             PGM /*CLCFTFUNZ*/
             DCL        VAR(&LIBPRD)  TYPE(*CHAR) LEN(1) VALUE(N)
             DCL        VAR(&LIBPRD1) TYPE(*CHAR) LEN(1) VALUE(N)
             DCL        VAR(&HDTAARA) TYPE(*CHAR) LEN(1024) VALUE(SPACES)
             RTVDTAARA  DTAARA(*LDA) RTNVAR(&HDTAARA)
             ADDLIBLE LIB(MCPRD)
             MONMSG     MSGID(CPF0000) EXEC(DO)
             CHGVAR     VAR(&LIBPRD) VALUE(Y)
             ENDDO
             ADDLIBLE LIB(MCPRD1)
             MONMSG     MSGID(CPF0000) EXEC(DO)
             CHGVAR     VAR(&LIBPRD1) VALUE(Y)
             ENDDO
  /***********************************************************************/
  /*       PD RAGLOW   1/30/91   ADDED THE FOLLOWING LOGIC IN ORDER      */
  /*                             TO BE ABLE TO DEACTIVATE THIS OPTION.   */
  /***********************************************************************/
             OVRDBF     FILE(MCFPMM0800) SHARE(*YES)
             OPNDBF     FILE(MCFPMM0800) OPTION(*ALL)
             MONMSG     MSGID(CPF0000) EXEC(DO)
             SNDUSRMSG  MSG('Attention Key program temporarily +
                          disabled.  Try again later.  any +
                          questions, please call operations.')
             GOTO CMDLBL(ENDPGM)
             ENDDO
  /***********************************************************************/
   /**********************************************************/
   /***  CALL CRAFTSMAN'S FUNCTIONS PROGRAM                ***/
   /**********************************************************/
             CALL TEXECUTV
             MONMSG MSGID(CPF0000) EXEC(DO)
                CALL MCXABEND
             SNDNETSPLF FILE(QPJOBLOG) TOUSRID((MCMGR AKRON60)) +
                          SPLNBR(*LAST)
             ENDDO
  /***********************************************************************/
  /*       PD RAGLOW   1/30/91   ADDED THE FOLLOWING LOGIC IN ORDER      */
  /*                             TO BE ABLE TO DEACTIVATE THIS OPTION.   */
  /***********************************************************************/
             DLTOVR     FILE(MCFPMM0800)
             CLOF       OPNID(MCFPMM0800)
             MONMSG     MSGID(CPF0000)
  /***********************************************************************/
             IF (&LIBPRD *EQ 'N') DO
             RMVLIBLE LIB(MCPRD)
             ENDDO
             IF (&LIBPRD1 *EQ 'N') DO
             RMVLIBLE LIB(MCPRD1)
             ENDDO
             CHGDTAARA  DTAARA(*LDA) VALUE(&HDTAARA)
ENDPGM:      ENDPGM
