/*********************************************************************/
/** PROGRAM: TARIBA03C                                             ***/
/**                                                                ***/
/** PURPOSE: CALL PROGRAM PASSED FROM MONITOR                      ***/
/**                                                                ***/
/** CREATED: 12/16/02                                              ***/
/** AUTHOR : DAN RAUCH - EXLTECH,INC                               ***/
/**                                                                ***/
/*********************************************************************/
/** SPECIAL NOTES:                                                 ***/
/*********************************************************************/
             PGM        PARM(&PROGRAM)

             DCL        VAR(&PROGRAM) TYPE(*CHAR) LEN(10)

             CHGLIBL    CURLIB(*CRTDFT)

/*------------------------------------------------------------------**/
/*-- CALL THE PROGRAM NAME PASSED                                 --**/
/*------------------------------------------------------------------**/
             CALL       PGM(&PROGRAM)
             MONMSG     MSGID(CPF0000) EXEC(GOTO CMDLBL(ENDIT))

ENDIT:       ENDPGM
