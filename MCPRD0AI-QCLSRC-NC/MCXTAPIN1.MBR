             PGM        PARM(&MOVTOTMP)
/******************************************************************/
/***                                                            ***/
/*** PROGRAM: MCXTAPIN1                                         ***/
/*** PURPOSE: JOB TO CREATE SAVEFILES CONTAINING CSIS/MMIS      ***/
/***          SOFTWARE FOR NEW INSTALL OF THE SYSTEM.           ***/
/***          CHANGES OWNERSHIP OF MCPRD0/MCPRD1 OBJECTS TO     ***/
/***          PD01 BEFORE CREATING THE SAVEFILES.               ***/
/*** PARMS  : MOVTOTMP  - 'Y' MOVES SOURCE IN AND OUT OF MCTEMP ***/
/***                      /MCTEMP2 AND CREATES SAVFILES.        ***/
/***                      'R' MOVES SOURCE FROM MCTEMP/MCTEMP2  ***/
/***                      BACK INTO MCPRD0/MCPRD1 ( ABORT ).    ***/
/***                      OTHERWISE PROGRAM ENDS.               ***/
/***                                                            ***/
/*** LIBRARIES SAVED:                                           ***/
/***    MCPRD0 - CUTOFF LIBRARY OF THE LAST CSIS/MMIS RELEASE   ***/
/***    MCPRD1 - DATA FILE STRUCTURES (WILL BE LOADED WITH LIVE ***/
/***             DATA)                                          ***/
/***    MCMENU - LATEST CSIS/MMIS TRANSACTIONS                  ***/
/***    U@PRD  - FULL MENU SYSTEM.  NOTE: IF PROD. CONTROL IS   ***/
/***             ALREADY INSTALLED, USE JOB MCXTAPIN1B WHICH    ***/
/***             WILL STORE MCMENU INSTEAD OF THE FULL U@PRD    ***/
/***    U1PRD    SLEEPER FILES                                  ***/
/***    U4PRD    CVTDATA COMMAND                                ***/
/***                                                            ***/
/******************************************************************/
/*** 10NOV1992 - COMMENTED OUT ALL LOGIC FOR LIBRARIES MCMENU,  ***/
/***             U@PRD, AND U1PRD SINCE NAPANEE ALREADY HAS THE ***/
/***             GLOBAL MENU SYSTEM AND SLEEPER INSTALLED.      ***/
/***                ---DAVE PLUM                                ***/
/***                                                            ***/
/*** 17NOV1993 - REACTIVATED THE LOGIC FOR LIBRARIES MCMENU,    ***/
/***             U@PRD, AND U1PRD.  REVISED THE SAVLIB          ***/
/***             STATEMENTS TO USE "*CURRENT" INSTEAD OF "*PRV" ***/
/***             FOR THE "TARGET RELEASE".  SEVERAL COBOL PGMS  ***/
/***             IN MCPRD0 WERE COMPILED USING "*CURRENT"       ***/
/***             (V2R2), SO IT WAS NOT POSSIBLE TO USE THE      ***/
/***             SAVLIB DEFAULT OF "*PRV" FOR TARGET RELEASE.   ***/
/***                ---DAVE PLUM                                ***/
/***                                                            ***/
/*** 08JAN1997 - REVISED SAVLIB STATEMENTS TO USE *CURRENT FOR  ***/
/***             TGTRLS FOR A RISC INSTALLATION.                ***/
/***                                                            ***/
/******************************************************************/
             DCL        VAR(&MOVTOTMP) TYPE(*CHAR) LEN(1)

/***                                                            ***/
/*** CHECK MOVTOTMP PARAMETER                                   ***/
/***                                                            ***/
             IF         COND((&MOVTOTMP *EQ 'R') *OR (&MOVTOTMP *EQ +
                          'r')) THEN(GOTO CMDLBL(MOVEBACK))
             IF         COND((&MOVTOTMP *NE 'Y') *AND (&MOVTOTMP *NE +
                          'y')) THEN(DO)
             SNDMSG     MSG('MCXTAPIN1: Invalid parameter +
                          specified.') TOUSR(*SYSOPR) MSGTYPE(*INFO)
             GOTO       CMDLBL(ALLDONE)
             ENDDO

/***                                                            ***/
/*** MOVE SOURCE OBJECTS FROM MCPRD0/MCPRD1 TO MCTEMP/MCTEMP2   ***/
/***                                                            ***/
/*** REMOVED REFERENCES TO VARIOUS COPYXXXS FILES THAT WERE     ***/
/*** CONDENSCED INTO COPYLIB.  08/08/94   CR KALMAN.            ***/


             MOVOBJ     OBJ(MCPRD0/COPYLIB) OBJTYPE(*FILE) +
                          TOLIB(MCTEMP)
             MONMSG     MSGID(CPF0000) EXEC(GOTO CMDLBL(ALLDONE))

             MOVOBJ     OBJ(MCPRD0/QCLSRC) OBJTYPE(*FILE) TOLIB(MCTEMP)
             MONMSG     MSGID(CPF0000) EXEC(GOTO CMDLBL(ALLDONE))

             MOVOBJ     OBJ(MCPRD0/QCMDSRC) OBJTYPE(*FILE) +
                          TOLIB(MCTEMP)
             MONMSG     MSGID(CPF0000) EXEC(GOTO CMDLBL(ALLDONE))

             MOVOBJ     OBJ(MCPRD0/QDDSSRC) OBJTYPE(*FILE) +
                          TOLIB(MCTEMP)
             MONMSG     MSGID(CPF0000) EXEC(GOTO CMDLBL(ALLDONE))

             MOVOBJ     OBJ(MCPRD0/QLBLSRC) OBJTYPE(*FILE) +
                          TOLIB(MCTEMP)
             MONMSG     MSGID(CPF0000) EXEC(GOTO CMDLBL(ALLDONE))


/***                                                            ***/
/*** CREATE SAVEFILES                                           ***/
/***                                                            ***/
             DLTF       FILE(MCBCK/SAVFMCPRD0)
             MONMSG     MSGID(CPF0000)
             DLTF       FILE(MCBCK/SAVFMCPRD1)
             MONMSG     MSGID(CPF0000)
             DLTF       FILE(MCBCK/SAVFMCMENU)
             MONMSG     MSGID(CPF0000)
             DLTF       FILE(MCBCK/SAVFU@PRD)
             MONMSG     MSGID(CPF0000)
             DLTF       FILE(MCBCK/SAVFU1PRD)
             MONMSG     MSGID(CPF0000)
             DLTF       FILE(MCBCK/SAVFU4PRD)
             MONMSG     MSGID(CPF0000)
             CRTSAVF    FILE(MCBCK/SAVFMCPRD0)
             CRTSAVF    FILE(MCBCK/SAVFMCPRD1)
             CRTSAVF    FILE(MCBCK/SAVFMCMENU)
             CRTSAVF    FILE(MCBCK/SAVFU@PRD)
             CRTSAVF    FILE(MCBCK/SAVFU1PRD)
             CRTSAVF    FILE(MCBCK/SAVFU4PRD)

/***                                                            ***/
/*** SAVE LIBRARIES TO SAVEFILES                                ***/
/***                                                            ***/
             SAVLIB     LIB(MCPRD0) DEV(*SAVF) +
                          SAVF(MCBCK/SAVFMCPRD0) TGTRLS(*CURRENT) +
                          PRECHK(*YES) DTACPR(*YES)
             SAVLIB     LIB(MCPRD1) DEV(*SAVF) +
                          SAVF(MCBCK/SAVFMCPRD1) TGTRLS(*CURRENT) +
                          PRECHK(*YES) DTACPR(*YES)

             SAVLIB     LIB(MCMENU) DEV(*SAVF) +
                          SAVF(MCBCK/SAVFMCMENU) TGTRLS(*CURRENT) +
                          PRECHK(*YES) DTACPR(*YES)
             SAVLIB     LIB(U@PRD) DEV(*SAVF) SAVF(MCBCK/SAVFU@PRD) +
                          TGTRLS(*CURRENT) PRECHK(*YES) DTACPR(*YES)
             SAVLIB     LIB(U1PRD) DEV(*SAVF) SAVF(MCBCK/SAVFU1PRD) +
                          TGTRLS(*CURRENT) PRECHK(*YES) DTACPR(*YES)

             SAVLIB     LIB(U4PRD) DEV(*SAVF) SAVF(MCBCK/SAVFU4PRD) +
                          TGTRLS(*CURRENT) PRECHK(*YES) DTACPR(*YES)

/***                                                            ***/
/*** DISPLAY THE SAVEFILES CONTENT                              ***/
/***                                                            ***/
             DSPSAVF    FILE(MCBCK/SAVFMCPRD0) OUTPUT(*PRINT)
             DSPSAVF    FILE(MCBCK/SAVFMCPRD1) OUTPUT(*PRINT)
             DSPSAVF    FILE(MCBCK/SAVFMCMENU) OUTPUT(*PRINT)
             DSPSAVF    FILE(MCBCK/SAVFU@PRD ) OUTPUT(*PRINT)
             DSPSAVF    FILE(MCBCK/SAVFU1PRD ) OUTPUT(*PRINT)
             DSPSAVF    FILE(MCBCK/SAVFU4PRD ) OUTPUT(*PRINT)

/***                                                            ***/
/*** MOVE SOURCE OBJECTS FROM MCTEMP/MCTEMP2 TO MCPRD0/MCPRD1   ***/
/***                                                            ***/
 MOVEBACK:
             MOVOBJ     OBJ(MCTEMP/COPYLIB) OBJTYPE(*FILE) +
                          TOLIB(MCPRD0)
             MONMSG     MSGID(CPF0000) EXEC(GOTO CMDLBL(ALLDONE))

             MOVOBJ     OBJ(MCTEMP/QCLSRC) OBJTYPE(*FILE) TOLIB(MCPRD0)
             MONMSG     MSGID(CPF0000) EXEC(GOTO CMDLBL(ALLDONE))

             MOVOBJ     OBJ(MCTEMP/QCMDSRC) OBJTYPE(*FILE) +
                          TOLIB(MCPRD0)
             MONMSG     MSGID(CPF0000) EXEC(GOTO CMDLBL(ALLDONE))

             MOVOBJ     OBJ(MCTEMP/QDDSSRC) OBJTYPE(*FILE) +
                          TOLIB(MCPRD0)
             MONMSG     MSGID(CPF0000) EXEC(GOTO CMDLBL(ALLDONE))

             MOVOBJ     OBJ(MCTEMP/QLBLSRC) OBJTYPE(*FILE) +
                          TOLIB(MCPRD0)
             MONMSG     MSGID(CPF0000) EXEC(GOTO CMDLBL(ALLDONE))

/***                                                            ***/
/*** PRINT THE JOBLOG AND EXIT                                  ***/
/***                                                            ***/
 ALLDONE:    DSPJOBLOG  OUTPUT(*PRINT)
             ENDPGM
