
        /*** DISPLAY THE JOB TO PD01 WITH USER DATA AS MCABEND ***/

             PGM

             OVRPRTF    FILE(QPDSPJOB) OUTQ(PD01) USRDTA(MCABEND)
             MONMSG     MSGID(CPF0000)
             DSPJOB     OUTPUT(*PRINT)
             MONMSG     MSGID(CPF0000)
             DLTOVR     FILE(QPDSPJOB)
             MONMSG     MSGID(CPF0000)

             ENDPGM
