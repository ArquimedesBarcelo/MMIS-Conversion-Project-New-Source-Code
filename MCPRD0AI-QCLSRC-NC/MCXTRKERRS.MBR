PGM          /***  THIS PROGRAM IS USED TO SET UP COBOL ERROR HANDLER. ***/
             /***  THIS CODE IS NORMALLY IN MCXOPNGLOB. IF THE PLANT   ***/
             /***  DOES NOT USE OUR MCXOPNGLOB THEN THE PROGRAM SHOULD ***/
             /***  BE CALLED RIGHT BEFORE CALLING UTC9002.             ***/

             DCL        VAR(&SCOPE)      TYPE(*CHAR) LEN(1)

             CHGJOB     INQMSGRPY(*SYSRPYL)
             MONMSG     MSGID(CPF0000)
             OVRPRTF    FILE(QPPGMDMP) OUTQ(PD01) HOLD(*YES) +
                          USRDTA(MCABEND)

          CMDCALL:
             CHGVAR     VAR(&SCOPE) VALUE('P')
             CALL       PGM(MCXCBLERR) PARM(&SCOPE)
             MONMSG     MSGID(CPF0000)

             CALL UTC9002
             MONMSG     MSGID(CPF0000) EXEC(DO)
                CHGDTAARA  DTAARA(*LDA (108 8)) VALUE('        ')
                GOTO       CMDLBL(CMDCALL)
             ENDDO
ENDPGM
