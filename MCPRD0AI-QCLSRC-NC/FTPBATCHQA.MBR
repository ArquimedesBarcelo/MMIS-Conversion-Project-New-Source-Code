             PGM        PARM(&PLTIP)
             DCL        VAR(&PLTIP) TYPE(*CHAR) LEN(17)

             CLRPFM     FILE(MCPRD1/QJOBSRC) MBR(FTPOUT)
             MONMSG     MSGID(CPF0000)

             OVRDBF     FILE(INPUT) TOFILE(MCPRD1/QJOBSRC) MBR(FTPIN)
             OVRDBF     FILE(OUTPUT) TOFILE(MCPRD1/QJOBSRC) +
                          MBR(FTPOUT)

 /*  SET TO OPEN FTP SESSION WITH DESIRED PLANT AS PASSED IN PARM  */
             STRTCPFTP  RMTSYS(&PLTIP)

             DLTOVR FILE(INPUT)
             DLTOVR FILE(OUTPUT)

/*  SEND COMPLETION MESSAGE                                         */
            SNDMSG     MSG('FTP FILE TRANSFER DONE') TOUSR(A334884)
     ENDPGM
