         /*****************************************************/
         /*  PGM NAME: CLDOCLST                               */
         /*                                                   */
         /*  CL SUBPROGRAM USED TO EXECUTE DOCUMENT LIST      */
         /*  PROGRAM (SDOCLST).  THE FOUND PARAMETER          */
         /*  CONTROLS WHETHER THE SELECT OPTION WILL BE       */
         /*  AVAILABLE FOR THE DOCUMENT LIST PROGRAM.         */
         /*  SINCE ONLY THE LIST IS DESIRED FROM THIS         */
         /*  POINT OF EXECUTION, THE FOUND PARAMETER          */
         /*  IS SET TO SPACES AS WELL AS THE OTHER            */
         /*  PARAMETERS PASSED TO THE LIST PROGRAM.           */
         /*                                                   */
         /*  CALLED FROM GLOBAL MENU (ZDOC)                   */
         /*                                                   */
         /*****************************************************/
PGM
             DCL        VAR(&DOCMNT) TYPE(*CHAR) LEN(10)
             DCL        VAR(&FOUND)  TYPE(*CHAR) LEN(01)
             DCL        VAR(&ERR)    TYPE(*CHAR) LEN(01)

             DSPFLR     FLR(J0100FLR) TYPE(*DOC) OUTPUT(*OUTFILE) +
                          OUTFILE(*LIBL/MCFPDS0300)
             MONMSG     MSGID(OFC8E6F) EXEC(DO)
             SNDPGMMSG MSG('System Error - Cannot Display Documents')
             GOTO ENDPGM
             ENDDO
             CALL       PGM(*LIBL/SDOCLST) PARM(&DOCMNT &FOUND &ERR)
 ENDPGM:        ENDPGM
