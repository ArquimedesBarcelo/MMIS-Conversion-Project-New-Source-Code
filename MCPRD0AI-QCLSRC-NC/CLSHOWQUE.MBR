PGM PARM(&DBPARMS)
             DCL        VAR(&DBPARMS) TYPE(*CHAR) LEN(100)
             CHKOBJ     OBJ(QTEMP/SHOWQUE) OBJTYPE(*FILE)
             MONMSG     MSGID(CPF9800) EXEC(DO)
             CRTPF      FILE(QTEMP/SHOWQUE) RCDLEN(59) SIZE(1000 0 0) +
                          ALLOCATE(*YES)
             ENDDO
             CLRPFM     FILE(QTEMP/SHOWQUE)
             OVRDBF     FILE(SHOWQUE) TOFILE(QTEMP/SHOWQUE)
             CALL       PGM(*LIBL/TSHOWQUE) PARM(&DBPARMS)
             DLTOVR     FILE(SHOWQUE)
             ENDPGM
