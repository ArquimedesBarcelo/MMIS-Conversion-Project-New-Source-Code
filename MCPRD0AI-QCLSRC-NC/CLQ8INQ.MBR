PGM PARM(&DBPARMS &VPARMS &CPARMS)
             DCL        VAR(&DBPARMS) TYPE(*CHAR) LEN(600)
             DCL        VAR(&VPARMS)  TYPE(*CHAR) LEN(120)
             DCL        VAR(&CPARMS)  TYPE(*CHAR) LEN(100)
             CHKOBJ     OBJ(QTEMP/OUTFILQ8) OBJTYPE(*FILE)
             MONMSG     MSGID(CPF9800) EXEC(DO)
             CRTPF      FILE(QTEMP/OUTFILQ8) RCDLEN(100)
             ENDDO
             CLRPFM     FILE(QTEMP/OUTFILQ8)
             OVRDBF     FILE(OUTFILQ8) TOFILE(QTEMP/OUTFILQ8)
             CALL       PGM(*LIBL/TQ8SUB) +
                        PARM(&DBPARMS &VPARMS &CPARMS)
             DLTOVR     FILE(OUTFILQ8)
             ENDPGM
