/***************************************************************/
/*                                                             */
/* Program Name: FTPBATCH                                      */
/* Program Title: CL program to simulate Batch FTP             */
/*                                                             */
/* Description: This CL program simulates a Batch FTP          */
/*              environment.  It requires the FTP subcommands  */
/*              and logon parameters to be included in a       */
/*              physical file.                                 */
/*                                                             */
/*              To accomplish this the INPUT/OUTPUT files to   */
/*              to the underlying FTP support (which is        */
/*              written in Pascal) are changed to get          */
/*              input from, and put output to the named        */
/*              physical file.                                 */
/*                                                             */
/*              The logon parameters and FTP subcommands       */
/*              should be in the following format (remember    */
/*              the CL program has the FTP command in          */
/*              it, so the file only contains logon and FTP    */
/*              Subcommand entries):                           */
/*                                                             */
/*  Record format of Physical File Member:                     */
/*  -------------------------------------                      */
/*                                                             */
/*  ---------------------------------------------------------  */
/*  |UserID Password                                        |  */
/*  |FTP Subcommand #1                                      |  */
/*  |FTP Subcommand #2                                      |  */
/*  |.                                                      |  */
/*  |.                                                      |  */
/*  |QUIT                                                   |  */
/*  ---------------------------------------------------------  */
/*                                                             */
/*  Example (FTP to VM and send/receive files)                 */
/*  ---------------------------------------------------------  */
/*  |RLDICK BOBSPSWD                                        |  */
/*  |PUT RLDICK/BOBSFILE.MEMBER1 RLDICK.EXEC                |  */
/*  |GET PROFILE.EXEC RLDICK/VMEXAMP.PROFILE                |  */
/*  |QUIT                                                   |  */
/*  ---------------------------------------------------------  */
/*                                                             */
/***************************************************************/
             PGM        PARM(&PLTIP)
             DCL        VAR(&PLTIP) TYPE(*CHAR) LEN(17)
 /*          DCL        VAR(&DATE) TYPE(*CHAR) LEN(6)         */
 /*          DCL        VAR(&JULIAN) TYPE(*CHAR) LEN(5)       */
 /*          DCL        VAR(&TIME) TYPE(*CHAR) LEN(6)         */
 /*          DCL        VAR(&MEMBER) TYPE(*CHAR) LEN(10)      */
 /*          DCL        VAR(&FTPFLAG) TYPE(*CHAR) LEN(1)      */

             CLRPFM     FILE(MCPRD0/QTXTSRC) MBR(FTPBGOUT)
             MONMSG     MSGID(CPF0000)

             OVRDBF     FILE(INPUT) TOFILE(MCPRD0/QTXTSRC) MBR(FTPBG)
             OVRDBF     FILE(OUTPUT) TOFILE(MCPRD0/QTXTSRC) +
                          MBR(FTPBGOUT)

 /*  SET TO OPEN FTP SESSION WITH DESIRED PLANT AS PASSED IN PARM  */
             STRTCPFTP  RMTSYS(&PLTIP)
 /*          STRTCPFTP  RMTSYS('134.200.200.28')        DANVILLE   */
 /*          STRTCPFTP  RMTSYS('134.200.162.62')        NAPANEE    */
 /*          STRTCPFTP  RMTSYS('134.200.244.2')         FREEPORT   */

 DLTOVR FILE(INPUT)
 DLTOVR FILE(OUTPUT)

 /*  SEND COMPLETION MESSAGE                                         */
             SNDMSG     MSG('FTP File Transfer DONE') TOUSR(A334884)

 /*  VERIFY SUCCESSFUL FILE TRANSFER                                 */

 /*          OVRDBF     FILE(QTXTSRC) TOFILE(MCPRD0/QTXTSRC) +       */
 /*                       MBR(FTPBGOUT)                              */
 /*          MONMSG     MSGID(CPF0000)                               */

 /*          CHGVAR     VAR(&FTPFLAG) VALUE('0')                     */

 /*          CALL       PGM(CMCFTPCHK) PARM(&FTPFLAG)                */
 /*          MONMSG     MSGID(CPF0000)                               */

 /*          DLTOVR     FILE(QTXTSRC)                                */
 /*          MONMSG     MSGID(CPF0000)                               */

 /*          IF         COND(&FTPFLAG ¬= '0') THEN(DO)               */

 /*  AN ERROR OCCURRED IN THE FILE TRANSFER ROUTINE.                 */
 /*     SEND A MESSAGE TO LOG THE ERROR                              */
 /*     COPY THE OUTPUT MEMBER SO SOMEONE CAN CHECK OUT THE ERROR    */

 /*          RTVSYSVAL  SYSVAL(QDATE) RTNVAR(&DATE)                  */
 /*          RTVSYSVAL  SYSVAL(QTIME) RTNVAR(&TIME)                  */

 /*          CVTDAT     DATE(&DATE) TOVAR(&JULIAN) FROMFMT(*SYSVAL) +*/
 /*                       TOFMT(*JUL) TOSEP(*NONE)                   */

 /*          CHGVAR     VAR(&MEMBER) VALUE('Z' *CAT +                */
 /*                       %SST(&JULIAN 3 3) *CAT %SST(&TIME 1 6))    */

 /*          SNDMSG     MSG('FTP File Transfer Error: Output in +    */
 /*                       QTXTSRC member ' *CAT &MEMBER) TOMSGQ(FTP) */
 /*          MONMSG     MSGID(CPF0000)                               */

 /*          CPYSRCF    FROMFILE(MCPRD0/QTXTSRC) +                   */
 /*                       TOFILE(MCPRD0/QTXTSRC) FROMMBR(FTPBGOUT) + */
 /*                       TOMBR(&MEMBER)                             */
 /*          MONMSG     MSGID(CPF0000)                               */

 /*          ENDDO                                                   */


             ENDPGM
