/*********************************************************************/
/** PROGRAM: ABCATEXCPC                                            ***/
/**                                                                ***/
/** PURPOSE: 1) RUN QUERY PROGRAMS TO CREATE CATALOG               ***/
/**             EXCEPTION FILE (ABCATEXC3)                         ***/
/**          2) FTP ABCATEXP3 TO AKRON60(PLANT MBR)                ***/
/**                                                                ***/
/** CREATED:     05/13/2004                                        ***/
/** AUTHOR :     BILL FONAGY                                       ***/
/** COPIED FROM: TARBEXCP3C                                        ***/
/**                                                                ***/
/*********************************************************************/
PGM
             DCL        VAR(&RECORDS) TYPE(*DEC) LEN(10 0)

             DCL        VAR(&MSG1) TYPE(*CHAR) LEN(29) VALUE('Job +
                          ABCATEXP3 JOB is Complete')
             DCL        VAR(&MSG2) TYPE(*CHAR) LEN(29) VALUE('- +
                          Check FTP data in ABCATEXP3')

             DCL        VAR(&ERR1) TYPE(*CHAR) LEN(29) VALUE('Job +
                          ABCATEXP3 JOB is Complete')
             DCL        VAR(&ERR2) TYPE(*CHAR) LEN(35) VALUE('- FTP +
                          Error - See FTP JobLog Mbr')
             DCL        VAR(&MSG) TYPE(*CHAR) LEN(80)

             DCL        VAR(&PLT) TYPE(*CHAR) LEN(3)
             DCL        VAR(&ZMBR) TYPE(*CHAR) LEN(4)
             DCL        VAR(&TARGET) TYPE(*CHAR) LEN(17)
             DCL        VAR(&ERRFLAG) TYPE(*CHAR) LEN(1)

             DCL        VAR(&MPLTKEY) TYPE(*CHAR) LEN(04) VALUE('P 01')
             DCL        VAR(&MPLTDTA) TYPE(*CHAR) LEN(60)
             DCL        VAR(&MPLTPGM) TYPE(*CHAR) LEN(10) +
                          VALUE(CMPLTINFO)
             DCL        VAR(&MPLTSTS) TYPE(*CHAR) LEN(02) VALUE('00')


             CHGJOB     LOGCLPGM(*NO)


/** GET PLANT CODE                                                 **/
             CALL       PGM(&MPLTPGM) PARM(&MPLTKEY &MPLTDTA &MPLTSTS)
             CHGVAR     VAR(&PLT) VALUE(%SST(&MPLTDTA 1 3))

             CHGVAR     VAR(&ZMBR) VALUE('Z' *CAT &PLT)
             CHGVAR     VAR(&TARGET) VALUE('AKRON60')
             CHGVAR     VAR(&ERRFLAG) VALUE('0')

/** DETERMINE IF CATALOG EXCEPTION DATA FIRST EXISTS *****************/
             RTVMBRD    FILE(MCFPAB1600) NBRCURRCD(&RECORDS)
             IF         COND(&RECORDS *EQ 0) THEN(GOTO CMDLBL(ENDIT))

             RUNQRY     QRY(ABCATEXP1)
             RUNQRY     QRY(ABCATEXP2)
             RUNQRY     QRY(ABCATEXP3)

/** SETUP INPUT/OUTPUT SRC MEMBERS FOR THE FTP PROGRAM ***************/
             CPYF       FROMFILE(MCPRD/QFTPSRC) +
                          TOFILE(MCPRD/QFTPSRC) FROMMBR(FTPCATEXP3) +
                          TOMBR(FTP2IN) MBROPT(*REPLACE)
             MONMSG     MSGID(CPF0000) EXEC(GOTO CMDLBL(ENDIT))


/** CALL THE FTP PROGRAM - PASS IP NAME AND ERRFLAG ******************/
             CALL       PGM(FTPBATCH2) PARM(&TARGET &ERRFLAG)

/** CHECK THE ERR FLAG FOR SUCCESSFUL FTP TO AKRON60 *****************/

             IF         COND(&ERRFLAG *EQ '0') THEN(DO)
/** SETUP COMPLETION MSG TO SEND TO ARIBA MSGQ ON AKRON60 ************/
             CHGVAR     VAR(&MSG) VALUE(&MSG1 *BCAT &MSG2 *CAT '(' +
                          *CAT &ZMBR *CAT ')')
             SNDNETMSG  MSG(&MSG) TOUSRID((ARIBA  AKRON60))
             ENDDO

             IF         COND(&ERRFLAG *NE '0') THEN(DO)
/** SETUP COMPLETION ERR MSG TO SEND TO ARIBA MSGQ ON AKRON60 ********/
             CHGVAR     VAR(&MSG) VALUE(&ERR1 *BCAT &ERR2)
             SNDNETMSG  MSG(&MSG) TOUSRID((ARIBA  AKRON60))
             ENDDO

ENDIT:
ENDPGM
