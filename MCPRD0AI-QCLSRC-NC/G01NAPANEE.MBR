             PGM
/*****************************************************************/
/*** PROGRAM: G01NAPANEE                                       ***/
/*** PURPOSE: TO ADD AND CHANGE DATABASE FILES (PHYSICAL AND   ***/
/***          LOGICAL) FOR THE NAPANEE G01 WO PARTS.           ***/
/*****************************************************************/
/*                                                               */
/*****************************************************************/
/**********                 STEP 1                ****************/
/**********           MMISA REFERENCE FILE        ****************/
/**********      DELETE PHYSICAL MMISA REF FILE   ****************/
/**********      CREATE PHYSICAL MMISA REF FILE   ****************/
/*****************************************************************/
             DLTF       FILE(MCPRD1/MMISA)
             MONMSG     MSGID(CPF2105)
             CRTPF      FILE(MCPRD1/MMISA) SRCFILE(*LIBL/QDDSSRCDB) +
                          SRCMBR(MMISA) TEXT('MMISA     Reference +
                          File') SIZE(*NOMAX)
             SNDMSG     MSG('Step 1 of 3 has COMPLETED NORMALLY in +
                          G01NAPANEE') TOUSR(*SYSOPR)
/*****************************************************************/
/**********                 STEP 2                ****************/
/************        MCFPMM1200  WO-PARTS PF      ****************/
/************  A) DELETE LOGICAL FILES            ****************/
/************  B) CREATE DUP OBJ OF PHYSICAL      ****************/
/************  C) DELETE PHYSICAL FILE            ****************/
/************  D) CREATE PHYSICAL FILE            ****************/
/************  E) COPY DUP OBJ INTO NEW PHYSICAL  ****************/
/************  F) CREATE LOGICAL FILES            ****************/
/************  G) DELETE DUP OBJ OF PHYSICAL      ****************/
/*****************************************************************/
/* STEP 2A */
             DLTF       FILE(MCPRD1/MCFLMM1201)
             MONMSG     MSGID(CPF2105)
/*         */
             DLTF       FILE(MCPRD1/MCFLMM1202)
             MONMSG     MSGID(CPF2105)
/*         */
             DLTF       FILE(MCPRD1/MCFLMM1203)
             MONMSG     MSGID(CPF2105)
/* STEP 2B */
             CRTDUPOBJ  OBJ(MCFPMM1200) FROMLIB(MCPRD1) +
                          OBJTYPE(*FILE) TOLIB(MCPRD1) +
                          NEWOBJ(MCFPMM120T) DATA(*YES)
/* STEP 2C */
             DLTF       FILE(MCPRD1/MCFPMM1200)
             MONMSG     MSGID(CPF2105)
/* STEP 2D */
             CRTPF      FILE(MCPRD1/MCFPMM1200) +
                          SRCFILE(*LIBL/QDDSSRCDB) +
                          SRCMBR(MCFPMM1200) TEXT('WO-PARTS         +
                          Physical File') SIZE(*NOMAX)
/* STEP 2E */
             CPYF       FROMFILE(MCPRD1/MCFPMM120T) +
                          TOFILE(MCPRD1/MCFPMM1200) MBROPT(*ADD) +
                          FMTOPT(*MAP)
/* STEP 2F */
             CRTLF      FILE(MCPRD1/MCFLMM1201) +
                          SRCFILE(*LIBL/QDDSSRCDB) +
                          SRCMBR(MCFLMM1201) TEXT('WO-PARTS         +
                          Logical File (WONUM)')
/*         */
             CRTLF      FILE(MCPRD1/MCFLMM1202) +
                          SRCFILE(*LIBL/QDDSSRCDB) +
                          SRCMBR(MCFLMM1202) TEXT('WO-PARTS         +
                          Logical File (PRTSTATUS)')
/*         */
             CRTLF      FILE(MCPRD1/MCFLMM1203) +
                          SRCFILE(*LIBL/QDDSSRCDB) +
                          SRCMBR(MCFLMM1203) TEXT('WO-PARTS         +
                          Logical File (PERCCNUM)')
/* STEP 2G */
             DLTF       FILE(MCPRD1/MCFPMM120T)
             MONMSG     MSGID(CPF2105)
             SNDMSG     MSG('Step 2 of 3 has COMPLETED NORMALLY in +
                          G01NAPANEE') TOUSR(*SYSOPR)
/*****************************************************************/
/**********                 STEP 3                 ***************/
/************  A) MOVE EXISTING PROGRAMS TO MCBCK  ***************/
/************  B) RESTORE OBJECTS FROM SAVEFILE    ***************/
/*****************************************************************/
/* STEP 3A */
             MOVOBJ     OBJ(MCPRD/ISSPARTS) OBJTYPE(*PGM)  TOLIB(MCBCK)
             MOVOBJ     OBJ(MCPRD/TAPPRVWO) OBJTYPE(*PGM)  TOLIB(MCBCK)
             MOVOBJ     OBJ(MCPRD/TASPTREQ) OBJTYPE(*PGM)  TOLIB(MCBCK)
             MOVOBJ     OBJ(MCPRD/TCOPYREQ) OBJTYPE(*PGM)  TOLIB(MCBCK)
             MOVOBJ     OBJ(MCPRD/TDELMMIS) OBJTYPE(*PGM)  TOLIB(MCBCK)
             MOVOBJ     OBJ(MCPRD/TDELRESV) OBJTYPE(*PGM)  TOLIB(MCBCK)
             MOVOBJ     OBJ(MCPRD/TDISPBAS) OBJTYPE(*PGM)  TOLIB(MCBCK)
             MOVOBJ     OBJ(MCPRD/TDISPPLN) OBJTYPE(*PGM)  TOLIB(MCBCK)
             MOVOBJ     OBJ(MCPRD/TDUPLBAT) OBJTYPE(*PGM)  TOLIB(MCBCK)
             MOVOBJ     OBJ(MCPRD/TDUPLSUB) OBJTYPE(*PGM)  TOLIB(MCBCK)
             MOVOBJ     OBJ(MCPRD/TEACHECK) OBJTYPE(*PGM)  TOLIB(MCBCK)
             MOVOBJ     OBJ(MCPRD/TGENWORK) OBJTYPE(*PGM)  TOLIB(MCBCK)
             MOVOBJ     OBJ(MCPRD/TGETAMTS) OBJTYPE(*PGM)  TOLIB(MCBCK)
             MOVOBJ     OBJ(MCPRD/TGETESTM) OBJTYPE(*PGM)  TOLIB(MCBCK)
             MOVOBJ     OBJ(MCPRD/THISTORY) OBJTYPE(*PGM)  TOLIB(MCBCK)
             MOVOBJ     OBJ(MCPRD/TMCOPPRT) OBJTYPE(*PGM)  TOLIB(MCBCK)
             MOVOBJ     OBJ(MCPRD/TMMDELETE) OBJTYPE(*PGM)  TOLIB(MCBCK)
             MOVOBJ     OBJ(MCPRD/TMMDELSUB) OBJTYPE(*PGM)  TOLIB(MCBCK)
             MOVOBJ     OBJ(MCPRD/TMODMADD) OBJTYPE(*PGM)  TOLIB(MCBCK)
             MOVOBJ     OBJ(MCPRD/TMODMCHG) OBJTYPE(*PGM)  TOLIB(MCBCK)
             MOVOBJ     OBJ(MCPRD/TMODMDEL) OBJTYPE(*PGM)  TOLIB(MCBCK)
             MOVOBJ     OBJ(MCPRD/TMODMLST) OBJTYPE(*PGM)  TOLIB(MCBCK)
             MOVOBJ     OBJ(MCPRD/TMODSTAT) OBJTYPE(*PGM)  TOLIB(MCBCK)
             MOVOBJ     OBJ(MCPRD/TMODWORK) OBJTYPE(*PGM)  TOLIB(MCBCK)
             MOVOBJ     OBJ(MCPRD/TNEWBUDG) OBJTYPE(*PGM)  TOLIB(MCBCK)
             MOVOBJ     OBJ(MCPRD/TPLNNEDD) OBJTYPE(*PGM)  TOLIB(MCBCK)
             MOVOBJ     OBJ(MCPRD/TPLNNEDP) OBJTYPE(*PGM)  TOLIB(MCBCK)
             MOVOBJ     OBJ(MCPRD/TPMLEVEX) OBJTYPE(*PGM)  TOLIB(MCBCK)
             MOVOBJ     OBJ(MCPRD/TPMNOWWO) OBJTYPE(*PGM)  TOLIB(MCBCK)
             MOVOBJ     OBJ(MCPRD/TPRINTWS) OBJTYPE(*PGM)  TOLIB(MCBCK)
             MOVOBJ     OBJ(MCPRD/TQ11SUB)  OBJTYPE(*PGM)  TOLIB(MCBCK)
             MOVOBJ     OBJ(MCPRD/TQ12SUB)  OBJTYPE(*PGM)  TOLIB(MCBCK)
             MOVOBJ     OBJ(MCPRD/TRACKING) OBJTYPE(*PGM)  TOLIB(MCBCK)
             MOVOBJ     OBJ(MCPRD/TREQINTF) OBJTYPE(*PGM)  TOLIB(MCBCK)
             MOVOBJ     OBJ(MCPRD/TREQINT2) OBJTYPE(*PGM)  TOLIB(MCBCK)
             MOVOBJ     OBJ(MCPRD/TREQREMS) OBJTYPE(*PGM)  TOLIB(MCBCK)
             MOVOBJ     OBJ(MCPRD/TSPRTCOP) OBJTYPE(*PGM)  TOLIB(MCBCK)
             MOVOBJ     OBJ(MCPRD/TSPRTCPM) OBJTYPE(*PGM)  TOLIB(MCBCK)
             MOVOBJ     OBJ(MCPRD/TSUFFIXW) OBJTYPE(*PGM)  TOLIB(MCBCK)
             MOVOBJ     OBJ(MCPRD/TSUFFSUM) OBJTYPE(*PGM)  TOLIB(MCBCK)
             MOVOBJ     OBJ(MCPRD/TTRANSFM) OBJTYPE(*PGM)  TOLIB(MCBCK)
             MOVOBJ     OBJ(MCPRD/TUPDTODW) OBJTYPE(*PGM)  TOLIB(MCBCK)
             MOVOBJ     OBJ(MCPRD/TINQMATL) OBJTYPE(*PGM)  TOLIB(MCBCK)
             MOVOBJ     OBJ(MCPRD/TSTAGMTL) OBJTYPE(*PGM)  TOLIB(MCBCK)
             MOVOBJ     OBJ(MCPRD/TPCHG)    OBJTYPE(*PGM)  TOLIB(MCBCK)
             MOVOBJ     OBJ(MCPRD/TPDEL1)   OBJTYPE(*PGM)  TOLIB(MCBCK)
             MOVOBJ     OBJ(MCPRD/SPMSCRWS) OBJTYPE(*PGM)  TOLIB(MCBCK)
             MOVOBJ     OBJ(MCPRD/TSEESTAT) OBJTYPE(*PGM)  TOLIB(MCBCK)
             MOVOBJ     OBJ(MCPRD/TVCSTREV) OBJTYPE(*PGM)  TOLIB(MCBCK)
             MOVOBJ     OBJ(MCPRD/TVERBALD) OBJTYPE(*PGM)  TOLIB(MCBCK)
             MOVOBJ     OBJ(MCPRD/TVERBALP) OBJTYPE(*PGM)  TOLIB(MCBCK)
/* STEP 4B */
             RSTOBJ     OBJ(*ALL) SAVLIB(MCBETA) DEV(*SAVF) +
                          SAVF(MCPRD/MMISANAP) RSTLIB(MCPRD)
             SNDMSG     MSG('Step 3 of 3 has COMPLETED NORMALLY in +
                          G01NAPANEE') TOUSR(*SYSOPR)
/*****************************************************************/
             DSPJOBLOG  OUTPUT(*PRINT)
             SNDMSG     MSG('G01NAPANEE has ENDED NORMALLY') TOUSR(*SYSOPR)
             ENDPGM
