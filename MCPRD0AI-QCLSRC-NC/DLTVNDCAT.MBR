/*********************************************************************/
/** PROGRAM: DLTVNDCAT                                              **/
/**                                                                 **/
/** =======  DELETE A VENDOR CATALOG  =======                       **/
/**                                                                 **/
/** PURPOSE: DELETE ALL RECORDS FROM CATALOG FILE MCFPAB2000 FOR    **/
/**          A GIVEN VENDOR CODE PASSED FROM CALLER                 **/
/**                                                                 **/
/** CREATED: 09/11/2003                                             **/
/** AUTHOR : DAN RAUCH - EXLTECH, LLC                               **/
/**                                                                 **/
/*********************************************************************/

/**@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@***/
/** SPECIAL NOTES: STRING THE RUNSQL REQUEST DATA TO &REQUEST       **/
/**                VARIABLE AND RUNSQL USING &REQUEST DATA          **/
/** IE:                                                             **/
/** RUNSQL  REQUEST('DELETE FROM &FILENAME                          **/
/**                   WHERE &FLD  =  &VENDOR')                      **/
/**@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@***/
             PGM        PARM(&VENDOR)

             DCL        VAR(&FILE) TYPE(*CHAR) LEN(10) +
                          VALUE(MCFPAB2000)
             DCL        VAR(&FLD) TYPE(*CHAR) LEN(10) VALUE(VENCDE)
             DCL        VAR(&VENDOR) TYPE(*CHAR) LEN(10)


             DCL        VAR(&REQUEST) TYPE(*CHAR) LEN(100)
             DCL        VAR(&APOS) TYPE(*CHAR) LEN(1) VALUE(X'7D')

             DCL        VAR(&SQLSTR1)  TYPE(*CHAR) LEN(12) +
                        VALUE('DELETE FROM ')
             DCL        VAR(&SQLSTR2)  TYPE(*CHAR) LEN(07) +
                        VALUE(' WHERE ')
             DCL        VAR(&SQLSTR3)  TYPE(*CHAR) LEN(03) +
                        VALUE(' = ')


             CHGVAR     VAR(&REQUEST) VALUE(&SQLSTR1 *CAT &FILE *CAT +
                          &SQLSTR2 *CAT &FLD *CAT &SQLSTR3 *CAT +
                          &APOS *CAT &VENDOR *CAT &APOS)

             RUNSQL     REQUEST(&REQUEST)

ENDPGM
