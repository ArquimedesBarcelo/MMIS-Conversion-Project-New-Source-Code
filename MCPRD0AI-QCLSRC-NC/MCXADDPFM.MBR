             PGM        PARM(&LIBRARY &FILE &MEMBER)
/*********************************************************************/
/*** PROGRAM : MCXADDPFM                                           ***/
/*** PURPOSE : TO ADD THE GIVEN MEMBER TO THE INDICATED FILE.  IF  ***/
/***           THE MEMBER ALREADY EXISTS THEN CLEAR IT OUT.        ***/
/*********************************************************************/
             DCL        VAR(&LIBRARY) TYPE(*CHAR) LEN(10)
             DCL        VAR(&FILE) TYPE(*CHAR) LEN(10)
             DCL        VAR(&MEMBER) TYPE(*CHAR) LEN(10)

             ADDPFM     FILE(&LIBRARY/&FILE) MBR(&MEMBER)
             MONMSG     MSGID(CPF5812 CPF7306) EXEC(DO)
             CLRPFM     FILE(&LIBRARY/&FILE) MBR(&MEMBER)
             ENDDO
             ENDPGM
