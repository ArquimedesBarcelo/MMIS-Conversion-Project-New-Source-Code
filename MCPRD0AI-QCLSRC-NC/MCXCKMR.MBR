         /*****************************************************/
         /*                                                   */
         /*    SIGN OFF ALL MMIS/CSIS USERS FOR RGZ OF        */
         /*    FILES BECAUSE THIS  REQUIRES THE USE OF        */
         /*    ALL FILES IN BOTH DATA BASES                   */
         /*                                                   */
         /*****************************************************/
             PGM
             DCLF       FILE(PLTLIB/HPFPDSP) RCDFMT(F132)
             DCL        VAR(&JOB)    TYPE(*CHAR) LEN(10)
             DCL        VAR(&USER)   TYPE(*CHAR) LEN(10)
             DCL        VAR(&NBR)    TYPE(*CHAR) LEN(06)
             DCL        VAR(&CJOB)   TYPE(*CHAR) LEN(10)
             DCL        VAR(&CUSER)  TYPE(*CHAR) LEN(10)
             DCL        VAR(&CNBR)   TYPE(*CHAR) LEN(06)
             DCL        VAR(&CHR)    TYPE(*CHAR) LEN(01)
             DCL        VAR(&MSG)    TYPE(*CHAR) LEN(125)
             DCL        VAR(&MSGDTA) TYPE(*CHAR) LEN(75)
             DCL        VAR(&MSGID)  TYPE(*CHAR) LEN(07)
             DCL        VAR(&MSGQ)   TYPE(*CHAR) LEN(10)
             RTVJOBA    JOB(&JOB) USER(&USER) NBR(&NBR)
             CLRPFM     FILE(PLTLIB/HPFPDSP)
             OVRPRTF    FILE(QPDSPOLK) OUTQ(QPRINT) HOLD(*YES)
             WRKOBJLCK  OBJ(MCPRD1/MCFPMM1600) OBJTYPE(*FILE) +
                          MBR(*ALL) OUTPUT(*PRINT) /* MMIS TRANS  +
                          FILE */
             CPYSPLF    FILE(QPDSPOLK) TOFILE(PLTLIB/HPFPDSP) +
                          JOB(&NBR/&USER/&JOB)
             DLTSPLF    FILE(QPDSPOLK) JOB(&NBR/&USER/&JOB)
             WRKOBJLCK  OBJ(MCPRD1/MCFPCS0200) OBJTYPE(*FILE) +
                          MBR(*ALL) OUTPUT(*PRINT) /* MMIS TRANS  +
                          FILE */
             CPYSPLF    FILE(QPDSPOLK) TOFILE(PLTLIB/HPFPDSP) +
                          JOB(&NBR/&USER/&JOB) MBROPT(*ADD)
             DLTSPLF    FILE(QPDSPOLK) JOB(&NBR/&USER/&JOB)
 READ1:
             RCVF       RCDFMT(F132)
             MONMSG     MSGID(CPF0000) EXEC(GOTO CMDLBL(RCVMSG))
             CHGVAR     VAR(&CHR)   VALUE(%SST(&FIL 15 01))
             IF         COND(&CHR *EQ ' ') THEN(GOTO READ1)
             CHGVAR     VAR(&CHR)   VALUE(%SST(&FIL 54 01))
             IF         COND(&CHR *EQ '*') THEN(DO)
                 CHGVAR     VAR(&CJOB)  VALUE(%SST(&FIL 15 10))
                 CHGVAR     VAR(&CUSER) VALUE(%SST(&FIL 26 10))
                 CHGVAR     VAR(&CNBR)  VALUE(%SST(&FIL 37 06))
             CHGVAR     VAR(&MSG) VALUE('  THE COMPUTER REQUIRES THE +
                          ENG & STORES FILES AT THIS TIME PLEASE +
                          TRY AGAIN AFTER 12:00 NOON ')
                 CHGVAR     VAR(&MSGQ) VALUE(&CJOB)
             SNDBRKMSG  MSG(&MSG) TOMSGQ(QSYS/&MSGQ)
             ENDJOB     JOB(&CNBR/&CUSER/&CJOB) OPTION(*IMMED) +
                          LOGLMT(0)
             MONMSG     MSGID(CPF0000) EXEC(GOTO CMDLBL(BYE1))
 BYE1:       ENDDO
             GOTO       CMDLBL(READ1)
 RCVMSG:
             RCVMSG     MSGDTA(&MSGDTA) MSGID(&MSGID)
             IF         COND(&MSGDTA *EQ ' ') THEN(GOTO CMDLBL(ENDPGM))
             SNDPGMMSG  MSGID(&MSGID) MSGF(QSYSL/QCPFMSG) +
                          MSGDTA(&MSGDTA)
             MONMSG     MSGID(CPF0000) EXEC(GOTO CMDLBL(ENDPGM))
             GOTO       CMDLBL(RCVMSG)
 ENDPGM:
             ENDPGM
