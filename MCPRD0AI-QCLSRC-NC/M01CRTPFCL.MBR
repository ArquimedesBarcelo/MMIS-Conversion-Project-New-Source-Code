/*********************************************************************/
/** PROGRAM: M01CRTPFCL                                             **/
/**                                                                 **/
/** PURPOSE: CREATE PHYSICALS FROM QDDSSRCDB IN MCPRD               **/
/**                                                                 **/
/** CREATED: MAY 4, 2005                                            **/
/** AUTHOR : DAN RAUCH - EXLTECH,INC                                **/
/**                                                                 **/
/*********************************************************************/
/** SPECIAL NOTES:                                                  **/
/*********************************************************************/
             PGM        PARM(&DBFLIB &INPLIB)

             DCL        VAR(&FNAME) TYPE(*CHAR) LEN(10)
             DCL        VAR(&INPLIB) TYPE(*CHAR) LEN(10)
             DCL        VAR(&DBFLIB) TYPE(*CHAR) LEN(10)
             DCL        VAR(&MBRTYP) TYPE(*CHAR) LEN(10)
             DCL        VAR(&SYSNAM) TYPE(*CHAR) LEN(8)

             RTVNETA    SYSNAME(&SYSNAM)


READ1ST:
             RTVMBRD    FILE(&INPLIB/QDDSSRCDB) MBR(*FIRSTMBR) +
                          RTNMBR(&FNAME) SRCTYPE(&MBRTYP)
             MONMSG     MSGID(CPF9999) EXEC(GOTO CMDLBL(ENDIT))
             GOTO       CHECKIT


READNXT:

             RTVMBRD    FILE(&INPLIB/QDDSSRCDB) MBR(&FNAME *NEXT) +
                          RTNMBR(&FNAME) SRCTYPE(&MBRTYP)
             MONMSG     MSGID(CPF3049) EXEC(GOTO CMDLBL(ENDIT))

CHECKIT:
/** PROCESS ONLY PHYSICAL FILE SOURCE MBRS                          **/
             IF COND(&MBRTYP *NE 'PF') THEN(DO)
             GOTO       READNXT
             ENDDO

             IF COND(&SYSNAM *EQ 'AKRON60') THEN(DO)
             GOTO       CONTINUE
             ENDDO

/**================================================================**/
/** PUT PF'S FOR THE JOB PARM AND DATAQ FILES IN MCPRD(&INPLIB)     */
/** ELSE    PUT ALL OTHERS IN THE DB LIBRARY(&DBFLIB)               */
/**================================================================**/
             IF    COND(%SST(&FNAME 1 8) *EQ 'MCFPAB11'    +
                   *OR  %SST(&FNAME 1 8) *EQ 'MCFPAB12'    +
                   *OR  %SST(&FNAME 1 8) *EQ 'MCFPAB19') THEN(DO)

/** IF FILE DOES NOT EXIST - CREATE IT USING QDDSSRCDB SOURCE MBR */
                   CHKOBJ     OBJ(&INPLIB/&FNAME) OBJTYPE(*FILE)
                   MONMSG     MSGID(CPF9801) EXEC(DO)
                   CRTPF      FILE(&INPLIB/&FNAME) +
                              SRCFILE(&INPLIB/QDDSSRCDB) +
                              SRCMBR(&FNAME) TEXT(*SRCMBRTXT) +
                              SIZE(*NOMAX)
                   ENDDO
                   GOTO       READNXT
             ENDDO

CONTINUE:

/** IF FILE DOES NOT EXIST - CREATE IT USING QDDSSRCDB SOURCE MBR */
             CHKOBJ     OBJ(&DBFLIB/&FNAME) OBJTYPE(*FILE)
             MONMSG     MSGID(CPF9801) EXEC(DO)
               CRTPF      FILE(&DBFLIB/&FNAME) +
                          SRCFILE(&INPLIB/QDDSSRCDB) +
                          SRCMBR(&FNAME) TEXT(*SRCMBRTXT) +
                          SIZE(*NOMAX)
             ENDDO

             GOTO       READNXT
ENDIT:
ENDPGM
