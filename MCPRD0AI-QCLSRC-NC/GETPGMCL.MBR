/*********************************************************************/
/** PROGRAM: GETPGMCL                                              ***/
/**                                                                ***/
/** PURPOSE: RETRIEVE THE CALLING PROGRAM NAME                     ***/
/**          LEVEL = 1  ==> 1ST PGM BACK IN STACK CALLED THIS CL   ***/
/**          (TRIGGER CALLS ARE USUALLY LEVEL = 2)                 ***/
/**                                                                ***/
/** CREATED:  1/07/03                                              ***/
/** AUTHOR : DAN RAUCH - EXLTECH,INC                               ***/
/**                                                                ***/
/*********************************************************************/
/** SPECIAL NOTES:                                                 ***/
/** THIS CODE CAME FROM AN ARTICLE IN MIDRANGE COMPUTING MAGAZINE  ***/
/** ---- MODIFIED SLIGHTLY ----                                    ***/
/*********************************************************************/
 BEGIN:      PGM        PARM(&LEVELS &RTNPGM)
             DCL        VAR(&LEVELS) TYPE(*DEC) LEN(3 0)
             DCL        VAR(&RTNPGM) TYPE(*CHAR) LEN(10)
             DCL        VAR(&SENDER) TYPE(*CHAR) LEN(80)
             DCL        VAR(&CALLER) TYPE(*CHAR) LEN(10)
             DCL        VAR(&MSGKEY) TYPE(*CHAR) LEN(4)
             DCL        VAR(&COUNTR) TYPE(*DEC) LEN(3 0)

             MONMSG     MSGID(CPF0000) EXEC(GOTO CMDLBL(ERROR))


             SNDPGMMSG  MSG(X) TOPGMQ(*PRV (*)) MSGTYPE(*INFO) +
                          KEYVAR(&MSGKEY)

             RCVMSG     PGMQ(*PRV *) MSGKEY(&MSGKEY) RMV(*YES) +
                        SENDER(&SENDER)

             CHGVAR     VAR(&CALLER) VALUE(%SST(&SENDER 56 10))
 LOOP:
             SNDPGMMSG  MSG(X) TOPGMQ(*PRV (&CALLER)) MSGTYPE(*INFO) +
                          KEYVAR(&MSGKEY)

             RCVMSG     PGMQ(*PRV (&CALLER)) MSGKEY(&MSGKEY) +
                          RMV(*YES) SENDER(&SENDER)

             CHGVAR     VAR(&COUNTR) VALUE(&COUNTR + 1)

             IF         COND(&COUNTR *EQ &LEVELS) THEN(DO)
             CHGVAR     VAR(&RTNPGM) VALUE(%SST(&SENDER 56 10))
             RETURN
             ENDDO
             ELSE (DO)
             CHGVAR     VAR(&CALLER) VALUE(%SST(&SENDER 56 10))
             GOTO       CMDLBL(LOOP)
             ENDDO

ERROR: /*  FWDPGMMSG FROMPGMQ(*) MSGTYPE(*ERROR)   */


ENDPGM
