/*********************************************************************/
/** PROGRAM: ABCATEXCLC                                            ***/
/**                                                                ***/
/** PURPOSE: CLEARS FILE ABCATEXP3 TO PREP FOR PLANT FTP DATA      ***/
/**                                                                ***/
/** EXAMPLE:                                                       ***/
/**          MCPRD1/ABCATEXP3(Z+PLANT ID) (IE: Z131, Z133 ..ETC)   ***/
/**                                                                ***/
/** CREATED: 05/14/2004                                            ***/
/** AUTHOR : BILL FONAGY                                           ***/
/** COPIED FROM: TARBEXCLRC                                        ***/
/**                                                                ***/
/** CHANGES:                                                       ***/
/**     11/02/2004  B FONAGY  ADDED: SPARTANBURG AND VALLEYFIELD   ***/
/**                         REMOVED: GADSDEN - NOW ON SAP          ***/
/**                                                                ***/
/*********************************************************************/
PGM

             CLRPFM     FILE(ABCATEXP3) MBR(ALLPLANTS)
/***** SPARTANBURG  11/02/2004                                       */
             CLRPFM     FILE(ABCATEXP3) MBR(Z120)
             CLRPFM     FILE(ABCATEXP3) MBR(Z126)
             CLRPFM     FILE(ABCATEXP3) MBR(Z129)
/***** GADSDEN      11/02/2004                                       */
/*****       CLRPFM     FILE(ABCATEXP3) MBR(Z131)                    */
             CLRPFM     FILE(ABCATEXP3) MBR(Z133)
             CLRPFM     FILE(ABCATEXP3) MBR(Z153)
             CLRPFM     FILE(ABCATEXP3) MBR(Z155)
             CLRPFM     FILE(ABCATEXP3) MBR(Z174)
/***** VALLEYFIELD  11/02/2004                                       */
             CLRPFM     FILE(ABCATEXP3) MBR(Z629)
             CLRPFM     FILE(ABCATEXP3) MBR(Z631)

             CLRMSGQ    MSGQ(ARIBA)

             SNDMSG     MSG('EXCEPTION FILE ABCATEXP3 MEMBERS +
                             CLEARED') TOMSGQ(ARIBA)

ENDIT:
ENDPGM
