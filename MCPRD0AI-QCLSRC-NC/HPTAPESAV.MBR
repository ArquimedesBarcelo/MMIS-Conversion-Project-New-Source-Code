PGM
             ADDLIBLE MCBCK
             MONMSG CPF0000
             SNDMSG     MSG('BACKUP COPY TO TAPE HAS STARTED') +
                          TOUSR(*SYSOPR)
             SAVSAVFDTA SAVF(BACKUP) DEV(TAP01) SEQNBR(1) +
                          ENDOPT(*UNLOAD) CLEAR(*ALL)
             MONMSG CPF0000
             CLRSAVF BACKUP
             RMVLIBLE MCBCK
             MONMSG CPF0000
             SNDMSG     MSG('BACKUP COPY TO TAPE IS COMPLETE') +
                          TOUSR(*SYSOPR)
ENDPGM
