             PGM
/*****************************************************************/
/***                                                           ***/
/*** PROGRAM: MCXRLSE                                          ***/
/*** PURPOSE: TO CUT A NEW RELEASE OF THE CSIS/MMIS SOFTWARE   ***/
/***          FROM MCBETA TO MCPRD0.                           ***/
/***                                                           ***/
/***          THIS CL SHOULD BE RUN AFTER A GENERAL RELEASE    ***/
/***          OF CSIS/MMIS HAS BEEN RELEASED.  ONCE THIS CL    ***/
/***          HAS EXECUTED CORRECTLY, DELETE LIBRARY MCBETA    ***/
/***          & FILES MCBCK/SVFMCBETA1 AND MCBCK/SVFMCBETA0.   ***/
/***                                                           ***/
/*** WARNING: YOU  M U S T   HAVE *ALLOBJ AUTHORITY OR RUN     ***/
/***          THIS PROGRAM FROM THE SECURITY OFFICER SIGNON    ***/
/***          SINCE THE RSTOBJ COMMANDS INCLUDE THE            ***/
/***          ALWOBJDIF(*ALL) PARAMETER.                       ***/
/***                                                           ***/
/*** NOTES  : THE SAVOBJ AND RSTOBJ COMMANDS IN STEP 2 SHOULD  ***/
/***          BE REVIEWED, AND CHANGED IF NECESSARY, PRIOR TO  ***/
/***          EACH EXECUTION OF THIS PROGRAM.  THESE COMMANDS  ***/
/***          INCLUDE MENTION OF THE REFERENCE FILES (STORES,  ***/
/***          MMISA, ETC.) THAT ARE PART OF THE PARTICULAR     ***/
/***          RELEASE BEING MOVED OUT OF MCBETA INTO MCPRD1.   ***/
/***          MORE SPECIFICALLY, CHECK TO MAKE SURE THAT THE   ***/
/***          OBJECTS THAT ARE MENTIONED IN THE SAVOBJ COMMAND ***/
/***          EXIST IN MCBETA. IF NOT, EITHER REMOVE THEM FROM ***/
/***          THE SAVOBJ COMMAND OR COPY THE EXISTING ONES IN  ***/
/***          MCPRD1 INTO MCBETA.                              ***/
/***                                                           ***/
/***          SINCE SO MANY THINGS TEND TO CHANGE FROM ONE     ***/
/***          RELEASE TO THE NEXT, IT IS ADVISABLE TO REVIEW   ***/
/***          AND REVISE THIS PROGRAM PRIOR TO EXECUTING IT.   ***/
/***                                                           ***/
/*** 30NOV1994 THIS PROGRAM WAS REVISED TO ACCOUNT FOR CHANGES ***/
/***           WHICH OCCURRED BETWEEN RELEASES G.01 AND H.01.  ***/
/***           SPECIFICALLY, BETWEEN THESE RELEASES MANY       ***/
/***           COPYLIB FILES WERE ELIMINATED, AND THEREFORE    ***/
/***           HAD TO BE REMOVED FROM THIS PROGRAM.            ***/
/***             --- DAVE PLUM                                 ***/
/*** 23JUL2003 CHANGED REFERENCE FILES TO BE JUST COPIED       ***/
/***           INSTEAD OF USING A SAVF. THAT ALLOWS FOR EASIER ***/
/***           CHANGES WHEN A REFERENCE FILE HAS NOT CHANGED.  ***/
/***             --- BRUCE GEISER                              ***/
/*****************************************************************/
/*****************************************************************/
/***      COPY QJOBSRC OF MCBETA TO MCPRD1, THEN DELETE        ***/
/***                                                           ***/
/***      YOU MAY NEED TO CHECK TO SEE IF A MEMBER EXISTS      ***/
/***      IN QJOBSRC2 OR QRJEJCL2 BECAUSE THE CPYSRCF COMMAND  ***/
/***      WILL SHUT DOWN IF THERE AREN'T ANY. AGAIN, COPY AN   ***/
/***      EXISTING ONE FROM MCPRD1'S QJOBSRC AND/OR QRJEJCL.   ***/
/*****************************************************************/
 STEP3:      CPYSRCF    FROMFILE(MCBETA/QJOBSRC) +
                          TOFILE(MCPRD1/QJOBSRC) FROMMBR(*ALL) +
                          TOMBR(*FROMMBR) MBROPT(*REPLACE)
             MONMSG     MSGID(CPF2868) EXEC(GOTO CMDLBL(STEP5))
             MONMSG     MSGID(CPF2800) EXEC(DO)
             SNDMSG     MSG('CPYSRCF QJOBSRC for library MCBETA did +
                          not complete correctly.  CSIS/MMIS +
                          Release operation terminated.  Please +
                          refer to joblog for details.') TOUSR(*SYSOPR)
             GOTO       CMDLBL(ENDPGM)
             ENDDO
             DLTF       FILE(MCBETA/QJOBSRC)
/*****************************************************************/
/***      COPY QRJEJCL OF MCBETA TO MCPRD0, THEN DELETE        ***/
/*****************************************************************/
 STEP4:      CPYSRCF    FROMFILE(MCBETA/QRJEJCL) +
                          TOFILE(MCPRD0/QRJEJCL) FROMMBR(*ALL) +
                          TOMBR(*FROMMBR) MBROPT(*REPLACE)
             MONMSG     MSGID(CPF2868) EXEC(GOTO CMDLBL(STEP6))
             MONMSG     MSGID(CPF2800) EXEC(DO)
             SNDMSG     MSG('CPYSRCF QRJEJCL for library MCBETA did +
                          not complete correctly.  CSIS/MMIS +
                          Release operation terminated.  Please +
                          refer to joblog for details.') TOUSR(*SYSOPR)
             GOTO       CMDLBL(ENDPGM)
             ENDDO
             DLTF       FILE(MCBETA/QRJEJCL)
/*****************************************************************/
/***      COPY QLBLSRC OF MCBETA TO MCPRD0, THEN DELETE        ***/
/*****************************************************************/
 STEP5:      CPYSRCF    FROMFILE(MCBETA/QLBLSRC) +
                          TOFILE(MCPRD0/QLBLSRC) FROMMBR(*ALL) +
                          TOMBR(*FROMMBR) MBROPT(*REPLACE)
             MONMSG     MSGID(CPF2800) EXEC(DO)
             SNDMSG     MSG('CPYSRCF QLBLSRC for library MCBETA did +
                          not complete correctly.  CSIS/MMIS +
                          Release operation terminated.  Please +
                          refer to joblog for details.') TOUSR(*SYSOPR)
             GOTO       CMDLBL(ENDPGM)
             ENDDO
             DLTF       FILE(MCBETA/QLBLSRC)
/*****************************************************************/
/***      COPY QDDSSRC OF MCBETA TO MCPRD0, THEN DELETE        ***/
/*****************************************************************/
 STEP6:      CPYSRCF    FROMFILE(MCBETA/QDDSSRC) +
                          TOFILE(MCPRD0/QDDSSRC) FROMMBR(*ALL) +
                          TOMBR(*FROMMBR) MBROPT(*REPLACE)
             MONMSG     MSGID(CPF2800) EXEC(DO)
             SNDMSG     MSG('CPYSRCF QDDSSRC for library MCBETA did +
                          not complete correctly.  CSIS/MMIS +
                          Release operation terminated.  Please +
                          refer to joblog for details.') TOUSR(*SYSOPR)
             GOTO       CMDLBL(ENDPGM)
             ENDDO
             DLTF       FILE(MCBETA/QDDSSRC)
/*****************************************************************/
/***      COPY QCLSRC OF MCBETA TO MCPRD0, THEN DELETE         ***/
/*****************************************************************/
 STEP7:      CPYSRCF    FROMFILE(MCBETA/QCLSRC) +
                          TOFILE(MCPRD0/QCLSRC) FROMMBR(*ALL) +
                          TOMBR(*FROMMBR) MBROPT(*REPLACE)
             MONMSG     MSGID(CPF2800) EXEC(DO)
             SNDMSG     MSG('CPYSRCF QCLSRC for library MCBETA did +
                          not complete correctly.  CSIS/MMIS +
                          Release operation terminated.  Please +
                          refer to joblog for details.') TOUSR(*SYSOPR)
             GOTO       CMDLBL(ENDPGM)
             ENDDO
             DLTF       FILE(MCBETA/QCLSRC)
/*****************************************************************/
/***      COPY QDDSSRCDB OF MCBETA TO MCPRD0, THEN DELETE      ***/
/*****************************************************************/
 STEP9:      CPYSRCF    FROMFILE(MCBETA/QDDSSRCDB) +
                          TOFILE(MCPRD0/QDDSSRCDB) FROMMBR(*ALL) +
                          TOMBR(*FROMMBR) MBROPT(*REPLACE)
             MONMSG     MSGID(CPF2800) EXEC(DO)
             SNDMSG     MSG('CPYSRCF QDDSSRCDB for library MCBETA +
                          did not complete correctly.  CSIS/MMIS +
                          Release operation terminated.  Please +
                          refer to joblog for details.') TOUSR(*SYSOPR)
             GOTO       CMDLBL(ENDPGM)
             ENDDO
             DLTF       FILE(MCBETA/QDDSSRCDB)
/*****************************************************************/
/***      COPY COPYLIB    OF MCBETA TO MCPRD0, THEN DELETE     ***/
/*****************************************************************/
 STEP10:     CPYSRCF    FROMFILE(MCBETA/COPYLIB) +
                          TOFILE(MCPRD0/COPYLIB) FROMMBR(*ALL) +
                          TOMBR(*FROMMBR) MBROPT(*REPLACE)
             MONMSG     MSGID(CPF2800) EXEC(DO)
             SNDMSG     MSG('CPYSRCF COPYLIB for library MCBETA +
                          did not complete correctly.  CSIS/MMIS +
                          Release operation terminated.  Please +
                          refer to joblog for details.') TOUSR(*SYSOPR)
             GOTO       CMDLBL(ENDPGM)
             ENDDO
             DLTF       FILE(MCBETA/COPYLIB)
/*****************************************************************/
/***      COPY ALL DFU FILES AND DISPLAY FILES TO MCPRD0       ***/
/***      THEN REMOVE THESE OBJECTS FROM MCBETA.               ***/
/***                                                           ***/
/***      (FOLLOWING THIS STEP ONLY PF-DTA TYPE FILES SHOULD   ***/
/***       REMAIN IN LIBRARY MCBETA.  WE WILL MOVE THESE TO    ***/
/***       MCPRD1 IN THE NEXT STEP.)                           ***/
/*****************************************************************/
 STEP11:     DLTF       FILE(MCBCK/SVFMCBETA0)
             MONMSG     MSGID(CPF0000)
             CRTSAVF    FILE(MCBCK/SVFMCBETA0) TEXT('MCBETA to +
                          MCPRD0 savf')
             SAVOBJ     OBJ(MCD* Z*) LIB(MCBETA) DEV(*SAVF) +
                          OBJTYPE(*FILE) SAVF(MCBCK/SVFMCBETA0) +
                          TGTRLS(*CURRENT)
             MONMSG     MSGID(CPF3700 CPF3800) EXEC(DO)
             SNDMSG     MSG('SAVOBJ command for library MCBETA did +
                          not complete correctly.  CSIS/MMIS +
                          Release operation terminated.  Please +
                          refer to joblog for details.') TOUSR(*SYSOPR)
             GOTO       CMDLBL(ENDPGM)
             ENDDO
             RSTOBJ     OBJ(MCD* Z*) SAVLIB(MCBETA) DEV(*SAVF) +
                          SAVF(MCBCK/SVFMCBETA0) MBROPT(*ALL) +
                          ALWOBJDIF(*ALL) RSTLIB(MCPRD0) OUTPUT(*PRINT)
             MONMSG     MSGID(CPF3872) EXEC(DO)
             SNDMSG     MSG('RSTOBJ command for SAVF SVFMCBETA0 did +
                          not complete correctly.  CSIS/MMIS +
                          Release operation terminated.  Please +
                          refer to joblog for details.') TOUSR(*SYSOPR)
             GOTO       CMDLBL(ENDPGM)
             ENDDO
             DLTF       FILE(MCBETA/MCD*)
             DLTF       FILE(MCBETA/Z*)
/*****************************************************************/
/***      NOW THAT THE ONLY REMAINING FILES IN LIBRARY MCBETA  ***/
/***      SHOULD BE THOSE WITH THE ATTRIBUTE PF-DTA, WE WILL   ***/
/***      MOVE THESE REMAINING FILES TO MCPRD1.                ***/
/***                                                           ***/
/***      (ALL PF-SRC, DFU, DSPF, LF, AND PF-DTA FILES NAMED   ***/
/***       MCFP* HAVE BEEN HANDLED ABOVE AND ARE NO LONGER IN  ***/
/***       MCBETA AT THIS POINT.)                              ***/
/*****************************************************************/
 STEP12:     DLTF       FILE(MCBCK/SVFMCBETA1)
             MONMSG     MSGID(CPF0000)
             CRTSAVF    FILE(MCBCK/SVFMCBETA1) TEXT('MCBETA to +
                          MCPRD1 savf')
             SAVOBJ     OBJ(*ALL) LIB(MCBETA) DEV(*SAVF) +
                          OBJTYPE(*FILE) SAVF(MCBCK/SVFMCBETA1) +
                          TGTRLS(*CURRENT)
             MONMSG     MSGID(CPF3700 CPF3800) EXEC(DO)
             SNDMSG     MSG('SAVOBJ command for library MCBETA did +
                          not complete correctly.  CSIS/MMIS +
                          Release operation terminated.  Please +
                          refer to joblog for details.') TOUSR(*SYSOPR)
             GOTO       CMDLBL(ENDPGM)
             ENDDO
             RSTOBJ     OBJ(*ALL) SAVLIB(MCBETA) DEV(*SAVF) +
                          OBJTYPE(*FILE) SAVF(MCBCK/SVFMCBETA1) +
                          MBROPT(*ALL) ALWOBJDIF(*ALL) +
                          RSTLIB(MCPRD1) OUTPUT(*PRINT)
             MONMSG     MSGID(CPF3872) EXEC(DO)
             SNDMSG     MSG('RSTOBJ command for SAVF SVFMCBETA1 did +
                          not complete correctly.  CSIS/MMIS +
                          Release operation terminated.  Please +
                          refer to joblog for details.') TOUSR(*SYSOPR)
             GOTO       CMDLBL(ENDPGM)
             ENDDO
             MONMSG     MSGID(CPF3773)
/*****************************************************************/
/***      COPY REST OF OBJECTS IN MCBETA TO MCPRD0.            ***/
/***      (*PGM, *QRYDFN, *CMD, *MENU, *MSGF, OBJECT TYPES)    ***/
/*****************************************************************/
 STEP13:     DLTF       FILE(MCBCK/SVFMCBETA0)
             MONMSG     MSGID(CPF0000)
             CRTSAVF    FILE(MCBCK/SVFMCBETA0) TEXT('MCBETA to +
                          MCPRD0 savf')
             SAVOBJ     OBJ(*ALL) LIB(MCBETA) DEV(*SAVF) +
                          OBJTYPE(*PGM *CMD *QRYDFN *MSGF *MENU) +
                          SAVF(MCBCK/SVFMCBETA0) TGTRLS(*CURRENT) +
                          PRECHK(*YES)
             MONMSG     MSGID(CPF3700 CPF3800) EXEC(DO)
             SNDMSG     MSG('SAVLIB command for library MCBETA did +
                          not complete correctly.  CSIS/MMIS +
                          Release operation terminated.  Please +
                          refer to joblog for details.') TOUSR(*SYSOPR)
             GOTO       CMDLBL(ENDPGM)
             ENDDO
             RSTOBJ     OBJ(*ALL) SAVLIB(MCBETA) DEV(*SAVF) +
                          SAVF(MCBCK/SVFMCBETA0) MBROPT(*ALL) +
                          ALWOBJDIF(*ALL) RSTLIB(MCPRD0) OUTPUT(*PRINT)
             MONMSG     MSGID(CPF3872) EXEC(DO)
             SNDMSG     MSG('RSTLIB command for SAVF SVFMCBETA0 did +
                          not complete correctly.  CSIS/MMIS +
                          Release operation terminated.  Please +
                          refer to joblog for details.') TOUSR(*SYSOPR)
             GOTO       CMDLBL(ENDPGM)
             ENDDO
/*****************************************************************/
/***      THE LAST TWO STEPS DO NOT DO DLTF COMMANDS FOR THE   ***/
/***      OBJECTS THAT HAVE JUST BEEN MOVED. IT IS ADVISED     ***/
/***      THAT YOU EXECUTE A CLRLIB MCBETA COMMAND IF NOTHING  ***/
/***      APPEARS BOGUS IN THE ACTUAL RSTOBJ EXECUTIONS.       ***/
/*****************************************************************/
ENDPGM:      DSPJOBLOG  OUTPUT(*PRINT)
             ENDPGM
