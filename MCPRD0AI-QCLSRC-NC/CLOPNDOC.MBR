         /*****************************************************/
         /*  PGM NAME: CLOPNDOC                               */
         /*                                                   */
         /*  CL SUBPROGRAM USED TO OPEN TEMPORARY FILE WHICH  */
         /*  IS USED BY CL COMMAND (DSPFLR) TO STORE ALL      */
         /*  DOCUMENTS, WITH THEIR DESCRIPTIONS, THAT ARE     */
         /*  USED IN THE CSIS/MMIS ONLINE DOCUMENTATION       */
         /*  SYSTEM.                                          */
         /*                                                   */
         /*  USED IN PROGRAM(S): TDOCLNK                      */
         /*                                                   */
         /*****************************************************/
PGM PARM(&DOCMNT &FOUND &ERR)
             DCL        VAR(&DOCMNT) TYPE(*CHAR) LEN(10)
             DCL        VAR(&FOUND)  TYPE(*CHAR) LEN(01)
             DCL        VAR(&ERR)    TYPE(*CHAR) LEN(01)

             CHKOBJ     OBJ(MCPRDB/MCFPDS0300) OBJTYPE(*FILE)
             MONMSG     MSGID(CPF9800) EXEC(DO)
             CRTPF      FILE(MCPRDB/MCFPDS0300) +
                          SRCFILE(MCPRD/QDDSSRCDB) SRCMBR(MCFPDS0300) +
                          LVLCHK(*NO)
             ENDDO
             CLRPFM     FILE(MCPRDB/MCFPDS0300)
             MONMSG     MSGID(CPF3130) EXEC(DO)
                        CHGVAR VAR(&ERR) VALUE(Y)
             ENDDO
             ENDPGM
