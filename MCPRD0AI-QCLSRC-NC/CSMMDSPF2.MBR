             PGM
/*********************************************************************/
/**  TO BE RUN IMMEDIATELY AFTER A RELEASE OF CSIS/MMIS IS INSTALLED**/
/**  AT A LOCATION WHERE THE PLANT TRANSLATES DISPLAY FILES.        **/
/**                                                                 **/
/**  THIS PROGRAM WILL GIVE A REPORT OF WHAT DISPLAY FILES HAVE     **/
/**  CHANGED ON THE RELEASE OF CSIS/MMIS FOR FOREIGN PLANTS THAT    **/
/**  TRANSLATE THE DISPLAY FILES OF CSIS/MMIS.  IN ADDITION TO THE  **/
/**  REPORT, EACH DISPLAY FILE ON THE REPORT WILL BE DELETED FROM   **/
/**  THE TRANSLATED LIBRARY MCLNG     SO THAT UNTIL THE CHANGES HAVE**/
/**  BEEN MADE IN THE TRANSLATED DISPLAY FILE, IT WILL USE THE      **/
/**  ENGLISH (NEW) VERSION.  THE PLANT CAN THEN USE THE REPORT TO   **/
/**  TO FIND WHICH DISPLAY FILES NEED CHANGED (TRANSLATED) AND THEN **/
/**  RECOMPILED INTO MCLNG.                                         **/
/**                                                                 **/
/**  IF A REPORT ONLY IS NEEDED, SIMPLY RUNQRY AGAINST QRYDFN       **/
/**  "DISPLAYF" INSTEAD OF THIS PROGRAM.                            **/
/*********************************************************************/

             DCLF       FILE(MCPRD1/DISPLAYF)

             CHKOBJ     OBJ(*LIBL/MCLNG) OBJTYPE(*LIB)
             MONMSG     MSGID(CPF9800) EXEC(GOTO CMDLBL(FINI))

             /* RUN QUERY TO GET REPORT OF CHANGED DISPLAY FILES */
             RUNQRY     QRY(MCPRD/DISPLAYF2) OUTTYPE(*PRINTER)

LOOP:
             RCVF
             DLTF       FILE(MCLNG/&DSFILE)
             MONMSG     MSGID(CPF0864) EXEC(GOTO CMDLBL(FINI))
             GOTO       CMDLBL(LOOP)
FINI:
             ENDPGM
