             PGM        PARM(&LIB &NEWOWN &USER &AUT)
/******************************************************************/
/***                                                            ***/
/*** PROGRAM: MCXSETAUT                                         ***/
/*** PURPOSE: TO CHANGE THE OBJECT OWNERSHIP OF ALL FILES IN    ***/
/***          &LIB TO &NEWOWN AND REVOKE ALL AUTHORITY EXCEPT   ***/
/***          TO &USER WITH &AUT.  THE LIBRARY AUTHORITES ARE   ***/
/***          ALSO CHANGED.                                     ***/
/***                                                            ***/
/******************************************************************/
             DCL        VAR(&NEWOWN) TYPE(*CHAR) LEN(10)
             DCL        VAR(&LIB) TYPE(*CHAR) LEN(10)
             DCL        VAR(&USER) TYPE(*CHAR) LEN(10)
             DCL        VAR(&AUT) TYPE(*CHAR) LEN(10)
             DCLF       FILE(QTEMP/MCXSETAUT)

/***                                                            ***/
/*** CREATE LISTING OF OBJECTS IN THE LIBRARY                   ***/
/***                                                            ***/
             DSPOBJD    OBJ(&LIB/*ALL) OBJTYPE(*ALL) +
                          OUTPUT(*OUTFILE) OUTFILE(QTEMP/MCXSETAUT) +
                          OUTMBR(*FIRST *REPLACE)
 READ:       RCVF
             MONMSG     MSGID(CPF0000) EXEC(GOTO CMDLBL(CHGLIBAUT))

/***                                                            ***/
/*** CHANGE THE OWNER, REVOKE ALL USER AUTHORITY THEN ADD       ***/
/*** USER AUTHORITY FOR USER SPECIFIED                          ***/
/***                                                            ***/
             CHGOBJOWN  OBJ(&ODLBNM/&ODOBNM) OBJTYPE(&ODOBTP) +
                          NEWOWN(&NEWOWN)
             RVKOBJAUT  OBJ(&ODLBNM/&ODOBNM) OBJTYPE(&ODOBTP) +
                          USER(*ALL) AUT(*ALL)
             GRTOBJAUT  OBJ(&ODLBNM/&ODOBNM) OBJTYPE(&ODOBTP) +
                          USER(&USER) AUT(&AUT)
             GOTO       CMDLBL(READ)
 CHGLIBAUT:
             CHGOBJOWN  OBJ(*LIBL/&LIB) OBJTYPE(*LIB) NEWOWN(&NEWOWN)
             RVKOBJAUT  OBJ(*LIBL/&LIB) OBJTYPE(*LIB) USER(*ALL) +
                          AUT(*ALL)
             GRTOBJAUT  OBJ(*LIBL/&LIB) OBJTYPE(*LIB) USER(&USER) +
                          AUT(&AUT)
             ENDPGM
