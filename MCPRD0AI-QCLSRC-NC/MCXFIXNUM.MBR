/* CALLS 'MCXFFD' FOR EVERY 'STORES' DATABASE DATASET THAT HAS */
/* NUMERIC ITEMS.  'MCXFFD' WILL TAKE ANY NUMERIC FIELD WITH   */
/* INVALID (NON-NUMERIC) DATA AND REPLACE IT WITH ZEROES.      */
     CALL MCXFFD PARM('MCFPCS0200')
     CALL MCXFFD PARM('MCFPCS0800')
     CALL MCXFFD PARM('MCFPCS0900')
     CALL MCXFFD PARM('MCFPCS1000')
     CALL MCXFFD PARM('MCFPCS1200')
     CALL MCXFFD PARM('MCFPCS1300')
     CALL MCXFFD PARM('MCFPCS1500')
     CALL MCXFFD PARM('MCFPCS2000')
     CALL MCXFFD PARM('MCFPCS2200')
     CALL MCXFFD PARM('MCFPCS2400')
     CALL MCXFFD PARM('MCFPCS2500')
     CALL MCXFFD PARM('MCFPCS2600')
     CALL MCXFFD PARM('MCFPCS2700')
     CALL MCXFFD PARM('MCFPCS3700')
