/*********************************************************************/
/** PROGRAM: TARIBACATC                                            ***/
/**                                                                ***/
/** PURPOSE: UPDATE VENDOR CATALOG                                 ***/
/**                                                                ***/
/** CREATED:  9/15/2003                                            ***/
/**                                                                ***/
/** AUTHOR : DAN RAUCH - eXLTech,LLC                               ***/
/**                                                                ***/
/** ----------------------------------------------------------------**/
/** STEP 1 : RUN SETUP PGM IF 1ST TIME AND FILE HAS RECORDS         **/
/**          ==> CALL TARIBASUP                                     **/
/**          NECESSARY FILES ARE ONLY LOADED ONCE FOR ARIBA 1ST     **/
/**          TIME SETUP THEN CLEARED AT EOJ.                        **/
/**                                                                 **/
/** STEP 2 : COPY CIF FILE TO GY FILE                               **/
/**          ==> CPYF MCFPAB2100  ==>  MCFPAB2200(AUDIT TRAIL CPY)  **/
/**                                                                 **/
/** STEP 3 : RUN PROGRAM TARIBACAT                                  **/
/**          ==> LOAD VENDOR CATALOG                                **/
/**                                                                 **/
/** STEP 4 : RUN PROGRAM TARIBAPRF                                  **/
/**          ==> RECALC VENDOR PRICES                               **/
/**          ==> SET ITEM PREFERENCES BY PRICE                      **/
/**                                                                 **/
/** STEP 5 : RUN PROGRAM TARIBAOVR                                  **/
/**          ==> RESTORE ITEM OVERRIDES                             **/
/**                                                                 **/
/** STEP 6 : RUN PROGRAM TARIBARPT                                  **/
/**          ==> PRINT PREFERRED CATALOG MISMATCH REPORT            **/
/**                                                                 **/
/** STEP 7 : REORG DB FILES                                         **/
/**                                                                 **/
/*********************************************************************/
/** SPECIAL NOTES:                                                 ***/
/*********************************************************************/
PGM
             DCL        VAR(&RECORDS) TYPE(*DEC) LEN(10 0)


             CHGJOB     LOGCLPGM(*NO)


/** CHK IF THERE ARE ANY SETUP RECORDS TO PROCESS - MCFPAB0900      **/
             RTVMBRD    FILE(MCFPAB0900) NBRCURRCD(&RECORDS)
             IF         COND(&RECORDS *GT 0) THEN(DO)
             CALL       PGM(TARIBASUP) /** 1ST TIME SETUP **/
             CLRPFM     FILE(MCFPAB0900) /*  CLEAR SETUP FILE    */
             ENDDO


/** MAKE SURE THE STAGING TABLE HAS RECORDS TO PROCESS              **/
             RTVMBRD    FILE(MCFPAB2100) NBRCURRCD(&RECORDS)
             IF         COND(&RECORDS *EQ 0) THEN(DO)
                        GOTO CMDLBL(EXIT)
             ENDDO


/** KEEP A COPY OF THE INPUT FILE FOR GOODYEAR AUDIT TRAIL PURPOSES **/
/** (*REPLACE) WILL ALWAYS BE A COPY OF ONLY LAST FILE PUSHED DOWN  **/
             CPYF       FROMFILE(MCFPAB2100) TOFILE(MCFPAB2200) +
                          MBROPT(*REPLACE) FMTOPT(*NOCHK)
             MONMSG     MSGID(CPF0000) EXEC(GOTO CMDLBL(EXIT))


/**-------------------------------------------------------- **/
/**--------- PUT MISMATCH REPORT ON ??? OUTQ -------------- **/
/**          OVRPRTF    FILE(XARIBARPT) OUTQ(** OUTQ?**)    **/
/**-------------------------------------------------------- **/

             CALL       PGM(TARIBACAT) /** CATALOG LOAD **/
             CALL       PGM(TARIBAPRF) /** SET ITEM PREFERENCE **/
             CALL       PGM(TARIBAOVR) /** RESTORE ITEM OVRDS  **/
             CALL       PGM(TARBEXCP1) /** PREF EXCEPTN RPT    **/
             CALL       PGM(TARBEXCP2) /** DMANPRT EXCP RPT    **/


/** REORG FILES BECAUSE OF HIGH NUMBER OF DELETED RECORDS           **/
             RGZPFM     FILE(MCFPAB1300) /*  REORG RESULTS FILE  */
             MONMSG     MSGID(CPF0000)

             RGZPFM     FILE(MCFPAB2700) /*  REORG OVERRIDE FILE */
             MONMSG     MSGID(CPF0000)

             RGZPFM     FILE(MCFPAB2100) /*  REORG CIF FILE  */
             MONMSG     MSGID(CPF0000)

             RGZPFM     FILE(MCFPAB2000) /*  REORG CATALOG FILE */
             MONMSG     MSGID(CPF0000)

             CLRPFM     FILE(MCFPAB1500) /*  CLEAR TRIGGER FILE  */
             MONMSG     MSGID(CPF0000)
EXIT:
ENDPGM
