             PGM
             DCL        VAR(&ACTION) TYPE(*CHAR) LEN(1)
                          /*  0-no action, 1-enable, 2-disable */
             DCL        VAR(&RC) TYPE(*CHAR) LEN(2)
                       /* 00-System name OK, 23-System Name not DEFINED */
             DCL        VAR(&DEFAULTS) TYPE(*CHAR) LEN(1000)
                       /* DEFAULT BACKUP VALUES */
             DCL        VAR(&COUNTER) TYPE(*DEC)
                       /* COUNTER               */
             DCLF       FILE(MCFDBACKUP)
     /****************************************************************/
     /*   GET THE DEFAULTS FROM THE DATA AREA WHERE THEY ARE STORED  */
     /****************************************************************/
             CHGVAR     VAR(&BUDTAARA1) VALUE('MCDABACKUP')
             CHGVAR     VAR(&BUDTALIB1) VALUE('MCPRD     ')
SEND1:       SNDRCVF    RCDFMT(MCRDBACK1)
             IF         COND(&IN03) THEN(GOTO CMDLBL(END))
             CHKOBJ     OBJ(&BUDTALIB1/&BUDTAARA1) OBJTYPE(*DTAARA)
             MONMSG     MSGID(CPF0000) EXEC(DO)
             CHGVAR     VAR(&BUERR1) VALUE('DATA AREA does not exist')
             GOTO       CMDLBL(SEND1)
             ENDDO
             RTVDTAARA  DTAARA(&BUDTALIB1/&BUDTAARA1) RTNVAR(&DEFAULTS)
             CHGVAR     VAR(&BUDTAARA)   VALUE(&BUDTAARA1)
             CHGVAR     VAR(&BUDTALIB)   VALUE(&BUDTALIB1)
             CHGVAR     VAR(&BUSYS1)     VALUE(%SST(&DEFAULTS 1   10))
             CHGVAR     VAR(&BUSYS2)     VALUE(%SST(&DEFAULTS 11  10))
             CHGVAR     VAR(&BUSYS3)     VALUE(%SST(&DEFAULTS 21  10))
             CHGVAR     VAR(&BUSYSLIB)   VALUE(%SST(&DEFAULTS 31  10))
             CHGVAR     VAR(&BUFILE1)    VALUE(%SST(&DEFAULTS 41  10))
             CHGVAR     VAR(&BUFILE2)    VALUE(%SST(&DEFAULTS 51  10))
             CHGVAR     VAR(&BUFILE3)    VALUE(%SST(&DEFAULTS 61  10))
             CHGVAR     VAR(&BUFILE4)    VALUE(%SST(&DEFAULTS 71  10))
             CHGVAR     VAR(&BUFILE5)    VALUE(%SST(&DEFAULTS 81  10))
             CHGVAR     VAR(&BUFLIB1)    VALUE(%SST(&DEFAULTS 91  10))
             CHGVAR     VAR(&BUFLIB2)    VALUE(%SST(&DEFAULTS 101 10))
             CHGVAR     VAR(&BUFLIB3)    VALUE(%SST(&DEFAULTS 111 10))
             CHGVAR     VAR(&BUFLIB4)    VALUE(%SST(&DEFAULTS 121 10))
             CHGVAR     VAR(&BUFLIB5)    VALUE(%SST(&DEFAULTS 131 10))
             CHGVAR     VAR(&BULIB1)     VALUE(%SST(&DEFAULTS 141 10))
             CHGVAR     VAR(&BULIB2)     VALUE(%SST(&DEFAULTS 151 10))
             CHGVAR     VAR(&BULIB3)     VALUE(%SST(&DEFAULTS 161 10))
             CHGVAR     VAR(&BULIB4)     VALUE(%SST(&DEFAULTS 171 10))
             CHGVAR     VAR(&BULIB5)     VALUE(%SST(&DEFAULTS 181 10))
             CHGVAR     VAR(&BUREORG)    VALUE(%SST(&DEFAULTS 191 1))
             CHGVAR     VAR(&BUSAVE)     VALUE(%SST(&DEFAULTS 192 1))
             CHGVAR     VAR(&BULORF)     VALUE(%SST(&DEFAULTS 193 1))
             CHGVAR     VAR(&BUUSER)     VALUE(%SST(&DEFAULTS 194 10))
             CHGVAR     VAR(&BUJOBQ1)    VALUE(%SST(&DEFAULTS 204 10))
             CHGVAR     VAR(&BUJOBQ2)    VALUE(%SST(&DEFAULTS 214 10))
             CHGVAR     VAR(&BUSAVFPFX)  VALUE(%SST(&DEFAULTS 224 08))
             CHGVAR     VAR(&BUSAVFLIB)  VALUE(%SST(&DEFAULTS 232 10))
             CHGVAR     VAR(&BUMEDIUM)   VALUE(%SST(&DEFAULTS 242 10))
             CHGVAR     VAR(&BUWARN)     VALUE(%SST(&DEFAULTS 252  1))
             CHGVAR     VAR(&BUWARNOP)   VALUE(%SST(&DEFAULTS 253  1))

     /****************************************************************/
     /*   SEND THE SCREEN TO THE TERMINAL FOR INPUT                  */
     /****************************************************************/
 SEND2:      SNDRCVF    RCDFMT(MCRDBACK2)
             IF         COND(&IN03) THEN(GOTO CMDLBL(END))
             CHGVAR     VAR(&IN01) VALUE('0')
             CHGVAR     VAR(&IN02) VALUE('0')
             CHGVAR     VAR(&IN03) VALUE('0')
             CHGVAR     VAR(&IN04) VALUE('0')
             CHGVAR     VAR(&IN05) VALUE('0')
             CHGVAR     VAR(&IN06) VALUE('0')
             CHGVAR     VAR(&IN07) VALUE('0')
             CHGVAR     VAR(&IN08) VALUE('0')
             CHGVAR     VAR(&IN09) VALUE('0')
             CHGVAR     VAR(&IN10) VALUE('0')
             CHGVAR     VAR(&IN11) VALUE('0')
             CHGVAR     VAR(&IN12) VALUE('0')
             CHGVAR     VAR(&IN13) VALUE('0')
             CHGVAR     VAR(&IN14) VALUE('0')
             CHGVAR     VAR(&IN15) VALUE('0')
             CHGVAR     VAR(&IN21) VALUE('0')
             CHGVAR     VAR(&IN22) VALUE('0')
             CHGVAR     VAR(&IN23) VALUE('0')
             CHGVAR     VAR(&IN24) VALUE('0')
             CHGVAR     VAR(&IN25) VALUE('0')
     /****************************************************************/
     /*   CHECK FOR THE EXISTENCE OF THE KEY FILES ENTERED           */
     /****************************************************************/
             IF         COND(&BUFILE1 *NE ' ') THEN(DO)
             CHKOBJ     OBJ(&BUFLIB1/&BUFILE1) OBJTYPE(*FILE)
             MONMSG     MSGID(CPF0000) EXEC(DO)
             CHGVAR     VAR(&BUERR) VALUE('file does not exist')
             CHGVAR     VAR(&IN11) VALUE('1')
             GOTO       CMDLBL(SEND2)
             ENDDO
             ENDDO
             IF         COND(&BUFILE2 *NE ' ') THEN(DO)
             CHKOBJ     OBJ(&BUFLIB2/&BUFILE2) OBJTYPE(*FILE)
             MONMSG     MSGID(CPF0000) EXEC(DO)
             CHGVAR     VAR(&BUERR) VALUE('file does not exist')
             CHGVAR     VAR(&IN12) VALUE('1')
             GOTO       CMDLBL(SEND2)
             ENDDO
             ENDDO
             IF         COND(&BUFILE3 *NE ' ') THEN(DO)
             CHKOBJ     OBJ(&BUFLIB3/&BUFILE3) OBJTYPE(*FILE)
             MONMSG     MSGID(CPF0000) EXEC(DO)
             CHGVAR     VAR(&BUERR) VALUE('file does not exist')
             CHGVAR     VAR(&IN13) VALUE('1')
             GOTO       CMDLBL(SEND2)
             ENDDO
             ENDDO
             IF         COND(&BUFILE4 *NE ' ') THEN(DO)
             CHKOBJ     OBJ(&BUFLIB4/&BUFILE4) OBJTYPE(*FILE)
             MONMSG     MSGID(CPF0000) EXEC(DO)
             CHGVAR     VAR(&BUERR) VALUE('file does not exist')
             CHGVAR     VAR(&IN14) VALUE('1')
             GOTO       CMDLBL(SEND2)
             ENDDO
             ENDDO
             IF         COND(&BUFILE5 *NE ' ') THEN(DO)
             CHKOBJ     OBJ(&BUFLIB5/&BUFILE5) OBJTYPE(*FILE)
             MONMSG     MSGID(CPF0000) EXEC(DO)
             CHGVAR     VAR(&BUERR) VALUE('file does not exist')
             CHGVAR     VAR(&IN15) VALUE('1')
             GOTO       CMDLBL(SEND2)
             ENDDO
             ENDDO
     /****************************************************************/
     /*   CHECK FOR THE EXISTENCE OF THE LIBRARIES ENTERED           */
     /****************************************************************/
             IF         COND(&BULIB1 *NE ' ') THEN(DO)
             CHKOBJ     OBJ(&BULIB1) OBJTYPE(*LIB)
             MONMSG     MSGID(CPF0000) EXEC(DO)
             CHGVAR     VAR(&BUERR) VALUE('Library does not exist')
             CHGVAR     VAR(&IN21) VALUE('1')
             GOTO       CMDLBL(SEND2)
             ENDDO
             ENDDO
             IF         COND(&BULIB2 *NE ' ') THEN(DO)
             CHKOBJ     OBJ(&BULIB2) OBJTYPE(*LIB)
             MONMSG     MSGID(CPF0000) EXEC(DO)
             CHGVAR     VAR(&BUERR) VALUE('Library does not exist')
             CHGVAR     VAR(&IN22) VALUE('1')
             GOTO       CMDLBL(SEND2)
             ENDDO
             ENDDO
             IF         COND(&BULIB3 *NE ' ') THEN(DO)
             CHKOBJ     OBJ(&BULIB3) OBJTYPE(*LIB)
             MONMSG     MSGID(CPF0000) EXEC(DO)
             CHGVAR     VAR(&BUERR) VALUE('Library does not exist')
             CHGVAR     VAR(&IN23) VALUE('1')
             GOTO       CMDLBL(SEND2)
             ENDDO
             ENDDO
             IF         COND(&BULIB4 *NE ' ') THEN(DO)
             CHKOBJ     OBJ(&BULIB4) OBJTYPE(*LIB)
             MONMSG     MSGID(CPF0000) EXEC(DO)
             CHGVAR     VAR(&BUERR) VALUE('Library does not exist')
             CHGVAR     VAR(&IN24) VALUE('1')
             GOTO       CMDLBL(SEND2)
             ENDDO
             ENDDO
             IF         COND(&BULIB5 *NE ' ') THEN(DO)
             CHKOBJ     OBJ(&BULIB5) OBJTYPE(*LIB)
             MONMSG     MSGID(CPF0000) EXEC(DO)
             CHGVAR     VAR(&BUERR) VALUE('Library does not exist')
             CHGVAR     VAR(&IN25) VALUE('1')
             GOTO       CMDLBL(SEND2)
             ENDDO
             ENDDO
     /****************************************************************/
     /*   CHECK FOR THE EXISTENCE OF THE USRPRF ENTERED              */
     /****************************************************************/
             IF         COND(&BUUSER *NE ' ') THEN(DO)
             CHKOBJ     OBJ(&BUUSER) OBJTYPE(*USRPRF)
             MONMSG     MSGID(CPF0000) EXEC(DO)
             CHGVAR     VAR(&BUERR) VALUE('USER not defined to system')
             CHGVAR     VAR(&IN05) VALUE('1')
             GOTO       CMDLBL(SEND2)
             ENDDO
             ENDDO
     /****************************************************************/
     /*   CHECK FOR THE EXISTENCE OF THE JOBQ'S ENTERED              */
     /****************************************************************/
             IF         COND(&BUJOBQ1 *NE ' ') THEN(DO)
             CHKOBJ     OBJ(&BUJOBQ1) OBJTYPE(*JOBQ)
             MONMSG     MSGID(CPF0000) EXEC(DO)
             CHGVAR     VAR(&BUERR) VALUE('JOBQ not defined to system')
             CHGVAR     VAR(&IN06) VALUE('1')
             GOTO       CMDLBL(SEND2)
             ENDDO
             ENDDO
             IF         COND(&BUJOBQ2 *NE ' ') THEN(DO)
             CHKOBJ     OBJ(&BUJOBQ2) OBJTYPE(*JOBQ)
             MONMSG     MSGID(CPF0000) EXEC(DO)
             CHGVAR     VAR(&BUERR) VALUE('JOBQ not defined to system')
             CHGVAR     VAR(&IN07) VALUE('1')
             GOTO       CMDLBL(SEND2)
             ENDDO
             ENDDO
     /****************************************************************/
     /*   CHECK FOR THE EXISTENCE OF THE SAVE FILE LIBRARY ENTERED   */
     /****************************************************************/
             IF (&BUSAVE *EQ 'D') THEN(DO)
             CHKOBJ     OBJ(&BUSAVFLIB) OBJTYPE(*LIB)
             MONMSG     MSGID(CPF0000) EXEC(DO)
             CHGVAR     VAR(&BUERR) VALUE('SAVEFILE library not +
                          defined to system')
             CHGVAR     VAR(&IN08) VALUE('1')
             GOTO       CMDLBL(SEND2)
             ENDDO
             ENDDO
     /****************************************************************/
     /*   CHECK FOR THE EXISTENCE OF THE TAPE DRIVE ENTERED          */
     /****************************************************************/
             IF (&BUSAVE *EQ 'T') THEN(DO)
             CHKOBJ     OBJ(&BUMEDIUM) OBJTYPE(*DEVD)
             MONMSG     MSGID(CPF0000) EXEC(DO)
             CHGVAR     VAR(&BUERR) VALUE('TAPE DRIVE not defined to system')
             CHGVAR     VAR(&IN09) VALUE('1')
             GOTO       CMDLBL(SEND2)
             ENDDO
             ENDDO
     /****************************************************************/
     /*  OVERRIDE THE MENU SYSTEM FILE TO ACCESS THE CORRECT LIBRARY */
     /****************************************************************/
             CHKOBJ     OBJ(&BUSYSLIB) OBJTYPE(*LIB)
             MONMSG     MSGID(CPF0000) EXEC(DO)
             CHGVAR     VAR(&BUERR) VALUE('SYSTEM library not +
                          defined to system')
             CHGVAR     VAR(&IN26) VALUE('1')
             GOTO       CMDLBL(SEND2)
             ENDDO
             OVRDBF     FILE(UTFLMSI1) TOFILE(&BUSYSLIB/UTFLMSI1)
     /****************************************************************/
     /*   CHECK FOR THE EXISTENCE OF THE SYSTEMS ENTERED             */
     /****************************************************************/
             IF (&BUSYS1 *NE ' ') THEN(DO)
             CHGVAR     VAR(&ACTION) VALUE('0')
             CALL       PGM(UTCSYSENAB) PARM(&BUSYS1 &ACTION &RC)
             IF         COND(&RC *NE '00')        THEN(DO)
             CHGVAR     VAR(&BUERR) VALUE('Invalid System name +
                          entered  RC = ')
             CHGVAR     VAR(%SST(&BUERR 60 2)) VALUE(&RC)
             CHGVAR     VAR(&IN01) VALUE('1')
             GOTO       CMDLBL(SEND2)
             ENDDO
             ENDDO
             IF (&BUSYS2 *NE ' ') THEN(DO)
             CHGVAR     VAR(&ACTION) VALUE('0')
             CALL       PGM(UTCSYSENAB) PARM(&BUSYS2 &ACTION &RC)
             IF         COND(&RC *NE '00')        THEN(DO)
             CHGVAR     VAR(&BUERR) VALUE('Invalid System name +
                          entered  RC = ')
             CHGVAR     VAR(%SST(&BUERR 60 2)) VALUE(&RC)
             CHGVAR     VAR(&IN02) VALUE('1')
             GOTO       CMDLBL(SEND2)
             ENDDO
             ENDDO
             IF (&BUSYS3 *NE ' ') THEN(DO)
             CHGVAR     VAR(&ACTION) VALUE('0')
             CALL       PGM(UTCSYSENAB) PARM(&BUSYS3 &ACTION &RC)
             IF         COND(&RC *NE '00')        THEN(DO)
             CHGVAR     VAR(&BUERR) VALUE('Invalid System name +
                          entered  RC = ')
             CHGVAR     VAR(%SST(&BUERR 60 2)) VALUE(&RC)
             CHGVAR     VAR(&IN04) VALUE('1')
             GOTO       CMDLBL(SEND2)
             ENDDO
             ENDDO
             DLTOVR     FILE(UTFLMSI1)
     /****************************************************************/
     /*   MOVE THE SAVE LIBRARIES TO THE FIRST POSITIONS AVAILABLE   */
     /****************************************************************/
             CHGVAR     VAR(&COUNTER) VALUE(0)
CHK1:        IF         COND(&BULIB1 *EQ ' ') THEN(DO)
             CHGVAR     VAR(&BULIB1) VALUE(&BULIB2)
             CHGVAR     VAR(&BULIB2) VALUE(&BULIB3)
             CHGVAR     VAR(&BULIB3) VALUE(&BULIB4)
             CHGVAR     VAR(&BULIB4) VALUE(&BULIB5)
             CHGVAR     VAR(&BULIB5) VALUE('      ')
             ENDDO
             IF         COND(&BULIB2 *EQ ' ') THEN(DO)
             CHGVAR     VAR(&BULIB2) VALUE(&BULIB3)
             CHGVAR     VAR(&BULIB3) VALUE(&BULIB4)
             CHGVAR     VAR(&BULIB4) VALUE(&BULIB5)
             CHGVAR     VAR(&BULIB5) VALUE('      ')
             ENDDO
             IF         COND(&BULIB3 *EQ ' ') THEN(DO)
             CHGVAR     VAR(&BULIB3) VALUE(&BULIB4)
             CHGVAR     VAR(&BULIB4) VALUE(&BULIB5)
             CHGVAR     VAR(&BULIB5) VALUE('      ')
             ENDDO
             IF         COND(&BULIB4 *EQ ' ') THEN(DO)
             CHGVAR     VAR(&BULIB4) VALUE(&BULIB5)
             CHGVAR     VAR(&BULIB5) VALUE('      ')
             ENDDO
             IF         COND(&COUNTER *LT 3) THEN(DO)
             CHGVAR     VAR(&COUNTER) VALUE(&COUNTER + 1)
             GOTO       CMDLBL(CHK1)
             ENDDO

     /****************************************************************/
     /*   CHECK FOR EXISTENCE OF DTAARA.  CREATE IF NOT THERE        */
     /****************************************************************/

             IF         COND(&BUDTAARA *EQ ' ') THEN(DO)
             CHGVAR     VAR(&BUERR) VALUE('Data Area must be +
                          specified')
             CHGVAR     VAR(&IN10) VALUE('1')
             GOTO       CMDLBL(SEND2)
             ENDDO
             CHKOBJ     OBJ(&BUDTALIB/&BUDTAARA) OBJTYPE(*DTAARA)
             MONMSG     MSGID(CPF0000) EXEC(CRTDTAARA +
                          DTAARA(&BUDTALIB/&BUDTAARA) TYPE(*CHAR) +
                          LEN(1000) TEXT('automatic backup +
                          procedure dtaara'))
             MONMSG     MSGID(CPF0000) EXEC(DO)
             CHGVAR     VAR(&BUERR) VALUE('DATA AREA not created.  +
                          See job log')
             CHGVAR     VAR(&IN10) VALUE('1')
             GOTO       CMDLBL(SEND2)
             ENDDO
     /****************************************************************/
     /*   CHANGE THE DATA AREA FOR DEFAULTS WITH VALUES FROM SCREEN  */
     /****************************************************************/
             CHGVAR     VAR(%SST(&DEFAULTS 1   10)) VALUE(&BUSYS1 )
             CHGVAR     VAR(%SST(&DEFAULTS 11  10)) VALUE(&BUSYS2 )
             CHGVAR     VAR(%SST(&DEFAULTS 21  10)) VALUE(&BUSYS3 )
             CHGVAR     VAR(%SST(&DEFAULTS 31  10)) VALUE(&BUSYSLIB)
             CHGVAR     VAR(%SST(&DEFAULTS 41  10)) VALUE(&BUFILE1)
             CHGVAR     VAR(%SST(&DEFAULTS 51  10)) VALUE(&BUFILE2)
             CHGVAR     VAR(%SST(&DEFAULTS 61  10)) VALUE(&BUFILE3)
             CHGVAR     VAR(%SST(&DEFAULTS 71  10)) VALUE(&BUFILE4)
             CHGVAR     VAR(%SST(&DEFAULTS 81  10)) VALUE(&BUFILE5)
             CHGVAR     VAR(%SST(&DEFAULTS 91  10)) VALUE(&BUFLIB1)
             CHGVAR     VAR(%SST(&DEFAULTS 101 10)) VALUE(&BUFLIB2)
             CHGVAR     VAR(%SST(&DEFAULTS 111 10)) VALUE(&BUFLIB3)
             CHGVAR     VAR(%SST(&DEFAULTS 121 10)) VALUE(&BUFLIB4)
             CHGVAR     VAR(%SST(&DEFAULTS 131 10)) VALUE(&BUFLIB5)
             CHGVAR     VAR(%SST(&DEFAULTS 141 10)) VALUE(&BULIB1 )
             CHGVAR     VAR(%SST(&DEFAULTS 151 10)) VALUE(&BULIB2 )
             CHGVAR     VAR(%SST(&DEFAULTS 161 10)) VALUE(&BULIB3 )
             CHGVAR     VAR(%SST(&DEFAULTS 171 10)) VALUE(&BULIB4 )
             CHGVAR     VAR(%SST(&DEFAULTS 181 10)) VALUE(&BULIB5 )
             CHGVAR     VAR(%SST(&DEFAULTS 191 1))  VALUE(&BUREORG)
             CHGVAR     VAR(%SST(&DEFAULTS 192 1))  VALUE(&BUSAVE )
             CHGVAR     VAR(%SST(&DEFAULTS 193 1))  VALUE(&BULORF )
             CHGVAR     VAR(%SST(&DEFAULTS 194 10)) VALUE(&BUUSER)
             CHGVAR     VAR(%SST(&DEFAULTS 204 10)) VALUE(&BUJOBQ1)
             CHGVAR     VAR(%SST(&DEFAULTS 214 10)) VALUE(&BUJOBQ2)
             CHGVAR     VAR(%SST(&DEFAULTS 224  8)) VALUE(&BUSAVFPFX)
             CHGVAR     VAR(%SST(&DEFAULTS 232 10)) VALUE(&BUSAVFLIB)
             CHGVAR     VAR(%SST(&DEFAULTS 242 10)) VALUE(&BUMEDIUM)
             CHGVAR     VAR(%SST(&DEFAULTS 252  1)) VALUE(&BUWARN)
             CHGVAR     VAR(%SST(&DEFAULTS 253  1)) VALUE(&BUWARNOP)

             CHGDTAARA  DTAARA(&BUDTALIB/&BUDTAARA) VALUE(&DEFAULTS)
     /****************************************************************/
     /*   IF NOT RUNNING THE BACKUP NOW, EXIT THE PROGRAM            */
     /****************************************************************/
             IF         COND(&BURUN *NE 'Y') THEN(GOTO CMDLBL(END))

     /****************************************************************/
     /****************************************************************/
     /********  BEGIN BACKUP PROCEDURE  ******************************/
     /****************************************************************/
     /****************************************************************/
             SBMJOB     CMD(CALL PGM(MCXBACKUP) PARM(&BUDTAARA +
                          &BUDTALIB))
 END:        ENDPGM
