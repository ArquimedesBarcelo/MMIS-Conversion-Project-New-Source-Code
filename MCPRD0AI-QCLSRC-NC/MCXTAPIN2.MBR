             PGM
/*****************************************************************/
/***                                                           ***/
/*** PROGRAM : MCXTAPTAP                                       ***/
/*** PURPOSE : THIS PROGRAM SAVES THE FOLLOWING SAVEFILES      ***/
/***           FROM MCBCK, THESE FILES CONTAIN ALL OBJECTS     ***/
/***           NEEDED FOR A CSIS/MMIS INSTALL.                 ***/
/***                                                           ***/
/***   MCBCK/SAVFMCPRD0                                        ***/
/***         SAVFMCPRD1                                        ***/
/***         SAVFMCMENU                                        ***/
/***         SAVFU@PRD                                         ***/
/***         SAVFU1PRD                                         ***/
/***         SAVFU4PRD                                         ***/
/***                                                           ***/
/*****************************************************************/
/*** 10NOV1992 - NAPANEE INSTALL TAPE.  COMMENTED OUT LOGIC    ***/
/***             RELATED TO LIBRARIES MCMENU, U@PRD, AND U1PRD ***/
/***             SINCE NAPANEE ALREADY HAS THE GLOBAL MENU     ***/
/***             SYSTEM AND SLEEPER INSTALLED.  FOR THIS       ***/
/***             INSTALLATION WE WILL ONLY SEND THE SAVFMCPRD0,***/
/***             SAVFMCPRD1, AND SAVFU4PRD SAVEFILES.          ***/
/***               ---DAVE PLUM                                ***/
/***                                                           ***/
/*** 17NOV1993 - "LATIN AMERICA" INSTALL TAPES.  REATIVATED THE***/
/***             LOGIC RELATED TO LIBRARIES MCMENU, U@PRD, AND ***/
/***             U1PRD.  ALSO COMMENTED OUT ALL "DSPTAP" LOGIC.***/
/***             ALSO CHANGED REFERNCES TO "TAP01" TO READ     ***/
/***             "TAP01".                                      ***/
/***               ---DAVE PLUM                                ***/
/***                                                           ***/
/*** 13NOV1994 - CHANGED ALL REFERENCES TO "TAP01" BACK TO     ***/
/***             "TAP01" TO CUT DAT TAPE FOR GREENSBURG AIR    ***/
/***             PLANT INSTALL.                                ***/
/***               ---BILL ROXBURY                             ***/
/***                                                           ***/
/*****************************************************************/
             DCL        VAR(&REPLY) TYPE(*CHAR) LEN(1)

/***                                                           ***/
/*** INITIALIZE THE FIRST TAPE                                 ***/
/***                                                           ***/
             INZTAP     DEV(TAP01) NEWVOL(MMCS) CHECK(*NO) +
                          DENSITY(1600)

/***                                                           ***/
/*** SAVE ALL THE SAVEFILES ONTO A SINGLE TAPSET, ONE RIGHT    ***/
/*** AFTER THE OTHER                                           ***/
/***                                                           ***/
             SAVSAVFDTA SAVF(MCBCK/SAVFMCPRD0) DEV(TAP01) SEQNBR(1) +
                          ENDOPT(*LEAVE)
             SAVSAVFDTA SAVF(MCBCK/SAVFMCPRD1) DEV(TAP01) SEQNBR(2) +
                          ENDOPT(*LEAVE)

       SAVSAVFDTA SAVF(MCBCK/SAVFMCMENU) DEV(TAP01) SEQNBR(3) +
                    ENDOPT(*LEAVE)
       SAVSAVFDTA SAVF(MCBCK/SAVFU@PRD) DEV(TAP01) SEQNBR(4) +
                    ENDOPT(*LEAVE)
       SAVSAVFDTA SAVF(MCBCK/SAVFU1PRD) DEV(TAP01) SEQNBR(5) +
                    ENDOPT(*LEAVE)

/**** CHANGED SEQNBR FROM 6 TO 3 IN THE FOLLOWING COMMAND - 10NOV92 */
/**** CHANGED SEQNBR FROM 3 TO 6 IN THE FOLLOWING COMMAND - 17NOV93 */
             SAVSAVFDTA SAVF(MCBCK/SAVFU4PRD) DEV(TAP01) SEQNBR(6) +
                          ENDOPT(*UNLOAD)

/***                                                           ***/
/*** HAVE THE USER MOUNT THE FIRST TAPE OF THE TAPESET SO A    ***/
/*** DSPTAP CAN BE DONE                                        ***/
/***                                                           ***/

/***** COMMENTED OUT THE FOLLOWING STMTS RELATED TO DSPTAP - 17NOV93 */

/*****       SNDUSRMSG  MSG('MCXTAPIN2: Mount the first tape of the +   */
/*****                    tapeset for the DSPTAP command ( G - +        */
/*****                    Perform DSPTAP S - Skip DSPTAP command +      */
/*****                    ):') VALUES('G' 'g' 'S' 's') MSGRPY(&REPLY)   */
/*****       IF         COND((&REPLY *EQ 'G') *OR (&REPLY *EQ 'g')) +   */
/*****                    THEN(DO)                                      */

/*****       DSPTAP     DEV(TAP01) SEQNBR(1) DATA(*SAVRST) +            */
/*****                    OUTPUT(*PRINT)                                */
/*****       SNDUSRMSG  MSG('MCXTAPIN2: Mount the second tape of the +  */
/*****                    tapeset for the DSPTAP command ( G - Go +     */
/*****                    ):') VALUES('G' 'g') MSGRPY(&REPLY)           */
/*****       DSPTAP     DEV(TAP01) SEQNBR(2) DATA(*SAVRST) +            */
/*****                    OUTPUT(*PRINT)                                */
/*****       SNDUSRMSG  MSG('MCXTAPIN2: Mount the third tape of the +   */
/*****                    tapeset for the DSPTAP command ( G - Go +     */
/*****                    ):') VALUES('G' 'g') MSGRPY(&REPLY)           */
/*****       DSPTAP     DEV(TAP01) SEQNBR(3) DATA(*SAVRST) +            */
/*****                    OUTPUT(*PRINT)                                */

/* *** COMMENTED OUT THE FOLLOWING 3 DSPTAP COMMANDS - 10NOV92 */
/*           DSPTAP     DEV(TAP01) SEQNBR(4) DATA(*SAVRST) +   */
/*                        OUTPUT(*PRINT)                       */
/*           DSPTAP     DEV(TAP01) SEQNBR(5) DATA(*SAVRST) +   */
/*                        OUTPUT(*PRINT)                       */
/*           DSPTAP     DEV(TAP01) SEQNBR(6) DATA(*SAVRST) +   */
/*                        OUTPUT(*PRINT)                       */

/*****       ENDDO                                                      */
             DSPJOBLOG  OUTPUT(*PRINT)
             ENDPGM
