             PGM PARM(&MBR &FROMRCD &TORCD)
             DCL VAR(&MBR)     TYPE(*CHAR) LEN(10)
             DCL VAR(&FROMRCD) TYPE(*CHAR) LEN(7)
             DCL VAR(&TORCD)   TYPE(*CHAR) LEN(7)
             DCL VAR(&FROMFILE) TYPE(*CHAR) LEN(10)
             DCL VAR(&FROMLIB)  TYPE(*CHAR) LEN(10)
             DCL VAR(&TOFILE) TYPE(*CHAR) LEN(10)
             DCL VAR(&TOLIB)  TYPE(*CHAR) LEN(10)
             DCL VAR(&DSPF)    TYPE(*CHAR) LEN(4)
             RTVDTAARA  DTAARA(*LDA (1 10)) RTNVAR(&FROMFILE)
             RTVDTAARA  DTAARA(*LDA (11 10)) RTNVAR(&FROMLIB)
             RTVDTAARA  DTAARA(*LDA (21 10)) RTNVAR(&TOFILE)
             RTVDTAARA  DTAARA(*LDA (31 10)) RTNVAR(&TOLIB)
             ADDPFM FILE(&TOLIB/&TOFILE) MBR(&MBR)
             MONMSG MSGID(CPF0000)
             CPYF       FROMFILE(&FROMLIB/&FROMFILE) +
                          TOFILE(&TOLIB/&TOFILE) FROMMBR(*FIRST) +
                          TOMBR(&MBR) MBROPT(*REPLACE) +
                          FROMRCD(&FROMRCD) TORCD(&TORCD) +
                          FMTOPT(*CVTSRC)
             MONMSG MSGID(CPF2800)
             ENDPGM
