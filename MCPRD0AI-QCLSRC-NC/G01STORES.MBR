             PGM
/*****************************************************************/
/*** PROGRAM: G01STORES                                        ***/
/*** PURPOSE: TO ADD AND CHANGE DATABASE FILES (PHYSICAL AND   ***/
/***          LOGICAL) FOR THE G01 DATABASE RELEASE.           ***/
/*****************************************************************/
/*                                                               */
/*****************************************************************/
/**********                 STEP 1                ****************/
/**********          STORES REFERENCE FILE        ****************/
/**********     DELETE PHYSICAL STORES REF FILE   ****************/
/**********     CREATE PHYSICAL STORES REF FILE   ****************/
/*****************************************************************/
             DLTF       FILE(MCPRD1/STORES)
             MONMSG     MSGID(CPF2105)
             CRTPF      FILE(MCPRD1/STORES) SRCFILE(*LIBL/QDDSSRCDB) +
                          SRCMBR(STORES) TEXT('STORES    Reference +
                          File') SIZE(*NOMAX)
             SNDMSG     MSG('Step 1 of 4 has COMPLETED NORMALLY in +
                          G01STORES') TOUSR(*SYSOPR)
/*****************************************************************/
/**********                 STEP 2                ****************/
/**********       MCFPCS4800  MEECCMCD            ****************/
/**********   CREATE PHYSICAL AND LOGICAL FILES   ****************/
/*****************************************************************/
             CRTPF      FILE(MCPRD1/MCFPCS5300) +
                          SRCFILE(*LIBL/QDDSSRCDB) +
                          SRCMBR(MCFPCS5300) TEXT('MEECCMCD         +
                          Physical File') SIZE(*NOMAX)
             CRTLF      FILE(MCPRD1/MCFLCS5301) +
                          SRCFILE(*LIBL/QDDSSRCDB) +
                          SRCMBR(MCFLCS5301) TEXT('MEECCMCD         +
                          Logical File (EECCOMCODE)')
             SNDMSG     MSG('Step 2 of 4 has COMPLETED NORMALLY in +
                          G01STORES') TOUSR(*SYSOPR)
/*****************************************************************/
/************               STEP 3                ****************/
/************        MCFPCS5100  MVALIDTYPE       ****************/
/************  CREATE PHYSICAL FILE               ****************/
/************  CREATE LOGICAL FILE                ****************/
/*****************************************************************/
             CRTPF      FILE(MCPRD1/MCFPCS5100) +
                          SRCFILE(*LIBL/QDDSSRCDB) +
                          SRCMBR(MCFPCS5100) TEXT('MVALIDTYPE       +
                          Physical File') SIZE(*NOMAX)
             CRTLF      FILE(MCPRD1/MCFLCS5101) +
                          SRCFILE(*LIBL/QDDSSRCDB) +
                          SRCMBR(MCFLCS5101) TEXT('MVALIDTYPE       +
                          Logical File (VLDCODETYP)')
             SNDMSG     MSG('Step 3 of 4 has COMPLETED NORMALLY in +
                          G01STORES') TOUSR(*SYSOPR)
/*****************************************************************/
/************                 STEP 4              ****************/
/************       MCFPCS5000  DVALIDDATA        ****************/
/************  CREATE PHYSICAL AND LOGICAL FILES  ****************/
/*****************************************************************/
             CRTPF      FILE(MCPRD1/MCFPCS5200) +
                          SRCFILE(*LIBL/QDDSSRCDB) +
                          SRCMBR(MCFPCS5200) TEXT('DVALIDDATA       +
                          Physical File') SIZE(*NOMAX)
             CRTLF      FILE(MCPRD1/MCFLCS5201) +
                          SRCFILE(*LIBL/QDDSSRCDB) +
                          SRCMBR(MCFLCS5201) TEXT('DVALIDDATA       +
                          Logical File (VLDCODETYP)')
             CRTLF      FILE(MCPRD1/MCFLCS5202) +
                          SRCFILE(*LIBL/QDDSSRCDB) +
                          SRCMBR(MCFLCS5202) TEXT('DVALIDDATA       +
                          Logical File (VLDCODEKEY)')
             SNDMSG     MSG('Step 4 of 4 has COMPLETED NORMALLY in +
                          G01STORES') TOUSR(*SYSOPR)
/*****************************************************************/
             DSPJOBLOG  OUTPUT(*PRINT)
             SNDMSG     MSG('G01STORES has ENDED NORMALLY') TOUSR(*SYSOPR)
             ENDPGM
