/*********************************************************************/
/**               T R I G G E R    P R O G R A M                    **/
/*********************************************************************/
/** PROGRAM: TCODEFCL                                               **/
/**                                                                 **/
/** PURPOSE: TRIGGER PROGRAM THAT SUBMITS JOB TO LOAD CODE FILTER   **/
/**          TABLE.                                                 **/
/**                  ----------------------------------             **/
/**                  *INSERT TRIGGER ON FILE MCFPAB0500             **/
/**                  ----------------------------------             **/
/**                                                                 **/
/** CREATED: 11/24/02                                               **/
/** AUTHOR : DAN RAUCH - eXLTech, LLC                               **/
/**                                                                 **/
/*********************************************************************/
/**            M O D I F I C A T I O N    H I S T O R Y             **/
/*********************************************************************/
/** 11\06\2003   DCR01   MODIFIED TO RETREIVE JOBD USING FILE       **/
/**              LIBRARY EXTRACTED FROM TRIGGER BUFFER, THEN        **/
/**              OVERRIDING TO MCFPMMJOBD AND CALLING CL PGM        **/
/**              GETJOBDCL.                                         **/
/** --------------------------------------------------------------- **/
/** XX\XX\XXXX   XXXXXX  XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX  **/
/*********************************************************************/
/** SPECIAL NOTES: -----------------------------------------        **/
/**                SHOULD BE COMPILED TO DATA FILE LIBRARY          **/
/**                -----------------------------------------        **/
/*********************************************************************/
             PGM        PARM(&PARM1  &PARM2)

             DCL        VAR(&PARM1) TYPE(*CHAR) LEN(1500)
             DCL        VAR(&PARM2) TYPE(*CHAR) LEN(2)
             DCL        VAR(&FLIB) TYPE(*CHAR) LEN(10)
             DCL        VAR(&JOBD) TYPE(*CHAR) LEN(10)

/*- BEGIN DCR01 -----------------------------------------------------*/
/*  -------- RTV TRIGGER FILE LIB FROM PASSED TRIGGER BUFFER ------- */
/** GET THE JOBD FROM FILE MCFPMMJOBD IN THE SAME LIB AS TRIGGER PF  */
/** BECAUSE VITRIA USES A STD *LIBL THAT MAY NOT BE SUITABLE FOR     */
/** UPDATING THE REQUIRED ENVIRONMENT (QA,PRD ...ETC). GET THE       */
/** CORRECT ENVIRONMENT LIBRARY(QA,PRD) FROM TRIGGER BUFFER (&PARM1) */
/*-------------------------------------------------------------------*/
             CHGVAR     VAR(&FLIB) VALUE(%SST(&PARM1 11 10))
             OVRDBF     FILE(MCFPMMJOBD) TOFILE(&FLIB/MCFPMMJOBD)

             CALL       PGM(MCPRD/GETJOBDCL) PARM(&JOBD)

             DLTOVR     FILE(MCFPMMJOBD)
/*- END DCR01 -------------------------------------------------------*/

             SBMJOB     CMD(CALL PGM(TCODEFCL2)) JOB(CODEFJOB) +
                          JOBD(&JOBD) USER(*JOBD) SYSLIBL(*SYSVAL) +
                          CURLIB(*CRTDFT) INLLIBL(*JOBD)

ENDIT:       ENDPGM
