/*****************************************************************/
/*                                                               */
/*   PROGRAM: MCXBETA                                            */
/*   PURPOSE: CUT M01 RELEASE OF CSIS/MMIS SOFTWARE TO MCBETA    */
/*                                                               */
/*****************************************************************/
/*   MAY  2, 2005    D. RAUCH    DCR01      REQUEST# 2005-NNNNN   */
/*   MODIFIED FOR RLS M01 TO ACCOMODATE SOX REQMNTS - REPLACED   */
/*   CPYLIB WITH *SAVF PROCESSING TO RETAIN THE INTEGRITY OF THE */
/*   OBJECT CREATE DATE/TIME                                     */
/*   ----------------------------------------------------------  */
/*   MMM DD, 2005  XXXXXXXXXXXXX  XXX01    REQUEST# 2005-NNNNN   */
/*   XXXXXXXXXXXXXXXXXXXXXX MOD DESCRIPTION XXXXXXXXXXXXXXXXXXXX */
/*****************************************************************/
             PGM

             DCL        VAR(&INPLIB) TYPE(*CHAR) LEN(10)
             DCL        VAR(&DBFLIB) TYPE(*CHAR) LEN(10)

             CHGVAR     VAR(&INPLIB) VALUE(MCPRD)
             CHGVAR     VAR(&DBFLIB) VALUE(MCBETA)

             DLTF       FILE(MCBCK/M01SAVF)
             MONMSG     MSGID(CPF2105)

             CRTSAVF    FILE(MCBCK/M01SAVF) TEXT('Release M01 SAVF')

             CLRSAVF    FILE(MCBCK/M01SAVF)
 MCPRD:      SAVOBJ     OBJ(*ALL) LIB(MCPRD) DEV(*SAVF) +
                          SAVF(MCBCK/M01SAVF)

             RSTOBJ     OBJ(*ALL) SAVLIB(MCPRD) DEV(*SAVF) +
                          SAVF(MCBCK/M01SAVF) RSTLIB(MCBETA)

             DSPSAVF    FILE(MCBCK/M01SAVF) OUTPUT(*PRINT)

             CLRSAVF    FILE(MCBCK/M01SAVF)
 MCPRDB:
/*** CREATE PHYSICAL FILES FROM MCPRD QDDSSRCDB IN LIB MCBETA  ***/
             CALL       PGM(M01CRTPFCL) PARM(&DBFLIB &INPLIB)

/*** CREATE LOGICAL  FILES FROM MCPRD QDDSSRCDB IN LIB MCBETA ***/
             CALL       PGM(M01CRTLFCL) PARM(&DBFLIB &INPLIB)

             SAVOBJ     OBJ(QJOBSRC) LIB(MCPRDB) DEV(*SAVF) +
                          SAVF(MCBCK/M01SAVF)

             RSTOBJ     OBJ(*ALL) SAVLIB(MCPRDB) DEV(*SAVF) +
                          SAVF(MCBCK/M01SAVF) RSTLIB(MCBETA)

             CLRSAVF    FILE(MCBCK/M01SAVF)
 RENAME:     RNMOBJ     OBJ(MCBETA/QJOBSRC) OBJTYPE(*FILE) +
                          NEWOBJ(QJOBSRC2)
             RNMOBJ     OBJ(MCBETA/QRJEJCL) OBJTYPE(*FILE) +
                          NEWOBJ(QRJEJCL2)
             SNDMSG     MSG('MCPRD and MCPRDB have been successfully +
                          copied to MCBETA.') TOUSR(QSYSOPR)


             DLTF       FILE(MCBCK/M01SAVF)
             MONMSG     MSGID(CPF2105)


ENDPGM:      DSPJOBLOG  OUTPUT(*PRINT)
             ENDPGM
