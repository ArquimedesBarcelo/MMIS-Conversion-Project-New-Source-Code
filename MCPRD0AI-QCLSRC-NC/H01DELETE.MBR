             PGM
             DCL        VAR(&LIB) TYPE(*CHAR) LEN(5) VALUE('MCPRD')
             DCL        VAR(&LIBN) TYPE(*DEC) LEN(1) VALUE(1)
             DCL        VAR(&LIBC) TYPE(*CHAR) LEN(1)
             DCL        VAR(&CURLIB) TYPE(*CHAR) LEN(6)
/*********************************************************************/
/*  THIS PROGRAM WILL ATTEMPT TO DELETE EACH OBSOLETE CSIS/MMIS      */
/*  OBJECT WHICH MAY EXIST ON A PLANT SYSTEM.                        */
/*                                                                   */
/*  FOR CSIS/MMIS RELEASE "H 0100" THE FOLLOWING OBJECTS SHOULD BE   */
/*  DELETED:                                                         */
/*                                                                   */
/*   - PROGRAM LIBRARY OBJECTS (LIBRARY MCPRD)                       */
/*     =======================================                       */
/*     - OBSOLETE CSAS REPORT PROGRAM TTRNSRPT AND RELATED OBJECTS   */
/*        - TRPTJ087    *PGM  CBL     DAVE PLUM    16FEB94           */
/*        - FOTTRNSRPT  *PGM  CL      DAVE PLUM    16FEB94           */
/*        - TTRNSRPT    *PGM  CBL     DAVE PLUM    16FEB94           */
/*     - OLD CSAS PROGRAM TINVCLAS    DAVE PLUM    07MAR94           */
/*     - OLD CSAS FREIGHT PROGRAMS    DAVE PLUM    19OCT94           */
/*        - TFILELMD, TSORTELM, TLOADFRT, TPAYFRT                    */
/*     - MCHEADERS MEMBERS DHDR03 AND DHDR61                         */
/*                                                                   */
/*   - DATA LIBRARY OBJECTS (LIBRARIES MCPRD1, MCPRD2, MCPRD3, ...)  */
/*     ============================================================  */
/*     - OLD CSAS DATABASE FILE DAPPLFRT (NEW FILE IS MCFPCA1100)    */
/*        - MCFLCA0801  *FILE LF      DAVE PLUM    16FEB94           */
/*        - MCFLCA0802  *FILE LF      DAVE PLUM    16FEB94           */
/*        - MCFLCA0803  *FILE LF      DAVE PLUM    16FEB94           */
/*        - MCFLCA0804  *FILE LF      DAVE PLUM    16FEB94           */
/*        - MCFLCA0805  *FILE LF      DAVE PLUM    16FEB94           */
/*        - MCFPCA0800  *FILE PF      DAVE PLUM    16FEB94           */
/*     - OLD "TO DO" PHYSICAL AND LOGICAL FILES                      */
/*        - MCFLTODO01  *FILE LF      DAVE PLUM    15APR94           */
/*        - MCFLTODO02  *FILE LF      DAVE PLUM    15APR94           */
/*        - MCFPTODO    *FILE PF      DAVE PLUM    15APR94           */
/*        - MCFPTODOS1  *FILE PF      DAVE PLUM    15APR94           */
/*     - OLD FREIGHT ACCOUNTING QJOBSRC MEMBERS (CL PGMS)            */
/*        - BHPFR, BXFRT, BXFRTSAV                                   */
/*     - OLD FREIGHT ACCOUNTING SEQUENTIAL FILES                     */
/*        - APPL* (INCLUDING APPLFRGT, APPL02, APPL03, ...,APPLNW01, */
/*                 APPLNW02, ..., APPLDP01, APPLDP02, ...,)          */
/*                                                                   */
/*********************************************************************/
/* SET CURLIB TO THE CSIS/MMIS PROGRAM LIBRARY NAME (MCPRD) */
             CHGCURLIB  CURLIB(MCPRD)
             MONMSG     MSGID(CPF0000)

             SNDMSG     MSG('Program H01DELETE is now deleting +
                          obsolete objects from CSIS/MMIS program +
                          library - MCPRD)') TOUSR(*REQUESTER)

             DLTPGM     PGM(*CURLIB/TRPTJ087)
             MONMSG     MSGID(CPF0000)
             DLTPGM     PGM(*CURLIB/FOTTRNSRPT)
             MONMSG     MSGID(CPF0000)
             DLTPGM     PGM(*CURLIB/TTRNSRPT)
             MONMSG     MSGID(CPF0000)

             DLTPGM     PGM(*CURLIB/TINVCLAS)
             MONMSG     MSGID(CPF0000)

             DLTPGM     PGM(*CURLIB/TFILELMD)
             MONMSG     MSGID(CPF0000)
             DLTPGM     PGM(*CURLIB/TSORTELM)
             MONMSG     MSGID(CPF0000)
             DLTPGM     PGM(*CURLIB/TLOADFRT)
             MONMSG     MSGID(CPF0000)
             DLTPGM     PGM(*CURLIB/TPAYFRT)
             MONMSG     MSGID(CPF0000)

             RMVM       FILE(*CURLIB/MCHEADERS) MBR(DHDR03)
             MONMSG     MSGID(CPF0000)
             RMVM       FILE(*CURLIB/MCHEADERS) MBR(DHDR61)
             MONMSG     MSGID(CPF0000)

/*##############################################################*/
/* WE WILL NOW LOOP THROUGH ALL EXISTING CSIS/MMIS DATA         */
/* LIBRARIES STARTING WITH MCPRD1, AND THEN GOING ON TO MCPRD2, */
/* MCPRD3, ETC.; UNTIL THE DATA LIBRARY DOES NOT EXIST.         */
/*##############################################################*/
LOOP:
             CHGVAR     VAR(&LIBC) VALUE(&LIBN)
             CHGVAR     VAR(&CURLIB) VALUE(&LIB *CAT &LIBC)

/*** CHECK TO SEE IF DATA LIBRARY MCPRD* EXISTS.  IF IT DOES NOT EXIST, ***/
/*** END THIS PROGRAM.                                                  ***/
             CHKOBJ     OBJ(QSYS/&CURLIB) OBJTYPE(*LIB)
             MONMSG     MSGID(CPF9801) EXEC(GOTO CMDLBL(ENDPGM))
             CHGCURLIB  CURLIB(&CURLIB)
             SNDMSG     MSG('Program H01DELETE is now deleting +
                          obsolete objects from  CSIS/MMIS data +
                          library - ' *CAT &CURLIB) TOUSR(*REQUESTER)

             DLTF       FILE(*CURLIB/MCFLCA0801)
             MONMSG     MSGID(CPF0000)
             DLTF       FILE(*CURLIB/MCFLCA0802)
             MONMSG     MSGID(CPF0000)
             DLTF       FILE(*CURLIB/MCFLCA0803)
             MONMSG     MSGID(CPF0000)
             DLTF       FILE(*CURLIB/MCFLCA0804)
             MONMSG     MSGID(CPF0000)
             DLTF       FILE(*CURLIB/MCFLCA0805)
             MONMSG     MSGID(CPF0000)
             DLTF       FILE(*CURLIB/MCFPCA0800)
             MONMSG     MSGID(CPF0000)
             DLTF       FILE(*CURLIB/MCFLTODO01)
             MONMSG     MSGID(CPF0000)
             DLTF       FILE(*CURLIB/MCFLTODO02)
             MONMSG     MSGID(CPF0000)
             DLTF       FILE(*CURLIB/MCFPTODO)
             MONMSG     MSGID(CPF0000)
             DLTF       FILE(*CURLIB/MCFPTODOS1)
             MONMSG     MSGID(CPF0000)

             DLTPGM     PGM(*CURLIB/BHPFR)
             MONMSG     MSGID(CPF0000)
             DLTPGM     PGM(*CURLIB/BXFRT)
             MONMSG     MSGID(CPF0000)
             DLTPGM     PGM(*CURLIB/BXFRTSAV)
             MONMSG     MSGID(CPF0000)
             RMVM       FILE(*CURLIB/QJOBSRC) MBR(BHPFR)
             MONMSG     MSGID(CPF0000)
             RMVM       FILE(*CURLIB/QJOBSRC) MBR(BXFRT)
             MONMSG     MSGID(CPF0000)
             RMVM       FILE(*CURLIB/QJOBSRC) MBR(BXFRTSAV)
             MONMSG     MSGID(CPF0000)

             DLTF       FILE(*CURLIB/APPL*)
             MONMSG     MSGID(CPF0000)

/*** INCREMENT THE LIBRARY NAME BY 1, AND GO BACK TO THE BEGINNING   ***/
/*** DATA LIBRARY SECTION OF THE PROGRAM.                            ***/
             CHGVAR     VAR(&LIBN) VALUE(&LIBN + 1)
             GOTO       CMDLBL(LOOP)

 ENDPGM:     SNDMSG     MSG('Program H01DELETE has ended normally') +
                          TOUSR(*REQUESTER)
             ENDPGM
