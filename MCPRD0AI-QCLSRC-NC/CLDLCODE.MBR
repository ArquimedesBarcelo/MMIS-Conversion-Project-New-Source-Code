PGM PARM(&DBPARMS &LINKS)
             DCL        VAR(&DBPARMS) TYPE(*CHAR) LEN(100)
             DCL        VAR(&LINKS)   TYPE(*CHAR) LEN(100)
             CHKOBJ     OBJ(QTEMP/DISTLIST) OBJTYPE(*FILE)
             MONMSG     MSGID(CPF9800) EXEC(DO)
             CRTPF      FILE(QTEMP/DISTLIST) RCDLEN(59)
             ENDDO
             CLRPFM     FILE(QTEMP/DISTLIST)
             OVRDBF     FILE(DISTLIST) TOFILE(QTEMP/DISTLIST)
             CALL       PGM(*LIBL/TDLCODE) PARM(&DBPARMS &LINKS)
             DLTOVR     FILE(DISTLIST)
             ENDPGM
