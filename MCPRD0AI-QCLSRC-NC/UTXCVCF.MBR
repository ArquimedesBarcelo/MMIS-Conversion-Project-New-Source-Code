             PGM  PARM(&CPYFQ &SRCFQ)
             DCL  VAR(&CPYFQ)    TYPE(*CHAR) LEN(20)
             DCL  VAR(&SRCFQ)    TYPE(*CHAR) LEN(20)
             DCL  VAR(&CPYFILE)  TYPE(*CHAR) LEN(10)
             DCL  VAR(&CPYLIB)   TYPE(*CHAR) LEN(10)
             DCL  VAR(&SRCFILE)  TYPE(*CHAR) LEN(10)
             DCL  VAR(&SRCLIB)   TYPE(*CHAR) LEN(10)
             DCL  VAR(&MSGDTA)   TYPE(*CHAR) LEN(80)
             DCL  VAR(&MSGID)    TYPE(*CHAR) LEN(7)
             DCL  VAR(&MSGF)     TYPE(*CHAR) LEN(10)
             DCL  VAR(&MSGFLIB)  TYPE(*CHAR) LEN(10)
             DCL  VAR(&LDA)      TYPE(*CHAR) LEN(2000)
/* * */
             MONMSG MSGID(CPF0000 MCH0000) EXEC(GOTO CPFERROR)
             RTVDTAARA  DTAARA(*LDA) RTNVAR(&LDA)
/* GET COPY FILE & LIBRARY */
             CHGVAR VAR(&CPYFILE) VALUE(%SST(&CPYFQ 1 10))
             CHGVAR VAR(&CPYLIB)  VALUE(%SST(&CPYFQ 11 10))
/* CHECK COPY FILE EXISTENCE */
             CHKOBJ     OBJ(&CPYLIB/&CPYFILE) OBJTYPE(*FILE)
/* GET SOURCE FILE & LIBRARY */
             CHGVAR VAR(&SRCFILE) VALUE(%SST(&SRCFQ 1 10))
             CHGVAR VAR(&SRCLIB)  VALUE(%SST(&SRCFQ 11 10))
/* CHECK SOURCE FILE EXISTENCE */
             CHKOBJ     OBJ(&SRCLIB/&SRCFILE) OBJTYPE(*FILE)
/* SET LOCAL DATA AREA TO PARMS PASSED */
             CHGDTAARA  DTAARA(*LDA (1 10))  VALUE(&CPYFILE)
             CHGDTAARA  DTAARA(*LDA (11 10)) VALUE(&CPYLIB)
             CHGDTAARA  DTAARA(*LDA (21 10)) VALUE(&SRCFILE)
             CHGDTAARA  DTAARA(*LDA (31 10)) VALUE(&SRCLIB)
/* CONVERT COPY FILE TO SOURCE */
             OVRDBF     FILE(CPYSRC) TOFILE(&CPYLIB/&CPYFILE)
             CALL   UTCCVCF
             DLTOVR FILE(CPYSRC)
             CHGDTAARA  DTAARA(*LDA) VALUE(&LDA)
             RETURN
CPFERROR:
             RCVMSG     MSGTYPE(*EXCP) MSGDTA(&MSGDTA) MSGID(&MSGID) +
                          MSGF(&MSGF) MSGFLIB(&MSGFLIB)
             SNDPGMMSG  MSGID(&MSGID) MSGF(&MSGFLIB/&MSGF) +
                          MSGDTA(&MSGDTA)
             MONMSG MSGID(CPF0000)
             CHGDTAARA  DTAARA(*LDA) VALUE(&LDA)
             ENDPGM
