         /*****************************************************/
         /*  PGM NAME: CLDSPDOC                               */
         /*                                                   */
         /*  CL SUBPROGRAM USED TO DISPLAY DOCUMENT WHICH     */
         /*  CONTAINS INFORMATION CONCERNING A CSIS/MMIS      */
         /*  ENHANCEMENT SELECTED BY  THE  USER  IN  THE      */
         /*  CSIS/MMIS ONLINE DOCUMENTATION SYSTEM.           */
         /*                                                   */
         /*  USED IN PROGRAM(S): TDOCDSP                      */
         /*                                                   */
         /*  VAR(S)  PASSED    : DOCMNT, FOUND                */
         /*                                                   */
         /* 10/15/97   JEFF BUNGO                             */
         /*   CHANGED PROGRAM TO RETRIEVE THE CURRENT FOLDER  */
         /*   FROM DATAAREA MCDADSFLR.                        */
         /*****************************************************/
             PGM PARM(&DOCMNT &FOUND)
             DCL        VAR(&JOB)    TYPE(*CHAR) LEN(10)
             DCL        VAR(&USER)   TYPE(*CHAR) LEN(10)
             DCL        VAR(&NBR)    TYPE(*CHAR) LEN(06)
             DCL        VAR(&DOCMNT) TYPE(*CHAR) LEN(10)
             DCL        VAR(&CHR)    TYPE(*CHAR) LEN(01)
             DCL        VAR(&FOUND)  TYPE(*CHAR) LEN(01)
             DCL        VAR(&FLR)    TYPE(*CHAR) LEN(10)

             RTVJOBA    JOB(&JOB) USER(&USER) NBR(&NBR)
         /*  CHKDLO     DLO(&DOCMNT) FLR(J0100FLR) OBJTYPE(*DOC)  */
         /*  MONMSG     MSGID(CPF8A82) EXEC(GOTO CMDLBL(DOCNFD))  */
             RTVDTAARA  DTAARA(MCDADSFLR) RTNVAR(&FLR)
 DOCFND:     DSPHLPDOC  DOC(&DOCMNT) FLR(&FLR)
             MONMSG     MSGID(OFC87B2 OFC87B4 OFC9040 OFC9041) +
                          EXEC(GOTO CMDLBL(DOCNFD))
             GOTO ENDPGM
 DOCNFD:     CHGVAR VAR(&FOUND) VALUE(N)
             GOTO ENDPGM
 ENDPGM:
             ENDPGM
