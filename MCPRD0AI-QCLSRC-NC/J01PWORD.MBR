             PGM
/*****************************************************************/
/*** PROGRAM: J01PWORD                                         ***/
/*** PURPOSE: TO ADD AND CHANGE DATABASE FILES (PHYSICAL AND   ***/
/***          LOGICAL) FOR THE J01 DATABASE RELEASE.           ***/
/***          THIS WILL HANDLE ALL DATABASES IN CSIS/MMIS.     ***/
/***                                                           ***/
/***          THIS PROGRAM WILL CONTAIN SPECIAL OPERATIONS     ***/
/***          FOR THIS J01 RELEASE WHICH ARE FOR THE EXPANSION ***/
/***          OF CURRENT DATE FIELDS TO INCLUDE THE CENTURY.   ***/
/***                                                           ***/
/***          THIS PROGRAM CHECKS FOR THE EXISTENCE OF DATA    ***/
/***          LIBRARY MCPRD* (WHERE "*" IS AN INTEGER THAT IS  ***/
/***          INITIALLY SET TO 1), UPDATES THIS LIBRARY IF IT  ***/
/***          EXISTS, THEN INCREMENTS THE DATA LIBRARY NAME    ***/
/***          BY 1, AND CONTINUES LOOPING UNTIL THE INTEGER    ***/
/***          EXCEEDS 9, AT WHICH TIME THE PROGRAM ENDS        ***/
/*****************************************************************/
             DCL        VAR(&LIB)    TYPE(*CHAR) LEN(5) VALUE('MCPRD')
             DCL        VAR(&LIBN) TYPE(*DEC) LEN(1) VALUE(1)
             DCL        VAR(&LIBC) TYPE(*CHAR) LEN(1)
             DCL        VAR(&CURLIB) TYPE(*CHAR) LEN(6)
             DCL        VAR(&NBRCURRCD) TYPE(*DEC) LEN(10 0)

             CHGJOB     LOG(4 0 *SECLVL) LOGCLPGM(*YES)
LOOP:
             CHGVAR     VAR(&LIBC) VALUE(&LIBN)
             CHGVAR     VAR(&CURLIB) VALUE(&LIB *CAT &LIBC)

/*** CHECK TO SEE IF DATA LIBRARY MCPRD* EXISTS.  IF IT DOES NOT EXIST, ***/
/*** AND MCPRD9 WAS JUST CHECKED THEN END; OTHERWISE GO BACK TO LOOP.      ***/
             CHKOBJ     OBJ(QSYS/&CURLIB) OBJTYPE(*LIB)
             MONMSG     MSGID(CPF9801) EXEC(DO)
                 IF COND(&LIBN *EQ 9) THEN(GOTO CMDLBL(ENDLOOP))
                 CHGVAR VAR(&LIBN) VALUE(&LIBN + 1)
                 GOTO CMDLBL(LOOP)
             ENDDO

             CHGCURLIB  CURLIB(&CURLIB)
             SNDMSG     MSG('Program J01PWORD is now updating  +
                          CSIS/MMIS data library - ' *CAT &CURLIB) +
                          TOUSR(*SYSOPR)

/*****************************************************************/
/****  COPY CURRENT MCFP* FILES TO THE ICFP* INTERMEDIATE     ****/
/****  FILES THAT SHOULD HAVE ALREADY BEEN RESTORED FOR J01.  ****/
/****  THIS IS THE FIRST STEP IN EXPANDING THE FILES FOR      ****/
/****  DATES THAT INCLUDE CENTURY.  A TWO BYTE FIELD IS ADDED ****/
/****  BEFORE EACH DATE FIELD AND DEFAULTED TO A VALUE OF 19. ****/
/****  EACH CPYF SHOULD BE DONE WITH *MAP FOR THIS STEP.      ****/
/****  NO COMPILING OF DDS SHOULD BE DONE IN THIS STEP.       ****/
/*****************************************************************/

STEP1:
/*****************************************************************/
/************             MCFPPW0100              ****************/
/************ COPY DATA TO INTERMEDIATE FILE      ****************/
/*****************************************************************/
             CHKOBJ     OBJ(*CURLIB/MCFPPW0100) OBJTYPE(*FILE)
             MONMSG     MSGID(CPF9801) EXEC(GOTO CMDLBL(STEP2))
             CHKOBJ     OBJ(*CURLIB/ICFPPW0100) OBJTYPE(*FILE)
             MONMSG     MSGID(CPF9801) EXEC(DO)
                 SNDMSG   MSG('CSIS/MMIS intermediate file ICFPPW0100 +
                          does not exist.  J01PWORD skipping this +
                          step either because the step had been +
                          completed or file was not restored.  If +
                          not restored, restore this intermediate +
                          file and attempt to run J01PWORD again.') +
                          TOUSR(QSYSOPR)
                 GOTO   CMDLBL(END)
             ENDDO
             RTVMBRD    FILE(*CURLIB/MCFPPW0100) NBRCURRCD(&NBRCURRCD)
             IF         (&NBRCURRCD *GT 0) THEN(DO)
             CPYF       FROMFILE(*CURLIB/MCFPPW0100) +
                          TOFILE(*CURLIB/ICFPPW0100) +
                          MBROPT(*REPLACE) FMTOPT(*MAP)
             MONMSG     MSGID(CPF0000) EXEC(DO)
             SNDMSG     MSG('CSIS/MMIS J01PWORD ERROR.  Error copying +
                          MCFPPW0100 data to intermediate file.  +
                          Check joblog, resolve error and attempt +
                          to run J01PWORD again.') TOUSR(QSYSOPR)
                 GOTO   CMDLBL(ENDPGM)
             ENDDO
             ENDDO
STEP2:
/*****************************************************************/
/**********           PWORD REFERENCE FILE        ****************/
/*****************************************************************/
             DLTF       FILE(*CURLIB/PWORD)
             MONMSG     MSGID(CPF2105)
             CRTPF      FILE(*CURLIB/PWORD) +
                          SRCFILE(*LIBL/QDDSSRCDB) SRCMBR(PWORD) +
                          TEXT(*SRCMBRTXT) SIZE(*NOMAX)
STEP3:
/*****************************************************************/
/************             MCFPPW0100              ****************/
/************  A) DELETE LOGICAL FILES            ****************/
/************  B) DELETE PHYSICAL FILE            ****************/
/************  C) CREATE PHYSICAL FILE            ****************/
/************  D) COPY ICFP* FILE INTO MCFP* FILE ****************/
/************  E) CREATE LOGICAL FILES            ****************/
/*****************************************************************/
             CHKOBJ     OBJ(*CURLIB/MCFPPW0100) OBJTYPE(*FILE)
             MONMSG     MSGID(CPF9801) EXEC(GOTO CMDLBL(STEP4))
             DLTF       FILE(*CURLIB/MCFLPW0101)
             MONMSG     MSGID(CPF2105)
             DLTF       FILE(*CURLIB/MCFPPW0100)
             MONMSG     MSGID(CPF2105)
             CRTPF      FILE(*CURLIB/MCFPPW0100) +
                          SRCFILE(*LIBL/QDDSSRCDB) +
                          SRCMBR(MCFPPW0100) TEXT(*SRCMBRTXT) +
                          SIZE(*NOMAX)
             MONMSG     MSGID(CPF0000) EXEC(DO)
                 SNDMSG MSG('CSIS/MMIS J01PWORD ERROR.  Error +
                          creating MCFPPW0100 file.  Check joblog, +
                          resolve error and attempt to run J01PWORD +
                          again.') TOUSR(QSYSOPR)
                 GOTO   CMDLBL(ENDPGM)
             ENDDO
             RTVMBRD    FILE(*CURLIB/ICFPPW0100) NBRCURRCD(&NBRCURRCD)
             IF         (&NBRCURRCD *GT 0) THEN(DO)
             CPYF       FROMFILE(*CURLIB/ICFPPW0100) +
                          TOFILE(*CURLIB/MCFPPW0100) MBROPT(*REPLACE) +
                          FMTOPT(*NOCHK)
             MONMSG     MSGID(CPF0000) EXEC(DO)
             SNDMSG     MSG('CSIS/MMIS J01PWORD ERROR.  Error +
                          copying intermediate file to MCFPPW0100 +
                          file.  Check joblog, resolve error and +
                          attempt to run J01PWORD again.') +
                          TOUSR(QSYSOPR)
                 GOTO   CMDLBL(ENDPGM)
             ENDDO
             ENDDO
             CRTLF      FILE(*CURLIB/MCFLPW0101) +
                          SRCFILE(*LIBL/QDDSSRCDB) +
                          SRCMBR(MCFLPW0101) TEXT(*SRCMBRTXT)
             DLTF       FILE(*CURLIB/ICFPPW0100)
/*****************************************************************/
/************ RESET C FOR BLANK YMD USING RUNSQL  ****************/
/*****************************************************************/
STEP4:
             CHKOBJ     OBJ(*LIBL/RUNSQL) OBJTYPE(*PGM)
             MONMSG     MSGID(CPF9801) EXEC(DO)
               SNDMSG     MSG('Century not reset to blank for blank +
                          YMD in PWORD because RUNSQL does not +
                          exist. Contact CSIS programming.') +
                          TOUSR(QSYSOPR)
               GOTO       CMDLBL(END)
             ENDDO
             CHKOBJ     OBJ(*CURLIB/MCFPPW0100) OBJTYPE(*FILE)
             MONMSG     MSGID(CPF9801) EXEC(GOTO CMDLBL(END))
             RUNSQL     REQUEST('UPDATE MCFPPW0100 +
                             SET PWDATEINIT = ''        '' +
                             WHERE SUBSTR(PWDATEINIT,3,6) = ''      ''')
             RUNSQL     REQUEST('UPDATE MCFPPW0100 +
                             SET PWLASTDATU = ''        '' +
                             WHERE SUBSTR(PWLASTDATU,3,6) = ''      ''')
/*****************************************************************/
             SNDMSG     MSG('Program J01PWORD has successfully +
                          updated  CSIS/MMIS data library - ' *CAT +
                          &CURLIB) TOUSR(*SYSOPR)

END:
/*** INCREMENT THE LIBRARY NAME BY 1, AND GO BACK TO THE BEGINNING   ***/
/*** OF THE PROGRAM.                                                 ***/
             CHGVAR     VAR(&LIBN) VALUE(&LIBN + 1)
             GOTO       CMDLBL(LOOP)

ENDLOOP:
             SNDMSG     MSG('J01PWORD has ENDED NORMALLY') +
                          TOUSR(*SYSOPR)

/*****************************************************************/
ENDPGM:
             ENDPGM
