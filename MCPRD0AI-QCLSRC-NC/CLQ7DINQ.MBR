PGM PARM(&DBPARMS &VPARMS &CPARMS)
             DCL        VAR(&DBPARMS) TYPE(*CHAR) LEN(100)
             DCL        VAR(&VPARMS)  TYPE(*CHAR) LEN(120)
             DCL        VAR(&CPARMS)  TYPE(*CHAR) LEN(120)
             CHKOBJ     OBJ(QTEMP/OUTFIQ7D) OBJTYPE(*FILE)
             MONMSG     MSGID(CPF9800) EXEC(DO)
             CRTPF      FILE(QTEMP/OUTFIQ7D) RCDLEN(70)
             ENDDO
             CLRPFM     FILE(QTEMP/OUTFIQ7D)
             OVRDBF     FILE(OUTFIQ7D) TOFILE(QTEMP/OUTFIQ7D)
             CALL       PGM(*LIBL/TQ7SUBD) +
                        PARM(&DBPARMS &VPARMS &CPARMS)
             DLTOVR     FILE(OUTFIQ7D)
             ENDPGM
