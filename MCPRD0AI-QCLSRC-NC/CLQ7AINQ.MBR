PGM PARM(&DBPARMS &VPARMS &CPARMS)
             DCL        VAR(&DBPARMS) TYPE(*CHAR) LEN(100)
             DCL        VAR(&VPARMS)  TYPE(*CHAR) LEN(120)
             DCL        VAR(&CPARMS)  TYPE(*CHAR) LEN(120)
             CHKOBJ     OBJ(QTEMP/OUTFIQ7A) OBJTYPE(*FILE)
             MONMSG     MSGID(CPF9800) EXEC(DO)
             CRTPF      FILE(QTEMP/OUTFIQ7A) RCDLEN(70)
             ENDDO
             CLRPFM     FILE(QTEMP/OUTFIQ7A)
             OVRDBF     FILE(OUTFIQ7A) TOFILE(QTEMP/OUTFIQ7A)
             CALL       PGM(*LIBL/TQ7SUBA) +
                        PARM(&DBPARMS &VPARMS &CPARMS)
             DLTOVR     FILE(OUTFIQ7A)
             ENDPGM
