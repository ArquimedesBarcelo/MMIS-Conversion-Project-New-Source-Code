             PGM        PARM(&VALUE &POS &LENGTH &STATUS)
             DCL        VAR(&VALUE) TYPE(*CHAR) LEN(4)
             DCL        VAR(&POS) TYPE(*CHAR) LEN(4)
             DCL        VAR(&LENGTH) TYPE(*CHAR) LEN(4)
             DCL        VAR(&STATUS) TYPE(*CHAR) LEN(2)
             DCL        VAR(&POS2) TYPE(*DEC) LEN(4) VALUE(0)
             CHGVAR     VAR(&STATUS) VALUE('00')
             CHGVAR     VAR(&POS2) VALUE(&POS)
             IF ((&POS2 < 257) *OR (&POS2 > 512)) THEN(DO)
                   CHGVAR     VAR(&STATUS) VALUE('98')
                   GOTO EOJ
                   ENDDO
             CHGDTAARA  DTAARA(*LDA (&POS &LENGTH)) VALUE(&VALUE)
             MONMSG     MSGID(CPF0000) EXEC(DO)
                   CHGVAR     VAR(&STATUS) VALUE('99')
                   ENDDO
 EOJ:        ENDPGM
