             PGM        PARM(&LIB &FILE &RCDL &NRCD &INCAMT &NOINC +
                          &STATUS)
             DCL        VAR(&LIB) TYPE(*CHAR) LEN(10)
             DCL        VAR(&FILE) TYPE(*CHAR) LEN(10)
             DCL        VAR(&RCDL) TYPE(*CHAR) LEN(4)
             DCL        VAR(&NRCD) TYPE(*CHAR) LEN(5)
             DCL        VAR(&INCAMT) TYPE(*CHAR) LEN(5)
             DCL        VAR(&NOINC) TYPE(*CHAR) LEN(2)
             DCL        VAR(&STATUS) TYPE(*CHAR) LEN(2)
             DCL        VAR(&DRCDL) TYPE(*DEC) LEN(4 0)
             DCL        VAR(&DNRCD) TYPE(*DEC) LEN(5 0)
             DCL        VAR(&DINCAMT) TYPE(*DEC) LEN(5 0)
             DCL        VAR(&DNOINC) TYPE(*DEC) LEN(2 0)
             IF (&LIB = '*LIBL') THEN(DO)
                 CHGVAR VAR(&LIB) VALUE('*CURLIB')
             ENDDO
/*  CHECK TO MAKE SURE RCDL, NRCD, INCAMT, NOINC ALL ALL NUMERIC  */
/*  IF ANY FIELD IS NOT NUMERIC SET IT TO A PREDETERMINED DEFAULT */
             CHGVAR     VAR(&DRCDL) VALUE(&RCDL)
             MONMSG     MSGID(CPF0000) EXEC(DO)
                 CHGVAR VAR(&DRCDL) VALUE(133)
                 ENDDO
             CHGVAR     VAR(&DNRCD) VALUE(&NRCD)
             MONMSG     MSGID(CPF0000) EXEC(DO)
                 CHGVAR VAR(&DNRCD) VALUE(10000)
                 ENDDO
             CHGVAR     VAR(&DINCAMT) VALUE(&INCAMT)
             MONMSG     MSGID(CPF0000) EXEC(DO)
                 CHGVAR VAR(&DINCAMT) VALUE(1000)
                 ENDDO
             CHGVAR     VAR(&DNOINC) VALUE(&NOINC)
             MONMSG     MSGID(CPF0000) EXEC(DO)
                 CHGVAR VAR(&DNOINC) VALUE(03)
                 ENDDO
             CHGVAR     VAR(&STATUS) VALUE('00')
             IF (&LIB  = '          ') DO
                CHGVAR    VAR(&LIB) VALUE('*CURLIB')
             ENDDO
             CHKOBJ     OBJ(&LIB/&FILE) OBJTYPE(*FILE) MBR(*FIRST) +
                          AUT(*OBJEXIST)
             MONMSG     MSGID(CPF0000) EXEC(DO)
                 IF (&LIB *EQ '*CURLIB') THEN(DO)
                     CRTPF      FILE(&FILE) RCDLEN(&DRCDL) +
                                SIZE(&DNRCD &DINCAMT &DNOINC)
                     MONMSG  MSGID(CPF0000) EXEC(DO)
                           CHGVAR VAR(&STATUS) VALUE('99')
                     ENDDO
                     GRTOBJAUT  OBJ(*CURLIB/&FILE) OBJTYPE(*FILE) +
                                  USER(*PUBLIC) AUT(*ALL)
                 ENDDO
                 ELSE DO
                     CRTPF      FILE(&LIB/&FILE) RCDLEN(&DRCDL) +
                                SIZE(&DNRCD &DINCAMT &DNOINC)
                     MONMSG  MSGID(CPF0000) EXEC(DO)
                           CHGVAR VAR(&STATUS) VALUE('99')
                     ENDDO
                     GRTOBJAUT  OBJ(&LIB/&FILE) OBJTYPE(*FILE) +
                                  USER(*PUBLIC) AUT(*ALL)
                 ENDDO
             ENDDO
 OVERRIDE:   IF (&LIB *NE '*CURLIB') THEN(DO)
                 OVRDBF  FILE(&FILE) TOFILE(&LIB/&FILE)
                 ENDDO
 EOJ:        ENDPGM
