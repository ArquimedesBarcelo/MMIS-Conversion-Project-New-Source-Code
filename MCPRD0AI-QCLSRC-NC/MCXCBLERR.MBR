             PGM        PARM(&SCOPE)

             DCL        VAR(&ERRORPGM) TYPE(*CHAR) LEN(20)
             DCL        VAR(&EXITLIB) TYPE(*CHAR) LEN(10)
             DCL        VAR(&EXITPGM) TYPE(*CHAR) LEN(20)
             DCL        VAR(&SCOPE) TYPE(*CHAR) LEN(1)
             DCL        VAR(&ERROR) TYPE(*CHAR) LEN(4) +
                          VALUE(X'00000000')

 BEGIN:
 /*                                                               */
 /*  IF THE USER IS REQUESTING THE ERROR HANDLER FOR THE CURRENT  */
 /*  COBOL RUN UNIT, THERE IS NO NEED TO SET UP A NEW ONE         */
 /*                                                               */
             IF         COND(&SCOPE = 'C') THEN(GOTO CMDLBL(ERRORSET))

 /*                                                               */
 /*  ESTABLISH A NEW COBOL RUN UNIT                               */
 /*                                                               */
             CALL       PGM(QLRCHGCM) PARM(&ERROR)

 /*                                                               */
 /*  SET THE ERROR HANDLER FOR THE NEW COBOL RUN UNIT             */
 /*                                                               */
 ERRORSET:
             CHGVAR     VAR(&ERRORPGM) VALUE('TCOBERR   *LIBL     ')

             CALL       PGM(QLRSETCE) PARM(&ERRORPGM &SCOPE &EXITLIB +
                          &EXITPGM &ERROR)

 /*                                                               */
 /*  FIND OUT WHAT THE PENDING ERROR HANDLER IS SET TO            */
 /*                                                               */

 /*          CALL       PGM(QLRRTVCE) PARM(&CURRENT &SCOPE &ERROR) */

 /*          SNDPGMMSG  MSG('Pending error handling program: ' +  */
 /*                       *CAT &CURRENT) TOPGMQ(*EXT)          */
 /*          SNDPGMMSG  MSG('Error Code: ' *CAT &ERROR) TOPGMQ(*EXT) */

 FINI:
             ENDPGM
