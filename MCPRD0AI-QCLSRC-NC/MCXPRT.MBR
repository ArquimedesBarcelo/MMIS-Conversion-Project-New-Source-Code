PGM        PARM(&FILE &LIBRARY &MEMBER &OUTQ &HEADING &PRTHEAD +
                &COLUMN132)
DCL        VAR(&FILE) TYPE(*CHAR) LEN(10)
DCL        VAR(&LIBRARY) TYPE(*CHAR) LEN(10)
DCL        VAR(&MEMBER) TYPE(*CHAR) LEN(10)
DCL        VAR(&OUTQ) TYPE(*CHAR) LEN(10)
DCL        VAR(&HEADING) TYPE(*CHAR) LEN(32)
DCL        VAR(&PRTHEAD) TYPE(*CHAR) LEN(1)
DCL        VAR(&COLUMN132) TYPE(*CHAR) LEN(1)
CALL TPRT PARM(&FILE &LIBRARY &MEMBER &OUTQ &HEADING &PRTHEAD +
               &COLUMN132)
ENDPGM
