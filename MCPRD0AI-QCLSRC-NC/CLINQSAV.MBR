PGM PARM(&DBPARMS &VPARMS &CPARMS)
             DCL        VAR(&DBPARMS) TYPE(*CHAR) LEN(600)
             DCL        VAR(&VPARMS)  TYPE(*CHAR) LEN(120)
             DCL        VAR(&CPARMS)  TYPE(*CHAR) LEN(120)
             CHKOBJ     OBJ(QTEMP/QINQSAVS) OBJTYPE(*FILE)
             MONMSG     MSGID(CPF9800) EXEC(DO)
             CRTPF      FILE(QTEMP/QINQSAVS) RCDLEN(120)
             ENDDO
             CLRPFM     FILE(QTEMP/QINQSAVS)
             OVRDBF     FILE(QINQSAVS) TOFILE(QTEMP/QINQSAVS)
             CALL       PGM(*LIBL/TINQSAVS) +
                        PARM(&DBPARMS &VPARMS &CPARMS)
             DLTOVR     FILE(QINQSAVS)
             ENDPGM
