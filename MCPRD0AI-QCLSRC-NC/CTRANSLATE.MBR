PGM PARM(&INLEN &INCHAR &INCODE)
             DCL        VAR(&INLEN)    TYPE(*DEC)   LEN(5 0)
             DCL        VAR(&INCHAR)   TYPE(*CHAR)  LEN(8)
             DCL        VAR(&INCODE)   TYPE(*LGL)   LEN(1)
             DCL        VAR(&TABLE)    TYPE(*CHAR)  LEN(10)
             DCL        VAR(&LIB)      TYPE(*CHAR)  LEN(10) VALUE(QSYS)
             IF (&INCODE *EQ '0') DO
                        CHGVAR VAR(&TABLE) VALUE('QASCII    ')
                  ENDDO
                  ELSE DO
                        CHGVAR VAR(&TABLE) VALUE('QEBCDIC   ')
                  ENDDO
             CALL PGM(QDCXLATE) PARM(&INLEN &INCHAR &TABLE &LIB)
             ENDPGM
