             PGM
/*****************************************************************/
/*** PROGRAM: I01STORES                                        ***/
/*** PURPOSE: TO ADD AND CHANGE DATABASE FILES (PHYSICAL AND   ***/
/***          LOGICAL) FOR THE I01 DATABASE RELEASE.           ***/
/***                                                           ***/
/***          THIS PROGRAM CHECKS FOR THE EXISTENCE OF DATA    ***/
/***          LIBRARY MCPRD* (WHERE "*" IS AN INTEGER THAT IS  ***/
/***          INITIALLY SET TO 1), UPDATES THIS LIBRARY IF IT  ***/
/***          EXISTS, THEN INCREMENTS THE DATA LIBRARY NAME    ***/
/***          BY 1, AND CONTINUES LOOPING UNTIL THE DATA       ***/
/***          LIBRARY FAILS TO EXIST AT WHICH TIME THE PROGRAM ***/
/***          ENDS.                                            ***/
/*****************************************************************/
             DCL        VAR(&LIB)    TYPE(*CHAR) LEN(5) VALUE('MCPRD')
             DCL        VAR(&LIBN) TYPE(*DEC) LEN(1) VALUE(1)
             DCL        VAR(&LIBC) TYPE(*CHAR) LEN(1)
             DCL        VAR(&CURLIB) TYPE(*CHAR) LEN(6)
LOOP:
             CHGVAR     VAR(&LIBC) VALUE(&LIBN)
             CHGVAR     VAR(&CURLIB) VALUE(&LIB *CAT &LIBC)

/*** CHECK TO SEE IF DATA LIBRARY MCPRD* EXISTS.  IF IT DOES NOT EXIST, ***/
/*** END THIS PROGRAM.                                                  ***/
             CHKOBJ     OBJ(QSYS/&CURLIB) OBJTYPE(*LIB)
             MONMSG     MSGID(CPF9801) EXEC(GOTO CMDLBL(ENDPGM))

             CHGCURLIB  CURLIB(&CURLIB)
             SNDMSG     MSG('Program I01STORES is now updating  +
                          CSIS/MMIS data library - ' *CAT &CURLIB) +
                          TOUSR(*SYSOPR)

STEP1:
/*****************************************************************/
/**********                 STEP 1                ****************/
/**********          STORES REFERENCE FILE        ****************/
/**********     DELETE PHYSICAL STORES REF FILE   ****************/
/**********     CREATE PHYSICAL STORES REF FILE   ****************/
/*****************************************************************/
             DLTF       FILE(*CURLIB/STORES)
             MONMSG     MSGID(CPF2105)
             CRTPF      FILE(*CURLIB/STORES) +
                          SRCFILE(*LIBL/QDDSSRCDB) SRCMBR(STORES) +
                          TEXT('STORES    Reference File') SIZE(*NOMAX)
             SNDMSG     MSG('Step 1 of 15 has COMPLETED NORMALLY in +
                          I01STORES') TOUSR(*SYSOPR)

STEP2:
/*****************************************************************/
/************               STEP 2                ****************/
/************             MCFLCS0102              ****************/
/************ CREATE NEW LOGICAL FOR MCFPCS0100   ****************/
/*****************************************************************/
             DLTF       FILE(*CURLIB/MCFLCS0102)
             MONMSG     MSGID(CPF2105)
             CRTLF      FILE(*CURLIB/MCFLCS0102) +
                          SRCFILE(*LIBL/QDDSSRCDB) +
                          SRCMBR(MCFLCS0102) TEXT('MPORCV           +
                          Logical File (PORCVSEQ)')
             SNDMSG     MSG('Step 2 of 15 has COMPLETED NORMALLY in +
                          I01STORES') TOUSR(*SYSOPR)

STEP3:
/*****************************************************************/
/************               STEP 3                ****************/
/************      MCFPCS0600  MBUYER             ****************/
/************  A) DELETE LOGICAL FILES            ****************/
/************  B) CREATE DUP OBJ OF PHYSICAL      ****************/
/************  C) DELETE PHYSICAL FILE            ****************/
/************  D) CREATE PHYSICAL FILE            ****************/
/************  E) COPY DUP OBJ INTO NEW PHYSICAL  ****************/
/************  F) CREATE LOGICAL FILES            ****************/
/************  G) DELETE DUP OBJ OF PHYSICAL      ****************/
/*****************************************************************/
/* STEP 3A */
             DLTF       FILE(*CURLIB/MCFLCS0601)
             MONMSG     MSGID(CPF2105)
/* STEP 3B */
             CRTDUPOBJ  OBJ(MCFPCS0600) FROMLIB(*CURLIB) +
                          OBJTYPE(*FILE) TOLIB(*CURLIB) +
                          NEWOBJ(MCFPCS060T) DATA(*YES)
/* STEP 3C */
             DLTF       FILE(*CURLIB/MCFPCS0600)
             MONMSG     MSGID(CPF2105)
/* STEP 3D */
             CRTPF      FILE(*CURLIB/MCFPCS0600) +
                          SRCFILE(*LIBL/QDDSSRCDB) +
                          SRCMBR(MCFPCS0600) TEXT('MBUYER           +
                          Physical File') SIZE(*NOMAX)
/* STEP 3E */
             CPYF       FROMFILE(*CURLIB/MCFPCS060T) +
                          TOFILE(*CURLIB/MCFPCS0600) MBROPT(*ADD) +
                          FMTOPT(*MAP)
/* STEP 3F */
             CRTLF      FILE(*CURLIB/MCFLCS0601) +
                          SRCFILE(*LIBL/QDDSSRCDB) +
                          SRCMBR(MCFLCS0601) TEXT('MBUYER           +
                          Logical File')
/* STEP 3G */
             DLTF       FILE(*CURLIB/MCFPCS060T)
             MONMSG     MSGID(CPF2105)
             SNDMSG     MSG('Step 3 of 15 has COMPLETED NORMALLY in +
                          I01STORES') TOUSR(*SYSOPR)

STEP4:
/*****************************************************************/
/************               STEP 4                ****************/
/************             MCFLCS0903              ****************/
/************ CREATE NEW LOGICAL FOR MCFPCS0900   ****************/
/*****************************************************************/
             DLTF       FILE(*CURLIB/MCFLCS0903)
             MONMSG     MSGID(CPF2105)
             CRTLF      FILE(*CURLIB/MCFLCS0903) +
                          SRCFILE(*LIBL/QDDSSRCDB) +
                          SRCMBR(MCFLCS0903) TEXT('DPORECD          +
                          Logical File (VENCDE/PODATE)')
             SNDMSG     MSG('Step 4 of 15 has COMPLETED NORMALLY in +
                          I01STORES') TOUSR(*SYSOPR)

STEP5:
/*****************************************************************/
/************               STEP 5                ****************/
/************             MCFLCS0904              ****************/
/************ CREATE NEW LOGICAL FOR MCFPCS0900   ****************/
/*****************************************************************/
             DLTF       FILE(*CURLIB/MCFLCS0904)
             MONMSG     MSGID(CPF2105)
             CRTLF      FILE(*CURLIB/MCFLCS0904) +
                          SRCFILE(*LIBL/QDDSSRCDB) +
                          SRCMBR(MCFLCS0904) TEXT('DPORECD          +
                          Logical File (PODATE)')
             SNDMSG     MSG('Step 5 of 15 has COMPLETED NORMALLY in +
                          I01STORES') TOUSR(*SYSOPR)

STEP6:
/*****************************************************************/
/************               STEP 6                ****************/
/************      MCFPCS1700  MVALIDPLTDATA      ****************/
/************  A) DELETE LOGICAL FILES            ****************/
/************  B) CREATE DUP OBJ OF PHYSICAL      ****************/
/************  C) DELETE PHYSICAL FILE            ****************/
/************  D) CREATE PHYSICAL FILE            ****************/
/************  E) COPY DUP OBJ INTO NEW PHYSICAL  ****************/
/************  F) CREATE LOGICAL FILES            ****************/
/************  G) DELETE DUP OBJ OF PHYSICAL      ****************/
/*****************************************************************/
/* STEP 6A */
             DLTF       FILE(*CURLIB/MCFLCS1701)
             MONMSG     MSGID(CPF2105)
/* STEP 6B */
             CRTDUPOBJ  OBJ(MCFPCS1700) FROMLIB(*CURLIB) +
                          OBJTYPE(*FILE) TOLIB(*CURLIB) +
                          NEWOBJ(MCFPCS170T) DATA(*YES)
/* STEP 6C */
             DLTF       FILE(*CURLIB/MCFPCS1700)
             MONMSG     MSGID(CPF2105)
/* STEP 6D */
             CRTPF      FILE(*CURLIB/MCFPCS1700) +
                          SRCFILE(*LIBL/QDDSSRCDB) +
                          SRCMBR(MCFPCS1700) TEXT('MVALIDPLTDATA    +
                          Physical File') SIZE(*NOMAX)
/* STEP 6E */
             CPYF       FROMFILE(*CURLIB/MCFPCS170T) +
                          TOFILE(*CURLIB/MCFPCS1700) MBROPT(*ADD) +
                          FMTOPT(*MAP)
/* STEP 6F */
             CRTLF      FILE(*CURLIB/MCFLCS1701) +
                          SRCFILE(*LIBL/QDDSSRCDB) +
                          SRCMBR(MCFLCS1701) TEXT('MVALIDPLTDATA    +
                          Logical File')
/* STEP 6G */
             DLTF       FILE(*CURLIB/MCFPCS170T)
             MONMSG     MSGID(CPF2105)
             SNDMSG     MSG('Step 6 of 15 has COMPLETED NORMALLY in +
                          I01STORES') TOUSR(*SYSOPR)

STEP7:
/*****************************************************************/
/************               STEP 7                ****************/
/************        MCFPCS5600  DPOTRACK         ****************/
/************ CREATE PF MCFPCS5600                ****************/
/************ CREATE LF MCFLCS5601                ****************/
/************ CREATE LF MCFLCS5602                ****************/
/*****************************************************************/
             CRTPF      FILE(*CURLIB/MCFPCS5600) +
                          SRCFILE(*LIBL/QDDSSRCDB) +
                          SRCMBR(MCFPCS5600) TEXT('DPOTRACK         +
                          Physical File') SIZE(*NOMAX)
             CRTLF      FILE(*CURLIB/MCFLCS5601) +
                          SRCFILE(*LIBL/QDDSSRCDB) +
                          SRCMBR(MCFLCS5601) TEXT('DPOTRACK         +
                          Logical File (DATTIMSTMP)')
             CRTLF      FILE(*CURLIB/MCFLCS5602) +
                          SRCFILE(*LIBL/QDDSSRCDB) +
                          SRCMBR(MCFLCS5602) TEXT('DPOTRACK         +
                          Logical File (PORCVNO)')
             SNDMSG     MSG('Step 7 of 15 has COMPLETED NORMALLY in +
                          I01STORES') TOUSR(*SYSOPR)

STEP8:
/*****************************************************************/
/************               STEP 8                ****************/
/************        MCFPCS5700  MCORPREQ         ****************/
/************ CREATE PF MCFPCS5700                ****************/
/************ CREATE LF MCFLCS5701                ****************/
/*****************************************************************/
             CRTPF      FILE(*CURLIB/MCFPCS5700) +
                          SRCFILE(*LIBL/QDDSSRCDB) +
                          SRCMBR(MCFPCS5700) TEXT('MCORPREQ         +
                          Physical File') SIZE(*NOMAX)
             CRTLF      FILE(*CURLIB/MCFLCS5701) +
                          SRCFILE(*LIBL/QDDSSRCDB) +
                          SRCMBR(MCFLCS5701) TEXT('MCORPREQ         +
                          Logical File (REQNO)')
             SNDMSG     MSG('Step 8 of 15 has COMPLETED NORMALLY in +
                          I01STORES') TOUSR(*SYSOPR)

STEP9:
/*****************************************************************/
/************               STEP 9                ****************/
/************        MCFPCS5800  MALTVEN          ****************/
/**********     CHECK FOR EXISTENCE OF MCFPCS5800 ****************/
/**********     IF IT DOES NOT EXIST, CREATE IT   ****************/
/**********     AND ITS RELATED LOGICAL FILES.    ****************/
/********** (SOME PLANTS HAVE MCFPCS5800 AND ITS  ****************/
/**********  LOGICAL FILES WHILE OTHER DO NOT)    ****************/
/*****************************************************************/
             CHKOBJ     OBJ(*CURLIB/MCFPCS5800) OBJTYPE(*FILE)
             MONMSG     MSGID(CPF9801) EXEC(DO)
               CRTPF      FILE(*CURLIB/MCFPCS5800) +
                            SRCFILE(*LIBL/QDDSSRCDB) +
                            SRCMBR(MCFPCS5800) TEXT('MALTVEN          +
                            Physical File') SIZE(*NOMAX)
               CRTLF      FILE(*CURLIB/MCFLCS5801) +
                            SRCFILE(*LIBL/QDDSSRCDB) +
                            SRCMBR(MCFLCS5801) TEXT('MALTVEN          +
                            Logical File (VENCALTKEY)')
               CRTLF      FILE(*CURLIB/MCFLCS5802) +
                            SRCFILE(*LIBL/QDDSSRCDB) +
                            SRCMBR(MCFLCS5802) TEXT('MALTVEN          +
                            Logical File (VENCDE VENCALTKEY)')
             ENDDO
             SNDMSG     MSG('Step 9 of 15 has COMPLETED NORMALLY in +
                          I01STORES') TOUSR(*SYSOPR)

STEP10:
/*****************************************************************/
/************               STEP 10               ****************/
/************        MCFPCS5900  DSTRWITH         ****************/
/************ CREATE PF MCFPCS5900                ****************/
/************ CREATE LF MCFLCS5901                ****************/
/*****************************************************************/
             CRTPF      FILE(*CURLIB/MCFPCS5900) +
                          SRCFILE(*LIBL/QDDSSRCDB) +
                          SRCMBR(MCFPCS5900) TEXT('DSTRWITH         +
                          Physical File') SIZE(*NOMAX)
             CRTLF      FILE(*CURLIB/MCFLCS5901) +
                          SRCFILE(*LIBL/QDDSSRCDB) +
                          SRCMBR(MCFLCS5901) TEXT('DSTRWITH         +
                          Logical File (DATECYMD)')
             SNDMSG     MSG('Step 10 of 15 has COMPLETED NORMALLY in +
                          I01STORES') TOUSR(*SYSOPR)

STEP11:
/*****************************************************************/
/************               STEP 11               ****************/
/************        MCFPCS6000  DTRAILER         ****************/
/************ CREATE PF MCFPCS6000                ****************/
/************ CREATE LF MCFLCS6001                ****************/
/*****************************************************************/
             CRTPF      FILE(*CURLIB/MCFPCS6000) +
                          SRCFILE(*LIBL/QDDSSRCDB) +
                          SRCMBR(MCFPCS6000) TEXT('DTRAILER         +
                          Physical File') SIZE(*NOMAX)
             CRTLF      FILE(*CURLIB/MCFLCS6001) +
                          SRCFILE(*LIBL/QDDSSRCDB) +
                          SRCMBR(MCFLCS6001) TEXT('DTRAILER         +
                          Logical File (PORCVNO)')
             SNDMSG     MSG('Step 11 of 15 has COMPLETED NORMALLY in +
                          I01STORES') TOUSR(*SYSOPR)

STEP12:
/*****************************************************************/
/************               STEP 12               ****************/
/************              DOCKFILE               ****************/
/************ CREATE PF DOCKFILE FOR BATCH RCVG   ****************/
/*****************************************************************/
             CRTPF      FILE(*CURLIB/DOCKFILE) +
                          SRCFILE(*LIBL/QDDSSRCDB) SRCMBR(DOCKFILE) +
                          TEXT('DOCKFILE         Physical File') +
                          MAXMBRS(10) SIZE(*NOMAX)
             MONMSG     MSGID(CPF7302) EXEC(GOTO CMDLBL(STEP13))
             ADDPFM     FILE(*CURLIB/DOCKFILE) MBR(DOCKFIL1)
             ADDPFM     FILE(*CURLIB/DOCKFILE) MBR(DOCKFIL2)
             ADDPFM     FILE(*CURLIB/DOCKFILE) MBR(DOCKFIL3)
             ADDPFM     FILE(*CURLIB/DOCKFILE) MBR(DOCKFIL4)
             ADDPFM     FILE(*CURLIB/DOCKFILE) MBR(DOCKFIL5)
             ADDPFM     FILE(*CURLIB/DOCKFILE) MBR(DOCKFIL6)
             ADDPFM     FILE(*CURLIB/DOCKFILE) MBR(DOCKFIL7)
             ADDPFM     FILE(*CURLIB/DOCKFILE) MBR(DOCKFIL8)
             ADDPFM     FILE(*CURLIB/DOCKFILE) MBR(DOCKFIL9)
             SNDMSG     MSG('Step 12 of 15 has COMPLETED NORMALLY in +
                          I01STORES') TOUSR(*SYSOPR)

STEP13:
/*****************************************************************/
/************               STEP 13               ****************/
/************              DKERFILE               ****************/
/************ CREATE PF DKERFILE, BATCH RCVG ERR  ****************/
/*****************************************************************/
             CRTPF      FILE(DKERFILE) RCDLEN(133) MAXMBRS(2) +
                          SIZE(*NOMAX)
             MONMSG     MSGID(CPF7302) EXEC(GOTO CMDLBL(STEP14))
             ADDPFM     FILE(*CURLIB/DKERFILE) MBR(DKERFIL2)
             SNDMSG     MSG('Step 13 of 15 has COMPLETED NORMALLY in +
                          I01STORES') TOUSR(*SYSOPR)

STEP14:
/*****************************************************************/
/**********                 STEP 14               ****************/
/**********          CSACCT REFERENCE FILE        ****************/
/**********     DELETE PHYSICAL CSACCT REF FILE   ****************/
/**********     CREATE PHYSICAL CSACCT REF FILE   ****************/
/*****************************************************************/
             DLTF       FILE(*CURLIB/CSACCT)
             MONMSG     MSGID(CPF2105)
             CRTPF      FILE(*CURLIB/CSACCT) +
                          SRCFILE(*LIBL/QDDSSRCDB) SRCMBR(CSACCT) +
                          TEXT('CSACCT    Reference File') SIZE(*NOMAX)
             SNDMSG     MSG('Step 14 of 15 has COMPLETED NORMALLY in +
                          I01STORES') TOUSR(*SYSOPR)
STEP15:
/*****************************************************************/
/**********                 STEP 15               ****************/
/**********          DTRANS2  (MCFPCA1200)        ****************/
/**********     CHECK FOR EXISTANCE OF MCFPCA1200 ****************/
/**********     IF IT DOES NOT EXIST, CREATE IT   ****************/
/**********     AND ITS RELATED LOGICAL FILES.    ****************/
/********** (SOME PLANTS HAVE MCFPCA1200 AND ITS  ****************/
/**********  LOGICAL FILES WHILE OTHER DO NOT)    ****************/
/*****************************************************************/
             CHKOBJ     OBJ(*CURLIB/MCFPCA1200) OBJTYPE(*FILE)
             MONMSG     MSGID(CPF9801) EXEC(DO)
                CRTPF      FILE(*CURLIB/MCFPCA1200) +
                            SRCFILE(*LIBL/QDDSSRCDB) +
                            SRCMBR(MCFPCA1200) TEXT('DTRANS2 +
                            Physical File') SIZE(*NOMAX)
                CRTLF      FILE(*CURLIB/MCFLCA1201) +
                            SRCFILE(*LIBL/QDDSSRCDB) +
                            SRCMBR(MCFLCA1201) TEXT('DTRANS2 Logical +
                            File (MATL-CODE,TRANS-DATE)')
                CRTLF      FILE(*CURLIB/MCFLCA1202) +
                            SRCFILE(*LIBL/QDDSSRCDB) +
                            SRCMBR(MCFLCA1202) TEXT('DTRANS2 Logical +
                            File (DEPT)')
                CRTLF      FILE(*CURLIB/MCFLCA1203) +
                            SRCFILE(*LIBL/QDDSSRCDB) +
                            SRCMBR(MCFLCA1203) TEXT('DTRANS2 Logical +
                            File (PO-NUMBER)')
             ENDDO
             SNDMSG     MSG('Step 15 of 15 has COMPLETED NORMALLY in +
                          I01STORES') TOUSR(*SYSOPR)

/*****************************************************************/
             SNDMSG     MSG('Program I01STORES has successfully +
                          updated  CSIS/MMIS data library - ' *CAT +
                          &CURLIB) TOUSR(*SYSOPR)

/*** INCREMENT THE LIBRARY NAME BY 1, AND GO BACK TO THE BEGINNING   ***/
/*** OF THE PROGRAM.                                                 ***/
             CHGVAR     VAR(&LIBN) VALUE(&LIBN + 1)
             GOTO       CMDLBL(LOOP)

/*****************************************************************/
ENDPGM:      DSPJOBLOG  OUTPUT(*PRINT)
             SNDMSG     MSG('I01STORES has ENDED NORMALLY') +
                          TOUSR(*SYSOPR)
             ENDPGM
