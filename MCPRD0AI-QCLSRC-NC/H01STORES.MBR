             PGM
/*****************************************************************/
/*** PROGRAM: H01STORES                                        ***/
/*** PURPOSE: TO ADD AND CHANGE DATABASE FILES (PHYSICAL AND   ***/
/***          LOGICAL) FOR THE H01 DATABASE RELEASE.           ***/
/***          THIS IS FOR BOTH THE STORES AND STHIST DATABASES ***/
/***                                                           ***/
/***          THIS PROGRAM CHECKS FOR THE EXISTENCE OF DATA    ***/
/***          LIBRARY MCPRD* (WHERE "*" IS AN INTEGER THAT IS  ***/
/***          INITIALLY SET TO 1), UPDATES THIS LIBRARY IF IT  ***/
/***          EXISTS, THEN INCREMENTS THE DATA LIBRARY NAME    ***/
/***          BY 1, AND CONTINUES LOOPING UNTIL THE DATA       ***/
/***          LIBRARY FAILS TO EXIST AT WHICH TIME THE PROGRAM ***/
/***          ENDS.                                            ***/
/*****************************************************************/
             DCL        VAR(&LIB)    TYPE(*CHAR) LEN(5) VALUE('MCPRD')
             DCL        VAR(&LIBN) TYPE(*DEC) LEN(1) VALUE(1)
             DCL        VAR(&LIBC) TYPE(*CHAR) LEN(1)
             DCL        VAR(&CURLIB) TYPE(*CHAR) LEN(6)
LOOP:
             CHGVAR     VAR(&LIBC) VALUE(&LIBN)
             CHGVAR     VAR(&CURLIB) VALUE(&LIB *CAT &LIBC)

/*** CHECK TO SEE IF DATA LIBRARY MCPRD* EXISTS.  IF IT DOES NOT EXIST, ***/
/*** END THIS PROGRAM.                                                  ***/
             CHKOBJ     OBJ(QSYS/&CURLIB) OBJTYPE(*LIB)
             MONMSG     MSGID(CPF9801) EXEC(GOTO CMDLBL(ENDPGM))

             CHGCURLIB  CURLIB(&CURLIB)
             SNDMSG     MSG('Program H01STORES is now updating  +
                          CSIS/MMIS data library - ' *CAT &CURLIB) +
                          TOUSR(*SYSOPR)

/*****************************************************************/
/**********                 STEP 1                ****************/
/**********          STORES REFERENCE FILE        ****************/
/**********     DELETE PHYSICAL STORES REF FILE   ****************/
/**********     CREATE PHYSICAL STORES REF FILE   ****************/
/*****************************************************************/
             DLTF       FILE(*CURLIB/STORES)
             MONMSG     MSGID(CPF2105)
             CRTPF      FILE(*CURLIB/STORES) +
                          SRCFILE(*LIBL/QDDSSRCDB) SRCMBR(STORES) +
                          TEXT('STORES    Reference File') SIZE(*NOMAX)
             SNDMSG     MSG('Step 1 of 22 has COMPLETED NORMALLY in +
                          H01STORES') TOUSR(*SYSOPR)
/*****************************************************************/
/**********                 STEP 2                ****************/
/**********          DINVRCD (MCFLCS2505)         ****************/
/**********     DELETE LOGICAL FILE MCFLCS2505    ****************/
/**********     CREATE LOGICAL FILE MCFLCS2505    ****************/
/********** (SOME PLANTS HAVE THIS 5TH LOGICAL    ****************/
/**********  FILE FOR DINVRCD WHILE OTHERS DO NOT)****************/
/*****************************************************************/
             DLTF       FILE(*CURLIB/MCFLCS2505)
             MONMSG     MSGID(CPF2105)
             CRTLF      FILE(*CURLIB/MCFLCS2505) +
                          SRCFILE(*LIBL/QDDSSRCDB) +
                          SRCMBR(MCFLCS2505) TEXT('DINVRCD Logical +
                          File  invoicests ')
             SNDMSG     MSG('Step 2 of 22 has COMPLETED NORMALLY in +
                          H01STORES') TOUSR(*SYSOPR)
/*****************************************************************/
/**********                 STEP 3                ****************/
/**********          DRCVCORR (MCFPCS5400)        ****************/
/**********     CREATE PHYSICAL FILE MCFPCS5400   ****************/
/**********     CREATE LOGICAL FILE  MCFLCS5401   ****************/
/**********     CREATE LOGICAL FILE  MCFLCS5402   ****************/
/*****************************************************************/
