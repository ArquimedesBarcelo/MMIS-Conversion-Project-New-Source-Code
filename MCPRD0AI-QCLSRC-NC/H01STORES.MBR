                          SRCFILE(*LIBL/QDDSSRCDB) +
                          SRCMBR(MCFPCS5400) TEXT('DRCVCORR +
                          Physical File') SIZE(*NOMAX)
             CRTLF      FILE(*CURLIB/MCFLCS5401) +
                          SRCFILE(*LIBL/QDDSSRCDB) +
                          SRCMBR(MCFLCS5401) TEXT('DRCVCORR  +
                          Logical File (PORCVNO ITEMNO)')
             CRTLF      FILE(*CURLIB/MCFLCS5402) +
                          SRCFILE(*LIBL/QDDSSRCDB) +
                          SRCMBR(MCFLCS5402) TEXT('DRCVCORR  +
                          Logical File (CORPCDE)')
             SNDMSG     MSG('Step 3 of 22 has COMPLETED NORMALLY in +
                          H01STORES') TOUSR(*SYSOPR)
/*****************************************************************/
