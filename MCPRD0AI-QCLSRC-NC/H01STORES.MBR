                          NEWOBJ(MCFPST060T) DATA(*YES)
/* STEP 14C */
             DLTF       FILE(*CURLIB/MCFPST0600)
             MONMSG     MSGID(CPF2105)
/* STEP 14D */
             CRTPF      FILE(*CURLIB/MCFPST0600) +
                          SRCFILE(*LIBL/QDDSSRCDB) +
                          SRCMBR(MCFPST0600) TEXT('DRCVITEM HISTORY +
                          Physical File') SIZE(*NOMAX)
/* STEP 14E */
             CPYF       FROMFILE(*CURLIB/MCFPST060T) +
                          TOFILE(*CURLIB/MCFPST0600) MBROPT(*ADD) +
                          FMTOPT(*MAP)
/* STEP 14F */
             CRTLF      FILE(*CURLIB/MCFLST0601) +
                          SRCFILE(*LIBL/QDDSSRCDB) +
                          SRCMBR(MCFLST0601) TEXT('DRCVITEM HISTORY +
                          Logical File (PORCVNO ITMNO)')
             CRTLF      FILE(*CURLIB/MCFLST0602) +
                          SRCFILE(*LIBL/QDDSSRCDB) +
                          SRCMBR(MCFLST0602) TEXT('DRCVITEM HISTORY +
                          Logical File (CORPCDE)')
/* STEP 14G */
             DLTF       FILE(*CURLIB/MCFPST060T)
             MONMSG     MSGID(CPF2105)
             SNDMSG     MSG('Step 14 of 22 has COMPLETED NORMALLY in +
                          H01STORES') TOUSR(*SYSOPR)
/*****************************************************************/
/************               STEP 15               ****************/
/************      MCFPST0700  DPOFREIGHT HISTORY ****************/
/************  A) DELETE LOGICAL FILES            ****************/
/************  B) CREATE DUP OBJ OF PHYSICAL      ****************/
/************  C) DELETE PHYSICAL FILE            ****************/
/************  D) CREATE PHYSICAL FILE            ****************/
/************  E) COPY DUP OBJ INTO NEW PHYSICAL  ****************/
/************  F) CREATE LOGICAL FILES            ****************/
/************  G) DELETE DUP OBJ OF PHYSICAL      ****************/
/*****************************************************************/
/* STEP 15A */
             DLTF       FILE(*CURLIB/MCFLST0701)
             MONMSG     MSGID(CPF2105)
             DLTF       FILE(*CURLIB/MCFLST0702)
             MONMSG     MSGID(CPF2105)
/* STEP 15B */
             CRTDUPOBJ  OBJ(MCFPST0700) FROMLIB(*CURLIB) +
                          OBJTYPE(*FILE) TOLIB(*CURLIB) +
                          NEWOBJ(MCFPST070T) DATA(*YES)
/* STEP 15C */
             DLTF       FILE(*CURLIB/MCFPST0700)
             MONMSG     MSGID(CPF2105)
/* STEP 15D */
             CRTPF      FILE(*CURLIB/MCFPST0700) +
                          SRCFILE(*LIBL/QDDSSRCDB) +
                          SRCMBR(MCFPST0700) TEXT('DPOFREIGHT +
                          HISTORY Physical File') SIZE(*NOMAX)
/* STEP 15E */
             CPYF       FROMFILE(*CURLIB/MCFPST070T) +
                          TOFILE(*CURLIB/MCFPST0700) MBROPT(*ADD) +
                          FMTOPT(*MAP)
/* STEP 15F */
             CRTLF      FILE(*CURLIB/MCFLST0701) +
                          SRCFILE(*LIBL/QDDSSRCDB) +
                          SRCMBR(MCFLST0701) TEXT('DPOFREIGHT HISTOR+
                          Y Logical File (PORCVNO)')
             CRTLF      FILE(*CURLIB/MCFLST0702) +
                          SRCFILE(*LIBL/QDDSSRCDB) +
                          SRCMBR(MCFLST0702) TEXT('DPOFREIGHT HISTOR+
                          Y Logical File (REGISTERNO)')
/* STEP 15G */
             DLTF       FILE(*CURLIB/MCFPST070T)
             MONMSG     MSGID(CPF2105)
             SNDMSG     MSG('Step 15 of 22 has COMPLETED NORMALLY in +
                          H01STORES') TOUSR(*SYSOPR)
/*****************************************************************/
/************               STEP 16               ****************/
/************      MCFPST0800  DINVRCD HISTORY    ****************/
/************  A) DELETE LOGICAL FILES            ****************/
/************  B) CREATE DUP OBJ OF PHYSICAL      ****************/
/************  C) DELETE PHYSICAL FILE            ****************/
/************  D) CREATE PHYSICAL FILE            ****************/
/************  E) COPY DUP OBJ INTO NEW PHYSICAL  ****************/
/************  F) CREATE LOGICAL FILES            ****************/
/************  G) DELETE DUP OBJ OF PHYSICAL      ****************/
/*****************************************************************/
/* STEP 16A */
             DLTF       FILE(*CURLIB/MCFLST0801)
             MONMSG     MSGID(CPF2105)
             DLTF       FILE(*CURLIB/MCFLST0802)
             MONMSG     MSGID(CPF2105)
             DLTF       FILE(*CURLIB/MCFLST0803)
             MONMSG     MSGID(CPF2105)
             DLTF       FILE(*CURLIB/MCFLST0804)
             MONMSG     MSGID(CPF2105)
/* STEP 16B */
             CRTDUPOBJ  OBJ(MCFPST0800) FROMLIB(*CURLIB) +
                          OBJTYPE(*FILE) TOLIB(*CURLIB) +
                          NEWOBJ(MCFPST080T) DATA(*YES)
/* STEP 16C */
             DLTF       FILE(*CURLIB/MCFPST0800)
             MONMSG     MSGID(CPF2105)
/* STEP 16D */
             CRTPF      FILE(*CURLIB/MCFPST0800) +
                          SRCFILE(*LIBL/QDDSSRCDB) +
                          SRCMBR(MCFPST0800) TEXT('DINVRCD +
                          HISTORY    Physical File') SIZE(*NOMAX)
/* STEP 16E */
             CPYF       FROMFILE(*CURLIB/MCFPST080T) +
                          TOFILE(*CURLIB/MCFPST0800) MBROPT(*ADD) +
                          FMTOPT(*MAP)
/* STEP 16F */
             CRTLF      FILE(*CURLIB/MCFLST0801) +
                          SRCFILE(*LIBL/QDDSSRCDB) +
                          SRCMBR(MCFLST0801) TEXT('DINVRCD HISTORY  +
                          Logical File (REGISTERNO)')
             CRTLF      FILE(*CURLIB/MCFLST0802) +
                          SRCFILE(*LIBL/QDDSSRCDB) +
                          SRCMBR(MCFLST0802) TEXT('DINVRCD HISTORY  +
                          Logical File (PORCVNO)')
             CRTLF      FILE(*CURLIB/MCFLST0803) +
                          SRCFILE(*LIBL/QDDSSRCDB) +
                          SRCMBR(MCFLST0803) TEXT('DINVRCD HISTORY  +
                          Logical File (VENCDE)')
             CRTLF      FILE(*CURLIB/MCFLST0804) +
                          SRCFILE(*LIBL/QDDSSRCDB) +
                          SRCMBR(MCFLST0804) TEXT('DINVRCD HISTORY  +
                          Logical File (INVOICENO)')
/* STEP 16G */
             DLTF       FILE(*CURLIB/MCFPST080T)
             MONMSG     MSGID(CPF2105)
             SNDMSG     MSG('Step 16 of 22 has COMPLETED NORMALLY in +
                          H01STORES') TOUSR(*SYSOPR)
/*****************************************************************/
/************               STEP 17               ****************/
/************      MCFPST1000  DINVACCT HISTORY   ****************/
/************  A) DELETE LOGICAL FILES            ****************/
/************  B) CREATE DUP OBJ OF PHYSICAL      ****************/
/************  C) DELETE PHYSICAL FILE            ****************/
/************  D) CREATE PHYSICAL FILE            ****************/
/************  E) COPY DUP OBJ INTO NEW PHYSICAL  ****************/
/************  F) CREATE LOGICAL FILES            ****************/
/************  G) DELETE DUP OBJ OF PHYSICAL      ****************/
/*****************************************************************/
/* STEP 17A */
             DLTF       FILE(*CURLIB/MCFLST1001)
             MONMSG     MSGID(CPF2105)
/* STEP 17B */
             CRTDUPOBJ  OBJ(MCFPST1000) FROMLIB(*CURLIB) +
                          OBJTYPE(*FILE) TOLIB(*CURLIB) +
                          NEWOBJ(MCFPST100T) DATA(*YES)
/* STEP 17C */
             DLTF       FILE(*CURLIB/MCFPST1000)
             MONMSG     MSGID(CPF2105)
/* STEP 17D */
             CRTPF      FILE(*CURLIB/MCFPST1000) +
                          SRCFILE(*LIBL/QDDSSRCDB) +
                          SRCMBR(MCFPST1000) TEXT('DINVACCT +
                          HISTORY    Physical File') SIZE(*NOMAX)
/* STEP 17E */
             CPYF       FROMFILE(*CURLIB/MCFPST100T) +
                          TOFILE(*CURLIB/MCFPST1000) MBROPT(*ADD) +
                          FMTOPT(*MAP)
/* STEP 17F */
             CRTLF      FILE(*CURLIB/MCFLST1001) +
                          SRCFILE(*LIBL/QDDSSRCDB) +
                          SRCMBR(MCFLST1001) TEXT('DINVACCT HISTORY +
                          Lgl File (REGISTERNO INVITEMNO)')
/* STEP 17G */
             DLTF       FILE(*CURLIB/MCFPST100T)
             MONMSG     MSGID(CPF2105)
             SNDMSG     MSG('Step 17 of 22 has COMPLETED NORMALLY in +
                          H01STORES') TOUSR(*SYSOPR)
/*****************************************************************/
/**********                 STEP 18               ****************/
/**********     HISTORY DRCVCORR (MCFPST5400)     ****************/
/**********     CREATE PHYSICAL FILE MCFPST5400   ****************/
/**********     CREATE LOGICAL FILE  MCFLST5401   ****************/
/**********     CREATE LOGICAL FILE  MCFLST5402   ****************/
/*****************************************************************/
             CRTPF      FILE(*CURLIB/MCFPST5400) +
                          SRCFILE(*LIBL/QDDSSRCDB) +
                          SRCMBR(MCFPST5400) TEXT('DRCVCORR HISTORY +
                          Physical File') SIZE(*NOMAX)
             CRTLF      FILE(*CURLIB/MCFLST5401) +
                          SRCFILE(*LIBL/QDDSSRCDB) +
                          SRCMBR(MCFLST5401) TEXT('DRCVCORR HISTORY +
                          Logical File (PORCVNO ITEMNO)')
             CRTLF      FILE(*CURLIB/MCFLST5402) +
                          SRCFILE(*LIBL/QDDSSRCDB) +
                          SRCMBR(MCFLST5402) TEXT('DRCVCORR HISTORY +
                          Logical File (CORPCDE)')
             SNDMSG     MSG('Step 18 of 22 has COMPLETED NORMALLY in +
                          H01STORES') TOUSR(*SYSOPR)
/*****************************************************************/
/************               STEP 19               ****************/
/*** EXECUTE PROGRAM TH01HIST TO REALIGN THE FLAGS IN DPORECD  ***/
/*** AND THE ACCOUNTING INFORMATION IN DPOITEM OF HISTORY.     ***/
/*****************************************************************/
             CALL       PGM(MCPRD/TH01HIST)
             SNDMSG     MSG('Step 19 of 22 has COMPLETED NORMALLY in +
                          H01STORES') TOUSR(*SYSOPR)
/*****************************************************************/
/**********                 STEP 20               ****************/
/**********     CHESS DOWNLOAD FILE CHATNO        ****************/
/**********     CREATE PHYSICAL FILE CHATNO       ****************/
/**********     ADD MEMBER CHATNO01 THRU CHATNO05 ****************/
/*****************************************************************/
             CRTPF      FILE(*CURLIB/CHATNO) RCDLEN(133) MAXMBRS(6) +
                          SIZE(*NOMAX)
             ADDPFM     FILE(*CURLIB/CHATNO) MBR(CHATNO01)
             ADDPFM     FILE(*CURLIB/CHATNO) MBR(CHATNO02)
             ADDPFM     FILE(*CURLIB/CHATNO) MBR(CHATNO03)
             ADDPFM     FILE(*CURLIB/CHATNO) MBR(CHATNO04)
             ADDPFM     FILE(*CURLIB/CHATNO) MBR(CHATNO05)
             SNDMSG     MSG('Step 20 of 22 has COMPLETED NORMALLY in +
                          H01STORES') TOUSR(*SYSOPR)
/*****************************************************************/
/**********                 STEP 21               ****************/
/**********          CSACCT REFERENCE FILE        ****************/
/**********     DELETE PHYSICAL CSACCT REF FILE   ****************/
/**********     CREATE PHYSICAL CSACCT REF FILE   ****************/
/*****************************************************************/
             DLTF       FILE(*CURLIB/CSACCT)
             MONMSG     MSGID(CPF2105)
             CRTPF      FILE(*CURLIB/CSACCT) +
                          SRCFILE(*LIBL/QDDSSRCDB) SRCMBR(CSACCT) +
                          TEXT('CSACCT    Reference File') SIZE(*NOMAX)
             SNDMSG     MSG('Step 21 of 22 has COMPLETED NORMALLY in +
                          H01STORES') TOUSR(*SYSOPR)
/*****************************************************************/
/**********                 STEP 22               ****************/
/**********          DAPPLFRT (MCFPCA1100)        ****************/
/**********     CHECK FOR EXISTANCE OF MCFPCA1100 ****************/
/**********     IF IT DOES NOT EXIST, CREATE IT   ****************/
/**********     AND ITS RELATED LOGICAL FILES.    ****************/
/********** (SOME PLANTS HAVE MCFPCA1100 AND ITS  ****************/
/**********  LOGICAL FILES WHILE OTHER DO NOT)    ****************/
/*****************************************************************/
             CHKOBJ     OBJ(*CURLIB/MCFPCA1100) OBJTYPE(*FILE)
             MONMSG     MSGID(CPF9801) EXEC(DO)
                CRTPF      FILE(*CURLIB/MCFPCA1100) +
                            SRCFILE(*LIBL/QDDSSRCDB) +
                            SRCMBR(MCFPCA1100) TEXT('DAPPLFRT +
                            Physical File') SIZE(*NOMAX)
                CRTLF      FILE(*CURLIB/MCFLCA1101) +
                            SRCFILE(*LIBL/QDDSSRCDB) +
                            SRCMBR(MCFLCA1101) TEXT('DAPPLFRT Logical +
                            File (PO)')
                CRTLF      FILE(*CURLIB/MCFLCA1102) +
                            SRCFILE(*LIBL/QDDSSRCDB) +
                            SRCMBR(MCFLCA1102) TEXT('DAPPLFRT Logical +
                            File (RAIL CAR)')
                CRTLF      FILE(*CURLIB/MCFLCA1103) +
                            SRCFILE(*LIBL/QDDSSRCDB) +
                            SRCMBR(MCFLCA1103) TEXT('DAPPLFRT Logical +
                            File (PAID CARR/PRO NUM)')
                CRTLF      FILE(*CURLIB/MCFLCA1104) +
                            SRCFILE(*LIBL/QDDSSRCDB) +
                            SRCMBR(MCFLCA1104) TEXT('DAPPLFRT Logical +
                            File (RATED CARR/PRO NUM)')
                CRTLF      FILE(*CURLIB/MCFLCA1105) +
                            SRCFILE(*LIBL/QDDSSRCDB) +
                            SRCMBR(MCFLCA1105) TEXT('DAPPLFRT Logical +
                            File (RAIL CAR)')
                CRTLF      FILE(*CURLIB/MCFLCA1106) +
                            SRCFILE(*LIBL/QDDSSRCDB) +
                            SRCMBR(MCFLCA1106) TEXT('DAPPLFRT Logical +
                            File (PAID PRO NUM)')
                CRTLF      FILE(*CURLIB/MCFLCA1107) +
                            SRCFILE(*LIBL/QDDSSRCDB) +
                            SRCMBR(MCFLCA1107) TEXT('DAPPLFRT Logical +
                            File (RATED PRO NUM)')
             ENDDO
             SNDMSG     MSG('Step 22 of 22 has COMPLETED NORMALLY in +
                          H01STORES') TOUSR(*SYSOPR)

             SNDMSG     MSG('Program H01STORES has successfully +
                          updated  CSIS/MMIS data library - ' *CAT +
                          &CURLIB) TOUSR(*SYSOPR)

/*****************************************************************/

/*** INCREMENT THE LIBRARY NAME BY 1, AND GO BACK TO THE BEGINNING   ***/
/*** OF THE PROGRAM.                                                 ***/
             CHGVAR     VAR(&LIBN) VALUE(&LIBN + 1)
             GOTO       CMDLBL(LOOP)

/*****************************************************************/
ENDPGM:      DSPJOBLOG  OUTPUT(*PRINT)
             SNDMSG     MSG('H01STORES has ENDED NORMALLY') +
                          TOUSR(*SYSOPR)
             ENDPGM
