/*********************************************************************/
/** PROGRAM: TARIBA02C                                             ***/
/**                                                                ***/
/** PURPOSE: SBMJOB TARIABPO PER JOBD                              ***/
/**                                                                ***/
/** CREATED: 11/26/02                                              ***/
/** AUTHOR : DAN RAUCH - eXLTech, LLC                              ***/
/**                                                                ***/
/*********************************************************************/
/** SPECIAL NOTES:    AKRON60 VERSION COMPILED TO FILE LIB         ***/
/*********************************************************************/
             PGM

             DCL        VAR(&LDA) TYPE(*CHAR) LEN(1024)
             DCL        VAR(&JOBNAME) TYPE(*CHAR) LEN(10)
             DCL        VAR(&JOBDESC) TYPE(*CHAR) LEN(10)
             DCL        VAR(&JOBPROG) TYPE(*CHAR) LEN(10)
             DCL        VAR(&STATUS)  TYPE(*CHAR) LEN(10)
             DCL        VAR(&SYSNAM)  TYPE(*CHAR) LEN(08)

             MONMSG     MSGID(CPF9898)


             RTVNETA    SYSNAME(&SYSNAM)


/*------------------------------------------------------------------**/
/*-- DATA PASSED FROM CALLER VIA *LDA                             --**/
/*------------------------------------------------------------------**/
             RTVDTAARA  DTAARA(*LDA) RTNVAR(&LDA)
             CHGVAR     VAR(&JOBNAME) VALUE(%SST(&LDA 1  10))
             CHGVAR     VAR(&JOBDESC) VALUE(%SST(&LDA 11 10))
             CHGVAR     VAR(&JOBPROG) VALUE(%SST(&LDA 21 10))

/*------------------------------------------------------------------**/
/*-- DONT ALLOW SUBMITTED JOBS TO STACK UP ON THE JOBQ            --**/
/*-- IF JOB TO SUBMIT IS ALREADY ACTIVE OR ON JOBQ, THE EXIT PGM  --**/
/*------------------------------------------------------------------**/
             RTVJOBSTS  JOB(&JOBNAME) STATUS(*ACTIVE) +
                          RTNSTATUS(&STATUS)
             IF         COND(&STATUS *EQ '*ACTIVE') THEN(DO)
             GOTO       CMDLBL(ENDIT)
             ENDDO

             RTVJOBSTS  JOB(&JOBNAME) STATUS(*JOBQ) RTNSTATUS(&STATUS)
             IF         COND(&STATUS *EQ '*JOBQ') THEN(DO)
             GOTO       CMDLBL(ENDIT)
             ENDDO


/*------------------------------------------------------------------**/
/*-- =============>>  A K R O N 6 0    O N L Y <<===============  --**/
/*------------------------------------------------------------------**/
/*-- SUBMIT THE JOB TO BATCH QUEUE WITH THE USER = "MCMGRQA"      --**/
/*-- THIS WAY WE DON'T NEED TO KEEP CREATING SEPARATE USER         -**/
/*-- PROFILES FOR EACH DEV ENVIRONMENT ...JUST USE MCMGRQA FOR ALL--**/
/*------------------------------------------------------------------**/
             IF         COND(&SYSNAM *EQ 'AKRON60 ') THEN(DO)
             SBMJOB     CMD(CALL PGM(&JOBPROG)) JOB(&JOBNAME) +
                          JOBD(&JOBDESC) JOBQ(CSISMMIS) +
/*** AKRON60 ONLY ***/    USER(MCMGRQA) SYSLIBL(*SYSVAL) +
                          CURLIB(*CRTDFT) INLLIBL(*JOBD)
             ENDDO



/*------------------------------------------------------------------**/
/*-- =============>>  P L A N T   U S E   O N L Y <<============  --**/
/*------------------------------------------------------------------**/
/*-- SUBMIT THE JOB TO BATCH QUEUE WITH USER = &JOBDESC           --**/
/*------------------------------------------------------------------**/
             IF         COND(&SYSNAM *NE 'AKRON60 ') THEN(DO)
             SBMJOB     CMD(CALL PGM(&JOBPROG)) JOB(&JOBNAME) +
                          JOBD(&JOBDESC) JOBQ(CSISMMIS) +
/*** PLANTS *********/    USER(&JOBDESC) SYSLIBL(*SYSVAL) +
                          CURLIB(*CRTDFT) INLLIBL(*JOBD)
             ENDDO

ENDIT:       ENDPGM
