             CHKOBJ     OBJ(QTEMP/LBRFILE) OBJTYPE(*FILE)
             MONMSG     MSGID(CPF9800) EXEC(DO)
             CRTPF      FILE(QTEMP/LBRFILE) RCDLEN(86)
             ENDDO
             CLRPFM     FILE(QTEMP/LBRFILE)
             OVRDBF     FILE(LBRFILE) TOFILE(QTEMP/LBRFILE)
             DLTOVR     FILE(LBRFILE)
             ENDPGM
