             PGM
/*****************************************************************/
/*** PROGRAM: K01STORES                                        ***/
/*** PURPOSE: TO ADD AND CHANGE DATABASE FILES (PHYSICAL AND   ***/
/***          LOGICAL) FOR THE K01 DATABASE RELEASE.           ***/
/***          THIS WILL HANDLE THE STORES DATABASE.            ***/
/***                                                           ***/
/***          THIS PROGRAM CHECKS FOR THE EXISTENCE OF DATA    ***/
/***          LIBRARY MCPRD* (WHERE "*" IS AN INTEGER THAT IS  ***/
/***          INITIALLY SET TO 1), UPDATES THIS LIBRARY IF IT  ***/
/***          EXISTS, THEN INCREMENTS THE DATA LIBRARY NAME    ***/
/***          BY 1, AND CONTINUES LOOPING UNTIL THE INTEGER    ***/
/***          EXCEEDS 9, AT WHICH TIME THE PROGRAM ENDS        ***/
/***                                                           ***/
/***          FOR CHANGES TO THE DATABASE, THE CHGPF COMMAND   ***/
/***          WILL BE USED INSTEAD OF THE MANUAL MOVING OF THE ***/
/***          DATA TO INTERMEDIATE FILES AND BACK AFTER FILE   ***/
/***          CREATION.  TO USE THIS, LOCATIONS MUST BE AT     ***/
/***          LEAST ON V3R2, V3R6, OR V3R7.                    ***/
/***                                                           ***/
/***          RECOMPILE THIS PROGRAM WITH TARGET RELEASE OF    ***/
/***          OF V3R2M0 TO ACCOUNT FOR THE CHGPF COMMAND.      ***/
/*****************************************************************/
             DCL        VAR(&LIB)    TYPE(*CHAR) LEN(5) VALUE('MCPRD')
             DCL        VAR(&LIBN) TYPE(*DEC) LEN(1) VALUE(1)
             DCL        VAR(&LIBC) TYPE(*CHAR) LEN(1)
             DCL        VAR(&CURLIB) TYPE(*CHAR) LEN(6)
             DCL        VAR(&NBRCURRCD) TYPE(*DEC) LEN(10 0)

             CHGJOB     LOG(4 0 *SECLVL) LOGCLPGM(*YES)
LOOP:
             CHGVAR     VAR(&LIBC) VALUE(&LIBN)
             CHGVAR     VAR(&CURLIB) VALUE(&LIB *CAT &LIBC)

/*** CHECK TO SEE IF DATA LIBRARY MCPRD* EXISTS.  IF IT DOES NOT EXIST, ***/
/*** AND MCPRD9 WAS JUST CHECKED THEN END; OTHERWISE GO BACK TO LOOP.      ***/
             CHKOBJ     OBJ(QSYS/&CURLIB) OBJTYPE(*LIB)
             MONMSG     MSGID(CPF9801) EXEC(DO)
                 IF COND(&LIBN *EQ 9) THEN(GOTO CMDLBL(ENDLOOP))
                 CHGVAR VAR(&LIBN) VALUE(&LIBN + 1)
                 GOTO CMDLBL(LOOP)
             ENDDO

             CHGCURLIB  CURLIB(&CURLIB)
             SNDMSG     MSG('Program K01STORES is now updating  +
                          CSIS/MMIS data library - ' *CAT &CURLIB) +
                          TOUSR(*SYSOPR)

/*****************************************************************/
/**********          STORES REFERENCE FILE        ****************/
/*****************************************************************/
             DLTF       FILE(*CURLIB/STORES)
             MONMSG     MSGID(CPF2105)
             CRTPF      FILE(*CURLIB/STORES) +
                          SRCFILE(MCPRD/QDDSSRCDB) SRCMBR(STORES) +
                          TEXT(*SRCMBRTXT) SIZE(*NOMAX)

/*****************************************************************/
/**********                NEW FILE               ****************/
/**********             MCFPCSPCAT FILE           ****************/
/*****************************************************************/
             CHKOBJ     OBJ(*CURLIB/MCFPCSPCAT) OBJTYPE(*FILE)
             MONMSG     MSGID(CPF9801) EXEC(DO)
               CRTPF      FILE(*CURLIB/MCFPCSPCAT) +
                          SRCFILE(MCPRD/QDDSSRCDB) +
                          SRCMBR(MCFPCSPCAT) TEXT(*SRCMBRTXT) +
                          SIZE(*NOMAX)
               CRTLF      FILE(*CURLIB/MCFLCSPCA1) +
                          SRCFILE(MCPRD/QDDSSRCDB) +
                          SRCMBR(MCFLCSPCA1) TEXT(*SRCMBRTXT)
             ENDDO

/*****************************************************************/
/**********                NEW FILE               ****************/
/**********             MCFPCS6500 FILE           ****************/
/*****************************************************************/
             CHKOBJ     OBJ(*CURLIB/MCFPCS6500) OBJTYPE(*FILE)
             MONMSG     MSGID(CPF9801) EXEC(DO)
               CRTPF      FILE(*CURLIB/MCFPCS6500) +
                          SRCFILE(MCPRD/QDDSSRCDB) +
                          SRCMBR(MCFPCS6500) TEXT(*SRCMBRTXT) +
                          SIZE(*NOMAX)
               CRTLF      FILE(*CURLIB/MCFLCS6501) +
                          SRCFILE(MCPRD/QDDSSRCDB) +
                          SRCMBR(MCFLCS6501) TEXT(*SRCMBRTXT)
               CRTLF      FILE(*CURLIB/MCFLCS6502) +
                          SRCFILE(MCPRD/QDDSSRCDB) +
                          SRCMBR(MCFLCS6502) TEXT(*SRCMBRTXT)
             ENDDO

/*****************************************************************/
/**********                NEW FILE               ****************/
/**********             MCFPCS6600 FILE           ****************/
/*****************************************************************/
             CHKOBJ     OBJ(*CURLIB/MCFPCS6600) OBJTYPE(*FILE)
             MONMSG     MSGID(CPF9801) EXEC(DO)
               CRTPF      FILE(*CURLIB/MCFPCS6600) +
                          SRCFILE(MCPRD/QDDSSRCDB) +
                          SRCMBR(MCFPCS6600) TEXT(*SRCMBRTXT) +
                          SIZE(*NOMAX) REUSEDLT(*YES)
               CRTLF      FILE(*CURLIB/MCFLCS6601) +
                          SRCFILE(MCPRD/QDDSSRCDB) +
                          SRCMBR(MCFLCS6601) TEXT(*SRCMBRTXT)
             ENDDO

/*****************************************************************/
/**********                NEW FILE               ****************/
/**********             MCFPCS6700 FILE           ****************/
/*****************************************************************/
             CHKOBJ     OBJ(*CURLIB/MCFPCS6700) OBJTYPE(*FILE)
             MONMSG     MSGID(CPF9801) EXEC(DO)
               CRTPF      FILE(*CURLIB/MCFPCS6700) +
                          SRCFILE(MCPRD/QDDSSRCDB) +
                          SRCMBR(MCFPCS6700) TEXT(*SRCMBRTXT) +
                          SIZE(*NOMAX) REUSEDLT(*YES)
               CRTLF      FILE(*CURLIB/MCFLCS6701) +
                          SRCFILE(MCPRD/QDDSSRCDB) +
                          SRCMBR(MCFLCS6701) TEXT(*SRCMBRTXT)
             ENDDO

/*****************************************************************/
/**********                NEW FILE               ****************/
/**********             MCFPCS6800 FILE           ****************/
/*****************************************************************/
             CHKOBJ     OBJ(*CURLIB/MCFPCS6800) OBJTYPE(*FILE)
             MONMSG     MSGID(CPF9801) EXEC(DO)
               CRTPF      FILE(*CURLIB/MCFPCS6800) +
                          SRCFILE(MCPRD/QDDSSRCDB) +
                          SRCMBR(MCFPCS6800) TEXT(*SRCMBRTXT) +
                          SIZE(*NOMAX) REUSEDLT(*YES)
               CRTLF      FILE(*CURLIB/MCFLCS6801) +
                          SRCFILE(MCPRD/QDDSSRCDB) +
                          SRCMBR(MCFLCS6801) TEXT(*SRCMBRTXT)
             ENDDO

/*****************************************************************/
/**********                NEW FILE               ****************/
/**********             MCFPCSRCPT FILE           ****************/
/* (SHOULD HAVE BEEN ADDED AS PART OF J.01 RELEASE IN MOST PLTS) */
/*****************************************************************/
             CHKOBJ     OBJ(*CURLIB/MCFPCSRCPT) OBJTYPE(*FILE)
             MONMSG     MSGID(CPF9801) EXEC(DO)
               CRTPF      FILE(*CURLIB/MCFPCSRCPT) +
                          SRCFILE(MCPRD/QDDSSRCDB) +
                          SRCMBR(MCFPCSRCPT) TEXT(*SRCMBRTXT) +
                          SIZE(*NOMAX) REUSEDLT(*YES)
               CRTLF      FILE(*CURLIB/MCFLCSRCPT) +
                          SRCFILE(MCPRD/QDDSSRCDB) +
                          SRCMBR(MCFLCSRCPT) TEXT(*SRCMBRTXT)
             ENDDO

/*****************************************************************/
/**********                NEW FILE               ****************/
/**********              RECDYSFIL FILE           ****************/
/*****************************************************************/
             CHKOBJ     OBJ(*CURLIB/RECDYSFIL) OBJTYPE(*FILE)
             MONMSG     MSGID(CPF9801) EXEC(DO)
             CRTPF      FILE(RECDYSFIL) RCDLEN(18) TEXT('Received +
                          Yesterday File') SIZE(*NOMAX)
             ENDDO

/*****************************************************************/
/**********                NEW FILE               ****************/
/**********             MCFPPOFILE FILE           ****************/
/*****************************************************************/
             CHKOBJ     OBJ(*CURLIB/MCFPPOFILE) OBJTYPE(*FILE)
             MONMSG     MSGID(CPF9801) EXEC(DO)
               CRTPF      FILE(*CURLIB/MCFPPOFILE) +
                          SRCFILE(MCPRD/QDDSSRCDB) +
                          SRCMBR(MCFPPOFILE) TEXT(*SRCMBRTXT) +
                          SIZE(*NOMAX)
             ENDDO

/*****************************************************************/
/**********                NEW FILE               ****************/
/**********             MCFPPOFIL2 FILE           ****************/
/*****************************************************************/
             CHKOBJ     OBJ(*CURLIB/MCFPPOFIL2) OBJTYPE(*FILE)
             MONMSG     MSGID(CPF9801) EXEC(DO)
               CRTPF      FILE(*CURLIB/MCFPPOFIL2) +
                          SRCFILE(MCPRD/QDDSSRCDB) +
                          SRCMBR(MCFPPOFIL2) TEXT(*SRCMBRTXT) +
                          SIZE(*NOMAX)
             ENDDO

/*****************************************************************/
/**********                NEW FILE               ****************/
/**********              DDTLCHGS FILE            ****************/
/*****************************************************************/
             CHKOBJ     OBJ(*CURLIB/DDTLCHGS) OBJTYPE(*FILE)
             MONMSG     MSGID(CPF9801) EXEC(DO)
             CRTPF      FILE(DDTLCHGS) RCDLEN(133) TEXT('TDTLCHGS +
                          Report File') SIZE(*NOMAX)
             ENDDO

/*****************************************************************/
/**********                NEW FILE               ****************/
/**********              DDLYCHGS FILE            ****************/
/*****************************************************************/
             CHKOBJ     OBJ(*CURLIB/DDLYCHGS) OBJTYPE(*FILE)
             MONMSG     MSGID(CPF9801) EXEC(DO)
             CRTPF      FILE(DDLYCHGS) RCDLEN(133) TEXT('TDLYCHGS +
                          Report File') SIZE(*NOMAX)
             ENDDO

/*****************************************************************/
/**********             NEW LOGICAL FILE          ****************/
/**********             MCFLCS0807 FILE           ****************/
/*****************************************************************/
             CHKOBJ     OBJ(*CURLIB/MCFLCS0807) OBJTYPE(*FILE)
             MONMSG     MSGID(CPF9801) EXEC(DO)
               CRTLF      FILE(*CURLIB/MCFLCS0807) +
                          SRCFILE(MCPRD/QDDSSRCDB) +
                          SRCMBR(MCFLCS0807) TEXT(*SRCMBRTXT)
             ENDDO

/*****************************************************************/
/**********             NEW LOGICAL FILE          ****************/
/**********             MCFLGENSM2 FILE           ****************/
/*****************************************************************/
             CHKOBJ     OBJ(*CURLIB/MCFLGENSM2) OBJTYPE(*FILE)
             MONMSG     MSGID(CPF9801) EXEC(DO)
               CRTLF      FILE(*CURLIB/MCFLGENSM2) +
                          SRCFILE(MCPRD/QDDSSRCDB) +
                          SRCMBR(MCFLGENSM2) TEXT(*SRCMBRTXT)
             ENDDO

/*****************************************************************/
/************      MCFPCS2900  DSHIPREL           ****************/
/************ USE CHGPF INSTEAD OF THE FOLLOWING  ****************/
/************  A) DELETE LOGICAL FILES            ****************/
/************  B) CREATE DUP OBJ OF PHYSICAL      ****************/
/************  C) DELETE PHYSICAL FILE            ****************/
/************  D) CREATE PHYSICAL FILE            ****************/
/************  E) COPY DUP OBJ INTO NEW PHYSICAL  ****************/
/************  F) CREATE LOGICAL FILES            ****************/
/************  G) DELETE DUP OBJ OF PHYSICAL      ****************/
/*****************************************************************/

             CHGPF      FILE(*CURLIB/MCFPCS2900) +
                          SRCFILE(MCPRD/QDDSSRCDB) LANGID(ENU)
             MONMSG     MSGID(CPF0000) EXEC(DO)
                        SNDMSG MSG('The CHGPF command on MCFPCS2900 has +
                          failed.  Please contact CSIS/MMIS staff.  +
                          Processing continues with other database +
                          changes.') TOUSR(*SYSOPR)
                        SNDPGMMSG MSG('The CHGPF command on MCFPCS2900 has +
                          failed.  Please contact CSIS/MMIS staff.  +
                          Processing continues with other database +
                          changes.')
             ENDDO

/*****************************************************************/
/**********        INCREASE PASSWORD FIELDS       ****************/
/**********              MCFP000200 FILE          ****************/
/********** USE CHGPF INSTEAD OF USING INT. FILES ****************/
/*****************************************************************/

             CHKOBJ     OBJ(*CURLIB/MCFP000200) OBJTYPE(*FILE)
             MONMSG     MSGID(CPF9801) EXEC(GOTO CMDLBL(ENDPWD))

             CHGPF      FILE(*CURLIB/MCFP000200) +
                          SRCFILE(MCPRD/QDDSSRCDB) LANGID(ENU)
             MONMSG     MSGID(CPF0000) EXEC(DO)
                        SNDMSG MSG('The CHGPF command on MCFP000200 has +
                          failed.  Please contact CSIS/MMIS staff.  +
                          Processing continues with other database +
                          changes.') TOUSR(*SYSOPR)
                        SNDPGMMSG MSG('The CHGPF command on MCFP000200 has +
                          failed.  Please contact CSIS/MMIS staff.  +
                          Processing continues with other database +
                          changes.')
             ENDDO
 ENDPWD:

/*****************************************************************/
/**********            ADD CENTURY TO FILE        ****************/
/**********              MCFPCSTERM FILE          ****************/
/**********     COPY DATA TO INTERMEDIATE FILE    ****************/
/*****************************************************************/
             CHKOBJ     OBJ(*CURLIB/MCFPCSTERM) OBJTYPE(*FILE)
             MONMSG     MSGID(CPF9801) EXEC(GOTO CMDLBL(TERM2))
             CHKOBJ     OBJ(*LIBL/ICFPCSTERM) OBJTYPE(*FILE)
             MONMSG     MSGID(CPF9801) EXEC(DO)
                 SNDMSG   MSG('CSIS/MMIS intermediate file ICFPCSTERM +
                          does not exist.  K01STORES skipping this +
                          step either because the step had been +
                          completed or file was not restored.  If +
                          not restored, restore this intermediate +
                          file and attempt to run K01STORES again.') +
                          TOUSR(QSYSOPR)
                 GOTO   CMDLBL(TERM2)
             ENDDO
             RTVMBRD    FILE(*CURLIB/MCFPCSTERM) NBRCURRCD(&NBRCURRCD)
             IF         (&NBRCURRCD *GT 0) THEN(DO)
             CPYF       FROMFILE(*CURLIB/MCFPCSTERM) +
                          TOFILE(*LIBL/ICFPCSTERM) +
                          MBROPT(*REPLACE) FMTOPT(*MAP *DROP)
             MONMSG     MSGID(CPF0000) EXEC(DO)
             SNDMSG     MSG('CSIS/MMIS K01STORES ERROR.  Error copying +
                          MCFPCSTERM data to intermediate file.  +
                          Check joblog, resolve error and attempt +
                          to run K01STORES again.') TOUSR(QSYSOPR)
                 GOTO   CMDLBL(ENDPGM)
             ENDDO
             ENDDO
             DLTF       FILE(*CURLIB/MCFLCSTERM)
             MONMSG     MSGID(CPF2105)
             DLTF       FILE(*CURLIB/MCFPCSTERM)
             MONMSG     MSGID(CPF2105)

/*****************************************************************/
/************             MCFPCSTERM              ****************/
/************  C) CREATE PHYSICAL FILE            ****************/
/************  D) COPY ICFP* FILE INTO MCFP* FILE ****************/
/************  E) CREATE LOGICAL FILE             ****************/
/*****************************************************************/
TERM2:
             CHKOBJ     OBJ(*LIBL/ICFPCSTERM) OBJTYPE(*FILE)
             MONMSG     MSGID(CPF9801) EXEC(GOTO CMDLBL(ENDTERM))
             CRTPF      FILE(*CURLIB/MCFPCSTERM) +
                          SRCFILE(MCPRD/QDDSSRCDB) +
                          SRCMBR(MCFPCSTERM) TEXT(*SRCMBRTXT) +
                          SIZE(*NOMAX)
             MONMSG     MSGID(CPF0000) EXEC(DO)
                 SNDMSG MSG('CSIS/MMIS K01STORES ERROR.  Error +
                          creating MCFPCSTERM file.  Check joblog, +
                          resolve error and attempt to run K01STORES +
                          again.') TOUSR(QSYSOPR)
                 GOTO   CMDLBL(ENDPGM)
             ENDDO
             RTVMBRD    FILE(*LIBL/ICFPCSTERM) NBRCURRCD(&NBRCURRCD)
             IF         (&NBRCURRCD *GT 0) THEN(DO)
             CPYF       FROMFILE(*LIBL/ICFPCSTERM) +
                          TOFILE(*CURLIB/MCFPCSTERM) MBROPT(*REPLACE) +
                          FMTOPT(*NOCHK)
             MONMSG     MSGID(CPF0000) EXEC(DO)
             SNDMSG     MSG('CSIS/MMIS K01STORES ERROR.  Error +
                          copying intermediate file to MCFPCSTERM +
                          file.  Check joblog, resolve error and +
                          attempt to run K01STORES again.') +
                          TOUSR(QSYSOPR)
                 GOTO   CMDLBL(ENDPGM)
             ENDDO
             ENDDO
             CRTLF      FILE(*CURLIB/MCFLCSTERM) +
                          SRCFILE(MCPRD/QDDSSRCDB) +
                          SRCMBR(MCFLCSTERM) TEXT(*SRCMBRTXT)
             DLTF       FILE(*LIBL/ICFPCSTERM)
 ENDTERM:

/*****************************************************************/
/************      MCFPCSUSAG  USAGEFILE          ****************/
/*****************************************************************/

             CHGPF      FILE(*CURLIB/MCFPCSUSAG) +
                          SRCFILE(MCPRD/QDDSSRCDB) LANGID(ENU)
             MONMSG     MSGID(CPF0000) EXEC(DO)
                        SNDMSG MSG('The CHGPF command on MCFPCSUSAG has +
                          failed.  Please contact CSIS/MMIS staff.  +
                          Processing continues with other database +
                          changes.') TOUSR(*SYSOPR)
                        SNDPGMMSG MSG('The CHGPF command on MCFPCSUSAG has +
                          failed.  Please contact CSIS/MMIS staff.  +
                          Processing continues with other database +
                          changes.')
             ENDDO

/*****************************************************************/
/************      FIX Y2K INVALID DATES          ****************/
/*****************************************************************/
             CALL       PGM(CLFIXY2K)
             MONMSG     MSGID(CPF0000) EXEC(DO)
                        SNDMSG     MSG('The call to program CLFIXY2K has +
                          failed.  Please contact CSIS/MMIS staff.  +
                          Processing continues with other database +
                          changes.') TOUSR(*SYSOPR)
                        SNDPGMMSG  MSG('The call to program CLFIXY2K has +
                          failed.  Please contact CSIS/MMIS staff.  +
                          Processing continues with other database +
                          changes.')
             ENDDO

/*****************************************************************/
/********* CHANGE MMIS PASSWORDS FROM 6 TO 8 CHARACTERS **********/
/*****************************************************************/
             CALL       PGM(TPPRESET)
             MONMSG     MSGID(CPF0000) EXEC(DO)
                        SNDMSG     MSG('The call to program TPPRESET has +
                          failed.  Please contact CSIS/MMIS staff.  +
                          Processing continues with other database +
                          changes.') TOUSR(*SYSOPR)
                        SNDPGMMSG  MSG('The call to program TPPRESET has +
                          failed.  Please contact CSIS/MMIS staff.  +
                          Processing continues with other database +
                          changes.')
             ENDDO

/*********************************************************************/
/***   COPY DATA FROM DRPTICHK TO DRPTICHKSV, AND CLEAR DRPTICHK   ***/
/***   (DRPTICHK MAY CONTAIN DATA WHICH IS NOT COMPATIBLE WITH     ***/
/***   THE NEW VERSION OF PROGRAM TPRTRPT)                         ***/
/*********************************************************************/

             CHKOBJ     OBJ(*CURLIB/DRPTICHK) OBJTYPE(*FILE)
             MONMSG     MSGID(CPF9801) EXEC(GOTO CMDLBL(ENDICHK))
             DLTF       FILE(*CURLIB/DRPTICHKSV)
             MONMSG     MSGID(CPF2105)
             CRTDUPOBJ  OBJ(DRPTICHK) FROMLIB(*CURLIB) +
                          OBJTYPE(*FILE) NEWOBJ(DRPTICHKSV) DATA(*YES)
             CLRPFM     FILE(*CURLIB/DRPTICHK)
ENDICHK:

/*****************************************************************/
/************        INITIALIZE MCFPCSRCPT        ****************/
/*****************************************************************/
             CHGPF      FILE(*CURLIB/MCFPCSRCPT) SIZE(*NOMAX) +
                          REUSEDLT(*YES)
             MONMSG     MSGID(CPF0000) EXEC(DO)
                        SNDMSG MSG('The CHGPF command on MCFPCSRCPT has +
                          failed.  Please contact CSIS/MMIS staff.  +
                          Processing continues with other database +
                          changes.') TOUSR(*SYSOPR)
                        SNDPGMMSG MSG('The CHGPF command on MCFPCSRCPT has +
                          failed.  Please contact CSIS/MMIS staff.  +
                          Processing continues with other database +
                          changes.')
             ENDDO

             CALL       PGM(TRCCHECK) PARM('Y' 'N')
             MONMSG     MSGID(CPF0000) EXEC(DO)
                        SNDMSG     MSG('The call to program TRCCHECK has +
                          failed.  Please contact CSIS/MMIS staff.  +
                          Processing continues with other database +
                          changes.') TOUSR(*SYSOPR)
                        SNDPGMMSG  MSG('The call to program TRCCHECK has +
                          failed.  Please contact CSIS/MMIS staff.  +
                          Processing continues with other database +
                          changes.')
             ENDDO

/*** INCREMENT THE LIBRARY NAME BY 1, AND GO BACK TO THE BEGINNING   ***/
/*** OF THE PROGRAM.                                                 ***/
             SNDMSG     MSG('Program K01STORES completed updating  +
                          CSIS/MMIS data library - ' *CAT &CURLIB) +
                          TOUSR(*SYSOPR)
             IF COND(&LIBN *EQ 9) THEN(GOTO CMDLBL(ENDLOOP))
             CHGVAR     VAR(&LIBN) VALUE(&LIBN + 1)
             GOTO CMDLBL(LOOP)

ENDLOOP:
             SNDMSG     MSG('K01STORES has COMPLETED') +
                          TOUSR(*SYSOPR)
/*****************************************************************/
ENDPGM:
             ENDPGM
