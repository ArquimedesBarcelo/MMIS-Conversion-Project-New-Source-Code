             PGM
/*****************************************************************/
/*** PROGRAM: CLSCCREATE                                       ***/
/*** PURPOSE: TO CREATE THE DATABASE FILES (PHYSICAL AND       ***/
/***          LOGICAL) FOR THE SAFETY CONTACT SYSTEM.          ***/
/*****************************************************************/
/*                                                               */
/*****************************************************************/
/**********                 STEP 1                ****************/
/**********      SAFETY CONTACT REFERENCE FILE    ****************/
/**********      CREATE PHYSICAL REFERENCE FILE   ****************/
/*****************************************************************/
             CRTPF      FILE(MCPRD1/SAFETYC) SRCFILE(*LIBL/QDDSSRCSC) +
                          SRCMBR(SAFETYC) TEXT('SAFETY CONTACT Reference +
                          File') SIZE(*NOMAX)
/*****************************************************************/
/**********                 STEP 2                ****************/
/**********       MCFPSC0100  SAFETY-CONTACT      ****************/
/**********   CREATE PHYSICAL AND LOGICAL FILES   ****************/
/*****************************************************************/
             CRTPF      FILE(MCPRD1/MCFPSC0100) +
                          SRCFILE(*LIBL/QDDSSRCSC) +
                          SRCMBR(MCFPSC0100) TEXT('SAFETY-CONTACT  +
                          Physical File') SIZE(*NOMAX)
             CRTLF      FILE(MCPRD1/MCFLSC0101) +
                          SRCFILE(*LIBL/QDDSSRCSC) +
                          SRCMBR(MCFLSC0101) TEXT('SAFETY-CONTACT  +
                          Logical File (SCDATESTMP)')
             CRTLF      FILE(MCPRD1/MCFLSC0102) +
                          SRCFILE(*LIBL/QDDSSRCSC) +
                          SRCMBR(MCFLSC0102) TEXT('SAFETY-CONTACT  +
                          Logical File (SCZONE)')
             CRTLF      FILE(MCPRD1/MCFLSC0103) +
                          SRCFILE(*LIBL/QDDSSRCSC) +
                          SRCMBR(MCFLSC0103) TEXT('SAFETY-CONTACT  +
                          Logical File (SCDELDATE)')
             CRTLF      FILE(MCPRD1/MCFLSC0104) +
                          SRCFILE(*LIBL/QDDSSRCSC) +
                          SRCMBR(MCFLSC0104) TEXT('SAFETY-CONTACT  +
                          Logical File (Date/Type/Time)')
             ENDPGM
