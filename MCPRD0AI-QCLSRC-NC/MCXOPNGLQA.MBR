/*********************************************************************/
/** PROGRAM: MCXOPNGLQA                                             **/
/**                                                                 **/
/** PURPOSE: START UP CSIS QA ENVIRONMENT                           **/
/**                                                                 **/
/*********************************************************************/
/** SPECIAL NOTES:                                                  **/
/** ==> THIS VERSION DOES NOT OPEN ALL DATABASE FILES               **/
/*********************************************************************/
/**                   M O D I F I C A T I O N S                     **/
/**        ---------------------------------------------------      **/
/** OCT 7, 2004   D.RAUCH    REQUEST#  2004-25599                   **/
/** ==> DCR01   RESTORE *CURLIB TO PREVIOUS VALUE ON PGM EXIT       **/
/**-----------------------------------------------------------------**/
/** XXX XX, XXXX  XXXXXXXXXXX  REQUEST# 9999-12345                  **/
/** ===> ?????   ENTER MOD DESCRIPTION HERE                         **/
/**-----------------------------------------------------------------**/
/*********************************************************************/
PGM
/*DCR01*/    DCL        VAR(&PRVCURLIB) TYPE(*CHAR) LEN(10)
/*DCR01*/    DCL        VAR(&STARNONE)  TYPE(*CHAR) LEN(10)
             DCL        VAR(&S)          TYPE(*CHAR) LEN(2)
             DCL        VAR(&SCJOB)      TYPE(*CHAR) LEN(10)
             DCL        VAR(&FRMMNUFLG)  TYPE(*CHAR) LEN(1)
             DCL        VAR(&FILSOPNFLG) TYPE(*CHAR) LEN(1)
             DCL        VAR(&SCOPE)      TYPE(*CHAR) LEN(1)

/*DCR01*/    CHGVAR     VAR(&STARNONE) VALUE('*NONE')

/*DCR01* =======================================================***/
/*DCR01* ==  SAVE *CURLIB SO IT CAN BE RESTORED LATER             */
/*DCR01* =======================================================***/
/*DCR01*/    RTVJOBA    CURLIB(&PRVCURLIB)

/*DCR01*/    IF         COND(&PRVCURLIB *EQ &STARNONE) THEN(DO)
/*DCR01*/    CHGVAR     VAR(&PRVCURLIB) VALUE('*CRTDFT')
/*DCR01*/    ENDDO

/*###############################################################*/
/*### THIS PROGRAM IS IDENTICAL TO ALL OF THE OTHER MCXOPNGL* ###*/
/*### PROGRAMS EXCEPT THE FOLLOWING BLOCK OF LOGIC.           ###*/
/*###############################################################*/
             RMVLIBLE   LIB(MCPRD1)
             MONMSG     MSGID(CPF0000)
             ADDLIBLE   LIB(MCQA1)
             MONMSG     MSGID(CPF0000)
             CHGCURLIB  CURLIB(MCQA1)
             MONMSG     MSGID(CPF0000)
/*### END OF LOGIC UNIQUE TO THIS MCXOPNGL* PROGRAM           ###*/
/*###############################################################*/

             CHGJOB     INQMSGRPY(*SYSRPYL)
             MONMSG     MSGID(CPF0000)
             OVRPRTF    FILE(QPPGMDMP) OUTQ(PD01) HOLD(*YES) +
                          USRDTA(MCABEND)

/******************************************************************/
/* CHGKBDMAP FOR USERS USING 3270 HCF EMULATION TO AS/400.        */
/******************************************************************/
             CHGKBDMAP  PF1(*F1) PF2(*F2) PF3(*F3) PF4(*F4) PF5(*F5) +
                          PF6(*F6) PF7(*F7) PF8(*F8) PF9(*F9) +
                          PF10(*F10) PF11(*F11) PF12(*F12) +
                          PF13(*F13) PF14(*F14) PF15(*F15) +
                          PF16(*F16) PF17(*F17) PF18(*F18) +
                          PF19(*F19) PF20(*F20) PF21(*F21) +
                          PF22(*F22) PF23(*F23) PF24(*F24) +
                          PA1PF1(*HELP) PA1PF2(*HLP3270) +
                          PA1PF7(*DOWN) PA1PF8(*UP) PA1PF10(*RESET) +
                          PA1PF11(*CLEAR) PA1PF12(*PRINT)
             MONMSG     MSGID(CPF0000)

CMDCALL:
IF (&FRMMNUFLG = 'N') THEN(DO)
   /***CALL UTPRD/UTX9001  REPLACED 27JUL1995***/
   CALL UTX9001
   MONMSG MSGID(CPF0000)
ENDDO
ELSE DO
   /*  SET UP COBOL ERROR HANDLER   */
   CHGVAR     VAR(&SCOPE) VALUE('P')
   CALL       PGM(MCXCBLERR) PARM(&SCOPE)
   MONMSG     MSGID(CPF0000)

   CALL UTC9002
   MONMSG MSGID(CPF0000) EXEC(DO)
      CHGDTAARA  DTAARA(*LDA (108 8)) VALUE('        ')
      GOTO       CMDLBL(CMDCALL)
   ENDDO
ENDDO

ENDOFPGM:

/*DCR01* =======================================================***/
/*DCR01* === RESTORE *CURLIB TO PREVIOUS VALUE                   **/
/*DCR01* =======================================================***/
/*DCR01*/    CHGCURLIB  CURLIB(&PRVCURLIB)
/*DCR01*/    MONMSG     MSGID(CPF0000)

ENDPGM
