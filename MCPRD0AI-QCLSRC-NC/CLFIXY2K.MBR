         /*****************************************************/
         /*  PGM NAME: CLFIXY2K                               */
         /*                                                   */
         /*  THIS PROGRAM WILL CORRECT DATE FIELDS THAT       */
         /*  CONTAIN INVALID DATES FOUND IN Y2K TESTING.      */
         /*                                                   */
         /*  USED IN PROGRAM(S): K01STORES                    */
         /*                                                   */
         /*  VAR(S) PASSED     : NONE                         */
         /*                                                   */
         /*****************************************************/

             CHKOBJ     OBJ(*LIBL/RUNSQL) OBJTYPE(*PGM)
             MONMSG     MSGID(CPF9801) EXEC(DO)
               SNDMSG     MSG('Y2K Date Fields not Updated in CSIS  +
                          because RUNQL does not exist.  Contact CSIS +
                          Programming.') +
                          TOUSR(QSYSOPR)
               GOTO     CMDLBL(ENDPGM)
             ENDDO

         /*****************************************************/
         /*****  UPDATE MSTORERM                          *****/
         /*****************************************************/
 STEP1:      CHKOBJ     OBJ(*CURLIB/MCFPCS0200) OBJTYPE(*FILE)
             MONMSG     MSGID(CPF9801) EXEC(GOTO CMDLBL(STEP2))
             RUNSQL     REQUEST('UPDATE MCFPCS0200 +
                          SET REQDTE = ''XXXXXXXX'' +
                          WHERE REQDTE = ''19XXXXXX''')

         /*****************************************************/
         /*****  UPDATE DPORECD                           *****/
         /*****************************************************/
 STEP2:      CHKOBJ     OBJ(*CURLIB/MCFPCS0900) OBJTYPE(*FILE)
             MONMSG     MSGID(CPF9801) EXEC(GOTO CMDLBL(STEP3))
             RUNSQL     REQUEST('UPDATE MCFPCS0900 +
                          SET SHIPDTE = ''00000000'' +
                          WHERE SHIPDTE = ''19000000'' +
                          OR SHIPDTE = ''20000000''')

         /*****************************************************/
         /*****  UPDATE DPOITEM                           *****/
         /*****************************************************/
 STEP3:      CHKOBJ     OBJ(*CURLIB/MCFPCS1000) OBJTYPE(*FILE)
             MONMSG     MSGID(CPF9801) EXEC(GOTO CMDLBL(STEP4))
             RUNSQL     REQUEST('UPDATE MCFPCS1000 +
                          SET SHIPDTE = ''00000000'' +
                          WHERE SHIPDTE = ''19000000'' OR +
                          SHIPDTE = ''20000000''')
             RUNSQL     REQUEST('UPDATE MCFPCS1000 +
                          SET EXPECTDTE = ''00000000'' +
                          WHERE EXPECTDTE = ''19000000'' OR +
                          EXPECTDTE = ''20000000''')
             RUNSQL     REQUEST('UPDATE MCFPCS1000 +
                          SET DTERCVD = ''00000000'' +
                          WHERE DTERCVD = ''19000000'' OR +
                          DTERCVD = ''20000000''')

         /*****************************************************/
         /*****  UPDATE DPOFREIGHT                        *****/
         /*****************************************************/
 STEP4:      CHKOBJ     OBJ(*CURLIB/MCFPCS2400) OBJTYPE(*FILE)
             MONMSG     MSGID(CPF9801) EXEC(GOTO CMDLBL(STEP5))
             RUNSQL     REQUEST('UPDATE MCFPCS2400 +
                          SET FRTBILLDTE = ''00000000'' +
                          WHERE FRTBILLDTE = ''19000000'' OR +
                          FRTBILLDTE = ''20000000''')

         /*****************************************************/
         /*****  UPDATE DINVRCD                           *****/
         /*****************************************************/
 STEP5:      CHKOBJ     OBJ(*CURLIB/MCFPCS2500) OBJTYPE(*FILE)
             MONMSG     MSGID(CPF9801) EXEC(GOTO CMDLBL(STEP6))
             RUNSQL     REQUEST('UPDATE MCFPCS2500 +
                          SET INVDTE = ''00000000'' +
                          WHERE INVDTE = ''19000000'' OR +
                          INVDTE = ''20000000''')

         /*****************************************************/
         /*****  UPDATE DPORECDH                          *****/
         /*****************************************************/
 STEP6:      CHKOBJ     OBJ(*CURLIB/MCFPST0300) OBJTYPE(*FILE)
             MONMSG     MSGID(CPF9801) EXEC(GOTO CMDLBL(ENDPGM))
             RUNSQL     REQUEST('UPDATE MCFPST0300  +
                          SET SHIPDTE = 0 +
                          WHERE SHIPDTE = 19000000  +
                          OR SHIPDTE = 20000000')

 ENDPGM:
             ENDPGM
