PGM PARM(&USERNAME &TERMINAL &CURLIB &JOBTYPE)
             DCL        VAR(&USERNAME) TYPE(*CHAR) LEN(10)
             DCL        VAR(&TERMINAL) TYPE(*CHAR) LEN(10)
             DCL        VAR(&CURLIB) TYPE(*CHAR) LEN(10)
             DCL        VAR(&JOBTYPE) TYPE(*CHAR) LEN(1)
             RTVJOBA    JOB(&TERMINAL) USER(&USERNAME) TYPE(&JOBTYPE) +
                          CURLIB(&CURLIB)
             ENDPGM
