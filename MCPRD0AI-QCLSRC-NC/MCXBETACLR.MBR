             PGM
/*****************************************************************/
/***                                                           ***/
/*** PROGRAM: MCXBETACLR                                       ***/
/*** PURPOSE: CLEAR MCPRD AND MCPRDB AFTER CREATION OF MCBETA  ***/
/***          TO PREPARE FOR THE NEXT RELEASE.                 ***/
/***                                                           ***/
/*****************************************************************/
             CHKOBJ     OBJ(MCBETA/QJOBSRC2) OBJTYPE(*FILE)
             MONMSG     MSGID(CPF9810) EXEC(DO)
             SNDMSG     MSG('MCBETA has not been created, MCPRD and +
                          MCPRDB will not be cleared.') TOUSR(*SYSOPR)
             GOTO       CMDLBL(ENDPGM)
             ENDDO
/*** MCPRD                                                     ***/
             CLRLIB     LIB(MCPRD)
             CRTSRCPF   FILE(MCPRD/COPYLIB) TEXT('CSIS/MMIS SOURCE +
                          COPY')
             CRTSRCPF   FILE(MCPRD/QCLSRC )
             CRTSRCPF   FILE(MCPRD/QCMDSRC )
             CRTSRCPF   FILE(MCPRD/QDDSSRC )
             CRTSRCPF   FILE(MCPRD/QDDSSRCDB )
             CRTSRCPF   FILE(MCPRD/QLBLSRC )
             CRTSRCPF   FILE(MCPRD/QRJEJCL )
             CRTSRCPF   FILE(MCPRD/QFTPSRC )
/***  MCPRDB                                                 ***/
             CLRLIB     LIB(MCPRDB)
             CRTSRCPF   FILE(MCPRDB/QJOBSRC)
/***  SEND SUCCESS MESSAGE                                   ***/
             SNDMSG     MSG('MCPRD and MCPRDB have been cleared and +
                          their source physical files recreated.') +
                          TOUSR(*SYSOPR)
             DSPJOBLOG  OUTPUT(*PRINT)
ENDPGM:      ENDPGM
