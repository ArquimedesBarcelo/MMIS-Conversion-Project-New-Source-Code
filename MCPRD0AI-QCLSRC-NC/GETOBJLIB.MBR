/*********************************************************************/
/** PROGRAM: GETPGMCL                                              ***/
/**                                                                ***/
/** PURPOSE: RETRIEVE AN OBJECT'S LIBRARY NAME                     ***/
/**                                                                ***/
/** CREATED:  1/15/03                                              ***/
/** AUTHOR : DAN RAUCH - EXLTECH,INC                               ***/
/**                                                                ***/
/*********************************************************************/
/** SPECIAL NOTES:                                                 ***/
/*********************************************************************/
             PGM        PARM(&OBJNAME &LIBNAME &OBJTYPE)
             DCL        VAR(&OBJNAME) TYPE(*CHAR) LEN(10)
             DCL        VAR(&LIBNAME) TYPE(*CHAR) LEN(10)
             DCL        VAR(&OBJTYPE) TYPE(*CHAR) LEN(7)

             MONMSG     MSGID(CPF0000) EXEC(GOTO CMDLBL(ENDIT))

             RTVOBJD    OBJ(&OBJNAME) OBJTYPE(&OBJTYPE) +
                          RTNLIB(&LIBNAME)

ENDIT:
ENDPGM
