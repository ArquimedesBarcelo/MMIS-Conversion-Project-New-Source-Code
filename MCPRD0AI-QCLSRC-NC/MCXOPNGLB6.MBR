PGM
             DCL        VAR(&S)          TYPE(*CHAR) LEN(2)
             DCL        VAR(&SCJOB)      TYPE(*CHAR) LEN(10)
             DCL        VAR(&FRMMNUFLG)  TYPE(*CHAR) LEN(1)
             DCL        VAR(&FILSOPNFLG) TYPE(*CHAR) LEN(1)
             DCL        VAR(&SCOPE)      TYPE(*CHAR) LEN(1)

/*###############################################################*/
/*### THIS PROGRAM IS IDENTICAL TO ALL OF THE OTHER MCXOPNGL* ###*/
/*### PROGRAMS EXCEPT THE FOLLOWING BLOCK OF LOGIC.           ###*/
             RMVLIBLE   LIB(MCPRD1)
             MONMSG     MSGID(CPF0000)
             ADDLIBLE   LIB(MCPRD6)
             MONMSG     MSGID(CPF0000)
             CHGCURLIB  CURLIB(MCPRD6)
             MONMSG     MSGID(CPF0000)
/*### END OF LOGIC UNIQUE TO THIS MCXOPNGL* PROGRAM           ###*/
/*###############################################################*/
             CHGJOB     INQMSGRPY(*SYSRPYL)
             MONMSG     MSGID(CPF0000)
             OVRPRTF    FILE(QPPGMDMP) OUTQ(PD01) HOLD(*YES) +
                          USRDTA(MCABEND)

/******************************************************************/
/* CHGKBDMAP FOR USERS USING 3270 HCF EMULATION TO AS/400.        */
/******************************************************************/
             CHGKBDMAP  PF1(*F1) PF2(*F2) PF3(*F3) PF4(*F4) PF5(*F5) +
                          PF6(*F6) PF7(*F7) PF8(*F8) PF9(*F9) +
                          PF10(*F10) PF11(*F11) PF12(*F12) +
                          PF13(*F13) PF14(*F14) PF15(*F15) +
                          PF16(*F16) PF17(*F17) PF18(*F18) +
                          PF19(*F19) PF20(*F20) PF21(*F21) +
                          PF22(*F22) PF23(*F23) PF24(*F24) +
                          PA1PF1(*HELP) PA1PF2(*HLP3270) +
                          PA1PF7(*DOWN) PA1PF8(*UP) PA1PF10(*RESET) +
                          PA1PF11(*CLEAR) PA1PF12(*PRINT)
             MONMSG     MSGID(CPF0000)

/******************************************************************/
/*** FIRST, CHECK IF THE FILE IS THERE THAT SAYS ALL CSIS/MMIS  ***/
/*** OPENS/OVERRIDES HAVE ALREADY BEEN DONE.  IF SO, SKIP ALL   ***/
/*** THE TIME-CONSUMING OPENS.  THIS FEATURE CAN BE USED TO DO  ***/
/*** ALL THE OPENS WHEN YOU FIRST SIGN ON, THUS ELIMINATING THE ***/
/*** INTERMINABLE DELAY EACH TIME CSIS/MMIS IS ENTERED/EXITED   ***/
/******************************************************************/
             CHGVAR     VAR(&FRMMNUFLG)  VALUE('Y')
             CHGVAR     VAR(&FILSOPNFLG) VALUE('Y')
             CHKOBJ     OBJ(QTEMP/MCFPOPNGLB) OBJTYPE(*FILE)
             MONMSG     MSGID(CPF0000) EXEC(DO)
                CHGVAR  VAR(&FILSOPNFLG) VALUE('N')
             ENDDO
             RTVDTAARA DTAARA(*LDA (1 10)) RTNVAR(&SCJOB)
             IF (&SCJOB = '          ') THEN(DO)
                 CHGVAR VAR(&FRMMNUFLG) VALUE('N')
             ENDDO

             /*** IF CALLING FROM INTIAL SIGNON AND FILES ARE     ***/
             /*** ALREADY OPEN, SKIP FILE OPENS                   ***/
             IF (&FILSOPNFLG = 'Y') THEN(DO)
                 GOTO CMDCALL
             ENDDO

/*** CALL CL PROGRAM MCXOPNALL TO PERFORM ALL OF THE OVRDBF ***/
/*** AND OPNDBF COMMANDS ON THE CSIS/MMIS DATABASE FILES    ***/
             CALL       PGM(*LIBL/MCXOPNALL)

/*** CALL CL PROGRAM TO SET ATTENTION PROGRAM TO JUMP BETWEEN   ***/
/*** DATABASES FOR MULTIPLE PLANTS ON ONE AS/400.               ***/
/*** EXISTANCE OF LIB MCPRD2 WILL BE THE KEY FOR MULTI PLANTS   ***/
             CHKOBJ     OBJ(MCPRD2) OBJTYPE(*LIB)
             MONMSG     MSGID(CPF9801) EXEC(GOTO CMDLBL(SKIPMULTI))
             SETATNPGM  PGM(*LIBL/CSWITCHDB)
SKIPMULTI:

/*** CREATE FLAG FILE SAYING THE OPENS HAVE BEEN DONE! ***/
IF (&FRMMNUFLG = 'N') THEN(DO)
   CALL CCRTFILE PARM('QTEMP' 'MCFPOPNGLB' '1' '10' '10' '10' &S)
ENDDO

CMDCALL:
IF (&FRMMNUFLG = 'N') THEN(DO)
   /***CALL UTPRD/UTX9001   REPLACED 27JUL1995***/
   CALL UTX9001
   MONMSG MSGID(CPF0000)
ENDDO
ELSE DO
   /*  SET UP COBOL ERROR HANDLER   */
   CHGVAR     VAR(&SCOPE) VALUE('P')
   CALL       PGM(MCXCBLERR) PARM(&SCOPE)
   MONMSG     MSGID(CPF0000)

   CALL UTC9002
   MONMSG MSGID(CPF0000) EXEC(DO)
      CHGDTAARA  DTAARA(*LDA (108 8)) VALUE('        ')
      GOTO       CMDLBL(CMDCALL)
   ENDDO
ENDDO

ENDOFPGM:
ENDPGM
