             PGM        PARM(&USER &SYSTEM &MSG)
/*********************************************************************/
/*** MCXSNDDST                                                     ***/
/***   THIS PROGRAM WILL SEND A MESSAGE (&MSG) TO THE USER-ID      ***/
/***   &USER AT SYSTEM &SYSTEM.                                    ***/
/*********************************************************************/
             DCL        VAR(&USER) TYPE(*CHAR) LEN(8)
             DCL        VAR(&SYSTEM) TYPE(*CHAR) LEN(8)
             DCL        VAR(&MSG) TYPE(*CHAR) LEN(256)

             SNDDST     TYPE(*MSG) TOUSRID((&USER &SYSTEM)) +
                          DSTD(SNDDST) MSG(&MSG)
             MONMSG     MSGID(CPF0000)
 FINI:
             ENDPGM
