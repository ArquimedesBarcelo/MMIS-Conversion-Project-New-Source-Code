             PGM        PARM(&OBJ &TYP)
             DCL        VAR(&OBJ)  TYPE(*CHAR) LEN(10)
             DCL        VAR(&TYP)  TYPE(*CHAR) LEN(4)
             DCL        VAR(&FILE) TYPE(*CHAR) LEN(10)
             DCL        VAR(&JOB) TYPE(*CHAR) LEN(10)
             DCL        VAR(&USER) TYPE(*CHAR) LEN(10)
             DCL        VAR(&YY) TYPE(*CHAR) LEN(2)
             DCL        VAR(&MM) TYPE(*CHAR) LEN(2)
             DCL        VAR(&DD) TYPE(*CHAR) LEN(2)
             DCL        VAR(&HH) TYPE(*CHAR) LEN(2)
             DCL        VAR(&M) TYPE(*CHAR) LEN(2)
             DCL        VAR(&SS) TYPE(*CHAR) LEN(2)
             DCL        VAR(&LCKMSG) TYPE(*CHAR) LEN(43)
             DCL        VAR(&CRTDATE) TYPE(*CHAR) LEN(13)
             RTVJOBA    JOB(&JOB) USER(&USER)
             RTVSYSVAL  SYSVAL(QYEAR) RTNVAR(&YY)
             RTVSYSVAL  SYSVAL(QMONTH) RTNVAR(&MM)
             RTVSYSVAL  SYSVAL(QDAY) RTNVAR(&DD)
             RTVSYSVAL  SYSVAL(QHOUR) RTNVAR(&HH)
             RTVSYSVAL  SYSVAL(QMINUTE) RTNVAR(&M)
             RTVSYSVAL  SYSVAL(QSECOND) RTNVAR(&SS)

             IF (&TYP *NE '*D') DO
                GOTO GETFILE
                ENDDO
             IF (&TYP *EQ '*D') DO
                CHGVAR     VAR(&TYP) VALUE(%SST(&OBJ 3 1))
                ENDDO
             IF ((&TYP *EQ 'F') *OR +
                 (&TYP *EQ 'X') *OR +
                 (&TYP *EQ 'C')) DO
                GOTO GETFILE
                ENDDO
             GOTO MC00001
 GETFILE:
             IF ((&TYP *EQ 'F   ') *OR (&TYP *EQ 'DDS') +
                                   *OR (&TYP *EQ 'DSPF')) DO
                CHGVAR  VAR(&FILE) VALUE('QDDSSRC')
                ENDDO
             IF ((&TYP *EQ 'C   ') *OR (&TYP *EQ 'CBL') +
                                   *OR (&TYP *EQ 'LBL')) DO
                CHGVAR  VAR(&FILE) VALUE('QLBLSRC')
                ENDDO
             IF ((&TYP *EQ 'X   ') *OR (&TYP *EQ 'CL ') +
                                   *OR (&TYP *EQ 'CLP')) DO
                CHGVAR  VAR(&FILE) VALUE('QCLSRC')
                ENDDO
             IF  (&TYP *EQ 'CMD ') DO
                CHGVAR  VAR(&FILE) VALUE('QCMDSRC')
                ENDDO
             IF  ((&TYP *EQ 'CPYC') *OR (&TYP *EQ 'CPYM') +
                                   *OR (&TYP *EQ 'CPY ')) DO
                CHGVAR  VAR(&FILE) VALUE('COPYLIB')
                ENDDO
 CHECKSRC: /*  DSPPFM     FILE(MCTST/&FILE) MBR(&OBJ) */
             RTVMBRD    FILE(MCTST/&FILE) MBR(&OBJ) CRTDATE(&CRTDATE)
             MONMSG     MSGID(CPF0000) EXEC(GOTO CMDLBL(COPYQA))
             GOTO MC00002
 COPYQA:
             CPYSRCF    FROMFILE(MCQA/&FILE) TOFILE(MCTST/&FILE) +
                          FROMMBR(&OBJ)
             MONMSG     MSGID(CPF0000) EXEC(GOTO CMDLBL(COPYPRD))
             GOTO CRTLOCK
 COPYPRD:
             CPYSRCF    FROMFILE(MCPRD/&FILE) TOFILE(MCTST/&FILE) +
                          FROMMBR(&OBJ)
             MONMSG     MSGID(CPF0000) EXEC(GOTO CMDLBL(COPYBETA))
             GOTO CRTLOCK
 COPYBETA:
             CPYSRCF    FROMFILE(MCBETA/&FILE) TOFILE(MCTST/&FILE) +
                          FROMMBR(&OBJ)
             MONMSG     MSGID(CPF0000) EXEC(GOTO CMDLBL(COPYPRD0))
             GOTO CRTLOCK
 COPYPRD0:
             CPYSRCF    FROMFILE(MCPRD0/&FILE) TOFILE(MCTST/&FILE) +
                          FROMMBR(&OBJ)
             MONMSG     MSGID(CPF0000) EXEC(GOTO CMDLBL(MC00003))
 CRTLOCK:    CHGVAR     VAR(&LCKMSG) VALUE('Locked by ' *CAT +
                          &USER *CAT 'on ' *CAT &MM *CAT '/' +
                          *CAT &DD *CAT '/' *CAT &YY *CAT +
                          ' at ' *CAT &HH *CAT ':' *CAT &M +
                          *CAT ':' *CAT &SS)
             CRTDTAARA  DTAARA(MCTST/&OBJ) TYPE(*CHAR) LEN(43) +
                          VALUE(&LCKMSG) TEXT(&LCKMSG)
             MONMSG     MSGID(CPF0000)
             GOTO EOJ

 MC00001:    SNDPGMMSG  MSGID(MC00001) MSGF(*LIBL/MCFPMSG) +
                          MSGDTA(&OBJ) MSGTYPE(*ESCAPE)
             GOTO EOJ
 MC00002:    RTVDTAARA  DTAARA(&OBJ) RTNVAR(&LCKMSG)
             SNDPGMMSG  MSGID(MC00002) MSGF(*LIBL/MCFPMSG) +
                          MSGDTA(&OBJ || &FILE || &LCKMSG) +
                          MSGTYPE(*ESCAPE)
             GOTO EOJ
 MC00003:    SNDPGMMSG  MSGID(MC00003) MSGF(*LIBL/MCFPMSG) +
                          MSGDTA(&OBJ || &FILE) MSGTYPE(*ESCAPE)
 EOJ:        ENDPGM
