         /*****************************************************/
         /*  PGM NAME: CLCHKDOC                               */
         /*                                                   */
         /*  CL SUBPROGRAM USED TO DETERMINE IF DOCUMENT      */
         /*  SELECTED BY USER EXISTS IN DOCUMENTATION FOLDER. */
         /*                                                   */
         /*  USED IN PROGRAM(S): TDOCDSP, TDOCLNK             */
         /*                                                   */
         /*  VAR(S) PASSED     : DOCMNT, FOUND                */
         /*                                                   */
         /*  10/14/97 JEFF BUNGO                              */
         /*  CHANGED PROGRAM TO RETRIEVE CURRENT FOLDER FROM  */
         /*  DATA AREA MCDADSFLR.                             */
         /*                                                   */
         /*****************************************************/
             PGM PARM(&DOCMNT &FOUND)
             DCL        VAR(&JOB)    TYPE(*CHAR) LEN(10)
             DCL        VAR(&USER)   TYPE(*CHAR) LEN(10)
             DCL        VAR(&NBR)    TYPE(*CHAR) LEN(06)
             DCL        VAR(&DOCMNT) TYPE(*CHAR) LEN(10)
             DCL        VAR(&CHR)    TYPE(*CHAR) LEN(01)
             DCL        VAR(&FOUND)  TYPE(*CHAR) LEN(01)
             DCL        VAR(&FLR)    TYPE(*CHAR) LEN(10)
             RTVJOBA    JOB(&JOB) USER(&USER) NBR(&NBR)
             RTVDTAARA  DTAARA(MCDADSFLR) RTNVAR(&FLR)
             CHKDLO     DLO(&DOCMNT) FLR(&FLR) OBJTYPE(*DOC)
             MONMSG     MSGID(CPF8A82) EXEC(DO)
             CHGVAR VAR(&FOUND) VALUE(N)
             GOTO ENDPGM
             ENDDO
             MONMSG     MSGID(CPF0001) EXEC(DO)
             CHGVAR VAR(&FOUND) VALUE(E)
             GOTO ENDPGM
             ENDDO
 ENDPGM:
             ENDPGM
