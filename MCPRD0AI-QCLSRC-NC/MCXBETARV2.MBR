             PGM
/*****************************************************************/
/***                                                           ***/
/*** PROGRAM: MCXBETARV2                                       ***/
/*** PURPOSE: TO REVIEW THE MCPRD LIBRARY PREVIOUS TO CUTTING  ***/
/***          A RELEASE TO MCBETA.  THIS PROGRAM WILL PRODUCE  ***/
/***          A LISTING OF MCPRD/MCPRDB MEMBERS THAT DO NOT    ***/
/***          DO NOT HAVE AN ASSOCIATED OBJECT AND A LISTING   ***/
/***          OF MCPRD/MCPRDB OBJECTS THAT DO NOT HAVE AN      ***/
/***          ASSOCIATED SOURCE MEMBER.                        ***/
/***                                                           ***/
/***          THIS PROGRAM SHOULD BE RUN MULTIPLE TIMES PRIOR  ***/
/***          TO RUNNING MCXBETA.  THE LISTINGS SHOULD BE      ***/
/***          ROUTED THROUGH THE SECTION AND ALL ITEMS         ***/
/***          RESOLVED BEFORE CONTINUING.                      ***/
/***                                                           ***/
/*****************************************************************/
 SRCLST:     PRTSRCSUM  SRCFILE(QLBLSRC QCLSRC QDDSSRC QDDSSRCDB) +
                          LIB(MCPRD) PRTFILE(QSYSPRT) OUTLIB(QTEMP)
             PRTSRCSUM  SRCFILE(QJOBSRC) LIB(MCPRDB) +
                          PRTFILE(QSYSPRT) OUTLIB(QTEMP) REPLACE(*NO)
 OBJLST:     DSPOBJD    OBJ(MCPRD/*ALL) OBJTYPE(*PGM *FILE) +
                          OUTPUT(*OUTFILE) OUTFILE(QTEMP/MCPRDOBJ)
             DSPOBJD    OBJ(MCPRDB/*ALL) OBJTYPE(*PGM *FILE) +
                          OUTPUT(*OUTFILE) OUTFILE(QTEMP/MCPRDOBJ) +
                          OUTMBR(*FIRST *ADD)
             OVRPRTF    FILE(QSYSPRT) PRTTXT('MCPRD Source without +
                          Objects') OUTQ(PRT03)
 NOOBJ:      RUNSQL     REQUEST('select msfile, msmbr, mstext from +
                          qtemp/srcsump where msmbr not in (select +
                          odobnm from qtemp/mcPRDobj)') OUTPUT(*PRINT)
             OVRPRTF    FILE(QSYSPRT) PRTTXT('MCPRD Objects without +
                          Source') OUTQ(PRT03)
 NOSRC:      RUNSQL     REQUEST('select odobnm, odobtp, odsrcl, +
                          odsrcf, odsrcm, odcrtu, odobtx     from +
                          qtemp/mcPRDobj where odobnm not in      +
                          (select msmbr from qtemp/srcsump)') +
                          OUTPUT(*PRINT)
             DLTOVR     FILE(QSYSPRT)
ENDPGM:
             ENDPGM
