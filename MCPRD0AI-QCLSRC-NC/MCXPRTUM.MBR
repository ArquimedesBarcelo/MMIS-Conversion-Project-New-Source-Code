             PGM        /* Print UM Report in Akron*/

             OVRPRTF    FILE(QSYSPRT) OUTQ(PD01) USRDTA(UMREPORT)
                        MONMSG MSGID(CPF0000)

             CPYF       FROMFILE(*LIBL/UMROUTESLP) TOFILE(QSYSPRT)
                        MONMSG MSGID(CPF0000)

             ADDLIBLE   LIB(TAATOOL)
                        MONMSG MSGID(CPF0000)

             MOVSPLF    FROMOUTQ(PD01) TOOUTQ(QQRX) FILE(QSYSPRT) +
                          USRDTA(UMREPORT)
                        MONMSG MSGID(CPF0000)

             MOVSPLF    FROMOUTQ(PD01) TOOUTQ(QQRX) FILE(QPQUPRFIL) +
                          USER(PRINTIT) USRDTA(UMREPORT) JOB(QPRTJOB)
                        MONMSG MSGID(CPF0000)

             ENDPGM
