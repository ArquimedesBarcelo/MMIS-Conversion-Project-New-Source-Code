             PGM        PARM(&SEQ &DATE &TIME &JNUM &CODE)
             DCL        VAR(&SEQ)  TYPE(*CHAR) LEN(4)
             DCL        VAR(&DATE) TYPE(*CHAR) LEN(9)
             DCL        VAR(&TIME) TYPE(*CHAR) LEN(11)
             DCL        VAR(&JNUM) TYPE(*CHAR) LEN(5)
             DCL        VAR(&CODE) TYPE(*CHAR) LEN(1)
             DCL        VAR(&MBR)  TYPE(*CHAR) LEN(7)
             DCL        VAR(&TEXT) TYPE(*CHAR) LEN(28)

             CHGVAR     VAR(&MBR)  VALUE('FRT' *CAT &SEQ)
             CHGVAR     VAR(&TEXT) VALUE(&DATE *BCAT &TIME *BCAT 'J' +
                                         *CAT &JNUM)

             CHKOBJ     OBJ(FRTDATAFL) OBJTYPE(*FILE) MBR(&MBR)

             MONMSG     MSGID(CPF0000) EXEC(GOTO CMDLBL(ADDMBR))

             CHGVAR     VAR(&CODE) VALUE('1')
             GOTO       CMDLBL(ENDPGM)

 ADDMBR:     ADDPFM     FILE(FRTDATAFL) MBR(&MBR) TEXT(&TEXT)

             MONMSG     MSGID(CPF0000) EXEC(CHGVAR VAR(&CODE) VALUE('9'))

 ENDPGM:     ENDPGM
