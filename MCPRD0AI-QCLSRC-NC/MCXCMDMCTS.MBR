             PGM
             DCL        VAR(&SYSNAME) TYPE(*CHAR) LEN(8)
             ADDLIBLE   LIB(MCTST) POSITION(*AFTER MCPRD1)
             MONMSG     MSGID(CPF0000)
             ADDLIBLE   LIB(TAATOOL) POSITION(*LAST)
             MONMSG     MSGID(CPF0000)
             ADDLIBLE   LIB(USRCMDS) POSITION(*LAST)
             MONMSG     MSGID(CPF0000)
/*           ADDLIBLE   LIB(T881S28) POSITION(*LAST)      */
/*           MONMSG     MSGID(CPF0000)                    */
             RTVNETA    SYSNAME(&SYSNAME)
             IF (&SYSNAME = 'AKRON60') THEN(DO)
                 ENDKBDBUF
             ENDDO
             STRPDM
             ENDPGM
