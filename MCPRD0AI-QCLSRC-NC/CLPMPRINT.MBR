             CHKOBJ     OBJ(QTEMP/OPMPRINT) OBJTYPE(*FILE)
             MONMSG     MSGID(CPF9800) EXEC(DO)
             CRTPF      FILE(QTEMP/OPMPRINT) RCDLEN(200)
             ENDDO
             CLRPFM     FILE(QTEMP/OPMPRINT)
             OVRDBF     FILE(OPMPRINT) TOFILE(QTEMP/OPMPRINT)
             DLTOVR     FILE(OPMPRINT)
             ENDPGM
