/********************************************************************/
/* SEND FILE EDI867 TO SAPCOMM USING PGM CMX0510F.                  */
/* CALLED FROM TFRANSND.                                            */
/********************************************************************/
             PGM PARM(&P1SNDF &MBRIN)
             DCL        VAR(&RTNCODE) TYPE(*CHAR) LEN(2)
             DCL        VAR(&P1KEY) TYPE(*CHAR) LEN(10)
             DCL        VAR(&P1LOCC) TYPE(*CHAR) LEN(4)
             DCL        VAR(&MBRIN) TYPE(*CHAR) LEN(10)
             DCL        VAR(&P1SNDF) TYPE(*CHAR) LEN(10)
             DCL        VAR(&P1SNDL) TYPE(*CHAR) LEN(10)
             DCL        VAR(&S) TYPE(*CHAR) LEN(2)
             ADDLIBLE   LIB(CMPRD)
             MONMSG     MSGID(CPF0000)
             CHGVAR     VAR(&P1KEY) VALUE('PRDTRN     ')
             CHGVAR     VAR(&P1LOCC) VALUE('T1A4')
             CHGVAR     VAR(&P1SNDL) VALUE('MCPRD1    ')
/*           CALL       PGM(CMPRD/CMX0510F) PARM(&RTNCODE &P1KEY +  */
/*                        &P1LOCC &MBRIN &P1SNDF &P1SNDL)           */
/*           IF         COND(&RTNCODE *NE '00') THEN(DO)            */
/*               GOTO       CMDLBL(FINI)                            */
/*           ENDDO                                                  */
FINI:
             CALL       PGM(TGENFILE) PARM(&MBRIN &MBRIN '06' +
                          'MCPRD1' '0088' '05000' '05000' '20' &S)

             ENDPGM
