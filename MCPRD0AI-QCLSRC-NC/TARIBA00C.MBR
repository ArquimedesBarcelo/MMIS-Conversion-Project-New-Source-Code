/*********************************************************************/
/** PROGRAM: TARIBA00C                                             ***/
/**                                                                ***/
/** PURPOSE: CHECK JOB TARIBAMON - IF NOT ACTIVE AND NOT ON JOBQ   ***/
/**          THEN SBMJOB TO JOBQ/SBS CSISMMIS -- THIS JOB IS       ***/
/**          TARIBA00J IS SUBMITTED BY "SLEEPER" TO RUN IN QBATCH  ***/
/**          ON A TIMELY BASIS (IE: HOURLY)                        ***/
/**                                                                ***/
/** CREATED: 11/26/02                                              ***/
/** AUTHOR : DAN RAUCH - EXLTECH,INC                               ***/
/**                                                                ***/
/*********************************************************************/
/** SPECIAL NOTES:                                                 ***/
/*********************************************************************/
             PGM

             DCL        VAR(&JOBD) TYPE(*CHAR) LEN(10)
             DCL        VAR(&TYPE) TYPE(*CHAR) LEN(1)
             DCL        VAR(&STATUS) TYPE(*CHAR) LEN(10)
             DCL        VAR(&PRGNAME) TYPE(*CHAR) LEN(10) +
                          VALUE('TARIBAJOB')
             DCL        VAR(&JOBNAME) TYPE(*CHAR) LEN(10) +
                          VALUE('TARIBAMON')
             DCL        VAR(&MONSBS) TYPE(*CHAR) LEN(10) +
                          VALUE(CSISMMIS)

             DCLF       FILE(MCFPMMJOBD)

/*-- MONMSG FOR RTVJOBSTS CMD                                     --**/
             MONMSG     MSGID(CPF9898)

/*------------------------------------------------------------------**/
/*-- START THE MONITOR SUBSYSTEM - CPF1010 = ALREADY ACTIVE       --**/
/*---@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@---------**/
/*-- COMMENTED OUT - BATCH USER ID NOT AUTHORIZED TO STRSBS CMD   --**/
/*------------------------------------------------------------------**/
/***         STRSBS     SBSD(&MONSBS)                               **/
/***         MONMSG     MSGID(CPF1010)                              **/
/*------------------------------------------------------------------**/


/*------------------------------------------------------------------**/
/*-- IF ALREADY ACTIVE OR ON JOBQ DONT SBMJOB & DONT GENERATE A   --**/
/*-- JOBLOG - SO GO TO LABEL CHGJ1                              --**/
/*------------------------------------------------------------------**/
             RTVJOBSTS  JOB(&JOBNAME) STATUS(*ACTIVE) +
                          RTNSTATUS(&STATUS)
             IF         COND(&STATUS *EQ '*ACTIVE   ') THEN(DO)
             GOTO       CMDLBL(CHGJ1)
             ENDDO

             RTVJOBSTS  JOB(&JOBNAME) STATUS(*JOBQ) RTNSTATUS(&STATUS)
             IF         COND(&STATUS *EQ '*JOBQ     ') THEN(DO)
             GOTO       CMDLBL(CHGJ1)
             ENDDO

READ:
             RCVF       RCDFMT(*FILE)
             MONMSG     MSGID(CPF0864) EXEC(GOTO CMDLBL(ENDIT))

             CHGVAR     VAR(&JOBD) VALUE(&MCFPMMJOBD)

             SBMJOB     CMD(CALL PGM(&PRGNAME)) JOB(&JOBNAME) +
                          JOBD(&JOBD) JOBQ(CSISMMIS) USER(*JOBD) +
                          CURLIB(*CRTDFT) INLLIBL(*JOBD)

/**== INITIAL JOB SUBMISSION WILL GENERATE A JOBLOG                ==*/
             GOTO       CMDLBL(ENDIT)
CHGJ1:
/**==================================================================*/
/**== IF THIS JOB WAS SUBMITTED AS BATCH, DONT GENERATE JOBLOG     ==*/
/**==================================================================*/
             RTVJOBA    TYPE(&TYPE)
             IF         COND(&TYPE *EQ '0') THEN(DO)
             CHGJOB     LOG(0 00 *NOLIST)
             ENDDO

ENDIT:  ENDPGM
