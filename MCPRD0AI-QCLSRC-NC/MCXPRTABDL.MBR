             PGM
             DCL        VAR(&S) TYPE(*CHAR) LEN(2)
             WRKSPLF    SELECT(*ALL *ALL *ALL MCABEND) OUTPUT(*PRINT)
             CALL       PGM(CCRTFILE) PARM('QTEMP' 'MCFWRKSPLF' '144' +
                          '1000' '1000' '99' &S)
             CALL       PGM(CCRTFILE) PARM('QTEMP' 'MCFPJOBLOG' '133' +
                          '10000' '1000' '99' &S)
             CPYSPLF    FILE(QPRTSPLF) TOFILE(QTEMP/MCFWRKSPLF) +
                          SPLNBR(*LAST)
             DLTSPLF    FILE(QPRTSPLF) SPLNBR(*LAST)
             CALL       PGM(MCCPRTABND) PARM('Y')
             /*************************************************/
             /*** COPY THE PRINT FILE CREATED BY MCCPRTABND ***/
             /*** FOR ANALYZATION OF TERM ERRORS, AND ALSO  ***/
             /*** CREATE A NEW REPORT WITHOUT TERM ERRS     ***/
             /*** NOTE: MCCTERMERR ALSO CALLS 'TBLPRTB' TO  ***/
             /*** GIVE A BLOWUP REPORT STARTING FROM THE    ***/
             /*** EARLIEST DATE OF THE MCABENDS FOUND       ***/
             /*************************************************/
             CPYSPLF    FILE(MCPRT) TOFILE(QTEMP/MCFWRKSPLF) +
                          SPLNBR(*LAST)
             CALL       PGM(MCCTERMERR)
             SNDNETSPLF FILE(MCPRT) TOUSRID((PRINTIT AKRON60)) +
                          SPLNBR(*LAST)
             ENDPGM
