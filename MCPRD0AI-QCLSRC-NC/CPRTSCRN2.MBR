             PGM
             DCL        VAR(&MOD)      TYPE(*CHAR) LEN(4)
             DCL        VAR(&CAP)      TYPE(*CHAR) LEN(4)
             DCL        VAR(&LATTR)    TYPE(*CHAR) LEN(4)
             DCL        VAR(&USERNAME) TYPE(*CHAR) LEN(8)
             DCL        VAR(&GRPNAME)  TYPE(*CHAR) LEN(8)
             DCL        VAR(&ACCTNAME) TYPE(*CHAR) LEN(8)
             DCL        VAR(&HOMEGRP)  TYPE(*CHAR) LEN(8)
             DCL        VAR(&ACCTNAME) TYPE(*CHAR) LEN(8)
             DCL        VAR(&TNUM)     TYPE(*CHAR) LEN(4)
       01  MOD                     PIC S9(4) COMP-4.
       01  CAP                     PIC S9(4) COMP-4.
       01  LATTR                   PIC S9(4) COMP-4.
       01  TNUM                    PIC S9(4) COMP-4.
             CALL       CWHO
             STRCPYSCN  SRCDEV(*REQUESTER) OUTDEV(*NONE)  +
                          OUTFILE(*LIBL/PRTSCRN)
             RMVMSG     PGMQ(*SAME CPRTSCRN2) CLEAR(*ALL)
             MONMSG     MSGID(CPF0000)
             ENDCPYSCN
             CPYF       FROMFILE(*LIBL/PRTSCRN) TOFILE(*PRINT)
             DLTF       FILE(*LIBL/PRTSCRN)
 EOJ:        ENDPGM
