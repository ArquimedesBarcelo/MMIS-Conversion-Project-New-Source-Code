/*********************************************************************/
/** PROGRAM: ABCATEXCPY                                            ***/
/**                                                                ***/
/** PURPOSE: COPY ALL ABCATEXP3 PLANT MEMBERS TO *FIRST MBR        ***/
/**                                                                ***/
/** CREATED: 05/14/2004                                            ***/
/** AUTHOR : BILL FONAGY                                           ***/
/** COPIED FROM: TARBCPYEXC                                        ***/
/**                                                                ***/
/** CHANGES:                                                       ***/
/**     11/02/2004  B FONAGY  ADDED: SPARTANBURG AND VALLEYFIELD   ***/
/**                         REMOVED: GADSDEN - NOW ON SAP          ***/
/**                                                                ***/
/*********************************************************************/
PGM

             DCL        VAR(&RECORDS) TYPE(*DEC)  LEN(10 0)
             DCL        VAR(&FLENAME) TYPE(*CHAR) LEN(13)
             DCL        VAR(&DIRNAME) TYPE(*CHAR) LEN(31)
             DCL        VAR(&LNKNAME) TYPE(*CHAR) LEN(46)
             DCL        VAR(&MSGLINE) TYPE(*CHAR) LEN(48)
             DCL        VAR(&WKEND)   TYPE(*CHAR) LEN(6)
             DCL        VAR(&MONTH)   TYPE(*CHAR) LEN(2)
             DCL        VAR(&DAY)     TYPE(*CHAR) LEN(2)
             DCL        VAR(&YEAR)    TYPE(*CHAR) LEN(2)
             DCL        VAR(&SEPRTOR) TYPE(*CHAR) LEN(1)

             CLRPFM     FILE(ABCATEXP3) MBR(ALLPLANTS)

             RTVSYSVAL  SYSVAL(QDATE) RTNVAR(&WKEND)
             CHGVAR     VAR(&SEPRTOR) VALUE('/')
             CHGVAR     VAR(&MSGLINE) VALUE('Just click on the link ' +
                             *CAT 'below and save to your PC')
             CHGVAR     VAR(&MONTH)   VALUE(%SST(&WKEND 1 2))
             CHGVAR     VAR(&DAY)     VALUE(%SST(&WKEND 3 2))
             CHGVAR     VAR(&YEAR)    VALUE(%SST(&WKEND 5 2))
             CHGVAR     VAR(&FLENAME) VALUE('abcatexp3.csv')
             CHGVAR     VAR(&DIRNAME) VALUE('/csismmis/reports/' +
                          *CAT &FLENAME)
             CHGVAR     VAR(&LNKNAME) VALUE('HTTP://akron60/' +
                          *CAT &DIRNAME)

/** -------------------------------------------------------------- ***/
/** COPY SPARTANBURG DATA    PLANT 120  11/02/2004                 ***/
/** -------------------------------------------------------------- ***/
             RTVMBRD    FILE(ABCATEXP3) MBR(Z120) NBRCURRCD(&RECORDS)
             IF         COND(&RECORDS *GT 0) THEN(DO)
             CPYF       FROMFILE(ABCATEXP3) TOFILE(ABCATEXP3) +
                          FROMMBR(Z120) TOMBR(ALLPLANTS) +
                          MBROPT(*REPLACE)
             MONMSG     MSGID(CPF0000)
             ENDDO

/** -------------------------------------------------------------- ***/
/** COPY DANVILLE DATA       PLANT 126                             ***/
/** -------------------------------------------------------------- ***/
             RTVMBRD    FILE(ABCATEXP3) MBR(Z126) NBRCURRCD(&RECORDS)
             IF         COND(&RECORDS *GT 0) THEN(DO)
             CPYF       FROMFILE(ABCATEXP3) TOFILE(ABCATEXP3) +
                          FROMMBR(Z126) TOMBR(ALLPLANTS) MBROPT(*ADD)
             MONMSG     MSGID(CPF0000)
             ENDDO

/** -------------------------------------------------------------- ***/
/** COPY UNION CITY DATA     PLANT 129                             ***/
/** -------------------------------------------------------------- ***/
             RTVMBRD    FILE(ABCATEXP3) MBR(Z129) NBRCURRCD(&RECORDS)
             IF         COND(&RECORDS *GT 0) THEN(DO)
             CPYF       FROMFILE(ABCATEXP3) TOFILE(ABCATEXP3) +
                          FROMMBR(Z129) TOMBR(ALLPLANTS) MBROPT(*ADD)
             MONMSG     MSGID(CPF0000)
             ENDDO

/*********************************************************************/
/** REMOVE GADSDEN FROM PROGRAM - NOW ON SAP  11/02/2004           ***/
/** -------------------------------------------------------------- ***/
/** COPY GADSDEN DATA        PLANT 131                             ***/
/** -------------------------------------------------------------- ***/
/*           RTVMBRD    FILE(ABCATEXP3) MBR(Z131) NBRCURRCD(&RECORDS)*/
/*           IF         COND(&RECORDS *GT 0) THEN(DO)                */
/*           CPYF       FROMFILE(ABCATEXP3) TOFILE(ABCATEXP3) +      */
/*                       FROMMBR(Z131) TOMBR(ALLPLANTS) MBROPT(*ADD) */
/*           MONMSG     MSGID(CPF0000)                               */
/*           ENDDO                                                   */

/** -------------------------------------------------------------- ***/
/** COPY TOPEKA DATA         PLANT 133                             ***/
/** -------------------------------------------------------------- ***/
             RTVMBRD    FILE(ABCATEXP3) MBR(Z133) NBRCURRCD(&RECORDS)
             IF         COND(&RECORDS *GT 0) THEN(DO)
             CPYF       FROMFILE(ABCATEXP3) TOFILE(ABCATEXP3) +
                          FROMMBR(Z133) TOMBR(ALLPLANTS) MBROPT(*ADD)
             MONMSG     MSGID(CPF0000)
             ENDDO

/** -------------------------------------------------------------- ***/
/** COPY LAWTON DATA         PLANT 153                             ***/
/** -------------------------------------------------------------- ***/
             RTVMBRD    FILE(ABCATEXP3) MBR(Z153) NBRCURRCD(&RECORDS)
             IF         COND(&RECORDS *GT 0) THEN(DO)
             CPYF       FROMFILE(ABCATEXP3) TOFILE(ABCATEXP3) +
                          FROMMBR(Z153) TOMBR(ALLPLANTS) MBROPT(*ADD)
             MONMSG     MSGID(CPF0000)
             ENDDO

/** -------------------------------------------------------------- ***/
/** COPY ASHEBORO DATA       PLANT 155                             ***/
/** -------------------------------------------------------------- ***/
             RTVMBRD    FILE(ABCATEXP3) MBR(Z155) NBRCURRCD(&RECORDS)
             IF         COND(&RECORDS *GT 0) THEN(DO)
             CPYF       FROMFILE(ABCATEXP3) TOFILE(ABCATEXP3) +
                          FROMMBR(Z155) TOMBR(ALLPLANTS) MBROPT(*ADD)
             MONMSG     MSGID(CPF0000)
             ENDDO

/** -------------------------------------------------------------- ***/
/** COPY DECATUR DATA        PLANT 174                             ***/
/** -------------------------------------------------------------- ***/
             RTVMBRD    FILE(ABCATEXP3) MBR(Z174) NBRCURRCD(&RECORDS)
             IF         COND(&RECORDS *GT 0) THEN(DO)
             CPYF       FROMFILE(ABCATEXP3) TOFILE(ABCATEXP3) +
                          FROMMBR(Z174) TOMBR(ALLPLANTS) MBROPT(*ADD)
             MONMSG     MSGID(CPF0000)
             ENDDO

 /** ------------------------------------------------------------- ***/
 /** COPY VALLEYFIELD        PLANT 629  11/02/2004                 ***/
 /** ------------------------------------------------------------- ***/
             RTVMBRD    FILE(ABCATEXP3) MBR(Z629) NBRCURRCD(&RECORDS)
             IF         COND(&RECORDS *GT 0) THEN(DO)
             CPYF       FROMFILE(ABCATEXP3) TOFILE(ABCATEXP3) +
                          FROMMBR(Z631) TOMBR(ALLPLANTS) MBROPT(*ADD)
             MONMSG     MSGID(CPF0000)
             ENDDO

 /** ------------------------------------------------------------- ***/
 /** COPY NAPANEE DATA        PLANT 631                            ***/
 /**-------------------------------------------------------------- ***/
             RTVMBRD    FILE(ABCATEXP3) MBR(Z631) NBRCURRCD(&RECORDS)
             IF         COND(&RECORDS *GT 0) THEN(DO)
             CPYF       FROMFILE(ABCATEXP3) TOFILE(ABCATEXP3) +
                          FROMMBR(Z631) TOMBR(ALLPLANTS) MBROPT(*ADD)
             MONMSG     MSGID(CPF0000)
             ENDDO

             SNDMSG     MSG('EXCEPTION FILE ABCATEXP3 ALL MEMBERS +
                             COPIED') TOMSGQ(ARIBA)

/** -------------------------------------------------------------- ***/
/** CONVERT DATABASE FILE INTO .CSV FILE                           ***/
/** -------------------------------------------------------------- ***/
             CPYTOIMPF FROMFILE(MCPRD1/ABCATEXP3) +
                        TOSTMF(&DIRNAME) +
                        MBROPT(*REPLACE) RCDDLM(*CRLF)

             CHGAUT    OBJ(&DIRNAME) USER(QTMHHTTP PD01) DTAAUT(*RX)
/*                      USER(QTMHHTTP) DTAAUT(*RX)                   */

/** -------------------------------------------------------------- ***/
/** SEND E-MAIL WITH LINK TO NEW CATALOG EXCEPTION DATA FILE .CSV  ***/
/** -------------------------------------------------------------- ***/
             SNDDST    TYPE(*LMSG) TOUSRID((A352022 GTRLAN) +
                                          (A343045 GTRLAN)) +
                       DSTD('Catalog Data') +
                       LONGMSG(&MSGLINE +
                               *CAT ':/P' *CAT &LNKNAME) +
                       SUBJECT('Catalog data for Period ending ' +
                                *CAT &MONTH *CAT &SEPRTOR +
                                *CAT &DAY *CAT &SEPRTOR +
                                *CAT &YEAR)

ENDPGM
