PGM PARM(&FILENAME)
             DCL        VAR(&FILENAME) TYPE(*CHAR) LEN(10)
             RMVM       FILE(MCFPEDTPFM) MBR(PURGEME)
             MONMSG     MSGID(CPF0000)
             CPYF       FROMFILE(&FILENAME) TOFILE(MCFPEDTPFM) +
                          TOMBR(PURGEME) MBROPT(*ADD) FMTOPT(*CVTSRC)
             STRSEU SRCFILE(*LIBL/MCFPEDTPFM) SRCMBR(PURGEME)
             CPYF       FROMFILE(MCFPEDTPFM) TOFILE(&FILENAME) +
                          FROMMBR(PURGEME) MBROPT(*REPLACE) +
                          FMTOPT(*CVTSRC)
             RMVM       FILE(MCFPEDTPFM) MBR(PURGEME)
             ENDPGM
