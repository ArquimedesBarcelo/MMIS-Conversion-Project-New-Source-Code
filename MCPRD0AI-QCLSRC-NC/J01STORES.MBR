                          updated  CSIS/MMIS data library - ' *CAT +
                          &CURLIB) TOUSR(*SYSOPR)

END:
/*** CALL CL PROGRAM TO START BXGETFOB TO LOAD FOB CODES             ***/
             SBMJOB     CMD(CALL PGM(MCPRD/CLGETFOB)) JOB(CLGETFOB) +
                          JOBD(PD01) USER(PD01)

/*** INCREMENT THE LIBRARY NAME BY 1, AND GO BACK TO THE BEGINNING   ***/
/*** OF THE PROGRAM.                                                 ***/
             CHGVAR     VAR(&LIBN) VALUE(&LIBN + 1)
             GOTO       CMDLBL(LOOP)

ENDLOOP:
             SNDMSG     MSG('J01STORES has ENDED') +
                          TOUSR(*SYSOPR)
/*****************************************************************/
ENDPGM:
             ENDPGM
