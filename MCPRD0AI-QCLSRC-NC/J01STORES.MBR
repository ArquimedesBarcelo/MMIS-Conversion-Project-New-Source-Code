                             WHERE WLKEY = ''IV0000''')
             RUNSQL     REQUEST('UPDATE MCFPCS0300 +
                             SET WLDTE = ''  ''||SUBSTR(WLDTE,3,6) +
                             WHERE WLKEY = ''ST0000''')
             RUNSQL     REQUEST('UPDATE MCFPCS0300 +
