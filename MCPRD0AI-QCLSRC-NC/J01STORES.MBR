                          TOFILE(*CURLIB/MCFPCS5400) MBROPT(*REPLACE) +
                          FMTOPT(*NOCHK)
             MONMSG     MSGID(CPF0000) EXEC(DO)
             SNDMSG     MSG('CSIS/MMIS J01STORES ERROR.  Error +
                          copying intermediate file to MCFPCS5400 +
                          file.  Check joblog, resolve error and +
                          attempt to run J01STORES again.') +
                          TOUSR(QSYSOPR)
                 GOTO   CMDLBL(ENDPGM)
             ENDDO
             ENDDO
             CRTLF      FILE(*CURLIB/MCFLCS5401) +
                          SRCFILE(*LIBL/QDDSSRCDB) +
                          SRCMBR(MCFLCS5401) TEXT(*SRCMBRTXT)
             CRTLF      FILE(*CURLIB/MCFLCS5402) +
                          SRCFILE(*LIBL/QDDSSRCDB) +
                          SRCMBR(MCFLCS5402) TEXT(*SRCMBRTXT)
             DLTF       FILE(*CURLIB/ICFPCS5400)
