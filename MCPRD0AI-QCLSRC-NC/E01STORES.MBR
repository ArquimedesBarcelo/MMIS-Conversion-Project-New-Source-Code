             PGM
/*****************************************************************/
/*** PROGRAM: E01STORES                                        ***/
/*** PURPOSE: TO ADD AND CHANGE DATABASE FILES (PHYSICAL AND   ***/
/***          LOGICAL) FOR THE E01 DATABASE RELEASE.           ***/
/*****************************************************************/
/*                                                               */
/*****************************************************************/
/**********                 STEP 1                ****************/
/**********          STORES REFERENCE FILE        ****************/
/**********     DELETE PHYSICAL STORES REF FILE   ****************/
/**********     CREATE PHYSICAL STORES REF FILE   ****************/
/*****************************************************************/
             DLTF       FILE(MCPRD1/STORES)
             MONMSG     MSGID(CPF2105)
             CRTPF      FILE(MCPRD1/STORES) SRCFILE(*LIBL/QDDSSRCDB) +
                          SRCMBR(STORES) TEXT('STORES    Reference +
                          File') SIZE(*NOMAX)
             SNDMSG     MSG('Step 1 of 9 has COMPLETED NORMALLY in +
                          E01STORES') TOUSR(*SYSOPR)
/*****************************************************************/
/**********                 STEP 2                ****************/
/**********       MCFPCS4800  DEDILOG             ****************/
/**********   CREATE PHYSICAL AND LOGICAL FILES   ****************/
/*****************************************************************/
             CRTPF      FILE(MCPRD1/MCFPCS4800) +
                          SRCFILE(*LIBL/QDDSSRCDB) +
                          SRCMBR(MCFPCS4800) TEXT('DEDILOG          +
                          Physical File') SIZE(*NOMAX)
             CRTLF      FILE(MCPRD1/MCFLCS4801) +
                          SRCFILE(*LIBL/QDDSSRCDB) +
                          SRCMBR(MCFLCS4801) TEXT('DEDILOG          +
                          Logical File (EDILOGTYPE)')
             CRTLF      FILE(MCPRD1/MCFLCS4802) +
                          SRCFILE(*LIBL/QDDSSRCDB) +
                          SRCMBR(MCFLCS4802) TEXT('DEDILOG          +
                          Logical File (EDILOGKEY)')
             SNDMSG     MSG('Step 2 of 9 has COMPLETED NORMALLY in +
                          E01STORES') TOUSR(*SYSOPR)
/*****************************************************************/
/************               STEP 3                ****************/
/************        MCFPCS4900  MCLASS           ****************/
/************  CREATE PHYSICAL FILE               ****************/
/************  COPY PHYSICAL FILE FROM MCFPCA0200 ****************/
/************  CREATE LOGICAL FILE                ****************/
/************  DELETE LOGICAL FILES FOR MCFPCA0200****************/
/************  DELETE PHYSICAL FILE MCFPCA0200    ****************/
/*****************************************************************/
             CRTPF      FILE(MCPRD1/MCFPCS4900) +
                          SRCFILE(*LIBL/QDDSSRCDB) +
                          SRCMBR(MCFPCS4900) TEXT('MCLASS           +
                          Physical File') SIZE(*NOMAX)
             CPYF       FROMFILE(MCPRD1/MCFPCA0200) +
                          TOFILE(MCPRD1/MCFPCS4900) MBROPT(*ADD) +
                          FMTOPT(*NOCHK)
             CRTLF      FILE(MCPRD1/MCFLCS4901) +
                          SRCFILE(*LIBL/QDDSSRCDB) +
                          SRCMBR(MCFLCS4901) TEXT('MCLASS           +
                          Logical File (ACTGCLASS)')
             DLTF       FILE(MCPRD1/MCFLCA0201)
             MONMSG     MSGID(CPF2105)
             DLTF       FILE(MCPRD1/MCFPCA0200)
             MONMSG     MSGID(CPF2105)
             SNDMSG     MSG('Step 3 of 9 has COMPLETED NORMALLY in +
                          E01STORES') TOUSR(*SYSOPR)
/*****************************************************************/
/************                 STEP 4              ****************/
/************       MCFPCS5000  DRESTRICT         ****************/
/************  CREATE PHYSICAL AND LOGICAL FILES  ****************/
/*****************************************************************/
             CRTPF      FILE(MCPRD1/MCFPCS5000) +
                          SRCFILE(*LIBL/QDDSSRCDB) +
                          SRCMBR(MCFPCS5000) TEXT('DRESTRICT        +
                          Physical File') SIZE(*NOMAX)
             CRTLF      FILE(MCPRD1/MCFLCS5001) +
                          SRCFILE(*LIBL/QDDSSRCDB) +
                          SRCMBR(MCFLCS5001) TEXT('DRESTRICT        +
                          Logical File (CORPCDE)')
             SNDMSG     MSG('Step 4 of 9 has COMPLETED NORMALLY in +
                          E01STORES') TOUSR(*SYSOPR)
/*****************************************************************/
/************               STEP 5                ****************/
/************        MCFPCS0400  MVALIDUM         ****************/
/************  A) DELETE LOGICAL FILES            ****************/
/************  B) CREATE DUP OBJ OF PHYSICAL      ****************/
/************  C) DELETE PHYSICAL FILE            ****************/
/************  D) CREATE PHYSICAL FILE            ****************/
/************  E) COPY DUP OBJ INTO NEW PHYSICAL  ****************/
/************  F) CREATE LOGICAL FILES            ****************/
/************  G) DELETE DUP OBJ OF PHYSICAL      ****************/
/*****************************************************************/
/* STEP 5A */
             DLTF       FILE(MCPRD1/MCFLCS0401)
             MONMSG     MSGID(CPF2105)
/* STEP 5B */
             CRTDUPOBJ  OBJ(MCFPCS0400) FROMLIB(MCPRD1) +
                          OBJTYPE(*FILE) TOLIB(MCPRD1) +
                          NEWOBJ(MCFPCS040T) DATA(*YES)
/* STEP 5C */
             DLTF       FILE(MCPRD1/MCFPCS0400)
             MONMSG     MSGID(CPF2105)
/* STEP 5D */
             CRTPF      FILE(MCPRD1/MCFPCS0400) +
                          SRCFILE(*LIBL/QDDSSRCDB) +
                          SRCMBR(MCFPCS0400) TEXT('MVALIDUM         +
                          Physical File') SIZE(*NOMAX)
/* STEP 5E */
             CPYF       FROMFILE(MCPRD1/MCFPCS040T) +
                          TOFILE(MCPRD1/MCFPCS0400) MBROPT(*ADD) +
                          FMTOPT(*NOCHK)
/* STEP 5F */
             CRTLF      FILE(MCPRD1/MCFLCS0401) +
                          SRCFILE(*LIBL/QDDSSRCDB) +
                          SRCMBR(MCFLCS0401) TEXT('MVALIDUM         +
                          Logical File (VALIDUM)')
/* STEP 5G */
             DLTF       FILE(MCPRD1/MCFPCS040T)
             MONMSG     MSGID(CPF2105)
             SNDMSG     MSG('Step 5 of 9 has COMPLETED NORMALLY in +
                          E01STORES') TOUSR(*SYSOPR)
/*****************************************************************/
/************               STEP 6                ****************/
/************        MCFPCS0600  MBUYER           ****************/
/************  A) DELETE LOGICAL FILES            ****************/
/************  B) CREATE DUP OBJ OF PHYSICAL      ****************/
/************  C) DELETE PHYSICAL FILE            ****************/
/************  D) CREATE PHYSICAL FILE            ****************/
/************  E) COPY DUP OBJ INTO NEW PHYSICAL  ****************/
/************  F) CREATE LOGICAL FILES            ****************/
/************  G) DELETE DUP OBJ OF PHYSICAL      ****************/
/*****************************************************************/
/* STEP 6A */
             DLTF       FILE(MCPRD1/MCFLCS0601)
             MONMSG     MSGID(CPF2105)
/* STEP 6B */
             CRTDUPOBJ  OBJ(MCFPCS0600) FROMLIB(MCPRD1) +
                          OBJTYPE(*FILE) TOLIB(MCPRD1) +
                          NEWOBJ(MCFPCS060T) DATA(*YES)
/* STEP 6C */
             DLTF       FILE(MCPRD1/MCFPCS0600)
             MONMSG     MSGID(CPF2105)
/* STEP 6D */
             CRTPF      FILE(MCPRD1/MCFPCS0600) +
                          SRCFILE(*LIBL/QDDSSRCDB) +
                          SRCMBR(MCFPCS0600) TEXT('MBUYER           +
                          Physical File') SIZE(*NOMAX)
/* STEP 6E */
             CPYF       FROMFILE(MCPRD1/MCFPCS060T) +
                          TOFILE(MCPRD1/MCFPCS0600) MBROPT(*ADD) +
                          FMTOPT(*NOCHK)
/* STEP 6F */
             CRTLF      FILE(MCPRD1/MCFLCS0601) +
                          SRCFILE(*LIBL/QDDSSRCDB) +
                          SRCMBR(MCFLCS0601) TEXT('MBUYER           +
                          Logical File (BUYERCDE)')
/* STEP 6G */
             DLTF       FILE(MCPRD1/MCFPCS060T)
             MONMSG     MSGID(CPF2105)
             SNDMSG     MSG('Step 6 of 9 has COMPLETED NORMALLY in +
                          E01STORES') TOUSR(*SYSOPR)
/*****************************************************************/
/************               STEP 7                ****************/
/************        MCFPCS0900  DPORECD          ****************/
/************  A) DELETE LOGICAL FILES            ****************/
/************  B) CREATE DUP OBJ OF PHYSICAL      ****************/
/************  C) DELETE PHYSICAL FILE            ****************/
/************  D) CREATE PHYSICAL FILE            ****************/
/************  E) COPY DUP OBJ INTO NEW PHYSICAL  ****************/
/************  F) CREATE LOGICAL FILES            ****************/
/************  G) DELETE DUP OBJ OF PHYSICAL      ****************/
/*****************************************************************/
/* STEP 7A */
             DLTF       FILE(MCPRD1/MCFLCS0901)
             MONMSG     MSGID(CPF2105)
             DLTF       FILE(MCPRD1/MCFLCS0902)
             MONMSG     MSGID(CPF2105)
/* STEP 7B */
             CRTDUPOBJ  OBJ(MCFPCS0900) FROMLIB(MCPRD1) +
                          OBJTYPE(*FILE) TOLIB(MCPRD1) +
                          NEWOBJ(MCFPCS090T) DATA(*YES)
/* STEP 7C */
             DLTF       FILE(MCPRD1/MCFPCS0900)
             MONMSG     MSGID(CPF2105)
/* STEP 7D */
             CRTPF      FILE(MCPRD1/MCFPCS0900) +
                          SRCFILE(*LIBL/QDDSSRCDB) +
                          SRCMBR(MCFPCS0900) TEXT('DPORECD          +
                          Physical File') SIZE(*NOMAX)
/* STEP 7E */
             CPYF       FROMFILE(MCPRD1/MCFPCS090T) +
                          TOFILE(MCPRD1/MCFPCS0900) MBROPT(*ADD) +
                          FMTOPT(*NOCHK)
/* STEP 7F */
             CRTLF      FILE(MCPRD1/MCFLCS0901) +
                          SRCFILE(*LIBL/QDDSSRCDB) +
                          SRCMBR(MCFLCS0901) TEXT('DPORECD          +
                          Logical File (PORCVNO)')
             CRTLF      FILE(MCPRD1/MCFLCS0902) +
                          SRCFILE(*LIBL/QDDSSRCDB) +
                          SRCMBR(MCFLCS0902) TEXT('DPORECD          +
                          Logical File (VENCDE)')
/* STEP 7G */
             DLTF       FILE(MCPRD1/MCFPCS090T)
             MONMSG     MSGID(CPF2105)
             SNDMSG     MSG('Step 7 of 9 has COMPLETED NORMALLY in +
                          E01STORES') TOUSR(*SYSOPR)
/*****************************************************************/
/************               STEP 8                ****************/
/************        MCFPCS1700  MVALIDPLTDATA    ****************/
/************  A) DELETE LOGICAL FILES            ****************/
/************  B) CREATE DUP OBJ OF PHYSICAL      ****************/
/************  C) DELETE PHYSICAL FILE            ****************/
/************  D) CREATE PHYSICAL FILE            ****************/
/************  E) COPY DUP OBJ INTO NEW PHYSICAL  ****************/
/************  F) CREATE LOGICAL FILES            ****************/
/************  G) DELETE DUP OBJ OF PHYSICAL      ****************/
/*****************************************************************/
/* STEP 8A */
             DLTF       FILE(MCPRD1/MCFLCS1701)
             MONMSG     MSGID(CPF2105)
/* STEP 8B */
             CRTDUPOBJ  OBJ(MCFPCS1700) FROMLIB(MCPRD1) +
                          OBJTYPE(*FILE) TOLIB(MCPRD1) +
                          NEWOBJ(MCFPCS170T) DATA(*YES)
/* STEP 8C */
             DLTF       FILE(MCPRD1/MCFPCS1700)
             MONMSG     MSGID(CPF2105)
/* STEP 8D */
             CRTPF      FILE(MCPRD1/MCFPCS1700) +
                          SRCFILE(*LIBL/QDDSSRCDB) +
                          SRCMBR(MCFPCS1700) TEXT('MVALIDPLTDATA    +
                          Physical File') SIZE(*NOMAX)
/* STEP 8E */
             CPYF       FROMFILE(MCPRD1/MCFPCS170T) +
                          TOFILE(MCPRD1/MCFPCS1700) MBROPT(*ADD) +
                          FMTOPT(*NOCHK)
/* STEP 8F */
             CRTLF      FILE(MCPRD1/MCFLCS1701) +
                          SRCFILE(*LIBL/QDDSSRCDB) +
                          SRCMBR(MCFLCS1701) TEXT('MVALIDPLTDATA    +
                          Logical File (VALDTAKEY)')
/* STEP 8G */
             DLTF       FILE(MCPRD1/MCFPCS170T)
             MONMSG     MSGID(CPF2105)
             SNDMSG     MSG('Step 8 of 9 has COMPLETED NORMALLY in +
                          E01STORES') TOUSR(*SYSOPR)
/*****************************************************************/
/************               STEP 9                ****************/
/************        MCFPCS1800  MCOMMENT         ****************/
/************  A) DELETE LOGICAL FILES            ****************/
/************  B) CREATE DUP OBJ OF PHYSICAL      ****************/
/************  C) DELETE PHYSICAL FILE            ****************/
/************  D) CREATE PHYSICAL FILE            ****************/
/************  E) COPY DUP OBJ INTO NEW PHYSICAL  ****************/
/************  F) CREATE LOGICAL FILES            ****************/
/************  G) DELETE DUP OBJ OF PHYSICAL      ****************/
/*****************************************************************/
/* STEP 9A */
             DLTF       FILE(MCPRD1/MCFLCS1801)
             MONMSG     MSGID(CPF2105)
/* STEP 9B */
             CRTDUPOBJ  OBJ(MCFPCS1800) FROMLIB(MCPRD1) +
                          OBJTYPE(*FILE) TOLIB(MCPRD1) +
                          NEWOBJ(MCFPCS180T) DATA(*YES)
/* STEP 9C */
             DLTF       FILE(MCPRD1/MCFPCS1800)
             MONMSG     MSGID(CPF2105)
/* STEP 9D */
             CRTPF      FILE(MCPRD1/MCFPCS1800) +
                          SRCFILE(*LIBL/QDDSSRCDB) +
                          SRCMBR(MCFPCS1800) TEXT('MCOMMENT         +
                          Physical File') SIZE(*NOMAX)
/* STEP 9E */
             CPYF       FROMFILE(MCPRD1/MCFPCS180T) +
                          TOFILE(MCPRD1/MCFPCS1800) MBROPT(*ADD) +
                          FMTOPT(*NOCHK)
/* STEP 9F */
             CRTLF      FILE(MCPRD1/MCFLCS1801) +
                          SRCFILE(*LIBL/QDDSSRCDB) +
                          SRCMBR(MCFLCS1801) TEXT('MCOMMENT         +
                          Logical File (MCOMCOMMNT)')
/* STEP 9G */
             DLTF       FILE(MCPRD1/MCFPCS180T)
             MONMSG     MSGID(CPF2105)
             SNDMSG     MSG('Step 9 of 9 has COMPLETED NORMALLY in +
                          E01STORES') TOUSR(*SYSOPR)
/*****************************************************************/
             DSPJOBLOG  OUTPUT(*PRINT)
             SNDMSG     MSG('E01STORES has ENDED NORMALLY') TOUSR(*SYSOPR)
             ENDPGM
