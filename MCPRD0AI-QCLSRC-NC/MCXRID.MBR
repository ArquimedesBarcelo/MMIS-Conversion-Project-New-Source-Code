             PGM        PARM(&MEMBER &COMMENT)
             DCL        VAR(&MEMBER)  TYPE(*CHAR) LEN(10)
             DCL        VAR(&COMMENT) TYPE(*CHAR) LEN(1)
             CRTSRCPF   QTEMP/QNEWSRC
             MONMSG     MSGID(CPF0000)
             ADDPFM     FILE(QTEMP/QNEWSRC) MBR(&MEMBER)
             MONMSG     MSGID(CPF0000)
             OVRDBF     FILE(QLBLSRC) TOFILE(MCTST/QLBLSRC) +
                          MBR(&MEMBER)
             OVRDBF     FILE(QNEWSRC) TOFILE(QTEMP/QNEWSRC) +
                          MBR(&MEMBER)
             CALL MCCRID     PARM(&COMMENT)
             IF (&COMMENT *EQ '0') DO
                 CPYSRCF    FROMFILE(QTEMP/QNEWSRC) +
                            TOFILE(MCTST/QLBLSRC) +
                            FROMMBR(&MEMBER)
                 GOTO EOJ
                 ENDDO
 MC00020:    RMVM QTEMP/QNEWSRC &MEMBER
             SNDPGMMSG  MSGID(MC00020) MSGF(*LIBL/MCFPMSG) +
                        MSGDTA(&MEMBER) MSGTYPE(*ESCAPE)
             GOTO EOJ
 EOJ:        RMVM QTEMP/QNEWSRC &MEMBER
             ENDPGM
