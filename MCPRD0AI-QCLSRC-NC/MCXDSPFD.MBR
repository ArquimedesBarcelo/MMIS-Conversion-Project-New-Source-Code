             PGM        PARM(&FILESPEC &PASSEDLIB)
             DCL        VAR(&FILESPEC) TYPE(*CHAR) LEN(10)
             DCL        VAR(&PASSEDLIB) TYPE(*CHAR) LEN(10)
             DLTF MCFPFD
             MONMSG MSGID(CPF0000)
             DSPFD      FILE(&PASSEDLIB/&FILESPEC) TYPE(*MBR) +
                          OUTPUT(*OUTFILE) OUTFILE(MCPRD/MCFPFD)
             ENDPGM
