/********************************************************************/
/*** THIS PROGRAM RENAMES BOTH A PHYSICAL FILE AND THE MEMBER     ***/
/*** WITHIN THE PHYSICAL FILE.  THIS PROGRAM IS FOOL-PROOF:       ***/
/*** IT WILL GUARANTEE THE MEMBER NAME WILL MATCH THE FILE NAME,  ***/
/*** EVEN IF THEY WERE DIFFERENT TO START WITH.                   ***/
/********************************************************************/
             PGM        PARM(&OLDFILE &NEWFILE)
             DCL        VAR(&OLDFILE)    TYPE(*CHAR) LEN(10)
             DCL        VAR(&NEWFILE)    TYPE(*CHAR) LEN(10)
             DCL        VAR(&MBRNAME)    TYPE(*CHAR) LEN(10)
             RNMOBJ     OBJ(*CURLIB/&OLDFILE) OBJTYPE(*FILE) +
                          NEWOBJ(&NEWFILE)
             /* THIS GETS THE *FIRST MEMBER NAME: WHATEVER IT IS */
             RTVMBRD    FILE(*CURLIB/&NEWFILE) RTNMBR(&MBRNAME)
             /* NOW RENAME MEMBER: WHATEVER THE OLD ONE WAS TO THE */
             /* NEW FILE NAME.                                     */
             RNMM       FILE(*CURLIB/&NEWFILE) MBR(&MBRNAME) +
                          NEWMBR(&NEWFILE)
             /* IN CASE YOU END UP TRYING TO RENAME THE MEMBER NAME */
             /* TO ITSELF, MONITOR FOR THAT ERROR MESSAGE.          */
             MONMSG     MSGID(CPF0001)
             ENDPGM
