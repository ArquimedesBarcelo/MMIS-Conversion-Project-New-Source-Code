/*****************************************************************/
/*** PROGRAM: M01STORES                                        ***/
/*** PURPOSE: TO ADD AND CHANGE DATABASE FILES (PHYSICAL AND   ***/
/***          LOGICAL) FOR THE M01 DATABASE RELEASE.           ***/
/***          THIS WILL HANDLE THE STORES DATABASE.            ***/
/***                                                           ***/
/***          THIS PROGRAM CHECKS FOR THE EXISTENCE OF DATA    ***/
/***          LIBRARY MCPRD* (WHERE "*" IS AN INTEGER THAT IS  ***/
/***          INITIALLY SET TO 1), UPDATES THIS LIBRARY IF IT  ***/
/***          EXISTS, THEN INCREMENTS THE DATA LIBRARY NAME    ***/
/***          BY 1, AND CONTINUES LOOPING UNTIL THE INTEGER    ***/
/***          EXCEEDS 9, AT WHICH TIME THE PROGRAM ENDS        ***/
/***                                                           ***/
/***          FOR CHANGES TO THE DATABASE, THE CHGPF COMMAND   ***/
/***          WILL BE USED INSTEAD OF THE MANUAL MOVING OF THE ***/
/***          DATA TO INTERMEDIATE FILES AND BACK AFTER FILE   ***/
/***          CREATION.  TO USE THIS, LOCATIONS MUST BE AT     ***/
/***          LEAST ON V3R2, V3R6, OR V3R7.                    ***/
/***                                                           ***/
/***          RECOMPILE THIS PROGRAM WITH TARGET RELEASE OF    ***/
/***          OF V3R2M0 TO ACCOUNT FOR THE CHGPF COMMAND.      ***/
/*****************************************************************/
             PGM

             DCL        VAR(&LIB) TYPE(*CHAR) LEN(5) VALUE('MCPRD')
             DCL        VAR(&LIBN) TYPE(*DEC) LEN(1) VALUE(1)
             DCL        VAR(&RECORDS) TYPE(*DEC) LEN(10 0)
             DCL        VAR(&LIBC) TYPE(*CHAR) LEN(1)
             DCL        VAR(&CURLIB) TYPE(*CHAR) LEN(6)

             DCL        VAR(&DBFLIB) TYPE(*CHAR) LEN(10)
             DCL        VAR(&INPLIB) TYPE(*CHAR) LEN(10)


             CRTSAVF    FILE(MCBCK/M01SAVF) TEXT('Save file for +
                          M01STORES')

             CHGJOB     LOG(4 0 *SECLVL) LOGCLPGM(*YES)

             CHGVAR     VAR(&INPLIB) VALUE(&LIB)
LOOP:
             CHGVAR     VAR(&LIBC) VALUE(&LIBN)
             CHGVAR     VAR(&CURLIB) VALUE(&LIB *CAT &LIBC)

             CHGVAR     VAR(&DBFLIB) VALUE(&CURLIB)

/*** CHECK TO SEE IF DATA LIBRARY MCPRD* EXISTS.  IF IT DOES NOT EXIST, ***/
/*** AND MCPRD9 WAS JUST CHECKED THEN END; OTHERWISE GO BACK TO LOOP.   ***/
             CHKOBJ     OBJ(QSYS/&CURLIB) OBJTYPE(*LIB)
             MONMSG     MSGID(CPF9801) EXEC(DO)
                 IF COND(&LIBN *EQ 9) THEN(GOTO CMDLBL(ENDLOOP))
                 CHGVAR VAR(&LIBN) VALUE(&LIBN + 1)
                 GOTO CMDLBL(LOOP)
             ENDDO

             CHGCURLIB  CURLIB(&CURLIB)
             SNDMSG     MSG('Program M01STORES is now updating  +
                          CSIS/MMIS data library - ' *CAT &CURLIB) +
                          TOUSR(*SYSOPR)



/*****************************************************************/
/**********          STORES REFERENCE FILE        ****************/
/*****************************************************************/
             DLTF       FILE(&CURLIB/STORES)
             MONMSG     MSGID(CPF2105)
             CRTPF      FILE(&CURLIB/STORES) +
                          SRCFILE(&INPLIB/QDDSSRCDB) SRCMBR(STORES) +
                          TEXT(*SRCMBRTXT) SIZE(*NOMAX)

/*****************************************************************/
/**********          CSACCT REFERENCE FILE        ****************/
/*****************************************************************/
             DLTF       FILE(&CURLIB/CSACCT)
             MONMSG     MSGID(CPF2105)
             CRTPF      FILE(&CURLIB/CSACCT) +
                          SRCFILE(&INPLIB/QDDSSRCDB) SRCMBR(CSACCT) +
                          TEXT(*SRCMBRTXT) SIZE(*NOMAX)

/*****************************************************************/
/** IF FILE MCFPCA1300 EXISTS:                                  **/
/**    1)  DELETE ALL ITS LOGICALS                              **/
/**    2)  CREATE A DUPLICATE OBJECT (DATA *YES) MCFPCA13XX     **/
/**    3)  DELETE THE ORIGINAL PHYSICAL MCFPCA1300              **/
/**    4)  PROCEED WITH BUILDING THE DB FROM QDDSSRCDB          **/
/**        THIS WILL CREATE A NEW MCFPCA1300 FILE AND ALL LF'S  **/
/**    5)  IF DUPE OBJECT MCFPCA13XX HAS RECORDS IN IT THEN     **/
/**        COPY THEM BACK USING THE *MAP *DROP OPTION           **/
/**        DELETE THE DUPE OBJ MCFPCA13XX                       **/
/*****************************************************************/
             CHGVAR     VAR(&RECORDS) VALUE(0)

/*** ----------------------------------------------------------------   ***/
/*** CHECK TO SEE IF DATA FILE MCFPCA1300 EXISTS. IF IT DOES NOT THEN   ***/
/*** PROCEED TO BUILD FILES - ELSE CREATE A DUPE OBJ TO COPY BACK FROM. ***/
/*** ----------------------------------------------------------------   ***/
             CHKOBJ     OBJ(MCFPCA1300) OBJTYPE(*FILE)
             MONMSG     MSGID(CPF9801) EXEC(DO)
                 GOTO CMDLBL(BLDFILES)
             ENDDO

/*** ----------------------------------------------------------------   ***/
/**    DELETE ALL LOGICALS                                  **/
/*** ----------------------------------------------------------------   ***/
             DLTF       FILE(MCFLCA13*)
             MONMSG     MSGID(CPF2105)

             RTVMBRD    FILE(&CURLIB/MCFPCA1300) NBRCURRCD(&RECORDS)

/*** ----------------------------------------------------------------   ***/
/**   IF FILE IS EMPTY THEN JUST DELETE IT HERE AND GO ON **/
/*** ----------------------------------------------------------------   ***/
             IF         COND(&RECORDS *EQ 0) THEN(DO)
             DLTF       FILE(MCFPCA1300)
             MONMSG     MSGID(CPF2105)
             GOTO CMDLBL(BLDFILES)
             ENDDO

/*** ----------------------------------------------------------------   ***/
/**   CREATE A DUPLICATE OBJECT (DATA *YES) MCFPCA13XX     **/
/*** ----------------------------------------------------------------   ***/
             CRTDUPOBJ  OBJ(MCFPCA1300) FROMLIB(*CURLIB) +
                          OBJTYPE(*FILE) NEWOBJ(MCFPCA13XX) DATA(*YES)

/*** ----------------------------------------------------------------   ***/
/**   DELETE THE PHYSICAL                                  **/
/*** ----------------------------------------------------------------   ***/
             DLTF       FILE(MCFPCA1300)
             MONMSG     MSGID(CPF2105)


BLDFILES:
/*** CREATE PHYSICAL FILES FROM "INPUT LIB" QDDSSRCDB          ***/
             CALL       PGM(M01CRTPFCL) PARM(&DBFLIB &INPLIB)

/*** CREATE LOGICAL  FILES FROM "INPUT LIB" QDDSSRCDB          ***/
             CALL       PGM(M01CRTLFCL) PARM(&DBFLIB &INPLIB)



/*** ----------------------------------------------------------------   ***/
/**   IF MCFPCA13XX HAS RECORDS IN IT THEN:                         */
/**      1) COPY THEM TO THE NEW PHYSICAL MCFPCA1300                */
/**      2) DELETE THE DUPE OBJ MCFPCA13XX                          */
/*** ----------------------------------------------------------------   ***/
             IF         COND(&RECORDS *GT 0) THEN(DO)
             CPYF       FROMFILE(&CURLIB/MCFPCA13XX) +
                          TOFILE(&CURLIB/MCFPCA1300) +
                          MBROPT(*REPLACE) FMTOPT(*MAP *DROP)
             MONMSG     MSGID(CPF9999) EXEC(GOTO CMDLBL(CONTINUE))
             DLTF       FILE(MCFPCA13XX)
             MONMSG     MSGID(CPF2105)
             ENDDO

CONTINUE:


/***********************************************************************/
/*** INCREMENT THE LIBRARY NAME BY 1, AND GO BACK TO THE BEGINNING   ***/
/*** OF THE PROGRAM.                                                 ***/
/***********************************************************************/

             SNDMSG     MSG('Program M01STORES completed updating  +
                          CSIS/MMIS data library - ' *CAT &CURLIB) +
                          TOUSR(*SYSOPR)

             IF COND(&LIBN *EQ 9) THEN(GOTO CMDLBL(ENDLOOP))

             CHGVAR     VAR(&LIBN) VALUE(&LIBN + 1)
             GOTO CMDLBL(LOOP)

ENDLOOP:

             SNDMSG     MSG('M01STORES has COMPLETED') +
                          TOUSR(*SYSOPR)

             ENDPGM
