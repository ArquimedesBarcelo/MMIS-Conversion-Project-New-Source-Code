             PGM PARM(&DEV &WLIB &PLIB)
             DCLF FILE(UTFPCTDB)
             DCL VAR(&DEV)      TYPE(*CHAR) LEN(10)
             DCL VAR(&WLIB)     TYPE(*CHAR) LEN(10)
             DCL VAR(&PLIB)     TYPE(*CHAR) LEN(10)
             DCL VAR(&DSSSET)   TYPE(*CHAR) LEN(10)
             DCL VAR(&SEQNBR)   TYPE(*DEC)  LEN(3 0)
             DCL VAR(&MSGID)    TYPE(*CHAR) LEN(7)
             DCL VAR(&MSGF)     TYPE(*CHAR) LEN(10)
             DCL VAR(&MSGFLIB)  TYPE(*CHAR) LEN(10)
             DCL VAR(&MSGDTA)   TYPE(*CHAR) LEN(80)
             MONMSG MSGID(CPF0000 MCH0000) EXEC(GOTO CPFERROR)
/* * */
/* TRANSLATE DATA BASE INFO FILE */
             OVRTAPF    FILE(QTAPE) CODE(*ASCII)
             CPYFRMTAP  FROMFILE(QTAPE) TOFILE(UTFPCTDB) +
                          FROMSEQNBR(1) FROMLABEL(*NONE) +
                          TOMBR(*FIRST) FROMDEV(&DEV) FROMREELS(*NL +
                          1) FROMRCDLEN(80) FROMENDOPT(*LEAVE) +
                          MBROPT(*REPLACE) FROMVOL(*NONE) +
                          FROMBLKLEN(800) FROMRCDBLK(*FB)
             CHGVAR     VAR(&SEQNBR) VALUE(1)
             DLTOVR     FILE(QTAPE)
RCVF:
             RCVF
             MONMSG     MSGID(CPF0000) EXEC(GOTO EOF)
             CHGVAR     VAR(&SEQNBR) VALUE(&SEQNBR + 1)
             CALL       PGM(UTCTDB) PARM(&CTNAME &CTSET &DSSSET)
             IF (&DSSSET *NE ' ') DO
             CHKOBJ OBJ(&WLIB/&DSSSET) OBJTYPE(*FILE)
             MONMSG MSGID(CPF9800) EXEC(DO)
               CRTDUPOBJ  OBJ(&DSSSET) FROMLIB(&PLIB) OBJTYPE(*FILE) +
                            TOLIB(&WLIB)
             ENDDO
             CPYFRMTAP  FROMFILE(QTAPE) TOFILE(&WLIB/&DSSSET) +
                          FROMSEQNBR(&SEQNBR) FROMLABEL(*NONE) +
                          TOMBR(*FIRST) FROMDEV(&DEV) FROMREELS(*NL +
                          1) FROMRCDLEN(&CTRECL) FROMENDOPT(*LEAVE) +
                          MBROPT(*REPLACE) FROMVOL(*NONE) +
                          FROMBLKLEN(&CTBLKL) FROMRCDBLK(*FB)
             TRANSLATE  FILE(&DSSSET) FROMLIB(&WLIB) TOLIB(&PLIB)
             ENDDO
             GOTO RCVF
EOF:
             RETURN
/* * */
CPFERROR:
             RCVMSG     MSGTYPE(*EXCP) MSGDTA(&MSGDTA) MSGID(&MSGID) +
                          MSGF(&MSGF) MSGFLIB(&MSGFLIB)
             SNDPGMMSG  MSGID(&MSGID) MSGF(&MSGFLIB/&MSGF) +
                          MSGDTA(&MSGDTA)
             MONMSG MSGID(CPF0000)
             ENDPGM
             ENDPGM
