             PGM
/****************************************************************/
/*** THIS PROGRAM WILL ALLOW THE USER TO CHANGE THEIR DEFAULT ***/
/*** JOB OUTQ.  IT WILL FIRST DISPLAY THEIR CURRENT DEFAULT   ***/
/*** AND THEN ALLOW THE USER ENTER A NEW OUTQ.                ***/
/****************************************************************/
             DCL VAR(&OUTQ)  TYPE(*CHAR)  LEN(10)
             DCL VAR(&MSGID) TYPE(*CHAR)  LEN(7)

             DCLF ZCHGOUTQ
/****************************************************************/
             CHGVAR VAR(&IN99) VALUE('0')
 START:
             RTVJOBA OUTQ(&CURROUTQ)

             SNDRCVF  DEV(*FILE) RCDFMT(DFTOUTQ)
             IF (&SETOUTQ *EQ '         ') THEN(GOTO CMDLBL(FINI))
             CHGVAR VAR(&OUTQ) VALUE(&SETOUTQ)

             CHGJOB OUTQ(&OUTQ)
             MONMSG MSGID(CPF0000) EXEC(DO)
                 RCVMSG MSGTYPE(*DIAG) MSG(&MSG)
                 CHGVAR VAR(&IN99) VALUE('1')
                 GOTO CMDLBL(START)
             ENDDO
             RETURN
FINI:
             ENDPGM
