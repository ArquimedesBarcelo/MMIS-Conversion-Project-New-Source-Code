             PGM
/*****************************************************************/
/*** PROGRAM: J01DRWFIL                                        ***/
/*** PURPOSE: TO ADD AND CHANGE DATABASE FILES (PHYSICAL AND   ***/
/***          LOGICAL) FOR THE J01 DATABASE RELEASE.           ***/
/***          THIS WILL HANDLE THE DRWFIL FILES.               ***/
/***                                                           ***/
/***          THIS PROGRAM WILL CONTAIN SPECIAL OPERATIONS     ***/
/***          FOR THIS J01 RELEASE WHICH ARE FOR THE EXPANSION ***/
/***          OF CURRENT DATE FIELDS TO INCLUDE THE CENTURY.   ***/
/***                                                           ***/
/***          THIS PROGRAM CHECKS FOR THE EXISTENCE OF DATA    ***/
/***          LIBRARY MCPRD* (WHERE "*" IS AN INTEGER THAT IS  ***/
/***          INITIALLY SET TO 1), UPDATES THIS LIBRARY IF IT  ***/
/***          EXISTS, THEN INCREMENTS THE DATA LIBRARY NAME    ***/
/***          BY 1, AND CONTINUES LOOPING UNTIL THE INTEGER    ***/
/***          EXCEEDS 9, AT WHICH TIME THE PROGRAM ENDS        ***/
/*****************************************************************/
             DCL        VAR(&LIB)    TYPE(*CHAR) LEN(5) VALUE('MCPRD')
             DCL        VAR(&LIBN) TYPE(*DEC) LEN(1) VALUE(1)
             DCL        VAR(&LIBC) TYPE(*CHAR) LEN(1)
             DCL        VAR(&CURLIB) TYPE(*CHAR) LEN(6)
             DCL        VAR(&NBRCURRCD) TYPE(*DEC) LEN(10 0)

             CHGJOB     LOG(4 0 *SECLVL) LOGCLPGM(*YES)
LOOP:
             CHGVAR     VAR(&LIBC) VALUE(&LIBN)
             CHGVAR     VAR(&CURLIB) VALUE(&LIB *CAT &LIBC)

/*** CHECK TO SEE IF DATA LIBRARY MCPRD* EXISTS.  IF IT DOES NOT EXIST, ***/
/*** AND MCPRD9 WAS JUST CHECKED THEN END; OTHERWISE GO BACK TO LOOP.      ***/
             CHKOBJ     OBJ(QSYS/&CURLIB) OBJTYPE(*LIB)
             MONMSG     MSGID(CPF9801) EXEC(DO)
                 IF COND(&LIBN *EQ 9) THEN(GOTO CMDLBL(ENDLOOP))
                 CHGVAR VAR(&LIBN) VALUE(&LIBN + 1)
                 GOTO CMDLBL(LOOP)
             ENDDO

             CHGCURLIB  CURLIB(&CURLIB)
             SNDMSG     MSG('Program J01DRWFIL is now updating  +
                          CSIS/MMIS data library - ' *CAT &CURLIB) +
                          TOUSR(*SYSOPR)

/*****************************************************************/
/****  COPY CURRENT MCFP* FILES TO THE ICFP* INTERMEDIATE     ****/
/****  FILES THAT SHOULD HAVE ALREADY BEEN RESTORED FOR J01.  ****/
/****  THIS IS THE FIRST STEP IN EXPANDING THE FILES FOR      ****/
/****  DATES THAT INCLUDE CENTURY.  A TWO BYTE FIELD IS ADDED ****/
/****  BEFORE EACH DATE FIELD AND DEFAULTED TO A VALUE OF 19. ****/
/****  EACH CPYF SHOULD BE DONE WITH *MAP *DROP FOR THIS STEP.****/
/****  NO COMPILING OF DDS SHOULD BE DONE IN THIS STEP.       ****/
/*****************************************************************/

STEP1:
/*****************************************************************/
/************             MCFPDF0100              ****************/
/************ COPY DATA TO INTERMEDIATE FILE      ****************/
/*****************************************************************/
             CHKOBJ     OBJ(*CURLIB/MCFPDF0100) OBJTYPE(*FILE)
             MONMSG     MSGID(CPF9801) EXEC(GOTO CMDLBL(STEP2))
             CHKOBJ     OBJ(*CURLIB/ICFPDF0100) OBJTYPE(*FILE)
             MONMSG     MSGID(CPF9801) EXEC(DO)
                 SNDMSG   MSG('CSIS/MMIS intermediate file ICFPDF0100 +
                          does not exist.  J01DRWFIL skipping this +
                          step either because the step had been +
                          completed or file was not restored.  If +
                          not restored, restore this intermediate +
                          file and attempt to run J01DRWFIL again.') +
                          TOUSR(QSYSOPR)
                 GOTO   CMDLBL(STEP2)
             ENDDO
             RTVMBRD    FILE(*CURLIB/MCFPDF0100) NBRCURRCD(&NBRCURRCD)
             IF         (&NBRCURRCD *GT 0) THEN(DO)
               CPYF       FROMFILE(*CURLIB/MCFPDF0100) +
                          TOFILE(*CURLIB/ICFPDF0100) +
                          MBROPT(*REPLACE) FMTOPT(*MAP *DROP)
               MONMSG     MSGID(CPF0000) EXEC(DO)
             SNDMSG     MSG('CSIS/MMIS J01DRWFIL ERROR.  Error copying +
                          MCFPDF0100 data to intermediate file.  +
                          Check joblog, resolve error and attempt +
                          to run J01DRWFIL again.') TOUSR(QSYSOPR)
                 GOTO   CMDLBL(ENDPGM)
               ENDDO
             ENDDO
             DLTF       FILE(*CURLIB/MCFLDF0101)
             MONMSG     MSGID(CPF2105)
             DLTF       FILE(*CURLIB/MCFLDF0102)
             MONMSG     MSGID(CPF2105)
             DLTF       FILE(*CURLIB/MCFLDF0103)
             MONMSG     MSGID(CPF2105)
             DLTF       FILE(*CURLIB/MCFLDF0104)
             MONMSG     MSGID(CPF2105)
             DLTF       FILE(*CURLIB/MCFLDF0105)
             MONMSG     MSGID(CPF2105)
             DLTF       FILE(*CURLIB/MCFLDF0106)
             MONMSG     MSGID(CPF2105)
             DLTF       FILE(*CURLIB/MCFPDF0100)
             MONMSG     MSGID(CPF2105)
STEP2:
/*****************************************************************/
/************             MCFPDF0200              ****************/
/************ COPY DATA TO INTERMEDIATE FILE      ****************/
/*****************************************************************/
             CHKOBJ     OBJ(*CURLIB/MCFPDF0200) OBJTYPE(*FILE)
             MONMSG     MSGID(CPF9801) EXEC(GOTO CMDLBL(STEP3))
             CHKOBJ     OBJ(*CURLIB/ICFPDF0200) OBJTYPE(*FILE)
             MONMSG     MSGID(CPF9801) EXEC(DO)
                 SNDMSG   MSG('CSIS/MMIS intermediate file ICFPDF0200 +
                          does not exist.  J01DRWFIL skipping this +
                          step either because the step had been +
                          completed or file was not restored.  If +
                          not restored, restore this intermediate +
                          file and attempt to run J01DRWFIL again.') +
                          TOUSR(QSYSOPR)
                 GOTO   CMDLBL(STEP3)
             ENDDO
             RTVMBRD    FILE(*CURLIB/MCFPDF0200) NBRCURRCD(&NBRCURRCD)
             IF         (&NBRCURRCD *GT 0) THEN(DO)
               CPYF       FROMFILE(*CURLIB/MCFPDF0200) +
                          TOFILE(*CURLIB/ICFPDF0200) +
                          MBROPT(*REPLACE) FMTOPT(*MAP *DROP)
               MONMSG     MSGID(CPF0000) EXEC(DO)
             SNDMSG     MSG('CSIS/MMIS J01DRWFIL ERROR.  Error copying +
                          MCFPDF0200 data to intermediate file.  +
                          Check joblog, resolve error and attempt +
                          to run J01DRWFIL again.') TOUSR(QSYSOPR)
                 GOTO   CMDLBL(ENDPGM)
               ENDDO
             ENDDO
             DLTF       FILE(*CURLIB/MCFLDF0201)
             MONMSG     MSGID(CPF2105)
             DLTF       FILE(*CURLIB/MCFPDF0200)
             MONMSG     MSGID(CPF2105)
STEP3:
/*****************************************************************/
/**********   DRAWING FILE  REFERENCE FILE        ****************/
/*****************************************************************/
             DLTF       FILE(*CURLIB/DRWFIL)
             MONMSG     MSGID(CPF2105)
             CRTPF      FILE(*CURLIB/DRWFIL) +
                          SRCFILE(*LIBL/QDDSSRCDB) SRCMBR(DRWFIL) +
                          TEXT(*SRCMBRTXT) SIZE(*NOMAX)
STEP4:
/*****************************************************************/
/************             MCFPDF0100              ****************/
/************  C) CREATE PHYSICAL FILE            ****************/
/************  D) COPY ICFP* FILE INTO MCFP* FILE ****************/
/************  E) CREATE LOGICAL FILES            ****************/
/*****************************************************************/
             CHKOBJ     OBJ(*CURLIB/ICFPDF0100) OBJTYPE(*FILE)
             MONMSG     MSGID(CPF9801) EXEC(GOTO CMDLBL(STEP5))
             CRTPF      FILE(*CURLIB/MCFPDF0100) +
                          SRCFILE(*LIBL/QDDSSRCDB) +
                          SRCMBR(MCFPDF0100) TEXT(*SRCMBRTXT) +
                          SIZE(*NOMAX)
             MONMSG     MSGID(CPF0000) EXEC(DO)
                 SNDMSG MSG('CSIS/MMIS J01DRWFIL ERROR.  Error +
                          creating MCFPDF0100 file.  Check joblog, +
                          resolve error and attempt to run +
                          J01DRWFIL again.') TOUSR(QSYSOPR)
                 GOTO   CMDLBL(ENDPGM)
             ENDDO
             RTVMBRD    FILE(*CURLIB/ICFPDF0100) NBRCURRCD(&NBRCURRCD)
             IF         (&NBRCURRCD *GT 0) THEN(DO)
               CPYF       FROMFILE(*CURLIB/ICFPDF0100) +
                          TOFILE(*CURLIB/MCFPDF0100) MBROPT(*REPLACE) +
                          FMTOPT(*NOCHK)
               MONMSG     MSGID(CPF0000) EXEC(DO)
                 SNDMSG MSG('CSIS/MMIS J01DRWFIL ERROR.  Error +
                          copying intermediate file to MCFPDF0100 +
                          file.  Check joblog, resolve error and +
                          attempt to run J01DRWFIL again.') +
                          TOUSR(QSYSOPR)
                 GOTO   CMDLBL(ENDPGM)
               ENDDO
             ENDDO
             CRTLF      FILE(*CURLIB/MCFLDF0101) +
                          SRCFILE(*LIBL/QDDSSRCDB) +
                          SRCMBR(MCFLDF0101) TEXT(*SRCMBRTXT)
             CRTLF      FILE(*CURLIB/MCFLDF0102) +
                          SRCFILE(*LIBL/QDDSSRCDB) +
                          SRCMBR(MCFLDF0102) TEXT(*SRCMBRTXT)
             CRTLF      FILE(*CURLIB/MCFLDF0103) +
                          SRCFILE(*LIBL/QDDSSRCDB) +
                          SRCMBR(MCFLDF0103) TEXT(*SRCMBRTXT)
             CRTLF      FILE(*CURLIB/MCFLDF0104) +
                          SRCFILE(*LIBL/QDDSSRCDB) +
                          SRCMBR(MCFLDF0104) TEXT(*SRCMBRTXT)
             CRTLF      FILE(*CURLIB/MCFLDF0105) +
                          SRCFILE(*LIBL/QDDSSRCDB) +
                          SRCMBR(MCFLDF0105) TEXT(*SRCMBRTXT)
             CRTLF      FILE(*CURLIB/MCFLDF0106) +
                          SRCFILE(*LIBL/QDDSSRCDB) +
                          SRCMBR(MCFLDF0106) TEXT(*SRCMBRTXT)
             DLTF       FILE(*CURLIB/ICFPDF0100)
STEP5:
/*****************************************************************/
/************             MCFPDF0200              ****************/
/************  C) CREATE PHYSICAL FILE            ****************/
/************  D) COPY ICFP* FILE INTO MCFP* FILE ****************/
/************  E) CREATE LOGICAL FILES            ****************/
/*****************************************************************/
             CHKOBJ     OBJ(*CURLIB/ICFPDF0200) OBJTYPE(*FILE)
             MONMSG     MSGID(CPF9801) EXEC(GOTO CMDLBL(STEP6))
             CRTPF      FILE(*CURLIB/MCFPDF0200) +
                          SRCFILE(*LIBL/QDDSSRCDB) +
                          SRCMBR(MCFPDF0200) TEXT(*SRCMBRTXT) +
                          SIZE(*NOMAX)
             MONMSG     MSGID(CPF0000) EXEC(DO)
                 SNDMSG MSG('CSIS/MMIS J01DRWFIL ERROR.  Error +
                          creating MCFPDF0200 file.  Check joblog, +
                          resolve error and attempt to run +
                          J01DRWFIL again.') TOUSR(QSYSOPR)
                 GOTO   CMDLBL(ENDPGM)
             ENDDO
             RTVMBRD    FILE(*CURLIB/ICFPDF0200) NBRCURRCD(&NBRCURRCD)
             IF         (&NBRCURRCD *GT 0) THEN(DO)
               CPYF       FROMFILE(*CURLIB/ICFPDF0200) +
                          TOFILE(*CURLIB/MCFPDF0200) MBROPT(*REPLACE) +
                          FMTOPT(*NOCHK)
               MONMSG     MSGID(CPF0000) EXEC(DO)
                 SNDMSG MSG('CSIS/MMIS J01DRWFIL ERROR.  Error +
                          copying intermediate file to MCFPDF0200 +
                          file.  Check joblog, resolve error and +
                          attempt to run J01DRWFIL again.') +
                          TOUSR(QSYSOPR)
                 GOTO   CMDLBL(ENDPGM)
               ENDDO
             ENDDO
             CRTLF      FILE(*CURLIB/MCFLDF0201) +
                          SRCFILE(*LIBL/QDDSSRCDB) +
                          SRCMBR(MCFLDF0201) TEXT(*SRCMBRTXT)
             DLTF       FILE(*CURLIB/ICFPDF0200)
/*****************************************************************/
/************ RESET C FOR BLANK YMD USING RUNSQL  ****************/
/*****************************************************************/
STEP6:
             CHKOBJ     OBJ(*LIBL/RUNSQL) OBJTYPE(*PGM)
             MONMSG     MSGID(CPF9801) EXEC(DO)
               SNDMSG     MSG('Century not reset to blank for blank +
                          YMD in DRWFIL because RUNSQL does not +
                          exist. Contact CSIS programming.') +
                          TOUSR(QSYSOPR)
               GOTO       CMDLBL(END)
             ENDDO
             CHKOBJ     OBJ(*CURLIB/MCFPDF0100) OBJTYPE(*FILE)
             MONMSG     MSGID(CPF9801) EXEC(GOTO CMDLBL(STEP7))
             RUNSQL     REQUEST('UPDATE MCFPDF0100 +
                             SET DRWINITDAT = ''        '' +
                             WHERE SUBSTR(DRWINITDAT,3,6) = ''      ''')
             RUNSQL     REQUEST('UPDATE MCFPDF0100 +
                             SET DRWREVDAT = ''        '' +
                             WHERE SUBSTR(DRWREVDAT,3,6) = ''      ''')
STEP7:
             CHKOBJ     OBJ(*CURLIB/MCFPDF0200) OBJTYPE(*FILE)
             MONMSG     MSGID(CPF9801) EXEC(GOTO CMDLBL(END))
             RUNSQL     REQUEST('UPDATE MCFPDF0200 +
                             SET DRWVERSDAT = ''        '' +
                             WHERE SUBSTR(DRWVERSDAT,3,6) = ''      ''')
/*****************************************************************/
             SNDMSG     MSG('Program J01DRWFIL has successfully +
                          updated  CSIS/MMIS data library - ' *CAT +
                          &CURLIB) TOUSR(*SYSOPR)
END:

/*** INCREMENT THE LIBRARY NAME BY 1, AND GO BACK TO THE BEGINNING   ***/
/*** OF THE PROGRAM.                                                 ***/
             CHGVAR     VAR(&LIBN) VALUE(&LIBN + 1)
             GOTO       CMDLBL(LOOP)
ENDLOOP:
             SNDMSG     MSG('J01DRWFIL has ENDED NORMALLY') +
                          TOUSR(*SYSOPR)
/*****************************************************************/
ENDPGM:
             ENDPGM
