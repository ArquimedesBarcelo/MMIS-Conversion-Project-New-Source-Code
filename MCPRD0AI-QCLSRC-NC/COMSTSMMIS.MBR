             PGM        /* Check the status of Communication +
                          Programs. Attempt to start them if they +
                          are not active  */

 BEGIN:

 CMCMMIS:

 /*  Try to allocate data area CMDAMMIS. If it can be allocated, then */
 /*  the job down load job is not running.                             */

             ALCOBJ     OBJ((CMPRD/CMDAMMIS *DTAARA *EXCL)) WAIT(5)
             MONMSG     MSGID(CPF0000) EXEC(GOTO CMDLBL(FINI))

 /*  Oh wow, we got it. Something must have knocked that dude off!   */
 /*  Let's tell someone what we found and that we are attempting to  */
 /*  revive him!!                                                    */

             SNDMSG     MSG('CMCMMIS Program not Active. Automatic +
                          Startup in Progress.') TOUSR(*SYSOPR)
             MONMSG     MSGID(CPF0000)

 /*  Give 'em back the data area so they  so they can use it.        */

             DLCOBJ     OBJ((CMPRD/CMDAMMIS *DTAARA *EXCL))
             MONMSG     MSGID(CPF0000)

             STRMMISSRV
             MONMSG     MSGID(CPF0000)

 FINI:
             ENDPGM
