/*********************************************************************/
/** PROGRAM: TARBCPYEXC                                            ***/
/**                                                                ***/
/** PURPOSE: COPY ALL MCFPAB3500 PLANT MEMBERS TO *FIRST MBR       ***/
/**                                                                ***/
/** CREATED: 04/30/2004                                            ***/
/** AUTHOR : DAN RAUCH - eXLTech, LLC                              ***/
/**                                                                ***/
/*********************************************************************/
/** SPECIAL NOTES:                                                 ***/
/*********************************************************************/
PGM

             DCL        VAR(&RECORDS) TYPE(*DEC) LEN(10 0)


             CLRPFM     FILE(MCFPAB3500) MBR(ALLPLANTS)

/** -------------------------------------------------------------- ***/
/** COPY DANVILLE DATA       PLANT 126                             ***/
/** -------------------------------------------------------------- ***/
             RTVMBRD    FILE(MCFPAB3500) MBR(Z126) NBRCURRCD(&RECORDS)
             IF         COND(&RECORDS *GT 0) THEN(DO)
             CPYF       FROMFILE(MCFPAB3500) TOFILE(MCFPAB3500) +
                          FROMMBR(Z126) TOMBR(ALLPLANTS) MBROPT(*ADD)
             MONMSG     MSGID(CPF0000)
             ENDDO

/** -------------------------------------------------------------- ***/
/** COPY UNION CITY DATA     PLANT 129                             ***/
/** -------------------------------------------------------------- ***/
             RTVMBRD    FILE(MCFPAB3500) MBR(Z129) NBRCURRCD(&RECORDS)
