             PGM        PARM(&LIB &FILE &STATUS)
             DCL        VAR(&LIB) TYPE(*CHAR) LEN(10)
             DCL        VAR(&FILE) TYPE(*CHAR) LEN(10)
             DCL        VAR(&STATUS) TYPE(*CHAR) LEN(2)
             CALL       WHO
             STRCPYSCN  SRCDEV(*REQUESTER) OUTDEV(*NONE)  +
                          OUTFILE(&LIB/&FILE)
             MONMSG     MSGID(CPF0000) EXEC(DO)
                          CHGVAR VAR(&STATUS) VALUE('99')
                          ENDDO
             ENDCPYSCN
             CPYF       FROMFILE(&LIB/&FILE) TOFILE(*PRINT)
             DLTF       FILE(&LIB/&FILE)
 OVERRIDE:   IF (&LIB *NE '*LIBL') THEN(DO)
                 OVRDBF  FILE(&FILE) TOFILE(&LIB/&FILE)
                 ENDDO
 EOJ:        ENDPGM
