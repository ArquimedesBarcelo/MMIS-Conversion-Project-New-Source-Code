             PGM        PARM(&PASSEDLIB &PASSEDTYP)
             DCL        VAR(&PASSEDLIB) TYPE(*CHAR) LEN(10)
             DCL        VAR(&PASSEDTYP) TYPE(*CHAR) LEN(10)
             DSPOBJD    OBJ(&PASSEDLIB/*ALL) OBJTYPE(&PASSEDTYP) +
                          DETAIL(*FULL) OUTPUT(*OUTFILE) +
                          OUTFILE(QTEMP/MCFPLIBRPT)
             RUNQRY     QRY(MCQLIBRPT)
             ENDPGM
