             PGM        PARM(&FILENAME &LIB &MBFCDT &MBFCTM &MBCHGD +
                          &MBCHGT &MBNRCD)
             DCL        VAR(&FILENAME) TYPE(*CHAR) LEN(10)
             DCL        VAR(&LIB) TYPE(*CHAR) LEN(10)
             DCLF       FILE(MCFPDSPFD)

             DSPFD      FILE(&LIB/&FILENAME) TYPE(*MBR) +
                          OUTPUT(*OUTFILE) OUTFILE(QTEMP/MCFPDSPFD) +
                          OUTMBR(*FIRST)

             RCVF
             RCVF       /* THIS CLOSES THE FILE */
             MONMSG     MSGID(CPF0000)

             ENDPGM
