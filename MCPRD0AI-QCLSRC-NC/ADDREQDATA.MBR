/********************************************************************/
     PGM PARM(&DATE &SEQ &TIME &CODE)
     DCL VAR(&DATE) TYPE(*CHAR) LEN(6)
     DCL VAR(&SEQ) TYPE(*CHAR) LEN(5)
     DCL VAR(&TIME) TYPE(*CHAR) LEN(6)
     DCL VAR(&CODE) TYPE(*CHAR) LEN(1)
     DCL VAR(&MBR) TYPE(*CHAR) LEN(10)
     DCL VAR(&TEXT) TYPE(*CHAR) LEN(30)
     CHGVAR VAR(&MBR) VALUE('R3REQ' *CAT &SEQ)
     CHGVAR VAR(&TEXT) VALUE('Requisitions' *BCAT &DATE *BCAT &TIME)
     CHKOBJ OBJ(R3REQDATA) OBJTYPE(*FILE) MBR(&MBR)
     MONMSG MSGID(CPF0000) EXEC(GOTO CMDLBL(ADDMBR))
     CHGVAR VAR(&CODE) VALUE('1')
     GOTO CMDLBL(ENDPGM)
ADDMBR: +
     ADDPFM FILE(R3REQDATA) MBR(&MBR) TEXT(&TEXT)
     MONMSG MSGID(CPF0000) EXEC(CHGVAR VAR(&CODE) VALUE('9'))
ENDPGM: +
     ENDPGM
