             PGM
/*****************************************************************/
/*** PROGRAM: E01MMISA                                         ***/
/*** PURPOSE: TO ADD AND CHANGE DATABASE FILES (PHYSICAL AND   ***/
/***          LOGICAL) FOR THE E01 DATABASE RELEASE.           ***/
/*****************************************************************/
/*                                                               */
/*****************************************************************/
/**********                 STEP 1                ****************/
/**********           MMISA REFERENCE FILE        ****************/
/**********      DELETE PHYSICAL MMISA REF FILE   ****************/
/**********      CREATE PHYSICAL MMISA REF FILE   ****************/
/*****************************************************************/
             DLTF       FILE(MCPRD1/MMISA)
             MONMSG     MSGID(CPF2105)
             CRTPF      FILE(MCPRD1/MMISA) SRCFILE(*LIBL/QDDSSRCDB) +
                          SRCMBR(MMISA) TEXT('MMISA     Reference +
                          File') SIZE(*NOMAX)
             SNDMSG     MSG('Step 1 of 6 has COMPLETED NORMALLY in +
                          E01MMISA') TOUSR(*SYSOPR)
/*****************************************************************/
/**********                 STEP 2                ****************/
/**********       MCFPMM4000  PM-JOBPLAN-KEYS     ****************/
/**********   CREATE PHYSICAL AND LOGICAL FILES   ****************/
/*****************************************************************/
             CRTPF      FILE(MCPRD1/MCFPMM4000) +
                          SRCFILE(*LIBL/QDDSSRCDB) +
                          SRCMBR(MCFPMM4000) TEXT('PM-JOBPLAN-KEYS  +
                          Physical File') SIZE(*NOMAX)
             CRTLF      FILE(MCPRD1/MCFLMM4001) +
                          SRCFILE(*LIBL/QDDSSRCDB) +
                          SRCMBR(MCFLMM4001) TEXT('PM-JOBPLAN-KEYS  +
                          Logical File (RECKEY)')
             CRTLF      FILE(MCPRD1/MCFLMM4002) +
                          SRCFILE(*LIBL/QDDSSRCDB) +
                          SRCMBR(MCFLMM4002) TEXT('PM-JOBPLAN-KEYS  +
                          Logical File (PMJOBPKEY)')
             CRTLF      FILE(MCPRD1/MCFLMM4003) +
                          SRCFILE(*LIBL/QDDSSRCDB) +
                          SRCMBR(MCFLMM4003) TEXT('PM-JOBPLAN-KEYS  +
                          Logical File (JOBPWOSEQ)')
             SNDMSG     MSG('Step 2 of 6 has COMPLETED NORMALLY in +
                          E01MMISA') TOUSR(*SYSOPR)
/*****************************************************************/
/************               STEP 3                ****************/
/************        MCFPMM4100  PM-JOBPLAN       ****************/
/************  CREATE PHYSICAL AND LOGICAL FILES  ****************/
/*****************************************************************/
             CRTPF      FILE(MCPRD1/MCFPMM4100) +
                          SRCFILE(*LIBL/QDDSSRCDB) +
                          SRCMBR(MCFPMM4100) TEXT('PM-JOBPLAN       +
                          Physical File') SIZE(*NOMAX)
             CRTLF      FILE(MCPRD1/MCFLMM4101) +
                          SRCFILE(*LIBL/QDDSSRCDB) +
                          SRCMBR(MCFLMM4101) TEXT('PM-JOBPLAN       +
                          Logical File (PMJOBPKEY)')
             CRTLF      FILE(MCPRD1/MCFLMM4102) +
                          SRCFILE(*LIBL/QDDSSRCDB) +
                          SRCMBR(MCFLMM4102) TEXT('PM-JOBPLAN       +
                          Logical File (JOBPWOSEQ)')
             CRTLF      FILE(MCPRD1/MCFLMM4103) +
                          SRCFILE(*LIBL/QDDSSRCDB) +
                          SRCMBR(MCFLMM4103) TEXT('PM-JOBPLAN       +
                          Logical File (PRTNUMBER)')
             SNDMSG     MSG('Step 3 of 6 has COMPLETED NORMALLY in +
                          E01MMISA') TOUSR(*SYSOPR)
/*****************************************************************/
/************                 STEP 4              ****************/
/************       MCFPMM4200  PM-JOBPLAN-TEMP   ****************/
/************  CREATE PHYSICAL AND LOGICAL FILES  ****************/
/*****************************************************************/
             CRTPF      FILE(MCPRD1/MCFPMM4200) +
                          SRCFILE(*LIBL/QDDSSRCDB) +
                          SRCMBR(MCFPMM4200) TEXT('PM-JOBPLAN-TEMP  +
                          Physical File') SIZE(*NOMAX)
             CRTLF      FILE(MCPRD1/MCFLMM4201) +
                          SRCFILE(*LIBL/QDDSSRCDB) +
                          SRCMBR(MCFLMM4201) TEXT('PM-JOBPLAN-TEMP  +
                          Logical File (PMJOBPKEY)')
             SNDMSG     MSG('Step 4 of 6 has COMPLETED NORMALLY in +
                          E01MMISA') TOUSR(*SYSOPR)
/*****************************************************************/
/************               STEP 5                ****************/
/************        MCFPMM1100  WO-PLANNED       ****************/
/************  A) DELETE LOGICAL FILES            ****************/
/************  B) CREATE DUP OBJ OF PHYSICAL      ****************/
/************  C) DELETE PHYSICAL FILE            ****************/
/************  D) CREATE PHYSICAL FILE            ****************/
/************  E) COPY DUP OBJ INTO NEW PHYSICAL  ****************/
/************  F) CREATE LOGICAL FILES            ****************/
/************  G) DELETE DUP OBJ OF PHYSICAL      ****************/
/*****************************************************************/
/* STEP 5A */
             DLTF       FILE(MCPRD1/MCFLMM1101)
             MONMSG     MSGID(CPF2105)
             DLTF       FILE(MCPRD1/MCFLMM1102)
             MONMSG     MSGID(CPF2105)
             DLTF       FILE(MCPRD1/MCFLMM1103)
             MONMSG     MSGID(CPF2105)
             DLTF       FILE(MCPRD1/MCFLMM1104)
             MONMSG     MSGID(CPF2105)
             DLTF       FILE(MCPRD1/MCFLMM1105)
             MONMSG     MSGID(CPF2105)
/* STEP 5B */
             CRTDUPOBJ  OBJ(MCFPMM1100) FROMLIB(MCPRD1) +
                          OBJTYPE(*FILE) TOLIB(MCPRD1) +
                          NEWOBJ(MCFPMM110T) DATA(*YES)
/* STEP 5C */
             DLTF       FILE(MCPRD1/MCFPMM1100)
             MONMSG     MSGID(CPF2105)
/* STEP 5D */
             CRTPF      FILE(MCPRD1/MCFPMM1100) +
                          SRCFILE(*LIBL/QDDSSRCDB) +
                          SRCMBR(MCFPMM1100) TEXT('WO-PLANNED       +
                          Physical File') SIZE(*NOMAX)
/* STEP 5E */
             CPYF       FROMFILE(MCPRD1/MCFPMM110T) +
                          TOFILE(MCPRD1/MCFPMM1100) MBROPT(*ADD) +
                          FMTOPT(*NOCHK)
/* STEP 5F */
             CRTLF      FILE(MCPRD1/MCFLMM1101) +
                          SRCFILE(*LIBL/QDDSSRCDB) +
                          SRCMBR(MCFLMM1101) TEXT('WO-PLANNED       +
                          Logical File (WONUM)')
             CRTLF      FILE(MCPRD1/MCFLMM1102) +
                          SRCFILE(*LIBL/QDDSSRCDB) +
                          SRCMBR(MCFLMM1102) TEXT('WO-PLANNED       +
                          Logical File (WOSTATUS)')
             CRTLF      FILE(MCPRD1/MCFLMM1103) +
                          SRCFILE(*LIBL/QDDSSRCDB) +
                          SRCMBR(MCFLMM1103) TEXT('WO-PLANNED       +
                          Logical File (EQPNUM)')
             CRTLF      FILE(MCPRD1/MCFLMM1104) +
                          SRCFILE(*LIBL/QDDSSRCDB) +
                          SRCMBR(MCFLMM1104) TEXT('WO-PLANNED       +
                          Logical File (DATEREQD)')
             CRTLF      FILE(MCPRD1/MCFLMM1105) +
                          SRCFILE(*LIBL/QDDSSRCDB) +
                          SRCMBR(MCFLMM1105) TEXT('WO-PLANNED       +
                          Logical File (DATESCHD)')
             CRTLF      FILE(MCPRD1/MCFLMM1106) +
                          SRCFILE(*LIBL/QDDSSRCDB) +
                          SRCMBR(MCFLMM1106) TEXT('WO-PLANNED       +
                          Logical File (PMJOBPKEY)')
/* STEP 5G */
             DLTF       FILE(MCPRD1/MCFPMM110T)
             MONMSG     MSGID(CPF2105)
             SNDMSG     MSG('Step 5 of 6 has COMPLETED NORMALLY in +
                          E01MMISA') TOUSR(*SYSOPR)
/*****************************************************************/
/************                 STEP 6              ****************/
/************       MCFPMM0900  WO-SUFFIX-NUM     ****************/
/************  DELETE PHYSICAL AND LOGICAL FILES  ****************/
/*****************************************************************/
             DLTF       FILE(MCPRD1/MCFLMM0901)
             MONMSG     MSGID(CPF2105)
             DLTF       FILE(MCPRD1/MCFPMM0900)
             MONMSG     MSGID(CPF2105)
             SNDMSG     MSG('Step 6 of 6 has COMPLETED NORMALLY in +
                          E01MMISA') TOUSR(*SYSOPR)
/*****************************************************************/
             DSPJOBLOG  OUTPUT(*PRINT)
             SNDMSG     MSG('E01MMISA has ENDED NORMALLY') TOUSR(*SYSOPR)
             ENDPGM
