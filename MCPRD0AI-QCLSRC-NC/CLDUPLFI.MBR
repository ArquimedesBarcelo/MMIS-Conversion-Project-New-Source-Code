             CHKOBJ     OBJ(QTEMP/DUPLFI) OBJTYPE(*FILE)
             MONMSG     MSGID(CPF9800) EXEC(DO)
             CRTPF      FILE(QTEMP/DUPLFI) RCDLEN(50)
             ENDDO
             CLRPFM     FILE(QTEMP/DUPLFI)
             OVRDBF     FILE(DUPLFI) TOFILE(QTEMP/DUPLFI)
             DLTOVR     FILE(DUPLFI)
             ENDPGM
