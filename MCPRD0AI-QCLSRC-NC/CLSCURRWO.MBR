PGM PARM(&DBPARMS)
             DCL        VAR(&DBPARMS) TYPE(*CHAR) LEN(100)
             CHKOBJ     OBJ(QTEMP/SCURRWO) OBJTYPE(*FILE)
             MONMSG     MSGID(CPF9800) EXEC(DO)
             CRTPF      FILE(QTEMP/SCURRWO) RCDLEN(74)
             ENDDO
             CLRPFM     FILE(QTEMP/SCURRWO)
             OVRDBF     FILE(SCURRWO) TOFILE(QTEMP/SCURRWO)
             CALL       PGM(*LIBL/TSCURRWO) PARM(&DBPARMS)
             DLTOVR     FILE(SCURRWO)
             ENDPGM
