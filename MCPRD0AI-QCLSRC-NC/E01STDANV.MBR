             PGM
/*****************************************************************/
/*** PROGRAM: E01STDANV                                        ***/
/*** PURPOSE: TO ADD AND CHANGE DATABASE FILES (PHYSICAL AND   ***/
/***          LOGICAL) FOR THE E01 DATABASE RELEASE.           ***/
/***          THIS IS A PARTIAL OF E01STORES THAT IS TO BE RUN ***/
/***          FOR DANVILLE ONLY, SINCE THEY HAVE THE EDI       ***/
/***          VERSION OF THE DATABASE ALREADY.                 ***/
/*****************************************************************/
/*                                                               */
/*****************************************************************/
/**********                 STEP 1                ****************/
/**********          STORES REFERENCE FILE        ****************/
/**********     DELETE PHYSICAL STORES REF FILE   ****************/
/**********     CREATE PHYSICAL STORES REF FILE   ****************/
/*****************************************************************/
             DLTF       FILE(MCPRD1/STORES)
             MONMSG     MSGID(CPF2105)
             CRTPF      FILE(MCPRD1/STORES) SRCFILE(*LIBL/QDDSSRCDB) +
                          SRCMBR(STORES) TEXT('STORES    Reference +
                          File') SIZE(*NOMAX)
             SNDMSG     MSG('Step 1 of 4 has COMPLETED NORMALLY in +
                          E01STDANV') TOUSR(*SYSOPR)
/*****************************************************************/
/************               STEP 2                ****************/
/************        MCFPCS4900  MCLASS           ****************/
/************  CREATE PHYSICAL FILE               ****************/
/************  COPY PHYSICAL FILE FROM MCFPCA0200 ****************/
/************  CREATE LOGICAL FILE                ****************/
/************  DELETE LOGICAL FILES FOR MCFPCA0200****************/
/************  DELETE PHYSICAL FILE MCFPCA0200    ****************/
/*****************************************************************/
             CRTPF      FILE(MCPRD1/MCFPCS4900) +
                          SRCFILE(*LIBL/QDDSSRCDB) +
                          SRCMBR(MCFPCS4900) TEXT('MCLASS           +
                          Physical File') SIZE(*NOMAX)
             CPYF       FROMFILE(MCPRD1/MCFPCA0200) +
                          TOFILE(MCPRD1/MCFPCS4900) MBROPT(*ADD) +
                          FMTOPT(*NOCHK)
             CRTLF      FILE(MCPRD1/MCFLCS4901) +
                          SRCFILE(*LIBL/QDDSSRCDB) +
                          SRCMBR(MCFLCS4901) TEXT('MCLASS           +
                          Logical File (ACTGCLASS)')
             DLTF       FILE(MCPRD1/MCFLCA0201)
             MONMSG     MSGID(CPF2105)
             DLTF       FILE(MCPRD1/MCFPCA0200)
             MONMSG     MSGID(CPF2105)
             SNDMSG     MSG('Step 2 of 4 has COMPLETED NORMALLY in +
                          E01STDANV') TOUSR(*SYSOPR)
/*****************************************************************/
/************                 STEP 3              ****************/
/************       MCFPCS5000  DRESTRICT         ****************/
/************  CREATE PHYSICAL AND LOGICAL FILES  ****************/
/*****************************************************************/
             CRTPF      FILE(MCPRD1/MCFPCS5000) +
                          SRCFILE(*LIBL/QDDSSRCDB) +
                          SRCMBR(MCFPCS5000) TEXT('DRESTRICT        +
                          Physical File') SIZE(*NOMAX)
             CRTLF      FILE(MCPRD1/MCFLCS5001) +
                          SRCFILE(*LIBL/QDDSSRCDB) +
                          SRCMBR(MCFLCS5001) TEXT('DRESTRICT        +
                          Logical File (CORPCDE)')
             SNDMSG     MSG('Step 3 of 4 has COMPLETED NORMALLY in +
                          E01STDANV') TOUSR(*SYSOPR)
/*****************************************************************/
/************               STEP 4                ****************/
/************        MCFPCS1700  MVALIDPLTDATA    ****************/
/************  A) DELETE LOGICAL FILES            ****************/
/************  B) CREATE DUP OBJ OF PHYSICAL      ****************/
/************  C) DELETE PHYSICAL FILE            ****************/
/************  D) CREATE PHYSICAL FILE            ****************/
/************  E) COPY DUP OBJ INTO NEW PHYSICAL  ****************/
/************  F) CREATE LOGICAL FILES            ****************/
/************  G) DELETE DUP OBJ OF PHYSICAL      ****************/
/*****************************************************************/
/* STEP 4A */
             DLTF       FILE(MCPRD1/MCFLCS1701)
             MONMSG     MSGID(CPF2105)
/* STEP 4B */
             CRTDUPOBJ  OBJ(MCFPCS1700) FROMLIB(MCPRD1) +
                          OBJTYPE(*FILE) TOLIB(MCPRD1) +
                          NEWOBJ(MCFPCS170T) DATA(*YES)
/* STEP 4C */
             DLTF       FILE(MCPRD1/MCFPCS1700)
             MONMSG     MSGID(CPF2105)
/* STEP 4D */
             CRTPF      FILE(MCPRD1/MCFPCS1700) +
                          SRCFILE(*LIBL/QDDSSRCDB) +
                          SRCMBR(MCFPCS1700) TEXT('MVALIDPLTDATA    +
                          Physical File') SIZE(*NOMAX)
/* STEP 4E */
             CPYF       FROMFILE(MCPRD1/MCFPCS170T) +
                          TOFILE(MCPRD1/MCFPCS1700) MBROPT(*ADD) +
                          FMTOPT(*NOCHK)
/* STEP 4F */
             CRTLF      FILE(MCPRD1/MCFLCS1701) +
                          SRCFILE(*LIBL/QDDSSRCDB) +
                          SRCMBR(MCFLCS1701) TEXT('MVALIDPLTDATA    +
                          Logical File (VALDTAKEY)')
/* STEP 4G */
             DLTF       FILE(MCPRD1/MCFPCS170T)
             MONMSG     MSGID(CPF2105)
             SNDMSG     MSG('Step 4 of 4 has COMPLETED NORMALLY in +
                          E01STDANV') TOUSR(*SYSOPR)
/*****************************************************************/
             DSPJOBLOG  OUTPUT(*PRINT)
             SNDMSG     MSG('E01STDANV has ENDED NORMALLY') TOUSR(*SYSOPR)
             ENDPGM
