             PGM        PARM(&JOBNUMBER &JOBUSER &JOBNAME &RETSTAT)
             DCL        VAR(&JOBNUMBER) TYPE(*CHAR) LEN(6)
             DCL        VAR(&JOBNAME) TYPE(*CHAR) LEN(10)
             DCL        VAR(&JOBUSER) TYPE(*CHAR) LEN(10)
             DCL        VAR(&RETSTAT) TYPE(*CHAR) LEN(2)
             CHGVAR VAR(&RETSTAT) VALUE('00')
             IF (&JOBNAME='*') THEN(DO)
                WRKJOB     JOB(*) +
                             OUTPUT(*PRINT) OPTION(*PGMSTK)
                MONMSG  MSGID(CPF0000) EXEC(DO)
                   CHGVAR VAR(&RETSTAT) VALUE('99')
                ENDDO
             ENDDO
             ELSE DO
                WRKJOB     JOB(&JOBNUMBER/&JOBUSER/&JOBNAME) +
                             OUTPUT(*PRINT) OPTION(*PGMSTK)
                MONMSG  MSGID(CPF0000) EXEC(DO)
                   CHGVAR VAR(&RETSTAT) VALUE('99')
                ENDDO
             ENDDO
             ENDPGM
