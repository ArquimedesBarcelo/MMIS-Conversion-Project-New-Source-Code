             PGM        /* Print CSIS/MMIS Error Log in Akron*/

             OVRPRTF    FILE(QSYSPRT) OUTQ(PD01) USRDTA(ERRORRPT)
                        MONMSG MSGID(CPF0000)

             CPYF       FROMFILE(*LIBL/ROUTESLIP) TOFILE(QSYSPRT)
                        MONMSG MSGID(CPF0000)

             ADDLIBLE   LIB(TAATOOL)
                        MONMSG MSGID(CPF0000)

             MOVSPLF    FROMOUTQ(PD01) TOOUTQ(PRT03) FILE(QSYSPRT) +
                          USRDTA(ERRORRPT)
                        MONMSG MSGID(CPF0000)

             MOVSPLF    FROMOUTQ(PD01) TOOUTQ(PRT03) FILE(QPQUPRFIL) +
                          USER(PRINTIT) USRDTA(ERRORRPT) JOB(QPRTJOB)
                        MONMSG MSGID(CPF0000)

             ENDPGM
