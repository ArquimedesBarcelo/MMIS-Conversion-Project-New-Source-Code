             PGM        PARM(&LIB &FILE &MBR &OBJTYP &STATUS)
             DCL        VAR(&LIB) TYPE(*CHAR) LEN(10)
             DCL        VAR(&FILE) TYPE(*CHAR) LEN(10)
             DCL        VAR(&MBR) TYPE(*CHAR) LEN(10)
             DCL        VAR(&OBJTYP) TYPE(*CHAR) LEN(10)
             DCL        VAR(&STATUS) TYPE(*CHAR) LEN(2)
             CHGVAR     VAR(&STATUS) VALUE('00')
             IF (&LIB = '          ') DO
                 CHGVAR VAR(&LIB) VALUE('*LIBL')
                 ENDDO
             IF (&MBR = '          ') DO
                 CHGVAR VAR(&MBR) VALUE('*NONE')
                 ENDDO
             IF (&OBJTYP = '          ') DO
                 CHGVAR VAR(&OBJTYP) VALUE('*FILE')
                 ENDDO
             CHKOBJ     OBJ(&LIB/&FILE) OBJTYPE(&OBJTYP) MBR(&MBR) +
                          AUT(*OBJEXIST)
             MONMSG     MSGID(CPF0000) EXEC(DO)
                   CHGVAR     VAR(&STATUS) VALUE('99')
                   ENDDO
 EOJ:        ENDPGM
