             PGM        PARM(&LIBNAME &SOURCENAME &MEMNAME)
             DCL        VAR(&LIBNAME) TYPE(*CHAR) LEN(10)
             DCL        VAR(&SOURCENAME) TYPE(*CHAR) LEN(10)
             DCL        VAR(&MEMNAME) TYPE(*CHAR) LEN(10)
             RMVM       FILE(&LIBNAME/&SOURCENAME) MBR(&MEMNAME)
             MONMSG     MSGID(CPF0000)
             ENDPGM
