             PGM
             DCL        VAR(&SCOPE)      TYPE(*CHAR) LEN(1)
/*   SETS LOGICAL DATA AREA TO BRING UP THE MANAGER SIGNON    */
/*   CAPABILITIES (JCW'S AS THE HP SYSTEM)                    */
             CHGDTAARA  DTAARA(*LDA (259 1)) VALUE('1')
             CHGDTAARA  DTAARA(*LDA (260 1)) VALUE('2')
             CHGDTAARA  DTAARA(*LDA (261 1)) VALUE('2')
   /*  SET UP COBOL ERROR HANDLER   */
             CHGVAR     VAR(&SCOPE) VALUE('P')
             CALL       PGM(MCXCBLERR) PARM(&SCOPE)
             MONMSG     MSGID(CPF0000)
             CALL TEXECPLN
/*           CHGDTAARA  DTAARA(*LDA (259 3)) VALUE('   ')     */
             ENDPGM
