/********************************************************************/
/* SEND FILE SWDATAFL TO SAPCOMM USING PGM CMX0510F.                */
/* THE MEMBER OF SWDATAFL TO BE SENT WILL BE A PASSED PARAMETER.    */
/* (CALLED BY PGM "SSUBCRWS")                                       */
/********************************************************************/
/*     WHEN INSTALLED IN A NEW PLANT:                               */
/*       - CHANGE P1SNDL PARAMETER TO CORRECT CSIS/MMIS LIBRARY.    */
/*       - CHANGE P1LOCC TO CORRECT PLANT ID NUMBER.                */
/********************************************************************/
             PGM PARM(&MBRIN)
             DCL        VAR(&RTNCODE) TYPE(*CHAR) LEN(2)
             DCL        VAR(&P1KEY) TYPE(*CHAR) LEN(10)
             DCL        VAR(&P1LOCC) TYPE(*CHAR) LEN(4)
             DCL        VAR(&MBRIN) TYPE(*CHAR) LEN(10)
             DCL        VAR(&P1SNDF) TYPE(*CHAR) LEN(10)
             DCL        VAR(&P1SNDL) TYPE(*CHAR) LEN(10)
             ADDLIBLE   LIB(CMPRD)
             CHGVAR     VAR(&P1KEY) VALUE('MMSRSV     ')
             CHGVAR     VAR(&P1LOCC) VALUE('N504')
             CHGVAR     VAR(&P1SNDF) VALUE('SWDATAFL  ')
             CHGVAR     VAR(&P1SNDL) VALUE('MCPRD1    ')
/*           CALL       PGM(CMPRD/CMX0510F) PARM(&RTNCODE &P1KEY +  */
/*                        &P1LOCC &MBRIN &P1SNDF &P1SNDL)           */
/*           IF         COND(&RTNCODE *NE '00') THEN(DO)            */
/*               GOTO       CMDLBL(FINI)                            */
/*           ENDDO                                                  */
             RMVLIBLE   LIB(CMPRD)
FINI:
             ENDPGM
