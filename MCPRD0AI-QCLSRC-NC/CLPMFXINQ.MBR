PGM PARM(&DBPARMS)
             DCL        VAR(&DBPARMS) TYPE(*CHAR) LEN(100)
             CHKOBJ     OBJ(QTEMP/PMFXINQ) OBJTYPE(*FILE)
             MONMSG     MSGID(CPF9800) EXEC(DO)
             CRTPF      FILE(QTEMP/PMFXINQ) RCDLEN(26)
             ENDDO
             CLRPFM     FILE(QTEMP/PMFXINQ)
             OVRDBF     FILE(PMFXINQ) TOFILE(QTEMP/PMFXINQ)
             CALL       PGM(*LIBL/SPMFXINQ) PARM(&DBPARMS)
             DLTOVR     FILE(PMFXINQ)
             ENDPGM
