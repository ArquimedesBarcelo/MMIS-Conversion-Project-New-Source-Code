             PGM        /* CLPAVRPTD */

             OVRDBF     FILE(PRTPAVRPT) TOFILE(MCPRD0/QRJEJCL) +
                          MBR(PRTPAVRPT)
             OVRDBF     FILE(PRTPAVRPTD) TOFILE(MCPRD0/QRJEJCL) +
                          MBR(PRTPAVRPTD)

             CALL       PGM(TPAVRPTD)

             DLTOVR     FILE(PRTPAVRPT)
             DLTOVR     FILE(PRTPAVRPTD)

             STRDBRDR   FILE(MCPRD1/QJOBSRC) MBR(BXPAVRPTD)

             ENDPGM
