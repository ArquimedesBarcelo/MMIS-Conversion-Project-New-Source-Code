             PGM        PARM(&MSG &USER)
/*********************************************************************/
/*** MCXSNDMSG                                                     ***/
/***   THIS PROGRAM WILL SEND A MESSAGE (&MSG) TO THE USER PROFILE ***/
/***   &USER.                                                      ***/
/*********************************************************************/
             DCL        VAR(&MSG) TYPE(*CHAR) LEN(512)
             DCL        VAR(&USER) TYPE(*CHAR) LEN(10)

             SNDUSRMSG  MSG(&MSG) MSGTYPE(*INFO) TOUSR(&USER)
             MONMSG     MSGID(CPF0000)
 FINI:
             ENDPGM
