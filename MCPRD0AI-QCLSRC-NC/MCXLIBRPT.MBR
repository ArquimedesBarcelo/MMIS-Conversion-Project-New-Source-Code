             PGM        PARM(&PASSEDLIB)
             DCL        VAR(&PASSEDLIB) TYPE(*CHAR) LEN(10)
             DSPOBJD    OBJ(&PASSEDLIB/*ALL) OBJTYPE(*ALL) +
                          DETAIL(*FULL) OUTPUT(*OUTFILE) +
                          OUTFILE(MCPRD/MCFPLIBRPT)
             RUNQRY     QRY(MCQLIBRPT)
             ENDPGM
