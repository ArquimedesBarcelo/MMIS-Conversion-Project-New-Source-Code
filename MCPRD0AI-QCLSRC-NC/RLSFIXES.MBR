             PGM        PARM(&RLSE &OPTION &DSPOPT)
             DCL        VAR(&RLSE)   TYPE(*CHAR) LEN(3)
             DCL        VAR(&OPTION) TYPE(*CHAR) LEN(1)
             DCL        VAR(&DSPOPT) TYPE(*CHAR) LEN(8)
             DCL        VAR(&RELEASE) TYPE(*CHAR) LEN(8)

             CHGVAR     VAR(&RELEASE) VALUE(&rlse *cat 'FIXES')

             IF         COND(&OPTION *EQ 'D') THEN(DO)
                        RUNQRY     QRY(*NONE) QRYFILE((MCPRD1/&RELEASE)) +
                          OUTTYPE(&DSPOPT)
                        MONMSG     MSGID(QRY1012) +
                          EXEC(SNDPGMMSG MSG('INVALID RELEASE NUMBER'))
                        GOTO CMDLBL(EOJ)
             ENDDO
             IF         COND(&OPTION *EQ 'C') THEN(DO)
                        STRDFU OPTION(1 1) DFUPGM(MCPRD0/RLSFIXESD) +
                               FILE(MCPRD1/&RELEASE) MBR(*FIRST)
                        MONMSG MSGID(DFU0635 DFU0630) +
                          EXEC(SNDPGMMSG MSG('INVALID RELEASE NUMBER'))
                        GOTO CMDLBL(EOJ)
             ENDDO
             SNDPGMMSG  MSG('INVALID OPTION SELECTED')

 EOJ:        ENDPGM
