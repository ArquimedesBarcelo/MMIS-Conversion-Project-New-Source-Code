             PGM  PARM(&FILE &FLIB &TLIB)
             DCL  VAR(&FILE)     TYPE(*CHAR) LEN(10)
             DCL  VAR(&FLIB)     TYPE(*CHAR) LEN(10)
             DCL  VAR(&TLIB)     TYPE(*CHAR) LEN(10)
             DCL  VAR(&MSGID)    TYPE(*CHAR) LEN(7)
             DCL  VAR(&MSGF)     TYPE(*CHAR) LEN(10)
             DCL  VAR(&MSGFLIB)   TYPE(*CHAR) LEN(10)
             DCL  VAR(&MSGDTA)    TYPE(*CHAR) LEN(80)
             MONMSG MSGID(CPF0000 MCH0000) EXEC(GOTO CPFERROR)
             CHKOBJ     OBJ(&FILE.&TLIB) OBJTYPE(*FILE) AUT(*OPER +
                          *OBJMGT *OBJEXIST *READ *ADD *UPD *DLT)
             CHKOBJ     OBJ(&FILE.&FLIB) OBJTYPE(*FILE) AUT(*OPER +
                          *READ)
             MONMSG     MSGID(CPF9800) EXEC(DO)
             CRTDUPOBJ  OBJ(&FILE) FROMLIB(&TLIB) OBJTYPE(*FILE) +
                          TOLIB(&FLIB)
             ENDDO
             DSPFFD     FILE(&FILE.&TLIB) OUTPUT(*NONE) +
                          OUTFILE(QADSPFFD.QTEMP)
             OVRDBF FILE(INPUT) TOFILE(&FILE.&FLIB)
             OVRDBF FILE(OUTPUT) TOFILE(&FILE.&TLIB)
             OVRDBF FILE(QADSPFFD) TOFILE(QADSPFFD.QTEMP)
             CALL UTCASCII2
             DLTOVR FILE(*ALL)
             RETURN
CPFERROR:
             RCVMSG     MSGTYPE(*EXCP) MSGDTA(&MSGDTA) MSGID(&MSGID) +
                          MSGF(&MSGF) MSGFLIB(&MSGFLIB)
             SNDPGMMSG  MSGID(&MSGID) MSGF(&MSGF.&MSGFLIB) +
                          MSGDTA(&MSGDTA)
             MONMSG MSGID(CPF0000)
             ENDPGM
