PGM PARM(&DBPARMS &VPARMS &CPARMS)
             DCL        VAR(&DBPARMS) TYPE(*CHAR) LEN(100)
             DCL        VAR(&VPARMS)  TYPE(*CHAR) LEN(120)
             DCL        VAR(&CPARMS)  TYPE(*CHAR) LEN(120)
             CHKOBJ     OBJ(QTEMP/ILFILE) OBJTYPE(*FILE)
             MONMSG     MSGID(CPF9800) EXEC(DO)
             CRTPF      FILE(QTEMP/ILFILE) RCDLEN(70)
             ENDDO
             CHKOBJ     OBJ(QTEMP/SMFILE) OBJTYPE(*FILE)
             MONMSG     MSGID(CPF9800) EXEC(DO)
             CRTPF      FILE(QTEMP/SMFILE) RCDLEN(70)
             ENDDO
             CHKOBJ     OBJ(QTEMP/OUTFILQ6) OBJTYPE(*FILE)
             MONMSG     MSGID(CPF9800) EXEC(DO)
             CRTPF      FILE(QTEMP/OUTFILQ6) RCDLEN(70)
             ENDDO
             CLRPFM     FILE(QTEMP/ILFILE)
             OVRDBF     FILE(ILFILE) TOFILE(QTEMP/ILFILE)
             CLRPFM     FILE(QTEMP/SMFILE)
             OVRDBF     FILE(SMFILE) TOFILE(QTEMP/SMFILE)
             CLRPFM     FILE(QTEMP/OUTFILQ6)
             OVRDBF     FILE(OUTFILQ6) TOFILE(QTEMP/OUTFILQ6)
             CALL       PGM(*LIBL/TQ6SUB) +
                        PARM(&DBPARMS &VPARMS &CPARMS)
             DLTOVR     FILE(ILFILE)
             DLTOVR     FILE(SMFILE)
             DLTOVR     FILE(OUTFILQ6)
             ENDPGM
