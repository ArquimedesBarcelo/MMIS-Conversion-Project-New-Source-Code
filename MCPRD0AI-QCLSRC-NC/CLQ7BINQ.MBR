PGM PARM(&DBPARMS &VPARMS &CPARMS)
             DCL        VAR(&DBPARMS) TYPE(*CHAR) LEN(100)
             DCL        VAR(&VPARMS)  TYPE(*CHAR) LEN(120)
             DCL        VAR(&CPARMS)  TYPE(*CHAR) LEN(120)
             CHKOBJ     OBJ(QTEMP/OUTFIQ7B) OBJTYPE(*FILE)
             MONMSG     MSGID(CPF9800) EXEC(DO)
             CRTPF      FILE(QTEMP/OUTFIQ7B) RCDLEN(70)
             ENDDO
             CLRPFM     FILE(QTEMP/OUTFIQ7B)
             OVRDBF     FILE(OUTFIQ7B) TOFILE(QTEMP/OUTFIQ7B)
             CALL       PGM(*LIBL/TQ7SUBB) +
                        PARM(&DBPARMS &VPARMS &CPARMS)
             DLTOVR     FILE(OUTFIQ7B)
             ENDPGM
