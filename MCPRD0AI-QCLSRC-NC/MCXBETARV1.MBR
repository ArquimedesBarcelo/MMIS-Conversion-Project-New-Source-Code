             PGM
/*****************************************************************/
/***                                                           ***/
/*** PROGRAM: MCXBETARV1                                       ***/
/*** PURPOSE: TO REVIEW THE MCTST LIBRARY PREVIOUS TO CUTTING  ***/
/***          A RELEASE TO MCBETA.  THIS PROGRAM WILL PRODUCE  ***/
/***          LISTINGS OF MEMBERS OF QLBLSRC, QCLSRC AND       ***/
/***          AND QDDSSRC IN MCTST AND AN OBJECT LISTING OF    ***/
/***          *PGM & *FILE IN MCTST.  IN ADDITION A LISTING    ***/
/***          MEMBERS THAT DO NOT HAVE AN ASSOCIATED OBJECT    ***/
/***          AND A LISTING OF OBJECTS THAT DO NOT HAVE AN     ***/
/***          ASSOCIATED SOURCE MEMBER.                        ***/
/***                                                           ***/
/***          THIS PROGRAM SHOULD BE RUN MULTIPLE TIMES PRIOR  ***/
/***          TO RUNNING MCXBETA.  THE LISTINGS SHOULD BE      ***/
/***          ROUTED THROUGH THE SECTION AND ALL ITEMS         ***/
/***          RESOLVED BEFORE CONTINUING.                      ***/
/***                                                           ***/
/*****************************************************************/
             OVRPRTF    FILE(QSYSPRT) PRTTXT('MCTST REVIEW FOR +
                          BETA RELEASE') OUTQ(PRT03)
             CPYF       FROMFILE(*LIBL/ROUTESLIP) TOFILE(QSYSPRT)
                        MONMSG MSGID(CPF0000)
             OVRPRTF    FILE(QSYSPRT) PRTTXT('MCTST Source Mbr +
                          Listing') OUTQ(PRT03)
 SRCLST:     PRTSRCSUM  SRCFILE(QLBLSRC QCLSRC QDDSSRC) LIB(MCTST) +
                          PRTFILE(QSYSPRT) OUTLIB(QTEMP)
             OVRPRTF    FILE(QPRTOBJD) PRTTXT('MCTST *PGM/*FILE Obj +
                          Listing') OUTQ(PRT03)
 OBJLST:     DSPOBJD    OBJ(MCTST/*ALL) OBJTYPE(*PGM *FILE) +
                          OUTPUT(*PRINT)
             DSPOBJD    OBJ(MCTST/*ALL) OBJTYPE(*PGM *FILE) +
                          OUTPUT(*OUTFILE) OUTFILE(QTEMP/MCTSTOBJ)
             OVRPRTF    FILE(QSYSPRT) PRTTXT('MCTST Source without +
                          Objects') OUTQ(PRT03)
 NOOBJ:      RUNSQL     REQUEST('select msfile, msmbr, mstext from +
                          qtemp/srcsump where msmbr not in (select +
                          odobnm from qtemp/mctstobj)') OUTPUT(*PRINT)
             OVRPRTF    FILE(QSYSPRT) PRTTXT('MCTST Objects without +
                          Source') OUTQ(PRT03)
 NOSRC:      RUNSQL     REQUEST('select odobnm, odobtp, odsrcl, +
                          odsrcf, odsrcm, odcrtu, odobtx     from +
                          qtemp/mctstobj where odobnm not in      +
                          (select msmbr from qtemp/srcsump)') +
                          OUTPUT(*PRINT)
             DLTOVR     FILE(QSYSPRT)
             DLTOVR     FILE(QPRTOBJD)
ENDPGM:
             ENDPGM
