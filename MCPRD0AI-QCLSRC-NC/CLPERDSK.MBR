PGM PARM(&DBPARMS &VPARMS &PLTIDT &PV &SVINDX)
             DCL        VAR(&DBPARMS) TYPE(*CHAR) LEN(100)
             DCL        VAR(&VPARMS)  TYPE(*CHAR) LEN(120)
             DCL        VAR(&PLTIDT)  TYPE(*CHAR) LEN(4)
             DCL        VAR(&PV)      TYPE(*CHAR) LEN(1)
             DCL        VAR(&SVINDX)  TYPE(*CHAR) LEN(2)
             CALL       PGM(*LIBL/TPPRNT) +
                        PARM(&DBPARMS &VPARMS &PLTIDT &PV &SVINDX)
             ENDPGM
