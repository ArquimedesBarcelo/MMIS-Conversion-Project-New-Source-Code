PGM PARM(&INDATE &OUTDATE)
             DCL        VAR(&INDATE)   TYPE(*CHAR)  LEN(6)
             DCL        VAR(&OUTDATE)  TYPE(*CHAR)  LEN(5)
             DCL        VAR(&INFORM)   TYPE(*CHAR)  LEN(7)  VALUE(*YMD)
             DCL        VAR(&OUTFORM)  TYPE(*CHAR)  LEN(7)  VALUE(*JUL)
             DCL        VAR(&SEPS)     TYPE(*CHAR)  LEN(7)  VALUE(*NONE)
             CVTDAT     DATE(&INDATE) TOVAR(&OUTDATE) +
                          FROMFMT(&INFORM) TOFMT(&OUTFORM) TOSEP(&SEPS)
             ENDPGM
