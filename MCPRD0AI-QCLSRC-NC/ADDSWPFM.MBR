             PGM        PARM(&SEQ &DATE &TIME &CODE)
             DCL        VAR(&SEQ)  TYPE(*CHAR) LEN(4)
             DCL        VAR(&DATE) TYPE(*CHAR) LEN(8)
             DCL        VAR(&TIME) TYPE(*CHAR) LEN(8)
             DCL        VAR(&CODE) TYPE(*CHAR) LEN(1)
             DCL        VAR(&MBR)  TYPE(*CHAR) LEN(7)
             DCL        VAR(&TEXT) TYPE(*CHAR) LEN(38)

             CHGVAR     VAR(&MBR)  VALUE('SW' *CAT &SEQ)
             CHGVAR     VAR(&TEXT) VALUE('Worksheet' *BCAT &MBR +
                          *BCAT &DATE *BCAT &TIME)

/* CHECK FOR EXISTENCE OF MEMBER                                 */
             CHKOBJ     OBJ(SWDATAFL) OBJTYPE(*FILE) MBR(&MBR)
             MONMSG     MSGID(CPF0000) EXEC(GOTO CMDLBL(ADDMBR))

/* IF MEMBER EXISTS, DELETE IT AND CHECK FOR ERRORS              */
             RMVM       FILE(SWDATAFL) MBR(&MBR)
             MONMSG     MSGID(CPF0000) EXEC(DO)
                 CHGVAR VAR(&CODE) VALUE('1')
                 GOTO CMDLBL(ENDPGM)
             ENDDO

/* ELSE ADD NEW MEMBER                                           */
 ADDMBR:     ADDPFM     FILE(SWDATAFL) MBR(&MBR) TEXT(&TEXT)
             MONMSG     MSGID(CPF0000) EXEC(CHGVAR VAR(&CODE) VALUE('9'))

 ENDPGM:     ENDPGM
