PGM   /*FOTRWMTLRP OPEN DATA FILES AND CALL TRWMTLRP*/
CSISOVR:
             OVRDBF     FILE(MCFLCS0201) SHARE(*YES)
             OVRDBF     FILE(MCFLCS0501) SHARE(*YES)
             OVRDBF     FILE(MCFLCS1001) SHARE(*YES)
             OVRDBF     FILE(MCFLCS1202) SHARE(*YES)
             OVRDBF     FILE(MCFLCS1401) SHARE(*YES)
             OVRDBF     FILE(MCFLCS3101) SHARE(*YES)
             OVRDBF     FILE(MCFLCS3603) SHARE(*YES)
             OVRDBF     FILE(MCFLCSUSAG) SHARE(*YES)
CSISOPN:
             OPNDBF     FILE(MCFLCS0201) OPTION(*ALL)
             OPNDBF     FILE(MCFLCS0501) OPTION(*ALL)
             OPNDBF     FILE(MCFLCS1001) OPTION(*ALL)
             OPNDBF     FILE(MCFLCS1202) OPTION(*ALL)
             OPNDBF     FILE(MCFLCS1401) OPTION(*ALL)
             OPNDBF     FILE(MCFLCS3101) OPTION(*ALL)
             OPNDBF     FILE(MCFLCS3603) OPTION(*ALL)
             OPNDBF     FILE(MCFLCSUSAG) OPTION(*ALL)
CMDCALL:
             CALL       TRWMTLRP
CSISCLS:
             CLOF       OPNID(MCFLCS0201)
             CLOF       OPNID(MCFLCS0501)
             CLOF       OPNID(MCFLCS1001)
             CLOF       OPNID(MCFLCS1202)
             CLOF       OPNID(MCFLCS1401)
             CLOF       OPNID(MCFLCS3101)
             CLOF       OPNID(MCFLCS3603)
             CLOF       OPNID(MCFLCSUSAG)
ENDPGM
