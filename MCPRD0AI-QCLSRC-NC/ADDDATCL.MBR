/*********************************************************************/
/** PROGRAM: ADDDATCL                                              ***/
/**                                                                ***/
/** PURPOSE: ADD/SUBTRACT "DAYS" TO/FROM GIVEN DATE                ***/
/**                                                                ***/
/** CREATED: 12/05/02                                              ***/
/** AUTHOR : DAN RAUCH - EXLTECH,INC                               ***/
/**                                                                ***/
/*********************************************************************/
/** SPECIAL NOTES:                                                 ***/
/*********************************************************************/
             PGM        PARM(&DAYS &RTNDAT &FRMDAT)

             DCL        VAR(&DAYS) TYPE(*DEC) LEN(5 0)
             DCL        VAR(&RTNDAT) TYPE(*CHAR) LEN(10)
             DCL        VAR(&FRMDAT) TYPE(*CHAR) LEN(8)

             MONMSG     MSGID(CPF9898)

             ADDDAT     DAYS(&DAYS) TOVAR(&RTNDAT) DATE(&FRMDAT)

             ENDPGM
