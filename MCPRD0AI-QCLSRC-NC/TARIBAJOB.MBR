/*********************************************************************/
/** PROGRAM: TARIBAJOB                                             ***/
/**                                                                ***/
/** PURPOSE: MONITOR PO'S PUSHED DOWN FROM ARIBA                  ***/
/**                                                                ***/
/** CREATED: 11/20/02                                              ***/
/** AUTHOR : DAN RAUCH - eXLTech, LLC                              ***/
/**                                                                ***/
/*********************************************************************/
/** SPECIAL NOTES:                                                 ***/
/*********************************************************************/
             PGM

             DCL        VAR(&TYPE) TYPE(*CHAR) LEN(1)
             DCL        VAR(&DQNAME) TYPE(*CHAR) LEN(10) +
                          VALUE(TARIBADQ1)
             DCL        VAR(&JOBLIB) TYPE(*CHAR) LEN(10) +
                          VALUE(TARIBALIB)
             DCL        VAR(&DATAQPGM) TYPE(*CHAR) LEN(10) +
                          VALUE(TARIBA01)
             DCL        VAR(&DTAARA1) TYPE(*CHAR) LEN(10) +
                          VALUE(TARIBADA1)
             DCL        VAR(&CRTFLAG) TYPE(*CHAR) LEN(1) +
                          VALUE(N)
             DCL        VAR(&VALUE) TYPE(*CHAR) LEN(80) +
                          VALUE('This Data Area is Locked *EXCL by +
                          Job Taribajob to Monitor Ariba DataQ')


             CHGJOB     LOGCLPGM(*NO)

             ADDLIBLE   LIB(&JOBLIB)
             MONMSG     MSGID(CPF2103)

             CHGLIBL    CURLIB(*CRTDFT)

             RTVJOBA    TYPE(&TYPE)
/*=================================================================**/
/** TRY TO ALLOCATE DATA AREA EXCLUSIVELY, IF THAT FAILS:          **/
/**   CPF2114 OR                                                   **/
/**   CPF1002   ALREADY ALLOCATED, THEN LEAVE PROGRAM              **/
/**                                                                **/
/**   CPF1085 OR                                                   **/
/**   CPF0939 - DATA AREA DOESN'T EXIST, SO CREATE & ALLOCATE IT   **/
/**                                                                **/
/**   CPF0000 - ALLOCATED SUCCESSFULLY, GO TO DATAQ PROCESS        **/
/*=================================================================**/
             ALCOBJ     OBJ((&DTAARA1 *DTAARA *EXCL)) WAIT(0)
             MONMSG     MSGID(CPF2114 CPF1002) EXEC(GOTO CMDLBL(CHGJ))
             MONMSG     MSGID(CPF0939 CPF1085) EXEC(CHGVAR +
                          VAR(&CRTFLAG) VALUE('Y'))

             IF         COND(&CRTFLAG *EQ 'Y') THEN(DO)
             CRTDTAARA  DTAARA(&JOBLIB/&DTAARA1) TYPE(*CHAR) LEN(80)
             CHGDTAARA  DTAARA(&JOBLIB/&DTAARA1 (1 80)) VALUE(&VALUE)
             ALCOBJ     OBJ((&JOBLIB/&DTAARA1 *DTAARA *EXCL)) WAIT(0)
             ENDDO


/*=================================================================**/
/** TRY TO DELETE THE DATAQ, THEN CREATE IT                        **/
/*=================================================================**/
             DLTDTAQ    DTAQ(&JOBLIB/&DQNAME)
             MONMSG     MSGID(CPF0000)

             CRTDTAQ    DTAQ(&JOBLIB/&DQNAME) MAXLEN(80) SEQ(*KEYED) +
                          KEYLEN(30) AUT(*ALL)
             MONMSG     MSGID(CPF0000)

/*=================================================================**/
/** CALL THE DATAQ MONITOR PGM (COBOL)                             **/
/*=================================================================**/
             CALL       PGM(&DATAQPGM)

/*=================================================================**/
/** DELETE THE DATAQ                                               **/
/*=================================================================**/
             DLTDTAQ    DTAQ(&JOBLIB/&DQNAME)
             MONMSG     MSGID(CPF0000)

/*=================================================================**/
/** DEALLOCATE THE DATA AREA                                       **/
/*=================================================================**/
             DLCOBJ     OBJ((&JOBLIB/&DTAARA1 *DTAARA *EXCL))
             MONMSG     MSGID(CPF0000)

             DLTDTAARA  DTAARA(&JOBLIB/&DTAARA1)
             GOTO       CMDLBL(ENDIT)
CHGJ:
/*=================================================================**/
/** IF THIS JOB WAS SUBMITTED AS BATCH, THE DON'T GENERATE JOBLOG  **/
/*=================================================================**/
             IF         COND(&TYPE *EQ '0') THEN(DO)
             CHGJOB     LOG(0 00 *NOLIST)
             ENDDO

ENDIT:       ENDPGM
