/*********************************************************************/
/** PROGRAM: TARIBAM00C                                             **/
/**                                                                 **/
/** PURPOSE: RUN TARIBAM00                                          **/
/**          MENU OF OPTIONS FOR MONITOR PROCESS                    **/
/**                                                                 **/
/** CREATED: 01/31/2003                                             **/
/** AUTHOR : DAN RAUCH - eXLTech, LLC                               **/
/**                                                                 **/
/*********************************************************************/
/** SPECIAL NOTES:                                                 ***/
/*********************************************************************/
PGM
             DCL        VAR(&LIB) TYPE(*CHAR) LEN(10)
             DCL        VAR(&CRTDFT) TYPE(*CHAR) LEN(10) VALUE(*CRTDFT)
             DCL        VAR(&NONE) TYPE(*CHAR) LEN(10) VALUE(*NONE)

             RTVJOBA    CURLIB(&LIB)
             IF COND(&LIB *NE &CRTDFT) THEN(DO)
                IF  COND(&LIB *NE &NONE) THEN(DO)
                    CHGLIBL    CURLIB(*CRTDFT)
                ENDDO
             ENDDO

             CALL       PGM(TARIBAM00)

             IF COND(&LIB *NE &CRTDFT) THEN(DO)
                IF  COND(&LIB *NE &NONE) THEN(DO)
                     CHGLIBL    CURLIB(&LIB)
                ENDDO
             ENDDO

ENDPGM
