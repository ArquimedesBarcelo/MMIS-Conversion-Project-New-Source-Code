             /***************************************************/
             /* PROGRAM: UTX7000                                */
             /* AUTHOR:  J M ONEIL                              */
             /* DATE:    07/12/85                               */
             /* PURPOSE: PRODUCE DB PHYSICAL FILE FROM RJE      */
             /*           PUNCHED OUTPUT                        */
             /*  ****** MODIFIED 19 DEC 89 BY C.HILLES: SPECIAL */
             /*  MANUAL VERSION TO BE USED WHEN AUTOMATIC VER.  */
             /* (CALLED AUTOMATICALLY OUT OF FORM CONTROL TABLE */
             /* FORM "DTAT") DOES NOT WORK.  YOU MUST CALL THE  */
             /* PROGRAM WITH A PARAMETER OF THE CORRECT BDTAT   */
             /* FILE: IE: CALL UTX7000M PARM(BDTAT002)          */
             /*                                                 */
             /*                                                 */
             /***************************************************/
             PGM        PARM(&DTATFIL)
             DCL  VAR(&DTATFIL) TYPE(*CHAR) LEN(10)
             DCL  VAR(&PARMS)  TYPE(*CHAR) LEN(30)
             DCL  VAR(&LIBIN)  TYPE(*CHAR) LEN(10)
             DCL  VAR(&FILIN)  TYPE(*CHAR) LEN(10)
             DCL  VAR(&MEMIN)  TYPE(*CHAR) LEN(10)
             DCL  VAR(&LIBOUT) TYPE(*CHAR) LEN(10)
             DCL  VAR(&FILOUT) TYPE(*CHAR) LEN(10)
             DCL  VAR(&MEMOUT) TYPE(*CHAR) LEN(10)
             DCL  VAR(&RECLEN) TYPE(*DEC)  LEN(5 0)
             DCL  VAR(&TYPOUT) TYPE(*CHAR) LEN(10)
             DCL  VAR(&JOBNAM) TYPE(*CHAR) LEN(10)
             DCL  VAR(&RECSTR) TYPE(*CHAR) LEN(9)
             DCL  VAR(&RECEND) TYPE(*CHAR) LEN(9)
             DCL  VAR(&RCODE)  TYPE(*DEC)  LEN(5 0)
             DCL  VAR(&MSGDTA) TYPE(*CHAR) LEN(80)
             DCL  VAR(&MSGID)  TYPE(*CHAR) LEN(7)
             DCL  VAR(&MSGF)   TYPE(*CHAR) LEN(10)
             DCL  VAR(&MSGFLIB) TYPE(*CHAR) LEN(10)
             DCL  VAR(&MSGQ)   TYPE(*CHAR) LEN(10)
             DCL  VAR(&MSGQLIB) TYPE(*CHAR) LEN(10)
             DCL  VAR(&RECIN)  TYPE(*CHAR) LEN(8) VALUE('00000000')
             DCL  VAR(&RECOUT) TYPE(*CHAR) LEN(8) VALUE('00000000')
             DCL  VAR(&DTYPE)  TYPE(*CHAR) LEN(1)
             DCL  VAR(&MAXRL)  TYPE(*DEC)  LEN(5 0)
             DCL  VAR(&MBROPT) TYPE(*CHAR) LEN(8) VALUE('*REPLACE')
             DCLDTAARA DTAARA(UTDA7000)
/* GET TRANSFER FILE IN CARD IMAGE USING RJE WRITER UTILITY */
/*           CALL       PGM(QMRSWTR) PARM(&PARMS)  */
/* GET CARD IMAGE FILE, LIBRARY & MEMBER NAME */
/*  ******** CHANGE THE FOLLOWING LINES FOR THE SPECIFIC FILE */
/*  ******** YOU WANT TO GET: THE BDTAT FILE HAS THE DEST FILE INFO */
             CHGVAR     VAR(&LIBIN) VALUE('QRJE')
             CHGVAR     VAR(&FILIN) VALUE('Q01PFPU1')
             CHGVAR     VAR(&MEMIN) VALUE(&DTATFIL)
/* CHANGE LOCAL DATA AREA TO PARMS FROM QMRSWTR */
             CHGDTAARA  DTAARA(*LDA) VALUE(&PARMS)
/* GET MESSAGE QUEUE */
             RCVDTAARA DTAARA(UTDA7000)
             CHGVAR VAR(&MSGQ) VALUE(%SST(&UTDA7000 1 10))
             CHGVAR VAR(&MSGQLIB) VALUE(%SST(&UTDA7000 11 10))
/* VERIFY MESSAGE QUEUE EXISTS AND AUTHORITY */
             CHKOBJ     OBJ(&MSGQ.&MSGQLIB) OBJTYPE(*MSGQ) AUT(*OPER +
                          *ADD)
             MONMSG     MSGID(CPF9800) EXEC(DO)
             RCVMSG     MSGTYPE(*EXCP) MSGDTA(&MSGDTA) MSGID(&MSGID) +
                          MSGF(&MSGF) MSGFLIB(&MSGFLIB)
             SNDPGMMSG  MSGID(&MSGID) MSGF(&MSGF.&MSGFLIB) +
                          MSGDTA(&MSGDTA) TOMSGQ(&MSGQ.&MSGQLIB)
             GOTO ERRMSG
             ENDDO
/* VERIFY CONTROL CARDS */
             OVRDBF     FILE(UTFPRJEI) TOFILE(&FILIN.&LIBIN) +
                          MBR(&MEMIN) POSITION(*START)
             CALL       PGM(UTC7000I) PARM(&LIBOUT &FILOUT &MEMOUT +
                        &RECLEN &TYPOUT &JOBNAM &RECSTR &RECEND &RCODE)
             DLTOVR     FILE(*ALL)
/* ERROR ? */
             IF (&RCODE *NE 0) THEN(DO)
             CHGVAR VAR(&MSGDTA) VALUE('Error Occured Processing +
                RJE Input Card Transfer File' +
                *BCAT &FILIN *TCAT '.' *TCAT &LIBIN +
                *BCAT 'MEMBER ' *BCAT &MEMIN)
             SNDMSG MSG(&MSGDTA) TOMSGQ(&MSGQ.&MSGQLIB)
             IF (&RCODE *EQ 1) THEN(DO)
                CHGVAR VAR(&MSGDTA) VALUE('Unable to Open File ' +
                  *BCAT &FILIN *TCAT '.' *TCAT &LIBIN +
                  *BCAT 'Member ' *BCAT &MEMIN)
                SNDMSG     MSG(&MSGDTA) TOMSGQ(&MSGQ.&MSGQLIB)
                GOTO ERRMSG
             ENDDO
             IF (&RCODE *EQ 2) THEN(DO)
                CHGVAR VAR(&MSGDTA) VALUE('Eof on File ' *BCAT &FILIN +
                  *TCAT '.' *TCAT &LIBIN *BCAT 'MEMBER ' +
                  *BCAT &MEMIN *BCAT 'Control Cards Not Found')
                SNDMSG MSG(&MSGDTA) TOMSGQ(&MSGQ.&MSGQLIB)
                GOTO ERRMSG
             ENDDO
             IF (&RCODE *EQ 3) THEN(DO)
                CHGVAR VAR(&MSGDTA) VALUE('Error On Read To File ' +
                  *BCAT &FILIN *TCAT '.' *TCAT &LIBIN +
                  *BCAT 'Member ' *BCAT &MEMIN)
                 SNDMSG MSG(&MSGDTA) TOMSGQ(&MSGQ.&MSGQLIB)
                GOTO ERRMSG
             ENDDO
             CHGVAR VAR(&MSGDTA) VALUE('Unknown Error On File ' +
                *BCAT &FILIN *TCAT '.' *TCAT &LIBIN +
                *BCAT 'MEMBER ' *BCAT &MEMIN)
             SNDMSG MSG(&MSGDTA) TOMSGQ(&MSGQ.&MSGQLIB)
             GOTO ERRMSG
             ENDDO
/* CHECK TRANSFER FILE MEMBER EXISTENCE AND AUTHORITY */
             CHKOBJ     OBJ(&FILOUT.&LIBOUT) OBJTYPE(*FILE) +
                          MBR(&MEMOUT) AUT(*OPER *OBJMGT *READ *ADD +
                          *UPD *DLT)
             MONMSG     MSGID(CPF9800) EXEC(DO)
             RCVMSG     MSGTYPE(*EXCP) MSGDTA(&MSGDTA) MSGID(&MSGID) +
                          MSGF(&MSGF) MSGFLIB(&MSGFLIB)
             IF (&MSGID *NE 'CPF9815') DO
                SNDPGMMSG  MSGID(&MSGID) MSGF(&MSGF.&MSGFLIB) +
                           MSGDTA(&MSGDTA) TOMSGQ(&MSGQ.&MSGQLIB)
                GOTO ERRMSG
             ENDDO
             CHGVAR VAR(&MBROPT) VALUE('*ADD')
             ENDDO
/* DISPLAY FILE DESCRIPTION */
             DSPFD      FILE(&FILOUT.&LIBOUT) TYPE(*ATR) +
                          OUTPUT(*NONE) FILEATR(*PHY) +
                          OUTFILE(UTFPRJED.QTEMP)
             MONMSG     MSGID(CPF3000 CPF9800) EXEC(DO)
              RCVMSG     MSGTYPE(*EXCP) MSGDTA(&MSGDTA) MSGID(&MSGID) +
                          MSGF(&MSGF) MSGFLIB(&MSGFLIB)
              SNDPGMMSG  MSGID(&MSGID) MSGF(&MSGF.&MSGFLIB) +
                          MSGDTA(&MSGDTA) TOMSGQ(&MSGQ.&MSGQLIB)
              GOTO ERRMSG
             ENDDO
/* GET TRANSFER OUTPUT FILE DESCRIPTION */
             OVRDBF     FILE(UTFPRJED) TOFILE(UTFPRJED.QTEMP)
             CALL       PGM(UTC7000D) PARM(&DTYPE &MAXRL)
             DLTOVR     FILE(*ALL)
/* SOURCE TRANSFER */
             IF (&TYPOUT *EQ '*SOURCE') DO
                IF (&DTYPE *EQ 'S') DO
                   GOTO SRCCPY
                ENDDO
                ELSE DO
                  CHGVAR VAR(&MSGDTA) VALUE('File ' *BCAT &FILOUT +
                    *TCAT '.' *TCAT &LIBOUT *BCAT 'is Not a Source +
                    File, Data Received Specified *SOURCE')
                  SNDMSG MSG(&MSGDTA) TOMSGQ(&MSGQ.&MSGQLIB)
                  GOTO ERRMSG
                ENDDO
             ENDDO
             IF (&DTYPE *EQ 'S') DO
                IF (&RECLEN *EQ 80) DO
                   GOTO SRCCPY
                ENDDO
                ELSE DO
                  CHGVAR VAR(&MSGDTA) VALUE('File ' *BCAT &FILOUT +
                    *TCAT '.' *TCAT &LIBOUT *BCAT 'is a Source File, +
                    Data Received is Not 80 Byte Records')
                  SNDMSG MSG(&MSGDTA) TOMSGQ(&MSGQ.&MSGQLIB)
                  GOTO ERRMSG
                ENDDO
             ENDDO
/* DATA FILE TRANSFER MEMBER EXISTS ? */
             IF (&MBROPT *EQ '*ADD') DO
                CHGVAR VAR(&MSGDTA) VALUE('Member ' *BCAT &MEMOUT +
                       *BCAT 'of File ' *BCAT &FILOUT +
                       *TCAT '.' *TCAT &LIBIN *BCAT 'Not Found')
                SNDMSG MSG(&MSGDTA) TOMSGQ(&MSGQ.&MSGQLIB)
                GOTO ERRMSG
             ENDDO
/* ALLOCATE TRANSFER OUTPUT FILE EXCLUSIVE */
             ALCOBJ     OBJ((&FILOUT.&LIBOUT *FILE *EXCL &MEMOUT)) +
                          WAIT(60)
             MONMSG     MSGID(CPF1000) EXEC(DO)
             RCVMSG     MSGTYPE(*EXCP) MSGDTA(&MSGDTA) MSGID(&MSGID) +
                          MSGF(&MSGF) MSGFLIB(&MSGFLIB)
             SNDPGMMSG  MSGID(&MSGID) MSGF(&MSGF.&MSGFLIB) +
                          MSGDTA(&MSGDTA) TOMSGQ(&MSGQ.&MSGQLIB)
             GOTO ERRMSG
             ENDDO
/* TRANSFER CARD FILE IMAGE TO OUTPUT FILE IMAGE */
             OVRDBF     FILE(UTFPRJEI) TOFILE(&FILIN.&LIBIN) +
                          MBR(&MEMIN) POSITION(*START)
             OVRDBF     FILE(UTFPRJEO) TOFILE(&FILOUT.&LIBOUT) +
                          MBR(&MEMOUT) POSITION(*START)
             CALL       PGM(UTC7000O) PARM(&MAXRL &RECLEN &RECIN +
                          &RECOUT &RECSTR &RECEND &RCODE)
             DLTOVR     FILE(*ALL)
             DLCOBJ     OBJ((&FILOUT.&LIBOUT *FILE *EXCL &MEMOUT))
/* ERROR ? */
             IF (&RCODE *EQ 0) THEN(DO)
                CHGVAR VAR(&MSGDTA) VALUE('Records Read - ' *BCAT +
                       &RECIN *BCAT 'Records Written -' *BCAT &RECOUT)
                SNDMSG MSG(&MSGDTA) TOMSGQ(&MSGQ.&MSGQLIB)
                GOTO  ENDCOPY
             ENDDO
             IF (&RCODE *EQ 1) THEN(DO)
               CHGVAR VAR(&MSGDTA) VALUE('Unable To Open Input File ' +
                  *BCAT &FILIN *TCAT '.' *TCAT &LIBIN +
                  *BCAT 'Member ' *BCAT &MEMIN)
               SNDMSG MSG(&MSGDTA) TOMSGQ(&MSGQ.&MSGQLIB)
               GOTO ERRMSG
             ENDDO
             IF (&RCODE *EQ 2) THEN(DO)
              CHGVAR VAR(&MSGDTA) VALUE('Unable To Open Output File ' +
                  *BCAT &FILOUT *TCAT '.' *TCAT &LIBOUT +
                  *BCAT 'MEMBER ' *BCAT &MEMOUT)
               SNDMSG MSG(&MSGDTA) TOMSGQ(&MSGQ.&MSGQLIB)
               GOTO ERRMSG
             ENDDO
             IF (&RCODE *EQ 3) THEN(DO)
               CHGVAR VAR(&MSGDTA) VALUE('File ' *BCAT &FILIN +
                  *TCAT '.' *TCAT &LIBIN *BCAT 'Member ' +
                  *BCAT &MEMIN *BCAT 'Has No Data Records To Copy')
               SNDMSG MSG(&MSGDTA) TOMSGQ(&MSGQ.&MSGQLIB)
               GOTO ERRMSG
             ENDDO
             IF (&RCODE *EQ 4) THEN(DO)
               CHGVAR VAR(&MSGDTA) VALUE('Eof On Read To File ' +
                  *BCAT &FILIN *TCAT '.' *TCAT &LIBIN +
                  *BCAT 'Member ' *BCAT &MEMIN *BCAT +
                  'Before End-Of-Data Record')
               SNDMSG MSG(&MSGDTA) TOMSGQ(&MSGQ.&MSGQLIB)
               GOTO ERRMSG
             ENDDO
             IF (&RCODE *EQ 5) THEN(DO)
               CHGVAR VAR(&MSGDTA) VALUE('Error On Read To File ' +
                  *BCAT &FILIN *TCAT '.' *TCAT &LIBIN +
                  *BCAT 'Member ' *BCAT &MEMIN)
               SNDMSG MSG(&MSGDTA) TOMSGQ(&MSGQ.&MSGQLIB)
               GOTO ERRMSG
             ENDDO
             IF (&RCODE *EQ 6) THEN(DO)
               CHGVAR VAR(&MSGDTA) VALUE('Error On Write To File ' +
                  *BCAT &FILOUT *TCAT '.' *TCAT &LIBOUT +
                  *BCAT 'Member ' *BCAT &MEMOUT)
               SNDMSG MSG(&MSGDTA) TOMSGQ(&MSGQ.&MSGQLIB)
               GOTO ERRMSG
             ENDDO
             CHGVAR VAR(&MSGDTA) VALUE('Unknown Error On File ' +
                *BCAT &FILOUT *TCAT '.' *TCAT &LIBOUT +
                *BCAT 'Member ' *BCAT &MEMOUT)
             SNDMSG MSG(&MSGDTA) TOMSGQ(&MSGQ.&MSGQLIB)
             GOTO ERRMSG
 ERRMSG:     CHGVAR VAR(&MSGDTA) VALUE('Output From Job ' *BCAT +
                &JOBNAM *BCAT 'Written To Input File ' +
                *BCAT &FILIN *TCAT '.' *TCAT &LIBIN +
                *BCAT 'Member ' *BCAT &MEMIN)
             SNDMSG MSG(&MSGDTA) TOMSGQ(&MSGQ.&MSGQLIB)
             GOTO EXIT
 SRCCPY:
             CPYF FROMFILE(&FILIN.&LIBIN) +
                  TOFILE(&FILOUT.&LIBOUT) FROMMBR(&MEMIN) +
                  TOMBR(&MEMOUT) MBROPT(&MBROPT) +
                  FROMRCD(&RECSTR) TORCD(&RECEND) +
                  FMTOPT(*CVTSRC) SRCOPT(*SEQNBR *DATE)
             MONMSG MSGID(CPF2800 CPF2900 CPF3100) EXEC(DO)
               RCVMSG MSGTYPE(*EXCP) MSGDTA(&MSGDTA) MSGID(&MSGID) +
                       MSGF(&MSGF) MSGFLIB(&MSGFLIB)
               SNDPGMMSG  MSGID(&MSGID) MSGF(&MSGF.&MSGFLIB) +
                          MSGDTA(&MSGDTA) TOMSGQ(&MSGQ.&MSGQLIB)
               GOTO ERRMSG
             ENDDO
 ENDCOPY:    CHGVAR VAR(&MSGDTA) VALUE('Output From Job ' *BCAT +
                  &JOBNAM *BCAT 'Written To File ' *BCAT &FILOUT +
                  *TCAT '.' *TCAT &LIBOUT *BCAT 'Member' *BCAT &MEMOUT)
             SNDMSG MSG(&MSGDTA) TOMSGQ(&MSGQ.&MSGQLIB)
             RMVM FILE(&FILIN.&LIBIN) MBR(&MEMIN)
 EXIT:
             ENDPGM
