             PGM        PARM(&FILESPEC &PASSEDLIB)
             DCL        VAR(&FILESPEC) TYPE(*CHAR) LEN(10)
             DCL        VAR(&PASSEDLIB) TYPE(*CHAR) LEN(10)
             DLTF MCFPOBJS
             MONMSG MSGID(CPF0000)
             DSPOBJD    OBJ(&PASSEDLIB/&FILESPEC) OBJTYPE(*ALL) +
                          DETAIL(*SERVICE) OUTPUT(*OUTFILE) +
                          OUTFILE(MCPRD/MCFPOBJS)
             ENDPGM
