         /***********************************************************/
         /*  PGM NAME: MCXRTVDTAA                               *****/
         /*                                                     *****/
         /***********************************************************/
             PGM        PARM(&DTAARA &DATA)

             DCL        VAR(&DTAARA) TYPE(*CHAR) LEN(10)
             DCL        VAR(&DATA)   TYPE(*CHAR) LEN(2000)

             RTVDTAARA  DTAARA(&DTAARA) RTNVAR(&DATA)
             MONMSG     MSGID(CPF1015) EXEC(DO)
                CHGVAR (&DATA) VALUE(' ')
             ENDDO

             ENDPGM
