/*********************************************************************/
/** PROGRAM: RUNSQLCL                                               **/
/**                                                                 **/
/** PURPOSE: EXECUTE RUNSQL COMMAND FROM PASSED REQUEST DATA        **/
/**                                                                 **/
/** CREATED: 03/26/2004                                             **/
/** AUTHOR : DAN RAUCH - EXLTECH,INC                                **/
/**                                                                 **/
/*********************************************************************/
             PGM  (&REQUEST)

             DCL        VAR(&REQUEST) TYPE(*CHAR) LEN(256)

             RUNSQL     REQUEST(&REQUEST)

ENDPGM
