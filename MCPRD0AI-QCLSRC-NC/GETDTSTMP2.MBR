/*********************************************************************/
/** PROGRAM: GETDTSTMP2                                            ***/
/**                                                                ***/
/** PURPOSE: FORMAT CURRENT DATE(W/CENTURY) AND TIME               ***/
/**         (INPUT PARM LENGTH = 30)                               ***/
/**         (POS 1  THRU  14 DATE/TIME STAMP) CCYYMMDDHHMMSS       ***/
/**         (POS 15 THRU  27 HDG DATE)                             ***/
/**         (POS 28 THRU  30 FUTURE USE)                           ***/
/**                                                                ***/
/** CREATED: 10/16/02                                              ***/
/** AUTHOR : DAN RAUCH - EXLTECH,INC                               ***/
/*********************************************************************/
/** SPECIAL NOTES:  USE WITH COPY MEMBER DTSPARMS2                 ***/
/*********************************************************************/
/**                   M O D I F I C A T I O N S                    ***/
/**        ---------------------------------------------------     ***/
/** JUN 21, 2004  D.RAUCH  MODIFIED TO INCLUDE A HEADING DATE      ***/
/*********************************************************************/

             PGM        PARM(&DTSTAMP)
             DCL        VAR(&DTSTAMP) TYPE(*CHAR) LEN(30)
             DCL        VAR(&DTSTAMP2) TYPE(*CHAR) LEN(30) VALUE(' ')
             DCL        VAR(&YEAR)  TYPE(*CHAR) LEN(4)
             DCL        VAR(&MONTH) TYPE(*CHAR) LEN(2)
             DCL        VAR(&DAY)   TYPE(*CHAR) LEN(2)
             DCL        VAR(&HOUR)  TYPE(*CHAR) LEN(2)
             DCL        VAR(&MINUTE) TYPE(*CHAR) LEN(2)
             DCL        VAR(&SECOND) TYPE(*CHAR) LEN(2)
             DCL        VAR(&SECOND) TYPE(*CHAR) LEN(2)

             DCL        VAR(&HDDATE) TYPE(*CHAR) LEN(13)
             DCL        VAR(&MMLIT) TYPE(*CHAR) LEN(4)
             DCL        VAR(&DDLIT) TYPE(*CHAR) LEN(2)
             DCL        VAR(&DAY1)  TYPE(*CHAR) LEN(1)
             DCL        VAR(&DD) TYPE(*DEC) LEN(2)
             DCL        VAR(&MM) TYPE(*DEC) LEN(2)
             DCL        VAR(&POS) TYPE(*DEC) LEN(2)
             DCL        VAR(&LEN) TYPE(*DEC) LEN(2) VALUE(4)

/** MONTH NAME ARRAY - 4 CHAR EACH ***********************************/
             DCL        VAR(&MONLIT) TYPE(*CHAR) LEN(48) +
          VALUE('Jan Feb Mar Apr May JuneJulyAug SeptOct Nov Dec ')

/**GET CENTURY AND YEAR VIA TAATOOLS MODULE **************************/
             TAATOOL/RTVDAT FULLYEAR(&YEAR)

             RTVSYSVAL  SYSVAL(QMONTH)  RTNVAR(&MONTH)
             RTVSYSVAL  SYSVAL(QDAY)    RTNVAR(&DAY)
             RTVSYSVAL  SYSVAL(QHOUR)   RTNVAR(&HOUR)
             RTVSYSVAL  SYSVAL(QMINUTE) RTNVAR(&MINUTE)
             RTVSYSVAL  SYSVAL(QSECOND) RTNVAR(&SECOND)

             CHGVAR     VAR(&DTSTAMP) VALUE(&DTSTAMP2)
/*===================================================================*/
/* POPULATE POSITIONS 1 THRU  14  ===>  CCYYMMDDHHMMSS               */
/*===================================================================*/
             CHGVAR     VAR(%SST(&DTSTAMP  1  4))  VALUE(&YEAR)
             CHGVAR     VAR(%SST(&DTSTAMP  5  2))  VALUE(&MONTH)
             CHGVAR     VAR(%SST(&DTSTAMP  7  2))  VALUE(&DAY)
             CHGVAR     VAR(%SST(&DTSTAMP  9  2))  VALUE(&HOUR)
             CHGVAR     VAR(%SST(&DTSTAMP 11  2))  VALUE(&MINUTE)
             CHGVAR     VAR(%SST(&DTSTAMP 13  2))  VALUE(&SECOND)


/*===================================================================*/
/*=   FORMAT  A HEADING DATE  X(13) -- XXXX DD, CCYY                =*/
/*===================================================================*/
/* POPULATE POSITIONS 15 THRU 27 WITH THE HEADING DATE               */
/* IE: JAN 15, 2004                                                  */
/*===================================================================*/
             CHGVAR     VAR(&MM) VALUE(&MONTH)
             CHGVAR     VAR(&DD) VALUE(&DAY)
             CHGVAR     VAR(&DAY1) VALUE(%SST(&DAY 2 1))

/*===================================================================*/
/* DETERMINE THE START'G POS OF THE MONTH NAME ARRAY ELEMENT         */
/* THEN POPULATE &HDDATE(VIA %SST) WITH MONTH NAME ARRAY ELEMENT     */
/*===================================================================*/
             CHGVAR     VAR(&POS) VALUE((&MM * 4) - 3)
             CHGVAR     VAR(&MMLIT) VALUE(%SST(&MONLIT &POS &LEN))
             CHGVAR     VAR(%SST(&HDDATE  1  4))  VALUE(&MMLIT)

/*===================================================================*/
/* ALLOW FOR 3 OR 4 CHARACTER MONTH NAME                             */
/*   ---> PROCESS 3 CHARACTER MONTH NAME  IE: JAN, FEB, MAR ...ETC  */
/*===================================================================*/
             IF          COND(%SST(&MMLIT 4 1) *EQ ' ') THEN(DO)

/*===================================================================*/
/* ALLOW FOR 1 OR 2 CHARACTER DAY                                    */
/* IF THE DAY > 9 ...THEN FORMAT A DATE WITH A 2 DIGIT DAY           */
/* IE:   JAN 10, 2004                                                */
/*===================================================================*/
             IF         COND(&DD *GT 9) THEN(DO)
             CHGVAR     VAR(%SST(&HDDATE 5 2)) VALUE(&DAY)
             CHGVAR     VAR(%SST(&HDDATE 7 2)) VALUE(', ')
             CHGVAR     VAR(%SST(&HDDATE 9 4)) VALUE(&YEAR)
             ENDDO

/*===================================================================*/
/* IF THE DAY <= 9 ...THEN FORMAT A DATE WITH A SINGLE DIGIT DAY    **/
/* TO EXCLUDE THE LEADING ZERO                                      **/
/* IE:   JAN 9, 2004  - NOT JUNE 09, 2004                           **/
/*===================================================================*/
             IF         COND(&DD *LE 9) THEN(DO)
             CHGVAR     VAR(%SST(&HDDATE 5 1)) VALUE(&DAY1)
             CHGVAR     VAR(%SST(&HDDATE 6 2)) VALUE(', ')
             CHGVAR     VAR(%SST(&HDDATE 8 4)) VALUE(&YEAR)
             ENDDO

             ENDDO


/*=========  E L S E ================================================*/


/*===================================================================*/
/* ALLOW FOR 3 OR 4 CHARACTER MONTH NAME                             */
/*   ---> PROCESS 4 CHARACTER MONTH NAME  IE: SEPT, JUNE ...ETC     */
/*===================================================================*/
             IF          COND(%SST(&MMLIT 4 1) *NE ' ') THEN(DO)

/*===================================================================*/
/* IF THE DAY > 9 ...THEN FORMAT A DATE WITH A 2 DIGIT DAY           */
/* IE:  JUNE 10, 2004                                                */
/*===================================================================*/
             IF         COND(&DD *GT 9) THEN(DO)
             CHGVAR     VAR(%SST(&HDDATE 6 2)) VALUE(&DAY)
             CHGVAR     VAR(%SST(&HDDATE 8 2)) VALUE(', ')
             CHGVAR     VAR(%SST(&HDDATE 10 4)) VALUE(&YEAR)
             ENDDO

/*===================================================================*/
/* IF THE DAY <= 9 ...THEN FORMAT A DATE WITH A SINGLE DIGIT DAY     */
/* (EXCLUDING THE LEADING ZERO)                                     **/
/* IE:  JUNE 9, 2004  - NOT JUNE 09, 2004                            */
/*===================================================================*/
             IF         COND(&DD *LE 9) THEN(DO)
             CHGVAR     VAR(%SST(&HDDATE 6 1)) VALUE(&DAY1)
             CHGVAR     VAR(%SST(&HDDATE 7 2)) VALUE(', ')
             CHGVAR     VAR(%SST(&HDDATE 9 4)) VALUE(&YEAR)
             ENDDO

             ENDDO


/*===================================================================*/
/* UPDATE THE PASSED PARM STRING IN POSITION 15 FOR LENGTH = 13      */
/*===================================================================*/
             CHGVAR     VAR(%SST(&DTSTAMP 15 13))  VALUE(&HDDATE)

ENDPGM
