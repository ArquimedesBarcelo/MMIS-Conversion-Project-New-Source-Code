/*********************************************************************/
/** PROGRAM: TCODEFCL2                                             ***/
/**                                                                ***/
/** PURPOSE: LOAD COMMODITY CODE FILTER TABLE                      ***/
/**                                                                ***/
/** CREATED: 10/25/02                                              ***/
/** AUTHOR : DAN RAUCH - eXLTech, LLC                              ***/
/**                                                                ***/
/*********************************************************************/
/** SPECIAL NOTES:                                                 ***/
/*********************************************************************/
             PGM

             DCL        VAR(&RECORDS) TYPE(*DEC) LEN(10 0)


             CLRPFM     FILE(MCFPAB1000)   /*CLR CODE FILTER FILE*/
             CLRPFM     FILE(MCFPAB0500)   /*CLR JOB TRIGGER FILE*/


/*********************************************************************/
/** ARIBA ENABLING DATA FILE - MCFPAB0900                           **/
/** CHK IF THERE ARE ANY SETUP RECORDS TO PROCESS - MCFPAB0900      **/
/*********************************************************************/
             RTVMBRD    FILE(MCFPAB0900) NBRCURRCD(&RECORDS)
             IF         COND(&RECORDS *GT 0) THEN(DO)
             CALL       PGM(TARIBASUP) /** 1ST TIME SETUP **/
             CLRPFM     FILE(MCFPAB0900) /*  CLEAR SETUP FILE    */
             ENDDO

             CALL       PGM(TCODFLTR)      /*LOAD CODE FILTER FILE*/

             ENDPGM
