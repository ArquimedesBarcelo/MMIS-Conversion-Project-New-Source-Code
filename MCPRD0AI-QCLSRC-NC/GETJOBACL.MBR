/*********************************************************************/
/** PROGRAM: GETJOBACL                                             ***/
/**                                                                ***/
/** PURPOSE: RETRIEVE JOB ATTRIBUTES                               ***/
/**          USER ID   JOB NAME  JOB NUMBER                        ***/
/**                                                                ***/
/** CREATED:  3/06/2003                                            ***/
/** AUTHOR : DAN RAUCH - EXLTECH,INC                               ***/
/**                                                                ***/
/*********************************************************************/
/** SPECIAL NOTES:                                                 ***/
/*********************************************************************/
             PGM        PARM(&USER &JOB &JNBR)

             DCL        VAR(&USER) TYPE(*CHAR) LEN(10)
             DCL        VAR(&JOB) TYPE(*CHAR) LEN(10)
             DCL        VAR(&JNBR) TYPE(*CHAR) LEN(6)

             RTVJOBA    JOB(&JOB) USER(&USER) NBR(&JNBR)

             ENDPGM
