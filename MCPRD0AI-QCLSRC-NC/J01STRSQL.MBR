             PGM
/*****************************************************************/
/************ RESET C FOR BLANK YMD USING RUNSQL  ****************/
/*****************************************************************/
STEP41:
             CHKOBJ     OBJ(*LIBL/RUNSQL) OBJTYPE(*PGM)
             MONMSG     MSGID(CPF9801) EXEC(DO)
               SNDMSG     MSG('Century not reset to blank for blank +
                          YMD in STORES because RUNSQL does not +
                          exist. Contact CSIS programming.') +
                          TOUSR(QSYSOPR)
               GOTO       CMDLBL(END)
             ENDDO
             CHKOBJ     OBJ(*CURLIB/MCFPCS0200) OBJTYPE(*FILE)
             MONMSG     MSGID(CPF9801) EXEC(GOTO CMDLBL(STEP42))
             RUNSQL     REQUEST('UPDATE MCFPCS0200 +
                             SET REQDTE = ''        '' +
                             WHERE SUBSTR(REQDTE,3,6) = ''      ''')
             RUNSQL     REQUEST('UPDATE MCFPCS0200 +
                             SET STRACTDTE = ''        '' +
                             WHERE SUBSTR(STRACTDTE,3,6) = ''      ''')
             RUNSQL     REQUEST('UPDATE MCFPCS0200 +
                             SET STRINITDTE = ''        '' +
                             WHERE SUBSTR(STRINITDTE,3,6) = ''      ''')
             RUNSQL     REQUEST('UPDATE MCFPCS0200 +
                             SET STRINVDTE = ''        '' +
                             WHERE SUBSTR(STRINVDTE,3,6) = ''      ''')
             RUNSQL     REQUEST('UPDATE MCFPCS0200 +
                             SET STRLSTIDTE = ''        '' +
                             WHERE SUBSTR(STRLSTIDTE,3,6) = ''      ''')
