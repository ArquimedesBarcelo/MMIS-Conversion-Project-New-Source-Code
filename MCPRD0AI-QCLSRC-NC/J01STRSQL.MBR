/*****************************************************************/
             SNDMSG     MSG('Program J01STORES has successfully +
                          updated  CSIS/MMIS data library - ' *CAT +
                          MCPRD1) TOUSR(*SYSOPR)

END:
/*** CALL CL PROGRAM TO START BXGETFOB TO LOAD FOB CODES             ***/
             SBMJOB     CMD(CALL PGM(MCPRD/CLGETFOB)) JOB(CLGETFOB) +
                          JOBD(PD01) USER(PD01)

ENDLOOP:
             SNDMSG     MSG('J01STORES has ENDED') +
                          TOUSR(*SYSOPR)
/*****************************************************************/
ENDPGM:
