             PGM
/*****************************************************************/
/*** PROGRAM: J01EQPREF                                        ***/
/*** PURPOSE: TO ADD AND CHANGE DATABASE FILES (PHYSICAL AND   ***/
/***          LOGICAL) FOR THE J01 DATABASE RELEASE.           ***/
/***          THIS WILL HANDLE THE EQPREF DATABASE.            ***/
/***                                                           ***/
/***          THIS PROGRAM WILL CONTAIN SPECIAL OPERATIONS     ***/
/***          FOR THIS J01 RELEASE WHICH ARE FOR THE EXPANSION ***/
/***          OF CURRENT DATE FIELDS TO INCLUDE THE CENTURY.   ***/
/***                                                           ***/
/***          THIS PROGRAM CHECKS FOR THE EXISTENCE OF DATA    ***/
/***          LIBRARY MCPRD* (WHERE "*" IS AN INTEGER THAT IS  ***/
/***          INITIALLY SET TO 1), UPDATES THIS LIBRARY IF IT  ***/
/***          EXISTS, THEN INCREMENTS THE DATA LIBRARY NAME    ***/
/***          BY 1, AND CONTINUES LOOPING UNTIL THE INTEGER    ***/
/***          EXCEEDS 9, AT WHICH TIME THE PROGRAM ENDS        ***/
/*****************************************************************/
             DCL        VAR(&LIB)    TYPE(*CHAR) LEN(5) VALUE('MCPRD')
             DCL        VAR(&LIBN) TYPE(*DEC) LEN(1) VALUE(1)
             DCL        VAR(&LIBC) TYPE(*CHAR) LEN(1)
             DCL        VAR(&CURLIB) TYPE(*CHAR) LEN(6)
             DCL        VAR(&NBRCURRCD) TYPE(*DEC) LEN(10 0)

             CHGJOB     LOG(4 0 *SECLVL) LOGCLPGM(*YES)
LOOP:
             CHGVAR     VAR(&LIBC) VALUE(&LIBN)
             CHGVAR     VAR(&CURLIB) VALUE(&LIB *CAT &LIBC)

/*** CHECK TO SEE IF DATA LIBRARY MCPRD* EXISTS.  IF IT DOES NOT EXIST, ***/
/*** AND MCPRD9 WAS JUST CHECKED THEN END; OTHERWISE GO BACK TO LOOP.      ***/
             CHKOBJ     OBJ(QSYS/&CURLIB) OBJTYPE(*LIB)
             MONMSG     MSGID(CPF9801) EXEC(DO)
                 IF COND(&LIBN *EQ 9) THEN(GOTO CMDLBL(ENDLOOP))
                 CHGVAR VAR(&LIBN) VALUE(&LIBN + 1)
                 GOTO CMDLBL(LOOP)
             ENDDO

             CHGCURLIB  CURLIB(&CURLIB)
             SNDMSG     MSG('Program J01EQPREF is now updating  +
                          CSIS/MMIS data library - ' *CAT &CURLIB) +
                          TOUSR(*SYSOPR)

/*****************************************************************/
/****  COPY CURRENT MCFP* FILES TO THE ICFP* INTERMEDIATE     ****/
/****  FILES THAT SHOULD HAVE ALREADY BEEN RESTORED FOR J01.  ****/
/****  THIS IS THE FIRST STEP IN EXPANDING THE FILES FOR      ****/
/****  DATES THAT INCLUDE CENTURY.  A TWO BYTE FIELD IS ADDED ****/
/****  BEFORE EACH DATE FIELD AND DEFAULTED TO A VALUE OF 19. ****/
/****  EACH CPYF SHOULD BE DONE WITH *MAP *DROP FOR THIS STEP.****/
/****  NO COMPILING OF DDS SHOULD BE DONE IN THIS STEP.       ****/
/*****************************************************************/

STEP1:
/*****************************************************************/
/************             MCFPER0800              ****************/
/************ COPY DATA TO INTERMEDIATE FILE      ****************/
/*****************************************************************/
             CHKOBJ     OBJ(*CURLIB/MCFPER0800) OBJTYPE(*FILE)
             MONMSG     MSGID(CPF9801) EXEC(GOTO CMDLBL(END))
             CHKOBJ     OBJ(*CURLIB/ICFPER0800) OBJTYPE(*FILE)
             MONMSG     MSGID(CPF9801) EXEC(DO)
                 SNDMSG   MSG('CSIS/MMIS intermediate file ICFPER0800 +
                          does not exist.  J01EQPREF skipping this +
                          step either because the step had been +
                          completed or file was not restored.  If +
                          not restored, restore this intermediate +
                          file and attempt to run J01EQPREF again.') +
                          TOUSR(QSYSOPR)
                 GOTO   CMDLBL(END)
             ENDDO
             RTVMBRD    FILE(*CURLIB/MCFPER0800) NBRCURRCD(&NBRCURRCD)
             IF         (&NBRCURRCD *GT 0) THEN(DO)
               CPYF       FROMFILE(*CURLIB/MCFPER0800) +
                          TOFILE(*CURLIB/ICFPER0800) +
                          MBROPT(*REPLACE) FMTOPT(*MAP *DROP)
               MONMSG     MSGID(CPF0000) EXEC(DO)
             SNDMSG     MSG('CSIS/MMIS J01EQPREF ERROR.  Error copying +
                          MCFPER0800 data to intermediate file.  +
                          Check joblog, resolve error and attempt +
                          to run J01EQPREF again.') TOUSR(QSYSOPR)
                 GOTO   CMDLBL(ENDPGM)
               ENDDO
             ENDDO
STEP2:
/*****************************************************************/
/**********           EQPREF REFERENCE FILE       ****************/
/*****************************************************************/
             DLTF       FILE(*CURLIB/EQPREF)
             MONMSG     MSGID(CPF2105)
             CRTPF      FILE(*CURLIB/EQPREF) +
                          SRCFILE(*LIBL/QDDSSRCDB) SRCMBR(EQPREF) +
                          TEXT(*SRCMBRTXT) SIZE(*NOMAX)
STEP3:
/*****************************************************************/
/************             MCFPER0800              ****************/
/************  A) DELETE LOGICAL FILES            ****************/
/************  B) DELETE PHYSICAL FILE            ****************/
/************  C) CREATE PHYSICAL FILE            ****************/
/************  D) COPY ICFP* FILE INTO MCFP* FILE ****************/
/************  E) CREATE LOGICAL FILES            ****************/
/*****************************************************************/
             CHKOBJ     OBJ(*CURLIB/MCFPER0800) OBJTYPE(*FILE)
             MONMSG     MSGID(CPF9801) EXEC(GOTO CMDLBL(END))
             DLTF       FILE(*CURLIB/MCFLER0801)
             MONMSG     MSGID(CPF2105)
             DLTF       FILE(*CURLIB/MCFPER0800)
             MONMSG     MSGID(CPF2105)
             CRTPF      FILE(*CURLIB/MCFPER0800) +
                          SRCFILE(*LIBL/QDDSSRCDB) +
                          SRCMBR(MCFPER0800) TEXT(*SRCMBRTXT) +
                          SIZE(*NOMAX)
             MONMSG     MSGID(CPF0000) EXEC(DO)
             SNDMSG     MSG('CSIS/MMIS J01EQPREF ERROR.  Error +
                          creating MCFPER0800 file.  Check joblog, +
                          resolve error and attempt to run +
                          J01EQPREF again.') TOUSR(QSYSOPR)
                 GOTO   CMDLBL(ENDPGM)
             ENDDO
             RTVMBRD    FILE(*CURLIB/ICFPER0800) NBRCURRCD(&NBRCURRCD)
             IF         (&NBRCURRCD *GT 0) THEN(DO)
               CPYF       FROMFILE(*CURLIB/ICFPER0800) +
                          TOFILE(*CURLIB/MCFPER0800) MBROPT(*REPLACE) +
                          FMTOPT(*NOCHK)
               MONMSG     MSGID(CPF0000) EXEC(DO)
             SNDMSG     MSG('CSIS/MMIS J01EQPREF ERROR.  Error +
                          copying intermediate file to MCFPER0800 +
                          file.  Check joblog, resolve error and +
                          attempt to run J01EQPREF again.') +
                          TOUSR(QSYSOPR)
                 GOTO   CMDLBL(ENDPGM)
               ENDDO
             ENDDO
             CRTLF      FILE(*CURLIB/MCFLER0801) +
                          SRCFILE(*LIBL/QDDSSRCDB) +
                          SRCMBR(MCFLER0801) TEXT(*SRCMBRTXT)
             DLTF       FILE(*CURLIB/ICFPER0800)
/*****************************************************************/
             SNDMSG     MSG('Program J01EQPREF has successfully +
                          updated  CSIS/MMIS data library - ' *CAT +
                          &CURLIB) TOUSR(*SYSOPR)
END:

/*** INCREMENT THE LIBRARY NAME BY 1, AND GO BACK TO THE BEGINNING   ***/
/*** OF THE PROGRAM.                                                 ***/
             CHGVAR     VAR(&LIBN) VALUE(&LIBN + 1)
             GOTO       CMDLBL(LOOP)
ENDLOOP:
             SNDMSG     MSG('J01EQPREF has ENDED NORMALLY') +
                          TOUSR(*SYSOPR)
/*****************************************************************/
ENDPGM:
             ENDPGM
