             PGM
/*****************************************************************/
/*** PROGRAM: J01STHIST                                        ***/
/*** PURPOSE: TO ADD AND CHANGE DATABASE FILES (PHYSICAL AND   ***/
/***          LOGICAL) FOR THE J01 DATABASE RELEASE.           ***/
/***          THIS WILL HANDLE THE STHIST FILES.               ***/
/***                                                           ***/
/***          THIS PROGRAM WILL CONTAIN SPECIAL OPERATIONS     ***/
/***          FOR THIS J01 RELEASE WHICH ARE FOR THE EXPANSION ***/
/***          OF CURRENT DATE FIELDS TO INCLUDE THE CENTURY.   ***/
/***                                                           ***/
/***          THIS PROGRAM CHECKS FOR THE EXISTENCE OF DATA    ***/
/***          LIBRARY MCPRD* (WHERE "*" IS AN INTEGER THAT IS  ***/
/***          INITIALLY SET TO 1), UPDATES THIS LIBRARY IF IT  ***/
/***          EXISTS, THEN INCREMENTS THE DATA LIBRARY NAME    ***/
/***          BY 1, AND CONTINUES LOOPING UNTIL THE INTEGER    ***/
/***          EXCEEDS 9, AT WHICH TIME THE PROGRAM ENDS        ***/
/*****************************************************************/
             DCL        VAR(&LIB)    TYPE(*CHAR) LEN(5) VALUE('MCPRD')
             DCL        VAR(&LIBN) TYPE(*DEC) LEN(1) VALUE(1)
             DCL        VAR(&LIBC) TYPE(*CHAR) LEN(1)
             DCL        VAR(&CURLIB) TYPE(*CHAR) LEN(6)
             DCL        VAR(&NBRCURRCD) TYPE(*DEC) LEN(10 0)

             CHGJOB     LOG(4 0 *SECLVL) LOGCLPGM(*YES)
LOOP:
             CHGVAR     VAR(&LIBC) VALUE(&LIBN)
             CHGVAR     VAR(&CURLIB) VALUE(&LIB *CAT &LIBC)

/*** CHECK TO SEE IF DATA LIBRARY MCPRD* EXISTS.  IF IT DOES NOT EXIST, ***/
/*** AND MCPRD9 WAS JUST CHECKED THEN END; OTHERWISE GO BACK TO LOOP.      ***/
             CHKOBJ     OBJ(QSYS/&CURLIB) OBJTYPE(*LIB)
             MONMSG     MSGID(CPF9801) EXEC(DO)
                 IF COND(&LIBN *EQ 9) THEN(GOTO CMDLBL(ENDLOOP))
                 CHGVAR VAR(&LIBN) VALUE(&LIBN + 1)
                 GOTO CMDLBL(LOOP)
             ENDDO

             CHGCURLIB  CURLIB(&CURLIB)
             SNDMSG     MSG('Program J01STHIST is now updating  +
                          CSIS/MMIS data library - ' *CAT &CURLIB) +
                          TOUSR(*SYSOPR)

/*****************************************************************/
/****  COPY CURRENT MCFP* FILES TO THE ICFP* INTERMEDIATE     ****/
/****  FILES THAT SHOULD HAVE ALREADY BEEN RESTORED FOR J01.  ****/
/****  THIS IS THE FIRST STEP IN EXPANDING THE FILES FOR      ****/
/****  DATES THAT INCLUDE CENTURY.  A TWO BYTE FIELD IS ADDED ****/
/****  BEFORE EACH DATE FIELD AND DEFAULTED TO A VALUE OF 19. ****/
/****  EACH CPYF SHOULD BE DONE WITH *MAP *DROP FOR THIS STEP.****/
/****  NO COMPILING OF DDS SHOULD BE DONE IN THIS STEP.       ****/
/****  AFTER THE COPY DELETE THE LOGICAL AND PHYSICAL FILES   ****/
/****  TO CONSERVE SPACE DURING THE UPDATE.                   ****/
/*****************************************************************/

STEP1:
/*****************************************************************/
/************             MCFPST0300              ****************/
/************ COPY DATA TO INTERMEDIATE FILE      ****************/
/*****************************************************************/
             CHKOBJ     OBJ(*CURLIB/MCFPST0300) OBJTYPE(*FILE)
             MONMSG     MSGID(CPF9801) EXEC(GOTO CMDLBL(STEP2))
             CHKOBJ     OBJ(*CURLIB/ICFPST0300) OBJTYPE(*FILE)
             MONMSG     MSGID(CPF9801) EXEC(DO)
                 SNDMSG   MSG('CSIS/MMIS intermediate file ICFPST0300 +
                          does not exist.  J01STHIST skipping this +
                          step either because the step had been +
                          completed or file was not restored.  If +
                          not restored, restore this intermediate +
                          file and attempt to run J01STHIST again.') +
                          TOUSR(QSYSOPR)
                 GOTO   CMDLBL(STEP2)
             ENDDO
             RTVMBRD    FILE(*CURLIB/MCFPST0300) NBRCURRCD(&NBRCURRCD)
             IF         (&NBRCURRCD *GT 0) THEN(DO)
             CPYF       FROMFILE(*CURLIB/MCFPST0300) +
                          TOFILE(*CURLIB/ICFPST0300) +
                          MBROPT(*REPLACE) FMTOPT(*MAP *DROP)
             MONMSG     MSGID(CPF0000) EXEC(DO)
             SNDMSG     MSG('CSIS/MMIS J01STHIST ERROR.  Error copying +
                          MCFPST0300 data to intermediate file.  +
                          Check joblog, resolve error and attempt +
                          to run J01STHIST again.') TOUSR(QSYSOPR)
                 GOTO   CMDLBL(ENDPGM)
             ENDDO
             ENDDO
             DLTF       FILE(*CURLIB/MCFLST0301)
             MONMSG     MSGID(CPF2105)
             DLTF       FILE(*CURLIB/MCFLST0302)
             MONMSG     MSGID(CPF2105)
             DLTF       FILE(*CURLIB/MCFPST0300)
             MONMSG     MSGID(CPF2105)
STEP2:
/*****************************************************************/
/************             MCFPST0400              ****************/
/************ COPY DATA TO INTERMEDIATE FILE      ****************/
/*****************************************************************/
             CHKOBJ     OBJ(*CURLIB/MCFPST0400) OBJTYPE(*FILE)
             MONMSG     MSGID(CPF9801) EXEC(GOTO CMDLBL(STEP3))
             CHKOBJ     OBJ(*CURLIB/ICFPST0400) OBJTYPE(*FILE)
             MONMSG     MSGID(CPF9801) EXEC(DO)
                 SNDMSG   MSG('CSIS/MMIS intermediate file ICFPST0400 +
                          does not exist.  J01STHIST skipping this +
                          step either because the step had been +
                          completed or file was not restored.  If +
                          not restored, restore this intermediate +
                          file and attempt to run J01STHIST again.') +
                          TOUSR(QSYSOPR)
                 GOTO   CMDLBL(STEP3)
             ENDDO
             RTVMBRD    FILE(*CURLIB/MCFPST0400) NBRCURRCD(&NBRCURRCD)
             IF         (&NBRCURRCD *GT 0) THEN(DO)
             CPYF       FROMFILE(*CURLIB/MCFPST0400) +
                          TOFILE(*CURLIB/ICFPST0400) +
                          MBROPT(*REPLACE) FMTOPT(*MAP *DROP)
             MONMSG     MSGID(CPF0000) EXEC(DO)
             SNDMSG     MSG('CSIS/MMIS J01STHIST ERROR.  Error copying +
                          MCFPST0400 data to intermediate file.  +
                          Check joblog, resolve error and attempt +
                          to run J01STHIST again.') TOUSR(QSYSOPR)
                 GOTO   CMDLBL(ENDPGM)
                 GOTO   CMDLBL(ENDPGM)
             ENDDO
             ENDDO
             DLTF       FILE(*CURLIB/MCFLST0401)
             MONMSG     MSGID(CPF2105)
             DLTF       FILE(*CURLIB/MCFLST0402)
             MONMSG     MSGID(CPF2105)
             DLTF       FILE(*CURLIB/MCFLST0403)
             MONMSG     MSGID(CPF2105)
             DLTF       FILE(*CURLIB/MCFPST0400)
             MONMSG     MSGID(CPF2105)
STEP3:
/*****************************************************************/
/************             MCFPST0600              ****************/
/************ COPY DATA TO INTERMEDIATE FILE      ****************/
/*****************************************************************/
             CHKOBJ     OBJ(*CURLIB/MCFPST0600) OBJTYPE(*FILE)
             MONMSG     MSGID(CPF9801) EXEC(GOTO CMDLBL(STEP4))
             CHKOBJ     OBJ(*CURLIB/ICFPST0600) OBJTYPE(*FILE)
             MONMSG     MSGID(CPF9801) EXEC(DO)
                 SNDMSG   MSG('CSIS/MMIS intermediate file ICFPST0600 +
                          does not exist.  J01STHIST skipping this +
                          step either because the step had been +
                          completed or file was not restored.  If +
                          not restored, restore this intermediate +
                          file and attempt to run J01STHIST again.') +
                          TOUSR(QSYSOPR)
                 GOTO   CMDLBL(STEP4)
             ENDDO
             RTVMBRD    FILE(*CURLIB/MCFPST0600) NBRCURRCD(&NBRCURRCD)
             IF         (&NBRCURRCD *GT 0) THEN(DO)
             CPYF       FROMFILE(*CURLIB/MCFPST0600) +
                          TOFILE(*CURLIB/ICFPST0600) +
                          MBROPT(*REPLACE) FMTOPT(*MAP *DROP)
             MONMSG     MSGID(CPF0000) EXEC(DO)
             SNDMSG     MSG('CSIS/MMIS J01STHIST ERROR.  Error copying +
                          MCFPST0600 data to intermediate file.  +
                          Check joblog, resolve error and attempt +
                          to run J01STHIST again.') TOUSR(QSYSOPR)
                 GOTO   CMDLBL(ENDPGM)
             ENDDO
             ENDDO
             DLTF       FILE(*CURLIB/MCFLST0601)
             MONMSG     MSGID(CPF2105)
             DLTF       FILE(*CURLIB/MCFLST0602)
             MONMSG     MSGID(CPF2105)
             DLTF       FILE(*CURLIB/MCFPST0600)
             MONMSG     MSGID(CPF2105)
STEP4:
/*****************************************************************/
/************             MCFPST5400              ****************/
/************ COPY DATA TO INTERMEDIATE FILE      ****************/
/*****************************************************************/
             CHKOBJ     OBJ(*CURLIB/MCFPST5400) OBJTYPE(*FILE)
             MONMSG     MSGID(CPF9801) EXEC(GOTO CMDLBL(STEP5))
             CHKOBJ     OBJ(*CURLIB/ICFPST5400) OBJTYPE(*FILE)
             MONMSG     MSGID(CPF9801) EXEC(DO)
                 SNDMSG MSG('CSIS/MMIS intermediate file +
                          ICFPST5400 does not exist.  J01STHIST ending +
                          immediately.  Restore the intermediate +
                          files and attempt to run J01STHIST again.') +
                          TOUSR(QSYSOPR)
                 GOTO   CMDLBL(ENDPGM)
             ENDDO
             RTVMBRD    FILE(*CURLIB/MCFPST5400) NBRCURRCD(&NBRCURRCD)
             IF         (&NBRCURRCD *GT 0) THEN(DO)
             CPYF       FROMFILE(*CURLIB/MCFPST5400) +
                          TOFILE(*CURLIB/ICFPST5400) +
                          MBROPT(*REPLACE) FMTOPT(*MAP *DROP)
             MONMSG     MSGID(CPF0000) EXEC(DO)
             SNDMSG     MSG('CSIS/MMIS J01STHIST ERROR.  Error copying +
                          MCFPST5400 data to intermediate file.  +
                          Check joblog, resolve error and attempt +
                          to run J01STHIST again.') TOUSR(QSYSOPR)
                 GOTO   CMDLBL(ENDPGM)
             ENDDO
             ENDDO
             DLTF       FILE(*CURLIB/MCFLST5401)
             MONMSG     MSGID(CPF2105)
             DLTF       FILE(*CURLIB/MCFLST5402)
             MONMSG     MSGID(CPF2105)
             DLTF       FILE(*CURLIB/MCFPST5400)
             MONMSG     MSGID(CPF2105)
STEP5:
/*****************************************************************/
/**********           STHIST REFERENCE FILE       ****************/
/*****************************************************************/
             DLTF       FILE(*CURLIB/STHIST)
             MONMSG     MSGID(CPF2105)
             CRTPF      FILE(*CURLIB/STHIST) +
                          SRCFILE(*LIBL/QDDSSRCDB) SRCMBR(STHIST) +
                          TEXT(*SRCMBRTXT) SIZE(*NOMAX)
STEP6:
/*****************************************************************/
/************             MCFPST0300              ****************/
/************  C) CREATE PHYSICAL FILE            ****************/
/************  D) COPY ICFP* FILE INTO MCFP* FILE ****************/
/************  E) CREATE LOGICAL FILES            ****************/
/*****************************************************************/
             CHKOBJ     OBJ(*CURLIB/ICFPST0300) OBJTYPE(*FILE)
             MONMSG     MSGID(CPF9801) EXEC(GOTO CMDLBL(STEP7))
             CRTPF      FILE(*CURLIB/MCFPST0300) +
                          SRCFILE(*LIBL/QDDSSRCDB) +
                          SRCMBR(MCFPST0300) TEXT(*SRCMBRTXT) +
                          SIZE(*NOMAX)
             MONMSG     MSGID(CPF0000) EXEC(DO)
                 SNDMSG MSG('CSIS/MMIS J01STHIST ERROR.  Error +
                          creating MCFPST0300 file.  Check joblog, +
                          resolve error and attempt to run J01STHIST +
                          again.') TOUSR(QSYSOPR)
                 GOTO   CMDLBL(ENDPGM)
             ENDDO
             RTVMBRD    FILE(*CURLIB/ICFPST0300) NBRCURRCD(&NBRCURRCD)
             IF         (&NBRCURRCD *GT 0) THEN(DO)
             CPYF       FROMFILE(*CURLIB/ICFPST0300) +
                          TOFILE(*CURLIB/MCFPST0300) MBROPT(*REPLACE) +
                          FMTOPT(*NOCHK)
             MONMSG     MSGID(CPF0000) EXEC(DO)
             SNDMSG     MSG('CSIS/MMIS J01STHIST ERROR.  Error +
                          copying intermediate file to MCFPST0300 +
                          file.  Check joblog, resolve error and +
                          attempt to run J01STHIST again.') +
                          TOUSR(QSYSOPR)
                 GOTO   CMDLBL(ENDPGM)
             ENDDO
             ENDDO
             CRTLF      FILE(*CURLIB/MCFLST0301) +
                          SRCFILE(*LIBL/QDDSSRCDB) +
                          SRCMBR(MCFLST0301) TEXT(*SRCMBRTXT)
             CRTLF      FILE(*CURLIB/MCFLST0302) +
                          SRCFILE(*LIBL/QDDSSRCDB) +
                          SRCMBR(MCFLST0302) TEXT(*SRCMBRTXT)
             DLTF     FILE(*CURLIB/ICFPST0300)
STEP7:
/*****************************************************************/
/************             MCFPST0400              ****************/
/************  C) CREATE PHYSICAL FILE            ****************/
/************  D) COPY ICFP* FILE INTO MCFP* FILE ****************/
/************  E) CREATE LOGICAL FILES            ****************/
/*****************************************************************/
             CHKOBJ     OBJ(*CURLIB/ICFPST0400) OBJTYPE(*FILE)
             MONMSG     MSGID(CPF9801) EXEC(GOTO CMDLBL(STEP8))
             CRTPF      FILE(*CURLIB/MCFPST0400) +
                          SRCFILE(*LIBL/QDDSSRCDB) +
                          SRCMBR(MCFPST0400) TEXT(*SRCMBRTXT) +
                          SIZE(*NOMAX)
             MONMSG     MSGID(CPF0000) EXEC(DO)
                 SNDMSG MSG('CSIS/MMIS J01STHIST ERROR.  Error +
                          creating MCFPST0400 file.  Check joblog, +
                          resolve error and attempt to run J01STHIST +
                          again.') TOUSR(QSYSOPR)
                 GOTO   CMDLBL(ENDPGM)
             ENDDO
             RTVMBRD    FILE(*CURLIB/ICFPST0400) NBRCURRCD(&NBRCURRCD)
             IF         (&NBRCURRCD *GT 0) THEN(DO)
             CPYF       FROMFILE(*CURLIB/ICFPST0400) +
                          TOFILE(*CURLIB/MCFPST0400) MBROPT(*REPLACE) +
                          FMTOPT(*NOCHK)
             MONMSG     MSGID(CPF0000) EXEC(DO)
             SNDMSG     MSG('CSIS/MMIS J01STHIST ERROR.  Error +
                          copying intermediate file to MCFPST0400 +
                          file.  Check joblog, resolve error and +
                          attempt to run J01STHIST again.') +
                          TOUSR(QSYSOPR)
                 GOTO   CMDLBL(ENDPGM)
             ENDDO
             ENDDO
             CRTLF      FILE(*CURLIB/MCFLST0401) +
                          SRCFILE(*LIBL/QDDSSRCDB) +
                          SRCMBR(MCFLST0401) TEXT(*SRCMBRTXT)
             CRTLF      FILE(*CURLIB/MCFLST0402) +
                          SRCFILE(*LIBL/QDDSSRCDB) +
                          SRCMBR(MCFLST0402) TEXT(*SRCMBRTXT)
             CRTLF      FILE(*CURLIB/MCFLST0403) +
                          SRCFILE(*LIBL/QDDSSRCDB) +
                          SRCMBR(MCFLST0403) TEXT(*SRCMBRTXT)
             DLTF       FILE(*CURLIB/ICFPST0400)
STEP8:
/*****************************************************************/
/************             MCFPST0600              ****************/
/************  C) CREATE PHYSICAL FILE            ****************/
/************  D) COPY ICFP* FILE INTO MCFP* FILE ****************/
/************  E) CREATE LOGICAL FILES            ****************/
/*****************************************************************/
             CHKOBJ     OBJ(*CURLIB/ICFPST0600) OBJTYPE(*FILE)
             MONMSG     MSGID(CPF9801) EXEC(GOTO CMDLBL(STEP9))
             CRTPF      FILE(*CURLIB/MCFPST0600) +
                          SRCFILE(*LIBL/QDDSSRCDB) +
                          SRCMBR(MCFPST0600) TEXT(*SRCMBRTXT) +
                          SIZE(*NOMAX)
             MONMSG     MSGID(CPF0000) EXEC(DO)
                 SNDMSG MSG('CSIS/MMIS J01STHIST ERROR.  Error +
                          creating MCFPST0600 file.  Check joblog, +
                          resolve error and attempt to run J01STHIST +
                          again.') TOUSR(QSYSOPR)
                 GOTO   CMDLBL(ENDPGM)
             ENDDO
             RTVMBRD    FILE(*CURLIB/ICFPST0600) NBRCURRCD(&NBRCURRCD)
             IF         (&NBRCURRCD *GT 0) THEN(DO)
             CPYF       FROMFILE(*CURLIB/ICFPST0600) +
                          TOFILE(*CURLIB/MCFPST0600) MBROPT(*REPLACE) +
                          FMTOPT(*NOCHK)
             MONMSG     MSGID(CPF0000) EXEC(DO)
             SNDMSG     MSG('CSIS/MMIS J01STHIST ERROR.  Error +
                          copying intermediate file to MCFPST0600 +
                          file.  Check joblog, resolve error and +
                          attempt to run J01STHIST again.') +
                          TOUSR(QSYSOPR)
                 GOTO   CMDLBL(ENDPGM)
             ENDDO
             ENDDO
             CRTLF      FILE(*CURLIB/MCFLST0601) +
                          SRCFILE(*LIBL/QDDSSRCDB) +
                          SRCMBR(MCFLST0601) TEXT(*SRCMBRTXT)
             CRTLF      FILE(*CURLIB/MCFLST0602) +
                          SRCFILE(*LIBL/QDDSSRCDB) +
                          SRCMBR(MCFLST0602) TEXT(*SRCMBRTXT)
             DLTF       FILE(*CURLIB/ICFPST0600)
STEP9:
/*****************************************************************/
/************             MCFPST5400              ****************/
/************  C) CREATE PHYSICAL FILE            ****************/
/************  D) COPY ICFP* FILE INTO MCFP* FILE ****************/
/************  E) CREATE LOGICAL FILES            ****************/
/*****************************************************************/
             CHKOBJ     OBJ(*CURLIB/ICFPST5400) OBJTYPE(*FILE)
             MONMSG     MSGID(CPF9801) EXEC(GOTO CMDLBL(STEP10))
             CRTPF      FILE(*CURLIB/MCFPST5400) +
                          SRCFILE(*LIBL/QDDSSRCDB) +
                          SRCMBR(MCFPST5400) TEXT(*SRCMBRTXT) +
                          SIZE(*NOMAX)
             MONMSG     MSGID(CPF0000) EXEC(DO)
                 SNDMSG MSG('CSIS/MMIS J01STHIST ERROR.  Error +
                          creating MCFPST5400 file.  Check joblog, +
                          resolve error and attempt to run J01STHIST +
                          again.') TOUSR(QSYSOPR)
                 GOTO   CMDLBL(ENDPGM)
             ENDDO
             RTVMBRD    FILE(*CURLIB/ICFPST5400) NBRCURRCD(&NBRCURRCD)
             IF         (&NBRCURRCD *GT 0) THEN(DO)
             CPYF       FROMFILE(*CURLIB/ICFPST5400) +
                          TOFILE(*CURLIB/MCFPST5400) MBROPT(*REPLACE) +
                          FMTOPT(*NOCHK)
             MONMSG     MSGID(CPF0000) EXEC(DO)
             SNDMSG     MSG('CSIS/MMIS J01STHIST ERROR.  Error +
                          copying intermediate file to MCFPST5400 +
                          file.  Check joblog, resolve error and +
                          attempt to run J01STHIST again.') +
                          TOUSR(QSYSOPR)
                 GOTO   CMDLBL(ENDPGM)
             ENDDO
             ENDDO
             CRTLF      FILE(*CURLIB/MCFLST5401) +
                          SRCFILE(*LIBL/QDDSSRCDB) +
                          SRCMBR(MCFLST5401) TEXT(*SRCMBRTXT)
             CRTLF      FILE(*CURLIB/MCFLST5402) +
                          SRCFILE(*LIBL/QDDSSRCDB) +
                          SRCMBR(MCFLST5402) TEXT(*SRCMBRTXT)
             DLTF       FILE(*CURLIB/ICFPST5400)
STEP9B:
/*****************************************************************/
/************             MCFPST6400              ****************/
/************  A) CREATE PHYSICAL FILE            ****************/
/************  B) CREATE LOGICAL FILES            ****************/
/*****************************************************************/
             CRTPF      FILE(*CURLIB/MCFPST6400) +
                          SRCFILE(*LIBL/QDDSSRCDB) +
                          SRCMBR(MCFPST6400) TEXT(*SRCMBRTXT) +
                          SIZE(*NOMAX)
             MONMSG     MSGID(CPF0000) EXEC(DO)
                 SNDMSG MSG('CSIS/MMIS J01STHIST ERROR.  Error +
                          creating MCFPST6400 file.  Check joblog, +
                          resolve error and attempt to run J01STHIST +
                          again.') TOUSR(QSYSOPR)
                 GOTO   CMDLBL(ENDPGM)
             ENDDO
             CRTLF      FILE(*CURLIB/MCFLST6401) +
                          SRCFILE(*LIBL/QDDSSRCDB) +
                          SRCMBR(MCFLST6401) TEXT(*SRCMBRTXT)
             CRTLF      FILE(*CURLIB/MCFLST6402) +
                          SRCFILE(*LIBL/QDDSSRCDB) +
                          SRCMBR(MCFLST6402) TEXT(*SRCMBRTXT)
             CRTLF      FILE(*CURLIB/MCFLST6403) +
                          SRCFILE(*LIBL/QDDSSRCDB) +
                          SRCMBR(MCFLST6403) TEXT(*SRCMBRTXT)
/*****************************************************************/
/************       REFORMAT BINARY DATES         ****************/
/************ ADD 19,000,000 TO CURRENT DATES TO  ****************/
/************ ADD CENTURY TO THE FIELD.           ****************/
/*****************************************************************/
STEP10:
             CHKOBJ     OBJ(*LIBL/RUNSQL) OBJTYPE(*PGM)
             MONMSG     MSGID(CPF9801) EXEC(DO)
                SNDMSG  MSG('The updates of the binary fields could +
                          not occur since RUNSQL did not exist.  +
                          Contact CSIS/MMIS Programming Staff +
                          immediately.') +
                        TOUSR(QSYSOPR)
                GOTO    CMDLBL(END)
             ENDDO
             CHKOBJ     OBJ(*CURLIB/MCFPST0300) OBJTYPE(*FILE)
             MONMSG     MSGID(CPF9801) EXEC(GOTO CMDLBL(STEP11))
             RUNSQL     REQUEST('UPDATE MCFPST0300 +
                                  SET PODELDTE = PODELDTE + 19000000  +
                                  WHERE PODELDTE > 0')
             RUNSQL     REQUEST('UPDATE MCFPST0300 +
                                  SET PODTE = PODTE + 19000000  +
                                  WHERE PODTE > 0')
             RUNSQL     REQUEST('UPDATE MCFPST0300 +
                                  SET POEXPDTE = POEXPDTE + 19000000  +
                                  WHERE POEXPDTE > 0')
             RUNSQL     REQUEST('UPDATE MCFPST0300 +
                                  SET SHIPDTE = SHIPDTE + 19000000  +
                                  WHERE SHIPDTE > 0')
STEP11:
             CHKOBJ     OBJ(*CURLIB/MCFPST0400) OBJTYPE(*FILE)
             MONMSG     MSGID(CPF9801) EXEC(GOTO CMDLBL(STEP12))
             RUNSQL     REQUEST('UPDATE MCFPST0400 +
                                 SET EXPECTDTE = EXPECTDTE + 19000000  +
                                  WHERE EXPECTDTE > 0')
             RUNSQL     REQUEST('UPDATE MCFPST0400 +
                                 SET ITMDTERCV = ITMDTERCV + 19000000  +
                                  WHERE ITMDTERCV > 0')
             RUNSQL     REQUEST('UPDATE MCFPST0400 +
                                 SET SHIPDTE = SHIPDTE + 19000000  +
                                  WHERE SHIPDTE > 0')
STEP12:
             CHKOBJ     OBJ(*CURLIB/MCFPST0700) OBJTYPE(*FILE)
             MONMSG     MSGID(CPF9801) EXEC(GOTO CMDLBL(STEP13))
             RUNSQL     REQUEST('UPDATE MCFPST0700 +
                               SET FRTBILLDTE = FRTBILLDTE + 19000000  +
                                WHERE FRTBILLDTE > 0')
             RUNSQL     REQUEST('UPDATE MCFPST0700 +
                               SET FRTDTERCV = FRTDTERCV + 19000000  +
                                WHERE FRTDTERCV > 0')
STEP13:
             CHKOBJ     OBJ(*CURLIB/MCFPST0800) OBJTYPE(*FILE)
             MONMSG     MSGID(CPF9801) EXEC(GOTO CMDLBL(STEP14))
             RUNSQL     REQUEST('UPDATE MCFPST0800 +
                                 SET INVCHKDTE = INVCHKDTE + 19000000  +
                                  WHERE INVCHKDTE > 0')
             RUNSQL     REQUEST('UPDATE MCFPST0800 +
                                 SET INVDTE = INVDTE + 19000000  +
                                  WHERE INVDTE > 0')
             RUNSQL     REQUEST('UPDATE MCFPST0800 +
                                 SET INVDUEDTE = INVDUEDTE + 19000000  +
                                  WHERE INVDUEDTE > 0')
             RUNSQL     REQUEST('UPDATE MCFPST0800 +
                                 SET INVINDTE = INVINDTE + 19000000  +
                                  WHERE INVINDTE > 0')
             RUNSQL     REQUEST('UPDATE MCFPST0800 +
                                 SET INVMODDTE = INVMODDTE + 19000000  +
                                  WHERE INVMODDTE > 0')
STEP14:
             CHKOBJ     OBJ(*CURLIB/MCFPST1100) OBJTYPE(*FILE)
             MONMSG     MSGID(CPF9801) EXEC(GOTO CMDLBL(STEP15))
             RUNSQL     REQUEST('UPDATE MCFPST1100 +
                                 SET PODELDTE = PODELDTE + 19000000  +
                                  WHERE PODELDTE > 0')
/*****************************************************************/
/************    RESET CENTURY FOR BLANK DATES    ****************/
/************ IF YMD IS BLANK THEN SET C TO BLANK ****************/
/************ C WAS DEFAULTED TO 19 FOR ALL DATES ****************/
/*****************************************************************/
STEP15:
             CHKOBJ     OBJ(*CURLIB/MCFPST0300) OBJTYPE(*FILE)
             MONMSG     MSGID(CPF9801) EXEC(GOTO CMDLBL(STEP16))
             RUNSQL     REQUEST('UPDATE MCFPST0300 +
                               SET POFLUPDA = ''        '' +
                               WHERE SUBSTR(POFLUPDA,3,6) = ''      ''')
             RUNSQL     REQUEST('UPDATE MCFPST0300 +
                               SET POLASTPAY = ''      '' +
                               WHERE SUBSTR(POLASTPAY,3,4) = ''    ''')
STEP16:
             CHKOBJ     OBJ(*CURLIB/MCFPST0400) OBJTYPE(*FILE)
             MONMSG     MSGID(CPF9801) EXEC(GOTO CMDLBL(STEP17))
             RUNSQL     REQUEST('UPDATE MCFPST0400 +
                               SET ITMDTESTO = ''        '' +
                              WHERE SUBSTR(ITMDTESTO,3,6) = ''      ''')
             RUNSQL     REQUEST('UPDATE MCFPST0400 +
                               SET ITMDTESTO = ''    DD  '' +
                               WHERE SUBSTR(ITMDTESTO,5,2) = ''DD''')
STEP17:
             CHKOBJ     OBJ(*CURLIB/MCFPST0600) OBJTYPE(*FILE)
             MONMSG     MSGID(CPF9801) EXEC(GOTO CMDLBL(STEP18))
             RUNSQL     REQUEST('UPDATE MCFPST0600 +
                               SET DTERCVD = ''        '' +
                              WHERE SUBSTR(DTERCVD,3,6) = ''      ''')
             RUNSQL     REQUEST('UPDATE MCFPST0600 +
                               SET ITMDTESTO = ''        '' +
                              WHERE SUBSTR(ITMDTESTO,3,6) = ''      ''')
             RUNSQL     REQUEST('UPDATE MCFPST0600 +
                               SET ITMDTESTO = ''    DD  '' +
                               WHERE SUBSTR(ITMDTESTO,5,2) = ''DD''')
STEP18:
             CHKOBJ     OBJ(*CURLIB/MCFPST5400) OBJTYPE(*FILE)
             MONMSG     MSGID(CPF9801) EXEC(GOTO CMDLBL(END))
             RUNSQL     REQUEST('UPDATE MCFPST5400 +
                             SET DTECORRECT = ''        '' +
                             WHERE SUBSTR(DTECORRECT,3,6) = ''      ''')

/*****************************************************************/
             SNDMSG     MSG('Program J01STHIST has successfully +
                          updated  CSIS/MMIS data library - ' *CAT +
                          &CURLIB) TOUSR(*SYSOPR)
END:

/*** INCREMENT THE LIBRARY NAME BY 1, AND GO BACK TO THE BEGINNING   ***/
/*** OF THE PROGRAM.                                                 ***/
             CHGVAR     VAR(&LIBN) VALUE(&LIBN + 1)
             GOTO       CMDLBL(LOOP)

ENDLOOP:
             SNDMSG     MSG('J01STHIST has ENDED NORMALLY') +
                          TOUSR(*SYSOPR)

/*****************************************************************/
ENDPGM:
             ENDPGM
