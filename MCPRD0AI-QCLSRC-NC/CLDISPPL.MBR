PGM PARM(&DBPARMS &PLPARMS &VPARMS)
             DCL        VAR(&DBPARMS) TYPE(*CHAR) LEN(100)
             DCL        VAR(&PLPARMS) TYPE(*CHAR) LEN(840)
             DCL        VAR(&VPARMS) TYPE(*CHAR) LEN(120)
             CHKOBJ     OBJ(QTEMP/JOBFI) OBJTYPE(*FILE)
             MONMSG     MSGID(CPF9800) EXEC(DO)
             CRTPF      FILE(QTEMP/JOBFI) RCDLEN(90)
             ENDDO
             CHKOBJ     OBJ(QTEMP/LBRFI) OBJTYPE(*FILE)
             MONMSG     MSGID(CPF9800) EXEC(DO)
             CRTPF      FILE(QTEMP/LBRFI) RCDLEN(92)
             ENDDO
             CHKOBJ     OBJ(QTEMP/MATFI) OBJTYPE(*FILE)
             MONMSG     MSGID(CPF9800) EXEC(DO)
             CRTPF      FILE(QTEMP/MATFI) RCDLEN(840)
             ENDDO
             CLRPFM     FILE(QTEMP/JOBFI)
             OVRDBF     FILE(JOBFI) TOFILE(QTEMP/JOBFI)
             CLRPFM     FILE(QTEMP/LBRFI)
             OVRDBF     FILE(LBRFI) TOFILE(QTEMP/LBRFI)
             CLRPFM     FILE(QTEMP/MATFI)
             OVRDBF     FILE(MATFI) TOFILE(QTEMP/MATFI)
             CALL       PGM(*LIBL/TDISPPLN) +
                        PARM(&DBPARMS &PLPARMS &VPARMS)
             DLTOVR     FILE(JOBFI)
             DLTOVR     FILE(LBRFI)
             DLTOVR     FILE(MATFI)
             ENDPGM
