             PGM        PARM(&OBJ &FILE)
             DCL        VAR(&OBJ)       TYPE(*CHAR) LEN(10)
             DCL        VAR(&FILE)      TYPE(*CHAR) LEN(10)
             DCL        VAR(&LIBRARY)   TYPE(*CHAR) LEN(10)
             DCL        VAR(&MESSAGE)   TYPE(*CHAR) LEN(60)
             DCL        VAR(&NOTINBCK)  TYPE(*LGL)  LEN(1)
             DCL        VAR(&NOTINPRD)  TYPE(*LGL)  LEN(1)

 CHECKSRC:   CHKOBJ     OBJ(MCPRD/&FILE) OBJTYPE(*FILE) MBR(&OBJ) +
                          AUT(*OBJEXIST)
             MONMSG     MSGID(CPF0000) EXEC(GOTO COPYTST)
             CPYSRCF    FROMFILE(MCPRD/&FILE) TOFILE(MCBCK/&FILE) +
                          FROMMBR(&OBJ)
             MONMSG     MSGID(CPF0000) EXEC(GOTO MC00010)
COPYTST:     CPYSRCF    FROMFILE(MCTST/&FILE) TOFILE(MCPRD/&FILE) +
                          FROMMBR(&OBJ)
             MONMSG     MSGID(CPF0000) EXEC(GOTO MC00011)
             RMVM       FILE(MCTST/&FILE) MBR(&OBJ)
             MONMSG     MSGID(CPF0000) EXEC(GOTO MC00012)
             GOTO EOJ
 MC00010:    SNDPGMMSG  MSGID(MC00010) MSGF(*LIBL/MCFPMSG) +
                          MSGDTA(&OBJ) MSGTYPE(*ESCAPE)
             GOTO EOJ
 MC00011:    SNDPGMMSG  MSGID(MC00011) MSGF(*LIBL/MCFPMSG) +
                          MSGDTA(&OBJ) MSGTYPE(*ESCAPE)
             GOTO EOJ
 MC00012:    SNDPGMMSG  MSGID(MC00012) MSGF(*LIBL/MCFPMSG) +
                          MSGDTA(&OBJ || &FILE) MSGTYPE(*ESCAPE)
             GOTO EOJ
 EOJ:        ENDPGM
