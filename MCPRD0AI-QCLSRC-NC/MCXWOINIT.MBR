             PGM
/* THIS PROGRAM CAN BE USED TO CALL THE MMIS WORKORDER ENTRY  */
/* SCREEN AS THE INITIAL PROGRAM IN A USER PROFILE            */
             DCL        VAR(&ONE) TYPE(*CHAR) LEN(56)
             DCL        VAR(&TWO) TYPE(*CHAR) LEN(100) +
                          VALUE('            +
                          1                                           -
                                            ')

             CALL       PGM(TXINITWO) PARM(&ONE &TWO)

             ENDPGM
