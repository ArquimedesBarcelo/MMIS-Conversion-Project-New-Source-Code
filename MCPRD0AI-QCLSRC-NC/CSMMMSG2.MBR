             PGM
/*********************************************************************/
/**  TO BE RUN IMMEDIATELY AFTER A RELEASE OF CSIS/MMIS IS INSTALLED */
/**  AT A LOCATION WHERE THE PLANT TRANSLATES THE CSIS/MMIS PROGRAM  */
/**  MESSAGE FILE MCFP000100.                                        */
/**                                                                  */
/**  THIS PROGRAM WILL CHECK FOR THE EXISTANCE OF A SECOND CSIS/MMIS */
/**  MESSAGE FILE USED FOR TRANSLATIONS IN FOREIGN LOCATIONS.  IF    */
/**  FILE EXISTS, THEN A COPY IS MADE OF THAT FILE FOR THE FOLLOWING */
/**  SQL STATEMENT WHICH WILL ADD RECORDS (MESSAGES) TO THE SECOND   */
/**  MESSAGE FILE IF THEY DO NOT EXIST IN THAT FILE WHEN COMPARED TO */
/**  THE ENGLISH MESSAGE FILE IN MCPRD0.  THE COPY OF THE SECOND     */
/**  MESSAGE FILE IS THEN DELETED.                                   */
/**                                                                  */
/**  A REPORT WILL BE GENERATED FOR THE RECORDS BEING ADDED TO THE   */
/**  TRANSLATED FILE, SO THAT THE PLANT WILL HAVE AN EASY WAY OF     */
/**  FINDING THE RECORDS TO TRANSLATE.                               */
/**                                                                  */
/**  THIS PROGRAM USES THE *CMD RUNSQL.  EACH LOCATION THAT PLANS TO */
/**  USE THIS PROGRAM TO UPDATE THE TRANSLATED MESSAGE FILE MUST     */
/**  HAVE ALL THE OBJECTS RELATED TO THIS COMMAND.  THEY INCLUDE:    */
/**          RUNSQL     *CMD                                         */
/**          RUNSQL     *PGM                                         */
/**          RUNSQL     *QMQRY                                       */
/**          RUNSQLHLP  *PNLGRP                                      */
/**  ALL OBJECTS ARE IN THE USRCMDS LIBRARY ON AKRON60.              */
/*********************************************************************/

             CHKOBJ     OBJ(MCLNG/MCFP000100) OBJTYPE(*FILE)
             MONMSG     MSGID(CPF9800) EXEC(GOTO CMDLBL(FINI))

             /* CREATE A COPY OF THE TRANSLATED FILE FOR USE IN SQL */
             DLTF       FILE(QTEMP/MSG2)
             MONMSG     MSGID(CPF0000)
             CRTDUPOBJ  OBJ(MCFP000100) FROMLIB(MCLNG) +
                          OBJTYPE(*FILE) TOLIB(QTEMP) NEWOBJ(MSG2) +
                          DATA(*YES)

             /* CREATE A REPORT OF RECORDS ADDED TO TRANSLATED FILE */
             RUNSQL     REQUEST('select * from mcprd0/mcfp000100 +
                          where mcfp000100.msgnum not in (select +
                          msg2.msgnum from qtemp/msg2)') OUTPUT(*PRINT)

             /* ADD RECORDS TO THE TRANSLATED FILE */
             RUNSQL     REQUEST('INSERT INTO MCLNG/MCFP000100 +
                          SELECT * FROM MCPRD0/MCFP000100 WHERE +
                          MCFP000100.MSGNUM NOT IN (SELECT +
                          MSG2.MSGNUM FROM QTEMP/MSG2)') OUTPUT(*)

             /* DELETE SECOND COPY OF THE TRANSLATED FILE */
             DLTF       FILE(QTEMP/MSG2)
FINI:
             ENDPGM
