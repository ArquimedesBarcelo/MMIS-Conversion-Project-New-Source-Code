             PGM        PARM(&LIB &FILE &STATUS)
             DCL        VAR(&LIB) TYPE(*CHAR) LEN(10)
             DCL        VAR(&FILE) TYPE(*CHAR) LEN(10)
             DCL        VAR(&STATUS) TYPE(*CHAR) LEN(2)
/*  SET STATUS TO '00'                                            */
             CHGVAR     VAR(&STATUS) VALUE('00')
             IF (&LIB  = '          ') DO
                CHGVAR    VAR(&LIB) VALUE('*LIBL')
             ENDDO
             DLTF       FILE(&LIB/&FILE)
/*  IF CPF2105 THEN THE FILE IS NOT FOUND SET STATUS TO 01        */
             MONMSG     MSGID(CPF2105) EXEC(DO)
                     CHGVAR  VAR(&STATUS) VALUE('01')
                     GOTO EOJ
                     ENDDO
/*  IF CPF3202 THE FILE IS IN USE SO SET STATUS 02                */
             MONMSG     MSGID(CPF3202) EXEC(DO)
                     CHGVAR  VAR(&STATUS) VALUE('02')
                     GOTO EOJ
                     ENDDO
/*  IF CPF2110 THE LIBRARY WAS NOT FOUND SO SET STATUS TO 03      */
             MONMSG     MSGID(CPF2110) EXEC(DO)
                     CHGVAR  VAR(&STATUS) VALUE('03')
                     GOTO EOJ
                     ENDDO
/*  ANY OTHER ERROR SET STATUS TO '99'                            */
             MONMSG     MSGID(CPF0000) EXEC(DO)
                     CHGVAR  VAR(&STATUS) VALUE('99')
                     GOTO EOJ
                     ENDDO
 EOJ:        ENDPGM
