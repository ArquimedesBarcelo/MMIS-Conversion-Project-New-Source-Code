PGM PARM(&DBPARMS &VPARMS &CPARMS)
             DCL        VAR(&DBPARMS) TYPE(*CHAR) LEN(100)
             DCL        VAR(&VPARMS)  TYPE(*CHAR) LEN(120)
             DCL        VAR(&CPARMS)  TYPE(*CHAR) LEN(120)
             CHKOBJ     OBJ(QTEMP/OUTFIQ7C) OBJTYPE(*FILE)
             MONMSG     MSGID(CPF9800) EXEC(DO)
             CRTPF      FILE(QTEMP/OUTFIQ7C) RCDLEN(70)
             ENDDO
             CLRPFM     FILE(QTEMP/OUTFIQ7C)
             OVRDBF     FILE(OUTFIQ7C) TOFILE(QTEMP/OUTFIQ7C)
             CALL       PGM(*LIBL/TQ7SUBC) +
                        PARM(&DBPARMS &VPARMS &CPARMS)
             DLTOVR     FILE(OUTFIQ7C)
             ENDPGM
