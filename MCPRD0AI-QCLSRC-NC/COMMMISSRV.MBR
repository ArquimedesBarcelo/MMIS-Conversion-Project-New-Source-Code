             PGM

             SBMJOB     CMD(CALL PGM(CMXMMIS)) JOB(CMCMMIS) +
                          JOBD(MCTCPIP) JOBQ(*JOBD) JOBPTY(*JOBD) +
                          OUTPTY(*JOBD) PRTDEV(*CURRENT) +
                          OUTQ(*JOBD) USER(*JOBD) SYSLIBL(*SYSVAL) +
                          CURLIB(*CRTDFT) INLLIBL(*JOBD) LOG(4 0 +
                          *MSG) LOGCLPGM(*JOBD) INQMSGRPY(*JOBD) +
                          HOLD(*JOBD) DATE(*JOBD) SWS(*JOBD)
             ENDPGM
