/*********************************************************************/
/** PROGRAM: TARBEXCLRC                                            ***/
/**                                                                ***/
/** PURPOSE: CLEAR FILE MCFPAB3500 TO PREP FOR PLANT FTP DATA      ***/
/**          PLANTS RUN CATALOG EXCEPTION(EXCP3JOB) WHICH BUILDS   ***/
/**          FILE MCFPAB3500, THIS FILE GETS FTP'D TO AKRON60 FILE ***/
/**          MCPRD1/MCFPAB3500 MEMBER NAME PER PLANT ID            ***/
/**                                                                ***/
/** EXAMPLE:                                                       ***/
/**          MCPRD1/MCFPAB3500(Z+PLANT ID) (IE: Z131, Z133 ..ETC)  ***/
/**                                                                ***/
/** CREATED: 04/30/2004                                            ***/
/** AUTHOR : DAN RAUCH - eXLTech, LLC                              ***/
/**                                                                ***/
/*********************************************************************/
/** SPECIAL NOTES:                                                 ***/
/*********************************************************************/
PGM

             CLRPFM     FILE(MCFPAB3500) MBR(ALLPLANTS)
             CLRPFM     FILE(MCFPAB3500) MBR(Z126) /*DANVILLE*/
             CLRPFM     FILE(MCFPAB3500) MBR(Z129) /*UNIONCITY*/
             CLRPFM     FILE(MCFPAB3500) MBR(Z131) /*GADSDEN*/
             CLRPFM     FILE(MCFPAB3500) MBR(Z133) /*TOPEKA*/
             CLRPFM     FILE(MCFPAB3500) MBR(Z153) /*LAWTON*/
             CLRPFM     FILE(MCFPAB3500) MBR(Z155) /*ASHEBORO*/
             CLRPFM     FILE(MCFPAB3500) MBR(Z174) /*DECATUR*/
             CLRPFM     FILE(MCFPAB3500) MBR(Z120) /*SPARTANBURG*/
             CLRPFM     FILE(MCFPAB3500) MBR(Z629) /*VALLEYFIELD*/
             CLRPFM     FILE(MCFPAB3500) MBR(Z631) /*NAPANEE*/

             CLRMSGQ    MSGQ(ARIBA)

             SNDMSG     MSG('Exception File MCFPAB3500 members +
                          cleared') TOMSGQ(ARIBA)
ENDIT:
ENDPGM
