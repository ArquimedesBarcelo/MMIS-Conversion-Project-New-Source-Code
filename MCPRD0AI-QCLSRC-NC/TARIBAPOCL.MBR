/*********************************************************************/
/** PROGRAM: TARIBAPOCL                                            ***/
/**                                                                ***/
/** PURPOSE: RUN TARIBAPO                                           **/
/**                                                                ***/
/** CREATED: 11/18/02                                              ***/
/** AUTHOR : DAN RAUCH - eXLTech, LLC                              ***/
/**                                                                ***/
/*********************************************************************/
/** SPECIAL NOTES:                                                 ***/
/*********************************************************************/
PGM
             DCL        VAR(&RECORDS) TYPE(*DEC) LEN(10 0)
             DCL        VAR(&DTS) TYPE(*CHAR) LEN(30)
             DCL        VAR(&DTFLD) TYPE(*CHAR) LEN(14)


             DCL        VAR(&REQUEST) TYPE(*CHAR) LEN(256)
             DCL        VAR(&STR1) TYPE(*CHAR) LEN(7) VALUE('UPDATE ')
             DCL        VAR(&STR2) TYPE(*CHAR) LEN(5) VALUE(' SET ')
             DCL        VAR(&STR3) TYPE(*CHAR) LEN(07) VALUE(' WHERE ')
             DCL        VAR(&STREQ) TYPE(*CHAR) LEN(03) VALUE(' = ')
             DCL        VAR(&APOS) TYPE(*CHAR) LEN(1) VALUE(X'7D')
             DCL        VAR(&BLNK) TYPE(*CHAR) LEN(1) VALUE(' ')
             DCL        VAR(&FILE) TYPE(*CHAR) LEN(10) +
                          VALUE(MCFPAB0200)
             DCL        VAR(&DBFLD) TYPE(*CHAR) LEN(10) +
                          VALUE(DATETIME14)


             DCL        VAR(&DATEPGM) TYPE(*CHAR) LEN(10) +
                          VALUE(GETDTSTMP2)
             DCL        VAR(&TYPE) TYPE(*CHAR) LEN(1)

             CHGLIBL    CURLIB(*CRTDFT)
             CHGJOB     LOGCLPGM(*NO)

/*-------------------------------------------------------------------*/
/*-- IF THIS JOB WAS SUBMITTED AS BATCH, DONT GENERATE JOBLOG       -*/
/*-------------------------------------------------------------------*/
             RTVJOBA    TYPE(&TYPE)
             IF         COND(&TYPE *EQ '0') THEN(DO)
             CHGJOB     LOG(0 00 *NOLIST)
             ENDDO

/*-------------------------------------------------------------------*/
/*-- CHECK TO SEE IF THERE ARE RECORDS TO PROCESS, IF NOT - LEAVE   -*/
/*-------------------------------------------------------------------*/
             RTVMBRD    FILE(MCFPAB0100) NBRCURRCD(&RECORDS)
             IF         COND(&RECORDS *EQ 0) THEN(DO)
                        GOTO CMDLBL(ENDIT)
             ENDDO

/*-------------------------------------------------------------------*/
/*-- CREATE JOBLOG IF THERE ARE RECORDS TO PROCESS                 --*/
/*-------------------------------------------------------------------*/
             CHGJOB     LOG(4 00 *SECLVL) LOGCLPGM(*YES)

/*-------------------------------------------------------------------*/
/*-- SAVE INPUT RECORDS TO SHADOW FILE MCFPAB0200                   -*/
/*-------------------------------------------------------------------*/
/*-- COPY FROM LF MCFLAB0101(BY PONUM/RECTYPE(DESCENDNG)) TO        -*/
/*-- TO PRESERVE VITRIA INSERTION ORDER, WHICH IS:                  -*/
/*--                                                                -*/
/*--    WITHIN PO NUMBER:                                           -*/
/*--    1) ITEM RECORDS 1ST (RECTYPE = '2')     ADD NEW PO          -*/
/*--    2) HEADER RECORDS LAST (RECTYPE = '1')  ADD NEW PO          -*/
/*--                                                                -*/
/*--    3) ITEM RECORDS 1ST (RECTYPE = '4')     CHG\CNL             -*/
/*--    4) HEADER RECORDS LAST (RECTYPE = '3')  CHG\CNL             -*/
/*--    5) HEADER RECORDS LAST (RECTYPE = '5')  CHG\CNL             -*/
/*--                                                                -*/
/*--                                                                -*/
/*-- COPYING FROM LOGICAL IS NECESSARY BECAUSE THE REUSE OF DELETED -*/
/*-- RECORDS CAN ALTER THE ORDER OF INSERTION WHEN VIEWING PHYSICAL -*/
/*-------------------------------------------------------------------*/
             CPYF       FROMFILE(MCFLAB0102) TOFILE(MCFPAB0200) +
                          MBROPT(*ADD) FMTOPT(*MAP)
             MONMSG     MSGID(CPF0000) EXEC(GOTO CMDLBL(ENDIT))


/*-------------------------------------------------------------------*/
/*-- ALL RECORDS ADDED VIA THE ABOVE CPYF WILL HAVE DATE\TIME      --*/
/*-- STAMP = BLANKS - GET THE CURRENT DATE\TIME STAMP AND UPDATE   --*/
/*-- AUDIT TRAIL FILE USING "RUNSQL" STMT                          --*/
/*-------------------------------------------------------------------*/
             CALL       PGM(&DATEPGM) PARM(&DTS)
             CHGVAR     VAR(&DTFLD) VALUE(%SST(&DTS 1 14))

             CHGVAR     VAR(&REQUEST) VALUE(&STR1 *CAT &FILE *CAT +
                          &STR2 *CAT &DBFLD *CAT &STREQ *CAT +
                          &APOS *CAT &DTFLD *CAT &APOS *CAT &STR3 +
                          *CAT &DBFLD *CAT &STREQ *CAT &APOS *CAT +
                          &BLNK *CAT &APOS)

             RUNSQL     REQUEST(&REQUEST)

/*-------------------------------------------------------------------*/
/*-- CALL TARIBAPO TO PROCESS PUSHED PO'S                          --*/
/*-------------------------------------------------------------------*/
             CALL       PGM(TARIBAPO)

ENDIT:
ENDPGM
