             PGM
/*****************************************************************/
/*** PROGRAM: G01MMISA                                         ***/
/*** PURPOSE: TO ADD AND CHANGE DATABASE FILES (PHYSICAL AND   ***/
/***          LOGICAL) FOR THE G01 DATABASE RELEASE.           ***/
/*****************************************************************/
/*                                                               */
/*****************************************************************/
/**********                 STEP 1                ****************/
/**********           MMISA REFERENCE FILE        ****************/
/**********      DELETE PHYSICAL MMISA REF FILE   ****************/
/**********      CREATE PHYSICAL MMISA REF FILE   ****************/
/*****************************************************************/
             DLTF       FILE(MCPRD1/MMISA)
             MONMSG     MSGID(CPF2105)
             CRTPF      FILE(MCPRD1/MMISA) SRCFILE(*LIBL/QDDSSRCDB) +
                          SRCMBR(MMISA) TEXT('MMISA     Reference +
                          File') SIZE(*NOMAX)
             SNDMSG     MSG('Step 1 of 9 has COMPLETED NORMALLY in +
                          G01MMISA') TOUSR(*SYSOPR)
/*****************************************************************/
/**********                 STEP 2                ****************/
/**********       MCFPMM4300  PM-MASTER-SCHED     ****************/
/**********   CREATE PHYSICAL AND LOGICAL FILES   ****************/
/*****************************************************************/
             CRTPF      FILE(MCPRD1/MCFPMM4300) +
                          SRCFILE(*LIBL/QDDSSRCDB) +
                          SRCMBR(MCFPMM4300) TEXT('PM-MASTER-SCHED  +
                          Physical File') SIZE(*NOMAX)
             CRTLF      FILE(MCPRD1/MCFLMM4301) +
                          SRCFILE(*LIBL/QDDSSRCDB) +
                          SRCMBR(MCFLMM4301) TEXT('PM-MASTER-SCHED  +
                          Logical File (PMSCHEDKEY)')
             SNDMSG     MSG('Step 2 of 9 has COMPLETED NORMALLY in +
                          G01MMISA') TOUSR(*SYSOPR)
/*****************************************************************/
/************               STEP 3                ****************/
/************        MCFPMM4400  PM-SCHEDULE      ****************/
/************  CREATE PHYSICAL AND LOGICAL FILES  ****************/
/*****************************************************************/
             CRTPF      FILE(MCPRD1/MCFPMM4400) +
                          SRCFILE(*LIBL/QDDSSRCDB) +
                          SRCMBR(MCFPMM4400) TEXT('PM-SCHEDULE      +
                          Physical File') SIZE(*NOMAX)
             CRTLF      FILE(MCPRD1/MCFLMM4401) +
                          SRCFILE(*LIBL/QDDSSRCDB) +
                          SRCMBR(MCFLMM4401) TEXT('PM-SCHEDULE      +
                          Logical File (PMRLSEDATE)')
             CRTLF      FILE(MCPRD1/MCFLMM4402) +
                          SRCFILE(*LIBL/QDDSSRCDB) +
                          SRCMBR(MCFLMM4402) TEXT('PM-SCHEDULE      +
                          Logical File (PMRLSEYTMO)')
             CRTLF      FILE(MCPRD1/MCFLMM4403) +
                          SRCFILE(*LIBL/QDDSSRCDB) +
                          SRCMBR(MCFLMM4403) TEXT('PM-SCHEDULE      +
                          Logical File (PMEQPNUM)')
             CRTLF      FILE(MCPRD1/MCFLMM4404) +
                          SRCFILE(*LIBL/QDDSSRCDB) +
                          SRCMBR(MCFLMM4404) TEXT('PM-SCHEDULE      +
                          Logical File (WONUM)')
             CRTLF      FILE(MCPRD1/MCFLMM4405) +
                          SRCFILE(*LIBL/QDDSSRCDB) +
                          SRCMBR(MCFLMM4405) TEXT('PM-SCHEDULE      +
                          Logical File (ZONE)')
             CRTLF      FILE(MCPRD1/MCFLMM4406) +
                          SRCFILE(*LIBL/QDDSSRCDB) +
                          SRCMBR(MCFLMM4406) TEXT('PM-SCHEDULE      +
                          Logical File (PMPRERELDT)')
             SNDMSG     MSG('Step 3 of 9 has COMPLETED NORMALLY in +
                          G01MMISA') TOUSR(*SYSOPR)
/*****************************************************************/
/************                 STEP 4              ****************/
/************       MCFPMM4500  PM-SIMULATOR      ****************/
/************  CREATE PHYSICAL AND LOGICAL FILES  ****************/
/*****************************************************************/
             CRTPF      FILE(MCPRD1/MCFPMM4500) +
                          SRCFILE(*LIBL/QDDSSRCDB) +
                          SRCMBR(MCFPMM4500) TEXT('PM-SIMULATOR     +
                          Physical File') SIZE(*NOMAX)
             CRTLF      FILE(MCPRD1/MCFLMM4501) +
                          SRCFILE(*LIBL/QDDSSRCDB) +
                          SRCMBR(MCFLMM4501) TEXT('PM-SIMULATOR     +
                          Logical File (PMRLSEDATE)')
             CRTLF      FILE(MCPRD1/MCFLMM4502) +
                          SRCFILE(*LIBL/QDDSSRCDB) +
                          SRCMBR(MCFLMM4502) TEXT('PM-SIMULATOR     +
                          Logical File (PMRLSEYTMO)')
             CRTLF      FILE(MCPRD1/MCFLMM4503) +
                          SRCFILE(*LIBL/QDDSSRCDB) +
                          SRCMBR(MCFLMM4503) TEXT('PM-SIMULATOR     +
                          Logical File (PMEQPNUM)')
             CRTLF      FILE(MCPRD1/MCFLMM4504) +
                          SRCFILE(*LIBL/QDDSSRCDB) +
                          SRCMBR(MCFLMM4504) TEXT('PM-SIMULATOR     +
                          Logical File (WONUM)')
             CRTLF      FILE(MCPRD1/MCFLMM4505) +
                          SRCFILE(*LIBL/QDDSSRCDB) +
                          SRCMBR(MCFLMM4505) TEXT('PM-SIMULATOR     +
                          Logical File (ZONE)')
             CRTLF      FILE(MCPRD1/MCFLMM4506) +
                          SRCFILE(*LIBL/QDDSSRCDB) +
                          SRCMBR(MCFLMM4506) TEXT('PM-SIMULATOR     +
                          Logical File (PMPRERELDT)')
             SNDMSG     MSG('Step 4 of 9 has COMPLETED NORMALLY in +
                          G01MMISA') TOUSR(*SYSOPR)
/*****************************************************************/
/************                 STEP 5              ****************/
/************       MCFPMM4600  PM-AUDIT          ****************/
/************  CREATE PHYSICAL AND LOGICAL FILES  ****************/
/*****************************************************************/
             CRTPF      FILE(MCPRD1/MCFPMM4600) +
                          SRCFILE(*LIBL/QDDSSRCDB) +
                          SRCMBR(MCFPMM4600) TEXT('PM-AUDIT         +
                          Physical File') SIZE(*NOMAX)
             CRTLF      FILE(MCPRD1/MCFLMM4601) +
                          SRCFILE(*LIBL/QDDSSRCDB) +
                          SRCMBR(MCFLMM4601) TEXT('PM-AUDIT         +
                          Logical File (AUDITDATE)')
             CRTLF      FILE(MCPRD1/MCFLMM4602) +
                          SRCFILE(*LIBL/QDDSSRCDB) +
                          SRCMBR(MCFLMM4602) TEXT('PM-AUDIT         +
                          Logical File (AUDITYRMO)')
             CRTLF      FILE(MCPRD1/MCFLMM4603) +
                          SRCFILE(*LIBL/QDDSSRCDB) +
                          SRCMBR(MCFLMM4603) TEXT('PM-AUDIT         +
                          Logical File (PMEQPNUM)')
             CRTLF      FILE(MCPRD1/MCFLMM4604) +
                          SRCFILE(*LIBL/QDDSSRCDB) +
                          SRCMBR(MCFLMM4604) TEXT('PM-AUDIT         +
                          Logical File (WONUM)')
             SNDMSG     MSG('Step 5 of 9 has COMPLETED NORMALLY in +
                          G01MMISA') TOUSR(*SYSOPR)
/*****************************************************************/
/************               STEP 6                ****************/
/************        MCFPMM1100  WO-PLANNED       ****************/
/************  A) DELETE LOGICAL FILES            ****************/
/************  B) CREATE DUP OBJ OF PHYSICAL      ****************/
/************  C) DELETE PHYSICAL FILE            ****************/
/************  D) CREATE PHYSICAL FILE            ****************/
/************  E) COPY DUP OBJ INTO NEW PHYSICAL  ****************/
/************  F) CREATE LOGICAL FILES            ****************/
/************  G) DELETE DUP OBJ OF PHYSICAL      ****************/
/*****************************************************************/
/* STEP 6A */
             DLTF       FILE(MCPRD1/MCFLMM1101)
             MONMSG     MSGID(CPF2105)
             DLTF       FILE(MCPRD1/MCFLMM1102)
             MONMSG     MSGID(CPF2105)
             DLTF       FILE(MCPRD1/MCFLMM1103)
             MONMSG     MSGID(CPF2105)
             DLTF       FILE(MCPRD1/MCFLMM1104)
             MONMSG     MSGID(CPF2105)
             DLTF       FILE(MCPRD1/MCFLMM1105)
             MONMSG     MSGID(CPF2105)
             DLTF       FILE(MCPRD1/MCFLMM1106)
             MONMSG     MSGID(CPF2105)
/* STEP 6B */
             CRTDUPOBJ  OBJ(MCFPMM1100) FROMLIB(MCPRD1) +
                          OBJTYPE(*FILE) TOLIB(MCPRD1) +
                          NEWOBJ(MCFPMM110T) DATA(*YES)
/* STEP 6C */
             DLTF       FILE(MCPRD1/MCFPMM1100)
             MONMSG     MSGID(CPF2105)
/* STEP 6D */
             CRTPF      FILE(MCPRD1/MCFPMM1100) +
                          SRCFILE(*LIBL/QDDSSRCDB) +
                          SRCMBR(MCFPMM1100) TEXT('WO-PLANNED       +
                          Physical File') SIZE(*NOMAX)
/* STEP 6E */
             CPYF       FROMFILE(MCPRD1/MCFPMM110T) +
                          TOFILE(MCPRD1/MCFPMM1100) MBROPT(*ADD) +
                          FMTOPT(*NOCHK)
/* STEP 6F */
             CRTLF      FILE(MCPRD1/MCFLMM1101) +
                          SRCFILE(*LIBL/QDDSSRCDB) +
                          SRCMBR(MCFLMM1101) TEXT('WO-PLANNED       +
                          Logical File (WONUM)')
             CRTLF      FILE(MCPRD1/MCFLMM1102) +
                          SRCFILE(*LIBL/QDDSSRCDB) +
                          SRCMBR(MCFLMM1102) TEXT('WO-PLANNED       +
                          Logical File (WOSTATUS)')
             CRTLF      FILE(MCPRD1/MCFLMM1103) +
                          SRCFILE(*LIBL/QDDSSRCDB) +
                          SRCMBR(MCFLMM1103) TEXT('WO-PLANNED       +
                          Logical File (EQPNUM)')
             CRTLF      FILE(MCPRD1/MCFLMM1104) +
                          SRCFILE(*LIBL/QDDSSRCDB) +
                          SRCMBR(MCFLMM1104) TEXT('WO-PLANNED       +
                          Logical File (DATEREQD)')
             CRTLF      FILE(MCPRD1/MCFLMM1105) +
                          SRCFILE(*LIBL/QDDSSRCDB) +
                          SRCMBR(MCFLMM1105) TEXT('WO-PLANNED       +
                          Logical File (DATESCHD)')
             CRTLF      FILE(MCPRD1/MCFLMM1106) +
                          SRCFILE(*LIBL/QDDSSRCDB) +
                          SRCMBR(MCFLMM1106) TEXT('WO-PLANNED       +
                          Logical File (PMJOBPKEY)')
             CRTLF      FILE(MCPRD1/MCFLMM1107) +
                          SRCFILE(*LIBL/QDDSSRCDB) +
                          SRCMBR(MCFLMM1107) TEXT('WO-PLANNED       +
                          Logical File (PMSCHEDKEY)')
/* STEP 6G */
             DLTF       FILE(MCPRD1/MCFPMM110T)
             MONMSG     MSGID(CPF2105)
             SNDMSG     MSG('Step 6 of 9 has COMPLETED NORMALLY in +
                          G01MMISA') TOUSR(*SYSOPR)
/*****************************************************************/
/************               STEP 7                ****************/
/************        MCFPMM3900  PM-OPEN-QUEUE    ****************/
/************  A) DELETE LOGICAL FILES            ****************/
/************  B) CREATE DUP OBJ OF PHYSICAL      ****************/
/************  C) DELETE PHYSICAL FILE            ****************/
/************  D) CREATE PHYSICAL FILE            ****************/
/************  E) COPY DUP OBJ INTO NEW PHYSICAL  ****************/
/************  F) CREATE LOGICAL FILES            ****************/
/************  G) DELETE DUP OBJ OF PHYSICAL      ****************/
/*****************************************************************/
/* STEP 7A */
             DLTF       FILE(MCPRD1/MCFLMM3901)
             MONMSG     MSGID(CPF2105)
             DLTF       FILE(MCPRD1/MCFLMM3902)
             MONMSG     MSGID(CPF2105)
             DLTF       FILE(MCPRD1/MCFLMM3903)
             MONMSG     MSGID(CPF2105)
/* STEP 7B */
             CRTDUPOBJ  OBJ(MCFPMM3900) FROMLIB(MCPRD1) +
                          OBJTYPE(*FILE) TOLIB(MCPRD1) +
                          NEWOBJ(MCFPMM390T) DATA(*YES)
/* STEP 7C */
             DLTF       FILE(MCPRD1/MCFPMM3900)
             MONMSG     MSGID(CPF2105)
/* STEP 7D */
             CRTPF      FILE(MCPRD1/MCFPMM3900) +
                          SRCFILE(*LIBL/QDDSSRCDB) +
                          SRCMBR(MCFPMM3900) TEXT('PM-OPEN-QUEUE    +
                          Physical File') SIZE(*NOMAX)
/* STEP 7E */
             CPYF       FROMFILE(MCPRD1/MCFPMM390T) +
                          TOFILE(MCPRD1/MCFPMM3900) MBROPT(*ADD) +
                          FMTOPT(*NOCHK)
/* STEP 7F */
             CRTLF      FILE(MCPRD1/MCFLMM3901) +
                          SRCFILE(*LIBL/QDDSSRCDB) +
                          SRCMBR(MCFLMM3901) TEXT('PM-OPEN-QUEUE    +
                          Logical File (WONUM)')
             CRTLF      FILE(MCPRD1/MCFLMM3902) +
                          SRCFILE(*LIBL/QDDSSRCDB) +
                          SRCMBR(MCFLMM3902) TEXT('PM-OPEN-QUEUE    +
                          Logical File (EQPNUM)')
             CRTLF      FILE(MCPRD1/MCFLMM3903) +
                          SRCFILE(*LIBL/QDDSSRCDB) +
                          SRCMBR(MCFLMM3903) TEXT('PM-OPEN-QUEUE    +
                          Logical File (ZONEPRTY)')
/* STEP 7G */
             DLTF       FILE(MCPRD1/MCFPMM390T)
             MONMSG     MSGID(CPF2105)
             SNDMSG     MSG('Step 7 of 9 has COMPLETED NORMALLY in +
                          G01MMISA') TOUSR(*SYSOPR)
/*****************************************************************/
/************               STEP 8                ****************/
/************        MCFPMM2200  CC-NOTE-MSTR     ****************/
/************  A) DELETE LOGICAL FILES            ****************/
/************  B) CREATE DUP OBJ OF PHYSICAL      ****************/
/************  C) DELETE PHYSICAL FILE            ****************/
/************  D) CREATE PHYSICAL FILE            ****************/
/************  E) COPY DUP OBJ INTO NEW PHYSICAL  ****************/
/************  F) CREATE LOGICAL FILES            ****************/
/************  G) DELETE DUP OBJ OF PHYSICAL      ****************/
/*****************************************************************/
/* STEP 8A */
             DLTF       FILE(MCPRD1/MCFLMM2201)
             MONMSG     MSGID(CPF2105)
/* STEP 8B */
             CRTDUPOBJ  OBJ(MCFPMM2200) FROMLIB(MCPRD1) +
                          OBJTYPE(*FILE) TOLIB(MCPRD1) +
                          NEWOBJ(MCFPMM220T) DATA(*YES)
/* STEP 8C */
             DLTF       FILE(MCPRD1/MCFPMM2200)
             MONMSG     MSGID(CPF2105)
/* STEP 8D */
             CRTPF      FILE(MCPRD1/MCFPMM2200) +
                          SRCFILE(*LIBL/QDDSSRCDB) +
                          SRCMBR(MCFPMM2200) TEXT('CC-NOTE-MSTR     +
                          Physical File') SIZE(*NOMAX)
/* STEP 8E */
             CPYF       FROMFILE(MCPRD1/MCFPMM220T) +
                          TOFILE(MCPRD1/MCFPMM2200) MBROPT(*ADD) +
                          FMTOPT(*NOCHK)
/* STEP 8F */
             CRTLF      FILE(MCPRD1/MCFLMM2201) +
                          SRCFILE(*LIBL/QDDSSRCDB) +
                          SRCMBR(MCFLMM2201) TEXT('CC-NOTE-MSTR     +
                          Logical File (NOTEKEY)')
/* STEP 8G */
             DLTF       FILE(MCPRD1/MCFPMM220T)
             MONMSG     MSGID(CPF2105)
             SNDMSG     MSG('Step 8 of 9 has COMPLETED NORMALLY in +
                          G01MMISA') TOUSR(*SYSOPR)
/*****************************************************************/
/************               STEP 9                ****************/
/************        MCFLMM2102  CORP-CODE-LINK   ****************/
/************  A) CREATE NEW LOGICAL FILE         ****************/
/*****************************************************************/
/*****************************************************************/
             CRTLF      FILE(MCPRD1/MCFLMM2102) +
                          SRCFILE(*LIBL/QDDSSRCDB) +
                          SRCMBR(MCFLMM2102) TEXT('CORP-CODE-LINK   +
                          Logical File (CC-LINK)')
             SNDMSG     MSG('Step 9 of 9 has COMPLETED NORMALLY in +
                          G01MMISA') TOUSR(*SYSOPR)
/*****************************************************************/
             DSPJOBLOG  OUTPUT(*PRINT)
             SNDMSG     MSG('G01MMISA has ENDED NORMALLY') TOUSR(*SYSOPR)
             ENDPGM
