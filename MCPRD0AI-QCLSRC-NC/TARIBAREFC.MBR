/*********************************************************************/
/** PROGRAM: TARIBAREFC                                             **/
/**                                                                 **/
/** PURPOSE: CATALOG REFRESH JOB                                    **/
/**                                                                 **/
/** CREATED: 11/04/2003                                             **/
/**                                                                 **/
/** AUTHOR : DAN RAUCH - eXLTech, LLC                               **/
/**                                                                 **/
/** ----------------------------------------------------------------**/
/** STEP 1 : RUN PROGRAM TARIBAPRF                                  **/
/**          ==> RECALC VENDOR PRICES                               **/
/**          ==> SET ITEM PREFERENCES BY PRICE                      **/
/**                                                                 **/
/** STEP 2 : RUN PROGRAM TARIBAOVR                                  **/
/**          ==> RESTORE ITEM OVERRIDES                             **/
/**                                                                 **/
/** STEP 3 : RUN PROGRAM TARBEXCP1                                  **/
/**          ==> PRINT PREFERRED CATALOG MISMATCH REPORT            **/
/**                                                                 **/
/** STEP 4 : REORG DB FILES                                         **/
/**                                                                 **/
/*********************************************************************/
/** SPECIAL NOTES:                                                 ***/
/*********************************************************************/
PGM

             CHGJOB     LOGCLPGM(*NO)


             CALL       PGM(TARIBAPRF) /** SET PREFERENCE FLAG **/
             CALL       PGM(TARIBAOVR) /** RESTORE ITEM PREFERENCES **/
             CALL       PGM(TARBEXCP1) /** PREF MISMATCH REPORT  **/

/** REORG FILES BECAUSE OF HIGH NUMBER OF DELETED RECORDS           **/
             RGZPFM     FILE(MCFPAB2000) /*  REORG CATALOG FILE */
             MONMSG     MSGID(CPF0000)

             RGZPFM     FILE(MCFPAB2700) /*  REORG CATALOG OVRD */
             MONMSG     MSGID(CPF0000)

ENDPGM
