         /*****************************************************/
         /*  PGM NAME: CLLSTDOC                               */
         /*                                                   */
         /*  CL SUBPROGRAM USED TO FILL TEMPORARY FILE WHICH  */
         /*  IS USED BY CL COMMAND (DSPFLR) TO STORE ALL      */
         /*  DOCUMENTS, WITH THEIR DESCRIPTIONS, THAT ARE     */
         /*  USED IN THE CSIS/MMIS ONLINE DOCUMENTATION       */
         /*  SYSTEM.                                          */
         /*                                                   */
         /*  USED IN PROGRAM(S): TDOCLNK                      */
         /*                                                   */
         /*****************************************************/
PGM PARM(&DOCMNT &FOUND &ERR)
             DCL        VAR(&DOCMNT) TYPE(*CHAR) LEN(10)
             DCL        VAR(&FOUND)  TYPE(*CHAR) LEN(01)
             DCL        VAR(&ERR)    TYPE(*CHAR) LEN(01)

             DSPFLR     FLR(J0100FLR) TYPE(*DOC) OUTPUT(*OUTFILE) +
                          OUTFILE(MCPRDB/MCFPDS0300)
             MONMSG     MSGID(OFC8E6F) EXEC(DO)
             CHGVAR     VAR(&ERR) VALUE(Y)
                        GOTO ENDPGM
             ENDDO
 ENDPGM:        ENDPGM
