                          to run J01CSAS again.') TOUSR(QSYSOPR)
                 GOTO   CMDLBL(ENDPGM)
               ENDDO
             ENDDO
             DLTF       FILE(*CURLIB/MCFLCA1201)
             MONMSG     MSGID(CPF2105)
             DLTF       FILE(*CURLIB/MCFLCA1202)
             MONMSG     MSGID(CPF2105)
             DLTF       FILE(*CURLIB/MCFLCA1203)
             MONMSG     MSGID(CPF2105)
             DLTF       FILE(*CURLIB/MCFPCA1200)
             MONMSG     MSGID(CPF2105)
STEP6:
/*****************************************************************/
/**********            CSAS REFERENCE FILE        ****************/
/*****************************************************************/
             DLTF       FILE(*CURLIB/CSACCT)
             MONMSG     MSGID(CPF2105)
             CRTPF      FILE(*CURLIB/CSACCT) +
                          SRCFILE(*LIBL/QDDSSRCDB) SRCMBR(CSACCT) +
                          TEXT(*SRCMBRTXT) SIZE(*NOMAX)
STEP7:
/*****************************************************************/
/************             MCFPCAMTD               ****************/
/************  C) CREATE PHYSICAL FILE            ****************/
/************  D) COPY ICFP* FILE INTO MCFP* FILE ****************/
/************  E) CREATE LOGICAL FILES            ****************/
/*****************************************************************/
             CHKOBJ     OBJ(*CURLIB/ICFPCAMTD) OBJTYPE(*FILE)
             MONMSG     MSGID(CPF9801) EXEC(GOTO CMDLBL(STEP8))
             CRTPF      FILE(*CURLIB/MCFPCAMTD) +
                          SRCFILE(*LIBL/QDDSSRCDB) +
                          SRCMBR(MCFPCAMTD) TEXT(*SRCMBRTXT) +
                          SIZE(*NOMAX)
             MONMSG     MSGID(CPF0000) EXEC(DO)
                 SNDMSG MSG('CSIS/MMIS J01CSAS ERROR.  Error +
                          creating MCFPCAMTD file.  Check joblog, +
                          resolve error and attempt to run J01CSAS +
                          again.') TOUSR(QSYSOPR)
                 GOTO   CMDLBL(ENDPGM)
             ENDDO
             RTVMBRD    FILE(*CURLIB/ICFPCAMTD) NBRCURRCD(&NBRCURRCD)
             IF         (&NBRCURRCD *GT 0) THEN(DO)
               CPYF       FROMFILE(*CURLIB/ICFPCAMTD) +
                          TOFILE(*CURLIB/MCFPCAMTD) MBROPT(*REPLACE) +
                          FMTOPT(*NOCHK)
               MONMSG     MSGID(CPF0000) EXEC(DO)
                 SNDMSG MSG('CSIS/MMIS J01CSAS ERROR.  Error copying +
                          intermediate file to MCFPCAMTD file.  +
                          Check joblog, resolve error and attempt +
                          to run J01CSAS again.') TOUSR(QSYSOPR)
                 GOTO   CMDLBL(ENDPGM)
               ENDDO
             ENDDO
             CRTLF      FILE(*CURLIB/MCFLCAMTD1) +
                          SRCFILE(*LIBL/QDDSSRCDB) +
                          SRCMBR(MCFLCAMTD1) TEXT(*SRCMBRTXT)
             CRTLF      FILE(*CURLIB/MCFLCAMTD2) +
                          SRCFILE(*LIBL/QDDSSRCDB) +
                          SRCMBR(MCFLCAMTD2) TEXT(*SRCMBRTXT)
             DLTF       FILE(*CURLIB/ICFPCAMTD)
STEP8:
/*****************************************************************/
/************             MCFPCA0600              ****************/
/************  C) CREATE PHYSICAL FILE            ****************/
/************  D) COPY ICFP* FILE INTO MCFP* FILE ****************/
/************  E) CREATE LOGICAL FILES            ****************/
/*****************************************************************/
