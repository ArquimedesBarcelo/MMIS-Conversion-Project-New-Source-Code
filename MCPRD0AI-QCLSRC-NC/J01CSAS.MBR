                          SRCMBR(MCFLCACARR) TEXT(*SRCMBRTXT)
             DLTF     FILE(*CURLIB/MCFPCACART)
/*****************************************************************/
/************ RESET C FILED TO BLANK IF YMD IS    ****************/
/************ BLANK.  USE RUNSQL TO MASS CHANGE   ****************/
/*****************************************************************/
STEP12:
             CHKOBJ     OBJ(*LIBL/RUNSQL) OBJTYPE(*PGM)
             MONMSG     MSGID(CPF9801) EXEC(DO)
               SNDMSG     MSG('Century not reset to blank for blank +
                          YMD in CSACCT because RUNSQL does not +
                          exist. Contact CSIS programming.') +
                          TOUSR(QSYSOPR)
               GOTO     CMDLBL(END)
             ENDDO
             CHKOBJ     OBJ(*CURLIB/MCFPCAMTD) OBJTYPE(*FILE)
             MONMSG     MSGID(CPF9801) EXEC(GOTO CMDLBL(STEP13))
             RUNSQL     REQUEST('UPDATE MCFPCAMTD  +
                          SET TRANSDATE = ''        '' +
                          WHERE SUBSTR(TRANSDATE,3,6) = ''      ''')
STEP13:
             CHKOBJ     OBJ(*CURLIB/MCFPCA0600) OBJTYPE(*FILE)
             MONMSG     MSGID(CPF9801) EXEC(GOTO CMDLBL(STEP14))
             RUNSQL     REQUEST('UPDATE MCFPCA0600  +
                          SET DATLSTUPD = ''        '' +
                          WHERE SUBSTR(DATLSTUPD,3,6) = ''      ''')
STEP14:
             CHKOBJ     OBJ(*CURLIB/MCFPCA0700) OBJTYPE(*FILE)
             MONMSG     MSGID(CPF9801) EXEC(GOTO CMDLBL(STEP15))
             RUNSQL     REQUEST('UPDATE MCFPCA0700  +
                          SET TRANSDATE = ''        '' +
                          WHERE SUBSTR(TRANSDATE,3,6) = ''      ''')
STEP15:
             CHKOBJ     OBJ(*CURLIB/MCFPCA0900) OBJTYPE(*FILE)
             MONMSG     MSGID(CPF9801) EXEC(GOTO CMDLBL(STEP16))
             RUNSQL     REQUEST('UPDATE MCFPCA0900  +
                          SET TRANSDATE = ''        '' +
                          WHERE SUBSTR(TRANSDATE,3,6) = ''      ''')
STEP16:
             CHKOBJ     OBJ(*CURLIB/MCFPCA1200) OBJTYPE(*FILE)
             MONMSG     MSGID(CPF9801) EXEC(GOTO CMDLBL(END))
             RUNSQL     REQUEST('UPDATE MCFPCA1200  +
                          SET TRANSDATE = ''        '' +
                          WHERE SUBSTR(TRANSDATE,3,6) = ''      ''')
/*****************************************************************/

             SNDMSG     MSG('Program J01CSAS has successfully +
                          updated  CSIS/MMIS data library - ' *CAT +
                          &CURLIB) TOUSR(*SYSOPR)
END:

/*** INCREMENT THE LIBRARY NAME BY 1, AND GO BACK TO THE BEGINNING   ***/
/*** OF THE PROGRAM.                                                 ***/
             CHGVAR     VAR(&LIBN) VALUE(&LIBN + 1)
             GOTO       CMDLBL(LOOP)
ENDLOOP:
             SNDMSG     MSG('J01CSAS has ENDED NORMALLY') +
                          TOUSR(*SYSOPR)

/*****************************************************************/
ENDPGM:      ENDPGM
