STEP11B:
/*****************************************************************/
/************             MCFPCACARR              ****************/
/************  C) CREATE PHYSICAL FILE            ****************/
/************  E) CREATE LOGICAL FILES            ****************/
/*****************************************************************/
             CHKOBJ     OBJ(*CURLIB/MCFPCACARR) OBJTYPE(*FILE)
             MONMSG     MSGID(CPF9801) EXEC(GOTO CMDLBL(STEP12))
             DLTF       FILE(*CURLIB/MCFLCACARR)
             MONMSG     MSGID(CPF0000)
             RNMOBJ     OBJ(*CURLIB/MCFPCACARR) OBJTYPE(*FILE) +
                          NEWOBJ(MCFPCACART)
             CRTPF      FILE(*CURLIB/MCFPCACARR) +
                          SRCFILE(*LIBL/QDDSSRCDB) +
                          SRCMBR(MCFPCACARR) TEXT(*SRCMBRTXT) +
                          SIZE(*NOMAX)
             MONMSG     MSGID(CPF0000) EXEC(DO)
                 SNDMSG MSG('CSIS/MMIS J01CSAS ERROR.  Error +
                          creating MCFPCACARR file.  Check joblog, +
                          resolve error and attempt to run J01CSAS +
                          again.') TOUSR(QSYSOPR)
                 GOTO   CMDLBL(ENDPGM)
             ENDDO
             RTVMBRD    FILE(*CURLIB/MCFPCACART) NBRCURRCD(&NBRCURRCD)
             IF         (&NBRCURRCD *GT 0) THEN(DO)
               CPYF       FROMFILE(*CURLIB/MCFPCACART) +
                          TOFILE(*CURLIB/MCFPCACARR) MBROPT(*REPLACE) +
