             CRTLF      FILE(*CURLIB/MCFLCA0702) +
                          SRCFILE(*LIBL/QDDSSRCDB) +
                          SRCMBR(MCFLCA0702) TEXT(*SRCMBRTXT)
             CRTLF      FILE(*CURLIB/MCFLCA0703) +
                          SRCFILE(*LIBL/QDDSSRCDB) +
                          SRCMBR(MCFLCA0703) TEXT(*SRCMBRTXT)
             DLTF     FILE(*CURLIB/ICFPCA0700)
STEP10:
/*****************************************************************/
/************             MCFPCA0900              ****************/
/************  C) CREATE PHYSICAL FILE            ****************/
/************  D) COPY ICFP* FILE INTO MCFP* FILE ****************/
/************  E) CREATE LOGICAL FILES            ****************/
/*****************************************************************/
             CHKOBJ     OBJ(*CURLIB/ICFPCA0900) OBJTYPE(*FILE)
             MONMSG     MSGID(CPF9801) EXEC(GOTO CMDLBL(STEP11))
