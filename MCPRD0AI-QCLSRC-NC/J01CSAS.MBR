             RTVMBRD    FILE(*CURLIB/ICFPCA0700) NBRCURRCD(&NBRCURRCD)
             IF         (&NBRCURRCD *GT 0) THEN(DO)
               CPYF       FROMFILE(*CURLIB/ICFPCA0700) +
