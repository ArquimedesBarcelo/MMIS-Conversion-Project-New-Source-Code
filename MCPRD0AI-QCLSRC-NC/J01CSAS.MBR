                          Check joblog, resolve error and attempt +
                          to run J01CSAS again.') TOUSR(QSYSOPR)
                 GOTO   CMDLBL(ENDPGM)
               ENDDO
             ENDDO
             DLTF       FILE(*CURLIB/MCFLCA0701)
             MONMSG     MSGID(CPF2105)
             DLTF       FILE(*CURLIB/MCFLCA0702)
             MONMSG     MSGID(CPF2105)
             DLTF       FILE(*CURLIB/MCFLCA0703)
             MONMSG     MSGID(CPF2105)
             DLTF       FILE(*CURLIB/MCFPCA0700)
             MONMSG     MSGID(CPF2105)
STEP4:
/*****************************************************************/
/************             MCFPCA0900              ****************/
/************ COPY DATA TO INTERMEDIATE FILE      ****************/
/*****************************************************************/
             CHKOBJ     OBJ(*CURLIB/MCFPCA0900) OBJTYPE(*FILE)
             MONMSG     MSGID(CPF9801) EXEC(GOTO CMDLBL(STEP5))
             CHKOBJ     OBJ(*CURLIB/ICFPCA0900) OBJTYPE(*FILE)
             MONMSG     MSGID(CPF9801) EXEC(DO)
                 SNDMSG   MSG('CSIS/MMIS intermediate file ICFPCA0900 +
                          does not exist.  J01CSAS skipping this +
                          step either because the step had been +
                          completed or file was not restored.  If +
                          not restored, restore this intermediate +
                          file and attempt to run J01CSAS again.') +
                          TOUSR(QSYSOPR)
                 GOTO   CMDLBL(STEP5)
             ENDDO
             RTVMBRD    FILE(*CURLIB/MCFPCA0900) NBRCURRCD(&NBRCURRCD)
             IF         (&NBRCURRCD *GT 0) THEN(DO)
               CPYF       FROMFILE(*CURLIB/MCFPCA0900) +
                          TOFILE(*CURLIB/ICFPCA0900) +
                          MBROPT(*REPLACE) FMTOPT(*MAP *DROP)
               MONMSG     MSGID(CPF0000) EXEC(DO)
                 SNDMSG MSG('CSIS/MMIS J01CSAS ERROR.  Error copying +
