                 SNDMSG MSG('CSIS/MMIS J01CSAS ERROR.  Error copying +
                          intermediate file to MCFPCA0600 file.  +
                          Check joblog, resolve error and attempt +
                          to run J01CSAS again.') TOUSR(QSYSOPR)
                 GOTO   CMDLBL(ENDPGM)
               ENDDO
             ENDDO
             CRTLF      FILE(*CURLIB/MCFLCA0601) +
                          SRCFILE(*LIBL/QDDSSRCDB) +
                          SRCMBR(MCFLCA0601) TEXT(*SRCMBRTXT)
             DLTF     FILE(*CURLIB/ICFPCA0600)
STEP9:
/*****************************************************************/
/************             MCFPCA0700              ****************/
/************  C) CREATE PHYSICAL FILE            ****************/
/************  D) COPY ICFP* FILE INTO MCFP* FILE ****************/
/************  E) CREATE LOGICAL FILES            ****************/
/*****************************************************************/
             CHKOBJ     OBJ(*CURLIB/ICFPCA0700) OBJTYPE(*FILE)
             MONMSG     MSGID(CPF9801) EXEC(GOTO CMDLBL(STEP10))
             CRTPF      FILE(*CURLIB/MCFPCA0700) +
                          SRCFILE(*LIBL/QDDSSRCDB) +
                          SRCMBR(MCFPCA0700) TEXT(*SRCMBRTXT) +
                          SIZE(*NOMAX)
             MONMSG     MSGID(CPF0000) EXEC(DO)
                 SNDMSG MSG('CSIS/MMIS J01CSAS ERROR.  Error +
                          creating MCFPCA0700 file.  Check joblog, +
                          resolve error and attempt to run J01CSAS +
