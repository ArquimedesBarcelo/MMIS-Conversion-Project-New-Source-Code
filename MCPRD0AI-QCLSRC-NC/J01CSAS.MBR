             MONMSG     MSGID(CPF9801) EXEC(GOTO CMDLBL(STEP9))
             CRTPF      FILE(*CURLIB/MCFPCA0600) +
                          SRCFILE(*LIBL/QDDSSRCDB) +
                          SRCMBR(MCFPCA0600) TEXT(*SRCMBRTXT) +
                          SIZE(*NOMAX)
             MONMSG     MSGID(CPF0000) EXEC(DO)
                 SNDMSG MSG('CSIS/MMIS J01CSAS ERROR.  Error +
                          creating MCFPCA0600 file.  Check joblog, +
                          resolve error and attempt to run J01CSAS +
                          again.') TOUSR(QSYSOPR)
                 GOTO   CMDLBL(ENDPGM)
             ENDDO
             RTVMBRD    FILE(*CURLIB/ICFPCA0600) NBRCURRCD(&NBRCURRCD)
             IF         (&NBRCURRCD *GT 0) THEN(DO)
               CPYF       FROMFILE(*CURLIB/ICFPCA0600) +
                          TOFILE(*CURLIB/MCFPCA0600) MBROPT(*REPLACE) +
                          FMTOPT(*NOCHK)
