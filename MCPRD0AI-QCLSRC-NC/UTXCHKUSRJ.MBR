         /*****************************************************/
         /*                                                   */
         /*         VERIFY THAT NO BATCH JOBS ARE RUNNING     */
         /*         BY CHECKING FOR ACTIVE JOBS OF THE        */
         /*         USER ID PASSED BY THE CALLING PROGRAM.    */
         /*  NOTE: CALLING PROGRAM MUST CREATE OR VERIFY THE  */
         /*        EXISTENCE OF FILE UTFPWRKF WITH A RECORD   */
         /*        LENGTH OF 132,  MEMBER UTFPWRKF.           */
         /*                                                   */
         /*****************************************************/
             PGM        PARM(&BUUSER &RC)
             DCLF       FILE(UTFPWRKF)
             DCL        VAR(&BUUSER) TYPE(*CHAR) LEN(10)
             DCL        VAR(&RC)     TYPE(*CHAR) LEN(02)
             DCL        VAR(&JOB)    TYPE(*CHAR) LEN(10)
             DCL        VAR(&USER)   TYPE(*CHAR) LEN(10)
             DCL        VAR(&NBR)    TYPE(*CHAR) LEN(06)
             DCL        VAR(&CMP)    TYPE(*CHAR) LEN(10)
             RTVJOBA    JOB(&JOB) USER(&USER) NBR(&NBR)
             CLRPFM     FILE(QTEMP/UTFPWRKF)
             OVRPRTF    FILE(QPDSPSBJ) OUTQ(QPRINT) HOLD(*YES)
         /*****************************************************/
         /*    BEGIN GATHERING A LIST OF USERS OF THE         */
         /*    KEY FILES WHO ARE CURRENTLY ACTIVE.            */
         /*    THEY WILL BE LOGGED OFF AFTER THE LIST         */
         /*    IS COMPLETE.                                   */
         /*****************************************************/
             WRKUSRJOB  USER(&BUUSER) STATUS(*ACTIVE) OUTPUT(*PRINT)
             CPYSPLF    FILE(QPDSPSBJ) TOFILE(UTFPWRKF) +
                          JOB(&NBR/&USER/&JOB)
             DLTSPLF    FILE(QPDSPSBJ) JOB(&NBR/&USER/&JOB)
         /*****************************************************/
         /*    IF THERE ARE ACTIVE JOBS, SEND RETURN CODE "11"*/
         /*****************************************************/
 READ1:
             RCVF
             MONMSG     MSGID(CPF0000) EXEC(GOTO CMDLBL(ENDPGM))
             CHGVAR     VAR(&CMP)   VALUE(%SST(&UTFPWRKF 17 10))
             IF         COND(&CMP *EQ &BUUSER) THEN(DO)
             CHGVAR     VAR(&RC)   VALUE('11')
             GOTO       CMDLBL(ENDPGM)
             ENDDO
             GOTO       CMDLBL(READ1)
 ENDPGM:
             ENDPGM
