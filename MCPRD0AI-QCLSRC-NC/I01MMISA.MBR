             PGM
/*****************************************************************/
/*** PROGRAM: I01MMISA                                         ***/
/*** PURPOSE: TO ADD AND CHANGE DATABASE FILES (PHYSICAL AND   ***/
/***          LOGICAL) FOR THE I01 DATABASE RELEASE.           ***/
/***                                                           ***/
/***          THIS PROGRAM CHECKS FOR THE EXISTENCE OF DATA    ***/
/***          LIBRARY MCPRD* (WHERE "*" IS AN INTEGER THAT IS  ***/
/***          INITIALLY SET TO 1), UPDATES THIS LIBRARY IF IT  ***/
/***          EXISTS, THEN INCREMENTS THE DATA LIBRARY NAME    ***/
/***          BY 1, AND CONTINUES LOOPING UNTIL THE DATA       ***/
/***          LIBRARY FAILS TO EXIST AT WHICH TIME THE PROGRAM ***/
/***          ENDS.                                            ***/
/*****************************************************************/
             DCL        VAR(&LIB)    TYPE(*CHAR) LEN(5) VALUE('MCPRD')
             DCL        VAR(&LIBN) TYPE(*DEC) LEN(1) VALUE(1)
             DCL        VAR(&LIBC) TYPE(*CHAR) LEN(1)
             DCL        VAR(&CURLIB) TYPE(*CHAR) LEN(6)
LOOP:
             CHGVAR     VAR(&LIBC) VALUE(&LIBN)
             CHGVAR     VAR(&CURLIB) VALUE(&LIB *CAT &LIBC)

/*** CHECK TO SEE IF DATA LIBRARY MCPRD* EXISTS.  IF IT DOES NOT EXIST, ***/
/*** END THIS PROGRAM.                                                  ***/
             CHKOBJ     OBJ(QSYS/&CURLIB) OBJTYPE(*LIB)
             MONMSG     MSGID(CPF9801) EXEC(GOTO CMDLBL(ENDPGM))

             CHGCURLIB  CURLIB(&CURLIB)
             SNDMSG     MSG('Program I01MMISA is now updating  +
                          CSIS/MMIS data library - ' *CAT &CURLIB) +
                          TOUSR(*SYSOPR)

/*****************************************************************/
/************               STEP 1                ****************/
/************        MCFPMM4800  MASBMSG          ****************/
/************  A) DELETE LOGICAL FILE             ****************/
/************  B) CREATE LOGICAL FILE             ****************/
/*****************************************************************/
/* STEP 1A */
             DLTF       FILE(*CURLIB/MCFLMM4801)
             MONMSG     MSGID(CPF2105)
/* STEP 1B */
             CRTLF      FILE(*CURLIB/MCFLMM4801) +
                          SRCFILE(*LIBL/QDDSSRCDB) +
                          SRCMBR(MCFLMM4801) TEXT('MASBMSG  +
                          ASBESTOS MESSAGE Logical File (MSGCODE)')
             SNDMSG     MSG('Step 1 of 1 has COMPLETED NORMALLY in +
                          I01MMISA') TOUSR(*SYSOPR)
/*****************************************************************/
             SNDMSG     MSG('Program I01MMISA has successfully +
                          updated  CSIS/MMIS data library - ' *CAT +
                          &CURLIB) TOUSR(*SYSOPR)

/*** INCREMENT THE LIBRARY NAME BY 1, AND GO BACK TO THE       ***/
/*** BEGINNING OF THE PROGRAM.                                 ***/
             CHGVAR     VAR(&LIBN) VALUE(&LIBN + 1)
             GOTO       CMDLBL(LOOP)

/*****************************************************************/
ENDPGM:      DSPJOBLOG  OUTPUT(*PRINT)
             SNDMSG     MSG('I01MMISA has ENDED NORMALLY') TOUSR(*SYSOPR)
             ENDPGM
