PGM PARM(&UPDATE &LDA)
             DCL        VAR(&UPDATE) TYPE(*CHAR) LEN(1)
             DCL        VAR(&LDA) TYPE(*CHAR) LEN(512)

             IF (&UPDATE *EQ 'N') THEN(+
             RTVDTAARA  DTAARA(*LDA) RTNVAR(&LDA))
             ELSE
             CHGDTAARA  DTAARA(*LDA) VALUE(&LDA)
ENDPGM
