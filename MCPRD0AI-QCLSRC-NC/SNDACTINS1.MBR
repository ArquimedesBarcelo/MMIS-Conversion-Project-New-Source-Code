             PGM        PARM(&USER)

             DCL        VAR(&USER) TYPE(*CHAR) LEN(10)

             ADDNETJOBE FROMUSRID(&USER AKRON60) ACTION(*SUBMIT) +
                          SBMUSER(&USER)
             MONMSG     MSGID(CPF0000)

             CRTSAVF    FILE(MCBCK/&USER) TEXT(&USER)
             MONMSG     MSGID(CPF0000)

             GRTOBJAUT  OBJ(MCBCK/&USER) OBJTYPE(*FILE) USER(&USER) +
                          AUT(*ALL)
             ENDPGM
