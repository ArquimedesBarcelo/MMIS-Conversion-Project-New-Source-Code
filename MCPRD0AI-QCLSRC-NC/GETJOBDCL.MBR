/*********************************************************************/
/** PROGRAM: GETJOBDCL                                             ***/
/**                                                                ***/
/** PURPOSE: RETRIEVE JOBD FROM MCFPMMJOBD                         ***/
/**                                                                ***/
/** CREATED: 10/30/2003                                            ***/
/** AUTHOR : DAN RAUCH - EXLTECH, LLC                              ***/
/**                                                                ***/
/*********************************************************************/
             PGM        PARM(&JOBD)

             DCL        VAR(&JOBD) TYPE(*CHAR) LEN(10)

             DCLF       FILE(MCFPMMJOBD)

             RCVF       RCDFMT(*FILE)
             MONMSG     MSGID(CPF0864) EXEC(GOTO CMDLBL(ENDIT))

             CHGVAR     VAR(&JOBD) VALUE(&MCFPMMJOBD)

ENDIT:       ENDPGM
