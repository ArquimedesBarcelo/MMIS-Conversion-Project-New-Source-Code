/*********************************************************************/
/*** PROGRAM : MCXTAPUP1A                                          ***/
/*** PURPOSE : TO CREATE SAVEFILES FOR CSIS/MMIS UPDATE TAPE.      ***/
/***           PROGRAM CSMMDSPF1 WILL BE CALLED TO CREATE THE FILE ***/
/***           MCBETA/DISPLAYF FOR LOCATIONS TRANSLATING DISPLAY   ***/
/***           FILES.                                              ***/
/*** PARM     :&TIMETOSTRT: TIME TO START THIS PROGRAM.  THIS IS   ***/
/***             SO IT CAN BE RUN FROM A TERMINAL AFTER DOING A    ***/
/***             'ENTSO'                                           ***/
/*** NOTE: YOU MUST HAVE QSECOFR AUTHORITY TO RUN THIS PROGRAM.    ***/
/***                                                               ***/
/***            LIB      TYPES                  OBJECTS            ***/
/*** M01SAVFUP1: MCBETA  *PGM                   *ALL               ***/
/***                     *CMD                                      ***/
/***                     *QRYDFN                                   ***/
/***                     *DTAARA                                   ***/
/*** M01SAVFUP2: MCBETA  *FILE                  Z*,  (FORMFILES)   ***/
/***                                            S*   (FORMFILES)   ***/
/***                                            X*   (PRINTFILE)   ***/
/***                                            QDDSSRCDB          ***/
/***                                            MCD* (DFU FILES)   ***/
/*** M01SAVFUP3: MCPRD0  *FILE                  MCFP*              ***/
/***                                            MCHEADERS          ***/
/***                                            QTCSRC             ***/
/*** M01SAVFUP4: MCBETA  *FILE                  QJOBSRC2           ***/
/*********************************************************************/
/***                                                               ***/
/***   THE PROCEDURE WAS CHANGED TO MAKE THE FIRST SAVEFILE FOR    ***/
/***   DOCUMENTATION.  THIS WILL ENABLE THE PLANT TO RESTORE AND   ***/
/***   DISTRIBUTE THE USER DOCUMENTATION BEFORE RESTORING THE      ***/
/***   ENTIRE TAPE RELEASE.                                        ***/
/***                                                               ***/
/*********************************************************************/
/***                                                               ***/
/***  NOVEMBER 2002                                                ***/
/***     REMOVED 4 SAVF'S FOR RELEASE L.01. REMOVED QUAOOPT        ***/
/***     QRYDFN'S AND MCFPDS* FILES.                               ***/
/********************************************************************/
/***  MAY 12, 2005    RELEASE M.01  REQUEST# 2005-51838            ***/
/***  1) REMOVED SAVE FILE #4 -  NO JOBSRC  OR  RJEJCL  MEMBERS   ***/
/***  2) CHANGED TARGET RELEASE TO V4R5M0                         ***/
/********************************************************************/
             PGM PARM(&TIMETOSTRT)

             DCL VAR(&TIMETOSTRT) TYPE(*CHAR) LEN(5)
             DCL VAR(&TARGET)     TYPE(*CHAR) LEN(8)


/***        CHGVAR VAR(&TARGET) VALUE('*CURRENT') ***/
            CHGVAR VAR(&TARGET) VALUE('V4R5M0')

/***                                                               ***/
/*** CHANGE THE JOB TO MAKE SURE THE JOB LOG IS NOT LOST, AND SO   ***/
/*** SO THAT CL PROGRAM COMMANDS ARE LOGGED.                       ***/
             CHGJOB     LOG(4 0 *SECLVL) LOGCLPGM(*YES)

GOTO CMDLBL(SKIP)
/***                                                               ***/
/*** DELAY THIS JOB UNTIL 8:00 PM SO THAT IT CAN BE RUN FROM A     ***/
/*** TERMINAL, WITHOUT CAUSING A PROBLEM FOR THE PROGRAMMERS.      ***/
/***                                                               ***/
             DLYJOB     RSMTIME(&TIMETOSTRT)

/*** REMOVE MCPRD0 AND MCBETA FROM OUR LIBRARY LIST SO WE DONT LOG ***/
/*** OURSELVES OFF ALSO                                            ***/
/***                                                               ***/
             RMVLIBLE MCPRD0
             MONMSG   MSGID(CPF0000)

             RMVLIBLE MCBETA
             MONMSG   MSGID(CPF0000)

/***                                                               ***/
/*** LOG OFF ANYONE THAT IS ACCESSING THE MCPRD0 AND MCBETA        ***/
/*** LIBRARIES. FIRST A WARNING. WAIT 5 MINUTES AND BEGIN LOGGING  ***/
/*** OFF.                                                          ***/
             CRTPF      FILE(QTEMP/UTFPWRKF) RCDLEN(132)
             MONMSG     MSGID(CPF0000)
             CALL       PGM(MCPRD0/UTXLOGOFF) PARM('0' 'LIB' 'X' 'X' +
                          'X' 'X' 'MCPRD0' 'X' 'X' 'X' 'X')
             CALL       PGM(MCPRD0/UTXLOGOFF) PARM('0' 'LIB' 'X' 'X' +
                          'X' 'X' 'MCBETA' 'X' 'X' 'X' 'X')

             DLYJOB     DLY(10)

             CALL       PGM(MCPRD0/UTXLOGOFF) PARM('1' 'LIB' 'X' 'X' +
                          'X' 'X' 'MCPRD0' 'X' 'X' 'X' 'X')
             CALL       PGM(MCPRD0/UTXLOGOFF) PARM('1' 'LIB' 'X' 'X' +
                          'X' 'X' 'MCBETA' 'X' 'X' 'X' 'X')
SKIP:
             ADDLIBLE MCPRD0
             MONMSG   MSGID(CPF0000)

             ADDLIBLE MCBETA
             MONMSG   MSGID(CPF0000)

/***                                                               ***/
/*** CREATE THE FILE MCBETA/DISPLAYF                               ***/
/***                                                               ***/
/*********** CALL       PGM(MCPRD0/CSMMDSPF1)                        */

/***                                                               ***/
/*** CREATE THE NEEDED SAVEFILES                                   ***/
/***                                                               ***/
             DLTF       FILE(MCBCK/M01SAVFUP1)
             MONMSG     MSGID(CPF0000)
             CRTSAVF    FILE(MCBCK/M01SAVFUP1)

             DLTF       FILE(MCBCK/M01SAVFUP2)
             MONMSG     MSGID(CPF0000)
             CRTSAVF    FILE(MCBCK/M01SAVFUP2)

             DLTF       FILE(MCBCK/M01SAVFUP3)
             MONMSG     MSGID(CPF0000)
             CRTSAVF    FILE(MCBCK/M01SAVFUP3)

             DLTF       FILE(MCBCK/M01SAVFUP4)
             MONMSG     MSGID(CPF0000)
             CRTSAVF    FILE(MCBCK/M01SAVFUP4)

/***********************************************                   ***/
/*** CHANGE THE OWNERSHIP OF EVERTHING IN MCPRD0 AND MCBETA TO     ***/
/*** PD01 BEFORE THE SAVEFILES ARE CREATED                         ***/
/***                                                               ***/
/*           CALL       PGM(MCXSETAUT) PARM('MCPRD0' 'PD01' +        */
/*                        '*PUBLIC' '*USE')                          */
/*           CALL       PGM(MCXSETAUT) PARM('MCBETA' 'PD01' +        */
/*                        '*PUBLIC' '*USE')                          */
/***********************************************                   ***/

/************************************************************      ***/
/*** FIRST SAVEFILE                                                ***/
/*** ALL PROGRAMS AND COMMANDS IN MCBETA                           ***/
/***                                                               ***/
             SAVOBJ     OBJ(*ALL) LIB(MCBETA) DEV(*SAVF) +
                          OBJTYPE(*PGM *CMD *DTAARA) +
                          SAVF(MCBCK/M01SAVFUP1) TGTRLS(&TARGET) +
                          PRECHK(*YES) DTACPR(*YES)

/************************************************************      ***/
/*** SECOND SAVEFILE                                               ***/
/*** ALL FORMFILES & PRINT FILES IN MCBETA (Z* S* X*)             ***/
/*** DATABASE CHANGES SINCE THE LAST RELEASE AND ALL DFU FILES     ***/
/***                                                               ***/
             SAVOBJ     OBJ(MCD* QDDSSRCDB S* Z* X*) +
                          LIB(MCBETA) DEV(*SAVF) +
                          OBJTYPE(*FILE) SAVF(MCBCK/M01SAVFUP2) +

/*** MONITOR TO CONTINUE WHEN AN OBJECT IS NOT FOUND               ***/
             MONMSG     MSGID(CPF3702)

/************************************************************      ***/
/*** THIRD SAVEFILE                                                ***/
/*** THE MESSAGE FILE, REPORT HEADERS, AND COMMAND FILES FROM      ***/
/*** MCPRDO LIBRARY                                                ***/
             SAVOBJ     OBJ(MCFP000100 MCHEADERS QTCSRC) LIB(MCPRD0) +
                          DEV(*SAVF) OBJTYPE(*FILE) +
                          SAVF(MCBCK/M01SAVFUP3) TGTRLS(&TARGET)

/*** MONITOR TO CONTINUE WHEN AN OBJECT IS NOT FOUND               ***/
             MONMSG     MSGID(CPF3702)

/************************************************************      ***/
/*** FOURTH SAVEFILE                                               ***/
/*** ALL ADDITIONS AND/OR CHANGES MADE TO QJOBSRC AND QRJEJCL      ***/
/*** STORED RESPECTIVELY IN QJOBSRC2 AND QRJEJCL2                  ***/
/***                                                               ***/

/*-----------------------------------------------------------------***/
/*** NO QJOBSRC OR QRJEJCL CHANGES WITH THIS RELEASE - CLRSAVF     ***/
/*-----------------------------------------------------------------***/
             CLRSAVF    FILE(MCBCK/M01SAVFUP4)

/*-----------------------------------------------------------------***/
/**********  SAVOBJ     OBJ(QJOBSRC2 QRJEJCL2) LIB(MCBETA) +  ********/
/*********************  DEV(*SAVF) OBJTYPE(*ALL) +   *****************/
/*********************  SAVF(MCBCK/M01SAVFUP4) TGTRLS(&TARGET) + *****/
/*********************  PRECHK(*YES) DTACPR(*YES)  *******************/
/*-----------------------------------------------------------------***/

/***                                                               ***/
/*** NOW DISPLAY EACH SAVEFILE TO PRINT                            ***/
/***                                                               ***/
             DSPSAVF    FILE(MCBCK/M01SAVFUP1) OUTPUT(*PRINT)
             DSPSAVF    FILE(MCBCK/M01SAVFUP2) OUTPUT(*PRINT)
             DSPSAVF    FILE(MCBCK/M01SAVFUP3) OUTPUT(*PRINT)
             DSPSAVF    FILE(MCBCK/M01SAVFUP4) OUTPUT(*PRINT)

             DSPJOBLOG  OUTPUT(*PRINT)

ENDPGM
