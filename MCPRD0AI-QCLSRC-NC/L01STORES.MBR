             PGM
/*****************************************************************/
/*** PROGRAM: L01STORES                                        ***/
/*** PURPOSE: TO ADD AND CHANGE DATABASE FILES (PHYSICAL AND   ***/
/***          LOGICAL) FOR THE L01 DATABASE RELEASE.           ***/
/***          THIS WILL HANDLE THE STORES DATABASE.            ***/
/***                                                           ***/
/***          THIS PROGRAM CHECKS FOR THE EXISTENCE OF DATA    ***/
/***          LIBRARY MCPRD* (WHERE "*" IS AN INTEGER THAT IS  ***/
/***          INITIALLY SET TO 1), UPDATES THIS LIBRARY IF IT  ***/
/***          EXISTS, THEN INCREMENTS THE DATA LIBRARY NAME    ***/
/***          BY 1, AND CONTINUES LOOPING UNTIL THE INTEGER    ***/
/***          EXCEEDS 9, AT WHICH TIME THE PROGRAM ENDS        ***/
/***                                                           ***/
/***          FOR CHANGES TO THE DATABASE, THE CHGPF COMMAND   ***/
/***          WILL BE USED INSTEAD OF THE MANUAL MOVING OF THE ***/
/***          DATA TO INTERMEDIATE FILES AND BACK AFTER FILE   ***/
/***          CREATION.  TO USE THIS, LOCATIONS MUST BE AT     ***/
/***          LEAST ON V3R2, V3R6, OR V3R7.                    ***/
/***                                                           ***/
/***          RECOMPILE THIS PROGRAM WITH TARGET RELEASE OF    ***/
/***          OF V3R2M0 TO ACCOUNT FOR THE CHGPF COMMAND.      ***/
/*****************************************************************/
             DCL        VAR(&LIB)    TYPE(*CHAR) LEN(5) VALUE('MCPRD')
             DCL        VAR(&LIBN) TYPE(*DEC) LEN(1) VALUE(1)
             DCL        VAR(&LIBC) TYPE(*CHAR) LEN(1)
             DCL        VAR(&CURLIB) TYPE(*CHAR) LEN(6)
/*           DCLF       FILE(QTEMP/MTAXINFO)                 */

             CHGJOB     LOG(4 0 *SECLVL) LOGCLPGM(*YES)
LOOP:
             CHGVAR     VAR(&LIBC) VALUE(&LIBN)
             CHGVAR     VAR(&CURLIB) VALUE(&LIB *CAT &LIBC)

/*** CHECK TO SEE IF DATA LIBRARY MCPRD* EXISTS.  IF IT DOES NOT EXIST, ***/
/*** AND MCPRD9 WAS JUST CHECKED THEN END; OTHERWISE GO BACK TO LOOP.   ***/
             CHKOBJ     OBJ(QSYS/&CURLIB) OBJTYPE(*LIB)
             MONMSG     MSGID(CPF9801) EXEC(DO)
                 IF COND(&LIBN *EQ 9) THEN(GOTO CMDLBL(ENDLOOP))
                 CHGVAR VAR(&LIBN) VALUE(&LIBN + 1)
                 GOTO CMDLBL(LOOP)
             ENDDO

             CHGCURLIB  CURLIB(&CURLIB)
             SNDMSG     MSG('Program L01STORES is now updating  +
                          CSIS/MMIS data library - ' *CAT &CURLIB) +
                          TOUSR(*SYSOPR)

/*****************************************************************/
/**********          STORES REFERENCE FILE        ****************/
/*****************************************************************/
             DLTF       FILE(*CURLIB/STORES)
             MONMSG     MSGID(CPF2105)
             CRTPF      FILE(*CURLIB/STORES) +
                          SRCFILE(MCPRD/QDDSSRCDB) SRCMBR(STORES) +
                          TEXT(*SRCMBRTXT) SIZE(*NOMAX)

/*****************************************************************/
/**********                NEW FILE               ****************/
/**********             MCFPCSAUTH FILE           ****************/
/*****************************************************************/
             CHKOBJ     OBJ(*CURLIB/MCFPCSAUTH) OBJTYPE(*FILE)
             MONMSG     MSGID(CPF9801) EXEC(DO)
               CRTPF      FILE(*CURLIB/MCFPCSAUTH) +
                          SRCFILE(MCPRD/QDDSSRCDB) +
                          SRCMBR(MCFPCSAUTH) TEXT(*SRCMBRTXT) +
                          SIZE(*NOMAX) REUSEDLT(*YES)
               CRTLF      FILE(*CURLIB/MCFLCSAUTH) +
                          SRCFILE(MCPRD/QDDSSRCDB) +
                          SRCMBR(MCFLCSAUTH) TEXT(*SRCMBRTXT)
             ENDDO

/*****************************************************************/
/**********                NEW FILE               ****************/
/**********             MCFPCSSPRQ FILE           ****************/
/*****************************************************************/
             CHKOBJ     OBJ(*CURLIB/MCFPCSSPRQ) OBJTYPE(*FILE)
             MONMSG     MSGID(CPF9801) EXEC(DO)
               CRTPF      FILE(*CURLIB/MCFPCSSPRQ) +
                          SRCFILE(MCPRD/QDDSSRCDB) +
                          SRCMBR(MCFPCSSPRQ) TEXT(*SRCMBRTXT) +
                          SIZE(*NOMAX) REUSEDLT(*YES)
             ENDDO

/******************************************************************/
/************      MCFPCS3700  MTAX CHANGE        *****************/
/******************************************************************/
/*** RETREIVE RECORD LENGTH OF MTAX INTO A FILE THEN READ IT      */
/******************************************************************/

/*           DSPFD FILE(*CURLIB/MCFPCS3700) TYPE(*RCDFMT) +       */
/*                 OUTPUT(*OUTFILE) OUTFILE(QTEMP/MTAXINFO)       */
/*           RCVF                                                 */

/*****************************************************************/
/* MTAXINFO CONTAINS THE RESULT OF THE PREVIOUS DSPFD COMMAND    */
/* THE RFLEN FIELD CONTAINS THE RECORD LENGTH OF THE MTAX FILE   */
/* A LENGTH OF 34 MEANS THAT THE FILE HAS ALREADY BEEN CONVERTED */
/*****************************************************************/

/*           IF COND(&RFLEN *EQ 34) THEN(GOTO CMDLBL(SKIPMTAX))      */

/*           CHGPF      FILE(*CURLIB/MCFPCS3700) +                   */
/*                      SRCFILE(MCPRD/QDDSSRCDB) LANGID(ENU)         */
/*           MONMSG     MSGID(CPF0000) EXEC(DO)                      */
/*             SNDMSG MSG('The CHGPF command on MCFPCS3700 has +     */
/*                        failed.  Please contact CSIS/MMIS staff.  +*/
/*                        Processing continues with other database + */
/*                        changes.') TOUSR(*SYSOPR)                  */
/*             SNDPGMMSG MSG('The CHGPF command on MCFPCS3700 has +  */
/*                        failed.  Please contact CSIS/MMIS staff.  +*/
/*                        Processing continues with other database + */
/*                        changes.')                                 */
/*           ENDDO                                                   */

/*****************************************************************/
/***          RUN THE SQL TO CONVERT TAX PCTS ON MTAX.           */
/***          Multiply tax percents by 100.                      */
/*****************************************************************/

/*           RUNSQL     REQUEST('UPDATE MCFPCS3700 SET TAXPCT1 = +     */
/*                       (TAXPCT1 * 100), TAXPCT2 = (TAXPCT2 * +       */
/*                       100), TAXPCT3 = (TAXPCT3 * 100), TAXPCT4 +    */
/*                       = (TAXPCT4 * 100)')                           */

/*           SNDMSG    MSG('The SQL to convert MCFPCS3700 has +        */
/*                        finished.') TOUSR(*SYSOPR)                   */
/*           SNDPGMMSG MSG('The SQL to convert MCFPCS3700 has +        */
/*                        finished.')                                  */

/*           GOTO CMDLBL(NEXTFILE)                                     */

SKIPMTAX:
/*           SNDMSG    MSG('File MTAX does NOT need to be converted') + */
/*                     TOUSR(*SYSOPR)                                   */
/*           SNDPGMMSG MSG('File MTAX does NOT need to be converted')   */

NEXTFILE:
/*           CLRPFM FILE(QTEMP/MTAXINFO)                                */

