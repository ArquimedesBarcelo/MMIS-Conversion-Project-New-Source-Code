             PGM PARM(&DEVTYP &DSPFDDS)
             DCL VAR(&DEVTYP) TYPE(*CHAR) LEN(1)
             DCL VAR(&DSPFDDS) TYPE(*CHAR) LEN(1)
/*********************************************************************/
/*** PROGRAM : MCXTAPUP1B                                          ***/
/*** PURPOSE : TO SAVE SAVEFILES TO TAPE FOR CSIS/MMIS UPDATE TAPE.***/
/***           SAVEFILES WERE CREATED BY MCXTAPUP1A.               ***/
/***            LIB      TYPES                  OBJECTS            ***/
/*** PARAMETERS:  &DSPFDDS,'Y' TO SAVE DSPF DDS IN SAVFUP7         ***/
/***                       'N' TO NOT SAVE DSPF DDS IN SAVFUP7     ***/
/***              &DEVTYP, 'C' FOR CARTRIDGE DEVICE TAP01          ***/
/***                       'T' FOR 1/4" TAPE DEVICE TAP02          ***/
/***   SAVFUP1: MCBETA   *FILE                  QTXTSRC            ***/
/***                                            DRPTRQ2            ***/
/***   SAVFUP2:          DLO                    XXXXXFLR           ***/
/***   SAVFUP3: MCBETA   *PGM                   *ALL               ***/
/***                     *CMD                                      ***/
/***                     *QRYDFN                                   ***/
/***   SAVFUP4: MCBETA   *FILE                  Z*                 ***/
/***                                            S*                 ***/
/***                                            MCFD*              ***/
/***                                            QDDSSRCDB          ***/
/***                                            MCD*               ***/
/***                                            MCFPDS*            ***/
/***                                            MCFLDS*            ***/
/***   SAVFUP5: MCPRD0   *FILE                  MCFP*              ***/
/***                                            MCHEADERS          ***/
/***                                            QUAOOPT            ***/
/***                                            QTCSRC             ***/
/***   SAVFUP6: MCBETA                          QJOBSRC2           ***/
/***                                            QRJEJCL2           ***/
/*** IF DSPF DDS IS TO BE SAVED (FOR DSPF TRANSLATION):            ***/
/***   SAVFUP7: MCBETA   *FILE                  QDDSSRC            ***/
/***                                            QDDSSRCDB          ***/
/***                                            DISPLAYF           ***/
/***                     *QRYDFN                DISPLAYF           ***/
/***                                                               ***/
/*** K01 RELEASE ONLY                                              ***/
/***   SAVFUP8: MCBETA   *FILE                  ICFP*              ***/
/*********************************************************************/
/*********************************************************************/
/***                                                               ***/
/***   THE PROCEDURE WAS CHANGED TO MAKE THE FIRST SAVEFILE FOR    ***/
/***   DOCUMENTATION.  THIS WILL ENABLE THE PLANT TO RESTORE AND   ***/
/***   DISTRIBUTE THE USER DOCUMENTATION BEFORE RESTORING THE      ***/
/***   ENTIRE TAPE RELEASE.                                        ***/
/***                                                               ***/
/*********************************************************************/
/***                                                               ***/
/*** NOW SAVE THE SAVEFILE DATA ONTA A SINGLE TAPESET, ONE RIGHT   ***/
/*** AFTER THE OTHER                                               ***/
/***                                                               ***/
             IF COND(&DEVTYP *EQ 'C') THEN(DO)
               INZTAP DEV(TAP01) NEWVOL(MMCS) CHECK(*NO)
               SAVSAVFDTA SAVF(MCBCK/SAVFUP1) DEV(TAP01) SEQNBR(1) +
                          ENDOPT(*LEAVE)
               SAVSAVFDTA SAVF(MCBCK/SAVFUP2) DEV(TAP01) SEQNBR(2) +
                          ENDOPT(*LEAVE)
               SAVSAVFDTA SAVF(MCBCK/SAVFUP3) DEV(TAP01) SEQNBR(3) +
                          ENDOPT(*LEAVE)
               SAVSAVFDTA SAVF(MCBCK/SAVFUP4) DEV(TAP01) SEQNBR(4) +
                          ENDOPT(*LEAVE)
               SAVSAVFDTA SAVF(MCBCK/SAVFUP5) DEV(TAP01) SEQNBR(5) +
                          ENDOPT(*LEAVE)
               SAVSAVFDTA SAVF(MCBCK/SAVFUP6) DEV(TAP01) SEQNBR(6) +
                          ENDOPT(*LEAVE)
               IF COND(&DSPFDDS *EQ 'Y') THEN(DO)
                SAVSAVFDTA SAVF(MCBCK/SAVFUP7) DEV(TAP01) SEQNBR(7) +
                             ENDOPT(*LEAVE)
               ENDDO
/*** K01 RELEASE ONLY  ***/
               SAVSAVFDTA SAVF(MCBCK/SAVFUP8) DEV(TAP01) SEQNBR(7) +
                          ENDOPT(*LEAVE)
               CHKTAP     DEV(TAP01) ENDOPT(*UNLOAD)
             ENDDO
             IF COND(&DEVTYP *EQ 'T') THEN(DO)
               INZTAP DEV(TAP02) NEWVOL(MMCS) CHECK(*NO)
               SAVSAVFDTA SAVF(MCBCK/SAVFUP1) DEV(TAP02) SEQNBR(1) +
                          ENDOPT(*LEAVE)
               SAVSAVFDTA SAVF(MCBCK/SAVFUP2) DEV(TAP02) SEQNBR(2) +
                          ENDOPT(*LEAVE)
               SAVSAVFDTA SAVF(MCBCK/SAVFUP3) DEV(TAP02) SEQNBR(3) +
                          ENDOPT(*LEAVE)
               SAVSAVFDTA SAVF(MCBCK/SAVFUP4) DEV(TAP02) SEQNBR(4) +
                          ENDOPT(*LEAVE)
               SAVSAVFDTA SAVF(MCBCK/SAVFUP5) DEV(TAP02) SEQNBR(5) +
                          ENDOPT(*LEAVE)
               SAVSAVFDTA SAVF(MCBCK/SAVFUP6) DEV(TAP02) SEQNBR(6) +
                          ENDOPT(*LEAVE)
               IF COND(&DSPFDDS *EQ 'Y') THEN(DO)
                SAVSAVFDTA SAVF(MCBCK/SAVFUP7) DEV(TAP03) SEQNBR(7) +
                             ENDOPT(*LEAVE)
               ENDDO
/*** K01 RELEASE ONLY  ***/
               ELSE (DO)
                SAVSAVFDTA SAVF(MCBCK/SAVFUP8) DEV(TAP02) SEQNBR(7) +
                          ENDOPT(*LEAVE)
               ENDDO
               CHKTAP     DEV(TAP02) ENDOPT(*UNLOAD)
             ENDDO
             ENDPGM
