PGM PARM(&DBPARMS)
             DCL        VAR(&DBPARMS) TYPE(*CHAR) LEN(600)
             CHKOBJ     OBJ(QTEMP/OUTFILE) OBJTYPE(*FILE)
             MONMSG     MSGID(CPF9800) EXEC(DO)
             CRTPF      FILE(QTEMP/OUTFILE) RCDLEN(56)
             ENDDO
             CLRPFM     FILE(QTEMP/OUTFILE)
             OVRDBF     FILE(OUTFILE) TOFILE(QTEMP/OUTFILE)
             CALL       PGM(*LIBL/THCDISP) PARM(&DBPARMS)
             DLTOVR     FILE(OUTFILE)
             ENDPGM
