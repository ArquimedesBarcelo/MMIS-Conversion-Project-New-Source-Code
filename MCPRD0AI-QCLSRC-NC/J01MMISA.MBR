             DLTF       FILE(*CURLIB/MCFLMM1004)
             MONMSG     MSGID(CPF2105)
             DLTF       FILE(*CURLIB/MCFLMM1005)
             MONMSG     MSGID(CPF2105)
             DLTF       FILE(*CURLIB/MCFLMM1006)
             MONMSG     MSGID(CPF2105)
             DLTF       FILE(*CURLIB/MCFLMM1007)
