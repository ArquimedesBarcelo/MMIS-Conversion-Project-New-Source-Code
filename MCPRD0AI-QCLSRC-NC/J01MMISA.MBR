/*****************************************************************/
             SNDMSG     MSG('Program J01MMISA has successfully +
                          updated  CSIS/MMIS data library - ' *CAT +
                          &CURLIB) TOUSR(*SYSOPR)

END:
/*** INCREMENT THE LIBRARY NAME BY 1, AND GO BACK TO THE BEGINNING   ***/
/*** OF THE PROGRAM.                                                 ***/
             CHGVAR     VAR(&LIBN) VALUE(&LIBN + 1)
             GOTO       CMDLBL(LOOP)

ENDLOOP:
             SNDMSG     MSG('J01MMISA has ENDED NORMALLY') +
                          TOUSR(*SYSOPR)
/*****************************************************************/
ENDPGM:
             ENDPGM
