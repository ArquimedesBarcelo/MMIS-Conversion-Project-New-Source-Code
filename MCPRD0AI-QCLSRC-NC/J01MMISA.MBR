/*****************************************************************/
STEP28:
             CHKOBJ     OBJ(*LIBL/RUNSQL) OBJTYPE(*PGM)
             MONMSG     MSGID(CPF9801) EXEC(DO)
               SNDMSG     MSG('Century not reset to blank for blank +
                          YMD in MMISA because RUNSQL does not +
                          exist. Contact CSIS programming.') +
                          TOUSR(QSYSOPR)
               GOTO       CMDLBL(END)
             ENDDO
             CHKOBJ     OBJ(*CURLIB/MCFPMM0300) OBJTYPE(*FILE)
             MONMSG     MSGID(CPF9801) EXEC(GOTO CMDLBL(STEP29))
             RUNSQL     REQUEST('UPDATE MCFPMM0300 +
                             SET PERCSD = ''        '' +
                             WHERE SUBSTR(PERCSD,3,6) = ''      ''')
