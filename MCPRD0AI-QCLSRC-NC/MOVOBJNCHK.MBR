             PGM        PARM(&OBJNAME &OBJTYPE &OBJFROMLIB &OBJTOLIB)
             DCL        VAR(&OBJNAME)    TYPE(*CHAR) LEN(10)
             DCL        VAR(&OBJTYPE)    TYPE(*CHAR) LEN(7)
             DCL        VAR(&OBJFROMLIB) TYPE(*CHAR) LEN(10)
             DCL        VAR(&OBJTOLIB)   TYPE(*CHAR) LEN(10)

             DLTOBJ     OBJNAME(&OBJNAME) OBJTYPE(&OBJTYPE) +
                          OBJLIB(&OBJTOLIB)
             IF         COND(&OBJTYPE *EQ '*FILE') THEN(CRTDUPOBJ +
                          OBJ(&OBJNAME) FROMLIB(&OBJFROMLIB) +
                          OBJTYPE(&OBJTYPE) TOLIB(&OBJTOLIB) +
                          DATA(*YES))
             ELSE       CMD(CRTDUPOBJ OBJ(&OBJNAME) +
                          FROMLIB(&OBJFROMLIB) OBJTYPE(&OBJTYPE) +
                          TOLIB(&OBJTOLIB))

             DLTOBJ     OBJNAME(&OBJNAME) OBJTYPE(&OBJTYPE) +
                          OBJLIB(&OBJFROMLIB)

