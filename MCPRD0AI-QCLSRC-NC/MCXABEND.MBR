/*** CHANGE THE JOB LOG PRINT FILE TO FORCE THE JOB LOG TO GO ***/
/*** INTO OUTQ "MCMGR"                                        ***/
             PGM
             DCL        VAR(&TERMINAL) TYPE(*CHAR) LEN(10)
             DCL        VAR(&USER)     TYPE(*CHAR) LEN(10)
             DCL        VAR(&NUMBER)   TYPE(*CHAR) LEN(10)
             DCL        VAR(&OUTQ)     TYPE(*CHAR) LEN(10)
             DCL        VAR(&TYPE)     TYPE(*CHAR) LEN(10)
             DCL        VAR(&CURLIB)   TYPE(*CHAR) LEN(10)
             DCL        VAR(&TRANS)    TYPE(*CHAR) LEN(4)
             DCL        VAR(&SENDSTRING) TYPE(*CHAR) LEN(300)

             OVRPRTF    FILE(QPJOBLOG) OUTQ(MCMGR) USRDTA(MCABEND)
             MONMSG     MSGID(CPF0000)
             DSPJOBLOG  OUTPUT(*PRINT)
             MONMSG     MSGID(CPF0000)
             DLTOVR     FILE(QPJOBLOG)
             MONMSG     MSGID(CPF0000)

             /*** PRINT THE JOB INFORMATION- FOR NOW WILL NOT USE ***/
          /* OVRPRTF    FILE(QPDSPJOB) OUTQ(MCMGR) USRDTA(MCABEND)*/
          /* MONMSG     MSGID(CPF0000)                            */
          /* DSPJOB     OUTPUT(*PRINT)                            */
          /* MONMSG     MSGID(CPF0000)                            */
          /* DLTOVR     FILE(QPDSPJOB)                            */
          /* MONMSG     MSGID(CPF0000)                            */

             RTVJOBA    JOB(&TERMINAL) USER(&USER) NBR(&NUMBER) +
                          OUTQ(&OUTQ) TYPE(&TYPE) CURLIB(&CURLIB)

             RTVDTAARA  DTAARA(*LDA (108 4)) RTNVAR(&TRANS)

             CHGVAR     VAR(&SENDSTRING) VALUE('*** CSIS/MMIS +
                          ABEND!! Terminal: ' *CAT &TERMINAL *TCAT ' +
                          User: ' *CAT &USER *TCAT ' Job num: ' *CAT +
                          &NUMBER *TCAT ' OUTQ: ' *CAT &OUTQ *TCAT ' +
                          JOBTYPE: ' *CAT &TYPE *TCAT ' +
                          Curlib: ' *CAT &CURLIB *TCAT ' +
                          TRANS: ' *CAT &TRANS *TCAT ' ***')
             ENDPGM
