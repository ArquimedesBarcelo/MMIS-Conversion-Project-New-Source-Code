PGM PARM(&DBPARMS &FSW &CC &QRECS &RSW)
             DCL        VAR(&DBPARMS) TYPE(*CHAR) LEN(600)
             DCL        VAR(&FSW)     TYPE(*DEC)  LEN(4)
             DCL        VAR(&CC)      TYPE(*CHAR) LEN(20)
             DCL        VAR(&QRECS)   TYPE(*CHAR) LEN(280)
             DCL        VAR(&RSW)     TYPE(*DEC)  LEN(4)
             CHKOBJ     OBJ(QTEMP/AUTOQC) OBJTYPE(*FILE)
             MONMSG     MSGID(CPF9800) EXEC(DO)
             CRTPF      FILE(QTEMP/AUTOQC) RCDLEN(60) SIZE(1000 0 0) +
                          ALLOCATE(*YES)
             ENDDO
             CLRPFM     FILE(QTEMP/AUTOQC)
             OVRDBF     FILE(AUTOQC) TOFILE(QTEMP/AUTOQC)
             CALL       PGM(*LIBL/TAUTOQC) PARM(&DBPARMS &FSW &CC &QRECS &RSW)
             DLTOVR     FILE(AUTOQC)
             ENDPGM
