             CHKOBJ     OBJ(QTEMP/OUTSHIFT) OBJTYPE(*FILE)
             MONMSG     MSGID(CPF9800) EXEC(DO)
             CRTPF      FILE(QTEMP/OUTSHIFT) RCDLEN(110)
             ENDDO
             CLRPFM     FILE(QTEMP/OUTSHIFT)
             OVRDBF     FILE(OUTSHIFT) TOFILE(QTEMP/OUTSHIFT)
             DLTOVR     FILE(OUTSHIFT)
             ENDPGM
