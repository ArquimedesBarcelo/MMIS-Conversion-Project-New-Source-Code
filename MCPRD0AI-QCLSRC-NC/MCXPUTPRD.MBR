             PGM        PARM(&OBJ &TYP)
             DCL        VAR(&OBJ)       TYPE(*CHAR) LEN(10)
             DCL        VAR(&TYP)       TYPE(*CHAR) LEN(4)
             DCL        VAR(&FILE)      TYPE(*CHAR) LEN(10)
             DCL        VAR(&LIBRARY)   TYPE(*CHAR) LEN(10)
             DCL        VAR(&MSGID)     TYPE(*CHAR) LEN(8)
             DCL        VAR(&MSGF)      TYPE(*CHAR) LEN(10)
             DCL        VAR(&MSGLIB)    TYPE(*CHAR) LEN(10)
             DCL        VAR(&MESSAGE)   TYPE(*CHAR) LEN(60)
             DCL        VAR(&LOGICAL)   TYPE(*CHAR) LEN(1)
             DCL        VAR(&NOTINBCK)  TYPE(*LGL)  LEN(1) VALUE('0')
             DCL        VAR(&NOTINPRD)  TYPE(*LGL)  LEN(1) VALUE('0')
             DCL        VAR(&OBJTYP)    TYPE(*CHAR) LEN(5)

             IF (&TYP *NE '*D') DO
                GOTO GETFILE
                ENDDO
             CHGVAR     VAR(&TYP) VALUE(%SST(&OBJ 3 1))
             IF ((&TYP *EQ 'F') *OR +
                 (&TYP *EQ 'X') *OR +
                 (&TYP *EQ 'C')) DO
                GOTO GETFILE
                ENDDO
             GOTO MC00001
 GETFILE:
             IF ((&TYP *EQ 'F   ') *OR (&TYP *EQ 'DDS')) DO
                CHGVAR  VAR(&FILE) VALUE('QDDSSRC')
                CHGVAR  VAR(&OBJTYP) VALUE('*FILE')
                ENDDO
             IF ((&TYP *EQ 'C   ') *OR (&TYP *EQ 'CBL') +
                                   *OR (&TYP *EQ 'LBL')) DO
                CHGVAR  VAR(&FILE) VALUE('QLBLSRC')
                CHGVAR  VAR(&OBJTYP) VALUE('*PGM')
                ENDDO
             IF ((&TYP *EQ 'X   ') *OR (&TYP *EQ 'CL ') +
                                   *OR (&TYP *EQ 'CLP')) DO
                CHGVAR  VAR(&FILE) VALUE('QCLSRC')
                CHGVAR  VAR(&OBJTYP) VALUE('*PGM')
                ENDDO
             IF  (&TYP *EQ 'CMD ') DO
                CHGVAR  VAR(&FILE) VALUE('QCMDSRC')
                CHGVAR  VAR(&OBJTYP) VALUE('*CMD')
                ENDDO
             IF  (&TYP *EQ 'CPYC') DO
                CHGVAR  VAR(&FILE) VALUE('COPYLIB')
                CHGVAR  VAR(&OBJTYP) VALUE('COPY')
               ENDDO
             IF  (&TYP *EQ 'CPYM') DO
                CHGVAR  VAR(&FILE) VALUE('COPYLIB')
                CHGVAR  VAR(&OBJTYP) VALUE('COPY')
               ENDDO
 CHECKSRC:   CHKOBJ     OBJ(MCQA/&FILE) OBJTYPE(*FILE) MBR(&OBJ) +
                          AUT(*OBJEXIST)
             MONMSG     MSGID(CPF0000) EXEC(GOTO MC00005)
             IF (&OBJTYP *EQ 'COPY') DO
                 GOTO COPYSRC
                 ENDDO
 CHECKQA:    CHKOBJ     OBJ(MCQA/&OBJ) OBJTYPE(&OBJTYP) +
                          AUT(*ALL)
             MONMSG     MSGID(CPF9801) EXEC(GOTO CMDLBL(MC00004))
             MONMSG     MSGID(CPF9802) EXEC(DO)
                        CHGVAR VAR(&LIBRARY) VALUE('MCQA')
                        GOTO MC00007
                        ENDDO
 CHECKPRD:   CHKOBJ     OBJ(MCPRD/&OBJ) OBJTYPE(&OBJTYP) +
                          AUT(*ALL)
             MONMSG     MSGID(CPF9801) EXEC(DO)
                        CHGVAR     VAR(&NOTINPRD) VALUE('1')
                        GOTO CHECKBCK
                        ENDDO
             MONMSG     MSGID(CPF9802) EXEC(DO)
                        CHGVAR VAR(&LIBRARY) VALUE('MCPRD')
                        GOTO MC00007
                        ENDDO
 CHECKBCK:   CHKOBJ     OBJ(MCBCK/&OBJ) OBJTYPE(&OBJTYP) +
                          AUT(*ALL)
             MONMSG     MSGID(CPF9801) EXEC(DO)
                        CHGVAR     VAR(&NOTINBCK) VALUE('1')
                        GOTO CHECKFILE
                        ENDDO
             MONMSG     MSGID(CPF9802) EXEC(DO)
                        CHGVAR VAR(&LIBRARY) VALUE('MCBCK')
                        GOTO MC00007
                        ENDDO
 CHECKFILE:  IF  (&OBJTYP *EQ '*FILE') DO
                 CHGLF      FILE(MCQA/&OBJ)
                 MONMSG CPF0000  EXEC(GOTO DELBACK)
                 CHGVAR &LOGICAL VALUE('1')
                 ENDDO
DELBACK:     IF  &NOTINBCK DO
                 GOTO MOVEPRD
                 ENDDO
             CHGVAR &LIBRARY VALUE('MCBCK')
             IF (&OBJTYP *EQ '*PGM') DO
                 DLTPGM MCBCK/&OBJ
                 MONMSG     MSGID(CPF0000) EXEC(GOTO CMDLBL(MC00013))
                 ENDDO

             IF (&OBJTYP *EQ '*FILE') DO
                 DLTF MCBCK/&OBJ
                 MONMSG     MSGID(CPF0000) EXEC(GOTO CMDLBL(MC00013))
                 ENDDO

             IF (&OBJTYP *EQ '*CMD') DO
                 DLTCMD MCBCK/&OBJ
                 MONMSG     MSGID(CPF0000) EXEC(GOTO CMDLBL(MC00013))
                 ENDDO

MOVEPRD:     IF (&LOGICAL *EQ '1') DO
                 GOTO CRTDUP
                 ENDDO
             IF  &NOTINPRD DO
                 GOTO MOVEQA
                 ENDDO
             IF (&OBJTYP *EQ '*PGM') DO
                 /* ONLY MOVE PGM SOURCE, NOT OBJECT */
                 DLTOBJ     OBJNAME(&OBJ) OBJTYPE(*PGM) OBJLIB(MCPRD)
                 GOTO MOVEQA
                 ENDDO
             MOVOBJ     OBJ(MCPRD/&OBJ) OBJTYPE(&OBJTYP) TOLIB(MCBCK)
             MONMSG     MSGID(CPF0610) EXEC(DO)
                        CHGVAR VAR(&LIBRARY) VALUE('MCPRD')
                        GOTO MC00009
                        ENDDO
 MOVEQA:     MOVOBJ     OBJ(MCQA/&OBJ) OBJTYPE(&OBJTYP) TOLIB(MCPRD)
             MONMSG     MSGID(CPF0610) EXEC(DO)
                        CHGVAR VAR(&LIBRARY) VALUE('MCQA')
                        GOTO MC00009
                        ENDDO
             GOTO COPYSRC
 CRTDUP:     CRTDUPOBJ  OBJ(&OBJ) FROMLIB(MCPRD) OBJTYPE(*FILE) +
                          TOLIB(MCBCK)
             MONMSG     MSGID(CPF0000)
             CHGVAR &LIBRARY VALUE('MCPRD')
             DLTF       FILE(MCPRD/&OBJ)
             MONMSG     MSGID(CPF0610) EXEC(GOTO CMDLBL(MC00009))
             MONMSG     MSGID(CPF0000) EXEC(GOTO CMDLBL(MC00013))
             CRTDUPOBJ  OBJ(&OBJ) FROMLIB(MCQA) OBJTYPE(*FILE) +
                          TOLIB(MCPRD)
             CHGVAR &LIBRARY VALUE('MCQA')
             DLTF       FILE(MCQA/&OBJ)
             MONMSG     MSGID(CPF0610) EXEC(GOTO CMDLBL(MC00009))
             MONMSG     MSGID(CPF0000) EXEC(GOTO CMDLBL(MC00013))
 COPYSRC:    CALL MCXCPYSRCP PARM(&OBJ &FILE)
             GOTO EOJ
 MC00001:    SNDPGMMSG  MSGID(MC00001) MSGF(*LIBL/MCFPMSG) +
                          MSGDTA(&OBJ) MSGTYPE(*ESCAPE)
             GOTO EOJ
 MC00004:    SNDPGMMSG  MSGID(MC00004) MSGF(*LIBL/MCFPMSG) +
                          MSGDTA(&OBJ) MSGTYPE(*ESCAPE)
             GOTO EOJ
 MC00005:    SNDPGMMSG  MSGID(MC00005) MSGF(*LIBL/MCFPMSG) +
                          MSGDTA(&OBJ || &FILE) MSGTYPE(*ESCAPE)
             GOTO EOJ
 MC00007:    SNDPGMMSG  MSGID(MC00007) MSGF(*LIBL/MCFPMSG) +
                          MSGDTA(&OBJ) MSGTYPE(*ESCAPE)
             GOTO EOJ
 MC00008:    DSPMSG
             GOTO EOJ
 MC00009:    SNDPGMMSG  MSGID(MC00009) MSGF(*LIBL/MCFPMSG) +
                          MSGDTA(&OBJ || &LIBRARY) MSGTYPE(*ESCAPE)
             GOTO EOJ
 MC00013:    SNDPGMMSG  MSGID(MC00013) MSGF(*LIBL/MCFPMSG) +
                          MSGDTA(&OBJ || &LIBRARY) MSGTYPE(*ESCAPE)
             GOTO EOJ
 EOJ:        ENDPGM
