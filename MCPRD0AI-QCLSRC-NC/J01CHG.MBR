             PGM
/*****************************************************************/
/*** PROGRAM: J01CHG                                           ***/
/*** PURPOSE: TO SUBMIT JOBS TO CHANGE THE CSIS/MMIS DATA BASE ***/
/***          FILES (PHYSICAL AND LOGICAL) FOR THE J01 RELEASE.***/
/***                                                           ***/
/***          THIS PROGRAM WILL SUBMIT 7 DIFFERENT JOBS (FOR   ***/
/***          SUBSET OF CSIS/MMIS) WITH A JOBD AND USER OF     ***/
/***          PD01.                                            ***/
/*****************************************************************/

             SBMJOB     CMD(CALL PGM(MCPRD/J01CSAS)) JOB(J01CSAS) +
                          JOBD(PD01) USER(PD01)
             SBMJOB     CMD(CALL PGM(MCPRD/J01DRWFIL)) +
                          JOB(J01DRWFIL) JOBD(PD01) USER(PD01)
             SBMJOB     CMD(CALL PGM(MCPRD/J01EQPREF)) +
                          JOB(J01EQPREF) JOBD(PD01) USER(PD01)
             SBMJOB     CMD(CALL PGM(MCPRD/J01MMISA)) JOB(J01MMISA) +
                          JOBD(PD01) USER(PD01)
             SBMJOB     CMD(CALL PGM(MCPRD/J01PWORD)) JOB(J01PWORD) +
                          JOBD(PD01) USER(PD01)
             SBMJOB     CMD(CALL PGM(MCPRD/J01STHIST)) +
                          JOB(J01STHIST) JOBD(PD01) USER(PD01)
             SBMJOB     CMD(CALL PGM(MCPRD/J01STORES)) +
                          JOB(J01STORES) JOBD(PD01) USER(PD01)

