             PGM        /*FCXACCUMFX*/
             OVRDBF     FILE(MCFLCS0101) SHARE(*YES)
             OVRDBF     FILE(MCFLCS1201) SHARE(*YES)
             OVRDBF     FILE(MCFLCS1001) SHARE(*YES)
             OPNDBF     FILE(MCFLCS0101) OPTION(*ALL)
             OPNDBF     FILE(MCFLCS1201) OPTION(*ALL)
             OPNDBF     FILE(MCFLCS1001) OPTION(*ALL)
             /***********************************************/
             /***** PARAMETERS ARE:                    ******/
             /*****     UPDATE FLAG              X(1)  ******/
             /*****     SKIP RECALLED RCVRS?     X(1)  ******/
             /*****     CHECK RCV/STR DATES?     X(1)  ******/
             /*****     NUMBER OF UPDATES TO DO  9(6)  ******/
             /***********************************************/
             OVRPRTF MCPRT MCPRT97
             CALL       TACCUMFX PARM('NYN999999MELINDA MADDEN')
             CLOF       OPNID(MCFLCS0101)
             CLOF       OPNID(MCFLCS1201)
             CLOF       OPNID(MCFLCS1001)
             SNDNETSPLF FILE(MCPRT) TOUSRID((PRINTIT AKRON60)) +
                          SPLNBR(*LAST)
ENDPGM
