             PGM
/*********************************************************************/
/**  TO BE RUN PRIOR TO CUTTING A RELEASE FROM MCBETA TO SEND TO A   */
/**  LOCATION THAT TRANSLATES DISPLAY FILES.                         */
/**                                                                  */
/**  THIS PROGRAM WILL BUILD A FILE IN MCBETA TO BE SENT TO THE      */
/**  PLANTS FOR A NEW RELEASE WHICH WILL CONTAIN A LIST OF CHANGED   */
/**  DISPLAY FILES FOR A NEW RELEASE.  THIS FILE IS BUILT USING      */
/**  DSPFD FOR ALL *DSPF OBJECTS IN MCBETA.  PROGRAM CSMMDSPF2 WILL  */
/**  BE RUN AT THE PLANT AND WILL READ THIS FILE TO GIVE A REPORT ON */
/**  CHANGED *DSP AND DELETE THE DISPLAY FILES FROM THE TRANSALATED  */
/**  LIBRARY.                                                        */
/**                                                                  */
/**  THE QUERY "DISPLAYF" WILL ALSO BE RUN FROM THIS PROGRAM TO GIVE */
/**  A LIST OF CHANGED DISPLAY FILES.                                */
/**                                                                  */
/**  ANOTHER FILE WILL BE BUILT IN MCBETA FROM THE TAATOOL PRTSRCCHG */
/**  COMMAND TO LIST SPECIFIC STATEMENTS THAT HAVE CHANGED IN EACH   */
/**  MEMBER OF MCBETA/QDDSSRC TO ASSIST THE PLANT IN CHANGING THEIR  */
/**  DDS IN THE MCLNG LIBRARY.                                       */
/**                                                                  */
/*********************************************************************/

             DLTF       FILE(MCBETA/DISPLAYF)
             MONMSG     MSGID(CPF0000)

             /* CREATE FILE OF CHANGED DSPF IN MCBETA */
             DSPFD      FILE(MCBETA/Z*) TYPE(*ATR) OUTPUT(*OUTFILE) +
                          FILEATR(*DSPF) OUTFILE(MCBETA/DISPLAYF)
             RUNQRY     QRY(DISPLAYF) OUTTYPE(*PRINTER)

             /* CREATE FILE OF CHANGED STATEMENTS IN MCBETA          */
             /*    SET THE FROMDATE TO THE LAST GENERAL RELEASE DATE */
             PRTSRCCHG  MBR(*ALL) SRCFILE(MCBETA/QDDSSRC) +
                          FROMDATE(941118)
             CRTPF      FILE(MCBETA/QDDSSRCCHG) RCDLEN(132) +
                          TEXT('QDDSSRC Statement Changes for +
                          Release Update') SIZE(*NOMAX)
             MONMSG     MSGID(CPF7302) EXEC(CLRPFM +
                          FILE(MCBETA/QDDSSRCCHG))
             CPYSPLF    FILE(QDDSSRC) TOFILE(MCBETA/QDDSSRCCHG) +
                          SPLNBR(*LAST)

FINI:
             ENDPGM
