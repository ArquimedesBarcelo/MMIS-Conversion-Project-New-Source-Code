PGM
/******************************************************************/
/***                                                            ***/
/***          STORES DATABASE OVERRIDES                         ***/
/***                                                            ***/
/******************************************************************/
             OVRDBF     FILE(MCFLCS0201) SHARE(*YES)
             MONMSG     MSGID(CPF0000)
             OVRDBF     FILE(MCFLCS0401) SHARE(*YES)
             MONMSG     MSGID(CPF0000)
             OVRDBF     FILE(MCFLCS0501) SHARE(*YES)
             MONMSG     MSGID(CPF0000)
             OVRDBF     FILE(MCFLCS0701) SHARE(*YES)
             MONMSG     MSGID(CPF0000)
             OVRDBF     FILE(MCFLCS0802) SHARE(*YES)
             MONMSG     MSGID(CPF0000)
             OVRDBF     FILE(MCFLCS0901) SHARE(*YES)
             MONMSG     MSGID(CPF0000)
             OVRDBF     FILE(MCFLCS1002) SHARE(*YES)
             MONMSG     MSGID(CPF0000)
             OVRDBF     FILE(MCFLCS1101) SHARE(*YES)
             MONMSG     MSGID(CPF0000)
             OVRDBF     FILE(MCFLCS1401) SHARE(*YES)
             MONMSG     MSGID(CPF0000)
             OVRDBF     FILE(MCFLCS1601) SHARE(*YES)
             MONMSG     MSGID(CPF0000)
             OVRDBF     FILE(MCFLCS1901) SHARE(*YES)
             MONMSG     MSGID(CPF0000)
             OVRDBF     FILE(MCFLCS2001) SHARE(*YES)
             MONMSG     MSGID(CPF0000)
             OVRDBF     FILE(MCFLCS2101) SHARE(*YES)
             MONMSG     MSGID(CPF0000)
             OVRDBF     FILE(MCFLCS3101) SHARE(*YES)
             MONMSG     MSGID(CPF0000)
             OVRDBF     FILE(MCFLCS3603) SHARE(*YES)
             MONMSG     MSGID(CPF0000)

/******************************************************************/
/***                                                            ***/
/***       STORES DATABASE OPENS                                ***/
/***                                                            ***/
/******************************************************************/
             OPNDBF     FILE(MCFLCS0201) OPTION(*ALL)
             MONMSG     MSGID(CPF0000)
             OPNDBF     FILE(MCFLCS0401) OPTION(*ALL)
             MONMSG     MSGID(CPF0000)
             OPNDBF     FILE(MCFLCS0501) OPTION(*ALL)
             MONMSG     MSGID(CPF0000)
             OPNDBF     FILE(MCFLCS0701) OPTION(*ALL)
             MONMSG     MSGID(CPF0000)
             OPNDBF     FILE(MCFLCS0802) OPTION(*ALL)
             MONMSG     MSGID(CPF0000)
             OPNDBF     FILE(MCFLCS0901) OPTION(*ALL)
             MONMSG     MSGID(CPF0000)
             OPNDBF     FILE(MCFLCS1002) OPTION(*ALL)
             MONMSG     MSGID(CPF0000)
             OPNDBF     FILE(MCFLCS1101) OPTION(*ALL)
             MONMSG     MSGID(CPF0000)
             OPNDBF     FILE(MCFLCS1401) OPTION(*ALL)
             MONMSG     MSGID(CPF0000)
             OPNDBF     FILE(MCFLCS1601) OPTION(*ALL)
             MONMSG     MSGID(CPF0000)
             OPNDBF     FILE(MCFLCS1901) OPTION(*ALL)
             MONMSG     MSGID(CPF0000)
             OPNDBF     FILE(MCFLCS2001) OPTION(*ALL)
             MONMSG     MSGID(CPF0000)
             OPNDBF     FILE(MCFLCS2101) OPTION(*ALL)
             MONMSG     MSGID(CPF0000)
             OPNDBF     FILE(MCFLCS3101) OPTION(*ALL)
             MONMSG     MSGID(CPF0000)
             OPNDBF     FILE(MCFLCS3603) OPTION(*ALL)
             MONMSG     MSGID(CPF0000)


/*** CALL SHIPPING RELEASE PROGRAM 'TRELBATC' (COBOL)              ***/
         CALL TRELBATC

/******************************************************************/
/***                                                            ***/
/***       STORES DATABASE CLOSES                               ***/
/***                                                            ***/
/******************************************************************/
             CLOF     OPNID(MCFLCS0201)
             MONMSG     MSGID(CPF0000)
             CLOF     OPNID(MCFLCS0401)
             MONMSG     MSGID(CPF0000)
             CLOF     OPNID(MCFLCS0501)
             MONMSG     MSGID(CPF0000)
             CLOF     OPNID(MCFLCS0701)
             MONMSG     MSGID(CPF0000)
             CLOF     OPNID(MCFLCS0802)
             MONMSG     MSGID(CPF0000)
             CLOF     OPNID(MCFLCS0901)
             MONMSG     MSGID(CPF0000)
             CLOF     OPNID(MCFLCS1002)
             MONMSG     MSGID(CPF0000)
             CLOF     OPNID(MCFLCS1101)
             MONMSG     MSGID(CPF0000)
             CLOF     OPNID(MCFLCS1401)
             MONMSG     MSGID(CPF0000)
             CLOF     OPNID(MCFLCS1601)
             MONMSG     MSGID(CPF0000)
             CLOF     OPNID(MCFLCS1901)
             MONMSG     MSGID(CPF0000)
             CLOF     OPNID(MCFLCS2001)
             MONMSG     MSGID(CPF0000)
             CLOF     OPNID(MCFLCS2101)
