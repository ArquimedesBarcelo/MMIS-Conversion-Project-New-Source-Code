             PGM        PARM(&SCOPE)

      /* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * */
      /* THIS PROGRAM IS A DUMMY VERSION OF MCXCBLERR.  IF A BATCH     */
      /* COBOL PROGRAM IS BLOWING UP DUE TO THE CALL TO MCXCBLERR THEN */
      /* THIS CL OBJECT SHOULD BE SENT TO THE PLANT. IT MUST BE        */
      /* RENAMED FROM MCXCBLERRX TO MCXCBLERR.  IT WILL DO NOTHING.    */
      /* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * */

             DCL        VAR(&SCOPE) TYPE(*CHAR) LEN(1)

             IF         COND(&SCOPE = 'C') THEN(GOTO CMDLBL(FINI))
             IF         COND(&SCOPE = 'P') THEN(GOTO CMDLBL(FINI))
 FINI:
             ENDPGM
