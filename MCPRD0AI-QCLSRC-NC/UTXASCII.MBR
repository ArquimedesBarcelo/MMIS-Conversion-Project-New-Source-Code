             PGM  PARM(&LFILE &FLIB &TLIB)
             DCL  VAR(&LFILE)    TYPE(*CHAR) LEN(1002)
             DCL  VAR(&FILE)     TYPE(*CHAR) LEN(10)
             DCL  VAR(&FLIB)     TYPE(*CHAR) LEN(10)
             DCL  VAR(&TLIB)     TYPE(*CHAR) LEN(10)
             DCL  VAR(&NLFILE)   TYPE(*DEC)  LEN(5 0)
             DCL  VAR(&ILFILE)   TYPE(*DEC)  LEN(5 0)
             DCL  VAR(&SLFILE)   TYPE(*DEC)  LEN(5 0)
             DCL  VAR(&XBIN)     TYPE(*CHAR) LEN(2)
             DCL  VAR(&MSGID)    TYPE(*CHAR) LEN(7)
             DCL  VAR(&MSGF)     TYPE(*CHAR) LEN(10)
             DCL  VAR(&MSGFLIB)   TYPE(*CHAR) LEN(10)
             DCL  VAR(&MSGDTA)    TYPE(*CHAR) LEN(80)
             MONMSG MSGID(CPF0000 MCH0000) EXEC(GOTO CPFERROR)
/* VERIFY FROMLIB, TOLIB  EXIST */
             CHKOBJ OBJ(&FLIB.QSYS) OBJTYPE(*LIB)
             CHKOBJ OBJ(&TLIB.QSYS) OBJTYPE(*LIB)
/* CONVERT NO OF VALUES IN FILE LIST */
             CHGVAR VAR(&XBIN) VALUE(%SST(&LFILE 1 2))
             CVTBINDEC  FROMBIN(&XBIN) TODEC(&NLFILE)
/* SET SUBSCRIPT TO FIRST LIST ELEMENT */
             CHGVAR VAR(&SLFILE)   VALUE(1)
TRANSLATE:
/* SET LIST OBJECT INDEX FROM SUBSCRIPT */
             CHGVAR VAR(&ILFILE) VALUE((((&SLFILE - 1) *10) +1) +2)
             CHGVAR VAR(&FILE) VALUE(%SST(&LFILE &ILFILE 10))
             CALL UTXASCII2 PARM(&FILE &FLIB &TLIB)
/* LAST LIST FILE ELEMENT ? */
             IF (&SLFILE *LT &NLFILE) DO
                CHGVAR VAR(&SLFILE) VALUE(&SLFILE + 1)
                GOTO TRANSLATE
             ENDDO
             RETURN
CPFERROR:
             RCVMSG     MSGTYPE(*EXCP) MSGDTA(&MSGDTA) MSGID(&MSGID) +
                          MSGF(&MSGF) MSGFLIB(&MSGFLIB)
             SNDPGMMSG  MSGID(&MSGID) MSGF(&MSGF.&MSGFLIB) +
                          MSGDTA(&MSGDTA)
             MONMSG MSGID(CPF0000)
             ENDPGM
