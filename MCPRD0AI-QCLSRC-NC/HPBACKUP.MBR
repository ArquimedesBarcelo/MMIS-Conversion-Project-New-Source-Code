PGM
             SNDBRKMSG  MSG('MMIS/CSIS system is going down in 15 +
                          minutes.  Please prepare to signoff.') +
                          TOMSGQ(*ALLWS)
             DLYJOB     DLY(300)
             SNDBRKMSG  MSG('MMIS/CSIS system is going down in 10 +
                          minutes.  Please prepare to signoff.') +
                          TOMSGQ(*ALLWS)
             DLYJOB     DLY(300)
             SNDBRKMSG  MSG('MMIS/CSIS system is going down in  5 +
                          minutes.  Please prepare to signoff.') +
                          TOMSGQ(*ALLWS)
             DLYJOB     DLY(300)
             SNDBRKMSG  MSG('MMIS/CSIS system is going down in 1 +
                          minute.Please signoff immediately...') +
                          TOMSGQ(*ALLWS)
             DLYJOB     DLY(60)
             ENDSBS     SBS(HP3000) OPTION(*IMMED)
             DLYJOB     DLY(60)
             ENDSBS     SBS(HP3000) OPTION(*IMMED)
             MONMSG     MSGID(CPF1054) EXEC(GOTO CMDLBL(SAV))
             MONMSG     MSGID(CPF0000)
             DLYJOB     DLY(60)
             ENDSBS     SBS(HP3000) OPTION(*IMMED)
             MONMSG     MSGID(CPF1054) EXEC(GOTO CMDLBL(SAV))
             MONMSG     MSGID(CPF0000)
             DLYJOB     DLY(60)
             ENDSBS     SBS(HP3000) OPTION(*IMMED)
             MONMSG     MSGID(CPF1054) EXEC(GOTO CMDLBL(SAV))
             MONMSG     MSGID(CPF0000)
             DLYJOB     DLY(60)
             ENDSBS     SBS(HP3000) OPTION(*IMMED)
             MONMSG     MSGID(CPF1054) EXEC(GOTO CMDLBL(SAV))
             MONMSG CPF0000
             GOTO ERR
SAV:         SAVLIB     LIB(MCPRD1) DEV(*SAVF) SAVF(MCBCK/BACKUP)
             MONMSG CPF0000
             STRSBS     SBSD(HP3000)
             MONMSG CPF0000
             SNDMSG     MSG('BACKUP HAS FINISHED - LOAD TAPE AND +
                          CALL HPTAPESAV') TOUSR(*SYSOPR)
             GOTO END
ERR:
             SNDMSG     MSG('''SUBSYSTEM HP3000 HAS NOT CANCELLED IN +
                          ALLOTED TIME - GO TO A COMMAND LINE, TYPE +
                          WRKACTJOB, THEN MANUALLY END ALL THE +
                          ACTIVE JOBS IN SUBSYSTEM HP3000.  WHEN +
                          FINISHED, ENDSBS HP3000.  THEN TYPE THE +
                          FOLLOWING COMMAND - SAVLIB LIB(MCPRD1) +
                          DEV(*SAVF) SAVF(MCBCK/BACKUP).  WHEN THAT +
                          IS FINISHED, SUBMIT THE JOB HPTAPESAV AS +
                          USUALL.') TOUSR(*SYSOPR)
END:
ENDPGM
