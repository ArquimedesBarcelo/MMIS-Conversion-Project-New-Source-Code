PGM        PARM(&FNUM)
DCL        VAR(&FNUM) TYPE(*CHAR) LEN(6)
DCL        VAR(&THEDFU) TYPE(*CHAR) LEN(9) VALUE('MCD')
             DCL        VAR(&THEFILE) TYPE(*CHAR) LEN(10) +
                          VALUE('MCFL')
CHGVAR VAR(%SST(&THEDFU 4 6)) VALUE(&FNUM)
CHGVAR VAR(%SST(&THEFILE 5 6)) VALUE(&FNUM)
             STRDFU     OPTION(1 1) DFUPGM(*LIBL/&THEDFU) +
                          FILE(*LIBL/&THEFILE) MBR(*FIRST)
ENDPGM
