         /*****************************************************/
         /*                                                   */
         /*    0 - WARNS SYSTEM USERS THAT THEIR SESSIONS     */
         /*        WILL BE CANCELLED IN 5 MINUTES IF THEY     */
         /*        DO NOT EXIT BEFORE THAT TIME.              */
         /*                                                   */
         /*    1 - SIGN OFF ALL SYSTEM USERS FOR              */
         /*        PROCEDURES WHICH REQUIRE EXCLUSIVE         */
         /*        ACCESS OF THE FILES.                       */
         /*  NOTE: CALLING PROGRAM MUST CREATE OR VERIFY THE  */
         /*        EXISTENCE OF FILE UTFPWRKF WITH A RECORD   */
         /*        LENGTH OF 132,  MEMBER UTFPWRKF.           */
         /*                                                   */
         /*****************************************************/
             PGM       PARM(&ACTION  &BUFILE1 &BUFILE2 &BUFILE3 +
                            &BUFILE4 &BUFILE5 &BUFLIB1 &BUFLIB2 +
                            &BUFLIB3 &BUFLIB4 &BUFLIB5)
             DCLF       FILE(UTFPWRKF)
             DCL        VAR(&ACTION)  TYPE(*CHAR) LEN(1)
             DCL        VAR(&BUFILE1) TYPE(*CHAR) LEN(10)
             DCL        VAR(&BUFILE2) TYPE(*CHAR) LEN(10)
             DCL        VAR(&BUFILE3) TYPE(*CHAR) LEN(10)
             DCL        VAR(&BUFILE4) TYPE(*CHAR) LEN(10)
             DCL        VAR(&BUFILE5) TYPE(*CHAR) LEN(10)
             DCL        VAR(&BUFLIB1) TYPE(*CHAR) LEN(10)
             DCL        VAR(&BUFLIB2) TYPE(*CHAR) LEN(10)
             DCL        VAR(&BUFLIB3) TYPE(*CHAR) LEN(10)
             DCL        VAR(&BUFLIB4) TYPE(*CHAR) LEN(10)
             DCL        VAR(&BUFLIB5) TYPE(*CHAR) LEN(10)
             DCL        VAR(&JOB)    TYPE(*CHAR) LEN(10)
             DCL        VAR(&SESSION) TYPE(*CHAR) LEN(01)
             DCL        VAR(&USER)   TYPE(*CHAR) LEN(10)
             DCL        VAR(&NBR)    TYPE(*CHAR) LEN(06)
             DCL        VAR(&CJOB)   TYPE(*CHAR) LEN(10)
             DCL        VAR(&CUSR)   TYPE(*CHAR) LEN(10)
             DCL        VAR(&CNBR)   TYPE(*CHAR) LEN(06)
             DCL        VAR(&CHR)    TYPE(*CHAR) LEN(01)
             DCL        VAR(&MSG)    TYPE(*CHAR) LEN(125)
             DCL        VAR(&MSGDTA) TYPE(*CHAR) LEN(75)
             DCL        VAR(&MSGID)  TYPE(*CHAR) LEN(07)
             DCL        VAR(&MSGQ)   TYPE(*CHAR) LEN(10)
             DCL        VAR(&JOBBYTE1) TYPE(*DEC) LEN(2 0) VALUE(15)
             DCL        VAR(&SESBYTE1) TYPE(*DEC) LEN(2 0) VALUE(22)
             DCL        VAR(&USRBYTE1) TYPE(*DEC) LEN(2 0) VALUE(26)
             DCL        VAR(&NBRBYTE1) TYPE(*DEC) LEN(2 0) VALUE(37)
             DCL        VAR(&ASTBYTE1) TYPE(*DEC) LEN(2 0) VALUE(54)
             RTVJOBA    JOB(&JOB) USER(&USER) NBR(&NBR)
             CLRPFM     FILE(QTEMP/UTFPWRKF)
             OVRPRTF    FILE(QPDSPOLK) OUTQ(QPRINT) HOLD(*YES)

         /*****************************************************/
         /*  IF HE WANTS TO LOG OFF ALL USERS THAT HAVE A     */
         /*  LIBRARY LOCKED (RATHER THAN A FILE), HE SETS THE */
         /*  FIRST FILE TO 'LIB'.  CURRENTLY ONLY HANDLES ONE */
         /*  LIBRARY.  NOTE: THE SPOOLFILE FORMAT FOR         */
         /*  WRKOBJLCK *LIB IS DIFFERENT THAN FOR FILES.      */
         /*****************************************************/
             IF         COND(&BUFILE1 *EQ 'LIB') THEN(DO)
               CHGVAR VAR(&JOBBYTE1) VALUE(4)
               CHGVAR VAR(&SESBYTE1) VALUE(11)
               CHGVAR VAR(&USRBYTE1) VALUE(16)
               CHGVAR VAR(&NBRBYTE1) VALUE(28)
               CHGVAR VAR(&ASTBYTE1) VALUE(37)
               WRKOBJLCK  OBJ(*LIBL/&BUFLIB1) OBJTYPE(*LIB) +
                            OUTPUT(*PRINT)
               CPYSPLF    FILE(QPDSPOLK) TOFILE(QTEMP/UTFPWRKF) +
                            JOB(&NBR/&USER/&JOB)
               DLTSPLF    FILE(QPDSPOLK) JOB(&NBR/&USER/&JOB)
             GOTO       CMDLBL(SKIPIT)
             ENDDO

         /*****************************************************/
         /*    BEGIN GATHERING A LIST OF USERS OF THE         */
         /*    KEY FILES WHO ARE CURRENTLY ACTIVE.            */
         /*    THEY WILL BE LOGGED OFF AFTER THE LIST         */
         /*    IS COMPLETE.                                   */
         /*****************************************************/
             IF         COND(&BUFILE1 *NE ' ') THEN(DO)
             WRKOBJLCK  OBJ(&BUFLIB1/&BUFILE1) OBJTYPE(*FILE) +
                          MBR(*ALL) OUTPUT(*PRINT)
             CPYSPLF    FILE(QPDSPOLK) TOFILE(QTEMP/UTFPWRKF) +
                          JOB(&NBR/&USER/&JOB)
             DLTSPLF    FILE(QPDSPOLK) JOB(&NBR/&USER/&JOB)
             ENDDO
             IF         COND(&BUFILE2 *NE ' ') THEN(DO)
             WRKOBJLCK  OBJ(&BUFLIB2/&BUFILE2) OBJTYPE(*FILE) +
                          MBR(*ALL) OUTPUT(*PRINT)
             CPYSPLF    FILE(QPDSPOLK) TOFILE(QTEMP/UTFPWRKF) +
                          JOB(&NBR/&USER/&JOB) MBROPT(*ADD)
             DLTSPLF    FILE(QPDSPOLK) JOB(&NBR/&USER/&JOB)
             ENDDO
             IF         COND(&BUFILE3 *NE ' ') THEN(DO)
             WRKOBJLCK  OBJ(&BUFLIB3/&BUFILE3) OBJTYPE(*FILE) +
                          MBR(*ALL) OUTPUT(*PRINT)
             CPYSPLF    FILE(QPDSPOLK) TOFILE(QTEMP/UTFPWRKF) +
                          JOB(&NBR/&USER/&JOB) MBROPT(*ADD)
             DLTSPLF    FILE(QPDSPOLK) JOB(&NBR/&USER/&JOB)
             ENDDO
             IF         COND(&BUFILE4 *NE ' ') THEN(DO)
             WRKOBJLCK  OBJ(&BUFLIB4/&BUFILE4) OBJTYPE(*FILE) +
                          MBR(*ALL) OUTPUT(*PRINT)
             CPYSPLF    FILE(QPDSPOLK) TOFILE(QTEMP/UTFPWRKF) +
                          JOB(&NBR/&USER/&JOB) MBROPT(*ADD)
             DLTSPLF    FILE(QPDSPOLK) JOB(&NBR/&USER/&JOB)
             ENDDO
             IF         COND(&BUFILE5 *NE ' ') THEN(DO)
             WRKOBJLCK  OBJ(&BUFLIB5/&BUFILE5) OBJTYPE(*FILE) +
                          MBR(*ALL) OUTPUT(*PRINT)
             CPYSPLF    FILE(QPDSPOLK) TOFILE(QTEMP/UTFPWRKF) +
                          JOB(&NBR/&USER/&JOB) MBROPT(*ADD)
             DLTSPLF    FILE(QPDSPOLK) JOB(&NBR/&USER/&JOB)
             ENDDO

 SKIPIT:
         /*****************************************************/
         /*    THE LIST HAS BEEN GENERATED.  IF &ACTION = 0,  */
         /*    THE USERS WILL BE WARNED.  IF &ACTION = 1,     */
         /*    THE USERS WILL BE LOGGED OFF THE SYSTEM.       */
         /*****************************************************/
             IF         COND(&ACTION *EQ '0') THEN(DO)
 READ1:
             RCVF
             MONMSG     MSGID(CPF0000) EXEC(GOTO CMDLBL(ENDPGM))
             CHGVAR     VAR(&CHR) VALUE(%SST(&UTFPWRKF &JOBBYTE1 01))
             IF         COND(&CHR *EQ ' ') THEN(GOTO READ1)
             CHGVAR     VAR(&CHR) VALUE(%SST(&UTFPWRKF &ASTBYTE1 01))
             IF         COND(&CHR *EQ '*') THEN(DO)
                 CHGVAR  VAR(&CJOB) VALUE(%SST(&UTFPWRKF &JOBBYTE1 10))
                 CHGVAR  VAR(&CUSR) VALUE(%SST(&UTFPWRKF &USRBYTE1 10))
                 CHGVAR  VAR(&CNBR) VALUE(%SST(&UTFPWRKF &NBRBYTE1 06))
             CHGVAR     VAR(&MSG) VALUE('  THE COMPUTER REQUIRES THE +
                          FILES YOU ARE ACCESSING.  PLEASE LOGOFF WITHIN +
                          FIVE MINUTES. ')
                 CHGVAR     VAR(&MSGQ) VALUE(&CJOB)
                 SNDBRKMSG  MSG(&MSG) TOMSGQ(QSYS/&MSGQ)
                 MONMSG     MSGID(CPF0000)
 BYE1:       ENDDO
             GOTO       CMDLBL(READ1)
             ENDDO
             IF         COND(&ACTION *EQ '1') THEN(DO)
 READ2:
             RCVF
             MONMSG     MSGID(CPF0000) EXEC(GOTO CMDLBL(RCVMSG))
             CHGVAR     VAR(&CHR) VALUE(%SST(&UTFPWRKF &JOBBYTE1 01))
             IF         COND(&CHR *EQ ' ') THEN(GOTO READ2)
             CHGVAR     VAR(&CHR)   VALUE(%SST(&UTFPWRKF &ASTBYTE1 01))
             IF         COND(&CHR *EQ '*') THEN(DO)
                 CHGVAR  VAR(&CJOB) VALUE(%SST(&UTFPWRKF &JOBBYTE1 10))
                 CHGVAR  VAR(&CUSR) VALUE(%SST(&UTFPWRKF &USRBYTE1 10))
                 CHGVAR  VAR(&CNBR) VALUE(%SST(&UTFPWRKF &NBRBYTE1 06))
             CHGVAR     VAR(&MSG) VALUE('  THE COMPUTER REQUIRES THE +
                          FILES YOU ARE ACCESSING.  PLEASE TRY AG+
                          AIN LATER. ')
                 CHGVAR     VAR(&MSGQ) VALUE(&CJOB)
             SNDBRKMSG  MSG(&MSG) TOMSGQ(QSYS/&MSGQ)
             MONMSG     MSGID(CPF0000)
             ENDJOB     JOB(&CNBR/&CUSR/&CJOB) OPTION(*IMMED) +
                          LOGLMT(0)
             MONMSG     MSGID(CPF0000) EXEC(GOTO CMDLBL(BYE2))
 BYE2:       ENDDO
             GOTO       CMDLBL(READ2)
             ENDDO
 RCVMSG:
             RCVMSG     MSGDTA(&MSGDTA) MSGID(&MSGID)
             IF         COND(&MSGDTA *EQ ' ') THEN(GOTO CMDLBL(ENDPGM))
             SNDPGMMSG  MSGID(&MSGID) MSGF(QCPFMSG) +
                          MSGDTA(&MSGDTA)
             MONMSG     MSGID(CPF0000) EXEC(GOTO CMDLBL(ENDPGM))
             GOTO       CMDLBL(RCVMSG)
 ENDPGM:
             ENDPGM
