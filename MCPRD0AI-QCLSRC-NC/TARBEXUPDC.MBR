/*********************************************************************/
/** PROGRAM: TARBEXUPDC                                            ***/
/**                                                                ***/
/** PURPOSE: RUN CATALOG EXCEPTION UPDATE PROGRAM                  ***/
/**                                                                ***/
/** CREATED: 01/08/2004                                            ***/
/** AUTHOR : DAN RAUCH - eXLTech, LLC                              ***/
/**                                                                ***/
/*********************************************************************/
/** SPECIAL NOTES:                                                 ***/
/*********************************************************************/
PGM

             DCL        VAR(&RECORDS) TYPE(*DEC) LEN(10 0)
             CHGJOB     LOGCLPGM(*NO)

             CALL       PGM(TARBEXUPD)

             RTVMBRD    FILE(MCFPAB1600) NBRCURRCD(&RECORDS)

             IF         COND(&RECORDS > 0) THEN(DO)
             RGZPFM     FILE(MCFPAB1600)
             MONMSG     MSGID(CPF2981)
             ENDDO

ENDPGM
