/********************************************************************/
/* SEND FILE R3REQDATA TO SAPCOMM USING PGM CMX0510F.               */
/* THE MEMBER OF R3REQDATA TO BE SENT WILL BE A PASSED PARAMETER.   */
/********************************************************************/
             PGM PARM(&MBRIN)
             DCL        VAR(&RTNCODE) TYPE(*CHAR) LEN(2)
             DCL        VAR(&P1KEY) TYPE(*CHAR) LEN(10)
             DCL        VAR(&P1LOCC) TYPE(*CHAR) LEN(4)
             DCL        VAR(&MBRIN) TYPE(*CHAR) LEN(10)
             DCL        VAR(&P1SNDF) TYPE(*CHAR) LEN(10)
             DCL        VAR(&P1SNDL) TYPE(*CHAR) LEN(10)
/*           ADDLIBLE   LIB(CMPRD)                                  */
             CHGVAR     VAR(&P1KEY) VALUE('MMSREQ     ')
             CHGVAR     VAR(&P1LOCC) VALUE('N509')
             CHGVAR     VAR(&P1SNDF) VALUE('R3REQDATA ')
             CHGVAR     VAR(&P1SNDL) VALUE('MCPRD2    ')
             CALL       PGM(CMPRD/CMX0510F) PARM(&RTNCODE &P1KEY +
                          &P1LOCC &MBRIN &P1SNDF &P1SNDL)
/*           IF         COND(&RTNCODE *NE '00') THEN(DO)            */
/*               GOTO       CMDLBL(FINI)                            */
/*           ENDDO                                                  */
FINI:
             ENDPGM
