             PGM
/*****************************************************************/
/*** PROGRAM: G01WOPARTS                                       ***/
/*** PURPOSE: TO ADD AND CHANGE DATABASE FILES (PHYSICAL AND   ***/
/***          LOGICAL) FOR THE G01 WO PARTS.                   ***/
/*****************************************************************/
/*                                                               */
/*****************************************************************/
/**********                 STEP 1                ****************/
/**********           MMISA REFERENCE FILE        ****************/
/**********      DELETE PHYSICAL MMISA REF FILE   ****************/
/**********      CREATE PHYSICAL MMISA REF FILE   ****************/
/*****************************************************************/
             DLTF       FILE(MCPRD1/MMISA)
             MONMSG     MSGID(CPF2105)
             CRTPF      FILE(MCPRD1/MMISA) SRCFILE(*LIBL/QDDSSRCDB) +
                          SRCMBR(MMISA) TEXT('MMISA     Reference +
                          File') SIZE(*NOMAX)
             SNDMSG     MSG('Step 1 of 2 has COMPLETED NORMALLY in +
                          G01WOPARTS') TOUSR(*SYSOPR)
/*****************************************************************/
/**********                 STEP 2                ****************/
/************        MCFPMM1200  WO-PARTS PF      ****************/
/************  A) DELETE LOGICAL FILES            ****************/
/************  B) CREATE DUP OBJ OF PHYSICAL      ****************/
/************  C) DELETE PHYSICAL FILE            ****************/
/************  D) CREATE PHYSICAL FILE            ****************/
/************  E) COPY DUP OBJ INTO NEW PHYSICAL  ****************/
/************  F) CREATE LOGICAL FILES            ****************/
/************  G) DELETE DUP OBJ OF PHYSICAL      ****************/
/*****************************************************************/
/* STEP 2A */
             DLTF       FILE(MCPRD1/MCFLMM1201)
             MONMSG     MSGID(CPF2105)
/*         */
             DLTF       FILE(MCPRD1/MCFLMM1202)
             MONMSG     MSGID(CPF2105)
/*         */
             DLTF       FILE(MCPRD1/MCFLMM1203)
             MONMSG     MSGID(CPF2105)
/* STEP 2B */
             CRTDUPOBJ  OBJ(MCFPMM1200) FROMLIB(MCPRD1) +
                          OBJTYPE(*FILE) TOLIB(MCPRD1) +
                          NEWOBJ(MCFPMM120T) DATA(*YES)
/* STEP 2C */
             DLTF       FILE(MCPRD1/MCFPMM1200)
             MONMSG     MSGID(CPF2105)
/* STEP 2D */
             CRTPF      FILE(MCPRD1/MCFPMM1200) +
                          SRCFILE(*LIBL/QDDSSRCDB) +
                          SRCMBR(MCFPMM1200) TEXT('WO-PARTS         +
                          Physical File') SIZE(*NOMAX)
/* STEP 2E */
             CPYF       FROMFILE(MCPRD1/MCFPMM120T) +
                          TOFILE(MCPRD1/MCFPMM1200) MBROPT(*ADD) +
                          FMTOPT(*MAP)
/* STEP 2F */
             CRTLF      FILE(MCPRD1/MCFLMM1201) +
                          SRCFILE(*LIBL/QDDSSRCDB) +
                          SRCMBR(MCFLMM1201) TEXT('WO-PARTS         +
                          Logical File (WONUM)')
/*         */
             CRTLF      FILE(MCPRD1/MCFLMM1202) +
                          SRCFILE(*LIBL/QDDSSRCDB) +
                          SRCMBR(MCFLMM1202) TEXT('WO-PARTS         +
                          Logical File (PRTSTATUS)')
/*         */
             CRTLF      FILE(MCPRD1/MCFLMM1203) +
                          SRCFILE(*LIBL/QDDSSRCDB) +
                          SRCMBR(MCFLMM1203) TEXT('WO-PARTS         +
                          Logical File (PERCCNUM)')
/* STEP 2G */
             DLTF       FILE(MCPRD1/MCFPMM120T)
             MONMSG     MSGID(CPF2105)
             SNDMSG     MSG('Step 2 of 2 has COMPLETED NORMALLY in +
                          G01WOPARTS') TOUSR(*SYSOPR)
/*****************************************************************/
             DSPJOBLOG  OUTPUT(*PRINT)
             SNDMSG     MSG('G01WOPARTS has ENDED NORMALLY') TOUSR(*SYSOPR)
             ENDPGM
