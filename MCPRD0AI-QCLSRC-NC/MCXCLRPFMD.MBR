             PGM        /*MCXCLRPFMD*/
/**************************************************************************/
/* THIS PROGRAM CAN BE USED TO PERFORM A CLEAR PHYSICAL FILE COMMAND      */
/* (CLRPFM) ON EACH CSIS/MMIS/CSAS "DATABASE" PHYSICAL FILE.              */
/*                                                                        */
/* THIS PROGRAM INCLUDES CLRPFM COMMANDS FOR RELEASE D 0100 PHYSICAL      */
/* FILES HAVING NUMERIC SUFFIXES AND THE FOLLOWING PREFIXES:              */
/*    MCFPBG MCFPCA MCFPCS MCFPDF MCFPER MCFPMM MCFPPW MCFPST MCFPZP      */
/*                                                                        */
/* SPECIAL NOTES:                                                         */
/* - PHYSICAL FILES SUCH AS: MCFPBLOWUP, MCFPCACARR, AND MCFPCAMTD WILL   */
/*      NOT BE AFFECTED BY THIS PROGRAM.                                  */
/* - THIS PROGRAM IS HARDCODED TO CLEAR PHYSICAL FILES IN LIBRARY MCPRD1. */
/**************************************************************************/
             CLRPFM     FILE(MCPRD1/MCFPBG0100)
             MONMSG     MSGID(CPF0000)
             CLRPFM     FILE(MCPRD1/MCFPBG0200)
