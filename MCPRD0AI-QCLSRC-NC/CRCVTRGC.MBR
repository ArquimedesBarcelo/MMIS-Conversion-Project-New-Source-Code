             PGM        PARM(&PARM1 &PARM2)

             DCL        VAR(&PARM1) TYPE(*CHAR) LEN(1500)
             DCL        VAR(&PARM2) TYPE(*CHAR) LEN(2)


/*-------------------------------------------------------------------*/
/* CALL TRIGGER PROGRAM                                            ***/
/*-------------------------------------------------------------------*/
             CALL       PGM(CRCVTRG) PARM(&PARM1 &PARM2)
             RCLRSC

ENDPGM
