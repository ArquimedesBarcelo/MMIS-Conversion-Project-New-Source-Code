/*********************************************************************/
/** PROGRAM: M01CRTLFCL                                             **/
/**                                                                 **/
/** PURPOSE: CREATE LOGICALS  FROM QDDSSRCDB IN MCPRD               **/
/**                                                                 **/
/** CREATED: MAY 4, 2005                                            **/
/** AUTHOR : DAN RAUCH - EXLTECH,INC                                **/
/**                                                                 **/
/*********************************************************************/
/** SPECIAL NOTES:                                                  **/
/*********************************************************************/
             PGM        PARM(&DBFLIB &INPLIB)

             DCL        VAR(&FNAME) TYPE(*CHAR) LEN(10)
             DCL        VAR(&INPLIB) TYPE(*CHAR) LEN(10)
             DCL        VAR(&DBFLIB) TYPE(*CHAR) LEN(10)
             DCL        VAR(&MBRTYP) TYPE(*CHAR) LEN(10)
             DCL        VAR(&SYSNAM) TYPE(*CHAR) LEN(8)


             RTVNETA    SYSNAME(&SYSNAM)


READ1ST:
             RTVMBRD    FILE(&INPLIB/QDDSSRCDB) MBR(*FIRSTMBR) +
                          RTNMBR(&FNAME) SRCTYPE(&MBRTYP)
             MONMSG     MSGID(CPF9999) EXEC(GOTO CMDLBL(ENDIT))
             GOTO       CHECKIT

READNXT:

             RTVMBRD    FILE(&INPLIB/QDDSSRCDB) MBR(&FNAME *NEXT) +
                          RTNMBR(&FNAME) SRCTYPE(&MBRTYP)
             MONMSG     MSGID(CPF3049) EXEC(GOTO CMDLBL(ENDIT))

CHECKIT:
/** PROCESS ONLY LOGICAL FILE SOURCE MBRS                          **/
             IF COND(&MBRTYP *NE 'LF') THEN(DO)
             GOTO       READNXT
             ENDDO


             IF COND(&SYSNAM *EQ 'AKRON60') THEN(DO)
             GOTO       CONTINUE
             ENDDO


/**================================================================**/
/** PUT LOGICALS FOR THE JOB PARM AND DATAQ FILES IN MCPRD(&INPLIB) */
/** ELSE    PUT ALL OTHERS IN THE DB LIBRARY                        */
/**================================================================**/
             IF    COND(%SST(&FNAME 1 8) *EQ 'MCFLAB11'    +
                   *OR  %SST(&FNAME 1 8) *EQ 'MCFLAB12'    +
                   *OR  %SST(&FNAME 1 8) *EQ 'MCFLAB19') THEN(DO)
/** DELETE THE FILE IF IT EXISTS FROM MCPRD                     **/
                        DLTF       FILE(&INPLIB/&FNAME)
                        MONMSG     MSGID(CPF2105)

/** CREATE THE FILE FROM THE SOURCE MBR IN QDDSSRCDB                **/
                        CRTLF    FILE(&INPLIB/&FNAME) +
                                 SRCFILE(&INPLIB/QDDSSRCDB) +
                                 TEXT(*SRCMBRTXT)
                        MONMSG     MSGID(CPF9999)
                        GOTO       READNXT
             ENDDO

CONTINUE:

/** DELETE THE FILE                                                 **/
             DLTF       FILE(&DBFLIB/&FNAME)
             MONMSG     MSGID(CPF2105)

/** CREATE THE FILE FROM THE SOURCE MBR IN QDDSSRCDB                **/
             CRTLF    FILE(&DBFLIB/&FNAME) SRCFILE(&INPLIB/QDDSSRCDB) +
                      TEXT(*SRCMBRTXT)
             MONMSG     MSGID(CPF9999)

             GOTO       READNXT
ENDIT:
ENDPGM
