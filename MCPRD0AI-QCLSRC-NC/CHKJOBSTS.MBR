/*********************************************************************/
/** PROGRAM: CHKJOBSTS                                             ***/
/**                                                                ***/
/** PURPOSE: CHECK FOR ACTIVE STATUS OF USER/JOB/JNBR              ***/
/**                                                                ***/
/** CREATED: 03/07/2003                                            ***/
/** AUTHOR : DAN RAUCH - EXLTECH,INC                               ***/
/**                                                                ***/
/*********************************************************************/
/** SPECIAL NOTES:                                                 ***/
/*********************************************************************/
             PGM        PARM(&USER &JOB &JNBR &STATUS)

             DCL        VAR(&USER) TYPE(*CHAR) LEN(10)
             DCL        VAR(&JOB) TYPE(*CHAR) LEN(10)
             DCL        VAR(&JNBR) TYPE(*CHAR) LEN(06)
             DCL        VAR(&STATUS) TYPE(*CHAR) LEN(10)

             MONMSG     MSGID(CPF9898)

             TAATOOL/RTVJOBSTS JOB(&JNBR/&USER/&JOB) STATUS(*ACTIVE) +
                          RTNSTATUS(&STATUS)

ENDIT:       ENDPGM
