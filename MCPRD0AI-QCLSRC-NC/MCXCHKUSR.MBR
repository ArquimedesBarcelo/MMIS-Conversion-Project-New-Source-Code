             PGM        PARM(&USER &EXIST)

             /***********************************************************/
             /*** THIS PROGRAM WILL VERIFY THAT A PASSED USER PROFILE ***/
             /*** EXISTS ON THE SYSTEM.  A VALUE OF Y IS RETURNED IF  ***/
             /*** THE PROFILE EXISTS, OTHERWISE A VALUE OF N.         ***/
             /***********************************************************/

             DCL        VAR(&USER)  TYPE(*CHAR) LEN(10)
             DCL        VAR(&EXIST) TYPE(*CHAR) LEN(1)

             CHGVAR     VAR(&EXIST) VALUE('Y')
             CHKOBJ     OBJ(&USER) OBJTYPE(*USRPRF)
             MONMSG     MSGID(CPF9800) EXEC(CHGVAR VAR(&EXIST) +
                          VALUE('N'))
             MONMSG     MSGID(CPF0001) EXEC(CHGVAR VAR(&EXIST) +
                          VALUE('N'))
FINI:
             ENDPGM
