/********************************************************************/
/*                REORGANIZE MMIS/CSIS FILES                        */
/********************************************************************/
     PGM PARM(&LIB1 &LIB2 &LIB3 &LIB4 &LIB5)
             DCL        VAR(&LIB1) TYPE(*CHAR) LEN(10)
             DCL        VAR(&LIB2) TYPE(*CHAR) LEN(10)
             DCL        VAR(&LIB3) TYPE(*CHAR) LEN(10)
             DCL        VAR(&LIB4) TYPE(*CHAR) LEN(10)
             DCL        VAR(&LIB5) TYPE(*CHAR) LEN(10)
             DCLF       FILE(UTFPFREORG)
             DSPOBJD    OBJ(&LIB1/*ALL) OBJTYPE(*FILE) +
                          OUTPUT(*OUTFILE) OUTFILE(QTEMP/UTFPFREORG)
             IF         COND(&LIB2 *NE ' ') THEN(DSPOBJD +
                          OBJ(&LIB2/*ALL) OBJTYPE(*FILE) +
                          OUTPUT(*OUTFILE) +
                          OUTFILE(QTEMP/UTFPFREORG) OUTMBR(*FIRST +
                          *ADD))
             IF         COND(&LIB3 *NE ' ') THEN(DSPOBJD +
                          OBJ(&LIB3/*ALL) OBJTYPE(*FILE) +
                          OUTPUT(*OUTFILE) +
                          OUTFILE(QTEMP/UTFPFREORG) OUTMBR(*FIRST +
                          *ADD))
             IF         COND(&LIB4 *NE ' ') THEN(DSPOBJD +
                          OBJ(&LIB4/*ALL) OBJTYPE(*FILE) +
                          OUTPUT(*OUTFILE) +
                          OUTFILE(QTEMP/UTFPFREORG) OUTMBR(*FIRST +
                          *ADD))
             IF         COND(&LIB5 *NE ' ') THEN(DSPOBJD +
                          OBJ(&LIB5/*ALL) OBJTYPE(*FILE) +
                          OUTPUT(*OUTFILE) +
                          OUTFILE(QTEMP/UTFPFREORG) OUTMBR(*FIRST +
                          *ADD))
READ:        RCVF
             MONMSG     MSGID(CPF0000) EXEC(GOTO CMDLBL(EOJ))
             IF         COND(%SST(&ODOBAT 1 2) *EQ 'PF') THEN(DO)
             RGZPFM     FILE(&ODLBNM/&ODOBNM)
             MONMSG     MSGID(CPF0000)
             GOTO       CMDLBL(READ)
             ENDDO
             GOTO       CMDLBL(READ)
EOJ:         ENDPGM
