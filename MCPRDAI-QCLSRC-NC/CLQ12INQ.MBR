PGM PARM(&DBPARMS &VPARMS &CPARMS)
             DCL        VAR(&DBPARMS) TYPE(*CHAR) LEN(600)
             DCL        VAR(&VPARMS)  TYPE(*CHAR) LEN(120)
             DCL        VAR(&CPARMS)  TYPE(*CHAR) LEN(120)
             CHKOBJ     OBJ(QTEMP/OUTFIQ12) OBJTYPE(*FILE)
             MONMSG     MSGID(CPF9800) EXEC(DO)
             CRTPF      FILE(QTEMP/OUTFIQ12) RCDLEN(142) SIZE(13000 +
                          13000 10)
             ENDDO
             CLRPFM     FILE(QTEMP/OUTFIQ12)
             OVRDBF     FILE(OUTFIQ12) TOFILE(QTEMP/OUTFIQ12)
             CHKOBJ     OBJ(QTEMP/WRKFIQ12) OBJTYPE(*FILE)
             MONMSG     MSGID(CPF9800) EXEC(DO)
             CRTPF      FILE(QTEMP/WRKFIQ12) RCDLEN(142) SIZE(13000 +
                          13000 10)
             ENDDO
             CLRPFM     FILE(QTEMP/WRKFIQ12)
             OVRDBF     FILE(WRKFIQ12) TOFILE(QTEMP/WRKFIQ12)
             CALL       PGM(*LIBL/TQ12SUB) +
                        PARM(&DBPARMS &VPARMS &CPARMS)
             DLTOVR     FILE(OUTFIQ12)
             DLTOVR     FILE(WRKFIQ12)
             ENDPGM
