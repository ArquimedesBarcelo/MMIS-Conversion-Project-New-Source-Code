PGM
             CHKOBJ     OBJ(QTEMP/OUTFILQ1) OBJTYPE(*FILE)
             MONMSG     MSGID(CPF9800) EXEC(DO)
             CRTPF      FILE(QTEMP/OUTFILQ1) RCDLEN(120) SIZE(13000 +
                          13000 10)
             ENDDO
             CLRPFM     FILE(QTEMP/OUTFILQ1)
             OVRDBF     FILE(OUTFILQ1) TOFILE(QTEMP/OUTFILQ1)
             CALL       PGM(*LIBL/TQ1SRRPT) +
                        PARM('V' 'SR' 'B2  ' 'X')
             DLTOVR     FILE(OUTFILQ1)
             ENDPGM
