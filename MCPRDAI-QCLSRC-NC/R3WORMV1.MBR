             PGM

             DCL        &DATE      *CHAR LEN(6)
             DCL        &MONTH     *CHAR LEN(2)
             DCL        VAR(&JULX) TYPE(*DEC) LEN(5)
             DCL        &JUL2      *CHAR LEN(5)
             DCL        &JUL1      *CHAR LEN(5)
             DCL        &MSG       *CHAR LEN(45)

             DCLF       FILE(TEMPHOLD)

             RTVSYSVAL  SYSVAL(QMONTH) RTNVAR(&MONTH)
             RTVSYSVAL  SYSVAL(QDATE) RTNVAR(&DATE)
             CVTDAT     DATE(&DATE) TOVAR(&JUL1) FROMFMT(*MDY) +
                          TOFMT(*JUL) TOSEP(*NONE)
             CHGVAR     VAR(&JULX) VALUE(&JUL1)

      IF   (&MONTH *EQ '01') DO
                     CHGVAR     VAR(&JULX) VALUE(&JULX + 365)
                     CHGVAR     VAR(&JULX) VALUE(&JULX - 1030)
                     ENDDO
                 ELSE DO
                     CHGVAR     VAR(&JULX) VALUE(&JULX - 30)
                     ENDDO

             CHGVAR     VAR(&JUL1) VALUE(&JULX)


 READFILE:   RCVF
             MONMSG     MSGID(CPF0000) EXEC(GOTO CMDLBL(EOJ))

             CVTDAT     DATE(&MLCDAT) TOVAR(&JUL2) FROMFMT(*YMD) +
                          TOFMT(*JUL) TOSEP(*NONE)

         IF ((&MLCCEN *EQ '0') *OR (&JUL2 *LT &JUL1)) DO
             RMVM       FILE(R3WOISS) MBR(&MLNAME)
             CHGVAR     VAR(&MSG) VALUE(&MLNAME *CAT ' Member of +
                          R3WOISS has been removed')
             SNDPGMMSG  MSG(&MSG)
         ENDDO

             GOTO       CMDLBL(READFILE)


 EOJ:
             ENDPGM
             RETURN
