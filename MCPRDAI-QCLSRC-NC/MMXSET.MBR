             PGM

  ADDLIBLE MCPRD1
  MONMSG CPF0000
  ADDLIBLE MCPRD
  MONMSG CPF0000
  CALL MMRONESHOT PARM('20070901' '20070909')
  MONMSG CPF0000

  ADDPFTRG FILE(MCPRD1/MCFPMM1000) TRGTIME(*AFTER) TRGEVENT(*INSERT)  +
          PGM(MCPRD/MMXADDREC) TRG(MM1000ADD)

             ADDPFTRG   FILE(MCPRD1/MCFPMM1000) TRGTIME(*AFTER) +
                          TRGEVENT(*UPDATE) PGM(MCPRD/MMXUPDREC) +
                          TRG(MM1000UPD)

             ENDPGM
