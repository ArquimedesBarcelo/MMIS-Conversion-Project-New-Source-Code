
/***---                                                         ---***/
/***---      Send Work Order Parts data to EDW                  ---***/
/***---        Separated out of CLWO2EDW due to large size      ---***/
/***---        at some plants causing FTP session to drop.      ---***/
/***---                                                         ---***/
/***---  RFC 1120233 CD 5105456 INC0737989 CPPI 2020-00121353   ---***/
/***---        06/25/2020  D. Baraona                           ---***/
/***---                                                         ---***/

             PGM

/***---   Housekeeping: clean FTP log file                      ---***/
             CLRPFM     FILE(*LIBL/QFTPSRC) MBR(FTPEDWWOO2)
             MONMSG     MSGID(CPF0000)

/***---   Override the default FTP input/output                 ---***/
             OVRDBF     FILE(INPUT) TOFILE(*LIBL/QFTPSRC) +
                          MBR(FTPEDWWOI2)
             OVRDBF     FILE(OUTPUT) TOFILE(*LIBL/QFTPSRC) +
                          MBR(FTPEDWWOO2)

/***---   Run the file transfer AHQIDA1=Test, AHQIPA1=Prod      ---***/
             STRTCPFTP  RMTSYS(AHQIPA1)

/***---   Remove the overrides on the FTP input/output          ---***/
             DLTOVR     FILE(INPUT)
             MONMSG     MSGID(CPF0000)
             DLTOVR     FILE(OUTPUT)
             MONMSG     MSGID(CPF0000)

/***---   Print the FTP transfer output                         ---***/
             CPYSRCF    FROMFILE(*LIBL/QFTPSRC) TOFILE(*PRINT) +
                          FROMMBR(FTPEDWWOO2)
             MONMSG     MSGID(CPF0000)

             ENDPGM

