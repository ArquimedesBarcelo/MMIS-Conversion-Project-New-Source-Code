             PGM

             DLTF QTEMP/TEMPHOLD
             MONMSG CPF0000

             DSPFD      FILE(*LIBL/R3WOISS) TYPE(*MBRLIST) +
                          OUTPUT(*OUTFILE) OUTFILE(QTEMP/TEMPHOLD)
             ADDLIBLE QTEMP
             MONMSG CPF0000
             CALL       PGM(R3WORMV1)
 EOJ:
             ENDPGM
             RETURN
