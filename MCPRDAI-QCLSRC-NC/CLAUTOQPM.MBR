PGM PARM(&DBPARMS)
             DCL        VAR(&DBPARMS) TYPE(*CHAR) LEN(600)
             CHKOBJ     OBJ(QTEMP/AUTOQPM) OBJTYPE(*FILE)
             MONMSG     MSGID(CPF9800) EXEC(DO)
             CRTPF      FILE(QTEMP/AUTOQPM) RCDLEN(55) SIZE(13000 +
                          13000 10)
             ENDDO
             CLRPFM     FILE(QTEMP/AUTOQPM)
             OVRDBF     FILE(AUTOQPM) TOFILE(QTEMP/AUTOQPM)
             CALL       PGM(*LIBL/TAUTOQPM) PARM(&DBPARMS)
             DLTOVR     FILE(AUTOQPM)
             ENDPGM
