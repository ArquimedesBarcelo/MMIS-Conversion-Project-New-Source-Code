PGM
DCL        &SYSNAME     *CHAR LEN(8)
RTVNETA    SYSNAME(&SYSNAME)
MONMSG CPF0000
IF         COND(&SYSNAME *EQ 'AKRON4') THEN(DO)
           ADDLIBLE MCPRD2
           MONMSG CPF0000
           ENDDO
ELSE       CMD(DO)
           ADDLIBLE MCPRD1
           MONMSG CPF0000
           ENDDO
ADDLIBLE MCPRD
MONMSG CPF0000
   CALL MMR1130
   MONMSG CPF0000
   CALL MMR1130
   MONMSG CPF0000
   CALL MMR1130
   MONMSG CPF0000
ENDIT:
ENDPGM
