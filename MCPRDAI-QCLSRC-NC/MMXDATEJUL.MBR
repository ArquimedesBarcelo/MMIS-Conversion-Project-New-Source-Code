             PGM  PARM(&XDT &XJD)

             DCL        VAR(&XDT) TYPE(*CHAR) LEN(8)
             DCL        VAR(&XJD) TYPE(*CHAR) LEN(7)

             CVTDAT     DATE(&XDT) TOVAR(&XJD) FROMFMT(*YYMD) +
                          TOFMT(*LONGJUL) TOSEP(*NONE)
             MONMSG     MSGID(CPF0550 CPF0551 CPF0552 CPF0553 CPF0554 +
                          CPF0555 CPF0556 CPF0557) EXEC(GOTO ERROR)
             RETURN

 ERROR:      CHGVAR     VAR(&XJD) VALUE('9999999')
             RETURN

             ENDPGM
