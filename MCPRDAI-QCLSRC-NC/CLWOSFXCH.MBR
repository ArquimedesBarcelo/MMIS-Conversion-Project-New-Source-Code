             PGM

/*** PURPOSE: ADJUST MMIS WO SUFFIX FOR THE NEW YEAR  (MCFPMM0800)         ***/
/***          AND RESET THE LAST-USED NUMBER TO 000001.                    ***/
/***          RUN JUST AFTER MIDNIGHT ON NEW YEARS DAY AT MMIS PLANTS.     ***/
/***          RFC 1121030   CD 5105693  CPPI 2020-00121353                 ***/
/***                      D. BARAONA   10/27/2020                          ***/
/***      *--- 20-YEAR PATTERN  ----*                                      ***/
/***      *--- YEAR        ALPHA                                           ***/
/***           2000-2009   A-K                                             ***/
/***           2010-2019   M-Y                                             ***/
/***           2020-2029   A-K                                             ***/
/***           2030-2039   M-Y                                             ***/
/***           2040-2049   A-K                                             ***/
/***           2050-2059   M-Y                                             ***/
/***           2060-2069   A-K                                             ***/
/***           2070-2079   M-Y                                             ***/
/***      *--- YEARS THAT USE THE FOLLOWING CODES:                         ***/
/***      *--- 2000-2009; 2020-2029; 2040-2049; 2060-2069                  ***/
/***           VALUE "A0"                                                  ***/
/***           VALUE "B1"                                                  ***/
/***           VALUE "C2"                                                  ***/
/***           VALUE "D3"                                                  ***/
/***           VALUE "E4"                                                  ***/
/***           VALUE "F5"                                                  ***/
/***           VALUE "G6"                                                  ***/
/***           VALUE "H7"                                                  ***/
/***           VALUE "J8"                                                  ***/
/***           VALUE "K9"                                                  ***/

/***      *--- YEARS THAT USE THE FOLLOWING CODES:                         ***/
/***      *--- 2010-2019; 2030-2039; 2050-2059; 2070-2079                  ***/
/***           VALUE "M0"                                                  ***/
/***           VALUE "N1"                                                  ***/
/***           VALUE "P2"                                                  ***/
/***           VALUE "R3"                                                  ***/
/***           VALUE "S4"                                                  ***/
/***           VALUE "T5"                                                  ***/
/***           VALUE "V6"                                                  ***/
/***           VALUE "W7"                                                  ***/
/***           VALUE "X8"                                                  ***/
/***           VALUE "Y9"                                                  ***/

/*****************************************************************************/
/* Used for system date and then year broken down                            */
             DCL        VAR(&CURDATE) TYPE(*CHAR) LEN(6) VALUE(' ')
             DCL        VAR(&Y1) TYPE(*CHAR) LEN(1) VALUE(' ')
             DCL        VAR(&Y2) TYPE(*CHAR) LEN(1) VALUE(' ')
/*****************************************************************************/

/*  Get today's date (MM/DD/YY)                                              */
             RTVSYSVAL  SYSVAL(QDATE) RTNVAR(&CURDATE)

/* Set &Y1 equal to the decade (first Y of the date (MM/DD/YY)               */
             CHGVAR     VAR(&Y1) VALUE(%SUBSTRING(&CURDATE 5 1))

/* Set &Y2 equal to the last digit of the date (MM/DD/YY)                    */
             CHGVAR     VAR(&Y2) VALUE(%SUBSTRING(&CURDATE 6 1))

/* Update wo last used number to 000001, no matter what the suffix will be   */

             RUNSQL REQUEST('UPDATE MCFPMM0800 SET LASTWONUM = ''000001''')

/* Update workorder suffix with A0-K9 (below) or M0-Y9 (at label MTHRUY)     */

             IF         COND((&Y1 *EQ '3') *OR (&Y1 *EQ '5') *OR +
                          (&Y1 *EQ '7')) THEN(GOTO CMDLBL(MTHRUY))

             IF         COND(&Y2 *EQ '0') THEN(RUNSQL +
                          REQUEST('UPDATE MCFPMM0800 SET +
                          LASTYRUSED = ''A0'''))

             IF         COND(&Y2 *EQ '1') THEN(RUNSQL +
                          REQUEST('UPDATE MCFPMM0800 SET +
                          LASTYRUSED = ''B1'''))

             IF         COND(&Y2 *EQ '2') THEN(RUNSQL +
                          REQUEST('UPDATE MCFPMM0800 SET +
                          LASTYRUSED = ''C2'''))

             IF         COND(&Y2 *EQ '3') THEN(RUNSQL +
                          REQUEST('UPDATE MCFPMM0800 SET +
                          LASTYRUSED = ''D3'''))

             IF         COND(&Y2 *EQ '4') THEN(RUNSQL +
                          REQUEST('UPDATE MCFPMM0800 SET +
                          LASTYRUSED = ''E4'''))

             IF         COND(&Y2 *EQ '5') THEN(RUNSQL +
                          REQUEST('UPDATE MCFPMM0800 SET +
                          LASTYRUSED = ''F5'''))

             IF         COND(&Y2 *EQ '6') THEN(RUNSQL +
                          REQUEST('UPDATE MCFPMM0800 SET +
                          LASTYRUSED = ''G6'''))

             IF         COND(&Y2 *EQ '7') THEN(RUNSQL +
                          REQUEST('UPDATE MCFPMM0800 SET +
                          LASTYRUSED = ''H7'''))

             IF         COND(&Y2 *EQ '8') THEN(RUNSQL +
                          REQUEST('UPDATE MCFPMM0800 SET +
                          LASTYRUSED = ''J8'''))

             IF         COND(&Y2 *EQ '9') THEN(RUNSQL +
                          REQUEST('UPDATE MCFPMM0800 SET +
                          LASTYRUSED = ''K9'''))

             GOTO       CMDLBL(ENDPGM)

/* Or update the MCFPMM0800 file to the correct suffix for workorders (M-Y)  */

 MTHRUY:     IF         COND(&Y2 *EQ '0') THEN(RUNSQL +
                          REQUEST('UPDATE MCFPMM0800 SET +
                          LASTYRUSED = ''M0'''))

             IF         COND(&Y2 *EQ '1') THEN(RUNSQL +
                          REQUEST('UPDATE MCFPMM0800 SET +
                          LASTYRUSED = ''N1'''))

             IF         COND(&Y2 *EQ '2') THEN(RUNSQL +
                          REQUEST('UPDATE MCFPMM0800 SET +
                          LASTYRUSED = ''P2'''))

             IF         COND(&Y2 *EQ '3') THEN(RUNSQL +
                          REQUEST('UPDATE MCFPMM0800 SET +
                          LASTYRUSED = ''R3'''))

             IF         COND(&Y2 *EQ '4') THEN(RUNSQL +
                          REQUEST('UPDATE MCFPMM0800 SET +
                          LASTYRUSED = ''S4'''))

             IF         COND(&Y2 *EQ '5') THEN(RUNSQL +
                          REQUEST('UPDATE MCFPMM0800 SET +
                          LASTYRUSED = ''T5'''))

             IF         COND(&Y2 *EQ '6') THEN(RUNSQL +
                          REQUEST('UPDATE MCFPMM0800 SET +
                          LASTYRUSED = ''V6'''))

             IF         COND(&Y2 *EQ '7') THEN(RUNSQL +
                          REQUEST('UPDATE MCFPMM0800 SET +
                          LASTYRUSED = ''W7'''))

             IF         COND(&Y2 *EQ '8') THEN(RUNSQL +
                          REQUEST('UPDATE MCFPMM0800 SET +
                          LASTYRUSED = ''X8'''))

             IF         COND(&Y2 *EQ '9') THEN(RUNSQL +
                          REQUEST('UPDATE MCFPMM0800 SET +
                          LASTYRUSED = ''Y9'''))

 ENDPGM:     ENDPGM

