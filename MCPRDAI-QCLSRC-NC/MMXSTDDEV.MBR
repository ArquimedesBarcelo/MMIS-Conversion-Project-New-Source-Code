PGM
CLRPFM MCFPMM1090
MONMSG CPF0000
CLRPFM MCFPMM1091
MONMSG CPF0000
CALL  MMRSTDDEV
MONMSG CPF0000
             OVRPRTF    FILE(STDDEV) OUTQ(MCMGR) HOLD(*YES)
   MONMSG CPF0000
             OVRPRTF    FILE(QSYSPRT) OUTQ(MCMGR) HOLD(*YES)
   MONMSG CPF0000
             RUNSQLSTM  SRCFILE(MCPRD/QSQLSRC) SRCMBR(STDDEV) +
                          COMMIT(*NONE)
   MONMSG CPF0000
             DLTOVR     FILE(STDDEV QSYSPRT)
   MONMSG CPF0000
   DLTSPLF    FILE(STDDEV) SPLNBR(*LAST)
   MONMSG CPF0000
CLRPFM MCFPMM1091
MONMSG CPF0000
ENDPGM
