     A                                      UNIQUE
     A          R MCRPMM1050
     A            CTPRODDATE     8          COLHDG('PRODUCTION DATE' 'YYYYMMDD')
     A            CTJULDATE      7          COLHDG('PRODUCTION DATE' 'YYYYDDD')
     A            CTNUMSHIFT     1S 0       COLHDG('NUM SHIFTS IN DAY')
     A*
     A            CTSTART1ST     4S 0       COLHDG('FIRST PROD SHIFT' 'START')
     A            CTSHIFT1ST     1          COLHDG('FIRST PROD SHIFT' 'OF DAY')
     A            CTCREW1ST      1          COLHDG('CREW WORKING 1ST')
     A*
     A            CTSTART2ND     4S 0       COLHDG('SECOND PROD SHIFT' 'START')
     A            CTSHIFT2ND     1          COLHDG('SECOND PROD SHIFT' 'OF DAY')
     A            CTCREW2ND      1          COLHDG('CREW WORKING 2ND')
     A*
     A            CTSTART3RD     4S 0       COLHDG('THIRD PROD SHIFT' 'START')
     A            CTSHIFT3RD     1          COLHDG('THIRD PROD SHIFT' 'OF DAY')
     A            CTCREW3RD      1          COLHDG('CREW WORKING 3RD')
     A*
     A            CTSTART4TH     4S 0       COLHDG('FORTH PROD SHIFT' 'START')
     A            CTSHIFT4TH     1          COLHDG('FORTH PROD SHIFT' 'OF DAY')
     A            CTCREW4TH      1          COLHDG('CREW WORKING 4TH')
     A*
     A            CTSEQ          2S 0       COLHDG('SCHED SEQ')
     A          K CTPRODDATE
