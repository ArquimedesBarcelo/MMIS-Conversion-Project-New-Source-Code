     A          R MCRPMM1130
     A*
     A            CNTDATE        8          COLHDG('DATE')
     A            CNTZONE        4          COLHDG('ZONE')
     A            CNTRECD        5S 0       COLHDG('WRITTEN')
     A            CNTSCHD        5S 0       COLHDG('SCHEDULED')
     A            CNTSRTR        5S 0       COLHDG('STARTED')
     A            CNTCOMP        5S 0       COLHDG('COMPLETED')
     A            CNTSRTRA       5S 0       COLHDG('ALL STARTED')
     A            CNTCOMPA       5S 0       COLHDG('ALL COMPLETED')
     A*
     A*     CONTINUOUS SHIFTS
     A*
     A            SFTOPEN1       5S 0       COLHDG('WO OPENED AT' ' START OF 1')
     A            SFTRECD1       5S 0       COLHDG('WRITTEN')
     A            SFTSCHD1       5S 0       COLHDG('SCHEDULED')
     A            SFTSRTR1       5S 0       COLHDG('STARTED')
     A            SFTCOMP1       5S 0       COLHDG('COMPLETED')
     A            SFTSRTRA1      5S 0       COLHDG('ALL STARTED')
     A            SFTCOMPA1      5S 0       COLHDG('ALL COMPLETED')
     A            SFTSHIFT1      1          COLHDG('SHIFT 1'  'SHIFT')
     A            SFTCREW1       1          COLHDG('SHIFT 1'  'CREW ')
     A*
     A            SFTOPEN2       5S 0       COLHDG('WO OPENED AT' ' START OF 2')
     A            SFTRECD2       5S 0       COLHDG('WRITTEN')
     A            SFTSCHD2       5S 0       COLHDG('SCHEDULED')
     A            SFTSRTR2       5S 0       COLHDG('STARTED')
     A            SFTCOMP2       5S 0       COLHDG('COMPLETED')
     A            SFTSRTRA2      5S 0       COLHDG('ALL STARTED')
     A            SFTCOMPA2      5S 0       COLHDG('ALL COMPLETED')
     A            SFTSHIFT2      1          COLHDG('SHIFT 2'  'SHIFT')
     A            SFTCREW2       1          COLHDG('SHIFT 2'  'CREW ')
     A*
     A            SFTOPEN3       5S 0       COLHDG('WO OPENED AT' ' START OF 3')
     A            SFTRECD3       5S 0       COLHDG('WRITTEN')
     A            SFTSCHD3       5S 0       COLHDG('SCHEDULED')
     A            SFTSRTR3       5S 0       COLHDG('STARTED')
     A            SFTCOMP3       5S 0       COLHDG('COMPLETED')
     A            SFTSRTRA3      5S 0       COLHDG('ALL STARTED')
     A            SFTCOMPA3      5S 0       COLHDG('ALL COMPLETED')
     A            SFTSHIFT3      1          COLHDG('SHIFT 3'  'SHIFT')
     A            SFTCREW3       1          COLHDG('SHIFT 3'  'CREW ')
     A*
     A*     NON-CONTINUOUS SHIFTS - TOPEKA ONLY
     A*
     A            SFTOPEN4       5S 0       COLHDG('WO OPENED AT' ' START OF 1')
     A            SFTRECD4       5S 0       COLHDG('WRITTEN')
     A            SFTSCHD4       5S 0       COLHDG('SCHEDULED')
     A            SFTSRTR4       5S 0       COLHDG('STARTED')
     A            SFTCOMP4       5S 0       COLHDG('COMPLETED')
     A            SFTSRTRA4      5S 0       COLHDG('ALL STARTED')
     A            SFTCOMPA4      5S 0       COLHDG('ALL COMPLETED')
     A            SFTSHIFT4      1          COLHDG('SHIFT 1'  'SHIFT')
     A*
     A            SFTOPEN5       5S 0       COLHDG('WO OPENED AT' ' START OF 2')
     A            SFTRECD5       5S 0       COLHDG('WRITTEN')
     A            SFTSCHD5       5S 0       COLHDG('SCHEDULED')
     A            SFTSRTR5       5S 0       COLHDG('STARTED')
     A            SFTCOMP5       5S 0       COLHDG('COMPLETED')
     A            SFTSRTRA5      5S 0       COLHDG('ALL STARTED')
     A            SFTCOMPA5      5S 0       COLHDG('ALL COMPLETED')
     A            SFTSHIFT5      1          COLHDG('SHIFT 2'  'SHIFT')
     A*
     A            SFTOPEN6       5S 0       COLHDG('WO OPENED AT' ' START OF 3')
     A            SFTRECD6       5S 0       COLHDG('WRITTEN')
     A            SFTSCHD6       5S 0       COLHDG('SCHEDULED')
     A            SFTSRTR6       5S 0       COLHDG('STARTED')
     A            SFTCOMP6       5S 0       COLHDG('COMPLETED')
     A            SFTSRTRA6      5S 0       COLHDG('ALL STARTED')
     A            SFTCOMPA6      5S 0       COLHDG('ALL COMPLETED')
     A            SFTSHIFT6      1          COLHDG('SHIFT 3'  'SHIFT')
     A*
     A*
     A          K CNTDATE
     A          K CNTZONE
