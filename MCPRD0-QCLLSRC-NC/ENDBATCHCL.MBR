/*********************************************************************/
/** PROGRAM: ENDBATCHCL                                            ***/
/**                                                                ***/
/**          ORDER CONSOLIDATION                                   ***/
/** PURPOSE: WRITE REGLOG "END OF BATCH" RECORD                    ***/
/**                                                                ***/
/**          IF THE REQLOG FILE HAS RECORDS TO PROCESS             ***/
/**             THEN LOAD PLANT CODE                               ***/
/**                  LOAD ALL 9'S TO REQ# AND CORP CODE            ***/
/**                  CALL CREQLOG                                  ***/
/**                                                                ***/
/** CREATED: 01/07/2004                                            ***/
/**                                                                ***/
/** AUTHOR : DAN RAUCH - eXLTech,LLC                               ***/
/**                                                                 **/
/*********************************************************************/
/** SPECIAL NOTES:                                                 ***/
/*********************************************************************/
PGM
             DCL        VAR(&RECORDS) TYPE(*DEC) LEN(10 0)
             DCL        VAR(&REQNO) TYPE(*CHAR) LEN(12)
             DCL        VAR(&CC) TYPE(*CHAR) LEN(10)
             DCL        VAR(&PLT) TYPE(*CHAR) LEN(04)
             DCL        VAR(&MANFN) TYPE(*CHAR) LEN(50) VALUE('END +
                          OF BATCH')
             DCL        VAR(&MANFP) TYPE(*CHAR) LEN(50)
             DCL        VAR(&VNDRN) TYPE(*CHAR) LEN(10)
             DCL        VAR(&VNDRP) TYPE(*CHAR) LEN(50)
             DCL        VAR(&VNDRX) TYPE(*CHAR) LEN(50)
             DCL        VAR(&UOM) TYPE(*CHAR) LEN(02)
             DCL        VAR(&PARMS) TYPE(*CHAR) LEN(238)
             DCL        VAR(&LOGPGM) TYPE(*CHAR) LEN(10) VALUE(CREQLOG)

             DCL        VAR(&MPLTKEY) TYPE(*CHAR) LEN(04) VALUE('P 01')
             DCL        VAR(&MPLTDTA) TYPE(*CHAR) LEN(60)
             DCL        VAR(&MPLTPGM) TYPE(*CHAR) LEN(10) +
                          VALUE(CMPLTINFO)
             DCL        VAR(&MPLTSTS) TYPE(*CHAR) LEN(02) VALUE('00')


/** MAKE SURE DREQLOG TABLE HAS RECORDS TO PROCESS                 **/
             RTVMBRD    FILE(MCFPAB0700) NBRCURRCD(&RECORDS)
             IF         COND(&RECORDS *EQ 0) THEN(DO)
                        GOTO CMDLBL(EXIT)
             ENDDO

/** GET PLANT CODE                                                 **/
             CALL       PGM(&MPLTPGM) PARM(&MPLTKEY &MPLTDTA &MPLTSTS)
             CHGVAR     VAR(&PLT) VALUE(%SST(&MPLTDTA 1 3))

/** CALL CREQLOG & WRITE AN END OF BATCH RECORD - REQNO = ALL 9'S   **/
             CHGVAR     VAR(&REQNO) VALUE('999999999999')
             CHGVAR     VAR(&CC) VALUE('9999999999')

             CHGVAR     VAR(%SST(&PARMS   1  12)) VALUE(&REQNO)
             CHGVAR     VAR(%SST(&PARMS  13  10)) VALUE(&CC)
             CHGVAR     VAR(%SST(&PARMS  23   4)) VALUE(&PLT)
             CHGVAR     VAR(%SST(&PARMS  27  50)) VALUE(&MANFN)
             CHGVAR     VAR(%SST(&PARMS  77  50)) VALUE(&MANFP)
             CHGVAR     VAR(%SST(&PARMS 127  10)) VALUE(&VNDRN)
             CHGVAR     VAR(%SST(&PARMS 137  50)) VALUE(&VNDRP)
             CHGVAR     VAR(%SST(&PARMS 187  50)) VALUE(&VNDRX)
             CHGVAR     VAR(%SST(&PARMS 237   2)) VALUE(&UOM)

             CALL       PGM(&LOGPGM) PARM(&PARMS)

EXIT:
ENDPGM
