     A            INVPSW3        8A
     A            INVPSW4        8A
     A            INVPSW5        8A
     A            INVPSW6        8A
     A            INVPSW7        8A
     A            INVPSW8        8A
     A            INVPSW9        8A
     A            INVPSW10       8A
     A            INVPSW11       8A
     A            INVPSW12       8A
     A            INVDTEAD       6A          COLHDG('DATE' 'ADDED')
     A            INVDTECH       6A          COLHDG('DATE' 'CHANGED')
     A            INVDTEAA       6A          COLHDG('DATE' 'AP ACT')
     A            INVAPFCT       1A          COLHDG('AP' 'FUNCTION')
     A            INVLTHVA       2S 0        COLHDG('TIME' 'VALID')
