     A                                      REF(STORES)
     A          R MCFRMONJP
     A            MJJOBPROC R               REFFLD(JOBNAME)
     A                                      ALIAS(MJ_JOBPROC_CS)
     A                                      COLHDG('JOB PROCESS')
