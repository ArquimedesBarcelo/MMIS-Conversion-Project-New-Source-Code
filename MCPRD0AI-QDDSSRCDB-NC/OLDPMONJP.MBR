     A            MJJOBNAME R               REFFLD(JOBNAME)
     A                                      COLHDG('JOB NAME')
     A                                      TEXT('JOB NAME')
     A            MJJOBDESC R               REFFLD(JOBDESC)
     A                                      COLHDG('JOB DESCRIPTION')
     A                                      TEXT('JOB DESCRIPTION')
     A            MJJOBPROG R               REFFLD(JOBPROG)
     A                                      COLHDG('JOB PGM CALLED')
     A                                      TEXT('JOB PGM CALLED')
     A            MJJOBTYPE R               REFFLD(JOBCALLFL)
     A                                      ALIAS(MJ_JOBTYPE_CS)
     A                                      COLHDG('JOB TYPE')
     A                                      TEXT('JOB TYPE')
     A            MJCALLFL  R               REFFLD(JOBCALLFL)
