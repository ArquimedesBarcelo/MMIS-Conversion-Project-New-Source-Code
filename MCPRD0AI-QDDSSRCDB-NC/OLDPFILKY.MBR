      ***************************************************************
      * FILE NAME : MCFPFILKY
      *
      * PURPOSE   : FILE USED TO LOAD KEYS FOR VARIOUS ARIBA PROCESS'G
      *             SETUP ARIBA KEYS
      *
      * CREATED   : 12/06/2002
      * AUTHOR    : EXLTECH, INC - DAN RAUCH
      *    B
      ***************************************************************
      * SETUP KEYS:
      *  1) MPLTINFO  =  'ARPOF000000'  - GET NEXT PO NUMBER
      *  2) VALDATA   =  'SAR       ARIBA' - SETUP STATUS 'AR'
      *  3) BUYER     =  'ARBAARIBA BUYER'  - SETUP BUYER NAME
      ***************************************************************
     A                                      REF(STORES)
     A          R MCFRFILKY
     A            FKFILEKY  R               REFFLD(RPTKEY)
     A                                      ALIAS(FK_FILE_CS)
     A                                      COLHDG('FILE KEY')
     A                                      TEXT('FILE KEY')
     A            FKKEYVAL  R               REFFLD(DESCDTA)
     A                                      COLHDG('KEY VALUE')
     A                                      TEXT('KEY VALUE')
