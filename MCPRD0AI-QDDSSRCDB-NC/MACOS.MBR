     A          R RMACOS
     A            PLANTID        2A         ALIAS(PLANTID_MACOS)
     A                                      TEXT('PLANT ID')
     A            PLANT          3A         ALIAS(PLANT_MACOS)
     A                                      TEXT('PLANT')
     A            DATE           5A         ALIAS(DATE_MACOS)
     A                                      TEXT('DATE (MONTH/YEAR)')
     A            DATERECD       8A         ALIAS(DATERECD_MACOS)
     A                                      TEXT('DATE RECEIVED')
     A            MATERIAL      30A         ALIAS(MATERIAL_MACOS)
     A                                      TEXT('MATERIAL NAME')
     A            VENDORNAME    44A         ALIAS(VENDORNAME_MACOS)
     A                                      TEXT('VENDOR NAME')
     A            UM             2A         ALIAS(UM_MACOS)
     A                                      TEXT('UNIT OF MEASURE')
     A            QTYRCVD       12S 4       ALIAS(QTYRCVD_MACOS)
     A                                      TEXT('QUANTITY RECEIVED')
     A            UMORIG         2A         ALIAS(UMORIG_MACOS)
     A                                      TEXT('ORIGINAL UM')
     A            QTYORIG       12S 4       ALIAS(QTYORIG_MACOS)
     A                                      TEXT('ORIGINAL QUANTITY')
     A            PO            11A         ALIAS(PO_MACOS)
     A                                      TEXT('PO NUMBER')
     A            RCVR           3A         ALIAS(RCVR_MACOS)
     A                                      TEXT('RECEIVING SLIP NUMBER')
     A            ITEM           4A         ALIAS(ITEM_MACOS)
     A                                      TEXT('ITEM NUMBER')
     A            VENDORCODE    10A         ALIAS(VENDORCODE_MACOS)
     A                                      TEXT('VENDOR CODE')
     A            CORPCODE       8A         ALIAS(CORPCODE_MACOS)
     A                                      TEXT('CORPORATE CODE')
     A            PAD44         44A         ALIAS(PAD44_MACOS)
     A                                      TEXT(' ')
