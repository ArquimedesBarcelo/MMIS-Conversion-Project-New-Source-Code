      ***************************************************************
      * FILE NAME : MCFPAB3500
      * FILE TYPE : PHYSICAL FILE
      *
      * PURPOSE   : DMANPART VS ARIBA CATALOG EXCEPTION RPTG
      *
      * CREATED   : 04/30/2004
      * AUTHOR    : EXLTECH, LLC - DAN RAUCH
      *
      *****************************************************************
      * SPECIAL NOTES:   THIS FILE IN LIB MCPRD1 ON AKRON60 HAS 8
      *                  MEMBERS(IE: Z131, Z133 ...ETC) - ONE PER EACH
      *                  PLANT THAT FTP'S EXCEPTION DATA VIA BATCH JOB
      *                  EXCP3JOB. THE PLANT VERSION OF THIS FILE LIVES
      *                  IN MCPRD4 AND HAS 1 MBR(*FIRST)
      *****************************************************************
     A                                      REF(STORES)
     A          R MCFRAB3500
     A            PLNTCDE        3A
     A            CORPCDE   R
     A**
     A            RECTYPE        1A
     A                                      COLHDG('REC TYPE')
     A                                      TEXT('REC TYPE')
     A                                      ALIAS(RECTYPE_CS)
     A            RECDSC        15A
     A                                      COLHDG('REC TYPE DESC')
     A                                      TEXT('REC TYPE DESC')
     A                                      ALIAS(RECDSC_CS)
     A**
     A            MANUFACT  R               REFFLD(MANUFACT50)
     A            MANPARTNO R               REFFLD(PARTNO50)
     A                                      COLHDG('MANUFACT PART NBR')
     A                                      TEXT('MANUFACT PART NBR')
     A                                      ALIAS(MANPARTNO_CS)
     A**
     A            PREFFLAG  R               REFFLD(FLAG1)
     A                                      COLHDG('PREFERNCE FLAG')
     A                                      TEXT('PREF FLAG')
     A                                      ALIAS(PREF_FLAG_CS)
     A**
     A            TYPFLAG   R               REFFLD(FLAG1)
     A                                      COLHDG('TYPE')
     A                                      TEXT('TYPE')
     A                                      ALIAS(TYP_FLAG_CS)
     A**
     A            DATETIME14R
     A**
     A**
     A          K PLNTCDE
     A          K CORPCDE
     A          K RECTYPE
