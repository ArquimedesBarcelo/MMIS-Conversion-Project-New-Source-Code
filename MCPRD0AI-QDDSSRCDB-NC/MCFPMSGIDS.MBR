     A*
     A*         MCFPMSGIDS - CSIS/MMIS MSG ID FILE WITH PROCESSING DIRECTIONS
     A*
     A          R MCRPMSGIDS
     A            MAINID        10A         TEXT('Main Id')
     A                                      COLHDG('MAIN ID')
     A            SUBID         10A         TEXT('Sub Id')
     A                                      COLHDG('SUB ID')
     A            RTNCODE        1A         TEXT('Return Code')
     A                                      COLHDG('RTN CODE')
     A            DSPSCRMSG      1A         TEXT('Dsp Screen Msg')
     A                                      COLHDG('DSP SCR MSG')
     A            DSPJOBLOG      1A         TEXT('Dsp Job Log')
     A                                      COLHDG('DSP JOB LOG')
     A            DSPJOB         1A         TEXT('Dsp Job')
     A                                      COLHDG('DSP JOB')
     A            RTVERRMSG      1A         TEXT('Retrieve Error Msgs')
     A                                      COLHDG('RTV ERR MSGS')
     A            SUBPGMERR      1A         TEXT('Err in Non-Cobol Sub-Pgm')
     A                                      COLHDG('ERR in SUB-PGM')
     A            SUBPGMMSG    100A         TEXT('Desc of Sub-Pgm Err')
     A                                      COLHDG('DESC of SUB-PGM ERR')
     A          K MAINID
     A          K SUBID
