     A*
     A*         MCFPER00   - CSIS/MMIS ERROR LOG FILE
     A*
     A          R MCRPERRORS
     A            MCDATE         6A         TEXT('Error Date')
     A                                      COLHDG('Error Date')
     A            MCTIME         6A         TEXT('Error Time')
     A                                      COLHDG('Error Time')
     A            MCJOB         10A         TEXT('Job Name')
     A                                      COLHDG('Job Name')
     A            MCUSER         7A         TEXT('User')
     A                                      COLHDG('User')
     A            MCNBR          6A         TEXT('Job Number')
     A                                      COLHDG('Job Number')
     A            MCPGM         10A         TEXT('Program Name')
     A                                      COLHDG('Program')
     A            MCLIB         10A         TEXT('Program Library')
     A                                      COLHDG('Library')
     A            MCMSG          7A         TEXT('Message ID')
     A                                      COLHDG('Message ID')
     A            MCDESC       100A         TEXT('Error Description')
     A                                      COLHDG('Error Description')
     A          K MCDATE
     A          K MCTIME
     A          K MCJOB
     A          K MCUSER
     A          K MCNBR
