003800**                                                          **
003900**            D A T A B A S E   W O R K                     **
004000**                                                          **
004100**************************************************************
004200
       01  FILE-STATUS.
           05  FILE-STATUS-1            PIC X  VALUE "0".
           05  FILE-STATUS-2            PIC X  VALUE "0".

004300 01  DSET-NAMES.
004400     05  DSET-NAME                 PIC X(16)  VALUE SPACES.
004500     05  DSET-MSTORERM             PIC X(16)  VALUE "MSTORERM;".
004600     05  DSET-MREQ                 PIC X(16)  VALUE "MREQ;".
004700     05  DSET-DREQD                PIC X(16)  VALUE "DREQD;".
004800     05  DSET-DREQITM              PIC X(16)  VALUE "DREQITM;".
004900     05  DSET-DREQDESC             PIC X(16)  VALUE "DREQDESC;".
005000     05  DSET-DPORECD              PIC X(16)  VALUE "DPORECD;".
005100     05  DSET-DPOITEM              PIC X(16)  VALUE "DPOITEM;".
005200
005300 01  MODE-AREA.
005400     05  MODE1                  PIC S9(4)   COMP       VALUE 1.
005500     05  MODE2                  PIC S9(4)   COMP       VALUE 2.
005600     05  MODE3                  PIC S9(4)   COMP       VALUE 3.
005700     05  MODE4                  PIC S9(4)   COMP       VALUE 4.
005800     05  MODE5                  PIC S9(4)   COMP       VALUE 5.
005900     05  MODE6                  PIC S9(4)   COMP       VALUE 6.
006000     05  MODE7                  PIC S9(4)   COMP       VALUE 7.
006100
006200 01 ITEM-LISTS.
006300     05  ALL-ITEMS              PIC XX    VALUE "@;".
006400     05  REQ-SEARCH             PIC X(12) VALUE "REQ-NUMBER;".
006500     05  PO-SEARCH              PIC X(10) VALUE "PO-RCV-NO;".
006600
006700 01 ARG-VALUES.
006800     05  CODE-ARG               PIC X(8)  VALUE SPACES.
006900     05  REQ-ARG                PIC X(12) VALUE SPACES.
007000     05  PO-ARG                 PIC X(14) VALUE SPACES.
007100
007200**************************************************************
007300**                                                          **
007400**           D A T A B A S E   B U F F E R S                **
007500**                                                          **
