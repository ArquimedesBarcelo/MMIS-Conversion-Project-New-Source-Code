000200 IDENTIFICATION DIVISION.
000300 PROGRAM-ID.    CMANINQ.
000400 AUTHOR.        C.I.HILLES/JIM COFFMAN (MAINTAINER).
000500*INSTALLATION.  GOODYEAR TIRE & RUBBER CO.
000600*DATE-WRITTEN.  SEPTEMPER, 1987.
000700*REMARKS.
000800*D          THIS SUBPROG IS CALLED FROM MMIS PROGRAMS TO
000900*D          INQUIRE ON REQUISITION DATA.
      *C
      *C   05/05/94  JE COFFMAN  WRITTEN REQUEST 94-001/SLS REQ 6487
      *C     ADDED THE ABILITY TO ALLOW 'SS' STATUS REQUISITIONS
      *C     THAT HAVE THE AUTHORIZATION FLAG SET VIA MP1 TO BE
      *C     RETRIEVED FOR CHANGING BY OTHER PROGRAMS.
      *C
      *C   08/14/96  JEFF BUNGO
      *C     EXPAND DATE FIELDS FOR YEAR 2000 COMPLIANCE.
      *C     INCLUDE CENTURY FOR EXPECT DATE, REQ DATE,
      *C     DATE WANTED, AND DATE RECEIVED.  CHANGE THE
      *C     PARMS TO CMANREQ TO PASS CENTURY ON THE DATES.
      *C
      *C   11/21/96   CA YODER   REQ #96-027
      *C     ADDED CURRENCY CODE TO PARAMETERS PASSED IN
      *C     "CMANREQ" COPYLIB MEMBER.
      *C
      *C   NOV 1997   JE COFFMAN
      *C     INCORPORATED LOGIC TO RETRIEVE INVOICE COSTS
      *C     BY ITEM.
      *C
      *C   SEP 2001   BE GEISER
      *C     ADD LOGIC TO PREVENT SUB1 FROM GOING OUT OF BOUNDS.
      *C
      *C   APR 2003   BE GEISER
      *C     ADD REQ SERVICE FLAG FIELD.
      *C
001000
001100 ENVIRONMENT DIVISION.
001200 CONFIGURATION SECTION.
001300 SOURCE-COMPUTER.    HP-3000.
001400 OBJECT-COMPUTER.    HP-3000.
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT MSTORERM
                  ASSIGN TO DATABASE-MCFLCS0201
                  ORGANIZATION IS INDEXED
                    ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                  FILE STATUS IS FILE-STATUS.

           SELECT MREQ
                  ASSIGN TO DATABASE-MCFLCS2001
                  ORGANIZATION IS INDEXED
                    ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                  FILE STATUS IS FILE-STATUS.

           SELECT DREQD
                  ASSIGN TO DATABASE-MCFLCS2101
                  ORGANIZATION IS INDEXED
                    ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                    WITH DUPLICATES
                  FILE STATUS IS FILE-STATUS.

           SELECT DREQITM
                  ASSIGN TO DATABASE-MCFLCS2201
                  ORGANIZATION IS INDEXED
                    ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                    WITH DUPLICATES
                  FILE STATUS IS FILE-STATUS.

           SELECT DREQDESC
                  ASSIGN TO DATABASE-MCFLCS2301
                  ORGANIZATION IS INDEXED
                    ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                    WITH DUPLICATES
                  FILE STATUS IS FILE-STATUS.

           SELECT DPOITEM
                  ASSIGN TO DATABASE-MCFLCS1002
                  ORGANIZATION IS INDEXED
                    ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                    WITH DUPLICATES
                  FILE STATUS IS FILE-STATUS.

           SELECT DPORECD
                  ASSIGN TO DATABASE-MCFLCS0901
                  ORGANIZATION IS INDEXED
                    ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                    WITH DUPLICATES
                  FILE STATUS IS FILE-STATUS.

           SELECT DINVRCD
                  ASSIGN TO DATABASE-MCFLCS2506
                  ORGANIZATION IS INDEXED
                    ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                    WITH DUPLICATES
                  FILE STATUS IS FILE-STATUS.
001500
           SELECT DINVITM
                  ASSIGN TO DATABASE-MCFLCS2601
                  ORGANIZATION IS INDEXED
                    ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                    WITH DUPLICATES
                  FILE STATUS IS FILE-STATUS.

001600 DATA DIVISION.
       FILE SECTION.
       FD  MSTORERM
           LABEL RECORDS ARE STANDARD.
       01  MSTORERM-REC.
           COPY DDS-MCRPCS0200  OF MCFLCS0201.

       FD  MREQ
           LABEL RECORDS ARE STANDARD.
       01  MREQ-REC.
           COPY DDS-MCRPCS2000  OF MCFLCS2001.

       FD  DREQD
           LABEL RECORDS ARE STANDARD.
       01  DREQD-REC.
           COPY DDS-MCRPCS2100  OF MCFLCS2101.

       FD  DREQITM
           LABEL RECORDS ARE STANDARD.
       01  DREQITM-REC.
           COPY DDS-MCRPCS2200  OF MCFLCS2201.

       FD  DREQDESC
           LABEL RECORDS ARE STANDARD.
       01  DREQDESC-REC.
           COPY DDS-MCRPCS2300  OF MCFLCS2301.

       FD  DPOITEM
           LABEL RECORDS ARE STANDARD.
       01  DPOITEM-REC.
           COPY DDS-MCRPCS1000  OF MCFLCS1002.

       FD  DPORECD
           LABEL RECORDS ARE STANDARD.
       01  DPORECD-REC.
           COPY DDS-MCRPCS0900  OF MCFLCS0901.

       FD  DINVRCD
           LABEL RECORDS ARE STANDARD.
       01  DINVRCD-REC.
           COPY DDS-MCRPCS2500  OF MCFLCS2506.

       FD  DINVITM
           LABEL RECORDS ARE STANDARD.
       01  DINVITM-REC.
           COPY DDS-MCRPCS2600  OF MCFLCS2601.
001700
001800 WORKING-STORAGE SECTION.
001900 77  SUB1                          PIC S9(4) COMP-4 VALUE 0.
002000 01  BU-DISPLAY-FLDS.
002100     05  BU-DISPLAY-LINE OCCURS 5  TIMES.
002200         10  DISPLAY-FLD    PIC X(14).
002300         10  DISPLAY-FLD9   PIC S9(8).
002400
