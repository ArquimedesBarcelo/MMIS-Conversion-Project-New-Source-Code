       PROCEDURE DIVISION USING BASE, VIEW-COMAREA,
           MPLTINFO-COMP, PASSED-SPOOL-PRT, PASSED-CODE,
           LANGUAGE-PARMS.

       PROC-DIV SECTION.
       BEGIN-HERE.
           MOVE 1                        TO  SAVE-PARA-NUMBER.
           PERFORM 1-HSK  THRU  1-H-X.
           PERFORM 6-INQ-MATL  THRU  6-IM-X.
           PERFORM 2-EOJ  THRU  2-EOJ-X.
           GOBACK.

       1-HSK.
           MOVE 66                       TO  RECSIZE.
           MOVE "USAGEFIL"               TO  FILENAME.
           MOVE 2                        TO  SAVE-PARA-NUMBER.

           MOVE 0 TO DESC-SUB, DB-SUB, PAGE-CTR.
           MOVE "N"                      TO  FIRST-FORM-GOT-FLAG.
           MOVE "N"                      TO  OVERRIDE-DB-FLAG.
           MOVE 0 TO NUM-LINES-FULL-DESC, NUM-FULL-PAGES,
             NUM-LINES-LAST-PAGE.

DCR02**------------------------------------------------------------
DCR02**-- CHECK MPLTINFO TO SEE IF THIS PLAN IS ARIBA ENABLED
DCR02**-- KEY = "ARIB" (USED TO SET CODE FILTER LENGTH)
DCR02**------------------------------------------------------------
DCR02      SET ARIBA-ENABLED-NO        TO TRUE.
DCR02      MOVE WS-ARIBA-ENABLED-KEY   TO  WS-ZMPLT-KEY.

DCR02      PERFORM ZMPLT-GET-MPLTINFO  THRU ZMPLT-EXIT.
DCR02      MOVE WS-ZMPLT-FILE-STATUS  TO  FILE-STATUS.
DCR02      IF  FILE-STATUS = "00"
DCR02          SET ARIBA-ENABLED-YES   TO TRUE
DCR02      END-IF.

           PERFORM 9999-OPEN-STUFF.

           MOVE MPLTINFO-COMP            TO  DE-COMP-1,
                                              DISP-CODE-2,
                                              DE-COMP-2,
                                              DE-COMP-3,
                                              DE-COMP-4.

           MOVE "TMTLSTAT"               TO  BU-PGM-NAME.
           MOVE BASE                     TO  HOME-BASE.
           MOVE MPLTINFO-COMP            TO  SRF-MPLTINFO-COMPANY,
                                              COMPANY-SAVE.
           MOVE 13009                    TO  CATREAD-MSG-NUMBER.
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
           MOVE MESSAGE-BUFFER           TO  MORE-AVAIL-MSG.

           MOVE 09013                    TO  CATREAD-MSG-NUMBER.
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
           MOVE MESSAGE-BUFFER           TO  REPAIR-MSG.

           MOVE 16090                    TO  CATREAD-MSG-NUMBER.
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
           MOVE MESSAGE-BUFFER           TO  BKWD-REVIEW-MSG.

           MOVE 16091                    TO  CATREAD-MSG-NUMBER.
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
           MOVE MESSAGE-BUFFER           TO  BKWD-FRWD-REVIEW-MSG.

           MOVE 16092                    TO  CATREAD-MSG-NUMBER.
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
           MOVE MESSAGE-BUFFER           TO  FRWD-REVIEW-MSG.

           MOVE 20054                    TO  CATREAD-MSG-NUMBER.
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
           MOVE MESSAGE-BUFFER           TO  AKRON-INSTRUCT-LINE1.

           MOVE 16093                    TO  CATREAD-MSG-NUMBER.
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
           MOVE MESSAGE-BUFFER           TO  AKRON-INSTRUCT-LINE2.

           MOVE 16094                    TO  CATREAD-MSG-NUMBER.
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
           MOVE MESSAGE-BUFFER           TO  AKRON-INSTRUCT-LINE3.

           MOVE 16095                    TO  CATREAD-MSG-NUMBER.
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
           MOVE MESSAGE-BUFFER           TO  AKRON-INSTRUCT-LINE4.

           MOVE 20055                    TO  CATREAD-MSG-NUMBER.
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
           MOVE MESSAGE-BUFFER           TO  SUB-PLT-INSTRUCT-LINE1.

           MOVE 20056                    TO  CATREAD-MSG-NUMBER.
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
           MOVE MESSAGE-BUFFER           TO  SUB-PLT-INSTRUCT-LINE2.

           MOVE 16095                    TO  CATREAD-MSG-NUMBER.
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
           MOVE MESSAGE-BUFFER           TO  SUB-PLT-INSTRUCT-LINE3.

           MOVE 16113                    TO  CATREAD-MSG-NUMBER.
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
           MOVE MESSAGE-BUFFER TO AKRON-INST-SCREEN-1B-LINE1.

           MOVE 06018                    TO  CATREAD-MSG-NUMBER.
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
           MOVE MESSAGE-BUFFER TO AKRON-INST-SCREEN-1B-LINE2.

           MOVE 03154                    TO  CATREAD-MSG-NUMBER.
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
           MOVE MESSAGE-BUFFER           TO  BLKT-FOUND-MSG.

      *------ CHECK JCW THAT TELLS IF THEY ARE ALLOWED TO SEE MARKET
      *------ COST OF ITEMS
           MOVE "PRICE;"                 TO  JCW-NAME.
           MOVE 258                      TO  JCW-STARTING-POS.
           CALL "CFINDJCW" USING JCW-PARMS.

      ******** 19JUN91 REPLACED THE FOLLOWING STMT. PRICE
      ******** WILL BE SHOWN UNLESS THE JCW IS SPECIFICALLY
      ******** SET TO "N".  DAP.
      *****MOVE JCW-YES-NO               TO  PO-PRICE-SW.

           IF JCW-VALUE(1) IS EQUAL TO "0"
               MOVE "N" TO PO-PRICE-SW
           ELSE
               MOVE "Y" TO PO-PRICE-SW.

      *------ CHECK JCW THAT TELLS IF THEY ARE ALLOWED TO SEE COST/
      *------ USAGE INFORMATION.
           MOVE "COST;"                  TO  JCW-NAME.
           MOVE 309                      TO  JCW-STARTING-POS.
           CALL "CFINDJCW" USING JCW-PARMS.

           IF JCW-VALUE(1) IS EQUAL TO "0"
               MOVE "N" TO COST-USAGE-SW
           ELSE
               MOVE "Y" TO COST-USAGE-SW.

           MOVE SPACES                   TO  BASE-AREA.
           MOVE 1                        TO  DB-SUB.
           OPEN INPUT PLANT-FILE.
           MOVE "N"                      TO  EOF-FLAG
           PERFORM UNTIL EOF-FLAG = "Y"
               READ PLANT-FILE AT END
                   MOVE "Y"              TO  EOF-FLAG
               END-READ
               IF EOF-FLAG = "N"
                   MOVE PLANT-ID         TO  BASE-PLT    (DB-SUB)
                   MOVE PLANT-HOMEGRP2   TO  BASE-GROUP  (DB-SUB)
                   MOVE PLANT-USAGEFIL   TO  FILENAMES   (DB-SUB)
                   MOVE 0                TO  FILENUMBERS (DB-SUB)
                   MOVE "  STORES."      TO  BASE-NAME   (DB-SUB)
                   MOVE PLANT-DESC       TO  BASE-PLT-DESC (DB-SUB)
                   ADD 1                 TO  DB-SUB
               END-IF
           END-PERFORM.
           CLOSE PLANT-FILE.

           IF DB-SUB  - 1 > 1
              MOVE "Y"                   TO  MULTIPLE-DB-PLANT.

           MOVE ZERO TO SUB.
           PERFORM 14 TIMES
               ADD 1 TO SUB
               MOVE ZERO TO K-MTH-USAGE (SUB)
           END-PERFORM.

           MOVE "SAP " TO PLTINFOKEY OF MPLTINFO-REC-I.
           READ MPLTINFO-I INTO BUF-MPLTINFO
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS = "00"
               IF MPLTINFO-SAP-HIDE-Q1-SW = "Y"
                   MOVE "Y"              TO  SAP-PLANT-SW.

       1-H-X.
           EXIT.

       2-EOJ.
           MOVE 3                        TO  SAVE-PARA-NUMBER.

           IF OVERRIDE-DB-FLAG = "Y"
               PERFORM 9100-RESET-DB THRU 9190-RD-X.

           PERFORM 9999-CLOSE-STUFF.

       2-EOJ-X.
           EXIT.

       2100-BLOWUP.
           MOVE SAVE-PARA-NUMBER         TO  BU-DISPLAY-PARA.
           CALL "TBLOWUP" USING BASE, BU-PGM-NAME, STATUS-AREA,
               VIEW-COMAREA, KSAM-STATUS, BU-DISPLAY-MSG,
               BU-DISPLAY-AREA.


       6-INQ-MATL.

      **************************************************************
      **                                                          **
      **        C O R P   C O D E   E N T R Y   S C R E E N       **
      **                                                          **
      **************************************************************

       61-WRITE-SCREEN-1.
           MOVE 5                        TO  SAVE-PARA-NUMBER.

           IF OVERRIDE-DB-FLAG = "Y"
               PERFORM 9100-RESET-DB THRU 9190-RD-X.

           IF PASSED-CODE > SPACES
               MOVE PASSED-CODE          TO  DISP-CODE-1, CODE-ARG
               MOVE SPACES               TO  PASSED-CODE
               MOVE COMPANY-SAVE         TO  DE-COMP-1,
                                      COMP-SCREEN-INDIC
               GO TO 61-GET-CORP-CODE-DESC.

       61-GETNEXTFORM.
           MOVE "FMTLSTAT1"              TO  VIEW-NFNAME.
           PERFORM 9999-GETNEXTFORM.
           MOVE "Y"                      TO  FIRST-FORM-GOT-FLAG.

           MOVE SPACES                   TO  DE-FIELDS-1.

           IF MORE-THAN-ONE-DB
               MOVE AKRON-INSTRUCT-LINE1 TO  MSG-LINE1-1
               MOVE AKRON-INSTRUCT-LINE2 TO  MSG-LINE2-1
               MOVE AKRON-INSTRUCT-LINE3 TO  MSG-LINE3-1
               MOVE SPACES               TO  MSG-LINE4-1
           ELSE
               MOVE SUB-PLT-INSTRUCT-LINE1  TO  MSG-LINE1-1
               MOVE SUB-PLT-INSTRUCT-LINE2  TO  MSG-LINE2-1
               MOVE SPACES               TO  MSG-LINE3-1.

           MOVE COMPANY-SAVE             TO  DE-COMP-1,
                                        COMP-SCREEN-INDIC.

           PERFORM 9999-PUTBUFFER-1.
           PERFORM 9999-PUTWINDOW.
      **************************************************************
      **   FROM THE CORP CODE ENTRY SCREEN, THE USER HAS THE      **
      **   FOLLOWING OPTIONS -                                    **
      **     1.  END PROGRAM                                      **
      **     2.  ENTER CODE, THUS AUTOMATICALLY BRINGING UP BASIC **
      **         INQUIRY SCREEN                                   **
      **************************************************************

       61-READ-SCREEN-1.
           MOVE 6                        TO  SAVE-PARA-NUMBER.
      *----- f1 f2, APPLICATION, f3 f6 f7 INVALID, f4 REFRESH, f5 PRT,
      *----- 'ENTER' IS VALID
           MOVE "I"                      TO  SRF-FKEY (7).
           MOVE 5                        TO  SRF-KEYSET.
           PERFORM 9999-DO-SCREEN-1.

           IF VIEW-LASTKEY = EXIT-PROGRAM
               GO TO 6-IM-X.

           MOVE VIEW-LASTKEY             TO  SAVE-VIEW-LASTKEY.
      *----- FOR AKRON PLANT, THE DEFAULT IS f1
           IF MORE-THAN-ONE-DB
               IF SAVE-VIEW-LASTKEY = 0
                   MOVE 1                TO  SAVE-VIEW-LASTKEY.

      *---------- IF CORP CODE IS NOT NUMERIC (NOT 7 DIGITS), THERE
      *           IS A CHANCE THE USER COULD BE ENTERING AN "ALTERNATE
      *           KEY".  THEREFORE, CHECK ALT KEY DATASET BEFORE
      *           CONTINUING.

           MOVE DISP-CODE-1              TO  ALT-KEY-ARG.
           CALL "TALTKEY" USING RET-CODE, BASE, STATUS-AREA,
             ALT-KEY-ARG ALT-CORP-CODE.
           MOVE ALT-CORP-CODE            TO  DISP-CODE-1.
           IF RET-CODE NOT = "00"
               MOVE "TALTKEY ERROR 61-GB1" TO BU-DISPLAY-MSG
               PERFORM 2100-BLOWUP.

      *****************************************************
      *                                                   *
      *   IF THE COMPANY IS AN AKRON PLANT AND THE 'f1'   *
      *   KEY IS PRESSED THEN BRING UP THE BASIC INQURIY  *
      *   SCREEN FOR THE CODE IN ITS HOME DATA BASE       *
      *   IF THE 'f2' IS PRESSED THEN BRING UP THE OVERALL*
      *   INQUIRY SCREEN FOR ALL DATA BASES IN THE AKRON  *
      *   COMPLEX PLT 1,2,3,5                             *
      *   IF ALL THE DATA BASES HAVE NOT BEEN OPEN YET    *
      *   THEN OPEN THE DATA BASES                        *
      *                                                   *
      *****************************************************

           IF MORE-THAN-ONE-DB AND SAVE-VIEW-LASTKEY = 2
               GO TO 67-WRITE-OVERALL-DB-SCREEN.

      *    "NOW GETTING DATA"
           MOVE 14063                    TO  CATREAD-MSG-NUMBER.
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
           MOVE 76                       TO  MESSAGE-ACTLEN.
           PERFORM 9999-PUTWINDOW.
           PERFORM 9999-SHOWFORM.

       61-GET-CORP-CODE-DESC.
           MOVE 81                       TO  SAVE-PARA-NUMBER.
           MOVE DISP-CODE-1              TO  CODE-ARG.
           PERFORM 9999-GETKEY-MSTORERM-CD-I.
           IF NO-ENTRY
             IF FIRST-FORM-GOT-FLAG = "Y"
               MOVE 19009                TO  CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE 1                    TO  SRF-ERROR-FLD
               GO TO 61-READ-SCREEN-1
             ELSE
               GO TO 61-GETNEXTFORM.

           IF STR-STATE = "F"
                   MOVE 03161            TO  CATREAD-MSG-NUMBER
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE MESSAGE-BUFFER   TO  DISP-INFO-2 DISP-INFO-3
           ELSE
               MOVE SPACES               TO  DISP-INFO-2 DISP-INFO-3.

           MOVE 5                        TO  CDESC-LINES-TO-GET.
           MOVE "N"                      TO  CDESC-LOCAL-DESC-OPTION.
           CALL "CDESC" USING CDESC-RET-CODE, BASE, STATUS-AREA,
             BU-DISPLAY-MSG, CODE-ARG, CDESC-DATA.
           IF BU-DISPLAY-MSG-1 NOT = SPACES
               PERFORM 2100-BLOWUP.

      *------- IF AUTHORIZATION FLAG IS SET, DISPLAY LITERAL ON SCREEN.
           IF STR-AUTH-FLAG = "X"
               MOVE SPACES               TO  HOLD-KM-LINE
               MOVE CDESC (1)            TO  HOLD-KW-MOD
               MOVE 16182                TO  CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER       TO  HOLD-AUTH-LIT
               MOVE HOLD-KM-LINE         TO  DISP-DESC-LINE-3 (1)
           ELSE
           MOVE CDESC (1)                TO  DISP-DESC-LINE-3 (1).
           MOVE CDESC (2)                TO  DISP-DESC-LINE-3 (2).
           MOVE CDESC (3)                TO  DISP-DESC-LINE-3 (3).
           IF CDESC-LINES-GOT > 4
               MOVE MORE-AVAIL-MSG       TO  DISP-DESC-LINE-3 (4)
           ELSE
               MOVE CDESC (4)            TO  DISP-DESC-LINE-3 (4).

       62-GET-CODE.
           MOVE 9                        TO  SAVE-PARA-NUMBER.
      **************************************************************
      **   EACH TIME A NEW CORP CODE HAS BEEN ENTERED AND         **
      **   VALIDATED, WE MOVE ALL THE DATA INTO EACH SCREEN.      **
      **   NOTE THAT SCREEN-4 DATA (MORE DESC) IS "FOUND" AND     **
      **   "GOT" EACH TIME THE USER GOES TO THAT SCREEN.          **
      **************************************************************

           PERFORM 70-MOVE-DE-FIELDS-2.
           PERFORM 71-MOVE-DE-FIELDS-3 THRU 71-M-DE-F-X.

      ********************************************
      *                                          *
      *  CHECK IF THIS CODE IS ON A BLANKET BY   *
      *  CALLING SUBROUTINE 'TCHKBLKT'. IT WILL  *
      *  RETURN A MSG IN 'TRM-RLSE-MSG' IF IT IS *
      *  ON A BLANKET OTHERWISE 'TRM-RLSE-MSG'   *
      *  WILL BE SPACES. THIS MSG IS PRINTED ON  *
      *  THE FIRST CODE INQUIRY SCREEN           *
      *                                          *
      ********************************************

           MOVE ZEROS                    TO  TOTAL-BLANKET-COUNT.
           MOVE SPACES                   TO  R11-SMALL-PO
                                             R11-LARGE-PO.
           CALL "TCHKBLKT" USING BASE,
                                 CODE-ARG,
                                 CHKBLKT-PARMS.

           IF TOTAL-BLANKET-COUNT > ZEROS
               MOVE BLKT-FOUND-MSG       TO  DISP-BLKT-MSG.

      *--------- SHOULD TECH. BULLETIN LITERAL BE DISPLAYED ON SCREEN?
           IF DTECHBUL-SW = "Y"
               PERFORM 9999-CHAINHD-DTECHBUL-I
               IF FILE-STATUS = "00"
                   MOVE "Y" TO SHOW-LIT-SW
               ELSE
                   MOVE "N" TO SHOW-LIT-SW.

           IF SHOW-LIT-SW = "N" AND DCOMPL-SW = "Y"
               PERFORM 9999-CHAINHD-DCOMPL-I
               IF FILE-STATUS = "00"
                   MOVE "Y" TO SHOW-LIT-SW
               ELSE
                   MOVE "N" TO SHOW-LIT-SW.

      **************************************************************
      **                                                          **
      **        B A S I C   I N Q U I R Y   S C R E E N           **
      **                                                          **
      **************************************************************

       62-WRITE-SCREEN-2.
           IF COST-USAGE-SW = "N"
               MOVE 90                   TO  SRF-ERROR-FLD.

           MOVE 10                       TO  SAVE-PARA-NUMBER.
           MOVE "FMTLSTAT2"              TO  VIEW-NFNAME.
           PERFORM 9999-GETNEXTFORM.

           MOVE COMP-SCREEN-INDIC        TO  DE-COMP-2.
           PERFORM 9999-PUTWINDOW.

      **************************************************************
      **   FROM THE BASIC INQUIRY SCREEN, THE USER HAS THE        **
      **   FOLLOWING OPTIONS -                                    **
      **     1.  END THE PROGRAM.                                 **
      **     2.  ENTER A NEW CORP CODE (GO TO SCREEN-1)           **
      **     3.  BRING UP THE RESERVATION INQUIRY SCREEN          **
      **     4.  BRING UP SCREEN TO SEE MORE LINES OF DESC        **
      **     5.  BRING UP MORE INQUIRY FIELDS SCREEN              **
      **     6.  INQUIRY THE LAST PO   (12/18/96 96-042)          **
      **************************************************************

      *----- f1,f2,f4,f6,f7,f8 APPLICATION, f3 INVALID, f5 PRT, 'ENTER' INVALID
           MOVE 0                        TO  SRF-KEYSET.
           MOVE "I"                      TO  SRF-FKEY (HP-F3-KEY).
           MOVE "I"                      TO  SRF-ENTER-FLAG.
           PERFORM 9999-DO-SCREEN-2.
           MOVE SPACES                   TO  MESSAGE-BUFFER.
           IF VIEW-LASTKEY = EXIT-PROGRAM
               GO TO 6-IM-X
           ELSE
           IF VIEW-LASTKEY = EXIT-AREA
               GO TO 61-WRITE-SCREEN-1
           ELSE
           IF VIEW-LASTKEY = 6
               GO TO 68-WRITE-RESERVATION-SCREEN
           ELSE
           IF VIEW-LASTKEY = 5
               PERFORM 69-LAST-PO-INQUIRY THRU 69-EXIT
               MOVE SPACES TO HISTORY-INDIC
               IF MESSAGE-BUFFER NOT = SPACES
                   MOVE 1 TO SRF-ERROR-FLD
               END-IF
               GO TO 62-WRITE-SCREEN-2
           ELSE
           IF VIEW-LASTKEY = 4
               GO TO 64-WRITE-SCREEN-4
           ELSE
           IF VIEW-LASTKEY = 2
               GO TO 63-WRITE-SCREEN-3
           ELSE
           IF VIEW-LASTKEY = 1
               GO TO 66-WRITE-BLANKET-SCREEN.

      **************************************************************
      **                                                          **
      **    M O R E   I N Q U I R Y   F I E L D S   S C R E E N   **
      **                                                          **
      **************************************************************

       63-WRITE-SCREEN-3.
           IF COST-USAGE-SW = "N"
               MOVE 90                   TO  SRF-ERROR-FLD.

           MOVE 12                       TO  SAVE-PARA-NUMBER.
           IF SAP-PLANT-SW = "Y"
               MOVE "FMTLSTAT3S"         TO  VIEW-NFNAME
           ELSE
               MOVE "FMTLSTAT3"          TO  VIEW-NFNAME.
           PERFORM 9999-GETNEXTFORM.
           MOVE COMP-SCREEN-INDIC        TO  DE-COMP-3.
           PERFORM 9999-PUTWINDOW.
      **************************************************************
      **   FROM THE MORE INQUIRY FIELDS SCREEN, THE USER HAS THE  **
      **   OPTION TO END THE PROGRAM OR GO TO ANY OF THE OTHER    **
      **   4 SCREENS.                                             **
      **************************************************************
      *----- f1,f4,f6,f7,f8 APPLICATION, f2,f3 INVALID, f5 PRT, 'ENTER' INVALID
DP9802*    MOVE 4                        TO  SRF-KEYSET.
DP9802     MOVE 0                        TO  SRF-KEYSET.
           MOVE "I"                      TO  SRF-FKEY (HP-F3-KEY).
           MOVE "I"                      TO  SRF-ENTER-FLAG.
           PERFORM 9999-DO-SCREEN-3.
           MOVE SPACES                   TO  MESSAGE-BUFFER.
           IF VIEW-LASTKEY = EXIT-PROGRAM
               GO TO 6-IM-X
           ELSE
           IF VIEW-LASTKEY = EXIT-AREA
               GO TO 61-WRITE-SCREEN-1
           ELSE
           IF VIEW-LASTKEY = 6
               GO TO 68-WRITE-RESERVATION-SCREEN
           ELSE
DP9802     IF VIEW-LASTKEY = 5
DP9802         PERFORM 69-LAST-PO-INQUIRY THRU 69-EXIT
DP9802         MOVE SPACES TO HISTORY-INDIC
DP9802         IF MESSAGE-BUFFER NOT = SPACES
DP9802             MOVE 1 TO SRF-ERROR-FLD
DP9802         END-IF
DP9802         GO TO 63-WRITE-SCREEN-3
DP9802     ELSE
           IF VIEW-LASTKEY = 4
               GO TO 64-WRITE-SCREEN-4
           ELSE
           IF VIEW-LASTKEY = 2
               IF STR-DISPLAY
                   PERFORM 73-MOVE-TOT-USAGE THRU 73-EXIT
               ELSE
                   PERFORM 72-MOVE-STR-USAGE THRU 72-EXIT
               END-IF
               GO TO 63-WRITE-SCREEN-3.
           IF VIEW-LASTKEY = 1
               GO TO 62-WRITE-SCREEN-2.

      **************************************************************
      **                                                          **
      **         M O R E   D E S C R I P T I O N   S C R E E N    **
      **                                                          **
      **************************************************************

       64-WRITE-SCREEN-4.
           IF COST-USAGE-SW = "N"
               MOVE 90                   TO  SRF-ERROR-FLD.

           MOVE 14                       TO  SAVE-PARA-NUMBER.
           MOVE "FMTLSTAT4"              TO  VIEW-NFNAME.
           PERFORM 9999-GETNEXTFORM.
           MOVE SPACES                   TO  DE-FIELDS-4.
           MOVE CORP-CODE                TO  DISP-CODE-4.
           MOVE COMP-SCREEN-INDIC        TO  DE-COMP-4.

       64-FIND-DDESC.
           MOVE 15                       TO  SAVE-PARA-NUMBER.
           MOVE SPACES                   TO  FULL-DESC-TBL.
           MOVE  +0                      TO  NUM-LINES-FULL-DESC.
           SET PAGE-INDEX                TO  1.
           SET LINE-INDEX                TO  1.

           PERFORM 9999-CHAINHD-DMANPART-CD-I.
             PERFORM 83-GET-DMANPART THRU 83-GD-X
                UNTIL (NOT GOOD-CALL) OR NUM-LINES-FULL-DESC = 48.

           PERFORM 9999-CHAINHD-DDESC-CD-I.
           PERFORM 81-GET-DDESC THRU 81-GD-X
              UNTIL (NOT GOOD-CALL) OR NUM-LINES-FULL-DESC = 48.

           PERFORM 9999-CHAINHD-DDESC2-CD-I.
           MOVE SPACES                   TO  BUF-DDESC2
           PERFORM 82-GET-DDESC2 THRU 82-GD-X
              UNTIL (NOT GOOD-CALL) OR NUM-LINES-FULL-DESC = 48.

           IF DTECHBUL-SW = "Y"
               PERFORM 9999-CHAINHD-DTECHBUL-I
               PERFORM 84-GET-DTECHBUL THRU 84-GD-X
                  UNTIL (NOT GOOD-CALL) OR NUM-LINES-FULL-DESC = 48.

           IF DCOMPL-SW = "Y"
               PERFORM 9999-CHAINHD-DCOMPL-I
               PERFORM 85-GET-DCOMPL THRU 85-GD-X
                  UNTIL (NOT GOOD-CALL) OR NUM-LINES-FULL-DESC = 48.

           DIVIDE NUM-LINES-FULL-DESC BY 12
              GIVING NUM-FULL-PAGES
              REMAINDER NUM-LINES-LAST-PAGE.

           IF NUM-LINES-LAST-PAGE = 0
               IF NUM-FULL-PAGES = 0
      ***          NO DESCRIPTION ON FILE         ***
                   MOVE 14003            TO  CATREAD-MSG-NUMBER
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE MESSAGE-BUFFER   TO  FULL-DESC-LINE (1, 1)
                   SET LAST-PAGE-INDEX   TO  1
               ELSE
                   SET LAST-PAGE-INDEX   TO  NUM-FULL-PAGES
           ELSE
               IF NUM-FULL-PAGES = 0
                   SET LAST-PAGE-INDEX   TO  1
               ELSE
                   SET LAST-PAGE-INDEX   TO  NUM-FULL-PAGES
                   SET LAST-PAGE-INDEX UP BY 1.

           SET PAGE-INDEX                TO  1.

       64-WRITE-MSG-LINE.
           MOVE 16                       TO  SAVE-PARA-NUMBER.
           IF PAGE-INDEX = 1
             IF PAGE-INDEX IS LESS THAN LAST-PAGE-INDEX
                 MOVE FRWD-REVIEW-MSG    TO  DESC-MSG
             ELSE
                 MOVE SPACES             TO  DESC-MSG
           ELSE
             IF PAGE-INDEX IS LESS THAN LAST-PAGE-INDEX
                 MOVE BKWD-FRWD-REVIEW-MSG        TO DESC-MSG
             ELSE
                 MOVE BKWD-REVIEW-MSG    TO  DESC-MSG.

       64-PUT-BUFFER.
           MOVE 17                       TO  SAVE-PARA-NUMBER.
           MOVE FULL-DESC-PAGE (PAGE-INDEX) TO DISP-DESC-TBL.

           PERFORM 9999-PUTWINDOW.
      *----- f1,f2,f3,f4,f6,f7,f8 APPLICATION, f5 PRT, 'ENTER' INVALID
DP9802*    MOVE 4                        TO  SRF-KEYSET.
DP9802     MOVE 0                        TO  SRF-KEYSET.
      *----- CANT GO BACKWARD IF AT BEGINNING, CANT GO FORWARD IF AT END.
           IF PAGE-INDEX = 1
               MOVE "I"                  TO  SRF-FKEY (HP-F3-KEY).
           IF PAGE-INDEX = LAST-PAGE-INDEX
               MOVE "I"                  TO  SRF-FKEY (4).
           MOVE "I"                      TO  SRF-ENTER-FLAG.
           PERFORM 9999-DO-SCREEN-4.
           MOVE SPACES                   TO  MESSAGE-BUFFER.
           IF VIEW-LASTKEY = EXIT-PROGRAM
               GO TO 6-IM-X
           ELSE
           IF VIEW-LASTKEY = EXIT-AREA
               GO TO 61-WRITE-SCREEN-1
           ELSE
           IF VIEW-LASTKEY = 6
               GO TO 68-WRITE-RESERVATION-SCREEN
           ELSE
DP9802     IF VIEW-LASTKEY = 5
DP9802         PERFORM 69-LAST-PO-INQUIRY THRU 69-EXIT
DP9802         MOVE SPACES TO HISTORY-INDIC
DP9802         IF MESSAGE-BUFFER NOT = SPACES
DP9802             MOVE 1 TO SRF-ERROR-FLD
DP9802         END-IF
DP9802         GO TO 64-WRITE-SCREEN-4
DP9802     ELSE
           IF VIEW-LASTKEY = 2
               GO TO 63-WRITE-SCREEN-3
           ELSE
           IF VIEW-LASTKEY = 1
               GO TO 62-WRITE-SCREEN-2
           ELSE
           IF VIEW-LASTKEY = HP-F3-KEY
               SET PAGE-INDEX DOWN BY 1
               GO TO 64-WRITE-MSG-LINE
           ELSE
           IF VIEW-LASTKEY = 4
               SET PAGE-INDEX UP BY 1
               GO TO 64-WRITE-MSG-LINE.

      ***********************************************
      *                                             *
      *   WRITE BLANKET INQUIRY SCREEN BY CALLING   *
      *   'TBLKTINQ' SUBROUTINE. IT WILL RETURN     *
      *   A VIEW-LASTKEY FROM A READ OF THE BLANKET *
      *   SCREEN. THIS VIEW-LASTKEY WILL DIRECT     *
      *   PROCESSING TO ANOTHER INQUIRY SCREEN      *
      *                                             *
      ***********************************************

       66-WRITE-BLANKET-SCREEN.
           MOVE 21                       TO  SAVE-PARA-NUMBER.
           CALL "TBLKINQ2" USING BASE,
                                 CODE-ARG,
                                 COMP-SCREEN-INDIC,
                                 VIEW-COMAREA,
                                 SCREEN-PRINT-PARMS,
                                 PASSED-SPOOL-PRT,
                                 LANGUAGE-PARMS
           IF VIEW-LASTKEY = 1
               GO TO 62-WRITE-SCREEN-2
           ELSE
           IF VIEW-LASTKEY = 2
               GO TO 63-WRITE-SCREEN-3
           ELSE
           IF VIEW-LASTKEY = 6
               GO TO 68-WRITE-RESERVATION-SCREEN
           ELSE
           IF VIEW-LASTKEY = EXIT-AREA
               GO TO 61-WRITE-SCREEN-1
           ELSE
           IF VIEW-LASTKEY = EXIT-PROGRAM
               GO TO 6-IM-X.

      *****************************************************************
      **                                                             **
      **    O V E R A L L   D A T A B A S E   I N Q U I R Y          **
      **                                                             **
      *****************************************************************
       67-WRITE-OVERALL-DB-SCREEN.
           MOVE 27                       TO  SAVE-PARA-NUMBER.
           MOVE DISP-CODE-1              TO  CODE-ARG.
           CALL "SMTALLDB" USING BASE, VIEW-COMAREA, MPLTINFO-COMP,
             PASSED-SPOOL-PRT, CODE-ARG, LANGUAGE-PARMS,
             BASE-AREA, RETURN-BASE.
           IF RETURN-BASE = "NOTFOUND"
      *------  STORES CODE DOES NOT EXIST IN ANY PLANT
               MOVE 19019                TO  CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE 1                    TO  SRF-ERROR-FLD
               MOVE "FMTLSTAT1"          TO  VIEW-NFNAME
               GO TO 61-READ-SCREEN-1.

           IF VIEW-LASTKEY = EXIT-PROGRAM
               GO TO 6-IM-X
           ELSE
           IF VIEW-LASTKEY = EXIT-AREA
               GO TO 61-WRITE-SCREEN-1
           ELSE
           IF RETURN-BASE = SPACES
               GO TO 61-GET-CORP-CODE-DESC
           ELSE
               PERFORM 9000-POINT-DIFFERENT-DB THRU 9090-PDD-X
               GO TO 61-GET-CORP-CODE-DESC.

      ***********************************************
      *                                             *
      *   WRITE RESERVATION INQUIRY SCREEN BY CALL- *
      *   ING 'TRSRVINQ' SUBROUTINE.  IT WILL RETURN*
      *   A VIEW-LASTKEY FROM A READ OF THIS SCREEN.*
      *   THIS VIEW-LASTKEY WILL DIRECT THE PRO-    *
      *   CESSING TO ANOTHER INQUIRY SCREEN.        *
      *                                             *
      ***********************************************

       68-WRITE-RESERVATION-SCREEN.
           MOVE 32                       TO  SAVE-PARA-NUMBER.
           CALL "TRSRVINQ" USING BASE,
                                 CODE-ARG,
                                 COMP-SCREEN-INDIC,
                                 VIEW-COMAREA,
                                 SCREEN-PRINT-PARMS,
                                 PASSED-SPOOL-PRT,
                                 FATAL-ERR-SW,
                                 BU-DISPLAY-MSG,
                                 LANGUAGE-PARMS.

           IF FATAL-ERR-SW  =  "Y"
               MOVE "TRSRVINQ ERROR IN 68-W-R-SCREEN"
                                         TO  BU-DISPLAY-MSG
               PERFORM 2100-BLOWUP.
           IF VIEW-LASTKEY = 1
               GO TO 62-WRITE-SCREEN-2
           ELSE
           IF VIEW-LASTKEY = 2
               GO TO 63-WRITE-SCREEN-3
           ELSE
           IF VIEW-LASTKEY = 4
               GO TO 64-WRITE-SCREEN-4
           ELSE
           IF VIEW-LASTKEY = EXIT-AREA
               GO TO 61-WRITE-SCREEN-1
           ELSE
           IF VIEW-LASTKEY = EXIT-PROGRAM
               GO TO 6-IM-X.

DP9802*----- BLOCK THE PROGRAM FROM FALLING THROUGH INTO THE NEXT
DP9802*----- PARAGRAPH.
           GO TO 6-IM-X.

       69-LAST-PO-INQUIRY.
      *----VERIFY-PO-EXISTENCE.
           MOVE "N"  TO  ERR-SW.
           PERFORM 691-CHECK-STORES-DB  THRU  691-EXIT.
           IF ERR-SW = "Y"
               GO TO 69-EXIT.

       69-PO-HEADER-SUBPGM.
           IF HISTORY-INDIC = "X"
               GO TO 69-PO-HEADER-HISTORY-SUBPGM.

           MOVE PLT-ARG TO ARG-PLT.
           MOVE PO-ARG  TO ARG-PO.
           CALL "TPOINQH" USING  BASE,
                                 SCREEN-PRINT-PARMS,
                                 PASSED-SPOOL-PRT,
                                 VIEW-COMAREA,
                                 PO-ARGUMENT-VALUES,
                                 SAVE-POINQ-AREA,
                                 LANGUAGE-PARMS.
           IF VIEW-LASTKEY EQUAL 2
               CALL "TPOINQI" USING  BASE,
                                     SCREEN-PRINT-PARMS,
                                     PASSED-SPOOL-PRT,
                                     VIEW-COMAREA,
                                     PO-ARGUMENT-VALUES,
                                     SAVE-POINQ-AREA,
                                     LANGUAGE-PARMS
               IF VIEW-LASTKEY EQUAL 1
                   GO TO  69-PO-HEADER-SUBPGM
               ELSE
                   GO TO  69-EXIT
           ELSE
               GO TO  69-EXIT.

       69-PO-HEADER-HISTORY-SUBPGM.
           MOVE PLT-ARG TO ARG-PLT.
           MOVE HIST-PO-ARG  TO ARG-PO.
           CALL "SPOINQHH" USING BASE,
                                 BASE-STHIST,
                                 SCREEN-PRINT-PARMS,
                                 PASSED-SPOOL-PRT,
                                 VIEW-COMAREA,
                                 PO-ARGUMENT-VALUES,
                                 SAVE-POINQ-AREA,
                                 LANGUAGE-PARMS.
           IF VIEW-LASTKEY EQUAL 2
               CALL "SPOINQIH" USING BASE,
                                     BASE-STHIST,
                                     SCREEN-PRINT-PARMS,
                                     PASSED-SPOOL-PRT,
                                     VIEW-COMAREA,
                                     PO-ARGUMENT-VALUES,
                                     SAVE-POINQ-AREA,
                                     LANGUAGE-PARMS
               IF VIEW-LASTKEY EQUAL 1
                   GO TO 69-PO-HEADER-HISTORY-SUBPGM.
       69-EXIT.
           EXIT.

       691-CHECK-HISTORY-DB.
           MOVE STR-LAST-PO          TO  HIST-PO-NUM.
           MOVE STR-LAST-RLSE        TO  HIST-RLSE.
           MOVE HIST-PO-ARG TO PORCVNO OF DPORECD-REC-I-H.
           START DPORECD-I-H KEY = PORCVNO OF DPORECD-REC-I-H
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
      *            ***  PO DOES NOT EXIST  ***
                   MOVE  16045 TO CATREAD-MSG-NUMBER
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE "Y"  TO  ERR-SW
               ELSE
                   MOVE "FIND DPORECD 691-CHD" TO BU-DISPLAY-MSG
                   GO TO 2100-BLOWUP
           ELSE
               MOVE "X"             TO  HISTORY-INDIC.

       691H-EXIT.
           EXIT.

       691-CHECK-STORES-DB.
           MOVE STR-LAST-PO              TO  ARG-PO-NUM.
           MOVE STR-LAST-RLSE            TO  ARG-RLSE.
           MOVE PO-ARG TO PORCVNO OF DPORECD-REC-I.
           START DPORECD-I KEY = PORCVNO OF DPORECD-REC-I
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
                   PERFORM 691-CHECK-HISTORY-DB  THRU  691H-EXIT
                   IF ERR-SW = "Y"
      *                ***  PO DOES NOT EXIST  ***
                       MOVE  16045 TO CATREAD-MSG-NUMBER
                       PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                       GO TO 691-EXIT
                   ELSE
                       GO TO 691-EXIT
               ELSE
                   MOVE "START DPORECD*691-CSD"  TO  BU-DISPLAY-MSG
                   GO TO 2100-BLOWUP.

       691-EXIT.
           EXIT.


       70-MOVE-DE-FIELDS-2.
           MOVE 33                       TO  SAVE-PARA-NUMBER.
           MOVE SPACES                   TO  DISP-DISP-INSTRUCT
                                          DISP-REPAIR
                                          DISP-STOCK-OUT
                                          DISP-HIGH-USAGE
                                          DISP-BLKT-MSG.
           MOVE CORP-CODE                TO  DISP-CODE-2.
***************
DCR01      MOVE CORP-CODE                TO  WS-ARIBA-CORPCODE.
DCR01      PERFORM  9999-READK-ARIBA-CATALOG  THRU 9999-READK-EXIT.
DCR01      MOVE WS-ARIBA-ITEM-SW         TO  DISP-ARIBA-FLAG.
***************
           MOVE STR-PREV-CODE            TO  DISP-LOC-CODE.
           MOVE STR-CLASS                TO  DISP-CLASS.
           MOVE STR-DFLT-DEPT            TO  DISP-DEFAULT-DEPT.
           MOVE "ALT UM CF"              TO  HEAD-CF.
           MOVE "UM1"                    TO  HEAD-UM1.
           MOVE "UM2"                    TO  HEAD-UM2.
           MOVE STR-UM                   TO  DISP-UM.
           MOVE STR-UM1                  TO  DISP-UM1.
           MOVE STR-UM2                  TO  DISP-UM2.
           MOVE STR-UM1-CF               TO  DISP-UM1-CF.
           MOVE STR-UM2-CF               TO  DISP-UM2-CF.
           MOVE STR-ONHAND               TO  DISP-ONHAND.
           MOVE STR-LOC (1)              TO  DISP-LOC1.
           MOVE STR-LOC-ONHAND (1)       TO  DISP-LOC1-ONHAND.
           MOVE STR-LOC (2)              TO  DISP-LOC2.
           MOVE STR-LOC-ONHAND (2)       TO  DISP-LOC2-ONHAND.
           MOVE STR-LOC (3)              TO  DISP-LOC3.
           MOVE STR-LOC-ONHAND (3)       TO  DISP-LOC3-ONHAND.
           MOVE STR-LOC (4)              TO  DISP-LOC4.
           MOVE STR-LOC-ONHAND (4)       TO  DISP-LOC4-ONHAND.
           MOVE STR-LOC (5)              TO  DISP-LOC5.
           MOVE STR-LOC-ONHAND (5)       TO  DISP-LOC5-ONHAND.
           MOVE STR-LOC (6)              TO  DISP-LOC6.
           MOVE STR-LOC-ONHAND (6)       TO  DISP-LOC6-ONHAND.
           MOVE STR-RESERVED             TO  DISP-RESERVED.
           SUBTRACT STR-RESERVED FROM STR-ONHAND GIVING DISP-AVAIL.
      ***********************************
      **  CALL 'SONORDER' TO GET TOTAL
      **  ONORDER IN STOREROOM UM
      ***********************************
           MOVE "Y"                      TO  SONORDER-CALC-DIR-ORD-SW.
           CALL "SONORDER" USING BASE,
                                 CODE-ARG,
                                 SONORDER-PARMS,
                                 COMPANY-SAVE,
                                 STATUS-AREA,
                                 BU-DISPLAY-MSG,
                                 BU-DISPLAY-FLDS.
           IF BU-DISPLAY-MSG NOT = SPACES
                MOVE "    ERROR"         TO  DISP-TOT-RED
                MOVE ZEROES              TO  DISP-STR-ONORDER
                                                DISP-DIR-ONORDER
                MOVE SPACES              TO  BU-DISPLAY-MSG
                MOVE ALL "0"             TO  BU-DISPLAY-AREA
           ELSE
           IF COMPANY-SAVE-1-2 = "11"
               MOVE SONORDER-TOTAL-ONORDER  TO  DISP-STR-ONORDER
               MOVE ZEROS                TO  DISP-DIR-ONORDER
               MOVE SONORDER-TOTAL-ONORDER  TO  DISP-TOT-ONORDER
           ELSE
               MOVE SONORDER-STR-ONORDER TO  DISP-STR-ONORDER
               MOVE SONORDER-DIR-ONORDER TO  DISP-DIR-ONORDER
               MOVE SONORDER-TOTAL-ONORDER  TO  DISP-TOT-ONORDER.
      ***********************************
      **  CALL 'SONDOCK' TO GET TOTAL
      **  ONDOCK IN STOREROOM UM
      ***********************************
           CALL "SONDOCK"  USING BASE,
                                 CODE-ARG,
                                 TOTAL-ONDOCK
                                 STATUS-AREA,
                                 BU-DISPLAY-MSG,
                                 BU-DISPLAY-FLDS.
           IF BU-DISPLAY-MSG NOT = SPACES
                MOVE "    ERROR"         TO  DISP-ONDOCK-ERROR
                MOVE SPACES              TO  BU-DISPLAY-MSG
                MOVE ALL "0"             TO  BU-DISPLAY-AREA
           ELSE
                MOVE TOTAL-ONDOCK        TO  DISP-ONDOCK.
           MOVE STR-LAST-PO              TO  DISP-PO-NUM
                                             ARG-PO-NUM.
           MOVE STR-LAST-RLSE            TO  DISP-RLSE
                                             ARG-RLSE.
           MOVE PO-ARG TO PORCVNO OF DPORECD-REC-I.
           READ DPORECD-I INTO BUF-DPORECD
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
      *----------- IF NOT IN THE LIVE DATABASE, SEARCH HISTORY.
               MOVE SPACES               TO  DISP-PO-BUYER
               MOVE ARG-PO-NUM           TO  HIST-PO-NUM
               MOVE ARG-RLSE             TO  HIST-RLSE
               MOVE HIST-PO-ARG TO PORCVNO OF DPORECD-REC-I-H
               READ DPORECD-I-H INTO BUF-DPORECD-H
                   INVALID KEY MOVE FILE-STATUS TO FILE-STATUS
               END-READ
               IF FILE-STATUS = "00"
                   MOVE POH-BUYER        TO  DISP-PO-BUYER
               END-IF
           ELSE
               MOVE PO-BUYER             TO  DISP-PO-BUYER.
           MOVE STR-AVG-COST             TO  DISP-AVG-COST.
           MOVE STR-DISB-INSTR           TO  DISP-DISP-INSTRUCT.
           MOVE STR-HIGH-USAGE           TO  DISP-HIGH-USAGE.
           MOVE STR-LAST-REQ-NO          TO  DISP-REQ-NUM.
           MOVE STR-LAST-REQ-DATE        TO  DATE-VALIDATE-IN.
           MOVE 4                        TO  DATE-MODE.
           CALL "TDATECK2" USING DATE-CHECK-AREA, LANGUAGE-PARMS
           MOVE DATE-SLASH-OUT           TO  DISP-REQ-DATE.

      *************************************************
020807**   IF ITEM IS RESTRICTED                     **
020807**   PUT "RESTRICTED ITEM   " MESSAGE ON THE   **
020807**   SCREEN.                                   **
      **   IF ITEM IS MAINT REPAIR OR OUTSIDE REPAIR **
      **   PUT "ITEM IS REPAIRABLE" MESSAGE ON THE   **
      **   SCREEN.                                   **
      *************************************************

020807     IF STR-RESTRICTED-FLG = 'X'
020807        MOVE '** RESTRICTED ITEM' TO  DISP-REPAIR.

           IF STR-OUT-REP = "X" OR STR-MAINT = "X"
               MOVE REPAIR-MSG           TO  DISP-REPAIR.

      *************************************************
      **   IF ITEM IS STOCKOUT, PUT STOCKOUT MSG ON  **
      **   SCREEN.                                   **
      *************************************************

           IF STR-STOCK-OT = "X"
               MOVE 19001                TO  CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER       TO  DISP-STOCK-OUT.

       71-MOVE-DE-FIELDS-3.
           MOVE 34                       TO  SAVE-PARA-NUMBER.
           MOVE CORP-CODE                TO  DISP-CODE-3.
           MOVE STR-UM                   TO  DISP-UM-3.
           MOVE STR-WR-DOWN              TO  DISP-WD.
           MOVE STR-ORD-ENG              TO  DISP-OE.
           MOVE STR-MAINT                TO  DISP-MR.
           MOVE STR-OUT-REP              TO  DISP-OR.
           MOVE STR-INS-ITM              TO  DISP-INS.
           MOVE STR-IMPORT-IND           TO  DISP-IMPORT-IND.
           MOVE STR-STOCK-OT             TO  DISP-SO.
           MOVE STR-CONS-IND             TO  DISP-CONS.
           MOVE STR-SARA-REPORTABLE      TO  DISP-SA.
           MOVE STR-RESTRICTED-FLG       TO  DISP-RW.
           MOVE STR-REQ-CHG-OVERRD       TO  DISP-OV.
           MOVE STR-ONHAND               TO  DISP-ONHAND-3.
           MOVE STR-INIT-DATE            TO  DATE-VALIDATE-IN.
           MOVE 4                        TO  DATE-MODE.
           CALL "TDATECK2" USING DATE-CHECK-AREA, LANGUAGE-PARMS.
           MOVE DATE-SLASH-OUT           TO  DISP-ADD-DATE.
           MOVE STR-AUTHOR               TO  DISP-ORIGINATOR.
           MOVE STR-MAX                  TO  DISP-MAX.
           MOVE STR-LAST-IDATE           TO  DATE-VALIDATE-IN.
           CALL "TDATECK2" USING DATE-CHECK-AREA, LANGUAGE-PARMS.
           MOVE DATE-SLASH-OUT           TO  DISP-ISS-DATE.
           MOVE STR-LAST-CHARGE          TO  DISP-CHARGE-DEPT.
           MOVE STR-LAST-EMPL            TO  DISP-LAST-EMPL.
           MOVE STR-REORDER              TO  DISP-REORDER.
           MOVE STR-ACT-DATE             TO  DATE-VALIDATE-IN.
           CALL "TDATECK2" USING DATE-CHECK-AREA, LANGUAGE-PARMS.
           MOVE DATE-SLASH-OUT           TO  DISP-ACT-DATE.
           PERFORM 9999-GET-MPERSONEL-I.
           MOVE STR-INV-DATE             TO  DATE-VALIDATE-IN.
           CALL "TDATECK2" USING DATE-CHECK-AREA, LANGUAGE-PARMS.
           MOVE DATE-SLASH-OUT           TO  DISP-PHY-DATE.
           IF STR-PHY-INV-CYL NOT NUMERIC
               MOVE "0000"               TO  STR-PHY-INV-CYL.
           MOVE STR-PHY-INV-CYL          TO  INV-CYCLE-9.
           MOVE INV-CYCLE-9              TO  DISP-PHY-CYCLE.
           MOVE STR-EXPEDITE             TO  DISP-EXPEDITE.
           MOVE STR-STD-COST             TO  DISP-STD-COST.
           MOVE STR-EST-LT               TO  DISP-EST-LT.
           MOVE STR-SOQ                  TO  DISP-SOQ.
CY1772     MOVE STR-MKT-COST             TO  DISP-UNIT-COST.
           IF PO-PRICE-SW = "Y"
               MOVE STR-MKT-COST         TO  DISP-MKT-COST
           ELSE
               MOVE SPACES               TO  DISP-MKT-COST-X.
           MOVE STR-OUT-REPAIR-COST      TO  DISP-OUT-REP-COST.
           MOVE STR-LAST-DLVTIMES (1)    TO  DISP-ACT-LT-1.
           MOVE STR-LAST-DLVTIMES (2)    TO  DISP-ACT-LT-2.
           MOVE STR-LAST-DLVTIMES (3)    TO  DISP-ACT-LT-3.
           MOVE STR-MTH-FCST             TO  DISP-AVG-MTH-USAGE.
           MOVE STR-EOQ                  TO  DISP-EOQ.

           PERFORM 9999-GETKEY-USAGEFIL-CD-I.

           PERFORM 72-MOVE-STR-USAGE THRU 72-EXIT.
           MOVE K-MTH-USAGE (14)         TO  DISP-USED-YTDY.


           MOVE 0                        TO  DISP-MTD-RECEIPTS
                                             DISP-RECD-YTDY
                                             DISP-LT-12-MTH-RECEIPTS.

           PERFORM 9999-GETKEY-RECEIPTFIL-CD-I.
           IF COND-WORD NOT = 0
               GO TO 71-M-DE-F-X.

           MOVE R-MTH-RECEIPTS (13)      TO  DISP-MTD-RECEIPTS.
           MOVE R-MTH-RECEIPTS (14)      TO  DISP-RECD-YTDY.

           MOVE 0                        TO  YTD-TOTAL.
           PERFORM VARYING SUB FROM 1 BY 1 UNTIL SUB > 12
               ADD R-MTH-RECEIPTS (SUB)  TO  YTD-TOTAL
           END-PERFORM.
           MOVE YTD-TOTAL                TO  DISP-LT-12-MTH-RECEIPTS.

       71-M-DE-F-X.                      EXIT.

       72-MOVE-STR-USAGE.
      *------STR USAGE IS TOTAL - DIRECT DELIVERY
           COMPUTE STR-USAGE = K-MTH-USAGE(1) - K-MTH-USAGE-DD(1).
           MOVE STR-USAGE                 TO DISP-JAN-USAGE.
           COMPUTE STR-USAGE = K-MTH-USAGE(2) - K-MTH-USAGE-DD(2).
           MOVE STR-USAGE                TO  DISP-FEB-USAGE.
           COMPUTE STR-USAGE = K-MTH-USAGE(3) - K-MTH-USAGE-DD(3).
           MOVE STR-USAGE                TO  DISP-MAR-USAGE.
           COMPUTE STR-USAGE = K-MTH-USAGE(4) - K-MTH-USAGE-DD(4).
           MOVE STR-USAGE                TO  DISP-APR-USAGE.
           COMPUTE STR-USAGE = K-MTH-USAGE(5) - K-MTH-USAGE-DD(5).
           MOVE STR-USAGE                TO  DISP-MAY-USAGE.
           COMPUTE STR-USAGE = K-MTH-USAGE(6) - K-MTH-USAGE-DD(6).
           MOVE STR-USAGE                TO  DISP-JUN-USAGE.
           COMPUTE STR-USAGE = K-MTH-USAGE(7) - K-MTH-USAGE-DD(7).
           MOVE STR-USAGE                TO  DISP-JUL-USAGE.
           COMPUTE STR-USAGE = K-MTH-USAGE(8) - K-MTH-USAGE-DD(8).
           MOVE STR-USAGE                TO  DISP-AUG-USAGE.
           COMPUTE STR-USAGE = K-MTH-USAGE(9) - K-MTH-USAGE-DD(9).
           MOVE STR-USAGE                TO  DISP-SEP-USAGE.
           COMPUTE STR-USAGE = K-MTH-USAGE(10) - K-MTH-USAGE-DD(10).
           MOVE STR-USAGE                TO  DISP-OCT-USAGE.
           COMPUTE STR-USAGE = K-MTH-USAGE(11) - K-MTH-USAGE-DD(11).
           MOVE STR-USAGE                TO  DISP-NOV-USAGE.
           COMPUTE STR-USAGE = K-MTH-USAGE(12) - K-MTH-USAGE-DD(12).
           MOVE STR-USAGE                TO  DISP-DEC-USAGE.
           COMPUTE STR-USAGE = K-MTH-USAGE(13) - K-MTH-USAGE-DD(13).
           MOVE STR-USAGE                TO  DISP-MTD-USAGE.

           MOVE 0                        TO  YTD-TOTAL.
           MOVE 0                        TO  SUB.
           PERFORM 12 TIMES
               ADD 1                     TO  SUB
               COMPUTE YTD-TOTAL = YTD-TOTAL +
                               (K-MTH-USAGE(SUB) - K-MTH-USAGE-DD(SUB))
           END-PERFORM.
           MOVE YTD-TOTAL                TO  DISP-LT-12-MTH-USAGE.
           MOVE
             "USAGE FOR ISSUES ONLY, F2 FOR ISSUES AND DIRECT DELIVERY."
             TO DISP-USAGE-LIT.
           MOVE "S" TO USAGE-SWITCH.
       72-EXIT.
           EXIT.

       73-MOVE-TOT-USAGE.
      *-----TOTAL USAGE INCLUDES STOREROOM AND DIRECT DELIVERY
           MOVE K-MTH-USAGE (1)          TO  DISP-JAN-USAGE.
           MOVE K-MTH-USAGE (2)          TO  DISP-FEB-USAGE.
           MOVE K-MTH-USAGE (3)          TO  DISP-MAR-USAGE.
           MOVE K-MTH-USAGE (4)          TO  DISP-APR-USAGE.
           MOVE K-MTH-USAGE (5)          TO  DISP-MAY-USAGE.
           MOVE K-MTH-USAGE (6)          TO  DISP-JUN-USAGE.
           MOVE K-MTH-USAGE (7)          TO  DISP-JUL-USAGE.
           MOVE K-MTH-USAGE (8)          TO  DISP-AUG-USAGE.
           MOVE K-MTH-USAGE (9)          TO  DISP-SEP-USAGE.
           MOVE K-MTH-USAGE (10)         TO  DISP-OCT-USAGE.
           MOVE K-MTH-USAGE (11)         TO  DISP-NOV-USAGE.
           MOVE K-MTH-USAGE (12)         TO  DISP-DEC-USAGE.
           MOVE K-MTH-USAGE (13)         TO  DISP-MTD-USAGE.

           MOVE 0                        TO  YTD-TOTAL.
           MOVE 0                        TO  SUB.
           PERFORM 12 TIMES
               ADD 1                     TO  SUB
               ADD K-MTH-USAGE (SUB)     TO  YTD-TOTAL
           END-PERFORM.
           MOVE YTD-TOTAL                TO  DISP-LT-12-MTH-USAGE.
           MOVE
             "USAGE FOR ISSUES AND DIRECT DELIVERY, F2 FOR ISSUES ONLY."
             TO DISP-USAGE-LIT.
           MOVE "T" TO USAGE-SWITCH.
       73-EXIT.
           EXIT.

       6-IM-X.
           EXIT.

       81-GET-DDESC.
           PERFORM 9999-GETNEXT-DDESC-CD-I.
           IF END-OF-CHAIN
               GO TO 81-GD-X.

           IF DESC-ID-NUM = "00"
               MOVE DESC-KW
                   TO FULL-DESC-LINE-KW (PAGE-INDEX, LINE-INDEX)
               MOVE DESC-MOD
                   TO FULL-DESC-LINE-MOD (PAGE-INDEX, LINE-INDEX)
           ELSE
               MOVE DESC-DATA
                   TO FULL-DESC-LINE (PAGE-INDEX, LINE-INDEX).

           ADD 1                         TO  NUM-LINES-FULL-DESC.

           IF LINE-INDEX IS LESS THAN 12
               SET LINE-INDEX UP BY 1
           ELSE
              IF PAGE-INDEX IS LESS THAN 4
                  SET PAGE-INDEX UP BY 1
                  SET LINE-INDEX         TO  1.

       81-GD-X.
           EXIT.

       82-GET-DDESC2.
           PERFORM 9999-GETNEXT-DDESC2-CD-I.
           IF END-OF-CHAIN
               GO TO 82-GD-X.

           IF DESC2-ID-NUM = "00"
               MOVE DESC2-KW
                   TO FULL-DESC-LINE-KW (PAGE-INDEX, LINE-INDEX)
               MOVE DESC2-MOD
                   TO FULL-DESC-LINE-MOD (PAGE-INDEX, LINE-INDEX)
           ELSE
               MOVE DESC2-DATA
                   TO FULL-DESC-LINE (PAGE-INDEX, LINE-INDEX).

           ADD 1                         TO  NUM-LINES-FULL-DESC.

           IF LINE-INDEX IS LESS THAN 12
               SET LINE-INDEX UP BY 1
           ELSE
               IF PAGE-INDEX IS LESS THAN 4
                   SET PAGE-INDEX UP BY 1
                   SET LINE-INDEX        TO  1.

       82-GD-X.
           EXIT.

       83-GET-DMANPART.
           PERFORM 9999-GETNEXT-DMANPART-CD-I.
           IF END-OF-CHAIN
               GO TO 83-GD-X.

           MOVE MAN-PARTNO-TYPE          TO  CFINPTYP-TYPE-DB.

           CALL "CFINPTYP" USING CFINPTYP-PARMS.
           MOVE "N"                      TO  CFINPTYP-1ST-CALL.

      *----- 11AUG1994 ADDED LOGIC FOR MAN-PARTNO-SELECT.
           IF MAN-PARTNO-SELECT NOT = SPACES
               MOVE "("
                   TO FULL-DESC-LINE-P1 (PAGE-INDEX, LINE-INDEX)
               MOVE MAN-PARTNO-SELECT
                   TO FULL-DESC-LINE-SEL (PAGE-INDEX, LINE-INDEX)
               MOVE ")"
                   TO FULL-DESC-LINE-P2 (PAGE-INDEX, LINE-INDEX).

           MOVE MAN-NAME
               TO FULL-DESC-LINE-MFR (PAGE-INDEX, LINE-INDEX).
           MOVE CFINPTYP-TYPE-SHORT
               TO FULL-DESC-LINE-TYPE (PAGE-INDEX, LINE-INDEX).
           MOVE MAN-PARTNO
               TO FULL-DESC-LINE-PARTNO (PAGE-INDEX, LINE-INDEX).

           ADD 1                         TO  NUM-LINES-FULL-DESC.

           IF LINE-INDEX IS LESS THAN 12
               SET LINE-INDEX UP BY 1
           ELSE
               IF PAGE-INDEX IS LESS THAN 4
                   SET PAGE-INDEX UP BY 1
                   SET LINE-INDEX        TO  1.

       83-GD-X.
           EXIT.

       84-GET-DTECHBUL.
           PERFORM 9999-GETNEXT-DTECHBUL-I.
           IF END-OF-CHAIN
               GO TO 84-GD-X.

           IF TECH-ID-NUM = "00"
      *--------- ADD A BLANK LINE BEFORE TECH. BULLETIN INFORMATION
               MOVE ALL "-"
                        TO  FULL-DESC-LINE (PAGE-INDEX, LINE-INDEX)
               ADD 1    TO  NUM-LINES-FULL-DESC
               IF LINE-INDEX IS LESS THAN 12
                   SET LINE-INDEX UP BY 1
               ELSE
                  IF PAGE-INDEX IS LESS THAN 4
                      SET PAGE-INDEX UP BY 1
                      SET LINE-INDEX         TO  1
                  END-IF
               END-IF
               MOVE "TECHNICAL BULLETIN"
                               TO  TL-LIT (PAGE-INDEX, LINE-INDEX)
               MOVE "LAST ACTIVITY:"
                               TO  TL-DATE-LIT (PAGE-INDEX, LINE-INDEX)
               MOVE "AUTHOR:"
                               TO  TL-USER-LIT (PAGE-INDEX, LINE-INDEX)
               MOVE TECH-LAST-ACT-YMD      TO  DATE-VALIDATE-IN
               MOVE 4                      TO  DATE-MODE
               CALL "TDATECHK" USING DATE-CHECK-AREA
               MOVE DATE-SLASH-OUT (1:6)
                                    TO  TL-1-6 (PAGE-INDEX, LINE-INDEX)
               MOVE TECH-LAST-ACT-CC
                                    TO  TL-7-8 (PAGE-INDEX, LINE-INDEX)
               MOVE DATE-SLASH-OUT (7:2)
                                    TO  TL-9-10 (PAGE-INDEX, LINE-INDEX)
               MOVE TECH-USERID
                               TO  TL-USER (PAGE-INDEX, LINE-INDEX)
           ELSE
               MOVE TECH-DATA
                   TO FULL-DESC-LINE (PAGE-INDEX, LINE-INDEX).

           ADD 1                         TO  NUM-LINES-FULL-DESC.

           IF LINE-INDEX IS LESS THAN 12
               SET LINE-INDEX UP BY 1
           ELSE
              IF PAGE-INDEX IS LESS THAN 4
                  SET PAGE-INDEX UP BY 1
                  SET LINE-INDEX         TO  1.

       84-GD-X.
           EXIT.

       85-GET-DCOMPL.
           PERFORM 9999-GETNEXT-DCOMPL-I.
           IF END-OF-CHAIN
               GO TO 85-GD-X.

           IF CMPL-ID-NUM = "00"
      *--------- ADD A BLANK LINE BEFORE COMPLIANCE REQMT INFORMATION
               MOVE ALL "-"
                        TO  FULL-DESC-LINE (PAGE-INDEX, LINE-INDEX)
               ADD 1    TO  NUM-LINES-FULL-DESC
               IF LINE-INDEX IS LESS THAN 12
                   SET LINE-INDEX UP BY 1
               ELSE
                  IF PAGE-INDEX IS LESS THAN 4
                      SET PAGE-INDEX UP BY 1
                      SET LINE-INDEX         TO  1
                  END-IF
               END-IF
               MOVE "COMPLIANCE REQMTS "
                               TO  TL-LIT (PAGE-INDEX, LINE-INDEX)
               MOVE "LAST ACTIVITY:"
                               TO  TL-DATE-LIT (PAGE-INDEX, LINE-INDEX)
               MOVE "AUTHOR:"
                               TO  TL-USER-LIT (PAGE-INDEX, LINE-INDEX)
               MOVE CMPL-LAST-ACT-YMD      TO  DATE-VALIDATE-IN
               MOVE 4                      TO  DATE-MODE
               CALL "TDATECHK" USING DATE-CHECK-AREA
               MOVE DATE-SLASH-OUT (1:6)
                                    TO  TL-1-6 (PAGE-INDEX, LINE-INDEX)
               MOVE CMPL-LAST-ACT-CC
                                    TO  TL-7-8 (PAGE-INDEX, LINE-INDEX)
               MOVE DATE-SLASH-OUT (7:2)
                                    TO  TL-9-10 (PAGE-INDEX, LINE-INDEX)
               MOVE CMPL-USERID
                               TO  TL-USER (PAGE-INDEX, LINE-INDEX)
           ELSE
               STRING CMPL-REG-BODY  "  "  CMPL-STANDARD
                        DELIMITED BY SIZE
                   INTO FULL-DESC-LINE (PAGE-INDEX, LINE-INDEX).

           ADD 1                         TO  NUM-LINES-FULL-DESC.

           IF LINE-INDEX IS LESS THAN 12
               SET LINE-INDEX UP BY 1
           ELSE
              IF PAGE-INDEX IS LESS THAN 4
                  SET PAGE-INDEX UP BY 1
                  SET LINE-INDEX         TO  1.

       85-GD-X.
           EXIT.

       9000-POINT-DIFFERENT-DB.
           MOVE "Y"                      TO  OVERRIDE-DB-FLAG.

           PERFORM 9999-CLOSE-STUFF.
      *------ OVERRIDE MSTORERM TO NEW DB LIBRARY
           STRING "OVRDBF FILE(MCFLCS0201) TOFILE(" DELIMITED BY SIZE,
             RETURN-BASE DELIMITED BY SPACES,
             "/MCFLCS0201) SHARE(*NO)" DELIMITED BY SIZE,
               INTO COMMAND-WORK.
           CALL "QCMDEXC" USING COMMAND-WORK, COMMAND-LEN.

      *------ OVERRIDE DDESC TO NEW DB LIBRARY
           STRING "OVRDBF FILE(MCFLCS1401) TOFILE(" DELIMITED BY SIZE,
             RETURN-BASE DELIMITED BY SPACES,
             "/MCFLCS1401) SHARE(*NO)" DELIMITED BY SIZE,
               INTO COMMAND-WORK.
           CALL "QCMDEXC" USING COMMAND-WORK, COMMAND-LEN.

      *------ OVERRIDE DDESC2 TO NEW DB LIBRARY
           STRING "OVRDBF FILE(MCFLCS3101) TOFILE(" DELIMITED BY SIZE,
             RETURN-BASE DELIMITED BY SPACES,
             "/MCFLCS3101) SHARE(*NO)" DELIMITED BY SIZE,
               INTO COMMAND-WORK.
           CALL "QCMDEXC" USING COMMAND-WORK, COMMAND-LEN.

      *------ OVERRIDE DMANPART TO NEW DB LIBRARY
           STRING "OVRDBF FILE(MCFLCS3603) TOFILE(" DELIMITED BY SIZE,
             RETURN-BASE DELIMITED BY SPACES,
             "/MCFLCS3603) SHARE(*NO)" DELIMITED BY SIZE,
               INTO COMMAND-WORK.
           CALL "QCMDEXC" USING COMMAND-WORK, COMMAND-LEN.

      *------ OVERRIDE DPOITEM TO NEW DB LIBRARY
           STRING "OVRDBF FILE(MCFLCS1001) TOFILE(" DELIMITED BY SIZE,
             RETURN-BASE DELIMITED BY SPACES,
             "/MCFLCS1001) SHARE(*NO)" DELIMITED BY SIZE,
               INTO COMMAND-WORK.
           CALL "QCMDEXC" USING COMMAND-WORK, COMMAND-LEN.

      *------ OVERRIDE DPORECD TO NEW DB LIBRARY
           STRING "OVRDBF FILE(MCFLCS0901) TOFILE(" DELIMITED BY SIZE,
             RETURN-BASE DELIMITED BY SPACES,
             "/MCFLCS0901) SHARE(*NO)" DELIMITED BY SIZE,
               INTO COMMAND-WORK.
           CALL "QCMDEXC" USING COMMAND-WORK, COMMAND-LEN.

      *------ OVERRIDE USAGEFIL TO NEW DB LIBRARY
           STRING "OVRDBF FILE(MCFLCSUSAG) TOFILE(" DELIMITED BY SIZE,
             RETURN-BASE DELIMITED BY SPACES,
             "/MCFLCSUSAG) SHARE(*NO)" DELIMITED BY SIZE,
               INTO COMMAND-WORK.
           CALL "QCMDEXC" USING COMMAND-WORK, COMMAND-LEN.

      *------ OVERRIDE MPLTINFO TO NEW DB LIBRARY
           STRING "OVRDBF FILE(MCFLCS0501) TOFILE(" DELIMITED BY SIZE,
             RETURN-BASE DELIMITED BY SPACES,
             "/MCFLCS0501) SHARE(*NO)" DELIMITED BY SIZE,
               INTO COMMAND-WORK.
           CALL "QCMDEXC" USING COMMAND-WORK, COMMAND-LEN.

      *------ OVERRIDE DRESERVE TO NEW DB LIBRARY
           STRING "OVRDBF FILE(MCFLCS1301) TOFILE(" DELIMITED BY SIZE,
             RETURN-BASE DELIMITED BY SPACES,
             "/MCFLCS1301) SHARE(*NO)" DELIMITED BY SIZE,
               INTO COMMAND-WORK.
           CALL "QCMDEXC" USING COMMAND-WORK, COMMAND-LEN.

           PERFORM 9999-OPEN-STUFF.

       9090-PDD-X.
           EXIT.

       9100-RESET-DB.
           MOVE "N"                      TO  OVERRIDE-DB-FLAG.

           PERFORM 9999-CLOSE-STUFF.

           MOVE "DLTOVR FILE(MCFLCS0201)" TO COMMAND-WORK.
           CALL "QCMDEXC" USING COMMAND-WORK, COMMAND-LEN.

           MOVE "DLTOVR FILE(MCFLCS1401)" TO COMMAND-WORK.
           CALL "QCMDEXC" USING COMMAND-WORK, COMMAND-LEN.

           MOVE "DLTOVR FILE(MCFLCS3101)" TO COMMAND-WORK.
           CALL "QCMDEXC" USING COMMAND-WORK, COMMAND-LEN.

           MOVE "DLTOVR FILE(MCFLCS3603)" TO COMMAND-WORK.
           CALL "QCMDEXC" USING COMMAND-WORK, COMMAND-LEN.

           MOVE "DLTOVR FILE(MCFLCS1001)" TO COMMAND-WORK.
           CALL "QCMDEXC" USING COMMAND-WORK, COMMAND-LEN.

           MOVE "DLTOVR FILE(MCFLCS0901)" TO COMMAND-WORK.
           CALL "QCMDEXC" USING COMMAND-WORK, COMMAND-LEN.

           MOVE "DLTOVR FILE(MCFLCSUSAG)" TO COMMAND-WORK.
           CALL "QCMDEXC" USING COMMAND-WORK, COMMAND-LEN.

           MOVE "DLTOVR FILE(MCFLCS0501)" TO COMMAND-WORK.
           CALL "QCMDEXC" USING COMMAND-WORK, COMMAND-LEN.

           MOVE "DLTOVR FILE(MCFLCS1301)" TO COMMAND-WORK.
           CALL "QCMDEXC" USING COMMAND-WORK, COMMAND-LEN.
           PERFORM 9999-OPEN-STUFF.

       9190-RD-X.
           EXIT.

      *------ THIS VERSION OF CATREAD ASSUMES THE SET/MSG NUMBER
      *------ WILL BE IN CATREAD-MSG-NUMBER.
       999-CATREAD.
           CALL "CCATREAD" USING CATREAD-PARMS.
           MOVE CATREAD-MSG-TEXT TO MESSAGE-BUFFER.
           IF MESSAGE-BUFFER-1  = SPACES
               MOVE "* ERROR ON THIS FIELD *" TO MESSAGE-BUFFER.
       999-CATREAD-EXIT.
           EXIT.

      *----- COMMENTED OUT COPYLIB MEMBER BECAUSE ALL INDICATORS
      *----- ARE SET TO 0 AFTER THE SCREEN WRITE.  HOWEVER, IF THE
      *----- USER IS NOT AUTHORIZED TO COST & USAGE INFO., INDICATOR
      *----- 90 NEEDS TO BE ON FOR ALL SCREEN WRITES.
      *COPY SCRNCALL IN COPYLIB.

       9999-GETNEXTFORM.
       9999-PUTWINDOW.
       9999-INITFORM.
       9999-SHOWFORM.
       9999-SETKEYLABEL.
       998-WRITE-SCREEN.
           IF SRF-CURSOR-FLD > ZERO
               MOVE B"1" TO IND (SRF-CURSOR-FLD)
               MOVE ZERO TO SRF-CURSOR-FLD.
           IF COST-USAGE-SW = "N"
               MOVE B"1"                 TO  IND (90).
           IF SHOW-LIT-SW = "Y"
               MOVE B"1"                 TO  IND (91).
           IF SAP-PLANT-SW = "Y"
               MOVE B"1"                 TO  IND (80)
               IF VIEW-NFNAME = "FMTLSTAT2" OR VIEW-NFNAME = "FMTLSTAT4"
                   MOVE B"1"             TO  IND (90).
           WRITE DISPLAY-REC  FORMAT IS VIEW-NFNAME
               INDIC ARE SRF-INDICATORS.
           MOVE ALL B"0" TO SRF-INDICATORS.

       998-READ-SCREEN.
           READ  DISPLAY-FILE FORMAT IS VIEW-NFNAME
               INDIC ARE SRF-INDICATORS.
           ACCEPT IOFEEDBACK FROM I-O-FEEDBACK-AREA.
           MOVE ALL B"0" TO SRF-INDICATORS.

      *------ A BAD STATUS MAY MEAN USER TURNED OFF TERMINAL.
      *------ IF SO, SIMULATE THE F3 KEY TO EXIT PROGRAM.
           IF DISPLAY-STATUS NOT = "00"
               MOVE EXIT-PROGRAM TO VIEW-LASTKEY
           ELSE
               MOVE FUNCTION-NUM TO VIEW-LASTKEY.
           IF SRF-KEYSET = 1 OR 3 OR 5 OR 7
               MOVE "I" TO SRF-FKEY (7).
           IF SRF-KEYSET > 0
               MOVE "I" TO SRF-FKEY (5).
           IF SRF-KEYSET = 1 OR 2 OR 5 OR 6 OR 7 OR 8
               MOVE "I" TO SRF-FKEY (4).
           IF SRF-KEYSET = 5 OR 6
               MOVE "I" TO SRF-FKEY (8), SRF-FKEY (6)
           ELSE
           IF SRF-KEYSET = 7 OR 8
               MOVE "I" TO SRF-FKEY (1), SRF-FKEY (2), SRF-FKEY (8).
           MOVE SPACES TO MESSAGE-BUFFER-1.
           IF VIEW-LASTKEY = ENTER-KEY
               IF SRF-ENTER-FLAG = "I"
      *            "E28: 'ENTER' NOT VALID HERE"
                   MOVE 5 TO LANG-SETNUM
                   MOVE 28 TO LANG-MSGNUM
                   MOVE 05028 TO CATREAD-MSG-NUMBER
                   MOVE 1 TO SRF-ERROR-FLD
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               ELSE
                   NEXT SENTENCE
           ELSE
           IF SRF-FKEY (VIEW-LASTKEY) = "I"
      *        "I10: INVALID FUNCTION KEY"
               MOVE 9 TO LANG-SETNUM
               MOVE 10 TO LANG-MSGNUM
               MOVE 09010 TO CATREAD-MSG-NUMBER
               MOVE 1 TO SRF-ERROR-FLD
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
           IF MESSAGE-BUFFER-1 = SPACES
               MOVE SPACES TO SRF-FKEY-AREA, SRF-ENTER-FLAG.
       9989-WS-X.
           EXIT.

       9999-RESET-SCREEN.
           MOVE B"1" TO IND(97).
           MOVE B"1" TO IND(96).

       COPY SCRNCL1  IN COPYLIB.
       COPY SCRNCL2  IN COPYLIB.
       COPY SCRNCL3  IN COPYLIB.
       COPY SCRNCL4  IN COPYLIB.

      *COPY GKMSTCDI IN C O P Y D B C S.
       9999-GETKEY-MSTORERM-CD-I.
           MOVE 0 TO COND-WORD.
           MOVE CODE-ARG TO CORPCDE OF MSTORERM-CD-REC-I.
           READ MSTORERM-CD-I INTO BUF-MSTORERM
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS = "23"
               MOVE 17 TO COND-WORD
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD
               IF HANDLE-BLOWUP-FLAG = "Y"
                   MOVE "GETKEY ERR 9999-GETKEY-MSTORERM-CD-I"
                       TO BU-MSG-AREA
                   PERFORM 2100-BLOWUP.

      *COPY CHDMPCDI IN C O P Y D B C S.
       9999-CHAINHD-DMANPART-CD-I.
           MOVE 0 TO COND-WORD.
           MOVE CODE-ARG TO CORPCDE OF DMANPART-CD-REC-I.
           START DMANPART-CD-I KEY = CORPCDE OF DMANPART-CD-REC-I
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF (FILE-STATUS NOT = "00") AND (FILE-STATUS-1 NOT = "2")
               MOVE 99 TO COND-WORD
               IF HANDLE-BLOWUP-FLAG = "Y"
                   MOVE "CHAINHD ERR 9999-CHAINHD-DMANPART-CD-I"
                       TO BU-MSG-AREA
                   PERFORM 2100-BLOWUP.

      *COPY CHDDSCDI IN C O P Y D B C S.
       9999-CHAINHD-DDESC-CD-I.
           MOVE 0 TO COND-WORD.
           MOVE CODE-ARG TO CORPCDE OF DDESC-CD-REC-I.
           START DDESC-CD-I KEY = CORPCDE OF DDESC-CD-REC-I
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF (FILE-STATUS NOT = "00") AND (FILE-STATUS-1 NOT = "2")
               MOVE 99 TO COND-WORD
               IF HANDLE-BLOWUP-FLAG = "Y"
                   MOVE "CHAINHD ERR 9999-CHAINHD-DDESC-CD-I"
                       TO BU-MSG-AREA
                   PERFORM 2100-BLOWUP.

      *COPY CHDD2CDI IN C O P Y D B C S.
       9999-CHAINHD-DDESC2-CD-I.
           MOVE 0 TO COND-WORD.
           MOVE CODE-ARG TO CORPCDE OF DDESC2-CD-REC-I.
           START DDESC2-CD-I KEY = CORPCDE OF DDESC2-CD-REC-I
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF (FILE-STATUS NOT = "00") AND (FILE-STATUS-1 NOT = "2")
               MOVE 99 TO COND-WORD
               IF HANDLE-BLOWUP-FLAG = "Y"
                   MOVE "CHAINHD ERR 9999-CHAINHD-DDESC2-CD-I"
                       TO BU-MSG-AREA
                   PERFORM 2100-BLOWUP.

       9999-CHAINHD-DTECHBUL-I.
           MOVE 0 TO COND-WORD.
           MOVE CODE-ARG TO CORPCDE OF DTECHBUL-REC-I.
           START DTECHBUL-I KEY = CORPCDE OF DTECHBUL-REC-I
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF (FILE-STATUS NOT = "00") AND (FILE-STATUS-1 NOT = "2")
               MOVE 99 TO COND-WORD
               IF HANDLE-BLOWUP-FLAG = "Y"
                   MOVE "CHAINHD ERR 9999-CHAINHD-DTECHBUL-CD-I"
                       TO BU-MSG-AREA
                   PERFORM 2100-BLOWUP.

       9999-CHAINHD-DCOMPL-I.
           MOVE 0 TO COND-WORD.
           MOVE CODE-ARG TO CORPCDE OF DCOMPL-REC-I.
           START DCOMPL-I KEY = CORPCDE OF DCOMPL-REC-I
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF (FILE-STATUS NOT = "00") AND (FILE-STATUS-1 NOT = "2")
               MOVE 99 TO COND-WORD
               IF HANDLE-BLOWUP-FLAG = "Y"
                   MOVE "CHAINHD ERR 9999-CHAINHD-DCOMPL-CD-I"
                       TO BU-MSG-AREA
                   PERFORM 2100-BLOWUP.

      *COPY GKUSECDI IN C O P Y D B C S.
       9999-GETKEY-USAGEFIL-CD-I.
           MOVE 0 TO COND-WORD.
           MOVE CODE-ARG TO CORPCDE OF USAGEFIL-CD-REC-I.
           READ USAGEFIL-CD-I INTO BUF-USAGEFIL
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS = "23"
               MOVE 17 TO COND-WORD
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD.

       9999-GETKEY-RECEIPTFIL-CD-I.
           MOVE 0 TO COND-WORD.
           MOVE CODE-ARG TO CORPCDE OF RECEIPTFIL-CD-REC-I.
           READ RECEIPTFIL-CD-I INTO BUF-RECEIPTFIL
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS = "23"
               MOVE 17 TO COND-WORD
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD.

      *COPY GNDDSCDI IN C O P Y D B C S.
       9999-GETNEXT-DDESC-CD-I.
           MOVE 0 TO COND-WORD.
           READ DDESC-CD-I NEXT INTO BUF-DDESC
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   MOVE 15 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD
                   IF HANDLE-BLOWUP-FLAG = "Y"
                       MOVE "GETNEXT ERR 9999-GETNEXT-DDESC-CD-I"
                           TO BU-MSG-AREA
                       PERFORM 2100-BLOWUP
                   END-IF
           ELSE
           IF CORPCDE OF DDESC-CD-REC-I NOT = CODE-ARG
               MOVE 15 TO COND-WORD.

      *COPY GNDD2CDI IN C O P Y D B C S.
       9999-GETNEXT-DDESC2-CD-I.
           MOVE 0 TO COND-WORD.
           READ DDESC2-CD-I NEXT INTO BUF-DDESC2
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   MOVE 15 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD
                   IF HANDLE-BLOWUP-FLAG = "Y"
                       MOVE "GETNEXT ERR 9999-GETNEXT-DDESC2-CD-I"
                           TO BU-MSG-AREA
                       PERFORM 2100-BLOWUP
                   END-IF
           ELSE
           IF CORPCDE OF DDESC2-CD-REC-I NOT = CODE-ARG
               MOVE 15 TO COND-WORD.

      *COPY GNDMPCDI IN C O P Y D B C S.
       9999-GETNEXT-DMANPART-CD-I.
           MOVE 0 TO COND-WORD.
           READ DMANPART-CD-I NEXT INTO BUF-DMANPART
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   MOVE 15 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD
                   IF HANDLE-BLOWUP-FLAG = "Y"
                       MOVE "GETNEXT ERR 9999-GETNEXT-DMANPART-CD-I"
                           TO BU-MSG-AREA
                       PERFORM 2100-BLOWUP
                   END-IF
           ELSE
           IF CORPCDE OF DMANPART-CD-REC-I NOT = CODE-ARG
               MOVE 15 TO COND-WORD.

       9999-GETNEXT-DTECHBUL-I.
           MOVE 0 TO COND-WORD.
           READ DTECHBUL-I NEXT INTO BUF-DTECHBUL
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   MOVE 15 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD
                   IF HANDLE-BLOWUP-FLAG = "Y"
                       MOVE "GETNEXT ERR 9999-GETNEXT-DTECHBUL-I"
                           TO BU-MSG-AREA
                       PERFORM 2100-BLOWUP
                   END-IF
           ELSE
           IF CORPCDE OF DTECHBUL-REC-I NOT = CODE-ARG
               MOVE 15 TO COND-WORD.

       9999-GETNEXT-DCOMPL-I.
           MOVE 0 TO COND-WORD.
           READ DCOMPL-I NEXT INTO BUF-DCOMPL
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   MOVE 15 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD
                   IF HANDLE-BLOWUP-FLAG = "Y"
                       MOVE "GETNEXT ERR 9999-GETNEXT-DCOMPL-I"
                           TO BU-MSG-AREA
                       PERFORM 2100-BLOWUP
                   END-IF
           ELSE
           IF CORPCDE OF DCOMPL-REC-I NOT = CODE-ARG
               MOVE 15 TO COND-WORD.

       9999-GET-MPERSONEL-I.
           MOVE STR-LAST-EMPL        TO  EMPL-ARG.
           MOVE EMPL-ARG TO PERCCNUM OF PERSONNEL-REC-I.
           READ PERSONNEL-I INTO BUF-PER-PERSONNEL
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS = "00"
               MOVE PER-EMP-NAME     TO  DISP-LAST-EMPL-NAME
           ELSE
               MOVE SPACES           TO  DISP-LAST-EMPL-NAME.


DCR01 *****************************************************************
DCR01 ** READ BY KEY ARIBA CATALOG FILE
DCR01 *****************************************************************
DCR01  9999-READK-ARIBA-CATALOG.

DCR01      SET ARIBA-BUYER-ITEM-NO   TO TRUE.
DCR02      IF  ARIBA-ENABLED-NO
DCR02          GO TO 9999-READK-EXIT
DCR02      END-IF.


DCR01      INITIALIZE  ARIBA-CATALOG-REC.
DCR01      MOVE  WS-ARIBA-CORPCODE  TO ARIBACAT-CORP-CODE.

DCR01      READ  ARIBA-CATALOG-FILE
DCR01      END-READ.

DCR01      IF  FILE-STATUS = "00"
DCR01          SET   ARIBA-BUYER-ITEM-YES  TO TRUE
DCR01      END-IF.

DCR01  9999-READK-EXIT.
DCR01      EXIT.
DCR01 *****************************************************************

       9999-OPEN-STUFF.
      *COPY OPMSTCDI IN  C O P Y D B C S.
           OPEN INPUT MSTORERM-CD-I.
      *COPY OPDDSCDI IN  C O P Y D B C S.
           OPEN INPUT DDESC-CD-I.
      *COPY OPDD2CDI IN  C O P Y D B C S.
           OPEN INPUT DDESC2-CD-I.
      *COPY OPUSECDI IN  C O P Y D B C S.
           OPEN INPUT USAGEFIL-CD-I.
      *COPY OPDMPCDI IN  C O P Y D B C S.

DCR02      IF  ARIBA-ENABLED-YES
DCR02          OPEN INPUT ARIBA-CATALOG-FILE
DCR02      END-IF.

           OPEN INPUT DMANPART-CD-I.
           OPEN INPUT DPORECD-I.
           OPEN INPUT DPORECD-I-H.
           OPEN INPUT RECEIPTFIL-CD-I.
           OPEN INPUT PERSONNEL-I.
           OPEN INPUT DTECHBUL-I.
           IF FILE-STATUS NOT = "00"
               MOVE "N" TO DTECHBUL-SW
           ELSE
               MOVE "Y" TO DTECHBUL-SW.
           OPEN INPUT DCOMPL-I.
           IF FILE-STATUS NOT = "00"
               MOVE "N" TO DCOMPL-SW
           ELSE
               MOVE "Y" TO DCOMPL-SW.
           OPEN INPUT MPLTINFO-I.
      *COPY OPDISPL  IN  C O P Y C S I S.
           OPEN I-O DISPLAY-FILE.
      *COPY OPSTORES IN  C O P Y D B C S.
      *------ DUMMY ENTRY FOR STORES DATABASE OPEN

       9999-CLOSE-STUFF.
      *COPY CLMSTCDI IN  C O P Y D B C S.
           CLOSE MSTORERM-CD-I.
      *COPY CLDDSCDI IN  C O P Y D B C S.
           CLOSE DDESC-CD-I.
      *COPY CLDD2CDI IN  C O P Y D B C S.
           CLOSE DDESC2-CD-I.
      *COPY CLUSECDI IN  C O P Y D B C S.
           CLOSE USAGEFIL-CD-I.
      *COPY CLDMPCDI IN  C O P Y D B C S.
           CLOSE DMANPART-CD-I.
           CLOSE DPORECD-I.
           CLOSE DPORECD-I-H.
           CLOSE RECEIPTFIL-CD-I.
           CLOSE PERSONNEL-I.

DCR02      IF  ARIBA-ENABLED-YES
DCR02          CLOSE ARIBA-CATALOG-FILE
DCR02      END-IF.

           CLOSE DISPLAY-FILE.
           IF DTECHBUL-SW = "Y"
               CLOSE DTECHBUL-I.
           IF DCOMPL-SW = "Y"
               CLOSE DCOMPL-I.
           CLOSE MPLTINFO-I.
      *COPY CLSTORES IN  C O P Y D B C S.
      *------ DUMMY ENTRY FOR STORES DATABASE CLOSE

DCR02  COPY ZMPLTSUBR  IN COPYLIB.
