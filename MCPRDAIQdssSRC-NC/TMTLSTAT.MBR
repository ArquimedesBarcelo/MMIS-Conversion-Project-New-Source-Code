      ****************************************************************
      **                                                          **
      **   THIS MATERIAL STATUS INQUIRY INCLUDES 5 SCREENS:       **
      **                                                          **
      ** DE-FIELDS-1. CORP CODE ENTRY SCREEN.  HERE THE CORPORATE **
      **              CODE TO BE INQUIRED UPON IS ENTERED AND     **
      **              CHECKED FOR VALIDITY.                       **
      **                                                          **
      ** DE-FIELDS-2. BASIC INQUIRY SCREEN.  BASIC DATA A CRAFTS- **
      **              MAN WOULD NEED ABOUT A STOREROOM ITEM.      **
      **                                                          **
      ** DE-FIELDS-3. MORE INQUIRY FIELDS.  EXTRA INQUIRY INFO    **
      **              THAT MIGHT BE NEEDED BY PURCHASING OR MATL  **
      **              CONTROL.                                    **
      **                                                          **
      ** DE-FIELDS-4. MORE DESCRIPTION SCREEN.  LETS THE USER SEE **
      **              ALL LINES OF DESCRIPTION (FOR CODES WITH 4  **
      **              OR MORE LINES OF DESCRIPTION).  THIS SCREEN **
      **              INCLUDES A ROLL-UP FEATURE.  FOLLOWING      **
      **              ALL OF THE PRIMARY LANGUAGE DESCRIPTION     **
      **              FOUND IN DDESC, THE 2ND LANGUAGE DESCRIPTION**
      **              FROM DDESC2 IS DISPLAYED, WHICH IS THEN     **
      **              FOLLOWED BY THE MFR DATA FROM DMANPART.     **
      **                   SCREEN-4A  TOP PART OF DESC SCREEN.    **
      **                   SCREEN-4B  BOTTOM PART OF DESC SCREEN. **
      **                                                          **
      **   FBLKINQ.  THE REQUIREMENT ORDER INQUIRY SCREEN IS      **
      **             BROUGHT UP THROUGH A SUB ROUTINE 'TBLKINQ'   **
      **                                                          **
      **   RESERVATIONS.  THE RESERVATION INQUIRY SCREEN IS CALLED**
      **                  FROM THE SUBPROGRAM TRSRVINQ.SOURCE.    **
      **                                                          **
      **************************************************************

       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.
       SOURCE-COMPUTER.  HP-3000.
       OBJECT-COMPUTER.  HP-3000.
       COPY SPECIALN IN COPYLIB.

       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
      *COPY SLMSTCDI IN C O P Y D B C S.
           SELECT MSTORERM-CD-I
               ASSIGN TO DATABASE-MCFLCS0201
               ORGANIZATION IS INDEXED
                 ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
               FILE STATUS IS FILE-STATUS.

      *COPY SLDDSCDI IN C O P Y D B C S.
           SELECT DDESC-CD-I
               ASSIGN TO DATABASE-MCFLCS1401
               ORGANIZATION IS INDEXED
                 ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                 WITH DUPLICATES
               FILE STATUS IS FILE-STATUS.

      *COPY SLDD2CDI IN C O P Y D B C S.
           SELECT DDESC2-CD-I
               ASSIGN TO DATABASE-MCFLCS3101
               ORGANIZATION IS INDEXED
                 ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                 WITH DUPLICATES
               FILE STATUS IS FILE-STATUS.

      *COPY SLUSECDI IN C O P Y D B C S.
           SELECT USAGEFIL-CD-I
               ASSIGN TO DATABASE-MCFLCSUSAG
               ORGANIZATION IS INDEXED
                 ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
               FILE STATUS IS FILE-STATUS.

      *COPY SLDMPCDI IN C O P Y D B C S.
           SELECT DMANPART-CD-I
               ASSIGN TO DATABASE-MCFLCS3603
               ORGANIZATION IS INDEXED
                 ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                 WITH DUPLICATES
               FILE STATUS IS FILE-STATUS.

           SELECT DPORECD-I
               ASSIGN TO DATABASE-MCFLCS0901
               ORGANIZATION IS INDEXED
                 ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                 WITH DUPLICATES
               FILE STATUS IS FILE-STATUS.

           SELECT DPORECD-I-H
               ASSIGN TO DATABASE-MCFLST0301
               ORGANIZATION IS INDEXED
                 ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                 WITH DUPLICATES
               FILE STATUS IS FILE-STATUS.

           SELECT RECEIPTFIL-CD-I
               ASSIGN TO DATABASE-MCFLCSRCPT
               ORGANIZATION IS INDEXED
                 ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
               FILE STATUS IS FILE-STATUS.

           SELECT PERSONNEL-I
               ASSIGN TO DATABASE-MCFLMM0301
               ORGANIZATION IS INDEXED
                 ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
               FILE STATUS IS FILE-STATUS.

           SELECT DTECHBUL-I
               ASSIGN         TO DATABASE-MCFLCS6901
               ORGANIZATION   IS INDEXED
               ACCESS MODE    IS DYNAMIC
               RECORD KEY     IS EXTERNALLY-DESCRIBED-KEY
                 WITH DUPLICATES
               FILE STATUS    IS FILE-STATUS.

           SELECT DCOMPL-I
               ASSIGN         TO DATABASE-MCFLCS7001
               ORGANIZATION   IS INDEXED
               ACCESS MODE    IS DYNAMIC
               RECORD KEY     IS EXTERNALLY-DESCRIBED-KEY
                 WITH DUPLICATES
               FILE STATUS    IS FILE-STATUS.

DCR01      SELECT ARIBA-CATALOG-FILE
DCR01             ASSIGN TO DATABASE-MCFLAB2004
DCR01             ORGANIZATION   IS INDEXED
DCR01             ACCESS MODE    IS DYNAMIC
DCR01             RECORD KEY     IS EXTERNALLY-DESCRIBED-KEY
DCR01             WITH DUPLICATES
DCR01             FILE STATUS    IS FILE-STATUS.

           SELECT MPLTINFO-I
               ASSIGN TO DATABASE-MCFLCS0501
               ORGANIZATION IS INDEXED
                 ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
               FILE STATUS IS FILE-STATUS.

           SELECT DISPLAY-FILE
DCR03          ASSIGN TO WORKSTATION-ZTMTLSTAT-SI
               ORGANIZATION IS TRANSACTION
               ACCESS IS SEQUENTIAL
               FILE STATUS IS DISPLAY-STATUS
               CONTROL-AREA IS WS-CONTROL.

           SELECT PLANT-FILE ASSIGN TO DISK-MCPLTCODES.

       DATA DIVISION.
       FILE SECTION.
       COPY PLTCODES IN COPYLIB.
       FD  MSTORERM-CD-I
           LABEL RECORDS ARE STANDARD.
       01  MSTORERM-CD-REC-I.
           COPY DDS-MCRPCS0200  OF MCFLCS0201.

       FD  USAGEFIL-CD-I
           LABEL RECORDS ARE STANDARD.
       01  USAGEFIL-CD-REC-I.
           COPY DDS-MCRPCSUSAG  OF MCFLCSUSAG.

       FD  DDESC-CD-I
           LABEL RECORDS ARE STANDARD.
       01  DDESC-CD-REC-I.
           COPY DDS-MCRPCS1400  OF MCFLCS1401.

       FD  DDESC2-CD-I
           LABEL RECORDS ARE STANDARD.
       01  DDESC2-CD-REC-I.
           COPY DDS-MCRPCS3100  OF MCFLCS3101.

       FD  DMANPART-CD-I
           LABEL RECORDS ARE STANDARD.
       01  DMANPART-CD-REC-I.
           COPY DDS-MCRPCS3600  OF MCFLCS3603.

       FD  DPORECD-I
           LABEL RECORDS ARE STANDARD.
       01  DPORECD-REC-I.
           COPY DDS-ALL-FORMATS OF MCFLCS0901.

       FD  DPORECD-I-H
           LABEL RECORDS ARE STANDARD.
       01  DPORECD-REC-I-H.
           COPY DDS-ALL-FORMATS OF MCFLST0301.

       FD  RECEIPTFIL-CD-I
           LABEL RECORDS ARE STANDARD.
       01  RECEIPTFIL-CD-REC-I.
           COPY DDS-MCRPCSRCPT  OF MCFLCSRCPT.

       FD  PERSONNEL-I
           LABEL RECORDS ARE STANDARD.
       01  PERSONNEL-REC-I.
           COPY DDS-ALL-FORMATS  OF MCFLMM0301.

DCR01  FD  ARIBA-CATALOG-FILE
DCR01      LABEL RECORDS ARE STANDARD.
DCR01  01  ARIBA-CATALOG-REC.
DCR01      COPY DDS-ALL-FORMATS  OF MCFLAB2004.
DCR01      COPY DARIBACAT  IN COPYLIB.

       FD  MPLTINFO-I
           LABEL RECORDS ARE STANDARD.
       01  MPLTINFO-REC-I.
           COPY DDS-MCRPCS0500  OF MCFLCS0501.

       FD  DTECHBUL-I
           LABEL RECORDS ARE STANDARD.
       01  DTECHBUL-REC-I.
           COPY DDS-MCRPCS6900  OF MCFLCS6901.

       FD  DCOMPL-I
           LABEL RECORDS ARE STANDARD.
       01  DCOMPL-REC-I.
           COPY DDS-MCRPCS7000  OF MCFLCS7001.

       FD  DISPLAY-FILE
           LABEL RECORDS ARE OMITTED.
       01  DISPLAY-REC                   PIC X(2000).

       WORKING-STORAGE SECTION.

       77  HANDLE-BLOWUP-FLAG            PIC X(1)  VALUE "Y".
       77  EOF-FLAG                      PIC X(1).
       77  PASSWORD                      PIC X(8)  VALUE "JADE;   ".
       77  INV-CYCLE-9                   PIC 9999.
       77  DLVTIME-9                     PIC 9999.
       77  SUB                           PIC 99.
       77  DESC-SUB                      PIC 99  VALUE ZEROS.
