017300     02  EOS-SW                  PIC 9.
017400 01  WO-BASIC-DATA.       COPY DWOBASIC OF COPYLIB.
017500 PROCEDURE DIVISION USING VIEW-COMAREA DBPARAMETERS
017600                     STATUS-AREA WO-NUMBER-WORK USER-INPUT
017700                     TSCALUPD-DATA WO-BASIC-DATA.
017800 START-PROCESSING.
017900     PERFORM 1-HSK.
018000     PERFORM 6-MAIN.
018100 2-EOJ.
           CLOSE LABOR-CURR-STAT-FILE.
           CLOSE LABOR-CURR-STAT-FIL2.
018200     GOBACK.
018300 1-HSK.
           OPEN I-O   LABOR-CURR-STAT-FILE.
           OPEN I-O   LABOR-CURR-STAT-FIL2.
018400     MOVE VIEW-APPLIC-AREA TO PLANT-IDEN.
018500     ACCEPT CUR-DATE-WA FROM DATE.
018600     MOVE CUR-DATE-YY TO COMPARE-YY.
018700     MOVE CUR-DATE-MM TO COMPARE-MM.
018800     MOVE CUR-DATE-DD TO COMPARE-DD.
      *------- 01/04/2010:  UPDATED WORKORDER LETTER SUFFIX LOGIC.
018900     IF WO-NUM-WORK-7 = "B" OR "F" OR "K" OR
                              "N" OR "T" OR "Y"
019000         MOVE 366 TO JUL-DAYS-LYR
019100     ELSE
019200     MOVE 365 TO JUL-DAYS-LYR.
019300**************************************************************
019400*    THE FOLLOWING CHECK WAS INCORPORATED 4-16-85 TO ASSURE  *
019500*    THAT A W/O BEING CW'D BY A CLOCK CARD THAT HAD NEVER    *
019600*    IP'D THE W/O WOULD PROMPT THE COORDINATOR FOR A START   *
019700*    TIME FOR THE CLOCK CARD                                 *
019800**************************************************************
019900     IF USER-IP-DATE = "DEPRES"
020000         MOVE SPACES TO MESSAGE-LINE.
020100 6-MAIN.
020200     PERFORM 614-UPDATE-CURR-LABOR THRU 614-UCL-EXIT.
020300 614-UPDATE-CURR-LABOR.
           MOVE 0 TO COND-WORD.
020600     IF STATUS-IN-1-2 = "IP"
020700         MOVE CRAFTSMAN-NO TO CRAFTSMAN-NO-WORK
020800         GO TO 614-ADD-NEW-REC.
021000     MOVE WO-NUMBER-WORK TO WONUM OF LCSFREC.
021100     MOVE CRAFTSMAN-NO TO CRAFTSMAN-NO-WORK.
021200     MOVE "Y" TO OO-CW-SW.
021300     MOVE 0 TO EMP-FLAG TWO-CRAFT-FLAG.
021400     IF CRAFTSMAN-NO-2 NOT = SPACES
021500         MOVE 1 TO TWO-CRAFT-FLAG.
021600     IF CRAFTSMAN-NO-2 = CRAFTSMAN-NO
021700         MOVE 0 TO TWO-CRAFT-FLAG.
           START LABOR-CURR-STAT-FILE KEY IS = EXTERNALLY-DESCRIBED-KEY
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF LCSF-STATUS NOT = "00" MOVE 17 TO COND-WORD.
022000     IF COND-WORD = 0
022100         NEXT SENTENCE
022200     ELSE
022300     GO TO 614-ADD-NEW-REC-CONT.
022400 614-LOOP-CHECK-WO.
022500     READ LABOR-CURR-STAT-FILE NEXT INTO CURR-LABOR-STAT-BUFF
022600         AT END    MOVE 15 TO COND-WORD.
           IF LCSF-STATUS NOT = "00" MOVE 15 TO COND-WORD.
           IF WONUM OF LCSFREC NOT = WO-NUMBER-WORK
                MOVE 15 TO COND-WORD.
022700     IF COND-WORD = 0
022800         NEXT SENTENCE
022900     ELSE
023000     IF COND-WORD = 15 AND STATUS-IN-1-2 = "CW" OR "LV"
023100         IF EMP-FLAG = 1
023200             GO TO 614-ADD-NEW-REC-CONT
023300         ELSE
023400         MOVE "Y" TO OO-CW-SW
023500         GO TO 614-ADD-NEW-REC-CONT
023600     ELSE
023700     IF COND-WORD = 15
023800         GO TO 614-UNLOCK-DB
023900     ELSE
024000     GO TO 614-ADD-NEW-REC-CONT.
024100     IF CRAFTSMAN-NO = EMP-NO
024200         MOVE 1 TO EMP-FLAG
024300         MOVE "N" TO OO-CW-SW
024400     ELSE
024500     IF CRAFTSMAN-NO-2 = EMP-NO
024600         MOVE 1 TO EMP-FLAG
024700         MOVE "N" TO OO-CW-SW
024800     ELSE
024900     IF STATUS-IN-1-2 = "VO" OR "HA" OR "HL" OR
025000                        "HM" OR "HS" OR "CW"
025100         MOVE "N" TO OO-CW-SW
025200     ELSE
025300     GO TO 614-LOOP-CHECK-WO.
025400     MOVE CALL-DATE-MM TO C-COMPL-MM.
025500     MOVE CALL-DATE-DD TO C-COMPL-DD.
025600     MOVE CALL-DATE-YY TO C-COMPL-YY.
           IF C-COMPL-YY > "70"
               MOVE "19" TO C-COMPL-CC
           ELSE
               MOVE "20" TO C-COMPL-CC.
025700     MOVE CALL-TIME TO C-COMPL-TIME.
           MOVE 0 TO COND-WORD.
           REWRITE LCSFREC FROM CURR-LABOR-STAT-BUFF
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF LCSF-STATUS NOT = "00" MOVE 17 TO COND-WORD.
026000     PERFORM 6140-SAVE-LABOR-RECORDS THRU 6140-SLR-EXIT.
026100     DELETE LABOR-CURR-STAT-FILE RECORD.
026200     GO TO 614-LOOP-CHECK-WO.
026300**************************************************************
026400*    THE PARAGRAPHS 614-ADD-NEW-REC THRU 614-UNLOCK-DB      **
026500*    MAKE SURE THAT A CRAFTSMAN CAN ONLY BE SIGNED ONTO     **
026600*    ONE WORK ORDER AT A TIME                               **
026700**************************************************************
026800 614-ADD-NEW-REC.
           MOVE 0 TO COND-WORD.
           MOVE CRAFTSMAN-NO TO PERCCNUM OF LCSFREC.
           START LABOR-CURR-STAT-FIL2 KEY IS = EXTERNALLY-DESCRIBED-KEY
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF LCSF2-STATUS NOT = "00" MOVE 17 TO COND-WORD.
027200     IF COND-WORD NOT = 0 GO TO 614-ADD-NEW-REC-CONT.
027300 614-LOOP-CHECK-CC.
027400     READ LABOR-CURR-STAT-FIL2 NEXT INTO CURR-LABOR-STAT-BUFF
027500         AT END    MOVE 15 TO COND-WORD.
           IF LCSF2-STATUS NOT = "00" MOVE 15 TO COND-WORD.
027600     IF COND-WORD = 15 GO TO 614-ADD-NEW-REC-CONT.
027700     MOVE CALL-DATE-MM TO C-COMPL-MM.
027800     MOVE CALL-DATE-DD TO C-COMPL-DD.
027900     MOVE CALL-DATE-YY TO C-COMPL-YY.
           IF C-COMPL-YY > "70"
               MOVE "19" TO C-COMPL-CC
           ELSE
               MOVE "20" TO C-COMPL-CC.
028000     MOVE CALL-TIME    TO C-COMPL-TIME.
           MOVE 0 TO COND-WORD.
           REWRITE LCSF2REC FROM CURR-LABOR-STAT-BUFF
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF LCSF2-STATUS NOT = "00" MOVE 17 TO COND-WORD.
028300     MOVE CRAFTSMAN-NO-WORK TO CC-NO.
028400     MOVE WO-NO-CLS TO WO-NO.
028900     PERFORM 6140-SAVE-LABOR-RECORDS THRU 6140-SLR-EXIT.
029000     DELETE LABOR-CURR-STAT-FILE RECORD.
029100     GO TO 614-LOOP-CHECK-CC.
029200 614-ADD-NEW-REC-CONT.
029300     MOVE WO-NUMBER-WORK TO WO-NO-CLS.
029400     MOVE CRAFTSMAN-NO-WORK TO EMP-NO.
029500     IF STATUS-IN-1-2 = "LV" OR "CW"
029600         IF OO-CW-SW = "N"
029700             GO TO 614-UNLOCK-DB
029800         ELSE
029900         IF USER-IP-DATE = "      "
030000             MOVE "FSUPUPD2" TO SCREEN-NAME
030800             MOVE CRAFTSMAN-NO-WORK TO CLK-CD
030900             MOVE WO-NUMBER-WORK TO WRK-NO
031000             MOVE TRUE-VAL TO IND (33) IND (99)
031500             CALL "TSCREEN" USING SCREEN-PARMS
                   IF SCREEN-STATUS NOT = "00"
                       GO TO 2-EOJ
                   ELSE
031600             IF VIEW-LASTKEY = 3
031700                 MOVE CRAFTSMAN-NO-WORK TO CRAFTSMAN-NO
031800                 GO TO 614-UNLOCK-DB
                   MOVE SCREEN-BUFFER TO USER-INPUT
032200             PERFORM 6141-CHECK-DATE-INPUT THRU
032300                   6141-CDI-EXIT
032400             IF DATE-ERROR = 1
032500                 MOVE 0 TO DATE-ERROR
032600                 MOVE SPACES TO USER-IP-DATE
032700                 GO TO 614-ADD-NEW-REC-CONT
032800             ELSE
032900             MOVE UID-MM TO C-START-MM
033000             MOVE UID-DD TO C-START-DD
033100             MOVE UID-YY TO C-START-YY
                   IF C-START-YY > "70"
                      MOVE "19" TO C-START-CC
                   ELSE
                      MOVE "20" TO C-START-CC
                   END-IF
033200             MOVE USER-IP-TIME TO C-START-TIME
033300             MOVE CALL-DATE-MM TO C-COMPL-MM
033400             MOVE CALL-DATE-DD TO C-COMPL-DD
033500             MOVE CALL-DATE-YY TO C-COMPL-YY
                   IF C-COMPL-YY > "70"
                     MOVE "19" TO C-COMPL-CC
                   ELSE
                     MOVE "20" TO C-COMPL-CC
                   END-IF
033600             MOVE CALL-TIME    TO C-COMPL-TIME
033700             PERFORM 6140-SAVE-LABOR-RECORDS THRU 6140-SLR-EXIT
033800             PERFORM 6142-CHECK-TEMPFILE-4-CC THRU 6142-CT4C-EXIT
033900             IF TWO-CRAFT-FLAG = 0
034000                 GO TO 614-UNLOCK-DB
034100             ELSE
034200             MOVE CRAFTSMAN-NO-2 TO CRAFTSMAN-NO-WORK
034300             MOVE 0 TO TWO-CRAFT-FLAG
034400             GO TO 614-ADD-NEW-REC-CONT
034500         ELSE
034600         MOVE UID-MM        TO C-START-MM
034700         MOVE UID-DD        TO C-START-DD
034800         MOVE UID-YY        TO C-START-YY
               IF C-START-YY > "70"
                  MOVE "19" TO C-START-CC
               ELSE
                  MOVE "20" TO C-START-CC
               END-IF
034900         MOVE USER-IP-TIME  TO C-START-TIME
035000         MOVE CALL-DATE-MM  TO C-COMPL-MM
035100         MOVE CALL-DATE-DD  TO C-COMPL-DD
035200         MOVE CALL-DATE-YY  TO C-COMPL-YY
               IF C-COMPL-YY > "70"
                  MOVE "19" TO C-COMPL-CC
               ELSE
                  MOVE "20" TO C-COMPL-CC
               END-IF
035300         MOVE CALL-TIME     TO C-COMPL-TIME
035400         PERFORM 6140-SAVE-LABOR-RECORDS THRU 6140-SLR-EXIT
035500         PERFORM 6142-CHECK-TEMPFILE-4-CC THRU 6142-CT4C-EXIT
035600         IF TWO-CRAFT-FLAG = 0
035700             GO TO 614-UNLOCK-DB
035800         ELSE
035900         MOVE CRAFTSMAN-NO-2 TO CRAFTSMAN-NO-WORK
036000         MOVE 0 TO TWO-CRAFT-FLAG
036100         GO TO 614-ADD-NEW-REC-CONT
036200     ELSE
036300     MOVE CALL-DATE-MM TO C-START-MM
036400     MOVE CALL-DATE-DD TO C-START-DD
036500     MOVE CALL-DATE-YY TO C-START-YY
           IF C-START-YY > "70"
              MOVE "19" TO C-START-CC
           ELSE
              MOVE "20" TO C-START-CC
           END-IF
036600     MOVE CALL-TIME TO C-START-TIME
036700     MOVE SPACES TO C-COMPL-DATE-CN C-COMPL-TIME.
           MOVE 0 TO COND-WORD.
           WRITE LCSFREC FROM CURR-LABOR-STAT-BUFF
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF LCSF-STATUS NOT = "00" MOVE 17 TO COND-WORD.
037000     IF COND-WORD = 17
037100         MOVE SPACES TO BUFFER
037200         MOVE "UNABLE TO ADD NEW LABOR STATS" TO BUFFER
037300         MOVE TRUE-VAL TO IND (99).
037600     IF CRAFTSMAN-NO-2 = "    " OR CRAFTSMAN-NO-WORK
037700         NEXT SENTENCE
037800     ELSE
037900     MOVE CRAFTSMAN-NO-2 TO CRAFTSMAN-NO-WORK
038000     GO TO 614-ADD-NEW-REC.
038100 614-UNLOCK-DB.
038200     MOVE SPACES TO USER-IP-DATE USER-IP-TIME.
038400 614-UCL-EXIT.    EXIT.
038500 6141-CHECK-DATE-INPUT.
038600     IF SPACES = UID-MM OR UID-DD OR UID-YY OR USER-IP-TIME
038700         MOVE "MUST INPUT START DATE AND TIME - TRY AGAIN@@@"
038800                  TO BUFFER
038900         MOVE TRUE-VAL TO IND (99)
039200         MOVE 1 TO DATE-ERROR
039300         GO TO 6141-CDI-EXIT.
039400     IF USER-IP-DATE IS NOT NUMERIC OR USER-IP-TIME IS NOT NUMERIC
039500         MOVE "INVALID START DATE OR TIME - TRY AGAIN@@@"
039600              TO BUFFER
039700         MOVE TRUE-VAL TO IND (99)
040000         MOVE 1 TO DATE-ERROR
040100         GO TO 6141-CDI-EXIT.
040200     MOVE UID-YY TO IP-COMP-YY.
040300     MOVE UID-MM TO IP-COMP-MM.
040400     MOVE UID-DD TO IP-COMP-DD.
040500     MOVE USER-IP-TIME TO IP-COMP-TIME.
040600     ACCEPT CUR-TIME-COMPARE FROM TIME.
040700     IF UID-MM > "00" AND < "13"
040800         IF UID-DD > "00" AND < "32"
040900             IF UID-YY IS NUMERIC
041000                 IF USER-IP-TIME > "    " AND < "2400"
041100                     IF USER-IP-COMPARE < DATE-TIME-RECD
041200                         MOVE "DATE OR TIME ENTERED LESS THAN DATE
041300-                        " OR TIME W/O RECEIVED - TRY AGAIN@@@"
041400                                TO BUFFER
041500                         MOVE TRUE-VAL TO IND (99)
041900                         MOVE 1 TO DATE-ERROR
042000                         GO TO 6141-CDI-EXIT
042100                     ELSE
042200                     IF IP-COMP-DATE > CUR-DATE-COMPARE
042300                         MOVE "DATE ENTERED GREATER THAN CURRENT D
042400-                        "ATE - TRY AGAIN@@@@"
042500                                TO BUFFER
042600                         MOVE TRUE-VAL TO IND (99)
043000                         MOVE 1 TO DATE-ERROR
043100                         GO TO 6141-CDI-EXIT
043200                     ELSE
043300                     IF IP-COMP-DATE = CUR-DATE-COMPARE AND
043400                        IP-COMP-TIME > COMPARE-TIME
043500                         MOVE "TIME ENTERED GREATER THAN CURRENT T
043600-                        "IME - TRY AGAIN@@@@"
043700                                TO BUFFER
043800                         MOVE TRUE-VAL TO IND (99)
044200                         MOVE 1 TO DATE-ERROR
044300                         GO TO 6141-CDI-EXIT
044400                     ELSE
044500                     NEXT SENTENCE
044600                 ELSE
044700                 MOVE "INVALID START TIME ENTERED - TRY AGAIN@@"
044800                     TO BUFFER
044900                 MOVE TRUE-VAL TO IND (99)
045300                 MOVE 1 TO DATE-ERROR
045400                 GO TO 6141-CDI-EXIT
045500             ELSE
045600             MOVE "INVALID YEAR ENTERED - TRY AGAIN@@@"
045700                   TO BUFFER
045800             MOVE TRUE-VAL TO IND (99)
046200             MOVE 1 TO DATE-ERROR
046300             GO TO 6141-CDI-EXIT
046400         ELSE
046500         MOVE "INVALID DAY ENTERED - TRY AGAIN@@@@"
046600                TO BUFFER
046700         MOVE TRUE-VAL TO IND (99)
047000         MOVE 1 TO DATE-ERROR
047100         GO TO 6141-CDI-EXIT
047200     ELSE
047300     MOVE "INVALID MONTH ENTERED - TRY AGAIN@@@@"
047400           TO BUFFER
047500     MOVE TRUE-VAL TO IND (99)
047800     MOVE 1 TO DATE-ERROR
047900     GO TO 6141-CDI-EXIT.
048000 6141-CDI-EXIT.    EXIT.
048100 6140-SAVE-LABOR-RECORDS.
048200     MOVE 0 TO JUL-DAY-SAVE.
           MOVE C-COMPL-DATE-CN   TO GREGDATE.
           MOVE SPACES TO JULDATE.
           CALL "JULGREG" USING GREGDATE JULDATE DAYDIGIT LEAPYEAR.
           MOVE JULDATE           TO JUL-DAY-COMP.
048900     ACCEPT TIME-BUFF FROM TIME.
049000     IF C-START-TIME = SPACES
049100         IF TIME-HM > "0659" AND < "1500"
049200             MOVE "0700" TO C-START-TIME
049300         ELSE
049400         IF TIME-HM > "1459" AND < "2300"
049500             MOVE "1500" TO C-START-TIME
049600         ELSE
049700         MOVE "2300" TO C-START-TIME.
049800     IF C-START-DATE-CN = SPACES OR ZEROES
049900         MOVE CUR-DATE-WA TO GREGDATE-YMD
               IF GREGDATE-YY > "70"
                   MOVE "19" TO GREGDATE-CC
               ELSE
                   MOVE "20" TO GREGDATE-CC
               END-IF
               MOVE SPACES TO JULDATE
               CALL "JULGREG" USING GREGDATE JULDATE DAYDIGIT LEAPYEAR
050400         MOVE JULDATE TO JUL-DAY-STRT
050500         IF C-START-TIME = "2300"
050600             SUBTRACT 1 FROM JUL-DAY-STRT
050700             MOVE JUL-DAY-STRT TO JULDATE
                   MOVE SPACES TO GREGDATE
                   CALL "JULGREG" USING GREGDATE JULDATE DAYDIGIT
                                        LEAPYEAR
                   MOVE GREGDATE TO C-START-DATE-CN
051400         ELSE
                   MOVE GREGDATE TO C-START-DATE-CN
051900     ELSE
              MOVE C-START-DATE-CN TO GREGDATE
              MOVE SPACES TO JULDATE
              CALL "JULGREG" USING GREGDATE JULDATE DAYDIGIT LEAPYEAR
052600        MOVE JULDATE           TO JUL-DAY-STRT.
052700     IF JUL-DAY-COMP < JUL-DAY-STRT
052800         MOVE JUL-DAY-STRT TO JUL-DAY-COMP
               MOVE C-START-DATE-CN TO C-COMPL-DATE-CN
053200         IF C-COMPL-TIME < C-START-TIME
053300             IF C-COMPL-TIME > "0000" AND < "0701"
053400                 IF C-START-TIME > "2245" AND < "2400"
053500                     ADD 1 TO JUL-DAY-COMP
053600                     MOVE JUL-DAY-COMP TO JULDATE
                           MOVE SPACES TO GREGDATE
                           CALL "JULGREG" USING GREGDATE JULDATE
                                                DAYDIGIT LEAPYEAR
                           MOVE GREGDATE TO C-COMPL-DATE-CN
054300                 ELSE
054400                 MOVE TIME-HM TO C-COMPL-TIME
054500             ELSE
054600             NEXT SENTENCE
054700         ELSE
054800         NEXT SENTENCE
054900     ELSE
055000     NEXT SENTENCE.
055100     MOVE ZONE TO ZONE-LINK.
055200     CALL "TLABUPDT" USING DBPARAMETERS
055300                           STATUS-AREA
055400                           VIEW-COMAREA
055500                           CURR-LABOR-STAT-BUFF
055600                           ZONE-LINK.
055700 6140-SLR-EXIT.    EXIT.
055800 6142-CHECK-TEMPFILE-4-CC.
055900     MOVE 0 TO COND-WORD.
056000     MOVE CRAFTSMAN-NO TO PERCCNUM OF LCSFREC.
056100     MOVE CURR-LABOR-STAT-BUFF TO CURR-LABOR-STAT-BUFF-2.
056200     START LABOR-CURR-STAT-FIL2 KEY IS = EXTERNALLY-DESCRIBED-KEY
056300         INVALID KEY    MOVE 17 TO COND-WORD.
           IF LCSF-STATUS NOT = "00" MOVE 17 TO COND-WORD.
056400     IF COND-WORD = 17 GO TO 6142-CT4C-EXIT.
056500 6142-CT4C-CONT.
056600     READ LABOR-CURR-STAT-FIL2 NEXT INTO CURR-LABOR-STAT-BUFF
056700         AT END    MOVE 15 TO COND-WORD.
           IF LCSF2-STATUS NOT = "00" MOVE 15 TO COND-WORD.
056800     IF COND-WORD = 15 GO TO 6142-CT4C-EXIT.
056900     MOVE C-START-DATE-2-CN TO C-COMPL-DATE-CN.
057000     MOVE C-START-TIME-2 TO C-COMPL-TIME.
057100     PERFORM 6140-SAVE-LABOR-RECORDS THRU 6140-SLR-EXIT.
057200     DELETE LABOR-CURR-STAT-FILE RECORD.
057300 6142-CT4C-EXIT.    EXIT.
