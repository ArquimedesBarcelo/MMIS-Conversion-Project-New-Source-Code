                   PERFORM 98A-SCREEN-READ
                   MOVE SPACES TO MATL-CMD-LINE
                                  MATL-CMD-LINE-2
                   GO TO 62-READ-ADD-SCREEN
               ELSE
               MOVE "FADDMATL" TO VIEW-CFNAME
               MOVE 29041 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE ERROR-BUFFER TO MESSAGE-WA
                                    MESSAGE-WA-2
               MOVE TRUE-VAL TO INDS (98)
               PERFORM 623-PUT-BUFFER
               PERFORM 99-SCREEN-WRITE
               PERFORM 98A-SCREEN-READ
               MOVE SPACES TO MATL-CMD-LINE
                              MATL-CMD-LINE-2
               GO TO 62-READ-ADD-SCREEN.
           IF VIEW-LASTKEY = 5
             IF (G-SWITCH = SPACES) AND (VERBAL-WO-SWITCH = "Y")
               MOVE 29131 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE ERROR-BUFFER TO EDIT-ERROR
               MOVE TRUE-VAL TO INDS (99)
               GO TO 62-ADD-ITEMS
             ELSE
               IF VIEW-CFNAME = "FADDMAT2" OR "FADDMCO2"
                   OR "FADDMCA2" OR "FADMAT2L" OR "FADMCO2L"
                   OR "FADMCA2L"
                   MOVE 35126 TO CATREAD-MSG-NUMBER
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE ERROR-BUFFER TO EDIT-ERROR
                   MOVE TRUE-VAL TO INDS (99)
                   GO TO 62-RAS-CONT
               ELSE
               IF VIEW-CFNAME = "FADDMUN2" OR "FADDMUA2"
                   OR "FADMUN2L" OR "FADMUA2L"
                   MOVE SPACES TO WO-PARTS-DATA
                   MOVE REC-NO TO SAVE-REC-NO
                   MOVE 0 TO REQS-CUT-SW
                   MOVE PRT-STATUS-WA TO PRT-STATUS
                   MOVE PRT-QUANT-WA TO QTY-WA
                   PERFORM 621-RIGHT-ADJUST-QTY THRU 621-RAQ-EXIT
                   MOVE QTY-BYTE-9 TO PRT-QUANT-WA-9
                                      PRT-QUANT-WA-9-2
                   MOVE PRT-UP-DOLS-WA TO UP-WA
                   PERFORM 622-RIGHT-ADJUST-UP THRU 622-RAU-EXIT
                   MOVE UP-BYTES-9 TO PRT-UP-DOLS-WA-9
                                      PRT-UP-DOLS-WA-9-2
                   MULTIPLY PRT-QUANT-WA-9 BY PRT-UP-WA-9
                       GIVING P-EST-COST
                   PERFORM 628-CUT-A-REQUISITION THRU 628-CAR-EXIT
                   PERFORM 627-SAVE-REQUIRED-DATA
                   PERFORM 69-WRITE-WO-PARTS-FILE
                   PERFORM 624-CK-AND-RECORD-ERROR
                   PERFORM 629-UPDATE-WO-STATUS THRU 629-UWS-EXIT
                   MOVE SPACES TO ARGUMENT-VALUES PASSED-SWITCHES
                   MOVE PLANT-IDENT TO PLT-ARG
                   MOVE PRT-REQ-NO TO REQ-ARG
                   MOVE PRT-WO-NU TO WO-ARG
                   MOVE "Y" TO UPDATE-SW
                   CALL "SREQDESC" USING BASE-STORES PASSED-SWITCHES
                                     VIEW-COMAREA SCREEN-PRINT-PARMS
                                     PASSED-SPOOL-PRT STATUS-AREA
                                     ARGUMENT-VALUES
                   PERFORM 620-SET-ADD-SCREEN
                   MOVE 35098 TO CATREAD-MSG-NUMBER
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE ERROR-BUFFER TO MESSAGE-WA
                                        MESSAGE-WA-2
                   MOVE TRUE-VAL TO INDS (98)
                   PERFORM 623-PUT-BUFFER
                   PERFORM 99-SCREEN-WRITE
                   PERFORM 98A-SCREEN-READ
                   CALL "CLPAUSE2"
                   ADD 1 TO CHAIN-CTR
                   MOVE CHAIN-CTR TO ITEM-NO-WA
                                     ITEM-NO-WA-2
                   MOVE 31042 TO CATREAD-MSG-NUMBER
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE ERROR-BUFFER TO MESSAGE-WA
                                        MESSAGE-WA-2
                   MOVE SAVE-EXPCLASS TO ADDL-DATA-WA
                                         ADDL-DATA-WA-2
                   MOVE ENG-PL-SCHD-ID TO ORIG-WA
                                          ORIG-WA-2
                   PERFORM 620-SET-SUB-PRIME
                   MOVE SPACES TO SAVE-REQ-INFO
                   MOVE 0 TO SAVE-ACT-QTY
                   GO TO 62-READ-ADD-SCREEN
               ELSE
               MOVE SPACES TO WO-PARTS-DATA
               PERFORM 627-SAVE-REQUIRED-DATA
               PERFORM 69-WRITE-WO-PARTS-FILE
               PERFORM 624-CK-AND-RECORD-ERROR
               MOVE " " TO REQ-SWITCH
               MOVE 35098 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE ERROR-BUFFER TO MESSAGE-WA
                                    MESSAGE-WA-2
               MOVE TRUE-VAL TO INDS (98)
               PERFORM 623-PUT-BUFFER
               PERFORM 99-SCREEN-WRITE
               PERFORM 98A-SCREEN-READ
               CALL "CLPAUSE2"
               ADD 1 TO CHAIN-CTR
               MOVE CHAIN-CTR TO ITEM-NO-WA
                                 ITEM-NO-WA-2
               PERFORM 620-SET-ADD-SCREEN
               MOVE 31042 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE ERROR-BUFFER TO MESSAGE-WA
                                    MESSAGE-WA-2
               MOVE SAVE-EXPCLASS TO ADDL-DATA-WA
                                     ADDL-DATA-WA-2
               MOVE ENG-PL-SCHD-ID TO ORIG-WA
                                      ORIG-WA-2
               PERFORM 620-SET-SUB-PRIME
               GO TO 62-READ-ADD-SCREEN.
           IF VIEW-LASTKEY = 6
             IF (G-SWITCH = SPACES) AND (VERBAL-WO-SWITCH = "Y")
               MOVE 29131 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE ERROR-BUFFER TO EDIT-ERROR
               MOVE TRUE-VAL TO INDS (99)
               GO TO 62-ADD-ITEMS
             ELSE
               IF VIEW-CFNAME = "FADDMAT2" OR "FADDMCO2"
                   OR " FADMAT2L" OR "FADMCO2L"
                   MOVE 35126 TO CATREAD-MSG-NUMBER
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE ERROR-BUFFER TO EDIT-ERROR
                   MOVE TRUE-VAL TO INDS (99)
                   GO TO 62-RAS-CONT
               ELSE
               IF A-C-WA = "U"
                   IF PRT-CODE-WA = "       "
                       MOVE SPACES TO WO-PARTS-DATA
                       MOVE REC-NO TO SAVE-REC-NO
                       MOVE 0 TO REQS-CUT-SW
                       MOVE PRT-STATUS-WA TO PRT-STATUS
                       MOVE PRT-QUANT-WA TO QTY-WA
                       PERFORM 621-RIGHT-ADJUST-QTY THRU 621-RAQ-EXIT
                       MOVE QTY-BYTE-9 TO PRT-QUANT-WA-9
                                          PRT-QUANT-WA-9-2
                       MOVE PRT-UP-DOLS-WA TO UP-WA
                       PERFORM 622-RIGHT-ADJUST-UP THRU 622-RAU-EXIT
                       MOVE UP-BYTES-9 TO PRT-UP-DOLS-WA-9
                                          PRT-UP-DOLS-WA-9-2
                       MULTIPLY PRT-QUANT-WA-9 BY PRT-UP-WA-9
                           GIVING P-EST-COST
                       MOVE "R" TO REQ-SWITCH
                       PERFORM 628-CUT-A-REQUISITION THRU 628-CAR-EXIT
                       PERFORM 627-SAVE-REQUIRED-DATA
                       PERFORM 69-WRITE-WO-PARTS-FILE
                       PERFORM 624-CK-AND-RECORD-ERROR
                       PERFORM 629-UPDATE-WO-STATUS THRU 629-UWS-EXIT
                       MOVE 35098 TO CATREAD-MSG-NUMBER
                       PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                       MOVE ERROR-BUFFER TO MESSAGE-WA
                                            MESSAGE-WA-2
                       MOVE TRUE-VAL TO INDS (98)
                       PERFORM 623-PUT-BUFFER
                       PERFORM 99-SCREEN-WRITE
                       PERFORM 98A-SCREEN-READ
                       CALL "CLPAUSE2"
                       ADD 1 TO CHAIN-CTR
                       MOVE CHAIN-CTR TO ITEM-NO-WA
                                         ITEM-NO-WA-2
                       PERFORM 620-SET-ADD-SCREEN
                       MOVE 31042 TO CATREAD-MSG-NUMBER
                       PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                       MOVE ERROR-BUFFER TO MESSAGE-WA
                                            MESSAGE-WA-2
                       MOVE SAVE-EXPCLASS TO ADDL-DATA-WA
                                             ADDL-DATA-WA-2
                       MOVE ENG-PL-SCHD-ID TO ORIG-WA
                                              ORIG-WA-2
                       PERFORM 620-SET-SUB-PRIME
                       MOVE SPACES TO SAVE-REQ-INFO
                       MOVE 0 TO SAVE-ACT-QTY
                       GO TO 62-READ-ADD-SCREEN
                   ELSE
                   MOVE 42078 TO CATREAD-MSG-NUMBER
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE ERROR-BUFFER TO MESSAGE-WA
                                        MESSAGE-WA-2
                   GO TO 62-RAS-CONT
               ELSE
               MOVE SPACES TO WO-PARTS-DATA
               MOVE REC-NO TO SAVE-REC-NO
               MOVE 0 TO REQS-CUT-SW
               MOVE PRT-STATUS-WA TO PRT-STATUS
      ********************************************************
      *     ADDED THE FOLLOWING CODE TO RIGHT JUSTIFY QUANTITY
      *     WHEN USER REALIZED THE WRONG QUANTITY WAS INPUT
      *     PRIOR TO CUTTING A REQUISITION AND TRIED TO ALTER
      *     IT.......JIM C.
      *********************************************************
               MOVE PRT-QUANT-WA   TO QTY-WA
               PERFORM 621-RIGHT-ADJUST-QTY THRU 621-RAQ-EXIT
               MOVE QTY-BYTE-9 TO PRT-QUANT-WA-9
                                  PRT-QUANT-WA-9-2
               MOVE PRT-UP-DOLS-WA TO UP-WA
               PERFORM 622-RIGHT-ADJUST-UP THRU 622-RAU-EXIT
               MOVE UP-BYTES-9 TO PRT-UP-DOLS-WA-9
                                  PRT-UP-DOLS-WA-9-2
               MULTIPLY PRT-QUANT-WA-9 BY PRT-UP-WA-9
                   GIVING P-EST-COST
               MOVE "R" TO REQ-SWITCH
               PERFORM 628-CUT-A-REQUISITION THRU 628-CAR-EXIT
               PERFORM 627-SAVE-REQUIRED-DATA
               PERFORM 69-WRITE-WO-PARTS-FILE
               PERFORM 624-CK-AND-RECORD-ERROR
               PERFORM 629-UPDATE-WO-STATUS THRU 629-UWS-EXIT
               MOVE 35098 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE ERROR-BUFFER TO MESSAGE-WA
                                    MESSAGE-WA-2
               MOVE TRUE-VAL TO INDS (98)
               PERFORM 623-PUT-BUFFER
               PERFORM 99-SCREEN-WRITE
               PERFORM 98A-SCREEN-READ
               CALL "CLPAUSE2"
               ADD 1 TO CHAIN-CTR
               MOVE CHAIN-CTR TO ITEM-NO-WA
                                 ITEM-NO-WA-2
               PERFORM 620-SET-ADD-SCREEN
               MOVE 31042 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE ERROR-BUFFER TO MESSAGE-WA
                                    MESSAGE-WA-2
               PERFORM 620-SET-SUB-PRIME
               MOVE SAVE-EXPCLASS TO ADDL-DATA-WA
                                     ADDL-DATA-WA-2
               MOVE ENG-PL-SCHD-ID TO ORIG-WA
                                      ORIG-WA-2
               MOVE SPACES TO SAVE-REQ-INFO
               MOVE 0 TO SAVE-ACT-QTY
               GO TO 62-READ-ADD-SCREEN.
           IF VIEW-LASTKEY = 7
               PERFORM 620-SET-ADD-SCREEN
               MOVE 31042 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE ERROR-BUFFER TO MESSAGE-WA
                                    MESSAGE-WA-2
