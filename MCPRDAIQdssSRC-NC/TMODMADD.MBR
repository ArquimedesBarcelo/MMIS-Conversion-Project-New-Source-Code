               MOVE 66075 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE ERROR-BUFFER TO MATL-CMD-LINE
                                    MATL-CMD-LINE-2
           ELSE
           IF VIEW-CFNAME = "FADDMUN2"
               MOVE "FADDMUNC" TO VIEW-CFNAME
               MOVE 66073 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE ERROR-BUFFER TO MATL-CMD-LINE
                                    MATL-CMD-LINE-2
           ELSE
           MOVE "FADDMATL" TO VIEW-CFNAME
           MOVE 66072 TO CATREAD-MSG-NUMBER
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
           MOVE ERROR-BUFFER TO MATL-CMD-LINE
                                MATL-CMD-LINE-2.
      ********************************************************************
      *    SMD-SW IS SET BEFORE GOING TO TMATHELP (HELP SCREENS)         *
      *    TO INSURE THAT FIELDS ARE NOT CLEARED WHICH THE USER HAS      *
      *    ALREADY INPUT                                                 *
      ********************************************************************
           IF SMD-SW = 1
               MOVE 0 TO SMD-SW
           ELSE
           IF PRT-CODE-WA = SPACES
               IF PRT-STATUS-1-WA = "M"
                    MOVE SPACES       TO PRT-QUANT-WA
                                         PRT-QUANT-WA-2
                                         PRT-UNIT-MEAS-WA
                                         PRT-UNIT-MEAS-WA-2
                                         MESSAGE-WA
                                         MESSAGE-WA-2
                    MOVE ZEROES       TO PRT-UP-WA
                                         PRT-UP-WA-2
               ELSE
               MOVE SPACES            TO PRT-QUANT-WA
                                         PRT-QUANT-WA-2
                                         PRT-UNIT-MEAS-WA
                                         PRT-UNIT-MEAS-WA-2
                                         PRT-CODE-WA
                                         PRT-CODE-WA-2
                                         PRT-DESC-WA
                                         PRT-DESC-WA-2
                                         REMARKS-WA
                                         REMARKS-WA-2
                                         MESSAGE-WA
                                         MESSAGE-WA-2
               MOVE ZEROES            TO PRT-UP-WA
                                         PRT-UP-WA-2
           ELSE
           MOVE SPACES                TO PRT-QUANT-WA
                                         PRT-QUANT-WA-2
                                         PRT-UNIT-MEAS-WA
                                         PRT-UNIT-MEAS-WA-2
                                         PRT-CODE-WA
                                         PRT-CODE-WA-2
                                         PRT-DESC-WA
                                         PRT-DESC-WA-2
                                         REMARKS-WA
                                         REMARKS-WA-2
                                         MESSAGE-WA
                                         MESSAGE-WA-2
           MOVE ZEROES                TO PRT-UP-WA
                                         PRT-UP-WA-2.

      ******************************************************
      *    PCPR-SW SET IN THE PARAGRAPH BELOW IS SET UP    *
      *    IN PLANT STARTUP ROUTINES OF CSIS TO INFORM     *
      *    THE PROGRAM OF WHETHER THE USER WILL ENTER      *
      *    COMPANY AND PRIME OR NOT ON THE ADD SCREENS     *
      ******************************************************
       620-SET-SUB-PRIME.
           IF MPLTINFO-PCPR-SW = "Y"
               IF VIEW-CFNAME = "FADMCODL" OR "FADMCOAL"
                   OR "FADMUNAL" OR "FADMUNCL"
                   MOVE SAVE-SUB-WA   TO SUB-WA
                                         SUB-WA-2
                   MOVE SAVE-PRIME-WA TO PRIME-WA
                                         PRIME-WA-2
               ELSE
               MOVE "DP"              TO VALID-ARG-1-2
               MOVE SAVE-DEPT         TO VALID-ARG-3-10
               PERFORM 69-START-MVALIDPLTDATA-FILE
               IF COND-WORD = 17
                   MOVE "000"         TO SUB-WA
                                         SUB-WA-2
                                         SAVE-SUB-WA
                   MOVE "   "         TO PRIME-WA
                                         PRIME-WA-2
                                         SAVE-PRIME-WA
                   MOVE "   "         TO PRT-COMP-WA-2
               ELSE
               PERFORM 69-READ-MVALIDPLTDATA-FILE
               IF COND-WORD = 15
                   MOVE "000"         TO SUB-WA
                                         SUB-WA-2
                                         SAVE-SUB-WA
                   MOVE "   "         TO PRIME-WA
                                         PRIME-WA-2
                                         SAVE-PRIME-WA
                   MOVE "   "         TO PRT-COMP-WA-2
               ELSE
               MOVE "000"             TO SUB-WA
                                         SUB-WA-2
                                         SAVE-SUB-WA
               MOVE VALID-DATA-PR     TO PRIME-WA
                                         PRIME-WA-2
                                         SAVE-PRIME-WA
               MOVE VALID-DATA-CO     TO PRT-COMP-WA-2
           ELSE
           IF VIEW-CFNAME = "FADDMCOD" OR "FADDMCOA"
               OR "FADDMUNA" OR "FADDMUNC"
               MOVE SAVE-SUB-WA       TO SUB-WA
                                         SUB-WA-2
               MOVE SAVE-PRIME-WA     TO PRIME-WA
                                         PRIME-WA-2
           ELSE
           MOVE "   "                 TO SUB-WA
                                         SUB-WA-2
                                         SAVE-SUB-WA
           MOVE "120"                 TO PRIME-WA
                                         PRIME-WA-2
                                         SAVE-PRIME-WA.

       621-RIGHT-ADJUST-QTY.
           MOVE 5 TO SUB1, SUB2.
           IF QTY-BYTE (SUB1) NOT = " " GO TO 621-ZEROFILL-FIELD.
       621-RAQ-FIRST.
           IF QTY-BYTE (SUB1) NOT = " " GO TO 621-MOVE-BYTE.
           IF SUB1 = 1 GO TO 621-ZEROFILL-FIELD.
           SUBTRACT 1 FROM SUB1.
           GO TO 621-RAQ-FIRST.
       621-MOVE-BYTE.
           IF QTY-BYTE (SUB1) = " "
             MOVE ZEROS TO QTY-BYTE (SUB1)
             GO TO 621-ZEROFILL-FIELD.
           MOVE QTY-BYTE (SUB1) TO QTY-BYTE (SUB2).
           MOVE " " TO QTY-BYTE (SUB1).
           IF SUB1 = 1 GO TO 621-ZEROFILL-FIELD.
           SUBTRACT 1 FROM SUB1, SUB2.
           GO TO 621-MOVE-BYTE.
       621-ZEROFILL-FIELD.
      *--- ADDED STATEMENTS TO MOVE ZEROES TO THE LEFT OF THE NUMBER.
           IF QTY-BYTE (5) = " " MOVE "0" TO QTY-BYTE (5).
           IF QTY-BYTE (4) = " " MOVE "0" TO QTY-BYTE (4).
           IF QTY-BYTE (3) = " " MOVE "0" TO QTY-BYTE (3).
           IF QTY-BYTE (2) = " " MOVE "0" TO QTY-BYTE (2).
           IF QTY-BYTE (1) = " " MOVE "0" TO QTY-BYTE (1).
           IF QTY-BYTE-9 NUMERIC
               MOVE QTY-BYTE-9 TO QTY-WS-5
               MOVE QTY-WS-5 TO QTY-BYTE-9.
       621-RAQ-EXIT.     EXIT.
       622-RIGHT-ADJUST-UP.
           MOVE 0 TO SUB1.
           PERFORM 6221-SCAN-FOR-DECIMAL THRU 6221-SFD-EXIT.
           MOVE 12 TO SUB1, SUB2.
           IF UPB (SUB1) NOT = " " GO TO 622-ZEROFILL-FIELD.
       622-RAU-FIRST.
           IF UPB (SUB1) NOT = " " GO TO 622-MOVE-BYTE.
           IF SUB1 = 1 GO TO 622-ZEROFILL-FIELD.
           SUBTRACT 1 FROM SUB1.
           GO TO 622-RAU-FIRST.
       622-MOVE-BYTE.
           IF UPB (SUB1) = " " GO TO 622-ZEROFILL-FIELD.
           MOVE UPB (SUB1) TO UPB (SUB2).
           MOVE " " TO UPB (SUB1).
           IF SUB1 = 1 GO TO 622-ZEROFILL-FIELD.
           SUBTRACT 1 FROM SUB1, SUB2.
           GO TO 622-MOVE-BYTE.
       622-ZEROFILL-FIELD.
           MOVE QTY-BYTE-9 TO QTY-WS-5.
           MOVE QTY-WS-5 TO QTY-BYTE-9.
       622-RAU-EXIT.    EXIT.
       622-RIGHT-ADJUST-TWO.
           IF TWO-B-WA (2) = " "
               MOVE TWO-B-WA (1) TO TWO-B-WA (2)
               MOVE "0" TO TWO-B-WA (1)
           ELSE
           IF TWO-B-WA (1) = " "
               MOVE "0" TO TWO-B-WA (1).
       622-RAT-EXIT.    EXIT.
       6221-SCAN-FOR-DECIMAL.
           ADD 1 TO SUB1.
           IF SUB1 > 12 GO TO 6221-SFD-EXIT.
           IF UPB (SUB1) = "."
               MOVE " " TO UPB (SUB1)
           ELSE
           GO TO 6221-SCAN-FOR-DECIMAL.
           ADD 1 TO SUB1.
           IF SUB1 > 12 GO TO 6221-SFD-EXIT.
           MOVE UPB (SUB1) TO PRT-UP-CENTS-WA-1
                              PRT-UP-CENTS-WA-1-2.
           MOVE " " TO UPB (SUB1).
           ADD 1 TO SUB1.
           IF SUB1 > 12 GO TO 6221-SFD-EXIT.
           MOVE UPB (SUB1) TO PRT-UP-CENTS-WA-2
                              PRT-UP-CENTS-WA-2-2.
           MOVE " " TO UPB (SUB1).
       6221-SFD-EXIT.    EXIT.
       623-GET-BUFFER.
           IF MPLTINFO-PCPR-SW = "Y"
               MOVE DSPLY-REC           TO MATL-WORKAREA-2
               MOVE MATL-HEADER-INFO-2  TO MATL-HEADER-INFO
               MOVE PRT-STATUS-WA-2     TO PRT-STATUS-WA
               MOVE PRIME-WA-2          TO PRIME-WA
               MOVE SUB-WA-2            TO SUB-WA
               MOVE STAGE-WA-2          TO STAGE-WA
               MOVE ORIG-WA-2           TO ORIG-WA
               MOVE DATE-REQD-WA-2      TO DATE-REQD-WA
               MOVE ADDL-INFO-WA-2      TO ADDL-INFO-WA
               MOVE SUGG-VENDOR-WA-2    TO SUGG-VENDOR-WA
               MOVE ITEM-NO-WA-2        TO ITEM-NO-WA
               MOVE PRT-QUANT-WA-2      TO PRT-QUANT-WA
               MOVE PRT-UNIT-MEAS-WA-2  TO PRT-UNIT-MEAS-WA
               MOVE PRT-CODE-WA-2       TO PRT-CODE-WA
               MOVE PRT-UP-WA-2         TO PRT-UP-WA
               MOVE ADDL-DATA-WA-2      TO ADDL-DATA-WA
               MOVE PRT-PM-LEVEL-WA-2   TO PRT-PM-LEVEL-WA
               MOVE PRT-PM-FLAG-WA-2    TO PRT-PM-FLAG-WA
               MOVE PRT-PM-SUBS-WA-2    TO PRT-PM-SUBS-WA
               MOVE PRT-DESC-WA-2       TO PRT-DESC-WA
               MOVE PRT-DESC-WA-80-2    TO PRT-DESC-WA-80
               MOVE REMARKS-WA-2        TO REMARKS-WA
               MOVE DOCK-NOTIFY-WA-2    TO DOCK-NOTIFY-WA
               MOVE MATL-CMD-LINE-2     TO MATL-CMD-LINE
               MOVE MATL-ERR-LINE-2     TO MATL-ERR-LINE
               MOVE MATL-ERR-LINE-2     TO MATL-ERR-LINE
           ELSE
           MOVE DSPLY-REC               TO MATL-WORKAREA
           MOVE MATL-HEADER-INFO        TO MATL-HEADER-INFO-2
           MOVE PRT-STATUS-WA           TO PRT-STATUS-WA-2
           MOVE PRIME-WA                TO PRIME-WA-2
           MOVE SUB-WA                  TO SUB-WA-2
           MOVE STAGE-WA                TO STAGE-WA-2
           MOVE ORIG-WA                 TO ORIG-WA-2
           MOVE DATE-REQD-WA            TO DATE-REQD-WA-2
           MOVE ADDL-INFO-WA            TO ADDL-INFO-WA-2
           MOVE SUGG-VENDOR-WA          TO SUGG-VENDOR-WA-2
           MOVE ITEM-NO-WA              TO ITEM-NO-WA-2
           MOVE PRT-QUANT-WA            TO PRT-QUANT-WA-2
           MOVE PRT-UNIT-MEAS-WA        TO PRT-UNIT-MEAS-WA-2
           MOVE PRT-CODE-WA             TO PRT-CODE-WA-2
           MOVE PRT-UP-WA               TO PRT-UP-WA-2
           MOVE ADDL-DATA-WA            TO ADDL-DATA-WA-2
           MOVE PRT-PM-LEVEL-WA         TO PRT-PM-LEVEL-WA-2
           MOVE PRT-PM-FLAG-WA          TO PRT-PM-FLAG-WA-2
           MOVE PRT-PM-SUBS-WA          TO PRT-PM-SUBS-WA-2
           MOVE PRT-DESC-WA             TO PRT-DESC-WA-2
           MOVE PRT-DESC-WA-80          TO PRT-DESC-WA-80-2
           MOVE REMARKS-WA              TO REMARKS-WA-2
           MOVE DOCK-NOTIFY-WA          TO DOCK-NOTIFY-WA-2
           MOVE MATL-CMD-LINE           TO MATL-CMD-LINE-2
           MOVE MATL-ERR-LINE           TO MATL-ERR-LINE-2.

       623-PUT-BUFFER.
           IF MPLTINFO-PCPR-SW = "Y"
               MOVE MATL-WORKAREA-2     TO DSPLY-REC
           ELSE
           MOVE MATL-WORKAREA           TO DSPLY-REC.

       624-CK-AND-RECORD-ERROR.
           IF COND-WORD NOT = 0
               MOVE "  MMISA" TO BLOWUP-BASE
               MOVE "WRITE FAILURE * TMODMADD *"
                   TO BU-DISPLAY-MSG
               PERFORM 998-BLOWUP.

       626-PCPR-EDITS.
           IF MPLTINFO-PCPR-SW = "N" GO TO 626-PE-X.
           IF PRT-CODE-WA-2 = "        "
               MOVE "PR" TO VALID-ARG-1-2
               MOVE PRIME-WA-2 TO VALID-ARG-3-10
               PERFORM 69-START-MVALIDPLTDATA-FILE
               IF COND-WORD = 17
      *M       "PRIME IS INVALID"
                   MOVE 16150 TO CATREAD-MSG-NUMBER
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE TRUE-VAL TO INDS (2) INDS (99)
                   GO TO 626-PE-X.
           IF PRT-COMP-WA-2 = "   "
      *M   "COMPANY CODE IS REQUIRED"
               MOVE 03196 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE TRUE-VAL TO INDS (39) INDS (99)
               GO TO 626-PE-X
           ELSE
           MOVE "CO" TO VALID-ARG-1-2
           MOVE PRT-COMP-WA-2 TO VALID-ARG-3-10
           PERFORM 69-START-MVALIDPLTDATA-FILE
           IF COND-WORD = 17
      *M   "COMPANY CODE IS INVALID"
               MOVE 03197 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE TRUE-VAL TO INDS (39) INDS (99)
               GO TO 626-PE-X.
           IF ADDL-DATA-WA-2 = SAVE-ADDL-DATA
               NEXT SENTENCE
           ELSE
           IF PRT-CODE-WA-2 = "        "
               NEXT SENTENCE
           ELSE
      *M   "EXP/NW IS NOT CHANGEABLE FOR STORES ITEMS"
           MOVE 05063 TO CATREAD-MSG-NUMBER
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
           MOVE TRUE-VAL TO INDS (27) INDS (99)
           GO TO 626-PE-X.
           IF SUB-WA-2 < "100"
               MOVE "NW" TO VALID-ARG-1-2
               MOVE ADDL-DATA-WA-2 TO VALID-ARG-3-10
               PERFORM 69-START-MVALIDPLTDATA-FILE
               IF COND-WORD = 17
      *M       "NEW WORK IS INVALID FOR EXPENSE TYPE ENTERED"
                   MOVE 14123 TO CATREAD-MSG-NUMBER
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE TRUE-VAL TO INDS (27) INDS (99)
                   GO TO 626-PE-X.
           IF SUB-WA-2 > "099"
               MOVE ADDL-DATA-WA-2 TO VALID-ARG
               MOVE "EC" TO VALID-ARG-1-2
               PERFORM 69-START-MVALIDPLTDATA-FILE
               IF COND-WORD = 17
      *M       "EXPENSE TYPE > 99 FOR EXPENSED ITEMS"
                   MOVE 05065 TO CATREAD-MSG-NUMBER
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE TRUE-VAL TO INDS (3) INDS (99)
                   GO TO 626-PE-X.
           IF PRT-CODE-WA-2 = "        "
               MOVE SUB-WA-2 TO PLT-ARG
               PERFORM 69-START-MCLASS-FILE
               IF COND-WORD = 17
      *M       "EXPENSE TYPE IS INVALID - CHECK MATERIALS CONTROL"
                   MOVE 05066 TO CATREAD-MSG-NUMBER
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE TRUE-VAL TO INDS (3) INDS (99).

       626-PE-X.    EXIT.

       627-SAVE-REQUIRED-DATA.
           MOVE SPACES TO WO-PARTS-DATA.
           IF PRT-REQ-NO = SPACES
               MOVE SAVE-ITEM-NO TO PRT-ITEM-NO
               MOVE SAVE-REQ-NO TO PRT-REQ-NO
               MOVE SAVE-ACT-QTY TO PRT-ACT-QTY-9.
           MOVE WO-NUM-WA TO PRT-WO-NU.
           MOVE PRT-STATUS-WA TO PRT-STATUS.
           MOVE PRT-QUANT-WA-9 TO PRT-EST-QTY-9.
      *    IF A-C-WA = "A"
      *        MOVE "*" TO PRT-EST-QTY-FLAG
      *    ELSE
      *    MOVE " " TO PRT-EST-QTY-FLAG.
           MOVE PRT-CODE-WA TO PRT-NUM.
           MOVE PRT-UNIT-MEAS-WA TO PRT-UNIT-MEAS.
           MOVE PRT-UP-WA-9 TO COST-WA.
           MOVE COST-DOLS TO PRT-UNIT-COST-DOLLR.
           MOVE COST-CENTS TO UC-WA-CENTS-1-2.
           MOVE 00 TO UC-WA-CENTS-3-4.
           MOVE UC-WA-C-94 TO PRT-UNIT-COST-CENTS.
           MULTIPLY PRT-QUANT-WA-9 BY PRT-UP-WA-9 GIVING P-EST-COST.
           MOVE PRIME-WA TO PRT-PRIME-1-3 SAVE-PRIME-WA.
           MOVE SUB-WA TO PRT-SUB-1-3 SAVE-SUB-WA.
           MOVE STAGE-WA TO PRT-STAGE.
           MOVE ORIG-WA TO PRT-ORIGINATOR.
           MOVE 3 TO DATE-MODE.
           MOVE DATE-REQD-WA TO DATE-VALIDATE-IN.
           CALL "TDATECHK" USING DATE-CHECK-AREA.
           MOVE DATE-DB TO PRT-DATE-USED.
           IF PRT-DATE-USED-YY > "70"
               MOVE "19" TO PRT-DATE-USED-CC
           ELSE
           MOVE "20" TO PRT-DATE-USED-CC.
           MOVE ADDL-INFO-WA TO PRT-ADDL-INFO.
           MOVE SUGG-VENDOR-WA TO PRT-SUGG-VENDOR.
           MOVE PRT-PM-LEVEL-WA TO PRT-LEVEL.
           MOVE PRT-PM-FLAG-WA TO PRT-FLAG.
           MOVE PRT-PM-SUBS-WA TO PRT-SS.
           MOVE P-D-WA-80 (1) TO PRT-DESC.
           MOVE P-D-WA-80 (2) TO PRT-DESC-2.
           MOVE P-D-WA-80 (3) TO PRT-DESC-3.
           MOVE P-D-WA-80 (4) TO PRT-DESC-4.
           MOVE P-D-WA-80 (5) TO PRT-DESC-5.
           MOVE REMARKS-1-WA TO PRT-REMARKS.
           MOVE REMARKS-2-WA TO PRT-REMARKS-2.

       628-CUT-A-REQUISITION.
           IF JCW-AREQJCW-259 = 1
               NEXT SENTENCE
           ELSE
           GO TO 628-CAR-EXIT.
           MOVE SPACES TO CMR-DATA CMR-DESC CMR-REMARKS
               CMR-RETURNED-DATA CMR-MISC-PARMS.
           MOVE "CR"               TO CMR-CALL-MODE.
           MOVE WO-NUM-WA          TO  CMR-WO-NUMBER.
           MOVE ITEM-NO-WA         TO  CMR-WO-ITEM-NUMBER.
           MOVE PRT-CODE-WA        TO  CMR-CORP-CODE.
           MOVE 3                  TO  DATE-MODE.
           MOVE DATE-REQD-WA       TO  DATE-VALIDATE-IN.
           CALL "TDATECHK" USING DATE-CHECK-AREA.
           MOVE DATE-DB            TO  CMR-DATE-REQUIRED.
           IF CMR-DATE-REQUIRED-YY > "70"
               MOVE "19"           TO  CMR-DATE-REQUIRED-CC
           ELSE
           MOVE "20"               TO  CMR-DATE-REQUIRED-CC.
           MOVE STAGE-WA           TO  CMR-STAGING-AREA.
           MOVE PRT-QUANT-WA       TO  CMR-QTY.
           MOVE PRT-UNIT-MEAS-WA   TO  CMR-UM.
           MOVE BUDGET-NO          TO  CMR-BUDGET-NUMBER.
           MOVE P-D-WA-80 (1)      TO  CMR-DESC-LINE (1).
           MOVE P-D-WA-80 (2)      TO  CMR-DESC-LINE (2).
           MOVE P-D-WA-80 (3)      TO  CMR-DESC-LINE (3).
           MOVE P-D-WA-80 (4)      TO  CMR-DESC-LINE (4).
           MOVE P-D-WA-80 (5)      TO  CMR-DESC-LINE (5).
           MOVE REMARKS-1-WA       TO  CMR-REMARK-1.
           MOVE REMARKS-2-WA       TO  CMR-REMARK-2.
           MOVE ORIG-WA            TO  CMR-REQ-ORIG.
           MOVE DOCK-NOTIFY-WA     TO  CMR-DOCK-NOTIFY.
           MOVE SERVICE-FLAG       TO  CMR-SERVICE-FLAG.
           IF MPLTINFO-PCPR-SW = "Y"
             MOVE SAVE-EXPCLASS  TO  WS-EXPENSE
             MOVE WS-EXPENSE-3   TO  CMR-SUB
             MOVE SUB-WA         TO  WS-EXPENSE-3
             MOVE SPACES         TO  WS-EXPENSE-5
             MOVE WS-EXPENSE     TO  CMR-EXPENSE-CLASS
             MOVE PRT-COMP-WA-2  TO CMR-COMPANY
           ELSE
             MOVE SUB-WA         TO  CMR-SUB
             MOVE SAVE-EXPCLASS  TO  CMR-EXPENSE-CLASS
             MOVE PLANT-IDENT    TO  CMR-COMPANY.
           MOVE ADDL-INFO-WA   TO  CMR-ADDTL-INFO.
           MOVE PRIME-WA           TO  CMR-PRIME.
           MOVE 0                  TO CMR-SPOOL-PRT.
           MOVE ZEROES             TO UC-WA-CENTS-3-4.
           MOVE PRT-UP-DOLS-WA-9   TO  UC-WA-DOLS.
           MOVE PRT-UP-CENTS-WA    TO  UC-WA-CENTS-1-2.
           MOVE U-C-WA             TO CMR-EST-UNIT-PRICE.
           MOVE ZEROES             TO CMR-EST-UNIT-PRICE-CURR.
           MOVE SAVE-DEPT          TO CMR-FOR-DEPT.
           MOVE SAVE-EXPCLASS      TO CMR-EXPENSE-CLASS.
           MOVE SUGG-VENDOR-WA     TO CMR-SUGGESTED-VENDOR.
      ****************************************************************
      *    THE FOLLOWING CALLS TO TPRINTWS WERE ADDED 4-28-86 TO     *
      *    PRINT THE WORK SHEET EACH TIME THAT A REQUISTION IS CUT.  *
      *    LOGIC WAS REQUESTED BY CME TO ALLOW ENGINEERING/PLANNING  *
      *    TO INCLUDE A COPY OF THE WORK TO BE DONE WITH THE MANUAL  *
      *    REQUISITION OF MATERIALS THAT MUST BE APPROVED.           *
      ****************************************************************
           IF PRT-STATUS-1-WA = "M"
               IF A-C-WA = "A"
                   NEXT SENTENCE
               ELSE
               IF NON-STORES-SW = 1
                   MOVE "%" TO CMR-UNAPP-FLAG
                   IF PRINT-WO-REQPK = "N"
                       NEXT SENTENCE
                   ELSE
                   CALL "TPRINTWS" USING DBPARAMETERS WO-PLANNED-DATA
                                     ERROR-SWITCH VIEW-COMAREA
               ELSE
               IF PRT-CODE-WA = "       "
                   MOVE "%" TO CMR-UNAPP-FLAG
                   IF PRINT-WO-REQPK = "N"
                       NEXT SENTENCE
                   ELSE
                   CALL "TPRINTWS" USING DBPARAMETERS WO-PLANNED-DATA
                                     ERROR-SWITCH VIEW-COMAREA
               ELSE
               MOVE 42064 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               GO TO 628-CAR-EXIT.
           IF PLANT-IDENT = "631"
               IF PRT-CODE-WA = "      " OR "NON-STR"
                   NEXT SENTENCE
               ELSE
               MOVE "X" TO CMR-AUTH-FLAG.
           CALL "CMANREQ" USING BASE-STORES
                                BASE-MMISA
                                BASE-BG
                                BASE-DUMMY
                                ERROR-76
                                CMR-CALL-MODE
                                CMR-DATA
                                CMR-DESC
                                CMR-REMARKS
                                CMR-RETURNED-DATA
                                CMR-MISC-PARMS
                                REQ-GLOBALS
                                LANGUAGE-PARMS
                                ESC-NAME
                                VIEW-COMAREA.
           IF CMR-RETURN-STATUS = "OK"
               MOVE 1 TO REQS-CUT-SW
               MOVE 44110 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE ERROR-BUFFER TO REQ-ISSUED-MSG
               MOVE CMR-WO-NUMBER TO REQU-WO
               MOVE CMR-REQ-NUMBER TO REQ-ISS PRT-REQ-NO SAVE-REQ-NO
               MOVE ITEM-NO-WA TO SAVE-ITEM-NO
               MOVE CMR-QTY TO SAVE-ACT-QTY
               MOVE TRUE-VAL TO INDS (98)
               MOVE REQ-ISSUED-MSG TO MATL-CMD-LINE
               MOVE MATL-WORKAREA TO DSPLY-REC
               PERFORM 99-SCREEN-WRITE
               PERFORM 98A-SCREEN-READ
               CALL "CLPAUSE2"
           ELSE
           IF CMR-RETURN-STATUS = "RE"
               MOVE 44034 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE ERROR-BUFFER TO MATL-CMD-LINE
               MOVE MATL-WORKAREA TO DSPLY-REC
               MOVE TRUE-VAL TO INDS (98)
               PERFORM 99-SCREEN-WRITE
               PERFORM 98A-SCREEN-READ
               CALL "CLPAUSE2"
           ELSE
           IF CMR-RETURN-STATUS = "DE"
               MOVE BASE-STORES TO BLOWUP-BASE
               MOVE "STORES DB ERROR - RETURNING FROM CMANREQ"
                   TO BU-DISPLAY-MSG
               PERFORM 998-BLOWUP
           ELSE
           IF CMR-RETURN-STATUS = "BB"
               MOVE 28021 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE ERROR-BUFFER TO MATL-CMD-LINE
               MOVE MATL-WORKAREA TO DSPLY-REC
               MOVE TRUE-VAL TO INDS (98)
               PERFORM 99-SCREEN-WRITE
               PERFORM 98A-SCREEN-READ
               CALL "CLPAUSE2"
           ELSE
           MOVE 45048 TO CATREAD-MSG-NUMBER
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
           MOVE ERROR-BUFFER TO MATL-CMD-LINE
           MOVE MATL-WORKAREA TO DSPLY-REC
           MOVE TRUE-VAL TO INDS (98)
           PERFORM 99-SCREEN-WRITE
           PERFORM 98A-SCREEN-READ
           CALL "CLPAUSE2".
       628-CAR-EXIT.    EXIT.

       629-UPDATE-WO-STATUS.
           IF REQS-CUT-SW = 0 GO TO 629-UWS-EXIT.
           PERFORM 69-START-WO-BASIC-FILE.
           IF COND-WORD = 17
             GO TO 629-UWS-CONT
           ELSE
             MOVE "Y" TO VERBAL-WO-SWITCH.
           PERFORM 69-READ-WO-BASIC-FILE.
           IF COND-WORD = 15
             GO TO 629-UWS-CONT
           ELSE
             MOVE "Y" TO VERBAL-WO-SWITCH.
           IF A-C-WA = "U"
               MOVE "HA" TO WO-STATUS WO-STATUS-WA.
           MOVE 0 TO COND-WORD.
           DELETE WO-BASIC-FILE RECORD
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF COND-WORD = 17
               MOVE "  MMISA" TO BLOWUP-BASE
               MOVE "DELETE OF WO-BASIC FAILED * TMODMADD *"
                   TO BU-DISPLAY-MSG
               PERFORM 998-BLOWUP.
           MOVE 0 TO COND-WORD.
           WRITE WBFREC FROM WO-BASIC-DATA
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF COND-WORD = 17
               MOVE "  MMISA" TO BLOWUP-BASE
               MOVE "WRITE OF WO-BASIC FAILED * TMODMADD *"
                   TO BU-DISPLAY-MSG
               PERFORM 998-BLOWUP.
           GO TO 629-UWS-EXIT.
       629-UWS-CONT.
           PERFORM 69-START-WO-PLANNED-FILE.
           IF COND-WORD = 17 GO TO 629-UWS-EXIT.
           PERFORM 69-READ-WO-PLANNED-FILE.
           IF COND-WORD = 15 GO TO 629-UWS-EXIT.
           IF A-C-WA = "U"
               MOVE "HA" TO WO-STATUS-P WO-STATUS-WA
           ELSE
           IF WO-STATUS-P = "OO" OR "HA"
               MOVE "HM" TO WO-STATUS-P WO-STATUS-WA.
           MOVE 0 TO COND-WORD.
           DELETE WO-PLANNED-FILE RECORD
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF COND-WORD = 17
               MOVE "  MMISA" TO BLOWUP-BASE
               MOVE "DELETE OF WO-PLANNED FAILED * TMODMADD *"
                   TO BU-DISPLAY-MSG
               PERFORM 998-BLOWUP.
           MOVE 0 TO COND-WORD.
           WRITE WPFREC FROM WO-PLANNED-DATA
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF COND-WORD = 17
               MOVE "  MMISA" TO BLOWUP-BASE
               MOVE "WRITE OF WO-PLANNED FAILED * TMODMADD *"
                   TO BU-DISPLAY-MSG
               PERFORM 998-BLOWUP.
       629-UWS-EXIT.    EXIT.

       69-START-MCLASS-FILE.
           MOVE 0 TO COND-WORD.
           MOVE PLT-ARG TO ACTGCLASS OF MCFREC.
           START MCLASS-FILE KEY IS = EXTERNALLY-DESCRIBED-KEY
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF MCF-STATUS NOT = "00" MOVE 17 TO COND-WORD.

       69-START-MPLTINFO-FILE.
           MOVE 0 TO COND-WORD.
           MOVE MPLTINFO-ARG TO PLTINFOKEY OF MFREC.
           START MPLTINFO-FILE KEY IS = EXTERNALLY-DESCRIBED-KEY
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF MF-STATUS NOT = "00" MOVE 17 TO COND-WORD.

       69-READ-MPLTINFO-FILE.
           MOVE 0 TO COND-WORD.
           READ MPLTINFO-FILE INTO BUF-MPLTINFO
               INVALID KEY    MOVE 15 TO COND-WORD.
           IF MF-STATUS NOT = "00" MOVE 15 TO COND-WORD.

       69-READ-MSTORERM-FILE.
           MOVE 0 TO COND-WORD.
           READ MSTORERM-FILE NEXT INTO BUF-MSTORERM
               AT END    MOVE 15 TO COND-WORD.
           IF MSF-STATUS NOT = "00" MOVE 15 TO COND-WORD.

       69-START-MSTORERM-FILE.
           MOVE 0 TO COND-WORD.
           MOVE PRT-CODE-WA TO CODE-ARG.
           MOVE CODE-ARG TO CORPCDE OF MSFREC.
           START MSTORERM-FILE KEY IS = EXTERNALLY-DESCRIBED-KEY
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF MSF-STATUS NOT = "00" MOVE 17 TO COND-WORD.

       69-START-MVALIDPLTDATA-FILE.
           MOVE 0 TO COND-WORD.
           MOVE VALID-ARG TO VALDTAKEY OF MPFREC.
           START MVALIDPLTDATA-FILE KEY IS = EXTERNALLY-DESCRIBED-KEY
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF MPF-STATUS NOT = "00" MOVE 17 TO COND-WORD.

       69-READ-MVALIDPLTDATA-FILE.
           MOVE 0 TO COND-WORD.
           READ MVALIDPLTDATA-FILE NEXT INTO BUF-MVALIDPLTDATA
               AT END    MOVE 15 TO COND-WORD.
           IF MVF-STATUS NOT = "00" MOVE 15 TO COND-WORD.

       69-START-MVALIDUM-FILE.
           MOVE 0 TO COND-WORD.
           MOVE ARG-UM-S TO VALIDUM OF MVFREC.
           START MVALIDUM-FILE KEY IS = EXTERNALLY-DESCRIBED-KEY
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF MVF-STATUS NOT = "00" MOVE 17 TO COND-WORD.

       69-START-PERSONNEL-FILE.
           MOVE 0 TO COND-WORD.
           MOVE ORIG-WA TO PERCCNUM OF PFREC.
           START PERSONNEL-FILE KEY IS = EXTERNALLY-DESCRIBED-KEY
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF PF-STATUS NOT = "00" MOVE 17 TO COND-WORD.

       69-READ-WO-BASIC-FILE.
           MOVE 0 TO COND-WORD.
           READ WO-BASIC-FILE INTO WO-BASIC-DATA
               INVALID KEY    MOVE 15 TO COND-WORD.
           IF WBF-STATUS NOT = "00" MOVE 15 TO COND-WORD.

       69-START-WO-BASIC-FILE.
           MOVE 0 TO COND-WORD.
           MOVE WORK-ORDER-NO TO WONUM OF WBFREC.
           START WO-BASIC-FILE KEY IS = EXTERNALLY-DESCRIBED-KEY
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF WBF-STATUS NOT = "00" MOVE 17 TO COND-WORD.

       69-READ-WO-PARTS-FILE.
           MOVE 0 TO COND-WORD.
           READ WO-PARTS-FILE NEXT INTO WO-PARTS-DATA
               AT END MOVE 15 TO COND-WORD.
           IF WORK-ORDER-NO NOT = WONUM OF WPFDREC
               MOVE 15 TO COND-WORD.
           IF WPFD-STATUS NOT = "00" MOVE 15 TO COND-WORD.

       69-START-WO-PARTS-FILE.
           MOVE 0 TO COND-WORD.
           MOVE WORK-ORDER-NO TO WONUM OF WPFDREC.
           START WO-PARTS-FILE KEY IS = EXTERNALLY-DESCRIBED-KEY
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF WPFD-STATUS NOT = "00" MOVE 17 TO COND-WORD.

       69-WRITE-WO-PARTS-FILE.
           MOVE 0 TO COND-WORD.
           WRITE WPFDREC FROM WO-PARTS-DATA
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF WPFD-STATUS NOT = "00" MOVE 17 TO COND-WORD.

       69-READ-WO-PLANNED-FILE.
           MOVE 0 TO COND-WORD.
           READ WO-PLANNED-FILE INTO WO-PLANNED-DATA
               INVALID KEY    MOVE 15 TO COND-WORD.
           IF WPF-STATUS NOT = "00" MOVE 15 TO COND-WORD.

       69-START-WO-PLANNED-FILE.
           MOVE 0 TO COND-WORD.
           MOVE WORK-ORDER-NO TO WONUM OF WPFREC.
           START WO-PLANNED-FILE KEY IS = EXTERNALLY-DESCRIBED-KEY
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF WPF-STATUS NOT = "00" MOVE 17 TO COND-WORD.

       98-SCREEN-READ.
           READ DISPLAY-FILE FORMAT IS VIEW-CFNAME
               INDIC IS INDICS.
           ACCEPT IOFEEDBACK FROM I-O-FEEDBACK-AREA.
           MOVE ALL B"0" TO INDICS.
           IF DSPLY-STATUS NOT = "00"
               MOVE 3 TO VIEW-LASTKEY
           ELSE
           MOVE FUNCTION-NUM TO VIEW-LASTKEY.

       98A-SCREEN-READ.
           READ DISPLAY-FILE TERMINAL IS TERMINAL-ID
               INDIC IS INDICS
                  NO DATA MOVE DSPLY-STATUS TO DSPLY-STATUS.
           MOVE ALL B"0" TO INDICS.

       99-SCREEN-WRITE.
           WRITE DSPLY-REC FORMAT IS VIEW-CFNAME
               INDIC IS INDICS.
           MOVE ALL B"0" TO INDICS.

       998-BLOWUP.
           MOVE "TMODMADD" TO BU-PGM-NAME.
           CALL "TBLOWUP" USING BLOWUP-BASE BU-PGM-NAME STATUS-AREA
                            VIEW-COMAREA DUMMY-KSAM-STAT
                            BU-DISPLAY-MSG BU-DISPLAY-FLDS.

       999-CATREAD.
           MOVE SPACES TO ERROR-BUFFER.
           CALL "CCATREAD" USING CATREAD-PARMS.
           MOVE CATREAD-MSG-TEXT TO ERROR-BUFFER.
       999-CATREAD-EXIT.
           EXIT.
