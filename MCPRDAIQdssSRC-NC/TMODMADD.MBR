               MOVE 66071 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE ERROR-BUFFER TO MATL-CMD-LINE
                                    MATL-CMD-LINE-2
           ELSE
           IF PRT-STATUS-1-WA = "M"
               IF PRT-CODE-WA = SPACES
                   IF A-C-WA = "A"
                        MOVE "FADDMUA2" TO VIEW-CFNAME
                        MOVE 66077 TO CATREAD-MSG-NUMBER
                        PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                        MOVE ERROR-BUFFER TO MATL-CMD-LINE
                                             MATL-CMD-LINE-2
                   ELSE
                   MOVE "FADDMUN2" TO VIEW-CFNAME
                   MOVE 66078 TO CATREAD-MSG-NUMBER
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE ERROR-BUFFER TO MATL-CMD-LINE
                                        MATL-CMD-LINE-2
               ELSE
               IF A-C-WA = "A"
                   MOVE "FADDMCA2" TO VIEW-CFNAME
                   MOVE 66074 TO CATREAD-MSG-NUMBER
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE ERROR-BUFFER TO MATL-CMD-LINE
                                        MATL-CMD-LINE-2
               ELSE
               MOVE "FADDMCO2" TO VIEW-CFNAME
               MOVE 66076 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE ERROR-BUFFER TO MATL-CMD-LINE
                                    MATL-CMD-LINE-2
           ELSE
           IF PRT-STATUS-1-WA = "S"
               MOVE "FADDMCO2" TO VIEW-CFNAME
               MOVE 66076 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE ERROR-BUFFER TO MATL-CMD-LINE
                                    MATL-CMD-LINE-2
           ELSE
           MOVE "FADDMAT2" TO VIEW-CFNAME
           MOVE 66071 TO CATREAD-MSG-NUMBER
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
           MOVE ERROR-BUFFER TO MATL-CMD-LINE
                                MATL-CMD-LINE-2.
           MOVE 30077 TO CATREAD-MSG-NUMBER.
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
           MOVE ERROR-BUFFER TO MESSAGE-WA
                                MESSAGE-WA-2.
       62-RAS-CONT.
           MOVE EDIT-ERROR TO MATL-ERR-LINE
                              MATL-ERR-LINE-2.
           PERFORM 623-PUT-BUFFER.
           PERFORM 99-SCREEN-WRITE.
           PERFORM 98-SCREEN-READ.
           MOVE SPACES TO ERROR-BUFFER EDIT-ERROR.
           PERFORM 623-GET-BUFFER.
           IF VIEW-LASTKEY = 1 OR 3 GO TO 2-EOJ.
           IF VIEW-LASTKEY = 2
               IF VIEW-CFNAME = "FADDMUA2" OR "FADDMCA2"
                   OR "FADMUA2L" OR "FADMCA2L"
                   MOVE 35126 TO CATREAD-MSG-NUMBER
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE ERROR-BUFFER TO EDIT-ERROR
                   MOVE TRUE-VAL TO INDS (99)
                   GO TO 62-RAS-CONT
               ELSE
               MOVE SPACES TO WO-PARTS-DATA
               PERFORM 627-SAVE-REQUIRED-DATA
               PERFORM 69-WRITE-WO-PARTS-FILE
               PERFORM 624-CK-AND-RECORD-ERROR
               MOVE 35098 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE ERROR-BUFFER TO MESSAGE-WA
                                    MESSAGE-WA-2
               PERFORM 623-PUT-BUFFER
               MOVE TRUE-VAL TO INDS (98)
               PERFORM 99-SCREEN-WRITE
               PERFORM 98A-SCREEN-READ
               CALL "CLPAUSE2"
               ADD 1 TO CHAIN-CTR
               MOVE CHAIN-CTR TO ITEM-NO-WA
                                 ITEM-NO-WA-2
               PERFORM 620-SET-ADD-SCREEN
               MOVE 31042 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE ERROR-BUFFER TO MESSAGE-WA
                                    MESSAGE-WA-2
               MOVE SAVE-EXPCLASS TO ADDL-DATA-WA
                                     ADDL-DATA-WA-2
               MOVE ENG-PL-SCHD-ID TO ORIG-WA
                                      ORIG-WA-2
               PERFORM 620-SET-SUB-PRIME
               GO TO 62-READ-ADD-SCREEN.
           IF VIEW-LASTKEY = 4
               IF MPLTINFO-PCPR-SW = "Y"
                   MOVE "FADMATLL" TO VIEW-CFNAME
                   MOVE 29041 TO CATREAD-MSG-NUMBER
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE ERROR-BUFFER TO MESSAGE-WA
                                        MESSAGE-WA-2
