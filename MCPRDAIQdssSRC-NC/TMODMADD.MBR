                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE ERROR-BUFFER TO MATL-CMD-LINE
                                        MATL-CMD-LINE-2
               ELSE
               IF PRT-STATUS-1-WA = "S"
                   MOVE "FADMCO2L" TO VIEW-CFNAME
                   MOVE 66076 TO CATREAD-MSG-NUMBER
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE ERROR-BUFFER TO MATL-CMD-LINE
                                        MATL-CMD-LINE-2
               ELSE
