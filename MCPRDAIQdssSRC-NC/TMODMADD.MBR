       LINKAGE SECTION.
       01  DBPARAMETERS.       COPY DBPARMS OF COPYLIB.
       01  WORK-ORDER-NO                     PIC X(10).
       COPY VCOMLINK OF COPYLIB.
       PROCEDURE DIVISION USING DBPARAMETERS WORK-ORDER-NO
                            VIEW-COMAREA.
       START-EXECUTING.
           PERFORM 1-HSK.
           PERFORM 6-MAIN THRU 6-MAIN-EXIT.
       2-EOJ.
           CLOSE DISPLAY-FILE.
           CLOSE MCLASS-FILE
           CLOSE MPLTINFO-FILE.
           CLOSE MSTORERM-FILE.
           CLOSE MVALIDUM-FILE.
           CLOSE MVALIDPLTDATA-FILE.
           CLOSE PERSONNEL-FILE.
           CLOSE WO-LAST-NUM-USED.
           CLOSE WO-BASIC-FILE.
           CLOSE WO-PLANNED-FILE.
           CLOSE WO-PARTS-FILE.
           GOBACK.
       1-HSK.
           MOVE SPACES TO WO-BASIC-DATA.
           MOVE SPACES TO WO-PLANNED-DATA.
           MOVE SPACES TO WO-PARTS-DATA.
           MOVE SPACES TO BASE-DUMMY BASE-MMISA BASE-STORES.
           OPEN I-O   DISPLAY-FILE.
           OPEN INPUT MCLASS-FILE.
           OPEN INPUT MPLTINFO-FILE.
           OPEN INPUT MSTORERM-FILE.
           OPEN INPUT MVALIDUM-FILE.
           OPEN INPUT MVALIDPLTDATA-FILE.
           OPEN INPUT PERSONNEL-FILE.
           OPEN INPUT WO-LAST-NUM-USED.
           OPEN I-O WO-BASIC-FILE.
           OPEN I-O WO-PLANNED-FILE.
           OPEN I-O WO-PARTS-FILE.
           MOVE 0 TO COND-WORD.
           MOVE 1 TO ARG-NO
           READ WO-LAST-NUM-USED INTO LAST-WO-BUFF
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF WLNU-STATUS NOT = "00" MOVE 17 TO COND-WORD.
           IF COND-WORD = 17 MOVE 1 TO DATE-FLAG-SW.
           MOVE 1 TO DATE-MODE.
           MOVE DATE-FLAG-SW TO DATE-CODE.
           CALL "TDATECHK" USING DATE-CHECK-AREA.
           MOVE DATE-SLASH-OUT TO CUR-DATE-WA.
           IF DATE-FLAG = 3
               MOVE CUR-DATE-MD TO CUR-DATE-CHECK-DM
               MOVE CUR-DATE-DM TO CUR-DATE-CHECK-MD
           ELSE
           MOVE CUR-DATE-MD TO CUR-DATE-CHECK-MD
           MOVE CUR-DATE-DM TO CUR-DATE-CHECK-DM.
           MOVE CUR-DATE-YY TO CUR-DATE-CHECK-YY.
           IF CUR-DATE-CHECK-YY > "70"
               MOVE "19" TO CUR-DATE-CHECK-CC
           ELSE
           MOVE "20" TO CUR-DATE-CHECK-CC.
           CALL "TPWORD" USING PASSWORD-INFORMATION.
           IF PASSWORD-FLAG = "N"
               MOVE "  PWORD" TO BLOWUP-BASE
               MOVE "FAILED PASSWORD CHECK - TMODMADD"
                   TO BU-DISPLAY-MSG
               PERFORM 998-BLOWUP.
           MOVE SPACES TO DBPARAMETERS-STORES.
           MOVE "RQGB" TO MPLTINFO-ARG.
           PERFORM 69-START-MPLTINFO-FILE.
           IF COND-WORD = 17
               MOVE "Y" TO MPLT-PRINT-WO-REQPK
               MOVE "N" TO MPLT-WOAP-TO-CUT-REQ
               MOVE "N" TO MPLT-WOAP-TO-APP-REQ
               MOVE MPLTINFO-RQGB TO REQ-GLOBALS
           ELSE
           PERFORM 69-READ-MPLTINFO-FILE
           IF COND-WORD = 15
               MOVE "Y" TO MPLT-PRINT-WO-REQPK
               MOVE "N" TO MPLT-WOAP-TO-CUT-REQ
               MOVE "N" TO MPLT-WOAP-TO-APP-REQ
               MOVE MPLTINFO-RQGB TO REQ-GLOBALS
           ELSE
           MOVE MPLTINFO-RQGB TO REQ-GLOBALS.
           CALL "TESCSEQ" USING ESC-NAME.
           ACCEPT MC-LOCAL-DATA-AREA FROM LOCAL-DATA-AREA.

      *-----RETRIEVE PDER TO DETERMINE IF NOTIFY USERID IS REQUIRED
           MOVE "PDER"        TO MPLTINFO-ARG.
           PERFORM 69-START-MPLTINFO-FILE.
           IF COND-WORD = 17
               MOVE "N"       TO SAVE-PDER-USERID
           ELSE
           PERFORM 69-READ-MPLTINFO-FILE
           IF COND-WORD = 15
               MOVE "N"       TO SAVE-PDER-USERID
           ELSE
               MOVE MPLTINFO-PDER-USERID TO SAVE-PDER-USERID.

      *********************************************************
      *    THE PCPR-SW RETRIEVED FROM MPLTINFO IN THE LOGIC   *
      *    BELOW IS USED TO FORCE THE COMPANY CODE TO BE      *
      *    ENTERED BY THE USER. THIS LOGIC WAS ADDED 8-31-92  *
      *    TO FACILITATE DATA FLOW BETWEEN GAS AND CSIS PER   *
      *    LUX REQUEST #6253                                  *
      *********************************************************
           MOVE "PCPR"        TO MPLTINFO-ARG.
           PERFORM 69-START-MPLTINFO-FILE.
           IF COND-WORD = 17
               MOVE "N"       TO MPLTINFO-PCPR-SW
           ELSE
           PERFORM 69-READ-MPLTINFO-FILE
           IF COND-WORD = 15
               MOVE "N"       TO MPLTINFO-PCPR-SW.

       6-MAIN.
           MOVE 0 TO ERR-SW CHAIN-CTR.
           MOVE 0 TO NON-STORES-SW SMD-SW.
           MOVE SPACES TO SAVE-REQ-INFO MATL-WORKAREA
               MATL-WORKAREA-2 SAVE-PRIME-WA SAVE-SUB-WA.
           MOVE 0 TO SAVE-ACT-QTY.
           MOVE SPACES TO WO-BASIC-DATA WO-PLANNED-DATA.
           PERFORM 60-GET-WO-DATA THRU 60-GWD-EXIT.
           IF WO-NUM = SPACES
               MOVE WO-NUM-PLANNED  TO WO-NUM-WA
                                       WO-NUM-WA-2
               MOVE DESCRIPTION-1-P TO DESCRIPTION-WA
                                       DESCRIPTION-WA-2
               MOVE APPROVAL-CODE-P TO A-C-WA
                                       A-C-WA-2
               MOVE WO-STATUS-P     TO WO-STATUS-WA
                                       WO-STATUS-WA-2
               MOVE EQUIP-NUM-P     TO EQPNUM-WA
                                       EQPNUM-WA-2
               MOVE ZONE-P          TO ZONE-WA
                                       ZONE-WA-2
               MOVE DEPT-P          TO SAVE-DEPT
               MOVE EXP-CLASS-P     TO ADDL-DATA-WA SAVE-EXPCLASS
                                       ADDL-DATA-WA-2
               MOVE ENG-PL-SCHD-ID  TO ORIG-WA
                                       ORIG-WA-2
               IF DATE-SCHD = "      "
                   NEXT SENTENCE
               ELSE
               MOVE 4               TO DATE-MODE
               MOVE DATE-SCHD       TO DATE-VALIDATE-IN
               CALL "TDATECHK" USING DATE-CHECK-AREA
               MOVE DATE-SLASH-OUT  TO DATE-SCHD-WA
                                       DATE-SCHD-WA-2
               MOVE TIME-SCHD-P-HH  TO TIME-SCHD-HH-WA
                                       TIME-SCHD-HH-WA-2
               MOVE ":"             TO TIME-COLON-WA
                                       TIME-COLON-WA-2
               MOVE TIME-SCHD-P-MM  TO TIME-SCHD-MM-WA
                                       TIME-SCHD-WA-2
           ELSE
           MOVE WO-NUM              TO WO-NUM-WA
                                       WO-NUM-WA-2
           MOVE APPROVAL-CODE       TO A-C-WA
                                       A-C-WA-2
           MOVE DESCRIPTION-1       TO DESCRIPTION-WA
                                       DESCRIPTION-WA-2
           MOVE WO-STATUS           TO WO-STATUS-WA
                                       WO-STATUS-WA-2
           MOVE EQUIP-NUM           TO EQPNUM-WA
                                       EQPNUM-WA-2
           MOVE DEPT                TO SAVE-DEPT
           MOVE EXP-CLASS           TO ADDL-DATA-WA SAVE-EXPCLASS
                                       ADDL-DATA-WA-2
           MOVE ENG-PL-SCHD-ID      TO ORIG-WA
                                       ORIG-WA-2
           MOVE ZONE OF WO-BASIC-DATA TO ZONE-WA
                                         ZONE-WA-2.

           MOVE "M"                 TO SERVICE-FLAG
                                       SERVICE-FLAG-2.
           MOVE SPACES              TO WO-PARTS-DATA.
           PERFORM 61-RETRIEVE-NEXT-ITEM THRU 61-RNI-EXIT.
           MOVE CHAIN-CTR           TO ITEM-NO-WA
                                       ITEM-NO-WA-2.
           PERFORM 62-ADD-ITEMS THRU 62-AI-EXIT.
       6-MAIN-EXIT.    EXIT.
       60-GET-WO-DATA.
           PERFORM 69-START-WO-BASIC-FILE.
           IF COND-WORD = 17
             GO TO 60-CHECK-WO-PLANNED
           ELSE
             MOVE "Y" TO VERBAL-WO-SWITCH.
           PERFORM 69-READ-WO-BASIC-FILE.
           IF COND-WORD = 15
             GO TO 60-CHECK-WO-PLANNED
           ELSE
             MOVE "Y" TO VERBAL-WO-SWITCH.
           GO TO 60-GWD-EXIT.
       60-CHECK-WO-PLANNED.
           PERFORM 69-START-WO-PLANNED-FILE.
           IF COND-WORD = 17 GO TO 60-GWD-EXIT.
           PERFORM 69-READ-WO-PLANNED-FILE.
       60-GWD-EXIT.    EXIT.
       61-RETRIEVE-NEXT-ITEM.
           PERFORM 69-START-WO-PARTS-FILE.
           IF COND-WORD = 17
               MOVE 47004 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE ERROR-BUFFER TO MESSAGE-WA
                                    MESSAGE-WA-2
               MOVE 1 TO ERR-SW
               GO TO 61-RNI-EXIT.
       61-RNI-LOOP.
           ADD 1 TO CHAIN-CTR.
           PERFORM 69-READ-WO-PARTS-FILE.
           IF COND-WORD = 15 GO TO 61-RNI-EXIT.
           GO TO 61-RNI-LOOP.
       61-RNI-EXIT.    EXIT.
       62-ADD-ITEMS.
           IF EXP-CLASS = SPACES
               MOVE EXP-CLASS-P TO ADDL-DATA-WA
                                   ADDL-DATA-WA-2
                                   SAVE-ADDL-DATA
           ELSE
           MOVE EXP-CLASS       TO ADDL-DATA-WA
                                   ADDL-DATA-WA-2
                                   SAVE-ADDL-DATA.
           MOVE ENG-PL-SCHD-ID  TO ORIG-WA
                                   ORIG-WA-2
           PERFORM 620-SET-SUB-PRIME.
           MOVE ZEROES          TO PRT-UP-WA
                                   PRT-UP-WA-2.
           MOVE 31042 TO CATREAD-MSG-NUMBER.
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
           MOVE ERROR-BUFFER    TO MESSAGE-WA
                                   MESSAGE-WA-2.
           IF CHAIN-CTR = 0 MOVE 1 TO CHAIN-CTR.
           MOVE CHAIN-CTR       TO ITEM-NO-WA
                                   ITEM-NO-WA-2.
           IF MPLTINFO-PCPR-SW = "Y"
                MOVE "FADMATLL" TO VIEW-CFNAME
           ELSE
           MOVE "FADDMATL" TO VIEW-CFNAME.
       62-READ-ADD-SCREEN.
           IF MATL-CMD-LINE = SPACES
               MOVE 66072 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE ERROR-BUFFER TO MATL-CMD-LINE.
           MOVE EDIT-ERROR TO MATL-ERR-LINE
                              MATL-ERR-LINE-2.
           PERFORM 623-PUT-BUFFER.
           PERFORM 99-SCREEN-WRITE.
           PERFORM 98-SCREEN-READ.
           MOVE SPACES TO ERROR-BUFFER EDIT-ERROR.
           PERFORM 623-GET-BUFFER.
           IF VIEW-LASTKEY = 1 OR 3 GO TO 2-EOJ.
           IF VIEW-LASTKEY = 2
                IF ENG-PL-SCHD-ID = SPACES
                   IF ORIG-WA = SPACES
                       MOVE SPACES    TO MATL-DATA MATL-CMD-LINE
                                         MATL-DATA-2 MATL-CMD-LINE-2
                       MOVE ZEROES    TO PRT-UP-WA
                                         PRT-UP-WA-2
                       MOVE CHAIN-CTR TO ITEM-NO-WA
                                         ITEM-NO-WA-2
                       GO TO 62-ADD-ITEMS
                   ELSE
                   MOVE ORIG-WA       TO ENG-PL-SCHD-ID
                   MOVE SPACES        TO MATL-DATA MATL-CMD-LINE
                                         MATL-DATA-2 MATL-CMD-LINE-2
                   MOVE ZEROES        TO PRT-UP-WA
                                         PRT-UP-WA-2
                   MOVE CHAIN-CTR     TO ITEM-NO-WA
                                         ITEM-NO-WA-2
                   GO TO 62-ADD-ITEMS
                ELSE
                MOVE SPACES           TO MATL-DATA MATL-CMD-LINE
                                         MATL-DATA-2 MATL-CMD-LINE-2
                MOVE ZEROES           TO PRT-UP-WA
                                         PRT-UP-WA-2
                MOVE CHAIN-CTR        TO ITEM-NO-WA
                                         ITEM-NO-WA-2
                GO TO 62-ADD-ITEMS.
           IF VIEW-LASTKEY = 7
               MOVE 1 TO SMD-SW
               CALL "TMATHELP" USING DBPARAMETERS VIEW-COMAREA
               MOVE 0 TO VIEW-LASTKEY
               PERFORM 620-SET-ADD-SCREEN
               GO TO 62-READ-ADD-SCREEN
           ELSE
           IF VIEW-LASTKEY = 8
               IF ORIG-WA = "    "
                   MOVE ENG-PL-SCHD-ID TO ORIG-WA
                   CALL "SCOPYREQ" USING MATL-WORKAREA
                   MOVE MATL-WORKAREA TO MATL-WORKAREA-2
                   GO TO 62-READ-ADD-SCREEN
               ELSE
               CALL "SCOPYREQ" USING MATL-WORKAREA
               MOVE MATL-WORKAREA TO MATL-WORKAREA-2
               GO TO 62-READ-ADD-SCREEN.
           IF VIEW-LASTKEY NOT = 0 GO TO 62-AI-EXIT.
           IF MATL-DATA = SPACES
               MOVE 35097 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE ERROR-BUFFER TO EDIT-ERROR
               MOVE TRUE-VAL TO INDS (1) INDS (99)
               GO TO 62-READ-ADD-SCREEN.
           IF PRT-STATUS-WA = "  "
               MOVE 42020 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE ERROR-BUFFER TO EDIT-ERROR
               MOVE TRUE-VAL TO INDS (1) INDS (99)
               GO TO 62-READ-ADD-SCREEN.
           IF PRT-STATUS-1-WA = "M" OR "S" OR "X"
               NEXT SENTENCE
           ELSE
           MOVE 35033 TO CATREAD-MSG-NUMBER
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
           MOVE ERROR-BUFFER TO EDIT-ERROR
           MOVE TRUE-VAL TO INDS (1) INDS (99)
           GO TO 62-READ-ADD-SCREEN.
           IF PRT-STATUS-1-WA = "X" OR "S"
               MOVE SPACES TO PRIME-WA
                              PRIME-WA-2
           ELSE
           IF PRIME-WA = "   "
               MOVE 42045 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE ERROR-BUFFER TO EDIT-ERROR
               MOVE TRUE-VAL TO INDS (2) INDS (99)
               GO TO 62-READ-ADD-SCREEN.
           IF PRT-STATUS-1-WA = "M"
               IF WO-STATUS-P = "CW" OR "DW" OR "FF"
                   MOVE 39006 TO CATREAD-MSG-NUMBER
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE ERROR-BUFFER TO EDIT-ERROR
                   MOVE TRUE-VAL TO INDS (1) INDS (99)
                   GO TO 62-READ-ADD-SCREEN
               ELSE
               IF WO-STATUS = "CW" OR "DW" OR "FF"
                   MOVE 39006 TO CATREAD-MSG-NUMBER
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE ERROR-BUFFER TO EDIT-ERROR
                   MOVE TRUE-VAL TO INDS (1) INDS (99)
                   GO TO 62-READ-ADD-SCREEN.
           PERFORM 626-PCPR-EDITS THRU 626-PE-X.
           IF INDS (99) = TRUE-VAL
               MOVE ERROR-BUFFER TO EDIT-ERROR
               GO TO 62-READ-ADD-SCREEN.
           IF ORIG-WA = "    "
               MOVE 41015 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE ERROR-BUFFER TO EDIT-ERROR
               MOVE TRUE-VAL TO INDS (5) INDS (99)
               GO TO 62-READ-ADD-SCREEN.
           MOVE ORIG-WA TO ENG-PL-SCHD-ID.
           PERFORM 69-START-PERSONNEL-FILE.
           IF COND-WORD = 17
               MOVE 41001 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE ERROR-BUFFER TO EDIT-ERROR
               MOVE TRUE-VAL TO INDS (5) INDS (99)
               GO TO 62-READ-ADD-SCREEN.

      * FOR SAP REQ TYPE MUST BE S-SERVICE OR M-MATERIAL OR R-REPAIR
           IF SERVICE-FLAG = "S" OR "M" OR "R"
               NEXT SENTENCE
           ELSE
               MOVE 19049 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE ERROR-BUFFER TO EDIT-ERROR
               MOVE TRUE-VAL TO INDS (27) INDS (99)
               GO TO 62-READ-ADD-SCREEN.

           IF DATE-REQD-WA = "      "
               MOVE 30020 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE ERROR-BUFFER TO EDIT-ERROR
               MOVE TRUE-VAL TO INDS (6) INDS (99)
               GO TO 62-READ-ADD-SCREEN
           ELSE
           IF DATE-FLAG = 3
               IF DATE-REQD-MD-WA > 00 AND < 32
                   IF DATE-REQD-DM-WA > 00 AND < 13
                       IF DATE-REQD-YY-WA IS NUMERIC
                           NEXT SENTENCE
                       ELSE
                       MOVE 35032 TO CATREAD-MSG-NUMBER
                       PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                       MOVE ERROR-BUFFER TO EDIT-ERROR
                       MOVE TRUE-VAL TO INDS (8) INDS (99)
                       GO TO 62-READ-ADD-SCREEN
                   ELSE
                   MOVE 35031 TO CATREAD-MSG-NUMBER
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE ERROR-BUFFER TO EDIT-ERROR
                   MOVE TRUE-VAL TO INDS (7) INDS (99)
                   GO TO 62-READ-ADD-SCREEN
               ELSE
               MOVE 35030 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE ERROR-BUFFER TO EDIT-ERROR
               MOVE TRUE-VAL TO INDS (6) INDS (99)
               GO TO 62-READ-ADD-SCREEN
           ELSE
           IF DATE-REQD-MD-WA > 00 AND < 13
               IF DATE-REQD-DM-WA > 00 AND < 32
                   IF DATE-REQD-YY-WA IS NUMERIC
                       NEXT SENTENCE
                   ELSE
                   MOVE 35032 TO CATREAD-MSG-NUMBER
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE ERROR-BUFFER TO EDIT-ERROR
                   MOVE TRUE-VAL TO INDS (8) INDS (99)
                   GO TO 62-READ-ADD-SCREEN
               ELSE
               MOVE 35030 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE ERROR-BUFFER TO EDIT-ERROR
               MOVE TRUE-VAL TO INDS (7) INDS (99)
               GO TO 62-READ-ADD-SCREEN
           ELSE
           MOVE 35031 TO CATREAD-MSG-NUMBER
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
           MOVE ERROR-BUFFER TO EDIT-ERROR
           MOVE TRUE-VAL TO INDS (6) INDS (99)
           GO TO 62-READ-ADD-SCREEN.
           IF DATE-FLAG = 3
               MOVE DATE-REQD-MD-WA TO IDRC-DM
               MOVE DATE-REQD-DM-WA TO IDRC-MD
               MOVE DATE-REQD-YY-WA TO IDRC-YY
           ELSE
           MOVE DATE-REQD-MD-WA TO IDRC-MD
           MOVE DATE-REQD-DM-WA TO IDRC-DM
           MOVE DATE-REQD-YY-WA TO IDRC-YY.
           IF IDRC-YY > "70"
               MOVE "19" TO IDRC-CC
           ELSE
           MOVE "20" TO IDRC-CC.
           IF INPUT-DATE-REQD-CHECK-CN < CUR-DATE-CHECK-CN
               MOVE 30022 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE ERROR-BUFFER TO EDIT-ERROR
               MOVE TRUE-VAL TO INDS (6) INDS (99)
               GO TO 62-READ-ADD-SCREEN.
           IF PRT-QUANT-WA = "     "
               MOVE 43003 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE ERROR-BUFFER TO EDIT-ERROR
               MOVE TRUE-VAL TO INDS (11) INDS (99)
               GO TO 62-READ-ADD-SCREEN
      *--- REARRANGED FOLLOWING STATEMENTS SO A CHECK FOR NUMERIC
      *--- QUANTITY COULD BE ADDED.     04/14/1995
      *    IF PRT-QUANT-WA-9 NUMERIC
      *        MOVE PRT-QUANT-WA TO QTY-WA
      *        MOVE QTY-BYTE-9 TO QTY-WS-5
      *        MOVE QTY-WS-5 TO QTY-BYTE-9
      *        MOVE QTY-BYTE-9 TO PRT-QUANT-WA-9
      *                           PRT-QUANT-WA-9-2
           ELSE
               MOVE PRT-QUANT-WA TO QTY-WA
               PERFORM 621-RIGHT-ADJUST-QTY THRU 621-RAQ-EXIT
      *------- CHECK TO SEE IF QUANTITY IS NUMERIC.
               IF QTY-BYTE-9 NOT NUMERIC
                   MOVE 43003 TO CATREAD-MSG-NUMBER
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE ERROR-BUFFER TO EDIT-ERROR
                   MOVE TRUE-VAL TO INDS (11) INDS (99)
                   GO TO 62-READ-ADD-SCREEN
               ELSE
                   MOVE QTY-BYTE-9 TO PRT-QUANT-WA-9
                                      PRT-QUANT-WA-9-2
                   MOVE PRT-QUANT-WA TO QTY-WA.
           IF PRT-QUANT-WA-9 = 0
               MOVE 43001 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE ERROR-BUFFER TO EDIT-ERROR
               MOVE TRUE-VAL TO INDS (11) INDS (99)
               GO TO 62-READ-ADD-SCREEN.
           IF PRT-CODE-WA = SPACES
               IF PRT-STATUS-1-WA = "S"
                   MOVE 42044 TO CATREAD-MSG-NUMBER
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE ERROR-BUFFER TO EDIT-ERROR
                   MOVE TRUE-VAL TO INDS (13) INDS (99)
                   GO TO 62-READ-ADD-SCREEN
               ELSE
               IF PRT-STATUS-1-WA = "M"
                   IF PRT-UNIT-MEAS-WA = SPACES
                       MOVE 47011 TO CATREAD-MSG-NUMBER
                       PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                       MOVE ERROR-BUFFER TO EDIT-ERROR
                       MOVE TRUE-VAL TO INDS (12) INDS (99)
                       GO TO 62-READ-ADD-SCREEN
                   ELSE
                   IF PRT-UP-WA = SPACES OR ZEROES
                       MOVE 47012 TO CATREAD-MSG-NUMBER
                       PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                       MOVE ERROR-BUFFER TO EDIT-ERROR
                       MOVE TRUE-VAL TO INDS (14) INDS (99)
                       GO TO 62-READ-ADD-SCREEN
                   ELSE
                   IF PRIME-WA = SPACES
                       MOVE 42045 TO CATREAD-MSG-NUMBER
                       PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                       MOVE ERROR-BUFFER TO EDIT-ERROR
                       MOVE TRUE-VAL TO INDS (2) INDS (99)
                       GO TO 62-READ-ADD-SCREEN
                   ELSE
                   IF SUB-WA = SPACES
                       MOVE 45040 TO CATREAD-MSG-NUMBER
                       PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                       MOVE ERROR-BUFFER TO EDIT-ERROR
                       MOVE TRUE-VAL TO INDS (3) INDS (99)
                       GO TO 62-READ-ADD-SCREEN
                   ELSE
                   IF PRT-DESC-WA = SPACES
                       MOVE 30076 TO CATREAD-MSG-NUMBER
                       PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                       MOVE ERROR-BUFFER TO EDIT-ERROR
                       MOVE TRUE-VAL TO INDS (19) INDS (99)
                       GO TO 62-READ-ADD-SCREEN
                   ELSE
                   NEXT SENTENCE
               ELSE
               IF PRT-UNIT-MEAS-WA = SPACES
                   MOVE 47011 TO CATREAD-MSG-NUMBER
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE ERROR-BUFFER TO EDIT-ERROR
                   MOVE TRUE-VAL TO INDS (12) INDS (99)
                   GO TO 62-READ-ADD-SCREEN
               ELSE
               IF PRT-UP-WA = SPACES OR ZEROES
                   MOVE 47012 TO CATREAD-MSG-NUMBER
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE ERROR-BUFFER TO EDIT-ERROR
                   MOVE TRUE-VAL TO INDS (14) INDS (99)
                   GO TO 62-READ-ADD-SCREEN
               ELSE
               IF PRT-DESC-WA = SPACES
                   MOVE 30076 TO CATREAD-MSG-NUMBER
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE ERROR-BUFFER TO EDIT-ERROR
                   MOVE TRUE-VAL TO INDS (19) INDS (99)
                   GO TO 62-READ-ADD-SCREEN
               ELSE
               IF ADDL-INFO-WA = SPACES
                   IF SUGG-VENDOR-WA = SPACES
                       NEXT SENTENCE
                   ELSE
                   MOVE SPACES TO SUGG-VENDOR-WA
                                  SUGG-VENDOR-WA-2
               ELSE
               MOVE SPACES     TO ADDL-INFO-WA
                                  ADDL-INFO-WA-2
               MOVE SPACES     TO SUGG-VENDOR-WA
                                  SUGG-VENDOR-WA-2
           ELSE
           MOVE SPACES TO STORES-DATA
           MOVE PRT-CODE-WA TO CSIS-CODE
           CALL "TCODINFO" USING STORES-DATA DBPARAMETERS-STORES
           IF RET-CODE = "NF"
               MOVE 35007 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE ERROR-BUFFER TO EDIT-ERROR
               MOVE TRUE-VAL TO INDS (13) INDS (99)
               GO TO 62-READ-ADD-SCREEN
           ELSE
           MOVE DESCRIP-1 TO P-D-WA-80 (1)
                             P-D-WA-80-2 (1)
           MOVE DESCRIP-2 TO P-D-WA-80 (2)
                             P-D-WA-80-2 (2)
           MOVE DESCRIP-3 TO P-D-WA-80 (3)
                             P-D-WA-80-2 (3)
           MOVE UNIT-COST TO U-C-WA
           MOVE UC-WA-DOLS      TO PRT-UP-DOLS-WA-9
                                   PRT-UP-DOLS-WA-9-2
           MOVE UC-WA-CENTS-1-2 TO PRT-UP-CENTS-WA
                                   PRT-UP-CENTS-WA-2A
           IF RET-CODE = "NS"
               IF PRT-STATUS-1-WA = "S"
                   MOVE 29081 TO CATREAD-MSG-NUMBER
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE ERROR-BUFFER TO EDIT-ERROR
                   MOVE TRUE-VAL TO INDS (12) INDS (99)
                   GO TO 62-READ-ADD-SCREEN
               ELSE
               MOVE 1 TO NON-STORES-SW
               IF PRT-UNIT-MEAS-WA = "  "
                   MOVE UNIT-OF-MEAS TO PRT-UNIT-MEAS-WA
                                        PRT-UNIT-MEAS-WA-2
               ELSE
               NEXT SENTENCE
           ELSE
           IF PRT-UNIT-MEAS-WA = "  "
               MOVE UNIT-OF-MEAS     TO PRT-UNIT-MEAS-WA
                                        PRT-UNIT-MEAS-WA-2.
      **************************************************************
      *    THE FOLLOWING CHECK FOR VALID UNIT OF MEASURE OR        *
      *    ALTERNATE UNIT OF MEASURE FOR A CODED STOREROOM ITEM    *
      *    WAS ADDED 3-18-86                                       *
      **************************************************************
           IF PRT-CODE-WA NOT = SPACES
               PERFORM 69-START-MSTORERM-FILE
               IF COND-WORD = 17
                   MOVE 47009 TO CATREAD-MSG-NUMBER
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE ERROR-BUFFER TO EDIT-ERROR
                   MOVE TRUE-VAL TO INDS (13) INDS (99)
                   GO TO 62-READ-ADD-SCREEN
               ELSE
               PERFORM 69-READ-MSTORERM-FILE
               IF COND-WORD = 15
                   MOVE 47009 TO CATREAD-MSG-NUMBER
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE ERROR-BUFFER TO EDIT-ERROR
                   MOVE TRUE-VAL TO INDS (13) INDS (99)
                   GO TO 62-READ-ADD-SCREEN
               ELSE
               MOVE CLSS OF MSFREC TO SUB-WA
                                      SUB-WA-2
               IF PRT-UNIT-MEAS-WA = STR-UM
                   NEXT SENTENCE
               ELSE
               IF PRT-UNIT-MEAS-WA = STR-UM1 OR STR-UM2
                   IF INDS (12) = TRUE-VAL
                       NEXT SENTENCE
                   ELSE
                   MOVE 42113 TO CATREAD-MSG-NUMBER
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE ERROR-BUFFER TO EDIT-ERROR
                   MOVE TRUE-VAL TO INDS (12) INDS (99)
                   GO TO 62-READ-ADD-SCREEN
               ELSE
               MOVE 35088 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE ERROR-BUFFER TO UM-ERROR-MSG
               MOVE STR-UM TO PRIM-UM
               MOVE UM-ERROR-MSG TO EDIT-ERROR
               MOVE TRUE-VAL TO INDS (12) INDS (99)
               GO TO 62-READ-ADD-SCREEN.
      **************************************************************
      *    THE FOLLOWING CHECK AGAINST UNIT OF MEASURE WAS ADDED   *
      *    2-10-86 TO ALLOW THE USER TO INPUT AN ALTERNATE UM,     *
      *    BUT TO ACCEPT ONE IF IT IS INPUT                        *
      **************************************************************
           IF PRT-UNIT-MEAS-WA = SPACES
               MOVE UNIT-OF-MEAS TO PRT-UNIT-MEAS-WA
                                    PRT-UNIT-MEAS-WA-2.
           MOVE PRT-UNIT-MEAS-WA TO ARG-UM-S.
           PERFORM 69-START-MVALIDUM-FILE.
           IF COND-WORD = 17
               MOVE 35011 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE ERROR-BUFFER TO EDIT-ERROR
               MOVE TRUE-VAL TO INDS (12) INDS (99)
               GO TO 62-READ-ADD-SCREEN.
           MOVE PRT-UP-DOLS-WA TO UP-WA.
           PERFORM 622-RIGHT-ADJUST-UP THRU 622-RAU-EXIT.
           MOVE UP-BYTES-9 TO PRT-UP-DOLS-WA-9
                              PRT-UP-DOLS-WA-9-2.
           IF PRT-UP-CENTS-WA-1 = " " MOVE "0" TO PRT-UP-CENTS-WA-1
                                                  PRT-UP-CENTS-WA-1-2.
           IF PRT-UP-CENTS-WA-2 = " " MOVE "0" TO PRT-UP-CENTS-WA-2
                                                  PRT-UP-CENTS-WA-2-2.
           IF WO-START-STATUS = "AA" OR "AR"
               IF PRT-PM-LEVEL-WA = "  "
                   MOVE 42138 TO CATREAD-MSG-NUMBER
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE TRUE-VAL TO INDS (16) INDS (99)
                   MOVE ERROR-BUFFER TO EDIT-ERROR
                   GO TO 62-READ-ADD-SCREEN
               ELSE
               MOVE SPACES TO TWO-BYTE-WA
               MOVE PRT-PM-LEVEL-WA TO TWO-BYTE-WA
               PERFORM 622-RIGHT-ADJUST-TWO THRU 622-RAT-EXIT
               MOVE TWO-BYTE-WA TO PRT-PM-LEVEL-WA
                                   PRT-PM-LEVEL-WA-2
               IF PRT-PM-LEVEL-WA = "00"
                   MOVE 42139 TO CATREAD-MSG-NUMBER
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE ERROR-BUFFER TO EDIT-ERROR
                   MOVE TRUE-VAL TO INDS (16) INDS (99)
                   GO TO 62-READ-ADD-SCREEN.
           IF WO-START-STATUS = "AA" OR "AR"
               IF PRT-PM-FLAG-WA = "  "
                   MOVE "99" TO PRT-PM-FLAG-WA
                                PRT-PM-FLAG-WA-2
               ELSE
               MOVE PRT-PM-FLAG-WA TO TWO-BYTE-WA
               PERFORM 622-RIGHT-ADJUST-TWO THRU 622-RAT-EXIT
               MOVE TWO-BYTE-WA TO PRT-PM-FLAG-WA
                                   PRT-PM-FLAG-WA-2
               IF PRT-PM-FLAG-WA = "00"
                   MOVE "99" TO PRT-PM-FLAG-WA
               ELSE
               IF PRT-PM-FLAG-WA NOT NUMERIC
                   MOVE 42141 TO CATREAD-MSG-NUMBER
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE ERROR-BUFFER TO EDIT-ERROR
                   MOVE TRUE-VAL TO INDS (17) INDS (99)
                   GO TO 62-READ-ADD-SCREEN.

      *------EDIT NOTIFY USERID.  ONLY NEED TO DO IF STATUS IS M
           IF PRT-STATUS-1-WA = "M"
             IF DOCK-NOTIFY-WA = SPACES
               IF SAVE-PDER-USERID = "Y"
      *            *** A VALID USERID IS REQUIRED ***
                   MOVE 22027 TO CATREAD-MSG-NUMBER
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE ERROR-BUFFER TO EDIT-ERROR
                   MOVE TRUE-VAL TO INDS (26) INDS (99)
                   GO TO 62-READ-ADD-SCREEN
               END-IF
           ELSE
               CALL "MCXCHKUSR" USING DOCK-NOTIFY-WA VALID-USER
               IF VALID-USER = "N"
      *            *** A VALID USERID IS REQUIRED ***
                   MOVE 22027 TO CATREAD-MSG-NUMBER
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE ERROR-BUFFER TO EDIT-ERROR
                   MOVE TRUE-VAL TO INDS (26) INDS (99)
                   GO TO 62-READ-ADD-SCREEN
               END-IF
           END-IF.


           IF MPLTINFO-PCPR-SW = "Y"
