       IDENTIFICATION DIVISION.
       PROGRAM-ID.  TRPTBVAL.
       DATE-COMPILED.
      ************************************************************
      ** THIS PROGRAM IS THE REPORT PROGRAM FOR BVA USERS.      **
      ** IT IS MENU OPTION R205 IN THE GLOBAL MENU SYSTEM.      **
      ** IT ONLY LOOKS AT LAST MONTH'S DATA.                    **
      ************************************************************
      * 14JUN2001  DAVE PLUM
      *  INCREASED THE SIZE OF THE CC-TABLE FROM 250 TO 350.
      *
      * 06AUG2001  DAVE PLUM
      *  INCREASED THE SIZE OF THE CC-TABLE FROM 350 TO 500.
      *
      * 30APR2002  CA YODER
      *  INCREASED THE SIZE OF THE CC-TABLE FROM 500 TO 700.
      *
      *C 01/04/2010  CA YODER  2010-00142425-001
      *C UPDATED LOGIC TO RECOGNIZE THE NEW WORKORDER LETTER
      *C SUFFIXES.
      *C
       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.
       COPY SPECIALN OF COPYLIB.
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT DREQD
               ASSIGN TO DATABASE-MCFLCS2102
               ORGANIZATION IS INDEXED
               ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                   WITH DUPLICATES
               FILE STATUS IS FILE-STATUS.

           SELECT DREQITM
               ASSIGN TO DATABASE-MCFLCS2201
               ORGANIZATION IS INDEXED
               ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
               FILE STATUS IS FILE-STATUS.

           SELECT DREQQUE
               ASSIGN TO DATABASE-MCFLCS4401
               ORGANIZATION IS INDEXED
               ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                   WITH DUPLICATES
               FILE STATUS IS FILE-STATUS.

           SELECT DTRANS
               ASSIGN TO DATABASE-MCFLCA07LM
               ORGANIZATION IS INDEXED
               ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                   WITH DUPLICATES
               FILE STATUS IS FILE-STATUS.

           SELECT FPREQSLM
               ASSIGN TO DATABASE-FPREQSLM
               ORGANIZATION IS SEQUENTIAL
               ACCESS IS SEQUENTIAL
               FILE STATUS IS FILE-STATUS.

           SELECT FPSTRALM
               ASSIGN TO DATABASE-FPSTRALM
               ORGANIZATION IS SEQUENTIAL
               ACCESS IS SEQUENTIAL
               FILE STATUS IS FILE-STATUS.

           SELECT MACCOUNT-INFO
               ASSIGN TO DATABASE-MCFLCA0101
               ORGANIZATION IS INDEXED
               ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
               FILE STATUS IS FILE-STATUS.

           SELECT MATL-ACCUM
               ASSIGN TO DATABASE-MCFLCA06LM
               ORGANIZATION IS INDEXED
               ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
               FILE STATUS IS FILE-STATUS.

           SELECT MCHT-ACCTS
               ASSIGN TO DATABASE-MCFLCA0302
               ORGANIZATION IS INDEXED
               ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                   WITH DUPLICATES
               FILE STATUS IS FILE-STATUS.

           SELECT MPERSON
               ASSIGN TO DATABASE-MCFLMM0301
               ORGANIZATION IS INDEXED
               ACCESS MODE IS RANDOM
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
               FILE STATUS IS FILE-STATUS.

           SELECT MPLTINFO
               ASSIGN TO DATABASE-MCFLCS0501
               ORGANIZATION IS INDEXED
               ACCESS MODE IS RANDOM
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
               FILE STATUS IS FILE-STATUS.

           SELECT PRINT-FILE ASSIGN TO PRINTER-MCPRT.

           SELECT SORT-FILE ASSIGN TO DISK-SORTFILE.

