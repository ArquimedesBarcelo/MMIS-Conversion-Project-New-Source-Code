079900*                        ITEM-NAME ITEM-VALUE.
080000*    IF COND-WORD = 0
080100*      NEXT SENTENCE
080200*    ELSE
080300*      GO TO R-S-T-E.
080400*    CALL "DBGET" USING BASE DSET-NAME MODE5 STATUS-AREA
080500*                       ALL-ITEMS SUFFIX-TOTAL-DATA ARG-NO.
080600*    IF COND-WORD = 0
080700*      NEXT SENTENCE
080800*    ELSE
080900*      GO TO R-S-T-E.
081000*
081100*    MOVE S-LABOR-ACT TO S-LABOR-CST.
081200*    MOVE S-STORE-ACT TO S-MATER-CST.
081300*    MOVE S-PURCH-ACT TO S-PURCH-CST.
081400*
081500*    COMPUTE
081600*    S-TOTAL-CST = S-LABOR-ACT + S-STORE-ACT + S-PURCH-ACT.
081700*
081800*    COMPUTE
081900*    S-ESTIMATE  = S-LABOR-EST + S-STORE-EST + S-PURCH-EST.
082000*
082100*    RELEASE SORTF.
082200*
082300*R-S-T-E.
082400*    EXIT.
