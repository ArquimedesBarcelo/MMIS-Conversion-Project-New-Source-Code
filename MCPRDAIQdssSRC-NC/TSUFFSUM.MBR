035000 PROCEDURE DIVISION USING SCREEN-DATA.
035100 BEGIN-PROG.
           PERFORM 1-HSK.
           PERFORM 6-MAIN.
       2-EOJ.
           CLOSE DISPLAY-FILE.
           CLOSE JOBPLAN-FILE.
           CLOSE WO-LABOR-FILE.
           CLOSE WO-LAST-NUM-USED.
           CLOSE WO-PARTS-FILE.
           CLOSE WO-PLANNED-FILE.
           MOVE SPACES TO PRNTF.
           MOVE NORMAL-PRINT TO PRNTF-TYPE.
036700     WRITE PRNTF AFTER ADVANCING NEW-PAGE.
036900*    CALL "SPOOL2631'STOP" USING PRNT-FILE
037000*                                SPOOLER-NUM
037100*                                NUM-COPIES
037200*                                PRTY
037300*                                N-STATUS
037400*                                S-ERR-MSG.
           CLOSE PRNT-FILE.
           GOBACK.
       1-HSK.
           OPEN I-O    DISPLAY-FILE.
           OPEN INPUT  JOBPLAN-FILE.
           OPEN INPUT  WO-LABOR-FILE.
           OPEN INPUT  WO-LAST-NUM-USED.
           OPEN INPUT  WO-PARTS-FILE.
           OPEN INPUT  WO-PLANNED-FILE.
           MOVE 196879 TO COMPRESS-CHARS.
           MOVE 196882 TO NORMAL-CHARS.
      *    MOVE 0 TO OVRPRTF-TOFILE-NUM.
           MOVE "L " TO OVRPRTF-TOFILE-NUM-X.
      *****************************************************************
      * OVERRIDE THE PRINT FILE TO PASSED PRINT FILE NUM. IF THAT
      * DOESNT EXIST, USE DEFAULT OUTQ FROM LOCAL DATA AREA. IF THE
      * OUTQ DOESN'T EXIST, DEFAULT TO 'MCPRT' PRINT FILE (OUTQ=*JOBD
      *****************************************************************
           CALL "COVRPRT" USING OVRPRTF-PARMS.
           CALL "QCMDEXC" USING OVRPRTF-PARM1, OVRPRTF-PARM2.
041000     OPEN OUTPUT PRNT-FILE.
           MOVE MASTER-WONUM TO SUFFIX-INPUT.
           MOVE WO-STATUS    TO STATUS-INPUT.
           MOVE A-C          TO CODE-INPUT.
           MOVE EQUIPNUM     TO EQPNUM-INPUT.
           MOVE DEPT         TO DEPT-INPUT.
           MOVE ZONE         TO ZONE-INPUT.
           MOVE CLSS         TO CLASS-INPUT.
           MOVE B1           TO BI-1.
           MOVE B2           TO BI-2.
           MOVE B3           TO BI-3.
           MOVE B4           TO BI-4.
           MOVE B5           TO BI-5.
           MOVE "-"          TO BI-DASH-1 BI-DASH-2 BI-DASH-3.
           MOVE "R"          TO BI-REVNO.
           MOVE REQUEST      TO REQUEST-INPUT.
           MOVE SORT-BY      TO SORT-INPUT.
           MOVE PRNT-DEV     TO SPOOLER-NUMBER.
           MOVE SPACES       TO PRNTF.
           MOVE NORMAL-PRINT TO PRNTF-TYPE.
           IF PAPER-SZ = "N"
               MOVE COMPRESS-PRINT TO PRNTF-TYPE.
           MOVE PAPER-SZ     TO PAPER-COLS.
           MOVE LINE-PER     TO LINES-PER-INCH.
040700     MOVE SPOOLER-NUMBER TO SPOOLER-INPUT.
040800     MOVE SPOOLER-INPUT  TO SPOOLER-NUM.
040900*    CALL "SPOOL2631'START" USING N-STATUS S-ERR-MSG.
           MOVE 0 TO COND-WORD.
045000     MOVE 1 TO ARG-NO.
           READ WO-LAST-NUM-USED INTO LAST-WO-BUFF
               INVALID KEY    MOVE 17 TO COND-WORD.
045400     IF COND-WORD NOT = 0
045600         WRITE PRNTF AFTER ADVANCING NEW-PAGE
045700         MOVE "ERROR IN PROGRAM TSUFFSUM" TO PRNTF-LINE
045800         WRITE PRNTF AFTER ADVANCING 1 LINES
045900         MOVE "DBGET ERROR IN PAR HOUSE" TO PRNTF-LINE
046000         WRITE PRNTF AFTER ADVANCING 1 LINES
046100         MOVE COND-WORD TO PRNTF-LINE
046200         WRITE PRNTF AFTER ADVANCING 1 LINES
046300         GO TO 2-EOJ.
046400     MOVE DATE-FLAG-SW TO DATE-CODE.
046600     MOVE 1 TO DATE-MODE.
046700     CALL "TDATECK2" USING DATE-CHECK-AREA LANGUAGE-PARMS.
046800     MOVE DATE-SLASH-OUT TO T-DATE.
047100     CALL "TSETCRFT" USING DBPARAMETERS
047200                           CRAFT-TABLE.
048100     MOVE STATUS-INPUT TO ST-R.
048200     MOVE CODE-INPUT TO CODE-R.
048300     MOVE EQPNUM-INPUT TO EQPNUM-R.
048400     MOVE DEPT-INPUT TO DEPT-R.
048500     MOVE ZONE-INPUT TO ZONE-R.
048600     MOVE CLASS-INPUT TO CLASS-R.
048800     IF BUDGET-INPUT = "   -  -  -   R  "
048900         MOVE SPACES TO BUDGET-R
049000     ELSE
049100     MOVE BUDGET-INPUT TO BUDGET-R.
049200
049300     MOVE REQUEST-INPUT TO REQUEST-R.
049400
049500     IF LINES-PER-INCH = "8"
049600         MOVE 70 TO PAGE-RECS
049700     ELSE
049800     MOVE 50 TO PAGE-RECS.
049900 6-MAIN.
