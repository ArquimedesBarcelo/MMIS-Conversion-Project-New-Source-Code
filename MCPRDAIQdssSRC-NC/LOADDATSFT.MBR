     F****************************************************************
     FMCFLMM2501IF   E           K DISK
     F*EJECT
     D CHKTIME         DS             4
     D  CHKHH                  1      2  0
     D  CHKMM                  3      4  0
     D*
     D CHKZONE         S              4
     D CHKDATE         S              8
     D PRODDATE        S              8
     D PRODSHFT        S              1
     D PRODMOD         S              4
     D CALCMOD         S              5S 0
     D ALPHAMOD        S              5
     D*
     D OFFSET          S              4  0
     D ADDIN           S              4  0
     D adate           S               d   datfmt(*iso)
     D indate          S              8
     D outdate         S              8
     D*
     D SHIFT1          DS
     D  S1SHIFT                1      1
     D  S1STRSFT               2      5
     D    S1STRHH              2      3  0
     D    S1STRMM              4      5  0
     D*
     D SHIFT2          DS
     D  S2SHIFT                1      1
     D  S2STRSFT               2      5
     D    S2STRHH              2      3  0
     D    S2STRMM              4      5  0
     D*
     D SHIFT3          DS
     D  S3SHIFT                1      1
     D  S3STRSFT               2      5
     D    S3STRHH              2      3  0
     D    S3STRMM              4      5  0
     D*
     D SHIFT4          DS
     D  S4SHIFT                1      1
     D  S4STRSFT               2      5  0
     D    S4STRHH              2      3  0
     D    S4STRMM              4      5  0
     D*
     D*
     C     *ENTRY        PLIST
     C                   PARM                    CHKZONE
     C                   PARM                    CHKDATE
     C                   PARM                    CHKTIME
     C                   PARM                    PRODDATE
     C                   PARM                    PRODSHFT
     C                   PARM                    PRODMOD
     C*
     C                   MOVE      *BLANK        PRODDATE
     C                   MOVE      *BLANK        PRODSHFT
     C                   MOVE      *BLANK        PRODMOD
     C*
     C     60            MULT      CHKHH         CALCMOD
     C                   ADD       CHKMM         CALCMOD
     C*
     C     CHKZONE       CHAIN     MCRPMM2500
     C*
     C*
     C                   IF        %found(MCFLMM2501)
     C*
     C     SHIFTCODE     IFEQ      '2'
     C                   EXSR      TWO
     C                   ELSE
     C     SHIFTCODE     IFEQ      '3'
     C                   EXSR      THREE
     C                   ELSE
     C     SHIFTCODE     IFEQ      '4'
     C                   EXSR      FOUR
     C                   ELSE
     C                   MOVE      '1'           PRODSHFT
     C                   MOVE      CHKDATE       PRODDATE
     C                   MOVE      '0001'        PRODMOD
     C                   END
     C                   END
     C                   END
     C*
     C                   ELSE
     C*
     C                   MOVE      '1'           PRODSHFT
     C                   MOVE      CHKDATE       PRODDATE
     C                   MOVE      '0001'        PRODMOD
     C*
     C                   END
     C*
     C                   SETON                                        LR
     C/EJECT
     C     TWO           BEGSR
     C*
     C     FRSTSHIFT     IFGT      SCNDSHIFT
     C                   MOVE      '1'           S1SHIFT
     C                   MOVE      FRSTSHIFT     S1STRSFT
     C                   MOVE      '2'           S2SHIFT
     C                   MOVE      SCNDSHIFT     S2STRSFT
     C                   ELSE
     C                   MOVE      '2'           S1SHIFT
     C                   MOVE      SCNDSHIFT     S1STRSFT
     C                   MOVE      '1'           S2SHIFT
     C                   MOVE      FRSTSHIFT     S2STRSFT
     C                   END
     C*
     C     60            MULT      S1STRHH       OFFSET
     C                   ADD       S1STRMM       OFFSET
     C*
     C     1440          SUB       OFFSET        ADDIN
     C*
     C     CHKTIME       IFGE      S1STRSFT
     C                   SUB       OFFSET        CALCMOD
     C                   MOVE      CALCMOD       ALPHAMOD
     C                   MOVE      ALPHAMOD      PRODMOD
     C                   MOVE      S1SHIFT       PRODSHFT
     C                   EXSR      CHGDATE
     C                   GOTO      ENDTWO
     C                   END
     C*
     C     CHKTIME       IFGE      S2STRSFT
     C                   ADD       ADDIN         CALCMOD
     C                   MOVE      CALCMOD       ALPHAMOD
     C                   MOVE      ALPHAMOD      PRODMOD
     C                   MOVE      S2SHIFT       PRODSHFT
     C                   MOVE      CHKDATE       PRODDATE
     C                   GOTO      ENDTWO
     C                   ELSE
     C                   ADD       ADDIN         CALCMOD
     C                   MOVE      CALCMOD       ALPHAMOD
     C                   MOVE      ALPHAMOD      PRODMOD
     C                   MOVE      S1SHIFT       PRODSHFT
     C                   MOVE      CHKDATE       PRODDATE
     C                   GOTO      ENDTWO
     C                   END
     C
     C     ENDTWO        TAG
     C                   ENDSR
     C/EJECT
     C     THREE         BEGSR
     C*
     C     FRSTSHIFT     IFGT      SCNDSHIFT
     C     FRSTSHIFT     IFGT      thrdSHIFT
     C                   MOVE      '1'           S1SHIFT
     C                   MOVE      FRSTSHIFT     S1STRSFT
     C                   END
     C                   END
     C*
     C     SCNDSHIFT     IFGT      FRSTSHIFT
     C     SCNDSHIFT     IFGT      THRDSHIFT
     C                   MOVE      '2'           S1SHIFT
     C                   MOVE      SCNDSHIFT     S1STRSFT
     C                   END
     C                   END
     C*
     C     THRDSHIFT     IFGT      FRSTSHIFT
     C     THRDSHIFT     IFGT      SCNDSHIFT
     C                   MOVE      '3'           S1SHIFT
     C                   MOVE      THRDSHIFT     S1STRSFT
     C                   END
     C                   END
     C*
     C     60            MULT      S1STRHH       OFFSET
     C                   ADD       S1STRMM       OFFSET
     C*
     C     1440          SUB       OFFSET        ADDIN
     C*
     C     S1SHIFT       IFEQ      '1'
     C*
     C     SCNDSHIFT     IFLT      THRDSHIFT
     C                   MOVE      '2'           S2SHIFT
     C                   MOVE      SCNDSHIFT     S2STRSFT
     C                   MOVE      '3'           S3SHIFT
     C                   MOVE      THRDSHIFT     S3STRSFT
     C                   ELSE
     C                   MOVE      '3'           S2SHIFT
     C                   MOVE      THRDSHIFT     S2STRSFT
     C                   MOVE      '2'           S3SHIFT
     C                   MOVE      SCNDSHIFT     S3STRSFT
     C                   END
     C*
     C                   END
     C*
     C     S1SHIFT       IFEQ      '2'
     C*
     C     FRSTSHIFT     IFLT      THRDSHIFT
     C                   MOVE      '1'           S2SHIFT
     C                   MOVE      FRSTSHIFT     S2STRSFT
     C                   MOVE      '3'           S3SHIFT
     C                   MOVE      THRDSHIFT     S3STRSFT
     C                   ELSE
     C                   MOVE      '3'           S2SHIFT
     C                   MOVE      THRDSHIFT     S2STRSFT
     C                   MOVE      '1'           S3SHIFT
     C                   MOVE      FRSTSHIFT     S3STRSFT
     C                   END
     C*
     C                   END
     C*
     C     S1SHIFT       IFEQ      '3'
     C*
     C     FRSTSHIFT     IFLT      SCNDSHIFT
     C                   MOVE      '1'           S2SHIFT
     C                   MOVE      FRSTSHIFT     S2STRSFT
     C                   MOVE      '2'           S3SHIFT
     C                   MOVE      SCNDSHIFT     S3STRSFT
     C                   ELSE
     C                   MOVE      '2'           S2SHIFT
     C                   MOVE      SCNDSHIFT     S2STRSFT
     C                   MOVE      '1'           S3SHIFT
     C                   MOVE      FRSTSHIFT     S3STRSFT
     C                   END
     C*
     C                   END
     C*
     C     CHKTIME       IFGE      S1STRSFT
     C                   SUB       OFFSET        CALCMOD
     C                   MOVE      CALCMOD       ALPHAMOD
     C                   MOVE      ALPHAMOD      PRODMOD
     C                   MOVE      S1SHIFT       PRODSHFT
     C                   EXSR      CHGDATE
     C                   GOTO      ENDTHREE
     C                   END
     C*
     C     CHKTIME       IFLT      S2STRSFT
     C                   ADD       ADDIN         CALCMOD
     C                   MOVE      CALCMOD       ALPHAMOD
     C                   MOVE      ALPHAMOD      PRODMOD
     C                   MOVE      S1SHIFT       PRODSHFT
     C                   MOVE      CHKDATE       PRODDATE
     C                   GOTO      ENDTHREE
     C                   END
     C*
     C     CHKTIME       IFLT      S3STRSFT
     C                   ADD       ADDIN         CALCMOD
     C                   MOVE      CALCMOD       ALPHAMOD
     C                   MOVE      ALPHAMOD      PRODMOD
     C                   MOVE      S2SHIFT       PRODSHFT
     C                   MOVE      CHKDATE       PRODDATE
     C                   GOTO      ENDTHREE
     C                   ELSE
     C                   ADD       ADDIN         CALCMOD
     C                   MOVE      CALCMOD       ALPHAMOD
     C                   MOVE      ALPHAMOD      PRODMOD
     C                   MOVE      S2SHIFT       PRODSHFT
     C                   MOVE      CHKDATE       PRODDATE
     C                   GOTO      ENDTHREE
     C                   END
     C*
     C     ENDTHREE      TAG
     C                   ENDSR
     C/EJECT
     C     FOUR          BEGSR
     C*
     C*      NOT USED BY ANY PLANT - IF NEEDED IT WILL BE CODED LATER
     C*
     C*
     C                   MOVE      '1'           PRODSHFT
     C                   MOVE      CHKDATE       PRODDATE
     C                   MOVE      '0001'        PRODMOD
     C*
     C
     C
     C
     C                   ENDSR
     C/EJECT
     C     CHGDATE       BEGSR
     C
     C                   eval      indate = chkdate
     C                   eval      adate = %date(indate:*iso0)
     C                   eval      adate = adate + %days(1)
     C                   eval      outdate = %subst(%char(adate):1:4)
     C                                     + %subst(%char(adate):6:2)
     C                                     + %subst(%char(adate):9:2)
     C                   MOVE      outdate       PRODDATE
     C
     C                   ENDSR
