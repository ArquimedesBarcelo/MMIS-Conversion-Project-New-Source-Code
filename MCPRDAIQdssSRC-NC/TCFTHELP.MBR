       IDENTIFICATION DIVISION.
       PROGRAM-ID.             TCFTHELP.
       AUTHOR.                 W. ROXBURY.
      *INSTALLATION.           GOODYEAR TIRE & RUBBER CO.
      *REMARKS.           ***  THIS IS THE CRAFTSMAN'S FUNCTIONS SUB-EXECUTIVE
      *                        RUN FROM TEXEHELP EXECUTIVE PROGRAM
      *                        SUBROUTINES CALLED:
      *                            TMESSAGE
      *                            TGETNEXT
      *                            TBBNEWS
      *                            TDISPMES
      *                            TQUPDATE
      *                            TALWONO
      *                            THELPSUB
      *                            ****.

      *C   03/11/1998   CA YODER   REQ #97-1125
      *C     CHANGED PASSWORD FROM 6 TO 8 FOR CALL TO "TPERPASS."
      *C
      *C   03/05/2002   GEISER
      *C     WIPED OUT ALL PERSONNEL DATA IF PASSWORD NOT CORRECT.
      *C
      *C   05/28/2002   GEISER
      *C     SKIPPED WO UPDATE PASSWORD CHECK FOR LAWTON ZONE Z1B.
      *C     PER BOB NESSELROADE.
      *C
      *C   01/01/2010   CA YODER
      *C     ADDED LOGIC TO UPDATE THE WORKORDER LETTER FOR THE YEAR
      *C     TO INCREASE THE CYCLE BEYOND 10 YEAR.  COPIED LOGIC FROM
      *C     TNEWWONU (COMMENTS INCLUDED BELOW).
      *C
      *C  IN ORDER TO HOLD DATA LONGER THAN 10 YEARS, CHANGE THE BASE METHOD FOR
      *C  CREATING A WORK ORDER NUMBER, BY STOPPING THE PROCESS OF WRAPPING THE
      *C  LETTER TO IDENTIFY THE YEAR FOR EACH DECADE. FOR W/O CREATED IN 2010,
      *C  INSTEAD OF USING LETTER A AGAIN, USE LETTER L AND SO ON. SKIP USING I,
      *C  O,  Q, AND  U TO AVOID CONFUSION.
      *C
      *C                    20 YEAR PATTERN
      *C
      *C   2000-2009    A-K
      *C   2010-2019    M-Y
      *C   2020-2029    A-K
      *C   2030-2039    M-Y
      *C   2040-2049    A-K
      *C   2050-2059    M-Y
      *C
      *C   06/25/2010   CA YODER    REQ# 2010-10920873
      *C     REMOVED HARD-CODED LOGIC FOR PASSWORD CHECK FOR LAWTON.
      *C

       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.
       SOURCE-COMPUTER.        IBM-AS400.
       OBJECT-COMPUTER.        IBM-AS400.
       SPECIAL-NAMES.          REQUESTOR IS WORK-STATION
                               SYSTEM-CONSOLE IS CONSOLE
                               LOCAL-DATA IS LOCAL-DATA-AREA.
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT WO-BASIC
                  ASSIGN       TO DATABASE-MCFLMM1001
                  ORGANIZATION IS INDEXED
                  ACCESS MODE  IS DYNAMIC
                  RECORD KEY   IS EXTERNALLY-DESCRIBED-KEY
                               WITH DUPLICATES
                  FILE STATUS  IS FILE-STAT.

           SELECT WO-PLANNED
                  ASSIGN       TO DATABASE-MCFLMM1101
                  ORGANIZATION IS INDEXED
                  ACCESS MODE  IS DYNAMIC
                  RECORD KEY   IS EXTERNALLY-DESCRIBED-KEY
                               WITH DUPLICATES
                  FILE STATUS  IS FILE-STAT.

           SELECT PER-PERSONNEL
                  ASSIGN       TO DATABASE-MCFLMM0301
                  ORGANIZATION IS INDEXED
                  ACCESS MODE  IS DYNAMIC
                  RECORD KEY   IS EXTERNALLY-DESCRIBED-KEY
                  FILE STATUS  IS FILE-STAT.

           SELECT WO-OPEN-QUEUE
                  ASSIGN       TO DATABASE-MCFLMM1903
                  ORGANIZATION IS INDEXED
                  ACCESS MODE  IS DYNAMIC
                  RECORD KEY   IS EXTERNALLY-DESCRIBED-KEY
                               WITH DUPLICATES
                  FILE STATUS  IS FILE-STAT.

           SELECT CURRENT-LABOR
                  ASSIGN       TO DATABASE-MCFLMM1601
                  ORGANIZATION IS INDEXED
                  ACCESS MODE  IS DYNAMIC
                  RECORD KEY   IS EXTERNALLY-DESCRIBED-KEY
                               WITH DUPLICATES
                  FILE STATUS  IS FILE-STAT.

           SELECT WO-CRAFTS-REQD
                  ASSIGN       TO DATABASE-MCFLMM0601
                  ORGANIZATION IS INDEXED
                  ACCESS MODE  IS DYNAMIC
                  RECORD KEY   IS EXTERNALLY-DESCRIBED-KEY
                  FILE STATUS  IS FILE-STAT.

           SELECT EQP-EQUIPMENT
                  ASSIGN       TO DATABASE-MCFLMM0201
                  ORGANIZATION IS INDEXED
                  ACCESS MODE  IS DYNAMIC
                  RECORD KEY   IS EXTERNALLY-DESCRIBED-KEY
                  FILE STATUS  IS FILE-STAT.

           SELECT DISPLAY-FILE
                  ASSIGN       TO WORKSTATION-ZCFTHELP-SI
                  ORGANIZATION IS TRANSACTION
                  ACCESS MODE  IS SEQUENTIAL
                  FILE STATUS  IS SCREEN-STATUS
                               MAJOR-MINOR
                  CONTROL-AREA IS SCREEN-CONTROL.

       DATA DIVISION.
