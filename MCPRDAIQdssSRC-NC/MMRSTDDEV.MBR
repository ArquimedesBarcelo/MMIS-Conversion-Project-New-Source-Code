     FMCFLMM10J2IF   E           K DISK
     FMCFPMM1090UF   E           K DISK
     FMCFPMM1091UF A E           K DISK
     F****************************************************************
     D*
     D  ZEQPNUM        S              6    INZ('      ')
     D  ZFAILCODE      S              6    INZ('      ')
     D  ZDATE          S              8    INZ('        ')
     D  ZDIV           S              4    INZ('    ')
     D  ZMIN           S              7  0
     D  ZDAYS          S              7  0
     D  XDAYS          S              5  0
     D  XYEARS         S              5  0
     D  MDATE1         S              8
     D  MDATE2         S              8
     D*
     D  ZONEPRTY       DS             6
     D  ZONE                   1      4
     D  PRTY                   5      6
     D*
     D JUL1            DS             7
     D  YEAR1                  1      4  0
     D  DAY1                   5      7  0
     D*
     D JUL2            DS             7
     D  YEAR2                  1      4  0
     D  DAY2                   5      7  0
     D*
     C*
     C                   READ      MCRPMM1090                             90
     C     *IN90         DOWEQ     '0'
     C                   DELETE    MCRPMM1090
     C                   READ      MCRPMM1090                             90
     C                   END
     C*
     C                   READ      MCRPMM1091                             91
     C     *IN91         DOWEQ     '0'
     C                   DELETE    MCRPMM1091
     C                   READ      MCRPMM1091                             91
     C                   END
     C*
     C                   READ      MCRPMM1000                             99
     C     *IN99         DOWEQ     '0'
     C     DATECOMP      IFEQ      '        '
     C     DATECOMP      OREQ      '0'
     C                   GOTO      NEXTR
     C                   END
     C*
     C     PRTY          IFNE      '1 '
     C                   GOTO      NEXTR
     C                   END
     C*
     C     ZEQPNUM       IFEQ      '      '
     C                   MOVE      EQPNUM        ZEQPNUM
     C                   MOVE      FAILCODE      ZFAILCODE
     C                   MOVE      DATECOMP      ZDATE
     C                   MOVE      DATECOMP      MDATE1
     C                   MOVE      ZONE          ZDIV
     C                   Z-ADD     MMWRENCH      ZMIN
     C                   Z-ADD     0             ZDAYS
     C                   GOTO      NEXTR
     C                   END
     C*
     C     EQPNUM        IFEQ      ZEQPNUM
     C     FAILCODE      ANDEQ     ZFAILCODE
     C                   MOVE      MDATE1        MDATE2
     C                   MOVE      DATECOMP      MDATE1
     C                   CALL      'MMXDATEJUL'
     C                   PARM                    MDATE1
     C                   PARM                    JUL1
     C                   CALL      'MMXDATEJUL'
     C                   PARM                    MDATE2
     C                   PARM                    JUL2
     C     DAY1          IFLT      DAY2
     C                   ADD       365           DAY1
     C                   SUB       1             YEAR1
     C                   END
     C     DAY1          SUB       DAY2          XDAYS
     C     YEAR1         SUB       YEAR2         XYEARS
     C                   EVAL      ZDAYS  = (365 * XYEARS) + XDAYS
     C                   ELSE
     C                   MOVE      MDATE1        MDATE2
     C                   Z-ADD     0             ZDAYS
     C                   END
     C*
     C                   MOVE      ZEQPNUM       MWEQPNUM
     C                   MOVE      ZFAILCODE     MWFAIL
     C                   MOVE      ZDATE         MWDATEC
     C                   MOVE      ZDIV          MWDIV
     C                   Z-ADD     ZMIN          MWMTTR
     C                   Z-ADD     ZDAYS         MWMTTF
     C                   WRITE     MCRPMM1091
     C*
     C                   MOVE      EQPNUM        ZEQPNUM
     C                   MOVE      FAILCODE      ZFAILCODE
     C                   MOVE      DATECOMP      ZDATE
     C                   MOVE      DATECOMP      MDATE1
     C                   MOVE      ZONE          ZDIV
     C                   Z-ADD     MMWRENCH      ZMIN
     C                   Z-ADD     0             ZDAYS
     C*
     C     NEXTR         TAG
     C                   READ      MCRPMM1000                             99
     C                   END
     C*
     C                   MOVE      ZEQPNUM       MWEQPNUM
     C                   MOVE      ZFAILCODE     MWFAIL
     C                   MOVE      ZDATE         MWDATEC
     C                   MOVE      ZDIV          MWDIV
     C                   Z-ADD     ZMIN          MWMTTR
     C                   Z-ADD     ZDAYS         MWMTTF
     C                   WRITE     MCRPMM1091
     C*
     C     ENDIT         TAG
     C                   SETON                                        LR
