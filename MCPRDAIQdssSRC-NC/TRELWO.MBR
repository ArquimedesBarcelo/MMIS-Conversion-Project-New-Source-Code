       IDENTIFICATION DIVISION.
       PROGRAM-ID.             TRELWO.
      *C
      *C  01/04/2010  CA YODER  2010-00142425-001
      *C     UPDATE LOGIC ASSIGNING WORKORDER LETTER SUFFIX.
      *C
       AUTHOR.                 W. ROXBURY.
       INSTALLATION.           GOODYEAR TIRE & RUBBER CO.
       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.
       SOURCE-COMPUTER.        AS-400.
       OBJECT-COMPUTER.        AS-400.
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT WO-BASIC
                  ASSIGN       TO DATABASE-MCFLMM1001
                  ORGANIZATION IS INDEXED
                  ACCESS MODE  IS DYNAMIC
                  RECORD KEY   IS EXTERNALLY-DESCRIBED-KEY
                               WITH DUPLICATES
                  FILE STATUS  IS FILE-STAT.

           SELECT WO-OPEN-QUEUE
                  ASSIGN       TO DATABASE-MCFLMM1902
                  ORGANIZATION IS INDEXED
                  ACCESS MODE  IS DYNAMIC
                  RECORD KEY   IS EXTERNALLY-DESCRIBED-KEY
                               WITH DUPLICATES
                  FILE STATUS  IS FILE-STAT.

           SELECT EQP-EQUIPMENT
                  ASSIGN       TO DATABASE-MCFLMM0201
                  ORGANIZATION IS INDEXED
                  ACCESS MODE  IS DYNAMIC
                  RECORD KEY   IS EXTERNALLY-DESCRIBED-KEY
                  FILE STATUS  IS FILE-STAT.

           SELECT DISPLAY-FILE
                  ASSIGN       TO WORKSTATION-ZCORLESS-SI
                  ORGANIZATION IS TRANSACTION
                  ACCESS MODE  IS SEQUENTIAL
                  FILE STATUS  IS SCREEN-STATUS
                               MAJOR-MINOR
                  CONTROL-AREA IS SCREEN-CONTROL.

       DATA DIVISION.
       FILE SECTION.
       FD  WO-BASIC
           LABEL RECORDS ARE STANDARD.
       01  VWO-REC.
           COPY DD-ALL-FORMATS OF MCFLMM1001.

       FD  WO-OPEN-QUEUE
           LABEL RECORDS ARE STANDARD.
       01  WOQ-REC.
           COPY DD-ALL-FORMATS OF MCFLMM1902.

       FD  EQP-EQUIPMENT
           LABEL RECORDS ARE STANDARD.
       01  EQP-REC.
           COPY DD-ALL-FORMATS OF MCFLMM0201.

       FD  DISPLAY-FILE
           LABEL RECORDS ARE OMITTED.
       01  DISPLAY-REC         PIC X(2000).

       WORKING-STORAGE SECTION.
       77  WO-SW                     PIC S9(4)  COMP-4  VALUE 0.
       77  SUB1                      PIC S9(4)  COMP-4.
       77  RETURN-CODE               PIC X.
       77  QUEUE-PRTY                PIC 9.
       77  QUEUE-SW                  PIC X.
       77  QUEUE-ERROR               PIC X(76).
       77  TRUE-VAL                  PIC 1              VALUE B"1".
      *---- 01/04/2010:  ADDED PARAMETER FOR CMMISYR.
       77  MMIS-LETTER                PIC X.

       01  FILE-STAT.
           05  FILE-STAT-1           PIC X  VALUE "0".
           05  FILE-STAT-2           PIC X  VALUE "0".

       01  PASSWORD-INFORMATION.
           05  NAME-OF-PROGRAM PIC X(08) VALUE "TRELWO  ".
           05  PROGRAM-TYPE    PIC X(02) VALUE "UP".
           05  PROGRAM-RELEASE PIC X(12) VALUE " J0100010001".
           05  PROGRAM-DESCRIPTION.
               10  PROG-DESCA1 PIC X(30) VALUE
                   "RELEASES WORKORDERS INTO THE Q".
               10  PROG-DESCA2 PIC X(30) VALUE
                   "UEUE.  ALLOWS SUPERVISORS TO  ".
               10  PROG-DESCB1 PIC X(30) VALUE
                   "RE-QUEUE HELD VERBAL WORKORDER".
               10  PROG-DESCB2 PIC X(30) VALUE
                   "S WHICH MAY NOW BE ASSIGNED.  ".
               10  PROG-FUNCT  PIC X(60) VALUE
                   "RUNS FROM f7 KEY OF SUPERVISOR FUNCTIONS MENU.    ".
           05  PASSWORD-FLAG   PIC X.

       01  CUR-DATE-WA.
           05  CUR-DATE-YY.
               10  CD-YY-1                 PIC X.
               10  CD-YY-2                 PIC X.
           05  CUR-DATE-MM                 PIC XX.
           05  CUR-DATE-DD                 PIC XX.

       01  YEAR-DESIGNATOR.
           05  YEAR-TABLE.
               10  YD-0      PIC X  VALUE "A".
               10  YD-1      PIC X  VALUE "B".
               10  YD-2      PIC X  VALUE "C".
               10  YD-3      PIC X  VALUE "D".
               10  YD-4      PIC X  VALUE "E".
               10  YD-5      PIC X  VALUE "F".
               10  YD-6      PIC X  VALUE "G".
               10  YD-7      PIC X  VALUE "H".
               10  YD-8      PIC X  VALUE "J".
               10  YD-9      PIC X  VALUE "K".
           05  YEAR-COUNTER REDEFINES YEAR-TABLE.
               10  YEARC OCCURS 10 TIMES PIC X.

       01  SCREEN-DATA.
           05  WO-BUFFER.
               10  WO-BUF-NUM      PIC X(06).
               10  WO-BUF-YR       PIC X.
               10  WO-BUF-SUF      PIC XXX.
           05  WO-DATA.
               10  WO-NUM-BUF      PIC X(10).
               10  WO-STAT-BUF     PIC X(02).
               10  EQUIP-BUF       PIC X(06).
               10  LOC-BUF         PIC X(08).
               10  DESC-BUF        PIC X(30).
               10  DESC-A-BUF      PIC X(66).
               10  DESC-B-BUF      PIC X(66).
               10  MSG-BUF         PIC X(76).
           05  ERRMSG              PIC X(79).

       01  DB-ERROR.
           05  DB-FUNC   PIC X(10) VALUE SPACES.
           05  DB-FILE   PIC X(18) VALUE SPACES.
           05  FILLER    PIC X(20) VALUE "ERROR - FILE-STAT = ".
           05  CON-WORD  PIC XX.

       01  CAT-TEXT-BUFFER.
           02  CAT-TEXT1  PIC X(53) VALUE SPACES.
           02  CAT-TEXT2  PIC X(02) VALUE "  ".

           COPY SCREENIO       IN COPYLIB.

           COPY CATREAD        IN COPYLIB.

       01  EQP-EQUIP-DATA.
           COPY MEQPFILE       IN COPYLIB.

       01  WO-BASIC-DATA.
           COPY DWOBASIC       IN COPYLIB.

       01  WO-QUEUE-DATA.
           COPY DWOOPENQ       IN COPYLIB.

       01  MESSAGE-BUFFER-DATA.
           COPY ERRORLIN       IN COPYLIB.

       LINKAGE SECTION.
       01  DBPARAMETERS.
           COPY DBPARMS        IN COPYLIB.

       PROCEDURE DIVISION USING DBPARAMETERS.
       CHECK-PASSWORD.
           CALL "TPWORD" USING PASSWORD-INFORMATION.
           IF PASSWORD-FLAG NOT = "N"
               GO TO BEGIN.
           GOBACK.

       BEGIN.
           PERFORM 1-HSK.
           GO TO 61-SHOWFORM.

       END-OF-JOB.
           CLOSE               DISPLAY-FILE.
           CLOSE               WO-BASIC.
           CLOSE               WO-OPEN-QUEUE.
           CLOSE               EQP-EQUIPMENT.
           GOBACK.

       1-HSK.
           OPEN I-O            DISPLAY-FILE.
           OPEN I-O            WO-OPEN-QUEUE.
           OPEN INPUT          WO-BASIC.
           OPEN INPUT          EQP-EQUIPMENT.

           MOVE "VRELWO"       TO SCREEN-NAME.
           MOVE SPACES         TO SCREEN-DATA MESSAGE-BUFFER.
           ACCEPT CUR-DATE-WA  FROM DATE.
      *------- 01/04/2010:  UPDATED WORKORDER LETTER SUFFIX LOGIC.
      *    MOVE CD-YY-2        TO SUB1.
      *    ADD 1               TO SUB1.
      *    MOVE YEARC (SUB1)   TO WO-BUF-YR.

           CALL "CMMISYR" USING MMIS-LETTER.
           MOVE MMIS-LETTER    TO WO-BUF-YR.
      *-------

       61-SHOWFORM.
           MOVE "00"           TO SCREEN-STATUS.
           MOVE SCREEN-DATA    TO DISPLAY-REC.

           WRITE DISPLAY-REC   FORMAT IS SCREEN-NAME
                               INDIC ARE SCREEN-INDICATORS.
           IF SCREEN-STATUS NOT = "00"
               DISPLAY "SCREEN WRITE ERROR.  SCREEN-STATUS IS "
                               SCREEN-STATUS
               GO TO END-OF-JOB.

           READ  DISPLAY-FILE FORMAT IS SCREEN-NAME
                               INDIC ARE SCREEN-INDICATORS
           IF SCREEN-STATUS NOT = "00"
               DISPLAY "SCREEN READ ERROR.  SCREEN-STATUS IS "
                               SCREEN-STATUS
               GO TO END-OF-JOB.

           MOVE DISPLAY-REC    TO SCREEN-DATA.
           MOVE ALL B"0"       TO SCREEN-INDICATORS.

           IF KEY-HIT = 1 OR 3
               GO TO END-OF-JOB.

           IF WO-SW = 0
               IF KEY-HIT NOT = 0
                   GO TO 61-SHOWFORM
               ELSE
                   NEXT SENTENCE
           ELSE
               IF KEY-HIT = 0
                   NEXT SENTENCE
               ELSE
               IF KEY-HIT = 2
                   GO TO 62-START-QUEUE
               ELSE
                   GO TO 61-SHOWFORM.

       61-GET-DATA.
           MOVE SPACES         TO MESSAGE-BUFFER.
           CALL "TALWONO" USING WO-BUFFER RETURN-CODE.
           MOVE SPACES         TO WO-DATA.

           MOVE WO-BUFFER      TO WONUM-MM OF WO-BASIC.
           READ WO-BASIC       INTO WO-BASIC-DATA
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
               IF FILE-STAT = "10" OR "14" OR "46"
                   MOVE 0      TO WO-SW
      **********************************************************************
      **    MESSAGE 035/039:
      ** INVALID WORKORDER NUMBER OR PLANNED WORKORDER.
      **********************************************************************
                   MOVE  35    TO CATREAD-MSG-SET
                   MOVE  39    TO CATREAD-MSG-NUM
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE MESSAGE-BUFFER TO DESC-A-BUF
                   GO TO 61-PUT-DATA
               ELSE
                   MOVE FILE-STAT  TO CON-WORD
                   MOVE "READ    " TO DB-FUNC
                   MOVE "WO-BASIC" TO DB-FILE
                   MOVE DB-ERROR   TO ERRMSG MESSAGE-BUFFER
                   MOVE TRUE-VAL   TO IND(12) IND(99)
                   GO TO 61-PUT-DATA.

           IF WO-BUFFER NOT = WO-NUM
               MOVE 0          TO WO-SW
      **********************************************************************
      **    MESSAGE 035/039:
      ** INVALID WORKORDER NUMBER OR PLANNED WORKORDER.
      **********************************************************************
               MOVE  35        TO CATREAD-MSG-SET
               MOVE  39        TO CATREAD-MSG-NUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER TO DESC-A-BUF
               GO TO 61-PUT-DATA.

           MOVE 1              TO WO-SW.
           MOVE WO-NUM         TO WO-NUM-BUF.
           MOVE WO-STATUS      TO WO-STAT-BUF.
           MOVE EQUIP-NUM      TO EQUIP-BUF.
           MOVE LOCATION       TO LOC-BUF.
           MOVE DESCRIPTION-1  TO DESC-BUF.
           MOVE DESCRIPTION-2-1 TO DESC-A-BUF.
           MOVE DESCRIPTION-2-2 TO DESC-B-BUF.

           MOVE WO-NUM         TO WONUM-MM OF WO-OPEN-QUEUE.
           START WO-OPEN-QUEUE KEY = WONUM-MM OF WO-OPEN-QUEUE
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT = "00"
               MOVE 0          TO WO-SW
      **********************************************************************
      **    MESSAGE 049/006:
      ** WORKORDER ALREADY RELEASED AND IS AVAILABLE FOR AUTOMATIC ASSIGNMENT
      **********************************************************************
               MOVE  49        TO CATREAD-MSG-SET
               MOVE   6        TO CATREAD-MSG-NUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER TO ERRMSG
               MOVE TRUE-VAL       TO IND(99)
               GO TO 61-PUT-DATA.

           IF WO-STATUS = "OO" OR "IP" OR "HM" OR "HL"
               GO TO 61-PUT-DATA.

           MOVE 0              TO WO-SW.
      **********************************************************************
      **    MESSAGE 029/049:
      ** CANNOT AUTOMATICALLY ASSIGN A WORKORDER WITH STATUS ..
      **********************************************************************
           MOVE  29            TO CATREAD-MSG-SET.
           MOVE  49            TO CATREAD-MSG-NUM.
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
           MOVE MESSAGE-BUFFER TO CAT-TEXT1.
           MOVE WO-STATUS      TO CAT-TEXT2.
           MOVE CAT-TEXT-BUFFER TO ERRMSG.
           MOVE TRUE-VAL       TO IND(12) IND(99).
           GO TO 61-SHOWFORM.

       61-PUT-DATA.
           MOVE SPACES         TO WO-BUFFER.
      *------- 01/04/2010:  UPDATED WORKORDER LETTER SUFFIX LOGIC.
      ***  MOVE YEARC (SUB1)   TO WO-BUF-YR.
           MOVE MMIS-LETTER    TO WO-BUF-YR.

           IF MESSAGE-BUFFER = SPACES AND WO-SW = 1
               MOVE SPACES     TO ERRMSG
      **********************************************************************
      **    MESSAGE 042/002:
      ** PRESS 'F2' TO ACTIVATE AUTOMATIC ASSIGNMENT ON W/O
      **********************************************************************
               MOVE  42        TO CATREAD-MSG-SET
               MOVE   2        TO CATREAD-MSG-NUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER TO MSG-BUF.

           GO TO 61-SHOWFORM.

       62-START-QUEUE.
           MOVE SPACES         TO EQP-EQUIP-DATA.
           MOVE 5              TO RIME-NO.
           MOVE EQUIP-NUM      TO EQPNUM-MM OF EQP-EQUIPMENT.
           READ EQP-EQUIPMENT  INTO EQP-EQUIP-DATA
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.

           MOVE SPACES         TO WO-QUEUE-DATA.
           MOVE ZONE           TO Q-ZONE.
           MOVE "1 "           TO Q-PRTY.
           MOVE WO-NUM         TO Q-WO-NUM.
           MOVE EQUIP-DOWN     TO Q-EQP-DOWN.
           MOVE "9999"         TO Q-CC-NUM.
           MOVE EQUIP-NUM      TO Q-EQUIP-NUM.
           MOVE DESCRIPTION-1  TO Q-DESCRIPTION.
           MOVE CRAFTS-REQD-1  TO Q-SKILL-1.
           MOVE CRAFTS-REQD-2  TO Q-SKILL-2.
           MOVE CRAFTS-REQD-3  TO Q-SKILL-3.

           IF PRIORITY = "1 "  MOVE 9 TO QUEUE-PRTY.
           IF PRIORITY = "2 "  MOVE 6 TO QUEUE-PRTY.
           IF PRIORITY = "3 "  MOVE 4 TO QUEUE-PRTY.
           IF PRIORITY = "4 "  MOVE 2 TO QUEUE-PRTY.
           IF PRIORITY = "5 "  MOVE 1 TO QUEUE-PRTY.

           COMPUTE QUEUE-FACTOR = RIME-NO * QUEUE-PRTY.
           MOVE "A"            TO QUEUE-SW.

           CALL "TQUPDATE" USING DBPARAMETERS
                                 WO-QUEUE-DATA
                                 QUEUE-SW
                                 QUEUE-ERROR.

           IF QUEUE-ERROR NOT = SPACES
               MOVE QUEUE-ERROR TO MESSAGE-BUFFER
               MOVE MESSAGE-BUFFER TO ERRMSG
               MOVE TRUE-VAL   TO IND(12) IND(99)
           ELSE
               MOVE SPACES     TO SCREEN-DATA MESSAGE-BUFFER
      *--------- 01/04/2010:  UPDATED WORKORDER LETTER SUFFIX LOGIC.
      ****     MOVE YEARC(SUB1) TO WO-BUF-YR.
               MOVE MMIS-LETTER TO WO-BUF-YR.

           IF MSG-TEXT = "LABOR"
      **********************************************************************
      **    MESSAGE 049/005:
      ** W/O SHOWS ACTIVE LABOR - NOT AVAILABLE FOR AUTOMATIC ASSIGNMENT
      **********************************************************************
               MOVE  49        TO CATREAD-MSG-SET
               MOVE   5        TO CATREAD-MSG-NUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER TO ERRMSG
               MOVE TRUE-VAL   TO IND(12) IND(99).

           GO TO 61-SHOWFORM.

       999-CATREAD.
           MOVE SPACES         TO MESSAGE-BUFFER.
           CALL "CCATREAD" USING CATREAD-PARMS.
           MOVE CATREAD-MSG-TEXT TO MESSAGE-BUFFER.

       999-CATREAD-EXIT.       EXIT.

