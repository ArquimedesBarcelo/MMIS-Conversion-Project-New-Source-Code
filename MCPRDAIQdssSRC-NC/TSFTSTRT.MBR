       IDENTIFICATION DIVISION.
       PROGRAM-ID.             TSFTSTRT.
       AUTHOR.                 W. ROXBURY.
       INSTALLATION.           GOODYEAR TIRE & RUBBER CO.
      *REMARKS.                THIS PROGRAM IP'S CRAFTSMEN ON WO'S
      *C---------------------------------------------------------------
      *C 02/25/93  JSB REQ 6306
      *C      ADDED "PR" AS A NEW WO STATUS FOR PRE-RELEASE.
      *C
      *C 08/28/09  CAY REQ 2009-00131261-003
      *C IN ORDER TO HOLD DATA LONGER THAN 10 YEARS, CHANGE THE
      *C BASE METHOD FOR CREATING A WORKORDER.  FOR W/O CREATED IN
      *C 2010, INSTEAD OF USING LETTER "A" AGAIN, USE "L", ETC.
      *C SKIP USING I, O, Q AND U TO AVOID CONFUSION.
      *C---------------------------------------------------------------
       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.
       SOURCE-COMPUTER.        IBM-AS400.
       OBJECT-COMPUTER.        IBM-AS400.
       SPECIAL-NAMES.          I-O-FEEDBACK     IS I-O-FEEDBACK-AREA
                               REQUESTOR        IS WORK-STATION
                               SYSTEM-CONSOLE   IS CONSOLE
                               LOCAL-DATA       IS LOCAL-DATA-AREA.

       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT LAB-CUR-STAT-CC
                  ASSIGN       TO DATABASE-MCFLMM1601
                  ORGANIZATION IS INDEXED
                  ACCESS MODE  IS DYNAMIC
                  RECORD KEY   IS EXTERNALLY-DESCRIBED-KEY
                               WITH DUPLICATES
                  FILE STATUS  IS FILE-STAT.

           SELECT LAB-CUR-STAT-WO
                  ASSIGN       TO DATABASE-MCFLMM1602
                  ORGANIZATION IS INDEXED
                  ACCESS MODE  IS DYNAMIC
                  RECORD KEY   IS EXTERNALLY-DESCRIBED-KEY
                               WITH DUPLICATES
                  FILE STATUS  IS FILE-STAT.

           SELECT PER-PERSONNEL
                  ASSIGN       TO DATABASE-MCFLMM0301
                  ORGANIZATION IS INDEXED
                  ACCESS MODE  IS DYNAMIC
                  RECORD KEY   IS EXTERNALLY-DESCRIBED-KEY
                  FILE STATUS  IS FILE-STAT.

           SELECT WO-BASIC
                  ASSIGN       TO DATABASE-MCFLMM1001
                  ORGANIZATION IS INDEXED
                  ACCESS MODE  IS DYNAMIC
                  RECORD KEY   IS EXTERNALLY-DESCRIBED-KEY
                               WITH DUPLICATES
                  FILE STATUS  IS FILE-STAT.

           SELECT WO-PLANNED
                  ASSIGN       TO DATABASE-MCFLMM1101
                  ORGANIZATION IS INDEXED
                  ACCESS MODE  IS DYNAMIC
                  RECORD KEY   IS EXTERNALLY-DESCRIBED-KEY
                               WITH DUPLICATES
                  FILE STATUS  IS FILE-STAT.

           SELECT DISPLAY-FILE
                  ASSIGN       TO WORKSTATION-ZCORLESS-SI
                  ORGANIZATION IS TRANSACTION
                  ACCESS MODE  IS SEQUENTIAL
                  FILE STATUS  IS SCREEN-STATUS
                               MAJOR-MINOR
                  CONTROL-AREA IS SCREEN-CONTROL.

       DATA DIVISION.
       FILE SECTION.
       FD  LAB-CUR-STAT-CC
           LABEL RECORDS ARE STANDARD.
       01  LCC-REC.
           COPY DDS-ALL-FORMATS OF MCFLMM1601.

       FD  LAB-CUR-STAT-WO
           LABEL RECORDS ARE STANDARD.
       01  LWO-REC.
           COPY DDS-ALL-FORMATS OF MCFLMM1602.

       FD  PER-PERSONNEL
           LABEL RECORDS ARE STANDARD.
       01  PP-REC.
           COPY DDS-ALL-FORMATS OF MCFLMM0301.

       FD  WO-BASIC
           LABEL RECORDS ARE STANDARD.
       01  VWO-REC.
           COPY DDS-ALL-FORMATS OF MCFLMM1001.

       FD  WO-PLANNED
           LABEL RECORDS ARE STANDARD.
       01  PWO-REC.
           COPY DDS-ALL-FORMATS OF MCFLMM1101.

       FD  DISPLAY-FILE
           LABEL RECORDS ARE OMITTED.
       01  DISPLAY-REC         PIC X(2000).

       WORKING-STORAGE SECTION.
       77  SUB1                PIC S9(4) BINARY VALUE ZEROS.
       77  STATUS-BUF          PIC XX.
       77  TIME-HOLD           PIC S9999 VALUE ZEROS.
       77  S-WINDOW            PIC S9999 VALUE ZEROS.
       77  E-WINDOW            PIC S9999 VALUE ZEROS.
       77  FILE-SW             PIC 9     VALUE 1.
           88  BASIC-FILE                VALUE 1.
           88  PLANNED-FILE              VALUE 2.
       77  ERROR-SW            PIC 9     VALUE 0.
           88  ERROR-SW-ON               VALUE 1.
       77  EDIT-SW             PIC 9     VALUE 0.
           88  EDIT-SW-ON                VALUE 1.
       77  COUNTER             PIC S9(4) VALUE 1    BINARY.
       77  KOUNTER             PIC S9(4) VALUE 0    BINARY.
       77  QUEUE-PRTY          PIC 9     VALUE ZEROS.
       77  QUEUE-SW            PIC X.
       77  QUEUE-ERROR         PIC X(76).
       77  TRUE-VAL            PIC 1     VALUE B"1".
       77  RETURN-COD          PIC 9999.
       77  RETURN-ERROR        PIC X(78).
       77  UPDATE-CODE         PIC X(2)  VALUE SPACES.

       01  FILE-STAT.
           05 FILE-STAT-1      PIC X   VALUE "0".
           05 FILE-STAT-2      PIC X   VALUE "0".

       01  PASSWORD-INFORMATION.
           05  NAME-OF-PROGRAM     PIC X(08) VALUE "TSFTSTRT".
           05  PROGRAM-TYPE        PIC X(02) VALUE "UP".
           05  PROGRAM-RELEASE     PIC X(12) VALUE " E0100010001".
           05  PROGRAM-DESCRIPTION.
               10  PROG-DESC-A1    PIC X(30) VALUE
                   "SHIFT START-UP PROGRAM ALLOWS ".
               10  PROG-DESC-A2    PIC X(30) VALUE
                   "SUPERVISOR TO START MULTIPLE  ".
               10  PROG-DESC-B1    PIC X(30) VALUE
                   "CRAFTSMEN IP ON WORKORDERS FRO".
               10  PROG-DESC-B2    PIC X(30) VALUE
                   "M THE SUPERVISOR's FUNCTIONS. ".
               10  PROG-FUNCTION1  PIC X(30) VALUE
                   "RUNS FROM f5 KEY OF SUPERVISOR".
               10  PROG-FUNCTION2  PIC X(30) VALUE
                   "'s UPDATE PROGRAM.            ".
           05  PASSWORD-FLAG       PIC X.

       01  TIME-BUFFER.
           05  TIME-BUF        PIC XXXX VALUE "0000".
           05  TIME-BUF-9      REDEFINES TIME-BUF PIC 9999.

       01  SCREEN-DATA.
           05  IP-1ST.
               10  IP-CC-1            PIC X(04).
               10  IP-WO-1.
                   15  IP-WO-1-6      PIC X(06).
                   15  IP-WO-1-7      PIC X(01).
                   15  IP-WO-1-SEQ    PIC X(03).
           05  IP-2ND.
               10  IP-CC-2            PIC X(04).
               10  IP-WO-2.
                   15  IP-WO-2-6      PIC X(06).
                   15  IP-WO-2-7      PIC X(01).
                   15  IP-WO-2-SEQ    PIC X(03).
           05  START-TIME             PIC X(04).
           05  IP-3RD.
               10  IP-CC-3            PIC X(04).
               10  IP-WO-3.
                   15  IP-WO-3-6      PIC X(06).
                   15  IP-WO-3-7      PIC X(01).
                   15  IP-WO-3-SEQ    PIC X(03).
           05  IP-4TH.
               10  IP-CC-4            PIC X(04).
               10  IP-WO-4.
                   15  IP-WO-4-6      PIC X(06).
                   15  IP-WO-4-7      PIC X(01).
                   15  IP-WO-4-SEQ    PIC X(03).
           05  IP-5TH.
               10  IP-CC-5            PIC X(04).
               10  IP-WO-5.
                   15  IP-WO-5-6      PIC X(06).
                   15  IP-WO-5-7      PIC X(01).
                   15  IP-WO-5-SEQ    PIC X(03).
           05  IP-6TH.
               10  IP-CC-6            PIC X(04).
               10  IP-WO-6.
                   15  IP-WO-6-6      PIC X(06).
                   15  IP-WO-6-7      PIC X(01).
                   15  IP-WO-6-SEQ    PIC X(03).
           05  IP-7TH.
               10  IP-CC-7            PIC X(04).
               10  IP-WO-7.
                   15  IP-WO-7-6      PIC X(06).
                   15  IP-WO-7-7      PIC X(01).
                   15  IP-WO-7-SEQ    PIC X(03).
           05  IP-8TH.
               10  IP-CC-8            PIC X(04).
               10  IP-WO-8.
                   15  IP-WO-8-6      PIC X(06).
                   15  IP-WO-8-7      PIC X(01).
                   15  IP-WO-8-SEQ    PIC X(03).
           05  COMM-1                 PIC X(74).
           05  COMM-2                 PIC X(74).
           05  CMDMSG                 PIC X(79).
           05  ERRMSG                 PIC X(79).

       01  IP-BUFFER.
           05  CC-BUF.
               10  CC-BUF-1       PIC X.
               10  CC-BUF-234     PIC XXX.
           05  WO-BUF.
               10  WO-BUF-1-7.
                   15  WO-BUF-6   PIC X(06).
                   15  WO-BUF-7   PIC X(01).
               10  WO-BUF-SEQ     PIC X(03).

       01  COMPLETE-COUNTERS.
           05  CMPL-1          PIC 9  VALUE 0.
           05  CMPL-2          PIC 9  VALUE 0.
           05  CMPL-3          PIC 9  VALUE 0.
           05  CMPL-4          PIC 9  VALUE 0.
           05  CMPL-5          PIC 9  VALUE 0.
           05  CMPL-6          PIC 9  VALUE 0.
           05  CMPL-7          PIC 9  VALUE 0.

       01  SHIFT-DATA.
           05  ZONE-BUF        PIC X(04).
           05  TIME-IN.
               10  HRS-IN      PIC 99 VALUE ZEROS.
               10  MIN-IN      PIC 99 VALUE ZEROS.
           05  CODE-BUF        PIC X.
           05  SHIFTS.
               10  S-1         PIC 9999 VALUE ZEROS.
               10  E-1         PIC 9999 VALUE ZEROS.
               10  S-2         PIC 9999 VALUE ZEROS.
               10  E-2         PIC 9999 VALUE ZEROS.
               10  S-3         PIC 9999 VALUE ZEROS.
               10  E-3         PIC 9999 VALUE ZEROS.
               10  S-4         PIC 9999 VALUE ZEROS.
               10  E-4         PIC 9999 VALUE ZEROS.
           05  CURR-SHIFT      PIC 9 VALUE ZEROS.

       01  DATE-BUF-CN.
           05  DATE-BUF-CC     PIC 99 VALUE ZEROS.
           05  DATE-BUF.
               10  DATE-BUF-YY.
                   15  CD-YY-1 PIC 9  VALUE ZEROS.
                   15  CD-YY-2 PIC 9  VALUE ZEROS.
               10  DATE-BUF-MM PIC 99 VALUE ZEROS.
               10  DATE-BUF-DD PIC 99 VALUE ZEROS.

       01  CUR-TIME-WA.
           05  CUR-TIME.
               10  CUR-TIME-HH PIC 99 VALUE ZEROS.
               10  CUR-TIME-MM PIC 99 VALUE ZEROS.
           05  CUR-TIME-SS     PIC XXXX.

       01  START-BUFFFER-X9.
           05  START-BUFFER.
               10  START-1-2   PIC 99 VALUE ZEROS.
               10  START-3-4   PIC 99 VALUE ZEROS.
           05  START-BUF       REDEFINES START-BUFFER
                               PIC 9999.

       01  WO-HOLD.
           05  WO-H-1          PIC X.
           05  WO-H-2          PIC X.
           05  WO-H-3          PIC X.
           05  WO-H-4          PIC X.
           05  WO-H-5          PIC X.
           05  WO-H-6          PIC X.

      *---------------------------------------------*
      *--- TASK 2009-00131261-003
      *---------------------------------------------*
      *---   20-YEAR PATTERN
      *--- YEAR        ALPHA
      *    2000-2009   A-K
      *    2010-2019   M-Y
      *    2020-2029   A-K
      *    2030-2039   M-Y
      *    2040-2049   A-K
      *    2050-2059   M-Y
      *---------------------------------------------*
      *--- YEARS THAT USE THE FOLLOWING ALPHA TABLE:
      *--- 2000-2009; 2020-2029; 2040-2049
      *---------------------------------------------*
       01  YEAR-DESIGNATOR.
           05  YEAR-TABLE.
               10  YD-0        PIC X  VALUE "A".
               10  YD-1        PIC X  VALUE "B".
               10  YD-2        PIC X  VALUE "C".
               10  YD-3        PIC X  VALUE "D".
               10  YD-4        PIC X  VALUE "E".
               10  YD-5        PIC X  VALUE "F".
               10  YD-6        PIC X  VALUE "G".
               10  YD-7        PIC X  VALUE "H".
               10  YD-8        PIC X  VALUE "J".
               10  YD-9        PIC X  VALUE "K".
           05  YEAR-COUNTER    REDEFINES YEAR-TABLE.
               10  YEARC       OCCURS 10 TIMES PIC X.

      *---------------------------------------------*
      *--- YEARS THAT USE THE FOLLOWING ALPHA TABLE:
      *--- 2010-2019; 2030-2039; 2050-2059
      *---------------------------------------------*
       01  YEAR-DESIGNATOR2.
           05  YEAR-TABLE2.
               10  YD-0        PIC X  VALUE "M".
               10  YD-1        PIC X  VALUE "N".
               10  YD-2        PIC X  VALUE "P".
               10  YD-3        PIC X  VALUE "R".
               10  YD-4        PIC X  VALUE "S".
               10  YD-5        PIC X  VALUE "T".
               10  YD-6        PIC X  VALUE "V".
               10  YD-7        PIC X  VALUE "W".
               10  YD-8        PIC X  VALUE "X".
               10  YD-9        PIC X  VALUE "Y".

       01  CAT-TEXT-BUFFER.
           05  CAT-TEXT1       PIC X(42).
           05  CAT-TEXT2       PIC X(07).
           05  FILLER          PIC X(25) VALUE SPACES.

       01  DB-ERROR.
           05  DB-FUNC   PIC X(10) VALUE SPACES.
           05  DB-FILE   PIC X(18) VALUE SPACES.
           05  FILLER    PIC X(20) VALUE "ERROR - FILE-STAT = ".
           05  CON-WORD  PIC XX.

           COPY SCREENIO       IN COPYLIB.

           COPY CATREAD        IN COPYLIB.

           COPY JCWAREA        IN COPYLIB.

       01  WO-BASIC-DATA.
           COPY DWOBASIC       IN COPYLIB.

       01  WO-PLANNED-DATA.
           COPY DWOPLAN        IN COPYLIB.

       01  WO-QUEUE-DATA.
           COPY DWOOPENQ       IN COPYLIB.

       01  LABOR-CURR-DATA.
           COPY DCURRLBR       IN COPYLIB.

       01  MESSAGE-BUFFER-DATA.
           COPY ERRORLIN       IN COPYLIB.

       LINKAGE SECTION.
       01  DBPARAMETERS.
           COPY DBPARMS        IN COPYLIB.

       01  WO-TRACK-DATA.
           COPY DWOTRACK       IN COPYLIB.

       PROCEDURE DIVISION      USING DBPARAMETERS
                               WO-TRACK-DATA.

       CHECK-PASSWORD.
           CALL "TPWORD"       USING PASSWORD-INFORMATION.
           IF PASSWORD-FLAG NOT = "N"
               GO TO BEGIN.
           GOBACK.

       BEGIN.
           OPEN INPUT          LAB-CUR-STAT-CC.
           OPEN I-O            LAB-CUR-STAT-WO.
           OPEN INPUT          PER-PERSONNEL.
           OPEN I-O            WO-BASIC.
           OPEN I-O            WO-PLANNED.
           OPEN I-O            DISPLAY-FILE.
           GO TO 1-HSK.

       2-EOJ.
           CLOSE               LAB-CUR-STAT-CC.
           CLOSE               LAB-CUR-STAT-WO.
           CLOSE               PER-PERSONNEL.
           CLOSE               WO-BASIC.
           CLOSE               WO-PLANNED.
           CLOSE               DISPLAY-FILE.
           GOBACK.

       1-HSK.
           ACCEPT DATE-BUF     FROM DATE.
           MOVE 20             TO DATE-BUF-CC.
           IF DATE-BUF-YY > 70
               MOVE 19         TO DATE-BUF-CC.

           ACCEPT CUR-TIME-WA  FROM TIME.
           MOVE CUR-TIME       TO TIME-IN.
           MOVE SPACES         TO TIME-BUF.
           MOVE 0              TO TIME-HOLD S-WINDOW E-WINDOW.
           MOVE "MAST"         TO ZONE-BUF.
           CALL "TGETSHFT"     USING SHIFT-DATA
                               DBPARAMETERS.
           IF SHIFT-DATA = SPACES
               GO TO 6-MAIN.

           ACCEPT CUR-TIME-WA  FROM TIME.
           MOVE S-1            TO START-BUF.
           COMPUTE TIME-HOLD = (60 * START-1-2) + START-3-4.
           COMPUTE S-WINDOW = TIME-HOLD - 21.
           COMPUTE E-WINDOW = TIME-HOLD +  1.
           MOVE CUR-TIME       TO START-BUFFER.
           COMPUTE TIME-HOLD = (60 * START-1-2) + START-3-4.

           IF S-WINDOW > E-WINDOW
               SUBTRACT +1440  FROM S-WINDOW.
           IF TIME-HOLD > E-WINDOW
               SUBTRACT +1440  FROM TIME-HOLD.
           IF TIME-HOLD < S-WINDOW
               ADD +1440       TO TIME-HOLD.
           IF TIME-HOLD > S-WINDOW AND < E-WINDOW
               MOVE S-1        TO TIME-BUF-9.
           IF TIME-BUF NOT = SPACES GO TO 6-MAIN.

           MOVE S-2            TO START-BUF.
           COMPUTE TIME-HOLD = (60 * START-1-2) + START-3-4.
           COMPUTE S-WINDOW = TIME-HOLD - 21.
           COMPUTE E-WINDOW = TIME-HOLD +  1.
           MOVE CUR-TIME       TO START-BUFFER.
           COMPUTE TIME-HOLD = (60 * START-1-2) + START-3-4.

           IF S-WINDOW > E-WINDOW
               SUBTRACT +1440  FROM S-WINDOW.
           IF TIME-HOLD > E-WINDOW
               SUBTRACT +1440  FROM TIME-HOLD.
           IF TIME-HOLD < S-WINDOW
               ADD +1440       TO TIME-HOLD.
           IF TIME-HOLD > S-WINDOW AND < E-WINDOW
               MOVE S-2        TO TIME-BUF-9.
           IF TIME-BUF NOT = SPACES GO TO 6-MAIN.

           IF CODE-BUF = "2" GO TO 6-MAIN.
           MOVE S-3            TO START-BUF.
           COMPUTE TIME-HOLD = (60 * START-1-2) + START-3-4.
           COMPUTE S-WINDOW = TIME-HOLD - 21.
           COMPUTE E-WINDOW = TIME-HOLD +  1.
           MOVE CUR-TIME       TO START-BUFFER.
           COMPUTE TIME-HOLD = (60 * START-1-2) + START-3-4.

           IF S-WINDOW > E-WINDOW
               SUBTRACT +1440  FROM S-WINDOW.
           IF TIME-HOLD > E-WINDOW
               SUBTRACT +1440  FROM TIME-HOLD.
           IF TIME-HOLD < S-WINDOW
               ADD +1440       TO TIME-HOLD.
           IF TIME-HOLD > S-WINDOW AND < E-WINDOW
               MOVE S-3        TO TIME-BUF-9.
           IF TIME-BUF NOT = SPACES GO TO 6-MAIN.

           IF CODE-BUF = "3" GO TO 6-MAIN.
           MOVE S-4            TO START-BUF.
           COMPUTE TIME-HOLD = (60 * START-1-2) + START-3-4.
           COMPUTE S-WINDOW = TIME-HOLD - 21.
           COMPUTE E-WINDOW = TIME-HOLD +  1.
           MOVE CUR-TIME       TO START-BUFFER.
           COMPUTE TIME-HOLD = (60 * START-1-2) + START-3-4.

           IF S-WINDOW > E-WINDOW
               SUBTRACT +1440  FROM S-WINDOW.
           IF TIME-HOLD > E-WINDOW
               SUBTRACT +1440  FROM TIME-HOLD.
           IF TIME-HOLD < S-WINDOW
               ADD +1440       TO TIME-HOLD.
           IF TIME-HOLD > S-WINDOW AND < E-WINDOW
               MOVE S-4        TO TIME-BUF-9.

       6-MAIN.
           MOVE ZEROS          TO COMPLETE-COUNTERS.
           ACCEPT CUR-TIME-WA  FROM TIME.
           IF TIME-BUF = SPACES
               MOVE CUR-TIME   TO TIME-BUF-9.
           MOVE "VSTARTUP"     TO SCREEN-NAME.

           MOVE SPACES         TO SCREEN-DATA MESSAGE-BUFFER.
           MOVE TIME-BUF       TO START-TIME.
      *-----------------------------------------------*
      *--- TASK 2009-00131261-003
      *-----------------------------------------------*
           IF CD-YY-1 = 1 OR 3 OR 5 OR 7 OR 9
             MOVE YEAR-DESIGNATOR2 TO YEAR-DESIGNATOR.
      *-----------------------------------------------*
           MOVE CD-YY-2        TO SUB1.
           ADD 1               TO SUB1.
           MOVE YEARC (SUB1)   TO IP-WO-1-7 IP-WO-2-7.
           MOVE YEARC (SUB1)   TO IP-WO-3-7 IP-WO-4-7.
           MOVE YEARC (SUB1)   TO IP-WO-5-7 IP-WO-6-7.
           MOVE YEARC (SUB1)   TO IP-WO-7-7 IP-WO-8-7.
           MOVE 0              TO SUB1.
      **********************************************************************
      **    MESSAGE 031/001:
      ** ENTER THE C/C# AND THE W/O# BEING ASSIGNED TO THAT C/C#, PRESS 'ENTER'
      **********************************************************************
           MOVE  31            TO CATREAD-MSG-SET.
           MOVE   1            TO CATREAD-MSG-NUM.
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
           MOVE MESSAGE-BUFFER TO COMM-1.

       61-SHOWFORM.
           MOVE 0              TO EDIT-SW.
           MOVE SPACES         TO MESSAGE-BUFFER.
           MOVE "00"           TO SCREEN-STATUS.
           MOVE SCREEN-DATA    TO DISPLAY-REC.

           WRITE DISPLAY-REC   FORMAT IS SCREEN-NAME
               INDIC ARE SCREEN-INDICATORS.
           IF SCREEN-STATUS NOT = "00"
               DISPLAY "SCREEN WRITE ERROR.  SCREEN-STATUS IS "
                        SCREEN-STATUS
               GO TO 2-EOJ.

           READ  DISPLAY-FILE  FORMAT IS SCREEN-NAME
               INDIC ARE SCREEN-INDICATORS
           IF SCREEN-STATUS NOT = "00"
               DISPLAY "SCREEN READ ERROR.  SCREEN-STATUS IS "
                        SCREEN-STATUS
               GO TO 2-EOJ.

           MOVE DISPLAY-REC    TO SCREEN-DATA.
           MOVE ALL B"0"       TO SCREEN-INDICATORS.

           IF KEY-HIT = 1 OR 3
               GO TO 2-EOJ
           ELSE
           IF KEY-HIT > 0 AND < 8
               GO TO 61-SHOWFORM.

           IF IP-WO-1-6 NOT = SPACES
               MOVE IP-WO-1-6  TO WO-HOLD
               IF WO-H-1 = "X"
                   NEXT SENTENCE
               ELSE
                   PERFORM 642-WO-ADJUST UNTIL WO-H-6 NOT = SPACE
                   MOVE WO-HOLD TO IP-WO-1-6.

           IF IP-WO-2-6 NOT = SPACES
               MOVE IP-WO-2-6  TO WO-HOLD
               IF WO-H-1 = "D"
                   MOVE IP-WO-1 TO IP-WO-2
               ELSE
               IF WO-H-1 = "X"
                   NEXT SENTENCE
               ELSE
                   PERFORM 642-WO-ADJUST UNTIL WO-H-6 NOT = SPACE
                   MOVE WO-HOLD TO IP-WO-2-6.

           IF IP-WO-3-6 NOT = SPACES
               MOVE IP-WO-3-6  TO WO-HOLD
               IF WO-H-1 = "D"
                   MOVE IP-WO-2 TO IP-WO-3
               ELSE
               IF WO-H-1 = "X"
                   NEXT SENTENCE
               ELSE
                   PERFORM 642-WO-ADJUST UNTIL WO-H-6 NOT = SPACE
                   MOVE WO-HOLD TO IP-WO-3-6.

           IF IP-WO-4-6 NOT = SPACES
               MOVE IP-WO-4-6  TO WO-HOLD
               IF WO-H-1 = "D"
                   MOVE IP-WO-3 TO IP-WO-4
               ELSE
               IF WO-H-1 = "X"
                   NEXT SENTENCE
               ELSE
                   PERFORM 642-WO-ADJUST UNTIL WO-H-6 NOT = SPACE
                   MOVE WO-HOLD TO IP-WO-4-6.

           IF IP-WO-5-6 NOT = SPACES
               MOVE IP-WO-5-6  TO WO-HOLD
               IF WO-H-1 = "D"
                   MOVE IP-WO-4 TO IP-WO-5
               ELSE
               IF WO-H-1 = "X"
                   NEXT SENTENCE
               ELSE
                   PERFORM 642-WO-ADJUST UNTIL WO-H-6 NOT = SPACE
                   MOVE WO-HOLD TO IP-WO-5-6.

           IF IP-WO-6-6 NOT = SPACES
               MOVE IP-WO-6-6  TO WO-HOLD
               IF WO-H-1 = "D"
                   MOVE IP-WO-5 TO IP-WO-6
               ELSE
               IF WO-H-1 = "X"
                   NEXT SENTENCE
               ELSE
                   PERFORM 642-WO-ADJUST UNTIL WO-H-6 NOT = SPACE
                   MOVE WO-HOLD TO IP-WO-6-6.

           IF IP-WO-7-6 NOT = SPACES
               MOVE IP-WO-7-6  TO WO-HOLD
               IF WO-H-1 = "D"
                   MOVE IP-WO-6 TO IP-WO-7
               ELSE
               IF WO-H-1 = "X"
                   NEXT SENTENCE
               ELSE
                   PERFORM 642-WO-ADJUST UNTIL WO-H-6 NOT = SPACE
                   MOVE WO-HOLD TO IP-WO-7-6.

           IF IP-WO-8-6 NOT = SPACES
               MOVE IP-WO-8-6  TO WO-HOLD
               IF WO-H-1 = "D"
                   MOVE IP-WO-7 TO IP-WO-8
               ELSE
               IF WO-H-1 = "X"
                   NEXT SENTENCE
               ELSE
                   PERFORM 642-WO-ADJUST UNTIL WO-H-6 NOT = SPACE
                   MOVE WO-HOLD TO IP-WO-8-6.

           IF CMPL-1 = 1       MOVE SPACES TO IP-1ST.
           IF CMPL-2 = 1       MOVE SPACES TO IP-2ND.
           IF CMPL-3 = 1       MOVE SPACES TO IP-3RD.
           IF CMPL-4 = 1       MOVE SPACES TO IP-4TH.
           IF CMPL-5 = 1       MOVE SPACES TO IP-5TH.
           IF CMPL-6 = 1       MOVE SPACES TO IP-6TH.
           IF CMPL-7 = 1       MOVE SPACES TO IP-7TH.

           PERFORM 64-EDIT-UPDATE THRU 64-EU-EXIT.
           IF EDIT-SW-ON
               MOVE HIGH-VALUES TO WONUM OF WO-BASIC
                                   WONUM OF WO-PLANNED
                                   WONUM OF LAB-CUR-STAT-WO
               START LAB-CUR-STAT-WO
                               KEY = WONUM OF LAB-CUR-STAT-WO
                   INVALID KEY MOVE FILE-STAT TO FILE-STAT
                   END-START
               START WO-BASIC  KEY = WONUM OF WO-BASIC
                   INVALID KEY MOVE FILE-STAT TO FILE-STAT
                   END-START
               START WO-PLANNED KEY = WONUM OF WO-PLANNED
                   INVALID KEY  MOVE FILE-STAT TO FILE-STAT
                   END-START
               GO TO 61-SHOWFORM.

           MOVE HIGH-VALUES    TO WONUM OF WO-BASIC
                                  WONUM OF WO-PLANNED
                                  WONUM OF LAB-CUR-STAT-WO.
           START LAB-CUR-STAT-WO
                               KEY = WONUM OF LAB-CUR-STAT-WO
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           START WO-BASIC      KEY = WONUM OF WO-BASIC
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           START WO-PLANNED    KEY = WONUM OF WO-PLANNED
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           GO TO 6-MAIN.

       62-RT-EXIT.    EXIT.

       64-EDIT-UPDATE.
           MOVE 1              TO COUNTER.
           MOVE IP-1ST         TO IP-BUFFER.
           IF CC-BUF-1 = "X"   MOVE SPACES TO CC-BUF.
           IF CC-BUF NOT = SPACES
               PERFORM 640-EDIT-CHECK THRU 640-EC-EXIT.
           IF EDIT-SW-ON GO    TO 64-EU-EXIT.
           MOVE 1              TO CMPL-1.

           MOVE 5              TO COUNTER.
           MOVE IP-2ND         TO IP-BUFFER.
           IF CC-BUF-1 = "X"   MOVE SPACES TO CC-BUF.
           IF CC-BUF NOT = SPACES
               PERFORM 640-EDIT-CHECK THRU 640-EC-EXIT.
           IF EDIT-SW-ON GO    TO 64-EU-EXIT.
           MOVE 1              TO CMPL-2.

           MOVE 9              TO COUNTER.
           MOVE IP-3RD         TO IP-BUFFER.
           IF CC-BUF-1 = "X"   MOVE SPACES TO CC-BUF.
           IF CC-BUF NOT = SPACES
               PERFORM 640-EDIT-CHECK THRU 640-EC-EXIT.
           IF EDIT-SW-ON GO    TO 64-EU-EXIT.
           MOVE 1              TO CMPL-3.

           MOVE 13             TO COUNTER.
           MOVE IP-4TH         TO IP-BUFFER.
           IF CC-BUF-1 = "X"   MOVE SPACES TO CC-BUF.
           IF CC-BUF NOT = SPACES
               PERFORM 640-EDIT-CHECK THRU 640-EC-EXIT.
           IF EDIT-SW-ON GO    TO 64-EU-EXIT.
           MOVE 1              TO CMPL-4.

           MOVE 17             TO COUNTER.
           MOVE IP-5TH         TO IP-BUFFER.
           IF CC-BUF-1 = "X"   MOVE SPACES TO CC-BUF.
           IF CC-BUF NOT = SPACES
               PERFORM 640-EDIT-CHECK THRU 640-EC-EXIT.
           IF EDIT-SW-ON GO    TO 64-EU-EXIT.
           MOVE 1              TO CMPL-5.

           MOVE 21             TO COUNTER.
           MOVE IP-6TH         TO IP-BUFFER.
           IF CC-BUF-1 = "X"   MOVE SPACES TO CC-BUF.
           IF CC-BUF NOT = SPACES
               PERFORM 640-EDIT-CHECK THRU 640-EC-EXIT.
           IF EDIT-SW-ON GO    TO 64-EU-EXIT.
           MOVE 1              TO CMPL-6.

           MOVE 25             TO COUNTER.
           MOVE IP-7TH         TO IP-BUFFER.
           IF CC-BUF-1 = "X"   MOVE SPACES TO CC-BUF.
           IF CC-BUF NOT = SPACES
               PERFORM 640-EDIT-CHECK THRU 640-EC-EXIT.
           IF EDIT-SW-ON GO    TO 64-EU-EXIT.
           MOVE 1              TO CMPL-7.

           MOVE 29             TO COUNTER.
           MOVE IP-8TH         TO IP-BUFFER.
           IF CC-BUF-1 = "X"   MOVE SPACES TO CC-BUF.
           IF CC-BUF NOT = SPACES
               PERFORM 640-EDIT-CHECK THRU 640-EC-EXIT.

       64-EU-EXIT.             EXIT.

       640-EDIT-CHECK.
           MOVE WO-BUF-6       TO WO-HOLD.
           IF WO-H-1 = "X"
               GO TO 640-EC-EXIT.
           COMPUTE KOUNTER = COUNTER + 1.
           IF CC-BUF = "NEWS" OR "9999"
      **********************************************************************
      **    MESSAGE 035/047:
      ** INVALID CLOCK CARD NUMBER
      **********************************************************************
               MOVE  35        TO CATREAD-MSG-SET
               MOVE  47        TO CATREAD-MSG-NUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE COUNTER    TO FIELD-NUMBER
               PERFORM 65-ERROR
               MOVE 1          TO EDIT-SW
               GO TO 640-EC-EXIT.

           MOVE CC-BUF         TO PERCCNUM OF PER-PERSONNEL.
           START PER-PERSONNEL
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
               IF FILE-STAT-1 = "2"
      **********************************************************************
      **    MESSAGE 035/047:
      ** INVALID CLOCK CARD NUMBER
      **********************************************************************
                   MOVE  35    TO CATREAD-MSG-SET
                   MOVE  47    TO CATREAD-MSG-NUM
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE COUNTER TO FIELD-NUMBER
                   PERFORM 65-ERROR
                   MOVE 1      TO EDIT-SW
                   GO TO 640-EC-EXIT
               ELSE
               MOVE FILE-STAT  TO CON-WORD
               MOVE "START   " TO DB-FUNC
               MOVE "PER-PERSONNEL" TO DB-FILE
               MOVE DB-ERROR   TO MESSAGE-BUFFER
               MOVE COUNTER    TO FIELD-NUMBER
               PERFORM 65-ERROR
               MOVE 1          TO EDIT-SW
               GO TO 640-EC-EXIT.

           MOVE CC-BUF         TO PERCCNUM OF LAB-CUR-STAT-CC.
           START LAB-CUR-STAT-CC
                               KEY = PERCCNUM OF LAB-CUR-STAT-CC
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
               IF FILE-STAT-1 = "2"
                   GO TO 640-EU-CONT
               ELSE
                   MOVE FILE-STAT  TO CON-WORD
                   MOVE "START   " TO DB-FUNC
                   MOVE "LAB-CUR-STAT-CC" TO DB-FILE
                   MOVE DB-ERROR   TO MESSAGE-BUFFER
                   MOVE COUNTER    TO FIELD-NUMBER
                   PERFORM 65-ERROR
                   MOVE 1          TO EDIT-SW
                   GO TO 640-EC-EXIT.

           READ LAB-CUR-STAT-CC NEXT INTO LABOR-CURR-DATA
               AT END           MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
               IF FILE-STAT = "10" OR "14" OR "46"
                   GO TO 640-EU-CONT
               ELSE
               MOVE FILE-STAT  TO CON-WORD
               MOVE "READ    " TO DB-FUNC
               MOVE "LAB-CUR-STAT-CC" TO DB-FILE
               MOVE DB-ERROR   TO MESSAGE-BUFFER
               MOVE COUNTER    TO FIELD-NUMBER
               PERFORM 65-ERROR
               MOVE 1          TO EDIT-SW
               GO TO 640-EC-EXIT.

           IF CC-BUF NOT = LCS-EMPL-NUM
               GO TO 640-EU-CONT.

      **********************************************************************
      **    MESSAGE 029/040:
      ** CLOCK CARD NUMBER ALREADY IP ON WORKORDER
      **********************************************************************
           MOVE  29            TO CATREAD-MSG-SET.
           MOVE  40            TO CATREAD-MSG-NUM.
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
           MOVE MESSAGE-BUFFER TO CAT-TEXT1.
           MOVE LCS-WO-NUM-7   TO CAT-TEXT2.
           MOVE CAT-TEXT-BUFFER TO COMM-1.

      **********************************************************************
      **    MESSAGE 029/015:
      ** CORRECT THE NUM OR PUT 'X' IN 1ST POSITION TO SKIP AND PRESS 'ENTER'
      **********************************************************************
           MOVE  29            TO CATREAD-MSG-SET.
           MOVE  15            TO CATREAD-MSG-NUM.
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
           MOVE MESSAGE-BUFFER TO COMM-2.
           MOVE SPACES         TO MESSAGE-BUFFER.
           MOVE COUNTER        TO FIELD-NUMBER.
           PERFORM 65-ERROR.
           MOVE 1              TO EDIT-SW.
           GO TO 640-EC-EXIT.

       640-EU-CONT.
           MOVE SPACES         TO WO-BASIC-DATA WO-PLANNED-DATA.
           MOVE 1              TO FILE-SW.
           MOVE 0              TO ERROR-SW.
           MOVE WO-BUF         TO WONUM OF WO-BASIC
                                  WONUM OF WO-PLANNED.
           START WO-BASIC      KEY = WONUM OF WO-BASIC
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT = ZEROS
               IF WO-BUF = WONUM OF WO-BASIC
                   GO TO READ-BASIC.

           START WO-PLANNED    KEY = WONUM OF WO-PLANNED
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT = ZEROS
               IF WO-BUF = WONUM OF WO-PLANNED
                   GO TO READ-PLANNED.

      **********************************************************************
      **    MESSAGE 035/040:
      ** INVALID WORKORDER NUMBER
      **********************************************************************
           MOVE  35            TO CATREAD-MSG-SET.
           MOVE  40            TO CATREAD-MSG-NUM.
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
           MOVE KOUNTER        TO FIELD-NUMBER.
           PERFORM 65-ERROR.
           MOVE 1              TO EDIT-SW.
           GO TO 640-EC-EXIT.

       READ-BASIC.
           READ WO-BASIC       INTO WO-BASIC-DATA
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = ZEROS
               MOVE "READ    " TO DB-FUNC
               MOVE "WO-BASIC" TO DB-FILE
               MOVE DB-ERROR   TO MESSAGE-BUFFER
               MOVE KOUNTER    TO FIELD-NUMBER
               PERFORM 65-ERROR
               MOVE 1          TO EDIT-SW
               GO TO 640-EC-EXIT.

           GO TO CONT-PROC.

       READ-PLANNED.
           READ WO-PLANNED     INTO WO-PLANNED-DATA
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = ZEROS
               MOVE "READ    " TO DB-FUNC
               MOVE "WO-PLANNED" TO DB-FILE
               MOVE DB-ERROR   TO MESSAGE-BUFFER
               MOVE KOUNTER    TO FIELD-NUMBER
               PERFORM 65-ERROR
               MOVE 1          TO EDIT-SW
               GO TO 640-EC-EXIT.

           MOVE 2              TO FILE-SW.

       CONT-PROC.
           IF BASIC-FILE
               MOVE WO-STATUS  TO STATUS-BUF
           ELSE
               MOVE WO-STATUS-P TO STATUS-BUF
               IF EXP-CLASS-P = SPACES
      **********************************************************************
      **    MESSAGE 049/016:
      ** W/O HAS NO EXPENSE CLASS
      **********************************************************************
                   MOVE  49    TO CATREAD-MSG-SET
                   MOVE  16    TO CATREAD-MSG-NUM
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE MESSAGE-BUFFER TO COMM-1
      **********************************************************************
      **    MESSAGE 029/015:
      ** CORRECT THE NUM OR PUT 'X' IN 1ST POSITION TO SKIP AND PRESS 'ENTER'
      **********************************************************************
                   MOVE  29    TO CATREAD-MSG-SET
                   MOVE  15    TO CATREAD-MSG-NUM
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE MESSAGE-BUFFER TO COMM-2
                   MOVE SPACES TO MESSAGE-BUFFER
                   MOVE KOUNTER TO FIELD-NUMBER
                   PERFORM 65-ERROR
                   MOVE 1      TO EDIT-SW
                   GO TO 640-EC-EXIT.

           IF BASIC-FILE
               NEXT SENTENCE
           ELSE
               IF STATUS-BUF = "OO"
                   MOVE "XX"   TO STATUS-BUF.

           IF STATUS-BUF = "OO" OR "IP" OR "HL" OR "SW" OR
                           "HM" OR "HS" OR "SD" OR "PR"
               NEXT SENTENCE
           ELSE
      **********************************************************************
      **    MESSAGE 049/001:
      ** WORKORDER NUMBER CANNOT BE PLACED 'IP'
      **********************************************************************
               MOVE  49        TO CATREAD-MSG-SET
               MOVE   1        TO CATREAD-MSG-NUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER TO COMM-1
      **********************************************************************
      **    MESSAGE 029/015:
      ** CORRECT THE NUM OR PUT 'X' IN 1ST POSITION TO SKIP AND PRESS 'ENTER'
      **********************************************************************
               MOVE  29        TO CATREAD-MSG-SET
               MOVE  15        TO CATREAD-MSG-NUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER TO COMM-2
               MOVE KOUNTER    TO FIELD-NUMBER
               PERFORM 65-ERROR
               MOVE 1          TO EDIT-SW
               GO TO 640-EC-EXIT.

           IF PLANNED-FILE
               IF APPROVAL-CODE-P = "U "
      **********************************************************************
      **    MESSAGE 038/011:
      ** LABOR CANNOT BE ADDED TO UNAPPROVED W/O
      **********************************************************************
                   MOVE  38    TO CATREAD-MSG-SET
                   MOVE  11    TO CATREAD-MSG-NUM
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE MESSAGE-BUFFER TO COMM-1
      **********************************************************************
      **    MESSAGE 029/015:
      ** CORRECT THE NUM OR PUT 'X' IN 1ST POSITION TO SKIP AND PRESS 'ENTER'
      **********************************************************************
                   MOVE  29    TO CATREAD-MSG-SET
                   MOVE  15    TO CATREAD-MSG-NUM
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE MESSAGE-BUFFER TO COMM-2
                   MOVE SPACES TO MESSAGE-BUFFER
                   MOVE KOUNTER TO FIELD-NUMBER
                   PERFORM 65-ERROR
                   MOVE 1      TO EDIT-SW
                   GO TO 640-EC-EXIT
               ELSE
               IF WO-NUM-SUFF-P = "000"
      **********************************************************************
      **    MESSAGE 029/116:
      ** CANNOT WRITE LABOR TO A MASTER SUFFIXED WORKORDER
      **********************************************************************
                   MOVE  29    TO CATREAD-MSG-SET
                   MOVE 116    TO CATREAD-MSG-NUM
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE MESSAGE-BUFFER TO COMM-1
      **********************************************************************
      **    MESSAGE 029/015:
      ** CORRECT THE NUM OR PUT 'X' IN 1ST POSITION TO SKIP AND PRESS 'ENTER'
      **********************************************************************
                   MOVE  29    TO CATREAD-MSG-SET
                   MOVE  15    TO CATREAD-MSG-NUM
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE MESSAGE-BUFFER TO COMM-2
                   MOVE SPACES TO MESSAGE-BUFFER
                   MOVE KOUNTER TO FIELD-NUMBER
                   PERFORM 65-ERROR
                   MOVE 1      TO EDIT-SW
      *            GO TO 640-EC-EXIT
      *        ELSE
      *        IF WO-CURRENT-TYPE = "E"
      **********************************************************************
      **    MESSAGE 029/118:
      ** CANNOT WRITE LABOR TO A WORKORDER IN THE ENGINEERING LOOP
      **********************************************************************
      *            MOVE  29    TO CATREAD-MSG-SET
      *            MOVE 118    TO CATREAD-MSG-NUM
      *            PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
      *            MOVE MESSAGE-BUFFER TO COMM-1
      **********************************************************************
      **    MESSAGE 029/015:
      ** CORRECT THE NUM OR PUT 'X' IN 1ST POSITION TO SKIP AND PRESS 'ENTER'
      **********************************************************************
      *            MOVE  29    TO CATREAD-MSG-SET
      *            MOVE  15    TO CATREAD-MSG-NUM
      *            PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
      *            MOVE MESSAGE-BUFFER TO COMM-2
      *            MOVE SPACES TO MESSAGE-BUFFER
      *            MOVE KOUNTER TO FIELD-NUMBER
      *            PERFORM 65-ERROR
      *            MOVE 1      TO EDIT-SW
                   GO TO 640-EC-EXIT.

           IF BASIC-FILE
               PERFORM 644-UPDATE-BASIC THRU 644-UB-EXIT
           ELSE
               PERFORM 644-UPDATE-PLANNED THRU 644-UP-EXIT.

       640-EC-EXIT.    EXIT.

       642-WO-ADJUST.
           MOVE WO-H-5         TO WO-H-6.
           MOVE WO-H-4         TO WO-H-5.
           MOVE WO-H-3         TO WO-H-4.
           MOVE WO-H-2         TO WO-H-3.
           MOVE WO-H-1         TO WO-H-2.
           MOVE "0"            TO WO-H-1.

       644-UPDATE-BASIC.
           IF CRAFTSMEN-1 = SPACES
               MOVE CC-BUF     TO CRAFTSMEN-1
           ELSE
           IF CRAFTSMEN-2 = SPACES
               MOVE CC-BUF     TO CRAFTSMEN-2
           ELSE
           IF CRAFTSMEN-3 = SPACES
               MOVE CC-BUF     TO CRAFTSMEN-3.

           IF DATE-STRT NOT NUMERIC
               MOVE DATE-BUF-CN TO DATE-STRT-CN
               MOVE TIME-BUF   TO TIME-STRT.

           IF WO-STATUS NOT = "SW"
               MOVE "IP"       TO WO-STATUS.

           REWRITE VWO-REC     FROM WO-BASIC-DATA
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
               GO TO 2-EOJ.

           MOVE SPACES         TO T-WO-DATA T-STATUS-DATA.
           MOVE "TSFTSTRT"     TO PROGRAM-NAME.
           MOVE WO-NUM         TO WO-NUM-TRACK.
           MOVE DATE-BUF-CN    TO DATE-STAMP-CN.
           MOVE CUR-TIME       TO TIME-STAMP.
           MOVE WO-STRT-STATUS TO WO-TYPE-STATUS.
           MOVE "SUPV"         TO USER-ID.
           MOVE CC-BUF         TO CLOCK-CARD.
           MOVE WO-STATUS      TO WO-STATUS-TRACK.
           MOVE "IP"           TO TRANS-STATUS.
           CALL "TWOTRACK"     USING WO-TRACK-DATA.
           MOVE SPACES         TO WO-QUEUE-DATA.
           MOVE WO-NUM         TO Q-WO-NUM.
           MOVE "D"            TO QUEUE-SW.
           CALL "TQUPDATE"     USING DBPARAMETERS
                               WO-QUEUE-DATA
                               QUEUE-SW
                               QUEUE-ERROR.
           PERFORM 644-UPDATE-TEMP-LABOR THRU 644-UTL-EXIT.

       644-UB-EXIT.    EXIT.

       644-UPDATE-PLANNED.
           IF DATE-STRT-P NOT NUMERIC
               MOVE DATE-BUF-CN TO DATE-STRT-P-CN
               MOVE TIME-BUF   TO TIME-STRT-P.

           IF WO-STATUS-P NOT = "SW"
               MOVE "IP"       TO WO-STATUS-P.

           REWRITE PWO-REC     FROM WO-PLANNED-DATA
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
               GO TO 2-EOJ.

           IF WO-START-STATUS = "AA"
               MOVE 0          TO RETURN-COD
               MOVE SPACES     TO RETURN-ERROR
               MOVE "IP"       TO UPDATE-CODE
               CALL "SPMCWSD"  USING WO-NUM-PLANNED
                               UPDATE-CODE
                               DATE-BUF
                               DBPARAMETERS
                               RETURN-COD
                               RETURN-ERROR.

           MOVE SPACES         TO T-WO-DATA T-STATUS-DATA.
           MOVE "TSFTSTRT"     TO PROGRAM-NAME.
           MOVE WO-NUM-PLANNED TO WO-NUM-TRACK.
           MOVE DATE-BUF-CN    TO DATE-STAMP-CN.
           MOVE CUR-TIME       TO TIME-STAMP.
           MOVE WO-START-STATUS TO WO-TYPE-STATUS.
           MOVE "SUPV"         TO USER-ID.
           MOVE CC-BUF         TO CLOCK-CARD.
           MOVE WO-STATUS-P    TO WO-STATUS-TRACK.
           MOVE "IP"           TO TRANS-STATUS.
           CALL "TWOTRACK"     USING WO-TRACK-DATA.
           PERFORM 644-UPDATE-TEMP-LABOR THRU 644-UTL-EXIT.

       644-UP-EXIT.    EXIT.

       644-UPDATE-TEMP-LABOR.
           MOVE WO-BUF         TO WONUM OF LAB-CUR-STAT-WO.
           START LAB-CUR-STAT-WO
                               KEY = WONUM OF LAB-CUR-STAT-WO
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
               IF FILE-STAT-1 = "2"
                   GO TO 644-UTL-UPDATE
               ELSE
                   GO TO 2-EOJ.

       644-UTL-DBGET.
           READ LAB-CUR-STAT-WO NEXT INTO LABOR-CURR-DATA
               AT END           MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
               IF FILE-STAT = "10" OR "14" OR "46"
                   GO TO 644-UTL-UPDATE
               ELSE
                   GO TO 2-EOJ.

           IF WO-BUF NOT = LCS-WO-NUM
               GO TO 644-UTL-UPDATE.

           IF CC-BUF = LCS-EMPL-NUM
               GO TO 644-UTL-EXIT
           ELSE
               GO TO 644-UTL-DBGET.

       644-UTL-UPDATE.
           MOVE SPACES         TO LABOR-CURR-STAT.
           MOVE CC-BUF         TO LCS-EMPL-NUM.
           MOVE WO-BUF         TO LCS-WO-NUM.
           MOVE DATE-BUF-CN    TO LCS-START-DATE-CN.
           MOVE TIME-BUF       TO LCS-START-TIME.

           WRITE LWO-REC       FROM LABOR-CURR-STAT
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
               GO TO 2-EOJ.

       644-UTL-EXIT.    EXIT.

       65-ERROR.
           MOVE MESSAGE-BUFFER TO ERRMSG.
           MOVE TRUE-VAL       TO IND(FIELD-NUMBER) IND(99).

       999-CATREAD.
           MOVE SPACES         TO MESSAGE-BUFFER.
           CALL "CCATREAD"     USING CATREAD-PARMS.
            MOVE CATREAD-MSG-TEXT TO MESSAGE-BUFFER.

       999-CATREAD-EXIT.    EXIT.

