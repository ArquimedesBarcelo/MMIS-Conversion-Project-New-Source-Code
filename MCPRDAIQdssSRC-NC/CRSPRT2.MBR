      **************************************************************
       01  SPOOLER-PARAMETERS.
           05  SPOOL-STATUS          PIC S9       VALUE ZERO COMP-4.
           05  SPOOL-MESSAGE         PIC X(75)    VALUE SPACES.
           05  FILLER                PIC X        VALUE SPACES.
           05  SPOOL-COPIES          PIC S9(2)    VALUE 1    COMP-4.
           05  SPOOL-PRIORITY        PIC S9       VALUE ZERO COMP-4.
           05  ACCTG-STATUS          PIC S9       VALUE ZERO COMP-4.
           05  ACCTG-MESSAGE         PIC X(75)    VALUE SPACES.
           05  FILLER                PIC X        VALUE SPACES.
           05  ACCTG-COPIES          PIC S9(2)    VALUE 1     COMP-4.
           05  ACCTG-PRIORITY        PIC S9       VALUE ZERO  COMP-4.
      *----------  THE FOLLOWING DATA IS FOR 3RD PRTR IN SUBPLANTS ONLY
           05  THIRD-STATUS          PIC S9       VALUE ZERO  COMP-4.
           05  THIRD-MESSAGE         PIC X(75)    VALUE SPACES.
           05  FILLER                PIC X        VALUE SPACES.
           05  THIRD-COPIES          PIC S9(2)    VALUE 1     COMP-4.
           05  THIRD-PRIORITY        PIC S9       VALUE ZERO  COMP-4.
       COPY TBLOWUP   OF COPYLIB.
       COPY TDATECHK  OF COPYLIB.
       COPY OVRPFDATA OF COPYLIB.
       COPY CCHKOBJ   OF COPYLIB.
       COPY CDESC     OF COPYLIB.
       COPY CNDESC    OF COPYLIB.
       COPY CATREAD   OF COPYLIB.
       COPY CCRTFILE IN COPYLIB.
       01  RET-CODE                  PIC X(2)     VALUE SPACES.
       COPY DBMODES   OF COPYLIB.
       COPY DBSTAT    OF COPYLIB.
       01  ALL-ITEM-LIST                PIC X(2)  VALUE "@;".

       01  CCRQDESC-PARMS.
           05  CCRQDESC-CODE          PIC X(7).
           05  CCRQDESC-LINES.
               10  CCRQDESC-LINE  OCCURS 10 TIMES
                                      PIC X(80).

      *----------  ARGUMENT VALUES
       01  CODE-ARG                   PIC X(8)   VALUE SPACES.
       01  PO-ARG                     PIC X(14)  VALUE SPACES.
       01  VEN-ARG                    PIC X(10)  VALUE SPACES.
       01  REQ-ARG                    PIC X(12) VALUE SPACES.
       01  FRT-ARG                    PIC X(14) VALUE SPACES.
       01  EMPL-ARG                   PIC X(6)   VALUE SPACES.
       01  COMMENT-ARG                PIC X(4)   VALUE SPACES.

