           MOVE 46                           TO LANG-MSGNUM.
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
           MOVE MESSAGE-BUFFER               TO HDR6-CODE.
           MOVE 47                           TO LANG-MSGNUM.
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
           MOVE MESSAGE-BUFFER               TO HDR6-DESC.
           MOVE 48                           TO LANG-MSGNUM.
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
           MOVE MESSAGE-BUFFER               TO PRICE-QTY-SAVE.
           MOVE 50                           TO LANG-MSGNUM.
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
           MOVE MESSAGE-BUFFER               TO LOT-MSG-WS.
           MOVE 51                           TO LANG-MSGNUM.
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
           MOVE MESSAGE-BUFFER               TO TALLY-MSG-WS.
           MOVE 52                           TO LANG-MSGNUM.
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
           MOVE MESSAGE-BUFFER               TO MSG61.
           MOVE 53                           TO LANG-MSGNUM.
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
           MOVE MESSAGE-BUFFER               TO MSG62.
           MOVE MISC-RS-ARG TO WS-RECEIVER, WS-ACCUMULATOR.
           MOVE "000" TO WS-ACCUM-RS.
           MOVE WS-ACCUMULATOR TO PO-ARG.
           MOVE PLT-NUMBER TO WHICH-PLANT.

           MOVE "MCFPCS7000"   TO  CHKOBJ-FILE-NAME.
           CALL "CCHKOBJ" USING    CHKOBJ-FILE-NAME,
                                   CHKOBJ-RETURN-STATUS.
           IF CHKOBJ-RETURN-STATUS  = "00"
               MOVE "Y"        TO  PRINT-DCOMPL-SW
           ELSE
               MOVE "N"        TO  PRINT-DCOMPL-SW.

           OPEN INPUT DVENDOR
                      DPOITEM
                      MPORCV
                      DREQD
                      MSTORERM
                      MREQ
                      DVENDITM
                      DPOFREIGHT
                      DRCVITEM
                      DPODATAITM
                      DPORECD
                      PER-PERSONNEL
                      DCHATNO
                      DCOMMENT.
           PERFORM 100-GET-DPORECD THRU 199-EXIT.
           IF NO-RECEIVER
              GO TO 09-EXIT.

           PERFORM 040-OPEN-SPOOLFILES THRU 049-EXIT.

           PERFORM 200-GET-DPOFREIGHT THRU 299-EXIT.

           PERFORM 400-FIND-RECEIVER THRU 499-EXIT.

      *----------  GET BEFORE/AFTER RCV INSTRUCTIONS
           PERFORM 600-GET-RCV-INST THRU 600-GRI-X.

           PERFORM 500-PRINT-RCVR THRU 599-EXIT.

      *----------  PRINT RCV AFTER INSTRUCTIONS
           IF RCV-AFTER-INST NOT = SPACES
              MOVE 1 TO LINE-ADV
              ADD  1 TO LINE-CTR
              MOVE SPACES TO PRINT-RCD
              PERFORM 860-PRT-LINE THRU 869-EXIT
              PERFORM 601-PRINT-RCV-INST THRU 601-PRI-X
                  VARYING SUB FROM 7 BY 1
                    UNTIL SUB > 12.

      *----------  PRINT END OF RECEIVER MESSAGE
           MOVE 1 TO LINE-ADV.
           ADD 1 TO LINE-CTR.
           MOVE SPACES TO PRINT-RCD.
           MOVE END-RCV-MSG TO PRINT-RCD.
           PERFORM 860-PRT-LINE THRU 869-EXIT.

           PERFORM 050-CLOSE-SPOOLFILES THRU 059-EXIT.

       09-EXIT.
           GOBACK.
      *************************************************************
      **      OPEN AS MANY SPOOLFILES AS WERE REQUESTED          **
      *************************************************************
       040-OPEN-SPOOLFILES.
           MOVE SPOOL-PRT-NO TO OVRPRTF-TOFILE-NUM.
           MOVE "MCPRT"      TO OVRPRTF-FILE.
           PERFORM 996-OVERRIDE-PRINT-FILE.
           OPEN OUTPUT ONLINE-PRT.

           IF ACCTG-PRT-NO NOT = ZEROES
              MOVE ACCTG-PRT-NO TO OVRPRTF-TOFILE-NUM
              MOVE "MCPRT2"     TO OVRPRTF-FILE
              PERFORM 996-OVERRIDE-PRINT-FILE
              OPEN OUTPUT ACCTG-PRT.

           IF PRINT-PRT-NO NOT = ZEROES
              MOVE PRINT-PRT-NO TO OVRPRTF-TOFILE-NUM
              MOVE "MCPRT3"     TO OVRPRTF-FILE
              PERFORM 996-OVERRIDE-PRINT-FILE
              OPEN OUTPUT THIRD-PRT.

           IF MISC-CAPITAL-SPOOLER NOT = ZEROES
              IF MISC-CAP-RCVR = "Y"
              MOVE MISC-CAPITAL-SPOOLER TO OVRPRTF-TOFILE-NUM
              MOVE "MCPRT4"     TO OVRPRTF-FILE
              PERFORM 996-OVERRIDE-PRINT-FILE
              OPEN OUTPUT CAPITAL-PRT.

           IF RAW-MAT-SPOOLER NOT = ZEROES
              IF RAW-MAT-PRINT = "Y"
              MOVE RAW-MAT-SPOOLER TO OVRPRTF-TOFILE-NUM
              MOVE "MCPRT5"     TO OVRPRTF-FILE
              PERFORM 996-OVERRIDE-PRINT-FILE
              OPEN OUTPUT RAWMAT-PRT.

       049-EXIT.  EXIT.
      *************************************************************
      **     CLOSE AS MANY SPOOLFILES AS WERE REQUESTED          **
      *************************************************************
       050-CLOSE-SPOOLFILES.
           CLOSE ONLINE-PRT.
           IF ACCTG-PRT-NO NOT = ZEROES
                   CLOSE ACCTG-PRT.

           IF PRINT-PRT-NO NOT = ZEROES
                   CLOSE THIRD-PRT.

           IF MISC-CAPITAL-SPOOLER NOT = ZEROES
              IF MISC-CAP-RCVR = "Y"
                   CLOSE CAPITAL-PRT.

           IF RAW-MAT-SPOOLER NOT = ZEROES
                IF RAW-MAT-PRINT = "Y"
                   CLOSE RAWMAT-PRT.

           CLOSE      DVENDOR
                      DREQD
                      MREQ
                      DPOFREIGHT
                      DPOITEM
                      DRCVITEM
                      MSTORERM
                      DPODATAITM
                      MPORCV
                      DPORECD
                      PER-PERSONNEL
                      DCHATNO
                      DCOMMENT.
       059-EXIT.  EXIT.
      *************************************************************
      *            READ DPORECD FOR PRINT DATA AND TO             *
      *            DETERMINE IF RECEIVER IS CODED OR NONCODED.    *
      *************************************************************
       100-GET-DPORECD.
      *----------  MOVE RS NUMBER TO PRINTOUT
           MOVE WS-PO                    TO DISP-PO.
           MOVE WS-RLSE                  TO DISP-RLSE.
           MOVE WS-RS                    TO DISP-RS.
           MOVE DISPLAY-PO-RLSE-RS       TO PRT-PO-RLSE-RS.

      *----------  FIND SEQUENCE NUMBER OF RECEIVING SLIP
           MOVE 0 TO COND-WORD.
           MOVE MISC-RS-ARG TO PORCVNO OF MPORCV-REC.
           READ MPORCV INTO BUF-MPORCV
               INVALID KEY MOVE 17 TO COND-WORD.
           IF FILE-STATUS-1 = "2"
               MOVE 17 TO COND-WORD
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD.

      *----------  IF NO ENTRY, THEN WHEN CREATING THE RECEIVER, THE
      *            USER SKIPPED ALL ITEMS AND CODE FALLS THROUGH.
           IF NO-ENTRY
              MOVE 1 TO DO-NOTHING
              GO TO 199-EXIT.

           IF NOT GOOD-CALL
              MOVE "DBGET MPORCV 100 SRSPRT" TO BU-DISPLAY-MSG
              PERFORM 990-BLOWUP THRU 999-EXIT.

           MOVE M-PO-RCV-SEQ TO SEQ-2F.

      *---------  USE PO NUMBER TO FIND HEADER INFORMATION
           MOVE 0 TO COND-WORD.
           MOVE PO-ARG TO PORCVNO OF DPORECD-REC.
           START DPORECD KEY = PORCVNO OF DPORECD-REC
               INVALID KEY MOVE 17 TO COND-WORD.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
                   MOVE 17 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.
           IF NOT GOOD-CALL
              MOVE "DBFIND DPORECD AT 200 SRSPRT" TO BU-DISPLAY-MSG
              PERFORM 990-BLOWUP THRU 999-EXIT.

           MOVE 0 TO COND-WORD.
           READ DPORECD NEXT INTO BUF-DPORECD
               AT END MOVE 15 TO COND-WORD.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   MOVE 15 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.
           IF PORCVNO OF DPORECD-REC NOT = PO-ARG
               MOVE 15 TO COND-WORD.
           IF NOT GOOD-CALL
              MOVE "DBGET DPORECD AT 200 SRSPRT" TO BU-DISPLAY-MSG
              PERFORM 990-BLOWUP THRU 999-EXIT.

           MOVE PO-REQ-NUMBER       TO   SAVE-REQ.
           MOVE PO-BUDGET-NUMBER    TO   PRT-BUD-NO.

           MOVE PO-DATE             TO   DATE-VALIDATE-IN.
           MOVE 4                   TO   DATE-MODE.
           CALL "TDATECHK" USING DATE-CHECK-AREA.
           MOVE DATE-SLASH-OUT      TO   PRT-PO-DATE.
           MOVE PO-FOR-DEPT         TO   PRT-FOR-DEPT.
           MOVE PO-RCV-DEPT         TO   PRT-RCV-DEPT.
           MOVE PO-ADDL-INFO        TO   PRT-ADDL-INFO.
           IF PO-SHIP-DATE IS NUMERIC
              MOVE PO-SHIP-DATE     TO   DATE-VALIDATE-IN
              CALL "TDATECHK" USING DATE-CHECK-AREA
              MOVE DATE-SLASH-OUT   TO PRT-SHIP-DATE
           ELSE
               MOVE SPACES          TO   PRT-SHIP-DATE
               MOVE PO-SHIP-DATE    TO   PRT-SHIP-DATE.
           MOVE PO-SUB              TO   PRT-SUB.
           MOVE PO-SUB-DET          TO   PRT-SUB-DETL.
           MOVE PO-VEN-CODE         TO   VEN-ARG.
           MOVE PO-BUYER            TO   PRT-BUYER.
           MOVE BUYER-LIT-SAVE      TO   BUYER-LIT.
           MOVE PO-FOB              TO   FOB-2F.

       199-EXIT.  EXIT.
      *************************************************************
      *         READ DPOFREIGHT TO FIND FREIGHT INFORMATION       *
      *************************************************************
       200-GET-DPOFREIGHT.
           MOVE SPACES TO SAVE-PACK-SLIP.
           MOVE 0 TO COND-WORD.
           MOVE MISC-RS-ARG TO PORCVNO OF DPOFREIGHT-REC.
           START DPOFREIGHT KEY = PORCVNO OF DPOFREIGHT-REC
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS-1 = "2" OR FILE-STATUS = "00"
               NEXT SENTENCE
           ELSE
               MOVE 99 TO COND-WORD.
           IF COND-WORD NOT = 0
                 MOVE "DBFIND DPOFRGHT 200 RSPRT" TO BU-DISPLAY-MSG
                 PERFORM 990-BLOWUP THRU 999-EXIT.

           MOVE 0 TO COND-WORD.
           READ DPOFREIGHT NEXT INTO BUF-DPOFREIGHT
               AT END MOVE 15 TO COND-WORD.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   MOVE 15 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.
           IF PORCVNO OF DPOFREIGHT-REC NOT = MISC-RS-ARG
               MOVE 15 TO COND-WORD.
           IF COND-WORD NOT = 0
               IF COND-WORD = 15
                   MOVE SPACES TO DISPLAY-FRT-REFER
                   MOVE "NO FRGHT" TO PRPD-COLLECT-H2
                   GO TO 299-EXIT
               ELSE
                 MOVE "DBGET DPOFREIGHT 200 RSPRT" TO BU-DISPLAY-MSG
                 PERFORM 990-BLOWUP THRU 999-EXIT.

           IF FRT-REFERBACK NOT  = SPACES
              MOVE FRT-REFERBACK TO FRT-ARG
              MOVE FRT-REFER-PO     TO DISP-FRT-PO
              MOVE FRT-REFER-RLSE   TO DISP-FRT-RLSE
              MOVE FRT-REFER-RS     TO DISP-FRT-RS
              IF PO-INVOICELESS-IND = "X"
                  MOVE FRT-PACK-SLIP    TO SAVE-PACK-SLIP
              END-IF
              PERFORM 250-FIND-FRTREFER
              IF NOT GOOD-CALL
                 MOVE "DBFIND DPOFREIGHT2 200 RSPRT" TO BU-DISPLAY-MSG
                 PERFORM 990-BLOWUP THRU 999-EXIT
              ELSE
              PERFORM 260-GET-FRTREFER
              IF END-OF-CHAIN
                 MOVE SPACES TO DISPLAY-FRT-REFER
                 MOVE "NO FRGHT" TO PRPD-COLLECT-H2
                 GO TO 299-EXIT
              ELSE
                 IF NOT GOOD-CALL
                    MOVE "DBGET2 DPOFREIGHT 200 RSPRT" TO BU-DISPLAY-MSG
                    PERFORM 990-BLOWUP THRU 999-EXIT
                 END-IF
              END-IF
              IF PO-INVOICELESS-IND = "X" AND
                 SAVE-PACK-SLIP NOT = SPACES
                  MOVE SAVE-PACK-SLIP TO FRT-PACK-SLIP.

       210-MOVE-FREIGHT-DATA.
           MOVE PO-ZBILL           TO PRT-Z-BILL.
           IF AKRON
              MOVE FRT-ZBILL       TO PRT-Z-BILL.
           MOVE FRT-CARRIER        TO CARRIER-H2A.
           MOVE FRT-BILL-NO        TO PRO-NUM-H2A.
           IF FRT-BILL-DATE NOT = SPACES
              MOVE FRT-BILL-DATE TO DATE-VALIDATE-IN
              MOVE 4 TO DATE-MODE
              CALL "TDATECHK" USING DATE-CHECK-AREA
              MOVE DATE-SLASH-OUT TO PRO-DATE-H2
           ELSE
              MOVE SPACES TO PRO-DATE-H2.
           MOVE FRT-CHARGES-9      TO FREIGHT-H2.
           MOVE FRT-PACK-SLIP      TO P-SLIP-2B.
           MOVE FRT-CARRIER-WT     TO C-WT-2C.
           MOVE FRT-OUR-WT         TO O-WT-2C.
           MOVE FRT-SPLC           TO ORIGIN-2B.
           MOVE FRT-EMPL           TO EMPL-2A.
           MOVE FRT-LOT            TO LOT-NO-2B.
           MOVE FRT-RAIL-CAR       TO CAR-NO-2C.
           MOVE FRT-SEALS          TO SEALS-2D.
           MOVE FRT-OSD            TO OSD-NO-2C.
      *    MOVE MISC-FRT-COMMENT      TO  COMMENT-2E.
           MOVE FRT-OSD-CLAIM      TO COMMENT-2E.
           IF FRT-TYPE = "P"
              IF AKRON
                 MOVE "PREPAID"    TO PRPD-COLLECT-H2
              ELSE
                 IF DISP-FRT-PO = SPACES
                    MOVE "PREPAID" TO PRPD-COLLECT-H2
                 ELSE
                    MOVE "PRIOR-P" TO PRPD-COLLECT-H2.

           IF FRT-TYPE = "C"
              IF AKRON
                 MOVE "COLLECT"    TO PRPD-COLLECT-H2
              ELSE
                  IF DISP-FRT-PO = SPACES
                     MOVE "COLLECT"  TO PRPD-COLLECT-H2
                  ELSE
                    MOVE "PRIOR-C" TO PRPD-COLLECT-H2.

           IF FRT-TYPE = "G"
              IF AKRON
                 MOVE "GOODYEAR"    TO PRPD-COLLECT-H2
              ELSE
                  IF DISP-FRT-PO = SPACES
                     MOVE "GOODYEAR"  TO PRPD-COLLECT-H2
                  ELSE
                  MOVE "PRIOR-G"    TO PRPD-COLLECT-H2.

           IF FRT-TYPE = "U"
              MOVE "UPS"            TO PRPD-COLLECT-H2.

           IF FRT-TYPE = "D"
              MOVE "LOCAL"          TO PRPD-COLLECT-H2.

           IF FRT-TYPE = "M"
              MOVE "PRIOR"          TO PRPD-COLLECT-H2.
           GO TO 299-EXIT.
       250-FIND-FRTREFER.
              MOVE 0 TO COND-WORD
              MOVE FRT-ARG TO PORCVNO OF DPOFREIGHT-REC
              START DPOFREIGHT KEY = PORCVNO OF DPOFREIGHT-REC
                    INVALID KEY MOVE 17 TO COND-WORD.
              IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
                   MOVE 17 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.
       260-GET-FRTREFER.
           MOVE 0 TO COND-WORD.
           READ DPOFREIGHT NEXT INTO BUF-DPOFREIGHT
               AT END MOVE 15 TO COND-WORD.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   MOVE 15 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.
           IF PORCVNO OF DPOFREIGHT-REC NOT = FRT-ARG
               MOVE 15 TO COND-WORD.
       299-EXIT.  EXIT.
      *************************************************************
      *         READ THROUGH ALL ITEMS ON RECEIVER AND GET        *
      *         THE DESCRIPTIONS FOR EACH.  WRITE THE DESC-       *
      *         RIPTIONS TO A FILE TO BE USED LATER DURING        *
      *         THE ACTUAL WRITING OF THE RECEIVER.  KEEP         *
      *         TRACK NOW OF THE NUMBER OF PRINT LINES THAT       *
      *         WILL BE REQUIRED SO THE TOTAL NUMBER OF PAGES     *
      *         CAN BE WRITTEN ON EACH PAGE OF THE RECEIVER.      *
      *************************************************************
       400-FIND-RECEIVER.
           MOVE SPACES                TO BUF-MSTORERM.
      *----------  FIND SPECIFIC ENTRY FOR RECEIVER
           MOVE 0 TO COND-WORD.
           MOVE MISC-RS-ARG TO PORCVNO OF DRCVITEM-REC.
           START DRCVITEM KEY NOT < PORCVNO OF DRCVITEM-REC
               INVALID KEY MOVE 17 TO COND-WORD.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
                   MOVE 17 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.
           IF NOT GOOD-CALL
                 MOVE "DBFIND DRCVITEM -SRSPRT  " TO BU-DISPLAY-MSG
                 PERFORM 990-BLOWUP THRU 999-EXIT.

      *----------  CREATE TEMPORARY FILE FOR DESCRIPTION
           MOVE "QTEMP"        TO CCRTFILE-LIBRARY.
           MOVE "RCHLDPRT"     TO CCRTFILE-FILE.
           MOVE "0084"         TO CCRTFILE-RECORD-LENGTH.
           CALL "CCRTFILE" USING CCRTFILE-LIBRARY,
                                 CCRTFILE-FILE
                                 CCRTFILE-RECORD-LENGTH
                                 CCRTFILE-NO-RECORDS
                                 CCRTFILE-INCREMENT-AMT
                                 CCRTFILE-NO-INCREMENTS
                                 CCRTFILE-STATUS.
           IF CCRTFILE-STATUS NOT = "00"
              MOVE "CCRTFILE CREATE OF RCHLDPRT FAILED"
                   TO BU-DISPLAY-MSG
                   PERFORM 990-BLOWUP THRU 999-EXIT.
           OPEN OUTPUT HOLD-PRT.
           MOVE 0 TO I.
           MOVE 25 TO LINE-CTR.

       405-GET-NEXT-ITEM.
           MOVE 0 TO COND-WORD.
           READ DRCVITEM NEXT INTO BUF-DRCVITEM
               AT END MOVE 15 TO COND-WORD.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   MOVE 15 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.
           IF PORCVNO OF DRCVITEM-REC NOT = MISC-RS-ARG
               MOVE 15 TO COND-WORD.
           IF END-OF-CHAIN
              CLOSE HOLD-PRT
              GO TO 499-EXIT.
           IF NOT GOOD-CALL
              MOVE "DBGET DRCVITEM 405 SRSPRT" TO BU-DISPLAY-MSG
              PERFORM 990-BLOWUP THRU 999-EXIT.

      *----------  IF SPECIFIC ITEMS WERE LISTED ON A REPRINT, SEARCH
      *            ONLY FOR THOSE ITEMS.
           IF MISC-REPRINT NOT = "Y"
              GO TO 406-CONTINUE.
           IF RCVR-PRINT-ITEMS NOT = ZERO
      *       "0000000000000000000000000000000000000000"
              SET RI TO 1
              SEARCH RCVR-ITEM
                      AT END GO TO 405-GET-NEXT-ITEM
                      WHEN RCVR-ITEM (RI) = RCV-ITEM-NUMBER
                      GO TO 406-CONTINUE.

       406-CONTINUE.
      *----------  COUNT QTY COUNT MSG IF NEEDED
           ADD 1 TO I.
           IF COUNT-ITEM (I) = "Y"
              ADD 1 TO LINE-CTR
              IF LINE-CTR > 55
                 MOVE 8 TO LINE-CTR.

      *-----------  COUNT COMMENT LINE
              ADD 1 TO LINE-CTR
              IF LINE-CTR > 55
                 MOVE 8 TO LINE-CTR.

      *-----------  ALWAYS COUNT RETURNABLE CONTAINERS
              ADD 1 TO LINE-CTR
              IF LINE-CTR > 55
                 MOVE 8 TO LINE-CTR.

           MOVE RCV-DATE-RCVD TO DATE-VALIDATE-IN.
           MOVE 4 TO DATE-MODE.
           CALL "TDATECHK" USING DATE-CHECK-AREA.
           MOVE DATE-SLASH-OUT TO RCV-DATE-2F.
           IF RCV-CORP-CODE = "NON-STR"
              GO TO 415-GET-ACCUMULATOR-UM.

      *----------   FIND AND GET ALL COMMENT LINES (LOCATED IN THE
      *----------   DATASET DPODATAITM) AND STORE IN THE HOLD FILE
           MOVE 0 TO COND-WORD.
           MOVE PO-ARG TO PORCVNO OF DPODATAITM-REC.
           START DPODATAITM KEY NOT < PORCVNO OF DPODATAITM-REC
               INVALID KEY MOVE 17 TO COND-WORD.
           IF FILE-STATUS = "00" OR FILE-STATUS-1 = "2"
               MOVE 0 TO COND-WORD
           ELSE
                 MOVE "DBFIND DPODATAITM 405 SRSPRT" TO BU-DISPLAY-MSG
                 PERFORM 990-BLOWUP THRU 999-EXIT.

           ADD 7 TO LINE-CTR.
           IF LINE-CTR > 55
               MOVE 8 TO LINE-CTR.

       410-GET-COMMENTS-LOOP.
           MOVE 0 TO COND-WORD.
           READ DPODATAITM NEXT INTO BUF-DPODATAITM
               AT END MOVE 15 TO COND-WORD.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   MOVE 15 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.
           IF PORCVNO OF DPODATAITM-REC NOT = PO-ARG
               MOVE 15 TO COND-WORD.
           IF END-OF-CHAIN  OR DATAITM-ITEM-NO > RCV-ITEM-NUMBER
               GO TO 415-GET-ACCUMULATOR-UM
           ELSE
               IF NOT GOOD-CALL
                 MOVE "DBGET DPODATAITM 410 SRSPRT" TO BU-DISPLAY-MSG
                 PERFORM 990-BLOWUP THRU 999-EXIT.

           IF DATAITM-ITEM-NO = RCV-ITEM-NUMBER
               MOVE DATAITM-INFO      TO HOLD-PRT-DESC
               MOVE RCV-ITEM-NUMBER   TO HOLD-PRT-ITEM
               ADD 1                  TO LINE-CTR
               WRITE HOLD-PRT-RCD.

            IF LINE-CTR > 55
                MOVE 8 TO LINE-CTR.

           GO TO 410-GET-COMMENTS-LOOP.

      *>>>>>>>>>>  GET ACCUMULATOR TO FIND THE UM (LOT UM NEEDS
      *            DESCRIPTION FROM RS-ARG INSTEAD OF PO-ARG)
       415-GET-ACCUMULATOR-UM.
           MOVE 0 TO COND-WORD.
           MOVE PO-ARG TO PORCVNO OF DPOITEM-REC.
           START DPOITEM KEY NOT < PORCVNO OF DPOITEM-REC
               INVALID KEY MOVE 17 TO COND-WORD.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
                   MOVE 17 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.
           IF NOT GOOD-CALL
              MOVE "DBFIND DPOITEM 500 SRSPRT" TO BU-DISPLAY-MSG
              PERFORM 990-BLOWUP THRU 999-EXIT.

       416-GET-NEXT-ITEM.
           MOVE 0 TO COND-WORD.
           READ DPOITEM NEXT INTO BUF-DPOITEM
               AT END MOVE 15 TO COND-WORD.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   MOVE 15 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.
           IF PORCVNO OF DPOITEM-REC NOT = PO-ARG
               MOVE 15 TO COND-WORD.
           IF NOT GOOD-CALL
              MOVE "DBGET DPOITEM 416 SRSPRT" TO BU-DISPLAY-MSG
              PERFORM 990-BLOWUP THRU 999-EXIT.

           IF ITM-NUMBER NOT = RCV-ITEM-NUMBER
              GO TO 416-GET-NEXT-ITEM.

           MOVE 1                           TO X.
           IF ITM-UM = "LT" OR "AS"
              MOVE 25                       TO CNDESC-LINES-TO-GET
              MOVE 0                        TO CNDESC-LINES-GOT
              MOVE SPACES                   TO CNDESC-LINE
              CALL "CNDESC" USING BASE, MISC-RS-ARG, RCV-ITEM-NUMBER,
                                  CNDESC-DATA
                 PERFORM 426-MOVE-NONCODED-DESC CNDESC-LINES-GOT TIMES
                 ADD CNDESC-LINES-GOT TO LINE-CTR
           ELSE
           IF RCV-CORP-CODE = "NON-STR"
              MOVE 25                       TO CNDESC-LINES-TO-GET
              MOVE 0                        TO CNDESC-LINES-GOT
              MOVE SPACES                   TO CNDESC-LINE
                 CALL "CNDESC" USING BASE, PO-ARG, RCV-ITEM-NUMBER,
                                     CNDESC-DATA
                 PERFORM 426-MOVE-NONCODED-DESC CNDESC-LINES-GOT TIMES
                 ADD CNDESC-LINES-GOT TO LINE-CTR
           ELSE
              MOVE SPACES                   TO CDESC-DATA
              MOVE 25                       TO CDESC-LINES-TO-GET
              MOVE "P"                      TO CDESC-LANGUAGE-OPTION
              MOVE "F"                      TO CDESC-DESC-OPTION
              MOVE "S"                      TO CDESC-MANUFACT-OPTION
              MOVE "R"                      TO CDESC-LOCAL-DESC-OPTION
              CALL "CDESC" USING RET-CODE, BASE, STATUS-AREA,
                           BU-DISPLAY-MSG, RCV-CORP-CODE, CDESC-DATA
              IF RET-CODE = "NF"
                 NEXT SENTENCE
              ELSE
                 PERFORM 425-MOVE-CODED-DESC CDESC-LINES-GOT TIMES
                 ADD CDESC-LINES-GOT TO LINE-CTR.

       421-PRINT-DCOMPL.
           IF PRINT-DCOMPL-SW = "Y"
               MOVE RCV-CORP-CODE  TO  CCRQDESC-CODE
               MOVE SPACES         TO  CCRQDESC-LINES
               CALL "CCRQDESC" USING CCRQDESC-PARMS
           ELSE
               GO TO 422-CHECK-LINE-CTR.
           IF CCRQDESC-LINES = SPACES
               GO TO 422-CHECK-LINE-CTR.
           IF LINE-CTR > 55
               SUBTRACT 55 FROM LINE-CTR.
           PERFORM VARYING SUB FROM 1 BY 1
                   UNTIL CCRQDESC-LINE (SUB) = SPACES OR
                            SUB > 6
               MOVE CCRQDESC-LINE (SUB)     TO  HOLD-PRT-DESC
               MOVE RCV-ITEM-NUMBER         TO  HOLD-PRT-ITEM
               WRITE HOLD-PRT-RCD
               ADD 1                        TO  LINE-CTR
           END-PERFORM.

       422-CHECK-LINE-CTR.
      *----------  ADD ACCTG DATA, LOCATIONS, AND BLANK LINES
           ADD 6 TO LINE-CTR.
           IF LINE-CTR > 55
               SUBTRACT 55 FROM LINE-CTR
               GO TO 422-CHECK-LINE-CTR.
           GO TO 405-GET-NEXT-ITEM.

       425-MOVE-CODED-DESC.
           MOVE CDESC (X)                TO HOLD-PRT-DESC.
           MOVE RCV-ITEM-NUMBER          TO HOLD-PRT-ITEM.
           WRITE HOLD-PRT-RCD.
           ADD 1 TO X.
       426-MOVE-NONCODED-DESC.
           MOVE CNDESC (X)               TO HOLD-PRT-DESC.
           MOVE RCV-ITEM-NUMBER          TO HOLD-PRT-ITEM.
           WRITE HOLD-PRT-RCD.
           ADD 1 TO X.
       499-EXIT.  EXIT.
      *************************************************************
      *         READ THROUGH THE RECEIVER ITEMS AGAIN AND         *
      *         PRINT THE RECEIVER THIS TIME USING THE HOLD       *
      *         FILE TO RETRIEVE THE DESCRIPTION LINES.           *
      *************************************************************
       500-PRINT-RCVR.
           MOVE 0 TO I.
           PERFORM 880-PRINT-HEADINGS THRU 889-EXIT.
           MOVE 26 TO LINE-CTR.

           OPEN INPUT HOLD-PRT.
           READ HOLD-PRT AT END
                MOVE ALL "9" TO HOLD-PRT-ITEM.

      *----------  FIND SPECIFIC ENTRY FOR RECEIVER
           MOVE 0 TO COND-WORD.
           MOVE MISC-RS-ARG TO PORCVNO OF DRCVITEM-REC.
           START DRCVITEM KEY NOT < PORCVNO OF DRCVITEM-REC
               INVALID KEY MOVE 17 TO COND-WORD.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
                   MOVE 17 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.
           IF NOT GOOD-CALL
                 MOVE "DBFIND DRCVITEM 500 SRSPRT  " TO BU-DISPLAY-MSG
                 PERFORM 990-BLOWUP THRU 999-EXIT.

       505-GET-NEXT-ITEM.
           MOVE 0 TO COND-WORD.
           READ DRCVITEM NEXT INTO BUF-DRCVITEM
               AT END MOVE 15 TO COND-WORD.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   MOVE 15 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.
           IF PORCVNO OF DRCVITEM-REC NOT = MISC-RS-ARG
               MOVE 15 TO COND-WORD.
           IF END-OF-CHAIN
              CLOSE HOLD-PRT
              GO TO 599-EXIT.
           IF NOT GOOD-CALL
              MOVE "DBGET DRCVITEM 505 SRSPRT" TO BU-DISPLAY-MSG
              PERFORM 990-BLOWUP THRU 999-EXIT.

      *----------  IF SPECIFIC ITEMS WERE LISTED ON A REPRINT, SEARCH
      *            ONLY FOR THOSE ITEMS.
           IF MISC-REPRINT NOT = "Y"
              GO TO 506-CONTINUE.
           IF RCVR-PRINT-ITEMS NOT = ZERO
      *       "0000000000000000000000000000000000000000"
              SET RI TO 1
              SEARCH RCVR-ITEM
                      AT END GO TO 505-GET-NEXT-ITEM
                      WHEN RCVR-ITEM (RI) = RCV-ITEM-NUMBER
                      GO TO 506-CONTINUE.

       506-CONTINUE.
      *************************************************************
      *   GET ACCUMULATOR ENTRY FOR THE REST OF ITEM INFORMATION  *
      *************************************************************
           MOVE 0 TO COND-WORD.
           MOVE PO-ARG TO PORCVNO OF DPOITEM-REC.
           START DPOITEM KEY NOT < PORCVNO OF DPOITEM-REC
               INVALID KEY MOVE 17 TO COND-WORD.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
                   MOVE 17 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.
           IF NOT GOOD-CALL
              MOVE "DBFIND DPOITEM 500 SRSPRT" TO BU-DISPLAY-MSG
              PERFORM 990-BLOWUP THRU 999-EXIT.

       506-GET-NEXT-ITEM.
           MOVE 0 TO COND-WORD.
           READ DPOITEM NEXT INTO BUF-DPOITEM
               AT END MOVE 15 TO COND-WORD.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   MOVE 15 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.
           IF PORCVNO OF DPOITEM-REC NOT = PO-ARG
               MOVE 15 TO COND-WORD.
           IF NOT GOOD-CALL
              MOVE "DBGET DPOITEM 506 SRSPRT" TO BU-DISPLAY-MSG
              PERFORM 990-BLOWUP THRU 999-EXIT.

           IF ITM-NUMBER NOT = HOLD-PRT-ITM
               GO TO 506-GET-NEXT-ITEM.

           PERFORM 800-FIND-PASSED-ITEM THRU 809-EXIT.

           MOVE SPACES                 TO PRT-SUB2.
           MOVE ITM-CLASS             TO PRT-SUB2.
           IF RCV-LOT = SPACES
              MOVE SPACES TO MSG50
              MOVE ZEROES TO PRT-RAW-LOT
           ELSE
              MOVE RCV-LOT TO PRT-RAW-LOT
              MOVE LOT-MSG-WS TO MSG50.
           MOVE RCV-ITEM-NUMBER       TO  PRT-ITM, HOLD-ITM-NO.
           IF RCV-TALLY = SPACES
              MOVE SPACES TO PRT-TALLY-MSG
              MOVE SPACES       TO PRT-TALLY
           ELSE
              MOVE TALLY-MSG-WS TO PRT-TALLY-MSG
              MOVE RCV-TALLY    TO PRT-TALLY.
           MOVE RCV-CORP-CODE         TO  PRT-CODE.
           IF RCV-CORP-CODE = "NON-STR"
              GO TO 507-PRT-QTY.

      *-----------  GET MSTORERM FOR LOCATIONS, CLASS, AND PREV-CODE
           MOVE ITM-CORP-CODE TO CODE-ARG.
           MOVE 0 TO COND-WORD.
           MOVE CODE-ARG TO CORPCDE OF MSTORERM-REC.
           READ MSTORERM INTO BUF-MSTORERM
               INVALID KEY MOVE 17 TO COND-WORD.
           IF FILE-STATUS-1 = "2"
               MOVE 17 TO COND-WORD
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD.
           IF NOT GOOD-CALL
               MOVE "DBGET MSTORER 506 SRSPRT" TO BU-DISPLAY-MSG
               MOVE CODE-ARG TO BU-DISPLAY-FLD (5)
               PERFORM 990-BLOWUP THRU 999-EXIT.

           IF PRT-SUB2 = SPACES
           MOVE ST-CLASS             TO  PRT-SUB2.

       507-PRT-QTY.
           IF KELLY-PLANT
              MOVE RCV-KELLY-PO-QTY   TO  WORK-QTY
           ELSE
              MOVE RCV-QTY-DLVR       TO  WORK-QTY.
           IF WORK-QTY-ADP-X = ZEROES
              MOVE WORK-QTY           TO  PRT-PO-DLVR-R
           ELSE
              MOVE WORK-QTY           TO  PRT-PO-DLVR.

           IF RCV-CORP-CODE = "NON-STR"
              GO TO 508-ITEM-COMPLETE.

           IF KELLY-PLANT
              MOVE ITM-UM             TO  PRT2-STR-DLVR-UM
              MOVE RCV-QTY-DLVR       TO  WORK-QTY
           ELSE
              MOVE RCV-QTY-DLVR       TO  WS-CONVERT-FLD
              PERFORM 820-CONVERT-TO-STR THRU 829-EXIT.
           IF WORK-QTY-ADP-X = ZEROS
               MOVE WORK-QTY          TO  PRT2-STR-DLVR-R
           ELSE
               MOVE WORK-QTY          TO  PRT2-STR-DLVR.

       508-ITEM-COMPLETE.
           IF ITM-COMPLETE-FLAG = SPACES
              MOVE SPACES TO PRT-COMPLETE
           ELSE
              MOVE "MARKED COMPLETE " TO PRT-COMPLETE.

           IF KELLY-PLANT
              MOVE RCV-KELLY-PO-UM    TO PRT-PO-DLVR-UM
           ELSE
              MOVE ITM-UM             TO PRT-PO-DLVR-UM.

      *----------  IF KELLY RAW MATERIALS, DISPLAY PO AND STORES QTY
           IF RCV-CORP-CODE = "NON-STR"
              IF KELLY-PLANT
                 IF PO-TYPE = "2"
                    NEXT SENTENCE
                 ELSE
                    GO TO 514-CHECK-NEXT-PAGE
              ELSE
                 GO TO 514-CHECK-NEXT-PAGE
           ELSE
              GO TO 512-CODED-LOGIC.

           MOVE ITM-QTY-ORD TO WORK-QTY.
           IF WORK-QTY-ADP-X  = ZEROS
               MOVE WORK-QTY          TO  PRT2-STR-ORD-R
           ELSE
               MOVE WORK-QTY          TO  PRT2-STR-ORD.

           MOVE RCV-QTY-DLVR TO WORK-QTY.
           IF WORK-QTY-ADP-X = ZEROES
              MOVE WORK-QTY           TO  PRT2-STR-DLVR-R
           ELSE
              MOVE WORK-QTY           TO  PRT2-STR-DLVR.
           MOVE ITM-UM                TO  PRT2-STR-ORD-UM,
                                          PRT2-STR-DLVR-UM.

           GO TO 514-CHECK-NEXT-PAGE.

      *>>>>>>>>>>  CODED ITEM LOGIC
       512-CODED-LOGIC.
           MOVE STR-UM             TO  PRT2-STR-ORD-UM, PRT2-STR-DLVR-UM.
           IF KELLY-PLANT
              MOVE ITM-UM          TO  PRT2-STR-ORD-UM
              MOVE ITM-QTY-ORD     TO  WORK-QTY
           ELSE
              MOVE ITM-QTY-ORD     TO  WS-CONVERT-FLD
              PERFORM 820-CONVERT-TO-STR THRU 829-EXIT.
           IF WORK-QTY-ADP-X  = ZEROS
               MOVE WORK-QTY       TO  PRT2-STR-ORD-R
           ELSE
               MOVE WORK-QTY       TO  PRT2-STR-ORD.

           IF RCV-CHATNO NOT = SPACES
               MOVE RCV-CHATNO TO CHATNO OF DCHATNO
               READ DCHATNO INTO BUF-DCHATNO
                 INVALID KEY MOVE FILE-STATUS TO FILE-STATUS
               END-READ
               IF FILE-STATUS = "00"
                   MOVE RCV-CHATNO TO PRT-CHATNO
                   MOVE CHAT-MFR   TO PRT-CHAT-MFR
                   MOVE CHAT-TRADE TO PRT-CHAT-TRADE
               ELSE
                   MOVE SPACES     TO PRT-CHATNO
                                      PRT-CHAT-MFR
                                      PRT-CHAT-TRADE
               END-IF
           ELSE
               MOVE SPACES     TO PRT-CHATNO
                                  PRT-CHAT-MFR
                                  PRT-CHAT-TRADE
           END-IF.

       514-CHECK-NEXT-PAGE.
           PERFORM 850-CHECK-NEXT-PAGE.
      *----------  FIND REQUISITION NUMBER
           MOVE SPACES TO PRT-REQ-NO, PRT-WO, PRT-REQ-ORIG.
           MOVE 0 TO COND-WORD.
           MOVE PO-ARG TO PORCVNO OF DREQD-REC.
           START DREQD KEY = PORCVNO OF DREQD-REC
               INVALID KEY MOVE 17 TO COND-WORD.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
                   MOVE 17 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.
           IF NO-ENTRY
              GO TO 525-PRT-ITEM.
           IF NOT GOOD-CALL
              MOVE "DBFIND DREQD AT 535 IN TNONCDRS" TO BU-DISPLAY-MSG
              PERFORM 990-BLOWUP THRU 999-EXIT.

       515-GET-DREQD.
           MOVE 0 TO COND-WORD.
           READ DREQD NEXT INTO BUF-DREQD
               AT END MOVE 15 TO COND-WORD.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   MOVE 15 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.
           IF PORCVNO OF DREQD-REC NOT = PO-ARG
               MOVE 15 TO COND-WORD.
           IF END-OF-CHAIN
              GO TO 525-PRT-ITEM.
           IF DREQD-PO-ITM-NO NOT = ITM-NUMBER
              GO TO 515-GET-DREQD.
           MOVE DREQD-REQ-NUMBER TO PRT-REQ-NO, REQ-ARG.
           MOVE DREQD-WO-NUMBER  TO PRT-WO.

       525-PRT-ITEM.
           IF PRT-REQ-NO = SPACES
              MOVE SAVE-REQ TO PRT-REQ-NO, REQ-ARG.

           MOVE ITM-SUB-DETL       TO  PRT-SUB-DETL2.
           MOVE ITM-ADDL-DATA      TO  PRT-ADDL-DATA.

           IF KELLY-PLANT
              MOVE ITM-KELLY-PO-QTY       TO  WORK-QTY
              MOVE ITM-KELLY-PO-UM    TO  PRT-PO-ORD-UM,
                                          PRT-PO-DLVR-UM
           ELSE
              MOVE ITM-QTY-ORD        TO  WORK-QTY
              MOVE ITM-UM             TO  PRT-PO-ORD-UM.
           IF WORK-QTY-ADP-X  = ZEROS
               MOVE WORK-QTY          TO  PRT-PO-ORD-R
           ELSE
               MOVE WORK-QTY          TO  PRT-PO-ORD.
           ADD 1 TO I.
           MOVE SPACES       TO PRINT-RCD.
           MOVE PRT-ITM-HDR  TO PLINE.
           MOVE 1            TO LINE-ADV.
           ADD 1             TO LINE-CTR.
           PERFORM 860-PRT-LINE THRU 869-EXIT.
           MOVE SPACES       TO PRT-REQ-NO.

           IF ITM-CORP-CODE = "NON-STR"
              IF KELLY-PLANT
                 IF PO-TYPE = "2"
                    NEXT SENTENCE
                 ELSE
                    GO TO 527-PRT-CONTAINER
              ELSE
                 GO TO 527-PRT-CONTAINER.

           MOVE SPACES           TO  PRINT-RCD.
           MOVE PRT-ITM-HDR2     TO  PLINE.
           MOVE 1                TO  LINE-ADV.
           ADD 1                 TO  LINE-CTR.
           PERFORM 860-PRT-LINE THRU 869-EXIT.

       527-PRT-CONTAINER.
           MOVE SPACES TO PRT-ITM-HDR3.
           IF ITM-UM = "LT" OR "AS"
              GO TO 530-PRT-DESC.
           IF PASS-CONTAINER-QTY (I) NOT NUMERIC
              GO TO 530-PRT-DESC.
           IF PASS-CONTAINER-QTY (I) = ZERO
              GO TO 530-PRT-DESC.

           MOVE PASS-CONTAINER-QTY (I)  TO WORK-QTY.
           IF WORK-QTY-ADP-X = ZEROES
              MOVE WORK-QTY             TO PRT3-CONT-DLVR-R
           ELSE
              MOVE WORK-QTY             TO PRT3-CONT-DLVR.
           MOVE PASS-CONTAINER-UM (I)   TO PRT3-CONT-UM.
           MOVE "RETURNABLE CONTAINER"   TO PRT3-CONT.

       530-PRT-DESC.
           MOVE SPACES TO PRT-REQ-INFO, PRT-REQ-STAGE.
           MOVE SPACES           TO  PRINT-RCD.
           MOVE PRT-ITM-HDR3     TO  PLINE.
           MOVE 1                TO  LINE-ADV.
           ADD 1                 TO  LINE-CTR.
           PERFORM 860-PRT-LINE THRU 869-EXIT.

      *----------  PRINT DESCRIPTION, SUB DETAIL, AND ADDITIONAL DATA
       533-PRT-DESC.
           PERFORM 850-CHECK-NEXT-PAGE.
       534-CHECK-HOLD-ITEM.
           IF ITM-NUMBER > HOLD-PRT-ITEM
               PERFORM 875-READ-HOLD-PRT THRU 879-EXIT
               GO TO 534-CHECK-HOLD-ITEM.

           IF ITM-NUMBER = HOLD-PRT-ITEM
               MOVE HOLD-PRT-DESC   TO   PRT-DESC-COMMENT
               MOVE PRT-DESC-HDR TO PLINE
               MOVE 1                       TO   LINE-ADV
               ADD 1                        TO   LINE-CTR
               PERFORM 860-PRT-LINE THRU 869-EXIT
               PERFORM 875-READ-HOLD-PRT THRU 879-EXIT
               GO TO 533-PRT-DESC
           ELSE
           IF ITM-SUB-DETL NOT = SPACES
               MOVE PRT-SUB-SUBDETL-ADDLDATA TO PLINE
               MOVE 1 TO LINE-ADV
               ADD 1  TO LINE-CTR
               PERFORM 860-PRT-LINE THRU 869-EXIT
           ELSE
           IF ITM-ADDL-DATA NOT = SPACES
               MOVE PRT-SUB-SUBDETL-ADDLDATA TO PLINE
               MOVE 1 TO LINE-ADV
               ADD 1  TO LINE-CTR
               PERFORM 860-PRT-LINE THRU 869-EXIT.

DCR01      INITIALIZE  BUF-MREQ.
           MOVE 0 TO COND-WORD.
           MOVE REQ-ARG TO REQNO OF MREQ-REC.
           READ MREQ INTO BUF-MREQ
               INVALID KEY MOVE 17 TO COND-WORD.
           IF FILE-STATUS-1 = "2"
               MOVE 17 TO COND-WORD
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD.
           IF NO-ENTRY
              NEXT SENTENCE
           ELSE
              IF NOT GOOD-CALL
                 MOVE "DBGET MREQ 530 SRSPRT" TO BU-DISPLAY-MSG
                 PERFORM 990-BLOWUP THRU 999-EXIT
              ELSE
                 MOVE REQ-SUBD      TO PRT-REQ-SUBD
                 MOVE REQ-ORIGINATOR TO PRT-REQ-ORIG EMPL-ARG
                 IF REQ-DOCK-NOTIFY NOT = SPACES
                     MOVE "  NOTIFY: " TO PRT-REQ-NOTIFY-H
                     MOVE REQ-DOCK-NOTIFY TO PRT-REQ-NOTIFY
                 ELSE
                     MOVE SPACES TO PRT-REQ-NOTIFY-H
                                    PRT-REQ-NOTIFY
                 END-IF
                 MOVE 0 TO COND-WORD
                 MOVE EMPL-ARG TO PERCCNUM OF PER-PERSONNEL-REC
                 READ PER-PERSONNEL INTO BUF-PER-PERSONNEL
                    INVALID KEY MOVE 17 TO COND-WORD
                 END-READ
                 IF FILE-STATUS-1 = "2"
                     MOVE 17 TO COND-WORD
                 ELSE
                     IF FILE-STATUS NOT = "00"
                       MOVE 99 TO COND-WORD
                     END-IF
                 END-IF
                 IF GOOD-CALL
                     MOVE PER-EMP-NAME TO PRT-REQ-ORIG-NAME
                 ELSE
                     IF NO-ENTRY
                      MOVE SPACES TO PRT-REQ-ORIG-NAME
                     ELSE
                      MOVE "DBGET ERR PERSONNEL 534-CHECK-HOLD-ITEM" TO
                        BU-DISPLAY-MSG
                      PERFORM 990-BLOWUP THRU 999-EXIT
                     END-IF
                 END-IF
                 MOVE REQ-ADDL-INFO TO PRT-REQ-INFO
                 MOVE REQ-STAGING-AREA         TO PRT-REQ-STAGE.

           MOVE SPACES           TO  PRINT-RCD.
           ADD 1                 TO  LINE-CTR.
           IF PRT-REQ-INFO = SPACES
              IF PRT-REQ-STAGE = SPACES
                 IF PRT-WO = SPACES
                   IF PRT-REQ-ORIG = "    " OR "9999"
                    PERFORM 860-PRT-LINE THRU 869-EXIT
                    GO TO 540-PRINT-CHAT-LINE.
           MOVE PRT-REQ-LINE TO PLINE.
           PERFORM 860-PRT-LINE THRU 869-EXIT.
           MOVE PRT-REQ-LINE-2 TO PLINE.
           PERFORM 860-PRT-LINE THRU 869-EXIT.

       540-PRINT-CHAT-LINE.
           IF PRT-CHATNO NOT = SPACES
               MOVE SPACES TO PRINT-RCD
               MOVE 1 TO LINE-ADV
               MOVE PRT-CHAT-LINE TO PLINE
               PERFORM 860-PRT-LINE THRU 869-EXIT
               ADD 1 TO LINE-CTR
               MOVE SPACES TO PRINT-RCD
               MOVE 1 TO LINE-ADV
               MOVE PRT-CHAT-LINE-2 TO PLINE
               PERFORM 860-PRT-LINE THRU 869-EXIT
               ADD 1 TO LINE-CTR
               MOVE SPACES TO PRT-CHATNO.

       550-PRINT-LAST-LINES.
           IF COUNT-ITEM (I) = "Y"
              MOVE "* QUANTITY COUNT REQUIRED" TO PRT-COUNT
              MOVE PRT-COUNT-MSG TO PLINE
              MOVE 1 TO LINE-ADV
              PERFORM 860-PRT-LINE THRU 869-EXIT
              ADD 1 TO LINE-CTR.

      *---------  PRINT ITEM RCV INSTRUCTIONS
           IF ITM-RCV-STD-INST NOT = SPACES
              MOVE 1 TO LINE-ADV
              ADD  1 TO LINE-CTR
              MOVE SPACES TO PRINT-RCD
              PERFORM 860-PRT-LINE THRU 869-EXIT
              PERFORM 601-PRINT-ITM-RCV-INST THRU 601-PIRI-X
                 VARYING SUB FROM 1 BY 1
                   UNTIL SUB > 4
              MOVE 1 TO LINE-ADV
              ADD  1 TO LINE-CTR
              MOVE SPACES TO PRINT-RCD
              PERFORM 860-PRT-LINE THRU 869-EXIT.

      *----------  SHOW ITEM PRICE ONLY FOR CERTAIN RECEIVING DEPTS.
           IF PO-RCV-DEPT = "107A" OR "1071" OR "BRUN" OR "LARE" OR
                            "ZUNI" OR "AEI" OR "JAN" OR "CLOV" OR
                            "CAST" OR "CIRC" OR "CIRM" OR "DES"
                            OR "CIRA" OR "CIRO" OR "EXCA" OR "EXCO"
                            OR "EXMA" OR "EXMO"
              MOVE "PRICE UM:  " TO PRICE-UMH
              MOVE ITM-PRICE-UM   TO PRICE-UM
              MOVE "PRICE:  "    TO PRICE-H
              MOVE ITM-UNIT-PRICE TO PRT-PRICE
           ELSE
              MOVE SPACES TO PRICE-UMH, PRICE-UM, PRICE-H, PRT-PRICE-X.

      *----PRINT EITHER STOREROOM, NONCODED OR DIRECT DELIVERY LITERALS
           IF ITM-CORP-CODE = "NON-STR"
              MOVE "NONCODED ITEM" TO PRT-STR-LIT
              MOVE SPACES TO PRT-DD-DETL, PRT-LOC1,
                             PRT-LOCATION-ENTRY
                             PRT-SEMI1
              GO TO 555-PLINE
           ELSE
           IF ITM-DATE-STORED = "  DD  "
                MOVE ITM-SUB-DETL        TO  PRT-DD-DETL
                MOVE "DIRECT DELIVERY "  TO  PRT-STR-LIT
           ELSE
                MOVE SPACES              TO  PRT-DD-DETL
                MOVE "--BIN LOCATIONS "  TO  PRT-STR-LIT.

           MOVE STR-LOC (1)         TO   PRT-LOC1.
           MOVE SPACES              TO   PRT-LOCATION-ENTRY.
           MOVE ZEROS               TO   STK.
           MOVE "; "                TO   PRT-SEMI1.
           IF STR-LOC (2) > SPACES
               ADD 1 TO STK
               MOVE STR-LOC (2)     TO   PRT-LOC (STK)
               MOVE "; "         TO   PRT-SEMI (STK).
           IF STR-LOC (3) > SPACES
               ADD 1 TO STK
               MOVE STR-LOC (3)     TO   PRT-LOC (STK)
               MOVE "; "         TO   PRT-SEMI (STK).
           IF STR-LOC (4) > SPACES
               ADD 1 TO STK
               MOVE STR-LOC (4)     TO   PRT-LOC (STK)
               MOVE "; "         TO   PRT-SEMI (STK).
           IF STR-LOC (5) > SPACES
               ADD 1 TO STK
               MOVE STR-LOC (5)     TO   PRT-LOC (STK)
               MOVE "; "         TO   PRT-SEMI (STK).
           IF STR-LOC (6) > SPACES
               ADD 1 TO STK
               MOVE STR-LOC (6)     TO   PRT-LOC (STK).

           MOVE PRT-STR-LOCS-1 TO  PLINE.
           MOVE 1              TO  LINE-ADV.
           ADD 1               TO  LINE-CTR.
           PERFORM 860-PRT-LINE THRU 869-EXIT.
           MOVE PRT-STR-LOCS-2 TO  PLINE.
           MOVE 1              TO  LINE-ADV.
           ADD 1               TO  LINE-CTR.
           PERFORM 860-PRT-LINE THRU 869-EXIT.
      *--------- PRINT ONHAND QUANTITIES UNDERNEATH BIN LOCATIONS
           MOVE STR-LOC-ONHAND (1)  TO   PRT-LOC1-9.
           MOVE SPACES              TO   PRT-LOCATION-ENTRY.
           MOVE ZEROS               TO   STK.
           MOVE "; "                TO   PRT-SEMI1.
           IF STR-LOC (2) > SPACES
               ADD 1 TO STK
               MOVE STR-LOC-ONHAND (2)  TO   PRT-LOC-9 (STK)
               MOVE "; "         TO   PRT-SEMI (STK).
           IF STR-LOC (3) > SPACES
               ADD 1 TO STK
               MOVE STR-LOC-ONHAND (3)  TO   PRT-LOC-9 (STK)
               MOVE "; "         TO   PRT-SEMI (STK).
           IF STR-LOC (4) > SPACES
               ADD 1 TO STK
               MOVE STR-LOC-ONHAND (4)  TO   PRT-LOC-9 (STK)
               MOVE "; "         TO   PRT-SEMI (STK).
           IF STR-LOC (5) > SPACES
               ADD 1 TO STK
               MOVE STR-LOC-ONHAND (5)  TO   PRT-LOC-9 (STK)
               MOVE "; "         TO   PRT-SEMI (STK).
           IF STR-LOC (6) > SPACES
               ADD 1 TO STK
               MOVE STR-LOC-ONHAND (6)  TO   PRT-LOC-9 (STK).

       555-PLINE.
           MOVE PRT-STR-LOCS-2 TO  PLINE.
           MOVE 1              TO  LINE-ADV.
           ADD 1               TO  LINE-CTR.
           PERFORM 860-PRT-LINE THRU 869-EXIT.

      *----------  PRINT COMMENT LINE ENTERED WITH EACH ITEM
           IF RCV-COMMENT NOT = SPACES
              MOVE RCV-COMMENT TO PRT-ITEM-COMMENT
              MOVE PRT-COMMENT TO PLINE
              PERFORM 860-PRT-LINE THRU 869-EXIT
              ADD 1 TO LINE-CTR.

      *---------  PRINT PRICE
           MOVE PRT2-STR-DLVR-UM-PRICE   TO  PLINE.
           MOVE 3            TO  LINE-ADV.
           ADD 3             TO  LINE-CTR.
           PERFORM 860-PRT-LINE THRU 869-EXIT.

           GO TO 505-GET-NEXT-ITEM.

       599-EXIT.  EXIT.

      *---GET BEFORE AND AFTER RCV INSTRUCTIONS
      *---  STORED IN DPODATAITM "000002" SEQ NO
       600-GET-RCV-INST.
           MOVE SPACES TO RCV-INSTRUCTIONS.
           MOVE PO-ARG TO PORCVNO OF DPODATAITM-REC.
           MOVE "000002" TO ITEMSEQNO OF DPODATAITM-REC.
           READ DPODATAITM INTO BUF-DPODATAITM
               AT END MOVE 17 TO COND-WORD.
           IF FILE-STATUS = "00"
               MOVE DATAITM-INFO  TO  RCV-INSTRUCTIONS.
       600-GRI-X.
           EXIT.


      *---- PRINT BEFORE/AFTER RCV INSTRUCTIONS
       601-PRINT-RCV-INST.
            MOVE RCV-INST-NO(SUB) TO RECEIVE-INSTRUCTION.
            PERFORM 601-PRINT-INST THRU 601-PI-X.
       601-PRI-X.
           EXIT.

       601-PRINT-ITM-RCV-INST.
           MOVE ITM-RCV-STD-INSTR(SUB) TO RECEIVE-INSTRUCTION.
           PERFORM 601-PRINT-INST THRU 601-PI-X.
       601-PIRI-X.
           EXIT.

       601-PRINT-INST.
           IF RECEIVE-INSTRUCTION = SPACES
               GO TO 601-PI-X.

           MOVE RECEIVE-INSTRUCTION TO BUILD-COM-NO.
           MOVE BUILD-COMMENT-NO TO COMMENT-ARG.
           MOVE 0 TO COND-WORD.
           MOVE COMMENT-ARG TO MCOMCOMMNT OF DCOMMENT-REC.
           START DCOMMENT KEY = MCOMCOMMNT OF DCOMMENT-REC
               INVALID KEY MOVE 17 TO COND-WORD.
           IF FILE-STATUS NOT = "00"
               GO TO 601-PI-X.

       601-GET-DCOMMENT.
           MOVE 0 TO COND-WORD.
           READ DCOMMENT NEXT INTO BUF-DCOMMENT
               AT END MOVE 15 TO COND-WORD.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   GO TO 601-PI-X
               ELSE
                   MOVE "READ DCOMMENT *601-PI" TO  BU-DISPLAY-MSG
                   MOVE COMMENT-ARG           TO  BU-DISPLAY-FLD (2)
                   PERFORM 990-BLOWUP THRU 999-EXIT.
           IF MCOMCOMMNT OF DCOMMENT-REC NOT = COMMENT-ARG
               GO TO 601-PI-X.

           MOVE 1                       TO  LINE-ADV.
           ADD  1 TO LINE-CTR.
           MOVE SPACES                  TO  PRTWK-AREA.
           IF EXP-PRT-START = "*EXP*"
               MOVE EXP-DATA-COMMENT    TO  PRTWK-STD-INST
           ELSE
           IF EXP-PRT-START = "*CMP*"
               MOVE COMP-DATA-COMMENT   TO  PRTWK-STD-INST
           ELSE
               MOVE DCOM-DATA-LINE      TO  PRTWK-STD-INST.
           MOVE SPACES                  TO  PRINT-RCD.
           MOVE PRTWK-STD-INST-LINE     TO  PRINT-RCD.
           PERFORM 860-PRT-LINE THRU 869-EXIT.

           GO TO 601-GET-DCOMMENT.
       601-PI-X.
           EXIT.

      *************************************************************
      *   SEARCH THE ITEMS PASSED AND SEE IF DELIVERED UM AND     *
      *   PRICE DATA WAS PASSED FROM THE RCVR CREATE PROGRAM.     *
      *************************************************************
       800-FIND-PASSED-ITEM.
           SET T TO 1.
           SEARCH PASS-ITEM-TABLE
              AT END
              MOVE SPACES TO PRT-PRICE-QTY-X
                             PRT-PRICE-UM
                             PRT2-STR-DLVR-UM
              GO TO 809-EXIT
              WHEN RCV-ITEM-NUMBER = PASS-ITEM (T)
              MOVE PASS-DLV-UM (T)       TO PRT2-STR-DLVR-UM.

      *----------  IF PRICE DATA IS NEEDED, MOVE IT ALSO
           IF PASS-PRICE-UM (T) NOT = SPACES
              MOVE PASS-PRICE-QTY (T)    TO PRT-PRICE-QTY
              MOVE PASS-PRICE-UM (T)     TO PRT-PRICE-UM
           ELSE
              MOVE SPACES                TO PRT-PRICE-QTY-X
                                            PRT-PRICE-UM.

       809-EXIT.  EXIT.
       810-DISPLAY.
           SET T UP BY 1.

      *----------  CONVERT NON-KELLY PLANTS' PO DELIVERY QUANTITY
      *            TO STOREROOM QUANTITY.
       820-CONVERT-TO-STR.
           IF ITM-UM = STR-UM
              MOVE WS-CONVERT-FLD TO WORK-QTY
           ELSE
              IF ITM-UM = STR-UM1
                 MULTIPLY WS-CONVERT-FLD BY STR-UM1-CF
                    GIVING WORK-QTY ROUNDED
              ELSE
                 IF ITM-UM = STR-UM2
                    MULTIPLY WS-CONVERT-FLD BY STR-UM2-CF
                        GIVING WORK-QTY ROUNDED.
       829-EXIT.  EXIT.
      *************************************************************
      *      CHECK IF A PAGE BREAK HAS OCCURRED                   *
      *************************************************************
       850-CHECK-NEXT-PAGE.
           IF LINE-CTR > 55 AND
              HOLD-PRT-ITEM NOT = ALL "9"
               MOVE 8 TO LINE-CTR
               ADD  1 TO PG-NO
               MOVE SPACES TO PRINT-RCD
               PERFORM 870-TOP-OF-NEW-PAGE
               MOVE HDR-1 TO PLINE
               MOVE 2 TO LINE-ADV
               PERFORM 860-PRT-LINE THRU 869-EXIT
               MOVE HDR-3   TO PLINE
               MOVE 2 TO LINE-ADV
               PERFORM 860-PRT-LINE THRU 869-EXIT
               MOVE  HDR-6  TO PLINE
               MOVE 1 TO LINE-ADV
               PERFORM 860-PRT-LINE THRU 869-EXIT
               MOVE  HDR-7  TO PLINE
               MOVE 2 TO LINE-ADV
               PERFORM 860-PRT-LINE THRU 869-EXIT.
      ************************************************************
      *   WRITE THE RECORD TO ANY PRINTERS THAT ARE REQUIRED.    *
      ************************************************************
       860-PRT-LINE.
           WRITE PRINT-RCD BEFORE ADVANCING LINE-ADV LINES.
           IF ACCTG-PRT-NO NOT = ZEROES
               MOVE PLINE TO PACCTG
               WRITE ACCTG-RCD BEFORE ADVANCING LINE-ADV LINES.
           IF PRINT-PRT-NO NOT = ZEROES
             MOVE PLINE TO PTHIRD
             WRITE THIRD-RCD BEFORE ADVANCING LINE-ADV LINES.
      *----------  PRINT CAPITAL ITEMS IF THE FLAG IS SET.  PRINT ALL
      *            HEADING LINES (I=0) AND THEN PRINT ONLY ITEMS
      *            THAT ARE CAPITAL ITEMS.
           IF MISC-CAPITAL-SPOOLER NOT = ZEROES
              IF MISC-CAP-RCVR = "Y"
                 IF I = 0
                    MOVE PLINE TO PCAP
                    WRITE CAPITAL-RCD BEFORE ADVANCING LINE-ADV LINES
                 ELSE
                    IF PASS-CAPITAL-ITEM (I) = "Y"
                    MOVE PLINE TO PCAP
                    WRITE CAPITAL-RCD BEFORE ADVANCING LINE-ADV LINES.

      *----------  WRITE TO RAW MATERIAL PRINTER IF REQUIRED
           IF RAW-MAT-SPOOLER NOT = ZEROES
              IF RAW-MAT-PRINT = "Y"
                 MOVE PLINE TO RMAT
                 WRITE RAWMAT-RCD BEFORE ADVANCING LINE-ADV LINES.
       869-EXIT.  EXIT.

      ************************************************************
      *              TOP OF NEW PAGE ROUTINE                     *
      ************************************************************
       870-TOP-OF-NEW-PAGE.
           WRITE PRINT-RCD AFTER ADVANCING NEW-PAGE.
           IF ACCTG-PRT-NO NOT = ZEROES
               MOVE PLINE TO PACCTG
               WRITE ACCTG-RCD AFTER ADVANCING NEW-PAGE.
           IF PRINT-PRT-NO NOT = ZEROES
             MOVE PLINE TO PTHIRD
             WRITE THIRD-RCD AFTER ADVANCING NEW-PAGE.
           IF MISC-CAPITAL-SPOOLER NOT = ZEROES
              IF MISC-CAP-RCVR = "Y"
                 MOVE PLINE TO PCAP
                 WRITE CAPITAL-RCD AFTER ADVANCING NEW-PAGE.
           IF RAW-MAT-SPOOLER NOT = ZEROES
              IF RAW-MAT-PRINT = "Y"
                 MOVE PLINE TO RMAT
                 WRITE RAWMAT-RCD AFTER ADVANCING NEW-PAGE.
       875-READ-HOLD-PRT.
           READ HOLD-PRT AT END
                MOVE ALL "9" TO HOLD-PRT-ITEM.
       879-EXIT.  EXIT.
      ************************************************************
      *              PRINT TO THE APPROPRIATE PRINTER            *
      ************************************************************
       880-PRINT-HEADINGS.
           MOVE 1                     TO DATE-MODE.
           CALL "TDATECHK" USING DATE-CHECK-AREA.
           MOVE DATE-SLASH-OUT        TO PRT-DATE.
           MOVE DATE-FORMATTED-TIME-OUT TO PRT-TIME.
           ADD 1 TO PG-NO.
           MOVE HDR-1       TO PLINE.
           MOVE 2 TO LINE-ADV.
           PERFORM 860-PRT-LINE THRU 869-EXIT.

           IF DISP-FRT-PO NOT = SPACES
               MOVE DISPLAY-FRT-REFER TO PRT-PRIOR-RS
               MOVE HDR-1A   TO PLINE
               MOVE 2                 TO LINE-ADV
               PERFORM 860-PRT-LINE THRU 869-EXIT.
           MOVE  HDR-2      TO PLINE.
           MOVE 1 TO LINE-ADV.
           PERFORM 860-PRT-LINE THRU 869-EXIT.
           MOVE HDR-2A     TO   PLINE.
           MOVE 1                   TO   LINE-ADV.
           PERFORM 860-PRT-LINE THRU 869-EXIT.
           MOVE HDR-2B    TO   PLINE.
           MOVE 1                  TO   LINE-ADV.
           PERFORM 860-PRT-LINE THRU 869-EXIT.
           MOVE HDR-2C    TO   PLINE.
           MOVE 1 TO LINE-ADV.
           PERFORM 860-PRT-LINE THRU 869-EXIT.
           MOVE HDR-2D    TO   PLINE.
           MOVE 1                  TO   LINE-ADV.
           PERFORM 860-PRT-LINE THRU 869-EXIT.
           MOVE HDR-2E    TO   PLINE.
           MOVE 1 TO LINE-ADV.
           PERFORM 860-PRT-LINE THRU 869-EXIT.
           MOVE HDR-2F    TO   PLINE.
           MOVE 2 TO LINE-ADV.
           PERFORM 860-PRT-LINE THRU 869-EXIT.
           MOVE  HDR-3      TO PLINE.
           MOVE 2 TO LINE-ADV.
           PERFORM 860-PRT-LINE THRU 869-EXIT.
           IF PRT-Z-BILL  = SPACES
               NEXT SENTENCE
           ELSE
               MOVE PRT-Z-BILL-NO TO PLINE
               MOVE 2             TO LINE-ADV
               PERFORM 860-PRT-LINE THRU 869-EXIT.

           MOVE PRT-PO-DATA TO   PLINE.
           MOVE 1                   TO  LINE-ADV.
           PERFORM 860-PRT-LINE THRU 869-EXIT.

           MOVE HDR-4A TO PLINE.
           MOVE 2                   TO   LINE-ADV.
           PERFORM 860-PRT-LINE THRU 869-EXIT.
      *************************************************************
      *         RETRIEVE VENDOR INFORMATION FOR THE REPORT        *
      *************************************************************
           MOVE VEN-LIT-SAVE        TO   VEN-LIT.
           MOVE VEN-ARG             TO   PRT-VEN-ADDR.
           MOVE 1                   TO   LINE-ADV.
           MOVE HDR-5      TO   PLINE.
           PERFORM 860-PRT-LINE THRU 869-EXIT.

           MOVE SPACES              TO   PRT-BUYER, BUYER-LIT.

           MOVE 0 TO COND-WORD.
           MOVE VEN-ARG TO VENCDE OF DVENDOR-REC.
           START DVENDOR KEY = VENCDE OF DVENDOR-REC
               INVALID KEY MOVE 17 TO COND-WORD.
           IF FILE-STATUS = "00" OR FILE-STATUS-1 = "2"
               MOVE 0 TO COND-WORD
           ELSE
               MOVE 99 TO COND-WORD.
           IF NOT GOOD-CALL
                 MOVE "DBFIND DVENDOR -SRSPRT  " TO BU-DISPLAY-MSG
                 MOVE VEN-ARG                     TO BU-DISPLAY-FLD (5)
                 PERFORM 990-BLOWUP THRU 999-EXIT.

       885-LOAD-VEN-DATA-FOR-PRT.
           MOVE 0 TO COND-WORD.
           READ DVENDOR NEXT INTO BUF-DVENDOR
               AT END MOVE 15 TO COND-WORD.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   MOVE 15 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.
           IF VENCDE OF DVENDOR-REC NOT = VEN-ARG
               MOVE 15 TO COND-WORD.
           IF NOT GOOD-CALL
               GO TO 886-PRINT.

           IF VEN-ITM-NO = "00" OR "07"
             IF VEN-ITM-NO = "00"
               MOVE SELLER-LIT-SAVE  TO  VEN-LIT
               MOVE VEN-NAME         TO  PRT-VEN-ADDR
               MOVE 1                TO  LINE-ADV
             ELSE
               MOVE SPACES           TO  VEN-LIT
               MOVE VEN-07-RCD       TO  PRT-VEN-ADDR
               MOVE 3                TO  LINE-ADV
           ELSE
             GO TO 885-LOAD-VEN-DATA-FOR-PRT.

           MOVE HDR-5    TO  PLINE.
           PERFORM 860-PRT-LINE THRU 869-EXIT.
           GO TO 885-LOAD-VEN-DATA-FOR-PRT.

       886-PRINT.
      *----------  PRINT BEFORE RECEIVER INSTRUCTIONS
           IF RCV-BEFORE-INST NOT = SPACES
              PERFORM 601-PRINT-RCV-INST THRU 601-PRI-X
                 VARYING SUB FROM 1 BY 1
                   UNTIL SUB > 6
              MOVE 1 TO LINE-ADV
              ADD  1 TO LINE-CTR
              MOVE SPACES TO PRINT-RCD
              PERFORM 860-PRT-LINE THRU 869-EXIT.
           IF PRINT-PRICE-SW = "Y"
              MOVE PRICE-QTY-SAVE TO PRICE-QTY-TITLE
           ELSE
              MOVE SPACES TO PRICE-QTY-TITLE.

           MOVE  HDR-6      TO PLINE.
           MOVE 1           TO LINE-ADV.
           PERFORM 860-PRT-LINE THRU 869-EXIT.
           MOVE HDR-7  TO PLINE.
           PERFORM 860-PRT-LINE THRU 869-EXIT.

       889-EXIT.  EXIT.

       COPY OVRPFCALL IN COPYLIB.
       990-BLOWUP.
           MOVE "CRSPRT"    TO BU-PGM-NAME.
           MOVE MISC-RS-ARG TO BU-DISPLAY-FLD (1).
           MOVE PO-ARG TO BU-DISPLAY-FLD (2).
           MOVE CODE-ARG TO BU-DISPLAY-FLD (3).
           CALL "TBLOWUP" USING BASE, BU-PGM-NAME, STATUS-AREA,
                VIEW-COMAREA, FILE-STATUS, BU-DISPLAY-MSG,
                 BU-DISPLAY-FLDS.
       999-EXIT.  EXIT.

       999-CATREAD.
           IF CATREAD-MSG-NUMBER = ZEROS
               MOVE LANG-SETNUM TO CATREAD-MSG-SET
               MOVE LANG-MSGNUM TO CATREAD-MSG-NUM.
           CALL "CCATREAD" USING CATREAD-PARMS.
           MOVE CATREAD-MSG-TEXT TO MESSAGE-BUFFER.
       999-CATREAD-EXIT.  EXIT.
