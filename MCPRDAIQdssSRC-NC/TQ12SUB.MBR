019900             15  OUTPUT-LINE-2.
020000                 20  OUTPUT-DESC      PIC X(79).
020100     05  MESSAGE-LINE                 PIC X(79).
           05  OUTPUT-CMD-LINE              PIC X(79).
           05  OUTPUT-MSG-LINE              PIC X(79).
020200
       COPY OVRPFDATA IN COPYLIB.

020300 01  PASSED-SPOOL-PRT                 PIC S9(2) VALUE ZERO COMP.
020400 01  PASSWORD-INFORMATION.
020500     05  NAME-OF-PROGRAM     PIC X(08) VALUE "TQ12SUB ".
020600     05  PROGRAM-TYPE        PIC X(02) VALUE "IN".
020700     05  PROGRAM-RELEASE     PIC X(12) VALUE " E0100010001".
020800     05  PROGRAM-DESCRIPTION.
020900         10  PROG-DESC-A.
                   15  FILLER      PIC X(16) VALUE " Q12 INQUIRY TO ".
                   15  FILLER      PIC X(09) VALUE "RETRIEVE ".
                   15  FILLER      PIC X(15) VALUE "RECEIVING DATA ".
                   15  FILLER      PIC X(20) VALUE "FOR REQ'D ITEMS ".
021100         10  PROG-DESC-B     PIC X(60) VALUE SPACES.
021300         10  PROG-FUNCTION   PIC X(60) VALUE SPACES.
021500     05  PASSWORD-FLAG       PIC X.
021600 01  PLANT-ID                         PIC XXX.
023100 01  RET-CODE                         PIC XX.
023200 01  SCREEN-PRINT-PARMS.
023300     05  PRINTCNTL                    PIC S9(4) VALUE ZERO COMP.
023400     05  PAGECNTL                     PIC S9(4) VALUE 49 COMP.
023500     05  SPOOLFIL-OPEN-SW             PIC X     VALUE "N".
       COPY DBSTAT OF COPYLIB.
025300
025400 COPY TBLOWUP IN COPYLIB.
025500
       01  TRUE-VAL                         PIC 1 VALUE B"1".

025600 01  WHO-VARIABLES.
025700     05  USERNAME                     PIC X(10).
025800     05  TERMNUM                      PIC X(10).
025900     05  CURRLIB                      PIC X(10).
           05  JOBLIBX                      PIC X.
026600 01  WO-PARTS-DATA.       COPY DWOPARTS OF COPYLIB.
       COPY WSCONTROL IN COPYLIB.
026800 LINKAGE SECTION.
027500 01  DBPARAMETERS.        COPY DBPARMS OF COPYLIB.
       COPY VCOMLINK OF COPYLIB.
       COPY CATREAD  OF COPYLIB.
028000 PROCEDURE DIVISION USING DBPARAMETERS VIEW-COMAREA
028100                      CATREAD-PARMS.
028300 START-PGM.
028400     PERFORM 1-HSK.
028500     PERFORM 6-MAIN THRU 6-MAIN-EXIT.
028600 2-EOJ.
           CLOSE DISPLAY-FILE.
           CLOSE WO-LAST-NUM-USED.
           CLOSE WO-PARTS-FILE-3.
028800     CLOSE WORK-FILE.
029200     GOBACK.
029300 1-HSK.
           OPEN I-O DISPLAY-FILE.
           OPEN INPUT WO-LAST-NUM-USED.
           OPEN INPUT WO-PARTS-FILE-3.
029400     MOVE SPACES TO BASE-STHIST.
030800     MOVE 1 TO ACT-KEY.
           MOVE 0 TO COND-WORD.
           READ WO-LAST-NUM-USED INTO LAST-WO-BUFF
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF WLNU-STATUS NOT = "00" MOVE 17 TO COND-WORD.
           IF COND-WORD = 17 MOVE 1 TO DATE-FLAG-SW.
031200     MOVE PLANT-IDENT TO PLANT-ID.
031300     MOVE DATE-FLAG-SW TO DATE-FLAG.
031400     MOVE DATE-FLAG TO DATE-CODE.
031700     CALL "TPWORD" USING PASSWORD-INFORMATION.
032100     IF PASSWORD-FLAG = "N" GO TO 2-EOJ.
032200     CALL "CLWHO" USING USERNAME TERMNUM CURRLIB JOBLIBX.
035400     MOVE SPACES TO INPUT-AREA.
034600 6-MAIN.
034700     MOVE 0 TO ACT-KEY ACT-KEY-2.
034800     MOVE 60 TO LINE-CTR.
034900     MOVE "FQ12INQ1" TO VIEW-CFNAME.
           MOVE ERROR-BUFFER TO INPUT-ERR-LINE.
           MOVE INPUT-AREA TO DSPLY-REC.
           PERFORM 99-SCREEN-WRITE.
           PERFORM 98-SCREEN-READ.
035800     MOVE SPACES TO ERROR-BUFFER.
           MOVE DSPLY-REC TO INPUT-AREA.
036200     IF VIEW-LASTKEY = 3 GO TO 2-EOJ.
           OPEN OUTPUT OUT-FILE.
036500     IF INPUT-PRINT = " "
036600         NEXT SENTENCE
036700     ELSE
036800     PERFORM 996-OVERRIDE-PRINT-FILE
036900     OPEN OUTPUT PRINT-FILE.
037300     MOVE 0 TO REL-RECS-CTR.
037400     MOVE SPACES TO DATE-RANGE-AREA.
037500     IF INPUT-DATE-FROM = SPACES
037600         MOVE SPACES TO DRA-FROM-CN
037700     ELSE
037800     MOVE 3 TO DATE-MODE
037900     MOVE INPUT-DATE-FROM TO DATE-VALIDATE-IN
038000     CALL "TDATECHK" USING DATE-CHECK-AREA
038100     MOVE DATE-DB TO DRA-FROM.
      *---------- ACCOUNT FOR CENTURY.
           IF DRA-FROM-YY > SPACES
               IF DRA-FROM-YY > "70"
                   MOVE "19"       TO  DRA-FROM-CC
               ELSE
                   MOVE "20"       TO  DRA-FROM-CC.
038200     IF INPUT-DATE-TO = SPACES
038300         MOVE SPACES TO DRA-TO-CN
038400     ELSE
038500     MOVE 3 TO DATE-MODE
038600     MOVE INPUT-DATE-TO TO DATE-VALIDATE-IN
038700     CALL "TDATECHK" USING DATE-CHECK-AREA
038800     MOVE DATE-DB TO DRA-TO.
      *---------- ACCOUNT FOR CENTURY.
           IF DRA-TO-YY > SPACES
               IF DRA-TO-YY > "70"
                   MOVE "19"       TO  DRA-TO-CC
               ELSE
                   MOVE "20"       TO  DRA-TO-CC.
038900     IF DRA-FROM-CN = SPACES
039000         IF DRA-TO-CN = SPACES
039100             NEXT SENTENCE
039200         ELSE
039300         MOVE SPACES TO DRA-TO-CN
039400     ELSE
039500     MOVE 4 TO DATE-MODE
039600     ACCEPT DATE-VALIDATE-IN FROM DATE
039700     CALL "TDATECHK" USING DATE-CHECK-AREA
039800     MOVE DATE-DB TO DRA-TO
           IF DRA-TO-YY > "70"
               MOVE "19"       TO  DRA-TO-CC
           ELSE
               MOVE "20"       TO  DRA-TO-CC.
039900     IF INPUT-ORIG = SPACES
040000         MOVE "NO ORIGINATOR WAS SPECIFIED - TRY AGAIN"
040100             TO ERROR-BUFFER
040300         MOVE TRUE-VAL TO INDS (1) INDS (99)
040900         GO TO 6-MAIN.
041100     PERFORM 69-START-WO-PARTS-FILE-3.
041700     IF COND-WORD = 17
041800         MOVE "ORIGINATOR HAS NO PURCHASED MATL TO CHECK"
041900             TO ERROR-BUFFER
042100         MOVE TRUE-VAL TO INDS (5) INDS (99)
042700         GO TO 6-MAIN.
042900     PERFORM 6-GET-RECORDS THRU 6-GR-EXIT.
043200     SORT SORT-FILE ON DESCENDING KEY SORT-WO-7
043300                                      SORT-WO-1-6
043400                                      SORT-REQ-NO
043500         INPUT PROCEDURE  7-SORT-RECORDS
043600         OUTPUT PROCEDURE 8-WRITE-OUTPUT.
043700
           MOVE 0 TO COND-WORD.
043800     MOVE 0 TO ACT-KEY-2.
043900     MOVE SPACES TO OUTPUT-AREA.
044000     MOVE 0 TO SUB1.
           CLOSE OUT-FILE WORK-FILE.
           OPEN INPUT WORK-FILE.
044100 6-MAIN-READ-WORKF.
044200     ADD 1 TO ACT-KEY-2.
      *--------- CORRECTED PROBLEM WITH DISPLAYING RECORDS.
044300*    IF ACT-KEY-2 NOT < REL-RECS-CTR
044300     IF ACT-KEY-2 > REL-RECS-CTR
044400         IF INPUT-PRINT = " "
045300             MOVE 66122 TO CATREAD-MSG-NUMBER
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE ERROR-BUFFER TO MESSAGE-LINE
                   MOVE SPACES TO OUTPUT-CMD-LINE
                   MOVE "FQ12INQ2" TO VIEW-CFNAME
                   MOVE OUTPUT-AREA TO DSPLY-REC
                   PERFORM 99-SCREEN-WRITE
045600             PERFORM 98-SCREEN-READ
                   MOVE SPACES TO ERROR-BUFFER
047800             GO TO 2-EOJ
045200         ELSE
044500         MOVE SPACES TO PRINTF
044600         WRITE PRINTF AFTER ADVANCING NEW-PAGE
045000         CLOSE PRINT-FILE
045100         GO TO 6-MAIN.
047900     READ WORK-FILE    INVALID KEY
               MOVE 17 TO COND-WORD.
           IF COND-WORD = 17
               IF INPUT-PRINT = " "
048000             MOVE 66122 TO CATREAD-MSG-NUMBER
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE ERROR-BUFFER TO MESSAGE-LINE
                   MOVE SPACES TO OUTPUT-CMD-LINE
                   MOVE OUTPUT-AREA TO DSPLY-REC
                   MOVE "FQ12INQ2" TO VIEW-CFNAME
                   PERFORM 99-SCREEN-WRITE
                   PERFORM 98-SCREEN-READ
048700             GO TO 2-EOJ
045200         ELSE
044500         MOVE SPACES TO PRINTF
044600         WRITE PRINTF AFTER ADVANCING NEW-PAGE
045000         CLOSE PRINT-FILE
045100         GO TO 6-MAIN.
048800     IF INPUT-PRINT = " "
048900         NEXT SENTENCE
049000     ELSE
049100     PERFORM 6-SPOOL THRU 6-SPOOL-EXIT
049200     GO TO 6-MAIN-READ-WORKF.
049300     MOVE 1 TO DATE-MODE.
049400     CALL "TDATECHK" USING DATE-CHECK-AREA.
049500     MOVE WORK-ORIG TO OUTPUT-ORIG.
049600     MOVE DATE-OUT TO OUTPUT-DATE.
049700     ACCEPT CUR-TIME-BUFF FROM TIME.
049800     MOVE CUR-TIME-HH-MM TO OUTPUT-TIME.
049900     ADD 1 TO SUB1.
050000     IF SUB1 > 7
050100         MOVE 30077 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE ERROR-BUFFER TO MESSAGE-LINE
               MOVE 66372 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE ERROR-BUFFER TO OUTPUT-CMD-LINE
               MOVE OUTPUT-AREA TO DSPLY-REC
               MOVE "FQ12INQ2" TO VIEW-CFNAME
               PERFORM 99-SCREEN-WRITE
               PERFORM 98-SCREEN-READ
               MOVE SPACES TO ERROR-BUFFER
               MOVE DSPLY-REC TO OUTPUT-AREA
050800         IF VIEW-LASTKEY = 3
050900             GO TO 2-EOJ
051700         ELSE
051800         IF VIEW-LASTKEY = 5
051900             MOVE SPACES TO OUTPUT-AREA
052000             GO TO 6-MAIN
051000         ELSE
051200         MOVE 1 TO SUB1
051300         MOVE SPACES TO OUTPUT-DATA MESSAGE-LINE
                   OUTPUT-CMD-LINE OUTPUT-MSG-LINE.
053400     MOVE WORK-WO TO OUTPUT-WO (SUB1).
053500     MOVE WORK-REQ-NO TO OUTPUT-REQ-NO (SUB1).
053600     MOVE WORK-ORDERED TO OUTPUT-ORDERED (SUB1).
053700     MOVE WORK-PO-NO TO OUTPUT-PO-NO (SUB1).
053800     MOVE WORK-RECEIVED TO OUTPUT-RECEIVED (SUB1).
053900     IF WORK-RCV-DATE = SPACES
054000         MOVE SPACES TO OUTPUT-RCV-DATE (SUB1)
054100     ELSE
054200     MOVE 4 TO DATE-MODE
054300     MOVE WORK-RCV-DATE TO DATE-VALIDATE-IN
054400     CALL "TDATECHK" USING DATE-CHECK-AREA
054500     MOVE DATE-SLASH-OUT TO OUTPUT-RCV-DATE (SUB1).
054600     MOVE WORK-DESCRIPTION TO OUTPUT-DESC (SUB1).
054700     GO TO 6-MAIN-READ-WORKF.
054800
054900 6-MAIN-EXIT.    EXIT.
055000
057700 6-SPOOL.
057800     ADD 3 TO LINE-CTR.
057900     IF LINE-CTR > 58 PERFORM 6-SPOOL-HEADERS.
058000     MOVE SPACES TO D1 D2.
058100     MOVE WORK-WO TO D1-WO-NO.
058200     MOVE WORK-REQ-NO TO D1-REQ-NO.
058300     MOVE WORK-PO-NO TO D1-PO-NO.
058400     MOVE WORK-RECEIVED TO D1-DLVRD.
058500     MOVE WORK-ORDERED TO D1-ORDRD.
058600     IF WORK-RCV-DATE = SPACES
058700         MOVE SPACES TO D1-RCVDAT
058800     ELSE
058900     MOVE 4 TO DATE-MODE
059000     MOVE WORK-RCV-DATE TO DATE-VALIDATE-IN
059100     CALL "TDATECHK" USING DATE-CHECK-AREA
059200     MOVE DATE-SLASH-OUT TO D1-RCVDAT.
059300     WRITE PRINTF FROM D1 AFTER ADVANCING 1 LINES.
059400     MOVE WORK-DESCRIPTION TO D2-DESC.
059500     WRITE PRINTF FROM D2 AFTER ADVANCING 1 LINES.
059600     MOVE ALL "-" TO D2-DESC.
059700     WRITE PRINTF FROM D2 AFTER ADVANCING 1 LINES.
059800 6-SPOOL-EXIT.    EXIT.
059900
060000 6-SPOOL-HEADERS.
060100     MOVE 0 TO LINE-CTR.
060200     MOVE INPUT-ORIG TO H1-ORIG.
060300     WRITE PRINTF FROM H1 AFTER ADVANCING NEW-PAGE.
060400     WRITE PRINTF FROM H2 AFTER ADVANCING 2 LINES.
060500     WRITE PRINTF FROM H3 AFTER ADVANCING 1 LINES.
060600     WRITE PRINTF FROM H4 AFTER ADVANCING 1 LINES.
060700     ADD 5 TO LINE-CTR.
060800
060900 6-GET-RECORDS.
           MOVE 0 TO ACT-KEY.
       6-GR-CONT.
061400     PERFORM 69-READ-WO-PARTS-FILE-3 THRU 69-RWPF3-EXIT.
061700     IF COND-WORD = 15 GO TO 6-GR-EXIT.
062400     MOVE SPACES TO OUTF.
062500     MOVE PRT-WO-NU TO OUT-WO.
062600     MOVE PRT-ORIGINATOR TO OUT-ORIG.
062700     MOVE PRT-DESC TO OUT-DESCRIPTION.
062800     MOVE PRT-PO-NO TO OUT-PO-NO.
062900     MOVE PRT-REQ-NO TO OUT-REQ-NO.
063000     PERFORM 6-CALL-CMANINQ THRU 6-CC-EXIT.
           IF OUT-RECVD = SPACES GO TO 6-GR-CONT.
063100     IF OUT-RECEIVED = ZEROES GO TO 6-GR-CONT.
063400     ADD 1 TO REL-RECS-CTR.
           MOVE 0 TO COND-WORD.
063500     PERFORM 6-WRITE-OUTF THRU 6-WO-EXIT.
           IF COND-WORD = 17 GO TO 6-GR-EXIT.
063600     GO TO 6-GR-CONT.
063700
068700 6-GR-EXIT.    EXIT.
068800
063800 6-CALL-CMANINQ.
063900     IF PRT-REQ-NO = SPACES OR "CANCEL" GO TO 6-CC-EXIT.
064000     MOVE SPACES TO CMR-DATA CMR-DESC CMR-REMARKS
064100         CMR-RETURNED-DATA CMR-REMARKS BU-DISPLAY-MSG.
064200     MOVE PRT-REQ-NO TO CMR-REQ-NUMBER.
064300     MOVE PRT-WO-NU TO CMR-WO-NUMBER.
064400     MOVE "IN" TO CMR-CALL-MODE.
064500     CALL "CMANINQ" USING BASE-STORES
064600                          CMR-CALL-MODE
064700                          CMR-DATA
064800                          CMR-DESC
064900                          CMR-REMARKS
065000                          CMR-RETURNED-DATA
065100                          CMR-MISC-PARMS
065200                          LANGUAGE-PARMS
065300                          ESC-NAME
065400                          STATUS-AREA
065500                          BU-DISPLAY-MSG.
065600     IF CMR-RETURN-STATUS NOT = "OK" GO TO 6-CC-EXIT.
065700     IF CMR-PO-NO-AND-REL = SPACES
065800         MOVE CMR-DESC-LINE (1) TO OUT-DESCRIPTION
065900     ELSE
066000     MOVE CMR-PO-NO-AND-REL TO OUT-PO-NO
066100     MOVE CMR-PO-QTY-ORD TO OUT-ORDERED
066200     MOVE CMR-DESC-LINE (1) TO OUT-DESCRIPTION
066300     IF CMR-PO-QTY-DLVR > 0
066400         MOVE CMR-PO-QTY-DLVR TO OUT-RECEIVED
066500         MOVE CMR-PO-DATE-RCVD-CN TO OUT-RCV-DATE-CN
066600         IF DATE-RANGE-AREA = SPACES
066700              NEXT SENTENCE
066800         ELSE
066900         IF OUT-RCV-DATE-CN NOT < DRA-FROM-CN
067000             IF OUT-RCV-DATE-CN NOT > DRA-TO-CN
067100                 NEXT SENTENCE
067200             ELSE
067300             MOVE ZEROES TO OUT-RECEIVED
067400         ELSE
067500         MOVE ZEROES TO OUT-RECEIVED
067600     ELSE
067700     MOVE ZEROES TO OUT-RECEIVED.
067800
067900 6-CC-EXIT.    EXIT.
068000
068100 6-WRITE-OUTF.
068400     ADD 1 TO ACT-KEY.
068200     WRITE OUTF    INVALID KEY MOVE 17 TO COND-WORD.
068500 6-WO-EXIT.    EXIT.
068600
       69-READ-WO-PARTS-FILE-3.
           MOVE 0 TO COND-WORD.
           READ WO-PARTS-FILE-3 NEXT INTO WO-PARTS-DATA
               AT END    MOVE 15 TO COND-WORD.
      *------------- ADDED "IF COND-WORD" STATEMENTS BECAUSE THE
      *------------- PROGRAM WAS LOOPING ON THE LAST RECORD IF IT
      *------------- MET THE SEARCH CRITERIA.
           IF COND-WORD NOT = 15
               IF PRT-ORIGINATOR NOT = INPUT-ORIG
                    MOVE 15 TO COND-WORD
                    GO TO 69-RWPF3-EXIT.
           IF COND-WORD NOT = 15
061800         IF PRT-STATUS-1 NOT = "M"
061900             GO TO 69-READ-WO-PARTS-FILE-3
062000         ELSE
062100         IF PRT-REQ-NO = SPACES
062200              GO TO 69-READ-WO-PARTS-FILE-3.
           IF WPFD3-STATUS NOT = "00" MOVE 15 TO COND-WORD.
       69-RWPF3-EXIT.    EXIT.

       69-START-WO-PARTS-FILE-3.
           MOVE 0 TO COND-WORD.
041200     MOVE INPUT-ORIG TO PRTCCNUM OF WPFD3REC.
           START WO-PARTS-FILE-3 KEY IS = EXTERNALLY-DESCRIBED-KEY
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF WPFD3-STATUS NOT = "00" MOVE 17 TO COND-WORD.

       98-SCREEN-READ.
           READ DISPLAY-FILE FORMAT IS VIEW-CFNAME
               INDIC IS INDICS.
           ACCEPT IOFEEDBACK FROM I-O-FEEDBACK-AREA.
           MOVE ALL B"0" TO INDICS.
           IF DSPLY-STATUS NOT = "00"
               MOVE 3 TO VIEW-LASTKEY
           ELSE
           MOVE FUNCTION-NUM TO VIEW-LASTKEY.

       99-SCREEN-WRITE.
           WRITE DSPLY-REC FORMAT IS VIEW-CFNAME
               INDIC IS INDICS.
           MOVE ALL B"0" TO INDICS.

       COPY OVRPFCALL IN COPYLIB.

       999-CATREAD.
           MOVE SPACES TO ERROR-BUFFER.
           CALL "CCATREAD" USING CATREAD-PARMS.
           MOVE CATREAD-MSG-TEXT TO ERROR-BUFFER.
       999-CATREAD-EXIT.    EXIT.

068900 7-SORT-RECORDS.
069000     MOVE 0 TO ACT-KEY.
           CLOSE OUT-FILE.
           OPEN INPUT OUT-FILE.
           PERFORM 7-SR THRU 7-SR-EXIT.
069100 7-SR.
069200     ADD 1 TO ACT-KEY.
      *--------- CORRECTED PROBLEM WITH DISPLAYING RECORDS.
069300*    IF ACT-KEY = REL-RECS-CTR GO TO 7-SR-EXIT.
           IF ACT-KEY > REL-RECS-CTR GO TO 7-SR-EXIT.
           READ OUT-FILE    INVALID KEY GO TO 7-SR-EXIT.
069500     MOVE OUT-DATA TO SORTF.
069600     RELEASE SORTF.
069700     GO TO 7-SR.
069800
069900 7-SR-EXIT.    EXIT.
070000
070100 8-WRITE-OUTPUT.
           MOVE 0 TO ACT-KEY-2.
           OPEN OUTPUT WORK-FILE.
           PERFORM 8-WO-CONT THRU 8-WO-EXIT.
       8-WO-CONT.
070200     RETURN SORT-FILE AT END GO TO 8-WO-EXIT.
070300     MOVE SPACES TO WORKF.
070600     ADD 1 TO ACT-KEY-2.
070400     MOVE SORTF TO WORK-DATA.
070500     WRITE WORKF    INVALID KEY GO TO 8-WO-EXIT.
070700     GO TO 8-WO-CONT.
070800
070900 8-WO-EXIT.    EXIT.
