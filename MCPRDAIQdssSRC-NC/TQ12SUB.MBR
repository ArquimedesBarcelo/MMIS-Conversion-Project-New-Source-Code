017600     05  INPUT-PRINT              PIC X.
017700     05  INPUT-FILL               PIC X(5).
           05  INPUT-CMD-LINE           PIC X(79).
           05  INPUT-ERR-LINE           PIC X(79).
       COPY IOFEEDBACK IN COPYLIB.
       COPY JCWAREA    IN COPYLIB.
       COPY LANGSUB OF COPYLIB.
