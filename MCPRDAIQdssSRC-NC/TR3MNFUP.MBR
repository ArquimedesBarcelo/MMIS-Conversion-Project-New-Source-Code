       IDENTIFICATION DIVISION.
       PROGRAM-ID.           TR3MNFUP.
       AUTHOR.               CA YODER.
       DATE-WRITTEN.         MAY 2013.
      *INSTALLATION.         GOODYEAR TIRE AND RUBBER CO.

      *D* REMARKS.
      *D*
      *D*    CPPI# 2011-22767969   RFC# 4089
      *D*
      *D*    THIS PROGRAM WILL UPDATE THE MANUFACTURER/PART NUMBER
      *D*    INFORMATION SENT FROM SAP.  THE FILE UPDATED IS DMANPART.
      *D*    ERRORS ARE WRITTEN TO THE REPORT FILE R3MNFRPF.
      *D*
      *D*    IF THE BLOCK CODE FROM SAP > SPACES, THEN THE MAN-PARTNO-SELECT
      *D*    FIELD WILL BE SET TO SPACE.  IF THE BLOCK CODE =
      *D*    SPACES, THE MAN-PARTNO-SELECT FIELD WILL BE SET TO B
      *D*    FOR PREFERRED.
      *D*
      *C* CHANGES.
      *C*
      *C*   XX/XX/XXXX    NAMEXXXXX  RFC# XXXX  CPPI#XXXXXXXXXXXXX
      *C*
      *C*

       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.
       SPECIAL-NAMES.    I-O-FEEDBACK IS I-O-FEEDBACK-AREA.

      ******************************************************************
       INPUT-OUTPUT SECTION.
      ******************************************************************
       FILE-CONTROL.

           SELECT MPLTINFO-I
               ASSIGN         TO DATABASE-MCFLCS0501
               ORGANIZATION   IS INDEXED
               ACCESS MODE    IS DYNAMIC
               RECORD KEY     IS EXTERNALLY-DESCRIBED-KEY
               FILE STATUS    IS FILE-STATUS.

           SELECT MSTORERM-I
               ASSIGN         TO DATABASE-MCFLCS0201
               ORGANIZATION   IS INDEXED
                 ACCESS MODE  IS DYNAMIC
               RECORD KEY     IS EXTERNALLY-DESCRIBED-KEY
               FILE STATUS    IS FILE-STATUS.

           SELECT DMANPART-IO
               ASSIGN         TO DATABASE-MCFLCS3603
               ORGANIZATION   IS INDEXED
                 ACCESS MODE  IS DYNAMIC
               RECORD KEY     IS EXTERNALLY-DESCRIBED-KEY
                              WITH DUPLICATES
               FILE STATUS IS FILE-STATUS.

           SELECT R3MNFUP-I
               ASSIGN         TO DATABASE-R3MNFUP
               ORGANIZATION   IS SEQUENTIAL
                 ACCESS MODE  IS SEQUENTIAL
               FILE STATUS    IS FILE-STATUS.

           SELECT R3MNF-RPT-O
               ASSIGN         TO DISK-R3MNFRPF
               FILE STATUS    IS FILE-STATUS.

      ******************************************************************
       DATA DIVISION.
      ******************************************************************

       FILE SECTION.

       FD  MPLTINFO-I
           LABEL RECORDS ARE STANDARD.
       01  MPLTINFO-REC-I.
           COPY DDS-MCRPCS0500  OF MCFLCS0501.

       FD  MSTORERM-I
           LABEL RECORDS ARE STANDARD.
       01  MSTORERM-REC-I.
           COPY DDS-ALL-FORMATS OF MCFLCS0201.

       FD  DMANPART-IO
           LABEL RECORDS ARE STANDARD.
       01  DMANPART-REC-IO.
           COPY DDS-MCRPCS3600  OF MCFLCS3603.

       FD  R3MNFUP-I
           LABEL RECORDS ARE STANDARD.
       01  R3MNFUP-REC-I        PIC X(87).

       FD  R3MNF-RPT-O
           LABEL RECORDS ARE OMITTED
           RECORD CONTAINS 133 CHARACTERS
           DATA RECORD IS R3MNF-RPT-REC.
       01  R3MNF-RPT-REC.
           05  RPT-CTL                   PIC X(1).
           05  RPT-LINE.
               10  CONTROL-DATE          PIC X(6).
               10  FILLER                PIC X(126).

      ******************************************************************
       WORKING-STORAGE SECTION.
      ******************************************************************

       77  SUB                    PIC 9.
       77  MSG-SUB                PIC 9.
       77  SAVE-PLANT-CODE        PIC X(4).
       77  PAGE-COUNT             PIC 999.
       77  LINE-COUNT             PIC 99.
       77  ERROR-SW               PIC X.
       77  UPDATE-CODE-SW         PIC X.
       77  FIRST-CODE-REC-SW      PIC X.
       77  NUM-RECS-PROC          PIC 9(5).

      *-----------------------------------------------------------------
      *  A R G U M E N T   V A L U E S
      *-----------------------------------------------------------------

       01  CODE-ARG                 PIC X(8)  VALUE SPACES.

      *-----------------------------------------------------------------
      *  F L A G S   A N D   S W I T C H E S
      *-----------------------------------------------------------------

       01  RTN-CODE                 PIC X.

      *-----------------------------------------------------------------
      *  R E P O R T   L I N E S
      *-----------------------------------------------------------------

       01  PRT-RPT-HDG-1.
           05                    PIC X(3).
           05  PRT-DATE-H1       PIC X(8).
           05                    PIC X(32).
           05                    PIC X(46)
               VALUE "R/3 MANUFACTUR/PART NUMBER UPDATE ERROR REPORT".
           05                    PIC X.
           05  PRT-PLT-H1        PIC X(4).
           05                    PIC X(28).
           05                    PIC X(8) VALUE "TR3MNFUP".
           05                    PIC X(3).

       01  PRT-RPT-HDG-2.
           05                    PIC X(3).
           05  PRT-TIME-H2       PIC X(8).
           05                    PIC X(49).
           05                    PIC X(6) VALUE "SEQ # ".
           05  PRT-SEQ-H2        PIC X(5).
           05                    PIC X(50).
           05                    PIC X(5) VALUE "PAGE ".
           05  PRT-PG-H2         PIC ZZ9.
           05                    PIC X(3).

       01  PRT-RPT-HDG-3.
           05                    PIC X(3).
           05                    PIC X(7) VALUE "CODE   ".
           05                    PIC X(3).
           05                    PIC X(5) VALUE "ERROR".
           05                    PIC X(75).
           05                    PIC X(40).

       01  PRT-RPT-HDG-4.
           05                    PIC X(3).
           05                    PIC X(7)   VALUE ALL "-".
           05                    PIC X(3).
           05                    PIC X(110) VALUE ALL "-".
           05                    PIC X(10).

       01  ERR-RPT-LINE.
           05                    PIC X(3).
           05  ERR-RPT-CODE      PIC X(8).
           05                    PIC X(2).
           05  ERR-RPT-MSG       PIC X(110).
           05                    PIC X(10).

       01  REC-PROC-RPT-LINE.
           05                    PIC X(14)  VALUE "   ****       ".
           05  REC-PROC-COUNT    PIC ZZZZ9.
           05                    PIC X(20) VALUE "  RECORDS PROCESSED ".

      *-----------------------------------------------------------------
      *  D A T A B A S E   A N D   F I L E   B U F F E R S
      *-----------------------------------------------------------------

      *--------- INPUT RECORDS FROM SAP R/3.
       01  R3-INPUT-RECORD.
           05  R3-HEADERID               PIC X(7).
           05  R3-FILEID                 PIC X(7).
           05  R3-LOC                    PIC X(4).
           05  R3-CREATE-DATE            PIC X(8).
           05  R3-CREATE-TIME            PIC X(6).
           05  R3-FILE-SEQ               PIC 9(5).
           05  FILLER                    PIC X(163).

       01  R3-DATA-RECORD  REDEFINES  R3-INPUT-RECORD.
           05  R3-CODE                   PIC X(8).
           05  R3-BLOCK                  PIC X(4).
           05  R3-MANUFACTURER           PIC X(35).
           05  R3-PART-NUM               PIC X(40).

       COPY MSTORERM   IN COPYLIB.
       COPY MPLT0      IN COPYLIB.
       COPY MPLTSAP    IN COPYLIB.
       COPY DMANPART   IN COPYLIB.

      *-----------------------------------------------------------------
      *  D A T A B A S E   S T A T U S   A R E A
      *-----------------------------------------------------------------

       01  FILE-STATUS.
           05  FILE-STATUS-1             PIC X.
           05  FILE-STATUS-2             PIC X.

       COPY DBCSACCT OF COPYLIB.

       COPY DATAB    OF COPYLIB.

       01  R3MNFUP-EOF-SW                PIC X.

      *-----------------------------------------------------------------
      *  U T I L I T Y   A R E A
      *-----------------------------------------------------------------

       COPY TBLOWUP OF COPYLIB.

       COPY VCOMAREA OF COPYLIB.

       COPY TDATECHK IN COPYLIB.

      ******************************************************************
       PROCEDURE DIVISION.
      ******************************************************************

       00-CONTROL.

           PERFORM 10-HSK.

           IF ERROR-SW = "N"
               PERFORM 60-MAIN.

           PERFORM 20-EOJ.

           GOBACK.

       10-HSK.

           OPEN INPUT      R3MNFUP-I
                           MPLTINFO-I
                           MSTORERM-I
                I-O        DMANPART-IO
                EXTEND     R3MNF-RPT-O.
           MOVE "N"                   TO  ERROR-SW.
           MOVE "Y"                   TO  FIRST-CODE-REC-SW.
           MOVE 0                     TO  NUM-RECS-PROC.

      *--------- GET SAP PLANT NUMBER.
           MOVE "SAP " TO PLTINFOKEY  OF MPLTINFO-REC-I.
           READ MPLTINFO-I INTO BUF-MPLTINFO
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           MOVE MPLTINFO-SAP-PLT-CODE TO SAVE-PLANT-CODE
                                         PRT-PLT-H1.

           MOVE "*****"               TO  PRT-SEQ-H2.
      *--------- READ HEADER RECORD.
           PERFORM 9999-READ-R3MNFUP-I.
           IF R3-HEADERID NOT = "HEADER "
               MOVE "** NO HEADER RECORD FOUND **"
                                      TO  ERR-RPT-MSG
               MOVE "Y"               TO  ERROR-SW
           ELSE
           IF SAVE-PLANT-CODE NOT = R3-LOC
               MOVE "** FILE NOT FOR THIS PLANT **"
                                      TO  ERR-RPT-MSG
               MOVE R3-FILE-SEQ       TO  PRT-SEQ-H2
               MOVE "Y"               TO  ERROR-SW
           ELSE

               MOVE R3-FILE-SEQ       TO  PRT-SEQ-H2.
           PERFORM 11-MOVE-RPT-HDG-DATA.
           PERFORM 9999-WRITE-RPT-HDGS.

      *--------- READ FIRST UPDATE RECORD.
           IF ERROR-SW = "N"
               PERFORM 9999-READ-R3MNFUP-I
               IF R3-HEADERID = "TRAILER"
                   MOVE "** NO UPDATE RECORDS FOUND **"
                                      TO  ERR-RPT-MSG
                   MOVE "Y"           TO  ERROR-SW.

           IF ERROR-SW = "Y"
               MOVE ERR-RPT-LINE      TO  RPT-LINE
               PERFORM 9999-WRITE-RPT-REC.

      *------- MOVE HEADING DATA TO REPORT.
       11-MOVE-RPT-HDG-DATA.
           MOVE 1                        TO  DATE-MODE.
           CALL "TDATECHK" USING DATE-CHECK-AREA.
           MOVE DATE-SLASH-OUT           TO  PRT-DATE-H1.
           MOVE DATE-FORMATTED-TIME-OUT  TO  PRT-TIME-H2.
           MOVE "*"                      TO  RPT-CTL.
           MOVE DATE-YMD-OUT             TO  CONTROL-DATE.
           WRITE R3MNF-RPT-REC.
           MOVE SPACES                   TO  R3MNF-RPT-REC.

       20-EOJ.
      *----------- IF NO ERRORS WRITTEN TO REPORT, INDICATE THAT
      *----------- ALL RECORDS WERE PROCESSED.
           IF PAGE-COUNT = 1 AND LINE-COUNT < 6
               MOVE SPACES               TO  ERR-RPT-CODE
               MOVE "** ALL RECORDS PROCESSED **"
                                         TO  ERR-RPT-MSG
               MOVE ERR-RPT-LINE         TO  RPT-LINE
               PERFORM 9999-WRITE-RPT-REC
           ELSE IF NUM-RECS-PROC > 0
               MOVE NUM-RECS-PROC        TO  REC-PROC-COUNT
               MOVE REC-PROC-RPT-LINE    TO  RPT-LINE
               PERFORM 9999-WRITE-RPT-REC.

           CLOSE           MSTORERM-I
                           DMANPART-IO
                           R3MNFUP-I
                           MPLTINFO-I
                           R3MNF-RPT-O.

      *-----------------------------------------------------------------
      *    M A I N   P A R A G R A P H
      *-----------------------------------------------------------------

       60-MAIN.
      *------- READ INPUT FILE UNTIL END-OF-FILE.  WHEN
      *------- MULTIPLE TRANSMISSIONS ARE IN THE SAME FILE, WE NEED
      *------- TO PROCESS UNTIL END-OF-FILE INSTEAD OF LOOKING FOR
      *------- THE TRAILER RECORD.  THERE MAY BE MULTIPLE TRAILER
      *------- RECORDS IN THE SAME FILE.

           PERFORM 600-PROCESS-UPDATES UNTIL R3MNFUP-EOF-SW = "Y".

       600-PROCESS-UPDATES.
           IF R3-HEADERID NOT = "HEADER " AND
              R3-HEADERID NOT = "TRAILER"
                IF FIRST-CODE-REC-SW = "Y"
                    PERFORM 9999-READ-MSTORERM-I
                    IF ERROR-SW = "Y"
                        MOVE ERR-RPT-LINE         TO  RPT-LINE
                        PERFORM 9999-WRITE-RPT-REC
                        MOVE "N"                  TO  UPDATE-CODE-SW
                    ELSE
                        MOVE "Y"                  TO  UPDATE-CODE-SW
                        PERFORM 9999-DELETE-DMANPART
                        MOVE "N"                  TO  FIRST-CODE-REC-SW
                    END-IF
                END-IF

      *------- IF THE CODE EXISTS IN MSTORERM, THEN ADD THE DMANPART
      *------- ENTRIES UNTIL THE NEXT CODE.
               IF UPDATE-CODE-SW = "Y"
                   PERFORM 610-UPDATE-DMANPART.

           PERFORM 9999-READ-R3MNFUP-I.
           IF R3-CODE NOT = CODE-ARG
               MOVE "Y"                           TO  FIRST-CODE-REC-SW
           ELSE
               MOVE "N"                           TO  FIRST-CODE-REC-SW.

       610-UPDATE-DMANPART.
           MOVE R3-CODE                  TO  MAN-CORPCODE.
           MOVE R3-MANUFACTURER          TO  MAN-NAME.
           MOVE R3-PART-NUM              TO  MAN-PARTNO.
           MOVE " "                      TO  MAN-PARTNO-TYPE.
           IF R3-BLOCK = SPACES
               MOVE "B"                  TO  MAN-PARTNO-SELECT
           ELSE
               MOVE SPACE                TO  MAN-PARTNO-SELECT.

           WRITE DMANPART-REC-IO FROM BUF-DMANPART
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           ADD 1                         TO  NUM-RECS-PROC.

      *-----------------------------------------------------------------
      *9999 UTILITY SECTION.
      *-----------------------------------------------------------------

       9999-BLOWUP.
           MOVE "TR3MNFUP" TO BU-PGM-NAME.
           CALL "TBLOWUP" USING BASE, BU-PGM-NAME, STATUS-AREA,
              VIEW-COMAREA, FILE-STATUS, BU-DISPLAY-MSG,
              BU-DISPLAY-FLDS.

      *---------------------------------
      * R3MNFUP-I
      *---------------------------------

       9999-READ-R3MNFUP-I.
           READ R3MNFUP-I INTO R3-INPUT-RECORD
               AT END MOVE "Y" TO R3MNFUP-EOF-SW.

      *---------------------------------
      * READ MSTORERM
      *---------------------------------

       9999-READ-MSTORERM-I.
           MOVE R3-CODE TO CODE-ARG
           MOVE "N"                      TO  ERROR-SW
           MOVE 0 TO COND-WORD.
           MOVE CODE-ARG TO CORPCDE OF MSTORERM-REC-I.
           READ MSTORERM-I INTO BUF-MSTORERM
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           MOVE R3-CODE                  TO  ERR-RPT-CODE
           IF FILE-STATUS NOT = "00"
               MOVE "CODE DOES NOT EXIST IN DATABASE"
                                         TO  ERR-RPT-MSG
               MOVE "Y"                  TO  ERROR-SW.

      *---------------------------------
      * DELETE DMANPART ENTRIES
      *---------------------------------

       9999-DELETE-DMANPART.
           MOVE 0 TO COND-WORD.
           MOVE R3-CODE TO CODE-ARG.
           MOVE CODE-ARG TO CORPCDE OF DMANPART-REC-IO.
           START DMANPART-IO KEY = CORPCDE OF DMANPART-REC-IO
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS = "00"
               READ DMANPART-IO NEXT INTO BUF-DMANPART
                   AT END MOVE FILE-STATUS TO FILE-STATUS
               END-READ
               MOVE 0 TO COND-WORD
               PERFORM UNTIL MAN-CORPCODE NOT = R3-CODE
                   DELETE DMANPART-IO
                       INVALID KEY MOVE FILE-STATUS TO FILE-STATUS
                   END-DELETE
                   READ DMANPART-IO NEXT INTO BUF-DMANPART
                       AT END MOVE FILE-STATUS TO FILE-STATUS
                   END-READ
               END-PERFORM.

      *---------------------------------
      * WRITE ERROR REPORT RECORD
      *---------------------------------

       9999-WRITE-RPT-REC.
           MOVE "2"             TO  RPT-CTL.
           WRITE R3MNF-RPT-REC.
           ADD 2                TO  LINE-COUNT.
           IF LINE-COUNT > 55
               PERFORM 9999-WRITE-RPT-HDGS.

      *---------------------------------
      * REPORT HEADING LINES
      *---------------------------------

       9999-WRITE-RPT-HDGS.
           ADD 1                TO  PAGE-COUNT.
           MOVE PAGE-COUNT      TO  PRT-PG-H2.

           MOVE "0"             TO  RPT-CTL.
           MOVE PRT-RPT-HDG-1   TO  RPT-LINE.
           WRITE R3MNF-RPT-REC.

           MOVE "1"             TO  RPT-CTL.
           MOVE PRT-RPT-HDG-2   TO  RPT-LINE.
           WRITE R3MNF-RPT-REC.

           MOVE "2"             TO  RPT-CTL.
           MOVE PRT-RPT-HDG-3   TO  RPT-LINE.
           WRITE R3MNF-RPT-REC.

           MOVE "1"             TO  RPT-CTL.
           MOVE PRT-RPT-HDG-4   TO  RPT-LINE.
           WRITE R3MNF-RPT-REC.

           MOVE 5               TO  LINE-COUNT.

