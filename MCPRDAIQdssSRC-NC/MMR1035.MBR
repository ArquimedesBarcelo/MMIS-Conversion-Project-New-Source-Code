     C**************************************************************************
     C*
     C                   SETON                                        LR
     C/EJECT
     C*
     C     LOADSFT       BEGSR
     C*
     C                   CLOSE     MCFPMM1060
     C                   OPEN      MCFPMM1060
     C                   READ      MCRPMM1060                             44
     C*
     C     XPLANT        IFEQ      'ASHEBORO'
     C                   EXSR      ASHE
     C                   GOTO      LOADEND
     C                   END
     C*
     C*
     C     *IN44         DOWEQ     '0'
     C*
     C                   MOVE      CHKTIME       CHKTIMEN
     C     CHKDATE       IFGE      CT60DATE
     C     CHKTIMEN      IFGE      CT60START
     C                   READ      MCRPMM1050
     C                   GOTO      GOON
     C                   ELSE
     C                   GOTO      GOON
     C                   END
     C                   END
     C*
     C*
     C                   READ      MCRPMM1060                             44
     C*
     C*
     C                   END
     C*
     C     GOON          TAG
     C*
     C     CTNUMSHIFT    IFEQ      2
     c*
     C     CHKTIMEN      IFGE      CTSTART1ST
     C     CHKTIMEN      ORLT      CTSTART2ND
     C                   MOVE      '1'           SHIFTKEY
     C                   ELSE
     C                   MOVE      '2'           SHIFTKEY
     C                   END
     C*
     C                   END
     C*
     C     CTNUMSHIFT    IFEQ      3
     C*
     C     CHKTIMEN      IFGE      CTSTART1ST
     C     CHKTIMEN      ORLT      CTSTART2ND
     C                   MOVE      '1'           SHIFTKEY
     C*
     C                   ELSE
     C*
     C*
     C     CHKTIMEN      IFGE      CTSTART2ND
     C     CHKTIMEN      ANDLT     CTSTART3RD
     C                   MOVE      '2'           SHIFTKEY
     C                   ELSE
     C                   MOVE      '3'           SHIFTKEY
     C                   END
     C                   END
     C                   END
     C*
     C
     C     LOADEND       TAG
     C
     C                   ENDSR
     C/EJECT
     C     ASHE          BEGSR
     C*
     C                   MOVE      CHKTIME       CHKTIMEN
     C     CHKDATE       IFGE      CT60DATE
     C     CHKTIMEN      IFLT      CT60START
     C                   READP     MCRPMM1050
     C                   GOTO      GOON1
     C                   ELSE
     C                   GOTO      GOON1
     C                   END
     C                   END
     C*
     C*
     C     GOON1         TAG
     C*
     c*
     C     CHKTIMEN      IFGE      CTSTART1ST
     C     CHKTIMEN      ANDLE     CTSTART2ND
     C                   MOVE      '1'           SHIFTKEY
     C                   ELSE
     C                   MOVE      '2'           SHIFTKEY
     C                   END
     C*
     C                   ENDSR
