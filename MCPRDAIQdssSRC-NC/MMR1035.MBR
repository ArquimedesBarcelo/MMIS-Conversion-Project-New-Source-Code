     F****************************************************************
     FMCFLMM100CIF   E           K DISK
     FMCFLMM110CIF   E           K DISK
     FMCFPMM1030UF A E           K DISK
     FMCFPMM1130UF A E           K DISK
     FMCFPMM1050IF   E           K DISK
     FMCFPMM1060IF   E           K DISK
     FMCFPMM1080IF   E           K DISK
     D*
     D  CHKKEY         S              8
     D  CHKZONE        S              4
     D  CHKHOUR        S              2
     D  SHIFTKEY       S              1
     D  CONTKEY        S              1
     D XPLANT          S              8    INZ('        ')
     D*
     D CHKTIMEN        S              4  0
     D XTIME           S             12  0
     D*
     D ATIME           DS            12
     D  AAAHH                  1      2
     D  AAAMIN                 3      4
     D  AAASS                  5      6
     D  AAAMM                  7      8
     D  AAADD                  9     10
     D  AAAYY                 11     12
     D*
     D  CHKDATE        DS             8
     D  CHKCC                  1      2
     D  CHKYY                  3      4
     D  CHKMM                  5      6
     D  CHKDD                  7      8
     D*
     D CHKTIME         DS             4
     D  CHKHH                  1      2  0
     D  CHKMIN                 3      4  0
     D*
     D SHIFTSTART      DS             4
     D  STSHH                  1      2  0
     D  STSMM                  3      4  0
     D*
     D*
     C                   TIME                    XTIME
     C                   MOVE      XTIME         ATIME
     C*
     C                   MOVE      '20'          CHKCC
     C                   MOVE      AAAHH         CHKHH
     C                   MOVE      AAAMIN        CHKMIN
     C                   MOVE      AAAMM         CHKMM
     C                   MOVE      AAADD         CHKDD
     C                   MOVE      AAAYY         CHKYY
     C*
     C*
     C     KEY1030       KLIST
     C                   KFLD                    CHKKEY
     C                   KFLD                    CHKZONE
     C*
     C                   CALL      'MMXGETSYS'
     C                   PARM                    XPLANT
     C*
