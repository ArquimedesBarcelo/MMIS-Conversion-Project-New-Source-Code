000200 IDENTIFICATION DIVISION.
000300 PROGRAM-ID. TMULTPRT.
      *C
      *C  01/04/2010  CA YODER  2010-00142425-001
      *C     UPDATE LOGIC ASSIGNING WORKORDER LETTER SUFFIX.
      *C
000400 ENVIRONMENT DIVISION.
000500 CONFIGURATION SECTION.
000600 SOURCE-COMPUTER.   AS400.
000700 OBJECT-COMPUTER.   AS400.
       SPECIAL-NAMES. I-O-FEEDBACK IS I-O-FEEDBACK-AREA
                      LOCAL-DATA IS LOCAL-DATA-AREA.
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT DISPLAY-FILE
               ASSIGN TO WORKSTATION-ZPLANNER-SI
               ORGANIZATION IS TRANSACTION
               ACCESS IS SEQUENTIAL
               FILE STATUS IS DSPLY-STATUS
               CONTROL-AREA IS WS-CONTROL.
           SELECT WO-BASIC-FILE
               ASSIGN TO DATABASE-MCFLMM1001
               ORGANIZATION IS INDEXED
               ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
               FILE STATUS IS WBF-STATUS.
           SELECT WO-LAST-NUM-USED
               ASSIGN TO DATABASE-MCFPMM0800
               ORGANIZATION IS RELATIVE
               ACCESS MODE IS RANDOM
               RELATIVE KEY IS ARG-NO
               FILE STATUS IS WLNU-STATUS.
           SELECT WO-PLANNED-FILE
               ASSIGN TO DATABASE-MCFLMM1101
               ORGANIZATION IS INDEXED
               ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
               FILE STATUS IS WPF-STATUS.
000800 DATA DIVISION.
       FILE SECTION.
       FD  DISPLAY-FILE
           LABEL RECORDS ARE OMITTED.
       01  DSPLY-REC                   PIC X(2000).
       FD  WO-BASIC-FILE
           LABEL RECORDS ARE STANDARD
           DATA RECORD IS WBFREC.
       01  WBFREC.
           COPY DDS-ALL-FORMATS OF MCFLMM1001.
       FD  WO-LAST-NUM-USED
           LABEL RECORDS ARE STANDARD
           DATA RECORD IS WLNUREC.
       01  WLNUREC.
           COPY DDS-ALL-FORMATS OF MCFPMM0800.
       FD  WO-PLANNED-FILE
           LABEL RECORDS ARE STANDARD
           DATA RECORD IS WPFREC.
       01  WPFREC.
           COPY DDS-ALL-FORMATS OF MCFLMM1101.
000900 WORKING-STORAGE SECTION.
       77  SAVE-SUB1                  PIC S9(4) COMP-4.
001200 77  SUB1                       PIC S9(4) COMP-4.
001300 77  YEAR-D                     PIC X.
      *---- 01/04/2010:  ADDED PARAMETER FOR CMMISYR.
       77  MMIS-LETTER                PIC X.
001400 01  ARG-NO                     PIC 9(9).
       COPY CATREAD IN COPYLIB.
001600 01  CONDIT-CODE                PIC X.
       COPY CPYIND  IN COPYLIB.
001700 01  CUR-DATE-WA.
002200     05  CUR-DATE-YR.
002300         10  FILLER             PIC X.
002400         10  CDY                PIC 9.
001800     05  CUR-DATE-MO            PIC 99.
002000     05  CUR-DATE-DA            PIC 99.
002500 01  ERROR-BUFFER.
002600     05  ERR-1.
002700         10  ERR-LIT1           PIC X(39).
002800         10  ERR-WO             PIC X(10).
002900         10  FILLER             PIC X(31).
003000     05  ERR-2 REDEFINES ERR-1.
003100             10  ERR-LIT2       PIC X(29).
003200             10  ERR-WO2        PIC X(10).
003300             10  FILLER         PIC X(41).
003400 01  ERROR-SWITCH.
003500     05  ERROR-SW               PIC S9(4) COMP-4.
       01  FILE-STATUSES.
           05  DSPLY-STATUS           PIC XX.
           05  WBF-STATUS             PIC XX.
           05  WLNU-STATUS            PIC XX.
           05  WPF-STATUS             PIC XX.
       COPY IOFEEDBACK IN COPYLIB.
       COPY JCWAREA OF COPYLIB.
003900 01  LAST-WO-BUFF.       COPY MLASTWO OF COPYLIB.
004100 01  PASSWORD-INFORMATION.
004200     05  NAME-OF-PROGRAM        PIC X(08) VALUE "TMULTPRT".
004300     05  PROGRAM-TYPE           PIC X(02) VALUE "UP".
004400     05  PROGRAM-RELEASE        PIC X(12) VALUE " E0100010001".
004500     05  PROGRAM-DESCRIPTION.
004600         10  PROG-DESC-A.
                   15  FILLER         PIC X(14) VALUE "MATERIALS PROC".
                   15  FILLER         PIC X(14) VALUE "ESSING PROGRAM".
                   15  FILLER         PIC X(14) VALUE " FOR MMIS - US".
                   15  FILLER         PIC X(14) VALUE "ER CAN ADD, CH".
                   15  FILLER         PIC X(4)  VALUE "ANGE".
004800         10  PROG-DESC-B.
                   15  FILLER         PIC X(14) VALUE ", DELTE AND LI".
                   15  FILLER         PIC X(14) VALUE "ST MATERIALS O".
                   15  FILLER         PIC X(14) VALUE "N A WORK ORDER".
                   15  FILLER         PIC X(18) VALUE SPACES.
005000         10  PROG-FUNCTION      PIC X(60) VALUE SPACES.
005200     05  PASSWORD-FLAG          PIC X.
005300 01  PLANT-ID                   PIC X(10).
005400 01  READ-AREA.
005500     05  READ-WOS OCCURS 20 TIMES.
005600         10  READ-WO-1-6        PIC X(6).
005700         10  READ-WO-7          PIC X.
005800         10  READ-WO-8-10       PIC XXX.
005900     05  READ-X                 PIC X.
           05  READ-CMD-LINE          PIC X(79).
           05  READ-ERR-LINE          PIC X(79).
       COPY DBSTAT OF COPYLIB.
       01  TRUE-VAL                   PIC 1 VALUE B"1".
008100 01  WO-BASIC-DATA.      COPY DWOBASIC OF COPYLIB.
008200 01  WO-PLANNED-DATA.    COPY DWOPLAN OF COPYLIB.
       COPY WSCONTROL IN COPYLIB.
008300 LINKAGE SECTION.
009000 01  DBPARAMETERS.       COPY DBPARMS OF COPYLIB.
       COPY VCOMLINK OF COPYLIB.
009300 PROCEDURE DIVISION USING DBPARAMETERS VIEW-COMAREA.
009500 START-PGM.
009600     PERFORM 1-HSK.
009700     PERFORM 6-MAIN THRU 6-MAIN-LOOP.
009800 2-EOJ.
           CLOSE DISPLAY-FILE.
           CLOSE WO-BASIC-FILE.
           CLOSE WO-LAST-NUM-USED.
           CLOSE WO-PLANNED-FILE.
009900     GOBACK.
010000 1-HSK.
           OPEN I-O   DISPLAY-FILE.
           OPEN INPUT WO-BASIC-FILE.
           OPEN INPUT WO-LAST-NUM-USED.
           OPEN INPUT WO-PLANNED-FILE.
010100     CALL "TPWORD" USING PASSWORD-INFORMATION.
010500     IF PASSWORD-FLAG = "N" GO TO 2-EOJ.
010600     MOVE LOW-VALUES TO STATUS-AREA.
           MOVE 0 TO SAVE-SUB1 SUB1.
           MOVE 0 TO COND-WORD.
010700     MOVE 1 TO ARG-NO.
           READ WO-LAST-NUM-USED INTO LAST-WO-BUFF
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF WLNU-STATUS NOT = "00" MOVE 17 TO COND-WORD.
           IF COND-WORD = 17 MOVE 1 TO DATE-FLAG-SW.
011100     MOVE PLANT-IDENT TO PLANT-ID.
011200     MOVE DATE-FLAG-SW TO DATE-FLAG.
011300     ACCEPT CUR-DATE-WA FROM DATE.
      *------- 01/04/2010:  UPDATED WORKORDER LETTER SUFFIX LOGIC.
011400*    IF CDY = 0 MOVE "A" TO YEAR-D
011500*    ELSE
011600*    IF CDY = 1 MOVE "B" TO YEAR-D
011700*    ELSE
011800*    IF CDY = 2 MOVE "C" TO YEAR-D
011900*    ELSE
012000*    IF CDY = 3 MOVE "D" TO YEAR-D
012100*    ELSE
012200*    IF CDY = 4 MOVE "E" TO YEAR-D
012300*    ELSE
012400*    IF CDY = 5 MOVE "F" TO YEAR-D
012500*    ELSE
012600*    IF CDY = 6 MOVE "G" TO YEAR-D
012700*    ELSE
012800*    IF CDY = 7 MOVE "H" TO YEAR-D
012900*    ELSE
013000*    IF CDY = 8 MOVE "J" TO YEAR-D
013100*    ELSE
013200*    MOVE "K" TO YEAR-D.

           CALL "CMMISYR" USING MMIS-LETTER.
           MOVE MMIS-LETTER    TO YEAR-D.
      *-------
           ACCEPT MC-LOCAL-DATA-AREA FROM LOCAL-DATA-AREA.
014100 6-MAIN.
           IF SUB1 = 0
               IF JCW-PJCW-261 = 2
                   MOVE "FPRNTWO2" TO VIEW-CFNAME
020900             MOVE SPACES TO READ-AREA
021000             PERFORM 610-SET-YR VARYING SUB1 FROM 1 BY 1
021100                 UNTIL SUB1 > 20
                   MOVE 52011 TO CATREAD-MSG-NUMBER
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE ERROR-BUFFER TO READ-CMD-LINE
                   MOVE READ-AREA TO DSPLY-REC
                   PERFORM 99-SCREEN-WRITE
                   PERFORM 98-SCREEN-READ
                   MOVE SPACES TO ERROR-BUFFER
                   MOVE DSPLY-REC TO READ-AREA
               ELSE
               MOVE "FPRNTWO1" TO VIEW-CFNAME
025400         MOVE SPACES TO READ-AREA
025500         PERFORM 610-SET-YR VARYING SUB1 FROM 1 BY 1
025600             UNTIL SUB1 > 20
               MOVE 52011 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE ERROR-BUFFER TO READ-CMD-LINE
               MOVE READ-AREA TO DSPLY-REC
               PERFORM 99-SCREEN-WRITE
               PERFORM 98-SCREEN-READ
               MOVE SPACES TO ERROR-BUFFER
               MOVE DSPLY-REC TO READ-AREA.
           IF VIEW-LASTKEY = 1 OR 3 GO TO 2-EOJ.
           MOVE SAVE-SUB1 TO SUB1.
014700***************************************************************
014800*    ERROR SWITCH IS SET TO "PZ" IF USER WISHES TO PRINT THE  *
014900*    WORK ORDER AT THE ZONE OR "L" IF THE PRINTS ARE TO GO    *
015000*    TO THE PLANNER'S PRINTER OR ENGINEER'S PRINTER           *
015100***************************************************************
015200 6-MAIN-LOOP.
015300     ADD 1 TO SUB1.
015400     IF SUB1 > 20 OR READ-WO-1-6 (SUB1) = SPACES
               MOVE 0 TO SAVE-SUB1 SUB1
015800         GO TO 6-MAIN.
016300     MOVE "0" TO CONDIT-CODE.
016400     CALL "TALWONO" USING READ-WOS (SUB1) CONDIT-CODE.
017700     IF READ-X = " "
017800         MOVE "NP" TO ERROR-SWITCH
017900         MOVE "L" TO CONDIT-CODE
018000     ELSE
018100     MOVE "PZ" TO ERROR-SWITCH.
           PERFORM 69-START-WO-BASIC-FILE.
           IF COND-WORD = 0
               PERFORM 69-READ-WO-BASIC-FILE
               IF COND-WORD = 0
034000             CALL "TPRTWO" USING DBPARAMETERS WO-BASIC-DATA
034100                     READ-WOS (SUB1) CONDIT-CODE VIEW-COMAREA
                   GO TO 6-MAIN-LOOP.
030700     PERFORM 69-START-WO-PLANNED-FILE.
           IF COND-WORD = 0
032100         PERFORM 69-READ-WO-PLANNED-FILE
032400             IF COND-WORD = 0
033600                 CALL "TPRINTWS" USING DBPARAMETERS
                                             WO-PLANNED-DATA
                                             ERROR-SWITCH
                                             VIEW-COMAREA
                       GO TO 6-MAIN-LOOP.
           MOVE 47004 TO CATREAD-MSG-NUMBER.
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
           MOVE READ-WOS (SUB1) TO ERR-WO.
           MOVE TRUE-VAL TO INDS (SUB1) INDS (99).
           MOVE SUB1 TO SAVE-SUB1.
018300     GO TO 6-MAIN.
018400***************************************************************
018500*    ERROR-SWITCH = PZ INDICATES PLANNED WORK ORDERS ARE TO   *
018600*         PRINT IN THE ZONE LOCATION ON THE WORK ORDER        *
018700*    CONDIT-CODE = SPACE INDICATES THAT VERBAL WORK ORDERS    *
018800*         ARE TO PRINT IN THE ZONE LOCATION OF THE WORK ORDER *
018900*                                                             *
019000*    ERROR-SWITCH = SPACE INDICATES THAT PLANNED WORK ORDERS  *
019100*         ARE TO PRINT AT DESIGNATED PRINTERS                 *
019200*    CONDIT-CODE = L INDICATES THAT VERBAL WORK ORDERS ARE    *
019300*         TO PRINT AT DESIGNATED PRINTERS                     *
019400*                                                             *
019500*    ERROR-SWITCH = NP INDICATES TO TPRINTWS THAT ONLY        *
019600*         THE PLANNED WORK ORDER BODY IS TO BE PRINTED        *
019700*                                                             *
019800***************************************************************
028900 610-SET-YR.
029000     MOVE YEAR-D TO READ-WO-7 (SUB1).

       69-READ-WO-BASIC-FILE.
           MOVE 0 TO COND-WORD.
           READ WO-BASIC-FILE NEXT INTO WO-BASIC-DATA
               AT END    MOVE 17 TO COND-WORD.
           IF WBF-STATUS NOT = "00" MOVE 17 TO COND-WORD.

       69-START-WO-BASIC-FILE.
           MOVE 0 TO COND-WORD.
           MOVE READ-WOS (SUB1) TO WONUM OF WBFREC.
           START WO-BASIC-FILE KEY IS = EXTERNALLY-DESCRIBED-KEY
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF WBF-STATUS NOT = "00" MOVE 17 TO COND-WORD.

       69-READ-WO-PLANNED-FILE.
           MOVE 0 TO COND-WORD.
           READ WO-PLANNED-FILE NEXT INTO WO-PLANNED-DATA
               AT END    MOVE 17 TO COND-WORD.
           IF WPF-STATUS NOT = "00" MOVE 17 TO COND-WORD.

       69-START-WO-PLANNED-FILE.
           MOVE 0 TO COND-WORD.
           MOVE READ-WOS (SUB1) TO WONUM OF WPFREC.
           START WO-PLANNED-FILE KEY IS = EXTERNALLY-DESCRIBED-KEY
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF WPF-STATUS NOT = "00" MOVE 17 TO COND-WORD.

       98-SCREEN-READ.
           READ DISPLAY-FILE FORMAT IS VIEW-CFNAME
               INDIC IS INDICS.
           ACCEPT IOFEEDBACK FROM I-O-FEEDBACK-AREA.
           MOVE ALL B"0" TO INDICS.
           IF DSPLY-STATUS NOT = "00"
               MOVE 3 TO VIEW-LASTKEY
           ELSE
           MOVE FUNCTION-NUM TO VIEW-LASTKEY.

       99-SCREEN-WRITE.
           WRITE DSPLY-REC FORMAT IS VIEW-CFNAME
               INDIC IS INDICS.
           MOVE ALL B"0" TO INDICS.

035400 999-CATREAD.
035500     MOVE SPACES TO ERROR-BUFFER.
           CALL "CCATREAD" USING CATREAD-PARMS.
           MOVE CATREAD-MSG-TEXT TO ERROR-BUFFER.
036400 999-CATREAD-EXIT.
036500     EXIT.
