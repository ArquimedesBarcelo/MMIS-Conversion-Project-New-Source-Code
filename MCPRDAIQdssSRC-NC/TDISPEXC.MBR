000200 IDENTIFICATION DIVISION.
000300 PROGRAM-ID. TDISPEXC.
      *REMARKS.
      *C---------------------------------------------------------------
      *C 08/28/09  CAY REQ 2009-00131261-003
      *C IN ORDER TO HOLD DATA LONGER THAN 10 YEARS, CHANGE THE
      *C BASE METHOD FOR CREATING A WORKORDER.  FOR W/O CREATED IN
      *C 2010, INSTEAD OF USING LETTER "A" AGAIN, USE "L", ETC.
      *C SKIP USING I, O, Q AND U TO AVOID CONFUSION.
      *C---------------------------------------------------------------
000400 ENVIRONMENT DIVISION.
000500 CONFIGURATION SECTION.
000600 SOURCE-COMPUTER. AS400.
000700 OBJECT-COMPUTER. AS400.
       SPECIAL-NAMES. I-O-FEEDBACK IS I-O-FEEDBACK-AREA
                      LOCAL-DATA IS LOCAL-DATA-AREA.
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT DISPLAY-FILE
               ASSIGN TO WORKSTATION-ZDISPLAY-SI
               ORGANIZATION IS TRANSACTION
               ACCESS IS SEQUENTIAL
               FILE STATUS IS DSPLY-STATUS
               CONTROL-AREA IS WS-CONTROL.
           SELECT WO-BASIC-FILE
               ASSIGN TO DATABASE-MCFLMM1001
               ORGANIZATION IS INDEXED
               ACCESS IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
               FILE STATUS IS WBF-STATUS.
           SELECT WO-LAST-NUM-USED
               ASSIGN TO DATABASE-MCFPMM0800
               ORGANIZATION IS RELATIVE
               ACCESS MODE IS RANDOM
               RELATIVE KEY IS ARG-NO
               FILE STATUS IS WLNU-STATUS.
           SELECT WO-PLANNED-FILE
               ASSIGN TO DATABASE-MCFLMM1101
               ORGANIZATION IS INDEXED
               ACCESS IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
               FILE STATUS IS WPF-STATUS.
000800 DATA DIVISION.
       FILE SECTION.
       FD  DISPLAY-FILE
           LABEL RECORDS ARE OMITTED.
       01  DSPLY-REC                         PIC X(2000).
       FD  WO-BASIC-FILE
           LABEL RECORDS ARE STANDARD
           DATA RECORD IS WBFREC.
       01  WBFREC.
           COPY DDS-ALL-FORMATS OF MCFLMM1001.
       FD  WO-LAST-NUM-USED
           LABEL RECORDS ARE STANDARD
           DATA RECORD IS LAST-NUM-USED-REC.
       01  LAST-NUM-USED-REC.
           COPY DDS-ALL-FORMATS OF MCFPMM0800.
       FD  WO-PLANNED-FILE
           LABEL RECORDS ARE STANDARD
           DATA RECORD IS WPFREC.
       01  WPFREC.
           COPY DDS-ALL-FORMATS OF MCFLMM1101.
000900 WORKING-STORAGE SECTION.
       77  WRITE-YEAR-BUF                    PIC X.
       77  SUB1                PIC S9(4) BINARY VALUE ZEROS.
001200 01  ARG-NO                            PIC 9(9).
001300 01  BLOWUP-BASE                       PIC X(16).
       COPY CATREAD OF COPYLIB.
       COPY CPYIND  OF COPYLIB.
002800 01  CHECK-YEAR.
002900**** 05  FILLER                        PIC X.
           05  CHECK-YEAR-NUM2               PIC 9.
003000     05  CHECK-YEAR-NUM                PIC 9.
           05  FILLER                        PIC X(4).
      *---------------------------------------------*
      *--- TASK 2009-00131261-003
      *---------------------------------------------*
      *---   20-YEAR PATTERN
      *--- YEAR        ALPHA
      *    2000-2009   A-K
      *    2010-2019   M-Y
      *    2020-2029   A-K
      *    2030-2039   M-Y
      *    2040-2049   A-K
      *    2050-2059   M-Y
      *---------------------------------------------*
      *--- YEARS THAT USE THE FOLLOWING ALPHA TABLE:
      *--- 2000-2009; 2020-2029; 2040-2049
      *---------------------------------------------*
       01  YEAR-DESIGNATOR.
           05  YEAR-TABLE.
               10  YD-0        PIC X  VALUE "A".
               10  YD-1        PIC X  VALUE "B".
               10  YD-2        PIC X  VALUE "C".
               10  YD-3        PIC X  VALUE "D".
               10  YD-4        PIC X  VALUE "E".
               10  YD-5        PIC X  VALUE "F".
               10  YD-6        PIC X  VALUE "G".
               10  YD-7        PIC X  VALUE "H".
               10  YD-8        PIC X  VALUE "J".
               10  YD-9        PIC X  VALUE "K".
           05  YEAR-COUNTER    REDEFINES YEAR-TABLE.
               10  YEARC       OCCURS 10 TIMES PIC X.

      *---------------------------------------------*
      *--- YEARS THAT USE THE FOLLOWING ALPHA TABLE:
      *--- 2010-2019; 2030-2039; 2050-2059
      *---------------------------------------------*
       01  YEAR-DESIGNATOR2.
           05  YEAR-TABLE2.
               10  YD-0        PIC X  VALUE "M".
               10  YD-1        PIC X  VALUE "N".
               10  YD-2        PIC X  VALUE "P".
               10  YD-3        PIC X  VALUE "R".
               10  YD-4        PIC X  VALUE "S".
               10  YD-5        PIC X  VALUE "T".
               10  YD-6        PIC X  VALUE "V".
               10  YD-7        PIC X  VALUE "W".
               10  YD-8        PIC X  VALUE "X".
               10  YD-9        PIC X  VALUE "Y".

003700 01  DBPARAMETERS.                    COPY DBPARMS OF COPYLIB.
005000 01  ERROR-BUFFER.
003900     05  FILLER                        PIC X(40) VALUE SPACES.
004000     05  WO-1-10                       PIC X(10) VALUE SPACES.
004100     05  FILLER                        PIC X(30) VALUE SPACES.
       01  FILE-STATUSES.
           05  DSPLY-STATUS                  PIC XX.
           05  WLNU-STATUS                   PIC XX.
           05  WBF-STATUS                    PIC XX.
           05  WPF-STATUS                    PIC XX.
       01  INPUT-BUFFER.
001800     05  WO-NUMBER.
001900         10  WO-NUMBER6                PIC X(6).
002000         10  WO-NUMBER7                PIC X.
002100         10  WO-NUM-SUFF               PIC XXX.
           05  INPUT-CMD-LINE                PIC X(79).
002200     05  INPUT-ERR-LINE                PIC X(79).
       COPY IOFEEDBACK IN COPYLIB.
004900 01  LAST-WO-BUFF.                    COPY MLASTWO  IN COPYLIB.
005100 01  PASSWORD-INFORMATION.
005200     05  NAME-OF-PROGRAM     PIC X(08) VALUE "TDISPEXC".
005300     05  PROGRAM-TYPE        PIC X(02) VALUE "RE".
005400     05  PROGRAM-RELEASE     PIC X(12) VALUE " E0100010001".
005500     05  PROGRAM-DESCRIPTION.
005600         10  PROG-DESC-A     PIC X(60) VALUE
005700       " OFFLINE DISPLAY ('D' FUNCTION) EXECUTIVE PROGRAM "      .
005800         10  PROG-DESC-B     PIC X(60) VALUE SPACES.
006000         10  PROG-FUNCTION   PIC X(60) VALUE SPACES.
006200     05  PASSWORD-FLAG       PIC X.
006300 01  RETURN-CODE                       PIC X.
006400 01  RETURN-SW                         PIC X.
006500 COPY DBSTAT     IN COPYLIB.
006600 COPY TBLOWUP    IN COPYLIB.
       01  TRUE-VAL                          PIC 1 VALUE B"1".
006800 COPY VCOMLINK   IN COPYLIB.
006900 01  WO-BASIC-DATA.                   COPY DWOBASIC OF COPYLIB.
009400 01  WO-PLANNED-DATA.                 COPY DWOPLAN  OF COPYLIB.
       COPY WSCONTROL  IN COPYLIB.
010000 PROCEDURE DIVISION.
010100 START-PROCESSING.
010200     PERFORM 1-HSK.
010300     PERFORM 6-MAIN.
010400 2-EOJ.
           CLOSE DISPLAY-FILE.
           CLOSE WO-BASIC-FILE WO-LAST-NUM-USED WO-PLANNED-FILE.
011000     GOBACK.
011100 1-HSK.
011200     MOVE LOW-VALUES TO STATUS-AREA VIEW-COMAREA.
           OPEN I-O   DISPLAY-FILE.
           OPEN INPUT WO-BASIC-FILE WO-LAST-NUM-USED WO-PLANNED-FILE.
011300     ACCEPT CHECK-YEAR FROM DATE.
      *-----------------------------------------------*
      *--- TASK 2009-00131261-003
      *-----------------------------------------------*
           IF CHECK-YEAR-NUM2 = 1 OR 3 OR 5 OR 7 OR 9
             MOVE YEAR-DESIGNATOR2 TO YEAR-DESIGNATOR.
      *-----------------------------------------------*
           MOVE CHECK-YEAR-NUM TO SUB1.
           ADD 1 TO SUB1.
           MOVE YEARC (SUB1)   TO WRITE-YEAR-BUF.
      *------ COMMENT OUT FOR TASK 2009-00131261-003
011400***  IF CHECK-YEAR-NUM = 0
011500***      MOVE "A" TO WRITE-YEAR-BUF
011600***  ELSE
011700***  IF CHECK-YEAR-NUM = 1
011800***      MOVE "B" TO WRITE-YEAR-BUF
011900***  ELSE
012000***  IF CHECK-YEAR-NUM = 2
012100***      MOVE "C" TO WRITE-YEAR-BUF
012200***  ELSE
012300***  IF CHECK-YEAR-NUM = 3
012400***      MOVE "D" TO WRITE-YEAR-BUF
012500***  ELSE
012600***  IF CHECK-YEAR-NUM = 4
012700***      MOVE "E" TO WRITE-YEAR-BUF
012800***  ELSE
012900***  IF CHECK-YEAR-NUM = 5
013000***      MOVE "F" TO WRITE-YEAR-BUF
013100***  ELSE
013200***  IF CHECK-YEAR-NUM = 6
013300***      MOVE "G" TO WRITE-YEAR-BUF
013400***  ELSE
013500***  IF CHECK-YEAR-NUM = 7
013600***      MOVE "H" TO WRITE-YEAR-BUF
013700***  ELSE
013800***  IF CHECK-YEAR-NUM = 8
013900***      MOVE "J" TO WRITE-YEAR-BUF
014000***  ELSE
014100***  IF CHECK-YEAR-NUM = 9
      ***      MOVE "K" TO WRITE-YEAR-BUF.
      *-----------------------------------------------*
           MOVE 0 TO COND-WORD.
           MOVE 1 TO ARG-NO.
018400     READ WO-LAST-NUM-USED INTO LAST-WO-BUFF
018500         INVALID KEY    MOVE 17 TO COND-WORD.
           IF WLNU-STATUS NOT = "00" MOVE 17 TO COND-WORD.
           IF COND-WORD = 17 GO TO 2-EOJ.
018600     MOVE DATE-FLAG-SW TO DATE-FLAG.
019000     CALL "TPWORD" USING PASSWORD-INFORMATION.
019400     IF PASSWORD-FLAG = "N"
019500         MOVE "  PWORD" TO BLOWUP-BASE
019600         MOVE "FAILED PASSWORD CHECK - TDISPEXC"
019700             TO BU-DISPLAY-MSG
019800         PERFORM 998-BLOWUP.
           MOVE 0 TO VIEW-LASTKEY.
023500 6-MAIN.
           MOVE SPACES TO ERROR-BUFFER INPUT-BUFFER.
023600     PERFORM 621-WRITE-SCREEN THRU 621-WS-EXIT.
024200     IF VIEW-LASTKEY = 2 GO TO 6-MAIN.
024300*
024400*    PUT UP SCREEN
024500*
024600 621-WRITE-SCREEN.
013200     MOVE "FDISPWON" TO VIEW-CFNAME.
           IF ERROR-BUFFER = SPACES
               MOVE SPACES TO INPUT-BUFFER
               MOVE 49059 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE WRITE-YEAR-BUF TO WO-NUMBER7
               MOVE ERROR-BUFFER TO INPUT-CMD-LINE
               MOVE SPACES TO ERROR-BUFFER
               MOVE INPUT-BUFFER TO DSPLY-REC
           ELSE
014500*    MOVE WRITE-YEAR-BUF TO WO-NUMBER7
           MOVE ERROR-BUFFER TO INPUT-ERR-LINE
           MOVE INPUT-BUFFER TO DSPLY-REC.
           PERFORM 99-SCREEN-WRITE.
           PERFORM 98-SCREEN-READ.
           MOVE DSPLY-REC TO INPUT-BUFFER.
           IF VIEW-LASTKEY = 3
016700         GO TO 2-EOJ
016800     ELSE
016900     IF VIEW-LASTKEY = 1 OR 2
017100         MOVE 35126 TO CATREAD-MSG-NUMBER
017300         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE TRUE-VAL TO INDS (99)
               GO TO 621-WRITE-SCREEN.
018400*
018500*    ALIGN WORK ORDER NUMBER
018600*
018700     CALL "TALWONO" USING WO-NUMBER RETURN-CODE.
018800     IF RETURN-CODE = "1"
018900         MOVE "0" TO RETURN-CODE
019100         MOVE 47004 TO CATREAD-MSG-NUMBER
019300         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
019500         MOVE WO-NUMBER TO WO-1-10
               MOVE TRUE-VAL TO INDS (1) INDS (99)
019900         GO TO 621-WRITE-SCREEN.
           MOVE 0 TO COND-WORD.
           MOVE WO-NUMBER TO WONUM OF WBFREC.
           START WO-BASIC-FILE KEY IS = EXTERNALLY-DESCRIBED-KEY
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF WBF-STATUS NOT = "00" MOVE 17 TO COND-WORD.
           IF COND-WORD = 17 GO TO 621-WS-CONT.
           READ WO-BASIC-FILE INTO WO-BASIC-DATA
               INVALID KEY    MOVE 15 TO COND-WORD.
           IF WO-NUMBER NOT = WONUM OF WBFREC MOVE 15 TO COND-WORD.
           IF WBF-STATUS NOT = "00" MOVE 15 TO COND-WORD.
           IF COND-WORD = 15
               MOVE 49002 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE TRUE-VAL TO INDS (1) INDS (99)
               GO TO 621-WRITE-SCREEN.
           CALL "CLDISPBA" USING DBPARAMETERS WO-BASIC-DATA
                             VIEW-COMAREA.
           GO TO 621-WS-EXIT.
       621-WS-CONT.
           MOVE 0 TO COND-WORD.
           MOVE WO-NUMBER TO WONUM OF WPFREC.
           START WO-PLANNED-FILE KEY IS = EXTERNALLY-DESCRIBED-KEY
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF WPF-STATUS NOT = "00" MOVE 17 TO COND-WORD.
           IF COND-WORD = 17
               MOVE 49002 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE TRUE-VAL TO INDS (98)
               MOVE ERROR-BUFFER TO INPUT-CMD-LINE
               MOVE INPUT-BUFFER TO DSPLY-REC
               PERFORM 99-SCREEN-WRITE
               PERFORM 98A-SCREEN-READ
               CALL "CLPAUSE2"
               GO TO 6-MAIN.
           READ WO-PLANNED-FILE INTO WO-PLANNED-DATA
               INVALID KEY    MOVE 15 TO COND-WORD.
           IF WO-NUMBER NOT = WONUM OF WPFREC MOVE 15 TO COND-WORD.
           IF WPF-STATUS NOT = "00" MOVE 15 TO COND-WORD.
           IF COND-WORD = 15
               MOVE 49002 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE TRUE-VAL TO INDS (1) INDS (99)
               GO TO 621-WRITE-SCREEN.
           CALL "CLDISPPL" USING DBPARAMETERS WO-PLANNED-DATA
                             VIEW-COMAREA.
       621-WS-EXIT.    EXIT.
040000
       98-SCREEN-READ.
           READ DISPLAY-FILE FORMAT IS VIEW-CFNAME
               INDIC IS INDICS.
           ACCEPT IOFEEDBACK FROM I-O-FEEDBACK-AREA.
           MOVE ALL B"0" TO INDICS.
           IF DSPLY-STATUS NOT = "00"
               MOVE 3 TO VIEW-LASTKEY
           ELSE
           MOVE FUNCTION-NUM TO VIEW-LASTKEY.

       98A-SCREEN-READ.
           READ DISPLAY-FILE TERMINAL IS TERMINAL-ID
               INDIC IS INDICS
                  NO DATA MOVE DSPLY-STATUS TO DSPLY-STATUS.
           MOVE ALL B"0" TO INDICS.

       99-SCREEN-WRITE.
           WRITE DSPLY-REC FORMAT IS VIEW-CFNAME
               INDIC IS INDICS.
           MOVE ALL B"0" TO INDICS.

040100 998-BLOWUP.
040200     MOVE "TDISPEXC" TO BU-PGM-NAME.
040300     CALL "TBLOWUP" USING BLOWUP-BASE BU-PGM-NAME STATUS-AREA
040400                      VIEW-COMAREA DUMMY-KSAM-STAT
040500                      BU-DISPLAY-MSG BU-DISPLAY-FLDS.
040600
040700 999-CATREAD.
040800     MOVE SPACES TO ERROR-BUFFER.
           CALL "CCATREAD" USING CATREAD-PARMS.
           MOVE CATREAD-MSG-TEXT TO ERROR-BUFFER.
042300 999-CATREAD-EXIT.    EXIT.
