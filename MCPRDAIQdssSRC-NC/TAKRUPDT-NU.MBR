      *  THE FOLLOWING ARE THE HOLD  AREAS FOR RAW MATERIALS       *
      *     THE MASTER FIELDS ARE THE ONES USED IN BUILDING        *
      *     THE TRANSACTIONS PASSED TO ACCOUNTING.                 *
      *                                                            *
      **************************************************************

       01  RAWMAT-HLD-FLDS.
           05  HOLD-CHARGE-DEPT          PIC X(6)   VALUE SPACES.
           05  HOLD-REQ-DEPT             PIC X(4)   VALUE SPACES.
           05  HOLD-EXP-CLASS            PIC X(6)   VALUE SPACES.
           05  HOLD-RM-EXP-OVERRIDE      PIC X(1).
           05  FILLER                    PIC X(43).

      *------ STR DEFAULT DEPT WILL BE USED IF THE PLANT STARTUP DEPT
      *------ (ABOVE), IS BLANK.
       01  ACTUAL-CHARGE-DEPT            PIC X(6)  VALUE SPACES.
       01  ACTUAL-REQ-DEPT               PIC X(4)  VALUE SPACES.
       01  ACTUAL-EXP-CLASS              PIC X(6)  VALUE SPACES.

      **************************************************************
      *                                                            *
      *  THE FOLLOWING ARE THE PRINT AREAS FOR RAW MATERIALS       *
      *     THESE ARE FOR THE ERROR SITUATIONS ONLY.               *
      *     THE ERROR DATA IS PRINTED AS THE PROGRAM RUNS.         *
      *                                                            *
      **************************************************************

       01  ERROR-HEAD1.
           05  FILLER                  PIC X(45)  VALUE SPACES.
           05  FILLER                  PIC X(36)
                VALUE "RAW MATERIAL ERROR REPORT - TAKRUPDT".
           05  FILLER                  PIC X(51)  VALUE SPACES.

       01  ERROR-HEAD2.
           05  FILLER  PIC X(6)  VALUE "PLT   ".
           05  FILLER  PIC X(14) VALUE "CORP-CODE     ".
           05  FILLER  PIC X(14) VALUE "ADJECTIVE     ".
           05  FILLER  PIC X(9)  VALUE "ISSUE QTY".
           05  FILLER  PIC X(20) VALUE SPACES.

       01  ERROR-UNDERLINE             PIC X(132) VALUE ALL "-".

       01  FORMAT-CHEM-PRT-DATA.
           05  FC-PLT                  PIC X(3).
           05  FILLER                  PIC XXX.
           05  FC-CORPCODE             PIC X(7).
           05  FILLER                  PIC X(7).
           05  FC-ADJ                  PIC X(10).
           05  FILLER                  PIC X(4).
           05  FC-QTY-ISSUED           PIC Z(7)9.
           05  FILLER                  PIC X(21).

      **************************************************************
      *                                                            *
      *  THE FOLLOWING ARE THE PRINT AREAS FOR RAW MATERIALS       *
      *     THESE ARE FOR THE WITHDRAWALS THAT HAVE TAKEN PLACE.   *
      *     THIS DATA IS SENT TO A HOLD-PRT THEN AT THE END OF     *
      *     THE PROCESSING BROUGHT BACK FOR PRINTING THRU SPOOLER. *
      *                                                            *
      **************************************************************

       01  RM-HEAD1.
           05  FILLER                  PIC X(8)   VALUE "TAKRUPDT".
           05  FILLER                  PIC X(5)   VALUE SPACES.
           05  FILLER                  PIC X(5)   VALUE "PAGE ".
           05  RM-PAGE-CNT             PIC ZZ9.
           05  FILLER                  PIC X(30)  VALUE SPACES.
           05  FILLER                  PIC X(31)
                VALUE "RAW MATERIALS ISSUED VIA ASPICS".
           05  FILLER                  PIC X(10)  VALUE SPACES.
           05  FILLER                  PIC X(9)   VALUE "RUN DATE ".
           05  RM-CUR-DATE             PIC X(8).
           05  FILLER                  PIC X      VALUE SPACES.
           05  RM-CUR-TIME.
               10  RM-HH               PIC X(2).
               10  FILLER              PIC X      VALUE ":".
               10  RM-MM               PIC X(2).
               10  FILLER              PIC X      VALUE ":".
               10  RM-SS               PIC X(2).

       01  RM-HEAD2.
           05  FILLER                  PIC X(54)  VALUE SPACES.
           05  FILLER                  PIC X(17)
                VALUE "PRODUCTION DATE  ".
           05  RM-MONTH                PIC X(2)   VALUE SPACES.
           05  FILLER                  PIC X      VALUE "-".
           05  RM-DAY                  PIC X(2)   VALUE SPACES.
           05  FILLER                  PIC X      VALUE "-".
           05  RM-YEAR                 PIC X(2)   VALUE SPACES.
           05  FILLER                  PIC X(62)  VALUE SPACES.

       01  RM-HEAD3.
           05  FILLER                  PIC X(50)  VALUE SPACES.
           05  FILLER                  PIC X(25)
                VALUE "UNIT OF          QUANTITY".
           05  FILLER                  PIC X(24)  VALUE SPACES.

       01  RM-HEAD4.
           05  FILLER  PIC X(20)  VALUE SPACES.
           05  FILLER  PIC X(14) VALUE "CORP-CODE     ".
           05  FILLER  PIC X(16) VALUE "ADJECTIVE     ".
           05  FILLER  PIC X(7)  VALUE "MEASURE".
           05  FILLER  PIC X(10) VALUE SPACES.
           05  FILLER  PIC X(6)  VALUE "ISSUED".
           05  FILLER  PIC X(59)  VALUE SPACES.

       01  RM-HEAD5.
           05  FILLER                  PIC X(20)  VALUE SPACES.
           05  FILLER                  PIC X(9)   VALUE ALL "-".
           05  FILLER                  PIC X(5)   VALUE SPACES.
           05  FILLER                  PIC X(10)  VALUE ALL "-".
           05  FILLER                  PIC X(6)   VALUE SPACES.
           05  FILLER                  PIC X(7)   VALUE ALL "-".
           05  FILLER                  PIC X(10)  VALUE SPACES.
           05  FILLER                  PIC X(8)   VALUE ALL "-".
           05  FILLER                  PIC X(57)  VALUE SPACES.

       01  RM-PRINT-LINE.
           05  FILLER                  PIC X(20)  VALUE SPACES.
           05  RM-PRT-CORPCODE         PIC XXBXXBXXX.
           05  FILLER                  PIC X(5)   VALUE SPACES.
           05  RM-PRT-ADJ              PIC X(10)   VALUE SPACES.
           05  FILLER                  PIC X(6)   VALUE SPACES.
           05  RM-PRT-STR-UM           PIC X(2).
           05  FILLER                  PIC X(14)  VALUE SPACES.
           05  RM-PRT-QTY-ISSUED       PIC --------9.
           05  FILLER                  PIC X(10)  VALUE SPACES.
           05  RM-PRT-TEST-INDIC       PIC X(8)   VALUE SPACES.
           05  FILLER                  PIC X(39)  VALUE SPACES.

       01  SAVE-CHEM-PRODDTE.
           05  SAVE-CP-MM              PIC X(2)    VALUE SPACE.
           05  FILLER                  PIC X       VALUE "-".
           05  SAVE-CP-DD              PIC X(2)    VALUE SPACE.
           05  FILLER                  PIC X       VALUE "-".
           05  SAVE-CP-YY              PIC X(2)    VALUE SPACE.

      **************************************************************
      **   THE FOLLOWING ARE PRINT AREAS FOR THE ADD OF           **
      **   INTERNATIONAL REQUISITIONS TO THE DATABASE             **
      **************************************************************

       01  REQ-RPT-HD1.
           05  FILLER          PIC X(4)  VALUE "PAGE".
           05  PRT-REQ-PAGE    PIC ZZZ9.
           05  FILLER          PIC X(10) VALUE SPACES.
           05  FILLER          PIC X(12) VALUE "I N T E R N ".
           05  FILLER          PIC X(16) VALUE "A T I O N A L   ".
           05  FILLER          PIC X(21) VALUE "R E Q U I S I T I O N".
           05  FILLER          PIC X(16) VALUE "   U P D A T E S".
           05  FILLER          PIC X(10) VALUE SPACES.
           05  FILLER          PIC X(5)  VALUE "DATE ".
           05  PRT-REQ-DT-HD   PIC X(8).
           05  FILLER          PIC X(2)  VALUE SPACES.
           05  PRT-REQ-TM-HD   PIC X(8).

       01  REQ-RPT-HD2.
           05  FILLER          PIC X(17) VALUE SPACES.
           05  FILLER          PIC X(10) VALUE "REQ NUMBER".
           05  FILLER          PIC X(7)  VALUE SPACES.
           05  FILLER          PIC X(8)  VALUE "REQ DATE".

       01  PRT-REQ-DETAIL.
           05  FILLER                    PIC X(17) VALUE SPACES.
           05  PRT-REQ                   PIC X(8).
           05  FILLER                    PIC X(9)  VALUE SPACES.
           05  PRT-REQ-DATE              PIC X(8).
           05  FILLER                    PIC X(4)  VALUE SPACES.
           05  PRT-REQ-MSG               PIC X(50).
           05  FILLER                    PIC X(4)  VALUE SPACES.
           05  PRT-REQ-ERROR             PIC ZZZZZ.

       01  REQ-ERROR-RCD.
           05  REQ-ERROR-DATE            PIC X(6).
           05  FILLER                    PIC X(1)  VALUE SPACES.
           05  REQ-ERROR-TIME            PIC X(6).
           05  FILLER                    PIC X(1)  VALUE SPACES.
           05  REQ-ERROR-REQ             PIC X(12).
           05  FILLER                    PIC X(1)  VALUE SPACES.
           05  REQ-ERROR-REQ-DATE        PIC X(6).
           05  FILLER                    PIC X(1)  VALUE SPACES.
           05  REQ-ERROR-CODE            PIC S9(4).
           05  REQ-ERROR-MSG             PIC X(42).

      **************************************************************
      **                                                          **
      **               K S A M   W O R K                          **
      **                                                          **
      **************************************************************

       01  FILENUMBER                   PIC S9(4) COMP VALUE 0.
       01  KEY-VALUE                    PIC X(8)  VALUE SPACES.

       01  USAGE-REC.
           05  FILLER                   PIC XX.
           05  K-CORP-CODE              PIC X(8).
           05  K-MONTHS                 OCCURS 14 TIMES.
               10  K-MTH-USAGE          PIC S9(9) COMP-4.
           05  K-MONTHS-DD              OCCURS 14 TIMES.
               10  K-MTH-USAGE-DD       PIC S9(9) COMP-4.

       01  RECEIPT-REC.
           05  R-CORP-CODE              PIC X(8).
           05  R-MONTHS                 OCCURS 14 TIMES.
               10  R-MTH-RECEIPTS       PIC S9(9) COMP-4.

       01  HP-CUR-DATE.
           05  HP-MM                   PIC XX.
           05  FILLER                  PIC X.
           05  HP-DD                   PIC XX.
           05  FILLER                  PIC X.
           05  HP-YY                   PIC XX.

       01  YMD-DATE.
           05  YY.
               10  YR-1                PIC X.
               10  YR-2                PIC X.
           05  MM                      PIC XX.
           05  DD                      PIC XX.





       PROCEDURE DIVISION.
       LOAD-PROCEDURE.
           MOVE "C" TO MCXCBLERR-SCOPE.
           CALL "MCXCBLERR" USING MCXCBLERR-SCOPE.
           MOVE "N" TO HOLD-PRINT-EOF-SW, RAW-BATCH-FILES-OPEN-SW,
             DELETE-ALTKEY-SW, VENDOR-EXISTS-FLAG, BACKOUT-FLAG,
             REQ-RPT-FILE-OPEN-SW, MAN-FOUND-FLAG,
             DCODE-EXISTS-FLAG, BANBURY-EXPLOSION-FLAG, ADD-VEN-09.
           MOVE ZERO TO PAGE-CTR, LINE-CTR, LINE-ADV,
             REQ-RPT-LINE-COUNT, REQ-RPT-PAGE-COUNT.
           MOVE "Y" TO FIRST-CALL.
           OPEN I-O MKEYADJ-O, MMANUFACT-O, MSTORERM-O,
             MVALIDPLTDATA-O, MREQ-O, DCODE-C-O,
             DMANPART-C-O, DDESC-O, DDESC2-O, DDAILYTC-O,
             DVENDOR-O, DREQITM-O, DREQD-O, USAGEFIL-O
             RECEIPTFIL-O.
           OPEN INPUT MPLTINFO-I, DCODE-K-I, DMANPART-M-I, DDESC-I.
           PERFORM 1-HSK.
           PERFORM 6-MAIN THRU 6-MAIN-X.
           PERFORM 2-EOJ.
           CLOSE MPLTINFO-I, MKEYADJ-O, MMANUFACT-O, MSTORERM-O,
             MVALIDPLTDATA-O, MREQ-O, DCODE-K-I, DCODE-C-O,
             DMANPART-M-I, DMANPART-C-O, DDESC-O, DDESC2-O,
             DDAILYTC-O, DVENDOR-O, DDESC-I, DREQITM-O,
             DREQD-O, USAGEFIL-O RECEIPTFIL-O.
           GOBACK.

       1-HSK.
           DISPLAY "NOTE: IF JCW 'AKBACKOUT' IS SET TO 99,".
           DISPLAY "RAW BATCH TRANSACTIONS CAN BE BACKED OUT".
           MOVE "1-H"                    TO   BU-DISPLAY-FLD (5).
           OPEN INPUT AKRON-FILE.
           IF FILE-STATUS NOT = "00"
               MOVE "OPEN FAIL OF AKRON-FILE" TO BU-DISPLAY-MSG
               PERFORM 2-BLOWUP.
           OPEN OUTPUT PRINT-FILE.
           OPEN I-O KVENDOR-FILE.

      *---------- THE AKRON UPDATE ERROR FILE IS A CIRCULAR FILE WHICH
      *---------- CONTAINS ERROR MESSAGES.  IT WAS CREATED INITIALLY
      *---------- FOR ONLY THE 88 TRANSACTION (ADD INTERNATIONAL
      *---------- REQS).  IT IS OPENED HERE, HOWEVER, SO THAT IN THE
      *---------- FUTURE OTHER TRANSACTIONS CAN WRITE THEIR ERRORS
      *---------- TO THIS CIRCULAR FILE.
      *------ NOTE: IBM DOESN'T HAVE CIRCULAR FILES THAT I KNOW OF
           MOVE "*LIBL"       TO CCRTFILE-LIBRARY.
           MOVE "DAKRERR"     TO CCRTFILE-FILE.
           MOVE "0133"        TO CCRTFILE-RECORD-LENGTH.
           MOVE "01000"       TO CCRTFILE-NO-RECORDS.
           MOVE "01000"       TO CCRTFILE-INCREMENT-AMT.
           MOVE 99            TO CCRTFILE-NO-INCREMENTS.
           CALL "CCRTFILE" USING CCRTFILE-LIBRARY,
                                 CCRTFILE-FILE,
                                 CCRTFILE-RECORD-LENGTH,
                                 CCRTFILE-NO-RECORDS,
                                 CCRTFILE-INCREMENT-AMT,
                                 CCRTFILE-NO-INCREMENTS,
                                 CCRTFILE-STATUS.
           IF CCRTFILE-STATUS NOT = "00"
               MOVE "CCRTFILE CREATE OF 'DAKRERR' FAILED"
                  TO BU-DISPLAY-MSG
               PERFORM 2-BLOWUP.

           OPEN EXTEND AKRUPDT-ERROR-FILE.

           ACCEPT YMD-DATE FROM DATE.
           MOVE YY TO HP-YY.
           MOVE MM TO HP-MM.
           MOVE DD TO HP-DD.
           MOVE HP-CUR-DATE TO RM-CUR-DATE.
           ACCEPT TIME-SAVE FROM TIME.
                   MOVE HH    TO  RM-HH.
                   MOVE MIN   TO  RM-MM.
                   MOVE SEC   TO  RM-SS.
           MOVE SPACES        TO  AKRON-WS-RCD.
           MOVE "    AKRON RJE ERROR REPORT  " TO PRINT-RCD.
           PERFORM 49-PRT-LINE.
           MOVE SPACES  TO  PRINT-RCD.
           MOVE 2  TO  LINE-ADV.
           PERFORM 49-PRT-LINE.

           MOVE "P 01"  TO  PLT-ARG.

      *    CALL "DBGET" USING BASE, DSET-MPLTINFO, MODE7, STATUS-AREA,
      *      ALL-ITEMS, BUF-MPLTINFO, PLT-ARG.
           MOVE PLT-ARG TO PLTINFOKEY OF MPLTINFO-REC-I.
           READ MPLTINFO-I INTO BUF-MPLTINFO
               INVALID KEY MOVE 17 TO COND-WORD.
           IF FILE-STATUS NOT = "00"
               MOVE "DBGET MPLTINFO 1-HSK" TO BU-DISPLAY-MSG
               PERFORM 2-BLOWUP.

           MOVE MPLTINFO-COMPANY         TO  SAVE-COMPANY.

           MOVE "PLAN"                   TO  PLT-ARG.
      *    CALL "DBGET" USING BASE, DSET-MPLTINFO, MODE7, STATUS-AREA,
      *      ALL-ITEMS, BUF-MPLTINFO, PLT-ARG.
           MOVE PLT-ARG TO PLTINFOKEY OF MPLTINFO-REC-I.
           READ MPLTINFO-I INTO BUF-MPLTINFO
               INVALID KEY MOVE 17 TO COND-WORD.
           IF FILE-STATUS NOT = "00"
               MOVE "DBGET ERR PLAN 1-HSK" TO BU-DISPLAY-MSG
               PERFORM 2-BLOWUP.

           MOVE PRIMARY-LANGUAGE         TO   SAVE-PRIM-LANG.

      *------ DETERMINE IF CORPORATE CODE DELETES ARE ALLOWED AT THIS
      *------ PLANT.  NORMALLY ONLY ALLOWED AT KELLY PLANTS, SINCE ALL
      *------ OTHER PLANTS DO DELETES ON HP FROM MATCONT MENU
      *------ AT KELLY THE DELETES ORIGINATE IN THE "PRAPS" SYSTEM AND
      *------ ARE PASSED TO THE HP VIA RJE TO THIS PROGRAM.
           MOVE "CDDL"                   TO  PLT-ARG.
      *    CALL "DBGET" USING BASE, DSET-MPLTINFO, MODE7, STATUS-AREA,
      *      ALL-ITEMS, BUF-MPLTINFO, PLT-ARG.
           MOVE PLT-ARG TO PLTINFOKEY OF MPLTINFO-REC-I.
           READ MPLTINFO-I INTO BUF-MPLTINFO
               INVALID KEY MOVE 17 TO COND-WORD.
           IF FILE-STATUS = "23"
               MOVE "N"                  TO   DELETE-ALLOW-FLAG
           ELSE
           IF FILE-STATUS = "00"
               MOVE "Y"                  TO   DELETE-ALLOW-FLAG
           ELSE
               MOVE "DBGET ERR CDDL 1-HSK" TO BU-DISPLAY-MSG
               PERFORM 2-BLOWUP.

      *------ CHECK TRANSACTION 50 RAW BATCH BACKOUT FLAG: LETS YOU
      *------ REVERSE OUT A RAW BATCH FILE.
      *------ NOTE: THE BACK OUT OPTION WILL NOT BE SUPPORTED ON IBM
      *------ BECAUSE ASPICS NOW HAS THE ABILITY TO BACK OUT A
      *------ PRODUCTION EXPLOSION AND SEND NEGATIVES.
           MOVE "N"                  TO  BACKOUT-FLAG.

      *--- CHECK TO SEE IF WE SHOULD USE THE NUMBER OF DAYS IN
      *--- MPLTINFO FOR ESTIMATED LEAD TIME.
           MOVE "POPT"                   TO  PLT-ARG.
           MOVE PLT-ARG TO PLTINFOKEY OF MPLTINFO-REC-I.
           READ MPLTINFO-I INTO BUF-MPLTINFO
               INVALID KEY MOVE 17 TO COND-WORD.
           IF FILE-STATUS NOT = "00"
               MOVE ZERO TO SHIP-DAYS
           ELSE
               IF    MPLTINFO-SHIP-DAYS-SW = "Y" AND
                     MPLTINFO-SHIP-DAYS NUMERIC
                   MOVE MPLTINFO-SHIP-DAYS-9  TO  SHIP-DAYS
               ELSE
                   MOVE ZERO                  TO  SHIP-DAYS
               END-IF
           END-IF.

      *--- CHECK TO SEE IF THE STR-AUTH-FLAG SHOULD BE SET IN
      *--- AN SAP PLANT.
           MOVE "SAP "                   TO  PLT-ARG.
           MOVE PLT-ARG TO PLTINFOKEY OF MPLTINFO-REC-I.
           READ MPLTINFO-I INTO BUF-MPLTINFO
               INVALID KEY MOVE 17 TO COND-WORD.
           IF FILE-STATUS = "00"
               MOVE MPLTINFO-SAP-SET-AUTH-FLAG TO SAP-AUTH-FLAG.

      *--- CHECK TO SEE IF THIS PLANT IS RUNNING SAP R3
           MOVE "PREQ"                   TO  PLT-ARG.
           MOVE PLT-ARG TO PLTINFOKEY OF MPLTINFO-REC-I.
           READ MPLTINFO-I INTO BUF-MPLTINFO
               INVALID KEY MOVE 17 TO COND-WORD.
           IF FILE-STATUS = "00"
               MOVE MPLTINFO-REQ-SYNR3-SW      TO SAP-R3-SW.


       2-BLOWUP.
           MOVE "TAKRUPDT"               TO  BU-PGM-NAME.
           MOVE CODE-ARG                 TO  BU-DISPLAY-FLD (1).
           CALL "TBLOWUP" USING BASE, BU-PGM-NAME, STATUS-AREA,
             DUMMY-VIEW-AREA, FILE-STATUS, BU-DISPLAY-MSG,
             BU-DISPLAY-FLDS.

       2-EOJ.
           MOVE "2-E"                    TO   BU-DISPLAY-FLD (5).
           MOVE TOTAL-HEADERS  TO  PRINT-RCD.
           PERFORM 49-PRT-LINE.
           CLOSE AKRON-FILE.
           CLOSE PRINT-FILE.
           CLOSE AKRUPDT-ERROR-FILE.
           CLOSE KVENDOR-FILE.
           IF RAW-BATCH-FILES-OPEN-SW = "Y"
               CLOSE  RAW-BATCH-ERRORS,
                      RAW-BATCH-REPORT
               MOVE "Y"  TO  SETJCW-VALUE
           ELSE
               MOVE "N"  TO  SETJCW-VALUE.

           MOVE 283          TO SETJCW-STARTING-POS.
           MOVE 1            TO SETJCW-LENGTH.
           CALL "SETJCW" USING SETJCW-VALUE,
                               SETJCW-STARTING-POS,
                               SETJCW-LENGTH,
                               SETJCW-STATUS.
           IF SETJCW-STATUS NOT = "00"
              MOVE "SETJCW ERROR RAWBATCH     " TO BU-DISPLAY-MSG
              PERFORM 2-BLOWUP.

           IF REQ-RPT-FILE-OPEN-SW = "Y"
               CLOSE REQ-REPORT-FILE
               MOVE "Y" TO SETJCW-VALUE
           ELSE
               MOVE "N" TO SETJCW-VALUE.
           MOVE 284          TO SETJCW-STARTING-POS.
           MOVE 1            TO SETJCW-LENGTH.
           CALL "SETJCW" USING SETJCW-VALUE,
                               SETJCW-STARTING-POS,
                               SETJCW-LENGTH,
                               SETJCW-STATUS.
           IF SETJCW-STATUS NOT = "00"
              MOVE "SETJCW ERROR REQRPT       " TO BU-DISPLAY-MSG
              PERFORM 2-BLOWUP.

       49-PRT-LINE.
           WRITE PRINT-RCD BEFORE ADVANCING LINE-ADV LINES.


       5-OPEN-RAW-BATCH-REPORT-FILES.
           OPEN OUTPUT RAW-BATCH-ERRORS,
                       RAW-BATCH-REPORT.
           MOVE "Y"          TO  RAW-BATCH-FILES-OPEN-SW.

      *------ DETERMINE IF THIS PLANT IS LIVE ON BANBURY EXPLOSION
      *------ PROCESSING. IF SO GET THE CHARGE DEPT, REQ DEPT, AND
      *------ EXP CLASSS FOR USE ON THE TRANSACTIONS.  THIS INFO IS
      *------ UPDATED THRU PLANT STARTUP.
           MOVE "BNEX"                   TO  PLT-ARG.
      *    CALL "DBGET" USING BASE, DSET-MPLTINFO, MODE7, STATUS-AREA,
      *      ALL-ITEMS, BUF-MPLTINFO, PLT-ARG.
           MOVE PLT-ARG TO PLTINFOKEY OF MPLTINFO-REC-I.
           READ MPLTINFO-I INTO BUF-MPLTINFO
               INVALID KEY MOVE 17 TO COND-WORD.
           IF FILE-STATUS = "23"
               MOVE "N"                  TO   BANBURY-EXPLOSION-FLAG
           ELSE
           IF FILE-STATUS = "00"
               MOVE "Y"                  TO   BANBURY-EXPLOSION-FLAG
               MOVE MPLTINFO-BNEX        TO   RAWMAT-HLD-FLDS
           ELSE
               MOVE "DBGET ERR BNEX 1-HSK" TO BU-DISPLAY-MSG
               PERFORM 2-BLOWUP.

       5100-OPEN-INVCK-RPT-FILE.
           MOVE "OVRDBF FILE(DRPTICHK) SHARE(*YES)"
             TO COMMAND-WORK.
           CALL "QCMDEXC" USING COMMAND-WORK, COMMAND-LEN.
           OPEN EXTEND INVCK-RPT-FILE.
           MOVE "Y" TO INVCK-RPT-OPEN.

       6-MAIN.
           MOVE "6-M"                    TO   BU-DISPLAY-FLD (5).

      **************************************************************
      **   THIS IS THE LIST OF TRANSACTIONS USED BY AKRON UPDATE: **
      **                                                          **
      **        10 - DELETE CORPORATE CODE (KELLY ONLY)           **
      **        20 - ADD CORPORATE CODE                           **
      **        30 - CHANGE DESCRIPTION FOR CORPORATE CODE        **
      **        40 - UPDATE AVERAGE COST, STD COST, MTHLY FCAST   **
      **        50 - UPDATE CHEMICAL ONHAND                       **
      **        60 - UPDATE INVOICE CHECK NUMBER                  **
      **        70 - ADD VENDOR                                   **
      **        71 - DELETE VENDOR                                **
      **        72 - CHANGE VENDOR ADDRESS                        **
      **        80 - DELETE ACCOUNTING DATA                       **
      **        81 - ADD ACCOUNTING DATA                          **
      **        88 - ADD INTERNATIONAL REQUISITION                **
      **        99 - UPDATE ONHAND QUANTITIES                     **
      **                                                          **
      **************************************************************

           READ AKRON-FILE
               AT END GO TO 6-MAIN-X.
           IF FILE-STATUS NOT = "00"
               MOVE "READ ERROR OF AKRON FILE" TO BU-DISPLAY-MSG
               PERFORM 2-BLOWUP.
DP23J0*
DP23J0*------ FOR PLANTS WHICH RECEIVE THEIR DATA VIA FTP INSTEAD OF
DP23J0*------ VIA RJE, THERE IS NO CARRIDGE CONTROL CHARACTER.
DP23J0*------ THEREFORE, WE NEED TO MOVE THE AKRON-FD-RECORD TO
DP23J0*------ AKRON-WS-DATA INSTEAD OF AKRON-WS-RCD.
DP23J0*
DP23J0     IF SAVE-COMPANY = "644"
DP23J0                    OR "690"
DP23J0                    OR "691"
DP23J0                    OR "693"
BG1155                    OR "364"
BG1155                    OR "664"
DP23J0         MOVE SPACES              TO HASP-CONTROL-BYTE
DP23J0         MOVE AKRON-FD-RECORD     TO AKRON-WS-DATA
DP23J0     ELSE
DP23J0         MOVE AKRON-FD-RECORD     TO AKRON-WS-RCD.
DP23J0*
DP23J0*****MOVE AKRON-FD-RECORD  TO  AKRON-WS-RCD.
DP23J0*
           IF WS-TC  = SPACES  AND
              WS-PLT = SPACES
               GO TO 6-MAIN.
           IF WS-TC = 70 OR 71 OR 72
               IF WS-VEN-PAY = SPACES
                   MOVE "000" TO WS-VEN-PAY.

           IF BACKOUT-FLAG = "Y"
               IF WS-TC NOT = "50"
                   GO TO 6-MAIN.

           IF WS-TC = "50" AND R3-PLANT
               GO TO 6-MAIN.

           IF WS-TC = "90" OR "80" OR "81" OR "88" OR "60"
               NEXT SENTENCE
           ELSE
           IF WS-TC = "50" AND WS-CP-LIT = "PRODDTE"
               NEXT SENTENCE
           ELSE
           IF WS-TC = 70 OR 71 OR 72
DP17A9*********IF WS-VEN-CODE NOT NUMERIC
DP17A9*********    ADD 1 TO RCD-CTR
DP17A9*********    MOVE AKRON-WS-DATA                 TO PRT-DATA
DP17A9*********    MOVE "  **VEN-CODE NOT NUMERIC** " TO PRT-MSG
DP17A9*********    PERFORM 49-PRT-LINE
DP17A9*********    GO TO 6-MAIN
DP17A9*********ELSE
                   GO TO 6-CHECK-TRANS
           ELSE

      **************************************************************
      *                                                            *
      *  FOLLOWING IS AN EDIT CHECK FOR CORPORATE CODE.  A VALID   *
      *  CORPORATE CODE MUST BE 1-7 NUMERIC CHARACTERS OR ANY      *
      *  ALPHA-NUMERIC COMBINATION THAT DOESN'T START WITH A SPACE *
      *  OR NUMERIC CHARACTERS WITH NO IMBEDDED SPACES.            *
      *                                                            *
      *  VALID EXAMPLES ARE:      2634578                          *
      *                           A124578                          *
      *                           B3546                            *
      *                           C9978G2                          *
      *                           27ARG52                          *
      *                                                            *
      *  THE FIRST POSITION IS CHECKED FOR A PERIOD TO TRAP OUT    *
      *  ANY IBM SYSTEM MESSAGES THAT MAY PRECEDE OR FOLLOW THE    *
      *  ACTUAL INPUT DATA.          LSB.                          *
      *                                                            *
      **************************************************************

           IF WS-CORPCODE NUMERIC
               NEXT SENTENCE
             ELSE
           IF  WS-CORPCODE1 = SPACE OR
                   WS-CORPCODE1 = "."
               MOVE AKRON-WS-DATA                     TO PRT-DATA
               MOVE "** INVALID CORPORATE CODE **"    TO PRT-MSG
               DISPLAY PRINT-RCD
               GO TO 6-MAIN
             ELSE
           IF WS-CORPCODE-R2-7 = SPACE
               MOVE AKRON-WS-DATA                     TO PRT-DATA
               MOVE "** INVALID CORPORATE CODE **"    TO PRT-MSG
               DISPLAY PRINT-RCD
               GO TO 6-MAIN
             ELSE
           IF WS-CORPCODE2 = SPACE
               MOVE AKRON-WS-DATA                     TO  PRT-DATA
               MOVE "** INVALID CORPORATE CODE **"    TO  PRT-MSG
               DISPLAY PRINT-RCD
               GO TO 6-MAIN
             ELSE
           IF WS-CORPCODE3 = SPACE
               IF WS-CORPCODE-R4-7 = SPACE
                   NEXT SENTENCE
               ELSE
                   MOVE AKRON-WS-DATA                 TO  PRT-DATA
                   MOVE "** INVALID CORPORATE CODE **" TO PRT-MSG
                   DISPLAY PRINT-RCD
                   GO TO 6-MAIN
             ELSE
           IF WS-CORPCODE4 = SPACE
               IF WS-CORPCODE-R5-7 = SPACE
                   NEXT SENTENCE
               ELSE
                   MOVE AKRON-WS-DATA                 TO  PRT-DATA
                   MOVE "** INVALID CORPORATE CODE **"  TO  PRT-MSG
                   DISPLAY PRINT-RCD
                   GO TO 6-MAIN
             ELSE
           IF WS-CORPCODE5 = SPACE
               IF WS-CORPCODE-R6-7 = SPACE
                   NEXT SENTENCE
               ELSE
                   MOVE AKRON-WS-DATA                 TO  PRT-DATA
                   MOVE "** INVALID CORPORATE CODE **"  TO  PRT-MSG
                   DISPLAY PRINT-RCD
                   GO TO 6-MAIN
             ELSE
           IF WS-CORPCODE6 = SPACE
               IF WS-CORPCODE7 = SPACE
                   NEXT SENTENCE
               ELSE
                   MOVE AKRON-WS-DATA                 TO  PRT-DATA
                   MOVE "** INVALID CORPORATE CODE **"  TO  PRT-MSG
                   DISPLAY PRINT-RCD
                   GO TO 6-MAIN.



      **************************************************************
      **   THIS IS THE LIST OF TRANSACTIONS USED BY AKRON UPDATE: **
      **                                                          **
      **        10 - DELETE CORPORATE CODE (KELLY ONLY)           **
      **        20 - ADD CORPORATE CODE                           **
      **        30 - CHANGE DESCRIPTION FOR CORPORATE CODE        **
      **        40 - UPDATE AVERAGE COST, STD COST, MTHLY FCAST   **
      **        50 - UPDATE CHEMICAL ONHAND                       **
      **        60 - UPDATE INVOICE CHECK NUMBER                  **
      **        70 - ADD VENDOR                                   **
      **        71 - DELETE VENDOR                                **
      **        72 - CHANGE VENDOR ADDRESS                        **
      **        80 - DELETE ACCOUNTING DATA                       **
      **        81 - ADD ACCOUNTING DATA                          **
      **        88 - ADD INTERNATIONAL REQUISITION                **
      **        99 - UPDATE ONHAND QUANTITIES                     **
      **                                                          **
      **************************************************************

       6-CHECK-TRANS.
           MOVE "6-CT"                   TO   BU-DISPLAY-FLD (5).
           IF WS-PLT NOT = SAVE-COMPANY
               MOVE AKRON-WS-DATA  TO PRT-DATA
               MOVE "**  WRONG PLANT CODE  **"  TO  PRT-MSG
               PERFORM 49-PRT-LINE
               GO TO 6-MAIN.

      *------ YOU MAY GET A CODE ADDED, THEN A MOD DESC ON ANOTHER CODE
      *------ THEN A MOD DESC AGAIN FOR 1ST CODE.  AVOID THINKING THIS
      *------ IS AN ADD THE 2CD TIME.
           IF WS-TC = "30"
               IF WS-CORPCODE NOT = SAVE-LAST-ADD
                   MOVE SPACES           TO   SAVE-LAST-ADD.

           IF WS-TC = "60" AND INVCK-RPT-OPEN = "N"
               PERFORM 5100-OPEN-INVCK-RPT-FILE.

           IF WS-TC = "10"
               ADD 1                     TO   RCD-CTR
               PERFORM 6010-DELETE-MSTORERM THRU 6090-DM-X
           ELSE
           IF WS-TC = "20"
               ADD 1                     TO   RCD-CTR
               PERFORM 62-ADD-MSTORERM   THRU 62-A-M-X
           ELSE
           IF WS-TC = "30"
               ADD 1                     TO   RCD-CTR
               IF WS-RECD-DESC-ID = ZERO
                   PERFORM 6100-TRANS-30-00     THRU 6190-T30-00-X
                   PERFORM 62-ADD-DESC-LINE THRU 62-A-D-X
               ELSE
               IF WS-RECD-DESC-ID > "00" AND WS-RECD-DESC-ID < "09"
                   PERFORM 6400-MANUFACT THRU 6410-M-X
               ELSE
                   PERFORM 62-ADD-DESC-LINE THRU 62-A-D-X
           ELSE
           IF WS-TC = "31" OR "32"
               ADD 1 TO RCD-CTR
               CALL "CUPDOVER" USING BASE, AKRON-WS-RCD, SAVE-PLT-AREA
           ELSE
           IF WS-TC = "40"
               ADD 1 TO RCD-CTR
               PERFORM 63-UPD-AVG-COST          THRU 63-U-A-C-X
           ELSE
           IF WS-TC = "50"
             IF RAW-BATCH-FILES-OPEN-SW = "N"
               PERFORM 5-OPEN-RAW-BATCH-REPORT-FILES
               GO TO 6-CHECK-TRANS
             ELSE
             IF WS-PLT = SAVE-COMPANY
               ADD 1  TO  RCD-CTR
               IF WS-CP-LIT = "PRODDTE"
      *---- VALIDATE THE PRODUCTION DATE
                   MOVE 3                TO  DATE-MODE
                   MOVE 0                TO  DATE-CODE
                   MOVE WS-CP-MDY        TO  DATE-VALIDATE-IN
                   CALL "TDATECHK" USING DATE-CHECK-AREA
                   IF DATE-RET-CODE = 1
                       MOVE "Y"     TO  INVALID-DATE
                   ELSE
                       MOVE "N"     TO  INVALID-DATE
                   END-IF
                   MOVE WS-CP-MM         TO RM-MONTH, SAVE-CP-MM
                   MOVE WS-CP-DD         TO RM-DAY, SAVE-CP-DD
                   MOVE WS-CP-YY         TO RM-YEAR, SAVE-CP-YY
      *----  WRITE RAW MATL HEADERS
                   ADD 1                      TO  PAGE-CTR
                   MOVE PAGE-CTR              TO  RM-PAGE-CNT
                   MOVE 0                     TO  RPT-CTL
                   MOVE RM-HEAD1              TO  RAW-BATCH-LINE
                   WRITE RAW-BATCH-RCD
                   MOVE 2                     TO  RPT-CTL
                   MOVE RM-HEAD2              TO  RAW-BATCH-LINE
                   WRITE RAW-BATCH-RCD
                   MOVE 2                     TO  RPT-CTL
                   MOVE RM-HEAD3              TO  RAW-BATCH-LINE
                   WRITE RAW-BATCH-RCD
                   MOVE 1                     TO  RPT-CTL
                   MOVE RM-HEAD4              TO  RAW-BATCH-LINE
                   WRITE RAW-BATCH-RCD
                   MOVE 1                     TO  RPT-CTL
                   MOVE RM-HEAD5              TO  RAW-BATCH-LINE
                   WRITE RAW-BATCH-RCD
                   MOVE 5                     TO LINE-CTR
      *----  WRITE ERROR HEADERS
                   MOVE 0  TO  ERR-CTL
                   MOVE ERROR-HEAD1           TO  RAW-BATCH-ERR-LINE
                   WRITE RAW-BATCH-ERR-RCD
                   MOVE RM-HEAD2              TO  RAW-BATCH-ERR-LINE
                   MOVE 2 TO ERR-CTL
                   WRITE RAW-BATCH-ERR-RCD
                   MOVE ERROR-HEAD2           TO  RAW-BATCH-ERR-LINE
                   MOVE 2  TO  ERR-CTL
                   WRITE RAW-BATCH-ERR-RCD
                   MOVE ERROR-UNDERLINE       TO  RAW-BATCH-ERR-LINE
                   MOVE 1  TO  ERR-CTL
                   WRITE RAW-BATCH-ERR-RCD
                   MOVE 2  TO  ERR-CTL
               ELSE
                   PERFORM 65-UPD-CHEM-ONHAND   THRU 65-UCO-X
             ELSE
                 IF WS-CP-LIT = "PRODDTE"
                     MOVE ERROR-HEAD1  TO  RAW-BATCH-ERR-LINE
                     WRITE RAW-BATCH-ERR-RCD
                     MOVE ERROR-UNDERLINE  TO  RAW-BATCH-ERR-LINE
                     MOVE 1  TO  ERR-CTL
                     WRITE RAW-BATCH-ERR-RCD
                     MOVE "INVALID PLANT FILE - CONTACT DP MANAGER"
                         TO  RAW-BATCH-ERR-LINE
                     MOVE 2  TO  ERR-CTL
                     WRITE RAW-BATCH-ERR-RCD
                 ELSE
                     MOVE "INVALID PLANT FILE - CONTACT DP MANAGER"
                         TO  RAW-BATCH-ERR-LINE
                     MOVE 1  TO  ERR-CTL
                     WRITE RAW-BATCH-ERR-RCD
           ELSE
           IF WS-TC = "60"
               ADD 1 TO RCD-CTR
               CALL "TAKINVCK" USING INVCK-RET-CODE, MODE1, BASE,
                 STATUS-AREA, AKRON-WS-RCD, INVCK-DATA
           ELSE
      **************************************************************
      **ON VENDOR ADDS OR CHANGES, THE 00 DVENDOR LINE # MUST BE
      **ADDED FIRST.  EACH TIME A 00 LINE IS ADDED OR CHANGED,
      **THE VEN # IS MOVED TO ADD-VEN-SAVE OR CHG-VEN-SAVE.
      **ANY ADD OR CHANGE OF A LINE OTHER THAN 00 IS THEN CHECKED
      **AGAINST THESE SAVES TO INSURE A 00 LINE WAS PROCESSED
      **PREVIOUSLY
      **************************************************************
           IF WS-TC = "70"
               ADD 1 TO RCD-CTR
               IF WS-VEN-ITM-NO = "00"
                   PERFORM 73-CALCULATED-GET-AVENDCODE
                   IF FATAL-ERR-SW = "Y"
                       NEXT SENTENCE
                   ELSE
                   IF VENDOR-EXISTS-FLAG = "Y"
                       MOVE SPACES                  TO VENDOR-PRINT-LINE
                       MOVE "ADD"                   TO PRT-VENDOR-ACTION
                       MOVE WS-VEN-CODE               TO  PRT-VENCODE
                       MOVE WS-VEN-ITM-DATA           TO  PRT-VEN-ADDR
                       MOVE VENDOR-PRINT-LINE         TO  PRINT-RCD
                       MOVE "*VENDOR ALREADY EXISTS*" TO  PRT-MSG
                       MOVE 1                         TO  LINE-ADV
                       PERFORM 49-PRT-LINE
                   ELSE
      *                *********************************************
      *                **IMMEDIATELY AFTER THE 00 DVENDOR LINE ADD,
      *                **THE VENDOR ACTIVITY DATE IS UPDATED TO
      *                **CURRENT DATE (DVENDOR LINE 08)
      *                *********************************************
                       MOVE WS-VEN-CODE               TO ADD-VEN-SAVE
                       PERFORM 70-ADD-DVENDOR   THRU 70-A-D-X
                       MOVE "08"                      TO WS-VEN-ITM-NO
                       MOVE YMD-DATE                  TO WS-VEN-ITM-DATA
                       PERFORM 70-ADD-DVENDOR-08  THRU 70-A-D-X
               ELSE
               IF WS-VEN-ITM-NO > "09" OR < "00"
                       MOVE SPACES                  TO VENDOR-PRINT-LINE
                       MOVE "ADD"                   TO PRT-VENDOR-ACTION
                       MOVE WS-VEN-CODE               TO  PRT-VENCODE
                       MOVE WS-VEN-ITM-DATA           TO  PRT-VEN-ADDR
                       MOVE VENDOR-PRINT-LINE         TO  PRINT-RCD
                       MOVE "*VENDOR LINE INVALID*"   TO  PRT-MSG
                       MOVE 1                         TO  LINE-ADV
                       PERFORM 49-PRT-LINE
               ELSE
               IF WS-VEN-CODE NOT = ADD-VEN-SAVE
                       MOVE SPACES                  TO VENDOR-PRINT-LINE
                       MOVE "ADD"                   TO PRT-VENDOR-ACTION
                       MOVE WS-VEN-CODE               TO  PRT-VENCODE
                       MOVE WS-VEN-ITM-DATA           TO  PRT-VEN-ADDR
                       MOVE VENDOR-PRINT-LINE         TO  PRINT-RCD
                       MOVE "*VENDOR NAME LINE ERROR*" TO PRT-MSG
                       MOVE 1                         TO  LINE-ADV
                       PERFORM 49-PRT-LINE
                       IF WS-VEN-ITM-NO = "07"
                         MOVE SPACES                  TO  PRINT-RCD
                         PERFORM 49-PRT-LINE
                       ELSE
                         NEXT SENTENCE
               ELSE
                   PERFORM 70-ADD-DVENDOR       THRU 70-A-D-X
           ELSE
           IF WS-TC = 71
               ADD 1 TO RCD-CTR
               MOVE "Y"  TO  FIRST-CALL
               PERFORM 71-DLT-VENDOR            THRU 71-D-V-X
           ELSE
           IF WS-TC = "72"
               ADD 1 TO RCD-CTR
               MOVE WS-VEN-CODE                       TO VEN-ARG
               IF WS-VEN-ITM-NO = "00"
                   PERFORM 73-CALCULATED-GET-AVENDCODE
                   IF FATAL-ERR-SW = "Y"
                       NEXT SENTENCE
                   ELSE
                   IF VENDOR-EXISTS-FLAG = "N"
                       MOVE SPACES                  TO VENDOR-PRINT-LINE
                       MOVE "CHG"                   TO PRT-VENDOR-ACTION
                       MOVE WS-VEN-CODE               TO  PRT-VENCODE
                       MOVE WS-VEN-ITM-DATA           TO  PRT-VEN-ADDR
                       MOVE VENDOR-PRINT-LINE         TO  PRINT-RCD
                       MOVE "*VENDOR DOES NOT EXIST*" TO  PRT-MSG
                       MOVE 1                         TO  LINE-ADV
                       PERFORM 49-PRT-LINE
                   ELSE
                       MOVE WS-VEN-CODE               TO CHG-VEN-SAVE
                       PERFORM 715-FIND-DVENDOR THRU 716-U-X
                       IF FATAL-ERR-SW = "Y"
                           NEXT SENTENCE
                       ELSE
                           PERFORM 70-ADD-DVENDOR THRU 70-A-D-X
                           MOVE "08"                  TO WS-VEN-ITM-NO
                           MOVE YMD-DATE              TO WS-VEN-ITM-DATA
                           PERFORM 70-ADD-DVENDOR-08  THRU 70-A-D-X
               ELSE
               IF WS-VEN-ITM-NO > "09" OR < "00"
                       MOVE SPACES                  TO VENDOR-PRINT-LINE
                       MOVE "CHG"                   TO PRT-VENDOR-ACTION
                       MOVE WS-VEN-CODE               TO  PRT-VENCODE
                       MOVE WS-VEN-ITM-DATA           TO  PRT-VEN-ADDR
                       MOVE VENDOR-PRINT-LINE         TO  PRINT-RCD
                       MOVE "*VENDOR LINE INVALID*"   TO  PRT-MSG
                       MOVE 1                         TO  LINE-ADV
                       PERFORM 49-PRT-LINE
               ELSE
               IF WS-VEN-CODE NOT = CHG-VEN-SAVE
                       MOVE SPACES                  TO VENDOR-PRINT-LINE
                       MOVE "CHG"                   TO PRT-VENDOR-ACTION
                       MOVE WS-VEN-CODE               TO  PRT-VENCODE
                       MOVE WS-VEN-ITM-DATA           TO  PRT-VEN-ADDR
                       MOVE VENDOR-PRINT-LINE         TO  PRINT-RCD
                       MOVE "*VENDOR NAME LINE ERROR*" TO PRT-MSG
                       MOVE 1                         TO  LINE-ADV
                       PERFORM 49-PRT-LINE
                       IF WS-VEN-ITM-NO = "07"
                         MOVE SPACES                  TO  PRINT-RCD
                         PERFORM 49-PRT-LINE
                       ELSE
                         NEXT SENTENCE
               ELSE
                   PERFORM 70-ADD-DVENDOR         THRU 70-A-D-X
           ELSE
           IF WS-TC = "80"
               ADD 1  TO  RCD-CTR
               PERFORM 80-DELETE-ACCT-DATA        THRU 80-DAD-X
           ELSE
           IF WS-TC = "81"
               ADD 1  TO  RCD-CTR
               PERFORM 81-ADD-ACCT-DATA           THRU 81-AAD-X
           ELSE
           IF WS-TC = "88"
               ADD 1  TO  RCD-CTR
               PERFORM 88-ADD-INT-REQ             THRU 88-AIR-X
           ELSE
           IF WS-TC = "**"
               NEXT SENTENCE
           ELSE
           IF WS-TC = "90"
               IF AKRON-SEND-CNT NUMERIC
                   ADD AKRON-SEND-CNT  TO  AKR-CTR
               ELSE
                   MOVE SPACES TO FORMAT-AKRON-CNT-PRT-DATA
                   MOVE AKRON-SEND-TC                 TO FAC-TC
                   MOVE AKRON-SEND-PLT                TO FAC-PLT
                   MOVE AKRON-SEND-CNT                TO FAC-SEND-CNT
                   MOVE FORMAT-AKRON-CNT-PRT-DATA     TO PRT-DATA
                   MOVE "  ** RECORD COUNT NOT NUMERIC **" TO PRT-MSG
                   PERFORM 49-PRT-LINE
           ELSE
           IF WS-TC = "99"
               ADD 1  TO  RCD-CTR
               PERFORM  99-UPDATE-ONHAND    THRU  99-UP-X
           ELSE
               MOVE AKRON-WS-DATA                     TO  PRT-DATA
               DISPLAY "INVALID TC IS ", WS-TC
               MOVE "  ** INVALID TC **"              TO  PRT-MSG
               PERFORM 49-PRT-LINE.

           IF FATAL-ERR-SW = "Y"
               GO TO 6-MAIN-X.

           GO TO 6-MAIN.

       6-MAIN-X.
           EXIT.

       6010-DELETE-MSTORERM.
           MOVE "6010-DM"                TO   BU-DISPLAY-FLD (5).
      *---------- THE DELETE TRANSACTION IS ALLOWED CURRENTLY ONLY AT
      *---------- KELLY PLANTS.  THE DELETE TRANSACTION BEING ALLOWED IS
      *---------- SIGNIFIED BY THE EXISTENCE OF THE "CDDL" KEY IN THE
      *---------- MPLTINFO DATASET.
           IF DELETE-ALLOW-FLAG = "N"
               MOVE "*** DELETE NOT ALLOWED ***" TO  PRT-DESC
               MOVE WS-CORPCODE                  TO  PRT-CORPCODE
               MOVE SPACES                       TO  PRT-CODE-ACTION
               MOVE 1                            TO  LINE-ADV
               MOVE CODE-PRINT-LINE              TO  PRINT-RCD
               PERFORM 49-PRT-LINE
               MOVE CODE-PRINT-LINE              TO  AKRUPDT-ERROR-RCD
               WRITE AKRUPDT-ERROR-RCD
               DISPLAY CODE-PRINT-LINE
               GO TO 6090-DM-X.

           MOVE WS-CORPCODE              TO   CODE-ARG.
           CALL "CCODEDEL" USING BASE, STATUS-AREA, BU-DISPLAY-MSG,
             CODE-ARG, FILENUMBER, CCODEDEL-PADDING.
           IF BU-DISPLAY-MSG-1 NOT = SPACES
               PERFORM 2-BLOWUP.

           MOVE SPACES                   TO   CODE-PRINT-LINE.
           MOVE "DEL"                    TO   PRT-CODE-ACTION.
           MOVE WS-CORPCODE              TO   PRT-CORPCODE.
           MOVE "**CODE DELETED  **"     TO   PRT-DESC.
           MOVE CODE-PRINT-LINE          TO   PRINT-RCD.
           PERFORM 49-PRT-LINE.

       6090-DM-X.
           EXIT.

       6100-TRANS-30-00.
           MOVE "6100-T30"               TO   BU-DISPLAY-FLD (5).
      *---------- THE KEYWORD MODIFIER ENTRY (TRANS 30, ID 00) MEANS
      *---------- WE MUST DO THE FOLLOWING:
      *              -  ADD THE MASTER KEYWORD ADJECTIVE ENTRY IF IT
      *                 DOESNT ALREADY EXIST
      *              -  DELETE ANY DCODE LINKS TO A KEYWORD ADJECTIVE
      *                 FOR THAT CODE - IN CASE KEY/MOD CHANGED
      *              -  DELETE MANUFACTURER/PART NUMBER ENTRIES FOR THAT
      *                 CODE SO THEY CAN BE READDED
      *              -  DELETE DESCRIPTION (EITHER DDESC OR DDESC2) FOR
           MOVE "MKEYADJ;"               TO  DSET-NAME.

           MOVE SPACES                   TO  BUF-MKEYADJ.
           MOVE WS-RECD-DESC-KWD         TO  KEYADJ-KEYWORD.
           MOVE WS-RECD-DESC-ADJ         TO  KEYADJ-MODIFIER.
      *    CALL "DBPUT" USING BASE, DSET-NAME, MODE1, STATUS-AREA,
      *      ALL-ITEMS, BUF-MKEYADJ.
           WRITE MKEYADJ-REC-O FROM BUF-MKEYADJ
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS = "22" OR "00"
               NEXT SENTENCE
           ELSE
               MOVE "DBPUT ERR MKEYADJ 6100-T30" TO BU-DISPLAY-MSG
               PERFORM 2-BLOWUP.

           MOVE WS-CORPCODE              TO  CODE-ARG.
           MOVE CODE-ARG TO CORPCDE OF MSTORERM-REC-O.
           START MSTORERM-O KEY = CORPCDE OF MSTORERM-REC-O
              INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS = "23"
               PERFORM 62-ADD-MSTORERM THRU 62-A-M-X
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE "START ERROR MSTORERM     " TO BU-DISPLAY-MSG
               PERFORM 2-BLOWUP.

           MOVE "DCODE;"                 TO  DSET-NAME.
      *    CALL "DBFIND" USING BASE, DSET-NAME, MODE1, STATUS-AREA,
      *      CODE-SEARCH, CODE-ARG.
           MOVE CODE-ARG TO CORPCDE OF DCODE-C-REC-O.
           START DCODE-C-O KEY = CORPCDE OF DCODE-C-REC-O
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF (FILE-STATUS NOT = "00") AND (FILE-STATUS-1 NOT = "2")
               MOVE "DBFIND ERR 6100-T30" TO BU-DISPLAY-MSG
               PERFORM 2-BLOWUP.

           MOVE "N"                      TO  DCODE-EXISTS-FLAG.
       6120-GET-DELETE-DCODE-LOOP.
           MOVE "6120-GDDL"              TO   BU-DISPLAY-FLD (5).
      *    CALL "DBGET" USING BASE, DSET-NAME, MODE5, STATUS-AREA,
      *      ALL-ITEMS, BUF-DCODE, CODE-ARG.
           MOVE 0 TO COND-WORD.
           READ DCODE-C-O NEXT INTO BUF-DCODE
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   MOVE 15 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.
           IF CORPCDE OF DCODE-C-REC-O NOT = CODE-ARG
               MOVE 15 TO COND-WORD.
           IF COND-WORD = 15
               GO TO 6150-PUT-DCODE
           ELSE
           IF COND-WORD NOT = 0
               MOVE "DBGET ERR DCOE 6120-GDDL" TO BU-DISPLAY-MSG
               PERFORM 2-BLOWUP.

      *---------- ONLY DELETE THE DCODE ENTRY FOR THE ENGLISH LANGUAGE
      *---------- BECAUSE ONLY THE ENGLISH DESCRIPTIONS COME DOWN FROM
      *---------- THE MAINFRAME, AND BECAUSE THE KEYWORD ADJECTIVE FOR
      *---------- A CODE MAY CHANGE
           IF SAVE-PRIM-LANG = "001"
               IF CODE-LANGUAGE-IND = "1"
                   NEXT SENTENCE
               ELSE
                   GO TO 6120-GET-DELETE-DCODE-LOOP
           ELSE
               IF CODE-LANGUAGE-IND = "2"
                   NEXT SENTENCE
               ELSE
                   GO TO 6120-GET-DELETE-DCODE-LOOP.

           MOVE "Y"                      TO   DCODE-EXISTS-FLAG.
           MOVE CODE-KEYWORD-MOD         TO   SAVE-KEYWORD-MOD.

      *    CALL "DBDELETE" USING BASE, DSET-NAME, MODE1, STATUS-AREA.
           DELETE DCODE-C-O
             INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE "DBDELETE ERR 6120-GDDL" TO BU-DISPLAY-MSG
               PERFORM 2-BLOWUP.

           GO TO 6120-GET-DELETE-DCODE-LOOP.

       6150-PUT-DCODE.
           MOVE "6150-PD"                TO   BU-DISPLAY-FLD (5).
           MOVE SPACES                   TO   BUF-DCODE.
           MOVE WS-RECD-DESC-KWD         TO   CODE-KEYWORD.
           MOVE WS-RECD-DESC-ADJ         TO   CODE-MODIFIER.
           MOVE CODE-ARG                 TO   CODE-KEY-CODE.
           IF SAVE-PRIM-LANG = "001"
               MOVE "1"                  TO   CODE-LANGUAGE-IND
           ELSE
               MOVE "2"                  TO   CODE-LANGUAGE-IND.

      *    CALL "DBPUT" USING BASE, DSET-NAME, MODE1, STATUS-AREA,
      *      ALL-ITEMS, BUF-DCODE.
           WRITE DCODE-C-REC-O FROM BUF-DCODE
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE "DBPUT ERR DCODE 6150-PD" TO BU-DISPLAY-MSG
               PERFORM 2-BLOWUP.

      *---------- IF A NON-AMERICAN LANGUAGE IS PRIMARY, AND IF IT IS
      *---------- A CORP-CODE ADD, THE DESCRIPTION IS ADDED TO BOTH
      *---------- LANGUAGES.  THE DCODE ENTRY MUST ALSO BE PUT OUT FOR BOTH
           IF WS-CORPCODE = SAVE-LAST-ADD
               IF SAVE-PRIM-LANG = "001"
                   NEXT SENTENCE
               ELSE
                   MOVE "1"              TO   CODE-LANGUAGE-IND
      *            CALL "DBPUT" USING BASE, DSET-NAME, MODE1,
      *              STATUS-AREA, ALL-ITEMS, BUF-DCODE
                   WRITE DCODE-C-REC-O FROM BUF-DCODE
                       INVALID KEY MOVE FILE-STATUS TO FILE-STATUS
                   END-WRITE
                   IF FILE-STATUS NOT = "00"
                       MOVE "DBPUT ERR DCODE2 6150-PD" TO BU-DISPLAY-MSG
                       PERFORM 2-BLOWUP.

       6155-DELETE-KEYWORD-ADJECTIVE.
           MOVE "6155-DKA"               TO   BU-DISPLAY-FLD (5).
      *---------- IF A DCODE ENTRY EXISTED FOR THE CODE, AND
      *---------- IF THE KEYWORD ADJECTIVE HAS CHANGED, ATTEMPT
      *---------- TO DELETE THE OLD KEYWORD ADJECTIVE
      *------ NOTE: FOR IBM, WE MUST CHECK FIRST THAT THERE ARE NO
      *------ ENTRIES FOR THAT KEYWORD ADJ, AND IF NOT DELETE IT.
           IF DCODE-EXISTS-FLAG = "Y"
             IF CODE-KEYWORD-MOD NOT = SAVE-KEYWORD-MOD
      *        CALL "DBGET" USING BASE, DSET-NAME, MODE7,
      *          STATUS-AREA, ALL-ITEMS, BUF-MKEYADJ,  SAVE-KEYWORD-MOD
               MOVE SAVE-KEYWORD-MOD TO KEYWORDADJ OF DCODE-K-REC-I
               START DCODE-K-I KEY = KEYWORDADJ OF DCODE-K-REC-I
                   INVALID KEY MOVE FILE-STATUS TO FILE-STATUS
               END-START
               IF FILE-STATUS-1 = "2"
                  MOVE SAVE-KEYWORD-MOD TO KEYWORDADJ OF MKEYADJ-REC-O
                  READ MKEYADJ-O INTO BUF-MKEYADJ
                      INVALID KEY MOVE FILE-STATUS TO FILE-STATUS
                  END-READ
                  IF FILE-STATUS NOT = "00"
                     MOVE "DBGET ERR MKEYADJ 6155-DK" TO BU-DISPLAY-MSG
                      PERFORM 2-BLOWUP
                  ELSE
      *               CALL "DBDELETE" USING BASE, DSET-NAME, MODE1,
      *                 STATUS-AREA
                      DELETE MKEYADJ-O
                        INVALID KEY MOVE FILE-STATUS TO FILE-STATUS
                      END-DELETE
                      IF FILE-STATUS NOT = "00"
                          MOVE "DBDELETE ERR MKEYADJ 6155-DK"
                            TO BU-DISPLAY-MSG
                          PERFORM 2-BLOWUP.

           MOVE 0                        TO   SUB.
       6157-FIND-LOOP.
      *---------- GET AND DELETE ALL MANUFACTURER/PART NUMBER DETAILS
      *---------- FOR THIS CODE - THEY WILL BE RE-ADDED
           MOVE "DMANPART;"              TO  DSET-NAME.
      *    CALL "DBFIND" USING BASE, DSET-NAME, MODE1,
      *      STATUS-AREA, CODE-SEARCH, CODE-ARG.
           MOVE CODE-ARG TO CORPCDE OF DMANPART-C-REC-O.
           START DMANPART-C-O KEY = CORPCDE OF DMANPART-C-REC-O
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF (FILE-STATUS NOT = "00") AND (FILE-STATUS-1 NOT = "2")
               MOVE "DBFIND ERR DMANPART 6150-PD" TO BU-DISPLAY-MSG
                PERFORM 2-BLOWUP.

       6160-GET-DELETE-DMANPART.
           MOVE "6160-GDD"              TO   BU-DISPLAY-FLD (5).
           MOVE "DMANPART;"              TO   DSET-NAME.
      *    CALL "DBGET" USING BASE, DSET-NAME, MODE5, STATUS-AREA,
      *      ALL-ITEMS, BUF-DMANPART, CODE-ARG.
           MOVE 0 TO COND-WORD.
           READ DMANPART-C-O NEXT INTO BUF-DMANPART
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   MOVE 15 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.
           IF CORPCDE OF DMANPART-C-REC-O NOT = CODE-ARG
               MOVE 15 TO COND-WORD.
           IF COND-WORD = 15
               MOVE SUB                  TO   MAN-TABLE-LIMIT
               GO TO 6170-DELETE-DESC
           ELSE
           IF COND-WORD NOT = 0
               MOVE "DBGET ERR DMANPART 6160-GDD" TO BU-DISPLAY-MSG
               PERFORM 2-BLOWUP.
           ADD 1                         TO   SUB.
      *---------- MOVE THE ENTRY TO A SAVE TABLE - THE USER CAN MODIFY
      *---------- ONE FIELD IN THIS ENTRY, WE NEED TO SAVE THE DATA SO
      *---------- THIS FIELD CAN BE SAVED ON THE RE-ADD OF THE DATA
           MOVE BUF-DMANPART             TO   DMANPART-LINE (SUB).

      *    CALL "DBDELETE" USING BASE, DSET-NAME, MODE1, STATUS-AREA.
           DELETE DMANPART-C-O
             INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE "DBDELETE ERR 6160-GDD" TO BU-DISPLAY-MSG
               PERFORM 2-BLOWUP.

      *---------- AN ATTEMPT IS MADE TO DELETE EACH MANUFACTURER
      *---------- FROM THE MANUAL MASTER - TO CLEAN IT UP IN CASE
      *---------- ALL DETAILS FOR A MANUFACTURER ARE DELETED.
      *------ NOTE: FOR IBM WE HAVE TO FIRST DETERMINE IF ANY DETAILS
      *------ EXIST.
CY1219*------ IF NO DETAILS EXIST, DO NOT ABEND; JUST CONTINUE SINCE
CY1219*------ THE ENTRIES ARE BEING DELETED ANYWAY.
           MOVE MAN-NAME TO MANUFACT OF DMANPART-M-REC-I.
           START DMANPART-M-I KEY = MANUFACT OF DMANPART-M-REC-I
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS-1 = "2"
               MOVE "MMANUFACT;"         TO  DSET-NAME
               MOVE MAN-NAME             TO  MANUFACT-ARG
      *        CALL "DBGET" USING BASE, DSET-NAME, MODE7, STATUS-AREA,
      *          ALL-ITEMS, BUF-MMANUFACT, MANUFACT-ARG
               MOVE MANUFACT-ARG TO MANUFACT OF MMANUFACT-REC-O
               READ MMANUFACT-O INTO BUF-MMANUFACT
                   INVALID KEY MOVE FILE-STATUS TO FILE-STATUS
               END-READ
               IF FILE-STATUS NOT = "00"
CY1219            NEXT SENTENCE
CY1219****        MOVE "DBGET ER MMANUFACT 6160-GDD" TO BU-DISPLAY-MSG
CY1219****        PERFORM 2-BLOWUP
CY1219****     END-IF
CY1219         ELSE
      *        CALL "DBDELETE" USING BASE,DSET-NAME,MODE1,STATUS-AREA.
               DELETE MMANUFACT-O
                 INVALID KEY MOVE FILE-STATUS TO FILE-STATUS
               END-DELETE
               IF FILE-STATUS NOT = "00"
                   MOVE "DEL ERR MMANUFACT 6160-GDD" TO BU-DISPLAY-MSG
                   PERFORM 2-BLOWUP.

      *------ NOTE: FOR IBM WE DONT HAVE THE KSAM FILES FOR MANUFACT
      *------ AND KEYADJ (BECAUSE MMANUFACT AND MKEYADJ ARE ALREADY
      *------ SORTED), SO WE DONT HAVE TO DELETE THEM.

      *------ HAVE TO GO BACK TO FIND LOOP BECAUSE DBDELETE LOSES CHAIN
           GO TO 6160-GET-DELETE-DMANPART.

       6170-DELETE-DESC.
           MOVE "6170-DD"                TO   BU-DISPLAY-FLD (5).
      *--------- CONTROL BREAK FOR CODE ADD REPORT
           IF WS-CORPCODE NOT = HOLD-CODE
               MOVE SPACES                  TO  PRINT-RCD
               MOVE 1                       TO  LINE-ADV
               PERFORM 49-PRT-LINE
               MOVE WS-CORPCODE             TO  HOLD-CODE.

           MOVE "N"                         TO  DELETE-ALTKEY-SW.

           IF SAVE-PRIM-LANG = "001"
               MOVE "DDESC;"             TO  DSET-NAME
           ELSE
               MOVE "DDESC2;"            TO  DSET-NAME.

           MOVE WS-CORPCODE                 TO  CODE-ARG.

      *    CALL "DBFIND" USING BASE, DSET-NAME, MODE1, STATUS-AREA,
      *        SEARCH-ITEM, CODE-ARG.
           PERFORM 9300-FIND-DDESC.

       61-DLT-DESC-LINE.
           MOVE "61-DDL"                 TO   BU-DISPLAY-FLD (5).
      *    CALL "DBGET" USING BASE, DSET-NAME, MODE5, STATUS-AREA,
      *        ALL-ITEMS, BUF-DDESC, CODE-ARG.
           PERFORM 9310-GET-DDESC.
           IF COND-WORD = 0
               NEXT SENTENCE
           ELSE
           IF COND-WORD = 15
               GO TO 61-CHECK-00
           ELSE
               MOVE "DBGET ERR 61-DDL" TO BU-DISPLAY-MSG
               PERFORM 2-BLOWUP.

      *---------- DON'T DELETE THE LOCAL DESCRIPTION
           IF DESC-ID-NUM = "99"
               GO TO 61-DLT-DESC-LINE.

      *    CALL "DBDELETE" USING BASE, DSET-NAME, MODE1, STATUS-AREA.
           PERFORM 9320-DELETE-DDESC.
           IF FILE-STATUS NOT = "00"
               MOVE "DBDELETE ERR 61-DDL" TO BU-DISPLAY-MSG
               PERFORM 2-BLOWUP.

      *---------- FOR RAW MATERIALS, WHEN THE KWRD/ADJ IS DELETED FROM
      *           THE DATABASE (FOR EITHER A CHANGE OR A DELETE),
      *           DELETE THE ALTERNATE KEY OUT OF THE ALT KEY DATASET.

           IF DESC-CODE-1-2 = "26"
               IF DESC-ID-NUM = "00"
                   MOVE "Y"           TO  DELETE-ALTKEY-SW
                   MOVE DESC-MOD      TO  ALT-KEY.

      *---------- THE ALTERNATE KEY FOR FABRICS IS FOUND IN THE 2CD
      *---------- LINE OF DESCRIPTION, WHICH IS ACTUALLY ID-NUM "09",
      *---------- SINCE LINES "01" - "08" ARE NOW USED FOR MANUFACTURERS
           IF DESC-CODE-1-2 = "27"
               IF DESC-ID-NUM = "09"
                   CALL "TDETCODE" USING RET-CODE, DESC-DATA, ALT-KEY
                   IF RET-CODE = "00"
                       MOVE "Y"       TO  DELETE-ALTKEY-SW.

           MOVE SPACES            TO  CODE-PRINT-LINE.
           MOVE "DEL"             TO  PRT-CODE-ACTION.
           MOVE CODE-ARG          TO  PRT-CORPCODE.
           MOVE DESC-DATA         TO  PRT-DESC.
           MOVE CODE-PRINT-LINE   TO  PRINT-RCD.
           MOVE 1                 TO  LINE-ADV.
           PERFORM 49-PRT-LINE.

           GO TO 61-DLT-DESC-LINE.

       61-CHECK-00.
           MOVE "61-C0"                  TO   BU-DISPLAY-FLD (5).

      *---------- NOW CALL THE ALT KEY PROGRAM TO DELETE THE ALT
      *           KEY FOUND ABOVE.

           IF DESC-CODE-1-2 = "26" OR "27"
               IF DELETE-ALTKEY-SW = "Y"
                   MOVE "DL"  TO  RET-CODE
                   CALL "TALTKEY" USING RET-CODE, BASE, STATUS-AREA,
                     ALT-KEY, ALT-CORP-CODE
                   IF RET-CODE = "BU"
                       DISPLAY "TALTKEY D ERROR COND-WORD = ", COND-WORD,
                         " CODE = ", DESC-CORP-CODE.

       6190-T30-00-X.
           EXIT.

       62-ADD-MSTORERM.
           MOVE "62-AM"                  TO   BU-DISPLAY-FLD (5).
           MOVE "MSTORERM;"                 TO  DSET-NAME.
           MOVE SPACES                      TO  BUF-MSTORERM.
           MOVE WS-CORPCODE                 TO  CORP-CODE.
           MOVE YMD-DATE                    TO  STR-INIT-DATE
                                                STR-ACT-DATE
                                                STR-INV-DATE.
           IF YY > "70"
               MOVE "19" TO STR-INIT-DATE-CC
                            STR-ACT-DATE-CC
                            STR-INV-DATE-CC
           ELSE
               MOVE "20" TO STR-INIT-DATE-CC
                            STR-ACT-DATE-CC
                            STR-INV-DATE-CC.
           MOVE SHIP-DAYS                   TO  STR-EST-LT.
           MOVE ZERO  TO  STR-EOQ, STR-REORDER, STR-MAX,
                          STR-EXPEDITE, STR-STD-COST, STR-AVG-COST,
                          STR-PREV-AVG, STR-UM1-CF, STR-UM2-CF,
                          STR-LAST-DLVTIMES (1), STR-LAST-DLVTIMES (2),
                          STR-LAST-DLVTIMES (3),
                          STR-PHY-INV-CYL,
                          STR-MKT-COST, STR-MTH-FCST, STR-ONHAND,
                          STR-ONORDER, STR-RESERVED, STR-RSRV-ONORD,
                          STR-OUT-REPAIR-COST,
                          STR-MAINT-REPAIR-COST,
                          STR-TAX-PERCENT
                          STR-LOC-ONHAND (1),
                          STR-LOC-ONHAND (2), STR-LOC-ONHAND (3),
                          STR-LOC-ONHAND (4), STR-LOC-ONHAND (5),
                          STR-LOC-ONHAND (6), STR-SOQ.
           IF SAP-AUTH-FLAG = "Y"
               MOVE "X"                     TO  STR-AUTH-FLAG.

           IF WS-TC NOT = "30"
               MOVE WS-RCD-AM-LOC-CODE      TO  STR-PREV-CODE
                                                STR-LOC (1)
               MOVE SPACES                  TO  STR-CLASS.

      *    CALL "DBPUT" USING BASE, DSET-NAME, MODE1, STATUS-AREA,
      *        ALL-ITEMS, BUF-MSTORERM.
           WRITE MSTORERM-REC-O FROM BUF-MSTORERM
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
             IF FILE-STATUS = "22"
               MOVE SPACES                  TO  CODE-PRINT-LINE
               MOVE "ADD"                   TO  PRT-CODE-ACTION
               MOVE CORP-CODE               TO  PRT-CORPCODE
               MOVE "** CODE ALREADY EXISTS*" TO PRT-DESC
               MOVE CODE-PRINT-LINE         TO  PRINT-RCD
               MOVE 1                       TO  LINE-ADV
               PERFORM 49-PRT-LINE
               GO TO 62-A-M-X
             ELSE
               MOVE "DBPUT ERR 62-AM" TO BU-DISPLAY-MSG
               PERFORM 2-BLOWUP.

      *---------- IF THE CODE WAS SUCCESSFULLY ADDED, WE SAVE THE CODE -
      *---------- SO THAT ON THE MANUFACTURER ADD WE KNOW IF THIS WAS AN "ADD"
      *---------- OR "CHANGE" TRANSACTION. (MANUFACT ADD DOESNT HAPPEN UNTIL
      *---------- THE 30 TRANSACTION COMES DOWN).
           MOVE WS-CORPCODE              TO   SAVE-LAST-ADD.

           MOVE SPACES            TO  PRINT-RCD.
           MOVE 1                 TO  LINE-ADV.
           PERFORM 49-PRT-LINE.
           MOVE SPACES            TO  CODE-PRINT-LINE.
           MOVE "ADD"             TO  PRT-CODE-ACTION.
           MOVE CORP-CODE         TO  PRT-CORPCODE.
           MOVE "**CODE ADDED  **" TO PRT-DESC.
           MOVE CODE-PRINT-LINE   TO  PRINT-RCD.
           PERFORM 49-PRT-LINE.
           MOVE CORP-CODE         TO  HOLD-CODE.

       62-ADD-DDAILYTC.
      ***************************************************************
      **   WHEN A NEW CORP CODE IS ADDED TO THE DATABASE, AN ENTRY **
      **   IS MADE TO DDAILYTC.  FOR PLANTS USING THE CSAS SYTEM   **
      **   THE CORP CODE WILL THEN BE ADDED TO THEIR CSAS DATABASE **
      **   OUT OF DDAILYTC.                                        **
      ***************************************************************
           MOVE "62-AD"                 TO BU-DISPLAY-FLD (5).
           MOVE SPACES                  TO BUF-DDAILYTC.
           MOVE YMD-DATE                TO DDAILYTC-DATE.
           ACCEPT HOLD-TIME FROM TIME.
           MOVE HOLD-TIME               TO DDAILYTC-TIME.
           MOVE WS-PLT                  TO DDAILYTC-PLT.
           MOVE "100"                   TO DDAILYTC-TC.
           MOVE CORP-CODE               TO TC100-CORP-CODE.
           MOVE "DDAILYTC"              TO DSET-NAME.

           WRITE DDAILYTC-REC-O FROM BUF-DDAILYTC
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE "WRITE DDAILYTC ERR 62-AD" TO BU-DISPLAY-MSG
               PERFORM 2-BLOWUP.

       62-AD-X.
           EXIT.

       62-ADD-KSAM.
           MOVE "62-AK"                  TO   BU-DISPLAY-FLD (5).
      **************************************************************
      **   WHEN A NEW CORP CODE IS ADDED TO THE DATABASE, AN      **
      **   ENTRY ALSO MUST BE ADDED IN THE KSAM "USAGFIL", WITH   **
      **   ALL USAGE FIGURES INITIALIZED TO ZERO.                 **
      **************************************************************

           MOVE CORP-CODE                TO   K-CORP-CODE.
           MOVE 0                        TO   SUB.

       62-INITIALIZE-KSAM.
           MOVE "62-IK"                  TO   BU-DISPLAY-FLD (5).
           ADD 1 TO SUB.
           IF SUB > 14
               GO TO 62-LOCK-KSAM.
           MOVE 0 TO K-MTH-USAGE (SUB)
                     K-MTH-USAGE-DD(SUB).
           GO TO 62-INITIALIZE-KSAM.

       62-LOCK-KSAM.
           MOVE "62-LK"                  TO   BU-DISPLAY-FLD (5).
           WRITE USAGEFIL-REC-O FROM USAGE-REC
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS = "22"
                NEXT SENTENCE
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE "CKWRITE ERR 62-LK"  TO BU-DISPLAY-MSG
               PERFORM 2-BLOWUP.

       62-ADD-RECEIPTS.
           MOVE "62-AR"                  TO   BU-DISPLAY-FLD (5).
      *********************************************************
      *  FOR EACH CODE ADDED TO MSTORERM, AN ENTRY MUST ALSO  *
      *  BE ADDED IN THE FILE "RECEIPTS" WITH ALL COUNTER     *
      *  FIGURES INITIALIZED TO ZERO.                         *
      *********************************************************

           MOVE CORP-CODE                TO   R-CORP-CODE.
           MOVE 0                        TO   SUB.

       62-INITIALIZE-RECEIPTS.
           MOVE "62-IR"                  TO   BU-DISPLAY-FLD (5).
           ADD 1 TO SUB.
           IF SUB > 14
               GO TO 62-LOCK-RECEIPTS.
           MOVE 0 TO R-MTH-RECEIPTS(SUB).
           GO TO 62-INITIALIZE-RECEIPTS.

       62-LOCK-RECEIPTS.
           MOVE "62-LR"                  TO   BU-DISPLAY-FLD (5).
           WRITE RECEIPTFIL-REC-O FROM RECEIPT-REC
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS = "22"
                NEXT SENTENCE
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE "WRITE ERR 62-LR"  TO BU-DISPLAY-MSG
               PERFORM 2-BLOWUP.

       62-A-M-X.
           EXIT.

       62-ADD-DESC-LINE.
           MOVE "62-ADL"                 TO   BU-DISPLAY-FLD (5).
           IF WS-CORPCODE NOT = HOLD-CODE
               MOVE SPACES                  TO  PRINT-RCD
               MOVE 1                       TO  LINE-ADV
               PERFORM 49-PRT-LINE
               MOVE WS-CORPCODE             TO  HOLD-CODE.

      *---------- WHEN ADDING A RAW MATERIAL OR FABRIC TO THE DATABASE,
      *           ALSO ADD THE ADJECTIVE (IE "ADAMAX") TO THE ALTERNATE
      *           KEY DATASET.

           IF WS-CORPCODE-R1-2 = "26"
               IF WS-RECD-DESC-ID = "00"
                   MOVE WS-RECD-DESC-ADJ   TO  ALT-KEY
                   MOVE WS-CORPCODE        TO  ALT-CORP-CODE
                   MOVE "AD"               TO  RET-CODE
                   CALL "TALTKEY" USING RET-CODE, BASE, STATUS-AREA,
                     ALT-KEY, ALT-CORP-CODE
                   IF RET-CODE NOT = "00"
                       DISPLAY "TALTKEY ERR A COND-WORD = ", COND-WORD,
                       " CODE = ", WS-CORPCODE.

      *---------- FOR RAW MATERIAL FABRICS, THE SECOND LINE OF
      *           DESCRIPTION CONTAINS THE ALTERNATE KEY.
      *           SINCE FOR RAW MATERIAL FABRICS THE ACTUAL ALTERNATE
      *           KEY COULD BE SEVERAL PLACES IN THE 2CD LINE OF DESC,
      *           A SPECIAL SUBPROGRAM IS CALLED TO DETERMINE THE
      *           ACTUAL ALT CODE.
      *---------- NOTE: NOW THAT MANUFACTURERS ARE IN "01" - "08",
      *---------- THE "SECOND LINE OF DESCRIPTION" IS NOW ID NUMBER
      *---------- "09".

           IF WS-CORPCODE-R1-2 = "27"
               IF WS-RECD-DESC-ID = "09"
                   MOVE WS-RECD-DESC-DETL  TO  FABRIC-DESC
                   CALL "TDETCODE" USING RET-CODE, FABRIC-DESC,
                     ALT-KEY
                   IF RET-CODE = "00"
                       MOVE WS-CORPCODE    TO  ALT-CORP-CODE
                       MOVE "AD"           TO  RET-CODE
                       CALL "TALTKEY" USING RET-CODE, BASE, STATUS-AREA,
                         ALT-KEY, ALT-CORP-CODE
                       IF RET-CODE NOT = "00"
                           DISPLAY "TALTKEY ERROR A COND-WORD = ",
                             COND-WORD, " CODE = ", WS-CORPCODE.

           IF SAVE-PRIM-LANG = "001"
               MOVE "DDESC;"             TO  DSET-NAME
           ELSE
               MOVE "DDESC2;"            TO  DSET-NAME.
           MOVE SPACES                   TO  BUF-DDESC.
           MOVE WS-CORPCODE              TO  CODE-ARG.

      *---------- IF WE ARE ADDING A "99" (LOCAL DESCRIPTION)
      *---------- PASSED FROM IBM, DELETE ANY EXISTING "99"
      *---------- RECORD.  (THE USERS MAY POSSIBLY ADD THEIR LOCAL
      *---------- DESCRIPTIONS VIA THE MAINFRAME).
           IF WS-RECD-DESC-ID = "99"
               PERFORM 6430-DELETE-99 THRU 6490-D9-X.

           MOVE WS-CORPCODE                 TO  DESC-CORP-CODE.
           MOVE WS-RECD-DESC-ID             TO  DESC-ID-NUM.
           MOVE WS-RECD-DESC-DETL           TO  DESC-DATA.
      *    CALL "DBPUT" USING BASE, DSET-NAME, MODE1, STATUS-AREA,
      *        ALL-ITEMS, BUF-DDESC.
           PERFORM 9330-PUT-DDESC.
           IF FILE-STATUS NOT = "00"
               MOVE "DBPUT ERR 62-ADL" TO BU-DISPLAY-MSG
               PERFORM 2-BLOWUP.

           MOVE SPACES            TO  CODE-PRINT-LINE.
           MOVE "ADD"             TO  PRT-CODE-ACTION.
           MOVE CODE-ARG          TO  PRT-CORPCODE.
           MOVE DESC-DATA         TO  PRT-DESC.
           MOVE CODE-PRINT-LINE   TO  PRINT-RCD.
           MOVE 1                 TO  LINE-ADV.
           PERFORM 49-PRT-LINE.

      *---------- IF A NON-AMERICAN LANGUAGE IS PRIMARY, AND IF IT IS
      *---------- A CORP-CODE ADD, ADD THE DESCRIPTION TO BOTH LANGUAGES.
      *---------- THIS IS SO THAT THERE WILL BE AT LEAST SOME DESCRIPTION IN
      *---------- THE PRIMARY LANGUAGE, IT CAN BE TRANSLATED LATER.
           IF WS-CORPCODE = SAVE-LAST-ADD
               IF SAVE-PRIM-LANG = "001"
                   NEXT SENTENCE
               ELSE
                   MOVE "DDESC;"         TO   DSET-NAME
      *            CALL "DBPUT" USING BASE, DSET-NAME, MODE1,
      *              STATUS-AREA, ALL-ITEMS, BUF-DDESC
                   PERFORM 9330-PUT-DDESC
                   IF FILE-STATUS NOT = "00"
                       MOVE "DBPUT ERR DDESC 62-ADL" TO BU-DISPLAY-MSG
                       PERFORM 2-BLOWUP.

       62-A-D-X.
           EXIT.

       63-UPD-AVG-COST.
           MOVE "63-UAC"                 TO   BU-DISPLAY-FLD (5).
           MOVE "MSTORERM;"              TO   DSET-NAME.
           MOVE WS-CORPCODE              TO   CODE-ARG.
      *    CALL "DBGET" USING BASE, DSET-NAME, MODE7, STATUS-AREA,
      *         ALL-ITEMS, BUF-MSTORERM, CODE-ARG.
           MOVE CODE-ARG TO CORPCDE OF MSTORERM-REC-O.
           READ MSTORERM-O INTO BUF-MSTORERM
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
             IF FILE-STATUS = "23"
               MOVE AKRON-WS-DATA           TO  PRT-DATA
               MOVE "  *CODE NOT ON FILE* PARA 63-UPD"  TO  PRT-MSG
               PERFORM 49-PRT-LINE
               GO TO 63-U-A-C-X
             ELSE
               MOVE "DBGET ERR MSTORERM 63-UAC" TO BU-DISPLAY-MSG
               PERFORM 2-BLOWUP.

           IF WS-AVG-CST-X = SPACES
               IF WS-LARGE-AVG-COST-X = SPACES
                   NEXT SENTENCE
               ELSE
                   MOVE STR-AVG-COST        TO  STR-PREV-AVG
                   MOVE WS-LARGE-AVG-COST   TO  STR-AVG-COST
           ELSE
               MOVE STR-AVG-COST            TO  STR-PREV-AVG
               MOVE WS-AVG-CST              TO  STR-AVG-COST.

           IF WS-STD-COST-X = SPACES
               IF WS-LARGE-STD-COST-X = SPACES
                   NEXT SENTENCE
               ELSE
                   MOVE WS-LARGE-STD-COST   TO  STR-STD-COST
           ELSE
               MOVE WS-STD-COST             TO  STR-STD-COST.

           IF WS-MTH-FCST-X NOT = SPACES
               MOVE WS-MTH-FCST             TO  STR-MTH-FCST.

      *    CALL "DBUPDATE" USING BASE DSET-NAME MODE1 STATUS-AREA
      *                          ALL-ITEMS BUF-MSTORERM.
           REWRITE MSTORERM-REC-O FROM BUF-MSTORERM
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE "DBUPDATE ERR 63-UAC" TO BU-DISPLAY-MSG
               PERFORM 2-BLOWUP.

       63-U-A-C-X.
           EXIT.

       6400-MANUFACT.
           MOVE "6400-MANUFACT"          TO   BU-DISPLAY-FLD (5).
           MOVE "MMANUFACT;"             TO  DSET-NAME.

           MOVE WS-MANUFACT              TO  MANUFACT-MAN-NAME.
      *    CALL "DBPUT" USING BASE, DSET-NAME, MODE1, STATUS-AREA,
      *      ALL-ITEMS, BUF-MMANUFACT.
           WRITE MMANUFACT-REC-O FROM BUF-MMANUFACT
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS = "00" OR "22"
               NEXT SENTENCE
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE "DBPUT ERR MMANUFACT 6400-M" TO BU-DISPLAY-MSG
               PERFORM 2-BLOWUP.

           MOVE WS-MANUFACT              TO   MAN-NAME.
           MOVE WS-MANUF-PART-TYPE-1     TO   MAN-PARTNO-TYPE.
           MOVE WS-MANUF-PART-NUMBER     TO   MAN-PARTNO.
           MOVE WS-CORPCODE              TO   MAN-CORPCODE.

      *---------- IF THIS IS A NEW CORP CODE, WE DONT NEED TO CHECK OLD
      *---------- MANUFACTURERS SINCE THERE WEREN'T ANY.  THE DEFAULT FOR A
      *---------- NEW CORPORATE CODE IS TO HAVE ALL MANUFACTURERS SELECTED.
      *---------- THE DEFAULT FOR AN OLD CORPORATE CODE IS TO HAVE ANY NEW
      *---------- MANUFACTURERS ADDED TO THAT OLD CODE BE "NOT SELECTED".
           IF WS-CORPCODE = SAVE-LAST-ADD
               MOVE "B"                  TO   MAN-PARTNO-SELECT
           ELSE
               PERFORM 6420-CHECK-OLD-MANUFACT THRU 6429-COM-X.

      *    CALL "DBPUT" USING BASE, DSET-NAME, MODE1, STATUS-AREA,
      *      ALL-ITEMS, BUF-DMANPART.
           WRITE DMANPART-C-REC-O FROM BUF-DMANPART
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE "DBPUT ERR DMANPART 6400-M" TO BU-DISPLAY-MSG
               PERFORM 2-BLOWUP.

           MOVE SPACES                   TO   CODE-PRINT-LINE.
           MOVE "MNF"                    TO   PRT-CODE-ACTION.
           MOVE CODE-ARG                 TO   PRT-CORPCODE.
           MOVE WS-RCD-DATA              TO   PRT-DESC.
           MOVE CODE-PRINT-LINE          TO   PRINT-RCD.
           MOVE 1                        TO   LINE-ADV
           PERFORM 49-PRT-LINE.

       6410-M-X.
           EXIT.
      *---------- THE USER CAN SELECT CERTAIN MANUFACTURERS TO APPEAR ON
      *---------- DESCRIPTIONS BY CODE.  THIS DATA MUST BE SAVED
       6420-CHECK-OLD-MANUFACT.
           MOVE 0                        TO   SUB.
           MOVE "N"                      TO   MAN-FOUND-FLAG.
       6422-CHECK-MANUFACT-LOOP.
           ADD 1                         TO   SUB.
      *---------- THE TABLE IS NOT CLEARED OUT FOR EACH CODE, BUT THE
      *---------- NUMBER OF ENTRIES IS SAVED FOR EACH CODE, ENSURING THAT
      *---------- WE DONT PICK UP DATA FROM A PREVIOUS CODE.
           IF SUB > MAN-TABLE-LIMIT
               GO TO 6425-CHECK-FOUND-FLAG.
           IF MAN-NAME = SAVE-MAN-NAME (SUB)
               NEXT SENTENCE
           ELSE
               GO TO 6422-CHECK-MANUFACT-LOOP.

           MOVE "Y"                      TO   MAN-FOUND-FLAG.
           MOVE SAVE-PARTNO-SELECT (SUB) TO   MAN-PARTNO-SELECT.

       6425-CHECK-FOUND-FLAG.
      *---------- IF THIS IS A NEW MANUFACTURER FOR AN OLD CODE, THE SELECTION
      *---------- KEY DEFAULTS TO SPACES - NOT SELECTED
           IF MAN-FOUND-FLAG = "N"
               MOVE SPACES               TO   MAN-PARTNO-SELECT.

       6429-COM-X.
           EXIT.

       6430-DELETE-99.
      *------ NOTE: IN IBM WE CAN GET LINE 99 DIRECTLY SINCE THE
      *------ DESC-ID-NUM IS PART OF THE KEY BECAUSE IT WAS A SORT ITEM
           MOVE "6430-D9"                TO   BU-DISPLAY-FLD (5).
           IF DSET-NAME = "DDESC;"
               MOVE CODE-ARG TO CORPCDE OF DDESC-REC-O
               MOVE "99" TO DESCIDNUM OF DDESC-REC-O
               READ DDESC-O INTO BUF-DDESC
                   INVALID KEY MOVE FILE-STATUS TO FILE-STATUS
               END-READ
               IF FILE-STATUS NOT = "00"
                   GO TO 6490-D9-X
               END-IF
               DELETE DDESC-O
                 INVALID KEY MOVE FILE-STATUS TO FILE-STATUS
               END-DELETE
               IF FILE-STATUS NOT = "00"
                   MOVE "DELETE DDESC 99 ERROR" TO BU-DISPLAY-MSG
                   PERFORM 2-BLOWUP
               END-IF
           ELSE
               MOVE CODE-ARG TO CORPCDE OF DDESC2-REC-O
               MOVE "99" TO DESCIDNUM OF DDESC2-REC-O
               READ DDESC2-O INTO BUF-DDESC
                   INVALID KEY MOVE FILE-STATUS TO FILE-STATUS
               END-READ
               IF FILE-STATUS NOT = "00"
                   GO TO 6490-D9-X
               END-IF
               DELETE DDESC2-O
                 INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
               IF FILE-STATUS NOT = "00"
                   MOVE "DELETE DDESC2 99 ERROR" TO BU-DISPLAY-MSG
                   PERFORM 2-BLOWUP.

           MOVE SPACES        TO  CODE-PRINT-LINE.
           MOVE "DEL"         TO  PRT-CODE-ACTION.
           MOVE CODE-ARG      TO  PRT-CORPCODE.
           MOVE DESC-DATA     TO  PRT-DESC.
           MOVE CODE-PRINT-LINE TO PRINT-RCD.
           MOVE 1             TO  LINE-ADV.
           PERFORM 49-PRT-LINE.

       6490-D9-X.
           EXIT.

      ************************************************************
      **               TRANSACTION 50
      ************************************************************
      **  TRANSACTION 50 UPDATES THE STR-ONHAND AND
      **  STR-LOC-ONHAND (1) FIELDS OF MSTORERM FOR CHEMICALS.
      **  THIS TRANSACTION IS SUPPLIED BY THE IBM PROGRAM
      **  P7204 THROUGH AKRON-FILE.  P7204 RECEIVES INPUT
      **  FROM THE AKRON ASPICS SYSTEM.           LS BAKER
      ************************************************************


       65-UPD-CHEM-ONHAND.
           MOVE "65-UCO"                 TO   BU-DISPLAY-FLD (5).
           IF BACKOUT-FLAG = "Y"
               MULTIPLY WS-CHEM-QTY-ISSUED BY -1
                 GIVING WS-CHEM-QTY-ISSUED.

           ACCEPT YMD-DATE FROM DATE.
           MOVE MM TO HP-MM.
           MOVE DD TO HP-DD.
           MOVE YY TO HP-YY.
           MOVE "MSTORERM;"              TO   DSET-NAME.
           MOVE WS-CORPCODE              TO   CODE-ARG.
           MOVE SPACES                   TO   FORMAT-CHEM-PRT-DATA.
           MOVE 2                        TO   ERR-CTL.
           MOVE WS-PLT                   TO   FC-PLT.
           MOVE WS-CORPCODE              TO   FC-CORPCODE.
           MOVE WS-CHEM-QTY-ISSUED       TO   FC-QTY-ISSUED.

      *    CALL "DBGET" USING    BASE
      *                          DSET-NAME
      *                          MODE7
      *                          STATUS-AREA
      *                          ALL-ITEMS
      *                          BUF-MSTORERM
      *                          CODE-ARG.
           MOVE CODE-ARG TO CORPCDE OF MSTORERM-REC-O.
           READ MSTORERM-O INTO BUF-MSTORERM
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "23"
                   MOVE FORMAT-CHEM-PRT-DATA TO RAW-BATCH-ERR-DATA
                   MOVE "*CORPCODE NOT ON HP FILE* 65-UCO"
                       TO RAW-BATCH-ERR-MSG
                   WRITE RAW-BATCH-ERR-RCD
                   GO TO 65-UCO-X
               ELSE
                   MOVE "DBGET ERR MSTORERM 65-UCO" TO BU-DISPLAY-MSG
                   PERFORM 2-BLOWUP.

           MOVE STR-ONHAND                  TO  SAVE-ONHAND-BEFORE.

           IF STR-UM = "LB" OR "EA"
               NEXT SENTENCE
           ELSE
               IF STR-UM = "GL"
                   IF STR-UM1 = "LB"
                       MULTIPLY STR-UM1-CF  BY  WS-CHEM-QTY-ISSUED
                   ELSE
                       IF STR-UM2 = "LB"
                           MULTIPLY STR-UM2-CF BY WS-CHEM-QTY-ISSUED
                       ELSE
                           PERFORM 92-RM-GET-ADJ  THRU  92-EXIT
                           MOVE FORMAT-CHEM-PRT-DATA
                               TO RAW-BATCH-ERR-DATA
                           MOVE "*STR-UM=GL,ALT-UM NOT=LB* 65-UCO" TO
                                                RAW-BATCH-ERR-MSG
                           WRITE RAW-BATCH-ERR-RCD
                           GO TO 65-UCO-X
               ELSE
                   PERFORM 92-RM-GET-ADJ  THRU  92-EXIT
                   MOVE FORMAT-CHEM-PRT-DATA TO RAW-BATCH-ERR-DATA
                   MOVE "*STR-UM NOT = LB,EA,GL  * 65-UCO"
                       TO RAW-BATCH-ERR-MSG
                   WRITE RAW-BATCH-ERR-RCD
                   GO TO 65-UCO-X.

           IF WS-CHEM-QTY-ISSUED > STR-ONHAND
               MOVE "Y"                     TO  ONHAND-ERROR-SW
               PERFORM 92-RM-GET-ADJ      THRU  92-EXIT
               MOVE FORMAT-CHEM-PRT-DATA    TO  RAW-BATCH-ERR-DATA
               MOVE "*ISSUE-QTY > STR-ONHAND * 65-UCO"
                   TO RAW-BATCH-ERR-MSG
               WRITE RAW-BATCH-ERR-RCD
               GO TO 65-UNLOCK-MSTORERM.

           IF WS-CHEM-QTY-ISSUED > STR-LOC-ONHAND (1)
               MOVE "Y"                     TO  ONHAND-ERROR-SW
               PERFORM 92-RM-GET-ADJ      THRU  92-EXIT
               MOVE FORMAT-CHEM-PRT-DATA    TO  RAW-BATCH-ERR-DATA
               MOVE "*ISSUE-QTY > LOC1-ONHAND* 65-UCO"
                   TO RAW-BATCH-ERR-MSG
               WRITE RAW-BATCH-ERR-RCD
               GO TO 65-UNLOCK-MSTORERM.

           IF INVALID-DATE = "Y"
               PERFORM 92-RM-GET-ADJ      THRU  92-EXIT
               MOVE FORMAT-CHEM-PRT-DATA    TO  RAW-BATCH-ERR-DATA
               MOVE "*INVALID PROD DATE-NOT PROCESSED"
                   TO RAW-BATCH-ERR-MSG
               WRITE RAW-BATCH-ERR-RCD
               GO TO 65-UNLOCK-MSTORERM.

      *------ PLANT STARTUP DETERMINES WHAT CHARGE DEPT WILL BE USED
      *------ FOR AUTOMATIC WITHDRAWALS.  IF THE PLANT STARTUP ENTRY IS
      *------ BLANK, WE USE THE DEFAULT DEPARTMENT FOR THAT CODE.  ALSO,
      *------ PLANT STARTUP REQUESTING DEPT IS BLANK, DEFAULT TO CHARGE.
           IF HOLD-CHARGE-DEPT = SPACES
               MOVE STR-DFLT-DEPT        TO   ACTUAL-CHARGE-DEPT
           ELSE
               MOVE HOLD-CHARGE-DEPT     TO   ACTUAL-CHARGE-DEPT.

           IF HOLD-REQ-DEPT = SPACES
               MOVE STR-DFLT-DEPT        TO   ACTUAL-REQ-DEPT
           ELSE
               MOVE HOLD-REQ-DEPT        TO   ACTUAL-REQ-DEPT.

           IF HOLD-EXP-CLASS = SPACES
               MOVE STR-EXPENSE-CLASS    TO   ACTUAL-EXP-CLASS
           ELSE
           IF HOLD-RM-EXP-OVERRIDE = "Y" AND STR-EXPENSE-CLASS > SPACES
               MOVE STR-EXPENSE-CLASS    TO   ACTUAL-EXP-CLASS
           ELSE
               MOVE HOLD-EXP-CLASS       TO   ACTUAL-EXP-CLASS.

           IF WS-CHEM-QTY-ISSUED > 0
               MOVE ACTUAL-CHARGE-DEPT   TO   STR-LAST-CHARGE
               MOVE YMD-DATE             TO   STR-LAST-IDATE
               IF YY > "70"
                   MOVE "19" TO STR-LAST-IDATE-CC
               ELSE
                   MOVE "20" TO STR-LAST-IDATE-CC.
           MOVE YMD-DATE                 TO   STR-ACT-DATE.
           IF YY > "70"
               MOVE "19" TO STR-ACT-DATE-CC
           ELSE
               MOVE "20" TO STR-ACT-DATE-CC.
           SUBTRACT WS-CHEM-QTY-ISSUED FROM STR-ONHAND,
             STR-LOC-ONHAND (1).

      *------ IF THE PLANT IS NOT LIVE ON BANBURY EXPLOSION UPDATES,
      *------ THEY STILL GET THE PRINTOUT (FOR TESTING PURPOSES).
           IF BANBURY-EXPLOSION-FLAG = "Y"
               NEXT SENTENCE
           ELSE
               GO TO  65-SAVE-PRINT.

           REWRITE MSTORERM-REC-O FROM BUF-MSTORERM
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE "DBUPDATE ERR 65-UCO" TO BU-DISPLAY-MSG
               PERFORM 2-BLOWUP.

       65-SAVE-PRINT.
           PERFORM 9-PRINT-RM-REPORT.

       65-UNLOCK-MSTORERM.
           IF ONHAND-ERROR-SW = "Y"
               MOVE "N" TO ONHAND-ERROR-SW
               GO TO 65-UCO-X.

           IF INVALID-DATE = "Y"
               GO TO 65-UCO-X.

           IF BANBURY-EXPLOSION-FLAG = "Y"
               NEXT SENTENCE
           ELSE
               GO TO 65-UCO-X.

       65-UPD-DDAILYTC.
           MOVE "65-UD"                  TO   BU-DISPLAY-FLD (5).

           MOVE SPACES                   TO   BUF-DDAILYTC.
           MOVE YMD-DATE                 TO   DDAILYTC-DATE.
           ACCEPT HOLD-TIME FROM TIME.
           MOVE HOLD-TIME TO DDAILYTC-TIME.
           MOVE WS-PLT                   TO   DDAILYTC-PLT.

      *------- THE BANBURY EXPLOSION ALLOWS ADJUSTMENTS TO PRODUCTION
      *------- AMOUNTS ON RAW BATCH REPORTING.  THUS A NEGATIVE QTY
      *------- CAN COME DOWN TO ADJUST OUT RAW MATERIAL AMOUNTS
      *------- IN THIS CASE CREATE A RETURN TRANSACTION.
           IF WS-CHEM-QTY-ISSUED < 0
             IF STR-AVG-COST > 99999.9999
               MOVE "430"                TO   DDAILYTC-TC
               MOVE CORP-CODE            TO   TC430-CORPCODE
               MOVE ACTUAL-CHARGE-DEPT   TO   TC430-DEPARTMENT
               MOVE SAVE-CHEM-PRODDTE    TO   TC430-WORK-ORDER
               MOVE ACTUAL-REQ-DEPT      TO   TC430-REQ-DEPT
               MOVE "PROD"               TO   TC430-EMP
               MULTIPLY WS-CHEM-QTY-ISSUED BY -1
                                       GIVING TC430-QTY
               MOVE STR-AVG-COST         TO   TC430-AVG-COST
               MOVE STR-UM               TO   TC430-UM
               MOVE ACTUAL-EXP-CLASS     TO   TC430-EXP-CLASS
               MOVE STR-CLASS            TO   TC430-CLASS
             ELSE
               MOVE "330"                TO   DDAILYTC-TC
               MOVE CORP-CODE            TO   TC330-CORPCODE
               MOVE ACTUAL-CHARGE-DEPT   TO   TC330-DEPARTMENT
               MOVE SAVE-CHEM-PRODDTE    TO   TC330-WORK-ORDER
               MOVE ACTUAL-REQ-DEPT      TO   TC330-REQ-DEPT
               MOVE "PROD"               TO   TC330-EMP
               MULTIPLY WS-CHEM-QTY-ISSUED BY -1
                                       GIVING TC330-QTY
               MOVE STR-AVG-COST         TO   TC330-AVG-COST
               MOVE STR-UM               TO   TC330-UM
               MOVE ACTUAL-EXP-CLASS     TO   TC330-EXP-CLASS
               MOVE STR-CLASS            TO   TC330-CLASS
           ELSE
           IF STR-AVG-COST > 99999.9999
               MOVE "433"                TO   DDAILYTC-TC
               MOVE CORP-CODE            TO   TC433-CORPCODE
               MOVE ACTUAL-CHARGE-DEPT   TO   TC433-DEPARTMENT
               MOVE SAVE-CHEM-PRODDTE    TO   TC433-WORK-ORDER
               MOVE ACTUAL-REQ-DEPT      TO   TC433-REQ-DEPT
               MOVE "PROD"               TO   TC433-EMP
               MOVE WS-CHEM-QTY-ISSUED   TO   TC433-QTY
               MOVE STR-AVG-COST         TO   TC433-AVG-COST
               MOVE STR-UM               TO   TC433-UM
               MOVE ACTUAL-EXP-CLASS     TO   TC433-EXP-CLASS
               MOVE STR-CLASS            TO   TC433-CLASS
           ELSE
               MOVE "333"                TO   DDAILYTC-TC
               MOVE CORP-CODE            TO   TC333-CORPCODE
               MOVE ACTUAL-CHARGE-DEPT   TO   TC333-DEPARTMENT
               MOVE SAVE-CHEM-PRODDTE    TO   TC333-WORK-ORDER
               MOVE ACTUAL-REQ-DEPT      TO   TC333-REQ-DEPT
               MOVE "PROD"               TO   TC333-EMP
               MOVE WS-CHEM-QTY-ISSUED   TO   TC333-QTY
               MOVE STR-AVG-COST         TO   TC333-AVG-COST
               MOVE STR-UM               TO   TC333-UM
               MOVE ACTUAL-EXP-CLASS     TO   TC333-EXP-CLASS
               MOVE STR-CLASS            TO   TC333-CLASS.

           MOVE "DDAILYTC;"              TO   DSET-NAME.

           WRITE DDAILYTC-REC-O FROM BUF-DDAILYTC
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE "DBPUT ERR DDAILYTC 65-UD" TO BU-DISPLAY-MSG
               PERFORM 2-BLOWUP.

      **************************************************************
      **   CALL "TREQFILU" TO DETERMINE WHETHER A REQUISITION     **
      **   UPDATE IS NEEDED, AND IF SO, TO UPDATE REQFILE.        **
      **   RET-CODE PARM OF "01" IS PASSED TELLING TREQFILU TO    **
      **   OPEN, THEN CLOSE REQFILE IF AN UPDATE IS DONE.         **
      **************************************************************

           MOVE STR-RESERVED             TO   SAVE-RESERVED-BEFORE.
           CALL "TREQFILU" USING RET-CODE, BASE, REQFILE-NUM, CODE-ARG
             SAVE-ONHAND-BEFORE, SAVE-RESERVED-BEFORE, STR-ONHAND,
             STR-RESERVED, STR-REORDER, STR-EXPEDITE.
           IF RET-CODE NOT = "00"
               DISPLAY "REQFILE UPDATE ERROR"
               DISPLAY "CODE = ", CODE-ARG
               DISPLAY "RET-CODE = ", RET-CODE
               MOVE "* REQFILE UPDATE ERROR *" TO RAW-BATCH-ERR-DATA
               MOVE CODE-ARG                   TO RAW-BATCH-ERR-MSG
               WRITE RAW-BATCH-ERR-RCD.

       65-UCO-X.
           EXIT.

       70-ADD-DVENDOR.
           MOVE "70-AD"                  TO   BU-DISPLAY-FLD (5).
      *-------- THE 08 LINE IS THE VENDOR ACTIVITY LINE, BUT IT ALSO HAS
      *-------- THE VENDOR COUNTRY.  THE 08 LINE IS AUTOMATICALLY ADDED
      *-------- ON THE "00" RECORD (FOR BOTH VEN ADD AND VEN MODIFY).
      *-------- SO IF AN 08 IS PASSED FROM MAINFRAME, PERFORM ROUTINE TO FIND
      *-------- THAT 08 LINE AND UPDATE IT WITH THE COUNTRY PASSED FROM MAINFRAM
           IF WS-VEN-ITM-NO = "08"
               PERFORM 74-FIND-UPDATE-VEN-08 THRU 749-FUV08-X
               IF FILE-STATUS = "23"
                   NEXT SENTENCE
               ELSE
                   GO TO 70-A-D-X.

      *-------- THE 09 LINE IS THE VENDOR PHONE AND CONTACT.  WHEN A VENDOR CHAN
      *-------- IS PASSED FROM THE MAINFRAME THE '09' LINE IS NOT ALWAYS INCLUDE
      *-------- SO WHEN THE '09' LINE IS PASSED, PERFORM ROUTINE TO FIND IT  AND
      *-------- IF FOUND UPDATE IT WITH THE INFO PASSED FROM THE MAINFRAME.
      *-------- IF THE '09' LINE IS NOT FOUND, THEN ADD THE INFO.
           IF WS-VEN-ITM-NO = "09"
               PERFORM 75-FIND-UPDATE-VEN-09 THRU 759-FUV09-X
               IF ADD-VEN-09 = "Y"
                   NEXT SENTENCE
               ELSE
                   GO TO 70-A-D-X.


       70-ADD-DVENDOR-08 .
      *---------- THIS PARAGRAPH IS EXECUTED WHEN WE WISH TO ADD THE 08
      *---------- VENDOR LINE FROM WITHIN THE PROGRAM, AS OPPOSED TO HAVING
      *---------- IT PASSED FROM THE MAINFRAME.
           MOVE "DVENDOR;"      TO DSET-NAME.
           MOVE SPACES          TO BUF-DVENDOR.
           MOVE WS-VEN-CODE     TO VEN-CODE.
           MOVE WS-VEN-ITM-NO   TO VEN-ITM-NO.
           MOVE WS-VEN-ITM-DATA TO VEN-ITM-DATA.
      *    CALL "DBPUT" USING BASE DSET-NAME MODE1 STATUS-AREA
      *        ALL-ITEMS BUF-DVENDOR.
           WRITE DVENDOR-REC-O FROM BUF-DVENDOR
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE "DBPUT ERR 70-AD" TO BU-DISPLAY-MSG
               PERFORM 2-BLOWUP.


           IF VEN-ITM-NO = "08"
               GO TO 70-A-D-UNLOCK.

           MOVE SPACES            TO  VENDOR-PRINT-LINE.
           MOVE "ADD"             TO  PRT-VENDOR-ACTION.
           MOVE VEN-CODE          TO  PRT-VENCODE.
           MOVE VEN-ITM-DATA      TO  PRT-VEN-ADDR.
           MOVE VENDOR-PRINT-LINE TO  PRINT-RCD.
           MOVE 1                 TO  LINE-ADV.
           PERFORM 49-PRT-LINE.

       70-A-D-UNLOCK.
           MOVE "70-ADU"                 TO   BU-DISPLAY-FLD (5).
           IF VEN-ITM-NO = "09"
               MOVE SPACES   TO  PRINT-RCD
               MOVE 1        TO  LINE-ADV
               PERFORM 49-PRT-LINE.

           IF VEN-ITM-NO = "00"
               MOVE WS-VEN-CODE          TO   KVENCDE
               MOVE WS-VEN-ITM-DATA      TO   KVENNAME
               WRITE KVENDOR-RECORD
                   INVALID KEY MOVE "Y"  TO   DUMMY-FIELD.

       70-A-D-X.
           EXIT.

       71-DLT-VENDOR.
           MOVE "71-DV"                  TO   BU-DISPLAY-FLD (5).
      *--------- DELETE OF A VENDOR FROM THE MAINFRAME IS NOT ALLOWED.
      *--------- A PRINTOUT IS DONE SO THAT THE USER MAY MANUALLY
      *--------- DELETE THE VENDOR IF DESIRED.
           MOVE SPACES                   TO   VENDOR-PRINT-LINE.
           MOVE "DEL"                    TO   PRT-VENDOR-ACTION.
           MOVE WS-VEN-CODE              TO   PRT-VENCODE.
           MOVE MANUAL-VEN-DEL-MSG       TO   PRT-VEN-ADDR.
           MOVE VENDOR-PRINT-LINE        TO   PRINT-RCD.
           MOVE 1                        TO   LINE-ADV.
           PERFORM 49-PRT-LINE.
           MOVE SPACES                   TO   PRINT-RCD.
           PERFORM 49-PRT-LINE.
           GO TO 71-D-V-X.

       71-D-V-X.
           EXIT.

       715-FIND-DVENDOR.
           MOVE "715-FD"                 TO   BU-DISPLAY-FLD (5).
           MOVE "DVENDOR;" TO DSET-NAME.
      *    CALL "DBFIND" USING BASE DSET-NAME MODE1 STATUS-AREA
      *        VEN-SEARCH VEN-ARG.
           MOVE VEN-ARG TO VENCDE OF DVENDOR-REC-O.
           START DVENDOR-O KEY = VENCDE OF DVENDOR-REC-O
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF (FILE-STATUS NOT = "00") AND (FILE-STATUS-1 NOT = "2")
               MOVE "DBFIND ERR 715-FD" TO BU-DISPLAY-MSG
               PERFORM 2-BLOWUP.

       716-GET-DELETE-DVENDOR.
      *    CALL "DBGET" USING BASE DSET-NAME MODE5 STATUS-AREA
      *        ALL-ITEMS BUF-DVENDOR VEN-ARG.
           MOVE 0 TO COND-WORD.
           READ DVENDOR-O NEXT INTO BUF-DVENDOR
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   MOVE 15 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.
           IF VENCDE OF DVENDOR-REC-O NOT = VEN-ARG
               MOVE 15 TO COND-WORD.
           IF COND-WORD = 15
               GO TO 716-UNLOCK
           ELSE
           IF COND-WORD NOT = 0
               MOVE "DBGET ERR DVENDOR 716-GDD" TO BU-DISPLAY-MSG
               PERFORM 2-BLOWUP.

      **************************************************************
      **IF A VENDOR CHANGE (TC=72), ONLY DVENDOR LINES 00-08 ARE
      **DELETED.  ELSE IF VENDOR DELETE, ALL VENDOR LINES DELETED
      **************************************************************
           IF WS-TC = "72" AND VEN-ITM-NO > "08"
               GO TO 716-UNLOCK.

      *    CALL "DBDELETE" USING BASE DSET-NAME MODE1 STATUS-AREA.
           DELETE DVENDOR-O
             INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE "DBDELETE ERR 716-GDD" TO BU-DISPLAY-MSG
               PERFORM 2-BLOWUP.

           MOVE SPACES            TO  VENDOR-PRINT-LINE.
           MOVE "DEL"             TO  PRT-VENDOR-ACTION.
           MOVE VEN-CODE          TO  PRT-VENCODE.
           MOVE VEN-ITM-DATA      TO  PRT-VEN-ADDR.
           MOVE VENDOR-PRINT-LINE TO  PRINT-RCD.
           MOVE 1                 TO  LINE-ADV.
           PERFORM 49-PRT-LINE.
           MOVE SPACES            TO  PRINT-RCD.
           PERFORM 49-PRT-LINE.

           GO TO 716-GET-DELETE-DVENDOR.
       716-UNLOCK.

           MOVE SPACES            TO  PRINT-RCD.
           MOVE 1                 TO  LINE-ADV.
           PERFORM 49-PRT-LINE.

           MOVE WS-VEN-CODE              TO   KVENCDE.
           MOVE WS-VEN-ITM-DATA          TO   KVENNAME.
           PERFORM 9976-DELETE-KVENDOR THRU 9979-DK-X.
       716-U-X.
           EXIT.

       73-CALCULATED-GET-AVENDCODE.
           MOVE WS-VEN-CODE                 TO VEN-ARG.
           MOVE VEN-ARG TO VENCDE OF DVENDOR-REC-O.
           START DVENDOR-O KEY = VENCDE OF DVENDOR-REC-O
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS-1 = "2"
               MOVE "N"                  TO  VENDOR-EXISTS-FLAG
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE "DBFIND ERR 73-CGA"  TO  BU-DISPLAY-MSG
               PERFORM 2-BLOWUP
           ELSE
               MOVE "Y"  TO  VENDOR-EXISTS-FLAG.

       74-FIND-UPDATE-VEN-08.
           MOVE "74-FUV08"               TO   BU-DISPLAY-FLD (5).
      *---------- THE 08 ACTIVITY DATE LINE ALWAYS EXISTS FOR A VENDOR.
      *---------- FIND IT AND UPDATE THE VENDOR-COUNTRY PASSED FROM MAINFRAME.
           MOVE WS-VEN-CODE              TO   VEN-ARG.
           MOVE VEN-ARG TO VENCDE OF DVENDOR-REC-O.
           MOVE "08" TO VENITMNO OF DVENDOR-REC-O.
           READ DVENDOR-O INTO BUF-DVENDOR
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS = "23"
               GO TO 749-FUV08-X
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE "DBFIND ERR DVENDOR 74-FUV08" TO BU-DISPLAY-MSG
               PERFORM 2-BLOWUP.

           MOVE WS-VEN-ITM-DATA-7-44     TO   VEN-ITM-DATA-7-44.
      *    CALL "DBUPDATE" USING BASE, DSET-NAME, MODE1,
      *      STATUS-AREA, ALL-ITEMS, BUF-DVENDOR.
           REWRITE DVENDOR-REC-O FROM BUF-DVENDOR
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE "DBUPDATE ERR 741-GV08L" TO BU-DISPLAY-MSG
               PERFORM 2-BLOWUP.

       749-FUV08-X.
           EXIT.

       75-FIND-UPDATE-VEN-09.
           MOVE "75-FUV09"               TO   BU-DISPLAY-FLD (5).
      *---------- THE 09 VENDOR PHONE AND CONTACT IS HANDLED DIFFERENTLY
      *---------- BECAUSE FOR A VENDOR CHANGE THIS LINE MAY NOT BE PASSED
      *---------- FROM THE MAINFRAME.
           MOVE WS-VEN-CODE              TO   VEN-ARG.
           MOVE VEN-ARG TO VENCDE OF DVENDOR-REC-O.
           MOVE "09" TO VENITMNO OF DVENDOR-REC-O.
           READ DVENDOR-O INTO BUF-DVENDOR
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS = "23"
               MOVE "Y"                  TO   ADD-VEN-09
               GO TO 759-FUV09-X
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE "DBFIND ERR DVENDOR 75-FUV09" TO BU-DISPLAY-MSG
               PERFORM 2-BLOWUP.

           MOVE "N"                      TO   ADD-VEN-09.
           MOVE WS-VEN-ITM-DATA          TO   VEN-ITM-DATA.
      *    CALL "DBUPDATE" USING BASE, DSET-NAME, MODE1,
      *      STATUS-AREA, ALL-ITEMS, BUF-DVENDOR.
           REWRITE DVENDOR-REC-O FROM BUF-DVENDOR
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE "DBUPDATE ERR 751-GV09L" TO BU-DISPLAY-MSG
               PERFORM 2-BLOWUP.

       759-FUV09-X.
           EXIT.


      ***********************************************************
      **           TRANSACTIONS 80 AND 81
      ***********************************************************
      **  TRANSACTION 80 REPRESENTS THE DELETION OF ACCOUNTING
      **  DATA FROM MVALIDPLTDATA.  TRANSACTION 81 REPRESENTS
      **  THE ADDITION OF ACCOUNTING DATA TO MVALIDPLTDATA.
      **  THESE TRANSACTIONS ARE SUPPLIED TO THE HP PROGRAM
      **  AKRUPDT FROM THE AKRON ACCOUNTS PAYABLE SYSTEM
      **  THROUGH AKRON-FILE.  ACCOUNTING DATA CONSISTS OF
      **  NEW WORK ORDER NUMBERS, EXPENSE CLASSES, AND
      **  DEPARTMENTS CHARGED.         LS BAKER
      ***********************************************************

       80-DELETE-ACCT-DATA.
           IF WS-ACCT-DATA-KEY = SPACES
               GO TO 80-DAD-X.
           MOVE "MVALIDPLTDATA;"  TO  DSET-NAME.
           MOVE WS-ACCT-DATA-KEY  TO  ACCT-DATA-ARG.

           MOVE ACCT-DATA-ARG TO VALDTAKEY OF MVALIDPLTDATA-REC-O.
           READ MVALIDPLTDATA-O INTO BUF-MVALIDPLTDATA
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS = "00"
               NEXT SENTENCE
           ELSE
               IF FILE-STATUS = "23"
                   MOVE AKRON-WS-DATA TO PRT-DATA
                   MOVE " *DATA NOT ON FILE* 80-ACCT" TO PRT-MSG
                   PERFORM 49-PRT-LINE
                   GO TO 80-DAD-X
               ELSE
                   MOVE "DBGET ERR MVALIDPLTDATA 80-DAD"
                     TO  BU-DISPLAY-MSG
                   PERFORM 2-BLOWUP.

           DELETE MVALIDPLTDATA-O
             INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE "DBDELETE ERR 80-DAD" TO BU-DISPLAY-MSG
               PERFORM 2-BLOWUP.

       80-DAD-X.
           EXIT.

       81-ADD-ACCT-DATA.
           IF WS-ACCT-DATA-KEY = SPACES
               GO TO 81-AAD-X.

           IF WS-ACCT-DATA-ID = "DP" OR "EC" OR "NW"
               NEXT SENTENCE
           ELSE
               MOVE AKRON-WS-DATA TO PRT-DATA
               MOVE " *INVALID ID* 81-ACCT" TO PRT-MSG
               PERFORM 49-PRT-LINE
               GO TO 81-AAD-X.

           MOVE "MVALIDPLTDATA;"  TO  DSET-NAME.
           MOVE SPACES            TO  BUF-MVALIDPLTDATA.
           MOVE WS-ACCT-DATA-KEY  TO  VALID-DATA-KEY.

           WRITE MVALIDPLTDATA-REC-O FROM BUF-MVALIDPLTDATA
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS = "00"
               NEXT SENTENCE
           ELSE
               IF FILE-STATUS = "22"
                   MOVE AKRON-WS-DATA TO PRT-DATA
                   MOVE " *DATA EXISTS* 81-ACCT" TO PRT-MSG
                   PERFORM 49-PRT-LINE
               ELSE
                   MOVE "DBPUT ERR 81-AAD" TO BU-DISPLAY-MSG
                   PERFORM 2-BLOWUP.

       81-AAD-X.
           EXIT.

       88-ADD-INT-REQ.
           IF REQ-RPT-FILE-OPEN-SW = "N"
               MOVE "Y"                  TO  REQ-RPT-FILE-OPEN-SW
               OPEN OUTPUT REQ-REPORT-FILE
               MOVE 1                    TO  DATE-MODE
               CALL "TDATECHK" USING DATE-CHECK-AREA
               MOVE DATE-SLASH-OUT       TO  PRT-REQ-DT-HD
               MOVE DATE-FORMATTED-TIME-OUT TO PRT-REQ-TM-HD
               PERFORM 881-REQ-HEADERS.

           MOVE WS-REQUISITION           TO  MREQ-NUMBER.
           MOVE WS-REQ-DATE              TO  REQ-DATE.
           IF REQ-DATE-YY > "70"
               MOVE "19" TO REQ-DATE-CC
           ELSE
               MOVE "20" TO REQ-DATE-CC.

           MOVE SPACES TO REQ-REL-MC-DATE-CN,
             REQ-RCV-DEPT, REQ-FOR-DEPT, REQ-DATE-WANTED-CN,
             REQ-SHIP-DATE-CN, REQ-ACCT-INFO, REQ-BUDGET-NO,
             REQ-TERMS, REQ-ADDL-INFO, REQ-ORIGINATOR, REQ-FOB,
             REQ-HOLD-STATUS-CODE, REQ-HOLD-STATUS, REQ-STAGING-AREA,
             REQ-FLAGS, REQ-PAD.
           MOVE 0 TO REQ-BUDGET-AMT.
           MOVE "X "                     TO  REQ-RELEASE-STAT.
           MOVE "NI"                     TO  REQ-STATUS.

      *    CALL "DBPUT" USING BASE, DSET-MREQ, MODE1, STATUS-AREA,
      *      ALL-ITEMS, BUF-MREQ.
           WRITE MREQ-REC-O FROM BUF-MREQ
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS = "22"
               MOVE "* ERROR : REQUISITION ALREADY EXISTS *"
                 TO PRT-REQ-MSG
               PERFORM 882-PRINT-REQ
               PERFORM 884-WRITE-REQ-ERROR
               GO TO 88-AIR-X
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE "* DATABASE ERROR ON REQUISITION ADD *"
                 TO PRT-REQ-MSG
               PERFORM 882-PRINT-REQ
               PERFORM 884-WRITE-REQ-ERROR
               GO TO 88-AIR-X
           ELSE
               MOVE "* REQUISITION ADDED *" TO  PRT-REQ-MSG.

           PERFORM 882-PRINT-REQ.

           MOVE MREQ-NUMBER                 TO  REQITM-REQ-NUMBER.
           MOVE "INTERNATIONAL REQUISITION" TO  REQITM-NOTE.
           MOVE "NON-STR"                   TO  REQITM-CORP-CODE.
           MOVE ZERO                        TO  REQITM-QTY-TO-ORD,
                                                REQITM-UNIT-PRICE,
                                                REQITM-UNIT-PRICE-CURR,
                                                REQITM-BUDGET-AMT.
           MOVE SPACES                      TO  REQITM-UM,
                                                REQITM-NUMBER,
                                                REQITM-PRICE-UM,
                                                REQITM-SUB-DETL,
                                                REQITM-ADDTL-DATA,
                                                REQITM-SHIP-DATE-CN,
                                                REQITM-BUDGET-NO,
                                                REQITM-TERMS,
                                                REQITM-FOB,
                                                REQITM-TAX-CODE,
                                                REQITM-PAD.

      *    CALL "DBPUT" USING BASE, DSET-DREQITM, MODE1, STATUS-AREA,
      *      ALL-ITEMS, BUF-DREQITM.
           WRITE DREQITM-REC-O FROM BUF-DREQITM
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE "DBPUT ERR DREQITM" TO  PRT-REQ-MSG
               PERFORM 882-PRINT-REQ
               PERFORM 884-WRITE-REQ-ERROR
               GO TO 88-AIR-X.

           MOVE MREQ-NUMBER              TO  DREQD-REQ-NUMBER.
           MOVE SPACES TO DREQD-PO-RCV-NO, DREQD-VEN-CODE,
             DREQD-BUYER-CODE, REQD-PAD, DREQD-WO-NUMBER,
             DREQD-PO-ITM-NO, DREQD-WO-ITM-NO.
      *    CALL "DBPUT" USING BASE, DSET-DREQD, MODE1, STATUS-AREA,
      *      ALL-ITEMS, BUF-DREQD.
           WRITE DREQD-REC-O FROM BUF-DREQD
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE "DBPUT ERR DREQD"    TO  PRT-REQ-MSG
               PERFORM 882-PRINT-REQ
               PERFORM 884-WRITE-REQ-ERROR
               GO TO 88-AIR-X.

       88-AIR-X.
           EXIT.

       881-REQ-HEADERS.
           MOVE 0                        TO  REQ-CTL.
           ADD 1                         TO  REQ-RPT-PAGE-COUNT.
           MOVE REQ-RPT-PAGE-COUNT       TO  PRT-REQ-PAGE.
           MOVE REQ-RPT-HD1              TO  REQ-LINE.
           WRITE REQ-REPORT-RCD.
           MOVE 2                        TO  REQ-CTL.
           MOVE REQ-RPT-HD2              TO  REQ-LINE.
           WRITE REQ-REPORT-RCD.
           MOVE 3                        TO  REQ-RPT-LINE-COUNT.
           MOVE 1                        TO  REQ-CTL.

       882-PRINT-REQ.
           MOVE 1                        TO  REQ-CTL.
           MOVE FILE-STATUS              TO  PRT-REQ-ERROR.
           MOVE 4                        TO  DATE-MODE.
           MOVE WS-REQ-DATE              TO  DATE-VALIDATE-IN.
           CALL "TDATECHK" USING DATE-CHECK-AREA.
           MOVE DATE-SLASH-OUT           TO  PRT-REQ-DATE.
           MOVE WS-REQUISITION           TO  PRT-REQ.
           MOVE PRT-REQ-DETAIL           TO  REQ-LINE.
           WRITE REQ-REPORT-RCD.
           ADD 1 TO  REQ-RPT-LINE-COUNT.
           IF REQ-RPT-LINE-COUNT > 55
               PERFORM 881-REQ-HEADERS.

       884-WRITE-REQ-ERROR.
           MOVE 1                        TO  REQ-CTL.
           MOVE COND-WORD                TO  REQ-ERROR-CODE,
                                             PRT-REQ-ERROR.
           MOVE 1                        TO  DATE-MODE.
           CALL "TDATECHK" USING DATE-CHECK-AREA.
           MOVE DATE-YMD-OUT             TO  REQ-ERROR-DATE.
           MOVE DATE-UNFORMATTED-TIME-OUT TO  REQ-ERROR-TIME.
           MOVE WS-REQUISITION           TO  REQ-ERROR-REQ.
           MOVE WS-REQ-DATE              TO  REQ-ERROR-REQ-DATE.
           MOVE PRT-REQ-MSG              TO  REQ-ERROR-MSG.
           MOVE REQ-ERROR-RCD            TO  AKRUPDT-ERROR-RCD.
           WRITE AKRUPDT-ERROR-RCD.
           DISPLAY "************** TAKRUPDT ERROR ***************".
           DISPLAY REQ-ERROR-RCD.

       9-PRINT-RM-REPORT.
           IF LINE-CTR GREATER THAN 51  OR
              PAGE-CTR = ZEROS
               PERFORM 91-RM-HEADINGS THRU 91-RMH-X

           MOVE SPACES                   TO   RM-PRINT-LINE.
           MOVE WS-CORPCODE              TO   RM-PRT-CORPCODE.
           MOVE STR-UM                   TO   RM-PRT-STR-UM.
           MOVE WS-CHEM-QTY-ISSUED       TO   RM-PRT-QTY-ISSUED.
           MOVE WS-CORPCODE              TO   CODE-ARG.
           IF BANBURY-EXPLOSION-FLAG = "Y"
               MOVE SPACES               TO   RM-PRT-TEST-INDIC
           ELSE
               MOVE "TEST RUN"           TO   RM-PRT-TEST-INDIC.
           PERFORM 92-RM-GET-ADJ   THRU  92-EXIT.
           MOVE FC-ADJ                   TO   RM-PRT-ADJ.
           MOVE 2                        TO   RPT-CTL.
           MOVE RM-PRINT-LINE            TO   RAW-BATCH-LINE.
           WRITE RAW-BATCH-RCD.
           ADD 2 TO LINE-CTR.

       9-PRMR-X.
           EXIT.

       91-RM-HEADINGS.
           ADD 1                      TO  PAGE-CTR.
           MOVE PAGE-CTR              TO  RM-PAGE-CNT.
           MOVE 0                     TO  RPT-CTL.
           MOVE RM-HEAD1              TO  RAW-BATCH-LINE.
           WRITE RAW-BATCH-RCD.
           MOVE 2                     TO  RPT-CTL.
           MOVE RM-HEAD2              TO  RAW-BATCH-LINE.
           WRITE RAW-BATCH-RCD.
           MOVE 2                     TO  RPT-CTL.
           MOVE RM-HEAD3              TO  RAW-BATCH-LINE.
           WRITE RAW-BATCH-RCD.
           MOVE 1                     TO  RPT-CTL.
           MOVE RM-HEAD4              TO  RAW-BATCH-LINE.
           WRITE RAW-BATCH-RCD.
           MOVE 1                     TO  RPT-CTL.
           MOVE RM-HEAD5              TO  RAW-BATCH-LINE.
           WRITE RAW-BATCH-RCD.
           MOVE 5                     TO LINE-CTR.

       91-RMH-X.
           EXIT.

       92-RM-GET-ADJ.
           MOVE "DDESC;"                    TO  DSET-NAME.
      *    CALL "DBFIND" USING BASE, DSET-NAME, MODE1, STATUS-AREA,
      *        SEARCH-ITEM, CODE-ARG.
           MOVE CODE-ARG TO CORPCDE OF DDESC-REC-I.
           START DDESC-I KEY = CORPCDE OF DDESC-REC-I
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF (FILE-STATUS NOT = "00") AND (FILE-STATUS-1 NOT = "2")
               GO TO 92-EXIT.

      *    CALL "DBGET" USING BASE, DSET-NAME, MODE5, STATUS-AREA,
      *        ALL-ITEMS, BUF-DDESC, CODE-ARG.
           READ DDESC-I NEXT INTO BUF-DDESC
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS = "00"
               MOVE DESC-MOD          TO  FC-ADJ.
       92-EXIT.
           EXIT.

       9300-FIND-DDESC.
           IF DSET-NAME = "DDESC;"
              MOVE CODE-ARG TO CORPCDE OF DDESC-REC-O
              START DDESC-O KEY = CORPCDE OF DDESC-REC-O
                  INVALID KEY MOVE FILE-STATUS TO FILE-STATUS
              END-START
              IF (FILE-STATUS NOT = "00") AND (FILE-STATUS-1 NOT = "2")
                  MOVE "START ERROR DDESC 9300-FD" TO BU-DISPLAY-MSG
                  PERFORM 2-BLOWUP
              ELSE
                  NEXT SENTENCE
           ELSE
              MOVE CODE-ARG TO CORPCDE OF DDESC2-REC-O
              START DDESC2-O KEY = CORPCDE OF DDESC2-REC-O
                  INVALID KEY MOVE FILE-STATUS TO FILE-STATUS
              END-START
              IF (FILE-STATUS NOT = "00") AND (FILE-STATUS-1 NOT = "2")
                  MOVE "START ERROR DDESC 9300-FD" TO BU-DISPLAY-MSG
                  PERFORM 2-BLOWUP.

       9310-GET-DDESC.
           IF DSET-NAME = "DDESC;"
               PERFORM 9311-GET-DDESC
           ELSE
               PERFORM 9312-GET-DDESC2.

       9311-GET-DDESC.
           MOVE 0 TO COND-WORD
           READ DDESC-O NEXT INTO BUF-DDESC
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   MOVE 15 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.
           IF CORPCDE OF DDESC-REC-O NOT = CODE-ARG
               MOVE 15 TO COND-WORD.

       9312-GET-DDESC2.
           MOVE 0 TO COND-WORD.
           READ DDESC2-O NEXT INTO BUF-DDESC
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   MOVE 15 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.
           IF CORPCDE OF DDESC2-REC-O NOT = CODE-ARG
               MOVE 15 TO COND-WORD.

       9320-DELETE-DDESC.
           IF DSET-NAME = "DDESC;"
               DELETE DDESC-O
                 INVALID KEY MOVE FILE-STATUS TO FILE-STATUS
               END-DELETE
               IF FILE-STATUS NOT = "00"
                   MOVE "DELETE ERR DDESC 9320-DD" TO BU-DISPLAY-MSG
                   PERFORM 2-BLOWUP
               END-IF
           ELSE
               DELETE DDESC2-O
                 INVALID KEY MOVE FILE-STATUS TO FILE-STATUS
               END-DELETE
               IF FILE-STATUS NOT = "00"
                   MOVE "DELETE ERR DDESC2 9320-DD" TO BU-DISPLAY-MSG
                   PERFORM 2-BLOWUP.

       9330-PUT-DDESC.
           IF DSET-NAME = "DDESC;"
               WRITE DDESC-REC-O FROM BUF-DDESC
                   INVALID KEY MOVE FILE-STATUS TO FILE-STATUS
               END-WRITE
               IF FILE-STATUS NOT = "00"
                   MOVE "WRITE ERR DDESC 9330-PD" TO BU-DISPLAY-MSG
                   PERFORM 2-BLOWUP
               END-IF
           ELSE
               WRITE DDESC2-REC-O FROM BUF-DDESC
                   INVALID KEY MOVE FILE-STATUS TO FILE-STATUS
               END-WRITE
               IF FILE-STATUS NOT = "00"
                   MOVE "WRITE ERR DDESC2 9330-PD" TO BU-DISPLAY-MSG
                   PERFORM 2-BLOWUP.
      **************************************************************
      **                  TRANSACTION 99                          **
      **************************************************************
      **  TRANSACTION 99 RECORD SUPPLIES TRANS-CODE, PLANT CODE,  **
      **  CORP-CODE, AND QUANTITY.                                **
      **  THIS TRANS WAS DEVELOPED FOR GADSDEN   START-UP.  IT    **
      **  PROVIDES A WAY TO UPDATE ONHANDS FOR LIVE STARTUP.      **
      **                                            ATL.          **
      **************************************************************

       99-UPDATE-ONHAND.
           IF WS-QTY NUMERIC
               NEXT SENTENCE
           ELSE
               MOVE AKRON-WS-DATA      TO  PRT-DATA
               MOVE "*QTY NOT NUMERIC*99-UPDATE*"  TO  PRT-MSG
               PERFORM  49-PRT-LINE
               GO TO 99-UP-X.

           MOVE "MSTORERM;"   TO  DSET-NAME.
           MOVE WS-CORPCODE    TO  CODE-ARG.

           MOVE CODE-ARG TO CORPCDE OF MSTORERM-REC-O.
           READ MSTORERM-O INTO BUF-MSTORERM
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS = "00"
               NEXT SENTENCE
           ELSE
               IF FILE-STATUS = "23"
                   MOVE AKRON-WS-DATA    TO  PRT-DATA
                   MOVE "*CORPCODE NOT ON HP FILE* 99-UP*"  TO  PRT-MSG
                   PERFORM  49-PRT-LINE
                   GO TO 99-UP-X
               ELSE
                   MOVE "DBGET ERR 99-UO" TO BU-DISPLAY-MSG
                   PERFORM 2-BLOWUP.

           MOVE WS-QTY          TO  STR-ONHAND
                                    STR-LOC-ONHAND (1).

           REWRITE MSTORERM-REC-O FROM BUF-MSTORERM
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE "DBUPDATE ERR 99-UO" TO BU-DISPLAY-MSG
               PERFORM 2-BLOWUP.
       99-UP-X.
           EXIT.

       9976-DELETE-KVENDOR.
           READ KVENDOR-FILE
               INVALID KEY GO TO 9978-UNLOCK-KVENDOR.

           DELETE KVENDOR-FILE
               INVALID KEY MOVE "Y"  TO   DUMMY-FIELD.

       9978-UNLOCK-KVENDOR.
      *------- NO UNLOCK PROCESSING REQUIRED ON THE AS/400

       9979-DK-X.
           EXIT.
