000200 IDENTIFICATION DIVISION.
000300 PROGRAM-ID. TJPMAINT.
      *C
      *C  01/04/2010  CA YODER  2010-00142425-001
      *C     UPDATE LOGIC ASSIGNING WORKORDER LETTER SUFFIX.
      *C
000400 ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.
       SOURCE-COMPUTER. AS400.
       OBJECT-COMPUTER. AS400.
       SPECIAL-NAMES. I-O-FEEDBACK IS I-O-FEEDBACK-AREA.
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT DISPLAY-FILE
               ASSIGN TO WORKSTATION-ZJPMAINT-SI
               ORGANIZATION IS TRANSACTION
               FILE STATUS IS DSPLY-STATUS
               CONTROL-AREA IS WS-CONTROL.
           SELECT JOBPLAN-LF1
               ASSIGN TO DATABASE-MCFLMM1801
               ORGANIZATION IS INDEXED
               ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                   WITH DUPLICATES
               FILE STATUS IS JOBPLAN-STATUS.
           SELECT JOBPLAN-LF2
               ASSIGN TO DATABASE-MCFLMM1801
               ORGANIZATION IS INDEXED
               ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
               FILE STATUS IS JOBPLAN-STATUS-2.
           SELECT PLANNED-LF1
               ASSIGN TO DATABASE-MCFLMM1101
               ORGANIZATION IS INDEXED
               ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
               FILE STATUS IS PLANNED-STATUS.
           SELECT PLANNED-LF2
               ASSIGN TO DATABASE-MCFLMM1101
               ORGANIZATION IS INDEXED
               ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
               FILE STATUS IS PLANNED-STATUS.
           SELECT WO-LAST-NUM-USED
               ASSIGN TO DATABASE-MCFPMM0800
               ORGANIZATION IS RELATIVE
               ACCESS MODE IS RANDOM
               RELATIVE KEY IS ARG-NO.
000500 DATA DIVISION.
       FILE SECTION.
       FD  DISPLAY-FILE
           LABEL RECORDS ARE OMITTED.
       01  DSPLY-REC                   PIC X(2000).
       FD  JOBPLAN-LF1
           LABEL RECORDS ARE STANDARD.
       01  JPLAN-LF1.
           COPY DDS-ALL-FORMATS OF MCFLMM1801.
       FD  JOBPLAN-LF2
           LABEL RECORDS ARE STANDARD.
       01  JPLAN-LF2.
           COPY DDS-ALL-FORMATS OF MCFLMM1801.
       FD  PLANNED-LF1
           LABEL RECORDS ARE STANDARD.
       01  WO-PLANNED-REC-LF1.
           COPY DDS-ALL-FORMATS OF MCFLMM1101.
       FD  PLANNED-LF2
           LABEL RECORDS ARE STANDARD.
       01  WO-PLANNED-REC-LF2.
           COPY DDS-ALL-FORMATS OF MCFLMM1101.
       FD  WO-LAST-NUM-USED
           LABEL RECORDS ARE STANDARD.
       01  WO-REC.
           COPY DDS-ALL-FORMATS OF MCFPMM0800.
000600 WORKING-STORAGE SECTION.
000700 77  JOB-CMP-SEQ                 PIC 999.
       77  REC-NUM                     PIC 9 VALUE 0.
001000 77  SAVE-YR-DIG                 PIC X.
       77  YR-SAVE                     PIC X.
      *---- 01/04/2010:  ADDED PARAMETER FOR CMMISYR.
       77  MMIS-LETTER                PIC X.
001100 01  ARG-NO                      PIC 9(9).
       COPY CATREAD OF COPYLIB.
001400 01  CUR-DATE-WA.
           05  CUR-DATE-YY             PIC XX.
           05  C-D-YY-9 REDEFINES CUR-DATE-YY.
               10  FILLER              PIC X.
001600         10  C-D-WA-Y            PIC 9.
           05  FILLER                  PIC X(4).
       01  DBPARAMETERS.
           COPY DBPARMS OF COPYLIB.
       01  DEL-COMP-MSG.
           05  FILLER                  PIC X(36).
           05  WODEL                   PIC X(10).
           05  FILLER                  PIC X(33).
       01  DUP-COMP-MSG.
           05  FILLER                  PIC X(28).
           05  WOIN                    PIC X(10).
           05  FILLER                  PIC X(15).
           05  WOOUT                   PIC X(10).
           05  FILLER                  PIC X(26).
001900 01  ERROR-BUFFER.
           05  FILLER                  PIC X(18).
           05  ERR-SEQ                 PIC 9(4).
           05  FILLER                  PIC X(58).
       01  FALS-VAL                    PIC 1 VALUE B"0".
002700 01  INPUT-BUF.
002800     05  INPUT-WO-FROM.
002900         10  INPUT-WO-FROM-1-6   PIC X(6).
003000         10  INPUT-WO-FROM-7     PIC X.
003100         10  INPUT-WO-FROM-8-10  PIC XXX.
003200     05  INPUT-JOBP-SEQ-FROM     PIC XXX.
003300     05  IJSF-9 REDEFINES INPUT-JOBP-SEQ-FROM  PIC 999.
003400     05  INPUT-WO-TO.
003500         10  INPUT-WO-TO-1-6     PIC X(6).
003600         10  INPUT-WO-TO-7       PIC X.
003700         10  INPUT-WO-TO-8-10    PIC XXX.
003800     05  INPUT-JOBP-SEQ-TO       PIC XXX.
003900     05  IJST-9 REDEFINES INPUT-JOBP-SEQ-TO    PIC 999.
           05  INPUT-CMD-LINE          PIC X(79).
           05  INPUT-ERR-LINE          PIC X(79).
       COPY IOFEEDBACK OF COPYLIB.
       01  JOBPLAN-BUFFER.
           COPY DJOBPLAN OF COPYLIB.
004100 01  JOBPLAN-KEY.
004200     05  JOBP-WO-NO              PIC X(10).
004300     05  JOBP-SEQ-NO             PIC 999.
004400     05  FILLER                  PIC X.
004100 01  JOBPLAN-KEY-2.
004200     05  JOBP-WO-NO-2            PIC X(10).
004300     05  JOBP-SEQ-NO-2           PIC 999.
004400     05  FILLER                  PIC X.
       01  JOBPLAN-STATUS              PIC XX VALUE SPACES.
       01  JOBPLAN-STATUS-2            PIC XX VALUE SPACES.
       01  JOBPLAN-REL-KEY             PIC 9(9) VALUE ZEROS.
           COPY LANGSUB OF COPYLIB.
       01  LAST-WO-BUFF.
           COPY MLASTWO OF COPYLIB.
004600 01  PASSWORD-INFORMATION.
004800     05  NAME-OF-PROGRAM     PIC X(08) VALUE "TJPMAINT".
004900     05  PROGRAM-TYPE        PIC X(02) VALUE "UP".
005000     05  PROGRAM-RELEASE     PIC X(12) VALUE " E0100010001".
005100     05  PROGRAM-DESCRIPTION.
005200         10  PROG-DESC-A     PIC X(60) VALUE
005300       "SPECIAL JOBPLAN MAINTENANCE PROGRAM THAT ALLOWS USER TO ".
005400         10  PROG-DESC-B     PIC X(60) VALUE
005500       "MANIPULATE WHOLE JOBPLANS FROM/TO A W/O                 ".
005600         10  PROG-FUNCTION   PIC X(60) VALUE SPACES.
005800     05  PASSWORD-FLAG       PIC X.
       01  PLANNED-STATUS              PIC XX VALUE SPACES.
005900 01  RET-CODE                    PIC XX.
           COPY DBSTAT OF COPYLIB.
       01  TRUE-VAL                    PIC 1 VALUE B"1".
           COPY VCOMAREA OF COPYLIB.
       01  WO-PLANNED-DATA.
           COPY DWOPLAN OF COPYLIB.
006700 01  WORKORDER-NUMBER            PIC X(10).
       01  DSPLY-STATUS                PIC XX.
       COPY WSCONTROL OF COPYLIB.
       COPY CPYIND OF COPYLIB.
006800 PROCEDURE DIVISION.
006900 START-PROGRAM.
007000     PERFORM 1-HSK.
007100     PERFORM 6-MAIN UNTIL VIEW-LASTKEY = 3.
007200 2-EOJ.
           CLOSE JOBPLAN-LF1.
           CLOSE JOBPLAN-LF2.
           CLOSE PLANNED-LF1.
           CLOSE PLANNED-LF2.
           CLOSE WO-LAST-NUM-USED.
007800     GOBACK.
007900 1-HSK.
           OPEN I-O DISPLAY-FILE.
           OPEN INPUT JOBPLAN-LF1.
           OPEN I-O   JOBPLAN-LF2.
           OPEN INPUT PLANNED-LF1.
           OPEN I-O   PLANNED-LF2.
           OPEN INPUT WO-LAST-NUM-USED.
           READ WO-LAST-NUM-USED INTO LAST-WO-BUFF  INVALID KEY
               MOVE 17 TO COND-WORD.
013700     CALL "TPWORD" USING PASSWORD-INFORMATION.
014100     IF PASSWORD-FLAG = "N" GO TO 2-EOJ.
           MOVE SPACES TO INPUT-BUF ERROR-BUFFER DUP-COMP-MSG
               DEL-COMP-MSG.
           MOVE 0 TO VIEW-LASTKEY.
014200     ACCEPT CUR-DATE-WA FROM DATE.
      *------- 01/04/2010:  UPDATED WORKORDER LETTER SUFFIX LOGIC.
014300*    IF C-D-WA-Y = 0
014400*        MOVE "A" TO SAVE-YR-DIG
014500*    ELSE
014600*    IF C-D-WA-Y = 1
014700*        MOVE "B" TO SAVE-YR-DIG
014800*    ELSE
014900*    IF C-D-WA-Y = 2
015000*        MOVE "C" TO SAVE-YR-DIG
015100*    ELSE
015200*    IF C-D-WA-Y = 3
015300*        MOVE "D" TO SAVE-YR-DIG
015400*    ELSE
015500*    IF C-D-WA-Y = 4
015600*        MOVE "E" TO SAVE-YR-DIG
015700*    ELSE
015800*    IF C-D-WA-Y = 5
015900*        MOVE "F" TO SAVE-YR-DIG
016000*    ELSE
016100*    IF C-D-WA-Y = 6
016200*        MOVE "G" TO SAVE-YR-DIG
016300*    ELSE
016400*    IF C-D-WA-Y = 7
016500*        MOVE "H" TO SAVE-YR-DIG
016600*    ELSE
016700*    IF C-D-WA-Y = 8
016800*        MOVE "J" TO SAVE-YR-DIG
016900*    ELSE
017000*    MOVE "K" TO SAVE-YR-DIG.

           CALL "CMMISYR" USING MMIS-LETTER.
           MOVE MMIS-LETTER    TO SAVE-YR-DIG.
      *-------
017100 6-MAIN.
           MOVE SPACES TO INPUT-BUF DSPLY-REC.
017200     MOVE "FJPMSELF" TO VIEW-CFNAME.
           PERFORM 99-SCREEN-WRITE.
           PERFORM 98-SCREEN-READ.
018200     IF VIEW-LASTKEY = 3 GO TO 2-EOJ.
           IF VIEW-LASTKEY = 1
018400         MOVE "FJPMAIN1" TO VIEW-CFNAME
               PERFORM 601-CHECK-TO-RESET
               MOVE INPUT-BUF TO DSPLY-REC
               PERFORM 99-SCREEN-WRITE
               PERFORM 98-SCREEN-READ
019200         IF VIEW-LASTKEY = 3
                   MOVE SPACES TO ERROR-BUFFER INPUT-BUF
                   MOVE 0 TO VIEW-LASTKEY
019300             GO TO 6-MAIN
019500         ELSE
               MOVE DSPLY-REC TO INPUT-BUF
019700         MOVE INPUT-WO-FROM TO WORKORDER-NUMBER
019800         CALL "TALWONO" USING WORKORDER-NUMBER RET-CODE
019900         MOVE WORKORDER-NUMBER TO INPUT-WO-FROM
020000         MOVE INPUT-WO-TO TO WORKORDER-NUMBER
020100         CALL "TALWONO" USING WORKORDER-NUMBER RET-CODE
020200         MOVE WORKORDER-NUMBER TO INPUT-WO-TO
               MOVE INPUT-BUF TO DSPLY-REC
               PERFORM 99-SCREEN-WRITE
               PERFORM 98A-SCREEN-READ
               MOVE SPACES TO ERROR-BUFFER
               MOVE 1 TO VIEW-LASTKEY
021300         PERFORM 62-DUPLICATE-JOBPLAN THRU 62-DJ-EXIT
               IF ERROR-BUFFER = SPACES
                   MOVE JOB-CMP-SEQ TO LAST-JOBPLAN-SEQ-1-3
021400             PERFORM 63-UPDATE-JOBPLAN-SEQ THRU 63-UJS-EXIT
                   MOVE 46026 TO CATREAD-MSG-NUMBER
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE ERROR-BUFFER TO DUP-COMP-MSG
                   MOVE INPUT-WO-FROM TO WOIN
                   MOVE INPUT-WO-TO TO WOOUT
                   MOVE TRUE-VAL TO INDS (98)
                   MOVE DUP-COMP-MSG TO INPUT-CMD-LINE
                   MOVE INPUT-BUF TO DSPLY-REC
                   PERFORM 99-SCREEN-WRITE
                   PERFORM 98A-SCREEN-READ
                   CALL "CLPAUSE2"
                   MOVE SPACES TO ERROR-BUFFER INPUT-BUF
                   GO TO 6-MAIN
               ELSE
               GO TO 6-MAIN.
021500     IF VIEW-LASTKEY = 2
021600         MOVE "FJPMAIN2" TO VIEW-CFNAME
               PERFORM 601-CHECK-TO-RESET
               MOVE INPUT-BUF TO DSPLY-REC
               PERFORM 99-SCREEN-WRITE
               PERFORM 98-SCREEN-READ
022400         IF VIEW-LASTKEY = 3
                   MOVE SPACES TO ERROR-BUFFER INPUT-BUF
                   MOVE 0 TO VIEW-LASTKEY
022500             GO TO 6-MAIN
022700         ELSE
               MOVE DSPLY-REC TO INPUT-BUF
               MOVE INPUT-WO-FROM TO WORKORDER-NUMBER
022900         CALL "TALWONO" USING WORKORDER-NUMBER RET-CODE
               MOVE WORKORDER-NUMBER TO INPUT-WO-FROM
               MOVE INPUT-BUF TO DSPLY-REC
               PERFORM 99-SCREEN-WRITE
               MOVE SPACES TO ERROR-BUFFER
               MOVE 2 TO VIEW-LASTKEY
023900         PERFORM 61-DELETE-JOBPLAN THRU 61-DJ-EXIT
               IF ERROR-BUFFER = SPACES
024100             MOVE INPUT-WO-FROM TO WORKORDER-NUMBER
024200             IF INPUT-JOBP-SEQ-FROM = "   "
024300                 MOVE 0 TO LAST-JOBPLAN-SEQ-1-3
024400                 PERFORM 63-UPDATE-JOBPLAN-SEQ
                           THRU 63-UJS-EXIT
                       MOVE 46040 TO CATREAD-MSG-NUMBER
                       PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                       MOVE ERROR-BUFFER TO DEL-COMP-MSG
                       MOVE INPUT-WO-FROM TO WODEL
                       MOVE DEL-COMP-MSG TO INPUT-CMD-LINE
                       MOVE TRUE-VAL TO INDS (98)
                       MOVE INPUT-BUF TO DSPLY-REC
                       PERFORM 99-SCREEN-WRITE
                       PERFORM 98A-SCREEN-READ
                       CALL "CLPAUSE2"
                       MOVE SPACES TO ERROR-BUFFER INPUT-BUF
                       GO TO 6-MAIN
                   ELSE
                   NEXT SENTENCE
               ELSE
               GO TO 6-MAIN.
       601-CHECK-TO-RESET.
           IF ERROR-BUFFER = SPACES
018700         MOVE SPACES TO INPUT-BUF
018800         MOVE SAVE-YR-DIG TO INPUT-WO-FROM-7 INPUT-WO-TO-7
               IF DUP-COMP-MSG = SPACES
                   IF DEL-COMP-MSG = SPACES
                       NEXT SENTENCE
                   ELSE
                   MOVE DEL-COMP-MSG TO INPUT-ERR-LINE
                   MOVE SPACES TO DEL-COMP-MSG
               ELSE
               MOVE DUP-COMP-MSG TO INPUT-ERR-LINE
               MOVE SPACES TO DUP-COMP-MSG
           ELSE
           MOVE ERROR-BUFFER TO INPUT-ERR-LINE.
025400 61-DELETE-JOBPLAN.
           MOVE 0 TO COND-WORD.
           MOVE INPUT-WO-FROM TO WONUM OF WO-PLANNED-REC-LF1.
           START PLANNED-LF1 KEY IS = EXTERNALLY-DESCRIBED-KEY
               INVALID KEY MOVE 17 TO COND-WORD.
025900     IF COND-WORD NOT = 0
               MOVE 49002 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE TRUE-VAL TO INDS (1) INDS (99)
               GO TO 61-DJ-EXIT.
           MOVE 0 TO COND-WORD.
           READ PLANNED-LF1 INTO WO-PLANNED-DATA
               INVALID KEY MOVE 15 TO COND-WORD.
026500     IF COND-WORD NOT = 0
               MOVE 49002 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE TRUE-VAL TO INDS (1) INDS (99)
               GO TO 61-DJ-EXIT.
026800     IF LAST-JOBPLAN-SEQ = "    "
026900         MOVE 998 TO JOB-CMP-SEQ
027000     ELSE
027100     MOVE LAST-JOBPLAN-SEQ-1-3 TO JOB-CMP-SEQ.
027200     IF INPUT-JOBP-SEQ-FROM = "   "
027300         NEXT SENTENCE
027400     ELSE
027500     PERFORM 61-DELETE-ONE-JOBPLAN-SEQ THRU 61-DOJS-EXIT
027700     GO TO 61-DJ-EXIT.
027800 61-DJ-CONT.
028100     MOVE SPACES TO JOBPLAN-BUFFER JOBPLAN-KEY.
028200     MOVE INPUT-WO-FROM TO JOBP-WO-NO.
028300     MOVE 001 TO JOBP-SEQ-NO.
028500 61-READ-JOBPLAN.
           MOVE 0 TO COND-WORD.
           MOVE JOBPLAN-KEY TO JOBPWOSEQ OF JPLAN-LF2.
           START JOBPLAN-LF2 KEY IS = EXTERNALLY-DESCRIBED-KEY
               INVALID KEY MOVE 17 TO COND-WORD.
028800     IF COND-WORD NOT = 0
               ADD 001 TO JOBP-SEQ-NO
028900         IF JOBP-SEQ-NO > JOB-CMP-SEQ
029000             GO TO 61-DJ-EXIT
029100         ELSE
029300         GO TO 61-READ-JOBPLAN.
029400 61-LOOP-DELETE.
           MOVE 0 TO COND-WORD.
           READ JOBPLAN-LF2 NEXT INTO JOBPLAN-BUFFER
               AT END GO TO 61-DJ-EXIT.
           IF JOBPLAN-WO-NO = JOBP-WO-NO
               NEXT SENTENCE
           ELSE
           GO TO 61-DJ-EXIT.
           DELETE JOBPLAN-LF2 RECORD.
           GO TO 61-LOOP-DELETE.
030500 61-DJ-EXIT.    EXIT.
030600
030700 61-DELETE-ONE-JOBPLAN-SEQ.
031000     MOVE SPACES TO JOBPLAN-BUFFER JOBPLAN-KEY.
031100     MOVE INPUT-WO-FROM TO JOBP-WO-NO.
031200     MOVE IJSF-9 TO JOBP-SEQ-NO.
031400 61-DOJS-CONT.
           MOVE 0 TO COND-WORD.
           MOVE JOBPLAN-KEY TO JOBPWOSEQ OF JPLAN-LF2.
           START JOBPLAN-LF2 KEY IS = EXTERNALLY-DESCRIBED-KEY
               INVALID KEY MOVE 17 TO COND-WORD.
031700     IF COND-WORD NOT = 0
               MOVE 36005 TO CATREAD-MSG-NUMBER
032100         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE TRUE-VAL TO INDS (4) INDS (99)
               GO TO 61-DOJS-EXIT.
032600 61-DOJS-CONT-1.
           MOVE 0 TO COND-WORD.
           READ JOBPLAN-LF2 NEXT INTO JOBPLAN-BUFFER
               AT END MOVE 15 TO COND-WORD.
032900     IF COND-WORD NOT = 0
               MOVE 36005 TO CATREAD-MSG-NUMBER
033300         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE ERROR-BUFFER TO INPUT-ERR-LINE
               MOVE TRUE-VAL TO INDS (4) INDS (99)
               GO TO 61-DOJS-EXIT.
           IF JOBPWOSEQ OF JPLAN-LF2 = JOBPLAN-KEY
               NEXT SENTENCE
           ELSE
           GO TO 61-DOJS-EXIT.
           DELETE JOBPLAN-LF2 RECORD   INVALID KEY
               GO TO 61-DOJS-EXIT.
033900     GO TO 61-DOJS-CONT-1.
034000 61-DOJS-EXIT.    EXIT.
034100
034200 62-DUPLICATE-JOBPLAN.
           MOVE SPACES TO JOBPLAN-KEY-2.
           MOVE ZEROES TO JOBP-SEQ-NO-2.
           MOVE 0 TO COND-WORD.
           MOVE INPUT-WO-FROM TO WONUM OF WO-PLANNED-REC-LF1.
           START PLANNED-LF1 KEY IS = EXTERNALLY-DESCRIBED-KEY
                INVALID KEY MOVE 17 TO COND-WORD.
034700     IF COND-WORD NOT = 0
               MOVE 49002 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE TRUE-VAL TO INDS (1) INDS (99)
               GO TO 62-DJ-EXIT.
           READ PLANNED-LF1 INTO WO-PLANNED-DATA
               INVALID KEY MOVE 15 TO COND-WORD.
035300     IF COND-WORD NOT = 0
               MOVE 49002 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE TRUE-VAL TO INDS (1) INDS (99)
               GO TO 62-DJ-EXIT.
           IF LAST-JOBPLAN-SEQ = "    "
               MOVE 998 TO JOB-CMP-SEQ
           ELSE
035600     MOVE LAST-JOBPLAN-SEQ-1-3 TO JOB-CMP-SEQ.
035900     MOVE SPACES TO JOBPLAN-KEY JOBPLAN-BUFFER.
036000     MOVE INPUT-WO-FROM TO JOBP-WO-NO.
036100     MOVE 000 TO JOBP-SEQ-NO.
036300     IF INPUT-JOBP-SEQ-FROM = "   "
036400         NEXT SENTENCE
036500     ELSE
036600     MOVE IJSF-9 TO JOBP-SEQ-NO
036700     PERFORM 62-DUPLICATE-ONE-JOBPLAN-SEQ THRU 62-DOJS-EXIT
036800     GO TO 62-DJ-EXIT.
           MOVE 0 TO COND-WORD.
           MOVE INPUT-WO-TO TO WONUM OF WO-PLANNED-REC-LF2.
           START PLANNED-LF2 KEY IS = EXTERNALLY-DESCRIBED-KEY
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF COND-WORD NOT = 0
               MOVE 49002 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE TRUE-VAL TO INDS (5) INDS (99)
               GO TO 62-DJ-EXIT.
           MOVE 0 TO COND-WORD.
           READ PLANNED-LF2 NEXT INTO WO-PLANNED-DATA
               AT END    MOVE 15 TO COND-WORD.
           IF COND-WORD NOT = 0
               MOVE 49002 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE TRUE-VAL TO INDS (5) INDS (99)
               GO TO 62-DJ-EXIT.
       62-READ-JPLAN-LF1.
           MOVE 0 TO COND-WORD.
           MOVE JOBPLAN-KEY TO JOBPWOSEQ OF JPLAN-LF1.
           START JOBPLAN-LF1 KEY IS > EXTERNALLY-DESCRIBED-KEY
               INVALID KEY MOVE 17 TO COND-WORD.
           IF COND-WORD NOT = 0
               MOVE 47010 TO CATREAD-MSG-NUMBER
038500         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE TRUE-VAL TO INDS (4) INDS (99)
038900         GO TO 62-DJ-EXIT.
       62-RJ-LF1-LOOP.
            MOVE 0 TO COND-WORD.
            READ JOBPLAN-LF1 NEXT INTO JOBPLAN-BUFFER
                AT END MOVE 15 TO COND-WORD.
            IF JOBPLAN-WO-NO NOT = INPUT-WO-FROM GO TO 62-DJ-EXIT.
            IF COND-WORD = 15 GO TO 62-DJ-EXIT.
            IF JOBPLAN-SEQ-NO-1-3 NOT = JOBP-SEQ-NO-2
                MOVE INPUT-WO-TO TO JOBP-WO-NO-2
                MOVE JOBPLAN-SEQ-NO-1-3 TO JOBP-SEQ-NO-2
                PERFORM 620-CHECK-IF-ALREADY-EXISTS
                IF COND-WORD = 0
                    MOVE 74939 TO CATREAD-MSG-NUMBER
                    PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                    MOVE JOBPLAN-SEQ-NO-1-3 TO ERR-SEQ
                    MOVE ERROR-BUFFER TO INPUT-ERR-LINE
                    MOVE INPUT-BUF TO DSPLY-REC
                    MOVE TRUE-VAL TO INDS (5) INDS (99)
                    PERFORM 99-SCREEN-WRITE
                    PERFORM 98-SCREEN-READ
                    GO TO 62-DJ-EXIT.
            MOVE INPUT-WO-TO TO JOBPLAN-WO-NO.
            MOVE JOBPLAN-BUFFER TO JPLAN-LF2.
            WRITE JPLAN-LF2.
            GO TO 62-RJ-LF1-LOOP.
042500 62-DJ-EXIT.    EXIT.
       620-CHECK-IF-ALREADY-EXISTS.
           MOVE 0 TO COND-WORD.
           MOVE JOBPLAN-KEY-2 TO JOBPWOSEQ OF JPLAN-LF2.
           START JOBPLAN-LF2 KEY = EXTERNALLY-DESCRIBED-KEY
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF JOBPLAN-STATUS-2 NOT = "00" MOVE 17 TO COND-WORD.
042700 62-DUPLICATE-ONE-JOBPLAN-SEQ.
           MOVE 0 TO COND-WORD.
           MOVE INPUT-WO-TO TO WONUM OF WO-PLANNED-REC-LF2.
           START PLANNED-LF2 KEY IS = EXTERNALLY-DESCRIBED-KEY
               INVALID KEY MOVE 17 TO COND-WORD.
043000     IF COND-WORD NOT = 0
               MOVE 36005 TO CATREAD-MSG-NUMBER
043600         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE TRUE-VAL TO INDS (5) INDS (99)
044000         GO TO 62-DOJS-EXIT.
           READ PLANNED-LF2 NEXT INTO WO-PLANNED-DATA
               AT END   MOVE 15 TO COND-WORD.
            IF COND-WORD NOT = 0
                MOVE 36005 TO CATREAD-MSG-NUMBER
                PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                MOVE TRUE-VAL TO INDS (5) INDS (99)
                GO TO 62-DOJS-EXIT.
       62-GET-JOBPLAN-REC.
            MOVE 0 TO COND-WORD.
            MOVE JOBPLAN-KEY TO JOBPWOSEQ OF JPLAN-LF1.
            START JOBPLAN-LF1 KEY IS = EXTERNALLY-DESCRIBED-KEY
                INVALID KEY    MOVE 17 TO COND-WORD.
            IF COND-WORD NOT = 0
                MOVE 47010 TO CATREAD-MSG-NUMBER
                PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                MOVE TRUE-VAL TO INDS (4) INDS (99)
                GO TO 62-DOJS-EXIT.
       62-GJR-LOOP.
           MOVE 0 TO COND-WORD.
           READ JOBPLAN-LF1 NEXT INTO JOBPLAN-BUFFER
               AT END    MOVE 15 TO COND-WORD.
           IF JOBPWOSEQ OF JPLAN-LF1 NOT = JOBPLAN-KEY
               MOVE 15 TO COND-WORD.
           IF COND-WORD = 15
               PERFORM 63-UPDATE-JOBPLAN-SEQ THRU 63-UJS-EXIT
               GO TO 62-DOJS-EXIT
           ELSE
           MOVE INPUT-WO-TO TO JOBPLAN-WO-NO
           MOVE IJST-9      TO JOBPLAN-SEQ-NO-1-3
           MOVE JOBPLAN-BUFFER TO JPLAN-LF2
           WRITE JPLAN-LF2 INVALID KEY GO TO 62-DOJS-EXIT.
           GO TO 62-GJR-LOOP.
048200 62-DOJS-EXIT.    EXIT.
048300
048400 63-UPDATE-JOBPLAN-SEQ.
           MOVE WO-NUM-P OF WO-PLANNED-DATA TO WONUM
               OF WO-PLANNED-REC-LF2.
049300     REWRITE WO-PLANNED-REC-LF2 FROM WO-PLANNED-DATA
               INVALID KEY    MOVE 99 TO COND-WORD.
           IF COND-WORD = 99
               MOVE 47038 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE TRUE-VAL TO INDS (99)
               GO TO 63-UJS-EXIT.
049800 63-UJS-EXIT.    EXIT.
       98-SCREEN-READ.
           READ DISPLAY-FILE INDIC IS INDICS
               MOVE FUNCTION-NUM TO VIEW-LASTKEY
               MOVE ALL B"0" TO INDICS.

       98A-SCREEN-READ.
           READ DISPLAY-FILE TERMINAL IS TERMINAL-ID
               INDIC IS INDICS
                  NO DATA MOVE DSPLY-STATUS TO DSPLY-STATUS.
           MOVE ALL B"0" TO INDICS.

       99-SCREEN-WRITE.
           WRITE DSPLY-REC FORMAT IS VIEW-CFNAME
               INDIC IS INDICS.
      *    MOVE B"0" TO INDS (99).

050000 999-CATREAD.
050100     MOVE SPACES TO ERROR-BUFFER.
           CALL "CCATREAD" USING CATREAD-PARMS.
           MOVE CATREAD-MSG-TEXT TO ERROR-BUFFER.
051000 999-CATREAD-EXIT.    EXIT.
