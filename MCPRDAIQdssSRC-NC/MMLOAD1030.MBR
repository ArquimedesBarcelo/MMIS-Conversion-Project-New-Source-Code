     F****************************************************************
     FMCFLMM1012UF   E           K DISK
     FMCFLMM1013UF   E           K DISK
     FMCFLMM1014UF   E           K DISK
     FMCFPMM1030UF A E           K DISK
     D*
     D  CHKKEY         S              8
     D  CHKZONE        S              4
     D  MOD            S              4
     D  CNT1           S              1  0
     D  CNT2           S              1  0
     D  CNT3           S              1  0
     D  CNT4           S              1  0
     C*
     C*
     C     KEY1030       KLIST
     C                   KFLD                    CHKKEY
     C                   KFLD                    CHKZONE
     C*
     C                   read      MCRLMM1012                             99
     C     *IN99         DOWEQ     '0'
     C     MMPRODDTRC    IFEQ      *BLANK
     C                   CALL      'LOADDATSFT'
     C                   PARM                    MXZONE
     C                   PARM                    MXDATERECD
     C                   PARM                    MXTIMERECD
     C                   PARM                    MMPRODDTRC
     C                   PARM                    MMSHFTRC
     C                   PARM                    MOD
     C                   MOVE      MOD           MMMODRECD
     C                   END
     C*
     C                   MOVE      MXDATERECD    CHKKEY
     C                   MOVE      MXZONE        CHKZONE
     C*
     C     KEY1030       CHAIN     MCRPMM1030                         66
     C                   IF        NOT%found(MCFPMM1030)
     C                   MOVE      CHKKEY        CNTDATE
     C                   MOVE      CHKZONE       CNTZONE
     C                   Z-ADD     0             CNTRECD
     C                   Z-ADD     0             CNTSRTR
     C                   Z-ADD     0             CNTCOMP
     C                   Z-ADD     0             CNTSRTRA
     C                   Z-ADD     0             CNTCOMPA
     C                   Z-ADD     0             SFTRECD1
     C                   Z-ADD     0             SFTSRTR1
     C                   Z-ADD     0             SFTCOMP1
     C                   Z-ADD     0             SFTSRTRA1
     C                   Z-ADD     0             SFTCOMPA1
     C                   Z-ADD     0             SFTRECD2
     C                   Z-ADD     0             SFTSRTR2
     C                   Z-ADD     0             SFTCOMP2
     C                   Z-ADD     0             SFTSRTRA2
     C                   Z-ADD     0             SFTCOMPA2
     C                   Z-ADD     0             SFTRECD3
     C                   Z-ADD     0             SFTSRTR3
     C                   Z-ADD     0             SFTCOMP3
     C                   Z-ADD     0             SFTSRTRA3
     C                   Z-ADD     0             SFTCOMPA3
     C                   WRITE     MCRPMM1030
     C     KEY1030       CHAIN     MCRPMM1030                         66
     C                   END
     C*
     C                   ADD       1             CNTRECD
     C*
     C     MMSHFTRC      IFEQ      '1'
     C                   ADD       1             SFTRECD1
     C                   END
     C*
     C     MMSHFTRC      IFEQ      '2'
     C                   ADD       1             SFTRECD2
     C                   END
     C*
     C     MMSHFTRC      IFEQ      '3'
     C                   ADD       1             SFTRECD3
     C                   END
     C*
     C                   MOVE      'Y'           MM1030A
     C*
     C                   UPDATE    MCRPMM1030
     C*
     C*               UPDATE ZONE *ALL
     C*
     C                   MOVE      '*ALL'        CHKZONE
     C*
     C     KEY1030       CHAIN     MCRPMM1030                         66
     C                   IF        NOT%found(MCFPMM1030)
     C                   MOVE      CHKKEY        CNTDATE
     C                   MOVE      '*ALL'        CNTZONE
     C                   Z-ADD     0             CNTRECD
     C                   Z-ADD     0             CNTSRTR
     C                   Z-ADD     0             CNTCOMP
     C                   Z-ADD     0             CNTSRTRA
     C                   Z-ADD     0             CNTCOMPA
     C                   Z-ADD     0             SFTRECD1
     C                   Z-ADD     0             SFTSRTR1
     C                   Z-ADD     0             SFTCOMP1
     C                   Z-ADD     0             SFTSRTRA1
     C                   Z-ADD     0             SFTCOMPA1
     C                   Z-ADD     0             SFTRECD2
     C                   Z-ADD     0             SFTSRTR2
     C                   Z-ADD     0             SFTCOMP2
     C                   Z-ADD     0             SFTSRTRA2
     C                   Z-ADD     0             SFTCOMPA2
     C                   Z-ADD     0             SFTRECD3
     C                   Z-ADD     0             SFTSRTR3
     C                   Z-ADD     0             SFTCOMP3
     C                   Z-ADD     0             SFTSRTRA3
     C                   Z-ADD     0             SFTCOMPA3
     C                   WRITE     MCRPMM1030
     C     KEY1030       CHAIN     MCRPMM1030                         66
     C                   END
     C*
     C                   ADD       1             CNTRECD
     C*
     C     MMSHFTRC      IFEQ      '1'
     C                   ADD       1             SFTRECD1
     C                   END
     C*
     C     MMSHFTRC      IFEQ      '2'
     C                   ADD       1             SFTRECD2
     C                   END
     C*
     C     MMSHFTRC      IFEQ      '3'
     C                   ADD       1             SFTRECD3
     C                   END
     C*
     C                   UPDATE    MCRPMM1030
     C*****
     C****
     C                   UPDATE    MCRLMM1012
     C*
     C                   read      MCRLMM1012                             99
     C                   END
     C*
     C*
     C*
     C                   read      MCRLMM1013                             99
     C     *IN99         DOWEQ     '0'
     C*
     C     MXDATESTRT    IFEQ      *BLANK
     C     MMPRODSTRT    IFEQ      *BLANK
     C                   GOTO      NEXT13
     C                   END
     C                   END
     C*
     C     MMPRODSTRT    IFEQ      *BLANK
     C                   CALL      'LOADDATSFT'
     C                   PARM                    MXZONE
     C                   PARM                    MXDATESTRT
     C                   PARM                    MXTIMESTRT
     C                   PARM                    MMPRODSTRT
     C                   PARM                    MMSHFTSTRT
     C                   PARM                    MOD
     C                   MOVE      MOD           MMMODSTRT
     C                   END
     C*
     C                   MOVE      MMPRODSTRT    CHKKEY
     C                   MOVE      MXZONE        CHKZONE
     C*
     C     MMPRODSTRT    IFEQ      MMPRODDTRC
     C                   Z-ADD     1             CNT1
     C                   Z-ADD     1             CNT2
     C                   ELSE
     C                   Z-ADD     0             CNT1
     C                   Z-ADD     1             CNT2
     C                   END
     C*
     C     KEY1030       CHAIN     MCRPMM1030                         66
     C                   IF        NOT%found(MCFPMM1030)
     C                   MOVE      CHKKEY        CNTDATE
     C                   MOVE      CHKZONE       CNTZONE
     C                   Z-ADD     0             CNTRECD
     C                   Z-ADD     0             CNTSRTR
     C                   Z-ADD     0             CNTCOMP
     C                   Z-ADD     0             CNTSRTRA
     C                   Z-ADD     0             CNTCOMPA
     C                   Z-ADD     0             SFTRECD1
     C                   Z-ADD     0             SFTSRTR1
     C                   Z-ADD     0             SFTCOMP1
     C                   Z-ADD     0             SFTSRTRA1
     C                   Z-ADD     0             SFTCOMPA1
     C                   Z-ADD     0             SFTRECD2
     C                   Z-ADD     0             SFTSRTR2
     C                   Z-ADD     0             SFTCOMP2
     C                   Z-ADD     0             SFTSRTRA2
     C                   Z-ADD     0             SFTCOMPA2
     C                   Z-ADD     0             SFTRECD3
     C                   Z-ADD     0             SFTSRTR3
     C                   Z-ADD     0             SFTCOMP3
     C                   Z-ADD     0             SFTSRTRA3
     C                   Z-ADD     0             SFTCOMPA3
     C                   WRITE     MCRPMM1030
     C     KEY1030       CHAIN     MCRPMM1030                         66
     C                   END
     C*
     C                   ADD       CNT1          CNTSRTR
     C                   ADD       CNT2          CNTSRTRA
     C*
     C     MMPRODSTRT    IFNE      MMPRODDTRC
     C                   Z-ADD     0             CNT3
     C                   Z-ADD     1             CNT4
     C                   ELSE
     C     MMSHFTSTRT    IFEQ      MMSHFTRC
     C                   Z-ADD     1             CNT3
     C                   Z-ADD     1             CNT4
     C                   ELSE
     C                   Z-ADD     0             CNT3
     C                   Z-ADD     1             CNT4
     C                   END
     C                   END
     C*
     C     MMSHFTSTRT    IFEQ      '1'
     C                   ADD       CNT3          SFTSRTR1
     C                   ADD       CNT4          SFTSRTRA1
     C                   END
     C*
     C     MMSHFTSTRT    IFEQ      '2'
     C                   ADD       CNT3          SFTSRTR2
     C                   ADD       CNT4          SFTSRTRA2
     C                   END
     C*
     C     MMSHFTSTRT    IFEQ      '3'
     C                   ADD       CNT3          SFTSRTR3
     C                   ADD       CNT4          SFTSRTRA3
     C                   END
     C*
     C                   MOVE      'Y'           MM1030B
     C*
     C                   UPDATE    MCRPMM1030
     C*
     C                   MOVE      '*ALL'        CHKZONE
     C*
     C     KEY1030       CHAIN     MCRPMM1030                         66
     C                   IF        NOT%found(MCFPMM1030)
     C                   MOVE      CHKKEY        CNTDATE
     C                   MOVE      CHKZONE       CNTZONE
     C                   Z-ADD     0             CNTRECD
     C                   Z-ADD     0             CNTSRTR
     C                   Z-ADD     0             CNTCOMP
     C                   Z-ADD     0             CNTSRTRA
     C                   Z-ADD     0             CNTCOMPA
     C                   Z-ADD     0             SFTRECD1
     C                   Z-ADD     0             SFTSRTR1
     C                   Z-ADD     0             SFTCOMP1
     C                   Z-ADD     0             SFTSRTRA1
     C                   Z-ADD     0             SFTCOMPA1
     C                   Z-ADD     0             SFTRECD2
     C                   Z-ADD     0             SFTSRTR2
     C                   Z-ADD     0             SFTCOMP2
     C                   Z-ADD     0             SFTSRTRA2
     C                   Z-ADD     0             SFTCOMPA2
     C                   Z-ADD     0             SFTRECD3
     C                   Z-ADD     0             SFTSRTR3
     C                   Z-ADD     0             SFTCOMP3
     C                   Z-ADD     0             SFTSRTRA3
     C                   Z-ADD     0             SFTCOMPA3
     C                   WRITE     MCRPMM1030
     C     KEY1030       CHAIN     MCRPMM1030                         66
     C                   END
     C*
     C                   ADD       CNT1          CNTSRTR
     C                   ADD       CNT2          CNTSRTRA
     C*
     C     MMSHFTSTRT    IFEQ      '1'
     C                   ADD       CNT3          SFTSRTR1
     C                   ADD       CNT4          SFTSRTRA1
     C                   END
     C*
     C     MMSHFTSTRT    IFEQ      '2'
     C                   ADD       CNT3          SFTSRTR2
     C                   ADD       CNT4          SFTSRTRA2
     C                   END
     C*
     C     MMSHFTSTRT    IFEQ      '3'
     C                   ADD       CNT3          SFTSRTR3
     C                   ADD       CNT4          SFTSRTRA3
     C                   END
     C*
     C                   MOVE      'Y'           MM1030B
     C*
     C                   UPDATE    MCRPMM1030
     C*
     C                   UPDATE    MCRLMM1013
     C*
     C     NEXT13        TAG
     C                   READ      MCRLMM1013                             99
     C                   END
     C*
     C*
     C*
     C                   read      MCRFMM1014                             99
     C     *IN99         DOWEQ     '0'
     C*
     C     MXDATECOMP    IFEQ      *BLANK
     C     MMPRODCOMP    IFEQ      *BLANK
     C                   GOTO      NEXT14
     C                   END
     C                   END
     C*
     C     MMPRODCOMP    IFEQ      *BLANK
     C                   CALL      'LOADDATSFT'
     C                   PARM                    MXZONE
     C                   PARM                    MXDATECOMP
     C                   PARM                    MXTIMECOMP
     C                   PARM                    MMPRODCOMP
     C                   PARM                    MMSHFTCOMP
     C                   PARM                    MOD
     C                   MOVE      MOD           MMMODCOMP
     C                   END
     C*
     C                   MOVE      MMPRODCOMP    CHKKEY
     C                   MOVE      MXZONE        CHKZONE
     C*
     C     MMPRODCOMP    IFEQ      MMPRODDTRC
     C                   Z-ADD     1             CNT1
     C                   Z-ADD     1             CNT2
     C                   ELSE
     C                   Z-ADD     0             CNT1
     C                   Z-ADD     1             CNT2
     C                   END
     C*
     C     KEY1030       CHAIN     MCRPMM1030                         66
     C                   IF        NOT%found(MCFPMM1030)
     C                   MOVE      CHKKEY        CNTDATE
     C                   MOVE      CHKZONE       CNTZONE
     C                   Z-ADD     0             CNTRECD
     C                   Z-ADD     0             CNTSRTR
     C                   Z-ADD     0             CNTCOMP
     C                   Z-ADD     0             CNTSRTRA
     C                   Z-ADD     0             CNTCOMPA
     C                   Z-ADD     0             SFTRECD1
     C                   Z-ADD     0             SFTSRTR1
     C                   Z-ADD     0             SFTCOMP1
     C                   Z-ADD     0             SFTSRTRA1
     C                   Z-ADD     0             SFTCOMPA1
     C                   Z-ADD     0             SFTRECD2
     C                   Z-ADD     0             SFTSRTR2
     C                   Z-ADD     0             SFTCOMP2
     C                   Z-ADD     0             SFTSRTRA2
     C                   Z-ADD     0             SFTCOMPA2
     C                   Z-ADD     0             SFTRECD3
     C                   Z-ADD     0             SFTSRTR3
     C                   Z-ADD     0             SFTCOMP3
     C                   Z-ADD     0             SFTSRTRA3
     C                   Z-ADD     0             SFTCOMPA3
     C                   WRITE     MCRPMM1030
     C     KEY1030       CHAIN     MCRPMM1030                         66
     C                   END
     C*
     C                   ADD       CNT1          CNTCOMP
     C                   ADD       CNT2          CNTCOMPA
     C*
     C     MMPRODCOMP    IFNE      MMPRODDTRC
     C                   Z-ADD     0             CNT3
     C                   Z-ADD     1             CNT4
     C                   ELSE
     C     MMSHFTCOMP    IFEQ      MMSHFTRC
     C                   Z-ADD     1             CNT3
     C                   Z-ADD     1             CNT4
     C                   ELSE
     C                   Z-ADD     0             CNT3
     C                   Z-ADD     1             CNT4
     C                   END
     C                   END
     C*
     C     MMSHFTCOMP    IFEQ      '1'
     C                   ADD       CNT3          SFTCOMP1
     C                   ADD       CNT4          SFTCOMPA1
     C                   END
     C*
     C     MMSHFTCOMP    IFEQ      '2'
     C                   ADD       CNT3          SFTCOMP2
     C                   ADD       CNT4          SFTCOMPA2
     C                   END
     C*
     C     MMSHFTCOMP    IFEQ      '3'
     C                   ADD       CNT3          SFTCOMP3
     C                   ADD       CNT4          SFTCOMPA3
     C                   END
     C*
     C                   MOVE      'Y'           MM1030C
     C*
     C                   UPDATE    MCRPMM1030
     C*
     C*
     C                   MOVE      '*ALL'        CHKZONE
     C*
     C*
     C     KEY1030       CHAIN     MCRPMM1030                         66
     C                   IF        NOT%found(MCFPMM1030)
     C                   MOVE      CHKKEY        CNTDATE
     C                   MOVE      CHKZONE       CNTZONE
     C                   Z-ADD     0             CNTRECD
     C                   Z-ADD     0             CNTSRTR
     C                   Z-ADD     0             CNTCOMP
     C                   Z-ADD     0             CNTSRTRA
     C                   Z-ADD     0             CNTCOMPA
     C                   Z-ADD     0             SFTRECD1
     C                   Z-ADD     0             SFTSRTR1
     C                   Z-ADD     0             SFTCOMP1
     C                   Z-ADD     0             SFTSRTRA1
     C                   Z-ADD     0             SFTCOMPA1
     C                   Z-ADD     0             SFTRECD2
     C                   Z-ADD     0             SFTSRTR2
     C                   Z-ADD     0             SFTCOMP2
     C                   Z-ADD     0             SFTSRTRA2
     C                   Z-ADD     0             SFTCOMPA2
     C                   Z-ADD     0             SFTRECD3
     C                   Z-ADD     0             SFTSRTR3
     C                   Z-ADD     0             SFTCOMP3
     C                   Z-ADD     0             SFTSRTRA3
     C                   Z-ADD     0             SFTCOMPA3
     C                   WRITE     MCRPMM1030
     C     KEY1030       CHAIN     MCRPMM1030                         66
     C                   END
     C*
     C                   ADD       CNT1          CNTCOMP
     C                   ADD       CNT2          CNTCOMPA
     C*
     C     MMSHFTCOMP    IFEQ      '1'
     C                   ADD       CNT3          SFTCOMP1
     C                   ADD       CNT4          SFTCOMPA1
     C                   END
     C*
     C     MMSHFTCOMP    IFEQ      '2'
     C                   ADD       CNT3          SFTCOMP2
     C                   ADD       CNT4          SFTCOMPA2
     C                   END
     C*
     C     MMSHFTCOMP    IFEQ      '3'
     C                   ADD       CNT3          SFTCOMP3
     C                   ADD       CNT4          SFTCOMPA3
     C                   END
     C*
     C                   MOVE      'Y'           MM1030C
     C*
