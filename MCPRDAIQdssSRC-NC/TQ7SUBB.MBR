028700 LINKAGE SECTION.
029400 01  DBPARAMETERS.      COPY DBPARMS OF COPYLIB.
       COPY VCOMLINK IN COPYLIB.
       COPY CATREAD  OF COPYLIB.
029800 PROCEDURE DIVISION USING DBPARAMETERS VIEW-COMAREA
                            CATREAD-PARMS.
030200 BEGIN-PGM.
           PERFORM 1-HSK THRU 1-HSK-CONT.
           PERFORM 6-MAIN THRU 6-MAIN-LOOP UNTIL VIEW-LASTKEY = 3.
       2-EOJ.
           CLOSE DISPLAY-FILE.
           CLOSE WO-CRAFTS-MSTR-FILE.
           CLOSE WO-LAST-NUM-USED.
           CLOSE WO-PLANNED-FILE.
           CLOSE WO-SCHEDULE-FILE.
           CLOSE WO-ZONE-PRTY-FILE.
           GOBACK.
       1-HSK.
030400     MOVE 0 TO DATE-MODE.
           OPEN I-O DISPLAY-FILE.
           OPEN INPUT WO-CRAFTS-MSTR-FILE.
           OPEN INPUT WO-LAST-NUM-USED.
           OPEN INPUT WO-PLANNED-FILE.
           OPEN INPUT WO-SCHEDULE-FILE.
           OPEN INPUT WO-ZONE-PRTY-FILE.
       1-HSK-CONT.
030800     MOVE SPACES TO SELECT-BUFFER ERROR-BUFFER.
032100     CALL "TPWORD" USING PASSWORD-INFORMATION.
032500     IF PASSWORD-FLAG = "N" GO TO 2-EOJ.
032600     ACCEPT CUR-DATE-WA FROM DATE.
           MOVE 0 TO COND-WORD.
           MOVE 1 TO ACT-KEY.
           READ WO-LAST-NUM-USED INTO LAST-WO-BUFF
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF WLNU-STATUS NOT = "00" MOVE 17 TO COND-WORD.
           IF COND-WORD = 17 MOVE 1 TO DATE-FLAG-SW.
           MOVE DATE-FLAG-SW TO DATE-FLAG.
032700     MOVE DATE-FLAG TO DATE-CODE.
032800     MOVE CUR-DATE-MM TO DATE-IN-MD.
032900     MOVE CUR-DATE-DD TO DATE-IN-DM.
033000     MOVE CUR-DATE-YY TO DATE-IN-YY.
033100     CALL "TDATECHK" USING DATE-CHECK-AREA.
033200     MOVE DATE-OUT-MD TO D-MM.
033300     MOVE DATE-OUT-DM TO D-DD.
033400     MOVE DATE-OUT-YY TO D-YY.
      *------- 01/04/2010:  UPDATED WORKORDER LETTER SUFFIX LOGIC.
033500*    IF CUR-DATE-YR = "0" MOVE "A" TO YEAR-DISP
033600*    ELSE
033700*    IF CUR-DATE-YR = "1" MOVE "B" TO YEAR-DISP
033800*    ELSE
033900*    IF CUR-DATE-YR = "2" MOVE "C" TO YEAR-DISP
034000*    ELSE
034100*    IF CUR-DATE-YR = "3" MOVE "D" TO YEAR-DISP
034200*    ELSE
034300*    IF CUR-DATE-YR = "4" MOVE "E" TO YEAR-DISP
034400*    ELSE
034500*    IF CUR-DATE-YR = "5" MOVE "F" TO YEAR-DISP
034600*    ELSE
034700*    IF CUR-DATE-YR = "6" MOVE "G" TO YEAR-DISP
034800*    ELSE
034900*    IF CUR-DATE-YR = "7" MOVE "H" TO YEAR-DISP
035000*    ELSE
035100*    IF CUR-DATE-YR = "8" MOVE "J" TO YEAR-DISP
035200*    ELSE
035300*    IF CUR-DATE-YR = "9" MOVE "K" TO YEAR-DISP
035400*    ELSE
035500*    MOVE " " TO YEAR-DISP.

           CALL "CMMISYR" USING MMIS-LETTER.
           MOVE MMIS-LETTER    TO YEAR-DISP.
      *-------

035700 6-MAIN.
035800     MOVE "FQ7BINQ" TO VIEW-CFNAME.
           MOVE SPACES TO SELECT-BUFFER.
036000     MOVE YEAR-DISP TO WO-YR.
           MOVE ERROR-BUFFER TO SELECT-MSG-LINE.
           MOVE SELECT-BUFFER TO DSPLY-REC.
           PERFORM 99-SCREEN-WRITE.
           PERFORM 98-SCREEN-READ.
           MOVE SPACES TO ERROR-BUFFER.
           MOVE DSPLY-REC TO SELECT-BUFFER.
037800     IF VIEW-LASTKEY = 1 OR 3 GO TO 2-EOJ.
038000     IF VIEW-LASTKEY NOT = 0 GO TO 6-MAIN.
038400     IF WO-BUF = SPACES
038500         MOVE 49004 TO CATREAD-MSG-NUMBER
038700         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
038800         MOVE TRUE-VAL TO INDS (1) INDS (99)
039000         GO TO 6-MAIN.
039100     CALL "TALWONO" USING WO-NUM-BUF RETURN-CODE.
039400     MOVE 0 TO COND-WORD.
039500     MOVE WO-NUM-BUF TO WONUM OF WPFREC.
039600     START WO-PLANNED-FILE KEY IS = EXTERNALLY-DESCRIBED-KEY
039700         INVALID KEY    MOVE 17 TO COND-WORD.
           IF WPF-STATUS NOT = "00" MOVE 17 TO COND-WORD.
039800     IF COND-WORD = 17
039900         MOVE 35040 TO CATREAD-MSG-NUMBER
040100         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
040200         MOVE TRUE-VAL TO INDS (1) INDS (99)
040400         GO TO 6-MAIN.
041100     READ WO-PLANNED-FILE NEXT INTO WO-PLANNED-DATA
041200         AT END    MOVE 17 TO COND-WORD.
           IF WPF-STATUS NOT = "00" MOVE 17 TO COND-WORD.
041300     IF COND-WORD = 17
041400         MOVE 35040 TO CATREAD-MSG-NUMBER
041600         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
041700         MOVE TRUE-VAL TO INDS (1) INDS (99)
041900         GO TO 6-MAIN.
042700     IF DAT1-BUF NOT = SPACES
042800         IF DAT1-BUF NOT NUMERIC
042900             MOVE 35014 TO CATREAD-MSG-NUMBER
043100             PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
043200             MOVE TRUE-VAL TO INDS (2) INDS (99)
043400             GO TO 6-MAIN
043500         ELSE
043600         NEXT SENTENCE
043700     ELSE
043800     MOVE 30028 TO CATREAD-MSG-NUMBER
044000     PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
044100     MOVE TRUE-VAL TO INDS (2) INDS (99)
044300     GO TO 6-MAIN.
044400
044500     IF DAT1-YY-9 IS NUMERIC
044600         IF DATE-FLAG = 1
044700             IF DAT1-MM-9 > 0 AND DAT1-MM-9 < 13
044800                 IF DAT1-DD-9 > 0 AND DAT1-DD-9 < 32
044900                     NEXT SENTENCE
045000                 ELSE
045100                 MOVE 35030 TO CATREAD-MSG-NUMBER
045300                 PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
045400                 MOVE TRUE-VAL TO INDS (2) INDS (99)
045600                 GO TO 6-MAIN
045700             ELSE
045800             MOVE 35031 TO CATREAD-MSG-NUMBER
046000             PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
046100             MOVE TRUE-VAL TO INDS (2) INDS (99)
046300             GO TO 6-MAIN
046400         ELSE
