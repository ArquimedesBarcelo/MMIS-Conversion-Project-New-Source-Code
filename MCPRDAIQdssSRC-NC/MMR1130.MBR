     C**************************************************************************
     C*
     C                   read      MCRLMM1112                             99
     C     *IN99         DOWEQ     '0'
     C*
     C     MMWONUM       CHAIN     MCRPMM1100
     C                   MOVE      DATESTRT      MXDATESTRT
     C                   MOVE      TIMESTRT      MXTIMESTRT
     C                   MOVE      DATECOMP      MXDATECOMP
     C                   MOVE      TIMECOMP      MXTIMECOMP
     C     DATESCHD      IFNE      '        '
     C     TIMESCHD      ANDEQ     '    '
     C                   MOVE      '0000'        TIMESCHD
     C                   END
     C                   MOVE      DATESCHD      MXDATESCHD
     C                   MOVE      TIMESCHD      MXTIMESCHD
     C     MXDATECOMP    IFNE      '        '
     C     MXDATESTRT    ANDEQ     '        '
     C                   MOVE      MXTIMECOMP    MXTIMESTRT
     C                   MOVE      MXDATECOMP    MXDATESTRT
     C                   END
     C     MXTIMECOMP    IFNE      '    '
     C     MXTIMESTRT    ANDEQ     '    '
