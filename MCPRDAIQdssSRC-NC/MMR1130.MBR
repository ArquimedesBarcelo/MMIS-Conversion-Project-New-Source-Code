     C*
     C     *IN44         DOWEQ     '0'
     C*
     C     TIMEFLAG      IFEQ      '1'
     C                   MOVE      MXTIMERECD    CHKTIME
     C                   MOVE      MXTIMERECD    CHKTIMEN
     C     MXDATERECD    IFGE      CT60DATE
     C     CHKTIMEN      IFGE      CT60START
     C                   READ      MCRPMM1050
     C                   GOTO      GOON
     C                   ELSE
     C                   GOTO      GOON
     C                   END
     C                   END
     C                   END
     C*
     C     TIMEFLAG      IFEQ      '2'
     C                   MOVE      MXTIMESTRT    CHKTIME
     C                   MOVE      MXTIMESTRT    CHKTIMEN
     C     MXDATESTRT    IFGE      CT60DATE
     C     CHKTIMEN      IFGE      CT60START
     C                   READ      MCRPMM1050
     C                   GOTO      GOON
     C                   ELSE
     C                   GOTO      GOON
     C                   END
     C                   END
     C                   END
     C*
     C     TIMEFLAG      IFEQ      '3'
     C                   MOVE      MXTIMECOMP    CHKTIME
     C                   MOVE      MXTIMECOMP    CHKTIMEN
     C     MXDATECOMP    IFGE      CT60DATE
     C     CHKTIMEN      IFGE      CT60START
     C                   READ      MCRPMM1050
     C                   GOTO      GOON
     C                   ELSE
     C                   GOTO      GOON
     C                   END
     C                   END
     C                   END
     C*
     C     TIMEFLAG      IFEQ      '4'
     C                   MOVE      MXTIMESCHD    CHKTIME
     C                   MOVE      MXTIMESCHD    CHKTIMEN
     C     MXDATESCHD    IFGE      CT60DATE
     C     CHKTIMEN      IFGE      CT60START
     C                   READ      MCRPMM1050
     C                   GOTO      GOON
     C                   ELSE
     C                   GOTO      GOON
     C                   END
     C                   END
     C                   END
     C*
     C                   READ      MCRPMM1060                             44
     C*
     C     XPLANT        IFEQ      'TOPEKA'
     C     EQPDEPT       CHAIN     MCRPMM1080
     C                   IF        %found(MCFPMM1080)
     C                   Z-ADD     2250          CT60START
     C                   END
     C                   END
     C*
     C                   END
     C*
     C     GOON          TAG
     C*
     C     CTNUMSHIFT    IFEQ      2
     c*
     C     CHKTIMEN      IFGE      CTSTART1ST
     C     CHKTIMEN      ORLT      CTSTART2ND
     C                   MOVE      CTSTART1ST    SHIFTSTART
     C                   MOVE      '1'           SHIFTKEY
     C                   ELSE
     C                   MOVE      '2'           SHIFTKEY
     C                   MOVE      CTSTART2ND    SHIFTSTART
     C                   END
     C*
     C                   END
     C*
     C     CTNUMSHIFT    IFEQ      3
     C*
     C     XPLANT        IFEQ      'TOPEKA'
     C     EQPDEPT       CHAIN     MCRPMM1080
     C                   IF        %found(MCFPMM1080)
     C                   Z-ADD     2250          CTSTART1ST
     C                   Z-ADD     0650          CTSTART2ND
     C                   Z-ADD     1450          CTSTART3RD
     C************       MOVE      ' '           CTCREW1ST
     C***************    MOVE      ' '           CTCREW2ND
     C*************      MOVE      ' '           CTCREW3RD
     C                   END
     C                   END
     C*
     C     CHKTIMEN      IFGE      CTSTART1ST
     C     CHKTIMEN      ORLT      CTSTART2ND
     C                   MOVE      CTSTART1ST    SHIFTSTART
     C                   MOVE      '1'           SHIFTKEY
     C*
     C                   ELSE
     C*
     C*
     C     CHKTIMEN      IFGE      CTSTART2ND
     C     CHKTIMEN      ANDLT     CTSTART3RD
     C                   MOVE      '2'           SHIFTKEY
     C                   MOVE      CTSTART2ND    SHIFTSTART
     C                   ELSE
     C                   MOVE      '3'           SHIFTKEY
     C                   MOVE      CTSTART3RD    SHIFTSTART
     C                   END
     C                   END
     C                   END
     C*
     C     60            MULT      CHKHH         CALCMOD
     C                   ADD       CHKMM         CALCMOD
     C*
     C     60            MULT      STSHH         OFFSET
     C                   ADD       STSMM         OFFSET
     C*
     C     1440          SUB       OFFSET        ADDIN
     C*
     C     CHKTIMEN      IFGE      CTSTART1ST
     C                   SUB       ADDIN         CALCMOD
     C                   MOVE      CALCMOD       ALPHAMOD
     C                   MOVE      ALPHAMOD      PRODMOD
     C                   ELSE
     C                   ADD       OFFSET        CALCMOD
     C                   MOVE      CALCMOD       ALPHAMOD
     C                   MOVE      ALPHAMOD      PRODMOD
     C                   END
     C*
     C                   MOVE      PRODMOD       MOD
     C
     C     LOADEND       TAG
     C
     C                   endsr
     C/EJECT
     C     ASHE          BEGSR
     C*
     C     TIMEFLAG      IFEQ      '1'
     C                   MOVE      MXTIMERECD    CHKTIME
     C                   MOVE      MXTIMERECD    CHKTIMEN
     C     MXDATERECD    IFGE      CT60DATE
     C     CHKTIMEN      IFlt      CT60START
     C                   READp     MCRPMM1050
     C                   GOTO      GOON1
     C                   ELSE
     C                   GOTO      GOON1
     C                   END
     C                   END
     C                   END
     C*
     C     TIMEFLAG      IFEQ      '2'
     C                   MOVE      MXTIMESTRT    CHKTIME
     C                   MOVE      MXTIMESTRT    CHKTIMEN
     C     MXDATESTRT    IFGE      CT60DATE
     C     CHKTIMEN      IFlt      CT60START
     C                   READP     MCRPMM1050
     C                   GOTO      GOON1
     C                   ELSE
     C                   GOTO      GOON1
     C                   END
     C                   END
     C                   END
     C*
     C     TIMEFLAG      IFEQ      '3'
     C                   MOVE      MXTIMECOMP    CHKTIME
     C                   MOVE      MXTIMECOMP    CHKTIMEN
     C     MXDATECOMP    IFGE      CT60DATE
     C     CHKTIMEN      IFlt      CT60START
     C                   READp     MCRPMM1050
     C                   GOTO      GOON1
     C                   ELSE
     C                   GOTO      GOON1
     C                   END
     C                   END
     C                   END
     C*
     C     TIMEFLAG      IFEQ      '4'
     C                   MOVE      MXTIMESCHD    CHKTIME
     C                   MOVE      MXTIMESCHD    CHKTIMEN
     C     MXDATESCHD    IFGE      CT60DATE
     C     CHKTIMEN      IFlt      CT60START
     C                   READp     MCRPMM1050
     C                   GOTO      GOON1
     C                   ELSE
     C                   GOTO      GOON1
     C                   END
     C                   END
     C                   END
     C*
     C*
     C     GOON1         TAG
     C*
     c*
     C     CHKTIMEN      IFGE      CTSTART1ST
     C     CHKTIMEN      andle     CTSTART2ND
     C                   MOVE      CTSTART1ST    SHIFTSTART
     C                   MOVE      '1'           SHIFTKEY
     C                   ELSE
     C                   MOVE      '2'           SHIFTKEY
     C                   MOVE      CTSTART2ND    SHIFTSTART
     C                   END
     C*
     C*
     C*
     C     60            MULT      CHKHH         CALCMOD
     C                   ADD       CHKMM         CALCMOD
     C*
     C     CALCMOD       IFLE      450
     C                   ADD       990           CALCMOD
     C                   ELSE
     C                   SUB       450           CALCMOD
     C                   END
     C*
     C                   MOVE      CALCMOD       ALPHAMOD
     C                   MOVE      ALPHAMOD      PRODMOD
     C*
     C                   MOVE      PRODMOD       MOD
     C
     C                   endsr
