       LINKAGE SECTION.
       01  ISCR-RET-CODE                 PIC S9(4) BINARY.
       01  BASE                          PIC X(24).
       01  MMISA                         PIC X(24).
       COPY DBSTAT     IN COPYLIB.
       COPY VCOMLINK   IN COPYLIB.
       COPY LANGSUB    IN COPYLIB.
       COPY TISSCRWS   IN COPYLIB.
       01 PASSED-MPLTINFO-COMP           PIC X(4).
       COPY ESCNAME   IN COPYLIB.

       PROCEDURE DIVISION USING ISCR-RET-CODE, BASE, MMISA,
           STATUS-AREA, VIEW-COMAREA, LANGUAGE-PARMS, ISCR-DATA,
           PASSED-MPLTINFO-COMP, ESC-NAME.
       1-HOUSEKEEP SECTION.
       1-BEGIN-HOUSEKEEP.

           MOVE 0 TO ISS-QTY-SAVE, RSRVD-THIS-WO, AVAIL,
             AVAIL-THIS-WO, SUB, SUB1, SUB2,
             SUB4, DUP-SUB, TABLE-LIMIT, TOTAL-QTY.
           MOVE "N" TO ONHAND-ERR1-FLAG, ONHAND-ERR2-FLAG,
             PRINTER-FOUND-FLAG.
           MOVE 2                        TO  SRF-MODE.
      *------ FOR IBM, WE ALLOW THE INQUIRY ANY TIME SINCE WE
      *------ DONT HAVE TO WORRY ABOUT STACK OVERFLOW
      *------ FOR IBM ONLY ------*
      *    MOVE ZERO                     TO  ISCR-RET-CODE.
      *------ FOR IBM ONLY ------*

           MOVE "CW"                     TO  STORES-COMAREA.
           MOVE PASSED-MPLTINFO-COMP     TO  SRF-MPLTINFO-COMPANY.

CAY02      OPEN INPUT MPLTINFO-PK-I.


      *------5/2/97 GET FRANCHISE TABLE.
           MOVE "FRAN"                   TO  PLT-ARG.
           MOVE 0 TO COND-WORD.
           PERFORM 9999-GETKEY-MPLTINFO-PK-I.
           IF NO-ENTRY
               MOVE SPACES               TO   FRAN-TABLE
           ELSE
               MOVE MPLTINFO-FRANCHISES  TO   FRAN-TABLE.

      *--------- GET PLANT NUMBER.
           MOVE "P 01"                   TO   PLT-ARG.
           MOVE 0                        TO   COND-WORD.
           PERFORM 9999-GETKEY-MPLTINFO-PK-I.
           MOVE MPLTINFO-COMPANY         TO   SAVE-PLT.

      *--------- FIND OUT IF THIS PLANT IS USING SAP.
           MOVE "SAP "                   TO  PLT-ARG.
           MOVE 0 TO COND-WORD.
           PERFORM 9999-GETKEY-MPLTINFO-PK-I.
           IF NO-ENTRY
               MOVE "N"                  TO  SAP-SEND-SWK
               MOVE "Y"                  TO  SAP-PRINT-SWK
           ELSE
               MOVE MPLTINFO-SAP-SEND-SWK    TO  SAP-SEND-SWK
               MOVE MPLTINFO-SAP-PRINT-SWK   TO  SAP-PRINT-SWK.


      *--------- FIND OUT IF PLANT IS SENDING REQS TO R/3.
           MOVE "PREQ"                   TO   PLT-ARG.
           MOVE 0                        TO   COND-WORD.
           PERFORM 9999-GETKEY-MPLTINFO-PK-I.
           MOVE MPLTINFO-REQ-SYNR3-SW    TO   SAVE-REQ-SYNR3-SW.

CAY02 *--------- DISABLE AKRON LOGIC BY SUBSTITUTING DUMMY PLANT NUM
CAY02 *--------- IF AKRON PLANT ON SAP.
CAY02      IF AKRON-PLANT AND SAVE-REQ-SYNR3-SW = "Y"
CAY02          MOVE DUMMY-PLT-NUM        TO  SRF-MPLTINFO-COMPANY.

      *---------- FIND OUT IF THIS IS A MULTIPLE STOREROOM PLANT.
      *---------- NOTE: THERE ARE 2 TYPES OF MULTIPLE STOREROOM PLANTS:
      *----------    1.  EACH CODE IS AUTOMATICALLY ASSUMED TO BE
      *----------        "MULTIPLE STOREROOM".
      *----------    2.  A CODE IS "MULTIPLE STOREROOM" ONLY IF 1 OR MORE
      *----------        OF THE BINS HAS A PREFIX ('A-', 'B-', ETC).  IF NOT
      *----------        IT IS ASSUMED THE USER SELECTED THE CORRECT STOREROOM
      *----------        ON THE WORKSHEET AND CAN WITHDRAW THE ENTIRE QUANTITY
      *----------        IN ALL BINS.
           MOVE "ST"                     TO  MPLTINFO-STR-ARG-STR.
           MOVE MPLTINFO-STR-ARG         TO  PLT-ARG.
           PERFORM 9999-GETKEY-MPLTINFO-PK-I.
           IF NO-ENTRY
               MOVE "N"                  TO  MULT-STR-FLAG
               MOVE "N"                  TO  ALWAYS-MULT-STR-CODE-FLAG
               MOVE "Y"                  TO  WO-OVERRD-ENTRY
               MOVE "Y"                  TO  WO-OVERRD-EXP
               MOVE "N"                  TO  ENTRY-OVERRD-EXP
               MOVE "N"                  TO  WS-PW-SW
               MOVE "N"                  TO  VALID-EMPL-CRAFTWS
               MOVE "N"                  TO  VALID-EMPL-STORES
               MOVE "Y"                  TO  PRINT-SINGLE-ISS-FLAG
               MOVE "Y"                  TO  PRINT-MULT-ISS-FLAG
               MOVE "N"                  TO  MULTI-INSTEAD-RW
               MOVE 1                    TO  ADV-AFTER-SINGLE
               MOVE 2                    TO  WS-ITEMS-SPLIT
               MOVE 1                    TO  ADV-AFTER-LE-X-WS
               MOVE 1                    TO  ADV-AFTER-GT-X-WS
           ELSE
               MOVE MPLTINFO-ST          TO  MULTIPLE-STR-DATA.

           MOVE "PLAN"                   TO  PLT-ARG.
           PERFORM 9999-GETKEY-MPLTINFO-PK-I.
           MOVE PRIMARY-LANGUAGE         TO  INQ-MPLT-DDESC-LANG.
           MOVE SECONDARY-LANGUAGE       TO  INQ-MPLT-DDESC2-LANG.

           PERFORM 9999-OPEN-STUFF.

           ACCEPT YMD-SHORT FROM DATE.

           MOVE LANG-ERCAT-GNAME2        TO  FORM-GNAME2.

           MOVE SPACES                   TO  WORK-LIST-TABLE.
           MOVE 0                        TO  SUB1.
       11-INIT-LOOP.
           ADD 1                         TO  SUB1.
           IF SUB1 > 14
               GO TO 11-IL-X.
           MOVE 0  TO WLT-QTY (SUB1, 1), WLT-QTY (SUB1, 2),
             WLT-QTY (SUB1, 3), WLT-QTY (SUB1, 4), WLT-QTY (SUB1, 5)
             WLT-QTY (SUB1, 6).
           GO TO 11-INIT-LOOP.
       11-IL-X.

           PERFORM 6-WORK-LIST THRU 66-WL-X.

CAY02 *---------- RESET PLANT NUMBER FOR AN AKRON PLANT.
CAY02      IF SRF-MPLTINFO-COMPANY = DUMMY-PLT-NUM
CAY02          MOVE SAVE-PLT             TO  SRF-MPLTINFO-COMPANY.

           GO TO 2-GOBACK.

       2100-BLOWUP.
           MOVE "TSUBCRWS"               TO  BU-PGM-NAME.
           MOVE PARA-POS-1               TO  BU-DISPLAY-FLD (4).
           MOVE PARA-POS-2               TO  BU-DISPLAY-FLD (5).
           MOVE WL-ARG                   TO  BU-DISPLAY-FLD (2).
           MOVE DE-CODE (1)              TO  BU-DISPLAY-FLD (3).
           MOVE DE-CODE (2)              TO  BU-DISPLAY-FLD (4).
           MOVE RET-CODE                 TO  BU-DISPLAY-FLD (1).
           CALL "TBLOWUP" USING BASE BU-PGM-NAME STATUS-AREA
             VIEW-COMAREA FILE-STATUS BU-DISPLAY-MSG
             BU-DISPLAY-FLDS.

       2-GOBACK.
           PERFORM 9999-CLOSE-STUFF.
           GOBACK.

       4-INIT-FLDS.
           ADD 1                         TO  SUB1.
           MOVE 0                        TO  BU-DISPLAY-FLD9 (SUB1).
           MOVE SPACES                   TO  BU-DISPLAY-FLD (SUB1).

       4-SELECT-LETTER.
CAY03 *------- 01/04/2010:  UPDATED WORKORDER LETTER SUFFIX LOGIC.
CAY03 *    IF YY-LAST-DIGIT = "0"
CAY03 *        MOVE "A"                  TO  YEAR-LETTER
CAY03 *    ELSE
CAY03 *    IF YY-LAST-DIGIT = "1"
CAY03 *        MOVE "B"                  TO  YEAR-LETTER
CAY03 *    ELSE
CAY03 *    IF YY-LAST-DIGIT = "2"
CAY03 *        MOVE "C"                  TO  YEAR-LETTER
CAY03 *    ELSE
CAY03 *    IF YY-LAST-DIGIT = "3"
CAY03 *        MOVE "D"                  TO  YEAR-LETTER
CAY03 *    ELSE
CAY03 *    IF YY-LAST-DIGIT = "4"
CAY03 *        MOVE "E"                  TO  YEAR-LETTER
CAY03 *    ELSE
CAY03 *    IF YY-LAST-DIGIT = "5"
CAY03 *        MOVE "F"                  TO  YEAR-LETTER
CAY03 *    ELSE
CAY03 *    IF YY-LAST-DIGIT = "6"
CAY03 *        MOVE "G"                  TO  YEAR-LETTER
CAY03 *    ELSE
CAY03 *    IF YY-LAST-DIGIT = "7"
CAY03 *        MOVE "H"                  TO  YEAR-LETTER
CAY03 *    ELSE
CAY03 *    IF YY-LAST-DIGIT = "8"
CAY03 *        MOVE "J"                  TO  YEAR-LETTER
CAY03 *    ELSE
CAY03 *        MOVE "K"                  TO  YEAR-LETTER.
CAY03
CAY03      CALL "CMMISYR" USING MMIS-LETTER.
CAY03      MOVE MMIS-LETTER    TO YEAR-LETTER.
CAY03 *-------


       4-CHECK-DUPLICATE-CODES.
           SUBTRACT 1 FROM DUP-SUB.
           IF DE-CODE (SUB1) = DE-CODE (DUP-SUB)
               MOVE 03108                TO  CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               COMPUTE SRF-ERROR-FLD = (3 * DUP-SUB) + 4
               MOVE DE-CODE (SUB1)       TO  MSG-FLD
               GO TO 4-CDC-X.
       4-CDC-X.
           EXIT.

       4-CLEAR-FORM.
           MOVE SPACES                   TO  MESSAGE-BUFFER.
           MOVE SPACES                   TO  DE-FIELDS-1.

       6-WORK-LIST.
       61-GET-FORM.
           MOVE "61-GET-FORM"            TO  SAVE-PARA-1.
      *---------- FOR AKRON AND FOR MULTIPLE STOREROOM PLANTS, WE HAVE A
      *---------- SEPARATE SCREEN.
      *---------- FOR AKRON SAP CONVERSION, DO WE STILL NEED A SEPARATE
      *----------   VERSION OF THE SCREEN?
           IF AKRON-PLANT
               IF SAVE-REQ-SYNR3-SW = "Y"
                  MOVE "CRAFTSSAPA"      TO  VIEW-NFNAME
               ELSE
                  MOVE "CRAFTSMANA"      TO  VIEW-NFNAME
               END-IF
           ELSE
           IF MULT-STR-PLANT
               IF SAVE-REQ-SYNR3-SW = "Y"
                  MOVE "CRAFTSSAPM"      TO  VIEW-NFNAME
               ELSE
                  MOVE "CRAFTSMANM"      TO  VIEW-NFNAME
               END-IF
           ELSE
               IF SAVE-REQ-SYNR3-SW = "Y"
                  MOVE "CRAFTSSAP"       TO  VIEW-NFNAME
               ELSE
                  MOVE "CRAFTSMAN"       TO  VIEW-NFNAME
               END-IF.
           PERFORM 9999-GETNEXTFORM.


      *---------- FROM THE "XEXECUTV" PROGRAM OF MMIS, THE CODE INQUIRYS
      *---------- THAT CAN BE CALLED FROM THIS PROGRAM END UP BEING TOO MANY
      *---------- LEVELS DEEP OF SUBPROGRAMS.  (STACK OVERFLOW OCCURS).
      *---------- THEREFORE WE HAVE A FLAG WHEN CALLING THIS PROGRAM TO DISALLO

      *---------- THIS FUNCTION KEY.
           IF ISCR-RET-CODE = 1
               MOVE "   f3           "   TO  KEY-LABEL
               MOVE 3                    TO  KEY-NUM
               PERFORM 9999-SETKEYLABEL
               MOVE "   f6           "   TO  KEY-LABEL
               MOVE 6                    TO  KEY-NUM
               PERFORM 9999-SETKEYLABEL
           ELSE
      *        "MANUFACTINQUIRY "  - FOR F3 FUNCTION KEY
               MOVE 13044                TO  CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER       TO  KEY-LABEL
               MOVE 3                    TO  KEY-NUM
               PERFORM 9999-SETKEYLABEL
      *        "KWRD/MODINQUIRY " - FOR F6 FUNCTION KEY
               MOVE 11019                TO  CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER       TO  KEY-LABEL
               MOVE 6                    TO  KEY-NUM
               PERFORM 9999-SETKEYLABEL.

           PERFORM 4-CLEAR-FORM.
       611-PUT-LETTER.
           MOVE "611-PUT-LETTER"         TO  SAVE-PARA-1.
      **************************************************************
      **   THE 7TH BYTE OF WO WILL BE D IF 83, E IF 84, ETC.      **
      **   THIS LETTER IS PUT INTO THE WO FIELD TO AID THE CRAFTS-**
      **   MAN.                                                   **
      **************************************************************
      *---------- AKRON WILL NOT HAVE THE LETTERS IN WORKORDER NUMBER.
           IF AKRON-PLANT
               NEXT SENTENCE
           ELSE
               PERFORM 4-SELECT-LETTER.

      *---------- IF THIS SUBPROGRAM WAS CALLED WITH DATA FOR THE
      *---------- SCREEN, PUT THE DATA INTO THE SCREEN.  IF WORKORDER
      *---------- OR PART1 ARE GREATER THAN SPACES, THIS TELLS US THAT
      *---------- THE CALLING PROGRAM WANTED INITAL DATA ON SCREEN.
           IF ISCR-WO-NUM = SPACES AND ISCR-PART (1) = SPACES
               NEXT SENTENCE
           ELSE
               MOVE ISCR-WO-NUM          TO  DE-WO
               MOVE ISCR-CC-NUM          TO  DE-EMPL
               PERFORM VARYING SUB FROM 1 BY 1 UNTIL SUB > 8
                   MOVE ISCR-PART (SUB)  TO  DE-CODE (SUB)
               END-PERFORM
               IF AKRON-PLANT
                   MOVE "3 "             TO  DE-CHARGE-DEPT-5-6.

       62-SHOW-FORM.
           MOVE SPACES                   TO  WORK-LIST-TABLE.
           MOVE "62-SHOW-FORM"           TO  SAVE-PARA-1.
      *---------- IF CODE-INQ-NOT-ALLOWED FLAG SET, DONT ALLOW THE F3,
      *---------- OTHERWISE ALLOW IT.  f1 TAB TO PLANNER, f2 MATERIAL INQUIRY
      *---------- f3 CODE INQUIRY, f4 REFRESH, f5 PRINT, f6 INVALID,
      *---------- f7 CLEAR FORM, f8 EXIT
           IF ISCR-RET-CODE = 1
               MOVE "I"                  TO  SRF-FKEY (HP-F3-KEY),
                                              SRF-FKEY (6).
           MOVE 2                        TO  SRF-KEYSET.
           PERFORM 9999-DO-SCREEN-1.

           MOVE VIEW-LASTKEY             TO  SAVE-VIEW-LASTKEY.
           IF VIEW-LASTKEY = EXIT-PROGRAM
               GO TO 66-WL-X.
           IF VIEW-LASTKEY = F7-KEY
               IF AKRON-PLANT
                   MOVE SPACES           TO  DE-FIELDS-1
                   GO TO 62-SHOW-FORM
               ELSE
                   MOVE SPACES           TO  DE-FIELDS-1
                   PERFORM 4-SELECT-LETTER
                   GO TO 62-SHOW-FORM.
      *------ 'SINQMFR' DOES BOTH KEYWORD AND MANUFACT INQUIRIES
           IF VIEW-LASTKEY = HP-F3-KEY OR F6-KEY
               PERFORM 681-CALL-SINQMFR THRU 682-CS-X
               GO TO 62-SHOW-FORM.

           IF VIEW-LASTKEY = F2-KEY
               PERFORM 671-MATERIAL-STATUS THRU 672-MS-X
               GO TO 62-SHOW-FORM.
           IF VIEW-LASTKEY = F1-KEY
               MOVE 33                   TO  SRF-CURSOR-FLD
               GO TO 62-SHOW-FORM.


       632-EDIT-STOREROOM.
      *------ FOR AKRON PLANTS, MULTIPLE STOREROOMS ARE ENABLED, BUT FOR
      *------ MULTIPLE DATABASE ONLY.  FOR "MULTIPLE STOREROOM" PLANTS,
      *------ MULTIPLE STORERMS ARE ENABLED IN SAME DATABASE BY USING
      *------ THE STORERM LOCATIONS.  FOR BOTH OF THESE CASES, THE USER
      *------ MUST DESIGNATE WHICH STOREROOM TO PRINT THE WORKSHEET IN.
      *------ FOR SINGLE-STOREROOM PLANTS, THE STR PRINTER IS STORED
      *------ IN THE MPLTINFO-KEY 'ST00'.  IF THAT DOESN'T EXIST, THE
      *------ DEFAULT IS PRINTER 8.
           IF AKRON-PLANT OR MULT-STR-PLANT
               MOVE DE-STOREROOM         TO  MPLTINFO-STR-ARG-STR
               MOVE MPLTINFO-STR-ARG     TO  PLT-ARG
               PERFORM 9999-GETKEY-MPLTINFO-PK-I
               IF NO-ENTRY
      *            "S22: STOREROOM DOES NOT EXIST"
                   MOVE 19022            TO  CATREAD-MSG-NUMBER
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE 8                TO  SRF-ERROR-FLD
                   GO TO 62-SHOW-FORM
               ELSE
                   MOVE MPLTINFO-STR-PRT TO  SPOOL-PRT-STORERM
      *--------------IF MULTI DB PLANT, DO OVRDBF AND OPEN FILES
                   IF AKRON-PLANT
                      PERFORM MULTIDB-OVRDBF-OPEN
                   END-IF
           ELSE
               MOVE "00"                 TO  MPLTINFO-STR-ARG-STR
               MOVE MPLTINFO-STR-ARG     TO  PLT-ARG
               PERFORM 9999-GETKEY-MPLTINFO-PK-I
               IF GOOD-CALL
                   MOVE MPLTINFO-STR-PRT TO  SPOOL-PRT-STORERM
               ELSE
               IF NO-ENTRY
                   MOVE 8                TO  SPOOL-PRT-STORERM.

DCR01      IF  DE-EMPL NOT = SPACE
DCR01      AND DE-EMPL NOT = WS-SAVE-CCNUM
DCR01          IF  DE-WO(1:6) = SPACE
DCR01              PERFORM 9999-GET-WORKORDER-DATA THRU 9999-GWD-EXIT
DCR01          END-IF
DCR01      END-IF.

       631-EDIT-CHARGE-DATA.
      *---------- THE EDITING SUBPROG MUST BE CALLED HERE SO THAT
      *           ERRORS ON THE CHARGE DATA LINE OF THE SCREEN WILL
      *           BE FLAGGED FIRST.  IT MUST BE CALLED AGAIN IN THE
      *           CODE LOOP IN EACH ITERATION BECAUSE THE DEFAULT
      *           EXPENSE CLASS LOGIC IS HANDLED BY THE SUBPROGRAM
      *           FOR EACH CODE.


           MOVE SRF-MPLTINFO-COMPANY     TO  EDIT-PLANT-CODE.
           MOVE DE-CODE (1)              TO  EDIT-CODE.
           MOVE DE-EMPL                  TO  EDIT-EMPL.
           MOVE DE-WO                    TO  EDIT-WO.
           MOVE DE-REQ-DEPT              TO  EDIT-REQ-DEPT.
           MOVE DE-CHARGE-DEPT           TO  EDIT-CHARGE-DEPT,
                                             EDIT-DIR-CHRG-DEPT.
           MOVE SPACES                   TO  EDIT-RESTRICTED-FLG.
           MOVE DE-EXP-CLASS             TO  EDIT-EXP-CLASS.
      *---------- DEFAULT EXP CLASS LOGIC HANDLED IN CODE LOOP BELOW
           MOVE SPACES                   TO  STR-EXPENSE-CLASS.
           MOVE "IS"                     TO  RET-CODE.

           CALL "TIREDIT" USING RET-CODE, BASE, MMISA, PART-WORKAREA,
             STATUS-AREA, EDIT-DATA, MESSAGE-BUFFER, MULTIPLE-STR-DATA,
             STORES-COMAREA, STR-EXPENSE-CLASS, LANGUAGE-PARMS.
           IF MESSAGE-BUFFER NOT = SPACES
                MOVE EDIT-SUB            TO  SRF-ERROR-FLD
      *------CLOSE FILES FOR MULTI DB PLANT
                IF AKRON-PLANT
                   PERFORM MULTIDB-DLTOVR-CLOSE
                END-IF
                GO TO 62-SHOW-FORM.

DB1008*------ Is this person allowed to withdraw using MMIS?
DB1008*------ Check the PER-PAD field in MCFPMM0300 and if it is Y,
DB1008*------ they're restricted & must use SAP PM for storeroom withdrawals.
DB1008*   C132: YOU CANNOT USE MMIS FOR STOREROOM WITHDRAWALS -- USE SAP PM
DB1008*
DB1008     MOVE DE-EMPL TO  PER-CC-ARG.
DB1008     MOVE PER-CC-ARG TO PERCCNUM OF PER-PERSON-PC-REC-I.
DB1008     READ PER-PERSON-PC-I INTO BUF-PER-PERSONNEL
DB1008         INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
DB1008     IF FILE-STATUS = "00"
DB1008         MOVE PER-PAD TO PER-PAD-BREAKDOWN
DB1008         IF PER-PAD-SWFLAG = "Y"
DB1008*           *C132: CANNOT USE MMIS FOR STOREROOM WITHDRAWALS-USE SAP PM
DB1008             MOVE 29132 TO CATREAD-MSG-NUMBER
DB1008             PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
DB1008             MOVE 8 TO SRF-ERROR-FLD
DB1008             GO TO 62-SHOW-FORM.

           MOVE EDIT-WO                  TO  DE-WO.
           MOVE EDIT-REQ-DEPT            TO  DE-REQ-DEPT.
           MOVE EDIT-CHARGE-DEPT         TO  DE-CHARGE-DEPT.
           MOVE EDIT-EXP-CLASS           TO  DE-EXP-CLASS.

CAY109*------ IF AN SAP PLANT, THEN VALIDATE THE PM/BD FIELD.
CAY707*------ INCLUDE OT (FOR OTHER) AS A VALID VALUE.  ALSO ALLOW SINGLE
CAY707*------ CHARACTERS OF B, P, AND O AS SHORTCUTS.
CAY109     IF SAVE-REQ-SYNR3-SW = "Y"
CAY109       IF DE-PM-BD = "BD" OR DE-PM-BD = "PM" OR DE-PM-BD = "OT" OR
CAY707          DE-PM-BD = "B"  OR DE-PM-BD = "P"  OR DE-PM-BD = "O"
CAY109         NEXT SENTENCE
CAY109       ELSE
CAY707         MOVE "PLEASE ENTER VALID VALUE: PM, BD, OT, P, B, O"
CAY109                               TO MESSAGE-BUFFER
CAY109         MOVE 50               TO SRF-ERROR-FLD
CAY109         IF AKRON-PLANT
CAY109           PERFORM MULTIDB-DLTOVR-CLOSE
CAY109         END-IF
CAY109         GO TO 62-SHOW-FORM
CAY109       END-IF
CAY109     END-IF.

           IF DE-CODE (1) = SPACES
            IF DE-CODE (2) = SPACES
             IF DE-CODE (3) = SPACES
              IF DE-CODE (4) = SPACES
               IF DE-CODE (5) = SPACES
                IF DE-CODE (6) = SPACES
                 IF DE-CODE (7) = SPACES
                  IF DE-CODE (8) = SPACES
      *               "C103: CODE IS A REQUIRED FIELD"
                      MOVE 03103         TO  CATREAD-MSG-NUMBER
                      PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                      MOVE 9             TO  SRF-ERROR-FLD
      *------CLOSE FILES FOR MULTI DB PLANT
                      IF AKRON-PLANT
                        PERFORM MULTIDB-DLTOVR-CLOSE
                      END-IF
                      GO TO 62-SHOW-FORM.

      *********************************************************
      **   SUB1 TABLES THROUGH THE DE-CODES AND QTYS.  IN    **
      **   CASE ANY LINES ARE BLANK, SUB4 IS TABLE POSITION  **
      **   OF THE WLT TABLE (WHICH OMITS BLANKS, AND ALSO    **
      **   SAVES OTHER INFO SUCH AS UM, DISB-INSTR, ETC FOR  **
      **   PRINTOUT.                                         **
           MOVE "65-PROCESS-WORKSHEET"   TO  SAVE-PARA-1.
      *********************************************************

           MOVE 0                        TO  SUB1, SUB4, TABLE-LIMIT.
       64-CODE-LOOP.
           MOVE "64-CODE-LOOP"           TO  SAVE-PARA-1.
           ADD 1                         TO  SUB1.
           IF SUB1 > 8
               GO TO 65-PROCESS-WORKSHEET.
           IF DE-CODE (SUB1) = SPACES
               GO TO 64-CODE-LOOP.

           MOVE SUB1                     TO  DUP-SUB.
           MOVE SPACES                   TO  MESSAGE-BUFFER.
           PERFORM 4-CHECK-DUPLICATE-CODES THRU 4-CDC-X
               UNTIL DUP-SUB < 2.
           IF MESSAGE-BUFFER NOT = SPACES
      *        "C108: CANNOT DUPLICATE STORES CODE ON WORKSHEET"
               MOVE 03108                TO  CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE DE-CODE (SUB1)       TO  MSG-FLD
               COMPUTE SRF-ERROR-FLD = (3 * SUB1) + 6
      *------CLOSE FILES FOR MULTI DB PLANT
               IF AKRON-PLANT
                   PERFORM MULTIDB-DLTOVR-CLOSE
               END-IF
               GO TO 62-SHOW-FORM.

           MOVE DE-CODE (SUB1)           TO  CODE-ARG.
           PERFORM 9999-GETKEY-MSTORERM-CD-I.
           IF NO-ENTRY
      *        "S9: STORES CODE DOES NOT EXIST"
               MOVE 19009                TO  CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE CODE-ARG             TO  MSG-FLD
               COMPUTE SRF-ERROR-FLD = (3 * SUB1) + 6
      *------CLOSE FILES FOR MULTI DB PLANT
               IF AKRON-PLANT
                   PERFORM MULTIDB-DLTOVR-CLOSE
               END-IF
               GO TO 62-SHOW-FORM.

           IF STR-STATE = "F"
      *        "C8: CODE FROZEN FOR INVENTORY - NO PROCESSING ALLOWED"
               MOVE 03008                TO  CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE CODE-ARG             TO  MSG-FLD
               COMPUTE SRF-ERROR-FLD = (3 * SUB1) + 6
      *------CLOSE FILES FOR MULTI DB PLANT
               IF AKRON-PLANT
                   PERFORM MULTIDB-DLTOVR-CLOSE
               END-IF
               GO TO 62-SHOW-FORM.

           IF STR-LOC (1)  =  SPACES
      *        "N53: NO PRIMARY BIN LOCATION FOR THIS CODE"
               MOVE 14053                TO  CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE CODE-ARG             TO  MSG-FLD
               COMPUTE SRF-ERROR-FLD = (3 * SUB1) + 6
      *------CLOSE FILES FOR MULTI DB PLANT
               IF AKRON-PLANT
                   PERFORM MULTIDB-DLTOVR-CLOSE
               END-IF
               GO TO 62-SHOW-FORM.

           MOVE "631-EDIT-CHARGE-DATA"   TO  SAVE-PARA-1.
           MOVE DE-CODE (SUB1)           TO  EDIT-CODE.
           IF DE-EXP(SUB1) = SPACES
               MOVE DE-EXP-CLASS         TO  DE-EXP(SUB1)
                                             EDIT-EXP-CLASS
           ELSE
               MOVE DE-EXP(SUB1)         TO  EDIT-EXP-CLASS.
           MOVE DE-REQ-DEPT              TO  EDIT-REQ-DEPT.
           MOVE DE-CHARGE-DEPT           TO  EDIT-CHARGE-DEPT.
           MOVE STR-RESTRICTED-FLG       TO  EDIT-RESTRICTED-FLG.
           MOVE STR-REQ-CHG-OVERRD       TO  EDIT-REQ-CHG-OVERRD.
           MOVE STR-DIR-CHRG-DEPT        TO  EDIT-DIR-CHRG-DEPT.
           MOVE "IS"                     TO  RET-CODE.

           CALL "TIREDIT" USING RET-CODE, BASE, MMISA, PART-WORKAREA,
             STATUS-AREA, EDIT-DATA, MESSAGE-BUFFER, MULTIPLE-STR-DATA,
             STORES-COMAREA, STR-EXPENSE-CLASS, LANGUAGE-PARMS.
           IF RET-CODE = "BU"
               MOVE "TIREDIT ERR 64-CL"  TO  BU-DISPLAY-MSG
               PERFORM 2100-BLOWUP.
           MOVE EDIT-EXP-CLASS TO DE-EXP(SUB1).

           IF MESSAGE-BUFFER NOT = SPACES
      *----------IF EXP ERROR, THEN SET ERR FLD FOR CODE EXP CLASS
               IF EDIT-SUB = 6
                  COMPUTE SRF-ERROR-FLD = 40 + SUB1
               ELSE
                   MOVE EDIT-SUB             TO  SRF-ERROR-FLD
               END-IF
      *------CLOSE FILES FOR MULTI DB PLANT
               IF AKRON-PLANT
                   PERFORM MULTIDB-DLTOVR-CLOSE
               END-IF
               GO TO 62-SHOW-FORM.

      **************************************************************
      **   IF THE ITEM IS A HIGH USAGE ITEM, THE CRAFTSMAN MUST   **
      **   PUT AN 'X' IN THE HIGH-USAGE BOX ON SCREEN TO SHOW     **
      **   THAT HE IS AWARE THE ITEM IS HIGH USAGE, BUT STILL     **
      **   WANTS TO WITHDRAW FROM THE STOREROOM.                  **
      **   NOTE:  THIS CHECK NOT MADE FOR AKRON PLANTS            **
      **************************************************************

           IF NOT AKRON-PLANT
             IF STR-HIGH-USAGE NOT = SPACES
               IF DE-HU (SUB1) NOT = "X"
      *-----       "E2: ENTER 'X' IF ITEM STILL DESIRED FROM STORERM, ITEM HIGH
                   MOVE 05002            TO  CATREAD-MSG-NUMBER
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE STR-HIGH-USAGE   TO  MSG-FLD
                   COMPUTE SRF-ERROR-FLD = (3 * SUB1) + 8
      *------CLOSE FILES FOR MULTI DB PLANT
                   IF AKRON-PLANT
                       PERFORM MULTIDB-DLTOVR-CLOSE
                   END-IF
                   GO TO 62-SHOW-FORM.

           MOVE DE-WO                    TO  QEDIT-WO.
           MOVE "I4"                     TO  RET-CODE.
           MOVE DE-QTY-X (SUB1)          TO  HOLD-QTY.
           MOVE DE-STOREROOM             TO  MULT-STR-STR.
      *------5/2/97 INIT SAVE-BIN-AREA WITH FRANCHISE FOR BINS
           PERFORM VARYING FRAN-SUB FROM 1 BY 1 UNTIL FRAN-SUB > 6
               IF FRAN-TABLE = SPACES
                   MOVE SPACES TO DE-FRAN(FRAN-SUB)
               ELSE
                   SET FRAN-IDX TO 1
                   SEARCH FRAN-ENTRY
                     AT END  MOVE SPACES TO DE-FRAN (FRAN-SUB)
                     WHEN FRAN-ID(FRAN-IDX) = STR-BIN-OWNER (FRAN-SUB)
                      MOVE FRAN-NAME(FRAN-IDX) TO DE-FRAN(FRAN-SUB)
                   END-SEARCH
               END-IF
           END-PERFORM.
           CALL "TQTYEDIT" USING RET-CODE, BASE, STATUS-AREA,
             CODE-ARG, QEDIT-WO, STR-ONHAND, STR-RESERVED,
             STR-LOC-AREA, SAVE-BIN-AREA, HOLD-QTY,
             ISSUED-QTY, RET-SUB, MESSAGE-BUFFER, MULTIPLE-STR-DATA,
             LANGUAGE-PARMS, WARNING-FLAG, WARNING-TYPE,
             WARNING-VALUE, STR-AVG-COST, DE-CHARGE-DEPT-1-4,
             DE-EXP(SUB1), DE-EMPL, STR-UM, STR-MAX, STR-REORDER
             STR-CODE-OWNER FRAN-TABLE.
           IF RET-CODE NOT = "00"
               MOVE "TQTYEDIT ERR 64-CL" TO  BU-DISPLAY-MSG
               PERFORM 2100-BLOWUP.
           MOVE HOLD-QTY                 TO  DE-QTY-X (SUB1).

           IF MESSAGE-BUFFER NOT = SPACES
               COMPUTE SRF-ERROR-FLD = (3 * SUB1) + 7
      *------CLOSE FILES FOR MULTI DB PLANT
                   IF AKRON-PLANT
                       PERFORM MULTIDB-DLTOVR-CLOSE
                   END-IF
               GO TO 62-SHOW-FORM.

           ADD 1                         TO  TABLE-LIMIT, SUB4.

           MOVE DE-CODE (SUB1)           TO  WLT-CODE (SUB4).
           MOVE SAVE-BIN-AREA            TO  FIL-BIN-AREA (SUB4).
           PERFORM VARYING SUB5 FROM 1 BY 1
                   UNTIL SUB5 GREATER THAN 6

               MOVE FIL-BIN (SUB4, SUB5) TO  WLT-BIN (SUB4, SUB5)
               MOVE FIL-QTY (SUB4, SUB5) TO  WLT-QTY (SUB4, SUB5)
      *--------------- MOVE SPACES TO BIN NUMBER IF QTY = 0.
               IF SAP-SEND-SWK = "Y"
                   IF WLT-QTY (SUB4, SUB5) = 0
                       MOVE SPACES       TO  WLT-BIN (SUB4, SUB5)
                   END-IF
               END-IF
           END-PERFORM.
           MOVE EDIT-CHARGE-DEPT         TO  WLT-CHARGE-DEPT (SUB4).
           MOVE DE-WO                    TO  WLT-WO (SUB4).
CAY109*----- USE WORK CENTER FOR PM/BD INDICATOR FOR SAP PLANTS.
CAY109     IF SAVE-REQ-SYNR3-SW = "Y"
CAY707       IF DE-PM-BD = "B"      MOVE "BD" TO  WLT-WORK-CENTER (SUB4)
CAY707       ELSE
CAY707         IF DE-PM-BD = "P"    MOVE "PM" TO  WLT-WORK-CENTER (SUB4)
CAY707       ELSE
CAY707         IF DE-PM-BD = "O"    MOVE "OT" TO  WLT-WORK-CENTER (SUB4)
CAY707       ELSE
CAY109         MOVE DE-PM-BD                  TO  WLT-WORK-CENTER (SUB4)
CAY707       END-IF
CAY109     ELSE
             MOVE DE-WORK-CENTER         TO  WLT-WORK-CENTER (SUB4).
           MOVE DE-EXP(SUB1)             TO  WLT-EXP-CLASS (SUB4).
           MOVE DE-EMPL                  TO  WLT-EMPL (SUB4).
           MOVE STR-UM                   TO  WLT-UM (SUB4).
           MOVE DE-REQ-DEPT              TO  WLT-REQ-DEPT (SUB4).
           MOVE STR-DISB-INSTR           TO  WLT-DISB-INSTR (SUB4).

           GO TO 64-CODE-LOOP.

       65-PROCESS-WORKSHEET.
      *------ WAIT, FIRST WE HAVE TO CHECK THE GUY'S PASSWORD IF
      *------ THE PASSWORD FLAG IS ON: MEXICO WANTS TO FORCE THEM TO
      *------ PUT IN A PASSWORD EVERY TIME THEY WITHDRAW.
           IF WS-PW-SW = "Y"
               MOVE VIEW-NFNAME          TO  SAVE-FORM
               PERFORM 6950-GET-EMPL-MMIS
      *------ FOR HP ONLY  ------*
      *        CALL "TPERPASS" USING VIEW-COMAREA, PER-CC-NUM,
      *          PER-EMP-NAME, PER-PWORD, PWORD-SWITCH, LANGUAGE-PARMS
      *------ FOR HP ONLY  ------*
      *------ FOR IBM ONLY -----*
               CALL "TPERPASS" USING PER-CC-NUM,
                 PER-EMP-NAME, PER-PWORD, PWORD-SWITCH
      *------ FOR IBM ONLY -----*
               PERFORM 9999-GETNEXTFORM
               PERFORM 9999-PUTBUFFER-1
               IF PWORD-SWITCH = "N"
      *            "I54: INVALID PASSWORD - TRY AGAIN"
                   MOVE 09054            TO  CATREAD-MSG-NUMBER
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE SAVE-FORM        TO  VIEW-NFNAME
                   MOVE   1              TO  SRF-ERROR-FLD
      *------CLOSE FILES FOR MULTI DB PLANT
                   IF AKRON-PLANT
                       PERFORM MULTIDB-DLTOVR-CLOSE
                   END-IF
                   GO TO 62-SHOW-FORM
               ELSE
                   MOVE SAVE-FORM        TO  VIEW-NFNAME
      *            ** THEY COULD END UP CHANGING EMPL NUM WITHIN PASS
      *            ** PGM: ONLY IF VALID-EMPL-SW = 'N' AND PW-SW='Y'
                   IF DE-EMPL NOT = PER-CC-NUM
                       MOVE 0            TO  SUB
                       PERFORM 6960-MOVE-EMPL 14 TIMES.

           MOVE EDIT-EXP-CLASS           TO  DE-EXP-CLASS.

      ************************************************************
      **   GIVE A "NOW PROCESSING" OR "OVERRIDDEN...."  MESSAGE **
      ************************************************************
           IF MPLT-MP1-OVERRD-CHG-DEPT = "Y"  OR
              STR-REQ-CHG-OVERRD = "X"        OR
              (ENTRY-OVERRD-EXP = "N"  AND  WO-OVERRD-EXP = "N")
               MOVE 05069                TO  CATREAD-MSG-NUMBER
           ELSE
               MOVE 14002                TO  CATREAD-MSG-NUMBER.
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
           MOVE "Y"                      TO  SRF-MSG-AND-GO.
           PERFORM 9999-SETERROR-1.

       652-CREATE-WORKSHEET.
           MOVE "652-CREATE-WORKSHEET"   TO  SAVE-PARA-1.
           MOVE "MWRKLIST;"              TO  DSET-NAME.
           PERFORM 9999-DSET-LOCK.

           MOVE 0                        TO  WRKL-NO-INC.
           PERFORM 9999-GETKEY-MWRKLIST-WK-O.

      ***  WORKSHEET NUMBER IS INCREMENTED BY ONE FROM LAST WS
      ***  CREATED.  (STORED IN THE SW0000 KEY IN MWRKLIST).
      ***  NOTE THAT IF THE LAST WORKSHEET WAS #9999, THE NEXT
      ***  INCREMENT WOULD BE ZERO.  ATTEMPTING TO CREATE A
      ***  0000 WORKSHEET WOULD RESULT IN DUPLICATE KEY ERROR.

           MOVE WRKLIST-DATE             TO  WL-ARG.
           ADD 1                         TO  WRKL-NO-INC.
           IF WRKL-NO-INC = 0
               ADD 1                     TO  WRKL-NO-INC.
           MOVE WL-ARG                   TO  WRKLIST-DATE.
           PERFORM 9999-UPDATE-MWRKLIST-WK-O.

           ACCEPT YMD-DATE               FROM DATE.

           MOVE WL-ARG                   TO  WRKLIST-KEY.
      *-----INCLUDE CENTURY IN WORKSHEET DATE
           MOVE YMD-DATE                 TO  WRKLIST-DATE.
           IF YY-SHORT > "70"
               MOVE "19" TO WRKLIST-DATE-CC
           ELSE
               MOVE "20" TO WRKLIST-DATE-CC.

      *-------- IF SENDING STOREROOM WORKSHEETS THROUGH SAPCOMM,
      *-------- DO NO WRITE ENTRY TO MWRKLIST.
           IF SAP-SEND-SWK = "Y"
               NEXT SENTENCE
           ELSE
               PERFORM 9999-PUT-MWRKLIST-WK-O
               PERFORM 9999-UNLOCK.

           MOVE WL-ARG                   TO  LOCK-VALUE.
           PERFORM 9999-MULTI-LOCK.

           MOVE 0                        TO  SUB1.
           MOVE WL-ARG                   TO  WL-KEY.

      *-------- IF SENDING STOREROOM WORKSHEETS THROUGH SAPCOMM,
      *-------- CREATE NEW FILE.
           IF SAP-SEND-SWK = "Y"
               PERFORM 9999-CREATE-NEW-PFM.

       653-PUT-WL-DTL-LOOP.
           MOVE "653-PUT-WL-DTL-LOOP"    TO  SAVE-PARA-1.
           ADD 1                         TO  SUB1.
           IF SUB1 > TABLE-LIMIT
               GO TO 654-UNLOCK-DWLITEM.

           IF WLT-CODE (SUB1) = SPACES
               GO TO 653-PUT-WL-DTL-LOOP.

           MOVE WLT-RCD (SUB1)           TO  WL-RCD-DATA.
           MOVE WLT-EXP-CLASS (SUB1)     TO  WL-EXP-CLASS.
      *-------- IF SENDING STOREROOM WORKSHEETS THROUGH SAPCOMM,
      *-------- WRITE RECORDS TO SW* FILE.
           IF SAP-SEND-SWK = "Y"
               PERFORM 9999-PUT-SWPFM-REC
           ELSE
               PERFORM 9999-PUT-DWLITEM-WK-O.

           GO TO 653-PUT-WL-DTL-LOOP.

       654-UNLOCK-DWLITEM.
           MOVE "654-UNLOCK-DWLITEM"     TO  SAVE-PARA-1.
           PERFORM 9999-UNLOCK.

      *-------- IF SENDING STOREROOM WORKSHEETS THROUGH SAPCOMM,
      *-------- CALL PROGRAM TO SEND FILE.
           IF SAP-SEND-SWK = "Y"
               CLOSE SWPFM-O
               CALL "CLSNDSW" USING CLSNDSW-FILENAME.

      *************************************************
      **  PRINTER.  IF UC AND MATCONT, SEND TO       **
      **  SPECIAL STOREROOM PRINTER                  **
      *************************************************
           IF SRF-MPLTINFO-COMPANY = "129" AND SRF-USERNAME = "MATCONT "
               MOVE 10                   TO  SPOOL-PRT-STORERM.

      **************************************************************
      **   HERE WE MOVE THE MAIN PRINTER NUMBER TO PRINT THE 1ST  **
      **   COPY OF THE WORKSHEET.  THIS WAS PREVIOUSLY SELECTED   **
      **   (IF MGR.STORES, TEST PRINTER, IF UNION CITY AND MATCONT**
      **   GO TO SPECIAL PRINTER, OTHERWISE GO TO STOREROOM PRT.  **
      **************************************************************

      ***  FOR CERTAIN PLANTS USING HALF-SHEET PAPER, THE WS PRT
      ***  PROG MUST ADVANCE TWICE AFTER PRINTING.  THIS IS PASSED
      ***  THRU WS-PARMS.  ALSO, WE WANT TO RING THE PRINTER
      ***  BEEPER, WHICH IS PASSED BY A "B" IN WS-PARMS.

      *    IF SRF-MPLTINFO-COMPANY = "126" OR "153" OR "131"
      *        MOVE "H"   TO  HALF-SHEET-FLAG.
           MOVE "B"                      TO  BELL-FLAG.

      *---------- IF HOME GROUP IS "DBT" - TRAINING DATABASE - USE THE
      *---------- LOCAL PRT NUMBER TO PRINT WORKSHEET (DONT WANT TRAINING
      *---------- WORKSHEETS TO PRINT IN ACTUAL STOREROOM).
      *---------- EXCEPTION FOR MULTIPLE STOREROOM PLANT - LET THE TRAINING
      *---------- USER IN THIS CASE PICK WHICH PRINTER HE WANTS - TRAINING
      *---------- DATABASE MUST HAVE THESE PRINTERS LOADED.

           IF MULT-STR-PLANT
               NEXT SENTENCE
           ELSE
           IF GRPNAME = "DBT"
               MOVE 0                    TO  SPOOL-PRT-STORERM.

           MOVE SPOOL-PRT-STORERM        TO  SPOOL-PRT.
           MOVE DE-PLANNER-DATA          TO  PLANNER-DATA.
           IF AKRON-PLANT
               MOVE "Y"                  TO  AKRON-FLAG.

      *---------- IF THIS IS AN SAP PLANT AND NO PRINT IS REQUIRED,
      *---------- SKIP CALL TO PRINT PROGRAM.
           IF SAP-PRINT-SWK = "N"
               NEXT SENTENCE
           ELSE
               CALL "TWSPRT" USING RET-CODE, BASE, MMISA, STATUS-AREA,
                 SPOOL-PRT, WL-ARG, WORK-LIST-TABLE, WS-PARMS,
                 LANGUAGE-PARMS, ESC-NAME, BU-DISPLAY-MSG,
                 MULTIPLE-STR-DATA
               IF BU-DISPLAY-MSG-1 NOT = SPACES
                   PERFORM 2100-BLOWUP.

      **************************************************************
      **   IF AN "X" IS PUT IN LAST POSITION OF PLANNER DATA, WE  **
      **   PRINT A SECOND PRINTOUT AT A SELECTED PRINTER.         **
      **************************************************************

      *---------- IF THIS IS AN SAP PLANT AND NO PRINT IS REQUIRED,
      *---------- SKIP CALL TO PRINT PROGRAM.
           IF SAP-PRINT-SWK = "N"
               NEXT SENTENCE
           ELSE
             IF DE-EXTRA-PRINT = "X"
               MOVE 0                    TO  SPOOL-PRT
               MOVE SPACES               TO  BELL-FLAG, HALF-SHEET-FLAG
               CALL "TWSPRT" USING RET-CODE, BASE, MMISA,
                 STATUS-AREA, SPOOL-PRT, WL-ARG, WORK-LIST-TABLE,
                 WS-PARMS, LANGUAGE-PARMS, ESC-NAME, BU-DISPLAY-MSG,
                 MULTIPLE-STR-DATA
               IF BU-DISPLAY-MSG-1 NOT = SPACES
                   PERFORM 2100-BLOWUP.

           PERFORM 4-CLEAR-FORM.
           MOVE 23008                    TO  CATREAD-MSG-NUMBER.
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
           MOVE WRKL-NO-INC              TO  MSG-FLD-9.
           MOVE MESSAGE-BUFFER           TO  DE-PGM-MSG.

           IF AKRON-PLANT
               NEXT SENTENCE
           ELSE
               PERFORM 4-SELECT-LETTER.
           PERFORM 9999-RESET-SCREEN.

      *------CLOSE FILES FOR MULTI DB PLANT
           IF AKRON-PLANT
               PERFORM MULTIDB-DLTOVR-CLOSE.

           GO TO 62-SHOW-FORM.
       66-WL-X.
           EXIT.

       671-MATERIAL-STATUS.
           MOVE "FCSISINQ"               TO  CSF-NEW-FORMFILE-NAME.
           MOVE "N"                      TO  CSF-MODE.
           PERFORM 7150-CALL-CSWITCHF.
           IF CSF-OPENFORM-ERR-SW = "Y"
               GO TO 672-MS-X.

           PERFORM VARYING SUB FROM 1 BY 1 UNTIL SUB > 8
               IF DE-CODE (SUB) > SPACES OR SUB = 1
                   MOVE DE-CODE (SUB) TO MTLSTAT-CODE-PARM
                   CALL "TMTLSTAT" USING BASE, VIEW-COMAREA,
                     SRF-MPLTINFO-COMPANY, SPOOL-PRT,
                     MTLSTAT-CODE-PARM, LANGUAGE-PARMS
               END-IF
           END-PERFORM.

           MOVE "O"                      TO  CSF-MODE.
           PERFORM 7150-CALL-CSWITCHF.

      *---------- SET THE F3 LABEL DEPENDING ON WHETHER CODE INQUIRIES
      *---------- ARE ALLOWED OR NOT
           PERFORM 69-SETKEYLABEL.

       672-MS-X.
           EXIT.

       681-CALL-SINQMFR.
           MOVE "FCSISINQ"               TO  CSF-NEW-FORMFILE-NAME.
           MOVE "N"                      TO  CSF-MODE.
           PERFORM 7150-CALL-CSWITCHF.
           IF CSF-OPENFORM-ERR-SW = "Y"
               GO TO 682-CS-X.

           IF SAVE-VIEW-LASTKEY = HP-F3-KEY
               MOVE "M"                  TO  SINQMFR-MFR-KWM-FLAG
           ELSE
               MOVE "K"                  TO  SINQMFR-MFR-KWM-FLAG.

           MOVE SRF-MPLTINFO-COMPANY     TO  INQ-MPLT-PLANT-CODE.
           CALL "SINQMFR" USING BASE, VIEW-COMAREA, LANGUAGE-PARMS,
             INQ-MPLT-PARMS, SINQMFR-PARMS.

           MOVE "O"                      TO  CSF-MODE.
           PERFORM 7150-CALL-CSWITCHF.

           MOVE 1 TO SUB2.
           PERFORM VARYING SUB FROM 1 BY 1 UNTIL SUB > 8
               IF INQ-CORP-CODE (SUB) > SPACES
                   MOVE "N" TO MOVED-IT-FLAG
                   PERFORM UNTIL MOVED-IT-FLAG = "Y" OR SUB2 > 8
                       IF DE-CODE (SUB2) = SPACES
                           MOVE INQ-CORP-CODE (SUB) TO DE-CODE (SUB2)
                           MOVE "Y" TO MOVED-IT-FLAG
                       END-IF
                       ADD 1 TO SUB2
                   END-PERFORM
               END-IF
           END-PERFORM.

      *---------- SET THE F3 LABEL DEPENDING ON WHETHER CODE INQUIRIES
      *---------- ARE ALLOWED OR NOT
           PERFORM 69-SETKEYLABEL.

       682-CS-X.
           EXIT.

       69-SETKEYLABEL.
      *    CALL "VSETKEYLABEL" USING VIEW-COMAREA, FORM-OR-GLOB,
      *      KEY-3, F3-MANUFACT.
      *    IF VIEW-STATUS NOT = 0
      *        MOVE "VSETKEYLABEL ERROR 61-GF" TO BU-DISPLAY-MSG
      *        PERFORM 2100-BLOWUP.
      *
      *    CALL "VSETKEYLABEL" USING VIEW-COMAREA, FORM-OR-GLOB,
      *      KEY-6, F6-KEYWORD.
      *    IF VIEW-STATUS NOT = 0
      *        MOVE "VSETKEYLABEL ERROR2 61-GF" TO BU-DISPLAY-MSG
      *        PERFORM 2100-BLOWUP.
      *

       6950-GET-EMPL-MMIS.
           MOVE DE-EMPL                  TO  PER-CC-ARG.
           PERFORM 9999-GETKEY-PER-PERSON-PC-I.
           IF GOOD-CALL
               NEXT SENTENCE
           ELSE
           IF NO-ENTRY
               MOVE SPACES               TO  BUF-PER-PERSONNEL.

       6960-MOVE-EMPL.
           ADD 1                         TO  SUB.
           IF WLT-CODE (SUB) > SPACES
               MOVE PER-CC-NUM           TO  WLT-EMPL (SUB).



       7150-CALL-CSWITCHF.
           CALL "CSWITCHF" USING VIEW-COMAREA, LANGUAGE-PARMS,
             FORMFILE, CSF-PARMS, BU-DISPLAY-MSG.
           IF BU-DISPLAY-MSG-1 NOT = SPACES
               PERFORM 2100-BLOWUP.

       COPY SCRNCALL IN COPYLIB.
       COPY SCRNCL1  IN COPYLIB.
      *------ THIS VERSION OF CATREAD ASSUMES THE SET/MSG NUMBER
      *------ WILL BE IN CATREAD-MSG-NUMBER.
       999-CATREAD.
           CALL "CCATREAD" USING CATREAD-PARMS.
           MOVE CATREAD-MSG-TEXT TO MESSAGE-BUFFER.
           IF MESSAGE-BUFFER-1  = SPACES
               MOVE "* ERROR ON THIS FIELD *" TO MESSAGE-BUFFER.
       999-CATREAD-EXIT.
           EXIT.
       9999-PUT-DWLITEM-WK-O.
           MOVE 0 TO COND-WORD.
           WRITE DWLITEM-WK-REC-O FROM BUF-DWLITEM
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD
               IF HANDLE-BLOWUP-FLAG = "Y"
                   MOVE "PUT ERR 9999-PUT-DWLITEM-WK-O"
                       TO BU-MSG-AREA
                   PERFORM 2100-BLOWUP.

       COPY UNLOCK   IN COPYLIB.
       9999-GETKEY-MPLTINFO-PK-I.
           MOVE 0 TO COND-WORD.
           MOVE PLT-ARG TO PLTINFOKEY OF MPLTINFO-PK-REC-I.
           READ MPLTINFO-PK-I INTO BUF-MPLTINFO
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS = "23"
               MOVE 17 TO COND-WORD
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD
               IF HANDLE-BLOWUP-FLAG = "Y"
                   MOVE "GETKEY ERR 9999-GETKEY-MPLTINFO-PK-I"
                       TO BU-MSG-AREA
                   PERFORM 2100-BLOWUP.

       9999-GETKEY-MSTORERM-CD-I.
           MOVE 0 TO COND-WORD.
           MOVE CODE-ARG TO CORPCDE OF MSTORERM-CD-REC-I.
           READ MSTORERM-CD-I INTO BUF-MSTORERM
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS = "23"
               MOVE 17 TO COND-WORD
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD
               IF HANDLE-BLOWUP-FLAG = "Y"
                   MOVE "GETKEY ERR 9999-GETKEY-MSTORERM-CD-I"
                       TO BU-MSG-AREA
                   PERFORM 2100-BLOWUP.

       9999-GETKEY-MWRKLIST-WK-O.
           MOVE 0 TO COND-WORD.
           MOVE WL-ARG TO WLKEY OF MWRKLIST-WK-REC-O.
           READ MWRKLIST-WK-O INTO BUF-MWRKLIST
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS = "23"
               MOVE 17 TO COND-WORD
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD
               IF HANDLE-BLOWUP-FLAG = "Y"
                   MOVE "GETKEY ERR 9999-GETKEY-MWRKLIST-WK-O"
                       TO BU-MSG-AREA
                   PERFORM 2100-BLOWUP.

       9999-RESET-MWRKLIST-WK-O.
           MOVE HIGH-VALUES TO WLKEY OF MWRKLIST-WK-REC-O.
           START MWRKLIST-WK-O KEY > WLKEY OF MWRKLIST-WK-REC-O
               INVALID KEY MOVE "00" TO FILE-STATUS.

       9999-PUT-MWRKLIST-WK-O.
           MOVE 0 TO COND-WORD.
           WRITE MWRKLIST-WK-REC-O FROM BUF-MWRKLIST
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD
               IF HANDLE-BLOWUP-FLAG = "Y"
                   MOVE "PUT ERR 9999-PUT-MWRKLIST-WK-O"
                       TO BU-MSG-AREA
                   PERFORM 2100-BLOWUP.

       9999-UPDATE-MWRKLIST-WK-O.
           MOVE 0 TO COND-WORD.
           REWRITE MWRKLIST-WK-REC-O FROM BUF-MWRKLIST
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD
               IF HANDLE-BLOWUP-FLAG = "Y"
                   MOVE "UPDATE ERR 9999-UPDATE-MWRKLIST-WK-O"
                       TO BU-MSG-AREA
                   PERFORM 2100-BLOWUP.

       COPY DLOCKCAL IN COPYLIB.
       COPY MLOCKCAL IN COPYLIB.
       9999-GETKEY-PER-PERSON-PC-I.
           MOVE 0 TO COND-WORD.
           MOVE PER-CC-ARG TO PERCCNUM OF PER-PERSON-PC-REC-I.
           READ PER-PERSON-PC-I INTO BUF-PER-PERSONNEL
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS = "23"
               MOVE 17 TO COND-WORD
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD
               IF HANDLE-BLOWUP-FLAG = "Y"
                   MOVE "GETKEY ERR 9999-GETKEY-PER-PERSON-PC-I"
                       TO BU-MSG-AREA
                   PERFORM 2100-BLOWUP.

       9999-OPEN-STUFF.
           OPEN INPUT PER-PERSON-PC-I.
DCR01      OPEN INPUT CURRENT-LABOR.
DCR01      OPEN INPUT BASIC-WO.
DCR01      OPEN INPUT PLANNED-WO.
       COPY OPDISPL  IN COPYLIB.
      *-------IF NOT MULTI DB PLANT, OPEN THESE FILES
           IF NOT AKRON-PLANT
               OPEN INPUT MSTORERM-CD-I
               OPEN I-O MWRKLIST-WK-O
               OPEN I-O DWLITEM-WK-O.
       9999-CLOSE-STUFF.
           CLOSE MPLTINFO-PK-I.
           CLOSE PER-PERSON-PC-I.
           CLOSE DISPLAY-FILE.
DCR01      CLOSE CURRENT-LABOR.
DCR01      CLOSE BASIC-WO.
DCR01      CLOSE PLANNED-WO.
      *-------IF NOT MULTI DB PLANT, CLOSE THESE FILES
           IF NOT AKRON-PLANT
               CLOSE MSTORERM-CD-I
                     MWRKLIST-WK-O
                     DWLITEM-WK-O.

      *-----------------------------------------------------------------
      *    CREATE NEW STOREROOM WITHDRAWAL FILE FOR SAP R/3.
      *-----------------------------------------------------------------

       9999-CREATE-NEW-PFM.
           MOVE 0                             TO  RTN-CODE.
           MOVE WL-KEY-NUM                    TO  SAVE-SEQ.
           MOVE 1                             TO  DATE-MODE.
           CALL "TDATECHK" USING DATE-CHECK-AREA.
           MOVE DATE-SLASH-OUT                TO  SAVE-DATE.
           MOVE DATE-FORMATTED-TIME-OUT       TO  SAVE-TIME.
           CALL "ADDSWPFM" USING  SAVE-SEQ,   SAVE-DATE,
                                  SAVE-TIME,  RTN-CODE.
           IF RTN-CODE NOT = ZERO
               MOVE "PROBLEM CREATING SW FILE"  TO  BU-DISPLAY-MSG
               PERFORM 2100-BLOWUP.
           MOVE SAVE-SEQ TO OVRDBF-SEQ.
           STRING "SW" SAVE-SEQ "    " DELIMITED BY SIZE
                                              INTO CLSNDSW-FILENAME.
           CALL "QCMDEXC" USING  OVRDBF-SW-CMD  OVRDBF-SW-LEN.
           OPEN OUTPUT     SWPFM-O.

      *-----------------------------------------------------------------
      *    WRITE RECORD TO SAP R/3 FILE.
      *-----------------------------------------------------------------

       9999-PUT-SWPFM-REC.
      *****MOVE WLT-EMPL (SUB1) TO PERCCNUM OF PER-PERSON-PC-REC-I.
           MOVE WL-EMPL TO PERCCNUM OF PER-PERSON-PC-REC-I.
           READ PER-PERSON-PC-I INTO BUF-PER-PERSONNEL
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
      ******************************************************************
      * 02JUL02 COMMENTED OUT THE FOLLOWING IF STATEMENT INVOLVING THE
      *  CHARGE DEPT.  EVEN IF THE EXPENSE CLASS IS AN SAP CWIP
      *  (INTERNAL ORDER) NUMBER, SAP STILL WANTS A VALID DEPARTMENT TO
      *  BE PASSED.   ---DAVE PLUM
      ******************************************************************
      ***  IF WL-EXP-CLASS (1:1) = "8"
      ***      MOVE SPACES TO WL-CHARGE-DEPT.
           IF FILE-STATUS NOT = "00"
               MOVE SPACES TO PER-EMP-NAME.
           STRING BUF-DWLITEM
                  SAVE-PLT
                  WLT-EXP-CLASS (SUB1)
                  PER-EMP-NAME
             DELIMITED BY SIZE
               INTO SWPFM-REC-O.
           WRITE SWPFM-REC-O.

      *-----------------------------------------------------------------

       MULTIDB-OVRDBF-OPEN.
           IF MPLT-MULTIDB-LIB = SPACES
               MOVE "*LIBL" TO MPLT-MULTIDB-LIB
           END-IF.

           STRING "OVRDBF FILE(MCFLCS0201) TOFILE(" DELIMITED BY SIZE,
             MPLT-MULTIDB-LIB DELIMITED BY SPACES,
             "/MCFLCS0201) SHARE(*NO)" DELIMITED BY SIZE,
               INTO COMMAND-WORK.
           CALL "QCMDEXC" USING COMMAND-WORK, COMMAND-LEN.

           STRING "OVRDBF FILE(MCFLCS1701) TOFILE(" DELIMITED BY SIZE,
             MPLT-MULTIDB-LIB DELIMITED BY SPACES,
             "/MCFLCS1701) SHARE(*NO)" DELIMITED BY SIZE,
               INTO COMMAND-WORK.
           CALL "QCMDEXC" USING COMMAND-WORK, COMMAND-LEN.

           STRING "OVRDBF FILE(MCFLCS1501) TOFILE(" DELIMITED BY SIZE,
             MPLT-MULTIDB-LIB DELIMITED BY SPACES,
             "/MCFLCS1501) SHARE(*NO)" DELIMITED BY SIZE,
               INTO COMMAND-WORK.
           CALL "QCMDEXC" USING COMMAND-WORK, COMMAND-LEN.

           STRING "OVRDBF FILE(MCFLCS0301) TOFILE(" DELIMITED BY SIZE,
             MPLT-MULTIDB-LIB DELIMITED BY SPACES,
             "/MCFLCS0301) SHARE(*NO)" DELIMITED BY SIZE,
               INTO COMMAND-WORK.
           CALL "QCMDEXC" USING COMMAND-WORK, COMMAND-LEN.

           STRING "OVRDBF FILE(MCFLCS5001) TOFILE(" DELIMITED BY SIZE,
             MPLT-MULTIDB-LIB DELIMITED BY SPACES,
             "/MCFLCS5001) SHARE(*NO)" DELIMITED BY SIZE,
               INTO COMMAND-WORK.
           CALL "QCMDEXC" USING COMMAND-WORK, COMMAND-LEN.

           STRING "OVRDBF FILE(MCFLCS1302) TOFILE(" DELIMITED BY SIZE,
             MPLT-MULTIDB-LIB DELIMITED BY SPACES,
             "/MCFLCS1302) SHARE(*NO)" DELIMITED BY SIZE,
               INTO COMMAND-WORK.
           CALL "QCMDEXC" USING COMMAND-WORK, COMMAND-LEN.

           STRING "OVRDBF FILE(MCFLCS5901) TOFILE(" DELIMITED BY SIZE,
             MPLT-MULTIDB-LIB DELIMITED BY SPACES,
             "/MCFLCS5901) SHARE(*NO)" DELIMITED BY SIZE,
               INTO COMMAND-WORK.
           CALL "QCMDEXC" USING COMMAND-WORK, COMMAND-LEN.

           STRING "OVRDBF FILE(MCFLCSUSAG) TOFILE(" DELIMITED BY SIZE,
             MPLT-MULTIDB-LIB DELIMITED BY SPACES,
             "/MCFLCSUSAG) SHARE(*NO)" DELIMITED BY SIZE,
               INTO COMMAND-WORK.
           CALL "QCMDEXC" USING COMMAND-WORK, COMMAND-LEN.

      *------OVRDBF FOR ADDITIONAL CDESC FILES
           STRING "OVRDBF FILE(MCFLCS1401) TOFILE(" DELIMITED BY SIZE,
             MPLT-MULTIDB-LIB DELIMITED BY SPACES,
             "/MCFLCS1401) SHARE(*NO)" DELIMITED BY SIZE,
               INTO COMMAND-WORK.
           CALL "QCMDEXC" USING COMMAND-WORK, COMMAND-LEN.

           STRING "OVRDBF FILE(MCFLCS3101) TOFILE(" DELIMITED BY SIZE,
             MPLT-MULTIDB-LIB DELIMITED BY SPACES,
             "/MCFLCS3101) SHARE(*NO)" DELIMITED BY SIZE,
               INTO COMMAND-WORK.
           CALL "QCMDEXC" USING COMMAND-WORK, COMMAND-LEN.

           STRING "OVRDBF FILE(MCFLCS3603) TOFILE(" DELIMITED BY SIZE,
             MPLT-MULTIDB-LIB DELIMITED BY SPACES,
             "/MCFLCS3603) SHARE(*NO)" DELIMITED BY SIZE,
               INTO COMMAND-WORK.
           CALL "QCMDEXC" USING COMMAND-WORK, COMMAND-LEN.

           OPEN INPUT MSTORERM-CD-I.
           OPEN I-O MWRKLIST-WK-O.
           OPEN I-O DWLITEM-WK-O.


       MULTIDB-DLTOVR-CLOSE.
           MOVE "DLTOVR FILE(MCFLCS0201)" TO COMMAND-WORK.
           CALL "QCMDEXC" USING COMMAND-WORK, COMMAND-LEN.

           MOVE "DLTOVR FILE(MCFLCS0301)" TO COMMAND-WORK.
           CALL "QCMDEXC" USING COMMAND-WORK, COMMAND-LEN.

           MOVE "DLTOVR FILE(MCFLCS1701)" TO COMMAND-WORK.
           CALL "QCMDEXC" USING COMMAND-WORK, COMMAND-LEN.

           MOVE "DLTOVR FILE(MCFLCS1501)" TO COMMAND-WORK.
           CALL "QCMDEXC" USING COMMAND-WORK, COMMAND-LEN.

           MOVE "DLTOVR FILE(MCFLCS5001)" TO COMMAND-WORK.
           CALL "QCMDEXC" USING COMMAND-WORK, COMMAND-LEN.

           MOVE "DLTOVR FILE(MCFLCS1302)" TO COMMAND-WORK.
           CALL "QCMDEXC" USING COMMAND-WORK, COMMAND-LEN.

           MOVE "DLTOVR FILE(MCFLCS5901)" TO COMMAND-WORK.
           CALL "QCMDEXC" USING COMMAND-WORK, COMMAND-LEN.

           MOVE "DLTOVR FILE(MCFLCSUSAG)" TO COMMAND-WORK.
           CALL "QCMDEXC" USING COMMAND-WORK, COMMAND-LEN.

      *------DLTOVR FOR ADDITIONAL CDESC FILES.
           MOVE "DLTOVR FILE(MCFLCS1401)" TO COMMAND-WORK.
           CALL "QCMDEXC" USING COMMAND-WORK, COMMAND-LEN.

           MOVE "DLTOVR FILE(MCFLCS3101)" TO COMMAND-WORK.
           CALL "QCMDEXC" USING COMMAND-WORK, COMMAND-LEN.

           MOVE "DLTOVR FILE(MCFLCS3603)" TO COMMAND-WORK.
           CALL "QCMDEXC" USING COMMAND-WORK, COMMAND-LEN.

           CLOSE MSTORERM-CD-I
                 MWRKLIST-WK-O
                 DWLITEM-WK-O.

DCR01 **************************************************************
DCR01 ** USE CLOCK NUMBER TO RETRIEVE IP WORKORDER DATA
DCR01 **************************************************************
DCR01  9999-GET-WORKORDER-DATA.

DCR01      MOVE  DE-EMPL          TO WS-SAVE-CCNUM.
DCR01      MOVE  SPACE            TO DE-WO.

DCR01      PERFORM  9999-READK-LABOR-DATA  THRU 9999-RLD-EXIT.
DCR01      IF FILE-STATUS NOT = "00"
DCR01         GO TO 9999-GWD-EXIT
DCR01      END-IF.

DCR01      MOVE  LCS-WO-NUM       TO DE-WO.

DCR01      PERFORM  9999-READK-BASIC-WO    THRU 9999-WOB-EXIT.
DCR01      IF FILE-STATUS NOT = "00"
DCR01         PERFORM  9999-READK-PLANNED-WO THRU 9999-WOP-EXIT
DCR01      END-IF.

DCR01  9999-GWD-EXIT.
DCR01       EXIT.

DCR01 **************************************************************
DCR01 ** READ CURRENT LABOR FILE BY CLOCK CARD NUMBER
DCR01 **************************************************************
DCR01  9999-READK-LABOR-DATA.

DCR01      MOVE DE-EMPL        TO PERCCNUM OF CURRENT-LABOR-REC.
DCR01      READ CURRENT-LABOR  INTO WS-CURRENT-LABOR
DCR01      END-READ.

DCR01  9999-RLD-EXIT.
DCR01       EXIT.

DCR01 **************************************************************
DCR01 ** READ BASIC WORK ORDER FILE - MCFPMM1000
DCR01 **************************************************************
DCR01  9999-READK-BASIC-WO.

DCR01      MOVE DE-WO          TO WONUM   OF BASIC-WO-REC.
DCR01      READ BASIC-WO  INTO WS-BASIC-WO
DCR01      END-READ.

DCR01 **** IF FILE-STATUS = "00"
DCR01 ****    MOVE DEPT OF WS-BASIC-WO TO DE-REQ-DEPT
DCR01 **** END-IF.

DCR01  9999-WOB-EXIT.
DCR01       EXIT.

DCR01 **************************************************************
DCR01 ** READ PLANNED WORK ORDER FILE - MCFPMM1100
DCR01 **************************************************************
DCR01  9999-READK-PLANNED-WO.

           MOVE DE-WO          TO WONUM    OF PLANNED-WO-REC.
           READ PLANNED-WO  INTO WS-PLANNED-WO
           END-READ.

DCR01 **** IF FILE-STATUS = "00"
DCR01 ****    MOVE DEPT-P OF WS-PLANNED-WO TO DE-REQ-DEPT
DCR01 **** END-IF.

DCR01  9999-WOP-EXIT.
DCR01       EXIT.
