       IDENTIFICATION DIVISION.
       PROGRAM-ID. TCOPYREQ.
      *REMARKS.
      *C   09/26/94.  M. L. MITCHELL
      *C     CHANGED LOGIC TO READ CHECK THE WO-PLANNED DATABASE
      *C     FOR EXISTENCE OF THE WO NUMBER THAT THE REQS WILL BE
      *C     COPIED TO.
      *C
      *C  01/04/2010  CA YODER  2010-00142425-001
      *C     UPDATE LOGIC ASSIGNING WORKORDER LETTER SUFFIX.
      *C
       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.
       SOURCE-COMPUTER. AS400.
       OBJECT-COMPUTER. AS400.
       SPECIAL-NAMES. I-O-FEEDBACK IS I-O-FEEDBACK-AREA.
       INPUT-OUTPUT SECTION.

       FILE-CONTROL.
           SELECT DISPLAY-FILE
               ASSIGN TO WORKSTATION-ZOFFLINE-SI
               ORGANIZATION IS TRANSACTION
               FILE STATUS IS DSPLY-STATUS
               CONTROL-AREA IS WS-CONTROL.

           SELECT PLAND-LF
               ASSIGN TO DATABASE-MCFLMM1101
               ORGANIZATION IS INDEXED
               ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
               FILE STATUS IS PLAND-STATUS.

           SELECT PARTS-LF1
               ASSIGN TO DATABASE-MCFLMM1201
               ORGANIZATION IS INDEXED
               ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                   WITH DUPLICATES
               FILE STATUS IS PARTS-STATUS.

           SELECT PARTS-LF2
               ASSIGN TO DATABASE-MCFLMM1201
               ORGANIZATION IS INDEXED
               ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                   WITH DUPLICATES
               FILE STATUS IS PARTS-STATUS-2.

           SELECT WO-LAST-NUM-USED
               ASSIGN TO DATABASE-MCFPMM0800
               ORGANIZATION IS RELATIVE
               ACCESS MODE IS RANDOM
               RELATIVE KEY IS ARG-NO.

       DATA DIVISION.
       FILE SECTION.
       FD  DISPLAY-FILE
           LABEL RECORDS ARE OMITTED.
       01  DSPLY-REC                   PIC X(2000).

       FD  PLAND-LF
           LABEL RECORDS ARE STANDARD.
       01  PLAN-LF.
           COPY DDS-ALL-FORMATS OF MCFLMM1101.

       FD  PARTS-LF1
           LABEL RECORDS ARE STANDARD.
       01  PREC-LF1.
           COPY DDS-ALL-FORMATS OF MCFLMM1201.

       FD  PARTS-LF2
           LABEL RECORDS ARE STANDARD.
       01  PREC-LF2.
           COPY DDS-ALL-FORMATS OF MCFLMM1201.

       FD  WO-LAST-NUM-USED
           LABEL RECORDS ARE STANDARD.
       01  WO-REC.
           COPY DDS-ALL-FORMATS OF MCFPMM0800.

       WORKING-STORAGE SECTION.

       COPY CATREAD OF COPYLIB.

      *---- 01/04/2010:  ADDED PARAMETER FOR CMMISYR.
       77  MMIS-LETTER                PIC X.

       01  ARG-NO                      PIC 9(9).
       01  MARVIN-NO                   PIC 9(9)   VALUE 1.
       01  SCREEN-FORMAT               PIC X(10).

       01  CUR-DATE-WA.
           05  CUR-DATE-YY             PIC XX.
           05  C-D-YY-9 REDEFINES CUR-DATE-YY.
               10  FILLER              PIC X.
               10  C-D-WA-Y            PIC 9.
           05  FILLER                  PIC X(4).

       01  DBPARAMETERS.
           COPY DBPARMS OF COPYLIB.

       01  ERROR-BUFFER.
           05  FILLER                  PIC X(40).
           05  WO-1-10                 PIC X(10).
           05  FILLER                  PIC X(30).

       01  FALS-VAL                    PIC 1 VALUE B"0".
       01  TRUE-VAL                    PIC 1 VALUE B"1".

       01  INPUT-BUF.
           05  INPUT-WO-FROM.
               10  INPUT-WO-FROM-1-6   PIC X(6).
               10  INPUT-WO-FROM-7     PIC X.
               10  INPUT-WO-FROM-8-10  PIC XXX.
           05  INPUT-WO-TO.
               10  INPUT-WO-TO-1-6     PIC X(6).
               10  INPUT-WO-TO-7       PIC X.
               10  INPUT-WO-TO-8-10    PIC XXX.
           05  INPUT-CMD-LINE          PIC X(79).
           05  INPUT-ERR-LINE          PIC X(79).

       COPY IOFEEDBACK OF COPYLIB.

       01  PARTS-BUFFER.
           05 PARTS-RECORD OCCURS 12 TIMES PIC X(742).

       01  PARTS-KEY.
           05  PARTS-NO-6               PIC X(6).
           05  PARTS-NO-1               PIC X.
           05  PARTS-NO-3               PIC X(3).

       01  PARTS-KEY-2.
           05  PARTS-NO-6-2             PIC X(6).
           05  PARTS-NO-1-2             PIC X.
           05  PARTS-NO-3-2             PIC X(3).

       01  PARTS-STATUS                 PIC XX VALUE SPACES.
       01  PARTS-STATUS-2               PIC XX VALUE SPACES.
       01  PLAND-STATUS                 PIC XX VALUE SPACES.
       01  DSPLY-STATUS                 PIC XX.

       01  PARTS-REL-KEY                PIC 9(9) VALUE ZEROS.

       01  PLAND-DATA.
         COPY DWOPLAN OF COPYLIB.

       COPY LANGSUB OF COPYLIB.

       01 LAST-WO-BUFF.
         COPY MLASTWO OF COPYLIB.

       01  PASSWORD-INFORMATION.
           05  NAME-OF-PROGRAM     PIC X(08) VALUE "TCOPYREQ".
           05  PROGRAM-TYPE        PIC X(02) VALUE "UP".
           05  PROGRAM-RELEASE     PIC X(12) VALUE " E0100010001".
           05  PROGRAM-DESCRIPTION.
               10  PROG-DESC-A     PIC X(60) VALUE
             "SPECIAL JOBPLAN MAINTENANCE PROGRAM THAT ALLOWS USER TO ".
               10  PROG-DESC-B     PIC X(60) VALUE
             "MANIPULATE WHOLE JOBPLANS FROM/TO A W/O                 ".
               10  PROG-FUNCTION   PIC X(60) VALUE SPACES.
           05  PASSWORD-FLAG       PIC X.

       01  S1                          PIC 99 COMP-3.
       01  SAVE-S1                     PIC 99 COMP-3.
       01  SAVE-ITEMNO1                PIC 9(4).
       01  SAVE-ITEMNO2                PIC 9(4).

       COPY DBSTAT OF COPYLIB.

       COPY VCOMAREA OF COPYLIB.

       01  WORKORDER-NUMBER            PIC X(10).
       01  RET-CODE                    PIC X.

       COPY WSCONTROL OF COPYLIB.

       COPY CPYIND OF COPYLIB.

       01  FCOPYREQ.
           COPY DD-FCOPYRQ1 OF ZOFFLINE.

       01  ERROR-MESSAGE-TABLE.
           05  ERROR-VALUES.
               10  FILLER              PIC X(74)   VALUE
           "   WORK-ORDER NUMBER MUST BE ENTERED                    ".
               10  FILLER              PIC X(74)   VALUE
           "   WORK-ORDER NUMBER NOT FOUND IN DATABASE              ".
               10  FILLER              PIC X(74)   VALUE
           "   YOU MUST ENTER A NEW WORK-ORDER NUMBER               ".
               10  FILLER              PIC X(74)   VALUE
           " YOU CAN ONLY COPY REQS TO AN EXISTING W/O NUMBER, W/O DOES
      -    "NOT EXIST ".
               10  FILLER              PIC X(74)   VALUE
           "   PLEASE ENTER A NEW WORK-ORDER NUMBER                 ".
               10  FILLER              PIC X(74)   VALUE
           "   YOU MUST ENTER AN ITEM NUMBER                        ".
               10  FILLER              PIC X(74)   VALUE
           "ITEM -NO IS NOT ON LIST, PLEASE CHOOSE ANOTHER  OR  PRESS PF
      -    "3 TO QUIT ".
               10  FILLER              PIC X(74)   VALUE
           "   SEVERE ERROR, EXISTING WO-NUMBER NOT FOUND IN DATABASE
      -    "603-      ".
               10  FILLER              PIC X(74)   VALUE
                                                     "ITEM COPIED TO NEW
      -    " WO NUMBER,  COPY ANOTHER ITEM TO THIS WO NUMBER (Y/N) ?".
               10  FILLER              PIC X(74)   VALUE
                                                     "       WOULD YOU L
      -    "IKE TO COPY ITEMS FROM ANOTHER ORDER WORK NUMBER (Y/N) ?".
           05  ERROR-MESSAGE   REDEFINES  ERROR-VALUES
               OCCURS 10  TIMES  PIC X(74).

       01  SAVE-YR-DIG                 PIC X.

       01  WS-SCREEN.
           05  WS-FILLER.
               10  WS-FROM-1-6         PIC X(6).
               10  WS-FROM-7           PIC X.
               10  WS-FROM-8-10        PIC XXX.
               10  WS-TO-1-6           PIC X(6).
               10  WS-TO-7             PIC X.
               10  WS-TO-8-10          PIC XXX.
               10    FILLER            PIC XX.
           05  ITEM-DATA.
               10  ITEMNUMS  OCCURS 12 TIMES.
                   15  WS-ITEM         PIC X(2).
                   15  WS-REQ          PIC X(10).
           05  WS-FUNCLI               PIC X(79).
           05  WS-CMDMSG               PIC X(79).
           05  WS-ERRMSG               PIC X(79).

       01  SWITCHES.
           05  CONTINUE-SW             PIC X     VALUE "N".
           05  CMDRQST-SW              PIC X     VALUE "N".
           05  COPY-SW                 PIC X     VALUE "N".
           05  INVALID-SW              PIC X     VALUE "N".
           05  WRITE-SW                PIC X     VALUE "N".

       PROCEDURE DIVISION.
       START-PROGRAM.
           PERFORM 1-HOUSEKEEPING THRU 1-EXIT.
           PERFORM 6-MAIN THRU 6-EXIT.
           PERFORM 2-END-OF-JOB THRU 2-EXIT.

       1-HOUSEKEEPING.
           OPEN I-O DISPLAY-FILE.
           OPEN I-O   PARTS-LF1.
           OPEN INPUT PARTS-LF2
                      PLAND-LF
                      WO-LAST-NUM-USED.
           READ WO-LAST-NUM-USED INTO LAST-WO-BUFF  INVALID KEY
               MOVE 17 TO COND-WORD.
           IF PASSWORD-FLAG = "N" GO TO 2-END-OF-JOB.

      *------- 01/04/2010:  UPDATED WORKORDER LETTER SUFFIX LOGIC.
      *    ACCEPT CUR-DATE-WA FROM DATE.
      *    IF C-D-WA-Y = 0
      *        MOVE "A" TO SAVE-YR-DIG
      *    ELSE
      *    IF C-D-WA-Y = 1
      *        MOVE "B" TO SAVE-YR-DIG
      *    ELSE
      *    IF C-D-WA-Y = 2
      *        MOVE "C" TO SAVE-YR-DIG
      *    ELSE
      *    IF C-D-WA-Y = 3
      *        MOVE "D" TO SAVE-YR-DIG
      *    ELSE
      *    IF C-D-WA-Y = 4
      *        MOVE "E" TO SAVE-YR-DIG
      *    ELSE
      *    IF C-D-WA-Y = 5
      *        MOVE "F" TO SAVE-YR-DIG
      *    ELSE
      *    IF C-D-WA-Y = 6
      *        MOVE "G" TO SAVE-YR-DIG
      *    ELSE
      *    IF C-D-WA-Y = 7
      *        MOVE "H" TO SAVE-YR-DIG
      *    ELSE
      *    IF C-D-WA-Y = 8
      *        MOVE "J" TO SAVE-YR-DIG
      *    ELSE
      *    MOVE "K" TO SAVE-YR-DIG.

           CALL "CMMISYR" USING MMIS-LETTER.
           MOVE MMIS-LETTER    TO SAVE-YR-DIG.
      *-------

           MOVE SPACES TO INPUT-BUF ERROR-BUFFER.
           MOVE 0 TO VIEW-LASTKEY.
           MOVE TRUE-VAL TO INDS (10)
                            INDS (26)
                            INDS (27).
           MOVE 0        TO SAVE-S1.

       1-EXIT.
           EXIT.

       2-END-OF-JOB.
           CLOSE PARTS-LF1.
           CLOSE PARTS-LF2.
           CLOSE WO-LAST-NUM-USED.
           GOBACK.

       2-EXIT.
           EXIT.

       30-READ-PARTS-1.
           READ PARTS-LF1
             INVALID KEY
               MOVE "Y" TO INVALID-SW.

       30-EXIT.
           EXIT.

       31-READ-PARTS-2.
           READ PARTS-LF2
             INVALID KEY
               MOVE "Y" TO INVALID-SW.

       31-EXIT.
           EXIT.

       32-READ-PLAND.
           READ PLAND-LF
             INVALID KEY
               MOVE "Y" TO INVALID-SW.

       32-EXIT.
           EXIT.

       5-PRINT-SCREEN.
             MOVE SAVE-YR-DIG TO WOIN1 OF FCOPYRQ1-I,
                                 WOUT1 OF FCOPYRQ1-I.
             MOVE "FCOPYRQ1" TO VIEW-CFNAME.
             MOVE FCOPYREQ TO DSPLY-REC.
             PERFORM 99-SCREEN-WRITE THRU 99-EXIT.
             PERFORM 98-SCREEN-READ  THRU 98-EXIT.
             MOVE DSPLY-REC TO FCOPYREQ.

       5-EXIT.
           EXIT.

       6-MAIN.
           PERFORM 5-PRINT-SCREEN THRU 5-EXIT.
           IF VIEW-LASTKEY = 3
             GO TO 6-EXIT
           ELSE
             PERFORM 60-CHECK-WO-NUM THRU 60-EXIT
             GO TO 6-MAIN.

       6-EXIT.
           EXIT.

       60-CHECK-WO-NUM.
           MOVE FALS-VAL           TO INDS (99).
           MOVE WOIN6 OF FCOPYRQ1-I TO PARTS-NO-6.
           MOVE WOIN1 OF FCOPYRQ1-I TO PARTS-NO-1.
           MOVE WOIN3 OF FCOPYRQ1-I TO PARTS-NO-3.
           IF PARTS-NO-6 = SPACES
             MOVE TRUE-VAL TO INDS (98)
             MOVE ERROR-MESSAGE (01) TO COMMANDLN1 OF FCOPYRQ1-O
             GO TO 60-EXIT.
      *
      *   ALIGN WORK ORDER NUMBER
      *
           CALL "TALWONO" USING PARTS-KEY, RET-CODE.
           MOVE PARTS-NO-6 TO WOIN6 OF FCOPYRQ1-O.
           MOVE PARTS-NO-1 TO WOIN1 OF FCOPYRQ1-O.
           MOVE PARTS-NO-3 TO WOIN3 OF FCOPYRQ1-O.

           MOVE SPACES TO COMMANDLN1 OF FCOPYRQ1-O.
           MOVE FALS-VAL TO INDS (98).
           MOVE SPACES TO PREC-LF1.
           MOVE PARTS-KEY TO WONUM OF PREC-LF1.
           PERFORM 30-READ-PARTS-1 THRU 30-EXIT.
           IF INVALID-SW = "Y"
             MOVE TRUE-VAL TO INDS (99)
             MOVE ERROR-MESSAGE (02) TO ERRMSG
             MOVE "N" TO INVALID-SW
             GO TO 60-EXIT.

           MOVE FALS-VAL TO INDS (99).
           MOVE SPACES TO ERRMSG.
           MOVE "N" TO CONTINUE-SW.

           PERFORM 600-GET-NEW-WO-NUM THRU 600-EXIT.
       60-CHOOSE.
           PERFORM 601-START-LIST THRU 601-EXIT.
           MOVE "N" TO CONTINUE-SW.
           PERFORM 602-CHOOSE-ITEM THRU 602-EXIT.
           PERFORM 603-COPY THRU 603-EXIT.
           MOVE "N" TO CONTINUE-SW.
           PERFORM 604-ANOTHER-ITEM THRU 604-EXIT.

       60-EXIT.
           EXIT.

       600-GET-NEW-WO-NUM.
           MOVE FALS-VAL TO INDS (10) INDS (26).
           MOVE TRUE-VAL TO INDS (11) INDS (25).
           PERFORM 5-PRINT-SCREEN THRU 5-EXIT.
           IF VIEW-LASTKEY = 3
             GO TO 605-START-OVER.

           MOVE WOUT6 OF FCOPYRQ1-I TO PARTS-NO-6-2.
           MOVE WOUT1 OF FCOPYRQ1-I TO PARTS-NO-1-2.
           MOVE WOUT3 OF FCOPYRQ1-I TO PARTS-NO-3-2.
           IF PARTS-NO-6-2 = SPACES
             MOVE TRUE-VAL TO INDS (98)
             MOVE ERROR-MESSAGE (03) TO COMMANDLN1 OF FCOPYRQ1-O
             GO TO 600-GET-NEW-WO-NUM.
      *
      *   ALIGN WORK ORDER NUMBER
      *
           CALL "TALWONO" USING PARTS-KEY-2, RET-CODE.
           MOVE PARTS-NO-6-2 TO WOUT6 OF FCOPYRQ1-O.
           MOVE PARTS-NO-1-2 TO WOUT1 OF FCOPYRQ1-O.
           MOVE PARTS-NO-3-2 TO WOUT3 OF FCOPYRQ1-O.

           MOVE SPACES TO COMMANDLN1 OF FCOPYRQ1-O.
           MOVE FALS-VAL TO INDS (98).
           MOVE SPACES TO PLAN-LF.
           MOVE PARTS-KEY-2 TO WONUM OF PLAN-LF.
           PERFORM 32-READ-PLAND THRU 32-EXIT.
           IF INVALID-SW = "Y"
             MOVE TRUE-VAL TO INDS(98)
             MOVE ERROR-MESSAGE (04) TO COMMANDLN1 OF FCOPYRQ1-O
             MOVE "N" TO INVALID-SW
             GO TO 600-GET-NEW-WO-NUM.

           MOVE FALS-VAL TO INDS (98).
           MOVE "N" TO INVALID-SW.
           MOVE FALS-VAL TO INDS (99) INDS (11) INDS (27).
           MOVE SPACES TO ERRMSG.
           MOVE TRUE-VAL TO INDS (12) INDS (26).

       600-EXIT.
           EXIT.

       601-START-LIST.
           MOVE PARTS-KEY TO WONUM OF PREC-LF2.
           START PARTS-LF2
               KEY IS > WONUM OF PREC-LF2
                 INVALID KEY
                   MOVE "N" TO CONTINUE-SW.
           MOVE FCOPYRQ1-O TO WS-SCREEN.
           PERFORM 6010-INIT-VALUES THRU 6010-EXIT
               VARYING S1 FROM 1 BY 1 UNTIL S1 > 12.
           MOVE 1 TO S1.
           PERFORM 6011-ITEMNUM-LIST THRU 6011-EXIT
               UNTIL S1 > 12.
           IF S1 = 99
               MOVE 66379 TO CATREAD-MSG-NUMBER
           ELSE
           MOVE 66381 TO CATREAD-MSG-NUMBER.
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
           MOVE ERROR-BUFFER TO WS-FUNCLI.
           MOVE WS-SCREEN TO FCOPYRQ1-O.

       601-EXIT.
           EXIT.

       6010-INIT-VALUES.
           MOVE SPACES TO ITEMNUMS (S1).

       6010-EXIT.
           EXIT.

       6011-ITEMNUM-LIST.
           READ PARTS-LF2 PRIOR RECORD
               AT END
                 MOVE 99 TO S1
                 GO TO 6011-EXIT.
           IF WONUM OF PREC-LF2 NOT EQUAL PARTS-KEY
             MOVE 99 TO S1
             GO TO 6011-EXIT.
           IF PRTREQNO OF PREC-LF2 = SPACES
             NEXT SENTENCE
           ELSE
             ADD 1                       TO  SAVE-S1
             MOVE SAVE-S1                TO  WS-ITEM (S1)
             MOVE PRTREQNO OF PREC-LF2   TO  WS-REQ (S1)
             MOVE PREC-LF2 TO PARTS-RECORD (S1)
             ADD 1 TO S1.

       6011-EXIT.
           EXIT.

       602-CHOOSE-ITEM.
           PERFORM 5-PRINT-SCREEN THRU 5-EXIT.
           IF VIEW-LASTKEY = 3
             GO TO 605-START-OVER.
           IF VIEW-LASTKEY = 1
               MOVE SPACES TO ITEM-DATA,
                              PARTS-BUFFER
               MOVE 1 TO S1
               PERFORM 6011-ITEMNUM-LIST THRU 6011-EXIT
                   UNTIL S1 > 12
               IF S1 = 99
                   MOVE 66379 TO CATREAD-MSG-NUMBER
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE ERROR-BUFFER TO WS-FUNCLI
                   MOVE WS-SCREEN TO FCOPYRQ1-O
                   GO TO 602-CHOOSE-ITEM
               ELSE
               MOVE 66381 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE ERROR-BUFFER TO WS-FUNCLI
               MOVE WS-SCREEN TO FCOPYRQ1-O
               GO TO 602-CHOOSE-ITEM.
           IF ITEMNO OF FCOPYRQ1-I = SPACES
             MOVE TRUE-VAL TO INDS (98)
             MOVE ERROR-MESSAGE (06) TO COMMANDLN1 OF FCOPYRQ1-O
             GO TO 602-CHOOSE-ITEM.

           MOVE ITEMNO OF FCOPYRQ1-I TO S1.
           IF S1 > 12
             SUBTRACT 12 FROM S1
           ELSE
           IF S1 > 24
             SUBTRACT 24 FROM S1
           ELSE
           IF S1 > 36
             SUBTRACT 36 FROM S1
           ELSE
           IF S1 > 48
             SUBTRACT 48 FROM S1
           ELSE
           IF S1 > 60
             SUBTRACT 60 FROM S1
           ELSE
           IF S1 > 72
             SUBTRACT 72 FROM S1
           ELSE
           IF S1 > 84
             SUBTRACT 84 FROM S1
           ELSE
           IF S1 > 96
             SUBTRACT 96 FROM S1.
           MOVE SPACES TO COMMANDLN1 OF FCOPYRQ1-O.
           MOVE FALS-VAL TO INDS (98).
           IF S1 > 12  OR S1 < 01
             MOVE ERROR-MESSAGE (07) TO COMMANDLN1 OF FCOPYRQ1-O
             GO TO 602-CHOOSE-ITEM.

           IF WS-REQ (S1) = SPACES
             MOVE ERROR-MESSAGE (07) TO COMMANDLN1 OF FCOPYRQ1-O
             PERFORM 5-PRINT-SCREEN THRU 5-EXIT
             GO TO 602-CHOOSE-ITEM.

       602-EXIT.
           EXIT.

       603-COPY.
           MOVE PARTS-RECORD (S1) TO PREC-LF1 .
           MOVE PARTS-KEY-2 TO WONUM OF PREC-LF1.
           MOVE PARTS-KEY-2 TO WONUM OF PREC-LF2.
             START PARTS-LF2
                 KEY IS NOT LESS THAN WONUM OF PREC-LF2
                   INVALID KEY
                   MOVE TRUE-VAL TO INDS (99)
                   MOVE ERROR-MESSAGE (08) TO COMMANDLN1 OF FCOPYRQ1-O
                   GO TO 2-END-OF-JOB.
           MOVE ZEROS TO SAVE-ITEMNO1 SAVE-ITEMNO2.
           PERFORM 6030-CHECK-ITEM THRU 6030-EXIT.
           IF SAVE-ITEMNO1 = ZEROS
             MOVE "0001" TO PRTITEMNO OF PREC-LF1
           ELSE
             ADD 1 TO SAVE-ITEMNO1
             MOVE SPACES TO PRTREQNO OF PREC-LF1
             MOVE SAVE-ITEMNO1 TO PRTITEMNO OF PREC-LF1.
           WRITE PREC-LF1.

       603-EXIT.
           EXIT.

       6030-CHECK-ITEM.
           READ PARTS-LF2 NEXT RECORD
               AT END
                 GO TO 6030-EXIT.

           IF PRTITEMNO OF PREC-LF2 NOT NUMERIC
             GO TO 6030-CHECK-ITEM.

           MOVE PRTITEMNO OF PREC-LF2 TO SAVE-ITEMNO2.
           IF SAVE-ITEMNO2 > SAVE-ITEMNO1
             MOVE SAVE-ITEMNO2 TO SAVE-ITEMNO1
             GO TO 6030-CHECK-ITEM.

       6030-EXIT.
           EXIT.

       604-ANOTHER-ITEM.
           MOVE FALS-VAL TO INDS (12).
           MOVE TRUE-VAL TO INDS (97) INDS (98) INDS (27).
           MOVE ERROR-MESSAGE (09) TO COMMANDLN1 OF FCOPYRQ1-O.
           PERFORM 5-PRINT-SCREEN THRU 5-EXIT.
           IF CMDRESPONS OF FCOPYRQ1-I = "Y"
             MOVE FALS-VAL TO INDS (98) INDS (97) INDS (27)
             MOVE SPACES TO CMDRESPONS OF FCOPYRQ1-I
                            CMDRESPONS OF FCOPYRQ1-O
                            COMMANDLN1 OF FCOPYRQ1-O
             MOVE SPACES TO ITEMNO OF FCOPYRQ1-I
             MOVE TRUE-VAL TO INDS (12)
             MOVE 0 TO SAVE-S1
             MOVE 1 TO S1
             GO TO 60-CHOOSE.

           GO TO 605-START-OVER.

       604-EXIT.
           EXIT.

       605-START-OVER.
             CLOSE PARTS-LF1.
             CLOSE PARTS-LF2.
             CLOSE WO-LAST-NUM-USED.
             MOVE SPACES TO WS-SCREEN
                            DSPLY-REC.
             MOVE ALL B"0" TO INDICS.
             PERFORM 1-HOUSEKEEPING THRU 1-EXIT.
             MOVE "C" TO WS-FROM-7
                         WS-TO-7.
             MOVE WS-SCREEN TO FCOPYRQ1-O.
             MOVE 0         TO SAVE-S1.
             GO TO 6-MAIN.

       605-EXIT.
           EXIT.

       98-SCREEN-READ.
           READ DISPLAY-FILE FORMAT IS VIEW-CFNAME
               INDICATORS ARE INDICS.
           ACCEPT IOFEEDBACK FROM I-O-FEEDBACK-AREA.
           IF DSPLY-STATUS NOT = "00"
             MOVE 3 TO VIEW-LASTKEY
           ELSE
             MOVE FUNCTION-NUM TO VIEW-LASTKEY.

       98-EXIT.
           EXIT.

       98A-SCREEN-READ.
           READ DISPLAY-FILE TERMINAL IS TERMINAL-ID
               INDICATORS ARE INDICS
                   NO DATA MOVE DSPLY-STATUS TO DSPLY-STATUS.

       98A-EXIT.
           EXIT.

       99-SCREEN-WRITE.
           WRITE DSPLY-REC FORMAT IS VIEW-CFNAME
               INDICATORS ARE INDICS.

       99-EXIT.
           EXIT.

       999-CATREAD.
           MOVE SPACES TO ERROR-BUFFER.
           CALL "CCATREAD" USING CATREAD-PARMS.
           MOVE CATREAD-MSG-TEXT TO ERROR-BUFFER.

       999-CATREAD-EXIT.
           EXIT.
