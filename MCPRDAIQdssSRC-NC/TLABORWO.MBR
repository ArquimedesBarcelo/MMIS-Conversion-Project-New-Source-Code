       IDENTIFICATION DIVISION.
       PROGRAM-ID.    TLABORWO.
      *REMARKS.       L2 - ADD LABOR RECORDS FOR PLANNED WORK ORDERS.
      *C----------------------------------------------------------------
      *C 02/25/93  JSB REQ #6306
      *C      ADDED "PR" AS A NEW WO STATUS FOR PRE-RELEASE.
      *C----------------------------------------------------------------
      *C
      *C  01/04/2010  CA YODER  2010-00142425-001
      *C     UPDATE LOGIC ASSIGNING WORKORDER LETTER SUFFIX.
      *C
       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.
       SOURCE-COMPUTER.    AS400.
       OBJECT-COMPUTER.    AS400.
       SPECIAL-NAMES. I-O-FEEDBACK IS I-O-FEEDBACK-AREA
                      LOCAL-DATA IS LOCAL-DATA-AREA.
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT DISPLAY-FILE
               ASSIGN TO WORKSTATION-ZOFFLINE-SI
               ORGANIZATION IS TRANSACTION
               FILE STATUS IS DSPLY-STATUS
               CONTROL-AREA IS WS-CONTROL.
           SELECT PERSONNEL-FILE
               ASSIGN TO DATABASE-MCFLMM0301
               ORGANIZATION IS INDEXED
               ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
               FILE STATUS IS PF-STATUS.
           SELECT WO-LAST-NUM-USED
               ASSIGN TO DATABASE-MCFPMM0800
               ORGANIZATION IS RELATIVE
               ACCESS MODE IS RANDOM
               RELATIVE KEY IS ARG-NO
               FILE STATUS IS WLNU-STATUS.
           SELECT WO-PLANNED-FILE
               ASSIGN TO DATABASE-MCFLMM1101
               ORGANIZATION IS INDEXED
               ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                   WITH DUPLICATES
               FILE STATUS IS WPF-STATUS.
       DATA DIVISION.
       FILE SECTION.
       FD  DISPLAY-FILE
           LABEL RECORDS ARE OMITTED.
       01  DSPLY-REC                   PIC X(2000).
       FD  PERSONNEL-FILE
           LABEL RECORDS ARE STANDARD
           DATA RECORD IS PFREC.
       01  PFREC.
           COPY DDS-ALL-FORMATS OF MCFLMM0301.
       FD  WO-LAST-NUM-USED
           LABEL RECORDS ARE STANDARD
           DATA RECORD IS WLNUREC.
       01  WLNUREC.
           COPY DDS-ALL-FORMATS OF MCFPMM0800.
       FD  WO-PLANNED-FILE
           LABEL RECORDS ARE STANDARD
           DATA RECORD IS WPFREC.
       01  WPFREC.
           COPY DDS-ALL-FORMATS OF MCFLMM1101.
       WORKING-STORAGE SECTION.
      *---- 01/04/2010:  ADDED PARAMETER FOR CMMISYR.
       77  MMIS-LETTER                PIC X.
       01  ARG-NO                PIC 9(9).
       01  BEG-TIME.
           05  BEG-HR            PIC 99.
           05  BEG-MN            PIC 99.
       01  BLOWUP-BASE           PIC X(16).
       COPY CATREAD OF COPYLIB.
       COPY CPYIND  OF COPYLIB.
       01  CURDATE-BUFF.
           05 Y-BUFF.
              10 FILLER          PIC X.
              10 DATE-YEAR       PIC X.
           05 M-BUFF             PIC X(2).
           05 D-BUFF             PIC X(2).
       01  CW-DATE               PIC X(12).
       COPY TDATESUB OF COPYLIB.
       01  DATE-0.
           05 YY-0               PIC 99.
           05 MM-0               PIC 99.
           05 DD-0               PIC 99.
       01  DATE-1.
           05 YY-1               PIC 99.
           05 MM-1               PIC 99.
           05 DD-1               PIC 99.
       01  DAY-DIGIT             PIC X.
       01  DBPARAMETERS.         COPY DBPARMS OF COPYLIB.
       01  END-TIME.
           05  END-HR            PIC 99.
           05  END-MN            PIC 99.
       01  ERROR-BUFFER.
           05  FILLER            PIC X(21).
           05  ERR-CC            PIC X(4).
           05  FILLER            PIC XX.
           05  ERR-REST.
               10  FILLER        PIC XX.
               10  ERR-NAME      PIC X(16).
               10  FILLER        PIC XX.
           05  ERR-HBE           PIC X(16).
           05  FILLER            PIC X(19).
       01  FIELDNUM              PIC S9(4) COMP-4.
       01  FILE-STATUSES.
           05  BMR-STATUS        PIC XX.
           05  DSPLY-STATUS      PIC XX.
           05  PF-STATUS         PIC XX.
           05  WLNU-STATUS       PIC XX.
           05  WPF-STATUS        PIC XX.
       01  GREG-DATE.
           05  GREG-CC           PIC XX.
           05  GREG-YMD.
               10  GREG-YY       PIC XX.
               10  GREG-MM       PIC XX.
               10  GREG-DD       PIC XX.
       COPY IOFEEDBACK OF COPYLIB.
       01  IP-DATE               PIC X(12).
       01  JULIAN-DATE.
           05  JULIAN-DATE-CC    PIC 99.
           05  JULIAN-DATE-YY    PIC 99.
           05  JULIAN-DATE-DDD   PIC 9(3).
       01  JULIAN-DATE-9 REDEFINES JULIAN-DATE  PIC 9(7).
       01  LABOR-CURR-DATA.      COPY DCURRLBR OF COPYLIB.
       COPY LANGSUB OF COPYLIB.
       01  LAST-WO-USED-DATA.    COPY MLASTWO OF COPYLIB.
       01  LEAP-YEAR-FLAG        PIC X.
       01  LINK-DATA.
           05 ZONE-BUF-LINK      PIC X(4).
           05 TIME-IN.
              10 HRS-IN          PIC 99.
              10 MIN-IN          PIC 99.
           05 CODE-BUF           PIC X.
           05 SHIFTS.
              10 S-1             PIC 9999.
              10 E-1             PIC 9999.
              10 S-2             PIC 9999.
              10 E-2             PIC 9999.
              10 S-3             PIC 9999.
              10 E-3             PIC 9999.
              10 S-4             PIC 9999.
              10 E-4             PIC 9999.
           05 CURR-SHIFT         PIC 9.
       01  PERSONNEL-DATA.       COPY MPERSONL OF COPYLIB.
       01  PASSWORD-INFORMATION.
           05  NAME-OF-PROGRAM     PIC X(08) VALUE "TLABORWO".
           05  PROGRAM-TYPE        PIC X(02) VALUE "UP".
           05  PROGRAM-RELEASE     PIC X(12) VALUE " E0100010001".
           05  PROGRAM-DESCRIPTION.
               10  PROG-DESC-A     PIC X(60) VALUE
                   "L2 -- PLANNED WORK ORDER LABOR INPUT              ".
               10  PROG-DESC-B     PIC X(60) VALUE SPACES.
               10  PROG-FUNCTION   PIC X(60) VALUE SPACES.
           05  PASSWORD-FLAG       PIC X VALUE "Y".
       01  PM-PARAMETERS.
           05 PM-WO-NUMBER       PIC X(10).
           05 PM-UPDATE-CODE     PIC X(2).
           05 PM-UPDATE-DATE     PIC X(6).
           05 PM-RETURN-CODE     PIC S9(4) COMP.
           05 PM-RETURN-ERROR    PIC X(84).
           05 PM-SW              PIC X.
       01  REFRESH-SW            PIC X.
       01  RET-CODE              PIC XX.
       01  SHOW-SW               PIC X.
       01  START-MINS            PIC 9999.
       01  STOP-MINS             PIC 9999.
       01  START-TIME            PIC S9999.
       01  STOP-TIME             PIC S9999.
       01  SHIFT-START           PIC S9999.
       01  S1                    PIC S9(4) COMP-4.
       01  STOP-SW               PIC X VALUE "N".
       COPY DBSTAT OF COPYLIB.
       01  SCREEN-DATA.
           05 WONUM-DATA.
              10 FILLER          PIC X(6).
              10 WO-YR           PIC X.
              10 FILLER          PIC X(3).
           05 STATUS-DATA        PIC X(2).
           05 DATE-DATA          PIC X(6).
           05 SHIFT-DATA         PIC X.
           05 START-DATA         PIC X(4).
           05 STOP-DATA          PIC X(4).
           05 CARD-TIME-DATA OCCURS 8 TIMES.
              10 CARD-DATA       PIC X(4).
              10 ON-DATA         PIC X(4).
              10 OFF-DATA        PIC X(4).
           05 FAILURE-CODE       PIC X(6).
           05  SCREEN-CMD-LINE   PIC X(79).
           05  SCREEN-ERR-LINE   PIC X(79).
       COPY TBLOWUP OF COPYLIB.
       01  TIME-BUFF.
           05 TIME-HHMM          PIC X(4).
           05 TIME-SECS          PIC XX.
       01  TRUE-VAL              PIC 1 VALUE B"1".
       COPY VCOMLINK OF COPYLIB.
       01  WO-PLANNED-DATA.      COPY DWOPLAN OF COPYLIB.
       01  WO-LABOR-DATA.        COPY DWOLABOR OF COPYLIB.
       01  WO-TRACK-DATA.        COPY DWOTRACK OF COPYLIB.
       01  WO-IP-DATE.
           05 WO-IP-DT           PIC X(8).
           05 WO-IP-TM           PIC X(4).
       01  WO-CW-DATE.
           05 WO-CW-DT           PIC X(8).
           05 WO-CW-TM           PIC X(4).
       COPY WSCONTROL OF COPYLIB.
       01  ZONE-LINK             PIC X(4).
       PROCEDURE DIVISION.
       START-PAR.
           PERFORM 1-HSK.
           PERFORM 6-MAIN THRU 6-MAIN-EXIT UNTIL VIEW-LASTKEY = 3.

       2-EOJ.
           CLOSE DISPLAY-FILE.
           CLOSE PERSONNEL-FILE.
           CLOSE WO-LAST-NUM-USED.
           CLOSE WO-PLANNED-FILE.
           GOBACK.

       1-HSK.
           OPEN I-O   DISPLAY-FILE.
           OPEN INPUT PERSONNEL-FILE.
           OPEN INPUT WO-LAST-NUM-USED.
           OPEN I-O   WO-PLANNED-FILE.
           MOVE 0 TO COND-WORD VIEW-LASTKEY.
           MOVE 1 TO ARG-NO.
           READ WO-LAST-NUM-USED INTO LAST-WO-USED-DATA
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF WLNU-STATUS NOT = "00" MOVE 17 TO COND-WORD.
           IF COND-WORD = 17 MOVE 1 TO DATE-FLAG-SW.
           MOVE DATE-FLAG-SW TO DATE-CODE.
           CALL "TPWORD" USING PASSWORD-INFORMATION.
           IF PASSWORD-FLAG = "N" GO TO 2-EOJ.

       6-MAIN.
           PERFORM 60-INITIALIZE.
           PERFORM 61-SHOW-SCREEN1.
           PERFORM 62-READ-SCREEN1 THRU 62-R-S1-E.
           IF REFRESH-SW = "Y" GO TO 6-MAIN-EXIT.
           PERFORM 63-SHOW-SCREEN2.
           PERFORM 64-READ-SCREEN2 THRU 64-R-S2-E.
           IF REFRESH-SW = "Y" GO TO 6-MAIN-EXIT.
           PERFORM 65-SHOW-SCREEN3.
           PERFORM 66-READ-SCREEN3 THRU 66-R-S3-E.

       6-MAIN-EXIT.    EXIT.

       60-INITIALIZE.
           MOVE "N" TO REFRESH-SW.
           MOVE "N" TO PM-SW.
           ACCEPT CURDATE-BUFF FROM DATE.
           ACCEPT TIME-BUFF FROM TIME.
           MOVE SPACES TO SCREEN-DATA.
           MOVE SPACES TO WO-IP-DATE WO-CW-DATE.
      *------- 01/04/2010:  UPDATED WORKORDER LETTER SUFFIX LOGIC.
      *    IF      DATE-YEAR = "0" MOVE "A" TO WO-YR
      *    ELSE IF DATE-YEAR = "1" MOVE "B" TO WO-YR
      *    ELSE IF DATE-YEAR = "2" MOVE "C" TO WO-YR
      *    ELSE IF DATE-YEAR = "3" MOVE "D" TO WO-YR
      *    ELSE IF DATE-YEAR = "4" MOVE "E" TO WO-YR
      *    ELSE IF DATE-YEAR = "5" MOVE "F" TO WO-YR
      *    ELSE IF DATE-YEAR = "6" MOVE "G" TO WO-YR
      *    ELSE IF DATE-YEAR = "7" MOVE "H" TO WO-YR
      *    ELSE IF DATE-YEAR = "8" MOVE "J" TO WO-YR
      *    ELSE IF DATE-YEAR = "9" MOVE "K" TO WO-YR.

           CALL "CMMISYR" USING MMIS-LETTER.
           MOVE MMIS-LETTER    TO WO-YR.
      *-------

           MOVE SPACES            TO WO-TRACK-DATA.
           MOVE "TLABORWO"        TO PROGRAM-NAME.
           MOVE Y-BUFF            TO DATE-STAMP-YY.
           IF Y-BUFF > "70"
               MOVE "19"          TO DATE-STAMP-CC
           ELSE
           MOVE "20"              TO DATE-STAMP-CC.
           MOVE M-BUFF            TO DATE-STAMP-MM.
           MOVE D-BUFF            TO DATE-STAMP-DD.
           MOVE TIME-HHMM         TO TIME-STAMP.
           MOVE SPACES            TO USER-ID CLOCK-CARD.
           MOVE SPACES            TO TRANS-STATUS.

       61-SHOW-SCREEN1.
           MOVE "LABRSCN1" TO VIEW-CFNAME.
           MOVE SCREEN-DATA TO DSPLY-REC.
           PERFORM 99-SCREEN-WRITE.

       62-READ-SCREEN1.
           PERFORM 98-SCREEN-READ.
           IF VIEW-LASTKEY = 3 GO TO 2-EOJ.
           IF VIEW-LASTKEY = 1
               MOVE "Y" TO REFRESH-SW
               GO TO 62-R-S1-E.
           MOVE DSPLY-REC TO SCREEN-DATA.
           CALL "TALWONO" USING WONUM-DATA RET-CODE.
           PERFORM 69-START-WO-PLANNED-FILE.
           IF COND-WORD = 17
               MOVE 35040 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE ERROR-BUFFER TO SCREEN-ERR-LINE
               MOVE TRUE-VAL TO INDS (4) INDS (99)
               MOVE SCREEN-DATA TO DSPLY-REC
               PERFORM 99-SCREEN-WRITE
               GO TO 62-READ-SCREEN1.
           PERFORM 69-READ-WO-PLANNED-FILE.
           IF COND-WORD = 15
               MOVE 35040 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE ERROR-BUFFER TO SCREEN-ERR-LINE
               MOVE TRUE-VAL TO INDS (4) INDS (99)
               MOVE SCREEN-DATA TO DSPLY-REC
               PERFORM 99-SCREEN-WRITE
               GO TO 62-READ-SCREEN1.
           IF WO-NUM-SUFF-P = "000"
               MOVE 35040 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE ERROR-BUFFER TO SCREEN-ERR-LINE
               MOVE TRUE-VAL TO INDS (4) INDS (99)
               MOVE SCREEN-DATA TO DSPLY-REC
               PERFORM 99-SCREEN-WRITE
               GO TO 62-READ-SCREEN1.
           IF EXP-CLASS-P = SPACES
               MOVE 49016 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE ERROR-BUFFER TO SCREEN-ERR-LINE
               MOVE TRUE-VAL TO INDS (4) INDS (99)
               MOVE SCREEN-DATA TO DSPLY-REC
               PERFORM 99-SCREEN-WRITE
               GO TO 62-READ-SCREEN1.
           IF WO-STATUS-P = "OO" OR "HA" OR "HM" OR "DW" OR "FF" OR "VO"
               MOVE 35085 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE ERROR-BUFFER TO SCREEN-ERR-LINE
               MOVE TRUE-VAL TO INDS (4) INDS (99)
               MOVE SCREEN-DATA TO DSPLY-REC
               PERFORM 99-SCREEN-WRITE
               GO TO 62-READ-SCREEN1.
           MOVE WO-STATUS-P TO STATUS-DATA.
       62-R-S1-E.    EXIT.

       63-SHOW-SCREEN2.
           MOVE "LABRSCN2" TO VIEW-CFNAME.
           MOVE SCREEN-DATA TO DSPLY-REC.
           PERFORM 99-SCREEN-WRITE.

       64-READ-SCREEN2.
           PERFORM 98-SCREEN-READ.
           IF VIEW-LASTKEY = 3 GO TO 2-EOJ.
           IF VIEW-LASTKEY = 1
               MOVE "Y" TO REFRESH-SW
               GO TO 64-R-S2-E.
           MOVE DSPLY-REC TO SCREEN-DATA.
           IF DATE-DATA = SPACES
               MOVE "000000" TO DATE-DATA.
           MOVE DATE-DATA TO DATE-VALIDATE-IN.
           MOVE 3 TO DATE-MODE.
           CALL "TDATECK2" USING DATE-CHECK-AREA LANGUAGE-PARMS.
           IF DATE-RET-CODE = 1
               MOVE DATE-MSG TO ERROR-BUFFER
               MOVE ERROR-BUFFER TO SCREEN-ERR-LINE
               MOVE SCREEN-DATA TO DSPLY-REC
               MOVE TRUE-VAL TO INDS (34) INDS (99)
               PERFORM 99-SCREEN-WRITE
               GO TO 64-READ-SCREEN2.
           MOVE DATE-DB TO DATE-0.
           MOVE YY-0 TO GREG-YY.
           MOVE MM-0 TO GREG-MM.
           MOVE DD-0 TO GREG-DD.
           IF GREG-YY > "70"
               MOVE "19" TO GREG-CC
           ELSE
           MOVE "20"     TO GREG-CC.
           MOVE SPACES   TO JULIAN-DATE.
           CALL "JULGREG" USING GREG-DATE, JULIAN-DATE,
                            DAY-DIGIT, LEAP-YEAR-FLAG.
           IF JULIAN-DATE-9 > 1
               SUBTRACT 1 FROM JULIAN-DATE-9
           ELSE
           MOVE 365 TO JULIAN-DATE-DDD
           SUBTRACT 1 FROM JULIAN-DATE-YY.
           MOVE SPACES TO GREG-DATE.
           CALL "JULGREG" USING GREG-DATE, JULIAN-DATE,
                            DAY-DIGIT, LEAP-YEAR-FLAG.
           MOVE GREG-YY TO YY-1.
           MOVE GREG-MM TO MM-1.
           MOVE GREG-DD TO DD-1.
           IF SHIFT-DATA < "1" OR > "4"
               MOVE 35034 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE ERROR-BUFFER TO SCREEN-ERR-LINE
               MOVE TRUE-VAL TO INDS (6) INDS (99)
               MOVE SCREEN-DATA TO DSPLY-REC
               PERFORM 99-SCREEN-WRITE
               GO TO 64-READ-SCREEN2.
           MOVE ZONE-P TO ZONE-BUF-LINK.
           MOVE 0 TO HRS-IN MIN-IN.
           CALL "TGETSHFT" USING LINK-DATA
                                 DBPARAMETERS.
           IF SHIFT-DATA  > CODE-BUF
               MOVE 35034 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE ERROR-BUFFER TO SCREEN-ERR-LINE
               MOVE TRUE-VAL TO INDS (6) INDS (99)
               MOVE SCREEN-DATA TO DSPLY-REC
               PERFORM 99-SCREEN-WRITE
               GO TO 64-READ-SCREEN2.
           IF SHIFT-DATA = "1"
               MOVE S-1 TO START-DATA
               MOVE E-1 TO STOP-DATA
           ELSE
           IF SHIFT-DATA = "2"
               MOVE S-2 TO START-DATA
               MOVE E-2 TO STOP-DATA
           ELSE
           IF SHIFT-DATA = "3"
               MOVE S-3 TO START-DATA
               MOVE E-3 TO STOP-DATA
           ELSE
           IF SHIFT-DATA = "4"
               MOVE S-4 TO START-DATA
               MOVE E-4 TO STOP-DATA.
       64-R-S2-E.    EXIT.

       65-SHOW-SCREEN3.
           IF WO-STATUS-P = "IP" OR "HS" OR "SD" OR "PR"
               MOVE "LABRSCN4" TO VIEW-CFNAME
           ELSE
           MOVE "LABRSCN3" TO VIEW-CFNAME.
           MOVE SCREEN-DATA TO DSPLY-REC.
           PERFORM 99-SCREEN-WRITE.

       66-READ-SCREEN3.
           PERFORM 98-SCREEN-READ.
           IF VIEW-LASTKEY = 3 GO TO 2-EOJ.
           IF VIEW-LASTKEY = 1
               MOVE "Y" TO REFRESH-SW
               GO TO 66-R-S3-E.
           MOVE DSPLY-REC TO SCREEN-DATA.
           MOVE "N" TO SHOW-SW.
           MOVE 7 TO FIELDNUM.
           PERFORM CHECK-CARD-TIMES THRU C-C-T-E VARYING S1 FROM 1 BY 1
               UNTIL S1 > 8.
           IF SHOW-SW = "Y"
               MOVE SCREEN-DATA TO DSPLY-REC
               PERFORM 99-SCREEN-WRITE
               GO TO 66-READ-SCREEN3.

           PERFORM ADD-LABOR-RECS   THRU A-L-R-E VARYING S1 FROM 1 BY 1
               UNTIL S1 > 8.

           IF CARD-DATA (1) = SPACES
               NEXT SENTENCE
           ELSE
           PERFORM RESET-WO-STATUS-DATES.
       66-R-S3-E.    EXIT.

       CHECK-CARD-TIMES.
           MOVE 0 TO COND-WORD.
           IF CARD-DATA (S1) = SPACES
               MOVE 9 TO S1
               GO TO C-C-T-E.
           MOVE CARD-DATA (S1) TO PERCCNUM OF PFREC.
           START PERSONNEL-FILE KEY IS = EXTERNALLY-DESCRIBED-KEY
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF PF-STATUS NOT = "00" MOVE 17 TO COND-WORD.
           IF COND-WORD = 17
               MOVE 35047 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE ERROR-BUFFER TO SCREEN-ERR-LINE
               MOVE TRUE-VAL TO INDS (FIELDNUM) INDS (99)
               MOVE "Y" TO SHOW-SW
               MOVE 9 TO S1
               GO TO C-C-T-E.
           READ PERSONNEL-FILE NEXT INTO PERSONNEL-DATA
               AT END    MOVE 15 TO COND-WORD.
           IF PF-STATUS NOT = "00" MOVE 15 TO COND-WORD.
           IF COND-WORD = 15
               MOVE 35047 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE ERROR-BUFFER TO SCREEN-ERR-LINE
               MOVE TRUE-VAL TO INDS (FIELDNUM) INDS (99)
               MOVE "Y" TO SHOW-SW
               MOVE 9 TO S1
               GO TO C-C-T-E.

           ADD 1 TO FIELDNUM.
           IF ON-DATA (S1) NUMERIC
               NEXT SENTENCE
           ELSE
           MOVE 35029 TO CATREAD-MSG-NUMBER
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
           MOVE ERROR-BUFFER TO SCREEN-ERR-LINE
           MOVE TRUE-VAL TO INDS (FIELDNUM) INDS (99)
           MOVE "Y" TO SHOW-SW
           MOVE 9 TO S1
           GO TO C-C-T-E.
           IF (ON-DATA (S1) > "0000" OR ON-DATA (S1) = "0000")
               AND ON-DATA (S1) < "2400"
                   NEXT SENTENCE
           ELSE
           MOVE 35029 TO CATREAD-MSG-NUMBER
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
           MOVE ERROR-BUFFER TO SCREEN-ERR-LINE
           MOVE TRUE-VAL TO INDS (FIELDNUM) INDS (99)
           MOVE "Y" TO SHOW-SW
           MOVE 9 TO S1
           GO TO C-C-T-E.
           MOVE ON-DATA (S1) TO TIME-IN.
           CALL "TGETSHFT" USING LINK-DATA DBPARAMETERS.
           IF SHIFT-DATA = CURR-SHIFT
                NEXT SENTENCE
           ELSE
           MOVE 35029 TO CATREAD-MSG-NUMBER
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
           MOVE ERROR-BUFFER TO SCREEN-ERR-LINE
           MOVE TRUE-VAL TO INDS (FIELDNUM) INDS (99)
           MOVE "Y" TO SHOW-SW
           MOVE 9 TO S1
           GO TO C-C-T-E.

           ADD 1 TO FIELDNUM.
           IF OFF-DATA (S1) NUMERIC
                NEXT SENTENCE
           ELSE
           MOVE 35029 TO CATREAD-MSG-NUMBER
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
           MOVE ERROR-BUFFER TO SCREEN-ERR-LINE
           MOVE TRUE-VAL TO INDS (FIELDNUM) INDS (99)
           MOVE "Y" TO SHOW-SW
           MOVE 9 TO S1
           GO TO C-C-T-E.
           IF (OFF-DATA (S1) > "0000" OR OFF-DATA (S1) = "0000")
               AND OFF-DATA (S1) < "2400"
               NEXT SENTENCE
           ELSE
           MOVE 35029 TO CATREAD-MSG-NUMBER
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
           MOVE ERROR-BUFFER TO SCREEN-ERR-LINE
           MOVE TRUE-VAL TO INDS (FIELDNUM) INDS (99)
           MOVE "Y" TO SHOW-SW
           MOVE 9 TO S1
           GO TO C-C-T-E.
           MOVE OFF-DATA (S1) TO TIME-IN.
           CALL "TGETSHFT" USING LINK-DATA DBPARAMETERS.
           IF SHIFT-DATA = CURR-SHIFT
               NEXT SENTENCE
           ELSE
           MOVE 35029 TO CATREAD-MSG-NUMBER
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
           MOVE ERROR-BUFFER TO SCREEN-ERR-LINE
           MOVE TRUE-VAL TO INDS (FIELDNUM) INDS (99)
           MOVE "Y" TO SHOW-SW
           MOVE 9 TO S1
           GO TO C-C-T-E.

           MOVE ON-DATA  (S1) TO START-TIME.
           MOVE OFF-DATA (S1) TO STOP-TIME.
           MOVE START-DATA TO SHIFT-START.

           IF START-DATA > STOP-DATA
             IF (START-TIME > SHIFT-START OR START-TIME = SHIFT-START)
                AND START-TIME < 2400
                COMPUTE START-TIME = START-TIME - 2400.

           IF START-DATA > STOP-DATA
             IF (STOP-TIME  > SHIFT-START OR STOP-TIME  = SHIFT-START)
                AND STOP-TIME  < 2400
                COMPUTE STOP-TIME  = STOP-TIME -  2400.

           IF START-TIME < STOP-TIME
               NEXT SENTENCE
           ELSE
           MOVE 35029 TO CATREAD-MSG-NUMBER
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
           MOVE ERROR-BUFFER TO SCREEN-ERR-LINE
           MOVE TRUE-VAL TO INDS (FIELDNUM) INDS (99)
           MOVE "Y" TO SHOW-SW
           MOVE 9 TO S1
           GO TO C-C-T-E.
           ADD 1 TO FIELDNUM.

       C-C-T-E.    EXIT.

       ADD-LABOR-RECS.
           IF CARD-DATA (S1) = SPACES
               MOVE 9 TO S1
               GO TO A-L-R-E.
           MOVE CARD-DATA (S1) TO LCS-EMPL-NUM.
           MOVE WO-NUM-PLANNED TO LCS-WO-NUM.
           IF START-DATA > STOP-DATA
             IF (ON-DATA (S1) > START-DATA OR
                 ON-DATA (S1) = START-DATA)
                 AND ON-DATA (S1) < "2400"
               MOVE DATE-1 TO LCS-START-DATE
             ELSE
               MOVE DATE-0 TO LCS-START-DATE
           ELSE
             MOVE DATE-0 TO LCS-START-DATE.
           IF LCS-START-DATE-YY > "70"
               MOVE "19" TO LCS-START-DATE-CC
           ELSE
           MOVE "20"     TO LCS-START-DATE-CC.
           IF START-DATA > STOP-DATA
             IF (OFF-DATA (S1) > START-DATA OR
                 OFF-DATA (S1) = START-DATA)
                 AND OFF-DATA (S1) < "2400"
               MOVE DATE-1 TO LCS-COMP-DATE
             ELSE
               MOVE DATE-0 TO LCS-COMP-DATE
           ELSE
             MOVE DATE-0 TO LCS-COMP-DATE.
           IF LCS-COMP-DATE-YY > "70"
               MOVE "19" TO LCS-COMP-DATE-CC
           ELSE
           MOVE "20"     TO LCS-COMP-DATE-CC.
           MOVE ON-DATA (S1) TO LCS-START-TIME.
           MOVE OFF-DATA (S1) TO LCS-COMP-TIME.
           MOVE ZONE-P TO ZONE-LINK.

           CALL "TLABUPDT" USING DBPARAMETERS
                                 LABOR-CURR-DATA ZONE-LINK.

      ************************
      * SAVE IP AND CW DATES *
      ************************

           STRING LCS-START-DATE-CN LCS-START-TIME
                  DELIMITED BY SIZE INTO IP-DATE.
           STRING LCS-COMP-DATE-CN  LCS-COMP-TIME
                  DELIMITED BY SIZE INTO CW-DATE.
           IF WO-IP-DATE = SPACES
             MOVE IP-DATE TO WO-IP-DATE
           ELSE
           IF IP-DATE < WO-IP-DATE
             MOVE IP-DATE TO WO-IP-DATE.
           IF WO-CW-DATE = SPACES
             MOVE CW-DATE TO WO-CW-DATE
           ELSE
           IF CW-DATE > WO-CW-DATE
             MOVE CW-DATE TO WO-CW-DATE.
           MOVE 38001 TO CATREAD-MSG-NUMBER.
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
           MOVE LCS-EMPL-NUM TO ERR-CC.
           MOVE SPACES TO ERR-REST.
           MOVE ERR-HBE TO ERR-NAME.
           MOVE SPACES TO ERR-HBE.
           MOVE TRUE-VAL TO INDS (98).
           MOVE ERROR-BUFFER TO SCREEN-CMD-LINE.
           MOVE SCREEN-DATA TO DSPLY-REC.
           PERFORM 99-SCREEN-WRITE.
           PERFORM 98A-SCREEN-READ.
           CALL "CLPAUSE2".

       A-L-R-E.    EXIT.

       RESET-WO-STATUS-DATES.
           PERFORM 69-START-WO-PLANNED-FILE.
           IF COND-WORD NOT = 0 PERFORM 998-BLOWUP.
           PERFORM 69-READ-WO-PLANNED-FILE.
           IF COND-WORD NOT = 0 PERFORM 998-BLOWUP.
           PERFORM 69-DELETE-WO-PLANNED-FILE.
           PERFORM RESET-STATUS.
           PERFORM RESET-DATES.
           PERFORM 69-WRITE-WO-PLANNED-FILE.
           IF COND-WORD NOT = 0 PERFORM 998-BLOWUP.
           MOVE WO-NUM-PLANNED TO WO-NUM-TRACK.
           MOVE WO-STATUS-P TO WO-STATUS-TRACK.
           MOVE WO-START-STATUS TO WO-TYPE-STATUS.
           CALL "TWOTRACK" USING WO-TRACK-DATA.

           IF PM-SW = "Y"
             MOVE WO-NUM-PLANNED TO PM-WO-NUMBER
             MOVE "CW"           TO PM-UPDATE-CODE
             MOVE DATE-COMP-P    TO PM-UPDATE-DATE

             CALL "SPMCWSD" USING   PM-WO-NUMBER
                                    PM-UPDATE-CODE
                                    PM-UPDATE-DATE
                                    DBPARAMETERS
                                    PM-RETURN-CODE
                                    PM-RETURN-ERROR.

       RESET-STATUS.
           IF WO-STATUS-P = "HS" OR "SD" OR "PR"
             MOVE "IP" TO WO-STATUS-P.

           IF FAILURE-CODE = SPACES
               NEXT SENTENCE
           ELSE
           MOVE "CW" TO WO-STATUS-P
           MOVE FAILURE-CODE TO FAILURE-CODE-P
           IF WO-START-STATUS = "AA"
               MOVE "Y" TO PM-SW.

       RESET-DATES.
           STRING DATE-STRT-P-CN TIME-STRT-P   DELIMITED BY SIZE
                  INTO IP-DATE.
           STRING DATE-COMP-P-CN TIME-COMP-P   DELIMITED BY SIZE
                  INTO CW-DATE.

           IF IP-DATE = SPACES
               MOVE WO-IP-DT TO DATE-STRT-P-CN
               MOVE WO-IP-TM TO TIME-STRT-P
           ELSE
           IF WO-IP-DATE < IP-DATE
               MOVE WO-IP-DT TO DATE-STRT-P-CN
               MOVE WO-IP-TM TO TIME-STRT-P.

           IF WO-STATUS-P = "CW"
               IF WO-CW-DATE > CW-DATE
                   MOVE WO-CW-DT TO DATE-COMP-P-CN
                   MOVE WO-CW-TM TO TIME-COMP-P.

       69-DELETE-WO-PLANNED-FILE.
           MOVE 0 TO COND-WORD.
           DELETE WO-PLANNED-FILE RECORD
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF WPF-STATUS NOT = "00" MOVE 17 TO COND-WORD.

       69-READ-WO-PLANNED-FILE.
           MOVE 0 TO COND-WORD.
           READ WO-PLANNED-FILE NEXT INTO WO-PLANNED-DATA
               AT END    MOVE 15 TO COND-WORD.
           IF WONUM-DATA NOT = WONUM OF WPFREC
               MOVE 15 TO COND-WORD.
           IF WPF-STATUS NOT = "00" MOVE 15 TO COND-WORD.

       69-START-WO-PLANNED-FILE.
           MOVE 0 TO COND-WORD.
           MOVE WONUM-DATA TO WONUM OF WPFREC.
           START WO-PLANNED-FILE KEY IS = EXTERNALLY-DESCRIBED-KEY
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF WPF-STATUS NOT = "00" MOVE 17 TO COND-WORD.

        69-WRITE-WO-PLANNED-FILE.
            MOVE 0 TO COND-WORD.
            WRITE WPFREC FROM WO-PLANNED-DATA
                INVALID KEY    MOVE 17 TO COND-WORD.
            IF WPF-STATUS NOT = "00" MOVE 17 TO COND-WORD.

       98-SCREEN-READ.
           READ DISPLAY-FILE FORMAT IS VIEW-CFNAME
               INDIC IS INDICS.
           ACCEPT IOFEEDBACK FROM I-O-FEEDBACK-AREA.
           MOVE ALL B"0" TO INDICS.
           IF DSPLY-STATUS NOT = "00"
               MOVE 3 TO VIEW-LASTKEY
           ELSE
           MOVE FUNCTION-NUM TO VIEW-LASTKEY.

       98A-SCREEN-READ.
           READ DISPLAY-FILE TERMINAL IS TERMINAL-ID
               INDIC IS INDICS
                  NO DATA MOVE DSPLY-STATUS TO DSPLY-STATUS.
           MOVE ALL B"0" TO INDICS.

       99-SCREEN-WRITE.
           WRITE DSPLY-REC FORMAT IS VIEW-CFNAME
               INDIC IS INDICS.
           MOVE ALL B"0" TO INDICS.

       998-BLOWUP.
           MOVE "TLABORWO" TO BU-PGM-NAME.
           CALL "TBLOWUP" USING BLOWUP-BASE BU-PGM-NAME STATUS-AREA
                            VIEW-COMAREA DUMMY-KSAM-STAT
                            BU-DISPLAY-MSG BU-DISPLAY-FLDS.

       999-CATREAD.
           MOVE SPACES TO ERROR-BUFFER.
           CALL "CCATREAD" USING CATREAD-PARMS.
           MOVE CATREAD-MSG-TEXT TO ERROR-BUFFER.
       999-CATREAD-EXIT.    EXIT.
