       IDENTIFICATION DIVISION.
       PROGRAM-ID.             TDVIPINQ.
      *C
      *C  09/16/1996       CA YODER
      *C    RE-COMPILED PROGRAM FOR CENTURY DATABASE CHANGES.
      *C
       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.
       SOURCE-COMPUTER.        IBM-AS400.
       OBJECT-COMPUTER.        IBM-AS400.
       COPY SPECIALN           IN COPYLIB.

       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT DISPLAY-FILE
                  ASSIGN       TO WORKSTATION-ZINQUIRY-SI
                  ORGANIZATION IS TRANSACTION
                  FILE STATUS  IS SCREEN-STATUS
                               MAJOR-MINOR
                  CONTROL-AREA IS SCREEN-CONTROL.

           SELECT LABOR-CUR-STAT
                  ASSIGN       TO DATABASE-MCFLMM1602
                  ORGANIZATION IS INDEXED
                  ACCESS MODE  IS DYNAMIC
                  RECORD KEY   IS EXTERNALLY-DESCRIBED-KEY
                               WITH DUPLICATES
                  FILE STATUS  IS FILE-STAT.

           SELECT OUT-FILE
                  ASSIGN       TO DATABASE-OUTIPDVI
                  ORGANIZATION IS RELATIVE
                  ACCESS MODE  IS RANDOM
                  RELATIVE KEY IS ACT-KEY
                  FILE STATUS  IS FILE-STAT.

           SELECT PER-PERSONNEL
                  ASSIGN       TO DATABASE-MCFLMM0301
                  ORGANIZATION IS INDEXED
                  ACCESS MODE  IS DYNAMIC
                  RECORD KEY   IS EXTERNALLY-DESCRIBED-KEY
                  FILE STATUS  IS FILE-STAT.

           SELECT PRINT-FILE
                  ASSIGN       TO PRINTER-MCPRT.

           SELECT SORT-FILE
                  ASSIGN       TO DISK-SORTFILE.

           SELECT WO-BASIC
                  ASSIGN       TO DATABASE-MCFLMM1002
                  ORGANIZATION IS INDEXED
                  ACCESS MODE  IS DYNAMIC
                  RECORD KEY   IS EXTERNALLY-DESCRIBED-KEY
                               WITH DUPLICATES
                  FILE STATUS  IS FILE-STAT.

           SELECT WO-LAST-NUM-USED
                  ASSIGN       TO DATABASE-MCFPMM0800
                  ORGANIZATION IS RELATIVE
                  ACCESS MODE  IS DYNAMIC
                  RELATIVE KEY IS ACT-KEY
                  FILE STATUS  IS FILE-STAT.

           SELECT WO-PLANNED
                  ASSIGN       TO DATABASE-MCFLMM1102
                  ORGANIZATION IS INDEXED
                  ACCESS MODE  IS DYNAMIC
                  RECORD KEY   IS EXTERNALLY-DESCRIBED-KEY
                               WITH DUPLICATES
                  FILE STATUS  IS FILE-STAT.

           SELECT WO-ZONE-PRTY
                  ASSIGN       TO DATABASE-MCFLMM0501
                  ORGANIZATION IS INDEXED
                  ACCESS MODE  IS DYNAMIC
                  RECORD KEY   IS EXTERNALLY-DESCRIBED-KEY
                  FILE STATUS  IS FILE-STAT.

       DATA DIVISION.
       FILE SECTION.
       FD  DISPLAY-FILE
           LABEL RECORDS       ARE OMITTED.
       01  DISPLAY-REC         PIC X(2000).

       FD  LABOR-CUR-STAT
           LABEL RECORDS       ARE STANDARD.
       01  LCSFREC.
           COPY DDS-ALL-FORMATS OF MCFLMM1602.

       FD  OUT-FILE RECORD     CONTAINS 104 CHARACTERS
           LABEL RECORDS       ARE OMITTED
           DATA RECORD         IS OUT-REC.
       01  OUT-REC.
           05  OUT-DATA.
               10  DEPT-OUT           PIC X(4).
               10  ZONE-OUT.
                   15  Z-OUT          PIC X(4).
                   15  P-OUT          PIC X.
                   15  FILLER         PIC X.
               10  SHIFT-OUT          PIC X.
               10  WOSTAT-OUT.
                   15  WOSTAT-O-1     PIC X.
                   15  WOSTAT-O-2     PIC X.
                   15  WOSTAT-O-34    PIC XX.
               10  WONUM-OUT.
                   15  WONO-OUT       PIC X(7).
                   15  WOSU-OUT       PIC X(3).
               10  WODESC-OUT         PIC X(30).
               10  EQNUM-OUT          PIC X(6).
               10  EQDOWN-OUT         PIC XX.
               10  DATE-RCVD.
                   15  DATE-RCVD-MM   PIC XX.
                   15  DATE-RCVD-DD   PIC XX.
                   15  DATE-RCVD-YY   PIC XX.
               10  TIME-RCVD          PIC XXXX.
               10  TIME-COMP-OUT      PIC XXXX.
               10  CRAFTSREQ-OUT.
                   15  C1-OUT         PIC XX.
                   15  C2-OUT         PIC XX.
                   15  C3-OUT         PIC XX.
               10  CMAN-1-OUT         PIC XXXX.
               10  CMAN-2-OUT         PIC XXXX.
               10  CMAN-3-OUT         PIC XXXX.
               10  TSTRT-OUT          PIC XXXX.
               10  RETM-OUT           PIC XXXX.
               10  VP-FLAG-OUT        PIC X.

       FD  PER-PERSONNEL
           LABEL RECORDS       ARE STANDARD.
       01  PFREC.
           COPY DDS-ALL-FORMATS OF MCFLMM0301.

       FD  PRINT-FILE RECORD   CONTAINS 80 CHARACTERS
           LABEL RECORDS       ARE OMITTED
           DATA RECORD         IS PRINT-REC.
       01  PRINT-REC           PIC X(80).

       SD  SORT-FILE RECORD    CONTAINS 104 CHARACTERS
           DATA RECORD         IS SORT-REC.
       01  SORT-REC.
           05  SORT-DEPT               PIC X(4).
           05  SORT-ZONE.
               10  SORT-Z              PIC X(4).
               10  SORT-P              PIC X.
               10  FILLER              PIC X.
           05  SORT-SHIFT              PIC X.
           05  SORT-WOSTAT             PIC X(4).
           05  SORT-WONUM.
               10  SORT-WONO           PIC X(7).
               10  SORT-WOSU           PIC X(3).
           05  SORT-WODESC             PIC X(30).
           05  SORT-EQNUM.
               10  SORT-EQ1            PIC X.
               10  SORT-EQ2            PIC X.
               10  SORT-EQ3            PIC X.
               10  SORT-EQ4            PIC X.
               10  SORT-EQ5            PIC X.
               10  SORT-EQ6            PIC X.
           05  SORT-EQDOWN             PIC XX.
           05  SORT-DATE-RCVD.
               10  SORT-DATE-RCVD-MM   PIC XX.
               10  SORT-DATE-RCVD-DD   PIC XX.
               10  SORT-DATE-RCVD-YY   PIC XX.
           05  SORT-TIME-RCVD          PIC XXXX.
           05  TIME-COMP-SORT          PIC XXXX.
           05  SORT-CRAFTSREQ.
               10  SORT-C1             PIC XX.
               10  SORT-C2             PIC XX.
               10  SORT-C3             PIC XX.
           05  CMAN-1-SORT             PIC XXXX.
           05  CMAN-2-SORT             PIC XXXX.
           05  CMAN-3-SORT             PIC XXXX.
           05  TSTRT-SORT              PIC XXXX.
           05  RETM-SORT               PIC XXXX.
           05  VP-FLAG-SORT            PIC X.

       FD  WO-BASIC
           LABEL RECORDS       ARE STANDARD.
       01  WBFREC.
           COPY DDS-ALL-FORMATS OF MCFLMM1002.

       FD  WO-LAST-NUM-USED
           LABEL RECORDS       ARE STANDARD.
       01  WLNUREC.
           COPY DDS-ALL-FORMATS OF MCFPMM0800.

       FD  WO-PLANNED
           LABEL RECORDS       ARE STANDARD.
       01  WPFREC.
           COPY DDS-ALL-FORMATS OF MCFLMM1102.

       FD  WO-ZONE-PRTY
           LABEL RECORDS       ARE STANDARD.
       01  WZPMFREC.
           COPY DDS-ALL-FORMATS OF MCFLMM0501.

       WORKING-STORAGE SECTION.
       77  ACT-KEY             PIC 9(9).
       77  ADV-CTR             PIC 9       VALUE 1.
       77  ALL-RECORDS-WRITTEN-SW
                               PIC X       VALUE SPACE.
       77  ARG-NO              PIC S9(9)   COMP-4.
       77  EOF-SW              PIC 9       VALUE 0.
       77  FIELD-CTR           PIC 99      VALUE 0.
       77  FIELD-HOLD          PIC X(79).
       77  FILE-SW             PIC 9       VALUE 1.
           88  BASIC-FILE                  VALUE 1.
       77  HEADING-DOTS        PIC X(79)   VALUE ALL "-".
       77  HOLD-BUFFER         PIC X(80).
       77  MASTER-BUFFER       PIC X(8).
       77  NEW-STAT-SW         PIC 9       VALUE 0.
       77  PRIORITY-TAG        PIC X.
       77  PRTY-CTR            PIC 99999   VALUE 0.
       77  P-SAVE              PIC X       VALUE SPACE.
       77  SCREEN-FLAG         PIC 9       VALUE 0.
       77  STAT-SAVE           PIC X(4)    VALUE SPACES.
       77  WOSTAT-BUF          PIC XX      VALUE "IP".
       77  WONUM-SAVE          PIC X(10)   VALUE SPACES.
       77  ZONE-HOLD           PIC X(04)   VALUE SPACES.
       77  TRUE-VAL            PIC 1       VALUE B"1".
       77  ERROR-BUFFER        PIC X(80).

       01  FILE-STAT.
           05  FILE-STAT-1     PIC X.
           05  FILE-STAT-2     PIC X.

       01  COUNTERS.
           05  PRTY1-K         PIC 9(4).
           05  PRTY2-K         PIC 9(4).
           05  PRTY3-K         PIC 9(4).
           05  PRTY4-K         PIC 9(4).
           05  PRTY5-K         PIC 9(4).
           05  LINE-K          PIC S99.

       01  CDATE-BUFFER.
           05  YY-BUF          PIC XX.
           05  MM-BUF          PIC XX.
           05  DD-BUF          PIC XX.

       01  DETAIL-REC.
           05  DETAIL-PREFIX.
               10  VP-FLAG             PIC X.
               10  WONUM-7             PIC X(7).
               10  FILLER              PIC X  VALUE "-".
               10  WONUM-3             PIC X(3).
               10  FILLER              PIC XX VALUE SPACES.
               10  EQNUM               PIC X(6).
               10  FILLER              PIC XX VALUE SPACES.
               10  EQDOWN              PIC XX.
               10  FILLER              PIC XX VALUE SPACE.
               10  WODESC              PIC X(30).
           05  DREC-IP.
               10  FILLER              PIC XXX.
               10  CCNUM-IP            PIC XXXX.
               10  FILLER              PIC XXX.
               10  TSTR-IP             PIC X(4).
               10  FILLER              PIC XXX.
               10  CRAFTSREQ-1-IP      PIC XX.
               10  FILLER              PIC X(04).

       01  FILL-SCREEN.
           05  FIELD-1         PIC X(78).
           05  FIELD-2         PIC X(79).
           05  FIELD-3         PIC X(79).
           05  FIELD-4         PIC X(79).
           05  FIELD-5         PIC X(79).
           05  FIELD-6         PIC X(79).
           05  FIELD-7         PIC X(79).
           05  FIELD-8         PIC X(79).
           05  FIELD-9         PIC X(79).
           05  FIELD-10        PIC X(79).
           05  FIELD-11        PIC X(79).
           05  FIELD-12        PIC X(79).
           05  FIELD-13        PIC X(79).
           05  FIELD-14        PIC X(79).
           05  FIELD-15        PIC X(79).
           05  FIELD-16        PIC X(79).
           05  FIELD-17        PIC X(79).
           05  FIELD-18        PIC X(79).
           05  FIELD-19        PIC X(79).
           05  FIELD-20        PIC X(79).
           05  FIELD-21        PIC X(79).
           05  FIELD-22        PIC X(79).
           05  FIELD-23        PIC X(79).
           05  SCRN-CMD-LINE   PIC X(79).
           05  SCRN-ERR-LINE   PIC X(79).

       01  FORMS-BUFFER.
           05  ZONE-BUF.
               10  Z-BUF-1     PIC X.
               10  Z-BUF-2     PIC X.
               10  FILLER      PIC XX.
           05  PRIORITY-BUF    PIC X.
           05  PRINT-BUF       PIC X.
           05  FORMS-CMD-LINE  PIC X(79).
           05  FORMS-ERR-LINE  PIC X(79).

       01  HEADING-DT-TM.
           05  FILLER  PIC X(20) VALUE SPACES.
           05  FILLER  PIC X(13) VALUE "PRINT DATE:  ".
           05  P-DATE.
               10  P-M PIC XX    VALUE SPACES.
               10  FILLER  PIC X VALUE "/".
               10  P-D PIC XX    VALUE SPACES.
               10  FILLER  PIC X VALUE "/".
               10  P-Y PIC XX    VALUE SPACES.
           05  FILLER  PIC X(15) VALUE "        TIME:  ".
           05  P-TIME  PIC X(04) VALUE SPACES.
           05  FILLER  PIC X(19) VALUE SPACES.

       01  HEADING-1-H.
           05  FILLER  PIC X(04) VALUE SPACES.
           05  FILLER  PIC X(10) VALUE "I P   S T ".
           05  FILLER  PIC X(17) VALUE "A T U S   B A C K".
           05  FILLER  PIC X(20) VALUE " L O G   S C R E E N".
           05  FILLER  PIC X(21) VALUE "   F O R   Z O N E:  ".
           05  MZ-1-H  PIC X(04) VALUE SPACES.
           05  FILLER  PIC X(03) VALUE SPACES.

       01  HEADING-X.
           05  FILLER          PIC X(20) VALUE SPACES.
           05  FILLER          PIC X(20) VALUE "'*' IS A PLANNED OR ".
           05  FILLER          PIC X(20) VALUE "ENGINEERED WORKORDER".
           05  FILLER          PIC X(19) VALUE SPACES.

       01  HEADING-2-COMP.
           05  HEADING-2-P     PIC X(04) VALUE SPACES.
           05  HEADING-2       PIC X(79).
           05  HEADING-2-S     PIC X(04) VALUE SPACES.

       01  HEADING-2-IP.
           05  FILLER          PIC X(14) VALUE " W/O NUM      ".
           05  FILLER          PIC X(12) VALUE "EQ NUM  DN  ".
           05  FILLER          PIC X(15) VALUE "W/O DESCRIPTION".
           05  FILLER          PIC X(10) VALUE SPACES.
           05  FILLER          PIC X(17) VALUE "   CC #   TSTR   ".
           05  FILLER          PIC X(11) VALUE "CRFT IP    ".

       01  LITERAL-1-L.
           05  FILLER          PIC X(9) VALUE "PRIORITY:".
           05  PRTY-1-L        PIC X.
           05  FILLER          PIC X(15) VALUE " ***TOTAL WORK ".
           05  FILLER          PIC X(9) VALUE "ORDERS = ".
           05  NUM-1-L         PIC ZZZ9.
           05  FILLER          PIC X(41) VALUE SPACES.

       01  NO-RECORDS-ERR.
           05  FILLER  PIC X(08) VALUE "NO W/O'S".
           05  FILLER  PIC X(26) VALUE " MEET THESE REQUIREMENTS--".
           05  FILLER  PIC X(20) VALUE "PRESS f2 TO REQUEST ".
           05  FILLER  PIC X(20) VALUE "AGAIN, f8 TO END JOB".

       01  PASSWORD-INFORMATION.
           05  NAME-OF-PROGRAM     PIC X(08) VALUE "TDVIPINQ".
           05  PROGRAM-TYPE        PIC X(02) VALUE "IN".
           05  PROGRAM-RELEASE     PIC X(12) VALUE " E0100010001".
           05  PROGRAM-DESCRIPTION.
               10  PROG-DESC-A     PIC X(60) VALUE
                 "INQUIRY FOR IP'D WORK ORDERS ONLY IN DANVILLE  "     .
               10  PROG-DESC-B     PIC X(60) VALUE SPACES.
               10  PROG-FUNCTION   PIC X(60) VALUE SPACES.
           05  PASSWORD-FLAG       PIC X.

       01  TIME-BUFFER.
           05  CUR-TIME.
               10  CUR-HRS     PIC XX.
               10  CUR-MINS    PIC XX.
           05  CUR-SECS        PIC XX.

       01  WORK-ARGUMENTS.
           05  ARG-DEFN.
               10  WO-NUM-ARG  PIC X(7).
               10  WO-SUFF-ARG PIC X(3).
           05  ARG-DEFN-3      PIC X(04).
           05  ANS             PIC X.

       01  ZONE-ARGUMENT.
           05  Z-ARG-4         PIC X(4).
           05  Z-ARG-5         PIC X VALUE "1".
           05  FILLER          PIC X VALUE SPACE.

       01  ZONE-BUFFERS.
           05  ZONE-BUF1       PIC XXXX.
           05  ZONE-BUF2       PIC XXXX.
           05  ZONE-BUF3       PIC XXXX.

       COPY OVRPFDATA          IN COPYLIB.

       COPY SCREENIO           IN COPYLIB.

       COPY CATREAD            IN COPYLIB.

       01  DBPARAMETERS.       COPY DBPARMS OF COPYLIB.

       01  WO-BASIC-DATA.      COPY DWOBASIC OF COPYLIB.

       01  WO-PLANNED-DATA.    COPY DWOPLAN  OF COPYLIB.

       01  PER-PERSONNEL-DATA. COPY MPERSONL OF COPYLIB.

       01  LAST-WO-BUFF.       COPY MLASTWO  OF COPYLIB.

       01  LBR-CURSTAT-DATA.   COPY DCURRLBR OF COPYLIB.

       PROCEDURE DIVISION.
       BEGIN-PROC.
           CALL "CLIPINQ".
           PERFORM 1-HSK.
           MOVE 0              TO KEY-HIT.
           PERFORM 6-MAIN      UNTIL KEY-HIT = 3.

       2-EOJ.
           CLOSE               DISPLAY-FILE.
           CLOSE               LABOR-CUR-STAT.
           CLOSE               PER-PERSONNEL.
           IF PRINT-BUF = "P"
               CLOSE           PRINT-FILE.
           CLOSE               WO-BASIC.
           CLOSE               WO-LAST-NUM-USED.
           CLOSE               WO-PLANNED.
           CLOSE               WO-ZONE-PRTY.
           IF KEY-HIT = 1      MOVE 2 TO KEY-HIT.
           IF KEY-HIT = 2      GO TO 6-MAIN.
           GOBACK.

       1-HSK.
           OPEN I-O            DISPLAY-FILE.
           OPEN INPUT          LABOR-CUR-STAT.
           OPEN INPUT          PER-PERSONNEL.
           OPEN INPUT          WO-BASIC.
           OPEN INPUT          WO-LAST-NUM-USED.
           OPEN INPUT          WO-PLANNED.
           OPEN INPUT          WO-ZONE-PRTY.
           ACCEPT CDATE-BUFFER FROM DATE.
           MOVE YY-BUF         TO P-Y.
           MOVE MM-BUF         TO P-M.
           MOVE DD-BUF         TO P-D.
           ACCEPT TIME-BUFFER  FROM TIME.
           MOVE CUR-TIME       TO P-TIME.
           MOVE 1              TO ACT-KEY.
           READ WO-LAST-NUM-USED INTO LAST-WO-BUFF
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
               MOVE 1          TO DATE-FLAG-SW.
           CALL "TPWORD"       USING PASSWORD-INFORMATION.
           IF PASSWORD-FLAG = "N" GO TO 2-EOJ.

       6-MAIN.
           PERFORM 61-WRITE-SCREEN THRU 61-WS-EXIT.
           PERFORM 62-SORT-INPUT.
           PERFORM 63-DISPLAY-OUTPUT.
           CLOSE               OUT-FILE.

       61-WRITE-SCREEN.
           MOVE 0              TO ACT-KEY.
           MOVE 0              TO PRTY-CTR.
           MOVE SPACES         TO ZONE-HOLD.
           MOVE 1              TO ADV-CTR.
           ACCEPT TIME-BUFFER  FROM TIME.
           MOVE CUR-TIME       TO P-TIME.
           MOVE SPACES         TO WORK-ARGUMENTS.
           MOVE SPACES         TO FORMS-BUFFER ERROR-BUFFER.
           MOVE SPACES         TO WONUM-SAVE.
           MOVE "N"            TO ALL-RECORDS-WRITTEN-SW.
           MOVE ZEROS          TO COUNTERS.

       61-WRITE-SCREEN-LOOP.
           MOVE "FDVIPINQ"     TO SCREEN-NAME.
           MOVE ERROR-BUFFER   TO FORMS-ERR-LINE.
           MOVE FORMS-BUFFER   TO DISPLAY-REC.

           WRITE DISPLAY-REC   FORMAT IS SCREEN-NAME
                               INDIC ARE SCREEN-INDICATORS.
           IF SCREEN-STATUS NOT = "00"
               DISPLAY "SCREEN WRITE ERROR.  SCREEN-STATUS IS "
                        SCREEN-STATUS
               GO TO 2-EOJ.

           READ DISPLAY-FILE   FORMAT IS SCREEN-NAME
                               INDIC ARE SCREEN-INDICATORS.
           IF SCREEN-STATUS NOT = "00"
               DISPLAY "SCREEN READ ERROR.  SCREEN-STATUS IS "
                        SCREEN-STATUS
               GO TO 2-EOJ.

           MOVE ALL B"0"       TO SCREEN-INDICATORS.
           MOVE DISPLAY-REC    TO FORMS-BUFFER.

           IF KEY-HIT = 3      GO TO 2-EOJ.

           IF KEY-HIT NOT = 0  GO TO 61-WRITE-SCREEN-LOOP.

           IF PRINT-BUF = " "
               NEXT SENTENCE
           ELSE
           MOVE "P"            TO PRINT-BUF
      *    MOVE 0              TO OVRPRTF-TOFILE-NUM
           MOVE "P "           TO OVRPRTF-TOFILE-NUM-X.
           PERFORM 996-OVERRIDE-PRINT-FILE
           OPEN OUTPUT         PRINT-FILE.

           IF PRIORITY-BUF = SPACE
               MOVE "A"        TO PRIORITY-BUF.
           IF PRIORITY-BUF = "1" OR "2" OR "3" OR "4" OR
                                    "5" OR "A"
               NEXT SENTENCE
           ELSE
      **********************************************************************
      **    MESSAGE 035/080:
      **  INVALID PRIORITY
      **********************************************************************
           MOVE 35             TO CATREAD-MSG-SET
           MOVE 80             TO CATREAD-MSG-NUM
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
           MOVE TRUE-VAL       TO IND(4) IND(99)
           GO TO 61-WRITE-SCREEN-LOOP.

           IF ZONE-BUF = SPACES
               NEXT SENTENCE
           ELSE
           IF Z-BUF-1 = "A" AND Z-BUF-2 = " " OR "A"
               NEXT SENTENCE
           ELSE
           IF Z-BUF-1 = "B" AND Z-BUF-2 = " " OR "B" OR "C" OR "D"
               NEXT SENTENCE
           ELSE
           IF Z-BUF-1 = "C" AND Z-BUF-2 = " "
               NEXT SENTENCE
           ELSE
           PERFORM 69-START-WO-ZONE-PRTY-MSTR
           IF FILE-STAT NOT = "00"
      **********************************************************************
      **    MESSAGE 035/044:
      **  INVALID ZONE
      **********************************************************************
              MOVE 35          TO CATREAD-MSG-SET
              MOVE 44          TO CATREAD-MSG-NUM
              PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
              MOVE TRUE-VAL    TO IND(2) IND(99)
              GO TO 61-WRITE-SCREEN-LOOP.

       61-WS-EXIT.             EXIT.

       62-SORT-INPUT.
           IF ZONE-BUF = SPACES
               SORT SORT-FILE  ASCENDING KEY SORT-Z
                                             SORT-P
                                             SORT-WONUM
                                             CMAN-1-SORT
               INPUT PROCEDURE  7-SORT-INPUT-RECORDS
               OUTPUT PROCEDURE 8-WRITE-FILE
           ELSE
               SORT SORT-FILE  ASCENDING KEY SORT-P
                                             SORT-WONUM
                                             CMAN-1-SORT
               INPUT PROCEDURE  7-SORT-INPUT-RECORDS
               OUTPUT PROCEDURE 8-WRITE-FILE.

           MOVE 0              TO ACT-KEY.
           CLOSE               OUT-FILE.
           OPEN INPUT          OUT-FILE.

       63-DISPLAY-OUTPUT.
           MOVE "FQ1SCRN"      TO SCREEN-NAME.
           MOVE SPACES         TO FILL-SCREEN.
           PERFORM 631-SETUP   THRU 631-EXIT.
           PERFORM 632-MAIN    THRU 632-EXIT UNTIL
                               ALL-RECORDS-WRITTEN-SW = "Y".

       632-MAIN.
           IF ZONE-BUF = SPACES
               IF Z-OUT NOT = ZONE-HOLD
                   MOVE P-SAVE TO PRTY-1-L
                   PERFORM 6321-PRTY-LITERAL
                   IF PRINT-BUF NOT = "P"
                       MOVE 18 TO LINE-K
                   ELSE
                   MOVE Z-OUT  TO ZONE-HOLD MZ-1-H
                   MOVE 55     TO LINE-K.

           IF PRINT-BUF NOT = "P"
               IF FIELD-CTR > 22 OR LINE-K > 16
      **********************************************************************
      **    MESSAGE 042/061:
      **  PRESS F1 TO CONTINUE, F2 FOR MENU, F3 TO END PROGRAM
      **********************************************************************
                   MOVE 42     TO CATREAD-MSG-SET
                   MOVE 61     TO CATREAD-MSG-NUM
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE 4      TO FIELD-CTR
                   PERFORM 632-SHOWFORM.

           IF PRINT-BUF = "P"
               IF LINE-K > 54
                   MOVE 0      TO LINE-K
                   PERFORM 6320-HEADINGS.

           MOVE SPACES         TO DETAIL-REC.
           MOVE WONO-OUT       TO WONUM-7.
           MOVE WOSU-OUT       TO WONUM-3.
           MOVE EQNUM-OUT      TO EQNUM.
           MOVE EQDOWN-OUT     TO EQDOWN.
           MOVE WODESC-OUT     TO WODESC.
           MOVE CMAN-1-OUT     TO CCNUM-IP.
           MOVE TSTRT-OUT      TO TSTR-IP.
           MOVE C1-OUT         TO CRAFTSREQ-1-IP.
           MOVE VP-FLAG-OUT    TO VP-FLAG.

           IF WONUM-OUT = WONUM-SAVE
               MOVE SPACES     TO DETAIL-PREFIX
           ELSE
           MOVE WONUM-OUT      TO WONUM-SAVE.

           IF ZONE-BUF NOT = SPACES
               IF P-OUT NOT = PRIORITY-TAG
                   MOVE P-OUT  TO PRIORITY-TAG
                   PERFORM 6321-PRTY-LITERAL.

           IF ZONE-BUF = SPACES
             IF Z-OUT = ZONE-HOLD
               IF P-OUT NOT = PRIORITY-TAG
                   MOVE P-SAVE TO PRTY-1-L
                   PERFORM 6321-PRTY-LITERAL.

           IF ZONE-BUF = SPACES
               IF Z-OUT NOT = ZONE-HOLD
                   MOVE 0      TO PRTY-CTR
                   MOVE Z-OUT  TO ZONE-HOLD MZ-1-H
                   IF PRINT-BUF NOT = "P"
                       PERFORM 6320-HEADINGS.

           IF PRINT-BUF NOT = "P"
               MOVE DETAIL-REC TO FIELD-HOLD
               PERFORM 6322-WRITE-FIELDS
               IF FIELD-CTR > 22
                   MOVE 1      TO SCREEN-FLAG.

           IF PRINT-BUF = "P"
               MOVE DETAIL-REC TO HOLD-BUFFER
               PERFORM 6322-PRINT-FUNCTION.

           ADD 1 TO LINE-K.
           IF DETAIL-PREFIX NOT = SPACES
               ADD 1           TO PRTY-CTR.
           ADD 1 TO ACT-KEY.
           READ OUT-FILE       INVALID KEY
               PERFORM 6323-INVALID-KEY-FUNCTION THRU 6323-IKF-EXIT
               MOVE "Y"        TO ALL-RECORDS-WRITTEN-SW
               GO TO 632-SHOWFORM.

           IF PRINT-BUF = "P"  GO TO 632-EXIT.
           IF SCREEN-FLAG = 0  GO TO 632-EXIT.
           MOVE 0              TO SCREEN-FLAG.

       632-SHOWFORM.
           IF PRINT-BUF = "P"  GO TO 632-EXIT.
           MOVE ERROR-BUFFER   TO SCRN-ERR-LINE.
           IF EOF-SW = 1
      **********************************************************************
      **    MESSAGE 066/133:
      **  END OF DATA--PRESS F2 TO REQUEST AGAIN OR F3 TO EXIT PROGRAM
      **********************************************************************
               MOVE 66         TO CATREAD-MSG-SET
               MOVE 133        TO CATREAD-MSG-NUM
           ELSE
      **********************************************************************
      **    MESSAGE 042/061:
      **  PRESS F1 TO CONTINUE, F2 FOR MENU, F3 TO END PROGRAM
      **********************************************************************
           MOVE 42             TO CATREAD-MSG-SET
           MOVE 61             TO CATREAD-MSG-NUM.

           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
           MOVE ERROR-BUFFER   TO SCRN-CMD-LINE.
           MOVE FILL-SCREEN    TO DISPLAY-REC.

           WRITE DISPLAY-REC   FORMAT IS SCREEN-NAME
                               INDIC ARE SCREEN-INDICATORS.
           IF SCREEN-STATUS NOT = "00"
               DISPLAY "SCREEN WRITE ERROR.  SCREEN-STATUS IS "
                        SCREEN-STATUS
               GO TO 2-EOJ.

           READ DISPLAY-FILE   FORMAT IS SCREEN-NAME
                               INDIC ARE SCREEN-INDICATORS.
           IF SCREEN-STATUS NOT = "00"
               DISPLAY "SCREEN READ ERROR.  SCREEN-STATUS IS "
                        SCREEN-STATUS
               GO TO 2-EOJ.

           MOVE ALL B"0"       TO SCREEN-INDICATORS.
           MOVE 0              TO LINE-K FIELD-CTR.

           IF KEY-HIT = 3      GO TO 2-EOJ.

           IF KEY-HIT = 1 OR 0
               IF EOF-SW = 0
                   IF NEW-STAT-SW = 0
                       PERFORM 6320-HEADINGS
                   ELSE
                   MOVE 0      TO NEW-STAT-SW
                   MOVE "Y"    TO ALL-RECORDS-WRITTEN-SW
               ELSE
               MOVE "Y"        TO ALL-RECORDS-WRITTEN-SW
               MOVE 2          TO KEY-HIT
           ELSE
           IF KEY-HIT = 2
               MOVE "Y"        TO ALL-RECORDS-WRITTEN-SW
           ELSE
           MOVE "Y"            TO ALL-RECORDS-WRITTEN-SW

           MOVE 2              TO KEY-HIT.

       632-EXIT.               EXIT.

       6320-HEADINGS.
           MOVE SPACES         TO FILL-SCREEN.
           IF PRINT-BUF NOT = "P"
               MOVE HEADING-1-H TO FIELD-2
               MOVE HEADING-X   TO FIELD-3
           ELSE
           MOVE HEADING-DT-TM  TO PRINT-REC
           WRITE PRINT-REC     AFTER ADVANCING NEW-PAGE
           MOVE HEADING-1-H    TO HOLD-BUFFER
           PERFORM 6322-PRINT-FUNCTION
           MOVE HEADING-X      TO HOLD-BUFFER
           PERFORM 6322-PRINT-FUNCTION.

           MOVE HEADING-2-IP   TO HEADING-2.

           IF PRINT-BUF NOT = "P"
               MOVE HEADING-2-COMP TO FIELD-4
               MOVE 4          TO FIELD-CTR
           ELSE
           MOVE HEADING-2      TO HOLD-BUFFER
           PERFORM 6322-PRINT-FUNCTION
           MOVE HEADING-DOTS   TO HOLD-BUFFER
           PERFORM 6322-PRINT-FUNCTION.

       6321-PRTY-LITERAL.
           MOVE P-OUT          TO PRIORITY-TAG P-SAVE.
           IF ZONE-BUF NOT = SPACES
               MOVE P-OUT      TO PRTY-1-L.
           IF ZONE-BUF = SPACES
               MOVE PRTY-CTR   TO NUM-1-L
               MOVE 0          TO PRTY-CTR
           ELSE
           IF PRTY-1-L = 1
               MOVE PRTY1-K    TO NUM-1-L
           ELSE
           IF PRTY-1-L = 2
               MOVE PRTY2-K    TO NUM-1-L
           ELSE
           IF PRTY-1-L = 3
               MOVE PRTY3-K    TO NUM-1-L
           ELSE
           IF PRTY-1-L = 4
               MOVE PRTY4-K    TO NUM-1-L
           ELSE
           IF PRTY-1-L = 5
               MOVE PRTY5-K    TO NUM-1-L.

           IF PRINT-BUF NOT = "P"
               MOVE LITERAL-1-L TO FIELD-HOLD
               PERFORM 6322-WRITE-FIELDS
               IF ZONE-BUF = SPACES
                   MOVE HEADING-DOTS TO FIELD-HOLD
                   PERFORM 6322-WRITE-FIELDS
                   ADD 1       TO LINE-K
               ELSE
               NEXT SENTENCE
           ELSE
           MOVE LITERAL-1-L    TO HOLD-BUFFER
           PERFORM 6322-PRINT-FUNCTION
           IF ZONE-BUF = SPACES
               MOVE HEADING-DOTS TO HOLD-BUFFER
               PERFORM 6322-PRINT-FUNCTION
               ADD 1           TO LINE-K.
           ADD 1               TO LINE-K.

       6323-INVALID-KEY-FUNCTION.
           IF PRINT-BUF NOT = "P"
               IF ZONE-BUF = SPACES
                   MOVE P-SAVE TO PRTY-1-L
                   PERFORM 6321-PRTY-LITERAL
      **********************************************************************
      **    MESSAGE 066/122:
      **  END OF DATA -- DEPRESS F3 FUNCTION KEY
      **********************************************************************
                   MOVE 66     TO CATREAD-MSG-SET
                   MOVE 122    TO CATREAD-MSG-NUM
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE 1      TO EOF-SW
               ELSE
      **********************************************************************
      **    MESSAGE 066/122:
      **  END OF DATA -- DEPRESS F3 FUNCTION KEY
      **********************************************************************
               MOVE 66         TO CATREAD-MSG-SET
               MOVE 122        TO CATREAD-MSG-NUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE 1          TO EOF-SW
           ELSE
           IF ZONE-BUF = SPACES
               MOVE P-SAVE     TO PRTY-1-L
               PERFORM 6321-PRTY-LITERAL
               MOVE SPACES     TO PRINT-REC
      *        WRITE PRINT-REC AFTER ADVANCING NEW-PAGE
               MOVE 2          TO KEY-HIT
               MOVE "Y"        TO ALL-RECORDS-WRITTEN-SW
           ELSE
           MOVE SPACES         TO PRINT-REC
      *    WRITE PRINT-REC     AFTER ADVANCING NEW-PAGE
           MOVE 2              TO KEY-HIT
           MOVE "Y"            TO ALL-RECORDS-WRITTEN-SW.

       6323-IKF-EXIT.          EXIT.

       631-SETUP.
           MOVE ZONE-BUF       TO MZ-1-H.
           MOVE 1              TO ACT-KEY.
           MOVE 0              TO EOF-SW.
           READ OUT-FILE       INVALID KEY
      **********************************************************************
      **    MESSAGE 040/067:
      **  NO W/O'S MEET THE REQS--PRESS 'F2' TO REQUEST AGAIN, 'F3' TO END JOB
      **********************************************************************
               MOVE 40         TO CATREAD-MSG-SET
               MOVE 67         TO CATREAD-MSG-NUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE TRUE-VAL   TO IND(1) IND(99)
               MOVE 2          TO KEY-HIT
               GO TO 2-EOJ.

           IF ZONE-BUF = SPACES
               MOVE Z-OUT      TO ZONE-HOLD MZ-1-H.

           PERFORM 6320-HEADINGS.
           MOVE P-OUT          TO PRIORITY-TAG P-SAVE.
           IF ZONE-BUF NOT = SPACES
               PERFORM 6321-PRTY-LITERAL.

       631-EXIT.               EXIT.

       6322-WRITE-FIELDS.
           ADD 1               TO FIELD-CTR.
           IF FIELD-CTR = 5
               MOVE FIELD-HOLD TO FIELD-5
           ELSE
           IF FIELD-CTR = 6
               MOVE FIELD-HOLD TO FIELD-6
           ELSE
           IF FIELD-CTR = 7
               MOVE FIELD-HOLD TO FIELD-7
           ELSE
           IF FIELD-CTR = 8
               MOVE FIELD-HOLD TO FIELD-8
           ELSE
           IF FIELD-CTR = 9
               MOVE FIELD-HOLD TO FIELD-9
           ELSE
           IF FIELD-CTR = 10
               MOVE FIELD-HOLD TO FIELD-10
           ELSE
           IF FIELD-CTR = 11
               MOVE FIELD-HOLD TO FIELD-11
           ELSE
           IF FIELD-CTR = 12
               MOVE FIELD-HOLD TO FIELD-12
           ELSE
           IF FIELD-CTR = 13
               MOVE FIELD-HOLD TO FIELD-13
           ELSE
           IF FIELD-CTR = 14
               MOVE FIELD-HOLD TO FIELD-14
           ELSE
           IF FIELD-CTR = 15
               MOVE FIELD-HOLD TO FIELD-15
           ELSE
           IF FIELD-CTR = 16
               MOVE FIELD-HOLD TO FIELD-16
           ELSE
           IF FIELD-CTR = 17
               MOVE FIELD-HOLD TO FIELD-17
           ELSE
           IF FIELD-CTR = 18
               MOVE FIELD-HOLD TO FIELD-18
           ELSE
           IF FIELD-CTR = 19
               MOVE FIELD-HOLD TO FIELD-19
           ELSE
           IF FIELD-CTR = 20
               MOVE FIELD-HOLD TO FIELD-20
           ELSE
           IF FIELD-CTR = 21
               MOVE FIELD-HOLD TO FIELD-21
           ELSE
           IF FIELD-CTR = 22
               MOVE FIELD-HOLD TO FIELD-22
           ELSE
           IF FIELD-CTR = 23
               MOVE FIELD-HOLD TO FIELD-23.

       6322-PRINT-FUNCTION.
           MOVE HOLD-BUFFER    TO PRINT-REC.
           WRITE PRINT-REC     AFTER ADVANCING ADV-CTR.

       69-START-WO-ZONE-PRTY-MSTR.
           MOVE ZONE-BUF       TO Z-ARG-4.
           MOVE ZONE-ARGUMENT  TO ZONEPRTY OF WZPMFREC.
           START WO-ZONE-PRTY  KEY = EXTERNALLY-DESCRIBED-KEY
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.

       COPY OVRPFCALL          OF COPYLIB.

       999-CATREAD.
           MOVE SPACES         TO ERROR-BUFFER.
           CALL "CCATREAD"     USING CATREAD-PARMS.
           MOVE CATREAD-MSG-TEXT TO ERROR-BUFFER.

       999-CATREAD-EXIT.       EXIT.

       7-SORT-INPUT-RECORDS.
           PERFORM 7-SORT-MAIN THRU 7-SORT-M-EXIT.

       7-SORT-MAIN.
           MOVE SPACES         TO SORT-REC.
           MOVE 1              TO FILE-SW.
           MOVE WOSTAT-BUF     TO WOSTATUS OF WO-BASIC.
           START WO-BASIC      KEY IS = EXTERNALLY-DESCRIBED-KEY
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
               GO TO 7-SORT-M-EXIT.

           PERFORM 70-SORT-DBGET THRU 70-SORT-DBGET-EXIT.

       7-SORT-M-CONT.
           MOVE 2              TO FILE-SW.
           MOVE WOSTAT-BUF     TO WOSTATUS OF WPFREC.
           START WO-PLANNED    KEY IS = EXTERNALLY-DESCRIBED-KEY
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
               GO TO 7-SORT-M-EXIT.
           PERFORM 70-SORT-DBGET THRU 70-SORT-DBGET-EXIT.

       7-SORT-M-EXIT.          EXIT.

       70-SORT-DBGET.
           MOVE SPACES         TO SORT-REC.
           IF BASIC-FILE
               READ WO-BASIC   NEXT INTO WO-BASIC-DATA
                   AT END      MOVE FILE-STAT TO FILE-STAT
               END-READ
               IF FILE-STAT  NOT = "00"
                   GO TO 70-SORT-DBGET-EXIT
               ELSE
               IF WOSTAT-BUF NOT = WO-STATUS
                   GO TO 70-SORT-DBGET-EXIT
               END-IF
           ELSE
               READ WO-PLANNED NEXT INTO WO-PLANNED-DATA
                   AT END      MOVE FILE-STAT TO FILE-STAT
               END-READ
               IF FILE-STAT NOT = "00"
                   GO TO 70-SORT-DBGET-EXIT
               ELSE
               IF WOSTAT-BUF NOT = WO-STATUS-P
                   GO TO 70-SORT-DBGET-EXIT
               END-IF
               MOVE SPACES          TO WO-BASIC-DATA
               MOVE WO-NUM-PLANNED  TO WO-NUM
               MOVE WO-STATUS-P     TO WO-STATUS
               MOVE DATE-RECD-P     TO DATE-RECD
               MOVE TIME-RECD-P     TO TIME-RECD
               MOVE APPROVAL-CODE-P TO APPROVAL-CODE
               MOVE REQUESTER-P     TO REQUESTER-B
               MOVE EQUIP-NUM-P     TO EQUIP-NUM
               MOVE EQUIP-NAME-P    TO EQUIP-NAME
               MOVE TYPE-NUM-P      TO TYPE-NUM
               MOVE DEPT-P          TO DEPT
               MOVE ZONE-PRIORITY-P TO ZONE-PRIORITY
               MOVE LOCATION-P      TO LOCATION
               MOVE EQUIP-DOWN-P    TO EQUIP-DOWN
               MOVE EXP-CLASS-P     TO EXP-CLASS
               MOVE DESCRIPTION-1-P TO DESCRIPTION-1
               MOVE DATE-STRT-P     TO DATE-STRT
               MOVE TIME-STRT-P     TO TIME-STRT
               MOVE DATE-COMP-P     TO DATE-COMP
               MOVE TIME-COMP-P     TO TIME-COMP
               MOVE "*"             TO VP-FLAG-SORT.

           MOVE ZONE-PRIORITY  TO SORT-ZONE.
           IF Z-BUF-1 = "A" AND Z-BUF-2 = " "
               MOVE "A1  "     TO ZONE-BUF1
               MOVE "A2  "     TO ZONE-BUF2
               MOVE "A3  "     TO ZONE-BUF3
           ELSE
           IF Z-BUF-1 = "A" AND Z-BUF-2 = "A"
               MOVE "A1  "     TO ZONE-BUF1
               MOVE "A2  "     TO ZONE-BUF2
           ELSE
           IF Z-BUF-1 = "B" AND Z-BUF-2 = " "
               MOVE "B1  "     TO ZONE-BUF1
               MOVE "B2  "     TO ZONE-BUF2
               MOVE "B3  "     TO ZONE-BUF3
           ELSE
           IF Z-BUF-1 = "B" AND Z-BUF-2 = "B"
               MOVE "B1  "     TO ZONE-BUF1
               MOVE "B2  "     TO ZONE-BUF2
           ELSE
           IF Z-BUF-1 = "B" AND Z-BUF-2 = "D"
               MOVE "B2  "     TO ZONE-BUF1
               MOVE "B3  "     TO ZONE-BUF2
           ELSE
           IF Z-BUF-1 = "B" AND Z-BUF-2 = "C"
               MOVE "B3  "     TO ZONE-BUF1
               MOVE "C1  "     TO ZONE-BUF2
               MOVE "C2  "     TO ZONE-BUF3
           ELSE
           IF Z-BUF-1 = "C" AND Z-BUF-2 = " "
               MOVE "C1  "     TO ZONE-BUF1
               MOVE "C2  "     TO ZONE-BUF2
           ELSE
           IF ZONE-BUF = "Z1  "
               MOVE "Z1  "     TO ZONE-BUF1
               MOVE "Z1A "     TO ZONE-BUF2
           ELSE
           MOVE ZONE-BUF       TO ZONE-BUF1.

           IF ZONE-BUF1 = SPACES
               MOVE SORT-Z     TO ZONE-BUF1.

           MOVE WO-STATUS      TO SORT-WOSTAT.
           MOVE WO-NUM         TO SORT-WONUM.
           MOVE DESCRIPTION-1  TO SORT-WODESC.
           MOVE EQUIP-NUM      TO SORT-EQNUM.
           MOVE EQUIP-DOWN     TO SORT-EQDOWN.
           MOVE CRAFTS-REQD-1  TO SORT-C1.
           MOVE CRAFTS-REQD-2  TO SORT-C2.
           MOVE CRAFTS-REQD-3  TO SORT-C3.
           MOVE TIME-STRT      TO TSTRT-SORT.
           MOVE SPACES         TO SORT-DATE-RCVD.
           MOVE TIME-STRT      TO SORT-TIME-RCVD.

           IF CRAFTSMEN-2 = SPACES
               MOVE CRAFTSMEN-1 TO CMAN-1-SORT
           ELSE
           IF CRAFTSMEN-3 = SPACES
               MOVE CRAFTSMEN-2 TO CMAN-1-SORT
           ELSE
           MOVE CRAFTSMEN-3    TO CMAN-1-SORT.

           IF PRIORITY-BUF = "A" OR SORT-P
               IF SORT-Z = ZONE-BUF OR ZONE-BUF1 OR ZONE-BUF2 OR
                               ZONE-BUF3 OR SPACES
                   PERFORM 70-SORT-RELEASE-REC THRU 70-SORT-RR-EXIT
                   IF SORT-P = 1
                       ADD 1   TO PRTY1-K
                   ELSE
                   IF SORT-P = 2
                       ADD 1   TO PRTY2-K
                   ELSE
                   IF SORT-P = 3
                       ADD 1   TO PRTY3-K
                   ELSE
                   IF SORT-P = 4
                       ADD 1   TO PRTY4-K
                   ELSE
                   IF SORT-P = 5
                       ADD 1   TO PRTY5-K.

           GO TO 70-SORT-DBGET.

       70-SORT-DBGET-EXIT.     EXIT.

       70-SORT-RELEASE-REC.
           MOVE WO-NUM         TO ARG-DEFN.
           MOVE SPACES         TO CMAN-1-SORT.
           MOVE ARG-DEFN       TO WONUM OF LCSFREC.
           START LABOR-CUR-STAT KEY IS = EXTERNALLY-DESCRIBED-KEY
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
               MOVE SPACES     TO CMAN-1-SORT
               MOVE SPACES     TO TSTRT-SORT SORT-C1
               RELEASE         SORT-REC
           ELSE
           PERFORM 70-IP-DBGET THRU 70-IP-DBG-EXIT.

       70-SORT-RR-EXIT.        EXIT.

       70-IP-DBGET.
           READ LABOR-CUR-STAT NEXT INTO LABOR-CURR-STAT
               AT END          MOVE FILE-STAT TO FILE-STAT.
           IF ARG-DEFN NOT = WONUM OF LCSFREC
               GO TO 70-IP-DBG-EXIT.
           IF FILE-STAT NOT = "00"
               IF CMAN-1-SORT = SPACES
                   MOVE SPACES TO TSTRT-SORT SORT-C1
                   RELEASE     SORT-REC
                   GO TO 70-IP-DBG-EXIT
               ELSE
               GO TO 70-IP-DBG-EXIT.

           MOVE LCS-EMPL-NUM   TO CMAN-1-SORT.
           MOVE LCS-START-TIME TO TSTRT-SORT.
           PERFORM 70-IP-GET-CRAFT THRU 70-IP-GET-CRAFT-EXIT.
           RELEASE             SORT-REC.

           GO TO 70-IP-DBGET.

       70-IP-DBG-EXIT.         EXIT.

       70-IP-GET-CRAFT.
           MOVE LCS-EMPL-NUM   TO PERCCNUM OF PFREC.
           START PER-PERSONNEL KEY IS = EXTERNALLY-DESCRIBED-KEY
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
               GO TO 70-IP-GET-CRAFT-EXIT.

           READ PER-PERSONNEL  NEXT INTO PER-PERSONNEL-DATA
               AT END          MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
               GO TO 70-IP-GET-CRAFT-EXIT.
           MOVE PER-CRAFT      TO SORT-C1.

       70-IP-GET-CRAFT-EXIT.   EXIT.

       8-WRITE-FILE.
           MOVE 0              TO ACT-KEY.
           OPEN OUTPUT         OUT-FILE.
           PERFORM 8-WF-CONT   THRU 8-WF-EXIT.

       8-WF-CONT.
           RETURN SORT-FILE    AT END GO TO 8-WF-EXIT.
           ADD 1               TO ACT-KEY.
           MOVE SORT-REC       TO OUT-DATA.
           WRITE OUT-REC       INVALID KEY GO TO 8-WF-EXIT.
           GO TO 8-WF-CONT.

       8-WF-EXIT.              EXIT.

