024000
024100 PROCEDURE DIVISION.
024200
024300 PROC-DIV SECTION 01.
024400
024500 BEGIN-HERE.
           MOVE "N" TO EOJ-SW.
           MOVE ZERO TO SUB.
024600     PERFORM 1-HSK THRU 1-H-X.
024700     IF FATAL-ERR-SW = "N"
024800         PERFORM 6-MAIN THRU 6-M-X.
024900     IF FATAL-ERR-SW = "Y"
025000         GO TO 2100-BLOWUP
025100     ELSE
025200         PERFORM 2-EOJ  THRU 2-EOJ-X
025300         IF FATAL-ERR-SW  =  "Y"
025400             GO TO 2100-BLOWUP.
025500     GOBACK.
025600
025700 1-HSK.
025800     MOVE "TRQPUPDT"  TO  BU-PGM-NAME.
025900     MOVE ZEROS  TO  COND-WORD.
026000     MOVE ZEROS  TO  VIEW-STATUS.
           PERFORM 9910-OPEN-STUFF.

030300**************************************************
030400*                                                *
030500*   GET CO. AND PRIME FROM MPLTINFO              *
030600*   USING 'P 01' AS THE ARGUMENT                 *
030700*                                                *
030800**************************************************
030900
031000     MOVE "P 01"  TO  PLT-ARG.
           PERFORM 9999-DBGET7-MPLTINFO-PK-I.
031800     MOVE MPLTINFO-COMPANY   TO  COMPANY-SAVE, COMP-SCREEN-INDIC.
033200
033300 1-H-X.
033400     EXIT.
033500
033600 2-EOJ.
           PERFORM 9920-CLOSE-STUFF.
036700 2-EOJ-X.
036800     EXIT.
036900
037000
037100*********************************************
037200*                                           *
037300*  BLOWUP ROUTINE EXECUTES WHENEVER A       *
037400*  FATAL ERROR OCCURS                       *
037500*                                           *
037600*********************************************
037700
037800 2100-BLOWUP.
037900     CALL "TBLOWUP" USING BASE, BU-PGM-NAME, STATUS-AREA,
038000         VIEW-COMAREA, FILE-STATUS, BU-DISPLAY-MSG,
038100                 BU-DISPLAY-FLDS.
038200
038300 2100-BLOWUP-X.
038400     EXIT.
038500
038600
045900**************************************************
046000*                                                *
046100*     6 - M A I N                                *
046200*                                                *
046300**************************************************
046400
046500
046600 6-MAIN.
046700     PERFORM 61-WRITE-FIRST-SCREEN  THRU  61-WFS-X.
046800     IF EOJ-SW  =  "Y"
046900         GO TO 6-M-X.
047000     IF FATAL-ERR-SW  =  "Y"
047100         GO TO 6-M-X.
047200     IF PROCESS-REQ-OPTION
047300         PERFORM 62-PROCESS-REQ-UPDATE  THRU  62-PRU-X
047400     ELSE
047500     IF PROCESS-WO-OPTION
047600         PERFORM 63-PROCESS-WO-RETURN  THRU  6390-PWR-X.
047700
047800     GO TO 6-MAIN.
047900
048000 6-M-X.
048100     EXIT.
048200
048300
048400
048500 61-WRITE-FIRST-SCREEN.
048600     MOVE "FRQPUPDT1"  TO  VIEW-NFNAME.
           PERFORM 9951-GETNEXTFORM.
049200
049300 61-CLEAR-SCREEN-1.
049400     MOVE SPACES  TO  SCREEN-1.
049500     MOVE COMP-SCREEN-INDIC  TO  DISP-SCREEN1-COMP.
           PERFORM 9953-PUTBUFFER.
           PERFORM 9956-PUTWINDOW.
051200
       61-SHOWFORM-SCREEN-1.
           MOVE "I" TO SRF-FKEY (1), SRF-FKEY (2),
             SRF-FKEY (4), SRF-FKEY (6), SRF-FKEY (7),
             SRF-FKEY (8).
           MOVE SCREEN-1 TO DISPLAY-REC.
           PERFORM 998-WRITE-SCREEN THRU 9989-WS-X.
           MOVE DISPLAY-REC TO SCREEN-1.
           IF MESSAGE-BUFFER-1 NOT = SPACES
               PERFORM 9954-SETERROR
               GO TO 61-SHOWFORM-SCREEN-1.

052800     IF VIEW-LASTKEY = 3
052900         MOVE "Y"  TO  EOJ-SW
053000         GO TO 61-WFS-X.

           PERFORM 9952-GETBUFFER.
057900
058000
058100 61-EDIT-REQ-NO.
           IF DE-REQ-NUM = SPACES AND DE-WO-NUM = SPACES
      *        "* YOU MUST ENTER REQUISITION OR WO *"
               MOVE 66 TO LANG-SETNUM
               MOVE 278 TO LANG-MSGNUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE 1 TO FIELD-NUMBER
               PERFORM 9954-SETERROR
               GO TO 61-SHOWFORM-SCREEN-1.

           IF DE-REQ-NUM = SPACES AND DE-BUYER-CODE > SPACES
      *        "* YOU MUST ENTER THE REQUISITION TO ASSIGN A BUYER CD "
               MOVE 66 TO LANG-SETNUM
               MOVE 279 TO LANG-MSGNUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE 1 TO FIELD-NUMBER
               PERFORM 9954-SETERROR
               GO TO 61-SHOWFORM-SCREEN-1.

058200     IF DE-REQ-NUM = SPACES
058300         GO TO 61-EDIT-WO-NO.
058400     MOVE DE-REQ-NUM  TO  REQ-ARG.
           PERFORM 9999-DBGET7-MREQ-RQ-I.
058700     IF COND-WORD  NOT = 0
058800         IF COND-WORD  =  17
058900*            "* REQUISITION DOES NOT EXIST *"
059000             MOVE  18 TO LANG-SETNUM
059100             MOVE   5 TO LANG-MSGNUM
059200             PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
059300             MOVE 2  TO  FIELD-NUMBER
059400             PERFORM 9954-SETERROR
059500             GO TO 61-SHOWFORM-SCREEN-1
059600         ELSE
059700             MOVE "DBGET MREQ 61-EDIT-REQ-NO" TO BU-DISPLAY-MSG
059800             MOVE REQ-ARG  TO  BU-DISPLAY-FLD (1)
059900             MOVE "Y"  TO  FATAL-ERR-SW
060000             GO TO 61-WFS-X.
060100
060200 61-CHECK-BUYER-CODE.
060300     IF DE-BUYER-CODE = SPACES
060400         GO TO 61-CHECK-WHICH-OPTION.
060500     MOVE DE-BUYER-CODE  TO  BUYER-ARG.
           PERFORM 9999-DBGET7-MBUYER-BY-I.
060800     IF COND-WORD NOT = 0
060900         IF COND-WORD  =  17
061000*            "* BUYER DOES NOT EXIST *"
061100             MOVE   2 TO LANG-SETNUM
061200             MOVE   4 TO LANG-MSGNUM
061300             PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
061400             MOVE 3  TO  FIELD-NUMBER
061500             PERFORM 9954-SETERROR
061600             GO TO 61-SHOWFORM-SCREEN-1
061700         ELSE
061800             MOVE "61-CHECK-BUYER-CODE"  TO BU-DISPLAY-MSG
061900             MOVE BUYER-ARG             TO BU-DISPLAY-FLD (1)
062000             MOVE "Y" TO FATAL-ERR-SW
062100             GO TO 61-WFS-X.
062200
062300 61-PROCESS-BUYER-CODE.
062400     IF REQ-MATCONT-RELEASE = " "
062500*        "* CANNOT ASSIGN BUYER CODE REQ NOT RELEASED *"
062600         MOVE   3 TO LANG-SETNUM
062700         MOVE 133 TO LANG-MSGNUM
062800         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
062900         MOVE 3  TO  FIELD-NUMBER
063000         PERFORM 9954-SETERROR
063100         GO TO 61-SHOWFORM-SCREEN-1
063200     ELSE
063300         PERFORM 611-UPDATE-BUYER-CODE THRU 611-UBC-X.
063400
063500     IF DE-BUYER-CODE-ONLY = "X"
063600         GO TO 61-CLEAR-SCREEN-1
063700     ELSE
063800         GO TO 61-CHECK-WHICH-OPTION.
063900
064000 61-EDIT-WO-NO.
064100
064200     MOVE DE-WO-NUM TO WO-ARG.
064300     CALL "TALWONO" USING WO-ARG, ALWO-RET-CODE.
           PERFORM 9999-DBFIND-DREQD-WO-I.
064600     IF COND-WORD = 17 OR CHAIN-LENGTH = 0
064700         MOVE 5 TO FIELD-NUMBER
064800*        "T18:  THERE ARE NO REQS FOR THIS WO, OR WO DOESNT EXIST"
064900         MOVE  20 TO LANG-SETNUM
065000         MOVE  18 TO LANG-MSGNUM
065100         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
065200         PERFORM 9954-SETERROR
065300         GO TO 61-SHOWFORM-SCREEN-1
065400     ELSE
065500     IF COND-WORD NOT = 0
065600         MOVE "DBFIND ERR 61-EWN"  TO  BU-DISPLAY-MSG
065700         PERFORM 2100-BLOWUP.
065800
065900     MOVE FRWD-ADDR TO SAVE-FRWD-ADDR.
066000     MOVE BKWD-ADDR TO SAVE-BKWD-ADDR.
066100
066200 61-CHECK-WHICH-OPTION.
066300     IF DE-REQ-NUM NOT = SPACES
066400         MOVE "R"  TO  PROCESS-OPTION-SW
066500     ELSE
066600     IF DE-WO-NUM NOT = SPACES
066700         MOVE "W"  TO  PROCESS-OPTION-SW.
066800
066900 61-WFS-X.
067000     EXIT.
067100
067200 611-UPDATE-BUYER-CODE.
067300     MOVE 1                 TO  NUMBER-OF-DSETS-LOCKED.
067400     MOVE DE-REQ-NUM        TO  LOCK-VALUE-1.
067500     MOVE "DREQD;"          TO  DSET-NAME-1.
067600     MOVE "REQ-NUMBER;"     TO  ITEM-LIST-1.
           PERFORM 9930-LOCK.
068300
068400 611-GET-AND-UPDATE-DREQD.
           PERFORM 9999-DBFIND-DREQD-RQ-O.
069200
           PERFORM 9999-DBGET5-DREQD-RQ-O.
070000
           PERFORM 9999-DBDELETE-DREQD-RQ-O.

070800     MOVE DE-BUYER-CODE  TO  DREQD-BUYER-CODE.
           PERFORM 9999-DBPUT-DREQD-RQ-O.
071600
071700 611-UNLOCK-DREQD.
           PERFORM 9940-UNLOCK.
072400
072500 611-UBC-X.
072600     EXIT.
072700
072800
072900 62-PROCESS-REQ-UPDATE.
073000     IF REQ-MAT-TYPE = "S"
073100         CALL "SRQPUPDC" USING BASE,
073200                               FILENUMBER,
073300                               COMPANY-SAVE,
073400                               REQ-ARG,
073500                               VIEW-COMAREA,
073600                               SCREEN-PRINT-PARMS,
073700                               PASSED-SPOOL-PRT,
073800                               LANGUAGE-PARMS
073810                               FORMFILE,
073820                               FORMFILE-FCSISINQ.
073900
074000     IF REQ-MAT-TYPE = "N"
074100         CALL "SRQPUPDN" USING BASE,
074200                               COMPANY-SAVE,
074300                               REQ-ARG,
074400                               VIEW-COMAREA,
074500                               PASSED-SPOOL-PRT,
074600                               LANGUAGE-PARMS,
074700                               BUF-MREQ,
074810                               FORMFILE,
074820                               FORMFILE-FCSISINQ.
074900
075000 62-PRU-X.
075100     EXIT.
075200
075300
075400 63-PROCESS-WO-RETURN.
075500
075600 6310-PROCESS-WO-LOOP.
075700*************************************************************
075800** THIS PARAGRAPH CONTINUES THE LOOP FOR INQUIRIES BY
075900** WORK ORDER NUMBER.
076000*************************************************************
076100
076200     IF SAVE-FRWD-ADDR = 0
076300         GO TO 6390-PWR-X.
076400
076500*---------- SINCE SUBPROGRAMS WE CALL IN THIS LOOP DO A DBFIND
076600*---------- ON "DREQD" ON A DIFFERENT PATH, WE HAVE TO DO
076700*---------- ANOTHER DBFIND FOR EACH DBGET TO ESTABLISH THE
076800*---------- CORRECT PATH. NOTE: ON IBM WE DON'T NEED TO DO THIS
           PERFORM 9999-RE-DBFIND-DREQD-WO-I.
077400
077500     MOVE SAVE-FRWD-ADDR           TO  DIRECTED-ADDR.
           PERFORM 9999-DBGET5-DREQD-WO-I.
078600     MOVE FRWD-ADDR                TO  SAVE-FRWD-ADDR.
           IF NOT GOOD-CALL
               GO TO 6390-PWR-X.
078800
078900     MOVE DREQD-REQ-NUMBER         TO  REQ-ARG.
           PERFORM 9999-DBGET7-MREQ-RQ-I.
079500
079600     PERFORM 62-PROCESS-REQ-UPDATE.
079700     IF VIEW-LASTKEY = 3
079800         GO TO 6390-PWR-X.
079900
080000
080100     GO TO 6310-PROCESS-WO-LOOP.
080200
080300 6390-PWR-X.
080400     EXIT.
080500
       9910-OPEN-STUFF.
           OPEN I-O DISPLAY-FILE, DREQD-RQ-O.
           OPEN INPUT MPLTINFO-PK-I, MREQ-RQ-I, MBUYER-BY-I,
             DREQD-WO-I.

       9920-CLOSE-STUFF.
           CLOSE DISPLAY-FILE, DREQD-RQ-O, MPLTINFO-PK-I,
             MREQ-RQ-I, MBUYER-BY-I, DREQD-WO-I.

       9930-LOCK.
      *------ DUMMY PARAGRAPH FOR IBM
       9940-UNLOCK.
       9951-GETNEXTFORM.
       9952-GETBUFFER.
       9953-PUTBUFFER.
       9954-SETERROR.
           MOVE B"1" TO IND (99).
           MOVE B"1" TO IND (FIELD-NUMBER).
           MOVE MESSAGE-BUFFER TO DE-MESSAGE-LINE.
       9955-CLEAR-FORM.
       9956-PUTWINDOW.
       9957-FIELDEDITS.
       9958-INITFORM.

       9999-DBGET7-MPLTINFO-PK-I.
           MOVE 0 TO COND-WORD.
           MOVE PLT-ARG TO PLTINFOKEY OF MPLTINFO-PK-REC-I.
           READ MPLTINFO-PK-I INTO BUF-MPLTINFO
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS = "23"
               MOVE 17 TO COND-WORD
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE "DBGET7 ERR 9999-DBGET7-MPLTINFO-PK-I"
                   TO BU-DISPLAY-MSG
               MOVE 99 TO COND-WORD.

       9999-DBGET7-MREQ-RQ-I.
           MOVE 0 TO COND-WORD.
           MOVE REQ-ARG TO REQNO OF MREQ-RQ-REC-I.
           READ MREQ-RQ-I INTO BUF-MREQ
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS = "23"
               MOVE 17 TO COND-WORD
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE "DBGET7 ERR 9999-DBGET7-MREQ-RQ-I"
                   TO BU-DISPLAY-MSG
               MOVE 99 TO COND-WORD.

       9999-DBGET7-MBUYER-BY-I.
           MOVE 0 TO COND-WORD.
           MOVE BUYER-ARG TO BUYERCDE OF MBUYER-BY-REC-I.
           READ MBUYER-BY-I INTO BUF-MBUYER
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS = "23"
               MOVE 17 TO COND-WORD
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE "DBGET7 ERR 9999-DBGET7-MBUYER-BY-I"
                   TO BU-DISPLAY-MSG
               MOVE 99 TO COND-WORD.

       9999-DBFIND-DREQD-WO-I.
           MOVE 0 TO COND-WORD.
           MOVE WO-ARG TO WONO OF DREQD-WO-REC-I.
           START DREQD-WO-I KEY = WONO OF DREQD-WO-REC-I
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF (FILE-STATUS NOT = "00") AND (FILE-STATUS-1 NOT = "2")
               MOVE "DBFIND ERR 9999-DBFIND-DREQD-WO-I"
                   TO BU-DISPLAY-MSG
               MOVE 99 TO COND-WORD.

       9999-RE-DBFIND-DREQD-WO-I.
      *------ FOR IBM, WE DON'T NEED TO DO THIS CAUSE THE SUBPROGRAMS
      *------ DON'T LOSE THE FILE POINTER.

       9999-DBGET5-DREQD-WO-I.
           MOVE 0 TO COND-WORD.
           READ DREQD-WO-I NEXT INTO BUF-DREQD
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   MOVE 15 TO COND-WORD
               ELSE
                   MOVE "DBGET5 ERR 9999-DBGET5-DREQD-WO-I"
                       TO BU-DISPLAY-MSG
                   MOVE 99 TO COND-WORD
           ELSE
           IF WONO OF DREQD-WO-REC-I NOT = WO-ARG
               MOVE 15 TO COND-WORD.

       9999-DBFIND-DREQD-RQ-O.
           MOVE 0 TO COND-WORD.
           MOVE REQ-ARG TO REQNO OF DREQD-RQ-REC-O.
           START DREQD-RQ-O KEY = REQNO OF DREQD-RQ-REC-O
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF (FILE-STATUS NOT = "00") AND (FILE-STATUS-1 NOT = "2")
               MOVE "DBFIND ERR 9999-DBFIND-DREQD-RQ-O"
                   TO BU-DISPLAY-MSG
               MOVE 99 TO COND-WORD.

       9999-DBGET5-DREQD-RQ-O.
           MOVE 0 TO COND-WORD.
           READ DREQD-RQ-O NEXT INTO BUF-DREQD
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   MOVE 15 TO COND-WORD
               ELSE
                   MOVE "DBGET5 ERR 9999-DBGET5-DREQD-RQ-O"
                       TO BU-DISPLAY-MSG
                   MOVE 99 TO COND-WORD
           ELSE
           IF REQNO OF DREQD-RQ-REC-O NOT = REQ-ARG
               MOVE HIGH-VALUES TO REQNO OF DREQD-RQ-REC-O
               START DREQD-RQ-O
                 KEY > REQNO OF DREQD-RQ-REC-O
                 INVALID KEY MOVE "00" TO FILE-STATUS
               END-START
               MOVE 15 TO COND-WORD.

       9999-DBDELETE-DREQD-RQ-O.
           MOVE 0 TO COND-WORD.
           DELETE DREQD-RQ-O
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE "DBDELETE ERR 9999-DBDELETE-DREQD-RQ-O"
                   TO BU-DISPLAY-MSG
               MOVE 99 TO COND-WORD.

       9999-DBPUT-DREQD-RQ-O.
           MOVE 0 TO COND-WORD.
           WRITE DREQD-RQ-REC-O FROM BUF-DREQD
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE "DBPUT ERR 9999-DBPUT-DREQD-RQ-O"
                   TO BU-DISPLAY-MSG
               MOVE 99 TO COND-WORD.

       COPY DISPCALL IN COPYLIB.
       COPY DISPCAL2 IN COPYLIB.
080600 999-CATREAD.
           IF CATREAD-MSG-NUMBER = ZEROS
               MOVE LANG-SETNUM TO CATREAD-MSG-SET
               MOVE LANG-MSGNUM TO CATREAD-MSG-NUM.
           CALL "CCATREAD" USING CATREAD-PARMS.
           MOVE CATREAD-MSG-TEXT TO MESSAGE-BUFFER.
082200 999-CATREAD-EXIT.
082300     EXIT.
