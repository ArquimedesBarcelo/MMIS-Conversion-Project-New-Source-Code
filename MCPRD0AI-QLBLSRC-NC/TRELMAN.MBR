027500 PROCEDURE DIVISION.
027600
027700 PROC-DIV SECTION 01.
027800
027900 BEGIN-HERE.
028000     PERFORM 1-HSK THRU 1-H-X.
028100
028200     PERFORM 6-MAIN THRU 6-M-X.
028300
028400     PERFORM 2-EOJ  THRU 2-EOJ-X.
028500
028600     GOBACK.
028700
028800 1-HSK.
           OPEN INPUT MPLTINFO-I, DPORECD-I, MREQ-I, DREQITM-I,
                      MSTORERM-I, DPOITEMP-I, DPOITEMC-I.
           OPEN I-O DISPLAY-FILE.

029000     CALL "TESCSEQ" USING ESC-NAME.
029100
033200**************************************************
033300*                                                *
033400*   GET CO. AND PRIME FROM MPLTINFO              *
033500*   USING 'P 01' AS THE ARGUMENT                 *
033600*                                                *
033700**************************************************
033800
033900     MOVE "P 01"  TO  PLT-ARG.
           MOVE PLT-ARG TO PLTINFOKEY OF MPLTINFO-REC-I.
           READ MPLTINFO-I INTO BUF-MPLTINFO
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
034300         MOVE "DBGET MPLTINFO 1-HSK P 01"  TO  BU-DISPLAY-MSG
034400         MOVE PLT-ARG               TO  BU-DISPLAY-FLD (1)
034500         GO TO 2-BLOWUP.
034600     MOVE MPLTINFO-COMPANY           TO  COMP-SCREEN-INDIC.
034700
034800********************************************
034900*
035000*   GET SHIPPING RELEASE PRINTER NUMBER
035100*
035200********************************************
035300
035400     MOVE 9                       TO  SAVE-PO-PRT-NUM.
035500     MOVE "POPT"                  TO  PLT-ARG.
           MOVE PLT-ARG TO PLTINFOKEY OF MPLTINFO-REC-I.
           READ MPLTINFO-I INTO BUF-MPLTINFO
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS-1 = "2"
               NEXT SENTENCE
           ELSE
           IF FILE-STATUS NOT = "00"
036200         MOVE "GET MPLTINFO 'POPT'*1HSK" TO BU-DISPLAY-MSG
036300         MOVE PLT-ARG  TO  BU-DISPLAY-FLD (1)
036400         GO TO 2-BLOWUP
036500     ELSE
               IF MPLTINFO-SHIP-REL-PRT-NO NOT = SPACES
036600             MOVE MPLTINFO-SHIP-REL-PRT-NO TO SAVE-PO-PRT-NUM
               ELSE
      *------------- UPDATE SHIP REL PRINTER IF NOT DEFINED
                   MOVE MPLTINFO-PO-PRT-NO TO SAVE-PO-PRT-NUM
                                              MPLTINFO-SHIP-REL-PRT-NO
                   OPEN I-O MPLTINFO
035500             MOVE "POPT"                  TO  PLT-ARG
                   MOVE PLT-ARG TO PLTINFOKEY OF MPLTINFO-REC
                   READ MPLTINFO
                       INVALID KEY MOVE FILE-STATUS TO FILE-STATUS
                   END-READ
                   REWRITE MPLTINFO-REC FROM BUF-MPLTINFO
                       INVALID KEY MOVE FILE-STATUS TO FILE-STATUS
                   END-REWRITE
                   CLOSE MPLTINFO
               END-IF
036700         MOVE MPLTINFO-ADDTL-DATA-EDIT-SW
036800                                  TO  EDIT-ADDTL-DATA-SW.
036900
037200     ACCEPT CUR-YMD FROM DATE.
      *-------- ACCOUNT FOR CENTURY
           IF CUR-YY > "70"
               MOVE "19"                TO  CUR-CC
           ELSE
               MOVE "20"                TO  CUR-CC.

      *------ GET DATE WANTED SWITCH FOR SCALCEDT.

           MOVE "PREQ"  TO  PLT-ARG.
           MOVE PLT-ARG TO PLTINFOKEY OF MPLTINFO-REC-I.
           READ MPLTINFO-I INTO BUF-MPLTINFO
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE "DBGET MPLTINFO 1-HSK PREQ"  TO  BU-DISPLAY-MSG
               MOVE PLT-ARG               TO  BU-DISPLAY-FLD (1)
               GO TO 2-BLOWUP.
           MOVE MPLTINFO-DATE-WANT-SW     TO  CALC-DATE-WANTED-SW.

037300 1-H-X.
037400     EXIT.
037500
037600 2-EOJ.
           CLOSE MPLTINFO-I, DPORECD-I, MREQ-I, DREQITM-I,
                 MSTORERM-I, DPOITEMP-I, DPOITEMC-I, DISPLAY-FILE.
040500
040600 2-EOJ-X.
040700      EXIT.
040800
040900******************************************************
041000**                                                  **
041100**   BLOWUP ROUTINE                                 **
041200**                                                  **
041300******************************************************
041400
041500 2-BLOWUP.
041600     MOVE "TRELMAN"               TO  BU-PGM-NAME.
041700     CALL "TBLOWUP" USING BASE, BU-PGM-NAME, STATUS-AREA,
041800         VIEW-COMAREA, FILE-STATUS, BU-DISPLAY-MSG,
041900             BU-DISPLAY-FLDS.
042000
042100 2-BLOWUP-X.
042200     EXIT.
045300
045400 4-PGM-ERROR.
           MOVE B"1"  TO IND (FIELD-NUMBER), IND (99).
           MOVE MESSAGE-BUFFER TO DE-MESSAGE-LINE.
046200
046300 4-PGM-ERROR-X.
046400     EXIT.
046500
048500
048600**************************************************
048700*                                                *
048800*     6 - M A I N                                *
048900*                                                *
049000**************************************************
049100
049200 6-MAIN.
049300     MOVE "FRELMAN1"  TO  VIEW-NFNAME.
050600
050800     MOVE SPACES             TO  SCREEN-1.
050900     MOVE COMP-SCREEN-INDIC  TO  DISP-COMPANY.
051000     MOVE PO-NUM             TO  DE-BLKT-NUM.
           MOVE ZEROS              TO  DE-ITEM-NUM.
051700
      *----- IF NOT THE FIRST TIME DISPLAYING THE SCREEN THEN
      *----- POSITION THE CURSOR TO THE SECOND INPUT FIELD
051800     IF NOT-FIRST-TIME
052000         MOVE B"1" TO IND (2).
052200
052300 6-SHOWFORM-SCREEN-1.
           MOVE SCREEN-1       TO DISPLAY-REC.
           PERFORM 998-WRITE-SCREEN THRU 998-READ-SCREEN.
           MOVE DISPLAY-REC    TO SCREEN-1.
054000
054100     IF VIEW-LASTKEY = 3
054200         GO TO 6-M-X
054300     ELSE
055700     IF VIEW-LASTKEY = 1 OR
055800        VIEW-LASTKEY = 2 OR
055900        VIEW-LASTKEY = 4 OR
056000        VIEW-LASTKEY = 5 OR
056100        VIEW-LASTKEY = 6 OR
056200        VIEW-LASTKEY = 7 OR
056200        VIEW-LASTKEY = 8
056400*        *** INVALID FUNCTION KEY ENTERED ***
056500         MOVE   9 TO LANG-SETNUM
056600         MOVE  10 TO LANG-MSGNUM
056700         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
056800         MOVE 1  TO  FIELD-NUMBER
056900         PERFORM 4-PGM-ERROR  THRU  4-PGM-ERROR-X
057000         GO TO 6-SHOWFORM-SCREEN-1.
057100
      *------- FIELD EDITS
           IF DE-CORP-CODE = SPACES AND
              DE-REQ-NUM = SPACES AND
              DE-ITEM-NUM = ZEROS
      *        YOU MUST ENTER PO NO. OR REQ. NO. OR ITEM NUMBER
076900         MOVE  66138  TO CATREAD-MSG-NUMBER
077100         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
077200         MOVE 4  TO  FIELD-NUMBER
077300         PERFORM 4-PGM-ERROR  THRU 4-PGM-ERROR-X
077400         GO TO 6-SHOWFORM-SCREEN-1.
078700
           IF DE-CORP-CODE NOT = SPACES AND
              DE-ITEM-NUM NOT = ZEROS
      *        SELECT ONLY ONE OPTION
076900         MOVE 66140  TO CATREAD-MSG-NUMBER
077100         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
077200         MOVE 2  TO  FIELD-NUMBER
077300         PERFORM 4-PGM-ERROR  THRU 4-PGM-ERROR-X
077400         GO TO 6-SHOWFORM-SCREEN-1.
078700
           IF DE-CORP-CODE NOT = SPACES AND
              DE-REQ-NUM NOT = SPACES
      *        SELECT ONLY ONE OPTION
076900         MOVE 66140  TO CATREAD-MSG-NUMBER
077100         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
077200         MOVE 4  TO  FIELD-NUMBER
077300         PERFORM 4-PGM-ERROR  THRU 4-PGM-ERROR-X
077400         GO TO 6-SHOWFORM-SCREEN-1.

           IF DE-CORP-CODE = "NON-STR"
      *        INVALID CORPORATE CODE
076900         MOVE 35021  TO CATREAD-MSG-NUMBER
077100         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
077200         MOVE 2  TO  FIELD-NUMBER
077300         PERFORM 4-PGM-ERROR  THRU 4-PGM-ERROR-X
077400         GO TO 6-SHOWFORM-SCREEN-1.

      *-------- VALIDATE USER-ID ENTERED.
           IF DE-NOTIFY-USERID > SPACES
               CALL "MCXCHKUSR" USING DE-NOTIFY-USERID VALID-USER
               IF VALID-USER = "N"
      *        A VALID USERID MUST BE ENTERED
                   MOVE 22027  TO CATREAD-MSG-NUMBER
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE 5  TO  FIELD-NUMBER
                   PERFORM 4-PGM-ERROR  THRU 4-PGM-ERROR-X
                   GO TO 6-SHOWFORM-SCREEN-1.

059100     MOVE SPACES                  TO  SRELEASE-PARMS.
059200     MOVE "P"                     TO  REL-CALL-PROG-ID.
059300     MOVE SAVE-PO-PRT-NUM         TO  REL-PO-PRT-NUM.
059400     MOVE EDIT-ADDTL-DATA-SW      TO  REL-EDIT-ADDTL-DATA-SW.
           MOVE ZEROS                   TO  REL-REQ-QUANTITY.
           MOVE DE-NOTIFY-USERID        TO  REL-NOTIFY-USERID.
059500
059600*****************************************************
059700*                                                   *
059800*    EDIT REQUIREMENT ORDER NUMBER                  *
059900*                                                   *
060000*****************************************************
060100
060200 6-EDIT-REQUIRE-ORDER.
060300     IF DE-BLKT-NUM = SPACES
060400         IF DE-ITEM-NUM NOT = ZEROS
060500*            *** YOU MUST ENTER A REQUIREMENT ORDER WHEN USING
060600*                ITEM NO. ***
060700             MOVE  25 TO LANG-SETNUM
060800             MOVE  17 TO LANG-MSGNUM
060900             PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
061000             MOVE 1  TO  FIELD-NUMBER
061100             PERFORM 4-PGM-ERROR  THRU  4-PGM-ERROR-X
061200             GO TO 6-SHOWFORM-SCREEN-1
061300         ELSE
061400             GO TO 6-EDIT-REQ-NO.
061500     MOVE DE-BLKT-NUM             TO  PO-NUM.
061600     MOVE BUILD-PO-NUM            TO  PO-ARG.
           MOVE 0 TO COND-WORD.
           MOVE PO-ARG TO PORCVNO OF DPORECD-REC-I.
           START DPORECD-I KEY = PORCVNO OF DPORECD-REC-I
               INVALID KEY MOVE 17 TO COND-WORD.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
                   MOVE 17 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.
061700*A   CALL "DBFIND" USING BASE, DSET-DPORECD, MODE1,
061800*A          STATUS-AREA, PO-SEARCH, PO-ARG.
061900     IF COND-WORD NOT = 0
062000         IF COND-WORD = 17
062100*            *** REQUIREMENT ORDER DOES NOT EXIST ***
062200             MOVE  18 TO LANG-SETNUM
062300             MOVE  20 TO LANG-MSGNUM
062400             PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
062500             MOVE MESSAGE-BUFFER TO MSG-TEXT
062600             MOVE DE-BLKT-NUM  TO  MSG-FLD
062700             MOVE 1            TO  FIELD-NUMBER
062800             PERFORM 4-PGM-ERROR  THRU  4-PGM-ERROR-X
062900             GO TO 6-SHOWFORM-SCREEN-1
063000         ELSE
063100             MOVE "FIND DPORECD 6-ERO" TO BU-DISPLAY-MSG
063200             MOVE PO-ARG               TO BU-DISPLAY-FLD (1)
063300             GO TO 2-BLOWUP.
           MOVE 0 TO COND-WORD.
           READ DPORECD-I NEXT INTO BUF-DPORECD
               AT END MOVE 15 TO COND-WORD.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14"
                   MOVE 15 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.
           IF PORCVNO OF DPORECD-REC-I NOT = PO-ARG
               MOVE 15 TO COND-WORD.
063400*A   CALL "DBGET" USING BASE, DSET-DPORECD, MODE5,
063500*A       STATUS-AREA, ALL-ITEMS, BUF-DPORECD, PO-ARG.
063600     IF COND-WORD NOT = 0
063700         MOVE "GET DPORECD 6-ERO" TO BU-DISPLAY-MSG
063800         MOVE PO-ARG              TO BU-DISPLAY-FLD (1)
063900         GO TO 2-BLOWUP.
064000
      *--------- USE CENTURY PO DATE.
064100     IF PO-EXPECT-DATE-CN < CUR-DATE
064200*        *** REQUIREMENT ORDER HAS EXPIRED CANNOT CUT RELEASE
064300*            EXP. DATE = ***
064400         MOVE  18 TO LANG-SETNUM
064500         MOVE  52 TO LANG-MSGNUM
064600         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
064700         MOVE MESSAGE-BUFFER TO MSG-TEXT
064800         MOVE PO-EXPECT-DATE  TO  MSG-FLD
064900         MOVE 1               TO  FIELD-NUMBER
065000         PERFORM 4-PGM-ERROR  THRU  4-PGM-ERROR-X
065100         GO TO 6-SHOWFORM-SCREEN-1.
065200
065300
065400     MOVE DE-BLKT-NUM          TO  REL-BLANKET-NUM.
065500
065600
065700**************************************************
065800*                                                *
065900*   EDIT REQUISITION NUMBER                      *
066000*                                                *
066100**************************************************
066200
066300 6-EDIT-REQ-NO.
066400     IF DE-REQ-NUM = SPACES
066500         GO TO 6-EDIT-CODE.
066600     MOVE DE-REQ-NUM   TO  REQ-ARG.
           MOVE 0 TO COND-WORD.
           MOVE REQ-ARG TO REQNO OF MREQ-REC-I.
           READ MREQ-I INTO BUF-MREQ
               INVALID KEY MOVE 17 TO COND-WORD.
           IF FILE-STATUS-1 = "2"
               MOVE 17 TO COND-WORD
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD.
066700*A   CALL "DBGET" USING BASE, DSET-MREQ, MODE7, STATUS-AREA
066800*A       ALL-ITEMS, BUF-MREQ, REQ-ARG.
066900     IF COND-WORD  NOT = 0
067000         IF COND-WORD  =  17
067100*            *** REQUISITION DOES NOT EXIST ***
067200             MOVE  18 TO LANG-SETNUM
067300             MOVE   5 TO LANG-MSGNUM
067400             PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
067500             MOVE MESSAGE-BUFFER TO MSG-TEXT
067600             MOVE DE-REQ-NUM  TO  MSG-FLD
067700             MOVE 4   TO  FIELD-NUMBER
067800             PERFORM 4-PGM-ERROR  THRU  4-PGM-ERROR-X
067900             GO TO 6-SHOWFORM-SCREEN-1
068000         ELSE
068100             MOVE "GET MREQ 6-EDIT-REQ-NO" TO BU-DISPLAY-MSG
068200             MOVE REQ-ARG  TO  BU-DISPLAY-FLD (1)
068300             GO TO 2-BLOWUP.
068400
068500**************************************************
068600*                                                *
068700*  MAKE SURE REQ. HAS BEEN RELEASED BY MATCONT   *
068800*                                                *
068900**************************************************
069000
069100     IF REQ-MATCONT-RELEASE  =  SPACES
069200*        *** REQ. NOT RELEASED BY ORIGINATOR; CANNOT PROCESS
069300*           RELEASE ***
069400         MOVE  18 TO LANG-SETNUM
069500         MOVE  53 TO LANG-MSGNUM
069600         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
069700         MOVE 4   TO  FIELD-NUMBER
069800         PERFORM 4-PGM-ERROR  THRU  4-PGM-ERROR
069900         GO TO 6-SHOWFORM-SCREEN-1.
070000
070100     IF REQ-PURCH-RELEASE = SPACES
070200         NEXT SENTENCE
070300     ELSE
070400*        *** REQ. HAS ALREADY BEEN ASSIGNED A P.O. CANNOT PROCESS
070500*            ON RELEASE ***
070600         MOVE  18 TO LANG-SETNUM
070700         MOVE  54 TO LANG-MSGNUM
070800         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
070900         MOVE 4   TO  FIELD-NUMBER
071000         PERFORM 4-PGM-ERROR  THRU  4-PGM-ERROR-X
071100         GO TO 6-SHOWFORM-SCREEN-1.
071200
071300**************************************************
071400*  IF REQ. IS NON-CODED MAKE SURE THAT REQ. NO.  *
071500*  AND ITEM NUMBER ARE ALSO ENTERED              *
071600**************************************************
071700
071800     IF REQ-MAT-TYPE = "S"
071900         NEXT SENTENCE
072000     ELSE
072100         IF DE-BLKT-NUM = SPACES
072200*        * MUST ENTER A REQUIREMENT ORDER WHEN REQ. IS NON-CODED *
072300             MOVE  13 TO LANG-SETNUM
072400             MOVE  40 TO LANG-MSGNUM
072500             PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
072600             MOVE 1  TO  FIELD-NUMBER
072700             PERFORM 4-PGM-ERROR  THRU  4-PGM-ERROR-X
072800             GO TO 6-SHOWFORM-SCREEN-1
072900         ELSE
073000         IF DE-ITEM-NUM = ZEROS
073100*        * MUST ENTER AN ITEM NUMBER WHEN REQ. IS NON-CODED *
073200             MOVE  13 TO LANG-SETNUM
073300             MOVE  41 TO LANG-MSGNUM
073400             PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
073500             MOVE 3  TO  FIELD-NUMBER
073600             PERFORM 4-PGM-ERROR  THRU  4-PGM-ERROR-X
073700             GO TO 6-SHOWFORM-SCREEN-1.
073800
073900 6-GET-DREQITM.
           MOVE REQ-ARG TO REQNO OF DREQITM-REC-I.
           START DREQITM-I KEY = REQNO OF DREQITM-REC-I
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
074300         MOVE "FIND DREQITM 6-GD" TO BU-DISPLAY-MSG
074400         MOVE REQ-ARG             TO BU-DISPLAY-FLD (1)
074500         GO TO 2-BLOWUP.
           READ DREQITM-I NEXT INTO BUF-DREQITM
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
074900         MOVE "GET DREQITM 6-GD" TO BU-DISPLAY-MSG
075000         MOVE REQ-ARG            TO BU-DISPLAY-FLD (1)
075100         GO TO 2-BLOWUP.
075200
075300     IF REQITM-CORP-CODE = "NON-STR"
075400         GO TO 6-CONT-REQ.
075500     MOVE REQITM-CORP-CODE  TO  CODE-ARG.
075600     IF DE-BLKT-NUM = SPACES
075700         PERFORM 61-CHECK-FOR-REQ-ORDER  THRU  61-CFRO-X
075800         IF UNEXPIRED-BLKT-COUNT = 0
075900             MOVE 4  TO  FIELD-NUMBER
076000             PERFORM 4-PGM-ERROR  THRU  4-PGM-ERROR-X
076100             GO TO 6-SHOWFORM-SCREEN-1
076200         ELSE
076300             NEXT SENTENCE
076400     ELSE
076500         PERFORM 61-CHECK-FOR-CODE-ON-REQ  THRU  61-CFCOR-X
076600         IF CODE-ON-REQ-SW = "Y"
076700             NEXT SENTENCE
076800         ELSE
076900*            *** CODE IS NOT ON REQUIREMENT ORDER ***
077000             MOVE   3 TO LANG-SETNUM
077100             MOVE 124 TO LANG-MSGNUM
077200             PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
077300             MOVE MESSAGE-BUFFER TO MSG-TEXT
077400             MOVE REQITM-CORP-CODE  TO  MSG-FLD
077500             MOVE 4  TO  FIELD-NUMBER
077600             PERFORM 4-PGM-ERROR  THRU  4-PGM-ERROR-X
077700             GO TO 6-SHOWFORM-SCREEN-1.
077800
077900 6-CONT-REQ.
078000     MOVE DE-REQ-NUM            TO  REL-REQ-NUM.
078100     IF REQ-DATE-WANTED = SPACES
078200         NEXT SENTENCE
078300     ELSE
078400         MOVE 4                 TO  DATE-MODE
078500         MOVE REQ-DATE-WANTED   TO  DATE-VALIDATE-IN
078600         CALL "TDATECK2" USING DATE-CHECK-AREA, LANGUAGE-PARMS
078700         MOVE DATE-YMD-OUT      TO  REL-REQ-DATE-WANT.
078800     MOVE REQITM-CORP-CODE      TO  REL-CODE.
078900     MOVE REQITM-QTY-TO-ORD     TO  REL-REQ-QUANTITY.
079000     MOVE REQITM-UM             TO  REL-REQ-QTY-UM.
           MOVE REQ-CO                TO  REL-COMPANY.
           MOVE REQ-PRIME             TO  REL-PRIME.
079100     MOVE REQ-SUB               TO  REL-SUB.
079200     MOVE REQ-SUBD              TO  REL-SUBD.
079300     MOVE REQ-ADDTL-DATA        TO  REL-ADDTL-DATA.
079400     IF REQITM-CORP-CODE = "NON-STR"
079500         GO TO 6-EDIT-ITEM-NO
079600     ELSE
079700         GO TO 6-CALL-SRELEASE.
079800
079900 6-EDIT-CODE.
080000     IF DE-CORP-CODE = SPACES
080100         GO TO 6-EDIT-ITEM-NO.
080200     MOVE DE-CORP-CODE        TO  CODE-ARG.
           MOVE 0 TO COND-WORD.
           MOVE CODE-ARG TO CORPCDE OF MSTORERM-REC-I.
           READ MSTORERM-I INTO BUF-MSTORERM
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
                   MOVE 17 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.
080300*A   CALL "DBGET" USING BASE, DSET-MSTORERM, MODE7,
080400*A       STATUS-AREA, ALL-ITEMS, BUF-MSTORERM, CODE-ARG.
080500     IF COND-WORD NOT = 0
080600         IF COND-WORD = 17
080700*            *** STORES CODE DOES NOT EXIST ***
080800             MOVE  19 TO LANG-SETNUM
080900             MOVE   9 TO LANG-MSGNUM
081000             PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
081100             MOVE MESSAGE-BUFFER TO MSG-TEXT
081200             MOVE DE-CORP-CODE  TO  MSG-FLD
081300             MOVE 2             TO  FIELD-NUMBER
081400             PERFORM 4-PGM-ERROR  THRU  4-PGM-ERROR-X
081500             GO TO 6-SHOWFORM-SCREEN-1
081600         ELSE
081700             MOVE "GET MSTORERM 6-EDIT-CODE" TO BU-DISPLAY-MSG
081800             MOVE CODE-ARG          TO BU-DISPLAY-FLD (1)
081900             GO TO 2-BLOWUP.
082000
082100     IF DE-BLKT-NUM = SPACES
082200         PERFORM 61-CHECK-FOR-REQ-ORDER  THRU  61-CFRO-X
082300         IF UNEXPIRED-BLKT-COUNT = 0
082400             MOVE 2  TO  FIELD-NUMBER
082500             PERFORM 4-PGM-ERROR  THRU  4-PGM-ERROR-X
082600             GO TO 6-SHOWFORM-SCREEN-1
082700         ELSE
082800             NEXT SENTENCE
082900     ELSE
083000         PERFORM 61-CHECK-FOR-CODE-ON-REQ  THRU  61-CFCOR-X
083100         IF CODE-ON-REQ-SW = "Y"
083200             NEXT SENTENCE
083300         ELSE
083400*            *** CODE IS NOT ON REQUIREMENT ORDER ***
083500             MOVE   3 TO LANG-SETNUM
083600             MOVE 124 TO LANG-MSGNUM
083700             PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
083800             MOVE MESSAGE-BUFFER TO MSG-TEXT
083900             MOVE DE-CORP-CODE  TO  MSG-FLD
084000             MOVE 2  TO  FIELD-NUMBER
084100             PERFORM 4-PGM-ERROR  THRU  4-PGM-ERROR-X
084200             GO TO 6-SHOWFORM-SCREEN-1.
084300
084400     MOVE DE-CORP-CODE       TO  REL-CODE.

      *------ MOVE THE LEAD TIEMS SO THAT THE EXPECT DATE CAN BE
      *------ CALCULATED.
           IF CALC-DATE-WANTED-SW = "Y"
               PERFORM VARYING SUB FROM 1 BY 1 UNTIL SUB > 3
                   MOVE STR-LAST-DLVTIMES (SUB) TO LEAD-TIMES (SUB)
               END-PERFORM
               MOVE STR-EST-LT                  TO SHIP-TIME
           END-IF.

084500     GO TO 6-CALL-SRELEASE.
084600
084700 6-EDIT-ITEM-NO.
           MOVE PO-ARG           TO  PORCVNO OF DPOITEMP-REC-I.
           MOVE DE-ITEM-NUM      TO  ITEMNO OF DPOITEMP-REC-I.
           READ DPOITEMP-I INTO BUF-DPOITEM
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
085800     IF FILE-STATUS NOT = "00"
085900         IF FILE-STATUS-1 =  "2"
086000*            *** ITEM # NOT FOUND ON REQUIREMENT ORDER CANNOT
086100*                PROCESS RELEASE ***
086200             MOVE   9 TO LANG-SETNUM
086300             MOVE  79 TO LANG-MSGNUM
086400             PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
086500             MOVE 3  TO  FIELD-NUMBER
086600             PERFORM 4-PGM-ERROR  THRU  4-PGM-ERROR-X
086700             GO TO 6-SHOWFORM-SCREEN-1
086800         ELSE
086900             MOVE "GET DPOITEM 6-GDI" TO BU-DISPLAY-MSG
087000             MOVE PO-ARG  TO  BU-DISPLAY-FLD (1)
087100             GO TO 2-BLOWUP.
087200
087800     IF DE-REQ-NUM NOT = SPACES
087900         IF REQ-MAT-TYPE = "N"
088000             IF ITM-CORP-CODE = "NON-STR"
088100                 NEXT SENTENCE
088200             ELSE
088300**               NON-CODED REQUISITION; MUST ENTER A NON-CODED
088400**                ITEM NUMBER ON REQUIREMENT ORDER
088500                 MOVE  14 TO LANG-SETNUM
088600                 MOVE  32 TO LANG-MSGNUM
088700                 PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
088800                 MOVE 3  TO  FIELD-NUMBER
088900                 PERFORM 4-PGM-ERROR  THRU  4-PGM-ERROR-X
089000                 GO TO 6-SHOWFORM-SCREEN-1.
089100
089200
089300     MOVE DE-ITEM-NUM        TO  REL-ITEM-NUM.

      *------ FIND LEAD TIMES FOR CORP CODE.
080200     MOVE ITM-CORP-CODE          TO  CODE-ARG.
           MOVE 0 TO COND-WORD.
           MOVE CODE-ARG TO CORPCDE OF MSTORERM-REC-I.
           READ MSTORERM-I INTO BUF-MSTORERM
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE SPACES             TO  REL-REQ-DATE-WANT
           ELSE
           IF CALC-DATE-WANTED-SW = "Y"
               PERFORM VARYING SUB FROM 1 BY 1 UNTIL SUB > 3
                   MOVE STR-LAST-DLVTIMES (SUB) TO LEAD-TIMES (SUB)
               END-PERFORM
               MOVE STR-EST-LT                  TO SHIP-TIME
           END-IF.
089400
089500 6-CALL-SRELEASE.
089600     IF DE-BLKT-NUM = SPACES
089700         IF UNEXPIRED-BLKT-COUNT > 1
089800             MOVE SPACES  TO  SELECTED-BLANKET-NO
089900             CALL "TGETBLK2" USING BASE,
090000                                   CODE-ARG,
090100                                   SELECTED-BLANKET-NO,
090200                                   COMP-SCREEN-INDIC,
090300                                   VIEW-COMAREA,
090400                                   SCREEN-PRINT-PARMS,
090500                                   PASSED-SPOOL-PRT,
090600                                   LANGUAGE-PARMS
090700             IF VIEW-LASTKEY = 7 OR 3
090800                 GO TO 6-MAIN
090900             ELSE
091000                 MOVE SELECTED-BLANKET-NO  TO  REL-BLANKET-NUM.
091100
      *------ CALL THE SUBPROGRAM TO OBTAIN THE EXPECT DATE FOR
      *------ SRELEASE.
      *------ DON'T CALL THE PROGRAM IF THE PLANT DOESN'T WANT THE
      *------ EXPECT DATE TO BE CALCULATED.
           IF CALC-DATE-WANTED-SW NOT = "Y"
               MOVE SPACES      TO REL-REQ-DATE-WANT
           ELSE
      *------ WE ALREADY HAVE THE EXP DATE IF REQ NUMBER IS NOT BLANK.
           IF DE-REQ-NUM NOT = SPACES
               NEXT SENTENCE
           ELSE
               CALL "SCALCEDT" USING SCALCEDT-PARAMETERS
               MOVE 4                 TO  DATE-MODE
               MOVE EXPECT-DATE       TO  DATE-VALIDATE-IN
               CALL "TDATECK2" USING DATE-CHECK-AREA, LANGUAGE-PARMS
               MOVE DATE-YMD-OUT      TO  REL-REQ-DATE-WANT.

091200     CALL "SRELEASE" USING BASE,
091300                           BASE-MMISA,
091400                           SRELEASE-PARMS,
091500                           COMP-SCREEN-INDIC,
091600                           VIEW-COMAREA,
091700                           SCREEN-PRINT-PARMS,
091800                           PASSED-SPOOL-PRT,
091900                           LANGUAGE-PARMS,
092000                           ESC-NAME.
           IF VIEW-LASTKEY = 7
               GO TO 6-CALL-SRELEASE.
092100
092200     MOVE "N"             TO  FIRST-TIME-SW.
092300
092400     GO TO 6-MAIN.
092500
092600 6-M-X.
092700     EXIT.
092800
092900 61-CHECK-FOR-CODE-ON-REQ.
093600     MOVE SPACES  TO  CODE-ON-REQ-SW.
           MOVE CODE-ARG TO CORPCDE OF DPOITEMC-REC-I.
           START DPOITEMC-I KEY = CORPCDE OF DPOITEMC-REC-I
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
                   GO TO 61-CFCOR-X
               ELSE
093300             MOVE "FIND DPOITEM 61-CFCOR"  TO  BU-DISPLAY-MSG
093400             MOVE CODE-ARG                 TO  BU-DISPLAY-FLD (1)
093500             GO TO 2-BLOWUP.
093700
093800 61-GET-DPOITEM.
           MOVE 0 TO COND-WORD.
           READ DPOITEMC-I NEXT INTO BUF-DPOITEM
               AT END MOVE 15 TO COND-WORD.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14"
                   MOVE 15 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.
           IF CORPCDE OF DPOITEMC-REC-I NOT = CODE-ARG
               MOVE 15 TO COND-WORD.
093900*A   CALL "DBGET" USING BASE,DSET-DPOITEM, MODE5,
094000*A       STATUS-AREA, ALL-ITEMS, BUF-DPOITEM, CODE-ARG.
094100     IF COND-WORD NOT = 0
094200         IF COND-WORD = 15
094300             GO TO 61-CFCOR-X
094400         ELSE
094500             MOVE "GET DPOITEM 61-GD"  TO BU-DISPLAY-MSG
094600             MOVE CODE-ARG             TO BU-DISPLAY-FLD (1)
094700             GO TO 2-BLOWUP.
094800     IF PO-ARG = ITM-PO-RCV-NO
094900         MOVE "Y"  TO  CODE-ON-REQ-SW
095000     ELSE
095100         GO TO 61-GET-DPOITEM.
095200
095300 61-CFCOR-X.
095400     EXIT.
095500
095600
095700 61-CHECK-FOR-REQ-ORDER.
095800     MOVE SPACES  TO  CHKBLKT-PARMS.
           MOVE COMP-SCREEN-INDIC TO COMPANY-ID.
095900     CALL "TCHKBLKT" USING BASE,
096000                           CODE-ARG,
096100                           CHKBLKT-PARMS.
096200     IF UNEXPIRED-BLKT-COUNT = 1
096300         MOVE FIRST-UNEXPIRED-BLKT  TO  REL-BLANKET-NUM
096400     ELSE
096500     IF UNEXPIRED-BLKT-COUNT = 0
096600*        *** NO UNEXPIRED REQUIREMENT ORDER WAS FOUND ***
096700         MOVE  14 TO LANG-SETNUM
096800         MOVE  78 TO LANG-MSGNUM
096900         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
097000         MOVE MESSAGE-BUFFER TO MSG-TEXT
097100         MOVE CODE-ARG  TO  MSG-FLD.
097200
097300 61-CFRO-X.
097400     EXIT.
097500
       COPY DISPCALL IN COPYLIB.

097600 999-CATREAD.
           IF CATREAD-MSG-NUMBER = ZEROS
               MOVE LANG-SETNUM TO CATREAD-MSG-SET
               MOVE LANG-MSGNUM TO CATREAD-MSG-NUM.
           CALL "CCATREAD" USING CATREAD-PARMS.
           MOVE CATREAD-MSG-TEXT TO MESSAGE-BUFFER.
099200 999-CATREAD-EXIT.
099300     EXIT.
