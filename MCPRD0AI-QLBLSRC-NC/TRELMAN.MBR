           COPY DDS-ALL-FORMATS  OF MCFLCS2001.

       FD  DPORECD-I
           LABEL RECORDS ARE STANDARD.
       01  DPORECD-REC-I.
           COPY DDS-ALL-FORMATS  OF MCFLCS0901.

       FD  DREQITM-I
           LABEL RECORDS ARE STANDARD.
       01  DREQITM-REC-I.
           COPY DDS-ALL-FORMATS  OF MCFLCS2201.

       FD  DPOITEMP-I
           LABEL RECORDS ARE STANDARD.
       01  DPOITEMP-REC-I.
           COPY DDS-ALL-FORMATS  OF MCFLCS1002.

       FD  DPOITEMC-I
           LABEL RECORDS ARE STANDARD.
       01  DPOITEMC-REC-I.
           COPY DDS-ALL-FORMATS  OF MCFLCS1001.

