000200 IDENTIFICATION DIVISION.
000300 PROGRAM-ID.    TRELMAN.
000400 AUTHOR.        KURT MOVSESIAN/JIM COFFMAN(MAINTAINER).
002200
002300**************************************************************
002400*                                                            *
002500*   T R E L M A N     THIS PROGRAM CREATES SHIPPING RELEASES *
002600*     IN PURCHASING BY ENTERING THE REQUIREMENT ORDER AND    *
002700*     EITHER THE REQUISITION NUMBER, CORP CODE, OR ITEM NO.  *
002800*                                                            *
002900*   SUBROUTINES CALLED:                                      *
003000*                           1) SRELEASE.SOURCE               *
003100*                           2) TCHKBLKT.SOURCE               *
003200*                           3) TGETBLKT.SOURCE               *
      *                           4) SCALCEDT                      *
003300*                                                            *
003400**************************************************************
      *C
      *C  03/23/94  JEFF BUNGO  REQ #6488
      *C    GAVE SHIPPING RELEASES THEIR OWN PRINTER NUMBER INSTEAD
      *C    OF USING THE PO PRINTER.  IF THE SHIPPING RELEASE
      *C    PRINTER NUMBER IS NOT YET DEFINED THEN USE THE PO
      *C    PRINTER NUMBER AND UPDATE THE SHIPPING RELEASE PRINTER
      *C    WITH THE PO PRINTER NUMBER.
      *C
      *C  08/31/1995  CATHY YODER   REQ # 95-022
      *C    ADDED CALL TO A NEW SUBROUTINE (SCALCEDT) TO CALCULATE
      *C    THE EXPECT DATE AND THEN PASS THAT PARAMETER TO SRELEASE.
      *C    THIS PREVENTS THE EXPECT DATE AND SHIP DATE FIELDS FROM
      *C    SHOWING UP AS SPACES.
      *C
      *C  06/14/1996  CA YODER
      *C    MODIFIED FOR CENTURY DATABASE CHANGES.
      *C
      *C  10/27/1997  CA YODER
      *C    ADDED FIELD TO SCREEN TO ALLOW NOTIFICATION OF A USER WHEN
      *C    THE MATERIAL IS RECEIVED AT THE DOCK.
      *C
003500
008400
008500
008600 ENVIRONMENT DIVISION.
008700 CONFIGURATION SECTION.
008800 SOURCE-COMPUTER.  HP-3000.
008900 OBJECT-COMPUTER.  HP-3000.
       SPECIAL-NAMES.  I-O-FEEDBACK IS I-O-FEEDBACK-AREA.
012800
012900 INPUT-OUTPUT SECTION.
       FILE-CONTROL.

           SELECT DISPLAY-FILE
                  ASSIGN TO WORKSTATION-ZRELMAN-SI
                  ORGANIZATION IS TRANSACTION
                  ACCESS IS SEQUENTIAL
                  FILE STATUS IS DISPLAY-STATUS
                  CONTROL-AREA IS WS-CONTROL.

           SELECT MPLTINFO-I
                  ASSIGN TO DATABASE-MCFLCS0501
                  ORGANIZATION IS INDEXED
                    ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                  FILE STATUS IS FILE-STATUS.

           SELECT MPLTINFO
                  ASSIGN TO DATABASE-MCFLCS0501
                  ORGANIZATION IS INDEXED
                    ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                  FILE STATUS IS FILE-STATUS.

           SELECT MSTORERM-I
                  ASSIGN TO DATABASE-MCFLCS0201
                  ORGANIZATION IS INDEXED
                    ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                  FILE STATUS IS FILE-STATUS.

           SELECT MREQ-I
                  ASSIGN TO DATABASE-MCFLCS2001
                  ORGANIZATION IS INDEXED
                    ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                  FILE STATUS IS FILE-STATUS.
003500
           SELECT DPORECD-I
                  ASSIGN TO DATABASE-MCFLCS0901
                  ORGANIZATION IS INDEXED
                    ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                    WITH DUPLICATES
                  FILE STATUS IS FILE-STATUS.

           SELECT DREQITM-I
                  ASSIGN TO DATABASE-MCFLCS2201
                  ORGANIZATION IS INDEXED
                    ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                    WITH DUPLICATES
                  FILE STATUS IS FILE-STATUS.

           SELECT DPOITEMP-I
                  ASSIGN TO DATABASE-MCFLCS1002
                  ORGANIZATION IS INDEXED
                    ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                    WITH DUPLICATES
                  FILE STATUS IS FILE-STATUS.

           SELECT DPOITEMC-I
                  ASSIGN TO DATABASE-MCFLCS1001
                  ORGANIZATION IS INDEXED
                    ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                    WITH DUPLICATES
                  FILE STATUS IS FILE-STATUS.

       DATA DIVISION.
