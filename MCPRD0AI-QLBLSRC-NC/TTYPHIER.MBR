000300 IDENTIFICATION DIVISION.
000400 PROGRAM-ID.     TTYPHIER.
000800*REMARKS. THIS PROGRAM COPIES ALL OR PART OF A TYPE NUMBER'S
000900*         HIERARCHY TO A NEW TYPE NUMBER'S HIERARCHY.
001100 ENVIRONMENT DIVISION.
001200 CONFIGURATION SECTION.
001300 SOURCE-COMPUTER.   AS400.
001400 OBJECT-COMPUTER.   AS400.
       SPECIAL-NAMES. I-O-FEEDBACK IS I-O-FEEDBACK-AREA
                      LOCAL-DATA IS LOCAL-DATA-AREA.
001000 INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT DISPLAY-FILE
               ASSIGN TO WORKSTATION-ZMASTER-SI
               ORGANIZATION IS TRANSACTION
               ACCESS IS SEQUENTIAL
               FILE STATUS IS DSPLY-STATUS
               CONTROL-AREA IS WS-CONTROL.
           SELECT WO-EQUIP-HIER-FILE
               ASSIGN TO DATABASE-MCFLMM1701
               ORGANIZATION IS INDEXED
               ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
               FILE STATUS IS WEHF-STATUS.
           SELECT WO-EQUIP-HIER-FILE-2
               ASSIGN TO DATABASE-MCFPMM1700
               ORGANIZATION IS RELATIVE
               ACCESS MODE IS RANDOM
               RELATIVE KEY IS PFKEY
               FILE STATUS IS WEHF2-STATUS.
001600 DATA DIVISION.
       FILE SECTION.
       FD  DISPLAY-FILE
           LABEL RECORDS ARE OMITTED.
       01  DSPLY-REC                     PIC X(2000).
       FD  WO-EQUIP-HIER-FILE
           LABEL RECORDS ARE STANDARD
           DATA RECORD IS WEHFREC.
       01  WEHFREC.
           COPY DDS-ALL-FORMATS OF MCFLMM1701.
       FD  WO-EQUIP-HIER-FILE-2
           LABEL RECORDS ARE STANDARD
           DATA RECORD IS WEHF2REC.
       01  WEHF2REC.
           COPY DDS-ALL-FORMATS OF MCFPMM1700.
001700 WORKING-STORAGE SECTION.
004200 01  ADDRESS-SUB                   PIC 9(4).
006500 01  ADDRESS-TABLE.
006600     05  REC-ADD OCCURS 9000 TIMES PIC 9(9).
003300 01  ALL-SUBS-FOUND-SW             PIC X VALUE "N".
       01  BLOWUP-BASE                   PIC X(16).
       COPY CATREAD OF COPYLIB.
003000 01  COPY-SW                       PIC X VALUE "N".
       COPY CPYIND  OF COPYLIB.
007900 01  DIG-LEVEL.
008000     05 D1                         PIC X.
008100     05 D2                         PIC X.
008200     05 D3                         PIC X.
008300     05 D4                         PIC X.
008400 01  DIG-LEVEL1.
008500     05 D11                        PIC X.
008600     05 D12                        PIC X.
008700     05 D13                        PIC X.
008800     05 D14                        PIC X.
       01  DSPLY-STATUS                  PIC XX.
005300 01  EQUIP-HIER-BUFFER.
005400     05  HIER-KEY.
005500         10  EQP-TYPE-BUF          PIC X(8).
005600         10  FATHER-SUB-BUF.
005700             15  FATH-4-BUF        PIC X(4).
005800             15  FILLER            PIC XX VALUE SPACES.
005900     05  HIER-DISP-CODE.
006000         10  SON-SUB-BUF.
006100             15  SON-4-BUF         PIC X(4).
006200             15  FILLER            PIC XX VALUE SPACES.
006300     05  SUB-ASSY-NAME             PIC X(50).
003400 01  FIELD-COUNT                   PIC 9.
004400 01  FIND-KEY-SUB                  PIC 9(4).
007100 01  INPUT-BUFFER.
007200     05  TYPENUM1                  PIC X(8).
007300     05  TYPENUM2                  PIC X(8).
007400     05  LEVEL1                    PIC X(4).
007500     05  LEVEL1A                   PIC X(4).
007600     05  LEVEL2                    PIC X(4).
007700     05  LEVEL2A                   PIC X(4).
007800     05  LEVEL3                    PIC X.
           05  INPUT-CMD-LINE            PIC X(79).
           05  INPUT-ERR-LINE            PIC X(79).
       COPY IOFEEDBACK OF COPYLIB.
004300 01  KEY-SUB                       PIC 9(4).
006700 01  KEY-TABLE.
006800     05  KEY-TAB OCCURS 9000 TIMES PIC X(6).
009100 01  LEVEL-SW                      PIC X.
003500 01  LOWER-SW                      PIC X.
009200 01  MESSAGE-1.
009300     05 MESSAGE-LEVEL              PIC X(5).
009400     05 MESSAGE-NOTE               PIC X(72).
006900 01  MISC-BUFFER                   PIC X(80) VALUE SPACES.
001800 01  PASSWORD-INFORMATION.
001900     05  NAME-OF-PROGRAM     PIC X(08) VALUE "TTYPHIER".
002000     05  PROGRAM-TYPE        PIC X(02) VALUE "MA".
002100     05  PROGRAM-RELEASE     PIC X(12) VALUE " E0100010001".
002200     05  PROGRAM-DESCRIPTION.
002300         10  PROG-DESC-A     PIC X(60) VALUE
002400            "COPIES SUBSYSTEMS FROM ONE TYPE NUMBER TO ANOTHER  ".
002500         10  PROG-DESC-B     PIC X(60) VALUE SPACES.
002700         10  PROG-FUNCTION   PIC X(60) VALUE SPACES.
002900     05  PASSWORD-FLAG       PIC X VALUE "Y".
004000 01  PERFORM-K                     PIC 9(4) VALUE 0.
       01  PFKEY                         PIC 9(9).
       COPY DBSTAT OF COPYLIB.
       COPY TBLOWUP OF COPYLIB.
004500 01  TEST-SUB-ARG.
004600     05 TEST-ARG1                  PIC X(8) VALUE SPACES.
004700     05 TEST-ARG2                  PIC X(4) VALUE SPACES.
004800     05 TEST-ARG3                  PIC X(2) VALUE SPACES.
       01  TRUE-VAL                      PIC 1 VALUE B"1".
004900 01  TYPE-SUB-ARG.
005000     05  EQP-TYPE-ARG              PIC X(8) VALUE SPACES.
005100     05  FATH-ARG                  PIC X(4) VALUE SPACES.
005200     05  FILLER                    PIC XX   VALUE SPACES.
008900 01  SAVE-DIG                      PIC X.
       01  WEHF-STATUS                   PIC XX.
       01  WEHF2-STATUS                  PIC XX.
       COPY WSCONTROL OF COPYLIB.
003100 01  ZC1                           PIC 9.
003200 01  ZC2                           PIC 9.
009000 01  ZERO-COUNT                    PIC 9.
009700 LINKAGE SECTION.
       COPY VCOMLINK OF COPYLIB.
011100 PROCEDURE DIVISION USING VIEW-COMAREA.
       START-PGM.
           PERFORM 1-HSK.
           PERFORM 6-MAIN UNTIL VIEW-LASTKEY = 3.
       2-EOJ.
           CLOSE DISPLAY-FILE.
           CLOSE WO-EQUIP-HIER-FILE.
           CLOSE WO-EQUIP-HIER-FILE-2.
           GOBACK.
012600 1-HSK.
           OPEN I-O   DISPLAY-FILE.
           OPEN I-O   WO-EQUIP-HIER-FILE.
           OPEN I-O   WO-EQUIP-HIER-FILE-2.
011900     CALL "TPWORD" USING PASSWORD-INFORMATION.
012300     IF PASSWORD-FLAG = "N" GO TO 2-EOJ.
012700     IF COPY-SW = "Y"
012800         MOVE "FHIERTYP4" TO VIEW-CFNAME.
013900     MOVE SPACES TO INPUT-BUFFER.
           MOVE 0 TO KEY-SUB FIND-KEY-SUB PFKEY ADDRESS-SUB.
       6-MAIN.
014100     MOVE "FHIERTYP1" TO VIEW-CFNAME.
           MOVE INPUT-BUFFER TO DSPLY-REC.
           PERFORM 99-SCREEN-WRITE.
           PERFORM 98-SCREEN-READ.
016300     IF VIEW-LASTKEY = 3 GO TO 2-EOJ.
016400     IF VIEW-LASTKEY = 1
016500         MOVE 0 TO VIEW-LASTKEY
016600         PERFORM HELP-SESSION THRU HELP-SESSION-EXIT
016700             UNTIL VIEW-LASTKEY = 3
016800             GO TO 6-MAIN.
016900     IF VIEW-LASTKEY = 0
017000         NEXT SENTENCE
017100     ELSE
017300     GO TO 6-MAIN.
017400     MOVE DSPLY-REC TO INPUT-BUFFER.
019400     MOVE 0 TO FIELD-COUNT.
019500     IF LEVEL1 NOT = SPACES ADD 1 TO FIELD-COUNT.
019600     IF LEVEL2 NOT = SPACES ADD 1 TO FIELD-COUNT.
019700     IF LEVEL3 NOT = SPACES ADD 1 TO FIELD-COUNT.
019800     IF FIELD-COUNT = 0
020500         MOVE 29026 TO CATREAD-MSG-NUMBER
020700         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MISC-BUFFER TO INPUT-ERR-LINE
020800         MOVE TRUE-VAL TO INDS (3) INDS (99)
020900         GO TO 6-MAIN.
021000     IF LEVEL1 NOT = "    "
021100         PERFORM ONE-LEVEL
021200     ELSE
021300     IF LEVEL2 NOT = "    "
021400         PERFORM LOWER-LEVELS
021500     ELSE
021600     IF LEVEL3 NOT = "    "
021700         PERFORM ALL-LEVELS
021800     ELSE
021900     GO TO 2-EOJ.
022000******** COPY ONE LEVEL OF THE HIERARCHY
022100 ONE-LEVEL.
022200     IF LEVEL1A = "    " MOVE LEVEL1 TO LEVEL1A.
022300     MOVE 0 TO ADDRESS-SUB.
022400     MOVE LOW-VALUES TO ADDRESS-TABLE.
022500     PERFORM ONE-FIND-TYPENUM.
022600     MOVE LEVEL1A TO DIG-LEVEL.
022700     PERFORM ONE-CHECK-DIGITS THRU ONE-MOVE-LEVEL1.
022800     MOVE "N" TO LEVEL-SW.
022900     PERFORM ONE-SEARCH-ENTRY THRU ONE-S-E-E.
023000     IF LEVEL-SW = "Y"
023100         NEXT SENTENCE
023200     ELSE
023300     MOVE LEVEL1A TO MESSAGE-LEVEL
023400     MOVE 31024 TO CATREAD-MSG-NUMBER
023600     PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
023700     MOVE MISC-BUFFER TO MESSAGE-NOTE
023800     MOVE MESSAGE-1 TO MISC-BUFFER
           MOVE MISC-BUFFER TO INPUT-ERR-LINE
023900     MOVE TRUE-VAL TO INDS (99)
024000     GO TO 6-MAIN.
024100     PERFORM ONE-LEVEL-LOCK.
024200     PERFORM ONE-FIND-SUBS THRU ONE-FS-EXIT.
024300     MOVE ADDRESS-SUB TO PERFORM-K.
024400     MOVE 0 TO ADDRESS-SUB.
024500     PERFORM ONE-COPY-SUBS THRU ONE-COPY-EXIT PERFORM-K TIMES.
024600     GO TO 2-EOJ.
024700******** COPY ALL BRANCHING LOWER LEVELS OF THE HIERARCHY
024800 LOWER-LEVELS.
024900     IF LEVEL2A = "    " MOVE LEVEL2 TO LEVEL2A.
025000     MOVE 0 TO ZC1.
025100     MOVE 0 TO ZC2.
025200     INSPECT LEVEL2  TALLYING ZC1 FOR ALL "0".
025300     INSPECT LEVEL2A TALLYING ZC2 FOR ALL "0".
025400     IF ZC1 NOT = ZC2
025500         MOVE 35005 TO CATREAD-MSG-NUMBER
025700         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MISC-BUFFER TO INPUT-ERR-LINE
025800         MOVE TRUE-VAL TO INDS (99)
025900         GO TO 6-MAIN.
026000     MOVE "N" TO ALL-SUBS-FOUND-SW.
026100     MOVE 1 TO KEY-SUB.
026200     MOVE 0 TO FIND-KEY-SUB ADDRESS-SUB.
026300     MOVE SPACES TO KEY-TABLE.
026400     MOVE LOW-VALUES TO ADDRESS-TABLE.
026500     MOVE LEVEL2 TO KEY-TAB (KEY-SUB).
026600     MOVE 0 TO ZERO-COUNT.
026700     INSPECT LEVEL2A TALLYING ZERO-COUNT FOR ALL "0".
026800     IF ZERO-COUNT = 0
026900         MOVE 35005 TO CATREAD-MSG-NUMBER
027100         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MISC-BUFFER TO INPUT-ERR-LINE
027200         MOVE TRUE-VAL TO INDS (99)
027300         GO TO 6-MAIN.
027400     PERFORM LOWER-FIND-TYPENUM.
027500     MOVE LEVEL2A TO DIG-LEVEL.
027600     PERFORM ONE-CHECK-DIGITS THRU ONE-MOVE-LEVEL1.
027700     MOVE "N" TO LEVEL-SW.
027800     MOVE LEVEL2A TO LEVEL1A.
027900     PERFORM ONE-SEARCH-ENTRY THRU ONE-S-E-E.
028000     IF LEVEL-SW = "Y"
028100         NEXT SENTENCE
028200     ELSE
028300     MOVE LEVEL2A TO MESSAGE-LEVEL
028400     MOVE 31024 TO CATREAD-MSG-NUMBER
028600     PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
028700     MOVE MISC-BUFFER TO MESSAGE-NOTE
028800     MOVE MESSAGE-1 TO MISC-BUFFER
           MOVE MISC-BUFFER TO INPUT-ERR-LINE
028900     MOVE TRUE-VAL TO INDS (99)
029000     GO TO 6-MAIN.
029100     MOVE LEVEL2 TO LEVEL1.
029200     MOVE LEVEL2A TO LEVEL1A.
029300     PERFORM ONE-LEVEL-LOCK.
029400     PERFORM ALL-FIND-SUBS THRU ALL-FS-EXIT
029500             UNTIL ALL-SUBS-FOUND-SW = "Y".
029600     MOVE ADDRESS-SUB TO PERFORM-K.
029700     MOVE 0 TO ADDRESS-SUB.
029800     MOVE 0 TO ZERO-COUNT.
029900     MOVE LEVEL2A TO DIG-LEVEL1.
030000     INSPECT DIG-LEVEL1 TALLYING ZERO-COUNT FOR ALL "0".
030100     MOVE "Y" TO LOWER-SW.
030200     PERFORM ALL-COPY-SUBS THRU ALL-COPY-EXIT PERFORM-K TIMES.
030300     GO TO 2-EOJ.
030400******** COPY THE ENTIRE HIERARCHY
030500 ALL-LEVELS.
030600     MOVE "N" TO ALL-SUBS-FOUND-SW.
030700     MOVE 1 TO KEY-SUB.
030800     MOVE 0 TO FIND-KEY-SUB ADDRESS-SUB.
030900     MOVE SPACES TO KEY-TABLE.
031000     MOVE LOW-VALUES TO ADDRESS-TABLE.
031100     MOVE "0000  " TO KEY-TAB (KEY-SUB).
031200     PERFORM ALL-FIND-TYPENUM.
031300     PERFORM ALL-FIND-SUBS THRU ALL-FS-EXIT
031400             UNTIL ALL-SUBS-FOUND-SW = "Y".
031500     MOVE ADDRESS-SUB TO PERFORM-K.
031600     MOVE 0 TO ADDRESS-SUB.
031700     MOVE "N" TO LOWER-SW.
031800     PERFORM ALL-COPY-SUBS THRU ALL-COPY-EXIT PERFORM-K TIMES.
031900     GO TO 2-EOJ.
032000**************************************************************
032100 ONE-FIND-TYPENUM.
032200     MOVE TYPENUM1 TO TEST-ARG1.
032300     MOVE LEVEL1 TO TEST-ARG2.
           MOVE 0 TO COND-WORD.
           MOVE TEST-SUB-ARG TO HIERKEY OF WEHFREC.
           START WO-EQUIP-HIER-FILE KEY IS = EXTERNALLY-DESCRIBED-KEY
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF WEHF-STATUS NOT = "00" MOVE 17 TO COND-WORD.
032600     IF COND-WORD = 17
032700         MOVE 41008 TO CATREAD-MSG-NUMBER
032900         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MISC-BUFFER TO INPUT-ERR-LINE
033000         MOVE TRUE-VAL TO INDS (99)
033100         GO TO 6-MAIN.
033700     MOVE 0 TO ZERO-COUNT.
033800     INSPECT LEVEL1A TALLYING ZERO-COUNT FOR ALL "0".
033900     IF ZERO-COUNT = 0
034000         MOVE 35005 TO CATREAD-MSG-NUMBER
034200         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MISC-BUFFER TO INPUT-ERR-LINE
034300         MOVE TRUE-VAL TO INDS (99)
034400         GO TO 6-MAIN.
034500     MOVE TYPENUM2 TO TEST-ARG1.
034600     MOVE LEVEL1A TO TEST-ARG2.
           MOVE 0 TO COND-WORD.
           MOVE TEST-SUB-ARG TO HIERKEY OF WEHFREC.
           START WO-EQUIP-HIER-FILE KEY IS = EXTERNALLY-DESCRIBED-KEY
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF WEHF-STATUS NOT = "00" MOVE 17 TO COND-WORD.
034900     IF COND-WORD = 0
035000         MOVE 40016 TO CATREAD-MSG-NUMBER
035200         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MISC-BUFFER TO INPUT-ERR-LINE
035300         MOVE TRUE-VAL TO INDS (99)
035400         GO TO 6-MAIN.
035500     IF COND-WORD = 17
035600         NEXT SENTENCE
035700     ELSE
035800     MOVE "PROGRAM TTYPHIER" TO BU-DISPLAY-MSG
035900     MOVE "DBFIND ERROR - PAR ONE-FIND-TYPENUM"
               TO BU-DISPLAY-FLD (1)
036000     MOVE COND-WORD TO BU-DISPLAY-FLD (2)
036100     PERFORM 998-BLOWUP.
036200 ONE-CHECK-DIGITS.
036300     IF D4 = 0
036400         NEXT SENTENCE
036500     ELSE
036600     MOVE 0 TO D4
036700     GO TO ONE-MOVE-LEVEL1.
036800     IF D3 = 0
036900         NEXT SENTENCE
037000     ELSE
037100     MOVE 0 TO D3
037200     GO TO ONE-MOVE-LEVEL1.
037300     IF D2 = 0
037400         NEXT SENTENCE
037500     ELSE
037600     MOVE 0 TO D2
037700     GO TO ONE-MOVE-LEVEL1.
037800     IF D1 = 0
037900         NEXT SENTENCE
038000     ELSE
038100     MOVE 0 TO D1.
038200 ONE-MOVE-LEVEL1.
038300     MOVE DIG-LEVEL TO TEST-ARG2.
038400 ONE-SEARCH-ENTRY.
           MOVE 0 TO COND-WORD.
           MOVE TEST-SUB-ARG TO HIERKEY OF WEHFREC.
           START WO-EQUIP-HIER-FILE KEY IS = EXTERNALLY-DESCRIBED-KEY
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF WEHF-STATUS NOT = "00" MOVE 17 TO COND-WORD.
038700     IF COND-WORD = 17 GO TO ONE-S-E-E.
           READ WO-EQUIP-HIER-FILE NEXT INTO EQUIP-HIER-BUFFER
               AT END    MOVE 15 TO COND-WORD.
           IF HIER-KEY NOT = TEST-SUB-ARG MOVE 15 TO COND-WORD.
           IF WEHF-STATUS NOT = "00" MOVE 15 TO COND-WORD.
039200     IF COND-WORD = 15 GO TO ONE-S-E-E.
039900     PERFORM ONE-SEARCH-ENTRY-CONT THRU ONE-S-E-C-E UNTIL
040000            COND-WORD = 15 OR LEVEL-SW = "Y".
040100 ONE-S-E-E.    EXIT.
040200
040300 ONE-SEARCH-ENTRY-CONT.
040400     IF SON-4-BUF = LEVEL1A
040500         MOVE "Y" TO LEVEL-SW
040600         GO TO ONE-S-E-C-E.
040700     READ WO-EQUIP-HIER-FILE NEXT INTO EQUIP-HIER-BUFFER
               AT END    MOVE 15 TO COND-WORD.
           IF HIER-KEY NOT = TEST-SUB-ARG MOVE 15 TO COND-WORD.
           IF WEHF-STATUS NOT = "00" MOVE 15 TO COND-WORD.
040900     IF COND-WORD = 0 OR 15
041000         NEXT SENTENCE
041100     ELSE
041300     MOVE "ERROR - PAR ONE-SEARCH-ENTRY-CONT" TO BU-DISPLAY-MSG
041500     PERFORM 998-BLOWUP.
041600 ONE-S-E-C-E.    EXIT.
041700
041800 ONE-LEVEL-LOCK.
042500     MOVE TYPENUM1 TO TEST-ARG1.
042600     MOVE LEVEL1 TO TEST-ARG2.
           MOVE 0 TO COND-WORD.
           MOVE TEST-SUB-ARG TO HIERKEY OF WEHFREC.
           START WO-EQUIP-HIER-FILE KEY IS = EXTERNALLY-DESCRIBED-KEY
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF WEHF-STATUS NOT = "00" MOVE 17 TO COND-WORD.
042900     IF COND-WORD NOT = 0 GO TO 2-EOJ.
043100     MOVE TYPENUM2 TO TEST-ARG1.
043200     MOVE LEVEL1A TO TEST-ARG2.
           MOVE 0 TO COND-WORD.
           MOVE TEST-SUB-ARG TO HIERKEY OF WEHFREC.
           START WO-EQUIP-HIER-FILE KEY IS = EXTERNALLY-DESCRIBED-KEY
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF WEHF-STATUS NOT = "00" MOVE 17 TO COND-WORD.
043500     IF COND-WORD NOT = 17 GO TO 2-EOJ.
043700     MOVE DIG-LEVEL TO TEST-ARG2.
043800     MOVE "N" TO LEVEL-SW.
043900     PERFORM ONE-SEARCH-ENTRY THRU ONE-S-E-E.
044000     IF LEVEL-SW = "Y"
044100         NEXT SENTENCE
044200     ELSE
044300     GO TO 2-EOJ.
044400 ONE-FIND-SUBS.
044500     MOVE TYPENUM1 TO EQP-TYPE-ARG.
044600     MOVE LEVEL1 TO FATH-ARG.
           MOVE 0 TO COND-WORD.
           MOVE TYPE-SUB-ARG TO HIERKEY OF WEHFREC.
           START WO-EQUIP-HIER-FILE KEY IS = EXTERNALLY-DESCRIBED-KEY
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF WEHF-STATUS NOT = "00" MOVE 17 TO COND-WORD.
044900     IF COND-WORD = 17 GO TO ONE-FS-EXIT.
045600     READ WO-EQUIP-HIER-FILE NEXT INTO EQUIP-HIER-BUFFER
045700         AT END    MOVE 15 TO COND-WORD.
           IF HIER-KEY NOT = TYPE-SUB-ARG MOVE 15 TO COND-WORD.
           IF WEHF-STATUS NOT = "00" MOVE 15 TO COND-WORD.
           IF COND-WORD = 15 GO TO ONE-FS-EXIT.
           ACCEPT IOFEEDBACK FROM I-O-FEEDBACK-AREA.
046500     PERFORM ONE-GET-SUBS THRU ONE-GET-SUBS-EXIT UNTIL
046600             COND-WORD = 15.
046700 ONE-FS-EXIT.   EXIT.
046800
046900 ONE-GET-SUBS.
047000     ADD 1 TO ADDRESS-SUB.
047100     MOVE IO-REL-NO TO REC-ADD (ADDRESS-SUB).
047200     READ WO-EQUIP-HIER-FILE NEXT INTO EQUIP-HIER-BUFFER
047300         AT END    MOVE 15 TO COND-WORD.
           IF HIER-KEY NOT = TYPE-SUB-ARG MOVE 15 TO COND-WORD.
           IF WEHF-STATUS NOT = "00" MOVE 15 TO COND-WORD.
047400     IF COND-WORD = 0
               ACCEPT IOFEEDBACK FROM I-O-FEEDBACK-AREA
047600     ELSE
           IF COND-WORD = 15
               NEXT SENTENCE
           ELSE
047800     MOVE "ERROR - PAR ONE-GET-SUBS" TO BU-DISPLAY-MSG
048000     PERFORM 998-BLOWUP.
048100 ONE-GET-SUBS-EXIT.    EXIT.
048200
048300 ONE-COPY-SUBS.
           MOVE 0 TO COND-WORD.
048400     ADD 1 TO ADDRESS-SUB.
048500     MOVE REC-ADD (ADDRESS-SUB) TO PFKEY.
048600     READ WO-EQUIP-HIER-FILE-2 INTO EQUIP-HIER-BUFFER
048700         INVALID KEY    MOVE 13 TO COND-WORD.
           IF WEHF2-STATUS NOT = "00" MOVE 13 TO COND-WORD.
048800     IF COND-WORD = 13 GO TO ONE-COPY-EXIT.
049500     MOVE TYPENUM2 TO EQP-TYPE-BUF.
049600     MOVE LEVEL1A TO FATH-4-BUF.
049700     MOVE SON-4-BUF TO DIG-LEVEL.
049800     MOVE 0 TO ZERO-COUNT.
049900     INSPECT DIG-LEVEL TALLYING ZERO-COUNT FOR ALL "0".
050000     IF ZERO-COUNT = 2 MOVE D2 TO SAVE-DIG.
050100     IF ZERO-COUNT = 1 MOVE D3 TO SAVE-DIG.
050200     IF ZERO-COUNT = 0 MOVE D4 TO SAVE-DIG.
050300     MOVE LEVEL1A TO DIG-LEVEL1.
050400     MOVE 0 TO ZERO-COUNT.
050500     INSPECT DIG-LEVEL1 TALLYING ZERO-COUNT FOR ALL "0".
050600     IF ZERO-COUNT = 3 MOVE SAVE-DIG TO D12.
050700     IF ZERO-COUNT = 2 MOVE SAVE-DIG TO D13.
050800     IF ZERO-COUNT = 1 MOVE SAVE-DIG TO D14.
050900     MOVE DIG-LEVEL1 TO SON-4-BUF.
           MOVE 0 TO COND-WORD.
051000     WRITE WEHFREC FROM EQUIP-HIER-BUFFER
051100         INVALID KEY    MOVE 17 TO COND-WORD.
           IF WEHF-STATUS NOT = "00" MOVE 17 TO COND-WORD.
051200     IF COND-WORD NOT = 0
051400         MOVE "ERROR - PAR ONE-COPY-SUBS" TO BU-DISPLAY-MSG
051600         PERFORM 998-BLOWUP.
051700 ONE-COPY-EXIT.   EXIT.
051800
051900**************************************************************
052000 LOWER-FIND-TYPENUM.
052100     MOVE TYPENUM1 TO TEST-ARG1.
052200     MOVE LEVEL2 TO TEST-ARG2.
           MOVE 0 TO COND-WORD.
           MOVE TEST-SUB-ARG TO HIERKEY OF WEHFREC.
           START WO-EQUIP-HIER-FILE KEY IS = EXTERNALLY-DESCRIBED-KEY
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF WEHF-STATUS NOT = "00" MOVE 17 TO COND-WORD.
052500     IF COND-WORD = 17
052600         MOVE 41008 TO CATREAD-MSG-NUMBER
052800         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MISC-BUFFER TO INPUT-ERR-LINE
052900         MOVE TRUE-VAL TO INDS (99)
053000         GO TO 6-MAIN.
053600     MOVE TYPENUM2 TO TEST-ARG1.
053700     MOVE LEVEL2A TO TEST-ARG2.
           MOVE 0 TO COND-WORD.
           MOVE TEST-SUB-ARG TO HIERKEY OF WEHFREC.
           START WO-EQUIP-HIER-FILE KEY IS = EXTERNALLY-DESCRIBED-KEY
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF WEHF-STATUS NOT = "00" MOVE 17 TO COND-WORD.
054000     IF COND-WORD = 0
054100         MOVE 40016 TO CATREAD-MSG-NUMBER
054300         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MISC-BUFFER TO INPUT-ERR-LINE
054400         MOVE TRUE-VAL TO INDS (99)
054500         GO TO 6-MAIN.
054600     IF COND-WORD = 17
054700         NEXT SENTENCE
054800     ELSE
055000     MOVE "ERROR - PAR LOWER-FIND-TYPENUM" TO BU-DISPLAY-MSG
055200     PERFORM 998-BLOWUP.
055300     MOVE TYPENUM1 TO EQP-TYPE-ARG.
055400**************************************************************
055500 ALL-FIND-TYPENUM.
057100     MOVE TYPENUM2 TO TEST-ARG1.
           MOVE "0000"   TO TEST-ARG2.
           MOVE 0 TO COND-WORD.
           MOVE TEST-SUB-ARG TO HIERKEY OF WEHFREC.
           START WO-EQUIP-HIER-FILE KEY IS = EXTERNALLY-DESCRIBED-KEY
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF WEHF-STATUS NOT = "00" MOVE 17 TO COND-WORD.
057400     IF COND-WORD = 0
057500         MOVE 40016 TO CATREAD-MSG-NUMBER
057700         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MISC-BUFFER TO INPUT-ERR-LINE
057800         MOVE TRUE-VAL TO INDS (99)
057900         GO TO 6-MAIN.
055600     MOVE TYPENUM1 TO TEST-ARG1.
055700     MOVE "0000" TO TEST-ARG2.
           MOVE 0 TO COND-WORD.
           MOVE TEST-SUB-ARG TO HIERKEY OF WEHFREC.
           START WO-EQUIP-HIER-FILE KEY IS = EXTERNALLY-DESCRIBED-KEY
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF WEHF-STATUS NOT = "00" MOVE 17 TO COND-WORD.
056000     IF COND-WORD = 17
056100         MOVE 41008 TO CATREAD-MSG-NUMBER
056300         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MISC-BUFFER TO INPUT-ERR-LINE
056400         MOVE TRUE-VAL TO INDS (99)
056500         GO TO 6-MAIN.
061000     MOVE TYPENUM1 TO EQP-TYPE-ARG.
061100 ALL-FIND-SUBS.
061200     ADD 1 TO FIND-KEY-SUB.
061300     IF KEY-TAB (FIND-KEY-SUB) = SPACES
061400         MOVE "Y" TO ALL-SUBS-FOUND-SW
061500         GO TO ALL-FS-EXIT
061600     ELSE
061700     MOVE KEY-TAB (FIND-KEY-SUB) TO FATH-ARG.
           MOVE 0 TO COND-WORD.
           MOVE TYPE-SUB-ARG TO HIERKEY OF WEHFREC.
           START WO-EQUIP-HIER-FILE KEY IS = EXTERNALLY-DESCRIBED-KEY
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF WEHF-STATUS NOT = "00" MOVE 17 TO COND-WORD.
062000     IF COND-WORD = 17 GO TO ALL-FS-EXIT.
062700     PERFORM ALL-GET-SUBS THRU ALL-GS-EXIT UNTIL
062800             COND-WORD = 15.
062900 ALL-FS-EXIT.    EXIT.
063000
063100 ALL-GET-SUBS.
           READ WO-EQUIP-HIER-FILE NEXT INTO EQUIP-HIER-BUFFER
               AT END    MOVE 15 TO COND-WORD.
           IF HIER-KEY NOT = TYPE-SUB-ARG MOVE 15 TO COND-WORD.
           IF WEHF-STATUS NOT = "00" MOVE 15 TO COND-WORD.
063400     IF COND-WORD = 15 GO TO ALL-GS-EXIT.
           ACCEPT IOFEEDBACK FROM I-O-FEEDBACK-AREA.
064100     ADD 1 TO ADDRESS-SUB.
064200     MOVE IO-REL-NO TO REC-ADD (ADDRESS-SUB).
064300     ADD 1 TO KEY-SUB.
064400     MOVE SON-SUB-BUF TO KEY-TAB (KEY-SUB).
064500 ALL-GS-EXIT.    EXIT.
064600
064700 ALL-COPY-SUBS.
           MOVE 0 TO COND-WORD.
064800     ADD 1 TO ADDRESS-SUB.
064900     MOVE REC-ADD (ADDRESS-SUB) TO PFKEY.
065000     READ WO-EQUIP-HIER-FILE-2 INTO EQUIP-HIER-BUFFER
065100         INVALID KEY   MOVE 13 TO COND-WORD.
           IF WEHF2-STATUS NOT = "00" MOVE 13 TO COND-WORD.
065200     IF COND-WORD = 13 GO TO ALL-COPY-EXIT.
065900     MOVE TYPENUM2 TO EQP-TYPE-BUF.
066000     IF LOWER-SW = "Y" PERFORM PARTIAL-LEVELS.
           MOVE 0 TO COND-WORD.
           WRITE WEHFREC FROM EQUIP-HIER-BUFFER
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF WEHF-STATUS NOT = "00" MOVE 17 TO COND-WORD.
066300     IF COND-WORD = 17
066500         MOVE "WRITE ERROR - PAR ALL-COPY-SUBS" TO BU-DISPLAY-MSG
066700         PERFORM 998-BLOWUP.
066800 ALL-COPY-EXIT.    EXIT.
066900
069400 PARTIAL-LEVELS.
069500     MOVE SON-4-BUF TO DIG-LEVEL.
069600     IF ZERO-COUNT = 3 MOVE D11 TO D1.
069700     IF ZERO-COUNT = 2 MOVE D11 TO D1
069800                  MOVE D12 TO D2.
069900     IF ZERO-COUNT = 1 MOVE D11 TO D1
070000                  MOVE D12 TO D2
070100                  MOVE D13 TO D3.
070200     MOVE DIG-LEVEL TO SON-4-BUF.
070300     MOVE FATH-4-BUF TO DIG-LEVEL.
070400     IF ZERO-COUNT = 3 MOVE D11 TO D1.
070500     IF ZERO-COUNT = 2 MOVE D11 TO D1
070600                  MOVE D12 TO D2.
070700     IF ZERO-COUNT = 1 MOVE D11 TO D1
070800                  MOVE D12 TO D2
070900                  MOVE D13 TO D3.
071000     MOVE DIG-LEVEL TO FATH-4-BUF.
071100 HELP-SESSION.
071200     MOVE "FHIERTYP2" TO VIEW-CFNAME.
071400     MOVE 0 TO VIEW-LASTKEY.
071500     PERFORM SHOW-READ UNTIL VIEW-LASTKEY = 1 OR 3.
071600     IF VIEW-LASTKEY = 3 GO TO HELP-SESSION-EXIT.
071700     MOVE "FHIERTYP3" TO VIEW-CFNAME.
071900     MOVE 0 TO VIEW-LASTKEY.
072000     PERFORM SHOW-READ UNTIL VIEW-LASTKEY = 1 OR 3.
072100 HELP-SESSION-EXIT.    EXIT.
072200
072300 SHOW-READ.
072400     PERFORM 99-SCREEN-WRITE.
072500     PERFORM 98-SCREEN-READ.

       98-SCREEN-READ.
           READ DISPLAY-FILE FORMAT IS VIEW-CFNAME
               INDIC IS INDICS.
           ACCEPT IOFEEDBACK FROM I-O-FEEDBACK-AREA.
           MOVE ALL B"0" TO INDICS.
           IF DSPLY-STATUS NOT = "00"
               MOVE 3 TO VIEW-LASTKEY
           ELSE
           MOVE FUNCTION-NUM TO VIEW-LASTKEY.

       98A-SCREEN-READ.
           READ DISPLAY-FILE TERMINAL IS TERMINAL-ID
               INDIC IS INDICS
                  NO DATA MOVE DSPLY-STATUS TO DSPLY-STATUS.
           MOVE ALL B"0" TO INDICS.

       99-SCREEN-WRITE.
           WRITE DSPLY-REC FORMAT IS VIEW-CFNAME
               INDIC IS INDICS.
           MOVE ALL B"0" TO INDICS.

296500 998-BLOWUP.
296600     MOVE "TTYPHIER" TO BU-PGM-NAME.
296700     CALL "TBLOWUP" USING BLOWUP-BASE BU-PGM-NAME STATUS-AREA
296800                      VIEW-COMAREA DUMMY-KSAM-STAT
296900                      BU-DISPLAY-MSG BU-DISPLAY-FLDS.
297000
073600 999-CATREAD.
073700     MOVE SPACES TO MISC-BUFFER.
073800     CALL "CCATREAD" USING CATREAD-PARMS.
073900     MOVE CATREAD-MSG-TEXT TO MISC-BUFFER.
074600 999-CATREAD-EXIT.    EXIT.
