000200 IDENTIFICATION DIVISION.
000300 PROGRAM-ID.    SONDOCK.
000500 AUTHOR.        JEFF BUNGO.
       DATE-WRITTEN.  SEPTEMBER 16, 1993.
       DATE-COMPILED.
000700*REMARKS.
000800*
000900*************************************************************
001000**                                                         **
001100**  THIS SUBROUTINE CALCULATES ONDOCK FOR A CORP CODE IN   **
001200**  STOREROOM UNIT OF MEASURE.  THE ONDOCK VALUE IS        **
001300**  CALCULATED BY SUMMING THE DIFFERENCE BETWEEN QTY       **
001400**  QTY RECEIVED AND QTY STORED ON EACH PO ITEM FOR A      **
001500**  GIVEN CORPORATE CODE.                                  **
001700**                                                         **
001800*************************************************************
      *C 06/10/96  JEFF BUNGO
      *C  EXPAND DATE FIELDS FOR YEAR 2000 COMPLIANCE.
      *C  RECOMPILE PROGRAM TO PICK UP NEW FILE FORMATS.
      *C
      *C 02/20/02  BRUCE GEISER
      *C  REMOVED ITEM COMPLETE FLAG CHECK. EVEN IF THE ITEM IS
      *C  COMPLETE, WE WANT TO KNOW HOW MUCH IS ON THE DOCK.
      *C
001800*************************************************************
002100
002200 ENVIRONMENT DIVISION.
002300 CONFIGURATION SECTION.
002400 SOURCE-COMPUTER.  HP-3000.
002500 OBJECT-COMPUTER.  HP-3000.
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT MSTORERM
                  ASSIGN TO DATABASE-MCFLCS0201
                  ORGANIZATION IS INDEXED
                    ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                  FILE STATUS IS FILE-STATUS.

           SELECT DPOITEM
                  ASSIGN TO DATABASE-MCFLCS1001
                  ORGANIZATION IS INDEXED
                    ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                    WITH DUPLICATES
                  FILE STATUS IS FILE-STATUS.
002700
002800 DATA DIVISION.
       FILE SECTION.
       FD  MSTORERM
           LABEL RECORDS ARE STANDARD.
       01  MSTORERM-REC.
           COPY DDS-MCRPCS0200  OF MCFLCS0201.

       FD  DPOITEM
           LABEL RECORDS ARE STANDARD.
       01  DPOITEM-REC.
           COPY DDS-MCRPCS1000  OF MCFLCS1001.

003000
003100 WORKING-STORAGE SECTION.
003200 77  QTY-STILL-ONDOCK             PIC S9(8)V9(4) VALUE ZEROS.
003300 77  QTY-ONDOCK                   PIC S9(8)      VALUE ZEROS.
004200
004300**************************************************************
004400**************************************************************
004500**                                                          **
004600**                DATABASE I/O BUFFER AREA                  **
004700**                                                          **
004800**************************************************************
004900**************************************************************
005000
005100 COPY MSTORERM IN COPYLIB.
005200
005300 COPY DPOITEM IN COPYLIB.
006700
006800 COPY DBMODES IN COPYLIB.
006900
       01  FILE-STATUS.
           05  FILE-STATUS-1            PIC X  VALUE "0".
           05  FILE-STATUS-2            PIC X  VALUE "0".

007800 LINKAGE SECTION.
007900
008000 01  BASE                         PIC X(10).
008100
008200 01  CODE-ARG                     PIC X(8).

       01  TOTAL-ONDOCK                 PIC S9(8).
008300
009100 COPY DBSTAT IN COPYLIB.
009200
009300 01  BU-DISPLAY-MSG.
009400     05  BU-DISPLAY-MSG-1         PIC X(1).
009500     05  FILLER                   PIC X(59).
009600
009700 01  BU-DISPLAY-FLDS.
009800     05  BU-DISPLAY-LINE  OCCURS 5 TIMES.
009900         10  BU-DISPLAY-FLD       PIC X(14).
010000         10  BU-DISPLAY-FLD9      PIC S9(8).
010100
010200
010300
010400 PROCEDURE DIVISION USING BASE,
010500                          CODE-ARG,
                                TOTAL-ONDOCK
010800                          STATUS-AREA,
010900                          BU-DISPLAY-MSG,
011000                          BU-DISPLAY-FLDS.
011100
011200 PROC-DIV SECTION 01.
011300
011400
011500 1-BEGIN.
           OPEN INPUT MSTORERM, DPOITEM.
011600     PERFORM 6-MAIN THRU 6-M-X.
           CLOSE MSTORERM, DPOITEM.
011800     GOBACK.
011900
012000
012100******************************************************
012200**                                                  **
012300**   BLOWUP ROUTINE                                 **
012400**                                                  **
012500******************************************************
012600
012700 2-BLOWUP.
012800     MOVE "SONDOCK"             TO  BU-DISPLAY-FLD (5).
012900     MOVE CODE-ARG              TO  BU-DISPLAY-FLD (4).
013000     GOBACK.
013100
013200
013300
013400**************************************************
013500*                                                *
013600*     6 - M A I N                                *
013700*                                                *
013800**************************************************
013900
014000
014100 6-MAIN.
014200     MOVE ZEROS                   TO  TOTAL-ONDOCK.
           MOVE 0 TO COND-WORD.
           MOVE CODE-ARG TO CORPCDE OF MSTORERM-REC.
           READ MSTORERM INTO BUF-MSTORERM
              INVALID KEY MOVE 17 TO COND-WORD.
           IF FILE-STATUS-1 = "2"
               MOVE 17 TO COND-WORD
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD.
014700     IF COND-WORD NOT = 0
014800         MOVE "GET MSTORERM 6-M" TO BU-DISPLAY-MSG
014900         GO TO 2-BLOWUP.
015000
015100     PERFORM 61-CALC-ONDOCK  THRU  61-CO-X.
015200
015300 6-M-X.
015400     EXIT.
015500
015600 61-CALC-ONDOCK.
           MOVE 0 TO COND-WORD.
           MOVE CODE-ARG TO CORPCDE OF DPOITEM-REC.
           START DPOITEM KEY = EXTERNALLY-DESCRIBED-KEY
             INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
                   MOVE 0 TO COND-WORD
                   GO TO 61-CO-X
               ELSE
                   MOVE 99 TO COND-WORD.
015900     IF COND-WORD NOT = 0
016000         MOVE "FIND DPOITEM 61-CO" TO BU-DISPLAY-MSG
016100         GO TO 2-BLOWUP.
016800
016900 61-GET-DPOITEM.
           MOVE 0 TO COND-WORD.
           READ DPOITEM NEXT INTO BUF-DPOITEM AT END
               MOVE 15 TO COND-WORD.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   MOVE 15 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.
           IF CORPCDE OF DPOITEM-REC NOT = CODE-ARG
               MOVE 15 TO COND-WORD.
017200     IF COND-WORD NOT = 0
017300         IF COND-WORD = 15
017400             GO TO 61-CO-X
017500         ELSE
017600             MOVE "GET DPOITEM  61-GD" TO BU-DISPLAY-MSG
017700             GO TO 2-BLOWUP.
017800
017900*****IF ITM-COMPLETE-FLAG > SPACE
018000*****    GO TO 61-GET-DPOITEM.

018200     IF ITM-QTY-DLVR > ITM-QTY-STORED
018300         NEXT SENTENCE
018400     ELSE
018500         GO TO 61-GET-DPOITEM.
018600
018700     SUBTRACT ITM-QTY-STORED  FROM  ITM-QTY-DLVR
018800         GIVING QTY-STILL-ONDOCK.
019000     IF ITM-UM = STR-UM
019100         MULTIPLY QTY-STILL-ONDOCK BY 1
                   GIVING QTY-ONDOCK ROUNDED
019200     ELSE
019300     IF ITM-UM = STR-UM1
019400         MULTIPLY QTY-STILL-ONDOCK BY  STR-UM1-CF
019500             GIVING  QTY-ONDOCK ROUNDED
019600     ELSE
019700     IF ITM-UM = STR-UM2
019800         MULTIPLY QTY-STILL-ONDOCK BY  STR-UM2-CF
019900             GIVING  QTY-ONDOCK ROUNDED
020000     ELSE
020100         MOVE "PO UM NOT VALID FOR CODE" TO BU-DISPLAY-MSG
020200         MOVE ITM-PO-RCV-NO       TO  BU-DISPLAY-FLD (3)
020300         GO TO 2-BLOWUP.
020400
020500     ADD QTY-ONDOCK               TO  TOTAL-ONDOCK.
020800
020900     GO TO 61-GET-DPOITEM.
021000
021100 61-CO-X.
021200     EXIT.
