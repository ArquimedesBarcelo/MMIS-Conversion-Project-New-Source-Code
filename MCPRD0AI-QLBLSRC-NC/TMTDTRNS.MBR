054700**************************************************
054800     IF SORT-TRANS-CODE = "ISS" OR "RET"
054900         IF SORT-CLASS > 099 AND SORT-CLASS < 200  OR
055000            SORT-CLASS > 399 AND SORT-CLASS < 500
055100               MOVE SORT-ACT-VALUE TO PRT-ACT
055200               COMPUTE HOLD-VAR = SORT-VALUE - SORT-ACT-VALUE
055300               MOVE HOLD-VAR      TO PRT-VAR.
055400
055500     IF SORT-TRANS-CODE = "ISS" OR "RET"
055600         IF SORT-CLASS > 099 AND SORT-CLASS < 200  OR
055700            SORT-CLASS > 399 AND SORT-CLASS < 500
055800             MOVE "904"           TO PRT-VAR-EXP
055900             MOVE "-"             TO PRT-HYPHEN
056000             MOVE SORT-CLASS      TO SVARDEPT-MATL-CLASS
056100             CALL "SVARDEPT" USING ACCTG-BASE,
056200                                   SVARDEPT-PARMS,
056300                                   STATUS-AREA,
056400                                   BU-DISPLAY-MSG,
056500                                   BU-DISPLAY-FLDS
056600             IF BU-DISPLAY-MSG NOT = SPACES
056700                 PERFORM 990-BLOWUP
056800             ELSE
056900                 MOVE SVARDEPT-DEPT-CLASS-VAR TO PRT-VAR-DEPT.
057000
057100     IF SORT-TRANS-CODE = "INV"
057200         IF SORT-DEPT = SAVE-STR-DEPT
057300             ADD SORT-QTY         TO MATL-INV-QTY
057400             ADD SORT-VALUE       TO MATL-INV-VALUE.
057500
057600     IF SORT-TRANS-CODE = "ISS"
057700         ADD SORT-QTY             TO MATL-ISS-RET-QTY
057800         ADD SORT-VALUE           TO MATL-ISS-RET-VALUE
057900         ADD SORT-ACT-VALUE       TO MATL-ISS-RET-ACT
058000         ADD HOLD-VAR             TO MATL-ISS-RET-VAR
058100     ELSE
058200         IF SORT-TRANS-CODE = "RET"
058300             SUBTRACT SORT-QTY    FROM MATL-ISS-RET-QTY
058400             SUBTRACT SORT-VALUE  FROM MATL-ISS-RET-VALUE
058500             SUBTRACT SORT-ACT-VALUE FROM MATL-ISS-RET-ACT
058600             SUBTRACT HOLD-VAR    FROM MATL-ISS-RET-VAR.
058700     MOVE SORT-ORDER-NUM          TO PRT-PO.
058800     IF SORT-ORDER-NUM NOT = SPACES
058900         MOVE "-"                 TO PRT-HYPHEN2
059000     ELSE
059100         MOVE SPACES              TO PRT-HYPHEN2.
059200     MOVE SORT-RELEASE            TO PRT-RELEASE.
059300     MOVE SORT-RCVR-NUM           TO PRT-RCVR.
059400     MOVE SORT-ITEM-NUM           TO PRT-ITEM.
059500     MOVE SORT-UNIT-MEASURE       TO PRT-UM.
059600     MOVE SORT-ACCT               TO PRT-ACCT.
059700     MOVE SORT-DEPT               TO PRT-DEPT.
059800     MOVE 4                       TO DATE-MODE.
059900     MOVE SORT-DATE               TO DATE-VALIDATE-IN.
060000     CALL "TDATECHK" USING DATE-CHECK-AREA.
060100     MOVE DATE-SLASH-OUT          TO PRT-DATE.
060200     MOVE SORT-DOCUMENT-NUM       TO PRT-DOCUMENT.
060300     WRITE PRT-REC FROM DETAIL-LINE AFTER 1.
060400     ADD 1                        TO LINE-CNT.
060500     MOVE SPACES                  TO PRT-REC
060600                                     DETAIL-LINE.
060700     MOVE ZERO                    TO HOLD-VAR.
060800
060900     RETURN SORT-FILE
061000        AT END
061100             MOVE "YES" TO NO-MORE-SORT.
061200
061300     IF LINE-CNT > 55
061400         IF SORT-MATL-CODE NOT = PREV-MATL-CODE
061500             NEXT SENTENCE
061600         ELSE
061700             PERFORM 750-PRINT-HEADINGS
061800             MOVE SPACES          TO PRT-REC
061900             WRITE PRT-REC AFTER 1
062000             ADD 1                TO LINE-CNT.
062100
062200 723-END-MATL-CODE.
062300     MOVE "INVOICE TOTALS"        TO TOTAL-LITERAL.
062400     MOVE MATL-INV-QTY            TO INV-QTY-PRT.
062500     MOVE MATL-INV-VALUE          TO INV-VALUE-PRT.
062600     MOVE 0                       TO MATL-INV-QTY
062700                                     MATL-INV-VALUE.
062800     WRITE PRT-REC FROM TOTAL-LINE AFTER 2.
062900     MOVE SPACES                  TO PRT-REC
063000                                     TOTAL-LINE.
063100     MOVE "PRIOR MTH END BAL"     TO TOTAL-LITERAL.
063200     PERFORM 760-GET-MMATL-ACCUM.
063300     MOVE MATL-BEG-BAL-DOLLARS    TO INV-VALUE-PRT.
063400     MOVE MATL-BEG-BAL-UNITS      TO INV-QTY-PRT.
063500     WRITE PRT-REC FROM TOTAL-LINE AFTER 1.
063600     MOVE SPACES                  TO PRT-REC
063700                                     TOTAL-LINE.
063800     MOVE MATL-ISS-RET-QTY        TO INV-QTY-PRT.
063900     MOVE MATL-ISS-RET-VALUE      TO INV-VALUE-PRT.
064000     MOVE MATL-ISS-RET-ACT        TO INV-ACT-PRT.
064100     MOVE MATL-ISS-RET-VAR        TO INV-VAR-PRT.
064200     MOVE "ISSUE/RETURN TOT"      TO TOTAL-LITERAL.
064300     WRITE PRT-REC FROM TOTAL-LINE AFTER 1.
064400     MOVE SPACES                  TO PRT-REC
064500                                     TOTAL-LINE.
064600     ADD 4                        TO LINE-CNT.
064700     IF LINE-CNT > 52
064800         PERFORM 750-PRINT-HEADINGS.
064900
065000
065100 750-PRINT-HEADINGS.
065200*************************************************
065300**   IF PRINT-FILE-CTR > 100 THEN CLOSE AND
065400**   REOPEN THE PRINT FILE SO WE DONT GET INTO
065500**   SPOOLFILE SIZE PROBLEMS.
065600*************************************************
065700     ADD 1                        TO PRINT-FILE-CTR.
065800     IF PRINT-FILE-CTR > 100
065900         MOVE ZEROS               TO PRINT-FILE-CTR
066000         CLOSE ONLINE-PRT
066100         OPEN OUTPUT ONLINE-PRT.
