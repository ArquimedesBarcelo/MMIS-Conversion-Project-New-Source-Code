028000
028100 COPY TBLOWUP IN COPYLIB.
028300
028400 PROCEDURE DIVISION.
028500
028600 001-BEGIN SECTION.
028700
028800 010-MAINLINE.
           MOVE "C" TO MCXCBLERR-SCOPE.
           CALL "MCXCBLERR" USING MCXCBLERR-SCOPE.

028900*******************************************************
029000**   CALL 'CBLOWSRT' FIRST BEFORE GOING INTO THE
029100**   SORT VERB.  THE FIRST CALL TO 'CBLOWSRT' OPENS
029200**   UP A NEW TEMPORARY FILE 'BLUPDATA' THAT IS USED
029300**   TO WRITE THE BLOWUP INFORMATION IF A BLOWUP
029400**   OCCURS
029500*******************************************************
029600
029700     CALL "CBLOWSRT" USING CBLOWSRT-PARMS,
029800                           ACCTG-BASE,
029900                           BU-PGM-NAME,
030000                           STATUS-AREA,
030100                           DUMMY-VIEW-AREA,
030200                           FILE-STATUS,
030300                           BU-DISPLAY-MSG,
030400                           BU-DISPLAY-FLDS.
030500
030600     SORT SORT-FILE ON ASCENDING KEY SORT-CLASS
030700                                     SORT-MATL-CODE
030800                                     SORT-DATE-CN
030900         INPUT PROCEDURE IS 050-PROCESS-TRANS
031000         OUTPUT PROCEDURE IS 700-CREATE-REPORT.
031100     PERFORM 1000-CLOSE-FILES.
031200     GOBACK.
031300
031500 050-PROCESS-TRANS SECTION.
       050-PROCESS-TRANS-PARA.
031600     PERFORM 100-BEGIN.
031700     PERFORM 200-PROCESS-DETAIL
031800         UNTIL END-OF-FILE.
031900
032000**********************************************************
032100*  TRANSFER CONTROL TO LAST STATEMENT IN INPUT PROCEDURE *
032200*  FOR SORTING OF RECORDS.                               *
032300**********************************************************
032400
032500     GO TO 699-PROCESS-EXIT.
032600
032700 100-BEGIN.
           PERFORM 9999-OPEN-STUFF.
034700
034800     MOVE SPACES                  TO SVARDEPT-PARMS.
034900     CALL "SVARDEPT" USING ACCTG-BASE,
035000                           SVARDEPT-PARMS,
035100                           STATUS-AREA,
035200                           BU-DISPLAY-MSG,
035300                           BU-DISPLAY-FLDS.
035400     IF BU-DISPLAY-MSG NOT = SPACES
035500         PERFORM 990-BLOWUP.
035600
035700****************************************************
035800**   GET STOREROOM DEPT FROM MACCOUNT-INFO        **
035900**   KEY IS EQUAL TO 'SDPT'.  THE STOREROOM DEPT. **
036000**   IS USED WHEN PROCESSING RECEIVING AND        **
036100**   RECEIPT INTO STOREROOM TCs (323, 324, 325)   **
036200****************************************************
036300
036400     MOVE "SDPT"                  TO MACCT-KEY.
           PERFORM 9999-DBGET7-MACCOUNT-INFO-IK-I.
037200     IF GOOD-CALL
037300         MOVE MACCT-STR-DEPT      TO  SAVE-STR-DEPT
037400     ELSE
037500         MOVE "GET MACCOUNT-INFO 'SDPT'* 100-B"
037600               TO BU-DISPLAY-MSG
037700         MOVE MACCT-KEY           TO  BU-DISPLAY-FLD (1)
037800         PERFORM 990-BLOWUP.
037900
038000     MOVE "MY"                    TO MACCT-KEY.
           PERFORM 9999-DBGET7-MACCOUNT-INFO-IK-I.
038800     IF GOOD-CALL
038900         MOVE MACCT-MONTH         TO MONTH-PARM
039000         MOVE MACCT-YEAR          TO YEAR-PARM
039100     ELSE
039200         MOVE "GET MACCOUNT-INFO MY* 100-B" TO BU-DISPLAY-MSG
039300         MOVE MACCT-KEY TO BU-DISPLAY-FLD (1)
039400         PERFORM 990-BLOWUP.
039500
039600     MOVE SPACES                  TO SORT-REC.
039700     MOVE 0                       TO SORT-VALUE
039800                                     SORT-QTY.
           PERFORM 9999-INIT-DTRANS-MC-I.
039900     PERFORM 400-GET-DTRANS.
040000
040200 200-PROCESS-DETAIL.
040300     IF TRANS-DOCUMENT-NUM = "PROC"
040400         NEXT SENTENCE
040500     ELSE
040600         PERFORM 600-BUILD-SORT-REC.
040700     PERFORM 400-GET-DTRANS.
040800
040900 400-GET-DTRANS.
           PERFORM 9999-DBGET2-DTRANS-MC-I.
041700     IF GOOD-CALL
041800         NEXT SENTENCE
041900     ELSE
042000         IF END-OF-FILE
042100             NEXT SENTENCE
042200         ELSE
042300             MOVE "DBGET DTRANS * 400-GD" TO BU-DISPLAY-MSG
042400             PERFORM 990-BLOWUP.
042500
042600
042700 600-BUILD-SORT-REC.
042800     MOVE TRANS-STORES-CODE       TO SORT-MATL-CODE
042900                                     MATL-CODE-ARG.
043000     MOVE TRANS-CLASS             TO SORT-CLASS.
043100     MOVE TRANS-DEPT              TO SORT-DEPT.
043200     MOVE TRANS-ACCT              TO SORT-ACCT.
043300     MOVE TRANS-PO-NUM            TO SORT-PO-NUM.
043400     MOVE TRANS-RCVR-NUM          TO SORT-RCVR-NUM
043500     MOVE TRANS-ITEM-NUM          TO SORT-ITEM-NUM.
043600     MOVE TRANS-CODE              TO SORT-TRANS-CODE4.
043700     MOVE TRANS-DATE-CN           TO SORT-DATE-CN.
043800     MOVE TRANS-DOCUMENT-NUM      TO SORT-DOCUMENT-NUM.
043900     MOVE TRANS-UNIT-MEASURE      TO SORT-UNIT-MEASURE.
044000     MOVE TRANS-QTY               TO SORT-QTY.
044100     MOVE TRANS-VALUE             TO SORT-VALUE.
044200
044300****************************************************
044400**   IF RAW MATERIAL CALCULATE ACTUAL COST USING
044500**   AVG. COST SINCE THE TRANS-VALUE IS IN TERMS
044600**   OF STD. COST
044700****************************************************
044800     IF TRANS-CLASS > 099 AND TRANS-CLASS < 200 OR
044900        TRANS-CLASS > 399 AND TRANS-CLASS < 500
045000         PERFORM 650-GET-MSTORERM
045100         COMPUTE SORT-ACT-VALUE = TRANS-QTY *
045200                                  STR-AVG-COST
045300     ELSE
045400         MOVE 0                   TO SORT-ACT-VALUE.
045500     RELEASE SORT-REC.
045600     MOVE SPACES                  TO SORT-REC.
045700     MOVE 0                       TO SORT-QTY
045800                                     SORT-ACT-VALUE
045900                                     SORT-VALUE.
046000
046100 650-GET-MSTORERM.
           PERFORM 9999-DBGET7-MSTORERM-CD-I.
046900     IF GOOD-CALL
047000         NEXT SENTENCE
047100     ELSE
047200         IF NO-ENTRY
047300             MOVE 0               TO STR-AVG-COST
047400         ELSE
047500             MOVE "DBGET MSTORERM * 650-GM" TO BU-DISPLAY-MSG
047600             MOVE MATL-CODE-ARG TO BU-DISPLAY-FLD (1)
047700             PERFORM 990-BLOWUP.
047800
047900
048000 699-PROCESS-EXIT.
048100     EXIT.
048200
048300
048400 700-CREATE-REPORT SECTION.
       700-CREATE-REPORT-PARA.
048500     DISPLAY "BEGIN REPORT".
048600     PERFORM 710-BEGIN-REPORT.
048700     PERFORM 720-PROCESS-MATL-CODE
048800         UNTIL NO-MORE-SORT = "YES".
048900
049000**************************************************
049100**  BRANCH TO LAST STATEMENT OF OUTPUT SECTION  **
049200**  TO COMPLETE PROCESSING OF REPORT            **
049300**************************************************
049400
049500     GO TO 799-CREATE-EXIT.
049600
049700 710-BEGIN-REPORT.
049800     OPEN OUTPUT ONLINE-PRT.
049900     RETURN SORT-FILE
050000        AT END
050100            MOVE "YES" TO NO-MORE-SORT.
050200     MOVE SPACES                  TO TOTAL-LINE.
050300     PERFORM 750-PRINT-HEADINGS.
050400
050500 720-PROCESS-MATL-CODE.
050600     PERFORM 721-BEGIN-MATL-CODE.
050700     PERFORM 722-PROCESS-TRANS
050800         UNTIL SORT-MATL-CODE NOT = PREV-MATL-CODE
050900                OR SORT-CLASS NOT = PREV-CLASS
051000                OR NO-MORE-SORT = "YES".
051100     PERFORM 723-END-MATL-CODE.
051200
051300 721-BEGIN-MATL-CODE.
051400     MOVE SORT-CLASS              TO PREV-CLASS.
051500     MOVE SORT-MATL-CODE          TO PREV-MATL-CODE.
051600     MOVE 0                       TO MATL-INV-QTY
051700                                     MATL-INV-VALUE
051800                                     MATL-ACT-VALUE
051900                                     MATL-VAR-VALUE
052000                                     MATL-ISS-RET-QTY
052100                                     MATL-ISS-RET-VALUE
052200                                     MATL-ISS-RET-ACT
052300                                     MATL-ISS-RET-VAR.
052400     IF SORT-MATL-CODE = "NON-STR"
052500         MOVE "NON-STOREROOM ITEM" TO MATL-DESCR-HDG
052600     ELSE
052700         MOVE 1                   TO CDESC-LINES-TO-GET
052800         MOVE "N"                 TO CDESC-LOCAL-DESC-OPTION
