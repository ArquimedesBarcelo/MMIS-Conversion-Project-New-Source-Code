070500
070600 990-BLOWUP.
070700
070800***************************************************************
070900**   CALL 'CBLOWSRT' INSTEAD OF 'TBLOWUP' WHEN A BLOWUP      **
071000**   SITUATION OCCURS SINCE THIS PROGRAM USES THE 'SORT'     **
071100**   VERB.  'CBLOWSRT' WRITES ALL THE BLOWUP INFORMATION     **
071200**   TO A TEMPORARY FILE 'BLUPDATA' (WHICH WAS OPENED AT     **
071300**   THE BEGINNING OF THE PROGRAM) THE CLOSES IT. THEN IT    **
071400**   CREATESA A SON PROCESS 'XBLOWSRT' THAT READS THE        **
071500**   BLOWUP INFORMATION OUT OF 'BLUPDATA' AND CALLS          **
071600**   'TBLOWUP' USING THIS INFO.  SINCE THE NEW PROCESS       **
071700**   'XBLOWSRT' HAS ITS OWN STACK THE STACK OVERFLOW         **
071800**   PROBLEM IS AVOIDED.                                     **
071900***************************************************************
072000
072100     MOVE "TMTDTRNS"              TO  BU-PGM-NAME.
072200     CALL "CBLOWSRT" USING CBLOWSRT-PARMS,
072300                           ACCTG-BASE,
072400                           BU-PGM-NAME,
072500                           STATUS-AREA,
072600                           DUMMY-VIEW-AREA,
072700                           FILE-STATUS,
072800                           BU-DISPLAY-MSG,
072900                           BU-DISPLAY-FLDS.
073000
073100
073200
073300
073400
073500 1000-CLOSE-FILES.
073600     CLOSE ONLINE-PRT.
           PERFORM 9999-CLOSE-STUFF.

       9999-DBGET7-MACCOUNT-INFO-IK-I.
           MOVE 0 TO COND-WORD.
           MOVE MACCT-KEY TO INFOKEY OF MACCOUNT-INFO-IK-REC-I.
           READ MACCOUNT-INFO-IK-I INTO BUF-MACCT-INFO
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS = "23"
               MOVE 17 TO COND-WORD
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD.

       9999-DBGET2-DTRANS-MC-I.
           MOVE 0 TO COND-WORD.
           READ DTRANS-MC-I NEXT INTO BUF-DTRANS
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS-1 = "1" OR FILE-STATUS = "46"
               MOVE 11 TO COND-WORD
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD.

       9999-INIT-DTRANS-MC-I.
           MOVE SPACES TO MATLCODE OF DTRANS-MC-REC-I.
           START DTRANS-MC-I KEY >= MATLCODE OF DTRANS-MC-REC-I
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.

       9999-DBGET7-MSTORERM-CD-I.
           MOVE 0 TO COND-WORD.
           MOVE MATL-CODE-ARG TO CORPCDE OF MSTORERM-CD-REC-I.
           READ MSTORERM-CD-I INTO BUF-MSTORERM
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS = "23"
               MOVE 17 TO COND-WORD
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD.

       9999-DBGET7-MMATL-ACCUM-MC-I.
           MOVE 0 TO COND-WORD.
           MOVE MATL-CODE-ARG TO MATLCODE OF MMATL-ACCUM-MC-REC-I.
           READ MMATL-ACCUM-MC-I INTO BUF-MATLACUM
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS = "23"
               MOVE 17 TO COND-WORD
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD.

       9999-OPEN-STUFF.
           OPEN INPUT MACCOUNT-INFO-IK-I   .
           OPEN INPUT DTRANS-MC-I          .
           OPEN INPUT MSTORERM-CD-I        .
           OPEN INPUT MMATL-ACCUM-MC-I     .

       9999-CLOSE-STUFF.
           CLOSE      MACCOUNT-INFO-IK-I   .
           CLOSE      DTRANS-MC-I          .
           CLOSE      MSTORERM-CD-I        .
           CLOSE      MMATL-ACCUM-MC-I     .
