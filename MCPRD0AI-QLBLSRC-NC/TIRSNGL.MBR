077300
077400 64-UPDATE-DDAILYTC.
      *------5/2/97 BUILD OWNER/QTY TABLE FOR WITHDRAWLS
           IF SCOM-PGM-KEY = "SW1"
            MOVE 0 TO MAX-OWNRS
            INITIALIZE OWNER-TABLE
            PERFORM VARYING SUB FROM 1 BY 1
             UNTIL SUB > 6
               IF DE-QTY(SUB) > 0
                   SET OWNR-IDX TO 1
                   SEARCH OWNER-ENTRY
                     AT END
                        ADD 1 TO MAX-OWNRS
                        MOVE DE-FRAN(SUB) TO OWNR(MAX-OWNRS)
                        IF DE-QTY-X(SUB) NUMERIC
                            MOVE DE-QTY(SUB)  TO OWNR-QTY(MAX-OWNRS)
                        ELSE
                            MOVE ZEROS        TO OWNR-QTY(MAX-OWNRS)
                        END-IF
                     WHEN OWNR(OWNR-IDX) = DE-FRAN(SUB)
                        IF MAX-OWNRS = 0
                            MOVE 1 TO MAX-OWNRS
                        END-IF
                        MOVE OWNR-IDX TO CURR-OWNR
                        IF DE-QTY-X(SUB) NUMERIC
                            IF OWNR-QTY(CURR-OWNR) NUMERIC
                                ADD DE-QTY(SUB) TO OWNR-QTY(CURR-OWNR)
                            ELSE
                                MOVE DE-QTY(SUB) TO OWNR-QTY(CURR-OWNR)
                            END-IF
                        END-IF
                   END-SEARCH
              END-IF
            END-PERFORM
           END-IF.

077500     MOVE 10                       TO  SAVE-PARA-NUMBER.
077600     IF DE-EXP-CLASS = "000000"
077700         MOVE SPACES               TO  DE-EXP-CLASS.
077800
