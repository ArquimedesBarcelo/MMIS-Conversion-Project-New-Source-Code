078100     MOVE DATE-UNFORMATTED-TIME-OUT TO  DDAILYTC-TIME.
078200     MOVE SRF-MPLTINFO-COMPANY     TO  DDAILYTC-PLT.
078300     IF SCOM-PGM-KEY = "SW1"
      *--------5/2/97 WRITE TC FOR EACH OWNER/QTY
            PERFORM VARYING SUB FROM 1 BY 1 UNTIL SUB > MAX-OWNRS
078400       IF STR-AVG-COST > 99999.9999
078500         MOVE "433"                TO  DDAILYTC-TC
078600         MOVE CODE-ARG             TO  TC433-CORPCODE
078700         MOVE DE-EMPL              TO  TC433-EMP
               MOVE OWNR-QTY(SUB)        TO  TC433-QTY
               PERFORM 900-GET-FRAN-ID THRU 900-GET-FRAN-ID-X
               MOVE HOLD-FRAN-ID         TO  TC433-FRAN-ID
078800*        MOVE QEDIT-TOTAL-QTY      TO  TC433-QTY
      *----------GOODYEAR OWNED USES AVG COST
      *----------FRANCHISE OWNED USES MKT COST
               IF STR-CODE-OWNER NOT = SPACES
                 IF HOLD-FRAN-ID NOT = STR-CODE-OWNER
                     MOVE STR-AVG-COST     TO  TC433-AVG-COST
                 ELSE
                     MOVE STR-MKT-COST     TO  TC433-AVG-COST
                 END-IF
               ELSE
                 MOVE STR-AVG-COST         TO  TC433-AVG-COST
               END-IF
079000         MOVE STR-UM               TO  TC433-UM
079100         MOVE DE-CHARGE-DEPT       TO  TC433-DEPARTMENT
079200         MOVE DE-WO                TO  TC433-WO
079300         MOVE DE-WORK-CENTER       TO  TC433-WORK-CENTER
079400         MOVE DE-EXP-CLASS         TO  TC433-EXP-CLASS
079500         MOVE DE-REQ-DEPT          TO  TC433-REQ-DEPT
079600         MOVE STR-CLASS            TO  TC433-CLASS
079700       ELSE
079800         MOVE "333"                TO  DDAILYTC-TC
079900         MOVE CODE-ARG             TO  TC333-CORPCODE
080000         MOVE DE-EMPL              TO  TC333-EMP
               MOVE OWNR-QTY(SUB)        TO  TC333-QTY
               PERFORM 900-GET-FRAN-ID THRU 900-GET-FRAN-ID-X
               MOVE HOLD-FRAN-ID         TO  TC333-FRAN-ID
080100         MOVE QEDIT-TOTAL-QTY      TO  TC333-QTY
               MOVE STR-AVG-COST         TO  TC333-AVG-COST
      *----------GOODYEAR OWNED USES AVG COST
      *----------FRANCHISE OWNED USES MKT COST
               IF STR-CODE-OWNER NOT = SPACES
                 IF HOLD-FRAN-ID NOT = STR-CODE-OWNER
                     MOVE STR-AVG-COST     TO  TC333-AVG-COST
                 ELSE
                     MOVE STR-MKT-COST     TO  TC333-AVG-COST
                 END-IF
               ELSE
                 MOVE STR-AVG-COST         TO  TC333-AVG-COST
               END-IF
080300         MOVE STR-UM               TO  TC333-UM
080400         MOVE DE-CHARGE-DEPT       TO  TC333-DEPARTMENT
080500         MOVE DE-WO                TO  TC333-WO
080600         MOVE DE-WORK-CENTER       TO  TC333-WORK-CENTER
080700         MOVE DE-EXP-CLASS         TO  TC333-EXP-CLASS
080800         MOVE DE-REQ-DEPT          TO  TC333-REQ-DEPT
080900         MOVE STR-CLASS            TO  TC333-CLASS
             END-IF
            END-PERFORM
081000     ELSE
081100       IF STR-AVG-COST > 99999.9999
081200         MOVE "430"                TO  DDAILYTC-TC
081300         MOVE CODE-ARG             TO  TC430-CORPCODE
081400         MOVE DE-EMPL              TO  TC430-EMP
081500         MOVE QEDIT-TOTAL-QTY      TO  TC430-QTY
081600         MOVE STR-AVG-COST         TO  TC430-AVG-COST
081700         MOVE STR-UM               TO  TC430-UM
081800         MOVE DE-CHARGE-DEPT       TO  TC430-DEPARTMENT
081900         MOVE DE-WO                TO  TC430-WO
082000         MOVE DE-WORK-CENTER       TO  TC430-WORK-CENTER
082100         MOVE DE-EXP-CLASS         TO  TC430-EXP-CLASS
082200         MOVE DE-REQ-DEPT          TO  TC430-REQ-DEPT
082300         MOVE STR-CLASS            TO  TC430-CLASS
082400       ELSE
082500         MOVE "330"                TO  DDAILYTC-TC
082600         MOVE CODE-ARG             TO  TC330-CORPCODE
082700         MOVE DE-EMPL              TO  TC330-EMP
082800         MOVE QEDIT-TOTAL-QTY      TO  TC330-QTY
082900         MOVE STR-AVG-COST         TO  TC330-AVG-COST
083000         MOVE STR-UM               TO  TC330-UM
083100         MOVE DE-CHARGE-DEPT       TO  TC330-DEPARTMENT
083200         MOVE DE-WO                TO  TC330-WO
083300         MOVE DE-WORK-CENTER       TO  TC330-WORK-CENTER
083400         MOVE DE-EXP-CLASS         TO  TC330-EXP-CLASS
083500         MOVE DE-REQ-DEPT          TO  TC330-REQ-DEPT
083600         MOVE STR-CLASS            TO  TC330-CLASS.
083700
083800     MOVE DSET-DDAILYTC            TO  DSET-NAME.
083900     PERFORM 9999-DSET-LOCK.
084000
084100     PERFORM 9999-PUT-DDAILYTC-DT-O.
084200
084300     PERFORM 9999-UNLOCK.
084400
      *--------- SEND USER NOTIFICATION MESSAGE IF SPECIFIED IN
      *--------- MCFPCSUSER.
           IF SCOM-PGM-KEY = "SW1"
               IF USER-FILE-EXISTS = "Y"
                   PERFORM 900-SEND-MESSAGE.

084500*********************************************************
084600**  PRINT A RECORD OF THE SINGLE ISSUE TO LOCAL PRINTER *
084700*********************************************************
           IF PRINT-SINGLE-ISS-FLAG NOT = "N"
084800         CALL "CIRPRNT" USING SCOM-PGM-KEY, MULTIPLE-STR-DATA,
084900           SRF-COMAREA, SRF-SPOOLER-REC, DE-CHARGE-DATA,
085000           BUF-MSTORERM, DATA-ENTRY-AREA, CDESC (1), CDESC (2),
085100           ESC-NAME, DATE-CHECK-AREA.
085200
085300 66-UPDATE-MMIS.
085400     MOVE 14                       TO  SAVE-PARA-NUMBER.
085500     IF DE-WO = SPACES
085600         GO TO 61-GET-IR-FORM.
085700
085800     MOVE SPACES                   TO  PART-WORKAREA.
085900     MOVE DE-WO                    TO  WO-NUMBER.
086000     MOVE CODE-ARG                 TO  STORES-CODE.
086100     MOVE QEDIT-TOTAL-QTY          TO  ISSUED-QTY.
086200     IF SCOM-PGM-KEY = "ST1"
086300         MULTIPLY -1         BY  QTY-ISSUED.
086400     MOVE STR-AVG-COST             TO  AVG-COST.
086500     MOVE V-KWRD-ADJ               TO  STORES-DESC.
086600     MOVE DE-EMPL                  TO  EMPLOYEE-ID.
086700     MOVE STR-UM                   TO  UNIT-OF-MEAS.
086800
086900     CALL "ISSPARTS" USING PART-WORKAREA
087000                           MMIS-BASE
087100                           LANGUAGE-PARMS
087200                           BUDGET-MESSAGE.
087300
087400     GO TO 61-GET-IR-FORM.
087500
087600 6-MAIN-X.
087700     PERFORM 5-CLEAR-FORM.
087800     PERFORM 9999-CLOSE-STUFF.
087900     IF BANBURY-CORR-FLAG EQUAL "Y"
088000       PERFORM 9999-DELETE-OVERRIDE-FORM-FILE.
088100
088200     GOBACK.
088300
       9999-OPEN-STUFF.
           OPEN I-O   MSTORERM-CD-O        .
           OPEN I-O   DDAILYTC-DT-O        .
           OPEN I-O   DISPLAY-FILE         .

           OPEN INPUT USER-I.
           IF FILE-STATUS NOT = "00"
               MOVE "N" TO USER-FILE-EXISTS
           ELSE
               MOVE "Y" TO USER-FILE-EXISTS.

       9999-CLOSE-STUFF.
           CLOSE      MSTORERM-CD-O        .
           CLOSE      DDAILYTC-DT-O        .
           CLOSE      DISPLAY-FILE         .
           CLOSE      USER-I.

       9999-OVERRIDE-FORM-FILE.
           MOVE "OVRDSPF FILE(ZUDCSTR) TOFILE(ZRMCORR)" TO
             COMMAND-WORK.
           CALL "QCMDEXC" USING COMMAND-WORK, COMMAND-LEN.

       9999-DELETE-OVERRIDE-FORM-FILE.
           MOVE "DLTOVR FILE(ZUDCSTR)" TO COMMAND-WORK.
           CALL "QCMDEXC" USING COMMAND-WORK, COMMAND-LEN.

088500 COPY HCATREAD   IN COPYLIB.
088600 COPY SCRNCALL   IN COPYLIB.
       9999-GETBUFFER-1.
           MOVE DISPLAY-REC TO DE-FIELDS-1.

       9999-PUTBUFFER-1.
           MOVE DE-FIELDS-1 TO DISPLAY-REC.

       9999-SETERROR-1.
           MOVE B"1"            TO IND (99).
           MOVE B"1"            TO IND (FIELD-NUMBER).
           MOVE MESSAGE-BUFFER  TO DE-MESSAGE-LINE-1.
           MOVE DE-FIELDS-1     TO DISPLAY-REC.

       9999-DO-SCREEN-1.
           PERFORM 998-WRITE-SCREEN THRU 9989-WS-X.

089000 COPY DLOCKCAL   IN COPYLIB.
089100 COPY MLOCKCAL   IN COPYLIB.
089200 COPY UNLOCK     IN COPYLIB.
       9999-GETKEY-MSTORERM-CD-O.
           MOVE 0 TO COND-WORD.
           MOVE CODE-ARG TO CORPCDE OF MSTORERM-CD-REC-O.
           READ MSTORERM-CD-O INTO BUF-MSTORERM
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS = "23"
               MOVE 17 TO COND-WORD
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD
               IF HANDLE-BLOWUP-FLAG = "Y"
                   MOVE "GETKEY ERR 9999-GETKEY-MSTORERM-CD-O"
                       TO BU-MSG-AREA
                   PERFORM 2100-BLOWUP.

       9999-RESET-MSTORERM-CD-O.
           MOVE HIGH-VALUES TO CORPCDE OF MSTORERM-CD-REC-O.
           START MSTORERM-CD-O KEY > CORPCDE OF MSTORERM-CD-REC-O
               INVALID KEY MOVE "00" TO FILE-STATUS.

       9999-PUT-DDAILYTC-DT-O.
           MOVE 0 TO COND-WORD.
           WRITE DDAILYTC-DT-REC-O FROM BUF-DDAILYTC
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD
               IF HANDLE-BLOWUP-FLAG = "Y"
                   MOVE "PUT ERR 9999-PUT-DDAILYTC-DT-O"
                       TO BU-MSG-AREA
                   PERFORM 2100-BLOWUP.

       9999-UPDATE-MSTORERM-CD-O.
           MOVE 0 TO COND-WORD.
           REWRITE MSTORERM-CD-REC-O FROM BUF-MSTORERM
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD
               IF HANDLE-BLOWUP-FLAG = "Y"
                   MOVE "UPDATE ERR 9999-UPDATE-MSTORERM-CD-O"
                       TO BU-MSG-AREA
                   PERFORM 2100-BLOWUP.

       900-SEND-MESSAGE.
           MOVE CODE-ARG TO CORPCDE OF USER-I-REC.
           START USER-I KEY = CORPCDE OF USER-I-REC
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS = "00"
               READ USER-I NEXT INTO BUF-USERFILE
                   AT END MOVE FILE-STATUS TO FILE-STATUS
               END-READ
               IF FILE-STATUS = "00"
                   PERFORM UNTIL USR-CORP-CODE NOT = CODE-ARG
                                     OR FILE-STATUS NOT = "00"
                       MOVE SPACES            TO  MCXSNDMSG-PARM
                       MOVE USR-CORP-CODE     TO  MCXSNDMSG-CODE
                       MOVE USR-MESSAGE       TO  MCXSNDMSG-MSG
                       CALL "MCXSNDMSG" USING MCXSNDMSG-PARM
                                              USR-USER-ID
                       READ USER-I NEXT INTO BUF-USERFILE
                           AT END MOVE FILE-STATUS TO FILE-STATUS
                       END-READ
                   END-PERFORM.

       900-GET-FRAN-NAME.
           IF FRAN-TABLE = SPACES
               MOVE SPACES TO DE-FRAN(SUB)
           ELSE
               SET FRAN-IDX TO 1
               SEARCH FRAN-ENTRY
                 AT END  MOVE SPACES TO DE-FRAN (SUB)
                 WHEN FRAN-ID(FRAN-IDX) = STR-BIN-OWNER (SUB)
                  MOVE FRAN-NAME(FRAN-IDX) TO DE-FRAN(SUB)
               END-SEARCH.
       900-GET-FRAN-NAME-X.
           EXIT.

       900-GET-FRAN-ID.
           IF FRAN-TABLE = SPACES
               MOVE SPACES TO HOLD-FRAN-ID
           ELSE
               SET FRAN-IDX TO 1
               SEARCH FRAN-ENTRY
                 AT END  MOVE SPACES TO HOLD-FRAN-ID
                 WHEN FRAN-NAME(FRAN-IDX) = OWNR (SUB)
                  MOVE FRAN-ID(FRAN-IDX) TO HOLD-FRAN-ID
               END-SEARCH.
       900-GET-FRAN-ID-X.
           EXIT.
