000200 IDENTIFICATION DIVISION.
000300 PROGRAM-ID.    TSUFFREP.
000600 ENVIRONMENT DIVISION.
000700 CONFIGURATION SECTION.
000800 SOURCE-COMPUTER.   AS400.
000900 OBJECT-COMPUTER.   AS400.
       SPECIAL-NAMES. I-O-FEEDBACK IS I-O-FEEDBACK-AREA
                      LOCAL-DATA IS LOCAL-DATA-AREA.
001000 INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT DISPLAY-FILE
               ASSIGN TO WORKSTATION-ZSUFFIX-SI
               ORGANIZATION IS TRANSACTION
               ACCESS IS SEQUENTIAL
               FILE STATUS IS DSPLY-STATUS
               CONTROL-AREA IS WS-CONTROL.
001300 DATA DIVISION.
       FILE SECTION.
       FD  DISPLAY-FILE
           LABEL RECORDS ARE OMITTED.
       01  DSPLY-REC               PIC X(2000).
001500 WORKING-STORAGE SECTION.
       COPY CPYIND  IN COPYLIB.

       01  DSPLY-STATUS            PIC XX.

       COPY IOFEEDBACK IN COPYLIB.

001900 01  MISC-BUFFER             PIC X(80) VALUE SPACES.
002000
002100 01  PASSWORD-INFORMATION.
002200     05  NAME-OF-PROGRAM     PIC X(08) VALUE "TSUFFREP".
002300     05  PROGRAM-TYPE        PIC X(02) VALUE "UP".
002400     05  PROGRAM-RELEASE     PIC X(12) VALUE " E0100010001".
002500     05  PROGRAM-DESCRIPTION.
002600         10  PROG-DESC-A     PIC X(60) VALUE
002700             " MAIN PROGRAM FOR SUFFIXING REPORTS     "          .
002800         10  PROG-DESC-B     PIC X(60) VALUE SPACES.
003000         10  PROG-FUNCTION   PIC X(60) VALUE SPACES.
003200     05  PASSWORD-FLAG       PIC X.
003300
       COPY DBSTAT OF COPYLIB.
003700
003800 01  SCREEN-DATA.
003900     05 SCREEN-KEY           PIC X(3).
           05  SCREEN-CMD-LINE     PIC X(79).
           05  SCREEN-ERR-LINE     PIC X(79).
004000
       COPY WSCONTROL IN COPYLIB.
004100 LINKAGE SECTION.
004300 01  DBPARAMETERS.           COPY DBPARMS OF COPYLIB.
       COPY VCOMLINK OF COPYLIB.
       COPY LANGSUB OF COPYLIB.
004700
004900 PROCEDURE DIVISION USING    DBPARAMETERS
005000                             VIEW-COMAREA
005100                             LANGUAGE-PARMS.
005400 START-PROGRAM.
           OPEN I-O   DISPLAY-FILE.
005500     PERFORM 6-MAIN THRU 6-MAIN-EXIT UNTIL VIEW-LASTKEY = 3.
       2-EOJ.
           CLOSE DISPLAY-FILE.
           GOBACK.

005800 6-MAIN.
006400     MOVE "FSUFFREP" TO VIEW-CFNAME.
007200     MOVE SPACES TO SCREEN-DATA DSPLY-REC.
           PERFORM 99-SCREEN-WRITE.
           PERFORM 98-SCREEN-READ.
           MOVE DSPLY-REC TO SCREEN-DATA.
010400     IF SCREEN-KEY = "R1 "
010500         CALL "TSUFFR01" USING DBPARAMETERS
010600                               VIEW-COMAREA
010700                               LANGUAGE-PARMS
               IF VIEW-LASTKEY = 3
                   MOVE 0 TO VIEW-LASTKEY
               ELSE
               NEXT SENTENCE
010800     ELSE
011400     IF SCREEN-KEY = "R2 "
011500         CALL "TSUFFR02" USING DBPARAMETERS
011600                               VIEW-COMAREA
011700                               LANGUAGE-PARMS
               IF VIEW-LASTKEY = 3
                   MOVE 0 TO VIEW-LASTKEY
               ELSE
               NEXT SENTENCE
012300     ELSE
012400     IF SCREEN-KEY = "R3 "
012500         CALL "TSUFFR03" USING DBPARAMETERS
012600                               VIEW-COMAREA
012700                               LANGUAGE-PARMS
               IF VIEW-LASTKEY = 3
                   MOVE 0 TO VIEW-LASTKEY.

       6-MAIN-EXIT.    EXIT.

       98-SCREEN-READ.
           READ DISPLAY-FILE FORMAT IS VIEW-CFNAME
               INDIC IS INDICS.
           ACCEPT IOFEEDBACK FROM I-O-FEEDBACK-AREA.
           MOVE ALL B"0" TO INDICS.
           IF DSPLY-STATUS NOT = "00"
               MOVE 3 TO VIEW-LASTKEY
           ELSE
           MOVE FUNCTION-NUM TO VIEW-LASTKEY.

       99-SCREEN-WRITE.
           WRITE DSPLY-REC FORMAT IS VIEW-CFNAME
               INDIC IS INDICS.
           MOVE ALL B"0" TO INDICS.
