145100                          CMR-CALL-MODE
145200                          CMR-DATA
145300                          CMR-DESC
145400                          CMR-REMARKS
145500                          CMR-RETURNED-DATA
145600                          CMR-MISC-PARMS
145700                          LANGUAGE-PARMS
145800                          ESC-NAME
145900                          STATUS-AREA
146000                          BU-DISPLAY-MSG.
146100     IF CMR-RETURN-STATUS NOT = "OK" GO TO 6-CC-EXIT.
146200     IF CMR-PO-NO-AND-REL = SPACES
146300         MOVE CMR-DESC-LINE (1) TO OUT-DESCRIPTION
146400         MULTIPLY CMR-QTY BY CMR-EST-UNIT-PRICE
146500             GIVING P-EST-COST
146600     ELSE
146700     MOVE CMR-PO-NO-AND-REL TO OUT-PO-NO
146800     MOVE CMR-PO-ITM-NO TO OUT-ITEM-NO
146900     MOVE CMR-PO-EXPECT-DATE TO OUT-EXP-DATE
147000*    MOVE CMR-PO-QTY-ORD TO OUT-ORDERED
           MOVE CMR-QTY        TO OUT-ORDERED
           PERFORM 60-CHK-QTYS THRU 60-CQ-X
147300     MOVE CMR-DESC-LINE (1) TO OUT-DESCRIPTION
147400     IF CMR-PO-QTY-DLVR > 0
               IF CMR-PO-QTY-DLVR > CMR-QTY
                   MOVE CMR-QTY     TO OUT-RECEIVED
                   MOVE CMR-PO-DATE-RCVD TO OUT-RCV-DATE
               ELSE
147500         MOVE CMR-PO-QTY-DLVR TO OUT-RECEIVED
147600         MOVE CMR-PO-DATE-RCVD TO OUT-RCV-DATE.
           IF PRT-EST-COST = SPACES MOVE ZEROES TO P-EST-COST.
           IF PRT-ACT-COST = SPACES MOVE ZEROES TO P-ACT-COST.
           IF PRT-EST-QTY = SPACES MOVE ZEROES TO PRT-EST-QTY-9.
           IF PRT-ACT-QTY = SPACES MOVE ZEROES TO PRT-ACT-QTY-9.
147700
147800 6-CC-EXIT.    EXIT.
147900
       60-CHK-QTYS.
           MOVE ZEROES TO P-ACT-COST.
           IF CMR-PO-QTY-PAID > CMR-QTY
               MOVE CMR-QTY TO CMR-PO-QTY-PAID.
           IF CMR-PO-QTY-ORD > CMR-QTY
               MOVE CMR-QTY TO CMR-PO-QTY-ORD.
           IF CMR-PO-QTY-PAID > 0
               IF CMR-INV-UNIT-PRICE > 0
                   MULTIPLY CMR-PO-QTY-PAID BY CMR-INV-UNIT-PRICE
                       GIVING P-ACT-COST
                   GO TO 60-CQ-X
               ELSE
               NEXT SENTENCE
           ELSE
           IF CMR-PO-QTY-PAID = 0
               IF CMR-INV-UNIT-PRICE > 0
                   MOVE CMR-INV-UNIT-PRICE TO P-ACT-COST
                   GO TO 60-CQ-X.
           IF CMR-PO-QTY-ORD > 0
               IF CMR-PO-UNIT-PRICE > 0
                   MULTIPLY CMR-PO-QTY-ORD BY CMR-PO-UNIT-PRICE
                       GIVING P-ACT-COST.

       60-CQ-X.    EXIT.

148000 6-WRITE-OUTF.
148300     ADD 1 TO ACT-KEY.
148100     WRITE OUTF    INVALID KEY MOVE 17 TO COND-WORD.
148400 6-WO-EXIT.    EXIT.
148500
       69-READ-WO-PARTS-FILE.
           MOVE 0 TO COND-WORD.
           READ WO-PARTS-FILE NEXT INTO WO-PARTS-DATA
              AT END    MOVE 15 TO COND-WORD.
           IF INPUT-WO NOT = PRT-WO-NU MOVE 15 TO COND-WORD.
           IF WPFD-STATUS NOT = "00" MOVE 15 TO COND-WORD.

       69-START-WO-PARTS-FILE.
           MOVE 0 TO COND-WORD.
           MOVE INPUT-WO TO WONUM OF WPFDREC.
           START WO-PARTS-FILE KEY IS = EXTERNALLY-DESCRIBED-KEY
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF WPFD-STATUS NOT = "00" MOVE 17 TO COND-WORD.

       69-READ-WO-PARTS-FILE-3.
           MOVE 0 TO COND-WORD.
           READ WO-PARTS-FILE-3 NEXT INTO WO-PARTS-DATA
               AT END    MOVE 15 TO COND-WORD.
           IF INPUT-ORIG NOT = PRT-ORIGINATOR MOVE 15 TO COND-WORD.
           IF WPFD3-STATUS NOT = "00" MOVE 15 TO COND-WORD.

       69-START-WO-PARTS-FILE-3.
           MOVE 0 TO COND-WORD.
           MOVE INPUT-ORIG TO PRTCCNUM OF WPFDREC3.
           START WO-PARTS-FILE-3 KEY IS = EXTERNALLY-DESCRIBED-KEY
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF WPFD3-STATUS NOT = "00" MOVE 17 TO COND-WORD.

       69-READ-WO-PLANNED-FILE-3.
           MOVE 0 TO COND-WORD.
           READ WO-PLANNED-FILE-3 NEXT INTO WO-PLANNED-DATA
               AT END    MOVE 17 TO COND-WORD.
           IF INPUT-EQPNUM NOT = EQUIP-NUM-P MOVE 15 TO COND-WORD.
           IF WPF3-STATUS NOT = "00" MOVE 17 TO COND-WORD.

       69-START-WO-PLANNED-FILE-3.
           MOVE 0 TO COND-WORD.
           MOVE INPUT-EQPNUM TO EQPNUM OF WPFREC3.
           START WO-PLANNED-FILE-3 KEY IS = EXTERNALLY-DESCRIBED-KEY
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF WPF3-STATUS NOT = "00" MOVE 17 TO COND-WORD.

       98-SCREEN-READ.
           READ DISPLAY-FILE FORMAT IS VIEW-CFNAME
               INDIC IS INDICS.
           ACCEPT IOFEEDBACK FROM I-O-FEEDBACK-AREA.
           MOVE ALL B"0" TO INDICS.
           IF DSPLY-STATUS NOT = "00"
               MOVE 3 TO VIEW-LASTKEY
           ELSE
           MOVE FUNCTION-NUM TO VIEW-LASTKEY.

       99-SCREEN-WRITE.
           WRITE DSPLY-REC FORMAT IS VIEW-CFNAME
               INDIC IS INDICS.
           MOVE ALL B"0" TO INDICS.

       COPY OVRPFCALL IN COPYLIB.

       999-CATREAD.
           MOVE SPACES TO ERROR-BUFFER.
           CALL "CCATREAD" USING CATREAD-PARMS.
           MOVE CATREAD-MSG-TEXT TO ERROR-BUFFER.
       999-CATREAD-EXIT.    EXIT.

148800 7-SORT-RECORDS.
148900     MOVE 0 TO ACT-KEY.
           CLOSE OUT-FILE.
           OPEN INPUT OUT-FILE.
           PERFORM 7-SR THRU 7-SR-EXIT.
149000 7-SR.
149100     ADD 1 TO ACT-KEY.
149200     IF ACT-KEY > REL-RECS-CTR GO TO 7-SR-EXIT.
           READ OUT-FILE     INVALID KEY GO TO 7-SR-EXIT.
149400     MOVE OUT-DATA TO SORTF.
149500     RELEASE SORTF.
149600     GO TO 7-SR.

       7-SR-EXIT.    EXIT.
149700
150000 8-WRITE-OUTPUT.
           MOVE 0 TO ACT-KEY-2.
           OPEN OUTPUT WORK-FILE.
           PERFORM 8-WO-CONT THRU 8-WO-EXIT.
       8-WO-CONT.
150100     RETURN SORT-FILE AT END GO TO 8-WO-EXIT.
150200     MOVE SPACES TO WORKF.
150500     ADD 1 TO ACT-KEY-2.
150300     MOVE SORTF TO WORK-DATA.
150400     WRITE WORKF    INVALID KEY GO TO 8-WO-EXIT.
150600     GO TO 8-WO-CONT.
