000200 IDENTIFICATION DIVISION.
000300 PROGRAM-ID.    SMODIACC.
000500 AUTHOR.        KURT MOVSESIAN/JIM COFFMAN (MAINTAINER).
000800
000900******************************************************
001000*                                                    *
001100*   S M O D I A C C                   PU2-11         *
001200*                                                    *
001300*    THIS SUB PROGRAM MODIFIES ITEM ACCOUNTING       *
001400*    INFO (SUBD. AND ADDTL INFO), AND TAX CODE       *
001500*    FOR EVERY ITEM AT ONCE ON REQUIREMENT ORDERS    *
001600*    ONLY!!                                          *
001700******************************************************
001800*   N O T E    T H I S   S U B R O U T I N E   I S   *
001900*         C A L L E D    B Y :                       *
002000*      1. SPOMOD                                     *
002100******************************************************
001200*C                                                   *
001200*C  04/04/1995    CA ZUBEK    REQ. # 95-009          *
001200*C  ADDED CALL TO "SPOTRACK" TO WRITE TO THE AUDIT   *
001200*C  FILE WHEN UNIT PRICE CHANGES.                    *
001200*C                                                   *
001200*C  07/10/1995    CA YODER                           *
001200*C  ADDED PO ITEM NUMBER TO FIELDS MOVED FOR         *
001200*C  "SPOTRACK."                                      *
      *C                                                   *
      *C  07/18/1996    CA YODER                           *
      *C  RE-COMPILED PROGRAM TO PICK UP CENTURY DATABASE  *
      *C  CHANGES.                                         *
      *C                                                   *
      *C  06/07/99   CA YODER   (DECATUR REQUEST)          *
      *C  RE-COMPILED TO PICK UP MTAX DATABASE CHANGE TO   *
      *C  EXPAND TAX RATE PERCENTAGE FROM 2 DECIMAL PLACES *
      *C  TO 4.                                            *
      *C                                                   *
002200
002300
002400 ENVIRONMENT DIVISION.
002500 CONFIGURATION SECTION.
002600 SOURCE-COMPUTER.  HP-3000.
002700 OBJECT-COMPUTER.  HP-3000.
       SPECIAL-NAMES.  I-O-FEEDBACK IS I-O-FEEDBACK-AREA.
012800
012900 INPUT-OUTPUT SECTION.
       FILE-CONTROL.

           SELECT DISPLAY-FILE
                  ASSIGN TO WORKSTATION-ZPURORD-SI
                  ORGANIZATION IS TRANSACTION
                  ACCESS IS SEQUENTIAL
                  FILE STATUS IS DISPLAY-STATUS
                  CONTROL-AREA IS WS-CONTROL.

           SELECT MVALIDPLTDATA-I
                  ASSIGN TO DATABASE-MCFLCS1701
                  ORGANIZATION IS INDEXED
                    ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                  FILE STATUS IS FILE-STATUS.

           SELECT MTAX-I
                  ASSIGN TO DATABASE-MCFLCS3701
                  ORGANIZATION IS INDEXED
                    ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                  FILE STATUS IS FILE-STATUS.
003500
           SELECT MPLTINFO-I
                  ASSIGN TO DATABASE-MCFLCS0501
                  ORGANIZATION IS INDEXED
                    ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                  FILE STATUS IS FILE-STATUS.
003500
           SELECT DPOITEM-O
                  ASSIGN TO DATABASE-MCFLCS1002
                  ORGANIZATION IS INDEXED
                    ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                    WITH DUPLICATES
                  FILE STATUS IS FILE-STATUS.

       DATA DIVISION.
       FILE SECTION.
       FD  DISPLAY-FILE
           LABEL RECORDS ARE OMITTED.
       01  DISPLAY-REC                  PIC X(2000).
      *    COPY DD-FMODIACC-O OF ZPURORD.

       FD  MVALIDPLTDATA-I
           LABEL RECORDS ARE STANDARD.
       01  MVALIDPLTDATA-REC-I.
           COPY DDS-ALL-FORMATS  OF MCFLCS1701.

       FD  MTAX-I
           LABEL RECORDS ARE STANDARD.
       01  MTAX-REC-I.
           COPY DDS-ALL-FORMATS  OF MCFLCS3701.

       FD  MPLTINFO-I
           LABEL RECORDS ARE STANDARD.
       01  MPLTINFO-REC-I.
           COPY DDS-ALL-FORMATS  OF MCFLCS0501.

       FD  DPOITEM-O
           LABEL RECORDS ARE STANDARD.
       01  DPOITEM-REC-O.
           COPY DDS-ALL-FORMATS  OF MCFLCS1002.


       WORKING-STORAGE SECTION.
       01  FILE-STATUS.
           05  FILE-STATUS-1            PIC X  VALUE "0".
           05  FILE-STATUS-2            PIC X  VALUE "0".

       77  DECREASE-PRICE-SW            PIC 9  VALUE 0.
003500 77  TOTAL-ITEM-CTR          PIC S9(4)  COMP-4 VALUE ZEROS.
003600 77  SUB                     PIC S9(4)  COMP-4 VALUE ZEROS.
       77  PERCENT-CHG-AMT         PIC S9(2)V9(2) COMP-3 VALUE ZEROS.
003700
