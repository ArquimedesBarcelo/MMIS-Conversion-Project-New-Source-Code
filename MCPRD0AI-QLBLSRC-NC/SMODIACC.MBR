013000
013100 01  DSET-NAMES.
013200     05  DSET-DPOITEM             PIC X(16)  VALUE "DPOITEM;".
013300     05  DSET-MTAX                PIC X(16)  VALUE "MTAX;".
013400     05  DSET-MVALIDPLTDATA  PIC X(16)  VALUE "MVALIDPLTDATA;".
013500
013800 COPY DBSTAT IN COPYLIB.
014600
014700 01 ITEMS-LISTING.
014800     05  ALL-ITEMS              PIC XX    VALUE "@;".
014900     05  PO-SEARCH              PIC X(10) VALUE "PO-RCV-NO;".
015000
015100 01 ARG-VALUES.
015200     05  PO-ARG                 PIC X(14) VALUE SPACES.
015300     05  MVALIDPLT-ARG          PIC X(10) VALUE SPACES.
015400     05  TAX-ARG                PIC X(2)  VALUE SPACES.
           05  PLT-ARG                PIC X(4)  VALUE SPACES.
015800
015900 COPY TBLOWUP IN COPYLIB.
016000
       01  PO-TRACK-DATA.
           COPY DPOTRACK   IN COPYLIB.

016100 LINKAGE SECTION.
016200
016300 01  BASE             PIC X(10).
016400
016500 01  BUILD-PO-SEARCH.
016600     05  PO-PREFIX           PIC X.
016700     05  PO-NO               PIC X(7).
016800     05  PO-REL              PIC X(3).
016900     05  PO-RCV              PIC X(3).
017000
