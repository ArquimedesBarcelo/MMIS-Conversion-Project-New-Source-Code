006700 01  MESSAGE-BUFFER.
006800     05  MSG-TEXT              PIC X(66)    VALUE SPACE.
006900     05  MSG-FLD               PIC X(10)     VALUE SPACE.
007000     05  MSG-FLD-9  REDEFINES  MSG-FLD      PIC Z(9)9.
007100 01  MESSAGE-BUFFER-R  REDEFINES  MESSAGE-BUFFER.
007200     05  MSG-TEXT-1R           PIC X(28).
007300     05  MSG-ITEM-NO           PIC ZZZ9.
007400     05  MSG-TEXT-2R           PIC X(6).
007500     05  MSG-ITEM-TOT          PIC ZZZ9.
007600     05  MSG-TEXT-3R           PIC X(34).
007700
007800
008300 01  FIELD-NUMBER              PIC S9(4)    VALUE 1    COMP-4.
008400
008500 01  SAVE-MSG-BUFFER.
008600     05  LB-MT-1R              PIC X(28).
008900
       COPY CATREAD IN COPYLIB.

       COPY DISPDATA IN COPYLIB.

       COPY IOFEEDBACK IN COPYLIB.

009400 COPY STC320    IN COPYLIB.
009500
