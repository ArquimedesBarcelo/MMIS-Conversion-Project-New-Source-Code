       IDENTIFICATION DIVISION.
       PROGRAM-ID.  TWESCOFL.
       DATE-COMPILED.
      ************************************************************
      ** THIS PROGRAM CREATES AN AS400 FILE FOR WESCO THAT      **
      ** CONTAINS CSIS INFORMATION. IT WILL BE UPLOADED TO      **
      ** A FLOPPY DISK AND GIVEN TO THEM TO CREATE A FILE       **
      ** TO BE USED FOR PARTS CONSOLIDATION.                    **
      ************************************************************
       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.
       COPY SPECIALN OF COPYLIB.
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT DMANPART
               ASSIGN TO DATABASE-MCFLCS3603
               ORGANIZATION IS INDEXED
               ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
               FILE STATUS IS FILE-STATUS.

           SELECT DPOITEM
               ASSIGN TO DATABASE-MCFLCS1002
               ORGANIZATION IS SEQUENTIAL
               ACCESS MODE IS SEQUENTIAL
               FILE STATUS IS FILE-STATUS.

           SELECT DPOITEM-S
               ASSIGN TO DATABASE-MCFLCS1001
               ORGANIZATION IS INDEXED
               ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                   WITH DUPLICATES
               FILE STATUS IS FILE-STATUS.

           SELECT DPORECD
               ASSIGN TO DATABASE-MCFLCS0901
               ORGANIZATION IS INDEXED
               ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
               FILE STATUS IS FILE-STATUS.

           SELECT MPLTINFO
               ASSIGN TO DATABASE-MCFLCS0501
               ORGANIZATION IS INDEXED
               ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
               FILE STATUS IS FILE-STATUS.

           SELECT MSTORERM
               ASSIGN TO DATABASE-MCFLCS0201
               ORGANIZATION IS INDEXED
               ACCESS MODE IS RANDOM
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
               FILE STATUS IS FILE-STATUS.

           SELECT MSTORERM-S
               ASSIGN TO DATABASE-MCFLCS0201
               ORGANIZATION IS SEQUENTIAL
               ACCESS IS SEQUENTIAL
               FILE STATUS IS FILE-STATUS.

           SELECT MSTORERM-DATA
               ASSIGN TO DATABASE-MCFPWESCO1
               ORGANIZATION IS SEQUENTIAL
               ACCESS MODE IS SEQUENTIAL
               FILE STATUS IS FILE-STATUS.

           SELECT MSTORERM-DATA-2
               ASSIGN TO DATABASE-MCFPWESCO2
               ORGANIZATION IS SEQUENTIAL
               ACCESS MODE IS SEQUENTIAL
               FILE STATUS IS FILE-STATUS.

           SELECT PRINT-FILE ASSIGN TO PRINTER-MCPRT.

           SELECT USAGEFIL
               ASSIGN TO DATABASE-MCFLCSUSAG
               ORGANIZATION IS INDEXED
               ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
               FILE STATUS IS FILE-STATUS.

       DATA DIVISION.
       FILE SECTION.
       FD  DMANPART
           LABEL RECORDS ARE STANDARD
           DATA RECORD IS DMANPART-REC.
       01  DMANPART-REC.
           COPY DDS-MCRPCS3600  OF MCFLCS3603.

       FD  DPOITEM
           LABEL RECORDS ARE STANDARD
           DATA RECORD IS DPOITEM-REC.
       01  DPOITEM-REC.
           COPY DDS-MCRPCS1000  OF MCFLCS1002.

       FD  DPOITEM-S
           LABEL RECORDS ARE STANDARD
           DATA RECORD IS DPOITEM-S-REC.
       01  DPOITEM-S-REC.
           COPY DDS-MCRPCS1000  OF MCFLCS1001.

       FD  DPORECD
           LABEL RECORDS ARE STANDARD
           DATA RECORD IS DPORECD-REC.
       01  DPORECD-REC.
           COPY DDS-MCRPCS0900  OF MCFLCS0901.

       FD  MPLTINFO
           LABEL RECORDS ARE STANDARD.
       01  MPLTINFO-REC.
           COPY DDS-MCRPCS0500  OF MCFLCS0501.

       FD  MSTORERM
           LABEL RECORDS ARE STANDARD.
       01  MSTORERM-REC.
           COPY DDS-MCRPCS0200  OF MCFLCS0201.

       FD  MSTORERM-S
           LABEL RECORDS ARE STANDARD.
       01  MSTORERM-S-REC.
           COPY DDS-MCRPCS0200  OF MCFLCS0201.

       FD  MSTORERM-DATA
           LABEL RECORDS ARE STANDARD
           DATA RECORD IS MSTORERM-DATA-REC.
       01  MSTORERM-DATA-REC.
           05  MDR-PLANT-CODE            PIC X(3).
           05  MDR-CORP-CODE             PIC X(8).
           05  MDR-USAGE-LAST-12MOS      PIC 9(12).
           05  MDR-YEAR-TO-DATE          PIC 9(12).
           05  MDR-ONHAND-QTY            PIC 9(8).
           05  MDR-AVG-COST              PIC 9(12)V9999.
           05  MDR-MKT-COST              PIC 9(12)V9999.
           05  MDR-DESC OCCURS 5 TIMES.
               10  MDR-DES               PIC X(80).
           05  MDR-LAST-PURCH            PIC X(6).
           05  MDR-LAST-PO               PIC X(10).
           05  MDR-BIN-LOC               PIC X(12).
           05  MDR-UNIT-OF-MEAS          PIC XX.
           05  MDR-MINIMUM               PIC 9(8).
           05  MDR-MAXIMUM               PIC 9(8).
           05  MDR-EXPEDITE              PIC 9(8).
           05  MDR-DFLT-DEPT             PIC X(6).
           05  MDR-PART-NAME             PIC X(26).
           05  MDR-PART-NUMBER           PIC X(20).
           05  FILLER                    PIC X(19).

       FD  MSTORERM-DATA-2
           LABEL RECORDS ARE STANDARD
           DATA RECORD IS MSTORERM-DATA-2-REC.
       01  MSTORERM-DATA-2-REC           PIC X(600).

       FD  PRINT-FILE
           LABEL RECORDS ARE OMITTED
           RECORD CONTAINS 132 CHARACTERS
           DATA RECORD IS PRINT-REC.
       01  PRINT-REC                     PIC X(132).

       FD  USAGEFIL
           LABEL RECORDS ARE STANDARD.
       01  USAGEFIL-REC.
           COPY DDS-MCRPCSUSAG  OF MCFLCSUSAG.

       WORKING-STORAGE SECTION.
       77  LINE-CTR                      PIC 99.
       77  RET-RECS-CTR                  PIC 9(5).
       77  SAVE-PLANT-CODE               PIC X(3).
       77  TOT-RECS-CTR                  PIC 9(5).
       01  HANDLE-BLOWUP-FLAG            PIC X(1)  VALUE "Y".

062200 01  BUF-USAGEFIL.
           05  FILLER                    PIC XX.
           05  K-CORP-CODE               PIC X(8).
062500     05  K-MONTHS                 OCCURS 14 TIMES.
               10  K-MTH-USAGE           PIC S9(9) COMP-4.
062700
       01  CODE-ARG                      PIC X(8).

       01  DETAIL-LINE-0.
           05  D-CC     PIC X(8)  VALUE SPACES.
           05  FILLER   PIC X     VALUE SPACE.
           05  D-12MOS  PIC Z(11)9.
           05  FILLER   PIC X     VALUE SPACE.
           05  D-YTD    PIC Z(11)9.
           05  FILLER   PIC X     VALUE SPACE.
           05  D-ONHAND PIC Z(7)9.
           05  FILLER   PIC X     VALUE SPACE.
           05  D-AVG    PIC Z(11)9.9(4).
           05  FILLER   PIC X     VALUE SPACE.
           05  D-MKT    PIC Z(11)9.9(4).
           05  FILLER   PIC X     VALUE SPACE.
           05  D-LPODAT PIC X(06) VALUE SPACES.
           05  FILLER   PIC X     VALUE SPACE.
           05  D-LPO    PIC X(10) VALUE SPACES.
           05  FILLER   PIC X     VALUE SPACE.
           05  D-PNAM   PIC X(26) VALUE SPACES.
           05  FILLER   PIC X(07) VALUE SPACES.

       01  DETAIL-LINE-1.
           05  FILLER   PIC X(98) VALUE SPACES.
           05  D-PNUM   PIC X(20) VALUE SPACES.
           05  FILLER   PIC X(14) VALUE SPACES.

       01  DETAIL-LINE-2.
           05  D-BINLOC PIC X(12) VALUE SPACES.
           05  FILLER   PIC X     VALUE SPACE.
           05  D-UM     PIC XX    VALUE SPACES.
           05  FILLER   PIC X     VALUE SPACE.
           05  D-MIN    PIC Z(7)9.
           05  FILLER   PIC X     VALUE SPACE.
           05  D-MAX    PIC Z(7)9.
           05  FILLER   PIC X     VALUE SPACE.
           05  D-EXP    PIC Z(7)9.
           05  FILLER   PIC X     VALUE SPACE.
           05  D-DFLT   PIC X(4)  VALUE SPACES.
           05  FILLER   PIC X     VALUE SPACE.
           05  D-DESC   PIC X(80) VALUE SPACES.

       01  HEADER-00.
           05  FILLER   PIC X(30)
               VALUE "CONTENTS OF FILE SENT TO WESCO".
           05  FILLER   PIC X(102) VALUE SPACES.

       01  HEADER-0.
           05  FILLER   PIC X(09) VALUE "CORPCODE ".
           05  FILLER   PIC X(13) VALUE "12 MOS USAGE ".
           05  FILLER   PIC X(13) VALUE " USAGE Y-T-D ".
           05  FILLER   PIC X(09) VALUE "  ONHAND ".
           05  FILLER   PIC X(18) VALUE "     AVERAGE COST ".
           05  FILLER   PIC X(18) VALUE "      MARKET COST ".
           05  FILLER   PIC X(07) VALUE "LPODAT ".
           05  FILLER   PIC X(11) VALUE " LAST P.O. ".
           05  FILLER   PIC X(27) VALUE "MANUFACTURER PART NAME   ".
           05  FILLER   PIC X(07) VALUE SPACES.

       01  HEADER-1.
           05  FILLER   PIC X(98) VALUE SPACES.
           05  FILLER   PIC X(21) VALUE "MANUFACT PART NUMBER ".
           05  FILLER   PIC X(13) VALUE SPACES.

       01  HEADER-2.
           05  FILLER   PIC X(13) VALUE "BIN LOCATION ".
           05  FILLER   PIC X(03) VALUE "UM ".
           05  FILLER   PIC X(09) VALUE " MINIMUM ".
           05  FILLER   PIC X(09) VALUE " MAXIMUM ".
           05  FILLER   PIC X(09) VALUE "  EXPED. ".
           05  FILLER   PIC X(05) VALUE "DFLT ".
           05  FILLER   PIC X(80) VALUE "DESCRIPTION ".

       01  HEADER-U.
           05  FILLER   PIC X(132) VALUE ALL "_".

       01  PO-ARG.
           05  FILLER                    PIC X     VALUE "P".
           05  MSTORERM-PO               PIC X(10).
           05  FILLER                    PIC XXX   VALUE "000".

       COPY VCOMAREA IN COPYLIB.
      *****************************************************************
      **                                                             **
      **  S U B P R O G R A M   A R E A                              **
      **                                                             **
      *****************************************************************
       COPY CCRTFILE IN COPYLIB.

       COPY CDESC    IN COPYLIB.

       COPY TBLOWUP  IN COPYLIB.

       COPY TDATECHK IN COPYLIB.

      *****************************************************************
      **                                                             **
      **  D A T A B A S E   W O R K                                  **
      **                                                             **
      *****************************************************************
       01  BASE                          PIC X(10)  VALUE "  STORES;".
       COPY FILESTAT   IN COPYLIB.
       COPY DBSTAT     IN COPYLIB.
       COPY OVRPFDATA  IN COPYLIB.
       01  SAVE-BUF-DPOITEM.
           05  FILLER                    PIC X(52).
           05  SAVE-ITM-UNIT-PRICE       PIC S9(11)V9(4) COMP-3.
           05  FILLER                    PIC X(28).
           05  SAVE-PO-RCV-NO.
               10  FILLER                PIC X(01).
               10  SAVE-PO-NO-AND-REL.
                   15  SAVE-PO-NO        PIC X(07).
                   15  SAVE-PO-REL       PIC X(03).
               10  FILLER                PIC X(04).
           05  FILLER                    PIC X(112).

      *****************************************************************
      **                                                             **
      **  D A T A B A S E   B U F F E R S                            **
      **                                                             **
      *****************************************************************
       COPY DMANPART   IN COPYLIB.

       COPY DPOITEM    IN COPYLIB.

       COPY DPORECD    IN COPYLIB.

       COPY MPLTINFO   IN COPYLIB.

       COPY MSTORERM   IN COPYLIB.

       PROCEDURE DIVISION.
       START-PGM.
           OPEN INPUT  DMANPART.
           OPEN INPUT  DPOITEM.
           OPEN INPUT  DPORECD.
           OPEN INPUT  MPLTINFO.
      *------ CALL CCRTFILE TO CREATE 'MCFPWESCOF'
           MOVE "*CURLIB"     TO CCRTFILE-LIBRARY.
           MOVE "MCFPWESCO1"  TO CCRTFILE-FILE.
           MOVE "0600"        TO CCRTFILE-RECORD-LENGTH.
           MOVE "10000"       TO CCRTFILE-NO-RECORDS.
           MOVE "01000"       TO CCRTFILE-INCREMENT-AMT.
           MOVE "03"          TO CCRTFILE-NO-INCREMENTS.
           CALL "CCRTFILE" USING CCRTFILE-LIBRARY,
                                 CCRTFILE-FILE,
                                 CCRTFILE-RECORD-LENGTH,
                                 CCRTFILE-NO-RECORDS,
                                 CCRTFILE-INCREMENT-AMT,
                                 CCRTFILE-NO-INCREMENTS,
                                 CCRTFILE-STATUS.
           IF CCRTFILE-STATUS NOT = "00"
               DISPLAY "CCRTFILE CREATE OF 'MCFPWESCO1' FAILED"
               GOBACK.
           OPEN OUTPUT MSTORERM-DATA.
      *------ CALL CCRTFILE TO CREATE 'MCFPWESCO2'
           MOVE "*CURLIB"     TO CCRTFILE-LIBRARY.
           MOVE "MCFPWESCO2"  TO CCRTFILE-FILE.
           MOVE "0600"        TO CCRTFILE-RECORD-LENGTH.
           MOVE "10000"       TO CCRTFILE-NO-RECORDS.
           MOVE "01000"       TO CCRTFILE-INCREMENT-AMT.
           MOVE "03"          TO CCRTFILE-NO-INCREMENTS.
           CALL "CCRTFILE" USING CCRTFILE-LIBRARY,
                                 CCRTFILE-FILE,
                                 CCRTFILE-RECORD-LENGTH,
                                 CCRTFILE-NO-RECORDS,
                                 CCRTFILE-INCREMENT-AMT,
                                 CCRTFILE-NO-INCREMENTS,
                                 CCRTFILE-STATUS.
           IF CCRTFILE-STATUS NOT = "00"
               DISPLAY "CCRTFILE CREATE OF 'MCFPWESCO2' FAILED"
               GOBACK.
           OPEN OUTPUT MSTORERM-DATA-2.
           OPEN INPUT  USAGEFIL.
           MOVE "MCPRT" TO OVRPRTF-FILE.
           PERFORM 996-OVERRIDE-PRINT-FILE.
           OPEN OUTPUT PRINT-FILE.
           MOVE 61 TO LINE-CTR.
           MOVE 0 TO RET-RECS-CTR, TOT-RECS-CTR.
           MOVE "P 01" TO PLTINFOKEY OF MPLTINFO-REC.
           READ MPLTINFO INTO BUF-MPLTINFO
               INVALID KEY    MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE "111" TO SAVE-PLANT-CODE
           ELSE
           MOVE MPLTINFO-COMPANY TO SAVE-PLANT-CODE.
           PERFORM 6000-MAIN THRU 6990-MAIN-X.
           CLOSE DMANPART.
           CLOSE DPOITEM.
           CLOSE DPORECD.
           CLOSE MPLTINFO.
           CLOSE MSTORERM-DATA.
           CLOSE MSTORERM-DATA-2.
           CLOSE PRINT-FILE.
           CLOSE USAGEFIL.
           GOBACK.

       2100-BLOWUP.
076300     MOVE "TWESCOFL" TO BU-PGM-NAME.
076400     CALL "TBLOWUP" USING BASE BU-PGM-NAME STATUS-AREA
076500                      VIEW-COMAREA DUMMY-KSAM-STAT
076600                      BU-DISPLAY-MSG BU-DISPLAY-FLDS.

       6000-MAIN.
           IF SAVE-PLANT-CODE = "131" OR "153"
               OPEN INPUT MSTORERM
           ELSE
           OPEN INPUT DPOITEM-S
           OPEN INPUT MSTORERM-S
           GO TO 6000-MAIN-2.
           READ DPOITEM NEXT INTO BUF-DPOITEM
               AT END    MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               DISPLAY "TOTAL RECORDS ON FILE = " TOT-RECS-CTR
               CLOSE MSTORERM
               GO TO 6990-MAIN-X.
           IF SAVE-PLANT-CODE = "131"
               IF ITM-PO-RCV-NO = "P35143  999000" OR "P35505  999000"
                   OR "P35506  999000" OR "P35509  999000"
                   OR "P35554  999000" OR "P35556  999000"
                   OR "P35557  999000" OR "P35558  999000"
                       NEXT SENTENCE
               ELSE
               GO TO 6000-MAIN
           ELSE
           IF SAVE-PLANT-CODE = "153"
               IF ITM-PO-RCV-NO = "P52201  999000" OR "P52201A 999000"
                   OR "P52201B 999000"
                       NEXT SENTENCE
               ELSE
               GO TO 6000-MAIN.
           ADD 1 TO TOT-RECS-CTR.
           MOVE ITM-CORP-CODE TO CORPCDE OF MSTORERM-REC.
           READ MSTORERM INTO BUF-MSTORERM
               INVALID KEY    MOVE FILE-STATUS TO FILE-STATUS.
           IF SAVE-PLANT-CODE = "211" OR "281" OR "285"
               IF ST-CLASS = "116" OR "285" OR "400" OR "520" OR "521"
                   NEXT SENTENCE
               ELSE
               GO TO 6000-MAIN
           ELSE
           IF SAVE-PLANT-CODE = "153" OR "131"
               NEXT SENTENCE
           ELSE
           IF SAVE-PLANT-CODE = "129"
               IF ST-CLASS = "312" OR "316"
                   NEXT SENTENCE
               ELSE
               GO TO 6000-MAIN
           ELSE
           IF ST-CLASS = "316"
               NEXT SENTENCE
           ELSE
           GO TO 6000-MAIN.
           MOVE SAVE-PLANT-CODE TO  MDR-PLANT-CODE.
           MOVE CORP-CODE       TO  MDR-CORP-CODE,
                                    CODE-ARG,
                                    D-CC.
           MOVE STR-ONHAND      TO  MDR-ONHAND-QTY,
                                    D-ONHAND.
           MOVE STR-AVG-COST    TO  MDR-AVG-COST,
                                    D-AVG.
           MOVE STR-LAST-PO-RLSE TO MSTORERM-PO,
                                    D-LPO.
           MOVE STR-LOC (1)     TO  MDR-BIN-LOC,
                                    D-BINLOC.
           MOVE STR-UM          TO  MDR-UNIT-OF-MEAS,
                                    D-UM.
           MOVE STR-REORDER     TO  MDR-MINIMUM,
                                    D-MIN.
           MOVE STR-MAX         TO  MDR-MAXIMUM,
                                    D-MAX.
           MOVE STR-EXPEDITE    TO  MDR-EXPEDITE,
                                    D-EXP.
           MOVE STR-DFLT-DEPT   TO  MDR-DFLT-DEPT,
                                    D-DFLT.
           MOVE STR-MKT-COST    TO  MDR-MKT-COST,
                                    D-MKT.
           MOVE PO-ARG          TO  PORCVNO OF DPORECD-REC.
           READ DPORECD INTO BUF-DPORECD
               INVALID KEY    MOVE FILE-STATUS TO FILE-STATUS.
           MOVE PO-DATE         TO  MDR-LAST-PURCH,
                                    D-LPODAT.
           MOVE STR-LAST-PO-RLSE TO MDR-LAST-PO,
                                    D-LPO.
           MOVE "F"             TO  CDESC-DESC-OPTION.
           MOVE 5               TO  CDESC-LINES-TO-GET.
           MOVE "N"             TO  CDESC-LOCAL-DESC-OPTION.
126000     CALL "CDESC" USING CDESC-RET-CODE, BASE, STATUS-AREA,
126100       BU-DISPLAY-MSG, CODE-ARG, CDESC-DATA.
126200     IF BU-DISPLAY-MSG-1 NOT = SPACES
126300         PERFORM 2100-BLOWUP.
           MOVE CDESC (1)       TO  MDR-DES (1),
                                    D-DESC.
           MOVE CDESC (2)       TO  MDR-DES (2).
           MOVE CDESC (3)       TO  MDR-DES (3).
           MOVE CDESC (4)       TO  MDR-DES (4).
           MOVE CDESC (5)       TO  MDR-DES (5).
           MOVE CODE-ARG TO CORPCDE OF USAGEFIL-REC.
           READ USAGEFIL INTO BUF-USAGEFIL
               INVALID KEY    MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS = "00"
               COMPUTE MDR-YEAR-TO-DATE = K-MTH-USAGE (1) +
                   K-MTH-USAGE (2) + K-MTH-USAGE (3) +
                   K-MTH-USAGE (4) + K-MTH-USAGE (5) +
                   K-MTH-USAGE (6) + K-MTH-USAGE (7)
               COMPUTE MDR-USAGE-LAST-12MOS = K-MTH-USAGE (1) +
                   K-MTH-USAGE (2) + K-MTH-USAGE (3) + K-MTH-USAGE (4)
                   + K-MTH-USAGE (5) + K-MTH-USAGE (6) +
                   K-MTH-USAGE (7) + K-MTH-USAGE (8) +
                   K-MTH-USAGE (9) + K-MTH-USAGE (10) +
                   K-MTH-USAGE (11) + K-MTH-USAGE (12).
           MOVE MDR-YEAR-TO-DATE TO D-YTD.
           MOVE MDR-USAGE-LAST-12MOS TO D-12MOS.
           MOVE CODE-ARG        TO  CORPCDE OF DMANPART-REC.
           READ DMANPART INTO BUF-DMANPART
               INVALID KEY    MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE SPACES      TO  MDR-PART-NUMBER,
                                    D-PNUM
           ELSE
           MOVE MAN-NAME        TO  MDR-PART-NAME,
                                    D-PNAM
           MOVE MAN-PARTNO      TO  MDR-PART-NUMBER,
                                    D-PNUM.
           IF ST-CLASS = "312"
               MOVE MSTORERM-DATA-REC TO MSTORERM-DATA-2-REC
               WRITE MSTORERM-DATA-2-REC
           ELSE
           WRITE MSTORERM-DATA-REC.
           ADD 4                     TO  LINE-CTR.
           IF LINE-CTR > 61
               PERFORM 6999-HEADER.
           WRITE PRINT-REC FROM DETAIL-LINE-0 AFTER ADVANCING 1 LINES.
           WRITE PRINT-REC FROM DETAIL-LINE-1 AFTER ADVANCING 1 LINES.
           WRITE PRINT-REC FROM DETAIL-LINE-2 AFTER ADVANCING 1 LINES.
           MOVE SPACES               TO  PRINT-REC.
           WRITE PRINT-REC AFTER ADVANCING 1 LINES.
           GO TO 6000-MAIN.

       6000-MAIN-2.
           READ MSTORERM-S NEXT INTO BUF-MSTORERM
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "46"
                   DISPLAY "TOTAL RECORDS ON FILE = " TOT-RECS-CTR
                   CLOSE DPOITEM-S
                   CLOSE MSTORERM-S
                   GO TO 6990-MAIN-X.
           ADD 1 TO TOT-RECS-CTR.
           IF SAVE-PLANT-CODE = "211" OR "281" OR "285"
               IF ST-CLASS = "116" OR "285" OR "400" OR "520" OR "521"
                   NEXT SENTENCE
               ELSE
               GO TO 6000-MAIN-2
           ELSE
           IF SAVE-PLANT-CODE = "129"
               IF ST-CLASS = "312" OR "316"
                   NEXT SENTENCE
               ELSE
               GO TO 6000-MAIN-2
           ELSE
           IF ST-CLASS = "312" OR "316"
               NEXT SENTENCE
           ELSE
           GO TO 6000-MAIN-2.
           MOVE SAVE-PLANT-CODE TO  MDR-PLANT-CODE.
           MOVE CORP-CODE       TO  MDR-CORP-CODE,
                                    CODE-ARG,
                                    D-CC.
           MOVE STR-ONHAND      TO  MDR-ONHAND-QTY,
                                    D-ONHAND.
           MOVE STR-AVG-COST    TO  MDR-AVG-COST,
                                    D-AVG.
           MOVE STR-LAST-PO-RLSE TO MSTORERM-PO,
                                    D-LPO.
           MOVE STR-LOC (1)     TO  MDR-BIN-LOC,
                                    D-BINLOC.
           MOVE STR-UM          TO  MDR-UNIT-OF-MEAS,
                                    D-UM.
           MOVE STR-REORDER     TO  MDR-MINIMUM,
                                    D-MIN.
           MOVE STR-MAX         TO  MDR-MAXIMUM,
                                    D-MAX.
           MOVE STR-EXPEDITE    TO  MDR-EXPEDITE,
                                    D-EXP.
           MOVE STR-DFLT-DEPT   TO  MDR-DFLT-DEPT,
                                    D-DFLT.
           MOVE STR-MKT-COST    TO  MDR-MKT-COST,
                                    D-MKT.
           IF SAVE-PLANT-CODE = "129"
               PERFORM 6002-GET-LOW-MKTCOST THRU 6002-GLM-X
           ELSE
           MOVE PO-ARG          TO  PORCVNO OF DPORECD-REC
           READ DPORECD INTO BUF-DPORECD
           MOVE PO-DATE         TO  MDR-LAST-PURCH,
                                    D-LPODAT
           MOVE STR-LAST-PO-RLSE TO MDR-LAST-PO,
                                    D-LPO.
           MOVE "F"             TO  CDESC-DESC-OPTION.
           MOVE 5               TO  CDESC-LINES-TO-GET.
           MOVE "N"             TO  CDESC-LOCAL-DESC-OPTION.
126000     CALL "CDESC" USING CDESC-RET-CODE, BASE, STATUS-AREA,
126100       BU-DISPLAY-MSG, CODE-ARG, CDESC-DATA.
126200     IF BU-DISPLAY-MSG-1 NOT = SPACES
126300         PERFORM 2100-BLOWUP.
           MOVE CDESC (1)       TO  MDR-DES (1),
                                    D-DESC.
           MOVE CDESC (2)       TO  MDR-DES (2).
           MOVE CDESC (3)       TO  MDR-DES (3).
           MOVE CDESC (4)       TO  MDR-DES (4).
           MOVE CDESC (5)       TO  MDR-DES (5).
           MOVE CODE-ARG TO CORPCDE OF USAGEFIL-REC.
           READ USAGEFIL INTO BUF-USAGEFIL
               INVALID KEY    MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS = "00"
               COMPUTE MDR-YEAR-TO-DATE = K-MTH-USAGE (1) +
                   K-MTH-USAGE (2) + K-MTH-USAGE (3) +
                   K-MTH-USAGE (4) + K-MTH-USAGE (5) +
                   K-MTH-USAGE (6) + K-MTH-USAGE (7)
               COMPUTE MDR-USAGE-LAST-12MOS = K-MTH-USAGE (1) +
                   K-MTH-USAGE (2) + K-MTH-USAGE (3) + K-MTH-USAGE (4)
                   + K-MTH-USAGE (5) + K-MTH-USAGE (6) +
                   K-MTH-USAGE (7) + K-MTH-USAGE (8) +
                   K-MTH-USAGE (9) + K-MTH-USAGE (10) +
                   K-MTH-USAGE (11) + K-MTH-USAGE (12).
           MOVE MDR-YEAR-TO-DATE     TO  D-YTD.
           MOVE MDR-USAGE-LAST-12MOS TO  D-12MOS.
           MOVE CODE-ARG        TO  CORPCDE OF DMANPART-REC.
           READ DMANPART INTO BUF-DMANPART
               INVALID KEY    MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE SPACES           TO  MDR-PART-NUMBER,
                                         D-PNUM
           ELSE
           MOVE MAN-NAME             TO  MDR-PART-NAME,
                                         D-PNAM
           MOVE MAN-PARTNO           TO  MDR-PART-NUMBER,
                                         D-PNUM.
           IF ST-CLASS = "312"
               MOVE MSTORERM-DATA-REC TO MSTORERM-DATA-2-REC
               WRITE MSTORERM-DATA-2-REC
           ELSE
           WRITE MSTORERM-DATA-REC.
           ADD 4                     TO  LINE-CTR.
           IF LINE-CTR > 61
               PERFORM 6999-HEADER.
           WRITE PRINT-REC FROM DETAIL-LINE-0 AFTER ADVANCING 1 LINES.
           WRITE PRINT-REC FROM DETAIL-LINE-1 AFTER ADVANCING 1 LINES.
           WRITE PRINT-REC FROM DETAIL-LINE-2 AFTER ADVANCING 1 LINES.
           MOVE SPACES               TO  PRINT-REC.
           WRITE PRINT-REC AFTER ADVANCING 1 LINES.
           GO TO 6000-MAIN-2.
       6002-GET-LOW-MKTCOST.
           MOVE SPACES               TO  SAVE-BUF-DPOITEM.
           MOVE CODE-ARG             TO  CORPCDE OF DPOITEM-S-REC.
           START DPOITEM-S KEY = CORPCDE OF DPOITEM-S-REC
               INVALID KEY    MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE SPACES           TO  MDR-LAST-PO,
                                         D-LPO,
               MOVE ZEROES           TO  MDR-LAST-PURCH,
                                         D-LPODAT,
                                         MDR-MKT-COST,
                                         D-MKT
               GO TO 6002-GLM-X.
       6002-GLM-CONT.
           READ DPOITEM-S NEXT INTO BUF-DPOITEM
               AT END    MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00" GO TO 6002-GLM-CONT-2.
           IF ITM-CORP-CODE NOT = CODE-ARG GO TO 6002-GLM-CONT-2.
           IF ITM-PO-NO-1-4 = "ITOV" GO TO 6002-GLM-CONT.
           IF SAVE-BUF-DPOITEM = SPACES
               MOVE BUF-DPOITEM      TO  SAVE-BUF-DPOITEM
               GO TO 6002-GLM-CONT.
           IF ITM-UNIT-PRICE < SAVE-ITM-UNIT-PRICE
               MOVE BUF-DPOITEM      TO  SAVE-BUF-DPOITEM.
           GO TO 6002-GLM-CONT.
       6002-GLM-CONT-2.
           IF SAVE-BUF-DPOITEM = SPACES
               MOVE SPACES           TO  MDR-LAST-PO,
                                         D-LPO,
               MOVE ZEROES           TO  MDR-LAST-PURCH,
                                         D-LPODAT,
                                         MDR-MKT-COST,
                                         D-MKT
               GO TO 6002-GLM-X.
           MOVE SAVE-PO-NO-AND-REL   TO  MDR-LAST-PO,
                                         D-LPO.
           MOVE SAVE-PO-RCV-NO       TO  PORCVNO OF DPORECD.
           READ DPORECD INTO BUF-DPORECD.
           MOVE PO-DATE              TO  MDR-LAST-PURCH,
                                         D-LPODAT.
           MOVE SAVE-ITM-UNIT-PRICE  TO  MDR-MKT-COST,
                                         D-MKT.
       6002-GLM-X.    EXIT.
       6990-MAIN-X.
           EXIT.

       6999-HEADER.
           WRITE PRINT-REC FROM HEADER-00 AFTER ADVANCING NEW-PAGE.
           WRITE PRINT-REC FROM HEADER-0 AFTER ADVANCING 1 LINES.
           WRITE PRINT-REC FROM HEADER-1 AFTER ADVANCING 1 LINES.
           WRITE PRINT-REC FROM HEADER-2 AFTER ADVANCING 1 LINES.
           WRITE PRINT-REC FROM HEADER-U AFTER ADVANCING 1 LINES.
           MOVE 5 TO LINE-CTR.

       COPY OVRPFCALL IN COPYLIB.

