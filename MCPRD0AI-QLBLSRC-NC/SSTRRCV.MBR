044300 6200-SHOW-FORM.
047700     IF PLT-NUMBER = "211" OR "281" OR "285"
               MOVE B"1" TO IND(88)
           ELSE
               MOVE B"0" TO IND(88)
           END-IF.
044400     MOVE 5  TO SAVE-PARA-NUMBER.
044500*---------- F1 AND F2 WILL CAUSE FIELD EDITS.  F7 WILL DO A
044600*---------- RCV SLIP INQUIRY.  ENTER IS NOT ALLOWED FROM THIS SCREEN.
044700     MOVE " AFE" TO SRF-FKEY (1), SRF-FKEY (2), SRF-FKEY (7).
044800     MOVE 6                        TO   SRF-KEYSET.
           MOVE "ZUDCSTR" TO VIEW-CFNAME.
           MOVE 0 TO SUB.
           PERFORM 9800-INIT-ITEMS 24 TIMES.
           MOVE "ALL" TO DE-ITM-X (1).
           MOVE DE-FIELDS TO SCREEN-BUFFER.
045000     CALL "TSHWRDFM" USING SRF-COMAREA, BU-DISPLAY-MSG,
045100       VIEW-COMAREA, BASE, STATUS-AREA, SRF-SPOOLER-REC,
045200       LANGUAGE-PARMS, SCREEN-BUFFER.
           MOVE SCREEN-BUFFER TO DE-FIELDS.
045300     IF BU-DISPLAY-MSG-1 NOT = SPACES
045400         PERFORM 2100-BLOWUP.
045500
           IF VIEW-LASTKEY = 0
      *       "E28: 'ENTER' NOT VALID HERE"
               MOVE   5 TO LANG-SETNUM
               MOVE  28 TO LANG-MSGNUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE 0 TO FIELD-NUMBER
               PERFORM  4-SETERROR  THRU  4-SE-X
               GO TO 6200-SHOW-FORM.

           IF DE-ITM-X (1) = "ALL"
               NEXT SENTENCE
           ELSE
               MOVE DE-ITM-X (1) TO RS-SHIFT-FLD
               CALL "TRSHIFT" USING RS-RET-CODE, RS-SHIFT-FLD
               MOVE RS-SHIFT-FLD-5-8 TO DE-ITM-X (1).

045600*---------- F1 IS FOR ACCEPTING RECEIVING SLIP "AS IS".  F2 ALLOWS USER
045700*---------- TO MODIFY EACH ITEM INTO STOREROOM.
045800     IF VIEW-LASTKEY = 1
045900         MOVE "Y"                  TO   OK-AS-IS-SW
046000     ELSE
046100         MOVE "N"                  TO   OK-AS-IS-SW.
046200
046300     IF VIEW-LASTKEY EQUAL 8
046400         GO TO 6990-MAIN-X.
