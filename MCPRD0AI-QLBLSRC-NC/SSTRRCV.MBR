047800         IF (DE-RS = ZEROES AND DE-RLSE = ZEROES) AND
                  DE-PRAPS = ZEROS
047900*-------     "RECEIVING SLIP NUMBER MUST BE ENTERED"
048000             MOVE  18 TO LANG-SETNUM
048100             MOVE  66 TO LANG-MSGNUM
048200             PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
048300             MOVE 26                        TO FIELD-NUMBER
048400             PERFORM  4-SETERROR  THRU  4-SE-X
048500             GO TO 6200-SHOW-FORM
048600         ELSE
048700             NEXT SENTENCE
048800     ELSE
048900     IF DE-RS = ZEROES
049000*------- "RECEIVING SLIP NUMBER MUST BE ENTERED"
