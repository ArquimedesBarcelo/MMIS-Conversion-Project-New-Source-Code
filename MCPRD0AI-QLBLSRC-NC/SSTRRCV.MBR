064400     MOVE ZEROES TO T.
064500 6410-LOAD-ALL-TO-SORT-TBL.
064600     MOVE 10 TO SAVE-PARA-NUMBER.
064700*    CALL "DBGET" USING BASE, DSET-DRCVITEM, MODE5, STATUS-AREA,
064800*            ALL-ITEMS, BUF-DRCVITEM, WS-RECEIVER.
           MOVE 0 TO COND-WORD.
           READ DRCVITEM-I NEXT INTO BUF-DRCVITEM
               AT END MOVE 15 TO COND-WORD.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   MOVE 15 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.
           IF PORCVNO OF DRCVITEM-REC-I NOT = WS-RECEIVER
               MOVE 15 TO COND-WORD.
064900     IF COND-WORD = 15
065000         IF T = ZEROS
065100*-------     "NO ITEMS AVAILABLE FOR RECEIPT INTO STOREROOM"
065200             MOVE  14 TO LANG-SETNUM
065300             MOVE  57 TO LANG-MSGNUM
