063100*  ARE FOUND IN DATASET        *
063200*  "DRCVITEM".                 *
063300********************************
063400
063500 6400-FIND-DPOITEM.
063600     MOVE 9  TO SAVE-PARA-NUMBER.
063700*    CALL "DBFIND" USING BASE, DSET-DRCVITEM, MODE1, STATUS-AREA,
063800*            PO-SEARCH, WS-RECEIVER.
           MOVE 0 TO COND-WORD.
           MOVE WS-RECEIVER TO PORCVNO OF DRCVITEM-REC-I.
           START DRCVITEM-I KEY >= PORCVNO OF DRCVITEM-REC-I
               INVALID KEY MOVE 0 TO COND-WORD.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
                   MOVE 0 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.
063900     IF COND-WORD NOT = 0
064000         MOVE "DBFIND ERR 6400-FIND-DPOITEM" TO BU-DISPLAY-MSG
064100         GO TO 2100-BLOWUP.
064200
