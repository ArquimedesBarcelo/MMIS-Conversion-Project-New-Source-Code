066800*---------- INTO THE STOREROOM.
066900     IF RCV-CORP-CODE = "NON-STR"
067000         GO TO 6410-LOAD-ALL-TO-SORT-TBL.
067100
067200*------- DIRECT DELIVERY ITEMS WILL NOT BE STORED.
      *------------ REPLACE THIS EDIT CHECK WITH CALL TO SUBROUTINE
067300*----IF RCV-DATE-STORED = "  DD  "
           MOVE WS-ACCUMULATOR TO PORCVNO OF DPOITEM-REC-I.
           MOVE RCV-ITEM-NUMBER TO ITEMNO OF DPOITEM-REC-I.
           READ DPOITEM-I INTO BUF-DPOITEM
               INVALID KEY MOVE 17 TO COND-WORD
           END-READ.
           IF FILE-STATUS NOT = "00"
               MOVE 17 TO COND-WORD
           END-IF.
           IF COND-WORD NOT = 0
               MOVE "READ ERR DPOITEM 6410-LOAD" TO BU-DISPLAY-MSG
               GO TO 2100-BLOWUP.
           CALL "CDDCHECK" USING PLT-NUMBER,
                                 DIRDEL-AREA,
                                 ITM-SUB-DETL,
                                 PO-ADDL-DATA,
                                 PO-PRIME,
                                 PO-INTERNAL-ORDER-INDIC
                                 PO-CO,
                                 ITM-CLASS,
                                 RETURN-FLAGS
                                 PO-SUB
           IF RETURN-DD = "Y"
               GO TO 6410-LOAD-ALL-TO-SORT-TBL.
067500
