050400
050500 6310-CHECK-EXISTENCE.
050600     MOVE 7  TO SAVE-PARA-NUMBER.
050700*---------- BUILD UP A PO ARG FOR BOTH ACCUMULATOR AND RECEIVER.
050800     MOVE "P"                      TO   WS-PO-INDIC,
050900                                        WS-ACCUM-PO-INDIC.
051000     MOVE DE-PO                    TO   WS-PO,
051100                                        WS-ACCUM-PO.
051200     IF PLT-NUMBER = "211" OR "281" OR "285"
051300         MOVE "000"                TO   WS-ACCUM-RLSE
051400         MOVE DE-RLSE              TO   WS-RLSE
051500     ELSE
051600         MOVE DE-RLSE              TO   WS-ACCUM-RLSE,
051700                                        WS-RLSE.
051800     MOVE "000"                    TO   WS-ACCUM-RS.
051900     MOVE DE-RS                    TO   WS-RS.
052000
           MOVE 0 TO COND-WORD.
      *------------- GET ACCUMULATOR FOR PRAPS NUMBER
           IF (PLT-NUMBER = "211" OR "281" OR "285") AND
               DE-PRAPS NOT = "000000"
              MOVE DE-PRAPS TO PORCVSEQ OF MPORCV-REC2-I
              READ MPORCV2-I INTO BUF-MPORCV
                  INVALID KEY MOVE 17 TO COND-WORD
              END-READ
              IF FILE-STATUS NOT = "00"
                 MOVE  18 TO LANG-SETNUM
                 MOVE  65 TO LANG-MSGNUM
                 PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                 MOVE DE-PRAPS                  TO MSG-FLD
                 MOVE 28                        TO FIELD-NUMBER
                 PERFORM  4-SETERROR  THRU  4-SE-X
                 GO TO 6200-SHOW-FORM
              ELSE
                 MOVE M-PO-RCV-NO TO WS-ACCUMULATOR
                                     WS-RECEIVER
                 MOVE "000" TO WS-ACCUM-RS
                 MOVE WS-PO TO DE-PO
                 MOVE WS-RLSE TO DE-RLSE
                 MOVE WS-RS  TO DE-RS
              END-IF
           END-IF.

052100*---------- CHECK EXISTANCE OF THE ACCUMULATOR
           MOVE 0 TO COND-WORD.
           MOVE WS-ACCUMULATOR TO PORCVNO OF MPORCV-REC-I.
           READ MPORCV-I INTO BUF-MPORCV
               INVALID KEY MOVE 17 TO COND-WORD
           END-READ.
           IF FILE-STATUS-1 = "2"
               MOVE 17 TO COND-WORD
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD
           END-IF
           END-IF.
052400     IF COND-WORD = 17
052500*------  "PURCHASE ORDER DOES NOT EXIST"
052600         MOVE  16 TO LANG-SETNUM
052700         MOVE  45 TO LANG-MSGNUM
052800         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
052900         MOVE WS-ACCUMULATOR            TO MSG-FLD
053000         MOVE 25                        TO FIELD-NUMBER
053100         PERFORM  4-SETERROR  THRU  4-SE-X
053200         GO TO 6200-SHOW-FORM
053300     ELSE
053400     IF COND-WORD NOT = 0
053500         MOVE "DBGET ERR 1 6310-CE" TO BU-DISPLAY-MSG
053600         PERFORM 2100-BLOWUP.
053700
           IF M-PO-LAST-RCVR-X NOT NUMERIC
               MOVE 0                    TO   M-PO-LAST-RCVR.
053800     MOVE M-PO-LAST-RCVR           TO   PASS-LAST-RECEIVER.
053900     MOVE DE-RS                    TO   PASS-START-RECEIVER
                                              PASS-NO-LEFT-OFF-AT.
054000     MOVE WS-RECEIVER              TO   PASS-PO.

      *---------- GET ACCOUNTING INFO FROM PO HEADER
           MOVE 0 TO COND-WORD.
           MOVE WS-ACCUMULATOR TO PORCVNO OF DPORECD-REC.
           READ DPORECD INTO BUF-DPORECD
               INVALID KEY MOVE 17 TO COND-WORD
           END-READ.
           IF FILE-STATUS-1 = "2"
               MOVE 17 TO COND-WORD
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD
           END-IF
           END-IF.
           IF COND-WORD = 17
      *------  "PURCHASE ORDER DOES NOT EXIST"
               MOVE  16 TO LANG-SETNUM
               MOVE  45 TO LANG-MSGNUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE WS-ACCUMULATOR            TO MSG-FLD
               MOVE 25                        TO FIELD-NUMBER
               PERFORM  4-SETERROR  THRU  4-SE-X
               GO TO 6200-SHOW-FORM
           ELSE
           IF COND-WORD NOT = 0
               MOVE "READ ERR DPORECD" TO BU-DISPLAY-MSG
               PERFORM 2100-BLOWUP.

      *--------05/15/97, SET FLAG FOR FRANCHISE PO BASED ON VENDOR CODE
           IF FRAN-TABLE NOT = SPACES
               SET FRAN-IDX TO 1
               SEARCH FRAN-ENTRY
                 AT END
                     MOVE SPACES TO FRAN-PO-ID
                 WHEN FRAN-VEN-CODE(FRAN-IDX) = PO-VEN-CODE
                     MOVE FRAN-ID(FRAN-IDX) TO FRAN-PO-ID
               END-SEARCH
           ELSE
               MOVE SPACES TO FRAN-PO-ID
           END-IF.

054200*---------- CHECK EXISTENCE OF THE RCV SLIP NUMBER.
054300*    CALL "DBGET" USING BASE, DSET-MPORCV, MODE7, STATUS-AREA,
054400*            ALL-ITEMS, BUF-MPORCV, WS-RECEIVER.
           MOVE 0 TO COND-WORD.
           MOVE WS-RECEIVER TO PORCVNO OF MPORCV-REC-I.
           READ MPORCV-I INTO BUF-MPORCV
               INVALID KEY MOVE 17 TO COND-WORD.
           IF FILE-STATUS-1 = "2"
               MOVE 17 TO COND-WORD
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD.
054500     IF COND-WORD = 17
054600*------- "RECEIVING SLIP NUMBER DOES NOT EXIST"
054700         MOVE  18 TO LANG-SETNUM
054800         MOVE  65 TO LANG-MSGNUM
054900         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
055000         MOVE WS-RECEIVER               TO MSG-FLD
055100         MOVE 27                        TO FIELD-NUMBER
055200         PERFORM  4-SETERROR  THRU  4-SE-X
