039800
039900 PROCEDURE DIVISION USING BASE, VIEW-COMAREA, LANGUAGE-PARMS,
040000           BUF-PLTINFO, MULT-STR-DATA.
040100 0000-CONTROL-PARA.
040200     MOVE 1  TO SAVE-PARA-NUMBER.
           MOVE 0 TO T, SUB, TBL-LIMIT, CHECK-QTY,
             WS-RESULT-FLD, SAVE-STORED-STR-UM-DEC, SAVE-STORED-STR-UM,
             SAVE-QTY-1, SAVE-QTY-2.
           MOVE "N" TO USER-WARNING-SW, OK-AS-IS-SW,
             PREV-ACCEPTED-SW.

           OPEN INPUT MPORCV-I, DPOITEM-I, DRCVITEM-I,
             DPORECD, MSTORERM-I, MPLTINFO, MPORCV2-I.
           OPEN I-O MPORCV-O, DDAILYTC, DPOITEM-O,
             DRCVITEM-O, MSTORERM-O.

040300     PERFORM 1000-HOUSEKEEP THRU 1990-HOUSEKEEP-X.
040400     PERFORM 6000-MAIN THRU 6990-MAIN-X.

           CLOSE MPORCV-I, MPORCV-O, DDAILYTC, DPOITEM-I,
             DPOITEM-O, DRCVITEM-I, DRCVITEM-O, DPORECD,
             MSTORERM-I, MSTORERM-O, MPLTINFO, MPORCV2-I.

040500     GOBACK.
040600
040700 1000-HOUSEKEEP.
040800     MOVE 2  TO SAVE-PARA-NUMBER.
040900*---------- SET UP "TSHWRDFM" TO KEEP FIELDS LEFT-SHIFTED FOR USER
041000     MOVE 2                        TO   SRF-MODE.
041100     MOVE LANG-ERCAT-FNAME2        TO   FORM-GNAME2,
041200                                        FORM-GNAME2-B.

      *---------- GET STORES RECEIPT EXTERNAL SYSTEM INDICATORS, 9/3/97
           MOVE 0 TO COND-WORD.
           MOVE "SRX " TO MPLTINFO-ARG.
           MOVE MPLTINFO-ARG TO PLTINFOKEY OF MPLTINFO-REC.
           READ MPLTINFO INTO BUF-MPLTINFO INVALID KEY
                MOVE 17 TO COND-WORD.
           IF COND-WORD NOT = 0
               MOVE "N"  TO SAVE-EXTSYS
                            SAVE-EXTAUTO
           ELSE
               MOVE MPLTINFO-SRX-EXTSYS TO SAVE-EXTSYS
               MOVE MPLTINFO-SRX-AUTO   TO SAVE-EXTAUTO.

      *---------- DOES PLANT WANT TO VERIFY USER-ID?
           MOVE "N" TO SAVE-SR-VERIFY-SW.
           MOVE 0 TO COND-WORD.
           MOVE "OPT " TO MPLTINFO-ARG.
           MOVE MPLTINFO-ARG TO PLTINFOKEY OF MPLTINFO-REC.
           READ MPLTINFO INTO BUF-MPLTINFO INVALID KEY
                MOVE 17 TO COND-WORD.
           IF COND-WORD = 0
               IF MPLTINFO-SR-VERIFY-SW > " "
                   MOVE MPLTINFO-SR-VERIFY-SW TO SAVE-SR-VERIFY-SW.

      *---------- FIND OUT WHO IS STORING THE MATERIAL.
           CALL "WHO"   USING  MOD CAP LATTR
                               USERNAME GRPNAME ACCTNAME
                               HOMEGRP TNUM.

      *---------- GET VALID FRANCHISERS, 4/28/97
           MOVE 0 TO COND-WORD.
           MOVE "FRAN" TO MPLTINFO-ARG.
           MOVE MPLTINFO-ARG TO PLTINFOKEY OF MPLTINFO-REC.
           READ MPLTINFO INTO BUF-MPLTINFO INVALID KEY
                MOVE 17 TO COND-WORD.
           IF COND-WORD NOT = 0
               MOVE SPACES TO FRAN-TABLE
           ELSE
               MOVE MPLTINFO-FRANCHISES TO FRAN-TABLE.

      *---------- RETRIEVE STOREROOM DEPARTMENTS FOR DIRECT DELIVERY
           MOVE SPACES TO DIRDEL-AREA.
           MOVE "DSTR" TO MPLTINFO-ARG.
           MOVE 0 TO COND-WORD.
           MOVE MPLTINFO-ARG TO PLTINFOKEY OF MPLTINFO-REC.
           READ MPLTINFO INTO BUF-MPLTINFO INVALID KEY
                MOVE 17 TO COND-WORD.
           IF COND-WORD NOT = 0
                 MOVE "READ MPLTINFO DSTR " TO BU-DISPLAY-MSG
                 PERFORM 2100-BLOWUP.
           MOVE 1 TO P-A.
       DSTR-LOOP.
           MOVE MPLTINFO-DEPT-STR (P-A)  TO DIRDEL-STR-DEPT (P-A).
           IF P-A = 6
              GO TO 1990-HOUSEKEEP-X.
           ADD 1 TO P-A.
           GO TO DSTR-LOOP.
       1990-HOUSEKEEP-X.
           EXIT.

041600 2100-BLOWUP.
041700     MOVE "SSTRRCV"                TO   BU-PGM-NAME.
041800     MOVE SAVE-PARA-NUMBER         TO   BU-DISPLAY-PARA.
041900     MOVE WS-RECEIVER              TO   BU-DISPLAY-FLD (1).
042000     MOVE WS-ACCUMULATOR           TO   BU-DISPLAY-FLD (2).
042100     MOVE TAB-CODE (T)             TO   BU-DISPLAY-FLD (3).
042200     MOVE T                        TO   BU-DISPLAY-FLD9 (1).
042300     CALL "TBLOWUP" USING BASE BU-PGM-NAME STATUS-AREA
042400       VIEW-COMAREA FILE-STATUS BU-DISPLAY-MSG
042500       BU-DISPLAY-FLDS.
042600
       4-SETERROR.
           MOVE "Y" TO SRF-ERROR-SW.
           IF FIELD-NUMBER NOT = 0
               MOVE B"1" TO IND (FIELD-NUMBER).
           MOVE MESSAGE-BUFFER TO DE-MESSAGE-LINE-1,
             DE-MESSAGE-LINE-2.
       4-SE-X.
           EXIT.
