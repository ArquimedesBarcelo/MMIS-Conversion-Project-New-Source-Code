120900
121000*************************************************************
121100**                                                         **
121200**         U P D A T I N G    T H E    D A T A B A S E     **
121300**                                                         **
121400*************************************************************
121500
121600
121700
121800
121900********************************************************
122000*                                                      *
122100*    MPORCV - CALC GET, UPDATE PO-STAT WITH XX OR MM   *
122200*                                                      *
122300********************************************************
122400
122500 6810-UPDATE-PO-STAT.
122600     MOVE 27 TO SAVE-PARA-NUMBER.
122700*---------- FIND DATE FOR UPDATING THE DATE STORED.
           MOVE 1 TO DATE-MODE.
122800     CALL "TDATECK2" USING DATE-CHECK-AREA, LANGUAGE-PARMS.
           MOVE DATE-YMD-OUT TO DATE-CYMD-YMD.
           IF DATE-CYMD-YY > 70
               MOVE 19 TO DATE-CYMD-CC
           ELSE
               MOVE 20 TO DATE-CYMD-CC.
122900
123000*---------- LOCK "MPORCV" AND "DPOITEM" ON THE ACCUMULATOR VALUE,
123100*---------- AND "DRCVITEM" ON THE RECEIVER VALUE (ITEM LEVEL).
123200     MOVE WS-ACCUMULATOR           TO   PO-VALUE-1.
123300     MOVE WS-ACCUMULATOR           TO   PO-VALUE-2.
123400     MOVE WS-RECEIVER              TO   PO-VALUE-3.
123500*    CALL "DBLOCK" USING BASE, ITEM-LOCK-PO, MODE5,
123600*      STATUS-AREA.
123700*    IF COND-WORD NOT = 0
123800*        MOVE "DBLOCK ERR 6810-UPS" TO BU-DISPLAY-MSG
123900*        PERFORM 2100-BLOWUP.
124000*
124100*    CALL "DBGET" USING BASE, DSET-MPORCV, MODE7, STATUS-AREA,
124200*            ALL-ITEMS, BUF-MPORCV, WS-RECEIVER.
           MOVE 0 TO COND-WORD.
           MOVE WS-RECEIVER TO PORCVNO OF MPORCV-REC-O.
           READ MPORCV-O INTO BUF-MPORCV
               INVALID KEY MOVE 17 TO COND-WORD.
           IF FILE-STATUS-1 = "2"
               MOVE 17 TO COND-WORD
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD.
124300     IF COND-WORD NOT = 0
124400         MOVE "DBGET ERR 6810-UPS" TO BU-DISPLAY-MSG
124500         PERFORM 2100-BLOWUP.
124600
           IF PREV-ACCEPTED-SW = "Y"
               NEXT SENTENCE
           ELSE
124700     IF OK-AS-IS-SW = "Y"
124800         MOVE "XX" TO PO-RCV-STAT-1-2
124900     ELSE
125000         MOVE "MM" TO PO-RCV-STAT-1-2.
125100
125200*--------- IF THE RCV. SLIP WAS PREVIOUSLY ACCEPTED INTO STOREROOM, THE
125300*--------- MODIFY FUNCTION MUST HAVE BEEN DONE.  IN THIS CASE WE DON'T
125400*--------- WANT TO CHANGE THE STATUS TO "MODIFIED", WE WANT TO LEAVE IT
125500*--------- AT "ACCEPTED".  TO DO THIS, WE JUST SKIP THE UPDATE.
      *--------- NOTE: FOR IBM WE MUST REWRITE ANYWAY TO UNLOCK.
125600*    IF PREV-ACCEPTED-SW = "Y"
125700*        GO TO 6830-FIND-DPOITEM.
125800
125900*    CALL "DBUPDATE" USING BASE, DSET-MPORCV, MODE1,
126000*            STATUS-AREA, ALL-ITEMS, BUF-MPORCV.
           MOVE 0 TO COND-WORD.
           REWRITE MPORCV-REC-O FROM BUF-MPORCV
               INVALID KEY MOVE 99 TO COND-WORD.
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD.
126100     IF COND-WORD NOT = 0
126200         MOVE "DBUPDATE ERR 6810-UPS" TO BU-DISPLAY-MSG
126300         PERFORM 2100-BLOWUP.
126400
126500********************************************************
126600*                                                      *
126700* DPOITEM - ACCUMULATOR -     UPDATE QTY/DATE STORED   *
126800*                                                      *
126900********************************************************
127000
127100 6830-FIND-DPOITEM.
127200     MOVE 28 TO SAVE-PARA-NUMBER.
127300*    CALL "DBFIND" USING BASE, DSET-DPOITEM, MODE1, STATUS-AREA,
127400*            PO-SEARCH, WS-ACCUMULATOR.
           MOVE 0 TO COND-WORD.
           MOVE WS-ACCUMULATOR TO PORCVNO OF DPOITEM-REC-O.
           START DPOITEM-O KEY >= PORCVNO OF DPOITEM-REC-O
               INVALID KEY MOVE 0 TO COND-WORD.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
                   MOVE 0 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.
127500     IF COND-WORD NOT = 0
127600         MOVE "DBFIND ERR DPOITEM 6830-FD" TO BU-DISPLAY-MSG
127700         PERFORM 2100-BLOWUP.
127800
127900     MOVE 1 TO T.
128000
128100 6835-UPDATE-ACCUM-QTY-STORED.
128200     MOVE 29 TO SAVE-PARA-NUMBER.
128300     IF T > TBL-LIMIT
128400         GO TO 6840-UPD-RCVR-QTY.
128500
128600*    CALL "DBGET" USING BASE, DSET-DPOITEM, MODE5, STATUS-AREA,
128700*            ALL-ITEMS, BUF-DPOITEM, WS-ACCUMULATOR.
           MOVE 0 TO COND-WORD.
           READ DPOITEM-O NEXT INTO BUF-DPOITEM
               AT END MOVE 15 TO COND-WORD.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   MOVE 15 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.
           IF PORCVNO OF DPOITEM-REC-O NOT = WS-ACCUMULATOR
               MOVE 15 TO COND-WORD.
128800     IF COND-WORD = 15
128900         GO TO 6840-UPD-RCVR-QTY
129000     ELSE
129100     IF COND-WORD NOT = 0
129200         MOVE "DBGET ERR DPOITEM 6830-FD" TO BU-DISPLAY-MSG
129300         PERFORM 2100-BLOWUP.
129400
129500     IF TAB-ITEM (T) NOT = ITM-NUMBER
129600         GO TO 6835-UPDATE-ACCUM-QTY-STORED.
129700
129800     IF TAB-PROCESS-ITEM-FLAG (T) = SPACES
129900         ADD 1 TO T
130000         GO TO 6835-UPDATE-ACCUM-QTY-STORED.
130100
130200*---------- IF NOTHING WAS STORED, DON'T UPDATE THE DATE OR QUANTITY
130300*---------- STORED.
130400     IF OK-AS-IS-SW = "Y"
130500         ADD TAB-QTY-DLVR (T)      TO   ITM-QTY-STORED
130600     ELSE
130700     IF TAB-STORED-DLV-UM (T) = 0
130800         ADD 1                     TO   T
130900         GO TO 6835-UPDATE-ACCUM-QTY-STORED
131000     ELSE
131100         ADD TAB-STORED-DLV-UM (T) TO   ITM-QTY-STORED.
131200
131300     MOVE DATE-CYMD                TO   ITM-DATE-STORED-CN.
131400
131500*    CALL "DBUPDATE" USING BASE, DSET-DPOITEM, MODE1,
131600*            STATUS-AREA, ALL-ITEMS, BUF-DPOITEM.
           MOVE 0 TO COND-WORD.
           REWRITE DPOITEM-REC-O FROM BUF-DPOITEM
               INVALID KEY MOVE 99 TO COND-WORD.
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD.
131700     IF COND-WORD NOT = 0
131800         MOVE "DBUPDATE ERR DPOITEM 6830-FD" TO BU-DISPLAY-MSG
131900         PERFORM 2100-BLOWUP.
132000
132100     ADD 1 TO T.
132200     GO TO 6835-UPDATE-ACCUM-QTY-STORED.
132300
132400 6840-UPD-RCVR-QTY.
132500     MOVE 30 TO SAVE-PARA-NUMBER.
           PERFORM 7000-UNLOCK-DPOITEM.
132600*    CALL "DBFIND" USING BASE, DSET-DRCVITEM, MODE1, STATUS-AREA,
132700*            PO-SEARCH, WS-RECEIVER.
           MOVE 0 TO COND-WORD.
           MOVE WS-RECEIVER TO PORCVNO OF DRCVITEM-REC-O.
           START DRCVITEM-O KEY >= PORCVNO OF DRCVITEM-REC-O
               INVALID KEY MOVE 17 TO COND-WORD.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
                   MOVE 17 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.
132800     IF COND-WORD NOT = 0
132900         MOVE "DBFIND ERR DRCVITEM 6840-URQ" TO BU-DISPLAY-MSG
133000         PERFORM 2100-BLOWUP.
133100
133200     MOVE 1 TO T.
133300
133400 6845-UPDATE-RCVR-QTY-STORED.
133500     MOVE 31 TO SAVE-PARA-NUMBER.
133600     IF T > TBL-LIMIT
133700         GO TO 6850-UNLOCK.
133800
133900*    CALL "DBGET" USING BASE, DSET-DRCVITEM, MODE5, STATUS-AREA,
