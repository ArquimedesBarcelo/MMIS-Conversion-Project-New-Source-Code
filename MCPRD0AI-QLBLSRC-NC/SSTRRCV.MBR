167600
167700     PERFORM 9300-DETERMINE-MULT-STR-CODE THRU 9330-DMSC-X.
167800     IF (NOT MULT-STR-PLANT) OR (NOT MULT-STR-CODE)
      *----------FIND PRIMARY FRANCHISE BIN FOR PO FRAN, 5/15/97
              MOVE 1 TO FRAN-SUB
              PERFORM 9240-FIND-PRIM-FRAN-BIN THRU 9240-EXIT
              ADD UMCF-QTY-STR-UM    TO   STR-LOC-ONHAND (FRAN-SUB)
      *------------ REMOVED PERIOD AFTER FOLLOWING STATEMENT BECAUSE
      *------------ THE "GO TO EXIT" WAS PERFORMED EVERY TIME, CAUSING
      *------------ THE BIN UPDATE LOGIC TO BE SKIPPED.
      ********MOVE STR-BIN-OWNER(FRAN-SUB) TO TC-BIN-OWNER.
              MOVE STR-BIN-OWNER(FRAN-SUB) TO TC-BIN-OWNER
168000        GO TO 9230-AOO-X.
168100
      *-------FIND MULTIPLE STOREROOM BIN
      *------- IF PO FRAN = CODE FRAN, FORCE INTO FRAN BIN
           IF STR-CODE-OWNER = FRAN-PO-ID
             IF MULT-STR-STR-1 = STR-LOC-1 (1)
               AND FRAN-PO-ID = STR-BIN-OWNER (1)
                 ADD UMCF-QTY-STR-UM       TO   STR-LOC-ONHAND (1)
                 MOVE STR-BIN-OWNER(1)     TO   TC-BIN-OWNER
             ELSE
             IF MULT-STR-STR-1 = STR-LOC-1 (2)
               AND FRAN-PO-ID = STR-BIN-OWNER (2)
                 ADD UMCF-QTY-STR-UM       TO   STR-LOC-ONHAND (2)
                 MOVE STR-BIN-OWNER(2)     TO   TC-BIN-OWNER
             ELSE
             IF MULT-STR-STR-1 = STR-LOC-1 (3)
               AND FRAN-PO-ID = STR-BIN-OWNER (3)
                 ADD UMCF-QTY-STR-UM       TO   STR-LOC-ONHAND (3)
                 MOVE STR-BIN-OWNER(3)     TO   TC-BIN-OWNER
             ELSE
             IF MULT-STR-STR-1 = STR-LOC-1 (4)
               AND FRAN-PO-ID = STR-BIN-OWNER (4)
                 ADD UMCF-QTY-STR-UM       TO   STR-LOC-ONHAND (4)
                 MOVE STR-BIN-OWNER(4)     TO   TC-BIN-OWNER
             ELSE
             IF MULT-STR-STR-1 = STR-LOC-1 (5)
               AND FRAN-PO-ID = STR-BIN-OWNER (5)
                 ADD UMCF-QTY-STR-UM       TO   STR-LOC-ONHAND (5)
                 MOVE STR-BIN-OWNER(5)     TO   TC-BIN-OWNER
             ELSE
             IF MULT-STR-STR-1 = STR-LOC-1 (6)
               AND FRAN-PO-ID = STR-BIN-OWNER (6)
               ADD UMCF-QTY-STR-UM       TO   STR-LOC-ONHAND (6)
               MOVE STR-BIN-OWNER(6)     TO   TC-BIN-OWNER
             ELSE
                 MOVE STR-BIN-OWNER(1)     TO   TC-BIN-OWNER
                 ADD UMCF-QTY-STR-UM       TO   STR-LOC-ONHAND (1).

      *------IF PO FRAN NOT EQUAL CODE FRAN, FORCE INTO GOODYEAR BIN
           IF STR-CODE-OWNER NOT = FRAN-PO-ID
             IF MULT-STR-STR-1 = STR-LOC-1 (1)
               AND STR-BIN-OWNER (1) = SPACES
                 ADD UMCF-QTY-STR-UM       TO   STR-LOC-ONHAND (1)
                 MOVE STR-BIN-OWNER(1)     TO   TC-BIN-OWNER
             ELSE
             IF MULT-STR-STR-1 = STR-LOC-1 (2)
               AND STR-BIN-OWNER (2) = SPACES
                 ADD UMCF-QTY-STR-UM       TO   STR-LOC-ONHAND (2)
                 MOVE STR-BIN-OWNER(2)     TO   TC-BIN-OWNER
             ELSE
             IF MULT-STR-STR-1 = STR-LOC-1 (3)
               AND STR-BIN-OWNER (3) = SPACES
                 ADD UMCF-QTY-STR-UM       TO   STR-LOC-ONHAND (3)
                 MOVE STR-BIN-OWNER(3)     TO   TC-BIN-OWNER
             ELSE
             IF MULT-STR-STR-1 = STR-LOC-1 (4)
               AND STR-BIN-OWNER (4) = SPACES
                 ADD UMCF-QTY-STR-UM       TO   STR-LOC-ONHAND (4)
                 MOVE STR-BIN-OWNER(4)     TO   TC-BIN-OWNER
             ELSE
             IF MULT-STR-STR-1 = STR-LOC-1 (5)
               AND STR-BIN-OWNER (5) = SPACES
                 ADD UMCF-QTY-STR-UM       TO   STR-LOC-ONHAND (5)
                 MOVE STR-BIN-OWNER(5)     TO   TC-BIN-OWNER
             ELSE
             IF MULT-STR-STR-1 = STR-LOC-1 (6)
               AND STR-BIN-OWNER (6) = SPACES
               ADD UMCF-QTY-STR-UM       TO   STR-LOC-ONHAND (6)
               MOVE STR-BIN-OWNER(6)     TO   TC-BIN-OWNER
             ELSE
                 MOVE STR-BIN-OWNER(1)     TO   TC-BIN-OWNER
                 ADD UMCF-QTY-STR-UM       TO   STR-LOC-ONHAND (1).

       9230-AOO-X.
           EXIT.

      *----FIND PRIMARY BIN
      *---- IF PO FRAN = CODE FRAN THEN FORCE INTO FRAN BIN
      *---- ELSE FORCE INTO GOODYEAR BIN
       9240-FIND-PRIM-FRAN-BIN.
           IF STR-CODE-OWNER = FRAN-PO-ID
             IF FRAN-PO-ID NOT = STR-BIN-OWNER(FRAN-SUB)
                IF FRAN-SUB = 6
                    MOVE 1 TO FRAN-SUB
                ELSE
                    ADD 1 TO FRAN-SUB
                    GO TO 9240-FIND-PRIM-FRAN-BIN
                END-IF
             END-IF
           ELSE
             IF STR-BIN-OWNER(FRAN-SUB) NOT = SPACES
                IF FRAN-SUB = 6
                    MOVE 1 TO FRAN-SUB
                ELSE
                    ADD 1 TO FRAN-SUB
                    GO TO 9240-FIND-PRIM-FRAN-BIN
                END-IF
             END-IF
           END-IF.
       9240-EXIT.
           EXIT.

170500 9300-DETERMINE-MULT-STR-CODE.
170600     IF ALWAYS-MULT-STR-CODE
170700         MOVE "Y"                  TO   MULT-STR-CODE-FLAG
170800         GO TO 9330-DMSC-X.
170900
171000     MOVE "N"                      TO   MULT-STR-CODE-FLAG.
      *----------- RESET SUB TO 0.
           MOVE 0                        TO   SUB.
171100 9320-DET-MULT-STR-LOOP.
171200     ADD 1                         TO   SUB.
171300     IF SUB > 6
171400         GO TO 9330-DMSC-X.
171500
171600     IF STR-LOC-2 (SUB) = "-"
171700         IF STR-LOC-1 (SUB) > "@" AND STR-LOC-1 (SUB) < "¢"
171800             MOVE "Y"              TO   MULT-STR-CODE-FLAG
171900             GO TO 9330-DMSC-X.
172000
172100     GO TO 9320-DET-MULT-STR-LOOP.
172200 9330-DMSC-X.
172300     EXIT.

       9400-RS-INQUIRY.
           IF PASS-SAVE-LASTKEY = 1
               CALL "SINQRSI"    USING BASE, VIEW-COMAREA,
                             SUBROUTINE-PARMS, LANGUAGE-PARMS
           ELSE
             IF PASS-SAVE-LASTKEY = 2
               CALL "SINQFRT" USING BASE, VIEW-COMAREA
                              SUBROUTINE-PARMS, LANGUAGE-PARMS
             ELSE
               IF PASS-SAVE-LASTKEY = 4
                 CALL "SINQRSIC" USING BASE, VIEW-COMAREA
                                SUBROUTINE-PARMS, LANGUAGE-PARMS
               END-IF
             END-IF
           END-IF.
           IF PASS-SAVE-LASTKEY = 1 OR 2 OR 4
             GO TO 9400-RS-INQUIRY
           END-IF.
       9400-EXIT.
           EXIT.

       9500-EDIT-FRAN.
           IF FRAN-TABLE NOT = SPACES
               SET FRAN-IDX TO 1
               SEARCH FRAN-ENTRY
                  AT END  MOVE "N" TO FRAN-FOUND
                  WHEN FRAN-NAME(FRAN-IDX) = LOC-FRAN (SUB)
                          MOVE "Y" TO FRAN-FOUND
               END-SEARCH
           ELSE
               MOVE "N" TO FRAN-FOUND
           END-IF.
       9500-EDIT-FRAN-X.
           EXIT.

       9501-FIND-FRAN-NAME.
           IF FRAN-TABLE NOT = SPACES
               SET FRAN-IDX TO 1
               SEARCH FRAN-ENTRY
                  AT END
                      MOVE SPACES TO LOC-FRAN(SUB)
                  WHEN FRAN-ID(FRAN-IDX) = STR-BIN-OWNER(SUB)
                      MOVE FRAN-NAME(FRAN-IDX) TO LOC-FRAN(SUB)
                                                  TAB-LOC-FRAN(T, SUB)
               END-SEARCH
           ELSE
               MOVE SPACES TO LOC-FRAN(SUB)
           END-IF.
       9501-FIND-FRAN-NAME-X.
           EXIT.

       9800-INIT-ITEMS.
           ADD 1 TO SUB.
           MOVE 0 TO DE-ITM-NO (SUB).

       999-CATREAD.
           IF CATREAD-MSG-NUMBER = ZEROS
               MOVE LANG-SETNUM TO CATREAD-MSG-SET
               MOVE LANG-MSGNUM TO CATREAD-MSG-NUM.
           CALL "CCATREAD" USING CATREAD-PARMS.
           MOVE CATREAD-MSG-TEXT TO MESSAGE-BUFFER.
       999-CATREAD-EXIT.
