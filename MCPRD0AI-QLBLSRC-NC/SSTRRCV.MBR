068500
      *------- VERIFY THAT THE PERSON STORING THE MATERIAL IS NOT
      *------- THE SAME AS THE PERSON WHO RECEIVED THE MATERIAL.
           IF SAVE-SR-VERIFY-SW = "Y"
             IF RCV-USER-ID > SPACES
               IF USERNAME = RCV-USER-ID
      *-------     "USER NOT AUTHORIZED TO PROCESS"
                   MOVE  21 TO LANG-SETNUM
                   MOVE  32 TO LANG-MSGNUM
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE DE-PO-RLSE-RS            TO MSG-FLD
                   MOVE 25                       TO FIELD-NUMBER
                   PERFORM  4-SETERROR  THRU  4-SE-X
                   GO TO 6200-SHOW-FORM.

068600     IF OK-AS-IS-SW = "Y"
068700*        CALL "DBGET" USING BASE, DSET-MSTORERM, MODE7,
068800*        STATUS-AREA, ALL-ITEMS, BUF-MSTORERM, RCV-CORP-CODE
               MOVE 0 TO COND-WORD
               MOVE RCV-CORP-CODE TO CORPCDE OF MSTORERM-REC-I
               READ MSTORERM-I INTO BUF-MSTORERM
                   INVALID KEY MOVE 17 TO COND-WORD
               END-READ
               IF FILE-STATUS-1 = "2"
                   MOVE 17 TO COND-WORD
               ELSE
               IF FILE-STATUS NOT = "00"
                   MOVE 99 TO COND-WORD
               END-IF
069000         IF COND-WORD NOT = 0
069100             MOVE "DBGET ERROR 6500" TO BU-DISPLAY-MSG
069200             PERFORM 2100-BLOWUP
069300         ELSE
069400         IF STR-STATE = "F"
069500*            "CODE FROZEN FOR INVENTORY - NO PROCESSING ALLOWED"
069600             MOVE   3 TO LANG-SETNUM
069700             MOVE   8 TO LANG-MSGNUM
069800             PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
069900             MOVE CORP-CODE TO MSG-FLD
070000             MOVE 25 TO FIELD-NUMBER
070100             PERFORM 4-SETERROR THRU 4-SE-X
070200             GO TO 6200-SHOW-FORM.

      *-------IF OK AS IS, IF FRAN CODE = FRAN PO, CHECK THAT ONE BIN
      *------- IS OWNED BY THE FRANCHISE, ELSE ERROR MESSAGE. 4/28/97
           IF OK-AS-IS-SW = "Y"
             IF FRAN-TABLE NOT = SPACES
               IF STR-CODE-OWNER = FRAN-PO-ID
                  IF STR-BIN-OWNER (1) NOT = STR-CODE-OWNER AND
                     STR-BIN-OWNER (2) NOT = STR-CODE-OWNER AND
                     STR-BIN-OWNER (3) NOT = STR-CODE-OWNER AND
                     STR-BIN-OWNER (4) NOT = STR-CODE-OWNER AND
                     STR-BIN-OWNER (5) NOT = STR-CODE-OWNER AND
                     STR-BIN-OWNER (6) NOT = STR-CODE-OWNER
      *         CODE FRANCHISE OWNED, BUT NO BIN OWNED BY FRANCHISE
                   MOVE   3 TO LANG-SETNUM
                   MOVE 627 TO LANG-MSGNUM
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE CORP-CODE TO MSG-FLD
                   MOVE 25 TO FIELD-NUMBER
                   PERFORM 4-SETERROR THRU 4-SE-X
                   GO TO 6200-SHOW-FORM.

