       IDENTIFICATION DIVISION.
       PROGRAM-ID.             SPMSCHUP.
       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.
       SOURCE-COMPUTER.        IBM-AS400.
       OBJECT-COMPUTER.        IBM-AS400.
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT PM-RLSE-DATE
                  ASSIGN       TO DATABASE-MCFLMM4401
                  ORGANIZATION IS INDEXED
                  ACCESS MODE  IS DYNAMIC
                  RECORD KEY   IS EXTERNALLY-DESCRIBED-KEY
                               WITH DUPLICATES
                  FILE STATUS  IS FILE-STAT.

           SELECT PM-RLSE-YRMO
                  ASSIGN       TO DATABASE-MCFLMM4402
                  ORGANIZATION IS INDEXED
                  ACCESS MODE  IS DYNAMIC
                  RECORD KEY   IS EXTERNALLY-DESCRIBED-KEY
                               WITH DUPLICATES
                  FILE STATUS  IS FILE-STAT.

       DATA DIVISION.
       FILE SECTION.
       FD  PM-RLSE-DATE
           LABEL RECORDS ARE STANDARD.
       01  PM-DATE-REC.
           COPY DDS-ALL-FORMATS OF MCFLMM4401.

       FD  PM-RLSE-YRMO
           LABEL RECORDS ARE STANDARD.
       01  PM-YRMO-REC.
           COPY DDS-ALL-FORMATS OF MCFLMM4402.

       WORKING-STORAGE SECTION.
       77  SUB                 PIC 9(08) VALUE 0.
       77  LAST-PR-TIME        PIC 9(07) VALUE 0.
       77  CENTURY-P           PIC S9(4).
       77  WS-LAST-PR-TIME     PIC 9(07).
       77  D-PARM              PIC X.
       77  L-PARM              PIC X.

       01  CURR-DATE.
           05  CD-YY           PIC 99.
           05  CD-MM           PIC 99.
           05  CD-DD           PIC 99.

       01  DELETE-PR-TABLE.
           05  DEL-PR          OCCURS 31 TIMES.
               10  DPR-RDT     PIC X(08).
               10  DPR-EQP     PIC X(06).
               10  DPR-PRD     PIC X(08).
               10  DPR-PRID    PIC X(10).

       01  FILE-STAT.
           05  FILE-STAT-1     PIC X   VALUE "0".
           05  FILE-STAT-2     PIC X   VALUE "0".

       01  INDATE.
           05  IN-YMD.
               10  IN-YY       PIC 99.
               10  IN-MM       PIC 99.
               10  IN-DD       PIC 99.
               10  FILLER      PIC X.
           05  IN-JULDAY       REDEFINES IN-YMD.
               10  IN-JUL      PIC 9(5).
               10  FILLER      PIC XX.

       01  GREG-DATE.
           05  G-YEAR          PIC XXXX.
           05  G-MONTH         PIC XX.
           05  G-DAY           PIC XX.

       01  JUL-SIGN            PIC S9(06).
       01  JUL-DATE            PIC  X(07).
       01  JULIAN-DATE         REDEFINES JUL-DATE
                               PIC  9(07).
       01  FILLER              REDEFINES JUL-DATE.
           05  J-YEAR          PIC 9999.
           05  J-DAY           PIC 999.

       01  OUTDATE.
           05  OUT-JULDAY.
               10  OUT-JUL     PIC 9(5).
               10  FILLER      PIC XX.
           05  OUTDATE-YMD     REDEFINES OUT-JULDAY.
               10  OUT-YY      PIC XX.
               10  OUT-MM      PIC XX.
               10  OUT-DD      PIC XX.
               10  FILLER      PIC X.

       01  PR-DATE.
           05  PR-DATE-YRMO.
               10  PR-DATE-YYYY.
                   15  PR-DATE-CT  PIC 99.
                   15  PR-DATE-YY  PIC 99.
               10  PR-DATE-MM      PIC 99.
           05  PR-DATE-DD          PIC 99.

       01  PR-ID.
           05  PR-DAY          PIC 9(03) VALUE 999.
           05  PR-TIME         PIC 9(07) VALUE ZEROS.

       01  TIME-IN.
           05  TI-7            PIC 9(07).
           05  TI-8            PIC 9(01).

       01  TODAYS-DATE.
           05  TD-YYYY.
               10  TD-CT       PIC 99.
               10  TD-YY       PIC 99.
           05  TD-MM           PIC 99.
           05  TD-DD           PIC 99.

       01  WS-PR-ID.
           05  WS-PR-DAY        PIC 9(03).
           05  WS-PR-TIME.
               10  WS-PR-TIME-9 PIC 9(07).

       01  PM-SCHED-DATA.
           COPY DPMSCHED       IN COPYLIB.

       LINKAGE SECTION.
           COPY DAYTABLE       IN COPYLIB.

       01  LINK-DATA.
           05 LINK-EQUIP       PIC X(06).
           05 LINK-WONUM.
               10 LINK-WO      PIC X(07).
               10 LINK-SUF     PIC X(03).
           05 LINK-ZONE-PRI    PIC X(06).
           05 LINK-YRMO.
               10 LINK-DATA-X.
                   15  LD-YEAR     PIC X(04).
                   15  LD-MONTH    PIC X(02).
               10 LINK-DATA-9      REDEFINES LINK-DATA-X.
                   15  LD-YR       PIC 9(04).
                   15  LD-YRB      REDEFINES LD-YR.
                       20  LDYR3   PIC 9(03).
                       20  LDYRL   PIC 9.
                   15  LD-MON      PIC 9(02).

       01  DBPARAMETERS.
           COPY DBPARMS        IN COPYLIB.

       01  ERROR-MESSAGE.
           05  ERROR-TEXT      PIC X(70).
           05  ERROR-FILL      PIC X(06).
           05  ERROR-CODE      REDEFINES ERROR-FILL
                               PIC 9(06).

       PROCEDURE DIVISION      USING DAY-TABLE-DATA
                               LINK-DATA
                               DBPARAMETERS
                               ERROR-MESSAGE.

       START-PROCESSING.
           OPEN I-O            PM-RLSE-DATE
                               PM-RLSE-YRMO.
           ACCEPT CURR-DATE    FROM DATE.
           MOVE CD-YY          TO TD-YY.
           MOVE CD-MM          TO TD-MM.
           MOVE CD-DD          TO TD-DD.
           MOVE 20             TO TD-CT.
           IF TD-YY > 90
               MOVE 19         TO TD-CT.

           MOVE ZEROS          TO SUB WS-LAST-PR-TIME.
           MOVE SPACES         TO ERROR-MESSAGE DELETE-PR-TABLE.

       START-LOOP.
           MOVE LINK-YRMO      TO PMRLSEYRMO OF PM-YRMO-REC.
           START PM-RLSE-YRMO  KEY = PMRLSEYRMO OF PM-YRMO-REC
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
               GO TO WRITE-DATA.

       READ-LOOP.
           READ PM-RLSE-YRMO   NEXT INTO PM-SCHED-DATA
               AT END          MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
               GO TO WRITE-DATA.

           IF SCH-RELEASE-YRMO NOT = LINK-YRMO
               GO TO WRITE-DATA.

           IF SCH-EQUIP-NUM NOT = LINK-EQUIP
               GO TO READ-LOOP.

           IF SCH-WO NOT = LINK-WO
               GO TO READ-LOOP.

           IF SCH-REC-TYPE = "CLPR"
               GO TO READ-LOOP.

           IF SCH-REC-TYP NOT = "CL"
               GO TO READ-LOOP.

           IF SCH-REL-DATA = DD-DATA(SCH-REL-DAY)
               MOVE SPACES     TO DAY-DATA(SCH-REL-DAY)
               GO TO READ-LOOP.

           IF SCH-PREREL-DATE NOT = SPACES
               ADD 1                 TO SUB
               MOVE SCH-RELEASE-DATE TO DPR-RDT(SUB)
               MOVE SCH-EQUIP-NUM    TO DPR-EQP(SUB)
               MOVE SCH-PREREL-DATE  TO DPR-PRD(SUB)
               MOVE SCH-PR-ID        TO DPR-PRID(SUB).

           DELETE              PM-RLSE-YRMO
              INVALID KEY      MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
               DISPLAY "   "
               DISPLAY "  DELETE RELEASE RECORD:"
               DISPLAY PM-SCHED-DATA
               DISPLAY "  FILE-STATUS = " FILE-STAT
               DISPLAY "   ".

           GO TO READ-LOOP.

       WRITE-DATA.
           PERFORM WRITE-RECORDS THRU WR-EXIT
                               VARYING SUB FROM 1 BY 1
                               UNTIL SUB > 31.

       DELETE-PR-DATA.
           IF DELETE-PR-TABLE NOT = SPACES
               PERFORM DELETE-PR-RECS THRU DPR-EXIT
                               VARYING SUB FROM 1 BY 1
                               UNTIL SUB > 31.

       END-OF-JOB.
            CLOSE              PM-RLSE-DATE
                               PM-RLSE-YRMO.
            GOBACK.

       WRITE-RECORDS.
           IF DAY-DATA(SUB) NOT = SPACES
               MOVE DAY-DATA(SUB) TO PM-SCHED-DATA
           ELSE
               GO TO WR-EXIT.

           IF DD-REST-PR(SUB) IS NUMERIC AND DD-REST-PR(SUB) > 0
               PERFORM CALC-PR-DATE THRU CPD-EXIT
               PERFORM CALC-PR-ID   THRU CPI-EXIT
               MOVE    PR-ID        TO   SCH-PR-ID
               MOVE    PR-DATE      TO   SCH-PREREL-DATE.

           MOVE 5              TO SCH-PRIORITY.

           WRITE PM-YRMO-REC   FROM PM-SCHED-DATA
              INVALID KEY      MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
               DISPLAY "   "
               DISPLAY "  WRITE RELEASE RECORD:"
               DISPLAY PM-SCHED-DATA
               DISPLAY "  FILE-STATUS = " FILE-STAT
               DISPLAY "   ".

           IF DD-REST-PR(SUB) NOT NUMERIC OR DD-REST-PR(SUB) = 0
               GO TO WR-EXIT.

           MOVE "PR"             TO SCH-REC-PR.
           MOVE SCH-RELEASE-DATE TO SCH-PREREL-DATE.
           MOVE PR-DATE          TO SCH-RELEASE-DATE.
           MOVE PR-DATE-YRMO     TO SCH-RELEASE-YRMO.

           WRITE PM-YRMO-REC   FROM PM-SCHED-DATA
              INVALID KEY      MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
               DISPLAY "   "
               DISPLAY "  WRITE PRE-RELEASE RECORD:"
               DISPLAY PM-SCHED-DATA
               DISPLAY "  FILE-STATUS = " FILE-STAT
               DISPLAY "   ".

       WR-EXIT.                EXIT.

       DELETE-PR-RECS.
           IF DEL-PR(SUB) = SPACES
               MOVE 32         TO SUB
               GO TO DPR-EXIT.

           MOVE DPR-PRD(SUB)   TO PMRLSEDATE OF PM-DATE-REC.
           PERFORM START-PR-LOOP THRU STRT-PR-EXIT.

       DPR-EXIT.               EXIT.

       START-PR-LOOP.
           START PM-RLSE-DATE  KEY = PMRLSEDATE OF PM-DATE-REC
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
               GO TO STRT-PR-EXIT.

       READ-PR-LOOP.
           READ PM-RLSE-DATE   NEXT INTO PM-SCHED-DATA
               AT END          MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
               GO TO STRT-PR-EXIT.

           IF SCH-RELEASE-DATE NOT = DPR-PRD(SUB)
               GO TO STRT-PR-EXIT.

           IF SCH-PR-ID NOT = DPR-PRID(SUB)
               GO TO READ-PR-LOOP.

           DELETE              PM-RLSE-DATE
              INVALID KEY      MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
               DISPLAY "   "
               DISPLAY "  DELETE PRE-RELEASE RECORD:"
               DISPLAY PM-SCHED-DATA
               DISPLAY "  FILE-STATUS = " FILE-STAT
               DISPLAY "   ".

           GO TO READ-PR-LOOP.

       STRT-PR-EXIT.           EXIT.

       CALC-PR-DATE.
           MOVE SCH-RELEASE-DATE TO GREG-DATE.
           MOVE SPACES         TO JUL-DATE D-PARM L-PARM.
           CALL "JULGREG"      USING
                               GREG-DATE
                               JUL-DATE
                               D-PARM
                               L-PARM.

           MOVE J-DAY          TO JUL-SIGN.
           SUBTRACT SCH-REST-PR FROM JUL-SIGN.
           PERFORM UNTIL       JUL-SIGN > 0
               ADD 365         TO JUL-SIGN
               SUBTRACT 1      FROM J-YEAR
           END-PERFORM.

           MOVE JUL-SIGN       TO J-DAY.
           MOVE SPACES         TO GREG-DATE.
           CALL "JULGREG"      USING
                               GREG-DATE
                               JUL-DATE
                               D-PARM
                               L-PARM.

           MOVE GREG-DATE      TO PR-DATE.

       CPD-EXIT.               EXIT.

       CALC-PR-ID.
           MOVE TODAYS-DATE    TO GREG-DATE.
           MOVE SPACES         TO JUL-DATE D-PARM L-PARM.
           CALL "JULGREG"      USING
                               GREG-DATE
                               JUL-DATE
                               D-PARM
                               L-PARM.

           MOVE J-DAY          TO WS-PR-DAY PR-DAY.
           ACCEPT TIME-IN      FROM TIME.
           MOVE TI-7           TO WS-PR-TIME.
           IF WS-PR-TIME-9 NOT > WS-LAST-PR-TIME
               ADD 1           TO WS-LAST-PR-TIME GIVING WS-PR-TIME-9.
           MOVE WS-PR-TIME-9   TO WS-LAST-PR-TIME PR-TIME.

       CPI-EXIT.               EXIT.

      *******************  END OF PROGRAM  -  SPMSCHUP  *****************
