009000**                                                          **
009100**************************************************************
009200
009300 COPY VCOMAREA   IN COPYLIB.
009400 01  MESSAGE-BUFFER.
009500     05  MSG-TEXT.
               10  MESSAGE-BUFFER-1        PIC X(1)  VALUE SPACES.
               10  FILLER                  PIC X(67) VALUE SPACES.
009600     05  MSG-FLD                     PIC X(8)  VALUE SPACES.
009700     05  MSG-FLD-9 REDEFINES MSG-FLD PIC ZZZZZZZ9.
009800
009900 01  MSG-BUFFLEN          PIC S9(4)  BINARY VALUE 76.
010000 01  MSG-ACTUALEN         PIC S9(4)  BINARY VALUE 76.
010100
010200 01  FORMFILE.
010300     05  FORM-FNAME                PIC X(8)  VALUE "FRMCORR".
010400     05  FILLER                    PIC X     VALUE ".".
010500     05  FORM-GNAME.
010600         10  FORM-GNAME1           PIC X(5)  VALUE "FLANG".
010700         10  FORM-GNAME2           PIC X(3)  VALUE SPACES.
010800     05  FILLER                    PIC X(19) VALUE SPACES.
010900
011000 01  FIELD-NUMBER         PIC S9(4) BINARY VALUE 1.
011100 01  SCREEN-BUFFLEN       PIC S9(4) BINARY VALUE 408.
011200 01  NUMBER-OF-FORMS      PIC S9(4) BINARY VALUE 21.
011300
       01  DE-FIELDS.
           05  DE-COMMAND-LINE           PIC X(79).
           05  DE-MESSAGE-LINE           PIC X(79).

