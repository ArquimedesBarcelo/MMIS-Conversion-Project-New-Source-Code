014200**************************************
014300*                                    *
014400*    NATIVE LANGUAGE SUPPORT AREA    *
014500*                                    *
014600**************************************
014700
014800 COPY LANGUAGE   IN COPYLIB.
014900
015100 PROCEDURE DIVISION.
015200 1-HOUSEKEEP.
           MOVE "C" TO MCXCBLERR-SCOPE.
           CALL "MCXCBLERR" USING MCXCBLERR-SCOPE.

015300*--------- MULTIPLE STOREROOM DATA DOES NOT APPLY TO THIS MODULE.
015400*--------- ONLY SINGLE ISSUE/RETURN ARE USED, MULT STR APPLIES ONLY
015500*--------- TO WORKSHEETS.
015600     MOVE SPACES                   TO   MULTIPLE-STR-DATA.
015700
015800     CALL "TESCSEQ" USING ESC-NAME.
           PERFORM 9999-OPEN-STUFF.
015900
019000*------- USE SUBPROG TO OPEN FORMFILE - HANDLES VIEW ERRORS
019100     MOVE "Y"                      TO   CSF-FIRST-OPENFORMF-FLAG.
019200     PERFORM 7150-CALL-CSWITCHF.
019300
019400*------- HANDLE POSSIBLE VIEW ERRORS ON OPENTERM
021200     PERFORM 6-MAIN THRU 6-MAIN-X.
021300
021400 2-EOJ.
           PERFORM 9999-CLOSE-STUFF.
           GOBACK.
022100
022200 2100-BLOWUP.
022300     MOVE "TRMCORR"                TO   BU-PGM-NAME.
022400     CALL "TBLOWUP" USING BASE BU-PGM-NAME STATUS-AREA
022500       VIEW-COMAREA FILE-STATUS BU-DISPLAY-MSG
022600       BU-DISPLAY-FLDS.
022700
024100 6-MAIN.
024200     MOVE "RMCORRMAIN" TO VIEW-NFNAME.
           PERFORM 9951-GETNEXTFORM.
024700
024800 61-SHOWFORM.
024900*----- f1,f2,F3,f6,f7,f8 APPLICATION, f4 REFRESH, f5 PRINT f7 CLR
025000     MOVE 1                        TO   SRF-KEYSET.
025100*-------  MOVE "I" TO   SRF-FKEY (3).
           PERFORM 9953-PUTBUFFER.
           PERFORM 998-WRITE-SCREEN THRU 9989-WS-X.
           IF MESSAGE-BUFFER-1 NOT = SPACES
               PERFORM 9954-SETERROR
               GO TO 61-SHOWFORM.

025800     IF VIEW-LASTKEY = 8 OR 3
025900         GO TO 6-MAIN-X
026000     ELSE
026100     IF VIEW-LASTKEY = 1
026200         MOVE "RM1"            TO  SCOM-PGM-KEY
026300         CALL "TIRSNGL" USING BASE, MMIS-BASE, STATUS-AREA,
026400           VIEW-COMAREA, STORES-COMAREA, SRF-COMAREA,
026500           SRF-SPOOLER-REC, LANGUAGE-PARMS, MULTIPLE-STR-DATA,
026600           ESC-NAME
026700     ELSE
026800     IF VIEW-LASTKEY = 2
026900         MOVE "RM2"           TO  SCOM-PGM-KEY
027000         CALL "TIRSNGL" USING BASE, MMIS-BASE, STATUS-AREA,
027100           VIEW-COMAREA, STORES-COMAREA, SRF-COMAREA,
027200           SRF-SPOOLER-REC, LANGUAGE-PARMS, MULTIPLE-STR-DATA,
027300           ESC-NAME
027400     ELSE
027500     IF VIEW-LASTKEY = 6
027600         PERFORM 611-MATERIAL-STATUS THRU 612-MT-X.
027700
027800     PERFORM 9955-CLEAR-FORM.
027900
028000     GO TO 6-MAIN.
028100
028200 6-MAIN-X.
028300     EXIT.
028400
028500 611-MATERIAL-STATUS.
028600     MOVE "FCSISINQ"               TO   CSF-NEW-FORMFILE-NAME.
028700     MOVE "N"                      TO   CSF-MODE.
028800     PERFORM 7150-CALL-CSWITCHF.
028900     IF CSF-OPENFORM-ERR-SW = "Y"
029000         GO TO 612-MT-X.
029100
029200     CALL "TMTLSTAT" USING BASE, VIEW-COMAREA,
029300       SRF-MPLTINFO-COMPANY, SRF-SPOOL-PRT-NO, DUMMY-CODE-PARM,
029400       LANGUAGE-PARMS.
029500
029600     MOVE "O"                      TO   CSF-MODE.
029700     PERFORM 7150-CALL-CSWITCHF.
029800
029900 612-MT-X.
030000     EXIT.
030100
030200 7150-CALL-CSWITCHF.
030300     CALL "CSWITCHF" USING VIEW-COMAREA, LANGUAGE-PARMS,
030400       FORMFILE, CSF-PARMS, BU-DISPLAY-MSG.
030500     IF BU-DISPLAY-MSG-1 NOT = SPACES
030600         PERFORM 2100-BLOWUP.
030700
       COPY DISPCALL IN COPYLIB.
       COPY DISPCAL2 IN COPYLIB.
       COPY HCATREAD IN COPYLIB.

       9930-LOCK.
       9940-UNLOCK.
       9951-GETNEXTFORM.
       9952-GETBUFFER.
           MOVE DISPLAY-REC TO DE-FIELDS.

       9953-PUTBUFFER.
           MOVE DE-FIELDS TO DISPLAY-REC.

       9954-SETERROR.
           MOVE B"1" TO IND (99).
           MOVE B"1" TO IND (FIELD-NUMBER).
           MOVE MESSAGE-BUFFER TO DE-MESSAGE-LINE.

       9955-CLEAR-FORM.
           MOVE SPACES TO DE-FIELDS, MESSAGE-BUFFER.

       9956-PUTWINDOW.
       9957-FIELDEDITS.
       9958-INITFORM.
       9959-SHOWFORM.
       9960-SETKEYLABEL.
       9961-AUTOREAD.
       9962-OPENFORM.
       9963-CLOSEFORM.
       9964-FINISHFORM.

       9999-DBGET7-MPLTINFO-PK-I.
           MOVE 0 TO COND-WORD.
           MOVE PLT-ARG TO PLTINFOKEY OF MPLTINFO-PK-REC-I.
           READ MPLTINFO-PK-I INTO BUF-MPLTINFO
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS = "23"
               MOVE 17 TO COND-WORD
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE "DBGET7 ERR 9999-DBGET7-MPLTINFO-PK-I"
                   TO BU-MSG-AREA
               MOVE 99 TO COND-WORD
               PERFORM 2100-BLOWUP.

       9999-OPEN-STUFF.
           OPEN I-O DISPLAY-FILE.
           OPEN INPUT MPLTINFO-PK-I                              .

       9999-CLOSE-STUFF.
           CLOSE DISPLAY-FILE.
           CLOSE      MPLTINFO-PK-I                              .
