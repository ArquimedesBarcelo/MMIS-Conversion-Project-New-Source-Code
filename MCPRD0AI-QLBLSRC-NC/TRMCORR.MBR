006600 COPY TBLOWUP    IN COPYLIB.
006700 COPY CSWITCHF   IN COPYLIB.
006800 COPY TSHWRDFM   IN COPYLIB.
       COPY DISPDAT2   IN COPYLIB.
       COPY IOFEEDBACK IN COPYLIB.
       COPY CATREAD    IN COPYLIB.
006900 COPY MULTSTR    IN COPYLIB.
007000
007100 01  STORES-COMAREA.
007200     05  SCOM-PGM-KEY              PIC X(3)  VALUE SPACES.
007300     05  FILLER                    PIC X(21) VALUE SPACES.
007400
007500 01  RET-CODE                      PIC X(2)  VALUE SPACES.
