       01  FILE-STATUS.
           05  FILE-STATUS-1            PIC X  VALUE "0".
           05  FILE-STATUS-2            PIC X  VALUE "0".
012500
012600 01  BASE                       PIC X(10) VALUE "  STORES;".
012700 01  BASE-2                     PIC X(20) VALUE SPACES.
012800 01  PASSWORD                   PIC X(5)  VALUE "JADE;".
012900 01  MMIS-BASE                  PIC X(8)  VALUE "  MMISA;".
013000 01  MMIS-PASSWORD              PIC X(7)  VALUE "DO-ALL;".
013100
