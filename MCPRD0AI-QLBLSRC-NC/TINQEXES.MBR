000200 IDENTIFICATION DIVISION.
000300 PROGRAM-ID. TINQEXES.
000400*REMARKS.    THIS PROGRAM IS THE EXECUTIVE CONTROLLING PROGRAM
000500*            FOR ALL INQUIRIES.
000600 ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.
       SOURCE-COMPUTER.     AS400.
       OBJECT-COMPUTER.     AS400.
       SPECIAL-NAMES. I-O-FEEDBACK IS I-O-FEEDBACK-AREA
                      LOCAL-DATA IS LOCAL-DATA-AREA.
001000 INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT DISPLAY-FILE
               ASSIGN TO WORKSTATION-ZINQUIRY-SI
               ORGANIZATION IS TRANSACTION
               ACCESS IS SEQUENTIAL
               FILE STATUS IS DSPLY-STATUS
               CONTROL-AREA IS WS-CONTROL.
000700 DATA DIVISION.
       FILE SECTION.
       FD  DISPLAY-FILE
           LABEL RECORDS ARE OMITTED.
       01  DSPLY-REC                    PIC X(2000).
000800 WORKING-STORAGE SECTION.
000900 01  BLOWUP-BASE                  PIC X(16).
       COPY CATREAD IN COPYLIB.
       COPY CPYIND  IN COPYLIB.
001000 COPY CSWITCHF  IN COPYLIB.
       01  DSPLY-STATUS                 PIC XX.
001100 01  ERROR-BUFFER.
001200     05  FILLER                   PIC X(70).
001300     05  E-ERROR                  PIC 9(4).
001400     05  FILLER                   PIC X(6).
       01  EXECUTIVE-DATA.
           05  X-WO-NUM                 PIC X(10).
           05  X-CC-NUM                 PIC X(04).
           05  X-EQUIP-NUM              PIC X(06).
           05  X-PARTS.
               10  PART-1               PIC X(07).
               10  PART-2               PIC X(07).
               10  PART-3               PIC X(07).
               10  PART-4               PIC X(07).
               10  PART-5               PIC X(07).
               10  PART-6               PIC X(07).
               10  PART-7               PIC X(07).
               10  PART-8               PIC X(07).
       COPY IOFEEDBACK IN COPYLIB.
001900 01  PASSWORD-INFORMATION.
002000     05  NAME-OF-PROGRAM     PIC X(08) VALUE "TINQEXES".
002100     05  PROGRAM-TYPE        PIC X(02) VALUE "IN".
002200     05  PROGRAM-RELEASE     PIC X(12) VALUE " E0100010001".
002300     05  PROGRAM-DESCRIPTION.
002400         10  PROG-DESC-A.
                   15  FILLER      PIC X(17) VALUE " EXECUTIVE PROGRA".
                   15  FILLER      PIC X(17) VALUE "M FOR MMIS PLANNE".
                   15  FILLER      PIC X(17) VALUE "R/ENGINEER MODULE".
                   15  FILLER      PIC X(9)  VALUE " - ALLOWS".
002600         10  PROG-DESC-B.
                   15  FILLER      PIC X(17) VALUE " USER TO SELECT W".
                   15  FILLER      PIC X(17) VALUE "/O INQUIRIES OR M".
                   15  FILLER      PIC X(17) VALUE "MIS DATABASE INQU".
                   15  FILLER      PIC X(9)  VALUE "IRIES    ".
002800         10  PROG-FUNCTION   PIC X(60) VALUE SPACES.
003000     05  PASSWORD-FLAG       PIC X.
003100 01  PLT-IDT                      PIC X(4).
       01  SCREEN-LINES.
           05  SCREEN-CMD-LINE          PIC X(79).
           05  SCREEN-ERR-LINE          PIC X(79).
       COPY DBSTAT OF COPYLIB.
003300 COPY TBLOWUP IN COPYLIB.
       COPY WSCONTROL IN COPYLIB.
003400 LINKAGE SECTION.
004100 01  DBPARAMETERS.       COPY DBPARMS OF COPYLIB.
004400 01  ERROR-SWITCH                 PIC S9(4) COMP-4.
       COPY VCOMLINK OF COPYLIB.
005200 PROCEDURE DIVISION USING DBPARAMETERS ERROR-SWITCH
                            VIEW-COMAREA.
005400 BEGIN-PROCESSING.
           PERFORM 1-HSK.
           PERFORM 6-MAIN.
       2-EOJ.
           CLOSE DISPLAY-FILE.
           GOBACK.
       1-HSK.
           OPEN I-O   DISPLAY-FILE.
005500     CALL "TPWORD" USING PASSWORD-INFORMATION.
005900     IF PASSWORD-FLAG = "N"
006000         MOVE "  PWORD" TO BLOWUP-BASE
006100         MOVE "FAILED PASSWORD CHECK - TINQEXES"
006200             TO BU-DISPLAY-MSG
006300         PERFORM 998-BLOWUP.
           MOVE SPACES TO DSPLY-REC.
       6-MAIN.
006400     MOVE "FINQEXEC" TO VIEW-CFNAME.
           MOVE SPACES TO SCREEN-LINES.
           MOVE 66349 TO CATREAD-MSG-NUMBER.
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
           MOVE ERROR-BUFFER TO SCREEN-CMD-LINE.
           MOVE SCREEN-LINES TO DSPLY-REC.
           PERFORM 99-SCREEN-WRITE.
           PERFORM 98-SCREEN-READ.
           MOVE SPACES TO ERROR-BUFFER.
008200     IF VIEW-LASTKEY = 3 GO TO 2-EOJ.
008500     IF VIEW-LASTKEY = 1
008600         PERFORM 60-CALL-WO-INQS UNTIL VIEW-LASTKEY = 3
008700         MOVE 0 TO VIEW-LASTKEY
008800         GO TO 6-MAIN.
009000     IF VIEW-LASTKEY = 2
009100         PERFORM 61-CALL-DB-INQS UNTIL VIEW-LASTKEY = 3
009200         MOVE 0 TO VIEW-LASTKEY
009300         GO TO 6-MAIN.
009500     IF VIEW-LASTKEY = 4
009600         CALL "TQ13SUB" USING DBPARAMETERS VIEW-COMAREA
                                CATREAD-PARMS
009800         MOVE 0 TO VIEW-LASTKEY
009900         GO TO 6-MAIN.
010100     IF VIEW-LASTKEY = 5
010200         CALL "CLINQSAV" USING DBPARAMETERS VIEW-COMAREA
                                 CATREAD-PARMS
010400         MOVE 0 TO VIEW-LASTKEY
010500         GO TO 6-MAIN.
           IF VIEW-LASTKEY = 6
               CALL "SAUTOMLT".
               MOVE 0 TO VIEW-LASTKEY
               GO TO 6-MAIN.
011500 60-CALL-WO-INQS.
           MOVE SPACES TO DSPLY-REC.
011600     MOVE "FINQEXE1" TO VIEW-CFNAME.
           MOVE 66351 TO CATREAD-MSG-NUMBER.
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
           MOVE ERROR-BUFFER TO SCREEN-CMD-LINE.
           MOVE SCREEN-LINES TO DSPLY-REC.
           PERFORM 99-SCREEN-WRITE.
           PERFORM 98-SCREEN-READ.
013300     IF VIEW-LASTKEY = 1
               MOVE SPACES TO DSPLY-REC
013400         MOVE "FINQEX1A" TO VIEW-CFNAME
               PERFORM 99-SCREEN-WRITE
               PERFORM 98-SCREEN-READ
014500         IF VIEW-LASTKEY = 3
014600             NEXT SENTENCE
014700         ELSE
014800         IF VIEW-LASTKEY = 1
014900             CALL "CLQ1INQ" USING DBPARAMETERS VIEW-COMAREA
                                    CATREAD-PARMS
015100             MOVE 0 TO VIEW-LASTKEY
015200         ELSE
015300         IF VIEW-LASTKEY = 2
015400             CALL "CLQ8INQ" USING DBPARAMETERS VIEW-COMAREA
                                    CATREAD-PARMS
015600             MOVE 0 TO VIEW-LASTKEY
               ELSE
               IF VIEW-LASTKEY = 4
020700             CALL "TQ10SUB" USING DBPARAMETERS VIEW-COMAREA
020800                              CATREAD-PARMS
020900             MOVE 0 TO VIEW-LASTKEY
015700         ELSE
015800         MOVE 0 TO VIEW-LASTKEY.
016000     IF VIEW-LASTKEY = 2
016100         CALL "CLQ6INQ" USING DBPARAMETERS VIEW-COMAREA
016200                          CATREAD-PARMS
016300         MOVE 0 TO VIEW-LASTKEY.
016500     IF VIEW-LASTKEY = 4
016600         CALL "TQ7SUB" USING DBPARAMETERS VIEW-COMAREA
016700                         CATREAD-PARMS
016800         MOVE 0 TO VIEW-LASTKEY.
017000     IF VIEW-LASTKEY = 5
018200         CALL "SPMLISTQ" USING DBPARAMETERS
018600         MOVE 0 TO VIEW-LASTKEY.
018800     IF VIEW-LASTKEY = 6
020000         CALL "THISTSUB" USING DBPARAMETERS
020400         MOVE 0 TO VIEW-LASTKEY.
020600     IF VIEW-LASTKEY = 7
               CALL "TSUFFINQ" USING DBPARAMETERS VIEW-COMAREA
               MOVE 0 TO VIEW-LASTKEY.
021100     IF VIEW-LASTKEY = 8
               MOVE 0 TO VIEW-LASTKEY
               MOVE SPACES TO DSPLY-REC
021200         MOVE "FINQEX1B" TO VIEW-CFNAME
               PERFORM 99-SCREEN-WRITE
               PERFORM 98-SCREEN-READ
021600         IF VIEW-LASTKEY = 1
021700             CALL "CLQ11INQ" USING DBPARAMETERS VIEW-COMAREA
021800                               CATREAD-PARMS
022000             MOVE 0 TO VIEW-LASTKEY
022100         ELSE
022200         IF VIEW-LASTKEY = 2
022300             CALL "CLQ12INQ" USING DBPARAMETERS VIEW-COMAREA
022400                               CATREAD-PARMS
022600             MOVE 0 TO VIEW-LASTKEY.
022700 61-CALL-DB-INQS.
           MOVE SPACES TO DSPLY-REC.
022800     MOVE "FINQEXE2" TO VIEW-CFNAME.
           MOVE 66350 TO CATREAD-MSG-NUMBER.
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
           MOVE ERROR-BUFFER TO SCREEN-CMD-LINE.
           MOVE SCREEN-LINES TO DSPLY-REC.
           PERFORM 99-SCREEN-WRITE.
           PERFORM 98-SCREEN-READ.
024500     IF VIEW-LASTKEY = 1
024700*        CALL "TPDISP" USING DBPARAMETERS VIEW-COMAREA
024800*                        PLT-IDT
               CALL "TPINQ" USING DBPARAMETERS VIEW-COMAREA
024900         MOVE 0 TO VIEW-LASTKEY.
025100     IF VIEW-LASTKEY = 2
026500         CALL "TEQRFINQ" USING EXECUTIVE-DATA DBPARAMETERS
027100         MOVE 0 TO VIEW-LASTKEY.
027300     IF VIEW-LASTKEY = 4
027400         CALL "TQ5SUB" USING DBPARAMETERS VIEW-COMAREA
027500                         CATREAD-PARMS
027600         MOVE 0 TO VIEW-LASTKEY.
028400
       98-SCREEN-READ.
           READ DISPLAY-FILE FORMAT IS VIEW-CFNAME
               INDIC IS INDICS.
           ACCEPT IOFEEDBACK FROM I-O-FEEDBACK-AREA.
           MOVE ALL B"0" TO INDICS.
           IF DSPLY-STATUS NOT = "00"
               MOVE 3 TO VIEW-LASTKEY
           ELSE
           MOVE FUNCTION-NUM TO VIEW-LASTKEY.

       99-SCREEN-WRITE.
           WRITE DSPLY-REC FORMAT IS VIEW-CFNAME
               INDIC IS INDICS.
           MOVE ALL B"0" TO INDICS.

028500 998-BLOWUP.
028600     MOVE "TINQEXES" TO BU-PGM-NAME.
028700     CALL "TBLOWUP" USING BLOWUP-BASE BU-PGM-NAME STATUS-AREA
028800                      VIEW-COMAREA DUMMY-KSAM-STAT
028900                      BU-DISPLAY-MSG BU-DISPLAY-FLDS.

       999-CATREAD.
           MOVE SPACES TO ERROR-BUFFER.
           CALL "CCATREAD" USING CATREAD-PARMS.
           MOVE CATREAD-MSG-TEXT TO ERROR-BUFFER.
       999-CATREAD-EXIT.    EXIT.
