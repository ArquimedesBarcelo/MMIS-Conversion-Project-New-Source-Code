000200 IDENTIFICATION DIVISION.
000300 PROGRAM-ID.     TGETFOB.
000400 AUTHOR.         CA YODER.
000500 DATE-WRITTEN.   JULY 1996.
000600 DATE-COMPILED.
000700*INSTALLATION.   THE GOODYEAR TIRE & RUBBER COMPANY.
000800*REMARKS.
000900*
001000*********************************************************
001100*D  T G E T F O B                                       *
001200*D                                                      *
001300*D    THIS PROGRAM COPIES FOB RECORDS FROM MPLTINFO     *
001400*D    TO A FLAT FILE TO BE USED BY TLOADVAL.            *
001500*********************************************************
001600
001700 ENVIRONMENT DIVISION.
001800 CONFIGURATION SECTION.
001900 SOURCE-COMPUTER.
002000 OBJECT-COMPUTER.
002100 INPUT-OUTPUT SECTION.
002200 FILE-CONTROL.

           SELECT FOB-FILE
                  ASSIGN TO DISK-FOBFILE.

           SELECT MPLTINFO-I
                  ASSIGN TO DATABASE-MCFLCS0501
                  ORGANIZATION IS INDEXED
                     ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                  FILE STATUS IS FILE-STATUS.

002500 DATA DIVISION.
002600 FILE SECTION.

002700 FD  FOB-FILE
002800     LABEL RECORDS ARE OMITTED
002900     RECORD CONTAINS 80 CHARACTERS
003000     DATA RECORD IS FOB-REC.
003100 01  FOB-REC.
003200     05  FOB-CODE              PIC X(6).
003300     05  FOB-DESC              PIC X(30).
003400     05  FILLER                PIC X(20).
003500     05  FOB-ERR-NUM           PIC X(6).
003600     05  FILLER                PIC X(18).
003700
       FD  MPLTINFO-I
           LABEL RECORDS ARE STANDARD.
       01  MPLTINFO-I-REC.
           COPY DDS-ALL-FORMATS OF MCFLCS0501.

003800 WORKING-STORAGE SECTION.
003900
004000 01  FILE-STATUS.
004100     05  FILE-STATUS-1         PIC X     VALUE "0".
004200     05  FILE-STATUS-2         PIC X     VALUE "0".
004300
004400 01  MPLTINFO-EOF-SW           PIC X     VALUE "N".
004500 01  RECORD-WRITTEN-SW         PIC X     VALUE "N".
004600
004700 01  HOLD-KEY.
004800     05  HOLD-KEY-1-2          PIC X(2).
004900     05  HOLD-KEY-3-4          PIC X(2).
005000
005100*-------------------------------------------------------------*
005200*                U T I L I T Y   A R E A                      *
005300*-------------------------------------------------------------*
005400
005500 COPY TBLOWUP IN COPYLIB.
005600
005700*-------------------------------------------------------------*
005800*               D A T A B A S E   W O R K                     *
005900*-------------------------------------------------------------*
006000
006100 COPY MPLTINFO IN COPYLIB.
006700
006800 COPY DATAB    IN COPYLIB.

       01  PLT-ARG                   PIC X(4).

      *-------------------------------------------------------------*
      *            P R O C E D U R E   D I V I S I O N              *
      *-------------------------------------------------------------*

007900 PROCEDURE DIVISION.
008000
008100 0-BEGIN.
008200     PERFORM 1-HSK.
008300     PERFORM 6-MAIN UNTIL MPLTINFO-EOF-SW = "Y".
008400     PERFORM 2-EOJ.
008500     GOBACK.
008600
008700 1-HSK.
008800     OPEN OUTPUT FOB-FILE
                INPUT  MPLTINFO-I.

           MOVE "FB  " TO PLT-ARG.
           MOVE PLT-ARG TO PLTINFOKEY OF MPLTINFO-I-REC.
           START MPLTINFO-I KEY >= PLTINFOKEY OF MPLTINFO-I-REC
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE "READ MPLTINFO * 1-HSK"  TO BU-DISPLAY-MSG
               PERFORM 2-BLOWUP
           ELSE
               READ MPLTINFO-I NEXT INTO BUF-MPLTINFO
                   AT END MOVE "Y" TO MPLTINFO-EOF-SW.
010200
010300 2-EOJ.
010400     CLOSE   FOB-FILE
                   MPLTINFO-I.
011000
011100 2-BLOWUP.
011200     MOVE "TGETFOB"               TO BU-PGM-NAME.
011300     CALL "TBLOWUP" USING BASE, BU-PGM-NAME, STATUS-AREA,
011400           DUMMY-VIEW-AREA, DUMMY-KSAM-STAT, BU-DISPLAY-MSG,
011500               BU-DISPLAY-AREA.
011600
011700*-------------------------------------------------------------*
011800*                M A I N   P A R A G R A P H                  *
011900*-------------------------------------------------------------*
012000
012100 6-MAIN.
012200     MOVE MPLTINFO-KEY            TO  HOLD-KEY.
012300     IF HOLD-KEY-1-2 = "FB"
012400         IF RECORD-WRITTEN-SW = "N"
012500             MOVE SPACES          TO  FOB-REC
012600             MOVE "FOBCOD"        TO  FOB-CODE
012700             MOVE "DELIVERY/FOB TERM CODES"
012800                                  TO  FOB-DESC
012900             MOVE "09113"         TO  FOB-ERR-NUM
013000             WRITE FOB-REC
013100             MOVE "Y"             TO  RECORD-WRITTEN-SW
013200         END-IF
013300         MOVE SPACES              TO  FOB-REC
013400         MOVE HOLD-KEY-3-4        TO  FOB-CODE
013500         MOVE MPLTINFO-FOB        TO  FOB-DESC
013600         WRITE FOB-REC
               READ MPLTINFO-I NEXT INTO BUF-MPLTINFO
                   AT END MOVE "Y" TO MPLTINFO-EOF-SW
               END-READ
           ELSE
               MOVE "Y"                 TO  MPLTINFO-EOF-SW.

