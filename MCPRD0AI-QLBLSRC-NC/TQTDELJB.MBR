001100 IDENTIFICATION DIVISION.
001200 PROGRAM-ID.    TQTDELJB.
001300 AUTHOR.        BARBARA WINTER.
001400*DATE-WRITTEN.  SEPTEMBER 1987.
001500*INSTALLATION.  GOODYEAR TIRE AND RUBBER CO.
001600
001700*REMARKS.
001800****************************************************
001900*             T Q T D E L J B                      *
002000* -- JOBSTREAM THAT DELETES ONE OR DATED QUOTES -- *
002100*                                                  *
002200*  IF A QUOTE NUMBER IS PASSED, THIS PROGRAM WILL  *
002300*  DELETE THAT QUOTE.  IF A DATE IS PASSED, ALL    *
002400*  QUOTES WITH AN EXPIRATION DATE OLDER THAN THAT  *
002500*  DATE WILL BE DELETED.                           *
002600*                                                  *
002700*   PARAMETERS:                                    *
002800*   ACCEPT1 - DATE OR QUOTE NUMBER                 *
002900*   ACCEPT2 - "Q" IF ACCEPT1 IS A QUOTE NUMBER;    *
003000*             "D" IF ACCEPT1 IS A DATE             *
003100****************************************************
      *C**************************************************
      *C   02/05/96     WILL MCINTYRE
      *C     REWORKED LOGIC FROM ORIGINAL VERSION
      *C     CONVERTED FROM HP-3000 SOURCE.  PROGRAM
      *C     NOW DELETES QUOTES BY DATE IF PASSED FROM
      *C     THE CALLING PROGRAM.
      *C
      *C   09/03/96     WILL MCINTYRE
      *C     MADE REVISIONS FOR END-OF-CENTURY COMPATABILITY
      *C
      *C   28APR1998    DAVE PLUM
      *C     REVISED TO CORRECT A BUG IN THE FILE-STATUS/COND-WORD
      *C     LOGIC ASSOCIATED WITH THE DVENDITM FILE.
      *C
003200 ENVIRONMENT DIVISION.
003300 CONFIGURATION SECTION.
003400 SOURCE-COMPUTER.    HP-3000.
003500 OBJECT-COMPUTER.    HP-3000.
003600 INPUT-OUTPUT SECTION.
003200 FILE-CONTROL.
            SELECT DVENDITM3-I
              ASSIGN TO DATABASE-MCFLCS0803
              ORGANIZATION IS INDEXED
                 ACCESS MODE IS DYNAMIC
              RECORD KEY IS EXTERNALLY-DESCRIBED-KEY WITH DUPLICATES
              FILE STATUS IS FILE-STATUS.
            SELECT DVENDITM3-O
              ASSIGN TO DATABASE-MCFLCS0803
              ORGANIZATION IS INDEXED
                 ACCESS MODE IS DYNAMIC
              RECORD KEY IS EXTERNALLY-DESCRIBED-KEY WITH DUPLICATES
              FILE STATUS IS FILE-STATUS.
            SELECT DQUOTEXT-O
              ASSIGN TO DATABASE-MCFLCS3801
              ORGANIZATION IS INDEXED
                 ACCESS MODE IS DYNAMIC
              RECORD KEY IS EXTERNALLY-DESCRIBED-KEY WITH DUPLICATES
              FILE STATUS IS FILE-STATUS.
003500 DATA DIVISION.
003800 FILE SECTION.
       FD  DVENDITM3-I
           LABEL RECORDS ARE STANDARD.
       01  DVENDITM3-REC-I.
           COPY DDS-MCRPCS0800  OF MCFLCS0803.
       FD  DVENDITM3-O
           LABEL RECORDS ARE STANDARD.
       01  DVENDITM3-REC-O.
           COPY DDS-MCRPCS0800  OF MCFLCS0803.
       FD  DQUOTEXT-O
           LABEL RECORDS ARE STANDARD.
       01  DQUOTEXT-REC-O.
           COPY DDS-MCRPCS3800  OF MCFLCS3801.
003600 WORKING-STORAGE SECTION.
       01  FILE-STATUS.
           05  FILE-STATUS-1      PIC X.
           05  FILE-STATUS-2      PIC X.
       01  RELATIVE-RECNO         PIC 9(9).

      *------ WS CONTROL AREA
       01  MAJOR-MINOR                 PIC XXXX.
       01  WS-CONTROL.
           02  FUNCTION-NUM            PIC XX.
                   88  EXIT-KEY-F8-USED                     VALUE "08". LVW000LS
                   88  REFRESH-KEY-F4-USED                  VALUE "04". LVW000LS
                   88  ENTER-KEY-USED                       VALUE "00". LVW000LS
                   88  F1-KEY-USED                          VALUE "01". LVW000LS
                   88  F2-KEY-USED                          VALUE "02". LVW000LS
                   88  F3-KEY-USED                          VALUE "03". LVW000LS
                   88  F4-KEY-USED                          VALUE "04". LVW000LS
                   88  F5-KEY-USED                          VALUE "05". LVW000LS
                   88  F6-KEY-USED                          VALUE "06". LVW000LS
                   88  F7-KEY-USED                          VALUE "07". LVW000LS
                   88  F8-KEY-USED                          VALUE "08". LVW000LS
           02 FUN-KEY REDEFINES FUNCTION-NUM PIC XX.
           02 TERMINAL-ID PIC X(10).
           02 FORMAT-NAME PIC X(10).

       01  DISPLAY-STATUS              PIC X(2).

       01  SRF-INDICATORS.
           05  IND OCCURS 99 TIMES   PIC 1 INDICATOR 01.

       01  COMPARE-DATE-CN          PIC X(8)     VALUE SPACES.
004500 01  COMPARE-QUOTE            PIC X(10).
004600*---------- VPRINTFORM
004700 01  SCREEN-PRINT-PARMS.
004800     05  PRINT-CTL            PIC S9(4)    VALUE 1 COMP.
004900     05  PAGE-CTL             PIC S9(4)    VALUE 49    COMP.
005000     05  SPOOL-FIL-OPEN-SW    PIC X        VALUE "Y".
005100 01  RETURN-STATUS            PIC X        VALUE SPACE.
005200
005300 COPY TDATECHK OF COPYLIB.
005400 01  RET-CODE                 PIC X(2)     VALUE "00".
005500*---------- TBLOWUP (PRINTS ERRORS TO AN ERROR FILE "BLOWUP.PUB" +)
005600*---------- (ABORTS PROGRAM.  RUN XBLPRT.OBJECT TO READ ERRORS.)
005700 01  BU-DISPLAY-MSG           PIC X(60)    VALUE SPACES.
005800 01  BU-PGM-NAME              PIC X(8)     VALUE "TQTDELJB".
005900 01  BU-DISPLAY-AREA          PIC X(110)   VALUE ALL "0".
006000 01  BU-DISPLAY-FLDS REDEFINES BU-DISPLAY-AREA.
006100     05  BU-DISPLAY-LINE OCCURS 5 TIMES.
006200         10  BU-DISPLAY-FLD   PIC X(14).
006300         10  BU-DISPLAY-FLD9  PIC S9(8).
006400 01  KSAM-STATUS-AREA         PIC X(2)     VALUE "00".
006500 01  VIEW-COMAREA.
006600     05  FILLER                 PIC X(118) VALUE ALL "0".
006700     05  FILLER                 PIC S9(4)  COMP VALUE 9999.
006900
007000 COPY DATAB OF COPYLIB.
007100
007200 01  QUOTE-ARG.
007300     05  QUOTE-ARG-NUM        PIC X(6)     VALUE SPACES.
007400     05  FILLER               PIC X(4)     VALUE SPACES.
007500 01  VENDOR-ARG               PIC X(10)    VALUE SPACES.
007600 01  VENDOR-SEARCH            PIC X(10)    VALUE "VEN-CODE;".
007700
007800 01  QUOTE-SEARCH             PIC X(10)    VALUE "QUOTE-NUM;".
007900
008000 01  DATASET-NAMES.
008100     05  DSET-NAME            PIC X(16)    VALUE SPACE.
008200     05  DVENDITM             PIC X(16)    VALUE "DVENDITM;".
008300     05  DQUOTEXT             PIC X(16)    VALUE "DQUOTEXT;".
008400     05  AQUOTENUM            PIC X(16)    VALUE "AQUOTENUM;".
008700
008800 COPY DVENDITM  OF COPYLIB.
008900 COPY LANGSUB OF COPYLIB.
009000 COPY DQUOTEXT  OF COPYLIB.
009100 01  BUF-AQUOTENUM              PIC X(10) VALUE SPACES.
       LINKAGE SECTION.
004000 01  ACCEPT-PARM.
004100     05  ACCEPT1.
               10  ACCEPT1-QUOTE    PIC X(6).
               10  FILLER           PIC X(2).
004200     05  ACCEPT2              PIC X.
004300     05  FILLER               PIC X(71).

       01  ACCEPT-PARM2             PIC X(161).
009200
009300*******************************************************************
009400*                     PROCEDURE DIVISION
009500*******************************************************************
009600 PROCEDURE DIVISION USING ACCEPT-PARM, ACCEPT-PARM2.
009700
009800 00-MAIN.
           OPEN I-O DVENDITM3-O DQUOTEXT-O.
           OPEN INPUT DVENDITM3-I.
010700     IF ACCEPT2 = "Q"
010800        MOVE ACCEPT1-QUOTE TO QUOTE-ARG-NUM
010900        PERFORM 700-DELETE-ITEMS THRU 799-EXIT
011000     ELSE
              MOVE ACCEPT1 TO COMPARE-DATE-CN
              PERFORM 100-HOUSEKEEPING        THRU 100-EXIT
              IF NO-ENTRY
                 NEXT SENTENCE
              ELSE
                 MOVE "******" TO COMPARE-QUOTE
011500           PERFORM 200-DELETE-DATED-QUOTES THRU 299-EXIT.
011600
011900     CLOSE DVENDITM3-O DQUOTEXT-O DVENDITM3-I.
012000
012100 09-EXIT.
           GOBACK.

       100-HOUSEKEEPING.
           MOVE SPACES TO QUOTENUM OF DVENDITM3-REC-I.
           MOVE 0 TO COND-WORD.
           START DVENDITM3-I KEY > QUOTENUM OF DVENDITM3-REC-I
             INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
              IF FILE-STATUS-1 = "2"
                 MOVE 17 TO COND-WORD
              ELSE
                 MOVE 99 TO COND-WORD.
           IF NO-ENTRY
              GO TO 100-EXIT.
           IF NOT GOOD-CALL
              MOVE "START  DVENDITM 100 TQTDELJB" TO BU-DISPLAY-MSG
              PERFORM 990-BLOWUP THRU 999-EXIT.

       100-EXIT.
           EXIT.

012200 200-DELETE-DATED-QUOTES.
           MOVE 0 TO COND-WORD.
           READ DVENDITM3-I NEXT INTO BUF-DVENDITM
                AT END MOVE  FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   MOVE 15 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.
030400     IF END-OF-CHAIN
030500        GO TO 299-EXIT.
030600     IF NOT GOOD-CALL
030700        MOVE "READNEXT DVENDITM 200 TQTDELJB" TO BU-DISPLAY-MSG
030800        PERFORM 990-BLOWUP THRU 999-EXIT.
           IF QUOTENUM OF DVENDITM3-REC-I = COMPARE-QUOTE
              GO TO 200-DELETE-DATED-QUOTES.
013100     MOVE QUOTENUM OF DVENDITM3-REC-I TO QUOTE-ARG
013200                                         COMPARE-QUOTE.
013300     PERFORM 700-DELETE-ITEMS THRU 799-EXIT.
013400     GO TO 200-DELETE-DATED-QUOTES.

013500 299-EXIT.  EXIT.
013600
013700 700-DELETE-ITEMS.
           MOVE 0 TO COND-WORD.
           MOVE QUOTE-ARG TO QUOTENUM OF DVENDITM3-REC-O.
           START DVENDITM3-O KEY = QUOTENUM OF DVENDITM3-REC-O
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
                   MOVE 17 TO COND-WORD
               ELSE
DP9804             MOVE 99 TO COND-WORD
DP9804     ELSE
DP9804         MOVE 0 TO COND-WORD.

           IF NO-ENTRY
              GO TO 799-EXIT.

           IF NOT GOOD-CALL
              MOVE "DBFIND  DVENDITM 700 TQTDELJB" TO BU-DISPLAY-MSG
DP9804        MOVE QUOTE-ARG TO BU-DISPLAY-FLD (1)
              PERFORM 990-BLOWUP THRU 999-EXIT.

       705-READNEXT-ITEM.
           MOVE 0 TO COND-WORD.
           READ DVENDITM3-O NEXT INTO BUF-DVENDITM
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   MOVE 15 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.
           IF QUOTENUM OF DVENDITM3-REC-O NOT = QUOTE-ARG
               MOVE 15 TO COND-WORD.

049200     IF END-OF-CHAIN
              PERFORM 830-UNLOCK-DVENDITM THRU 839-EXIT
049300        GO TO 770-DELETE-PARAGRAPH.

049400     IF NOT GOOD-CALL
049500        MOVE "DBGET DVENDITM 705 TQTDELJB" TO BU-DISPLAY-MSG
049600        PERFORM 990-BLOWUP THRU 999-EXIT.
049700
047100 750-DELETE-QUOTE.

      *-----  ENSURE THAT RECORD IS A QUOTE ITEM, AND CHECK
      *-----  ONLY RECORDS THAT HAVE AN EXPIRATION DATE VALUE.

           IF VEN-QUOTE-FLAG NOT = "Q"
              GO TO 705-READNEXT-ITEM.

           IF ACCEPT2 = "D"
              IF VEN-ITM-PRICE-DATE-CN = SPACES
                 GO TO 705-READNEXT-ITEM
              ELSE
                 IF VEN-ITM-PRICE-DATE-CN > COMPARE-DATE-CN
                    GO TO 705-READNEXT-ITEM
                 END-IF
              END-IF
           END-IF.

           MOVE 0 TO COND-WORD.
           DELETE DVENDITM3-O
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD.
049400     IF NOT GOOD-CALL
049500        MOVE "DBDELETE DVENDITM 750 TQTDELJB" TO BU-DISPLAY-MSG
049600        PERFORM 990-BLOWUP THRU 999-EXIT.
049700
           GO TO 705-READNEXT-ITEM.
051000
051100 770-DELETE-PARAGRAPH.
           MOVE 0 TO COND-WORD.
           MOVE QUOTE-ARG TO QUOTENUM OF DQUOTEXT-REC-O.
           START DQUOTEXT-O KEY = QUOTENUM OF DQUOTEXT-REC-O
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
                   MOVE 17 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.
051600       IF NOT GOOD-CALL
051700          GO TO 799-EXIT.
052100
052500 775-GET-TEXT.
           MOVE 0 TO COND-WORD.
           READ DQUOTEXT-O  NEXT INTO BUF-DQUOTEXT
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   MOVE 15 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.
           IF QUOTENUM OF DQUOTEXT-REC-O NOT = QUOTE-ARG
               MOVE 15 TO COND-WORD.
052800     IF END-OF-CHAIN
              PERFORM 820-UNLOCK-DQUOTEXT THRU 829-EXIT
052900        GO TO 799-EXIT.
053000     IF NOT GOOD-CALL
053100        MOVE "DBGET DQUOTEXT AT 775 IN CQTPRT" TO BU-DISPLAY-MSG
053200        MOVE QUOTE-ARG TO BU-DISPLAY-FLD (1)
053300        PERFORM 990-BLOWUP THRU 999-EXIT.
053400
           MOVE 0 TO COND-WORD.
           DELETE DQUOTEXT-O
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD.
054400
055900     GO TO 775-GET-TEXT.
056000 799-EXIT.  EXIT.

       820-UNLOCK-DQUOTEXT.
      *------- DO A START > HIGH-VALUES TO UNLOCK
           MOVE HIGH-VALUES TO QUOTENUM OF DQUOTEXT-REC-O.
           START DQUOTEXT-O KEY > QUOTENUM OF DQUOTEXT-REC-O
               INVALID KEY MOVE "00" TO FILE-STATUS.
       829-EXIT.  EXIT.
057100
       830-UNLOCK-DVENDITM.
      *------- DO A START > HIGH-VALUES TO UNLOCK
           MOVE HIGH-VALUES TO QUOTENUM OF DVENDITM3-REC-O.
           START DVENDITM3-O KEY > QUOTENUM OF DVENDITM3-REC-O
               INVALID KEY MOVE "00" TO FILE-STATUS.
       839-EXIT.  EXIT.
023500 990-BLOWUP.
023600     CALL "TBLOWUP" USING BASE, BU-PGM-NAME, STATUS-AREA,
023700                   VIEW-COMAREA, KSAM-STATUS-AREA, BU-DISPLAY-MSG,
023800                   BU-DISPLAY-FLDS.
023900 999-EXIT.     EXIT.
