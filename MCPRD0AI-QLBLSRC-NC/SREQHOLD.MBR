       IDENTIFICATION DIVISION.
       PROGRAM-ID.     SREQHOLD.
       AUTHOR.         ANNETTE M. KRAUSS.
       INSTALLATION.   THE GOODYEAR TIRE AND RUBBER COMPANY - AKRON.
       DATE-WRITTEN.   JUNE 9, 1987.
       DATE-COMPILED.
      *REMARKS.
      **************************************************************
      *                                                            *
      *D   SREQHOLD     REQUISTION HOLD CODES SUBPROGRAM           *
      *D                                                           *
      **************************************************************
       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.
       SOURCE-COMPUTER.  IBM-AS400.
       OBJECT-COMPUTER.  IBM-AS400.
       SPECIAL-NAMES. I-O-FEEDBACK IS I-O-FEEDBACK-AREA.
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
            SELECT DISPLAY-FILE
                   ASSIGN TO WORKSTATION-ZPLTSTUP-SI
                   ORGANIZATION IS TRANSACTION
                   ACCESS IS SEQUENTIAL
                   FILE STATUS IS DISPLAY-STATUS
                   CONTROL-AREA IS WS-CONTROL.
            SELECT MVALIDPLT-O
                   ASSIGN TO DATABASE-MCFLCS1701
                   ORGANIZATION IS INDEXED
                   ACCESS IS DYNAMIC
                   RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                   FILE STATUS IS FILE-STATUS.

       DATA DIVISION.
       FILE SECTION.
       FD  DISPLAY-FILE
           LABEL RECORDS ARE OMITTED.
       01  DISPLAY-REC.
           COPY DD-REQHOLDSTA-O OF ZPLTSTUP.
           COPY DD-REQHOLDSTM-O OF ZPLTSTUP.
           COPY DD-HELP3-O      OF ZPLTSTUP.
       FD  MVALIDPLT-O
           LABEL RECORDS ARE STANDARD.
       01  MVALIDPLT-O-REC.
           COPY DDS-MCRPCS1700 OF MCFLCS1701.
       WORKING-STORAGE SECTION.
       01  FILE-STATUS.
           05  FILE-STATUS-1                 PIC X VALUE SPACE.
           05  FILE-STATUS-2                 PIC X VALUE SPACE.
       01  REQ-HOLD-ARG.
           05  FILLER                        PIC X VALUE "S".
           05  REQ-HOLD-IN                   PIC XX.
           05  FILLER                        PIC X(7) VALUE SPACES.
      *************************************************************
      **                                                         **
      **              D A T A    B A S E    A R E A              **
      **                                                         **
      *************************************************************
      *************************************************************

       COPY MVALDPLT IN COPYLIB.
       COPY DBSTAT IN COPYLIB.
       01  MESSAGE-BUFFER.
           05  MSG-TEXT                    PIC X(64)  VALUE SPACES.
           05  MSG-FLD                     PIC X(12)  VALUE SPACES.
           05  MSG-FLD-9 REDEFINES MSG-FLD
                                           PIC Z(11)9.

      *************************************************************
      *************************************************************
      **                                                         **
      **                 TERMINAL I/O DATA AREA                  **
      **                                                         **
      *************************************************************
      *************************************************************

       01  REQ-HOLD-SCREEN.
           05  ADD-REQ-HOLD-INFO.
               10  REQ-HOLD-CODE1        PIC X(2).
               10  REQ-HOLD-DESC1        PIC X(10).
           05  MODIFY-REQ-HOLD-INFO.
               10  REQ-HOLD-CODE2        PIC X(2).
               10  REQ-HOLD-DESC2        PIC X(10).
           05  REQ-HOLD-MSGLINE          PIC X(79).
           05  CMDLINE                   PIC X(79).
           05  ERR-MSGLINE               PIC X(79).
       01 HELP-SCREEN.
           05  HELP-CMDLINE              PIC X(79).
           05  HELP-MSGLINE              PIC X(79).
       COPY TBLOWUP IN COPYLIB.
       COPY CATREAD IN COPYLIB.
       COPY DISPDATA IN COPYLIB.
       COPY IOFEEDBACK IN COPYLIB.

      *************************************************************
      *************************************************************
      **                                                         **
      **               LINKAGE   SECTION                         **
      **                                                         **
      *************************************************************
      *************************************************************

       LINKAGE SECTION.

       01  BASE                          PIC X(10).
       COPY VCOMLINK IN COPYLIB.
       COPY LANGSUB IN COPYLIB.


      *************************************************************
      **#########################################################**
      *************************************************************
      **                                                         **
      **          P R O C E D U R E    D I V I S I O N           **
      **                                                         **
      *************************************************************
      **#########################################################**
      *************************************************************

       PROCEDURE DIVISION USING BASE,
                                VIEW-COMAREA,
                                LANGUAGE-PARMS.


       MAIN-PGM SECTION 01.

       BEGIN-HERE.
           PERFORM 1-HSK.
           PERFORM 6-MAIN THRU 6-MAIN-X.
           PERFORM 2-EOJ.

       1-HSK.
           MOVE "SREQHOLD" TO BU-PGM-NAME.
           OPEN I-O DISPLAY-FILE, MVALIDPLT-O.

       2-EOJ.
           CLOSE DISPLAY-FILE, MVALIDPLT-O.
           GOBACK.

      ******************************************************
      **                 BLOWUP ROUTINE                   **
      ******************************************************

       2-BLOWUP.
           CALL "TBLOWUP" USING BASE, BU-PGM-NAME, STATUS-AREA,
               VIEW-COMAREA, FILE-STATUS, BU-DISPLAY-MSG,
               BU-DISPLAY-AREA.


      **************************************************
      *                                                *
      *                  6 - M A I N                   *
      *                                                *
      **************************************************

       6-MAIN.
           MOVE SPACES TO REQ-HOLD-SCREEN.

       6-PUT-BUFFER.
      ***  INPUT DATA ABOVE AND PRESS 'ENTER'  ***
           MOVE   9 TO LANG-SETNUM.
           MOVE  20 TO LANG-MSGNUM.
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
           MOVE MESSAGE-BUFFER TO REQ-HOLD-MSGLINE.

       6-SHOW-FORM.
           MOVE "REQHOLDSTA" TO VIEW-NFNAME.
           MOVE REQ-HOLD-SCREEN TO DISPLAY-REC.
           PERFORM 998-WRITE-SCREEN THRU 998-READ-SCREEN.
           MOVE DISPLAY-REC     TO REQ-HOLD-SCREEN.

       6-READ-FIELDS.
           IF VIEW-LASTKEY = 3
               GO TO 6-MAIN-X.
           IF VIEW-LASTKEY = 1
               PERFORM 65-HELP-SCREEN THRU 65-HELP-SCREEN-X
               GO TO 6-SHOW-FORM
           ELSE
           IF VIEW-LASTKEY = 2 OR
              VIEW-LASTKEY = 4 OR
              VIEW-LASTKEY = 5 OR
              VIEW-LASTKEY = 6 OR
              VIEW-LASTKEY = 7 OR
              VIEW-LASTKEY = 8
      *****    INVALID FUNCTION KEY    *****
               MOVE   9 TO LANG-SETNUM
               MOVE  10 TO LANG-MSGNUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER TO ERR-MSGLINE
               MOVE B"1" TO IND(99)
               GO TO 6-SHOW-FORM.

       6-EDIT-CHECKS.
           IF REQ-HOLD-CODE1 NOT = SPACES AND
              REQ-HOLD-CODE2 NOT = SPACES
      *CHOOSE ONLY ONE OPTION
               MOVE  66135 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER TO ERR-MSGLINE
               MOVE B"1" TO IND(99), IND(7)
               GO TO 6-SHOW-FORM.

           IF REQ-HOLD-CODE1 NOT = SPACES
                  MOVE REQ-HOLD-CODE1 TO REQ-HOLD-IN
                  MOVE REQ-HOLD-ARG   TO VALDTAKEY OF MVALIDPLT-O-REC
                  START MVALIDPLT-O KEY = VALDTAKEY OF MVALIDPLT-O-REC
                      INVALID KEY MOVE FILE-STATUS TO FILE-STATUS
                  END-START
                  IF FILE-STATUS = "00"
      ****  REQ. HOLD STATUS CODE ALREADY EXISTS -- CANNOT ADD  ****
                      MOVE  18 TO LANG-SETNUM
                      MOVE  36 TO LANG-MSGNUM
                      PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                      MOVE MESSAGE-BUFFER TO ERR-MSGLINE
                      MOVE B"1" TO IND(99), IND(7)
                      GO TO 6-SHOW-FORM
                  ELSE
                  IF FILE-STATUS-1 = "2"
                      IF REQ-HOLD-DESC1 = SPACES
      *** DESCRIPTION REQUIRED
                          MOVE 30042 TO CATREAD-MSG-NUMBER
                          PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                          MOVE MESSAGE-BUFFER TO ERR-MSGLINE
                          MOVE B"1" TO IND(99), IND(10)
                          GO TO 6-SHOW-FORM
                      ELSE
                          PERFORM 61-ADD-MVALDPLT
                  ELSE
                      MOVE "START MVALDPLT ERROR IN 6-EDIT-CHECK"
                          TO BU-DISPLAY-MSG
                      MOVE REQ-HOLD-ARG TO BU-DISPLAY-FLD (1)
                      PERFORM 2-BLOWUP.

           IF REQ-HOLD-CODE2 NOT = SPACES
              MOVE REQ-HOLD-CODE2 TO REQ-HOLD-IN
              MOVE REQ-HOLD-ARG   TO VALDTAKEY OF MVALIDPLT-O-REC
              START MVALIDPLT-O KEY = VALDTAKEY OF MVALIDPLT-O-REC
                  INVALID KEY MOVE FILE-STATUS TO FILE-STATUS
              END-START
              IF FILE-STATUS-1 = "2"
      **** REQ. HOLD STATUS DOES NOT EXIST -- CANNOT MODIFY/DELETE ****
                  MOVE  18 TO LANG-SETNUM
                  MOVE  37 TO LANG-MSGNUM
                  PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                  MOVE MESSAGE-BUFFER TO ERR-MSGLINE
                  MOVE B"1" TO IND(99), IND(7)
                  GO TO 6-SHOW-FORM
              ELSE
              IF FILE-STATUS = "00"
                      PERFORM 62-MODIFY-MVALDPLT THRU
                                  62-MODIFY-MVALDPLT-X
              ELSE
                  MOVE "START MVALDPLT ERROR IN 6-EDIT-CHECK"
                      TO BU-DISPLAY-MSG
                  MOVE REQ-HOLD-ARG TO BU-DISPLAY-FLD (1)
                  PERFORM 2-BLOWUP.

           GO TO 6-MAIN.

       6-MAIN-X.
           EXIT.

       61-ADD-MVALDPLT.
           MOVE SPACES         TO BUF-MVALIDPLTDATA.
           MOVE REQ-HOLD-ARG   TO VALID-DATA-KEY.
           MOVE REQ-HOLD-DESC1 TO VALID-DATA-DESC.
           WRITE MVALIDPLT-O-REC FROM BUF-MVALIDPLTDATA
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE "READ MVALDPLT ERROR IN 61-ADD-MVALDPLT"
                    TO BU-DISPLAY-MSG
               MOVE REQ-HOLD-ARG TO BU-DISPLAY-FLD (1)
               PERFORM 2-BLOWUP.

       62-MODIFY-MVALDPLT.
           READ MVALIDPLT-O NEXT INTO BUF-MVALIDPLTDATA
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
             OR VALID-DATA-KEY NOT = REQ-HOLD-ARG
               MOVE "READ NEXT ERROR 62-PUT-BUFFER"
                   TO BU-DISPLAY-MSG
               MOVE REQ-HOLD-ARG TO BU-DISPLAY-FLD (1)
               PERFORM 2-BLOWUP.
           MOVE VALID-DATA-DESC TO REQ-HOLD-DESC2.
      ***  INPUT DATA ABOVE AND PRESS 'ENTER'  ***
           MOVE   9 TO LANG-SETNUM.
           MOVE  20 TO LANG-MSGNUM.
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
           MOVE MESSAGE-BUFFER TO REQ-HOLD-MSGLINE.

       62-SHOW-FORM.
           MOVE "REQHOLDSTM" TO VIEW-NFNAME.
           MOVE REQ-HOLD-SCREEN TO DISPLAY-REC.
           PERFORM 998-WRITE-SCREEN THRU 998-READ-SCREEN.
           MOVE DISPLAY-REC     TO REQ-HOLD-SCREEN.

       62-READ-FIELDS.
           IF VIEW-LASTKEY = 3
               GO TO 62-MODIFY-MVALDPLT-X.
           IF VIEW-LASTKEY = 1
               PERFORM 65-HELP-SCREEN THRU 65-HELP-SCREEN-X
               GO TO 62-SHOW-FORM
           ELSE
           IF VIEW-LASTKEY = 2 OR
              VIEW-LASTKEY = 4 OR
              VIEW-LASTKEY = 5 OR
              VIEW-LASTKEY = 6 OR
              VIEW-LASTKEY = 7 OR
              VIEW-LASTKEY = 8
      *****    INVALID FUNCTION KEY    *****
               MOVE   9 TO LANG-SETNUM
               MOVE  10 TO LANG-MSGNUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER TO ERR-MSGLINE
               MOVE B"1" TO IND(99)
               GO TO 62-SHOW-FORM.
           IF REQ-HOLD-DESC2 = SPACES
      *** DESCRIPTION REQUIRED
               MOVE 30042 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER TO ERR-MSGLINE
               MOVE B"1" TO IND(99), IND(10)
               GO TO 62-SHOW-FORM.

       62-REPLACE-MVALDPLT.
           MOVE REQ-HOLD-DESC2 TO VALID-DATA-DESC.
           REWRITE MVALIDPLT-O-REC FROM BUF-MVALIDPLTDATA
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
              MOVE "REWRITE MVALDPLT ERROR IN 62-MODIFY-MVALDPLT"
                   TO BU-DISPLAY-MSG
              MOVE REQ-HOLD-ARG TO BU-DISPLAY-FLD (1)
              PERFORM 2-BLOWUP.


       62-MODIFY-MVALDPLT-X.
            EXIT.

       65-HELP-SCREEN.
           MOVE "HELP3" TO VIEW-NFNAME.
           MOVE SPACES  TO HELP-SCREEN.
           MOVE HELP-SCREEN TO DISPLAY-REC.
           PERFORM 998-WRITE-SCREEN THRU 998-READ-SCREEN.
           MOVE DISPLAY-REC TO HELP-SCREEN.

       65-HELP-SCREEN-X.
            EXIT.

       COPY DISPCALL IN COPYLIB.
       999-CATREAD.
           IF CATREAD-MSG-NUMBER = ZEROS
               MOVE LANG-SETNUM TO CATREAD-MSG-SET
               MOVE LANG-MSGNUM TO CATREAD-MSG-NUM.
           CALL "CCATREAD" USING CATREAD-PARMS.
           MOVE CATREAD-MSG-TEXT TO MESSAGE-BUFFER.

       999-CATREAD-EXIT.
           EXIT.
