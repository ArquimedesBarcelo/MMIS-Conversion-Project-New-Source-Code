000200 IDENTIFICATION DIVISION.
000300 PROGRAM-ID.     CREQREM.
000400 AUTHOR.         C.I.HILLES.
000500 DATE-WRITTEN.   9 JAN 87.
000600 DATE-COMPILED.
000700*INSTALLATION.   GOODYEAR TIRE AND RUBBER CO.
000800*REMARKS.
000900*    THIS PROGRAM WILL RETURN 2 LINES OF REQUISITION REMARKS.
001000*    THE REMARKS IN THE STORES DATABASE ARE STORED AS LINE
001100*    NUMBERS 95 AND 96 OF THE "DREQDESC" DATASET.
001200*
001300 ENVIRONMENT DIVISION.
001400 CONFIGURATION SECTION.
001500 SOURCE-COMPUTER. HP-3000.
001600 OBJECT-COMPUTER. HP-3000.
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT DREQDESC
                  ASSIGN TO DATABASE-MCFLCS2301
                  ORGANIZATION IS INDEXED
                    ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                    WITH DUPLICATES
                  FILE STATUS IS FILE-STATUS.

001700 DATA DIVISION.
       FILE SECTION.
       FD  DREQDESC
           LABEL RECORDS ARE STANDARD.
       01  DREQDESC-REC.
           COPY DDS-MCRPCS2300  OF MCFLCS2301.

001800 WORKING-STORAGE SECTION.
001900**************************************************************
002000**                                                          **
002100**            D A T A B A S E   W O R K                     **
002200**                                                          **
002300**************************************************************
002400 COPY DREQDESC   IN COPYCSIS.
002500
       01  FILE-STATUS.
           05  FILE-STATUS-1            PIC X  VALUE "0".
           05  FILE-STATUS-2            PIC X  VALUE "0".
002600 01  REQ-SEARCH                    PIC X(11) VALUE "REQ-NUMBER;".
002700 01  ALL-ITEMS                     PIC X(2)  VALUE "@;".
002800 01  DSET-DREQDESC                 PIC X(9)  VALUE "DREQDESC;".
002900
003000 01  MODE-AREA.
003100     05  MODE1                  PIC S9(4)   COMP       VALUE 1.
003200     05  MODE6                  PIC S9(4)   COMP       VALUE 6.
003300
003400 LINKAGE SECTION.
003500 01  BASE                          PIC X(10).
003600 01  BASE-MMISA                    PIC X(24).
003700 COPY DBSTAT     IN COPYCSIS.
003800 COPY DREQD      IN COPYCSIS.
003900 01  REQ-STATUS                    PIC X(2).
004000 01  REQ-REMARKS.
004100     05  REMARK-1                  PIC X(79).
004200     05  REMARK-2                  PIC X(79).
004300 01  BU-DISPLAY-MSG.
004400     05  BU-DISPLAY-MSG-1          PIC X(1).
004500     05  FILLER                    PIC X(57).
004600     05  BU-DISPLAY-PART-ERR       PIC X(2).
004700
004800 PROCEDURE DIVISION USING BASE,
004900                          BASE-MMISA,
005000                          STATUS-AREA,
005100                          BUF-DREQD,
005200                          REQ-STATUS,
005300                          REQ-REMARKS,
005400                          BU-DISPLAY-MSG.
005500
005600 6000-MAIN.
005700     MOVE SPACES                   TO   REQ-REMARKS.
           OPEN INPUT DREQDESC.
009400
           MOVE DREQD-REQ-NUMBER TO REQNO OF DREQDESC-REC.
           MOVE "000195" TO ITEMSEQNO OF DREQDESC-REC.
           MOVE 0 TO COND-WORD.
           READ DREQDESC INTO BUF-DREQDESC
               INVALID KEY MOVE 17 TO COND-WORD.
           IF FILE-STATUS-1 = "2"
               MOVE 17 TO COND-WORD
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD.
           IF COND-WORD = 17
               MOVE SPACES TO REMARK-1
           ELSE
           IF COND-WORD = 0
               MOVE REQDESC-DATA TO REMARK-1
           ELSE
               MOVE "CREQREM DREQDESC READ-1 ERROR" TO BU-DISPLAY-MSG
               GO TO 6590-END-JOB.

           MOVE DREQD-REQ-NUMBER TO REQNO OF DREQDESC-REC.
           MOVE "000196" TO ITEMSEQNO OF DREQDESC-REC.
           MOVE 0 TO COND-WORD.
           READ DREQDESC INTO BUF-DREQDESC
               INVALID KEY MOVE 17 TO COND-WORD.
           IF FILE-STATUS-1 = "2"
               MOVE 17 TO COND-WORD
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD.
           IF COND-WORD = 17
               MOVE SPACES TO REMARK-2
           ELSE
           IF COND-WORD = 0
               MOVE REQDESC-DATA TO REMARK-2
           ELSE
               MOVE "CREQREM DREQDESC READ-2 ERROR" TO BU-DISPLAY-MSG
               GO TO 6590-END-JOB.

009500 6590-END-JOB.
           CLOSE DREQDESC.
009600     GOBACK.
