       IDENTIFICATION DIVISION.
       PROGRAM-ID.             TDFEQPCX.
       AUTHOR.                 W. ROXBURY.
      *INSTALLATION.           GOODYEAR TIRE & RUBBER CO.
      *C****************************************************************
      *C  WDR  04/25/94
      *C  DELETED ALL REFERENCES TO PORTABILITY MODE COPYLIBS
      *C****************************************************************

       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.
       SOURCE-COMPUTER.        IBM-AS400.
       OBJECT-COMPUTER.        IBM-AS400.
       COPY SPECIALN           IN COPYLIB.

       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT EQP-EQUIP-EN-I
                  ASSIGN       TO DATABASE-MCFLMM0201
                  ORGANIZATION IS INDEXED
                  ACCESS MODE  IS DYNAMIC
                  RECORD KEY   IS EXTERNALLY-DESCRIBED-KEY
                  FILE STATUS  IS FILE-STATUS.

           SELECT DRAWING-FL-EN-O
                  ASSIGN       TO DATABASE-MCFLDF0103
                  ORGANIZATION IS INDEXED
                  ACCESS MODE  IS DYNAMIC
                  RECORD KEY   IS EXTERNALLY-DESCRIBED-KEY
                               WITH DUPLICATES
                  FILE STATUS  IS FILE-STATUS.

           SELECT DISPLAY-FILE
                  ASSIGN       TO WORKSTATION-ZDFEQPCX-SI
                  ORGANIZATION IS TRANSACTION
                  ACCESS MODE  IS SEQUENTIAL
                  FILE STATUS  IS DISPLAY-STATUS
                  CONTROL-AREA IS WS-CONTROL.

       DATA DIVISION.
       FILE SECTION.
       FD  DISPLAY-FILE
           LABEL RECORDS ARE OMITTED.
       01  DISPLAY-REC        PIC X(1500).

       FD  EQP-EQUIP-EN-I
           LABEL RECORDS IS STANDARD.
       01  EQP-EQUIP-EN-REC-I.
           COPY DDS-ALL-FORMATS OF MCFLMM0201.

       FD  DRAWING-FL-EN-O
           LABEL RECORDS IS STANDARD.
       01  DRAWING-FL-EN-REC-O.
           COPY DDS-ALL-FORMATS OF MCFLDF0103.

       WORKING-STORAGE SECTION.
       77  HANDLE-BLOWUP-FLAG  PIC X      VALUE "Y".
       77  FIND-SW             PIC 9.
       77  REC-CNT             PIC 9(06).
       77  MMISA               PIC X(24) VALUE "  MMISA;".
       77  DRWFIL              PIC X(24) VALUE "  DRWFIL;".
       77  BASE                PIC X(24).
       77  DSET-EQP-EQUIP      PIC X(16) VALUE "EQP-EQUIPMENT;".
       77  DSET-DRAWING-FL     PIC X(16) VALUE "DRAWING-FILE;".
       77  DSET-NAME           PIC X(16) VALUE "DRAWING-FILE;".
       77  EQUIP-NUM-SEARCH    PIC X(16) VALUE "EQP-EQUIP-NUM;".
       77  EQP-NUM-SEARCH      PIC X(16) VALUE "EQUIP-NUM;".
       77  PASSWORD-MMISA      PIC X(08) VALUE "DO-ALL;".
       77  PASSWORD-DRWFIL     PIC X(08) VALUE "DO-ALL;".
       77  TERMFILENAME        PIC X(11) VALUE "TERMLIST;".
       77  EQUIP-NUM-ARG       PIC X(06).
       77  EQP-NUM-ARG         PIC X(06).
       77  ALL-ITEMS           PIC XX    VALUE "@;".

       01  FORMFILE.
           05  FORM-FNAME      PIC X(8)  VALUE "FDFEQPCX".
           05  FILLER          PIC X(1)  VALUE ".".
           05  FORM-GNAME.
               10  FORM-GNAME1 PIC X(5)  VALUE "FLANG".
               10  FORM-GNAME2 PIC X(3)  VALUE SPACES.
           05  FILLER          PIC X(19) VALUE SPACES.

       01  DE-FIELDS-1.
           05  EQP-OLD         PIC X(06).
           05  EQP-NEW         PIC X(06).
           05  COMP-MESSAGES.
               10  COMP-MSG-1  PIC X(34).
               10  C-EQPOLD    PIC X(06).
               10  COMP-MSG-2  PIC X(34).
               10  C-EQPNEW    PIC X(06).
               10  COMP-MSG-3  PIC X(34).
               10  REC-DISP    PIC ZZZZZ9.
           05  SCREEN-MSGS.
               10  DE-COMMAND-LINE-1
                               PIC X(79).
               10  DE-MESSAGE-LINE-1
                               PIC X(79).

       01  BUF-EQP-EQUIPMENT.
           COPY MEQPFILE       IN COPYLIB.

       01  BUF-DRAWING-FILE.
           COPY DDRAWFIL       IN COPYLIB.

           COPY DBSTAT         IN COPYLIB.
           COPY DBMODES        IN COPYLIB.
           COPY CATREAD        IN COPYLIB.
           COPY HMSGBUF        IN COPYLIB.
           COPY FUNCTDEF       IN COPYLIB.
           COPY VCOMAREA       IN COPYLIB.
           COPY DISPDAT2       IN COPYLIB.
           COPY FILESTAT       IN COPYLIB.
           COPY IOFEEDBACK     IN COPYLIB.
           COPY CSWITCHF       IN COPYLIB.
           COPY LANGUAGE       IN COPYLIB.
           COPY TSHWRDFM       IN COPYLIB.
           COPY TBLOWUP        IN COPYLIB.

       PROCEDURE DIVISION.
       BEGIN-PROC.
           PERFORM 9999-OPENS.
           MOVE "N"            TO  SRF-BASE-FLAG
                                   SRF-MPLTINFO-FLAG
                                   SRF-SPOOL-FLAG.
           MOVE "Y"            TO  CSF-FIRST-OPENFORMF-FLAG.
           CALL "CSWITCHF" USING VIEW-COMAREA, LANGUAGE-PARMS,
             FORMFILE, CSF-PARMS, BU-DISPLAY-MSG.
           IF BU-DISPLAY-MSG-1 NOT = SPACES
               PERFORM 2100-BLOWUP.

           CALL "SOPENTRM" USING VIEW-COMAREA, BU-DISPLAY-MSG.
           IF BU-DISPLAY-MSG-1 NOT = SPACES
               PERFORM 2100-BLOWUP.

           MOVE ZERO           TO FIND-SW REC-CNT.
           MOVE DRWFIL         TO BASE.
           MOVE SPACES         TO DE-FIELDS-1.
           MOVE "DFEQPCX"      TO VIEW-NFNAME.
           PERFORM 9999-GETNEXTFORM.
           GO TO 6-SHOWFORM.

       6-RESET-SCREEN.
           MOVE ZERO           TO FIND-SW REC-CNT.
           MOVE SPACES         TO EQP-OLD EQP-NEW.
           PERFORM 9999-RESET-SCREEN.

       6-SHOWFORM.
           PERFORM 9999-DO-SCREEN-1.
           IF VIEW-LASTKEY NOT = 0
               GO TO END-OF-JOB.

       6-EDIT.
           IF EQP-OLD = EQP-NEW
               GO TO 6-RESET-SCREEN.

           IF EQP-OLD = SPACES
      **********************************************************************
      **    MESSAGE 031/016:
      ** EQUIPMENT NUMBER IS REQUIRED
      **********************************************************************
               MOVE 31016      TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD
               MOVE MESSAGE-BUFFER TO DE-COMMAND-LINE-1
               MOVE 1          TO SRF-ERROR-FLD
               MOVE SPACES     TO COMP-MESSAGES
               PERFORM 9999-SETERROR-1
               GO TO 6-SHOWFORM.

           IF EQP-NEW = SPACES
      **********************************************************************
      **    MESSAGE 031/016:
      ** EQUIPMENT NUMBER IS REQUIRED
      **********************************************************************
               MOVE 31016      TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD
               MOVE MESSAGE-BUFFER TO DE-COMMAND-LINE-1
               MOVE 2          TO SRF-ERROR-FLD
               MOVE SPACES     TO COMP-MESSAGES
               PERFORM 9999-SETERROR-1
               GO TO 6-SHOWFORM.

           MOVE EQP-OLD        TO EQUIP-NUM-ARG.
           PERFORM 9999-GETKEY-EQP-EQUIP-EN-I.
           IF NO-ENTRY
      **********************************************************************
      **    MESSAGE 031/010:
      ** EQUIPMENT NUMBER DOES NOT EXIST
      **********************************************************************
               MOVE 31010      TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD
               MOVE MESSAGE-BUFFER TO DE-COMMAND-LINE-1
               MOVE 1          TO SRF-ERROR-FLD
               MOVE SPACES     TO COMP-MESSAGES
               PERFORM 9999-SETERROR-1
               GO TO 6-SHOWFORM.

           MOVE EQP-NEW        TO EQUIP-NUM-ARG.
           PERFORM 9999-GETKEY-EQP-EQUIP-EN-I.
           IF NO-ENTRY
      **********************************************************************
      **    MESSAGE 031/010:
      ** EQUIPMENT NUMBER DOES NOT EXIST
      **********************************************************************
               MOVE 31010      TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD
               MOVE MESSAGE-BUFFER TO DE-COMMAND-LINE-1
               MOVE 2          TO SRF-ERROR-FLD
               MOVE SPACES     TO COMP-MESSAGES
               PERFORM 9999-SETERROR-1
               GO TO 6-SHOWFORM.

       6-MAIN.
           MOVE EQP-OLD        TO EQP-NUM-ARG.
           PERFORM 9999-CHAINHD-DRAWING-FL-EN-O.
           IF NO-ENTRY
             IF FIND-SW = 0
      **********************************************************************
      **    MESSAGE 040/046:
      ** NO RECORDS FOUND FOR THIS EQUIPMENT NUMBER
      **********************************************************************
               MOVE 40046      TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD
               MOVE MESSAGE-BUFFER TO DE-COMMAND-LINE-1
               MOVE 1          TO SRF-ERROR-FLD
               MOVE SPACES     TO COMP-MESSAGES
               PERFORM 9999-SETERROR-1
               GO TO 6-SHOWFORM
             ELSE
               MOVE EQP-OLD    TO C-EQPOLD
               MOVE EQP-NEW    TO C-EQPNEW
               MOVE REC-CNT    TO REC-DISP
               MOVE " ALL RECORDS OF EQUIPMENT NUMBER: "
                               TO COMP-MSG-1
               MOVE "            HAVE BEEN CHANGED TO: "
                               TO COMP-MSG-2
               MOVE "                 RECORDS CHANGED: "
                               TO COMP-MSG-3
               GO TO 6-RESET-SCREEN.

           PERFORM 61-DBGET.
           GO TO 6-MAIN.

       END-OF-JOB.
           PERFORM 9999-CLOSES.
           GOBACK.

       61-DBGET.
           PERFORM 9999-GETNEXT-DRAWING-FL-EN-O.
           IF END-OF-CHAIN
             IF FIND-SW = 0
      **********************************************************************
      **    MESSAGE 040/046:
      ** NO RECORDS FOUND FOR THIS EQUIPMENT NUMBER
      **********************************************************************
               MOVE 40046      TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD
               MOVE MESSAGE-BUFFER TO DE-COMMAND-LINE-1
               MOVE 1          TO SRF-ERROR-FLD
               MOVE SPACES     TO COMP-MESSAGES
               PERFORM 9999-SETERROR-1
               GO TO 6-SHOWFORM
             ELSE
               MOVE EQP-OLD    TO C-EQPOLD
               MOVE EQP-NEW    TO C-EQPNEW
               MOVE REC-CNT    TO REC-DISP
               MOVE " ALL RECORDS OF EQUIPMENT NUMBER: "
                               TO COMP-MSG-1
               MOVE "            HAVE BEEN CHANGED TO: "
                               TO COMP-MSG-2
               MOVE "                 RECORDS CHANGED: "
                               TO COMP-MSG-3
               GO TO 6-RESET-SCREEN.

           MOVE 1              TO FIND-SW.
           MOVE EQP-NEW        TO DRAW-ENUM.
           PERFORM 9999-DSET-LOCK.
           PERFORM 9999-DELETE-DRAWING-FL-EN-O.
           PERFORM 9999-PUT-DRAWING-FL-EN-O,
           PERFORM 9999-UNLOCK.
           ADD 1               TO REC-CNT.

       2100-BLOWUP.
           MOVE "TDFEQPCX"     TO BU-PGM-NAME.
           CALL "TBLOWUP" USING DRWFIL BU-PGM-NAME STATUS-AREA
                VIEW-COMAREA FILE-STATUS BU-DISPLAY-MSG
                BU-DISPLAY-FLDS.
           GOBACK.

       COPY SCRNCALL           IN COPYLIB.
       COPY SCRNCL1            IN COPYLIB.

      *------ THIS VERSION OF CATREAD ASSUMES THE SET/MSG NUMBER
      *------ WILL BE IN CATREAD-MSG-NUMBER.
       999-CATREAD.
           CALL "CCATREAD" USING CATREAD-PARMS.
           MOVE CATREAD-MSG-TEXT TO MESSAGE-BUFFER.
           IF MESSAGE-BUFFER-1  = SPACES
               MOVE "* ERROR ON THIS FIELD *" TO MESSAGE-BUFFER.
       999-CATREAD-EXIT.
           EXIT.

       9999-DSET-LOCK.
      * DUMMY COPYLIB MEMBER ON AS/400

       9999-UNLOCK.
      * DUMMY COPYLIB MEMBER ON AS/400

       9999-DELETE-DRAWING-FL-EN-O.
           MOVE 0 TO COND-WORD.
           DELETE DRAWING-FL-EN-O
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD
               IF HANDLE-BLOWUP-FLAG = "Y"
                   MOVE "DELETE ERR 9999-DELETE-DRAWING-FL-EN-O"
                       TO BU-MSG-AREA
                   PERFORM 2100-BLOWUP.

       9999-PUT-DRAWING-FL-EN-O.
           MOVE 0 TO COND-WORD.
           WRITE DRAWING-FL-EN-REC-O FROM BUF-DRAWING-FILE
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD
               IF HANDLE-BLOWUP-FLAG = "Y"
                   MOVE "PUT ERR 9999-PUT-DRAWING-FL-EN-O"
                       TO BU-MSG-AREA
                   PERFORM 2100-BLOWUP.

       9999-GETKEY-EQP-EQUIP-EN-I.
           MOVE 0 TO COND-WORD.
           MOVE EQUIP-NUM-ARG TO EQPNUM OF EQP-EQUIP-EN-REC-I.
           READ EQP-EQUIP-EN-I INTO BUF-EQP-EQUIPMENT
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS = "23"
               MOVE 17 TO COND-WORD
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD
               IF HANDLE-BLOWUP-FLAG = "Y"
                   MOVE "GETKEY ERR 9999-GETKEY-EQP-EQUIP-EN-I"
                       TO BU-MSG-AREA
                   PERFORM 2100-BLOWUP.

       9999-CHAINHD-DRAWING-FL-EN-O.
           MOVE 0 TO COND-WORD.
           MOVE EQP-NUM-ARG TO DRWEQPNUM OF DRAWING-FL-EN-REC-O.
           START DRAWING-FL-EN-O KEY = DRWEQPNUM OF DRAWING-FL-EN-REC-O
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF (FILE-STATUS NOT = "00") AND (FILE-STATUS-1 NOT = "2")
               MOVE 99 TO COND-WORD
               IF HANDLE-BLOWUP-FLAG = "Y"
                   MOVE "CHAINHD ERR 9999-CHAINHD-DRAWING-FL-EN-O"
                       TO BU-MSG-AREA
                   PERFORM 2100-BLOWUP.

       9999-GETNEXT-DRAWING-FL-EN-O.
           MOVE 0 TO COND-WORD.
           READ DRAWING-FL-EN-O NEXT INTO BUF-DRAWING-FILE
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14"
                   PERFORM 9999-RESET-DRAWING-FL-EN-O
                   MOVE 15 TO COND-WORD
               ELSE
               IF FILE-STATUS = "46"
                   MOVE 15 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD
                   IF HANDLE-BLOWUP-FLAG = "Y"
                       MOVE "GETNEXT ERR 9999-GETNEXT-DRAWING-FL-EN-O"
                           TO BU-MSG-AREA
                       PERFORM 2100-BLOWUP
                   END-IF
           ELSE
           IF DRWEQPNUM OF DRAWING-FL-EN-REC-O NOT = EQP-NUM-ARG
               PERFORM 9999-RESET-DRAWING-FL-EN-O
               MOVE 15 TO COND-WORD.

       9999-RESET-DRAWING-FL-EN-O.
           MOVE HIGH-VALUES TO DRWEQPNUM OF DRAWING-FL-EN-REC-O.
           START DRAWING-FL-EN-O KEY > DRWEQPNUM OF DRAWING-FL-EN-REC-O
               INVALID KEY MOVE "00" TO FILE-STATUS.

       9999-OPENS.
           OPEN I-O            DISPLAY-FILE.
           OPEN I-O            DRAWING-FL-EN-O.
           OPEN INPUT          EQP-EQUIP-EN-I.

       9999-CLOSES.
           CLOSE               DRAWING-FL-EN-O.
           CLOSE               EQP-EQUIP-EN-I.
           CLOSE               DISPLAY-FILE.

      ***************  END OF FILE  **********************************
