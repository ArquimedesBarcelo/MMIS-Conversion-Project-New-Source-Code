000200 IDENTIFICATION DIVISION.
000300 PROGRAM-ID.    TPLNNEDD.
000500 INSTALLATION.  GOODYEAR.
000700*REMARKS.       THIS PROGRAM DISPLAYS WHAT PERCENT OF IT'S
000800*               ESTIMATED COST A PLANNED WORK ORDER HAS REACHED.
      *C
      *C 09/11/96  JEFF BUNGO
      *C    EXPAND DATE FIELDS FOR YEAR 2000 COMPLIANCE.
      *C    RECOMPILE TO PICK UP COPYLIB CHANGES.
      *C
001200 ENVIRONMENT DIVISION.
001300 CONFIGURATION SECTION.
001400 SOURCE-COMPUTER.   AS400.
001500 OBJECT-COMPUTER.   AS400.
       COPY SPECIALN IN COPYLIB.
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT DISPLAY-FILE
               ASSIGN TO WORKSTATION-ZREPORT-SI
               ORGANIZATION IS TRANSACTION
               ACCESS IS SEQUENTIAL
               FILE STATUS IS DSPLY-STATUS
               CONTROL-AREA IS WS-CONTROL.
           SELECT JOBPLAN-FILE
               ASSIGN TO DATABASE-MCFLMM1801
               ORGANIZATION IS INDEXED
               ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                   WITH DUPLICATES
               FILE STATUS IS JF-STATUS.
           SELECT PER-PERSONNEL
               ASSIGN TO DATABASE-MCFLMM0301
               ACCESS IS SEQUENTIAL
               FILE STATUS IS PP-STATUS.
           SELECT WO-LABOR-FILE
               ASSIGN TO DATABASE-MCFLMM1301
               ORGANIZATION IS INDEXED
               ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                   WITH DUPLICATES
               FILE STATUS IS WLF-STATUS.
           SELECT WO-LAST-NUM-USED
               ASSIGN TO DATABASE-MCFPMM0800
               ORGANIZATION IS RELATIVE
               ACCESS MODE IS RANDOM
               RELATIVE KEY IS ARG-NO
               FILE STATUS IS WLNU-STATUS.
           SELECT WO-MATER-FILE
               ASSIGN TO DATABASE-MCFLMM1201
               ORGANIZATION IS INDEXED
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                   WITH DUPLICATES
               FILE STATUS IS WMF-STATUS.
           SELECT WO-PLANNED-FILE
               ASSIGN TO DATABASE-MCFLMM1101
               ORGANIZATION IS INDEXED
               ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
               FILE STATUS IS WPF-STATUS.
001800 DATA DIVISION.
       FILE SECTION.
       FD  DISPLAY-FILE
           LABEL RECORDS ARE OMITTED.
       01  DSPLY-REC               PIC X(2000).
       FD  JOBPLAN-FILE
           LABEL RECORDS ARE STANDARD
           DATA RECORD IS JFREC.
       01  JFREC.
           COPY DDS-ALL-FORMATS OF MCFLMM1801.
       FD  PER-PERSONNEL
           LABEL RECORDS ARE STANDARD
           DATA RECORD IS PPREC.
       01  PPREC.
           COPY DDS-ALL-FORMATS OF MCFLMM0301.
       FD  WO-LABOR-FILE
           LABEL RECORDS ARE STANDARD
           DATA RECORD IS WLFREC.
       01  WLFREC.
           COPY DDS-ALL-FORMATS OF MCFLMM1301.
       FD  WO-LAST-NUM-USED
           LABEL RECORDS ARE STANDARD
           DATA RECORD IS WLNUREC.
       01  WLNUREC.
           COPY DDS-ALL-FORMATS OF MCFPMM0800.
       FD  WO-MATER-FILE
           LABEL RECORDS ARE STANDARD
           DATA RECORD IS WMFREC.
       01  WMFREC.
           COPY DDS-ALL-FORMATS OF MCFLMM1201.
       FD  WO-PLANNED-FILE
           LABEL RECORDS ARE STANDARD
           DATA RECORD IS WPFREC.
       01  WPFREC.
           COPY DDS-ALL-FORMATS OF MCFLMM1101.
001900 WORKING-STORAGE SECTION.
002000 01  ARG-NO                PIC 9(9).
002100 01  AMOUNT                PIC 9(16).
       COPY CATREAD OF COPYLIB.
       COPY CPYIND  OF COPYLIB.
       01  FILE-STATUSES.
           05  DSPLY-STATUS      PIC XX.
           05  JF-STATUS         PIC XX.
           05  PP-STATUS         PIC XX.
           05  WLF-STATUS        PIC XX.
           05  WLNU-STATUS       PIC XX.
           05  WMF-STATUS        PIC XX.
           05  WPF-STATUS        PIC XX.
       COPY IOFEEDBACK OF COPYLIB.
003200 01  JOBPLAN-DATA.         COPY DJOBPLAN OF COPYLIB.
003300 01  JOBPLAN-KEY.
003400     05  JOBWONUM          PIC X(10).
003500     05  JOBSEQUENCE.
003600         10  SEQNUM        PIC 9(3).
003700         10  FILLER        PIC X.
003800 01  LABOR-EST             PIC 9(12).
003900 01  LAST-WO-BUFF.         COPY MLASTWO OF COPYLIB.
004200 01  PERSONNEL-DATA.       COPY MPERSONL OF COPYLIB.
004300 01  PLNNED-TOTALS.
004400     05  LABOR-TOTAL       PIC 9(12).
004500     05  MATER-TOTAL       PIC 9(15).
004600     05  PURCH-TOTAL       PIC 9(15).
004700     05  WONUM-TOTAL       PIC 9(16).
004800     05  ESTIMATE-TOTAL    PIC 9(16).
004900     05  W-PERCENT         PIC 999V999.
005100 01  SEQ-NO                PIC 9999.
005200 01  SEQ-NO-TEMP           PIC 999.
       COPY DBSTAT OF COPYLIB.
005800 01  VALUE-LINE.
005900     05  WONUM-V           PIC X(10).
006000     05  STATUS-V          PIC X(2).
006100     05  EQPNUM-V          PIC X(6).
006200     05  DESCRIPTION-V     PIC X(30).
006300     05  CLASS-V           PIC X(8).
006400     05  BUDGET-V          PIC X(13).
006500     05  REQUEST-V         PIC X(12).
006600     05  LABOR-V           PIC Z(12).
006700     05  MATER-V           PIC Z(15).
006800     05  PURCH-V           PIC Z(15).
006900     05  TOTAL-V           PIC Z(16).
007000     05  PERCENT-V         PIC Z99.
007100     05  PERCENT-X REDEFINES PERCENT-V
007200                           PIC X(3).
007300     05  ESTIM-V           PIC Z(16).
007400     05  DEFAULT-V         PIC X(17).
007500     05  ZONE-V            PIC X(4).
007800 01  WO-LABOR-DATA.        COPY DWOLABOR OF COPYLIB.
007700 01  WO-MATER-DATA.        COPY DWOPARTS OF COPYLIB.
007600 01  WO-PLNND-DATA.        COPY DWOPLAN OF COPYLIB.
       COPY WSCONTROL IN COPYLIB.
008000 LINKAGE SECTION.
008100 01  WONUM-PASS            PIC X(10).
008200 01  STATUS-CHECK          PIC X.
008300 01  MISC-BUFFER           PIC X(80).
       COPY VCOMLINK OF COPYLIB.
008500 01  DBPARAMETERS.         COPY DBPARMS OF COPYLIB.
       COPY LANGSUB OF COPYLIB.
008900 PROCEDURE DIVISION USING WONUM-PASS STATUS-CHECK MISC-BUFFER
009000                          VIEW-COMAREA DBPARAMETERS
009100                          LANGUAGE-PARMS.
009200 BEGIN-PAR.
009300     PERFORM 1-HSK.
           PERFORM 6-MAIN.
       2-EOJ.
           CLOSE DISPLAY-FILE.
           CLOSE JOBPLAN-FILE.
           CLOSE PER-PERSONNEL.
           CLOSE WO-LABOR-FILE.
           CLOSE WO-LAST-NUM-USED.
           CLOSE WO-MATER-FILE.
           CLOSE WO-PLANNED-FILE.
           GOBACK.
       1-HSK.
           OPEN I-O    DISPLAY-FILE.
           OPEN INPUT  JOBPLAN-FILE.
           OPEN INPUT  PER-PERSONNEL.
           OPEN INPUT  WO-LABOR-FILE.
           OPEN INPUT  WO-LAST-NUM-USED.
           OPEN INPUT  WO-MATER-FILE.
           OPEN INPUT  WO-PLANNED-FILE.
010500     MOVE 0 TO ESTIMATE-TOTAL.
           MOVE 0 TO COND-WORD.
012000     MOVE 1 TO ARG-NO.
012100     READ WO-LAST-NUM-USED INTO LAST-WO-BUFF
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF WLNU-STATUS NOT = "00" MOVE 17 TO COND-WORD.
           IF COND-WORD = 17 MOVE 1 TO DATE-FLAG-SW.
012600     IF PLANT-IDENT = "126" OR "129" OR "131" OR "133" OR "153"
012700                            OR "211"
012800         MOVE 15000 TO AMOUNT
012900     ELSE
013000     MOVE 10000 TO AMOUNT.
013100     MOVE 0 TO COND-WORD.
           READ PER-PERSONNEL NEXT INTO PERSONNEL-DATA
               AT END    MOVE 15 TO COND-WORD.
           IF PP-STATUS NOT = "00" MOVE 15 TO COND-WORD.
013600     IF COND-WORD NOT = 0 GO TO 2-EOJ.
       6-MAIN.
009400     PERFORM 60-GET-WONUM.
009500     PERFORM 61-GET-LABOR THRU 61-GET-LABOR-EXIT.
009600     PERFORM 62-GET-MATER THRU 62-GET-MATER-EXIT.
009700     PERFORM 63-GET-JPLAN THRU 63-GET-JPLAN-EXIT.
009800     PERFORM 64-CALCULATE.
009900     PERFORM 65-DISPLAY-INFO.
013700
013900 60-GET-WONUM.
014000     PERFORM 69-START-WO-PLANNED-FILE.
014700     IF COND-WORD = 17
014800         MOVE 49002 TO CATREAD-MSG-NUMBER
015000         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
015100         MOVE "D" TO STATUS-CHECK
015200         GO TO 6-MAIN.
015400     PERFORM 69-READ-WO-PLANNED-FILE.
015700     IF COND-WORD = 15
015800         MOVE 49002 TO CATREAD-MSG-NUMBER
016000         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
016100         MOVE "D" TO STATUS-CHECK
016200         GO TO 6-MAIN.
016400     MOVE WO-NUM-PLANNED TO WONUM-V.
016500     MOVE WO-STATUS-P TO STATUS-V.
016600     MOVE EQUIP-NUM-P TO EQPNUM-V.
016700     MOVE DESCRIPTION-1-P TO DESCRIPTION-V.
016800     MOVE EXP-CLASS-P TO CLASS-V.
016900     MOVE BUDGET-NO TO BUDGET-V.
017000     MOVE REQUEST-NO TO REQUEST-V.
017100     MOVE SPACES TO DEFAULT-V.
017200     MOVE ZONE-P TO ZONE-V.
017300
017500 61-GET-LABOR.
017700     MOVE 0 TO LABOR-TOTAL.
017800     PERFORM 69-START-WO-LABOR-FILE.
018400     IF COND-WORD = 17 GO TO 61-GET-LABOR-EXIT.
           PERFORM 69-READ-WO-LABOR-FILE.
019100     IF COND-WORD = 15 GO TO 61-GET-LABOR-EXIT.
019500     PERFORM 610-READ-LABOR-CHAIN THRU 610-RLCE
               UNTIL COND-WORD = 15.
019600 61-GET-LABOR-EXIT.    EXIT.
019800
020000 62-GET-MATER.
020200     MOVE 0 TO MATER-TOTAL PURCH-TOTAL.
020300     PERFORM 69-START-WO-MATER-FILE.
020900     IF COND-WORD = 17 GO TO 62-GET-MATER-EXIT.
021400     PERFORM 69-READ-WO-MATER-FILE.
021600     IF COND-WORD = 15 GO TO 62-GET-MATER-EXIT.
022000     PERFORM 620-READ-MATER-CHAIN THRU 620-RMCE
               UNTIL COND-WORD = 15.
022100 62-GET-MATER-EXIT.    EXIT.
022300
022500 63-GET-JPLAN.
023000     IF LAST-JOBPLAN-SEQ = "    " OR "000 "
023100         GO TO 63-GET-JPLAN-EXIT.
           PERFORM 69-START-JOBPLAN-FILE.
023200     PERFORM 630-READ-JOBPLAN-CHAINS THRU 630-RJCE
023300        UNTIL COND-WORD = 15.
023500 63-GET-JPLAN-EXIT.    EXIT.
023600
023800 64-CALCULATE.
023900     MOVE LABOR-TOTAL TO LABOR-V.
024000     MOVE MATER-TOTAL TO MATER-V.
024100     MOVE PURCH-TOTAL TO PURCH-V.
024200     COMPUTE WONUM-TOTAL = LABOR-TOTAL + MATER-TOTAL
024300                                       + PURCH-TOTAL.
024400     MOVE WONUM-TOTAL TO TOTAL-V.
024500     IF ESTIMATE-TOTAL = 0
024600         MOVE AMOUNT TO ESTIMATE-TOTAL
024700         MOVE "(default maximum)" TO DEFAULT-V.
024800     MOVE ESTIMATE-TOTAL TO ESTIM-V.
024900     COMPUTE W-PERCENT = WONUM-TOTAL / ESTIMATE-TOTAL * 100.
025000     MOVE W-PERCENT TO PERCENT-V.
025100
025300 610-READ-LABOR-CHAIN.
025500     IF LABOR-COST NUMERIC
025600         ADD LABOR-COST TO LABOR-TOTAL.
025700     PERFORM 69-READ-WO-LABOR-FILE.
026300 610-RLCE.    EXIT.
026500
026700 620-READ-MATER-CHAIN.
026900     IF P-ACT-COST NUMERIC
027000         IF PRT-PO-NO = SPACES
027100             ADD P-ACT-COST TO MATER-TOTAL
027200         ELSE
027300         ADD P-ACT-COST TO PURCH-TOTAL.
027400     IF P-EST-COST NUMERIC
027500         ADD P-EST-COST TO ESTIMATE-TOTAL.
027600     PERFORM 69-READ-WO-MATER-FILE.
028300 620-RMCE.    EXIT.
028500
028700 630-READ-JOBPLAN-CHAINS.
           PERFORM 69-READ-JOBPLAN-FILE.
031200     IF JOBPLAN-MEN NUMERIC AND JOBPLAN-EST-TIME NUMERIC
031300         COMPUTE LABOR-EST = PER-LABOR-RATE * JOBPLAN-MEN
031400                                            * JOBPLAN-EST-TIME
031500         ADD LABOR-EST TO ESTIMATE-TOTAL.
030600 630-RJCE.    EXIT.
030800
032700 65-DISPLAY-INFO.
032900     MOVE "DWONUM1" TO VIEW-CFNAME.
           MOVE VALUE-LINE TO DSPLY-REC.
           PERFORM 99-SCREEN-WRITE.
           PERFORM 98-SCREEN-READ.
           IF VIEW-LASTKEY = 3 GO TO 2-EOJ.

       69-START-JOBPLAN-FILE.
           MOVE 0 TO COND-WORD.
022800     MOVE WO-NUM-PLANNED TO JOBWONUM.
022900     MOVE SPACES TO JOBSEQUENCE.
           MOVE 0 TO SEQNUM.
           START JOBPLAN-FILE KEY > EXTERNALLY-DESCRIBED-KEY
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF JF-STATUS NOT = "00" MOVE 17 TO COND-WORD.

       69-READ-JOBPLAN-FILE.
           MOVE 0 TO COND-WORD.
           READ JOBPLAN-FILE NEXT INTO JOBPLAN-DATA
               AT END    MOVE 15 TO COND-WORD.
           IF JOBWONUM NOT = JOBPLAN-WO-NO
               MOVE 15 TO COND-WORD.
           IF JF-STATUS NOT = "00" MOVE 15 TO COND-WORD.

       69-START-WO-LABOR-FILE.
           MOVE 0 TO COND-WORD.
           MOVE WO-NUM-PLANNED TO WONUM OF WLFREC.
           START WO-LABOR-FILE KEY = EXTERNALLY-DESCRIBED-KEY
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF WLF-STATUS NOT = "00" MOVE 17 TO COND-WORD.

       69-READ-WO-LABOR-FILE.
           MOVE 0 TO COND-WORD.
           READ WO-LABOR-FILE NEXT INTO WO-LABOR-DATA
               AT END    MOVE 15 TO COND-WORD.
           IF WO-NUM-PLANNED NOT = WONUM OF WLFREC
               MOVE 15 TO COND-WORD.
           IF WLF-STATUS NOT = "00" MOVE 15 TO COND-WORD.

       69-START-WO-MATER-FILE.
           MOVE 0 TO COND-WORD.
           MOVE WO-NUM-PLANNED TO WONUM OF WMFREC.
           START WO-MATER-FILE KEY = EXTERNALLY-DESCRIBED-KEY
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF WMF-STATUS NOT = "00" MOVE 17 TO COND-WORD.

       69-READ-WO-MATER-FILE.
           MOVE 0 TO COND-WORD.
           READ WO-MATER-FILE NEXT INTO WO-MATER-DATA
               AT END    MOVE 15 TO COND-WORD.
           IF WO-NUM-PLANNED NOT = WONUM OF WMFREC
               MOVE 15 TO COND-WORD.
           IF WMF-STATUS NOT = "00" MOVE 15 TO COND-WORD.

       69-START-WO-PLANNED-FILE.
           MOVE 0 TO COND-WORD.
           MOVE WONUM-PASS TO WONUM OF WPFREC.
           START WO-PLANNED-FILE KEY = EXTERNALLY-DESCRIBED-KEY
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF WPF-STATUS NOT = "00" MOVE 17 TO COND-WORD.

       69-READ-WO-PLANNED-FILE.
           MOVE 0 TO COND-WORD.
           READ WO-PLANNED-FILE NEXT INTO WO-PLNND-DATA
               AT END    MOVE 15 TO COND-WORD.
           IF WONUM-PASS NOT = WONUM OF WPFREC
               MOVE 15 TO COND-WORD.
           IF WPF-STATUS NOT = "00" MOVE 15 TO COND-WORD.

       98-SCREEN-READ.
           READ DISPLAY-FILE FORMAT IS VIEW-CFNAME
               INDIC IS INDICS.
           ACCEPT IOFEEDBACK FROM I-O-FEEDBACK-AREA.
           MOVE ALL B"0" TO INDICS.
           IF DSPLY-STATUS NOT = "00"
               MOVE 3 TO VIEW-LASTKEY
           ELSE
           MOVE FUNCTION-NUM TO VIEW-LASTKEY.

       99-SCREEN-WRITE.
           WRITE DSPLY-REC FORMAT IS VIEW-CFNAME
               INDIC IS INDICS.
           MOVE ALL B"0" TO INDICS.

038900 999-CATREAD.
039000     MOVE SPACES TO MISC-BUFFER.
           CALL "CCATREAD" USING CATREAD-PARMS.
           MOVE CATREAD-MSG-TEXT TO MISC-BUFFER.
040500 999-CATREAD-EXIT.    EXIT.
