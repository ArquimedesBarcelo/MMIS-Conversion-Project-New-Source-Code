           05  FILLER  PIC X(8)  VALUE "INTR197 ".
           05  FILLER  PIC X(8)  VALUE "INTR198 ".
           05  FILLER  PIC X(8)  VALUE "INTR297 ".
           05  FILLER  PIC X(8)  VALUE "INTR347 ".
