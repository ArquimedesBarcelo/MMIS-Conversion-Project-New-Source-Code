000200 IDENTIFICATION DIVISION.
000300 PROGRAM-ID.          TCHKAPPS.
000400 AUTHOR.              JIM COFFMAN.
000500 DATE-WRITTEN.        05/21/94.
000600 DATE-COMPILED.
000700*INSTALLATION.        GOODYEAR TIRE AND RUBBER - AKRON.
000800*SECURITY.
000900*REMARKS.
001000*C   THIS PROGRAM RUNS WHEN THE USERS LOG ONTO CSIS/MMIS VIA
001100*C   THE MENU SYSTEM. IT CHECKS TO SEE IF THE PERSON LOGGING
001200*C   ON IS A VALID APPROVER AND IF SO DETERMINES HOW MANY REQS
      *C   ARE IN HIS QUEUE AND SENDS A MESSAGE WITH THE INFORMATION
      *C   TO HIS USERID.
      *C
001700 ENVIRONMENT DIVISION.
001800 CONFIGURATION SECTION.
001900 SOURCE-COMPUTER.  AS400.
002000 OBJECT-COMPUTER.  AS400.
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT MEMPL
                  ASSIGN TO DATABASE-MCFLCS4201
                  ORGANIZATION IS INDEXED
                    ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                  FILE STATUS IS FILE-STATUS.

           SELECT DREQQUE
                  ASSIGN TO DATABASE-MCFLCS4404
                  ORGANIZATION IS INDEXED
                    ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                    WITH DUPLICATES
                  FILE STATUS IS FILE-STATUS.
002100
002200 DATA DIVISION.
       FILE SECTION.
       FD  MEMPL
           LABEL RECORDS ARE STANDARD.
       01  MEMPL-REC.
           COPY DDS-MCRPCS4200  OF MCFLCS4201.

       FD  DREQQUE
           LABEL RECORDS ARE STANDARD.
       01  DREQQUE-REC.
           COPY DDS-MCRPCS4400  OF MCFLCS4404.
002300 WORKING-STORAGE SECTION.
       77  REQS-CTR                      PIC 9(4).

       01  APP-MESSAGE.
           05  REQS-APPROVER             PIC X(10) VALUE SPACES.
           05  FILLER                    PIC X(3)  VALUE " - ".
           05  FILLER                    PIC X(9)  VALUE
            "You have ".
           05  REQS-ZCTR                 PIC Z(3)9.
           05  FILLER                    PIC X(43) VALUE
            " requisitions queued awaiting your approval".
           05  FILLER                    PIC X(456) VALUE SPACES.

008200 01  BLOWUP-BASE                   PIC X(10).

       COPY DBSTAT     IN COPYLIB.

       COPY DREQQUE    IN COPYLIB.

       01  FILE-STATUS.
           05  FILE-STATUS-1             PIC X  VALUE "0".
           05  FILE-STATUS-2             PIC X  VALUE "0".

       COPY MEMPL      IN COPYLIB.
007400
004000 01  MODE-AREA.
004100     05  DB-MODE                   PIC S9(4)   COMP       VALUE 0.
004200     05  MODE1                     PIC S9(4)   COMP       VALUE 1.
004300     05  MODE2                     PIC S9(4)   COMP       VALUE 2.
004400     05  MODE3                     PIC S9(4)   COMP       VALUE 3.
004500     05  MODE4                     PIC S9(4)   COMP       VALUE 4.
004600     05  MODE5                     PIC S9(4)   COMP       VALUE 5.
004700     05  MODE7                     PIC S9(4)   COMP       VALUE 7.
004800
       COPY TBLOWUP    IN COPYLIB.

       COPY VCOMLINK   IN COPYLIB.

       01  WHO-PARMS.
           05  USERNAME                  PIC X(10).
           05  TERMNUM                   PIC X(10).
           05  CURRLIB                   PIC X(10).
           05  JOBLIBX                   PIC X.

009400 PROCEDURE DIVISION.
       START-PGM.
           PERFORM 1-HSK.
           PERFORM 6-MAIN THRU 6-MAIN-X.

       2-EOJ.
           CLOSE DREQQUE, MEMPL.
018900     GOBACK.
019000
076200 2-BLOWUP.
076300     MOVE "TCHKAPPS" TO BU-PGM-NAME.
076400     CALL "TBLOWUP" USING BLOWUP-BASE BU-PGM-NAME STATUS-AREA
076500                      VIEW-COMAREA DUMMY-KSAM-STAT
076600                      BU-DISPLAY-MSG BU-DISPLAY-FLDS.

       1-HSK.
           OPEN INPUT DREQQUE, MEMPL.
           CALL "CLWHO" USING USERNAME TERMNUM CURRLIB JOBLIBX.
       6-MAIN.
           READ MEMPL NEXT INTO BUF-MEMPL
               AT END    MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00" GO TO 6-MAIN-X.
           IF USERNAME = MEMPL-USERID
               IF MEMPL-APP-RQ-FLAG = "N"
                   GO TO 6-MAIN-X
               ELSE
               MOVE 0 TO REQS-CTR
               PERFORM 60-GET-REQS-FOR-APPROVER THRU 60-GRFA-X
               IF REQS-CTR = 0
                   GO TO 6-MAIN-X
               ELSE
               MOVE REQS-CTR TO REQS-ZCTR
               MOVE USERNAME TO REQS-APPROVER
               CALL "MCXSNDMSG" USING APP-MESSAGE, USERNAME
               GO TO 6-MAIN-X.
           GO TO 6-MAIN.
       6-MAIN-X.    EXIT.

       60-GET-REQS-FOR-APPROVER.
      *    MOVE "8888" TO MEMPL-EMPL.
           MOVE MEMPL-EMPL TO EMPLQUEDST OF DREQQUE-REC.
           START DREQQUE KEY = EMPLQUEDST OF DREQQUE-REC
               INVALID KEY    MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00" GO TO 60-GRFA-X.
       60-GRFA-LOOP.
           READ DREQQUE NEXT INTO BUF-DREQQUE
               AT END     MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00" GO TO 60-GRFA-X.
           IF DRQQ-EQ-EMPL NOT = MEMPL-EMPL GO TO 60-GRFA-X.
           IF DRQQ-EQ-ST = "  "
               ADD 1 TO REQS-CTR
               GO TO 60-GRFA-LOOP.
       60-GRFA-X.     EXIT.
