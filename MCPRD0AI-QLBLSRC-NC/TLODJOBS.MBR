000200 IDENTIFICATION DIVISION.
000300 PROGRAM-ID.        TLODJOBS.
001000******************************************************
001100*C  THIS PROGRAM WILL USE THE INPUT FILE CREATED IN  *
001200*C  TRETJOBS (JOB-FILE) AND LOAD GENERIC JOBPLAN     *
001300*C  ENTRIES INTO DATA SETS MCFPMM3500 AND MCFPMM3600.*
001600******************************************************
000600 ENVIRONMENT DIVISION.
000700 CONFIGURATION SECTION.
000800 SOURCE-COMPUTER.   AS400.
000900 OBJECT-COMPUTER.   AS400.
001000 INPUT-OUTPUT SECTION.
001100 FILE-CONTROL.
001600     SELECT JOB-FILE
               ASSIGN TO DATABASE-MCFPJOBF
001700         ORGANIZATION IS SEQUENTIAL
               ACCESS MODE IS SEQUENTIAL
001800         FILE STATUS IS JF-STATUS.
           SELECT JOBPLAN-BANK-FILE
               ASSIGN TO DATABASE-MCFLMM3601
               ORGANIZATION IS INDEXED
               ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                   WITH DUPLICATES
               FILE STATUS IS JBF-STATUS.
           SELECT MASTER-JOBPLAN
               ASSIGN TO DATABASE-MCFLMM3501
               ORGANIZATION IS INDEXED
               ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
               FILE STATUS IS MJ-STATUS.
001300     SELECT PRINT-FILE ASSIGN TO PRINTER-MCPRT.
001700 DATA DIVISION.
001800 FILE SECTION.
002700 FD  JOB-FILE
002800     RECORD CONTAINS 80 CHARACTERS
002900     DATA RECORD IS JOBF.
003000 01  JOBF.
           05  JOB-NAME              PIC X(10).
           05  JOB-SEQ               PIC 9(3).
           05  FILLER                PIC X(67).
       FD  JOBPLAN-BANK-FILE
           LABEL RECORDS ARE STANDARD
           DATA RECORD IS JBFREC.
       01  JBFREC.
           COPY DDS-ALL-FORMATS OF MCFLMM3601.
       FD  MASTER-JOBPLAN
           LABEL RECORDS ARE STANDARD
           DATA RECORD IS MJREC.
       01  MJREC.
           COPY DDS-ALL-FORMATS OF MCFLMM3501.
002300 FD  PRINT-FILE RECORD CONTAINS 132 CHARACTERS
002400     LABEL RECORD IS OMITTED
002500     DATA RECORD IS PRT-REC.
002600 01  PRT-REC                   PIC X(132).
004400 WORKING-STORAGE SECTION.
004900 77  ENTRIES-READ              PIC 9(4)  VALUE 0.
005000 77  ENTRIES-WRITTEN           PIC 9(4)  VALUE 0.
005100 77  ERROR-SUB                 PIC 99    VALUE 0.
       77  FST-SW                    PIC 9     VALUE 0.
005300 77  LINE-K                    PIC 99    VALUE 0.
005900 01  DBPARAMETERS.            COPY DBPARMS OF COPYLIB.
       01  DELETE-FILE              PIC X(10)  VALUE "MCFPJOBF".
       01  ERROR-BUFFER              PIC X(80).
       01  FILE-STATUSES.
           05  JF-STATUS             PIC XX.
           05  JBF-STATUS            PIC XX.
           05  MJ-STATUS             PIC XX.
       01  JOBPLAN-BANK-BUFFER.     COPY DJOBPLAN OF COPYLIB.
      *01  MASTER-JOBPLAN-BUFFER.   COPY DMASTJOB OF COPYLIB.
       01  MASTER-JOBPLAN-BUFFER.   COPY MMASTJOB OF COPYLIB.
       COPY OVRPFDATA IN COPYLIB.
       01  SAVE-JOB-NAME-SEQ.
           05  SAVE-JOB-NAME         PIC X(10).
           05  SAVE-JOB-SEQ          PIC 9(3).
010700 COPY DBSTAT   OF COPYLIB.
010800 PROCEDURE DIVISION.
010900 BEGIN-PGM.
           PERFORM 1-HSK.
011000     PERFORM 6-MAIN THRU 6-M-X.
011700 2-EOJ.
           CLOSE JOB-FILE.
           CLOSE JOBPLAN-BANK-FILE.
           CLOSE MASTER-JOBPLAN.
           CALL "MCDLT" USING DELETE-FILE.
           CLOSE PRINT-FILE.
011900     DISPLAY "ENTRIES READ    = " ENTRIES-READ.
012000     DISPLAY "ENTRIES WRITTEN = " ENTRIES-WRITTEN.
012100     GOBACK.
       1-HSK.
015500     MOVE LOW-VALUES TO STATUS-AREA.
           OPEN INPUT  JOB-FILE.
           OPEN OUTPUT JOBPLAN-BANK-FILE.
           OPEN I-O    MASTER-JOBPLAN.
           PERFORM 996-OVERRIDE-PRINT-FILE.
           OPEN OUTPUT PRINT-FILE.
      *----MOVE SPACES TO SAVE-JOB-NAME SAVE-JOB-SEQ.
           MOVE SPACES TO SAVE-JOB-NAME-SEQ.
014800 6-MAIN.
017600     READ JOB-FILE INTO JOBPLAN-BANK-BUFFER
               AT END GO TO 6-M-X.
           IF JOB-NAME NOT = SAVE-JOB-NAME
               IF FST-SW = 0
                   MOVE 1 TO FST-SW
                   MOVE JOBPLAN-WO-NO      TO SAVE-JOB-NAME
                   MOVE JOBPLAN-SEQ-NO-1-3 TO SAVE-JOB-SEQ
                   PERFORM 69-WRITE-MASTER-JOBPLAN
                   GO TO 6-MAIN
               ELSE
               PERFORM 69-WRITE-MASTER-JOBPLAN
               MOVE JOBPLAN-WO-NO      TO SAVE-JOB-NAME
               MOVE JOBPLAN-SEQ-NO-1-3 TO SAVE-JOB-SEQ
               GO TO 6-MAIN.
018000     ADD 1 TO ENTRIES-READ.
           MOVE JOBPLAN-BANK-BUFFER TO JBFREC.
           WRITE JBFREC FROM JOBPLAN-BANK-BUFFER
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF JBF-STATUS NOT = "00" MOVE 17 TO COND-WORD.
026600     IF COND-WORD NOT = 0
026700        MOVE SPACES TO PRT-REC
026800        MOVE "ERROR IN DBPUT PARA 99 PGM TLODJOBS" TO PRT-REC
026900        WRITE PRT-REC AFTER ADVANCING 1 LINES
027200        GO TO 2-EOJ.
027300     ADD 1 TO ENTRIES-WRITTEN.
           GO TO 6-MAIN.
027600 6-M-X.         EXIT.

       69-WRITE-MASTER-JOBPLAN.
           MOVE 0 TO COND-WORD.
           MOVE SPACES        TO MASTER-JOBPLAN-BUFFER.
           MOVE JOBPLAN-BANK-BUFFER TO MJREC.
           WRITE MJREC FROM MASTER-JOBPLAN-BUFFER
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF MJ-STATUS NOT = "00" MOVE 17 TO COND-WORD.

       COPY OVRPFCALL IN COPYLIB.
