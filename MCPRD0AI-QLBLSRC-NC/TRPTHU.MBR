027900*PROCEDURE DIVISION USING HD-ROUTE-DATA, SORT-DATA.
       PROCEDURE DIVISION.
028000 BEGIN-SORT SECTION.
028100 1-HOUSEKEEPING.
9406CK     MOVE "C" TO SCOPE.
9406CK     CALL "MCXCBLERR" USING SCOPE.

           ACCEPT HD-ROUTE-DATA.
           ACCEPT MTLS-DATA-LINE-1.
           ACCEPT MTLS-DATA-LINE-1B.
           ACCEPT MTLS-DATA-LINE-2.
           ACCEPT MTLS-DATA-LINE-3.

           MOVE "N" TO END-OF-INPUT-FILE, END-OF-SORT-FILE,
             BLOWUP-SWITCH.
           MOVE 60 TO LINE-K.
           MOVE 0 TO PAGE-K, TOTAL-COST, GRAND-TOTAL.
           OPEN INPUT MSTORERM-I, DDESC-I, DMANPART-I.
028200     CALL "TESCSEQ" USING ESC-NAME.
028300     MOVE CHAR-1636PI     TO COMPRESS-PRINT.
028400     MOVE CHAR-10PI       TO NORMAL-PRINT.
           MOVE HD-SPOOLER-NUMBER TO OVRPRTF-TOFILE-NUM.
           MOVE "*YES"            TO OVRPRTF-SHARED.
           MOVE HD-NO-OF-COPIES   TO OVRPRTF-COPIES.
           MOVE "MCPRT"           TO OVRPRTF-FILE.
           PERFORM 996-OVERRIDE-PRINT-FILE.
028900     OPEN OUTPUT PRINT-FILE.
029100     DISPLAY HD-ROUTE-DATA.
029300     DISPLAY MTLS-DATA-LINE-1.
           DISPLAY MTLS-DATA-LINE-1B.
           DISPLAY MTLS-DATA-LINE-2.
           DISPLAY MTLS-DATA-LINE-3.
029500     MOVE "DHDR85.PUB" TO HD-FILE-NAME.
029600     CALL "THDPRT2" USING HD-RET-CODE, HD-FILE-NAME,
029700        FNUM, HD-ROUTE-DATA, ESC-NAME.
029800     IF PAPER-IS-132-COLS
029900          NEXT SENTENCE
030000     ELSE
030100         WRITE PRT-REC FROM COMPRESS-PRINT AFTER ADVANCING 0.
030300     IF HD-RET-CODE NOT = 0
030400         DISPLAY "THDRPT ERROR".
030500     MOVE HD-SPOOLER-NUMBER TO SPOOL-PRT.

           MOVE MTLS-RPT-TITLE     TO PRT-RPT-TITLE.
           MOVE "  TRPTHU"         TO PRT-PGM-NAME.
           IF MTLS-FROM-RANGE > SPACES OR MTLS-TO-RANGE > SPACES
               PERFORM 9-MOVE-HEADING-DESC.
           IF MTLS-COST-OPT = "M"
               MOVE "MKT COST"     TO PRT-COST-LIT
           ELSE
           IF MTLS-COST-OPT = "A"
               MOVE "AVG COST"     TO PRT-COST-LIT
           ELSE
           IF MTLS-COST-OPT = "R"
               MOVE "REP COST"     TO PRT-COST-LIT.

030600     MOVE 1 TO DATE-MODE.
030700     CALL "TDATECHK" USING DATE-CHECK-AREA.
030800     MOVE DATE-SLASH-OUT TO PRT-DATE.
030900     MOVE DATE-FORMATTED-TIME-OUT TO PRT-TIME.
031000
           PERFORM 9-MOVE-OPTION-LINES.
           WRITE PRT-REC FROM OPTION-LINE-1  AFTER ADVANCING 3 LINES.
           WRITE PRT-REC FROM OPTION-LINE-2  AFTER ADVANCING 1 LINE.
           WRITE PRT-REC FROM OPTION-LINE-2B AFTER ADVANCING 1 LINE.
           WRITE PRT-REC FROM OPTION-LINE-2C AFTER ADVANCING 1 LINE.
           WRITE PRT-REC FROM OPTION-LINE-3  AFTER ADVANCING 1 LINE.
           WRITE PRT-REC FROM OPTION-LINE-4  AFTER ADVANCING 1 LINE.
           WRITE PRT-REC FROM OPTION-LINE-5  AFTER ADVANCING 1 LINE.
           WRITE PRT-REC FROM OPTION-LINE-6  AFTER ADVANCING 1 LINE.
           WRITE PRT-REC FROM OPTION-LINE-7  AFTER ADVANCING 1 LINE.
           WRITE PRT-REC FROM OPTION-LINE-8  AFTER ADVANCING 1 LINE.
           WRITE PRT-REC FROM OPTION-LINE-HU AFTER ADVANCING 1 LINE.

031600*    IF DE-KEY = "C"
031700*    SORT SORT-FILE
031800*         ON ASCENDING KEY SRT-CORP-CODE
031900*         INPUT  PROCEDURE IS 8-INPUT-RECORDS
032000*         OUTPUT PROCEDURE IS 9-WRITE-RECORDS
032100*    ELSE
032200*    SORT SORT-FILE
032300*         ON ASCENDING KEY SRT-HIGH-USAGE, SRT-CORP-CODE
032400*         INPUT  PROCEDURE IS 8-INPUT-RECORDS
032500*         OUTPUT PROCEDURE IS 9-WRITE-RECORDS.

           COPY MTLSPROC IN COPYLIB.

032600 2-EOJ.
032700     IF PAPER-IS-132-COLS
032800         NEXT SENTENCE
032900     ELSE
033000         WRITE PRT-REC FROM NORMAL-PRINT AFTER ADVANCING 0
033200
033300     MOVE HD-NO-OF-COPIES TO SPOOL-COPIES.
033400
033500
033900     CLOSE PRINT-FILE.
           CLOSE MSTORERM-I, DDESC-I, DMANPART-I.
034100     GOBACK.
034200
034300
034400*************************************************************
034500*                    BLOWUP   ROUTINE                       *
034600*************************************************************
034700 2-BLOWUP.
034900     WRITE PRT-REC FROM NORMAL-PRINT AFTER ADVANCING 0.
035000
035100     MOVE "TRPTHU" TO BU-PGM-NAME.
035200     CALL "TBLOWUP" USING BASE, BU-PGM-NAME, STATUS-AREA,
035300           VIEW-COMAREA, FILE-STATUS, BU-DISPLAY-MSG,
035400           BU-DISPLAY-AREA.
035500
035600 7-INPUT-RECORDS SECTION.

       COPY MTLSINPT IN COPYLIB.

      *8-INPUT-RECORDS-PARA.
      *    MOVE SPACES TO CORPCDE OF MSTORERM-REC-I.
      *    START MSTORERM-I KEY >= CORPCDE OF MSTORERM-REC-I
      *        INVALID KEY MOVE 17 TO COND-WORD.
      *    IF FILE-STATUS NOT = "00"
      *        MOVE "START ERR MSTORERM 8-IR" TO BU-DISPLAY-MSG
      *        PERFORM 2-BLOWUP.
035700*    PERFORM 81-PROCESS-INPUT-RECORDS THRU 81-PIR-EXIT UNTIL
035800*            ALL-INPUT-RECORDS-PROCESSED.
035900*    GO TO 8-IR-EXIT.
036000*
036100*81-PROCESS-INPUT-RECORDS.
036200*    CALL "DBGET" USING BASE DSET-MSTORERM MODE2 STATUS-AREA
036300*                  ALL-ITEM-LIST BUF-MSTORERM NO-ARG.
      *    READ MSTORERM-I NEXT INTO BUF-MSTORERM
      *        AT END MOVE FILE-STATUS TO FILE-STATUS.
036400*    IF FILE-STATUS-1 = "1"
036500*        MOVE "Y" TO END-OF-INPUT-FILE
036600*        GO TO 81-PIR-EXIT
036700*    ELSE
036800*    IF FILE-STATUS NOT = "00"
036900*        MOVE "DBGET ERROR PARA 81-PIR    " TO BU-DISPLAY-MSG
037000*        GO TO 2-BLOWUP.
037100*
037200*    MOVE SPACES TO TEMP-HIGH-USAGE.
037300*    MOVE STR-HIGH-USAGE TO TEMP-HIGH-USAGE.
037400*    SET T-INDEX TO 1.
037500*    IF TEMP-HIGH-USAGE NOT = SPACES
037600*        PERFORM 811-CHECK-USAGE 6 TIMES.
037700*    GO TO 81-PIR-EXIT.
037800*
037900*811-CHECK-USAGE.
038000*    MOVE SPACES                            TO SORT-REC.
038100*    IF T-HU (T-INDEX) NOT = SPACES
038200*      IF ALL-AREAS
038300*        MOVE CORP-CODE                     TO SRT-CORP-CODE
038400*        MOVE T-HU (T-INDEX)                TO SRT-HIGH-USAGE
038500*        MOVE STR-AVG-COST                  TO SRT-AVG-COST
038600*        MOVE STR-UM                        TO SRT-UM
038700*        MOVE STR-ONHAND                    TO SRT-ONHAND
038800*        MOVE STR-DISB-INSTR                TO SRT-DISB-INSTR
038900*        MOVE STR-LAST-IDATE-CN             TO SRT-LAST-IDATE-CN
039000*        MOVE STR-LOC (1)                   TO SRT-LOC1
039100*        MOVE STR-LOC (2)                   TO SRT-LOC2
039200*        MOVE STR-LOC (3)                   TO SRT-LOC3
039300*        MOVE STR-LOC (4)                   TO SRT-LOC4
039400*        MOVE STR-LOC (5)                   TO SRT-LOC5
039500*        MOVE STR-LOC (6)                   TO SRT-LOC6
039600*        RELEASE SORT-REC
039700*    ELSE
039800*     IF T-HU (T-INDEX) = DE-AREA (1) OR
039900*      T-HU (T-INDEX) = DE-AREA (2) OR
040000*      T-HU (T-INDEX) = DE-AREA (3)
040100*        MOVE CORP-CODE                     TO SRT-CORP-CODE
040200*        MOVE T-HU (T-INDEX)                TO SRT-HIGH-USAGE
040300*        MOVE STR-AVG-COST                  TO SRT-AVG-COST
040400*        MOVE STR-UM                        TO SRT-UM
040500*        MOVE STR-ONHAND                    TO SRT-ONHAND
040600*        MOVE STR-DISB-INSTR                TO SRT-DISB-INSTR
040700*        MOVE STR-LAST-IDATE-CN             TO SRT-LAST-IDATE-CN
040800*        MOVE STR-LOC (1)                   TO SRT-LOC1
040900*        MOVE STR-LOC (2)                   TO SRT-LOC2
041000*        MOVE STR-LOC (3)                   TO SRT-LOC3
041100*        MOVE STR-LOC (4)                   TO SRT-LOC4
041200*        MOVE STR-LOC (5)                   TO SRT-LOC5
041300*        MOVE STR-LOC (6)                   TO SRT-LOC6
041400*        RELEASE SORT-REC.
041500*    SET T-INDEX UP BY 1.
041600*
041700*81-PIR-EXIT.
041800*    EXIT.
041900
042000 7-IR-EXIT.
042100     EXIT.
042200
042300 8-WRITE-RECORDS SECTION.
       8-WRITE-RECORDS-PARA.
042400     RETURN SORT-FILE AT END
042500         MOVE "Y" TO END-OF-SORT-FILE
042600         MOVE  1  TO PRT-PAGE
               WRITE PRT-REC FROM HEADING-1 AFTER ADVANCING NEW-PAGE
               WRITE PRT-REC FROM HEADING-2 AFTER ADVANCING 1 LINE
042700*        WRITE PRT-REC FROM HDR-1 AFTER ADVANCING NEW-PAGE
042800*        WRITE PRT-REC FROM HDR-2 AFTER ADVANCING 1 LINES
042900         WRITE PRT-REC FROM HDR-3 AFTER ADVANCING 2 LINES
043000         MOVE NO-SORTED-RECORDS TO PRT-REC
043100         WRITE PRT-REC AFTER ADVANCING 2 LINES
043200         GO TO 2-EOJ.
043300
           PERFORM 9-MOVE-CONTROL-BREAK.

043400     PERFORM 82-PROCESS-SORTED-RECORDS THRU 82-PSR-EXIT
043500             UNTIL ALL-SORTED-RECORDS-PROCESSED.
043600*    IF DE-KEY = "C"

      *------- DON'T PRINT TOTAL LINE IF BIN LOC OR MANUF SORT BECAUSE
      *------- CODES COULD BE DUPLICATED.
           IF MTLS-SORT-OPT NOT = "06" AND MTLS-SORT-OPT NOT = "08"
               MOVE CODES-RELEASED TO PRT-GRD-ITMS
043700         MOVE GRAND-TOTAL TO PRT-GRD-TOTAL
043800         WRITE PRT-REC FROM GRAND-TOTAL-LINE AFTER
043900         ADVANCING 3 LINES.
044000*    ELSE
044100*          MOVE SRT-HIGH-USAGE TO TOT-HIGH-USAGE
044200*          MOVE HU-TOTAL TO P-TOTAL
044300*          WRITE PRT-REC FROM TOTAL-LINE AFTER
044400*                      ADVANCING 2
044500*          MOVE DASHES TO PRT-REC
044600*          WRITE PRT-REC AFTER ADVANCING 1.
044700     GO TO 8-WR-EXIT.
044800
044900 82-PROCESS-SORTED-RECORDS.
045000     IF LINE-K > 57
               PERFORM 9-CHECK-HEADINGS.
045800     MOVE SPACES                   TO PRT-REC, PRT-ITEM-DATA.
045900     MOVE  SRT-CORP-CODE                    TO CODE-ARG.
046000
046100*    IF (DE-KEY = "C") AND (PREV-CODE = SRT-CORP-CODE)
046200*        MOVE SRT-HIGH-USAGE TO PRT-HIGH-USAGE
046300*        WRITE PRT-REC FROM PRT-ITEM-DATA AFTER
046400*                            ADVANCING 1
046500*        ADD 1 TO LINE-K
046600*        PERFORM 92-RETURN-SORT
046700*        GO TO 92-PSR-EXIT
046800*    ELSE
046900*       IF (DE-KEY NOT = "C") AND (SRT-HIGH-USAGE NOT =
047000*          PREV-HIGH-USAGE) AND (PREV-HIGH-USAGE NOT = SPACES)
047100*          MOVE PREV-HIGH-USAGE TO TOT-HIGH-USAGE
047200*          MOVE HU-TOTAL TO P-TOTAL
047300*          WRITE PRT-REC FROM TOTAL-LINE AFTER
047400*                      ADVANCING 2
047500*          MOVE DASHES TO PRT-REC
047600*          WRITE PRT-REC AFTER ADVANCING 1
047700*          MOVE ZERO TO HU-TOTAL
047800*          ADD 3 TO LINE-K.
047900*
048000*    MOVE SRT-HIGH-USAGE TO PREV-HIGH-USAGE.
048100*
048200*
048300*    CALL "DBFIND" USING BASE, DSET-DDESC, MODE1, STATUS-AREA,
048400*            CODE-SEARCH, CODE-ARG.
      *    MOVE CODE-ARG TO CORPCDE OF DDESC-REC-I.
      *    START DDESC-I KEY = CORPCDE OF DDESC-REC-I
      *        INVALID KEY MOVE 17 TO COND-WORD.
      *    IF (FILE-STATUS NOT = "00") AND (FILE-STATUS-1 NOT = "2")
048600*        MOVE "DBFIND ERR DDESC" TO BU-DISPLAY-MSG
048700*        PERFORM 2-BLOWUP.
048800*
048900*    CALL "DBGET" USING BASE, DSET-DDESC, MODE5, STATUS-AREA,
049000*            ALL-ITEM-LIST, BUF-DDESC, CODE-ARG.
      *    MOVE 0 TO COND-WORD.
      *    READ DDESC-I NEXT INTO BUF-DDESC
      *        AT END MOVE FILE-STATUS TO FILE-STATUS.
      *    IF FILE-STATUS NOT = "00"
      *        IF FILE-STATUS = "10" OR "14" OR "46"
      *            MOVE 15 TO COND-WORD
      *        ELSE
      *            MOVE 99 TO COND-WORD.
      *    IF CORPCDE OF DDESC-REC-I NOT = CODE-ARG
      *        MOVE 15 TO COND-WORD.
049100*    IF COND-WORD = 0
049200*        MOVE DESC-DATA                     TO PRT-DESC
049300*    ELSE
049400*        MOVE "* NO DESCRIPTION ON FILE *"  TO PRT-DESC.

           MOVE SRT-KEYWD-MOD      TO  PRT-DESC.
049500
049600 92-CONT.
049700     COMPUTE TOTAL-COST  =  SRT-ONHAND * SRT-COST.
049800     ADD TOTAL-COST TO HU-TOTAL.
049900     MOVE SRT-CORP-CODE TO PREV-CODE.
050000     ADD TOTAL-COST                         TO GRAND-TOTAL.
050100     MOVE SRT-CORP-CODE                     TO PRT-CODE.
050300     MOVE SRT-ONHAND                        TO PRT-ONHAND.
050400     MOVE SRT-UM                            TO PRT-UM.
050500     MOVE SRT-COST                          TO PRT-AVG-COST.
           MOVE CODE-ARG TO CORPCDE OF MSTORERM-REC-I.
           READ MSTORERM-I INTO BUF-MSTORERM
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS-1 = "2"
               INITIALIZE BUF-MSTORERM
           ELSE
           IF FILE-STATUS NOT = "00"
              MOVE "MSTORERM DBGET ERR: 92-CONT" TO BU-DISPLAY-MSG
              PERFORM 2-BLOWUP.
           MOVE STR-HIGH-USAGE-AREA (1)           TO PRT-HIGH-USAGE.
050600     MOVE STR-DISB-INSTR                    TO PRT-DISB.
050700     MOVE 4                            TO DATE-MODE.
050800     MOVE SRT-LAST-IDATE               TO DATE-VALIDATE-IN.
050900     CALL "TDATECHK"  USING DATE-CHECK-AREA.
051000     MOVE DATE-SLASH-OUT                TO PRT-LAST-IDATE.
051100     MOVE STR-LOC (1)                  TO PRT-LOC1.
051200     MOVE STR-LOC (2)                  TO PRT-LOC2.
051300     MOVE STR-LOC (3)                  TO PRT-LOC3.
051400     MOVE STR-LOC (4)                  TO PRT-LOC4.
051500     MOVE STR-LOC (5)                  TO PRT-LOC5.
051600     MOVE STR-LOC (6)                  TO PRT-LOC6.
051700     MOVE TOTAL-COST                        TO PRT-TOTAL.
051800     WRITE PRT-REC FROM PRT-ITEM-DATA AFTER ADVANCING 2 LINES.
051900     WRITE PRT-REC FROM PRT-LOC-DATA  AFTER ADVANCING 1 LINES.
052000     WRITE PRT-REC FROM PRT-DESC-DATA AFTER ADVANCING 1 LINES.
052100     ADD 4              TO LINE-K.
052200
           PERFORM VARYING SUB FROM 2 BY 1 UNTIL SUB > 6
               IF STR-HIGH-USAGE-AREA (SUB) > SPACES
                   PERFORM 9-PRINT-USAGE
               END-IF
           END-PERFORM.

      *---------- PRINT INV LEVELS IF REQUESTED.
           IF MTLS-CODE-OPT = "X"
               PERFORM 9-MOVE-LIMITS
               ADD 1 TO LINE-K
               WRITE PRT-REC FROM USAGE-LIMITS-LINE
                                             AFTER ADVANCING 1 LINE.

           IF LINE-K > 57
               PERFORM 9-CHECK-HEADINGS.

           IF MTLS-DESC-OPT NOT = "X"
               GO TO 82-RETURN-SORT.

052300 92-GET-DESC.
052400*----------  PRINT REST OF DESCRIPTION
052500*    CALL "DBGET" USING BASE, DSET-DDESC, MODE5, STATUS-AREA,
052600*            ALL-ITEM-LIST, BUF-DDESC, CODE-ARG.
           MOVE 0 TO COND-WORD.
           READ DDESC-I NEXT INTO BUF-DDESC
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   MOVE 15 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.
           IF CORPCDE OF DDESC-REC-I NOT = CODE-ARG
               MOVE 15 TO COND-WORD.
052700     IF COND-WORD = 0
052800        MOVE DESC-DATA                      TO PRT-DESC
052900      ELSE
053000        GO TO 82-RETURN-SORT.
053100     WRITE PRT-REC FROM PRT-DESC-DATA AFTER ADVANCING 1 LINES.
053200     ADD 1 TO LINE-K.
053300     IF LINE-K > 57
               PERFORM 9-CHECK-HEADINGS.

054100     GO TO 92-GET-DESC.
054200
054300 82-RETURN-SORT.
054400     RETURN SORT-FILE AT END
054500         MOVE "Y"                           TO END-OF-SORT-FILE.

      *--------- PRINT CONTROL BREAKS.
           IF MTLS-SORT-OPT NOT = "01" AND MTLS-SORT-OPT NOT = "  "
               IF END-OF-SORT-FILE NOT = "Y"
                   PERFORM 9-CHECK-CONTROL-BREAK
               END-IF
               IF END-OF-SORT-FILE = "Y" OR CNTL-BREAK-SW = "Y"
                   MOVE SPACES TO PRT-REC
                   ADD 1              TO  LINE-K
                   WRITE PRT-REC AFTER ADVANCING 1 LINE
                   PERFORM 9-PRINT-CONTROL-BREAK
                   WRITE PRT-REC FROM CONTROL-BREAK-LINE
                                             AFTER ADVANCING 1 LINE
                   PERFORM 9-MOVE-CONTROL-BREAK
                   IF END-OF-SORT-FILE = "N"
                       PERFORM 9-CHECK-HEADINGS.
054600
054700 82-PSR-EXIT.
054800     EXIT.
054900
055000 8-WR-EXIT.
055100     EXIT.
055200
       9-UTILITY SECTION.

       9-PRINT-USAGE.
           MOVE SPACES                     TO PRT-REC, PRT-ITEM-DATA.
           MOVE STR-HIGH-USAGE-AREA (SUB)  TO PRT-HIGH-USAGE.
           WRITE PRT-REC FROM PRT-ITEM-DATA AFTER
                               ADVANCING 1.
           ADD 1 TO LINE-K.

       COPY OVRPFCALL IN COPYLIB.

       COPY MTLSUTIL  IN COPYLIB.

       9-CHECK-HEADINGS.
           ADD     1      TO PAGE-K.
           MOVE    1      TO LINE-K.
           MOVE PAGE-K    TO PRT-PAGE.
           ADD     3      TO LINE-K.
           WRITE PRT-REC FROM HEADING-1 AFTER ADVANCING NEW-PAGE.
           WRITE PRT-REC FROM HEADING-2 AFTER ADVANCING 1 LINE.
           IF MTLS-SORT-OPT > SPACES AND MTLS-SORT-OPT NOT = "01"
             MOVE CNTL-BREAK-HOLD-FIELD TO PRT-H2B-VALUE
             WRITE PRT-REC FROM HEADING-2B AFTER ADVANCING 1 LINE
             ADD   1      TO LINE-K.
      *    WRITE PRT-REC FROM HDR-1 AFTER ADVANCING NEW-PAGE.
      *    WRITE PRT-REC FROM HDR-2 AFTER ADVANCING 1 LINES.
           WRITE PRT-REC FROM HDR-3 AFTER ADVANCING 2 LINES.

      *------- DUMMY PARAGRAPH; NOT USED IN THIS PROGRAM.
       9-COMPUTE-USAGE.
           EXIT.
