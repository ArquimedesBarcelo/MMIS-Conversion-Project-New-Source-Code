      **************************************************

       62-CHECK-DDESC.
           IF (DESC-ID-NUM = 99)
                   AND (DE-LOC-DESC = DESC-DATA)
               GO TO 62-WRITE-DAILYTC.
           IF (DESC-ID-NUM NOT = 99)
                   AND (DE-LOC-DESC = SPACES)
               GO TO 62-WRITE-DAILYTC.

       62-MODIFY-DDESC.
           MOVE SPACES TO BUF-DDESC.
           MOVE CODE-ARG TO CORPCDE OF DDESC-REC-O.
           MOVE "99" TO DESCIDNUM OF DDESC-REC-O.
           READ DDESC-O INTO BUF-DDESC
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS-1 = "2"
               NEXT SENTENCE
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE "READ DDESC *62-MD" TO BU-DISPLAY-MSG
               GO TO 2-BLOWUP.
           IF (DESC-ID-NUM = 99)
                   AND (DE-LOC-DESC = SPACES)
               DELETE DDESC-O
                 INVALID KEY MOVE FILE-STATUS TO FILE-STATUS END-DELETE
               IF FILE-STATUS = "00"
                   GO TO 62-WRITE-DAILYTC
               ELSE
                   MOVE "DELETE 62-MODIFY-DDESC" TO BU-DISPLAY-MSG
                   GO TO 2-BLOWUP.
           IF (DESC-ID-NUM = 99)
                   AND (DE-LOC-DESC NOT = DESC-DATA)
               MOVE DE-LOC-DESC TO DESC-DATA
               REWRITE DDESC-REC-O FROM BUF-DDESC
                INVALID KEY MOVE FILE-STATUS TO FILE-STATUS END-REWRITE
               IF FILE-STATUS = "00"
                   GO TO 62-WRITE-DAILYTC
               ELSE
                   MOVE "UPDATE 62-MODIFY-DDESC" TO BU-DISPLAY-MSG
                   GO TO 2-BLOWUP.
           IF (DESC-ID-NUM NOT = 99)
                   AND (DE-LOC-DESC NOT = SPACES)
               MOVE CORP-CODE TO DESC-CORP-CODE
               MOVE DE-LOC-DESC TO DESC-DATA
               MOVE "99" TO DESC-ID-NUM
               WRITE DDESC-REC-O FROM BUF-DDESC
                 INVALID KEY MOVE FILE-STATUS TO FILE-STATUS END-WRITE
               IF FILE-STATUS = "00"
                   GO TO 62-WRITE-DAILYTC
               ELSE
                   MOVE "PUT 62-MODIFY-DDESC" TO BU-DISPLAY-MSG
                   GO TO 2-BLOWUP.

264100****************************************************
264200*                                                  *
264300*   UPDATE DDAILYTC WITH ALL THE 311 TC NECESSARY  *
264400*   TO CONVEY ALL CHANGES MADE UP THE FIVE         *
264500*   TC 311's CAN BE CUT ID 1-5. NOW TC 311 ID 1 IS *
264600*   ALWAYS CUT EVEN IT NO VALUES WERE MODIFIED IN  *
264700*   THAT TC                                        *
264800*                                                  *
264900****************************************************
265000
265100 62-WRITE-DAILYTC.
265200     MOVE 1                         TO DATE-MODE.
265300     CALL "TDATECK2" USING DATE-CHECK-AREA, LANGUAGE-PARMS.
265400     MOVE DATE-YMD-OUT              TO DDAILYTC-DATE.
265500     ACCEPT DDAILYTC-TIME FROM TIME.
265600     MOVE "311"                     TO DDAILYTC-TC.
265700     MOVE PASS-COMPANY-CODE         TO DDAILYTC-PLT.
265800     MOVE CORP-CODE                 TO TC311-CORP-CODE.
265900
266700***************************
266800*                         *
266900*  TC 311 ID 1            *
267000*                         *
267100***************************
267200
267300 62-CHECK-DATA-ID-1.
267400     IF TC-ID-1-SW = "N"
267500         GO TO 62-CHECK-DATA-ID-2.
267600     MOVE SPACES         TO TC311-TC-DATA.
267700     MOVE "1"            TO TC311-ID-1.
267800     MOVE DE-PREV-CODE   TO TC311-PREV-CODE.
267900     MOVE DE-AUTHOR      TO TC311-AUTHOR.
268000     MOVE DE-CLASS       TO TC311-CLASS.
268100     MOVE DE-DIR-CHRG    TO TC311-DIR-CHRG.
268200     MOVE DE-DFLT-DEPT   TO TC311-DEPT-CHG.
268300     MOVE DE-WR-DOWN     TO TC311-WR-DOWN.
268400     MOVE DE-STOCK-OT    TO TC311-STOCK-OT.
268500     MOVE DE-IMPORT      TO TC311-IMPORT.
268600     MOVE DE-INS-ITM     TO TC311-INS-ITM.
268700     MOVE DE-ORD-ENG     TO TC311-ORD-ENG.
268800     MOVE DE-OUT-REP     TO TC311-OUT-REP.
268900     MOVE DE-MAINT       TO TC311-MAINT.
269000     MOVE STR-LOC (1)    TO TC311-STOCK-LOC.
269100     PERFORM 4-DBPUT-DDAILYTC THRU 4-DDT-X.
269200     IF FILE-STATUS NOT = "00"
269300         MOVE "PUT DDAILYTC TC331-1" TO BU-DISPLAY-MSG
269400         GO TO 2-BLOWUP.
269500
      ***************************
      *                         *
      *  TC 311 ID 2            *
      *                         *
      ***************************

       62-CHECK-DATA-ID-2.
           IF TC-ID-2-SW = "N"
               GO TO 62-UCC-X.
           MOVE SPACES         TO TC311-TC-DATA.
           MOVE "2"            TO TC311-ID-2.
           MOVE DE-LOC-DESC    TO TC311-LOC-DESC.
           PERFORM 4-DBPUT-DDAILYTC THRU 4-DDT-X.
           IF FILE-STATUS NOT = "00"
               MOVE "PUT DDAILYTC TC331-2" TO BU-DISPLAY-MSG
               GO TO 2-BLOWUP.

       62-UCC-X.
           EXIT.

       COPY DISPCALL IN COPYLIB.

       998-AUTO-READ-SCREEN.
           READ  DISPLAY-FILE TERMINAL IS TERMINAL-ID
               INDIC ARE SRF-INDICATORS
                   NO DATA MOVE DISPLAY-STATUS TO DISPLAY-STATUS.
           MOVE ALL B"0" TO SRF-INDICATORS.

312200 999-CATREAD.
           IF CATREAD-MSG-NUMBER = ZEROS
               MOVE LANG-SETNUM TO CATREAD-MSG-SET
               MOVE LANG-MSGNUM TO CATREAD-MSG-NUM.
           CALL "CCATREAD" USING CATREAD-PARMS.
           MOVE CATREAD-MSG-TEXT TO MESSAGE-BUFFER.
313800
313900 999-CATREAD-EXIT.
314000     EXIT.
