       IDENTIFICATION DIVISION.
       PROGRAM-ID.             TPMSCHG1.
       AUTHOR.                 J.S. BUNGO.
       INSTALLATION.           GOODYEAR TIRE & RUBBER CO.
      *REMARKS.                PREVENTIVE MAINTENANCE SCHEDULE CONVERT
      *                        THIS IS A UTILITY PROGRAM TO CONVERT PM
      *                        SCHEDULES (AUTO AND FIXED DATE) AND THE
      *                        PM OPEN QUEUE FROM THE E01/F01 RELEASE
      *                        TO THE G01 RELEASE.
       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.
       SOURCE-COMPUTER.        HP-3000.
       OBJECT-COMPUTER.        HP-3000.

       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT PM-MASTER-SCHED
                  ASSIGN TO DATABASE-MCFLMM4301
                  ORGANIZATION IS INDEXED
                  ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                  FILE STATUS IS FILE-STAT.
           SELECT PREV-MAINT
                  ASSIGN TO DATABASE-MCFLMM1401
                  ORGANIZATION IS INDEXED
                  ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                  FILE STATUS IS FILE-STAT.
           SELECT PM-TRANS-FILE
                  ASSIGN TO DATABASE-MCFLMM1501
                  ORGANIZATION IS INDEXED
                  ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                  FILE STATUS IS FILE-STAT.
           SELECT PM-SCHEDULE
                  ASSIGN TO DATABASE-MCFLMM4403
                  ORGANIZATION IS INDEXED
                  ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                  FILE STATUS IS FILE-STAT.
           SELECT PM-QUEUE
                  ASSIGN TO DATABASE-MCFLMM3902
                  ORGANIZATION IS INDEXED
                  ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                  FILE STATUS IS FILE-STAT.
           SELECT PM-OPEN-QUEUE
                  ASSIGN TO DATABASE-MCFPMM3900
                  ORGANIZATION IS SEQUENTIAL
                  ACCESS MODE IS SEQUENTIAL
                  FILE STATUS IS FILE-STAT.
           SELECT WO-PLANNED
                  ASSIGN TO DATABASE-MCFLMM1101
                  ORGANIZATION IS INDEXED
                  ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                  FILE STATUS IS FILE-STAT.
           SELECT PRINT-FILE
                  ASSIGN TO PRINTER-MCPRT.
       DATA DIVISION.
       FILE SECTION.
       FD  PM-MASTER-SCHED
           LABEL RECORDS ARE STANDARD.
       01  PMS-REC.
           COPY DDS-ALL-FORMATS OF MCFLMM4301.
       FD  PREV-MAINT
           LABEL RECORDS ARE STANDARD.
       01  PREV-MAINT-REC.
           COPY DDS-ALL-FORMATS OF MCFLMM1401.
       FD  PM-TRANS-FILE
           LABEL RECORDS ARE STANDARD.
       01  PM-TRANS-REC.
           COPY DDS-ALL-FORMATS OF MCFLMM1501.
       FD  PM-SCHEDULE
           LABEL RECORDS ARE STANDARD.
       01  PM-SCHED-REC.
           COPY DDS-ALL-FORMATS OF MCFLMM4403.
       FD  PM-QUEUE
           LABEL RECORDS ARE STANDARD.
       01  PMQ-REC.
           COPY DDS-ALL-FORMATS OF MCFLMM3902.
       FD  PM-OPEN-QUEUE
           LABEL RECORDS ARE STANDARD.
       01  PMOQ-REC.
           COPY DDS-ALL-FORMATS OF MCFPMM3900.
       FD  WO-PLANNED
           LABEL RECORDS ARE STANDARD.
       01  WO-PLANNED-REC.
           COPY DDS-ALL-FORMATS OF MCFLMM1101.
       FD  PRINT-FILE RECORD CONTAINS 80 CHARACTERS
           LABEL RECORD IS OMITTED
           DATA RECORD IS PRINT-REC.
       01  PRINT-REC.
           05  PRT-SCH-CONV.
               10  PRT-SCH-TXT1  PIC X(12).
               10  PRT-SCH-EQP   PIC X(6).
               10  PRT-SCH-TXT2  PIC X(2).
               10  PRT-SCH-WO    PIC X(07).
               10  PRT-SCH-SUFF  PIC X(03).
               10  FILLER        PIC X(50).
           05  PRT-PREREL REDEFINES PRT-SCH-CONV.
               10  PRT-PREREL-TXT  PIC X(27).
               10  PRT-PREREL-DATE PIC X(08).
               10  PRT-PREREL-TXT2 PIC X(08).
               10  PRT-PREREL-LVL  PIC X(02).
               10  FILLER          PIC X(35).
           05  PRT-REL REDEFINES PRT-SCH-CONV.
               10  PRT-REL-TXT     PIC X(16).
               10  PRT-REL-DATE    PIC X(8).
               10  PRT-REL-TXT2    PIC X(08).
               10  PRT-REL-LVL     PIC X(02).
               10  FILLER          PIC X(26).
           05  PRT-FIX REDEFINES PRT-SCH-CONV.
               10  PRT-FIX-TXT1    PIC X(21).
               10  PRT-FIX-EQP     PIC X(6).
               10  PRT-FIX-TXT2    PIC X(3).
               10  PRT-FIX-WO      PIC X(10).
               10  FILLER          PIC X(40).
           05  PRT-Q REDEFINES PRT-SCH-CONV.
               10  PRT-Q-TXT1      PIC X(18).
               10  PRT-Q-EQP       PIC X(06).
               10  PRT-Q-TXT2      PIC X(02).
               10  PRT-Q-WO        PIC X(10).
               10  PRT-Q-TXT3      PIC X(3).
               10  PRT-Q-DESC      PIC X(30).
               10  FILLER          PIC X(08).
       WORKING-STORAGE SECTION.
       77  FILE-STAT           PIC X(2)  VALUE SPACES.
       77  BASE                PIC X(16) VALUE SPACES.
       77  ARG-NO              PIC S9(9) VALUE 1  COMP.
       77  ITEM-EQUIP          PIC X(16) VALUE "PM-EQUIP-NUM;".
       77  ITEM-WO-EQP         PIC X(16) VALUE "EQUIP-NUM;".
       77  ITEM-WO             PIC X(16) VALUE "WO-NUM;".
       77  ITEM-SCHED          PIC X(16) VALUE "PM-SCHED-KEY;".
       77  RETURN-CODE         PIC XX    VALUE "0 ".
       77  MAX-DAYS            PIC 9(4)  VALUE 400.
       77  MANUAL-FLAG         PIC X     VALUE "N".
       77  LEVEL-KEY           PIC X(02).
       77  EQUIP-KEY           PIC X(06).
       77  SCHED-KEY           PIC X(10) VALUE SPACES.
       01  WO-KEY.
           05  WO-KEY-NUM      PIC X(07).
           05  WO-KEY-SUFF     PIC X(03).

       01  CURRENTDATE.
           05  CURRDATE-YY     PIC 9(2).
           05  CURRDATE-MM     PIC 9(2).
           05  CURRDATE-DD     PIC 9(2).

       01  CURR-DATE.
           05  CD-YYYY-X.
               10  CD-CT       PIC 9(2).
               10  CD-YY       PIC 9(2).
           05  CD-YYYY REDEFINES CD-YYYY-X PIC 9(4).
           05  CD-MM           PIC 9(2).
           05  CD-DD           PIC 9(2).
       01  CURR-DATE2 REDEFINES CURR-DATE.
           05  FILLER          PIC 9(2).
           05  CD-YYMMDD       PIC 9(6).

       01  TODAYS-DATE.
           05  TD-YYYY.
               10  TD-CT       PIC 9(2).
               10  TD-YY       PIC 9(2).
           05  TD-MM           PIC 9(2).
           05  TD-DD           PIC 9(2).

       01  STOP-DATE.
           05  STOP-YYYY.
               10  STOP-CT       PIC 9(2).
               10  STOP-YY       PIC 9(2).
           05  STOP-MM           PIC 9(2).
           05  STOP-DD           PIC 9(2).

       01  WS-DATE.
           05  WS-CT             PIC 9(2).
           05  WS-YYMMDD.
               10  WS-YY         PIC 9(2).
               10  WS-MM         PIC 9(2).
               10  WS-DD         PIC 9(2).
       01  WS-DATE2 REDEFINES WS-DATE.
           05  WS-YYYY           PIC 9(4).
           05  WS-MMDD           PIC 9(4).

       01  JUL-DATE            PIC S9(5).
       01  JUL-YP REDEFINES JUL-DATE.
           05  JUL-Y           PIC S99.
           05  JUL-P           PIC S999.
       01  CENTURY-P           PIC S9(4).

       01  DB-ERROR.
           05  DB-TYPE   PIC X(08) VALUE SPACES.
           05  FILLER    PIC X(21) VALUE " ERROR - COND-WORD = ".
           05  CON-WORD  PIC -9999.

       01  WS-DESCRIPTION.
           05  FILLER      PIC X(6).
           05  WS-DESC-LVL PIC 9(2).
           05  WS-DESC-LVL12 REDEFINES WS-DESC-LVL.
               10  WS-DESC-LVL1  PIC X(1).
               10  FILLER        PIC 9(1).
           05  FILLER      PIC X(14).
           05  WS-DESC-MAN PIC X(6).

       01  WS-PR-ID.
           05  WS-PR-DAY         PIC 9(3).
           05  WS-PR-TIME.
               10  WS-PR-TIME-9  PIC 9(7).
       01  WS-LAST-PR-TIME       PIC 9(7).

       01  RIME-FIELDS.
           05  RIME-X.
               10  RIME-0  PIC 9.
               10  RIME-9  PIC 9.
           05  RIME-CALC REDEFINES RIME-X PIC 99.

       01  INIT-SIM-FLAG   PIC X(01).
           88  INITIATOR               VALUE "I".
           88  SIMULATOR               VALUE "S".
       01  INIT-PARMS.
           05  INIT-EQUIP          PIC X(06).
           05  INIT-WONUM.
               10  INIT-WONUM-WO   PIC X(7).
               10  INIT-WONUM-SUFF PIC X(3).
           05  INIT-SCHED          PIC X(10).
           05  INIT-DATE           PIC X(08).

       01  EQP-TABLE.
           05  EQP-PM-DATA OCCURS 12 TIMES.
               10  EQP-PM-EQUIP-NUM         PIC X(06).
               10  EQP-PM-EQUIP-RIME        PIC 99.
               10  EQP-PM-WO-NUM.
                   15  EQP-PM-WO-NUMBER     PIC 9(06).
                   15  EQP-PM-WO-YEAR       PIC X(01).
                   15  EQP-PM-WO-SUFFIX     PIC 9(03).
               10  EQP-PM-LEVEL             PIC 99.
               10  EQP-PM-CYCLE             PIC 9(04).
               10  EQP-PM-OPS-HOURS         PIC 9(04).
               10  EQP-PM-PC-COUNT          PIC 9(04).
               10  EQP-PM-ADDL-CYCLE        PIC 9(04).
               10  EQP-PM-CRITICAL          PIC 9(04).
               10  EQP-PM-LOOK-AHEAD        PIC 9(04).
               10  EQP-PM-PRE-REL           PIC 9(04).
               10  EQP-PM-PRTY              PIC X(02).
               10  EQP-PM-LAST-REL          PIC 9(06).
               10  EQP-PM-NEXT-REL          PIC 9(06).
               10  EQP-PM-SCHED-DT          PIC 9(06).
               10  EQP-PM-LAST-COMP         PIC 9(06).
               10  EQP-PM-EXEC-FLAG         PIC 9.
               10  EQP-PM-FIX-FLAG          PIC X.
               10  EQP-PM-PAD-AREA          PIC X(10).
       01  SAVE-PM-DATA.
               10  SAV-PM-EQUIP-NUM         PIC X(06).
               10  SAV-PM-EQUIP-RIME        PIC 99.
               10  SAV-PM-WO-NUM.
                   15  SAV-PM-WO-NUMBER     PIC 9(06).
                   15  SAV-PM-WO-YEAR       PIC X(01).
                   15  SAV-PM-WO-SUFFIX     PIC 9(03).
               10  SAV-PM-LEVEL             PIC 99.
               10  SAV-PM-CYCLE             PIC 9(04).
               10  SAV-PM-OPS-HOURS         PIC 9(04).
               10  SAV-PM-PC-COUNT          PIC 9(04).
               10  SAV-PM-ADDL-CYCLE        PIC 9(04).
               10  SAV-PM-CRITICAL          PIC 9(04).
               10  SAV-PM-LOOK-AHEAD        PIC 9(04).
               10  SAV-PM-PRE-REL           PIC 9(04).
               10  SAV-PM-PRTY              PIC X(02).
               10  SAV-PM-LAST-REL          PIC 9(06).
               10  SAV-PM-NEXT-REL          PIC 9(06).
               10  SAV-PM-SCHED-DT          PIC 9(06).
               10  SAV-PM-LAST-COMP         PIC 9(06).
               10  SAV-PM-EXEC-FLAG         PIC 9.
               10  SAV-PM-FIX-FLAG          PIC X.
               10  SAV-PM-PAD-AREA          PIC X(10).

       01  LAST-EQUIP-NUM                   PIC X(06).
       01  LAST-WO-NUM                      PIC X(10).
       01  LAST-ERROR-EQP                   PIC X(06).
       01  HIGHEST-LEVEL                    PIC 99.
       01  START-LEVEL                      PIC 99.
       01  LEVEL1                           PIC 99.
       01  LEVEL2                           PIC 99.
       01  LEVEL3                           PIC 99.
       01  LA-DATE                          PIC 9(06).
       01  OLD-INIT-DATE                    PIC 9(08).

       01  DBPARAMETERS.       COPY DBPARMS IN COPYLIB.
       COPY DBSTAT IN COPYLIB.
       01  WO-PLANNED-DATA.    COPY DWOPLAN IN COPYLIB.
       01  PM-SCHED-DATA.      COPY DPMSCHED IN COPYLIB.
       01  PMOQ-DATA.          COPY DPMOPENQ IN COPYLIB.
       01  PM-TRANS-DATA.      COPY TRANSFIL IN COPYLIB.
       01  PREV-MAINT-DATA.    COPY DPMTRANS IN COPYLIB.
       01  PM-MSCHED-DATA.     COPY DPMMSTSC IN COPYLIB.
       COPY VCOMAREA IN COPYLIB.
       COPY LANGSUB IN COPYLIB.
       01  MESSAGE-BUFFER-DATA. COPY ERRORLIN IN COPYLIB.
       COPY TBLOWUP IN COPYLIB.
       COPY OVRPFDATA IN COPYLIB.

       PROCEDURE DIVISION.
       BEGIN.
           MOVE LOW-VALUES     TO STATUS-AREA.
           MOVE ZEROS          TO WS-LAST-PR-TIME.
           MOVE "  MMISA;"     TO BASE.

           OPEN INPUT PREV-MAINT
                      PM-TRANS-FILE
                      PM-MASTER-SCHED.
           OPEN I-O   WO-PLANNED
                      PM-SCHEDULE
                      PM-QUEUE
                      PM-OPEN-QUEUE.

      *    MOVE 0 TO OVRPRTF-TOFILE-NUM.
           MOVE "P " TO OVRPRTF-TOFILE-NUM-X.
           COPY OVRPFCALL IN COPYLIB.
           OPEN OUTPUT PRINT-FILE.

           ACCEPT CURRENTDATE FROM DATE.

           IF CURRDATE-YY > 90
               MOVE 19 TO CD-CT TD-CT
           ELSE
               MOVE 20 TO CD-CT TD-CT.
           MOVE CURRDATE-YY TO TD-YY CD-YY.
           MOVE CURRDATE-MM TO TD-MM CD-MM.
           MOVE CURRDATE-DD TO TD-DD CD-DD.

           PERFORM SCHEDULE-CONVERT THRU SCHEDULE-CONVERT-EXIT.
           PERFORM FIXED-DATE-CONVERT THRU FIXED-DATE-CONVERT-EXIT.
           PERFORM QUEUE-CONVERT THRU QUEUE-CONVERT-EXIT.
           CLOSE      PREV-MAINT
                      PM-TRANS-FILE
                      PM-MASTER-SCHED
                      WO-PLANNED
                      PM-SCHEDULE
                      PM-QUEUE
                      PM-OPEN-QUEUE.
           GOBACK.

       SCHEDULE-CONVERT.
           MOVE SPACES TO PRINT-REC.
           MOVE "*********************************************"
               TO PRINT-REC.
           WRITE PRINT-REC AFTER ADVANCING 3 LINES.
           MOVE "PM SCHEDULE CONVERSION TO NEW SCHEDULE FORMAT"
               TO PRINT-REC.
           WRITE PRINT-REC AFTER ADVANCING 1 LINE.
           MOVE "*********************************************"
               TO PRINT-REC.
           WRITE PRINT-REC AFTER ADVANCING 1 LINE.
           MOVE SPACES TO LAST-EQUIP-NUM LAST-ERROR-EQP LAST-WO-NUM.
           MOVE ZEROS TO HIGHEST-LEVEL.
       SCHEDULE-LOOP.
           READ PREV-MAINT NEXT INTO PREV-MAINT-DATA
               AT END MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT = "10" OR "14" OR "46"
               IF HIGHEST-LEVEL NOT = ZEROS
                   IF EQP-PM-FIX-FLAG (HIGHEST-LEVEL) = "Y"
                       PERFORM FIX-RELEASE THRU FIX-RELEASE-EXIT
                   ELSE
                       PERFORM INIT-LAST-EQUIP THRU
                               INIT-LAST-EQUIP-EXIT
                   END-IF
               END-IF
               MOVE SPACES TO PRINT-REC
               MOVE "** END OF CONVERTING PM SCHEDULES **"
                 TO PRINT-REC
               WRITE PRINT-REC AFTER ADVANCING 2 LINES
               GO TO SCHEDULE-CONVERT-EXIT
           ELSE
           IF FILE-STAT NOT = "00"
               MOVE "READ PREV-MAINT ERROR" TO BU-DISPLAY-MSG
               MOVE ARG-NO TO BU-DISPLAY-FLD (2)
               PERFORM 999-BLOWUP.

           IF PM-WO-NUM = SPACES
               GO TO SCHEDULE-LOOP.

      *-----PROCESS ONE EQUIPMENT AT A TIME AFTER READING ALL LEVELS
           IF PM-EQUIP-NUM NOT = LAST-EQUIP-NUM
               IF HIGHEST-LEVEL NOT = ZEROS
                   MOVE PREV-MAINT-DATA TO SAVE-PM-DATA
                   MOVE SPACES TO PRINT-REC
                   MOVE "CONVERT FOR " TO PRT-SCH-TXT1
                   MOVE LAST-EQUIP-NUM TO PRT-SCH-EQP
                   MOVE ", " TO PRT-SCH-TXT2
                   MOVE LAST-WO-NUM    TO PRT-SCH-WO
                   MOVE "000"          TO PRT-SCH-SUFF
                   WRITE PRINT-REC AFTER ADVANCING 2 LINES
                   IF EQP-PM-FIX-FLAG (HIGHEST-LEVEL) = "Y"
                       PERFORM FIX-RELEASE THRU FIX-RELEASE-EXIT
                   ELSE
                       PERFORM INIT-LAST-EQUIP THRU
                               INIT-LAST-EQUIP-EXIT
                   END-IF
                   MOVE SAVE-PM-DATA TO PREV-MAINT-DATA
               END-IF
      *        IF PM-EXEC-FLAG NOT = 0
      *-------------SCHEDULE RECORD IS ACTIVE ALREADY
      *            GO TO SCHEDULE-LOOP
      *        END-IF

               IF PM-NEXT-REL NOT NUMERIC
      *-------------SCHEDULE IS NOT INITIALIZED
                   MOVE ZEROS TO HIGHEST-LEVEL
                   GO TO SCHEDULE-LOOP
               END-IF

      *---------CHECK IF SCHEDULE HAS BEEN CONVERTED ALREADY
               MOVE PM-EQUIP-NUM TO EQUIP-KEY
      *        MOVE PM-LEVEL TO LEVEL-KEY
               MOVE PM-WO-NUM TO WO-KEY
               MOVE ZEROS TO WO-KEY-SUFF
               MOVE "00" TO FILE-STAT
               PERFORM CHECK-CONVERT THRU CHECK-CONVERT-EXIT
               IF FILE-STAT = "00"
                   IF LAST-ERROR-EQP NOT = PM-EQUIP-NUM
                       MOVE SPACES TO PRINT-REC
                       MOVE "CONVERT FOR " TO PRT-SCH-TXT1
                       MOVE PM-EQUIP-NUM TO PRT-SCH-EQP
                       MOVE ", " TO PRT-SCH-TXT2
                       MOVE PM-WO-NUM    TO PRT-SCH-WO
                       MOVE "000"        TO PRT-SCH-SUFF
                       WRITE PRINT-REC AFTER ADVANCING 2 LINES
                       MOVE SPACES TO PRINT-REC
                       MOVE "  ALREADY CONVERTED" TO PRINT-REC
                       WRITE PRINT-REC AFTER ADVANCING 1 LINE
                       MOVE ZEROS TO HIGHEST-LEVEL
                       MOVE PM-EQUIP-NUM TO LAST-ERROR-EQP
                   END-IF
                   GO TO SCHEDULE-LOOP
               END-IF

               PERFORM GET-WO-PLANNED THRU GET-WO-PLANNED-EXIT

      *---------CHECK FOR MASTER SCHEDULE LINK
               IF PM-SCHEDULE-KEY = SPACES
                   IF LAST-ERROR-EQP NOT = PM-EQUIP-NUM
                       MOVE SPACES TO PRINT-REC
                       MOVE "CONVERT FOR " TO PRT-SCH-TXT1
                       MOVE PM-EQUIP-NUM TO PRT-SCH-EQP
                       MOVE ", " TO PRT-SCH-TXT2
                       MOVE PM-WO-NUM    TO PRT-SCH-WO
                       MOVE "000"        TO PRT-SCH-SUFF
                       WRITE PRINT-REC AFTER ADVANCING 2 LINES
                       MOVE SPACES TO PRINT-REC
                   MOVE "  NOT CONVERTED, NO MASTER SCHED LINKED TO WO"
                         TO PRINT-REC
                       WRITE PRINT-REC AFTER ADVANCING 1 LINE
                       MOVE ZEROS TO HIGHEST-LEVEL
                       MOVE PM-EQUIP-NUM TO LAST-ERROR-EQP
                   END-IF
                   GO TO SCHEDULE-LOOP
               END-IF

               MOVE SPACES TO EQP-TABLE
               MOVE PM-EQUIP-NUM TO LAST-EQUIP-NUM
               MOVE PM-WO-NUM TO LAST-WO-NUM
               MOVE 0 TO HIGHEST-LEVEL
               MOVE 1 TO START-LEVEL
           END-IF.
           MOVE PREV-MAINT-DATA TO EQP-PM-DATA (PM-LEVEL).
           IF PM-LEVEL > HIGHEST-LEVEL
               MOVE PM-LEVEL TO HIGHEST-LEVEL
           END-IF.
           IF PM-EXEC-FLAG = 1
               ADD 1 TO PM-LEVEL GIVING START-LEVEL
           END-IF.
           GO TO SCHEDULE-LOOP.
       SCHEDULE-CONVERT-EXIT.
           EXIT.

       FIX-RELEASE.
           PERFORM CALC-OLD-INIT-DATE THRU CALC-OLD-INIT-DATE-EXIT.
           MOVE "I" TO INIT-SIM-FLAG.
           MOVE LAST-EQUIP-NUM TO INIT-EQUIP.
           MOVE PM-SCHEDULE-KEY TO INIT-SCHED.
           MOVE WO-KEY TO INIT-WONUM.
           MOVE OLD-INIT-DATE TO INIT-DATE.
           CALL "SPMINITL" USING DBPARAMETERS VIEW-COMAREA
                 LANGUAGE-PARMS INIT-SIM-FLAG INIT-PARMS.
           MOVE SPACES TO PRINT-REC.
           MOVE "  FIXED RECORDS WRITTEN FOR ALL LEVELS"
              TO PRINT-REC.
           WRITE PRINT-REC AFTER ADVANCING 1 LINE.
       FIX-RELEASE-EXIT.
           EXIT.

       INIT-LAST-EQUIP.
           IF START-LEVEL > HIGHEST-LEVEL
               GO TO INIT-LAST-EQUIP-EXIT.
           MOVE START-LEVEL TO LEVEL1.
           ADD 1 TO LEVEL1 GIVING LEVEL2.
           PERFORM CALC-LA-DATE THRU CALC-LA-DATE-EXIT.
           PERFORM UNTIL LEVEL2 > HIGHEST-LEVEL
               IF EQP-PM-SCHED-DT (LEVEL2) NOT > LA-DATE
                   MOVE LEVEL2 TO LEVEL1
                   ADD 1 TO LEVEL2
                   PERFORM CALC-LA-DATE THRU CALC-LA-DATE-EXIT
               ELSE
                   ADD 1 TO LEVEL2
               END-IF
           END-PERFORM.
           IF LEVEL1 NOT = START-LEVEL
               MOVE EQP-PM-SCHED-DT (START-LEVEL) TO
                    EQP-PM-SCHED-DT (LEVEL1)
               MOVE LEVEL1 TO START-LEVEL
           END-IF.
           PERFORM WRITE-LEVEL THRU WRITE-LEVEL-EXIT
               VARYING LEVEL3 FROM START-LEVEL BY 1
                   UNTIL LEVEL3 > HIGHEST-LEVEL.
       INIT-LAST-EQUIP-EXIT.
           EXIT.

       CALC-LA-DATE.
           MOVE EQP-PM-SCHED-DT (LEVEL1) TO WS-YYMMDD.
           IF WS-YY > 90
               MOVE 19 TO WS-CT
           ELSE
               MOVE 20 TO WS-CT.
           CALL "JULIANDATE" USING WS-YYMMDD JUL-DATE.
           ADD EQP-PM-LOOK-AHEAD (LEVEL1) TO JUL-P.
           PERFORM ADJUST-JULIAN-DOWN UNTIL JUL-P < 366.
           CALL "GREGDATE" USING JUL-DATE WS-YYMMDD.
           MOVE WS-YYMMDD TO LA-DATE.
       CALC-LA-DATE-EXIT.
           EXIT.

       CALC-OLD-INIT-DATE.
           MOVE EQP-PM-SCHED-DT (HIGHEST-LEVEL) TO WS-YYMMDD.
           IF WS-YY > 90
               MOVE 19 TO WS-CT
           ELSE
               MOVE 20 TO WS-CT.
           CALL "JULIANDATE" USING WS-YYMMDD JUL-DATE.
           SUBTRACT EQP-PM-CYCLE (HIGHEST-LEVEL) FROM JUL-P.
           PERFORM ADJUST-JULIAN-UP UNTIL JUL-P > 0.
           CALL "GREGDATE" USING JUL-DATE WS-YYMMDD.
           MOVE WS-DATE TO OLD-INIT-DATE.
       CALC-OLD-INIT-DATE-EXIT.
           EXIT.

       WRITE-LEVEL.
           MOVE SPACES TO WS-PR-ID.
           MOVE SPACES TO PM-SCHED-DATA.
           MOVE EQP-PM-DATA (LEVEL3) TO PREV-MAINT-DATA.
           IF PM-PRE-REL > 0
             IF PM-SCHED-DT NOT NUMERIC
                 MOVE SPACES TO PRINT-REC
                 MOVE "  NOT CONVERTED, BAD DATA" TO PRINT-REC
                 WRITE PRINT-REC AFTER ADVANCING 1 LINE
                 GO TO WRITE-LEVEL-EXIT
             END-IF
             PERFORM CALC-PR-ID THRU CALC-PR-ID-EXIT
             IF PM-NEXT-REL = 999999 OR 000000
      *---------WORK ORDER HAS ALREADY BEEN PRE RELEASED
                 MOVE PM-WO-NUM TO WO-KEY
                 PERFORM GET-WO-PLANNED THRU GET-WO-PLANNED-EXIT
                 IF PM-NEXT-REL = 000000
      *---------------WORK ORDER PRE RELEASED BUT NOT SCHEDULED
                     IF WO-STATUS-P = "OO"
      *-----------------UPDATE "OO" STATUS TO "PR" WO-STATUS
                         MOVE "PR" TO WO-STATUS-P
                         PERFORM UPDATE-WO-PLANNED THRU
                                 UPDATE-WO-PLANNED-EXIT
                         MOVE SPACES TO PRINT-REC
                         MOVE "  PREREL WO CHANGED TO PR STATUS"
                           TO PRINT-REC
                         WRITE PRINT-REC AFTER ADVANCING 1 LINE
                     END-IF
                 END-IF
                 PERFORM GET-OPEN-QUEUE THRU GET-OPEN-QUEUE-EXIT
                     IF FILE-STAT = "00"
                       PERFORM CALC-PR-DATE THRU CALC-PR-DATE-EXIT
                       MOVE WS-DATE TO PMQ-DATE
                       IF PM-FIX-FLAG = "Y"
                           MOVE "FX" TO PMQ-REC-TYP
                       ELSE
                           MOVE "DN" TO PMQ-REC-TYP
                       END-IF
                       IF WO-STATUS-P = "00" OR "HS"
                         MOVE "PR" TO PMQ-REC-PR
                       END-IF
                       MOVE PM-CRITICAL TO PMQ-CRITICAL
                       MOVE PM-CYCLE TO PMQ-CYCLE
                       MOVE PM-LOOK-AHEAD TO PMQ-LOOK-AHEAD
                       MOVE PM-PRE-REL TO PMQ-PRE-REL
                       MOVE WS-PR-ID TO PMQ-PR-ID
                       PERFORM UPDATE-OPEN-QUEUE THRU
                               UPDATE-OPEN-QUEUE-EXIT
                       MOVE SPACES TO PRINT-REC
                       MOVE "  SCH PRERELEASE UPDATED IN QUEUE"
                          TO PRINT-REC
                       WRITE PRINT-REC AFTER ADVANCING 1 LINE
                     ELSE
                       MOVE "00" TO FILE-STAT
                       MOVE PM-WO-NUM TO PMQ-WO-NUM
                       MOVE PM-EQUIP-NUM TO PMQ-EQUIP-NUM
                       MOVE ZONE-PRIORITY-P TO PMQ-ZONE-PRI
                       MOVE DESCRIPTION-1-P TO PMQ-DESCRIPTION
                       PERFORM CALC-Q-FACTOR THRU CALC-Q-FACTOR-EXIT
                       PERFORM CALC-PR-DATE THRU CALC-PR-DATE-EXIT
                       MOVE WS-DATE TO PMQ-DATE
                       MOVE RIME-CALC       TO PM-QUEUE-FACTOR
                       IF PM-FIX-FLAG = "Y"
                         MOVE "FX" TO PMQ-REC-TYP
                       ELSE
                         MOVE "DN" TO PMQ-REC-TYPE
                       END-IF
                       IF WO-STATUS-P = "00" OR "HS"
                         MOVE "PR" TO PMQ-REC-PR
                       END-IF
                       MOVE PM-CRITICAL TO PMQ-CRITICAL
                       MOVE PM-CYCLE TO PMQ-CYCLE
                       MOVE PM-LOOK-AHEAD TO PMQ-LOOK-AHEAD
                       MOVE PM-PRE-REL TO PMQ-PRE-REL
                       MOVE WS-PR-ID TO PMQ-PR-ID
                       PERFORM WRITE-OPEN-QUEUE THRU
                               WRITE-OPEN-QUEUE-EXIT
                       MOVE SPACES TO PRINT-REC
                       MOVE "  PREREL WO WRITTEN TO THE QUEUE"
                         TO PRINT-REC
                       WRITE PRINT-REC AFTER ADVANCING 1 LINE
                     END-IF
                 MOVE WS-PR-ID TO SCH-PR-ID
                 MOVE PMQ-DATE TO SCH-PREREL-DATE
             ELSE
      *--------WORK ORDER HAS NOT BEEN PRE RELEASED, WRITE PR SCHEDULE
                 MOVE PM-NEXT-REL TO WS-YYMMDD
                 MOVE 19 TO WS-CT
                 MOVE WS-DATE TO SCH-RELEASE-DATE
                 MOVE WS-YYYY TO SCH-REL-YRMO-YR
                 MOVE WS-MM TO SCH-REL-YRMO-MO
                 IF PM-FIX-FLAG = "Y"
                     MOVE "FX" TO SCH-REC-TYP
                 ELSE
                     MOVE "DN" TO SCH-REC-TYP
                 END-IF
                 MOVE "PR" TO SCH-REC-PR
                 MOVE PM-EQUIP-NUM TO SCH-EQUIP-NUM
                 MOVE PM-WO-NUM TO SCH-WO-NUM
                 MOVE ZONE-PRIORITY-P TO SCH-ZONE-PRI
                 MOVE PM-SCHED-DT TO WS-YYMMDD
                 MOVE 19 TO WS-CT
                 MOVE WS-DATE TO SCH-PREREL-DATE
                 MOVE PM-LEVEL TO SCH-LEVEL
                 MOVE PM-CRITICAL TO SCH-CRITICAL
                 MOVE PM-CYCLE TO SCH-CYCLE
                 MOVE PM-LOOK-AHEAD TO SCH-LOOK-AHEAD
                 MOVE PM-PRE-REL TO SCH-PRE-REL
                 MOVE PM-PRIORITY TO SCH-PRIORITY
                 MOVE WS-PR-ID TO SCH-PR-ID
                 MOVE SPACES TO PRINT-REC
                 MOVE "  PRERELEASE SCHEDULED FOR " TO PRT-PREREL-TXT
                 MOVE SCH-RELEASE-DATE TO PRT-PREREL-DATE
                 MOVE ", LEVEL " TO PRT-PREREL-TXT2
                 MOVE SCH-LEVEL TO PRT-PREREL-LVL
                 WRITE PRINT-REC AFTER ADVANCING 1 LINE
                 MOVE SCH-RELEASE-DATE TO SCH-PREREL-DATE
                 PERFORM WRITE-SCHEDULE THRU WRITE-SCHEDULE-EXIT
             END-IF
           END-IF.
      *-----WRITE SCHEDULE RECORD.
           MOVE PM-SCHED-DT TO WS-YYMMDD.
           MOVE 19 TO WS-CT.
           MOVE WS-DATE TO SCH-RELEASE-DATE.
           MOVE WS-YYYY TO SCH-REL-YRMO-YR.
           MOVE WS-MM TO SCH-REL-YRMO-MO.
           IF PM-FIX-FLAG = "Y"
               MOVE "FX" TO SCH-REC-TYP
           ELSE
               MOVE "DN" TO SCH-REC-TYP
           END-IF.
           MOVE SPACES TO SCH-REC-PR.
           MOVE PM-EQUIP-NUM TO SCH-EQUIP-NUM.
           MOVE PM-WO-NUM TO SCH-WO-NUM.
           MOVE ZONE-PRIORITY-P TO SCH-ZONE-PRI.
           MOVE PM-LEVEL TO SCH-LEVEL.
           MOVE PM-CYCLE TO SCH-CYCLE.
           MOVE PM-LOOK-AHEAD TO SCH-LOOK-AHEAD.
           MOVE PM-PRE-REL TO SCH-PRE-REL.
           MOVE PM-CRITICAL TO SCH-CRITICAL.
           MOVE PM-PRIORITY TO SCH-PRIORITY.
           MOVE SPACES TO PRINT-REC.
           MOVE "  SCHEDULED FOR " TO PRT-REL-TXT.
           MOVE SCH-RELEASE-DATE TO PRT-REL-DATE.
           MOVE ", LEVEL " TO PRT-REL-TXT2.
           MOVE SCH-LEVEL TO PRT-REL-LVL.
           WRITE PRINT-REC AFTER ADVANCING 1 LINES.
           PERFORM WRITE-SCHEDULE THRU WRITE-SCHEDULE-EXIT.
       WRITE-LEVEL-EXIT.
           EXIT.

       FIXED-DATE-CONVERT.
           MOVE SPACES TO PRINT-REC.
           MOVE "***********************************************"
             TO PRINT-REC.
           WRITE PRINT-REC AFTER ADVANCING 3 LINES.
           MOVE "PM FIXED DATE CONVERSION TO NEW SCHEDULE FORMAT"
             TO PRINT-REC.
           WRITE PRINT-REC AFTER ADVANCING 1 LINE.
           MOVE "***********************************************"
             TO PRINT-REC.
           WRITE PRINT-REC AFTER ADVANCING 1 LINE.

           PERFORM CALC-STOP-DATE THRU CALC-STOP-DATE-EXIT.

       TRANS-FILE-LOOP.
           READ PM-TRANS-FILE NEXT INTO PM-TRANS-DATA
               AT END MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT = "10" OR "14" OR "46"
               MOVE SPACES TO PRINT-REC
               MOVE "** END OF CONVERTING FIXED-DATE SCHEDULES **"
                 TO PRINT-REC
               WRITE PRINT-REC AFTER ADVANCING 2 LINES
               GO TO FIXED-DATE-CONVERT-EXIT
           ELSE
           IF FILE-STAT NOT = "00"
               MOVE "READ PM-TRANS-FILE ERROR" TO BU-DISPLAY-MSG
               MOVE ARG-NO TO BU-DISPLAY-FLD (2)
               PERFORM 999-BLOWUP.

           MOVE TR-EQUIP-NUM TO EQUIP-KEY.
           MOVE TR-WO-NUM TO WO-KEY.
           MOVE ZEROS TO WO-KEY-SUFF.
           MOVE TR-LEVEL TO LEVEL-KEY.
           IF TR-FILLER = "**" OR "WW" OR "MM" OR "QQ" OR "SS" OR "AA"
               PERFORM CHECK-CONVERT THRU CHECK-CONVERT-EXIT
               IF FILE-STAT = "00"
                   MOVE SPACES TO PRINT-REC
                   MOVE "CONVERT SCHEDULE FOR " TO PRT-FIX-TXT1
                   MOVE TR-EQUIP-NUM TO PRT-FIX-EQP
                   MOVE " - " TO PRT-FIX-TXT2
                   MOVE WO-KEY TO PRT-FIX-WO
                   WRITE PRINT-REC AFTER ADVANCING 2 LINES
                   MOVE SPACES TO PRINT-REC
                   MOVE "  ALREADY CONVERTED" TO PRINT-REC
                   WRITE PRINT-REC AFTER ADVANCING 1 LINE
                   GO TO TRANS-FILE-LOOP.
           IF TR-FILLER = "**" OR "WW" OR "MM" OR "QQ" OR "SS" OR "AA"
             MOVE SPACES TO PRINT-REC
             MOVE "CONVERT SCHEDULE FOR " TO PRT-FIX-TXT1
             MOVE TR-EQUIP-NUM TO PRT-FIX-EQP
             MOVE " - " TO PRT-FIX-TXT2
             MOVE WO-KEY TO PRT-FIX-WO
             WRITE PRINT-REC AFTER ADVANCING 2 LINES
             PERFORM FIXED-DATE-SCHED THRU FIXED-DATE-SCHED-EXIT.
           GO TO TRANS-FILE-LOOP.
       FIXED-DATE-CONVERT-EXIT.
           EXIT.

       FIXED-DATE-SCHED.
           MOVE TR-SCHED-DT TO CD-YYMMDD.
           IF CD-YY > 90
               MOVE 19 TO CD-CT
           ELSE
               MOVE 20 TO CD-CT.
           IF TR-FILLER = "**"
               MOVE SPACES TO PRINT-REC
               MOVE "  FIXED DATE SCHEDULE, ONE TIME" TO PRINT-REC
               WRITE PRINT-REC AFTER ADVANCING 1 LINE
               PERFORM WRITE-CALENDAR THRU WRITE-CALENDAR-EXIT
           ELSE
           IF TR-FILLER = "WW"
               MOVE SPACES TO PRINT-REC
               MOVE "  FIXED DATE SCHEDULE, WEEKLY" TO PRINT-REC
               WRITE PRINT-REC AFTER ADVANCING 1 LINE
               MOVE CURR-DATE TO WS-DATE
               CALL "JULIANDATE" USING WS-YYMMDD JUL-DATE
               PERFORM WRITE-CALENDAR THRU WRITE-CALENDAR-EXIT
                 VARYING JUL-P FROM JUL-P BY 7
                 UNTIL CURR-DATE > STOP-DATE
           ELSE
           IF TR-FILLER = "MM"
               MOVE SPACES TO PRINT-REC
               MOVE "  FIXED DATE SCHEDULE, MONTHLY" TO PRINT-REC
               WRITE PRINT-REC AFTER ADVANCING 1 LINE
               PERFORM WRITE-CALENDAR THRU WRITE-CALENDAR-EXIT
                 VARYING CD-MM FROM CD-MM BY 1
                 UNTIL CURR-DATE > STOP-DATE
           ELSE
           IF TR-FILLER = "QQ"
               MOVE SPACES TO PRINT-REC
               MOVE "  FIXED DATE SCHEDULE, QUARTERLY" TO PRINT-REC
               WRITE PRINT-REC AFTER ADVANCING 1 LINE
               PERFORM WRITE-CALENDAR THRU WRITE-CALENDAR-EXIT
                 VARYING CD-MM FROM CD-MM BY 3
                 UNTIL CURR-DATE > STOP-DATE
           ELSE
           IF TR-FILLER = "SS"
               MOVE SPACES TO PRINT-REC
               MOVE "  FIXED DATE SCHEDULE, SEMI-ANNUAL" TO PRINT-REC
               WRITE PRINT-REC AFTER ADVANCING 1 LINE
               PERFORM WRITE-CALENDAR THRU WRITE-CALENDAR-EXIT
                 VARYING CD-MM FROM CD-MM BY 6
                 UNTIL CURR-DATE > STOP-DATE
           ELSE
           IF TR-FILLER = "AA"
               MOVE SPACES TO PRINT-REC
               MOVE "  FIXED DATE SCHEDULE, ANNUAL" TO PRINT-REC
               WRITE PRINT-REC AFTER ADVANCING 1 LINE
               PERFORM WRITE-CALENDAR THRU WRITE-CALENDAR-EXIT
                 VARYING CD-YYYY FROM CD-YYYY BY 1
                 UNTIL CURR-DATE > STOP-DATE.
       FIXED-DATE-SCHED-EXIT.
           EXIT.

       WRITE-CALENDAR.
           MOVE SPACES TO PM-SCHED-DATA.
           IF TR-FILLER = "WW"
               PERFORM ADJUST-JULIAN-DOWN UNTIL JUL-P < 366
               CALL "GREGDATE" USING JUL-DATE WS-YYMMDD
               MOVE WS-DATE TO CURR-DATE
           ELSE
           IF TR-FILLER = "MM" OR "QQ" OR "SS"
               IF CD-MM > 12
                   MOVE 1 TO CD-MM
                   ADD 1 TO CD-YYYY.
           IF CURR-DATE > STOP-DATE AND TR-FILLER NOT = "**"
               GO TO WRITE-CALENDAR-EXIT.
           MOVE CURR-DATE TO SCH-RELEASE-DATE.
           MOVE CD-YYYY TO SCH-REL-YRMO-YR.
           MOVE CD-MM TO SCH-REL-YRMO-MO.
           MOVE "CL  " TO SCH-REC-TYPE.
           MOVE TR-EQUIP-NUM TO SCH-EQUIP-NUM.
           MOVE TR-WO-NUM TO SCH-WO-NUM.
           MOVE ZEROS TO SCH-WO-SUFF.
           MOVE SCH-WO-NUM TO WO-KEY.
           PERFORM GET-WO-PLANNED THRU GET-WO-PLANNED-EXIT.
           MOVE ZONE-PRIORITY-P TO SCH-ZONE-PRI.
           IF TR-LEVEL NUMERIC
               MOVE TR-LEVEL TO SCH-LEVEL
           ELSE
               MOVE 1 TO SCH-LEVEL.
           IF TR-CRITICAL NUMERIC
               MOVE TR-CRITICAL TO SCH-CRITICAL
           ELSE
               MOVE ZEROS TO SCH-CRITICAL.
           IF TR-CYCLE NUMERIC
               MOVE TR-CYCLE TO SCH-CYCLE
           ELSE
               MOVE ZEROS TO SCH-CYCLE.
           IF TR-LOOK-AHEAD NUMERIC
               MOVE TR-LOOK-AHEAD TO SCH-LOOK-AHEAD
           ELSE
               MOVE ZEROS TO SCH-LOOK-AHEAD.
           IF TR-PRE-REL NUMERIC
               MOVE TR-PRE-REL TO SCH-PRE-REL
           ELSE
               MOVE ZEROS TO SCH-PRE-REL.
           IF TR-PRIORITY NUMERIC
               MOVE TR-PRIORITY TO SCH-PRIORITY
           ELSE
               MOVE ZEROS TO SCH-PRIORITY.
           PERFORM WRITE-SCHEDULE THRU WRITE-SCHEDULE-EXIT.
           MOVE SPACES TO PRINT-REC.
           MOVE "  SCHEDULED FOR " TO PRT-REL-TXT.
           MOVE SCH-RELEASE-DATE TO PRT-REL-DATE.
           MOVE ", LEVEL " TO PRT-REL-TXT2.
           MOVE SCH-LEVEL TO PRT-REL-LVL.
           WRITE PRINT-REC AFTER ADVANCING 1 LINE.
           IF TR-FILLER = "WW"
               MOVE CURR-DATE TO WS-DATE
               CALL "JULIANDATE" USING WS-YYMMDD JUL-DATE
           END-IF.
       WRITE-CALENDAR-EXIT.
           EXIT.

       WRITE-SCHEDULE.
           WRITE PM-SCHED-REC FROM PM-SCHED-DATA
               INVALID KEY MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
               MOVE "WRITE PM-SCHEDULE ERROR " TO BU-DISPLAY-MSG
               MOVE SCH-EQUIP-NUM TO BU-DISPLAY-FLD (2)
               MOVE SCH-LEVEL TO BU-DISPLAY-FLD (3)
               MOVE SCH-RELEASE-DATE TO BU-DISPLAY-FLD (4)
               PERFORM 999-BLOWUP.
       WRITE-SCHEDULE-EXIT.
           EXIT.

       CHECK-CONVERT.
           MOVE EQUIP-KEY TO PMEQPNUM OF PM-SCHEDULE.
           START PM-SCHEDULE KEY = PMEQPNUM OF PM-SCHEDULE
               INVALID KEY MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
               GO TO CHECK-CONVERT-EXIT.
       CHECK-CONVERT-LOOP.
           READ PM-SCHEDULE NEXT INTO PM-SCHED-DATA
               AT END MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT = "10" OR "14" OR "46"
               GO TO CHECK-CONVERT-EXIT
           ELSE
           IF FILE-STAT NOT = "00"
               MOVE "READ PM-SCHEDULE ERROR" TO BU-DISPLAY-MSG
               MOVE ITEM-EQUIP TO BU-DISPLAY-FLD (2)
               MOVE EQUIP-KEY TO BU-DISPLAY-FLD (3)
               PERFORM 999-BLOWUP.
           IF SCH-EQUIP-NUM NOT = EQUIP-KEY
               MOVE "10" TO FILE-STAT
               GO TO CHECK-CONVERT-EXIT.
           IF SCH-WO = WO-KEY-NUM
               GO TO CHECK-CONVERT-EXIT.
           GO TO CHECK-CONVERT-LOOP.
       CHECK-CONVERT-EXIT.
           EXIT.

       GET-WO-PLANNED.
           MOVE WO-KEY TO WONUM OF WO-PLANNED.
           READ WO-PLANNED INTO WO-PLANNED-DATA
               INVALID KEY MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
               MOVE "READ WO-PLANNED ERROR" TO BU-DISPLAY-MSG
               MOVE WO-KEY TO BU-DISPLAY-FLD (2)
               PERFORM 999-BLOWUP.
       GET-WO-PLANNED-EXIT.
           EXIT.

       UPDATE-WO-PLANNED.
           REWRITE WO-PLANNED-REC FROM WO-PLANNED-DATA
               INVALID KEY MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
               MOVE "REWRITE WO-PLANNED ERROR" TO BU-DISPLAY-MSG
               MOVE WO-NUM-PLANNED TO BU-DISPLAY-FLD (2)
               PERFORM 999-BLOWUP.
       UPDATE-WO-PLANNED-EXIT.
           EXIT.

       GET-OPEN-QUEUE.
           MOVE EQUIP-KEY TO EQPNUM OF PM-QUEUE.
           START PM-QUEUE KEY = EQPNUM OF PM-QUEUE
             INVALID KEY MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
               GO TO GET-OPEN-QUEUE-EXIT.
       GET-OPEN-QUEUE-LOOP.
           READ PM-QUEUE NEXT INTO PMOQ-DATA
               AT END MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT = "10" OR "14" OR "46"
               GO TO GET-OPEN-QUEUE-EXIT
           ELSE
           IF FILE-STAT NOT = "00"
               MOVE "READ PM-QUEUE ERROR" TO BU-DISPLAY-MSG
               MOVE EQUIP-KEY TO BU-DISPLAY-FLD (2)
               PERFORM 999-BLOWUP.
           IF PMQ-EQUIP-NUM NOT = EQUIP-KEY
               MOVE "10" TO FILE-STAT
               GO TO GET-OPEN-QUEUE-EXIT.
           MOVE PMQ-DESCRIPTION TO WS-DESCRIPTION.
           IF WS-DESC-MAN = "MANUAL"
               GO TO GET-OPEN-QUEUE-LOOP.
           IF WS-DESC-LVL1 = SPACES
               MOVE "0" TO WS-DESC-LVL1.
           IF WS-DESC-LVL = PM-LEVEL AND PMQ-WO-NUM = PM-WO-NUM
               GO TO GET-OPEN-QUEUE-EXIT.
           GO TO GET-OPEN-QUEUE-LOOP.
       GET-OPEN-QUEUE-EXIT.
           EXIT.

       UPDATE-OPEN-QUEUE.
           REWRITE PMQ-REC FROM PMOQ-DATA
               INVALID KEY MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
               MOVE "REWRITE PM-QUEUE ERROR" TO BU-DISPLAY-MSG
               MOVE PMQ-EQUIP-NUM TO BU-DISPLAY-FLD (2)
               MOVE PMQ-WO-NUM TO BU-DISPLAY-FLD (3)
               PERFORM 999-BLOWUP.
       UPDATE-OPEN-QUEUE-EXIT.
           EXIT.

       WRITE-OPEN-QUEUE.
           WRITE PMQ-REC FROM PMOQ-DATA
               INVALID KEY MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
               MOVE "WRITE PM-QUEUE ERROR" TO BU-DISPLAY-MSG
               MOVE PMQ-EQUIP-NUM TO BU-DISPLAY-FLD (2)
               MOVE PMQ-WO-NUM TO BU-DISPLAY-FLD (3)
               PERFORM 999-BLOWUP.
       WRITE-OPEN-QUEUE-EXIT.
           EXIT.

       ADJUST-JULIAN-DOWN.
           SUBTRACT 365 FROM JUL-P.
           ADD 1 TO JUL-Y.
           IF JUL-Y = ZEROS
               ADD 1 TO WS-CT.

       ADJUST-JULIAN-UP.
           ADD 365 TO JUL-P.
           IF JUL-Y = 0
               MOVE 99 TO JUL-Y
               SUBTRACT 1 FROM WS-CT
           ELSE
               SUBTRACT 1 FROM JUL-Y.

       CALC-STOP-DATE.
           MOVE TODAYS-DATE TO WS-DATE.
           CALL "JULIANDATE" USING WS-YYMMDD JUL-DATE.
           ADD MAX-DAYS TO JUL-P.
           PERFORM ADJUST-JULIAN-DOWN UNTIL JUL-P < 366.
           CALL "GREGDATE" USING JUL-DATE WS-YYMMDD.
           MOVE WS-DATE TO STOP-DATE.
       CALC-STOP-DATE-EXIT.
           EXIT.

       CALC-PR-DATE.
           MOVE PM-SCHED-DT TO WS-YYMMDD.
           MOVE 19 TO WS-CT.
           CALL "JULIANDATE" USING WS-YYMMDD JUL-DATE.
           SUBTRACT PM-PRE-REL FROM JUL-P.
           PERFORM ADJUST-JULIAN-UP UNTIL JUL-P > 0.
           CALL "GREGDATE" USING JUL-DATE WS-YYMMDD.
       CALC-PR-DATE-EXIT.
           EXIT.

       CALC-Q-FACTOR.
           MOVE RIME-P TO RIME-X.
           MOVE 0 TO RIME-0.
           IF RIME-X NOT NUMERIC
               MOVE 5 TO RIME-CALC
           ELSE
           IF RIME-CALC > 0 AND < 10
               NEXT SENTENCE
           ELSE
               MOVE 5 TO RIME-CALC.
           IF PM-PRIORITY = 1 COMPUTE RIME-CALC = RIME-CALC * 5.
           IF PM-PRIORITY = 2 COMPUTE RIME-CALC = RIME-CALC * 4.
           IF PM-PRIORITY = 3 COMPUTE RIME-CALC = RIME-CALC * 3.
           IF PM-PRIORITY = 4 COMPUTE RIME-CALC = RIME-CALC * 2.
           IF PM-PRIORITY = 5 COMPUTE RIME-CALC = RIME-CALC * 1.
       CALC-Q-FACTOR-EXIT.
           EXIT.

       CALC-PR-ID.
           MOVE TODAYS-DATE TO WS-DATE.
           CALL "JULIANDATE" USING WS-YYMMDD JUL-DATE.
           MOVE JUL-P TO WS-PR-DAY.
           ACCEPT WS-PR-TIME FROM TIME.
           IF WS-PR-TIME-9 NOT > WS-LAST-PR-TIME
               ADD 1 TO WS-LAST-PR-TIME GIVING WS-PR-TIME-9.
           MOVE WS-PR-TIME-9 TO WS-LAST-PR-TIME.
       CALC-PR-ID-EXIT.
           EXIT.

       QUEUE-CONVERT.
           MOVE SPACES TO PRINT-REC.
           MOVE "**************************************" TO PRINT-REC.
           WRITE PRINT-REC AFTER ADVANCING 3 LINES.
           MOVE "PM OPEN QUEUE CONVERSION TO NEW FORMAT" TO PRINT-REC.
           WRITE PRINT-REC AFTER ADVANCING 1 LINE.
           MOVE "**************************************" TO PRINT-REC.
           WRITE PRINT-REC AFTER ADVANCING 1 LINE.

       QUEUE-CONVERT-LOOP.
           READ PM-OPEN-QUEUE NEXT INTO PMOQ-DATA
               AT END MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT = "10" OR "14" OR "46"
               MOVE SPACES TO PRINT-REC
               MOVE "** END OF CONVERTING PM OPEN QUEUE **"
                 TO PRINT-REC
               WRITE PRINT-REC AFTER ADVANCING 2 LINES
               GO TO QUEUE-CONVERT-EXIT
           ELSE
           IF FILE-STAT NOT = "00"
               MOVE "READ PM-QUEUE ERROR" TO BU-DISPLAY-MSG
               MOVE ARG-NO TO BU-DISPLAY-FLD (2)
               PERFORM 999-BLOWUP.

           IF PMQ-DATE = SPACES
               GO TO QUEUE-CONVERT-LOOP.

           IF PMQ-DD NUMERIC
                GO TO QUEUE-CONVERT-LOOP.

           MOVE SPACES TO PRINT-REC.
           MOVE "CONVERT QUEUE FOR " TO PRT-Q-TXT1.
           MOVE PMQ-WO-NUM TO PRT-Q-WO.
           MOVE ", " TO PRT-Q-TXT2.
           MOVE PMQ-EQUIP-NUM TO PRT-Q-EQP.
           MOVE " - " TO PRT-Q-TXT3.
           MOVE PMQ-DESCRIPTION TO PRT-Q-DESC.
           WRITE PRINT-REC AFTER ADVANCING 2 LINES.

           MOVE PMQ-DATE TO WS-YYMMDD.
           MOVE 19 TO WS-CT.
           MOVE WS-DATE TO PMQ-DATE.

           MOVE PMQ-DESCRIPTION TO WS-DESCRIPTION.
           IF WS-DESC-MAN NOT = "MANUAL"
             IF WS-DESC-LVL1 = SPACES
                 MOVE "0" TO WS-DESC-LVL1
             END-IF
             MOVE PMQ-WO-NUM TO WO-KEY
             MOVE ZEROS TO WO-KEY-SUFF
             PERFORM GET-WO-PLANNED THRU GET-WO-PLANNED-EXIT
             IF PM-SCHEDULE-KEY NOT = SPACES
               MOVE PM-SCHEDULE-KEY TO SCHED-KEY
               MOVE WS-DESC-LVL TO LEVEL-KEY
               PERFORM GET-MSCHED-LVL THRU GET-MSCHED-LVL-EXIT
               IF FILE-STAT = "00"
                 MOVE PMS-REC-TYP TO PMQ-REC-TYP
                 MOVE PMS-CRITICAL TO PMQ-CRITICAL
                 MOVE PMS-CYCLE TO PMQ-CYCLE
                 MOVE PMS-LOOK-AHEAD TO PMQ-LOOK-AHEAD
                 MOVE PMS-PRE-REL TO PMQ-PRE-REL
               ELSE
                 MOVE SPACES TO PRINT-REC
                 MOVE "NOT CONVERTED, ERROR RETRIEVING MASTER SCHEDULE"
                   TO PRINT-REC
                 WRITE PRINT-REC AFTER ADVANCING 1 LINE
               GO TO QUEUE-CONVERT-LOOP
               END-IF
             ELSE
               MOVE SPACES TO PRINT-REC
               MOVE "NOT CONVERTED, NOT LINKED TO ANY MASTER SCHEDULE"
                 TO PRINT-REC
               WRITE PRINT-REC AFTER ADVANCING 1 LINE
               GO TO QUEUE-CONVERT-LOOP
             END-IF
           ELSE
             MOVE "MR" TO PMQ-REC-TYP
           END-IF.
           REWRITE PMOQ-REC FROM PMOQ-DATA.
           IF FILE-STAT NOT = "00"
               MOVE "REWRITE PM-OPEN-QUEUE ERROR" TO BU-DISPLAY-MSG
               MOVE PMQ-EQUIP-NUM TO BU-DISPLAY-FLD (2)
               MOVE PMQ-WO-NUM TO BU-DISPLAY-FLD (3)
               PERFORM 999-BLOWUP.
           MOVE SPACES TO PRINT-REC.
           MOVE "  QUEUE RECORD HAS BEEN CONVERTED" TO PRINT-REC.
           WRITE PRINT-REC AFTER ADVANCING 1 LINE.
           GO TO QUEUE-CONVERT-LOOP.
       QUEUE-CONVERT-EXIT.
           EXIT.

       GET-MSCHED-LVL.
           MOVE SCHED-KEY TO PMSCHEDKEY OF PM-MASTER-SCHED.
           START PM-MASTER-SCHED KEY = PMSCHEDKEY OF PM-MASTER-SCHED
               INVALID KEY MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
               GO TO GET-MSCHED-LVL-EXIT.
       GET-MSCHED-LOOP.
           READ PM-MASTER-SCHED NEXT INTO PM-MSCHED-DATA
               AT END MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT = "10" OR "14" OR "46"
               GO TO GET-MSCHED-LVL-EXIT
           ELSE
           IF FILE-STAT NOT = "00"
               MOVE "READ PM-MASTER-SCHED ERROR" TO BU-DISPLAY-MSG
               MOVE SCHED-KEY TO BU-DISPLAY-FLD (2)
               PERFORM 999-BLOWUP.
           IF PMS-SCHED-KEY NOT = SCHED-KEY
               MOVE "10" TO FILE-STAT
               GO TO GET-MSCHED-LVL-EXIT.
           IF PMS-LEVEL NOT = LEVEL-KEY
               GO TO GET-MSCHED-LOOP.
       GET-MSCHED-LVL-EXIT.
           EXIT.

       999-BLOWUP.
           MOVE "TPMSCHG1" TO BU-PGM-NAME.
           CALL "TBLOWUP" USING BASE BU-PGM-NAME STATUS-AREA
                          VIEW-COMAREA FILE-STAT
                          BU-DISPLAY-MSG BU-DISPLAY-FLDS.

       END-OF-JOB.
           GOBACK.
