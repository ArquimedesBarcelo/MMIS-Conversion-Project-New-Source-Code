       EJECT
       WORKING-STORAGE SECTION.

       01  C1                               PIC 9(9).
       01  C2                               PIC 9(9).
       01  C3                               PIC 9(9).
       01  C4                               PIC 9(9).
       01  CDATE.
           05 YY                            PIC 99.
           05 MM                            PIC 99.
           05 DD                            PIC 99.

       01  CY-TODAY-DATE.
           05  TODAY-CENT                   PIC X(2)  VALUE SPACES.
           05  TODAY-DATE.
               10  TODAY-YEAR               PIC X(2)  VALUE SPACES.
               10  FILLER                   PIC X(4)  VALUE SPACES.

       01  CTIME.
           05 HH                            PIC 99.
           05 MN                            PIC 99.
           05 FILLER                        PIC X(4).
       01  DELETE-WONUM.
           05  DELETE-WONO                  PIC X(7).
           05  DELETE-SUFF                  PIC XXX.
       01  FILE-STATUS                      PIC XX.
       01  GOBACK-SW                        PIC X.
       01  GDATE.
           05 GYY                           PIC 99.
           05 GMM                           PIC 99.
           05 GDD                           PIC 99.
       01  JDATE.
           05 JYY                           PIC 99.
       01  JOBP-WONUM                       PIC X(10).
       01  MASTER-SW                        PIC X.
       01  STOP-READ                        PIC X.
       01  STOP-DEL                         PIC X.
       01  STOP-CHG                         PIC X.
       01  TEMP-WONUM.
           05 TEMP-NUMBER                   PIC X(7).
           05 TEMP-SUFFIX                   PIC X(3).
       01  TEMP-STATUS.
           05 TEMP-STATUS1                  PIC X.
           05 TEMP-STATUS2                  PIC X.

      *-----  FILE BUFFERS FOR BASIC AND PLANNED WORKORDER FILES

       01  BUF-DWOBASIC.                    COPY DWOBASIC IN COPYLIB.
       01  BUF-DWOPLAN.                     COPY DWOPLAN  IN COPYLIB.

       EJECT
       PROCEDURE DIVISION.

       OPEN-PAR.
           OPEN INPUT FILE1101.

           OPEN I-O FILE1
                    FILE10
                    FILE1102
                    FILE12
                    FILE13
                    FILE16
                    FILE18
                    FILE19
                    FILE23
                    FILE24
                    FILE26
                    FILE39
                    FILE44
                    FILE45
                    FILE46.

           MOVE 0 TO C1 C2 C3 C4.

           ACCEPT CDATE FROM DATE.

      *-----  FORMAT DATE WITH CENTURY

           MOVE CDATE TO TODAY-DATE.
           IF TODAY-YEAR > "70"
              MOVE "19"  TO TODAY-CENT
           ELSE
              MOVE "20"  TO TODAY-CENT.

           ACCEPT CTIME FROM TIME.

           PERFORM MAIN-PAR THRU MAIN-PAR-EXIT.

           PERFORM END-PAR.

       END-PAR.
           CLOSE    FILE1
                    FILE10
                    FILE1101
                    FILE1102
                    FILE12
                    FILE13
                    FILE16
                    FILE18
                    FILE19
                    FILE23
                    FILE24
                    FILE26
                    FILE39
                    FILE44
                    FILE45
                    FILE46.

           DISPLAY "NOTE: VERBAL WORK ORDERS DELETED " C1.
           DISPLAY "NOTE: PLNNED WORK ORDERS DELETED " C2.

           DISPLAY "NOTE: VERBAL WORK ORDERS READ    " C3.
           DISPLAY "NOTE: PLNNED WORK ORDERS READ    " C4.

           GOBACK.

       EJECT
       MAIN-PAR.
           MOVE "FF" TO WOSTATUS OF REC10.
           START FILE10
            KEY IS = WOSTATUS OF REC10.
           IF FILE-STATUS = "00"
             MOVE "N" TO STOP-DEL
             PERFORM DELETE-VERBAL THRU DELETE-VERBAL-EXIT
              UNTIL STOP-DEL = "Y".

           MOVE "FF" TO WOSTATUS OF REC1102.
           START FILE1102
            KEY IS = WOSTATUS OF REC1102.
           IF FILE-STATUS = "00"
             MOVE "N" TO STOP-DEL
             PERFORM DELETE-PLNNED THRU DELETE-PLNNED-EXIT
              UNTIL STOP-DEL = "Y".

           MOVE "VO" TO WOSTATUS OF REC10.
           START FILE10
            KEY IS = WOSTATUS OF REC10.
           IF FILE-STATUS = "00"
             MOVE "N" TO STOP-CHG
             PERFORM CHANGE-VERBAL-VO THRU CHANGE-VERBAL-VO-EXIT
              UNTIL STOP-CHG = "Y".

           MOVE "VO" TO WOSTATUS OF REC1102.
           START FILE1102
            KEY IS = WOSTATUS OF REC1102.
           IF FILE-STATUS = "00"
             MOVE "N" TO STOP-CHG
             PERFORM CHANGE-PLNNED-VO THRU CHANGE-PLNNED-VO-EXIT
              UNTIL STOP-CHG = "Y".

       MAIN-PAR-EXIT.
           EXIT.

       EJECT
       DELETE-VERBAL.
           READ FILE10 NEXT RECORD.
           IF FILE-STATUS NOT = "00"
             MOVE "Y" TO STOP-DEL
             GO TO DELETE-VERBAL-EXIT.

           IF WOSTATUS OF REC10 NOT = "FF"
             REWRITE REC10
             MOVE "Y" TO STOP-DEL
             GO TO DELETE-VERBAL-EXIT.

           ADD 1 TO C3.

           IF BASDELDATE NOT NUMERIC
             MOVE "00000000" TO BASDELDATE.

           MOVE WONUM OF REC10 TO DELETE-WONUM.

           IF CY-TODAY-DATE > BASDELDATE
             PERFORM DELETE-FILE1
             PERFORM DELETE-FILE12
             PERFORM DELETE-FILE13
             PERFORM DELETE-FILE24
             PERFORM DELETE-FILE26

             DELETE FILE10 RECORD
             IF FILE-STATUS NOT = "00"
               DISPLAY "ERROR: FILE STATUS = "
                       FILE-STATUS
                       " ON DELETE OF FILE10"
               GO TO END-PAR
             ELSE
               ADD 1 TO C1

           ELSE
             IF BASPAD = "P   "
               NEXT SENTENCE
             ELSE
      **********************************************************
      *    STATEMENT BELOW *'D OUT 11/30/93 TO NOT DELETE      *
      *    MESSAGES ATTACHED TO WORK ORDERS FOR NAPANEE'S      *
      *    TRACKING OF INFORMATION                             *
      **********************************************************
      *        PERFORM DELETE-FILE24
               PERFORM DELETE-FILE26

               MOVE "P" TO BASPAD
               REWRITE REC10
               IF FILE-STATUS NOT = "00"
                 DISPLAY "ERROR: FILE STATUS = "
                         FILE-STATUS
                         " ON MODIFY OF FILE10"
                 GO TO END-PAR.

       DELETE-VERBAL-EXIT.
           EXIT.

       EJECT
       DELETE-PLNNED.
           READ FILE1102 NEXT RECORD.
           IF FILE-STATUS NOT = "00"
             MOVE "Y" TO STOP-DEL
             GO TO DELETE-PLNNED-EXIT.

           IF WOSTATUS OF REC1102 NOT = "FF"
             REWRITE REC1102
             MOVE "Y" TO STOP-DEL
             GO TO DELETE-PLNNED-EXIT.

           ADD 1 TO C4.

           IF SAVEHISTSW OF REC1102 > "  "
             GO TO DELETE-PLNNED-EXIT.

           IF PLDDELDATE OF REC1102 NOT NUMERIC
             MOVE "00000000" TO PLDDELDATE OF REC1102.

           PERFORM CHECK-MASTER THRU CHECK-MASTER-EXIT.
           IF MASTER-SW = "Y"
             GO TO DELETE-PLNNED-EXIT.

           MOVE WONUM OF REC1102 TO DELETE-WONUM.

           IF CY-TODAY-DATE > PLDDELDATE OF REC1102
             PERFORM DELETE-FILE1
             PERFORM DELETE-FILE12
             PERFORM DELETE-FILE13
             PERFORM DELETE-FILE18
             PERFORM DELETE-FILE23
             PERFORM DELETE-FILE24
             PERFORM DELETE-FILE26
             PERFORM DELETE-FILE39
             PERFORM DELETE-FILE44
             PERFORM DELETE-FILE45
             PERFORM DELETE-FILE46

             DELETE FILE1102 RECORD
             IF FILE-STATUS NOT = "00"
               DISPLAY "ERROR: FILE STATUS = "
                       FILE-STATUS
                       " ON DELETE OF FILE1102"
               GO TO END-PAR
             ELSE
               ADD 1 TO C2

           ELSE
             IF PLDPAD OF REC1102 = "P   "
               NEXT SENTENCE
             ELSE
               PERFORM DELETE-FILE18
               PERFORM DELETE-FILE23
      **********************************************************
      *    STATEMENT BELOW *'D OUT 11/30/93 TO NOT DELETE      *
      *    MESSAGES ATTACHED TO WORK ORDERS FOR NAPANEE'S      *
      *    TRACKING OF INFORMATION                             *
      **********************************************************
      *        PERFORM DELETE-FILE24
               PERFORM DELETE-FILE26

               MOVE "P" TO PLDPAD OF REC1102
               REWRITE REC1102
               IF FILE-STATUS NOT = "00"
                 DISPLAY "ERROR: FILE STATUS = "
                         FILE-STATUS
                         " ON MODIFY OF FILE1102"
                 GO TO END-PAR.

       DELETE-PLNNED-EXIT.
           EXIT.

       CHECK-MASTER.
           MOVE "N" TO MASTER-SW.
           MOVE WONUM OF REC1102 TO TEMP-WONUM.
           IF TEMP-SUFFIX NUMERIC
             IF TEMP-SUFFIX > "000"
               NEXT SENTENCE
             ELSE
               GO TO CHECK-MASTER-EXIT
           ELSE
             GO TO CHECK-MASTER-EXIT.

           MOVE WONUM OF REC1102 TO WONUM OF REC1101.
           READ FILE1101.
           IF FILE-STATUS NOT = "00"
             GO TO CHECK-MASTER-EXIT.

           IF WOSTATUS OF REC1101 NOT = "FF"
             MOVE "Y" TO MASTER-SW.

       CHECK-MASTER-EXIT.
           EXIT.

       EJECT
       CHANGE-VERBAL-VO.
           READ FILE10 NEXT INTO BUF-DWOBASIC
             AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
             MOVE "Y" TO STOP-CHG
             GO TO CHANGE-VERBAL-VO-EXIT.

           IF WO-STATUS NOT = "VO"
             REWRITE REC10 FROM BUF-DWOBASIC
             MOVE "Y" TO STOP-CHG
             GO TO CHANGE-VERBAL-VO-EXIT.

      *-----  SINCE THE KEY FIELD IS GETTING UPDATED (WOSTATUS), THE
      *-----  RECORD MUST BE DELETED AND RE-INSERTED

           DELETE FILE10.
           IF FILE-STATUS NOT = "00"
              DISPLAY "ERROR: FILE STATUS = "
                      FILE-STATUS
                      " ON DELETE OF FILE10, WO-NO = "
                      WO-NUM
              GO TO END-PAR.

           MOVE "DW" TO WO-STATUS.
           MOVE CY-TODAY-DATE TO DATE-COMP-CN.
           MOVE CTIME TO TIME-COMP.
           MOVE WO-STRT-STATUS TO TEMP-STATUS.
           MOVE "D" TO TEMP-STATUS2.
           MOVE TEMP-STATUS TO WO-STRT-STATUS.
           MOVE BUF-DWOBASIC TO REC10.

           WRITE REC10
             INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.

           IF FILE-STATUS NOT = "00"
             DISPLAY "ERROR: FILE STATUS = "
                     FILE-STATUS
                     " ON RE-INSERT OF FILE10, WONUM = "
                     WO-NUM
             GO TO END-PAR.

       CHANGE-VERBAL-VO-EXIT.
           EXIT.

       EJECT
       CHANGE-PLNNED-VO.
           READ FILE1102 NEXT INTO BUF-DWOPLAN
             AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
             MOVE "Y" TO STOP-CHG
             GO TO CHANGE-PLNNED-VO-EXIT.

           IF WO-STATUS-P NOT = "VO"
             REWRITE REC1102 FROM BUF-DWOPLAN
             MOVE "Y" TO STOP-CHG
             GO TO CHANGE-PLNNED-VO-EXIT.


      *-----  SINCE THE KEY FIELD IS GETTING UPDATED (WOSTATUS), THE
      *-----  RECORD MUST BE DELETED AND RE-INSERTED

           DELETE FILE1102.
           IF FILE-STATUS NOT = "00"
              DISPLAY "ERROR: FILE STATUS = "
                      FILE-STATUS
                      " ON DELETE OF FILE1102, WO-NUM = "
                      WO-NUM-PLANNED
              GO TO END-PAR.

           MOVE "DW" TO WO-STATUS-P.
           MOVE CY-TODAY-DATE TO DATE-COMP-P-CN.
           MOVE CTIME TO TIME-COMP-P.
           MOVE WO-START-STATUS TO TEMP-STATUS.
           MOVE "D" TO TEMP-STATUS2.
           MOVE TEMP-STATUS TO WO-START-STATUS.
           MOVE BUF-DWOPLAN TO REC1102.

           WRITE REC1102
             INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.

           IF FILE-STATUS NOT = "00"
             DISPLAY "ERROR: FILE STATUS = "
                     FILE-STATUS
                     " ON RE-INSERT OF FILE1102, WO-NUM = "
                     WO-NUM-PLANNED
             GO TO END-PAR.

       CHANGE-PLNNED-VO-EXIT.
           EXIT.

       EJECT
       DELETE-FILE1.
           MOVE DELETE-WONUM TO WONUM OF REC1.
           DELETE FILE1 RECORD.
           IF FILE-STATUS NOT = "00"
             IF FILE-STATUS NOT = "23"
               DISPLAY "ERROR: FILE STATUS = "
                       FILE-STATUS
                       " ON DELETE OF FILE1 " DELETE-WONUM
               GO TO END-PAR.

       EJECT
       DELETE-FILE12.
           MOVE DELETE-WONUM TO WONUM OF REC12.
           START FILE12
            KEY IS = WONUM OF REC12.
           IF FILE-STATUS = "00"
             MOVE "N" TO STOP-READ
             PERFORM DELETE-FILE12-C THRU DELETE-FILE12-C-E
               UNTIL STOP-READ = "Y".

       DELETE-FILE12-C.
           READ FILE12 NEXT RECORD.
           IF FILE-STATUS NOT = "00"
             MOVE "Y" TO STOP-READ
             GO TO DELETE-FILE12-C-E.

           IF WONUM OF REC12 NOT = DELETE-WONUM
             REWRITE REC12
             MOVE "Y" TO STOP-READ
             GO TO DELETE-FILE12-C-E.

           DELETE FILE12 RECORD.
           IF FILE-STATUS NOT = "00"
             DISPLAY "ERROR: FILE STATUS = "
                     FILE-STATUS
                     " ON DELETE OF FILE12"
             GO TO END-PAR.

       DELETE-FILE12-C-E.
           EXIT.

       EJECT
       DELETE-FILE13.
           MOVE DELETE-WONUM TO WONUM OF REC13.
           START FILE13
            KEY IS = WONUM OF REC13.
           IF FILE-STATUS = "00"
             MOVE "N" TO STOP-READ
             PERFORM DELETE-FILE13-C THRU DELETE-FILE13-C-E
              UNTIL STOP-READ = "Y".

       DELETE-FILE13-C.
           READ FILE13 NEXT RECORD.
           IF FILE-STATUS NOT = "00"
             MOVE "Y" TO STOP-READ
             GO TO DELETE-FILE13-C-E.

           IF WONUM OF REC13 NOT = DELETE-WONUM
             REWRITE REC13
             MOVE "Y" TO STOP-READ
             GO TO DELETE-FILE13-C-E.

           DELETE FILE13 RECORD.
           IF FILE-STATUS NOT = "00"
             DISPLAY "ERROR: FILE STATUS = "
                     FILE-STATUS
                     " ON DELETE OF FILE13"
             GO TO END-PAR.

       DELETE-FILE13-C-E.
           EXIT.

       EJECT
       DELETE-FILE18.
           MOVE DELETE-WONUM TO JOBPWOSEQ.
           START FILE18
            KEY IS NOT LESS THAN JOBPWOSEQ.
           IF FILE-STATUS = "00"
             MOVE "N" TO STOP-READ
             PERFORM DELETE-FILE18-C THRU DELETE-FILE18-C-E
              UNTIL STOP-READ = "Y".

       DELETE-FILE18-C.
           READ FILE18 NEXT RECORD.
           IF FILE-STATUS NOT = "00"
             MOVE "Y" TO STOP-READ
             GO TO DELETE-FILE18-C-E.

           MOVE JOBPWOSEQ TO JOBP-WONUM.
           IF JOBP-WONUM NOT = DELETE-WONUM
             REWRITE REC18
             MOVE "Y" TO STOP-READ
             GO TO DELETE-FILE18-C-E.

           DELETE FILE18 RECORD.
           IF FILE-STATUS NOT = "00"
             DISPLAY "ERROR: FILE STATUS = "
                     FILE-STATUS
                     " ON DELETE OF FILE18"
             GO TO END-PAR.

       DELETE-FILE18-C-E.
           EXIT.

       EJECT
       DELETE-FILE23.
           MOVE DELETE-WONUM TO WONUM OF REC23.
           START FILE23
            KEY IS = WONUM OF REC23.
           IF FILE-STATUS = "00"
             MOVE "N" TO STOP-READ
             PERFORM DELETE-FILE23-C THRU DELETE-FILE23-C-E
              UNTIL STOP-READ = "Y".

       DELETE-FILE23-C.
           READ FILE23 NEXT RECORD.
           IF FILE-STATUS NOT = "00"
             MOVE "Y" TO STOP-READ
             GO TO DELETE-FILE23-C-E.

           IF WONUM OF REC23 NOT = DELETE-WONUM
             REWRITE REC23
             MOVE "Y" TO STOP-READ
             GO TO DELETE-FILE23-C-E.

           DELETE FILE23 RECORD.
           IF FILE-STATUS NOT = "00"
             DISPLAY "ERROR: FILE STATUS = "
                     FILE-STATUS
                     " ON DELETE OF FILE23"
             GO TO END-PAR.

       DELETE-FILE23-C-E.
           EXIT.

       EJECT
       DELETE-FILE24.
           MOVE DELETE-WONUM TO TOWO OF REC24.
           START FILE24
            KEY IS = TOWO OF REC24.
           IF FILE-STATUS = "00"
             MOVE "N" TO STOP-READ
             PERFORM DELETE-FILE24-C THRU DELETE-FILE24-C-E
              UNTIL STOP-READ = "Y".

       DELETE-FILE24-C.
           READ FILE24 NEXT RECORD.
           IF FILE-STATUS NOT = "00"
             MOVE "Y" TO STOP-READ
             GO TO DELETE-FILE24-C-E.

           IF TOWO OF REC24 NOT = DELETE-WONUM
             REWRITE REC24
             MOVE "Y" TO STOP-READ
             GO TO DELETE-FILE24-C-E.

           DELETE FILE24 RECORD.
           IF FILE-STATUS NOT = "00"
             DISPLAY "ERROR: FILE STATUS = "
                     FILE-STATUS
                     " ON DELETE OF FILE24"
             GO TO END-PAR.

       DELETE-FILE24-C-E.
