       IDENTIFICATION DIVISION.
       PROGRAM-ID.             SPMSETUP.
      *REMARKS.            *** PM SYSTEM OPTIONS SETUP PROGRAM
       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.
       SOURCE-COMPUTER.        IBM-AS400.
       OBJECT-COMPUTER.        IBM-AS400.

       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT PM-MASTER-FILE
                  ASSIGN       TO DATABASE-MCFLMM4701
                  ORGANIZATION IS INDEXED
                  ACCESS MODE  IS DYNAMIC
                  RECORD KEY   IS EXTERNALLY-DESCRIBED-KEY
                               WITH DUPLICATES
                  FILE STATUS  IS FILE-STAT.

           SELECT PER-PERSONNEL
                  ASSIGN       TO DATABASE-MCFLMM0301
                  ORGANIZATION IS INDEXED
                  ACCESS MODE  IS DYNAMIC
                  RECORD KEY   IS EXTERNALLY-DESCRIBED-KEY
                  FILE STATUS  IS FILE-STAT.

           SELECT DISPLAY-FILE
                  ASSIGN       TO WORKSTATION-ZPMMAINT-SI
                  ORGANIZATION IS TRANSACTION
                  ACCESS MODE  IS SEQUENTIAL
                  FILE STATUS  IS SCREEN-STATUS
                               MAJOR-MINOR
                  CONTROL-AREA IS SCREEN-CONTROL.

       DATA DIVISION.
       FILE SECTION.
       FD  PM-MASTER-FILE
           LABEL RECORDS       ARE STANDARD
           DATA RECORD         IS PMREC.
       01  PMREC.
           COPY DDS-ALL-FORMATS OF MCFLMM4701.

       FD  PER-PERSONNEL
           LABEL RECORDS       ARE STANDARD
           DATA RECORD         IS PERREC.
       01  PERREC.
           COPY DDS-ALL-FORMATS OF MCFLMM0301.

       FD  DISPLAY-FILE
           LABEL RECORDS       ARE OMITTED.
       01  DISPLAY-REC         PIC X(2000).

       WORKING-STORAGE SECTION.
       77  ARG-NO              PIC 9(9)  VALUE 1.
       77  BASE                PIC X(24) VALUE SPACES.
       77  CHANGE-SW-1         PIC X     VALUE SPACE.
       77  SCREEN-SAVE-2       PIC X(183).
       77  INPUT-SW            PIC X     VALUE SPACE.
           88  NEW-RECORD                VALUE "X".
       77  TRUE-VAL            PIC 1     VALUE B"1".

       01  PASSWORD-INFORMATION.
           05  NAME-OF-PROGRAM PIC X(08) VALUE "SPMSETUP".
           05  PROGRAM-TYPE    PIC X(02) VALUE "MA".
           05  PROGRAM-RELEASE PIC X(12) VALUE " J0100010001".
           05  PROGRAM-DESCRIPTION.
               10  PROG-DESC1  PIC X(30) VALUE
                   "MANAGEMENT FUNCTIONS TO SET OP".
               10  PROG-DESC2  PIC X(30) VALUE
                   "ERATING OPTIONS FOR THE       ".
               10  PROG-DESC3  PIC X(30) VALUE
                   "PREVENTIVE MAINTENANCE SYSTEM.".
               10  PROG-DESC4  PIC X(30) VALUE SPACES.
               10  PROG-FUNC1  PIC X(30) VALUE
                   "SHOULD BE PASSWORD PROTECTED. ".
               10  PROG-FUNC2  PIC X(30) VALUE SPACES.
           05  PASSWORD-FLAG   PIC X.

       01  FILE-STAT.
           05 FILE-STAT-1      PIC X   VALUE "0".
           05 FILE-STAT-2      PIC X   VALUE "0".

       01  SCREEN-DATA-1.
           05  CC-DATA.
               10  CC-NAM1     PIC X(16).
               10  CC-NUM1     PIC X(04).
           05  MSG-SWITCHES.
               10  SW1         PIC X.
               10  YN1         PIC XXX.
               10  SW2         PIC X.
               10  YN2         PIC XXX.
               10  SW3         PIC X.
               10  YN3         PIC XXX.
               10  SW4         PIC X.
               10  YN4         PIC XXX.
               10  SW5         PIC X.
               10  YN5         PIC XXX.
               10  SW6         PIC X.
               10  YN6         PIC XXX.
           05  CMDMSG1         PIC X(79).
           05  ERRMSG1         PIC X(79).

       01  SCREEN-DATA-2.
           05  CC-DATA.
               10  CC-NAM2     PIC X(16).
               10  CC-NUM2     PIC X(04).
           05  INIT-LIMIT.
               10  I-400       PIC X.
               10  I-750       PIC X.
           05  RE-INIT-LIMIT.
               10  R-NOT       PIC X.
               10  R-HALF      PIC X.
               10  R-100       PIC X.
           05  CMDMSG2         PIC X(79).
           05  ERRMSG2         PIC X(79).

           COPY SCREENIO       IN COPYLIB.

           COPY CATREAD        IN COPYLIB.

           COPY TBLOWUP        IN COPYLIB.

           COPY DBSTAT         IN COPYLIB.

           COPY VCOMAREA       IN COPYLIB.

       01  MESSAGE-DATA.       COPY ERRORLIN IN COPYLIB.

       01  DBPARAMETERS.       COPY DBPARMS  IN COPYLIB.

       01  PER-PERS-DATA.      COPY MPERSONL IN COPYLIB.

       01  PM-MASTER-DATA.     COPY DPMMASTR IN COPYLIB.

       LINKAGE SECTION.
       01  CNUM-BUFFER.
           05  CNUM-BUF        PIC X(04).
           05  CNAM-BUF        PIC X(16).

       PROCEDURE DIVISION      USING CNUM-BUFFER.
       BEGIN-PROC.
           OPEN I-O            DISPLAY-FILE
                               PM-MASTER-FILE.
           OPEN INPUT          PER-PERSONNEL.

           CALL "TPWORD"       USING PASSWORD-INFORMATION.
           IF PASSWORD-FLAG = "N" GO TO END-OF-JOB.

           MOVE SPACES         TO INPUT-SW
                                  SCREEN-DATA-1 CHANGE-SW-1
                                  SCREEN-DATA-2 SCREEN-SAVE-2
                                  PM-MASTER-DATA.

           MOVE CNUM-BUF       TO CC-NUM1 CC-NUM2
                                  PERCCNUM OF PM-MASTER-FILE.
           MOVE CNAM-BUF       TO CC-NAM1 CC-NAM2.

           READ PM-MASTER-FILE INTO PM-MASTER-DATA
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT = "23"
               MOVE SPACES     TO MSG-FLAGS INIT-VALUE REINIT-VALUE
               MOVE "400 "     TO INIT-VALUE
               MOVE "000 "     TO REINIT-VALUE
               MOVE "X"        TO INPUT-SW
           ELSE
           IF FILE-STAT NOT = "00"
               MOVE "READ ERROR:  PM-MASTER-FILE" TO  BU-DISPLAY-MSG
               MOVE "MCFLMM4701" TO BU-DISPLAY-FLD (1)
               MOVE FILE-STAT    TO BU-DISPLAY-FLD (2)
               GO TO 999-BLOWUP.

       SCREEN-ONE.
           MOVE "NO "          TO YN1 YN2 YN3 YN4 YN5 YN6.
           IF MSGSW1 = "XX"
               MOVE "YES"      TO YN1.
           IF MSGSW2 = "XX"
               MOVE "YES"      TO YN2.
           IF MSGSW3 = "XX"
               MOVE "YES"      TO YN3.
           IF MSGSW4 = "XX"
               MOVE "YES"      TO YN4.
           IF MSGSW5 = "XX"
               MOVE "YES"      TO YN5.
           IF MSGSW6 = "XX"
               MOVE "YES"      TO YN6.

           MOVE "VPMCUST1"     TO SCREEN-NAME.
           MOVE "00"           TO SCREEN-STATUS.
           MOVE SCREEN-DATA-1  TO DISPLAY-REC.

           WRITE DISPLAY-REC   FORMAT IS SCREEN-NAME
               INDIC ARE SCREEN-INDICATORS.
           IF SCREEN-STATUS NOT = "00"
               DISPLAY "SCREEN WRITE ERROR.  SCREEN-STATUS IS "
                               SCREEN-STATUS
               GO TO END-OF-JOB.

           READ  DISPLAY-FILE  FORMAT IS SCREEN-NAME
               INDIC ARE SCREEN-INDICATORS
           IF SCREEN-STATUS NOT = "00"
               DISPLAY "SCREEN READ ERROR.  SCREEN-STATUS IS "
                               SCREEN-STATUS
               GO TO END-OF-JOB.

           MOVE ALL B"0"       TO SCREEN-INDICATORS.
           MOVE DISPLAY-REC    TO SCREEN-DATA-1.

           IF KEY-HIT = 3 OR 8 GO TO END-OF-JOB.

           IF KEY-HIT = 1 OR 2 OR 4 OR 5 OR 6
               GO TO SCREEN-ONE.

           IF SW1 NOT = SPACE
               MOVE "X"        TO CHANGE-SW-1
               IF MSGSW1 NOT = SPACES
                   MOVE SPACES TO MSGSW1 SW1
               ELSE
                   MOVE " "    TO SW1
                   MOVE "XX"   TO MSGSW1.

           IF SW2 NOT = SPACE
               MOVE "X"        TO CHANGE-SW-1
               IF MSGSW2 NOT = SPACES
                   MOVE SPACES TO MSGSW2 SW2
               ELSE
                   MOVE " "    TO SW2
                   MOVE "XX"   TO MSGSW2.

           IF SW3 NOT = SPACE
               MOVE "X"        TO CHANGE-SW-1
               IF MSGSW3 NOT = SPACES
                   MOVE SPACES TO MSGSW3 SW3
               ELSE
                   MOVE " "    TO SW3
                   MOVE "XX"   TO MSGSW3.

           IF SW4 NOT = SPACE
               MOVE "X"        TO CHANGE-SW-1
               IF MSGSW4 NOT = SPACES
                   MOVE SPACES TO MSGSW4 SW4
               ELSE
                   MOVE " "    TO SW4
                   MOVE "XX"   TO MSGSW4.

           IF SW5 NOT = SPACE
               MOVE "X"        TO CHANGE-SW-1
               IF MSGSW5 NOT = SPACES
                   MOVE SPACES TO MSGSW5 SW5
               ELSE
                   MOVE " "    TO SW5
                   MOVE "XX"   TO MSGSW5.

           IF SW6 NOT = SPACE
               MOVE "X"        TO CHANGE-SW-1
               IF MSGSW6 NOT = SPACES
                   MOVE SPACES TO MSGSW6 SW6
               ELSE
                   MOVE " "    TO SW6
                   MOVE "XX "  TO MSGSW6.

           MOVE CC-NUM1        TO CC-KEY.
           PERFORM CHECK-WRITE-1.

           IF KEY-HIT = 7
               GO TO SCREEN-TWO.

           GO TO SCREEN-ONE.

       SCREEN-TWO.
           IF INIT-VALUE = "400 "
              MOVE "X"         TO I-400
           ELSE
           IF INIT-VALUE = "750 "
              MOVE "X"         TO I-750.

           IF REINIT-VALUE = "000 "
              MOVE "X"         TO R-NOT
           ELSE
           IF REINIT-VALUE = "200 "
              MOVE "X"         TO R-HALF
           ELSE
           IF REINIT-VALUE = "375 "
              MOVE "X"         TO R-HALF
           ELSE
           IF REINIT-VALUE = "300 "
              MOVE "X"         TO R-100
           ELSE
           IF REINIT-VALUE = "650 "
              MOVE "X"         TO R-100.

           MOVE "VPMCUST2"     TO SCREEN-NAME.

       SHOWFORM-TWO.
           MOVE "00"           TO SCREEN-STATUS.
           MOVE SCREEN-DATA-2  TO DISPLAY-REC SCREEN-SAVE-2.

           WRITE DISPLAY-REC   FORMAT IS SCREEN-NAME
               INDIC ARE SCREEN-INDICATORS.
           IF SCREEN-STATUS NOT = "00"
               DISPLAY "SCREEN WRITE ERROR.  SCREEN-STATUS IS "
                               SCREEN-STATUS
               GO TO END-OF-JOB.

           READ  DISPLAY-FILE  FORMAT IS SCREEN-NAME
               INDIC ARE SCREEN-INDICATORS
           IF SCREEN-STATUS NOT = "00"
               DISPLAY "SCREEN READ ERROR.  SCREEN-STATUS IS "
                               SCREEN-STATUS
               GO TO END-OF-JOB.

           MOVE ALL B"0"       TO SCREEN-INDICATORS.
           MOVE DISPLAY-REC    TO SCREEN-DATA-2.

           IF KEY-HIT = 3 OR 8 GO TO END-OF-JOB.

           IF KEY-HIT = 1 OR 2 OR 4 OR 5 OR 6
               GO TO SCREEN-TWO.

           IF I-400  NOT = SPACE MOVE "X" TO I-400.
           IF I-750  NOT = SPACE MOVE "X" TO I-750.
           IF R-NOT  NOT = SPACE MOVE "X" TO R-NOT.
           IF R-HALF NOT = SPACE MOVE "X" TO R-HALF.
           IF R-100  NOT = SPACE MOVE "X" TO R-100.

           IF " " = I-400 AND I-750
      *M**************************************************************
      *M  MESSAGE:  041/025
      *M  ONE FIELD MUST BE SELECTED
      *M**************************************************************
               MOVE 41025      TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER TO ERRMSG2
               MOVE B"1"       TO IND(1) IND(99)
               GO TO SHOWFORM-TWO.

           IF "X" = I-400 AND I-750
      *M**************************************************************
      *M  MESSAGE:  041/026
      *M  ONLY ONE FIELD MAY BE SELECTED
      *M**************************************************************
               MOVE 41026      TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER TO ERRMSG2
               MOVE B"1"       TO IND(1) IND(99)
               GO TO SHOWFORM-TWO.

           IF " " = R-NOT AND R-100 AND R-HALF
      *M**************************************************************
      *M  MESSAGE:  041/025
      *M  ONE FIELD MUST BE SELECTED
      *M**************************************************************
               MOVE 41025      TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER TO ERRMSG2
               MOVE B"1"       TO IND(2) IND(99)
               GO TO SHOWFORM-TWO.

           IF "X" = R-NOT AND R-100
      *M**************************************************************
      *M  MESSAGE:  041/026
      *M  ONLY ONE FIELD MAY BE SELECTED
      *M**************************************************************
               MOVE 41026      TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER TO ERRMSG2
               MOVE B"1"       TO IND(2) IND(99)
               GO TO SHOWFORM-TWO.

           IF "X" = R-100 AND R-HALF
      *M**************************************************************
      *M  MESSAGE:  041/026
      *M  ONLY ONE FIELD MAY BE SELECTED
      *M**************************************************************
               MOVE 41026      TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER TO ERRMSG2
               MOVE B"1"       TO IND(2) IND(99)
               GO TO SHOWFORM-TWO.

           IF "X" = R-NOT AND R-HALF
      *M**************************************************************
      *M  MESSAGE:  041/026
      *M  ONLY ONE FIELD MAY BE SELECTED
      *M**************************************************************
               MOVE 41026      TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER TO ERRMSG2
               MOVE B"1"       TO IND(2) IND(99)
               GO TO SHOWFORM-TWO.

           IF I-400 = "X"
              MOVE "400 "      TO INIT-VALUE
           ELSE
           IF I-750 = "X"
              MOVE "750 "      TO INIT-VALUE.

           MOVE "000 "         TO REINIT-VALUE.
           IF R-HALF = "X" AND INIT-VALUE = "400 "
              MOVE "200 "      TO REINIT-VALUE
           ELSE
           IF R-HALF = "X" AND INIT-VALUE = "750 "
              MOVE "375 "      TO REINIT-VALUE
           ELSE
           IF R-100 = "X" AND INIT-VALUE = "400 "
              MOVE "300 "      TO REINIT-VALUE
           ELSE
           IF R-100 = "X" AND INIT-VALUE = "750 "
              MOVE "650 "      TO REINIT-VALUE.

           MOVE CC-NUM1        TO CC-KEY.
           PERFORM CHECK-WRITE-2.

           IF KEY-HIT = 7
               GO TO SCREEN-ONE.

           GO TO SCREEN-TWO.

       END-OF-JOB.
           CLOSE               DISPLAY-FILE
                               PER-PERSONNEL
                               PM-MASTER-FILE.
           GOBACK.

       CHECK-WRITE-1.
           IF NEW-RECORD
               PERFORM WRITE-DATA-RECORD
           ELSE
           IF CHANGE-SW-1 NOT = SPACE
               MOVE SPACE      TO CHANGE-SW-1
               PERFORM WRITE-DATA-RECORD.

       CHECK-WRITE-2.
           IF NEW-RECORD
               PERFORM WRITE-DATA-RECORD
           ELSE
           IF SCREEN-DATA-2 NOT = SCREEN-SAVE-2
               PERFORM WRITE-DATA-RECORD.

       WRITE-DATA-RECORD.
           IF NEW-RECORD
               PERFORM WRITE-NEW-RECORD
           ELSE
               PERFORM WRITE-OLD-RECORD.

           MOVE CNUM-BUF       TO PERCCNUM OF PM-MASTER-FILE.
           READ PM-MASTER-FILE INTO PM-MASTER-DATA
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
               MOVE "READ ERROR:  PM-MASTER-FILE" TO  BU-DISPLAY-MSG
               MOVE "MCFLMM4701" TO BU-DISPLAY-FLD (1)
               MOVE FILE-STAT    TO BU-DISPLAY-FLD (2)
               GO TO 999-BLOWUP.

       WRITE-NEW-RECORD.
           WRITE PMREC         FROM PM-MASTER-DATA
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
               MOVE "WRITE ERROR:  PM-MASTER-FILE" TO  BU-DISPLAY-MSG
               MOVE "MCFLMM4701" TO BU-DISPLAY-FLD (1)
               MOVE FILE-STAT  TO BU-DISPLAY-FLD (2)
               GO TO 999-BLOWUP.
           MOVE " "            TO INPUT-SW.

       WRITE-OLD-RECORD.
           REWRITE PMREC       FROM PM-MASTER-DATA
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
               MOVE "REWRITE ERROR:  PM-MASTER-FILE" TO  BU-DISPLAY-MSG
               MOVE "MCFLMM4701" TO BU-DISPLAY-FLD (1)
               MOVE FILE-STAT    TO BU-DISPLAY-FLD (2)
               GO TO 999-BLOWUP.

       999-BLOWUP.
           MOVE "SPMSETUP"     TO BU-PGM-NAME.
           CALL "TBLOWUP"      USING BASE
                               BU-PGM-NAME
                               STATUS-AREA
                               VIEW-COMAREA
                               FILE-STAT
                               BU-DISPLAY-MSG
                               BU-DISPLAY-AREA.

       999-CATREAD.
           MOVE SPACES         TO MESSAGE-BUFFER.
           CALL "CCATREAD"     USING CATREAD-PARMS.
           MOVE CATREAD-MSG-TEXT TO MESSAGE-BUFFER.

       999-CATREAD-EXIT.       EXIT.

