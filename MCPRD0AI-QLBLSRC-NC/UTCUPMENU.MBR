           SELECT DISPLAY-FILE
                  ASSIGN TO WORKSTATION-UTFDUPMENU-SI
                  ORGANIZATION IS TRANSACTION
                  ACCESS IS SEQUENTIAL
                  FILE STATUS IS DISPLAY-STATUS
                  CONTROL-AREA IS WS-CONTROL.

018500 DATA DIVISION.
018600 FILE SECTION.
018700
018800 FD  ONLINE-PRT
018900     LABEL RECORDS ARE OMITTED
019000     RECORD CONTAINS 132 CHARACTERS
019100     DATA RECORD IS PRINT-RCD.
019200 01  PRINT-RCD.
019300     05  PRINT-LINE           PIC X(132).
019400
