      ********* CHECK TO SEE IF CORRECT VENDOR CODE(S)
           MOVE "N"               TO  VENDOR-MATCH-SW.
           IF VENDOR-CODES (1) > SPACES OR VENDOR-CODES (2) > SPACES
                                        OR VENDOR-CODES (3) > SPACES
               PERFORM VARYING SUB FROM 1 BY 1 UNTIL SUB > 3
                                               OR VENDOR-MATCH-SW = "Y"
                   IF PO-VEN-CODE = VENDOR-CODES (SUB)
                       MOVE "Y"   TO VENDOR-MATCH-SW
                   END-IF
               END-PERFORM
               IF VENDOR-MATCH-SW = "N"
                   GO TO 86-MAIN.

