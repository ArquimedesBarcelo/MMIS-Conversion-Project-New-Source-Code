           END-PERFORM.

092200     IF RPT1-ITEMS-SW = "N"
092300         WRITE PRINT-RCD FROM HDR-1 AFTER ADVANCING NEW-PAGE
               IF VENDOR-MATCH-SW = "Y"
                   WRITE PRINT-RCD FROM HDR-VENDOR AFTER ADVANCING 1
               END-IF
092400         MOVE "NO PURCHASE ORDERS QUALIFIED FOR REPORT"
092500             TO PRINT-RCD
092600         WRITE PRINT-RCD AFTER ADVANCING 3 LINES.
092700     IF RPT2-ITEMS-SW = "N"
092800         WRITE PRINT-RCD FROM HDR-7 AFTER ADVANCING NEW-PAGE
               IF VENDOR-MATCH-SW = "Y"
                   WRITE PRINT-RCD FROM HDR-VENDOR AFTER ADVANCING 1
               END-IF
092900         MOVE "NO PURCHASE ORDER QUALIFIED FOR REPORT"
093000             TO PRINT-RCD
093100         WRITE PRINT-RCD AFTER ADVANCING 3 LINES.
093200
093300     IF PAPER-IS-132-COLS
093400         NEXT SENTENCE
093500     ELSE
093600         WRITE PRINT-RCD FROM NORMAL-PRINT AFTER ADVANCING 0.
093700
093800     MOVE SPACES TO PRINT-RCD.
093900     WRITE PRINT-RCD AFTER ADVANCING NEW-PAGE.
094000
094100 9-OR-EXIT.
094200     EXIT.
       9-OP-EXIT.
           EXIT.
047000 COPY OVRPFCALL OF COPYLIB.
