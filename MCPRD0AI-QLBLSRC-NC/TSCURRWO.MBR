           COPY SCREENIO       IN COPYLIB.

           COPY CATREAD        IN COPYLIB.

           COPY JCWAREA        IN COPYLIB.

       01  WO-BASIC-DATA.
           COPY DWOBASIC       IN COPYLIB.

       01  WO-PLANNED-DATA.
           COPY DWOPLAN        IN COPYLIB.

       01  WO-PERS-DATA.
           COPY MPERSONL       IN COPYLIB.

       01  ZONE-DATA.
           COPY MZONPRTY       IN COPYLIB.

       01  LABOR-CURR-DATA.
           COPY DCURRLBR       IN COPYLIB.

       01  MESSAGE-BUFFER-DATA.
           COPY ERRORLIN       IN COPYLIB.

       LINKAGE SECTION.
       01  DBPARAMETERS.
           COPY DBPARMS        IN COPYLIB.

       PROCEDURE DIVISION USING DBPARAMETERS.
       CHECK-PASSWORD          SECTION 01.
           CALL "TPWORD" USING PASSWORD-INFORMATION.
           IF PASSWORD-FLAG NOT = "N"
               GO TO OPEN-FILES.
           GOBACK.

       OPEN-FILES.
           OPEN INPUT          LABOR-CURRENT-STAT.
           OPEN INPUT          PER-PERSONNEL.
           OPEN INPUT          WO-BASIC.
           OPEN INPUT          WO-PLANNED.
           OPEN INPUT          WO-ZONE-PRTY.
           OPEN INPUT          PER-CREW-MSTR.
           OPEN I-O            DISPLAY-FILE.
           OPEN I-O            DISPLAY-FILE-2.
           ACCEPT MC-LOCAL-DATA-AREA FROM LOCAL-DATA-AREA.
           MOVE 0              TO CREW-PARM.
           IF RETURN-BYTE = "C"
               MOVE 1          TO CREW-PARM.

       BEGIN.
           PERFORM 1-HSK THRU 1-HSK-EXIT.
           GO TO 6-MAIN.

       END-OF-JOB.
           CLOSE               LABOR-CURRENT-STAT.
           CLOSE               PER-PERSONNEL.
           CLOSE               WO-BASIC.
           CLOSE               WO-PLANNED.
           CLOSE               WO-ZONE-PRTY.
           CLOSE               PER-CREW-MSTR.
           CLOSE               DISPLAY-FILE.
           CLOSE               DISPLAY-FILE-2.
           CLOSE               OUT-FILE.
           GOBACK.

       1-HSK.
           MOVE 0              TO FUNCTION-SW
                                  RESERVATIONS.
           MOVE SPACES         TO QUEUE-RECORDS CNUM-BUFFER.
           MOVE "Q"            TO AUTOQ-SW.
      *********************************************************
      **  IF JCW `AUTOQSW' IS SET TO BLANK, THE EXECUTIVE    **
      **  WILL RUN THE AUTO-ZONE VERSION (TAUTOQZ) AT THE    **
      **  SELECTION OF `f1'.  IF THE JCW IS SET TO ANY OTHER **
      **  VALUE, THE AUTO-CRAFT VERSION (TAUTOQC) OF `f1'    **
      **  WILL BE EXECUTED.                                  **
      *********************************************************

           IF JCW-AUTOQSW-266 = " "
               NEXT SENTENCE
           ELSE
               MOVE "C"        TO AUTOQ-SW.

           MOVE SPACES         TO SCREEN-DATA MESSAGE-BUFFER
                                  LINE-DATA SHIFT-DATA.

           IF JCW-ZJCW-269 = "    "
               PERFORM 1-GETZONE-JCW THRU 1-GZJ-EXIT
           ELSE
               MOVE JCW-ZJCW-269 TO ZONE-FIELD.

           MOVE ZONE-FIELD     TO ZONE-DISP ZONE-BUFFER.

           IF CREW-PARM = 0
               GO TO 1-HSK-CONT.

           IF JCW-CREWJCW-276 = "  "
               PERFORM 2-GETCREW-JCW THRU 2-GCJ-EXIT
           ELSE
               MOVE JCW-CREWJCW-276 TO CREW-BUF.

       1-HSK-CONT.
           ACCEPT TIME-BUFF    FROM TIME.
           MOVE TIME-HM        TO TIME-IN.
           CALL "TGETSHFT" USING SHIFT-DATA
                                 DBPARAMETERS.
           MOVE "VCURRWOS"       TO SCREEN-NAME.

       1-HSK-EXIT.    EXIT.

       1-GETZONE-JCW.
           MOVE SPACES           TO ZONE-SCREEN-DATA MESSAGE-BUFFER.
           MOVE "VGETZONE"       TO SCREEN-NAME.

       1-SHOWFORM.
           MOVE "00"           TO SCREEN-STATUS.
           MOVE ZONE-SCREEN-DATA TO DISPLAY-REC-2.

           WRITE DISPLAY-REC-2 FORMAT IS SCREEN-NAME
               INDIC ARE SCREEN-INDICATORS.
           IF SCREEN-STATUS NOT = "00"
               DISPLAY "SCREEN WRITE ERROR.  SCREEN-STATUS IS "
                        SCREEN-STATUS
               GO TO END-OF-JOB.

           READ  DISPLAY-FILE-2 FORMAT IS SCREEN-NAME
               INDIC ARE SCREEN-INDICATORS
           IF SCREEN-STATUS NOT = "00"
               DISPLAY "SCREEN READ ERROR.  SCREEN-STATUS IS "
                        SCREEN-STATUS
               GO TO END-OF-JOB.

           MOVE DISPLAY-REC-2  TO ZONE-SCREEN-DATA.
           MOVE ALL B"0"       TO SCREEN-INDICATORS.

           IF KEY-HIT = 1 OR 3
               GO TO END-OF-JOB.

           IF ZONE-BUF = SPACES
      ************************************************************
      ****  MESSAGE:  ZONE IS REQUIRED
      ************************************************************
               MOVE  52        TO CATREAD-MSG-SET
               MOVE   1        TO CATREAD-MSG-NUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER TO ERRMSGZ
               MOVE TRUE-VAL   TO IND(1) IND(99)
               GO TO 1-SHOWFORM.

           MOVE ZONE-BUF       TO ZONE-BUFFER Z-ARG.
           MOVE ZONE-ARGUMENT  TO ZONEPRTY OF WO-ZONE-PRTY.
           READ WO-ZONE-PRTY   INTO ZONE-DATA
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
      ************************************************************
      ****  MESSAGE:  INVALID ZONE
      ************************************************************
               MOVE  35        TO CATREAD-MSG-SET
               MOVE  44        TO CATREAD-MSG-NUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE FILE-STAT  TO CON-WORD
               MOVE CON-WORD   TO MSG-FLD
               MOVE MESSAGE-BUFFER TO ERRMSGZ
               MOVE TRUE-VAL   TO IND(1) IND(99)
               GO TO 1-SHOWFORM.

           MOVE ZONE-FIELD     TO SETJCW-VALUE JCW-ZJCW-269.
           MOVE 269            TO SETJCW-STARTING-POS.
           MOVE 4              TO SETJCW-LENGTH.
           MOVE "00"           TO SETJCW-STATUS.

           CALL "SETJCW" USING SETJCW-VALUE
                               SETJCW-STARTING-POS
                               SETJCW-LENGTH
                               SETJCW-STATUS.
           IF SETJCW-STATUS NOT = "00"
               MOVE "    "     TO JCW-ZJCW-269.

           ACCEPT TIME-BUFF    FROM TIME.
           MOVE TIME-HM        TO TIME-IN.
           CALL "TGETSHFT" USING SHIFT-DATA
                                 DBPARAMETERS.

       1-GZJ-EXIT.    EXIT.

       2-GETCREW-JCW.
           MOVE SPACES         TO CREW-SCREEN-DATA MESSAGE-BUFFER.
           MOVE "VGETCREW"     TO SCREEN-NAME.

       2-SHOWFORM.
           MOVE "00"           TO SCREEN-STATUS.
           MOVE CREW-SCREEN-DATA TO DISPLAY-REC-2.

           WRITE DISPLAY-REC-2 FORMAT IS SCREEN-NAME
               INDIC ARE SCREEN-INDICATORS.
           IF SCREEN-STATUS NOT = "00"
               DISPLAY "SCREEN WRITE ERROR.  SCREEN-STATUS IS "
                        SCREEN-STATUS
               GO TO END-OF-JOB.

           READ  DISPLAY-FILE-2 FORMAT IS SCREEN-NAME
               INDIC ARE SCREEN-INDICATORS
           IF SCREEN-STATUS NOT = "00"
               DISPLAY "SCREEN READ ERROR.  SCREEN-STATUS IS "
                        SCREEN-STATUS
               GO TO END-OF-JOB.

           MOVE DISPLAY-REC-2  TO CREW-SCREEN-DATA.
           MOVE ALL B"0"       TO SCREEN-INDICATORS.

           IF KEY-HIT = 1 OR 3
               GO TO END-OF-JOB.

           IF CREW-BUF = SPACES
      ************************************************************
      ****  MESSAGE:  CREW IS REQUIRED
      ************************************************************
               MOVE  29        TO CATREAD-MSG-SET
               MOVE 111        TO CATREAD-MSG-NUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER TO ERRMSGC
               MOVE TRUE-VAL   TO IND(1) IND(99)
               GO TO 2-SHOWFORM.

           MOVE CREW-BUF       TO CREWMASTER OF PER-CREW-MSTR.
           READ PER-CREW-MSTR  INTO CREW-DATA
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
      ************************************************************
      ****  MESSAGE:  INVALID CREW
      ************************************************************
               MOVE  35        TO CATREAD-MSG-SET
               MOVE  26        TO CATREAD-MSG-NUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE FILE-STAT  TO CON-WORD
               MOVE CON-WORD   TO MSG-FLD
               MOVE MESSAGE-BUFFER TO ERRMSGC
               MOVE TRUE-VAL   TO IND(1) IND(99)
               GO TO 2-SHOWFORM.

           MOVE CREW-BUF       TO SETJCW-VALUE JCW-CREWJCW-276.
           MOVE 276            TO SETJCW-STARTING-POS.
           MOVE 2              TO SETJCW-LENGTH.
           MOVE "00"           TO SETJCW-STATUS.

           CALL "SETJCW" USING SETJCW-VALUE
                               SETJCW-STARTING-POS
                               SETJCW-LENGTH
                               SETJCW-STATUS.
           IF SETJCW-STATUS NOT = "00"
               MOVE "  "       TO JCW-CREWJCW-276.

       2-GCJ-EXIT. EXIT.

       6-MAIN.
           MOVE 0              TO ACT-KEY.
           SORT SORT-FILE ASCENDING KEY SORT-CC-NAME
               INPUT PROCEDURE SORT-IN-PROC
               OUTPUT PROCEDURE SORT-OUT-PROC.

           IF ACT-KEY = 0
               MOVE SPACES     TO SCREEN-DATA
               MOVE ZONE-FIELD TO ZONE-DISP
      ************************************************************
      ****  MESSAGE:  NO RECORDS FOUND WHICH MATCH YOUR SELECTION
      ************************************************************
               MOVE  40        TO CATREAD-MSG-SET
               MOVE  11        TO CATREAD-MSG-NUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER TO ERRMSG
               MOVE TRUE-VAL   TO IND(99)
               GO TO 61-SHOWFORM.

           MOVE 0              TO ACT-KEY.
           OPEN INPUT          OUT-FILE.

       61-RESET-SCREEN.
           MOVE SPACES         TO SCREEN-DATA.
           MOVE ZONE-FIELD     TO ZONE-DISP.
           PERFORM 62-FILL-SCREEN THRU 62-FS-EXIT.
      ************************************************************
      ****  MESSAGE:  PRESS `ENTER' TO CONTINUE OR
      ****                        PRESS APPROPRIATE FUNCTION KEY
      ************************************************************
           MOVE  42            TO CATREAD-MSG-SET.
           MOVE  69            TO CATREAD-MSG-NUM.
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
           MOVE MESSAGE-BUFFER TO CMDMSG.

       61-SHOWFORM.
           IF CREW-PARM NOT = 0
               MOVE "VCURRWOSC" TO SCREEN-NAME.

           MOVE "00"           TO SCREEN-STATUS.
           MOVE SCREEN-DATA    TO DISPLAY-REC SCREEN-SAVE.

           WRITE DISPLAY-REC  FORMAT IS SCREEN-NAME
               INDIC ARE SCREEN-INDICATORS.
           IF SCREEN-STATUS NOT = "00"
               DISPLAY "SCREEN WRITE ERROR.  SCREEN-STATUS IS "
                        SCREEN-STATUS
               GO TO END-OF-JOB.

           READ  DISPLAY-FILE FORMAT IS SCREEN-NAME
               INDIC ARE SCREEN-INDICATORS
           IF SCREEN-STATUS NOT = "00"
               DISPLAY "SCREEN READ ERROR.  SCREEN-STATUS IS "
                        SCREEN-STATUS
               GO TO END-OF-JOB.

           MOVE DISPLAY-REC    TO SCREEN-DATA.
           MOVE ALL B"0"       TO SCREEN-INDICATORS.

           IF KEY-HIT = 1 OR 3
               GO TO END-OF-JOB.

           IF KEY-HIT = 2
               MOVE "    "     TO JCW-ZJCW-269
               CLOSE           OUT-FILE
               GO TO BEGIN.

           IF KEY-HIT = 4
               IF AUTOQ-SW = "Q"
                   CALL "CLAUTOQZ" USING DBPARAMETERS
                                         FUNCTION-SW
                                         CNUM-BUFFER
                                         QUEUE-RECORDS
                                         RESERVATIONS
                   ACCEPT MC-LOCAL-DATA-AREA FROM LOCAL-DATA-AREA
                   MOVE JCW-ZJCW-269 TO ZONE-FIELD
                   GO TO 6-MAIN
               ELSE
                   CALL "CLAUTOQC" USING DBPARAMETERS
                                         FUNCTION-SW
                                         CNUM-BUFFER
                                         QUEUE-RECORDS
                                         RESERVATIONS
                   ACCEPT MC-LOCAL-DATA-AREA FROM LOCAL-DATA-AREA
                   MOVE JCW-ZJCW-269 TO ZONE-FIELD
                   GO TO 6-MAIN.

           IF KEY-HIT = 5
               CLOSE           OUT-FILE
               PERFORM 63-SPEC-DISP THRU 63-SPEC-DISP-EXIT
               GO TO 6-MAIN.

           IF KEY-HIT = 8
               IF CREW-PARM = 0
                   NEXT SENTENCE
               ELSE
                   MOVE "  "   TO JCW-CREWJCW-276
                   CLOSE       OUT-FILE
                   GO TO BEGIN.

           IF KEY-HIT NOT = 0
               GO TO 61-SHOWFORM.

           IF EOF-SW = 1
               MOVE 0  TO EOF-SW
               MOVE 0  TO ACT-KEY.

           IF WO-S1 NOT = SPACE AND
              DESC-BUF-1 NOT = "UNASSIGNED"
                 MOVE WO-NUM-BUF-1  TO DWO-BUFFER
                 MOVE WO-FILE-SW-1  TO FFLAG
                 MOVE SPACE         TO WO-S1
                 PERFORM 64-DISPLAY-WO THRU 64-EXIT
                 MOVE SCREEN-SAVE   TO DISPLAY-REC
                 GO TO 61-SHOWFORM
           ELSE
           IF WO-S2 NOT = SPACE AND
              DESC-BUF-2 NOT = "UNASSIGNED"
                 MOVE WO-NUM-BUF-2  TO DWO-BUFFER
                 MOVE WO-FILE-SW-2  TO FFLAG
                 MOVE SPACE         TO WO-S2
                 PERFORM 64-DISPLAY-WO THRU 64-EXIT
                 MOVE SCREEN-SAVE   TO DISPLAY-REC
                 GO TO 61-SHOWFORM
           ELSE
           IF WO-S3 NOT = SPACE AND
              DESC-BUF-3 NOT = "UNASSIGNED"
                 MOVE WO-NUM-BUF-3  TO DWO-BUFFER
                 MOVE WO-FILE-SW-3  TO FFLAG
                 MOVE SPACE         TO WO-S3
                 PERFORM 64-DISPLAY-WO THRU 64-EXIT
                 MOVE SCREEN-SAVE   TO DISPLAY-REC
                 GO TO 61-SHOWFORM
           ELSE
           IF WO-S4 NOT = SPACE AND
              DESC-BUF-4 NOT = "UNASSIGNED"
                 MOVE WO-NUM-BUF-4  TO DWO-BUFFER
                 MOVE WO-FILE-SW-4  TO FFLAG
                 MOVE SPACE         TO WO-S4
                 PERFORM 64-DISPLAY-WO THRU 64-EXIT
                 MOVE SCREEN-SAVE   TO DISPLAY-REC
                 GO TO 61-SHOWFORM
           ELSE
           IF WO-S5 NOT = SPACE AND
              DESC-BUF-5 NOT = "UNASSIGNED"
                 MOVE WO-NUM-BUF-5  TO DWO-BUFFER
                 MOVE WO-FILE-SW-5  TO FFLAG
                 MOVE SPACE         TO WO-S5
                 PERFORM 64-DISPLAY-WO THRU 64-EXIT
                 MOVE SCREEN-SAVE   TO DISPLAY-REC
                 GO TO 61-SHOWFORM
           ELSE
           IF WO-S6 NOT = SPACE AND
              DESC-BUF-6 NOT = "UNASSIGNED"
                 MOVE WO-NUM-BUF-6  TO DWO-BUFFER
                 MOVE WO-FILE-SW-6  TO FFLAG
                 MOVE SPACE         TO WO-S6
                 PERFORM 64-DISPLAY-WO THRU 64-EXIT
                 MOVE SCREEN-SAVE   TO DISPLAY-REC
                 GO TO 61-SHOWFORM
           ELSE
           IF WO-S7 NOT = SPACE AND
              DESC-BUF-7 NOT = "UNASSIGNED"
                 MOVE WO-NUM-BUF-7  TO DWO-BUFFER
                 MOVE WO-FILE-SW-7  TO FFLAG
                 MOVE SPACE         TO WO-S7
                 PERFORM 64-DISPLAY-WO THRU 64-EXIT
                 MOVE SCREEN-SAVE   TO DISPLAY-REC
                 GO TO 61-SHOWFORM
           ELSE
           IF WO-S8 NOT = SPACE AND
              DESC-BUF-8 NOT = "UNASSIGNED"
                 MOVE WO-NUM-BUF-8  TO DWO-BUFFER
                 MOVE WO-FILE-SW-8  TO FFLAG
                 MOVE SPACE         TO WO-S1
                 PERFORM 64-DISPLAY-WO THRU 64-EXIT
                 MOVE SCREEN-SAVE   TO DISPLAY-REC
                 GO TO 61-SHOWFORM
           ELSE
           IF WO-S9 NOT = SPACE AND
              DESC-BUF-9 NOT = "UNASSIGNED"
                 MOVE WO-NUM-BUF-9  TO DWO-BUFFER
                 MOVE WO-FILE-SW-9  TO FFLAG
                 MOVE SPACE         TO WO-S9
                 PERFORM 64-DISPLAY-WO THRU 64-EXIT
                 MOVE SCREEN-SAVE   TO DISPLAY-REC
                 GO TO 61-SHOWFORM
           ELSE
           IF WO-S10 NOT = SPACE AND
              DESC-BUF-10 NOT = "UNASSIGNED"
                 MOVE WO-NUM-BUF-10 TO DWO-BUFFER
                 MOVE WO-FILE-SW-10 TO FFLAG
                 MOVE SPACE         TO WO-S10
                 PERFORM 64-DISPLAY-WO THRU 64-EXIT
                 MOVE SCREEN-SAVE   TO DISPLAY-REC
                 GO TO 61-SHOWFORM
           ELSE
           IF WO-S11 NOT = SPACE AND
              DESC-BUF-11 NOT = "UNASSIGNED"
                 MOVE WO-NUM-BUF-11  TO DWO-BUFFER
                 MOVE WO-FILE-SW-11 TO FFLAG
                 MOVE SPACE         TO WO-S11
                 PERFORM 64-DISPLAY-WO THRU 64-EXIT
                 MOVE SCREEN-SAVE   TO DISPLAY-REC
                 GO TO 61-SHOWFORM
           ELSE
           IF WO-S12 NOT = SPACE AND
              DESC-BUF-12 NOT = "UNASSIGNED"
                 MOVE WO-NUM-BUF-12 TO DWO-BUFFER
                 MOVE WO-FILE-SW-12 TO FFLAG
                 MOVE SPACE         TO WO-S12
                 PERFORM 64-DISPLAY-WO THRU 64-EXIT
                 MOVE SCREEN-SAVE   TO DISPLAY-REC
                 GO TO 61-SHOWFORM
           ELSE
           IF WO-S13 NOT = SPACE AND
              DESC-BUF-13 NOT = "UNASSIGNED"
                 MOVE WO-NUM-BUF-13 TO DWO-BUFFER
                 MOVE WO-FILE-SW-13 TO FFLAG
                 MOVE SPACE         TO WO-S13
                 PERFORM 64-DISPLAY-WO THRU 64-EXIT
                 MOVE SCREEN-SAVE   TO DISPLAY-REC
                 GO TO 61-SHOWFORM
           ELSE
           IF WO-S14 NOT = SPACE AND
              DESC-BUF-14 NOT = "UNASSIGNED"
                 MOVE WO-NUM-BUF-14 TO DWO-BUFFER
                 MOVE WO-FILE-SW-14 TO FFLAG
                 MOVE SPACE         TO WO-S14
                 PERFORM 64-DISPLAY-WO THRU 64-EXIT
                 MOVE SCREEN-SAVE   TO DISPLAY-REC
                 GO TO 61-SHOWFORM
           ELSE
           IF WO-S15 NOT = SPACE AND
              DESC-BUF-15 NOT = "UNASSIGNED"
                 MOVE WO-NUM-BUF-15 TO DWO-BUFFER
                 MOVE WO-FILE-SW-15 TO FFLAG
                 MOVE SPACE         TO WO-S15
                 PERFORM 64-DISPLAY-WO THRU 64-EXIT
                 MOVE SCREEN-SAVE   TO DISPLAY-REC
                 GO TO 61-SHOWFORM.

           GO TO 61-RESET-SCREEN.

       64-DISPLAY-WO.
           MOVE SPACES         TO WO-BASIC-DATA WO-PLANNED-DATA.
           IF FFLAG = "*"
                GO TO 64-DISPLAY-PLANNED.

           MOVE "B"            TO FILE-SW.
           MOVE DWO-BUFFER     TO WONUM OF WO-BASIC.
           READ WO-BASIC       INTO WO-BASIC-DATA
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
               MOVE "READ   B" TO DB-FUNC
               MOVE "WO-BASIC" TO DB-FILE
               MOVE FILE-STAT  TO CON-WORD
               MOVE DB-ERROR   TO MESSAGE-BUFFER
               MOVE DWO-BUFFER TO MSG-FLD
               GO TO 64-CONT.

           GO TO 64-CALL-DISPLAY-PROGRAM.

       64-DISPLAY-PLANNED.
           MOVE "P"            TO FILE-SW.
           MOVE DWO-BUFFER     TO WONUM OF WO-PLANNED.
           READ WO-PLANNED     INTO WO-PLANNED-DATA
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
               MOVE "READ   P" TO DB-FUNC
               MOVE "WO-PLANNED" TO DB-FILE
               MOVE FILE-STAT  TO CON-WORD
               MOVE DB-ERROR   TO MESSAGE-BUFFER
               MOVE DWO-BUFFER TO MSG-FLD
               GO TO 64-CONT.

       64-CALL-DISPLAY-PROGRAM.
           MOVE SPACES         TO MESSAGE-BUFFER.
           CALL "TDISPWO" USING DBPARAMETERS
                                WO-BASIC-DATA
                                WO-PLANNED-DATA
                                FILE-SW.

           MOVE "VCURRWOS"     TO SCREEN-NAME.

       64-CONT.
           MOVE SCREEN-SAVE    TO SCREEN-DATA.

       64-EXIT.    EXIT.

       62-FILL-SCREEN.
           ADD 1               TO ACT-KEY.
           MOVE SPACES         TO OUT-REC.
           READ OUT-FILE INVALID KEY
               MOVE 1          TO EOF-SW
               GO TO 62-FS-EXIT.
           IF ACT-KEY > MAX-KEY
               MOVE 1          TO EOF-SW
               GO TO 62-FS-EXIT.
           PERFORM 62-MOVE-DATA.
           MOVE LINE-DATA      TO LINE-1.

           ADD 1               TO ACT-KEY.
           MOVE SPACES         TO OUT-REC.
           READ OUT-FILE INVALID KEY
               MOVE 1          TO EOF-SW
               GO TO 62-FS-EXIT.
           IF ACT-KEY > MAX-KEY
               MOVE 1          TO EOF-SW
               GO TO 62-FS-EXIT.
           PERFORM 62-MOVE-DATA.
           MOVE LINE-DATA      TO LINE-2.

           ADD 1               TO ACT-KEY.
           MOVE SPACES         TO OUT-REC.
           READ OUT-FILE INVALID KEY
               MOVE 1          TO EOF-SW
               GO TO 62-FS-EXIT.
           IF ACT-KEY > MAX-KEY
               MOVE 1          TO EOF-SW
               GO TO 62-FS-EXIT.
           PERFORM 62-MOVE-DATA.
           MOVE LINE-DATA      TO LINE-3.

           ADD 1               TO ACT-KEY.
           MOVE SPACES         TO OUT-REC.
           READ OUT-FILE INVALID KEY
               MOVE 1          TO EOF-SW
               GO TO 62-FS-EXIT.
           IF ACT-KEY > MAX-KEY
               MOVE 1          TO EOF-SW
               GO TO 62-FS-EXIT.
           PERFORM 62-MOVE-DATA.
           MOVE LINE-DATA      TO LINE-4.

           ADD 1               TO ACT-KEY.
           MOVE SPACES         TO OUT-REC.
           READ OUT-FILE INVALID KEY
               MOVE 1          TO EOF-SW
               GO TO 62-FS-EXIT.
           IF ACT-KEY > MAX-KEY
               MOVE 1          TO EOF-SW
               GO TO 62-FS-EXIT.
           PERFORM 62-MOVE-DATA.
           MOVE LINE-DATA      TO LINE-5.

           ADD 1               TO ACT-KEY.
           MOVE SPACES         TO OUT-REC.
           READ OUT-FILE INVALID KEY
               MOVE 1          TO EOF-SW
               GO TO 62-FS-EXIT.
           IF ACT-KEY > MAX-KEY
               MOVE 1          TO EOF-SW
               GO TO 62-FS-EXIT.
           PERFORM 62-MOVE-DATA.
           MOVE LINE-DATA      TO LINE-6.

           ADD 1               TO ACT-KEY.
           MOVE SPACES         TO OUT-REC.
           READ OUT-FILE INVALID KEY
               MOVE 1          TO EOF-SW
               GO TO 62-FS-EXIT.
           IF ACT-KEY > MAX-KEY
               MOVE 1          TO EOF-SW
               GO TO 62-FS-EXIT.
           PERFORM 62-MOVE-DATA.
           MOVE LINE-DATA      TO LINE-7.

           ADD 1               TO ACT-KEY.
           MOVE SPACES         TO OUT-REC.
           READ OUT-FILE INVALID KEY
               MOVE 1          TO EOF-SW
               GO TO 62-FS-EXIT.
           IF ACT-KEY > MAX-KEY
               MOVE 1          TO EOF-SW
               GO TO 62-FS-EXIT.
           PERFORM 62-MOVE-DATA.
           MOVE LINE-DATA      TO LINE-8.

           ADD 1               TO ACT-KEY.
           MOVE SPACES         TO OUT-REC.
           READ OUT-FILE INVALID KEY
               MOVE 1          TO EOF-SW
               GO TO 62-FS-EXIT.
           IF ACT-KEY > MAX-KEY
               MOVE 1          TO EOF-SW
               GO TO 62-FS-EXIT.
           PERFORM 62-MOVE-DATA.
           MOVE LINE-DATA      TO LINE-9.

           ADD 1               TO ACT-KEY.
           MOVE SPACES         TO OUT-REC.
           READ OUT-FILE INVALID KEY
               MOVE 1          TO EOF-SW
               GO TO 62-FS-EXIT.
           IF ACT-KEY > MAX-KEY
               MOVE 1          TO EOF-SW
               GO TO 62-FS-EXIT.
           PERFORM 62-MOVE-DATA.
           MOVE LINE-DATA      TO LINE-10.

           ADD 1               TO ACT-KEY.
           MOVE SPACES         TO OUT-REC.
           READ OUT-FILE INVALID KEY
               MOVE 1          TO EOF-SW
               GO TO 62-FS-EXIT.
           IF ACT-KEY > MAX-KEY
               MOVE 1          TO EOF-SW
               GO TO 62-FS-EXIT.
           PERFORM 62-MOVE-DATA.
           MOVE LINE-DATA      TO LINE-11.

           ADD 1               TO ACT-KEY.
           MOVE SPACES         TO OUT-REC.
           READ OUT-FILE INVALID KEY
               MOVE 1          TO EOF-SW
               GO TO 62-FS-EXIT.
           IF ACT-KEY > MAX-KEY
               MOVE 1          TO EOF-SW
               GO TO 62-FS-EXIT.
           PERFORM 62-MOVE-DATA.
           MOVE LINE-DATA      TO LINE-12.

           ADD 1               TO ACT-KEY.
           MOVE SPACES         TO OUT-REC.
           READ OUT-FILE INVALID KEY
               MOVE 1          TO EOF-SW
               GO TO 62-FS-EXIT.
           IF ACT-KEY > MAX-KEY
               MOVE 1          TO EOF-SW
               GO TO 62-FS-EXIT.
           PERFORM 62-MOVE-DATA.
           MOVE LINE-DATA      TO LINE-13.

           ADD 1               TO ACT-KEY.
           MOVE SPACES         TO OUT-REC.
           READ OUT-FILE INVALID KEY
               MOVE 1          TO EOF-SW
               GO TO 62-FS-EXIT.
           IF ACT-KEY > MAX-KEY
               MOVE 1          TO EOF-SW
               GO TO 62-FS-EXIT.
           PERFORM 62-MOVE-DATA.
           MOVE LINE-DATA      TO LINE-14.

           ADD 1               TO ACT-KEY.
           MOVE SPACES         TO OUT-REC.
           READ OUT-FILE INVALID KEY
               MOVE 1          TO EOF-SW
               GO TO 62-FS-EXIT.
           IF ACT-KEY > MAX-KEY
               MOVE 1          TO EOF-SW
               GO TO 62-FS-EXIT.
           PERFORM 62-MOVE-DATA.
           MOVE LINE-DATA      TO LINE-15.

       62-FS-EXIT.    EXIT.

       62-MOVE-DATA.
           MOVE SPACES             TO  LINE-DATA.
           MOVE OUT-TEMP-FLAG      TO  TEMP-BUF.
           MOVE OUT-CC-NUM         TO  CC-BUF.
           MOVE OUT-CC-NAME        TO  NAME-BUF.
           MOVE OUT-WO-TYPE        TO  WO-FILE-SW.
           MOVE OUT-WO-NUM         TO  WO-NUM-BUF.
           MOVE OUT-EQUIP          TO  EQUIP-BUF.
           MOVE OUT-LOCATION       TO  LOC-BUF.
           MOVE OUT-DESCRIPT       TO  DESC-BUF.
           IF OUT-WO-NUM = SPACES
               MOVE "UNASSIGNED"   TO WO-NUM-BUF.

       63-SPEC-DISP.
           MOVE "VCURRWO"      TO SCREEN-NAME.
           MOVE SPACES         TO SPEC-BUFFER MESSAGE-BUFFER.

       63-SHOWFORM.
           MOVE "00"           TO SCREEN-STATUS.
           MOVE SPEC-BUFFER    TO DISPLAY-REC.

           WRITE DISPLAY-REC  FORMAT IS SCREEN-NAME
               INDIC ARE SCREEN-INDICATORS.
           IF SCREEN-STATUS NOT = "00"
               DISPLAY "SCREEN WRITE ERROR.  SCREEN-STATUS IS "
                        SCREEN-STATUS
               GO TO END-OF-JOB.

           READ  DISPLAY-FILE FORMAT IS SCREEN-NAME
               INDIC ARE SCREEN-INDICATORS
           IF SCREEN-STATUS NOT = "00"
               DISPLAY "SCREEN READ ERROR.  SCREEN-STATUS IS "
                        SCREEN-STATUS
               GO TO END-OF-JOB.

           MOVE DISPLAY-REC    TO SPEC-BUFFER.
           MOVE ALL B"0"       TO SCREEN-INDICATORS.

           IF KEY-HIT = 3
               GO TO END-OF-JOB.

           IF KEY-HIT = 1
               GO TO 63-RESET-FORM.

           IF CC-SW = 0
               IF KEY-HIT NOT = 0
                   GO TO 63-SHOWFORM
               ELSE
                   NEXT SENTENCE
           ELSE
               IF KEY-HIT NOT = 0
                   GO TO 63-SHOWFORM.

           IF S-CC-BUF = "NEWS" OR "9999"
      ************************************************************
      ****  MESSAGE:  INVALID CRAFTSMAN NUMBER
      ************************************************************
               MOVE  35        TO CATREAD-MSG-SET
               MOVE  49        TO CATREAD-MSG-NUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER TO ERRMSGS
               MOVE TRUE-VAL   TO IND(99)
               GO TO 63-SHOWFORM.

           MOVE SPACES         TO S-NAME-BUF.
           MOVE S-CC-BUF       TO PERCCNUM OF PER-PERSONNEL.
           READ PER-PERSONNEL  INTO WO-PERS-DATA
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
             IF FILE-STAT-1 = "2"
      ************************************************************
      ****  MESSAGE:  INVALID CRAFTSMAN NUMBER
      ************************************************************
               MOVE  35        TO CATREAD-MSG-SET
               MOVE  49        TO CATREAD-MSG-NUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER TO ERRMSGS
               MOVE TRUE-VAL   TO IND(99)
               GO TO 63-SHOWFORM
             ELSE
               MOVE FILE-STAT  TO CON-WORD
               MOVE "READ    " TO DB-FUNC
               MOVE "PER-PERSONNEL" TO DB-FILE
               MOVE DB-ERROR   TO MESSAGE-BUFFER
               MOVE MESSAGE-BUFFER TO ERRMSGS
               MOVE TRUE-VAL   TO IND(99)
               GO TO 63-SHOWFORM.

           MOVE 1              TO CC-SW.
           MOVE S-CC-BUF       TO S-CC-DISP.
           MOVE SPACES         TO S-CC-BUF.
           MOVE PER-EMP-NAME   TO S-NAME-BUF.
           PERFORM 63-GET-S-WO-DATA THRU 63-GWD-EXIT.
           GO TO 63-SHOWFORM.

       63-RESET-FORM.
           MOVE "VCURRWOS"     TO SCREEN-NAME.

       63-SPEC-DISP-EXIT.    EXIT.

       63-GET-S-WO-DATA.
           MOVE SPACES         TO S-WO-DATA.
           MOVE S-CC-DISP      TO PERCCNUM OF LABOR-CURRENT-STAT.
           START LABOR-CURRENT-STAT
                               KEY = PERCCNUM OF LABOR-CURRENT-STAT
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
      ************************************************************
      ****  MESSAGE:
      ****  CRAFTSMAN NOT CURRENTLY ASSIGNED TO A WORKORDER
      ************************************************************
               MOVE  29        TO CATREAD-MSG-SET
               MOVE  64        TO CATREAD-MSG-NUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER TO S-DESC-A-BUF
               GO TO 63-GWD-EXIT.

           READ LABOR-CURRENT-STAT NEXT INTO LABOR-CURR-STAT
               AT END          MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
               IF FILE-STAT = "10" OR "14" OR "46"
      ************************************************************
      ****  MESSAGE:
      ****  CRAFTSMAN NOT CURRENTLY ASSIGNED TO A WORKORDER
      ************************************************************
                   MOVE  29        TO CATREAD-MSG-SET
                   MOVE  64        TO CATREAD-MSG-NUM
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE MESSAGE-BUFFER TO S-DESC-A-BUF
                   GO TO 63-GWD-EXIT
               ELSE
                   MOVE FILE-STAT  TO CON-WORD
                   MOVE "READ    " TO DB-FUNC
                   MOVE "LABOR-CURRENT-STAT" TO DB-FILE
                   MOVE DB-ERROR   TO MESSAGE-BUFFER
                   GO TO 63-SHOWFORM.

           IF S-CC-DISP NOT = LCS-EMPL-NUM
      ************************************************************
      ****  MESSAGE:
      ****  CRAFTSMAN NOT CURRENTLY ASSIGNED TO A WORKORDER
      ************************************************************
               MOVE  29        TO CATREAD-MSG-SET
               MOVE  64        TO CATREAD-MSG-NUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER TO S-DESC-A-BUF
               GO TO 63-GWD-EXIT.

           MOVE LCS-WO-NUM     TO WONUM OF WO-BASIC
                                  WONUM OF WO-PLANNED.
           START WO-BASIC      KEY = WONUM OF WO-BASIC
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT = "00"
               IF LCS-WO-NUM = WONUM OF WO-BASIC
                   GO TO READ-BASIC.

           START WO-PLANNED    KEY = WONUM OF WO-PLANNED
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT = "00"
               IF LCS-WO-NUM = WONUM OF WO-PLANNED
                   GO TO READ-PLANNED.

      ************************************************************
      ****  MESSAGE:
      ****  CRAFTSMAN NOT CURRENTLY ASSIGNED TO A WORKORDER
      ************************************************************
           MOVE  29            TO CATREAD-MSG-SET.
           MOVE  64            TO CATREAD-MSG-NUM.
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
           MOVE MESSAGE-BUFFER TO S-DESC-A-BUF.
           GO TO 63-GWD-EXIT.

       READ-BASIC.
           READ WO-BASIC       INTO WO-BASIC-DATA
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = ZEROS
               MOVE FILE-STAT  TO CON-WORD
               MOVE "READ    " TO DB-FUNC
               MOVE "WO-BASIC" TO DB-FILE
               MOVE DB-ERROR   TO MESSAGE-BUFFER
               MOVE MESSAGE-BUFFER TO ERRMSGS
               MOVE TRUE-VAL   TO IND(99)
               GO TO 63-GWD-EXIT.

           GO TO CONT-PROC.

       READ-PLANNED.
           READ WO-PLANNED     INTO WO-PLANNED-DATA
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = ZEROS
               MOVE FILE-STAT  TO CON-WORD
               MOVE "READ    " TO DB-FUNC
               MOVE "WO-PLANNED" TO DB-FILE
               MOVE DB-ERROR   TO MESSAGE-BUFFER
               MOVE MESSAGE-BUFFER TO ERRMSGS
               MOVE TRUE-VAL   TO IND(99)
               GO TO 63-GWD-EXIT.

           MOVE SPACES             TO WO-BASIC-DATA.
           MOVE "*"                TO S-WO-FILE-SW.
           MOVE WO-NUM-PLANNED     TO WO-NUM.
           MOVE EQUIP-NUM-P        TO EQUIP-NUM.
           MOVE LOCATION-P         TO LOCATION.
           MOVE DESCRIPTION-1-P    TO DESCRIPTION-1.
           MOVE DESCRIPTION-2-1-P  TO DESCRIPTION-2-1.
           MOVE DESCRIPTION-2-2-P  TO DESCRIPTION-2-2.

       CONT-PROC.
           MOVE WO-NUM             TO S-WO-NUM-BUF.
           MOVE EQUIP-NUM          TO S-EQUIP-BUF.
           MOVE LOCATION           TO S-LOC-BUF.
           MOVE DESCRIPTION-1      TO S-DESC-BUF.
           MOVE DESCRIPTION-2-1    TO S-DESC-A-BUF.
           MOVE DESCRIPTION-2-2    TO S-DESC-B-BUF.

       63-GWD-EXIT.    EXIT.

       999-CATREAD.
           MOVE SPACES         TO MESSAGE-BUFFER.
           CALL "CCATREAD" USING CATREAD-PARMS.
           MOVE CATREAD-MSG-TEXT TO MESSAGE-BUFFER.

       999-CATREAD-EXIT.    EXIT.

       SORT-IN-PROC SECTION 02.
           OPEN INPUT          PER-MASTER.
           PERFORM SORT-MAIN THRU SORT-M-EXIT.
           CLOSE               PER-MASTER.
           GO TO SORT-IP-EXIT.

       SORT-MAIN.
           MOVE SPACES         TO SORT-REC.
           READ PER-MASTER     INTO WO-PERS-DATA
               AT END GO TO SORT-M-EXIT.
           IF FILE-STAT-1 = "2"
               GO TO SORT-M-EXIT
           ELSE
           IF FILE-STAT NOT = "00"
               MOVE FILE-STAT  TO CON-WORD
               MOVE "READ    " TO DB-FUNC
               MOVE "PER-MASTER" TO DB-FILE
               DISPLAY DB-ERROR
               GO TO SORT-M-EXIT.

           IF PER-CRAFT = "SS" OR "FL"
               GO TO SORT-MAIN.

           IF PER-TEMP-ZONE = SPACES
               IF ZONE-FIELD = PER-MAINT-ZONE
                   NEXT SENTENCE
               ELSE
                   GO TO SORT-MAIN
           ELSE
               IF ZONE-FIELD = PER-TEMP-ZONE
                   MOVE "+"    TO SORT-TEMP-FLAG
               ELSE
                   GO TO SORT-MAIN.

           MOVE PER-SHIFT-CREW TO SC-BUFFER.

           IF CREW-PARM = 0
               IF SHIFT-BUFFER NOT = CURR-SHIFT-X
                   GO TO SORT-MAIN
               ELSE
                   NEXT SENTENCE
           ELSE
               IF CREW-BUFFER NOT = CREW-FIELD
                   GO TO SORT-MAIN.

           MOVE PER-CC-NUM     TO SORT-CC-NUM.
           MOVE PER-EMP-NAME   TO SORT-CC-NAME.
           PERFORM SORT-DBGET THRU SORT-DBGET-EXIT.
           RELEASE SORT-REC.
           GO TO SORT-MAIN.

       SORT-M-EXIT.    EXIT.

       SORT-DBGET.
           MOVE PER-CC-NUM     TO PERCCNUM OF LABOR-CURRENT-STAT.
           START LABOR-CURRENT-STAT
                               KEY = PERCCNUM OF LABOR-CURRENT-STAT
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
             IF FILE-STAT-1 = "2"
                 GO TO SORT-DBGET-EXIT
               ELSE
                 MOVE FILE-STAT  TO CON-WORD
                 MOVE "START   " TO DB-FUNC
                 MOVE "LABOR-CURRENT-STAT" TO DB-FILE
                 DISPLAY DB-ERROR
                 GO TO SORT-M-EXIT.

           READ LABOR-CURRENT-STAT NEXT INTO LABOR-CURR-STAT
               AT END          MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
               IF FILE-STAT = "10" OR "14" OR "46"
                   GO TO SORT-DBGET-EXIT
               ELSE
                   MOVE FILE-STAT  TO CON-WORD
                   MOVE "READ    " TO DB-FUNC
                   MOVE "LABOR-CURRENT-STAT" TO DB-FILE
                   DISPLAY DB-ERROR
                   GO TO SORT-M-EXIT.

           IF PER-CC-NUM NOT = LCS-EMPL-NUM
               GO TO SORT-DBGET-EXIT.

           MOVE LCS-WO-NUM     TO WONUM OF WO-BASIC
                                  WONUM OF WO-PLANNED.
           START WO-BASIC      KEY = WONUM OF WO-BASIC
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT = ZEROS
               IF LCS-WO-NUM = WONUM OF WO-BASIC
                   GO TO SORT-READ-BASIC.

           START WO-PLANNED    KEY = WONUM OF WO-PLANNED
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT = ZEROS
               IF LCS-WO-NUM = WONUM OF WO-PLANNED
                   GO TO SORT-READ-PLANNED.

           MOVE FILE-STAT      TO CON-WORD.
           MOVE "START   "     TO DB-FUNC.
           MOVE "WORKORDER"    TO DB-FILE.
           DISPLAY DB-ERROR.
           GO TO SORT-M-EXIT.

       SORT-READ-BASIC.
           READ WO-BASIC       INTO WO-BASIC-DATA
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = ZEROS
               MOVE FILE-STAT  TO CON-WORD
               MOVE "READ    " TO DB-FUNC
               MOVE "WO-BASIC" TO DB-FILE
               DISPLAY DB-ERROR
               GO TO SORT-M-EXIT.

           GO TO SORT-CONT-PROC.

       SORT-READ-PLANNED.
           READ WO-PLANNED     INTO WO-PLANNED-DATA
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = ZEROS
               MOVE FILE-STAT  TO CON-WORD
               MOVE "READ    " TO DB-FUNC
               MOVE "WO-PLANNED" TO DB-FILE
               DISPLAY DB-ERROR
               GO TO SORT-M-EXIT.

           MOVE "*"                TO SORT-WO-TYPE.
           MOVE WO-NUM-PLANNED     TO SORT-WO-NUM.
           MOVE EQUIP-NUM-P        TO SORT-EQUIP.
           MOVE LOCATION-P         TO SORT-LOCATION.
           MOVE DESCRIPTION-1-P    TO SORT-DESCRIPT.
           GO TO SORT-DBGET-EXIT.

       SORT-CONT-PROC.
           MOVE WO-NUM         TO  SORT-WO-NUM.
           MOVE EQUIP-NUM      TO  SORT-EQUIP.
           MOVE LOCATION       TO  SORT-LOCATION.
           MOVE DESCRIPTION-1  TO  SORT-DESCRIPT.

       SORT-DBGET-EXIT.    EXIT.

       SORT-IP-EXIT.    EXIT.

       SORT-OUT-PROC SECTION 03.
           OPEN OUTPUT         OUT-FILE.
           PERFORM SORT-READ-LOOP THRU SRL-EXIT.
           CLOSE               OUT-FILE.
           GO TO SORT-OP-EXIT.

       SORT-READ-LOOP.
           RETURN SORT-FILE AT END
               MOVE ACT-KEY    TO MAX-KEY
               GO TO SRL-EXIT.
           ADD 1               TO ACT-KEY.
           MOVE SORT-REC       TO OUT-REC.
           WRITE OUT-REC INVALID KEY
               DISPLAY "WRITE OUT-FILE ERR"
               GO TO SRL-EXIT.
           GO TO SORT-READ-LOOP.

       SRL-EXIT.    EXIT.

       SORT-OP-EXIT.    EXIT.

