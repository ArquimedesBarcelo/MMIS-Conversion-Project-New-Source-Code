       IDENTIFICATION DIVISION.
       PROGRAM-ID.             TSCURRWO.
       AUTHOR.                 W. ROXBURY.
       INSTALLATION.           GOODYEAR TIRE & RUBBER CO.
      *REMARKS. IF THE SUPERVISOR's FUNCTIONS PROGRAM 'TSUPEXCREW'
      *               IS RUN, THIS PROGRAM WILL DISPLAY
      *               PERSONNEL ASSIGNED TO THIS ZONE FROM A CREW
      *               DESIGNATION ENTERED THE FIRST TIME THE
      *               FUNNCTION IS EXECUTED.
       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.
       SOURCE-COMPUTER.        AS-400.
       OBJECT-COMPUTER.        AS-400.
       SPECIAL-NAMES.          I-O-FEEDBACK     IS I-O-FEEDBACK-AREA
                               REQUESTOR        IS WORK-STATION
                               SYSTEM-CONSOLE   IS CONSOLE
                               LOCAL-DATA       IS LOCAL-DATA-AREA.

       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT LABOR-CURRENT-STAT
                  ASSIGN       TO DATABASE-MCFLMM1601
                  ORGANIZATION IS INDEXED
                  ACCESS MODE  IS DYNAMIC
                  RECORD KEY   IS EXTERNALLY-DESCRIBED-KEY
                               WITH DUPLICATES
                  FILE STATUS  IS FILE-STAT.

           SELECT PER-PERSONNEL
                  ASSIGN       TO DATABASE-MCFLMM0301
                  ORGANIZATION IS INDEXED
                  ACCESS MODE  IS DYNAMIC
                  RECORD KEY   IS EXTERNALLY-DESCRIBED-KEY
                  FILE STATUS  IS FILE-STAT.

           SELECT PER-MASTER
                  ASSIGN       TO DATABASE-MCFPMM0300
                  ORGANIZATION IS SEQUENTIAL
                  ACCESS MODE  IS SEQUENTIAL
                  FILE STATUS  IS FILE-STAT.

           SELECT WO-BASIC
                  ASSIGN       TO DATABASE-MCFLMM1001
                  ORGANIZATION IS INDEXED
                  ACCESS MODE  IS DYNAMIC
                  RECORD KEY   IS EXTERNALLY-DESCRIBED-KEY
                               WITH DUPLICATES
                  FILE STATUS  IS FILE-STAT.

           SELECT WO-PLANNED
                  ASSIGN       TO DATABASE-MCFLMM1101
                  ORGANIZATION IS INDEXED
                  ACCESS MODE  IS DYNAMIC
                  RECORD KEY   IS EXTERNALLY-DESCRIBED-KEY
                               WITH DUPLICATES
                  FILE STATUS  IS FILE-STAT.

           SELECT WO-ZONE-PRTY
                  ASSIGN       TO DATABASE-MCFLMM0501
                  ORGANIZATION IS INDEXED
                  ACCESS MODE  IS DYNAMIC
                  RECORD KEY   IS EXTERNALLY-DESCRIBED-KEY
                  FILE STATUS  IS FILE-STAT.

           SELECT PER-CREW-MSTR
                  ASSIGN       TO DATABASE-MCFLMM3401
                  ORGANIZATION IS INDEXED
                  ACCESS MODE  IS DYNAMIC
                  RECORD KEY   IS EXTERNALLY-DESCRIBED-KEY
                  FILE STATUS  IS FILE-STAT.

           SELECT DISPLAY-FILE
                  ASSIGN       TO WORKSTATION-ZCORLESS-SI
                  ORGANIZATION IS TRANSACTION
                  ACCESS MODE  IS SEQUENTIAL
                  FILE STATUS  IS SCREEN-STATUS
                               MAJOR-MINOR
                  CONTROL-AREA IS SCREEN-CONTROL.

           SELECT DISPLAY-FILE-2
                  ASSIGN       TO WORKSTATION-ZGETSCRNS-SI
                  ORGANIZATION IS TRANSACTION
                  ACCESS MODE  IS SEQUENTIAL
                  FILE STATUS  IS SCREEN-STATUS
                               MAJOR-MINOR
                  CONTROL-AREA IS SCREEN-CONTROL.

           SELECT OUT-FILE
                  ASSIGN       TO DISK-SCURRWO
                  ORGANIZATION IS RELATIVE
                  ACCESS MODE  IS DYNAMIC
                  RELATIVE KEY IS ACT-KEY
                  FILE STATUS  IS FILE-STAT.

           SELECT SORT-FILE
                  ASSIGN       TO DISK-SORTFILE.

       DATA DIVISION.
       FILE SECTION.
       FD  LABOR-CURRENT-STAT
           LABEL RECORDS ARE STANDARD.
       01  LS-REC.
           COPY DDS-ALL-FORMATS OF MCFLMM1601.

       FD  PER-PERSONNEL
           LABEL RECORDS ARE STANDARD.
       01  PP-REC.
           COPY DDS-ALL-FORMATS OF MCFLMM0301.

       FD  PER-MASTER
           LABEL RECORDS ARE STANDARD.
       01  PM-REC.
           COPY DDS-ALL-FORMATS OF MCFPMM0300.

       FD  WO-BASIC
           LABEL RECORDS ARE STANDARD.
       01  VWO-REC.
           COPY DDS-ALL-FORMATS OF MCFLMM1001.

       FD  WO-PLANNED
           LABEL RECORDS ARE STANDARD.
       01  PWO-REC.
           COPY DDS-ALL-FORMATS OF MCFLMM1101.

       FD  WO-ZONE-PRTY
           LABEL RECORDS ARE STANDARD.
       01  ZP-REC.
           COPY DDS-ALL-FORMATS OF MCFLMM0501.

       FD  PER-CREW-MSTR
           LABEL RECORDS ARE STANDARD.
       01  CRW-REC.
           COPY DDS-ALL-FORMATS OF MCFLMM3401.

       FD  DISPLAY-FILE
           LABEL RECORDS ARE OMITTED.
       01  DISPLAY-REC         PIC X(2000).

       FD  DISPLAY-FILE-2
           LABEL RECORDS ARE OMITTED.
       01  DISPLAY-REC-2       PIC X(2000).

       FD  OUT-FILE RECORD CONTAINS 74 CHARACTERS
           LABEL RECORDS ARE OMITTED
           DATA RECORD IS OUT-REC.
       01  OUT-REC.
           05  OUT-TEMP-FLAG   PIC X.
           05  OUT-CC-NUM      PIC XXXX.
           05  OUT-CC-NAME     PIC X(16).
           05  OUT-WO-TYPE     PIC X.
           05  OUT-WO-NUM      PIC X(10).
           05  OUT-EQUIP       PIC X(06).
           05  OUT-LOCATION    PIC X(08).
           05  OUT-DESCRIPT    PIC X(28).

       SD  SORT-FILE RECORD CONTAINS 74 CHARACTERS
           DATA RECORD IS SORT-REC.
       01  SORT-REC.
           05  SORT-TEMP-FLAG  PIC X.
           05  SORT-CC-NUM     PIC XXXX.
           05  SORT-CC-NAME    PIC X(16).
           05  SORT-WO-TYPE    PIC X.
           05  SORT-WO-NUM     PIC X(10).
           05  SORT-EQUIP      PIC X(06).
           05  SORT-LOCATION   PIC X(08).
           05  SORT-DESCRIPT   PIC X(28).

       WORKING-STORAGE SECTION.
       77  ACT-KEY             PIC 9999         VALUE 0.
       77  MAX-KEY             PIC 9999         VALUE 0.
       77  SAVE-KEY            PIC 9999         VALUE 0.
       77  EOF-SW              PIC 9            VALUE 0.
       77  AUTOQ-SW            PIC X            VALUE "Q".
       77  CC-SW               PIC S9(4) BINARY VALUE 0.
       77  CREW-PARM           PIC S9(4) BINARY VALUE 0.
       77  TRUE-VAL            PIC 1            VALUE B"1".
       77  FILE-SW             PIC X            VALUE "B".
       77  FFLAG               PIC X            VALUE " ".
       77  CNUM-BUFFER         PIC X(20)        VALUE SPACES.
       77  DWO-BUFFER          PIC X(10)        VALUE SPACES.
       77  SCREEN-SAVE         PIC X(1400)      VALUE SPACES.
       77  FUNCTION-SW         PIC  9(4)        VALUE 0.
       77  RESERVATIONS        PIC  9(4)        VALUE 0.
       77  QUEUE-RECORDS       PIC X(280)       VALUE SPACES.

       01  FILE-STAT.
           05 FILE-STAT-1      PIC X            VALUE "0".
           05 FILE-STAT-2      PIC X            VALUE "0".

       01  PASSWORD-INFORMATION.
           05  NAME-OF-PROGRAM     PIC X(08) VALUE "TSCURRWO".
           05  PROGRAM-TYPE        PIC X(02) VALUE "IN".
           05  PROGRAM-RELEASE     PIC X(12) VALUE " E0100010001".
           05  PROGRAM-DESCRIPTION.
               10  PROG-DESC-A1    PIC X(30) VALUE
                   "ALLOWS THE SUPERVISOR TO INQUI".
               10  PROG-DESC-A2    PIC X(30) VALUE
                   "RE CLOCK-CARD NUMBERS FOR HIS ".
               10  PROG-DESC-B1    PIC X(30) VALUE
                   "ZONE AND DETERMINE IF THE CRAF".
               10  PROG-DESC-B2    PIC X(30) VALUE
                   "TSMAN IS IP ON A WORKORDER.   ".
               10  PROG-FUNCTION1  PIC X(30) VALUE
                   "RUNS FROM f5 KEY OF SUPERVISOR".
               10  PROG-FUNCTION2  PIC X(30) VALUE
                   " FUNCTIONS MENU.              ".
           05  PASSWORD-FLAG       PIC X.

