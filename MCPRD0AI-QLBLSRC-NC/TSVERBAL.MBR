000200 IDENTIFICATION DIVISION.
000300 PROGRAM-ID.  TSVERBAL.
000500 INSTALLATION.  GOODYEAR.
000700*REMARKS.       THIS PROGRAM SUBMITS AN OFFLINE JOB  THAT
000800*               CREATES A HARD COPY REPORT LISTING VERBAL
000900*               WORK ORDERS THAT HAVE REACHED A CERTAIN %
001000*               OF THEIR MAXIMUM COST.
001100*               IT ALSO CALLS A PROGRAM THAT DISPLAYS THIS
001200*               PERCENT FOR A PARTICULAR WORK ORDER NUMBER.
      *C
      *C 02/27/97  JEFF BUNGO
      *C   READ IN JOBD FROM MCFPMMJOBD.
      *C
001500 ENVIRONMENT DIVISION.
001600 CONFIGURATION SECTION.
001700 SOURCE-COMPUTER.   AS400.
001800 OBJECT-COMPUTER.   AS400.
       COPY SPECIALN IN COPYLIB.
001900 INPUT-OUTPUT SECTION.
002000 FILE-CONTROL.
           SELECT DISPLAY-FILE
               ASSIGN TO WORKSTATION-ZREPORT-SI
               ORGANIZATION IS TRANSACTION
               ACCESS IS SEQUENTIAL
               FILE STATUS IS DSPLY-STATUS
               CONTROL-AREA IS WS-CONTROL.
           SELECT PLANT-JOBD-FILE ASSIGN TO DATABASE-MCFPMMJOBD.
002300 DATA DIVISION.
002400 FILE SECTION.
       FD  DISPLAY-FILE
           LABEL RECORDS ARE OMITTED.
       01  DSPLY-REC               PIC X(2000).
       FD  PLANT-JOBD-FILE
           RECORD CONTAINS 10 CHARACTERS.
       01  PLANT-JOBD              PIC X(10).
003600 WORKING-STORAGE SECTION.
       COPY CATREAD OF COPYLIB.
       COPY CPYIND  OF COPYLIB.
005000 01  DBPARAMETERS.              COPY DBPARMS OF COPYLIB.
       01  DSPLY-STATUS               PIC XX.
006100 01  HD-ROUTE-DATA.
006200     05 HD-NAME                 PIC X(15).
006300     05 HD-DEPT                 PIC X(4).
006400     05 HD-SPOOLER-NUM          PIC 9(3).
006500     05 HD-USER                 PIC X(8).
006600     05 HD-ACCOUNT              PIC X(8).
006700     05 HD-GROUP                PIC X(8).
006800     05 HD-TERM                 PIC X(4).
006900     05 HD-PAPER-FLAG           PIC X.
007100     05 HD-PRTRPT-FLAG          PIC X.
007200     05 FILLER                  PIC X(28).
       COPY IOFEEDBACK IN COPYLIB.
       COPY LANGSUB OF COPYLIB.
       01  LINK-DATA.
           05  LINK-50                PIC X(50).
           05  LINK-80                PIC X(80).
           05  FILLER                 PIC X(70).
008200 01  MISC-BUFFER                PIC X(80) VALUE SPACES.
009000 01  ROUTE-FIELDS.
009100     05  R-NAME                 PIC X(15).
009200     05  R-DEPT                 PIC X(4).
009300     05  R-PRINTER              PIC 9(3).
009400     05  R-PAPER-FLAG           PIC X.
           05  R-CMD-LINE             PIC X(79).
           05  R-ERR-LINE             PIC X(79).
       COPY DBSTAT OF COPYLIB.
010200 01  STATUS-CHECK               PIC X VALUE "O".
       01  SUBMIT-PGM                 PIC X(10).
       01  SUBMIT-PARM                PIC X(200).
       01  SUBMIT-JOB                 PIC X(10).
       01  SUBMIT-JOBD                PIC X(10).
       01  SUBMIT-OUTQ                PIC X(10).
       01  SUBMIT-USER                PIC X(10).
010400 01  TERM-BUFFER.
           05  TERM-INFO.
010500         10  PERCENT-B          PIC X(2).
010600         10  MAXIMUM-B          PIC X(16).
010700         10  EQPNUM-B           PIC X(6).
010800         10  DEPT-B             PIC X(4).
010900         10  ZONE-B             PIC X(4).
011000         10  EXPCLASS-B         PIC X(8).
011100         10  WONUM-B            PIC X(10).
           05  TERM-CMD-LINE          PIC X(79).
           05  TERM-ERR-LINE          PIC X(79).
       01  TRUE-VAL                   PIC 1 VALUE B"1".
       COPY VCOMLINK OF COPYLIB.
011500 01  WHO-VARIABLES.
011600     05  MOD                    PIC S9(4) COMP-4.
011700     05  CAP                    PIC S9(8) COMP-4.
011800     05  LATTR                  PIC S9(8) COMP-4.
011900     05  USERNAME               PIC X(8).
012000     05  GRPNAME                PIC X(8).
012100     05  ACCTNAME               PIC X(8).
012200     05  HOMEGRP                PIC X(8).
012300     05  TNUM                   PIC 99 COMP-4.
012400     05  FILLER                 PIC X(2).
       COPY WSCONTROL IN COPYLIB.
012700 PROCEDURE DIVISION.
012800 BEGIN-PAR.
           PERFORM 1-HSK.
           PERFORM 6-MAIN THRU 6-MAIN-EXIT.
       2-EOJ.
           CLOSE DISPLAY-FILE.
           GOBACK.
       1-HSK.
           OPEN I-O    DISPLAY-FILE.
           MOVE SPACES TO TERM-BUFFER.
           CALL "WHO" USING MOD CAP LATTR USERNAME GRPNAME
                        ACCTNAME HOMEGRP TNUM.
           OPEN INPUT PLANT-JOBD-FILE.
           READ PLANT-JOBD-FILE NEXT.
           CLOSE PLANT-JOBD-FILE.
       6-MAIN.
           IF INDS (99) = TRUE-VAL
               MOVE MISC-BUFFER TO TERM-ERR-LINE
           ELSE
           MOVE SPACES TO TERM-ERR-LINE.
017400     MOVE "PERCENTG" TO VIEW-CFNAME.
           MOVE TERM-BUFFER TO DSPLY-REC.
           PERFORM 99-SCREEN-WRITE.
           PERFORM 98-SCREEN-READ.
020500     IF VIEW-LASTKEY = 3 GO TO 2-EOJ.
           MOVE DSPLY-REC TO TERM-BUFFER.
023200     IF PERCENT-B = SPACES
023300         IF WONUM-B = SPACES
023400             MOVE TRUE-VAL TO INDS (1) INDS (99)
023600             MOVE 42021 TO CATREAD-MSG-NUMBER
023800             PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
024300             GO TO 6-MAIN.
           IF MAXIMUM-B = SPACES
               MOVE TRUE-VAL TO INDS (2) INDS (99)
               MOVE 66359 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               GO TO 6-MAIN.
024400     IF WONUM-B = SPACES
032600         MOVE SPACES TO ROUTE-FIELDS HD-ROUTE-DATA
024600         MOVE "ROUTE" TO VIEW-CFNAME
               MOVE ROUTE-FIELDS TO DSPLY-REC
025300         PERFORM 99-SCREEN-WRITE
               PERFORM 98-SCREEN-READ
               MOVE DSPLY-REC TO ROUTE-FIELDS
032900         MOVE R-NAME TO HD-NAME
033000         MOVE R-DEPT TO HD-DEPT
033100         MOVE R-PAPER-FLAG TO HD-PAPER-FLAG
035000         MOVE USERNAME TO HD-USER
035100         MOVE ACCTNAME TO HD-ACCOUNT
035200         MOVE GRPNAME TO HD-GROUP
035300         MOVE TNUM TO HD-TERM
025400         PERFORM SUBMIT-VERBAL
025500     ELSE
025600     CALL "TVERBALD" USING WONUM-B STATUS-CHECK MISC-BUFFER
025700                           VIEW-COMAREA  DBPARAMETERS
025800                           LANGUAGE-PARMS MAXIMUM-B
025900     IF STATUS-CHECK = "E"
026000         NEXT SENTENCE
026100     ELSE
026200     IF STATUS-CHECK = "O"
026300         MOVE "PERCENTG" TO VIEW-CFNAME
               MOVE SPACES TO TERM-BUFFER
027000         GO TO 6-MAIN
027100     ELSE
027200     IF STATUS-CHECK = "D"
               MOVE TRUE-VAL TO INDS (7) INDS (99)
               GO TO 6-MAIN.
027700 6-MAIN-EXIT.    EXIT.
035400
035600 SUBMIT-VERBAL.
           MOVE "CLSVERBAL"   TO  SUBMIT-PGM.
           MOVE SPACES        TO  LINK-DATA.
           MOVE TERM-INFO     TO  LINK-50.
           MOVE HD-ROUTE-DATA TO  LINK-80.
           MOVE LINK-DATA     TO  SUBMIT-PARM.
           MOVE "TSVERBAL"    TO  SUBMIT-JOB.
           MOVE PLANT-JOBD    TO  SUBMIT-JOBD.
           MOVE "*JOBD"       TO  SUBMIT-OUTQ.
           MOVE "*JOBD"       TO  SUBMIT-USER.
           CALL "CLSUBMIT"  USING SUBMIT-PGM
                                  SUBMIT-PARM
                                  SUBMIT-JOB
                                  SUBMIT-JOBD
                                  SUBMIT-OUTQ
                                  SUBMIT-USER.

       98-SCREEN-READ.
           READ DISPLAY-FILE FORMAT IS VIEW-CFNAME
               INDIC IS INDICS.
           ACCEPT IOFEEDBACK FROM I-O-FEEDBACK-AREA.
           MOVE ALL B"0" TO INDICS.
           IF DSPLY-STATUS NOT = "00"
               MOVE 3 TO VIEW-LASTKEY
           ELSE
           MOVE FUNCTION-NUM TO VIEW-LASTKEY.

       99-SCREEN-WRITE.
           WRITE DSPLY-REC FORMAT IS VIEW-CFNAME
               INDIC IS INDICS.
           MOVE ALL B"0" TO INDICS.

040400 999-CATREAD.
040500     MOVE SPACES TO MISC-BUFFER.
           CALL "CCATREAD" USING CATREAD-PARMS.
           MOVE CATREAD-MSG-TEXT TO MISC-BUFFER.
041800 999-CATREAD-EXIT.    EXIT.
