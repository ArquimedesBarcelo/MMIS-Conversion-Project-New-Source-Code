040500*********************************************
040600*                                           *
040700*  OPEN ALL FILES & DATA BASE               *
040800*                                           *
040900*********************************************
041000
041100 1-HSK.
           DISPLAY "********* REQUISITION R/3 EXTRACT **********".
           DISPLAY "WHAT TYPE OF RECORDS SHOULD BE EXTRACTED?   ".
           DISPLAY "   A  - CORPORATE PURCHASING                ".
           DISPLAY "   R3 - SYNERGY R3                          ".
      **** ACCEPT PROC-REQS-IND.
           DISPLAY "PROC REQS IND ACCEPTED = " PROC-REQS-IND.
           IF PROC-REQS-IND = "A "
               OPEN OUTPUT CORP-FIL2.
           IF PROC-REQS-IND = "R3"
               OPEN OUTPUT R3FILE.
           OPEN I-O    DDAILYTC.
           OPEN INPUT  DREQDESC-I.
           OPEN INPUT  DREQITM-I.
           OPEN INPUT  MBUYER-I.
           OPEN I-O    MCORPREQ-O.
           OPEN INPUT  MPLTINFO-I.
           OPEN I-O    MPLTINFO-O.
           OPEN INPUT  MREQ-I.
           OPEN INPUT  MSTORERM-I.
041200     OPEN OUTPUT REQ-REPORT.
           OPEN INPUT  DPOITEM-I.

042500**********************************************
042600*                                            *
042700*    DO DBGET MPLTINFO WITH  "P 01" =        *
042800*    PLTINFO-KEY TO GET PLANT CODE TO        *
042900*    PRINT ON THE PAGE HEADINGS              *
043000*                                            *
043100**********************************************
043200
043300     MOVE "P 01"         TO  PLT-ARG.
           MOVE 0              TO  COND-WORD.
           MOVE PLT-ARG TO PLTINFOKEY OF MPLTINFO-REC-I.
           READ MPLTINFO-I INTO BUF-MPLTINFO INVALID KEY
                MOVE 17 TO COND-WORD.
           IF FILE-STATUS-1 = "2"
               MOVE 17 TO COND-WORD
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD.
043600     IF COND-WORD NOT = ZERO
043700         MOVE "GET MPLTINFO*1-HSK" TO BU-DISPLAY-MSG
043800         MOVE PLT-ARG              TO BU-DISPLAY-FLD (2)
043900         GO TO 2-BLOWUP.
044000     MOVE MPLTINFO-COMPANY  TO  COMPANY-SAVE.
044100     MOVE MPLTINFO-PRIME    TO  PRIME-SAVE.
044200
044300*********************************************
044400*                                           *
044500*  RETRIEVE THAT TRANSMISSION SEQUENCE      *
044600*  MAINTAINED IN RECORD KEY 'CREQ'.         *
044700*                                           *
044800*********************************************
044900
045000     MOVE "CREQ"         TO  PLT-ARG.
           MOVE 0              TO  COND-WORD.
           MOVE PLT-ARG TO PLTINFOKEY OF MPLTINFO-REC-I.
           READ MPLTINFO-I INTO BUF-MPLTINFO INVALID KEY
                MOVE 17 TO COND-WORD.
           IF FILE-STATUS-1 = "2"
               MOVE 17 TO COND-WORD
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD.
045300     IF COND-WORD NOT = ZERO
045400         MOVE SPACES             TO  MPLTINFO-DATA
045500         MOVE "CREQ"             TO  MPLTINFO-KEY
045600                                     PLT-ARG
045700         MOVE ZEROES             TO  MPLTINFO-CREQ-SEQ
046000         WRITE MPLTINFO-REC-O FROM BUF-MPLTINFO
               READ MPLTINFO-I INTO BUF-MPLTINFO
046800     ELSE
046900     MOVE MPLTINFO-CREQ-SEQ      TO  SAVE-SEQ-NO.
047000
047100**********************************************
047200*                                            *
047300*   CALL TDATECHK FOR TODAYS DATE & TIME     *
047400*                                            *
047500**********************************************
047600     MOVE 1                          TO  DATE-MODE.
047700     CALL "TDATECHK" USING DATE-CHECK-AREA.
047800     MOVE DATE-SLASH-OUT             TO  PRT-DATE.
047900     MOVE DATE-FORMATTED-TIME-OUT    TO  PRT-TIME,
                                               TIME-SAVE.
048000     MOVE DATE-YMD-OUT               TO  CUR-DATE.
048100
048200**************************************************
048300*                                                *
048400*   COMPUTE TODAYS JULIAN DATE TO BE USED LATER  *
048500*   WHEN COMPUTING DATE WANTED                   *
048600*                                                *
048700**************************************************
048800
048900     MOVE YY-9            TO  GREG-YY.
049000     MOVE MM-9            TO  GREG-MM.
049100     MOVE DD-9            TO  GREG-DD.
049200     IF GREG-YY > "70"
               MOVE "19"        TO  GREG-CC
           ELSE
           MOVE "20"            TO  GREG-CC.
           MOVE SPACES          TO  JULIAN-DATE.
           CALL "JULGREG" USING GREG-DATE, JULIAN-DATE,
                            DAY-DIGIT, LEAP-YEAR-FLAG.
049800     MOVE JULIAN-DATE-9   TO  TODAYS-JULIAN.
049900
050000     PERFORM 621-REPORT-HDR THRU 621-R-H-X.
050100     PERFORM 621-PAGE-HDR  THRU  621-P-H-X.
050200 1-H-X.
050300     EXIT.
050400
050500 2-EOJ.
           IF PROC-REQS-IND = "A "
               CLOSE CORP-FIL2.
           CLOSE DDAILYTC.
           CLOSE DREQDESC-I.
           CLOSE DREQITM-I.
           CLOSE MCORPREQ-O.
           CLOSE MPLTINFO-I.
           CLOSE MPLTINFO-O.
           CLOSE MREQ-I.
041200     CLOSE REQ-REPORT.
           CLOSE DPOITEM-I.
050700
051700 2-EOJ-X.
051800     EXIT.
051900
052000*********************************************
052100*                                           *
052200*  BLOWUP ROUTINE EXECUTES WHENEVER A       *
052300*  FATAL ERROR OCCURS                       *
052400*                                           *
052500*********************************************
052600
052700 2-BLOWUP.
052800     MOVE "TREQABST"              TO  BU-PGM-NAME.
052900     MOVE REQ-ARG                 TO  BU-DISPLAY-FLD (1).
053000     CALL "TBLOWUP" USING BASE, BU-PGM-NAME, STATUS-AREA,
053100         VIEW-COMAREA, DUMMY-KSAM-STAT, BU-DISPLAY-MSG,
053200             BU-DISPLAY-FLDS.
053300
053400 2-BLOWUP-X.
053500     EXIT.
053600
053700***************************
053800*                         *
053900*  M A I N                *
054000*                         *
054100***************************
054200
054300 6-MAIN.
054400     PERFORM 60-READ-MCORPREQ  THRU  60-RM-X.
054500
           IF PROC-REQS-IND = "A "
054600         SORT SORT-FILE ON ASCENDING KEY SORT-REQNO
054700             USING CORP-FIL2
054800             GIVING CORP-FIL2
055000         OPEN INPUT CORP-FIL2
055100         PERFORM 60-READ-REQ-FILE  THRU  60-RRF-X.
054900
           IF PROC-REQS-IND = "R3"
               SORT SORT-FILE ON ASCENDING KEY SORT-REQNO
                   USING R3FILE
                   GIVING R3FILE
               CALL "SR3REQEX".
055200 6-MAIN-X.
055300     EXIT.
055400
055500
055600**************************************************
055700*                                                *
055800*   THIS ROUTINE LOCKS THE MCORPREQ DATA SET SO  *
055900*   THAT NO MORE PROCESSING CAN BE DONE TO IT    *
056000*   AND THEN READS EVERY ENTRY AND WRITES THEM   *
056100*   TO CORPFILE OR R3FILE DEPENDING ON STATUS.   *
      *   IT, THEN, DELETES THE RECORD FROM THE
056200*   MCORPREQ DATA SET.  THIS IS DONE TO INSURE   *
056300*   THAT ALL ENTRIES ARE PROCESSED ONLY ONCE     *
056400*   YET NOT TIE UP THE MCORPREQ DATA SET THE     *
056500*   ENTIRE TIME THIS PROGRAM IS RUNNING.         *
056600*                                                *
056700**************************************************
056800
056900 60-READ-MCORPREQ.
           READ MCORPREQ-O NEXT INTO BUF-MCORPREQ
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14"
                   GO TO 60-CLOSE-CORPFIL2
               ELSE
               MOVE "GET MCORPREQ * 60-RM" TO BU-DISPLAY-MSG
               GO TO 2-BLOWUP.
059600
           IF PROC-REQS-IND = "A "
               IF MCORPREQ-REQ-STATUS = "A "
059700             MOVE SPACES                   TO  CORP-FIL2-RCD
059800             MOVE MCORPREQ-REQ-NUMBER      TO  CORP-FIL2-REQNO
059900             MOVE MCORPREQ-REQ-STATUS      TO  CORP-FIL2-STATUS
060000             WRITE CORP-FIL2-RCD
                   DELETE MCORPREQ-O
                   GO TO 60-READ-MCORPREQ
               ELSE
               IF MCORPREQ-REQ-STATUS = "RL"
                   MOVE SPACES                   TO  CORP-FIL2-RCD
                   MOVE MCORPREQ-REQ-NUMBER      TO  CORP-FIL2-REQNO
                   MOVE MCORPREQ-REQ-STATUS      TO  CORP-FIL2-STATUS
                   MOVE MCORPREQ-RLSE            TO  CORP-FIL2-RLSE
                   WRITE CORP-FIL2-RCD
                   DELETE MCORPREQ-O
                   GO TO 60-READ-MCORPREQ
               ELSE
               GO TO 60-READ-MCORPREQ
           ELSE
           IF PROC-REQS-IND = "R3"
               IF MCORPREQ-REQ-STATUS = "R3"
                   MOVE SPACES                   TO  R3FILE-RCD
                   MOVE MCORPREQ-REQ-NUMBER      TO  R3FILE-REQNO
                   MOVE MCORPREQ-REQ-STATUS      TO  R3FILE-STATUS
                   WRITE R3FILE-RCD
                   DELETE MCORPREQ-O
                   GO TO 60-READ-MCORPREQ
               ELSE
               GO TO 60-READ-MCORPREQ
           ELSE
           GO TO 60-READ-MCORPREQ.

       60-CLOSE-CORPFIL2.
           IF PROC-REQS-IND = "A "
               CLOSE CORP-FIL2.
           IF PROC-REQS-IND = "R3"
               CLOSE R3FILE.
062800
064000 60-RM-X.
064100     EXIT.
064200
064300*********************************************
064400*                                           *
064500*  THIS PROCEDURES READS ALL CODES IN       *
064600*  'CORP-FIL2' AND ABSTRACTS THE REQ        *
064700*  DATA TO THE FILE TO BE TRANSMITTED       *
064800*  TO CORPORATE PURCHASING.                 *
064900*********************************************
065000 60-READ-REQ-FILE.
065100     READ CORP-FIL2 AT END
065200         PERFORM 600-CHECK-FOR-ONE
065300         GO TO 60-RRF-X.
065400
           MOVE CORP-FIL2-REQNO TO SAVE-REQ-NO.
           MOVE 0               TO SAVE-RECORD-SEQ.

065500     ADD 1 TO RECORDS-READ-CTR.
065600     IF RECORDS-READ-CTR = 1
065700         PERFORM 601-SET-CONTROL-RCD THRU 601-SCR-X.
065800
065900     PERFORM 602-ABSTRACT-REQ-DATA THRU 602-ARD-X.
066000
066100     GO TO 60-READ-REQ-FILE.
066200
066300 60-RRF-X.    EXIT.
066400
066500 600-CHECK-FOR-ONE.
066600     IF AT-LEAST-ONE-REQ  =  "N"
066700         MOVE "**  NO REQUISITIONS PROCESSED  **"
066800             TO PRINT-LINE
066900         MOVE 3  TO  PRT-CTL
067000         WRITE PRINT-RCD
067100     ELSE
067200     PERFORM 65-UPDATE-MPLTINFO  THRU  65-U-M-X.
067300
067400 601-SET-CONTROL-RCD.
067500     MOVE SPACES                     TO AKRON-DATA-BUFFER.
067600     MOVE "CSIS REQUISITIONS       " TO CNTRL-HEADER.
      *------ SEQUENCE NUMBER WAS INCREMENTING BY 2, SO THIS ADD STMT.
      *------ WAS COMMENTED OUT.  THE COUNTER IS INCREMENTED LATER IN
      *------ THE PROGRAM.  THE VALUE IN MPLTINFO WILL BE THE NEXT
      *------ SEQUENCE NUMBER TO BE WRITTEN.      11/15/95
067700*    ADD 1                           TO SAVE-SEQ-NO.
067800     MOVE SAVE-SEQ-NO                TO CNTRL-SEQUENCE-NO.
067900     MOVE MM                         TO CTD-MM.
068000     MOVE DD                         TO CTD-DD.
068100     MOVE YY                         TO CTD-YY.
           MOVE SPACES                     TO BUF-DDAILYTC.
           MOVE CUR-DATE                   TO DDAILYTC-DATE.
           ACCEPT DDAILYTC-TIME FROM TIME.
           MOVE COMPANY-SAVE               TO DDAILYTC-PLT.
           MOVE "937"                      TO DDAILYTC-TC.
           MOVE SPACES                     TO TC937-REQNO.
           MOVE 0                          TO TC937-RECORD-TYPE.
           MOVE 01                         TO TC937-RECORD-SEQ.
068200     MOVE AKRON-CTL-DATA             TO TC937-DATA.
           WRITE DDAILYTC-REC FROM BUF-DDAILYTC
               INVALID KEY    MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE "WRITE OF CONTROL RECORD FAILED"
                                           TO BU-DISPLAY-MSG
               MOVE FILE-STATUS            TO BU-DISPLAY-FLD9 (1)
               PERFORM 2-BLOWUP.
068400 601-SCR-X.    EXIT.
068500
068600 602-ABSTRACT-REQ-DATA.
068700     MOVE CORP-FIL2-REQNO             TO REQ-ARG.
068800 602-ABSTRACT-MREQ-INFO.
      *------ THIS PARAGRAPH CONTAINS VALUES USED FOR THE TECH CENTER.
      *------ IF OTHER PLANTS NEED TO USE THIS PROGRAM, IT WILL HAVE TO
      *------ BE CHANGED.           11/15/95
           MOVE 0 TO COND-WORD.
           MOVE REQ-ARG TO REQNO OF MREQ-REC-I.
           READ MREQ-I INTO BUF-MREQ
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
                   MOVE 17 TO COND-WORD
               ELSE
               MOVE 99 TO COND-WORD.
069100     IF COND-WORD NOT = 0
069200         IF COND-WORD = 17
069300             GO TO 602-ARD-X
069400         ELSE
069500         MOVE "READ ERROR IN MREQ  "  TO BU-DISPLAY-MSG
069600         MOVE COND-WORD               TO BU-DISPLAY-FLD9 (1)
069700         PERFORM 2-BLOWUP.
069800     MOVE SPACES                      TO AKRON-DATA,
069900                                         DETAIL-LINE.
070000     MOVE "1"                         TO AKRON-TC.
070100     MOVE MREQ-NUMBER                 TO TC1-REQ-NUMBER,
070200                                         REQ-NO-OUT.
070300     MOVE REQ-CO                      TO TC1-COMPANY.
070400     MOVE REQ-PRIME                   TO TC1-PRIME.
           IF REQ-SUB = "   "
               MOVE ZEROES                  TO REQ-SUB.
070500     MOVE REQ-SUB                     TO TC1-SUB-ACCT.
      *------ MOVE SUBDETAIL TO REDEFINES FIELD INSTEAD OF TO A NUMERIC
      *------ FIELD BECAUSE THE FIRST DIGIT WAS BEING TRUNCATED, CAUSING
      *------ A BLANK IN THE SUBDETAIL FIELD.  11/02/95
070600     MOVE REQ-SUBD                    TO TC1-SUB-DTL-R.
           IF REQ-ADDTL-DATA = "        "
               MOVE 000000                  TO REQ-A-D-6.
070700     MOVE REQ-A-D-6                   TO TC1-ADDTL-DATA.
           IF REQ-BUDGET-NO = SPACES
               MOVE "PUR"                   TO TC1-BUDGET-LIT
               MOVE YY                      TO TC1-BUDGET-YR
               MOVE MM                      TO TC1-BUDGET-MO
           ELSE
070800         MOVE REQ-BUDGET-NO           TO TC1-BUDGET-NUMBER.
070900     MOVE REQ-BUDGET-AMT              TO TC1-BUDGET-AMNT.
           MOVE REQ-DATE-MM                 TO TC1-RD-MM.
           MOVE REQ-DATE-DD                 TO TC1-RD-DD.
           MOVE REQ-DATE-YY                 TO TC1-RD-YY.
           MOVE REQ-DATE-WANT-MM            TO TC1-DW-MM.
           MOVE REQ-DATE-WANT-DD            TO TC1-DW-DD.
           MOVE REQ-DATE-WANT-YY            TO TC1-DW-YY.
071200     MOVE REQ-DATE-WANTED             TO DATE-WANTED-OUT.
071400     MOVE REQ-ORIGINATOR              TO TC1-ORIGINATOR,
071500                                         ID-OUT.
           MOVE SPACES                      TO HOLD-LOCAL-DESC.
           PERFORM 66-GET-CORP-CODE.

           MOVE CODE-ARG TO CORPCDE OF MSTORERM-REC.
           READ MSTORERM-I INTO BUF-MSTORERM
              INVALID KEY    MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS = "00"
               IF STR-BUYER = "    "
                   NEXT SENTENCE
               ELSE
               MOVE STR-BUYER TO BUYERCDE OF MBUYER-REC
               READ MBUYER-I INTO BUF-MBUYER
               MOVE BUYER-NAME TO TC1-BUYER-NAME.

           IF COMPANY-SAVE = "112"
      *----------- HARD-CODED VALUES FOR TECH CENTER ------------------
      *********MOVE "KEN BARR      "            TO TC1-REQUESTER-NAME
      *********MOVE "CLIFF OYER    "            TO TC1-REQUESTER-NAME
      *********MOVE "CHARLIE STUMP "            TO TC1-REQUESTER-NAME
               MOVE "JEFF HUBBARD  "            TO TC1-REQUESTER-NAME
               MOVE "550A"                      TO TC1-REQUESTER-DEPT
                                                   TC1-RCDV-DEPT
                                                   TC1-FOR-DEPT
               MOVE "  78591"                   TO TC1-REQUESTER-PHNUM
               MOVE "TC"                        TO TC1-ADDL-INFO
      *----------------------------------------------------------------
           ELSE
           IF COMPANY-SAVE = "310"
      *----------- HARD-CODED VALUES FOR DES MOINES  ------------------
               MOVE "DAVID MANKA   "            TO TC1-REQUESTER-NAME
               MOVE "750 "                      TO TC1-REQUESTER-DEPT
               MOVE "DESM"                      TO TC1-RCDV-DEPT
                                                   TC1-FOR-DEPT
               MOVE "DES MOINES   "             TO TC1-SHIPTO-CODE
               MOVE "  68174"                   TO TC1-REQUESTER-PHNUM
               MOVE "  "                        TO TC1-ADDL-INFO
               MOVE "111"                       TO TC1-COMPANY
      *----------------------------------------------------------------
           END-IF.

           IF CORP-FIL2-STATUS = "RL"
               MOVE CORP-FIL2-RLSE          TO TC1-REQMT-ORD
                                               RLSE-OUT
           ELSE
               MOVE SPACES                  TO TC1-REQMT-ORD
                                               RLSE-OUT.

071600     MOVE AKRON-DATA-BUFFER           TO WORK-BUFFER.
           MOVE SPACES                      TO BUF-DDAILYTC.
           MOVE CUR-DATE                    TO DDAILYTC-DATE.
           ACCEPT DDAILYTC-TIME FROM TIME.
           MOVE COMPANY-SAVE                TO DDAILYTC-PLT.
           MOVE "937"                       TO DDAILYTC-TC.
           MOVE SAVE-REQ-NO                 TO TC937-REQNO.
           MOVE "1"                         TO TC937-RECORD-TYPE.
           MOVE ZEROS                       TO TC937-RECORD-SEQ.
           MOVE 0                           TO SUB1
                                               SUB2.
           MOVE SPACES                      TO TC937-DATA.
           PERFORM 6090-BUILD-DDAILYTC-RECORD THRU 6090-BDR-X.
           ADD 1                            TO TC937-RECORD-SEQ.
           WRITE DDAILYTC-REC FROM BUF-DDAILYTC
               INVALID KEY    MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE "WRITE OF DDAILYTC RECORD 1 FAILED"
                                            TO BU-DISPLAY-MSG
               MOVE FILE-STATUS             TO BU-DISPLAY-FLD9 (1)
               PERFORM 2-BLOWUP.
           MOVE 0                           TO SUB1.
           MOVE SPACES                      TO TC937-DATA.
           PERFORM 6090-BUILD-DDAILYTC-RECORD THRU 6090-BDR-X.
           ADD 1                            TO TC937-RECORD-SEQ.
           WRITE DDAILYTC-REC FROM BUF-DDAILYTC
               INVALID KEY    MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE "WRITE OF DDAILYTC RECORD 2 FAILED"
                   TO BU-DISPLAY-MSG
               MOVE FILE-STATUS             TO BU-DISPLAY-FLD9 (1)
               PERFORM 2-BLOWUP.
           MOVE 0                           TO SUB1.
           MOVE SPACES                      TO TC937-DATA.
           PERFORM 6090-BUILD-DDAILYTC-RECORD THRU 6090-BDR-X.
           ADD 1                            TO TC937-RECORD-SEQ.
           WRITE DDAILYTC-REC FROM BUF-DDAILYTC
               INVALID KEY    MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE "WRITE OF DDAILYTC RECORD 3 FAILED"
                   TO BU-DISPLAY-MSG
               MOVE FILE-STATUS             TO BU-DISPLAY-FLD9 (1)
               PERFORM 2-BLOWUP.
           MOVE 0                           TO SUB1.
           MOVE SPACES                      TO TC937-DATA.
           PERFORM 6090-BUILD-DDAILYTC-RECORD THRU 6090-BDR-X.
           ADD 1                            TO TC937-RECORD-SEQ.
           WRITE DDAILYTC-REC FROM BUF-DDAILYTC
               INVALID KEY    MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE "WRITE OF DDAILYTC RECORD 4 FAILED"
                   TO BU-DISPLAY-MSG
               MOVE FILE-STATUS             TO BU-DISPLAY-FLD9 (1)
               PERFORM 2-BLOWUP.
           MOVE 0                           TO SUB1.
           MOVE SPACES                      TO TC937-DATA.
           PERFORM 6090-BUILD-DDAILYTC-RECORD THRU 6090-BDR-X.
           ADD 1                            TO TC937-RECORD-SEQ.
           WRITE DDAILYTC-REC FROM BUF-DDAILYTC
               INVALID KEY    MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE "WRITE OF DDAILYTC RECORD 5 FAILED"
                   TO BU-DISPLAY-MSG
               MOVE FILE-STATUS      TO BU-DISPLAY-FLD9 (1)
               PERFORM 2-BLOWUP.
           MOVE 0                           TO SUB1.
           MOVE SPACES                      TO TC937-DATA.
           PERFORM 6090-BUILD-DDAILYTC-RECORD THRU 6090-BDR-X.
           ADD 1                            TO TC937-RECORD-SEQ.
           WRITE DDAILYTC-REC FROM BUF-DDAILYTC
               INVALID KEY    MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE "WRITE OF DDAILYTC RECORD 6 FAILED"
                   TO BU-DISPLAY-MSG
               MOVE FILE-STATUS      TO BU-DISPLAY-FLD9 (1)
               PERFORM 2-BLOWUP.
071800     MOVE "Y"                         TO AT-LEAST-ONE-REQ.
071900
072000 602-ABSTRACT-DREQITM-INFO.
           MOVE REQ-ARG TO REQNO OF DREQITM-REC-I.
072100     START DREQITM-I KEY = REQNO OF DREQITM-REC-I
072200         INVALID KEY MOVE 17 TO COND-WORD.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
                   GO TO 602-ARD-X
               ELSE
               MOVE "START ERROR ON DREQITM * 602-ADI"
                   TO BU-DISPLAY-MSG
               PERFORM 2-BLOWUP.
072400 602-ABSTRACT-DREQITM-LOOP.
072500     READ DREQITM-I NEXT INTO BUF-DREQITM
072600         AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14"
                   GO TO 602-ABSTRACT-DESC
               ELSE
               MOVE "READ ERROR ON DREQITM * 602-ADI"
                   TO BU-DISPLAY-MSG
               PERFORM 2-BLOWUP.
           IF REQITM-REQ-NUMBER NOT = REQ-ARG GO TO 602-ABSTRACT-DESC.
073400     MOVE SPACES                      TO AKRON-DATA.
073500     MOVE "3"                         TO AKRON-TC.
           IF CORP-FIL2-STATUS = "RL"
               PERFORM 6021-FIND-ITEM-NO THRU 6021-FIN-X
           ELSE
           MOVE 1                           TO TC3-ITEM-NO.
073600*    MOVE REQITM-NUMBER               TO TC3-ITEM-NO.
073700     MOVE REQITM-QTY-TO-ORD           TO TC3-ITEM-QTY,
073800                                         QTY-OUT.
073900     MOVE REQITM-UM                   TO TC3-ITEM-QTY-UM,
074000                                         UM-OUT.
074100     MOVE REQITM-UNIT-PRICE           TO TC3-ITEM-PRICE.
074200     MOVE REQITM-PRICE-UM             TO TC3-ITEM-PRICE-UM
074300     MOVE REQITM-CORP-CODE            TO TC3-CSIS-CODE,
074400                                         CORP-CODE-OUT.
074500     MOVE AKRON-DATA-BUFFER           TO WORK-BUFFER.
           MOVE SPACES                      TO BUF-DDAILYTC.
           MOVE CUR-DATE                    TO DDAILYTC-DATE.
           ACCEPT DDAILYTC-TIME FROM TIME.
           MOVE COMPANY-SAVE                TO DDAILYTC-PLT.
           MOVE "937"                       TO DDAILYTC-TC.
           MOVE SAVE-REQ-NO                 TO TC937-REQNO.
           MOVE "3"                         TO TC937-RECORD-TYPE.
           MOVE ZEROS                       TO TC937-RECORD-SEQ.
           MOVE 0                           TO SUB1
                                               SUB2.
           MOVE SPACES                      TO TC937-DATA.
           PERFORM 6090-BUILD-DDAILYTC-RECORD THRU 6090-BDR-X.
           ADD 1                            TO TC937-RECORD-SEQ.
           WRITE DDAILYTC-REC FROM BUF-DDAILYTC
               INVALID KEY    MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE "WRITE OF DDAILYTC ITEM RECORD 1 FAILED"
                                            TO BU-DISPLAY-MSG
               MOVE FILE-STATUS             TO BU-DISPLAY-FLD9 (1)
               PERFORM 2-BLOWUP.
           MOVE 0                           TO SUB1.
           MOVE SPACES                      TO TC937-DATA.
           PERFORM 6090-BUILD-DDAILYTC-RECORD THRU 6090-BDR-X.
           ADD 1                            TO TC937-RECORD-SEQ.
           WRITE DDAILYTC-REC FROM BUF-DDAILYTC
               INVALID KEY    MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE "WRITE OF DDAILYTC ITEM RECORD 2 FAILED"
                   TO BU-DISPLAY-MSG
               MOVE FILE-STATUS             TO BU-DISPLAY-FLD9 (1)
               PERFORM 2-BLOWUP.
074700     ADD 1                            TO LINE-CTR.
074800     IF LINE-CTR > 50
074900         PERFORM 621-PAGE-HDR THRU 621-P-H-X.
075000     MOVE 1                           TO PRT-CTL.
075100     MOVE DETAIL-LINE                 TO PRINT-LINE.
075200     WRITE PRINT-RCD.
075300     GO TO 602-ABSTRACT-DREQITM-LOOP.
075400
075500 602-ABSTRACT-DESC.
075600     MOVE 0                           TO SUB
                                               HOLD-DESC-LINE-NO
                                               SAVE-RECORD-SEQ.
           MOVE "4"                         TO TC937-RECORD-TYPE.
075700     MOVE SPACES                      TO DESC-TABLE.
           MOVE REQ-ARG                     TO REQNO OF DREQDESC-REC-I.
075800     START DREQDESC-I KEY = REQNO OF DREQDESC-REC-I
075900         INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
                   GO TO 602-ARD-CONT
               ELSE
               MOVE "CANNOT FIND DESCRIPTION * 602-AD"
                   TO BU-DISPLAY-MSG
               GO TO 2-BLOWUP.
076100 602-ABSTRACT-DESC-LOOP.
076200     READ DREQDESC-I NEXT INTO BUF-DREQDESC
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "46"
                   GO TO 602-ARD-CONT
               ELSE
               IF FILE-STATUS = "10" OR "14"
                   IF HOLD-LOCAL-DESC = SPACES
076600               PERFORM 6020-LOAD-DRS THRU 6020-LD-X
                       VARYING SUB FROM 1 BY 1
076700                   UNTIL (SUB > 94) OR (D-T (SUB) = SPACES)
076800               GO TO 602-ARD-CONT
                   ELSE
                   ADD 1                     TO SUB
                   ADD 1                     TO SAVE-D-LINENO
                   MOVE SAVE-D-LINENO        TO D-LINENO (SUB)
                   MOVE HOLD-LOCAL-DESC      TO D-T (SUB)
                   PERFORM 6020-LOAD-DRS THRU 6020-LD-X
                     VARYING SUB FROM 1 BY 1
                       UNTIL (SUB > 94) OR (D-T (SUB) = SPACES)
                   GO TO 602-ARD-CONT
               ELSE
               MOVE "READ ERROR ON DREQDESC * 602-ADL"
                   TO BU-DISPLAY-MSG
               PERFORM 2-BLOWUP.
           IF REQDESC-REQ-NUMBER NOT = REQ-ARG
               IF HOLD-LOCAL-DESC = SPACES
076600             PERFORM 6020-LOAD-DRS THRU 6020-LD-X
                      VARYING SUB FROM 1 BY 1
076700                    UNTIL (SUB > 94) OR (D-T (SUB) = SPACES)
076800             GO TO 602-ARD-CONT
                   ELSE
                   ADD 1                     TO SUB
                   ADD 1                     TO SAVE-D-LINENO
                   MOVE SAVE-D-LINENO        TO D-LINENO (SUB)
                   MOVE HOLD-LOCAL-DESC      TO D-T (SUB)
                   PERFORM 6020-LOAD-DRS THRU 6020-LD-X
                     VARYING SUB FROM 1 BY 1
                       UNTIL (SUB > 94) OR (D-T (SUB) = SPACES)
                   GO TO 602-ARD-CONT.
077300     ADD 1                             TO SUB.
077400     MOVE REQDESC-LINE-NO              TO D-LINENO (SUB),
                                                SAVE-D-LINENO.
077500     MOVE REQDESC-DATA                 TO D-T (SUB).
077600     GO TO 602-ABSTRACT-DESC-LOOP.

       602-ARD-CONT.
           MOVE SPACES            TO AKRON-DATA.
           ADD 1                  TO SAVE-RECORD-SEQ.
           MOVE SAVE-RECORD-SEQ   TO TC937-RECORD-SEQ.
           ADD 1                  TO HOLD-DESC-LINE-NO.
           MOVE HOLD-DESC-LINE-NO TO TC4-LINE-NO.
           MOVE STR-DISB-INSTR    TO TC4-ITEM-DESCR.
           MOVE TC4-DATA          TO TC937-DATA.
           WRITE DDAILYTC-REC FROM BUF-DDAILYTC
               INVALID KEY    MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE "WRITE OF DDAILYTC DISB RECORD FAILED"
                   TO BU-DISPLAY-MSG
               MOVE FILE-STATUS TO BU-DISPLAY-FLD9 (1)
               PERFORM 2-BLOWUP.

077700 602-ARD-X.    EXIT.
077800
077900 6020-LOAD-DRS.
078000     MOVE SPACES                       TO AKRON-DATA.
078100     MOVE "4"                          TO AKRON-TC.
      *------ EVERY LINE NUMBER HAS TO BE UNIQUE FOR CORP. PURCH., SO A
      *------ NEW FIELD WAS ADDED TO KEEP TRACK OF THE LINE NUMBERS.
078200*    MOVE D-LINENO (SUB)               TO TC4-LINE-NO.
           ADD 1                             TO HOLD-DESC-LINE-NO.
           MOVE HOLD-DESC-LINE-NO            TO TC4-LINE-NO.
078300     MOVE D-T-36 (SUB)                 TO TC4-ITEM-DESCR.
078400     MOVE SPACES                       TO BUF-DDAILYTC.
078500     MOVE CUR-DATE                     TO DDAILYTC-DATE.
           ACCEPT DDAILYTC-TIME FROM TIME.
           MOVE COMPANY-SAVE                 TO DDAILYTC-PLT.
           MOVE "937"                        TO DDAILYTC-TC.
           MOVE SAVE-REQ-NO                  TO TC937-REQNO.
           MOVE "4"                          TO TC937-RECORD-TYPE.
           MOVE SAVE-RECORD-SEQ              TO TC937-RECORD-SEQ.
      *------ MOVE DATA BUFFER INSTEAD OF TC4-DATA; THEREFORE,
      *------ THE TRANSACTION NUMBER IS MOVED ALSO.   9/26/95
           MOVE AKRON-DATA-BUFFER            TO TC937-DATA.
           ADD 1                             TO TC937-RECORD-SEQ.
           WRITE DDAILYTC-REC FROM BUF-DDAILYTC
               INVALID KEY    MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE "WRITE OF DDAILYTC DESC RECORD 1 FAILED"
                   TO BU-DISPLAY-MSG
               MOVE FILE-STATUS              TO BU-DISPLAY-FLD9 (1)
               PERFORM 2-BLOWUP.
           ADD 1                             TO SAVE-RECORD-SEQ.
           IF SAVE-RECORD-SEQ = 98 MOVE 95 TO SUB.

078600     IF D-T-43 (SUB) = SPACES GO TO 6020-LD-X.

           ADD 1                             TO HOLD-DESC-LINE-NO.
           MOVE HOLD-DESC-LINE-NO            TO TC4-LINE-NO.

078900     MOVE D-T-43 (SUB)                 TO TC4-ITEM-DESCR.
      *------ MOVE DATA BUFFER INSTEAD OF TC4-DATA; THEREFORE,
      *------ THE TRANSACTION NUMBER IS MOVED ALSO.   9/26/95
           MOVE AKRON-DATA-BUFFER            TO TC937-DATA.
           ADD 1                             TO TC937-RECORD-SEQ.
           WRITE DDAILYTC-REC FROM BUF-DDAILYTC
               INVALID KEY    MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE "WRITE OF DDAILYTC DESC RECORD 2 FAILED"
                   TO BU-DISPLAY-MSG
               MOVE FILE-STATUS              TO BU-DISPLAY-FLD9 (1)
               PERFORM 2-BLOWUP.
           ADD 1                             TO SAVE-RECORD-SEQ.
           IF SAVE-RECORD-SEQ = 98 MOVE 95 TO SUB.
       6020-LD-X.    EXIT.
079200
       6090-BUILD-DDAILYTC-RECORD.
           ADD 1                     TO SUB1.
           IF SUB1 > 47 GO TO 6090-BDR-X.
           ADD 1                     TO SUB2.
      *****IF SUB2 > 235 GO TO 6090-BDR-X.
           IF SUB2 > 250 GO TO 6090-BDR-X.
           MOVE W-B (SUB2)           TO TC937-BYTE (SUB1).
           GO TO 6090-BUILD-DDAILYTC-RECORD.
       6090-BDR-X.    EXIT.

       6021-FIND-ITEM-NO.
           MOVE CORP-FIL2-RLSE       TO  PO-ARG-NUM.
           MOVE 1                    TO  TC3-ITEM-NO.
           MOVE PO-ARG TO PORCVNO OF DPOITEM-REC-I.
           START DPOITEM-I KEY >= PORCVNO OF DPOITEM-REC-I
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               GO TO 6021-FIN-X.

       6021-GET-DPOITEM.
           READ DPOITEM-I NEXT INTO BUF-DPOITEM
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00" OR
               PORCVNO OF DPOITEM-REC-I NOT = PO-ARG
               GO TO 6021-FIN-X.
           IF ITM-CORP-CODE = REQITM-CORP-CODE
               MOVE ITM-NUMBER       TO  TC3-ITEM-NO
               GO TO 6021-FIN-X
           ELSE
               GO TO 6021-GET-DPOITEM.

       6021-FIN-X.    EXIT.

079300*******************************************
079400*                                         *
079500*  PRINT ROUTINE TO PRINT REQUISITION     *
079600*                                         *
079700*******************************************
079800
079900 621-PRINT-REQ.
080000     IF LINE-CTR > 50
080100         PERFORM 621-PAGE-HDR.
080200******************************************
080300*                                        *
080400*  PRINT ROUTINE TO PRINT HDR OF         *
080500*  REQUISTION REPORT                     *
080600*                                        *
080700******************************************
080800
080900 621-PAGE-HDR.
081000     ADD 1                     TO  PAGE-CTR.
081100     MOVE PAGE-CTR             TO  PAGE-NO-OUT.
081200     MOVE ZEROS                TO  LINE-CTR.
081300     MOVE ZEROS                TO  PRT-CTL.
081400     MOVE PRINT-HDR1           TO  PRINT-LINE.
081500     WRITE PRINT-RCD.
081600     MOVE 1                    TO  PRT-CTL.
081700     MOVE PRINT-HDR2           TO  PRINT-LINE.
081800     WRITE PRINT-RCD.
081900     MOVE DASH-LINE            TO  PRINT-LINE.
082000     WRITE PRINT-RCD.
082100
082200 621-P-H-X.
082300     EXIT.
082400
082500**************************************************
082600*                                                *
082700*   THIS PROCEDURE PRINTS THE REPORT HEADER      *
082800*                                                *
082900**************************************************
083000
083100 621-REPORT-HDR.
083200     MOVE SPACES         TO PRINT-LINE.
083300     MOVE 0              TO PRT-CTL.
083400     WRITE PRINT-RCD.
083500     MOVE 1              TO PRT-CTL.
083600     MOVE HDR-0          TO PRINT-LINE.
083700     WRITE PRINT-RCD.
083800     WRITE PRINT-RCD.
083900     MOVE HDR-1          TO PRINT-LINE.
084000     WRITE PRINT-RCD.
084100     MOVE HDR-2          TO PRINT-LINE.
084200     WRITE PRINT-RCD.
084300     MOVE HDR-3          TO PRINT-LINE.
084400     WRITE PRINT-RCD.
084500     MOVE HDR-4          TO PRINT-LINE.
084600     WRITE PRINT-RCD.
084700     MOVE HDR-5          TO PRINT-LINE.
084800     WRITE PRINT-RCD.
084900     MOVE HDR-0          TO PRINT-LINE.
085000     WRITE PRINT-RCD.
085100     WRITE PRINT-RCD.
085200
085300 621-R-H-X.
085400     EXIT.
085500******************************************
085600*                                        *
085700*  ROUTINE UPDATES THE LAST REQ NO.      *
085800*  MAINTAINED IN MPLTINFO. A LOCK OF     *
085900*  MPLTINFO IS DONE AT THE RECORD LEVEL  *
086000*  USING PLTINFO-KEY = "PREQ"            *
086100*                                        *
086200******************************************
086300
086400 65-UPDATE-MPLTINFO.
087400     MOVE "CREQ"         TO  PLTINFOKEY OF MPLTINFO-REC-O.
087500     READ MPLTINFO-O INTO BUF-MPLTINFO
087600         INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
087700     IF FILE-STATUS NOT = "00"
087800         MOVE "GET MPLTINFO * 65-UM" TO BU-DISPLAY-MSG
087900         MOVE PLT-ARG                TO BU-DISPLAY-FLD (2)
088000         GO TO 2-BLOWUP.
088100     ADD 1               TO  SAVE-SEQ-NO.
088200     MOVE SAVE-SEQ-NO    TO  MPLTINFO-REQ-NO.
088300     REWRITE MPLTINFO-REC-O FROM BUF-MPLTINFO
088400         INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
088500     IF FILE-STATUS NOT = "00"
088600         MOVE "UPDATE MPLTINFO* 65-UM" TO
088700             BU-DISPLAY-MSG
088800         GO TO 2-BLOWUP.
089500
089600 65-U-M-X.
089700     EXIT.

       66-GET-CORP-CODE.
           MOVE REQ-ARG TO REQNO OF DREQITM-REC-I.
           START DREQITM-I KEY = REQNO OF DREQITM-REC-I
               INVALID KEY MOVE 17 TO COND-WORD.
           IF FILE-STATUS = "00"
               READ DREQITM-I NEXT INTO BUF-DREQITM
                   AT END MOVE FILE-STATUS TO FILE-STATUS
               END-READ
               IF FILE-STATUS = "00"
                   MOVE REQITM-CORP-CODE    TO CODE-ARG
                   MOVE 2                   TO CDESC-LINES-TO-GET
                   MOVE "F"                 TO CDESC-DESC-OPTION
                   MOVE "R"                 TO CDESC-LOCAL-DESC-OPTION
                   CALL "CDESC" USING RET-CODE,
                                      BASE,
                                      STATUS-AREA,
                                      BU-DISPLAY-MSG,
                                      CODE-ARG,
                                      CDESC-DATA
                   IF CDESC-LINES-GOT  =  0
                       MOVE SPACES          TO TC1-BRIEF-DESC
                   ELSE
                       MOVE CDESC (1)       TO TC1-BRIEF-DESC
                       MOVE CDESC (2)       TO HOLD-LOCAL-DESC
                   END-IF
               ELSE
                   MOVE SPACES              TO TC1-BRIEF-DESC
               END-IF
           ELSE
               MOVE SPACES                  TO TC1-BRIEF-DESC
           END-IF.
