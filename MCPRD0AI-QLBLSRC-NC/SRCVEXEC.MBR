       9999-SEND-NAFTA-MSG.
           IF BUYR-FILE-SW = "Y"
      *------------ SEND MESSAGE TO PO BUYER CODE USERID.
               MOVE PO-BUYER (1:3) TO BUYERCDE OF BUYR-I-REC
      *------------ BUYER CODE FROM AKRON IS THE FIRST 3 CHARACTERS
      *------------ OF THE PO-BUYER FIELD.
      *****    MOVE PO-BUYER-CODE TO BUYERCDE OF BUYR-I-REC
               READ BUYR-I INTO BUF-BUYRFILE
                   AT END MOVE FILE-STATUS TO FILE-STATUS
               END-READ
               IF FILE-STATUS = "00"
                   MOVE BUYR-USER-ID     TO MCXSNDDST-USER
                   MOVE BUYR-SYSTEM      TO MCXSNDDST-SYSTEM
                   PERFORM 9999-CALL-MCXSNDDST
               END-IF
      *------------ SEND MESSAGE TO USERS TO GET MESSAGES FOR
      *------------ ALL RECEIVERS.
               MOVE "*ALL" TO BUYERCDE OF BUYR-I-REC
               START BUYR-I KEY = BUYERCDE OF BUYR-I-REC
                   INVALID KEY MOVE FILE-STATUS TO FILE-STATUS
               END-START
               READ BUYR-I NEXT INTO BUF-BUYRFILE
                   AT END MOVE FILE-STATUS TO FILE-STATUS
               END-READ
               PERFORM UNTIL FILE-STATUS NOT = "00" OR
                             BUYR-CODE NOT = "*ALL"
                   MOVE BUYR-USER-ID     TO MCXSNDDST-USER
                   MOVE BUYR-SYSTEM      TO MCXSNDDST-SYSTEM
                   PERFORM 9999-CALL-MCXSNDDST
                   READ BUYR-I NEXT INTO BUF-BUYRFILE
                       AT END MOVE FILE-STATUS TO FILE-STATUS
                   END-READ
               END-PERFORM.

       9999-CALL-MCXSNDDST.
           MOVE WS-PO                    TO MCXSNDDST-PO.
           MOVE WS-RLSE                  TO MCXSNDDST-RLSE.
           MOVE WS-RS                    TO MCXSNDDST-RCVR.
           MOVE 1                        TO DATE-MODE.
           CALL "TDATECK2" USING DATE-CHECK-AREA, LANGUAGE-PARMS.
           MOVE DATE-YMD-OUT TO DATE-CYMD-YMD.
           IF DATE-CYMD-YY > 70
               MOVE 19 TO DATE-CYMD-CC
           ELSE
               MOVE 20 TO DATE-CYMD-CC.
           MOVE DATE-SLASH-OUT           TO MCXSNDDST-DATE.
           MOVE DATE-FORMATTED-TIME-OUT  TO MCXSNDDST-TIME.
           CALL "MCXSNDDST" USING MCXSNDDST-USER
                                  MCXSNDDST-SYSTEM
                                  MCXSNDDST-MSG.

       9999-WRITE-NAFTA-TRACK.
           MOVE SPACES                    TO BUF-NFTAFILE.
           MOVE "P"                       TO NFTA-PO-RCV-NO (1:1).
           MOVE WS-PO                     TO NFTA-PO.
           MOVE WS-RLSE                   TO NFTA-RLSE.
           MOVE WS-RS                     TO NFTA-RCVR.
           MOVE PO-VEN-CODE               TO NFTA-VEN-CODE.
           MOVE DATE-CYMD                 TO NFTA-DATE.
           MOVE DATE-UNFORMATTED-TIME-OUT TO NFTA-TIME.
      **** MOVE PO-BUYER-CODE             TO NFTA-BUYER.
           MOVE PO-BUYER (1:3)            TO NFTA-BUYER.
           WRITE NFTA-IO-REC FROM BUF-NFTAFILE
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.

       9999-SEND-EXPEDITE-MSG.
           MOVE "EXPEDITE    " TO REQNO OF REQ-FILE-IO.
           READ REQ-FILE-IO INTO BUF-REQ-FILE
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS = "00"
               MOVE REQF-USER-ID TO HOLD-USER-ID
               MOVE REQ-ARG      TO REQNO OF REQ-FILE-IO
               READ REQ-FILE-IO INTO BUF-REQ-FILE
                   INVALID KEY MOVE FILE-STATUS TO FILE-STATUS
               END-READ
               IF FILE-STATUS = "00"
                   MOVE REQ-ARG  TO REQ-NOTIFY-REQ-NUMBER-2
                   MOVE WS-RECEIVER-2-14  TO REQ-NOTIFY-RCV-NUMBER-2
                   MOVE 1        TO  DATE-MODE
                   CALL "TDATECK2" USING DATE-CHECK-AREA, LANGUAGE-PARMS
                   MOVE DATE-SLASH-OUT TO  REQ-NOTIFY-DATE-2
                   MOVE DATE-FORMATTED-TIME-OUT TO REQ-NOTIFY-TIME-2
                   CALL "MCXSNDDST" USING HOLD-USER-ID
                                          HOLD-SYSTEM-ID
                                          REQ-NOTIFICATION-2.
                   DELETE REQ-FILE-IO
                      INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.

