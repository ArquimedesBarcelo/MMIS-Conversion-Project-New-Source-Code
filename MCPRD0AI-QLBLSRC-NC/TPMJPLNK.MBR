       IDENTIFICATION DIVISION.
       PROGRAM-ID.             TPMJPLNK.
       AUTHOR.                 W. ROXBURY.
       INSTALLATION.           GOODYEAR TIRE & RUBBER CO.

      *C   03/11/1998   CA YODER   REQ #97-1125
      *C     CHANGED PASSWORD FROM 6 TO 8 FOR CALL TO "TPERPASS."
      *C

       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.
       SOURCE-COMPUTER.        IBM-AS400.
       OBJECT-COMPUTER.        IBM-AS400.

       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT WO-PLANNED
                  ASSIGN       TO DATABASE-MCFLMM1101
                  ORGANIZATION IS INDEXED
                  ACCESS MODE  IS DYNAMIC
                  RECORD KEY   IS EXTERNALLY-DESCRIBED-KEY
                               WITH DUPLICATES
                  FILE STATUS  IS FILE-STAT.

           SELECT WO-LAST-NUM-USED
                  ASSIGN       TO DATABASE-MCFPMM0800
                  ORGANIZATION IS RELATIVE
                  ACCESS MODE  IS RANDOM
                  RELATIVE KEY IS ARG-NO
                  FILE STATUS  IS FILE-STAT.

           SELECT PM-JOBPLAN-KEYS
                  ASSIGN       TO DATABASE-MCFLMM4002
                  ORGANIZATION IS INDEXED
                  ACCESS MODE  IS DYNAMIC
                  RECORD KEY   IS EXTERNALLY-DESCRIBED-KEY
                               WITH DUPLICATES
                  FILE STATUS  IS FILE-STAT.

           SELECT DISPLAY-FILE
                  ASSIGN       TO WORKSTATION-ZPMLEVEL-SI
                  ORGANIZATION IS TRANSACTION
                  ACCESS MODE  IS SEQUENTIAL
                  FILE STATUS  IS SCREEN-STATUS
                               MAJOR-MINOR
                  CONTROL-AREA IS SCREEN-CONTROL.

       DATA DIVISION.
       FILE SECTION.
       FD  WO-PLANNED
           LABEL RECORDS ARE STANDARD.
       01  WO-PLANNED-REC.
           COPY DDS-ALL-FORMATS OF MCFLMM1101.

       FD  WO-LAST-NUM-USED
           LABEL RECORDS ARE STANDARD.
       01  WO-LAST-NUM-USED-REC.
           COPY DDS-ALL-FORMATS OF MCFPMM0800.

       FD  PM-JOBPLAN-KEYS
           LABEL RECORDS ARE STANDARD.
       01  PM-JOBP-KEYS-REC.
           COPY DDS-ALL-FORMATS OF MCFLMM4002.

       FD  DISPLAY-FILE
           LABEL RECORDS ARE OMITTED.
       01  DISPLAY-REC         PIC X(2000).

       WORKING-STORAGE SECTION.
       77  ARG-NO              PIC 9(9).
       77  TRUE-VAL            PIC 1     VALUE B"1".
       77  RETURN-CODE         PIC XX    VALUE "0 ".
       77  CNUM-BUF            PIC X(04).
       77  CNAM-BUF            PIC X(16).
       77  PWORD-SWITCH        PIC X.

       01  PASSWORD-INFORMATION.
           05  NAME-OF-PROGRAM     PIC X(08) VALUE "TPMJPLNK".
           05  PROGRAM-TYPE        PIC X(02) VALUE "IN".
           05  PROGRAM-RELEASE     PIC X(12) VALUE " J0100010001".
           05  PROGRAM-DESCRIPTION.
               10  PROG-DESC-A     PIC X(60) VALUE
              "LINKS EXISTING PM MASTER AND SUFFIXED WORKORDERS TO THE".
               10  PROG-DESC-B     PIC X(60) VALUE
              "NEW FORMAT JOBPLAN NAME.".
               10  PROG-FUNCTION   PIC X(60) VALUE SPACES.
           05  PASSWORD-FLAG       PIC X.

       01  FILE-STAT.
           05 FILE-STAT-1      PIC X   VALUE "0".
           05 FILE-STAT-2      PIC X   VALUE "0".

       01  SCREEN-DATA.
           05  WO-NUM-MASTER.
               10  WO-WO       PIC X(06).
               10  WO-YEAR     PIC X.
               10  WO-SUFF     PIC XXX.
           05  JP-NAME-BUF     PIC X(10).
           05  SCREEN-MSGS.
               10  CMDMSG      PIC X(79).
               10  ERRMSG      PIC X(79).

       01  PWORD-BUFFER.
      *-------------- EXPANDED PASSWORD FROM 6 TO 8 CHARACTERS.
      **** 05  PWORD-BUF       PIC X(06).
           05  PWORD-BUF       PIC X(08).
           05  PWD-X           PIC XX.
           05  DATE-BUFF       REDEFINES PWD-X
                               PIC 9(2).

       01  DB-ERROR.
           05  DB-TYPE   PIC X(08) VALUE SPACES.
           05  FILLER    PIC X(21) VALUE " ERROR - COND-WORD = ".
           05  CON-WORD  PIC -9999.

           COPY SCREENIO       IN COPYLIB.

           COPY CATREAD        IN COPYLIB.

       01  DBPARAMETERS.
           COPY DBPARMS        IN COPYLIB.

       01  WO-PLANNED-DATA.
           COPY DWOPLAN        IN COPYLIB.

           COPY VCOMAREA       IN COPYLIB.

       01  LAST-WO-USED-DATA.
           COPY MLASTWO        IN COPYLIB.

           COPY LANGSUB        IN COPYLIB.

       01  MESSAGE-BUFFER-DATA.
           COPY ERRORLIN       IN COPYLIB.

       01  PM-JOBP-KEYS-DATA.
           COPY DPMJBKEY       IN COPYLIB.

       PROCEDURE DIVISION.
       BEGIN.
           MOVE SPACES         TO CNUM-BUF  CNAM-BUF.

           OPEN I-O            WO-PLANNED.
           OPEN INPUT          PM-JOBPLAN-KEYS.
           OPEN I-O            DISPLAY-FILE.

           OPEN INPUT          WO-LAST-NUM-USED.
           MOVE SPACES TO LAST-WO-USED-DATA.
           MOVE 1 TO ARG-NO.
           READ  WO-LAST-NUM-USED INTO LAST-WO-USED-DATA
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = ZEROS
               DISPLAY "UNABLE TO GET LAST-WO-USED DATA."
                       "    FILE-STAT = " FILE-STAT
               CLOSE           WO-LAST-NUM-USED
               GO TO END-OF-JOB.

           CLOSE               WO-LAST-NUM-USED.

           MOVE DATE-FLAG-SW   TO DATE-FLAG.
           IF DB-VERSION = SPACES
               MOVE "VERSION " TO DB-TYPE
               MOVE 0 TO CON-WORD
               DISPLAY "MMISA DATABASE HAS NO VERSION NUMBER"
               DISPLAY DB-ERROR
               GOBACK.

           CALL "TPWORD" USING PASSWORD-INFORMATION.
           IF PASSWORD-FLAG = "N"
               GO TO END-OF-JOB.

           CALL "TPERPASS" USING CNUM-BUF
                                 CNAM-BUF
                                 PWORD-BUFFER
                                 PWORD-SWITCH.
           MOVE "Y" TO PWORD-SWITCH.
           IF PWORD-SWITCH = "N"
               GO TO END-OF-JOB.

           MOVE "VJPLINK"      TO SCREEN-NAME.
           MOVE SPACES         TO SCREEN-DATA.

       RESET-SCREEN.
           MOVE SPACES         TO WO-NUM-MASTER.
           MOVE LYU-X          TO WO-YEAR.

       SHOWFORM.
           MOVE SCREEN-DATA    TO DISPLAY-REC.
           MOVE "00"           TO SCREEN-STATUS.
           WRITE DISPLAY-REC  FORMAT IS SCREEN-NAME
               INDIC ARE SCREEN-INDICATORS.
           IF SCREEN-STATUS NOT = "00"
               DISPLAY "SCREEN WRITE ERROR.  SCREEN-STATUS IS "
                        SCREEN-STATUS
               GO TO END-OF-JOB.

           READ  DISPLAY-FILE FORMAT IS SCREEN-NAME
               INDIC ARE SCREEN-INDICATORS
           IF SCREEN-STATUS NOT = "00"
               DISPLAY "SCREEN READ ERROR.  SCREEN-STATUS IS "
                        SCREEN-STATUS
               GO TO END-OF-JOB.

           MOVE ALL B"0"       TO SCREEN-INDICATORS.
           MOVE DISPLAY-REC    TO SCREEN-DATA.

           IF KEY-HIT = 3 OR 8
               GO TO END-OF-JOB.

           IF KEY-HIT NOT = 0
               GO TO SHOWFORM.

           IF WO-WO = "      "
               GO TO SHOWFORM.

           IF JP-NAME-BUF = "          "
               GO TO SHOWFORM.

           MOVE "0 "           TO RETURN-CODE.
           CALL "TALWONO" USING WO-NUM-MASTER RETURN-CODE.
           IF RETURN-CODE NOT = "0 "
      **********************************************************************
      **    MESSAGE 035/040:
      ** INVALID WORKORDER NUMBER
      **********************************************************************
               MOVE  35        TO LANG-SETNUM
               MOVE  40        TO LANG-MSGNUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE   1        TO FIELD-NUMBER
               PERFORM 65-ERROR
               GO TO SHOWFORM.

           MOVE JP-NAME-BUF TO PMJOBPKEY OF PM-JOBPLAN-KEYS.
           START PM-JOBPLAN-KEYS KEY = PMJOBPKEY OF PM-JOBPLAN-KEYS
               INVALID KEY MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
      *M********************************************************************
      *M    MESSAGE 036/008:
      *M JOBPLAN DOES NOT EXIST
      *M********************************************************************
               MOVE  36        TO LANG-SETNUM
               MOVE   8        TO LANG-MSGNUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE   4        TO FIELD-NUMBER
               PERFORM 65-ERROR
               GO TO SHOWFORM.

           READ PM-JOBPLAN-KEYS NEXT INTO PM-JOBP-KEYS-DATA
               AT END MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT = "10" OR "14" OR "46"
      *M********************************************************************
      *M    MESSAGE 036/008:
      *M JOBPLAN DOES NOT EXIST
      *M********************************************************************
               MOVE  36        TO LANG-SETNUM
               MOVE   8        TO LANG-MSGNUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE   4        TO FIELD-NUMBER
               PERFORM 65-ERROR
               GO TO SHOWFORM.
           IF FILE-STAT NOT = "00"
               MOVE "DBGET   " TO DB-TYPE
               MOVE FILE-STAT  TO CON-WORD
               MOVE DB-ERROR   TO MESSAGE-BUFFER
               MOVE   4        TO FIELD-NUMBER
               PERFORM 65-ERROR
               GO TO SHOWFORM.
           IF PMJPK-JOBP-KEY NOT = JP-NAME-BUF
      *M********************************************************************
      *M    MESSAGE 036/008:
      *M JOBPLAN DOES NOT EXIST
      *M********************************************************************
               MOVE  36        TO LANG-SETNUM
               MOVE   8        TO LANG-MSGNUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE   4        TO FIELD-NUMBER
               PERFORM 65-ERROR
               GO TO SHOWFORM.

           MOVE WO-NUM-MASTER TO WONUM OF WO-PLANNED.
           START WO-PLANNED KEY = WONUM OF WO-PLANNED
               INVALID KEY MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
      **********************************************************************
      **    MESSAGE 035/040:
      ** INVALID WORKORDER NUMBER
      **********************************************************************
               MOVE  35        TO LANG-SETNUM
               MOVE  40        TO LANG-MSGNUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE   1        TO FIELD-NUMBER
               PERFORM 65-ERROR
               GO TO SHOWFORM.

           READ WO-PLANNED NEXT INTO WO-PLANNED-DATA
               AT END MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT = "10" OR "14" OR "46"
      **********************************************************************
      **    MESSAGE 035/040:
      ** INVALID WORKORDER NUMBER
      **********************************************************************
               MOVE  35        TO LANG-SETNUM
               MOVE  40        TO LANG-MSGNUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE   1        TO FIELD-NUMBER
               PERFORM 65-ERROR
               GO TO SHOWFORM.
           IF FILE-STAT NOT = "00"
               MOVE "DBGET   " TO DB-TYPE
               MOVE FILE-STAT  TO CON-WORD
               MOVE DB-ERROR   TO MESSAGE-BUFFER
               MOVE   1        TO FIELD-NUMBER
               PERFORM 65-ERROR
               GO TO SHOWFORM.
           IF WO-NUM-PLANNED NOT = WO-NUM-MASTER
      *----- UNLOCK RECORD OF WO-PLANNED
              MOVE HIGH-VALUES TO WONUM OF WO-PLANNED
              START WO-PLANNED KEY > WONUM OF WO-PLANNED
                  INVALID KEY MOVE FILE-STAT TO FILE-STAT
              END-START
      **********************************************************************
      **    MESSAGE 035/040:
      ** INVALID WORKORDER NUMBER
      **********************************************************************
               MOVE  35        TO LANG-SETNUM
               MOVE  40        TO LANG-MSGNUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE   1        TO FIELD-NUMBER
               PERFORM 65-ERROR
               GO TO SHOWFORM.

           IF WO-START-STATUS NOT = "AA"
      *----- UNLOCK RECORD OF WO-PLANNED
              MOVE HIGH-VALUES TO WONUM OF WO-PLANNED
              START WO-PLANNED KEY > WONUM OF WO-PLANNED
                  INVALID KEY MOVE FILE-STAT TO FILE-STAT
              END-START
      **********************************************************************
      **    MESSAGE 049/053:
      ** WORKORDER IS NOT DESIGNATED AS A `PM' WORKORDER
      **********************************************************************
               MOVE  49 TO LANG-SETNUM
               MOVE  53 TO LANG-MSGNUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE   1        TO FIELD-NUMBER
               PERFORM 65-ERROR
               GO TO SHOWFORM.

           MOVE JP-NAME-BUF    TO PM-JOBPLAN-KEY.

           REWRITE WO-PLANNED-REC FROM WO-PLANNED-DATA
               INVALID KEY MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
               MOVE "REWRITE " TO DB-TYPE
               MOVE FILE-STAT  TO CON-WORD
               MOVE DB-ERROR   TO MESSAGE-BUFFER
               MOVE   1        TO FIELD-NUMBER
               PERFORM 65-ERROR
               GO TO SHOWFORM.

           GO TO RESET-SCREEN.

       END-OF-JOB.
           CLOSE               PM-JOBPLAN-KEYS.
           CLOSE               WO-PLANNED.
           CLOSE               DISPLAY-FILE.
           GOBACK.

       65-ERROR.
           MOVE MESSAGE-BUFFER TO ERRMSG.
           MOVE TRUE-VAL       TO IND(FIELD-NUMBER) IND(99).

       999-CATREAD.
           MOVE LANG-SETNUM TO CATREAD-MSG-SET.
           MOVE LANG-MSGNUM TO CATREAD-MSG-NUM.
           MOVE SPACES         TO MESSAGE-BUFFER.
           CALL "CCATREAD" USING CATREAD-PARMS.
           IF CATREAD-MSG-NOT-FOUND
               MOVE "***ERROR***" TO MESSAGE-BUFFER
           ELSE
               MOVE CATREAD-MSG-TEXT TO MESSAGE-BUFFER.

       999-CATREAD-EXIT.    EXIT.

      ****************  END OF FILE - TPMJPLNK  ****************************


