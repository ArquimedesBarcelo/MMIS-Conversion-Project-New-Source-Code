       731-TRANS-PROCESS.
           MOVE SORT-DEPT-TYPE TO SAVE-DEPT-TYPE.
9407CK     IF SORT-ERR = "1"
  .           MOVE "** INVALID DEPT **" TO PRT-ERR
  .        ELSE
9407CK        MOVE SPACES TO PRT-ERR.

           IF SORT-SEQ = 1
               IF SORT-REPORT-CODE = 02
                   IF SORT-CLASS = 101 OR 102 OR 104 OR 106
                       ADD SORT-VALUE TO DEPT-ACCT-ACTUAL
                       ADD SORT-STD-VALUE TO DEPT-ACCT-STANDARD
                       ADD SORT-VAR TO CLASS-102-VARIANCE
                       ADD SORT-VAR TO DEPT-ACCT-VARIANCE
                       IF SORT-TRANS = "ISS " OR "RET " OR "RETV"
                           OR "AADJ" OR "SADJ" OR "ISSI"
                           ADD SORT-VALUE TO WITHDRAWALS-ACTUAL
                       ELSE
                       NEXT SENTENCE
                   ELSE
                       IF SORT-CLASS > 399 AND SORT-CLASS < 500
                           ADD SORT-VALUE TO DEPT-ACCT-ACTUAL
                           ADD SORT-STD-VALUE TO DEPT-ACCT-STANDARD
                           ADD SORT-VAR TO CLASS-400-VARIANCE
                           ADD SORT-VAR TO DEPT-ACCT-VARIANCE
                           IF SORT-TRANS = "ISS " OR "RET " OR "RETV"
                               OR "AADJ" OR "SADJ" OR "ISSI"
                               ADD SORT-VALUE TO WITHDRAWALS-ACTUAL
                           ELSE
                           NEXT SENTENCE
                       ELSE
                           ADD SORT-VALUE TO DEPT-ACCT-ACTUAL
                           ADD SORT-STD-VALUE TO DEPT-ACCT-STANDARD
                           ADD SORT-VAR TO CLASS-OTHER-VARIANCE
                           ADD SORT-VAR TO DEPT-ACCT-VARIANCE
                           IF SORT-TRANS = "ISS " OR "RET " OR "RETV"
                               OR "AADJ" OR "SADJ" OR "ISSI"
                               ADD SORT-VALUE TO WITHDRAWALS-ACTUAL
                           ELSE
                           NEXT SENTENCE
               ELSE
               ADD SORT-VALUE TO DEPT-ACCT-ACTUAL
               ADD SORT-STD-VALUE TO DEPT-ACCT-STANDARD
               ADD SORT-VAR TO DEPT-ACCT-VARIANCE
               IF SORT-TRANS = "ISS " OR "RET " OR "RETV"
                   OR "AADJ" OR "SADJ" OR "ISSI"
                   ADD SORT-VALUE TO WITHDRAWALS-ACTUAL
               ELSE
               NEXT SENTENCE
           ELSE
               ADD SORT-VALUE TO ACCOUNT-ACTUAL
               ADD SORT-STD-VALUE TO ACCOUNT-STANDARD
               ADD SORT-VAR TO ACCOUNT-VARIANCE.
           RETURN SORT-FILE
              AT END
                  MOVE "YES" TO NO-MORE-SORT.

