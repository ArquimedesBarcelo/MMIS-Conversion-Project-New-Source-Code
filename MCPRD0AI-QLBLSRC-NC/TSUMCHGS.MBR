088800     MOVE GRAND-STANDARD TO GRAND-STANDARD-PRT.
088900     MOVE GRAND-VARIANCE TO GRAND-VARIANCE-PRT.
089000     WRITE PRT-REC FROM GRAND-LINE AFTER ADVANCING 2.
089100
089200
089300 720-PROCESS-VOUCHER.
089400     PERFORM 721-BEGIN-VOUCHER.
089500     PERFORM 722-PROCESS-LEDGER
089600         UNTIL SORT-REPORT-CODE NOT = PREV-REPORT-CODE
089700             OR NO-MORE-SORT = "YES".
089800     PERFORM 723-VOUCHER-END.
089900
090000 721-BEGIN-VOUCHER.
090100     MOVE 0 TO VOUCHER-ACTUAL
090200               VOUCHER-STANDARD
090300               VOUCHER-VARIANCE.
090400     MOVE SORT-REPORT-CODE TO PREV-REPORT-CODE.
090500     MOVE SORT-REPORT-CODE TO REPORT-CODE-ARG.
           PERFORM 9999-DBGET7-MREPORT-RC-I.
091300     IF GOOD-CALL
091400         MOVE MREPORT-DESC  TO REPORT-DESCR-HDG
091500     ELSE
091600         IF NO-ENTRY
091700             DISPLAY "NO ENTRY IN REPORT CODE MASTER FOR "
091800                          SORT-REPORT-CODE
091900         ELSE
092000             MOVE "DBGET MREPORT * 721-BEGIN" TO BU-DISPLAY-MSG
092200             PERFORM 990-BLOWUP.
092300     PERFORM 750-PRINT-HEADINGS.
092400
092500 722-PROCESS-LEDGER.
092600     PERFORM 724-LEDGER-BEGIN.
092700     PERFORM 725-PROCESS-DIV
092800         UNTIL SORT-LEDG NOT = PREV-LEDGER
092900             OR SORT-REPORT-CODE NOT = PREV-REPORT-CODE
093000                  OR NO-MORE-SORT = "YES".
093100     PERFORM 726-LEDGER-END.
093200
093300 723-VOUCHER-END.
093400     MOVE PREV-REPORT-CODE TO REPORT-CODE-TRLR.
093500     MOVE VOUCHER-ACTUAL TO VOUCHER-ACTUAL-PRT.
093600     MOVE VOUCHER-STANDARD TO VOUCHER-STANDARD-PRT.
093700     MOVE VOUCHER-VARIANCE TO VOUCHER-VARIANCE-PRT.
093800     ADD VOUCHER-ACTUAL TO GRAND-ACTUAL.
093900     ADD VOUCHER-STANDARD TO GRAND-STANDARD.
094000     ADD VOUCHER-VARIANCE TO GRAND-VARIANCE.
094100     WRITE PRT-REC FROM VOUCHER-LINE AFTER ADVANCING 2 LINES.
094200
094300 724-LEDGER-BEGIN.
094400     MOVE 0 TO LEDGER-ACTUAL
094500               LEDGER-STANDARD
094600               LEDGER-VARIANCE.
094700     MOVE SORT-LEDG TO PREV-LEDGER.
094800
094900 725-PROCESS-DIV.
095000     IF SORT-SEQ = 1
095100         PERFORM 727-DIV-BEGIN
095200         PERFORM 728-DEPT-ACCT-PROCESS
095300             UNTIL SORT-DIV NOT = PREV-DIV
095400                OR SORT-LEDG NOT = PREV-LEDGER
095500                  OR SORT-REPORT-CODE NOT = PREV-REPORT-CODE
095600                      OR NO-MORE-SORT = "YES"
095700         PERFORM 729-DIV-END
095800     ELSE
095900         PERFORM 728-ACCOUNT-PROCESS
096000             UNTIL SORT-LEDG NOT = PREV-LEDGER
096100                OR SORT-REPORT-CODE NOT = PREV-REPORT-CODE
096200                    OR NO-MORE-SORT = "YES".
096300
096400 726-LEDGER-END.
096500     MOVE PREV-LEDGER TO LEDG-CODE-TRLR.
096600     MOVE LEDGER-ACTUAL TO LEDGER-ACTUAL-PRT.
096700     MOVE LEDGER-STANDARD TO LEDGER-STANDARD-PRT.
096800     MOVE LEDGER-VARIANCE TO LEDGER-VARIANCE-PRT.
096900     ADD LEDGER-ACTUAL TO VOUCHER-ACTUAL.
097000     ADD LEDGER-STANDARD TO VOUCHER-STANDARD.
097100     ADD LEDGER-VARIANCE TO VOUCHER-VARIANCE.
097200     WRITE PRT-REC FROM LEDGER-LINE AFTER ADVANCING 2.
097300     IF SORT-REPORT-CODE = PREV-REPORT-CODE
097400         PERFORM 750-PRINT-HEADINGS
097500     ELSE
097600         ADD 2 TO LINE-CNT.
097700
097800 727-DIV-BEGIN.
097900     MOVE 0 TO DIV-ACTUAL
098000               DIV-STANDARD
