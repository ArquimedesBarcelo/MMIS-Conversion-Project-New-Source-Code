059300 200-PROCESS-DETAIL.
059400     IF TRANS-DOCUMENT-NUM = "PROC"
059500         NEXT SENTENCE
059600     ELSE
059700         IF TRANS-CODE-TRANS = "ISS"
059900             PERFORM 500-GET-MMATL-ACCUM
060000             PERFORM 510-GET-LEDGER
060100             PERFORM 550-GET-MSTORERM
060200             PERFORM 600-BUILD-SORT-REC
060300         ELSE
059700         IF TRANS-CODE = "RET " OR "SADJ" OR "AADJ" OR "RETV"
059900             PERFORM 500-GET-MMATL-ACCUM
060000             PERFORM 510-GET-LEDGER
060100             PERFORM 550-GET-MSTORERM
060200             PERFORM 600-BUILD-SORT-REC
060300         ELSE
060400             IF TRANS-CODE = "INV" OR "FRT"
060500                 IF TRANS-STORES-CODE = "NON-STR"
060600                     PERFORM 500-GET-MMATL-ACCUM
060700                     PERFORM 510-GET-LEDGER
060800                     PERFORM 550-GET-MSTORERM
060900                     PERFORM 600-BUILD-SORT-REC
061000                 ELSE
061100                 IF TRANS-DEPT NOT = MACCT-STR-DEPT
061200                     PERFORM 500-GET-MMATL-ACCUM
061300                     PERFORM 510-GET-LEDGER
061400                     PERFORM 550-GET-MSTORERM
061500                     PERFORM 600-BUILD-SORT-REC
061600                 ELSE
061700                     NEXT SENTENCE
061800             ELSE
061900                 NEXT SENTENCE.
062000     PERFORM 400-GET-DTRANS.
062100
062200
062300 400-GET-DTRANS.
           PERFORM 9999-DBGET2-DTRANS-MC-I.
063100     IF GOOD-CALL
063200         NEXT SENTENCE
063300     ELSE
063400         IF END-OF-FILE
063500             NEXT SENTENCE
063600         ELSE
063700             MOVE "DBGET DTRANS * 400-GET" TO BU-DISPLAY-MSG
064000             PERFORM 990-BLOWUP.
064100     MOVE TRANS-STORES-CODE TO MMATL-CODE-ARG.
064200
064300
064400
064500
064600 500-GET-MMATL-ACCUM.
064700     IF MMATL-CODE-ARG = "NON-STR"
064800         PERFORM 505-SET-REPORT-CODE
064900     ELSE
               PERFORM 9999-DBGET7-MMATL-ACCUM-MC-I
065700         IF GOOD-CALL
065800             IF TRANS-ACCT > "009999"
065900*****************IF TRANS-CODE = "INV" ***REPLACED 04DEC1992 DAP
                       IF TRANS-CODE = "INV" OR "FRT"
066000                     MOVE 06 TO SORT-REPORT-CODE
066100                 ELSE
066200                     MOVE 04 TO SORT-REPORT-CODE
066300             ELSE
066400                 MOVE MATL-REPORT-CODE TO SORT-REPORT-CODE
066500         ELSE
066600             MOVE "DBGET MMATL-ACCUM * 500-GET" TO BU-DISPLAY-MSG
066800             MOVE MMATL-CODE-ARG TO BU-DISPLAY-FLD (1)
066900             PERFORM 990-BLOWUP.
067000
067100**********************************************************
067200**  THIS SECTION SETS THE REPORT CODE FOR DIRECT        **
067300**  DELIVERIES THAT ARE NOT CODED.  ALL CODED ITEMS     **
067400**  HAVE A REPORT CODE ATTACHED.                        **
067500**********************************************************
067600
067700 505-SET-REPORT-CODE.
067800*    IF TRANS-CLASS < 200
067900*        MOVE 02 TO SORT-REPORT-CODE
068000*    ELSE
068100*        IF TRANS-CLASS < 344
068200*            MOVE 05 TO SORT-REPORT-CODE
068300*        ELSE
068400*            IF TRANS-CLASS < 400
068500*                MOVE 01 TO SORT-REPORT-CODE
068600*            ELSE
068700*                IF TRANS-CLASS < 500
068800*                    MOVE 02 TO SORT-REPORT-CODE
068900*                ELSE
069000*                    MOVE 01 TO SORT-REPORT-CODE.
      ******************************************************
      *    THE ABOVE LOGIC WAS CHANGED 7/30/97 DUE TO      *
      *    VALLEYFIELD USING CLASS 080 FOR MAJOR SPARE     *
      *    PARTS.....JIM C.                                *
      ******************************************************
068100     IF (TRANS-CLASS > 099 AND TRANS-CLASS < 200) OR
068200        (TRANS-CLASS > 399 AND TRANS-CLASS < 500)
068300         MOVE "02"                TO SORT-REPORT-CODE
068400     ELSE
068500     IF (TRANS-CLASS > 199 AND TRANS-CLASS < 344)
068600         MOVE "05"                TO SORT-REPORT-CODE
068700     ELSE
068800     IF (TRANS-CLASS > 343 AND TRANS-CLASS < 400)  OR
068900        (TRANS-CLASS > 499) OR (TRANS-CLASS < 100)
069000         MOVE "01"                TO SORT-REPORT-CODE.
069100     IF TRANS-ACCT = "000000" OR TRANS-ACCT = SPACES
069200         NEXT SENTENCE
069300     ELSE
069400*        IF TRANS-CLASS < 200 OR TRANS-CLASS > 399
               IF (TRANS-CLASS > 099 AND TRANS-CLASS < 200) OR
                  (TRANS-CLASS > 399)
069500             NEXT SENTENCE
069600         ELSE
069700         IF TRANS-ACCT > "009999"
069800             MOVE 06 TO SORT-REPORT-CODE
069900         ELSE
070000             IF TRANS-ACCT = "000951"
070100                 MOVE 02 TO SORT-REPORT-CODE
070200             ELSE
070300                 IF TRANS-ACCT < "000100"
070400                     OR TRANS-ACCT = "000250" OR "000251"
070500                     OR "000252" OR "000253" OR "000254"
070600                     OR "000891" OR "000892" OR "000893"
                           OR "000894" OR "000895" OR "000896"
                           OR "000897" OR "000898" OR "000899"
070700                         MOVE 05 TO SORT-REPORT-CODE
070800                 ELSE
070900                     MOVE 01 TO SORT-REPORT-CODE.
071000

       510-GET-LEDGER.
           MOVE TRANS-DEPT TO DEPT-KEY.
           PERFORM 9999-DBGET7-MCHT-ACCTS-DP-I.
           IF GOOD-CALL
               NEXT SENTENCE
           ELSE
9407CK     IF NO-ENTRY
  .            MOVE "1" TO SORT-ERR
  .            MOVE "Y" TO FOUND-ERROR
  .            INITIALIZE BUF-MCHTACCTS
9407CK     ELSE
               MOVE "DBGET MCHT-ACCTS * 510-GET" TO BU-DISPLAY-MSG
               MOVE DEPT-KEY TO BU-DISPLAY-FLD (1)
               PERFORM 990-BLOWUP.

           MOVE MCHT-LEDGERT TO SORT-LEDG-CODE.

073100 550-GET-MSTORERM.
073200     IF MMATL-CODE-ARG = "NON-STR" OR MMATL-FST4 = "ACCR"
073300         MOVE 0 TO STR-STD-COST
073400     ELSE
               PERFORM 9999-DBGET7-MSTORERM-CD-I
074200         IF GOOD-CALL
074300             NEXT SENTENCE
074400         ELSE
074500             IF NO-ENTRY
074600                 MOVE 0 TO STR-STD-COST
074700             ELSE
074800                 MOVE "DBGET MSTORE * 550-GET" TO BU-DISPLAY-MSG
075000                 MOVE MMATL-CODE-ARG TO BU-DISPLAY-FLD (1)
075100                 PERFORM 990-BLOWUP.

       600-BUILD-SORT-REC.
           MOVE TRANS-CODE       TO SORT-TRANS.
           MOVE TRANS-DEPT       TO SORT-DEPT-CHGD.
           MOVE TRANS-ACCT       TO SORT-ACCT-CHGD.
           MOVE TRANS-CLASS      TO SORT-CLASS.
           MOVE MCHT-DEPT-TYPE   TO SORT-DEPT-TYPE.
           IF TRANS-STORES-CODE = "2641544" AND
               TRANS-ACCT = "000042"
                 MOVE 05         TO SORT-REPORT-CODE.
           IF MCHT-DEPT-TYPE = "MS" OR "MU" OR "MW"
      *        IF TRANS-CLASS > 199 AND TRANS-CLASS < 400
               IF (TRANS-CLASS > 199 AND TRANS-CLASS < 400)
                   MOVE 01       TO SORT-REPORT-CODE
               ELSE
                   NEXT SENTENCE
           ELSE
               NEXT SENTENCE.
           IF TRANS-CODE = "AADJ" OR "SADJ" OR "RET" OR "RETV"
               COMPUTE SORT-QTY-CHGD = TRANS-QTY * -1
               COMPUTE SORT-VALUE = TRANS-VALUE * -1
           ELSE
               MOVE TRANS-QTY TO SORT-QTY-CHGD
               MOVE TRANS-VALUE TO SORT-VALUE.

      *----- 09OCT90 DAP - ADDED "AADJ" TO THE IF "INV" PORTION
      *----- OF THE FOLLOWING IF STMT.  THIS ALLOWS "AADJ"
      *----- TO REMAIN VALUED AT THE DOLLAR AMT THE USER INPUT.

           IF MCHT-DEPT-TYPE = "PR"
      *        IF (TRANS-CLASS < 200) OR (TRANS-CLASS > 399
      *             AND TRANS-CLASS < 500)
               IF (TRANS-CLASS > 099 AND TRANS-CLASS < 200) OR
                  (TRANS-CLASS > 399 AND TRANS-CLASS < 500)
                       IF TRANS-STORES-CODE = "NON-STR" OR
                          STR-STD-COST = 0 OR
                          TRANS-CODE = "FRT" OR
                          TRANS-CODE = "INV" AND
                          SORT-QTY-CHGD = ZEROS
                          MOVE 0 TO SORT-STD-VALUE
                       ELSE
                          IF TRANS-CODE = "INV" OR "AADJ"
                               COMPUTE SORT-STD-VALUE =
                                   SORT-QTY-CHGD * STR-STD-COST
                          ELSE
                               MOVE SORT-VALUE TO SORT-STD-VALUE
                               COMPUTE SORT-VALUE =
                                  SORT-QTY-CHGD * STR-AVG-COST
               ELSE
                   MOVE 0 TO SORT-STD-VALUE
           ELSE
               MOVE 0 TO SORT-STD-VALUE.

           IF TRANS-VALUE = 0
               MOVE 0 TO SORT-STD-VALUE.

      **************************************************
      **   IF THE DEPT TYPE = V THIS IS A VARIANCE DEPT
      **   CHARGE AND THE ENTIRE AMOUNT SHOULD GO TO
      **   VARIANCE OTHERWISE CALCULATE A VARIANCE
      **   IF A STANDARD VALUE EXISTS (NOT = 0)
      **************************************************

           IF MCHT-DEPT-TYPE1 = "V"
               MOVE SORT-VALUE          TO SORT-VAR
               MOVE 0                   TO SORT-STD-VALUE
           ELSE
               IF SORT-STD-VALUE NOT = 0
                   COMPUTE SORT-VAR = SORT-VALUE - SORT-STD-VALUE
               ELSE
                   MOVE 0               TO SORT-VAR.

      ***************************************************
      **   IF THE DEPT TYPE = "PR" PROCESS DEPT,
      **   VOUCHER 24 (REPORT CODE 02) AND THE TRANSACTION
      **   IS FOR A NON-CODED ITEM OR AND INVOICE WITH
      **   ZERO QTY OR A FREIGHT TRANSACTION THEN THE
      **   ENTIRE AMOUNT WILL GO TO VARIANCE.
      ***************************************************

           IF MCHT-DEPT-TYPE = "PR"
               IF SORT-REPORT-CODE = "02"
                   IF TRANS-STORES-CODE = "NON-STR" OR
                      TRANS-CODE = "FRT" OR
                      TRANS-CODE = "INV" AND
                      SORT-QTY-CHGD = ZEROS
                       MOVE SORT-VALUE      TO SORT-VAR.

           RELEASE SORT-REC.
           MOVE SPACES TO SORT-REC.
           MOVE 0 TO SORT-QTY-CHGD
                     SORT-VALUE
                     SORT-VAR
                     SORT-STD-VALUE.

083800 650-GET-STR-DEPT.
083900     MOVE "SDPT" TO MACCT-KEY.
