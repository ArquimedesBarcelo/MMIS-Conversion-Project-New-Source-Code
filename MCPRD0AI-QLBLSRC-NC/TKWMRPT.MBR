001100 IDENTIFICATION DIVISION.
001200 PROGRAM-ID.     TKWMRPT.
001300 AUTHOR.         ANNETTE M. KRAUSS.
001400*INSTALLATION.   GOODYEAR TIRE & RUBBER CO.
001500*DATE-WRITTEN.   MAY 6, 1986.
001600 DATE-COMPILED.
001700*REMARKS.
001800*          REPORT OF VALID KEYWORD/MODIFIERS.
001900*
002000*************************************************************
002100*************************************************************
002200*                     TKWMRPT                               *
002300*                                                           *
002400*         THIS PROGRAM WILL PRINT A REPORT OF VALID         *
002500*         KEYWORD/MODIFIERS. THE USER CAN SPECIFY A         *
002600*         RANGE OF KWM OR PRINT ALL OF THE KWM.             *
002700*                                                           *
002800*************************************************************
002900*************************************************************
      *C
      *C   10FEB1994    DAVE PLUM
      *C     ADDED CALL TO THE COBOL ERROR HANDLER - MCXCBLERR.
      *C
003100 ENVIRONMENT DIVISION.
003200 CONFIGURATION SECTION.
003300 SOURCE-COMPUTER.    HP-3000.
003400 OBJECT-COMPUTER.    HP-3000.
003500 SPECIAL-NAMES. C01 IS NEW-PAGE.
003700
003800 INPUT-OUTPUT SECTION.
003900 FILE-CONTROL.
004000     SELECT SORT-FILE      ASSIGN TO DISK-SORT.
004100     SELECT PRINT-FILE     ASSIGN TO PRINTER-MCPRT.
             SELECT MKEYADJ-I
               ASSIGN TO DATABASE-MCFLCS3301
               ORGANIZATION IS INDEXED
                  ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
               FILE STATUS IS FILE-STATUS.
             SELECT MPLTINFO-I
               ASSIGN TO DATABASE-MCFLCS0501
               ORGANIZATION IS INDEXED
                  ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
               FILE STATUS IS FILE-STATUS.
004200
004300 DATA DIVISION.
004400 FILE SECTION.
004500 FD  PRINT-FILE
004600     RECORD CONTAINS 132 CHARACTERS.
004700 01  PRINT-REC                              PIC X(132).
004800
004900 SD  SORT-FILE
005000     RECORD CONTAINS 49 CHARACTERS.
005100 01  SORT-RECORD.
005200     05  SORT-KW                            PIC X(19).
005300     05  SORT-MOD                           PIC X(30).
       FD  MKEYADJ-I
           LABEL RECORDS ARE STANDARD.
       01  MKEYADJ-REC-I.
           COPY DDS-MCRPCS3300  OF MCFLCS3301.

       FD  MPLTINFO-I
           LABEL RECORDS ARE STANDARD.
       01  MPLTINFO-REC-I.
           COPY DDS-MCRPCS0500  OF MCFLCS0501.
005400
005500 WORKING-STORAGE SECTION.
       01  MCXCBLERR-SCOPE            PIC X(1)  VALUE "C".
       01  FILE-STATUS.
           05  FILE-STATUS-1          PIC X.
           05  FILE-STATUS-2          PIC X.
005600 01  PAGE-NUM                   PIC 9(3)   VALUE 0.
005700 01  LINE-CTR                   PIC 9(3)   VALUE 0.
005800 01  MESSAGE-AREA.
005900     05  NO-SORTED-RECORDS      PIC X(132) VALUE
006000      "    ****   NO RECORDS FOUND IN RANGE SPECIFIED  ****".
006100 01  END-OF-SORT-FILE           PIC X(1)   VALUE "N".
006200     88  ALL-SORTED-RECORDS-PROCESSED      VALUE "Y".
006300 01  END-OF-INPUT-FILE          PIC X(1)   VALUE "N".
006400     88  ALL-INPUT-RECORDS-PROCESSED       VALUE "Y".
006500 01  PLANT-NUMBER               PIC X(3)   VALUE SPACES.
006600
007600
007700*----------  WORK AREAS FOR DATA LINE MADE INTO SAME SIZE
007800*            AS DATABASE ENTRY.
007900 01  DATA-LINE-WS.
008000     05  LOW-RANGE-KWM                     VALUE SPACES.
008100         10  WSL-KEY             PIC X(19).
008200         10  FILLER              PIC X.
008300         10  WSL-MOD             PIC X(30).
008400     05  HIGH-RANGE-KWM                     VALUE SPACES.
008500         10  WSH-KEY             PIC X(19).
008600         10  FILLER              PIC X.
008700         10  WSH-MOD             PIC X(30).
008800
008900 01  RPT-JCW                     PIC X(2)   VALUE SPACES.
009000
009100 01  ACCEPT-FIELDS.
009200     05  ACCEPT-ALL-FLAG        PIC X(1)   VALUE SPACE.
009300         88  ALL-ITEMS                     VALUE "A".
009400
009500
009600*-------------- TABLE WORK AREA
009700 01  TBL-WS.
009800     05  TBL-KWM                           OCCURS 100 TIMES.
009900         10  TBL-KW             PIC X(19).
010000         10  TBL-MOD            PIC X(30).
010100
010200 01  TBL-INDEX                  PIC 9(3).
010300 01  TBL-HALF                   PIC 9(3).
010400 01  TBL-INDEX2                 PIC 9(3).
010500
010600*-------------- ESCAPE SEQUENCES
010700 COPY ESCNAM2   OF COPYLIB.
       COPY OVRPFDATA OF COPYLIB.
       COPY CCHKOBJ   OF COPYLIB.
       COPY CCRTFILE  OF COPYLIB.
       COPY THDPRTA   OF COPYLIB.
010800
010900 01  COMPRESS-PRINT             PIC X(8).
011000
011100 01  NORMAL-PRINT               PIC X(8).
011200
011300 01  ESC-TEXT-61                PIC X(8).
011400
011500 COPY TBLOWUP OF COPYLIB.
011600 01  VIEW-COMAREA.
011700     05  FILLER                  PIC X(118)  VALUE ALL "0".
011800     05  FILLER                  PIC S9(4)   COMP-4 VALUE 9999.
011900 01  KSAM-STATUS                 PIC X(2)    VALUE SPACES.
012000
013900 COPY TDATECHK OF COPYLIB.
014000
014100*------------- PRINT AREAS
014200 01  PRINT-LINE                 PIC X(132)  VALUE SPACES.
014300
014400 01  HEAD1 REDEFINES PRINT-LINE.
014500     05  FILLER                 PIC X(23).
014600     05  HEAD1-TITLE1           PIC X(38).
014700     05  HEAD1-TITLE2           PIC X(48).
014800     05  FILLER                 PIC X(23).
014900
015000 01  HEAD2 REDEFINES PRINT-LINE.
015100     05  FILLER                 PIC X(1).
015200     05  HEAD2-DATE             PIC X(8).
015300     05  FILLER                 PIC X(5).
015400     05  HEAD2-TIME             PIC X(8).
015500     05  FILLER                  PIC X(98).
015600     05  HEAD2-PAGE              PIC X(5).
015700     05  HEAD2-PAGE-NO           PIC Z,ZZ9.
015800     05  FILLER                  PIC X(2).
015900
016000 01  HEAD3 REDEFINES PRINT-LINE.
016100     05  FILLER                  PIC X(45).
016200     05  HEAD3-TITLE             PIC X(36).
016300     05  HEAD3-PLANT             PIC X(3).
016400     05  FILLER                  PIC X(48).
016500
016600 01  RANGE1-TITLE REDEFINES PRINT-LINE.
016700     05  FILLER                  PIC X(57).
016800     05  RANGE1                  PIC X(11).
016900     05  FILLER                  PIC X(64).
017000
017100 01  RANGE2-TITLE REDEFINES PRINT-LINE.
017200     05  FILLER                  PIC X(10).
017300     05  RANGE2-RANGE            PIC X(8).
017400     05  RANGE2-LOW              PIC X(50).
017500     05  RANGE2-TO               PIC X(4).
017600     05  RANGE2-HIGH             PIC X(50).
017700     05  FILLER                  PIC X(10).
017800
017900 01  HEAD4 REDEFINES PRINT-LINE.
018000     05  FILLER                  PIC X(5).
018100     05  HEAD4-KEYWORD           PIC X(19).
018200     05  FILLER                  PIC X(2).
018300     05  HEAD4-MODIFIER          PIC X(30).
018400     05  FILLER                  PIC X(20).
018500     05  HEAD4-KEYWORD2          PIC X(19).
018600     05  FILLER                  PIC X(2).
018700     05  HEAD4-MODIFIER2         PIC X(30).
018800     05  FILLER                  PIC X(5).
018900
019000 01  LINE1 REDEFINES PRINT-LINE.
019100     05  FILLER                  PIC X(5).
019200     05  LINE1-KEYWORD           PIC X(19).
019300     05  FILLER                  PIC X(2).
019400     05  LINE1-MODIFIER          PIC X(30).
019500     05  FILLER                  PIC X(20).
019600     05  LINE1-KEYWORD2          PIC X(19).
019700     05  FILLER                  PIC X(2).
019800     05  LINE1-MODIFIER2         PIC X(30).
019900     05  FILLER                  PIC X(5).
020000*------------- DATABASE AREA
020100 COPY DATAB OF COPYLIB.
020700
020800 01  DATABASE-ARGS.
020900     05  MKEYADJ-ARG.
021000         10  KW-ARG              PIC X(20)  VALUE SPACES.
021100         10  MOD-ARG             PIC X(30)  VALUE SPACES.
021200     05  DUMMY-ARG               PIC X(50)  VALUE SPACES.
021300     05  PLT-ARG                 PIC X(4)   VALUE "P 01".
021400
021800*------------- DATABASE BUFFERS
021900 COPY MKEYADJ OF COPYLIB.
022000 COPY MPLTINFO OF COPYLIB.
022100
012600 LINKAGE SECTION.
       COPY THDPRTB OF COPYLIB.
006700*------------- ACCEPT FIELDS
006900 01  DATA-LINE                  PIC X(80).
007000 01  DATE-LANE-X REDEFINES DATA-LINE.
007100     05  LOW-RANGE-KEY          PIC X(18).
007200     05  LOW-RANGE-MOD          PIC X(21).
007300     05  HIGH-RANGE-KEY         PIC X(18).
007400     05  HIGH-RANGE-MOD         PIC X(21).
007500     05  RPT-JCW                PIC X(2).
022200*************************************************************
022300*************************************************************
022400*           P R O C E D U R E     D I V I S I O N           *
022500*************************************************************
022600*************************************************************
022700 PROCEDURE DIVISION USING HD-ROUTE-DATA DATA-LINE.
022800 00-BEGIN-SORT SECTION.
022900
023000 10-OPEN-FILES.
           MOVE "C"                       TO MCXCBLERR-SCOPE.
           CALL "MCXCBLERR" USING MCXCBLERR-SCOPE.

023100     MOVE "TKWMRPT"                 TO BU-PGM-NAME.
023200     OPEN INPUT MKEYADJ-I MPLTINFO-I.
023900
024000*************************************************************
024100*************************************************************
024200*   ACCEPT TWO LINES OF DATA: 1) ALL HEADER INFORMATION -   *
024300*     WHO AND WHERE THIS REPORT WILL BE ROUTED TO  2) A     *
024400*     RANGE OF KEYWORD/MODIFIERS OR THE WORD "ALL"          *
024500*                                                           *
024600*************************************************************
024700*************************************************************
024800 30-GET-PARAMETERS.
025100     DISPLAY HD-ROUTE-DATA.
025200     DISPLAY DATA-LINE.
025300     MOVE LOW-RANGE-KEY  TO WSL-KEY.
025400     MOVE LOW-RANGE-MOD  TO WSL-MOD.
025500     MOVE HIGH-RANGE-KEY TO WSH-KEY.
025600     MOVE HIGH-RANGE-MOD TO WSH-MOD.
025700     IF LOW-RANGE-KEY = "ALL"
025800         MOVE "A" TO ACCEPT-ALL-FLAG.
025900
026100     MOVE "DHDR08.PUB"   TO HD-FILE-NAME.
065000*---------- OPEN THE PRINT FILE, GET THE FILE NUMBER OF THE PRINT
065100*---------- FILE, AND PRINT THE HEADER PAGE.
           MOVE HD-SPOOLER-NUMBER TO OVRPRTF-TOFILE-NUM.
           MOVE "*YES"       TO OVRPRTF-SHARED.
028100     MOVE HD-NO-OF-COPIES TO OVRPRTF-COPIES.
           MOVE "MCPRT"      TO OVRPRTF-FILE.
           PERFORM 996-OVERRIDE-PRINT-FILE.
065300     OPEN OUTPUT PRINT-FILE.
066700
026200     CALL "THDPRT2" USING HD-RET-CODE, HD-FILE-NAME, FNUM,
026300         HD-ROUTE-DATA, ESC-NAME.
026400     IF HD-RET-CODE NOT = 0
026500         MOVE "THDPRT2 ERROR * KWMRPT" TO BU-DISPLAY-MSG
026600         MOVE "HD-RET-CODE = "         TO BU-DISPLAY-FLD (1)
026700         MOVE HD-RET-CODE              TO BU-DISPLAY-FLD9 (1)
026800         GO TO 2-BLOWUP.
026900
027000
027100*------------- GET RECORD FOR PLANT NUMBER
           MOVE 0 TO COND-WORD.
           MOVE "P 01" TO PLT-ARG.
           MOVE PLT-ARG TO PLTINFOKEY  OF MPLTINFO-REC-I.
           READ MPLTINFO-I INTO BUF-MPLTINFO INVALID KEY
                MOVE 17 TO COND-WORD.
027400     IF NOT GOOD-CALL
027500         MOVE "DBGET ERROR IN 010-OPEN-FILES"
027600             TO BU-DISPLAY-MSG
027700         MOVE "P 01" TO BU-DISPLAY-FLD (1)
027800         PERFORM 2-BLOWUP.
027900     MOVE MPLTINFO-COMPANY TO PLANT-NUMBER.
028000
028010     CALL "TESCSEQ" USING ESC-NAME.
028100     MOVE CHAR-1636PI     TO COMPRESS-PRINT.
028200     MOVE CHAR-10PI       TO NORMAL-PRINT.
028400     MOVE TEXT-LENGTH-61  TO ESC-TEXT-61.
028500
028600 60-SORT.
028700     SORT SORT-FILE
028800         ON ASCENDING KEY SORT-KW
028900                          SORT-MOD
029000         INPUT  PROCEDURE IS 8-INPUT-RECORDS THRU 89-EXIT
029100         OUTPUT PROCEDURE IS 9-WRITE-RECORDS THRU 99-EXIT.
029200
029300
029400     WRITE PRINT-REC FROM ESC-TEXT-61  AFTER ADVANCING 0.
029500     WRITE PRINT-REC FROM NORMAL-PRINT AFTER ADVANCING 0.
029600     CLOSE PRINT-FILE.
029700     CLOSE MKEYADJ-I MPLTINFO-I.
030300     GOBACK.
030400
030500
030600*************************************************************
030700*                    BLOWUP   ROUTINE                       *
030800*************************************************************
030900 2-BLOWUP.
031000     WRITE PRINT-REC FROM ESC-TEXT-61  AFTER ADVANCING 0.
031100     WRITE PRINT-REC FROM NORMAL-PRINT AFTER ADVANCING 0.
031200
031300     CALL "TBLOWUP" USING BASE, BU-PGM-NAME, STATUS-AREA,
031400           VIEW-COMAREA, FILE-STATUS, BU-DISPLAY-MSG,
031500           BU-DISPLAY-AREA.
031600
031700 8-INPUT-RECORDS.
           IF ALL-ITEMS
              MOVE SPACES TO MKEYADJ-ARG
           ELSE
              MOVE LOW-RANGE-KEY TO KW-ARG
              MOVE LOW-RANGE-MOD TO MOD-ARG.

           MOVE 0 TO COND-WORD.
           MOVE MKEYADJ-ARG TO KEYWORDADJ OF MKEYADJ-REC-I.
           START MKEYADJ-I KEY >= KEYWORDADJ OF MKEYADJ-REC-I
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
                   MOVE 17 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.
031800     PERFORM 81-PROCESS-INPUT-RECORDS THRU 81-PIR-EXIT
031900         UNTIL ALL-INPUT-RECORDS-PROCESSED.
032000     GO TO 89-EXIT.
032100
032200 81-PROCESS-INPUT-RECORDS.
           MOVE 0 TO COND-WORD.
           READ MKEYADJ-I NEXT INTO BUF-MKEYADJ
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   MOVE 15 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.
032500     IF END-OF-CHAIN
032600         MOVE "Y" TO END-OF-INPUT-FILE
032700         GO TO 81-PIR-EXIT.
032800     IF NOT GOOD-CALL
032900         MOVE "DBGET MKEYADJ IN 8-P-I-R"
033000             TO BU-DISPLAY-MSG
033100         PERFORM 82-BLOWUP.
033200
033300     IF ALL-ITEMS
033400         GO TO 81-WRITE-KWM.
033500
033600
033700*    IF KEYADJ-KEYWORD-MOD < LOW-RANGE-KWM
033800*        GO TO 81-PROCESS-INPUT-RECORDS.
033900
034000     IF KEYADJ-KEYWORD-MOD > HIGH-RANGE-KWM
              MOVE "Y" TO END-OF-INPUT-FILE
              GO TO 81-PIR-EXIT.

034300 81-WRITE-KWM.
034400      MOVE KEYADJ-KEYWORD  TO SORT-KW.
034500      MOVE KEYADJ-MODIFIER TO SORT-MOD.
034600      RELEASE SORT-RECORD.
034700
034800 81-PIR-EXIT.
034900     EXIT.
035100
035200*************************************************************
035300*                    BLOWUP   ROUTINE                       *
035400*************************************************************
035500 82-BLOWUP.
035600     WRITE PRINT-REC FROM ESC-TEXT-61  AFTER ADVANCING 0.
035700     WRITE PRINT-REC FROM NORMAL-PRINT AFTER ADVANCING 0.
035800
035900     CALL "TBLOWUP" USING BASE, BU-PGM-NAME, STATUS-AREA,
036000           VIEW-COMAREA, FILE-STATUS, BU-DISPLAY-MSG,
036100           BU-DISPLAY-AREA.
036200
036300
036400 89-EXIT.
036500     EXIT.
036600
036700 9-WRITE-RECORDS.
036800     IF PAPER-IS-132-COLS
036900         NEXT SENTENCE
037000     ELSE
037100        WRITE PRINT-REC FROM COMPRESS-PRINT AFTER ADVANCING 0.
037200        WRITE PRINT-REC FROM ESC-TEXT-61    AFTER ADVANCING 0.
037300
037400     PERFORM 94-NEW-PAGE.
037500     RETURN SORT-FILE AT END
037600         MOVE "Y"               TO END-OF-SORT-FILE
037700         MOVE NO-SORTED-RECORDS TO PRINT-REC
037800         WRITE PRINT-REC AFTER ADVANCING 1 LINES
037900         GO TO 99-EXIT.
038000     PERFORM 91-PROCESS-SORTED-RECORDS THRU 91-PSR-EXIT
038100         UNTIL ALL-SORTED-RECORDS-PROCESSED.
038200     GO TO 99-EXIT.
038300
038400 91-PROCESS-SORTED-RECORDS.
038500     MOVE  1     TO TBL-INDEX.
038600     MOVE SPACES TO TBL-WS.
038700     PERFORM 92-FILL-TABLE UNTIL ALL-SORTED-RECORDS-PROCESSED OR
038800            TBL-INDEX > 100.
038900     IF TBL-INDEX > 50
039000         DIVIDE TBL-INDEX BY 2 GIVING TBL-HALF
039100         MOVE  1 TO TBL-INDEX
039200         COMPUTE TBL-INDEX2 = TBL-HALF + 1
039300         PERFORM 93-WRITE-TABLE UNTIL TBL-INDEX > TBL-HALF
039400     ELSE
039500         MOVE TBL-INDEX TO TBL-INDEX2
039600         MOVE  1        TO TBL-INDEX
039700         PERFORM 931-WRITE-TABLE UNTIL TBL-INDEX > TBL-INDEX2.
039800
039900     IF NOT ALL-SORTED-RECORDS-PROCESSED
040000         PERFORM 94-NEW-PAGE.
040100
040200
040300 91-PSR-EXIT.
040400     EXIT.
040500
040600 92-FILL-TABLE.
040700     MOVE SORT-KW  TO TBL-KW (TBL-INDEX).
040800     MOVE SORT-MOD TO TBL-MOD (TBL-INDEX).
040900
041000     RETURN SORT-FILE AT END
041100        MOVE "Y" TO END-OF-SORT-FILE.
041200     ADD 1 TO TBL-INDEX.
041300
041400 93-WRITE-TABLE.
041500     MOVE TBL-KW (TBL-INDEX)   TO LINE1-KEYWORD.
041600     MOVE TBL-MOD (TBL-INDEX)  TO LINE1-MODIFIER.
041700     MOVE TBL-KW (TBL-INDEX2)  TO LINE1-KEYWORD2.
041800     MOVE TBL-MOD (TBL-INDEX2) TO LINE1-MODIFIER2.
041900     WRITE PRINT-REC FROM LINE1 AFTER ADVANCING 1 LINES.
042000     ADD  1 TO TBL-INDEX, TBL-INDEX2.
042100
042200 931-WRITE-TABLE.
042300     MOVE TBL-KW (TBL-INDEX)   TO LINE1-KEYWORD.
042400     MOVE TBL-MOD (TBL-INDEX)  TO LINE1-MODIFIER.
042500     MOVE SPACES               TO LINE1-KEYWORD2,
042600                                  LINE1-MODIFIER2.
042700     WRITE PRINT-REC FROM LINE1 AFTER ADVANCING 1 LINES.
042800     ADD  1 TO TBL-INDEX.
042900
043000 94-NEW-PAGE.
043100     MOVE SPACES                TO PRINT-LINE.
043200     ADD 1                      TO PAGE-NUM.
043300     MOVE "G O O D Y E A R   C O R P O R A T E   "
043400                                TO HEAD1-TITLE1.
043500     MOVE "S T O R E S  I N F O R M A T I O N   S Y S T E M"
043600                                TO HEAD1-TITLE2.
043700     WRITE PRINT-REC FROM PRINT-LINE AFTER ADVANCING NEW-PAGE.
043800     MOVE SPACES                TO PRINT-LINE.
043900
044000     MOVE 1                     TO DATE-MODE.
044100     CALL "TDATECHK" USING DATE-CHECK-AREA.
044200     MOVE DATE-FORMATTED-TIME-OUT TO HEAD2-TIME.
044300     MOVE DATE-SLASH-OUT        TO HEAD2-DATE.
044400     MOVE "PAGE "               TO HEAD2-PAGE.
044500     MOVE PAGE-NUM              TO HEAD2-PAGE-NO.
044600     WRITE PRINT-REC FROM PRINT-LINE AFTER ADVANCING 1 LINES.
044700     MOVE SPACES                TO PRINT-LINE.
044800     MOVE "    VALID KEYWORD/MODIFIERS - PLANT "
044900                                TO HEAD3-TITLE.
045000     MOVE PLANT-NUMBER          TO HEAD3-PLANT.
045100     WRITE PRINT-REC FROM PRINT-LINE AFTER ADVANCING 1 LINES.
045200     MOVE SPACES                 TO PRINT-LINE.
045300     IF ALL-ITEMS
045400         MOVE "RANGE:  ALL"      TO RANGE1
045500     ELSE
045600         MOVE "RANGE:  "         TO RANGE2-RANGE
045700         MOVE " TO "             TO RANGE2-TO
045800         MOVE LOW-RANGE-KWM      TO RANGE2-LOW
045900         MOVE HIGH-RANGE-KWM     TO RANGE2-HIGH.
046000     WRITE PRINT-REC FROM PRINT-LINE AFTER ADVANCING 2 LINES.
046100     MOVE SPACES                 TO PRINT-LINE.
046200     MOVE "KEYWORD"              TO HEAD4-KEYWORD,
046300                                    HEAD4-KEYWORD2.
046400     MOVE "MODIFIER"             TO HEAD4-MODIFIER,
046500                                    HEAD4-MODIFIER2.
046600     WRITE PRINT-REC FROM PRINT-LINE AFTER ADVANCING 1 LINES.
046700     MOVE SPACES                 TO PRINT-LINE.
046800     WRITE PRINT-REC FROM PRINT-LINE AFTER ADVANCING 2 LINES.
046900
047000 COPY OVRPFCALL OF COPYLIB.
047100 99-EXIT.
047200     EXIT.
