      *----5/15/97 JSB, IF CHANGING FRAN ID, OLD FRAN MUST NOT OWN A BIN
           IF DE-FRAN-ID NOT = OLD-FRAN-ID AND OLD-FRAN-ID NOT = SPACES
              SET NOERR TO TRUE
              PERFORM VARYING BIN-SUB FROM 1 BY 1
                 UNTIL BIN-SUB > 6
                  IF STR-BIN-OWNER(BIN-SUB) = OLD-FRAN-ID
                     SET ERR TO TRUE
                  END-IF
              END-PERFORM
              IF ERR
      ***  FRAN OWNS A BIN. CANNOT CHANGE CODE UNTIL REMOVED FROM BIN
                   MOVE   6 TO LANG-SETNUM
                   MOVE  50 TO LANG-MSGNUM
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE 57 TO FIELD-NUMBER
                   PERFORM 4-PGM-ERROR  THRU  4-PGM-ERROR-X
                   GO TO 62-SHOWFORM-SCREEN-2
              END-IF
           END-IF.

      *----4/15/97 JSB, EDIT FOR VALID FRANCHISER
       62-EDIT-FRANCHISER.
           IF FRAN-TABLE NOT = SPACES
            IF DE-FRAN-ID NOT = SPACES
              SET FRAN-IDX TO 1
              SEARCH FRAN-ENTRY
                 AT END
      ***          INVALID ID
                   MOVE   9 TO LANG-SETNUM
                   MOVE  19 TO LANG-MSGNUM
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE 57 TO FIELD-NUMBER
                   PERFORM 4-PGM-ERROR  THRU  4-PGM-ERROR-X
                   GO TO 62-SHOWFORM-SCREEN-2
                WHEN FRAN-ID(FRAN-IDX) = DE-FRAN-ID
                   NEXT SENTENCE.

