269200     IF FILE-STATUS NOT = "00"
285500         MOVE "PUT DDAILYTC TC334" TO BU-DISPLAY-MSG
285600         GO TO 2-BLOWUP.
285700
CAY    62-UPDATE-CSAS.
           IF CSAS-FLAG = "N"
               GO TO 62-UCC-X.
BEG01      IF CHANGING-STOREROOM-UM-SW = "N"
BEG01          GO TO 62-UCC-X.
           MOVE CODE-ARG TO MATLCODE OF MMATL-ACCUM-REC-O.
           READ MMATL-ACCUM-O INTO BUF-MATLACUM
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE "READ MMATL FAILED; CSAS NOT UPDATED"
                                            TO BU-DISPLAY-MSG
               GO TO 2-BLOWUP.
           IF MATL-UNIT-MEASURE > SPACES
               PERFORM 623-COMPUTE-CSAS-VALUES THRU 623-CCV-X.
           MOVE DE-UM                       TO MATL-UNIT-MEASURE.
           REWRITE MMATL-ACCUM-REC-O FROM BUF-MATLACUM
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           MOVE HIGH-VALUES TO MATLCODE OF MMATL-ACCUM-REC-O.
           START MMATL-ACCUM-O KEY > MATLCODE OF MMATL-ACCUM-REC-O
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF CHANGING-STOREROOM-UM-SW = "Y"
               PERFORM 624-UPDATE-DTRANS THRU 624-UD-X.


286500 62-UCC-X.
286600     EXIT.
