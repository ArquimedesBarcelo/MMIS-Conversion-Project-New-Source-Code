050200*                                           *
050300*  BLOWUP ROUTINE EXECUTES WHENEVER A       *
050400*  FATAL ERROR OCCURS                       *
050500*                                           *
050600*********************************************
050700
050800 2-BLOWUP.
050900     MOVE "TPLTMAST"              TO  BU-PGM-NAME.
051000     MOVE CODE-ARG                TO  BU-DISPLAY-FLD (1).
051100     CALL "TBLOWUP" USING BASE, BU-PGM-NAME, STATUS-AREA,
051200         VIEW-COMAREA, FILE-STATUS, BU-DISPLAY-MSG,
051300                 BU-DISPLAY-FLDS.
051400
051500 2-BLOWUP-X.
051600     EXIT.
054500
054600 4-PGM-ERROR.
           MOVE B"1" TO IND (FIELD-NUMBER), IND (99).
           MOVE MESSAGE-BUFFER TO DE1-MESSAGE-LINE,
                                  DE2-MESSAGE-LINE,
                                  DE3-MESSAGE-LINE.
055400
055500 4-PGM-ERROR-X.
055600     EXIT.
057600
057700 4-DBGET-MVALIDUM.
057800     MOVE "N"                     TO EDIT-ERR-SW.
           MOVE UM-ARG TO VALIDUM OF MVALIDUM-REC-I.
           START MVALIDUM-I KEY = VALIDUM OF MVALIDUM-REC-I
               INVALID KEY MOVE "2" TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
058500***          INVALID UNIT OF MEASURE
058600             MOVE   9 TO LANG-SETNUM
058700             MOVE  12 TO LANG-MSGNUM
058800             PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
059000             PERFORM 4-PGM-ERROR  THRU  4-PGM-ERROR-X
059100             MOVE "Y"             TO  EDIT-ERR-SW
059200     ELSE
059300         MOVE "GET MVALIDUM *4-DM"  TO  BU-DISPLAY-MSG
059400         GO TO 2-BLOWUP.
059500
059600 4-DGU-X.
059700     EXIT.
