048800 MODIFY-CODE SECTION 05.
       BEGIN-HERE.
           MOVE "N" TO EDIT-ERR-SW, EOJ-SW, CHANGING-STOREROOM-UM-SW,
               REORD-MSG-SW, TC-ID-1-SW, TC-ID-2-SW, TC-ID-3-SW,
               TC-ID-4-SW, TC-ID-5-SW, TC-ID-6-SW, CLASS-CHG-SW.
           MOVE SPACES TO PO-SW, WO-SW, OLD-CLASS-SAVE, UM-CHECK,
               NEW-CODE, DEPARTMENT, EXPENSE-CLASS, NEW-WORK,
               BUILD-COM-NO, BUILD-TAX-NO, ARG-VALUES.
           MOVE ZEROES TO TOTAL-LOCS-SAVE, LOC-DIFF-SAVE,
               OLD-ONHAND-SAVE.
           OPEN INPUT MVALIDUM-I, MPLTINFO-I, MVALIDPLTDATA-I,
                      DWLITEM-I, MBUYER-I, MCOMMENT-I, MTAX-I, MREQ-I,
                      DREQD-I, DPOITEM-I, MCLASS-I, MACTINFO-I.
           OPEN I-O DISPLAY-FILE, MSTORERM-O, DDESC-O, DDAILYTC-O,
                    USAGEFIL, MMATL-ACCUM-O, DTRANS-O.
048900
049000*-------- THE "WHO" INTRINSIC IS USED TO FIND OUT USER AND
049100*-------- ACCT NAME.  THE ONLY PURPOSE FOR THIS CALL IS TO KNOW
049200*-------- WHETHER THE USE OF THE 'f6' KEY (GENERATE COMPARE
049300*-------- RECORD) IS AUTHORIZED (MGR.CME ONLY).
049400     CALL "WHO" USING MOD, CAP, LATTR,
049500       USERNAME, GRPNAME, ACCTNAME, HOMEGRP, TNUM.
049600
           MOVE "Y"                      TO  SAVE-PDER-SW.
           MOVE "PDER"                   TO  PLT-ARG.
           MOVE 0 TO COND-WORD.
           MOVE PLT-ARG TO PLTINFOKEY OF MPLTINFO-REC-I.
           READ MPLTINFO-I INTO BUF-MPLTINFO
               INVALID KEY MOVE 17 TO COND-WORD.
           IF FILE-STATUS-1 = "2"
               MOVE 17 TO COND-WORD
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD.
           IF COND-WORD NOT = 0
               MOVE "Y"                  TO   SAVE-PDER-SW
           ELSE
           MOVE MPLTINFO-PDER-SW         TO   SAVE-PDER-SW.

           MOVE "00"                     TO  FILE-STATUS.
           MOVE "P 02"                   TO  PLT-ARG.
           MOVE PLT-ARG TO PLTINFOKEY OF MPLTINFO-REC-I.
           READ MPLTINFO-I INTO BUF-MPLTINFO
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS = "00"
               MOVE MPLTINFO-SEQ         TO   CSIS-SEQ.

      *-----4/15/97 JSB, GET VALID FRANCHISERS
           MOVE "FRAN"                   TO  PLT-ARG.
           MOVE 0 TO COND-WORD.
           MOVE PLT-ARG TO PLTINFOKEY OF MPLTINFO-REC-I.
           READ MPLTINFO-I INTO BUF-MPLTINFO
               INVALID KEY MOVE 17 TO COND-WORD.
           IF FILE-STATUS-1 = "2"
               MOVE 17 TO COND-WORD
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD.
           IF COND-WORD NOT = 0
               MOVE SPACES               TO   FRAN-TABLE
           ELSE
           MOVE MPLTINFO-FRANCHISES      TO   FRAN-TABLE.

      *-----01/12/98 JSB, RETRIEVE *LDA TO FIND ORIGINATING
      *----  GLOBAL MENU TRANSACTION.  IF MENU TRANSACTIONS IS
      *----  MP1I, THEN PROTECT FIELDS THAT ISC MAT. CONTROL
      *----  USERS SHOULD NOT CHANGE.  SET UP FOR DANVILLE FOR
      *----  FRANCHISE USERS.
           ACCEPT LDA FROM LOCAL-DATA-AREA.

      *-----READ CSAS INFORMATION.
           MOVE "N"         TO  CSAS-FLAG.
           MOVE "CSAS"      TO  PLT-ARG.
           MOVE 0           TO  COND-WORD.
           MOVE PLT-ARG TO PLTINFOKEY OF MPLTINFO-REC-I.
           READ MPLTINFO-I INTO BUF-MPLTINFO
               INVALID KEY MOVE 17 TO COND-WORD.
           IF FILE-STATUS = "00"
               MOVE "Y"     TO CSAS-FLAG.

           IF CSAS-FLAG = "Y"
               MOVE "MTED"      TO  CSAS-ARG
               MOVE 0           TO  COND-WORD
               MOVE CSAS-ARG TO INFOKEY OF MACTINFO-REC-I
               READ MACTINFO-I INTO BUF-MACCT-INFO
                   INVALID KEY MOVE 17 TO COND-WORD
               END-READ
               IF FILE-STATUS = "00"
                   MOVE MACCT-MONTH-END-DATE  TO CLOSING-DATE-YMD
               END-IF

               MOVE "SEQ "      TO  CSAS-ARG
               MOVE 0           TO  COND-WORD
               MOVE CSAS-ARG TO INFOKEY OF MACTINFO-REC-I
               READ MACTINFO-I INTO BUF-MACCT-INFO
                   INVALID KEY MOVE 17 TO COND-WORD
               END-READ
               IF FILE-STATUS = "00"
                   MOVE MACCT-ABST-SEQ        TO CSAS-SEQ.

           CALL "TDATECK2" USING DATE-CHECK-AREA, LANGUAGE-PARMS.
           MOVE DATE-YMD-OUT                  TO HOLD-DATE-YMD.

049700     PERFORM 6-MAIN  THRU  6-M-X.
049800
           CLOSE MVALIDUM-I, MPLTINFO-I, MVALIDPLTDATA-I,
                 DWLITEM-I, MBUYER-I, MCOMMENT-I, MTAX-I, MREQ-I,
                 DREQD-I, DPOITEM-I, USAGEFIL, MCLASS-I, MACTINFO-I,
                 DISPLAY-FILE, MSTORERM-O, DDESC-O, DDAILYTC-O,
                 MMATL-ACCUM-O, DTRANS-O.
049900     GOBACK.
050000
