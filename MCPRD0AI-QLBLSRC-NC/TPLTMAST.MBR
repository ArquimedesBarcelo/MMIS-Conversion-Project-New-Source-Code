286800*************************************************
286900*                                               *
287000*  THIS ROUTINE FIND THE STATUS OF THE LAST     *
287100*  REQUISITION. THIS ROUTINE IS USED FOR THE    *
287200*  EDIT TO REORDER WHEN REORDER IS MODIFED      *
287300*  ABOVE OR BELOW ONHAND                        *
287400*                                               *
287500*************************************************
287600
287700 621-FIND-LAST-REQ-STAT.
287800     MOVE STR-LAST-REQ-NO  TO  MSG-REQ-NO.
287900     IF STR-LAST-REQ-DATE = "XXXXXX"
288000***      CANCELLED
288100         MOVE   3 TO LANG-SETNUM
288200         MOVE  15 TO LANG-MSGNUM
288300         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
288400         MOVE MESSAGE-BUFFER TO MSG-REQ-STAT
288500         GO TO 621-FLRS-X.
288600     MOVE STR-LAST-REQ-NO  TO  REQ-ARG.
           MOVE REQ-ARG TO REQNO OF MREQ-REC-I.
           READ MREQ-I INTO BUF-MREQ
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
289100***          P.O. CUT & DELETED
289200             MOVE  16 TO LANG-SETNUM
289300             MOVE   2 TO LANG-MSGNUM
289400             PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
289500             MOVE MESSAGE-BUFFER TO MSG-REQ-STAT
289600             GO TO 621-FLRS-X
289700         ELSE
289800             MOVE "GET 621-FIND-LAST-REQ-STAT"
289900                 TO BU-DISPLAY-MSG
290000             MOVE REQ-ARG  TO  BU-DISPLAY-FLD (2)
290100             GO TO 2-BLOWUP.
290200     IF REQ-RELEASE-STAT = "XX"
290300         PERFORM 622-GET-DREQD-PO-NUM THRU 622-GDPN-X
290400     ELSE
290500         IF REQ-RELEASE-STAT = "X "
290600             IF REQ-HOLD-STATUS = SPACES
290700***              PURCHASING
290800                 MOVE  16 TO LANG-SETNUM
290900                 MOVE   1 TO LANG-MSGNUM
291000                 PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
291100                 MOVE MESSAGE-BUFFER TO MSG-REQ-STAT
291200             ELSE
291300                 MOVE REQ-HOLD-STATUS  TO  MSG-REQ-STAT
291400         ELSE
291500             IF REQ-HOLD-STATUS = SPACES
291600***              MTL. CTL.
291700                 MOVE  13 TO LANG-SETNUM
291800                 MOVE   8 TO LANG-MSGNUM
291900                 PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
292000                 MOVE MESSAGE-BUFFER TO MSG-REQ-STAT
292100             ELSE
292200                 MOVE REQ-HOLD-STATUS  TO  MSG-REQ-STAT.
292300
292400 621-FLRS-X.
292500     EXIT.
292600
292700*************************************************
292800*                                               *
292900*  FIND THE P.O. NUMBER OF THE REQUSITION       *
293000*                                               *
293100*************************************************
293200
293300 622-GET-DREQD-PO-NUM.
           MOVE REQ-ARG TO REQNO OF DREQD-REC-I.
           START DREQD-I KEY = REQNO OF DREQD-REC-I
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
                   GO TO 622-GDPN-X
               ELSE
293700             MOVE "FIND 622-GET-DREQD-PO-NUM" TO BU-DISPLAY-MSG
293800             MOVE REQ-ARG                 TO BU-DISPLAY-FLD (2)
293900             GO TO 2-BLOWUP.
           READ DREQD-I NEXT INTO BUF-DREQD
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14"
294400             GO TO 622-GDPN-X
294500         ELSE
294600             MOVE "GET 622-GET-DREQD-PO-NUM"
294700                 TO BU-DISPLAY-MSG
294800             MOVE REQ-ARG  TO  BU-DISPLAY-FLD (2)
294900             GO TO 2-BLOWUP.
           IF REQNO OF DREQD-REC-I NOT = REQ-ARG
               GO TO 622-GDPN-X.

295000***  ON P.O. #
295100     MOVE  15 TO LANG-SETNUM.
295200     MOVE  24 TO LANG-MSGNUM.
295300     PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
295400     MOVE MESSAGE-BUFFER TO MSG-PO-LIT.
295500     MOVE DREQD-PO-NUM-RLSE  TO  MSG-REQ-PO-NUM.
295600
295700 622-GDPN-X.
295800     EXIT.
295900
296000*************************************************
296100*                                               *
296200*  THIS ROUTINE CHECKS A UM TO SEE IF ANY PO    *
296300*  EXIST THAT USE THAT UM IF SO PO-SW IS SET TO *
296400*  'P'                                          *
296500*                                               *
296600*************************************************
296700
296800 622-FIND-CODE-ON-RCV-PO.
296900     MOVE SPACES TO PO-SW.
           MOVE CODE-ARG TO CORPCDE OF DPOITEM-REC-I.
           START DPOITEM-I KEY = CORPCDE OF DPOITEM-REC-I
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
                   GO TO 622-FCOWP-X
               ELSE
297300             MOVE "622-FIND-CODE-ON-RCV-PO" TO BU-DISPLAY-MSG
297400             GO TO 2-BLOWUP.
297500
297600 622-GET-CODE-ON-RCV-PO.
           READ DPOITEM-I NEXT INTO BUF-DPOITEM
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14"
                   NEXT SENTENCE
               ELSE
298300             MOVE "622-GET-CODE-ON-RCV-PO" TO BU-DISPLAY-MSG
298400             GO TO 2-BLOWUP
           ELSE
           IF CORPCDE OF DPOITEM-REC-I NOT = CODE-ARG
               NEXT SENTENCE
298500     ELSE
298600         IF ITM-PO-RCVR = "000"
298700           IF UM-CHECK = ITM-UM  OR  UM-CHECK = ITM-PRICE-UM
298800             MOVE "P"  TO  PO-SW
298900           ELSE
299000             GO TO 622-GET-CODE-ON-RCV-PO
299100         ELSE
299200             GO TO 622-GET-CODE-ON-RCV-PO.
299300
299400 622-FCOWP-X.
299500     EXIT.
299600
       623-COMPUTE-CSAS-VALUES.
BEG01      IF DE-CONV-FACTOR NOT NUMERIC
BEG01          MOVE ZEROS        TO DE-CONV-FACTOR.
           COMPUTE MATL-BEG-BAL-UNITS       ROUNDED =
              (MATL-BEG-BAL-UNITS * DE-CONV-FACTOR).
           COMPUTE MATL-RCPT-UNITS          ROUNDED =
              (MATL-RCPT-UNITS * DE-CONV-FACTOR).
           COMPUTE MATL-ISSUE-UNITS         ROUNDED =
              (MATL-ISSUE-UNITS * DE-CONV-FACTOR).
           COMPUTE MATL-RTN-UNITS           ROUNDED =
              (MATL-RTN-UNITS * DE-CONV-FACTOR).
           COMPUTE MATL-ADJ-UNITS           ROUNDED =
              (MATL-ADJ-UNITS * DE-CONV-FACTOR).
           COMPUTE MATL-UNITS-RCVD-NOT-INV  ROUNDED =
              (MATL-UNITS-RCVD-NOT-INV * DE-CONV-FACTOR).
           COMPUTE MATL-UNITS-INV-NOT-RCVD  ROUNDED =
              (MATL-UNITS-INV-NOT-RCVD * DE-CONV-FACTOR).
           COMPUTE MATL-ACCTG-UNIT-CORR     ROUNDED =
              (MATL-ACCTG-UNIT-CORR * DE-CONV-FACTOR).
           COMPUTE MATL-INTRANSIT-UNITS     ROUNDED =
              (MATL-INTRANSIT-UNITS * DE-CONV-FACTOR).
           COMPUTE MATL-RTNVAL-UNITS        ROUNDED =
              (MATL-RTNVAL-UNITS * DE-CONV-FACTOR).

       623-CCV-X.
           EXIT.

       624-UPDATE-DTRANS.
           MOVE CODE-ARG TO MATLCODE OF DTRANS-REC-O.
           START DTRANS-O KEY = MATLCODE OF DTRANS-REC-O
              INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           READ DTRANS-O NEXT INTO BUF-DTRANS
              AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS = "00"
               PERFORM UNTIL TRANS-STORES-CODE NOT = CODE-ARG OR
                                   FILE-STATUS NOT = "00"
                   COMPUTE TRANS-QTY ROUNDED =
                             (TRANS-QTY * DE-CONV-FACTOR)
                   COMPUTE TRANS-BALANCE-QTY ROUNDED =
                             (TRANS-BALANCE-QTY * DE-CONV-FACTOR)
                   MOVE DE-UM TO TRANS-UNIT-MEASURE
                   REWRITE DTRANS-REC-O FROM BUF-DTRANS
                       INVALID KEY MOVE FILE-STATUS TO FILE-STATUS
                   END-REWRITE
                   READ DTRANS-O NEXT INTO BUF-DTRANS
                       AT END MOVE FILE-STATUS TO FILE-STATUS
                   END-READ
               END-PERFORM.

       624-UD-X.
           EXIT.

