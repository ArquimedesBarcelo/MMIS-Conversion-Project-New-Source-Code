      *---EDIT RCV STD INSTRUCTIONS
       62-EDIT-RCV-STD-INST.
           MOVE "R"   TO BUILD-COM-PREFIX.
           MOVE ZERO  TO  SUB.

       62-EDIT-ALL-4-RCV-INST.
           ADD 1  TO  SUB.
           IF SUB > 4
               GO TO 62-EDIT-TAX-CODE.
           IF DE-RCV-INST (SUB) = SPACES
               GO TO 62-EDIT-ALL-4-RCV-INST.
           MOVE DE-RCV-INST (SUB) TO BUILD-COM-NO.
           MOVE BUILD-COMMENT-NO  TO  COMMENT-ARG.
           MOVE COMMENT-ARG TO MCOMCOMMNT OF MCOMMENT-REC-I.
           START MCOMMENT-I KEY = MCOMCOMMNT OF MCOMMENT-REC-I
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
      ***          RCV INST DOES NOT EXIST
                   MOVE  19 TO LANG-SETNUM
                   MOVE  24 TO LANG-MSGNUM
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE 49  TO  FIELD-NUMBER
                   ADD SUB  TO  FIELD-NUMBER
                   PERFORM 4-PGM-ERROR  THRU  4-PGM-ERROR-X
                   GO TO 62-SHOWFORM-SCREEN-2
               ELSE
                   MOVE "* GET 62-EDIT-ALL-4-RCV-INST *"
                       TO BU-DISPLAY-MSG
                   MOVE COMMENT-ARG  TO  BU-DISPLAY-FLD (2)
                   GO TO 2-BLOWUP.
           GO TO 62-EDIT-ALL-4-RCV-INST.

