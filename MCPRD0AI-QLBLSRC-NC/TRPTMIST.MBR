       COPY OVRPFCALL IN COPYLIB.

       9930-LOCK.
       9940-UNLOCK.
       9999-DBGET7-MPLTINFO-PK-I.
           MOVE 0 TO COND-WORD.
           MOVE PLT-ARG TO PLTINFOKEY OF MPLTINFO-PK-REC-I.
           READ MPLTINFO-PK-I INTO BUF-MPLTINFO
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS = "23"
               MOVE 17 TO COND-WORD
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE "DBGET7 ERR 9999-DBGET7-MPLTINFO-PK-I"
                   TO BU-MSG-AREA
               MOVE 99 TO COND-WORD
               PERFORM 2100-BLOWUP.

       9999-DBGET7-USAGEFIL-CD-I.
           MOVE 0 TO COND-WORD.
           MOVE CODE-ARG TO CORPCDE OF USAGEFIL-CD-REC-I.
           READ USAGEFIL-CD-I INTO BUF-USAGEFIL
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS = "23"
               MOVE 17 TO COND-WORD
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE "DBGET7 ERR 9999-DBGET7-USAGEFIL-CD-I"
                   TO BU-MSG-AREA
               MOVE 99 TO COND-WORD
               PERFORM 2100-BLOWUP.

       9999-DBGET2-MSTORERM-CD-I.
           MOVE 0 TO COND-WORD.
           READ MSTORERM-CD-I NEXT INTO BUF-MSTORERM
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS-1 = "1" OR FILE-STATUS = "46"
               MOVE 11 TO COND-WORD
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE "DBGET2 ERR 9999-DBGET2-MSTORERM-CD-I"
                   TO BU-MSG-AREA
               MOVE 99 TO COND-WORD
               PERFORM 2100-BLOWUP.

       9999-INIT-MSTORERM-CD-I.
           MOVE SPACES TO CORPCDE OF MSTORERM-CD-REC-I.
           START MSTORERM-CD-I KEY >= CORPCDE OF MSTORERM-CD-REC-I
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.

       9999-GETFNUM.
      *------ IBM OVERRIDES THE PRINT FILE *SHR BEFORE THE OPEN,
      *------ THUS DOES NOT USE THIS CALL WHICH OCCURS AFTER THE
      *------ THE OPEN

       9999-OPEN-STUFF.
           OPEN INPUT MPLTINFO-PK-I         MSTORERM-CD-I        .
           OPEN INPUT USAGEFIL-CD-I.

       9999-CLOSE-STUFF.
           CLOSE      MPLTINFO-PK-I         MSTORERM-CD-I        .
           CLOSE      USAGEFIL-CD-I.
