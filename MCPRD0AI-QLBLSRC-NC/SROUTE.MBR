001100 IDENTIFICATION DIVISION.
001200 PROGRAM-ID.          SROUTE.
001300 AUTHOR.              C.I.HILLES.
001400 DATE-WRITTEN.        6/13/89.
001500 DATE-COMPILED.
001600*INSTALLATION.        GOODYEAR TIRE AND RUBBER - AKRON.
001700*
001800*REMARKS.
001900*D   ROUTE SCREEN SUBPROGRAM FOR TRSCREEN AND OTHER REPORT
002000*D   OPTION PROGRAMS.  THIS RETURNS THE 'HD-ROUTE-DATA' CARD
      *    WHICH HAS PERSONS NAME, DEPT, AND PRINTER NUMBER.
      *    NOTE: WAS ORIGINALLY WRITTEN FOR 'TINVWS', WILL BE PUT
      *    INTO 'TRSCREEN' LATER.
002100*
      *C   27DEC1996     DAVE PLUM
      *C      REVISED PROGRAM TO ACCOUNT FOR THE FACT THAT THE SPOOLER
      *C      NUMBER FIELD ON FORM "ROUTE" OF ZRSCREEN WAS CHANGED FROM
      *C      3 BYTES TO 2 BYTES FOR RELEASE J.01.  THIS IS SIMILAR TO
      *C      WHAT WAS DONE WITH PROGRAM SRSCRNS2.
      *C
      *C      ALSO ADDED LOGIC TO RETRIEVE THE POPT MPLTINFO PRINTER
      *C      OPTIONS.  IF THE PRINTER OPTION TO HAVE NO ASCII CONTROL
      *C      CHARACTERS ON REPORTS IS SET TO "Y", THEN WE WON'T
      *C      DISPLAY THE CHOICE OF WIDE OR NARROW PAPER PRINTING.  WE
      *C      WILL SET THE VALUE OF DE-PAPER-FLAG TO "X" IF THIS FLAG
      *C      HAS A VALUE OF "Y".
      *C
      *C   26MAR1997     JIM COFFMAN
      *C      CHANGED THE CHECK FOR VIEW-LASTKEY = 8 TO VIEW-LASTKEY =
      *C      EXIT-PROGRAM.
      *C
015600 ENVIRONMENT DIVISION.
015700 CONFIGURATION SECTION.
015800 SOURCE-COMPUTER.  HP-3000.
015900 OBJECT-COMPUTER.  HP-3000.
       SPECIAL-NAMES. I-O-FEEDBACK IS I-O-FEEDBACK-AREA.
016000 INPUT-OUTPUT SECTION.

       FILE-CONTROL.
           SELECT DISPLAY-FILE
                  ASSIGN TO WORKSTATION-ZRSCREEN-SI
                  ORGANIZATION IS TRANSACTION
                  ACCESS IS SEQUENTIAL
                  FILE STATUS IS DISPLAY-STATUS
                  CONTROL-AREA IS WS-CONTROL.

           SELECT MPLTINFO
                  ASSIGN TO DATABASE-MCFLCS0501
                  ORGANIZATION IS INDEXED
                  ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                  FILE STATUS IS FILE-STATUS.

016500 DATA DIVISION.
       FILE SECTION.
       FD  DISPLAY-FILE
           LABEL RECORDS ARE OMITTED.
       01  DISPLAY-REC        PIC X(1500).

       FD  MPLTINFO
           LABEL RECORDS ARE STANDARD.
       01  MPLTINFO-REC.
           COPY DDS-MCRPCS0500 OF MCFLCS0501.

017600 WORKING-STORAGE SECTION.
019200*************************************************************
019300**                                                          **
019400**          C O M M U N I C A T I O N S   A R E A S         **
019500**                                                          **
019600**************************************************************
019700
019800 COPY TSHWRDFM   IN COPYLIB.
       COPY DISPDAT2   IN COPYLIB.
       COPY IOFEEDBACK IN COPYLIB.
       COPY CATREAD    IN COPYLIB.
020500*** COMM AREA FOR "TBLOWUP"
020600 01  BU-PGM-NAME              PIC X(8)  VALUE "TRSCREEN".
020700 01  DUMMY-KSAM-STAT          PIC X(2)  VALUE SPACES.
020800 01  BU-DISPLAY-MSG.
020900     05  BU-DISPLAY-MSG-1     PIC X(1)  VALUE SPACES.
021000     05  FILLER               PIC X(59) VALUE SPACES.
021100 01  BU-DISPLAY-AREA          PIC X(110) VALUE "0".
021200 01  BU-DISPLAY-FLDS REDEFINES BU-DISPLAY-AREA.
021300     05  BU-DISPLAY-LINE OCCURS 5 TIMES.
021400         10  BU-DISPLAY-FLD        PIC X(14).
021500         10  BU-DISPLAY-FLD9       PIC S9(8).
021600 01  DUMMY-BASE               PIC X(16) VALUE SPACES.
029200**************************************************************
029300**                                                          **
029400**           D A T A B A S E   W O R K                      **
029500**                                                          **
029600**************************************************************
029900 01  PASSWORD                   PIC X(5)  VALUE "JADE;".
030000 01  DB-DATASETS.
030100     05  DSET-MPLTINFO          PIC X(16)  VALUE "MPLTINFO;".
030200
031000 01  MPLTINFO-ARG.
031100     05  MPLTINFO-SPOOLTYP-KEY  PIC X(1)  VALUE "*".
031200     05  MPLTINFO-PRT           PIC X(3).
031300
031400**************************************************************
031500**                                                          **
031600**           D A T A B A S E   B U F F E R S                **
031700**                                                          **
031800**************************************************************
031900
       01  FILE-STATUS.
           05  FILE-STATUS-1            PIC X(1) VALUE SPACES.
           05  FILE-STATUS-2            PIC X(1) VALUE SPACES.

032000*01  BUF-MPLTINFO.
032100*    05  MPLTINFO-KEY             PIC X(4).
032200*    05  MPLTINFO-DATA            PIC X(60).
032300*    05  MPLTINFO-PRINTER REDEFINES MPLTINFO-DATA.
032400*        10  MPLTINFO-JSPOOLER    PIC X(2).
032500*        10  MPLTINFO-JSPOOL-TYPE PIC X(2).
032600*        10  FILLER               PIC X(56).
032700
       COPY MPLT0    IN COPYLIB.
       COPY MPLTPOPT IN COPYLIB.

032800**************************************************************
032900**                                                          **
033000**                V I E W   W O R K                         **
033100**                                                          **
033200**************************************************************
       COPY FUNCTDEF IN COPYLIB.
033300
035100 01  MESSAGE-BUFFER.
035200     05  MSG-TEXT.
               10  MESSAGE-BUFFER-1        PIC X(1)  VALUE SPACES.
               10  FILLER                  PIC X(67) VALUE SPACES.
035300     05  MSG-FLD                     PIC X(8)   VALUE SPACES.
035400     05  MSG-FLD-9 REDEFINES MSG-FLD PIC ZZZZZZZ9.
035500
035900 01  HELP-FORM.
036000     05  HELP-NAME        PIC X(4)  VALUE "HELP".
036100     05  HELP-RPT-JCW     PIC X(4)  VALUE SPACES.
036200
036300 01  FIELD-NUMBER         PIC S9(4) COMP-4 VALUE ZERO.
036400
036600**************************************************************
036700**                                                          **
036800**                 S C R E E N   D A T A                    **
036900**                                                          **
037000**************************************************************
037100
037700 01  DE-ROUTE-FIELDS.
037800     05  DE-NAME                      PIC X(15).
037900     05  DE-DEPT                      PIC X(4).
038000*****05  DE-PRINTER                   PIC 9(3). *REPLACED 27DEC96*
           05  DE-PRINTER                   PIC 9(2).
038100     05  DE-PAPER-FLAG                PIC X(1).
038200     05  DE-NO-OF-COPIES              PIC X(2).
           05  DE-COMMAND-LINE-2            PIC X(79).
           05  DE-MESSAGE-LINE-2            PIC X(79).
038300
       01  SPOOLER-NUMBER                   PIC 9(3) VALUE 0.

038400 LINKAGE SECTION.
038500 01  BASE.
           05  BASE-1-2                  PIC X(2).
           05  FILLER                    PIC X(10).
       COPY DBSTAT   IN COPYLIB.
038600 COPY VCOMLINK IN COPYLIB.
038700 COPY LANGSUB  IN COPYLIB.
038800 COPY THDPRTB  IN COPYLIB.
038900
039000 PROCEDURE DIVISION USING BASE,
                                STATUS-AREA,
039100                          VIEW-COMAREA,
                                LANGUAGE-PARMS,
                                HD-ROUTE-DATA.

039200 1000-HOUSEKEEP.
           OPEN INPUT MPLTINFO.
           MOVE "POPT" TO PLTINFOKEY OF MPLTINFO-REC.
           READ MPLTINFO INTO BUF-MPLTINFO
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE "N" TO MPLTINFO-NOASCII-REPORTS.

           OPEN I-O DISPLAY-FILE.
040400     MOVE 2                     TO  SRF-MODE.
044300
044400     PERFORM 6000-MAIN THRU 6990-MAIN-X.
           CLOSE MPLTINFO.
           CLOSE DISPLAY-FILE.
044600     GOBACK.
044700
044800 2000-BLOWUP.
044900     MOVE "SROUTE" TO BU-PGM-NAME.
045100     CALL "TBLOWUP" USING DUMMY-BASE BU-PGM-NAME
045200       STATUS-AREA VIEW-COMAREA DISPLAY-STATUS
045300       BU-DISPLAY-MSG BU-DISPLAY-FLDS.
045400
045500**************************************************************
045600**                                                          **
045700**           P E R F O R M E D   R O U T I N E S            **
045800**                                                          **
045900**************************************************************
046000
047400 4030-SETERROR.
           MOVE B"1" TO IND (99).
           MOVE B"1" TO IND (FIELD-NUMBER).
           MOVE MESSAGE-BUFFER TO DE-MESSAGE-LINE-2.
051300
048800**************************************************************
048900**                                                          **
049000**               M A I N   P R O G R A M                    **
049100**                                                          **
049200**************************************************************
049300
049400 6000-MAIN.
055900 6300-GET-ROUTE-SCREEN.
056000     MOVE "ROUTE"                  TO  VIEW-NFNAME.
           MOVE SPACES TO DE-ROUTE-FIELDS.
           MOVE ZERO TO DE-PRINTER.
           MOVE "01" TO DE-NO-OF-COPIES.
056700
056800 6310-SHOW-FORM.
           IF MPLTINFO-NOASCII-REPORTS = "Y"
               MOVE B"0" TO IND(10)
               MOVE "X"  TO DE-PAPER-FLAG
           ELSE
               MOVE B"1" TO IND(10).

           MOVE DE-ROUTE-FIELDS TO DISPLAY-REC.
       6315-SHOW.
           MOVE "I" TO SRF-FKEY (6).
           PERFORM 998-WRITE-SCREEN THRU 9989-WS-X.
           MOVE DISPLAY-REC TO DE-ROUTE-FIELDS.
           IF MESSAGE-BUFFER-1 NOT = SPACES
               PERFORM 4030-SETERROR
               GO TO 6315-SHOW.

057500     IF VIEW-LASTKEY = EXIT-PROGRAM
057800         GO TO 6990-MAIN-X.
057900
058600     IF LANG-MSGNUM = 9999
058700        GO TO 6320-SKIP-VALIDATE.
058800*---------- VALIDATE THE ROUTING PRINTER ENTERED.
058900*    MOVE DE-PRINTER          TO  MPLTINFO-PRT.
059000*    CALL "DBGET" USING BASE, DSET-MPLTINFO, MODE7, STATUS-AREA,
059100*      ALL-ITEMS, BUF-MPLTINFO, MPLTINFO-ARG.
059200*    IF (COND-WORD = 17) OR
059300*      (RPT-PRINTER-TYPE = "1" AND MPLTINFO-JSPOOLER < "01")
059400*        ***INVALID PRINTER - USE ANOTHER OR 'LP' FOR LINE PRINTER***
059500*        MOVE   9 TO LANG-SETNUM
059600*        MOVE  91 TO LANG-MSGNUM
059700*        PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
059800*        MOVE 3                  TO  FIELD-NUMBER
059900*        PERFORM 4030-SETERROR
060000*        GO TO 6310-SHOW-FORM
060100*    ELSE
060200*    IF COND-WORD NOT = 0
060300*        MOVE "DBGET ERR MPLTINFO" TO BU-DISPLAY-MSG
060400*        PERFORM 2000-BLOWUP.
060500*
           IF DE-NAME = SPACES
      *        "T62: THIS FIELD IS REQUIRED"
               MOVE 20 TO LANG-SETNUM
               MOVE 62 TO LANG-MSGNUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE 1 TO FIELD-NUMBER
               PERFORM 4030-SETERROR
               GO TO 6310-SHOW-FORM.

      *------ DEFAULT THE NUMBER OF COPIES TO ONE.
           IF (DE-NO-OF-COPIES NOT NUMERIC) OR DE-NO-OF-COPIES = "00"
              MOVE "01" TO DE-NO-OF-COPIES.

060600 6320-SKIP-VALIDATE.
060700     MOVE DE-NAME             TO  HD-NAME.
060800     MOVE DE-DEPT             TO  HD-DEPT.
060900*****MOVE DE-PRINTER          TO  HD-SPOOLER-NUMBER. *27DEC1996*
           MOVE DE-PRINTER          TO  SPOOLER-NUMBER.
           MOVE SPOOLER-NUMBER      TO  HD-SPOOLER-NUMBER.
064800     MOVE DE-PAPER-FLAG       TO  HD-PAPER-FLAG.
064900     MOVE DE-NO-OF-COPIES     TO  HD-NO-OF-COPIES.
067500
067800 6990-MAIN-X.
067900     EXIT.
068000
       COPY DISPCALL IN COPYLIB.
       COPY DISPCAL2 IN COPYLIB.
068100 999-CATREAD.
           IF CATREAD-MSG-NUMBER = ZEROS
               MOVE LANG-SETNUM TO CATREAD-MSG-SET
               MOVE LANG-MSGNUM TO CATREAD-MSG-NUM.
           CALL "CCATREAD" USING CATREAD-PARMS.
           MOVE CATREAD-MSG-TEXT TO MESSAGE-BUFFER.
069700 999-CATREAD-EXIT.
069800     EXIT.
