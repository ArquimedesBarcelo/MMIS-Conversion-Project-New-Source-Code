000200 IDENTIFICATION DIVISION.
000300 PROGRAM-ID.    TMACOSRP.
000600 AUTHOR.        WL MCINTYRE.
000900*REMARKS.
001400*
003100*C****************************************************************
      *C  03/07/95     WL MCINTYRE
      *C  MACOS MONTHLY RECEIPT QUANTITIES PROGRAM.
      *C
      *C  PROGRAM CREATES A FLAT FILE (MACOSFIL) CONTAINING DETAIL
      *C  RECORDS FOR RAW MATERIAL RECEIPTS FOR A COMPLETE MONTH,
      *C  WHICH IS DETERMINED BY A PARAMETER PASSED TO THE PROGRAM,
      *C  WHICH INDICATES WHETHER DATA FOR THE PRIOR MONTH OR FOR
      *C  A SPECIFIED DATE IS SELECTED.
      *C
      *C 09/17/96  JEFF BUNGO
      *C  EXPAND DATE FIELDS FOR YEAR 2000 COMPLIANCE.
      *C  RECOMPILE TO PICK UP COPYLIB CHANGES.
      *C
      *C 09/23/99  CA YODER
      *C  INCLUDED SPARTANBURG, SOCIAL CIRCLE, AND MIX CENTER TO
      *C  PLANT LIST.
      *C
      *C 11/06/01  CA YODER
      *C  INCLUDED DECATUR, CARTERSVILLE, AND ASHEBORO TO PLANT
      *C  LIST.
      *C
      *C 02/28/02  CA YODER
      *C  ADDED TECH CENTER TO PLANT LIST.
      *C
      *C****************************************************************
003200
003300 ENVIRONMENT DIVISION.
003400 INPUT-OUTPUT SECTION.
003500 FILE-CONTROL.
003600     SELECT MACOS-FILE
                  ASSIGN TO DISK-MACOSFIL
                  ORGANIZATION IS SEQUENTIAL
                  ACCESS MODE IS SEQUENTIAL
                  FILE STATUS IS FILE-STATUS.
003700
           SELECT MSTORERM-I
                  ASSIGN TO DATABASE-MCFLCS0201
                  ORGANIZATION IS INDEXED
                  ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                  FILE STATUS IS FILE-STATUS.

           SELECT DRCVITEM-I
                  ASSIGN TO DATABASE-MCFLCS1201
                  ORGANIZATION IS INDEXED
                  ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                    WITH DUPLICATES
                  FILE STATUS IS FILE-STATUS.

           SELECT DCODE-I
                  ASSIGN TO DATABASE-MCFLCS3402
                  ORGANIZATION IS INDEXED
                  ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                    WITH DUPLICATES
                  FILE STATUS IS FILE-STATUS.

           SELECT DPORECD-I
                  ASSIGN TO DATABASE-MCFLCS0901
                  ORGANIZATION IS INDEXED
                  ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                    WITH DUPLICATES
                  FILE STATUS IS FILE-STATUS.

           SELECT DVENDOR-I
                  ASSIGN TO DATABASE-MCFLCS0701
                  ORGANIZATION IS INDEXED
                  ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                    WITH DUPLICATES
                  FILE STATUS IS FILE-STATUS.

           SELECT MPLTINFO-I
                  ASSIGN TO DATABASE-MCFLCS0501
                  ORGANIZATION IS INDEXED
                  ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                  FILE STATUS IS FILE-STATUS.

003800 DATA DIVISION.
003900 FILE SECTION.
004000 FD  MACOS-FILE
004100     RECORD CONTAINS 200 CHARACTERS.
004200 01  MACOS-RECORD.
004300     05  FILLER                  PIC X(200).
004400
004000 FD  MSTORERM-I
004100     LABEL RECORDS ARE STANDARD.
004200 01  MSTORERM-REC-I.
004300     COPY DDS-MCRPCS0200 OF MCFLCS0201.
004400
       FD  DRCVITEM-I
           LABEL RECORDS ARE STANDARD.
       01  DRCVITEM-REC-I.
           COPY DDS-MCRPCS1200 OF MCFLCS1201.

       FD  DCODE-I
           LABEL RECORDS ARE STANDARD.
       01  DCODE-REC-I.
           COPY DDS-MCRPCS3400 OF MCFLCS3402.

       FD  DPORECD-I
           LABEL RECORDS ARE STANDARD.
       01  DPORECD-REC-I.
           COPY DDS-MCRPCS0900 OF MCFLCS0901.

       FD  DVENDOR-I
           LABEL RECORDS ARE STANDARD.
       01  DVENDOR-REC-I.
           COPY DDS-MCRPCS0700 OF MCFLCS0701.

       FD  MPLTINFO-I
           LABEL RECORDS ARE STANDARD.
       01  MPLTINFO-REC-I.
           COPY DDS-MCRPCS0500 OF MCFLCS0501.

       WORKING-STORAGE SECTION.
       01  OUTPUT-RECORD.
           05  OUT-PLANT-ID            PIC X(02).
           05  OUT-PLANT               PIC X(03).
           05  OUT-DATE-LIT            PIC X(05).
           05  OUT-DATE-RCVD           PIC X(08).
           05  OUT-GDYR-CODE           PIC X(30).
           05  OUT-VENDOR-NAME         PIC X(44).
           05  OUT-UM                  PIC X(02).
           05  OUT-QTY-RCVD            PIC S9(08)V9(04).
           05  OUT-ORIG-UM             PIC X(02).
           05  OUT-ORIG-QTY-RCVD       PIC S9(08)V9(04).
           05  OUT-PO-NO               PIC X(11).
           05  OUT-RCV-NO              PIC X(03).
           05  OUT-RCV-ITEM-NO         PIC X(04).
           05  OUT-VENDOR-CODE         PIC X(10).
           05  OUT-CORP-CODE           PIC X(08).
           05  FILLER                  PIC X(44).

       01  MAJ-GRP-1-2                 PIC X(02) VALUE SPACES.
       01  CURRENT-DATE                PIC X(6)  VALUE SPACES.
       01  CURRENT-DATE-NUM            REDEFINES CURRENT-DATE.
           05  CURR-DATE-YY            PIC 9(2).
           05  CURR-DATE-MM            PIC 9(2).
           05  CURR-DATE-DD            PIC 9(2).
       01  CALC-CENT-YEAR              PIC 9(4)  VALUE ZEROS.
       01  CALC-CCYY                   REDEFINES CALC-CENT-YEAR.
           05  CALC-CC                 PIC 9(2).
           05  CALC-YY                 PIC 9(2).
       01  FILE-CYMD.
           05  FILE-CC                 PIC X(2)  VALUE SPACES.
           05  FILE-YMD.
               10  FILE-YM.
                   15  FILE-YY         PIC X(2)  VALUE SPACES.
                   15  FILE-MM         PIC X(2)  VALUE SPACES.
               10  FILE-DD             PIC X(2)  VALUE SPACES.
       01  COMP-CYM.
           05  COMP-CC                 PIC X(2)  VALUE SPACE.
           05  COMP-YM.
               10  COMP-YY             PIC X(2)  VALUE SPACES.
               10  COMP-MM             PIC X(2)  VALUE SPACES.

       01  SAVE-PLANT-ID               PIC X(2)  VALUE SPACES.
       01  SAVE-PLANT                  PIC X(3)  VALUE SPACES.
       01  SAVE-UM                     PIC X(2)  VALUE SPACES.
       01  SAVE-KEYWORD-MOD.
           05  SAVE-KEYWORD.
               10  SAVE-KM-CODE        PIC X(4)  VALUE SPACES.
               10  FILLER              PIC X(16) VALUE SPACES.
           05  SAVE-MODIFIER           PIC X(30) VALUE SPACES.
       01  SAVE-DATE-LIT.
           05  SAVE-MONTH-LIT          PIC X(3)        VALUE SPACES.
           05  SAVE-YEAR               PIC X(2)        VALUE SPACES.
       01  CALC-QTY-DLVR               PIC 9(8)V9(4)   VALUE 0.
       01  SAVE-VENDOR-NAME            PIC X(44)       VALUE SPACES.
       01  SAVE-PO-RCV-NO.
           05  SAVE-PO-NO              PIC X(11)       VALUE SPACES.
           05  SAVE-RCV-NO             PIC X(03)       VALUE SPACES.
       01  BUILD-PO-RCV-NO.
           05  BUILD-PO-NO             PIC X(11)       VALUE SPACES.
           05  FILLER                  PIC X(03)       VALUE "000".

       01  CDEIDX                      PIC X(1)  VALUE "0".
       01  MTHIDX                      PIC 9(2)  VALUE 0.
       01  MONTH-VALUE.
           05  FILLER                  PIC X(3)  VALUE "JAN".
           05  FILLER                  PIC X(3)  VALUE "FEB".
           05  FILLER                  PIC X(3)  VALUE "MAR".
           05  FILLER                  PIC X(3)  VALUE "APR".
           05  FILLER                  PIC X(3)  VALUE "MAY".
           05  FILLER                  PIC X(3)  VALUE "JUN".
           05  FILLER                  PIC X(3)  VALUE "JUL".
           05  FILLER                  PIC X(3)  VALUE "AUG".
           05  FILLER                  PIC X(3)  VALUE "SEP".
           05  FILLER                  PIC X(3)  VALUE "OCT".
           05  FILLER                  PIC X(3)  VALUE "NOV".
           05  FILLER                  PIC X(3)  VALUE "DEC".
       01  MONTH-TBL                   REDEFINES MONTH-VALUE.
           05  MONTH-TBL-ENTRY         OCCURS 12 TIMES.
               10  MONTH-TE            PIC X(3).

       01  END-DRCVITEM-FLAG           PIC X     VALUE "N".
       01  CONVERT-FLAG                PIC X     VALUE " ".
       01  UM-RCVD-FLAG                PIC X     VALUE SPACES.
           88  RCVD-IN-PRIM                      VALUE "1".
           88  RCVD-IN-ALT1                      VALUE "2".
           88  RCVD-IN-ALT2                      VALUE "3".
       01  UM-DB-FLAG                  PIC X     VALUE SPACES.
           88  LB-IN-PRIM-DB                     VALUE "1".
           88  LB-IN-ALT1-DB                     VALUE "2".
           88  LB-IN-ALT2-DB                     VALUE "3".

       01  FILE-STATUS.
           05  FILE-STATUS-1           PIC X.
           05  FILE-STATUS-2           PIC X.

       01 FILE-NAME                    PIC X(08) VALUE "MACOSFIL".

       01 JOB-INFO.
          05 KICKOUT-TYPE              PIC X(01) VALUE SPACES.
          05 KICKOUT-CODE              PIC X(07) VALUE SPACES.
          05 KICKOUT-TEXT              PIC X(40) VALUE SPACES.
          05 KICKOUT-VALUE             PIC X(40) VALUE SPACES.
          05 KICKOUT-COUNT             PIC 9(08) VALUE 0.
          05 RECORDS-READ              PIC 9(08) VALUE 0.
          05 RECORDS-WRITTEN           PIC 9(08) VALUE 0.

       01 DEFAULT-SW                   PIC X(01).
          88  PROCESS-PREV-MONTH       VALUE "Y".
          88  PROCESS-SEL-MONTH        VALUE "N".

      **************************************************************
      **************************************************************
      **                                                          **
      **                DATABASE I/O BUFFER AREA                  **
      **                                                          **
      **************************************************************
      **************************************************************

       COPY MSTORERM OF COPYLIB.
       COPY DRCVITEM OF COPYLIB.
       COPY DCODE    OF COPYLIB.
       COPY DPORECD  OF COPYLIB.
       COPY DVENDOR  OF COPYLIB.
       COPY MPLT0    OF COPYLIB.
       COPY MPLTP01  OF COPYLIB.
       COPY MPLTPLAN OF COPYLIB.

       COPY DATAB OF COPYLIB.

       COPY TDATECHK OF COPYLIB.
       COPY CCRTFILE OF COPYLIB.

       COPY TBLOWUP OF COPYLIB.

       COPY VIEWDUM OF COPYLIB.

       LINKAGE SECTION.
       01  RUN-DATE                    PIC X(6).
       01  RUN-DATE-NUM                REDEFINES RUN-DATE.
           05  RUN-MM                  PIC 9(2).
           05  RUN-CC                  PIC 9(2).
           05  RUN-YY                  PIC 9(2).

       PROCEDURE DIVISION USING RUN-DATE.

       PROC-DIV SECTION 01.

       1-BEGIN.
           PERFORM 1-HSK THRU 1-EXIT.
           PERFORM 6-MAIN THRU 6-EXIT.
           PERFORM 2-EOJ  THRU 2-EXIT.
           GOBACK.

       1-HSK.
           OPEN OUTPUT MACOS-FILE.
           OPEN INPUT MSTORERM-I
                      DRCVITEM-I
                      DCODE-I
                      DPORECD-I
                      DVENDOR-I
                      MPLTINFO-I.

           DISPLAY " ".
           DISPLAY "************************************************".
           DISPLAY "*         T   M   A   C   O   S   R   P        *".
           DISPLAY "************************************************".
           DISPLAY " ".

           INITIALIZE JOB-INFO.
           CALL "TDATECHK" USING DATE-CHECK-AREA.
           MOVE DATE-YMD-OUT   TO  CURRENT-DATE.

      *-----  CHECK PARAMETER TO DETERMINE IF PROGRAM IS TO SELECT
      *-----  DATA FROM THE PRIOR MONTH (XXXXXX) OR THE MONTH
      *-----  SPECIFIED IN THE PARAMETER IN THE FORM OF (MMCCYY)

           MOVE SPACES TO DEFAULT-SW.
           IF RUN-DATE = "XXXXXX"
              MOVE "Y" TO DEFAULT-SW
           ELSE
              MOVE "N" TO DEFAULT-SW.
           IF PROCESS-PREV-MONTH
              PERFORM 10-PROCESS-PREV-MONTH THRU 10-EXIT
           ELSE
              PERFORM 11-PROCESS-SELECTED-MONTH  THRU 11-EXIT.

           MOVE CALC-CC           TO COMP-CC FILE-CC.
           MOVE CALC-YY           TO COMP-YY.
           MOVE MTHIDX            TO COMP-MM.
           MOVE MONTH-TE (MTHIDX) TO SAVE-MONTH-LIT.
           MOVE CALC-YY           TO SAVE-YEAR.


      *-----  GET PLANT NUMBER AND DETERMINE THE INDEX TO READ
      *-----  THE ENGLISH CODE DESCRIPTION FROM FILE DCODE (0001)

           MOVE "P 01" TO PLTINFOKEY OF MPLTINFO-REC-I.
           MOVE 0 TO COND-WORD.
           PERFORM 30-READ-MPLTINFO THRU 30-EXIT.
           IF FILE-STATUS NOT = "00"
              MOVE "READ MPLTINFO 1-HSK" TO BU-DISPLAY-MSG
              MOVE PLTINFOKEY  TO  BU-DISPLAY-FLD (1)
              PERFORM 9999-BLOWUP THRU 9999-EXIT.
           MOVE MPLTINFO-COMPANY TO SAVE-PLANT.
           MOVE "PLAN" TO PLTINFOKEY OF MPLTINFO-REC-I.
           MOVE 0 TO COND-WORD.
           PERFORM 30-READ-MPLTINFO THRU 30-EXIT.
           IF FILE-STATUS NOT = "00"
              MOVE "READ MPLTINFO 1-HSK" TO BU-DISPLAY-MSG
              MOVE PLTINFOKEY  TO  BU-DISPLAY-FLD (1)
              PERFORM 9999-BLOWUP THRU 9999-EXIT.
           IF PRIMARY-LANGUAGE = "001"
              MOVE "1" TO CDEIDX
           ELSE IF SECONDARY-LANGUAGE = "001"
              MOVE "2" TO CDEIDX
           ELSE IF THIRD-LANGUAGE = "001"
              MOVE "3" TO CDEIDX
           ELSE
              MOVE "1" TO CDEIDX.
           PERFORM 12-GET-PLANT-ID THRU 12-EXIT.

           DISPLAY " ".
           DISPLAY "RUN DATE FOR JOB IS : " SAVE-DATE-LIT.
           DISPLAY "PLANT IS            : " SAVE-PLANT.
           DISPLAY "PLANT ID IS         : " SAVE-PLANT-ID.
           DISPLAY "LANGUAGE INDEX IS   : " CDEIDX.
           DISPLAY " ".

       1-EXIT.
           EXIT.

       10-PROCESS-PREV-MONTH.
           IF CURR-DATE-YY < 40
              MOVE 20 TO CALC-CC
           ELSE
              MOVE 19 TO CALC-CC.
           MOVE CURR-DATE-YY TO CALC-YY.
           COMPUTE MTHIDX = (CURR-DATE-MM - 1).
           IF MTHIDX = 0
              COMPUTE MTHIDX = MTHIDX + 12
              COMPUTE CALC-CENT-YEAR = CALC-CENT-YEAR - 1.

       10-EXIT.
           EXIT.

       11-PROCESS-SELECTED-MONTH.

      *-----  ONLY USE PASSED DATE IF IT IS NUMERIC AND MONTH VALID

           IF RUN-DATE NOT NUMERIC
              PERFORM 10-PROCESS-PREV-MONTH THRU 10-EXIT
              GO TO 11-EXIT.
           IF RUN-MM < 1 OR > 12
              PERFORM 10-PROCESS-PREV-MONTH THRU 10-EXIT
              GO TO 11-EXIT.
           MOVE RUN-CC TO CALC-CC.
           MOVE RUN-YY TO CALC-YY.
           MOVE RUN-MM TO MTHIDX.

       11-EXIT.
           EXIT.

       12-GET-PLANT-ID.
      *-------- USE 111 FOR MIX CENTER.
           IF SAVE-PLANT = "111"
              MOVE "MC" TO SAVE-PLANT-ID
           ELSE IF SAVE-PLANT = "112"
              MOVE "TC" TO SAVE-PLANT-ID
           ELSE IF SAVE-PLANT = "120"
              MOVE "SB" TO SAVE-PLANT-ID
           ELSE IF SAVE-PLANT = "130"
              MOVE "SC" TO SAVE-PLANT-ID
           ELSE IF SAVE-PLANT = "126"
              MOVE "DA" TO SAVE-PLANT-ID
           ELSE IF SAVE-PLANT = "129"
              MOVE "UC" TO SAVE-PLANT-ID
           ELSE IF SAVE-PLANT = "131"
              MOVE "GA" TO SAVE-PLANT-ID
           ELSE IF SAVE-PLANT = "133"
              MOVE "TO" TO SAVE-PLANT-ID
           ELSE IF SAVE-PLANT = "153"
              MOVE "LA" TO SAVE-PLANT-ID
           ELSE IF SAVE-PLANT = "155"
              MOVE "AS" TO SAVE-PLANT-ID
           ELSE IF SAVE-PLANT = "173"
              MOVE "CA" TO SAVE-PLANT-ID
           ELSE IF SAVE-PLANT = "174"
              MOVE "DE" TO SAVE-PLANT-ID
           ELSE IF SAVE-PLANT = "211"
              MOVE "FA" TO SAVE-PLANT-ID
           ELSE IF SAVE-PLANT = "281"
              MOVE "FP" TO SAVE-PLANT-ID
           ELSE IF SAVE-PLANT = "285"
              MOVE "TY" TO SAVE-PLANT-ID
           ELSE IF SAVE-PLANT = "629"
              MOVE "VA" TO SAVE-PLANT-ID
           ELSE IF SAVE-PLANT = "631"
              MOVE "NN" TO SAVE-PLANT-ID
           ELSE IF SAVE-PLANT = "637"
              MOVE "MH" TO SAVE-PLANT-ID.

       12-EXIT.
           EXIT.

       2-EOJ.
           DISPLAY " ".
           DISPLAY "*************************************** ".
           DISPLAY "J O B   C O M P L E T I O N   S T A T S".
           DISPLAY "*************************************** ".
           DISPLAY " ".
           DISPLAY "RECORDS READ        : " RECORDS-READ.
           DISPLAY "RECORDS BYPASSED    : " KICKOUT-COUNT.
           DISPLAY "RECORDS WRITTEN     : " RECORDS-WRITTEN.
           DISPLAY " ".
           DISPLAY "NORMAL END OF JOB".

           CLOSE MACOS-FILE
                 MSTORERM-I
                 DRCVITEM-I
                 DCODE-I
                 DPORECD-I
                 DVENDOR-I
                 MPLTINFO-I.

       2-EXIT.
           EXIT.

       30-READ-MPLTINFO.
           READ MPLTINFO-I INTO BUF-MPLTINFO
             INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.

       30-EXIT.
           EXIT.

       31-READ-DRCVITEM.
           READ DRCVITEM-I NEXT INTO BUF-DRCVITEM
             AT END MOVE FILE-STATUS TO FILE-STATUS.

       31-EXIT.
           EXIT.

       32-READ-DCODE.
           READ DCODE-I NEXT INTO BUF-DCODE
             AT END MOVE FILE-STATUS TO FILE-STATUS.

       32-EXIT.
           EXIT.

       33-READ-MSTORERM.
           READ MSTORERM-I INTO BUF-MSTORERM
             INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.

       33-EXIT.
           EXIT.

       34-READ-DPORECD.
           READ DPORECD-I INTO BUF-DPORECD
             INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.

       34-EXIT.
           EXIT.

       35-READ-DVENDOR.
           READ DVENDOR-I NEXT INTO BUF-DVENDOR
             AT END MOVE FILE-STATUS TO FILE-STATUS.

       35-EXIT.
           EXIT.

       6-MAIN.
           MOVE LOW-VALUES TO PORCVNO OF DRCVITEM-REC-I.
           MOVE 0 TO COND-WORD.
           START DRCVITEM-I KEY > PORCVNO OF DRCVITEM-REC-I
             INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
              MOVE "START DRCVITEM 6-MN TMACOSRP" TO BU-DISPLAY-MSG
              PERFORM 9999-BLOWUP THRU 9999-EXIT.

           MOVE "N" TO END-DRCVITEM-FLAG.
           PERFORM 60-PROCESS-RECEIVER THRU 60-EXIT
              UNTIL END-DRCVITEM-FLAG = "Y".

       6-EXIT.
           EXIT.

       60-PROCESS-RECEIVER.
           MOVE 0 TO COND-WORD.
           PERFORM 31-READ-DRCVITEM THRU 31-EXIT.
           IF FILE-STATUS NOT = "00"
              IF FILE-STATUS = "10" OR "14" OR "46"
                 MOVE 15 TO COND-WORD
                 MOVE "Y" TO END-DRCVITEM-FLAG
              ELSE
                 MOVE 99 TO COND-WORD.
           IF END-OF-CHAIN
              GO TO 60-EXIT.
           IF NOT GOOD-CALL
              MOVE "READ DRCVITEM 6-MN TMACOSRP" TO BU-DISPLAY-MSG
              PERFORM 9999-BLOWUP THRU 9999-EXIT.
           ADD 1 TO RECORDS-READ.

      *-----  ONLY KEEP RECEIPTS FOR CORPORATE CODED MATERIALS

           IF RCV-CORP-CODE = "NON-STR"
              PERFORM 9000-KICKOUT-RTN THRU 9000-EXIT
              GO TO 60-EXIT.
           MOVE RCV-CORP-CODE TO MAJ-GRP-1-2.

      *-----  ONLY KEEP RECEIPTS FOR RAW MATERIALS CODES

           IF MAJ-GRP-1-2 < "26" OR > "29"
              PERFORM 9000-KICKOUT-RTN THRU 9000-EXIT
              GO TO 60-EXIT.
           MOVE RCV-DATE-RCVD TO FILE-YMD.

      *-----  ONLY KEEP RECEIPTS IN DATE RANGE

           IF FILE-YM NOT = COMP-YM
              PERFORM 9000-KICKOUT-RTN THRU 9000-EXIT
              GO TO 60-EXIT.
           MOVE RCV-CORP-CODE TO CORPCDE OF DCODE-REC-I.
           MOVE 0 TO COND-WORD.
           START DCODE-I KEY = CORPCDE OF DCODE-REC-I
             INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
              MOVE "START DCODE 60 TMACOSRP" TO BU-DISPLAY-MSG
              PERFORM 9999-BLOWUP THRU 9999-EXIT.
           MOVE SPACES TO SAVE-KEYWORD-MOD.
           PERFORM 600-GET-KWRD THRU 600-EXIT.

      *-----  ONLY KEEP RECEIPTS FOR MATERIAL NAMES BEGINNING
      *-----  WITH THE LETTERS "CODE"

           IF SAVE-KM-CODE NOT = "CODE"
              PERFORM 9000-KICKOUT-RTN THRU 9000-EXIT
              GO TO 60-EXIT.

      *-----  RECEIPT MEETS MACOS REQUIREMENTS.  NOW CHECK QUANTITY
      *-----  UM FOR "LB", IF NOT ATTEMPT TO CONVERT.  IF CANNOT CONVERT
      *-----  THEN LEAVE ORIGINAL UM IN FILE TO INDICATE ERROR.
      *-----  FINALLY TRY TO FIND VENDOR NAME FOR RECEIPT AND WRITE
      *-----  RECEIPT INFORMATION TO DETAIL FILE

           MOVE SPACES TO CONVERT-FLAG.
           PERFORM 601-GET-QUANTITY-UM THRU 601-EXIT.
           PERFORM 602-GET-VENDOR-NAME THRU 602-EXIT.
           PERFORM 603-WRITE-RECORD    THRU 603-EXIT.

       60-EXIT.
           EXIT.

       600-GET-KWRD.
           MOVE 0 TO COND-WORD.
           PERFORM 32-READ-DCODE THRU 32-EXIT.
           IF FILE-STATUS NOT = "00"
              IF FILE-STATUS = "10" OR "14" OR "46"
                 MOVE 15 TO COND-WORD
              ELSE
                 MOVE 99 TO COND-WORD.
           IF GOOD-CALL
              IF RCV-CORP-CODE NOT EQUAL TO CODE-KEY-CODE
                 THEN MOVE 15 TO COND-WORD.
           IF END-OF-CHAIN
              GO TO 600-EXIT.
           IF NOT GOOD-CALL
              MOVE "READ DCODE 600 TMACOSRP" TO BU-DISPLAY-MSG
              PERFORM 9999-BLOWUP THRU 9999-EXIT.

      *-----  ONLY GET ENGLISH CODE DESCRIPTION FROM DCODE

           IF CODE-LANGUAGE-IND = CDEIDX
              MOVE CODE-KEYWORD-MOD TO SAVE-KEYWORD-MOD
              GO TO 600-EXIT
           ELSE
              GO TO 600-GET-KWRD.

       600-EXIT.
           EXIT.

       601-GET-QUANTITY-UM.
           MOVE ZEROS TO CALC-QTY-DLVR.

      *-----  IF RECEIVED IN "LB", THEN NO CONVERSION NECESSARY

           IF RCV-ITEM-UM = "LB"
              MOVE RCV-QTY-DLVR TO CALC-QTY-DLVR
              MOVE RCV-ITEM-UM  TO SAVE-UM
              GO TO 601-EXIT.

      *-----  NEED TO GET CONVERSION FACTORS/UM FOR CORPCDE FROM DB

           MOVE RCV-CORP-CODE TO CORPCDE OF MSTORERM-REC-I.
           MOVE 0 TO COND-WORD.
           PERFORM 33-READ-MSTORERM THRU 33-EXIT.
           IF FILE-STATUS NOT = "00"
              MOVE "READ MSTORERM 601 TMACOSRP" TO BU-DISPLAY-MSG
              PERFORM 9999-BLOWUP THRU 9999-EXIT.
           MOVE SPACES TO UM-DB-FLAG.
           IF STR-UM = "LB"
              MOVE "1" TO UM-DB-FLAG
           ELSE IF STR-UM1 = "LB"
              MOVE "2" TO UM-DB-FLAG
           ELSE IF STR-UM2 = "LB"
              MOVE "3" TO UM-DB-FLAG.

      *-----  LB MUST BE IN ONE OF THE UM FOR CODE TO CONVERT QTY

           IF UM-DB-FLAG EQUAL SPACES
              MOVE "N" TO CONVERT-FLAG
              MOVE RCV-ITEM-UM  TO SAVE-UM
              MOVE RCV-QTY-DLVR TO CALC-QTY-DLVR
              GO TO 601-EXIT.

      *-----  DETERMINE WHICH DATABASE UM THE MATERIAL RECEIVED IN

           MOVE SPACES TO UM-RCVD-FLAG.
           IF RCV-ITEM-UM = STR-UM
              MOVE "1" TO UM-RCVD-FLAG
           ELSE IF RCV-ITEM-UM = STR-UM1
                   MOVE "2" TO UM-RCVD-FLAG
           ELSE IF RCV-ITEM-UM = STR-UM2
                   MOVE "3" TO UM-RCVD-FLAG.

      *-----  CONVERT QTY BASED ON UM IT WAS RECEIVED IN USING THE
      *-----  CONVERSION FACTORS FOR THE CODE FROM THE STORERM DB

           IF RCVD-IN-PRIM
              PERFORM 6010-CONVERT-FROM-PRIM THRU 6010-EXIT
           ELSE IF RCVD-IN-ALT1
                   PERFORM 6011-CONVERT-FROM-ALT1 THRU 6011-EXIT
           ELSE IF RCVD-IN-ALT2
                   PERFORM 6012-CONVERT-FROM-ALT2 THRU 6012-EXIT
           ELSE
              MOVE "N" TO CONVERT-FLAG
              MOVE RCV-ITEM-UM  TO SAVE-UM
              MOVE RCV-QTY-DLVR TO CALC-QTY-DLVR.

       601-EXIT.
           EXIT.

       6010-CONVERT-FROM-PRIM.
           IF LB-IN-ALT1-DB
              IF STR-UM1-CF NOT NUMERIC
                 MOVE "N" TO CONVERT-FLAG
                 MOVE RCV-ITEM-UM  TO SAVE-UM
                 MOVE RCV-QTY-DLVR TO CALC-QTY-DLVR
                 GO TO 6010-EXIT
              ELSE
                 MOVE "LB" TO SAVE-UM
                 COMPUTE CALC-QTY-DLVR = RCV-QTY-DLVR / STR-UM1-CF
                 GO TO 6010-EXIT.
           IF LB-IN-ALT2-DB
              IF STR-UM2-CF NOT NUMERIC
                 MOVE "N" TO CONVERT-FLAG
                 MOVE RCV-ITEM-UM  TO SAVE-UM
                 MOVE RCV-QTY-DLVR TO CALC-QTY-DLVR
              ELSE
                 MOVE "LB" TO SAVE-UM
                 COMPUTE CALC-QTY-DLVR = RCV-QTY-DLVR / STR-UM2-CF.

       6010-EXIT.
           EXIT.

       6011-CONVERT-FROM-ALT1.
           IF STR-UM1-CF NOT NUMERIC
              MOVE "N" TO CONVERT-FLAG
              MOVE RCV-ITEM-UM TO SAVE-UM
              MOVE RCV-QTY-DLVR TO CALC-QTY-DLVR
              GO TO 6011-EXIT.
           COMPUTE CALC-QTY-DLVR = RCV-QTY-DLVR * STR-UM1-CF.
           IF LB-IN-PRIM-DB
              MOVE "LB" TO SAVE-UM
              GO TO 6011-EXIT.
           IF STR-UM2-CF NOT NUMERIC
              MOVE "N" TO CONVERT-FLAG
              MOVE RCV-ITEM-UM TO SAVE-UM
              MOVE RCV-QTY-DLVR TO CALC-QTY-DLVR
              GO TO 6011-EXIT.
           COMPUTE CALC-QTY-DLVR = CALC-QTY-DLVR / STR-UM2-CF.
           MOVE "LB" TO SAVE-UM.

       6011-EXIT.
           EXIT.

       6012-CONVERT-FROM-ALT2.
           IF STR-UM2-CF NOT NUMERIC
              MOVE "N" TO CONVERT-FLAG
              MOVE RCV-ITEM-UM TO SAVE-UM
              MOVE RCV-QTY-DLVR TO CALC-QTY-DLVR
              GO TO 6012-EXIT.
           COMPUTE CALC-QTY-DLVR = RCV-QTY-DLVR * STR-UM2-CF.
           IF LB-IN-PRIM-DB
              MOVE "LB" TO SAVE-UM
              GO TO 6012-EXIT.
           IF STR-UM1-CF NOT NUMERIC
              MOVE "N" TO CONVERT-FLAG
              MOVE RCV-ITEM-UM TO SAVE-UM
              MOVE RCV-QTY-DLVR TO CALC-QTY-DLVR
              GO TO 6012-EXIT.
           COMPUTE CALC-QTY-DLVR = CALC-QTY-DLVR / STR-UM1-CF.
           MOVE "LB" TO SAVE-UM.

       6012-EXIT.
           EXIT.

       602-GET-VENDOR-NAME.
           MOVE RCV-PO-RCV-NO   TO SAVE-PO-RCV-NO.
           MOVE SAVE-PO-NO      TO BUILD-PO-NO.
           MOVE BUILD-PO-RCV-NO TO PORCVNO OF DPORECD-REC-I
           MOVE 0 TO COND-WORD.
           MOVE SPACES TO BUF-DPORECD.
           PERFORM 34-READ-DPORECD THRU 34-EXIT.
           IF FILE-STATUS NOT = "00"
              MOVE "NAME NOT AVAILABLE" TO SAVE-VENDOR-NAME
              GO TO 602-EXIT.
           MOVE PO-VEN-CODE   TO VENCDE OF DVENDOR-REC-I.
           MOVE 0 TO COND-WORD.
           MOVE SPACES TO BUF-DVENDOR.
           START DVENDOR-I KEY = VENCDE OF DVENDOR-REC-I
             INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
              MOVE "NAME NOT AVAILABLE" TO SAVE-VENDOR-NAME
              GO TO 602-EXIT.
           MOVE 0 TO COND-WORD.
           PERFORM 35-READ-DVENDOR THRU 35-EXIT.
           IF FILE-STATUS NOT = "00"
              MOVE "NAME NOT AVAILABLE" TO SAVE-VENDOR-NAME
              GO TO 602-EXIT.
           IF VEN-VEN-CODE NOT EQUAL PO-VEN-CODE
              MOVE "NAME NOT AVAILABLE" TO SAVE-VENDOR-NAME
              GO TO 602-EXIT.
           IF VEN-ITM-NO NOT EQUAL "00"
              MOVE "NAME NOT AVAILABLE" TO SAVE-VENDOR-NAME
              GO TO 602-EXIT.
           MOVE VEN-ITM-DATA            TO SAVE-VENDOR-NAME.

       602-EXIT.
           EXIT.

       603-WRITE-RECORD.
           INITIALIZE OUTPUT-RECORD.
           MOVE SAVE-PLANT-ID      TO OUT-PLANT-ID.
           MOVE SAVE-PLANT         TO OUT-PLANT.
           MOVE SAVE-DATE-LIT      TO OUT-DATE-LIT.
           MOVE FILE-CYMD          TO OUT-DATE-RCVD.
           MOVE SAVE-MODIFIER      TO OUT-GDYR-CODE.
           MOVE SAVE-VENDOR-NAME   TO OUT-VENDOR-NAME.
           MOVE SAVE-UM            TO OUT-UM.
           MOVE CALC-QTY-DLVR      TO OUT-QTY-RCVD.
           MOVE RCV-ITEM-UM        TO OUT-ORIG-UM.
           MOVE RCV-QTY-DLVR       TO OUT-ORIG-QTY-RCVD.
           MOVE SAVE-PO-NO         TO OUT-PO-NO.
           MOVE SAVE-RCV-NO        TO OUT-RCV-NO.
           MOVE RCV-ITEM-NUMBER    TO OUT-RCV-ITEM-NO.
           MOVE PO-VEN-CODE        TO OUT-VENDOR-CODE.
           MOVE RCV-CORP-CODE      TO OUT-CORP-CODE.
           MOVE OUTPUT-RECORD      TO MACOS-RECORD.
           WRITE MACOS-RECORD.
           ADD 1 TO RECORDS-WRITTEN.

       603-EXIT.
           EXIT.

       9000-KICKOUT-RTN.
           ADD 1 TO KICKOUT-COUNT.
      *    MOVE RCV-CORP-CODE TO KICKOUT-CODE.
      *    DISPLAY KICKOUT-TEXT " FOR CODE : " KICKOUT-CODE.
      *    DISPLAY "+++++  PURCHASE ORDER/RCV SLIP : " RCV-PO-RCV-NO.
      *    DISPLAY "+++++  RECEIVER ITEM NUMBER    : " RCV-ITEM-NUMBER.
      *    IF KICKOUT-TYPE NOT EQUAL SPACES
      *       IF KICKOUT-TYPE = "D"
      *          MOVE RCV-DATE-RCVD   TO KICKOUT-VALUE
      *       ELSE IF KICKOUT-TYPE = "K"
      *          MOVE SAVE-KEYWORD    TO KICKOUT-VALUE
      *       ELSE IF KICKOUT-TYPE = "U"
      *          STRING "RCV UM:"
      *                 RCV-ITEM-UM
      *                 " PRI UM:"
      *                 STR-UM
      *                 " ALT1:"
      *                 STR-UM1
      *                 " ALT2:"
      *                 STR-UM2          DELIMITED BY SIZE
      *                 INTO             KICKOUT-VALUE.
      *    IF KICKOUT-TYPE NOT EQUAL SPACES
      *       DISPLAY "+++++  FIELD: " KICKOUT-VALUE.
      *    MOVE SPACES TO KICKOUT-CODE
      *                   KICKOUT-TEXT
      *                   KICKOUT-TYPE
      *                   KICKOUT-VALUE.

       9000-EXIT.
           EXIT.

       9999-BLOWUP.
           MOVE "TMACOSRP"   TO  BU-PGM-NAME.
           CALL "TBLOWUP" USING BASE, BU-PGM-NAME, STATUS-AREA,
               VIEW-COMAREA, DUMMY-KSAM-STAT, BU-DISPLAY-MSG,
                       BU-DISPLAY-FLDS.

       9999-EXIT.
           EXIT.
