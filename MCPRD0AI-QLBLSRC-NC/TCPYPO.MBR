           05  MSG-TEXT-AS400 REDEFINES MSG-TEXT-HP
                                         PIC X(38).

014700
015200 01  FIELD-NUMBER                  PIC S9(4)  VALUE 1 COMP-4.
015400
015500 01  PASSED-SPOOL-PRT              PIC S9(2)  VALUE ZEROS COMP-4.
015600
015700 01  SCREEN-PRINT-PARMS.
015800     05  PRINTCNTL             PIC S9(4)    VALUE ZERO  COMP-4.
015900     05  PAGECNTL              PIC S9(4)    VALUE 49    COMP-4.
016000     05  SPOOLFIL-OPEN-SW      PIC X        VALUE "N".
016100
       COPY DISPDATA IN COPYLIB.

       COPY IOFEEDBACK IN COPYLIB.

       COPY CATREAD IN COPYLIB.
016200
016800
