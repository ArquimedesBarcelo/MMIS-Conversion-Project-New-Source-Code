020800*                   *
020900*   DATA SET NAMES  *
021000*                   *
021100*********************
021200
021300 01  DSET-NAMES.
021400     05  DSET-NAME              PIC X(16)  VALUE SPACES.
021500     05  DSET-MSTORERM          PIC X(16)  VALUE "MSTORERM;".
021600     05  DSET-MPLTINFO          PIC X(16)  VALUE "MPLTINFO;".
021700     05  DSET-DPOITEM           PIC X(16)  VALUE "DPOITEM;".
021800     05  DSET-MPORCV            PIC X(16)  VALUE "MPORCV;".
021900     05  DSET-DPORECD           PIC X(16)  VALUE "DPORECD;".
022000     05  DSET-DPODATAITM        PIC X(16)  VALUE "DPODATAITM;".
022100
022200 01 ITEMS-LISTING.
022300     05  ALL-ITEMS              PIC XX    VALUE "@;".
022400     05  PO-SEARCH              PIC X(10) VALUE "PO-RCV-NO;".
022500
022600 01 ARG-VALUES.
022700     05  CODE-ARG               PIC X(8)  VALUE SPACES.
022800     05  PLT-ARG                PIC X(4)  VALUE SPACES.
022900     05  PO-ARG                 PIC X(14) VALUE SPACES.
023600
023700************************************
023800*
023900*  PARAMETERS FOR CALLING
024000*  STC320.SOURCE
024100*
024200************************************
024300
024400 COPY STC320 IN COPYLIB.
024500
024600*************************************
024700*
024800*  PARAMETERS FOR CALLING 'STC360'
024900*  WHICH IS THE SUBROUTINE FOR CUTTING
025000*  TC 360 AND 361s
025100*************************************
025200
025300 01  STC360-TC                    PIC X(3) VALUE SPACES.
025400 01  COMPANY-SAVE                 PIC X(3) VALUE SPACES.
025500
       COPY CCRTFILE IN COPYLIB.

025600 COPY LANGUAGE IN COPYLIB.
025700
025800 COPY TBLOWUP IN COPYLIB.
025900
026000
026100 PROCEDURE DIVISION.
026200
026300 PROC-DIV SECTION 01.
026400
026500 BEGIN-HERE.
026600     PERFORM 1-HSK THRU 1-H-X.
026700
026800     PERFORM 6-MAIN THRU 6-M-X.
026900
027000     PERFORM 2-EOJ  THRU 2-EOJ-X.
027100
027200     GOBACK.
027300
027400 1-HSK.
           OPEN I-O  DISPLAY-FILE, MPORCV-O, DPORECD-O, DPOITEM-O,
                     DPODATAITM-O.
           OPEN INPUT MPLTINFO-I, MSTORERM-I.
031500
031600     MOVE "P 01"         TO  PLT-ARG.
           MOVE PLT-ARG TO PLTINFOKEY OF MPLTINFO-REC-I.
           READ MPLTINFO-I INTO BUF-MPLTINFO
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
032000         MOVE "1-HSK"   TO  BU-DISPLAY-MSG
032100         MOVE PLT-ARG   TO  BU-DISPLAY-FLD (3)
032200         GO TO 2-BLOWUP
           ELSE
               MOVE MPLTINFO-COMPANY TO COMPANY-SAVE.
032300
DCR01 **--------------------------------------------------------------
DCR01      MOVE PLTINFODTA(1:3)  TO WS-Z000-PLANT-CODE.
DCR01 **--------------------------------------------------------------

DCR01      PERFORM Z000-PGM-SETUP     THRU Z000-PS-EXIT.

032400 1-H-X.
032500     EXIT.
032600
DCR01  Z000-PGM-SETUP.
DCR01 *****************************************************
DCR01 *   MAKE SURE PO LOGGING IS ACTIVE FOR THIS PLANT
DCR01 *****************************************************
DCR01      SET  Z000-POLG-ACTIVE-NO TO TRUE.
DCR01
DCR01      MOVE WS-Z000-POLG-KEY TO PLTINFOKEY.
DCR01      READ MPLTINFO-I INTO BUF-MPLTINFO.
DCR01      IF FILE-STATUS = "00"
DCR01         IF  PLTINFODTA(1:1) = "Y"
DCR01             SET  Z000-POLG-ACTIVE-YES TO TRUE
DCR01         END-IF
DCR01      END-IF.

DCR01  Z000-PS-EXIT.
DCR01      EXIT.


       2-EOJ.
           CLOSE  DISPLAY-FILE, MPORCV-O, DPORECD-O, DPOITEM-O,
                  DPODATAITM-O, MPLTINFO-I, MSTORERM-I.
034800 2-EOJ-X.
034900      EXIT.
035000
035100******************************************************
035200**                                                  **
035300**   BLOWUP ROUTINE                                 **
035400**                                                  **
035500******************************************************
035600
035700 2-BLOWUP.
035800     MOVE "TCPYPO"  TO  BU-PGM-NAME.
035900     CALL "TBLOWUP" USING BASE, BU-PGM-NAME, STATUS-AREA,
036000         VIEW-COMAREA, FILE-STATUS, BU-DISPLAY-MSG,
036100             BU-DISPLAY-FLDS.
039000
039100
039200 4-PGM-ERROR.
           MOVE B"1" TO IND (FIELD-NUMBER) IND (99).
           MOVE MESSAGE-BUFFER TO TRM-MESSAGE-LINE.
040000
040100 4-PGM-ERROR-X.
040200     EXIT.
040300
042300
042400 6-MAIN.
042500     PERFORM 61-CHANGE-BLK-NO  THRU  61-CBN-X.
042600     IF EOJ-SW  =  "Y"
042700         GO TO 6-M-X.
042800     GO TO 6-MAIN.
042900
043000 6-M-X.
043100     EXIT.
043200
043300 61-CHANGE-BLK-NO.
043400     MOVE "CPYPO"  TO  VIEW-NFNAME.
044800     MOVE SPACES   TO  SCREEN-1.
045500
045600 61-SHOWFORM-SCREEN-1.
           MOVE SCREEN-1       TO DISPLAY-REC.
           PERFORM 998-WRITE-SCREEN THRU 998-READ-SCREEN.
           MOVE DISPLAY-REC    TO SCREEN-1.
046300
046400     IF VIEW-LASTKEY = 3
046500         MOVE "Y"  TO  EOJ-SW
046600         GO TO 61-CBN-X
046700     ELSE
048100     IF VIEW-LASTKEY = 1 OR
048200        VIEW-LASTKEY = 2 OR
048300        VIEW-LASTKEY = 4 OR
048400        VIEW-LASTKEY = 5 OR
048500        VIEW-LASTKEY = 6 OR
048600        VIEW-LASTKEY = 7 OR
              VIEW-LASTKEY = 8
048800         MOVE   9 TO LANG-SETNUM
048900         MOVE  10 TO LANG-MSGNUM
049000         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
049100         MOVE 1  TO  FIELD-NUMBER
049200         PERFORM 4-PGM-ERROR  THRU  4-PGM-ERROR-X
049300         GO TO 61-SHOWFORM-SCREEN-1.
049400
      *------ FIELD EDITS
           IF TRM-OLD-BLKT = SPACES
      *         PURCHASE ORDER NUMBER IS REQUIRED
               MOVE 42134 TO CATREAD-MSG-NUMBER
069800         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
069900         MOVE 1  TO FIELD-NUMBER
070000         PERFORM 4-PGM-ERROR  THRU  4-PGM-ERROR-X
070100         GO TO 61-SHOWFORM-SCREEN-1.
051300
           IF TRM-NEW-BLKT = SPACES
      *         PURCHASE ORDER NUMBER IS REQUIRED
               MOVE 42134 TO CATREAD-MSG-NUMBER
069800         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
069900         MOVE 2  TO FIELD-NUMBER
070000         PERFORM 4-PGM-ERROR  THRU  4-PGM-ERROR-X
070100         GO TO 61-SHOWFORM-SCREEN-1.
051300
           IF TRM-EXP-DATE = SPACES
      *         EXPIRATION DATE IS REQUIRED
               MOVE 66155 TO CATREAD-MSG-NUMBER
069800         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
069900         MOVE 3  TO FIELD-NUMBER
070000         PERFORM 4-PGM-ERROR  THRU  4-PGM-ERROR-X
070100         GO TO 61-SHOWFORM-SCREEN-1.

051400 61-EDIT-PO-NO.
051500     MOVE "000"                   TO  PO-REL.
051600     MOVE "000"                   TO  PO-RCV.
051700     MOVE TRM-OLD-BLKT            TO  PO-NO.
051800     MOVE BUILD-PO-SEARCH         TO  PO-ARG,
051900                                      SAVE-OLD-PO-NUM,
052000                                      BU-DISPLAY-FLD (1).
           MOVE PO-ARG TO PORCVNO OF MPORCV-REC-O.
           READ MPORCV-O INTO BUF-MPORCV
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
              IF FILE-STATUS-1 = "2"
                   MOVE 0 TO PO-SW
                   PERFORM 610-CHECK-4-PO
                   IF PO-SW = 0
                       MOVE  16 TO LANG-SETNUM
                       MOVE  45 TO LANG-MSGNUM
                       PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                       MOVE 1  TO  FIELD-NUMBER
                       PERFORM 4-PGM-ERROR  THRU  4-PGM-ERROR-X
                       GO TO 61-SHOWFORM-SCREEN-1
                   ELSE
                   GO TO 61-EDIT-NEW-NUM
053100         ELSE
053200             MOVE "GET MPORCV * 61-EBN"  TO  BU-DISPLAY-MSG
053300             GO TO 2-BLOWUP.

      *------- DO A START > HIGH-VALUES TO UNLOCK
           MOVE HIGH-VALUES TO PORCVNO OF MPORCV-REC-O.
           START MPORCV-O KEY > PORCVNO OF MPORCV-REC-O
               INVALID KEY MOVE "00" TO FILE-STATUS.
054200
054300 61-EDIT-NEW-NUM.
054400     MOVE TRM-NEW-BLKT                 TO  PO-NO.
054500     MOVE BUILD-PO-SEARCH              TO  PO-ARG,
054600                                           SAVE-NEW-PO-NUM,
054700                                           BU-DISPLAY-FLD (2).
           MOVE PO-ARG TO PORCVNO OF MPORCV-REC-O.
           READ MPORCV-O INTO BUF-MPORCV
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
                   NEXT SENTENCE
               ELSE
056100             MOVE "GET MPORCV * 61-ENN" TO BU-DISPLAY-MSG
056200             GO TO 2-BLOWUP
           ELSE
055100         MOVE  16 TO LANG-SETNUM
055200         MOVE  64 TO LANG-MSGNUM
055300         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
055400         MOVE 2  TO  FIELD-NUMBER
055500         PERFORM 4-PGM-ERROR THRU 4-PGM-ERROR-X
      *------- DO A START > HIGH-VALUES TO UNLOCK
               MOVE HIGH-VALUES TO PORCVNO OF MPORCV-REC-O
               START MPORCV-O KEY > PORCVNO OF MPORCV-REC-O
                   INVALID KEY MOVE "00" TO FILE-STATUS END-START
055600         GO TO 61-SHOWFORM-SCREEN-1.
056300
056400 61-EDIT-PO-STATUS.
056500     MOVE SAVE-OLD-PO-NUM    TO  PO-ARG.
           MOVE PO-ARG TO PORCVNO OF DPORECD-REC-O.
           START DPORECD-O KEY = PORCVNO OF DPORECD-REC-O
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
056900         MOVE "FIND * 61-EPS"  TO  BU-DISPLAY-MSG
057000         GO TO 2-BLOWUP.
057100
           READ DPORECD-O NEXT INTO BUF-DPORECD
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00" OR
              PORCVNO OF DPORECD-REC-O NOT = PO-ARG
057500         MOVE "GET * 61-EPS"   TO  BU-DISPLAY-MSG
057600         GO TO 2-BLOWUP.
057700
      *------- DO A START > HIGH-VALUES TO UNLOCK
           MOVE HIGH-VALUES TO PORCVNO OF DPORECD-REC-O.
           START DPORECD-O KEY > PORCVNO OF DPORECD-REC-O
               INVALID KEY MOVE "00" TO FILE-STATUS.

057800********************************
057900**                            **
058000**   EDIT EXPIRATION DATE     **
058100**                            **
058200********************************
058300
058400     MOVE TRM-EXP-DATE            TO DATE-VALIDATE-IN.
058500     MOVE 3                       TO DATE-MODE.
058600     CALL "TDATECK2" USING DATE-CHECK-AREA, LANGUAGE-PARMS.
058700     IF DATE-RET-CODE NOT = 0
058800         MOVE DATE-MSG            TO MESSAGE-BUFFER
058900         MOVE 3                   TO FIELD-NUMBER
059000         PERFORM 4-PGM-ERROR  THRU 4-PGM-ERROR-X
059100         GO TO 61-SHOWFORM-SCREEN-1
059200     ELSE
059300     MOVE DATE-YMD-OUT            TO SAVE-EXP-DATE
           IF SAVE-EXP-DATE-YY > "70"
               MOVE "19"                TO SAVE-EXP-DATE-CC
           ELSE
           MOVE "20"                    TO SAVE-EXP-DATE-CC.
059400
      *      NOW PROCESSING
059500     MOVE  14 TO LANG-SETNUM.
059600     MOVE   2 TO LANG-MSGNUM.
059700     PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
           MOVE MESSAGE-BUFFER TO TRM-COMMAND-LINE.
           MOVE B"1" TO IND (98).
           MOVE SCREEN-1 TO DISPLAY-REC.
           PERFORM 998-WRITE-SCREEN.
           PERFORM 998-AUTO-READ-SCREEN.
061200
061300 61-BUILD-NEW-BLKT.
063300     MOVE SPACES                  TO  BUF-MPORCV.
063400     MOVE SAVE-NEW-PO-NUM         TO  M-PO-RCV-NO.
           WRITE MPORCV-REC-O FROM BUF-MPORCV
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
063900         MOVE "PUT * 61-BNB"  TO  BU-DISPLAY-MSG
064000         GO TO 2-BLOWUP.
064100
064200 61-BUILD-DPORECD.
064300     MOVE SAVE-NEW-PO-NUM         TO  PO-RCV-NO.
064400     MOVE SAVE-EXP-DATE-CYMD      TO  PO-EXPECT-DATE-CN.
           ACCEPT PO-DATE FROM DATE.
           IF PO-DATE-YY > "70"
               MOVE "19"                TO  PO-DATE-CC
           ELSE
           MOVE "20"                    TO  PO-DATE-CC.
           MOVE SPACES                  TO  PO-LAST-PAYMENT.
           WRITE DPORECD-REC-O FROM BUF-DPORECD
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
065100         MOVE "PUT DPORECD * 61-BD"  TO  BU-DISPLAY-MSG
065200         GO TO 2-BLOWUP.

DCR01 **-------------------------------------------------------------
DCR01      IF  Z000-POLG-ACTIVE-YES
DCR01          MOVE SAVE-NEW-PO-NUM         TO  WS-Z000-PORCVNO
DCR01          PERFORM L000-LOG-ADD           THRU L000-ADD-EXIT
DCR01      END-IF.
DCR01 **-------------------------------------------------------------

066000**********************
066100*                    *
066200*CREATE TC 360       *
066300*                    *
066400**********************

066600     MOVE "360"                TO  STC360-TC.
066800     CALL "STC360" USING BASE,
066900                         COMPANY-SAVE,
067000                         STC360-TC,
067100                         BUF-DPORECD,
067200                         STATUS-AREA,
067300                         BU-DISPLAY-MSG,
067400                         BU-DISPLAY-FLDS.
067500     IF BU-DISPLAY-MSG NOT = SPACES
067600         GO TO 2-BLOWUP.
067800
067900     PERFORM 62-CREATE-BLKT  THRU  62-CB-X.

      *------- DO A START > HIGH-VALUES TO UNLOCK BOTH DPOITEM-O AND
      *------- DPODATAITM-O SINCE THEY ARE READ IN 62-CREATE-BLKT
           MOVE HIGH-VALUES TO PORCVNO OF DPOITEM-REC-O.
           START DPOITEM-O KEY > PORCVNO OF DPOITEM-REC-O
               INVALID KEY MOVE "00" TO FILE-STATUS.
           MOVE HIGH-VALUES TO PORCVNO OF DPODATAITM-REC-O.
           START DPODATAITM-O KEY > PORCVNO OF DPODATAITM-REC-O
               INVALID KEY MOVE "00" TO FILE-STATUS.
068000
           MOVE SPACES  TO SCREEN-1.
      *  PROCESS COMPLETE; ENTER NEXT ORDERS OR 'F3' TO EXIT
068800     MOVE  16 TO LANG-SETNUM.
068900     MOVE  86 TO LANG-MSGNUM.
069000     PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
           MOVE MESSAGE-BUFFER TO TRM-COMMAND-LINE.
           MOVE B"1" TO IND (98).
069300     GO TO 61-SHOWFORM-SCREEN-1.
069400
069500 61-CBN-X.
069600     EXIT.
069800
       610-CHECK-4-PO.
           MOVE "000"             TO PO-REL.
           MOVE BUILD-PO-SEARCH   TO PO-ARG,
                                     SAVE-OLD-PO-NUM,
                                     BU-DISPLAY-FLD (1).
           MOVE TRM-OLD-BLKT      TO PO-NO.
           MOVE BUILD-PO-SEARCH   TO PORCVNO OF DPORECD-REC-O.
           READ DPORECD-O INTO BUF-DPORECD
               INVALID KEY    MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               NEXT SENTENCE
           ELSE
               MOVE 1             TO PO-SW.
           MOVE HIGH-VALUES       TO PORCVNO OF DPORECD-REC-O,
                                                MPORCV-REC-O.
           START DPORECD-O KEY > PORCVNO OF DPORECD-REC-O
               INVALID KEY    MOVE "00" TO FILE-STATUS.
           START MPORCV-O KEY > PORCVNO OF MPORCV-REC-O
               INVALID KEY    MOVE "00" TO FILE-STATUS.

       62-CREATE-BLKT.
           MOVE PO-ARG TO PORCVNO OF DPOITEM-REC-O.
           START DPOITEM-O KEY = PORCVNO OF DPOITEM-REC-O
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
                   GO TO 62-CB-X
               ELSE
070400             MOVE "FIND * 62-CB"  TO  BU-DISPLAY-MSG
070500             GO TO 2-BLOWUP.
071000
071100     IF TRM-SORT-ITEM = "X"
071200         PERFORM 63-SORT-ITEMS  THRU 63-SI-X.
071300
071400     MOVE SPACES          TO  DONE-PROCESS-ITEMS.
071500     MOVE ZEROS           TO  TOTAL-ITEM-CTR.
071600     MOVE   8 TO LANG-SETNUM.
071700     MOVE   2 TO LANG-MSGNUM.
071800     PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
071900     MOVE MESSAGE-BUFFER TO LB-MT-1R.
072000     MOVE  66163 TO CATREAD-MSG-NUMBER.
072200     PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
072300     MOVE MESSAGE-BUFFER TO LB-MT-2R.
072400     MOVE  66162 TO CATREAD-MSG-NUMBER.
072600     PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
072700     MOVE MESSAGE-BUFFER TO LB-MT-3R.
072800     MOVE SPACES TO MESSAGE-BUFFER.
072900     MOVE LB-MT-1R  TO  MSG-TEXT-1R.
073000     MOVE LB-MT-2R  TO  MSG-TEXT-2R.
073100*    MOVE LB-MT-3R  TO  MSG-TEXT-3R.
           MOVE LB-MT-3R  TO  MSG-TEXT-AS400.
073200*    MOVE ZEROS           TO  MSG-ITEM-TOT.
073600
073700 62-START-READING-ITEMS.
073800     MOVE 0               TO  SUB.
073900
074000 62-GET-DPOITEM-CALC.
074100     ADD 1  TO  SUB.
074200     IF SUB > 10
074300         GO TO 62-DISPLAY-MESSAGE.
074400
074500*******************************************************
074600**   IF SORT BY CORP-CODE OPTION IS CHOSEN THEN
074700**   THEN USE THE SORTED ITEM FILE TO GET THE
074800**   RECORD ADDRESS OF THE ITEMS IN DPOITEM
074900*******************************************************
075000
075100     IF TRM-SORT-ITEM = "X"
075200         PERFORM 621-READ-ITEM-FILE
           ELSE
               PERFORM 621-READ-NEXT-DPOITEM.
075300     IF DONE-PROCESS-ITEMS = "Y"
075400         GO TO 62-DISPLAY-MESSAGE.
077100
077700     ADD 1                        TO  TOTAL-ITEM-CTR.
077900
078000     MOVE SAVE-NEW-PO-NUM         TO  ITM-PO-RCV-NO.
078100     IF TRM-SORT-ITEM = "X"
078200         MOVE TOTAL-ITEM-CTR      TO  ITM-NUMBER.
078300
078400     IF ITM-CORP-CODE = "NON-STR"
078500         NEXT SENTENCE
078600     ELSE
078700         MOVE ITM-CORP-CODE       TO  CODE-ARG
               MOVE CODE-ARG TO CORPCDE OF MSTORERM-REC-I
               READ MSTORERM-I INTO BUF-MSTORERM
                   INVALID KEY MOVE FILE-STATUS TO FILE-STATUS END-READ
               IF FILE-STATUS NOT = "00"
079100             MOVE "GET * 62-GDC"  TO  BU-DISPLAY-MSG
079200             GO TO 2-BLOWUP.

079300     IF ITM-CORP-CODE = "NON-STR"
079400         NEXT SENTENCE
079500     ELSE
079600         IF ITM-CLASS = SPACES
079700             MOVE STR-CLASS       TO ITM-CLASS.
079800
           MOVE 0      TO ITM-QTY-DLVR
                          ITM-QTY-STORED
                          ITM-QTY-PAID
           MOVE SPACES TO ITM-DATE-RCVD
                          ITM-DATE-STORED.

           WRITE DPOITEM-REC-O FROM BUF-DPOITEM
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
080200         MOVE "PUT DPOITEM * 62-GDC"  TO  BU-DISPLAY-MSG
080300         GO TO 2-BLOWUP.
080400
080500*******************************************************
080600**   IF SORTING THE NEW ORDER BY CORP CODE GO OUT AND
080700**   CHECK FOR ITEM DESCRIPTION BY ITEM NUMBER
080800*******************************************************
080900
081000     IF TRM-SORT-ITEM = "X"
081100         PERFORM 63-LOAD-DPODATAITM  THRU 63-LD-X.
081900
082000
082100**************************************************************
082200*                                                            *
082300*   THE FOLLOWING LOGIC TO UPDATE MSTORERM WITH LAST PO AND  *
082400*   PRICE INFORMATION HAS BEEN TAKEN OUT FOR NOW BECAUSE THE *
082500*   PLANTS DID NOT WANT THE PRIOR INFORMATION LOST UNTIL A   *
082600*   SHIPPING RELEASE FOR THE NEW PURCHASE ORDER IS           *
082700*   CREATED                                                  *
082800*                                                            *
082900**************************************************************
083000
           IF ITM-CORP-CODE = "NON-STR"
               NEXT SENTENCE
           ELSE
               MOVE COMPANY-SAVE            TO  SPOMSTRM-COMPANY-SAVE
               MOVE ITM-QTY-ORD             TO  SPOMSTRM-QTY
               MOVE ITM-UM                  TO  SPOMSTRM-QTY-UM
               MOVE ITM-UNIT-PRICE          TO  SPOMSTRM-PRICE
               MOVE ITM-PRICE-UM            TO  SPOMSTRM-PRICE-UM
               MOVE ITM-PO-NO               TO  SPOMSTRM-PO-NUM
               MOVE ITM-PO-REL              TO  SPOMSTRM-PO-RLSE
               MOVE PO-VEN-CODE             TO  SPOMSTRM-VEN-CODE
               MOVE PO-CURRENCY-CODE        TO  SPOMSTRM-CUR-CODE
               CALL "SPOMSTRM" USING BASE,
                                     CODE-ARG,
                                     SPOMSTRM-PARMS,
                                     ZBILL-PO-SW,
                                     STATUS-AREA,
                                     BU-DISPLAY-MSG,
                                     BU-DISPLAY-FLDS
               IF BU-DISPLAY-MSG NOT = SPACES
                   GO TO 2-BLOWUP.

083100
083200 62-BUILD-DDAILYTC-320.
083300     MOVE SPACES                  TO  STC320-PARMS.
083400     MOVE COMPANY-SAVE            TO  STC320-COMPANY-SAVE.
083500     MOVE "20"                    TO  STC320-ITEM-TC-ID.
083600     MOVE ITM-PO-RCV-NO           TO  STC320-PO-NUM.
083700     MOVE ITM-NUMBER              TO  STC320-ITEM.
083800     IF ITM-CORP-CODE = "NON-STR"
083900         MOVE "NC"                TO  STC320-CODE
084000         MOVE ITM-PRICE-UM        TO  STC320-QTY-UM,
084100                                      STC320-PRICE-UM
084200         MOVE ITM-UNIT-PRICE      TO  STC320-PRICE
084300     ELSE
084400         MOVE ITM-CORP-CODE       TO  STC320-CODE
084500         MOVE STR-UM              TO  STC320-QTY-UM,
084600                                      STC320-PRICE-UM
084700         IF ITM-PRICE-UM = STR-UM
084800             MOVE ITM-UNIT-PRICE  TO  STC320-PRICE
084900         ELSE
085000         IF ITM-PRICE-UM = STR-UM1
085100             DIVIDE ITM-UNIT-PRICE  BY STR-UM1-CF
085200                                  GIVING STC320-PRICE ROUNDED
085300         ELSE
085400         IF ITM-PRICE-UM = STR-UM2
085500             DIVIDE ITM-UNIT-PRICE  BY STR-UM2-CF
085600                                  GIVING STC320-PRICE ROUNDED
085700         ELSE
085800             MOVE ZEROS           TO  STC320-PRICE.
085900     MOVE ZEROS                   TO  STC320-QTY.
086000     MOVE ITM-TAX-CODE            TO  STC320-TAX-CODE.
086100     MOVE ZEROS                   TO  STC320-OLD-BUDGET-AMT.
086200     IF ITM-CLASS = SPACES
086300         IF ITM-CORP-CODE = "NON-STR"
086400             NEXT SENTENCE
086500         ELSE
086600             MOVE STR-CLASS       TO  STC320-SUB
086700     ELSE
086800         MOVE ITM-CLASS           TO  STC320-SUB.
           MOVE ITM-COMPANY             TO  STC320-COMPANY.
           MOVE ITM-PRIME               TO  STC320-PRIME.
086900     MOVE ITM-SUB-DETL            TO  STC320-SUBD.
087000     MOVE ITM-ADDL-DATA           TO  STC320-ADDTL-DATA.
087100     MOVE PO-BUDGET-NUMBER        TO  STC320-BUDGET-NO.
087200     MOVE PO-CURRENCY-CODE        TO  STC320-CUR-CODE.
087300     CALL "STC320" USING BASE,
087400                         STC320-PARMS,
087500                         STATUS-AREA,
087600                         BU-DISPLAY-MSG,
087700                         BU-DISPLAY-FLDS.
087800     IF BU-DISPLAY-MSG-1  NOT = SPACES
087900         GO TO 2-BLOWUP.

           GO TO 62-GET-DPOITEM-CALC.
088800
088900 62-DISPLAY-MESSAGE.
089000     MOVE TOTAL-ITEM-CTR   TO  MSG-ITEM-NO.
           MOVE MESSAGE-BUFFER TO TRM-COMMAND-LINE.
           MOVE B"1" TO IND (98).
           MOVE SCREEN-1 TO DISPLAY-REC.
           PERFORM 998-WRITE-SCREEN.
           PERFORM 998-AUTO-READ-SCREEN.
089600
089700     IF DONE-PROCESS-ITEMS = "Y"
089800         NEXT SENTENCE
089900     ELSE
090000         GO TO 62-START-READING-ITEMS.
090100
090200 62-UPDATE-DPODATAITM.
090300     IF TRM-SORT-ITEM = "X"
090400         CLOSE ITEM-FILE.
090500
           MOVE PO-ARG TO PORCVNO OF DPODATAITM-REC-O.
           START DPODATAITM-O KEY = PORCVNO OF DPODATAITM-REC-O
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
                   GO TO 62-CB-X
               ELSE
090900             MOVE "FIND * 62-UD"  TO  BU-DISPLAY-MSG
091000             GO TO 2-BLOWUP.
092900
093000 62-GET-DPODATAITM.
           READ DPODATAITM-O NEXT INTO BUF-DPODATAITM
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   GO TO 62-CB-X
               ELSE
                   MOVE "READ DPODATAITM *62-GD" TO BU-DISPLAY-MSG
                   GO TO 2-BLOWUP.
           IF PORCVNO OF DPODATAITM-REC-O NOT = PO-ARG
               GO TO 62-CB-X.
093900
094000**********************************************************
094100**   IF THE SORT BY CORP-CODE OPTION IS CHOSEN THEN
094200**   ONLY LOAD ITEM NUMBER ZEROS (STD INSTR) SINCE THE
094300**   ITEM DESCRIPTIONS WERE LOADED PREVIOUSLY
094400**********************************************************
094500
094600     IF TRM-SORT-ITEM = "X"
094700         IF DATAITM-ITEM-NO-9 = ZEROS
094800             NEXT SENTENCE
094900         ELSE
095000             GO TO 62-CB-X.
095200
095300     MOVE SAVE-NEW-PO-NUM       TO  DATAITM-PO-RCV-NO.
           WRITE DPODATAITM-REC-O FROM BUF-DPODATAITM
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
095700         MOVE "PUT DPODATAITM * 62-GD"  TO  BU-DISPLAY-MSG
095800         GO TO 2-BLOWUP.
095900
096300     GO TO 62-GET-DPODATAITM.
096400
097200 62-CB-X.
097300     EXIT.
097400
097500 621-READ-ITEM-FILE.
097600     READ ITEM-FILE
097700         AT END
097800             MOVE "Y"             TO DONE-PROCESS-ITEMS.
097900
           IF DONE-PROCESS-ITEMS NOT = "Y"
               MOVE PO-ARG           TO  PORCVNO OF DPOITEM-REC-O
               MOVE ITEM-NUMBER      TO  ITEMNO OF DPOITEM-REC-O
               READ DPOITEM-O INTO BUF-DPOITEM
                   INVALID KEY MOVE FILE-STATUS TO FILE-STATUS END-READ
               IF FILE-STATUS NOT = "00"
070300             MOVE "READ DPOITEM * 621-RIF" TO BU-DISPLAY-MSG
070400             GO TO 2-BLOWUP.
098100
098200 621-READ-NEXT-DPOITEM.
           READ DPOITEM-O NEXT INTO BUF-DPOITEM
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14"
                   MOVE "Y" TO DONE-PROCESS-ITEMS
               ELSE
                   MOVE "READ NEXT DPOITEM *621-RND" TO BU-DISPLAY-MSG
                   GO TO 2-BLOWUP
           ELSE
               IF PORCVNO OF DPOITEM-REC-O NOT = PO-ARG
                   MOVE "Y" TO DONE-PROCESS-ITEMS.
098300
098400 63-SORT-ITEMS.
           MOVE "READING ITEMS AND LOADING SORT FILE" TO MESSAGE-BUFFER.
           MOVE MESSAGE-BUFFER TO TRM-COMMAND-LINE.
           MOVE B"1" TO IND (98).
           MOVE SCREEN-1 TO DISPLAY-REC.
           PERFORM 998-WRITE-SCREEN.
           PERFORM 998-AUTO-READ-SCREEN.
099500
      *----- CALL CCRTFILE TO CREATE A TEMPORARY FILE 'ITEMFILE'
      *----- LIBRARY 'QTEMP' IS USED FOR TEMPORARY FILES
           MOVE SPACES        TO CCRTFILE-PARMS.
           MOVE "QTEMP"       TO CCRTFILE-LIBRARY.
           MOVE "ITEMFILE"    TO CCRTFILE-FILE.
           MOVE "0011"        TO CCRTFILE-RECORD-LENGTH.
           MOVE "00500"       TO CCRTFILE-NO-RECORDS.
           MOVE "00100"       TO CCRTFILE-INCREMENT-AMT.
           MOVE "10"          TO CCRTFILE-NO-INCREMENTS.
           CALL "CCRTFILE" USING CCRTFILE-LIBRARY,
                                 CCRTFILE-FILE,
                                 CCRTFILE-RECORD-LENGTH,
                                 CCRTFILE-NO-RECORDS,
                                 CCRTFILE-INCREMENT-AMT,
                                 CCRTFILE-NO-INCREMENTS,
                                 CCRTFILE-STATUS.
           IF CCRTFILE-STATUS NOT = "00"
               MOVE "CCRTFILE CREATE OF 'PRNTWORK' FAILED"
                  TO BU-DISPLAY-MSG
               GO TO 2-BLOWUP.

099600     OPEN OUTPUT ITEM-FILE.
           MOVE ZEROS TO COND-WORD.
099700     PERFORM 64-LOAD-ITEM-FILE
099800         UNTIL END-OF-CHAIN
099900     CLOSE ITEM-FILE.
100000
           MOVE "SORTING ITEMS BY CORPORATE CODE" TO MESSAGE-BUFFER.
           MOVE MESSAGE-BUFFER TO TRM-COMMAND-LINE.
           MOVE B"1" TO IND (98).
           MOVE SCREEN-1 TO DISPLAY-REC.
           PERFORM 998-WRITE-SCREEN.
           PERFORM 998-AUTO-READ-SCREEN.
101100
101200     SORT SORT-FILE ON ASCENDING KEY SORT-CORP-CODE
101300         USING ITEM-FILE
101400         GIVING ITEM-FILE.
101500
101600     OPEN INPUT ITEM-FILE.
101700
101800 63-SI-X.
101900     EXIT.
102000
102100
102200 63-LOAD-DPODATAITM.
           MOVE PO-ARG TO PORCVNO OF DPODATAITM-REC-O.
           START DPODATAITM-O KEY = PORCVNO OF DPODATAITM-REC-O
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
                   GO TO 63-LD-X
               ELSE
102600             MOVE "FIND * 63-LD"  TO  BU-DISPLAY-MSG
102700             GO TO 2-BLOWUP.
102800
103400 63-GET-DPODATAITM.
           READ DPODATAITM-O NEXT INTO BUF-DPODATAITM
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   GO TO 63-LD-X
               ELSE
103900             MOVE "GET DPODATAITM * 63-GET-DPODATA"
104000                 TO  BU-DISPLAY-MSG
104100             GO TO 2-BLOWUP.
           IF PORCVNO OF DPODATAITM-REC-O NOT = PO-ARG
               GO TO 63-LD-X.
104400
104500     IF DATAITM-ITEM-NO-9 < ITEM-NUMBER
104600         NEXT SENTENCE
104700     ELSE
104800     IF DATAITM-ITEM-NO-9 > ITEM-NUMBER
104900         GO TO 63-LD-X
105000     ELSE
105100         MOVE SAVE-NEW-PO-NUM     TO  DATAITM-PO-RCV-NO
105200         MOVE TOTAL-ITEM-CTR      TO  DATAITM-ITEM-NO-9
               WRITE DPODATAITM-REC-O FROM BUF-DPODATAITM
                   INVALID KEY MOVE FILE-STATUS TO FILE-STATUS
                       END-WRITE
               IF FILE-STATUS NOT = "00"
105600             MOVE "PUT DPODATAITM * 63-GD"  TO  BU-DISPLAY-MSG
105700             GO TO 2-BLOWUP.
105800
106200     GO TO 63-GET-DPODATAITM.
106300
106400 63-LD-X.
106500     EXIT.
106600
106700
106800 64-LOAD-ITEM-FILE.
           MOVE 0 TO COND-WORD.
           READ DPOITEM-O NEXT INTO BUF-DPOITEM
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   MOVE 15 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.
           IF PORCVNO OF DPOITEM-REC-O NOT = PO-ARG
               MOVE 15 TO COND-WORD.
107100     IF COND-WORD NOT = 0
107200         IF END-OF-CHAIN
107300             NEXT SENTENCE
107400         ELSE
107500             MOVE "GET DPOITEM * 64-LIF" TO BU-DISPLAY-MSG
107600             GO TO 2-BLOWUP
107700     ELSE
107800         MOVE ITM-NUMBER          TO ITEM-NUMBER
107900         MOVE ITM-CORP-CODE       TO ITEM-CORP-CODE
108100         WRITE ITEM-RCD.
108200
       COPY DISPCALL IN COPYLIB.
108300
       998-AUTO-READ-SCREEN.
           READ  DISPLAY-FILE TERMINAL IS TERMINAL-ID
               INDIC ARE SRF-INDICATORS
                   NO DATA MOVE DISPLAY-STATUS TO DISPLAY-STATUS.
           MOVE ALL B"0" TO SRF-INDICATORS.

       999-CATREAD.
           IF CATREAD-MSG-NUMBER = ZEROS
               MOVE LANG-SETNUM TO CATREAD-MSG-SET
               MOVE LANG-MSGNUM TO CATREAD-MSG-NUM.
           CALL "CCATREAD" USING CATREAD-PARMS.
           MOVE CATREAD-MSG-TEXT TO MESSAGE-BUFFER.
       999-CATREAD-EXIT.
           EXIT.

DCR01  COPY POLOGSUBR2 IN COPYLIB.
