       IDENTIFICATION DIVISION.
       PROGRAM-ID.             SEQNPCPY.
       AUTHOR.                 P.D. RAGLOW.
       INSTALLATION.           GOODYEAR TIRE AND RUBBER CO.
       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.
       SOURCE-COMPUTER.        IBM-AS400.
       OBJECT-COMPUTER.        IBM-AS400.
      *C****************************************************************
      *C  WDR  04/25/94
      *C  DELETED ALL REFERENCES TO PORTABILITY MODE COPYLIBS
      *C****************************************************************

       COPY SPECIALN           IN COPYLIB.

       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT EQP-REF-ES-O
                  ASSIGN       TO DATABASE-MCFLER0101
                  ORGANIZATION IS INDEXED
                  ACCESS MODE  IS DYNAMIC
                  RECORD KEY   IS EXTERNALLY-DESCRIBED-KEY
                  FILE STATUS  IS FILE-STATUS.

           SELECT EQP-REM-ES-O
                  ASSIGN       TO DATABASE-MCFLER0301
                  ORGANIZATION IS INDEXED
                  ACCESS MODE  IS DYNAMIC
                  RECORD KEY   IS EXTERNALLY-DESCRIBED-KEY
                  FILE STATUS  IS FILE-STATUS.

           SELECT EQP-OPS-ES-O
                  ASSIGN       TO DATABASE-MCFLER0501
                  ORGANIZATION IS INDEXED
                  ACCESS MODE  IS DYNAMIC
                  RECORD KEY   IS EXTERNALLY-DESCRIBED-KEY
                  FILE STATUS  IS FILE-STATUS.

           SELECT DRAWING-FL-EN-O
                  ASSIGN       TO DATABASE-MCFLDF0103
                  ORGANIZATION IS INDEXED
                  ACCESS MODE  IS DYNAMIC
                  RECORD KEY   IS EXTERNALLY-DESCRIBED-KEY
                               WITH DUPLICATES
                  FILE STATUS  IS FILE-STATUS.

           SELECT PRINT-FILE
                  ASSIGN       TO PRINTER-MCPRT.

           SELECT WO-LAST-NM-LW-I
                  ASSIGN       TO DATABASE-MCFLMM0801
                  ORGANIZATION IS INDEXED
                  ACCESS MODE  IS DYNAMIC
                  RECORD KEY   IS EXTERNALLY-DESCRIBED-KEY
                  FILE STATUS  IS FILE-STATUS.

           SELECT FLAT-FILE
                  ASSIGN       TO DISK-DEQNXTAB.

           SELECT TEMP-TABLE
                  ASSIGN       TO DISK-DEQNPCPY.

       DATA DIVISION.
       FILE SECTION.
       FD  EQP-REF-ES-O
           LABEL RECORDS ARE STANDARD.
       01  EQP-REF-ES-REC-O.
           COPY DDS-MCRPER0100  OF MCFLER0101.

       FD  EQP-REM-ES-O
           LABEL RECORDS ARE STANDARD.
       01  EQP-REM-ES-REC-O.
           COPY DDS-MCRPER0300  OF MCFLER0301.

       FD  EQP-OPS-ES-O
           LABEL RECORDS ARE STANDARD.
       01  EQP-OPS-ES-REC-O.
           COPY DDS-MCRPER0500  OF MCFLER0501.

       FD  DRAWING-FL-EN-O
           LABEL RECORDS ARE STANDARD.
       01  DRAWING-FL-EN-REC-O.
           COPY DDS-MCRPDF0100  OF MCFLDF0103.

       FD  WO-LAST-NM-LW-I
           LABEL RECORDS ARE STANDARD.
       01  WO-LAST-NM-LW-REC-I.
           COPY DDS-MCRPMM0800  OF MCFLMM0801.

       FD  PRINT-FILE
           DATA RECORD IS PRINT-REC.
       01  PRINT-REC           PIC X(132).

       FD  FLAT-FILE
           DATA RECORD IS FLAT-REC.
       01  FLAT-REC            PIC X(80).

       FD  TEMP-TABLE
           DATA RECORD IS TEMP-REC.
       01  TEMP-REC            PIC X(804).

       WORKING-STORAGE SECTION.
       77  HANDLE-BLOWUP-FLAG                PIC X    VALUE "Y".
       77  CNTR1                             PIC 99   VALUE 00.
       77  CNTR2                             PIC 9999 VALUE 00.
       77  LINE-CNT                          PIC 99   VALUE 00.
       77  SUB-HOLD                          PIC XXXX VALUE SPACES.
       77  SUBLVL-FOUND                      PIC X    VALUE "N".
       77  TEMP-TABLE-IND                    PIC X    VALUE "N".
       77  EOF-FLAG                          PIC X    VALUE "N".

       COPY FILESTAT           IN COPYLIB.

       COPY TBLOWUP            IN COPYLIB.

      *
      * DATABASE AREA
      *

       COPY DATAB              IN COPYLIB.

       01  MMISA                          PIC X(24)  VALUE "  MMISA;".
       01  DRWFIL                         PIC X(24)  VALUE "  DRWFIL;".
       01  EQPREF                         PIC X(24)  VALUE "  EQPREF;".

       01  ALL-ITEMS                      PIC XX     VALUE "@;".

       01  PASSWORD-MMISA                 PIC X(7)  VALUE "DO-ALL;".
       01  PASSWORD-DRWFIL                PIC X(7)  VALUE "DO-ALL;".
       01  PASSWORD-EQPREF                PIC X(7)  VALUE "DO-ALL;".

       01  ARGUMENTS  VALUE SPACES.
           05  HIER-KEY-ARG.
               10  HKA-TYPE       PIC X(8).
               10  HKA-SUB.
                   15  HKA-SUB1   PIC X.
                   15  HKA-SUB2   PIC X.
                   15  HKA-SUB3   PIC X.
                   15  HKA-SUB4   PIC X.
               10  FILLER         PIC XX.
           05  EQP-SUB-ARG.
               10  ESA-EQP        PIC X(6).
               10  ESA-SUB        PIC X(4).
           05  EQP-NUM-ARG        PIC X(6).
           05  LAST-WONUM-ARG     PIC X(6).

       01  SEARCH-FIELDS.
           05  HIER-KEY-SEARCH    PIC X(16)  VALUE "HIER-KEY;".
           05  EQP-SUB-SEARCH     PIC X(16)  VALUE "EQP-SUB-KEY;".
           05  EQP-NUM-SEARCH     PIC X(16)  VALUE "EQP-NUM;".
           05  LAST-WONUM-SEARCH  PIC X(16)  VALUE "LAST-WO-NUM;".

       01  DATASET-NAMES.
           05  DSET-EQP-REF       PIC X(16)  VALUE "EQP-REFERENCE;".
           05  DSET-EQP-REM       PIC X(16)  VALUE "EQP-REMARKS;".
           05  DSET-EQP-OPS       PIC X(16)  VALUE "EQP-OPERATIONS;".
           05  DSET-DRAWING-FL    PIC X(16)  VALUE "DRAWING-FILE;".
           05  DSET-WO-LAST-NM    PIC X(17)  VALUE "WO-LAST-NUM-USED;".
           05  FILLER             PIC X      VALUE SPACE.
           05  DSET-NAME          PIC X(17)  VALUE SPACES.

       01  HOLDING-TABLE VALUE SPACES.
           05  HT-DATA    OCCURS 20 TIMES.
               10  HT-KEY.
                   15  HT-EQP         PIC X(6).
                   15  HT-SUBSYSTEM   PIC X(4).
               10  FILLER             PIC X(794).
       01  HOLDING-TABLE2 REDEFINES HOLDING-TABLE.
           05  HT2-DATA    OCCURS 50 TIMES.
               10  FILLER             PIC X(80).
               10  HT-DF-KEY          PIC X(6).
               10  FILLER             PIC X(106).
           05  FILLER                 PIC X(360).

      *
      * PRINT FILE AREA
      *
       01  HEADER1.
           05  FILLER      PIC X(40)    VALUE "SEQNPCPY".
           05  FILLER      PIC X(60)    VALUE "EQUIPMENT SUBSYSTEM BREAK
      -       "DOWN - COPY FUNCTION".
           05  FILLER      PIC X(6)     VALUE "DATE:".
           05  H1-DATE     PIC X(8)     VALUE SPACES.
           05  FILLER      PIC X(10)    VALUE SPACES.
           05  FILLER      PIC X(5)     VALUE "PAGE".
           05  H1-PAGE     PIC 99       VALUE ZEROES.

       01  HEADER2.
           05  FILLER      PIC X(55)    VALUE SPACES.
           05  FILLER      PIC X(45)    VALUE "AUDIT REPORT".
           05  FILLER      PIC X(6)     VALUE "TIME:".
           05  H2-TIME     PIC X(8)     VALUE SPACES.

       01  HEADER3.
           05  FILLER      PIC X(11)    VALUE "FROM EQP #".
           05  H3-FREQP    PIC X(12)    VALUE SPACES.
           05  FILLER      PIC X(15)    VALUE "FROM SUBSYSTEM".
           05  H3-FRSUB    PIC X(4)     VALUE SPACES.
           05  FILLER      PIC X(10)    VALUE SPACES.
           05  FILLER      PIC X(9)     VALUE "TO EQP #".
           05  H3-TOEQP    PIC X(12)    VALUE SPACES.
           05  FILLER      PIC X(13)    VALUE "TO SUBSYSTEM".
           05  H3-TOSUB    PIC X(4)     VALUE SPACES.
           05  FILLER      PIC X(10)    VALUE SPACES.

       01  HEADER4.
           05  FILLER      PIC X(19)    VALUE "FILE NAME".
           05  FILLER      PIC X(20)    VALUE "DATA RECORDS COPIED".

       01  HEADER5.
           05  FILLER      PIC X(19)    VALUE "---------".
           05  FILLER      PIC X(20)    VALUE "-------------------".

       01  PRINT-LINE.
           05  PL-FILE     PIC X(16)    VALUE SPACES.
           05  FILLER      PIC XXX      VALUE " -".
           05  PL-RECORD   PIC X(113)   VALUE SPACES.

       COPY CCRTFILE           IN COPYLIB.

       COPY TDATECHK           IN COPYLIB.

       COPY FUNCTDEF           IN COPYLIB.

       COPY IOFEEDBACK         IN COPYLIB.

       COPY VCOMAREA           IN COPYLIB.

       COPY COMMAND            IN COPYLIB.

       COPY OVRPFDAT           IN COPYLIB.

       COPY HMSGBUF            IN COPYLIB.

       01  BUF-FLAT.
           05  FR-PLANT    PIC XXX.
           05  FR-FREQP    PIC X(6).
           05  FR-FRSUB    PIC XXXX.
           05  FR-TOEQP    PIC X(6).
           05  FR-TOSUB    PIC XXXX.
           05  FR-DATE     PIC X(8).
           05  FR-TIME     PIC X(8).
           05  FILLER      PIC X(41).

       01  BUF-DRAWING-FILE.
       COPY DDRAWFIL           IN COPYLIB.

       01  BUF-LAST-NUM-USED.
       COPY MLASTWO            IN COPYLIB.

       COPY MEQPREF            IN COPYLIB.

       COPY DEQPREM            IN COPYLIB.

       COPY DEQPOPS            IN COPYLIB.

       01  ACCEPT-FIELDS  VALUE SPACES.
           05  EQP-REF-OPT               PIC X.
           05  DRW-FIL-OPT               PIC X.
           05  FROM-EQP                  PIC X(6).
           05  TO-EQP                    PIC X(6).
           05  ACCEPT-TABLE.
               10  FILLER    OCCURS 20 TIMES.
                   15  ACCEPT-ITEM.
                       20  FR-LVL        PIC XXXX.
                       20  FILLER        PIC X(23).
                       20  TO-LVL        PIC XXXX.
                       20  FILLER        PIC X(23).

       PROCEDURE DIVISION.
       MAIN-LINE-LOGIC.
           ACCEPT OVRPRTF-TOFILE-NUM.
           ACCEPT EQP-REF-OPT.
           ACCEPT DRW-FIL-OPT.
           ACCEPT FROM-EQP.
           ACCEPT TO-EQP.
           ACCEPT ACCEPT-ITEM(1).
           ACCEPT ACCEPT-ITEM(2).
           ACCEPT ACCEPT-ITEM(3).
           ACCEPT ACCEPT-ITEM(4).
           ACCEPT ACCEPT-ITEM(5).
           ACCEPT ACCEPT-ITEM(6).
           ACCEPT ACCEPT-ITEM(7).
           ACCEPT ACCEPT-ITEM(8).
           ACCEPT ACCEPT-ITEM(9).
           ACCEPT ACCEPT-ITEM(10).

           PERFORM 996-OVERRIDE-PRINT-FILE.
           MOVE 0 TO H1-PAGE.
           MOVE 67 TO LINE-CNT.
           MOVE FROM-EQP TO H3-FREQP.
           MOVE TO-EQP   TO H3-TOEQP.
           MOVE 1 TO DATE-MODE.
           CALL "TDATECHK" USING DATE-CHECK-AREA.
           MOVE DATE-FORMATTED-TIME-OUT TO H2-TIME.
           MOVE DATE-SLASH-OUT     TO H1-DATE.
           OPEN OUTPUT PRINT-FILE.
           MOVE "*CURLIB"  TO CCRTFILE-LIBRARY.
           MOVE "DEQNXTAB" TO CCRTFILE-FILE.
           MOVE  80        TO CCRTFILE-RECORD-LENGTH.
           MOVE 10000      TO CCRTFILE-NO-RECORDS.
           MOVE 2000       TO CCRTFILE-INCREMENT-AMT.
           MOVE 20         TO CCRTFILE-NO-INCREMENTS.
           MOVE 0          TO CCRTFILE-STATUS.
           CALL "CCRTFILE" USING CCRTFILE-LIBRARY
                                 CCRTFILE-FILE
                                 CCRTFILE-RECORD-LENGTH
                                 CCRTFILE-NO-RECORDS
                                 CCRTFILE-INCREMENT-AMT
                                 CCRTFILE-NO-INCREMENTS
                                 CCRTFILE-STATUS.

           IF EQP-REF-OPT = "Y"
               PERFORM 10-COPY-EQP-REF
           END-IF
           IF DRW-FIL-OPT = "Y"
               PERFORM 20-COPY-DRW-FIL
           END-IF.

           PERFORM 40-WRITE-FLAT-FILE.

       END-PROCESSES.
           CLOSE PRINT-FILE.
           GOBACK.

      ****************************************************************
      *PARAGRAPH NAME : 04-PRINT-RTN.                                *
      *PURPOSE : TO PRINT THE AUDIT TRAIL.                           *
      ****************************************************************
       04-PRINT-RTN.
           IF LINE-CNT > 66
             PERFORM 05-HEADER-ROUTINE
           END-IF
           IF FR-LVL(CNTR1) NOT = H3-FRSUB
             IF LINE-CNT > 62
               PERFORM 05-HEADER-ROUTINE
             ELSE
               MOVE FR-LVL(CNTR1) TO H3-FRSUB
               MOVE TO-LVL(CNTR1) TO H3-TOSUB
               WRITE PRINT-REC FROM HEADER3 AFTER 2
               WRITE PRINT-REC FROM HEADER4 AFTER 1
               WRITE PRINT-REC FROM HEADER5 AFTER 1
               ADD 4 TO LINE-CNT
             END-IF
           END-IF
           WRITE PRINT-REC FROM PRINT-LINE  AFTER 1
           ADD 1 TO LINE-CNT.

      ****************************************************************
      *PARAGRAPH NAME : 05-HEADER-ROUTINE.                           *
      *PURPOSE : TO PRINT THE AUDIT TRAIL HEADER.                    *
      ****************************************************************
       05-HEADER-ROUTINE.
           IF FR-LVL(CNTR1) NOT = H3-FRSUB
             MOVE FR-LVL(CNTR1) TO H3-FRSUB
             MOVE TO-LVL(CNTR1) TO H3-TOSUB
           END-IF.
           ADD 1 TO H1-PAGE.
           WRITE PRINT-REC FROM HEADER1 AFTER ADVANCING PAGE.
           WRITE PRINT-REC FROM HEADER2 AFTER ADVANCING 1.
           WRITE PRINT-REC FROM HEADER3 AFTER ADVANCING 2.
           WRITE PRINT-REC FROM HEADER4 AFTER ADVANCING 1.
           WRITE PRINT-REC FROM HEADER5 AFTER ADVANCING 1.
           MOVE 5 TO LINE-CNT.

      ****************************************************************
      *PARAGRAPH NAME : 10-COPY-EQP-REF.                             *
      *PURPOSE : TO COPY INFORMATION TO THE NEW TYPE - SUBSYSTEM.    *
      ****************************************************************
       10-COPY-EQP-REF.
           OPEN I-O            EQP-REF-ES-O.
           OPEN I-O            EQP-REM-ES-O.
           OPEN I-O            EQP-OPS-ES-O.
           MOVE 1 TO CNTR1.
           PERFORM UNTIL CNTR1 GREATER THAN 10
             MOVE FROM-EQP TO ESA-EQP
             IF FR-LVL(CNTR1) NOT = SPACES
               MOVE FR-LVL(CNTR1) TO ESA-SUB
               PERFORM 11-COPY-TO-EQP-REF
               MOVE SPACES TO HOLDING-TABLE
               PERFORM 12-COPY-TO-EQP-REM
               MOVE SPACES TO HOLDING-TABLE
               PERFORM 13-COPY-TO-EQP-OPS
             END-IF
             ADD 1 TO CNTR1
           END-PERFORM.

           CLOSE               EQP-REF-ES-O.
           CLOSE               EQP-REM-ES-O.
           CLOSE               EQP-OPS-ES-O.

      ****************************************************************
      *PARAGRAPH NAME : 11-COPY-TO-EQP-REF.                          *
      *PURPOSE : TO COPY INFORMATION TO THE NEW TYPE - SUBSYSTEM.    *
      ****************************************************************
       11-COPY-TO-EQP-REF.
           PERFORM 9999-GETKEY-EQP-REF-ES-O.
           IF COND-WORD = 0
             MOVE TO-EQP        TO ESA-EQP  ESK-EQUIP OF BUF-EQP-REF
             MOVE TO-LVL(CNTR1) TO ESA-SUB  ESK-SUB OF BUF-EQP-REF
             MOVE EQPREF       TO BASE
             MOVE DSET-EQP-REF TO DSET-NAME
             MOVE DSET-EQP-REF TO PL-FILE
             MOVE BUF-EQP-REF TO PL-RECORD
             PERFORM 04-PRINT-RTN
             MOVE "N" TO HANDLE-BLOWUP-FLAG
             PERFORM 9999-DSET-LOCK
             PERFORM 9999-PUT-EQP-REF-ES-O
             PERFORM 9999-UNLOCK
             MOVE "Y" TO HANDLE-BLOWUP-FLAG
           END-IF.

      ****************************************************************
      *PARAGRAPH NAME : 12-COPY-TO-EQP-REM.                          *
      *PURPOSE : TO COPY INFORMATION TO THE NEW TYPE - SUBSYSTEM.    *
      ****************************************************************
       12-COPY-TO-EQP-REM.
           MOVE FROM-EQP TO ESA-EQP.
           MOVE FR-LVL(CNTR1) TO ESA-SUB.
           PERFORM 9999-CHAINHD-EQP-REM-ES-O.
           PERFORM 9999-GETNEXT-EQP-REM-ES-O.
           MOVE 1 TO CNTR2.
           PERFORM UNTIL END-OF-CHAIN OR CNTR2 > 10
             MOVE BUF-EQP-REM  TO HT-DATA(CNTR2)
             ADD 1 TO CNTR2
             PERFORM 9999-GETNEXT-EQP-REM-ES-O
           END-PERFORM.
      *****************************************************************
      *   IF THERE ARE MORE RECORDS THAN HOLDING-TABLE CAN HOLD, CREATE
      *   A TEMPORARY FILE TO HOLD THE OVERFLOW.
      *****************************************************************
           IF NOT END-OF-CHAIN
             MOVE "QTEMP"      TO CCRTFILE-LIBRARY
             MOVE "DEQNPCPY"   TO CCRTFILE-FILE
             MOVE  804         TO CCRTFILE-RECORD-LENGTH
             MOVE  400         TO CCRTFILE-NO-RECORDS
             MOVE   50         TO CCRTFILE-INCREMENT-AMT
             MOVE    3         TO CCRTFILE-NO-INCREMENTS
             MOVE    0         TO CCRTFILE-STATUS
             CALL "CCRTFILE"   USING CCRTFILE-LIBRARY
                                     CCRTFILE-FILE
                                     CCRTFILE-RECORD-LENGTH
                                     CCRTFILE-NO-RECORDS
                                     CCRTFILE-INCREMENT-AMT
                                     CCRTFILE-NO-INCREMENTS
                                     CCRTFILE-STATUS
             OPEN OUTPUT TEMP-TABLE
             MOVE "Y" TO TEMP-TABLE-IND
             PERFORM UNTIL END-OF-CHAIN
               WRITE TEMP-REC  FROM BUF-EQP-REM
               PERFORM 9999-GETNEXT-EQP-REM-ES-O
             END-PERFORM
             CLOSE TEMP-TABLE
             OPEN INPUT TEMP-TABLE
           END-IF.
           MOVE 1            TO CNTR2.
           MOVE EQPREF       TO BASE.
           MOVE DSET-EQP-REM TO DSET-NAME.
           PERFORM 9999-DSET-LOCK.
           PERFORM UNTIL HT-KEY(CNTR2) = SPACES OR CNTR2 > 10
             MOVE HT-DATA(CNTR2) TO BUF-EQP-REM
             MOVE TO-EQP TO ESK-EQUIP OF BUF-EQP-REM
             MOVE TO-LVL(CNTR1) TO ESK-SUB OF BUF-EQP-REM
             MOVE DSET-EQP-REM TO PL-FILE
             MOVE BUF-EQP-REM TO PL-RECORD
             PERFORM 04-PRINT-RTN
             PERFORM 9999-PUT-EQP-REM-ES-O
             ADD 1 TO CNTR2
           END-PERFORM.
           MOVE 0 TO COND-WORD.
           IF TEMP-TABLE-IND = "Y"
             MOVE "N" TO TEMP-TABLE-IND EOF-FLAG
             READ TEMP-TABLE INTO BUF-EQP-REM
                       AT END MOVE "Y" TO EOF-FLAG
             END-READ
             PERFORM UNTIL EOF-FLAG = "Y"
               MOVE TO-EQP  TO ESK-EQUIP OF BUF-EQP-REM
               MOVE TO-LVL(CNTR1) TO ESK-SUB OF BUF-EQP-REM
               MOVE DSET-EQP-REM TO PL-FILE
               MOVE BUF-EQP-REM TO PL-RECORD
               PERFORM 04-PRINT-RTN
               PERFORM 9999-PUT-EQP-REM-ES-O
               READ TEMP-TABLE INTO BUF-EQP-REM
                         AT END MOVE "Y" TO EOF-FLAG
               END-READ
             END-PERFORM
             CLOSE TEMP-TABLE
           END-IF.
           PERFORM 9999-UNLOCK.

      ****************************************************************
      *PARAGRAPH NAME : 13-COPY-TO-EQP-OPS.                          *
      *PURPOSE : TO COPY INFORMATION TO THE NEW TYPE - SUBSYSTEM.    *
      ****************************************************************
       13-COPY-TO-EQP-OPS.
           MOVE FROM-EQP TO ESA-EQP.
           MOVE FR-LVL(CNTR1) TO ESA-SUB.
           PERFORM 9999-CHAINHD-EQP-OPS-ES-O.
           PERFORM 9999-GETNEXT-EQP-OPS-ES-O.
           MOVE 1 TO CNTR2.
           PERFORM UNTIL END-OF-CHAIN OR CNTR2 > 10
             MOVE BUF-EQP-OPS  TO HT-DATA(CNTR2)
             ADD 1 TO CNTR2
             PERFORM 9999-GETNEXT-EQP-OPS-ES-O
           END-PERFORM.
      *****************************************************************
      *   IF THERE ARE MORE RECORDS THAN HOLDING-TABLE CAN HOLD, CREATE
      *   A TEMPORARY FILE TO HOLD THE OVERFLOW.
      *****************************************************************
           IF NOT END-OF-CHAIN
             MOVE "QTEMP"      TO CCRTFILE-LIBRARY
             MOVE "DEQNPCPY"   TO CCRTFILE-FILE
             MOVE  804         TO CCRTFILE-RECORD-LENGTH
             MOVE  400         TO CCRTFILE-NO-RECORDS
             MOVE   50         TO CCRTFILE-INCREMENT-AMT
             MOVE    3         TO CCRTFILE-NO-INCREMENTS
             MOVE    0         TO CCRTFILE-STATUS
             CALL "CCRTFILE"   USING CCRTFILE-LIBRARY
                                     CCRTFILE-FILE
                                     CCRTFILE-RECORD-LENGTH
                                     CCRTFILE-NO-RECORDS
                                     CCRTFILE-INCREMENT-AMT
                                     CCRTFILE-NO-INCREMENTS
                                     CCRTFILE-STATUS
             OPEN OUTPUT TEMP-TABLE
             MOVE "Y" TO TEMP-TABLE-IND
             PERFORM UNTIL END-OF-CHAIN
               WRITE TEMP-REC  FROM BUF-EQP-OPS
               PERFORM 9999-GETNEXT-EQP-OPS-ES-O
             END-PERFORM
             CLOSE TEMP-TABLE
             OPEN INPUT TEMP-TABLE
           END-IF.

           MOVE 1 TO CNTR2.
           MOVE EQPREF       TO BASE.
           MOVE DSET-EQP-OPS TO DSET-NAME.
           PERFORM 9999-DSET-LOCK.
           PERFORM UNTIL HT-KEY(CNTR2) = SPACES OR CNTR2 > 35
             MOVE HT-DATA(CNTR2) TO BUF-EQP-OPS
             MOVE TO-EQP TO ESK-EQUIP OF BUF-EQP-OPS
             MOVE TO-LVL(CNTR1) TO ESK-SUB OF BUF-EQP-OPS
             MOVE DSET-EQP-OPS TO PL-FILE
             MOVE BUF-EQP-OPS TO PL-RECORD
             PERFORM 04-PRINT-RTN
             PERFORM 9999-PUT-EQP-OPS-ES-O
             ADD 1 TO CNTR2
           END-PERFORM.
           IF TEMP-TABLE-IND = "Y"
             MOVE "N" TO TEMP-TABLE-IND EOF-FLAG
             READ TEMP-TABLE INTO BUF-EQP-OPS
                       AT END MOVE "Y" TO EOF-FLAG
             END-READ
             PERFORM UNTIL EOF-FLAG = "Y"
               MOVE TO-EQP TO ESK-EQUIP OF BUF-EQP-OPS
               MOVE TO-LVL(CNTR1) TO ESK-SUB OF BUF-EQP-OPS
               MOVE DSET-EQP-OPS TO PL-FILE
               MOVE BUF-EQP-OPS TO PL-RECORD
               PERFORM 04-PRINT-RTN
               PERFORM 9999-PUT-EQP-OPS-ES-O
               READ TEMP-TABLE INTO BUF-EQP-OPS
                        AT END MOVE "Y" TO EOF-FLAG
               END-READ
             END-PERFORM
             CLOSE TEMP-TABLE
           END-IF.

           PERFORM 9999-UNLOCK.

      ****************************************************************
      *PARAGRAPH NAME : 20-COPY-DRW-FIL.                             *
      *PURPOSE : TO COPY DRAWING FILE INFO TO NEW TYPE - SUBSYSTEM   *
      *                                                              *
      ****************************************************************
       20-COPY-DRW-FIL.
           OPEN I-O            DRAWING-FL-EN-O.
           MOVE 1              TO CNTR1.
           PERFORM UNTIL CNTR1 GREATER THAN 10
             MOVE SPACES TO HOLDING-TABLE
             IF FR-LVL(CNTR1) NOT = SPACES
               MOVE FROM-EQP TO EQP-NUM-ARG
               PERFORM 9999-CHAINHD-DRAWING-FL-EN-O
               PERFORM 9999-GETNEXT-DRAWING-FL-EN-O
               MOVE 1 TO CNTR2
               PERFORM UNTIL END-OF-CHAIN OR CNTR2 > 40
                 IF DRAW-SUBSYS = FR-LVL(CNTR1)
                   MOVE BUF-DRAWING-FILE TO HT2-DATA(CNTR2)
                   ADD 1 TO CNTR2
                 END-IF
                 PERFORM 9999-GETNEXT-DRAWING-FL-EN-O
               END-PERFORM
      *****************************************************************
      *   IF THERE ARE MORE RECORDS THAN HOLDING-TABLE CAN HOLD, CREATE
      *   A TEMPORARY FILE TO HOLD THE OVERFLOW.
      *****************************************************************
               IF NOT END-OF-CHAIN
                 MOVE "QTEMP"      TO CCRTFILE-LIBRARY
                 MOVE "DEQNPCPY"   TO CCRTFILE-FILE
                 MOVE  804         TO CCRTFILE-RECORD-LENGTH
                 MOVE  400         TO CCRTFILE-NO-RECORDS
                 MOVE   50         TO CCRTFILE-INCREMENT-AMT
                 MOVE    3         TO CCRTFILE-NO-INCREMENTS
                 MOVE    0         TO CCRTFILE-STATUS
                 CALL "CCRTFILE"   USING CCRTFILE-LIBRARY
                                         CCRTFILE-FILE
                                         CCRTFILE-RECORD-LENGTH
                                         CCRTFILE-NO-RECORDS
                                         CCRTFILE-INCREMENT-AMT
                                         CCRTFILE-NO-INCREMENTS
                                         CCRTFILE-STATUS
                 OPEN OUTPUT TEMP-TABLE
                 MOVE "Y" TO TEMP-TABLE-IND
                 PERFORM UNTIL END-OF-CHAIN
                   IF DRAW-SUBSYS = FR-LVL(CNTR1)
                     WRITE TEMP-REC FROM BUF-DRAWING-FILE
                   END-IF
                   PERFORM 9999-GETNEXT-DRAWING-FL-EN-O
                 END-PERFORM
                 CLOSE TEMP-TABLE
                 OPEN INPUT TEMP-TABLE
               END-IF
               MOVE 1 TO CNTR2
               MOVE DRWFIL          TO BASE
               MOVE DSET-DRAWING-FL TO DSET-NAME
               PERFORM 9999-DSET-LOCK
               PERFORM UNTIL CNTR2 > 40 OR HT-DF-KEY(CNTR2) = SPACES
                 MOVE HT2-DATA(CNTR2) TO BUF-DRAWING-FILE
                 MOVE TO-EQP        TO DRAW-ENUM
                 MOVE TO-LVL(CNTR1) TO DRAW-SUBSYS
                 MOVE DSET-DRAWING-FL  TO PL-FILE
                 MOVE BUF-DRAWING-FILE TO PL-RECORD
                 PERFORM 04-PRINT-RTN
                 PERFORM 9999-PUT-DRAWING-FL-EN-O
                 ADD 1 TO CNTR2
               END-PERFORM
               IF TEMP-TABLE-IND = "Y"
                 MOVE "N" TO TEMP-TABLE-IND EOF-FLAG
                 READ TEMP-TABLE INTO BUF-DRAWING-FILE
                            AT END MOVE "Y" TO EOF-FLAG
                 END-READ
                 PERFORM UNTIL EOF-FLAG = "Y"
                   MOVE TO-EQP        TO DRAW-ENUM
                   MOVE TO-LVL(CNTR1) TO DRAW-SUBSYS
                   MOVE DSET-DRAWING-FL  TO PL-FILE
                   MOVE BUF-DRAWING-FILE TO PL-RECORD
                   PERFORM 04-PRINT-RTN
                   PERFORM 9999-PUT-DRAWING-FL-EN-O
                   READ TEMP-TABLE INTO BUF-DRAWING-FILE
                           AT END MOVE "Y" TO EOF-FLAG
                   END-READ
                 END-PERFORM
                 CLOSE TEMP-TABLE
               END-IF
               PERFORM 9999-UNLOCK
             END-IF
             ADD 1 TO CNTR1
           END-PERFORM.

           CLOSE               DRAWING-FL-EN-O.

      ****************************************************************
      * PARAGRAPH : 2100-BLOWUP                                      *
      * PURPOSE   : TO LOG ERROR MESSAGE AND ABORT PROGRAM           *
      ****************************************************************
       2100-BLOWUP.
           MOVE "TEQNPCPY" TO BU-PGM-NAME.
           CALL "TBLOWUP" USING BASE, BU-PGM-NAME, STATUS-AREA,
                 DUMMY-VIEW-AREA, DUMMY-KSAM-STAT, BU-DISPLAY-MSG,
                 BU-DISPLAY-FLDS.

      ****************************************************************
      *PARAGRAPH NAME : 40-WRITE-FLAT-FILE.                          *
      *PURPOSE : WRITE THE RELATIONSHIPS TO THE FLAT FILE.           *
      *                                                              *
      ****************************************************************
       40-WRITE-FLAT-FILE.
           OPEN EXTEND         FLAT-FILE.
           OPEN INPUT          WO-LAST-NM-LW-I.
           PERFORM 9999-GETSER-WO-LAST-NM-LW-I.
           MOVE PLANT-IDENT                TO FR-PLANT.
           MOVE FROM-EQP                   TO FR-FREQP.
           MOVE TO-EQP                     TO FR-TOEQP.
           MOVE DATE-YMD-OUT               TO FR-DATE.
           MOVE DATE-UNFORMATTED-TIME-OUT  TO FR-TIME.
           MOVE 1 TO CNTR1.
           PERFORM UNTIL CNTR1 GREATER THAN 10
             IF FR-LVL(CNTR1) NOT = SPACES
               MOVE FR-LVL(CNTR1)  TO FR-FRSUB
               MOVE TO-LVL(CNTR1)  TO FR-TOSUB
               WRITE FLAT-REC FROM BUF-FLAT
             END-IF
             ADD 1 TO CNTR1
           END-PERFORM.

           CLOSE               FLAT-FILE.
           CLOSE               WO-LAST-NM-LW-I.

       COPY OVRPFCAL           IN COPYLIB.

       9999-COMMAND.
           CALL "QCMDEXC" USING COMMAND-WORK, COMMAND-LEN.

       COPY DLOCKCAL           IN COPYLIB.

       COPY UNLOCK             IN COPYLIB.

       9999-GETKEY-EQP-REF-ES-O.
           MOVE 0 TO COND-WORD.
           MOVE EQP-SUB-ARG TO EQRSUBKEY OF EQP-REF-ES-REC-O.
           READ EQP-REF-ES-O INTO BUF-EQP-REF
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS = "23"
               MOVE 17 TO COND-WORD
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD
               IF HANDLE-BLOWUP-FLAG = "Y"
                   MOVE "GETKEY ERR 9999-GETKEY-EQP-REF-ES-O"
                       TO BU-MSG-AREA
                   PERFORM 2100-BLOWUP.

       9999-RESET-EQP-REF-ES-O.
           MOVE HIGH-VALUES TO EQRSUBKEY OF EQP-REF-ES-REC-O.
           START EQP-REF-ES-O KEY > EQRSUBKEY OF EQP-REF-ES-REC-O
               INVALID KEY MOVE "00" TO FILE-STATUS.

       9999-CHAINHD-EQP-REM-ES-O.
           MOVE 0 TO COND-WORD.
           MOVE EQP-SUB-ARG TO EQRSUBKEY OF EQP-REM-ES-REC-O.
           START EQP-REM-ES-O KEY = EQRSUBKEY OF EQP-REM-ES-REC-O
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF (FILE-STATUS NOT = "00") AND (FILE-STATUS-1 NOT = "2")
               MOVE 99 TO COND-WORD
               IF HANDLE-BLOWUP-FLAG = "Y"
                   MOVE "CHAINHD ERR 9999-CHAINHD-EQP-REM-ES-O"
                       TO BU-MSG-AREA
                   PERFORM 2100-BLOWUP.

       9999-CHAINHD-EQP-OPS-ES-O.
           MOVE 0 TO COND-WORD.
           MOVE EQP-SUB-ARG TO EQRSUBKEY OF EQP-OPS-ES-REC-O.
           START EQP-OPS-ES-O KEY = EQRSUBKEY OF EQP-OPS-ES-REC-O
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF (FILE-STATUS NOT = "00") AND (FILE-STATUS-1 NOT = "2")
               MOVE 99 TO COND-WORD
               IF HANDLE-BLOWUP-FLAG = "Y"
                   MOVE "CHAINHD ERR 9999-CHAINHD-EQP-OPS-ES-O"
                       TO BU-MSG-AREA
                   PERFORM 2100-BLOWUP.

       9999-CHAINHD-DRAWING-FL-EN-O.
           MOVE 0 TO COND-WORD.
           MOVE EQP-NUM-ARG TO DRWEQPNUM OF DRAWING-FL-EN-REC-O.
           START DRAWING-FL-EN-O KEY = DRWEQPNUM OF DRAWING-FL-EN-REC-O
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF (FILE-STATUS NOT = "00") AND (FILE-STATUS-1 NOT = "2")
               MOVE 99 TO COND-WORD
               IF HANDLE-BLOWUP-FLAG = "Y"
                   MOVE "CHAINHD ERR 9999-CHAINHD-DRAWING-FL-EN-O"
                       TO BU-MSG-AREA
                   PERFORM 2100-BLOWUP.

       9999-GETNEXT-EQP-REM-ES-O.
           MOVE 0 TO COND-WORD.
           READ EQP-REM-ES-O NEXT INTO BUF-EQP-REM
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14"
                   PERFORM 9999-RESET-EQP-REM-ES-O
                   MOVE 15 TO COND-WORD
               ELSE
               IF FILE-STATUS = "46"
                   MOVE 15 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD
                   IF HANDLE-BLOWUP-FLAG = "Y"
                       MOVE "GETNEXT ERR 9999-GETNEXT-EQP-REM-ES-O"
                           TO BU-MSG-AREA
                       PERFORM 2100-BLOWUP
                   END-IF
           ELSE
           IF EQRSUBKEY OF EQP-REM-ES-REC-O NOT = EQP-SUB-ARG
               PERFORM 9999-RESET-EQP-REM-ES-O
               MOVE 15 TO COND-WORD.

       9999-RESET-EQP-REM-ES-O.
           MOVE HIGH-VALUES TO EQRSUBKEY OF EQP-REM-ES-REC-O.
           START EQP-REM-ES-O KEY > EQRSUBKEY OF EQP-REM-ES-REC-O
               INVALID KEY MOVE "00" TO FILE-STATUS.

       9999-GETNEXT-EQP-OPS-ES-O.
           MOVE 0 TO COND-WORD.
           READ EQP-OPS-ES-O NEXT INTO BUF-EQP-OPS
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14"
                   PERFORM 9999-RESET-EQP-OPS-ES-O
                   MOVE 15 TO COND-WORD
               ELSE
               IF FILE-STATUS = "46"
                   MOVE 15 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD
                   IF HANDLE-BLOWUP-FLAG = "Y"
                       MOVE "GETNEXT ERR 9999-GETNEXT-EQP-OPS-ES-O"
                           TO BU-MSG-AREA
                       PERFORM 2100-BLOWUP
                   END-IF
           ELSE
           IF EQRSUBKEY OF EQP-OPS-ES-REC-O NOT = EQP-SUB-ARG
               PERFORM 9999-RESET-EQP-OPS-ES-O
               MOVE 15 TO COND-WORD.

       9999-RESET-EQP-OPS-ES-O.
           MOVE HIGH-VALUES TO EQRSUBKEY OF EQP-OPS-ES-REC-O.
           START EQP-OPS-ES-O KEY > EQRSUBKEY OF EQP-OPS-ES-REC-O
               INVALID KEY MOVE "00" TO FILE-STATUS.

       9999-GETNEXT-DRAWING-FL-EN-O.
           MOVE 0 TO COND-WORD.
           READ DRAWING-FL-EN-O NEXT INTO BUF-DRAWING-FILE
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14"
                   PERFORM 9999-RESET-DRAWING-FL-EN-O
                   MOVE 15 TO COND-WORD
               ELSE
               IF FILE-STATUS = "46"
                   MOVE 15 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD
                   IF HANDLE-BLOWUP-FLAG = "Y"
                       MOVE "GETNEXT ERR 9999-GETNEXT-DRAWING-FL-EN-O"
                           TO BU-MSG-AREA
                       PERFORM 2100-BLOWUP
                   END-IF
           ELSE
           IF DRWEQPNUM OF DRAWING-FL-EN-REC-O NOT = EQP-NUM-ARG
               PERFORM 9999-RESET-DRAWING-FL-EN-O
               MOVE 15 TO COND-WORD.

       9999-RESET-DRAWING-FL-EN-O.
           MOVE HIGH-VALUES TO DRWEQPNUM OF DRAWING-FL-EN-REC-O.
           START DRAWING-FL-EN-O KEY > DRWEQPNUM OF DRAWING-FL-EN-REC-O
               INVALID KEY MOVE "00" TO FILE-STATUS.

       9999-GETSER-WO-LAST-NM-LW-I.
           MOVE 0 TO COND-WORD.
           READ WO-LAST-NM-LW-I NEXT INTO BUF-LAST-NUM-USED
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS-1 = "1"
               MOVE 11 TO COND-WORD
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD
               IF HANDLE-BLOWUP-FLAG = "Y"
                   MOVE "GETSER ERR 9999-GETSER-WO-LAST-NM-LW-I"
                       TO BU-MSG-AREA
                   PERFORM 2100-BLOWUP.

       9999-BEGFIL-WO-LAST-NM-LW-I.
           MOVE SPACES TO LASTWONUM OF WO-LAST-NM-LW-REC-I.
           START WO-LAST-NM-LW-I KEY >= LASTWONUM OF WO-LAST-NM-LW-REC-I
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.

       9999-PUT-EQP-REF-ES-O.
           MOVE 0 TO COND-WORD.
           WRITE EQP-REF-ES-REC-O FROM BUF-EQP-REF
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD
               IF HANDLE-BLOWUP-FLAG = "Y"
                   MOVE "PUT ERR 9999-PUT-EQP-REF-ES-O"
                       TO BU-MSG-AREA
                   PERFORM 2100-BLOWUP.

       9999-PUT-EQP-REM-ES-O.
           MOVE 0 TO COND-WORD.
           WRITE EQP-REM-ES-REC-O FROM BUF-EQP-REM
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD
               IF HANDLE-BLOWUP-FLAG = "Y"
                   MOVE "PUT ERR 9999-PUT-EQP-REM-ES-O"
                       TO BU-MSG-AREA
                   PERFORM 2100-BLOWUP.

       9999-PUT-EQP-OPS-ES-O.
           MOVE 0 TO COND-WORD.
           WRITE EQP-OPS-ES-REC-O FROM BUF-EQP-OPS
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD
               IF HANDLE-BLOWUP-FLAG = "Y"
                   MOVE "PUT ERR 9999-PUT-EQP-OPS-ES-O"
                       TO BU-MSG-AREA
                   PERFORM 2100-BLOWUP.

       9999-PUT-DRAWING-FL-EN-O.
           MOVE 0 TO COND-WORD.
           WRITE DRAWING-FL-EN-REC-O FROM BUF-DRAWING-FILE
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD
               IF HANDLE-BLOWUP-FLAG = "Y"
                   MOVE "PUT ERR 9999-PUT-DRAWING-FL-EN-O"
                       TO BU-MSG-AREA
                   PERFORM 2100-BLOWUP.

