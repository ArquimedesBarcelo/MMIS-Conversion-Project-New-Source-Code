       IDENTIFICATION DIVISION.
       PROGRAM-ID.             TAPPORTN.
       AUTHOR.                 W. ROXBURY.
       INSTALLATION.           GOODYEAR TIRE & RUBBER CO.
       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.
       SOURCE-COMPUTER.        IBM-AS400.
       OBJECT-COMPUTER.        IBM-AS400.
       SPECIAL-NAMES.          REQUESTOR IS WORK-STATION
                               SYSTEM-CONSOLE IS CONSOLE
                               LOCAL-DATA IS LOCAL-DATA-AREA.
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT WO-BASIC
                  ASSIGN       TO DATABASE-MCFLMM1001
                  ORGANIZATION IS INDEXED
                  ACCESS MODE  IS DYNAMIC
                  RECORD KEY   IS EXTERNALLY-DESCRIBED-KEY
                               WITH DUPLICATES
                  FILE STATUS  IS FILE-STAT.

           SELECT WO-PLANNED
                  ASSIGN       TO DATABASE-MCFLMM1101
                  ORGANIZATION IS INDEXED
                  ACCESS MODE  IS DYNAMIC
                  RECORD KEY   IS EXTERNALLY-DESCRIBED-KEY
                               WITH DUPLICATES
                  FILE STATUS  IS FILE-STAT.

           SELECT WO-OPEN-Q-CC
                  ASSIGN       TO DATABASE-MCFLMM1903
                  ORGANIZATION IS INDEXED
                  ACCESS MODE  IS DYNAMIC
                  RECORD KEY   IS EXTERNALLY-DESCRIBED-KEY
                               WITH DUPLICATES
                  FILE STATUS  IS FILE-STAT.

           SELECT WO-OPEN-Q-WO
                  ASSIGN       TO DATABASE-MCFLMM1902
                  ORGANIZATION IS INDEXED
                  ACCESS MODE  IS DYNAMIC
                  RECORD KEY   IS EXTERNALLY-DESCRIBED-KEY
                               WITH DUPLICATES
                  FILE STATUS  IS FILE-STAT.

           SELECT DISPLAY-FILE
                  ASSIGN       TO WORKSTATION-ZCFTHELP-SI
                  ORGANIZATION IS TRANSACTION
                  ACCESS MODE  IS SEQUENTIAL
                  FILE STATUS  IS SCREEN-STATUS
                               MAJOR-MINOR
                  CONTROL-AREA IS SCREEN-CONTROL.

       DATA DIVISION.
       FILE SECTION.
       FD  WO-BASIC
           LABEL RECORDS ARE STANDARD.
       01  VWO-REC.
           COPY DDS-ALL-FORMATS OF MCFLMM1001.

       FD  WO-PLANNED
           LABEL RECORDS ARE STANDARD.
       01  PWO-REC.
           COPY DDS-ALL-FORMATS OF MCFLMM1101.

       FD  WO-OPEN-Q-CC
           LABEL RECORDS ARE STANDARD.
       01  QCC-REC.
           COPY DDS-ALL-FORMATS OF MCFLMM1903.

       FD  WO-OPEN-Q-WO
           LABEL RECORDS ARE STANDARD.
       01  QWO-REC.
           COPY DDS-ALL-FORMATS OF MCFLMM1902.

       FD  DISPLAY-FILE
           LABEL RECORDS ARE OMITTED.
       01  DISPLAY-REC         PIC X(2000).

       WORKING-STORAGE SECTION.
       77  LOOP-CTR            PIC S9(4) COMP-4 VALUE 0.
       77  FIND-SW             PIC S9(4) COMP-4 VALUE 0.
       77  DATE-SW             PIC S9(4) COMP-4 VALUE 0.
       77  SHORT-SW            PIC S9(4) COMP-4 VALUE 0.
       77  RESERVE-SW          PIC S9(4) COMP-4 VALUE 0.
       77  CW-SW               PIC S9(4) COMP-4 VALUE 0.
       77  TMIN                PIC S9(4) COMP-4 VALUE 0.
       77  LMIN                PIC S9(4) COMP-4 VALUE 0.
       77  STRT-MIN            PIC S9(4) COMP-4 VALUE 0.
       77  STOP-MIN            PIC S9(4) COMP-4 VALUE 0.
       77  ROOT-HOURS          PIC S9(4) COMP-4 VALUE 0.
       77  HR-MIN              PIC S9(4) COMP-4 VALUE 0.
       77  SAVE-LASTKEY        PIC S9(4) COMP-4 VALUE 0.
       77  MAIN-SW             PIC X.
       77  FILE-SW             PIC X          VALUE "B".
       77  QUEUE-SW            PIC X          VALUE SPACE.
       77  CALL-PGM            PIC X          VALUE SPACE.
       77  QUEUE-ERROR         PIC X(76).
       77  WO-KEY              PIC X(10).
       77  WO-HOLD-AREA        PIC X(900).
       77  TRUE-VAL            PIC 1          VALUE B"1".

