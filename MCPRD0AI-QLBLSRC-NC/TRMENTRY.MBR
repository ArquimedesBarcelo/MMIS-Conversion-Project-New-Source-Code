       IDENTIFICATION DIVISION.
       PROGRAM-ID.                      TRMENTRY.
       AUTHOR.                          ANNETTE TREUDLER.
      *INSTALLATION.                    GOODYEAR TIRE & RUBBER CO.
       DATE-WRITTEN.                    APRIL 6, 1987.
       DATE-COMPILED.                   CURRENT-DATE.
      *REMARKS.
      *D**************************************************************
      *D*                                                           **
      *D*        T R M E N T R Y                                    **
      *D*                                                           **
      *D*   MATERIAL CODE AND DAILY REQUIREMENTS ENTRY PROGRAM.     **
      *D*   THIS PROGRAM WILL BE USED AS A FRONT-END DATA LOAD      **
      *D*   PROGRAM FOR THE RAW MATERIAL INVENTORY POSITION REPORT. **
      *D*   PROGRAM WILL EVENTUALLY BE ELIMATED WHEN DATA IS SENT   **
      *D*   DIRECTLY FROM ASPICS.                                   **
      *D**************************************************************
      *C*
      *C* CR KALMAN        4/26/94            REQUEST 6490
      *C* REMOVED PORTABLILITY COPYLIBS.
      *C
      *C 09/13/96  JEFF BUNGO
      *C   EXPAND DATE FIELDS FOR YEAR 2000 COMPLIANCE.
      *C   RECOMPILE TO PICK UP COPYLIB CHANGES.
      *C
      *C 02/26/97  JEFF BUNGO
      *C   CHANGED LIBRARY ON CCRTFILE TO *CURLIB INSTEAD OF MCPRD1
      *C

       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.
       SPECIAL-NAMES.          I-O-FEEDBACK     IS I-O-FEEDBACK-AREA
                               LOCAL-DATA       IS LOCAL-DATA-AREA
                               C01 IS NEW-PAGE.
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT RAWMTL-FILE            ASSIGN TO DISK-DRAWMTL.
           SELECT STOCK-FILE             ASSIGN TO DISK-DSTCKVAL.
           SELECT RMACTIVE               ASSIGN TO DISK-RMACTIVE
                                         FILE STATUS IS FILE-STATUS.
           SELECT MALTKEY-CA-I
               ASSIGN TO DATABASE-MCFLCS3001
               ORGANIZATION IS INDEXED
                 ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
               FILE STATUS IS FILE-STATUS.
           SELECT MSTORERM-CD-I
               ASSIGN TO DATABASE-MCFLCS0201
               ORGANIZATION IS INDEXED
                 ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
               FILE STATUS IS FILE-STATUS.
           SELECT MPLTINFO-PK-I
               ASSIGN TO DATABASE-MCFLCS0501
               ORGANIZATION IS INDEXED
                 ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
               FILE STATUS IS FILE-STATUS.
           SELECT DISPLAY-FILE
                  ASSIGN TO WORKSTATION-ZRMENTRY-SI
                  ORGANIZATION IS TRANSACTION
                  ACCESS IS SEQUENTIAL
                  FILE STATUS IS DISPLAY-STATUS
                  CONTROL-AREA IS WS-CONTROL.
       DATA DIVISION.
       FILE SECTION.

      *------ FOR IBM ONLY ------*
       FD  MALTKEY-CA-I
           LABEL RECORDS ARE STANDARD.
       01  MALTKEY-CA-REC-I.
           COPY DDS-MCRPCS3000  OF MCFLCS3001.

       FD  MSTORERM-CD-I
           LABEL RECORDS ARE STANDARD.
       01  MSTORERM-CD-REC-I.
           COPY DDS-MCRPCS0200  OF MCFLCS0201.

       FD  MPLTINFO-PK-I
           LABEL RECORDS ARE STANDARD.
       01  MPLTINFO-PK-REC-I.
           COPY DDS-MCRPCS0500  OF MCFLCS0501.

       FD  DISPLAY-FILE
           LABEL RECORDS ARE OMITTED.
       01  DISPLAY-REC        PIC X(1500).
      *------ FOR IBM ONLY ------*

       FD  RMACTIVE
           RECORD CONTAINS 80 CHARACTERS.
       01  RMACTIVE-REC                  PIC X(80).

       FD  RAWMTL-FILE
           RECORD CONTAINS 16 CHARACTERS
           DATA RECORD IS RAWMTL-REC.
       01  RAWMTL-REC.
           05  RAWMTL-CODE               PIC X(8).
           05  RAWMTL-LBS                PIC 9(8).

       FD  STOCK-FILE
           RECORD CONTAINS  9 CHARACTERS
           DATA RECORD IS STOCK-VALUE-REC.
       01  STOCK-VALUE-REC.
           05  STOCK-VALUE               PIC 9(9).

       WORKING-STORAGE SECTION.
      ***************************************************************
      **               W O R K I N G   S T O R A G E               **
      ***************************************************************
       77  HANDLE-BLOWUP-FLAG            PIC X(1)  VALUE "Y".
       77  ERROR-SW                      PIC X(1)  VALUE "N".
       01  INDX                          PIC 9(2)  VALUE 1.
       01  INDY                          PIC 9     VALUE 1.
       01  INDZ                          PIC 9(2)  VALUE 1.
       01  BUFFER-SW                     PIC X(1)  VALUE "1".
       01  CODE-TABLE                    PIC X(384) VALUE SPACES.
       01  CODE-TABLE-RDF REDEFINES CODE-TABLE.
           05  CODE-TABLE-INFO OCCURS 24 TIMES.
               10  CT-CODE               PIC X(8).
               10  CT-QTY                PIC X(8).

      *
      * FILE STATUS DEFINITION FOR AS/400 DB CALLS OR HP KSAM CALLS
      *
       01  FILE-STATUS.
           05  FILE-STATUS-1             PIC X.
           05  FILE-STATUS-2             PIC X.

      ***************************************************************
      **              S U B P R O G R A M   A R E A S              **
      ***************************************************************
       COPY TBLOWUP    IN COPYLIB.
       COPY TSHWRDFM   IN COPYLIB.
       COPY CATREAD    IN COPYLIB.
       COPY CDLTF      IN COPYLIB.
       COPY CCRTFILE   IN COPYLIB.
       COPY JCWAREA    IN COPYLIB.

      ***************************************************************
      **                    D A T A B A S E                        **
      ***************************************************************

       COPY DATAB      IN COPYLIB.

       01  DATASET-NAMES.
           05  DSET-MPLTINFO             PIC X(16)  VALUE "MPLTINFO;".
           05  DSET-MSTORERM             PIC X(16)  VALUE "MSTORERM;".
           05  DSET-MALTKEY              PIC X(16)  VALUE "MALTKEY;".
           05  DSET-NAME                 PIC X(16)  VALUE SPACES.

       01  ITEMS-LISTINGS.
           05  ALL-ITEMS                 PIC X(2)   VALUE "@;".

       01  ARG-VALUES.
           05  ALT-KEY-ARG               PIC X(40)  VALUE SPACES.
           05  CODE-ARG                  PIC X(8)   VALUE SPACES.
           05  PLT-ARG.
               10  MPLTINFO-FILLER       PIC X(1)   VALUE "*".
               10  MPLTINFO-PRT          PIC X(3).

      ***************************************************************
      **             D A T A B A S E    B U F F E R S              **
      ***************************************************************

       COPY MSTORERM   IN COPYLIB.
       COPY MALTKEY    IN COPYLIB.

       01  BUF-MPLTINFO.
           05  MPLTINFO-KEY              PIC X(4).
           05  MPLTINFO-DATA             PIC X(60).
           05  MPLTINFO-PRINTER REDEFINES MPLTINFO-DATA.
               10  MPLTINFO-JSPOOLER     PIC X(2).
               10  MPLTINFO-JSPOOL-TYPE  PIC X(2).
               10  FILLER                PIC X(56).

      ***************************************************************
      **       T E R M I N A L   I / O   D A T A   A R E A         **
      ***************************************************************

       01  DE-FIELDS-1.
           05  FIN-STOCK-VALUE           PIC X(9).
           05  CODE-LOAD-AREA            PIC X(480).
           05  CODE-LOAD-RDF REDEFINES CODE-LOAD-AREA.
               10  CODE-QTY-ROW             OCCURS 12 TIMES.
                   15  CODE-QTY-COLUMN      OCCURS  2 TIMES.
                       20  CS-CODE       PIC X(12).
                       20  CS-QTY        PIC X(8).
           05  FILLER                    PIC X(1).
           05  DE-COMMAND-LINE-1         PIC X(79).
           05  DE-MESSAGE-LINE-1         PIC X(79).

       01  DE-FIELDS-2.
           05  DE-COMMAND-LINE-2         PIC X(79).
           05  DE-MESSAGE-LINE-2         PIC X(79).

      ***************************************************************
      **             V I E W   W O R K   A R E A                   **
      ***************************************************************

       COPY DISPDAT2   IN COPYLIB.
       COPY IOFEEDBACK IN COPYLIB.
       COPY FUNCTDEF   IN COPYLIB.
       COPY VCOMAREA   IN COPYLIB.
       01  SAVE-LASTKEY                  PIC S9(4) BINARY VALUE 0.

       01  FORMFILE.
           05  FORM-FNAME               PIC X(8)  VALUE "FRMENTRY".
           05  FILLER                   PIC X(1)  VALUE ".".
           05  FORM-GNAME.
               10  FORM-GNAME1          PIC X(5)  VALUE "FLANG".
               10  FORM-GNAME2          PIC X(3)  VALUE SPACES.
           05  FILLER                   PIC X(19) VALUE SPACES.

      ***************************************************************
      **      N A T I V E    L A N G U A G E   S U P P O R T       **
      ***************************************************************

       COPY LANGUAGE IN COPYLIB.
       COPY HMSGBUF IN COPYLIB.

      ***************************************************************
      **###########################################################**
      ***************************************************************
      **                                                           **
      **           P R O C E D U R E    D I V I S I O N            **
      **                                                           **
      ***************************************************************
      **###########################################################**
      ***************************************************************

       PROCEDURE DIVISION.
       MAIN-LINE-LOGIC.
           OPEN INPUT RMACTIVE.
           OPEN I-O DISPLAY-FILE.
           IF FILE-STATUS EQUAL "00"

      *
      * SOME USER IS ALREADY
      * ACCESSING THE FILE DRAWMTL  OR THE BATCH REPORT JOB IS
      * RUNNING.  NO SIMULTANEOUS ACCESS IS ALLOWED.
      *
             CLOSE RMACTIVE
             PERFORM 61-RMACTIVE-EXISTS THRU 61-RE-X

           ELSE

             MOVE SPACES        TO CCRTFILE-PARMS
             MOVE "*CURLIB"     TO CCRTFILE-LIBRARY
             MOVE "RMACTIVE"    TO CCRTFILE-FILE
             MOVE 80            TO CCRTFILE-RECORD-LENGTH
             MOVE 1             TO CCRTFILE-NO-RECORDS
             MOVE 0             TO CCRTFILE-INCREMENT-AMT
             MOVE 0             TO CCRTFILE-NO-INCREMENTS
             CALL "CCRTFILE" USING CCRTFILE-LIBRARY,
                                   CCRTFILE-FILE,
                                   CCRTFILE-RECORD-LENGTH,
                                   CCRTFILE-NO-RECORDS,
                                   CCRTFILE-INCREMENT-AMT,
                                   CCRTFILE-NO-INCREMENTS,
                                   CCRTFILE-STATUS
             IF CCRTFILE-STATUS NOT = "00"

                 MOVE "CCRTFILE CREATE OF 'DRAWMTL' FAILED"
                    TO BU-DISPLAY-MSG
                 GO TO 2100-BLOWUP

             END-IF
             PERFORM 9999-OPENS
             PERFORM 60-MAIN THRU 60-MAIN-X
             PERFORM 9999-CLOSES

           END-IF.
           CLOSE DISPLAY-FILE.
           GOBACK.

      ***************************************************************
      **                                                           **
      **                       6 0 - M A I N                       **
      **                                                           **
      ***************************************************************

       60-MAIN.
           MOVE SPACES        TO CCRTFILE-PARMS.
           MOVE "*CURLIB"     TO CCRTFILE-LIBRARY.
           MOVE "DRAWMTL"     TO CCRTFILE-FILE.
           MOVE 16            TO CCRTFILE-RECORD-LENGTH.
           MOVE 2000          TO CCRTFILE-NO-RECORDS.
           MOVE 10            TO CCRTFILE-INCREMENT-AMT.
           MOVE 1             TO CCRTFILE-NO-INCREMENTS.
           CALL "CCRTFILE" USING CCRTFILE-LIBRARY,
                                 CCRTFILE-FILE,
                                 CCRTFILE-RECORD-LENGTH,
                                 CCRTFILE-NO-RECORDS,
                                 CCRTFILE-INCREMENT-AMT,
                                 CCRTFILE-NO-INCREMENTS,
                                 CCRTFILE-STATUS.
           IF CCRTFILE-STATUS NOT = "00"
               MOVE "CCRTFILE CREATE OF 'DRAWMTL' FAILED"
                  TO BU-DISPLAY-MSG
               GO TO 2100-BLOWUP.

           MOVE SPACES        TO CCRTFILE-PARMS.
           MOVE "*CURLIB"     TO CCRTFILE-LIBRARY.
           MOVE "DSTCKVAL"    TO CCRTFILE-FILE.
           MOVE 9             TO CCRTFILE-RECORD-LENGTH.
           MOVE 1             TO CCRTFILE-NO-RECORDS.
           MOVE 1             TO CCRTFILE-INCREMENT-AMT.
           MOVE 1             TO CCRTFILE-NO-INCREMENTS.
           CALL "CCRTFILE" USING CCRTFILE-LIBRARY,
                                 CCRTFILE-FILE,
                                 CCRTFILE-RECORD-LENGTH,
                                 CCRTFILE-NO-RECORDS,
                                 CCRTFILE-INCREMENT-AMT,
                                 CCRTFILE-NO-INCREMENTS,
                                 CCRTFILE-STATUS.
           IF CCRTFILE-STATUS NOT = "00"
               MOVE "CCRTFILE CREATE OF 'DSTCKVAL' FAILED"
                  TO BU-DISPLAY-MSG
               GO TO 2100-BLOWUP.

           OPEN OUTPUT RAWMTL-FILE,
                       STOCK-FILE.

       60-GET-NEXTFORM.
           MOVE "ENTRYSCR1" TO VIEW-NFNAME.
           PERFORM 9999-GETNEXTFORM.

       60-PUT-WINDOW.
           MOVE SPACES                   TO MESSAGE-BUFFER.
           PERFORM 9999-PUTWINDOW.

       60-PUT-BUFFER.
           MOVE SPACES TO CODE-LOAD-AREA.
       60-SHOW-FORM.
           MOVE 2 TO SRF-MODE.
           PERFORM 9999-DO-SCREEN-1.

           IF VIEW-LASTKEY = EXIT-PROGRAM
             CLOSE RAWMTL-FILE
             CLOSE STOCK-FILE
             MOVE "DRAWMTL" TO DLTF-FILE-NAME
             CALL "CDLTF" USING DLTF-FILE-NAME
             MOVE "DSTCKVAL" TO DLTF-FILE-NAME
             CALL "CDLTF" USING DLTF-FILE-NAME
             MOVE "RMACTIVE" TO DLTF-FILE-NAME
             CALL "CDLTF" USING DLTF-FILE-NAME
             GO TO 60-MAIN-X.

       60-GET-BUFFER.
           IF BUFFER-SW = "1"
               MOVE FIN-STOCK-VALUE      TO STOCK-VALUE
               IF ERROR-SW = "Y"
                   NEXT SENTENCE
               ELSE
                   WRITE STOCK-VALUE-REC.

      *--------- INITIALIZE THE INDEXES
           MOVE 1 TO INDX, INDY, INDZ.
           MOVE SPACES TO CODE-TABLE.

       60-EDIT-CHECKS.
      *--------- VALIDATE CODES ENTERED BY USER

           PERFORM VARYING INDY FROM 1 BY 1
                   UNTIL INDY > 2 OR SRF-ERROR-FLD > 0

             PERFORM VARYING INDX FROM 1 BY 1
                     UNTIL INDX > 12 OR SRF-ERROR-FLD > 0

               IF CS-CODE (INDX, INDY) NOT EQUAL SPACES

                 MOVE CS-CODE (INDX, INDY) TO ALT-KEY-ARG
                 PERFORM 9999-GETKEY-MALTKEY-CA-I
                 IF NO-ENTRY
                     MOVE CS-CODE (INDX, INDY) TO CODE-ARG
                 ELSE
                     MOVE ALT-CORP-CODE TO CODE-ARG
                 END-IF

                 PERFORM 9999-GETKEY-MSTORERM-CD-I
                 IF NO-ENTRY

                   MOVE 19009 TO CATREAD-MSG-NUMBER
                   PERFORM 999-CATREAD
                   COMPUTE SRF-ERROR-FLD =
                     (INDY * 2) + ((INDX - 1) * 4)
                   MOVE "Y" TO ERROR-SW

                 ELSE

                   MOVE CORP-CODE TO CT-CODE (INDZ)
                   MOVE CS-QTY (INDX, INDY) TO CT-QTY (INDZ)
                   ADD 1 TO INDZ

                 END-IF

               END-IF

             END-PERFORM

           END-PERFORM.
           IF SRF-ERROR-FLD > 0
             GO TO 60-SHOW-FORM.

           MOVE 1 TO INDX, INDY.
       60-WRITE-CODES.
      *--------- WRITE THE CODES TO THE FILE

           PERFORM VARYING INDZ FROM 1 BY 1
                   UNTIL INDZ > 24 OR
                         CT-CODE(INDZ) EQUAL SPACES

             MOVE CT-CODE (INDZ) TO RAWMTL-CODE
             MOVE CT-QTY (INDZ) TO RAWMTL-LBS
             WRITE RAWMTL-REC

           END-PERFORM.

      *---------- IF THE USER PRESSED 'ENTER' BRING UP AN EMPTY BUFFER
      *---------- SO THAT THEY CAN CONTINUE ENTERING CODES
           IF VIEW-LASTKEY = ENTER-KEY
               PERFORM 9999-RESET-SCREEN
               IF BUFFER-SW = "1"
                   MOVE "X" TO BUFFER-SW
                   MOVE "ENTRYSCR2" TO VIEW-NFNAME
                   PERFORM 9999-GETNEXTFORM
                   GO TO 60-PUT-WINDOW
               ELSE
                   GO TO 60-PUT-WINDOW.

           CLOSE RAWMTL-FILE,
                 STOCK-FILE.

      *---------- IF THE USER PRESSED 'f2' RUN THE REPORT
           IF VIEW-LASTKEY = F2-KEY
               PERFORM 62-WRITE-RPT THRU 62-WRITE-RPT-X.

       60-MAIN-X.
           EXIT.

       61-RMACTIVE-EXISTS.
      *--------- THE BATCH REPORT PROGRAM OR ANOTHER USER IS ACCESSING
      *--------- DRAWMTL.DB
           MOVE "RMACTIVE"              TO VIEW-NFNAME.
           PERFORM 9999-GETNEXTFORM.

           MOVE SPACES                  TO MESSAGE-BUFFER.
           PERFORM 9999-PUTWINDOW.
           PERFORM 9999-DO-SCREEN-2.

       61-RE-X.
           EXIT.

      ***************************************************************
      **                                                           **
      **             6 2 - W R I T E - R E P O R T                 **
      **                                                           **
      ***************************************************************

       62-WRITE-RPT.

      *
      * TREAT IT AS A BATCH REPORT WITH NO OPTIONS
      *  -- CHANGE TO LATEST PORTABLILITY WHEN PORTED.
      *
           MOVE "088" TO SETJCW-VALUE.
           MOVE 278 TO SETJCW-STARTING-POS.
           MOVE 3 TO SETJCW-LENGTH.
           CALL "SETJCW" USING SETJCW-VALUE, SETJCW-STARTING-POS,
                               SETJCW-LENGTH, SETJCW-STATUS.
           CALL "TRSCREN2".

       62-WRITE-RPT-X.
           EXIT.


      ***************************************************************
      **                      BLOWUP ROUTINE                       **
      ***************************************************************
       2100-BLOWUP.
           MOVE "TRMENTRY" TO BU-PGM-NAME.
           CALL "TBLOWUP" USING BASE, BU-PGM-NAME, STATUS-AREA,
               VIEW-COMAREA, FILE-STATUS, BU-DISPLAY-MSG,
               BU-DISPLAY-AREA.

      *------ THIS VERSION OF CATREAD ASSUMES THE SET/MSG NUMBER
      *------ WILL BE IN CATREAD-MSG-NUMBER.
       999-CATREAD.
           CALL "CCATREAD" USING CATREAD-PARMS.
           MOVE CATREAD-MSG-TEXT TO MESSAGE-BUFFER.
           IF MESSAGE-BUFFER-1  = SPACES
               MOVE "* ERROR ON THIS FIELD *" TO MESSAGE-BUFFER.
       999-CATREAD-EXIT.
           EXIT.

       9999-OPENS.
           OPEN INPUT MALTKEY-CA-I
                      MSTORERM-CD-I
                      MPLTINFO-PK-I.

       9999-CLOSES.
           CLOSE      MALTKEY-CA-I
                      MSTORERM-CD-I
                      MPLTINFO-PK-I.

       9999-GETKEY-MALTKEY-CA-I.
           MOVE 0 TO COND-WORD.
           MOVE ALT-KEY-ARG TO CORPALTKEY OF MALTKEY-CA-REC-I.
           READ MALTKEY-CA-I INTO BUF-MALTKEY
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS = "23"
               MOVE 17 TO COND-WORD
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD
               IF HANDLE-BLOWUP-FLAG = "Y"
                   MOVE "GETKEY ERR 9999-GETKEY-MALTKEY-CA-I"
                       TO BU-MSG-AREA
                   PERFORM 2100-BLOWUP.

       9999-GETKEY-MSTORERM-CD-I.
           MOVE 0 TO COND-WORD.
           MOVE CODE-ARG TO CORPCDE OF MSTORERM-CD-REC-I.
           READ MSTORERM-CD-I INTO BUF-MSTORERM
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS = "23"
               MOVE 17 TO COND-WORD
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD
               IF HANDLE-BLOWUP-FLAG = "Y"
                   MOVE "GETKEY ERR 9999-GETKEY-MSTORERM-CD-I"
                       TO BU-MSG-AREA
                   PERFORM 2100-BLOWUP.

       9999-GETKEY-MPLTINFO-PK-I.
           MOVE 0 TO COND-WORD.
           MOVE PLT-ARG TO PLTINFOKEY OF MPLTINFO-PK-REC-I.
           READ MPLTINFO-PK-I INTO BUF-MPLTINFO
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS = "23"
               MOVE 17 TO COND-WORD
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD
               IF HANDLE-BLOWUP-FLAG = "Y"
                   MOVE "GETKEY ERR 9999-GETKEY-MPLTINFO-PK-I"
                       TO BU-MSG-AREA
                   PERFORM 2100-BLOWUP.

       9999-GETNEXTFORM.
       9999-PUTWINDOW.
       9999-INITFORM.
       9999-SHOWFORM.
       9999-SETKEYLABEL.
       998-WRITE-SCREEN.
           IF SRF-CURSOR-FLD > ZERO
               MOVE B"1" TO IND (SRF-CURSOR-FLD)
               MOVE ZERO TO SRF-CURSOR-FLD.
           WRITE DISPLAY-REC  FORMAT IS VIEW-NFNAME
               INDIC ARE SRF-INDICATORS.
           MOVE ALL B"0" TO SRF-INDICATORS.

       998-READ-SCREEN.
           READ  DISPLAY-FILE FORMAT IS VIEW-NFNAME
               INDIC ARE SRF-INDICATORS.
           ACCEPT IOFEEDBACK FROM I-O-FEEDBACK-AREA.
           MOVE ALL B"0" TO SRF-INDICATORS.

      *------ A BAD STATUS MAY MEAN USER TURNED OFF TERMINAL.
      *------ IF SO, SIMULATE THE F3 KEY TO EXIT PROGRAM.
           IF DISPLAY-STATUS NOT = "00"
               MOVE EXIT-PROGRAM TO VIEW-LASTKEY
           ELSE
               MOVE FUNCTION-NUM TO VIEW-LASTKEY.
           IF SRF-KEYSET = 1 OR 3 OR 5 OR 7
               MOVE "I" TO SRF-FKEY (7).
           IF SRF-KEYSET > 0
               MOVE "I" TO SRF-FKEY (5).
           IF SRF-KEYSET = 1 OR 2 OR 5 OR 6 OR 7 OR 8
               MOVE "I" TO SRF-FKEY (4).
           IF SRF-KEYSET = 5 OR 6
               MOVE "I" TO SRF-FKEY (8), SRF-FKEY (6)
           ELSE
           IF SRF-KEYSET = 7 OR 8
               MOVE "I" TO SRF-FKEY (1), SRF-FKEY (2), SRF-FKEY (8).
           MOVE SPACES TO MESSAGE-BUFFER-1.
           IF VIEW-LASTKEY = ENTER-KEY
               IF SRF-ENTER-FLAG = "I"
      *            "E28: 'ENTER' NOT VALID HERE"
                   MOVE 5 TO LANG-SETNUM
                   MOVE 28 TO LANG-MSGNUM
                   MOVE 05028 TO CATREAD-MSG-NUMBER
                   MOVE 1 TO SRF-ERROR-FLD
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               ELSE
                   NEXT SENTENCE
           ELSE
           IF SRF-FKEY (VIEW-LASTKEY) = "I"
      *        "I10: INVALID FUNCTION KEY"
               MOVE 9 TO LANG-SETNUM
               MOVE 10 TO LANG-MSGNUM
               MOVE 09010 TO CATREAD-MSG-NUMBER
               MOVE 1 TO SRF-ERROR-FLD
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
           IF MESSAGE-BUFFER-1 = SPACES
               MOVE SPACES TO SRF-FKEY-AREA, SRF-ENTER-FLAG.
       9989-WS-X.
           EXIT.

       9999-RESET-SCREEN.
           MOVE B"1" TO IND(97).
           MOVE B"1" TO IND(96).

       9999-GETBUFFER-1.
           MOVE DISPLAY-REC TO DE-FIELDS-1.

       9999-PUTBUFFER-1.
           MOVE DE-FIELDS-1 TO DISPLAY-REC.

       9999-SETERROR-1.
           MOVE MESSAGE-BUFFER TO DE-COMMAND-LINE-1.
           IF SRF-MSG-AND-GO = "Y"
             MOVE "N" TO SRF-MSG-AND-GO
             MOVE B"1" TO IND (98)
             MOVE DE-FIELDS-1 TO DISPLAY-REC
             PERFORM 998-WRITE-SCREEN
             READ DISPLAY-FILE TERMINAL IS TERMINAL-ID
               INDIC ARE SRF-INDICATORS
               NO DATA CONTINUE
             END-READ
             MOVE B"0" TO IND(98)
             PERFORM 998-WRITE-SCREEN
             MOVE SPACES TO MESSAGE-BUFFER
           ELSE
             MOVE B"1" TO IND (SRF-ERROR-FLD).

       9999-DO-SCREEN-1.
           MOVE SRF-SAVE-COMMAND-LINE TO DE-COMMAND-LINE-1.
           IF SRF-ERROR-FLD > ZERO
               PERFORM 9999-SETERROR-1.
           PERFORM 9999-PUTBUFFER-1.
           PERFORM 998-WRITE-SCREEN THRU 9989-WS-X.
           PERFORM 9999-GETBUFFER-1.
           IF SRF-LAST-FORM NOT = VIEW-NFNAME
               MOVE VIEW-NFNAME       TO SRF-LAST-FORM
               MOVE DE-COMMAND-LINE-1 TO SRF-SAVE-COMMAND-LINE.
           IF MESSAGE-BUFFER-1 NOT = SPACES
               GO TO 9999-DO-SCREEN-1.
           IF SRF-ERROR-FLD > ZERO
               MOVE ZERO TO SRF-ERROR-FLD
               MOVE SRF-SAVE-COMMAND-LINE TO DE-COMMAND-LINE-1.

       9999-GETBUFFER-2.
           MOVE DISPLAY-REC TO DE-FIELDS-2.

       9999-PUTBUFFER-2.
           MOVE DE-FIELDS-2 TO DISPLAY-REC.

       9999-SETERROR-2.
           MOVE MESSAGE-BUFFER TO DE-COMMAND-LINE-2.
           IF SRF-MSG-AND-GO = "Y"
             MOVE "N" TO SRF-MSG-AND-GO
             MOVE B"1" TO IND (98)
             MOVE DE-FIELDS-2 TO DISPLAY-REC
             PERFORM 998-WRITE-SCREEN
             READ DISPLAY-FILE TERMINAL IS TERMINAL-ID
               INDIC ARE SRF-INDICATORS
               NO DATA CONTINUE
             END-READ
             MOVE B"0" TO IND (98)
             PERFORM 998-WRITE-SCREEN
             MOVE SPACES TO MESSAGE-BUFFER
           ELSE
             MOVE B"1" TO IND (SRF-ERROR-FLD).

       9999-DO-SCREEN-2.
           MOVE SRF-SAVE-COMMAND-LINE TO DE-COMMAND-LINE-2.
           IF SRF-ERROR-FLD > ZERO
               PERFORM 9999-SETERROR-2.
           PERFORM 9999-PUTBUFFER-2.
           PERFORM 998-WRITE-SCREEN THRU 9989-WS-X.
           PERFORM 9999-GETBUFFER-2.
           IF SRF-LAST-FORM NOT = VIEW-NFNAME
               MOVE VIEW-NFNAME       TO SRF-LAST-FORM
               MOVE DE-COMMAND-LINE-2 TO SRF-SAVE-COMMAND-LINE.
           IF MESSAGE-BUFFER-1 NOT = SPACES
               GO TO 9999-DO-SCREEN-2.
           IF SRF-ERROR-FLD > ZERO
               MOVE ZERO TO SRF-ERROR-FLD
               MOVE SRF-SAVE-COMMAND-LINE TO DE-COMMAND-LINE-2.

