000200 IDENTIFICATION DIVISION.
000300 PROGRAM-ID.    TPCHG.
000400 INSTALLATION.  GOODYEAR.
000500*REMARKS.
000600*        #######################################################
000700*        #  This program changes a clock card number only. No  #
000800*        #  other information is changed. All the details are  #
000900*        #  changed also so the master can be deleted........  #
001000*        #######################################################.
      *C
      *C  09/10/96  JEFF BUNGO
      *C     EXPAND DATE FIELDS FOR YEAR 2000 COMPLIANCE.
      *C     RECOMPILE TO PICK UP COPYLIB CHANGES.
      *C
001200 ENVIRONMENT DIVISION.
001300 CONFIGURATION SECTION.
001400 SOURCE-COMPUTER.      AS400.
001500 OBJECT-COMPUTER.      AS400.
       SPECIAL-NAMES.      I-O-FEEDBACK IS I-O-FEEDBACK-AREA
                           LOCAL-DATA IS LOCAL-DATA-AREA.
001000 INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT DISPLAY-FILE
               ASSIGN TO WORKSTATION-ZPERSON-SI
               ORGANIZATION IS TRANSACTION
               ACCESS IS SEQUENTIAL
               FILE STATUS IS DSPLY-STATUS
               CONTROL-AREA IS WS-CONTROL.
           SELECT LABOR-CURR-STAT-FILE
               ASSIGN TO DATABASE-MCFLMM1602
               ORGANIZATION IS INDEXED
               ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                   WITH DUPLICATES
               FILE STATUS IS LCS-STATUS.
           SELECT NEWS-TABLE
               ASSIGN TO DATABASE-MCFLMM2803
               ORGANIZATION IS INDEXED
               ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                   WITH DUPLICATES
               FILE STATUS IS NT-STATUS.
           SELECT PER-ABSENCE
               ASSIGN TO DATABASE-MCFLMM3101
               ORGANIZATION IS INDEXED
               ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                   WITH DUPLICATES
               FILE STATUS IS PA-STATUS.
           SELECT PER-CONFIDENTIAL
               ASSIGN TO DATABASE-MCFLMM3301
               ORGANIZATION IS INDEXED
               ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                   WITH DUPLICATES
               FILE STATUS IS PC-STATUS.
           SELECT PER-FREE
               ASSIGN TO DATABASE-MCFLMM3201
               ORGANIZATION IS INDEXED
               ACCESS IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                   WITH DUPLICATES
               FILE STATUS IS PFC-STATUS.
           SELECT PERSONNEL-FILE
               ASSIGN TO DATABASE-MCFLMM0301
               ORGANIZATION IS INDEXED
               ACCESS IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
               FILE STATUS IS PF-STATUS.
           SELECT WO-LABOR
               ASSIGN TO DATABASE-MCFLMM1302
               ORGANIZATION IS INDEXED
               ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                   WITH DUPLICATES
               FILE STATUS IS WL-STATUS.
           SELECT WO-MESSAGE
               ASSIGN TO DATABASE-MCFLMM2401
               ORGANIZATION IS INDEXED
               ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                   WITH DUPLICATES
               FILE STATUS IS WM-STATUS.
           SELECT WO-OPEN-QUEUE
               ASSIGN TO DATABASE-MCFLMM1903
               ORGANIZATION IS INDEXED
               ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                   WITH DUPLICATES
               FILE STATUS IS WOQ-STATUS.
           SELECT WO-PARTS
               ASSIGN TO DATABASE-MCFLMM1203
               ORGANIZATION IS INDEXED
               ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                   WITH DUPLICATES
               FILE STATUS IS WP-STATUS.
001600 DATA DIVISION.
       FILE SECTION.
       FD  DISPLAY-FILE
           LABEL RECORDS ARE OMITTED.
       01  DSPLY-REC                   PIC X(2000).
       FD  LABOR-CURR-STAT-FILE
           LABEL RECORDS ARE STANDARD
           DATA RECORD IS LCSREC.
       01  LCSREC.
           COPY DDS-ALL-FORMATS OF MCFLMM1602.
       FD  NEWS-TABLE
           LABEL RECORDS ARE STANDARD
           DATA RECORD IS NTREC.
       01  NTREC.
           COPY DDS-ALL-FORMATS OF MCFLMM2803.
       FD  PER-ABSENCE
           LABEL RECORDS ARE STANDARD
           DATA RECORD IS PAREC.
       01  PAREC.
           COPY DDS-ALL-FORMATS OF MCFLMM3101.
       FD  PER-CONFIDENTIAL
           LABEL RECORDS ARE STANDARD
           DATA RECORD IS PCREC.
       01  PCREC.
           COPY DDS-ALL-FORMATS OF MCFLMM3301.
       FD  PER-FREE
           LABEL RECORDS ARE STANDARD
           DATA RECORD IS PFCREC.
       01  PFCREC.
           COPY DDS-ALL-FORMATS OF MCFLMM3201.
       FD  PERSONNEL-FILE
           LABEL RECORDS ARE STANDARD
           DATA RECORD IS PFREC.
       01  PFREC.
           COPY DDS-ALL-FORMATS OF MCFLMM0301.
       FD  WO-LABOR
           LABEL RECORDS ARE STANDARD
           DATA RECORD IS WLREC.
       01  WLREC.
           COPY DDS-ALL-FORMATS OF MCFLMM1302.
       FD  WO-MESSAGE
           LABEL RECORDS ARE STANDARD
           DATA RECORD IS WMREC.
       01  WMREC.
           COPY DDS-ALL-FORMATS OF MCFLMM2401.
       FD  WO-OPEN-QUEUE
           LABEL RECORDS ARE STANDARD
           DATA RECORD IS WOQREC.
       01  WOQREC.
           COPY DDS-ALL-FORMATS OF MCFLMM1903.
       FD  WO-PARTS
           LABEL RECORDS ARE STANDARD
           DATA RECORD IS WPREC.
       01  WPREC.
           COPY DDS-ALL-FORMATS OF MCFLMM1203.
001700 WORKING-STORAGE SECTION.
       01  BLOWUP-BASE                  PIC X(16).
003300 01  CARD-YEAR-WS.
003400     05  CARD-WS                  PIC X(4).
003500     05  YEAR-WS                  PIC X(2).
       COPY CATREAD OF COPYLIB.
       COPY CPYIND  OF COPYLIB.
005100 01  LABOR-CURR-STAT-DATA.        COPY DCURRLBR OF COPYLIB.
004000 01  ERROR-BUFFER.
           05  FILLER                   PIC X(12).
           05  ERR-CC-IN                PIC X(4).
           05  FILLER                   PIC X(34).
           05  ERR-CC-OUT               PIC X(4).
           05  FILLER                   PIC X(26).
       01  FILE-STATUSES.
           05  DSPLY-STATUS             PIC XX.
           05  LCS-STATUS               PIC XX.
           05  NT-STATUS                PIC XX.
           05  PA-STATUS                PIC XX.
           05  PC-STATUS                PIC XX.
           05  PF-STATUS                PIC XX.
           05  PFC-STATUS               PIC XX.
           05  WL-STATUS                PIC XX.
           05  WM-STATUS                PIC XX.
           05  WOQ-STATUS               PIC XX.
           05  WP-STATUS                PIC XX.
       COPY IOFEEDBACK OF COPYLIB.
005200 01  LABOR-DATA.                  COPY DWOLABOR OF COPYLIB.
005300 01  MESSAGE-DATA.                COPY DWOMSG   OF COPYLIB.
005400 01  NEWS-DATA.                   COPY DNEWSTBL OF COPYLIB.
003100 01  MSG-SW                       PIC 9.
005000 01  OPEN-QUEUE-DATA.             COPY DWOOPENQ OF COPYLIB.
001800 01  PASSWORD-INFORMATION.
001900     05  NAME-OF-PROGRAM     PIC X(08) VALUE "TPCHG   ".
002000     05  PROGRAM-TYPE        PIC X(02) VALUE "MA".
002100     05  PROGRAM-RELEASE     PIC X(12) VALUE " E0100010001".
002200     05  PROGRAM-DESCRIPTION.
002300         10  PROG-DESC-A     PIC X(60) VALUE
002400         "CHANGES A CLOCK CARD NUMBER IN THE PERSONNEL SYSTEM "  .
002500         10  PROG-DESC-B     PIC X(60) VALUE SPACES.
002700         10  PROG-FUNCTION   PIC X(60) VALUE SPACES.
002900     05  PASSWORD-FLAG       PIC X.
004600 01  PER-PERSONNEL.               COPY MPERSONL OF COPYLIB.
004700 01  PER-ABSENCE-DATA.            COPY DPERABS  OF COPYLIB.
004800 01  PER-FREE-WS.                 COPY DPERFREE OF COPYLIB.
004900 01  PER-CONFIDENTIAL-DATA.       COPY DPERCONF OF COPYLIB.
003600 01  SCREEN-BUFFER.
003700     05  CC01                     PIC X(4).
003800     05  CC02                     PIC X(4).
           05  SCREEN-CMD-LINE          PIC X(79).
           05  SCREEN-ERR-LINE          PIC X(79).
004100 COPY DBSTAT  OF COPYLIB.
003200 01  STOP-SW                      PIC X.
       COPY TBLOWUP   OF COPYLIB.
       01  TRUE-VAL                     PIC 1 VALUE B"1".
       01  WO-PARTS-DATA.               COPY DWOPARTS OF COPYLIB.
005500 COPY WSCONTROL OF COPYLIB.
005600 LINKAGE SECTION.
005700 01  DBPARAMETERS.                COPY DBPARMS  OF COPYLIB.
005800 COPY VCOMLINK OF COPYLIB.
005900 01  PLT-IDT                      PIC X(4).
006200 PROCEDURE DIVISION USING DBPARAMETERS
006300                          VIEW-COMAREA
006400                          PLT-IDT.
007400 BEGIN-PROGRAM.
           PERFORM 1-HSK.
           PERFORM 6-MAIN.
008800 2-EOJ.
           CLOSE DISPLAY-FILE.
           CLOSE LABOR-CURR-STAT-FILE.
           CLOSE NEWS-TABLE.
           CLOSE PER-ABSENCE.
           CLOSE PER-CONFIDENTIAL.
           CLOSE PER-FREE.
           CLOSE PERSONNEL-FILE.
           CLOSE WO-LABOR.
           CLOSE WO-MESSAGE.
           CLOSE WO-OPEN-QUEUE.
           CLOSE WO-PARTS.
009000     GOBACK.
       1-HSK.
           OPEN I-O   DISPLAY-FILE.
           OPEN I-O   LABOR-CURR-STAT-FILE.
           OPEN I-O   NEWS-TABLE.
           OPEN I-O   PER-ABSENCE.
           OPEN I-O   PER-CONFIDENTIAL.
           OPEN I-O   PER-FREE.
           OPEN I-O   PERSONNEL-FILE.
           OPEN I-O   WO-LABOR.
           OPEN I-O   WO-MESSAGE.
           OPEN I-O   WO-OPEN-QUEUE.
           OPEN I-O   WO-PARTS.
006700     CALL "TPWORD" USING PASSWORD-INFORMATION.
007100     IF PASSWORD-FLAG = "N" GO TO 2-EOJ.
007500     MOVE SPACES TO ERROR-BUFFER SCREEN-BUFFER.
007600     MOVE "FPCHG" TO VIEW-CFNAME.
009100 6-MAIN.
           IF INDS (99) = TRUE-VAL
               MOVE ERROR-BUFFER TO SCREEN-ERR-LINE.
           MOVE SCREEN-BUFFER TO DSPLY-REC.
           PERFORM 99-SCREEN-WRITE.
009200     PERFORM 98-SCREEN-READ.
           MOVE DSPLY-REC TO SCREEN-BUFFER.
010200     IF VIEW-LASTKEY = 3 GO TO 2-EOJ.
012400     IF CC01 = "9999" GO TO 2-EOJ.
012500     IF CC02 = "9999" GO TO 2-EOJ.
           MOVE 0 TO COND-WORD.
           MOVE CC02 TO PERCCNUM OF PFREC.
           START PERSONNEL-FILE KEY IS = EXTERNALLY-DESCRIBED-KEY
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF PF-STATUS NOT = "00" MOVE 17 TO COND-WORD.
015100     IF COND-WORD = 0
015200         MOVE 29069 TO CATREAD-MSG-NUMBER
015400         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE TRUE-VAL TO INDS (2) INDS (99)
016300         GO TO 6-MAIN.
012800     PERFORM 69-START-PERSONNEL-FILE.
013300     IF COND-WORD = 17
013400         MOVE 29023 TO CATREAD-MSG-NUMBER
013600         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE TRUE-VAL TO INDS (1) INDS (99)
014500         GO TO 6-MAIN.
014800     PERFORM 69-READ-PERSONNEL-FILE.
           IF COND-WORD = 15
               MOVE 29023 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE TRUE-VAL TO INDS (1) INDS (99)
               GO TO 6-MAIN.
019300     MOVE CC02 TO PER-CC-NUM OF PER-PERSONNEL.
           MOVE 0 TO COND-WORD.
019500     WRITE PFREC FROM PER-PERSONNEL
019600         INVALID KEY    MOVE 17 TO COND-WORD.
           IF PF-STATUS NOT = "00" MOVE 17 TO COND-WORD.
019700     IF COND-WORD = 17
               MOVE "WRITE ERROR PER-PERSONNEL * TPCHG *"
                   TO BU-DISPLAY-MSG
               PERFORM 998-BLOWUP.
           PERFORM 69-START-WO-OPEN-QUEUE.
031200     IF COND-WORD = 17
031300         NEXT SENTENCE
031400     ELSE
020600     MOVE "N" TO STOP-SW
020700     PERFORM 601-CHG-OPEN-DATA THRU 601-COD-EXIT
020800         UNTIL STOP-SW = "Y".
033400     PERFORM 69-START-LABOR-CURR-STAT.
033700     IF COND-WORD = 17
033800         NEXT SENTENCE
033900     ELSE
021600     MOVE "N" TO STOP-SW
021700     PERFORM 602-CHG-STAT-DATA THRU 602-CSD-EXIT
021800         UNTIL STOP-SW = "Y".
035900     PERFORM 69-START-WO-LABOR.
036200     IF COND-WORD = 17
036300         NEXT SENTENCE
036400     ELSE
022600     MOVE "N" TO STOP-SW
022700     PERFORM 603-CHG-LABOR-DATA THRU 603-CLD-EXIT
022800         UNTIL STOP-SW = "Y".
023100     MOVE 1 TO MSG-SW.
038400     PERFORM 69-START-WO-MESSAGE.
038700     IF COND-WORD = 17
038800         NEXT SENTENCE
038900     ELSE
023700     MOVE "N" TO STOP-SW
023800     PERFORM 604-CHG-MSG-DATA   THRU 604-CMD-EXIT
023900         UNTIL STOP-SW = "Y".
024000     MOVE 2 TO MSG-SW.
038400     PERFORM 69-START-WO-MESSAGE.
038700     IF COND-WORD = 17
038800         NEXT SENTENCE
038900     ELSE
           MOVE "N" TO STOP-SW
024300     PERFORM 604-CHG-MSG-DATA   THRU 604-CMD-EXIT
024400         UNTIL STOP-SW = "Y".
041000     PERFORM 69-START-NEWS-TABLE.
041300     IF COND-WORD = 17
041400         NEXT SENTENCE
041500     ELSE
025200     MOVE "N" TO STOP-SW
025300     PERFORM 605-CHG-NEWS-DATA THRU 605-CND-EXIT
025400         UNTIL STOP-SW = "Y".
025800     MOVE CC01 TO CARD-WS.
025900     MOVE PER-YEAR1 TO YEAR-WS.
043500     PERFORM 69-START-PER-ABSENCE.
043800     IF COND-WORD = 17
043900         NEXT SENTENCE
044000     ELSE
026800     MOVE "N" TO STOP-SW
026400     PERFORM 606-CHG-ABS-DATA  THRU 606-CAD-EXIT
026500         UNTIL STOP-SW = "Y".
           MOVE CC01 TO CARD-WS.
           MOVE PER-YEAR2 TO YEAR-WS.
043500     PERFORM 69-START-PER-ABSENCE.
043800     IF COND-WORD = 17
043900         NEXT SENTENCE
044000     ELSE
026800     MOVE "N" TO STOP-SW
026900     PERFORM 606-CHG-ABS-DATA  THRU 606-CAD-EXIT
027000         UNTIL STOP-SW = "Y".
           MOVE CC01 TO CARD-WS.
           MOVE PER-YEAR3 TO YEAR-WS.
043500     PERFORM 69-START-PER-ABSENCE.
043800     IF COND-WORD = 17
043900         NEXT SENTENCE
044000     ELSE
027300     MOVE "N" TO STOP-SW
027400     PERFORM 606-CHG-ABS-DATA  THRU 606-CAD-EXIT
027500         UNTIL STOP-SW = "Y".
046200     PERFORM 69-START-PER-FREE.
046500     IF COND-WORD = 17
046600         NEXT SENTENCE
046700     ELSE
028300     MOVE "N" TO STOP-SW
028400     PERFORM 607-CHG-FREE-DATA THRU 607-CFD-EXIT
028500         UNTIL STOP-SW = "Y".
048700     PERFORM 69-START-PER-CONFIDENTIAL.
049000     IF COND-WORD = 17
049100         NEXT SENTENCE
049200     ELSE
029300     MOVE "N" TO STOP-SW
029400     PERFORM 608-CHG-CONF-DATA THRU 608-CCD-EXIT
029500         UNTIL STOP-SW = "Y".
048700     PERFORM 69-START-WO-PARTS.
049000     IF COND-WORD = 17
049100         NEXT SENTENCE
049200     ELSE
029300     MOVE "N" TO STOP-SW
029400     PERFORM 609-CHG-PARTS-DATA THRU 609-CPD-EXIT
029500         UNTIL STOP-SW = "Y".
           PERFORM 61-DELETE-MASTER THRU 61-DM-EXIT.
029700 61-DELETE-MASTER.
           PERFORM 69-START-PERSONNEL-FILE.
           IF COND-WORD = 17 GO TO 61-DM-EXIT.
           PERFORM 69-READ-PERSONNEL-FILE.
           IF COND-WORD = 15 GO TO 61-DM-EXIT.
           MOVE 0 TO COND-WORD.
029800     DELETE PERSONNEL-FILE RECORD
029900         INVALID KEY    MOVE 17 TO COND-WORD.
           IF PF-STATUS NOT = "00" MOVE 17 TO COND-WORD.
           IF COND-WORD = 17
               MOVE "PERSONNEL FILE RECORD DELETE FAILED * TPCHG *"
                   TO BU-DISPLAY-MSG
               PERFORM 998-BLOWUP.
           MOVE 66201 TO CATREAD-MSG-NUMBER.
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
           MOVE CC01 TO ERR-CC-IN.
           MOVE CC02 TO ERR-CC-OUT.
           MOVE ERROR-BUFFER TO SCREEN-CMD-LINE.
           MOVE TRUE-VAL TO INDS (98).
           MOVE SCREEN-BUFFER TO DSPLY-REC.
           PERFORM 99-SCREEN-WRITE.
           PERFORM 98A-SCREEN-READ.
           CALL "CLPAUSE2".
       61-DM-EXIT.    EXIT.
030800 601-CHG-OPEN-DATA.
           PERFORM 69-READ-WO-OPEN-QUEUE.
031900     IF COND-WORD = 15
032000         MOVE "Y" TO STOP-SW
032100         GO TO 601-COD-EXIT.
032300     PERFORM 69-DELETE-WO-OPEN-QUEUE.
           IF COND-WORD = 17
               MOVE "DELETE OF WO-OPEN-QUEUE FAILED * TPCHG *"
                   TO BU-DISPLAY-MSG
               PERFORM 998-BLOWUP.
           PERFORM 69-WRITE-WO-OPEN-QUEUE.
           IF COND-WORD = 17
               MOVE "WRITE OF NEW WO-OPEN-QUEUE FAILED * TPCHG *"
                   TO BU-DISPLAY-MSG
               PERFORM 998-BLOWUP.
033100 601-COD-EXIT.    EXIT.
033300 602-CHG-STAT-DATA.
034100     PERFORM 69-READ-LABOR-CURR-STAT.
034400     IF COND-WORD = 15
034500         MOVE "Y" TO STOP-SW
034600         GO TO 602-CSD-EXIT.
034700     PERFORM 69-DELETE-LABOR-CURR-STAT.
034900     IF COND-WORD = 17
               MOVE "LABOR-CURR-STAT DELETE FAILED * TPCHG *"
                   TO BU-DISPLAY-MSG
               PERFORM 998-BLOWUP.
035100     PERFORM 69-WRITE-LABOR-CURR-STAT.
035400     IF COND-WORD = 17
035500         MOVE "WRITE OF LABOR-CURR-STAT FAILED * TPCHG *"
                   TO BU-DISPLAY-MSG
               PERFORM 998-BLOWUP.
035600 602-CSD-EXIT.    EXIT.
035800 603-CHG-LABOR-DATA.
036600     PERFORM 69-READ-WO-LABOR.
036900     IF COND-WORD = 15
037000         MOVE "Y" TO STOP-SW
037100         GO TO 603-CLD-EXIT.
037200     PERFORM 69-DELETE-WO-LABOR.
           IF COND-WORD = 17
               MOVE "DELETE OF WO-LABOR FAILED * TPCHG *"
                   TO BU-DISPLAY-MSG
               PERFORM 998-BLOWUP.
           PERFORM 69-WRITE-WO-LABOR.
           IF COND-WORD = 17
               MOVE "WRITE OF WO-LABOR FAILED * TPCHG *"
                   TO BU-DISPLAY-MSG
               PERFORM 998-BLOWUP.
038100 603-CLD-EXIT.    EXIT.
038300 604-CHG-MSG-DATA.
039100     PERFORM 69-READ-WO-MESSAGE.
039400     IF COND-WORD = 15
039500         MOVE "Y" TO STOP-SW
039600         GO TO 604-CMD-EXIT.
039700     PERFORM 69-DELETE-WO-MESSAGE.
           IF COND-WORD = 17
               MOVE "DELETE OF WO-MESSAGE FAILED * TPCHG *"
                   TO BU-DISPLAY-MSG
               PERFORM 998-BLOWUP.
040000     IF MSG-SW = 1 MOVE CC02 TO FROM-CC.
040100     IF MSG-SW = 2 MOVE CC02 TO TO-CC.
040200     PERFORM 69-WRITE-WO-MESSAGE.
040500     IF COND-WORD NOT = 0
040600         MOVE "WRITE OF WO-MESSAGE FAILED * TPCHG *"
                   TO BU-DISPLAY-MSG
               PERFORM 998-BLOWUP.
040700 604-CMD-EXIT.    EXIT.
040900 605-CHG-NEWS-DATA.
041700     PERFORM 69-READ-NEWS-TABLE.
042000     IF COND-WORD = 15
042100         MOVE "Y" TO STOP-SW
042200         GO TO 605-CND-EXIT.
042300     PERFORM 69-DELETE-NEWS-TABLE.
042500     IF COND-WORD = 17
               MOVE "DELETE OF NEWS DATA FAILED * TPCHG *"
                   TO BU-DISPLAY-MSG
               PERFORM 998-BLOWUP.
042700     PERFORM 69-WRITE-NEWS-TABLE.
042800     IF COND-WORD = 17
042900         MOVE "WRITE FAILED FOR NEWS-DATA * TPCHG *"
043000             TO BU-DISPLAY-MSG
043100         PERFORM 998-BLOWUP.
043200 605-CND-EXIT.    EXIT.
043400 606-CHG-ABS-DATA.
044200     PERFORM 69-READ-PER-ABSENCE.
044500     IF COND-WORD = 15
044600         MOVE "Y" TO STOP-SW
044700         GO TO 606-CAD-EXIT.
044800     PERFORM 69-DELETE-PER-ABSENCE.
044900     IF COND-WORD = 17
045000         MOVE "DELETE FAILED FOR PER-ABSENCE RECORD * TPCHG *"
                   TO BU-DISPLAY-MSG
               PERFORM 998-BLOWUP.
045100     MOVE PER-ABS-CC-YR TO CARD-YEAR-WS.
045200     MOVE CC02 TO CARD-WS.
045300     MOVE CARD-YEAR-WS TO PER-ABS-CC-YR.
045400     PERFORM 69-WRITE-PER-ABSENCE.
045500     IF COND-WORD = 17
045600        MOVE "WRITE FAILED FOR ABSENCE DATA * TPCHG *"
                  TO BU-DISPLAY-MSG
045700        PERFORM 998-BLOWUP.
045900 606-CAD-EXIT.     EXIT.
046100 607-CHG-FREE-DATA.
046900     PERFORM 69-READ-PER-FREE.
047200     IF COND-WORD = 15
04730          MOVE "Y" TO STOP-SW
047400         GO TO 607-CFD-EXIT.
047500     PERFORM 69-DELETE-PER-FREE.
047700     IF COND-WORD = 17
               MOVE "DELETE FAILED FOR PER-FREE * TPCHG *"
                   TO BU-DISPLAY-MSG
               PERFORM 998-BLOWUP.
047800     MOVE CC02 TO PER-FREE-CC.
047900     PERFORM 69-WRITE-PER-FREE.
048000     IF COND-WORD = 17
048100         MOVE "WRITE FAILED FOR PER-FREE * TPCHG *"
048200             TO BU-DISPLAY-MSG
048300         PERFORM 998-BLOWUP.
048400 607-CFD-EXIT.    EXIT.
048600 608-CHG-CONF-DATA.
049400     PERFORM 69-READ-PER-CONFIDENTIAL.
049700     IF COND-WORD = 15
049800         MOVE "Y" TO STOP-SW
049900         GO TO 608-CCD-EXIT.
050000     PERFORM 69-DELETE-PER-CONFIDENTIAL.
050100     IF COND-WORD = 17
050200         MOVE "DELETE OF PER-CONFIDENTIAL FAILED * TPCHG *"
                   TO BU-DISPLAY-MSG
               PERFORM 998-BLOWUP.
050300     MOVE CC02 TO PER-CONF-CC.
050400     PERFORM 69-WRITE-PER-CONFIDENTIAL.
050500     IF COND-WORD = 17
050600         MOVE "WRITE FAILED FOR PER-CONFIDENTIAL * TPCHG *"
050700             TO BU-DISPLAY-MSG
050800         PERFORM 998-BLOWUP.
050900 608-CCD-EXIT.    EXIT.
051000
048600 609-CHG-PARTS-DATA.
049400     PERFORM 69-READ-WO-PARTS.
049700     IF COND-WORD = 15
049800         MOVE "Y" TO STOP-SW
049900         GO TO 609-CPD-EXIT.
050000     PERFORM 69-DELETE-WO-PARTS.
050100     IF COND-WORD = 17
050200         MOVE "DELETE OF WO-PARTS FAILED * TPCHG *"
                   TO BU-DISPLAY-MSG
               PERFORM 998-BLOWUP.
050300     MOVE CC02 TO PRT-ORIGINATOR.
050400     PERFORM 69-WRITE-WO-PARTS.
050500     IF COND-WORD = 17
050600         MOVE "WRITE FAILED FOR WO-PARTS * TPCHG *"
050700             TO BU-DISPLAY-MSG
050800         PERFORM 998-BLOWUP.
050900 609-CPD-EXIT.    EXIT.
051000
       69-DELETE-LABOR-CURR-STAT.
           MOVE 0 TO COND-WORD.
           DELETE LABOR-CURR-STAT-FILE RECORD
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF LCS-STATUS NOT = "00" MOVE 17 TO COND-WORD.

       69-READ-LABOR-CURR-STAT.
           MOVE 0 TO COND-WORD.
           READ LABOR-CURR-STAT-FILE NEXT INTO LABOR-CURR-STAT-DATA
               AT END    MOVE 15 TO COND-WORD.
           IF PERCCNUM OF LCSREC NOT = CC01 MOVE 15 TO COND-WORD.
           IF LCS-STATUS NOT = "00" MOVE 15 TO COND-WORD.

       69-START-LABOR-CURR-STAT.
           MOVE 0 TO COND-WORD.
           MOVE CC01 TO PERCCNUM OF LCSREC.
           START LABOR-CURR-STAT-FILE KEY IS = EXTERNALLY-DESCRIBED-KEY
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF LCS-STATUS NOT = "00" MOVE 17 TO COND-WORD.

       69-WRITE-LABOR-CURR-STAT.
           MOVE 0 TO COND-WORD.
           WRITE LCSREC FROM LABOR-CURR-STAT-DATA
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF LCS-STATUS NOT = "00" MOVE 17 TO COND-WORD.

       69-DELETE-NEWS-TABLE.
           MOVE 0 TO COND-WORD.
           DELETE NEWS-TABLE RECORD
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF NT-STATUS NOT = "00" MOVE 17 TO COND-WORD.

       69-READ-NEWS-TABLE.
           MOVE 0 TO COND-WORD.
           READ NEWS-TABLE NEXT INTO NEWS-DATA
               AT END    MOVE 15 TO COND-WORD.
           IF PERCCNUM OF NTREC NOT = CC01 MOVE 15 TO COND-WORD.
           IF NT-STATUS NOT = "00" MOVE 15 TO COND-WORD.

       69-START-NEWS-TABLE.
           MOVE 0 TO COND-WORD.
           MOVE CC01 TO PERCCNUM OF NTREC.
           START NEWS-TABLE KEY IS = EXTERNALLY-DESCRIBED-KEY
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF NT-STATUS NOT = "00" MOVE 17 TO COND-WORD.

       69-WRITE-NEWS-TABLE.
           MOVE 0 TO COND-WORD.
           WRITE NTREC FROM NEWS-DATA
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF NT-STATUS NOT = "00" MOVE 17 TO COND-WORD.

       69-DELETE-PER-ABSENCE.
           MOVE 0 TO COND-WORD.
           DELETE PER-ABSENCE RECORD
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF PA-STATUS NOT = "00" MOVE 17 TO COND-WORD.

       69-READ-PER-ABSENCE.
           MOVE 0 TO COND-WORD.
           READ PER-ABSENCE NEXT INTO PER-ABSENCE-DATA
               AT END    MOVE 15 TO COND-WORD.
           IF PERABSCCYR OF PAREC NOT = CARD-YEAR-WS
               MOVE 15 TO COND-WORD.
           IF PA-STATUS NOT = "00" MOVE 15 TO COND-WORD.

       69-START-PER-ABSENCE.
           MOVE 0 TO COND-WORD.
           MOVE CARD-YEAR-WS TO PERABSCCYR OF PAREC.
           START PER-ABSENCE KEY IS = EXTERNALLY-DESCRIBED-KEY
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF PA-STATUS NOT = "00" MOVE 17 TO COND-WORD.

       69-WRITE-PER-ABSENCE.
           MOVE 0 TO COND-WORD.
           WRITE PAREC FROM PER-ABSENCE-DATA
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF PA-STATUS NOT = "00" MOVE 17 TO COND-WORD.

       69-DELETE-PER-CONFIDENTIAL.
           MOVE 0 TO COND-WORD.
           DELETE PER-CONFIDENTIAL RECORD
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF PC-STATUS NOT = "00" MOVE 17 TO COND-WORD.

       69-READ-PER-CONFIDENTIAL.
           MOVE 0 TO COND-WORD.
           READ PER-CONFIDENTIAL NEXT INTO PER-CONFIDENTIAL-DATA
               AT END    MOVE 15 TO COND-WORD.
           IF PERCCNUM OF PCREC NOT = CC01 MOVE 15 TO COND-WORD.
           IF PC-STATUS NOT = "00" MOVE 15 TO COND-WORD.

       69-START-PER-CONFIDENTIAL.
           MOVE 0 TO COND-WORD.
           MOVE CC01 TO PERCCNUM OF PCREC.
           START PER-CONFIDENTIAL KEY IS = EXTERNALLY-DESCRIBED-KEY
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF PC-STATUS NOT = "00" MOVE 17 TO COND-WORD.

       69-WRITE-PER-CONFIDENTIAL.
           MOVE 0 TO COND-WORD.
           WRITE PCREC FROM PER-CONFIDENTIAL-DATA
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF PC-STATUS NOT = "00" MOVE 17 TO COND-WORD.

       69-DELETE-PER-FREE.
           MOVE 0 TO COND-WORD.
           DELETE PER-FREE RECORD
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF PFC-STATUS NOT = "00" MOVE 17 TO COND-WORD.

       69-READ-PER-FREE.
           MOVE 0 TO COND-WORD.
           READ PER-FREE NEXT INTO PER-FREE-WS
               AT END    MOVE 15 TO COND-WORD.
           IF PERCCNUM OF PFCREC NOT = CC01 MOVE 15 TO COND-WORD.
           IF PFC-STATUS NOT = "00" MOVE 15 TO COND-WORD.

       69-START-PER-FREE.
           MOVE 0 TO COND-WORD.
           MOVE CC01 TO PERCCNUM OF PFCREC.
           START PER-FREE KEY IS = EXTERNALLY-DESCRIBED-KEY
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF PFC-STATUS NOT = "00" MOVE 17 TO COND-WORD.

       69-WRITE-PER-FREE.
           MOVE 0 TO COND-WORD.
           WRITE PFCREC FROM PER-FREE-WS
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF PFC-STATUS NOT = "00" MOVE 17 TO COND-WORD.

       69-READ-PERSONNEL-FILE.
           MOVE 0 TO COND-WORD.
           READ PERSONNEL-FILE NEXT INTO PER-PERSONNEL
               AT END    MOVE 15 TO COND-WORD.
           IF PF-STATUS NOT = "00" MOVE 15 TO COND-WORD.

       69-START-PERSONNEL-FILE.
           MOVE 0 TO COND-WORD.
           MOVE CC01 TO PERCCNUM OF PFREC.
           START PERSONNEL-FILE KEY IS = EXTERNALLY-DESCRIBED-KEY
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF PF-STATUS NOT = "00" MOVE 17 TO COND-WORD.

       69-DELETE-WO-LABOR.
           MOVE 0 TO COND-WORD.
           DELETE WO-LABOR RECORD
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF WL-STATUS NOT = "00" MOVE 17 TO COND-WORD.

       69-READ-WO-LABOR.
           MOVE 0 TO COND-WORD.
           READ WO-LABOR NEXT INTO LABOR-DATA
               AT END    MOVE 15 TO COND-WORD.
           IF LBR-EMPL-NUM NOT = CC01 MOVE 15 TO COND-WORD.
           IF WL-STATUS NOT = "00" MOVE 15 TO COND-WORD.

       69-START-WO-LABOR.
           MOVE 0 TO COND-WORD.
           MOVE CC01 TO LBRCCNUM OF WLREC.
           START WO-LABOR KEY IS = EXTERNALLY-DESCRIBED-KEY
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF WL-STATUS NOT = "00" MOVE 17 TO COND-WORD.

        69-WRITE-WO-LABOR.
            MOVE 0 TO COND-WORD.
            WRITE WLREC FROM LABOR-DATA
                INVALID KEY    MOVE 17 TO COND-WORD.
            IF WL-STATUS NOT = "00" MOVE 17 TO COND-WORD.

        69-DELETE-WO-MESSAGE.
            MOVE 0 TO COND-WORD.
            DELETE WO-MESSAGE RECORD
                INVALID KEY    MOVE 17 TO COND-WORD.
            IF WM-STATUS NOT = "00" MOVE 17 TO COND-WORD.

        69-READ-WO-MESSAGE.
            MOVE 0 TO COND-WORD.
            READ WO-MESSAGE NEXT INTO MESSAGE-DATA
                AT END    MOVE 15 TO COND-WORD.
            IF FROM-CC NOT = CC01 MOVE 15 TO COND-WORD.
            IF WM-STATUS NOT = "00" MOVE 15 TO COND-WORD.

       69-START-WO-MESSAGE.
           MOVE 0 TO COND-WORD.
           MOVE CC01 TO FROMCC OF WMREC.
           START WO-MESSAGE KEY IS = EXTERNALLY-DESCRIBED-KEY
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF WM-STATUS NOT = "00" MOVE 17 TO COND-WORD.

       69-WRITE-WO-MESSAGE.
           MOVE 0 TO COND-WORD.
           WRITE WMREC FROM MESSAGE-DATA
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF WM-STATUS NOT = "00" MOVE 17 TO COND-WORD.

       69-DELETE-WO-OPEN-QUEUE.
           MOVE 0 TO COND-WORD.
           DELETE WO-OPEN-QUEUE RECORD
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF WOQ-STATUS NOT = "00" MOVE 17 TO COND-WORD.

       69-READ-WO-OPEN-QUEUE.
           MOVE 0 TO COND-WORD.
           READ WO-OPEN-QUEUE NEXT INTO OPEN-QUEUE-DATA
               AT END    MOVE 15 TO COND-WORD.
           IF CC01 NOT = PERCCNUM OF WOQREC MOVE 15 TO COND-WORD.
           IF WOQ-STATUS NOT = "00" MOVE 15 TO COND-WORD.

       69-START-WO-OPEN-QUEUE.
           MOVE 0 TO COND-WORD.
           MOVE CC01 TO PERCCNUM OF WOQREC.
           START WO-OPEN-QUEUE KEY IS = EXTERNALLY-DESCRIBED-KEY
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF WOQ-STATUS NOT = "00" MOVE 17 TO COND-WORD.

       69-WRITE-WO-OPEN-QUEUE.
           MOVE 0 TO COND-WORD.
           MOVE CC02 TO Q-CC-NUM.
           WRITE WOQREC FROM OPEN-QUEUE-DATA
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF WOQ-STATUS NOT = "00" MOVE 17 TO COND-WORD.

       69-DELETE-WO-PARTS.
           MOVE 0 TO COND-WORD.
           DELETE WO-PARTS RECORD
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF WP-STATUS NOT = "00" MOVE 17 TO COND-WORD.

       69-READ-WO-PARTS.
           MOVE 0 TO COND-WORD.
           READ WO-PARTS NEXT INTO WO-PARTS-DATA
               AT END    MOVE 15 TO COND-WORD.
           IF PRT-ORIGINATOR NOT = CC01 MOVE 15 TO COND-WORD.
           IF WP-STATUS NOT = "00" MOVE 15 TO COND-WORD.

       69-START-WO-PARTS.
           MOVE 0 TO COND-WORD.
           MOVE CC01 TO PRTCCNUM OF WPREC.
           START WO-PARTS KEY IS = EXTERNALLY-DESCRIBED-KEY
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF WP-STATUS NOT = "00" MOVE 17 TO COND-WORD.

        69-WRITE-WO-PARTS.
            MOVE 0 TO COND-WORD.
            WRITE WPREC FROM WO-PARTS-DATA
                INVALID KEY    MOVE 17 TO COND-WORD.
            IF WP-STATUS NOT = "00" MOVE 17 TO COND-WORD.

       98-SCREEN-READ.
           READ DISPLAY-FILE FORMAT IS VIEW-CFNAME
               INDIC IS INDICS.
           ACCEPT IOFEEDBACK FROM I-O-FEEDBACK-AREA.
           MOVE ALL B"0" TO INDICS.
           IF DSPLY-STATUS NOT = "00"
               MOVE 3 TO VIEW-LASTKEY
           ELSE
           MOVE FUNCTION-NUM TO VIEW-LASTKEY.

       98A-SCREEN-READ.
           READ DISPLAY-FILE TERMINAL IS TERMINAL-ID
               INDIC IS INDICS
                  NO DATA MOVE DSPLY-STATUS TO DSPLY-STATUS.
           MOVE ALL B"0" TO INDICS.

       99-SCREEN-WRITE.
           WRITE DSPLY-REC FORMAT IS VIEW-CFNAME
               INDIC IS INDICS.
           MOVE ALL B"0" TO INDICS.

076200 998-BLOWUP.
076300     MOVE "TEXECPLN" TO BU-PGM-NAME.
076400     CALL "TBLOWUP" USING BLOWUP-BASE BU-PGM-NAME STATUS-AREA
076500                      VIEW-COMAREA DUMMY-KSAM-STAT
076600                      BU-DISPLAY-MSG BU-DISPLAY-FLDS.

051100 999-CATREAD.
024000     MOVE SPACES TO ERROR-BUFFER.
024100     CALL "CCATREAD" USING CATREAD-PARMS.
024200     MOVE CATREAD-MSG-TEXT TO ERROR-BUFFER.
052100 999-CATREAD-EXIT.
052200     EXIT.
