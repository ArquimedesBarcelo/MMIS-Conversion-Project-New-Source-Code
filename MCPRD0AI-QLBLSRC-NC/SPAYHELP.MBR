000200 IDENTIFICATION DIVISION.
000300 PROGRAM-ID.     SPAYHELP.
000400 AUTHOR.         CA YODER.
000500 DATE-WRITTEN.   JULY 1996.
000600 DATE-COMPILED.
000700 INSTALLATION.   THE GOODYEAR TIRE AND RUBBER COMPANY - AKRON.
000800*REMARKS.
000900**************************************************************
001000*                                                            *
001100*D   Program:   S P A Y H E L P                              *
001200*                                                            *
001300*D    This program is used to load payment terms and their   *
001400*D    descriptions into MVALIDTYPE/DVALIDDATA to be used     *
001500*D    by "CGENHELP".                                         *
001600*D                                                           *
001700**************************************************************
001800
001900 ENVIRONMENT DIVISION.
002000 CONFIGURATION SECTION.
002100 SOURCE-COMPUTER.  IBM-AS400.
002200 OBJECT-COMPUTER.  IBM-AS400.

       INPUT-OUTPUT SECTION.
       FILE-CONTROL.

           SELECT DISPLAY-FILE
               ASSIGN TO WORKSTATION-ZPAYHELP-SI
               ORGANIZATION IS TRANSACTION
               ACCESS IS SEQUENTIAL
               FILE STATUS IS DISPLAY-STATUS
               CONTROL-AREA IS WS-CONTROL.

           SELECT MPLTINFO-I
               ASSIGN TO DATABASE-MCFLCS0501
               ORGANIZATION IS INDEXED
               ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
               FILE STATUS IS FILE-STATUS.

           SELECT MVALID-IO
               ASSIGN TO DATABASE-MCFLCS5101
               ORGANIZATION IS INDEXED
               ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
               FILE STATUS IS FILE-STATUS.

           SELECT DVALID-IO
               ASSIGN TO DATABASE-MCFLCS5202
               ORGANIZATION IS INDEXED
               ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                 WITH DUPLICATES
               FILE STATUS IS FILE-STATUS.

       DATA DIVISION.
       FILE SECTION.

       FD  DISPLAY-FILE
           LABEL RECORDS ARE OMITTED.
       01  DISPLAY-REC        PIC X(2000).

       FD  MPLTINFO-I
           LABEL RECORDS ARE STANDARD.
       01  MPLTINFO-I-REC.
           COPY DDS-ALL-FORMATS OF MCFLCS0501.

       FD  MVALID-IO
           LABEL RECORDS ARE STANDARD.
       01  MVALID-IO-REC.
           COPY DDS-ALL-FORMATS OF MCFLCS5101.

       FD  DVALID-IO
           LABEL RECORDS ARE STANDARD.
       01  DVALID-IO-REC.
           COPY DDS-ALL-FORMATS OF MCFLCS5202.

002500 WORKING-STORAGE SECTION.

002600 01  FILE-STATUS.
           05  FILE-STATUS-1        PIC X VALUE SPACE.
           05  FILE-STATUS-2        PIC X VALUE SPACE.

002700*-----------------------------------------------------------*
002900*               D A T A    B A S E    A R E A               *
      *-----------------------------------------------------------*
003200
003300 COPY DVLDDATA IN COPYLIB.
003400
003500 COPY MVLDTYPE IN COPYLIB.
003600
003700 COPY MPLTINFO IN COPYLIB.
003800
004400 01  HOLD-MVALIDTYPE.
004500     05  FILLER                    PIC X(6)   VALUE "PAYCOD".
004600     05  FILLER                    PIC X(13)  VALUE
004700                                              "PAYMENT TERMS".
004800     05  FILLER                    PIC X(37)  VALUE SPACES.
004900     05  FILLER                    PIC X(6)   VALUE "09112".
005000
005900 01  SEARCH-ARGUMENTS.
006000     05  TYPE-ARG                  PIC X(6)  VALUE "PAYCOD".
006100     05  TERM-ARG.
006200         10  FILLER                PIC X(6)  VALUE "PAYCOD".
006300         10  TERM-ARG-ITEM         PIC X(6)  VALUE SPACES.
006400     05  PLT-ARG                   PIC X(4)  VALUE SPACES.
006500
006600 01  VALIDATE-TERMS-PCT.
006700     05     FILLER                 PIC X(3)  VALUE "TMP".
006800     05  VALID-TERMS-PCT           PIC X.
006900
007000 01  VALIDATE-TERMS-DD.
007100     05     FILLER                 PIC X(3)  VALUE "TMD".
007200     05  VALID-TERMS-DUE-DATE      PIC X.
007300
007800 01  HOLD-TERM.
007900     05  HOLD-PCT                  PIC X.
008000     05  HOLD-DD                   PIC X.
008100
008200 01  MESSAGE-BUFLEN                PIC S9(4) COMP VALUE 76.
008300 01  MESSAGE-ACTLEN                PIC S9(4) COMP VALUE 76.
008400 01  FIELD-NUMBER                  PIC S9(4) COMP VALUE 1.
008500
008600 01  MESSAGE-BUFFER.
008700     05  MSG-TEXT                  PIC X(64)  VALUE SPACES.
008800     05  MSG-FLD                   PIC X(12)  VALUE SPACES.
008900
009000 01  SUB                           PIC 9(2)   VALUE 0.
009100 01  NUM-CODES                     PIC 9(2)   VALUE 0.
010300
010400 COPY DATAB IN COPYLIB.
010500
010600*************************************************************
010700*                                                           *
010800*                  TERMINAL I/O DATA AREA                   *
010900*                                                           *
011000*************************************************************
011100
011200 01  PAY-SCREEN.
011300     05  ADD-PAY-INFO   OCCURS 4 TIMES.
011400         10  PAY-CODE              PIC X(2).
011500         10  PAY-DESC-ADD.
011600             15  PAY-DESC-PCT      PIC X(5).
011700             15  PAY-DESC-DD       PIC X(18).
011800     05  DELETE-PAY-INFO.
011900         10  PAY-CODEA             PIC X(2).
012000         10  PAY-DESC              PIC X(23).
012100     05  PAY-MSGLINE               PIC X(76).
           05  PAY-ERRLINE               PIC X(79).

       01  WS-CONTROL.
           05  FUNCTION-KEY         PIC X(2).
               88  ENTER-KEY-USED            VALUE "00".
               88  F1-KEY-USED               VALUE "01".
               88  F2-KEY-USED               VALUE "02".
               88  F3-KEY-USED               VALUE "03".
               88  F4-KEY-USED               VALUE "04".
               88  F5-KEY-USED               VALUE "05".
               88  F6-KEY-USED               VALUE "06".
               88  F7-KEY-USED               VALUE "07".
               88  F8-KEY-USED               VALUE "08".
               88  F9-KEY-USED               VALUE "09".
               88  F10-KEY-USED              VALUE "10".
               88  F11-KEY-USED              VALUE "11".
               88  F12-KEY-USED              VALUE "12".
               88  ROLLUP-KEY-USED           VALUE "RU".
           05  TERMINAL-ID          PIC X(10).
           05  FORMAT-NAME          PIC X(10).

       01  DISPLAY-STATUS           PIC X(2).

       01  SRF-INDICATORS.
           05  IND                  PIC 1
                                    OCCURS 99 TIMES
                                    INDICATOR 1.
               88  IND-OFF          VALUE B"0".
               88  IND-ON           VALUE B"1".

       01  OFF-SWITCH               PIC 1  VALUE B"0".
       01  ON-SWITCH                PIC 1  VALUE B"1".

      *-----------------------------------------------------------*
      *               U T I L I T Y   A R E A                     *
      *-----------------------------------------------------------*

012300 COPY VCOMAREA OF COPYLIB.
012400
013300 COPY TBLOWUP OF COPYLIB.
013400
       COPY CATREAD OF COPYLIB.

       COPY LANGSUB OF COPYLIB.

       COPY CGENHELP OF COPYLIB.

013800*************************************************************
013900**                                                         **
014000**          P R O C E D U R E    D I V I S I O N           **
014100**                                                         **
014200*************************************************************
014400
014500 PROCEDURE DIVISION.
014600
014700 0-PAYTERM-SEC SECTION 1.
014800
014900 0-BEGIN-HERE.
015000     PERFORM 1-HSK.
015100     PERFORM 6-MAIN THRU 6-MAIN-X.
015200     PERFORM 2-EOJ.
015300     GOBACK.
015400
015500 1-HSK.
015700     MOVE "SPAYHELP" TO BU-PGM-NAME.
015800
           OPEN INPUT  MPLTINFO-I
                I-O    DVALID-IO
                       MVALID-IO
                       DISPLAY-FILE.

      *----------- Check for existence of Master Record in MVALIDTYPE.
019800     PERFORM 10-CHECK-FOR-MASTER.
019900
020000 10-CHECK-FOR-MASTER.
           MOVE TYPE-ARG TO VLDCODETYP OF MVALID-IO-REC.
           READ MVALID-IO INTO BUF-MVALIDTYPE
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
020400     IF FILE-STATUS = "00"
020500         NEXT SENTENCE
020600     ELSE
020700     IF FILE-STATUS-1 = "2"
020800         PERFORM 11-ADD-MASTER
020900     ELSE
021000     IF FILE-STATUS NOT = "00"
021100         MOVE "READ ERROR: 10-CHECK-FOR-MASTER"
021200                TO  BU-DISPLAY-MSG
021300         PERFORM 2-BLOWUP.
021400
021500 11-ADD-MASTER.
           MOVE HOLD-MVALIDTYPE    TO  BUF-MVALIDTYPE.
           WRITE MVALID-IO-REC FROM BUF-MVALIDTYPE
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
021800     IF FILE-STATUS NOT = "00"
021900         MOVE "WRITE ERROR: 11-ADD-MASTER"
022000                TO  BU-DISPLAY-MSG
022100         PERFORM 2-BLOWUP.
023500
023600 2-EOJ.
           CLOSE    MPLTINFO-I
                    DVALID-IO
                    MVALID-IO
                    DISPLAY-FILE.
025700
025800*---------- Blowup Routine
026000 2-BLOWUP.
026100     CALL "TBLOWUP" USING BASE, BU-PGM-NAME, STATUS-AREA,
026200           VIEW-COMAREA, DUMMY-KSAM-STAT, BU-DISPLAY-MSG,
026300           BU-DISPLAY-AREA.
026400
032600*---------------------------------------------------------*
032700*                  6 - M A I N                            *
      *---------------------------------------------------------*
032900
033000 6-MAIN.
           INITIALIZE DISPLAY-REC.

       6-PUT-BUFFER.
      ***  INPUT DATA ABOVE AND PRESS 'ENTER'  ***
           MOVE   9 TO LANG-SETNUM.
           MOVE  20 TO LANG-MSGNUM.
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
           MOVE MESSAGE-BUFFER TO PAY-MSGLINE.

       6-SHOW-FORM.
           MOVE PAY-SCREEN TO DISPLAY-REC.
           WRITE DISPLAY-REC FORMAT IS "PAYHELP"
               INDICATORS ARE SRF-INDICATORS.
           IF DISPLAY-STATUS NOT = "00"
               MOVE "PROBLEM ON INIT SCREEN WRITE" TO BU-DISPLAY-MSG
               PERFORM 2-BLOWUP.
           READ DISPLAY-FILE
               FORMAT IS "PAYHELP"
               INDICATORS ARE SRF-INDICATORS.
           MOVE ALL B"0" TO SRF-INDICATORS.
           IF DISPLAY-STATUS NOT = "00"
               MOVE "PROBLEM ON READ SCREEN" TO BU-DISPLAY-MSG
               PERFORM 2-BLOWUP.
           MOVE DISPLAY-REC    TO PAY-SCREEN.
037800
037900     IF F3-KEY-USED
038000         GO TO 6-MAIN-X.
038100
038200     IF  F2-KEY-USED   OR
038300         F8-KEY-USED
038900*****    INVALID FUNCTION KEY    *****
039000             MOVE   9 TO LANG-SETNUM
039100             MOVE  10 TO LANG-MSGNUM
039200             PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE MESSAGE-BUFFER TO PAY-MSGLINE
                   GO TO 6-SHOW-FORM.

           IF F4-KEY-USED
               MOVE SPACES TO CGENHELP-PARMS, BU-DISPLAY-MSG
               MOVE "PAYCOD" TO CGENHELP-TYPE
               CALL "CGENHELP" USING BU-DISPLAY-AREA,
                                 BU-DISPLAY-MSG,
                                 CGENHELP-PARMS,
                                 VIEW-COMAREA
               GO TO 6-SHOW-FORM.

041600 6-EDIT-CHECKS.
041700     MOVE 0 TO NUM-CODES.
041800     PERFORM 61-CHECK-FIELDS
041900         VARYING SUB FROM 1 BY 1 UNTIL SUB > 4.
042000     IF NUM-CODES > 0 AND
042100             PAY-CODEA NOT = SPACES
      *----------- ONLY PERFORM 1 FUNCTION AT A TIME
042200         MOVE   3 TO LANG-SETNUM
042300         MOVE  62 TO LANG-MSGNUM
042400         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
042500         MOVE MESSAGE-BUFFER TO PAY-ERRLINE
               MOVE ON-SWITCH TO IND (99), IND (01)
042700         GO TO 6-SHOW-FORM.
042800
042900*----------- CHECK FOR DUPLICATE ENTRIES ON SCREEN.
043000     IF PAY-CODE (1) NOT = SPACES
043100         IF  PAY-CODE (1) = PAY-CODE (2)  OR
043200             PAY-CODE (1) = PAY-CODE (3)  OR
043300             PAY-CODE (1) = PAY-CODE (4)
043400             MOVE   4 TO LANG-SETNUM
043500             MOVE  52 TO LANG-MSGNUM
043600             PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE MESSAGE-BUFFER TO PAY-ERRLINE
                   MOVE ON-SWITCH TO IND (99), IND (1)
043900             GO TO 6-SHOW-FORM.
044000
044100     IF  PAY-CODE (2) NOT = SPACES
044200         IF  PAY-CODE (2) = PAY-CODE (3)  OR
044300             PAY-CODE (2) = PAY-CODE (4)
044400             MOVE   4 TO LANG-SETNUM
044500             MOVE  52 TO LANG-MSGNUM
044600             PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE MESSAGE-BUFFER TO PAY-ERRLINE
                   MOVE ON-SWITCH TO IND (99), IND (2)
044900             GO TO 6-SHOW-FORM.
045000
045100     IF PAY-CODE (3) NOT = SPACES
045200         IF  PAY-CODE (3) = PAY-CODE (4)
045300             MOVE   4 TO LANG-SETNUM
045400             MOVE  52 TO LANG-MSGNUM
045500             PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE MESSAGE-BUFFER TO PAY-ERRLINE
                   MOVE ON-SWITCH TO IND (99), IND (3)
045800             GO TO 6-SHOW-FORM.
045900
046000     IF NUM-CODES = 0
046100         GO TO 6-DELETE-SECTION.
046200
046300*----------- Add Payment Terms -----------*
046400
046500     MOVE 1 TO SUB.
046600
046700 6-ADD-SECTION.
046800     IF PAY-CODE (SUB) = SPACES
046900         GO TO 6-CONTINUE.
047000
047100
047200     MOVE PAY-CODE (SUB)  TO TERM-ARG-ITEM
047300                             BU-DISPLAY-FLD (1)
047400                             HOLD-TERM.
047600
047700     MOVE HOLD-PCT               TO VALID-TERMS-PCT.
047800     MOVE VALIDATE-TERMS-PCT     TO PLT-ARG.
047900
048000*---------- Check to see if terms exist in MPLTINFO.
048100
           MOVE PLT-ARG TO PLTINFOKEY OF MPLTINFO-I-REC.
           READ MPLTINFO-I INTO BUF-MPLTINFO
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
048400     IF FILE-STATUS = "00" OR FILE-STATUS-1 = "2"
048500         NEXT SENTENCE
048600     ELSE
048700         MOVE "READ 1 MPLTINFO: 61-A-S"    TO BU-DISPLAY-MSG
048800         PERFORM 2-BLOWUP.
048900
049000     IF FILE-STATUS NOT = "00"
049100*M---- C23: CODE DOES NOT EXIST - ENTER ANOTHER CODE OR SPACES
049200         MOVE  3 TO LANG-SETNUM
049300         MOVE 23 TO LANG-MSGNUM
049400         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
049500         MOVE MESSAGE-BUFFER TO PAY-ERRLINE
               MOVE ON-SWITCH TO IND (99), IND (SUB)
049600         GO TO 6-SHOW-FORM
049700     ELSE
049800         MOVE MPLTINFO-DISC-AMNT-DESC  TO PAY-DESC-PCT (SUB).
049900
050000     MOVE HOLD-DD                TO VALID-TERMS-DUE-DATE.
050100     MOVE VALIDATE-TERMS-DD      TO PLT-ARG.
           MOVE PLT-ARG TO PLTINFOKEY OF MPLTINFO-I-REC.
           READ MPLTINFO-I INTO BUF-MPLTINFO
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS = "00" OR FILE-STATUS-1 = "2"
050500         NEXT SENTENCE
050600     ELSE
050700         MOVE "READ 2 MPLTINFO: 61-A-S"    TO BU-DISPLAY-MSG
050800         PERFORM 2-BLOWUP.
050900
051000     IF FILE-STATUS NOT = "00"
051100*M---- C23: CODE DOES NOT EXIST - ENTER ANOTHER CODE OR SPACES
               MOVE SPACES TO PAY-DESC-ADD (SUB)
051200         MOVE  3 TO LANG-SETNUM
051300         MOVE 23 TO LANG-MSGNUM
051400         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER TO PAY-ERRLINE
               MOVE ON-SWITCH TO IND (99), IND (SUB)
051600         GO TO 6-SHOW-FORM
051700     ELSE
051800         MOVE MPLTINFO-TMD-DESC  TO PAY-DESC-DD (SUB).
051900
052000*---------- See if term code already exists in DVALIDDATA.
052100
           MOVE TERM-ARG TO VLDCODEKEY OF DVALID-IO-REC.
           START DVALID-IO KEY = VLDCODEKEY OF DVALID-IO-REC
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           READ DVALID-IO INTO BUF-DVALIDDATA
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
052500     IF FILE-STATUS = "00"
052600****   PAY CODE ALREADY EXISTS --- CANNOT ADD   ****
               MOVE SPACES TO PAY-DESC-ADD (SUB)
052700         MOVE  16 TO LANG-SETNUM
052800         MOVE 174 TO LANG-MSGNUM
052900         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
053000         MOVE MESSAGE-BUFFER TO PAY-ERRLINE
               MOVE ON-SWITCH TO IND (99), IND (SUB)
053100         GO TO 6-SHOW-FORM
053200     ELSE
053300         IF FILE-STATUS-1 = "2"
053400             NEXT SENTENCE
053500         ELSE
053600             MOVE "READ DVALIDDATA ERROR: 6-E-C"
053700                  TO BU-DISPLAY-MSG
053800             PERFORM 2-BLOWUP
               END-IF
           END-IF.
053900
054000 6-CONTINUE.
054100     IF SUB = 4
054200         PERFORM 62-ADD-DVALIDDATA THRU
054300                 62-ADD-DVALIDDATA-X
054400         GO TO 6-MAIN
054500     ELSE
054600         ADD 1 TO SUB
054700         GO TO 6-ADD-SECTION.
054800
054900*----------- Delete Payment Terms -----------*
055000
055100 6-DELETE-SECTION.
055200     IF PAY-CODEA NOT = SPACES
055300         MOVE PAY-CODEA    TO TERM-ARG-ITEM  BU-DISPLAY-FLD (1)
               MOVE TERM-ARG TO VLDCODEKEY OF DVALID-IO-REC
               START DVALID-IO KEY = VLDCODEKEY OF DVALID-IO-REC
                   INVALID KEY MOVE FILE-STATUS TO FILE-STATUS
               END-START
               READ DVALID-IO INTO BUF-DVALIDDATA
                   INVALID KEY MOVE FILE-STATUS TO FILE-STATUS
               END-READ
055600         IF FILE-STATUS-1 = "2"
055700****   PAY CODE DOES NOT EXIST --- CANNOT DELETE   ****
055800             MOVE  16 TO LANG-SETNUM
055900             MOVE 173 TO LANG-MSGNUM
056000             PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE MESSAGE-BUFFER TO PAY-ERRLINE
                   MOVE ON-SWITCH TO IND (99), IND (5)
056300             GO TO 6-SHOW-FORM
056400         ELSE
056500         IF FILE-STATUS = "00"
057500             PERFORM 63-DELETE-DVALIDDATA
057600                            THRU 63-DELETE-DVALIDDATA-X
057700         ELSE
057800             MOVE "READ DVALIDDATA: 6-EDIT-CHECK"
057900                 TO BU-DISPLAY-MSG
058000             PERFORM 2-BLOWUP.
058100
058200     GO TO 6-MAIN.
058300
058400 6-MAIN-X.
058500     EXIT.
058600
058700*------------------ ADD ROUTINE ----------------------*
058800
058900 61-CHECK-FIELDS.
059000     IF PAY-CODE (SUB) NOT = SPACES
059100         ADD 1 TO NUM-CODES.
059200
059300 61-ADD-DVALIDDATA.
059400     IF PAY-CODE (SUB) = SPACES
059500         GO TO 61-ADD-DVALIDDATA-X.
061000
061100     MOVE SPACES             TO  BUF-DVALIDDATA.
061200     MOVE "PAYCOD"           TO  VALID-CODE-TYPE.
061300     MOVE PAY-CODE (SUB)     TO  TERM-ARG-ITEM.
061400     MOVE TERM-ARG           TO  VALID-CODE-KEY.
061500     MOVE PAY-DESC-ADD (SUB) TO  VALID-CODE-DESC.
061600     WRITE DVALID-IO-REC FROM BUF-DVALIDDATA
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
061800     IF FILE-STATUS NOT = "00"
061900         MOVE "WRITE DVALIDDATA ERROR IN 61-ADD-DVALIDDATA"
062000              TO BU-DISPLAY-MSG
062100         MOVE TERM-ARG     TO BU-DISPLAY-FLD (1)
062200         PERFORM 2-BLOWUP.
062300
063800 61-ADD-DVALIDDATA-X.
063900     EXIT.
064000
064100*------------------- ADD ROUTINE ---------------------*
064200
064300 62-ADD-DVALIDDATA.
065000
066100 62-PUT-BUFFER.
066200***  PRESS 'F2' TO ADD OR 'F8' TO CANCEL ADD ***
066300     MOVE  16 TO LANG-SETNUM.
066400     MOVE 175 TO LANG-MSGNUM.
066500     PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
066600     MOVE MESSAGE-BUFFER TO PAY-MSGLINE.
      *---------- PROTECT TERMS FIELDS SO VALUES CANNOT BE CHANGED.
           MOVE ON-SWITCH TO IND (20).
066700
067600 62-SHOW-FORM.
           MOVE PAY-SCREEN  TO DISPLAY-REC.
           WRITE DISPLAY-REC FORMAT IS "PAYHELP"
               INDICATORS ARE SRF-INDICATORS.
           IF DISPLAY-STATUS NOT = "00"
               MOVE "PROBLEM ON INIT SCREEN WRITE" TO BU-DISPLAY-MSG
               PERFORM 2-BLOWUP.
           READ DISPLAY-FILE
               FORMAT IS "PAYHELP"
               INDICATORS ARE SRF-INDICATORS.
           MOVE ALL B"0" TO SRF-INDICATORS.
           IF DISPLAY-STATUS NOT = "00"
               MOVE "PROBLEM ON READ SCREEN" TO BU-DISPLAY-MSG
               PERFORM 2-BLOWUP.
           MOVE DISPLAY-REC TO PAY-SCREEN.

           IF ENTER-KEY-USED
               GO TO 62-SHOW-FORM.

           IF F3-KEY-USED OR F8-KEY-USED
               MOVE SPACES TO PAY-SCREEN
               GO TO 62-ADD-DVALIDDATA-X.

           IF F4-KEY-USED
      *****    INVALID FUNCTION KEY    *****
               MOVE   9 TO LANG-SETNUM
               MOVE  10 TO LANG-MSGNUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER TO PAY-ERRLINE
               MOVE ON-SWITCH TO IND (99)
               GO TO 62-SHOW-FORM.

070800 62-MAIN-ADD-DVALIDDATA.
070900     PERFORM 61-ADD-DVALIDDATA THRU 61-ADD-DVALIDDATA-X
071000         VARYING SUB FROM 1 BY 1 UNTIL SUB > 4.
071100     MOVE SPACES TO PAY-SCREEN.
071200
071300 62-ADD-DVALIDDATA-X.
071400     EXIT.
071500
071600*---------------- DELETE ROUTINE ---------------------*
071700
071800 63-DELETE-DVALIDDATA.
072500
073600 63-PUT-BUFFER.
074000     MOVE VALID-CODE-DESC   TO  PAY-DESC.
074100***  PRESS 'f2' TO DELETE OR 'f8' TO EXIT (LEAVE UNCHANGED)  ***
074200     MOVE  16 TO LANG-SETNUM.
074300     MOVE  82 TO LANG-MSGNUM.
074400     PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
074500     MOVE MESSAGE-BUFFER TO PAY-MSGLINE.
      *---------- PROTECT TERMS FIELDS SO VALUES CANNOT BE CHANGED.
           MOVE ON-SWITCH TO IND (20).
074600
075500 63-SHOW-FORM.
           MOVE PAY-SCREEN  TO DISPLAY-REC.
           WRITE DISPLAY-REC FORMAT IS "PAYHELP"
               INDICATORS ARE SRF-INDICATORS.
           IF DISPLAY-STATUS NOT = "00"
               MOVE "PROBLEM ON INIT SCREEN WRITE" TO BU-DISPLAY-MSG
               PERFORM 2-BLOWUP.
           READ DISPLAY-FILE
               FORMAT IS "PAYHELP"
               INDICATORS ARE SRF-INDICATORS.
           MOVE ALL B"0" TO SRF-INDICATORS.
           IF DISPLAY-STATUS NOT = "00"
               MOVE "PROBLEM ON READ SCREEN" TO BU-DISPLAY-MSG
               PERFORM 2-BLOWUP.
           MOVE DISPLAY-REC TO PAY-SCREEN.

           IF F3-KEY-USED OR F8-KEY-USED
               MOVE SPACES TO PAY-SCREEN
               GO TO 63-DELETE-DVALIDDATA-X.

078700 63-MAIN-DELETE-DVALIDDATA.
080100     DELETE DVALID-IO
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE "DELETE DVALIDDATA * 63-D" TO BU-DISPLAY-MSG
               PERFORM 2-BLOWUP.
082300     MOVE SPACES TO PAY-SCREEN.
082400
082500 63-DELETE-DVALIDDATA-X.
082600     EXIT.
082700
082800*********************************************************
082900 999-CATREAD.
083000     MOVE SPACES TO MESSAGE-BUFFER.
           IF CATREAD-MSG-NUMBER = ZEROS
               MOVE LANG-SETNUM TO CATREAD-MSG-SET
               MOVE LANG-MSGNUM TO CATREAD-MSG-NUM.
