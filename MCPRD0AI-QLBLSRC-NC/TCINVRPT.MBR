000200 IDENTIFICATION DIVISION.
000300 PROGRAM-ID.           TCINVRPT.
000800*REMARKS.              THIS PROGRAM WILL READ THROUGH THE
000900*                      MATERIAL ACCUM DATA SET AND COMPUTE
      *                      TOTAL INVENTORY DOLLARS BY CLASS.
002200 ENVIRONMENT DIVISION.
002300 CONFIGURATION SECTION.
002400 SOURCE-COMPUTER.      HP-3000.
002500 OBJECT-COMPUTER.      HP-3000.
       COPY SPECIALN IN COPYLIB.
002700
002800 INPUT-OUTPUT SECTION.
002900 FILE-CONTROL.
           SELECT DTRANS
               ASSIGN TO DATABASE-MCFLCA07SU
               ORGANIZATION IS INDEXED
               ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
               FILE STATUS IS FILE-STATUS.

           SELECT MACCOUNT-INFO
                  ASSIGN TO DATABASE-MCFLCA0101
                  ORGANIZATION IS INDEXED
                  ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                  FILE STATUS IS FILE-STATUS.

           SELECT MMATL-ACCUM
               ASSIGN TO DATABASE-MCFLCA06SU
               ORGANIZATION IS INDEXED
               ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
               FILE STATUS IS FILE-STATUS.

           SELECT ONLINE-PRT ASSIGN TO PRINTER-MCPRT.

           SELECT SORT-FILE ASSIGN TO DISK-SORT.

003600 DATA DIVISION.
003800 FILE SECTION.
       FD  DTRANS
           LABEL RECORDS ARE STANDARD.
       01  DTRANS-REC.
           COPY DDS-MCRPCA0700  OF MCFLCA07SU.

       FD  MACCOUNT-INFO
           LABEL RECORDS ARE STANDARD
           DATA RECORD IS MACCOUNT-INFO-REC.
       01  MACCOUNT-INFO-REC.
           COPY DDS-MCRPCA0100  OF MCFLCA0101.

       FD  MMATL-ACCUM
           LABEL RECORDS ARE STANDARD.
       01  MMATL-ACCUM-REC.
           COPY DDS-MCRPCA0600  OF MCFLCA06SU.

