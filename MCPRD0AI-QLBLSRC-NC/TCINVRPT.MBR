028400*******************************************************
028500*   PARAMETERS USED IN 'TBLOWUP' ROUTINE (PRINTS      *
028600*   ERRORS AND ABORTS PROGRAM.  RUN XBLPRT.OBJECT TO  *
028700*   READ ERRORS).                                     *
028800*******************************************************
028900
029000 COPY TBLOWUP IN COPYLIB.
029100
029200******************************************
029300**   PARAMETERS FOR CALLING 'CBLOWSRT'
029400******************************************
029500
029600 COPY CBLOWSRT IN COPYLIB.
029700
       COPY THDPRTB IN COPYLIB.
       01  OPTION-REC            PIC X(80).

       PROCEDURE DIVISION.
030200 001-BEGIN SECTION.
       001-SET-DATES.
           OPEN INPUT DTRANS.
           OPEN INPUT MACCOUNT-INFO.
           OPEN INPUT MMATL-ACCUM.
           ACCEPT HD-ROUTE-DATA.
           DISPLAY "HD-ROUTE DATE = " HD-ROUTE-DATA.
           CALL "TESCSEQ" USING ESC-NAME.
           MOVE CHAR-1636PI       TO COMPRESS-PRINT.
           MOVE CHAR-10PI         TO NORMAL-PRINT.
           MOVE HD-SPOOLER-NUMBER TO OVRPRTF-TOFILE-NUM.
           MOVE "*YES"            TO OVRPRTF-SHARED.
           MOVE HD-NO-OF-COPIES   TO OVRPRTF-COPIES.
           MOVE "MCPRT"           TO OVRPRTF-FILE.
           PERFORM 996-OVERRIDE-PRINT-FILE.
           OPEN OUTPUT ONLINE-PRT.
           IF PAPER-IS-132-COLS
               NEXT SENTENCE
           ELSE
           WRITE PRINT-REC FROM COMPRESS-PRINT AFTER ADVANCING 0 LINES.
           MOVE SPACES TO DCHG-TABLE.
           MOVE "MTED"    TO INFOKEY OF MACCOUNT-INFO-REC.
           READ MACCOUNT-INFO INTO BUF-MACCT-INFO
               INVALID KEY    MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE "READ MACTINFO - MTED" TO BU-DISPLAY-MSG
               GO TO 2-EOJ.

           MOVE MACCT-PREV-MTH-END-DATE TO DATE-LO-WA-YYMMDD.
           IF DATE-LO-WA-YY > "70"
               MOVE "19"     TO DATE-LO-WA-CC
           ELSE
           MOVE "20"         TO DATE-LO-WA-CC.
           MOVE MACCT-PREV-MTH-END-TIME TO TIME-LO-WA.
           ACCEPT CUR-DATE FROM DATE.
           MOVE C-D-Y        TO GREG-YY.
           MOVE C-D-M        TO GREG-MM.
           MOVE C-D-D        TO GREG-DD.
           IF C-D-Y > 70
               MOVE 19       TO GREG-CC
           ELSE
           MOVE 20           TO GREG-CC.
           MOVE SPACES TO JULIAN-DATE.
           CALL "JULGREG" USING GREG-DATE, JULIAN-DATE,
                            DAY-DIGIT, LEAP-YEAR-FLAG.
           DISPLAY "DAY DIGIT = " DAY-DIGIT.
           IF DAY-DIGIT = 7
               NEXT SENTENCE
           ELSE
           IF JULIAN-DDD > DAY-DIGIT
               SUBTRACT DAY-DIGIT FROM JULIAN-DDD
           ELSE
           IF LEAP-YEAR-FLAG = "Y"
               ADD 366 TO JULIAN-DDD
               SUBTRACT DAY-DIGIT FROM JULIAN-DDD
               SUBTRACT 1 FROM JULIAN-YEAR
           ELSE
           ADD 365 TO JULIAN-DDD
           SUBTRACT DAY-DIGIT FROM JULIAN-DDD
           SUBTRACT 1 FROM JULIAN-YEAR.

           MOVE SPACES TO GREG-DATE.
           CALL "JULGREG" USING GREG-DATE, JULIAN-DATE,
                            DAY-DIGIT, LEAP-YEAR-FLAG.
           MOVE GREG-DATE               TO DATE-HI-WA.
      *    MOVE MACCT-MONTH-END-DATE    TO DATE-HI-WA-YYMMDD.
      *    IF DATE-HI-WA-YY > "70"
      *        MOVE "19" TO DATE-HI-WA-CC
      *    ELSE
      *    MOVE "20"     TO DATE-HI-WA-CC.
           MOVE MACCT-MONTH-END-TIME    TO TIME-HI-WA.

           DISPLAY "COMPARE DATE AREA = " COMPARE-DATE-TIME-WA.

           PERFORM 001-TABLE-INIT
               VARYING SUB FROM 1 BY 1 UNTIL SUB > 100.

       001-LOOP-LOAD-TABLE.
           READ DTRANS NEXT INTO BUF-DTRANS
               AT END GO TO 010-MAINLINE.
           IF TRANS-CODE = "DCHG"
               NEXT SENTENCE
           ELSE
           GO TO 001-LOOP-LOAD-TABLE.
      *    IF TRANS-DATE-TIME NOT < DATE-TIME-LO-WA
      *        AND NOT > DATE-TIME-HI-WA
      *            NEXT SENTENCE
      *    ELSE
      *    GO TO 001-LOOP-LOAD-TABLE.
           IF TRANS-BALANCE-QTY > 0
               NEXT SENTENCE
           ELSE
           GO TO 001-LOOP-LOAD-TABLE.
           PERFORM 001-SET-DCHG-TABLE
               VARYING SUB FROM 1 BY 1 UNTIL SUB > 100.
           GO TO 001-LOOP-LOAD-TABLE.

       001-TABLE-INIT.
           MOVE SPACES TO DCHG-CLASS (SUB).
           MOVE ZEROES TO DCHG-DOLLARS (SUB).

       001-SET-DCHG-TABLE.
           DIVIDE TRANS-VALUE BY TRANS-QTY
               GIVING UNIT-VALUE ROUNDED.
           MULTIPLY TRANS-BALANCE-QTY BY UNIT-VALUE
               GIVING DOLLAR-VALUE ROUNDED.
           IF TRANS-CLASS = DCHG-CLASS (SUB)
               ADD DOLLAR-VALUE  TO DCHG-DOLLARS (SUB)
               MOVE 100          TO SUB
           ELSE
           IF DCHG-CLASS (SUB) = "    "
               MOVE TRANS-CLASS  TO DCHG-CLASS (SUB)
               MOVE DOLLAR-VALUE TO DCHG-DOLLARS (SUB)
               MOVE 100          TO SUB.

       010-MAINLINE.
           PERFORM VARYING SUB FROM 1 BY 1 UNTIL SUB > 100
               DISPLAY DCHG-CLASS (SUB) " " DCHG-DOLLARS (SUB)
           END-PERFORM.

           MOVE "C" TO MCXCBLERR-SCOPE.
           CALL "MCXCBLERR" USING MCXCBLERR-SCOPE.

030500*******************************************************
030600**   CALL 'CBLOWSRT' FIRST BEFORE GOING INTO THE
030700**   SORT VERB.  THE FIRST CALL TO 'CBLOWSRT' OPENS
030800**   UP A NEW TEMPORARY FILE 'BLUPDATA' THAT IS USED
030900**   TO WRITE THE BLOWUP INFORMATION IF A BLOWUP
031000**   OCCURS
031100*******************************************************
031200
031300     CALL "CBLOWSRT" USING CBLOWSRT-PARMS,
031400                           ACCTG-BASE,
031500                           BU-PGM-NAME,
031600                           STATUS-AREA,
031700                           DUMMY-VIEW-AREA,
031800                           FILE-STATUS,
031900                           BU-DISPLAY-MSG,
032000                           BU-DISPLAY-FLDS.
032100
032600     SORT SORT-FILE ON ASCENDING KEY SORT-CLASS
032700                                     SORT-MATL-CODE
032800         INPUT PROCEDURE  IS 050-PROCESS-TRANS
032900         OUTPUT PROCEDURE IS 700-CREATE-REPORT.

       2-EOJ.
           IF PAPER-IS-132-COLS
               NEXT SENTENCE
           ELSE
           MOVE SPACES TO PRINT-REC
           WRITE PRINT-REC FROM NORMAL-PRINT AFTER ADVANCING 0 LINES.
           CLOSE DTRANS.
           CLOSE MACCOUNT-INFO.
033300     CLOSE MMATL-ACCUM.
           CLOSE ONLINE-PRT.
033400     GOBACK.
033500
033700 050-PROCESS-TRANS SECTION.
       050-PROCESS-TRANS-PARA.
           PERFORM 9999-INIT-MMATL-ACCUM.
036100     PERFORM 400-GET-MMATL-ACCUM.
033900     PERFORM 200-PROCESS-DETAIL
034000         UNTIL END-OF-FILE.
034700     GO TO 699-PROCESS-EXIT.
036300
036400 200-PROCESS-DETAIL.
036500     IF MATL-STORES-CODE = "NON-STR"
036600         NEXT SENTENCE
036700     ELSE
036800     PERFORM 600-BUILD-SORT-REC.
036900     PERFORM 400-GET-MMATL-ACCUM.
037000
037100 400-GET-MMATL-ACCUM.
           PERFORM 9999-DBGET2-MMATL-ACCUM.
037900     IF GOOD-CALL
038000         NEXT SENTENCE
038100     ELSE
038200     IF END-OF-FILE
038300         NEXT SENTENCE
038400     ELSE
038500     MOVE "DBGET MMATL-ACCUM * 400-GMA" TO BU-DISPLAY-MSG
038600     PERFORM 990-BLOWUP.
038700
038800
038900 600-BUILD-SORT-REC.
039000********************************************************
039100**   CALL 'SOPNRAV' TO GET STOREROOM OPEN INVOICE
039200**   UNITS
039300********************************************************
039400     MOVE MATL-STORES-CODE        TO SOPNRAV-MATL-CODE.
039500     CALL "SOPNRAV" USING ACCTG-BASE,
039600                          SOPNRAV-PARMS,
039700                          STATUS-AREA,
039800                          BU-DISPLAY-MSG,
039900                          BU-DISPLAY-FLDS.
040000     IF BU-DISPLAY-MSG NOT = SPACES
040100         PERFORM 990-BLOWUP.
040200
040300     MOVE MATL-STORES-CODE        TO SORT-MATL-CODE,
040400                                     BU-DISPLAY-FLD (1).
040500     MOVE MATL-CLASS              TO SORT-CLASS.
040600     MOVE MATL-BEG-BAL-DOLLARS    TO SORT-BEG-DOLLARS.
040700     MOVE MATL-INV-DOLLARS        TO SORT-RCPT-DOLLARS.
040800     MOVE MATL-TOT-ISS-DOLLARS    TO SORT-ISS-DOLLARS.
040900     MOVE MATL-RTN-DOLLARS        TO SORT-RTN-DOLLARS.
041000     MOVE MATL-RTNVAL-DOLLARS     TO SORT-RTNVAL-DOLLARS.
041100     MOVE MATL-TOT-ADJ-DOLLARS    TO SORT-ADJ-DOLLARS.
041200     MOVE MATL-ACCTG-DOLLAR-CORR  TO SORT-DOLLAR-CORR.
041300     MOVE S-STR-OPEN-INV-DLRS     TO SORT-INV-ONDOCK-DOLLARS.
041400     MOVE MATL-INTRANSIT-DOLLARS  TO SORT-INTRANSIT-DOLLARS.
           MOVE S-ISS-FRAN-DLRS         TO SORT-FRAN-ISS-DOLLARS.
041500     IF MATL-STORES-CODE-1-4 = "OPNR"
041600         MOVE MATL-RCPT-DOLLARS   TO SORT-OPEN-RCVR-DOLLARS
041700         MOVE ZEROS               TO SORT-BEG-DOLLARS
041800                                     SORT-RCPT-DOLLARS
041900                                     SORT-ISS-DOLLARS
042000                                     SORT-RTN-DOLLARS
042100                                     SORT-RTNVAL-DOLLARS
042200                                     SORT-ADJ-DOLLARS
042300                                     SORT-DOLLAR-CORR
042400                                     SORT-INV-ONDOCK-DOLLARS
042500                                     SORT-INTRANSIT-DOLLARS
                                           SORT-FRAN-ISS-DOLLARS
042600     ELSE
042700     MOVE ZEROS                   TO SORT-OPEN-RCVR-DOLLARS.

043300     RELEASE SORT-REC.
043400
050600 699-PROCESS-EXIT.
050700     EXIT.
050800
050900 700-CREATE-REPORT SECTION.
       700-CREATE-REPORT-PARA.
051000     DISPLAY "BEGIN REPORT".
      *    ACCEPT CUR-DATE FROM DATE.
           MOVE GREG-YY TO H1-Y.
           MOVE GREG-MM TO H1-M.
           MOVE GREG-DD TO H1-D.
051100     PERFORM 710-BEGIN-REPORT.
051200     PERFORM 720-PROCESS-CLASS
051300        UNTIL NO-MORE-SORT = "YES".
051400     PERFORM 725-END-REPORT.
051500
051600**************************************************
051700**  BRANCH TO LAST STATEMENT OF OUTPUT SECTION  **
051800**  TO COMPLETE PROCESSING OF REPORT            **
051900**************************************************
052000
052100     GO TO 799-CREATE-EXIT.
052200
052300 710-BEGIN-REPORT.
052600     RETURN SORT-FILE
052700        AT END
052800            MOVE "YES" TO NO-MORE-SORT.
           MOVE SORT-CLASS TO PREV-CLASS
053200     PERFORM 750-PRINT-HEADINGS.
053300
053400
053500 720-PROCESS-CLASS.
053700     PERFORM 722-PROCESS-TRANS
053800         UNTIL SORT-CLASS NOT = PREV-CLASS
053900             OR NO-MORE-SORT = "YES".
054000     PERFORM 723-END-CLASS.
054100
066200 722-PROCESS-TRANS.
066300     ADD SORT-BEG-DOLLARS         TO CLASS-BEG-DOLLARS.
066400     ADD SORT-RCPT-DOLLARS        TO CLASS-RCPT-DOLLARS.
066500     IF SORT-ADJ-DOLLARS < 0
066600         ADD SORT-ADJ-DOLLARS     TO CLASS-ADJ-DOLLARS-CR
066700     ELSE
066800         ADD SORT-ADJ-DOLLARS     TO CLASS-ADJ-DOLLARS-DR.
066900     IF SORT-DOLLAR-CORR < 0
067000         ADD SORT-DOLLAR-CORR     TO CLASS-ADJ-DOLLARS-CR
067100     ELSE
067200         ADD SORT-DOLLAR-CORR     TO CLASS-ADJ-DOLLARS-DR.
067300     COMPUTE CLASS-ISS-DOLLARS  = CLASS-ISS-DOLLARS +
067400                     (SORT-ISS-DOLLARS - SORT-RTN-DOLLARS -
067500                           SORT-RTNVAL-DOLLARS).
067600     ADD SORT-INV-ONDOCK-DOLLARS  TO CLASS-INV-DLRS-ONDOCK.
067700     ADD SORT-OPEN-RCVR-DOLLARS   TO CLASS-OPEN-RCVR-DOLLARS.
067800     ADD SORT-INTRANSIT-DOLLARS   TO CLASS-INTRANSIT-DOLLARS.
           ADD SORT-FRAN-ISS-DOLLARS    TO CLASS-FRAN-ISS-DOLLARS.
067900     RETURN SORT-FILE
068000        AT END
068100             MOVE "YES" TO NO-MORE-SORT.
068200
068300 723-END-CLASS.
068400     COMPUTE ROUNDED-BEG-DOLLARS ROUNDED = CLASS-BEG-DOLLARS
068500                                            * 1.
068700     COMPUTE ROUNDED-RCPT-DOLLARS ROUNDED = CLASS-RCPT-DOLLARS
068800                                            * 1.
           PERFORM 7230-GET-DCHG-DOLLARS
               VARYING SUB FROM 1 BY 1 UNTIL SUB > 100.

           DISPLAY PREV-CLASS " " CLASS-DCHG-DOLLARS.

069000     COMPUTE ROUNDED-DCHG-DOLLARS ROUNDED = CLASS-DCHG-DOLLARS
069100                                            * 1
069400     COMPUTE ROUNDED-OPEN-RCVR-DOLLARS ROUNDED =
069500         CLASS-OPEN-RCVR-DOLLARS * 1.
069700     COMPUTE ROUNDED-INV-DLRS-ONDOCK  ROUNDED =
069800         CLASS-INV-DLRS-ONDOCK - CLASS-ONDOCK-CARRY-DOLLARS.
070000     COMPUTE CLASS-TOT-DEBITS = ROUNDED-RCPT-DOLLARS +
070100*                               ROUNDED-DCHG-DOLLARS +
070200                                ROUNDED-OPEN-RCVR-DOLLARS.
070400     COMPUTE ROUNDED-ISS-DOLLARS ROUNDED = CLASS-ISS-DOLLARS * 1.
070600     COMPUTE ROUNDED-ADJ-DOLLARS-CR ROUNDED =
070700                    CLASS-ADJ-DOLLARS-CR * -1.
070800     COMPUTE ROUNDED-ADJ-DOLLARS-DR ROUNDED =
070900                     CLASS-ADJ-DOLLARS-DR * 1.
071000     COMPUTE ROUNDED-ADJ-DOLLARS-CR = ROUNDED-ADJ-DOLLARS-CR -
071100                                      ROUNDED-ADJ-DOLLARS-DR.
071300     COMPUTE CLASS-TOT-CREDITS = ROUNDED-DCHG-DOLLARS +
071400                                 ROUNDED-ISS-DOLLARS +
071500                                 ROUNDED-ADJ-DOLLARS-CR.
071700     COMPUTE CLASS-END-DOLLARS = ROUNDED-BEG-DOLLARS +
071800                                 CLASS-TOT-DEBITS -
071900                                 CLASS-TOT-CREDITS.
072000     MOVE CLASS-END-DOLLARS       TO D-UNITS.
           IF (PREV-CLASS > "099" AND < "200") OR
               (PREV-CLASS > "399" AND < "500")
                   ADD CLASS-END-DOLLARS TO RAWMTL-UNITS.
           IF PREV-CLASS = "120"
               MOVE CLASS-END-DOLLARS    TO  UNITS-120.
072100     COMPUTE ROUNDED-INTRANSIT-DOLLARS ROUNDED =
072200         CLASS-INTRANSIT-DOLLARS * 1.
072400     COMPUTE ROUNDED-TOTAL-ONDOCK ROUNDED =
072500         CLASS-INV-DLRS-ONDOCK * 1.
           COMPUTE ROUNDED-FRAN-ISS-DOLLARS ROUNDED =
                      CLASS-FRAN-ISS-DOLLARS * 1.
072700
           MOVE PREV-CLASS TO D-CLSS.
072800     WRITE PRINT-REC FROM DETAIL-LINE-0 AFTER ADVANCING 1 LINES.
073100     ADD 1                        TO LINE-CNT.
073200     IF LINE-CNT > 61
073300         PERFORM  750-PRINT-HEADINGS.
073400
073500     ADD ROUNDED-BEG-DOLLARS      TO TOT-BEG-DOLLARS.
073600     ADD ROUNDED-RCPT-DOLLARS     TO TOT-RCPT-DOLLARS.
073700     ADD ROUNDED-DCHG-DOLLARS     TO TOT-DCHG-DOLLARS.
073800     ADD ROUNDED-OPEN-RCVR-DOLLARS TO TOT-OPEN-RCVR-DOLLARS.
073900     ADD ROUNDED-INV-DLRS-ONDOCK  TO TOT-INV-DLRS-ONDOCK.
074000     ADD CLASS-TOT-DEBITS         TO TOT-DEBITS.
074100     ADD ROUNDED-ISS-DOLLARS      TO TOT-ISS-DOLLARS.
074200     ADD ROUNDED-ADJ-DOLLARS-CR   TO TOT-ADJ-DOLLARS-CR.
074300     ADD CLASS-TOT-CREDITS        TO TOT-CREDITS.
074400     ADD CLASS-END-DOLLARS        TO TOT-END-DOLLARS.
074500     ADD CLASS-INTRANSIT-DOLLARS  TO TOT-INTRANSIT-DOLLARS.
074600     ADD ROUNDED-TOTAL-ONDOCK     TO TOT-ONDOCK.
           ADD ROUNDED-FRAN-ISS-DOLLARS TO TOT-FRAN-ISS-DOLLARS.

075600     MOVE 0                       TO CLASS-BEG-DOLLARS
075700                                     CLASS-RCPT-DOLLARS
075800                                     CLASS-DCHG-DOLLARS
075900                                     CLASS-ADJ-DOLLARS-DR
076000                                     CLASS-OPEN-RCVR-DOLLARS
076100                                     CLASS-TOT-DEBITS
076200                                     CLASS-ISS-DOLLARS
076300                                     CLASS-ADJ-DOLLARS-CR
076400                                     CLASS-INV-DLRS-ONDOCK
076500                                     CLASS-ONDOCK-CARRY-DOLLARS
076600                                     CLASS-INTRANSIT-DOLLARS
076700                                     CLASS-TOT-CREDITS
076800                                     CLASS-END-DOLLARS
                                           CLASS-FRAN-ISS-DOLLARS.
           MOVE SORT-CLASS              TO PREV-CLASS.
077000
       7230-GET-DCHG-DOLLARS.
           IF PREV-CLASS = DCHG-CLASS (SUB)
               MOVE DCHG-DOLLARS (SUB)  TO CLASS-DCHG-DOLLARS
               MOVE 100                 TO SUB.

077100 725-END-REPORT.
           MOVE "    TOTAL    "         TO D-CLSS-DTL.
           MOVE TOT-END-DOLLARS         TO D-UNITS
                                           GRAND-TOTAL.
           WRITE PRINT-REC FROM DETAIL-LINE-0 AFTER ADVANCING 2 LINES.
           ADD 2                        TO LINE-CNT.
           IF LINE-CNT > 61
               PERFORM  750-PRINT-HEADINGS.
           MOVE SPACES TO D-CLSS-DTL.
           MOVE RAWMTL-UNITS TO D-UNITS.
           ADD 3 TO LINE-CNT.
           IF LINE-CNT > 61
               WRITE PRINT-REC FROM HEADER-3 AFTER ADVANCING 1 LINES
               WRITE PRINT-REC FROM DETAIL-LINE-0
                   AFTER ADVANCING 2 LINES
           ELSE
           WRITE PRINT-REC FROM HEADER-3 AFTER ADVANCING 1 LINES
           WRITE PRINT-REC FROM DETAIL-LINE-0 AFTER ADVANCING 2 LINES.
           SUBTRACT UNITS-120 FROM RAWMTL-UNITS
               GIVING RAWMTL-UNITS-120.
           MOVE "LESS CLS 120 "  TO D-CLSS-DTL.
           MOVE RAWMTL-UNITS-120 TO D-UNITS.
           WRITE PRINT-REC FROM DETAIL-LINE-0
               AFTER ADVANCING 2 LINES.
           MOVE SPACES TO PRINT-REC.
           WRITE PRINT-REC AFTER ADVANCING 2 LINES.
           MOVE SPACES      TO D-CLSS-DTL.
           SUBTRACT RAWMTL-UNITS FROM GRAND-TOTAL.
           MOVE GRAND-TOTAL TO D-UNITS.
           ADD 3 TO LINE-CNT.
           IF LINE-CNT > 61
               MOVE SPACES TO PRINT-REC
               WRITE PRINT-REC AFTER ADVANCING NEW-PAGE
               WRITE PRINT-REC FROM HEADER-4 AFTER ADVANCING 1 LINES
               WRITE PRINT-REC FROM DETAIL-LINE-0
                   AFTER ADVANCING 2 LINES
           ELSE
           WRITE PRINT-REC FROM HEADER-4 AFTER ADVANCING 1 LINES
           WRITE PRINT-REC FROM DETAIL-LINE-0 AFTER ADVANCING 2 LINES.
079100
079200 750-PRINT-HEADINGS.
           WRITE PRINT-REC FROM HEADER-0 AFTER ADVANCING NEW-PAGE.
           WRITE PRINT-REC FROM HEADER-1 AFTER ADVANCING 1 LINES.
           WRITE PRINT-REC FROM HEADER-2 AFTER ADVANCING 1 LINES.
           MOVE SPACES TO PRINT-REC.
           WRITE PRINT-REC AFTER ADVANCING 1 LINES.
           MOVE 4 TO LINE-CNT.

082700 799-CREATE-EXIT.
082800     EXIT.
082900
083000 900-ERROR SECTION.
083100
083200 990-BLOWUP.
083300
083400***************************************************************
083500**   CALL 'CBLOWSRT' INSTEAD OF 'TBLOWUP' WHEN A BLOWUP      **
083600**   SITUATION OCCURS SINCE THIS PROGRAM USES THE 'SORT'     **
083700**   VERB.  'CBLOWSRT' WRITES ALL THE BLOWUP INFORMATION     **
083800**   TO A TEMPORARY FILE 'BLUPDATA' (WHICH WAS OPENED AT     **
083900**   THE BEGINNING OF THE PROGRAM) THE CLOSES IT. THEN IT    **
084000**   CREATESA A SON PROCESS 'XBLOWSRT' THAT READS THE        **
084100**   BLOWUP INFORMATION OUT OF 'BLUPDATA' AND CALLS          **
084200**   'TBLOWUP' USING THIS INFO.  SINCE THE NEW PROCESS       **
084300**   'XBLOWSRT' HAS ITS OWN STACK THE STACK OVERFLOW         **
084400**   PROBLEM IS AVOIDED.                                     **
084500***************************************************************
084600
084700     MOVE "TCINVRPT"              TO  BU-PGM-NAME.
084800     CALL "CBLOWSRT" USING CBLOWSRT-PARMS,
084900                           ACCTG-BASE,
085000                           BU-PGM-NAME,
085100                           STATUS-AREA,
085200                           DUMMY-VIEW-AREA,
085300                           FILE-STATUS,
085400                           BU-DISPLAY-MSG,
085500                           BU-DISPLAY-FLDS.
085900
       9999-DBGET2-MMATL-ACCUM.
           MOVE 0 TO COND-WORD.
           READ MMATL-ACCUM NEXT INTO BUF-MATLACUM
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS-1 = "1" OR FILE-STATUS = "46"
               MOVE 11 TO COND-WORD
           ELSE
               IF FILE-STATUS NOT = "00"
                   MOVE 99 TO COND-WORD.

       9999-INIT-MMATL-ACCUM.
           MOVE SPACES TO MATLCODE OF MMATL-ACCUM-REC.
           START MMATL-ACCUM KEY >= MATLCODE OF MMATL-ACCUM
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.

       COPY OVRPFCALL IN COPYLIB.

