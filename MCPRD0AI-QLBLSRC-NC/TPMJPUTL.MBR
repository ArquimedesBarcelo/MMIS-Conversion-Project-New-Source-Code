       IDENTIFICATION DIVISION.
       PROGRAM-ID.    TPMJPUTL.
       AUTHOR.        J S BUNGO.
       INSTALLATION.  GOODYEAR TIRE & RUBBER CO.

      *C   03/11/1998   CA YODER   REQ #97-1125
      *C     CHANGED PASSWORD FROM 6 TO 8 FOR CALL TO "TPERPASS."
      *C
       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.
       SOURCE-COMPUTER. HP-3000.
       OBJECT-COMPUTER. HP-3000.
       SPECIAL-NAMES.  I-O-FEEDBACK IS I-O-FEEDBACK-AREA.

       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT DISPLAY-FILE
             ASSIGN TO WORKSTATION-ZPMMAINT-SI
             ORGANIZATION IS TRANSACTION
             ACCESS IS SEQUENTIAL
             FILE STATUS DISPLAY-STATUS
             CONTROL-AREA IS WS-CONTROL.
           SELECT PM-JOBPLAN
             ASSIGN TO DATABASE-MCFLMM4101
             ORGANIZATION IS INDEXED
             ACCESS IS DYNAMIC
             RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
             WITH DUPLICATES
             FILE STATUS IS FILE-STAT.
           SELECT PM-JOBPLAN-KEYS
             ASSIGN TO DATABASE-MCFLMM4002
             ORGANIZATION IS INDEXED
             ACCESS IS DYNAMIC
             RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
             WITH DUPLICATES
             FILE STATUS IS FILE-STAT.
           SELECT JOBPLAN
             ASSIGN TO DATABASE-MCFLMM1801
             ORGANIZATION IS INDEXED
             ACCESS IS DYNAMIC
             RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
             WITH DUPLICATES
             FILE STATUS IS FILE-STAT.

       DATA DIVISION.
       FILE SECTION.
       FD  DISPLAY-FILE
           LABEL RECORDS ARE OMITTED.
       01  DISPLAY-REC         PIC X(2000).
       FD  PM-JOBPLAN
           LABEL RECORDS ARE STANDARD.
       01  PM-JOBPLAN-REC.
           COPY DDS-ALL-FORMATS OF MCFLMM4101.
       FD  PM-JOBPLAN-KEYS
           LABEL RECORDS ARE STANDARD.
       01  PM-JOBP-KEYS-REC.
           COPY DDS-ALL-FORMATS OF MCFLMM4002.
       FD  JOBPLAN
           LABEL RECORDS ARE STANDARD.
       01  JOBPLAN-REC.
           COPY DDS-ALL-FORMATS OF MCFLMM1801.

       WORKING-STORAGE SECTION.
       77  TRUE-VAL                VALUE B"1" PIC 1.
       77  RETURN-CODE             PIC XX    VALUE "0 ".
       77  LINE-CTR                PIC 9999.
       77  SEQ-NO                  PIC 9999.
       77  SEQ-NO-TEMP             PIC 999.
       77  SAVE-JOBPSEQ            PIC 999   VALUE 0.
       77  SAVE-CFT1               PIC XX.

       01  ARG-NO                  PIC 9(9).
       01  RELATIVE-REC-NO         PIC 9(9).
       01  JOBPLAN-FOUND           PIC X.

       01  PASSWORD-INFORMATION.
           05  NAME-OF-PROGRAM     PIC X(08) VALUE "TPMJPUTL".
           05  PROGRAM-TYPE        PIC X(02) VALUE "IN".
           05  PROGRAM-RELEASE     PIC X(12) VALUE " J0100010001".
           05  PROGRAM-DESCRIPTION.
               10  PROG-DESC-A     PIC X(60) VALUE
           "EXTRACTS JOBPLAN INFORMATION AND PLACES IT IN NEW FORMAT  ".
               10  PROG-DESC-B     PIC X(60) VALUE
           "                                                          ".
               10  PROG-FUNCTION   PIC X(60) VALUE
           "                                                          ".
           05  PASSWORD-FLAG       PIC X.

       01  TERMFILENAME                  PIC X(11) VALUE "TERMLIST;".
       01  FORMFILE.
           05  FORM-FNAME                PIC X(8)  VALUE "FPMMAINT".
           05  FILLER                    PIC X     VALUE ".".
           05  FORM-GNAME.
               10  FORM-GNAME1           PIC X(5)  VALUE "FLANG".
               10  FORM-GNAME2           PIC X(3)  VALUE SPACES.
           05  FILLER                    PIC X(19) VALUE SPACES.

       01  DISPLAY-STATUS                PIC X(02).
       01  FILE-STAT                     PIC X(02).

       01  SCREEN-BUFFER.
           05  WO-NUM-MASTER.
               10  MASTER-WO                    PIC X(06).
               10  MASTER-YEAR                  PIC X.
               10  MASTER-SUFFIX                PIC XXX.
           05  JP-NAME-BUF                      PIC X(10).
           05  JP-TITLE                         PIC X(50).
           05  CMDMSG                           PIC X(79).
           05  ERRMSG                           PIC X(79).

       01  JOBPLAN-KEY-BUF.
           05 JOBWONUM             PIC X(10).
           05 JOBSEQUENCE.
              10 SEQNUM            PIC X(3).
              10 FILLER            PIC X.

       01  SEQ-ADJ.
           05  SEQ-FILL        PIC X.
           05  SEQ-MOVE        PIC X(03).

       01  DB-ERROR.
           05  DB-TYPE   PIC X(08) VALUE SPACES.
           05  DB-FILE   PIC X(18) VALUE SPACES.
           05  FILLER    PIC X(21) VALUE " ERROR - COND-WORD = ".
           05  CON-WORD  PIC -9999.

       01  PREV-JOBPLAN-KEY     PIC X(10).
       01  PREV-SEQ-ADJ         PIC X(04).

       01  CNUM-BUF             PIC X(04).
       01  CNAM-BUF             PIC X(16).
       01  PWORD-BUFFER.
      *----------- EXPANDED PASSWORD FROM 6 TO 8 CHARACTERS.
      **** 05  PWORD-BUF        PIC X(06).
           05  PWORD-BUF        PIC X(08).
           05  PWD-X            PIC XX.
       01  PWORD-SWITCH         PIC X.

       01  WS-CONTROL.
           02  FUNCTION-NUM     PIC X(02).
           02  TERMINAL-ID      PIC X(10).
           02  FORMAT-NAME      PIC X(10).

       01  SRF-INDICATORS.
           05  IND OCCURS 99 TIMES PIC 1 INDICATOR 01.

       COPY IOFEEDBACK OF COPYLIB.
       01  DBPARAMETERS.       COPY DBPARMS   OF COPYLIB.
       COPY DBSTAT   OF COPYLIB.
       COPY VCOMLINK OF COPYLIB.
       01  LAST-WO-USED-DATA.  COPY MLASTWO   OF COPYLIB.
       COPY LANGSUB  OF COPYLIB.
       01  MESSAGE-BUFFER-DATA. COPY ERRORLIN OF COPYLIB.
       01  JOBPLAN-DATA.       COPY DJOBPLAN  OF COPYLIB.
       01  PM-JOBPLAN-DATA.    COPY DPMJBPLN  OF COPYLIB.
       01  PM-JOBP-KEYS-DATA.  COPY DPMJBKEY  OF COPYLIB.
       COPY CATREAD IN COPYLIB.

       PROCEDURE DIVISION.
       BEGIN.
           MOVE "0000" TO SEQ-ADJ.
           MOVE SPACES TO CNUM-BUF  CNAM-BUF SAVE-CFT1.
           MOVE LOW-VALUES     TO PREV-JOBPLAN-KEY  PREV-SEQ-ADJ.
           MOVE LOW-VALUES     TO STATUS-AREA FILE-STAT.
           MOVE "N" TO JOBPLAN-FOUND.
           MOVE SPACES TO DBPARAMETERS.
           MOVE ALL B"0" TO SRF-INDICATORS.

      *----OPEN ALL DATABASE FILES
           OPEN I-O DISPLAY-FILE.
           OPEN INPUT JOBPLAN.
           OPEN I-O PM-JOBPLAN
                    PM-JOBPLAN-KEYS.

           CALL "TPWORD" USING PASSWORD-INFORMATION.
           IF PASSWORD-FLAG = "N"
               GO TO END-OF-JOB.

           CALL "TPERPASS" USING CNUM-BUF
                                 CNAM-BUF
                                 PWORD-BUFFER
                                 PWORD-SWITCH.
           IF PWORD-SWITCH = "N"
               GO TO END-OF-JOB.

           MOVE "VJPCOPY" TO VIEW-NFNAME.

       RESET-SCREEN.
           MOVE SPACES         TO SCREEN-BUFFER.
           MOVE LYU-X          TO MASTER-YEAR.
           MOVE ALL B"0" TO SRF-INDICATORS.

       SHOWFORM.
           MOVE SCREEN-BUFFER TO DISPLAY-REC.
           WRITE DISPLAY-REC FORMAT IS VIEW-NFNAME
               INDIC ARE SRF-INDICATORS.
           MOVE ALL B"0" TO SRF-INDICATORS.

           READ DISPLAY-FILE FORMAT IS VIEW-NFNAME
               INDIC ARE SRF-INDICATORS.
           ACCEPT IOFEEDBACK FROM I-O-FEEDBACK-AREA.
           IF DISPLAY-STATUS NOT = "00"
               MOVE 3 TO VIEW-LASTKEY
           ELSE
               MOVE FUNCTION-NUM TO VIEW-LASTKEY.

           IF VIEW-LASTKEY = 3 OR 8
               GO TO END-OF-JOB.
           IF VIEW-LASTKEY NOT = 0
               GO TO SHOWFORM.
           MOVE DISPLAY-REC TO SCREEN-BUFFER.

           IF MASTER-WO = "      "
      **********************************************************************
      **    MESSAGE 035/040:
      ** INVALID WORKORDER NUMBER
      **********************************************************************
               MOVE  35        TO CATREAD-MSG-SET
               MOVE  40        TO CATREAD-MSG-NUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE TRUE-VAL TO IND (1)  IND (99)
               GO TO SHOWFORM.

           IF JP-NAME-BUF = "          "
      **********************************************************************
      **    MESSAGE 036/023:
      ** JOBPLAN NAME IS REQUIRED
      **********************************************************************
               MOVE  36        TO CATREAD-MSG-SET
               MOVE  23        TO CATREAD-MSG-NUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE TRUE-VAL TO IND (2)  IND (99)
               GO TO SHOWFORM.

           IF JP-TITLE = SPACES
      **********************************************************************
      **    MESSAGE 030/042:
      ** DESCRIPTION REQUIRED
      **********************************************************************
               MOVE  30        TO CATREAD-MSG-SET
               MOVE  42        TO CATREAD-MSG-NUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE TRUE-VAL TO IND (5)  IND (99)
               GO TO SHOWFORM.

           MOVE SPACES         TO RETURN-CODE.
           CALL "TALWONO" USING WO-NUM-MASTER RETURN-CODE.
           IF RETURN-CODE = "1 "
      **********************************************************************
      **    MESSAGE 035/040:
      ** INVALID WORKORDER NUMBER
      **********************************************************************
               MOVE  35        TO CATREAD-MSG-SET
               MOVE  40        TO CATREAD-MSG-NUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE TRUE-VAL TO IND (1)  IND (99)
               GO TO SHOWFORM.

           MOVE JP-NAME-BUF TO PMJOBPKEY OF PM-JOBPLAN-KEYS.
           START PM-JOBPLAN-KEYS KEY = PMJOBPKEY OF PM-JOBPLAN-KEYS
               INVALID KEY MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT = "00"
      **********************************************************************
      **    MESSAGE 036/016:
      ** JOBPLAN ALREADY EXISTS
      **********************************************************************
               MOVE  36        TO CATREAD-MSG-SET
               MOVE  16        TO CATREAD-MSG-NUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE TRUE-VAL TO IND (2)  IND (99)
               GO TO SHOWFORM.

           MOVE 0 TO FIELD-NUMBER.
           PERFORM COPY-JOBPLAN THRU CJ-EXIT.
           IF FIELD-NUMBER > 0 GO TO SHOWFORM.
           GO TO RESET-SCREEN.

       END-OF-JOB.
           CLOSE DISPLAY-FILE
                 JOBPLAN
                 PM-JOBPLAN
                 PM-JOBPLAN-KEYS.
           GOBACK.

       999-CATREAD.
           MOVE SPACES  TO CATREAD-MSG-TEXT.
           CALL "CCATREAD" USING CATREAD-PARMS.
           IF CATREAD-MSG-NOT-FOUND
               MOVE "*ERROR ON THIS FIELD*" TO CATREAD-MSG-TEXT.
           MOVE CATREAD-MSG-TEXT TO ERRMSG.
       999-CATREAD-EXIT.    EXIT.

       COPY-JOBPLAN.
           MOVE WO-NUM-MASTER     TO JOBWONUM.
           MOVE SPACES            TO JOBSEQUENCE.
           MOVE 0                 TO SEQ-FILL.
           PERFORM READ-JOBPLAN-CHAINS THRU RJ-EXIT VARYING SEQ-NO
               FROM 1 BY 1 UNTIL SEQ-NO > 998.
           IF JOBPLAN-FOUND = "Y"
               IF FIELD-NUMBER NOT = 1
                   MOVE 1 TO FIELD-NUMBER
      **********************************************************************
      **    MESSAGE 036/022:
      ** JOBPLAN HAS BEEN CONVERTED TO NEW FORMAT SUCCESSFULLY
      **********************************************************************
                   MOVE  36        TO CATREAD-MSG-SET
                   MOVE  22        TO CATREAD-MSG-NUM
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE TRUE-VAL TO IND (1)  IND (99)
               END-IF
           ELSE
      **********************************************************************
      **    MESSAGE 036/008:
      ** JOBPLAN DOES NOT EXIST
      **********************************************************************
               MOVE  36        TO CATREAD-MSG-SET
               MOVE  08        TO CATREAD-MSG-NUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE TRUE-VAL TO IND (1)  IND (99)
               MOVE 1 TO FIELD-NUMBER
           END-IF.
       CJ-EXIT.    EXIT.

       READ-JOBPLAN-CHAINS.
           MOVE SEQ-NO         TO SEQ-NO-TEMP.
           MOVE SEQ-NO-TEMP    TO SEQNUM.
           MOVE JOBPLAN-KEY-BUF TO JOBPWOSEQ OF JOBPLAN.
           START JOBPLAN KEY = JOBPWOSEQ OF JOBPLAN
               INVALID KEY MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
               GO TO RJ-EXIT.

           MOVE "Y" TO JOBPLAN-FOUND.
           MOVE 0 TO LINE-CTR.
           MOVE ZEROS TO COND-WORD.
           PERFORM DBGET-JPLAN THRU DJ-EXIT UNTIL COND-WORD = 15.
       RJ-EXIT.    EXIT.

       DBGET-JPLAN.
           READ JOBPLAN NEXT INTO JOBPLAN-DATA
               AT END MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT = "10" OR "14" OR "46"
               MOVE 15 TO COND-WORD
               GO TO DJ-EXIT
           ELSE
           IF FILE-STAT NOT = "00"
               MOVE "JOBPLAN" TO DB-FILE
               MOVE FILE-STAT  TO CON-WORD
               MOVE "DBGET" TO DB-TYPE
               MOVE DB-ERROR   TO ERRMSG
               MOVE  TRUE-VAL TO IND (1)  IND(99)
               MOVE 15         TO COND-WORD
               MOVE 1 TO FIELD-NUMBER
               GO TO DJ-EXIT.
           IF JOBP-WO-NO-SEQ NOT = JOBPLAN-KEY-BUF
               MOVE 15 TO COND-WORD
               GO TO DJ-EXIT.

           MOVE SPACES TO PM-JOBPLAN-DATA.

           MOVE JP-NAME-BUF TO JOBPLAN-KEY PMJP-KEY.

           IF JOBPLAN-KEY NOT = PREV-JOBPLAN-KEY
               MOVE JOBPLAN-KEY TO PREV-JOBPLAN-KEY
               PERFORM PUT-JOBP-KEYREC THRU PUT-JOBP-KEYREC-EXIT
               IF COND-WORD NOT = 0
                   MOVE 15 TO COND-WORD
                   GO TO DJ-EXIT.

           MOVE JOBPLAN-SEQ-NO-1-3 TO SEQ-MOVE.

           IF SEQ-ADJ NOT = PREV-SEQ-ADJ
               MOVE SEQ-ADJ TO PREV-SEQ-ADJ
               PERFORM PUT-TASK-HEADER THRU PUT-TASK-HEADER-EXIT
               IF COND-WORD NOT = 0
                   MOVE 15 TO COND-WORD
                   GO TO DJ-EXIT.

           MOVE SEQ-ADJ        TO PMJP-SEQN   PMJP-SEQ.
           ADD  1              TO LINE-CTR.
      *----LINE NUMBER CANNOT EXCEED 160, IGNORE ADD'L LINES
           IF LINE-CTR > 160
               MOVE 15 TO COND-WORD
               GO TO DJ-EXIT.
           MOVE LINE-CTR       TO PMJP-LINE.
           MOVE JOBPLAN-DESCRIP TO PMJP-DESC.
           MOVE JOBPLAN-DT     TO PMJP-DT.

           IF JOBPLAN-CRAFT = SPACES
               MOVE SAVE-CFT1  TO PMJP-CFT1
           ELSE
           MOVE JOBPLAN-CRAFT  TO PMJP-CFT1 SAVE-CFT1.

           MOVE JOBPLAN-MEN    TO PMJP-MNX.
           MOVE JOBPLAN-EST    TO PMJP-EST.
           MOVE JOBP-LEVEL-9   TO PMJP-LEVEL.
           MOVE JOBP-FLAG-9    TO PMJP-FLAG.
           MOVE JOBP-SS        TO PMJP-SS.

           WRITE PM-JOBPLAN-REC FROM PM-JOBPLAN-DATA
               INVALID KEY MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
               MOVE "PM-JOBPLAN" TO DB-FILE
               MOVE "DBPUT   " TO DB-TYPE
               MOVE FILE-STAT   TO CON-WORD
               MOVE DB-ERROR   TO ERRMSG
               MOVE TRUE-VAL TO IND (1)  IND(99)
               MOVE 15         TO COND-WORD
               MOVE 1 TO FIELD-NUMBER.
       DJ-EXIT.    EXIT.

       PUT-JOBP-KEYREC.
           MOVE SPACES TO PM-JOBP-KEYS-DATA.
           MOVE "KEYREC" TO RECORD-KEY.
           MOVE JP-NAME-BUF TO PMJPK-JOBP-KEY  PMJPK-JOBP-NAME.
           MOVE "0000" TO PMJPK-TASK-NUM.
           MOVE "0000" TO PMJPK-JOBP-TASK.
           MOVE CNUM-BUF TO PMJPK-ORIGINATOR.
           ACCEPT PMJPK-DATE-STAMP FROM DATE.
           MOVE "20"           TO PMJPK-DATE-STAMP-CC.
           IF PMJPK-DATE-STAMP-YY > "70"
               MOVE "19"       TO PMJPK-DATE-STAMP-CC.
           ACCEPT PMJPK-TIME-STAMP FROM TIME.
           MOVE JP-TITLE TO PMJPK-KEY-TITLE.

           WRITE PM-JOBP-KEYS-REC FROM PM-JOBP-KEYS-DATA
               INVALID KEY MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
               MOVE "PM-JOBP-KEYS" TO DB-FILE
               MOVE "DBPUT   " TO DB-TYPE
               MOVE FILE-STAT TO CON-WORD
               MOVE DB-ERROR   TO ERRMSG
               MOVE TRUE-VAL TO IND (1)  IND (99)
               MOVE 99         TO COND-WORD
               MOVE 9999       TO SEQ-NO
               MOVE 1 TO FIELD-NUMBER.
       PUT-JOBP-KEYREC-EXIT.
           EXIT.

       PUT-TASK-HEADER.
           MOVE SPACES TO PM-JOBP-KEYS-DATA.
           MOVE "TASKHD" TO RECORD-KEY.
           MOVE JP-NAME-BUF TO PMJPK-JOBP-KEY  PMJPK-JOBP-NAME.
           MOVE SEQ-ADJ TO PMJPK-TASK-NUM.
           MOVE SEQ-ADJ TO PMJPK-JOBP-TASK.
           MOVE CNUM-BUF TO PMJPK-ORIGINATOR.
           ACCEPT PMJPK-DATE-STAMP FROM DATE.
           MOVE "20"           TO PMJPK-DATE-STAMP-CC.
           IF PMJPK-DATE-STAMP-YY > "70"
               MOVE "19"       TO PMJPK-DATE-STAMP-CC.
           ACCEPT PMJPK-TIME-STAMP FROM TIME.

           WRITE PM-JOBP-KEYS-REC FROM PM-JOBP-KEYS-DATA
               INVALID KEY MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
               MOVE "PM-JOBP-KEYS" TO DB-FILE
               MOVE "DBPUT   " TO DB-TYPE
               MOVE FILE-STAT TO CON-WORD
               MOVE DB-ERROR   TO ERRMSG
               MOVE TRUE-VAL TO IND (1)  IND (99)
               MOVE 99         TO COND-WORD
               MOVE 9999       TO SEQ-NO
               MOVE 1 TO FIELD-NUMBER.
       PUT-TASK-HEADER-EXIT.
           EXIT.
      **********************************************************************
