109300         MOVE ZEROS               TO  LINE-SUB
109400         GO TO 61-PRINT-ITEM-VALUE
           ELSE
109200     IF SAVE-CONT-DSET EQUAL "S"
109300         MOVE ZEROS               TO  LINE-SUB
109400         GO TO 61-PRINT-STD-INSTS
109500     ELSE
109600     IF SAVE-CONT-DSET EQUAL "A"
109700         MOVE ZEROS               TO  LINE-SUB
109800         GO TO  61-WRITE-ACCTG-DATA-LINE
109900     ELSE
110000         MOVE "CONTINUE LOGIC FAIL*61-DCD"  TO  BU-DISPLAY-MSG
110100         GO TO 2-BLOWUP.
110200
110300 61-GET-DPOITEM-CALC.
           MOVE PO-ARG TO PORCVNO OF DPOITEMH-REC-I.
           MOVE ITEM-ADDRESS (PAGE-SUB)  TO  ITMNO OF DPOITEMH-REC-I.
           READ DPOITEMH-I INTO BUF-DPOITEM-H
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
                   MOVE 3 TO VIEW-LASTKEY
                   GO TO 61-PROCESS-ITEMS-X
               ELSE
                   MOVE "GET4 DPOITEM*61-GDC"  TO  BU-DISPLAY-MSG
                   GO TO 2-BLOWUP
           ELSE
               GO TO 61-GATHER-ITEM-DATA.
112500
112600 61-GET-DPODESC-CALC.
           MOVE PO-ARG TO PORCVNO OF DPODESCH-REC-I.
           MOVE SAVE-ITEM-SEQ TO POITEMSEQ OF DPODESCH-REC-I.
           READ DPODESCH-I INTO BUF-DPODESC-H
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
                   MOVE 3 TO VIEW-LASTKEY
                   GO TO 61-PROCESS-ITEMS-X
               ELSE
                   MOVE "GET4 DPODESC*61-GDC"    TO  BU-DISPLAY-MSG
                   GO TO 2-BLOWUP.
114200
114300     MOVE ZERO  TO  LINE-SUB.
114400
114500     IF DPODESCH-ITEM-NO EQUAL ITMH-NUMBER
114600         ADD 1  TO  LINE-SUB
114700         MOVE PODESCH-DESC  TO  DE1-ITEM-LINE (LINE-SUB).
114800
114900     GO TO  61-GET-DPODESC-LOOP.
115000
115100 61-PROCESS-ITEMS-X.
115200     EXIT.

       611-LOAD-STD-INSTS.
           MOVE STD-INST-ENTRIES (INST-SUB) TO STD-INST-OUT (INST-SUB).
       611-LSI-X.
           EXIT.
115300
119200
119300 73-PGM-ERROR.
           MOVE B"1"   TO IND (FIELD-NUMBER) IND (99).
           MOVE MESSAGE-BUFFER TO DE1-MESSAGE-LINE.
120500 73-PGM-ERROR-X.
120600     EXIT.
120700
       COPY DISPCALL IN COPYLIB.
123300
123400 999-CATREAD.
           IF CATREAD-MSG-NUMBER = ZEROS
               MOVE LANG-SETNUM TO CATREAD-MSG-SET
               MOVE LANG-MSGNUM TO CATREAD-MSG-NUM.
           CALL "CCATREAD" USING CATREAD-PARMS.
           MOVE CATREAD-MSG-TEXT TO MESSAGE-BUFFER.
125000 999-CATREAD-EXIT.
125100     EXIT.
