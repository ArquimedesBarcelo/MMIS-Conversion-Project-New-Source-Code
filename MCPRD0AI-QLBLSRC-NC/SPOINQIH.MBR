087600     IF PRICE-ALLOWED  AND ITMH-ZBILL-VALUE > ZEROS
087700         ADD 1                    TO  LINE-SUB
087800         IF LINE-SUB > 9
087900             MOVE "Z"             TO  SAVE-CONT-DSET
088000             GO TO 61-WRITE-MSG-LINE
088100         ELSE
088200             MOVE ITMH-ZBILL-VALUE TO  DE1-ITEM-UNIT-VALUE
088300             MOVE UNIT-VALUE-AREA TO  DE1-ITEM-LINE (LINE-SUB).

       61-PRINT-STD-INSTS.
           IF ITMH-STD-INST = SPACES
               NEXT SENTENCE
           ELSE
               ADD 1 TO LINE-SUB
               IF LINE-SUB > 9
                   MOVE "S" TO SAVE-CONT-DSET
                   GO TO 61-WRITE-MSG-LINE
               ELSE
                   MOVE ITMH-STD-INST TO STD-INST-TABLE
                   PERFORM 611-LOAD-STD-INSTS THRU 611-LSI-X
                     VARYING INST-SUB FROM 1 BY 1
                       UNTIL INST-SUB > 4
                   MOVE STD-INST-DATA TO DE1-ITEM-LINE (LINE-SUB).
088400
088500 61-WRITE-ACCTG-DATA-LINE.
088600     ADD 1  TO  LINE-SUB.
088700
088800     IF LINE-SUB GREATER THAN 9
088900         MOVE "A"     TO  SAVE-CONT-DSET
089000         GO TO  61-WRITE-MSG-LINE.
089100
089200****************************************************
089300*    MOVE REQ NUMBER TO ACCTG LINE                 *
089400****************************************************
089500     IF ITMH-REQ-NUMBER = SPACES
089600         MOVE "************"       TO  AR-REQ-NO  AR-REQ-NO-2
089700     ELSE
089800         MOVE ITMH-REQ-NUMBER      TO  AR-REQ-NO  AR-REQ-NO-2.
089900
           IF SAVE-PCPO-SW = "Y"
               MOVE ACCTING-REQ-DATA-2 TO DE1-ITEM-LINE (LINE-SUB)
           ELSE
090000         MOVE ACCTING-REQ-DATA TO DE1-ITEM-LINE (LINE-SUB).
090100
090200 61-WRITE-MSG-LINE.
           IF CONTINUED-SCREEN = "Y"
               GO TO 61-WRITE-MSG-LINE-CONT.
           MOVE "N" TO ANOTHER-ITEM-SW.
           READ DPOITEMH-I NEXT
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   MOVE SPACES TO PORCVNO OF DPOITEMH-REC-I
               ELSE
                   MOVE "READ DPOITEMH *61-WML" TO BU-DISPLAY-MSG
                   GO TO 2-BLOWUP.
           IF PORCVNO OF DPOITEMH-REC-I NOT = PO-ARG
               NEXT SENTENCE
           ELSE
               MOVE "Y" TO ANOTHER-ITEM-SW
               ADD 1 TO PAGE-SUB
               MOVE ITMNO OF DPOITEMH-REC-I TO ITEM-ADDRESS (PAGE-SUB)
               SUBTRACT 1 FROM PAGE-SUB.

       61-WRITE-MSG-LINE-CONT.
090300     IF LINE-SUB GREATER THAN 9
090400         IF PAGE-SUB GREATER THAN 1
090500             IF ANOTHER-ITEM-SW = "Y"
090600                 IF CONTINUED-SCREEN EQUAL "Y"
090700                     MOVE BCSF-REVIEW-MSG  TO  DE1-MSG-LINE
090800                 ELSE
090900                     MOVE BCF-REVIEW-MSG  TO  DE1-MSG-LINE
091000             ELSE
091100                 MOVE BC-REVIEW-MSG  TO  DE1-MSG-LINE
091200         ELSE
091300             IF ANOTHER-ITEM-SW = "Y"
091400                 IF CONTINUED-SCREEN EQUAL "Y"
091500                     MOVE CSF-REVIEW-MSG  TO  DE1-MSG-LINE
091600                 ELSE
091700                     MOVE CF-REVIEW-MSG  TO  DE1-MSG-LINE
091800             ELSE
091900                 MOVE C-REVIEW-MSG  TO  DE1-MSG-LINE
092000     ELSE
092100         IF PAGE-SUB GREATER THAN 1
092200             IF ANOTHER-ITEM-SW = "Y"
092300                 IF CONTINUED-SCREEN EQUAL "Y"
092400                     MOVE BSF-REVIEW-MSG  TO  DE1-MSG-LINE
092500                 ELSE
092600                     MOVE BF-REVIEW-MSG  TO  DE1-MSG-LINE
092700             ELSE
092800                 IF CONTINUED-SCREEN EQUAL "Y"
092900                     MOVE BS-REVIEW-MSG  TO  DE1-MSG-LINE
093000                 ELSE
093100                     MOVE B-REVIEW-MSG  TO  DE1-MSG-LINE
093200         ELSE
093300             IF ANOTHER-ITEM-SW = "Y"
093400                 IF CONTINUED-SCREEN EQUAL "Y"
093500                     MOVE SF-REVIEW-MSG  TO  DE1-MSG-LINE
093600                 ELSE
093700                     MOVE F-REVIEW-MSG  TO  DE1-MSG-LINE
093800             ELSE
093900                 IF CONTINUED-SCREEN EQUAL "Y"
094000                     MOVE S-REVIEW-MSG  TO  DE1-MSG-LINE
094100                 ELSE
094200                     MOVE SPACE  TO  DE1-MSG-LINE.
094300
096200
096300 61-PROCESS-FORM1.
      *-----DETERMINE TO DISPLAY "F4 FOR QS9000 TRACKING"
           IF ITMH-QS9000-TRACK = "X"
              MOVE B"1" TO IND(1).
           MOVE DE-BUFFER1     TO DISPLAY-REC.
           PERFORM 998-WRITE-SCREEN THRU 998-READ-SCREEN.
           MOVE DISPLAY-REC    TO DE-BUFFER1.
097000
097100     IF VIEW-LASTKEY EQUAL 3
097200         GO TO  61-PROCESS-ITEMS-X.
097300
097400     IF VIEW-LASTKEY EQUAL 1
097500         GO TO  61-PROCESS-ITEMS-X.
097600
097700     IF VIEW-LASTKEY EQUAL 2
097800         IF CONTINUED-SCREEN EQUAL "Y"
097900             GO TO  61-GET-DPOITEM-CALC
098000         ELSE
098100*            ***  INVALID FUNCTION KEY ENTERED  ***
098200             MOVE   9 TO LANG-SETNUM
098300             MOVE  10 TO LANG-MSGNUM
098400             PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
098500             MOVE 99  TO  FIELD-NUMBER
098600             PERFORM  73-PGM-ERROR THRU 73-PGM-ERROR-X
098700             GO TO  61-PROCESS-FORM1.
100100
100200     IF VIEW-LASTKEY EQUAL 4
100300         IF LINE-SUB GREATER THAN 9
100400             GO TO  61-DETERMINE-CONT-DATASET
100500         ELSE
100600*            ***  INVALID FUNCTION KEY ENTERED  ***
100700             MOVE   9 TO LANG-SETNUM
100800             MOVE  10 TO LANG-MSGNUM
100900             PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
101000             MOVE 99 TO FIELD-NUMBER
101100             PERFORM  73-PGM-ERROR  THRU 73-PGM-ERROR-X
101200             GO TO  61-PROCESS-FORM1.
101300
           IF VIEW-LASTKEY EQUAL 5
               IF ITMH-QS9000-TRACK = "X"
                   MOVE "H" TO TRAK-FUNCTION
                   CALL "SRCVTRAK" USING ITMH-PO-RCV-NO
                                         ITMH-NUMBER
                                         VEN-ARG
                                         ITMH-CORP-CODE
                                         TRAK-FUNCTION
                                         ITMH-QTY-ORD
                   GO TO  61-PROCESS-FORM1
               ELSE
      *            ***  INVALID FUNCTION KEY ENTERED  ***
                   MOVE   9 TO LANG-SETNUM
                   MOVE  10 TO LANG-MSGNUM
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE 99 TO FIELD-NUMBER
                   PERFORM  73-PGM-ERROR   THRU  73-PGM-ERROR-X
                   GO TO  61-PROCESS-FORM1.

102600     IF VIEW-LASTKEY EQUAL 6
102700         IF PAGE-SUB GREATER THAN 1
103400             SUBTRACT 1  FROM  PAGE-SUB
103500             GO TO  61-GET-DPOITEM-CALC
103600         ELSE
103700*            ***  INVALID FUNCTION KEY ENTERED  ***
103800             MOVE   9 TO LANG-SETNUM
103900             MOVE  10 TO LANG-MSGNUM
104000             PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
104100             MOVE 99  TO  FIELD-NUMBER
104200             PERFORM  73-PGM-ERROR THRU 73-PGM-ERROR-X
104300             GO TO  61-PROCESS-FORM1.
104400
104500     IF VIEW-LASTKEY EQUAL 7
104600         IF ANOTHER-ITEM-SW = "Y"
104700             ADD 1 TO PAGE-SUB
105000             GO TO  61-GET-DPOITEM-CALC
105300         ELSE
105400*            ***  INVALID FUNCTION KEY ENTERED  ***
105500             MOVE   9 TO LANG-SETNUM
105600             MOVE  10 TO LANG-MSGNUM
105700             PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
105800             MOVE 99  TO  FIELD-NUMBER
105900             PERFORM  73-PGM-ERROR THRU 73-PGM-ERROR-X
106000             GO TO  61-PROCESS-FORM1.
106100
060800     IF VIEW-LASTKEY EQUAL 5  OR
061000        VIEW-LASTKEY EQUAL 8
061100*        ***  INVALID FUNCTION KEY ENTERED  ***
061200         MOVE   9 TO LANG-SETNUM
061300         MOVE  10 TO LANG-MSGNUM
061400         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
061500         MOVE 99  TO  FIELD-NUMBER
061600         PERFORM  73-PGM-ERROR   THRU  73-PGM-ERROR-X
061700         GO TO  61-PROCESS-FORM1.
106200
