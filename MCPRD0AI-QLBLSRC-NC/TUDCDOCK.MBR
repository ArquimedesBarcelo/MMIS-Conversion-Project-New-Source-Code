021500 PROCEDURE DIVISION.
021600 00-CONTROL SECTION 00.
021700 00-RCVEXEC-MAIN.
021800     PERFORM 100-OPEN-ALL THRU 109-EXIT.
021900
022000     PERFORM 130-INITIALIZATION THRU 139-EXIT.
022100
022200     PERFORM 200-DOCK-MENU-SCREEN THRU 299-EXIT.
022300
022400     PERFORM 110-CLOSE-ALL THRU 119-EXIT.
022500
022600     GOBACK.
022700*************************************************************
022800*              O P E N   A L L   F I L E S                  *
022900*************************************************************
023000 100-OPEN-ALL.
           OPEN INPUT MEMPL.
           OPEN INPUT MPLTINFO.
           OPEN I-O DISPLAY-FILE.
023100     MOVE SPACES TO MISCELLANEOUS-DATA.
           MOVE "MGR     " TO MISC-USER-NAME.
023200     MOVE 9 TO VIEW-FORMSTORESIZE.
           CALL "CLWHO" USING USERNAME TERMNUM CURRLIB JOBLIBX.
           MOVE 0 TO COND-WORD.
           MOVE "RQGB" TO PLTINFOKEY OF MPLTINFO-REC.
           READ MPLTINFO INTO BUF-MPLTINFO
               INVALID KEY MOVE 17 TO COND-WORD.
           IF MEMPL-STATUS-1 = "2"
               MOVE 17 TO COND-WORD
           ELSE
           IF MEMPL-STATUS NOT = "00"
               MOVE 99 TO COND-WORD.
020100     IF COND-WORD NOT = 0
020200         MOVE "DBGET ERR MPLTINFO" TO BU-DISPLAY-MSG
020300         PERFORM 990-BLOWUP THRU 999-EXIT.
           MOVE MPLTINFO-RQGB TO REQ-GLOBALS.
030700 109-EXIT.  EXIT.
030800***********************************************************
030900*         CLOSE ALL FILES AND INITIALIZE USER KEYS        *
031000***********************************************************
031100 110-CLOSE-ALL.
           CLOSE MPLTINFO, DISPLAY-FILE, MEMPL.
031600 119-EXIT.  EXIT.
031700
031800***********************************************************
031900**    AKRON NEEDS TO VERIFY USERS.  READ IN THE FILE     **
032000**    CONTAING VALID USERS, DEPARTMENTS, AND SPOOLERS.   **
032100***********************************************************
032200 130-INITIALIZATION.
      *----------  FIND THE USER AND SPOOLER NUMBERS
           CALL "TSPLPRT" USING SP-RET-CODE, SP-AREA.
           IF SP-RET-CODE = "NF"
              MOVE "SPOOL KEY NOT FOUND * RCVEXEC" TO BU-DISPLAY-MSG
              PERFORM 990-BLOWUP THRU 999-EXIT
           ELSE
           IF SP-RET-CODE NOT = "00"
              MOVE "TSPLPRT ERROR * RCVEXEC" TO BU-DISPLAY-MSG
              PERFORM 990-BLOWUP THRU 999-EXIT.

           MOVE SP-USERNAME        TO MISC-USER-NAME.
           MOVE SP-SPOOL-NO (1)    TO SPOOL-PRT-NO.
           MOVE SP-SPOOL-NO (2)    TO ACCTG-PRT-NO.
           MOVE SP-SPOOL-NO (3)    TO PRINT-PRT-NO.
032500
032600*------------ MOVE SPACES TO INTERNAL-ORDER-PARMS USED BY PO
032700*------------ PRINT SUB. 'TPOPRTSL'
032800     MOVE SPACES                  TO  INTERNAL-ORDER-PARMS.
032900
033000*----------  FIND THE PLANT NUMBER AND PASS IT TO SUBROUTINES
           MOVE 0 TO COND-WORD.
           MOVE MPLTINFO-ARG TO PLTINFOKEY  OF MPLTINFO-REC.
           READ MPLTINFO INTO BUF-MPLTINFO INVALID KEY
                MOVE 17 TO COND-WORD.
033300     IF COND-WORD NOT = 0
033400           MOVE "DBGET MPLTINFO - TDOCKUDC " TO BU-DISPLAY-MSG
033500           PERFORM 990-BLOWUP THRU 999-EXIT.
033600     MOVE MPLTINFO-COMPANY TO PLT-NUMBER-PASS, COMPANY-SAVE.
033700     IF TELLS-WHICH-PLANT = "11"
033800        MOVE 1 TO PLANT-TYPE
033900     ELSE
034000        MOVE 0 TO PLANT-TYPE.
034100     MOVE SPACES TO USER-AREA, DIRDEL-AREA, AUTOSTORE-AREA.
034110
034120*-------  FIND THE CAPITAL ITEM PRINTER AND RAW MATERIAL PRTR&P
034130     MOVE "POPT" TO MPLTINFO-ARG.
           MOVE 0 TO COND-WORD.
           MOVE MPLTINFO-ARG TO PLTINFOKEY OF MPLTINFO-REC.
           READ MPLTINFO   INTO BUF-MPLTINFO INVALID KEY
                MOVE 17 TO COND-WORD.
034160     IF COND-WORD NOT = 0
034170           MOVE "DBGET MPLTINFO2 - TDOCKUDC " TO BU-DISPLAY-MSG
034180           PERFORM 990-BLOWUP THRU 999-EXIT.
034190     MOVE MPLTINFO-CAP-ITEM-PRT TO MISC-CAPITAL-SPOOLER.
034200     IF MPLTINFO-CAP-ITEM-PRT = "00"
034210        MOVE "N" TO MISC-PRINT-CAP-ITEMS
034220     ELSE
034230        MOVE "Y" TO MISC-PRINT-CAP-ITEMS.
034240
034250     MOVE MPLTINFO-RAWMAT-PRT-NO TO RAW-MAT-SPOOLER.
034310
      *-------  FIND P326 SWITCH TO PASS TO SUBROUTINES
           MOVE "P326" TO MPLTINFO-ARG.
           MOVE 0 TO COND-WORD.
           MOVE MPLTINFO-ARG TO PLTINFOKEY OF MPLTINFO-REC.
           READ MPLTINFO INTO BUF-MPLTINFO INVALID KEY
                MOVE 17 TO COND-WORD.
           IF COND-WORD NOT = 0
               MOVE "N" TO MISC-P326-SW
           ELSE
               MOVE MPLTINFO-P326-SW TO MISC-P326-SW.

034320*-------  FIND OVERSHIPMENT PERCENTAGES AND RAW MATERIAL MAJOR GROUPS
034330     MOVE "OVSH" TO MPLTINFO-ARG.
           MOVE 0 TO COND-WORD.
           MOVE MPLTINFO-ARG TO PLTINFOKEY OF MPLTINFO-REC.
           READ MPLTINFO INTO BUF-MPLTINFO INVALID KEY
                MOVE 17 TO COND-WORD.
034360     IF COND-WORD NOT = 0
034370           MOVE "DBGET MPLTINFO2 - TDOCKUDC " TO BU-DISPLAY-MSG
034380           PERFORM 990-BLOWUP THRU 999-EXIT.
034390     MOVE MPLTINFO-CODED-OVSH-VALUE TO CODED-OVERSHIPMENT.
034391     MOVE MPLTINFO-NCODED-OVSH-VALUE TO NONCODED-OVERSHIPMENT.
034392     MOVE MPLTINFO-CODED-RM-OVSH-VALUE TO CODED-RAW-OVERSHIPMENT.
034393     MOVE MPLTINFO-RM-MAJOR-GROUP TO RAW-MATERIAL-GROUP.
           IF MPLTINFO-BATCH-ONLINE-LOCK = SPACES
               MOVE "N" TO LOCK-ONLINE
           ELSE
               MOVE MPLTINFO-BATCH-ONLINE-LOCK TO LOCK-ONLINE.
           IF MPLTINFO-DOCK-SPECIAL-PRINT = SPACES
               MOVE "Y" TO DOCK-SPECIAL-PRINT
           ELSE
               MOVE MPLTINFO-DOCK-SPECIAL-PRINT TO DOCK-SPECIAL-PRINT.
034400
034401*----------  FIND CLASS IF TALLY NUMBER IS REQUIRED AT RECEIPT.
034402     MOVE MPLTINFO-TALLY-CLASS TO TALLY-CLASS.
034410*----------  LOAD AUTOMATIC STORE SWITCH FOR RAW MATERIALS
034420     MOVE 1 TO P-A.
034430 132-LOAD-AUTOSTORE.
034440     MOVE MPLTINFO-MJRGRP (P-A) TO AUTOSTORE-GRP (P-A).
034450     MOVE MPLTINFO-STORE-SW (P-A) TO AUTOSTORE-SW (P-A).
034460     ADD 1 TO P-A.
034470     IF P-A < 5
034480        GO TO 132-LOAD-AUTOSTORE.
034490
034491     SET U-X TO 1.
034492     MOVE 1 TO P-A.
034500*----------  FIND THE STOREROOM DEPARTMENTS FOR DIRECT DELIVERY
034600     MOVE "DSTR" TO MPLTINFO-ARG.
           MOVE 0 TO COND-WORD.
           MOVE MPLTINFO-ARG TO PLTINFOKEY OF MPLTINFO-REC.
           READ MPLTINFO INTO BUF-MPLTINFO INVALID KEY
                MOVE 17 TO COND-WORD.
034900     IF COND-WORD NOT = 0
035000           MOVE "DBGET MPLTINFO2 - TDOCKUDC " TO BU-DISPLAY-MSG
035100           PERFORM 990-BLOWUP THRU 999-EXIT.
035200     IF AKRON
035300        OPEN INPUT USER-FILE
              IF MPLTINFO-STATUS NOT = "00"
                  GO TO 137-READ-DIRDEL-FILE
              ELSE
035400            GO TO 135-READ-USER-FILE
035500     ELSE
035600        GO TO 137-READ-DIRDEL-FILE.
035700
035800 135-READ-USER-FILE.
035900     READ USER-FILE INTO USER-DATA (U-X)
036000          AT END CLOSE USER-FILE
036100          GO TO 139-EXIT.
           IF MPLTINFO-STATUS NOT = "00"
               GO TO 139-EXIT.
036200     SET U-X UP BY 1.
036300     GO TO 135-READ-USER-FILE.
036400 137-READ-DIRDEL-FILE.
036500     MOVE MPLTINFO-DEPT-STR (P-A)  TO DIRDEL-STR-DEPT (P-A).
036600     IF P-A = 6
036700        GO TO 139-EXIT.
036800     ADD 1 TO P-A.
036900     GO TO 137-READ-DIRDEL-FILE.
037000 139-EXIT.  EXIT.
037100**********************************************************
037200**********************************************************
037300*              DOCK MENU EXECUTIVE PROGRAM               *
037400
037500*     OPEN DATABASE, TERMINAL, FILES, ETC.  DISPLAY      *
037600*     THE DOCK MENU AND ALLOW USER TO ENTER PROGRAM      *
037700*     SELECTION.   CALL EACH SUBROUTINE THAT IS          *
037800*     REQUESTED AND RETURN CONTROL BACK TO THIS MENU     *
037900*     AFTERWARDS.  WHEN USER EXITS THIS PROGRAM, SIGN    *
038000*     HIM OFF THE TERMINAL THROUGH THE UDC.              *
038100**********************************************************
038200**********************************************************
038300  200-DOCK-MENU-SCREEN.
038400     MOVE RCVMENU TO VIEW-NFNAME.
038500*    CALL "VGETNEXTFORM" USING VIEW-COMAREA.
038600*    IF VIEW-STATUS NOT = ZERO
038700*       MOVE "VGETNEXTFORM ERROR TDOCKUDC" TO BU-DISPLAY-MSG
038800*       PERFORM 990-BLOWUP THRU 999-EXIT.
038900
039000*    CALL "VINITFORM" USING VIEW-COMAREA.
039100*    IF VIEW-STATUS NOT = ZERO
039200*       MOVE "VINITFORM ERROR TDOCKUDC"    TO BU-DISPLAY-MSG
039300*       MOVE VIEW-NFNAME                   TO BU-DISPLAY-FLD (1)
039400*       PERFORM 990-BLOWUP THRU 999-EXIT.
039500*
039600*    MOVE SPACES TO MESSAGE-BUFFER.
039700*    MOVE 76     TO MESSAGE-ACTLEN.
039800*    PERFORM 920-SHOW-MSG THRU 929-EXIT.
039900
040000 205-DISPLAY-SCREEN.
           MOVE SCREEN-KEY-AREA TO SCREEN-BUFFER.
           MOVE "ZUDCDOCK" TO VIEW-CFNAME.
           MOVE SCREEN-BUFFER TO DISPLAY-REC.
           WRITE DISPLAY-REC FORMAT IS VIEW-NFNAME
              INDIC ARE SRF-INDICATORS.
           MOVE ALL B"0" TO SRF-INDICATORS.

           READ  DISPLAY-FILE FORMAT IS VIEW-NFNAME
               INDIC ARE SRF-INDICATORS.
           ACCEPT IOFEEDBACK FROM I-O-FEEDBACK-AREA.
           MOVE ALL B"0" TO SRF-INDICATORS.
           MOVE DISPLAY-REC TO SCREEN-BUFFER.
           MOVE SPACES TO DE-MESSAGE-LINE.

      *------ A BAD STATUS MAY MEAN USER TURNED OFF TERMINAL.
      *------ IF SO, SIMULATE THE F3 KEY TO EXIT PROGRAM.
           IF DISPLAY-STATUS NOT = "00"
               MOVE 3 TO VIEW-LASTKEY
           ELSE
               MOVE FUNCTION-NUM TO VIEW-LASTKEY.
035800
036200     IF VIEW-LASTKEY EQUAL 2 OR
036400        VIEW-LASTKEY EQUAL 8 OR
036500        VIEW-LASTKEY EQUAL 4 OR
036600        VIEW-LASTKEY EQUAL 7 OR
036700        VIEW-LASTKEY EQUAL 6
              MOVE 9 TO LANG-SETNUM
              MOVE 10 TO LANG-MSGNUM
036800        PERFORM 940-VSETERROR THRU 949-EXIT
036900        GO TO 205-DISPLAY-SCREEN.
           MOVE SCREEN-BUFFER TO SCREEN-KEY-AREA.
040900     IF VIEW-LASTKEY EQUAL 3
041000        GO TO 299-EXIT.
041100
041200*---------- READ DATA BUFFER
041300*    CALL "VGETBUFFER" USING  VIEW-COMAREA, SCREEN-KEY,
041400*                             VIEW-DBUFLEN.
041500*    IF VIEW-STATUS NOT = ZERO
041600*        MOVE "VGETBUFFER ERROR TDOCKUDC"  TO  BU-DISPLAY-MSG
041700*        PERFORM 990-BLOWUP THRU 999-EXIT.
041800*
041900*************************************************************
042000*      POSSIBLE SELECTIONS FROM MENU:                       *
042100*           1.  RD - CREATE A RECEIVING SLIP                *
      *               RS  - RECEIVE ASN SHIPMENT
042200*           2.  RC  - CORRECT A RECEIVING SLIP              *
042300*           3.  RC3 - CORRECT FREIGHT                       *
042400*           4.  Q3  - RECEIVING SLIP INQUIRY                *
042500*           5.  Q2  - PO INQUIRY BY PO                      *
042600*           6.  Q4  - PO-RCV SLIP INQUIRY BY CODE           *
042700*           7.  Q5  - PO INQUIRY BY VENDOR CODE             *
      *               Q6  - VENDOR CODE INQUIRY                   *
      *               Q6A - VENDOR INFORMATION INQUIRY            *
042800*           8.  RM1 - RECEIVING SLIP REPRINT                *
042900*           9.  RM2 - PO REPRINT                            *
043000*          10.  Q1  - MATERIAL STATUS BY CORP-CODE          *
043010*          11.  Q11 - TALLY INQUIRY                         *
043100*************************************************************
043200     IF SCREEN-KEY = "RD"
              IF A-KELLY-PLANT AND LOCK-ONLINE = "Y"
                  MOVE "FUNCTION LOCKED, ONLY BATCH RECEIPTS ALLOWED"
                     TO MESSAGE-BUFFER
                  MOVE 1 TO FIELD-NUMBER
                  PERFORM 940-VSETERROR THRU 949-EXIT
              ELSE
043300            CALL "SRCVEXEC" USING BASE-MMISA,
043300                              MISCELLANEOUS-DATA,
043400                              VIEW-COMAREA,
                                    DSET-ARRAY,
043600                              USER-AREA,
043700                              DIRDEL-AREA,
043710                              AUTOSTORE-AREA,
043800                              LANGUAGE-PARMS,
043900                              ESC-NAME
043910                              DOCK-OVERSHIPMENT
                                    ASN-RECEIVER
              END-IF
044000        GO TO 200-DOCK-MENU-SCREEN.

           IF SCREEN-KEY = "RS"
               CALL "TASNDOCK"
               GO TO 200-DOCK-MENU-SCREEN.
044100
044200*----------  RECEIVING SLIP CORRECTIONS
044300     IF SCREEN-KEY = "RC"
              IF A-KELLY-PLANT AND LOCK-ONLINE = "Y"
                  MOVE "FUNCTION LOCKED, ONLY BATCH RECEIPTS ALLOWED"
                     TO MESSAGE-BUFFER
                  MOVE 1 TO FIELD-NUMBER
                  PERFORM 940-VSETERROR THRU 949-EXIT
              ELSE
