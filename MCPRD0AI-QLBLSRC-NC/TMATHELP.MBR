000200 IDENTIFICATION DIVISION.
000300 PROGRAM-ID. TMATHELP.
000400 ENVIRONMENT DIVISION.
000500 CONFIGURATION SECTION.
000600 SOURCE-COMPUTER.   AS400.
000700 OBJECT-COMPUTER.   AS400.
       SPECIAL-NAMES. I-O-FEEDBACK IS I-O-FEEDBACK-AREA
                      LOCAL-DATA IS LOCAL-DATA-AREA.
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT DISPLAY-FILE
               ASSIGN TO WORKSTATION-ZMATHELP-SI
               ORGANIZATION IS TRANSACTION
               ACCESS IS SEQUENTIAL
               FILE STATUS IS DSPLY-STATUS
               CONTROL-AREA IS WS-CONTROL.
000800 DATA DIVISION.
001700 FILE SECTION.
       FD  DISPLAY-FILE
           LABEL RECORDS ARE OMITTED.
       01  DSPLY-REC                    PIC X(2000).
000900 WORKING-STORAGE SECTION.
001100 01  BLOWUP-BASE                  PIC X(16) VALUE "  MMISA;".
       COPY CATREAD  OF COPYLIB.
       COPY CPYIND   OF COPYLIB.
       01  DSPLY-STATUS                 PIC XX.
       01  EDIT-ERROR                   PIC X(80).
001200 01  ERROR-BUFFER                 PIC X(80).
       COPY IOFEEDBACK IN COPYLIB.
       COPY DBSTAT OF COPYLIB.
002000 COPY TBLOWUP IN COPYLIB.
       01  TRUE-VAL                     PIC 1 VALUE B"1".
       COPY WSCONTROL IN COPYLIB.
002100 LINKAGE SECTION.
002200 01  DBPARAMETERS.        COPY DBPARMS OF COPYLIB.
       COPY VCOMLINK OF COPYLIB.
002500 PROCEDURE DIVISION USING DBPARAMETERS VIEW-COMAREA.
002700 START-PGM.
           OPEN I-O   DISPLAY-FILE.
002800     MOVE "FADDINST" TO VIEW-CFNAME.
           PERFORM 69-CALL-HELP-SCREEN.
003900     IF VIEW-LASTKEY = 3
004000         GO TO 2-EOJ
004100     ELSE
004200     IF VIEW-LASTKEY = 1
004300         PERFORM 6-READ-GENERAL-INSTRUCTIONS THRU
004400             6-RGI-EXIT
004500         MOVE 0 TO VIEW-LASTKEY
004600         GO TO START-PGM
004700     ELSE
004800     IF VIEW-LASTKEY = 2
004900         PERFORM 6-READ-CODED-INSTRUCTIONS THRU
005000             6-RCI-EXIT
005100         MOVE 0 TO VIEW-LASTKEY
005200         GO TO START-PGM
005300     ELSE
005400     IF VIEW-LASTKEY = 4
005500         PERFORM 6-READ-UNCODED-INSTRUCTIONS THRU
005600             6-RUI-EXIT
005700         MOVE 0 TO VIEW-LASTKEY
005800         GO TO START-PGM
005900     ELSE
006000     IF VIEW-LASTKEY = 5
006100         PERFORM 6-READ-NS-INSTRUCTIONS THRU
006200             6-RNSI-EXIT
006300         MOVE 0 TO VIEW-LASTKEY
006400         GO TO START-PGM
006500     ELSE
006600     IF VIEW-LASTKEY = 6
006700         PERFORM 6-READ-CHG-INSTRUCTIONS THRU 6-RCHGI-EXIT
006800         MOVE 0 TO VIEW-LASTKEY
006900         GO TO START-PGM
007000     ELSE
007100     IF VIEW-LASTKEY = 7
007200         PERFORM 6-READ-DEL-INSTRUCTIONS THRU 6-RDI-EXIT
007300         MOVE 0 TO VIEW-LASTKEY
007400         GO TO START-PGM
007500     ELSE
009200     MOVE 35126 TO CATREAD-MSG-NUMBER
009400     PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
           MOVE ERROR-BUFFER TO EDIT-ERROR
           MOVE TRUE-VAL TO INDS (99)
009900     GO TO START-PGM.
010000 2-EOJ.
           CLOSE DISPLAY-FILE.
010100     GOBACK.
010200 6-READ-GENERAL-INSTRUCTIONS.
010300     MOVE "FGENINST" TO VIEW-CFNAME.
           PERFORM 69-CALL-HELP-SCREEN.
011500     IF VIEW-LASTKEY = 3 GO TO 6-RGI-EXIT.
013100     MOVE "FGENINS2" TO VIEW-CFNAME.
           PERFORM 69-CALL-HELP-SCREEN.
014300     IF VIEW-LASTKEY = 3 GO TO 6-RGI-EXIT.
015900     MOVE "FGENINS3" TO VIEW-CFNAME.
           PERFORM 69-CALL-HELP-SCREEN.
017100     IF VIEW-LASTKEY = 3 GO TO 6-RGI-EXIT.
018700     MOVE "FGENINS4" TO VIEW-CFNAME.
           PERFORM 69-CALL-HELP-SCREEN.
019900     IF VIEW-LASTKEY = 3 GO TO 6-RGI-EXIT.
021500     MOVE "FGENINS5" TO VIEW-CFNAME.
           PERFORM 69-CALL-HELP-SCREEN.
022700     IF VIEW-LASTKEY = 3 GO TO 6-RGI-EXIT.
024300     MOVE "FGENINS6" TO VIEW-CFNAME.
025500     IF VIEW-LASTKEY = 3 GO TO 6-RGI-EXIT.
027100     MOVE "FGENINS7" TO VIEW-CFNAME.
           PERFORM 69-CALL-HELP-SCREEN.
028300     IF VIEW-LASTKEY = 3 GO TO 6-RGI-EXIT.
029900 6-RGI-EXIT.    EXIT.
030000 6-READ-CODED-INSTRUCTIONS.
030100     MOVE "FACODINS" TO VIEW-CFNAME.
           PERFORM 69-CALL-HELP-SCREEN.
031300     IF VIEW-LASTKEY = 3 GO TO 6-RCI-EXIT.
032900     MOVE "FACODIN2" TO VIEW-CFNAME.
           PERFORM 69-CALL-HELP-SCREEN.
033800     IF VIEW-LASTKEY = 3 GO TO 6-RCI-EXIT.
035700     MOVE "FACODIN3" TO VIEW-CFNAME.
           PERFORM 69-CALL-HELP-SCREEN.
036900     IF VIEW-LASTKEY = 3 GO TO 6-RCI-EXIT.
038500 6-RCI-EXIT.    EXIT.
038600 6-READ-UNCODED-INSTRUCTIONS.
038700     MOVE "FAUNCINS" TO VIEW-CFNAME.
           PERFORM 69-CALL-HELP-SCREEN.
039900     IF VIEW-LASTKEY = 3 GO TO 6-RUI-EXIT.
041500     MOVE "FAUNCIN2" TO VIEW-CFNAME.
           PERFORM 69-CALL-HELP-SCREEN.
042700     IF VIEW-LASTKEY = 3 GO TO 6-RUI-EXIT.
044300     MOVE "FAUNCIN3" TO VIEW-CFNAME.
           PERFORM 69-CALL-HELP-SCREEN.
047000 6-RUI-EXIT.    EXIT.
047100 6-READ-NS-INSTRUCTIONS.
047200     MOVE "FACNSINS" TO VIEW-CFNAME.
           PERFORM 69-CALL-HELP-SCREEN.
048400     IF VIEW-LASTKEY = 3 GO TO 6-RNSI-EXIT.
050200     MOVE "FACNSIN2" TO VIEW-CFNAME.
           PERFORM 69-CALL-HELP-SCREEN.
051400     IF VIEW-LASTKEY = 3 GO TO 6-RNSI-EXIT.
053000     MOVE "FACNSIN3" TO VIEW-CFNAME.
           PERFORM 69-CALL-HELP-SCREEN.
055700 6-RNSI-EXIT.    EXIT.
055800 6-READ-CHG-INSTRUCTIONS.
055900     MOVE "FCHGINST" TO VIEW-CFNAME.
           PERFORM 69-CALL-HELP-SCREEN.
057000     IF VIEW-LASTKEY = 3 GO TO 6-RCHGI-EXIT.
058800     MOVE "FCHGINS2" TO VIEW-CFNAME.
           PERFORM 69-CALL-HELP-SCREEN.
060000     IF VIEW-LASTKEY = 3 GO TO 6-RCHGI-EXIT.
061800     MOVE "FCHGINS3" TO VIEW-CFNAME.
           PERFORM 69-CALL-HELP-SCREEN.
064500 6-RCHGI-EXIT.    EXIT.
064600 6-READ-DEL-INSTRUCTIONS.
064700     MOVE "FDELINST" TO VIEW-CFNAME.
           PERFORM 69-CALL-HELP-SCREEN.
065800     IF VIEW-LASTKEY = 3 GO TO 6-RDI-EXIT.
067600     MOVE "FDELINS2" TO VIEW-CFNAME.
           PERFORM 69-CALL-HELP-SCREEN.
070300 6-RDI-EXIT.    EXIT.
070400
       69-CALL-HELP-SCREEN.
           MOVE SPACES TO DSPLY-REC.
           PERFORM 99-SCREEN-WRITE.
           PERFORM 98-SCREEN-READ.
           MOVE SPACES TO ERROR-BUFFER.

       98-SCREEN-READ.
           READ DISPLAY-FILE FORMAT IS VIEW-CFNAME
               INDIC IS INDICS.
           ACCEPT IOFEEDBACK FROM I-O-FEEDBACK-AREA.
           MOVE ALL B"0" TO INDICS.
           IF DSPLY-STATUS NOT = "00"
               MOVE 3 TO VIEW-LASTKEY
           ELSE
           MOVE FUNCTION-NUM TO VIEW-LASTKEY.

       99-SCREEN-WRITE.
           WRITE DSPLY-REC FORMAT IS VIEW-CFNAME
               INDIC IS INDICS.
           MOVE ALL B"0" TO INDICS.

070500 998-BLOWUP.
070600     MOVE "TMATHELP" TO BU-PGM-NAME.
070700     CALL "TBLOWUP" USING BLOWUP-BASE BU-PGM-NAME STATUS-AREA
070800                      VIEW-COMAREA DUMMY-KSAM-STAT
070900                      BU-DISPLAY-MSG BU-DISPLAY-FLDS.
071000
071100 999-CATREAD.
071200     MOVE SPACES TO ERROR-BUFFER.
           CALL "CCATREAD" USING CATREAD-PARMS.
           MOVE CATREAD-MSG-TEXT TO ERROR-BUFFER.
072700 999-CATREAD-EXIT.
072800     EXIT.
