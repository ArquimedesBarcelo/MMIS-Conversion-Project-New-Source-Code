       IDENTIFICATION DIVISION.
       PROGRAM-ID.          TUDCSTR.
       AUTHOR.              C HILLES.
       DATE-WRITTEN.        02/12/86.
       DATE-COMPILED.
      *INSTALLATION.        GOODYEAR TIRE AND RUBBER - AKRON.
      *SECURITY.
      *REMARKS.
      *C  10-20-92   BK DISMUKES   REQUEST# 5977
      *C   1. ADDED LOGIC TO CALL Q8 (REQUISITION INQUIRY)
      *C
      *C  07MAY1996  DAVE PLUM     REQUEST #6598
      *C   ADDED THE PARAMETER SRF-MPLTINFO-COMPANY TO THE SET
      *C   OF PARAMETERS PASSED TO PROGRAM SRETWVLS.  THE COMPANY
      *C   CODE IS NEEDED BY PROGRAM CISITRAW WHICH IS CALLED BY
      *C   SRETWVLS.
      *C
      *C  01MAY2001  JIM COFFAM
      *C   ADDED CODE AT NAPANEE'S REQUEST TO CURTAIL THE
      *C   GENERIC SIGNONS FROM ACCESSING ALL REQUISITIONS.
      *C
      *C  11JUN2003  CA YODER     NAPANEE REQUEST
      *C   ADDED LOGIC TO CHECK MPLTINFO SWITCH TO SEE IF ST5
      *C   OPTION SHOULD BE SHOWN ON THE SCREEN.
      *C
       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.
       SOURCE-COMPUTER.  HP-3000.
       OBJECT-COMPUTER.  HP-3000.
       COPY SPECIALN IN COPYLIB.
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT MEMPL
                  ASSIGN TO DATABASE-MCFLCS4202
                  ORGANIZATION IS INDEXED
                    ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                    WITH DUPLICATES
                  FILE STATUS IS FILE-STATUS.

           SELECT MPLTINFO-PK-I
               ASSIGN TO DATABASE-MCFLCS0501
               ORGANIZATION IS INDEXED
                 ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
               FILE STATUS IS FILE-STATUS.

           SELECT DISPLAY-FILE
               ASSIGN TO WORKSTATION-ZUDCSTR-SI
               ORGANIZATION IS TRANSACTION
               ACCESS IS SEQUENTIAL
               FILE STATUS IS DISPLAY-STATUS
               CONTROL-AREA IS WS-CONTROL.


       DATA DIVISION.
       FILE SECTION.
      *------ FD AREA FOR IBM ONLY ------*
       FD  MEMPL
           LABEL RECORDS ARE STANDARD.
       01  MEMPL-REC.
           COPY DDS-MCRPCS4200  OF MCFLCS4202.

       FD  MPLTINFO-PK-I
           LABEL RECORDS ARE STANDARD.
       01  MPLTINFO-PK-REC-I.
           COPY DDS-MCRPCS0500  OF MCFLCS0501.

       FD  DISPLAY-FILE
           LABEL RECORDS ARE OMITTED.
       01  DISPLAY-REC                   PIC X(1500).
      *------ FD AREA FOR IBM ONLY ------*

       WORKING-STORAGE SECTION.

       77  ANY-KEY                       PIC X(1).
       77  HANDLE-BLOWUP-FLAG            PIC X(1)  VALUE "Y".
       77  HOLD-ST5-SW                   PIC X(1)  VALUE "Y".

      **************************************************************
      **                                                          **
      **     S U B P R O G R A M   A R E A S                      **
      **                                                          **
      **************************************************************

       COPY STCOM      IN COPYLIB.
       COPY TBLOWUP    IN COPYLIB.
       COPY TSPLPRT    IN COPYLIB.
       COPY TSHWRDFM   IN COPYLIB.
       COPY CSWITCHF   IN COPYLIB.
       COPY ESCNAM2    IN COPYLIB.
       COPY CATREAD    IN COPYLIB.
       COPY IOFEEDBACK IN COPYLIB.
       COPY DISPDAT2   IN COPYLIB.
       COPY TISSCRWS   IN COPYLIB.

       01  DUMMY-CODE                    PIC X(8) VALUE SPACES.

       01  PASS-RPT-NUMBER               PIC S9(4) BINARY VALUE 3.

       01  SDSCINQ-PARMS.
           05 SDSCINQ-COMPANY            PIC X(3) VALUE SPACES.
           05 SDSCINQ-DDESC-LANG         PIC X(3) VALUE SPACES.
           05 SDSCINQ-DDESC2-LANG        PIC X(3) VALUE SPACES.

       COPY MULTSTR    IN COPYLIB.

       01  PASS-SPOOL                    PIC S9(2) VALUE ZERO COMP-4.
       01  REQ-PLANT.
           05  REQ-PLANT-CODE       PIC X(3)    VALUE SPACES.
           05  FILLER               PIC X       VALUE SPACES.

       COPY REQGLOBS IN COPYLIB.

       01  REQI-RET-CODE                 PIC S9(4) VALUE ZERO COMP-4.
       COPY SMREQINQ OF COPYLIB.

       01  WHO-PARMS.
           05  USERNAME                            PIC X(10).
           05  TERMNUM                             PIC X(10).
           05  CURRLIB                             PIC X(10).
           05  JOBLIBX                             PIC X.

      **************************************************************
      **                                                          **
      **                  V I E W   W O R K                       **
      **                                                          **
      **************************************************************
       COPY FUNCTDEF IN COPYLIB.

       01  FIELD-NUMBER                  PIC S9(4) COMP VALUE 1.

       COPY VCOMAREA IN COPYLIB.
       01  FORMFILE.
           05  FORM-FNAME                PIC X(8)  VALUE "FUDCSTR".
           05  FILLER                    PIC X     VALUE ".".
           05  FORM-GNAME.
               10  FORM-GNAME1           PIC X(5)  VALUE "FLANG".
               10  FORM-GNAME2           PIC X(3)  VALUE SPACES.
           05  FILLER                    PIC X(19) VALUE SPACES.

       01  TERMFILENAME                  PIC X(11) VALUE "TERM;".

       COPY HMSGBUF IN COPYLIB.
      **************************************************************
      **                                                          **
      **       D A T A   E N T R Y   B U F F E R S                **
      **                                                          **
      **************************************************************

       01  DE-FIELDS-1.
           05  V-COMPANY                 PIC X(3) VALUE SPACES.
           05  DE-PGM-KEY                PIC X(3) VALUE SPACES.
           05  DE-COMMAND-LINE-1         PIC X(79) VALUE SPACES.
           05  DE-MESSAGE-LINE-1         PIC X(79) VALUE SPACES.

      **************************************************************
      **                                                          **
      **            D A T A B A S E   W O R K                     **
      **                                                          **
      **************************************************************
       01  FILE-STATUS.
           05  FILE-STATUS-1             PIC X  VALUE "0".
           05  FILE-STATUS-2             PIC X  VALUE "0".

       01  MPLTINFO-STATUS               PIC X(2).
       01  BASE                          PIC X(24) VALUE "  STORES;".
       01  PASSWORD                      PIC X(5)  VALUE "JADE;".
       01  MMIS-BASE                     PIC X(8)  VALUE "  MMISA;".
       01  MMIS-PASSWORD                 PIC X(7)  VALUE "DO-ALL;".
       01  BUDGET-BASE                   PIC X(24) VALUE "  BUDGET:".
       01  BUDGET-PASSWORD               PIC X(7)  VALUE "DO-ALL;".
       COPY DBSTHIST OF COPYLIB.

       COPY DBSTAT IN COPYLIB.

       01  DSET-NAMES.
           05  DSET-DUMMY                PIC X(2)  VALUE SPACES.
           05  DSET-MPLTINFO             PIC X(16) VALUE "MPLTINFO;".

       01  MODE-AREA.
           05  MODE1                     PIC S9(4) BINARY VALUE 1.
           05  MODE7                     PIC S9(4) BINARY VALUE 7.

       01  ALL-ITEMS                     PIC X(2)  VALUE "@;".

       01  PLT-ARG                       PIC X(4)  VALUE SPACES.

       COPY MEMPL    IN COPYLIB.
       COPY MPLT0    IN COPYLIB.
       COPY MPLTPLAN IN COPYLIB.
       COPY MPLTST   IN COPYLIB.
       COPY MPLTP01  IN COPYLIB.
       COPY MPLTRQGB IN COPYLIB.
       COPY MPLTOPT  IN COPYLIB.

      **************************************
      *                                    *
      *    NATIVE LANGUAGE SUPPORT AREA    *
      *                                    *
      **************************************

       COPY LANGUAGE IN COPYLIB.


       PROCEDURE DIVISION.
       0000-START.

           MOVE SPACES TO ISCR-DATA.
           PERFORM 1000-HOUSEKEEP THRU 1990-H-X.
           MOVE "N"                      TO  SAVE-PRT-OPT.
           PERFORM 6000-MAIN THRU 6990-MAIN-X.
           PERFORM 2000-EOJ.
           GOBACK.

       1000-HOUSEKEEP.
           PERFORM 9999-OPEN-STUFF.

           CALL "TSPLPRT" USING SP-RET-CODE, SP-AREA.
           IF SP-RET-CODE = "NF"
               MOVE "SPOOL KEY NOT FOUND * RCVEXEC" TO BU-DISPLAY-MSG
               PERFORM 2100-BLOWUP
           ELSE
           IF SP-RET-CODE NOT = "00"
               MOVE "TSPLPRT ERROR * RCVEXEC" TO BU-DISPLAY-MSG
               PERFORM 2100-BLOWUP.

           MOVE SP-SPOOL-NO (1)          TO  PASS-SPOOL.
           MOVE SP-USERNAME              TO  SRF-USERNAME.

           MOVE "P 01"                   TO  PLT-ARG.
           PERFORM 9999-GETKEY-MPLTINFO-PK-I.
           MOVE MPLTINFO-COMPANY         TO  SRF-MPLTINFO-COMPANY
                                             REQ-PLANT-CODE.

           MOVE "PLAN"                   TO  PLT-ARG.
           PERFORM 9999-GETKEY-MPLTINFO-PK-I.
           MOVE PRIMARY-LANGUAGE         TO  SDSCINQ-DDESC-LANG
           MOVE SECONDARY-LANGUAGE       TO  SDSCINQ-DDESC2-LANG.

           MOVE "Y"                      TO  HOLD-ST5-SW.
           MOVE "OPT "                   TO  PLT-ARG.
           PERFORM 9999-GETKEY-MPLTINFO-PK-I.
           IF FILE-STATUS = "00"
               MOVE MPLTINFO-ST5-ON-STR-SW
                                         TO  HOLD-ST5-SW.

      *---------- THE STST KEY IN MPLTINFO TELLS IF THIS IS A MULTIPLE
      *---------- STOREROOM PLANT.  IF THE "ALWAYS-MULT-STR-CODE" FLAG IS
      *---------- SET TO "Y", ALL CODES ARE CONSIDERED "MULTIPLE STOREROOM
      *---------- CODES".  IF NOT, ONLY CODES WITH AN "A-", "B-", ETC PREFIX
      *---------- IN AT LEAST 1 LOCATION ARE CONSIDERED MULT-STR-CODES.
           MOVE SPACES                   TO  BUF-MPLTINFO
           MOVE "STST"                   TO  PLT-ARG
           PERFORM 9999-GETKEY-MPLTINFO-PK-I.
           IF NO-ENTRY
               MOVE "N"                  TO  MULT-STR-FLAG
               MOVE "N"                  TO  ALWAYS-MULT-STR-CODE-FLAG
               MOVE "Y"                  TO  WO-OVERRD-ENTRY
               MOVE "Y"                  TO  WO-OVERRD-EXP
               MOVE "N"                  TO  ENTRY-OVERRD-EXP
               MOVE "N"                  TO  WS-PW-SW
               MOVE "N"                  TO  VALID-EMPL-CRAFTWS
               MOVE "N"                  TO  VALID-EMPL-STORES
           ELSE
               MOVE MPLTINFO-ST          TO  MULTIPLE-STR-DATA.

      *---------- THE 7TH DIGIT OF THE USER TELLS WHICH STOREROOM WE ARE
      *---------- AT IN A MULT-STR SITUATION.  (IE. "STORESA" MEANS WE ARE
      *---------- AT STOREROOM A, ETC).
           IF MULT-STR-FLAG = "Y"
               MOVE SRF-USER-7           TO  MULT-STR-STR-1
               MOVE SRF-USER-8           TO  MULT-STR-STR-2.
           CALL "CLWHO" USING USERNAME TERMNUM CURRLIB JOBLIBX.
           MOVE "RQGB" TO PLT-ARG.
           MOVE PLT-ARG TO PLTINFOKEY OF MPLTINFO-PK-REC-I.
           PERFORM 9999-GETKEY-MPLTINFO-PK-I.
020100     IF COND-WORD NOT = 0
020200         MOVE "DBGET ERR MPLTINFO" TO BU-DISPLAY-MSG
020300         GO TO 2100-BLOWUP.
           MOVE MPLTINFO-RQGB TO REQ-GLOBALS.
           MOVE SPACES TO INQ-CC-INPUT.
           MOVE USERNAME TO USERID OF MEMPL-REC.
           READ MEMPL INTO BUF-MEMPL
               INVALID KEY     MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS = "00"
               IF MEMPL-INQUIRE-CAP = "Y"
                   MOVE SPACES TO INQ-CC-INPUT
                   MOVE "Y"    TO INQ-INQ-FLAG
               ELSE
               MOVE MEMPL-EMPL TO INQ-CC-INPUT
               MOVE "N"        TO INQ-INQ-FLAG
           ELSE
           MOVE SPACES         TO INQ-CC-INPUT
           MOVE "Y"            TO INQ-INQ-FLAG.
       1990-H-X.
           EXIT.

       2000-EOJ.
           PERFORM 9999-CLOSE-STUFF.

       2100-BLOWUP.
           MOVE "TUDCSTR"                TO  BU-PGM-NAME.
           CALL "TBLOWUP" USING BASE, BU-PGM-NAME, STATUS-AREA,
             VIEW-COMAREA, DUMMY-KSAM-STAT, BU-DISPLAY-MSG,
             BU-DISPLAY-FLDS.

       6000-MAIN.
       6010-GETNEXTFORM.
           MOVE "FUDCSTR"                TO  VIEW-NFNAME.
           MOVE SPACES                   TO  DE-PGM-KEY.
           MOVE SRF-MPLTINFO-COMPANY     TO  V-COMPANY.
       6100-SHOWFORM.
      *----- f1, f2, f3 INVALID, f4 REFRESH, f5 PRINT, f6 INVALID, f7 CLEAR
           MOVE 7                        TO  SRF-KEYSET.
      *---------- REMOVE ST5 OPTION FROM SCREEN IF SPECIFIED IN MPLTINFO.
           IF HOLD-ST5-SW = "N"
               MOVE B"1" TO IND (50).
           PERFORM 9999-DO-SCREEN-1.
           IF VIEW-LASTKEY = EXIT-PROGRAM
               GO TO 6990-MAIN-X.

           MOVE DE-PGM-KEY               TO  SCOM-PGM-KEY.

           IF DE-PGM-KEY = "SW1" OR "SW2" OR "SW3" OR "SW4" OR "ST1"
                        OR "ST2" OR "ST3" OR "ST4"
               CALL "SIRMAIN" USING BASE, MMIS-BASE, VIEW-COMAREA,
                 LANGUAGE-PARMS, STORES-COMAREA, SRF-COMAREA,
                 SRF-SPOOLER-REC, ESC-NAME, MULTIPLE-STR-DATA.

      *------ 07MAY1996 ADDED SRF-MPLTINFO-COMPANY TO THE SET OF
      *------  PARAMETERS PASSED TO SRETWVLS.  ---DAVE PLUM
           IF DE-PGM-KEY = "ST5"
               IF HOLD-ST5-SW = "N"
                   NEXT SENTENCE
               ELSE
               CALL "SRETWVLS" USING BASE, VIEW-COMAREA, LANGUAGE-PARMS,
                 ESC-NAME, MULTIPLE-STR-DATA, SRF-MPLTINFO-COMPANY.

           IF DE-PGM-KEY = "SW6" OR "ST6"
               CALL "SIRMULT" USING BASE, MMIS-BASE, STATUS-AREA,
                 VIEW-COMAREA, STORES-COMAREA, SRF-COMAREA,
                 SRF-SPOOLER-REC, LANGUAGE-PARMS, MULTIPLE-STR-DATA,
                 ESC-NAME, ISCR-DATA.

           IF DE-PGM-KEY = "SR"
               CALL "SSTRRCV" USING BASE, VIEW-COMAREA, LANGUAGE-PARMS,
                 SRF-BUF-MPLTINFO, MULTIPLE-STR-DATA.

           IF DE-PGM-KEY = "SB"
               CALL "SBINLOCS" USING BASE, VIEW-COMAREA,
                 LANGUAGE-PARMS.

           IF DE-PGM-KEY = "Q1"
               MOVE "N"                  TO  CSF-MODE
               MOVE "FCSISINQ"           TO  CSF-NEW-FORMFILE-NAME
               PERFORM 7150-CALL-CSWITCHF
               IF CSF-OPENFORM-ERR-SW = "Y"
                   GO TO 6100-SHOWFORM
               ELSE
                   CALL "TMTLSTAT" USING BASE, VIEW-COMAREA,
                     SRF-MPLTINFO-COMPANY, SRF-SPOOL-PRT-NO,
                     DUMMY-CODE, LANGUAGE-PARMS
                   MOVE "O"              TO  CSF-MODE
                   PERFORM 7150-CALL-CSWITCHF.

           IF DE-PGM-KEY = "Q3"
               MOVE "N"                  TO  CSF-MODE
               MOVE "FCSISINQ"           TO  CSF-NEW-FORMFILE-NAME
               PERFORM 7150-CALL-CSWITCHF
               IF CSF-OPENFORM-ERR-SW = "Y"
                   GO TO 6100-SHOWFORM
               ELSE
                   CALL "SRSINQS" USING BASE, VIEW-COMAREA,
                     LANGUAGE-PARMS
                   MOVE "O"              TO  CSF-MODE
                   PERFORM 7150-CALL-CSWITCHF.

           IF DE-PGM-KEY = "Q4"
               MOVE "N"                  TO  CSF-MODE
               MOVE "FCSISINQ"           TO  CSF-NEW-FORMFILE-NAME
               PERFORM 7150-CALL-CSWITCHF
               IF CSF-OPENFORM-ERR-SW = "Y"
                   MOVE 0                TO  VIEW-STATUS
                   GO TO 6100-SHOWFORM
               ELSE
                   CALL "TPOINQCS" USING BASE, VIEW-COMAREA,
                     LANGUAGE-PARMS
                   MOVE "O"              TO  CSF-MODE
                   PERFORM 7150-CALL-CSWITCHF.

           IF DE-PGM-KEY = "Q8"
               MOVE "N"                  TO  CSF-MODE
               MOVE "ZCSISINQ"           TO  CSF-NEW-FORMFILE-NAME
               PERFORM 7150-CALL-CSWITCHF
               IF CSF-OPENFORM-ERR-SW = "Y"
                   MOVE 0                TO  VIEW-STATUS
                   GO TO 6100-SHOWFORM
               ELSE
                   MOVE SPACES     TO REQI-DATA
                   CALL "SMREQINQ" USING REQI-RET-CODE,
                                         BASE,
                                         BASE-STHIST,
                                         MMIS-BASE,
                                         BUDGET-BASE,
                                         STATUS-AREA,
                                         VIEW-COMAREA,
                                         LANGUAGE-PARMS,
                                         REQI-DATA,
                                         REQ-GLOBALS,
                                         REQ-PLANT,
                                         PASS-SPOOL,
                                         ESC-NAME
                   MOVE "O"              TO  CSF-MODE
                   PERFORM 7150-CALL-CSWITCHF.

           IF DE-PGM-KEY = "Q9"
               MOVE SRF-MPLTINFO-COMPANY TO  SDSCINQ-COMPANY
               MOVE "N"                  TO  CSF-MODE
               MOVE "FCSISINQ"           TO  CSF-NEW-FORMFILE-NAME
               PERFORM 7150-CALL-CSWITCHF
               IF CSF-OPENFORM-ERR-SW = "Y"
                   GO TO 6100-SHOWFORM
               ELSE
                   CALL "SDSCINQ" USING BASE, VIEW-COMAREA,
                     LANGUAGE-PARMS, SDSCINQ-PARMS
                   MOVE "O"              TO  CSF-MODE
                   PERFORM 7150-CALL-CSWITCHF.

           IF DE-PGM-KEY = "SM1"
               CALL "SRWREPRT" USING BASE, MMIS-BASE, STATUS-AREA,
                 VIEW-COMAREA, STORES-COMAREA, SRF-COMAREA,
                 SRF-SPOOLER-REC, LANGUAGE-PARMS, MULTIPLE-STR-DATA,
                 ESC-NAME.

           IF DE-PGM-KEY = "SM2"
               MOVE "FRSCREEN"           TO  CSF-NEW-FORMFILE-NAME
               MOVE "N"                  TO  CSF-MODE
               PERFORM 7150-CALL-CSWITCHF
               IF CSF-OPENFORM-ERR-SW = "Y"
                   GO TO 6100-SHOWFORM
               ELSE
                   CALL "SRSCRNS" USING BASE, VIEW-COMAREA,
                     LANGUAGE-PARMS, PASS-RPT-NUMBER
                   PERFORM 7140-OPENTERM
                   MOVE "O"              TO  CSF-MODE
                   PERFORM 7150-CALL-CSWITCHF.

           IF DE-PGM-KEY = "RS"
               CALL "SRESERVE" USING BASE, MMIS-BASE,
                 VIEW-COMAREA, SRF-COMAREA, LANGUAGE-PARMS.

           MOVE SPACES                   TO  MESSAGE-BUFFER.
           MOVE SPACES                   TO  DE-FIELDS-1.
           GO TO 6010-GETNEXTFORM.
       6990-MAIN-X.
           EXIT.

       7140-OPENTERM.
      *    CALL "VOPENTERM" USING VIEW-COMAREA, TERMFILENAME.
      *    IF VIEW-STATUS NOT = 0
      *        MOVE "OPENTERM ERR 7140-O" TO BU-DISPLAY-MSG
      *        PERFORM 2100-BLOWUP.
      *
       7150-CALL-CSWITCHF.
           MOVE "N"                      TO  CSF-OPENFORM-ERR-SW.
           CALL "CSWITCHF" USING VIEW-COMAREA, LANGUAGE-PARMS,
             FORMFILE, CSF-PARMS, BU-DISPLAY-MSG.
           IF BU-DISPLAY-MSG-1 NOT = SPACES
               PERFORM 2100-BLOWUP.
       COPY SCRNCALL IN COPYLIB.
       COPY SCRNCL1  IN COPYLIB.

      *------ THIS VERSION OF CATREAD ASSUMES THE SET/MSG NUMBER
      *------ WILL BE IN CATREAD-MSG-NUMBER.
       999-CATREAD.
           CALL "CCATREAD" USING CATREAD-PARMS.
           MOVE CATREAD-MSG-TEXT TO MESSAGE-BUFFER.
           IF MESSAGE-BUFFER-1  = SPACES
               MOVE "* ERROR ON THIS FIELD *" TO MESSAGE-BUFFER.
       999-CATREAD-EXIT.
           EXIT.

       9999-GETKEY-MPLTINFO-PK-I.
           MOVE 0 TO COND-WORD.
           MOVE PLT-ARG TO PLTINFOKEY OF MPLTINFO-PK-REC-I.
           READ MPLTINFO-PK-I INTO BUF-MPLTINFO
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS = "23"
               MOVE 17 TO COND-WORD
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD
               IF HANDLE-BLOWUP-FLAG = "Y"
                   MOVE "GETKEY ERR 9999-GETKEY-MPLTINFO-PK-I"
                       TO BU-MSG-AREA
                   PERFORM 2100-BLOWUP.

       9999-OPEN-STUFF.
           OPEN INPUT MEMPL.
           OPEN INPUT MPLTINFO-PK-I.
       COPY OPDISPL  IN COPYLIB.
       9999-CLOSE-STUFF.
           CLOSE DISPLAY-FILE.
           CLOSE MEMPL.
           CLOSE MPLTINFO-PK-I.
