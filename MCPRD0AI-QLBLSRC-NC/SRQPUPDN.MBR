000900******************************************************
001000*                                                    *
001100*   S R Q P U P D C                                  *
001200*                                                    *
001300*D  THIS SUB PROGRAM PLACES NON-CODED REQUISITIONS   *
001400*D  ON HOLD OR RETURNS THEM TO THE ORIGINATOR AND IS *
001500*D  USED BY PURCHASING.                              *
001600*D  NOTE THE REQUISITION MUST BE RELEASED TO         *
001700*D  PURCHASING BEFORE PURCHASING CAN UPDATE IT.      *
001800*                                                    *
001900******************************************************
002000*   N O T E    T H I S   S U B R O U T I N E   I S   *
002100*         C A L L E D    B Y :                       *
002200*      1. TRQPUPDT                                   *
002300******************************************************
002400*   N O T E    T H I S   S U B R O U T I N E         *
002500*         C A L L S :                                *
002600*      1. TCHKBLKT                                   *
002700*      2. TBLKTINQ                                   *
002800*      3. SPOINQ                                     *
002900******************************************************
003000*     08/25/87.
003100*       CHANGED PROGRAM TO PUT THE ACTUAL PO NUMBER ON THE SCREEN
003200*       WHEN A PO IS CUT FOR A REQ.  ALSO ADDED PO INQUIRY AS A
003300*       FUNCTION KEY.
003400*       AMK.
003500*
003600 ENVIRONMENT DIVISION.
003700 CONFIGURATION SECTION.
003800 SOURCE-COMPUTER.  HP-3000.
003900 OBJECT-COMPUTER.  HP-3000.
       COPY SPECIALN IN COPYLIB.
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT DREQD-RQ-I
               ASSIGN TO DATABASE-MCFLCS2101
               ORGANIZATION IS INDEXED
                 ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                 WITH DUPLICATES
               FILE STATUS IS FILE-STATUS.

           SELECT DREQITM-RQ-I
               ASSIGN TO DATABASE-MCFLCS2201
               ORGANIZATION IS INDEXED
                 ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                 WITH DUPLICATES
               FILE STATUS IS FILE-STATUS.

           SELECT MBUYER-BY-I
               ASSIGN TO DATABASE-MCFLCS0601
               ORGANIZATION IS INDEXED
                 ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
               FILE STATUS IS FILE-STATUS.

           SELECT MVALIDPLTDATA-VD-I
               ASSIGN TO DATABASE-MCFLCS1701
               ORGANIZATION IS INDEXED
                 ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
               FILE STATUS IS FILE-STATUS.

           SELECT MREQ-RQ-O
               ASSIGN TO DATABASE-MCFLCS2001
               ORGANIZATION IS INDEXED
                 ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
               FILE STATUS IS FILE-STATUS.

           SELECT DDAILYTC-DL-O
               ASSIGN TO DATABASE-MCFLCS1601
               ORGANIZATION IS INDEXED
                 ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                 WITH DUPLICATES
               FILE STATUS IS FILE-STATUS.

           SELECT DISPLAY-FILE
               ASSIGN TO WORKSTATION-ZRQPUPDT-SI
               ORGANIZATION IS TRANSACTION
               ACCESS IS SEQUENTIAL
               FILE STATUS IS DISPLAY-STATUS
               CONTROL-AREA IS WS-CONTROL.
004000
