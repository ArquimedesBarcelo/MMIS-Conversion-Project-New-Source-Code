023700*************************************************************
023800 LINKAGE SECTION.
023900 01  BASE                          PIC X(10).
024000
024100 01  COMPANY-SAVE                  PIC X(3).
024200 01  REQ-ARG                       PIC X(12).
024300 COPY VCOMLINK   IN COPYLIB.
024400 01  PASSED-SPOOL-PRT              PIC S9(2) BINARY.
024500 COPY LANGSUB    IN COPYLIB.
024600 COPY MREQ       IN COPYLIB.
024700 01  FORMFILE                      PIC X(36).
024800 01  FORMFILE-FCSISINQ             PIC X(36).
024900
025000 PROCEDURE DIVISION USING  BASE,
025100                           COMPANY-SAVE,
025200                           REQ-ARG,
025300                           VIEW-COMAREA,
025400                           PASSED-SPOOL-PRT,
025500                           LANGUAGE-PARMS,
025600                           BUF-MREQ,
025700                           FORMFILE,
025800                           FORMFILE-FCSISINQ.
025900
026000 1-BEGIN.
           MOVE "01" TO BU-DISPLAY-PARA.
026100     MOVE "SRQPUPDN"               TO  BU-PGM-NAME.
026200     MOVE "I"                      TO  SRF-FKEY (1), SRF-FKEY (2),
026300                                       SRF-FKEY (6), SRF-FKEY (7),
026400                                       SRF-FKEY (8).
           PERFORM 9999-OPEN-STUFF.
           MOVE SPACES TO DE-FIELDS.
026500     PERFORM 6000-MAIN THRU 6400-MAIN-X.
           PERFORM 9999-CLOSE-STUFF.
026600     GOBACK.
026700
026800 2100-BLOWUP.
026900     MOVE REQ-ARG                  TO  BU-DISPLAY-FLD (1).
027000     CALL "TBLOWUP" USING BASE, BU-PGM-NAME, STATUS-AREA,
027100       VIEW-COMAREA, FILE-STATUS, BU-DISPLAY-MSG,
027200       BU-DISPLAY-FLDS.
027300
030800 4500-REWRITE-SCREEN.
030900     MOVE "FRQPUPDT4"              TO  VIEW-NFNAME.
           PERFORM 9951-GETNEXTFORM.
031500     MOVE SPACES TO                MESSAGE-BUFFER.
           PERFORM 9956-PUTWINDOW.
032200     PERFORM 9953-PUTBUFFER.
032300
032400 4500-RS-EXIT.
032500     EXIT.
032600
032700
032800 6000-MAIN.
           MOVE "02" TO BU-DISPLAY-PARA.
032900     MOVE "FRQPUPDT4"              TO  VIEW-NFNAME.
           PERFORM 9951-GETNEXTFORM.
034000     MOVE SPACES TO                MESSAGE-BUFFER.
           PERFORM 9956-PUTWINDOW.
034700*--------- GET THE DATA AND MOVE IT TO THE SCREEN
034800     PERFORM 6500-GET-DATA THRU 6590-GD-X.
034900     PERFORM 6600-MOVE-DATA THRU 6690-MD-X.
035100     PERFORM 9953-PUTBUFFER.
035200
035300 6100-SHOW-FORM.
           MOVE "03" TO BU-DISPLAY-PARA.
035400*-------- THE SUBPROG "TSHWRDF2" DOES SHOWFORM, READFIELDS,
035500*-------- FIELDEDITS, AND HANDLES SPECIAL FUNCTION KEYS
035600     MOVE PASSED-SPOOL-PRT         TO   SRF-SPOOL-NO (1).
035700     IF F3-VALID
035800         MOVE 3                    TO  LABEL-NUMBER
035900         MOVE F3-LABEL             TO  LABEL-VALUE
036000         PERFORM 9960-SETKEYLABEL
036100         MOVE 0                    TO  SRF-KEYSET
036200         MOVE F3-KEYSET            TO  SRF-FKEY-AREA
036300     ELSE
036400         MOVE 7                    TO  SRF-KEYSET.
       6110-SHOWFORM.
           MOVE DE-FIELDS TO DISPLAY-REC.
           PERFORM 998-WRITE-SCREEN THRU 9989-WS-X.
           MOVE DISPLAY-REC TO DE-FIELDS.
           IF MESSAGE-BUFFER-1 NOT = SPACES
               PERFORM 9954-SETERROR
               GO TO 6110-SHOWFORM.
037000
037100     IF VIEW-LASTKEY = 3
037200         GO TO 6400-MAIN-X.
037300
037400     PERFORM 9952-GETBUFFER.
037500     IF VIEW-LASTKEY = 8
037600         MOVE FORMFILE-FCSISINQ   TO  FORMFILE-1
037700         PERFORM 6800-OPEN-AND-CLOSE-FORM  THRU  6800-OACF-X
037800         CALL "SPOINQ" USING BASE,
037900                             BASE-STHIST,
038000                             VIEW-COMAREA,
038100                             COMPANY-SAVE,
038200                             LANGUAGE-PARMS
038300         MOVE FORMFILE            TO  FORMFILE-1
038400         PERFORM 6800-OPEN-AND-CLOSE-FORM  THRU  6800-OACF-X
038500         PERFORM 4500-REWRITE-SCREEN THRU 4500-RS-EXIT
038600         GO TO 6100-SHOW-FORM.
038700
038800*------ EDIT THE HOLD OR RELEASE STATUS ENTERED BY USER
038900*------ LOCK THE ENTRY, THEN GET IT AGAIN TO INSURE DATA
039000*------ INTEGRITY - YET NOT LOCK THE ENTRY THROUGH A SCREEN
039100     MOVE SPACES                   TO  MESSAGE-BUFFER-1.
039200     PERFORM 6750-LOCK-GET-MREQ
039300     PERFORM 6700-EDIT-SCREEN THRU 6740-ES-X.
039400     IF MESSAGE-BUFFER-1 NOT = SPACES
039500         PERFORM 9932-UNLOCK-MREQ
039600         GO TO 6100-SHOW-FORM.
039700
039800*------ LOCK AND GET THE MREQ ENTRY, UPDATE THE BUFFER AS EITHER
039900*------ HOLD OR RETURN STATUS, TENR HOLD OR RETURN STATUS,
040000*------ AND THEN UPDATE AND UNLOCK THE REQ ENTRY
040100
040200*------ ON HOLD, UPDATE THE REQ HOLD STATUS.  ON RETURN, CALL
040300*------ SUBPROG WHICH WILL UPDATE TO RETURN STATUS, AND RE-QUEUE THE
040400*------ THE REQ FOR ALL APPROVERS.
040500     IF DE-HOLD-OPTION > SPACES
040600         PERFORM 6760-HOLD-REQ
040700         PERFORM 6770-UPDATE-UNLOCK-MREQ
040800     ELSE
040900     IF DE-RETURN-OPTION > SPACES
041000         PERFORM 9932-UNLOCK-MREQ
041100         PERFORM 6765-RETURN-REQ
041200         IF COMPANY-SAVE = "622" OR "645" OR "648" OR "658"
041300             PERFORM 7170-TC337
041400         ELSE
041500             NEXT SENTENCE
041600     ELSE
041700         PERFORM 9932-UNLOCK-MREQ.
041800
041900
042000 6400-MAIN-X.
042100     EXIT.
042200
042300 6500-GET-DATA.
           MOVE "04" TO BU-DISPLAY-PARA.
           PERFORM 9999-DBFIND-DREQD-RQ-I.
           PERFORM 9999-DBGET5-DREQD-RQ-I.
043600
           PERFORM 9999-DBFIND-DREQITM-RQ-I.
           PERFORM 9999-DBGET5-DREQITM-RQ-I.
044100
044800 6590-GD-X.
044900     EXIT.
045000
045100 6600-MOVE-DATA.
045200     MOVE COMPANY-SAVE             TO  DISP-COMP.
045300     MOVE REQ-ARG                  TO  DISP-REQ-NO.
045400
045500     MOVE REQ-DATE                 TO  DATE-VALIDATE-IN.
045600     MOVE 4                        TO  DATE-MODE.
045700     CALL "TDATECHK" USING DATE-CHECK-AREA.
045800     MOVE DATE-SLASH-OUT           TO  DISP-REQDATE.
045900
046000     MOVE REQITM-QTY-TO-ORD        TO  DISP-REQ-QTY.
046100     MOVE REQITM-UM                TO  DISP-REQ-UM.
046200     MOVE DREQD-WO-NUMBER          TO  DISP-WO-NUMBER.
046300     MOVE DREQD-WO-ITM-NO          TO  DISP-WO-ITEM.
046400
046500     MOVE REQ-DATE-WANTED          TO  DATE-VALIDATE-IN.
046600     CALL "TDATECHK" USING DATE-CHECK-AREA.
046700     MOVE DATE-SLASH-OUT           TO  DISP-DATE-WANTED.
046800
046900     IF REQ-RELEASE-STAT = "XX"
047000         MOVE DREQD-PO-RCV-NO      TO  SAVE-PO-RCV-NO
047100         MOVE STRIP-PO-NO          TO  PO-NO-OUT
047200         MOVE PO-MSG               TO  DISP-BLKT-MSG
047300         MOVE "Y"                  TO  F3-VALID-SW
047400         MOVE "P.O. CUT"           TO  DISP-HOLD-STATUS
047500     ELSE
047600     MOVE SPACES TO DISP-BLKT-MSG
047700     IF REQ-RELEASE-STAT = "X "
047800         IF REQ-HOLD-STATUS = SPACES
047900             MOVE "PURCHASING"     TO  DISP-HOLD-STATUS
048000         ELSE
048100             MOVE REQ-HOLD-STATUS  TO  DISP-HOLD-STATUS
048200     ELSE
048300     IF REQ-HOLD-STATUS = SPACES
048400         MOVE "MTL. CTL."          TO  DISP-HOLD-STATUS
048500     ELSE
048600         MOVE REQ-HOLD-STATUS      TO  DISP-HOLD-STATUS.
048700
048800     MOVE REQ-ACCT-INFO            TO  DISP-ACCT-INFO.
048900
049000     MOVE 3                        TO  RQD-NUM-LINES.
049100     CALL "TNRQDESC" USING RQD-NUM-LINES, BASE, STATUS-AREA,
049200       REQ-ARG, REQ-DESC-AREA, BU-DISPLAY-MSG.
049300     IF BU-DISPLAY-MSG-1 NOT = SPACES
049400         PERFORM 2100-BLOWUP.
049500
049600     MOVE RQD-DESC (1)             TO  DESC-OUT (1).
049700     MOVE RQD-DESC (2)             TO  DESC-OUT (2).
049800     MOVE RQD-DESC (3)             TO  DESC-OUT (3).
049900
           MOVE DREQD-BUYER-CODE TO BUYER-ARG.
           PERFORM 9999-DBGET7-MBUYER-BY-I.
050200     IF GOOD-CALL
050300         MOVE BUYER-NAME           TO  DISP-BUYER-NAME
050400     ELSE
050600         MOVE SPACES               TO  DISP-BUYER-NAME.
051000
051100     MOVE REQ-BUDGET-NO            TO  BUILD-BUDGETNO.
051200     MOVE BUILD-BUDGET1            TO  EDIT-BUDGET1.
051300     MOVE BUILD-BUDGET2            TO  EDIT-BUDGET2.
051400     MOVE BUILD-BUDGET3            TO  EDIT-BUDGET3.
051500     MOVE BUILD-BUDGET4            TO  EDIT-BUDGET4.
051600     MOVE EDIT-BUDGET-NO           TO  DISP-BUDGET-NUMBER.
051700
051800     MOVE REQ-BUDGET-AMT           TO  DISP-BUDGET-AMOUNT.
051900     MOVE REQ-FOR-DEPT             TO  DISP-FOR-DEPT.
052000     MOVE REQ-STAGING-AREA         TO  DISP-STAGING-AREA.
052100     MOVE REQITM-UNIT-PRICE        TO  DISP-EST-PRICE.
052200
052300 6690-MD-X.
052400     EXIT.
052500
052600 6700-EDIT-SCREEN.
052700     IF DE-HOLD-OPTION = SPACES
052800         NEXT SENTENCE
052900     ELSE
053000     IF REQ-MATCONT-RELEASE = "X"
053100         IF REQ-PURCH-RELEASE = SPACES
053200             NEXT SENTENCE
053300         ELSE
053400*            "CANNOT PUT ON HOLD REQUISITION ON P.O.#"
053500             MOVE 3                TO  LANG-SETNUM
053600             MOVE 129              TO  LANG-MSGNUM
053700             PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
053800             MOVE DREQD-PO-NUM-RLSE TO MSG-FLD
053900             MOVE 8                TO  FIELD-NUMBER
054000             PERFORM 9954-SETERROR
054100             GO TO 6740-ES-X
054200     ELSE
054300*        "CANNOT PUT ON HOLD REQUISITION NOT RELEASED BY ORIGINATOR"
054400         MOVE   3 TO LANG-SETNUM
054500         MOVE 130 TO LANG-MSGNUM
054600         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
054700         MOVE 8                    TO  FIELD-NUMBER
054800         PERFORM 9954-SETERROR
054900         GO TO 6740-ES-X.
055000
055100     IF DE-RETURN-OPTION = SPACES
055200         NEXT SENTENCE
055300     ELSE
055400     IF REQ-MATCONT-RELEASE = "X"
055500         IF REQ-PURCH-RELEASE = SPACES
055600             NEXT SENTENCE
055700         ELSE
055800*            "CANNOT RETURN; REQUISITION ON P.O.#"
055900             MOVE   3 TO LANG-SETNUM
056000             MOVE 131 TO LANG-MSGNUM
056100             PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
056200             MOVE DREQD-PO-NUM-RLSE TO MSG-FLD
056300             MOVE 9  TO  FIELD-NUMBER
056400             PERFORM 9954-SETERROR
056500             GO TO 6740-ES-X
056600     ELSE
056700*        "CANNOT RETURN; REQUISITION NOT RELEASED BY ORIGINATOR"
056800         MOVE   3 TO LANG-SETNUM
056900         MOVE 132 TO LANG-MSGNUM
057000         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
057100         MOVE 9  TO  FIELD-NUMBER
057200         PERFORM 9954-SETERROR
057300         GO TO 6740-ES-X.
057400
057500     IF DE-HOLD-OPTION  =  SPACES
057600         GO TO 6740-ES-X.
057700     MOVE DE-HOLD-OPTION  TO  STATUS-CODE.
           PERFORM 9999-DBGET7-MVALIDPLTDATA-VD-I.
058100     IF NO-ENTRY
058200*        "* INVALID HOLD OPTION CHOOSEN *"
058300         MOVE   9 TO LANG-SETNUM
058400         MOVE  80 TO LANG-MSGNUM
058500         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
058600         MOVE DE-HOLD-OPTION  TO  MSG-FLD
058700         MOVE 8     TO  FIELD-NUMBER
058800         PERFORM 9954-SETERROR
058900         GO TO 6740-ES-X.
059400
059500 6740-ES-X.
059600     EXIT.
059700
059800 6750-LOCK-GET-MREQ.
059900     MOVE REQ-ARG                  TO   LOCK-VALUE-1,
060000                                        LOCK-VALUE-2.
           PERFORM 9930-LOCK.
           PERFORM 9999-DBGET7-MREQ-RQ-O.
061200
061300 6760-HOLD-REQ.
061400     MOVE DE-HOLD-OPTION           TO  REQ-HOLD-STATUS-CODE.
061500     MOVE VALID-DATA-DESC          TO  REQ-HOLD-STATUS.
061600
061700 6765-RETURN-REQ.
061800     MOVE "N"                      TO   CSF-MODE.
061900     MOVE "FCSISINQ"               TO   CSF-NEW-FORMFILE-NAME.
062000     PERFORM 7150-CALL-CSWITCHF.
062100     IF CSF-OPENFORM-ERR-SW = "Y"
062200         MOVE "COULDN'T OPEN INQ FORM" TO BU-DISPLAY-MSG
062300         PERFORM 2100-BLOWUP.
062400
           PERFORM 9999-RESET-MREQ-RQ-O.
062500     MOVE "Y"                      TO   EARET-LOCK-FLAG.
062600     CALL "SEARETRN" USING BASE, BASE-MMISA, BASE-BUDGET,
062700       STATUS-AREA, BUF-MREQ, BUF-DREQITM, BUF-DREQD,
062800       REQ-GLOBALS, EARET-PARMS, LANGUAGE-PARMS, VIEW-COMAREA.
062900
063000     MOVE "O"                      TO   CSF-MODE.
063100     PERFORM 7150-CALL-CSWITCHF.
063200
063300 6770-UPDATE-UNLOCK-MREQ.
           PERFORM 9999-DBUPDATE-MREQ-RQ-O.
063900     PERFORM 9932-UNLOCK-MREQ.
064000
064100 9932-UNLOCK-MREQ.
064600 6800-OPEN-AND-CLOSE-FORM.
064700     PERFORM 9963-CLOSEFORM.
065100
065200*******************************************************
065300**  CALL 'ZSIZE' INTRINSIC TO RECOVER 'Z' AREA NO
065400**  LONGER BEING USED SO THAT THE 'DL' AREA CAN BE
065500**  EXPANDED IF NEEDED DURING THE 'VOPENFORM'
065600**  THIS AVOIDS THE 'DL' SIZE ERROR VIEW-STATUS=40
065700*******************************************************
065800
           PERFORM 9961-ZSIZE.
           PERFORM 9962-OPENFORM.

066700 6800-OACF-X.
066800     EXIT.
066900
067000 7150-CALL-CSWITCHF.
067100     CALL "CSWITCHF" USING VIEW-COMAREA, LANGUAGE-PARMS,
067200       FORMFILE, CSF-PARMS, BU-DISPLAY-MSG.
067300     IF BU-DISPLAY-MSG-1 NOT = SPACES
067400         PERFORM 2100-BLOWUP.
067500
067600 7170-TC337.
           PERFORM 9935-LOCK-DDAILYTC.
068200     MOVE SPACES                   TO   BUF-DDAILYTC.
068300     MOVE 1                        TO   DATE-MODE.
068400     CALL "TDATECHK" USING DATE-CHECK-AREA.
068500     MOVE DATE-YMD-OUT             TO   DDAILYTC-DATE.
068600     MOVE DATE-UNFORMATTED-TIME-OUT TO  DDAILYTC-TIME.
068700     MOVE "337"                    TO   DDAILYTC-TC.
068800     MOVE COMPANY-SAVE             TO   DDAILYTC-PLT.
068900     MOVE REQITM-CORP-CODE         TO   DDAILYTC-CODE.
069000     MOVE MREQ-NUMBER              TO   TC337-REQ-NUMBER.
069100
           PERFORM 9999-DBPUT-DDAILYTC-DL-O.
           PERFORM 9940-UNLOCK.
070400
       COPY HCATREAD IN COPYLIB.
       COPY DISPCALL IN COPYLIB.
       COPY DISPCAL2 IN COPYLIB.

       9930-LOCK.
       9932-UNLOCK-MREQ.
           MOVE HIGH-VALUES TO REQNO OF MREQ-RQ-REC-O.
           START MREQ-RQ-O KEY > REQNO OF MREQ-RQ-REC-O
             INVALID KEY MOVE "00" TO FILE-STATUS.

       9935-LOCK-DDAILYTC.
       9940-UNLOCK.

       9951-GETNEXTFORM.
       9952-GETBUFFER.
       9953-PUTBUFFER.
       9954-SETERROR.
           MOVE B"1" TO IND (99).
           MOVE B"1" TO IND (FIELD-NUMBER).
           MOVE MESSAGE-BUFFER TO DE-MESSAGE-LINE.
       9955-CLEAR-FORM.
       9956-PUTWINDOW.
       9957-FIELDEDITS.
       9958-INITFORM.
       9960-SETKEYLABEL.
       9961-ZSIZE.
       9962-OPENFORM.
       9963-CLOSEFORM.

       9999-DBUPDATE-MREQ-RQ-O.
           MOVE 0 TO COND-WORD.
           REWRITE MREQ-RQ-REC-O FROM BUF-MREQ
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE "DBUPDATE ERR 9999-DBUPDATE-MREQ-RQ-O"
                   TO BU-MSG-AREA
               MOVE 99 TO COND-WORD.

       9999-DBFIND-DREQD-RQ-I.
           MOVE 0 TO COND-WORD.
           MOVE REQ-ARG TO REQNO OF DREQD-RQ-REC-I.
           START DREQD-RQ-I KEY = REQNO OF DREQD-RQ-REC-I
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF (FILE-STATUS NOT = "00") AND (FILE-STATUS-1 NOT = "2")
               MOVE "DBFIND ERR 9999-DBFIND-DREQD-RQ-I"
                   TO BU-MSG-AREA
               PERFORM 2100-BLOWUP.

       9999-DBGET5-DREQD-RQ-I.
           MOVE 0 TO COND-WORD.
           READ DREQD-RQ-I NEXT INTO BUF-DREQD
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   MOVE 15 TO COND-WORD
               ELSE
                   MOVE "DBGET5 ERR 9999-DBGET5-DREQD-RQ-I"
                       TO BU-MSG-AREA
                   MOVE 99 TO COND-WORD
           ELSE
           IF REQNO OF DREQD-RQ-REC-I NOT = REQ-ARG
               MOVE 15 TO COND-WORD.

       9999-DBFIND-DREQITM-RQ-I.
           MOVE 0 TO COND-WORD.
           MOVE REQ-ARG TO REQNO OF DREQITM-RQ-REC-I.
           START DREQITM-RQ-I KEY = REQNO OF DREQITM-RQ-REC-I
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF (FILE-STATUS NOT = "00") AND (FILE-STATUS-1 NOT = "2")
               MOVE "DBFIND ERR 9999-DBFIND-DREQITM-RQ-I"
                   TO BU-MSG-AREA
               PERFORM 2100-BLOWUP.

       9999-DBGET5-DREQITM-RQ-I.
           MOVE 0 TO COND-WORD.
           READ DREQITM-RQ-I NEXT INTO BUF-DREQITM
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   MOVE 15 TO COND-WORD
               ELSE
                   MOVE "DBGET5 ERR 9999-DBGET5-DREQITM-RQ-I"
                       TO BU-MSG-AREA
                   MOVE 99 TO COND-WORD
           ELSE
           IF REQNO OF DREQITM-RQ-REC-I NOT = REQ-ARG
               MOVE 15 TO COND-WORD.

       9999-DBGET7-MBUYER-BY-I.
           MOVE 0 TO COND-WORD.
           MOVE BUYER-ARG TO BUYERCDE OF MBUYER-BY-REC-I.
           READ MBUYER-BY-I INTO BUF-MBUYER
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS = "23"
               MOVE 17 TO COND-WORD
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE "DBGET7 ERR 9999-DBGET7-MBUYER-BY-I"
                   TO BU-MSG-AREA
               PERFORM 2100-BLOWUP.

       9999-DBGET7-MVALIDPLTDATA-VD-I.
           MOVE 0 TO COND-WORD.
           MOVE VALID-DATA-ARG TO VALDTAKEY OF MVALIDPLTDATA-VD-REC-I.
           READ MVALIDPLTDATA-VD-I INTO BUF-MVALIDPLTDATA
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS = "23"
               MOVE 17 TO COND-WORD
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE "DBGET7 ERR 9999-DBGET7-MVALIDPLTDATA-VD-I"
                   TO BU-MSG-AREA
               PERFORM 2100-BLOWUP.

       9999-DBGET7-MREQ-RQ-O.
           MOVE 0 TO COND-WORD.
           MOVE REQ-ARG TO REQNO OF MREQ-RQ-REC-O.
           READ MREQ-RQ-O INTO BUF-MREQ
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS = "23"
               MOVE 17 TO COND-WORD
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE "DBGET7 ERR 9999-DBGET7-MREQ-RQ-O"
                   TO BU-MSG-AREA
               PERFORM 2100-BLOWUP.

       9999-RESET-MREQ-RQ-O.
           MOVE HIGH-VALUES TO REQNO OF MREQ-RQ-REC-O.
           START MREQ-RQ-O KEY > REQNO OF MREQ-RQ-REC-O
               INVALID KEY MOVE "00" TO FILE-STATUS.

       9999-DBPUT-DDAILYTC-DL-O.
           MOVE 0 TO COND-WORD.
           WRITE DDAILYTC-DL-REC-O FROM BUF-DDAILYTC
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE "DBPUT ERR 9999-DBPUT-DDAILYTC-DL-O"
                   TO BU-MSG-AREA
               PERFORM 2100-BLOWUP.

       9999-OPEN-STUFF.
           OPEN I-O DISPLAY-FILE.
           OPEN INPUT DREQD-RQ-I            DREQITM-RQ-I
                      MBUYER-BY-I           MVALIDPLTDATA-VD-I   .
           OPEN I-O   MREQ-RQ-O             DDAILYTC-DL-O        .

       9999-CLOSE-STUFF.
           CLOSE DISPLAY-FILE
           CLOSE      DREQD-RQ-I            DREQITM-RQ-I
                      MBUYER-BY-I           MVALIDPLTDATA-VD-I
                      MREQ-RQ-O             DDAILYTC-DL-O        .
