000200 IDENTIFICATION DIVISION.
000300 PROGRAM-ID. TJOBPFIX.
000400 ENVIRONMENT DIVISION.
000500 CONFIGURATION SECTION.
000600 SOURCE-COMPUTER. AS400.
000700 OBJECT-COMPUTER. AS400.
       SPECIAL-NAMES. I-O-FEEDBACK IS I-O-FEEDBACK-AREA
                      LOCAL-DATA IS LOCAL-DATA-AREA.
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT JOBPLAN-FILE
               ASSIGN TO DATABASE-MCFPMM1800
               ORGANIZATION IS SEQUENTIAL
               ACCESS IS SEQUENTIAL
               FILE STATUS IS JF-STATUS.
000800 DATA DIVISION.
       FILE SECTION.
       FD  JOBPLAN-FILE
           LABEL RECORDS ARE STANDARD
           DATA RECORD IS JFREC.
       01  JFREC.
           COPY DDS-ALL-FORMATS OF MCFPMM1800.
000900 WORKING-STORAGE SECTION.
       77  JP-REC-CTR          PIC 9(6).
       77  SUB                 PIC 99.
       01  JF-STATUS           PIC XX.
005200 01  JOBPLAN-BUFFER.
           05  JBYTE OCCURS 88 TIMES PIC X.
012500 COPY DBSTAT   OF COPYLIB.
015900 PROCEDURE DIVISION.
016200 START-PROGRAM.
016300     PERFORM 1-HSK.
016400     PERFORM 6-MAIN.
016500 2-EOJ.
           DISPLAY "RECORDS PROCESSED = " JP-REC-CTR.
           CLOSE JOBPLAN-FILE.
016600     GOBACK.
016700 1-HSK.
           OPEN I-O   JOBPLAN-FILE.
           MOVE 0 TO JP-REC-CTR.
           MOVE 0 TO SUB.
       6-MAIN.
           PERFORM 69-READ-JOBPLAN-FILE.
           PERFORM 60-CHANGE-JOBFILE THRU 60-CJ-EXIT
               UNTIL COND-WORD = 15.

       60-CHANGE-JOBFILE.
           ADD 1 TO SUB.
           IF SUB > 88
               PERFORM 69-REWRITE-JOBPLAN-FILE
               ADD 1 TO JP-REC-CTR
               IF COND-WORD = 15
                   GO TO 60-CJ-EXIT
               ELSE
               PERFORM 69-READ-JOBPLAN-FILE
               IF COND-WORD = 15
                   GO TO 60-CJ-EXIT
               ELSE
               MOVE 0 TO SUB
               GO TO 60-CHANGE-JOBFILE.
           IF JBYTE (SUB) = "¢"
               MOVE "(" TO JBYTE (SUB)
               GO TO 60-CHANGE-JOBFILE.
           IF JBYTE (SUB) = "!"
               MOVE ")" TO JBYTE (SUB)
               GO TO 60-CHANGE-JOBFILE.
           GO TO 60-CHANGE-JOBFILE.
       60-CJ-EXIT.    EXIT.

       69-READ-JOBPLAN-FILE.
           MOVE 0 TO COND-WORD.
           READ JOBPLAN-FILE NEXT INTO JOBPLAN-BUFFER
               AT END    MOVE 15 TO COND-WORD.
           IF JF-STATUS NOT = "00" MOVE 15 TO COND-WORD.

       69-REWRITE-JOBPLAN-FILE.
           MOVE 0 TO COND-WORD.
           REWRITE JFREC FROM JOBPLAN-BUFFER.
           IF JF-STATUS NOT = "00" MOVE 15 TO COND-WORD.
