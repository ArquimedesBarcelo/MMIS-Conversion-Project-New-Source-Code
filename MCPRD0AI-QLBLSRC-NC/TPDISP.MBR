000200 IDENTIFICATION DIVISION.
000300 PROGRAM-ID.    TPDISP.
000400 INSTALLATION.  GOODYEAR.
000500*REMARKS.
000600*        ########################################################
000700*        #  This is the personnel main display program .......  #
000800*        #  ---- -- --- --------- ---- ------- ------- .......  #
000900*        ########################################################.
      *C
      *C 09/09/96  JEFF BUNGO
      *C   EXPAND DATE FIELDS FOR YEAR 2000 COMPLIANCE.
      *C   RECOMPILE TO PICK UP COPYLIB CHANGES.
      *C
001100 ENVIRONMENT DIVISION.
001200 CONFIGURATION SECTION.
001300 SOURCE-COMPUTER.      AS400.
001400 OBJECT-COMPUTER.      AS400.
       SPECIAL-NAMES.      I-O-FEEDBACK IS I-O-FEEDBACK-AREA
                           LOCAL-DATA IS LOCAL-DATA-AREA.
001000 INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT DISPLAY-FILE
               ASSIGN TO WORKSTATION-ZPERSON-SI
               ORGANIZATION IS TRANSACTION
               ACCESS IS SEQUENTIAL
               FILE STATUS IS DSPLY-STATUS
               CONTROL-AREA IS WS-CONTROL.
           SELECT PER-CONFIDENTIAL
               ASSIGN TO DATABASE-MCFLMM3301
               ORGANIZATION IS INDEXED
               ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                   WITH DUPLICATES
               FILE STATUS IS PC-STATUS.
           SELECT PER-FREE
               ASSIGN TO DATABASE-MCFLMM3201
               ORGANIZATION IS INDEXED
               ACCESS IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
               FILE STATUS IS PFC-STATUS.
           SELECT PERSONNEL-FILE
               ASSIGN TO DATABASE-MCFLMM0301
               ORGANIZATION IS INDEXED
               ACCESS IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
               FILE STATUS IS PF-STATUS.
001500 DATA DIVISION.
       FILE SECTION.
       FD  DISPLAY-FILE
           LABEL RECORDS ARE OMITTED.
       01  DSPLY-REC                   PIC X(2000).
       FD  PER-CONFIDENTIAL
           LABEL RECORDS ARE STANDARD
           DATA RECORD IS PCREC.
       01  PCREC.
           COPY DDS-ALL-FORMATS OF MCFLMM3301.
       FD  PER-FREE
           LABEL RECORDS ARE STANDARD
           DATA RECORD IS PFCREC.
       01  PFCREC.
           COPY DDS-ALL-FORMATS OF MCFLMM3201.
       FD  PERSONNEL-FILE
           LABEL RECORDS ARE STANDARD
           DATA RECORD IS PFREC.
       01  PFREC.
           COPY DDS-ALL-FORMATS OF MCFLMM0301.
001600 WORKING-STORAGE SECTION.
       COPY CATREAD OF COPYLIB.
003000 01  CC-BUF.
           05  CC-FIELD                 PIC X(4).
           05  CC-CMD-LINE              PIC X(79).
           05  CC-ERR-LINE              PIC X(79).
003500 01  CC-SW                        PIC X.
       COPY CPYIND  OF COPYLIB.
003200 01  ERROR-BUFFER                 PIC X(80).
       01  FILE-STATUSES.
           05  DSPLY-STATUS             PIC XX.
           05  PC-STATUS                PIC XX.
           05  PF-STATUS                PIC XX.
           05  PFC-STATUS               PIC XX.
       COPY IOFEEDBACK OF COPYLIB.
001700 01  PASSWORD-INFORMATION.
001800     05  NAME-OF-PROGRAM     PIC X(08) VALUE "TPDISP  ".
001900     05  PROGRAM-TYPE        PIC X(02) VALUE "MA".
002000     05  PROGRAM-RELEASE     PIC X(12) VALUE " E0100010001".
002100     05  PROGRAM-DESCRIPTION.
002200         10  PROG-DESC-A     PIC X(60) VALUE
002300            "MAIN DISPLAY PROGRAM IN THE PERSONNEL MODULE "      .
002400         10  PROG-DESC-B     PIC X(60) VALUE SPACES.
002600         10  PROG-FUNCTION   PIC X(60) VALUE SPACES.
002800     05  PASSWORD-FLAG       PIC X.
003300 01  PER-PERSONNEL.               COPY MPERSONL OF COPYLIB.
002900 01  RETURN-SW                    PIC X.
003700 01  SAVE-KEY                     PIC S9(4) COMP-4.
003400 COPY DBSTAT IN COPYLIB.
       01  TRUE-VAL                     PIC 1 VALUE B"1".
003800 COPY WSCONTROL OF COPYLIB.
003900 LINKAGE SECTION.
004000 01  DBPARAMETERS.                COPY DBPARMS OF COPYLIB.
004100 COPY VCOMLINK IN COPYLIB.
004200 01  PLT-IDT                      PIC X(4).
004400
004500 PROCEDURE DIVISION USING DBPARAMETERS
004600                          VIEW-COMAREA
004700                          PLT-IDT.
       BEGIN-PROGRAM.
           PERFORM 1-HSK.
           PERFORM 6-MAIN UNTIL VIEW-LASTKEY = 3.
       2-EOJ.
           CLOSE DISPLAY-FILE.
           CLOSE PER-CONFIDENTIAL.
           CLOSE PER-FREE.
           CLOSE PERSONNEL-FILE.
           GOBACK.
       1-HSK.
           OPEN I-O   DISPLAY-FILE.
           OPEN INPUT PER-CONFIDENTIAL.
           OPEN INPUT PER-FREE.
           OPEN INPUT PERSONNEL-FILE.
005000     CALL "TPWORD" USING PASSWORD-INFORMATION.
005400     IF PASSWORD-FLAG = "N" GO TO 2-EOJ.
005800     MOVE SPACES TO ERROR-BUFFER DSPLY-REC CC-BUF.
       6-MAIN.
005900     MOVE "FPDISP1" TO VIEW-CFNAME.
           IF INDS (99) = TRUE-VAL
               MOVE ERROR-BUFFER TO CC-ERR-LINE.
           MOVE CC-BUF TO DSPLY-REC.
007300     PERFORM 99-SCREEN-WRITE.
           PERFORM 98-SCREEN-READ.
           MOVE DSPLY-REC TO CC-BUF.
008300     IF VIEW-LASTKEY = 3 GO TO 2-EOJ.
008400     MOVE VIEW-LASTKEY TO SAVE-KEY.
           PERFORM 69-START-PERSONNEL-FILE.
011300     IF COND-WORD = 0
011400         MOVE "Y" TO CC-SW
               PERFORM 69-READ-PERSONNEL-FILE
               IF COND-WORD = 0
                   NEXT SENTENCE
               ELSE
               MOVE "N" TO CC-SW
011600     ELSE
011700     MOVE "N" TO CC-SW.
012100     IF SAVE-KEY = 1
012200         IF CC-SW = "Y"
012300             CALL "TPDISP1" USING DBPARAMETERS VIEW-COMAREA
012400                              PLT-IDT PER-PERSONNEL
                   MOVE 0 TO VIEW-LASTKEY
                   MOVE PER-CC-NUM TO CC-BUF
012500         ELSE
012600         MOVE 29023 TO CATREAD-MSG-NUMBER
012800         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE TRUE-VAL TO INDS (1) INDS (99)
013400         GO TO 6-MAIN
013500     ELSE
013600     IF SAVE-KEY = 2
013700         IF CC-SW = "Y"
013800             IF SPACES = PER-YEAR1 AND PER-YEAR2 AND PER-YEAR3
013900                 MOVE 27006 TO CATREAD-MSG-NUMBER
014100                 PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
014200                 MOVE TRUE-VAL TO INDS (1) INDS (99)
014700                 GO TO 6-MAIN
014800             ELSE
014900             CALL "TPDISP2" USING DBPARAMETERS VIEW-COMAREA
015000                              PLT-IDT PER-PERSONNEL
                   MOVE 0 TO VIEW-LASTKEY
                   MOVE PER-CC-NUM TO CC-BUF
015100         ELSE
015200         MOVE 29023 TO CATREAD-MSG-NUMBER
015400         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE TRUE-VAL TO INDS (1) INDS (99)
016000         GO TO 6-MAIN
016100     ELSE
016200     IF SAVE-KEY = 4
016300         IF CC-SW = "Y"
016700             PERFORM 69-START-PER-FREE
017000             IF COND-WORD = 17
017100                 MOVE 46035 TO CATREAD-MSG-NUMBER
017300                 PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                       MOVE TRUE-VAL TO INDS (1) INDS (99)
018100                 GO TO 6-MAIN
018200             ELSE
011100             MOVE 33002 TO CATREAD-MSG-NUMBER
011400             PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE ERROR-BUFFER TO CC-CMD-LINE
                   MOVE CC-BUF TO DSPLY-REC
                   MOVE TRUE-VAL TO INDS (98)
                   PERFORM 99-SCREEN-WRITE
                   PERFORM 98A-SCREEN-READ
                   CALL "CLPAUSE2"
018300             CALL "TPDISP3" USING DBPARAMETERS VIEW-COMAREA
018400                              PLT-IDT PER-PERSONNEL
                   MOVE 0 TO VIEW-LASTKEY
                   MOVE PER-CC-NUM TO CC-BUF
018500         ELSE
018600         MOVE 29023 TO CATREAD-MSG-NUMBER
018800         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE TRUE-VAL TO INDS (1) INDS (99)
019400         GO TO 6-MAIN
019500     ELSE
019600     IF SAVE-KEY = 5
019700         IF CC-SW = "Y"
020100             PERFORM 69-START-PER-CONFIDENTIAL
020400             IF COND-WORD = 17
020500                 MOVE 35056 TO CATREAD-MSG-NUMBER
020700                 PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
020800                 MOVE TRUE-VAL TO INDS (1) INDS (99)
021500             GO TO 6-MAIN
021600         ELSE
021700         CALL "TPDISP4" USING DBPARAMETERS VIEW-COMAREA
021800                           PLT-IDT PER-PERSONNEL
               MOVE 0 TO VIEW-LASTKEY
               MOVE PER-CC-NUM TO CC-BUF
021900     ELSE
022000     MOVE 29023 TO CATREAD-MSG-NUMBER
022200     PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
           MOVE TRUE-VAL TO INDS (1) INDS (99)
022800     GO TO 6-MAIN.
024000
       69-START-PER-FREE.
           MOVE 0 TO COND-WORD.
           MOVE CC-FIELD TO PERCCNUM OF PFCREC.
           START PER-FREE KEY IS = EXTERNALLY-DESCRIBED-KEY
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF PFC-STATUS NOT = "00" MOVE 17 TO COND-WORD.

       69-START-PER-CONFIDENTIAL.
           MOVE 0 TO COND-WORD.
           MOVE CC-FIELD TO PERCCNUM OF PCREC.
           START PER-CONFIDENTIAL KEY IS = EXTERNALLY-DESCRIBED-KEY
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF PC-STATUS NOT = "00" MOVE 17 TO COND-WORD.

       69-READ-PERSONNEL-FILE.
           MOVE 0 TO COND-WORD.
           READ PERSONNEL-FILE NEXT INTO PER-PERSONNEL
               AT END    MOVE 15 TO COND-WORD.
           IF PF-STATUS NOT = "00" MOVE 15 TO COND-WORD.

       69-START-PERSONNEL-FILE.
           MOVE 0 TO COND-WORD.
           MOVE CC-FIELD TO PERCCNUM OF PFREC.
           START PERSONNEL-FILE KEY IS = EXTERNALLY-DESCRIBED-KEY
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF PF-STATUS NOT = "00" MOVE 17 TO COND-WORD.

       98-SCREEN-READ.
           READ DISPLAY-FILE FORMAT IS VIEW-CFNAME
               INDIC IS INDICS.
           ACCEPT IOFEEDBACK FROM I-O-FEEDBACK-AREA.
           MOVE ALL B"0" TO INDICS.
           IF DSPLY-STATUS NOT = "00"
               MOVE 3 TO VIEW-LASTKEY
           ELSE
           MOVE FUNCTION-NUM TO VIEW-LASTKEY.

       98A-SCREEN-READ.
           READ DISPLAY-FILE TERMINAL IS TERMINAL-ID
               INDIC IS INDICS
                  NO DATA MOVE DSPLY-STATUS TO DSPLY-STATUS.
           MOVE ALL B"0" TO INDICS.

       99-SCREEN-WRITE.
           WRITE DSPLY-REC FORMAT IS VIEW-CFNAME
               INDIC IS INDICS.
           MOVE ALL B"0" TO INDICS.

024100 999-CATREAD.
           MOVE SPACES TO ERROR-BUFFER.
           CALL "CCATREAD" USING CATREAD-PARMS.
           MOVE CATREAD-MSG-TEXT TO ERROR-BUFFER.
025200 999-CATREAD-EXIT.
025300     EXIT.
