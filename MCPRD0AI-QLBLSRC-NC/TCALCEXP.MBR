057400*                                                *
057500**************************************************
057600
057700
057800 6-MAIN.
057900     SORT SORT-FILE
058000         ON ASCENDING KEY SORT-CODE
058100         INPUT PROCEDURE IS ABSTRACT-CODES
058200         OUTPUT PROCEDURE IS WRITE-REPORT.
058300
058400 6-M-X.
058500     EXIT.
058600
058700
058800
058900*******************************************
059000*                                         *
059100*    I N P U T    P R O C E D U R E       *
059200*                                         *
059300*******************************************
059400
059500 ABSTRACT-CODES SECTION.
059600
       61-START-MSTORERM.
           MOVE SPACES TO CORPCDE OF MSTORERM-REC-I.
           START MSTORERM-I KEY > CORPCDE OF MSTORERM-REC-I
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
                   NEXT SENTENCE
               ELSE
                   MOVE "START MSTORERM * 61-SM" TO BU-DISPLAY-MSG
                   GO TO 2-BLOWUP.

059700 61-ABSTRACT-LOOP.
059800
059900*** SERIAL GET THRU MSTORERM FOR CODES
060000
060100
           READ MSTORERM-I NEXT INTO BUF-MSTORERM
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
060900             GO TO 61-AC-X
061000         ELSE
061100             MOVE "GET MSTORERM AL"  TO  BU-DISPLAY-MSG
061200             GO TO 2-BLOWUP.
060500*** END OF SEGMENT (MODE2) GIVES A COND-CODE OF "11"
061300
061400
061500 61-DOES-CODE-QUALIFY.
061600     IF STR-STOCK-OT = " "
061700         NEXT SENTENCE
061800     ELSE
061900         GO TO 61-ABSTRACT-LOOP.
062000     IF STR-EST-LT = ZEROS  AND  STR-LAST-DLVTIMES (1) = ZEROS
062100         GO TO 61-ABSTRACT-LOOP.
062200     IF STR-MAX = ZEROS AND
062300        STR-REORDER = ZEROS AND
062400        STR-EXPEDITE = ZEROS
062500          GO TO 61-ABSTRACT-LOOP.
062600
062700 61-GET-USAGE.
           MOVE CORP-CODE TO CORPCDE OF USAGEFIL-REC-I.
           READ USAGEFIL-I INTO USAGE-REC
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
063200         MOVE "CKREADBYKEY ERR MS3F" TO BU-DISPLAY-MSG
063300         MOVE KEY-VALUE              TO BU-DISPLAY-FLD (1)
063400         GO TO 2-BLOWUP.
063500
063600     MOVE ZEROS                    TO  YEAR-TOTAL,
063700                                       SUB.
063800
063900 61-CALCULATE-USAGE.
064000     ADD 1  TO  SUB
064100     IF SUB  >  12
064200         GO TO 61-COMPUTE-NEW-EXPEDITES.
064300     ADD K-MTH-USAGE (SUB)  TO  YEAR-TOTAL.
064400     GO TO 61-CALCULATE-USAGE.
064500
064600 61-COMPUTE-NEW-EXPEDITES.
064700     DIVIDE YEAR-TOTAL  BY  365  GIVING  DAILY-USAGE.
064800     IF STR-EST-LT = ZEROS
064900         MOVE STR-LAST-DLVTIMES (1) TO  LEAD-TIME
065000     ELSE
065100         MOVE STR-EST-LT            TO  LEAD-TIME.
065200     MULTIPLY DAILY-USAGE BY LEAD-TIME
065300         GIVING LEAD-TIME-USAGE.
065400     COMPUTE SQ-LT-USAGE = LEAD-TIME-USAGE ** .5
065500     MULTIPLY SQ-LT-USAGE  BY  1.65
065600         GIVING EXPEDITE-95-AVAIL ROUNDED.
065700     MULTIPLY SQ-LT-USAGE  BY  3.09
065800         GIVING EXPEDITE-99-AVAIL ROUNDED.
065900     ADD EXPEDITE-95-AVAIL, LEAD-TIME-USAGE
066000         GIVING REORDER-95-AVAIL ROUNDED.
066100     ADD EXPEDITE-99-AVAIL, LEAD-TIME-USAGE
066200         GIVING REORDER-99-AVAIL ROUNDED.
066300     MULTIPLY STR-REORDER BY 1.5 GIVING
066400         REORDER-150-PCT ROUNDED.
066500     MULTIPLY STR-REORDER BY .5 GIVING
066600         REORDER-50-PCT ROUNDED.
066700
066800****  CHECK TO SEE IF PRESENT REORDER X 150% IS TOO LOW
066900
067000     IF REORDER-150-PCT  <  REORDER-95-AVAIL
067100         NEXT SENTENCE
067200     ELSE
067300
067400****  CHECK TO SEE IF PRESENT REORDER X 50% IS TOO HIGH
067500
067600     IF REORDER-50-PCT  >  REORDER-99-AVAIL
067700         NEXT SENTENCE
067800     ELSE
067900         GO TO 61-ABSTRACT-LOOP.
068000
068100 61-RELEASE-RCD.
068200     MOVE CORP-CODE                TO  SORT-CODE.
068300     MOVE STR-UM                   TO  SORT-UM.
068400     MOVE STR-MAX                  TO  SORT-MAX.
068500     MOVE STR-REORDER              TO  SORT-REORDER.
068600     MOVE STR-EXPEDITE             TO  SORT-EXPEDITE.
068700     MOVE DAILY-USAGE              TO  SORT-DAILY-USAGE.
068800     MOVE LEAD-TIME                TO  SORT-LEAD-TIME.
068900     MOVE EXPEDITE-95-AVAIL        TO  SORT-EXPEDITE-95-AVAIL.
069000     MOVE REORDER-95-AVAIL         TO  SORT-REORDER-95-AVAIL.
069100     MOVE EXPEDITE-99-AVAIL        TO  SORT-EXPEDITE-99-AVAIL.
069200     MOVE REORDER-99-AVAIL         TO  SORT-REORDER-99-AVAIL.
069300     RELEASE SORT-RCD.
069400     GO TO 61-ABSTRACT-LOOP.
069500
069600 61-AC-X.
069700     EXIT.
069800
069900*******************************************
070000*                                         *
070100*    O U T P U T   P R O C E D U R E      *
070200*                                         *
070300*******************************************
070400
070500 WRITE-REPORT SECTION.
070600 WRITE-RPT.
070700*    PERFORM 621-WRITE-HEADER-PAGE  THRU  621-WHP-X.
070800     MOVE 66  TO LINE-CTR.
070900
071000 62-RETURN-A-RECORD.
071100     RETURN SORT-FILE  AT END
071200         GO TO 62-WR-X.
071300
071400 62-MOVE-DATA-TO-PRINT.
071500     MOVE SORT-CODE                TO  CORP-CODE-OUT.
071600     MOVE SORT-UM                  TO  UM-OUT.
071700     MOVE SORT-DAILY-USAGE         TO  USAGE-OUT.
071800     MOVE SORT-LEAD-TIME           TO  LEAD-TIME-OUT.
071900     MOVE SORT-MAX                 TO  MAX-OUT.
072000     MOVE SORT-REORDER             TO  REORDER-OUT.
072100     MOVE SORT-EXPEDITE            TO  EXPEDITE-OUT.
072200     MOVE SORT-EXPEDITE-95-AVAIL   TO  EXPEDITE-95-AVAIL-OUT.
072300     MOVE SORT-REORDER-95-AVAIL    TO  REORDER-95-AVAIL-OUT.
072400     MOVE SORT-EXPEDITE-99-AVAIL   TO  EXPEDITE-99-AVAIL-OUT.
072500     MOVE SORT-REORDER-99-AVAIL    TO  REORDER-99-AVAIL-OUT.
072600     MOVE DETAIL-LINE-1            TO  PRINT-RCD.
072700     MOVE 2                        TO  LINE-ADV.
072800     PERFORM 621-WRITE-DETAIL-LINE.
072900
073000 62-GET-KEYWORD-ADJ.
073100     MOVE SORT-CODE                TO  CODE-ARG.
           MOVE CODE-ARG TO CORPCDE OF DDESC-REC-I.
           START DDESC-I KEY = CORPCDE OF DDESC-REC-I
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
                   NEXT SENTENCE
               ELSE
073500             MOVE "FIND DDESC * 62-GKA" TO BU-DISPLAY-MSG
073600             MOVE CODE-ARG              TO BU-DISPLAY-FLD (1)
073700             GO TO 2-BLOWUP.
073800
           MOVE 0 TO COND-WORD.
           READ DDESC-I NEXT INTO BUF-DDESC
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
074300             MOVE 15 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.
           IF CORPCDE OF DDESC-REC-I NOT = CODE-ARG
               MOVE 15 TO COND-WORD.
074100     IF COND-WORD NOT = 0
074200         IF COND-WORD = 15
074300             MOVE "* NO DESCRIPTION ON FILE *"
074400                 TO  DESC-OUT
074500         ELSE
074600             MOVE "GET DDESC * 62-GKA" TO BU-DISPLAY-MSG
074700             MOVE CODE-ARG             TO BU-DISPLAY-FLD (1)
074800             GO TO 2-BLOWUP
074900     ELSE
075000         MOVE DESC-DATA              TO  DESC-OUT.
075100     MOVE 1                       TO  LINE-ADV.
075200     MOVE DETAIL-LINE-2           TO  PRINT-RCD.
075300     PERFORM 621-WRITE-DETAIL-LINE.
075400
075500     GO TO 62-RETURN-A-RECORD.
075800
075900 621-WRITE-DETAIL-LINE.
076000     IF LINE-CTR > 56
076100         PERFORM 621-WRITE-HEADER-LINE.
076200     WRITE PRINT-RCD  AFTER ADVANCING  LINE-ADV.
076300     ADD LINE-ADV  TO  LINE-CTR.
076400
076500 621-WRITE-HEADER-LINE.
076600     MOVE PRINT-RCD       TO  SAVE-PRINT-LINE.
076700     MOVE ZEROS           TO  LINE-CTR.
076800     ADD 1                TO  PAGE-CTR
076900     MOVE PAGE-CTR        TO  PAGE-NO-OUT.
077000     WRITE PRINT-RCD FROM HEADER-1  AFTER
077100         ADVANCING NEWPAGE.
077200     WRITE PRINT-RCD FROM HEADER-2  AFTER
077300         ADVANCING 2 LINES.
077400     WRITE PRINT-RCD FROM HEADER-3  AFTER
077500         ADVANCING 1 LINES.
077600     WRITE PRINT-RCD FROM DASH-LINE  AFTER
077700         ADVANCING 1 LINES.
077800     MOVE SAVE-PRINT-LINE  TO  PRINT-RCD.
077900
078000*621-WRITE-HEADER-PAGE.
078100
078500*621-WHP-X.
078600*    EXIT.
078700
078800 62-WR-X.
078900     EXIT.
