078500     IF NOT GOOD-CALL
078600        MOVE "DBGET DVENDOR 245 SVENINQ" TO BU-DISPLAY-MSG
078700        PERFORM 990-BLOWUP THRU 999-EXIT.
078800
078900     IF VEN-ITM-NO = "00"
079000        MOVE VEN-ITM-DATA TO V3-VENNAME
079100     ELSE
079200        IF VEN-ITM-NO = "01"
079300            MOVE VEN-ITM-DATA TO V3-ADDR1
079400        ELSE
079500        IF VEN-ITM-NO = "02"
079600            MOVE VEN-ITM-DATA TO V3-ADDR2
079700        ELSE
079800        IF VEN-ITM-NO = "07"
079900            MOVE VEN-ITM-DATA TO V3-ADDR3
080000        ELSE
080100        IF VEN-ITM-NO = "09"
080200            MOVE VEN-CONTACT TO V3-CONTACT
080300            MOVE "CONTACT:" TO V3-CONTACT-LIT
080400            MOVE "PHONE:" TO V3-PHONE-LIT
080500                IF VEN-CONTACT-PHONE IS NUMERIC
080600                    MOVE VEN-PH-AREA   TO SCR-PH-AREA
080700                    MOVE VEN-PH-FIRST3 TO SCR-PH-FIRST3
080800                    MOVE VEN-PH-LAST4  TO SCR-PH-LAST4
080900                    MOVE "-"           TO SCR-PH-DASH1
081000                                          SCR-PH-DASH2
081100                ELSE
081200                IF VEN-PH2-TEST = SPACES
081300                AND VEN-CONTACT-PHONE NOT = SPACES
081400                    MOVE SPACES TO SCR-PHONE2
081500                    MOVE VEN-PH2-FIRST3 TO SCR-PH2-FIRST3
081600                    MOVE VEN-PH2-LAST4  TO SCR-PH2-LAST4
081700                    MOVE "-"            TO SCR-PH2-DASH1
081800                ELSE
081900                    MOVE SPACES TO SCR-PHONE
082000                    MOVE VEN-CONTACT-PHONE TO SCR-PHONE
082100        ELSE
082200        IF VEN-ITM-NO = "10"
082300            MOVE VEN-MIN-ORDER TO V3-MINORD
082400        ELSE
082500        IF VEN-ITM-NO = "12"
082600            MOVE VEN-FREE-NOTE-1 TO V3-NOTE1
082700            MOVE "NOTE:"         TO V3-NOTE-LIT
082800        ELSE
082900            IF VEN-ITM-NO = "13"
083000                MOVE VEN-FREE-NOTE-2 TO V3-NOTE2.
083100
083200     GO TO 245-VENDOR-LOOP.
083300******************************************************************
083400*                    DISPLAY SCREEN WITH ITEM DATA               *
083500******************************************************************
       246-NO-MORE.
           IF END-FLAG = 1
              MOVE B"0" TO IND(74)
           ELSE
              MOVE B"1" TO IND(74).

       247-PUTBUFFER.
           MOVE SCREEN3-SUBFILE TO DISPLAY-REC.
           WRITE SUBFILE DISPLAY-REC FORMAT "RDSF1"
                 INDICATORS ARE SRF-INDICATORS.

       252-NEXT-SCREEN.
            MOVE RELATIVE-RECNO TO SUBFILE-CONTROL-RECNO.
            WRITE DISPLAY-REC FORMAT "RDSB1" INDICATORS SRF-INDICATORS.
            MOVE B"1" TO IND (76).
            IF RELATIVE-RECNO > ZERO
               MOVE B"1" TO IND(75)
            ELSE
               MOVE B"0" TO IND(75).

       253-CONTROL-SCREEN.
            MOVE SCREEN2-CONTROL TO DISPLAY-REC.
            WRITE DISPLAY-REC FORMAT "RDSC1" INDICATORS SRF-INDICATORS.
            READ DISPLAY-FILE FORMAT "RDSC1"
                 INDICATORS SRF-INDICATORS.
      *----------  CLEAR 'LAST VENDOR' MESSAGE
            MOVE B"0" TO IND(72).
      *----------  ROLLUP OR F3 EXIT OR F2 LAST VENDOR
            IF (IND(78) = B"1")
               GO TO 200-BY-CORPCODE
            ELSE
            IF (IND(02) = B"1")
               GO TO 270-LAST-BUSINESS-VENDOR
            ELSE
            IF (IND(03) = B"1")
               GO TO 299-EXIT.

092400 270-LAST-BUSINESS-VENDOR.
092500     IF SAVE-LAST-VENDOR = SPACES
092600****  NO LAST VENDOR ON RECORD FOR THIS CORPORATE CODE
               MOVE B"1" TO IND(72)
               GO TO 253-CONTROL-SCREEN.

      *----------  LAST VENDOR THAT WE HAVE DONE BUSINESS WITH
      *            IS IN RECORD 1
           MOVE 1 TO RELATIVE-RECNO.
           GO TO 252-NEXT-SCREEN.
093400
093500 299-EXIT.     EXIT.

093600 300-BY-VENDOR.
093700     MOVE 1 TO ITEM-COUNT.
093800
       302-BY-VENDOR.
070600*----------  GET EACH CORPORATE CODE TIED TO THE VENDOR
           IF END-FLAG = 1
              MOVE B"1" TO IND(73)
              GO TO 353-CONTROL-SCREEN
           ELSE
              MOVE B"0" TO IND(73).
           MOVE 0 TO COND-WORD.
           READ DVENDITM NEXT INTO BUF-DVENDITM
               AT END MOVE 15 TO COND-WORD.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   MOVE 15 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.
           IF VENCDE OF DVENDITM-REC NOT = VENDOR-ARG
               MOVE 15 TO COND-WORD.
071000     IF NOT GOOD-CALL
               MOVE 1 TO END-FLAG
               GO TO 346-NO-MORE.
072400
072500 340-MOVE-DATA.
           MOVE SPACES                       TO SCREEN5-SUBFILE.
           ADD  1                            TO RELATIVE-RECNO.
108500     MOVE VEN-ITM-PRICE                TO V5-PRICE.
108600     MOVE 4                            TO DATE-MODE.
108700     MOVE VEN-ITM-PRICE-DATE           TO DATE-VALIDATE-IN.
108800     CALL "TDATECK2" USING DATE-CHECK-AREA, LANGUAGE-PARMS.
108900     MOVE DATE-SLASH-OUT               TO V5-EXP-DATE.
109000
109100     MOVE VEN-ITM-LT1                  TO V5-LT1.
109200     MOVE VEN-ITM-LT2                  TO V5-LT2.
109300     MOVE VEN-ITM-LT3                  TO V5-LT3.
109400     MOVE VEN-EST-LT                   TO V5-LT4.
109500     MOVE VEN-TERMS                    TO V5-TERMS.
109600     MOVE VEN-FOB                      TO V5-FOB.
109700     MOVE VEN-ITM-CORPCODE             TO V5-CORPCODE, CODE-ARG.
109900
054800*165-GET-DESC.   *REPLACED 17JUL1997*
       345-GET-DESC.
           MOVE 0 TO COND-WORD.
           MOVE CODE-ARG TO CORPCDE OF DDESC-REC.
           START DDESC KEY = CORPCDE OF DDESC-REC
               INVALID KEY MOVE 17 TO COND-WORD.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
                   MOVE 17 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.
055100     IF NO-ENTRY OR CHAIN-LENGTH = 0
055200        MOVE 14 TO LANG-SETNUM
055300        MOVE  3 TO LANG-MSGNUM
055400        PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
055500        MOVE MESSAGE-BUFFER TO V5-DESC1
055600        GO TO 346-NO-MORE.
055700     IF NOT GOOD-CALL
055800        MOVE "DBFIND DDESC 345 SVENINQS" TO BU-DISPLAY-MSG
055900        PERFORM 990-BLOWUP THRU 999-EXIT.
           MOVE 0 TO COND-WORD.
           READ DDESC NEXT INTO BUF-DDESC
               AT END MOVE 15 TO COND-WORD.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   MOVE 15 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.
           IF CORPCDE OF DDESC-REC NOT = CODE-ARG
               MOVE 15 TO COND-WORD.
056200     IF NOT GOOD-CALL
056300        MOVE "DBGET1 DDESC 345 SVENINQS" TO BU-DISPLAY-MSG
056400        PERFORM 990-BLOWUP THRU 999-EXIT.
056500     MOVE DESC-DATA TO V5-DESC1
           READ DDESC NEXT INTO BUF-DDESC
               AT END MOVE 15 TO COND-WORD.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   MOVE 15 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.
           IF CORPCDE OF DDESC-REC NOT = CODE-ARG
               MOVE 15 TO COND-WORD.
056800     IF END-OF-CHAIN
056900        GO TO 346-NO-MORE.
057000     IF NOT GOOD-CALL
057100        MOVE "DBGET2 DDESC 345 SVENINQS" TO BU-DISPLAY-MSG
057200        PERFORM 990-BLOWUP THRU 999-EXIT.
057300     MOVE DESC-DATA TO V5-DESC2.
057400
083300******************************************************************
083400*                    DISPLAY SCREEN WITH ITEM DATA               *
083500******************************************************************
       346-NO-MORE.
           IF END-FLAG = 1
              MOVE B"0" TO IND(74)
           ELSE
              MOVE B"1" TO IND(74).

       347-PUTBUFFER.
           MOVE SCREEN5-SUBFILE TO DISPLAY-REC.
           WRITE SUBFILE DISPLAY-REC FORMAT "RDSF2"
                 INDICATORS ARE SRF-INDICATORS.

           ADD 1 TO ITEM-COUNT.
           IF ITEM-COUNT < 4
              GO TO 302-BY-VENDOR.

       352-NEXT-SCREEN.
            MOVE RELATIVE-RECNO TO V4-CONTROL-RECNO.
            WRITE DISPLAY-REC FORMAT "RDSB2" INDICATORS SRF-INDICATORS.
            MOVE B"1" TO IND (76).
            IF RELATIVE-RECNO > ZERO
               MOVE B"1" TO IND(75)
            ELSE
               MOVE B"0" TO IND(75).

       353-CONTROL-SCREEN.
            MOVE SCREEN4-CONTROL TO DISPLAY-REC.
            WRITE DISPLAY-REC FORMAT "RDSC2" INDICATORS SRF-INDICATORS.
            READ DISPLAY-FILE FORMAT "RDSC2"
                 INDICATORS SRF-INDICATORS.
      *----------  CLEAR 'LAST VENDOR' MESSAGE
            MOVE B"0" TO IND(72).
      *----------  ROLLUP OR F3 EXIT
            IF (IND(78) = B"1")
               GO TO 300-BY-VENDOR
            ELSE
            IF (IND(03) = B"1")
               GO TO 399-EXIT.

118100 399-EXIT.     EXIT.

       820-CLEAR-SUBFILE2.
           MOVE B"0" TO IND (73), IND (75), IND (76).
           MOVE B"1" TO IND (77).
           MOVE SCREEN2-CONTROL TO DISPLAY-REC.
           WRITE DISPLAY-REC FORMAT "RDSC1" INDICATORS SRF-INDICATORS.
           MOVE B"0" TO IND (77).
           MOVE 0 TO RELATIVE-RECNO.

       829-EXIT.  EXIT.

       830-CLEAR-SUBFILE1.
           MOVE B"0" TO IND (73), IND (75), IND (76).
           MOVE B"1" TO IND (77).
           MOVE SCREEN4-CONTROL TO DISPLAY-REC.
           WRITE DISPLAY-REC FORMAT "RDSC2" INDICATORS SRF-INDICATORS.
           MOVE B"0" TO IND (77).
           MOVE 0 TO RELATIVE-RECNO.

       839-EXIT.  EXIT.

124200 940-VSETERROR.
           MOVE B"1" TO IND (99).
           MOVE B"1" TO IND (FIELD-NUMBER).
           MOVE MESSAGE-BUFFER TO DE-MESSAGE-LINE.

125600 949-EXIT.     EXIT.

127200**********************************************************************
127300*                           B L O W U P                              *
127400*          CHECK FOR IMAGE, VIEW, OR SPOOL ERROR.  CLOSE             *
127500*          FILES, GET OUT OF BLOCK MODE, AND DISPLAY                 *
127600*          APPROPRIATE ERROR MESSAGE ON SCREEN.                      *
127700*                                                                    *
127800*          ALSO APPENDS THE ERROR MESSAGE TO A FILE CALLED           *
127900*          BLOWUP.PUB.  TO READ THIS FILE, RUN "XBLPRT.OBJECT".      *
128000*                                                                    *
128100*             |||   PROGRAM IS ABORTED IN TBLOWUP   |||              *
128200**********************************************************************
128400 990-BLOWUP.
128500     MOVE VIEW-NFNAME     TO BU-DISPLAY-FLD (1).
128600     MOVE CODE-ARG        TO BU-DISPLAY-FLD (2).
128700     MOVE VEN-ITM-VENCODE TO BU-DISPLAY-FLD (3).
129100     CALL "TBLOWUP" USING BASE, BU-PGM-NAME, STATUS-AREA,
129200                   VIEW-COMAREA, FILE-STATUS, BU-DISPLAY-MSG     ,
129300                   BU-DISPLAY-FLDS.

129400 999-EXIT.     EXIT.
129500
129600 999-CATREAD.
           IF CATREAD-MSG-NUMBER = ZEROS
               MOVE LANG-SETNUM TO CATREAD-MSG-SET
               MOVE LANG-MSGNUM TO CATREAD-MSG-NUM.
           CALL "CCATREAD" USING CATREAD-PARMS.
           MOVE CATREAD-MSG-TEXT TO MESSAGE-BUFFER.

131200 999-CATREAD-EXIT.
131300     EXIT.
