014000*        P R O C E D U R E        D I V I S I O N            *
014100**************************************************************
014200 PROCEDURE DIVISION.
014300 00-MAIN.
014400     PERFORM 010-OPEN-ALL THRU 019-EXIT.
           ACCEPT ACCEPT-DATA1.
014700     DISPLAY ACCEPT-DATA1.
           ACCEPT ACCEPT-DATA2.
           DISPLAY ACCEPT-DATA2.
           MOVE 0 TO QT-ENTRIES.
014800     PERFORM 200-CREATE-PO-FROM-QUOTE THRU 299-EXIT.
014900
015000     PERFORM 020-CLOSE-ALL THRU 029-EXIT.
015100
015200     GOBACK.
015300****************************************************************
015400*           OPEN ALL FILES AND PREPARE FOR PROCESSING          *
015500****************************************************************
015600 010-OPEN-ALL.
017500
017600*----------  OPEN DATABASE
           OPEN INPUT DVENDOR-I DVENDITM-I DREQDESC-I MBUYER-I
                      MSTORERM-I MPLTINFO-I DQUOTEXT-I.
018200
018300*----------  FIND THE PLANT NUMBER AND PASS IT TO SUBROUTINES
018400     MOVE "P 01" TO MPLTINFO-ARG.
           MOVE 0 TO COND-WORD.
           MOVE MPLTINFO-ARG TO PLTINFOKEY OF MPLTINFO-REC-I.
           READ MPLTINFO-I INTO BUF-MPLTINFO
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS-1 = "2"
               MOVE 17 TO COND-WORD
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD.
018700     IF COND-WORD NOT = 0
018800           MOVE "DBGET MPLTINFO - TQTGENPO" TO BU-DISPLAY-MSG
018900           PERFORM 990-BLOWUP THRU 999-EXIT.
           MOVE "P" TO PO-ARG.
           MOVE "STAND     " TO QT-STD-ARG.
020500 019-EXIT.  EXIT.
020600
020700****************************************************************
020800*                    CLOSE ALL FILES                           *
020900****************************************************************
021000 020-CLOSE-ALL.
           CLOSE      DVENDOR-I DVENDITM-I DREQDESC-I MBUYER-I
                      MSTORERM-I MPLTINFO-I DQUOTEXT-I.
021300 029-EXIT.  EXIT.
021400 200-CREATE-PO-FROM-QUOTE.
021410     PERFORM 840-SET-JCW THRU 849-EXIT.
021500     MOVE SQTPOS-QUOTE TO QUOTE-ARG.
           MOVE 0 TO COND-WORD.
           MOVE QUOTE-ARG TO QUOTENUM OF DVENDITM-REC-I.
           START DVENDITM-I KEY = QUOTENUM OF DVENDITM-REC-I
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
                   MOVE 17 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.
021800     IF NO-ENTRY
021900          GO TO 299-EXIT.
022000     IF NOT GOOD-CALL
022100        MOVE "DBFIND DVENDITM 200 TQTGENPO" TO BU-DISPLAY-MSG
022200        PERFORM 990-BLOWUP THRU 999-EXIT.
022300
022400 210-READ-ALL-ITEMS.
           MOVE 0 TO COND-WORD.
           READ DVENDITM-I NEXT INTO BUF-DVENDITM
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   MOVE 15 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.
           IF QUOTENUM OF DVENDITM-REC-I NOT = QUOTE-ARG
               MOVE 15 TO COND-WORD.
022700     IF END-OF-CHAIN
022900        GO TO 299-EXIT.
023000     IF NOT GOOD-CALL
023100        MOVE "DBGET DVENDITM 210 TQTGENPO" TO BU-DISPLAY-MSG
023200        PERFORM 990-BLOWUP THRU 999-EXIT.
023300
023301     MOVE VEN-ITM-VENCODE TO VENDOR-ARG.
      *------ CALL CCRTFILE TO CREATE A TEMPORARY FILE 'XXXXXXXXXX'
           MOVE "QTEMP"       TO CCRTFILE-LIBRARY.
           MOVE "DQTPO   "    TO CCRTFILE-FILE.
           MOVE "0133"        TO CCRTFILE-RECORD-LENGTH.
           MOVE "05000"       TO CCRTFILE-NO-RECORDS.
           MOVE "01000"       TO CCRTFILE-INCREMENT-AMT.
           MOVE "99"          TO CCRTFILE-NO-INCREMENTS.
           CALL "CCRTFILE" USING CCRTFILE-LIBRARY,
                                 CCRTFILE-FILE,
                                 CCRTFILE-RECORD-LENGTH,
                                 CCRTFILE-NO-RECORDS,
                                 CCRTFILE-INCREMENT-AMT,
                                 CCRTFILE-NO-INCREMENTS,
                                 CCRTFILE-STATUS.
           IF CCRTFILE-STATUS NOT = "00"
               MOVE "CCRTFILE CREATE OF 'DQTPO' FAILED"
                  TO BU-DISPLAY-MSG
               PERFORM 990-BLOWUP THRU 999-EXIT.
023310     OPEN OUTPUT INPUT-PO-FILE.
023320*******************************************************
023330*    CREATE HEADER LABEL RECORD                       *
023340*******************************************************
023350     MOVE SPACES                TO INPUT-PO-REC.
023360     MOVE "PURCHASE ORDERS"     TO HEADER-LABEL.
023370     MOVE "N"                   TO LOAD-SW.
023380     MOVE QUOTE-ARG-NUM         TO IN-QUOTE.
           MOVE FILE-HEADER-LABEL     TO INPUT-PO-REC.
           DISPLAY INPUT-PO-REC.
023390     WRITE INPUT-PO-REC.
