001000**                                                           **
001100*D          T C L A S C H K                                  **
001200**                                                           **
001300*D   THIS PROGRAM CHECKS TO MAKE SURE THAT THE CLASS FOR     **
001400*D   A CORPORATE CODE IS THE SAME IN MMATL-ACCUM AND         **
001500*D   DTRANS.                                                 **
001600**                                                           **
001700***************************************************************
      *C
      *C   07FEB1994    DAVE PLUM
      *C     ADDED CALL TO THE COBOL ERROR HANDLER - MCXCBLERR.
      *C
      *C   09/04/1996   CA YODER
      *C     MODIFIED PROGRAM FOR CENTURY DATABASE CHANGES.

001900 ENVIRONMENT DIVISION.
002000 CONFIGURATION SECTION.
002100 SOURCE-COMPUTER.      HP-3000.
002200 OBJECT-COMPUTER.      HP-3000.
       COPY SPECIALN IN COPYLIB.
002400
002500 INPUT-OUTPUT SECTION.
002600 FILE-CONTROL.

           SELECT MMATL-ACCUM-MC-I
               ASSIGN TO DATABASE-MCFLCA0601
               ORGANIZATION IS INDEXED
                 ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
               FILE STATUS IS FILE-STATUS.

           SELECT DTRANS-MC-I
               ASSIGN TO DATABASE-MCFLCA0701
               ORGANIZATION IS INDEXED
                 ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                 WITH DUPLICATES
               FILE STATUS IS FILE-STATUS.

           SELECT MPLTINFO-PK-I
               ASSIGN TO DATABASE-MCFLCS0501
               ORGANIZATION IS INDEXED
                 ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
               FILE STATUS IS FILE-STATUS.

           SELECT PRINT-FILE ASSIGN TO PRINTER-MCPRT.

           SELECT SORT-FILE ASSIGN TO DISK-SORT.

003100 DATA DIVISION.
