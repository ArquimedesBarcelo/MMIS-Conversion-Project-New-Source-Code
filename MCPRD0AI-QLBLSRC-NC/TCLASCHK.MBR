022200***************************************************************
022300 PROCEDURE DIVISION.
022400
022500 MAIN-PGM SECTION.
022600
022700 001-BEGIN-HERE.
022800     PERFORM 100-HSK              THRU 100-HSK-X.
022900     PERFORM 600-MAIN             THRU 600-MAIN-X.
023000     PERFORM 200-EOJ              THRU 200-EOJ-X.
023100     GOBACK.
023200
023300 100-HSK.
           MOVE "C" TO MCXCBLERR-SCOPE.
           CALL "MCXCBLERR" USING MCXCBLERR-SCOPE.
023400     MOVE "TCLASCHK" TO BU-PGM-NAME.
023500
023600     OPEN OUTPUT PRINT-FILE.
023700
           PERFORM 9999-OPEN-STUFF.
025600
025700     MOVE 1                       TO DATE-MODE.
025800     CALL "TDATECHK" USING DATE-CHECK-AREA.
025900     MOVE DATE-FORMATTED-TIME-OUT TO H2-TIME.
026000     MOVE DATE-SLASH-OUT          TO H2-DATE.
026200
026300*------------- GET RECORD FOR PLANT NUMBER
           PERFORM 9999-DBGET7-MPLTINFO-PK-I.
026600     IF NOT GOOD-CALL
026700         MOVE "DBGET ERROR IN 300-GET-PARMS"
026800             TO BU-DISPLAY-MSG
026900         MOVE "P 01" TO BU-DISPLAY-FLD (1)
027000         PERFORM 990-BLOWUP.
027100     MOVE MPLTINFO-COMPANY TO PLANT-H1.
027200
027300 100-HSK-X.
027400     EXIT.
027500
027600 200-EOJ.
027700     CLOSE PRINT-FILE.
027800
           PERFORM 9999-CLOSE-STUFF.
029100
029200 200-EOJ-X.
029300     EXIT.
029400
029600***************************************************************
029700**                                                           **
029800**                  6 0 0 - M A I N                          **
029900**                                                           **
030000***************************************************************
030100 600-MAIN.
030200
030300     SORT SORT-FILE ON ASCENDING KEY SORT-MASTER-CLASS
030400                                     SORT-MATL-CODE
030500         INPUT PROCEDURE  IS 700-PROCESS-TRANS
030600         OUTPUT PROCEDURE IS 800-CREATE-REPORT.
030700
030800 600-MAIN-X.
           EXIT.
030900
031000***************************************************************
031100**              I N P U T   P R O C E D U R E                **
031200***************************************************************
031300 700-PROCESS-TRANS SECTION.
       700-PROCESS-TRANS-PARA.
           PERFORM 9999-INIT-MMATL-ACCUM-MC-I.
031400
031500 710-GET-MMATL-ACCUM.
           PERFORM 9999-DBGET2-MMATL-ACCUM-MC-I.
032300     IF NOT GOOD-CALL
032400         IF END-OF-FILE
032500             GO TO 799-PROCESS-EXIT
032600         ELSE
032700             MOVE "DBGET MMATL-ACCUM * 710-GMA " TO
032800                  BU-DISPLAY-MSG
032900             MOVE COND-WORD TO BU-DISPLAY-FLD (1)
033000             PERFORM 990-BLOWUP.
033100
033200*----------  EXCLUDE NON-STORE ITEMS
033300     IF MATL-STORES-CODE = "NON-STR"
033400         GO TO 710-GET-MMATL-ACCUM
033500     ELSE
033600         MOVE MATL-STORES-CODE    TO MATL-CODE-ARG.
033700
           PERFORM 9999-DBFIND-DTRANS-MC-I.
034400     IF GOOD-CALL
034800         GO TO 720-GET-DTRANS
034900     ELSE
035000     IF NO-ENTRY
035100         GO TO 710-GET-MMATL-ACCUM
035200     ELSE
035300         MOVE "DBFIND MMATL-ACCUM * 710-GMA " TO
035400             BU-DISPLAY-MSG
035500         MOVE COND-WORD TO BU-DISPLAY-FLD (1)
035600         PERFORM 990-BLOWUP.
035700
035800 720-GET-DTRANS.
           PERFORM 9999-DBGET5-DTRANS-MC-I.
036600     IF NOT GOOD-CALL
036700         IF END-OF-CHAIN
036800             GO TO 710-GET-MMATL-ACCUM
036900         ELSE
037000             MOVE "DBGET DTRANS * 720-GET" TO
037100                  BU-DISPLAY-MSG
037200             MOVE COND-WORD TO BU-DISPLAY-FLD (1)
037300             PERFORM 990-BLOWUP.
037400
037500     IF TRANS-CLASS NOT = MATL-CLASS
037600         MOVE MATL-CLASS          TO  SORT-MASTER-CLASS
037700         MOVE TRANS-STORES-CODE   TO  SORT-MATL-CODE
037800         MOVE TRANS-CLASS         TO  SORT-CLASS
037900         MOVE TRANS-DEPT          TO  SORT-DEPT
038000         MOVE TRANS-ACCT          TO  SORT-ACCT
038100         MOVE TRANS-PO-NUM        TO  SORT-PO-NO
038200         MOVE TRANS-ITEM-NUM      TO  SORT-ITEM-NO
038300         MOVE TRANS-CODE          TO  SORT-TRANS-CODE
      *------------ ACCOUNT FOR CENTURY.
038400         MOVE TRANS-DATE-CN       TO  SORT-TRANS-DATE-CN
038500         MOVE TRANS-TIME          TO  SORT-TRANS-TIME
038600         MOVE TRANS-QTY           TO  SORT-QTY
038700         MOVE TRANS-VALUE         TO  SORT-VALUE
038800         MOVE TRANS-UNIT-MEASURE  TO  SORT-UM
038900         MOVE TRANS-BALANCE-QTY   TO  SORT-BAL-QTY
039000         RELEASE SORT-REC.
039100     GO TO 720-GET-DTRANS.
039200
039300 799-PROCESS-EXIT.
039400     EXIT.
039500
039600***************************************************************
039700**              O U T P U T   P R O C E D U R E              **
039800***************************************************************
039900 800-CREATE-REPORT SECTION.
       800-CREATE-REPORT-PARA.
040000     PERFORM 890-READ-SORT-FILE.
040100     PERFORM 890-NEW-PAGE.
040200     IF NO-MORE-RECORDS
040300         WRITE PRT-REC FROM NO-RECORDS AFTER ADVANCING 2 LINES
040400         GO TO 899-EXIT.
040500     PERFORM 810-WRITE-DETAIL UNTIL NO-MORE-RECORDS.
040600     GO TO 899-EXIT.
040700
040900 810-WRITE-DETAIL.
041000     IF SORT-MASTER-CLASS NOT = SAVE-CLASS
041100         WRITE PRT-REC FROM HEADER-3       AFTER ADVANCING 2 LINES
041200         MOVE SORT-MASTER-CLASS   TO  DL1-CLASS, SAVE-CLASS
041300         WRITE PRT-REC FROM DETAIL-LINE-1  AFTER ADVANCING 1 LINES
041400         WRITE PRT-REC FROM HEADER-4       AFTER ADVANCING 1 LINES
041500         ADD  4                   TO  LINE-CTR.
041600
041700     MOVE SORT-MATL-CODE          TO  DL2-CODE.
041800     MOVE SORT-CLASS              TO  DL2-CLASS.
041900     MOVE SORT-DEPT               TO  DL2-DEPT.
042000     MOVE SORT-ACCT               TO  DL2-ACCT.
042100     MOVE SORT-PO-NO              TO  DL2-PO.
042200     MOVE SORT-ITEM-NO            TO  DL2-ITEM.
042300     MOVE SORT-TRANS-CODE         TO  DL2-TRAN.
042400     MOVE 4                       TO  DATE-MODE.
042500     MOVE SORT-TRANS-DATE         TO  DATE-VALIDATE-IN.
042600     CALL "TDATECHK" USING DATE-CHECK-AREA.
042700     MOVE DATE-SLASH-OUT          TO  DL2-DATE.
042800     MOVE SORT-TRANS-TIME         TO  UNFORMATTED-TIME.
042900     MOVE UNFORMATTED-TIME-HH     TO  FORMATTED-TIME-HH.
043000     MOVE UNFORMATTED-TIME-MN     TO  FORMATTED-TIME-MN.
043100     MOVE UNFORMATTED-TIME-SS     TO  FORMATTED-TIME-SS.
043200     MOVE FORMATTED-TIME-OUT      TO  DL2-TIME.
043300     MOVE SORT-QTY                TO  DL2-QTY.
043400     MOVE SORT-VALUE              TO  DL2-VALUE.
043500     MOVE SORT-UM                 TO  DL2-UM.
043600     MOVE SORT-BAL-QTY            TO  DL2-BAL-QTY.
043700
043800     WRITE PRT-REC FROM DETAIL-LINE-2 AFTER ADVANCING 1 LINES.
043900     ADD  1                       TO LINE-CTR.
044000
044100     PERFORM 890-READ-SORT-FILE.
044200
044300     IF LINE-CTR > 60
044400         PERFORM 890-NEW-PAGE
044500         IF SORT-MASTER-CLASS = SAVE-CLASS
044600         WRITE PRT-REC FROM HEADER-3      AFTER ADVANCING 2 LINES
044700         MOVE SAVE-CLASS          TO DL1-CLASS
044800         WRITE PRT-REC FROM DETAIL-LINE-1 AFTER ADVANCING 1 LINES
044900         WRITE PRT-REC FROM HEADER-4      AFTER ADVANCING 1 LINES
045000         ADD  4                   TO LINE-CTR.
045100
045200***************************************************************
045300**            P E R F O R M E D    R O U T I N E S           **
045400***************************************************************
045500 890-READ-SORT-FILE.
045600     RETURN SORT-FILE AT END
045700         MOVE "Y" TO SORT-EOF.
045800
045900 890-NEW-PAGE.
046000     WRITE PRT-REC FROM HEADER-1 AFTER ADVANCING NEW-PAGE.
046100     ADD  1                       TO PAGE-CTR.
046200     MOVE PAGE-CTR                TO H2-PAGE-NO.
046300     WRITE PRT-REC FROM HEADER-2 AFTER ADVANCING 1 LINES.
046400     MOVE 2                       TO LINE-CTR.
046500
046600 899-EXIT.
046700     EXIT.
046800
046900 900-ERROR SECTION.
047000
047100***************************************************************
047200**                     BLOWUP ROUTINE                        **
047300***************************************************************
047400 990-BLOWUP.
047500
047600     CALL "TBLOWUP" USING BASE, BU-PGM-NAME, STATUS-AREA,
047700           DUMMY-VIEW-AREA, FILE-STATUS, BU-DISPLAY-MSG,
047800           BU-DISPLAY-AREA.

       9999-DBGET2-MMATL-ACCUM-MC-I.
           MOVE 0 TO COND-WORD.
           READ MMATL-ACCUM-MC-I NEXT INTO BUF-MATLACUM
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS-1 = "1" OR FILE-STATUS = "46"
               MOVE 11 TO COND-WORD
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD.

       9999-INIT-MMATL-ACCUM-MC-I.
           MOVE SPACES TO MATLCODE OF MMATL-ACCUM-MC-REC-I.
           START MMATL-ACCUM-MC-I KEY >= MATLCODE OF
              MMATL-ACCUM-MC-REC-I
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.

       9999-DBFIND-DTRANS-MC-I.
           MOVE 0 TO COND-WORD.
           MOVE MATL-CODE-ARG TO MATLCODE OF DTRANS-MC-REC-I.
           START DTRANS-MC-I KEY = MATLCODE OF DTRANS-MC-REC-I
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF (FILE-STATUS NOT = "00") AND (FILE-STATUS-1 NOT = "2")
               MOVE 99 TO COND-WORD.

       9999-DBGET5-DTRANS-MC-I.
           MOVE 0 TO COND-WORD.
           READ DTRANS-MC-I NEXT INTO BUF-DTRANS
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   MOVE 15 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD
           ELSE
           IF MATLCODE OF DTRANS-MC-REC-I NOT = MATL-CODE-ARG
               MOVE 15 TO COND-WORD.

       9999-DBGET7-MPLTINFO-PK-I.
           MOVE 0 TO COND-WORD.
           MOVE PLT-ARG TO PLTINFOKEY OF MPLTINFO-PK-REC-I.
           READ MPLTINFO-PK-I INTO BUF-MPLTINFO
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS = "23"
               MOVE 17 TO COND-WORD
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD.

       9999-OPEN-STUFF.
           OPEN INPUT MMATL-ACCUM-MC-I     .
           OPEN INPUT DTRANS-MC-I          .
           OPEN INPUT MPLTINFO-PK-I        .

       9999-CLOSE-STUFF.
           CLOSE      MMATL-ACCUM-MC-I     .
           CLOSE      DTRANS-MC-I          .
           CLOSE      MPLTINFO-PK-I        .
