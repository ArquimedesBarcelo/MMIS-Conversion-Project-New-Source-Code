       IDENTIFICATION DIVISION.
       PROGRAM-ID.             TWOHALST.
       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.
       SOURCE-COMPUTER.        IBM-AS400.
       OBJECT-COMPUTER.        IBM-AS400.

       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT OUT-FILE
                  ASSIGN       TO DATABASE-OUTHALST
                  ORGANIZATION IS INDEXED
                  ACCESS MODE  IS DYNAMIC
                  RECORD KEY   IS OUT-KEY
                  FILE STATUS  IS FILE-STAT.

           SELECT PRINT-FILE
                  ASSIGN       TO PRINTER-QPRINT.

           SELECT SORT-FILE
                  ASSIGN       TO DISK-SORTFILE.

           SELECT WO-LAST-NUM-USED
                  ASSIGN       TO DATABASE-MCFPMM0800
                  ORGANIZATION IS RELATIVE
                  ACCESS MODE  IS RANDOM
                  RELATIVE KEY IS ARG-NO-9
                  FILE STATUS  IS FILE-STAT.

           SELECT WO-PLANNED-FILE
                ASSIGN         TO DATABASE-MCFLMM1102
                ORGANIZATION   IS INDEXED
                ACCESS MODE    IS DYNAMIC
                RECORD KEY     IS EXTERNALLY-DESCRIBED-KEY
                               WITH DUPLICATES
                FILE STATUS    IS FILE-STAT.

       DATA DIVISION.
       FILE SECTION.
       FD  OUT-FILE RECORD CONTAINS 66 CHARACTERS
           LABEL RECORD IS OMITTED
           DATA RECORD IS OUT-REC.
       01  OUT-REC.
           05  OUT-KEY                  PIC 9(4).
           05  OUT-DATA.
               10  OUT-ZONE             PIC X(04).
               10  OUT-PRTY             PIC X(02).
               10  OUT-WO-NUM           PIC X(10).
               10  OUT-DESC             PIC X(30).
               10  OUT-CODE             PIC X(02).
               10  OUT-TYPE             PIC XX.
               10  OUT-RECD.
                   15  O-RECD-YY        PIC XX.
                   15  O-RECD-MM        PIC XX.
                   15  O-RECD-DD        PIC XX.
               10  OUT-REQD.
                   15  O-REQD-YY        PIC XX.
                   15  O-REQD-MM        PIC XX.
                   15  O-REQD-DD        PIC XX.

       FD  PRINT-FILE RECORD CONTAINS 80 CHARACTERS
           LABEL RECORD IS OMITTED
           DATA RECORD IS PRINT-REC.
       01  PRINT-REC                    PIC X(80).

       SD  SORT-FILE RECORD CONTAINS 62 CHARACTERS
           DATA RECORD IS SORT-REC.
       01  SORT-REC.
           05  SORT-ZONE                PIC X(04).
           05  SORT-PRTY                PIC X(02).
           05  SORT-WO-NUM              PIC X(10).
           05  SORT-DESC                PIC X(30).
           05  SORT-CODE                PIC X(02).
           05  SORT-TYPE                PIC 9(02).
           05  SORT-RECD                PIC X(06).
           05  SORT-REQD                PIC X(06).

       FD  WO-LAST-NUM-USED
           LABEL RECORDS ARE STANDARD
           DATA RECORD IS WLNUREC.
       01  WLNUREC.
           COPY DDS-ALL-FORMATS OF MCFPMM0800.

       FD  WO-PLANNED-FILE
           LABEL RECORDS ARE STANDARD
           DATA RECORD IS WPFREC.
       01  WPFREC.
           COPY DDS-ALL-FORMATS OF MCFLMM1102.

       WORKING-STORAGE SECTION.
       77  ACT-KEY             PIC 9(4)   VALUE 0.
       77  EOF-SW              PIC S9     VALUE 0.
           88  EOF-SW-ON                  VALUE 1.
       77  LINE-C              PIC 9(5)   VALUE 59.
       77  PAGE-CNTR           PIC 9(5)   VALUE 0.
       77  PRTY-SAVE           PIC XX     VALUE SPACES.
       77  ZONE-SAVE           PIC XXXX   VALUE SPACES.
       77  ARG-NO              PIC XX     VALUE "HA".
       77  ARG-NO-9            PIC 9(9).
       77  D-PARM              PIC X.
       77  L-PARM              PIC X.

       01  FILE-STAT.
           05  FILE-STAT-1     PIC X.
           05  FILE-STAT-2     PIC X.

       01  CURR-DATE.
           05  YY-BUFF         PIC 99.
           05  MM-BUFF         PIC 99.
           05  DD-BUFF         PIC 99.

       01  GREG-DATE.
           05  G-CENT          PIC XX.
           05  G-YEAR          PIC XX.
           05  G-MONTH         PIC XX.
           05  G-DAY           PIC XX.

       01  JUL-SIGN            PIC S9(06).
       01  JUL-DATE            PIC  X(07).
       01  JULIAN-DATE         REDEFINES JUL-DATE
                               PIC  9(07).
       01  FILLER              REDEFINES JUL-DATE.
           05  J-YEAR          PIC 9999.
           05  J-DAY           PIC 999.

       01  TIME-BUFFER.
           05  CUR-TIME.
               10  CUR-HRS     PIC XX.
               10  CUR-MIN     PIC XX.
           05  CUR-SEC         PIC XX.

       01  HEADER-ONE.
           05  FILLER   PIC X(08)  VALUE "TWOHALST".
           05  FILLER   PIC X(11)  VALUE SPACES.
           05  FILLER   PIC X(13)  VALUE "PRINT DATE:  ".
           05  CDATE-H.
               10  CDH-M    PIC 99.
               10  FILLER   PIC X  VALUE "/".
               10  CDH-D    PIC 99.
               10  FILLER   PIC X  VALUE "/".
               10  CDH-Y    PIC 99.
           05  FILLER   PIC X(04)  VALUE SPACES.
           05  FILLER   PIC X(07)  VALUE "TIME:  ".
           05  TIME-H   PIC X(04).
           05  FILLER   PIC X(14)  VALUE "        PAGE: ".
           05  PAGE-H   PIC ZZZZ9  VALUE ZERO.
           05  FILLER   PIC X(06)   VALUE SPACES.

       01  HEADER-TWO.
           05  FILLER  PIC X(20)  VALUE "  'H A'   S T A T U ".
           05  FILLER  PIC X(20)  VALUE "S   W O R K O R D E ".
           05  FILLER  PIC X(20)  VALUE "R S   O V E R   1 5 ".
           05  FILLER  PIC X(20)  VALUE "  D A Y S   O L D   ".

       01  HEADER-THREE.
           05  FILLER  PIC X(19)  VALUE "ZONE  PR  WO NUMBER".
           05  FILLER  PIC X(13)  VALUE "  DESCRIPTION".
           05  FILLER  PIC X(21)  VALUE SPACES.
           05  FILLER  PIC X(27)  VALUE "CD  TP  DATE RECD DATE REQD".

       01  HEADER-DOTS.
           05  FILLER  PIC X(20)  VALUE "--------------------".
           05  FILLER  PIC X(20)  VALUE "--------------------".
           05  FILLER  PIC X(20)  VALUE "--------------------".
           05  FILLER  PIC X(20)  VALUE "--------------------".

       01  PRINT-BUFFER.
           05  P-ZONE          PIC XXXX.
           05  FILLER          PIC XX  VALUE SPACES.
           05  P-PRTY          PIC XX.
           05  FILLER          PIC XX  VALUE SPACES.
           05  P-WO-NUM        PIC X(10).
           05  FILLER          PIC X   VALUE SPACE.
           05  P-DESC          PIC X(30).
           05  FILLER          PIC XX  VALUE SPACES.
           05  P-CODE          PIC XX.
           05  FILLER          PIC XX  VALUE SPACES.
           05  P-TYPE          PIC XX.
           05  FILLER          PIC XX  VALUE SPACES.
           05  P-RECD-MM       PIC XX.
           05  FILLER          PIC X   VALUE "/".
           05  P-RECD-DD       PIC XX.
           05  FILLER          PIC X   VALUE "/".
           05  P-RECD-YY       PIC XX.
           05  FILLER          PIC XX  VALUE SPACES.
           05  P-REQD-MM       PIC XX.
           05  FILLER          PIC X   VALUE "/".
           05  P-REQD-DD       PIC XX.
           05  FILLER          PIC X   VALUE "/".
           05  P-REQD-YY       PIC XX.
           05  FILLER          PIC X   VALUE SPACE.

       01  WORKING-MSG.
           05  FILLER  PIC X(08) VALUE SPACES.
           05  FILLER  PIC X(19) VALUE "****  THERE ARE NO ".
           05  FILLER  PIC X(22) VALUE "'HA' STATUS WORKORDERS".
           05  FILLER  PIC X(23) VALUE " OVER 15 DAYS OLD  ****".
           05  FILLER  PIC X(08) VALUE SPACES.

       01  DBPARAMETERS.
           COPY DBPARMS        OF COPYLIB.

       01  LAST-WO-USED-WA.
           COPY MLASTWO        OF COPYLIB.

       01  WO-PLANNED-DATA.
           COPY DWOPLAN        OF COPYLIB.

       PROCEDURE DIVISION.
       BEGIN-PGM.
           CALL "CLOUTHA".
           PERFORM 1-HSK.
           PERFORM 6-MAIN.

       2-EOJ.
           CLOSE               PRINT-FILE.
           CLOSE               OUT-FILE.
           CLOSE               WO-LAST-NUM-USED.
           CLOSE               WO-PLANNED-FILE.
           GOBACK.

       1-HSK.
           OPEN OUTPUT         PRINT-FILE.
           OPEN I-O            OUT-FILE.
           OPEN INPUT          WO-LAST-NUM-USED.
           OPEN INPUT          WO-PLANNED-FILE.

           MOVE SPACES         TO SORT-REC.
           ACCEPT CURR-DATE    FROM DATE.
           MOVE YY-BUFF        TO CDH-Y.
           MOVE MM-BUFF        TO CDH-M.
           MOVE DD-BUFF        TO CDH-D.

           ACCEPT TIME-BUFFER  FROM TIME.
           MOVE CUR-TIME       TO TIME-H.

           MOVE 1              TO ARG-NO-9.
           READ WO-LAST-NUM-USED INTO LAST-WO-USED-WA
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
               MOVE 1          TO DATE-FLAG-SW.

       6-MAIN.
           SORT SORT-FILE      ASCENDING KEY
                               SORT-ZONE
                               SORT-PRTY
                               SORT-WO-NUM
               INPUT  PROCEDURE 7-SORT-IN
               OUTPUT PROCEDURE 8-SORT-OUT.

           PERFORM 6-PRINT-OUTPUT.

       6-PRINT-OUTPUT.
           MOVE 0              TO OUT-KEY.
           PERFORM 6-READ-FILE THRU 6-READ-FILE-EXIT
                               UNTIL EOF-SW-ON.

           IF OUT-KEY = 1
               PERFORM 6-HEADINGS
               MOVE WORKING-MSG TO PRINT-REC
               WRITE PRINT-REC AFTER ADVANCING 3
               MOVE SPACES     TO PRINT-REC
               WRITE PRINT-REC BEFORE ADVANCING 0 LINES
           ELSE
               MOVE SPACES     TO PRINT-REC
               WRITE PRINT-REC BEFORE ADVANCING 0 LINES.

       6-READ-FILE.
           ADD 1               TO OUT-KEY.
           IF OUT-KEY = 1
               READ OUT-FILE   FIRST
                   AT END      MOVE 1 TO EOF-SW
                   GO TO 6-READ-FILE-EXIT
           ELSE
           READ OUT-FILE       NEXT
               AT END          MOVE 1 TO EOF-SW
               GO TO 6-READ-FILE-EXIT.

           IF LINE-C IS LESS THAN 59
               NEXT SENTENCE
           ELSE PERFORM 6-HEADINGS.

           IF OUT-ZONE = ZONE-SAVE AND LINE-C NOT = 6
               MOVE SPACES     TO P-ZONE
           ELSE
               MOVE SPACES     TO PRINT-REC
               WRITE           PRINT-REC
               ADD 1           TO LINE-C
               MOVE OUT-ZONE   TO P-ZONE ZONE-SAVE.

           IF OUT-PRTY = PRTY-SAVE AND LINE-C NOT = 6
               MOVE SPACES     TO P-PRTY
           ELSE
               MOVE OUT-PRTY   TO P-PRTY PRTY-SAVE.

           MOVE OUT-WO-NUM     TO P-WO-NUM.
           MOVE OUT-DESC       TO P-DESC.
           MOVE OUT-CODE       TO P-CODE.
           MOVE OUT-TYPE       TO P-TYPE.
           MOVE O-RECD-MM      TO P-RECD-MM.
           MOVE O-RECD-DD      TO P-RECD-DD.
           MOVE O-RECD-YY      TO P-RECD-YY.
           MOVE O-REQD-YY      TO P-REQD-YY.
           MOVE O-REQD-MM      TO P-REQD-MM.
           MOVE O-REQD-DD      TO P-REQD-DD.

           MOVE PRINT-BUFFER   TO PRINT-REC.
           WRITE               PRINT-REC.
           ADD 1               TO LINE-C.

       6-READ-FILE-EXIT.       EXIT.

       6-HEADINGS.
           ADD 1               TO PAGE-CNTR.
           MOVE PAGE-CNTR      TO PAGE-H.
           MOVE HEADER-ONE     TO PRINT-REC.
           WRITE PRINT-REC     AFTER ADVANCING 0 LINES.
           MOVE SPACES         TO PRINT-REC.
           WRITE PRINT-REC.
           MOVE HEADER-TWO     TO PRINT-REC.
           WRITE PRINT-REC.
           MOVE HEADER-DOTS    TO PRINT-REC.
           WRITE PRINT-REC.
           MOVE HEADER-THREE   TO PRINT-REC.
           WRITE PRINT-REC.
           MOVE HEADER-DOTS    TO PRINT-REC.
           WRITE PRINT-REC.
           MOVE 6              TO LINE-C.

       7-SORT-IN.
           PERFORM 7-SORT-DBFIND THRU 7-SORT-DBFIND-EXIT.

       7-SORT-DBFIND.
           MOVE YY-BUFF        TO G-YEAR.
           MOVE MM-BUFF        TO G-MONTH.
           MOVE DD-BUFF        TO G-DAY.
           MOVE 20             TO G-CENT.
           IF G-YEAR > 70
               MOVE 19         TO G-CENT.

           MOVE SPACES         TO JUL-DATE D-PARM L-PARM.
           CALL "JULGREG"      USING
                               GREG-DATE
                               JUL-DATE
                               D-PARM
                               L-PARM.

           MOVE J-DAY          TO JUL-SIGN.
           SUBTRACT 15         FROM JUL-SIGN.
           PERFORM UNTIL       JUL-SIGN > 0
               ADD 365         TO JUL-SIGN
               SUBTRACT 1      FROM J-YEAR
           END-PERFORM.

           MOVE JUL-SIGN       TO J-DAY.
           MOVE SPACES         TO GREG-DATE.
           CALL "JULGREG"      USING
                               GREG-DATE
                               JUL-DATE
                               D-PARM
                               L-PARM.

           MOVE ARG-NO         TO WOSTATUS OF WPFREC.
           START WO-PLANNED-FILE KEY IS = EXTERNALLY-DESCRIBED-KEY
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
               GO TO 2-EOJ.

           PERFORM 7-SORT-DBGET THRU 7-SORT-DBGET-EXIT.

       7-SORT-DBFIND-EXIT.     EXIT.

       7-SORT-DBGET.
           READ WO-PLANNED-FILE NEXT INTO WO-PLANNED-DATA
               AT END          MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
               GO TO 7-SORT-DBGET-EXIT.

           IF WOSTATUS OF WPFREC NOT = ARG-NO
               GO TO 7-SORT-DBGET-EXIT.

           IF DATE-RECD-P-CN < GREG-DATE
               MOVE ZONE-P            TO SORT-ZONE
               MOVE PRIORITY-P        TO SORT-PRTY
               MOVE WO-NUM-PLANNED    TO SORT-WO-NUM
               MOVE DESCRIPTION-1-P   TO SORT-DESC
               MOVE APPROVAL-CODE-P   TO SORT-CODE
               MOVE WO-START-STATUS   TO SORT-TYPE
               MOVE DATE-RECD-P       TO SORT-RECD
               MOVE DATE-REQD         TO SORT-REQD
               RELEASE                SORT-REC.
               GO TO 7-SORT-DBGET.

       7-SORT-DBGET-EXIT.      EXIT.

       8-SORT-OUT.
           MOVE 0              TO ACT-KEY.
           PERFORM 8-SO-LOOP   THRU 8-SO-EXIT.

       8-SO-LOOP.
           RETURN SORT-FILE    AT END GO TO 8-SO-EXIT.
           ADD 1               TO ACT-KEY.
           MOVE ACT-KEY        TO OUT-KEY.
           MOVE SORT-REC       TO OUT-DATA.
           WRITE OUT-REC       INVALID KEY    GO TO 8-SO-EXIT.
           GO TO 8-SO-LOOP.

       8-SO-EXIT.              EXIT.

