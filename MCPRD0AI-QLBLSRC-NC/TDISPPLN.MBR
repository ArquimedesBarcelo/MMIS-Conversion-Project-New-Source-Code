       IDENTIFICATION DIVISION.
       PROGRAM-ID.    TDISPPLN.
       INSTALLATION.  GOODYEAR TIRE & RUBBER CO.
      *REMARKS.   THIS PROGRAM DISPLAYS A WORK ORDER;
      *                   SOFT KEY F1 CONTINUES AN EXISTING DISPLAY,
      *                   SOFT KEY F2 REQUESTS NEW WORK ORDER NUMBER,
      *               SOFT KEY F3 DISPLAYS PLANNED WORK ORDER,
      *               SOFT KEY F4 DISPLAYS MATERIALS USED,
      *               SOFT KEY F5 DISPLAYS MATERIALS ORDERED,
      *               SOFT KEY F6 DISPLAYS LABOR USED,
      *                   SOFT KEY F7 CAUSES SCREEN TO BE PRINTED,
      *                   SOFT KEY F8 EXITS PROGRAM.
      *          SUBROUTINES CALLED:
      *              TALWONO
      *              TSCRNPRT
      *              ****.
      *C
      *C 09/10/96  JEFF BUNGO
      *C   EXPAND DATE FIELDS FOR YEAR 2000 COMPLIANCE.
      *C   RECOMPILE TO PICK UP COPYLIB CHANGES.
      *C
       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.
       SOURCE-COMPUTER.    AS400.
       OBJECT-COMPUTER.    AS400.
       SPECIAL-NAMES. I-O-FEEDBACK IS I-O-FEEDBACK-AREA
                      LOCAL-DATA IS LOCAL-DATA-AREA.
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT DISPLAY-FILE
               ASSIGN TO WORKSTATION-ZDISPLAY-SI
               ORGANIZATION IS TRANSACTION
               ACCESS IS SEQUENTIAL
               FILE STATUS IS DSPLY-STATUS
               CONTROL-AREA IS WS-CONTROL.
           SELECT JOBFILE
               ASSIGN TO DATABASE-JOBFI
               ORGANIZATION IS INDEXED
               ACCESS MODE IS DYNAMIC
               RECORD KEY IS ACT-KEYJ
               FILE STATUS IS JOBF-STATUS.
           SELECT JOBPLAN-FILE
               ASSIGN TO DATABASE-MCFLMM1801
               ORGANIZATION IS INDEXED
               ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                   WITH DUPLICATES
               FILE STATUS IS JF-STATUS.
           SELECT LBRFILE
               ASSIGN TO DATABASE-LBRFI
               ORGANIZATION IS INDEXED
               ACCESS MODE IS DYNAMIC
               RECORD KEY IS ACT-KEYL
               FILE STATUS IS LBRF-STATUS.
           SELECT MATFILE
               ASSIGN TO DATABASE-MATFI
               ORGANIZATION IS INDEXED
               ACCESS MODE IS DYNAMIC
               RECORD KEY IS ACT-KEYM
               FILE STATUS IS MATF-STATUS.
           SELECT PERSONNEL-FILE
               ASSIGN TO DATABASE-MCFPMM0300
               ORGANIZATION IS SEQUENTIAL
               ACCESS IS SEQUENTIAL
               FILE STATUS IS PF-STATUS.
           SELECT WO-LABOR-FILE
               ASSIGN TO DATABASE-MCFLMM1301
               ORGANIZATION IS INDEXED
               ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                   WITH DUPLICATES
               FILE STATUS IS WLF-STATUS.
           SELECT WO-LAST-NUM-USED
               ASSIGN TO DATABASE-MCFPMM0800
               ORGANIZATION IS RELATIVE
               ACCESS MODE IS RANDOM
               RELATIVE KEY IS ARG-NO
               FILE STATUS IS WOLN-STATUS.
           SELECT WO-PARTS-FILE
               ASSIGN TO DATABASE-MCFLMM1201
               ORGANIZATION IS INDEXED
               ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                   WITH DUPLICATES
               FILE STATUS IS WPF-STATUS.
       DATA DIVISION.
       FILE SECTION.
       FD  DISPLAY-FILE
           LABEL RECORDS ARE OMITTED.
       01  DSPLY-REC                   PIC X(2000).
       FD  JOBFILE
           RECORD CONTAINS 90 CHARACTERS
           LABEL RECORD IS OMITTED
           DATA RECORD IS JOBREC.
       01  JOBREC.
           05  ACT-KEYJ                         PIC 9(4).
           05  JOBREC-REC                       PIC X(86).
       FD  JOBPLAN-FILE
           LABEL RECORD IS STANDARD
           DATA RECORD IS JOBPF.
       01  JOBPF.
           COPY DD-MCRPMM1800 OF MCFLMM1801.
       FD  LBRFILE
           RECORD CONTAINS 92 CHARACTERS
           LABEL RECORD IS OMITTED
           DATA RECORD IS LBRREC.
       01  LBRREC.
           05  ACT-KEYL                         PIC 9(4).
           05  LBRREC-REC                       PIC X(88).
       FD  MATFILE
           RECORD CONTAINS 840 CHARACTERS
           LABEL RECORD IS OMITTED
           DATA RECORD IS MATF.
       01  MATF.
           05  ACT-KEYM                         PIC 9(4).
           05  MATREC-REC                       PIC X(836).
       FD  PERSONNEL-FILE
           LABEL RECORDS ARE STANDARD
           DATA RECORD IS PFREC.
       01  PFREC.
           COPY DD-MCRPMM0300 OF MCFPMM0300.
       FD  WO-LABOR-FILE
           LABEL RECORDS ARE STANDARD
           DATA RECORD IS WOLABF.
       01  WOLABF.
           COPY DD-MCRPMM1300 OF MCFLMM1301.
       FD  WO-LAST-NUM-USED
           LABEL RECORDS ARE STANDARD
           DATA RECORD IS WLNU.
       01  WLNU.
           COPY DD-MCRPMM0800 OF MCFPMM0800.
       FD  WO-PARTS-FILE
           LABEL RECORDS ARE STANDARD
           DATA RECORD IS WOPARF.
       01  WOPARF.
           COPY DD-MCRPMM1200 OF MCFLMM1201.
