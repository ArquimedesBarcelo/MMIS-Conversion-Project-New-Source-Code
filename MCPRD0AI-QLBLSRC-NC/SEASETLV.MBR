000200 IDENTIFICATION DIVISION.
000300 PROGRAM-ID.          SEASETLV.
000400 AUTHOR.              C HILLES/JIM COFFMAN (MAINTAINER).
000500 DATE-WRITTEN.        7/1/87.
000600 DATE-COMPILED.
000700*INSTALLATION.        GOODYEAR TIRE AND RUBBER - AKRON.
000800*SECURITY.
000900*REMARKS.
001000*D   ELECTRONIC APPROVAL SYSTEM - LEVEL SETUP PROGRAM.
001100
001200
001300 ENVIRONMENT DIVISION.
001400 CONFIGURATION SECTION.
001500 SOURCE-COMPUTER.  HP-3000.
001600 OBJECT-COMPUTER.  HP-3000.
       SPECIAL-NAMES. I-O-FEEDBACK IS I-O-FEEDBACK-AREA.

       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT DISPLAY-FILE
                  ASSIGN TO WORKSTATION-ZEASETUP-SI
                  ORGANIZATION IS TRANSACTION
                  ACCESS IS SEQUENTIAL
                  FILE STATUS IS DISPLAY-STATUS
                  CONTROL-AREA IS WS-CONTROL.

           SELECT MLEVEL-O
                  ASSIGN TO DATABASE-MCFLCS4101
                  ORGANIZATION IS INDEXED
                    ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                  FILE STATUS IS FILE-STATUS.

           SELECT MPATH-O
                  ASSIGN TO DATABASE-MCFLCS3901
                  ORGANIZATION IS INDEXED
                    ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                  FILE STATUS IS FILE-STATUS.

           SELECT MEMPL-O
                  ASSIGN TO DATABASE-MCFLCS4201
                  ORGANIZATION IS INDEXED
                    ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                  FILE STATUS IS FILE-STATUS.

           SELECT DLEVEL-O
                  ASSIGN TO DATABASE-MCFLCS4301
                  ORGANIZATION IS INDEXED
                    ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                    WITH DUPLICATES
                  FILE STATUS IS FILE-STATUS.

           SELECT DPATHDEF-O
                  ASSIGN TO DATABASE-MCFLCS4001
                  ORGANIZATION IS INDEXED
                    ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                    WITH DUPLICATES
                  FILE STATUS IS FILE-STATUS.

001700 DATA DIVISION.
       FILE SECTION.
       FD  DISPLAY-FILE
           LABEL RECORDS ARE OMITTED.
       01  DISPLAY-REC        PIC X(1500).

       FD  MLEVEL-O
           LABEL RECORDS ARE STANDARD.
       01  MLEVEL-REC-O.
           COPY DDS-MCRPCS4100  OF MCFLCS4101.

       FD  MPATH-O
           LABEL RECORDS ARE STANDARD.
       01  MPATH-REC-O.
           COPY DDS-MCRPCS3900  OF MCFLCS3901.

       FD  MEMPL-O
           LABEL RECORDS ARE STANDARD.
       01  MEMPL-REC-O.
           COPY DDS-MCRPCS4200  OF MCFLCS4201.

       FD  DLEVEL-O
           LABEL RECORDS ARE STANDARD.
       01  DLEVEL-REC-O.
           COPY DDS-MCRPCS4300  OF MCFLCS4301.

       FD  DPATHDEF-O
           LABEL RECORDS ARE STANDARD.
       01  DPATHDEF-REC-O.
           COPY DDS-MCRPCS4000  OF MCFLCS4001.

001800
001900 WORKING-STORAGE SECTION.
002000
002100 77  MOD-DEL-FLAG                  PIC X(1).
002200 77  UPDATE-MPATH-FLAG             PIC X(1).
002300 77  SUB                           PIC S9(4) COMP-4.
