010000**                                                          **
010100**                  S C R E E N   D A T A                   **
010200**                                                          **
010300**************************************************************
010400
010500 01  DE-FIELDS.
010600     05  DE-LEVEL                  PIC X(2).
010700     05  DE-LEVEL-DESC             PIC X(36).
           05  DE-COMMAND-LINE-1         PIC X(79).
           05  DE-MESSAGE-LINE-1         PIC X(79).
010800
010900 01  DE-FIELDS-B.
011000     05  DE-OLD-LEVEL              PIC X(2).
011100     05  DE-NEW-LEVEL              PIC X(2).
           05  DE-COMMAND-LINE-2         PIC X(79).
           05  DE-MESSAGE-LINE-2         PIC X(79).
011200
011300**************************************************************
011400**                                                          **
011500**            L I N K A G E   S E C T I O N                 **
011600**                                                          **
011700**************************************************************
011800
011900 LINKAGE SECTION.
012000 01  BASE                      PIC X(10).
012100 01  MMIS-BASE                 PIC X(13).
012200
012300 COPY VCOMLINK   IN COPYLIB.
012400 COPY TSHWSUB2   IN COPYLIB.
012500 COPY LANGSUB    IN COPYLIB.
012600
012700 PROCEDURE DIVISION USING BASE
012800                          MMIS-BASE,
012900                          VIEW-COMAREA,
013000                          SRF-COMAREA,
013100                          LANGUAGE-PARMS.
013200
013300 1-HSK.
           OPEN I-O DISPLAY-FILE, MLEVEL-O, MPATH-O, MEMPL-O,
             DLEVEL-O, DPATHDEF-O.
013400     PERFORM 6000-MAIN THRU 6990-MAIN-X.
           CLOSE DISPLAY-FILE, MLEVEL-O, MPATH-O, MEMPL-O,
             DLEVEL-O, DPATHDEF-O.
013500     GOBACK.
013600
013700 2100-BLOWUP.
013800     MOVE "SEASETLV"               TO   BU-PGM-NAME.
013900     CALL "TBLOWUP" USING BASE BU-PGM-NAME STATUS-AREA
014000       VIEW-COMAREA FILE-STATUS BU-DISPLAY-MSG
014100       BU-DISPLAY-FLDS.
014200
016300 4015-SET-ERROR.
           MOVE B"1" TO IND (99).
           MOVE B"1" TO IND (FIELD-NUMBER).
           MOVE MESSAGE-BUFFER TO DE-MESSAGE-LINE-1, DE-MESSAGE-LINE-2.
051300
017000 4020-CLEAR-FORM.
017100     MOVE SPACES TO MESSAGE-BUFFER.
018300     MOVE SPACES                   TO   DE-FIELDS.
      *    MOVE "00"                     TO   DE-LEVEL.
018500
019300******************************************************************
019400**                                                              **
019500**          L E V E L   M A I N   M E N U                       **
019600**                                                              **
019700******************************************************************
019800 6000-MAIN.
019900     MOVE "EALEVMENU"              TO   VIEW-NFNAME.
020100     PERFORM 4020-CLEAR-FORM.
020200
020300*----- f1,f2,f3,f4,f8 APPL,f5 PRT SCR,f6,f7 INVALID,ENTER INVALID
020400     MOVE 0                        TO   SRF-KEYSET.
020500     MOVE "I"                      TO   SRF-FKEY (7).
020600     MOVE "P"                      TO   SRF-FKEY (5).
020700     MOVE "N"                      TO   SRF-ENTER-FLAG.
       6010-SHOWFORM.
           MOVE DE-FIELDS TO DISPLAY-REC.
           PERFORM 998-WRITE-SCREEN THRU 998-READ-SCREEN.
           MOVE DISPLAY-REC TO DE-FIELDS.
021300
021400     IF VIEW-LASTKEY = 3
021500         GO TO 6990-MAIN-X.
021600
021700     IF VIEW-LASTKEY = 1
021800         PERFORM 6300-ADD THRU 6390-A-X
021900     ELSE
022000     IF VIEW-LASTKEY = 2
022100         MOVE "M"                  TO   MOD-DEL-FLAG
022200         PERFORM 6500-MOD-DEL THRU 6590-MD-X
022300     ELSE
022400     IF VIEW-LASTKEY = 8
022500         MOVE "D"                  TO   MOD-DEL-FLAG
022600         PERFORM 6500-MOD-DEL THRU 6590-MD-X
022700     ELSE
022800     IF VIEW-LASTKEY = 4
022900         PERFORM 6600-LEVEL-INQUIRY THRU 6690-LI-X
023000     ELSE
023100     IF VIEW-LASTKEY = 6
023200         PERFORM 6700-MOVE-LEVEL THRU 6790-ML-X.
023300
023400
023500     GO TO 6000-MAIN.
023600
023700******************************************************************
023800**                                                              **
023900**       A D D   L E V E L                                      **
024000**                                                              **
024100******************************************************************
024200 6300-ADD.
024300     MOVE "EALEVADD"               TO   VIEW-NFNAME.
024500     PERFORM 4020-CLEAR-FORM.
024600
024700 6310-SHOW-ADD-FORM.
024800     MOVE 7                        TO   SRF-KEYSET.
       6310-SHOWFORM.
           MOVE DE-FIELDS TO DISPLAY-REC.
           PERFORM 998-WRITE-SCREEN THRU 998-READ-SCREEN.
           MOVE DISPLAY-REC TO DE-FIELDS.

025500     IF VIEW-LASTKEY = 3
025600         GO TO 6390-A-X.
025700
026000     MOVE DE-LEVEL                 TO   LEVEL-ARG.
026100     PERFORM 7000-GET-MLEVEL.
026200     IF FILE-STATUS = "00"
               PERFORM 7010-UNLOCK-MLEVEL
026300*        "E44: ENTRY ALREADY EXISTS"
026400         MOVE   5                  TO   LANG-SETNUM
026500         MOVE  44                  TO   LANG-MSGNUM
026600         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
026700         MOVE 1                    TO   FIELD-NUMBER
026800         PERFORM 4015-SET-ERROR
026900         GO TO 6310-SHOW-ADD-FORM.
027000
027100     PERFORM 7030-MOVE-TO-DB.
027200
027500*    CALL "DBPUT" USING BASE, DSET-MLEVEL, MODE1, STATUS-AREA,
027600*      ALL-ITEMS, BUF-MLEVEL.
           WRITE MLEVEL-REC-O FROM BUF-MLEVEL
               INVALID KEY MOVE 99 TO COND-WORD.
           IF FILE-STATUS NOT = "00"
027800         MOVE "DBPUT ERR MLEVEL 6110-SAF" TO BU-DISPLAY-MSG
027900         PERFORM 2100-BLOWUP.
028000
           PERFORM 4020-CLEAR-FORM.
028300     GO TO 6310-SHOW-ADD-FORM.
028400
028500 6390-A-X.
028600     EXIT.
028700
028800******************************************************************
028900**                                                              **
029000**      M O D I F Y / D E L E T E   L E V E L                   **
029100**                                                              **
029200******************************************************************
029300 6500-MOD-DEL.
029400*------- GET THE FATHER FORM FOR MODIFY OR DELETE
029500     IF MOD-DEL-FLAG = "M"
029600         MOVE "EALEVMOD"           TO   VIEW-NFNAME
029700     ELSE
029800         MOVE "EALEVDEL"           TO   VIEW-NFNAME.
030000
030100 6505-MOD-DEL-GETFORM-1.
030200*------- GET SON FORM FOR LEVEL NUMBER TO MODIFY ENTRY
030300     IF MOD-DEL-FLAG = "M"
030400         MOVE "EALEVMOD1"          TO   VIEW-NFNAME
030500     ELSE
030600         MOVE "EALEVDEL1"          TO   VIEW-NFNAME.
030800     PERFORM 4020-CLEAR-FORM.
030900
031000 6510-SHOW-MOD-FORM-1.
031100     MOVE 7                        TO   SRF-KEYSET.
       6510-SHOWFORM.
           MOVE DE-FIELDS TO DISPLAY-REC.
           PERFORM 998-WRITE-SCREEN THRU 998-READ-SCREEN.
           MOVE DISPLAY-REC TO DE-FIELDS.

031800     IF VIEW-LASTKEY = 3
031900         GO TO 6590-MD-X.
032000
032300     MOVE DE-LEVEL                 TO   LEVEL-ARG.
032400     PERFORM 7000-GET-MLEVEL.
032500     IF FILE-STATUS-1 = "2"
032600*        "E45: ENTRY DOES NOT EXIST"
032700         MOVE  5                   TO   LANG-SETNUM
032800         MOVE 45                   TO   LANG-MSGNUM
032900         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
033000         MOVE 1                    TO   FIELD-NUMBER
033100         PERFORM 4015-SET-ERROR
033200         GO TO 6510-SHOW-MOD-FORM-1.
033300
           PERFORM 7010-UNLOCK-MLEVEL.

033400*    CALL "DBFIND" USING BASE, DSET-DLEVEL, MODE1, STATUS-AREA,
033500*      LEVEL-SEARCH, LEVEL-ARG.
           MOVE 0 TO COND-WORD.
           MOVE LEVEL-ARG TO LEVELNUM OF DLEVEL-REC-O.
           START DLEVEL-O KEY = LEVELNUM OF DLEVEL-REC-O
               INVALID KEY MOVE 17 TO COND-WORD.
033600     IF (FILE-STATUS NOT = "00") AND (FILE-STATUS-1 NOT = "2")
033700         MOVE "DBFIND ERR DLEVEL 6010-SMF1" TO BU-DISPLAY-MSG
033800         PERFORM 2100-BLOWUP.
034000
034100     IF FILE-STATUS = "00" AND MOD-DEL-FLAG = "D"
      *------- DO A START > HIGH-VALUES TO UNLOCK
               MOVE HIGH-VALUES TO LEVELNUM OF DLEVEL-REC-O
               START DLEVEL-O KEY > LEVELNUM OF DLEVEL-REC-O
                   INVALID KEY MOVE "00" TO FILE-STATUS
               END-START
034200*        "C128: CANNOT DELETE - EMPLOYEE ID LINKED TO THIS ENTRY"
034300         MOVE   3                  TO   LANG-SETNUM
034400         MOVE 128                  TO   LANG-MSGNUM
034500         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
034600         MOVE 1                    TO   FIELD-NUMBER
034700         PERFORM 4015-SET-ERROR
034800         GO TO 6510-SHOW-MOD-FORM-1.
034900
035000     IF MOD-DEL-FLAG = "M"
035100         MOVE "EALEVMOD2"          TO   VIEW-NFNAME
035200     ELSE
035300         MOVE "EALEVDEL2"          TO   VIEW-NFNAME.
035500
035600     MOVE MLEVEL-LEVEL-NUM         TO   DE-LEVEL.
035700     MOVE MLEVEL-LEVEL-DESC        TO   DE-LEVEL-DESC.
035800
036000     IF MOD-DEL-FLAG = "D"
036100*        "P123: PRESS 'ENTER' TO DELETE OR 'f8' TO EXIT
036200         MOVE  16                  TO   LANG-SETNUM
036300         MOVE 123                  TO   LANG-MSGNUM
036400         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
036600
036700 6530-SHOW-MOD-FORM-2.
036800*----- f1 f2 f3 f6 INVALID, f4 REFRESH, f5 PRT, f7 CLR, f8 EXIT
036900     MOVE 7                        TO   SRF-KEYSET.
       6535-SHOWFORM.
           MOVE DE-FIELDS TO DISPLAY-REC.
           PERFORM 998-WRITE-SCREEN THRU 998-READ-SCREEN.
           MOVE DISPLAY-REC TO DE-FIELDS.

037600     IF VIEW-LASTKEY = 3
037700         PERFORM 4020-CLEAR-FORM
037800         GO TO 6505-MOD-DEL-GETFORM-1.
037900
           PERFORM 7000-GET-MLEVEL.

038200     PERFORM 7030-MOVE-TO-DB.
038300
038400     IF MOD-DEL-FLAG = "M"
038500*        CALL "DBUPDATE" USING BASE, DSET-MLEVEL, MODE1,
038600*          STATUS-AREA, ALL-ITEMS, BUF-MLEVEL
               REWRITE MLEVEL-REC-O FROM BUF-MLEVEL
                   INVALID KEY MOVE 99 TO COND-WORD
               END-REWRITE
               IF FILE-STATUS NOT = "00"
038800             MOVE "DBUPDATE ERR 6530-SFM2" TO BU-DISPLAY-MSG
038900             PERFORM 2100-BLOWUP
039000         ELSE
039100             NEXT SENTENCE
039200     ELSE
039300*        CALL "DBDELETE" USING BASE, DSET-MLEVEL, MODE1,
039400*          STATUS-AREA
               DELETE MLEVEL-O INVALID KEY
                   MOVE "2" TO FILE-STATUS-1
               END-DELETE
               IF FILE-STATUS NOT = "00"
039600             MOVE "DBDELETE ERR 6530-SFM2" TO BU-DISPLAY-MSG
039700             PERFORM 2100-BLOWUP.
039800
040100     GO TO 6505-MOD-DEL-GETFORM-1.
040200
040300 6590-MD-X.
040400     EXIT.
040500
040600 6600-LEVEL-INQUIRY.
040700     MOVE "FCSISINQ"               TO   CSF-NEW-FORMFILE-NAME.
040800     MOVE "N"                      TO   CSF-MODE.
040900     PERFORM 7150-CALL-CSWITCHF.
041000     IF CSF-OPENFORM-ERR-SW = "Y"
041100         GO TO 6690-LI-X.
041200
041300     CALL "SEALEVIQ" USING BASE, MMIS-BASE, VIEW-COMAREA,
041400       SRF-COMAREA, LANGUAGE-PARMS.
041500
041600     MOVE "O"                      TO   CSF-MODE.
041700     PERFORM 7150-CALL-CSWITCHF.
041800
041900 6690-LI-X.
042000     EXIT.
042100
042200 6700-MOVE-LEVEL.
042300     MOVE "EALEVMOVE"              TO   VIEW-NFNAME.
           MOVE "00"                     TO   DE-OLD-LEVEL,
                                              DE-NEW-LEVEL.
042600
042700 6710-SHOWFORM-MOVE.
042800     MOVE 7                        TO   SRF-KEYSET.
       6710-SHOWFORM.
           MOVE DE-FIELDS-B TO DISPLAY-REC.
           PERFORM 998-WRITE-SCREEN THRU 998-READ-SCREEN.
           MOVE DISPLAY-REC TO DE-FIELDS-B.

043400     IF VIEW-LASTKEY = 3
043500         GO TO 6790-ML-X.
043600
044300     MOVE DE-OLD-LEVEL             TO   LEVEL-ARG.
044400     PERFORM 7000-GET-MLEVEL.
044500     IF FILE-STATUS-1 = "2"
044600*        "ENTRY DOES NOT EXIST"
044700         MOVE   5 TO LANG-SETNUM
044800         MOVE  45 TO LANG-MSGNUM
044900         MOVE   1 TO FIELD-NUMBER
045000         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
045100         PERFORM 4015-SET-ERROR
045200         GO TO 6710-SHOWFORM-MOVE.
045300
           PERFORM 7010-UNLOCK-MLEVEL.

045400     MOVE DE-NEW-LEVEL             TO   LEVEL-ARG.
045500     PERFORM 7000-GET-MLEVEL.
045600     IF FILE-STATUS = "00"
               PERFORM 7010-UNLOCK-MLEVEL
045700*        "ENTRY ALREADY EXISTS"
045800         MOVE   5 TO LANG-SETNUM
045900         MOVE  44 TO LANG-MSGNUM
046000         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
046100         MOVE 2                    TO   FIELD-NUMBER
046200         PERFORM 4015-SET-ERROR
046300         GO TO 6710-SHOWFORM-MOVE.
046400
046500*------ COPY THE NEW LEVEL TO THE OLD LEVEL
046600     MOVE DE-NEW-LEVEL             TO   MLEVEL-LEVEL-NUM.
046800*    CALL "DBPUT" USING  BASE, DSET-MLEVEL, MODE1,
046900*      STATUS-AREA, ALL-ITEMS, BUF-MLEVEL.
           WRITE MLEVEL-REC-O FROM BUF-MLEVEL
               INVALID KEY MOVE 99 TO COND-WORD.
           IF FILE-STATUS NOT = "00"
047100         MOVE "DBPUT ERR  MLEVEL 6710-SM" TO BU-DISPLAY-MSG
047200         PERFORM 2100-BLOWUP.
047400
047500*------ CHANGE THE OLD TO THE NEW LEVEL IN EACH MPATH AND DPATHDEF
047600*------ ENTRY, AND MOVE EACH DLEVEL SEGMENT FROM THE OLD TO NEW
047700     MOVE DE-OLD-LEVEL             TO   OLD-LEVEL-ARG.
047800     MOVE DE-NEW-LEVEL             TO   NEW-LEVEL-ARG.
047900     PERFORM 7400-MOVE-LEVEL THRU 7490-ML-X.
048000
      *------- DO A START > HIGH-VALUES TO UNLOCK
           MOVE HIGH-VALUES TO PATHNUM OF MPATH-REC-O.
           START MPATH-O KEY > PATHNUM OF MPATH-REC-O
               INVALID KEY MOVE "00" TO FILE-STATUS.
           MOVE HIGH-VALUES TO PATHNUM OF DPATHDEF-REC-O.
           START DPATHDEF-O KEY > PATHNUM OF DPATHDEF-REC-O
               INVALID KEY MOVE "00" TO FILE-STATUS.

048100*------ FINALLY, DELETE THE OLD LEVEL
048300     MOVE DE-OLD-LEVEL             TO   LEVEL-ARG.
048400     PERFORM 7000-GET-MLEVEL.
048500*    CALL "DBDELETE" USING BASE, DSET-MLEVEL, MODE1,
048600*      STATUS-AREA.
           DELETE MLEVEL-O INVALID KEY MOVE "2" TO FILE-STATUS-1.
           IF FILE-STATUS NOT = "00"
048800         MOVE "DBDELETE ERR MLEV 6710-SM" TO BU-DISPLAY-MSG
048900         PERFORM 2100-BLOWUP.
049100
049200     GO TO 6700-MOVE-LEVEL.
049300
049400 6790-ML-X.
049500     EXIT.
049600
049700
049800 6990-MAIN-X.
049900     EXIT.
050000
050100******************************************************************
050200**                                                              **
050300**      P E R F O R M E D   R O U T I N E S                     **
050400**                                                              **
050500******************************************************************
050600 7000-GET-MLEVEL.
050700*    CALL "DBGET" USING BASE, DSET-MLEVEL, MODE7, STATUS-AREA,
050800*      ALL-ITEMS, BUF-MLEVEL, LEVEL-ARG.
           MOVE LEVEL-ARG TO LEVELNUM OF MLEVEL-REC-O.
           READ MLEVEL-O INTO BUF-MLEVEL
               INVALID KEY MOVE 17 TO COND-WORD.
050900     IF FILE-STATUS = "00" OR FILE-STATUS-1 = "2"
051000         NEXT SENTENCE
051100     ELSE
051200         MOVE "DBGET ERR 7000-GM" TO BU-DISPLAY-MSG
051300         PERFORM 2100-BLOWUP.
051400
       7010-UNLOCK-MLEVEL.
      *------- DO A START > HIGH-VALUES TO UNLOCK
           MOVE HIGH-VALUES TO LEVELNUM OF MLEVEL-REC-O.
           START MLEVEL-O KEY > LEVELNUM OF MLEVEL-REC-O
               INVALID KEY MOVE "00" TO FILE-STATUS.

052700 7030-MOVE-TO-DB.
           IF VIEW-NFNAME = "EALEVADD"
052800         MOVE SPACES               TO   BUF-MLEVEL
           ELSE
           MOVE SPACES                   TO   MLEVEL-LEVEL-NUM
                                              MLEVEL-LEVEL-DESC.
052900     MOVE DE-LEVEL                 TO   MLEVEL-LEVEL-NUM.
053000     MOVE DE-LEVEL-DESC            TO   MLEVEL-LEVEL-DESC.
053100
053200 7040-GET-MPATH.
053300*    CALL "DBGET" USING BASE, DSET-MPATH, MODE7, STATUS-AREA,
053400*      ALL-ITEMS, BUF-MPATH, PATH-ARG.
           MOVE PATH-ARG TO PATHNUM OF MPATH-REC-O.
           READ MPATH-O INTO BUF-MPATH
               INVALID KEY MOVE 17 TO COND-WORD.
053500     IF FILE-STATUS = "00" OR FILE-STATUS-1 = "2"
053600         NEXT SENTENCE
053700     ELSE
053800         MOVE "DBGET ERR 7040-GM" TO BU-DISPLAY-MSG
053900         PERFORM 2100-BLOWUP.
054000
055300 7150-CALL-CSWITCHF.
055400     CALL "CSWITCHF" USING VIEW-COMAREA, LANGUAGE-PARMS,
055500       FORMFILE, CSF-PARMS, BU-DISPLAY-MSG.
055600     IF BU-DISPLAY-MSG-1 NOT = SPACES
055700         PERFORM 2100-BLOWUP.
055800
055900 7400-MOVE-LEVEL.
056000     MOVE 0                        TO   PATH-ARG-NUMBER.
056100
056200 7410-MOVE-LEVEL-LOOP.
056300     IF PATH-ARG-NUMBER > 998
056400         GO TO 7450-MOVE-DLEVEL.
056500
056600     ADD 1                         TO   PATH-ARG-NUMBER.
056700     PERFORM 7040-GET-MPATH.
056800     IF FILE-STATUS-1 = "2"
056900         MOVE 999                  TO   PATH-ARG-NUMBER
057000         PERFORM 7040-GET-MPATH
057100         IF FILE-STATUS-1 = "2"
057200             GO TO 7450-MOVE-DLEVEL.
057300
057400     MOVE "N"                      TO   UPDATE-MPATH-FLAG.
057500     MOVE 0                        TO   SUB.
057600     PERFORM 7500-MOVE-LEVELS 12 TIMES.
057700     IF UPDATE-MPATH-FLAG = "Y"
058000*        CALL "DBUPDATE" USING BASE, DSET-MPATH, MODE1,
058100*          STATUS-AREA, ALL-ITEMS, BUF-MPATH.
               REWRITE MPATH-REC-O FROM BUF-MPATH
                   INVALID KEY MOVE 99 TO COND-WORD
               END-REWRITE
               IF FILE-STATUS = "00"
058300             NEXT SENTENCE
058400         ELSE
058500         IF COND-WORD NOT = 0
058600             MOVE "DBUPDATE ERR MPATH"  TO   BU-DISPLAY-MSG
058700             PERFORM 2100-BLOWUP.
058800
058900*------ THE LEVEL COULD BE IN DPATHDEF, WHERE IT IS SPECIFIED IN
059000*------ THE PATH 999
059100     MOVE MPATH-PATH-NUMBER        TO   PATH-ARG.
059200*    CALL "DBFIND" USING BASE, DSET-DPATHDEF, MODE1,
05930 *      STATUS-AREA, PATH-SEARCH, PATH-ARG.
           MOVE PATH-ARG TO PATHNUM OF DPATHDEF-REC-O.
           START DPATHDEF-O KEY = PATHNUM OF DPATHDEF-REC-O
               INVALID KEY MOVE 17 TO COND-WORD.
033600     IF (FILE-STATUS NOT = "00") AND (FILE-STATUS-1 NOT = "2")
059500         MOVE "DBFIND ERR DPATHDF" TO BU-DISPLAY-MSG
059600         PERFORM 2100-BLOWUP.
059700
059800 7420-DPATHDEF-LOOP.
059900*    CALL "DBGET" USING BASE, DSET-DPATHDEF, MODE5,
060000*      STATUS-AREA, ALL-ITEMS, BUF-DPATHDEF, PATH-ARG.
           MOVE 0 TO COND-WORD.
           READ DPATHDEF-O NEXT INTO BUF-DPATHDEF
               AT END MOVE 15 TO COND-WORD.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   MOVE 15 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.
           IF PATHNUM OF DPATHDEF-REC-O NOT = PATH-ARG
               MOVE 15 TO COND-WORD.
060100     IF END-OF-CHAIN
060200         GO TO 7410-MOVE-LEVEL-LOOP
060300     ELSE
060400     IF NOT GOOD-CALL
060500         MOVE "DBGET ERR DPATHD 7420-DL" TO BU-DISPLAY-MSG
060600         PERFORM 2100-BLOWUP.
060700
060800     IF DPATHD-LEVEL = OLD-LEVEL-ARG
060900         MOVE NEW-LEVEL-ARG        TO   DPATHD-LEVEL
061200*        CALL "DBUPDATE" USING BASE, DSET-DPATHDEF, MODE1,
061300*          STATUS-AREA, ALL-ITEMS, BUF-DPATHDEF.
               REWRITE DPATHDEF-REC-O FROM BUF-DPATHDEF
                   INVALID KEY MOVE 99 TO COND-WORD
               END-REWRITE
               IF FILE-STATUS NOT = "00"
061500             MOVE "DBUPDATE ERR DPATHDEF"  TO   BU-DISPLAY-MSG
061600             PERFORM 2100-BLOWUP.
061900
062000     GO TO 7420-DPATHDEF-LOOP.
062100
062200 7450-MOVE-DLEVEL.
062300*    CALL "DBFIND" USING BASE, DSET-DLEVEL, MODE1,
062400*      STATUS-AREA, LEVEL-SEARCH, OLD-LEVEL-ARG.
           MOVE OLD-LEVEL-ARG TO LEVELNUM OF DLEVEL-REC-O.
           START DLEVEL-O KEY = LEVELNUM OF DLEVEL-REC-O
               INVALID KEY MOVE 17 TO COND-WORD.
           IF (FILE-STATUS NOT = "00") AND (FILE-STATUS-1 NOT = "2")
062600         MOVE "DBFIND ERR DLEVEL" TO BU-DISPLAY-MSG
062700         PERFORM 2100-BLOWUP.
062800
062900*    CALL "DBGET" USING BASE, DSET-DLEVEL, MODE5,
063000*      STATUS-AREA, ALL-ITEMS, BUF-DLEVEL, OLD-LEVEL-ARG.
           MOVE 0 TO COND-WORD.
           READ DLEVEL-O NEXT INTO BUF-DLEVEL
               AT END MOVE 15 TO COND-WORD.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   MOVE 15 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.
           IF LEVELNUM OF DLEVEL-REC-O NOT = OLD-LEVEL-ARG
               MOVE 15 TO COND-WORD.
063100     IF END-OF-CHAIN
063200         GO TO 7490-ML-X
063300     ELSE
063400     IF NOT GOOD-CALL
063500         MOVE "DBGET ERR DLEVEL 7450-MD" TO BU-DISPLAY-MSG
063600         PERFORM 2100-BLOWUP.
064000
064100*    CALL "DBDELETE" USING BASE, DSET-DLEVEL, MODE1,
064200*      STATUS-AREA.
           DELETE DLEVEL-O INVALID KEY MOVE "2" TO FILE-STATUS-1.
           IF FILE-STATUS NOT = "00"
064400         MOVE "DBDELTE ERR DLEVEL 7450-MD" TO BU-DISPLAY-MSG
064500         PERFORM 2100-BLOWUP.
064600
064700     MOVE NEW-LEVEL-ARG            TO   DLEVEL-LEVEL-NUM.
064800*    CALL "DBPUT" USING  BASE, DSET-DLEVEL, MODE1,
064900*      STATUS-AREA, ALL-ITEMS, BUF-DLEVEL.
           WRITE DLEVEL-REC-O FROM BUF-DLEVEL
               INVALID KEY MOVE 99 TO COND-WORD.
           IF FILE-STATUS NOT = "00"
065100         MOVE "DBPUT ERR DLEVEL 7450-MD" TO BU-DISPLAY-MSG
065200         PERFORM 2100-BLOWUP.
065400
065500*------ NOW GET THE EMPLOYEE AND CHANGE HIS LEVEL TO THE
065600*------ NEW ONE.
065700     MOVE DLEVEL-EMPL              TO   EMPL-ARG.
066000*    CALL "DBGET" USING BASE, DSET-MEMPL, MODE7,
066100*      STATUS-AREA, ALL-ITEMS, BUF-MEMPL, EMPL-ARG.
           MOVE EMPL-ARG TO EMPLOYID OF MEMPL-REC-O.
           READ MEMPL-O INTO BUF-MEMPL
               INVALID KEY MOVE 17 TO COND-WORD.
066200     IF FILE-STATUS-1 = "2"
066400         GO TO 7450-MOVE-DLEVEL
066500     ELSE
066600     IF FILE-STATUS NOT = "00"
066700         MOVE "DBGET ERR MEMPL 7450-MD" TO BU-DISPLAY-MSG
066800         PERFORM 2100-BLOWUP.
066900
067000     MOVE NEW-LEVEL-ARG            TO   MEMPL-LEVEL.
067100*    CALL "DBUPDATE" USING BASE, DSET-MEMPL, MODE1,
067200*      STATUS-AREA, ALL-ITEMS, BUF-MEMPL.
           REWRITE MEMPL-REC-O FROM BUF-MEMPL
               INVALID KEY MOVE 99 TO COND-WORD.
           IF FILE-STATUS NOT = "00"
067400         MOVE "DUPDATE ERR MEMPL 7450-MD" TO BU-DISPLAY-MSG
067500         PERFORM 2100-BLOWUP.
067900
068000     GO TO 7450-MOVE-DLEVEL.
068100
068200 7490-ML-X.
068300     EXIT.
068400
068500 7500-MOVE-LEVELS.
068600     ADD 1                         TO   SUB.
068700     IF MPATH-LEVEL (SUB) = OLD-LEVEL-ARG
068800         MOVE "Y"                  TO   UPDATE-MPATH-FLAG
068900         MOVE NEW-LEVEL-ARG        TO   MPATH-LEVEL (SUB)
069000*        *** NOTE: MLEVEL WAS GOT IN EDITS AFTER DATA ENTRY
069100         MOVE MLEVEL-ACTIVE-EMPL   TO   MPATH-EMPL (SUB).
069200
069300
       COPY DISPCALL IN COPYLIB.
069400 999-CATREAD.
           IF CATREAD-MSG-NUMBER = ZEROS
               MOVE LANG-SETNUM TO CATREAD-MSG-SET
               MOVE LANG-MSGNUM TO CATREAD-MSG-NUM.
           CALL "CCATREAD" USING CATREAD-PARMS.
           MOVE CATREAD-MSG-TEXT TO MESSAGE-BUFFER.
071000 999-CATREAD-EXIT.
071100     EXIT.
