       01  FILE-STATUS.
           05  FILE-STATUS-1            PIC X  VALUE "0".
           05  FILE-STATUS-2            PIC X  VALUE "0".
005900
006000 COPY DBSTAT     IN COPYLIB.
006100 01  DSET-NAMES.
006200     05  DSET-NAME                 PIC X(16).
006300     05  DSET-MLEVEL               PIC X(16) VALUE "MLEVEL;".
006400     05  DSET-DLEVEL               PIC X(16) VALUE "DLEVEL;".
006500     05  DSET-MPATH                PIC X(16) VALUE "MPATH;".
006600     05  DSET-DPATHDEF             PIC X(16) VALUE "DPATHDEF;".
006700     05  DSET-MEMPL                PIC X(16) VALUE "MEMPL;".
006800
006900 01  MODE-AREA.
007000     05  MODE1                     PIC S9(4)   COMP       VALUE 1.
007100     05  MODE3                     PIC S9(4)   COMP       VALUE 3.
007200     05  MODE5                     PIC S9(4)   COMP       VALUE 5.
007300     05  MODE7                     PIC S9(4)   COMP       VALUE 7.
007400
007500 01  ALL-ITEMS                     PIC X(2)  VALUE "@;".
007600 01  LEVEL-SEARCH                  PIC X(10) VALUE "LEVEL-NUM;".
007700 01  PATH-SEARCH                   PIC X(9)  VALUE "PATH-NUM;".
007800 01  EMPL-SEARCH                   PIC X(16) VALUE "EMPLOYEE-ID;".
007900 01  LEVEL-ARG                     PIC X(2).
008000 01  EMPL-ARG                      PIC X(4).
008100 01  OLD-LEVEL-ARG                 PIC X(2).
008200 01  NEW-LEVEL-ARG                 PIC X(2).
008300 01  PATH-ARG.
008400     05  PATH-ARG-PREFIX           PIC X(1)  VALUE "R".
008500     05  PATH-ARG-NUMBER           PIC 9(3).
