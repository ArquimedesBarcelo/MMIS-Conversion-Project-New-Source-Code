017500*************************************************************
017600*************************************************************
017700*                     PROCEDURE DIVISION                    *
017800*        DISPLAY THE SCREEN REQUESTING BUYER CODE,          *
017900*     VENDOR CODES, CORPORATE CODES AND QUANTITIES.         *
018000*     PRINT A QUOTE SHEET FOR EACH VENDOR ENTERED.          *
018100*     UPDATE THE MPLTINFO DATASET WITH A NEW QUOTE          *
018200*     NUMBER.  CLEAR THE SCREEN OF OLD DATA AND START       *
018300*     AGAIN.                                                *
018400*************************************************************
018500*************************************************************
018600 PROCEDURE DIVISION.
018700 00-MAIN.
018800*----------  OPEN FILES AND TERMINAL
018900 010-OPEN-FILES.
           OPEN I-O DISPLAY-FILE.
           OPEN I-O DVENDOR-O.
           OPEN INPUT DVENDOR-I.
018910     CALL "TESCSEQ" USING ESC-NAME.
020700
021100     CALL "TSPLPRT" USING SP-RET-CODE, SP-AREA.
021200     IF SP-RET-CODE = "NF"
021300         MOVE "SPOOL KEY NOT FOUND * RCVEXEC" TO BU-DISPLAY-MSG
021400         PERFORM 990-BLOWUP THRU 999-EXIT
021500     ELSE
021600     IF SP-RET-CODE NOT = "00"
021700         MOVE "TSPLPRT ERROR * RCVEXEC" TO BU-DISPLAY-MSG
021800         PERFORM 990-BLOWUP THRU 999-EXIT.
021900
022000*----------  PERFORM MAIN PROCESSING
022100     PERFORM 050-SHOW-MAIN-SCREEN THRU 059-EXIT.
022200
022300 015-CLOSE-FILES.
022400*----------  CLOSE FILES
022500     CLOSE DISPLAY-FILE, DVENDOR-O, DVENDOR-I.
023100     GOBACK.
023300*************************************************************
023400*************************************************************
023500*         DISPLAY SCREEN AND ALLOW USER TO ENTER DATA       *
023600*************************************************************
023700*************************************************************
023800 050-SHOW-MAIN-SCREEN.
023900     MOVE FORM-MENU                TO VIEW-NFNAME.
025300
025400 055-SHOW-FORM.
           MOVE SPACES TO DISPLAY-REC.
           WRITE DISPLAY-REC FORMAT IS VIEW-NFNAME
              INDIC ARE SRF-INDICATORS.
           MOVE ALL B"0" TO SRF-INDICATORS.

           READ  DISPLAY-FILE FORMAT IS VIEW-NFNAME
               INDIC ARE SRF-INDICATORS.
           ACCEPT IOFEEDBACK FROM I-O-FEEDBACK-AREA.
           MOVE ALL B"0" TO SRF-INDICATORS.

      *------ A BAD STATUS MAY MEAN USER TURNED OFF TERMINAL.
      *------ IF SO, SIMULATE THE F3 KEY TO EXIT PROGRAM.
           IF DISPLAY-STATUS NOT = "00"
               MOVE 3 TO VIEW-LASTKEY
           ELSE
               MOVE FUNCTION-NUM TO VIEW-LASTKEY.
035800
026600     IF VIEW-LASTKEY = 1
026700         GO TO 100-ADD-ROUTINE.
026800
026900     IF VIEW-LASTKEY = 2
027000        GO TO 200-DELETE-ROUTINE.
027100
027200     IF VIEW-LASTKEY = 8
027300        GO TO 300-REPORT-ROUTINE.
028400     IF VIEW-LASTKEY EQUAL 3
028500         GO TO 015-CLOSE-FILES.
028600
028700     IF VIEW-LASTKEY EQUAL 4  OR
028800        VIEW-LASTKEY EQUAL 6 OR
028900        VIEW-LASTKEY EQUAL 7
029200         PERFORM  940-VSETERROR THRU 949-EXIT
029300         GO TO  055-SHOW-FORM.
029400 059-EXIT.  EXIT.
029600*************************************************************
029700*************************************************************
029800*                     ADD ROUTINE                           *
029900
030000 100-ADD-ROUTINE.
030100     MOVE SPACES TO SCREEN-ADD.
030200     MOVE FORM-ADD TO VIEW-NFNAME.
031600
031700 105-SHOW-FORM.
           MOVE SCREEN-ADD TO DISPLAY-REC.
           WRITE DISPLAY-REC FORMAT IS VIEW-NFNAME
              INDIC ARE SRF-INDICATORS.
           MOVE ALL B"0" TO SRF-INDICATORS.

           READ  DISPLAY-FILE FORMAT IS VIEW-NFNAME
               INDIC ARE SRF-INDICATORS.
           ACCEPT IOFEEDBACK FROM I-O-FEEDBACK-AREA.
           MOVE ALL B"0" TO SRF-INDICATORS.
           MOVE DISPLAY-REC TO SCREEN-ADD.

      *------ A BAD STATUS MAY MEAN USER TURNED OFF TERMINAL.
      *------ IF SO, SIMULATE THE F3 KEY TO EXIT PROGRAM.
           IF DISPLAY-STATUS NOT = "00"
               MOVE 3 TO VIEW-LASTKEY
           ELSE
               MOVE FUNCTION-NUM TO VIEW-LASTKEY.
032700
032800     MOVE VIEW-LASTKEY TO SAVE-KEY.
032900
034400
034500     IF VIEW-LASTKEY EQUAL 8
034600        GO TO 200-DELETE-ROUTINE.
034700
034800     IF VIEW-LASTKEY EQUAL 4
034900        GO TO 300-REPORT-ROUTINE.
035000
035100     IF VIEW-LASTKEY = 7
035200        GO TO 050-SHOW-MAIN-SCREEN.
035300
035400     IF VIEW-LASTKEY EQUAL 3
035500         GO TO 015-CLOSE-FILES.
035600
035700     IF VIEW-LASTKEY EQUAL 6
036000         PERFORM  940-VSETERROR THRU 949-EXIT
036100         GO TO  105-SHOW-FORM.
038300     MOVE 1 TO I.
038400
038500*----------  READ ENTIRE SCREEN.  SKIP ANY BLANKS AND IGNORE ANY
038600*            DUPLICATE CODES.
038700 105-READ-SCREEN.
038800     IF SCREEN-ADD-VENDOR (I) = SPACES
038900        GO TO 150-CHECK-IF-DONE.
039000
039100     MOVE SCREEN-ADD-VENDOR (I) TO VEN-NUMBER.
039200     MOVE VEN-WORK              TO CODE-ARG.
040000
040100*----------  CHECK IF PAY FLAG IS ALREADY SET
           MOVE 0 TO COND-WORD.
           MOVE CODE-ARG TO VENCDE OF DVENDOR-REC-I.
           START DVENDOR-I KEY > VENCDE OF DVENDOR-REC-I
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
                   MOVE 17 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.
040310     IF NO-ENTRY
040320        GO TO 150-CHECK-IF-DONE.
040400     IF NOT GOOD-CALL
040500        MOVE "DBFIND DVENDOR 105 TVENRCV" TO BU-DISPLAY-MSG
040600        PERFORM 990-BLOWUP THRU 999-EXIT.
040900*    CALL "DBGET" USING BASE, DVENDOR, MODE6, STATUS-AREA,
041000*                       ALL-ITEM-LIST, BUF-DVENDOR, CODE-ARG.
           MOVE 0 TO COND-WORD.
           READ DVENDOR-I PRIOR INTO BUF-DVENDOR
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   MOVE 15 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.
           IF VENCDE OF DVENDOR-REC-I NOT = CODE-ARG
               MOVE 15 TO COND-WORD.
041100     IF GOOD-CALL
041200        IF VEN-ITM-NO = 99
041300           MOVE "VENDOR IS ALREADY MARKED TO BE PAID"
041400                  TO MESSAGE-BUFFER
041500           MOVE I TO FIELD-NUMBER
041600           PERFORM 940-VSETERROR THRU 949-EXIT
041700           GO TO 105-SHOW-FORM
041800        ELSE
041900           GO TO 150-CHECK-IF-DONE.
042000
042700 150-CHECK-IF-DONE.
042800     ADD 1 TO I.
042900     IF I > 50
043000        MOVE 1 TO I
043100        GO TO 155-ADD-CODES
043200     ELSE
043300        GO TO 105-READ-SCREEN.
043400
043500 155-ADD-CODES.
043600     IF SCREEN-ADD-VENDOR (I) = SPACES
043700        GO TO 157-CHECK-IF-DONE.
043800     MOVE SCREEN-ADD-VENDOR (I) TO VEN-NUMBER.
043900     MOVE VEN-WORK              TO VEN-VEN-CODE.
044000     MOVE SPACES TO VEN-ITM-DATA.
044100     MOVE "X" TO VEN-RCV-PAY.
044200     CALL "TDATECHK" USING DATE-CHECK-AREA.
044210     MOVE DATE-YMD-OUT TO VEN-DATE-ADDED.
044300     MOVE 99 TO VEN-ITM-NO.
           MOVE 0 TO COND-WORD.
           WRITE DVENDOR-REC-O FROM BUF-DVENDOR
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD.
045000     IF NOT GOOD-CALL
045100        MOVE "DBPUT 155 TVENRCV" TO BU-DISPLAY-MSG
045200        PERFORM 990-BLOWUP THRU 999-EXIT.
045300
      *------- DO A START > HIGH-VALUES TO UNLOCK
           MOVE HIGH-VALUES TO VENCDE OF DVENDOR-REC-O.
           START DVENDOR-O KEY > VENCDE OF DVENDOR-REC-O
               INVALID KEY MOVE "00" TO FILE-STATUS.
045800 157-CHECK-IF-DONE.
045900     ADD 1 TO I.
046000     IF I > 50
046100        GO TO 160-CHECK-FUNCTION-KEY
046200     ELSE
046300        GO TO 155-ADD-CODES.
046400
046500
046600*----------  KEY 2=PROCESS AND CONTINUE.  LET KEY 1 AND 'ENTER'
046700*            KEY PROCESS AND GO BACK TO MAIN SCREEN.
046800 160-CHECK-FUNCTION-KEY.
046900     IF SAVE-KEY = 2
047000        GO TO 100-ADD-ROUTINE.
047100
047200     GO TO 050-SHOW-MAIN-SCREEN.
047600
047700 200-DELETE-ROUTINE.
047800     MOVE SPACES TO SCREEN-DELETE.
047900     MOVE FORM-DELETE TO VIEW-NFNAME.
049300
049400     MOVE "ENTER CODES TO DELETE FROM PAY FILE AND PRESS ENTER"
049500             TO SCREEN-DEL-MSG.
050200
050300 205-SHOW-FORM.
052500
           MOVE SCREEN-DELETE TO DISPLAY-REC.
           WRITE DISPLAY-REC FORMAT IS VIEW-NFNAME
              INDIC ARE SRF-INDICATORS.
           MOVE ALL B"0" TO SRF-INDICATORS.

           READ  DISPLAY-FILE FORMAT IS VIEW-NFNAME
               INDIC ARE SRF-INDICATORS.
           ACCEPT IOFEEDBACK FROM I-O-FEEDBACK-AREA.
           MOVE ALL B"0" TO SRF-INDICATORS.
           MOVE DISPLAY-REC TO SCREEN-DELETE.

      *------ A BAD STATUS MAY MEAN USER TURNED OFF TERMINAL.
      *------ IF SO, SIMULATE THE F3 KEY TO EXIT PROGRAM.
           IF DISPLAY-STATUS NOT = "00"
               MOVE 3 TO VIEW-LASTKEY
           ELSE
               MOVE FUNCTION-NUM TO VIEW-LASTKEY.
032700
052600     IF VIEW-LASTKEY EQUAL 8
052700        GO TO 100-ADD-ROUTINE.
052800
052900     IF VIEW-LASTKEY EQUAL 4
053000        GO TO 300-REPORT-ROUTINE.
053100
053200     IF VIEW-LASTKEY = 7
053300        GO TO 050-SHOW-MAIN-SCREEN.
053400
053500     IF VIEW-LASTKEY EQUAL 3
053600         GO TO 015-CLOSE-FILES.
053700
053800     IF VIEW-LASTKEY EQUAL 6
054100         PERFORM  940-VSETERROR THRU 949-EXIT
054200         GO TO  205-SHOW-FORM.
056710
056720*----------  CHECK IF ANY CODES WERE ENTERED
056730     IF SCREEN-CHECK-AREA = SPACES
056740        GO TO 205-SHOW-FORM.
056750
056800     MOVE 1 TO I.
056900
057000*----------  FIRST CHECK THE 10 INDIVIDUAL VENDORS FOR ANY
057100*            NONEXISTENT CODES.
057200 210-READ-INDIVIDUAL-CODES.
057300     IF SCREEN-DEL-CODE (I) = SPACES
057400        GO TO 215-CHECK-IF-DONE.
057500
057600*----------  CHECK IF THE ENTRY IS THERE TO DELETE
057700     MOVE SCREEN-DEL-CODE (I) TO VEN-NUMBER.
057710     MOVE VEN-WORK            TO CODE-ARG.
           MOVE 0 TO COND-WORD.
           MOVE CODE-ARG TO VENCDE OF DVENDOR-REC-I.
           START DVENDOR-I KEY > VENCDE OF DVENDOR-REC-I
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
                   MOVE 17 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.
058500     IF NO-ENTRY
058600        MOVE "VENDOR DOES NOT EXIST IN PAY FILE" TO MESSAGE-BUFFER
058700        COMPUTE FIELD-NUMBER = 2 * I - 1
058800        PERFORM 940-VSETERROR THRU 949-EXIT
058900        GO TO 205-SHOW-FORM.
059000     IF NOT GOOD-CALL
059100        MOVE "DBFIND DVENDOR 210 TVENRCV" TO BU-DISPLAY-MSG
059200        PERFORM 990-BLOWUP THRU 999-EXIT.
           MOVE 0 TO COND-WORD.
           READ DVENDOR-I PRIOR INTO BUF-DVENDOR
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   MOVE 15 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.
           IF VENCDE OF DVENDOR-REC-I NOT = CODE-ARG
               MOVE 15 TO COND-WORD.
059500     IF GOOD-CALL
059600        IF VEN-ITM-NO = 99
059700           NEXT SENTENCE
059800        ELSE
059900        COMPUTE FIELD-NUMBER = 2 * I - 1
060000           MOVE "VENDOR DOES NOT EXIST IN PAY FILE"
060100                    TO MESSAGE-BUFFER
060200           PERFORM 940-VSETERROR THRU 949-EXIT
060300           GO TO 205-SHOW-FORM.
060400     IF NOT GOOD-CALL
059900        COMPUTE FIELD-NUMBER = 2 * I - 1
060000           MOVE "VENDOR DOES NOT EXIST IN PAY FILE"
060100                    TO MESSAGE-BUFFER
060200           PERFORM 940-VSETERROR THRU 949-EXIT
060300           GO TO 205-SHOW-FORM.
060700
060800*----------  GET VENDOR NAME
           MOVE 0 TO COND-WORD.
           MOVE CODE-ARG TO VENCDE OF DVENDOR-REC-I.
           START DVENDOR-I KEY = VENCDE OF DVENDOR-REC-I
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
                   MOVE 17 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.
061100     IF NOT GOOD-CALL
061200        MOVE "DBFIND2 DVENDOR 215 TVENRCV" TO BU-DISPLAY-MSG
061300        PERFORM 990-BLOWUP THRU 999-EXIT.
           MOVE 0 TO COND-WORD.
           READ DVENDOR-I NEXT INTO BUF-DVENDOR
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   MOVE 15 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.
           IF VENCDE OF DVENDOR-REC-I NOT = CODE-ARG
               MOVE 15 TO COND-WORD.
061600     IF NOT GOOD-CALL
061700        MOVE "DBGET5 DVENDOR 210 TVENRCV" TO BU-DISPLAY-MSG
061800        PERFORM 990-BLOWUP THRU 999-EXIT.
061900     IF VEN-ITM-NO = 00
062000        MOVE VEN-NAME TO SCREEN-DEL-NAME (I)
062100     ELSE
062200        MOVE "NO VENDOR NAME ON FILE" TO SCREEN-DEL-NAME (I).
062300     MOVE SCREEN-DEL-CODE (I) TO SCREEN-DEL-CODE (I).
062400
062500 215-CHECK-IF-DONE.
062600     ADD 1 TO I.
062700     IF I > 10
062800        MOVE 1 TO I
062900        GO TO 220-SHOW-VENDORS-TO-DELETE
063000     ELSE
063100        GO TO 210-READ-INDIVIDUAL-CODES.
063200
063300 220-SHOW-VENDORS-TO-DELETE.
063400     MOVE FORM-DELETE2 TO VIEW-NFNAME.
064800
064900     MOVE "DEPRESS F1 OR F2 TO DELETE CODES" TO SCREEN-DEL-MSG.
065500
065600 225-SHOW-FORM.
           MOVE SCREEN-DELETE TO DISPLAY-REC.
           WRITE DISPLAY-REC FORMAT IS VIEW-NFNAME
              INDIC ARE SRF-INDICATORS.
           MOVE ALL B"0" TO SRF-INDICATORS.

           READ  DISPLAY-FILE FORMAT IS VIEW-NFNAME
               INDIC ARE SRF-INDICATORS.
           ACCEPT IOFEEDBACK FROM I-O-FEEDBACK-AREA.
           MOVE ALL B"0" TO SRF-INDICATORS.
           MOVE DISPLAY-REC TO SCREEN-DELETE.

      *------ A BAD STATUS MAY MEAN USER TURNED OFF TERMINAL.
      *------ IF SO, SIMULATE THE F3 KEY TO EXIT PROGRAM.
           IF DISPLAY-STATUS NOT = "00"
               MOVE 3 TO VIEW-LASTKEY
           ELSE
               MOVE FUNCTION-NUM TO VIEW-LASTKEY.
066700     MOVE VIEW-LASTKEY TO SAVE-KEY.
067800
067900     IF VIEW-LASTKEY EQUAL 8
068000        GO TO 100-ADD-ROUTINE.
068100
068200     IF VIEW-LASTKEY EQUAL 4
068300        GO TO 300-REPORT-ROUTINE.
068400
068500     IF VIEW-LASTKEY = 7
068600        GO TO 050-SHOW-MAIN-SCREEN.
068700
068800     IF VIEW-LASTKEY EQUAL 3
068900         GO TO 015-CLOSE-FILES.
069000
069100     IF VIEW-LASTKEY EQUAL 6
069200        GO TO 200-DELETE-ROUTINE.
069300 250-DELETE-ENTRIES.
069400     IF SCREEN-DEL-CODE (I) = SPACES
069500        GO TO 255-CHECK-IF-DONE.
069600
069700     MOVE SCREEN-DEL-CODE (I) TO VEN-NUMBER.
069800     MOVE VEN-WORK            TO CODE-ARG.
           MOVE 0 TO COND-WORD.
           MOVE CODE-ARG TO VENCDE OF DVENDOR-REC-O.
           START DVENDOR-O KEY > VENCDE OF DVENDOR-REC-O
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
                   MOVE 17 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.
           MOVE 0 TO COND-WORD.
           READ DVENDOR-O PRIOR INTO BUF-DVENDOR
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   MOVE 15 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.
           IF VENCDE OF DVENDOR-REC-O NOT = CODE-ARG
               MOVE 15 TO COND-WORD.
071100     IF GOOD-CALL
071200        IF VEN-ITM-NO NOT = 99
071300           GO TO 255-CHECK-IF-DONE.
071400
           MOVE 0 TO COND-WORD.
           DELETE DVENDOR-O
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD.
072000     IF NOT GOOD-CALL
072100        MOVE "DBDELETE 220 TVENRCV" TO BU-DISPLAY-MSG
072200        PERFORM 990-BLOWUP THRU 999-EXIT.
072300
      *------- DO A START > HIGH-VALUES TO UNLOCK
           MOVE HIGH-VALUES TO VENCDE OF DVENDOR-REC-O.
           START DVENDOR-O KEY > VENCDE OF DVENDOR-REC-O
               INVALID KEY MOVE "00" TO FILE-STATUS.
072500     IF NOT GOOD-CALL
072600        MOVE "DBUNLOCK DVENDOR 155 TVENRCV" TO BU-DISPLAY-MSG
072700        PERFORM 990-BLOWUP THRU 999-EXIT.
072800
072900 255-CHECK-IF-DONE.
073000     ADD 1 TO I.
073100     IF I > 10
073200        GO TO 280-CHECK-FUNCTION-KEYS
073300     ELSE
073400        GO TO 250-DELETE-ENTRIES.
073500
073600 280-CHECK-FUNCTION-KEYS.
      *------- DO A START > HIGH-VALUES TO UNLOCK
           MOVE HIGH-VALUES TO VENCDE OF DVENDOR-REC-O.
           START DVENDOR-O KEY > VENCDE OF DVENDOR-REC-O
               INVALID KEY MOVE "00" TO FILE-STATUS.
072500     IF NOT GOOD-CALL
072600        MOVE "DBUNLOCK DVENDOR 155 TVENRCV" TO BU-DISPLAY-MSG
072700        PERFORM 990-BLOWUP THRU 999-EXIT.
072800
073700     IF SAVE-KEY = 2
073800        GO TO 200-DELETE-ROUTINE.
073900
