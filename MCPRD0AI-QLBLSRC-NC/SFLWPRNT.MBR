062000 6-PRINT-PO.
      *----- CALL CCRTFILE TO CREATE A TEMPORARY FILE 'PRNTWORK'
      *----- LIBRARY 'QTEMP' IS USED FOR TEMPORARY FILES
           INITIALIZE            CCRTFILE-PARMS.
           MOVE "QTEMP"       TO CCRTFILE-LIBRARY.
           MOVE "PRNTWORK"    TO CCRTFILE-FILE.
           MOVE 0133          TO CCRTFILE-RECORD-LENGTH.
           MOVE 05000         TO CCRTFILE-NO-RECORDS.
           MOVE 02000         TO CCRTFILE-INCREMENT-AMT.
           MOVE 10            TO CCRTFILE-NO-INCREMENTS.
           CALL "CCRTFILE" USING CCRTFILE-LIBRARY,
                                 CCRTFILE-FILE,
                                 CCRTFILE-RECORD-LENGTH,
                                 CCRTFILE-NO-RECORDS,
                                 CCRTFILE-INCREMENT-AMT,
                                 CCRTFILE-NO-INCREMENTS,
                                 CCRTFILE-STATUS.
           IF CCRTFILE-STATUS NOT = "00"
               MOVE "CCRTFILE CREATE OF 'PRNTWORK' FAILED"
                  TO BU-DISPLAY-MSG
               GO TO 2-BLOWUP.
