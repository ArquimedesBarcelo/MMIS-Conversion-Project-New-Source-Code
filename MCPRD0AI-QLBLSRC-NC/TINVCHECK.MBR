000200 IDENTIFICATION DIVISION.
000300 PROGRAM-ID.    TINVCHECK.
000800
002400 ENVIRONMENT DIVISION.
002500 CONFIGURATION SECTION.
002600 SOURCE-COMPUTER.  IBM-AS400.
002700 OBJECT-COMPUTER.  IBM-AS400.
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
003000
      ****************************************************************
      *
      * CHANGES:
      *
      *C*  07/03/96   CA YODER
      *C*    RE-COMPILED TO PICK UP CENTURY DATABASE CHANGES.
      *
      ****************************************************************

           SELECT DINVACCT-I
                  ASSIGN TO DATABASE-MCFLCS2701
                  ORGANIZATION IS INDEXED
                    ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                     WITH DUPLICATES
                  FILE STATUS IS FILE-STATUS.
002800
           SELECT DINVITM-I
                  ASSIGN TO DATABASE-MCFLCS2601
                  ORGANIZATION IS INDEXED
                    ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                     WITH DUPLICATES
                  FILE STATUS IS FILE-STATUS.
003000
           SELECT DINVRCD-I
                  ASSIGN TO DATABASE-MCFLCS2501
                  ORGANIZATION IS INDEXED
                    ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                     WITH DUPLICATES
                  FILE STATUS IS FILE-STATUS.
002800
003000
003100 DATA DIVISION.
003200 FILE SECTION.
       FD  DINVACCT-I
           LABEL RECORDS ARE STANDARD.
       01  DINVACCT-REC-I.
           COPY DDS-ALL-FORMATS OF MCFLCS2701.
003300
       FD  DINVITM-I
           LABEL RECORDS ARE STANDARD.
       01  DINVITM-REC-I.
           COPY DDS-ALL-FORMATS OF MCFLCS2601.
003400
       FD  DINVRCD-I
           LABEL RECORDS ARE STANDARD.
       01  DINVRCD-REC-I.
           COPY DDS-ALL-FORMATS OF MCFLCS2501.
003400
003500 WORKING-STORAGE SECTION.
       01  FILE-STATUS.
           05  FILE-STATUS-1            PIC X  VALUE "0".
           05  FILE-STATUS-2            PIC X  VALUE "0".

9406CK 01  SCOPE   PIC X.

003600
003700**************************************************************
003800**************************************************************
003900**                                                          **
004000**                DATABASE I/O BUFFER AREA                  **
004100**                                                          **
004200**************************************************************
004300**************************************************************
004400
       COPY DINVACCT IN COPYLIB.
       COPY DINVITM  IN COPYLIB.
       COPY DINVRCD  IN COPYLIB.
008400
008500 PROCEDURE DIVISION.
008600
008700
008800
       BEGIN-HERE.
9406CK     MOVE "C" TO SCOPE.
9406CK     CALL "MCXCBLERR" USING SCOPE.

           DISPLAY "BEGINNING DINVACCT".
           OPEN INPUT DINVACCT-I.
           PERFORM 63-MAIN THRU 63-M-X.
           CLOSE DINVACCT-I.

           DISPLAY "BEGINNING DINVITM".
           OPEN INPUT DINVITM-I.
           PERFORM 64-MAIN THRU 64-M-X.
           CLOSE DINVITM-I.

           DISPLAY "BEGINNING DINVRCD".
           OPEN INPUT DINVRCD-I.
           PERFORM 65-MAIN THRU 65-M-X.
           CLOSE DINVRCD-I.
009100     GOBACK.
009200
010800 63-MAIN.
010900     READ DINVACCT-I FIRST RECORD
               AT END GO TO 63-M-X.
           IF FILE-STATUS NOT = "00"
               DISPLAY "READ FIRST DINVACCT*63-MAIN"
               GO TO 63-M-X.

011000     PERFORM 63-READ-FILE THRU 63-RF-X.
011100
011200 63-M-X.
011300     EXIT.
011400
011500 63-READ-FILE.
           MOVE DINVACCT-REC-I TO BUF-DINVACCT.
           READ DINVACCT-I NEXT RECORD
               AT END GO TO 63-RF-X.
           IF FILE-STATUS NOT = "00"
               DISPLAY "READ NEXT DINVACCT *61-RF"
               GO TO 63-RF-X.
           IF BUF-DINVACCT = DINVACCT-REC-I
               DISPLAY "DUPLICATE DINVACCT -", DINVACCT-REC-I.
           GO TO 63-READ-FILE.

       63-RF-X.
           EXIT.

010800 64-MAIN.
010900     READ DINVITM-I FIRST RECORD
               AT END GO TO 64-M-X.
           IF FILE-STATUS NOT = "00"
               DISPLAY "READ FIRST DINVITM *6-MAIN"
               GO TO 64-M-X.

011000     PERFORM 64-READ-FILE THRU 64-RF-X.

011100
011200 64-M-X.
011300     EXIT.
011400
011500 64-READ-FILE.
           MOVE DINVITM-REC-I TO BUF-DINVITM.
           READ DINVITM-I NEXT RECORD
               AT END GO TO 64-RF-X.
           IF FILE-STATUS NOT = "00"
               DISPLAY "READ NEXT DINVITM  *61-RF"
               GO TO 64-RF-X.
           IF BUF-DINVITM = DINVITM-REC-I
               DISPLAY "DUPLICATE DINVITM - ", DINVITM-REC-I.
           GO TO 64-READ-FILE.

       64-RF-X.
           EXIT.
010800 65-MAIN.
010900     READ DINVRCD-I FIRST RECORD
               AT END GO TO 65-M-X.
           IF FILE-STATUS NOT = "00"
               DISPLAY "READ FIRST DINVRCD *6-MAIN"
               GO TO 65-M-X.

011000     PERFORM 65-READ-FILE THRU 65-RF-X.

011100
011200 65-M-X.
011300     EXIT.
011400
011500 65-READ-FILE.
           MOVE DINVRCD-REC-I TO BUF-DINVRCD.
           READ DINVRCD-I NEXT RECORD
               AT END GO TO 65-RF-X.
           IF FILE-STATUS NOT = "00"
               DISPLAY "READ NEXT DINVRCD  *61-RF"
               GO TO 65-RF-X.
           IF BUF-DINVRCD = DINVRCD-REC-I
               DISPLAY "DUPLICATE DINVRCD - ", BUF-DINVRCD.
           GO TO 65-READ-FILE.

       65-RF-X.
           EXIT.
