       IDENTIFICATION DIVISION.
       PROGRAM-ID.           TINVRPT.
       AUTHOR.               KALMAN.
       DATE-WRITTEN.         OCT 1993.
      *INSTALLATION.         GOODYEAR TIRE AND RUBBER CO.

      *D* REMARKS.
      *D*
      *D*
      *D*
      *C* CHANGES.
      *C*
      *C* 12/08/1997    CA YODER
      *C* Y2K TESTING REVEALED THAT THIS PROGRAM WAS NOT INCLUDING
      *C* CENTURY IN THE LF MCFPGENSUM.  ADDED A SECOND DATE FIELD
      *C* (INCLUDING CENTURY) TO THE CONTROL RECORD SO THAT THE
      *C* SORT WILL BE CORRECT.
      *C*

       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.
       SPECIAL-NAMES.      I-O-FEEDBACK IS I-O-FEEDBACK-AREA.

      ******************************************************************
       INPUT-OUTPUT SECTION.
      ******************************************************************
       FILE-CONTROL.
           SELECT DISPLAY-FILE
                  ASSIGN TO WORKSTATION-ZINVGEN-SI
                  ORGANIZATION IS TRANSACTION
                  ACCESS IS DYNAMIC
                  RELATIVE KEY IS SUBFILE-IX
                  FILE STATUS IS DISPLAY-STATUS
                  CONTROL-AREA IS WS-CONTROL.
           SELECT GENSUMFL-I
                  ASSIGN TO DISK-GENSUMFL
                  ORGANIZATION IS RELATIVE
                  ACCESS MODE IS DYNAMIC
                  RELATIVE KEY IS GENSUMFL-IX
                  FILE STATUS IS FILE-STATUS.
           SELECT GENSUMFL-DT-I
                  ASSIGN TO DATABASE-MCFLGENSM2
      ********    ASSIGN TO DATABASE-MCFLGENSUM
                  ORGANIZATION IS INDEXED
                  ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                  WITH DUPLICATES
                  FILE STATUS IS FILE-STATUS.
           SELECT GENRPTFL-O
                  ASSIGN TO DISK-GENRPTFL.

      ******************************************************************
       DATA DIVISION.
      ******************************************************************

       FILE SECTION.

       FD  DISPLAY-FILE
           LABEL RECORDS ARE OMITTED.
       01  DISPLAY-REC         PIC X(1000).

       FD  GENSUMFL-I
           LABEL RECORDS ARE OMITTED
           RECORD CONTAINS 133 CHARACTERS.
       01  GENSUMFL-REC-I          PIC X(133).

       FD  GENSUMFL-DT-I
           LABEL RECORDS ARE STANDARD.
       01  GENSUMFL-DT-REC-I.
           COPY DDS-MCRPGENSUM  OF MCFLGENSM2.
      **** COPY DDS-MCRPGENSUM  OF MCFLGENSUM.

       FD  GENRPTFL-O
           DATA RECORD IS GENRPTFL-REC-O
           RECORD CONTAINS 133 CHARACTERS
           LABEL RECORDS ARE OMITTED.
       01  GENRPTFL-REC-O.
           05  RPT-CTL               PIC X.
           05  RPT-LINE              PIC X(132).

      ******************************************************************
       WORKING-STORAGE SECTION.
      ******************************************************************
      *-----------------------------------------------------------------
      *  Q C M D E X C   F I E L D S
      *-----------------------------------------------------------------
       01  CPYF-CMD.
           05         PIC X(30) VALUE "CPYF FROMFILE(*LIBL/GENSUMFL) ".
           05         PIC X(23) VALUE "TOFILE(*LIBL/GENRPTFL) ".
           05         PIC X(25) VALUE "MBROPT(*REPLACE) FROMRCD(".
           05  CPYF-STR-RRN     PIC 9(5).
           05                   PIC X(8)  VALUE ") TORCD(".
           05  CPYF-END-RRN     PIC 9(5).
           05                   PIC X(1)  VALUE ")".

       01  CPYF-CMD-LEN                   PIC S9(10)V9(5) COMP-3
                                          VALUE 97.
      *-----------------------------------------------------------------
      *  D A T E   &   T I M E   F I E L D S
      *-----------------------------------------------------------------

       01  CUR-DATE.
           05  CUR-DATE-CC                PIC X(2).
           05  CUR-SYSTEM-DATE.
               10  CUR-DATE-YY            PIC X(2).
               10  CUR-DATE-MM            PIC X(2).
               10  CUR-DATE-DD            PIC X(2).

       01  SAVE-RUN-DT                    PIC X(10).

      *-----------------------------------------------------------------
      *  A R G U M E N T   V A L U E S
      *-----------------------------------------------------------------

       01  PO-14-ARG                          VALUE SPACES.
           05  PO-11-ARG.
               10  PO-PREFIX-ARG    PIC X.
               10  PO-10-ARG.
                   15  PO-NUM-ARG   PIC X(7).
                   15  PO-RLS-ARG   PIC X(3).
           05  PO-RCVR-ARG          PIC X(3).
       01  PO-14-ARG-DUP            REDEFINES PO-14-ARG.
           05  PO-PREFIX-ARG-DUP    PIC X.
           05  PO-13-ARG            PIC X(13).
       01  RAIL-CAR-ARG             PIC X(10) VALUE SPACES.
       01  SHIP-DATE-ARG.
           05  SHIP-DATE-CC         PIC X(2).
           05  SHIP-DATE-YYMMDD     PIC X(6).
       01  RECNUM-ARG               PIC S9(8) COMP-4.
       01  DATE-ARG                 PIC X(8).
       01  CARRIER-ARG              PIC X(4).
       01  PRO-NO-ARG               PIC X(16).

      *-----------------------------------------------------------------
      *  F L A G S   A N D   S W I T C H E S
      *-----------------------------------------------------------------

       01  GENSUMFL-DT-EOF          PIC X.
       01  GENSUMFL-RRN-EOF         PIC X.

       01  REC-LIST-OPTION          PIC X.
       01  SEARCH-TOGGLE            PIC X.

       01  RTN-CODE                 PIC 9.

       01  SAVE-AVG-COST-CALC-SW    PIC X(1).

       01  IN-CLOSING-PERIOD        PIC X.

       01  FLD-LEN                  PIC 9.

       01  INFO-TYPE                PIC X.

       01  SAVE-RECNUM              PIC S9(9) COMP-4.

      *-----------------------------------------------------------------
      *  I N D E X E S
      *-----------------------------------------------------------------

       01  SUBFILE-IX                    PIC  9(4).
       01  GENSUMFL-IX                   PIC  9(8) COMP-4.

      *-----------------------------------------------------------------
      *  A C C U M U L A T O R S
      *-----------------------------------------------------------------

       01  LOAD-LIMIT                    PIC 999.
           88  LOAD-LIMIT-REACHED        VALUE 17.
       01  SUBFILE-REC-CNT               PIC 9(4).

      *-----------------------------------------------------------------
      *  T A B L E S
      *-----------------------------------------------------------------
      *-----------------------------------------------------------------
      *  B U F F E R S
      *-----------------------------------------------------------------

      *SFL SCREEN.
       01  BUF-SCREEN1.
           05  S1-OPTION          PIC X(1).
           05  S1-ACTION          PIC X(2).
           05  S1-RUN-DT.
               10  S1-RUN-YYYY    PIC X(4).
               10  S1-DASH1       PIC X.
               10  S1-RUN-MM      PIC X(2).
               10  S1-DASH2       PIC X.
               10  S1-RUN-DD      PIC X(2).
           05  S1-ACT-DT.
               10  S1-ACT-YYYY    PIC X(4).
               10  S1-DASH3       PIC X.
               10  S1-ACT-MM      PIC X(2).
               10  S1-DASH4       PIC X.
               10  S1-ACT-DD      PIC X(2).
           05  S1-STR-REG         PIC X(5).
           05  S1-END-REG         PIC X(5).
           05  S1-TOT-AMT         PIC X(14).
           05  S1-TOT-REG         PIC X(5).
           05  S1-SEQ             PIC X(5).
           05  S1-STR-RRN         PIC S9(8) COMP-4.
           05  S1-END-RRN         PIC S9(8) COMP-4.

      *SFLCTL SCREEN.
       01  BUF-SCREEN2.
           05  S2-RELRCD          PIC S9(5).
           05  S2-DSPREC          PIC S9(4).

      *FKEY & ERR MSG SCREEN FOR SFL.
       01  BUF-SCREEN3.
           05  S3-MSG-LINE        PIC X(79).

       01  SAVE-BUF-GENSUMFL      PIC X(133).

       01  BUF-GENSUMFL.
           05  GEN-DATA                      PIC X(133).

           05  GEN-DATE-RCD        REDEFINES GEN-DATA.
               10  GEN-TYPE                  PIC X.
               10  GEN-RUN-DATE.
                   15  GEN-RUN-YY            PIC X(2).
                   15  GEN-RUN-MM            PIC X(2).
                   15  GEN-RUN-DD            PIC X(2).
               10                            PIC X(126).

           05  GEN-HDR-RCD         REDEFINES GEN-DATA.
               10                            PIC X(75).
               10  GEN-ACT-DATE.
                   15  GEN-ACT-MM            PIC X(2).
                   15                        PIC X.
                   15  GEN-ACT-DD            PIC X(2).
                   15                        PIC X.
                   15  GEN-ACT-YY            PIC X(2).
               10                            PIC X(15).
               10  GEN-SEQ                   PIC X(5).
               10                            PIC X(22).
               10  GEN-PG                    PIC XX.
               10                            PIC X(6).

           05  GEN-DTL-RCD         REDEFINES GEN-DATA.
               10                            PIC X(116).
               10  GEN-REG-NUM               PIC 9(5).
               10  GEN-REG-ALPHA    REDEFINES GEN-REG-NUM PIC X(5).
               10                            PIC X(12).

           05  GEN-TOT-RCD         REDEFINES GEN-DATA.
               10                            PIC X(3).
               10  GEN-TOTAL                 PIC X(6).
               10                            PIC X(7).
               10  GEN-TOT-AMT               PIC X(14).
               10                            PIC X(86).
               10  GEN-TOT-REG               PIC X(5).
               10                            PIC X(12).

       COPY MACTINFO OF COPYLIB.

      *-----------------------------------------------------------------
      *  D A T A B A S E   S T A T U S   A R E A
      *-----------------------------------------------------------------

       01  FILE-STATUS.
           05  FILE-STATUS-1             PIC X.
           05  FILE-STATUS-2             PIC X.

       COPY DBCSACCT OF COPYLIB.

       COPY DATAB    OF COPYLIB.

       01  IOFEEDBACK.
           05  IO-OFFSET                       PIC S9(4) COMP-4.
           05  IO-OUT-COUNT                    PIC S9(8) COMP-4.
           05  IO-GET-COUNT                    PIC S9(8) COMP-4.
           05  IO-PUT-GET-COUNT                PIC S9(8) COMP-4.
           05  IO-OTHER-COUNT                  PIC S9(8) COMP-4.
           05  FILLER                          PIC X.
           05  IO-OPERATION                    PIC X.
           05  IO-FORMAT                       PIC X(10).
           05  IO-DEV-CLASS                    PIC X(2).
           05  IO-PGM-DEVICE                   PIC X(10).
           05  IO-REC-LEN                      PIC S9(8) COMP-4.
           05  IO-RTG-DTA                      PIC X(80).
           05  IO-BLK-REC                      PIC S9(4) COMP-4.
           05  IO-RESV                         PIC X(4).
           05  IO-BLK-CNT                      PIC S9(8) COMP-4.
           05  FILLER                          PIC X(8).

           05  FEEDBACK-SIZE                   PIC S9(8) COMP-4.
           05  JOIN-LOGICAL                    PIC X(4).
           05  KEY-OFFSET                      PIC S9(4) COMP-4.
           05  LOCKED-RECORDS                  PIC S9(4) COMP-4.
           05  MAX-FIELDS                      PIC S9(4) COMP-4.
           05  FIELD-MAPPING-OFFSET            PIC S9(8) COMP-4.
           05  CURRENT-FILE-POSITION           PIC X(1).
           05  CURRENT-RECORD-DELETE           PIC X(1).
           05  NO-OF-KEYS                      PIC S9(4) COMP-4.
           05  RESERVED-FIELD                  PIC X(4).
           05  KEY-LENGTH                      PIC S9(4) COMP-4.
           05  DATA-MEMBER-NO                  PIC S9(4) COMP-4.
           05  IO-RECNUM                       PIC S9(8) COMP-4.

      *-----------------------------------------------------------------
      *  T E M P O R A R Y   F I L E   P A R M S
      *-----------------------------------------------------------------

       COPY CCRTFILE IN COPYLIB.

      *-----------------------------------------------------------------
      *  U T I L I T Y   A R E A
      *-----------------------------------------------------------------

       COPY CATREAD OF COPYLIB.

       COPY TBLOWUP OF COPYLIB.

       COPY TDATECHK OF COPYLIB.

       COPY VCOMAREA OF COPYLIB.

      *COPY DISPDATA OF COPYLIB.
       01  WS-CONTROL.
           05  FUNCTION-KEY       PIC XX.
               88  ENTER-KEY-USED                       VALUE "00".
               88  F1-KEY-USED                          VALUE "01".
               88  F2-KEY-USED                          VALUE "02".
               88  F3-KEY-USED                          VALUE "03".
               88  F4-KEY-USED                          VALUE "04".
               88  F5-KEY-USED                          VALUE "05".
               88  F6-KEY-USED                          VALUE "06".
               88  F7-KEY-USED                          VALUE "07".
               88  F8-KEY-USED                          VALUE "08".
               88  F9-KEY-USED                          VALUE "09".
               88  F10-KEY-USED                         VALUE "10".
               88  F11-KEY-USED                         VALUE "11".
               88  F12-KEY-USED                         VALUE "12".
               88  ROLLUP-KEY-USED                      VALUE "RU".
           05  TERMINAL-ID        PIC X(10).
           05  FORMAT-NAME        PIC X(10).

       01  DISPLAY-STATUS         PIC X(2).

       01  SRF-INDICATORS.
           05  IND                PIC 1
                                  OCCURS 99 TIMES
                                  INDICATOR 1.
               88  IND-OFF        VALUE B"0".
               88  IND-ON         VALUE B"1".

       01  OFF-SWITCH             PIC 1  VALUE B"0".
       01  ON-SWITCH              PIC 1  VALUE B"1".

      ******************************************************************
       PROCEDURE DIVISION.
      ******************************************************************

      *-----------------------------------------------------------------
       MAIN SECTION.
      *-----------------------------------------------------------------

       0-CONTROL.

           PERFORM 1-HSK.

           PERFORM 6-LOOP THRU 6-LOOP-X.

           PERFORM 2-EOJ.

           GOBACK.

       1-HSK.

           OPEN INPUT      GENSUMFL-I
                           GENSUMFL-DT-I.
           OPEN I-O        DISPLAY-FILE.

      *----AS OF MAR 93 THE CENTURY IS NOT AVAILABLE FROM THE SYSTEM.
      *----UNTIL THE SITUATION CHANGES, THE FOLLOWING CODING IS A
      *----TEMPORARY MEASURE. THIS CODING IS USED FOR ALL DATES IN
      *----THIS PROGRAM THAT NEED CONVERSION.

           ACCEPT CUR-SYSTEM-DATE FROM DATE.
           IF CUR-DATE-YY < "40"
              MOVE "20" TO CUR-DATE-CC
           ELSE
              MOVE "19" TO CUR-DATE-CC.

           MOVE  1  TO S2-DSPREC.

       2-EOJ.
           CLOSE           GENSUMFL-I
                           GENSUMFL-DT-I
                           DISPLAY-FILE.

      *-----------------------------------------------------------------
       6-LOOP SECTION.
      *-----------------------------------------------------------------

       60-LOAD-SCREEN.

           INITIALIZE SUBFILE-IX,  SUBFILE-REC-CNT.

      *----SHOW SFLCTL (71) AND CLEAR SFL (72), BUT DON'T SHOW IT (70).

           MOVE ON-SWITCH TO IND (71)  IND (72).
           MOVE OFF-SWITCH TO IND (70).

           WRITE SUBFILE DISPLAY-REC FROM BUF-SCREEN2
              FORMAT IS "ALSTSFLCTL"
              INDICATORS ARE SRF-INDICATORS.
           IF DISPLAY-STATUS NOT = "00"
              MOVE "PROBLEM ON INIT SFL WRITE" TO BU-DISPLAY-MSG
              GO TO 9999-BLOWUP.

      *----TURN CLEAR SFL OFF.

           MOVE OFF-SWITCH TO IND (72).

       60A-GET-LIST.

           INITIALIZE BUF-SCREEN1, LOAD-LIMIT.
           MOVE SUBFILE-REC-CNT TO SUBFILE-IX.

           PERFORM 600-LIST-REPORTS.

      *    MOVE BUF-GENSUMFL TO SAVE-BUF-GENSUMFL.
      *    MOVE IO-RECNUM    TO SAVE-RECNUM.

       61-SHOW-SCREEN.

      *----PUT UP FUNCTION KEY SCREEN.

           WRITE DISPLAY-REC FROM BUF-SCREEN3
                 FORMAT IS "ALSTFKEY"
                 INDICATORS ARE SRF-INDICATORS.
           MOVE ALL B"0" TO SRF-INDICATORS.

      *----OVERLAY WITH SFLCTL AND SFL SCREENS.

           IF SUBFILE-IX = ZERO
              MOVE OFF-SWITCH TO IND (70)
           ELSE
              MOVE ON-SWITCH TO IND (70).
           MOVE ON-SWITCH TO IND (71).

           IF GENSUMFL-DT-EOF = "Y"
              MOVE ON-SWITCH  TO IND (73)
           ELSE
              MOVE OFF-SWITCH TO IND (73).

           WRITE SUBFILE DISPLAY-REC FROM BUF-SCREEN2
              FORMAT IS "ALSTSFLCTL"
              INDICATORS ARE SRF-INDICATORS.
           MOVE ALL B"0" TO SRF-INDICATORS.
           IF DISPLAY-STATUS NOT = "00"
              MOVE "PROBLEM ON SHOW SFL WRITE" TO BU-DISPLAY-MSG
              MOVE SUBFILE-IX TO BU-DISPLAY-FLD (1)
              MOVE DISPLAY-STATUS TO BU-DISPLAY-FLD (2)
              GO TO 9999-BLOWUP.

      *----READ USER INPUT.
           READ DISPLAY-FILE INTO BUF-SCREEN2
              FORMAT IS "ALSTSFLCTL"
              INDICATORS ARE SRF-INDICATORS.
           IF IND-ON (75)
              SET ROLLUP-KEY-USED TO TRUE.
           MOVE ALL B"0" TO SRF-INDICATORS.
           IF DISPLAY-STATUS NOT = "00"
              MOVE "PROBLEM ON READ SFL" TO BU-DISPLAY-MSG
              GO TO 9999-BLOWUP.

       62-ACTION.

           IF ROLLUP-KEY-USED
              COMPUTE S2-DSPREC = SUBFILE-REC-CNT + 1
      *       MOVE SAVE-BUF-GENSUMFL TO BUF-GENSUMFL
      *       MOVE SAVE-RECNUM       TO RECNUM-ARG
              GO TO 60A-GET-LIST.

           IF ENTER-KEY-USED
              GO TO 61-SHOW-SCREEN.

      *    IF F2-KEY-USED
      *       PERFORM 621-CALL-SFRTINQ
      *       GO TO 61-SHOW-SCREEN.

           IF F3-KEY-USED
              GO TO 6-LOOP-X.

           IF F4-KEY-USED
              PERFORM 624-PRINT
              GO TO 61-SHOW-SCREEN.

      *    IF F5-KEY-USED
      *       MOVE  1  TO S2-DSPREC
      *       GO TO 60-LOAD-SCREEN.

      *    IF F9-KEY-USED
      *       MOVE  1  TO S2-DSPREC
      *       GO TO 60-LOAD-SCREEN.

       600-LIST-REPORTS.

           IF NOT ROLLUP-KEY-USED
              PERFORM 9999-READ-FIRST-GENSUMFL-DT-I
              ACCEPT IOFEEDBACK FROM I-O-FEEDBACK-AREA.

           PERFORM UNTIL GENSUMFL-DT-EOF = "Y" OR LOAD-LIMIT-REACHED
              IF GEN-RUN-YY < "40"
                 STRING "20"        DELIMITED BY SIZE,
                        GEN-RUN-YY  DELIMITED BY SIZE INTO S1-RUN-YYYY
              ELSE
                 STRING "19"        DELIMITED BY SIZE,
                        GEN-RUN-YY  DELIMITED BY SIZE INTO S1-RUN-YYYY
              END-IF
              MOVE GEN-RUN-MM TO S1-RUN-MM
              MOVE GEN-RUN-DD TO S1-RUN-DD
              MOVE "-" TO S1-DASH1, S1-DASH2
              MOVE S1-RUN-DT TO SAVE-RUN-DT
              INITIALIZE BUF-GENSUMFL, GENSUMFL-RRN-EOF

              COMPUTE RECNUM-ARG = IO-RECNUM + 1
              PERFORM 9999-READ-GENSUMFL-I

              PERFORM UNTIL GEN-TYPE = "*" OR GENSUMFL-RRN-EOF = "Y"
                 IF GEN-PG = " 1"
                    COMPUTE S1-STR-RRN = IO-RECNUM - 1
                    MOVE GEN-SEQ TO S1-SEQ
                    IF GEN-ACT-YY < "40"
                       STRING "20"       DELIMITED BY SIZE,
                              GEN-ACT-YY DELIMITED BY SIZE
                                         INTO S1-ACT-YYYY
                    ELSE
                       STRING "19"       DELIMITED BY SIZE,
                              GEN-ACT-YY DELIMITED BY SIZE
                                         INTO S1-ACT-YYYY
                    END-IF
                    MOVE GEN-ACT-MM TO S1-ACT-MM
                    MOVE GEN-ACT-DD TO S1-ACT-DD
                    MOVE "-" TO S1-DASH3, S1-DASH4
                 END-IF
                 IF GEN-REG-NUM IS NUMERIC
                    IF GEN-REG-ALPHA < S1-STR-REG
                       OR S1-STR-REG = SPACES
                          MOVE GEN-REG-ALPHA TO S1-STR-REG
                    END-IF
                    IF GEN-REG-ALPHA > S1-END-REG
                       MOVE GEN-REG-ALPHA TO S1-END-REG
                    END-IF
                 END-IF
                 IF GEN-TOTAL = "TOTALS"
                    MOVE GEN-TOT-AMT TO S1-TOT-AMT
                    MOVE GEN-TOT-REG TO S1-TOT-REG
                    IF S1-RUN-DT = SPACES
                       MOVE SAVE-RUN-DT TO S1-RUN-DT
                    END-IF
                    MOVE IO-RECNUM TO S1-END-RRN
                    ADD 1 TO SUBFILE-IX, SUBFILE-REC-CNT, LOAD-LIMIT
                    IF SUBFILE-IX = 4001
                       MOVE "SUBFILE TOO SMALL-INCREASE ALSTSFL/ZINVGEN"
                          TO BU-DISPLAY-MSG
                       MOVE SUBFILE-IX TO BU-DISPLAY-FLD (1)
                       GO TO 9999-BLOWUP
                    END-IF
                    WRITE SUBFILE DISPLAY-REC FROM BUF-SCREEN1
                       FORMAT IS "ALSTSFL"
                       INDICATORS ARE SRF-INDICATORS
                    END-WRITE
                    IF DISPLAY-STATUS NOT = "00"
                       MOVE "PROBLEM ON LOAD SFL WRITE"
                            TO BU-DISPLAY-MSG
                       MOVE SUBFILE-IX TO BU-DISPLAY-FLD (1)
                       MOVE S1-SEQ     TO BU-DISPLAY-FLD (2)
                       MOVE DISPLAY-STATUS TO BU-DISPLAY-FLD (4)
                       GO TO 9999-BLOWUP
                    END-IF
                    INITIALIZE BUF-SCREEN1
                 END-IF
                 IF GEN-TYPE = "4"
                    MOVE "          0.00" TO S1-TOT-AMT
                    MOVE "    0"          TO S1-TOT-REG
                    MOVE "**NO "          TO S1-STR-REG
                    MOVE "REG**"          TO S1-END-REG
                    IF S1-RUN-DT = SPACES
                       MOVE SAVE-RUN-DT TO S1-RUN-DT
                    END-IF
                    MOVE IO-RECNUM TO S1-END-RRN
                    ADD 1 TO SUBFILE-IX, SUBFILE-REC-CNT, LOAD-LIMIT
                    IF SUBFILE-IX = 4001
                       MOVE "SUBFILE TOO SMALL-INCREASE ALSTSFL/ZINVGEN"
                          TO BU-DISPLAY-MSG
                       MOVE SUBFILE-IX TO BU-DISPLAY-FLD (1)
                       GO TO 9999-BLOWUP
                    END-IF
                    WRITE SUBFILE DISPLAY-REC FROM BUF-SCREEN1
                       FORMAT IS "ALSTSFL"
                       INDICATORS ARE SRF-INDICATORS
                    END-WRITE
                    IF DISPLAY-STATUS NOT = "00"
                       MOVE "PROBLEM ON LOAD SFL WRITE"
                            TO BU-DISPLAY-MSG
                       MOVE SUBFILE-IX TO BU-DISPLAY-FLD (1)
                       MOVE S1-SEQ     TO BU-DISPLAY-FLD (2)
                       MOVE DISPLAY-STATUS TO BU-DISPLAY-FLD (4)
                       GO TO 9999-BLOWUP
                    END-IF
                    INITIALIZE BUF-SCREEN1
                 END-IF
                 PERFORM 9999-READ-NEXT-GENSUMFL-I
                 ACCEPT IOFEEDBACK FROM I-O-FEEDBACK-AREA
              END-PERFORM
              PERFORM 9999-READ-NEXT-GENSUMFL-DT-I
              ACCEPT IOFEEDBACK FROM I-O-FEEDBACK-AREA
           END-PERFORM.

       624-PRINT.

      *----FIND FIRST SUBFILE REC TO PRINT.

           PERFORM UNTIL S1-OPTION = "X" OR DISPLAY-STATUS NOT = ZERO
              READ SUBFILE DISPLAY-FILE NEXT MODIFIED RECORD
                   INTO BUF-SCREEN1
                   FORMAT IS "ALSTSFL"
           END-PERFORM

           IF S1-OPTION = "X"
              MOVE SUBFILE-IX TO S2-DSPREC
           ELSE
              MOVE S2-RELRCD TO S2-DSPREC.
           IF S2-DSPREC < 1
              MOVE 1 TO S2-DSPREC.

           PERFORM UNTIL DISPLAY-STATUS NOT = ZERO

              MOVE S1-STR-RRN TO CPYF-STR-RRN
              MOVE S1-END-RRN TO CPYF-END-RRN

              CALL "QCMDEXC" USING  CPYF-CMD  CPYF-CMD-LEN
              CALL "BINVGENRP"

      *-------UPDATE THE SUBFILE RECORD

              MOVE "4P" TO S1-ACTION
              INITIALIZE S1-OPTION

              REWRITE SUBFILE DISPLAY-REC FROM BUF-SCREEN1
                 FORMAT IS "ALSTSFL"
                 INDICATORS ARE SRF-INDICATORS
                 INVALID KEY MOVE FILE-STATUS TO FILE-STATUS
              END-REWRITE

      *-------GET NEXT SUBFILE RECORD TO INQUIRE

              PERFORM UNTIL S1-OPTION = "X" OR DISPLAY-STATUS NOT = ZERO
                 READ SUBFILE DISPLAY-FILE NEXT MODIFIED RECORD
                      INTO BUF-SCREEN1
                      FORMAT IS "ALSTSFL"
                 END-READ
              END-PERFORM

           END-PERFORM.

       6-LOOP-X.
           EXIT.

      *-----------------------------------------------------------------
       9999-UTILITY SECTION.
      *-----------------------------------------------------------------

       9999-BLOWUP.
           MOVE "TINVRPT" TO BU-PGM-NAME.
           CALL "TBLOWUP" USING BASE, BU-PGM-NAME, STATUS-AREA,
              VIEW-COMAREA, FILE-STATUS, BU-DISPLAY-MSG,
              BU-DISPLAY-FLDS.

      *---------------------------------
      * GENSUMFL
      *---------------------------------

      *-KEY = RRN-----------------------

       9999-READ-GENSUMFL-I.
           MOVE RECNUM-ARG TO GENSUMFL-IX.
           READ GENSUMFL-I INTO BUF-GENSUMFL
                INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
              MOVE "*" TO GEN-TYPE.
      *       MOVE "READ GENSUMFL*9999-RDI" TO BU-DISPLAY-MSG
      *       MOVE RECNUM-ARG TO BU-DISPLAY-FLD (1)
      *       MOVE FILE-STATUS TO BU-DISPLAY-FLD (2)
      *       GO TO 9999-BLOWUP.

       9999-READ-NEXT-GENSUMFL-I.
           READ GENSUMFL-I NEXT INTO BUF-GENSUMFL
              AT END MOVE "Y" TO GENSUMFL-RRN-EOF.

      *-KEY = DT------------------------

       9999-READ-FIRST-GENSUMFL-DT-I.
           READ GENSUMFL-DT-I FIRST INTO BUF-GENSUMFL
             AT END MOVE "Y" TO GENSUMFL-DT-EOF.

       9999-READ-NEXT-GENSUMFL-DT-I.
           READ GENSUMFL-DT-I NEXT INTO BUF-GENSUMFL
              AT END MOVE "Y" TO GENSUMFL-DT-EOF.
