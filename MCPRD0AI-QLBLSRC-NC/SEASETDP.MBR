000200 IDENTIFICATION DIVISION.
000300 PROGRAM-ID.          SEASETDP.
000400 AUTHOR.              C HILLES/JIM COFFMAN (MAINTAINER).
000500 DATE-WRITTEN.        6/4/88.
000600 DATE-COMPILED.
000700*INSTALLATION.        GOODYEAR TIRE AND RUBBER - AKRON.
000800*SECURITY.
000900*REMARKS.
001000*C   ELECTRONIC APPROVAL SYSTEM - DEPARTMENT COMBINED KEY SETUP
001100*C   PROGRAM AND EXPLODE DEPARTMENTS PROGRAM.
001200*C      THE MAIN KEY INTO THE PATHS IS DEPARTMENT.  IF REQUESTING
001300*C      AND CHARGE DEPT MATCH, NO PROBLEM, WE JUST SEARCH BY THAT
001400*C      DEPT.  IF REQ AND CHARGE DEPT DONT MATCH, WE CHECK FOR
001500*C      THE COMBINED KEY IN MVALIDPLTDATA (REQ + CHARGE DEPT).
001600*C      IF IT DOESNT EXIST, AGAIN WE GO BY CHARGE DEPT.  IF IT
001700*C      DOES EXIST, THERE ARE 3 OPTIONS:
001800*C        1.  GO BY CHARGE DEPT
001900*C        2.  GO BY REQUESTING DEPT
002000*C        3.  COMBINED PATH OF CHARGE DEPT AND REQ DEPT
002100*C
      *C   FEB. 1995 JE COFFMAN  WRITTEN REQUEST 94-041/SLS #6558
      *C     ADDED LOGIC TO ALLOW THE USER TO ADD, MODIFY, INQUIRE AND
      *C     DELETE A "PSEUDO" DEPARTMENT AND THE DEPARTMENTS THAT ARE
      *C     TO BE LINKED TO IT TO EXPLODE REQUISITIONS IN THE E1
      *C     FUNCTION.
      *C
002200
002300 ENVIRONMENT DIVISION.
002400 CONFIGURATION SECTION.
002500 SOURCE-COMPUTER.  HP-3000.
002600 OBJECT-COMPUTER.  HP-3000.
       SPECIAL-NAMES. I-O-FEEDBACK IS I-O-FEEDBACK-AREA.

       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT DISPLAY-FILE
                  ASSIGN TO WORKSTATION-ZEASETUP-SI
                  ORGANIZATION IS TRANSACTION
                  ACCESS IS SEQUENTIAL
                  FILE STATUS IS DISPLAY-STATUS
                  CONTROL-AREA IS WS-CONTROL.

           SELECT MVALIDPLT-O
                  ASSIGN TO DATABASE-MCFLCS1701
                  ORGANIZATION IS INDEXED
                    ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                  FILE STATUS IS FILE-STATUS.

002700
002800 DATA DIVISION.
       FILE SECTION.
       FD  DISPLAY-FILE
           LABEL RECORDS ARE OMITTED.
       01  DISPLAY-REC        PIC X(1500).

       FD  MVALIDPLT-O
           LABEL RECORDS ARE STANDARD.
       01  MVALIDPLT-REC-O.
           COPY DDS-MCRPCS1700  OF MCFLCS1701.

002900 WORKING-STORAGE SECTION.
       77  SUB                PIC S9(4) COMP-4.
003000
003100**************************************************************
003200**                                                          **
003300**                S U B P R O G R A M   A R E A S           **
003400**                                                          **
003500**************************************************************
003600
003700 COPY TDATECHK   IN COPYLIB.
003800 COPY TBLOWUP    IN COPYLIB.
003900 COPY CSWITCHF   IN COPYLIB.
      *------ WS CONTROL AREA
       01  MAJOR-MINOR                   PIC XXXX.
       01  WS-CONTROL.
           05  FUNCTION-NUM              PIC XX.
               88  EXIT-KEY-F8-USED                 VALUE "08".
               88  REFRESH-KEY-F4-USED              VALUE "04".
               88  ENTER-KEY-USED                   VALUE "00".
               88  F1-KEY-USED                      VALUE "01".
               88  F2-KEY-USED                      VALUE "02".
               88  F3-KEY-USED                      VALUE "03".
               88  F4-KEY-USED                      VALUE "04".
               88  F5-KEY-USED                      VALUE "05".
               88  F6-KEY-USED                      VALUE "06".
               88  F7-KEY-USED                      VALUE "07".
               88  F8-KEY-USED                      VALUE "08".
           05  FUN-KEY REDEFINES FUNCTION-NUM  PIC XX.
           05  TERMINAL-ID               PIC X(10).
           05  FORMAT-NAME               PIC X(10).

       01  DISPLAY-STATUS                PIC X(2).

       COPY IOFEEDBACK IN COPYLIB.
       COPY CATREAD    IN COPYLIB.
004000 01  FORMFILE                      PIC X(31) VALUE "FEASETUP".
004100
004200**************************************************************
004300**                                                          **
004400**                  V I E W   W O R K                       **
004500**                                                          **
004600**************************************************************
004700
004800**  SEE LINKAGE SECTION FOR VIEW-COMAREA
004900
005000 01  MESSAGE-BUFFER.
005100     05  MSG-TEXT.
               10  MESSAGE-BUFFER-1        PIC X(1).
               10  FILLER                  PIC X(67).
005200     05  MSG-FLD          PIC X(8)   VALUE SPACES.
005300     05  MSG-FLD-9 REDEFINES MSG-FLD PIC ZZZZZZZ9.
005400
005800 01  FIELD-NUMBER         PIC S9(4) COMP-4 VALUE 1.
005900
       01  FUNC-SCREEN.
           05  FUNC-CMD-LINE            PIC X(79).
           05  FUNC-ERR-LINE            PIC X(79).

006000**************************************************************
006100**                                                          **
006200**            D A T A B A S E   W O R K                     **
006300**                                                          **
006400**************************************************************
       01  FILE-STATUS.
           05  FILE-STATUS-1            PIC X  VALUE "0".
           05  FILE-STATUS-2            PIC X  VALUE "0".
006500
006600 COPY DBSTAT     IN COPYLIB.
006700 01  DSET-NAMES.
006800     05  DSET-MVALIDPLT  PIC X(16) VALUE "MVALIDPLTDATA;".
006900
007000 01  MODE-AREA.
007100     05  MODE1                     PIC S9(4)   COMP       VALUE 1.
007200     05  MODE3                     PIC S9(4)   COMP       VALUE 3.
007300     05  MODE5                     PIC S9(4)   COMP       VALUE 5.
007400     05  MODE7                     PIC S9(4)   COMP       VALUE 7.
007500
007600 01  ALL-ITEMS                     PIC X(2)  VALUE "@;".
007700 01  PLTDATA-ARG.
007800     10  PLTDATA-ARG-1-2           PIC X(2).
007900     10  PLTDATA-ARG-3-10.
008000         15  PLTDATA-REQ-DEPT      PIC X(4).
008100         15  PLTDATA-CHARGE-DEPT   PIC X(4).
008200
008300**************************************************************
008400**                                                          **
008500**           D A T A B A S E   B U F F E R S                **
008600**                                                          **
008700**************************************************************
008800
008900 COPY MVALDPLT   IN COPYLIB.
009000
009100**************************************************************
009200**                                                          **
009300**                  S C R E E N   D A T A                   **
009400**                                                          **
009500**************************************************************
009600
009700 01  DE-FIELDS.
009800     05  DE-REQ-DEPT               PIC X(4).
009900     05  DE-CHARGE-DEPT            PIC X(4).
010000     05  DE-FLAG                   PIC X(4).
           05  DE-COMMAND-LINE           PIC X(79).
           05  DE-MESSAGE-LINE           PIC X(79).
010100
       01  DE-FIELDS-X.
           05  DE-DEPT-TO-EXPLODE        PIC X(4).
           05  DE-DEPTS-TO-X-TO.
               10  DE-DEPTS-TO-X OCCURS 10 TIMES.
                   15  X-DEPTS           PIC X(4).
           05  DE-COMMAND-LINE-X         PIC X(79).
           05  DE-MESSAGE-LINE-X         PIC X(79).

       01  DE-FIELDS-X1.
           05  DE-DEPT-TO-MODIFY         PIC X(4).
           05  DE-COMMAND-LINE-X1        PIC X(79).
           05  DE-MESSAGE-LINE-X1        PIC X(79).

010200**************************************************************
010300**                                                          **
010400**            L I N K A G E   S E C T I O N                 **
010500**                                                          **
010600**************************************************************
010700
010800 LINKAGE SECTION.
010900 01  BASE                      PIC X(10).
011000 01  MMIS-BASE                 PIC X(13).
011100
011200 COPY VCOMLINK   IN COPYLIB.
011300 COPY TSHWSUB2   IN COPYLIB.
011400 COPY LANGSUB    IN COPYLIB.
011500
011600 PROCEDURE DIVISION USING BASE
011700                          MMIS-BASE,
011800                          VIEW-COMAREA,
011900                          SRF-COMAREA,
012000                          LANGUAGE-PARMS.
012100
012200 1-HSK.
           OPEN I-O DISPLAY-FILE, MVALIDPLT-O.
012300     PERFORM 6000-MAIN THRU 6990-MAIN-X.
           CLOSE DISPLAY-FILE, MVALIDPLT-O.
012400     GOBACK.
012500
012600 2100-BLOWUP.
012700     MOVE "SEASETDP"               TO   BU-PGM-NAME.
012800     CALL "TBLOWUP" USING BASE BU-PGM-NAME STATUS-AREA
012900       VIEW-COMAREA FILE-STATUS BU-DISPLAY-MSG
013000       BU-DISPLAY-FLDS.
013100
015900 4020-CLEAR-FORM.
016000     MOVE SPACES TO MESSAGE-BUFFER.
017200     MOVE SPACES                   TO   DE-FIELDS.
017400
015200 4030-SETERROR.
           MOVE B"1" TO IND (99).
           MOVE B"1" TO IND (FIELD-NUMBER).
           MOVE MESSAGE-BUFFER TO DE-MESSAGE-LINE.
051300
018200******************************************************************
018300**                                                              **
018400**           D E P T S  M A I N   M E N U                       **
018500**                                                              **
018600******************************************************************
018700 6000-MAIN.
           MOVE "EADPMENU"               TO   VIEW-NFNAME.
           MOVE SPACES                   TO   FUNC-SCREEN.
           MOVE FUNC-SCREEN              TO   DISPLAY-REC.
           PERFORM 998-WRITE-SCREEN THRU 998-READ-SCREEN.
           MOVE DISPLAY-REC              TO   FUNC-SCREEN.
           IF VIEW-LASTKEY = 1
               PERFORM 6700-SETUP-EXPLODE THRU 6700-SE-X
               GO TO 6000-MAIN.

           IF VIEW-LASTKEY = 3 GO TO 6990-MAIN-X.

018800     MOVE "EADEPTMN"               TO   VIEW-NFNAME.
019000     PERFORM 4020-CLEAR-FORM.
019100
019200     MOVE 2                        TO   SRF-KEYSET.
019300     MOVE "I"                      TO   SRF-FKEY (6),
019400                                        SRF-FKEY (7).
019500     MOVE "N"                      TO   SRF-ENTER-FLAG.
       6010-SHOWFORM.
           MOVE DE-FIELDS TO DISPLAY-REC.
           PERFORM 998-WRITE-SCREEN THRU 998-READ-SCREEN.
           MOVE DISPLAY-REC TO DE-FIELDS.
           IF MESSAGE-BUFFER-1 NOT = SPACES
               PERFORM 4030-SETERROR
               GO TO 6010-SHOWFORM.

020200     IF VIEW-LASTKEY = 3
020300         GO TO 6000-MAIN.
020400
020500     IF VIEW-LASTKEY = 1
020600         PERFORM 6300-ADD THRU 6390-A-X
020700     ELSE
020800     IF VIEW-LASTKEY = 2
020900         PERFORM 6500-DEL THRU 6590-MD-X
021000     ELSE
021100     IF VIEW-LASTKEY = 8
021200         PERFORM 6600-DEPT-INQUIRY THRU 6690-LI-X.
021300
021400     GO TO 6000-MAIN.
021500
021600******************************************************************
021700**                                                              **
021800**       A D D    D E P T S                                     **
021900**                                                              **
022000******************************************************************
022100 6300-ADD.
022200     MOVE "EADEPTAD"               TO   VIEW-NFNAME.
022400     PERFORM 4020-CLEAR-FORM.
022500
022600 6310-SHOW-ADD-FORM.
022700     MOVE 7                        TO   SRF-KEYSET.
       6310-SHOWFORM.
           MOVE DE-FIELDS TO DISPLAY-REC.
           PERFORM 998-WRITE-SCREEN THRU 998-READ-SCREEN.
           MOVE DISPLAY-REC TO DE-FIELDS.
           IF MESSAGE-BUFFER-1 NOT = SPACES
               PERFORM 4030-SETERROR
               GO TO 6310-SHOWFORM.

023400     IF VIEW-LASTKEY = 3
023500         GO TO 6390-A-X.
023600
023900     PERFORM 7000-GET-MVALIDPLTDATA.
024000     IF FILE-STATUS = "00"
024100*        "E44: ENTRY ALREADY EXISTS"
               PERFORM 7010-UNLOCK-MVALIDPLT
024200         MOVE   5                  TO   LANG-SETNUM
024300         MOVE  44                  TO   LANG-MSGNUM
024400         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
024500         PERFORM 4030-SETERROR
024600         GO TO 6310-SHOW-ADD-FORM.
024700
024800     PERFORM 7030-MOVE-TO-DB.
024900
025200*    CALL "DBPUT" USING BASE, DSET-MVALIDPLT, MODE1, STATUS-AREA,
025300*      ALL-ITEMS, BUF-MVALIDPLTDATA.
           WRITE MVALIDPLT-REC-O FROM BUF-MVALIDPLTDATA
               INVALID KEY MOVE 99 TO COND-WORD.
           IF FILE-STATUS NOT = "00"
025500         MOVE "DBPUT ERR MVALIDPLTDATA 6110-SAF" TO BU-DISPLAY-MSG
025600         PERFORM 2100-BLOWUP.
025700
025900     PERFORM 4020-CLEAR-FORM.
026000     GO TO 6310-SHOW-ADD-FORM.
026100
026200 6390-A-X.
026300     EXIT.
026400
026500******************************************************************
026600**                                                              **
026700**              D E L E T E   D E P T S                         **
026800**                                                              **
026900******************************************************************
027000 6500-DEL.
027100     MOVE "EADEPTDL"           TO   VIEW-NFNAME.
027300     PERFORM 4020-CLEAR-FORM.
027400
027500 6510-SHOW-DEL-FORM-1.
027600     MOVE 7                        TO   SRF-KEYSET.
       6510-SHOWFORM.
           MOVE DE-FIELDS TO DISPLAY-REC.
           PERFORM 998-WRITE-SCREEN THRU 998-READ-SCREEN.
           MOVE DISPLAY-REC TO DE-FIELDS.
           IF MESSAGE-BUFFER-1 NOT = SPACES
               PERFORM 4030-SETERROR
               GO TO 6510-SHOWFORM.

028300     IF VIEW-LASTKEY = 3
028400         GO TO 6590-MD-X.
028500
028800     PERFORM 7000-GET-MVALIDPLTDATA.
028900     IF FILE-STATUS-1 = "2"
029000*        "E45: ENTRY DOES NOT EXIST"
029100         MOVE  5                   TO   LANG-SETNUM
029200         MOVE 45                   TO   LANG-MSGNUM
029300         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
029400         PERFORM 4030-SETERROR
029500         GO TO 6510-SHOW-DEL-FORM-1.
029600
030300 6530-SHOW-DEL-FORM-2.
030400*----- f1 f2 f3 f6 INVALID, f4 REFRESH, f5 PRT, f7 CLR, f8 EXIT
           MOVE "EADEPTDL2"              TO   VIEW-NFNAME.
030500     MOVE 7                        TO   SRF-KEYSET.
       6535-SHOWFORM.
           PERFORM 7010-UNLOCK-MVALIDPLT.
           MOVE DE-FIELDS TO DISPLAY-REC.
           PERFORM 998-WRITE-SCREEN THRU 998-READ-SCREEN.
           MOVE DISPLAY-REC TO DE-FIELDS.
           IF MESSAGE-BUFFER-1 NOT = SPACES
               PERFORM 4030-SETERROR
               GO TO 6535-SHOWFORM.

031200     IF VIEW-LASTKEY = 3
031300         PERFORM 4020-CLEAR-FORM
031400         GO TO 6500-DEL.
031500
           PERFORM 7000-GET-MVALIDPLTDATA.
031800     PERFORM 7030-MOVE-TO-DB.
031900
032000*    CALL "DBDELETE" USING BASE, DSET-MVALIDPLT, MODE1,
032100*      STATUS-AREA
           DELETE MVALIDPLT-O INVALID KEY MOVE "2" TO FILE-STATUS-1.
           IF FILE-STATUS NOT = "00"
032300         MOVE "DBDELETE ERR 6530-SFM2" TO BU-DISPLAY-MSG
032400         PERFORM 2100-BLOWUP.
032500
032800     GO TO 6500-DEL.
032900
033000 6590-MD-X.
033100     EXIT.
033200
033300 6600-DEPT-INQUIRY.
033400     MOVE "FCSISINQ"               TO   CSF-NEW-FORMFILE-NAME.
033500     MOVE "N"                      TO   CSF-MODE.
033600     PERFORM 7150-CALL-CSWITCHF.
033700     IF CSF-OPENFORM-ERR-SW = "Y"
033800         GO TO 6690-LI-X.
033900
034000     CALL "SEADPTIQ" USING BASE, MMIS-BASE, VIEW-COMAREA,
034100       SRF-COMAREA, LANGUAGE-PARMS.
034200
034300     MOVE "O"                      TO   CSF-MODE.
034400     PERFORM 7150-CALL-CSWITCHF.
034500
034600 6690-LI-X.
034700     EXIT.
034800
       6700-SETUP-EXPLODE.
           MOVE "FEAXDPMN"               TO   VIEW-NFNAME.
           MOVE SPACES                   TO   FUNC-SCREEN.
           MOVE FUNC-SCREEN              TO   DISPLAY-REC.
           PERFORM 998-WRITE-SCREEN THRU 998-READ-SCREEN.
           MOVE DISPLAY-REC              TO   FUNC-SCREEN.
           IF VIEW-LASTKEY = 1
               MOVE "FEAXDEPA"           TO   VIEW-NFNAME
               MOVE SPACES               TO   DE-FIELDS-X
               PERFORM 6700-ADD-XDEPS THRU 6700-AX-X
           ELSE
           IF VIEW-LASTKEY = 2
               MOVE "FEAXDPM1"           TO   VIEW-NFNAME
               MOVE SPACES               TO   DE-FIELDS-X1
               PERFORM 6700-MOD-XDEPS THRU 6700-MX-X
           ELSE
           IF VIEW-LASTKEY = 3
               GO TO 6700-SE-X
           ELSE
           IF VIEW-LASTKEY = 4
               PERFORM 6700-INQ-XDEPS THRU 6700-IX-X
           ELSE
           IF VIEW-LASTKEY = 8
               MOVE "FEAXDPD1"           TO   VIEW-NFNAME
               MOVE SPACES               TO   DE-FIELDS-X1
               PERFORM 6700-DEL-XDEPS THRU 6700-DX-X.
           GO TO 6700-SETUP-EXPLODE.

       6700-SE-X.    EXIT.

       6700-ADD-XDEPS.
           MOVE DE-FIELDS-X   TO  DISPLAY-REC.
           PERFORM 998-WRITE-SCREEN THRU 998-READ-SCREEN.
           MOVE DISPLAY-REC   TO  DE-FIELDS-X.
           IF VIEW-LASTKEY = 3 GO TO 6700-AX-X.
           IF VIEW-LASTKEY NOT = 0
               MOVE  9 TO LANG-SETNUM
               MOVE 10 TO LANG-MSGNUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER TO DE-MESSAGE-LINE-X
               MOVE B"1" TO IND (99)
               GO TO 6700-ADD-XDEPS.
           MOVE SPACES TO PLTDATA-ARG.
           MOVE "ED"   TO PLTDATA-ARG-1-2.
           MOVE DE-DEPT-TO-EXPLODE TO PLTDATA-REQ-DEPT.
           MOVE PLTDATA-ARG   TO VALDTAKEY OF MVALIDPLT-REC-O
           READ MVALIDPLT-O INTO BUF-MVALIDPLTDATA
               INVALID KEY    MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS = "00"
               MOVE  5 TO LANG-SETNUM
               MOVE 82 TO LANG-MSGNUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER TO DE-MESSAGE-LINE-X
               MOVE 1 TO FIELD-NUMBER
               MOVE B"1" TO IND (1) IND (99)
               GO TO 6700-ADD-XDEPS.
           MOVE 0      TO FIELD-NUMBER,
                          SUB.
           PERFORM 67000-EDIT-DEPTS.
           IF FIELD-NUMBER NOT = 0 GO TO 6700-ADD-XDEPS.
           PERFORM 67001-WRITE-XDEPS.
           MOVE SPACES TO DE-FIELDS-X.
           GO TO 6700-ADD-XDEPS.
       6700-AX-X.    EXIT.

       67000-EDIT-DEPTS.
           ADD 1 TO SUB.
           IF SUB > 10 OR X-DEPTS (SUB) = "    "
               MOVE "99" TO FILE-STATUS
           ELSE
           MOVE SPACES TO PLTDATA-ARG
           MOVE "DP" TO PLTDATA-ARG-1-2
           MOVE X-DEPTS (SUB) TO PLTDATA-REQ-DEPT
           MOVE PLTDATA-ARG   TO VALDTAKEY OF MVALIDPLT-REC-O
           READ MVALIDPLT-O INTO BUF-MVALIDPLTDATA
               INVALID KEY    MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS = "00"
               GO TO 67000-EDIT-DEPTS
           ELSE
           IF FILE-STATUS = "99"
               NEXT SENTENCE
           ELSE
           MOVE  9  TO LANG-SETNUM
           MOVE 65  TO LANG-MSGNUM
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
           ADD  1 TO SUB GIVING FIELD-NUMBER
           MOVE B"1" TO IND (99) IND (FIELD-NUMBER)
           MOVE MESSAGE-BUFFER TO DE-MESSAGE-LINE-X.

       67001-WRITE-XDEPS.
           MOVE SPACES                 TO  PLTDATA-ARG,
                                           BUF-MVALIDPLTDATA.
           MOVE "ED"                   TO  PLTDATA-ARG-1-2.
           MOVE DE-DEPT-TO-EXPLODE     TO  PLTDATA-REQ-DEPT.
           MOVE PLTDATA-ARG            TO  VALID-DATA-KEY.
           MOVE DE-DEPTS-TO-X-TO       TO  VALID-EXPLODE-DEPTS.
           WRITE MVALIDPLT-REC-O FROM BUF-MVALIDPLTDATA
               INVALID KEY    MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE "WRITE OF X-DEPTS FAILED " TO BU-DISPLAY-MSG
               PERFORM 2100-BLOWUP.

       6700-MOD-XDEPS.
           MOVE DE-FIELDS-X1           TO  DISPLAY-REC.
           PERFORM 998-WRITE-SCREEN THRU 998-READ-SCREEN.
           IF VIEW-LASTKEY = 3 GO TO 6700-MX-X.
           MOVE DISPLAY-REC            TO  DE-FIELDS-X1.
       6700-MX-READ.
           MOVE SPACES                 TO  PLTDATA-ARG.
           MOVE "ED"                   TO  PLTDATA-ARG-1-2.
           MOVE DE-DEPT-TO-MODIFY      TO  PLTDATA-REQ-DEPT.
           MOVE PLTDATA-ARG            TO  VALDTAKEY OF MVALIDPLT-REC-O.
           READ MVALIDPLT-O INTO BUF-MVALIDPLTDATA
               INVALID KEY    MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE 09043              TO  CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER     TO  DE-MESSAGE-LINE-X1
               MOVE B"1"               TO  IND (1) IND (99)
               GO TO 6700-MOD-XDEPS.
       6700-SETUP-MODIFY.
           MOVE "FEAXDPM2"             TO  VIEW-NFNAME.
           MOVE SPACES                 TO  DE-FIELDS-X.
           MOVE DE-DEPT-TO-MODIFY      TO  DE-DEPT-TO-EXPLODE.
           MOVE VALID-EXPLODE-DEPTS    TO  DE-DEPTS-TO-X-TO.
       6700-PROCESS-MODIFY.
           MOVE DE-FIELDS-X            TO  DISPLAY-REC.
           PERFORM 998-WRITE-SCREEN THRU 998-READ-SCREEN.
           IF VIEW-LASTKEY = 3
               MOVE "FEAXDPM1"         TO  VIEW-NFNAME
               MOVE SPACES             TO  DE-FIELDS-X1
               GO TO 6700-MOD-XDEPS.
           MOVE DISPLAY-REC            TO  DE-FIELDS-X.
           MOVE 0                      TO  FIELD-NUMBER,
                                           SUB.
           PERFORM 67000-EDIT-DEPTS.
           IF FIELD-NUMBER NOT = 0 GO TO 6700-PROCESS-MODIFY.
           PERFORM 6700-MX-READ.
           MOVE DE-DEPTS-TO-X-TO       TO  VALID-EXPLODE-DEPTS.
           REWRITE MVALIDPLT-REC-O FROM BUF-MVALIDPLTDATA
               INVALID KEY    MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE "REWRITE MVALIDPLTDATA FAILED - 6700 MOD"
                   TO BU-DISPLAY-MSG
               PERFORM 2100-BLOWUP.
           MOVE "FEAXDPM1"             TO  VIEW-NFNAME.
           MOVE SPACES                 TO  DE-FIELDS-X1.
           GO TO 6700-MOD-XDEPS.

       6700-MX-X.    EXIT.

       6700-INQ-XDEPS.
033400     MOVE "FCSISINQ"               TO   CSF-NEW-FORMFILE-NAME.
033500     MOVE "N"                      TO   CSF-MODE.
033600     PERFORM 7150-CALL-CSWITCHF.
033700     IF CSF-OPENFORM-ERR-SW = "Y"
033800         GO TO 6700-IX-X.
033900
034000     CALL "SEADPXIQ" USING BASE, MMIS-BASE, VIEW-COMAREA,
034100       SRF-COMAREA, LANGUAGE-PARMS.
034200
034300     MOVE "O"                      TO   CSF-MODE.
034400     PERFORM 7150-CALL-CSWITCHF.
034500
       6700-IX-X.    EXIT.

       6700-DEL-XDEPS.
           MOVE DE-FIELDS-X1           TO  DISPLAY-REC.
           PERFORM 998-WRITE-SCREEN THRU 998-READ-SCREEN.
           IF VIEW-LASTKEY = 3 GO TO 6700-DX-X.
           MOVE DISPLAY-REC            TO  DE-FIELDS-X1.
           MOVE SPACES                 TO  PLTDATA-ARG.
           MOVE "ED"                   TO  PLTDATA-ARG-1-2.
           MOVE DE-DEPT-TO-MODIFY      TO  PLTDATA-REQ-DEPT.
           MOVE PLTDATA-ARG            TO  VALDTAKEY OF MVALIDPLT-REC-O.
           READ MVALIDPLT-O INTO BUF-MVALIDPLTDATA
               INVALID KEY    MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE 09043              TO  CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER     TO  DE-MESSAGE-LINE-X1
               MOVE B"1"               TO  IND (1) IND (99)
               GO TO 6700-DEL-XDEPS.
           DELETE MVALIDPLT-O RECORD
               INVALID KEY    MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE "DELETE ERROR MVALIDPLTDATA - 6700 DEL"
                   TO BU-DISPLAY-MSG
               PERFORM 2100-BLOWUP.
           MOVE SPACES                 TO  DE-FIELDS-X1.
           GO TO 6700-DEL-XDEPS.
       6700-DX-X.    EXIT.

034900 6990-MAIN-X.
035000     EXIT.
035100
035200******************************************************************
035300**                                                              **
035400**      P E R F O R M E D   R O U T I N E S                     **
035500**                                                              **
035600******************************************************************
035700 7000-GET-MVALIDPLTDATA.
035800     MOVE "RC"                     TO   PLTDATA-ARG-1-2.
035900     MOVE DE-REQ-DEPT              TO   PLTDATA-REQ-DEPT.
036000     MOVE DE-CHARGE-DEPT           TO   PLTDATA-CHARGE-DEPT.
036100*    CALL "DBGET" USING BASE, DSET-MVALIDPLT, MODE7, STATUS-AREA,
036200*      ALL-ITEMS, BUF-MVALIDPLTDATA, PLTDATA-ARG.
           MOVE PLTDATA-ARG TO VALDTAKEY OF MVALIDPLT-REC-O.
           READ MVALIDPLT-O INTO BUF-MVALIDPLTDATA
               INVALID KEY MOVE 17 TO COND-WORD.
036300     IF FILE-STATUS = "00" OR FILE-STATUS-1 = "2"
036400         NEXT SENTENCE
036500     ELSE
036600         MOVE "DBGET ERR 7000-GM" TO BU-DISPLAY-MSG
036700         PERFORM 2100-BLOWUP.
036800
       7010-UNLOCK-MVALIDPLT.
      *------- DO A START > HIGH-VALUES TO UNLOCK
           MOVE HIGH-VALUES TO VALDTAKEY OF MVALIDPLT-REC-O.
           START MVALIDPLT-O KEY > VALDTAKEY OF MVALIDPLT-REC-O
               INVALID KEY MOVE "00" TO FILE-STATUS.

038200 7030-MOVE-TO-DB.
038300     MOVE SPACES                   TO   BUF-MVALIDPLTDATA.
038400     MOVE "RC"                     TO   PLTDATA-ARG-1-2.
038500     MOVE DE-REQ-DEPT              TO   PLTDATA-REQ-DEPT.
038600     MOVE DE-CHARGE-DEPT           TO   PLTDATA-CHARGE-DEPT.
038700     MOVE PLTDATA-ARG              TO   VALID-DATA-KEY.
038800     MOVE DE-FLAG                  TO   VALID-DATA-DESC.
038900
039000 7150-CALL-CSWITCHF.
039100     CALL "CSWITCHF" USING VIEW-COMAREA, LANGUAGE-PARMS,
039200       FORMFILE, CSF-PARMS, BU-DISPLAY-MSG.
039300     IF BU-DISPLAY-MSG-1 NOT = SPACES
039400         PERFORM 2100-BLOWUP.
039500
       COPY DISPCALL IN COPYLIB.
039600 999-CATREAD.
           IF CATREAD-MSG-NUMBER = ZEROS
               MOVE LANG-SETNUM TO CATREAD-MSG-SET
               MOVE LANG-MSGNUM TO CATREAD-MSG-NUM.
           CALL "CCATREAD" USING CATREAD-PARMS.
           MOVE CATREAD-MSG-TEXT TO MESSAGE-BUFFER.
041200 999-CATREAD-EXIT.
041300     EXIT.
