011200 01  DE-FIELDS.
011300     05  DE-PATH.
011400         10  DE-PATH-PREFIX        PIC X(1).
011500         10  DE-PATH-NUMBER        PIC X(3).
011600     05  V-PATH-DESC               PIC X(30).
011700     05  V-MIN-VAL                 PIC Z(13)9.
011800     05  V-MAX-VAL                 PIC Z(13)9.
011900     05  V-WO-APPROVE              PIC X(1).
012000     05  V-PATH-LEVEL-AREA.
012100         10  V-PATH-LEVEL OCCURS 10 TIMES PIC X(2).
012200     05  V-INORD-SIMEL-AREA.
012300         10  V-INORD-SIMEL OCCURS 10 TIMES PIC X(1).
012400     05  V-PATHDEF-AREA.
012500         10  V-PATHDEF-LINE OCCURS 15 TIMES.
012600             15  V-INCL-EXCL       PIC X(7).
012700             15  V-TYPE            PIC X(16).
012800             15  V-LOW-VALUE       PIC X(14).
012900             15  V-TO-MSG          PIC X(3).
013000             15  V-HIGH-VALUE      PIC X(14).
           05  DE-COMMAND-LINE-1         PIC X(79).
           05  DE-MESSAGE-LINE-1         PIC X(79).
013100
013200 01  DE-FIELDS-2.
013300     05  V2-PATH.
013400         10  V2-PATH-PREFIX        PIC X(1).
013500         10  V2-PATH-NUMBER        PIC X(3).
013600     05  V2-PATH-DESC              PIC X(30).
013700     05  V2-MIN-VAL                PIC X(14).
013800     05  V2-MAX-VAL                PIC X(14).
013900     05  V2-WO-APPROVE             PIC X(1).
014000     05  V2-PRINT-OPTION           PIC X(1).
014100     05  V2-CATEGORY               PIC X(1).
014200     05  V2-PATH-LEVEL-AREA.
014300         10  V2-PATH-LEVEL-LINE OCCURS 10 TIMES.
014400             15  V2-PATH-LEVEL     PIC X(2).
014500             15  V2-INORD-SIMEL    PIC X(1).
014600             15  V2-LEVEL-DESC     PIC X(36).
014700             15  V2-ACTIVE-EMPL    PIC X(4).
014800             15  V2-ACTIVE-EMPL-NM PIC X(16).
           05  DE-COMMAND-LINE-2         PIC X(79).
           05  DE-MESSAGE-LINE-2         PIC X(79).
014900
015000**************************************************************
015100**                                                          **
015200**            L I N K A G E   S E C T I O N                 **
015300**                                                          **
015400**************************************************************
015500
015600 LINKAGE SECTION.
015700 01  BASE                      PIC X(10).
015800 01  BASE-MMISA                 PIC X(13).
015900
016000 COPY VCOMLINK   IN COPYLIB.
016100 COPY TSHWSUB2   IN COPYLIB.
016200 COPY LANGSUB    IN COPYLIB.
016300
016400 PROCEDURE DIVISION USING BASE
016500                          BASE-MMISA,
016600                          VIEW-COMAREA,
016700                          SRF-COMAREA,
016800                          LANGUAGE-PARMS.
016900
017000 1-HSK.
           OPEN INPUT MPATH-I, MLEVEL-I, PER-PERSONNEL-I,
             DPATHDEF-I.
           OPEN I-O DISPLAY-FILE.
017100*    "INCLUDE"
017200     MOVE  63                      TO   LANG-SETNUM.
017300     MOVE   1                      TO   LANG-MSGNUM.
017400     PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
017500     MOVE MESSAGE-BUFFER           TO   INCLUDE-LITERAL.
017600*    "EXCLUDE"
017700     MOVE   2                      TO   LANG-MSGNUM.
017800     PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
017900     MOVE MESSAGE-BUFFER           TO   EXCLUDE-LITERAL.
018000*    "ACCOUNTING CLASS"
018100     MOVE   3                      TO   LANG-MSGNUM.
018200     PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
018300     MOVE MESSAGE-BUFFER           TO   ACCOUNTING-CLASS-LITERAL.
018400*    "DEPARTMENT"
018500     MOVE   4                      TO   LANG-MSGNUM.
018600     PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
018700     MOVE MESSAGE-BUFFER           TO   DEPARTMENT-LITERAL.
018800*    "EXPENSE CLASS"
018900     MOVE   5                      TO   LANG-MSGNUM.
019000     PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
019100     MOVE MESSAGE-BUFFER           TO   EXPENSE-CLASS-LITERAL.
019200*    "BUDGET NUMBER"
019300     MOVE   6                      TO   LANG-MSGNUM.
019400     PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
019500     MOVE MESSAGE-BUFFER           TO   BUDGET-NUMBER-LITERAL.
019600
019700     PERFORM 6000-MAIN THRU 6990-MAIN-X.
           CLOSE MPATH-I, MLEVEL-I, PER-PERSONNEL-I, DPATHDEF-I.
           CLOSE DISPLAY-FILE.
019800     GOBACK.
019900
020000 2100-BLOWUP.
020100     MOVE "SEAPHIQ2"               TO   BU-PGM-NAME.
020200     CALL "TBLOWUP" USING BASE BU-PGM-NAME STATUS-AREA
020300       VIEW-COMAREA FILE-STATUS BU-DISPLAY-MSG
020400       BU-DISPLAY-FLDS.

022600 4015-SET-ERROR.
           MOVE B"1" TO IND (99).
           MOVE B"1" TO IND (FIELD-NUMBER).
           MOVE MESSAGE-BUFFER TO DE-MESSAGE-LINE-1.
           MOVE MESSAGE-BUFFER TO DE-MESSAGE-LINE-2.
023500     MOVE SPACES TO MESSAGE-BUFFER.
051300
023400 4020-CLEAR-FORM.
023500     MOVE SPACES TO MESSAGE-BUFFER.
024700     MOVE SPACES                   TO   DE-FIELDS.
024800     MOVE "R"                      TO   DE-PATH-PREFIX.

025900******************************************************************
026000**                                                              **
026100**             M A I N   P R O G R A M                          **
026200**                                                              **
026300******************************************************************
026400 6000-MAIN.
026500     MOVE "EAPHIQ2"                TO   VIEW-NFNAME.
026700     PERFORM 4020-CLEAR-FORM.
026800
026900 6010-SHOW-FIRST-FORM.
027000     MOVE 6                        TO   SRF-KEYSET.
027100     MOVE " AFE"                   TO   SRF-FKEY (1).
027200     MOVE "I"                      TO   SRF-FKEY (2)
027300                                        SRF-FKEY (7).
       6010-SHOWFORM.
           MOVE "000" TO DE-PATH-NUMBER.
           MOVE DE-FIELDS TO DISPLAY-REC.
           PERFORM 998-WRITE-SCREEN THRU 998-READ-SCREEN.
           MOVE DISPLAY-REC TO DE-FIELDS.
           IF MESSAGE-BUFFER-1 NOT = SPACES
               PERFORM 4015-SET-ERROR
               GO TO 6010-SHOWFORM.

028000     IF VIEW-LASTKEY = 3 GO TO 6990-MAIN-X.
028200
028500     PERFORM 7000-GET-MPATH.
028600     IF FILE-STATUS NOT = "00"
028700*        "E45: ENTRY DOES NOT EXIST"
028800         MOVE  5                   TO   LANG-SETNUM
028900         MOVE 45                   TO   LANG-MSGNUM
029000         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
029100         MOVE 1                    TO   FIELD-NUMBER
029200         PERFORM 4015-SET-ERROR
029300         GO TO 6010-SHOW-FIRST-FORM.
029400
029500     MOVE PATH-ARG                 TO   V2-PATH.
029600     MOVE MPATH-PATH-DESC          TO   V-PATH-DESC
029700                                        V2-PATH-DESC.
029800     MOVE MPATH-MIN-VAL            TO   V-MIN-VAL
029900                                        V2-MIN-VAL.
030000     MOVE MPATH-MAX-VAL            TO   V-MAX-VAL
030100                                        V2-MAX-VAL.
030200     MOVE MPATH-WO-APPROVE         TO   V-WO-APPROVE
030300                                        V2-WO-APPROVE.
030400     MOVE MPATH-PRINT-OPTION       TO   V2-PRINT-OPTION.
030500     MOVE MPATH-CATEGORY           TO   V2-CATEGORY.
030600
030700*------ GET ALL THE DETAILS OF PATH LEVELS AND LOAD TO SCRN 1
030800     PERFORM 7080-LOAD-PATH-LEVELS THRU 7089-LPL-X.
030900
031000*------ GET ALL THE PATH DEFINITIONS AND LOAD TO SCREEN
031100     PERFORM 7100-LOAD-PATH-DEFS THRU 7190-LPD-X.
031200
031300*------ f1 SHOWS THE LEVEL DETAIL (WITH LEVEL DESCRIPTIONS),
031400*------ 'ENTER' SHOWS THE PATH DEFINITIONS
031500     IF VIEW-LASTKEY = 1
031600         PERFORM 6200-SHOW-LEVEL-FORM THRU 6290-SLF-X
031700         IF VIEW-LASTKEY = 3
031800             GO TO 6000-MAIN
031900         ELSE
032000             MOVE "EAPHIQ2"        TO   VIEW-NFNAME.
032200
032500 6100-SHOW-SECOND-FORM.
032600     MOVE 2                        TO   SRF-KEYSET.
032700     MOVE "I"                      TO   SRF-FKEY (3)
                                              SRF-FKEY (6)
032800                                        SRF-FKEY (7).
       6110-SHOWFORM.
           MOVE DE-FIELDS TO DISPLAY-REC.
           PERFORM 998-WRITE-SCREEN THRU 998-READ-SCREEN.
           MOVE DISPLAY-REC TO DE-FIELDS.
           IF DPATHDEF-EOF-SW = "Y" AND VIEW-LASTKEY = 2
      *M        "I10: INVALID FUNCTION KEY"
                MOVE 9 TO LANG-SETNUM
                MOVE 10 TO LANG-MSGNUM
                MOVE 1 TO FIELD-NUMBER, SRF-ERROR-FLD
                PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
           IF MESSAGE-BUFFER-1 NOT = SPACES
               PERFORM 4015-SET-ERROR
               GO TO 6110-SHOWFORM.

033500     IF VIEW-LASTKEY = 1
033600         PERFORM 6200-SHOW-LEVEL-FORM THRU 6290-SLF-X
033700         IF VIEW-LASTKEY = 3
033800             GO TO 6000-MAIN
033900         ELSE
034000             MOVE "EAPHIQ2"        TO   VIEW-NFNAME
034400             GO TO 6100-SHOW-SECOND-FORM.
034500
           IF VIEW-LASTKEY = 2
               MOVE 0 TO SUB
               MOVE SPACES TO V-PATHDEF-AREA
               PERFORM 7110-LOAD-PATHDEF-LOOP THRU 7190-LPD-X
               GO TO 6110-SHOWFORM.

           IF VIEW-LASTKEY = 4
               PERFORM 7100-RESTART
               PERFORM 7100-LOAD-PATH-DEFS THRU 7190-LPD-X
               GO TO 6100-SHOW-SECOND-FORM.

034600     GO TO 6000-MAIN.
034700
034800 6200-SHOW-LEVEL-FORM.
034900     MOVE "EAPHIQ2B"               TO   VIEW-NFNAME.
035100
036000     MOVE 6                        TO   SRF-KEYSET.
036100     MOVE "I"                      TO   SRF-FKEY (2)
036200                                        SRF-FKEY (7).
       6210-SHOWFORM.
           MOVE DE-FIELDS-2 TO DISPLAY-REC.
           PERFORM 998-WRITE-SCREEN THRU 998-READ-SCREEN.
           MOVE DISPLAY-REC TO DE-FIELDS-2.
           IF MESSAGE-BUFFER-1 NOT = SPACES
               PERFORM 4015-SET-ERROR
               GO TO 6210-SHOWFORM.

036900 6290-SLF-X.
037000     EXIT.
037100
037200
037300 6990-MAIN-X.
037400     EXIT.
037500
037600******************************************************************
037700**                                                              **
037800**      P E R F O R M E D   R O U T I N E S                     **
037900**                                                              **
038000******************************************************************
038100 7000-GET-MPATH.
038200     MOVE DE-PATH                  TO   PATH-ARG.
038300*    CALL "DBGET" USING BASE, DSET-MPATH, MODE7, STATUS-AREA,
038400*      ALL-ITEMS, BUF-MPATH, PATH-ARG.
           MOVE PATH-ARG TO PATHNUM OF MPATH-REC-I.
           READ MPATH-I INTO BUF-MPATH
               INVALID KEY MOVE 17 TO COND-WORD.
038500     IF FILE-STATUS = "00" OR FILE-STATUS-1 = "2"
038600         NEXT SENTENCE
038700     ELSE
038800         MOVE "DBGET ERR 7000-GM" TO BU-DISPLAY-MSG
038900         PERFORM 2100-BLOWUP.
039000
039100 7080-LOAD-PATH-LEVELS.
039200     MOVE 0                        TO   SUB.
039300 7082-LOAD-PATH-LEVELS-LOOP.
039400     ADD 1                         TO   SUB.
039500     IF SUB > 10
039600         GO TO 7089-LPL-X.
039700
039800     MOVE MPATH-LEVEL (SUB)        TO   V-PATH-LEVEL (SUB)
039900                                        V2-PATH-LEVEL (SUB),
040000                                        LEVEL-ARG.
040100     MOVE MPATH-LV-O-S (SUB)       TO   V-INORD-SIMEL (SUB),
040200                                        V2-INORD-SIMEL (SUB).
040300     MOVE MPATH-EMPL (SUB)         TO   V2-ACTIVE-EMPL (SUB),
040400                                        EMPL-ARG.
040500
040600*    CALL "DBGET" USING BASE-MMISA, DSET-PER-PERSONNEL, MODE7,
040700*      STATUS-AREA, ALL-ITEMS, BUF-PER-PERSONNEL, EMPL-ARG.
           MOVE EMPL-ARG TO PERCCNUM OF PER-PERSONNEL-REC-I.
           READ PER-PERSONNEL-I INTO BUF-PER-PERSONNEL
               INVALID KEY MOVE 17 TO COND-WORD.
040800     IF FILE-STATUS = "00"
040900         MOVE PER-EMP-NAME         TO   V2-ACTIVE-EMPL-NM (SUB)
041000     ELSE
041100     IF FILE-STATUS-1 = "2"
041200         MOVE SPACES               TO   V2-ACTIVE-EMPL-NM (SUB)
041300     ELSE
041400         MOVE "DBGET ERR MMISA 7082-LPLL" TO BU-DISPLAY-MSG
041500         PERFORM 2100-BLOWUP.
041600
041700*    CALL "DBGET" USING BASE, DSET-MLEVEL, MODE7, STATUS-AREA,
041800*      ALL-ITEMS, BUF-MLEVEL, LEVEL-ARG.
           MOVE LEVEL-ARG TO LEVELNUM OF MLEVEL-REC-I.
           READ MLEVEL-I INTO BUF-MLEVEL
               INVALID KEY MOVE 17 TO COND-WORD.
041900     IF FILE-STATUS-1 = "2"
042000         MOVE SPACES               TO   BUF-MLEVEL
042100     ELSE
042200     IF FILE-STATUS NOT = "00"
042300         MOVE "DBGET ERR MLEVEL 7082-LPLL" TO BU-DISPLAY-MSG
042400         PERFORM 2100-BLOWUP.
042500
042600     MOVE MLEVEL-LEVEL-DESC        TO   V2-LEVEL-DESC (SUB).
042700
042800     GO TO 7082-LOAD-PATH-LEVELS-LOOP.
042900
043000 7089-LPL-X.
043100     EXIT.
043200
       7100-RESTART.
           MOVE "N"                      TO    DPATHDEF-EOF-SW.
           CLOSE DPATHDEF-I.
           OPEN INPUT DPATHDEF-I.

043300 7100-LOAD-PATH-DEFS.
           MOVE "N" TO DPATHDEF-EOF-SW.
           MOVE SPACES TO V-PATHDEF-AREA.
043400*    CALL "DBFIND" USING BASE, DSET-DPATHDEF, MODE1, STATUS-AREA,
043500*      PATH-SEARCH, PATH-ARG.
           MOVE PATH-ARG TO PATHNUM OF DPATHDEF-REC-I.
           START DPATHDEF-I KEY = PATHNUM OF DPATHDEF-REC-I
               INVALID KEY MOVE 17 TO COND-WORD.
043900
044000     MOVE ZERO                     TO   SUB.
044100 7110-LOAD-PATHDEF-LOOP.
044200*    CALL "DBGET" USING BASE, DSET-DPATHDEF, MODE5, STATUS-AREA,
044300*      ALL-ITEMS, BUF-DPATHDEF, PATH-ARG.
           MOVE 0 TO COND-WORD.
           READ DPATHDEF-I NEXT INTO BUF-DPATHDEF
               AT END MOVE 15 TO COND-WORD.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   MOVE 15 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.
           IF PATHNUM OF DPATHDEF-REC-I NOT = PATH-ARG
               MOVE 15 TO COND-WORD.
           IF COND-WORD NOT = 0
               MOVE "Y" TO DPATHDEF-EOF-SW.
044400     IF END-OF-CHAIN
044500         GO TO 7190-LPD-X
044600     ELSE
044700     IF NOT GOOD-CALL
044800         MOVE "DBGET ERR 7110-LPL" TO BU-DISPLAY-MSG
044900         PERFORM 2100-BLOWUP.
045000
045100     ADD 1                         TO   SUB.
045200     IF SUB > 15
045300         GO TO 7190-LPD-X.
045400
045500     IF DPATHD-INCL-EXCL-FLAG = "I"
045600         MOVE INCLUDE-LITERAL           TO   V-INCL-EXCL (SUB)
045700     ELSE
045800         MOVE EXCLUDE-LITERAL           TO   V-INCL-EXCL (SUB).
045900
046000     IF DPATHD-TYPE = "C"
046100         MOVE ACCOUNTING-CLASS-LITERAL  TO   V-TYPE (SUB)
046200     ELSE
046300     IF DPATHD-TYPE = "D"
046400         MOVE DEPARTMENT-LITERAL        TO   V-TYPE (SUB)
046500     ELSE
046600     IF DPATHD-TYPE = "E"
046700         MOVE EXPENSE-CLASS-LITERAL     TO   V-TYPE (SUB)
046800     ELSE
046900     IF DPATHD-TYPE = "B"
047000         MOVE BUDGET-NUMBER-LITERAL     TO   V-TYPE (SUB).
047100
047200     MOVE DPATHD-LOW-VALUE         TO   V-LOW-VALUE (SUB).
047300     MOVE DPATHD-HIGH-VALUE        TO   V-HIGH-VALUE (SUB).
047400     IF DPATHD-HIGH-VALUE > SPACES
047500         MOVE "- "                 TO   V-TO-MSG (SUB)
047600     ELSE
047700         MOVE SPACES               TO   V-TO-MSG (SUB).
047800
047900     GO TO 7110-LOAD-PATHDEF-LOOP.
048000
048100 7190-LPD-X.
048200     EXIT.
048300
       COPY DISPCALL IN COPYLIB.
048400 999-CATREAD.
           IF CATREAD-MSG-NUMBER = ZEROS
               MOVE LANG-SETNUM TO CATREAD-MSG-SET
               MOVE LANG-MSGNUM TO CATREAD-MSG-NUM.
           CALL "CCATREAD" USING CATREAD-PARMS.
           MOVE CATREAD-MSG-TEXT TO MESSAGE-BUFFER.
050000 999-CATREAD-EXIT.
050100     EXIT.
