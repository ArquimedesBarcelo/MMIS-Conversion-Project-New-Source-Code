001300
001400 ENVIRONMENT DIVISION.
001500 CONFIGURATION SECTION.
001600 SOURCE-COMPUTER.  HP-3000.
001700 OBJECT-COMPUTER.  HP-3000.
       SPECIAL-NAMES. I-O-FEEDBACK IS I-O-FEEDBACK-AREA.

       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT DISPLAY-FILE
DCR01             ASSIGN TO WORKSTATION-ZSEAPHIQ2-SI
                  ORGANIZATION IS TRANSACTION
                  ACCESS IS SEQUENTIAL
                  FILE STATUS IS DISPLAY-STATUS
                  CONTROL-AREA IS WS-CONTROL.

           SELECT MPATH-I
                  ASSIGN TO DATABASE-MCFLCS3901
                  ORGANIZATION IS INDEXED
                    ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                  FILE STATUS IS FILE-STATUS.

           SELECT MLEVEL-I
                  ASSIGN TO DATABASE-MCFLCS4101
                  ORGANIZATION IS INDEXED
                    ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                  FILE STATUS IS FILE-STATUS.

           SELECT PER-PERSONNEL-I
                  ASSIGN TO DATABASE-MCFLMM0301
                  ORGANIZATION IS INDEXED
                    ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                  FILE STATUS IS FILE-STATUS.

           SELECT DPATHDEF-I
                  ASSIGN TO DATABASE-MCFLCS4001
                  ORGANIZATION IS INDEXED
                    ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                    WITH DUPLICATES
                  FILE STATUS IS FILE-STATUS.

001800
001900 DATA DIVISION.
       FILE SECTION.
       FD  MPATH-I
           LABEL RECORDS ARE STANDARD.
       01  MPATH-REC-I.
           COPY DDS-MCRPCS3900  OF MCFLCS3901.

       FD  MLEVEL-I
           LABEL RECORDS ARE STANDARD.
       01  MLEVEL-REC-I.
           COPY DDS-MCRPCS4100  OF MCFLCS4101.

       FD  PER-PERSONNEL-I
           LABEL RECORDS ARE STANDARD.
       01  PER-PERSONNEL-REC-I.
           COPY DDS-MCRPMM0300  OF MCFLMM0301.

       FD  DPATHDEF-I
           LABEL RECORDS ARE STANDARD.
       01  DPATHDEF-REC-I.
           COPY DDS-MCRPCS4000  OF MCFLCS4001.

       FD  DISPLAY-FILE
           LABEL RECORDS ARE OMITTED.
       01  DISPLAY-REC        PIC X(2000).

002000 WORKING-STORAGE SECTION.
002100
002200 77  SUB                           PIC S9(4) COMP-4 VALUE 0.
       77  DPATHDEF-EOF-SW               PIC X     VALUE "N".
002300
002400 01  INCLUDE-LITERAL               PIC X(7).
002500 01  EXCLUDE-LITERAL               PIC X(7).
002600 01  ACCOUNTING-CLASS-LITERAL      PIC X(16).
002700 01  DEPARTMENT-LITERAL            PIC X(16).
002800 01  EXPENSE-CLASS-LITERAL         PIC X(16).
002900 01  BUDGET-NUMBER-LITERAL         PIC X(16).
