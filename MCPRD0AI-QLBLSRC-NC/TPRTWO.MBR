000200 IDENTIFICATION DIVISION.
000300 PROGRAM-ID.         TPRTWO.
000700*REMARKS.   ****THIS PROGRAM PRINTS THE CRAFTSMANS
000800*                   COPY OF A WORK ORDER****.
000900 ENVIRONMENT DIVISION.
001000 CONFIGURATION SECTION.
001100 SOURCE-COMPUTER.    AS400.
001200 OBJECT-COMPUTER.    AS400.
       COPY SPECIALN IN COPYLIB.
001500 INPUT-OUTPUT SECTION.
001600 FILE-CONTROL.
001800     SELECT CH-PRINT-FILE
               ASSIGN TO PRINTER-MCPRT.
           SELECT DISPLAY-FILE
               ASSIGN TO WORKSTATION-ZPLANNER-SI
               ORGANIZATION IS TRANSACTION
               ACCESS IS SEQUENTIAL
               FILE STATUS IS DSPLY-STATUS
               CONTROL-AREA IS WS-CONTROL.
           SELECT WO-LAST-NUM-USED
               ASSIGN TO DATABASE-MCFPMM0800
               ORGANIZATION IS RELATIVE
               ACCESS MODE IS RANDOM
               RELATIVE KEY IS ARG-NO
               FILE STATUS IS WLNU-STATUS.
           SELECT ZONE-SPOOLER-FILE
               ASSIGN TO DATABASE-MCFLZP0101
               ORGANIZATION IS INDEXED
               ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
               FILE STATUS IS ZSF-STATUS.
002000 DATA DIVISION.
002100 FILE SECTION.
002600 FD  CH-PRINT-FILE
002700     LABEL RECORDS ARE OMITTED
002800     RECORD CONTAINS 132 CHARACTERS.
002900 01  CH-PRINT-RECORD.
003000     05  CH-CARRIAGE-CTL         PIC X.
003100     05  CH-PRINT-AREA           PIC X(131).
       FD  DISPLAY-FILE
           LABEL RECORDS ARE OMITTED.
       01  DSPLY-REC                   PIC X(2000).
       FD  WO-LAST-NUM-USED
           LABEL RECORDS ARE STANDARD
           DATA RECORD IS WLNUREC.
       01  WLNUREC.
           COPY DDS-ALL-FORMATS OF MCFPMM0800.
       FD  ZONE-SPOOLER-FILE
           LABEL RECORDS ARE STANDARD
           DATA RECORD IS ZSFREC.
       01  ZSFREC.
           COPY DDS-ALL-FORMATS OF MCFLZP0101.
