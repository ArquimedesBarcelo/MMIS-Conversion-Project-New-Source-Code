021500 01  TEMPORARY-WO-NUM.
021600     05  TMP-WO-NUM-PRIME        PIC X(7).
021700     05  TMP-WO-NUM-SUFFIX       PIC X(3).
021800 01  CONDIT-CODE.
021900     05  COND-CODE               PIC X.
       COPY VCOMLINK IN COPYLIB.
022000 PROCEDURE DIVISION USING DBPARAMETERS WO-BASIC-DATA
022100                      TEMPORARY-WO-NUM CONDIT-CODE
                            VIEW-COMAREA.
022200 BEGIN.
022300     PERFORM 1-HSK THRU 1-HSK-EXIT.
022400     PERFORM 6-MAIN.
       2-EOJ.
           CLOSE DISPLAY-FILE.
033200     CLOSE CH-PRINT-FILE.
           CLOSE WO-LAST-NUM-USED.
           CLOSE ZONE-SPOOLER-FILE.
022800     GOBACK.
023200 1-HSK.
           OPEN I-O   DISPLAY-FILE.
           OPEN INPUT WO-LAST-NUM-USED.
           OPEN INPUT ZONE-SPOOLER-FILE.
           CALL "CLWHO" USING USERNAME TERMNUM CURRLIB JOBLIBX.
           MOVE 0 TO COND-WORD.
023800     MOVE 1 TO ARG-NO.
           READ WO-LAST-NUM-USED INTO LAST-WO-BUFF
               INVALID KEY   MOVE 17 TO COND-WORD.
           IF WLNU-STATUS NOT = "00" MOVE 17 TO COND-WORD.
           IF COND-WORD = 17 MOVE 1 TO DATE-FLAG-SW.
024100     MOVE DATE-FLAG TO DATE-CODE.
024200     IF PLANT-IDENT = "126 "
024300         IF WO-STATUS = "HL" OR "HA" OR "HM" OR "HS" OR "CW"
024400             IF CONDIT-CODE = "L"
024500                 NEXT SENTENCE
024600             ELSE
024700             GO TO 2-EOJ.
028500*    MOVE SPACES TO ZONE-SPOOLER-WA.
028800*    PERFORM 99-START-ZONE-SPOOLER-FILE.
029000*    IF COND-WORD = 17
029100*        MOVE 0  TO ZONE-SPOOLER-NUM-V
      *    ELSE
      *    PERFORM 99-READ-ZONE-SPOOLER-FILE
      *    IF COND-WORD = 15
           MOVE 0 TO ZONE-SPOOLER-NUM-V.
032500     MOVE ZONE-SPOOLER-NUM-V TO OVRPRTF-TOFILE-NUM.
           IF OVRPRTF-TOFILE-NUM = 0
               MOVE "P " TO OVRPRTF-TOFILE-NUM-X.
           PERFORM 996-OVERRIDE-PRINT-FILE.
025300     OPEN OUTPUT CH-PRINT-FILE.
       1-HSK-EXIT.    EXIT.

052700 6-MAIN.
052800     PERFORM 61-PRINT-LINE-1.
052900     PERFORM 62-PRINT-LINE-2.
053000     PERFORM 63-PRINT-LINE-3.
053100     PERFORM 64-PRINT-LINE-4.
053200     PERFORM 65-PRINT-LINE-5.
053300     PERFORM 66-PRINT-LINE-6.
053400     PERFORM 67-PRINT-LINE-7.
053500     PERFORM 68-PRINT-LINE-8.
053600     PERFORM 69-PRINT-LINE-9.
053700     PERFORM 6A-PRINT-LINE-10.
053800     PERFORM 6B-PRINT-LINE-11.
053900     PERFORM 6C-PRINT-LINE-12.
054000     PERFORM 6D-PRINT-LINE-13.
054100     PERFORM 6G-PRINT-LINE-16 THRU 6G-PL-16-EXIT.
054200     PERFORM 60-TOP-OF-PAGE.
054300 60-TOP-OF-PAGE.
054400     MOVE SPACES TO PRINT-LINE.
054500     MOVE PRINT-LINE TO CH-PRINT-RECORD.
054600*    WRITE CH-PRINT-RECORD AFTER ADVANCING NEW-PAGE.
054700     MOVE " " TO PRINT-LINE.
054800 61-PRINT-LINE-1.
054900     IF ZONE = "B1  " AND PLANT-IDENT = "129 "
055000         MOVE "" TO PRINT-LINE
055100         PERFORM 7-PRINT-A-LINE
055200         MOVE "" TO PRINT-LINE
055300         PERFORM 7-PRINT-A-LINE
055400         MOVE "" TO PRINT-LINE
055500         PERFORM 7-PRINT-A-LINE
055600     ELSE NEXT SENTENCE.
055700     MOVE SPACES TO PRINT-LINE.
055800     MOVE "                             W O R K   O R D E R
055900-         "                         " TO PRINT-LINE.
056000     PERFORM 7-PRINT-A-LINE.
056100 62-PRINT-LINE-2.
056200     MOVE SPACES TO PRINT-LINE.
056300     IF COND-CODE = "1"
056400         MOVE " TMP W/O NUM:" TO LINE-2-FIELD-1
056500         MOVE TMP-WO-NUM-PRIME TO LINE-2-FIELD-2
056600         MOVE "-" TO LINE-2-FIELD-3
056700         MOVE TMP-WO-NUM-SUFFIX TO LINE-2-FIELD-4.
056800     PERFORM 7-PRINT-A-LINE.
056900 63-PRINT-LINE-3.
057000     MOVE SPACES TO PRINT-LINE.
057100     MOVE " W/O NUM:" TO LINE-3-FIELD-1.
057200     MOVE WO-NUM-PRIM TO LINE-3-FIELD-2.
057300     MOVE "-" TO LINE-3-FIELD-3.
057400     MOVE WO-NUM-SUFF TO LINE-3-FIELD-4.
057500     MOVE "W/O STATUS:" TO LINE-3-FIELD-5.
057600     MOVE WO-STATUS TO LINE-3-FIELD-6.
057700     MOVE "TIME RECD:" TO LINE-3-FIELD-7.
057800     MOVE 4 TO DATE-MODE.
057900     MOVE DATE-RECD TO DATE-VALIDATE-IN.
058000     CALL "TDATECHK" USING DATE-CHECK-AREA.
058100     MOVE DATE-SLASH-OUT TO LINE-3-FIELD8-12.
058200     MOVE TIME-RECD-HH TO LINE-3-FIELD-13.
058300     MOVE ":" TO LINE-3-FIELD-14.
058400     MOVE TIME-RECD-MM TO LINE-3-FIELD-15.
058500     PERFORM 7-PRINT-A-LINE.
058600 64-PRINT-LINE-4.
058700     MOVE SPACES TO PRINT-LINE.
058800     MOVE " APPROVAL CODE:" TO LINE-4-FIELD-1.
058900     MOVE APPROVAL-CODE TO LINE-4-FIELD-2.
059000     MOVE "REQUESTER:" TO LINE-4-FIELD-3.
059100     MOVE REQUESTER-B TO LINE-4-FIELD-4.
059200     MOVE "EQUIP NUM:" TO LINE-4-FIELD-5.
059300     MOVE EQUIP-NUM TO LINE-4-FIELD-6.
059400     PERFORM 7-PRINT-A-LINE.
059500 65-PRINT-LINE-5.
059600     MOVE SPACES TO PRINT-LINE.
059700     MOVE " EQUIP NAME:" TO LINE-5-FIELD-1.
059800     MOVE EQUIP-NAME TO LINE-5-FIELD-2.
059900     MOVE "(" TO LINE-5-FIELD-3.
060000     MOVE TYPE-NUM TO LINE-5-FIELD-4.
060100     MOVE ")" TO LINE-5-FIELD-5.
060200     PERFORM 7-PRINT-A-LINE.
060300 66-PRINT-LINE-6.
060400     MOVE SPACES TO PRINT-LINE.
060500     MOVE " DEPT:" TO LINE-6-FIELD-1.
060600     MOVE DEPT TO LINE-6-FIELD-2.
060700     MOVE "MAINT ZONE:" TO LINE-6-FIELD-3.
060800     MOVE ZONE TO LINE-6-FIELD-4.
060900     MOVE "LOCATION:" TO LINE-6-FIELD-5.
061000     MOVE LOCATION TO LINE-6-FIELD-6.
061100     MOVE "PRIORITY:" TO LINE-6-FIELD-7.
061200     MOVE PRIORITY TO LINE-6-FIELD-8.
061300     PERFORM 7-PRINT-A-LINE.
061400 67-PRINT-LINE-7.
061500     MOVE SPACES TO PRINT-LINE.
061600     MOVE " EQUIP DOWN:" TO LINE-7-FIELD-1.
061700     MOVE EQUIP-DOWN TO LINE-7-FIELD-2.
061800     MOVE "CRAFTS REQT:" TO LINE-7-FIELD-3.
061900     MOVE CRAFTS-REQD-1 TO LINE-7-FIELD-4.
062000     MOVE CRAFTS-REQD-2 TO LINE-7-FIELD-5.
062100     MOVE CRAFTS-REQD-3 TO LINE-7-FIELD-6.
062200     MOVE "EXP CLASS:" TO LINE-7-FIELD-7.
062300     MOVE EXP-CLASS TO LINE-7-FIELD-8.
062400     PERFORM 7-PRINT-A-LINE.
062500 68-PRINT-LINE-8.
062600     MOVE SPACES TO PRINT-LINE.
062700     MOVE " DESCRIPTION:" TO LINE-8-FIELD-1.
062800     MOVE DESCRIPTION-1 TO LINE-8-FIELD-2.
062900     PERFORM 7-PRINT-A-LINE.
063000 69-PRINT-LINE-9.
063100     MOVE SPACES TO PRINT-LINE.
063200     MOVE " ADD'L INFO :" TO LINE-9-FIELD-1.
063300     MOVE DESCRIPTION-2-1 TO LINE-9-FIELD-2.
063400     PERFORM 7-PRINT-A-LINE.
063500 6A-PRINT-LINE-10.
063600     MOVE SPACES TO PRINT-LINE.
063700     MOVE DESCRIPTION-2-2 TO LINE-10-FIELD-1.
063800     PERFORM 7-PRINT-A-LINE.
063900 6B-PRINT-LINE-11.
064000     MOVE SPACES TO PRINT-LINE.
064100     PERFORM 7-PRINT-A-LINE.
064200 6C-PRINT-LINE-12.
064300     MOVE SPACES TO PRINT-LINE.
064400     MOVE " CRAFTSMEN:" TO LINE-12-FIELD-1.
064500     MOVE "TIME STRT:" TO LINE-12-FIELD-2.
064600     MOVE ":" TO LINE-12-FIELD-9.
064700     IF CONDIT-CODE = "9" OR "L"
064800         MOVE CRAFTSMEN-1 TO LINE-12-FIELD-CR1
064900         MOVE CRAFTSMEN-2 TO LINE-12-FIELD-CR2
065000         MOVE CRAFTSMEN-3 TO LINE-12-FIELD-CR3
065100         MOVE 4 TO DATE-MODE
065200         MOVE DATE-STRT TO DATE-VALIDATE-IN
065300         CALL "TDATECHK" USING DATE-CHECK-AREA
065400         MOVE DATE-SLASH-OUT TO LINE-12-FIELD3-7
065500         MOVE TIME-STRT-HH TO LINE-12-FIELD-8
065600         MOVE TIME-STRT-MM TO LINE-12-FIELD-10.
065700     PERFORM 7-PRINT-A-LINE.
065800 6D-PRINT-LINE-13.
065900     MOVE SPACES TO PRINT-LINE.
066000     MOVE " FAILURE CODE:" TO LINE-13-FIELD-1.
066100     MOVE "-" TO LINE-13-FIELD-3.
066200     MOVE "TIME COMP:" TO LINE-13-FIELD-5.
066300     MOVE ":" TO LINE-13-FIELD-12.
066400     IF CONDIT-CODE = "9" OR "L"
066500         MOVE FAIL-CODE-REASON TO LINE-13-FIELD-2
066600         MOVE FAIL-CODE-SUBSYS TO LINE-13-FIELD-4
066700         MOVE 4 TO DATE-MODE
066800         MOVE DATE-COMP TO DATE-VALIDATE-IN
066900         CALL "TDATECHK" USING DATE-CHECK-AREA
067000         MOVE DATE-SLASH-OUT TO LINE-13-FIELD6-10
067100         MOVE TIME-COMP-HH TO LINE-13-FIELD-11
067200         MOVE TIME-COMP-MM TO LINE-13-FIELD-13.
067300     PERFORM 7-PRINT-A-LINE.
067400 6G-PRINT-LINE-16.
067500     IF CRAFTS-REQD-1 = "IL" OR CRAFTS-REQD-2 = "IL"
067600         OR CRAFTS-REQD-3 = "IL" NEXT SENTENCE ELSE
067700         GO TO 6G-PL-16-EXIT.
067800     IF ZONE = "A1  " OR "A2  "  OR "A3  "
067900         MOVE "" TO PRINT-LINE
068000         PERFORM 7-PRINT-A-LINE
068100         MOVE "" TO PRINT-LINE
068200         PERFORM 7-PRINT-A-LINE
068300         MOVE "" TO PRINT-LINE
068400         PERFORM 7-PRINT-A-LINE.
068500 6G-PL-16-EXIT.  EXIT.
068600 7-PRINT-A-LINE.
068900     MOVE PRINT-LINE TO CH-PRINT-RECORD.
069000     WRITE CH-PRINT-RECORD AFTER ADVANCING 1 LINES.

       98-SCREEN-READ.
           READ DISPLAY-FILE FORMAT IS VIEW-CFNAME
               INDIC IS INDICS.
           ACCEPT IOFEEDBACK FROM I-O-FEEDBACK-AREA.
           MOVE ALL B"0" TO INDICS.
           IF DSPLY-STATUS NOT = "00"
               MOVE 3 TO VIEW-LASTKEY
           ELSE
           MOVE FUNCTION-NUM TO VIEW-LASTKEY.

       99-SCREEN-WRITE.
           WRITE DSPLY-REC FORMAT IS VIEW-CFNAME
               INDIC IS INDICS.
           MOVE ALL B"0" TO INDICS.

       99-START-ZONE-SPOOLER-FILE.
           MOVE 0 TO COND-WORD.
028600     MOVE ZONE OF WO-BASIC-DATA TO ZONEKEY OF ZSFREC.
           START ZONE-SPOOLER-FILE KEY IS = EXTERNALLY-DESCRIBED-KEY
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF ZSF-STATUS NOT = "00" MOVE 17 TO COND-WORD.

       99-READ-ZONE-SPOOLER-FILE.
           MOVE 0 TO COND-WORD.
           READ ZONE-SPOOLER-FILE NEXT INTO ZONE-SPOOLER-WA
               AT END    MOVE 15 TO COND-WORD.
           IF ZSF-STATUS NOT = "00" MOVE 15 TO COND-WORD.

       COPY OVRPFCALL IN COPYLIB.
