000200 IDENTIFICATION DIVISION.
000300 PROGRAM-ID.          SPSESYSO.
000400 AUTHOR.              CA YODER.
000500 DATE-WRITTEN.        OCTOBER 1995.
000600 DATE-COMPILED.
000700*INSTALLATION.        GOODYEAR TIRE AND RUBBER - AKRON.
000800*SECURITY.
      ******************************************************************
      *D*  SPSESYSO  --  SETUP USER OPTIONS                            *
      *D*                                                              *
      *D*  ** COPIED FROM SPLTSYSO AND MODIFIED **                     *
      *D*                                                              *
      *D*  CALLED BY:  TSETOPT                                         *
      *D*                                                              *
      ******************************************************************
001100 ENVIRONMENT DIVISION.
001200 CONFIGURATION SECTION.
001300 SOURCE-COMPUTER.  HP-3000.
001400 OBJECT-COMPUTER.  HP-3000.
       SPECIAL-NAMES. I-O-FEEDBACK IS I-O-FEEDBACK-AREA.

       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT DISPLAY-FILE
                  ASSIGN TO WORKSTATION-ZSTARTUP-SI
                  ORGANIZATION IS TRANSACTION
                  ACCESS IS SEQUENTIAL
                  FILE STATUS IS DISPLAY-STATUS
                  CONTROL-AREA IS WS-CONTROL.

           SELECT MPLTINFO-O
                  ASSIGN TO DATABASE-MCFLCS0501
                  ORGANIZATION IS INDEXED
                    ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                  FILE STATUS IS FILE-STATUS.

001500
001600 DATA DIVISION.
       FILE SECTION.
       FD  DISPLAY-FILE
           LABEL RECORDS ARE OMITTED.
       01  DISPLAY-REC        PIC X(1500).

       FD  MPLTINFO-O
           LABEL RECORDS ARE STANDARD.
       01  MPLTINFO-REC-O.
           COPY DDS-MCRPCS0500  OF MCFLCS0501.

001700 WORKING-STORAGE SECTION.
001800
001900 01  SUB                           PIC S9(4) COMP-4 VALUE 0.
002000******************************************************************
002100**                                                              **
002200**      S U B P R O G R A M   A R E A S                         **
002300**                                                              **
002400******************************************************************
002500
002600 COPY TBLOWUP    IN COPYLIB.
002700 COPY TSHWRDFM   IN COPYLIB.
      *------ WS CONTROL AREA
       01  MAJOR-MINOR                   PIC XXXX.
       01  WS-CONTROL.
           05  FUNCTION-NUM              PIC XX.
               88  EXIT-KEY-F8-USED                 VALUE "08".
               88  REFRESH-KEY-F4-USED              VALUE "04".
               88  ENTER-KEY-USED                   VALUE "00".
               88  F1-KEY-USED                      VALUE "01".
               88  F2-KEY-USED                      VALUE "02".
               88  F3-KEY-USED                      VALUE "03".
               88  F4-KEY-USED                      VALUE "04".
               88  F5-KEY-USED                      VALUE "05".
               88  F6-KEY-USED                      VALUE "06".
               88  F7-KEY-USED                      VALUE "07".
               88  F8-KEY-USED                      VALUE "08".
           05  FUN-KEY REDEFINES FUNCTION-NUM  PIC XX.
           05  TERMINAL-ID               PIC X(10).
           05  FORMAT-NAME               PIC X(10).

       01  DISPLAY-STATUS                PIC X(2).

       COPY IOFEEDBACK IN COPYLIB.
       COPY CATREAD    IN COPYLIB.
002800**************************************************************
002900**                                                          **
003000**                  V I E W   W O R K                       **
003100**                                                          **
003200**************************************************************
003300
003400**  SEE LINKAGE SECTION FOR VIEW-COMAREA
003500
003600 01  MESSAGE-BUFFER.
003700     05  MSG-TEXT.
               10  MESSAGE-BUFFER-1      PIC X(1)   VALUE SPACES.
               10  FILLER                PIC X(67) VALUE SPACES.
003800     05  MSG-FLD                   PIC X(8)   VALUE SPACES.
003900     05  MSG-FLD-9 REDEFINES MSG-FLD PIC ZZZZZZZ9.
004300
004400 01  FIELD-NUMBER                  PIC S9(4) COMP-4 VALUE 1.
004500
004600**************************************************************
004700**                                                          **
004800**            D A T A B A S E   W O R K                     **
004900**                                                          **
005000**************************************************************
       01  FILE-STATUS.
           05  FILE-STATUS-1            PIC X  VALUE "0".
           05  FILE-STATUS-2            PIC X  VALUE "0".
005100
005200 COPY DBSTAT     IN COPYLIB.
005300 01  DSET-NAMES.
005400     05  DSET-MPLTINFO             PIC X(16) VALUE "MPLTINFO;".
005500
005600 01  MODE-AREA.
005700     05  MODE1                     PIC S9(4)   COMP       VALUE 1.
005800     05  MODE2                     PIC S9(4)   COMP       VALUE 2.
005900     05  MODE3                     PIC S9(4)   COMP       VALUE 3.
006000     05  MODE5                     PIC S9(4)   COMP       VALUE 5.
006100     05  MODE7                     PIC S9(4)   COMP       VALUE 7.
006200
006300 01  ALL-ITEMS                     PIC X(2)  VALUE "@;".
006400
006500 01  MPLTINFO-ARG.
006600     05  FILLER                    PIC X(2)  VALUE "ST".
006700     05  MPLTINFO-ARG-STR      PIC X(2).
006800
006900 01  TEST-MPLTINFO-KEY.
007000     05  TEST-ST                   PIC X(2).
007100     05  TEST-ST-NUM               PIC X(2).
007200
007300**************************************************************
007400**                                                          **
007500**           D A T A B A S E   B U F F E R S                **
007600**                                                          **
007700**************************************************************
007800
007900 COPY MPLT0      IN COPYLIB.
008000 COPY MPLTBNEX   IN COPYLIB.
008100 COPY MPLTPOPT   IN COPYLIB.
008200
008300**************************************************************
008400**                                                          **
008500**                  S C R E E N   D A T A                   **
008600**                                                          **
008700**************************************************************
008800
008900 01  DE-FIELDS.
009000     05  DE-CODE-DELETES           PIC X(1).
009700     05  DE-TC999                  PIC X(1).
           05  DE-COMMAND-LINE           PIC X(79).
           05  DE-MESSAGE-LINE           PIC X(79).
009900
010000**************************************************************
010100**                                                          **
010200**            L I N K A G E   S E C T I O N                 **
010300**                                                          **
010400**************************************************************
010500
010600 LINKAGE SECTION.
010700 01  BASE                      PIC X(10).
010800
010900 COPY VCOMLINK   IN COPYLIB.
011000 COPY LANGSUB    IN COPYLIB.
011100
011200 PROCEDURE DIVISION USING          BASE,
011300                                   VIEW-COMAREA,
011400                                   LANGUAGE-PARMS.
011500
011600 1000-START.
           MOVE 0 TO SUB.
           OPEN I-O DISPLAY-FILE, MPLTINFO-O.
011700     PERFORM 6000-MAIN THRU 6990-MAIN-X.
           CLOSE DISPLAY-FILE, MPLTINFO-O.
011800     GOBACK.
011900
012000 2100-BLOWUP.
012100     MOVE "SPSESYSO"               TO   BU-PGM-NAME.
012200     CALL "TBLOWUP" USING BASE BU-PGM-NAME STATUS-AREA
012300       VIEW-COMAREA FILE-STATUS BU-DISPLAY-MSG
012400       BU-DISPLAY-FLDS.
012500
       4030-SETERROR.
           MOVE B"1" TO IND (99).
           MOVE B"1" TO IND (FIELD-NUMBER).
           MOVE MESSAGE-BUFFER TO DE-MESSAGE-LINE.
051300
012600 6000-MAIN.
012700     MOVE "SETOPT1"                TO   VIEW-NFNAME.
013200
013300*------ KEY THAT TELLS WHETHER BATCH CORPORATE CODE DELTES THRU
013400*------ AKRON UPDATE ARE ALLOWED (NORMALLY KELLY PLANTS ONLY).
013500     MOVE SPACES                   TO   DE-FIELDS.
013600     MOVE "CDDL"                   TO   MPLTINFO-ARG.
013700     PERFORM 7400-GET-MPLTINFO.
013800     IF NO-ENTRY
013900         MOVE "N"                  TO   DE-CODE-DELETES
014000     ELSE
014100     IF GOOD-CALL
014200         MOVE "Y"                  TO   DE-CODE-DELETES.
014300
015900*------ KEY THAT TELLS WHETHER TC999s ARE TO BE CREATED IN
016000*------ BCUTOFF.DB.CME.
016100     MOVE "TC99"                   TO   MPLTINFO-ARG.
016200     PERFORM 7400-GET-MPLTINFO.
016300     IF NO-ENTRY
016400         MOVE "N"                  TO   DE-TC999
016500     ELSE
016600     IF GOOD-CALL
016700         MOVE "Y"                  TO   DE-TC999.
016800
      *------- DO A START > HIGH-VALUES TO UNLOCK
           MOVE HIGH-VALUES TO PLTINFOKEY OF MPLTINFO-REC-O.
           START MPLTINFO-O KEY > PLTINFOKEY OF MPLTINFO-REC-O
               INVALID KEY MOVE "00" TO FILE-STATUS.

018200 6100-SHOWFORM-1.
018300     MOVE 7                        TO   SRF-KEYSET.
       6010-SHOWFORM.
           MOVE DE-FIELDS TO DISPLAY-REC.
           PERFORM 998-WRITE-SCREEN THRU 998-READ-SCREEN.
           MOVE DISPLAY-REC TO DE-FIELDS.
           IF MESSAGE-BUFFER-1 NOT = SPACES
               PERFORM 4030-SETERROR
               GO TO 6010-SHOWFORM.

019000     IF VIEW-LASTKEY = 3
019100         GO TO 6990-MAIN-X.
019200
020100     MOVE "CDDL"                   TO   MPLTINFO-ARG.
020200     PERFORM 7400-GET-MPLTINFO.
020300     IF NO-ENTRY
020400         IF DE-CODE-DELETES = "Y"
020500             MOVE "CDDL"           TO   MPLTINFO-KEY
020600             MOVE SPACES           TO   MPLTINFO-DATA
020700             PERFORM 7430-PUT-MPLTINFO
020800         ELSE
020900             NEXT SENTENCE
021000     ELSE
021100     IF DE-CODE-DELETES = "N"
021200         PERFORM 7420-DELETE-MPLTINFO.
021300
023000     MOVE "TC99"                   TO   MPLTINFO-ARG.
023100     PERFORM 7400-GET-MPLTINFO.
023200     IF NO-ENTRY
023300         IF DE-TC999 = "Y"
023400             MOVE "TC99"           TO   MPLTINFO-KEY
023500             MOVE SPACES           TO   MPLTINFO-DATA
023600             PERFORM 7430-PUT-MPLTINFO
023700         ELSE
023800             NEXT SENTENCE
023900     ELSE
024000     IF DE-TC999 = "N"
024100         PERFORM 7420-DELETE-MPLTINFO.
024200
025500 6990-MAIN-X.
025600     EXIT.
025700
025800******************************************************************
025900**                                                              **
026000**       P E R F O R M E D   R O U T I N E S                    **
026100**                                                              **
026200******************************************************************
026300 7400-GET-MPLTINFO.
026400*    CALL "DBGET" USING BASE, DSET-MPLTINFO, MODE7,
026500*      STATUS-AREA, ALL-ITEMS, BUF-MPLTINFO, MPLTINFO-ARG.
           MOVE 0 TO COND-WORD.
           MOVE MPLTINFO-ARG TO PLTINFOKEY OF MPLTINFO-REC-O.
           READ MPLTINFO-O INTO BUF-MPLTINFO
               INVALID KEY MOVE 17 TO COND-WORD.
026600     IF FILE-STATUS = "23"
026700         MOVE 17 TO COND-WORD
026800     ELSE
026900     IF FILE-STATUS NOT = "00"
027000         MOVE "DBGET ERR MPLTINFO 7400-GM" TO BU-DISPLAY-MSG
027100         PERFORM 2100-BLOWUP.
027200
027300 7410-UPDATE-MPLTINFO.
027400*    CALL "DBUPDATE" USING BASE, DSET-MPLTINFO, MODE1,
027500*      STATUS-AREA, ALL-ITEMS, BUF-MPLTINFO.
           REWRITE MPLTINFO-REC-O FROM BUF-MPLTINFO
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
027700         MOVE "DBUPDATE ERR MPLTINFO 7410-UM" TO BU-DISPLAY-MSG
027800         PERFORM 2100-BLOWUP.
027900
028000 7420-DELETE-MPLTINFO.
028100*    CALL "DBDELETE" USING BASE, DSET-MPLTINFO, MODE1,
028200*      STATUS-AREA.
           DELETE MPLTINFO-O
             INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
028400         MOVE "DBDELETE ERR MPLTINFO 7420-DM" TO BU-DISPLAY-MSG
028500         PERFORM 2100-BLOWUP.
028600
028700 7430-PUT-MPLTINFO.
028800*    CALL "DBPUT" USING BASE, DSET-MPLTINFO, MODE1,
028900*      STATUS-AREA, ALL-ITEMS, BUF-MPLTINFO
           WRITE MPLTINFO-REC-O FROM BUF-MPLTINFO
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
029100         MOVE "DBPUT ERR MPLTINFO 7430-PM" TO BU-DISPLAY-MSG
029200         PERFORM 2100-BLOWUP.

       COPY DISPCALL  IN COPYLIB.
       999-CATREAD.
           IF CATREAD-MSG-NUMBER = ZEROS
               MOVE LANG-SETNUM TO CATREAD-MSG-SET
               MOVE LANG-MSGNUM TO CATREAD-MSG-NUM.
           CALL "CCATREAD" USING CATREAD-PARMS.
           MOVE CATREAD-MSG-TEXT TO MESSAGE-BUFFER.
        999-CATREAD-EXIT.
