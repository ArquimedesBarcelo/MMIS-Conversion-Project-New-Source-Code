026900*************************************************************
027000*                  PROCEDURE DIVISION                       *
027100*      OPEN FILES.  DISPLAY MAIN MENU.  THE USER CAN        *
027200*      CHOOSE TO PERFORM THE FOLLOWING FUNCTIONS:           *
027300*      INQUIRY, ADD, MODIFY, DELETE, OR EXIT PROGRAM.       *
027400*      THE DATABASE IS UPDATED FOR AN ADD, MODIFY, OR       *
027500*      DELETE.  WHEN THE USER SELECTS EXIT, CLOSE FILES.    *
027600*************************************************************
027700 PROCEDURE DIVISION.
027900 00-MAIN.
028000     PERFORM 010-OPEN-FILES THRU 019-EXIT.
028100
028200     PERFORM 020-SELECT-FUNCTION THRU 029-EXIT.
028300
028400     PERFORM 050-CLOSE-FILES THRU 059-EXIT.
028500
028600     GOBACK.
028610
028800*************************************************************
028900*************************************************************
029000*                     OPEN FILES                            *
029100*************************************************************
029200*************************************************************
029300 010-OPEN-FILES.
           OPEN I-O MCOMMENT-O, DCOMMENT-O.
           OPEN INPUT MCOMMENT-I, DCOMMENT-I.
           MOVE "ZDECOM" TO VIEW-CFNAME.

030900 019-EXIT.  EXIT.
031000***********************************************************
031100***********************************************************
031200*         CLOSE ALL FILES AND INITIALIZE USER KEYS        *
031300***********************************************************
031400***********************************************************
031500 050-CLOSE-FILES.
           CLOSE MCOMMENT-I, DCOMMENT-I,
                 MCOMMENT-O, DCOMMENT-O.

032000 059-EXIT.  EXIT.
032200*************************************************************
032300*************************************************************
032400*                SELECT FUNCTION                            *
032500*                                                           *
032600*     DISPLAY MAIN MENU.  THE FOLLOWING PARAGRAPHS ARE      *
032700*     PERFORMED DEPENDING ON THE FUNCTION SELECTED:         *
032800*                    100  -  INQUIRY                        *
032900*                    200  -  ADD                            *
033000*                    300  -  MODIFY                         *
033100*                    400  -  DELETE                         *
033200*************************************************************
033300*************************************************************
033400 020-SELECT-FUNCTION.
033500     MOVE FORM-MAIN-MENU           TO VIEW-NFNAME.
           MOVE SPACES     TO SCREEN-MAIN-MENU.
034900
035000 022-SHOW-FORM.
           MOVE 3 TO SRF-MODE.
           MOVE SCREEN-MAIN-MENU TO SCREEN-BUFFER.
           CALL "TSHWRDFM" USING SRF-COMAREA, BU-DISPLAY-MSG,
               VIEW-COMAREA, BASE, STATUS-AREA, SRF-SPOOLER-REC,
               LANGUAGE-PARMS, SCREEN-BUFFER.
           MOVE SCREEN-BUFFER TO SCREEN-MAIN-MENU.
035500
036100     IF VIEW-LASTKEY = 1
036200        PERFORM 100-INQUIRY THRU 199-EXIT
036300        GO TO 020-SELECT-FUNCTION.
036400
036500     IF VIEW-LASTKEY = 2
036600        PERFORM 200-ADD     THRU 299-EXIT
036700        GO TO 020-SELECT-FUNCTION.
036800
036900     IF VIEW-LASTKEY = 8
037000        PERFORM 300-MODIFY  THRU 399-EXIT
037100        GO TO 020-SELECT-FUNCTION.
037200
037300     IF VIEW-LASTKEY = 4
037400        PERFORM 400-DELETE  THRU 499-EXIT
037500        GO TO 020-SELECT-FUNCTION.

           IF VIEW-LASTKEY = 5
              CALL "TRCVINST"
              GO TO 020-SELECT-FUNCTION.
038700
038800     IF VIEW-LASTKEY EQUAL 3
038900         GO TO 029-EXIT.
039000
039100     IF VIEW-LASTKEY EQUAL 6  OR
              VIEW-LASTKEY EQUAL 7
      **        I9: INVALID FUNCTION KEY
039300         MOVE   9 TO LANG-SETNUM
039310         MOVE  10 TO LANG-MSGNUM
039320         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER TO MAIN-MSG-LINE
               MOVE B"1"  TO IND(99)
039600         GO TO  022-SHOW-FORM.

           MOVE SPACES TO SCREEN-MAIN-MENU.
           GO TO 022-SHOW-FORM.
039700
039800 029-EXIT.  EXIT.
040000*************************************************************
040100*************************************************************
040200*                        I N Q U I R Y                      *
040300*       ENTER INSTRUCTION NUMBER.  COMMENT LINES ARE        *
040400*       DISPLAYED ALONG WITH PLANT TYPE.  DATASET POINTERS  *
040500*       ARE KEPT IN CASE THERE ARE MORE COMMENTS TO DISPLAY *
040600*       THAT CANNOT ALL FIT ONTO ONE SCREEN.                *
040700*************************************************************
040800*************************************************************
040900 100-INQUIRY.
041400     MOVE FORM-INQUIRY             TO VIEW-NFNAME.
           MOVE SPACES TO SCREEN-INQUIRY.
042800
042900 105-SHOW-FORM.
           MOVE 3 TO SRF-MODE.
           MOVE SCREEN-INQUIRY TO SCREEN-BUFFER.
           CALL "TSHWRDFM" USING SRF-COMAREA, BU-DISPLAY-MSG,
               VIEW-COMAREA, BASE, STATUS-AREA, SRF-SPOOLER-REC,
               LANGUAGE-PARMS, SCREEN-BUFFER.
           MOVE SCREEN-BUFFER TO SCREEN-INQUIRY.
044300
046100     IF VIEW-LASTKEY EQUAL 3
046200         GO TO 199-EXIT.
046300
046400     IF VIEW-LASTKEY EQUAL 1 OR
046500        VIEW-LASTKEY EQUAL 2 OR
              VIEW-LASTKEY EQUAL 4 OR
046600        VIEW-LASTKEY EQUAL 5 OR
              VIEW-LASTKEY EQUAL 6 OR
046700        VIEW-LASTKEY EQUAL 7 OR
046800        VIEW-LASTKEY EQUAL 8
      **        I9: INVALID FUNCTION KEY
046900         MOVE   9 TO LANG-SETNUM
046910         MOVE  10 TO LANG-MSGNUM
046920         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER      TO INQUIRY-MSG-LINE
               MOVE 1 TO FIELD-NUMBER
               MOVE B"1" TO IND(FIELD-NUMBER) IND(99)
047200         GO TO  105-SHOW-FORM.
047300
      *---------- MAKE SURE INST. NUMBER IS ENTERED
           IF INQUIRY-NUM = SPACES
      **  INSTRUCTION NUMBER MUST BE ENTERED
               MOVE ZERO  TO LANG-SETNUM
               MOVE 40    TO LANG-MSGNUM
               PERFORM 999-CATREAD  THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER  TO  INQUIRY-MSG-LINE
               MOVE B"1"  TO IND(1), IND(99)
               GO TO 105-SHOW-FORM.

049000*----------  VALIDATE THAT INSTRUCTION EXISTS
049100     MOVE INQUIRY-NUM              TO BUILD-COM-NO.
049200     MOVE BUILD-COMMENT-NO         TO COMMENT-ARG.
           PERFORM 500-GET-MCOMMENT-I.
049500     IF NO-ENTRY
      **    I28: INSTRUCTION DOES NOT EXIST - CORRECT AND REENTER
049600        MOVE   9 TO LANG-SETNUM
049610        MOVE  28 TO LANG-MSGNUM
049620        PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
              MOVE 1   TO FIELD-NUMBER
              MOVE MESSAGE-BUFFER  TO INQUIRY-MSG-LINE
              MOVE B"1" TO IND(FIELD-NUMBER) IND(99)
049900        GO TO 105-SHOW-FORM.
050000
050100     IF NOT GOOD-CALL
050200        MOVE "DBFIND DCOMMENT 105 DECOM" TO BU-DISPLAY-MSG
050300        PERFORM 990-BLOWUP THRU 999-EXIT.
050500     MOVE SPACES                   TO SCREEN-INQUIRE.
050600     MOVE INQUIRY-NUM              TO INQUIRE-NUM.
           MOVE SPACES                   TO COMMENT-HOLD-AREA.
           MOVE 1  TO PAGE-CTR, LINE-CTR, CURRENT-PAGE-CTR.
           SET I TO 1.
           MOVE ZEROS TO PRINT-FLAG.
           PERFORM 500-FIND-DCOMMENT-I.
           IF NO-ENTRY
               GO TO 125-SHOW-COMMENTS.
050700
050800*----------  READ FIRST LINE TO FIND OUT TYPE OF PRINT
           PERFORM 500-GET-DCOMMENT-I.
051500
051600     IF NOT GOOD-CALL
051700        MOVE "DBGET1 DCOMMENT 105 DECOM" TO BU-DISPLAY-MSG
051800        PERFORM 990-BLOWUP THRU 999-EXIT.
051900
052000     MOVE 0 TO PRINT-FLAG.
052200     IF COMP-PRT-START = COMPRESSED-PRINT
052300         MOVE 2 TO PRINT-FLAG
052400         MOVE COMP-DATA-COMMENT  TO INQUIRE-INSTR (I)
                                          COMMENT-LINE (1, 1)
052500         MOVE   3 TO LANG-SETNUM
052510         MOVE 146 TO LANG-MSGNUM
052520         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
052530         MOVE MESSAGE-BUFFER TO INQUIRE-PRINT
052600     ELSE
052700         IF EXP-PRT-START = EXPANDED-PRINT
052800             MOVE 1 TO PRINT-FLAG
052900             MOVE EXP-DATA-COMMENT  TO  INQUIRE-INSTR (I)
                                              COMMENT-LINE (1, 1)
053000             MOVE   5 TO LANG-SETNUM
053010             MOVE  41 TO LANG-MSGNUM
053020             PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
053030             MOVE MESSAGE-BUFFER TO INQUIRE-PRINT
053100         ELSE
053200             MOVE DCOM-DATA-LINE  TO  INQUIRE-INSTR (I)
                                            COMMENT-LINE (1, 1)
053300             MOVE  18 TO LANG-SETNUM
053310             MOVE  78 TO LANG-MSGNUM
053320             PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
053330             MOVE MESSAGE-BUFFER TO INQUIRE-PRINT.

           PERFORM 140-LOAD-COMMENT-AREA  THRU 140-LCA-X.

053600
055000 125-SHOW-COMMENTS.
           PERFORM 160-GET-RIGHT-MSG.

055100     MOVE FORM-INQUIRE TO VIEW-NFNAME.
057300
057400 127-SHOW-FORM.
           MOVE 3 TO SRF-MODE.
           MOVE SCREEN-INQUIRE TO SCREEN-BUFFER.
           CALL "TSHWRDFM" USING SRF-COMAREA, BU-DISPLAY-MSG,
               VIEW-COMAREA, BASE, STATUS-AREA, SRF-SPOOLER-REC,
               LANGUAGE-PARMS, SCREEN-BUFFER.
           MOVE SCREEN-BUFFER TO SCREEN-INQUIRE.

           IF VIEW-LASTKEY = 0
               GO TO 127-SHOW-FORM.
058600
060300     IF VIEW-LASTKEY EQUAL 3
060400         GO TO 199-EXIT.
060500
060600     IF VIEW-LASTKEY EQUAL 1
060700        IF PREV-AND-MORE
                 SUBTRACT 1 FROM CURRENT-PAGE-CTR
                 MOVE COMMENT-PAGE (CURRENT-PAGE-CTR) TO
                     INQUIRE-INSTRUCTIONS
                 GO TO 125-SHOW-COMMENTS
061100        ELSE
061200           IF PREVIOUS-ONLY
                     SUBTRACT 1 FROM CURRENT-PAGE-CTR
                     MOVE COMMENT-PAGE (CURRENT-PAGE-CTR) TO
                         INQUIRE-INSTRUCTIONS
                     GO TO 125-SHOW-COMMENTS.
061600
061700     IF VIEW-LASTKEY EQUAL 2
061800        IF MORE-ONLY
                 ADD 1 TO CURRENT-PAGE-CTR
                 MOVE COMMENT-PAGE (CURRENT-PAGE-CTR) TO
                     INQUIRE-INSTRUCTIONS
                 GO TO 125-SHOW-COMMENTS
062200        ELSE
062300           IF PREV-AND-MORE
                     ADD 1 TO CURRENT-PAGE-CTR
                     MOVE COMMENT-PAGE (CURRENT-PAGE-CTR) TO
                         INQUIRE-INSTRUCTIONS
                     GO TO 125-SHOW-COMMENTS.
062700     IF VIEW-LASTKEY EQUAL 7
062800        GO TO 100-INQUIRY.
062900
      **    I9: INVALID FUNCTION KEY
063000     MOVE   9 TO LANG-SETNUM
063010     MOVE  10 TO LANG-MSGNUM
063020     PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
           MOVE MESSAGE-BUFFER TO INQUIRE-MSG-LINE.
           MOVE 1 TO FIELD-NUMBER.
           MOVE B"1" TO IND(FIELD-NUMBER) IND(99).
063300     GO TO  127-SHOW-FORM.

       140-LOAD-COMMENT-AREA.
           PERFORM 500-GET-DCOMMENT-I.
           IF END-OF-CHAIN
               GO TO 140-LCA-X.
           ADD 1 TO LINE-CTR.
           IF LINE-CTR > 14
               MOVE 1 TO LINE-CTR
               ADD 1 TO PAGE-CTR
               IF PAGE-CTR > 7
                   MOVE 7  TO PAGE-CTR
                   GO TO 140-LCA-X.
064300
064400     IF EXP-PRINT
064500        MOVE EXP-DATA-COMMENT
                  TO COMMENT-LINE (PAGE-CTR, LINE-CTR)
064600     ELSE
064700        IF COMP-PRINT
064800           MOVE COMP-DATA-COMMENT
                     TO COMMENT-LINE (PAGE-CTR, LINE-CTR)
064900        ELSE
065000           MOVE DCOM-DATA-LINE
                     TO COMMENT-LINE (PAGE-CTR, LINE-CTR).
065100
           IF PAGE-CTR = 1
               SET I UP BY 1
064400         IF EXP-PRINT
064500             MOVE EXP-DATA-COMMENT TO INQUIRE-INSTR (I)
064600         ELSE
064700             IF COMP-PRINT
