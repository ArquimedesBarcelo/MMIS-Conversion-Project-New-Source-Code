           IF FILE-STATUS NOT = "00"
              MOVE 99 TO COND-WORD.
128600     IF NOT GOOD-CALL
128700        MOVE "DBDELETE DCOMMENT 340 DECOM" TO BU-DISPLAY-MSG
128800        PERFORM 990-BLOWUP THRU 999-EXIT.
128900     GO TO 330-GET-CHANGES.
129000
129100 345-ADD-NEW-LINES.
129200*----------  IF LINE = SPACES, SKIP IT AND CHECK THE NEXT ONE
129300     IF MOD-LINES (M) = SPACES
129400        GO TO 347-CONTINUE-ADD.
129500
129600     ADD 1 TO LINE-SAVE.
129700     MOVE BUILD-COMMENT-NO  TO  DCOM-COMMENT-NO.
129800     MOVE LINE-SAVE         TO  DCOM-LINE-NO.
129900     MOVE SPACES            TO  DCOM-DATA-LINE.
130000
130100     IF EXP-PRINT
130200        MOVE MOD-FIRST (M) TO EXP-DATA-COMMENT
130300        MOVE EXPANDED-PRINT  TO  EXP-PRT-START
130400*       MOVE REG-5  TO  EXP-PRT-STOP
130500     ELSE
130600        IF COMP-PRINT
130700           MOVE MOD-LINES (M) TO COMP-DATA-COMMENT
130800           MOVE COMPRESSED-PRINT  TO  COMP-PRT-START
130900*          MOVE REG-5  TO  COMP-PRT-STOP
131000        ELSE
131100           MOVE MOD-LINES (M) TO DCOM-DATA-LINE.
            MOVE ZEROS TO COND-WORD.
            WRITE DCOMMENT-REC-O FROM BUF-DCOMMENT.
            IF FILE-STATUS NOT = "00"
                MOVE 99 TO COND-WORD.
131400     IF NOT GOOD-CALL
131500        MOVE "DBPUT DCOMMENT 345 DECOM" TO BU-DISPLAY-MSG
131600        PERFORM 990-BLOWUP THRU 999-EXIT.
131700
131800 347-CONTINUE-ADD.
131900     ADD 1 TO M.
132000     IF M < 5
132100        GO TO 345-ADD-NEW-LINES.

132300*************************************************************
132400*            FINISHED UPDATING 4 COMMENT LINES.  CHECK      *
132500*            IF THE NEXT SET OF 4 WERE REQUESTED TO BE      *
132600*            DISPLAYED AND MODIFIED.                        *
132700*************************************************************
132800 350-UNLOCK-DCOMMENT.
133400*---------- CHECK IF USER MARKED THE CONTINUE BOX
133500     IF MOD-X = "X"
133600        MOVE LINE-SAVE TO SEQ-NO-SAVE
133700        MOVE 1 TO M
133800        MOVE SPACES TO MOD-LINES (1), MOD-LINES (2),
133900                       MOD-LINES (3), MOD-LINES (4), MOD-X
134000        PERFORM 392-FIND-COMMENT-LINE-NO THRU 393-EXIT
134100        GO TO 310-GET-COMMENT-FOR-SCREEN.
134200
134300*----------  DO NOT CONTINUE, SO ASK FOR NEW COMMENT NUMBER
134400     GO TO 300-MODIFY.
134500
134600 390-FIND-COMMENT-LINE-NO.
           MOVE ZEROS TO COND-WORD.
           MOVE COMMENT-ARG TO MCOMCOMMNT OF DCOMMENT-REC-O.
           START DCOMMENT-O
               KEY IS EQUAL TO MCOMCOMMNT OF DCOMMENT-REC-O
               INVALID KEY MOVE 17 TO COND-WORD.
           IF FILE-STATUS  NOT = "00"
               IF FILE-STATUS-1 = "2"
                   MOVE 17 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.

           IF SEQ-NO-SAVE = ZEROS
              GO TO 391-EXIT.
134900     IF NOT GOOD-CALL
135000        MOVE "DBFIND DCOMMENT 390 DECOM" TO BU-DISPLAY-MSG
135100        PERFORM 990-BLOWUP THRU 999-EXIT.
135200
135300 390-GET-COMMENT.
           MOVE ZEROS TO COND-WORD.
           READ DCOMMENT-O NEXT RECORD INTO BUF-DCOMMENT
               AT END GO TO 391-EXIT.
           IF COMMENT-ARG NOT = MCOMCOMMNT OF DCOMMENT-REC-O
               MOVE 99  TO COND-WORD
               MOVE "COMMENT NOS. NOT EQUAL 390-GC" TO BU-DISPLAY-MSG
               PERFORM 990-BLOWUP THRU 999-EXIT.
135600     IF NOT GOOD-CALL
135700        MOVE "DBGET DCOMMENT 390 DECOM" TO BU-DISPLAY-MSG
135800        PERFORM 990-BLOWUP THRU 999-EXIT.
135900
136000     IF DCOM-LINE-NO = SEQ-NO-SAVE
136100        GO TO 391-EXIT.
136200     IF DCOM-LINE-NO < SEQ-NO-SAVE
136300        GO TO 390-GET-COMMENT.
136400     MOVE "* SEQ. NUMBER NOT FOUND AT 390 DECOM"
136500          TO BU-DISPLAY-MSG
136600     PERFORM 990-BLOWUP THRU 999-EXIT.
136700 391-EXIT.  EXIT.

       392-FIND-COMMENT-LINE-NO.
           PERFORM 500-FIND-DCOMMENT-I.

           IF SEQ-NO-SAVE = ZEROS
               GO TO 393-EXIT.
           IF NOT GOOD-CALL
               MOVE "START DCOMMENT-I *392-FCLN" TO BU-DISPLAY-MSG
               PERFORM 990-BLOWUP THRU 999-EXIT.

       392-GET-COMMENT.
           PERFORM 500-GET-DCOMMENT-I.
           IF COMMENT-ARG NOT = MCOMCOMMNT OF DCOMMENT-REC-I
               MOVE "COMMENT NOS. NOT EQUAL 392-GC" TO BU-DISPLAY-MSG
               PERFORM 990-BLOWUP THRU 999-EXIT.
135600     IF NOT GOOD-CALL
135700        MOVE "DBGET DCOMMENT 392-GC" TO BU-DISPLAY-MSG
135800        PERFORM 990-BLOWUP THRU 999-EXIT.
135900
136000     IF DCOM-LINE-NO = SEQ-NO-SAVE
136100        GO TO 393-EXIT.
136200     IF DCOM-LINE-NO < SEQ-NO-SAVE
136300        GO TO 392-GET-COMMENT.
136400     MOVE "* SEQ. NUMBER NOT FOUND AT 390 DECOM"
136500          TO BU-DISPLAY-MSG
136600     PERFORM 990-BLOWUP THRU 999-EXIT.
136700 393-EXIT.  EXIT.

136800 399-EXIT. EXIT.

137000*************************************************************
137100*************************************************************
137200*                    D E L E T E                            *
137300*                                                           *
137400*       ENTER INSTRUCTION NUMBER TO BE DELETED.  DELETE     *
137500*       ALL ENTRIES FROM DCOMMMENT AND MCOMMENT DATASETS.   *
137600*************************************************************
137700*************************************************************
137800 400-DELETE.
137900     MOVE FORM-DELETE TO VIEW-NFNAME.
           MOVE SPACES  TO SCREEN-DEL.
139300
139400 405-SHOW-DELETE-FORM.
           MOVE 3 TO SRF-MODE.
           MOVE SCREEN-DEL TO SCREEN-BUFFER.
           CALL "TSHWRDFM" USING SRF-COMAREA, BU-DISPLAY-MSG,
               VIEW-COMAREA, BASE, STATUS-AREA, SRF-SPOOLER-REC,
               LANGUAGE-PARMS, SCREEN-BUFFER.
           MOVE SCREEN-BUFFER TO SCREEN-DEL.

142300     IF VIEW-LASTKEY EQUAL 3
142400         GO TO 499-EXIT.
142500
142600     IF VIEW-LASTKEY EQUAL 1 OR
142700        VIEW-LASTKEY EQUAL 2 OR
              VIEW-LASTKEY EQUAL 4 OR
142800        VIEW-LASTKEY EQUAL 5 OR
              VIEW-LASTKEY EQUAL 6 OR
142900        VIEW-LASTKEY EQUAL 7 OR
143000        VIEW-LASTKEY EQUAL 8
      **         I9: INVALID FUNCTION KEY
143100         MOVE   9 TO LANG-SETNUM
143110         MOVE  10 TO LANG-MSGNUM
143120         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE 1 TO FIELD-NUMBER
               MOVE B"1" TO IND(FIELD-NUMBER) IND(99)
               MOVE MESSAGE-BUFFER TO SCREEN-DEL-MSG-LINE
143400         GO TO  405-SHOW-DELETE-FORM.
145100
      *---------- MAKE SURE INST. NUMBER IS ENTERED
           IF SCREEN-DEL-NUM = SPACES
      **  INSTRUCTION NUMBER MUST BE ENTERED
               MOVE ZERO  TO LANG-SETNUM
               MOVE 40    TO LANG-MSGNUM
               PERFORM 999-CATREAD  THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER  TO  SCREEN-DEL-MSG-LINE
               MOVE B"1"  TO IND(1), IND(99)
               GO TO 405-SHOW-DELETE-FORM.

145200*----------  VALIDATE THAT INSTRUCTION EXISTS
145300     MOVE SCREEN-DEL-NUM           TO BUILD-COM-NO.
145400     MOVE BUILD-COMMENT-NO         TO COMMENT-ARG.
           MOVE ZEROS                         TO COND-WORD.
           MOVE COMMENT-ARG TO MCOMCOMMNT OF DCOMMENT-REC-O.
           START DCOMMENT-O
              KEY IS EQUAL TO MCOMCOMMNT OF DCOMMENT-REC-O
              INVALID KEY MOVE 17 TO COND-WORD.
           IF FILE-STATUS  NOT = "00"
               IF FILE-STATUS-1 = "2"
                   MOVE 17 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.
145700     IF NO-ENTRY
145800        MOVE   9 TO LANG-SETNUM
145810        MOVE  28 TO LANG-MSGNUM
145820        PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
              MOVE MESSAGE-BUFFER  TO SCREEN-DEL-MSG-LINE
              MOVE 1 TO FIELD-NUMBER
              MOVE B"1" TO IND(FIELD-NUMBER) IND(99)
146100        GO TO 405-SHOW-DELETE-FORM.
146200
146300     IF NOT GOOD-CALL
146400        MOVE "DBFIND DCOMMENT 405 DECOM" TO BU-DISPLAY-MSG
146500        PERFORM 990-BLOWUP THRU 999-EXIT.
146600
      **  N40: NOW PROCESSING P.O. INSTRUCTION DELETE
146700     MOVE  14 TO LANG-SETNUM
146710     MOVE  40 TO LANG-MSGNUM
146720     PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
           MOVE MESSAGE-BUFFER TO SCREEN-DEL-COMMAND-LINE.
      *    MOVE B"1" TO IND(99).
           MOVE 4 TO SRF-MODE.
           MOVE SCREEN-DEL TO SCREEN-BUFFER.
           CALL "TSHWRDFM" USING SRF-COMAREA, BU-DISPLAY-MSG,
               VIEW-COMAREA, BASE, STATUS-AREA, SRF-SPOOLER-REC,
               LANGUAGE-PARMS, SCREEN-BUFFER.
148000
148100*----------  DELETE DCOMMENT
148200 410-DELETE-DCOMMENT.
           MOVE ZEROS TO COND-WORD.
           READ DCOMMENT-O NEXT RECORD INTO BUF-DCOMMENT
               AT END MOVE 15 TO COND-WORD.
           IF DCOM-COMMENT-NO NOT = COMMENT-ARG
               REWRITE DCOMMENT-REC-O FROM BUF-DCOMMENT
               MOVE 15 TO COND-WORD.
148500     IF END-OF-CHAIN
148600        GO TO 415-UNLOCK-DCOMMENT.
148700     IF NOT GOOD-CALL
148800        MOVE "DBGET DCOMMENT 410 DECOM" TO BU-DISPLAY-MSG
148900        PERFORM 990-BLOWUP THRU 999-EXIT.
149000
           MOVE ZEROS TO COND-WORD.
           DELETE DCOMMENT-O.
           IF FILE-STATUS NOT = "00"
               MOVE 99  TO COND-WORD.
149200     IF NOT GOOD-CALL
149300        MOVE "DBDELETE DCOMMENT 410 DECOM" TO BU-DISPLAY-MSG
149400        PERFORM 990-BLOWUP THRU 999-EXIT.
149500
149600     GO TO 410-DELETE-DCOMMENT.
149700
149800 415-UNLOCK-DCOMMENT.
           MOVE COMMENT-ARG  TO MCOMCOMMNT OF MCOMMENT-REC-O.
           MOVE ZERO TO COND-WORD.
           READ MCOMMENT-O INTO BUF-MCOMMENT
               INVALID KEY MOVE 17 TO COND-WORD.
           IF FILE-STATUS  NOT = "00"
               IF FILE-STATUS-1 = "2"
                   MOVE 17 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.
151200     IF NOT GOOD-CALL
151300        MOVE "DBGET MCOMMENT 415 DECOM" TO BU-DISPLAY-MSG
151400        PERFORM 990-BLOWUP THRU 999-EXIT.
151500
           MOVE ZEROS TO COND-WORD.
           DELETE MCOMMENT-O.
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD.
151700     IF NOT GOOD-CALL
151800        MOVE "DBDELETE MCOMMENT 415 DECOM" TO BU-DISPLAY-MSG
151900        PERFORM 990-BLOWUP THRU 999-EXIT.
152500
152600     GO TO 400-DELETE.

152700 499-EXIT.  EXIT.

       500-GET-MCOMMENT-I.
           MOVE COMMENT-ARG  TO MCOMCOMMNT OF MCOMMENT-REC-I.
           MOVE ZERO TO COND-WORD.
           READ MCOMMENT-I INTO BUF-MCOMMENT
               INVALID KEY MOVE 17 TO COND-WORD.
           IF FILE-STATUS  NOT = "00"
               IF FILE-STATUS-1 = "2"
                   MOVE 17 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.

       500-FIND-DCOMMENT-I.
           MOVE ZEROS TO COND-WORD.
           MOVE COMMENT-ARG TO MCOMCOMMNT OF DCOMMENT-REC-I.
           START DCOMMENT-I
               KEY IS EQUAL TO MCOMCOMMNT OF DCOMMENT-REC-I
               INVALID KEY MOVE 17 TO COND-WORD.
           IF FILE-STATUS  NOT = "00"
               IF FILE-STATUS-1 = "2"
                   MOVE 17 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.

       500-GET-DCOMMENT-I.
           MOVE ZEROS TO COND-WORD.
           READ DCOMMENT-I NEXT RECORD INTO BUF-DCOMMENT
               AT END MOVE 15 TO COND-WORD.
           IF COMMENT-ARG NOT = MCOMCOMMNT OF DCOMMENT-REC-I
               MOVE 15  TO COND-WORD.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "1"
                   MOVE 15 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.


157200************************************************************
157300************************************************************
157400*                    B L O W U P                           *
157500*     CHECK FOR IMAGE, VIEW, OR SPOOL ERROR.  CLOSE        *
157600*     FILES, GET OUT OF BLOCK MODE, AND DISPLAY            *
157700*     APPROPRIATE ERROR MESSAGE ON SCREEN.                 *
157800*                                                          *
157900*     ALSO APPENDS THE ERROR MESSAGE TO A FILE CALLED      *
158000*     BLOWUP.PUB.  TO READ THIS FILE, RUN "XBLPRT.OBJECT". *
158100*                                                          *
158200*         |||  PROGRAM IS ABORTED IN TBLOWUP  |||          *
158300************************************************************
158400************************************************************
158500 990-BLOWUP.
158600     MOVE VIEW-NFNAME TO BU-DISPLAY-FLD (1).
158700     MOVE COMMENT-ARG TO BU-DISPLAY-FLD (2).
           IF FILE-STATUS NUMERIC
               MOVE FILE-STATUS TO COND-WORD.
158800     CALL "TBLOWUP" USING BASE, BU-PGM-NAME, STATUS-AREA,
158900           VIEW-COMAREA, FILE-STATUS, BU-DISPLAY-MSG,
159000           BU-DISPLAY-FLDS.
159100 999-EXIT.  EXIT.
159200
159300 999-CATREAD.
           IF CATREAD-MSG-NUMBER = ZEROS
               MOVE LANG-SETNUM  TO CATREAD-MSG-SET
               MOVE LANG-MSGNUM  TO CATREAD-MSG-NUM.
           CALL "CCATREAD" USING CATREAD-PARMS.
           MOVE CATREAD-MSG-TEXT  TO MESSAGE-BUFFER.
160900 999-CATREAD-EXIT.
161000     EXIT.
161100
       500-UPDATE-MCOMMENT.
           MOVE MOD-NUM           TO BUILD-COM-NO.
           MOVE BUILD-COMMENT-NO  TO MCOMCOMMNT OF MCOMMENT-REC-O.
           READ MCOMMENT-O INTO BUF-MCOMMENT.
           IF FILE-STATUS = "00"
               MOVE MOD-SUBJECT   TO MCOM-SUBJECT-CODE
               REWRITE MCOMMENT-REC-O FROM BUF-MCOMMENT
               IF FILE-STATUS NOT = "00"
                   MOVE "REWRITE FAILED IN 500-UPDATE-MCOMMENT"
                       TO BU-DISPLAY-MSG
                   PERFORM 990-BLOWUP THRU 999-EXIT
               ELSE
               NEXT SENTENCE
           ELSE
           MOVE "READ FAILED IN 500-UPDATE-MCOMMENT"
               TO BU-DISPLAY-MSG
           PERFORM 990-BLOWUP THRU 999-EXIT.
      *    UNLOCK MCOMMENT RECORD SINCE I-O READ ABOVE
           REWRITE MCOMMENT-REC-O FROM BUF-MCOMMENT.

       550-HELP-SUBJECT-CODE.
           ADD 1 TO HELP-FORM-COUNTER.
           IF HELP-FORM-COUNTER > 3
               GO TO 550-HELP-SUBJECT-CODE-X.
           MOVE FORM-NAME TO VIEW-NFNAME.
           MOVE 3 TO SRF-MODE.
           CALL "TSHWRDFM" USING SRF-COMAREA, BU-DISPLAY-MSG,
               VIEW-COMAREA, BASE, STATUS-AREA, SRF-SPOOLER-REC,
               LANGUAGE-PARMS, SCREEN-BUFFER.
           MOVE SPACES    TO DE1-FIELDS.
           MOVE SPACES TO MESSAGE-BUFFER.
           MOVE 3 TO SRF-MODE.
           CALL "TSHWRDFM" USING SRF-COMAREA, BU-DISPLAY-MSG,
               VIEW-COMAREA, BASE, STATUS-AREA, SRF-SPOOLER-REC,
               LANGUAGE-PARMS, SCREEN-BUFFER.
           IF HELP-FORM-COUNTER < 3
               MOVE 16  TO LANG-SETNUM
               MOVE 140 TO LANG-MSGNUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE 3 TO SRF-MODE
               CALL "TSHWRDFM" USING SRF-COMAREA, BU-DISPLAY-MSG,
                   VIEW-COMAREA, BASE, STATUS-AREA, SRF-SPOOLER-REC,
                   LANGUAGE-PARMS, SCREEN-BUFFER.
           IF VIEW-LASTKEY = 3 GO TO 550-HELP-SUBJECT-CODE-X.
           GO TO 550-HELP-SUBJECT-CODE.
       550-HELP-SUBJECT-CODE-X.
           EXIT.
