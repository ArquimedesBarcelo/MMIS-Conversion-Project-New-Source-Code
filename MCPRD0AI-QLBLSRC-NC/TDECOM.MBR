070200*************************************************************
070300*                    A D D                                  *
070400*                                                           *
070500*    ENTER INSTRUCTION NUMBER AND AS MANY COMMENTS AS       *
070600*    NEEDED.  EXPANDED PRINT MAY ONLY USE THE FIRST         *
070700*    36 CHARACTERS OF EACH LINE.  COMPRESSED AND REGULAR    *
070800*    PRINT MAY USE 72 CHARACTERS PER LINE.                  *
070900*************************************************************
071000*************************************************************
071100 200-ADD.
071200     MOVE FORM-ADD                 TO VIEW-NFNAME.
           MOVE SPACES  TO SCREEN-ADD.
072600
072700 205-SHOW-FORM.
           MOVE 3 TO SRF-MODE.
           MOVE SCREEN-ADD TO SCREEN-BUFFER.
           CALL "TSHWRDFM" USING SRF-COMAREA, BU-DISPLAY-MSG,
               VIEW-COMAREA, BASE, STATUS-AREA, SRF-SPOOLER-REC,
               LANGUAGE-PARMS, SCREEN-BUFFER.
           MOVE SCREEN-BUFFER TO SCREEN-ADD.
075600     IF VIEW-LASTKEY EQUAL 3
075700         GO TO 299-EXIT.
075800
           IF VIEW-LASTKEY = 1
               MOVE ZEROES    TO HELP-FORM-COUNTER
               PERFORM 550-HELP-SUBJECT-CODE THRU
                       550-HELP-SUBJECT-CODE-X
               GO TO 200-ADD.

076000     IF VIEW-LASTKEY EQUAL 2 OR
              VIEW-LASTKEY EQUAL 4 OR
076100        VIEW-LASTKEY EQUAL 5 OR
              VIEW-LASTKEY EQUAL 6 OR
076200        VIEW-LASTKEY EQUAL 7 OR
076300        VIEW-LASTKEY EQUAL 8
      **        I9: INVALID FUNCTION KEY
076400         MOVE   9 TO LANG-SETNUM
076410         MOVE  10 TO LANG-MSGNUM
076420         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE 1 TO FIELD-NUMBER
               MOVE B"1" TO IND(FIELD-NUMBER) IND(99)
               MOVE MESSAGE-BUFFER TO ADD-MSG-LINE
076700         GO TO  205-SHOW-FORM.
078400
078500*----------  IF ON A CONTINUING SCREEN, SKIP NUMBER VALIDATION
078600     IF CONTINUING-INSTRUCTION
078700        GO TO 210-EDIT-INPUT.

      *---------- MAKE SURE INST. NUMBER IS ENTERED
           IF ADD-NUM = SPACES
      **  INSTRUCTION NUMBER MUST BE ENTERED
               MOVE ZERO  TO LANG-SETNUM
               MOVE 40    TO LANG-MSGNUM
               PERFORM 999-CATREAD  THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER  TO  ADD-MSG-LINE
               MOVE B"1"  TO IND(1), IND(99)
               GO TO 205-SHOW-FORM.
078800
      *---------- VALIDATE CONTINUATION INDICATOR
           IF ADD-X = " " OR "X"
               NEXT SENTENCE
           ELSE
      **  ENTER AN 'X' TO CONTINUE ENTERING STANDARD INSTRUCTIONS
               MOVE ZERO TO LANG-SETNUM
               MOVE 41   TO LANG-MSGNUM
               PERFORM 999-CATREAD  THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER  TO  ADD-MSG-LINE
               MOVE B"1"  TO IND(10), IND(99)
               GO TO 205-SHOW-FORM.

      *---------- VALIDATE PRINT SIZE INDICATOR
           IF ADD-P = " " OR "C" OR "E"
               NEXT SENTENCE
           ELSE
      **   VALID ENTRIES ARE 'B', 'C', OR ' '; CORRECT AND REENTER
               MOVE ZEROS TO LANG-SETNUM
               MOVE 42    TO LANG-MSGNUM
               PERFORM 999-CATREAD  THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER  TO  ADD-MSG-LINE
               MOVE B"1"  TO IND(11), IND(99)
               GO TO 205-SHOW-FORM.

078900*----------  VALIDATE THAT INSTRUCTION DOES NOT ALREADY EXIST
079000     MOVE ADD-NUM                  TO BUILD-COM-NO.
079100     MOVE BUILD-COMMENT-NO         TO COMMENT-ARG.
           PERFORM 500-GET-MCOMMENT-I.
079400     IF NO-ENTRY
079500        NEXT SENTENCE
079600     ELSE
079700        IF GOOD-CALL
      *  INSTRUCTION NUMBER ALREADY EXISTS - CORRECT AND REENTER
079800           MOVE   9 TO LANG-SETNUM
079810           MOVE  29 TO LANG-MSGNUM
079820           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                 MOVE 1 TO FIELD-NUMBER
                 MOVE B"1" TO IND(FIELD-NUMBER) IND(99)
                 MOVE MESSAGE-BUFFER TO ADD-MSG-LINE
080100           GO TO 205-SHOW-FORM
080200        ELSE
080300           MOVE "DBFIND DCOMMENT 210 DECOM" TO BU-DISPLAY-MSG
080400           PERFORM 990-BLOWUP  THRU 999-EXIT.
080500
080600 210-EDIT-INPUT.
080700*----------  CHECK IF THEY ENTERED ANYTHING IN DESCRIPTION LINES
           IF CONTINUING-INSTRUCTION
              NEXT SENTENCE
           ELSE
080800     IF ADD-LINES (1)  = SPACES
080900        IF ADD-LINES (2) = SPACES
081000        IF ADD-LINES (3) = SPACES
081100        IF ADD-LINES (4) = SPACES
      *   AT LEAST ON INSTRUCTION MUST BE ENTERED
081200            MOVE   1 TO LANG-SETNUM
081210            MOVE   5 TO LANG-MSGNUM
081220            PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                  MOVE 2 TO FIELD-NUMBER
                  MOVE B"1" TO IND(FIELD-NUMBER) IND(99)
                  MOVE MESSAGE-BUFFER  TO ADD-MSG-LINE
081500            GO TO 205-SHOW-FORM.
