       IDENTIFICATION DIVISION.
       PROGRAM-ID.     TR3PURINF.
       AUTHOR.         HARRY PROCTOR.
       DATE-WRITTEN.   FEB 2004.
       DATE-COMPILED.

      ************************************************************
      **                                                        **
      ** TR3PIR                                                 **
      ** ======                                                 **
      **   THIS PROGRAM EXTRACTS CSIS VENDOR DATA FOR R/3.      **
      **                                                        **
      ** FILES CREATED:                                         **
      ** ==============                                         **
      **   R3FPPIR     --                                       **
      **                                                        **
      ************************************************************
      ** 6/08/04 - BRUCE GEISER                                 **
      **   CHANGED COST TO INCLUDE 2 DECIMAL POSITIONS. PER     **
      **   E-MAIL FROM SALLY LAMSON.                            **
      **                                                        **
      ************************************************************

       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.

       SOURCE-COMPUTER.          IBM-AS400.
       OBJECT-COMPUTER.          IBM-AS400.

       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT MPLTINFO-I
               ASSIGN         TO DATABASE-MCFLCS0501
               ORGANIZATION   IS INDEXED
               ACCESS MODE    IS DYNAMIC
               RECORD KEY     IS EXTERNALLY-DESCRIBED-KEY
               FILE STATUS    IS FILE-STATUS.

           SELECT STORES-I
               ASSIGN         TO DATABASE-MCFLCS0201
               ORGANIZATION   IS INDEXED
                 ACCESS MODE  IS DYNAMIC
               RECORD KEY     IS EXTERNALLY-DESCRIBED-KEY
               FILE STATUS    IS FILE-STATUS.

           SELECT LOAD-FILE
               ASSIGN         TO DATABASE-R3FPPIR
               ORGANIZATION   IS INDEXED
                 ACCESS MODE  IS DYNAMIC
               RECORD KEY     IS EXTERNALLY-DESCRIBED-KEY
               FILE STATUS    IS FILE-STATUS.

           SELECT PRINT-FILE  ASSIGN TO PRINTER-MCPRT.

       DATA DIVISION.
       FILE SECTION.
       FD  MPLTINFO-I
           LABEL RECORDS ARE STANDARD.
       01  MPLTINFO-REC-I.
           COPY DDS-MCRPCS0500  OF MCFLCS0501.

       FD  STORES-I
           LABEL RECORDS ARE STANDARD.
       01  STORES-REC-I.
           COPY DDS-MCRPCS0200 OF MCFLCS0201.

       FD  LOAD-FILE
           LABEL RECORDS ARE STANDARD.
       01  LOAD-REC.
           COPY DDS-R3RPIR  OF R3FPPIR.

       FD  PRINT-FILE
           LABEL RECORDS ARE OMITTED
           RECORD CONTAINS 132 CHARACTERS
           DATA RECORD IS PRINT-REC.
       01  PRINT-REC                     PIC X(132).

       WORKING-STORAGE SECTION.
       77  LINE-CTR                      PIC 99.
       77  TOT-RECS-CTR                  PIC 9(5).
       77  POITEM-EOF-SW                 PIC X     VALUE "N".
       77  STORES-EOF-SW                 PIC X     VALUE "N".
       77  HOLD-PLT-ID                   PIC X.
       77  HOLD-PLANT-CODE               PIC X(4).
       77  VENDOR-ARG                    PIC X(10).
       77  HOLD-ZIP                      PIC X(9).
       77  SUB                           PIC 9(2).
       77  SUB2                          PIC 9(2).

       01  PLANT-ENTRIES.
           05  FILLER      PIC X(8)  VALUE "111N515 ".
           05  FILLER      PIC X(8)  VALUE "284N514C".
           05  FILLER      PIC X(8)  VALUE "126N501D".
           05  FILLER      PIC X(8)  VALUE "631N510E".
           05  FILLER      PIC X(8)  VALUE "281N506F".
           05  FILLER      PIC X(8)  VALUE "131N502G".
           05  FILLER      PIC X(8)  VALUE "211N505K".
           05  FILLER      PIC X(8)  VALUE "153N508L".
           05  FILLER      PIC X(8)  VALUE "637N509M".
           05  FILLER      PIC X(8)  VALUE "133N503P".
           05  FILLER      PIC X(8)  VALUE "285N507T".
           05  FILLER      PIC X(8)  VALUE "129N504U".
           05  FILLER      PIC X(8)  VALUE "629N511V".

       01  PLANT-TABLE REDEFINES PLANT-ENTRIES.
           05  PLANT-DATA-LINE  OCCURS 13 TIMES  INDEXED BY I.
               10  CSIS-PLT-NO    PIC X(3).
               10  SAP-PLT-NO     PIC X(4).
               10  SAP-PO-PREFIX  PIC X.

       01  HOLD-FAX               PIC X(24).

      *****************************************************************
      **  S U B P R O G R A M   A R E A                              **
      *****************************************************************

       COPY TBLOWUP  IN COPYLIB.

      *COPY TDATECHK IN COPYLIB.

      *****************************************************************
      **  D A T A B A S E   W O R K                                  **
      *****************************************************************

       COPY FILESTAT   OF COPYLIB.

      *COPY OVRPFDATA  OF COPYLIB.

      *COPY DBPOARG1   OF COPYLIB.

       COPY DATAB      OF COPYLIB.

       COPY VCOMAREA   OF COPYLIB.

      *****************************************************************
      **  D A T A B A S E   B U F F E R S                            **
      *****************************************************************

       COPY MSTORERM   OF COPYLIB.

       COPY MPLT0      OF COPYLIB.
       COPY MPLTP01    OF COPYLIB.

      /****************************************************************
      *           FILE STATUS
      *****************************************************************

       01  FILE-STATUS-WORDS.
           05  PF-STATUS            PIC XX  VALUE "00".
               88  NO-FILE-ERR              VALUE "00".
               88  END-OF-FILE              VALUE "10".
               88  DUPLICATE-KEY            VALUE "22".
               88  NO-RECORD-FOUND          VALUE "23".
       01 NUM-CVT                   PIC S9(13)V99.
       01 R3-COST                   PIC X(11) JUST RIGHT.

      *****************************************************************
      **  R / 3   R E C O R D   L A Y O U T                          **
      *****************************************************************

       01 MK01-LOAD-REC.
          05  MK01-PLANT              PIC X(4).
          05  MK01-VENDOR-CODE        PIC X(12).
          05  MK01-CORP-CODE          PIC X(07).
          05  MK01-COST               PIC X(11).
          05  MK01-UOM                PIC X(02).
          05  MK01-TAX-CODE           PIC X(01).
          05  MK01-DATE               PIC X(08).
          05  MK01-CONSIGN            PIC X(01).
          05  MK01-FILLER             PIC X(97).


      *****************************************************************
      **  P R O C E D U R E   D I V I S I O N                        **
      *****************************************************************

       PROCEDURE DIVISION.

       START-PGM.
           PERFORM 1-HSK.
           PERFORM 6-MAIN UNTIL STORES-EOF-SW = "Y".
           PERFORM 2-EOJ.
           GOBACK.

       1-HSK.

           OPEN INPUT  STORES-I
                       MPLTINFO-I
                OUTPUT LOAD-FILE.
      *    OPEN OUTPUT PRINT-FILE.
      *    MOVE "N"    TO POITEM-EOF-SW.
      *    MOVE 61     TO LINE-CTR.
           MOVE "P 01" TO PLTINFOKEY  OF MPLTINFO-REC-I.
           READ MPLTINFO-I INTO BUF-MPLTINFO
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
      *--------- REPLACE CSIS PLANT CODE WITH SAP PLANT CODE.
           SET I TO 1.
           SEARCH PLANT-DATA-LINE
               AT END
                   MOVE SPACES             TO  HOLD-PLANT-CODE
                                               HOLD-PLT-ID
               WHEN CSIS-PLT-NO (I) = MPLTINFO-COMPANY
                   MOVE SAP-PLT-NO (I)     TO  HOLD-PLANT-CODE
                   MOVE SAP-PO-PREFIX (I)  TO  HOLD-PLT-ID.
           MOVE SPACES TO MK01-LOAD-REC.
           PERFORM 9100-START-STORES-I.
           PERFORM 9110-READ-NEXT-STORES-I.

       2-EOJ.
           CLOSE MPLTINFO-I
                 STORES-I
                 LOAD-FILE.
      *          PRINT-FILE.

       200-BLOWUP.
           MOVE "TR3PIR" TO BU-PGM-NAME.
           CALL "TBLOWUP" USING BASE, BU-PGM-NAME, STATUS-AREA,
               VIEW-COMAREA, FILE-STATUS, BU-DISPLAY-MSG,
               BU-DISPLAY-FLDS.

       6-MAIN.
           IF STR-MKT-COST > 0
              AND STR-LAST-VENDOR NOT = SPACES
              PERFORM 100-WRITE-R3-REC.
           PERFORM 9110-READ-NEXT-STORES-I.

       100-WRITE-R3-REC.
           MOVE SPACES          TO MK01-LOAD-REC.
           MOVE HOLD-PLANT-CODE TO MK01-PLANT.
           MOVE STR-LAST-VENDOR TO MK01-VENDOR-CODE.
           MOVE CORP-CODE       TO MK01-CORP-CODE.
    *****  MOVE STRMKTCOST      TO NUM-CVT.
    *****  CONVERT A 4 DIGIT DECIMAL TO A CHARACTER WITH 2 DECIMALS.
           COMPUTE NUM-CVT ROUNDED = STRMKTCOST * 1.
           DIVIDE NUM-CVT BY 10000 GIVING NUM-CVT.
           MOVE NUM-CVT         TO R3-COST.
           MOVE R3-COST         TO MK01-COST.
           MOVE STR-UM          TO MK01-UOM.
           MOVE STR-TAX-CODE    TO MK01-TAX-CODE.
           MOVE STR-CONS-IND    TO MK01-CONSIGN.
           MOVE MK01-LOAD-REC   TO LOAD-REC.
           WRITE LOAD-REC.

      ***************************************************************
      ** U T I L I T Y   P A R A G R A P H S                       **
      ***************************************************************

      ***************************************************************
      ** F I L E   I N P U T                                       **
      ***************************************************************

       9100-START-STORES-I.
           MOVE LOW-VALUES TO CORPCDE OF STORES-REC-I.
           START STORES-I KEY > CORPCDE OF STORES-REC-I
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.

       9110-READ-NEXT-STORES-I.
           READ STORES-I NEXT INTO BUF-MSTORERM
               AT END MOVE "Y" TO STORES-EOF-SW.

