062100         DUMMY-VIEW-AREA, FILE-STATUS, BU-DISPLAY-MSG,
062200             BU-DISPLAY-FLDS.
062500 8-INPUT-RECORDS SECTION.
       8-BEGIN-HERE.
062600     PERFORM 81-HOUSEKEEPING THRU 81-H-EXIT.
           IF NO-OF-DAYS-OLD-X = SPACES AND
              REQ-NO-OF-DAYS-OLD-X = SPACES
               GO TO 8-IR-EXIT.
062700     PERFORM 86-MAIN THRU 86-M-EXIT UNTIL
062800             ALL-RECORDS-RETRIEVED-SW = "Y".
062900     GO TO 8-IR-EXIT.
063000
063100 81-HOUSEKEEPING.
063200
063300**************************************************************
063400*    IN THIS PARAGRAPH I INITIALIZE AREAS IN WORKING STORAGE,*
063500*  USE JULIANDATE AND GREGORIAN DATE UTILITIES TO CALCULATE  *
063600*  THE DATE NO-OF-DAYS-OLD AND REQ-NO-OF-DAYS-OLD.           *
063700**************************************************************
063800
063900     MOVE 1        TO  DATE-MODE.
064000     CALL "TDATECHK" USING DATE-CHECK-AREA.
064100     MOVE DATE-SLASH-OUT     TO DATE-2-H, DATE-4-H, DATE-9-H.
064200     MOVE DATE-FORMATTED-TIME-OUT TO TIME-2-H,
064300                                     TIME-4-H, TIME-9-H.
064400     MOVE DATE-YMD-OUT       TO GREGDATE-YMD.
           IF GREGDATE-YY > "70"
               MOVE "19" TO GREGDATE-CC
           ELSE
               MOVE "20" TO GREGDATE-CC.
           MOVE SPACES TO JULDATE.
           CALL "JULGREG" USING GREGDATE JULDATE DAYDIGIT LEAPYEAR.
           MOVE JULDAY             TO TODAYS-JULIAN.
           IF NO-OF-DAYS-OLD-X = SPACES
               GO TO 81-CALC-REQ-DATE.
065000
065100 81-CALC-PO-DATE.
065200     IF TODAYS-JULIAN > NO-OF-DAYS-OLD
065300         NEXT SENTENCE
065400     ELSE
065500         ADD  365    TO TODAYS-JULIAN
065600         SUBTRACT 1  FROM JULYEAR
065700         GO TO 81-CALC-PO-DATE.
065800
065900     SUBTRACT NO-OF-DAYS-OLD FROM TODAYS-JULIAN.
           MOVE TODAYS-JULIAN TO JULDAY.
           MOVE SPACES TO GREGDATE.
           CALL "JULGREG" USING GREGDATE JULDATE DAYDIGIT LEAPYEAR.
066100     MOVE GREGDATE TO CUR-DATE-CHECK-CN.
           DISPLAY "PO DATE CUTOFF=", CUR-DATE-CHECK-CN.
068800     MOVE NO-OF-DAYS-OLD     TO NUMBER-OF-DAYS-OUT,
068900                                NON-RCV-NO-OF-DAYS-OUT.
066600
           MOVE DATE-YMD-OUT       TO GREGDATE-YMD.
           IF GREGDATE-YY > "70"
               MOVE "19" TO GREGDATE-CC
           ELSE
               MOVE "20" TO GREGDATE-CC.
           MOVE SPACES TO JULDATE.
           CALL "JULGREG" USING GREGDATE JULDATE DAYDIGIT LEAPYEAR.
           MOVE JULDAY             TO TODAYS-JULIAN.
067200
067300 81-CALC-REQ-DATE.
           IF REQ-NO-OF-DAYS-OLD-X = SPACES
               GO TO 81-START-DPORECD.

067400     IF TODAYS-JULIAN > REQ-NO-OF-DAYS-OLD
067500         NEXT SENTENCE
067600     ELSE
067700         ADD  365    TO TODAYS-JULIAN
067800         SUBTRACT 1  FROM JULYEAR
067900         GO TO 81-CALC-REQ-DATE.
068000
068100     SUBTRACT REQ-NO-OF-DAYS-OLD FROM TODAYS-JULIAN.
           MOVE TODAYS-JULIAN TO JULDAY.
           MOVE SPACES TO GREGDATE.
           CALL "JULGREG" USING GREGDATE JULDATE DAYDIGIT LEAPYEAR.
066100     MOVE GREGDATE TO CUR-DATE-REQ-CHECK-CN.
           DISPLAY "REQUIREMENT DATE CUTOFF=", CUR-DATE-REQ-CHECK-CN.
069000     MOVE REQ-NO-OF-DAYS-OLD TO REQ-NUMBER-OF-DAYS-OUT.
069100
      *------ DO A START ON DPORECD TO POSITION TO BEGINNING OF
      *------ FILE.
       81-START-DPORECD.
           MOVE SPACES TO PORCVNO OF DPORECD-REC-I.
           START DPORECD-I KEY > PORCVNO OF DPORECD-REC-I
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE "START DPORECD *82-CJD" TO BU-DISPLAY-MSG
               GO TO 2-BLOWUP.

069200 81-H-EXIT.
069300     EXIT.
069400
069500 86-MAIN.
069600
069700**************************************************************
069800*     I DO A SERIAL READ (MODE2) ON THE DPORECD DATASET      *
069900**************************************************************
070000
           READ DPORECD-I NEXT INTO BUF-DPORECD
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14"
070500             MOVE "Y" TO ALL-RECORDS-RETRIEVED-SW
070600             GO TO 86-M-EXIT
070700         ELSE
070800             MOVE "GET DPORECD*86-MAIN" TO BU-DISPLAY-MSG
070900             GO TO 2-BLOWUP.
071000
071100**********************************************************
071200*     CHECK TO SEE IF THE PURCHASE ORDER IS A BLANKET    *
071300*  PURCHASE ORDER, IF THE DATE CHECK PASSES WE AUTO.     *
071400*  WRITE THE RECORD.  HOWEVER, THE INDIVIDUAL RELEASES   *
071500*  AGAINST THE BLANKETS WILL BE TREATED JUST LIKE NORMAL *
071600*  PURCHASE ORDERS FOR PURPOSES OF THESE REPORTS.        *
      *---4/10/96 ADDED KELLY LOGIC FOR BLANKET ORDERS (JSB)   *
071700**********************************************************
071900
072000     IF PO-RLS-NO = "999"
            OR (KELLY-PLANT AND PO-BLANKET-INDIC = "B")
072100         IF REQ-NO-OF-DAYS-OLD-X NOT = SPACES
072200             IF CUR-DATE-REQ-CHECK-CN > PO-EXPECT-DATE-CN
072300                 MOVE "3" TO TYPE-TRANS-SW
072400                 PERFORM 8642-RELEASE-TO-SORT
072500                 GO TO 86-M-EXIT
072600             ELSE
072700                 GO TO 86-M-EXIT
072800         ELSE
072900             GO TO 86-M-EXIT.
073000
073100*****************************
073200*   SEE IF OPEN POs ARE TO  *
073300*   INCLUDED ON THE RPT.    *
073400*****************************
073500
073600     IF NO-OF-DAYS-OLD-X = SPACES
073700         GO TO 86-M-EXIT.
073000
073800*****************************
073800*   CHECK FOR SPECIFIED     *
073800*   BUYER CODES             *
073800*****************************
073800
073800     IF  SEL-BUYER-CODE = SPACES
073800         NEXT SENTENCE
073800     ELSE
073800         IF SEL-BUYER-CODE = PO-BUYER-CODE
073800             NEXT SENTENCE
073800         ELSE
073800             GO TO  86-M-EXIT.
073800
073800*****************************
073800*   CHECK FOR SPECIFIED     *
073800*   RECEIVING DEPARTMENTS   *
073800*****************************
073800
073800     IF  SPACES = RCV-DEPT-1 AND
073800                  RCV-DEPT-2 AND
073800                  RCV-DEPT-3
073800         NEXT SENTENCE
073800     ELSE
073800         IF PO-RCV-DEPT = RCV-DEPT-1 OR
073800                          RCV-DEPT-2 OR
073800                          RCV-DEPT-3
073800             NEXT SENTENCE
073800         ELSE
073800             GO TO  86-M-EXIT.
073800
073900******************************
074000*  CHECK TO SEE IF PO IS A   *
074100*  NON-RECEIVABLE ONE AND    *
      *  SHOULD IT BE INCLUDED     *
074200******************************
074300
            IF NON-REC-PO = SPACES
               NEXT SENTENCE
            ELSE
074400         IF PO-NON-RCV-INDIC = "X"
075000             GO TO 86-M-EXIT.

074400      IF PO-NON-RCV-INDIC = "X"
074500         IF CUR-DATE-CHECK-CN  >  PO-EXPECT-DATE-CN
074600             MOVE "2" TO TYPE-TRANS-SW
074700             PERFORM 864-CHECK-ITEM THRU 864-CI-X
074800             GO TO 86-M-EXIT
074900         ELSE
075000             GO TO 86-M-EXIT.
075100
075200*****************************
075300*  CHECK TO MAKE SURE PO    *
075400*  HAS BEEN EXPECTED.       *
075500*****************************
075600
075700     IF PO-EXPECT-DATE = SPACES
075800         NEXT SENTENCE
075900     ELSE
               IF SEL-EXP-DATE = SPACES
                   NEXT SENTENCE
               ELSE
076000           IF CUR-DATE-CHECK-CN  <  PO-EXPECT-DATE-CN
076100             GO TO 86-M-EXIT.
076200
076400     IF CUR-DATE-CHECK-CN > PO-DATE-CN
076500         NEXT SENTENCE
076600     ELSE
076700         GO TO 86-M-EXIT.
076800
      *****************************
      *  CHECK TO MAKE SURE VENDOR*
      *  MATCHES PO IF SUPPLIED.  *
      *****************************

           IF SEL-VEN-CODE = SPACES
               NEXT SENTENCE
           ELSE
               IF SEL-VEN-CODE = PO-VEN-CODE
                   NEXT SENTENCE
               ELSE
                   GO TO 86-M-EXIT.

076900     MOVE "1" TO TYPE-TRANS-SW.
077000     PERFORM 864-CHECK-ITEM THRU 864-CI-X.
077100
077200 86-M-EXIT.
077300     EXIT.
077400
077500 864-CHECK-ITEM.
077600     MOVE PO-RCV-NO TO PO-ARG.
           MOVE PO-ARG TO PORCVNO OF DPOITEM-REC-I.
           START DPOITEM-I KEY = PORCVNO OF DPOITEM-REC-I
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
078800             GO TO 864-CI-X
               ELSE
078000             MOVE "FIND DPOITEM*864-CI" TO BU-DISPLAY-MSG
078100             GO TO 2-BLOWUP.
1094CZ     MOVE "Y" TO FIRST-ITEM-INDIC.
078200
078300 8641-GET-DPOITEMS.
           READ DPOITEM-I NEXT INTO BUF-DPOITEM
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14"
078800             GO TO 864-CI-X
078900         ELSE
079000             MOVE "GET DPOITEM *8641-GD" TO BU-DISPLAY-MSG
079100             GO TO 2-BLOWUP.
           IF PORCVNO OF DPOITEM-REC-I NOT = PO-ARG
078800         GO TO 864-CI-X.
079200
      *----------------------------------------------------------------*
      *  IF OPTION TO EXCLUDE NON-CODED PO'S WAS CHOSEN, CHECK IF      *
      *  ITEM-NUMBER = 0001 AND IF CORP-CODE = NON-STR.  IF BOTH       *
      *  CONDITIONS ARE TRUE, THIS PO IS CONSIDERED NON-CODED AND IS   *
      *  EXCLUDED FROM THE REPORT.         10/10/94   CA ZUBEK         *
      *----------------------------------------------------------------*

1094CZ     IF EXCLUDE-NON-CODED = "X"  AND  FIRST-ITEM
1094CZ         IF ITM-CORP-CODE = "NON-STR"
1094CZ             GO TO 864-CI-X.
1094CZ     MOVE "N" TO FIRST-ITEM-INDIC.

079300     IF ITM-COMPLETE-FLAG > SPACES
079400         GO TO 8641-GET-DPOITEMS.
079500
079600*--------------  CRITERIA SELECTION:
079700*--------------    A - COMPARE QTY ORD   TO   QTY DLVR
079800*--------------    B - COMPARE QTY PAID  TO   QTY DLVR
079900*--------------    C - COMPARE QTY ORD   TO   QTY DLVR   AND
080000*--------------                QTY PAID  TO   QTY DLVR
080100*--------------  IF CRITERIA SELECTION IS A OR C, WE COMPARE QTY DLVR
080200*--------------  TO QTY ORD.  IF QTY DLVR < QTY ORD, PO IS CONSIDERED
080300*--------------  OPEN.
080400
080500     IF CRITERIA-SEL = "A" OR "C"
080600         IF ITM-QTY-DLVR  <  ITM-QTY-ORD
080700             GO TO 8642-RELEASE-TO-SORT
080800         ELSE
080900             IF CRITERIA-SEL = "A"
081000                 GO TO 8641-GET-DPOITEMS.
081100
081200*--------------  IF CRITERIA SELECTION IS B OR C, WE COMPARE QTY PAID
081300*--------------  TO QTY DLVR.  IF QTY PAID < QTY DLVR, PO IS CONSIDERED
081400*--------------  OPEN.
081500
081600     IF CRITERIA-SEL = "B" OR "C"
081700         IF ITM-QTY-PAID < ITM-QTY-DLVR
081800             GO TO 8642-RELEASE-TO-SORT
081900         ELSE
082000             GO TO 8641-GET-DPOITEMS.
082100
082200
082300 8642-RELEASE-TO-SORT.
082400     MOVE PO-PO-NO       TO PONUM-SORT.
082500     MOVE PO-RLS-NO      TO BLANKET-SORT.
082600     MOVE PO-RCVR        TO RECEIVER-SORT.
082700     MOVE PO-DATE-CN     TO PODATE-SORT-CN.
082800     MOVE PO-EXPECT-DATE TO EXPECT-DATE-SORT.
082900     MOVE PO-BUYER-CODE  TO BUYER-SORT.
           MOVE PO-NON-RCV-INDIC   TO  NON-RCV-SORT.
083000     IF TYPE-TRANS-SW = "3"
083100         MOVE SPACES       TO VENCODE-SORT
083200     ELSE
083300         MOVE PO-VEN-CODE  TO VENCODE-SORT.
083400
083500     RELEASE SORT-REC.
083600
083700 864-CI-X.
083800     EXIT.
083900
084000
084100
084200 8-IR-EXIT.
084300     EXIT.
084400
084500 9-OUTPUT-RECORDS SECTION.
       9-BEGIN-HERE.
084600     IF PAPER-IS-132-COLS
084700         NEXT SENTENCE
084800     ELSE
084900        WRITE PRT-REC FROM COMPRESS-PRINT AFTER ADVANCING 0.
085200
085300     PERFORM 96-MAIN THRU 96-M-EXIT UNTIL
085400             ALL-RECORDS-WRITTEN-SW = "Y".
085500     PERFORM 98-CHECK-ALL-REPORTS THRU 98-CAR-EXIT.
085600     GO TO 9-OR-EXIT.
085700
085800 96-MAIN.
085900     RETURN SORT-FILE AT END
086000         MOVE "Y" TO ALL-RECORDS-WRITTEN-SW
086100         GO TO 96-M-EXIT.
