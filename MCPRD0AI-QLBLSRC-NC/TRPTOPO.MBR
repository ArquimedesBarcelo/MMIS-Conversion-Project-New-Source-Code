053600         HD-ROUTE-DATA, ESC-NAME.
053700     IF HD-RET-CODE NOT = 0
053800         MOVE "THDPRT2 ERROR * RPTOPO" TO BU-DISPLAY-MSG
053900         MOVE "HD-RET-CODE = "        TO BU-DISPLAY-FLD (1)
054000         MOVE HD-RET-CODE             TO BU-DISPLAY-FLD9 (1)
054100         GO TO 2-BLOWUP.
054200
054300     MOVE "TRPTOPO" TO BU-PGM-NAME.
054900
           MOVE "N" TO INVOICE-IND.
055000     MOVE "PODL" TO PLT-ARG.
           MOVE PLT-ARG TO PLTINFOKEY OF MPLTINFO-REC-I.
           READ MPLTINFO-I INTO BUF-MPLTINFO
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
                   NEXT SENTENCE
               ELSE
                   MOVE "DBGET MPLTINFO * 10-OF" TO BU-DISPLAY-MSG
                   GO TO 2-BLOWUP
           ELSE
               IF MPLTINFO-INVOICE-IND = "Y"
                   MOVE "Y" TO INVOICE-IND.
056200
056300     IF CRITERIA-SEL = "B" OR "C"
056400         IF NOT INVOICE-IND-ON
056500             MOVE
056600             "INVALID SELECTION - NO PAID QUANTITIES AVAILABLE "
056700                 TO SEL-OUT
056800             WRITE PRT-REC FROM HEADING-1-H AFTER
                       ADVANCING NEW-PAGE
056900             GO TO 2-EOJ.

      *-----GET PLANT NUMBER
           MOVE "P 01" TO PLT-ARG.
           MOVE PLT-ARG TO PLTINFOKEY OF MPLTINFO-REC-I.
           READ MPLTINFO-I INTO BUF-MPLTINFO
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE "READ MPLTINFO P 01" TO BU-DISPLAY-MSG
               GO TO 2-BLOWUP
           ELSE
               MOVE MPLTINFO-COMPANY TO WHICH-PLANT
                                        PLANT-EVAL.

057200     CALL "TESCSEQ" USING ESC-NAME.
