043300**************************************************************
043400*        P R O C E D U R E        D I V I S I O N            *
046100**************************************************************
046200 PROCEDURE DIVISION USING HD-ROUTE-DATA LINE-1.
046300 00-MAIN.
046400     MOVE "TOPNCMT2"                   TO BU-PGM-NAME.
046500     PERFORM 010-OPEN-FILES     THRU 019-EXIT.
046700     PERFORM 100-READ-ITEMS     THRU 199-EXIT.
046800     PERFORM 200-SORT           THRU 299-EXIT.
046900     PERFORM 300-PRINT-REPORT   THRU 399-EXIT.
047000     PERFORM 020-CLOSE-FILES    THRU 029-EXIT.
047100     GOBACK.
047300*************************************************************
047400*           OPEN DATABASE AND PRINT FILE                    *
047500*************************************************************
047600 010-OPEN-FILES.
           OPEN INPUT DPORECD-I MSTORERM-I DINVRCD-I
                      MPLTINFO-I.

           MOVE 70 TO LINE-CTR.
048100
048200*----------  BUILD NEW TEMP FILE
048300*    MOVE SPACES TO COMMAND.
048400*    MOVE "BUILD INVDISC.PUB;DISC=50000,32,7;REC=-133,25,F,ASCII;T&"
048500*-               "EMP"  TO COMMAND
048600*    CALL INTRINSIC "COMMAND" USING COMMAND-IMAGE, COMMAND-ERROR,
048700*                                   COMMAND-PARM.
048800*    IF COMMAND-ERROR NOT = 0
048900*       MOVE COMMAND TO BU-DISPLAY-MSG
049000*       MOVE "COMMAND INTRINSIC FAILED" TO BU-DISPLAY-FLD (1)
049100*       MOVE COMMAND-ERROR              TO BU-DISPLAY-FLD9 (1)
049200*       MOVE COMMAND-PARM               TO BU-DISPLAY-FLD9 (2)
049300*       PERFORM 990-BLOWUP THRU 999-EXIT.
049400*----------  OPEN OUTPUT FILE
      *----- CALL CCRTFILE TO CREATE A TEMPORARY FILE FOR SORTING
      *----- LIBRARY 'QTEMP' IS USED FOR TEMPORARY FILES
           MOVE SPACES        TO CCRTFILE-PARMS.
           MOVE "QTEMP"       TO CCRTFILE-LIBRARY.
           MOVE "SORTED"      TO CCRTFILE-FILE.
           MOVE "0075"        TO CCRTFILE-RECORD-LENGTH.
           MOVE "90000"       TO CCRTFILE-NO-RECORDS.
           MOVE "02000"       TO CCRTFILE-INCREMENT-AMT.
           MOVE "10"          TO CCRTFILE-NO-INCREMENTS.
           CALL "CCRTFILE" USING CCRTFILE-LIBRARY,
                                 CCRTFILE-FILE,
                                 CCRTFILE-RECORD-LENGTH,
                                 CCRTFILE-NO-RECORDS,
                                 CCRTFILE-INCREMENT-AMT,
                                 CCRTFILE-NO-INCREMENTS,
                                 CCRTFILE-STATUS.
           IF CCRTFILE-STATUS NOT = "00"
               MOVE "CCRTFILE CREATE OF 'SORTED' FAILED"
                  TO BU-DISPLAY-MSG
               PERFORM 990-BLOWUP THRU 999-EXIT.
049500     OPEN OUTPUT SORTED-PRINT-FILE.
049600
049700     MOVE 1  TO  DATE-MODE.
049800     CALL "TDATECHK" USING DATE-CHECK-AREA.
049900     MOVE DATE-YMD-OUT  TO  DATE-90-DAYS-OLD,
050000                            TODAYS-DATE.
      *--------- ACCOUNT FOR CENTURY.
           IF DATE-90-YY > 70
               MOVE 19        TO  DATE-90-CC
                                  TODAYS-DATE-CC
           ELSE
               MOVE 20        TO  DATE-90-CC
                                  TODAYS-DATE-CC.
050100     IF DATE-90-MM < 04
050200         SUBTRACT 1  FROM  DATE-90-DAYS-YEAR
050300         ADD 12  TO  DATE-90-MM.
050400     SUBTRACT 3  FROM  DATE-90-MM.
050500     MOVE "P 01"         TO  PLT-ARG.
050600*    CALL "DBGET" USING BASE, DSET-MPLTINFO, MODE7,
050700*        STATUS-AREA, ALL-ITEM-LIST, BUF-MPLTINFO, PLT-ARG.
           MOVE 0 TO COND-WORD.
           MOVE PLT-ARG TO PLTINFOKEY OF MPLTINFO-REC-I.
           READ MPLTINFO-I INTO BUF-MPLTINFO
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS-1 = "2"
               MOVE 17 TO COND-WORD
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD.
050800     IF COND-WORD NOT = ZERO
050900         MOVE "GET MPLTINFO 1-HSK" TO BU-DISPLAY-MSG
051000         MOVE PLT-ARG              TO BU-DISPLAY-FLD (1)
051100         PERFORM 990-BLOWUP  THRU 999-EXIT
051200     ELSE
051300         MOVE MPLTINFO-COMPANY     TO COMPANY-SAVE.
051400
051500 019-EXIT.  EXIT.
051600
051700*************************************************************
051800*               CLOSE DATABASE AND PRINT FILE               *
051900*************************************************************
052000 020-CLOSE-FILES.
052100     CLOSE DISC-PRT, SORTED-PRINT-FILE.
           CLOSE DPORECD-I MSTORERM-I DINVRCD-I
                 MPLTINFO-I.
052300 029-EXIT.  EXIT.

057500*************************************************************
057600*************************************************************
057700*       READ ALL OF DPORECD ENTRIES.                        *
057900*************************************************************
058000*************************************************************
058100 100-READ-ITEMS.
058200*    CALL "DBGET" USING BASE, DPORECD, MODE2, STATUS-AREA,
058300*                 ALL-ITEM-LIST, BUF-DPORECD, DUMMY-ARG.
           MOVE 0 TO COND-WORD.
           MOVE SPACES TO PORCVNO OF DPORECD-REC-I.
           START DPORECD-I KEY IS GREATER OR EQUAL
                    PORCVNO OF DPORECD-REC-I
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
                   MOVE 17 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.
058400     IF END-OF-FILE
058500        GO TO 199-EXIT.

       102-READ-LOOP.
           MOVE 0 TO COND-WORD.
           READ DPORECD-I NEXT INTO BUF-DPORECD
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
                   MOVE 99 TO COND-WORD.
058600     IF NOT GOOD-CALL
058700        GO TO 199-EXIT.
058900
059000*----------  CANNOT PAY ON A BLANKET SO IGNORE ALL "999" RELEASES
059100     MOVE PO-RCV-NO TO PO-WORK-AREA, PO-ARG.
059200     IF PO-WORK-RLS = "999"
059300        GO TO 102-READ-LOOP.
059400
059500*-------- DONT INCLUDE POs OLDER THAN 90 DAYS FOR THE FOLLOWING
059600*-------- PLANTS
059700     IF COMPANY-SAVE = "131"
      *----------- ACCOUNT FOR CENTURY.
059800         IF PO-DATE-CN < DATE-90-DAYS-OLD-CN
059900             GO TO 102-READ-LOOP.
060000
060100*****************************************************
060200**  IF PO IS A NON-RECEIVABLE MAKE SURE THE EXPIRATION
060300**  DATE HAS NOT BEEN REACHED IF SO DONT INCLUDE THIS PO
060400**  ON THE OPEN COMMENTMENT REPORT
060500*****************************************************
060600
060700     IF PO-NON-RCV-INDIC = "X"
      *----------- ACCOUNT FOR CENTURY.
060800         IF PO-EXPECT-DATE-CN < TODAYS-DATE-CN
060900             GO TO 102-READ-LOOP
061000         ELSE
061100             MOVE "Y"  TO  NON-RCV-PO-SW
061200     ELSE
061300         MOVE "N"  TO  NON-RCV-PO-SW.
061400
      *----------  DO NOT INCLUDE FRANCHISED PURCHASE ORDER
      *----------  AS THE LIABILLITY DOES NOT OCCUR UNTIL THE
      *----------  MATERIAL IS WITHDRAWN FROM THE STOREROOM

           IF PO-NONPAY-IND = " "
               NEXT SENTENCE
           ELSE
           GO TO 102-READ-LOOP.
062000
062100 105-RETRIEVE-ITEM.
062700     PERFORM 130-FIND-PAYMENTS THRU 139-EXIT.
062800     PERFORM 140-WRITE-PO-TO-FILE THRU 149-EXIT.
062900     GO TO 102-READ-LOOP.
063000
080500*************************************************************
080600*        DETERMINE PAYMENTS MADE ON EACH ITEM.              *
080700*************************************************************
080800 130-FIND-PAYMENTS.
080900*    CALL "DBFIND" USING BASE, DINVRCD, MODE1, STATUS-AREA,
081000*                  PO-SEARCH, PO-ARG.
           MOVE 0     TO COND-WORD.
           MOVE ZEROS TO S-INVOICE-PAYMENTS-AMT,
                         S-INVOICE-PAYMENTS-ROUND.
           MOVE PO-ARG TO PORCVNO OF DINVRCD-REC-I.
           START DINVRCD-I KEY = PORCVNO OF DINVRCD-REC-I
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
                   GO TO 139-EXIT
               ELSE
                   MOVE 99 TO COND-WORD.
081100     IF NOT GOOD-CALL
081200        MOVE "DBFIND DINVRCD AT 130 IN TOPNCMT2" TO BU-DISPLAY-MSG
081300        PERFORM 990-BLOWUP THRU 999-EXIT.
081400
081500 132-GET-DINVRCD.
081600*    CALL "DBGET" USING BASE, DINVRCD, MODE5, STATUS-AREA,
081700*                 ALL-ITEM-LIST, BUF-DINVRCD, PO-ARG.
           MOVE 0 TO COND-WORD.
           READ DINVRCD-I NEXT INTO BUF-DINVRCD
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   MOVE 15 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.
           IF PORCVNO OF DINVRCD-REC-I NOT = PO-ARG
               MOVE 15 TO COND-WORD.

           IF COND-WORD NOT = ZERO
               IF COND-WORD = 15
                   ADD S-INVOICE-PAYMENTS-AMT  TO
                       S-INVOICE-PAYMENTS-ROUND  ROUNDED
                   GO TO 139-EXIT
               ELSE
                   MOVE "DBGET DINVRCD*132-GD"  TO  BU-DISPLAY-MSG
                   PERFORM 990-BLOWUP THRU 999-EXIT.

081800     IF NOT GOOD-CALL
081900        GO TO 139-EXIT.
082300
082400     IF INV-STATUS = "H" OR "I"
082500        GO TO 132-GET-DINVRCD.
082600
           IF INV-STATUS = "H" OR "I"
               NEXT SENTENCE
           ELSE
               ADD INV-NET-DUE-VENDOR  TO
                   S-INVOICE-PAYMENTS-AMT.

           GO TO 132-GET-DINVRCD.

***************************
086100 139-EXIT.  EXIT.
086300*************************************************************
086400*      WRITE PO ENTRY TO SORT FILE.                         *
086900*************************************************************
087000 140-WRITE-PO-TO-FILE.
087200
087300 142-MOVE-ITEMS.
           SUBTRACT S-INVOICE-PAYMENTS-ROUND  FROM
               PO-BUDGET-AMT  GIVING  S-OPEN-BUDGET-AMT.
           IF S-OPEN-BUDGET-AMT > 0
087800         MOVE PO-BUDGET-NUMBER         TO SRTD-BUDGET-NO
087900         MOVE PO-SUB                   TO SRTD-SUB-CLASS
088000         MOVE PO-SUB-DET               TO SRTD-SUB-DET
088100         MOVE PO-ADDL-DATA             TO SRTD-ADDL-DATA
087800         MOVE PO-BUDGET-AMT            TO SRTD-BUDGET-AMT
088300         MOVE S-INVOICE-PAYMENTS-ROUND TO SRTD-PAID-AMT
088400         MOVE PO-RCV-NO                TO SRTD-PO
088500         MOVE PO-DATE                  TO SRTD-PO-DATE
088600
088700         WRITE SRTD-RECORD.
089200
089300 149-EXIT.  EXIT.
089200
093100 199-EXIT.  EXIT.
093300*************************************************************
093400*************************************************************
093500*          SORT THE SORT FILE BY BUDGET NUMBER OR           *
093600*          BY THE OPTION THE USER SELECTED.                 *
093700*************************************************************
093800*************************************************************
093900 200-SORT.
094000     CLOSE SORTED-PRINT-FILE.
094200     SORT SORT-FILE ON ASCENDING KEY SORT-BUDGET-NO
                                           SORT-PO
094300                                     SORT-SUB-CLASS
094400                                     SORT-SUB-DET
094500                                     SORT-ADDL-DATA
094600          USING SORTED-PRINT-FILE
094700          GIVING SORTED-PRINT-FILE
094800     GO TO 299-EXIT.
094900
097100 299-EXIT.  EXIT.
097300*************************************************************
097400*************************************************************
097500*        PRINT THE REPORT.  SEPARATE BREAKS OF SELECTED     *
097600*        OPTION WITH 3 BLANK LINES, NOT WITH A NEW PAGE     *
097700*        SINCE THIS REPORT HAS THE POTENTIAL OF BEING HUGE. *
097800*************************************************************
097900*************************************************************
098000 300-PRINT-REPORT.
098100*---------- OPEN THE PRINT FILE, GET THE FILE NUMBER OF THE PRINT
098200*---------- FILE, AND PRINT THE HEADER PAGE.
098300     OPEN INPUT SORTED-PRINT-FILE.
099200
020300*----------  SET UP PRINTER ESCAPE SEQUENCES
020400     CALL "TESCSEQ" USING ESC-NAME.
020500     MOVE CHAR-1636PI     TO COMPRESS-PRINT.
020600     MOVE CHAR-10PI       TO NORMAL-PRINT.
020700     MOVE TEXT-LENGTH-61 TO ESC-TEXT-61.
020800     MOVE TEXT-LENGTH-60 TO ESC-TEXT-60.
021800
078400*----------  OPEN OUTPUT FILE
           MOVE HD-SPOOLER-NUMBER TO OVRPRTF-TOFILE-NUM.
           MOVE "*YES"       TO OVRPRTF-SHARED.
028100     MOVE HD-NO-OF-COPIES TO OVRPRTF-COPIES.
           MOVE "MCPRT"      TO OVRPRTF-FILE.
           PERFORM 996-OVERRIDE-PRINT-FILE.
021100     OPEN OUTPUT DISC-PRT.
021900*----------  PRINT HEADER PAGE
022100     MOVE "DHDR112.PUB" TO HD-FILE-NAME.
022200     CALL "THDPRT2" USING HD-RET-CODE, HD-FILE-NAME,
022300        FNUM, HD-ROUTE-DATA, ESC-NAME.
022400     IF PAPER-IS-132-COLS
022500          NEXT SENTENCE
022600     ELSE
022700         WRITE PRT-REC FROM COMPRESS-PRINT AFTER ADVANCING 0
022800         WRITE PRT-REC FROM ESC-TEXT-61 AFTER ADVANCING 0.
022900     IF HD-RET-CODE NOT = 0
023000         DISPLAY "THDRPT ERROR".
023200
099300 301-READ-LOOP.
099400     READ SORTED-PRINT-FILE
099500           AT END     PERFORM 380-BREAK-TOTAL THRU 389-EXIT
099600                      GO TO 390-REPORT-TOTALS.
099800     GO TO 305-COMPARE-BUDGET.
100500
100600 302-SEPARATE-BREAKS.
100700*----------  DO NOT PRINT BREAK TOTALS FOR FIRST READ
100800**** IF COMPARE-VARIABLES NOT = SPACES
100900     PERFORM 380-BREAK-TOTAL THRU 389-EXIT.
101000     MOVE SPACES                TO PRINT-LINE.
101100     MOVE PRINT-LINE            TO PRT-LINE.
101300     WRITE PRT-REC AFTER ADVANCING 3 LINES.
101500     ADD 3                      TO LINE-CTR.
101600
101700*----------  RESET COMPARE VARIABLES
101800     MOVE SRTD-SUB-CLASS        TO COMPARE-CLASS.
101900     MOVE SRTD-SUB-DET          TO COMPARE-DET.
102000     MOVE SRTD-ADDL-DATA        TO COMPARE-ADDL.
102100     MOVE SRTD-BUDGET-NO        TO COMPARE-BUDGET.
102200
102300     GO TO 310-MOVE-FIELDS.
102400
102500 305-COMPARE-BUDGET.
102600     IF SRTD-BUDGET-NO NOT = COMPARE-BUDGET
102700        GO TO 302-SEPARATE-BREAKS.
102900*************************************************************
103000*       PRINT THE DETAIL LINE FOR EACH RECORD.              *
103100*************************************************************
103200 310-MOVE-FIELDS.
103300     IF LINE-CTR > 55
103400        PERFORM 370-NEW-PAGE THRU 379-EXIT.
103500
103600     MOVE SPACES                TO PRINT-LINE.
103700     MOVE SRTD-BUDGET-NO        TO LINE1-BUDGET.
103800     MOVE SRTD-SUB-CLASS        TO LINE1-CLASS.
103900     MOVE SRTD-PO                TO PO-WORK-AREA.
104000     MOVE DISPLAY-PO            TO LINE1-PO.
104100     MOVE SRTD-PO-DATE          TO DATE-VALIDATE-IN.
104200     MOVE 4                     TO DATE-MODE.
104300     CALL "TDATECHK" USING DATE-CHECK-AREA.
104400     MOVE DATE-SLASH-OUT        TO LINE1-DATE.
104500     MOVE SRTD-SUB-DET          TO LINE1-SUB.
104600     MOVE SRTD-ADDL-DATA        TO LINE1-ADDTL.
104700     MOVE ZEROS                 TO WORK-BUDGET-AMT.
104800     ADD SRTD-BUDGET-AMT        TO WORK-BUDGET-AMT ROUNDED.
104900     MOVE WORK-BUDGET-AMT       TO LINE1-BUD-AMT.
105000     MOVE ZEROS                 TO WORK-PAID-AMT.
105100     ADD SRTD-PAID-AMT          TO WORK-PAID-AMT ROUNDED.
105200     MOVE WORK-PAID-AMT         TO LINE1-PAID.
105300
105400     SUBTRACT WORK-PAID-AMT FROM WORK-BUDGET-AMT
105500              GIVING WORK-OPEN-AMT.
105600     IF WORK-OPEN-AMT > ZEROS
105700         NEXT SENTENCE
105800     ELSE
105900         GO TO 301-READ-LOOP.
106000     MOVE WORK-OPEN-AMT         TO LINE1-OPEN.
106100     MOVE PRINT-LINE            TO PRT-LINE.
106200     WRITE PRT-REC AFTER ADVANCING 1 LINES.
106300     ADD 1                      TO LINE-CTR.
106400
106500     ADD SRTD-BUDGET-AMT        TO TOTAL-BAT-WS.
106600     ADD SRTD-PAID-AMT          TO TOTAL-PAT-WS.
106700     ADD WORK-OPEN-AMT          TO TOTAL-OCT-WS.
106800
106900     GO TO 301-READ-LOOP.
107100 370-NEW-PAGE.
107200     MOVE SPACES                TO PRINT-LINE.
107300     ADD 1                      TO PAGE-NUM.
107400     MOVE "O P E N   C O M M I T M E N T   R E P O R T"
107500                                TO HEAD1-TITLE.
107600     MOVE PRINT-LINE            TO PRT-LINE.
107800     WRITE PRT-REC AFTER ADVANCING NEW-PAGE.
107900     MOVE SPACES                TO PRINT-LINE.
108000
108100     MOVE 1                     TO DATE-MODE.
108200     CALL "TDATECHK" USING DATE-CHECK-AREA.
108300     MOVE DATE-FORMATTED-TIME-OUT TO HEAD2-TIME.
108400     MOVE DATE-SLASH-OUT        TO HEAD2-DATE.
108500     MOVE "by "                 TO HEAD2-TITLE.
108700     MOVE "PO HEADER "          TO HEAD2-OPTION.
109200     MOVE "PAGE "               TO HEAD2-PAGE.
109300     MOVE PAGE-NUM              TO HEAD2-PAGE-NO.
109500     MOVE PRINT-LINE            TO PRT-LINE.
109600     WRITE PRT-REC AFTER ADVANCING 1 LINE.
112500     MOVE SPACES                TO PRINT-LINE.
112600
112700     MOVE "BUDGET"              TO HEAD4-BUDGET.
112800     MOVE "CLASS"               TO HEAD4-CLASS.
112900     MOVE "SUB"                 TO HEAD4-SUB.
113000     MOVE "ADDTL"               TO HEAD4-ADDTL.
113100     MOVE "PURCHASE"            TO HEAD4-PURCHASE.
113200     MOVE "PO"                  TO HEAD4-PO.
113300     MOVE "BUDGET"              TO HEAD4-BUDGET2.
113400     MOVE "PAID"                TO HEAD4-PAID.
113500     MOVE "OPEN"                TO HEAD4-OPEN.
113700     MOVE PRINT-LINE            TO PRT-LINE.
113800     WRITE PRT-REC AFTER ADVANCING 4 LINES.
113900     MOVE SPACES                TO PRINT-LINE.
114000
114100     MOVE "NUMBER"              TO HEAD5-NUMBER.
114200     MOVE "DETAIL"              TO HEAD5-DETAIL.
114300     MOVE "DATA"                TO HEAD5-DATA.
114400     MOVE "ORDER"               TO HEAD5-ORDER.
114500     MOVE "DATE"                TO HEAD5-DATE.
114600     MOVE "AMOUNT"              TO HEAD5-AMOUNT, HEAD5-AMOUNT2.
114700     MOVE "COMMITMENT"          TO HEAD5-COMMIT.
114900     MOVE PRINT-LINE            TO PRT-LINE.
115000     WRITE PRT-REC AFTER ADVANCING 1 LINE.
115100     MOVE SPACES                TO PRINT-LINE.
115200     MOVE PRINT-LINE            TO PRT-LINE.
115300     WRITE PRT-REC AFTER ADVANCING 1 LINE.
115400
115500     MOVE  8                    TO LINE-CTR.
115600 379-EXIT.  EXIT.
115800*************************************************************
115900*      PRINT TOTALS FOR EACH GROUP BREAK                    *
116000*************************************************************
116100 380-BREAK-TOTAL.
116200     IF TOTAL-OCT-WS = ZEROS
116300         GO TO 389-EXIT.
116400     MOVE SPACES                 TO PRINT-LINE.
116500     MOVE "==============" TO DASHES1, DASHES2, DASHES3.
116700     MOVE PRINT-LINE             TO PRT-LINE.
116800     WRITE PRT-REC AFTER ADVANCING 1 LINES.
116900     MOVE SPACES                 TO PRINT-LINE.
117000     MOVE TOTAL-BAT-WS           TO TOTAL-BAT.
117100     MOVE TOTAL-PAT-WS           TO TOTAL-PAT.
117200     MOVE TOTAL-OCT-WS           TO TOTAL-OCT.
117300     MOVE "TOTAL  "              TO TOTAL-TOTAL.
117400     MOVE " *"                   TO TOTAL-END.
117500     MOVE PRINT-LINE             TO PRT-LINE.
117600     WRITE PRT-REC AFTER ADVANCING 1 LINES.
117700     MOVE SPACES                 TO PRINT-LINE.
117800
117900     ADD TOTAL-BAT-WS TO RPTOT-BAT-WS.
118000     ADD TOTAL-PAT-WS TO RPTOT-PAT-WS.
118100     ADD TOTAL-OCT-WS TO RPTOT-OCT-WS.
118200     MOVE ZEROES TO TOTAL-BAT-WS, TOTAL-PAT-WS, TOTAL-OCT-WS.
118300     ADD 3                       TO LINE-CTR.
118400 389-EXIT.  EXIT.
118500
118600*************************************************************
118700*      PRINT FINAL REPORT TOTALS FOR ALL GROUPS             *
118800*************************************************************
118900 390-REPORT-TOTALS.
119000     MOVE SPACES                 TO PRINT-LINE.
119200     MOVE "REPORT TOTAL  "       TO RPTOT-RPTOT.
119300     MOVE RPTOT-BAT-WS           TO RPTOT-BAT.
119400     MOVE RPTOT-PAT-WS           TO RPTOT-PAT.
119500     MOVE RPTOT-OCT-WS           TO RPTOT-OCT.
119600     MOVE " **"                  TO RPTOT-END.
119700     MOVE PRINT-LINE             TO PRT-LINE.
119800     WRITE PRT-REC AFTER ADVANCING 2 LINES.
119900     MOVE SPACES                 TO PRINT-LINE.
120000 399-EXIT.  EXIT.
       800-READ-MSTORERM.
           MOVE 0 TO COND-WORD.
           MOVE CORPCODE-ARG TO CORPCDE OF MSTORERM-REC-I.
           READ MSTORERM-I INTO BUF-MSTORERM
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS-1 = "2"
               MOVE 17 TO COND-WORD
           ELSE
