       IDENTIFICATION DIVISION.
       PROGRAM-ID.             SPMCHGLVL.
       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.
       SOURCE-COMPUTER.        IBM-AS400.
       OBJECT-COMPUTER.        IBM-AS400.

       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT DISPLAY-FILE
                  ASSIGN       TO WORKSTATION-ZPMMAINT-SI
                  ORGANIZATION IS TRANSACTION
                  ACCESS MODE  IS DYNAMIC
                  RELATIVE KEY IS RECNO
                  FILE STATUS  IS SCREEN-STATUS
                               MAJOR-MINOR
                  CONTROL-AREA IS SCREEN-CONTROL.

           SELECT JOBPLAN-I
                  ASSIGN       TO DATABASE-MCFLMM4104
                  ORGANIZATION IS INDEXED
                  ACCESS MODE  IS DYNAMIC
                  RECORD KEY   IS EXTERNALLY-DESCRIBED-KEY
                               WITH DUPLICATES
                  FILE STATUS  IS FILE-STAT.

           SELECT JOBPLAN-O
                  ASSIGN       TO DATABASE-MCFLMM4102
                  ORGANIZATION IS INDEXED
                  ACCESS MODE  IS DYNAMIC
                  RECORD KEY   IS EXTERNALLY-DESCRIBED-KEY
                               WITH DUPLICATES
                  FILE STATUS  IS FILE-STAT.

           SELECT WO-CRAFTS-REQD
                  ASSIGN       TO DATABASE-MCFLMM0601
                  ORGANIZATION IS INDEXED
                  ACCESS MODE  IS DYNAMIC
                  RECORD KEY   IS EXTERNALLY-DESCRIBED-KEY
                  FILE STATUS  IS FILE-STAT.

       DATA DIVISION.
       FILE SECTION.
       FD  DISPLAY-FILE
           LABEL RECORDS       ARE OMITTED.
       01  DISPLAY-REC         PIC X(2000).

       FD  JOBPLAN-I
           LABEL RECORDS       ARE STANDARD.
       01  JOBPLAN-I-REC.
           COPY DDS-ALL-FORMATS OF MCFLMM4104.

       FD  JOBPLAN-O
           LABEL RECORDS       ARE STANDARD.
       01  JOBPLAN-O-REC.
           COPY DDS-ALL-FORMATS OF MCFLMM4102.

       FD  WO-CRAFTS-REQD
           LABEL RECORDS       ARE STANDARD.
       01  WO-CRAFTS-REQD-REC.
           COPY DDS-ALL-FORMATS OF MCFLMM0601.

       WORKING-STORAGE SECTION.
       77  FIND-SW             PIC X         VALUE " ".
       77  MOD-SW              PIC X         VALUE " ".
       77  SAVE-TASK           PIC X(04)     VALUE "    ".
       77  CTR                 PIC 9999      VALUE 0.
       77  RECNO               PIC 9999      VALUE 0.
       77  RECNO-SAV           PIC 9999      VALUE 0.
       77  TRUE-VAL            PIC 1         VALUE B"1".
       77  NEG-VAL             PIC 1         VALUE B"0".

       01  FILE-STAT.
           05  FILE-STAT-1     PIC  X.
           05  FILE-STAT-2     PIC  X.

       01  PMCHG-BUFF.
           05  PMCHG-JPN       PIC  X(10).
           05  PMCHG-LEV       PIC  X(02).
           05  CMDMSG-00       PIC  X(79).
           05  ERRMSG-00       PIC  X(79).

       01  PMJPT-BUFF.
           05  PMJPT-JPN       PIC  X(10).
           05  PMJPT-LEV       PIC  X(02).
           05  CMDMSG-01       PIC  X(79).
           05  ERRMSG-01       PIC  X(79).

       01  PMJPT-BUFF-SUB.
           05  PMJPT-SEL       PIC  X(01).
           05  PMJPT-TASK      PIC  X(04).

       01  TSKCHG-BUFF.
           05  TSKCHG-JPN          PIC  X(10).
           05  TSKCHG-LEV          PIC  X(02).
           05  TSK-DATA.
               10  JP-KEY-SEQ-DISP.
                   15  JP-KEY-DISP PIC X(10).
                   15  JP-SEQ-DISP PIC X(04).
               10  JP-LEVEL-BUF    PIC X(02).
               10  JP-EXFLAG-BUF   PIC X(02).
               10  SUBSYS-BUF      PIC X(04).
               10  CRAFT-BUF.
                   15  CRAFT-1-BUF PIC XX.
                   15  CRAFT-2-BUF PIC XX.
                   15  CRAFT-3-BUF PIC XX.
               10  MEN-BUF         PIC X(02).
               10  EST-HRS-BUF.
                   15  EHRS        PIC 999.
                   15  EHRS-DEC    PIC 9.
               10  EST-HRS-DEC     REDEFINES EST-HRS-BUF
                                   PIC 999V9.
               10  DT-HRS-BUF.
                   15  DTHRS       PIC 999.
                   15  DTHRS-D     PIC 9.
               10  DT-HRS-DEC      REDEFINES DT-HRS-BUF
                                   PIC 999V9.
           05  CMDMSG-02           PIC  X(79).
           05  ERRMSG-02           PIC  X(79).

       01  JOBP-TASK-KEY.
           05  JOBP-NAME       PIC X(10).
           05  JOBP-TASK       PIC X(04).

       01  ADJ-2.
           05  F1              PIC X.
           05  F2              PIC X.

       01  ADJ-3.
           05  F3              PIC X.
           05  F4              PIC X.
           05  F5              PIC X.

       01  ADJ-4.
           05  F6              PIC X.
           05  F7              PIC X.
           05  F8              PIC X.
           05  F9              PIC X.

           COPY SCREENIO       IN COPYLIB.

           COPY CATREAD        IN COPYLIB.

           COPY LANGSUB        IN COPYLIB.

       01  MESSAGE-FILE-DATA.
           COPY ERRORLIN       IN COPYLIB.

       01  PM-JOBPLAN-DATA.
           COPY DPMJBPLN       IN COPYLIB.

       LINKAGE SECTION.
       01  JOBPLAN-NAME-LINK   PIC X(10).

       PROCEDURE DIVISION      USING
                               JOBPLAN-NAME-LINK.
       000-INIT.
           OPEN I-O            DISPLAY-FILE
                               JOBPLAN-O.
           OPEN INPUT          WO-CRAFTS-REQD
                               JOBPLAN-I.

       010-VGETNEXTFORM-PMCHG.
           MOVE SPACES         TO PMCHG-BUFF FIND-SW SAVE-TASK.
           MOVE JOBPLAN-NAME-LINK TO PMCHG-JPN.
           MOVE "PMCHGLVL"     TO SCREEN-NAME.

       020-VSHOWFORM-PMCHG.
           MOVE "00"           TO SCREEN-STATUS.
           MOVE PMCHG-BUFF     TO DISPLAY-REC.

           WRITE DISPLAY-REC   FORMAT IS SCREEN-NAME
                               INDIC ARE SCREEN-INDICATORS.
           IF SCREEN-STATUS NOT = "00"
               DISPLAY "SCREEN WRITE ERROR.  SCREEN-STATUS IS "
                               SCREEN-STATUS
               GO TO 999-END-PROG.

           READ  DISPLAY-FILE  FORMAT IS SCREEN-NAME
                               INDIC ARE SCREEN-INDICATORS.
           IF SCREEN-STATUS NOT = "00"
               DISPLAY "SCREEN READ ERROR.  SCREEN-STATUS IS "
                               SCREEN-STATUS
               GO TO 999-END-PROG.

           MOVE DISPLAY-REC    TO PMCHG-BUFF.
           MOVE ALL B"0"       TO SCREEN-INDICATORS.

           IF KEY-HIT = 3 OR 8
               GO TO 999-END-PROG.

           IF PMCHG-LEV = SPACES
      *M********************************************************************
      *M    MESSAGE 038/013:
      *M LEVEL NUMBER IS REQUIRED
      *M********************************************************************
               MOVE  38        TO LANG-SETNUM
               MOVE  13        TO LANG-MSGNUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE CATREAD-MSG-TEXT TO ERRMSG-00
               MOVE   1        TO FIELD-NUMBER
               MOVE TRUE-VAL   TO IND(FIELD-NUMBER) IND(99)
               GO TO 020-VSHOWFORM-PMCHG.

           MOVE PMCHG-LEV      TO ADJ-2.
           PERFORM             ADJUST-2.
           MOVE ADJ-2          TO PMCHG-LEV.

           IF PMCHG-LEV NOT NUMERIC
      *M********************************************************************
      *M    MESSAGE 038/014:
      *M LEVEL NUMBER MUST BE NUMERIC
      *M********************************************************************
               MOVE  38        TO LANG-SETNUM
               MOVE  14        TO LANG-MSGNUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE CATREAD-MSG-TEXT TO ERRMSG-00
               MOVE   1        TO FIELD-NUMBER
               MOVE TRUE-VAL   TO IND(FIELD-NUMBER) IND(99)
               GO TO 020-VSHOWFORM-PMCHG.

       080-DISPLAY-PMCHG.
           MOVE SPACE          TO MOD-SW.
           MOVE JOBPLAN-NAME-LINK TO PMJOBPKEY OF JOBPLAN-I
                                  PMJPT-JPN.
           MOVE PMCHG-LEV      TO JOBPLEVEL OF JOBPLAN-I
                                  PMJPT-LEV.
           START JOBPLAN-I
               KEY NOT LESS THAN PMJOBPKEY OF JOBPLAN-I
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
               MOVE SPACES     TO MESSAGE-BUFFER
               MOVE "START ERROR, JOBPLAN-I                FILE-STAT ="
                               TO MSG-TEXT
               MOVE FILE-STAT  TO MSG-FLD
               MOVE MESSAGE-BUFFER TO ERRMSG-00
               MOVE  1         TO FIELD-NUMBER
               MOVE TRUE-VAL   TO IND(FIELD-NUMBER) IND(99)
               GO TO 020-VSHOWFORM-PMCHG.

           MOVE 0              TO RECNO.
           MOVE NEG-VAL        TO IND(75).
           MOVE TRUE-VAL       TO IND(77) IND(76).
           MOVE SPACES         TO PMJPT-BUFF-SUB
                                  DISPLAY-REC.
           WRITE DISPLAY-REC   FORMAT "CHGL"
                               INDIC ARE SCREEN-INDICATORS.
           IF SCREEN-STATUS NOT = "00"
               DISPLAY
               "SUBFILE CLEAR WRITE ERROR.  SCREEN-STATUS IS "
                               SCREEN-STATUS.
           MOVE NEG-VAL        TO IND(77).

       DBGET-LOOP.
           READ JOBPLAN-I
               NEXT            INTO PM-JOBPLAN-DATA
               AT END          MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT = "10" OR "14" OR "46"
               GO TO SUBF-CONT
           ELSE
           IF FILE-STAT NOT = "00"
               MOVE SPACES     TO MESSAGE-BUFFER
               MOVE "READ ERROR, JOBPLAN-I                 FILE-STAT ="
                               TO MSG-TEXT
               MOVE FILE-STAT  TO MSG-FLD
               MOVE MESSAGE-BUFFER TO ERRMSG-00
               MOVE  1         TO FIELD-NUMBER
               MOVE TRUE-VAL   TO IND(FIELD-NUMBER) IND(99)
               GO TO 020-VSHOWFORM-PMCHG.

           IF JOBPLAN-KEY NOT = JOBPLAN-NAME-LINK
               GO TO SUBF-CONT.

           IF PMJP-LEVEL > PMCHG-LEV
               GO TO SUBF-CONT.

           IF PMJP-LEVEL NOT = PMCHG-LEV
               GO TO DBGET-LOOP.

           IF PMJP-SEQ NOT = SAVE-TASK
               MOVE PMJP-SEQ   TO SAVE-TASK
           ELSE
               GO TO DBGET-LOOP.

           MOVE SPACES         TO PMJPT-BUFF-SUB.
           MOVE PMJP-SEQ       TO PMJPT-TASK.

           ADD 1               TO RECNO.
           MOVE PMJPT-BUFF-SUB TO DISPLAY-REC.
           MOVE "00" TO SCREEN-STATUS.
           WRITE SUBFILE       DISPLAY-REC FORMAT "CHGLDISP"
                               INDIC ARE SCREEN-INDICATORS
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF SCREEN-STATUS NOT = "00"
               DISPLAY   "SUBFILE 1 WRITE ERROR.  SCREEN STATUS IS "
                               SCREEN-STATUS
               GO TO 999-END-PROG.

           GO TO DBGET-LOOP.

       SUBF-CONT.
           IF RECNO EQUAL 0
               GO TO 010-VGETNEXTFORM-PMCHG.

           WRITE DISPLAY-REC   FORMAT "CHGLSEL"
                               INDIC ARE SCREEN-INDICATORS.
           MOVE TRUE-VAL       TO IND(76).
           IF RECNO GREATER THAN 0
               MOVE TRUE-VAL   TO IND(75)
           ELSE
               MOVE NEG-VAL    TO IND(75).
           MOVE RECNO          TO RECNO-SAV.
           MOVE PMJPT-BUFF     TO DISPLAY-REC.
           WRITE DISPLAY-REC   FORMAT "CHGL"
                               INDIC ARE SCREEN-INDICATORS.
           READ DISPLAY-FILE   FORMAT "CHGL"
                               INDIC ARE SCREEN-INDICATORS.

           IF KEY-HIT = 3 OR 8
               GO TO 999-END-PROG.

           IF KEY-HIT = 5
             PERFORM VARYING CTR FROM 1 BY 1 UNTIL CTR > RECNO-SAV
               MOVE CTR        TO RECNO
               MOVE SPACES     TO PMJPT-BUFF-SUB
               READ SUBFILE    DISPLAY-FILE
                               INTO PMJPT-BUFF-SUB
                               FORMAT "CHGLDISP"
                               INDIC ARE SCREEN-INDICATORS
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT
               END-READ
               IF PMJPT-BUFF-SUB NOT = SPACES
                   IF MOD-SW = SPACE
                       PERFORM     090-MODIFY-SCRN THRU 090-MS-EXIT
                       MOVE "X"    TO MOD-SW
                   END-IF
                   PERFORM 100-MODIFY-TASKS THRU 100-MT-EXIT
               END-IF
             END-PERFORM
             MOVE RECNO-SAV      TO RECNO
           ELSE
             PERFORM UNTIL SPACES = PMJPT-BUFF-SUB
               MOVE SPACES     TO PMJPT-BUFF-SUB
               READ SUBFILE    DISPLAY-FILE
                               NEXT MODIFIED INTO PMJPT-BUFF-SUB
                               FORMAT "CHGLDISP"
                               INDIC ARE SCREEN-INDICATORS
               END-READ
               IF PMJPT-BUFF-SUB NOT = SPACES
                   IF MOD-SW = SPACE
                       PERFORM     090-MODIFY-SCRN THRU 090-MS-EXIT
                       MOVE "X"    TO MOD-SW
                   END-IF
                   PERFORM 100-MODIFY-TASKS THRU 100-MT-EXIT
               END-IF
             END-PERFORM.

           GO TO 010-VGETNEXTFORM-PMCHG.

       090-MODIFY-SCRN.
           MOVE SPACES         TO TSKCHG-BUFF.
           MOVE "MODTASK"      TO SCREEN-NAME.
           MOVE PMCHG-JPN      TO TSKCHG-JPN
                                  JP-KEY-DISP.
           MOVE PMCHG-LEV      TO TSKCHG-LEV
                                  JP-LEVEL-BUF.
           MOVE PMJPT-TASK     TO JP-SEQ-DISP.

       090-SHOWFORM.
           MOVE TSKCHG-BUFF    TO DISPLAY-REC.
           WRITE DISPLAY-REC   FORMAT IS SCREEN-NAME
                               INDIC ARE SCREEN-INDICATORS.
           IF SCREEN-STATUS NOT = "00"
               DISPLAY "SCREEN WRITE ERROR.  SCREEN-STATUS IS "
                               SCREEN-STATUS
               GO TO 999-END-PROG.

           READ  DISPLAY-FILE  FORMAT IS SCREEN-NAME
                               INDIC ARE SCREEN-INDICATORS.
           IF SCREEN-STATUS NOT = "00"
               DISPLAY "SCREEN READ ERROR.  SCREEN-STATUS IS "
                               SCREEN-STATUS
               GO TO 999-END-PROG.

           MOVE ALL B"0"       TO SCREEN-INDICATORS.
           MOVE DISPLAY-REC    TO TSKCHG-BUFF.

           IF KEY-HIT = 3 OR 8
               GO TO 999-END-PROG.

           IF JP-LEVEL-BUF = SPACES
      *M********************************************************************
      *M    MESSAGE 038/013:
      *M LEVEL NUMBER IS REQUIRED
      *M********************************************************************
               MOVE  38        TO LANG-SETNUM
               MOVE  13        TO LANG-MSGNUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE CATREAD-MSG-TEXT TO ERRMSG-02
               MOVE 4          TO FIELD-NUMBER
               MOVE TRUE-VAL   TO IND(FIELD-NUMBER) IND(99)
               GO TO 090-SHOWFORM.

           MOVE JP-LEVEL-BUF   TO ADJ-2.
           PERFORM ADJUST-2.
           MOVE ADJ-2          TO JP-LEVEL-BUF.

           IF JP-LEVEL-BUF NOT NUMERIC
      *M********************************************************************
      *M    MESSAGE 038/014:
      *M LEVEL NUMBER MUST BE NUMERIC
      *M********************************************************************
               MOVE  38        TO LANG-SETNUM
               MOVE  14        TO LANG-MSGNUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE CATREAD-MSG-TEXT TO ERRMSG-02
               MOVE 4          TO FIELD-NUMBER
               MOVE TRUE-VAL   TO IND(FIELD-NUMBER) IND(99)
               GO TO 090-SHOWFORM.

           MOVE JP-EXFLAG-BUF  TO ADJ-2.
           PERFORM ADJUST-2.
           MOVE ADJ-2          TO JP-EXFLAG-BUF.

           IF JP-EXFLAG-BUF = "00"
               MOVE "99"       TO JP-EXFLAG-BUF.

           IF JP-EXFLAG-BUF NOT NUMERIC
      *M********************************************************************
      *M    MESSAGE 031/063:
      *M EXCEPTION FLAG MUST BE NUMERIC
      *M********************************************************************
               MOVE  31        TO LANG-SETNUM
               MOVE  63        TO LANG-MSGNUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE CATREAD-MSG-TEXT TO ERRMSG-02
               MOVE 5          TO FIELD-NUMBER
               MOVE TRUE-VAL   TO IND(FIELD-NUMBER) IND(99)
               GO TO 090-SHOWFORM.

           MOVE SUBSYS-BUF     TO ADJ-4.
           PERFORM ADJUST-4.
           MOVE ADJ-4          TO SUBSYS-BUF.

           IF SUBSYS-BUF NOT NUMERIC
      *M********************************************************************
      *M    MESSAGE 045/044:
      *M SUBSYSTEM MUST BE 4 DIGITS NUMERIC
      *M********************************************************************
               MOVE  45        TO LANG-SETNUM
               MOVE  44        TO LANG-MSGNUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE CATREAD-MSG-TEXT TO ERRMSG-02
               MOVE 6          TO FIELD-NUMBER
               MOVE TRUE-VAL   TO IND(FIELD-NUMBER) IND(99)
               GO TO 090-SHOWFORM.

           IF SUBSYS-BUF = "0000" MOVE "    " TO SUBSYS-BUF.

           IF CRAFT-1-BUF = SPACES
               MOVE CRAFT-2-BUF TO CRAFT-1-BUF
               MOVE CRAFT-3-BUF TO CRAFT-2-BUF
               MOVE SPACES      TO CRAFT-3-BUF.

           IF CRAFT-1-BUF = SPACES
               MOVE CRAFT-2-BUF TO CRAFT-1-BUF
               MOVE CRAFT-3-BUF TO CRAFT-2-BUF
               MOVE SPACES      TO CRAFT-3-BUF.

           IF CRAFT-2-BUF = SPACES
               MOVE CRAFT-3-BUF TO CRAFT-2-BUF
               MOVE SPACES      TO CRAFT-3-BUF.

           IF CRAFT-1-BUF = SPACES
               NEXT SENTENCE
           ELSE
           MOVE CRAFT-1-BUF    TO CRAFTREQD OF WO-CRAFTS-REQD
           START WO-CRAFTS-REQD KEY = CRAFTREQD OF WO-CRAFTS-REQD
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT
           END-START
           IF FILE-STAT NOT = "00"
      *M********************************************************************
      *M    MESSAGE 035/037:
      *M INVALID CRAFT
      *M********************************************************************
               MOVE  35        TO LANG-SETNUM
               MOVE  37        TO LANG-MSGNUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE CATREAD-MSG-TEXT TO ERRMSG-02
               MOVE 7          TO FIELD-NUMBER
               MOVE TRUE-VAL   TO IND(FIELD-NUMBER) IND(99)
               GO TO 090-SHOWFORM.

           IF CRAFT-2-BUF = SPACES
               NEXT SENTENCE
           ELSE
           MOVE CRAFT-2-BUF    TO CRAFTREQD OF WO-CRAFTS-REQD
           START WO-CRAFTS-REQD KEY = CRAFTREQD OF WO-CRAFTS-REQD
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT
           END-START
           IF FILE-STAT NOT = "00"
      *M********************************************************************
      *M    MESSAGE 035/037:
      *M INVALID CRAFT
      *M********************************************************************
               MOVE  35        TO LANG-SETNUM
               MOVE  37        TO LANG-MSGNUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE CATREAD-MSG-TEXT TO ERRMSG-02
               MOVE 88         TO FIELD-NUMBER
               MOVE TRUE-VAL   TO IND(FIELD-NUMBER) IND(99)
               GO TO 090-SHOWFORM.

           IF CRAFT-3-BUF = SPACES
               NEXT SENTENCE
           ELSE
           MOVE CRAFT-3-BUF    TO CRAFTREQD OF WO-CRAFTS-REQD
           START WO-CRAFTS-REQD KEY = CRAFTREQD OF WO-CRAFTS-REQD
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT
           END-START
           IF FILE-STAT NOT = "00"
      *M********************************************************************
      *M    MESSAGE 035/037:
      *M INVALID CRAFT
      *M********************************************************************
               MOVE  35        TO LANG-SETNUM
               MOVE  37        TO LANG-MSGNUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE CATREAD-MSG-TEXT TO ERRMSG-02
               MOVE 89         TO FIELD-NUMBER
               MOVE TRUE-VAL   TO IND(FIELD-NUMBER) IND(99)
               GO TO 090-SHOWFORM.

           IF CRAFT-1-BUF = CRAFT-2-BUF
               MOVE CRAFT-3-BUF TO CRAFT-2-BUF
               MOVE SPACES      TO CRAFT-3-BUF.

           IF CRAFT-1-BUF = CRAFT-2-BUF
               MOVE CRAFT-3-BUF TO CRAFT-2-BUF
               MOVE SPACES      TO CRAFT-3-BUF.

           IF CRAFT-2-BUF = CRAFT-3-BUF
               MOVE SPACES     TO CRAFT-3-BUF.

           MOVE MEN-BUF        TO ADJ-2.
           PERFORM ADJUST-2.
           MOVE ADJ-2          TO MEN-BUF.

           IF MEN-BUF NOT NUMERIC
      *M********************************************************************
      *M    MESSAGE 032/017:
      *M FIELD MUST BE SPACES OR NUMERIC
      *M********************************************************************
               MOVE  32        TO LANG-SETNUM
               MOVE  17        TO LANG-MSGNUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE CATREAD-MSG-TEXT TO ERRMSG-02
               MOVE 8          TO FIELD-NUMBER
               MOVE TRUE-VAL   TO IND(FIELD-NUMBER) IND(99)
               GO TO 090-SHOWFORM.

           IF MEN-BUF = "00"
               MOVE "  "       TO MEN-BUF.

           MOVE EHRS           TO ADJ-3.
           PERFORM ADJUST-3.
           MOVE ADJ-3          TO EHRS.

           IF EHRS NOT NUMERIC
      *M********************************************************************
      *M    MESSAGE 032/017:
      *M FIELD MUST BE SPACES OR NUMERIC
      *M********************************************************************
               MOVE  32        TO LANG-SETNUM
               MOVE  17        TO LANG-MSGNUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE CATREAD-MSG-TEXT TO ERRMSG-02
               MOVE 9          TO FIELD-NUMBER
               MOVE TRUE-VAL   TO IND(FIELD-NUMBER) IND(99)
               GO TO 090-SHOWFORM.

           IF EHRS-DEC NOT NUMERIC
               MOVE 0          TO EHRS-DEC.

           MOVE DTHRS          TO ADJ-3.
           PERFORM ADJUST-3.
           MOVE ADJ-3          TO DTHRS.

           IF DTHRS NOT NUMERIC
      *M********************************************************************
      *M    MESSAGE 032/017:
      *M FIELD MUST BE SPACES OR NUMERIC
      *M********************************************************************
               MOVE  32        TO LANG-SETNUM
               MOVE  17        TO LANG-MSGNUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE CATREAD-MSG-TEXT TO ERRMSG-02
               MOVE 11         TO FIELD-NUMBER
               MOVE TRUE-VAL   TO IND(FIELD-NUMBER) IND(99)
               GO TO 090-SHOWFORM.

           IF DTHRS-D NOT NUMERIC
               MOVE 0          TO DTHRS-D.

       090-MS-EXIT.            EXIT.

       100-MODIFY-TASKS.
           MOVE LOW-VALUES     TO PM-JOBPLAN-DATA.
           MOVE PMJPT-JPN      TO JOBP-NAME.
           MOVE PMJPT-TASK     TO JOBP-TASK.
           MOVE JOBP-TASK-KEY  TO JOBPWOSEQ OF JOBPLAN-O.
           START JOBPLAN-O
               KEY NOT LESS    THAN JOBPWOSEQ OF JOBPLAN-O
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
               GO TO 100-MT-EXIT.

       100-WRITE-LOOP.
           READ JOBPLAN-O
               NEXT            INTO PM-JOBPLAN-DATA
               AT END          MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
               GO TO 100-MT-EXIT.

           IF JOBPLAN-KEY NOT = JOBPLAN-NAME-LINK
               GO TO 100-MT-EXIT.

           IF PMJP-SEQN NOT = PMJPT-TASK
               GO TO 100-MT-EXIT.

           MOVE JP-LEVEL-BUF   TO PMJP-LEVEL.
           MOVE JP-EXFLAG-BUF  TO PMJP-FLAG.
           MOVE SUBSYS-BUF     TO PMJP-SS.
           MOVE CRAFT-BUF      TO PMJP-CRAFT.
           MOVE MEN-BUF        TO PMJP-MNX.
           MOVE EST-HRS-BUF    TO PMJP-EST.
           MOVE DT-HRS-BUF     TO PMJP-DT.

           REWRITE JOBPLAN-O-REC FROM PM-JOBPLAN-DATA
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
               GO TO 100-MT-EXIT.

           GO TO 100-WRITE-LOOP.

       100-MT-EXIT.            EXIT.

       ADJUST-2.
           PERFORM ELIMINATE1  UNTIL F2 NOT = SPACE.
           IF F1 = SPACE MOVE "0" TO F1.

       ADJUST-3.
           PERFORM ELIMINATE2  UNTIL F5 NOT = SPACE.
           IF F3 = SPACE MOVE "0" TO F3.
           IF F4 = SPACE MOVE "0" TO F4.

       ADJUST-4.
           PERFORM ELIMINATE3  UNTIL F9 NOT = SPACE.
           IF F6 = SPACE MOVE "0" TO F6.
           IF F7 = SPACE MOVE "0" TO F7.
           IF F8 = SPACE MOVE "0" TO F8.

       ELIMINATE1.
           MOVE F1             TO F2.
           MOVE "0"            TO F1.

       ELIMINATE2.
           MOVE F4             TO F5.
           MOVE F3             TO F4.
           MOVE "0"            TO F3.

       ELIMINATE3.
           MOVE F8             TO F9.
           MOVE F7             TO F8.
           MOVE F6             TO F7.
           MOVE "0"            TO F6.

       999-END-PROG.
           CLOSE               DISPLAY-FILE.
           CLOSE               JOBPLAN-I.
           CLOSE               JOBPLAN-O.
           CLOSE               WO-CRAFTS-REQD.
           GOBACK.

       999-CATREAD.
           MOVE SPACES         TO CATREAD-MSG-TEXT.
           MOVE LANG-SETNUM    TO CATREAD-MSG-SET.
           MOVE LANG-MSGNUM    TO CATREAD-MSG-NUM.
           CALL "CCATREAD"     USING CATREAD-PARMS.
           IF CATREAD-MSG-NOT-FOUND
               MOVE "** CATALOG READ ERROR ON THIS FIELD **"
                               TO CATREAD-MSG-TEXT.

       999-CATREAD-EXIT.       EXIT.

