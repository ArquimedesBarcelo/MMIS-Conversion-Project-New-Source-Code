020800 LINKAGE SECTION.
020900
021000 01  BASE                      PIC X(10).
021100 01  MMIS-BASE                 PIC X(13).
021200
021300 COPY DBSTAT     IN COPYLIB.
021400 COPY VCOMLINK   IN COPYLIB.
021500 COPY STCOM      IN COPYLIB.
021600 COPY TSHWSUB    IN COPYLIB.
021700 COPY LANGSUB    IN COPYLIB.
021800 COPY MULTSTR    IN COPYLIB.
021900 COPY ESCNAME   IN COPYLIB.
022000
022100 PROCEDURE DIVISION USING BASE MMIS-BASE STATUS-AREA
022200                          VIEW-COMAREA STORES-COMAREA
022300                          SRF-COMAREA, SRF-SPOOLER-REC,
022400                          LANGUAGE-PARMS, MULTIPLE-STR-DATA,
022500                          ESC-NAME.
022600
022700 1-HOUSEKEEPING.
022800
           OPEN I-O DISPLAY-FILE.
           OPEN INPUT DWLITEM.
022900     PERFORM 6000-MAIN THRU 6990-MAIN-X.
           CLOSE DWLITEM.
           CLOSE DISPLAY-FILE.
023000     GOBACK.
023100
023200 2100-BLOWUP.
023300     MOVE "SRWREPRT" TO BU-PGM-NAME.
023400     MOVE WS-WORKSHEET-KEY         TO   BU-DISPLAY-FLD (4).
023500     MOVE CODE-ARG                 TO   BU-DISPLAY-FLD (3).
023600     CALL "TBLOWUP" USING BASE BU-PGM-NAME STATUS-AREA
023700       VIEW-COMAREA DUMMY-KSAM-STAT BU-DISPLAY-MSG
023800       BU-DISPLAY-FLDS.
023900
024000**********************
024100*                    *
024200*       M A I N      *
024300*                    *
024400**********************
024500
024600 6000-MAIN.
024700
024800 61-GET-FORM.
024900     MOVE 0                        TO   SUB.
025000     MOVE SPACES                   TO   WORK-LIST-TABLE.
025100
025200     MOVE RWREPRT    TO  VIEW-NFNAME.
025300*    CALL "VGETNEXTFORM" USING  VIEW-COMAREA.
025400*    IF VIEW-STATUS NOT = ZERO
025500*        MOVE "VGETNEXTFORM ERROR RSREPRT"  TO  BU-DISPLAY-MSG
025600*        PERFORM 2100-BLOWUP.
025700*
025800 611-INIT-FORM.
025900*    CALL "VINITFORM" USING  VIEW-COMAREA.
026000*    IF VIEW-STATUS NOT = ZERO
026100*        MOVE "VINITFORM ERROR RSREPRT"  TO  BU-DISPLAY-MSG
026200*        PERFORM 2100-BLOWUP.
026300*
026400 612-PUT-WINDOW.
026500     MOVE SPACE      TO  MESSAGE-BUFFER.
026600*    CALL "VPUTWINDOW" USING  VIEW-COMAREA, MESSAGE-BUFFER,
026700*                             MESSAGE-ACTLEN.
026800*    IF VIEW-STATUS NOT = ZERO
026900*        MOVE "VPUTWINDOW ERROR RSREPRT"  TO  BU-DISPLAY-MSG
027000*        PERFORM 2100-BLOWUP.
027100*
027200 62-SHOW-FORM.
027300*----- f1 f2 f3 f6 INVALID, f4 REFRESH, f5 PRT, f7 CLR, f8 EXIT
           MOVE "0000" TO DE-WORKSHEET-NO.
027400*    MOVE 7                        TO   SRF-KEYSET.
           MOVE DE-FIELDS TO SCREEN-BUFFER.
027500*    CALL "TSHWRDFM" USING SRF-COMAREA, BU-DISPLAY-MSG,
027600*      VIEW-COMAREA, BASE, STATUS-AREA, SRF-SPOOLER-REC,
027700*      LANGUAGE-PARMS, SCREEN-BUFFER.
           MOVE SCREEN-BUFFER TO DISPLAY-REC.
           WRITE DISPLAY-REC FORMAT IS VIEW-NFNAME
              INDIC ARE SRF-INDICATORS.
           MOVE ALL B"0" TO SRF-INDICATORS.

           READ  DISPLAY-FILE FORMAT IS VIEW-NFNAME
               INDIC ARE SRF-INDICATORS.
           ACCEPT IOFEEDBACK FROM I-O-FEEDBACK-AREA.
           MOVE ALL B"0" TO SRF-INDICATORS.
           MOVE DISPLAY-REC TO SCREEN-BUFFER.

      *------ A BAD STATUS MAY MEAN USER TURNED OFF TERMINAL.
      *------ IF SO, SIMULATE THE F3 KEY TO EXIT PROGRAM.
           IF DISPLAY-STATUS NOT = "00"
               MOVE 3 TO VIEW-LASTKEY
           ELSE
               MOVE FUNCTION-NUM TO VIEW-LASTKEY.
035800
           MOVE SCREEN-BUFFER TO DE-FIELDS.
027800     IF BU-DISPLAY-MSG-1 NOT = SPACES
027900         PERFORM 2100-BLOWUP.
028000
028100     IF VIEW-LASTKEY = 3
028200         GO TO 6990-MAIN-X.
028300
028400 623-GET-BUFFER.
028500*    CALL "VGETBUFFER" USING  VIEW-COMAREA, DE-FIELDS,
028600*                             VIEW-DBUFLEN.
028700*    IF VIEW-STATUS NOT = ZERO
028800*        MOVE "VGETBUFFER ERROR RSREPRT"  TO  BU-DISPLAY-MSG
028900*        MOVE VIEW-NFNAME                 TO  BU-DISPLAY-AREA
029000*        PERFORM 2100-BLOWUP.
029100*
           MOVE DE-WORKSHEET-NO TO RS-SHIFT-FLD.
           CALL "TRSHIFT" USING RS-RET-CODE, RS-SHIFT-FLD.
           MOVE RS-SHIFT-FLD-5-8 TO DE-WORKSHEET-NO.

029200     IF DE-RETURN-FLAG = "X"
029300         MOVE "ST"  TO  WS-WORKSHEET-LIT
029400     ELSE
029600         MOVE "SW"  TO  WS-WORKSHEET-LIT.
029700
029800*******************************************************
029900*                                                     *
030000*                  FIND  DWLITEM                      *
030100*                                                     *
030200*******************************************************
030300
030400     MOVE DE-WORKSHEET-NO  TO  WS-WORKSHEET-NO.
030500     MOVE WS-WORKSHEET-KEY TO  WL-ARG.
030600
030700*    CALL "DBFIND" USING BASE, DSET-DWLITEM, MODE1, STATUS-AREA,
030800*            WL-SEARCH, WL-ARG.
           MOVE 0 TO COND-WORD.
           MOVE WL-ARG TO WLKEY OF DWLITEM-REC.
           START DWLITEM KEY = EXTERNALLY-DESCRIBED-KEY
               INVALID KEY MOVE 17 TO COND-WORD.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
                   MOVE 17 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.
030900     IF COND-WORD NOT = 0
031000*        "W16: WORKSHEET NUMBER DOES NOT EXIST"
031100         MOVE  23 TO LANG-SETNUM
031200         MOVE  16 TO LANG-MSGNUM
031300         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
031400         MOVE MESSAGE-BUFFER TO MSG-TEXT
031500         MOVE WL-ARG                    TO MSG-FLD
031600         PERFORM  9-USER-ERROR  THRU  9-USER-ERROR-X
031700         GO TO  62-SHOW-FORM.
031800
031900***********************************************************
032000*
032100*     DISPLAY A 'NOW PROCESSING' MESSAGE ON THE SCREEN
032200*
032300***********************************************************
032400
032500 8-PUT-IN-PROCESS-MSG-UP.
032600         MOVE  14 TO LANG-SETNUM
032700         MOVE   2 TO LANG-MSGNUM
032800         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
032900         PERFORM 9-VIEW-PUTWINDOW THRU 9-SHOW-FORM-X.
033000
033100     MOVE 0                        TO   SUB.
033200 61-GET-DWLITEM-LOOP.
033300*    CALL "DBGET" USING BASE, DSET-DWLITEM, MODE5, STATUS-AREA,
033400*            ALL-ITEM-LIST, BUF-DWLITEM, WL-ARG.
           MOVE 0 TO COND-WORD.
           READ DWLITEM NEXT INTO BUF-DWLITEM
               AT END MOVE 15 TO COND-WORD.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   MOVE 15 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.
           IF WLKEY OF DWLITEM-REC NOT = WL-ARG
               MOVE 15 TO COND-WORD.
033500     IF COND-WORD NOT = 0
033600         IF COND-WORD = 15
033700             GO TO 62-CALL-PRINT-SUBPROGRAM
033800         ELSE
033900           MOVE "DBGET DWLITEM  RWREPRT   " TO BU-DISPLAY-MSG
034000           PERFORM 2100-BLOWUP.
034100
034200     ADD 1                         TO   SUB.
034300     MOVE WL-CODE                  TO   WLT-CODE (SUB).
034400     MOVE WL-CHARGE-DEPT           TO   WLT-CHARGE-DEPT (SUB).
034500     MOVE WL-WO                    TO   WLT-WO (SUB).
034600     MOVE WL-WORK-CENTER           TO   WLT-WORK-CENTER (SUB).
           MOVE WL-EMPL                  TO   WLT-EMPL (SUB).
           MOVE WL-UM                    TO   WLT-UM (SUB).
034700     MOVE WL-BINDATA               TO   WLT-BIN-AREA (SUB).
034800     MOVE WL-REQ-DEPT              TO   WLT-REQ-DEPT (SUB).
034900     MOVE WL-EXP-CLASS             TO   WLT-EXP-CLASS (SUB).
035000
035100     GO TO 61-GET-DWLITEM-LOOP.
035200
035300 62-CALL-PRINT-SUBPROGRAM.
035400     IF SRF-SPOOL-NO (5) = "99"
035500         MOVE "H"                  TO   HALF-SHEET-FLAG.
035600     IF WS-WORKSHEET-LIT = "ST"
035700         MOVE "R"                  TO   RETURN-FLAG.
035800     IF AKRON-PLANT
035900         MOVE "Y"                  TO   AKRON-FLAG.
036000     CALL "TWSPRT" USING RET-CODE, BASE, MMIS-BASE, STATUS-AREA,
036100       SRF-SPOOL-PRT-NO, WS-WORKSHEET-KEY, WORK-LIST-TABLE,
036200       WS-PARMS, LANGUAGE-PARMS, ESC-NAME, BU-DISPLAY-MSG,
             MULTIPLE-STR-DATA.
036300     IF BU-DISPLAY-MSG-1 NOT = SPACES
036400         PERFORM 2100-BLOWUP.
036500
036600*---------- LOOP UP FOR NEXT WORKSHEET NUMBER ENTRY.
           MOVE SPACES TO DE-FIELDS.
036700     GO TO 61-GET-FORM.
036800
036900 6990-MAIN-X.
037000     EXIT.
037100
037200
037300 9-VIEW-PUTWINDOW.
037400*    CALL "VPUTWINDOW" USING  VIEW-COMAREA, MESSAGE-BUFFER,
037500*                             MESSAGE-ACTLEN.
037600*    IF VIEW-STATUS NOT = ZERO
037700*        MOVE "VPUTWINDOW ERROR *RSREPRT"  TO  BU-DISPLAY-MSG
037800*        PERFORM 2100-BLOWUP.
037900*
038000 9-VIEW-PUTWINDOW-X.
038100
038200 9-SHOW-FORM.
038300*    CALL "VSHOWFORM" USING  VIEW-COMAREA.
038400*    IF VIEW-STATUS NOT = 0
038500*        MOVE "VSHOWFORM ERROR *RSREPRT"  TO  BU-DISPLAY-MSG
038600*        PERFORM 2100-BLOWUP.
038700*
038800 9-SHOW-FORM-X.
038900
039000 9-USER-ERROR.
039100*    CALL "VSETERROR" USING VIEW-COMAREA, FIELD-NUMBER,
039200*        MESSAGE-BUFFER, MESSAGE-BUFLEN.
039300*    IF VIEW-STATUS NOT = 0
039400*        MOVE "VSETERROR ERR 9-UE" TO BU-DISPLAY-MSG
039500*        PERFORM 2100-BLOWUP.
           MOVE "Y" TO SRF-ERROR-SW.
           MOVE B"1" TO IND (FIELD-NUMBER).
           MOVE MESSAGE-BUFFER TO DE-MESSAGE-LINE.
051300
039600 9-USER-ERROR-X.
039700
039800 999-CATREAD.
           IF CATREAD-MSG-NUMBER = ZEROS
               MOVE LANG-SETNUM TO CATREAD-MSG-SET
               MOVE LANG-MSGNUM TO CATREAD-MSG-NUM.
           CALL "CCATREAD" USING CATREAD-PARMS.
           MOVE CATREAD-MSG-TEXT TO MESSAGE-BUFFER.
040600 999-CATREAD-EXIT.
040700     EXIT.
