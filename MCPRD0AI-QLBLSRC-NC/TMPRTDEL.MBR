000200 IDENTIFICATION DIVISION.
000300 PROGRAM-ID.    TMPRTDEL.
000600 ENVIRONMENT DIVISION.
000700 CONFIGURATION SECTION.
000800 SOURCE-COMPUTER.   AS400.
000900 OBJECT-COMPUTER.   AS400.
       SPECIAL-NAMES. I-O-FEEDBACK IS I-O-FEEDBACK-AREA
                      LOCAL-DATA IS LOCAL-DATA-AREA.
001000 INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT MASTER-PRTPLAN-FILE
               ASSIGN TO DATABASE-MCFLMM3701
               ORGANIZATION IS INDEXED
               ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
               FILE STATUS IS MP-STATUS.
           SELECT PRTPLAN-BANK
               ASSIGN TO DATABASE-MCFLMM3801
               ORGANIZATION IS INDEXED
               ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                   WITH DUPLICATES
               FILE STATUS IS PB-STATUS.
001200 DATA DIVISION.
       FILE SECTION.
       FD  MASTER-PRTPLAN-FILE
           LABEL RECORDS ARE STANDARD
           DATA RECORD IS MPREC.
       01  MPREC.
           COPY DDS-ALL-FORMATS OF MCFLMM3701.
       FD  PRTPLAN-BANK
           LABEL RECORDS ARE STANDARD
           DATA RECORD IS PBREC.
       01  PBREC.
           COPY DDS-ALL-FORMATS OF MCFLMM3801.
001400 WORKING-STORAGE SECTION.
       01  BLOWUP-BASE             PIC X(16).
003100 01  K-FUNCTION              PIC X(8).
003500 01  K-STATUS                PIC X(2).
003300 01  K-VALUE                 PIC X(10).
004100 01  MASTER-PRTPLAN-DATA.    COPY MMSTPART OF COPYLIB.
       01  MP-STATUS               PIC XX.
001600 01  PASSWORD-INFORMATION.
001700     05  NAME-OF-PROGRAM     PIC X(08) VALUE "TMPRTDEL".
001800     05  PROGRAM-TYPE        PIC X(02) VALUE "UP".
001900     05  PROGRAM-RELEASE     PIC X(12) VALUE " E0100010001".
002000     05  PROGRAM-DESCRIPTION.
002100         10  PROG-DESC-A     PIC X(60) VALUE
002200             " DELETE GENERIC PART PLANS  "                      .
002300         10  PROG-DESC-B     PIC X(60) VALUE SPACES.
002500         10  PROG-FUNCTION   PIC X(60) VALUE SPACES.
002700     05  PASSWORD-FLAG       PIC X.
       01  PB-STATUS               PIC XX.
003900 01  PRTPLAN-BUFFER.         COPY DPRTBANK OF COPYLIB.
002900 COPY DBSTAT OF COPYLIB.
       COPY TBLOWUP  OF COPYLIB.
004300 01  WORK-ORDER-NO           PIC X(10).
004500 LINKAGE SECTION.
004700 01  DBPARAMETERS.           COPY DBPARMS OF COPYLIB.
004800 COPY VCOMLINK OF COPYLIB.
004900 01  MASTER-PRTPLAN          PIC X(10).
005000 COPY LANGSUB OF COPYLIB.
005300 PROCEDURE DIVISION USING    DBPARAMETERS
005400                             VIEW-COMAREA
005500                             MASTER-PRTPLAN
005600                             LANGUAGE-PARMS.
005700
005800 START-PROGRAM.
005900     PERFORM 1-HSK.
006000     PERFORM 6-MAIN.
006100
006200 2-EOJ.
           CLOSE MASTER-PRTPLAN-FILE.
           CLOSE PRTPLAN-BANK.
006400     GOBACK.
006500
006700 1-HSK.
           OPEN I-O    MASTER-PRTPLAN-FILE.
           OPEN I-O    PRTPLAN-BANK.
006800     CALL "TPWORD" USING PASSWORD-INFORMATION.
007200     IF PASSWORD-FLAG = "N" GO TO 2-EOJ.
007600     MOVE MASTER-PRTPLAN    TO WORK-ORDER-NO.
007700
007900 6-MAIN.
008100     PERFORM 60-READ-PRTPLAN.
008400     PERFORM 61-DELETE-MASTER.
008600
008700 60-READ-PRTPLAN.
           MOVE 0 TO COND-WORD.
           MOVE WORK-ORDER-NO TO GPRTPNAME OF PBREC.
           START PRTPLAN-BANK KEY IS = EXTERNALLY-DESCRIBED-KEY
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF PB-STATUS NOT = "00" MOVE 17 TO COND-WORD.
009000     IF COND-WORD = 17
009100         NEXT SENTENCE
009200     ELSE
009300     IF COND-WORD = 0
009400         PERFORM 69-READ-PRTPLAN-BANK
009600         IF COND-WORD = 0
009700             PERFORM 61-DELETE-PRTPLAN UNTIL COND-WORD = 15
009800         ELSE
009900         IF COND-WORD = 15
010000             NEXT SENTENCE
010100         ELSE
010200         PERFORM 998-BLOWUP
010400     ELSE
010500     PERFORM 998-BLOWUP.
010700
010800 61-DELETE-PRTPLAN.
           MOVE 0 TO COND-WORD.
           DELETE PRTPLAN-BANK RECORD
               INVALID KEY     MOVE 17 TO COND-WORD.
           IF PB-STATUS NOT = "00" MOVE 17 TO COND-WORD.
011000     IF COND-WORD NOT = 0
011100         PERFORM 998-BLOWUP.
011300     PERFORM 69-READ-PRTPLAN-BANK.
011600     IF COND-WORD = 0 OR 15
011700         NEXT SENTENCE
011800     ELSE
011900     PERFORM 998-BLOWUP.
012100
012300 61-DELETE-MASTER.
           MOVE 0 TO COND-WORD.
012600     MOVE MASTER-PRTPLAN TO GPRTPNAME OF MPREC.
012800     START MASTER-PRTPLAN-FILE KEY IS = EXTERNALLY-DESCRIBED-KEY
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF MP-STATUS NOT = "00" MOVE 17 TO COND-WORD.
           IF COND-WORD = 17
               PERFORM 998-BLOWUP.
           READ MASTER-PRTPLAN-FILE NEXT INTO MASTER-PRTPLAN-DATA
               AT END    MOVE 15 TO COND-WORD.
           IF MP-STATUS NOT = "00" MOVE 15 TO COND-WORD.
013100     IF COND-WORD = 0
               MOVE 0 TO COND-WORD
               PERFORM 69-DELETE-MASTER-PRTPLAN
013400         IF COND-WORD NOT = 0
                   PERFORM 998-BLOWUP
013500         ELSE
013600         NEXT SENTENCE
013700     ELSE
013800     IF COND-WORD = 17
013900         NEXT SENTENCE
014000     ELSE
014100     PERFORM 998-BLOWUP.
       69-DELETE-MASTER-PRTPLAN.
           MOVE 0 TO COND-WORD.
           DELETE MASTER-PRTPLAN-FILE RECORD
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF MP-STATUS NOT = "00" MOVE 17 TO COND-WORD.
       69-READ-PRTPLAN-BANK.
           MOVE 0 TO COND-WORD.
           READ PRTPLAN-BANK NEXT INTO PRTPLAN-BUFFER
               AT END    MOVE 15 TO COND-WORD.
           IF PB-STATUS NOT = "00" MOVE 15 TO COND-WORD.
076200 998-BLOWUP.
076300     MOVE "TMPRTDEL" TO BU-PGM-NAME.
076400     CALL "TBLOWUP" USING BLOWUP-BASE BU-PGM-NAME STATUS-AREA
076500                      VIEW-COMAREA DUMMY-KSAM-STAT
076600                      BU-DISPLAY-MSG BU-DISPLAY-FLDS.
