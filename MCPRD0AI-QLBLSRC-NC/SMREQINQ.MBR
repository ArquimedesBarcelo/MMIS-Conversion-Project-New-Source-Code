088000 6000-MAIN.
088100*------ IF DATA WAS PASSED FROM THE CALLING PROGRAM,
088200*------ SKIP THE FIRST SCREEN GETTING THE INFO TO INQUIRE
088300*------ ON.  NOTE - THIS SUBPROGROG ASSUMES THAT THE DATA
088400*------ PASSED WAS VALIDATED
           IF SAVE-INQ-INQ-FLAG = "N"
088900         MOVE "Y"                  TO   CALLED-DATA-FLAG
089000         MOVE REQI-REQ-NO          TO   DE-REQ-NO
089100         MOVE REQI-WO-NO           TO   DE-WO-NO
089200         MOVE REQI-CORP-CODE       TO   DE-CORP-CODE
089300         MOVE "X"                  TO   DE-INCLUDE-UNAPPROVED,
089400                                        DE-INCLUDE-IN-PURCH,
089500                                        DE-INCLUDE-ON-PO,
089600                                        DE-INCLUDE-CODED-STR,
                                              DE-INCLUDE-CODED-NONSTR,
089700                                        DE-INCLUDE-NON-CODED
089800         MOVE "5"                  TO   DE-SORT-KEY
089900         MOVE "S"                  TO   DE-REQS-PER-SCRN
               MOVE SAVE-INQ-CC-INPUT    TO   DE-ORIGINATOR
090000         GO TO 6130-LOAD-REQ-FILE
           ELSE
088500     IF REQI-REQ-NO = SPACES AND REQI-REQ-NO = SPACES AND
088600       REQI-CORP-CODE = SPACES
088700         NEXT SENTENCE
088800     ELSE
088900         MOVE "Y"                  TO   CALLED-DATA-FLAG
089000         MOVE REQI-REQ-NO          TO   DE-REQ-NO
089100         MOVE REQI-WO-NO           TO   DE-WO-NO
089200         MOVE REQI-CORP-CODE       TO   DE-CORP-CODE
089300         MOVE "X"                  TO   DE-INCLUDE-UNAPPROVED,
089400                                        DE-INCLUDE-IN-PURCH,
089500                                        DE-INCLUDE-ON-PO,
089600                                        DE-INCLUDE-CODED-STR,
                                              DE-INCLUDE-CODED-NONSTR,
089700                                        DE-INCLUDE-NON-CODED
089800         MOVE "5"                  TO   DE-SORT-KEY
089900         MOVE "S"                  TO   DE-REQS-PER-SCRN
090000         GO TO 6130-LOAD-REQ-FILE.
090100
090200 6010-GET-FORM1.
090300     MOVE ZEROES TO STATUS-AREA.
090400     MOVE SPACES TO PLT-ARG, PO-ARG, VEN-ARG, REQ-ARG, CODE-ARG,
090500                    WO-ARG.
090600
090700     PERFORM 8210-GET-SCREEN1-FORM.
090900
091000*------ 1ST TIME, DEFLT VALUES ARE SET (IN SAVE-DE-VALUES, SET IN
091100*------ HOUSEKEEP. AFTER THAT, KEEP OPTIONS THEY USED LAST.
091200     MOVE SAVE-DE-FIELDS           TO   DE-FIELDS.

      *------ IF USER HAS OPTED TO RETAIN APPROVAL AMOUNTS IN MEMPL
      *------ FOR DISPLAY PURPOSES CHANGE THE FUNCTION KEY SELECTIONS
      *------ TO ALLOW THE USER TO SEE HIS CURRENT TOTALS VIA THE F5
      *------ KEY.

           IF DISPLAY-APP-AMTS = "Y"
               MOVE 06037 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER TO DE-COMMAND-LINE-1
           ELSE
           MOVE 06036 TO CATREAD-MSG-NUMBER
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
           MOVE MESSAGE-BUFFER TO DE-COMMAND-LINE-1.
091300
091600 6100-SHOWFORM-1.
      *--------- SHOULD CURRENCY BE DISPLAYED ON SCREEN?
           IF SAVE-REQ-CURR-SW = "N"
               MOVE B"1" TO IND(40).

           MOVE DE-FIELDS TO DISPLAY-REC.
           MOVE 2 TO SRF-KEYSET.
           MOVE "I" TO SRF-FKEY (8).
           PERFORM 998-WRITE-SCREEN THRU 998-READ-SCREEN.
           IF MESSAGE-BUFFER-1 NOT = SPACES
               PERFORM 4030-SETERROR
               GO TO 6100-SHOWFORM-1.
           MOVE DISPLAY-REC TO DE-FIELDS.
092600
092700     MOVE "N"                      TO   FIRST-TIME-FLAG.
092800
092900*------ HELP SCREEN
093000     IF VIEW-LASTKEY = 1
093100         MOVE "HLPRQA"             TO   HELP-FORM-PREFIX
093200         PERFORM 8110-HELP
093300         GO TO 6010-GET-FORM1.
093400
093500*------ TAB TO REQ NUMBER
093600     IF VIEW-LASTKEY = 2
               MOVE B"1" TO IND (9)
094000         GO TO 6100-SHOWFORM-1.
094100
093500*------ TAB TO ORIGINATOR
093600     IF VIEW-LASTKEY = 5
               MOVE B"1" TO IND (11)
094000         GO TO 6100-SHOWFORM-1.
094100
      *------ DISPLAY APPROVED $ AMOUNTS
           IF VIEW-LASTKEY = 7
               IF DISPLAY-APP-AMTS = "Y"
                   IF DE-APPROVER = "    "
                       NEXT SENTENCE
                   ELSE
                   MOVE DE-APPROVER        TO EMPLOYID OF MEMPL-REC
                   READ MEMPL INTO BUF-MEMPL
                   IF MEMPL-DISPLAY-DOLS = "N"
                       NEXT SENTENCE
                   ELSE
                   MOVE VIEW-NFNAME        TO SAVE-VIEW-NFNAME
                   MOVE "EAAPPAMT"         TO VIEW-NFNAME
                   MOVE SPACES             TO EAPP-DATA
                   MOVE DE-APPROVER        TO EAPP-CC
                   MOVE MEMPL-TODAY-BUCKET TO EAPP-DAILY-AMT
                   MOVE MEMPL-WEEKS-BUCKET TO EAPP-WEEKS-AMT
                   MOVE MEMPL-TOTAL-BUCKET TO EAPP-TOTAL-AMT
                   MOVE EAPP-DATA          TO   DISPLAY-REC
      *--------- SHOULD CURRENCY BE DISPLAYED ON SCREEN?
                   IF SAVE-REQ-CURR-SW = "N"
                       MOVE B"1" TO IND(40)
                   END-IF
      *--------- SHOULD ADDITIONAL INFO FIELD BE AN INPUT FIELD?
                   IF SAVE-REQ-SYNR3-SW = "Y"
                       MOVE B"1" TO IND (18)
                   END-IF
                   PERFORM 998-WRITE-SCREEN THRU 9989-WS-X
                   MOVE SAVE-VIEW-NFNAME   TO VIEW-NFNAME
                   MOVE SPACES             TO SAVE-VIEW-NFNAME
                   GO TO 6100-SHOWFORM-1.

094200*------ REQUISITION USER INQUIRY
094300     IF VIEW-LASTKEY = 6
094400         CALL "SEAUSEIQ" USING     BASE,
094500                                   BASE-MMISA,
094600                                   VIEW-COMAREA,
094700                                   SRF-COMAREA,
094800                                   LANGUAGE-PARMS,
094900                                   EAUSE-PARMS
095000         IF EAUSE-RETURNED-EMPL = SPACES
095100             GO TO 6010-GET-FORM1
095200         ELSE
095300             PERFORM 8210-GET-SCREEN1-FORM
095400             MOVE EAUSE-RETURNED-EMPL   TO   DE-ORIGINATOR
095600             GO TO 6100-SHOWFORM-1.
095700
095800     IF VIEW-LASTKEY = 3
095900         GO TO 6990-MAIN-X.
096000
096200     MOVE DE-FIELDS                TO   SAVE-DE-FIELDS.
096300
096400 6130-LOAD-REQ-FILE.
096500
           IF DE-SORT-KEY = "7"
               MOVE "Y" TO DREQQUE-DATE-SW
           ELSE
               MOVE "N" TO DREQQUE-DATE-SW.

096600*------ RELATIVE FILE IS LOADED UP FIRST WITH ALL REQS FOR INQ
096700     OPEN OUTPUT REQTEMP-SEQ.
096800     MOVE SPACES                   TO   MESSAGE-BUFFER-1.
096900     MOVE 0                        TO   REQTEMP-LIMIT.
097000     MOVE 0                        TO   REQTEMP-KEY.
           IF DE-REQ-NO = SPACES
               IF DE-WO-NO = SPACES
                   IF DE-CORP-CODE = SPACES
                       IF DE-ORIGINATOR = SPACES
                           IF DE-APPROVER = SPACES
                             IF DE-DATE = SPACES
                               MOVE 13   TO   LANG-SETNUM
                               MOVE 68   TO   LANG-MSGNUM
                               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                               MOVE 9    TO   FIELD-NUMBER
                               PERFORM 4030-SETERROR
                               CLOSE REQTEMP-SEQ
                               GO TO 6100-SHOWFORM-1.
097100     IF DE-REQ-NO NOT = SPACES
097200         MOVE "R"                  TO   SELECT-KEY-FLAG
097300         MOVE 9                    TO   FIELD-NUMBER
097400         PERFORM 6600-LOAD-FROM-MREQ THRU 6690-LFM-X
097500     ELSE
097600     IF DE-WO-NO NOT = SPACES
097700         MOVE "W"                  TO   SELECT-KEY-FLAG
097800         MOVE DE-WO-NO             TO   WO-ARG
097900         CALL "TALWONO" USING WO-ARG, ALWO-RET-CODE
098000         MOVE WO-ARG               TO   DE-WO-NO
098100         MOVE 10                   TO   FIELD-NUMBER
098200         PERFORM 6300-LOAD-FROM-DREQD THRU 6390-LFD-X
098300     ELSE
098400     IF DE-CORP-CODE NOT = SPACES
098500         MOVE "C"                  TO   SELECT-KEY-FLAG
098600         MOVE 5                    TO   FIELD-NUMBER
098700         PERFORM 6400-LOAD-FROM-DREQITM THRU 6490-LFD-X
098800     ELSE
098900     IF DE-ORIGINATOR NOT = SPACES
099000         MOVE "O"                  TO   SELECT-KEY-FLAG
099100         MOVE 11                   TO   FIELD-NUMBER
099200         PERFORM 6500-LOAD-FROM-DREQQUE THRU 6590-LFD-X
099300     ELSE
099400     IF DE-APPROVER NOT = SPACES
099500         MOVE "A"                  TO   SELECT-KEY-FLAG
099600         MOVE 12                   TO   FIELD-NUMBER
099700         PERFORM 6500-LOAD-FROM-DREQQUE THRU 6590-LFD-X
099800     ELSE
           IF DE-DATE NOT = SPACES
               MOVE "D"                  TO   SELECT-KEY-FLAG
               MOVE 23                   TO   FIELD-NUMBER
               PERFORM 6800-LOAD-FROM-MREQ-DATE  THRU  6890-LFM-X
           ELSE
099900     IF CALLED-DATA-FLAG = "Y"
100000         MOVE 1                    TO   REQI-RET-CODE
100100         GO TO 6990-MAIN-X
100200     ELSE
100300         GO TO 6100-SHOWFORM-1.
100400
100500     CLOSE REQTEMP-SEQ.
100600
100700*------ IF NO REQS FOUND, BUT NO ERROR FROM LOAD ROUTINE, (LIKE
100800*------ CORP CODE NOT EXIST, NO REQS FOR THIS WO, ETC), THEN THE
100900*------ EXCLUDE OPTIONS EXCLUDED EVERYTHING FOR THE CHAIN.
101000     IF REQTEMP-LIMIT = 0
101100         IF MESSAGE-BUFFER-1 = SPACES
101200*            "R83: NO REQUISITIONS FOUND"
101300             MOVE  18 TO LANG-SETNUM
101400             MOVE  83 TO LANG-MSGNUM
101500             PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
101600
101700*------ IF NO REQS FOUND, THE LOAD ROUTINE SETS THE ERROR.  IF
101800*------ USER ENTERED SELECTION DATA, GO BACK TO MAIN SCREEN.
101900*------ BUT IF CALLED DATA PASSED AND USER GOES TO SCRN1 FOR A
102000*------ 2CD INQUIRY, DONT EXIT
102100     IF REQTEMP-LIMIT = 0
102200         IF CALLED-DATA-FLAG = "Y" AND FIRST-TIME-FLAG = "Y"
102300             MOVE 2                TO   REQI-RET-CODE
102400             GO TO 6990-MAIN-X
102500         ELSE
102600             PERFORM 4030-SETERROR
102700             GO TO 6100-SHOWFORM-1.
102800
102900*------ USER CAN SORT THE INQUIRY DIFFERENT WAYS.  SORT THE FILES
103000*------ DIRECTLY (WITHOUT INPUT/OUTPUT SECTION) TO AVOID STACK
103100*------ PROBLEMS.
103200     IF DE-SORT-KEY = "2"
103300         SORT SORT-FILE ON ASCENDING KEY SORT-REQ-NUMBER
103400             USING REQTEMP-SEQ
103500             GIVING REQTEMP-SEQ.
103600
103700*------ WHEN SORTING BY WORKORDER WE WANT THOSE REQS WITHOUT ANY
103800*------ WORKORDER TO BE LAST - TO GIVE HIGHER PRIORITY TO WO
103900*------ WO REQS.  THERFORE WO OF SPACES IS CHANGED TO/FROM
104000*------ Zs WHEN WRITING/READING "REQTEMP" FILE.
104100     IF DE-SORT-KEY = "3"
104200         SORT SORT-FILE ON ASCENDING KEY SORT-WO-NUMBER
104300             USING REQTEMP-SEQ
104400             GIVING REQTEMP-SEQ.
104500
104600     IF DE-SORT-KEY = "4"
104700         SORT SORT-FILE ON ASCENDING KEY SORT-BUDGET-NO
104800             USING REQTEMP-SEQ
104900             GIVING REQTEMP-SEQ.
105000
105100     IF DE-SORT-KEY = "5"
105200         SORT SORT-FILE ON DESCENDING KEY SORT-DATE-CN,
105300                                          SORT-REQ-NUMBER
105400             USING REQTEMP-SEQ
105500             GIVING REQTEMP-SEQ.
105600
105700     IF DE-SORT-KEY = "6"
105800         SORT SORT-FILE ON ASCENDING KEY SORT-DATE-CN
105900             USING REQTEMP-SEQ
106000             GIVING REQTEMP-SEQ.
106100
           IF DE-SORT-KEY = "7"
               SORT SORT-FILE ON DESCENDING KEY SORT-DATE-CN,
                                                SORT-REQ-NUMBER
                   USING REQTEMP-SEQ
                   GIVING REQTEMP-SEQ.

106200     MOVE 5                        TO   MODE-MISC.
106300     OPEN INPUT REQTEMP-REL.
106400     MOVE 0                        TO   REQTEMP-KEY.
106500     MOVE 0                        TO   FIELD-NUMBER.
106600
106700*------ AT THIS POINT WE HAVE THE RELATIVE FILE LOADED WITH ALL
106800*------ REQS REQUESTED: WE DECIDE EITHER TO GO TO THE 1-REQ-PER
106900*------ SCREEN OR THE MULTIPLE-REQ SCREEN.
107000     IF DE-REQS-PER-SCRN = "S"
107100         PERFORM 6140-SINGLE-INQ THRU 6190-SI-X
107200     ELSE
107300         PERFORM 6200-MULTIPLE-INQ THRU 6290-MI-X.
107400
107500     CLOSE REQTEMP-REL.
107600
107700     IF VIEW-LASTKEY = 3
107800         GO TO 6990-MAIN-X
107900     ELSE
108000         GO TO 6010-GET-FORM1.
108100
108200******************************************************************
108300**                                                              **
108400**       S I N G L E   I T E M   I N Q U I R Y                  **
108500**                                                              **
108600******************************************************************
108700 6140-SINGLE-INQ.
108800*------ AFTER ANY SUBPROG IS CALLED FROM THE REQ DATA SCREEN, WE
108900*------ COME BACK HERE- IN CASE REQ WAS DELETED OR CHANGED.
109000*------ IN CASE ALL REQS IN FILE WERE DELETED AFTER CALLING A
109100*------ SUBPROGRAM, WE EXIT BACK TO MAIN SCREEN.
           MOVE SPACES TO MESSAGE-BUFFER-1.
109200 6145-REGET-REQ.
           MOVE SPACES TO MESSAGE-BUFFER.
       6150-REGET-NOSPACE.
109300     PERFORM 6700-GET-NEXT-REQ THRU 6710-GNR-X.
109400     IF ALL-DETAILS-FOUND-FLAG = "N"
109500         CLOSE REQTEMP-REL
109600         GO TO 6010-GET-FORM1.
109700
109800*------ IF WO AMOUNTS APPROVED, COMMITTED, REQUISITIONED/NOT
109900*------ PURCHASED, AND AVAILABLE ARE NOT TO BE DISPLAYED (BECAUSE
110000*------ OF THE SLOWER RESPONSE TIME INVOLVED IN THE CURRENT
110100*------ METHOD OF RETREIVING THE DATA), CHANGE THAT FIELD TO
110200*------ DISPLAY ONLY.  THIS IS AN OPTION ON GLOBALS MENU.
110300     PERFORM 8200-GET-SCREEN2-FORM.
110400*    IF DISP-WO-AMTS NOT = "Y"
110500*        CALL "VCHANGEFIELD" USING VIEW-COMAREA,
110600*          VCHGFLD-SPEC-BUF, VCHGFLD-NUM-ENTRIES
110700*        IF VIEW-STATUS NOT = 0
110800*            MOVE "VCHANGEFIELD ERR 6160-GRS" TO BU-DISPLAY-MSG
110900*            PERFORM 2100-BLOWUP.
111000*
111100******************************************************************
111200**           BUILD SINGLE INQUIRY SCREEN                        **
111300******************************************************************
111400 6160-GET-REQ-SCREEN.
111500
111600     PERFORM 8200-GET-SCREEN2-FORM.
112000
112100******************************************************************
112200* SET EACH FUNCTION KEY DEPENDING ON WHETHER                     *
112300* IT IS ENABLED:                                                 *
112400*                                                                *
112500*  f1 - PREV                (VARIABLE - IF BACKWRD ENTRY IN CHAIN*
112600*  f2 - NEXT                (VARIABLE - IF ANOTHER ENTRY IN CHAIN*
112700*  f3 - APPROVE/PO INQUIRY  (VARIABLE - IF APPROVE/IF REQ ON PO) *
112800*  f4 - FULL DESC           (FIXED)                              *
112900*  f5 - PRINT SCRN          (FIXED)                              *
113000*  f6 - OTHER FUNCTIONS     (FIXED)                              *
113100*  f7 - EXIT                (FIXED)                              *
113200*  f8 - END PROGRAM         (FIXED)                              *
113300******************************************************************
113400
113500 6165-BUILD-REQ-SCREEN.
           IF MESSAGE-BUFFER-1 NOT = SPACES
                MOVE DE-MESSAGE-LINE-2 TO SAVE-MSG.
113600     MOVE SPACES                   TO   DE-FIELDS-2.
           IF MESSAGE-BUFFER-1 NOT = SPACES
                MOVE SAVE-MSG TO DE-MESSAGE-LINE-2.
113700     MOVE ZERO                     TO   V-QTY-TO-ORD,
113800                                        V-UNIT-PRICE,
113800                                        V-UNIT-PRICE-2,
113900                                        V-BUDGET-AMT,
114000                                        V-QTY-ORD,
114100                                        V-QTY-DLVR.
114200
114300 6167-BUILD-NOSPACE.
114400     PERFORM 8220-SET-PREV-NEXT-KEYS.
114500
114700     MOVE "N"                      TO   APPROVE-FKEY-ON.
114800     IF REQI-APPROVE-FLAG = "Y"  AND REQ-STATUS < "SS" AND
114900       REQ-MATCONT-RELEASE = " " AND EAEDIT-QUEUED-FLAG = "Y"
115000       AND DRQQ-APPROVE-DATE-CN = SPACES
115100         MOVE KEY-APPROVE          TO   CLW-8
115200         MOVE "Y"                  TO   APPROVE-FKEY-ON
115300     ELSE
114800     IF REQI-APPROVE-FLAG = "Y"  AND REQ-STATUS = "SS" AND
114900       REQ-MATCONT-RELEASE = " " AND EAEDIT-QUEUED-FLAG = "Y"
115000       AND DRQQ-APPROVE-DATE-CN = SPACES
             AND REQ-AUTH-CODE-FLAG = "X"
115100         MOVE KEY-APPROVE          TO   CLW-8
115200         MOVE "Y"                  TO   APPROVE-FKEY-ON
               MOVE "X"                  TO   EAEDIT-AUTH-FLAG
115300     ELSE
115400     IF REQ-RELEASE-STAT = "XX"
115500         MOVE KEY-POPTION          TO   CLW-8
115600     ELSE
115700         MOVE "I"                  TO   SRF-FKEY (8)
115800         MOVE SPACES               TO   CLW-8.
116000
116100*------ NOTE: KEYS 5, 6, 7, AND 8 ARE STATIC AND WILL BE SET IN
116200*------ FORM.
116300
116400     MOVE MREQ-NUMBER              TO   V-REQ-NUMBER.
116500     MOVE 4                        TO   DATE-MODE.
116600     MOVE REQ-DATE                 TO   DATE-VALIDATE-IN.
116700     CALL "TDATECHK" USING DATE-CHECK-AREA.
116800     MOVE DATE-SLASH-OUT           TO   V-REQ-DATE.
116900     MOVE REQITM-CORP-CODE         TO   V-CORP-CODE.
117000     MOVE REQITM-QTY-TO-ORD        TO   V-QTY-TO-ORD.
117100     MOVE REQITM-UM                TO   V-UM.
117200     MOVE REQITM-UNIT-PRICE        TO   V-UNIT-PRICE.
           IF REQITM-UNIT-PRICE-CURR NOT NUMERIC
               MOVE ZEROES               TO   V-UNIT-PRICE-2
           ELSE
           MOVE REQITM-UNIT-PRICE-CURR   TO   V-UNIT-PRICE-2.
           MOVE REQITM-CURRENCY          TO   V-CURRENCY-2.
           MOVE SAVE-HOME-CURRENCY       TO   V-CURRENCY.
           IF SAVE-REQ-CURR-SW = "N"
               MOVE SPACES               TO  V-CURR-NAME
           ELSE
               MOVE REQITM-CURRENCY      TO  UM-ARG
               MOVE UM-ARG TO VALIDUM OF MVALIDUM-REC-I
               READ MVALIDUM-I INTO BUF-MVALIDUM
                   INVALID KEY MOVE FILE-STATUS TO FILE-STATUS
               END-READ
               IF FILE-STATUS NOT = "00"
                   MOVE SPACES               TO V-CURR-NAME
               ELSE
                   MOVE VALID-CURRENCY-DESC  TO V-CURR-NAME.

      *-------- IF NO "OTHER CURRENCY" EXISTS, HIDE FIELDS ON SCREEN.
           IF REQITM-CURRENCY = SPACES OR SAVE-REQ-CURR-SW = "N"
               MOVE SPACES               TO   V-UNIT-PRICE-2-R
               MOVE B"1" TO IND(40).

      *--------- TRANSLATE REQ-SERVICE-FLAG INTO LITERAL FOR DISPLAY.
           IF REQ-SERVICE-FLAG = "S"
               MOVE "SERVICE "           TO   V-REQ-FLAG
           ELSE
               IF REQ-SERVICE-FLAG = "R"
                   MOVE "REPAIR  "       TO   V-REQ-FLAG
               ELSE
                   MOVE "MATERIAL"       TO   V-REQ-FLAG.

      *--------- SHOULD ADDITIONAL INFO FIELD BE AN INPUT FIELD?
           IF SAVE-REQ-SYNR3-SW = "Y"
               MOVE B"1" TO IND (18).
117300     MOVE REQITM-BUDGET-AMT        TO   V-BUDGET-AMT.
           INSPECT V-BUDGET-AMT REPLACING LEADING "0" BY " ".
117400
117500*------ SHOW BUDGET NUMBER WITH DASHES, NO REVISION
117600*    MOVE REQITM-BUDGET-NO         TO   BUDNUM-IN.
117700*    CALL "CBUDNUM" USING BUDNUM-IN, BUDNUM-NODASH-NOREV,
117800*      BUDNUM-NODASH-REV, BUDNUM-DASH-NOREV, BUDNUM-DASH-REV.
117900*    MOVE BUDNUM-DASH-NOREV        TO   V-BUDGET-NO.
           MOVE REQITM-BUDGET-NO         TO   V-BUDGET-NO.
118000
118100*------ NOTE: 'TGETAMTS' TO GET WORKORDER COST AMTS IS CALLED IN
118200*------ '6700-GET-NEXT-REQ' BECAUSE IT GETS REQ DATA FOR ALL REQS
118300*------ ON THE WO, THUS LOSING OUR CURRENT 'MREQ' AND 'DREQITM'
118400*------ RECORDS.  SO WE CALL IT BEFORE GETTING THOSE RECORDS.
118500     IF DREQD-WO-NUMBER > SPACES AND DISP-WO-AMTS = "Y"
118600         ADD TGETAMTS-WO-AMT-APP, 0 GIVING NUM-14 ROUNDED
118700         MOVE NUM-14               TO   DISP-WO-APP
118800         ADD TGETAMTS-WO-AMT-COMM, 0 GIVING NUM-14 ROUNDED
118900         MOVE NUM-14               TO   DISP-WO-COMT
119000         ADD TGETAMTS-AMT-NOT-PUR, 0 GIVING NUM-14 ROUNDED
119100         MOVE NUM-14               TO   DISP-WO-REQ
119200         ADD TGETAMTS-AMT-AVAIL, 0 GIVING NUM-14 ROUNDED
119300         MOVE NUM-14               TO   DISP-WO-AVAIL
119400         MOVE DISP-WO-AMTS-LINE    TO   V-WO-AMTS-LINE
119500     ELSE
119600         MOVE SPACES               TO   V-WO-AMTS-LINE.
119700
119800     MOVE REQ-DATE-WANTED          TO   DATE-VALIDATE-IN.
119900     CALL "TDATECHK" USING DATE-CHECK-AREA.
120000     MOVE DATE-SLASH-OUT           TO   V-DATE-WANTED.
           IF SAVE-PACD-SW = "N"
               MOVE "NW/A.D."            TO   DE-ACCT-INFO-LIT
           ELSE
           MOVE "EXP/NW "                TO   DE-ACCT-INFO-LIT.
           IF SAVE-REQ-SYNR3-SW = "Y"
               MOVE "SAP INT ORD #  "    TO   DE-ADDL-INFO-LIT
               MOVE B"1" TO IND (18)
           ELSE
               MOVE "ADDITIONAL INFO"    TO   DE-ADDL-INFO-LIT.
120100     MOVE REQ-ACCT-INFO            TO   DE-ACCT-INFO,
120200                                        SAVE-ACCT-INFO.
120300     MOVE REQ-STAGING-AREA         TO   V-STAGING-AREA.
120400     MOVE REQ-ORIGINATOR           TO   V-ORIGINATOR.
           IF REQ-ORIGINATOR NOT = "    "
120500         PERFORM 7200-GET-EMPLOYEE-MMIS
           ELSE
               MOVE SPACES               TO   PER-EMP-NAME.
120600     MOVE PER-EMP-NAME             TO   V-ORIG-NAME.
120700     MOVE DREQD-WO-NUMBER          TO   V-WO-NUMBER.
120800
120900     IF DREQD-WO-NUMBER = SPACES
121000         MOVE SPACES               TO   V-WO-APP
121100     ELSE
121200         MOVE V-WO-NUMBER          TO   APPROVAL-WO
121300         CALL "TPASSAPP" USING BASE-MMISA, APPROVAL-WORKAREA
121400         MOVE APPROVAL-STATUS      TO   V-WO-APP.
121500     MOVE REQ-ADDL-INFO            TO   V-ADDL-INFO
                                              SAVE-ADDL-INFO.
121600     MOVE REQITM-NOTE              TO   V-SUGGESTED-VENDOR.
121700     IF REQ-REPAIR-INDIC = "X"
121800         MOVE "R"                  TO   V-REQ-TYPE
121900     ELSE
122000         MOVE "P"                  TO   V-REQ-TYPE.
122100     IF REQ-MODIFY-FLAG = "X"
122200         MOVE "Y"                  TO   V-REQ-MOD
122300     ELSE
122400         MOVE "N"                  TO   V-REQ-MOD.
122500     IF REQ-PATH NUMERIC
122600         MOVE REQ-PATH             TO   V-PATH
122700     ELSE
122800         MOVE ZERO                 TO   V-PATH.
122900     IF REQ-APPROVALS-LEFT NUMERIC
123000         MOVE REQ-APPROVALS-LEFT-9 TO   V-APPROVALS-LEFT
123100     ELSE
123200         MOVE ZERO                 TO   V-APPROVALS-LEFT.
123300
123400     IF REQ-MAT-TYPE = "S"
123500         MOVE 3                    TO   CDESC-LINES-TO-GET
123600         MOVE "N"                  TO   CDESC-LOCAL-DESC-OPTION
123700         CALL "CDESC" USING CDESC-RET-CODE, BASE, STATUS-AREA,
123800           BU-DISPLAY-MSG, CODE-ARG, CDESC-DATA
123900         IF BU-DISPLAY-MSG-1 NOT = SPACES
124000             PERFORM 2100-BLOWUP
124100         ELSE
124200             MOVE CDESC (1)        TO   V-DESC (1)
124300             MOVE CDESC (2)        TO   V-DESC (2)
124400             MOVE CDESC (3)        TO   V-DESC (3)
           ELSE
      *---------- IF SAP PLANT AND A CODED REQ, SHOW REQ DESCRIPTION
      *---------- FIRST, THEN CODE DESCRIPTION.
               IF SAVE-REQ-SYNR3-SW = "Y" AND CODE-ARG NOT = "NON-STR"
                   INITIALIZE HOLD-DESC-AREA
                   MOVE 3                    TO   RQD-NUM-LINES
                   CALL "TNRQDESC" USING RQD-NUM-LINES, BASE,
                     STATUS-AREA, REQ-ARG, REQ-DESC-AREA, BU-DISPLAY-MSG
                   IF BU-DISPLAY-MSG-1 NOT = SPACES
                       PERFORM 2100-BLOWUP
                   ELSE
                       MOVE RQD-DESC (1)     TO   HOLD-DESC (1)
                       MOVE RQD-DESC (2)     TO   HOLD-DESC (2)
                       MOVE RQD-DESC (3)     TO   HOLD-DESC (3)
                   END-IF
                   MOVE 3                TO   CDESC-LINES-TO-GET
                   MOVE "N"              TO   CDESC-LOCAL-DESC-OPTION
                   CALL "CDESC" USING CDESC-RET-CODE, BASE,
                     STATUS-AREA, BU-DISPLAY-MSG, CODE-ARG, CDESC-DATA
                   IF BU-DISPLAY-MSG-1 NOT = SPACES
                       PERFORM 2100-BLOWUP
                   ELSE
                       MOVE CDESC (1)    TO   HOLD-DESC (4)
                       MOVE CDESC (2)    TO   HOLD-DESC (5)
                       MOVE CDESC (3)    TO   HOLD-DESC (6)
                   END-IF
                   MOVE 1                TO  SUB2
                   PERFORM VARYING SUB1 FROM 1 BY 1 UNTIL SUB1 > 6
                                                       OR SUB2 > 3
                       IF HOLD-DESC (SUB1) > SPACES
                           MOVE HOLD-DESC (SUB1) TO V-DESC (SUB2)
                           ADD 1         TO  SUB2
                       END-IF
                   END-PERFORM
124500     ELSE
124600         MOVE 3                    TO   RQD-NUM-LINES
124700         CALL "TNRQDESC" USING RQD-NUM-LINES, BASE, STATUS-AREA,
124800           REQ-ARG, REQ-DESC-AREA, BU-DISPLAY-MSG
124900         IF BU-DISPLAY-MSG-1 NOT = SPACES
125000             PERFORM 2100-BLOWUP
125100         ELSE
125200             MOVE RQD-DESC (1)     TO   V-DESC (1)
125300             MOVE RQD-DESC (2)     TO   V-DESC (2)
125400             MOVE RQD-DESC (3)     TO   V-DESC (3).
125500
125600     CALL "CREQREM" USING BASE, BASE-MMISA, STATUS-AREA,
125700       BUF-DREQD, REQ-STATUS, REQR-REMARKS, BU-DISPLAY-MSG.
125800     IF BU-DISPLAY-MSG-1 NOT = SPACES
125900         PERFORM 2100-BLOWUP.
126000     MOVE REQR-REMARKS             TO   V-REMARK-AREA.
126100
126200     IF REQ-RELEASE-STAT = "XX"
126300         PERFORM 7300-GET-PO-DATA THRU 7390-GPD-X.
126400
126500     IF V-CORP-CODE = "NON-STR"
126600         MOVE SPACES               TO   V-BLANKET
126700     ELSE
126800         MOVE SPACES               TO   FIRST-UNEXPIRED-BLKT
                                              R11-SMALL-PO
                                              R11-LARGE-PO
126900         CALL "TCHKBLKT" USING BASE, CODE-ARG, CHKBLKT-PARMS
127000         MOVE FIRST-UNEXPIRED-BLKT TO   V-BLANKET.
127100
127200     IF REQ-STATUS = "SS" OR "S"
127300*        "CODED STOREROOM ITEM"
127400         MOVE  3  TO LANG-SETNUM
127500         MOVE 162 TO LANG-MSGNUM
127600         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
127700     ELSE
127800     IF REQ-STATUS = "SN"
127900*        "CODED NON-STOREROOM ITEM"
128000         MOVE   3 TO LANG-SETNUM
128100         MOVE 163 TO LANG-MSGNUM
128200         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
128300     ELSE
128400     IF REQ-STATUS = "NM"
128500*        "NON CODED ITEM"
128600         MOVE  14 TO LANG-SETNUM
128700         MOVE 108 TO LANG-MSGNUM
128800         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
128900     ELSE
129000     IF REQ-STATUS = "NI"
129100*        "NON-CODED INTERNATIONAL REQ"
129200         MOVE  14 TO LANG-SETNUM
129300         MOVE 109 TO LANG-MSGNUM
129400         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
129500     ELSE
129600        MOVE SPACES                TO   MESSAGE-BUFFER.
129700
129800     MOVE MESSAGE-BUFFER           TO   V-REQ-STATUS.
