192500 6600-LOAD-FROM-MREQ.
192600
192700     MOVE DE-REQ-NO TO REQ-ARG.
192800     PERFORM 7030-GET-MREQ.
192900     IF COND-WORD = 17
193000*        "R5: REQUISITION NUMBER DOES NOT EXIST"
193100         MOVE  18 TO LANG-SETNUM
193200         MOVE   5 TO LANG-MSGNUM
193300         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
193400         GO TO 6690-LFM-X.
193500
193600     PERFORM 7020-FIND-GET-DREQD THRU 7025-FGD-X.
193700     PERFORM 7150-WRITE-REQTEMP.
193800
193900 6690-LFM-X.
194000      EXIT.
194100
194200 6700-GET-NEXT-REQ.
194300     PERFORM 6720-NEXT-KEY.
194400
194500     IF REQTEMP-KEY > REQTEMP-LIMIT
194600         GO TO 6710-GNR-X.
194700
194800     IF REQTEMP-KEY < 1
194900         GO TO 6710-GNR-X.
195000
195100     READ REQTEMP-REL INVALID KEY
195200         MOVE "INVAL KEY READ RQFIL 6700-GNR" TO BU-DISPLAY-MSG
195300         PERFORM 2100-BLOWUP.
195400
195500*------ WO SPACES CHANGED TO Zs SO NON-WO WILL BE LAST IN SORT
195600     IF REQTEMP-WO-NUMBER OF REQTEMP-REL-REC = BIGGEST-WO
195700         MOVE SPACES TO REQTEMP-WO-NUMBER OF REQTEMP-REL-REC.
195800
195900     IF REQTEMP-KEY = 1
196000         MOVE "N"                  TO   PREVIOUS-FLAG
196100     ELSE
196200         MOVE "Y"                  TO   PREVIOUS-FLAG.
196300
196400     IF REQTEMP-KEY = REQTEMP-LIMIT
196500         MOVE "N"                  TO   NEXT-FLAG
196600     ELSE
196700         MOVE "Y"                  TO   NEXT-FLAG.
196800
196900*------ WE CALL 'TGETAMTS' HERE SO IT WONT LOSE CURRENT RECORD.
197000     IF DISP-WO-AMTS = "Y"
           AND REQTEMP-WO-NUMBER OF REQTEMP-REL-REC > SPACES
197100         MOVE REQTEMP-WO-NUMBER OF REQTEMP-REL-REC
                 TO TGETAMTS-WO-NUMBER
197200         CALL "TGETAMTS" USING    BASE-MMISA,
197300                                  BASE,
197400                                  TGETAMTS-PARMS,
197500                                  LANGUAGE-PARMS,
197600                                  ESC-NAME,
197700                                  VIEW-COMAREA.
197800
197900     MOVE REQTEMP-REQ-NUMBER OF REQTEMP-REL-REC TO REQ-ARG.
198000     MOVE "Y"                      TO   ALL-DETAILS-FOUND-FLAG.
198100     PERFORM 7000-FIND-GET-DREQITM-MSTORE THRU 7005-FGDM-X.
198200     PERFORM 7020-FIND-GET-DREQD THRU 7025-FGD-X.
198300     PERFORM 7030-GET-MREQ.
198400     PERFORM 7050-FIND-GET-DREQQUE THRU 7055-FGD-X.
198500
198600*------ AFTER THE TEMP FILE IS CREATED, A REQ IN THE FILE COULD
198700*------ HAVE BEEN DELETED. ALSO, SKIP ANY BAD REQS.
198800     IF ALL-DETAILS-FOUND-FLAG = "N"
198900         GO TO 6700-GET-NEXT-REQ.
199000
199100
199200 6710-GNR-X.
199300     EXIT.
199400
199500 6720-NEXT-KEY.
199600     IF MODE-MISC = 5
199700         ADD 1                     TO   REQTEMP-KEY
199800     ELSE
199900         SUBTRACT 1                FROM REQTEMP-KEY.
200000

      ******************************************************************
      **                                                              **
      **       L O A D   F R O M   M R E Q   (B Y   D A T E)          **
      **                                                              **
      ******************************************************************
       6800-LOAD-FROM-MREQ-DATE.

           INITIALIZE          DATE-CHECK-AREA.
           MOVE DE-DATE        TO  DATE-VALIDATE-IN.
           MOVE 3              TO  DATE-MODE.
           CALL "TDATECHK"     USING DATE-CHECK-AREA.
           IF DATE-MSG NOT = SPACES
               MOVE DATE-MSG   TO  MESSAGE-BUFFER
               GO TO 6890-LFM-X.

           MOVE 0 TO COND-WORD.
           MOVE DATE-YMD-OUT     TO  DATE-ARG-YMD.
           IF DATE-ARG-YY > "70"
               MOVE "19"         TO  DATE-ARG-CC
           ELSE
               MOVE "20"         TO  DATE-ARG-CC.
           MOVE DATE-ARG TO REQDTE OF MREQ-DTE-REC.
           START MREQ-DTE KEY >= REQDTE OF MREQ-DTE-REC
               INVALID KEY MOVE 17 TO COND-WORD.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
                   MOVE 17 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.
           IF COND-WORD = 17
               PERFORM 8001-DATE-NOT-ON-REQ
               MOVE 23                   TO   FIELD-NUMBER
               GO TO 6890-LFM-X
           ELSE
           IF COND-WORD NOT = 0
               MOVE "DBFIND ERR MREQ 6800-LFM" TO BU-DISPLAY-MSG
               PERFORM 2100-BLOWUP.

       6810-LOAD-FROM-MREQ-LOOP.
           MOVE 0 TO COND-WORD.
           READ MREQ-DTE NEXT INTO BUF-MREQ
               AT END MOVE 15 TO COND-WORD.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   MOVE 15 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.
           IF DATE-ARG NOT = REQ-DATE-CN MOVE 15 TO COND-WORD.
           IF END-OF-CHAIN
               GO TO 6890-LFM-X
           ELSE
           IF NOT GOOD-CALL
               MOVE "DBGET ERR MREQ 6810-LFML" TO BU-DISPLAY-MSG
               PERFORM 2100-BLOWUP.

           MOVE MREQ-NUMBER              TO   REQ-ARG.
           PERFORM 7020-FIND-GET-DREQD THRU 7025-FGD-X.
           PERFORM 7120-CHECK-SELECTIONS THRU 7140-CS-X.
           IF SELECTED-FLAG = "N"
               GO TO 6810-LOAD-FROM-MREQ-LOOP.

           PERFORM 7150-WRITE-REQTEMP.
           GO TO 6810-LOAD-FROM-MREQ-LOOP.

       6890-LFM-X.
           EXIT.


200100
200200
200300 6990-MAIN-X.
200400     EXIT.
200500
