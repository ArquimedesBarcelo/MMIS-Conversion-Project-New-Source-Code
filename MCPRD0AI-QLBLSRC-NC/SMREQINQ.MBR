217200             GO TO 7140-CS-X
217300         ELSE
217400             NEXT SENTENCE
217500     ELSE
217600     IF REQ-RELEASE-STAT = "XX"
217700         IF DE-INCLUDE-ON-PO = SPACES
217800             GO TO 7140-CS-X.
217900
218000     IF REQ-STATUS = "SS"
