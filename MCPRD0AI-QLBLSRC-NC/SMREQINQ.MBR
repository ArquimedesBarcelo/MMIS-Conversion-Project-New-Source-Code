248800     MOVE MEMPL-LEVEL              TO   EAVACA-EMPL-LEVEL.
248900     CALL "SEAVACA" USING          BASE,
249000                                   BASE-MMISA,
249100                                   EAVACA-PARMS,
249200                                   VIEW-COMAREA,
249300                                   LANGUAGE-PARMS.
249400
249500
249600 8160-REPRINT.
           IF PRINT-REQ-AMTS = "Y"
               MOVE "Y"                  TO   REQ-PRT-WO-AMTS
           ELSE
           MOVE "N"                      TO   REQ-PRT-WO-AMTS.

250100     MOVE MREQ-NUMBER              TO   REQ-NUMBER.
250200     MOVE MPLTINFO-COMP            TO   REQ-COMPANY-SAVE.
250300     MOVE V-REMARK (1)             TO   REQ-FREE-VERB-LINE (1).
250400     MOVE V-REMARK (2)             TO   REQ-FREE-VERB-LINE (2).
250500     CALL "SREQPRNT" USING BASE, BASE-MMISA, SREQPRNT-PARMS,
250600       ESC-NAME, LANGUAGE-PARMS, STATUS-AREA,
250700       BU-DISPLAY-MSG, BU-DISPLAY-FLDS, VIEW-COMAREA.
250800     IF BU-DISPLAY-MSG-1 NOT = SPACES
250900         PERFORM 2100-BLOWUP.
251000
251100 8165-R-X.
251200     EXIT.
251300
251400 8170-APPROVE.
           MOVE SPACES                   TO   EAPP-PARMS.
251500     CALL "CEAAPPRV" USING         BASE,
251600                                   BASE-MMISA,
251700                                   BASE-BUDGET,
251800                                   STATUS-AREA,
251900                                   BUF-MREQ,
252000                                   BUF-DREQQUE,
252100                                   REQ-GLOBALS,
252200                                   EAPP-PARMS,
252300                                   BU-DISPLAY-MSG.
252400     IF BU-DISPLAY-MSG-1 NOT = SPACES
252500         PERFORM 2100-BLOWUP.
252600
252700*------ IF FINAL APPROVAL, PRINT: BUT ONLY IF PRINT FLAG
252800*------ (EITHER LOCAL OR PURCH) IS ON.
           IF PRINT-FLAG = "N"
               NEXT SENTENCE
           ELSE
252900     IF REQ-APPROVALS-LEFT-9 < 1
253100         MOVE SPACES               TO   REQ-REPRINT-INDIC
253200         MOVE REQ-APP-PRT-NUM-9    TO   REQ-SPOOL-PRT
253300         PERFORM 8160-REPRINT THRU 8165-R-X.
253400
           IF DISPLAY-APP-AMTS = "Y"
               IF MEMPL-DISPLAY-DOLS = "N"
                   NEXT SENTENCE
               ELSE
               MOVE VIEW-NFNAME          TO   SAVE-VIEW-NFNAME
               MOVE "EAAPPAMT"           TO   VIEW-NFNAME
               MOVE EAPP-DATA            TO   DISPLAY-REC
      *--------- SHOULD CURRENCY BE DISPLAYED ON SCREEN?
               IF SAVE-REQ-CURR-SW = "N"
                   MOVE B"1" TO IND(40)
               END-IF
      *--------- SHOULD ADDITIONAL INFO FIELD BE AN INPUT FIELD?
               IF SAVE-REQ-SYNR3-SW = "Y"
                   MOVE B"1" TO IND (18)
               END-IF
               PERFORM 998-WRITE-SCREEN THRU 9989-WS-X
               MOVE SAVE-VIEW-NFNAME     TO   VIEW-NFNAME
               MOVE SPACES               TO   SAVE-VIEW-NFNAME.
253500 8175-A-X.
253600     EXIT.
253700
253800 8180-EDIT-APPROVE.
253900*------ COMMENTS ARE ONLY ALLOWED IF FORWARDING OR IF HE HAS IT
254000*------ QUEUED
254100     IF (DE-Q-COMMENT-1 NOT = SPACES) OR
254200        (DE-Q-COMMENT-2 NOT = SPACES)
254300         MOVE "Y"                  TO   EAEDIT-COMMENT-FLAG
254400     ELSE
254500         MOVE "N"                  TO   EAEDIT-COMMENT-FLAG.
254600
254700*------ ONLY EDIT IF f8 IS HIT (APPROVE), OR ONE OF THE FUNCTIONS
254800*------ IS SELECTED. NOTE: IF REQ ON PO, f8 WILL HAVE PO INQ,
254900*------ SO DONT EDIT
255000     IF (VIEW-LASTKEY = 8) AND APPROVE-FKEY-ON = "Y"
255100         MOVE "A"                  TO   EAEDIT-MODE
255200         MOVE 1                    TO   FIELD-NUMBER
255300     ELSE
255400     IF DE-RETURN > " "
255500         MOVE "R"                  TO   EAEDIT-MODE
255600         MOVE 41                   TO   FIELD-NUMBER
255700     ELSE
255800     IF DE-FORWARD-TO > "   "
255900         MOVE "F"                  TO   EAEDIT-MODE
256000         MOVE 45                   TO   FIELD-NUMBER
256100     ELSE
256200     IF DE-MODIFY > " "
256300         MOVE "M"                  TO   EAEDIT-MODE
256400         MOVE 43                   TO   FIELD-NUMBER
256500     ELSE
256600     IF DE-ACCT-INFO NOT = SAVE-ACCT-INFO
256700         MOVE "M"                  TO   EAEDIT-MODE
256800         MOVE 13                   TO   FIELD-NUMBER
256900     ELSE
           IF V-ADDL-INFO NOT = SAVE-ADDL-INFO
               MOVE "M"                  TO   EAEDIT-MODE
               MOVE 17                   TO   FIELD-NUMBER
           ELSE
257000     IF EAEDIT-COMMENT-FLAG = "Y"
257100         MOVE "C"                  TO   EAEDIT-MODE
257200         MOVE 48                   TO   FIELD-NUMBER
257300     ELSE
257000     IF V-TAX-CODE NOT = SAVE-V-TAX-CODE
257100         GO TO 8183-EDIT-TAX-CODE
257300     ELSE
257400         GO TO 8185-EA-X.
257500
257600 8182-EDIT-APPROVE-MULT.
257700     MOVE REQ-STATUS               TO   EAEDIT-STATUS.
257800     MOVE REQ-RELEASE-STAT         TO   EAEDIT-RELEASE-STAT.
257900     MOVE REQ-ORIGINATOR           TO   EAEDIT-ORIG.
258000     MOVE REQ-HOLD-STATUS          TO   EAEDIT-HOLD-STATUS.
258100     MOVE DRQQ-APPROVE-DATE        TO   EAEDIT-APPROVE-DATE.
           MOVE MEMPL-EMPL               TO   EAEDIT-EMPL.
258200     CALL "CEAEDIT" USING          EAEDIT-PARMS,
258300                                   REQ-GLOBALS,
258400                                   BUF-MEMPL,
258500                                   MESSAGE-BUFFER,
258600                                   LANGUAGE-PARMS,
258700                                   BU-DISPLAY-MSG.
           MOVE " "                      TO   EAEDIT-AUTH-FLAG.
258800     IF MESSAGE-BUFFER-1 NOT = SPACES
258900         PERFORM 4030-SETERROR
               GO TO 8185-EA-X.

      *-----  EDIT TAX CODE, IF ENTERED.
       8183-EDIT-TAX-CODE.

           IF V-TAX-CODE = SPACES
              GO TO 8185-EA-X.

           MOVE V-TAX-CODE TO TAXCDE-ARG.
           MOVE TAXCDE-ARG TO TAXCDE OF MTAX-REC.
           MOVE 0 TO COND-WORD.
           READ MTAX INTO BUF-MTAX
             INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
              IF FILE-STATUS = "23"
                 MOVE 17 TO COND-WORD
              ELSE
                 MOVE 99 TO COND-WORD.
           IF NOT GOOD-CALL
              IF NO-ENTRY
      *T7: TAX CODE DOES NOT EXIST
                 MOVE  20 TO LANG-SETNUM
                 MOVE  07 TO LANG-MSGNUM
                 PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                 MOVE 55 TO FIELD-NUMBER
                 PERFORM 4030-SETERROR
              ELSE
                 MOVE "READ MTAX 8180-EA" TO BU-DISPLAY-MSG
                 PERFORM 2100-BLOWUP.
259000
259100 8185-EA-X.
259200     EXIT.
259300
259400 8190-UPDATE-DREQQUE.
259500*    MOVE REQ-ARG                  TO   LOCK-VALUE-1.
259600*    MOVE "DREQQUE;"               TO   DSET-NAME-1.
259700*    MOVE "REQ-NUMBER;"            TO   ITEM-LIST-1.
259800*    PERFORM 7600-LOCK.
259900
260300*    CALL "DBUPDATE" USING BASE, DSET-DREQQUE, MODE1,
260400*      STATUS-AREA, ALL-ITEMS, BUF-DREQQUE.
           MOVE DRQQ-REQ-NUMBER TO REQNO OF DREQQUE-REQ-O.
           MOVE DRQQ-ORDER TO QUEORDER OF DREQQUE-REQ-O.
           READ DREQQUE-REQ-O INTO BUF-DREQQUE
               INVALID KEY MOVE 17 TO COND-WORD.
           IF FILE-STATUS NOT = "00"
               GO TO 8195-UD-X.

260000     MOVE DE-Q-COMMENT-1           TO   DRQQ-COMMENT-1.
260100     MOVE DE-Q-COMMENT-2           TO   DRQQ-COMMENT-2.
260200
           REWRITE DREQQUE-REQ-REC-O FROM BUF-DREQQUE
             INVALID KEY MOVE 99 TO COND-WORD.
           IF FILE-STATUS NOT = "00"
               MOVE "DBUPDATE REWRITE ERR2 8190-UD" TO BU-DISPLAY-MSG
               PERFORM 2100-BLOWUP.
260800
260900*    PERFORM 7610-UNLOCK.
261000
261100 8195-UD-X.
261200     EXIT.
261300
261400 8200-GET-SCREEN2-FORM.
261500     IF REQI-APPROVE-FLAG = "Y"
261600         MOVE "FREQRLSE2"          TO   VIEW-NFNAME
261700     ELSE
261800         MOVE "REQSCRN2"           TO   VIEW-NFNAME.
262000
262100 8210-GET-SCREEN1-FORM.
262200     IF REQI-APPROVE-FLAG = "Y"
262300         MOVE "FREQRLSE"           TO   VIEW-NFNAME
262400     ELSE
262500         MOVE "REQSCRN1"           TO   VIEW-NFNAME.
262700
262800 8215-GET-MULT-FORM.
262900     IF REQI-APPROVE-FLAG = "Y"
263000         MOVE "FREQRLSE4"          TO   VIEW-NFNAME
263100     ELSE
263200         MOVE "REQSCRN4"           TO   VIEW-NFNAME.
263400
263500 8220-SET-PREV-NEXT-KEYS.
263700     IF PREVIOUS-FLAG = "N"
263800         MOVE "I"                  TO   SRF-FKEY (1)
263900         MOVE SPACES               TO   CLW-1
264000     ELSE
264100         MOVE KEY-PREV             TO   CLW-1.
264300
264500     IF NEXT-FLAG = "N"
264600         MOVE "I"                  TO   SRF-FKEY (2)
264700         MOVE SPACES               TO   CLW-2
264800     ELSE
264900         MOVE KEY-NEXT             TO   CLW-2.
265100
265200 8300-BUYER-NAME.
265300     MOVE DREQD-BUYER-CODE TO BUYER-ARG.
265400*    CALL "DBGET" USING BASE DSET-MBUYER MODE7 STATUS-AREA
265500*                 ALL-ITEMS BUF-MBUYER BUYER-ARG.
           MOVE 0 TO COND-WORD.
           MOVE BUYER-ARG TO BUYERCDE OF MBUYER-REC.
           READ MBUYER INTO BUF-MBUYER
               INVALID KEY MOVE 17 TO COND-WORD.
           IF FILE-STATUS-1 = "2"
               MOVE 17 TO COND-WORD
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD.
265600     IF GOOD-CALL
265700        MOVE BUYER-NAME TO DE-BUYER
265800     ELSE
265900        MOVE SPACES     TO DE-BUYER.
266000 8309-EXIT.  EXIT.
266100
       9000-DBFIND-DREQQUE.
           MOVE 0 TO COND-WORD.
           IF ORIG-OR-EMPL-SEARCH = "EMPLOYEE-ID;"
               MOVE EMPL-ARG TO EMPLOYID OF DREQQUE-EMPL-REC
               START DREQQUE-EMPL KEY = EMPLOYID OF DREQQUE-EMPL-REC
                   INVALID KEY MOVE 17 TO COND-WORD
               END-START
               IF FILE-STATUS NOT = "00"
                   IF FILE-STATUS-1 = "2"
                       MOVE 17 TO COND-WORD
                   ELSE
                       MOVE 99 TO COND-WORD
                   END-IF
               END-IF
           ELSE
           IF ORIG-OR-EMPL-SEARCH = "EMPLOYEE-ORIG;"
               MOVE EMPL-ARG TO EMPLOYORIG OF DREQQUE-ORIG-REC
               START DREQQUE-ORIG KEY = EMPLOYORIG OF DREQQUE-ORIG-REC
                   INVALID KEY MOVE 17 TO COND-WORD
               END-START
               IF FILE-STATUS NOT = "00"
                   IF FILE-STATUS-1 = "2"
                       MOVE 17 TO COND-WORD
                   ELSE
                       MOVE 99 TO COND-WORD
                   END-IF
               END-IF
           ELSE
           IF ORIG-OR-EMPL-SEARCH = "EMPL-ORIG-ST;"
               MOVE EMPL-ARG TO EMPLORIGST OF DREQQUE-ORIG-ST-REC
               START DREQQUE-ORIG-ST KEY = EMPLORIGST
                 OF DREQQUE-ORIG-ST-REC INVALID KEY
                 MOVE 17 TO COND-WORD
               END-START
               IF FILE-STATUS NOT = "00"
                   IF FILE-STATUS-1 = "2"
                       MOVE 17 TO COND-WORD
                   ELSE
                       MOVE 99 TO COND-WORD
                   END-IF
               END-IF
           ELSE
           IF ORIG-OR-EMPL-SEARCH = "EMPL-QUEUED-ST;"
               MOVE EMPL-ARG TO EMPLQUEDST OF DREQQUE-EMPL-ST-REC
               START DREQQUE-EMPL-ST KEY = EMPLQUEDST
                 OF DREQQUE-EMPL-ST-REC INVALID KEY
                 MOVE 17 TO COND-WORD
               END-START
               IF FILE-STATUS NOT = "00"
                   IF FILE-STATUS-1 = "2"
                       MOVE 17 TO COND-WORD
                   ELSE
                       MOVE 99 TO COND-WORD
                   END-IF
               END-IF.

       9010-DBGET-DREQQUE.
           MOVE 0 TO COND-WORD.
           IF ORIG-OR-EMPL-SEARCH = "EMPLOYEE-ID;"
               PERFORM 9011-DBGET-DREQQUE-EMPL
           ELSE
           IF ORIG-OR-EMPL-SEARCH = "EMPLOYEE-ORIG;"
               PERFORM 9012-DBGET-DREQQUE-ORIG
           ELSE
           IF ORIG-OR-EMPL-SEARCH = "EMPL-ORIG-ST;"
               PERFORM 9013-DBGET-DREQQUE-ORIG-ST
           ELSE
           IF ORIG-OR-EMPL-SEARCH = "EMPL-QUEUED-ST;"
               PERFORM 9014-DBGET-DREQQUE-EMPL-ST.

       9011-DBGET-DREQQUE-EMPL.
           MOVE 0 TO COND-WORD.
           READ DREQQUE-EMPL NEXT INTO BUF-DREQQUE
               AT END MOVE 15 TO COND-WORD.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   MOVE 15 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.
           IF EMPLOYID OF DREQQUE-EMPL-REC NOT = EMPL-ARG
               MOVE 15 TO COND-WORD.

       9012-DBGET-DREQQUE-ORIG.
           MOVE 0 TO COND-WORD.
           READ DREQQUE-ORIG NEXT INTO BUF-DREQQUE
               AT END MOVE 15 TO COND-WORD.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   MOVE 15 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.
           IF EMPLOYORIG OF DREQQUE-ORIG-REC NOT = EMPL-ARG
               MOVE 15 TO COND-WORD.

       9013-DBGET-DREQQUE-ORIG-ST.
           MOVE 0 TO COND-WORD.
           READ DREQQUE-ORIG-ST NEXT INTO BUF-DREQQUE
               AT END MOVE 15 TO COND-WORD.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   MOVE 15 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.
           IF EMPLORIGST OF DREQQUE-ORIG-ST-REC NOT = EMPL-ARG
               MOVE 15 TO COND-WORD.

       9014-DBGET-DREQQUE-EMPL-ST.
           MOVE 0 TO COND-WORD.
           READ DREQQUE-EMPL-ST NEXT INTO BUF-DREQQUE
               AT END MOVE 15 TO COND-WORD.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   MOVE 15 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.
           IF EMPLQUEDST OF DREQQUE-EMPL-ST-REC NOT = EMPL-ARG
               MOVE 15 TO COND-WORD.

       COPY DISPCALL IN COPYLIB.
       COPY DISPCAL2  IN COPYLIB.
266200 999-CATREAD.
           IF CATREAD-MSG-NUMBER = ZEROS
               MOVE LANG-SETNUM TO CATREAD-MSG-SET
               MOVE LANG-MSGNUM TO CATREAD-MSG-NUM.
           CALL "CCATREAD" USING CATREAD-PARMS.
           MOVE CATREAD-MSG-TEXT TO MESSAGE-BUFFER.
267800 999-CATREAD-EXIT.
267900     EXIT.
