           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
                   MOVE 17 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.
178600     IF COND-WORD = 17
178700         PERFORM 8000-CORP-NOT-ON-REQ
178800         MOVE 5                    TO   FIELD-NUMBER
178900         GO TO 6490-LFD-X
179000     ELSE
179100     IF COND-WORD NOT = 0
