       7700-UPDATE-DREQITM.
           MOVE REQ-ARG TO REQNO  OF DREQITM-REC-O.
      *    MOVE "0001"  TO ITEMNO OF DREQITM-REC-O.
           MOVE 0 TO COND-WORD.
           START DREQITM-O KEY NOT LESS THAN EXTERNALLY-DESCRIBED-KEY
             INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
              MOVE "START DREQITM 7700-UD" TO BU-DISPLAY-MSG
              PERFORM 2100-BLOWUP.
       7700-LOOP.
           READ DREQITM-O NEXT INTO BUF-DREQITM
             AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS = "10" OR "14" OR "46"
              MOVE 15 TO COND-WORD
           ELSE
           IF FILE-STATUS NOT = "00"
              MOVE 99 TO COND-WORD.
           IF FILE-STATUS = "00"
              IF REQITM-REQ-NUMBER NOT = REQ-ARG
                 MOVE 15 TO COND-WORD.
           IF END-OF-CHAIN
              MOVE HIGH-VALUES TO REQNO OF DREQITM-REC-O
              START DREQITM-O KEY > REQNO OF DREQITM-REC-O
              GO TO 7700-EXIT.
           IF GOOD-CALL
              NEXT SENTENCE
           ELSE
              MOVE "READ NEXT DREQITM 7700-UD" TO BU-DISPLAY-MSG
              PERFORM 2100-BLOWUP.
           MOVE V-TAX-CODE TO REQITM-TAX-CODE.
           MOVE 0 TO COND-WORD.
           REWRITE DREQITM-REC-O FROM BUF-DREQITM
             INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
              MOVE "REWRITE DREQITM 7700-UD" TO BU-DISPLAY-MSG
              PERFORM 2100-BLOWUP.
           GO TO 7700-LOOP.

       7700-EXIT.
           EXIT.

