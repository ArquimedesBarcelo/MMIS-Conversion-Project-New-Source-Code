049600                                   MPLTINFO-COMP,
049700                                   PASS-SPOOL-PRT-NO,
049800                                   ESC-NAME.
049900
050000
050100 0000-BEGIN.
      *------ FOR IBM (EBCDIC), NUMBERS ARE LARGER THAN LETTERS
           IF COMPUTER-ENVIRONMENT = "I"
               MOVE "999999999999" TO BIGGEST-WO
           ELSE
               MOVE "ZZZZZZZZZZZZ" TO BIGGEST-WO.
           MOVE "ZCSISINQ" TO VIEW-CFNAME.
           MOVE 0 TO REQTEMP-LIMIT, REQTEMP-KEY, SAVE-REQTEMP-KEY,
             NUM-14, FIRST-SCRN-REQTEMP, SUB.
           MOVE 1 TO DATE-MODE.
           OPEN INPUT MSTORERM, MREQ, MPLTINFO, MEMPL, MLEVEL, MBUYER
             PER-PERSONNEL, DREQD-REQ, DREQD-WO, DREQITM-REQ,
             DREQITM-CODE, DREQQUE-REQ, DREQQUE-EMPL, DREQQUE-ORIG,
             DREQQUE-EMPL-ST, DREQQUE-ORIG-ST, DPOITEM, MVALIDPLTDATA,
             MREQ-DTE, MVALIDUM-I, MTAX.
           OPEN I-O DREQQUE-REQ-O.
           OPEN I-O DISPLAY-FILE.
           OPEN I-O DREQITM-O.
           MOVE SPACES                   TO   SAVE-VIEW-NFNAME.
           MOVE INQ-CC-INPUT             TO   SAVE-INQ-CC-INPUT.
           MOVE INQ-INQ-FLAG             TO   SAVE-INQ-INQ-FLAG.
050200*    MOVE "RESET REQTEMP"          TO   COMMAND.
050300*    CALL INTRINSIC "COMMAND" USING COMMAND-IMAGE,
050400*      COMMAND-ERROR, COMMAND-PARM.
050500
050600*------ USER HAS TO ENTER HIS ID AND PASSWORD BEFORE HE CAN
050700*------ APPROVE REQS. "A" TELLS VALIDATE FOR APPROVAL CAP.
050800     IF REQI-APPROVE-FLAG = "Y"
050900         MOVE "A"                  TO   EAVALID-TYPE
051000         CALL "SEAVALID" USING     BASE,
051100                                   BASE-MMISA,
051200                                   EAVALID-PARMS,
051300                                   VIEW-COMAREA,
051400                                   LANGUAGE-PARMS,
051500                                   BUF-MEMPL
051600         IF EAVALID-OK NOT = "Y"
051700             GO TO 0010-END.
051800
051900*------ REQ INQUIRY CAN BE CALLED FROM REQ MOD WHICH CAN BE
052000*------ CALLED FROM REQ APPROVE.  THEREFORE HAVE TO USE A DIFF
052100*------ FILE FOR INQUIRE AND APPROVE.
052200*    IF REQI-APPROVE-FLAG NOT = "Y"
052300*        MOVE "FILE REQTEMP=REQTEMP2"   TO   COMMAND
052400*        CALL INTRINSIC "COMMAND" USING COMMAND-IMAGE,
052500*          COMMAND-ERROR, COMMAND-PARM
052600*        IF COMMAND-ERROR NOT = 0
052700*            MOVE "COMMAND ERROR"  TO BU-DISPLAY-MSG
052800*            PERFORM 2100-BLOWUP.
052900*
      *------ CALL CCRTFILE TO CREATE A TEMPORARY FILE 'REQTEMP'
           MOVE "QTEMP"       TO CCRTFILE-LIBRARY.
           IF REQI-APPROVE-FLAG NOT = "Y"
               MOVE "REQTEMP2" TO CCRTFILE-FILE
           ELSE
               MOVE "REQTEMP" TO CCRTFILE-FILE.
           MOVE "0042"        TO CCRTFILE-RECORD-LENGTH.
           MOVE "10000"       TO CCRTFILE-NO-RECORDS.
           MOVE "01000"       TO CCRTFILE-INCREMENT-AMT.
           MOVE "03"          TO CCRTFILE-NO-INCREMENTS.
           CALL "CCRTFILE" USING CCRTFILE-LIBRARY,
                                 CCRTFILE-FILE,
                                 CCRTFILE-RECORD-LENGTH,
                                 CCRTFILE-NO-RECORDS,
                                 CCRTFILE-INCREMENT-AMT,
                                 CCRTFILE-NO-INCREMENTS,
                                 CCRTFILE-STATUS.
           IF CCRTFILE-STATUS NOT = "00"
               MOVE "CCRTFILE CREATE OF 'REQTEMP' FAILED"
                  TO BU-DISPLAY-MSG
               PERFORM 2100-BLOWUP.

           IF REQI-APPROVE-FLAG NOT = "Y"
               MOVE "OVRDBF FILE(REQTEMP) TOFILE(QTEMP/REQTEMP2)"
                 TO COMMAND-WORK
           ELSE
               MOVE "OVRDBF FILE(REQTEMP) TOFILE(QTEMP/REQTEMP)"
                 TO COMMAND-WORK.
           CALL "QCMDEXC" USING COMMAND-WORK, COMMAND-LEN.

053000     PERFORM  1000-HSK  THRU  1990-HSK-X.
053100     PERFORM 6000-MAIN THRU 6990-MAIN-X.
053200
           MOVE "DLTOVR FILE(REQTEMP)" TO COMMAND-WORK.
           CALL "QCMDEXC" USING COMMAND-WORK, COMMAND-LEN.
053300*    IF REQI-APPROVE-FLAG NOT = "Y"
053400*        MOVE "RESET REQTEMP"      TO   COMMAND
053500*        CALL INTRINSIC "COMMAND" USING COMMAND-IMAGE,
053600*          COMMAND-ERROR, COMMAND-PARM.
053700*
053800 0010-END.
           CLOSE MSTORERM, MREQ, MPLTINFO, MEMPL, MLEVEL, MBUYER,
             PER-PERSONNEL, DREQD-REQ, DREQD-WO, DREQITM-REQ,
             DREQITM-CODE, DREQQUE-REQ, DREQQUE-EMPL, DREQQUE-ORIG,
             DREQQUE-EMPL-ST, DREQQUE-ORIG-ST, MVALIDPLTDATA,
             DREQQUE-REQ-O, DPOITEM, DISPLAY-FILE, MREQ-DTE,
             MVALIDUM-I, DREQITM-O, MTAX.
053900     GOBACK.
054000
054100 1000-HSK.
054200     MOVE SPACES                   TO   DE-FIELDS.
054300
054400*    IF BASE-MMISA-1-2 = SPACES
054500*        MOVE "  MMISA;"           TO   BASE-MMISA
054600*        CALL "DBOPEN" USING BASE-MMISA, PASSWORD-MMISA, MODE1,
054700*          STATUS-AREA
054800*        IF COND-WORD NOT = 0
054900*            MOVE "DBOPEN ERROR MMISA " TO BU-DISPLAY-MSG
055000*            PERFORM 2100-BLOWUP.
055100*
055200     MOVE SPACES TO ARGUMENT-VALUES.
055300     MOVE MPLTINFO-COMP            TO   BUF-MPLTINFO.
055400     CALL "TALWONO" USING REQI-WO-NO, ALWO-RET-CODE.
055500
055600*    IF PASS-SPOOL-PRT-NO = 0
055700*        CALL "TSPLPRT" USING SP-RET-CODE, SP-AREA
055800*        MOVE SP-SPOOL-NO (1)      TO   PASS-SPOOL-PRT-NO.
055900*
056000*------ GET REQ GLOBALS IF DON'T HAVE ALREADY
056100     IF PRINT-WO-REQPK = "Y" OR "N"
056200         MOVE REQ-GLOBALS      TO  MPLTINFO-DATA
056300     ELSE
056400     MOVE "RQGB"               TO  PLT-ARG
056500*    CALL "DBGET" USING BASE, DSET-MPLTINFO, MODE7,
056600*      STATUS-AREA, ALL-ITEMS, BUF-MPLTINFO, PLT-ARG
           MOVE 0 TO COND-WORD
           MOVE PLT-ARG TO PLTINFOKEY OF MPLTINFO-REC
           READ MPLTINFO INTO BUF-MPLTINFO
               INVALID KEY MOVE 17 TO COND-WORD
           END-READ
           IF FILE-STATUS-1 = "2"
               MOVE 17 TO COND-WORD
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD
           END-IF
056700     IF GOOD-CALL
056800         MOVE MPLTINFO-RQGB    TO   REQ-GLOBALS
056900     ELSE
057000     IF NO-ENTRY
057100         MOVE "Y"              TO   MPLT-PRINT-WO-REQPK
057200         MOVE "N"              TO   MPLT-WOAP-TO-CUT-REQ
057300         MOVE "N"              TO   MPLT-WOAP-TO-APP-REQ
               MOVE "N"              TO   MPLT-DISPLAY-APP-AMTS
057400     ELSE
057500     MOVE "DBGET ERR MPLT RQGB 1000-H" TO BU-DISPLAY-MSG
057600     PERFORM 2100-BLOWUP.
057700
      *-------- FIND OUT IF PLANT WANTS CURRENCY CODE TO BE SHOWN
      *-------- ON SCREENS.
           MOVE "PREQ"                   TO  PLT-ARG.
           MOVE 0 TO COND-WORD.
           MOVE PLT-ARG TO PLTINFOKEY OF MPLTINFO-REC.
           READ MPLTINFO INTO BUF-MPLTINFO
               INVALID KEY MOVE 17 TO COND-WORD.
           IF FILE-STATUS-1 = "2"
               MOVE 17 TO COND-WORD
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD.
           IF COND-WORD NOT = 0
               MOVE "N"                  TO   SAVE-REQ-CURR-SW
                                              SAVE-REQ-SYNR3-SW
           ELSE
               MOVE MPLTINFO-REQ-SYNR3-SW     TO SAVE-REQ-SYNR3-SW
               IF MPLTINFO-REQ-CURR-SW = SPACES
                   MOVE "N"              TO   SAVE-REQ-CURR-SW
               ELSE
                   MOVE MPLTINFO-REQ-CURR-SW   TO   SAVE-REQ-CURR-SW.

      *-------- GET PLANT'S HOME CURRENCY CODE
           MOVE "CCHM"                   TO  MPLTINFO-ARG.
           MOVE 0 TO COND-WORD.
           MOVE MPLTINFO-ARG TO PLTINFOKEY OF MPLTINFO-REC.
           READ MPLTINFO INTO BUF-MPLTINFO
               INVALID KEY MOVE 17 TO COND-WORD.
           IF FILE-STATUS-1 = "2"
               MOVE 17 TO COND-WORD
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD.
           IF COND-WORD NOT = 0
               MOVE SPACES                  TO   SAVE-HOME-CURRENCY
           ELSE
               MOVE MPLTINFO-HOME-CUR-CODE  TO   SAVE-HOME-CURRENCY.

           MOVE "Y"                      TO  SAVE-PACD-SW.
056400     MOVE "PACD"                   TO  PLT-ARG.
           MOVE PLT-ARG TO PLTINFOKEY OF MPLTINFO-REC.
           READ MPLTINFO INTO BUF-MPLTINFO
               INVALID KEY MOVE 17 TO COND-WORD
           END-READ
056700     IF GOOD-CALL
056800         MOVE MPLTINFO-PACD-SW     TO   SAVE-PACD-SW.

057800*------ IF THIS PROGRAM IS BEING USED AS REQ RELEASE PROG,
057900*------ HAVE TO GET THE REQ PRINTER TO RELEASE THE REQ TO
058000     IF REQI-APPROVE-FLAG = "Y"
058100         PERFORM 2000-GET-REQ-PRINTER THRU 2010-GRP-X.
058200
058300*------ LOAD UP SOME LITERALS FOR SCREEN AND FUNCTION KEYS FROM
058400*------ MESSAGE CATALOG.
058500*    "F8-PO INQ       "
058600     MOVE  16 TO LANG-SETNUM.
058700     MOVE 120 TO LANG-MSGNUM.
058800     PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
058900     MOVE MESSAGE-BUFFER           TO   KEY-POPTION.
060000*    "F1-PREV         "
060100     MOVE  16 TO LANG-SETNUM.
060200     MOVE 121 TO LANG-MSGNUM.
060300     PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
060400     MOVE MESSAGE-BUFFER           TO   KEY-PREV.
060500*    "F2-NEXT         "
060600     MOVE  14 TO LANG-SETNUM.
060700     MOVE  59 TO LANG-MSGNUM.
060800     PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
060900     MOVE MESSAGE-BUFFER           TO   KEY-NEXT.
061000*    "HOLD STATUS : "
061100     MOVE   8 TO LANG-SETNUM.
061200     MOVE   7 TO LANG-MSGNUM.
061300     PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
061400     MOVE MESSAGE-BUFFER           TO   HOLD-STAT-MSG1.
061500
061600*------ THE "RELEASE REQ" KEY WILL BE USED ONLY IF THIS PROGRAM
061700*------ IS IN RELEASE REQ MODE
061800     IF REQI-APPROVE-FLAG = "Y"
061900*        "F8-APPROVE     "
062000         MOVE  18 TO LANG-SETNUM
062100         MOVE  26 TO LANG-MSGNUM
062200         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
062300         MOVE MESSAGE-BUFFER       TO   KEY-APPROVE.
062400
062500*------ IF DISPLAYING WO AMOUNTS (APPROVED, COMMITTED, REQ NOT
062600*------ PURCH, AVAIL), LOAD UP NEEDED LITERALS FOR SCREEN
062700     IF DISP-WO-AMTS = "Y"
062800*        "APP"
062900         MOVE   1 TO LANG-SETNUM
063000         MOVE  36 TO LANG-MSGNUM
063100         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
063200         MOVE MESSAGE-BUFFER       TO   APP-LIT
063300*        "COMT"
063400         MOVE   3 TO LANG-SETNUM
063500         MOVE 175 TO LANG-MSGNUM
063600         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
063700         MOVE MESSAGE-BUFFER       TO   COMT-LIT
063800*        "REQ"
063900         MOVE  18 TO LANG-SETNUM
064000         MOVE  87 TO LANG-MSGNUM
064100         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
064200         MOVE MESSAGE-BUFFER       TO   REQ-LIT
064300*        "AVAIL"
064400         MOVE   1 TO LANG-SETNUM
064500         MOVE  37 TO LANG-MSGNUM
064600         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
064700         MOVE MESSAGE-BUFFER       TO   AVAIL-LIT.
064800
064900     MOVE SPACES                   TO   SAVE-DE-FIELDS.
065000     MOVE "S"                      TO   SAVE-REQS-PER-SCRN.
065100     IF REQI-APPROVE-FLAG = "Y"
065200         MOVE "5"                  TO   SAVE-SORT-KEY
065300         MOVE "X"                  TO   SAVE-INCLUDE-UNAPPROVED
               MOVE "X"                  TO   SAVE-INCLUDE-CODED-STORE
065400         MOVE "X"                  TO   SAVE-INCLUDE-CODED-NONSTR
065500         MOVE "X"                  TO   SAVE-INCLUDE-NON-CODED
065600         MOVE "X"                  TO   SAVE-EXCLUDE-YOU-APPROVE
065700         MOVE MEMPL-EMPL           TO   SAVE-APPROVER
065800     ELSE
065900         MOVE "5"                  TO   SAVE-SORT-KEY
066000         MOVE "X"                  TO   SAVE-INCLUDE-UNAPPROVED
066100         MOVE "X"                  TO   SAVE-INCLUDE-IN-PURCH
066200         MOVE "X"                  TO   SAVE-INCLUDE-ON-PO
066300         MOVE "X"                  TO   SAVE-INCLUDE-CODED-STORE
066400         MOVE "X"                  TO   SAVE-INCLUDE-CODED-NONSTR
066500         MOVE "X"                  TO   SAVE-INCLUDE-NON-CODED.
066600
066700*------ THE NEXT STEPS ARE DONE ONLY FOR REQ APPROVALS, WHERE
066800*------ AN EMPLOYEE ID MUST BE ENTERED (NOT REQ INQUIRY).
066900     IF REQI-APPROVE-FLAG NOT = "Y"
067000         GO TO 1990-HSK-X.
067100
067200*------ JUST IN CASE THE ACTIVE FLAG IS SCREWED UP, MAKE SURE
067300*------ THE EMPL IS THE ACTIVE ONE AT HIS LEVEL.
067400     MOVE MEMPL-LEVEL              TO   LEVEL-ARG.
067500*    CALL "DBGET" USING BASE, DSET-MLEVEL, MODE7, STATUS-AREA,
067600*      ALL-ITEMS, BUF-MLEVEL, LEVEL-ARG.
           MOVE 0 TO COND-WORD.
           MOVE LEVEL-ARG TO LEVELNUM OF MLEVEL-REC.
           READ MLEVEL INTO BUF-MLEVEL
               INVALID KEY MOVE 17 TO COND-WORD.
           IF FILE-STATUS-1 = "2"
               MOVE 17 TO COND-WORD
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD.
067700     IF NOT GOOD-CALL
067800         MOVE "DBGET ERR MLEVEL 1000-H" TO BU-DISPLAY-MSG
067900         PERFORM 2100-BLOWUP.
068000
068100*------ IF THE EMPL WAS INACTIVE, GETTING INTO THIS PGM SIGNALS
068200*------ THAT HE IS ACTIVE AGAIN.  WE NEED TO REACTIVATE HIM
068300*------ (WHICH WILL ALSO DEACTIVATE HIS ALTERNATE FROM THAT LEV).
068400     IF MEMPL-ACTIVE-FLAG = "N"
068500       OR (MEMPL-EMPL NOT = MLEVEL-ACTIVE-EMPL)
068600*        *** UPDATE CURRENT MEMPL TO ACTIVE
068700         MOVE MEMPL-EMPL           TO   CEAU-EMPL
068800         MOVE "N"                  TO   CEAU-OLD-ACTIVE
068900         MOVE "Y"                  TO   CEAU-CURRENT-ACTIVE
069000         MOVE MEMPL-LEVEL          TO   CEAU-OLD-LEVEL,
069100                                        CEAU-CURRENT-LEVEL
069200         MOVE "Y"                  TO   CEAU-UPDATE-MEMPL-FLAG
069300         CALL "CEAUPEMP" USING BASE, STATUS-AREA, CEAUPEMP-PARMS,
069400           BU-DISPLAY-MSG
069500         IF BU-DISPLAY-MSG-1 NOT = SPACES
069600             PERFORM 2100-BLOWUP.
069700
069800*------ IF THIS EMPL WAS NOT ACTIVE AT HIS OWN LEVEL, CHANGE
069900*------ ALL UNAPPROVED REQS QUEUED TO THE OLD ACTIVE EMPL
070000*------ AT THIS LEVEL BACK TO HIM: BUT ONLY THOSE ENTRIES
070100*------ IN DREQQUE QUEUED TO THIS EMPL'S LEVEL.  (IE, THE
070200*------ ALTERNATE MAY HAVE SOME REQS QUEUED TO HIM AT HIS
070300*------ OWN LEVEL, AND SOME AT THE LEVEL HE IS SUBBING FOR).
070400     IF MLEVEL-ACTIVE-EMPL = MEMPL-EMPL
070500         NEXT SENTENCE
070600     ELSE
070700         CALL "CEAQCHG" USING BASE, STATUS-AREA, BU-DISPLAY-MSG,
070800           MLEVEL-ACTIVE-EMPL, MEMPL-EMPL, MEMPL-LEVEL.
070900
071100 1990-HSK-X.
071200     EXIT.
071300
071400 2000-GET-REQ-PRINTER.
071500     IF GOT-REQ-PRT-NUM = "Y"
071600         GO TO 2010-GRP-X.
071700
071800     MOVE "Y"                      TO   GOT-REQ-PRT-NUM.
071900
072000*------ THE KEY "RQRL" TELLS US WHERE TO PRINT.  THE
072100*------ FOLLOWING ARE THE POSSIBILITIES:
072200*------   1. PRINT ON PURCH PRINTER     -   "RQRL" DOES NOT EXIST
072300*------   2. PRINT AT LOCAL PRINTER     -   "RQRL" - "LOCAL"
072400*------   3. DO NOT PRINT               -   "RQRL" - "NOPRT"
072500
072600     MOVE "RQRL"                   TO  PLT-ARG.
072700*    CALL "DBGET" USING BASE, DSET-MPLTINFO, MODE7,
072800*      STATUS-AREA, ALL-ITEMS, BUF-MPLTINFO, PLT-ARG.
      *------ NOTE: FOR IBM A PRINT NUM OF ZERO MEANS LOCAL PRINTER.
           MOVE 0 TO COND-WORD.
           MOVE PLT-ARG TO PLTINFOKEY OF MPLTINFO-REC.
           READ MPLTINFO INTO BUF-MPLTINFO
               INVALID KEY MOVE 17 TO COND-WORD.
072900     IF FILE-STATUS-1 = "2"
073000         MOVE "L" TO PRINT-FLAG
           ELSE
073200     IF FILE-STATUS = "00"
073300        IF REQ-RLSE-PRINT-CONTROL = "PURCH"
073400            MOVE "P" TO PRINT-FLAG
073500        ELSE
073600         IF REQ-RLSE-PRINT-CONTROL = "LOCAL"
073700             MOVE 0                 TO  REQ-APP-PRT-NUM-9
                   MOVE "L" TO PRINT-FLAG
073800             GO TO 2010-GRP-X
073900         ELSE
074000         IF REQ-RLSE-PRINT-CONTROL = "NOPRT"
074100             MOVE "N" TO PRINT-FLAG
074200             GO TO 2010-GRP-X
074300         ELSE
074400             MOVE 0                 TO  REQ-APP-PRT-NUM-9
                   MOVE "L" TO PRINT-FLAG
074500             GO TO 2010-GRP-X
074600     ELSE
074700        MOVE "DBGET ERR MPLT1 76-GPP" TO BU-DISPLAY-MSG
074800        PERFORM 2100-BLOWUP.
074900
075000*------ PRINT AT THE BLANK FORM PO PRINTER, IF THE KEY
075100*------ DOES NOT EXIST IN DATABASE, PRINT TO LOCAL PRINTER
075200     MOVE "POPT"                   TO  PLT-ARG.
075300*    CALL "DBGET" USING BASE, DSET-MPLTINFO, MODE7,
075400*      STATUS-AREA, ALL-ITEMS, BUF-MPLTINFO,
075500*      PLT-ARG.
           MOVE 0 TO COND-WORD.
           MOVE PLT-ARG TO PLTINFOKEY OF MPLTINFO-REC.
           READ MPLTINFO INTO BUF-MPLTINFO
               INVALID KEY MOVE 17 TO COND-WORD.
           IF FILE-STATUS-1 = "2"
               MOVE 17 TO COND-WORD
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD.
075600     IF COND-WORD = 17
075700         MOVE ZERO                 TO   REQ-APP-PRT-NUM-9
075800     ELSE
075900     IF COND-WORD = ZERO
               IF MPLTINFO-REQ-PRT-NO NUMERIC
                   MOVE MPLTINFO-REQ-PRT-NO TO REQ-APP-PRT-NUM-9
               ELSE
076000             MOVE ZERO                TO REQ-APP-PRT-NUM-9
076100     ELSE
076200         MOVE "DBGET ERR MPLT 76-GET-REQ-PRINTER"
076300           TO BU-DISPLAY-MSG
076400         PERFORM 2100-BLOWUP.
076500
076600 2010-GRP-X.
076700     EXIT.
076800
076900 2100-BLOWUP.
077000     MOVE "SMREQINQ"               TO   BU-PGM-NAME.
077100     IF REQI-REQ-NO NOT = SPACES
077200         MOVE REQI-REQ-NO          TO   BU-DISPLAY-FLD (1)
077300     ELSE
077400     IF REQI-CORP-CODE NOT = SPACES
077500         MOVE REQI-CORP-CODE       TO   BU-DISPLAY-FLD (1)
077600     ELSE
077700         MOVE REQI-WO-NO           TO   BU-DISPLAY-FLD (1).
077800     MOVE MREQ-NUMBER              TO   BU-DISPLAY-FLD (2).
077900     MOVE DREQD-WO-NUMBER          TO   BU-DISPLAY-FLD (3).
078000     MOVE DREQD-PO-RCV-NO          TO   BU-DISPLAY-FLD (4).
078100     MOVE REQITM-CORP-CODE         TO   BU-DISPLAY-FLD (5).
078200     MOVE REQTEMP-KEY              TO   BU-DISPLAY-FLD9 (1).
078300     CALL "TBLOWUP" USING BASE, BU-PGM-NAME, STATUS-AREA,
078400       VIEW-COMAREA, FILE-STATUS, BU-DISPLAY-MSG,
078500       BU-DISPLAY-FLDS.
078600
083500 4030-SETERROR.
           MOVE B"1" TO IND (99).
           MOVE B"1" TO IND (FIELD-NUMBER).
           MOVE MESSAGE-BUFFER TO DE-MESSAGE-LINE-1,
051300                            DE-MESSAGE-LINE-2.
084200
       4100-CALL-CSWITCHF.
           CALL "CSWITCHF" USING VIEW-COMAREA, LANGUAGE-PARMS,
             FORMFILE, CSF-PARMS, BU-DISPLAY-MSG.

