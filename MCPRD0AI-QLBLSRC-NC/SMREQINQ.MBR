           IF DE-ACCT-INFO = SAVE-ACCT-INFO
               GO TO 8106-CHECK-ADDL-INFO.
           MOVE SPACES                   TO   VALID-ARG.
           MOVE "DP"                     TO   VALID-ARG-1-2.
235800     MOVE DE-SUBD                  TO   CMR-FOR-DEPT,
                                              VALID-ARG-3-10.
           MOVE VALID-ARG                TO   VALDTAKEY OF
                                              MVALIDPLTDATA-REC.
           READ MVALIDPLTDATA INTO BUF-MVALIDPLTDATA
               INVALID KEY    MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE  9                   TO   LANG-SETNUM
               MOVE 43                   TO   LANG-MSGNUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE 15                   TO   FIELD-NUMBER
               PERFORM 4030-SETERROR
               MOVE DE-FIELDS-2          TO   DISPLAY-REC
      *--------- SHOULD CURRENCY BE DISPLAYED ON SCREEN?
               IF SAVE-REQ-CURR-SW = "N"
                   MOVE B"1" TO IND(40)
               END-IF
      *--------- SHOULD ADDITIONAL INFO FIELD BE AN INPUT FIELD?
               IF SAVE-REQ-SYNR3-SW = "Y"
                   MOVE B"1" TO IND (18)
               END-IF
               PERFORM 998-WRITE-SCREEN THRU 998-READ-SCREEN
               MOVE DISPLAY-REC          TO   DE-FIELDS-2
               MOVE SPACES               TO   DE-MESSAGE-LINE-1,
                                              DE-MESSAGE-LINE-2
               IF VIEW-LASTKEY = 3
                   GO TO 8107-UAI-X
               ELSE
               GO TO 8105-CHECK-DEPT.
       8106-CHECK-ADDL-INFO.
           IF SAVE-REQ-SYNR3-SW = "Y" AND V-ADDL-INFO > SPACES
               MOVE SPACES                   TO   VALID-ARG
               MOVE "NW"                     TO   VALID-ARG-1-2
235800         MOVE V-ADDL-INFO              TO   VALID-ARG-3-10
               MOVE VALID-ARG                TO   VALDTAKEY OF
                                                  MVALIDPLTDATA-REC
               READ MVALIDPLTDATA INTO BUF-MVALIDPLTDATA
                   INVALID KEY    MOVE FILE-STATUS TO FILE-STATUS
               END-READ
               IF FILE-STATUS NOT = "00"
                   MOVE  9                   TO   LANG-SETNUM
                   MOVE 71                   TO   LANG-MSGNUM
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE 17                   TO   FIELD-NUMBER
                   PERFORM 4030-SETERROR
                   MOVE DE-FIELDS-2          TO   DISPLAY-REC
      *-------------- SHOULD CURRENCY BE DISPLAYED ON SCREEN?
                   IF SAVE-REQ-CURR-SW = "N"
                       MOVE B"1" TO IND(40)
                   END-IF
      *-------------- SHOW ADDITIONAL INFO FIELD AS AN INPUT FIELD
                   MOVE B"1" TO IND (18)
                   PERFORM 998-WRITE-SCREEN THRU 998-READ-SCREEN
                   MOVE DISPLAY-REC          TO   DE-FIELDS-2
                   MOVE SPACES               TO   DE-MESSAGE-LINE-1,
                                                  DE-MESSAGE-LINE-2
                   IF VIEW-LASTKEY = 3
