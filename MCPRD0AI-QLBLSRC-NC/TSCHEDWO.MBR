                   MOVE S-UP-REM-HOLD-1 TO S-UP-REM-HOLD-2
                   MOVE S-UP-REM        TO S-UP-REM-HOLD-1
                   MOVE H-LINE-2        TO LINE-UP2
                   PERFORM 63-EDIT-DATA THRU 63-ED-EXIT
                   IF IND(99) = TRUE-VAL
                       ADD 08  TO FIELD-NUMBER
                       MOVE TRUE-VAL TO IND(FIELD-NUMBER)
                       GO TO 6-MAIN-CONT
                   ELSE
                   IF ADD-SW = 1
                       PERFORM 63-PUT-DATA
                       PERFORM 63-ADD-DATA THRU 63-AD-EXIT
                       IF IND(99) = TRUE-VAL
                           ADD 08  TO FIELD-NUMBER
                           MOVE TRUE-VAL TO IND(FIELD-NUMBER)
                           GO TO 6-MAIN-CONT
                       ELSE
                           MOVE SPACES TO LINE-2 H-LINE-2
                                          LINE-UP LINE-UP2
                   ELSE
                   IF SPACES = H-2-MM AND H-2-DD AND H-2-YY AND
                       H-2-SHIFT AND H-2-QTY AND H-2-CRAFT
                           AND H-2-HRS AND H-2-REM
                           PERFORM 63-PUT-DATA
                           PERFORM 63-ADD-DATA THRU 63-AD-EXIT
                           IF IND(99) = TRUE-VAL
