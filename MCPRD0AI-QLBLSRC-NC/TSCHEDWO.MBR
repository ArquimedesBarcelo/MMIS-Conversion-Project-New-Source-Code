       IDENTIFICATION DIVISION.
       PROGRAM-ID.             TSCHEDWO.
       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.
       SOURCE-COMPUTER.        IBM-AS400.
       OBJECT-COMPUTER.        IBM-AS400.
      *C---------------------------------------------------------------
      *C 02/25/93 JSB REQ #6306
      *C     ADDED "PR" AS A NEW WO STATUS FOR PRE-RELEASE.
      *C---------------------------------------------------------------

       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT DISPLAY-FILE
                  ASSIGN       TO WORKSTATION-ZSCHDULE-SI
                  ORGANIZATION IS TRANSACTION
                  ACCESS MODE  IS SEQUENTIAL
                  FILE STATUS  IS SCREEN-STATUS
                               MAJOR-MINOR
                  CONTROL-AREA IS SCREEN-CONTROL.

           SELECT WO-CRAFTS-REQD
                  ASSIGN       TO DATABASE-MCFLMM0601
                  ORGANIZATION IS INDEXED
                  ACCESS MODE  IS DYNAMIC
                  RECORD KEY   IS EXTERNALLY-DESCRIBED-KEY
                  FILE STATUS  IS FILE-STAT.

           SELECT WO-LAST-NUM-USED
                  ASSIGN       TO DATABASE-MCFPMM0800
                  ORGANIZATION IS RELATIVE
                  ACCESS MODE  IS RANDOM
                  RELATIVE KEY IS ARG-NO
                  FILE STATUS  IS FILE-STAT.

           SELECT WO-PLANNED
                  ASSIGN       TO DATABASE-MCFLMM1101
                  ORGANIZATION IS INDEXED
                  ACCESS MODE  IS DYNAMIC
                  RECORD KEY   IS EXTERNALLY-DESCRIBED-KEY
                               WITH DUPLICATES
                  FILE STATUS  IS FILE-STAT.

           SELECT WO-SCHEDULE
                  ASSIGN       TO DATABASE-MCFLMM2302
                  ORGANIZATION IS INDEXED
                  ACCESS MODE  IS DYNAMIC
                  RECORD KEY   IS EXTERNALLY-DESCRIBED-KEY
                               WITH DUPLICATES
                  FILE STATUS  IS FILE-STAT.

           SELECT OUT-FILE
                  ASSIGN       TO DATABASE-OUTSCHDS
                  ORGANIZATION IS RELATIVE
                  ACCESS MODE  IS RANDOM
                  RELATIVE KEY IS ACT-KEY
                  FILE STATUS  IS FILE-STAT.

           SELECT SORT-FILE
                  ASSIGN       TO DISK-SORTFILE.

       DATA DIVISION.
       FILE SECTION.
       FD  DISPLAY-FILE
           LABEL RECORDS       ARE OMITTED.
       01  DISPLAY-REC         PIC X(2000).

       FD  WO-CRAFTS-REQD
           LABEL RECORDS       ARE STANDARD
           DATA RECORD         IS WCRFREC.
       01  WCRFREC.
           COPY DDS-ALL-FORMATS OF MCFLMM0601.

       FD  WO-LAST-NUM-USED
           LABEL RECORDS       ARE STANDARD
           DATA RECORD         IS WLNUREC.
       01  WLNUREC.
           COPY DDS-ALL-FORMATS OF MCFPMM0800.

       FD  WO-PLANNED
           LABEL RECORDS       ARE STANDARD
           DATA RECORD         IS WPFREC.
       01  WPFREC.
           COPY DDS-ALL-FORMATS OF MCFLMM1101.

       FD  WO-SCHEDULE
           LABEL RECORDS       ARE STANDARD
           DATA RECORD         IS WSFREC.
       01  WSFREC.
           COPY DDS-ALL-FORMATS OF MCFLMM2302.

       FD  OUT-FILE RECORD     CONTAINS 48 CHARACTERS
           LABEL RECORDS       ARE OMITTED
           DATA RECORD         IS OUT-REC.
       01  OUT-REC.
           05  OUT-DATA.
               10  OUT-DATE.
                   15  OUT-CC  PIC XX.
                   15  OUT-YY  PIC XX.
                   15  OUT-MM  PIC XX.
                   15  OUT-DD  PIC XX.
               10  OUT-SHIFT   PIC X.
               10  OUT-QTY     PIC XX.
               10  OUT-CRAFT   PIC XX.
               10  OUT-HRS.
                   15  OUT-HM  PIC 999V9.
               10  OUT-REM     PIC X(30).
               10  OUT-SHIFT-ID PIC X.

       SD  SORT-FILE RECORD    CONTAINS 48 CHARACTERS
           DATA RECORD         IS SORT-REC.
       01  SORT-REC.
           05  SORT-DATE.
               10  SORT-CC     PIC XX.
               10  SORT-YY     PIC XX.
               10  SORT-MM     PIC XX.
               10  SORT-DD     PIC XX.
           05  SORT-SHIFT      PIC X.
           05  SORT-QTY        PIC XX.
           05  SORT-CRAFT      PIC XX.
           05  SORT-HRS.
               10  SORT-HM     PIC 999V9.
           05  SORT-REM        PIC X(30).
           05  SORT-SHIFT-ID   PIC X.

       WORKING-STORAGE SECTION.
       77  ACT-KEY             PIC 9(9).
       77  ADD-SW              PIC 9  VALUE 0.
       77  ARG-NO              PIC 9(9).
       77  CRAFT-BUF           PIC X(02).
       77  EOF-SW              PIC 9  VALUE 0.
       77  FIELD-NUMBER        PIC S9(4) COMP-4.
       77  MAX-KEY             PIC 9(9).
       77  RTN-CODE            PIC X.
       77  WO-HOLD             PIC X(25).
       77  WO-YR-HOLD          PIC X  VALUE SPACE.
       77  YEAR-DISP           PIC X  VALUE SPACE.
       77  SCREEN-SAVE         PIC X(10).
       77  TRUE-VAL            PIC 1 VALUE B"1".
       77  ERROR-BUFFER        PIC X(80).

       01  PASSWORD-INFORMATION.
           05  NAME-OF-PROGRAM     PIC X(08) VALUE "TSCHEDWO".
           05  PROGRAM-TYPE        PIC X(02) VALUE "UP".
           05  PROGRAM-RELEASE     PIC X(12) VALUE " J0100010001".
           05  PROGRAM-DESCRIPTION.
               10  PROG-DESC-A.
                   15  FILLER      PIC X(15) VALUE "ALLOWS USER TO ".
                   15  FILLER      PIC X(17) VALUE "ADD, MODIFY, AND ".
                   15  FILLER      PIC X(17) VALUE "DELETE RECORDS IN".
                   15  FILLER      PIC X(11) VALUE " PLANNED  ".
               10  PROG-DESC-B.
                   15  FILLER      PIC X(15) VALUE "W/O SCHEDULING ".
                   15  FILLER      PIC X(45) VALUE "SYSTEM ".
               10  PROG-FUNCTION.
                   15  FILLER      PIC X(11) VALUE "ELECTRONIC ".
                   15  FILLER      PIC X(13) VALUE "NOTEBOOK FOR ".
                   15  FILLER      PIC X(17) VALUE "PLANNERS TO KEEP ".
                   15  FILLER      PIC X(09) VALUE "TRACK OF ".
                   15  FILLER      PIC X(10) VALUE "SCHEDULES ".
           05  PASSWORD-FLAG       PIC X.

       01  FILE-STAT.
           05  FILE-STAT-1     PIC X.
           05  FILE-STAT-2     PIC X.

       01  CUR-DATE-WA.
           02  CUR-DATE-YY.
               03  FILLER      PIC X.
               03  CUR-DATE-YR PIC X.
           02  CUR-DATE-MM     PIC XX.
           02  CUR-DATE-DD     PIC XX.

       01  CURR-DATE-99.
           05  CURR-CT-99      PIC 99.
           05  CURR-YR-99      PIC 99.
           05  CURR-MO-99      PIC 99.
           05  CURR-DY-99      PIC 99.

       01  DATE-COMPARE.
           05  DATE-99-CC      PIC 99.
           05  DATE-99-YY      PIC 99.
           05  DATE-99-MM      PIC 99.
           05  DATE-99-DD      PIC 99.

       01  DATE-HOLD.
           05  DH-MM           PIC XX.
           05  DH-DD           PIC XX.
           05  DH-YY           PIC XX.

       01  SCH-DATE-99.
           05  SCH-DATE-99-CC  PIC 99.
           05  SCH-DATE-99-YY  PIC 99.
           05  SCH-DATE-99-MM  PIC 99.
           05  SCH-DATE-99-DD  PIC 99.

       01  HOLD-BUFFER.
           05  H-LINE-1.
               10  H-1-DATE.
                   15  H-1-MM  PIC XX.
                   15  H-1-DD  PIC XX.
                   15  H-1-YY  PIC XX.
               10  H-1-SHIFT   PIC X.
               10  H-1-QTY     PIC XX.
               10  H-1-CRAFT   PIC XX.
               10  H-1-HRS.
                   15  H-1-HM  PIC 999V9.
               10  H-1-REM     PIC X(30).
           05  H-LINE-2.
               10  H-2-DATE.
                   15  H-2-MM  PIC XX.
                   15  H-2-DD  PIC XX.
                   15  H-2-YY  PIC XX.
               10  H-2-SHIFT   PIC X.
               10  H-2-QTY     PIC XX.
               10  H-2-CRAFT   PIC XX.
               10  H-2-HRS.
                   15  H-2-HM  PIC 999V9.
               10  H-2-REM     PIC X(30).
           05  H-LINE-3.
               10  H-3-DATE.
                   15  H-3-MM  PIC XX.
                   15  H-3-DD  PIC XX.
                   15  H-3-YY  PIC XX.
               10  H-3-SHIFT   PIC X.
               10  H-3-QTY     PIC XX.
               10  H-3-CRAFT   PIC XX.
               10  H-3-HRS.
                   15  H-3-HM  PIC 999V9.
               10  H-3-REM     PIC X(30).
           05  H-LINE-4.
               10  H-4-DATE.
                   15  H-4-MM  PIC XX.
                   15  H-4-DD  PIC XX.
                   15  H-4-YY  PIC XX.
               10  H-4-SHIFT   PIC X.
               10  H-4-QTY     PIC XX.
               10  H-4-CRAFT   PIC XX.
               10  H-4-HRS.
                   15  H-4-HM  PIC 999V9.
               10  H-4-REM     PIC X(30).
           05  H-LINE-5.
               10  H-5-DATE.
                   15  H-5-MM  PIC XX.
                   15  H-5-DD  PIC XX.
                   15  H-5-YY  PIC XX.
               10  H-5-SHIFT   PIC X.
               10  H-5-QTY     PIC XX.
               10  H-5-CRAFT   PIC XX.
               10  H-5-HRS.
                   15  H-5-HM  PIC 999V9.
               10  H-5-REM     PIC X(30).
           05  H-LINE-6.
               10  H-6-DATE.
                   15  H-6-MM  PIC XX.
                   15  H-6-DD  PIC XX.
                   15  H-6-YY  PIC XX.
               10  H-6-SHIFT   PIC X.
               10  H-6-QTY     PIC XX.
               10  H-6-CRAFT   PIC XX.
               10  H-6-HRS.
                   15  H-6-HM  PIC 999V9.
               10  H-6-REM     PIC X(30).

       01  LINE-UP.
           05  S-UP-DATE.
               10  S-UP-MM     PIC XX.
               10  S-UP-DD     PIC XX.
               10  S-UP-YY     PIC XX.
           05  S-UP-SHIFT      PIC X.
           05  S-UP-QTY.
               10  S-UP-QTY1   PIC X.
               10  S-UP-QTY2   PIC X.
           05  S-UP-CRAFT      PIC XX.
           05  S-UP-HRS.
               10  S-UP-HM     PIC 999V9.
           05  S-UP-REM.
               10  S-UP-REM-2  PIC X(02).
               10  S-UP-REM-28 PIC X(28).

       01  LINE-UP2.
           05  S-UP2-DATE.
               10  S-UP2-MM     PIC XX.
               10  S-UP2-DD     PIC XX.
               10  S-UP2-YY     PIC XX.
           05  S-UP2-SHIFT      PIC X.
           05  S-UP2-QTY.
               10  S-UP2-QTY1   PIC X.
               10  S-UP2-QTY2   PIC X.
           05  S-UP2-CRAFT      PIC XX.
           05  S-UP2-HRS.
               10  S-UP2-HM     PIC 999V9.
           05  S-UP2-REM        PIC X(30).

       01  S-UP-REM-HOLD.
           05  S-UP-REM-HOLD-1 PIC X(30).
           05  S-UP-REM-HOLD-2 PIC X(30).

       01  S-UP-WA.
           05  S-UP-H.
               10  S-UP-H1     PIC X.
               10  S-UP-H2     PIC X.
               10  S-UP-H3     PIC X.
           05  S-UP-T          PIC X.

       01  SCREEN-DATA.
           05  WO-DATA.
               10  S-WO-NUM.
                   15  WO-NUM-S PIC X(06).
                   15  WO-YR  PIC X.
                   15  WO-SUF PIC X(03).
               10  WO-EQUIP   PIC X(06).
               10  S-DATE.
                   15  S-MM   PIC XX.
                   15  S-DD   PIC XX.
                   15  S-YY   PIC XX.
               10  S-SHIFT    PIC X.
           05  DATA-BUFFER.
               10  LINE-1.
                   15  S-1-DATE.
                       20  S-1-MM     PIC XX.
                       20  S-1-DD     PIC XX.
                       20  S-1-YY     PIC XX.
                   15  S-1-SHIFT      PIC X.
                   15  S-1-QTY        PIC XX.
                   15  S-1-CRAFT      PIC XX.
                   15  S-1-HRS.
                       20  S-1-HM     PIC 999V9.
                   15  S-1-REM        PIC X(30).
               10  LINE-2.
                   15  S-2-DATE.
                       20  S-2-MM     PIC XX.
                       20  S-2-DD     PIC XX.
                       20  S-2-YY     PIC XX.
                   15  S-2-SHIFT      PIC X.
                   15  S-2-QTY        PIC XX.
                   15  S-2-CRAFT      PIC XX.
                   15  S-2-HRS.
                       20  S-2-HM     PIC 999V9.
                   15  S-2-REM        PIC X(30).
               10  LINE-3.
                   15  S-3-DATE.
                       20  S-3-MM     PIC XX.
                       20  S-3-DD     PIC XX.
                       20  S-3-YY     PIC XX.
                   15  S-3-SHIFT      PIC X.
                   15  S-3-QTY        PIC XX.
                   15  S-3-CRAFT      PIC XX.
                   15  S-3-HRS.
                       20  S-3-HM     PIC 999V9.
                   15  S-3-REM        PIC X(30).
               10  LINE-4.
                   15  S-4-DATE.
                       20  S-4-MM     PIC XX.
                       20  S-4-DD     PIC XX.
                       20  S-4-YY     PIC XX.
                   15  S-4-SHIFT      PIC X.
                   15  S-4-QTY        PIC XX.
                   15  S-4-CRAFT      PIC XX.
                   15  S-4-HRS.
                       20  S-4-HM     PIC 999V9.
                   15  S-4-REM        PIC X(30).
               10  LINE-5.
                   15  S-5-DATE.
                       20  S-5-MM     PIC XX.
                       20  S-5-DD     PIC XX.
                       20  S-5-YY     PIC XX.
                   15  S-5-SHIFT      PIC X.
                   15  S-5-QTY        PIC XX.
                   15  S-5-CRAFT      PIC XX.
                   15  S-5-HRS.
                       20  S-5-HM     PIC 999V9.
                   15  S-5-REM        PIC X(30).
               10  LINE-6.
                   15  S-6-DATE.
                       20  S-6-MM     PIC XX.
                       20  S-6-DD     PIC XX.
                       20  S-6-YY     PIC XX.
                   15  S-6-SHIFT      PIC X.
                   15  S-6-QTY        PIC XX.
                   15  S-6-CRAFT      PIC XX.
                   15  S-6-HRS.
                       20  S-6-HM     PIC 999V9.
                   15  S-6-REM        PIC X(30).
           05  NOTE-DATA              PIC X(76).
           05  SCREEN-CMD-LINE        PIC X(79).
           05  SCREEN-ERR-LINE        PIC X(79).

       01  SHIFT-DATA.
           05  ZONE-BUF        PIC X(04).
           05  TIME-IN.
               10  HRS-IN      PIC 99.
               10  MIN-IN      PIC 99.
           05  CODE-BUF        PIC X.
           05  SHIFTS.
               10  S-1         PIC 9999.
               10  E-1         PIC 9999.
               10  S-2         PIC 9999.
               10  E-2         PIC 9999.
               10  S-3         PIC 9999.
               10  E-3         PIC 9999.
               10  S-4         PIC 9999.
               10  E-4         PIC 9999.
           05  CURR-SHIFT      PIC 9.

       01  WO-DELETE-DATA.
           05  S-H-ZP.
               10  S-H-Z       PIC X(4).
               10  S-H-P       PIC X(2).
           05  S-H-WO          PIC X(10).
           05  S-H-EQ-NUM      PIC X(6).
           05  S-H-DATE.
               10  S-H-YY      PIC X(02).
               10  S-H-MM      PIC X(02).
               10  S-H-DD      PIC X(02).
           05  S-H-SHIFT.
               10  S-H-SHFT    PIC X.
               10  FILLER      PIC X.
           05  S-H-QTY         PIC X(02).
           05  S-H-CRAFT       PIC X(02).
           05  S-H-HOURS.
               10  S-H-HRS     PIC X(03).
               10  S-H-TENTHS  PIC X.
           05  S-H-REM         PIC X(30).
           05  S-H-PAD         PIC X(20).

       01  ZONE-ARGUMENT.
           05  Z-ARG           PIC X(4).
           05  FILLER          PIC XX   VALUE "1 ".

           COPY SCREENIO       IN COPYLIB.

           COPY CATREAD        IN COPYLIB.

       01  DBPARAMETERS.
           COPY DBPARMS        IN COPYLIB.

       01  LAST-WO-USED-DATA.
           COPY MLASTWO        IN COPYLIB.

       01  WO-PLANNED-DATA.
           COPY DWOPLAN        IN COPYLIB.

       01  WO-SCHED-DATA.
           COPY DWOSCHED       IN COPYLIB.

       PROCEDURE DIVISION.
       BEGIN-PGM.
           CALL "TPWORD"       USING PASSWORD-INFORMATION.
           IF PASSWORD-FLAG = "N"
               GOBACK.

           CALL "CLSCHDS".
           OPEN I-O            DISPLAY-FILE.
           OPEN INPUT          WO-CRAFTS-REQD.
           OPEN INPUT          WO-LAST-NUM-USED.
           OPEN INPUT          WO-PLANNED.
           OPEN I-O            WO-SCHEDULE.
           MOVE 0              TO KEY-HIT ADD-SW.
           MOVE SPACES         TO DATA-BUFFER.
           MOVE 1              TO ARG-NO.

           READ WO-LAST-NUM-USED INTO LAST-WO-USED-DATA
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
               MOVE 1          TO DATE-FLAG-SW.

           MOVE DATE-FLAG-SW   TO DATE-FLAG.

           ACCEPT CUR-DATE-WA   FROM DATE.
           IF CUR-DATE-YR = "0" MOVE "A" TO YEAR-DISP
           ELSE
           IF CUR-DATE-YR = "1" MOVE "B" TO YEAR-DISP
           ELSE
           IF CUR-DATE-YR = "2" MOVE "C" TO YEAR-DISP
           ELSE
           IF CUR-DATE-YR = "3" MOVE "D" TO YEAR-DISP
           ELSE
           IF CUR-DATE-YR = "4" MOVE "E" TO YEAR-DISP
           ELSE
           IF CUR-DATE-YR = "5" MOVE "F" TO YEAR-DISP
           ELSE
           IF CUR-DATE-YR = "6" MOVE "G" TO YEAR-DISP
           ELSE
           IF CUR-DATE-YR = "7" MOVE "H" TO YEAR-DISP
           ELSE
           IF CUR-DATE-YR = "8" MOVE "J" TO YEAR-DISP
           ELSE
           IF CUR-DATE-YR = "9" MOVE "K" TO YEAR-DISP
           ELSE
           MOVE " "             TO YEAR-DISP.

       6-MAIN.
           MOVE CUR-DATE-MM    TO CURR-MO-99.
           MOVE CUR-DATE-DD    TO CURR-DY-99.
           MOVE CUR-DATE-YY    TO CURR-YR-99.
           MOVE 20             TO CURR-CT-99.
           IF CURR-YR-99 > 70
               MOVE 19         TO CURR-CT-99.

           MOVE SPACES         TO SCREEN-DATA
                                  ERROR-BUFFER
                                  SCH-DATE-99.

           MOVE "FSCHEDWO"     TO SCREEN-NAME.
           MOVE YEAR-DISP      TO WO-YR-HOLD.
           MOVE  WO-YR-HOLD    TO WO-YR.

       6-SHOWFORM.
           MOVE 31042          TO CATREAD-MSG-NUMBER.
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
           MOVE ERROR-BUFFER   TO NOTE-DATA.
           MOVE 66175          TO CATREAD-MSG-NUMBER.
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
           MOVE ERROR-BUFFER   TO SCREEN-CMD-LINE.

           IF S-1-HRS = "    " MOVE ZEROES TO S-1-HM.
           IF S-2-HRS = "    " MOVE ZEROES TO S-2-HM.
           IF S-3-HRS = "    " MOVE ZEROES TO S-3-HM.
           IF S-4-HRS = "    " MOVE ZEROES TO S-4-HM.
           IF S-5-HRS = "    " MOVE ZEROES TO S-5-HM.
           IF S-6-HRS = "    " MOVE ZEROES TO S-6-HM.

           MOVE SCREEN-DATA    TO DISPLAY-REC.
           MOVE "00"           TO SCREEN-STATUS.

           WRITE DISPLAY-REC   FORMAT IS SCREEN-NAME
                               INDIC ARE SCREEN-INDICATORS.
           IF SCREEN-STATUS NOT = "00"
               DISPLAY "SCREEN WRITE ERROR.  SCREEN-STATUS IS "
                               SCREEN-STATUS
               GO TO END-OF-JOB.

           READ  DISPLAY-FILE  FORMAT IS SCREEN-NAME
                               INDIC ARE SCREEN-INDICATORS.
           IF SCREEN-STATUS NOT = "00"
               DISPLAY "SCREEN READ ERROR.  SCREEN-STATUS IS "
                               SCREEN-STATUS
               GO TO END-OF-JOB.

           MOVE ALL B"0"       TO SCREEN-INDICATORS.
           MOVE DISPLAY-REC    TO SCREEN-DATA.

           IF KEY-HIT = 3
               GO TO END-OF-JOB.

           IF KEY-HIT = 5
               MOVE 1          TO ADD-SW
           ELSE
           IF KEY-HIT NOT = 0
               GO TO 6-SHOWFORM.

           IF WO-NUM-S = SPACES
               MOVE 49004          TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE ERROR-BUFFER   TO SCREEN-ERR-LINE
               MOVE TRUE-VAL       TO IND(1) IND(99)
               GO TO 6-SHOWFORM.

           CALL "TALWONO"      USING S-WO-NUM RTN-CODE.

           MOVE S-WO-NUM       TO WONUM OF WPFREC.
           START WO-PLANNED    KEY IS = EXTERNALLY-DESCRIBED-KEY
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
               MOVE 35040          TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE ERROR-BUFFER   TO SCREEN-ERR-LINE
               MOVE TRUE-VAL       TO IND(1) IND(99)
               GO TO 6-SHOWFORM.

           READ WO-PLANNED     NEXT INTO WO-PLANNED-DATA
               AT END          MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
               MOVE 40014          TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE ERROR-BUFFER   TO SCREEN-ERR-LINE
               MOVE TRUE-VAL       TO IND(1) IND(99)
               GO TO 6-SHOWFORM.

           IF WO-STATUS-P = "IP" OR "SD" OR "HS" OR "SW" OR "PR"
               NEXT SENTENCE
           ELSE
               MOVE 35084          TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE ERROR-BUFFER   TO SCREEN-ERR-LINE
               MOVE TRUE-VAL       TO IND(1) IND(99)
               GO TO 6-SHOWFORM.

           MOVE ZONE-P         TO ZONE-BUF.
           MOVE ZEROS          TO TIME-IN.
           CALL "TGETSHFT"     USING SHIFT-DATA
                                     DBPARAMETERS.

           MOVE EQUIP-NUM-P    TO WO-EQUIP.

           IF SPACES = S-MM AND S-DD AND S-YY
               IF S-SHIFT NOT = SPACE
                   MOVE SPACE  TO S-SHIFT
                   GO TO 6-MAIN-SORT
               ELSE
               GO TO 6-MAIN-SORT.

           IF S-YY IS NUMERIC
               IF DATE-FLAG = 1
                   IF S-MM > "00" AND S-MM < "13"
                       IF S-DD > "00" AND S-DD < "32"
                           NEXT SENTENCE
                       ELSE
                           MOVE 35030          TO CATREAD-MSG-NUMBER
                           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                           MOVE ERROR-BUFFER   TO SCREEN-ERR-LINE
                           MOVE TRUE-VAL       TO IND(99)
                           MOVE 4              TO FIELD-NUMBER
                           GO TO 6-SHOWFORM
                   ELSE
                       MOVE 35031          TO CATREAD-MSG-NUMBER
                       PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                       MOVE ERROR-BUFFER   TO SCREEN-ERR-LINE
                       MOVE TRUE-VAL       TO IND(99)
                       MOVE 3              TO FIELD-NUMBER
                       GO TO 6-SHOWFORM
               ELSE
               IF S-MM > "00" AND S-MM < "32"
                   IF S-DD > "00" AND S-DD < "13"
                       NEXT SENTENCE
                   ELSE
                       MOVE 35031          TO CATREAD-MSG-NUMBER
                       PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                       MOVE ERROR-BUFFER   TO SCREEN-ERR-LINE
                       MOVE TRUE-VAL       TO IND(99)
                       MOVE 4              TO FIELD-NUMBER
                       GO TO 6-SHOWFORM
               ELSE
                   MOVE 35030          TO CATREAD-MSG-NUMBER
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE ERROR-BUFFER   TO SCREEN-ERR-LINE
                   MOVE TRUE-VAL       TO IND(99)
                   MOVE 3              TO FIELD-NUMBER
                   GO TO 6-SHOWFORM
           ELSE
               MOVE 35032          TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE ERROR-BUFFER   TO SCREEN-ERR-LINE
               MOVE TRUE-VAL       TO IND(99)
               MOVE 5              TO FIELD-NUMBER
               GO TO 6-SHOWFORM.

           IF CODE-BUF = "2"
               IF S-SHIFT = "1" OR "2" OR " "
                   NEXT SENTENCE
               ELSE
                   MOVE 35034          TO CATREAD-MSG-NUMBER
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE ERROR-BUFFER   TO SCREEN-ERR-LINE
                   MOVE TRUE-VAL       TO IND(99)
                   MOVE 6 TO FIELD-NUMBER
                   GO TO 6-SHOWFORM.

           IF CODE-BUF = "3"
               IF S-SHIFT = "1" OR "2" OR "3" OR " "
                   NEXT SENTENCE
               ELSE
                   MOVE 35034          TO CATREAD-MSG-NUMBER
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE ERROR-BUFFER   TO SCREEN-ERR-LINE
                   MOVE TRUE-VAL       TO IND(99)
                   MOVE 6              TO FIELD-NUMBER
                   GO TO 6-SHOWFORM.

           IF CODE-BUF = "4"
               IF S-SHIFT = "1" OR "2" OR "3" OR "4" OR " "
                   NEXT SENTENCE
               ELSE
                   MOVE 35034          TO CATREAD-MSG-NUMBER
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE ERROR-BUFFER   TO SCREEN-ERR-LINE
                   MOVE TRUE-VAL       TO IND(99)
                   MOVE 6              TO FIELD-NUMBER
                   GO TO 6-SHOWFORM.

           MOVE S-YY           TO SCH-DATE-99-YY.
           MOVE S-MM           TO SCH-DATE-99-MM.
           MOVE S-DD           TO SCH-DATE-99-DD.
           IF DATE-FLAG = 3
               MOVE S-DD       TO SCH-DATE-99-MM
               MOVE S-MM       TO SCH-DATE-99-DD.

           MOVE 20             TO SCH-DATE-99-CC.
           IF SCH-DATE-99-YY  > 70
               MOVE 19         TO SCH-DATE-99-CC.

       6-MAIN-SORT.
           MOVE 0              TO ACT-KEY.
           IF ADD-SW = 1       GO TO 61-GET-FORM.
           SORT SORT-FILE      ASCENDING KEY SORT-DATE
                                             SORT-SHIFT-ID
                                             SORT-CRAFT
               INPUT PROCEDURE  7-SORT-INPUT-RECORDS
               OUTPUT PROCEDURE 8-SORT-WRITE-FILE.

           IF ACT-KEY = 0
               MOVE 40011          TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE ERROR-BUFFER   TO SCREEN-CMD-LINE
               MOVE SCREEN-DATA    TO DISPLAY-REC
               MOVE ERROR-BUFFER   TO SCREEN-ERR-LINE
               MOVE TRUE-VAL       TO IND(98)
               GO TO 6-SHOWFORM.

       61-GET-FORM.
           MOVE 0              TO ACT-KEY EOF-SW.
           CLOSE               OUT-FILE.
           OPEN INPUT          OUT-FILE.
           MOVE "FSCHEDWO1"    TO SCREEN-NAME.
           IF ADD-SW = 1
               IF SPACES = S-MM AND S-DD AND S-YY
                   NEXT SENTENCE
               ELSE
               MOVE "FSCHEDWO2" TO SCREEN-NAME
               IF S-SHIFT NOT = SPACE
                    MOVE "FSCHEDWO3" TO SCREEN-NAME.

       61-RESET-SCREEN.
           IF EOF-SW = 1
               MOVE 0          TO EOF-SW
               CLOSE           OUT-FILE
               GO TO 6-MAIN-SORT.

           MOVE WO-DATA        TO WO-HOLD.
           MOVE SPACES         TO SCREEN-DATA.
           MOVE ZEROES         TO S-1-HM S-2-HM S-3-HM
                                  S-4-HM S-5-HM S-6-HM.
           MOVE WO-HOLD        TO WO-DATA.
           MOVE 31046          TO CATREAD-MSG-NUMBER.
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
           MOVE ERROR-BUFFER   TO NOTE-DATA.

           IF ADD-SW = 1
               IF SPACES = S-MM AND S-DD AND S-YY
                   MOVE DATA-BUFFER TO HOLD-BUFFER
                   GO TO 6-MAIN-CONT
               ELSE
                   MOVE S-DATE      TO S-1-DATE  S-2-DATE  S-3-DATE
                                       S-4-DATE  S-5-DATE  S-6-DATE
                   MOVE S-SHIFT     TO S-1-SHIFT S-2-SHIFT S-3-SHIFT
                                       S-4-SHIFT S-5-SHIFT S-6-SHIFT
                   MOVE DATA-BUFFER TO HOLD-BUFFER
                   GO TO 6-MAIN-CONT.

           PERFORM 62-GET-DATA THRU 62-GD-EXIT.

       6-MAIN-CONT.
           IF SCREEN-NAME = "FSCHEDWO1" OR "FSCHEDWO2" OR "FSCHEDWO3"
               MOVE 66176      TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE ERROR-BUFFER TO SCREEN-CMD-LINE.

           IF SCREEN-NAME = "FSCHEDWOA" OR "FSCHEDWOB"
               MOVE SCREEN-SAVE TO SCREEN-NAME.

           IF S-1-HRS = "    " MOVE ZEROES TO S-1-HM.
           IF S-2-HRS = "    " MOVE ZEROES TO S-2-HM.
           IF S-3-HRS = "    " MOVE ZEROES TO S-3-HM.
           IF S-4-HRS = "    " MOVE ZEROES TO S-4-HM.
           IF S-5-HRS = "    " MOVE ZEROES TO S-5-HM.
           IF S-6-HRS = "    " MOVE ZEROES TO S-6-HM.

           MOVE SCREEN-DATA    TO DISPLAY-REC.
           MOVE "00"           TO SCREEN-STATUS.

           WRITE DISPLAY-REC   FORMAT IS SCREEN-NAME
                               INDIC ARE SCREEN-INDICATORS.
           IF SCREEN-STATUS NOT = "00"
               DISPLAY "SCREEN WRITE ERROR.  SCREEN-STATUS IS "
                               SCREEN-STATUS
               GO TO END-OF-JOB.

           READ  DISPLAY-FILE  FORMAT IS SCREEN-NAME
                               INDIC ARE SCREEN-INDICATORS.
           IF SCREEN-STATUS NOT = "00"
               DISPLAY "SCREEN READ ERROR.  SCREEN-STATUS IS "
                               SCREEN-STATUS
               GO TO END-OF-JOB.

           MOVE ALL B"0"       TO SCREEN-INDICATORS.
           MOVE DISPLAY-REC    TO SCREEN-DATA.

           IF KEY-HIT = 3
               GO TO END-OF-JOB.

           IF KEY-HIT = 0
               IF DATA-BUFFER = HOLD-BUFFER
                   IF ADD-SW = 1
                       GO TO 6-SHOWFORM
                   ELSE
                   GO TO 61-RESET-SCREEN
               ELSE
               GO TO 62-READ-DATA.

           IF KEY-HIT = 2
               MOVE SCREEN-NAME TO SCREEN-SAVE
               MOVE "FSCHEDWOA" TO SCREEN-NAME
               MOVE  WO-YR      TO WO-YR-HOLD
               GO TO 6-SHOWFORM.

           IF KEY-HIT = 4
               MOVE SCREEN-NAME TO SCREEN-SAVE
               MOVE "FSCHEDWOB" TO SCREEN-NAME
               MOVE  WO-YR      TO WO-YR-HOLD
               GO TO 6-SHOWFORM.

           MOVE 0              TO MAX-KEY ACT-KEY.
           MOVE SPACES         TO SCREEN-DATA
                                  ERROR-BUFFER
                                  SCH-DATE-99.
           MOVE 0              TO ADD-SW.
           MOVE "FSCHEDWO"     TO SCREEN-NAME.
           MOVE YEAR-DISP      TO WO-YR-HOLD.
           MOVE  WO-YR-HOLD    TO WO-YR.
           MOVE 66175          TO CATREAD-MSG-NUMBER.
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
           MOVE ERROR-BUFFER   TO SCREEN-CMD-LINE.
           CLOSE               OUT-FILE.
           GO TO 6-MAIN.

       62-READ-DATA.
           MOVE SPACES         TO S-UP-REM-HOLD.
           IF S-1-MM = "DD"
               MOVE SPACES     TO S-1-MM S-1-DD S-1-YY S-1-SHIFT
                                  S-1-QTY S-1-CRAFT S-1-HRS S-1-REM.
           IF LINE-1 = H-LINE-1
               MOVE S-UP-REM-HOLD-1 TO S-UP-REM-HOLD-2
               MOVE S-1-REM         TO S-UP-REM-HOLD-1
           ELSE
           IF SPACES = S-1-MM AND S-1-DD AND S-1-YY AND S-1-SHIFT
               AND S-1-QTY AND S-1-CRAFT AND S-1-REM
                   MOVE LINE-1   TO LINE-UP
                   MOVE H-LINE-1 TO LINE-UP2
                   PERFORM 63-PUT-DATA
                   PERFORM 63-DEL-DATA THRU 63-DD-EXIT
                   IF IND(99) = TRUE-VAL
                       MOVE TRUE-VAL TO IND(FIELD-NUMBER)
                       GO TO 6-MAIN-CONT
                   ELSE
                       MOVE SPACES TO LINE-1 H-LINE-1 LINE-UP LINE-UP2
               ELSE
                   MOVE LINE-1 TO LINE-UP
                   MOVE S-UP-REM-HOLD-1 TO S-UP-REM-HOLD-2
                   MOVE S-UP-REM        TO S-UP-REM-HOLD-1
                   MOVE H-LINE-1 TO LINE-UP2
                   PERFORM 63-EDIT-DATA THRU 63-ED-EXIT
                   IF IND(99) = TRUE-VAL
                       MOVE TRUE-VAL TO IND(FIELD-NUMBER)
                       GO TO 6-MAIN-CONT
                   ELSE
                   IF ADD-SW = 1
                       PERFORM 63-PUT-DATA
                       PERFORM 63-ADD-DATA THRU 63-AD-EXIT
                       IF IND(99) = TRUE-VAL
                           MOVE TRUE-VAL TO IND(FIELD-NUMBER)
                           GO TO 6-MAIN-CONT
                       ELSE
                           MOVE SPACES TO LINE-1 H-LINE-1
                                          LINE-UP LINE-UP2
                   ELSE
                   IF SPACES = H-1-MM AND H-1-DD AND H-1-YY AND
                       H-1-SHIFT AND H-1-QTY AND H-1-CRAFT
                           AND H-1-HRS AND H-1-REM
                           PERFORM 63-PUT-DATA
                           PERFORM 63-ADD-DATA THRU 63-AD-EXIT
                           IF IND(99) = TRUE-VAL
                               MOVE TRUE-VAL TO IND(FIELD-NUMBER)
                               GO TO 6-MAIN-CONT
                           ELSE
                               MOVE SPACES TO LINE-1 H-LINE-1
                                              LINE-UP LINE-UP2
                       ELSE
                           PERFORM 63-PUT-DATA
                           PERFORM 63-DEL-DATA THRU 63-DD-EXIT
                           IF IND(99) = TRUE-VAL
                               MOVE TRUE-VAL TO IND(FIELD-NUMBER)
                               GO TO 6-MAIN-CONT
                           ELSE
                               PERFORM 63-PUT-DATA
                               PERFORM 63-ADD-DATA THRU 63-AD-EXIT
                               IF IND(99) = TRUE-VAL
                                   MOVE TRUE-VAL TO IND(FIELD-NUMBER)
                                   GO TO 6-MAIN-CONT
                               ELSE
                                   MOVE SPACES TO LINE-1 H-LINE-1
                                                  LINE-UP LINE-UP2.

           IF S-2-MM = "DD"
               MOVE SPACES TO S-2-MM S-2-DD S-2-YY S-2-SHIFT
                              S-2-QTY S-2-CRAFT S-2-HRS S-2-REM.

           IF LINE-2 = H-LINE-2
               MOVE S-UP-REM-HOLD-1 TO S-UP-REM-HOLD-2
               MOVE S-2-REM         TO S-UP-REM-HOLD-1
           ELSE
           IF SPACES = S-2-MM AND S-2-DD AND S-2-YY AND S-2-SHIFT
               AND S-2-QTY AND S-2-CRAFT
                   AND S-2-REM
                   MOVE LINE-2   TO LINE-UP
                   MOVE H-LINE-2 TO LINE-UP2
                   PERFORM 63-PUT-DATA
                   PERFORM 63-DEL-DATA THRU 63-DD-EXIT
                   IF IND(99) = TRUE-VAL
                       ADD 08    TO FIELD-NUMBER
                       MOVE TRUE-VAL TO IND(FIELD-NUMBER)
                       GO TO 6-MAIN-CONT
                   ELSE
                       MOVE SPACES TO LINE-2 H-LINE-2
                                      LINE-UP LINE-UP2
               ELSE
