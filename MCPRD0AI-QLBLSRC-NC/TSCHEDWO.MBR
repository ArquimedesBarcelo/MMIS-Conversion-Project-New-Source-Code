                       AND H-6-HRS AND H-6-REM
                       PERFORM 63-PUT-DATA
                       PERFORM 63-ADD-DATA THRU 63-AD-EXIT
                       IF IND(99) = TRUE-VAL
                           ADD 40 TO FIELD-NUMBER
                           MOVE TRUE-VAL TO IND(FIELD-NUMBER)
                           GO TO 6-MAIN-CONT
