                   ELSE
                   PERFORM 63-PUT-DATA
                   PERFORM 63-ADD-DATA THRU 63-AD-EXIT
                   IF IND(99) = TRUE-VAL
                       ADD 40 TO FIELD-NUMBER
                       MOVE TRUE-VAL TO IND(FIELD-NUMBER)
                       GO TO 6-MAIN-CONT
                   ELSE
                   MOVE SPACES TO LINE-6 H-LINE-6 LINE-UP LINE-UP2.

           GO TO 61-RESET-SCREEN.

       63-PUT-DATA.
           MOVE ZONE-P         TO Z-ARG.
           MOVE ZONE-ARGUMENT  TO SCHED-ZP S-H-ZP.
           MOVE S-WO-NUM       TO SCHED-WO S-H-WO.
           MOVE WO-EQUIP       TO SCHED-EQ-NUM S-H-EQ-NUM.

           IF SPACES = S-UP-YY AND S-UP-MM AND S-UP-DD
               MOVE SPACES     TO SCHED-DATE-CN
           ELSE
               MOVE S-UP-YY    TO SCHED-YY
               MOVE S-UP-MM    TO SCHED-MM
               MOVE S-UP-DD    TO SCHED-DD
               IF DATE-FLAG = 3
                   MOVE S-UP-DD TO SCHED-MM
                   MOVE S-UP-MM TO SCHED-DD
               END-IF
               MOVE "20"       TO SCHED-CC
               IF SCHED-YY  > "70"
                   MOVE "19"   TO SCHED-CC.

           MOVE S-UP-SHIFT     TO SCHED-SHFT.
           MOVE S-UP-QTY       TO SCHED-QTY.
           MOVE S-UP-CRAFT     TO SCHED-CRAFT.
           MOVE S-UP-HRS       TO SCHED-HOURS.
           MOVE S-UP-REM       TO SCHED-REM.
           MOVE SPACES         TO SCHED-PAD.

           IF SPACES = S-UP2-YY AND S-UP2-MM AND S-UP2-DD
               MOVE SPACES     TO S-H-DATE
           ELSE
           MOVE S-UP2-YY       TO S-H-YY
           MOVE S-UP2-MM       TO S-H-MM
           MOVE S-UP2-DD       TO S-H-DD
           IF DATE-FLAG = 3
               MOVE S-UP2-DD   TO S-H-MM
               MOVE S-UP2-MM   TO S-H-DD.

           MOVE S-UP2-SHIFT    TO S-H-SHFT.
           MOVE S-UP2-QTY      TO S-H-QTY.
           MOVE S-UP2-CRAFT    TO S-H-CRAFT.
           MOVE S-UP2-HRS      TO S-H-HOURS.
           MOVE S-UP2-REM      TO S-H-REM.
           MOVE SPACES         TO S-H-PAD.

       63-EDIT-DATA.
           IF S-UP-YY IS NUMERIC
               IF DATE-FLAG = 1
                   IF S-UP-MM > "00" AND S-UP-MM < "13"
                       IF S-UP-DD > "00" AND S-UP-DD < "32"
                           NEXT SENTENCE
                       ELSE
                           MOVE 35030          TO CATREAD-MSG-NUMBER
                           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                           MOVE ERROR-BUFFER   TO SCREEN-ERR-LINE
                           MOVE TRUE-VAL       TO IND(99)
                           MOVE 2              TO FIELD-NUMBER
                           GO TO 63-ED-EXIT
                   ELSE
                       MOVE 35031          TO CATREAD-MSG-NUMBER
                       PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                       MOVE ERROR-BUFFER   TO SCREEN-ERR-LINE
                       MOVE TRUE-VAL       TO IND(99)
                       MOVE 1              TO FIELD-NUMBER
                       GO TO 63-ED-EXIT
               ELSE
               IF S-UP-MM > "00" AND S-UP-MM < "32"
                   IF S-UP-DD > "00" AND S-UP-DD < "13"
                       NEXT SENTENCE
                   ELSE
                       MOVE 35031          TO CATREAD-MSG-NUMBER
                       PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                       MOVE ERROR-BUFFER   TO SCREEN-ERR-LINE
                       MOVE TRUE-VAL       TO IND(99)
                       MOVE 2              TO FIELD-NUMBER
                       GO TO 63-ED-EXIT
               ELSE
                   MOVE 35030          TO CATREAD-MSG-NUMBER
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE ERROR-BUFFER   TO SCREEN-ERR-LINE
                   MOVE TRUE-VAL       TO IND(99)
                   MOVE 1              TO FIELD-NUMBER
                   GO TO 63-ED-EXIT
           ELSE
               MOVE 35032          TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE ERROR-BUFFER   TO SCREEN-ERR-LINE
               MOVE TRUE-VAL       TO IND(99)
               MOVE 3              TO FIELD-NUMBER
               GO TO 63-ED-EXIT.

           MOVE S-UP-YY        TO DATE-99-YY.
           MOVE S-UP-MM        TO DATE-99-MM.
           MOVE S-UP-DD        TO DATE-99-DD
           IF DATE-FLAG = 3
               MOVE S-UP-DD    TO DATE-99-MM
               MOVE S-UP-MM    TO DATE-99-DD.

           MOVE 20             TO DATE-99-CC.
           IF DATE-99-YY  > 70
               MOVE 19         TO DATE-99-CC.

           IF DATE-COMPARE < CURR-DATE-99
               MOVE 30018          TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE ERROR-BUFFER   TO SCREEN-ERR-LINE
               MOVE TRUE-VAL       TO IND(99)
               MOVE 1              TO FIELD-NUMBER
               GO TO 63-ED-EXIT.

           IF CODE-BUF = "2"
               IF S-UP-SHIFT = "1" OR "2"
                   NEXT SENTENCE
               ELSE
                   MOVE 35034          TO CATREAD-MSG-NUMBER
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE ERROR-BUFFER   TO SCREEN-ERR-LINE
                   MOVE TRUE-VAL       TO IND(99)
                   MOVE 4              TO FIELD-NUMBER
                   GO TO 63-ED-EXIT.

           IF CODE-BUF = "3"
               IF S-UP-SHIFT = "1" OR "2" OR "3"
                   NEXT SENTENCE
               ELSE
                   MOVE 35034          TO CATREAD-MSG-NUMBER
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE ERROR-BUFFER   TO SCREEN-ERR-LINE
                   MOVE TRUE-VAL       TO IND(99)
                   MOVE 4              TO FIELD-NUMBER
                   GO TO 63-ED-EXIT.

           IF CODE-BUF = "4"
               IF S-UP-SHIFT = "1" OR "2" OR "3" OR "4"
                   NEXT SENTENCE
               ELSE
                   MOVE 35034          TO CATREAD-MSG-NUMBER
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE ERROR-BUFFER   TO SCREEN-ERR-LINE
                   MOVE TRUE-VAL       TO IND(99)
                   MOVE 4              TO FIELD-NUMBER
                   GO TO 63-ED-EXIT.

           IF S-UP-QTY = SPACES
               MOVE "01"       TO S-UP-QTY.

           IF S-UP-QTY2 = SPACE
               MOVE S-UP-QTY1  TO S-UP-QTY2
               MOVE "0"        TO S-UP-QTY1.

           IF S-UP-QTY NOT NUMERIC
               MOVE 35041          TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE ERROR-BUFFER   TO SCREEN-ERR-LINE
               MOVE TRUE-VAL       TO IND(99)
               MOVE 5              TO FIELD-NUMBER
               GO TO 63-ED-EXIT.

           IF S-UP-CRAFT = SPACES
               MOVE 29032          TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE ERROR-BUFFER   TO SCREEN-ERR-LINE
               MOVE TRUE-VAL       TO IND(99)
               MOVE 6              TO FIELD-NUMBER
               GO TO 63-ED-EXIT.

           MOVE S-UP-CRAFT     TO CRAFT-BUF.

           MOVE CRAFT-BUF      TO CRAFTREQD OF WCRFREC.
           START WO-CRAFTS-REQD KEY IS = EXTERNALLY-DESCRIBED-KEY
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
               MOVE 35037          TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE ERROR-BUFFER   TO SCREEN-ERR-LINE
               MOVE TRUE-VAL       TO IND(99)
               MOVE 6              TO FIELD-NUMBER
               GO TO 63-ED-EXIT.

           MOVE S-UP-HRS       TO S-UP-WA.

           IF S-UP-H3 = SPACE
               MOVE S-UP-H2    TO S-UP-H3
               MOVE S-UP-H1    TO S-UP-H2
               MOVE "0"        TO S-UP-H1.

           IF S-UP-H3 = SPACE
               MOVE S-UP-H2    TO S-UP-H3
               MOVE S-UP-H1    TO S-UP-H2
               MOVE "0"        TO S-UP-H1.

           IF S-UP-H3 = SPACE
               MOVE S-UP-H2    TO S-UP-H3
               MOVE S-UP-H1    TO S-UP-H2
               MOVE "0"        TO S-UP-H1.

           IF S-UP-H NOT NUMERIC
               MOVE 35029          TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE ERROR-BUFFER   TO SCREEN-ERR-LINE
               MOVE TRUE-VAL       TO IND(99)
               MOVE 7              TO FIELD-NUMBER
               GO TO 63-ED-EXIT.

           IF S-UP-T = SPACE
               MOVE "0"        TO S-UP-T.

           IF S-UP-T NOT NUMERIC
               MOVE 35029          TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE ERROR-BUFFER   TO SCREEN-ERR-LINE
               MOVE TRUE-VAL       TO IND(99)
               MOVE 7              TO FIELD-NUMBER
               GO TO 63-ED-EXIT.

           IF S-UP-H = "000" AND S-UP-T = "0"
               MOVE 46013          TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE ERROR-BUFFER   TO SCREEN-ERR-LINE
               MOVE TRUE-VAL       TO IND(99)
               MOVE 7              TO FIELD-NUMBER
               GO TO 63-ED-EXIT.

           IF S-UP-REM-28 = SPACES
               IF S-UP-REM-2 = "D " OR "DD" OR "DU" OR " D"
                   MOVE S-UP-REM-HOLD-2 TO S-UP-REM S-UP-REM-HOLD-1
                   MOVE S-UP-REM-HOLD-2 TO S-UP2-REM.

       63-ED-EXIT.             EXIT.

       63-ADD-DATA.
           MOVE WO-SCHED-DATA  TO WO-DELETE-DATA.
           WRITE WSFREC        FROM WO-DELETE-DATA
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.

       63-AD-EXIT.             EXIT.

       63-DEL-DATA.
           MOVE S-WO-NUM       TO WONUM OF WSFREC.
           START WO-SCHEDULE   KEY IS = EXTERNALLY-DESCRIBED-KEY
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
               GO TO 63-DD-EXIT.

       63-DEL-DBGET.
           READ WO-SCHEDULE    NEXT INTO WO-SCHED-DATA
               AT END          MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
               GO TO 63-DD-EXIT.

           IF S-WO-NUM NOT = WONUM OF WSFREC
               GO TO 63-DD-EXIT.

           IF SCHED-DATE = S-H-DATE AND
              SCHED-SHFT = S-H-SHFT AND
              SCHED-CRAFT = S-H-CRAFT
               NEXT SENTENCE
           ELSE
               GO TO 63-DEL-DBGET.

           DELETE WO-SCHEDULE RECORD
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.

       63-DD-EXIT.             EXIT.

       62-GET-DATA.
           MOVE DATA-BUFFER    TO HOLD-BUFFER.
           PERFORM 621-READ-OUTSCHDS THRU 621-RO-EXIT.
           IF ACT-KEY > MAX-KEY
               MOVE 1          TO EOF-SW
               GO TO 62-GD-EXIT.

           PERFORM 63-OUT-REC.
           MOVE SPACES         TO OUT-DATA.
           MOVE LINE-UP        TO LINE-1 H-LINE-1.
           PERFORM 621-READ-OUTSCHDS THRU 621-RO-EXIT.

           IF ACT-KEY > MAX-KEY
               MOVE 1          TO EOF-SW
               GO TO 62-GD-EXIT.

           PERFORM 63-OUT-REC.
           MOVE LINE-UP        TO LINE-2 H-LINE-2.
           MOVE SPACES         TO OUT-DATA.
           PERFORM 621-READ-OUTSCHDS THRU 621-RO-EXIT.

           IF ACT-KEY > MAX-KEY
               MOVE 1          TO EOF-SW
               GO TO 62-GD-EXIT.

           PERFORM 63-OUT-REC.
           MOVE LINE-UP        TO LINE-3 H-LINE-3.
           MOVE SPACES         TO OUT-DATA.
           PERFORM 621-READ-OUTSCHDS THRU 621-RO-EXIT.

           IF ACT-KEY > MAX-KEY
               MOVE 1          TO EOF-SW
               GO TO 62-GD-EXIT.

           PERFORM 63-OUT-REC.
           MOVE LINE-UP        TO LINE-4 H-LINE-4.
           MOVE SPACES         TO OUT-DATA.
           PERFORM 621-READ-OUTSCHDS THRU 621-RO-EXIT.

           IF ACT-KEY > MAX-KEY
               MOVE 1          TO EOF-SW
               GO TO 62-GD-EXIT.

           PERFORM 63-OUT-REC.
           MOVE LINE-UP        TO LINE-5 H-LINE-5.
           MOVE SPACES         TO OUT-DATA.
           PERFORM 621-READ-OUTSCHDS THRU 621-RO-EXIT.

           IF ACT-KEY > MAX-KEY
               MOVE 1          TO EOF-SW
               GO TO 62-GD-EXIT.

           PERFORM 63-OUT-REC.
           MOVE LINE-UP        TO LINE-6 H-LINE-6.

       62-GD-EXIT.             EXIT.

       621-READ-OUTSCHDS.
           ADD 1               TO ACT-KEY.
           IF ACT-KEY > MAX-KEY GO TO 621-RO-EXIT.
           MOVE SPACES         TO OUT-DATA.
           READ OUT-FILE       INVALID KEY
               MOVE 1          TO EOF-SW
               GO TO 621-RO-EXIT.

           IF SCH-DATE-99 = SPACES
               NEXT SENTENCE
           ELSE
           IF SCH-DATE-99 = OUT-DATE
               IF S-SHIFT = OUT-SHIFT OR SPACE
                   NEXT SENTENCE
               ELSE
                   GO TO 621-READ-OUTSCHDS
            ELSE
                GO TO 621-READ-OUTSCHDS.

       621-RO-EXIT.            EXIT.

       63-OUT-REC.
           MOVE OUT-YY         TO S-UP-YY.
           MOVE OUT-MM         TO S-UP-MM.
           MOVE OUT-DD         TO S-UP-DD
           IF DATE-FLAG = 3
               MOVE OUT-DD     TO S-UP-MM
               MOVE OUT-MM     TO S-UP-DD.

           MOVE OUT-SHIFT      TO S-UP-SHIFT.
           MOVE OUT-QTY        TO S-UP-QTY.
           MOVE OUT-CRAFT      TO S-UP-CRAFT.
           MOVE OUT-HRS        TO S-UP-HRS.
           MOVE OUT-REM        TO S-UP-REM.

       END-OF-JOB.
           CLOSE               DISPLAY-FILE.
           CLOSE               OUT-FILE.
           CLOSE               WO-CRAFTS-REQD.
           CLOSE               WO-LAST-NUM-USED.
           CLOSE               WO-PLANNED.
           CLOSE               WO-SCHEDULE.
           GOBACK.

       999-CATREAD.
            MOVE SPACES        TO ERROR-BUFFER.
            CALL "CCATREAD"    USING CATREAD-PARMS.
            MOVE CATREAD-MSG-TEXT TO ERROR-BUFFER.

       999-CATREAD-EXIT.       EXIT.

       7-SORT-INPUT-RECORDS.
           PERFORM 70-SORT-MAIN THRU 70-SORT-M-EXIT.

       70-SORT-MAIN.
           MOVE S-WO-NUM       TO WONUM OF WSFREC.
           START WO-SCHEDULE   KEY IS = EXTERNALLY-DESCRIBED-KEY
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
               GO TO 70-SORT-M-EXIT.

           PERFORM 701-SORT-DBGET THRU 701-SORT-DBGET-EXIT.

       70-SORT-M-EXIT.         EXIT.

       701-SORT-DBGET.
           MOVE SPACES         TO SORT-REC.
           READ WO-SCHEDULE    NEXT INTO WO-SCHED-DATA
               AT END          MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
               GO TO 701-SORT-DBGET-EXIT.

           IF WONUM OF WSFREC NOT = S-WO-NUM
               GO TO 701-SORT-DBGET-EXIT.

      *    IF SCH-DATE-99 = SPACES
      *        GO TO 7011-SORT-RELEASE
      *    ELSE
      *    IF SCH-DATE-99 = SCHED-DATE
      *        IF S-SHIFT = SCHED-SHFT OR SPACE
      *            GO TO 7011-SORT-RELEASE
      *        ELSE
      *        GO TO 701-SORT-DBGET-EXIT
      *    ELSE
      *    GO TO 701-SORT-DBGET-EXIT.

       7011-SORT-RELEASE.
           MOVE SCHED-DATE-CN  TO SORT-DATE.
           MOVE SCHED-SHFT     TO SORT-SHIFT.

           IF SCHED-SHFT = "1" MOVE "B" TO SORT-SHIFT-ID.
           IF SCHED-SHFT = "2" MOVE "C" TO SORT-SHIFT-ID.
           IF SCHED-SHFT = "4" MOVE "A" TO SORT-SHIFT-ID.

           IF CODE-BUF = "3"
               IF SCHED-SHFT = "3" MOVE "A" TO SORT-SHIFT-ID.

           IF CODE-BUF = "4"
               IF SCHED-SHFT = "3" MOVE "D" TO SORT-SHIFT-ID.

           MOVE SCHED-QTY      TO SORT-QTY.
           MOVE SCHED-CRAFT    TO SORT-CRAFT.
           MOVE SCHED-HOURS    TO SORT-HRS.
           MOVE SCHED-REM      TO SORT-REM.
           RELEASE             SORT-REC.

           GO TO 701-SORT-DBGET.

       701-SORT-DBGET-EXIT.    EXIT.

       8-SORT-WRITE-FILE.
           MOVE 0              TO ACT-KEY.
           OPEN OUTPUT         OUT-FILE.
           PERFORM 8-SWF-LOOP  THRU 8-SWF-EXIT.

       8-SWF-LOOP.
           RETURN SORT-FILE    AT END
               MOVE ACT-KEY    TO MAX-KEY
               GO TO 8-SWF-EXIT.

           ADD 1               TO ACT-KEY.
           MOVE SORT-REC       TO OUT-DATA.
           WRITE OUT-REC       INVALID KEY
               GO TO 8-SWF-EXIT.
           GO TO 8-SWF-LOOP.

       8-SWF-EXIT.    EXIT.

