                               MOVE TRUE-VAL TO IND(FIELD-NUMBER)
                               GO TO 6-MAIN-CONT
                           ELSE
                               MOVE SPACES TO LINE-2 H-LINE-2
                                              LINE-UP LINE-UP2
                       ELSE
                       PERFORM 63-PUT-DATA
                       PERFORM 63-DEL-DATA THRU 63-DD-EXIT
                       IF IND(99) = TRUE-VAL
                           ADD 08 TO FIELD-NUMBER
                           MOVE TRUE-VAL TO IND(FIELD-NUMBER)
                           GO TO 6-MAIN-CONT
                       ELSE
                       PERFORM 63-PUT-DATA
                       PERFORM 63-ADD-DATA THRU 63-AD-EXIT
                       IF IND(99) = TRUE-VAL
                           ADD 08 TO FIELD-NUMBER
                           MOVE TRUE-VAL TO IND(FIELD-NUMBER)
                           GO TO 6-MAIN-CONT
                       ELSE
                       MOVE SPACES TO LINE-2 H-LINE-2
                                      LINE-UP LINE-UP2.

           IF S-3-MM = "DD"
               MOVE SPACES TO S-3-MM S-3-DD S-3-YY S-3-SHIFT
                              S-3-QTY S-3-CRAFT S-3-HRS S-3-REM.

           IF LINE-3 = H-LINE-3
               MOVE S-UP-REM-HOLD-1 TO S-UP-REM-HOLD-2
               MOVE S-3-REM         TO S-UP-REM-HOLD-1
           ELSE
           IF SPACES = S-3-MM AND S-3-DD AND S-3-YY AND S-3-SHIFT
               AND S-3-QTY AND S-3-CRAFT
                   AND S-3-REM
                   MOVE LINE-3 TO LINE-UP
                   MOVE H-LINE-3 TO LINE-UP2
                   PERFORM 63-PUT-DATA
                   PERFORM 63-DEL-DATA THRU 63-DD-EXIT
                   IF IND(99) = TRUE-VAL
                       ADD 16 TO FIELD-NUMBER
                       MOVE TRUE-VAL TO IND(FIELD-NUMBER)
                       GO TO 6-MAIN-CONT
                   ELSE
                   MOVE SPACES TO LINE-3 H-LINE-3 LINE-UP LINE-UP2
               ELSE
               MOVE LINE-3 TO LINE-UP
               MOVE S-UP-REM-HOLD-1 TO S-UP-REM-HOLD-2
               MOVE S-UP-REM        TO S-UP-REM-HOLD-1
               MOVE H-LINE-3 TO LINE-UP2
               PERFORM 63-EDIT-DATA THRU 63-ED-EXIT
               IF IND(99) = TRUE-VAL
                   ADD 16 TO FIELD-NUMBER
                   MOVE TRUE-VAL TO IND(FIELD-NUMBER)
                   GO TO 6-MAIN-CONT
               ELSE
               IF ADD-SW = 1
                   PERFORM 63-PUT-DATA
                   PERFORM 63-ADD-DATA THRU 63-AD-EXIT
                   IF IND(99) = TRUE-VAL
                       ADD 16 TO FIELD-NUMBER
                       MOVE TRUE-VAL TO IND(FIELD-NUMBER)
                       GO TO 6-MAIN-CONT
                   ELSE
                   MOVE SPACES TO LINE-3 H-LINE-3 LINE-UP LINE-UP2
               ELSE
               IF SPACES = H-3-MM AND H-3-DD AND H-3-YY AND
                   H-3-SHIFT AND H-3-QTY AND H-3-CRAFT
                       AND H-3-HRS AND H-3-REM
                       PERFORM 63-PUT-DATA
                       PERFORM 63-ADD-DATA THRU 63-AD-EXIT
                       IF IND(99) = TRUE-VAL
                           ADD 16 TO FIELD-NUMBER
                           MOVE TRUE-VAL TO IND(FIELD-NUMBER)
                           GO TO 6-MAIN-CONT
                       ELSE
                       MOVE SPACES TO LINE-3 H-LINE-3 LINE-UP LINE-UP2
                   ELSE
                   PERFORM 63-PUT-DATA
                   PERFORM 63-DEL-DATA THRU 63-DD-EXIT
                   IF IND(99) = TRUE-VAL
                       ADD 16 TO FIELD-NUMBER
                       MOVE TRUE-VAL TO IND(FIELD-NUMBER)
                       GO TO 6-MAIN-CONT
                   ELSE
                   PERFORM 63-PUT-DATA
                   PERFORM 63-ADD-DATA THRU 63-AD-EXIT
                   IF IND(99) = TRUE-VAL
                       ADD 16 TO FIELD-NUMBER
                       MOVE TRUE-VAL TO IND(FIELD-NUMBER)
                       GO TO 6-MAIN-CONT
                   ELSE
                   MOVE SPACES TO LINE-3 H-LINE-3 LINE-UP LINE-UP2.

           IF S-4-MM = "DD"
               MOVE SPACES TO S-4-MM S-4-DD S-4-YY S-4-SHIFT
                      S-4-QTY S-4-CRAFT S-4-HRS S-4-REM.
           IF LINE-4 = H-LINE-4
               MOVE S-UP-REM-HOLD-1 TO S-UP-REM-HOLD-2
               MOVE S-4-REM         TO S-UP-REM-HOLD-1
           ELSE
           IF SPACES = S-4-MM AND S-4-DD AND S-4-YY AND S-4-SHIFT
               AND S-4-QTY AND S-4-CRAFT
                   AND S-4-REM
                   MOVE LINE-4 TO LINE-UP
                   MOVE H-LINE-4 TO LINE-UP2
                   PERFORM 63-PUT-DATA
                   PERFORM 63-DEL-DATA THRU 63-DD-EXIT
                   IF IND(99) = TRUE-VAL
                       ADD 24 TO FIELD-NUMBER
                       MOVE TRUE-VAL TO IND(FIELD-NUMBER)
                       GO TO 6-MAIN-CONT
                   ELSE
                   MOVE SPACES TO LINE-4 H-LINE-4 LINE-UP LINE-UP2
               ELSE
               MOVE LINE-4 TO LINE-UP
               MOVE S-UP-REM-HOLD-1 TO S-UP-REM-HOLD-2
               MOVE S-UP-REM        TO S-UP-REM-HOLD-1
               MOVE H-LINE-4 TO LINE-UP2
               PERFORM 63-EDIT-DATA THRU 63-ED-EXIT
               IF IND(99) = TRUE-VAL
                   ADD 24 TO FIELD-NUMBER
                   MOVE TRUE-VAL TO IND(FIELD-NUMBER)
                   GO TO 6-MAIN-CONT
               ELSE
               IF ADD-SW = 1
                   PERFORM 63-PUT-DATA
                   PERFORM 63-ADD-DATA THRU 63-AD-EXIT
                   IF IND(99) = TRUE-VAL
                       ADD 24 TO FIELD-NUMBER
                       MOVE TRUE-VAL TO IND(FIELD-NUMBER)
                       GO TO 6-MAIN-CONT
                   ELSE
                   MOVE SPACES TO LINE-4 H-LINE-4 LINE-UP LINE-UP2
               ELSE
               IF SPACES = H-4-MM AND H-4-DD AND H-4-YY AND
                   H-4-SHIFT AND H-4-QTY AND H-4-CRAFT
                       AND H-4-HRS AND H-4-REM
                       PERFORM 63-PUT-DATA
                       PERFORM 63-ADD-DATA THRU 63-AD-EXIT
                       IF IND(99) = TRUE-VAL
