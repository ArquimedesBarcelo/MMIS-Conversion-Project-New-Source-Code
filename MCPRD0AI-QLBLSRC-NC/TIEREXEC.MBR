000200 IDENTIFICATION DIVISION.
000300 PROGRAM-ID.    TIEREXEC.
000600*REMARKS.  ***  THIS IS THE EXECUTIVE MODULE FOR
000700*               THE EQUIPMENT REFERENCE FILE
000800*               DATABASE MAINTENANCE PROGRAM
000900*          ***  SUBROUTINES CALLED:
001000*                   TERRORD
001100*                   TIERREFA
001200*                   TIERREFC
001300*                   TIERDEL
001400*                   TIERTYPE
001500*                   TIERTITL
001600*                   ****.
001700 ENVIRONMENT DIVISION.
001800 CONFIGURATION SECTION.
001900 SOURCE-COMPUTER.    AS400.
002000 OBJECT-COMPUTER.    AS400.
       SPECIAL-NAMES. I-O-FEEDBACK IS I-O-FEEDBACK-AREA
                      LOCAL-DATA IS LOCAL-DATA-AREA.
001000 INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT DISPLAY-FILE
               ASSIGN TO WORKSTATION-ZIEQPREF-SI
               ORGANIZATION IS TRANSACTION
               ACCESS IS SEQUENTIAL
               FILE STATUS IS DSPLY-STATUS
               CONTROL-AREA IS WS-CONTROL.
           SELECT EQUIPMENT-FILE
               ASSIGN TO DATABASE-MCFLMM0201
               ORGANIZATION IS INDEXED
               ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
               FILE STATUS IS EF-STATUS.
           SELECT MASTER-RECORD-EQPREF
               ASSIGN TO DATABASE-MCFLER0801
               ORGANIZATION IS RELATIVE
               ACCESS MODE IS RANDOM
               RELATIVE KEY IS ARG-NO
               FILE STATUS IS MRE-STATUS.
           SELECT WO-LAST-NUM-USED
               ASSIGN TO DATABASE-MCFPMM0800
               ORGANIZATION IS RELATIVE
               ACCESS MODE IS RANDOM
               RELATIVE KEY IS ARG-NO
               FILE STATUS IS WLNU-STATUS.
002200 DATA DIVISION.
       FILE SECTION.
       FD  DISPLAY-FILE
           LABEL RECORDS ARE OMITTED.
       01  DSPLY-REC                   PIC X(2000).
       FD  EQUIPMENT-FILE
           LABEL RECORDS ARE STANDARD
           DATA RECORD IS EFREC.
       01  EFREC.
           COPY DDS-ALL-FORMATS OF MCFLMM0201.
       FD  MASTER-RECORD-EQPREF
           LABEL RECORDS ARE STANDARD
           DATA RECORD IS MREREC.
       01  MREREC.
           COPY DDS-ALL-FORMATS OF MCFLER0801.
       FD  WO-LAST-NUM-USED
           LABEL RECORDS ARE STANDARD
           DATA RECORD IS WLNUREC.
       01  WLNUREC.
           COPY DDS-ALL-FORMATS OF MCFPMM0800.
002300 WORKING-STORAGE SECTION.
002700 77  ARG-NO                  PIC 9(9).
002900
       COPY CATREAD OF COPYLIB.

       COPY CPYIND  OF COPYLIB.

005100 01  CUR-EQP-DISP.
005200     05  CE-LITERAL          PIC X(28).
005300     05  EQP-NUM             PIC X(06).
005400
009100 01  DBPARAMETERS.      COPY DBPARMS OF COPYLIB.

009300 01  EQP-EQUIPMENT.     COPY MEQPFILE OF COPYLIB.

004300 01  EQP-SUB-BUFFER.
004400     05  EQP-NUM-BUF         PIC X(06) VALUE SPACES.
004500     05  SUB-SYS-BUF         PIC X(04) VALUE SPACES.
004600     05  EQP-SUB-DESC        PIC X(40) VALUE SPACES.
004700     05  EQP-TYPE-BUF        PIC X(08) VALUE SPACES.
004800     05  ACD-FUNCTION        PIC X(06) VALUE SPACES.
004900     05  ACD-SW              PIC X(01) VALUE SPACES.
           05  EQP-CMD-LINE        PIC X(79).
           05  EQP-ERR-LINE        PIC X(79).
005000
005900 01  EQP-SAVE-BUFFER.
006000     05  EQP-NUM-SAVE        PIC X(06) VALUE SPACES.
006100     05  FILLER              PIC X(217) VALUE SPACES.
006200
       01  FILE-STATUSES.
           05  DSPLY-STATUS        PIC XX.
           05  EF-STATUS           PIC XX.
           05  MRE-STATUS          PIC XX.
           05  WLNU-STATUS         PIC XX.

       COPY IOFEEDBACK OF COPYLIB.

009500 01  LAST-WO-USED-DATA. COPY MLASTWO  OF COPYLIB.

009700 COPY DFMASTER OF COPYLIB.

007700 01  MESSAGE-BUFFER.
007800     05  MESSAGE-LIT         PIC X(28).
007900     05  FILLER              PIC X(52).
008400
003000 01  PASSWORD-INFORMATION.
003100     05  NAME-OF-PROGRAM     PIC X(08) VALUE "TIEREXEC".
003200     05  PROGRAM-TYPE        PIC X(02) VALUE "UP".
003300     05  PROGRAM-RELEASE     PIC X(12) VALUE " E0100010001".
003400     05  PROGRAM-DESCRIPTION.
003500         10  PROG-DESC-A.
                   15  FILLER      PIC X(15) VALUE "PRIMARY MODULE ".
                   15  FILLER      PIC X(16) VALUE "OF THE EQUIPMENT".
                   15  FILLER      PIC X(16) VALUE " REFERENCE FILE ".
                   15  FILLER      PIC X(13) VALUE "MAINTENANCE".
003700         10  PROG-DESC-B.
                   15  FILLER      PIC X(17) VALUE "PROGRAM TO PERMIT".
                   15  FILLER      PIC X(17) VALUE " ADDITIONS, MODIF".
                   15  FILLER      PIC X(17) VALUE "ATIONS, AND DELET".
                   15  FILLER      PIC X(09) VALUE "IONS TO ".
003900         10  PROG-FUNCTION.
                   15  FILLER      PIC X(09) VALUE "SPECIFIC ".
                   15  FILLER      PIC X(15) VALUE "(LOCAL NUMBER) ".
                   15  FILLER      PIC X(12) VALUE "AND GENERIC ".
                   15  FILLER      PIC X(14) VALUE "(TYPE NUMBER) ".
                   15  FILLER      PIC X(10) VALUE "RECORDS ".
004100     05  PASSWORD-FLAG       PIC X.
004200
005500 01  SCREEN-BUFFER.
           05  SCREEN-EQP-C-E.
005600         10  SCREEN-EQP-DISP PIC X(06).
005700         10  SCREEN-C-E-DISP PIC X(34).
           05  SCREEN-CMD-LINE     PIC X(79).
           05  SCREEN-ERR-LINE     PIC X(79).
005800
009200 COPY DBSTAT    OF COPYLIB.

006300 01  TEMP-BUFFER.
006400     05  DESC-BUFFER            PIC X(40).
006500     05  FILLER                 PIC X(10).
006600
       01  TRUE-VAL                   PIC 1 VALUE B"1".

009400 COPY VCOMLINK  OF COPYLIB.

       COPY WSCONTROL OF COPYLIB.
009900 PROCEDURE DIVISION.
010000 BEGIN-PGM.
           PERFORM 1-HSK.
           PERFORM 6-MAIN THRU 6-MAIN-EXIT UNTIL VIEW-LASTKEY = 3.
       2-EOJ.
           CLOSE DISPLAY-FILE.
           CLOSE EQUIPMENT-FILE.
           CLOSE MASTER-RECORD-EQPREF.
           CLOSE WO-LAST-NUM-USED.
           GOBACK.
       1-HSK.
010200     MOVE LOW-VALUES TO STATUS-AREA VIEW-COMAREA.
           MOVE 0 TO VIEW-LASTKEY.
           OPEN I-O    DISPLAY-FILE.
           OPEN INPUT  EQUIPMENT-FILE.
           OPEN INPUT  MASTER-RECORD-EQPREF.
           OPEN INPUT  WO-LAST-NUM-USED.
010100     MOVE SPACES TO EQP-SUB-BUFFER.
016200     MOVE 1 TO ARG-NO.
016300     MOVE SPACES TO BUF-DFMASTER.
           READ MASTER-RECORD-EQPREF INTO BUF-DFMASTER
               INVALID KEY     MOVE 17 TO COND-WORD.
           IF MRE-STATUS NOT = "00" MOVE 17 TO COND-WORD.
018100     IF COND-WORD = 17 GO TO 2-EOJ.
018500     CALL "TPWORD" USING PASSWORD-INFORMATION.
018900     IF PASSWORD-FLAG = "N" GO TO 2-EOJ.
020600     MOVE SPACES TO LAST-WO-USED-DATA.
           READ WO-LAST-NUM-USED INTO LAST-WO-USED-DATA
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF WLNU-STATUS NOT = "00" MOVE 17 TO COND-WORD.
021100     IF COND-WORD NOT = 0 MOVE 1 TO DATE-FLAG-SW.
022700     MOVE DATE-FLAG-SW TO DATE-FLAG.
           MOVE SPACES TO DSPLY-REC SCREEN-BUFFER.
025800 6-MAIN.
           IF INDS (99) = TRUE-VAL
               MOVE MESSAGE-BUFFER TO SCREEN-ERR-LINE
               MOVE SPACES         TO MESSAGE-BUFFER
           ELSE
           MOVE SPACES TO SCREEN-ERR-LINE.
           MOVE 66292 TO CATREAD-MSG-NUMBER.
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
           MOVE MESSAGE-BUFFER TO SCREEN-CMD-LINE.
           MOVE SCREEN-BUFFER TO DSPLY-REC.
025900     MOVE "FIEREXEC" TO VIEW-CFNAME.
           PERFORM 99-SCREEN-WRITE.
           PERFORM 98-SCREEN-READ.
           MOVE DSPLY-REC TO SCREEN-BUFFER.
           MOVE SCREEN-EQP-DISP TO EQP-NUM-BUF.
032900     IF VIEW-LASTKEY = 3 GO TO 6-MAIN-EXIT.
033200     IF VIEW-LASTKEY = 6 OR 7 GO TO 6-MAIN-LOOP.
033500     IF VIEW-LASTKEY = 0
033600         MOVE 42017 TO CATREAD-MSG-NUMBER
033800**MESSAGE******************************************************
033900** PRESS APPROPRIATE FUNCTION KEY TO CONTINUE                **
034000***************************************************************
034100         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER TO SCREEN-CMD-LINE
034200         MOVE TRUE-VAL TO INDS (98)
               MOVE SCREEN-BUFFER TO DSPLY-REC
               PERFORM 99-SCREEN-WRITE
               PERFORM 98A-SCREEN-READ
               CALL "CLPAUSE2"
034400         GO TO 6-MAIN.
029000     MOVE EQP-SUB-BUFFER TO EQP-SAVE-BUFFER.
029100     IF EQP-NUM-BUF = SPACES
029200         MOVE SPACES TO SCREEN-BUFFER
029300     ELSE
029500     MOVE EQP-NUM-BUF TO EQP-NUM
029600     MOVE SPACES TO CE-LITERAL
029700     MOVE 29063 TO CATREAD-MSG-NUMBER
029900**MESSAGE******************************************************
030000** CURRENT EQUIPMENT NUMBER IS                               **
030100***************************************************************
030200     PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
030300     MOVE MESSAGE-LIT TO CE-LITERAL
030400     MOVE CUR-EQP-DISP TO SCREEN-C-E-DISP.
030500     MOVE SPACES TO EQP-SUB-BUFFER.
034600     IF EQP-NUM-SAVE NOT = SPACES
035200         MOVE SCREEN-EQP-DISP TO EQP-NUM-BUF
035300         IF EQP-NUM-BUF = SPACES
035400             MOVE EQP-SAVE-BUFFER TO EQP-SUB-BUFFER
035500             GO TO 6-MAIN-LOOP.
036300     IF SCREEN-EQP-DISP = SPACES
036400         MOVE 31016 TO CATREAD-MSG-NUMBER
036600**MESSAGE******************************************************
036700** EQUIPMENT NUMBER IS REQUIRED                              **
036800***************************************************************
036900         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
037000         MOVE TRUE-VAL TO INDS (1) INDS (99)
037200         GO TO 6-MAIN.
037400     MOVE SCREEN-EQP-DISP TO EQP-NUM-BUF.
037900     PERFORM 69-START-EQUIPMENT-FILE.
           IF COND-WORD = 17
03870          MOVE ZEROS TO EQP-TYPE-BUF
03880          MOVE 30052 TO CATREAD-MSG-NUMBER
039000**MESSAGE******************************************************
039100** DEVICE NOT IN EQUIPMENT FILE                              **
039200***************************************************************
039300         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER TO EQP-SUB-DESC
           ELSE
           PERFORM 69-READ-EQUIPMENT-FILE
038200     IF COND-WORD = 0
038300         MOVE EQP-TYPE TO EQP-TYPE-BUF
038400         MOVE EQP-EQUIP-NAME TO TEMP-BUFFER
038500         MOVE DESC-BUFFER    TO EQP-SUB-DESC
038600     ELSE
03870      MOVE ZEROS TO EQP-TYPE-BUF
03880      MOVE 30052 TO CATREAD-MSG-NUMBER
039000**MESSAGE******************************************************
039100** DEVICE NOT IN EQUIPMENT FILE                              **
039200***************************************************************
039300     PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
           MOVE MESSAGE-BUFFER TO EQP-SUB-DESC.
039500
039600 6-MAIN-LOOP.
040000     IF VIEW-LASTKEY = 2
040100         MOVE "A" TO ACD-SW
040200         MOVE 27048 TO CATREAD-MSG-NUMBER
040400**MESSAGE******************************************************
040500** ADD                                                       **
040600***************************************************************
040700         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
040800         MOVE MESSAGE-BUFFER TO ACD-FUNCTION
040900         CALL "TIERREFA" USING VIEW-COMAREA
                                     DBPARAMETERS
041300                               EQP-SUB-BUFFER
               IF VIEW-LASTKEY = 3
                   GO TO 6-MAIN-EXIT
               ELSE
               MOVE 0 TO VIEW-LASTKEY
041800         GO TO 6-MAIN.
041900
042000     IF VIEW-LASTKEY = 4
042100         MOVE "C" TO ACD-SW
042200         MOVE 29061 TO CATREAD-MSG-NUMBER
042400**MESSAGE******************************************************
042500** CHANGE                                                    **
042600***************************************************************
042700         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
042800         MOVE MESSAGE-BUFFER TO ACD-FUNCTION
042900         CALL "TIERREFC" USING VIEW-COMAREA
                                     DBPARAMETERS
043300                               EQP-SUB-BUFFER
               IF VIEW-LASTKEY = 3
                   GO TO 6-MAIN-EXIT
               ELSE
               MOVE 0 TO VIEW-LASTKEY
043800         GO TO 6-MAIN.
043900
044000     IF VIEW-LASTKEY = 5
044100         MOVE "D" TO ACD-SW
044200         MOVE 30053 TO CATREAD-MSG-NUMBER
044400**MESSAGE******************************************************
044500** DELETE                                                    **
044600***************************************************************
044700         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
044800         MOVE MESSAGE-BUFFER TO ACD-FUNCTION
044900         CALL "TIERDEL" USING VIEW-COMAREA
                                    DBPARAMETERS
045300                              EQP-SUB-BUFFER
               IF VIEW-LASTKEY = 3
                   GO TO 6-MAIN-EXIT
               ELSE
               MOVE 0 TO VIEW-LASTKEY
045800         GO TO 6-MAIN.
045900
046000     IF VIEW-LASTKEY = 6
046100         CALL "TIERTYPE" USING VIEW-COMAREA
                                     DBPARAMETERS
046500                               EQP-SUB-BUFFER
               IF VIEW-LASTKEY = 3
                   GO TO 6-MAIN-EXIT
               ELSE
               MOVE 0 TO VIEW-LASTKEY
047000         GO TO 6-MAIN.
047100
047200     IF VIEW-LASTKEY = 7
047300         CALL "TIERTITL" USING VIEW-COMAREA
                                     DBPARAMETERS
048000         MOVE SPACES TO EQP-NUM-BUF
               MOVE 0 TO VIEW-LASTKEY
048200         GO TO 6-MAIN.
048300     GO TO 6-MAIN.

       6-MAIN-EXIT.    EXIT.
048400
       69-START-EQUIPMENT-FILE.
           MOVE 0 TO COND-WORD.
           MOVE EQP-NUM-BUF TO EQPNUM OF EFREC.
           START EQUIPMENT-FILE KEY IS = EXTERNALLY-DESCRIBED-KEY
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF EF-STATUS NOT = "00" MOVE 17 TO COND-WORD.

       69-READ-EQUIPMENT-FILE.
           MOVE 0 TO COND-WORD.
           READ EQUIPMENT-FILE NEXT INTO EQP-EQUIPMENT
               AT END    MOVE 15 TO COND-WORD.
           IF EF-STATUS NOT = "00" MOVE 15 TO COND-WORD.

       98-SCREEN-READ.
           READ DISPLAY-FILE FORMAT IS VIEW-CFNAME
               INDIC IS INDICS.
           ACCEPT IOFEEDBACK FROM I-O-FEEDBACK-AREA.
           MOVE ALL B"0" TO INDICS.
           IF DSPLY-STATUS NOT = "00"
               MOVE 3 TO VIEW-LASTKEY
           ELSE
           MOVE FUNCTION-NUM TO VIEW-LASTKEY.

       98A-SCREEN-READ.
           READ DISPLAY-FILE TERMINAL IS TERMINAL-ID
               INDIC IS INDICS
                  NO DATA MOVE DSPLY-STATUS TO DSPLY-STATUS.
           MOVE ALL B"0" TO INDICS.

       99-SCREEN-WRITE.
           WRITE DSPLY-REC FORMAT IS VIEW-CFNAME
               INDIC IS INDICS.
           MOVE ALL B"0" TO INDICS.

049900 999-CATREAD.
050000     MOVE SPACES TO MESSAGE-BUFFER.
           CALL "CCATREAD" USING CATREAD-PARMS.
           MOVE CATREAD-MSG-TEXT TO MESSAGE-BUFFER.
051000 999-CATREAD-EXIT.    EXIT.
