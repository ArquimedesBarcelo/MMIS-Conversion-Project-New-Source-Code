       LINKAGE SECTION.
025500 COPY THDPRTB OF COPYLIB.
008200 01  ACCEPT-FIELDS.
008300     05  ACCEPT-QUOTE OCCURS 3 TIMES   PIC X(6).
008400     05  ACCEPT-REPORT                 PIC X(1).
008500     05  FILLER                        PIC X(61).
           05  FILLER                        PIC X(81).
022200 PROCEDURE DIVISION USING HD-ROUTE-DATA ACCEPT-FIELDS.
022300 100-BEGIN.
022400
020300*----------  SET UP PRINTER ESCAPE SEQUENCES
020400     CALL "TESCSEQ" USING ESC-NAME.
020500     MOVE CHAR-1636PI     TO COMPRESS-PRINT.
020600     MOVE CHAR-10PI       TO NORMAL-PRINT.
020700     MOVE TEXT-LENGTH-61 TO ESC-TEXT-61.
020800     MOVE TEXT-LENGTH-60 TO ESC-TEXT-60.
021800
078400*----------  OPEN OUTPUT FILE
           MOVE HD-SPOOLER-NUMBER TO OVRPRTF-TOFILE-NUM.
           MOVE "*YES"       TO OVRPRTF-SHARED.
028100     MOVE HD-NO-OF-COPIES TO OVRPRTF-COPIES.
           MOVE "MCPRT"      TO OVRPRTF-FILE.
           PERFORM 996-OVERRIDE-PRINT-FILE.
      *----- CALL CCRTFILE TO CREATE A TEMPORARY FILE FOR SORTING
      *----- LIBRARY 'QTEMP' IS USED FOR TEMPORARY FILES
           MOVE SPACES        TO CCRTFILE-PARMS.
           MOVE "QTEMP"       TO CCRTFILE-LIBRARY.
           MOVE "SORTED"      TO CCRTFILE-FILE.
           MOVE "0032"        TO CCRTFILE-RECORD-LENGTH.
           MOVE "90000"       TO CCRTFILE-NO-RECORDS.
           MOVE "02000"       TO CCRTFILE-INCREMENT-AMT.
           MOVE "10"          TO CCRTFILE-NO-INCREMENTS.
           CALL "CCRTFILE" USING CCRTFILE-LIBRARY,
                                 CCRTFILE-FILE,
                                 CCRTFILE-RECORD-LENGTH,
                                 CCRTFILE-NO-RECORDS,
                                 CCRTFILE-INCREMENT-AMT,
                                 CCRTFILE-NO-INCREMENTS,
                                 CCRTFILE-STATUS.
           IF CCRTFILE-STATUS NOT = "00"
               MOVE "CCRTFILE CREATE OF 'SORTED' FAILED"
                  TO BU-DISPLAY-MSG
               PERFORM 990-BLOWUP THRU 999-EXIT.
021100     OPEN OUTPUT PRINT-FILE.
021900*----------  PRINT HEADER PAGE
022100     MOVE "DHDR81.PUB" TO HD-FILE-NAME.
022200     CALL "THDPRT2" USING HD-RET-CODE, HD-FILE-NAME,
022300        FNUM, HD-ROUTE-DATA, ESC-NAME.
022400     IF PAPER-IS-132-COLS
022500          NEXT SENTENCE
022600     ELSE
022700         WRITE PRT-REC FROM COMPRESS-PRINT AFTER ADVANCING 0
022800         WRITE PRT-REC FROM ESC-TEXT-61 AFTER ADVANCING 0.
022900     IF HD-RET-CODE NOT = 0
023000         DISPLAY "THDRPT ERROR".
023400
025300     MOVE HD-SPOOLER-NUMBER TO SPOOL-PRT.
025400
025500*----------  SET UP HEADING LITERALS FOR REPORT
025600     MOVE 1 TO DATE-MODE.
025700     CALL "TDATECHK" USING DATE-CHECK-AREA.
025900     MOVE DATE-SLASH-OUT                 TO H1-DATE.
026000*****MOVE DATE-FORMATTED-TIME-OUT        TO H1-TIME.
           MOVE DATE-FORMATTED-TIME-OUT        TO H2-TIME.
026200     MOVE "COMPARE QUOTE BIDS"
026300                                         TO H1-TITLE.
026400*****MOVE "PROGRAM TQTCOMPR"             TO H1-PROGRAM.
026500*****MOVE "PAGE "                        TO H1-PAGE.
           MOVE "PAGE "                        TO H2-PAGE.
026600     IF ACCEPT-REPORT = "S"
026700        MOVE "SUMMARY REPORT"            TO H2-TITLE
026800     ELSE
026900        MOVE "DETAIL REPORT "            TO H2-TITLE.
027000
027100     MOVE "QUOTE:"                       TO H3-QUOTE-TITLE.
027200     MOVE "VENDOR CODE:"                 TO H4-VENDOR-CODE.
027300     MOVE "VENDOR NAME:"                 TO H5-VENDOR-NAME.
027400     MOVE "CORP CODE"                    TO H6-CODE.
027500     MOVE "PRICE  X   QTY  =  EXT AMOUNT"
027600          TO H6-ITEM1, H6-ITEM2, H6-ITEM3.
027700     MOVE ZEROES TO WORK-EXT (1), WORK-EXT (2), WORK-EXT (3).
027710     MOVE ALL "-" TO TD-DASH1, TD-DASH2, TD-DASH3.
027720     MOVE ALL "-" TO H7-CODE H7-ITEM1 H7-ITEM2 H7-ITEM3.
027800
           OPEN INPUT DVENDOR-I DVENDITM-I DCODE-I.
028300
028400*----------  PROCESS REPORT DATA
028600     SORT SORT-FILE
028700          ON ASCENDING KEY SRT-CODE SRT-QUOTE
028800          INPUT  PROCEDURE IS 200-INPUT-RECORDS THRU 299-EXIT
028900          OUTPUT PROCEDURE IS 300-WRITE-RECORDS THRU 399-EXIT.
029000
029100*----------  PRINT REPORT, CLOSE FILES, AND QUIT
029200     IF PAPER-IS-132-COLS
029300         NEXT SENTENCE
029400     ELSE
029500         WRITE PRT-REC FROM NORMAL-PRINT AFTER ADVANCING 0
029600         WRITE PRT-REC FROM ESC-TEXT-60 AFTER ADVANCING 0.
029700
029800     MOVE HD-NO-OF-COPIES TO SPOOL-COPIES.
030200
030300     CLOSE PRINT-FILE.
030400     CLOSE DVENDOR-I DVENDITM-I DCODE-I.
030500     GOBACK.
030600
030700***********************************************************************
030800*       INPUT SECTION:  RETRIEVE VENDOR RECORDS FOR SORTING           *
030900***********************************************************************
031000 200-INPUT-RECORDS.
031100     MOVE 0 TO X.
031200     PERFORM 205-PROCESS-EACH-QUOTE THRU 290-EXIT UNTIL
031300             ALL-INPUT-RECORDS-PROCESSED.
031400     GO TO 299-EXIT.
031500
031600 205-PROCESS-EACH-QUOTE.
032200     ADD 1 TO X.
032500     IF X > 3
032600        MOVE "Y" TO END-OF-INPUT-FILE
032700        GO TO 290-EXIT.
032300     IF ACCEPT-QUOTE (X) = "000000" OR
032310         ACCEPT-QUOTE (X) = SPACES
032450           GO TO 205-PROCESS-EACH-QUOTE.
032800
032900     MOVE ACCEPT-QUOTE (X) TO QUOTE-ARG.
           MOVE 0 TO COND-WORD.
           MOVE QUOTE-ARG TO QUOTENUM OF DVENDITM-REC-I.
           START DVENDITM-I KEY = QUOTENUM OF DVENDITM-REC-I
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
                   MOVE 17 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.
033200     IF NOT GOOD-CALL
033300        IF X = 1
033400           MOVE "QUOTE NOT FOUND" TO H5-VENDOR1
033410           GO TO 205-PROCESS-EACH-QUOTE
033500        ELSE
033501           IF X = 2
033502              MOVE "QUOTE NOT FOUND" TO H5-VENDOR2
033503              GO TO 205-PROCESS-EACH-QUOTE
033506           ELSE
033507              MOVE "QUOTE NOT FOUND" TO H5-VENDOR3
033508              GO TO 205-PROCESS-EACH-QUOTE.
033510     MOVE "N" TO FOUND-VENDOR.
033600 210-PROCESS-INPUT-RECORDS.
033700     MOVE SPACES TO SORT-REC.
           MOVE 0 TO COND-WORD.
           READ DVENDITM-I NEXT INTO BUF-DVENDITM
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   MOVE 15 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.
           IF QUOTENUM OF DVENDITM-REC-I NOT = QUOTE-ARG
               MOVE 15 TO COND-WORD.
034000     IF COND-WORD = 15
034100         GO TO 205-PROCESS-EACH-QUOTE
034200     ELSE
034300     IF COND-WORD NOT = 0
034400         MOVE "DBGET DVENDITM  210 TQTCOMPR" TO BU-DISPLAY-MSG
034500         PERFORM 990-BLOWUP THRU 999-EXIT.
034600     IF FOUND-VENDOR = "N"
034610        MOVE VEN-ITM-VENCODE TO VEN-ARG
034620        PERFORM 215-GET-NAME THRU 219-EXIT
034630        MOVE "Y" TO FOUND-VENDOR.
034700
034710     IF VEN-ITM-CORPCODE = "NON-STR"
034720        GO TO 210-PROCESS-INPUT-RECORDS.
034730
034800     MOVE VEN-ITM-CORPCODE      TO SRT-CODE.
034900     MOVE X                     TO SRT-QUOTE.
035000     MOVE VEN-BID-QTY           TO SRT-BID-QTY.
035100     MOVE VEN-ITM-PRICE         TO SRT-PRICE.
035200     IF VEN-BID-QTY NOT < VEN-LOW-QTY (1)
035300        IF VEN-BID-QTY NOT > VEN-HIGH-QTY (1)
035310           MOVE "V" TO SRT-FLAG
035400           MOVE VEN-WORK-PRICE (1) TO SRT-PRICE.
035500     IF VEN-BID-QTY NOT < VEN-LOW-QTY (2)
035600        IF VEN-BID-QTY NOT > VEN-HIGH-QTY (2)
035610           MOVE "V" TO SRT-FLAG
035700           MOVE VEN-WORK-PRICE (2) TO SRT-PRICE.
035800     IF VEN-BID-QTY NOT < VEN-LOW-QTY (3)
035900        IF VEN-BID-QTY NOT > VEN-HIGH-QTY (3)
035910           MOVE "V" TO SRT-FLAG
036000           MOVE VEN-WORK-PRICE (3) TO SRT-PRICE.
036100
           IF VEN-BID-QTY = ZERO
              MOVE " " TO SRT-FLAG.
036200     IF SRT-PRICE = ZERO
036300        MOVE VEN-ITM-PRICE    TO SRT-PRICE.
036400     RELEASE SORT-REC.
036500
036600     GO TO 210-PROCESS-INPUT-RECORDS.
036700
036720*----------  GET VENDOR NAME
036730 215-GET-NAME.
           MOVE 0 TO COND-WORD.
           MOVE VEN-ARG TO VENCDE OF DVENDOR-REC-I.
           START DVENDOR-I KEY = VENCDE OF DVENDOR-REC-I
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
                   MOVE 17 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.
036733     IF NOT GOOD-CALL
036734        GO TO 219-EXIT.
036735
036736 217-GET-NAME.
           MOVE 0 TO COND-WORD.
           READ DVENDOR-I NEXT INTO BUF-DVENDOR
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   MOVE 15 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.
           IF VENCDE OF DVENDOR-REC-I NOT = VEN-ARG
               MOVE 15 TO COND-WORD.
036760     IF END-OF-CHAIN
036770        GO TO 219-EXIT
036780     ELSE
036790        IF NOT GOOD-CALL
036800           MOVE "DBGET DVENDOR 811 AT TQTCOMPR" TO BU-DISPLAY-MSG
036810           PERFORM 990-BLOWUP THRU 999-EXIT.
036820
036830     IF VEN-ITM-NO NOT = "00"
036840        GO TO 217-GET-NAME.
036850
036860     IF X = 1
036870        MOVE VEN-NAME TO H5-VENDOR1
036880        MOVE VEN-ARG TO H4-CODE1
036890     ELSE
036900        IF X = 2
036910           MOVE VEN-NAME TO H5-VENDOR2
036920           MOVE VEN-ARG TO H4-CODE2
036930        ELSE
036940           MOVE VEN-NAME TO H5-VENDOR3
036950           MOVE VEN-ARG TO H4-CODE3.
036960
036970 219-EXIT.  EXIT.
038600
038700 290-EXIT.  EXIT.
038800 299-EXIT.  EXIT.
038900
039000***********************************************************************
039100*     OUTPUT SECTION:  WRITE VENDOR RECORDS TO CREATE REPORT          *
039200***********************************************************************
039300 300-WRITE-RECORDS.
039400     RETURN SORT-FILE AT END
039500         MOVE "Y" TO END-OF-SORT-FILE
039510         MOVE SRT-CODE TO COMPARE-CODE
039600         PERFORM 940-PRINT-HEADINGS THRU 949-EXIT
039700         MOVE NO-SORTED-RECORDS TO PRT-REC
039800         WRITE PRT-REC AFTER ADVANCING 2 LINES
039900         GO TO 399-EXIT.
040000
040010     MOVE SPACES TO LINE1.
040100     PERFORM 310-PROCESS-SORTED-RECORDS THRU 390-EXIT
040200             UNTIL ALL-SORTED-RECORDS-PROCESSED.
040201     MOVE WORK-EXT (1) TO T1-QUOTE1.
040202     MOVE WORK-EXT (2) TO T1-QUOTE2.
040203     MOVE WORK-EXT (3) TO T1-QUOTE3.
040204     WRITE PRT-REC FROM TOTAL-DASH AFTER ADVANCING 2 LINES.
040210     WRITE PRT-REC FROM TOTAL1 AFTER ADVANCING 1 LINES.
040220     MOVE SPACES TO PRT-REC.
040230     MOVE "V = VOLUME DISCOUNTS" TO PRT-REC.
040240     WRITE PRT-REC AFTER ADVANCING 2 LINES.
040250
040300     GO TO 399-EXIT.
040400
040500 310-PROCESS-SORTED-RECORDS.
040600     IF LINE-K > 60
040700         PERFORM 940-PRINT-HEADINGS THRU 949-EXIT.
040800
041000
041010     IF ACCEPT-REPORT NOT = "S"
041100       IF SRT-CODE NOT = COMPARE-CODE
              MOVE COMPARE-CODE TO CORPCDE OF DCODE-REC-I
041200        MOVE SRT-CODE TO COMPARE-CODE
041300        MOVE SPACES TO PRT-REC
041400        WRITE PRT-REC FROM LINE1 AFTER ADVANCING 1 LINE
041410        MOVE SPACES TO LINE1
              PERFORM 950-GET-KWD-MOD
041500        ADD 1 TO LINE-K.
041600
041700     MOVE SRT-CODE TO L1-CODE.
041800     MOVE SRT-PRICE TO L1-PRICE (SRT-QUOTE).
041900     MOVE SRT-BID-QTY TO L1-QTY (SRT-QUOTE).
042000*****COMPUTE L1-EXT-WORK = SRT-BID-QTY * SRT-PRICE.
           COMPUTE L1-EXT-WORK ROUNDED = SRT-BID-QTY * SRT-PRICE.
042010     MOVE L1-EXT-WORK TO L1-EXT (SRT-QUOTE).
042020     MOVE SRT-FLAG TO L1-VOLUME-DISCOUNT (SRT-QUOTE).
042100
042200     COMPUTE WORK-EXT (SRT-QUOTE) =
042210         WORK-EXT (SRT-QUOTE) + L1-EXT-WORK.
042300
042400     RETURN SORT-FILE AT END
042500        MOVE SPACES TO PRT-REC
042501        PERFORM 385-PRINT-LAST-LINE
042502        MOVE "Y" TO END-OF-SORT-FILE.
042503     GO TO 390-EXIT.
042504
042505 385-PRINT-LAST-LINE.
042510        IF ACCEPT-REPORT NOT = "S"
042600           WRITE PRT-REC FROM LINE1 AFTER ADVANCING 1 LINE
                 MOVE COMPARE-CODE TO CORPCDE OF DCODE-REC-I
                 PERFORM 950-GET-KWD-MOD.
042900
043000 390-EXIT.  EXIT.
043100 399-EXIT.  EXIT.
043400 940-PRINT-HEADINGS.
043410     MOVE ACCEPT-QUOTE (1) TO H3-QUOTE1.
043420     MOVE ACCEPT-QUOTE (2) TO H3-QUOTE2.
043430     MOVE ACCEPT-QUOTE (3) TO H3-QUOTE3.
043500     ADD 1 TO PAGE-K.
043600*****MOVE PAGE-K TO H1-PAGE-NO.
           MOVE PAGE-K TO H2-PAGE-NO.
043700     WRITE PRT-REC FROM HDR-1 AFTER ADVANCING NEW-PAGE.
043800     WRITE PRT-REC FROM HDR-2 AFTER ADVANCING 1 LINE.
043900     WRITE PRT-REC FROM HDR-3 AFTER ADVANCING 3 LINES.
044000     WRITE PRT-REC FROM HDR-4 AFTER ADVANCING 1 LINE.
044100     WRITE PRT-REC FROM HDR-5 AFTER ADVANCING 1 LINE.
044200     WRITE PRT-REC FROM HDR-6 AFTER ADVANCING 2 LINES.
044210     WRITE PRT-REC FROM HDR-7 AFTER ADVANCING 1 LINES.
044300     MOVE 8 TO LINE-K.
044400 949-EXIT.  EXIT.

       950-GET-KWD-MOD.
           READ DCODE-I INTO BUF-DCODE
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           MOVE SPACES               TO  LINE2.
           IF FILE-STATUS = "00"
               STRING CODE-KEYWORD   DELIMITED BY SPACES
                      ", "           DELIMITED BY SIZE
                      CODE-MODIFIER  DELIMITED BY SPACES
                   INTO L2-KWD-MOD
               WRITE PRT-REC FROM LINE2 AFTER ADVANCING 1 LINE
               ADD 1                 TO  LINE-K.

       COPY OVRPFCALL OF COPYLIB.
044500
044600*************************************************************
044700*                    BLOWUP   ROUTINE                       *
044800*************************************************************
044900 990-BLOWUP.
045000     WRITE PRT-REC FROM ESC-TEXT-61  AFTER ADVANCING 0.
045100     WRITE PRT-REC FROM NORMAL-PRINT AFTER ADVANCING 0.
045200
045300     MOVE "TQTCOMPR" TO BU-PGM-NAME.
045400     MOVE QUOTE-ARG TO BU-DISPLAY-FLD (1).
045600     CALL "TBLOWUP" USING BASE, BU-PGM-NAME, STATUS-AREA,
045700           VIEW-COMAREA, FILE-STATUS, BU-DISPLAY-MSG,
045800           BU-DISPLAY-AREA.
045900
046000 999-EXIT.  EXIT.
