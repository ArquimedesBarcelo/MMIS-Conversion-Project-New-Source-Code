       WORKING-STORAGE SECTION.
       01  FILE-STATUS.
           05  FILE-STATUS-1            PIC X  VALUE "0".
           05  FILE-STATUS-2            PIC X  VALUE "0".
       77  SUB                        PIC S9(4) COMP-4 VALUE ZEROS.
       77  SAVE-FILE-STATUS           PIC 99           VALUE ZEROS.

DCR01  COPY POLOGSUBWS IN COPYLIB.

DCR01  COPY CPOLOGPRM   IN COPYLIB.


      **************************
      *                        *
      *  SWITCHES              *
      *                        *
      **************************

       01  SWITCH-AREA.
           05  NO-ITEM-SW             PIC X.
               88  NO-ITEM-ON                 VALUE "Y".


       01  BUILD-RCVR-NUMBER.
           05  BUILD-RCVR-PO-P        PIC X(1)  VALUE "P".
           05  BUILD-RCVR-PO-REL      PIC X(10) VALUE SPACES.
           05  BUILD-RCVR-NO          PIC X(3)  VALUE SPACES.


       01  WORK-AREA.
           05  SAVE-LAST-RCVR         PIC 9(3)  VALUE ZEROS.
           05  FORMAT-DATE            PIC 9(8)  VALUE ZEROS.

