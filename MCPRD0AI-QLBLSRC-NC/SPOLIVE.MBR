      *********************

       01  DSET-NAMES.
           05  DSET-NAME              PIC X(16)  VALUE SPACES.
           05  DSET-DPORECD           PIC X(16)  VALUE "DPORECD;".
           05  DSET-MPORCV            PIC X(16)  VALUE "MPORCV;".
           05  DSET-DREQD             PIC X(16)  VALUE "DREQD;".
           05  DSET-DREQITM           PIC X(16)  VALUE "DREQITM;".
           05  DSET-DPOITEM           PIC X(16)  VALUE "DPOITEM;".
           05  DSET-DPODATAITM        PIC X(16)  VALUE "DPODATAITM;".
           05  DSET-DPOFREIGHT        PIC X(16)  VALUE "DPOFREIGHT;".
           05  DSET-DINVRCD           PIC X(16)  VALUE "DINVRCD;".
           05  DSET-DINVITM           PIC X(16)  VALUE "DINVITM;".
           05  DSET-DINVACCT          PIC X(16)  VALUE "DINVACCT;".
           05  DSET-DVENDOR           PIC X(16)  VALUE "DVENDOR;".
           05  DSET-MSTORERM          PIC X(16)  VALUE "MSTORERM;".
           05  DSET-DRCVITEM          PIC X(16)  VALUE "DRCVITEM;".

      ********* DSET NAMES FOR STORES HISTORY 'STHIST'

           05  DSET-DPODESC-H         PIC X(16)  VALUE "DPODESC;".


       COPY DBMODES IN COPYLIB.

       COPY DBSTAT  IN COPYLIB.

       01 ITEMS-LISTING.
           05  ALL-ITEMS              PIC XX    VALUE "@;".
           05  CODE-SEARCH            PIC X(10) VALUE "CORP-CODE;".
           05  REQ-SEARCH             PIC X(12) VALUE "REQ-NUMBER;".
           05  PO-SEARCH              PIC X(10) VALUE "PO-RCV-NO;".
           05  VEN-SEARCH             PIC X(10) VALUE "VEN-CODE;".
           05  REG-SEARCH             PIC X(16)
                                      VALUE "REGISTER-NUMBER;".

       01  ARG-VALUES.
           05  REQ-ARG                PIC X(12) VALUE SPACES.
           05  PO-ARG                 PIC X(14) VALUE SPACES.
           05  VEN-ARG                PIC X(10) VALUE SPACES.
           05  REGISTER-ARG           PIC X(6)  VALUE SPACES.
PDR        05  PLT-ARG                PIC X(4)  VALUE SPACES.
           05  RCVR-ARG.
               10  RCVR-PO-NUM        PIC X(7)  VALUE SPACES.
               10  RCVR-PO-REL        PIC X(3)  VALUE SPACES.
               10  RCVR-PO-RCVR       PIC 9(3)  VALUE ZEROS.
               10  RCVR-PO-DUP        PIC X     VALUE SPACES.


       COPY MULTLOCK IN COPYLIB.

       COPY TDATECHK IN COPYLIB.

       COPY TBLOWUP IN COPYLIB.

       COPY CATREAD IN COPYLIB.

       LINKAGE SECTION.

       01  BASE             PIC X(10).

       01  BUILD-PO-NUMBER  PIC X(14).

       01  COMPANY-SAVE     PIC X(3).

       01  ALT-VEN-CODE     PIC X(10).

       01  BASE-STHIST      PIC X(10).

       01  BUILD-POH-NUMBER PIC X(14).

       COPY VCOMLINK IN COPYLIB.

       PROCEDURE DIVISION USING  BASE,
                                 BUILD-PO-NUMBER,
                                 COMPANY-SAVE,
                                 ALT-VEN-CODE,
                                 BASE-STHIST,
                                 BUILD-POH-NUMBER,
                                 VIEW-COMAREA.



       PO-LIVE-UPDATE SECTION 10.
       P-L-U.
           OPEN INPUT DPORECDH-I, DPOITEMH-I, DPODESCH-I,
                      DPOFREIGHTH-I, DRCVITEMH-I, DINVRCDH-I,
                      DINVITMH-I, DINVACCTH-I, DRCVCORRH-I DRCVTRAKH-I.
           OPEN I-O   MPORCV-O, DPORECD-O, DPOITEM-O,
                      DPODATAITM-O, DPOFREIGHT-O, DRCVITEM-O,
                      DINVRCD-O, DINVITM-O, DINVACCT-O,
                      DRCVCORR-O, DRCVTRAK-O.
           OPEN INPUT DINVRCD-RG-I.
           OPEN I-O MPLTINFO-PK-O.

DCR01      PERFORM Z000-PGM-SETUP     THRU Z000-PS-EXIT.

           PERFORM 6-MAIN  THRU  6-MAIN-X.

           CLOSE DPORECDH-I, DPOITEMH-I, DPODESCH-I,
                 DPOFREIGHTH-I, DRCVITEMH-I, DINVRCDH-I,
                 DINVITMH-I, DINVACCTH-I, DRCVCORRH-I,
                 MPORCV-O, DPORECD-O, DPOITEM-O,
                 DPODATAITM-O, DPOFREIGHT-O, DRCVITEM-O,
                 DINVRCD-O, DINVITM-O, DINVACCT-O, DRCVCORR-O,
                 DRCVTRAKH-I, DRCVTRAK-O.
           CLOSE DINVRCD-RG-I.
           CLOSE MPLTINFO-PK-O.
           GOBACK.


DCR01  Z000-PGM-SETUP.
DCR01
DCR01 *****************************************************
DCR01 *   MAKE SURE PO LOGGING IS ACTIVE FOR THIS PLANT
DCR01 *****************************************************
DCR01      SET  Z000-POLG-ACTIVE-NO TO TRUE.
DCR01
DCR01      MOVE WS-Z000-POLG-KEY         TO  PLT-ARG.
DCR01      PERFORM 9999-GETKEY-MPLTINFO-PK-O.
DCR01      IF FILE-STATUS = "00"
DCR01         IF  PLTINFODTA(1:1) = "Y"
DCR01             SET  Z000-POLG-ACTIVE-YES TO TRUE
DCR01         END-IF
DCR01      END-IF.
DCR01
DCR01      IF   Z000-POLG-ACTIVE-NO
DCR01           GO TO Z000-PS-EXIT
DCR01      END-IF.
DCR01
DCR01 ******************************************************************
DCR01 * GET PLANT CODE                                                 *
DCR01 ******************************************************************
DCR01      MOVE  WS-Z000-CMPNY-KEY  TO PLT-ARG.
DCR01      PERFORM 9999-GETKEY-MPLTINFO-PK-O.
DCR01      IF NO-ENTRY
DCR01         MOVE "MPLTINFO * NO PLTCD 'P 01'" TO BU-DISPLAY-MSG
DCR01         GO TO 2100-BLOWUP
DCR01      END-IF.

DCR01      MOVE PLTINFODTA(1:3)  TO WS-Z000-PLANT-CODE.

DCR01  Z000-PS-EXIT.
DCR01      EXIT.


      ******************************************************
      **                                                  **
      **   BLOWUP ROUTINE                                 **
      **                                                  **
      ******************************************************

       2-BLOWUP.
           MOVE "SPOLIVE"  TO BU-PGM-NAME.
           CALL "TBLOWUP" USING BASE, BU-PGM-NAME, STATUS-AREA,
               VIEW-COMAREA, FILE-STATUS, BU-DISPLAY-MSG,
                   BU-DISPLAY-FLDS.

       2100-BLOWUP.
               PERFORM 70-BACKOUT-ROUTINE   THRU 70-BR-X
               GO TO 2-BLOWUP.

       3-BLOWUP.
           MOVE "SPOLIVE"  TO BU-PGM-NAME.
           CALL "TBLOWUP" USING BASE-STHIST, BU-PGM-NAME, STATUS-AREA,
               DUMMY-VIEW-AREA, FILE-STATUS, BU-DISPLAY-MSG,
                   BU-DISPLAY-FLDS.


       6-MAIN.

           MOVE BUILD-PO-NUMBER       TO  BU-DISPLAY-FLD (1).

           PERFORM 62-LOAD-PO-HISTORY         THRU  62-LPH-X.

           PERFORM 63-LOAD-RECEIVING-HISTORY  THRU  63-LRH-X.

PDR   ******************************************************************
PDR   *     HOLD "PREG" RECORD IN MPLTINFO WHILE RECALLING INVOICE     *
PDR   *     INFORMATION, TO INSURE NO DUPLICATION OF REGISTER NUMBERS  *
PDR   *     IN THE LIVE DATABASE.         PDR                          *
PDR   ******************************************************************
PDR        MOVE "PREG"   TO PLT-ARG.
PDR        PERFORM 9999-GETKEY-MPLTINFO-PK-O.
PDR        IF NO-ENTRY
PDR            MOVE "MPLTINFO * NO ENTRY 'PREG'" TO BU-DISPLAY-MSG
PDR            GO TO 2100-BLOWUP.

           PERFORM 64-LOAD-INVOICING-HISTORY  THRU  64-LIH-X.

PDR        PERFORM 9999-RESET-MPLTINFO-PK-O.

       6-MAIN-X.
           EXIT.




       62-LOAD-PO-HISTORY.
           MOVE BUILD-POH-NUMBER      TO  PO-ARG.
           MOVE PO-ARG                TO  PORCVNO OF DPORECDH-REC-I.
           READ DPORECDH-I INTO BUF-DPORECD-H
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE "READ DPORECD * 62-LPH" TO BU-DISPLAY-MSG
               GO TO 3-BLOWUP.

DCR01 *-------------------------------------------------------------
DCR01 *--  LOG A PO HISTORY TRANSACTION - FROM HISTORY TO LIVE
DCR01 *-------------------------------------------------------------
DCR01      IF  Z000-POLG-ACTIVE-YES
DCR01          MOVE BUILD-PO-NUMBER       TO  WS-Z000-PORCVNO
DCR01          PERFORM L000-LOG-HST8      THRU L000-HST8-EXIT
DCR01      END-IF.
DCR01 *-------------------------------------------------------------

           MOVE SPACES                TO  BUF-DPORECD  BUF-MPORCV.
           MOVE BUILD-PO-NUMBER       TO  PO-RCV-NO  M-PO-RCV-NO.
           MOVE POH-REQ-NUMBER        TO  PO-REQ-NUMBER.
           MOVE POH-RCV-DEPT          TO  PO-RCV-DEPT.
           MOVE POH-FOR-DEPT          TO  PO-FOR-DEPT.
           MOVE POH-DATE              TO  FORMAT-DATE.
           MOVE FORMAT-DATE           TO  PO-DATE-CN.
      *-------- MOVE ZERO TO CENTURY IF DATE IS EQUAL TO ZERO.
           IF FORMAT-DATE = ZERO
               MOVE "00"              TO  PO-DATE-CC
           ELSE
           IF PO-DATE-CC = "19" OR "20"
               NEXT SENTENCE
           ELSE
           IF PO-DATE-YY > "70"
               MOVE "19"              TO  PO-DATE-CC
           ELSE
           MOVE "20"                  TO  PO-DATE-CC.
           MOVE POH-SHIP-DATE         TO  FORMAT-DATE.
           MOVE FORMAT-DATE           TO  PO-SHIP-DATE-CN.
      *-------- MOVE ZERO TO CENTURY IF DATE IS EQUAL TO ZERO.
           IF FORMAT-DATE = ZERO
               MOVE "00"              TO  PO-SHIP-DATE-CC
           ELSE
           IF PO-SHIP-DATE-CC = "19" OR "20"
               NEXT SENTENCE
           ELSE
           IF PO-SHIP-YY > "70"
               MOVE "19"              TO  PO-SHIP-DATE-CC
           ELSE
           MOVE "20"                  TO  PO-SHIP-DATE-CC.
           MOVE POH-EXPECT-DATE       TO  FORMAT-DATE.
           MOVE FORMAT-DATE           TO  PO-EXPECT-DATE-CN.
      *-------- MOVE ZERO TO CENTURY IF DATE IS EQUAL TO ZERO.
           IF FORMAT-DATE = ZERO
               MOVE "00"              TO  PO-EXPECT-DATE-CC
           ELSE
           IF PO-EXPECT-DATE-CC = "19" OR "20"
               NEXT SENTENCE
           ELSE
           IF PO-EXPECT-YY > "70"
               MOVE "19"              TO  PO-EXPECT-DATE-CC
           ELSE
           MOVE "20"                  TO  PO-EXPECT-DATE-CC.
           MOVE POH-PLT               TO  PO-PLT.
           MOVE POH-BLDG              TO  PO-BLDG.
           MOVE POH-CO                TO  PO-CO.
           MOVE POH-PRIME             TO  PO-PRIME.
           MOVE POH-SUB               TO  PO-SUB.
           MOVE POH-SUB-DET           TO  PO-SUB-DET.
           MOVE POH-ADDL-DATA         TO  PO-ADDL-DATA.
           MOVE POH-NO-CHECK-INDIC    TO  PO-NO-CHECK-INDIC.
           MOVE POH-EEC-PO-INDIC      TO  PO-EEC-PO-INDIC.
           MOVE POH-BUDGET-NUMBER     TO  PO-BUDGET-NUMBER.
           MOVE POH-BUDGET-AMT        TO  PO-BUDGET-AMT.
           MOVE POH-FREIGHT-TERMS     TO  PO-FREIGHT-TERMS.
           MOVE POH-EDI-FLAG          TO  PO-EDI-FLAG.
           MOVE POH-TERMS             TO  PO-TERMS.
           MOVE POH-BUYER-TYP         TO  PO-BUYER-TYP.
           MOVE POH-ADDL-INFO         TO  PO-ADDL-INFO.
           MOVE POH-VIA               TO  PO-VIA.
           MOVE POH-FOB               TO  PO-FOB.
           IF ALT-VEN-CODE = SPACES
               MOVE POH-VEN-CODE      TO  PO-VEN-CODE
           ELSE
               MOVE ALT-VEN-CODE      TO  PO-VEN-CODE.
           MOVE POH-BUYER-CODE        TO  PO-BUYER-CODE.
           MOVE POH-TYPE              TO  PO-TYPE.
           MOVE POH-BLANKET-INDIC     TO  PO-BLANKET-INDIC.
           MOVE POH-ALT-REMIT-INDIC   TO  PO-ALT-REMIT-INDIC.
           MOVE POH-MULTI-ZBILL       TO  PO-MULTI-ZBILL.
           MOVE POH-NON-RCV-INDIC     TO  PO-NON-RCV-INDIC.
           MOVE POH-INTERNAL-ORD-INDIC
                                      TO  PO-INTERNAL-ORDER-INDIC.
           MOVE POH-LAST-PAYMENT-CN   TO  PO-LAST-PAYMENT-CN.
           IF PO-LAST-PAYMENT-CN = SPACES
               NEXT SENTENCE
           ELSE
           IF PO-LAST-PAYMENT-CC = "19" OR "20"
               NEXT SENTENCE
           ELSE
           IF PO-LAST-PAYMENT-YEAR > "70"
               MOVE "19"              TO  PO-LAST-PAYMENT-CC
           ELSE
           MOVE "20"                  TO  PO-LAST-PAYMENT-CC.
           MOVE POH-CURRENCY-CODE     TO  PO-CURRENCY-CODE.
           MOVE POH-ZBILL             TO  PO-ZBILL.
           MOVE POH-FOLLOWUP-DATE-CN  TO  PO-FOLLOWUP-DATE-CN.
           IF PO-FOLLOWUP-DATE-CN = SPACES
               NEXT SENTENCE
           ELSE
           IF PO-FOLLOWUP-DATE-CC = "19" OR "20"
               NEXT SENTENCE
           ELSE
           IF PO-FOLLOWUP-YY > "70"
               MOVE "19"              TO  PO-FOLLOWUP-DATE-CC
           ELSE
           MOVE "20"                  TO  PO-FOLLOWUP-DATE-CC.
           MOVE POH-FOLLOWUP-COUNT    TO  PO-FOLLOWUP-COUNT.
           MOVE POH-CREATE-TYPE       TO  PO-CREATE-TYPE.
           MOVE POH-INVOICELESS-INDIC TO  PO-INVOICELESS-IND.
           MOVE POH-TRANSPORT-MODE    TO  PO-TRANSPORT-MODE.
           MOVE POH-TRANSPORT-CHGPAY  TO  PO-TRANSPORT-CHGPAY.
           MOVE POH-TRANSPORT-TERMS-OF-DEL TO PO-TRANSPORT-TERMS-OF-DEL.
           MOVE "999999"              TO  PO-PRFAX-DATE.
           MOVE POH-EEC-NATURE-TRANS  TO  PO-EEC-NATURE-TRANS.
           MOVE POH-EEC-PORT-AIRPORT  TO  PO-EEC-PORT-AIRPORT.
           MOVE POH-NONPAY-IND        TO  PO-NONPAY-IND.
           IF POH-RLS-NO = "999"
               MOVE POH-LAST-RCVR     TO  M-PO-LAST-RLSE,
               MOVE "B"               TO  M-PO-BLK-INDIC
           ELSE
           MOVE POH-LAST-RCVR         TO  M-PO-LAST-RCVR,
                                          SAVE-LAST-RCVR.
           MOVE "HISTPO"              TO  M-PO-RCV-SEQ.


       62-PUT-HEADER.
           WRITE MPORCV-REC-O FROM BUF-MPORCV
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               PERFORM 70-BACKOUT-ROUTINE   THRU 70-BR-X
               MOVE "PUT MPORCV * 62-PH"  TO BU-DISPLAY-MSG
               GO TO 2-BLOWUP.

           WRITE DPORECD-REC-O FROM BUF-DPORECD
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
                PERFORM 70-BACKOUT-ROUTINE   THRU 70-BR-X
                MOVE "PUT DPORECD * 62-PH" TO BU-DISPLAY-MSG
                GO TO 2-BLOWUP.

       621-LOAD-ITEMS.
           MOVE PO-ARG TO PORCVNO OF DPOITEMH-REC-I.
           START DPOITEMH-I KEY = PORCVNO OF DPOITEMH-REC-I
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
                   GO TO 62-LPH-X
               ELSE
                   MOVE "START DPOITEM * 621-LI" TO BU-DISPLAY-MSG
                   GO TO 3-BLOWUP.

           READ DPOITEMH-I NEXT INTO BUF-DPOITEM-H
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   GO TO 62-LPH-X
               ELSE
                   MOVE "GET DPOITEM * 621-LI" TO BU-DISPLAY-MSG
                   GO TO 3-BLOWUP.
           IF PORCVNO OF DPOITEMH-REC-I NOT = PO-ARG
               GO TO 62-LPH-X.

       621-MOVE-ITEMS.
           MOVE SPACES                 TO  BUF-DPOITEM.
           MOVE ZEROS                  TO  ITM-QTY-ORD,
                                           ITM-QTY-DLVR,
                                           ITM-QTY-STORED,
                                           ITM-UNIT-PRICE,
                                           ITM-QTY-PAID,
                                           ITM-WT,
                                           ITM-KELLY-PO-QTY,
                                           ITM-ZBILL-VALUE,
                                           ITM-ASN-QTY.
           MOVE BUILD-PO-NUMBER        TO  ITM-PO-RCV-NO.
           IF ITMH-CORP-CODE = SPACES
               MOVE "NON-STR"          TO  ITM-CORP-CODE
           ELSE
               MOVE ITMH-CORP-CODE     TO  ITM-CORP-CODE.
           MOVE ITMH-NUMBER            TO  ITM-NUMBER.
           MOVE ITMH-QTY-ORD           TO  ITM-QTY-ORD.
           MOVE ITMH-QTY-DLVR          TO  ITM-QTY-DLVR.
           MOVE ITMH-QTY-STORED        TO  ITM-QTY-STORED.
           MOVE ITMH-QTY-PAID          TO  ITM-QTY-PAID.
           MOVE ITMH-QTY-UM            TO  ITM-UM.
           MOVE ITMH-UNIT-PRICE        TO  ITM-UNIT-PRICE.
           MOVE ITMH-PRICE-UM          TO  ITM-PRICE-UM.
           MOVE ITMH-SUB               TO  ITM-CLASS.
           MOVE ITMH-SUB-DETL          TO  ITM-SUB-DETL.
           MOVE ITMH-ADDL-DATA         TO  ITM-ADDL-DATA.
           MOVE ITMH-DATE-RCVD         TO  FORMAT-DATE.
           IF FORMAT-DATE = ZEROES
               MOVE SPACES             TO  ITM-DATE-RCVD-CN
           ELSE
           MOVE FORMAT-DATE            TO  ITM-DATE-RCVD-CN
           IF YY-RCVD > "70"
               MOVE "19"               TO  CC-RCVD
           ELSE
           MOVE "20"                   TO  CC-RCVD.
           MOVE ITMH-DATE-STORED-CN    TO  ITM-DATE-STORED-CN.
           IF CC-STORED = "19" OR "20"
               NEXT SENTENCE
           ELSE
           IF MM-STORED = "DD"
               NEXT SENTENCE
           ELSE
           IF YY-STORED > "70"
               MOVE "19"               TO  CC-STORED
           ELSE
           MOVE "20"                   TO  CC-STORED.
           MOVE ITMH-COMPANY           TO  ITM-COMPANY.
           MOVE ITMH-PRIME             TO  ITM-PRIME.
           MOVE ITMH-WT                TO  ITM-WT.
           MOVE ITMH-SHIP-DATE         TO  FORMAT-DATE.
           IF FORMAT-DATE = ZEROES
               NEXT SENTENCE
           ELSE
           MOVE FORMAT-DATE            TO  ITM-SHIP-DATE-CN
           IF ITM-SHIP-DATE-CC = "00"
               MOVE "00"               TO  ITM-SHIP-DATE-CC
           ELSE
           IF ITM-SHIP-DATE-CC = "19" OR "20"
               NEXT SENTENCE
           ELSE
           IF ITM-SHIP-YY > "70"
               MOVE "19"               TO  ITM-SHIP-DATE-CC
           ELSE
           MOVE "20"                   TO  ITM-SHIP-DATE-CC.
           MOVE ITMH-EXPECT-DATE       TO  FORMAT-DATE.
           IF FORMAT-DATE = ZEROES
               NEXT SENTENCE
           ELSE
           MOVE FORMAT-DATE            TO  ITM-EXPECT-DATE-CN
           IF ITM-EXPECT-DATE-CC = "19" OR "20"
               NEXT SENTENCE
           ELSE
           IF ITM-EXPECT-YY > "70"
               MOVE "19"               TO  ITM-EXPECT-DATE-CC
           ELSE
           MOVE "20"                   TO  ITM-EXPECT-DATE-CC.

           MOVE ITMH-TERMS             TO  ITM-TERMS.
           MOVE ITMH-FOB               TO  ITM-FOB.
           MOVE ITMH-STD-INST          TO  ITM-STD-INST.
           MOVE ITMH-COMPLETE-FLAG     TO  ITM-COMPLETE-FLAG.
           MOVE ITMH-CONTAINER         TO  ITM-CONTAINER.
           MOVE ITMH-SECOND-DESC-INDIC TO  ITM-SECOND-DESC-INDIC.
           MOVE ITMH-TAX-CODE          TO  ITM-TAX-CODE.
           MOVE ITMH-KELLY-PO-QTY      TO  ITM-KELLY-PO-QTY.
           MOVE ITMH-KELLY-PO-UM       TO  ITM-KELLY-PO-UM.
           MOVE ITMH-ZBILL-VALUE       TO  ITM-ZBILL-VALUE.
           MOVE ITMH-MASTER-STOCK      TO  ITM-MASTER-STOCK.
           MOVE ITMH-EEC-ORIGIN-COUNTRY TO ITM-EEC-ORIGIN-COUNTRY.
           MOVE ITMH-EEC-COMM-CODE     TO  ITM-EEC-COMM-CODE.
           MOVE ITMH-CHAT-NO           TO  ITM-CHAT-NO.
           MOVE ITMH-QS9000-TRACK      TO  ITM-QS9000-TRACK.
           MOVE SPACES                 TO  ITM-RCV-STD-INST.
           MOVE ZEROES                 TO  ITM-ASN-QTY.
           MOVE SPACES                 TO  ITM-ASN-DATE.

       621-PUT-DPOITEM.
           WRITE DPOITEM-REC-O FROM BUF-DPOITEM
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               PERFORM 70-BACKOUT-ROUTINE   THRU 70-BR-X
               MOVE "PUT DPOITEM * 621-PD"  TO BU-DISPLAY-MSG
               GO TO 2-BLOWUP.

           READ DPOITEMH-I NEXT INTO BUF-DPOITEM-H
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   GO TO 621-FIND-DPODESC
               ELSE
                   PERFORM 70-BACKOUT-ROUTINE  THRU 70-BR-X
                   MOVE "GET DPOITEM * 621-PD" TO BU-DISPLAY-MSG
                   GO TO 3-BLOWUP.
           IF PORCVNO OF DPOITEMH-REC-I NOT = PO-ARG
               GO TO 621-FIND-DPODESC.

           GO TO 621-MOVE-ITEMS.

       621-FIND-DPODESC.
           MOVE PO-ARG TO PORCVNO OF DPODESCH-REC-I.
           START DPODESCH-I KEY = PORCVNO OF DPODESCH-REC-I
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
                   GO TO 621-FIND-DRCVTRAK
               ELSE
                   PERFORM 70-BACKOUT-ROUTINE THRU 70-BR-X
                   MOVE "START DPODESC * 621-PD" TO BU-DISPLAY-MSG
                   GO TO 3-BLOWUP.

       621-GET-DPODESC.
           READ DPODESCH-I NEXT INTO BUF-DPODESC-H
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   GO TO 621-FIND-DRCVTRAK
               ELSE
                   PERFORM 70-BACKOUT-ROUTINE THRU 70-BR-X
                   MOVE "GET DPODESC * 621-PD" TO BU-DISPLAY-MSG
                   GO TO 3-BLOWUP.
           IF PORCVNO OF DPODESCH-REC-I NOT = PO-ARG
               GO TO 62-LPH-X.

       621-PUT-DPODATAITM.
           MOVE SPACES                TO  BUF-DPODATAITM.
           MOVE BUILD-PO-NUMBER       TO  DATAITM-PO-RCV-NO.
           MOVE PODESCH-DESC          TO  DATAITM-INFO.
           MOVE PODESCH-SEQ           TO  DATAITM-LINE.
           WRITE DPODATAITM-REC-O FROM BUF-DPODATAITM
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               PERFORM 70-BACKOUT-ROUTINE  THRU  70-BR-X
               MOVE "PUT DPODATAITM*621-PD" TO BU-DISPLAY-MSG
               GO TO 2-BLOWUP.

           GO TO 621-GET-DPODESC.

       621-FIND-DRCVTRAK.
           MOVE PO-ARG TO PORCVNO OF DRCVTRAKH-REC-I.
           START DRCVTRAKH-I KEY = EXTERNALLY-DESCRIBED-KEY
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
                   GO TO 62-LPH-X
               ELSE
                   PERFORM 70-BACKOUT-ROUTINE THRU 70-BR-X
                   MOVE "START DRCVTRAK * 621-PD" TO BU-DISPLAY-MSG
                   GO TO 3-BLOWUP.

       621-GET-DRCVTRAK.
           READ DRCVTRAKH-I NEXT INTO BUF-DRCVTRAKH
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   GO TO 62-LPH-X
               ELSE
                   PERFORM 70-BACKOUT-ROUTINE THRU 70-BR-X
                   MOVE "GET DRCVTRAK * 621-PD" TO BU-DISPLAY-MSG
                   GO TO 3-BLOWUP.
           IF PORCVNO OF DRCVTRAKH-REC-I NOT = PO-ARG
               GO TO 62-LPH-X.

       621-PUT-DRCVTRAK.
           MOVE SPACES                TO  BUF-DRCVTRAK.
           MOVE BUILD-PO-NUMBER       TO  RCVTRAK-PO-RCV-NO.
           MOVE RCVTRAKH-ITEM-NUMBER   TO  RCVTRAK-ITEM-NUMBER.
           MOVE RCVTRAKH-SEQNO         TO  RCVTRAK-SEQNO.
           MOVE RCVTRAKH-VEN-CODE      TO  RCVTRAK-VEN-CODE.
           MOVE RCVTRAKH-CORP-CODE     TO  RCVTRAK-CORP-CODE.
           MOVE RCVTRAKH-EXPECT-QTY    TO  RCVTRAK-EXPECT-QTY.
           MOVE RCVTRAKH-EXPECT-DATE   TO  RCVTRAK-EXPECT-DATE.
           MOVE RCVTRAKH-EXPECT-DATE   TO  FORMAT-DATE.
           IF FORMAT-DATE = ZEROES
               MOVE SPACES             TO  RCVTRAK-EXPECT-DATE
           ELSE
               MOVE FORMAT-DATE        TO  RCVTRAK-EXPECT-DATE.
           MOVE RCVTRAKH-EARLY-DAYS    TO  RCVTRAK-EARLY-DAYS.
           MOVE RCVTRAKH-LATE-DAYS     TO  RCVTRAK-LATE-DAYS.
           MOVE RCVTRAKH-RCV-SLIP      TO  RCVTRAK-RCV-SLIP.
           MOVE RCVTRAKH-CARRIER       TO  RCVTRAK-CARRIER.
           MOVE RCVTRAKH-DLVR-QTY      TO  RCVTRAK-DLVR-QTY.
           MOVE RCVTRAKH-DLVR-DATE     TO  RCVTRAK-DLVR-DATE.
           MOVE RCVTRAKH-CORRECTIVE-ACTION TO RCVTRAKH-CORRECTIVE-ACTION.
           MOVE RCVTRAKH-ALREADY-REPORTED TO RCVTRAKH-ALREADY-REPORTED.
           WRITE DRCVTRAK-REC-O FROM BUF-DRCVTRAK
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               PERFORM 70-BACKOUT-ROUTINE  THRU  70-BR-X
               MOVE "PUT DRCVTRAK*621-PD" TO BU-DISPLAY-MSG
               GO TO 2-BLOWUP.

           GO TO 621-GET-DRCVTRAK.
       62-LPH-X.
           EXIT.

       63-LOAD-RECEIVING-HISTORY.
           MOVE BUILD-POH-NUMBER      TO  RCVR-ARG.
           MOVE BUILD-PO-NUMBER       TO  BUILD-RCVR-NUMBER.

      ****** LOAD ALL FREIGHT BILLS FOUND UNDER THE PO NUMBER KEY
      ****** SINCE THESE FREIGHT BILLS CAN BE PUT OUT BY THE INVOICE
      ****** PROCESSING PROGRAM.

           PERFORM 631-LOAD-FREIGHT-INFO  THRU  631-LFI-X.

       63-LOAD-RCVR-LOOP.
           IF SAVE-LAST-RCVR = RCVR-PO-RCVR
               GO TO 63-LRH-X.
           ADD 1  TO  RCVR-PO-RCVR.
           MOVE RCVR-PO-RCVR          TO  BUILD-RCVR-NO.
           PERFORM 631-LOAD-FREIGHT-INFO  THRU  631-LFI-X.

      ******** LOAD RECEIVING SLIP ITEMS

           IF NO-ITEM-ON
               NEXT SENTENCE
           ELSE
               PERFORM 632-GET-RCV-SLIP THRU 632-GRS-X.

           GO TO 63-LOAD-RCVR-LOOP.

       63-LRH-X.
           EXIT.

       631-LOAD-FREIGHT-INFO.
           MOVE RCVR-ARG TO PORCVNO OF DPOFREIGHTH-REC-I.
           START DPOFREIGHTH-I KEY = PORCVNO OF DPOFREIGHTH-REC-I
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
                   GO TO 631-LFI-X
               ELSE
                   PERFORM 70-BACKOUT-ROUTINE  THRU  70-BR-X
                   MOVE "FIND DPOFREIGHT * 631-LFI" TO BU-DISPLAY-MSG
                   GO TO 3-BLOWUP.

       631-GET-FREIGHT-LOOP.
           READ DPOFREIGHTH-I NEXT INTO BUF-DPOFREIGHT-H
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   GO TO 631-LFI-X
               ELSE
                   PERFORM 70-BACKOUT-ROUTINE  THRU  70-BR-X
                   MOVE "GET DPOFREIGHT*631-GFL" TO BU-DISPLAY-MSG
                   GO TO 3-BLOWUP.
           IF PORCVNO OF DPOFREIGHTH-REC-I NOT = RCVR-ARG
               GO TO 631-LFI-X.

           MOVE SPACES                 TO  BUF-DPOFREIGHT.
           MOVE BUILD-RCVR-NUMBER      TO  FRT-PO-RCV-NO,
                                           M-PO-RCV-NO.
           MOVE FRTH-TYPE              TO  FRT-TYPE.
           MOVE FRTH-PAID-FLAG         TO  FRT-PAID-FLAG.
           MOVE FRTH-EMPL              TO  FRT-EMPL.
           MOVE FRTH-PACK-SLIP         TO  FRT-PACK-SLIP.
           MOVE FRTH-CARRIER           TO  FRT-CARRIER.
           MOVE FRTH-BILL-NO           TO  FRT-BILL-NO.
           MOVE FRTH-CHARGES           TO  FRT-CHARGES-9.
           MOVE FRTH-BILL-DATE         TO  FORMAT-DATE.
           MOVE FORMAT-DATE            TO  FRT-BILL-DATE-CN.
           IF FRT-YY = "  "
               MOVE "  "               TO  FRT-CC
           ELSE
           IF FRT-YY > "70"
               MOVE "19"               TO  FRT-CC
           ELSE
           MOVE "20"                   TO  FRT-CC.
           MOVE FRTH-DATE-RCVD         TO  FORMAT-DATE.
           MOVE FORMAT-DATE            TO  FRT-DATE-RCVD-CN.
           IF FRT-DATE-RCVD-CC = "00"
               MOVE "00"               TO  FRT-DATE-RCVD-CC
           ELSE
           IF FRT-DATE-RCVD-CC = "19" OR "20"
               NEXT SENTENCE
           ELSE
           IF FRT-DATE-RCVD-YY > "70"
               MOVE "19"               TO  FRT-DATE-RCVD-CC
           ELSE
           MOVE "20"                   TO  FRT-DATE-RCVD-CC.
           MOVE FRTH-DATE-ARRIVAL      TO  FRT-DATE-ARRIVAL.
           MOVE FRTH-SPLC              TO  FRT-SPLC.
           MOVE FRTH-CARRIER-WT        TO  FRT-CARRIER-WT.
           MOVE FRTH-OUR-WT            TO  FRT-OUR-WT.
           MOVE FRTH-RAIL-CAR          TO  FRT-RAIL-CAR.
           MOVE FRTH-LOT               TO  FRT-LOT.
           MOVE FRTH-SEALS             TO  FRT-SEALS.
           MOVE FRTH-OSD               TO  FRT-OSD.
           MOVE FRTH-REFERBACK         TO  FRT-REFERBACK.
           MOVE FRTH-OSD-CLAIM         TO  FRT-OSD-CLAIM.
           MOVE FRTH-REG-NO            TO  FRT-REG-NO.
           MOVE FRTH-RCVR-SEQ-NO       TO  M-PO-RCV-SEQ.

       631-PUT-FREIGHT.
           IF RCVR-PO-RCVR NOT = ZEROS
               WRITE MPORCV-REC-O FROM BUF-MPORCV
                   INVALID KEY MOVE FILE-STATUS TO FILE-STATUS
               END-WRITE
               IF FILE-STATUS NOT = "00"
                   PERFORM 70-BACKOUT-ROUTINE THRU 70-BR-X
                   MOVE "PUT MPORCV * 631-PF" TO BU-DISPLAY-MSG
                   GO TO 2-BLOWUP.

           WRITE DPOFREIGHT-REC-O FROM BUF-DPOFREIGHT
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               PERFORM 70-BACKOUT-ROUTINE  THRU  70-BR-X
               MOVE "PUT DPOFREIGHT*631-PF" TO BU-DISPLAY-MSG
               GO TO 2-BLOWUP.

           GO TO 631-GET-FREIGHT-LOOP.

       631-LFI-X.
           EXIT.


       632-GET-RCV-SLIP.
           MOVE RCVR-ARG TO PORCVNO OF DRCVITEMH-REC-I.
           START DRCVITEMH-I KEY = PORCVNO OF DRCVITEMH-REC-I
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
                   GO TO 632-GET-RCVR-CORRECTIONS
               ELSE
                   PERFORM 70-BACKOUT-ROUTINE  THRU  70-BR-X
                   MOVE "FIND DRCVITEM-H * 632-GRS" TO BU-DISPLAY-MSG
                   GO TO 3-BLOWUP.

       632-GET-RCVR-ITEM-LOOP.
           READ DRCVITEMH-I NEXT INTO BUF-DRCVITEM-H
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   GO TO 632-GET-RCVR-CORRECTIONS
               ELSE
                   PERFORM 70-BACKOUT-ROUTINE  THRU  70-BR-X
                   MOVE "GET DRCVITEM-H*633-GRIL" TO BU-DISPLAY-MSG
                   GO TO 3-BLOWUP.
           IF PORCVNO OF DRCVITEMH-REC-I NOT = RCVR-ARG
               GO TO 632-GET-RCVR-CORRECTIONS.

           MOVE SPACES                TO  BUF-DRCVITEM.
           MOVE BUILD-RCVR-NUMBER     TO  RCV-PO-RCV-NO.
           MOVE RCVH-ITEM-NUMBER      TO  RCV-ITEM-NUMBER.
           IF RCVH-CORP-CODE = SPACES
               MOVE "NON-STR"         TO  RCV-CORP-CODE
           ELSE
               MOVE RCVH-CORP-CODE    TO  RCV-CORP-CODE.
           IF RCVH-ITM-QTY-DLVR-X = SPACES
               MOVE ZEROES            TO  RCV-QTY-DLVR
           ELSE
           MOVE RCVH-ITM-QTY-DLVR     TO  RCV-QTY-DLVR.
           MOVE RCVH-DATE-RCVD-CN     TO  RCV-DATE-RCVD-CN.
           IF RCV-CC-RCVD = "19" OR "20"
               NEXT SENTENCE
           ELSE
           IF RCV-YY-RCVD > "70"
               MOVE "19"              TO  RCV-CC-RCVD
           ELSE
           MOVE "20"                  TO  RCV-CC-RCVD.
           IF RCVH-QTY-STORED-X = SPACES
               MOVE ZEROES            TO  RCV-QTY-STORED
           ELSE
           MOVE RCVH-QTY-STORED       TO  RCV-QTY-STORED.
           MOVE RCVH-DATE-STORED-CN   TO  RCV-DATE-STORED-CN.
           IF RCV-CC-STORED = "19" OR "20"
               NEXT SENTENCE
           ELSE
           IF RCV-MM-STORED = "DD"
               NEXT SENTENCE
           ELSE
           IF RCV-YY-STORED > "70"
               MOVE "19"              TO  RCV-CC-STORED
           ELSE
           MOVE "20"                  TO  RCV-CC-STORED.
           MOVE RCVH-FLAGS            TO  RCV-FLAGS.
           IF RCVH-KELLY-PO-QTY-X = SPACES
               MOVE ZEROES            TO  RCV-KELLY-PO-QTY
           ELSE
           MOVE RCVH-KELLY-PO-QTY     TO  RCV-KELLY-PO-QTY.
           MOVE RCVH-KELLY-PO-UM      TO  RCV-KELLY-PO-UM.
           MOVE RCVH-ITEM-UM          TO  RCV-ITEM-UM.
           MOVE RCVH-COMMENT          TO  RCV-COMMENT.
           MOVE RCVH-LOT              TO  RCV-LOT.
           MOVE RCVH-TALLY            TO  RCV-TALLY.
           MOVE RCVH-CHATNO           TO  RCV-CHATNO.
           MOVE RCVH-EEC-ORIGIN-COUNTRY
                                      TO RCV-EEC-ORIGIN-COUNTRY.
           MOVE RCVH-EEC-NET-MASS     TO  RCV-EEC-NET-MASS.
           MOVE RCVH-EEC-SUPPL-UNITS  TO  RCV-EEC-SUPPL-UNITS.
           MOVE RCVH-EEC-QUAL         TO  RCV-EEC-QUAL.
           MOVE RCVH-EEC-QUAL-CODE    TO  RCV-EEC-QUAL-CODE.
           MOVE ZEROES                TO  RCV-ASN-QTY.
           MOVE SPACES                TO  RCV-ASN-DATE.

       632-PUT-DRCVITEM.
           WRITE DRCVITEM-REC-O FROM BUF-DRCVITEM
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               PERFORM 70-BACKOUT-ROUTINE  THRU  70-BR-X
               MOVE "PUT DRCVITEM*632-PDC" TO BU-DISPLAY-MSG
               GO TO 2-BLOWUP.

           GO TO 632-GET-RCVR-ITEM-LOOP.

       632-GET-RCVR-CORRECTIONS.
           MOVE RCVR-ARG TO PORCVNO OF DRCVCORRH-REC-I.
           START DRCVCORRH-I KEY = PORCVNO OF DRCVCORRH-REC-I
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
                   GO TO 632-GRS-X
               ELSE
                   PERFORM 70-BACKOUT-ROUTINE  THRU  70-BR-X
                   MOVE "FIND DRCVCORR-H * 632-GRC" TO BU-DISPLAY-MSG
                   GO TO 3-BLOWUP.

       632-GET-RCVR-CORR-LOOP.
           READ DRCVCORRH-I NEXT INTO BUF-DRCVCORR-H
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   GO TO 632-GRS-X
               ELSE
                   PERFORM 70-BACKOUT-ROUTINE  THRU  70-BR-X
                   MOVE "GET DRCVCORR-H*633-GRCL" TO BU-DISPLAY-MSG
                   GO TO 3-BLOWUP.
           IF PORCVNO OF DRCVCORRH-REC-I NOT = RCVR-ARG
               GO TO 632-GRS-X.

           MOVE SPACES                TO  BUF-DRCVCORR.
           MOVE BUILD-RCVR-NUMBER     TO  CORR-PO-NUMBER.
           MOVE CORR-ITEM-H           TO  CORR-ITEM.
           MOVE CORR-CORP-CODE-H      TO  CORR-CORP-CODE.
           MOVE CORR-DATE-H-CN        TO  CORR-DATE-CN.
           IF CORR-DATE-CC = "19" OR "20"
               NEXT SENTENCE
           ELSE
           IF CORR-DATE-YY > "70"
               MOVE "19"              TO  CORR-DATE-CC
           ELSE
           MOVE "20"                  TO  CORR-DATE-CC.
           MOVE CORR-REASON-H         TO  CORR-REASON.

       632-PUT-DRCVCORR.
           WRITE DRCVCORR-REC-O FROM BUF-DRCVCORR
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               PERFORM 70-BACKOUT-ROUTINE  THRU  70-BR-X
               MOVE "PUT DRCVCORR*632-PDC" TO BU-DISPLAY-MSG
               GO TO 2-BLOWUP.

           GO TO 632-GET-RCVR-CORR-LOOP.


       632-GRS-X.
           EXIT.

       64-LOAD-INVOICING-HISTORY.
           MOVE PO-ARG TO PORCVNO OF DINVRCDH-REC-I.
           START DINVRCDH-I KEY = PORCVNO OF DINVRCDH-REC-I
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
                   GO TO 64-LIH-X
               ELSE
                   PERFORM 70-BACKOUT-ROUTINE  THRU  70-BR-X
                   MOVE "FIND DINVRCD * 64-LIH" TO BU-DISPLAY-MSG
                   GO TO 3-BLOWUP.

       64-GET-DINVRCD.
           READ DINVRCDH-I NEXT INTO BUF-DINVRCD-H
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   GO TO 64-LIH-X
               ELSE
                   PERFORM 70-BACKOUT-ROUTINE  THRU  70-BR-X
                   MOVE "GET DINVRCD*64-GD" TO BU-DISPLAY-MSG
                   GO TO 3-BLOWUP.
           IF PORCVNO OF DINVRCDH-REC-I NOT = PO-ARG
               GO TO 64-LIH-X.

      *****************************************************************
      *   CHECK FOR EXISTENCE OF REGISTER NUMBER IN LIVE DATABASE.    *
      *   IF IT ALREADY EXISTS, PERFORM BACKOUT PROCEDURE.    PDR     *
      *****************************************************************
           MOVE INVH-REG-NO TO REGISTER-ARG.
           PERFORM 9999-CHAINHD-DINVRCD-RG-I.
           PERFORM 9999-GETNEXT-DINVRCD-RG-I.
           IF GOOD-CALL
             PERFORM 9999-RESET-MPLTINFO-PK-O
             PERFORM 70-BACKOUT-ROUTINE THRU 70-BR-X
             MOVE "DUPLICATE REGISTER, CANNOT RECALL PO" TO
               BU-DISPLAY-MSG
             MOVE "REGISTER" TO BU-DISPLAY-FLD(2)
             MOVE REGISTER-ARG TO BU-DISPLAY-FLD(3)
             GO TO 2-BLOWUP.

           MOVE SPACES                 TO  BUF-DINVRCD.
           MOVE BUILD-PO-NUMBER        TO  INV-PO-RCV-NO.
           MOVE INVH-REG-NO            TO  INV-REG-NO.
           MOVE INVH-MFEST-NO          TO  INV-MFEST-NO.
           MOVE INVH-MFEST-YY          TO  INV-MFEST-YY.
           MOVE INVH-STATUS            TO  INV-STATUS.
           MOVE INVH-VEN-CODE          TO  INV-VEN-CODE.
           MOVE INVH-NO                TO  INV-NO.
           MOVE INVH-DATE              TO  INV-DATE.
           MOVE FORMAT-DATE            TO  INV-DATE-CN.
      *-------- DATES WERE BEING MOVED OVER AS "19000000" OR "20000000"
      *-------- IF THERE WAS NO DATE.  CORRECTED PROBLEM.   3/6/97
           IF FORMAT-DATE = 0
               MOVE SPACES             TO  INV-DATE-CN
           ELSE
           IF INV-DATE-CC = "19" OR "20"
               NEXT SENTENCE
           ELSE
           IF INV-DATE-YY > "70"
               MOVE "19"               TO  INV-DATE-CC
           ELSE
           MOVE "20"                   TO  INV-DATE-CC.
           MOVE INVH-ENTRY-DATE        TO  FORMAT-DATE.
           MOVE FORMAT-DATE            TO  INV-ENTRY-CN.
           IF FORMAT-DATE = 0
               MOVE SPACES             TO  INV-ENTRY-CN
           ELSE
           IF INV-ENTRY-CC = "19" OR "20"
               NEXT SENTENCE
           ELSE
           IF INV-ENTRY-YY > "70"
               MOVE "19"               TO  INV-ENTRY-CC
           ELSE
           MOVE "20"                   TO  INV-ENTRY-CC.
           MOVE INVH-DUE-DATE          TO  FORMAT-DATE.
           MOVE FORMAT-DATE            TO  INV-DUE-CN.
           IF FORMAT-DATE = 0
               MOVE SPACES             TO  INV-DUE-CN
           ELSE
           IF INV-DUE-CC = "19" OR "20"
               NEXT SENTENCE
           ELSE
           IF INV-DUE-YY > "70"
               MOVE "19"               TO  INV-DUE-CC
           ELSE
           MOVE "20"                   TO  INV-DUE-CC.
           MOVE INVH-MOD-DATE          TO  FORMAT-DATE.
           MOVE FORMAT-DATE            TO  INV-MOD-CN.
           IF FORMAT-DATE = 0
               MOVE SPACES             TO  INV-MOD-CN
           ELSE
           IF INV-MOD-CC = "19" OR "20"
               NEXT SENTENCE
           ELSE
           IF INV-MOD-YY > "70"
               MOVE "19"               TO  INV-MOD-CC
           ELSE
           MOVE "20"                   TO  INV-MOD-CC.
           MOVE INVH-CHECK-DATE        TO  FORMAT-DATE.
           MOVE FORMAT-DATE            TO  INV-CHECK-CN.
           IF FORMAT-DATE = 0
               MOVE SPACES             TO  INV-CHECK-CN
           ELSE
           IF INV-CHECK-CC = "19" OR "20"
               NEXT SENTENCE
           ELSE
           IF INV-CHECK-YY > "70"
               MOVE "19"               TO  INV-CHECK-CC
           ELSE
           MOVE "20"                   TO  INV-CHECK-CC.
           MOVE INVH-CHECK-NO          TO  INV-CHECK-NO.
           MOVE INVH-TERMS             TO  INV-TERMS.
           MOVE INVH-I-MATL-EXT        TO  INV-I-MATL-EXT.
           MOVE INVH-P-MATL-EXT        TO  INV-P-MATL-EXT.
           MOVE INVH-PAYMENT-IND       TO  INV-PAYMENT-IND.
           MOVE INVH-ADD-VFRT          TO  INV-ADD-VFRT.
           MOVE INVH-ADD-TAX           TO  INV-ADD-TAX.
           MOVE INVH-ADD-CTNRS         TO  INV-ADD-CTNRS.
           MOVE INVH-ADD-INS           TO  INV-ADD-INS.
           MOVE INVH-ADD-OTHER         TO  INV-ADD-OTHER.
           MOVE INVH-TAX-CODE          TO  INV-TAX-CODE.
           MOVE INVH-CE-LIST           TO  INV-CE-LIST.
           MOVE INVH-CPW-CODE          TO  INV-CPW-CODE.
           MOVE INVH-NET-DUE-VENDOR    TO  INV-NET-DUE-VENDOR.
           MOVE INVH-TOTAL-CFRT        TO  INV-TOTAL-CFRT.
           MOVE INVH-ADJ-ATAX (1)      TO  INV-ADJ-ATAX (1).
           MOVE INVH-ADJ-ATAX (2)      TO  INV-ADJ-ATAX (2).
           MOVE INVH-ADJ-ATAX (3)      TO  INV-ADJ-ATAX (3).
           MOVE INVH-ADJ-ATAX (4)      TO  INV-ADJ-ATAX (4).
           MOVE INVH-ADJ-OTHER         TO  INV-ADJ-OTHER.
           MOVE INVH-DIST-COST         TO  INV-DIST-COST.
           MOVE INVH-ADD-CLERK         TO  INV-ADD-CLERK.
           MOVE INVH-MOD-CLERK         TO  INV-MOD-CLERK.
           MOVE INVH-NO-CHECK-INDIC    TO  INV-NO-CHECK-INDIC.
           MOVE INVH-TAX-ON-FRT        TO  INV-TAX-ON-FRT.
           MOVE INVH-FREE-VERB         TO  INV-FREE-VERB.
           MOVE INVH-RCVR-NO           TO  INV-RCVR-NO.

       64-PUT-DINVRCD.
           WRITE DINVRCD-REC-O FROM BUF-DINVRCD
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               PERFORM 70-BACKOUT-ROUTINE  THRU  70-BR-X
               MOVE "PUT DINVRCD*64-PD" TO BU-DISPLAY-MSG
               GO TO 2-BLOWUP.

           MOVE INVH-REG-NO            TO  REGISTER-ARG.
           PERFORM 641-LOAD-ITEMS-INFO  THRU  641-LII-X.

           PERFORM 642-LOAD-ITEM-ACCT-INFO  THRU  642-LIAI-X.

           GO TO 64-GET-DINVRCD.

       64-LIH-X.
           EXIT.

       641-LOAD-ITEMS-INFO.
           MOVE REGISTER-ARG TO REGISTERNO OF DINVITMH-REC-I.
           START DINVITMH-I KEY = REGISTERNO OF DINVITMH-REC-I
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
                   GO TO 641-LII-X
               ELSE
                   PERFORM 70-BACKOUT-ROUTINE  THRU  70-BR-X
                   MOVE "FIND DINVITM * 641-LII" TO BU-DISPLAY-MSG
                   GO TO 3-BLOWUP.

       641-GET-DINVITM.
           READ DINVITMH-I NEXT INTO BUF-DINVITM-H
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   GO TO 641-LII-X
               ELSE
                   PERFORM 70-BACKOUT-ROUTINE  THRU  70-BR-X
                   MOVE "GET DINVITM*641-GD" TO BU-DISPLAY-MSG
                   GO TO 3-BLOWUP.
           IF REGISTERNO OF DINVITMH-REC-I NOT = REGISTER-ARG
               GO TO 641-LII-X.

           IF INVITMH-PO-NUM = INVH-PO-RLSE
               NEXT SENTENCE
           ELSE
               GO TO 641-GET-DINVITM.

           MOVE SPACES                TO  BUF-DINVITM.
           MOVE INVITMH-REG-NO        TO  INVITM-REG-NO.
           MOVE INVITMH-CORPCODE      TO  INVITM-CORPCODE.
           MOVE INVITMH-PO-QTY-PD     TO  INVITM-PO-QTY-PD.
           MOVE INVITMH-PO-UM         TO  INVITM-PO-UM.
           MOVE INVITMH-PO-UPRICE     TO  INVITM-PO-UPRICE.
           MOVE INVITMH-INV-QTY-PD    TO  INVITM-INV-QTY-PD.
           MOVE INVITMH-INV-UPRICE    TO  INVITM-INV-UPRICE.
           MOVE INVITMH-ITEM-NO       TO  INVITM-ITEM-NO.
           MOVE INVITMH-MEMO-INDIC    TO  INVITM-MEMO-INDIC.
           MOVE INVITMH-TAX-CODE      TO  INVITM-TAX-CODE.

       641-PUT-DINVITM.
           WRITE DINVITM-REC-O FROM BUF-DINVITM
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               PERFORM 70-BACKOUT-ROUTINE  THRU  70-BR-X
               MOVE "PUT DINVITM*641-PD" TO BU-DISPLAY-MSG
               GO TO 2-BLOWUP.

           GO TO 641-GET-DINVITM.

       641-LII-X.
           EXIT.

       642-LOAD-ITEM-ACCT-INFO.
           MOVE REGISTER-ARG TO REGISTERNO OF DINVACCTH-REC-I.
           START DINVACCTH-I KEY = REGISTERNO OF DINVACCTH-REC-I
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
                   GO TO 642-LIAI-X
               ELSE
                   PERFORM 70-BACKOUT-ROUTINE  THRU  70-BR-X
                   MOVE "FIND DINVACCT * 642-LIAI" TO BU-DISPLAY-MSG
                   GO TO 3-BLOWUP.

       642-GET-DINVACCT.
           READ DINVACCTH-I NEXT INTO BUF-DINVACCT-H
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   GO TO 642-LIAI-X
               ELSE
                   PERFORM 70-BACKOUT-ROUTINE  THRU  70-BR-X
                   MOVE "GET DINVACCT*642-GD" TO BU-DISPLAY-MSG
                   GO TO 3-BLOWUP.
           IF REGISTERNO OF DINVACCTH-REC-I NOT = REGISTER-ARG
               GO TO 642-LIAI-X.

           IF INVACCTH-PO-NUM = INVH-PO-RLSE
               NEXT SENTENCE
           ELSE
               GO TO 642-GET-DINVACCT.

           MOVE SPACES                 TO  BUF-DINVACCT.
           MOVE INVACCTH-REG-NO        TO  INVACCT-REG-NO.
           MOVE INVACCTH-DATA          TO  INVACCT-DATA.
           MOVE INVACCTH-PCT           TO  INVACCT-PCT.
           MOVE INVACCTH-ITEM          TO  INVACCT-ITEM.
           IF INVACCTH-LINE NOT NUMERIC
               MOVE ZEROS              TO  INVACCT-LINE
           ELSE
               MOVE INVACCTH-LINE      TO  INVACCT-LINE
           END-IF.

       642-PUT-DINVACCT.
           WRITE DINVACCT-REC-O FROM BUF-DINVACCT
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               PERFORM 70-BACKOUT-ROUTINE  THRU  70-BR-X
               MOVE "PUT DINVACCT*642-PD" TO BU-DISPLAY-MSG
               GO TO 2-BLOWUP.

           GO TO 642-GET-DINVACCT.

       642-LIAI-X.
           EXIT.

       70-BACKOUT-ROUTINE.
           MOVE FILE-STATUS      TO SAVE-FILE-STATUS.
           CALL "SDELTPO" USING BASE, BUILD-PO-NUMBER,
                                COMPANY-SAVE.
           MOVE SAVE-FILE-STATUS TO FILE-STATUS.

       70-BR-X.
           EXIT.

      ******************************************************************
      *   PROTABILITY PARAGRAPHS                                       *
      ******************************************************************
       9999-GETKEY-MPLTINFO-PK-O.
DCR01      INITIALIZE MPLTINFO-PK-REC-O.
           MOVE 0 TO COND-WORD.
           MOVE PLT-ARG TO PLTINFOKEY OF MPLTINFO-PK-REC-O.
           READ MPLTINFO-PK-O INTO BUF-MPLTINFO
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS = "23"
               MOVE 17 TO COND-WORD
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD
               IF HANDLE-BLOWUP-FLAG = "Y"
                   MOVE "GETKEY ERR 9999-GETKEY-MPLTINFO-PK-O"
                       TO BU-MSG-AREA
                   PERFORM 2100-BLOWUP.

       9999-RESET-MPLTINFO-PK-O.
           MOVE HIGH-VALUES TO PLTINFOKEY OF MPLTINFO-PK-REC-O.
           START MPLTINFO-PK-O KEY > PLTINFOKEY OF MPLTINFO-PK-REC-O
               INVALID KEY MOVE "00" TO FILE-STATUS.

       9999-CHAINHD-DINVRCD-RG-I.
           MOVE 0 TO COND-WORD.
           MOVE REGISTER-ARG TO REGISTERNO OF DINVRCD-RG-REC-I.
           START DINVRCD-RG-I KEY = REGISTERNO OF DINVRCD-RG-REC-I
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF (FILE-STATUS NOT = "00") AND (FILE-STATUS-1 NOT = "2")
               MOVE 99 TO COND-WORD
               IF HANDLE-BLOWUP-FLAG = "Y"
                   MOVE "CHAINHD ERR 9999-CHAINHD-DINVRCD-RG-I"
                       TO BU-MSG-AREA
                   PERFORM 2100-BLOWUP.

       9999-GETNEXT-DINVRCD-RG-I.
           MOVE 0 TO COND-WORD.
           READ DINVRCD-RG-I NEXT INTO BUF-DINVRCD
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   MOVE 15 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD
                   IF HANDLE-BLOWUP-FLAG = "Y"
                       MOVE "GETNEXT ERR 9999-GETNEXT-DINVRCD-RG-I"
                           TO BU-MSG-AREA
                       PERFORM 2100-BLOWUP
                   END-IF
           ELSE
           IF REGISTERNO OF DINVRCD-RG-REC-I NOT = REGISTER-ARG
               MOVE 15 TO COND-WORD.

DCR01  COPY POLOGSUBR2 IN COPYLIB.
