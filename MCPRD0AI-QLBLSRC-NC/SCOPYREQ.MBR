       IDENTIFICATION DIVISION.
       PROGRAM-ID. SCOPYREQ.
      *REMARKS.
      *C     THIS PROGRAM WILL OPERATE FROM THE F8 KEY BEING
      *C     PRESSED IN THE ADD MATERIALS OPTION OF THE MMIS PLANNER
      *C     OR ENGINEER FUNCTIONS. IT WILL COPY AN EXISTING REQ'S
      *C     INFORMATION ONTO THE SCREEN FOR ADDING.
      *C
      *C  OCTOBER 11, 2000 JIM COFFMAN
      *C     PICKED UP THE PASSED ENG-PL-SCHD-ID FROM TMODMADD WHEN
      *C     NAPANEE WAS CONCERNED ABOUT THE ORIGINATOR OF THE REQ
      *C     BEING CARRIED OVER INSTEAD OF THE PERSON WHO IS DOING
      *C     THE PLANNING/SCHEDULING.
      *C
       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.
       SOURCE-COMPUTER. AS400.
       OBJECT-COMPUTER. AS400.
       SPECIAL-NAMES. I-O-FEEDBACK IS I-O-FEEDBACK-AREA.
       INPUT-OUTPUT SECTION.

       FILE-CONTROL.
           SELECT DISPLAY-FILE
               ASSIGN TO WORKSTATION-ZMODIFY-SI
               ORGANIZATION IS TRANSACTION
               ACCESS IS SEQUENTIAL
               FILE STATUS IS DSPLY-STATUS
               CONTROL-AREA IS WS-CONTROL.

           SELECT DREQDESC
               ASSIGN TO DATABASE-MCFLCS2301
               ORGANIZATION IS INDEXED
               ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                 WITH DUPLICATES
               FILE STATUS IS FILE-STATUS.

           SELECT DREQITM
               ASSIGN TO DATABASE-MCFLCS2201
               ORGANIZATION IS INDEXED
               ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                 WITH DUPLICATES
               FILE STATUS IS FILE-STATUS.

           SELECT MREQ
               ASSIGN TO DATABASE-MCFLCS2001
               ORGANIZATION IS INDEXED
               ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
               FILE STATUS IS FILE-STATUS.

       DATA DIVISION.
       FILE SECTION.
       FD  DISPLAY-FILE
           LABEL RECORDS ARE OMITTED.
       01  DSPLY-REC                   PIC X(2000).

       FD  DREQDESC
           LABEL RECORDS ARE STANDARD
           DATA RECORD IS DREQDESC-REC.
       01  DREQDESC-REC.
           COPY DDS-MCRPCS2300  OF MCFLCS2301.

       FD  DREQITM
           LABEL RECORDS ARE STANDARD
           DATA RECORD IS DREQITM-REC.
       01  DREQITM-REC.
           COPY DDS-MCRPCS2200  OF MCFLCS2201.

       FD  MREQ
           LABEL RECORDS ARE STANDARD
           DATA RECORD IS MREQ-REC.
       01  MREQ-REC.
           COPY DDS-MCRPCS2000  OF MCFLCS2001.

       WORKING-STORAGE SECTION.
       77  SUB                          PIC S9(4) COMP-4.
       77  SAVE-ORIG                    PIC X(4).

       01  BASE                         PIC X(10).

       COPY CATREAD   OF COPYLIB.

       COPY CDESC     OF COPYLIB.

       01  CODE-ARG                     PIC X(8).

       COPY CPYIND    OF COPYLIB.

       COPY DBSTAT    OF COPYLIB.

       COPY DREQDESC  OF COPYLIB.

       COPY DREQITM   OF COPYLIB.

       01  DSPLY-STATUS                 PIC XX.

       01  ERROR-BUFFER.
           05  FILLER                  PIC X(38).
           05  REQ-ERROR               PIC X(12).
           05  FILLER                  PIC X(30).

       01  FILE-STATUS                 PIC XX.

       01  INPUT-BUF.
           05  INPUT-REQNUM            PIC X(12).
           05  INPUT-CMD-LINE          PIC X(79).
           05  INPUT-ERR-LINE          PIC X(79).

       COPY IOFEEDBACK OF COPYLIB.

       COPY LANGSUB   OF COPYLIB.

       COPY MREQ      OF COPYLIB.

       01  PASSWORD-INFORMATION.
           05  NAME-OF-PROGRAM     PIC X(08) VALUE "SCOPYREQ".
           05  PROGRAM-TYPE        PIC X(02) VALUE "UP".
           05  PROGRAM-RELEASE     PIC X(12) VALUE " E0100010001".
           05  PROGRAM-DESCRIPTION.
               10  PROG-DESC-A     PIC X(60) VALUE
             "SPECIAL JOBPLAN MAINTENANCE PROGRAM THAT ALLOWS USER TO ".
               10  PROG-DESC-B     PIC X(60) VALUE
             "MANIPULATE WHOLE JOBPLANS FROM/TO A W/O                 ".
               10  PROG-FUNCTION   PIC X(60) VALUE SPACES.
           05  PASSWORD-FLAG       PIC X.

       COPY TBLOWUP   OF COPYLIB.

       01  TRUE-VAL                PIC 1 VALUE B"1".

       COPY VCOMAREA  OF COPYLIB.

       COPY WSCONTROL OF COPYLIB.

       LINKAGE SECTION.
       01  MATL-WORKAREA.
           05  MATL-HEADER-INFO.
               10  WO-NUM-WA                 PIC X(10).
               10  DESCRIPTION-WA            PIC X(30).
               10  A-C-WA                    PIC X.
               10  WO-STATUS-WA              PIC XX.
               10  EQPNUM-WA                 PIC X(6).
               10  ZONE-WA                   PIC X(4).
               10  DATE-SCHD-WA              PIC X(8).
               10  TIME-SCHD-WA.
                   15  TIME-SCHD-HH-WA       PIC XX.
                   15  TIME-COLON-WA         PIC X.
                   15  TIME-SCHD-MM-WA       PIC XX.
           05  MATL-DATA.
               10  PRT-STATUS-WA.
                   15  PRT-STATUS-1-WA       PIC X.
                   15  PRT-STATUS-2-WA       PIC X.
               10  PRIME-WA                  PIC XXX.
               10  SUB-WA                    PIC XXX.
               10  STAGE-WA                  PIC X(4).
               10  ORIG-WA                   PIC X(4).
               10  DATE-REQD-WA.
                   15  DATE-REQD-MD-WA       PIC XX.
                   15  DATE-REQD-DM-WA       PIC XX.
                   15  DATE-REQD-YY-WA       PIC XX.
               10  ADDL-INFO-WA              PIC X(14).
               10  SUGG-VENDOR-WA            PIC X(30).
               10  ITEM-NO-WA                PIC X(4).
               10  PRT-QUANT-WA              PIC X(5).
               10  PRT-QUANT-WA-9 REDEFINES PRT-QUANT-WA  PIC 9(5).
               10  PRT-UNIT-MEAS-WA          PIC XX.
               10  PRT-CODE-WA               PIC X(7).
               10  PRT-UP-WA.
                   15  PRT-UP-DOLS-WA        PIC X(12).
                   15  PRT-UP-DOLS-WA-9 REDEFINES PRT-UP-DOLS-WA
                                             PIC 9(12).
                   15  PRT-UP-CENTS-WA.
                       20  PRT-UP-CENTS-WA-1 PIC X.
                       20  PRT-UP-CENTS-WA-2 PIC X.
               10  PRT-UP-WA-9 REDEFINES PRT-UP-WA  PIC 9(12)V99.
               10  ADDL-DATA-WA              PIC X(8).
               10  PRT-PM-LEVEL-WA           PIC XX.
               10  PRT-PM-FLAG-WA            PIC XX.
               10  PRT-PM-SUBS-WA            PIC XXXX.
               10  PRT-DESC-WA.
                   15  P-D-WA OCCURS 395 TIMES  PIC X.
               10  PRT-DESC-WA-80 REDEFINES PRT-DESC-WA.
                   15  P-D-WA-80 OCCURS 5    PIC X(79).
               10  REMARKS-WA.
                   15  REMARKS-1-WA          PIC X(79).
                   15  REMARKS-2-WA          PIC X(79).
               10  DOCK-NOTIFY-WA            PIC X(10).
               10  MESSAGE-WA                PIC X(79).
           05  MATL-CMD-LINE                 PIC X(79).
           05  MATL-ERR-LINE                 PIC X(79).


       PROCEDURE DIVISION USING MATL-WORKAREA.
       START-PROGRAM.
           PERFORM 1-HOUSEKEEPING.
           PERFORM 6-MAIN THRU 6-M-X.
           CLOSE DISPLAY-FILE.
           CLOSE DREQDESC.
           CLOSE DREQITM.
           CLOSE MREQ.
           GOBACK.

       1-HOUSEKEEPING.
           OPEN I-O    DISPLAY-FILE.
           OPEN INPUT  DREQDESC.
           OPEN INPUT  DREQITM.
           OPEN INPUT  MREQ.
           MOVE SPACES TO INPUT-BUF ERROR-BUFFER.
           MOVE SPACES TO SAVE-ORIG.
           IF ORIG-WA NOT = "    " MOVE ORIG-WA TO SAVE-ORIG.
           MOVE SPACES TO PRT-STATUS-WA SUB-WA STAGE-WA ORIG-WA
               DATE-REQD-WA ADDL-INFO-WA SUGG-VENDOR-WA
               PRT-QUANT-WA PRT-CODE-WA PRT-UP-WA PRT-PM-LEVEL-WA
               PRT-PM-FLAG-WA PRT-PM-SUBS-WA PRT-DESC-WA
               REMARKS-WA DOCK-NOTIFY-WA MESSAGE-WA PRT-UNIT-MEAS-WA.
           MOVE "FCOPYREQ" TO VIEW-CFNAME.

       6-MAIN.
           MOVE INPUT-BUF TO DSPLY-REC.
           PERFORM 99-SCREEN-WRITE.
           PERFORM 98-SCREEN-READ.
           MOVE DSPLY-REC TO INPUT-BUF.
           IF VIEW-LASTKEY = 3 GO TO 6-M-X.
           MOVE INPUT-REQNUM TO REQNO OF MREQ-REC.
           READ MREQ INTO BUF-MREQ
               INVALID KEY    MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE 18005 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE ERROR-BUFFER TO INPUT-ERR-LINE
               MOVE TRUE-VAL TO INDS (1) INDS (99)
               GO TO 6-MAIN.
           MOVE "M "             TO  PRT-STATUS-WA.
           MOVE REQ-PRIME        TO  PRIME-WA.
           MOVE REQ-SUB          TO  SUB-WA.
           MOVE REQ-ADDTL-DATA   TO  ADDL-DATA-WA.
           MOVE REQ-ADDL-INFO    TO  ADDL-INFO-WA.
           IF SAVE-ORIG = "    "
               MOVE REQ-ORIGINATOR   TO  ORIG-WA
           ELSE
           MOVE SAVE-ORIG        TO  ORIG-WA.
           MOVE REQ-STAGING-AREA TO  STAGE-WA.
           MOVE REQ-DOCK-NOTIFY  TO  DOCK-NOTIFY-WA.
           PERFORM 61-GET-DREQITM  THRU 61-GD-X.
           IF REQ-STATUS = "SS"
               MOVE 5 TO CDESC-LINES-TO-GET
               MOVE "N" TO CDESC-LOCAL-DESC-OPTION
               CALL "CDESC" USING CDESC-RET-CODE, BASE, STATUS-AREA,
                              BU-DISPLAY-MSG, CODE-ARG, CDESC-DATA
               IF BU-DISPLAY-MSG NOT = SPACES
                   GO TO 6-M-X
               ELSE
               MOVE CDESC (1) TO P-D-WA-80 (1)
               MOVE CDESC (2) TO P-D-WA-80 (2)
               MOVE CDESC (3) TO P-D-WA-80 (3)
               MOVE CDESC (4) TO P-D-WA-80 (4)
               MOVE CDESC (5) TO P-D-WA-80 (5)
           ELSE
           PERFORM 62-GET-DREQDESC THRU 62-GD-X.
       6-M-X.    EXIT.

       61-GET-DREQITM.
           MOVE INPUT-REQNUM TO REQNO OF DREQITM-REC.
           START DREQITM KEY = REQNO OF DREQITM-REC
               INVALID KEY    MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00" GO TO 61-GD-X.
       61-GD-LOOP.
           READ DREQITM NEXT INTO BUF-DREQITM
               AT END    MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00" GO TO 61-GD-X.
           IF REQITM-REQ-NUMBER NOT = INPUT-REQNUM GO TO 61-GD-X.
           IF REQITM-CORP-CODE = "NON-STR"
               NEXT SENTENCE
           ELSE
           MOVE REQITM-CORP-CODE TO PRT-CODE-WA,
                                    CODE-ARG.
           MOVE REQITM-QTY-TO-ORD TO PRT-QUANT-WA-9.
           MOVE REQITM-UM TO PRT-UNIT-MEAS-WA.
           MOVE REQITM-UNIT-PRICE TO PRT-UP-WA-9.
       61-GD-X.    EXIT.

       62-GET-DREQDESC.
           MOVE 0 TO SUB.
           MOVE INPUT-REQNUM TO REQNO OF DREQDESC-REC.
           START DREQDESC KEY = REQNO OF DREQDESC-REC
               INVALID KEY    MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00" GO TO 62-GD-X.
       62-GD-LOOP.
           READ DREQDESC NEXT INTO BUF-DREQDESC
               AT END    MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00" GO TO 62-GD-X.
           IF REQDESC-REQ-NUMBER NOT = INPUT-REQNUM GO TO 62-GD-X.
           IF REQDESC-LINE-NO = "95"
               MOVE REQDESC-DATA TO REMARKS-1-WA
           ELSE
           IF REQDESC-LINE-NO = "96"
               MOVE REQDESC-DATA TO REMARKS-2-WA
           ELSE
           ADD 1 TO SUB
           IF SUB > 5
               GO TO 62-GD-X
           ELSE
           MOVE REQDESC-DATA TO P-D-WA-80 (SUB).
           GO TO 62-GD-LOOP.
       62-GD-X.    EXIT.

       98-SCREEN-READ.
           READ DISPLAY-FILE FORMAT IS VIEW-CFNAME
               INDIC IS INDICS.
           ACCEPT IOFEEDBACK FROM I-O-FEEDBACK-AREA.
           MOVE ALL B"0" TO INDICS.
           IF DSPLY-STATUS NOT = "00"
               MOVE 3 TO VIEW-LASTKEY
           ELSE
           MOVE FUNCTION-NUM TO VIEW-LASTKEY.

       98A-SCREEN-READ.
           READ DISPLAY-FILE TERMINAL IS TERMINAL-ID
               INDIC IS INDICS
                  NO DATA  MOVE DSPLY-STATUS TO DSPLY-STATUS.
           MOVE ALL B"0" TO INDICS.

       99-SCREEN-WRITE.
           WRITE DSPLY-REC FORMAT IS VIEW-CFNAME
               INDIC IS INDICS.
           MOVE ALL B"0" TO INDICS.

       999-CATREAD.
           MOVE SPACES TO ERROR-BUFFER.
           CALL "CCATREAD" USING CATREAD-PARMS.
           MOVE CATREAD-MSG-TEXT TO ERROR-BUFFER.

       999-CATREAD-EXIT.
           EXIT.
