               "  **** FINISHED STOCK VALUE ****  ".
           05  FSL-VALUE                 PIC ZZZ,ZZZ,ZZ9.

      **************************************************************
      **##########################################################**
      **************************************************************
      **                                                          **
      **          P R O C E D U R E     D I V I S I O N           **
      **                                                          **
      **************************************************************
      **##########################################################**
      **************************************************************

       PROCEDURE DIVISION.

       PROC-DIV SECTION 01.

       START-HERE.
           PERFORM 1-HSK                 THRU  1-HSK-X.

           PERFORM 3-GET-PARMS           THRU  3-GP-X.

           PERFORM 6-MAIN                THRU  6-MAIN-X.

           PERFORM 2-EOJ                 THRU  2-EOJ-X.

           GOBACK.

       1-HSK.
9406CK     MOVE "C" TO SCOPE.
9406CK     CALL "MCXCBLERR" USING SCOPE.

           PERFORM 9999-OPENS.

      **************************************************
      *                                                *
      *   GET CO. AND PRIME FROM MPLTINFO              *
      *   USING 'P 01' AS THE ARGUMENT                 *
      *                                                *
      **************************************************

           MOVE "P 01"  TO  PLT-ARG.
           PERFORM 9999-GETKEY-MPLTINFO-PK-I.
           IF NO-ENTRY
               MOVE "GETKEY MPLTINFO 1-HSK P 01"  TO  BU-DISPLAY-MSG
               MOVE PLT-ARG              TO  BU-DISPLAY-FLD (1)
               GO TO 2100-BLOWUP.
           MOVE MPLTINFO-COMPANY         TO  COMPANY-SAVE,
                                             PLANT-H1.

      *----- SET PARAMETERS FOR CALL TO 'CDESC'
           MOVE "K" TO CDESC-DESC-OPTION.
           MOVE 1 TO CDESC-LINES-TO-GET.

       1-HSK-X.
           EXIT.

       2-EOJ.
           CLOSE RAWMTL-FILE, STOCK-FILE.
           MOVE "RMACTIVE" TO DLTF-FILE-NAME.
           CALL "CDLTF" USING DLTF-FILE-NAME.

           IF NOT PAPER-IS-132-COLS
               WRITE PRINT-REC FROM NORMAL-PRINT
                   AFTER ADVANCING 0 LINES.

           PERFORM 9999-CLOSES THRU 9999-CLOSES-EXIT.

       2-EOJ-X.
            EXIT.

      ******************************************************
      **                                                  **
      **   BLOWUP ROUTINE                                 **
      **                                                  **
      ******************************************************

       2100-BLOWUP.
           MOVE "TRWMTLRP"               TO  BU-PGM-NAME.
           CALL "TBLOWUP" USING BASE, BU-PGM-NAME, STATUS-AREA,
               DUMMY-VIEW-AREA, FILE-STATUS, BU-DISPLAY-MSG,
                       BU-DISPLAY-FLDS.

       2100-BLOWUP-X.
           EXIT.

       3-GET-PARMS.
      *------------- GET PARMS FOR REPORT
           ACCEPT HD-ROUTE-DATA.
           DISPLAY HD-ROUTE-DATA.

           OPEN OUTPUT PRINT-FILE.

           PERFORM 9999-GETFNUM.
           MOVE "DHDRWMTL.PUB"   TO HD-FILE-NAME.
           CALL "THDPRT2" USING HD-RET-CODE, HD-FILE-NAME, FNUM,
               HD-ROUTE-DATA, ESC-NAME.
           IF HD-RET-CODE NOT = 0
               MOVE "THDPRT2 ERROR * RWMTLRP" TO BU-DISPLAY-MSG
               MOVE "HD-RET-CODE = "         TO BU-DISPLAY-FLD (1)
               MOVE HD-RET-CODE              TO BU-DISPLAY-FLD9 (1)
               GO TO 2100-BLOWUP.

           CALL "TESCSEQ" USING ESC-NAME.
           MOVE CHAR-1636PI             TO COMPRESS-PRINT.
           MOVE CHAR-10PI               TO NORMAL-PRINT.
           MOVE CHAR-5PI                TO EXPAND-PRINT.

           IF NOT PAPER-IS-132-COLS
               WRITE PRINT-REC FROM COMPRESS-PRINT
                   AFTER ADVANCING 0 LINES.

           MOVE 1                       TO DATE-MODE.
           CALL "TDATECHK" USING DATE-CHECK-AREA.
           MOVE DATE-FORMATTED-TIME-OUT TO H2-TIME.
           MOVE DATE-SLASH-OUT          TO H2-DATE.
           MOVE DATE-YMD-OUT             TO DATE-CHK.

       3-GP-X.
           EXIT.


      **************************************************
      *                                                *
      *               6 - M A I N                      *
      *                                                *
      **************************************************

       6-MAIN.

           SORT SORT-FILE  ON ASCENDING KEY SORT-CLASS
                                            SORT-ADJ
                                            SORT-CODE
               INPUT  PROCEDURE IS 7-PROCESS-SORT
               OUTPUT PROCEDURE IS 8-WRITE-REPORT.

       6-MAIN-X.
           EXIT.

       9999-GETFNUM.
      * DUMMY COPYLIB MEMBER ON AS/400

       9999-OPENS.
           OPEN INPUT MPLTINFO-PK-I
                      MSTORERM-CD-I
                      DRCVITEM-CD-I
                      USAGEFIL-CD-I.

       9999-CLOSES.
           CLOSE      MPLTINFO-PK-I
                      MSTORERM-CD-I
                      DRCVITEM-CD-I
                      USAGEFIL-CD-I.
       9999-CLOSES-EXIT.
           EXIT.

       9999-GETKEY-MPLTINFO-PK-I.
           MOVE 0 TO COND-WORD.
           MOVE PLT-ARG TO PLTINFOKEY OF MPLTINFO-PK-REC-I.
           READ MPLTINFO-PK-I INTO BUF-MPLTINFO
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS = "23"
               MOVE 17 TO COND-WORD
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD
               IF HANDLE-BLOWUP-FLAG = "Y"
                   MOVE "GETKEY ERR 9999-GETKEY-MPLTINFO-PK-I"
                       TO BU-MSG-AREA
                   PERFORM 2100-BLOWUP.

       9999-GETKEY-MSTORERM-CD-I.
           MOVE 0 TO COND-WORD.
           MOVE CODE-ARG TO CORPCDE OF MSTORERM-CD-REC-I.
           READ MSTORERM-CD-I INTO BUF-MSTORERM
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS = "23"
               MOVE 17 TO COND-WORD
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD
               IF HANDLE-BLOWUP-FLAG = "Y"
                   MOVE "GETKEY ERR 9999-GETKEY-MSTORERM-CD-I"
                       TO BU-MSG-AREA
                   PERFORM 2100-BLOWUP.

       9999-CHAINHD-DRCVITEM-CD-I.
           MOVE 0 TO COND-WORD.
           MOVE CODE-ARG TO CORPCDE OF DRCVITEM-CD-REC-I.
           START DRCVITEM-CD-I KEY = CORPCDE OF DRCVITEM-CD-REC-I
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF (FILE-STATUS NOT = "00") AND (FILE-STATUS-1 NOT = "2")
               MOVE 99 TO COND-WORD
               IF HANDLE-BLOWUP-FLAG = "Y"
                   MOVE "CHAINHD ERR 9999-CHAINHD-DRCVITEM-CD-I"
                       TO BU-MSG-AREA
                   PERFORM 2100-BLOWUP.

       9999-GETNEXT-DRCVITEM-CD-I.
           MOVE 0 TO COND-WORD.
           READ DRCVITEM-CD-I NEXT INTO BUF-DRCVITEM
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   MOVE 15 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD
                   IF HANDLE-BLOWUP-FLAG = "Y"
                       MOVE "GETNEXT ERR 9999-GETNEXT-DRCVITEM-CD-I"
                           TO BU-MSG-AREA
                       PERFORM 2100-BLOWUP
                   END-IF
           ELSE
           IF CORPCDE OF DRCVITEM-CD-REC-I NOT = CODE-ARG
               MOVE 15 TO COND-WORD.

       9999-GETKEY-USAGEFIL-CD-I.
           MOVE 0 TO COND-WORD.
           MOVE CODE-ARG TO CORPCDE OF USAGEFIL-CD-REC-I.
           READ USAGEFIL-CD-I INTO BUF-USAGEFIL
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS = "23"
               MOVE 17 TO COND-WORD
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD.


      **************************************************************
      **            I N P U T    P R O C E D U R E                **
      **************************************************************

       7-PROCESS-SORT  SECTION.
       7-PSS.
           OPEN INPUT RAWMTL-FILE.
           PERFORM 73-READ-CODES.
           IF ALL-RECORDS-READ
               GO TO 79-EXIT.
           PERFORM 71-PROCESS-CODES THRU 73-READ-CODES
               UNTIL ALL-RECORDS-READ.

      **********************************************
      *   TRANSFER CONTROL TO LAST STATEMENT IN    *
      *   INPUT PROCEDURE FOR SORTING OF RECORDS.  *
      **********************************************

           GO TO 79-EXIT.

       71-PROCESS-CODES.
           MOVE RAWMTL-CODE              TO CODE-ARG,
                                            DE-CODE.

           PERFORM 9999-GETKEY-MSTORERM-CD-I.
           IF NO-ENTRY
             GO TO 73-READ-CODES.

           CALL "CDESC" USING CDESC-RET-CODE, BASE, STATUS-AREA,
               BU-DISPLAY-MSG, DE-CODE, CDESC-DATA.
           IF BU-DISPLAY-MSG NOT = SPACES
               PERFORM 2100-BLOWUP.

       72-RELEASE-SORT.
           MOVE SPACES                   TO SORT-REC.
           MOVE RAWMTL-CODE              TO SORT-CODE.
           MOVE RAWMTL-LBS               TO SORT-LBS.
           MOVE STR-CLASS                TO SORT-CLASS.
           MOVE CDESC-KEYWORD  (1)       TO SORT-KW.
           MOVE CDESC-MODIFIER (1)       TO SORT-ADJ.
           RELEASE SORT-REC.

       73-READ-CODES.
           READ RAWMTL-FILE AT END MOVE "YES" TO RAWMTL-EOF.

       79-EXIT.

      **************************************************************
      **            O U T P U T    P R O C E D U R E              **
      **************************************************************
       8-WRITE-REPORT SECTION.
       8-WRS.
           OPEN INPUT STOCK-FILE.
           READ STOCK-FILE AT END
               MOVE "*** NO FINISHED STOCK VALUE FIGURE FOUND ***"
                   TO PRINT-REC
               WRITE PRINT-REC AFTER ADVANCING 2 LINES
               GO TO 89-EXIT.

           PERFORM 89-NEW-PAGE.
           PERFORM 84-READ-SORT-FILE.
           IF END-OF-SORT
               MOVE "** NO RECORDS AVAILABLE AT THIS TIME **"
                       TO PRINT-REC
               WRITE PRINT-REC AFTER ADVANCING 2 LINES
               GO TO 89-EXIT
           ELSE
               MOVE "Y"                  TO CLASS-START-SW.

           PERFORM 81-PROCESS-SORT-RECS THRU 84-READ-SORT-FILE
               UNTIL END-OF-SORT.

           PERFORM 89-CLASS-BREAK.
           PERFORM 85-REPORT-TOTALS.

           GO TO 89-EXIT.

       81-PROCESS-SORT-RECS.
           IF SORT-CLASS NOT = SAVE-CLASS AND NOT START-CLASS
               PERFORM 89-CLASS-BREAK.

           MOVE SORT-CODE                TO CODE-ARG.

           PERFORM 9999-GETKEY-MSTORERM-CD-I.
           IF NO-ENTRY
             GO TO 84-READ-SORT-FILE.

           IF START-CLASS
               MOVE SORT-CLASS           TO DL1-CLASS,
                                            SAVE-CLASS
               MOVE "N"                  TO CLASS-START-SW
           ELSE
               MOVE SPACES               TO DL1-CLASS.

           MOVE SORT-CODE                TO DL1-CODE.
           MOVE SORT-LBS                 TO DL1-DLY-REQ.
           MOVE STR-ONHAND               TO DL1-INVENTORY.
           MOVE STR-UM                   TO DL1-UM.
           MOVE STR-AVG-COST             TO DL1-AVG-COST.
      *----- CALCULATE TOTAL ONORDER
           MOVE ZEROS                    TO SONORDER-TOTAL-ONORDER,
                                            SONORDER-STR-ONORDER,
                                            SONORDER-DIR-ONORDER.
           CALL "SONORDER" USING BASE, CODE-ARG, SONORDER-PARMS,
               COMPANY-SAVE, STATUS-AREA, BU-DISPLAY-MSG,
               BU-DISPLAY-FLDS.
           IF BU-DISPLAY-MSG NOT = SPACES
               PERFORM 2100-BLOWUP.


           MOVE SONORDER-TOTAL-ONORDER   TO DL1-ON-ORDER.
           ADD  SONORDER-TOTAL-ONORDER   TO CLASS-ONORDER.

      *------ CALCULATE 'DAYS ON HAND'
           COMPUTE DAYS-ON-HAND ROUNDED = STR-ONHAND / SORT-LBS
           MOVE DAYS-ON-HAND             TO DL1-DAYS-OH.

      *------ CALCULATE 'INVENTORY VALUE'
           COMPUTE INV-VALUE ROUNDED = STR-AVG-COST * STR-ONHAND.
           MOVE INV-VALUE                TO DL1-INV-VALUE.
           ADD  INV-VALUE                TO CLASS-INV-VALUE.

      *------ CALCULATE 'ACCT DAYS'
           COMPUTE ACCT-DAYS ROUNDED = INV-VALUE / FNSHD-STOCK-VALUE.
           MOVE ACCT-DAYS                TO DL1-ACCT-DAYS.


           MOVE SORT-KW                  TO DL2-KW.
           MOVE SORT-ADJ                 TO DL2-ADJ.

      *------ GET USAGE FIGURES FOR 24 HR AND MTD
           PERFORM 9999-GETKEY-USAGEFIL-CD-I.
           IF NO-ENTRY
               MOVE "GETKEY USAGEFIL" TO BU-DISPLAY-MSG
               MOVE CODE-ARG TO BU-DISPLAY-FLD (1)
               PERFORM 2100-BLOWUP.

           MOVE K-MTH-USAGE (14)         TO DL2-24HR-USAGE.
           ADD  K-MTH-USAGE (14)         TO CLASS-24HR-USAGE.

           MOVE K-MTH-USAGE (13)         TO DL2-MTD-USAGE.
           ADD  K-MTH-USAGE (13)         TO CLASS-MTD-USAGE.

           PERFORM 9999-CHAINHD-DRCVITEM-CD-I.

       82-CHAINED-READ-DRCVITEM.
           PERFORM 9999-GETNEXT-DRCVITEM-CD-I.
           IF END-OF-CHAIN
             MOVE MTD-RECEIPTS TO DL2-MTD-RECEIPTS
             ADD MTD-RECEIPTS TO CLASS-MTD-RECEIPTS
             MOVE ZEROS TO MTD-RECEIPTS
             GO TO 83-PRINT-LINE.

           IF RCV-YY-RCVD = CHK-YY
               IF RCV-MM-RCVD = CHK-MM
                   IF RCV-ITEM-UM = STR-UM
                       ADD RCV-QTY-DLVR  TO MTD-RECEIPTS
                   ELSE
                   IF RCV-ITEM-UM = STR-UM1
                       COMPUTE STR-RCV-QTY =
                              RCV-QTY-DLVR * STR-UM1-CF
                       ADD STR-RCV-QTY  TO MTD-RECEIPTS
                   ELSE
                   IF RCV-ITEM-UM = STR-UM2
                       COMPUTE STR-RCV-QTY =
                              RCV-QTY-DLVR * STR-UM2-CF
                       ADD STR-RCV-QTY  TO MTD-RECEIPTS.

           GO TO 82-CHAINED-READ-DRCVITEM.

       83-PRINT-LINE.
           ADD SORT-LBS                  TO CLASS-LBS.
           ADD STR-ONHAND                TO CLASS-ONHAND.

           IF LINE-CTR > 56
               PERFORM 89-NEW-PAGE
               MOVE SORT-CLASS           TO DL1-CLASS.

           WRITE PRINT-REC  FROM DETAIL-LINE  AFTER ADVANCING 2 LINES.
           WRITE PRINT-REC  FROM DETAIL-LINE2 AFTER ADVANCING 1 LINES.
           ADD 3 TO LINE-CTR.

       84-READ-SORT-FILE.
           RETURN SORT-FILE
               AT END MOVE "YES" TO SORT-EOF.

       85-REPORT-TOTALS.
           IF LINE-CTR > 58
               PERFORM 89-NEW-PAGE.

           MOVE GRAND-LBS                TO GL1-DLY-REQ
           MOVE GRAND-ONHAND             TO GL1-INVENTORY.
           MOVE GRAND-ONORDER            TO GL1-ON-ORDER.
           MOVE GRAND-INV-VALUE          TO GL1-INV-VALUE.
           MOVE "LB"                     TO GL1-UM.
           MOVE GRAND-24HR-USAGE         TO GL2-24HR-USAGE.
           MOVE GRAND-MTD-USAGE          TO GL2-MTD-USAGE.
           MOVE GRAND-MTD-RECEIPTS       TO GL2-MTD-RECEIPTS.

      *------ CALCULATE 'DAYS ON HAND'
           COMPUTE GRAND-DAYS-ON-HAND ROUNDED =
               GRAND-ONHAND / GRAND-LBS.
           MOVE GRAND-DAYS-ON-HAND       TO GL1-DAYS-OH.

      *------ CALCULATE 'ACCT DAYS'
           COMPUTE ACCT-DAYS ROUNDED =
               GRAND-INV-VALUE / FNSHD-STOCK-VALUE.
           MOVE ACCT-DAYS                TO GL1-ACCT-DAYS.

           WRITE PRINT-REC  FROM GRAND-LINE  AFTER ADVANCING 2 LINES.
           WRITE PRINT-REC  FROM GRAND-LINE2 AFTER ADVANCING 1 LINES.

           MOVE FNSHD-STOCK-VALUE        TO FSL-VALUE.
           WRITE PRINT-REC FROM FNSHD-STOCK-LINE
             AFTER ADVANCING 2 LINES.

       89-CLASS-BREAK.
           MOVE SAVE-CLASS               TO CL1-CLASS.
           MOVE CLASS-LBS                TO CL1-DLY-REQ.
           MOVE CLASS-ONHAND             TO CL1-INVENTORY.
           MOVE CLASS-INV-VALUE          TO CL1-INV-VALUE.
           MOVE CLASS-ONORDER            TO CL1-ON-ORDER.
           MOVE "LB"                     TO CL1-UM.
           MOVE CLASS-24HR-USAGE         TO CL2-24HR-USAGE.
           MOVE CLASS-MTD-USAGE          TO CL2-MTD-USAGE.
           MOVE CLASS-MTD-RECEIPTS       TO CL2-MTD-RECEIPTS.

      *------ CALCULATE 'DAYS ON HAND'
           COMPUTE CLASS-DAYS-ON-HAND ROUNDED =
               CLASS-ONHAND / CLASS-LBS.
           MOVE CLASS-DAYS-ON-HAND       TO CL1-DAYS-OH.

      *------ CALCULATE 'ACCT DAYS'
           COMPUTE ACCT-DAYS ROUNDED =
               CLASS-INV-VALUE / FNSHD-STOCK-VALUE.
           MOVE ACCT-DAYS                TO CL1-ACCT-DAYS.

           WRITE PRINT-REC  FROM CLASS-LINE-DASH
                                           AFTER ADVANCING 2 LINES.
           WRITE PRINT-REC  FROM CLASS-LINE  AFTER ADVANCING 1 LINES.
           WRITE PRINT-REC  FROM CLASS-LINE2 AFTER ADVANCING 1 LINES.
           WRITE PRINT-REC  FROM CLASS-LINE-DASH
                                           AFTER ADVANCING 1 LINES.
           ADD 5 TO LINE-CTR.

      *------ ACCUMULATE GRAND TOTALS
           ADD  CLASS-LBS                TO GRAND-LBS.
           ADD  CLASS-ONHAND             TO GRAND-ONHAND.
           ADD  CLASS-ONORDER            TO GRAND-ONORDER.
           ADD  CLASS-INV-VALUE          TO GRAND-INV-VALUE.
           ADD  CLASS-24HR-USAGE         TO GRAND-24HR-USAGE.
           ADD  CLASS-MTD-USAGE          TO GRAND-MTD-USAGE.
           ADD  CLASS-MTD-RECEIPTS       TO GRAND-MTD-RECEIPTS.

      *------- RESET CLASS TOTALS
           MOVE ZEROS TO CLASS-TOTALS.
           MOVE "Y" TO CLASS-START-SW.

       89-NEW-PAGE.
           WRITE PRINT-REC FROM HEADER-1 AFTER ADVANCING NEW-PAGE.
           ADD  1                       TO PAGE-CTR.
           MOVE PAGE-CTR                TO H2-PAGE-NO.
           WRITE PRINT-REC FROM HEADER-2 AFTER ADVANCING 1 LINES.
           WRITE PRINT-REC FROM HEADER-3 AFTER ADVANCING 2 LINES.
           WRITE PRINT-REC FROM HEADER-4 AFTER ADVANCING 1 LINES.
           WRITE PRINT-REC FROM HEADER-5 AFTER ADVANCING 1 LINES.
           WRITE PRINT-REC FROM HEADER-6 AFTER ADVANCING 1 LINES.
           WRITE PRINT-REC FROM BLANK-LINE AFTER ADVANCING 1 LINES.
           MOVE 8                       TO LINE-CTR.

       89-EXIT.
           EXIT.

