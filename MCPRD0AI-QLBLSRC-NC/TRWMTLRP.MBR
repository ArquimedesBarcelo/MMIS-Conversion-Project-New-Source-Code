       IDENTIFICATION DIVISION.
       PROGRAM-ID.                       TRWMTLRP.
       AUTHOR.                           ANNETTE TREUDLER.
       DATE-WRITTEN.                     APRIL 8, 1988.
       DATE-COMPILED.

      *C   09/04/1996    CA YODER
      *C     RE-COMPILED PROGRAM TO PICK UP CENTURY DATABASE CHANGES.
      *C
      *C  11/25/97    JEFF BUNGO   REQ #97-017
      *C     ADD USAGE FIELDS FOR DIRECT DELIVERY.  DD USAGE
      *C     TO BE STORED IN ADDITIONAL FIELD AND TOTAL USAGE.
      *C     STORE ISSUE USAGE CALCULATED BY TOTAL USAGE - DD USAGE.
      *C

       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.
       SPECIAL-NAMES.          I-O-FEEDBACK     IS I-O-FEEDBACK-AREA
                               LOCAL-DATA       IS LOCAL-DATA-AREA
                               C01 IS NEW-PAGE.
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT RAWMTL-FILE            ASSIGN TO DISK-DRAWMTL.
           SELECT STOCK-FILE             ASSIGN TO DISK-DSTCKVAL.
           SELECT SORT-FILE       ASSIGN TO DISK-SORT.
           SELECT PRINT-FILE ASSIGN TO PRINTER-MCPRT.
           SELECT MPLTINFO-PK-I
               ASSIGN TO DATABASE-MCFLCS0501
               ORGANIZATION IS INDEXED
                 ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
               FILE STATUS IS FILE-STATUS.
           SELECT MSTORERM-CD-I
               ASSIGN TO DATABASE-MCFLCS0201
               ORGANIZATION IS INDEXED
                 ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
               FILE STATUS IS FILE-STATUS.
           SELECT DRCVITEM-CD-I
               ASSIGN TO DATABASE-MCFLCS1202
               ORGANIZATION IS INDEXED
                 ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                 WITH DUPLICATES
               FILE STATUS IS FILE-STATUS.
           SELECT USAGEFIL-CD-I
               ASSIGN TO DATABASE-MCFLCSUSAG
               ORGANIZATION IS INDEXED
                 ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
               FILE STATUS IS FILE-STATUS.

       DATA DIVISION.
       FILE SECTION.

      *------ FOR IBM ONLY ------*
       FD  MPLTINFO-PK-I
           LABEL RECORDS ARE STANDARD.
       01  MPLTINFO-PK-REC-I.
           COPY DDS-MCRPCS0500  OF MCFLCS0501.

       FD  MSTORERM-CD-I
           LABEL RECORDS ARE STANDARD.
       01  MSTORERM-CD-REC-I.
           COPY DDS-MCRPCS0200  OF MCFLCS0201.

       FD  DRCVITEM-CD-I
           LABEL RECORDS ARE STANDARD.
       01  DRCVITEM-CD-REC-I.
           COPY DDS-MCRPCS1200  OF MCFLCS1202.

       FD  USAGEFIL-CD-I
           LABEL RECORDS ARE STANDARD.
       01  USAGEFIL-CD-REC-I.
           COPY DDS-MCRPCSUSAG  OF MCFLCSUSAG.
      *------ FOR IBM ONLY ------*

       FD  PRINT-FILE
           DATA RECORD IS PRINT-REC.
       01  PRINT-REC                PIC X(132).


       FD  RAWMTL-FILE
           DATA RECORD IS RAWMTL-REC
           RECORD CONTAINS 16 CHARACTERS
           LABEL RECORDS ARE OMITTED.
       01  RAWMTL-REC.
           05  RAWMTL-CODE               PIC X(8).
           05  RAWMTL-LBS                PIC 9(8).

       FD  STOCK-FILE
           DATA RECORD IS STOCK-REC
           RECORD CONTAINS 9 CHARACTERS
           LABEL RECORDS ARE OMITTED.
       01  STOCK-REC.
           05  FNSHD-STOCK-VALUE         PIC 9(9).

       SD  SORT-FILE
           DATA RECORD IS SORT-REC
           RECORD CONTAINS 70 CHARACTERS.
       01  SORT-REC.
           05  SORT-CLASS                PIC X(4).
           05  SORT-CODE                 PIC X(8).
           05  SORT-KW                   PIC X(20).
           05  SORT-ADJ                  PIC X(30).
           05  SORT-LBS                  PIC 9(8).

       WORKING-STORAGE SECTION.
      **************************************************************
      *                PROGRAM  VARIABLES                         **
      **************************************************************
       77  HANDLE-BLOWUP-FLAG            PIC X(1)   VALUE "Y".
       77  FATAL-ERR-SW                  PIC X(1)   VALUE SPACES.
       77  EOJ-SW                        PIC X(1)   VALUE SPACES.
       77  LINE-CTR                      PIC 99      VALUE 0.
       77  PAGE-CTR                      PIC 9(4)    VALUE 0.
       01  CLASS-START-SW                PIC X(1)    VALUE "N".
           88  START-CLASS                           VALUE "Y".
       01  SORT-EOF                      PIC X(1)    VALUE "N".
           88  END-OF-SORT                           VALUE "Y".
       01  RAWMTL-EOF                    PIC X(1)    VALUE "N".
           88  ALL-RECORDS-READ                      VALUE "Y".
       01  NO-RECORDS                    PIC X(133)  VALUE
           " NO ITEMS QUALIFIED FOR THE REPORT".
       01  SAVE-CODE                     PIC X(8)    VALUE SPACES.
       01  SAVE-CLASS                    PIC X(4)    VALUE SPACES.
       01  DE-CODE                       PIC X(8)    VALUE SPACES.
       01  COMPANY-SAVE                  PIC X(4)    VALUE SPACES.
       01  DATE-CHK.
           05  CHK-YY                    PIC 99.
           05  CHK-MM                    PIC 99.
           05  CHK-DD                    PIC 99.
9406CK 01  SCOPE   PIC X.

      *************************************************************
      **              A C C U M U L A T O R S                    **
      *************************************************************

       01  INV-VALUE                     PIC S9(9)V99  VALUE 0.
       01  DAYS-ON-HAND                  PIC S9(6)V99  VALUE 0.
       01  ACCT-DAYS                     PIC S9(6)V99  VALUE 0.
       01  MTD-RECEIPTS                  PIC S9(9)     VALUE 0.
       01  STR-RCV-QTY                   PIC S9(8)V9(4) VALUE 0.

       01  CLASS-TOTALS.
           05  CLASS-LBS                 PIC S9(9)      VALUE 0.
           05  CLASS-ONHAND              PIC S9(9)      VALUE 0.
           05  CLASS-ONORDER             PIC S9(9)      VALUE 0.
           05  CLASS-INV-VALUE           PIC S9(9)V99   VALUE 0.
           05  CLASS-24HR-USAGE          PIC S9(9)      VALUE 0.
           05  CLASS-MTD-USAGE           PIC S9(9)      VALUE 0.
           05  CLASS-MTD-RECEIPTS        PIC S9(9)      VALUE 0.
           05  CLASS-DAYS-ON-HAND        PIC S9(6)V99   VALUE 0.

       01  GRAND-TOTALS.
           05  GRAND-LBS                 PIC S9(11)     VALUE 0.
           05  GRAND-ONHAND              PIC S9(11)     VALUE 0.
           05  GRAND-ONORDER             PIC S9(11)     VALUE 0.
           05  GRAND-INV-VALUE           PIC S9(9)V99   VALUE 0.
           05  GRAND-24HR-USAGE          PIC S9(11)     VALUE 0.
           05  GRAND-MTD-USAGE           PIC S9(11)     VALUE 0.
           05  GRAND-MTD-RECEIPTS        PIC S9(11)     VALUE 0.
           05  GRAND-DAYS-ON-HAND        PIC S9(6)V99   VALUE 0.

      *************************************************************
      **          C A L L E D    S U B P R O G R A M S           **
      *************************************************************

       COPY THDPRT     IN COPYLIB.
       COPY TBLOWUP    IN COPYLIB.
       COPY TDATECHK   IN COPYLIB.
       COPY SONORDER   IN COPYLIB.
       COPY CDESC      IN COPYLIB.
       COPY CDLTF      IN COPYLIB.
      *******************************************************
      **           TERMINAL I/O DATA AREA                  **
      *******************************************************

       01  ROUTE-LINE                   PIC X(80).

      *******************************************************
      **               ESCAPE SEQUENCE INFO                **
      *******************************************************

       COPY ESCNAM2 IN COPYLIB.

       01  ESC-INFO.
           05  COMPRESS-PRINT           PIC X(8).
           05  NORMAL-PRINT             PIC X(8).
           05  EXPAND-PRINT             PIC X(8).

      **************************************************************
      **************************************************************
      **                                                          **
      **                DATABASE I/O BUFFER AREA                  **
      **                                                          **
      **************************************************************
      **************************************************************

      *
      * FILE STATUS DEFINITION FOR AS/400 DB CALLS OR HP KSAM CALLS
      *
       01  FILE-STATUS.
           05  FILE-STATUS-1             PIC X.
           05  FILE-STATUS-2             PIC X.

       01  DSET-NAMES.
           05  DSET-NAME                 PIC X(16)  VALUE SPACES.
           05  DSET-MSTORERM             PIC X(16)  VALUE "MSTORERM;".
           05  DSET-DRCVITEM             PIC X(16)  VALUE "DRCVITEM;".
           05  DSET-MPLTINFO             PIC X(16)  VALUE "MPLTINFO;".

       COPY DATAB      IN COPYLIB.
       COPY MSTORERM   IN COPYLIB.
       COPY DRCVITEM   IN COPYLIB.
       COPY MPLT0      IN COPYLIB.
       COPY MPLTP01    IN COPYLIB.
       COPY USAGEFIL   IN COPYLIB.

       01 ITEMS-LISTING.
           05  ALL-ITEMS                 PIC XX     VALUE "@;".
           05  CORP-SEARCH               PIC X(16)  VALUE "CORP-CODE;".

       01 ARG-VALUES.
           05  CODE-ARG                  PIC X(8).
           05  PLT-ARG                   PIC X(4).

