       IDENTIFICATION DIVISION.
       PROGRAM-ID.             TMCRAFT.
       AUTHOR.                 W. ROXBURY.

       INSTALLATION.           GOODYEAR TIRE & RUBBER CO.

       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.

       SOURCE-COMPUTER.        IBM-AS400.
       OBJECT-COMPUTER.        IBM-AS400.

      *****************************************************************
      **          M O D I F I C A T I O N    H I S T O R Y
      *****************************************************************
      *    01/28/97  WDR
      *    RE-WROTE ENTIRE PROGRAM TO MAKE MORE USER-FRIENDLY.
      * ---------------------------------------------------------------*
DCR01 *  APR 15, 2005  DCR01  DAN RAUCH       REQUEST# 2005-78291
DCR01 *     ADD DESCRIPTION TO DATA FILE(USE FILLER AREA(12 BYTES))
DCR01 *     AND DISPLAY FILE ZCRAFT - DISPLAY FILE CREATED FROM ZMASTER
      *****************************************************************


       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT CRAFT-FILE
                  ASSIGN       TO DATABASE-MCFLMM0601
                  ORGANIZATION IS INDEXED
                  ACCESS MODE  IS DYNAMIC
                  RECORD KEY   IS EXTERNALLY-DESCRIBED-KEY
                  FILE STATUS  IS FILE-STAT.

           SELECT DISPLAY-FILE
                  ASSIGN       TO WORKSTATION-ZTMCRAFT-SI
                  ORGANIZATION IS TRANSACTION
                  ACCESS MODE  IS DYNAMIC
                  RELATIVE KEY IS RECNO
                  FILE STATUS  IS SCREEN-STATUS
                               MAJOR-MINOR
                  CONTROL-AREA IS SCREEN-CONTROL.

       DATA DIVISION.
       FILE SECTION.
       FD  CRAFT-FILE
           LABEL RECORDS       ARE STANDARD.
       01  CFT-REC.
           COPY DDS-ALL-FORMATS OF MCFLMM0601.

       FD  DISPLAY-FILE
           LABEL RECORDS ARE OMITTED.
       01  DISPLAY-REC         PIC X(2000).

       WORKING-STORAGE SECTION.
       77  MSG-SW              PIC  X(01).
       77  MSG-BUFFER          PIC  X(76).
       77  MESSAGE-BUFFER      PIC  X(76).
       77  CFT-KEY             PIC  X(02).
       77  RECNO               PIC  9999   VALUE 0.
       77  DISP-CNTR           PIC  99     VALUE 0.
       77  TRUE-VAL            PIC  1      VALUE B"1".
       77  NEG-VAL             PIC  1      VALUE B"0".

       01  PASSWORD-INFORMATION.
           05  NAME-OF-PROGRAM     PIC X(08) VALUE "TMCRAFT ".
           05  PROGRAM-TYPE        PIC X(02) VALUE "MA".
           05  PROGRAM-RELEASE     PIC X(12) VALUE " K0200010001".
           05  PROGRAM-DESCRIPTION.
               10  PROG-DESC-A     PIC X(60) VALUE
           "MAINTENANCE OF THE MMIS CRAFT FILE IN THE MMIS DATABASE.".
               10  PROG-DESC-B     PIC X(60) VALUE SPACES.
               10  PROG-FUNCTION   PIC X(60) VALUE SPACES.
           05  PASSWORD-FLAG       PIC X.

DCR01 *************************************************************
DCR01  01  WS-CRAFT            PIC X(06)            VALUE SPACE.
DCR01  01  WS-FLAG             PIC X(06)            VALUE SPACE.
DCR01  01  WS-DESC             PIC X(36)            VALUE SPACE.
DCR01  01  WS-DSP              PIC X                VALUE SPACE.
DCR01 *************************************************************


       01  FILE-STAT.
           05  FILE-STAT-1     PIC X  VALUE "0".
           05  FILE-STAT-2     PIC X  VALUE "0".

       01  SCREEN-MENU.
           05  CFT-ADD         PIC X(02).
           05  CFT-CHG         PIC X(02).
           05  CFT-DEL         PIC X(02).
           05  CFT-DISP        PIC X(02).
           05  MSGFLDM         PIC X(76).
           05  CMDMSGM         PIC X(79).
           05  ERRMSGM         PIC X(79).

       01  SCREEN-ADD.
           05  ADD-SCREEN.
               10  ACRAFT      PIC X(02).
               10  AFLAG       PIC X(01).
DCR01          10  ADESC       PIC X(12).
           05  CMDMSGA         PIC X(79).
           05  ERRMSGA         PIC X(79).

       01  SCREEN-CHANGE.
           05  CHG-SCREEN.
               10  CCRAFT      PIC X(02).
               10  CFLAG       PIC X(01).
DCR01          10  CDESC       PIC X(12).
           05  CMDMSGC         PIC X(79).
           05  ERRMSGC         PIC X(79).

       01  SCREEN-DELETE.
           05  DEL-SCREEN.
               10  DCRAFT      PIC X(02).
               10  DFLAG       PIC X(01).
DCR01          10  DDESC       PIC X(12).
           05  CMDMSGD         PIC X(79).
           05  ERRMSGD         PIC X(79).

       01  SCREEN-DISPLAY.
           05  SCRAFT.
               10  SCFT-1      PIC X(01).
               10  SCFT-2      PIC X(01).
           05  SFLAG           PIC X(01).
DCR01      05  SDESC           PIC X(12).

       01  SCREEN-MSG.
           05  MSG1            PIC X(11) VALUE "THE CRAFT '".
           05  MSG2            PIC X(11) VALUE "' HAS BEEN ".
           05  MSG3            PIC X(16) VALUE "YOUR CRAFT FILE.".
           05  MSGA            PIC X(09) VALUE "ADDED TO ".
           05  MSGC            PIC X(12) VALUE "MODIFIED IN ".
           05  MSGD            PIC X(13) VALUE "DELETED FROM ".

           COPY SCREENIO       IN COPYLIB.

       01  CRAFT-DATA.
           COPY MWOCRAFT       IN COPYLIB.

       PROCEDURE DIVISION.
       OPEN-PARAGRAPH.
           MOVE SPACE          TO MSG-SW.
           OPEN I-O            DISPLAY-FILE.
           OPEN I-O            CRAFT-FILE.

           CALL "TPWORD"       USING PASSWORD-INFORMATION.
           IF PASSWORD-FLAG = "N"
               GO TO END-OF-JOB.

      *C****************************************************************
      *-- DISPLAY MAIN MENU/INPUT SCREEN (OR HELP/INPUT SCREEN)
      *C****************************************************************

       SETUP-MENU-SCREEN.
           MOVE SPACES         TO SCREEN-MENU
                                  SCREEN-ADD
                                  SCREEN-CHANGE
                                  SCREEN-DELETE.

           MOVE "CFTMENU"      TO SCREEN-NAME.

       SHOW-MENU-SCREEN.
           IF MSG-SW NOT = SPACE
               MOVE SPACE      TO MSG-SW
               MOVE MSG-BUFFER TO MSGFLDM
           ELSE
               MOVE SPACES     TO MSGFLDM.

           MOVE "00"           TO SCREEN-STATUS.
           MOVE  SCREEN-MENU   TO DISPLAY-REC.

           WRITE DISPLAY-REC   FORMAT IS SCREEN-NAME
                               INDIC ARE SCREEN-INDICATORS.
           IF SCREEN-STATUS NOT = "00"
               DISPLAY "SCREEN WRITE ERROR.  SCREEN-STATUS IS "
                               SCREEN-STATUS
               GO TO END-OF-JOB.

           READ  DISPLAY-FILE  FORMAT IS SCREEN-NAME
                               INDIC ARE SCREEN-INDICATORS
           IF SCREEN-STATUS NOT = "00"
               DISPLAY "SCREEN READ ERROR.  SCREEN-STATUS IS "
                               SCREEN-STATUS
               GO TO END-OF-JOB.

           MOVE ALL B"0"       TO SCREEN-INDICATORS.
           MOVE DISPLAY-REC    TO SCREEN-MENU.

           IF KEY-HIT = 3 OR 8
               GO TO END-OF-JOB.

           IF KEY-HIT = 9
               GO TO SETUP-MENU-SCREEN.

           IF KEY-HIT = 1 OR 2 OR 4 OR 5 OR 6 OR 7
               GO TO READ-SCREEN-CONT.

      *C****************************************************************
      *-- DETERMINE IF ONLY ONE FIELD IS FILLED AND SET FUNCTION KEY
      *-- SO 'ENTER' KEY WILL FUNCTION FOR THAT FIELD ONLY.
      *C****************************************************************

           MOVE  0             TO DISP-CNTR.
           IF CFT-ADD NOT = SPACES
               ADD 1           TO DISP-CNTR.

           IF CFT-CHG NOT = SPACES
               ADD 3           TO DISP-CNTR.

           IF CFT-DEL NOT = SPACES
               ADD 5           TO DISP-CNTR.

           IF CFT-DISP NOT = SPACES
               ADD 7           TO DISP-CNTR.

      *C****************************************************************
      *-- IF MORE THAN ONE FIELD IS FILLED, DISPLAY ERROR DESIGNATING
      *-- THAT USER PRESS THE DESIRED FUNCTION KEY.
      *C****************************************************************

           IF DISP-CNTR = 1 OR 3 OR 5 OR 7
               NEXT SENTENCE
           ELSE
      *M****************************************************************
      *M  PRESS APPROPRIATE FUNCTION KEY TO CONTINUE
      *M****************************************************************
               MOVE "PRESS APPROPRIATE FUNCTION KEY TO CONTINUE"
                               TO ERRMSGM
               MOVE TRUE-VAL   TO IND(99)
               GO TO SHOW-MENU-SCREEN.

           IF DISP-CNTR = 1
               MOVE 1          TO KEY-HIT
           ELSE
           IF DISP-CNTR = 3
               MOVE 2          TO KEY-HIT
           ELSE
           IF DISP-CNTR = 5
               MOVE 4          TO KEY-HIT
           ELSE
           IF DISP-CNTR = 7
               MOVE 5          TO KEY-HIT.

      *C****************************************************************
      *-- EDIT FIELDS FILLED AND DETERMINE VALID INPUT FOR FUNCTION
      *-- REQUESTED.  IF VALID, PERFORM FUNCTION.
      *C****************************************************************

       READ-SCREEN-CONT.
           IF KEY-HIT = 1
               IF CFT-ADD = SPACES
      *M********************************************************************
      *M CRAFT IS REQUIRED
      *M********************************************************************
                   MOVE "CRAFT IS REQUIRED"
                               TO ERRMSGM
                   MOVE TRUE-VAL TO IND(1) IND(99)
                   GO TO SHOW-MENU-SCREEN
               ELSE
                   MOVE CFT-ADD TO CFT-KEY
                   PERFORM CHECK-CRAFT THRU CHECK-CRAFT-EXIT
                   IF FILE-STAT = "23"
                       PERFORM ADD-CRAFT THRU ADD-CRAFT-EXIT
                       GO TO SETUP-MENU-SCREEN
                   ELSE
                   IF FILE-STAT = "00"
      *M********************************************************************
      *M CRAFT ALREADY EXISTS
      *M********************************************************************
                       MOVE "CRAFT ALREADY EXISTS"
                                       TO ERRMSGM
                       MOVE TRUE-VAL   TO IND(1) IND(99)
                       GO TO SHOW-MENU-SCREEN
                   ELSE
                       MOVE MESSAGE-BUFFER TO ERRMSGM
                       MOVE TRUE-VAL   TO IND(1) IND(99)
                       GO TO SHOW-MENU-SCREEN.

           IF KEY-HIT = 2
               IF CFT-CHG = SPACES
      *M********************************************************************
      *M CRAFT IS REQUIRED
      *M********************************************************************
                   MOVE "CRAFT IS REQUIRED"
                               TO ERRMSGM
                   MOVE TRUE-VAL TO IND(2) IND(99)
                   GO TO SHOW-MENU-SCREEN
               ELSE
                   MOVE CFT-CHG TO CFT-KEY
                   PERFORM CHECK-CRAFT THRU CHECK-CRAFT-EXIT
                   IF FILE-STAT = "00"
                       PERFORM CHG-CRAFT THRU CHG-CRAFT-EXIT
                       GO TO SETUP-MENU-SCREEN
                   ELSE
                   IF FILE-STAT = "23"
      *M********************************************************************
      *M INVALID CRAFT
      *M********************************************************************
                       MOVE "INVALID CRAFT"
                                       TO ERRMSGM
                       MOVE TRUE-VAL   TO IND(2) IND(99)
                       GO TO SHOW-MENU-SCREEN
                   ELSE
                       MOVE MESSAGE-BUFFER TO ERRMSGM
                       MOVE TRUE-VAL   TO IND(2) IND(99)
                       GO TO SHOW-MENU-SCREEN.

           IF KEY-HIT = 4
               IF CFT-DEL = SPACES
      *M********************************************************************
      *M CRAFT IS REQUIRED
      *M********************************************************************
                   MOVE "CRAFT IS REQUIRED"
                               TO ERRMSGM
                   MOVE TRUE-VAL TO IND(3) IND(99)
                   GO TO SHOW-MENU-SCREEN
               ELSE
                   MOVE CFT-DEL TO CFT-KEY
                   PERFORM CHECK-CRAFT THRU CHECK-CRAFT-EXIT
                   IF FILE-STAT = "00"
                       PERFORM DEL-CRAFT THRU DEL-CRAFT-EXIT
                       GO TO SETUP-MENU-SCREEN
                   ELSE
                   IF FILE-STAT = "23"
      *M********************************************************************
      *M INVALID CRAFT
      *M********************************************************************
                       MOVE "INVALID CRAFT"
                                       TO ERRMSGM
                       MOVE TRUE-VAL   TO IND(3) IND(99)
                       GO TO SHOW-MENU-SCREEN
                   ELSE
                       MOVE MESSAGE-BUFFER TO ERRMSGM
                       MOVE TRUE-VAL   TO IND(3) IND(99)
                       GO TO SHOW-MENU-SCREEN.

           IF KEY-HIT = 5
               PERFORM DISP-CRAFT THRU DISP-CRAFT-EXIT
               GO TO SETUP-MENU-SCREEN.

           IF KEY-HIT = 7
               MOVE "CFTHELP"  TO SCREEN-NAME
               GO TO SHOW-MENU-SCREEN.

           GO TO SETUP-MENU-SCREEN.

       ADD-CRAFT.
      *C****************************************************************
      *--    >>  ADD CRAFT RECORD TO FILE  <<
      *--  ADD-CRAFT EDITS FOR VALID INPUT AND WRITES A CRAFT
      *--  RECORD TO THE CRAFT FILE (MCFPMM0600) ONLY.
      *C****************************************************************

           MOVE "CFTADD"       TO SCREEN-NAME.

       SHOW-ADD-SCREEN.
           MOVE "00"           TO SCREEN-STATUS.
           MOVE CFT-ADD        TO ACRAFT.
           MOVE  SCREEN-ADD    TO DISPLAY-REC.

           WRITE DISPLAY-REC   FORMAT IS SCREEN-NAME
                               INDIC ARE SCREEN-INDICATORS.
           IF SCREEN-STATUS NOT = "00"
               DISPLAY "SCREEN WRITE ERROR.  SCREEN-STATUS IS "
                               SCREEN-STATUS
               GO TO END-OF-JOB.

           READ  DISPLAY-FILE  FORMAT IS SCREEN-NAME
                               INDIC ARE SCREEN-INDICATORS
           IF SCREEN-STATUS NOT = "00"
               DISPLAY "SCREEN READ ERROR.  SCREEN-STATUS IS "
                               SCREEN-STATUS
               GO TO END-OF-JOB.

           MOVE ALL B"0"       TO SCREEN-INDICATORS.
           MOVE DISPLAY-REC    TO SCREEN-ADD.

           IF KEY-HIT = 3 OR 8
             GO TO END-OF-JOB.

           IF KEY-HIT = 1
             GO TO ADD-CRAFT-EXIT.

           IF AFLAG = " " OR "1" OR "2" OR "4"
               NEXT SENTENCE
           ELSE
      *M********************************************************************
      *M INVALID FLAG
      *M********************************************************************
               MOVE "INVALID FLAG"
                               TO ERRMSGA
               MOVE TRUE-VAL   TO IND(1) IND(99)
               GO TO SHOW-ADD-SCREEN.

DCR01 *M********************************************************************
DCR01 *M MUST ENTER A DESC
DCR01 *M********************************************************************
DCR01      IF ADESC = SPACE
DCR01          MOVE "PLEASE ENTER A DESCRIPTION"  TO ERRMSGA
DCR01          MOVE TRUE-VAL   TO IND(2) IND(99)
DCR01          GO TO SHOW-ADD-SCREEN.

           MOVE SPACES         TO CRAFT-DATA.
           MOVE ACRAFT         TO CRAFT-MSTR.
DCR01      MOVE ADESC          TO CRAFT-PAD.
           MOVE AFLAG          TO CRAFT-FLAG.

           WRITE CFT-REC       FROM CRAFT-DATA
               INVALID KEY
      *M****************************************************************
      *M  ADD FAILED
      *M****************************************************************
                   MOVE "ADD FAILED"
                                   TO ERRMSGA
                   MOVE TRUE-VAL   TO IND(99)
                   GO TO SHOW-ADD-SCREEN.

           MOVE "X"            TO MSG-SW.
           MOVE SPACES         TO MSG-BUFFER.
           STRING MSG1 CFT-ADD MSG2 MSGA MSG3
                               DELIMITED BY SIZE
                               INTO MSG-BUFFER.

       ADD-CRAFT-EXIT.         EXIT.

       CHG-CRAFT.
      *C****************************************************************
      *--    >>  CHANGE CRAFT RECORD IN FILE  <<
      *--  CHG-CRAFT EDITS FOR VALID INPUT AND MODIFIES THE CRAFT
      *--  RECORD IN THE CRAFT FILE (MCFPMM0600).
      *C****************************************************************

           MOVE "CFTCHANGE"    TO SCREEN-NAME.
           MOVE CRAFT-MSTR     TO  CCRAFT.
           MOVE CRAFT-FLAG     TO  CFLAG.
DCR01      MOVE CRAFT-PAD      TO  CDESC.

       SHOW-CHANGE-SCREEN.
           MOVE "00"           TO SCREEN-STATUS.
           MOVE  SCREEN-CHANGE TO DISPLAY-REC.

           WRITE DISPLAY-REC   FORMAT IS SCREEN-NAME
                               INDIC ARE SCREEN-INDICATORS.
           IF SCREEN-STATUS NOT = "00"
               DISPLAY "SCREEN WRITE ERROR.  SCREEN-STATUS IS "
                               SCREEN-STATUS
               GO TO END-OF-JOB.

           READ  DISPLAY-FILE  FORMAT IS SCREEN-NAME
                               INDIC ARE SCREEN-INDICATORS
           IF SCREEN-STATUS NOT = "00"
               DISPLAY "SCREEN READ ERROR.  SCREEN-STATUS IS "
                               SCREEN-STATUS
               GO TO END-OF-JOB.

           MOVE ALL B"0"       TO SCREEN-INDICATORS.
           MOVE DISPLAY-REC    TO SCREEN-CHANGE.

           IF KEY-HIT = 3 OR 8
             GO TO END-OF-JOB.

           IF KEY-HIT = 1
               GO TO CHG-CRAFT-EXIT.

           IF CFLAG = " " OR "1" OR "2" OR "4"
               NEXT SENTENCE
           ELSE
      *M********************************************************************
      *M INVALID FLAG
      *M********************************************************************
               MOVE "INVALID FLAG"
                               TO ERRMSGC
               MOVE TRUE-VAL   TO IND(1) IND(99)
               GO TO SHOW-CHANGE-SCREEN.

DCR01      IF CDESC = SPACE
DCR01          MOVE "PLEASE ENTER A DESCRIPTION" TO ERRMSGC
DCR01          MOVE TRUE-VAL   TO IND(2) IND(99)
DCR01          GO TO SHOW-CHANGE-SCREEN.

           MOVE CCRAFT         TO CRAFTREQD OF CFT-REC.
           READ CRAFT-FILE     INTO CRAFT-DATA
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
               MOVE "CHANGE FAILED - READ CRAFT-FILE"
                               TO ERRMSGC
               MOVE TRUE-VAL   TO IND(99)
                   GO TO SHOW-CHANGE-SCREEN.

           MOVE CFLAG          TO CRAFT-FLAG.
DCR01      MOVE CDESC          TO CRAFT-PAD.
           REWRITE CFT-REC     FROM CRAFT-DATA
               INVALID KEY
                   MOVE "CHANGE FAILED - REWRITE CRAFT-FILE"
                                   TO ERRMSGC
                   MOVE TRUE-VAL   TO IND(99)
                   GO TO SHOW-CHANGE-SCREEN.

           MOVE "X"            TO MSG-SW.
           MOVE SPACES         TO MSG-BUFFER.
           STRING MSG1 CFT-CHG MSG2 MSGC MSG3
                               DELIMITED BY SIZE
                               INTO MSG-BUFFER.

       CHG-CRAFT-EXIT.         EXIT.

       DEL-CRAFT.
      *C****************************************************************
      *--    >>  DELETE CRAFT RECORD IN FILE  <<
      *--  DEL-CRAFT DELETES THE CRAFT RECORD FROM THE CRAFT FILE
      *--  (MCFPMM0600) BUT DOES NOT DELETE ASSOCIATED RECORDS IN
      *--  OTHER FILES.  NO NEW ASSOCIATED RECORDS MAY BE CREATED LINKED
      *--  TO THE OLD (DELETED) CRAFT RECORD.
      *C****************************************************************

           MOVE "CFTDELETE"    TO SCREEN-NAME.
           MOVE CRAFT-MSTR     TO  DCRAFT.
           MOVE CRAFT-FLAG     TO  DFLAG.
DCR01      MOVE CRAFT-PAD      TO  DDESC.

       SHOW-DELETE-SCREEN.
           MOVE "00"           TO SCREEN-STATUS.
           MOVE  SCREEN-DELETE TO DISPLAY-REC.

           WRITE DISPLAY-REC   FORMAT IS SCREEN-NAME
                               INDIC ARE SCREEN-INDICATORS.
           IF SCREEN-STATUS NOT = "00"
               DISPLAY "SCREEN WRITE ERROR.  SCREEN-STATUS IS "
                               SCREEN-STATUS
               GO TO END-OF-JOB.

           READ  DISPLAY-FILE  FORMAT IS SCREEN-NAME
                               INDIC ARE SCREEN-INDICATORS
           IF SCREEN-STATUS NOT = "00"
               DISPLAY "SCREEN READ ERROR.  SCREEN-STATUS IS "
                               SCREEN-STATUS
               GO TO END-OF-JOB.

           MOVE ALL B"0"       TO SCREEN-INDICATORS.
           MOVE DISPLAY-REC    TO SCREEN-DELETE.

           IF KEY-HIT = 3 OR 8
             GO TO END-OF-JOB.

           IF KEY-HIT NOT = 4
               GO TO DEL-CRAFT-EXIT.

           MOVE DCRAFT         TO CRAFTREQD OF CFT-REC.
           READ CRAFT-FILE
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
               MOVE "DELETE FAILED"
                               TO ERRMSGD
               MOVE TRUE-VAL   TO IND(99)
               GO TO SHOW-DELETE-SCREEN.

           DELETE CRAFT-FILE
               INVALID KEY
                   MOVE "DELETE FAILED"
                                   TO ERRMSGD
                   MOVE TRUE-VAL   TO IND(99)
                   GO TO SHOW-DELETE-SCREEN.

           MOVE "X"            TO MSG-SW.
           MOVE SPACES         TO MSG-BUFFER.
           STRING MSG1 CFT-DEL MSG2 MSGD MSG3
                               DELIMITED BY SIZE
                               INTO MSG-BUFFER.

       DEL-CRAFT-EXIT.         EXIT.


DCR01******************************************************
DCR01  DISP-CRAFT.
DCR01
DCR01      MOVE SPACE            TO WS-CRAFT.
DCR01      MOVE SPACE            TO WS-FLAG.
DCR01      MOVE SPACE            TO WS-DESC.
DCR01      MOVE "D"              TO WS-DSP.
DCR01      CALL "SMCRAFT" USING  WS-CRAFT  WS-FLAG  WS-DESC  WS-DSP.
DCR01
DCR01  DISP-CRAFT-EXIT.
DCR01        EXIT.
DCR01******************************************************


       CHECK-CRAFT.
           MOVE CFT-KEY        TO CRAFTREQD OF CFT-REC.
           READ CRAFT-FILE     INTO CRAFT-DATA
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT = "00" OR "23"
               GO TO CHECK-CRAFT-EXIT
           ELSE
               STRING "READ ERROR IN CRAFT-FILE        FILE STATUS = "
                               FILE-STAT
                               DELIMITED BY SIZE
                               INTO MESSAGE-BUFFER.

       CHECK-CRAFT-EXIT.       EXIT.

       END-OF-JOB.
           CLOSE               DISPLAY-FILE.
           CLOSE               CRAFT-FILE.
           GOBACK.

      *************  END OF FILE  ************************************
