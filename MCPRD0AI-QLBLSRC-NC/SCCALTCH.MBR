000200 IDENTIFICATION DIVISION.
000300 PROGRAM-ID.     SCCALTCH.
000400 AUTHOR.         J.S.BUNGO.
000500 DATE-WRITTEN.   1/25/94.
000600 DATE-COMPILED.
000700 INSTALLATION.   THE GOODYEAR TIRE AND RUBBER COMPANY - AKRON.
000800*REMARKS.
000900*D   THIS SUBPROGRAM RENAMES AND DELETES A CORPORATE CODE IN THE
001000*D   CSIS ALTERNATE KEY FOR A CORP CODE FILE.  THIS SUBROUTINE
001100*D   SHOULD BE CALLED WHENEVER A CODE IS RENAMED TO ANOTHER CODE
001200*D   OR WHEN A CORPORATE CODE IS DELETED FROM STORES.  THE PARMS
001300*D   DETERMINE WHICH FUNCTION TO PERFORM ON THE RECORDS FOUND.
001400
001500 ENVIRONMENT DIVISION.
001600 CONFIGURATION SECTION.
001700 SOURCE-COMPUTER.  HP-3000.
001800 OBJECT-COMPUTER.  HP-3000.
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT MALTKEY
               ASSIGN TO DATABASE-MCFLCS3001
               ORGANIZATION IS INDEXED
               ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                  WITH DUPLICATES
               FILE STATUS IS FILE-STAT.
           SELECT MALTKEY-INPUT
               ASSIGN TO DATABASE-MCFLCS3001
               ORGANIZATION IS INDEXED
               ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                  WITH DUPLICATES
               FILE STATUS IS FILE-STAT.


       DATA DIVISION.
       FILE SECTION.
       FD  MALTKEY
           LABEL RECORDS ARE STANDARD.
       01  MALTKEY-REC.
           COPY DDS-ALL-FORMATS OF MCFLCS3001.
       FD  MALTKEY-INPUT
           LABEL RECORDS ARE STANDARD.
       01  MALTKEY-INPUT-REC.
           COPY DDS-ALL-FORMATS OF MCFLCS3001.

002100 WORKING-STORAGE SECTION.
002200
002300 77  FILE-STAT            PIC X(02)  VALUE SPACES.
       77  ALTKEY-EXISTS        PIC X(01)  VALUE "N".
       77  BEGIN-CORPCODE-ALT-KEY  PIC X(40)  VALUE SPACES.

       COPY MALTKEY IN COPYLIB.
005500
005600 COPY DBMODES IN COPYLIB.
005700 COPY DBSTAT  IN COPYLIB.
005800
005900 LINKAGE SECTION.
006100 01  OLD-CODE             PIC X(08).
006200 01  NEW-CODE             PIC X(08).
006300 01  BU-DISPLAY-MSG       PIC X(60).
006400 01  BU-DISPLAY-FLDS.
006500     05  BU-DISPLAY-LINE OCCURS 5 TIMES.
006600         10  BU-DISPLAY-FLD  PIC X(14).
006700         10  BU-DISPLAY-FLD9 PIC S9(8).
006800
006900 PROCEDURE DIVISION USING OLD-CODE
007100                          NEW-CODE
007200                          BU-DISPLAY-MSG
007300                          BU-DISPLAY-FLDS.
007400
007500 6-MAIN.
           OPEN I-O MALTKEY.
           OPEN INPUT MALTKEY-INPUT.

007900     IF NEW-CODE NOT = SPACES
008000*--------RENAME OLD CODE TO NEW CODE
008100         PERFORM RENAME-CODE THRU RENAME-CODE-EXIT
008200     ELSE
008300*--------OLD CODE IS BEING DELETED
008400         PERFORM DELETE-CODE THRU DELETE-CODE-EXIT
008500     END-IF.
           CLOSE MALTKEY
                 MALTKEY-INPUT.
009300     GOBACK.
009400
009500 RENAME-CODE.
           MOVE SPACES TO CORPALTKEY OF MALTKEY.
           START MALTKEY KEY NOT < CORPALTKEY OF MALTKEY
               INVALID KEY MOVE FILE-STAT TO FILE-STAT.
009800     IF FILE-STAT NOT = "00"
010600         GO TO RENAME-CODE-EXIT.
010700 RENAME-LOOP.
           READ MALTKEY NEXT INTO BUF-MALTKEY
               AT END MOVE FILE-STAT TO FILE-STAT.
011000     IF FILE-STAT = "10" OR "14" OR "46"
011100         GO TO RENAME-CODE-EXIT
011200     ELSE IF FILE-STAT NOT = "00"
011300         MOVE "READ ERROR MALTKEY, RENAME"
011400              TO BU-DISPLAY-MSG
011500         MOVE "SCCALTCH" TO BU-DISPLAY-FLD (2)
011600         MOVE FILE-STAT TO BU-DISPLAY-FLD (3)
011700         MOVE OLD-CODE TO BU-DISPLAY-FLD (4)
011800         GO TO RENAME-CODE-EXIT.
           IF ALT-CORP-CODE NOT = OLD-CODE
               GO TO RENAME-LOOP.

012800*----IF NEW ALTKEY EXISTS ALREADY FOR CODE THEN DO NOT RE-ADD
      *---- BUT REMOVE THE ALTERNATE KEY TO THAT CODE.
012900     MOVE "N" TO ALTKEY-EXISTS.
013100     PERFORM CHECK-NEW-ALTKEY THRU CHECK-NEW-ALTKEY-EXIT.
013200     IF ALTKEY-EXISTS = "Y"
               DELETE MALTKEY
                   INVALID KEY MOVE FILE-STAT TO FILE-STAT
               END-DELETE
               IF FILE-STAT NOT = "00"
011300             MOVE "DELETE ERROR MALTKEY, RENAME"
011400                  TO BU-DISPLAY-MSG
011500             MOVE "SCCALTCH" TO BU-DISPLAY-FLD (2)
011600             MOVE FILE-STAT TO BU-DISPLAY-FLD (3)
011700             MOVE OLD-CODE TO BU-DISPLAY-FLD (4)
                   GO TO RENAME-CODE-EXIT
               ELSE
013300             GO TO RENAME-CODE.

      *----UPDATE THE CODE FOR THE ALTERNATE KEY.
           MOVE MALTKEY-REC TO BUF-MALTKEY.
013400     MOVE NEW-CODE TO ALT-CORP-CODE.
           REWRITE MALTKEY-REC FROM BUF-MALTKEY
               INVALID KEY MOVE FILE-STAT TO FILE-STAT.
014600     IF FILE-STAT NOT = "00"
014700         MOVE "REWRITE ERROR MALTKEY, RENAME"
014800              TO BU-DISPLAY-MSG
014900         MOVE "SCCALTCH" TO BU-DISPLAY-FLD (2)
015000         MOVE FILE-STAT TO BU-DISPLAY-FLD (3)
015100         MOVE OLD-CODE TO BU-DISPLAY-FLD (4)
015200         MOVE NEW-CODE TO BU-DISPLAY-FLD (5)
015300         GO TO RENAME-CODE-EXIT.

016300     GO TO RENAME-CODE.
016400 RENAME-CODE-EXIT.
016500     EXIT.
016600
016700 DELETE-CODE.
           MOVE SPACES TO CORPALTKEY OF MALTKEY.
           START MALTKEY KEY NOT < CORPALTKEY OF MALTKEY
               INVALID KEY MOVE FILE-STAT TO FILE-STAT.
017000     IF FILE-STAT NOT = "00"
017800         GO TO DELETE-CODE-EXIT.
017900 DELETE-LOOP.
           READ MALTKEY NEXT INTO BUF-MALTKEY
               AT END MOVE FILE-STAT TO FILE-STAT.
018200     IF FILE-STAT = "10" OR "14" OR "46"
018300         GO TO DELETE-CODE-EXIT
018400     ELSE IF FILE-STAT NOT = "00"
018500         MOVE "READ ERROR MALTKEY, DELETE-CODE"
018600            TO BU-DISPLAY-MSG
018700         MOVE "SCCALTCH" TO BU-DISPLAY-FLD (2)
018800         MOVE FILE-STAT TO BU-DISPLAY-FLD (3)
018900         MOVE OLD-CODE TO BU-DISPLAY-FLD (4)
019000         GO TO DELETE-CODE-EXIT.
           IF ALT-CORP-CODE NOT = OLD-CODE
               GO TO DELETE-LOOP.
           DELETE MALTKEY
               INVALID KEY MOVE FILE-STAT TO FILE-STAT.
019200     IF FILE-STAT NOT = "00"
019300         MOVE "DELETE ERROR MALTKEY, DELETE-CODE"
019400              TO BU-DISPLAY-MSG
019500         MOVE "SCCALTCH" TO BU-DISPLAY-FLD (2)
019600         MOVE FILE-STAT TO BU-DISPLAY-FLD (3)
019700         MOVE OLD-CODE TO BU-DISPLAY-FLD (4)
019800         MOVE BUF-MALTKEY TO BU-DISPLAY-FLD (5)
019900         GO TO DELETE-CODE-EXIT.
020000     GO TO DELETE-CODE.
020100 DELETE-CODE-EXIT.
020200     EXIT.

       CHECK-NEW-ALTKEY.
           MOVE CORPCODE-ALT-KEY TO CORPALTKEY OF MALTKEY-INPUT
                                    BEGIN-CORPCODE-ALT-KEY.
           START MALTKEY-INPUT KEY = CORPALTKEY OF MALTKEY-INPUT
               INVALID KEY MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
              GO TO CHECK-NEW-ALTKEY-EXIT.
       CHECK-ALTKEY-LOOP.
           READ MALTKEY-INPUT NEXT INTO BUF-MALTKEY
               AT END MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT = "00"
               IF CORPCODE-ALT-KEY NOT = BEGIN-CORPCODE-ALT-KEY
                   MOVE "10" TO FILE-STAT
                   GO TO CHECK-NEW-ALTKEY-EXIT
               ELSE
                   IF ALT-CORP-CODE = NEW-CODE
                       MOVE "Y" TO ALTKEY-EXISTS
                   ELSE
                       GO TO CHECK-ALTKEY-LOOP.
       CHECK-NEW-ALTKEY-EXIT.
           EXIT.
