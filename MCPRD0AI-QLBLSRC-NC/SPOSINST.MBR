007800*   FOR WRITING STD INSTRUCTIONS TO *
007900*   SCREEN                          *
008000*                                   *
008100*************************************
008200
008300 01  DB-ADDR-TABLE.
008400     05  DATA-BASE-ADDR OCCURS 60 TIMES.
008500         10  COMMENT-ADDR     PIC X(4).
008600
008900 01  WORK-AREA.
009000     05  TERM-PAGE-CTR           PIC 9(2)    VALUE ZEROS.
009100
009200 01  WORK-AREA-KEYS.
009300     05  BUILD-COMMENT-NO.
009400         10  BUILD-COM-PREFIX       PIC X     VALUE "C".
009500         10  BUILD-COM-NO           PIC X(3)  VALUE SPACES.
009600
009700
009800 01  MESSAGE-BUFFER.
009900     05  MSG-TEXT              PIC X(66)    VALUE SPACE.
010000     05  MSG-FLD               PIC X(10)    VALUE SPACE.
010100     05  MSG-FLD-9  REDEFINES  MSG-FLD      PIC Z(9)9.
010200
010700 01  FIELD-NUMBER              PIC S9(4)    VALUE 1    COMP-4.
011300
       COPY DISPDATA IN COPYLIB.

       COPY IOFEEDBACK IN COPYLIB.

       COPY CATREAD IN COPYLIB.
011400
