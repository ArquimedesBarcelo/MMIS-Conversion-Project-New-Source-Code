019100
019200 COPY TBLOWUP IN COPYLIB.
019400
019500 LINKAGE SECTION.
019600
019700 01  BASE                         PIC X(10).
019800
019900 01  BUILD-PO-SEARCH.
020000     05  PO-PREFIX                PIC X.
020100     05  PO-NO-REL.
020200         10  PO-NO                PIC X(7).
020300         10  PO-REL               PIC X(3).
020400     05  PO-RCV                   PIC X(3).
020500
020600 COPY VCOMLINK IN COPYLIB.
020700
020800***********************************
020900**  PARAMETERS FOR 'SPOSINST'
021000***********************************
021100
021200 COPY SPOSINST IN COPYLIB.
021300
021400 COPY ESCNAME IN COPYLIB.
021500
021600**************************************
021700*                                    *
021800*  PRINTCNTL IS SET TO 1 THIS CAUSES *
021900*  THE FIELD ON A SCREEN PRINTOUT    *
022000*  TO BE UNDERLINED                  *
022100*                                    *
022200*  PAGECNTL IS SET TO 49 (OCTAL 61)  *
022300*  THIS CAUSE THE LP TO EJECT AFTER  *
022400*  THE SCREEN IS PRINTED             *
022500*                                    *
022600**************************************
022700
022800 01  SCREEN-PRINT-PARMS.
022900     05  PRINTCNTL             PIC S9(4)    COMP-4.
023000     05  PAGECNTL              PIC S9(4)    COMP-4.
023100     05  SPOOLFIL-OPEN-SW      PIC X.
023200
023300 01  PASSED-SPOOL-PRT          PIC S9(2)    COMP-4.
023400
023500 COPY LANGSUB IN COPYLIB.
023600
023700
023800 PROCEDURE DIVISION USING BASE,
023900                          BUILD-PO-SEARCH,
024000                          VIEW-COMAREA,
024100                          SPOSINST-PARMS,
024200                          ESC-NAME,
024300                          SCREEN-PRINT-PARMS,
024400                          PASSED-SPOOL-PRT,
024500                          LANGUAGE-PARMS.
024600
024700 PROC-DIV SECTION 04.
024800
024900 BEGIN-HERE.
           OPEN INPUT MCOMMENT-I, DCOMMENT-I.
           OPEN I-O DISPLAY-FILE.

025000     PERFORM 64-PROCESS-STD-INST  THRU 64-PSI-X.
 25100
           CLOSE MCOMMENT-I, DCOMMENT-I, DISPLAY-FILE.
025200     GOBACK.
025300
025400
025500******************************************************
025600**                                                  **
025700**   BLOWUP ROUTINE                                 **
025800**                                                  **
025900******************************************************
026000
026100 2-BLOWUP.
026200     MOVE "SPOSINST" TO  BU-PGM-NAME.
           IF FILE-STATUS NUMERIC
               MOVE FILE-STATUS  TO COND-WORD.
026300     CALL "TBLOWUP" USING BASE, BU-PGM-NAME, STATUS-AREA,
026400         VIEW-COMAREA, FILE-STATUS, BU-DISPLAY-MSG,
026500             BU-DISPLAY-FLDS.
026600
029500
029600 4-PGM-ERROR.
           MOVE B"1" TO IND(FIELD-NUMBER), IND(99).
030400
030500 4-PGM-ERROR-X.
030600     EXIT.
032600
032700
032800 64-PROCESS-STD-INST.
032900**** MOVE SPACES                  TO SPOSINST-STD-INST,
033000     MOVE SPACES                  TO SPOSINST-CONFIRMING-FLAG,
033100                                     SPOSINST-CONFIRM-VERBAGE
                                           SPOSINST-RCV-INST.
033900     MOVE "PURORD4"               TO VIEW-NFNAME.
034400
034500     MOVE SPACES                  TO SCREEN-4.
           IF SPOSINST-STD-INST > SPACES
               MOVE SPOSINST-STD-INST   TO DE4-INSTRUCT-LIST
           ELSE
               MOVE SPACES              TO SPOSINST-STD-INST.
034600     MOVE SPOSINST-COMPANY-CODE   TO DE4-COMPANY-CODE.
034700     MOVE PO-NO                   TO DE4-PO.
034800     MOVE PO-REL                  TO DE4-PO-REL.
035100     MOVE 1                       TO TERM-PAGE-CTR.
035500     MOVE SPACES                  TO DB-ADDR-TABLE.
           MOVE 0 TO COND-WORD.
           READ MCOMMENT-I FIRST INTO BUF-MCOMMENT
               AT END MOVE 11 TO COND-WORD.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14"
                   GO TO 64-CHECK-FOR-STD-INST
               ELSE
                   MOVE 99 TO COND-WORD.
036800     IF MCOM-KEY-PREFIX  = "C" OR "R"
037200         MOVE MCOM-COMMENT-NO     TO COMMENT-ADDR (1)
034900         GO TO 64-CHECK-FOR-STD-INST.

035000 64-GET-FIRST-ADDR.
           MOVE 0 TO COND-WORD.
           READ MCOMMENT-I NEXT INTO BUF-MCOMMENT
               AT END MOVE 11 TO COND-WORD.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14"
                   MOVE 11  TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.
035800*A   CALL "DBGET" USING BASE, DSET-MCOMMENT, MODE2,
035900*A       STATUS-AREA, ALL-ITEMS, BUF-MCOMMENT, COMMENT-ARG.
036000     IF COND-WORD NOT = 0
036100         IF COND-WORD = 11
036200             GO TO 64-CHECK-FOR-STD-INST
036300         ELSE
036400             MOVE "GET MCOMMENT * 64-GFA"  TO  BU-DISPLAY-MSG
036500             MOVE COMMENT-ARG              TO  BU-DISPLAY-FLD (2)
036600             GO TO 2-BLOWUP.
036700
036800     IF MCOM-KEY-PREFIX = "C" OR "R"
037200         MOVE MCOM-COMMENT-NO     TO COMMENT-ADDR (1)
037100     ELSE
037000         GO TO 64-GET-FIRST-ADDR.
037300
037400 64-CHECK-FOR-STD-INST.
037500     IF COMMENT-ADDR (1) = SPACES
037600*        "NO P.O. STANDARD INSTRUCTIONS EXIST IN SYSTEM"
037700         MOVE  14                 TO LANG-SETNUM
037800         MOVE   8                 TO LANG-MSGNUM
037900         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
038000         MOVE MESSAGE-BUFFER      TO DE4-INST-FIRST-LINE (1)
038100         GO TO 64-WRITE-MSG-LINE.
038200
038300 64-GET-COMMENT-CALC.
           MOVE 0 TO COND-WORD.
038400     MOVE COMMENT-ADDR (TERM-PAGE-CTR)
               TO MCOMCOMMNT OF MCOMMENT-REC-I.
           READ MCOMMENT-I INTO BUF-MCOMMENT
               INVALID KEY MOVE 17 TO COND-WORD.
           IF FILE-STATUS-1 = "2"
               MOVE 17 TO COND-WORD
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD.
038500*A   CALL "DBGET" USING BASE, DSET-MCOMMENT, MODE4,
038600*A       STATUS-AREA, ALL-ITEMS, BUF-MCOMMENT, CALC-ADDR.
038700     IF COND-WORD NOT = 0
038800         MOVE "GET MCOMMENT * 64-GCC" TO BU-DISPLAY-MSG
039000         GO TO 2-BLOWUP.
039100
039200     MOVE SPACES                  TO DE4-INSTRUCT-INQ.
039300     MOVE 1                       TO INST-SUB.
039400     GO TO 64-FIND-DCOMMENT.
039500
039600********************************************
039700*                                          *
039800*  DO A SERIAL READ OF MCOMMENT TO FIND    *
039900*  ALL COMMENTS SO I CAN PRINT FIRST LINE  *
040000*  OF EACH COMMENT TO THE TERMINAL         *
040100*                                          :
040200********************************************
040300
040400 64-SERIAL-READ-MCOMMENT.
           MOVE 0 TO COND-WORD.
           READ MCOMMENT-I NEXT INTO BUF-MCOMMENT
               AT END MOVE 11 TO COND-WORD.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14"
                   MOVE 11  TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.
040500*A   CALL "DBGET" USING BASE, DSET-MCOMMENT, MODE2,
040600*A       STATUS-AREA, ALL-ITEMS, BUF-MCOMMENT, COMMENT-ARG.
040700     IF COND-WORD NOT = 0
040800         IF COND-WORD = 11
040900             GO TO 64-WRITE-MSG-LINE
041000         ELSE
041100             MOVE "GET MCOMMENT * 64-SRM"  TO  BU-DISPLAY-MSG
041200             MOVE COMMENT-ARG          TO  BU-DISPLAY-FLD (2)
041300             GO TO 2-BLOWUP.
041400
041500     IF MCOM-KEY-PREFIX = "C" OR "R"
               NEXT SENTENCE
           ELSE
041600         GO TO 64-SERIAL-READ-MCOMMENT.
041700
041800     ADD 1                        TO INST-SUB.
041900     IF INST-SUB > 8
042000         ADD 1                    TO TERM-PAGE-CTR
042100         MOVE MCOM-COMMENT-NO     TO COMMENT-ADDR (TERM-PAGE-CTR)
042200         GO TO 64-WRITE-MSG-LINE.
042300
042400 64-FIND-DCOMMENT.
           IF MCOM-KEY-PREFIX = "R"
              MOVE "*"                  TO DE4-INST-TYPE(INST-SUB)
           ELSE
              MOVE " "                  TO DE4-INST-TYPE(INST-SUB).
042500     MOVE MCOM-KEY-NUM            TO DE4-INST-NO (INST-SUB).
042600     MOVE MCOM-COMMENT-NO         TO COMMENT-ARG.
           MOVE 0 TO COND-WORD.
           MOVE COMMENT-ARG TO MCOMCOMMNT OF DCOMMENT-REC-I.
           START DCOMMENT-I KEY = MCOMCOMMNT OF DCOMMENT-REC-I
               INVALID KEY MOVE 0 TO COND-WORD.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
                   MOVE 0 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.
042700*A   CALL "DBFIND" USING BASE, DSET-DCOMMENT, MODE1,
042800*A       STATUS-AREA, COMMENT-SEARCH, COMMENT-ARG.
042900     IF COND-WORD NOT = 0
043000         MOVE "FIND DCOMMENT * 64-FD" TO  BU-DISPLAY-MSG
043100         MOVE COMMENT-ARG             TO  BU-DISPLAY-FLD (2)
043200         GO TO 2-BLOWUP.
           MOVE 0 TO COND-WORD.
           READ DCOMMENT-I NEXT INTO BUF-DCOMMENT
               AT END MOVE 15 TO COND-WORD.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   MOVE 15 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.
           IF MCOMCOMMNT OF DCOMMENT-REC-I NOT = COMMENT-ARG
               MOVE 15 TO COND-WORD.
043300*A   CALL "DBGET" USING BASE, DSET-DCOMMENT, MODE5,
043400*A       STATUS-AREA, ALL-ITEMS, BUF-DCOMMENT, COMMENT-ARG.
043500     IF COND-WORD NOT = 0
043600         IF COND-WORD = 15
043700*            " NO INSTRUCTION ON FILE "
043800             MOVE  14 TO LANG-SETNUM
043900             MOVE  54 TO LANG-MSGNUM
044000             PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
044100             MOVE MESSAGE-BUFFER TO DE4-INST-FIRST-LINE (INST-SUB)
044200             GO TO 64-SERIAL-READ-MCOMMENT
044300         ELSE
044400             MOVE "GET DCOMMENT * 64-FD" TO  BU-DISPLAY-MSG
044500             MOVE COMMENT-ARG            TO  BU-DISPLAY-FLD (2)
044600             GO TO 2-BLOWUP.
044700
044800***************************************
044900*                                     *
045000*  CHECK TO DETERMINE PRINT TYPE OF   *
045100*  EITHER EXPANDED, COMPRESSED, OR    *
045200*  REGULAR PRINT                      *
045300*                                     *
045400***************************************
045500
045600     IF EXP-PRT-START = EXP-PRT-SEQ
045700         MOVE EXP-DATA-COMMENT    TO
045800             DE4-INST-FIRST-LINE (INST-SUB)
045900     ELSE
046000     IF COMP-PRT-START = COMP-PRT-SEQ
046100         MOVE COMP-DATA-COMMENT   TO
046200             DE4-INST-FIRST-LINE (INST-SUB)
046300     ELSE
046400         MOVE DCOM-DATA-LINE      TO
046500             DE4-INST-FIRST-LINE (INST-SUB).
046600
046700     GO TO 64-SERIAL-READ-MCOMMENT.
046800
046900 64-WRITE-MSG-LINE.
047000     MOVE COND-WORD               TO SAVE-COND-WORD.
047100     IF SAVE-COND-WORD = 11  AND  TERM-PAGE-CTR > 1
047200*        "PRESS 'f4' TO SEE PREVIOUS STD. INSTRUCTIONS"
047300         MOVE  16                 TO LANG-SETNUM
047400         MOVE  12                 TO LANG-MSGNUM
047500         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
047600         MOVE MESSAGE-BUFFER      TO DE4-MSG
047700     ELSE
047800     IF INST-SUB > 8  AND  TERM-PAGE-CTR > 2
047900*        "PRESS 'f4' TO SEE PREV STD. INSTRUCTION  'f5' TO "
048000*        "SEE MORE STD. INST"
048100         MOVE  16                 TO LANG-SETNUM
048200         MOVE  13                 TO LANG-MSGNUM
048300         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
048400         MOVE MESSAGE-BUFFER      TO DE4-MSG
048500     ELSE
048600     IF INST-SUB > 8
048700*        "PRESS 'f5' TO SEE MORE STD. INSTRUCTIONS"
048800         MOVE  16                 TO LANG-SETNUM
048900         MOVE  16                 TO LANG-MSGNUM
049000         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
049100         MOVE MESSAGE-BUFFER      TO DE4-MSG
049200     ELSE
049300     IF TERM-PAGE-CTR = 1
049400         MOVE SPACES              TO DE4-MSG
049500     ELSE
049600         MOVE "PAGE PROBLEM INST" TO BU-DISPLAY-MSG
049700         MOVE TERM-PAGE-CTR       TO BU-DISPLAY-FLD (2)
049800         MOVE INST-SUB            TO BU-DISPLAY-FLD9 (1)
049900         GO TO 2-BLOWUP.
050000
051500 64-READ-SCREEN-4.
           MOVE SCREEN-4       TO DISPLAY-REC.
           PERFORM 998-WRITE-SCREEN THRU 998-READ-SCREEN.
           MOVE DISPLAY-REC    TO SCREEN-4.
052200
053600     IF VIEW-LASTKEY = 3
053700         GO TO 64-PSI-X
053800     ELSE
053900     IF VIEW-LASTKEY = 1
054100         MOVE SPACES              TO MESSAGE-BUFFER
054200         MOVE 40                  TO FIELD-NUMBER
054300         MOVE B"1" TO IND(FIELD-NUMBER)
054400         GO TO 64-READ-SCREEN-4
054500     ELSE
054600     IF VIEW-LASTKEY = 2 OR
054700        VIEW-LASTKEY = 6 OR
054800        VIEW-LASTKEY = 7 OR
              VIEW-LASTKEY = 8
055000*        "INVALID FUNCTION KEY ENTERED"
055100         MOVE   9 TO LANG-SETNUM
055200         MOVE  10 TO LANG-MSGNUM
055300         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER TO DE4-MESSAGE-LINE
055400         MOVE 35  TO  FIELD-NUMBER
055500         PERFORM 4-PGM-ERROR  THRU  4-PGM-ERROR-X
055600         GO TO 64-READ-SCREEN-4.
055700
055800     IF SAVE-COND-WORD = 11  AND  TERM-PAGE-CTR > 1
055900         IF VIEW-LASTKEY = 5
056100*            "INVALID FUNCTION KEY ENTERED"
056200             MOVE   9 TO LANG-SETNUM
056300             MOVE  10 TO LANG-MSGNUM
056400             PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE MESSAGE-BUFFER TO DE4-MESSAGE-LINE
056500             MOVE 35  TO  FIELD-NUMBER
056600             PERFORM 4-PGM-ERROR THRU 4-PGM-ERROR-X
056700             GO TO 64-READ-SCREEN-4
056800         ELSE
056900         IF VIEW-LASTKEY = 4
057200             SUBTRACT 1 FROM TERM-PAGE-CTR
057300             GO TO 64-GET-COMMENT-CALC
057400         ELSE
057500             NEXT SENTENCE
057600     ELSE
057700     IF INST-SUB > 8  AND  TERM-PAGE-CTR > 2
057800         IF VIEW-LASTKEY = 5
058100             GO TO 64-GET-COMMENT-CALC
058200         ELSE
058300         IF VIEW-LASTKEY = 4
058600             SUBTRACT 2 FROM TERM-PAGE-CTR
058700             GO TO 64-GET-COMMENT-CALC
058800         ELSE
058900             NEXT SENTENCE
059000     ELSE
059100     IF INST-SUB > 8
059200         IF VIEW-LASTKEY = 5
059500             GO TO 64-GET-COMMENT-CALC
059600         ELSE
059700         IF VIEW-LASTKEY = 4
059900*            "INVALID FUNCTION KEY ENTERED"
060000             MOVE   9 TO LANG-SETNUM
060100             MOVE  10 TO LANG-MSGNUM
060200             PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE MESSAGE-BUFFER TO DE4-MESSAGE-LINE
060300             MOVE 35  TO  FIELD-NUMBER
060400             PERFORM 4-PGM-ERROR THRU 4-PGM-ERROR-X
060500             GO TO 64-READ-SCREEN-4
060600         ELSE
060700             NEXT SENTENCE
060800     ELSE
060900     IF TERM-PAGE-CTR = 1
061000         IF VIEW-LASTKEY = 4 OR 5
061200*            "INVALID FUNCTION KEY ENTERED"
061300             MOVE   9 TO LANG-SETNUM
061400             MOVE  10 TO LANG-MSGNUM
061500             PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE MESSAGE-BUFFER TO DE4-MESSAGE-LINE
061600             MOVE 35  TO  FIELD-NUMBER
061700             PERFORM 4-PGM-ERROR THRU 4-PGM-ERROR-X
061800             GO TO 64-READ-SCREEN-4.
063700
063800 64-EDIT-CONFIRMING-ORDER.
063900     IF DE4-CONFIRMING-VERB  NOT =  SPACES
064000         IF DE4-CONFIRMING-ORDER  =  SPACES
064100*          "ENTER 'X' IN CONFIRMING ORDER TO USE CONFIRMING FREE "
064200*               "VERBAGE"
064300           MOVE   5 TO LANG-SETNUM
064400           MOVE  34 TO LANG-MSGNUM
064500           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                 MOVE MESSAGE-BUFFER TO DE4-MESSAGE-LINE
064600           MOVE 35  TO  FIELD-NUMBER
064700           PERFORM 4-PGM-ERROR  THRU  4-PGM-ERROR-X
064800           GO TO 64-READ-SCREEN-4.
064900
065000     MOVE 0                       TO SUB.
065100
065200***************************************
065300*                                     *
065400*  EDIT COMMENTS FOR VALID COMMENT NO.*
065500*                                     *
065600***************************************
065700
065800 64-EDIT-COMMENT-NO.
065900     ADD 1 TO SUB.
066000     IF SUB  >  12
               MOVE 0 TO SUB.
066100         GO TO 64-EDIT-RCV-COMMENT-NO.
066200
066300     IF DE4-INSTRUCT-NO (SUB) = SPACES
066400         GO TO 64-EDIT-COMMENT-NO.
066500     MOVE DE4-INSTRUCT-NO (SUB)   TO BUILD-COM-NO.
           MOVE "C" TO BUILD-COM-PREFIX.
066600     MOVE BUILD-COMMENT-NO        TO COMMENT-ARG.
           MOVE 0 TO COND-WORD.
           MOVE COMMENT-ARG TO MCOMCOMMNT OF MCOMMENT-REC-I.
           READ MCOMMENT-I INTO BUF-MCOMMENT
               INVALID KEY MOVE 17 TO COND-WORD.
           IF FILE-STATUS-1 = "2"
               MOVE 17 TO COND-WORD
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD.
066700*A   CALL "DBGET" USING BASE, DSET-MCOMMENT, MODE7,
066800*A       STATUS-AREA, ALL-ITEMS, BUF-MCOMMENT, COMMENT-ARG.
066900     IF COND-WORD NOT = 0
067000         IF COND-WORD = 17
067100*            "INSTRUCTION NUMBER DOES NOT EXIST"
067200             MOVE   9 TO LANG-SETNUM
067300             MOVE  60 TO LANG-MSGNUM
067400             PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE MESSAGE-BUFFER TO DE4-MESSAGE-LINE
067500             MOVE SUB  TO  FIELD-NUMBER
067600             IF FIELD-NUMBER > 6
067700                 ADD 33           TO FIELD-NUMBER
067800                 PERFORM 4-PGM-ERROR  THRU  4-PGM-ERROR-X
067900                 GO TO 64-READ-SCREEN-4
068000             ELSE
068100                 PERFORM 4-PGM-ERROR  THRU  4-PGM-ERROR-X
068200                 GO TO 64-READ-SCREEN-4
068300         ELSE
068400             MOVE "GET MCOMMENT * 64-ECN" TO BU-DISPLAY-MSG
068500             MOVE COMMENT-ARG             TO BU-DISPLAY-FLD (2)
068600             GO TO 2-BLOWUP.
068700
068800     GO TO 64-EDIT-COMMENT-NO.
068900
065200*******************************************
065300*                                         *
065400*  EDIT RCV COMMENTS FOR VALID COMMENT NO.*
065500*                                         *
065600*******************************************
065700
065800 64-EDIT-RCV-COMMENT-NO.
065900     ADD 1 TO SUB.
066000     IF SUB  >  12
066100         GO TO 64-SAVE-STD-INST.
066200
066300     IF DE4-RCV-INSTRUCT-NO (SUB) = SPACES
066400         GO TO 64-EDIT-RCV-COMMENT-NO.
066500     MOVE DE4-RCV-INSTRUCT-NO (SUB)   TO BUILD-COM-NO.
           MOVE "R" TO BUILD-COM-PREFIX.
066600     MOVE BUILD-COMMENT-NO        TO COMMENT-ARG.
           MOVE 0 TO COND-WORD.
           MOVE COMMENT-ARG TO MCOMCOMMNT OF MCOMMENT-REC-I.
           READ MCOMMENT-I INTO BUF-MCOMMENT
               INVALID KEY MOVE 17 TO COND-WORD.
           IF FILE-STATUS-1 = "2"
               MOVE 17 TO COND-WORD
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD.
066900     IF COND-WORD NOT = 0
067000         IF COND-WORD = 17
067100*            "INSTRUCTION NUMBER DOES NOT EXIST"
067200             MOVE   9 TO LANG-SETNUM
067300             MOVE  60 TO LANG-MSGNUM
067400             PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE MESSAGE-BUFFER TO DE4-MESSAGE-LINE
067500             MOVE SUB  TO  FIELD-NUMBER
067600             IF FIELD-NUMBER > 6
067700                 ADD 59           TO FIELD-NUMBER
067800                 PERFORM 4-PGM-ERROR  THRU  4-PGM-ERROR-X
067900                 GO TO 64-READ-SCREEN-4
068000             ELSE
068100                 PERFORM 4-PGM-ERROR  THRU  4-PGM-ERROR-X
068200                 GO TO 64-READ-SCREEN-4
068300         ELSE
068400             MOVE "GET MCOMMENT * 64-ERCN" TO BU-DISPLAY-MSG
068500             MOVE COMMENT-ARG             TO BU-DISPLAY-FLD (2)
068600             GO TO 2-BLOWUP.
068700
068800     GO TO 64-EDIT-RCV-COMMENT-NO.
068900
