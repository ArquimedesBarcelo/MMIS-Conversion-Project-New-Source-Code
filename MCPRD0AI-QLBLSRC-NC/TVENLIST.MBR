       IDENTIFICATION DIVISION.
       PROGRAM-ID.     TVENLIST.
       AUTHOR.         BARBARA WINTER.
       INSTALLATION.   GOODYEAR TIRE & RUBBER COMPANY.
       DATE-WRITTEN.   FEBRUARY 1987.
      *REMARKS.        THIS PROGRAM PRINTS A LISTING OF VENDORS SORTED BY
      *                CORPORATE CODE OR BY VENDOR CODE.
      *
       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.
       SOURCE-COMPUTER.    HP-3000.
       OBJECT-COMPUTER.    HP-3000.
       COPY SPECIALN IN COPYCSIS.

       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
            SELECT ONLINE-PRT    ASSIGN TO PRINTER-MCPRT.
            SELECT SORT-FILE ASSIGN TO DISK-SORTFILE.
           SELECT KVENDOR-FILE  ASSIGN TO DATABASE-MCFLCSVEND
             ORGANIZATION IS INDEXED
             ACCESS MODE IS DYNAMIC
             RECORD KEY IS EXTERNALLY-DESCRIBED-KEY WITH DUPLICATES
             FILE STATUS IS FILE-STATUS.
           SELECT KVENDOR-FILE2 ASSIGN TO DATABASE-MCFLCSVEN2
             ORGANIZATION IS INDEXED
             ACCESS MODE IS DYNAMIC
             RECORD KEY IS EXTERNALLY-DESCRIBED-KEY WITH DUPLICATES
             FILE STATUS IS FILE-STATUS.
            SELECT DVENDOR
              ASSIGN TO DATABASE-MCFLCS0701
              ORGANIZATION IS INDEXED
                 ACCESS MODE IS DYNAMIC
              RECORD KEY IS EXTERNALLY-DESCRIBED-KEY WITH DUPLICATES
              FILE STATUS IS FILE-STATUS.
            SELECT MVALIDUM
              ASSIGN TO DATABASE-MCFLCS0401
              ORGANIZATION IS INDEXED
                 ACCESS MODE IS DYNAMIC
              RECORD KEY IS EXTERNALLY-DESCRIBED-KEY WITH DUPLICATES
              FILE STATUS IS FILE-STATUS.

       DATA DIVISION.
       FILE SECTION.
       FD  ONLINE-PRT RECORD CONTAINS 132 CHARACTERS.
       01  PRT-REC                    PIC X(132).

       SD  SORT-FILE RECORD CONTAINS 54 CHARACTERS.
       01  SORT-REC.
            05  SRT-VEN-NAME          PIC X(44).
            05  SRT-VEN-CODE          PIC X(10).

       FD  KVENDOR-FILE.
       01  KVENDOR-RECORD.
           COPY DDS-MCRPCSVEND OF MCFLCSVEND.

       FD  KVENDOR-FILE2.
       01  KVENDOR-RECORD2.
           COPY DDS-MCRPCSVEND OF MCFLCSVEN2.

       FD  DVENDOR
           LABEL RECORDS ARE STANDARD.
       01  DVENDOR-REC.
           COPY DDS-MCRPCS0700  OF MCFLCS0701.

       FD  MVALIDUM
           LABEL RECORDS ARE STANDARD.
       01  MVALIDUM-REC.
           COPY DDS-MCRPCS0400  OF MCFLCS0401.
       WORKING-STORAGE SECTION.
       01  FILE-STATUS.
           05  FILE-STATUS-1          PIC X.
           05  FILE-STATUS-2          PIC X.
       01  LINE-K                     PIC 99    VALUE 60 COMP-4.
       01  PAGE-K                     PIC 9(3)  VALUE 0  COMP-4.
       01  CODE-ARG                   PIC X(10) VALUE SPACES.
       01  UM-ARG                     PIC X(10) VALUE SPACES.
       01  NO-ARG                     PIC X(10) VALUE SPACES.

      *----------  E S C A P E   S E Q U E N C E S
       01  COMPRESS-PRINT             PIC X(8).
       01  NORMAL-PRINT               PIC X(8).
       01  ESC-TEXT-61                PIC X(8).
       01  ESC-TEXT-60                PIC X(8).

       COPY ESCNAM2 IN COPYCSIS.
       COPY TDATECHK IN COPYCSIS.
       COPY THDPRTA  IN COPYCSIS.
       COPY TBLOWUP  IN COPYCSIS.
       COPY OVRPFDATA OF COPYCSIS.
       COPY CCHKOBJ   OF COPYCSIS.
       01  MESSAGE-AREA.
           05  NO-SORTED-RECORDS      PIC X(33) VALUE
                                   "ZERO RECORDS QUALIFIED FOR REPORT".

       01  SWITCH-AREA.
           05  END-OF-INPUT-FILE      PIC X VALUE "N".
               88  ALL-INPUT-RECORDS-PROCESSED       VALUE "Y".
           05  END-OF-SORT-FILE       PIC X VALUE "N".
               88  ALL-SORTED-RECORDS-PROCESSED      VALUE "Y".

       01  FILE-TYPE                  PIC X.
           88  READING-CODES               VALUE "C".

       COPY DATAB     IN COPYCSIS.
       COPY AVENCODE  IN COPYCSIS.
       COPY DVENDOR   IN COPYCSIS.
       COPY MVALIDUM  IN COPYCSIS.
       COPY VCOMAREA  IN COPYCSIS.

       01  HDR-1.
           05  H1-DATE                PIC X(8).
           05  FILLER                 PIC X(5)   VALUE SPACES.
           05  H1-TIME                PIC X(8).
           05  FILLER                 PIC X(31)  VALUE SPACES.
           05  FILLER                 PIC X(27)
               VALUE "V E N D O R   L I S T I N G".
           05  FILLER                 PIC X(42)  VALUE SPACES.
           05  FILLER                 PIC X(5)   VALUE "PAGE".
           05  H1-PAGE-NO             PIC ZZZZ9  VALUE ZEROES.
           05  FILLER                 PIC X      VALUE SPACE.

       01  HDR-2.
           05  FILLER                 PIC X(58)  VALUE SPACES.
           05  FILLER                 PIC X(12)  VALUE "SORTED BY: ".
           05  H2-SORT                PIC X(4).
           05  FILLER                 PIC X(58)  VALUE SPACES.

       01  HDR-3.
           05  FILLER                 PIC X(110) VALUE SPACES.
           05  FILLER                 PIC X(8)   VALUE "PHONE".
           05  FILLER                 PIC X(14)  VALUE SPACES.

       01  HDR-4.
           05  FILLER                 PIC X(2)   VALUE SPACES.
           05  FILLER                 PIC X(6)   VALUE "VENDOR".
           05  FILLER                 PIC X(7)   VALUE SPACES.
           05  FILLER                 PIC X(4)   VALUE "NAME".
           05  FILLER                 PIC X(45)  VALUE SPACES.
           05  FILLER                 PIC X(7)   VALUE "CONTACT".
           05  FILLER                 PIC X(39)  VALUE SPACES.
           05  FILLER                 PIC X(5)   VALUE "TELEX".
           05  FILLER                 PIC X(7)   VALUE SPACES.
           05  FILLER                 PIC X(9)   VALUE "MIN ORDER".

       01  HDR-5.
           05  FILLER                 PIC X(3)   VALUE SPACES.
           05  FILLER                 PIC X(4)   VALUE "CODE".
           05  FILLER                 PIC X(8)   VALUE SPACES.
           05  FILLER                 PIC X(7)   VALUE "ADDRESS".
           05  FILLER                 PIC X(42)  VALUE SPACES.
           05  FILLER                 PIC X(5)   VALUE "NOTE1".
           05  FILLER                 PIC X(41)  VALUE SPACES.
           05  FILLER                 PIC X(8)   VALUE "CURRENCY".
           05  FILLER                 PIC X(14)  VALUE SPACES.

       01  HDR-6.
           05  FILLER                 PIC X(64)  VALUE SPACES.
           05  FILLER                 PIC X(5)   VALUE "NOTE2".
           05  FILLER                 PIC X(41)  VALUE SPACES.
           05  FILLER                 PIC X(8)   VALUE "FAX".
           05  FILLER                 PIC X(14)  VALUE SPACES.

       01  HDR-7.
           05  FILLER                 PIC X(10)  VALUE ALL "=".
           05  FILLER                 PIC X(5)   VALUE SPACES.
           05  FILLER                 PIC X(44)  VALUE ALL "=".
           05  FILLER                 PIC X(5)   VALUE SPACES.
           05  FILLER                 PIC X(41)  VALUE ALL "=".
           05  FILLER                 PIC X(5)   VALUE SPACES.
           05  FILLER                 PIC X(10)  VALUE ALL "=".
           05  FILLER                 PIC X(2)   VALUE SPACES.
           05  FILLER                 PIC X(9)   VALUE ALL "=".

       01  LINE1.
           05  L1-CODE                PIC X(10).
           05  FILLER                 PIC X(5)   VALUE SPACES.
           05  L1-NAME                PIC X(44).
           05  FILLER                 PIC X(5)   VALUE SPACES.
           05  L1-CONTACT             PIC X(44).
           05  FILLER                 PIC X(2)   VALUE SPACES.
           05  L1-PHONE               PIC X(10).
           05  FILLER                 PIC X(4)   VALUE SPACES.
           05  L1-DOLLAR              PIC X      VALUE SPACE.
           05  L1-MINORD              PIC ZZZ9   VALUE ZEROES.
           05  FILLER                 PIC X(3)   VALUE SPACES.

       01  LINE2.
           05  FILLER                 PIC X(15)  VALUE SPACES.
           05  L2-ADDRESS             PIC X(44).
           05  FILLER                 PIC X(5)   VALUE SPACES.
           05  L2-NOTE                PIC X(44).
           05  FILLER                 PIC X(2)   VALUE SPACES.
           05  L2-TELEX               PIC X(10).
           05  FILLER                 PIC X(12)  VALUE SPACES.

       01  LINE3.
           05  FILLER                 PIC X(15)  VALUE SPACES.
           05  L3-ADDRESS             PIC X(44).
           05  FILLER                 PIC X(5)   VALUE SPACES.
           05  L3-NOTE                PIC X(44).
           05  FILLER                 PIC X(2)   VALUE SPACES.
           05  L3-CC                  PIC X(2).
           05  FILLER                 PIC X(2)   VALUE SPACES.
           05  L3-CURRENCY-DESC       PIC X(12).
           05  FILLER                 PIC X(6)   VALUE SPACES.

       01  LINE4.
           05  FILLER                 PIC X(15)  VALUE SPACES.
           05  L4-ADDRESS             PIC X(44).
           05  FILLER                 PIC X(49)  VALUE SPACES.
           05  L4-FAX                 PIC X(24).

       01  LINE5.
           05  FILLER                 PIC X(15)  VALUE SPACES.
           05  L5-ADDRESS             PIC X(44).
           05  FILLER                 PIC X(75)  VALUE SPACES.

       01  LINE6.
           05  FILLER                 PIC X(15)  VALUE SPACES.
           05  L6-ADDRESS             PIC X(44).
           05  FILLER                 PIC X(75)  VALUE SPACES.

       01  LINE7.
           05  FILLER                 PIC X(15)  VALUE SPACES.
           05  L7-ADDRESS             PIC X(44).
           05  FILLER                 PIC X(75)  VALUE SPACES.

       01  LINE8.
           05  FILLER                 PIC X(15)  VALUE SPACES.
           05  L8-ADDRESS             PIC X(44).
           05  FILLER                 PIC X(75)  VALUE SPACES.

       01  LINE9.
           05  FILLER                 PIC X(15)  VALUE SPACES.
           05  L9-ADDRESS             PIC X(44).
           05  FILLER                 PIC X(75)  VALUE SPACES.
       LINKAGE SECTION.
       COPY THDPRTB OF COPYCSIS.
       01  SORT-DATA.
           05  DE-KEY                 PIC X.
           05  DE-LOW-RANGE           PIC X(20).
           05  DE-HIGH-RANGE          PIC X(20).
           05  FILLER                 PIC X(39).

       PROCEDURE DIVISION USING HD-ROUTE-DATA SORT-DATA.
       BEGIN-SORT SECTION.
       00-MAIN.

      *----------  SET UP PRINTER ESCAPE SEQUENCES
           CALL "TESCSEQ" USING ESC-NAME.
           MOVE CHAR-1636PI     TO COMPRESS-PRINT.
           MOVE CHAR-10PI       TO NORMAL-PRINT.
           MOVE TEXT-LENGTH-61 TO ESC-TEXT-61.
           MOVE TEXT-LENGTH-60 TO ESC-TEXT-60.

           OPEN INPUT KVENDOR-FILE KVENDOR-FILE2  DVENDOR MVALIDUM.
           DISPLAY "ROUTE DATA:".
           DISPLAY HD-ROUTE-DATA.
           DISPLAY "SORT-DATA:".
           DISPLAY SORT-DATA.
      *----------  PROCESS REPORT DATA
           IF DE-KEY = "C"
           SORT SORT-FILE
                ON ASCENDING KEY SRT-VEN-CODE
                INPUT  PROCEDURE IS 200-INPUT-RECORDS
                OUTPUT PROCEDURE IS 300-WRITE-RECORDS
           ELSE
           SORT SORT-FILE
                ON ASCENDING KEY SRT-VEN-NAME
                INPUT  PROCEDURE IS 200-INPUT-RECORDS
                OUTPUT PROCEDURE IS 300-WRITE-RECORDS.

      *----------  PRINT REPORT, CLOSE FILES, AND QUIT
           IF PAPER-IS-132-COLS
               NEXT SENTENCE
           ELSE
               WRITE PRT-REC FROM NORMAL-PRINT AFTER ADVANCING 0
               WRITE PRT-REC FROM ESC-TEXT-60 AFTER ADVANCING 0.

           CLOSE ONLINE-PRT.
           CLOSE DVENDOR, KVENDOR-FILE, KVENDOR-FILE2 MVALIDUM.
           GOBACK.

      *************************************************************
      *                    BLOWUP   ROUTINE                       *
      *************************************************************
       2-BLOWUP.
           WRITE PRT-REC FROM ESC-TEXT-61  AFTER ADVANCING 0.
           WRITE PRT-REC FROM NORMAL-PRINT AFTER ADVANCING 0.

           MOVE "TVENLIST" TO BU-PGM-NAME.
           MOVE CODE-ARG TO BU-DISPLAY-FLD (1).
           MOVE SRT-VEN-CODE TO BU-DISPLAY-FLD (2).
           CALL "TBLOWUP" USING BASE, BU-PGM-NAME, STATUS-AREA,
                 VIEW-COMAREA, FILE-STATUS, BU-DISPLAY-MSG,
                 BU-DISPLAY-AREA.
       COPY OVRPFCALL IN COPYCSIS.

      ***********************************************************************
      *       INPUT SECTION:  RETRIEVE VENDOR RECORDS FOR SORTING           *
      ***********************************************************************
       200-INPUT-RECORDS SECTION.
       200-INPUT.
           MOVE 0 TO COND-WORD.
           IF DE-LOW-RANGE = "ALL"
              IF DE-KEY = "C"
                 MOVE LOW-VALUES TO KVENCDE OF KVENDOR-RECORD2
                 MOVE HIGH-VALUES TO DE-HIGH-RANGE
              ELSE
                 MOVE LOW-VALUES TO KVENNAME OF KVENDOR-RECORD
                 MOVE HIGH-VALUES TO DE-HIGH-RANGE
           ELSE
              IF DE-KEY = "C"
                 MOVE DE-LOW-RANGE TO KVENCDE OF KVENDOR-RECORD2
              ELSE
                 MOVE DE-LOW-RANGE TO KVENNAME OF KVENDOR-RECORD.
           IF DE-KEY = "C"
                 PERFORM 202-GET-BY-CODE
           ELSE
                 PERFORM 203-GET-BY-NAME.
           PERFORM 210-PROCESS-INPUT-RECORDS THRU 290-EXIT UNTIL
                   ALL-INPUT-RECORDS-PROCESSED.
           GO TO 299-EXIT.
       202-GET-BY-CODE.
           START KVENDOR-FILE2 KEY >= KVENCDE OF KVENDOR-RECORD2
               INVALID KEY MOVE 17 TO COND-WORD.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
                   MOVE 17 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.
           MOVE "C" TO FILE-TYPE.

       203-GET-BY-NAME.
           START KVENDOR-FILE KEY >= KVENNAME OF KVENDOR-RECORD
               INVALID KEY MOVE 17 TO COND-WORD.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
                   MOVE 17 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.
           MOVE "N" TO FILE-TYPE.

       204-READ-BY-CODE.
           MOVE 0 TO COND-WORD.
           READ KVENDOR-FILE2 NEXT
               AT END MOVE 15 TO COND-WORD.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   MOVE 15 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.

       205-READ-BY-NAME.
           MOVE 0 TO COND-WORD.
           READ KVENDOR-FILE NEXT
               AT END MOVE 15 TO COND-WORD.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   MOVE 15 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.
       210-PROCESS-INPUT-RECORDS.
           MOVE SPACES TO SORT-REC.
           IF READING-CODES
              PERFORM 204-READ-BY-CODE
           ELSE
              PERFORM 205-READ-BY-NAME.
           IF COND-WORD = 15
               MOVE "Y" TO END-OF-INPUT-FILE
               GO TO 290-EXIT
           ELSE
           IF COND-WORD NOT = 0
               MOVE "DBGET AVENDCODE 81" TO BU-DISPLAY-MSG
               PERFORM 2-BLOWUP.

           IF READING-CODES
                    IF KVENCDE OF KVENDOR-FILE2 > DE-HIGH-RANGE
                       MOVE "Y" TO END-OF-INPUT-FILE
                       GO TO 290-EXIT
                    ELSE
                       MOVE KVENCDE OF KVENDOR-FILE2 TO SRT-VEN-CODE
                       MOVE KVENNAME OF KVENDOR-FILE2 TO SRT-VEN-NAME
                       RELEASE SORT-REC
                       GO TO 210-PROCESS-INPUT-RECORDS
            ELSE
               IF DE-LOW-RANGE = "ALL"
                  MOVE KVENCDE OF KVENDOR-FILE  TO SRT-VEN-CODE
                  MOVE KVENNAME OF KVENDOR-FILE  TO SRT-VEN-NAME
                  RELEASE SORT-REC
                  GO TO 210-PROCESS-INPUT-RECORDS
                ELSE
                    IF KVENNAME OF KVENDOR-FILE  > DE-HIGH-RANGE
                       MOVE "Y" TO END-OF-INPUT-FILE
                       GO TO 290-EXIT
                    ELSE
                       MOVE KVENCDE OF KVENDOR-FILE  TO SRT-VEN-CODE
                       MOVE KVENNAME OF KVENDOR-FILE  TO SRT-VEN-NAME
                       RELEASE SORT-REC
                       GO TO 210-PROCESS-INPUT-RECORDS.

           GO TO 210-PROCESS-INPUT-RECORDS.

       219-EXIT.  EXIT.

       290-EXIT.  EXIT.
       299-EXIT.  EXIT.

      ***********************************************************************
      *     OUTPUT SECTION:  WRITE VENDOR RECORDS TO CREATE REPORT          *
      ***********************************************************************
       300-WRITE-RECORDS SECTION.
       300-WR-BEGIN.
      *----------  OPEN OUTPUT FILE
           MOVE HD-SPOOLER-NUMBER TO OVRPRTF-TOFILE-NUM.
           MOVE "*YES"       TO OVRPRTF-SHARED.
           MOVE HD-NO-OF-COPIES TO OVRPRTF-COPIES.
           MOVE "MCPRT"      TO OVRPRTF-FILE.
           PERFORM 996-OVERRIDE-PRINT-FILE.
           OPEN OUTPUT ONLINE-PRT.
      *----------  PRINT HEADER PAGE
           MOVE "DHDR71.PUB" TO HD-FILE-NAME.
           CALL "THDPRT2" USING HD-RET-CODE, HD-FILE-NAME,
              FNUM, HD-ROUTE-DATA, ESC-NAME.
           IF PAPER-IS-132-COLS
                NEXT SENTENCE
           ELSE
           WRITE PRT-REC FROM COMPRESS-PRINT
               AFTER ADVANCING 0
           WRITE PRT-REC FROM ESC-TEXT-61 AFTER ADVANCING 0.
           IF HD-RET-CODE NOT = 0
               DISPLAY "THDRPT ERROR".

      *----------  SET UP HEADING LITERALS FOR REPORT
           MOVE 1 TO DATE-MODE.
           CALL "TDATECHK" USING DATE-CHECK-AREA.
           MOVE DATE-SLASH-OUT                 TO H1-DATE.
           MOVE DATE-FORMATTED-TIME-OUT        TO H1-TIME.
           IF DE-KEY = "C"
              MOVE "CODE"                      TO H2-SORT
           ELSE
              MOVE "NAME"                      TO H2-SORT.

           IF DE-LOW-RANGE = SPACES AND DE-HIGH-RANGE = SPACES
           MOVE "ALL" TO DE-LOW-RANGE.

       300-WRITE.
           RETURN SORT-FILE AT END
               MOVE "Y" TO END-OF-SORT-FILE
               PERFORM 398-PRINT-HEADINGS
               MOVE NO-SORTED-RECORDS TO PRT-REC
               WRITE PRT-REC AFTER ADVANCING 2 LINES
               GO TO 399-EXIT.

           PERFORM 310-PROCESS-SORTED-RECORDS THRU 390-EXIT
                   UNTIL ALL-SORTED-RECORDS-PROCESSED.
           GO TO 399-EXIT.

       310-PROCESS-SORTED-RECORDS.
           IF LINE-K > 50
               PERFORM 398-PRINT-HEADINGS.

           MOVE SPACES TO LINE1, LINE2, LINE3, LINE4,
                          LINE5, LINE6, LINE7, LINE8.

           MOVE SRT-VEN-CODE          TO CODE-ARG.
           MOVE 0 TO COND-WORD.
           MOVE CODE-ARG TO VENCDE OF DVENDOR-REC.
           START DVENDOR KEY = VENCDE OF DVENDOR-REC
               INVALID KEY MOVE 17 TO COND-WORD.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
                   MOVE 17 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.
           IF NOT GOOD-CALL
              GO TO 325-READ-FILE.

       315-GET-VENDOR-DATA.
           MOVE 0 TO COND-WORD.
           READ DVENDOR NEXT INTO BUF-DVENDOR
               AT END MOVE 15 TO COND-WORD.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   MOVE 15 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.
           IF VENCDE OF DVENDOR-REC NOT = CODE-ARG
               MOVE 15 TO COND-WORD.
           IF END-OF-CHAIN
              GO TO 320-PRINT-LINES
           ELSE
              IF NOT GOOD-CALL
                 MOVE "DBGET DVENDOR AT 92 TVENLIST" TO BU-DISPLAY-MSG
                 PERFORM 2-BLOWUP.

               IF VEN-ITM-NO  = "00"
                   MOVE VEN-ITM-DATA     TO L1-NAME
                   MOVE VEN-VEN-CODE     TO L1-CODE
               ELSE
               IF VEN-ITM-NO  = "01"
                   MOVE VEN-ITM-DATA     TO L2-ADDRESS
               ELSE
               IF VEN-ITM-NO  = "02"
                   MOVE VEN-ITM-DATA     TO L3-ADDRESS
               ELSE
               IF VEN-ITM-NO  = "03"
                   MOVE VEN-ITM-DATA     TO L4-ADDRESS
               ELSE
               IF VEN-ITM-NO  = "04"
                   MOVE VEN-ITM-DATA     TO L5-ADDRESS
               ELSE
               IF VEN-ITM-NO  = "05"
                   MOVE VEN-ITM-DATA     TO L6-ADDRESS
               ELSE
               IF VEN-ITM-NO  = "06"
                   MOVE VEN-ITM-DATA     TO L7-ADDRESS
               ELSE
               IF VEN-ITM-NO  = "07"
                   MOVE VEN-ITM-DATA     TO L8-ADDRESS
               ELSE
               IF VEN-ITM-NO  = "08"
                   MOVE VEN-COUNTRY      TO L9-ADDRESS
               ELSE
               IF VEN-ITM-NO = "09"
                   MOVE VEN-CONTACT      TO L1-CONTACT
                   MOVE VEN-CONTACT-PHONE TO L1-PHONE
               ELSE
               IF VEN-ITM-NO = "10"
                   MOVE VEN-MIN-ORDER    TO L1-MINORD
                   MOVE "$"              TO L1-DOLLAR
                   MOVE VEN-TELEX        TO L2-TELEX
                   MOVE VEN-FAX          TO L4-FAX
                   MOVE VEN-CC           TO L3-CC
                   PERFORM 391-GET-CC-DESC THRU 391-EXIT
               ELSE
               IF VEN-ITM-NO = "12"
                   MOVE VEN-FREE-NOTE-1  TO L2-NOTE
               ELSE
               IF VEN-ITM-NO = "13"
                   MOVE VEN-FREE-NOTE-2  TO L3-NOTE.

           GO TO 315-GET-VENDOR-DATA.

       320-PRINT-LINES.
           ADD      2        TO LINE-K.
           MOVE SPACES       TO PRT-REC.
           WRITE PRT-REC FROM LINE1 AFTER ADVANCING 2 LINES.

           IF LINE2 NOT = SPACES
               ADD     1         TO LINE-K
               MOVE SPACES       TO PRT-REC
               WRITE PRT-REC FROM LINE2 AFTER ADVANCING 1 LINE.

           IF LINE3 NOT = SPACES
               ADD      1        TO LINE-K
               MOVE SPACES       TO PRT-REC
               WRITE PRT-REC FROM LINE3 AFTER ADVANCING 1 LINES.

           IF LINE4 NOT = SPACES
               ADD      1        TO LINE-K
               MOVE SPACES       TO PRT-REC
               WRITE PRT-REC FROM LINE4 AFTER ADVANCING 1 LINES.

           IF LINE5 NOT = SPACES
               ADD      1        TO LINE-K
               MOVE SPACES       TO PRT-REC
               WRITE PRT-REC FROM LINE5 AFTER ADVANCING 1 LINES.

           IF LINE6 NOT = SPACES
               ADD      1        TO LINE-K
               MOVE SPACES       TO PRT-REC
               WRITE PRT-REC FROM LINE6 AFTER ADVANCING 1 LINES.

           IF LINE7 NOT = SPACES
               ADD      1        TO LINE-K
               MOVE SPACES       TO PRT-REC
               WRITE PRT-REC FROM LINE7 AFTER ADVANCING 1 LINES.

           IF LINE8 NOT = SPACES
               ADD      1        TO LINE-K
               MOVE SPACES       TO PRT-REC
               WRITE PRT-REC FROM LINE8 AFTER ADVANCING 1 LINES.

           IF LINE9 NOT = SPACES
               ADD      1        TO LINE-K
               MOVE SPACES       TO PRT-REC
               WRITE PRT-REC FROM LINE9 AFTER ADVANCING 1 LINES.

       325-READ-FILE.
           RETURN SORT-FILE AT END
               MOVE "Y"                           TO END-OF-SORT-FILE.

       390-EXIT.  EXIT.

       391-GET-CC-DESC.
           IF VEN-CC = SPACES
              MOVE SPACES TO L3-CURRENCY-DESC
              GO TO 391-EXIT.

           MOVE VEN-CC TO UM-ARG.
           MOVE 0 TO COND-WORD.
           MOVE UM-ARG TO VALIDUM OF MVALIDUM-REC.
           READ MVALIDUM INTO BUF-MVALIDUM
               INVALID KEY MOVE 17 TO COND-WORD.
           IF FILE-STATUS-1 = "2"
               MOVE 17 TO COND-WORD
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD.
           IF COND-WORD NOT = 0
              MOVE "????????????" TO L3-CURRENCY-DESC
           ELSE
              MOVE VALID-CURRENCY-DESC TO L3-CURRENCY-DESC.
       391-EXIT.  EXIT.

       398-PRINT-HEADINGS.
           ADD 1 TO PAGE-K.
           MOVE PAGE-K TO H1-PAGE-NO.
           WRITE PRT-REC FROM HDR-1 AFTER ADVANCING NEW-PAGE.
           WRITE PRT-REC FROM HDR-2 AFTER ADVANCING 1 LINE.
           WRITE PRT-REC FROM HDR-3 AFTER ADVANCING 3 LINES.
           WRITE PRT-REC FROM HDR-4 AFTER ADVANCING 1 LINE.
           WRITE PRT-REC FROM HDR-5 AFTER ADVANCING 1 LINE.
           WRITE PRT-REC FROM HDR-6 AFTER ADVANCING 1 LINE.
           WRITE PRT-REC FROM HDR-7 AFTER ADVANCING 1 LINE.
           MOVE 10 TO LINE-K.

       399-EXIT.  EXIT.
