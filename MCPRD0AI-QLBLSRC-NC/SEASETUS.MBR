012900
013000 01  DE-FIELDS.
013100     05  DE-EMPL                   PIC X(4).
           05  DE-USERID                 PIC X(8).
013200     05  DE-LEVEL                  PIC X(2).
013300     05  DE-ACTIVE-FLAG            PIC X(1).
013400     05  DE-CRT-RQ-FLAG            PIC X(1).
013500     05  DE-APP-RQ-FLAG            PIC X(1).
013600     05  DE-FORWARD-CAP            PIC X(1).
013700     05  DE-MODIFY-CAP             PIC X(1).
013800     05  DE-RETURN-CAP             PIC X(1).
           05  DE-EXPLODE-CAP            PIC X(1).
           05  DE-INQUIRE-CAP            PIC X(1).
           05  DE-DISPLAY-DOLS           PIC X(1).
           05  DE-COMMAND-LINE           PIC X(78).
           05  DE-MESSAGE-LINE           PIC X(78).
013900
014000**************************************************************
014100**                                                          **
014200**            L I N K A G E   S E C T I O N                 **
014300**                                                          **
014400**************************************************************
014500
014600 LINKAGE SECTION.
014700 01  BASE                      PIC X(10).
014800 01  MMIS-BASE                 PIC X(13).
014900
015000 COPY VCOMLINK   IN COPYLIB.
015100 COPY TSHWSUB2   IN COPYLIB.
015200 COPY LANGSUB    IN COPYLIB.
015300
015400 PROCEDURE DIVISION USING BASE
015500                          MMIS-BASE,
015600                          VIEW-COMAREA,
015700                          SRF-COMAREA,
015800                          LANGUAGE-PARMS.
015900
016000 1-HSK.
           MOVE 0 TO SUB.
           OPEN I-O DISPLAY-FILE, MEMPL-O, DLEVEL-O.
           OPEN INPUT MLEVEL-I, DREQQUE-I, PER-PERSONNEL-I.
016100     PERFORM 6000-MAIN THRU 6990-MAIN-X.
           CLOSE DISPLAY-FILE, MEMPL-O, DLEVEL-O, DREQQUE-I,
             PER-PERSONNEL-I, MLEVEL-I.
016200     GOBACK.
016300
016400 2100-BLOWUP.
016500     MOVE "SEASETUS"               TO   BU-PGM-NAME.
016600     CALL "TBLOWUP" USING BASE BU-PGM-NAME STATUS-AREA
016700       VIEW-COMAREA FILE-STATUS BU-DISPLAY-MSG
016800       BU-DISPLAY-FLDS.
016900
019000 4015-SET-ERROR.
           MOVE B"1" TO IND (99).
           MOVE B"1" TO IND (FIELD-NUMBER).
           MOVE MESSAGE-BUFFER TO DE-MESSAGE-LINE.
051300
019700 4020-CLEAR-FORM.
019800     MOVE SPACES TO MESSAGE-BUFFER.
021000     MOVE SPACES                   TO   DE-FIELDS.
           MOVE "00" TO DE-LEVEL.
021200
022000******************************************************************
022100**                                                              **
022200**          L E V E L   M A I N   M E N U                       **
022300**                                                              **
022400******************************************************************
022500 6000-MAIN.
022600     MOVE "EAUSERMENU"             TO   VIEW-NFNAME.
022800     PERFORM 4020-CLEAR-FORM.
022900
023000*----- f1,f2,f3,f4,f8 APPL,f5 PRT SCR,f6,f7 INVALID,ENTER INVALID
023100     MOVE 0                        TO   SRF-KEYSET.
023200     MOVE "I"                      TO   SRF-FKEY (6),
023300                                        SRF-FKEY (7).
023400     MOVE "P"                      TO   SRF-FKEY (5).
023500     MOVE "N"                      TO   SRF-ENTER-FLAG.
       6010-SHOWFORM.
           MOVE DE-FIELDS TO DISPLAY-REC.
           PERFORM 998-WRITE-SCREEN THRU 998-READ-SCREEN.
           MOVE DISPLAY-REC TO DE-FIELDS.

024200     IF VIEW-LASTKEY = 3
024300         GO TO 6990-MAIN-X.
024400
024500     IF VIEW-LASTKEY = 1
024600         MOVE "A"                  TO   MOD-DEL-FLAG
024700         PERFORM 6300-ADD THRU 6390-A-X
024800     ELSE
024900     IF VIEW-LASTKEY = 2
025000         MOVE "M"                  TO   MOD-DEL-FLAG
025100         PERFORM 6500-MOD-DEL THRU 6590-MD-X
025600     ELSE
025700     IF VIEW-LASTKEY = 4
025800         PERFORM 6600-USER-INQUIRY THRU 6690-UI-X
025200     ELSE
025300     IF VIEW-LASTKEY = 8
025400         MOVE "D"                  TO   MOD-DEL-FLAG
025500         PERFORM 6500-MOD-DEL THRU 6590-MD-X.
025900
026000     GO TO 6000-MAIN.
026100
026200******************************************************************
026300**                                                              **
026400**       A D D   A U T H O R I Z A T I O N                      **
026500**                                                              **
026600******************************************************************
026700 6300-ADD.
026800     MOVE SPACES                   TO   OLD-ACTIVE,
026900                                        OLD-LEVEL.
027000     MOVE "EAUSERADD"              TO   VIEW-NFNAME.
027200     PERFORM 4020-CLEAR-FORM.
027300
027400 6310-SHOW-ADD-FORM.
027500     MOVE 7                        TO   SRF-KEYSET.
       6310-SHOWFORM.
           MOVE DE-FIELDS TO DISPLAY-REC.
           PERFORM 998-WRITE-SCREEN THRU 998-READ-SCREEN.
           MOVE DISPLAY-REC TO DE-FIELDS.

028200     IF VIEW-LASTKEY = 3
028300         GO TO 6390-A-X.
028400
028700     PERFORM 7000-GET-EMPLOYEE.
028800     IF GOOD-CALL
               PERFORM 7010-UNLOCK-MEMPL
028900*        "E44: ENTRY ALREADY EXISTS"
029000         MOVE   5                  TO   LANG-SETNUM
029100         MOVE  44                  TO   LANG-MSGNUM
029200         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
029300         MOVE 1                    TO   FIELD-NUMBER
029400         PERFORM 4015-SET-ERROR
029500         GO TO 6310-SHOW-ADD-FORM.
029600
029700     PERFORM 7100-GET-EMPLOYEE-MMIS.
029800     IF NOT GOOD-CALL
029900*        "E46: EMPLOYEE ID NOT VALIDD IN MMIS PERSONNEL SYSTEM"
030000         MOVE   5                  TO   LANG-SETNUM
030100         MOVE  46                  TO   LANG-MSGNUM
030200         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
030300         MOVE 1                    TO   FIELD-NUMBER
030400         PERFORM 4015-SET-ERROR
030500         GO TO 6310-SHOW-ADD-FORM.
030600
030700     MOVE SPACES                   TO   MSG-TEXT.
030800     PERFORM 7400-EDITS THRU 7490-E-X.
030900     IF MSG-TEXT NOT = SPACES
031000         GO TO 6310-SHOW-ADD-FORM.
031100
031200     PERFORM 7030-MOVE-TO-DB.
031300
031700*    CALL "DBPUT" USING BASE, DSET-MEMPL, MODE1, STATUS-AREA,
031800*      ALL-ITEMS, BUF-MEMPL.
           WRITE MEMPL-REC-O FROM BUF-MEMPL
               INVALID KEY MOVE 99 TO COND-WORD.
           IF FILE-STATUS NOT = "00"
032000         MOVE "DBPUT ERR MEMPL 6110-SAF" TO BU-DISPLAY-MSG
032100         PERFORM 2100-BLOWUP.
032200
032300*------- NOW ADD THE EMPLOYEE AS A MEMBER OF HIS LEVEL.
032400     PERFORM 7600-ADD-DLEVEL.
032500
032800     PERFORM 8000-UPDATE-EMPL-LEVELS.
032900
033000     PERFORM 4020-CLEAR-FORM.
033100     GO TO 6310-SHOW-ADD-FORM.
033200
033300 6390-A-X.
033400     EXIT.
033500
033600******************************************************************
033700**                                                              **
033800**      M O D I F Y / D E L E T E   A U T H O R I Z A T I O N   **
033900**                                                              **
034000******************************************************************
034100 6500-MOD-DEL.
034200*------- GET THE FATHER FORM FOR MODIFY OR DELETE
034300     IF MOD-DEL-FLAG = "M"
034400         MOVE "EAUSERMOD"          TO   VIEW-NFNAME
034500     ELSE
034600         MOVE "EAUSERDEL"          TO   VIEW-NFNAME.
034800
034900 6505-MOD-DEL-GETFORM-1.
035000*------- GET SON FORM FOR LEVEL NUMBER TO MODIFY ENTRY
035100     IF MOD-DEL-FLAG = "M"
035200         MOVE "EAUSERMOD1"         TO   VIEW-NFNAME
035300     ELSE
035400         MOVE "EAUSERDEL1"         TO   VIEW-NFNAME.
035600     PERFORM 4020-CLEAR-FORM.
035700
035800 6510-SHOW-MOD-FORM-1.
035900     MOVE 7                        TO   SRF-KEYSET.
       6510-SHOWFORM.
           MOVE DE-FIELDS TO DISPLAY-REC.
           PERFORM 998-WRITE-SCREEN THRU 998-READ-SCREEN.
           MOVE DISPLAY-REC TO DE-FIELDS.

036600     IF VIEW-LASTKEY = 3
036700         GO TO 6590-MD-X.
036800
037100     PERFORM 7000-GET-EMPLOYEE.
037200     IF NO-ENTRY
037300*        "E45: ENTRY DOES NOT EXIST"
037400         MOVE  5                   TO   LANG-SETNUM
037500         MOVE 45                   TO   LANG-MSGNUM
037600         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
037700         MOVE 1                    TO   FIELD-NUMBER
037800         PERFORM 4015-SET-ERROR
037900         GO TO 6510-SHOW-MOD-FORM-1.
038000
038100*------  CAN'T DELETE AN EMPL IF ANY REQS ARE QUEUED UP
038200*------  TO BE APPROVED FOR THAT EMPLOYEE ID
038300*    CALL "DBFIND" USING BASE, DSET-DREQQUE, MODE1,
038400*      STATUS-AREA, EMPL-SEARCH, EMPL-ARG.
           MOVE EMPL-ARG TO EMPLOYID OF DREQQUE-REC-I.
           START DREQQUE-I KEY = EMPLOYID OF DREQQUE-REC-I
               INVALID KEY MOVE 17 TO COND-WORD.
           IF (FILE-STATUS NOT = "00") AND (FILE-STATUS-1 NOT = "2")
038600         MOVE "DBFIND ERR DREQQUE 6530-SMF2" TO BU-DISPLAY-MSG
038700         PERFORM 2100-BLOWUP.
038800
038900     IF MOD-DEL-FLAG = "D"
039000       IF FILE-STATUS = "00"
039100*        "E49: EMPLOYEE HAS QUEUED UP REQS: CANNOT BE DELETED"
039200         MOVE   5 TO LANG-SETNUM
039300         MOVE  49 TO LANG-MSGNUM
039400         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
039500         MOVE 1                    TO   FIELD-NUMBER
039600         PERFORM 4015-SET-ERROR
039700         GO TO 6510-SHOW-MOD-FORM-1.
039800
039900     IF MOD-DEL-FLAG = "M"
040000         MOVE "EAUSERMOD2"         TO   VIEW-NFNAME
040100     ELSE
040200         MOVE "EAUSERDEL2"         TO   VIEW-NFNAME.
040400
040500     MOVE MEMPL-EMPL               TO   DE-EMPL.
           MOVE MEMPL-USERID             TO   DE-USERID.
040600     MOVE MEMPL-LEVEL              TO   DE-LEVEL.
040700     MOVE MEMPL-ACTIVE-FLAG        TO   DE-ACTIVE-FLAG.
040800     MOVE MEMPL-CRT-RQ-FLAG        TO   DE-CRT-RQ-FLAG.
040900     MOVE MEMPL-APP-RQ-FLAG        TO   DE-APP-RQ-FLAG.
041000     MOVE MEMPL-FORWARD-CAP        TO   DE-FORWARD-CAP.
041100     MOVE MEMPL-MODIFY-CAP         TO   DE-MODIFY-CAP.
041200     MOVE MEMPL-RETURN-CAP         TO   DE-RETURN-CAP.
           MOVE MEMPL-EXPLODE-CAP        TO   DE-EXPLODE-CAP.
           MOVE MEMPL-INQUIRE-CAP        TO   DE-INQUIRE-CAP.
           MOVE MEMPL-DISPLAY-DOLS       TO   DE-DISPLAY-DOLS.
041300
041400*------ SET UP TO TELL IF LEVELS OR ACTIVE STATE CHANGED:
041500*------ SO THAT OLD LEVELS CAN BE UPDATED IN MPATH AND MLEVEL
041600     MOVE MEMPL-LEVEL              TO   OLD-LEVEL.
041700     MOVE MEMPL-ACTIVE-FLAG        TO   OLD-ACTIVE.
041800
042700 6530-SHOW-MOD-FORM-2.
042800*----- f1 f2 f3 f6 INVALID, f4 REFRESH, f5 PRT, f7 CLR, f8 EXIT
042900     MOVE 7                        TO   SRF-KEYSET.
           PERFORM 7010-UNLOCK-MEMPL.
       6535-SHOWFORM.
           MOVE DE-FIELDS TO DISPLAY-REC.
           PERFORM 998-WRITE-SCREEN THRU 998-READ-SCREEN.
           MOVE DISPLAY-REC TO DE-FIELDS.

043600     IF VIEW-LASTKEY = 3
043700         PERFORM 4020-CLEAR-FORM
043800         GO TO 6505-MOD-DEL-GETFORM-1.
043900
044200     MOVE SPACES                   TO   MSG-TEXT.
044300     PERFORM 7400-EDITS THRU 7490-E-X.
044400     IF MSG-TEXT NOT = SPACES
044500         GO TO 6530-SHOW-MOD-FORM-2.
044600
           PERFORM 7000-GET-EMPLOYEE.
045400     PERFORM 7030-MOVE-TO-DB.
045500
045600     IF MOD-DEL-FLAG = "M"
045700*        CALL "DBUPDATE" USING BASE, DSET-MEMPL, MODE1,
045800*          STATUS-AREA, ALL-ITEMS, BUF-MEMPL
               REWRITE MEMPL-REC-O FROM BUF-MEMPL
                   INVALID KEY MOVE 99 TO COND-WORD
               END-REWRITE
               IF FILE-STATUS NOT = "00"
046000             MOVE "DBUPDATE ERR 6530-SFM2" TO BU-DISPLAY-MSG
046100             PERFORM 2100-BLOWUP
046200         ELSE
046300             NEXT SENTENCE
046400     ELSE
046500         PERFORM 7650-DELETE-DLEVEL THRU 7690-DD-X
046600*        CALL "DBDELETE" USING BASE, DSET-MEMPL, MODE1,
046700*          STATUS-AREA
               DELETE MEMPL-O INVALID KEY MOVE "2" TO FILE-STATUS-1
               END-DELETE
               IF FILE-STATUS NOT = "00"
046900             MOVE "DBDELETE ERR 6530-SFM2" TO BU-DISPLAY-MSG
047000             PERFORM 2100-BLOWUP.
047100
047200*------ FOR MODIFY, WE DELETE AND RE-ADD THE DLEVEL SEGMENT.
047300*------ FOR DELETE, WE JUST DELETE IT.
047400     IF MOD-DEL-FLAG = "M"
047500         PERFORM 7650-DELETE-DLEVEL THRU 7690-DD-X
047600         PERFORM 7600-ADD-DLEVEL.
047700
048000*------ IF DELETING, WE WANT TO TAKE THE EMPL OUT OF THE MPATH
048100*------ AND MLEVEL ENTRIES, SO WE FLAG IT AS GOING TO 'NOT ACTIVE
048200*------ AND FORCE A LEVEL CHANGE SO HIS OLD LEVELS WILL BE
048300*------ DELETED.
048400     IF MOD-DEL-FLAG = "D"
048500         MOVE "N"                  TO   DE-ACTIVE-FLAG
048600         MOVE "ZZ"                 TO   DE-LEVEL.
048700
048800     PERFORM 8000-UPDATE-EMPL-LEVELS.
048900
049000     GO TO 6505-MOD-DEL-GETFORM-1.
049100
049200 6590-MD-X.
049300     EXIT.
049400
049500 6600-USER-INQUIRY.
049600     MOVE "FCSISINQ"               TO   CSF-NEW-FORMFILE-NAME.
049700     MOVE "N"                      TO   CSF-MODE.
049800     PERFORM 7150-CALL-CSWITCHF.
049900     IF CSF-OPENFORM-ERR-SW = "Y"
050000         GO TO 6690-UI-X.
050100
050200     CALL "SEAUSEIQ" USING BASE, MMIS-BASE, VIEW-COMAREA,
050300       SRF-COMAREA, LANGUAGE-PARMS, EAUSE-PARMS.
050400
050500     MOVE "O"                      TO   CSF-MODE.
050600     PERFORM 7150-CALL-CSWITCHF.
050700
050800 6690-UI-X.
050900     EXIT.
051000
051100
051200 6990-MAIN-X.
051300     EXIT.
051400
051500******************************************************************
051600**                                                              **
051700**      P E R F O R M E D   R O U T I N E S                     **
051800**                                                              **
051900******************************************************************
052000 7000-GET-EMPLOYEE.
052100     MOVE DE-EMPL           TO   EMPL-ARG.
052200*    CALL "DBGET" USING BASE, DSET-MEMPL, MODE7, STATUS-AREA,
052300*      ALL-ITEMS, BUF-MEMPL, EMPL-ARG.
           MOVE 0 TO COND-WORD.
           MOVE EMPL-ARG TO EMPLOYID OF MEMPL-REC-O.
           READ MEMPL-O INTO BUF-MEMPL
               INVALID KEY MOVE 17 TO COND-WORD.
           IF FILE-STATUS-1 = "2"
               MOVE 17 TO COND-WORD
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD.
052400     IF COND-WORD = 0 OR 17
052500         NEXT SENTENCE
052600     ELSE
052700         MOVE "DBGET ERR 7000-GM" TO BU-DISPLAY-MSG
052800         PERFORM 2100-BLOWUP.
052900
       7010-UNLOCK-MEMPL.
      *------- DO A START > HIGH-VALUES TO UNLOCK
           MOVE HIGH-VALUES TO EMPLOYID OF MEMPL-REC-O.
           START MEMPL-O KEY > EMPLOYID OF MEMPL-REC-O
               INVALID KEY MOVE "00" TO FILE-STATUS.

054500 7030-MOVE-TO-DB.
054600     IF MOD-DEL-FLAG = "A"
054700         MOVE SPACES               TO   BUF-MEMPL.
054800     MOVE DE-EMPL                  TO   MEMPL-EMPL.
           MOVE DE-USERID                TO   MEMPL-USERID.
054900     MOVE DE-LEVEL                 TO   MEMPL-LEVEL.
055000     MOVE DE-ACTIVE-FLAG           TO   MEMPL-ACTIVE-FLAG.
055100     MOVE "N"                      TO   MEMPL-INVOICE-FLAG.
055200     MOVE DE-CRT-RQ-FLAG           TO   MEMPL-CRT-RQ-FLAG.
055300     MOVE DE-APP-RQ-FLAG           TO   MEMPL-APP-RQ-FLAG.
055400     MOVE DE-FORWARD-CAP           TO   MEMPL-FORWARD-CAP.
055500     MOVE DE-MODIFY-CAP            TO   MEMPL-MODIFY-CAP.
055600     MOVE DE-RETURN-CAP            TO   MEMPL-RETURN-CAP.
           MOVE DE-EXPLODE-CAP           TO   MEMPL-EXPLODE-CAP.
           MOVE DE-INQUIRE-CAP           TO   MEMPL-INQUIRE-CAP.
           MOVE DE-DISPLAY-DOLS          TO   MEMPL-DISPLAY-DOLS.
055700
057800 7070-GET-MLEVEL.
057900*    CALL "DBGET" USING BASE, DSET-MLEVEL, MODE7,
058000*      STATUS-AREA, ALL-ITEMS, BUF-MLEVEL, LEVEL-ARG.
           MOVE 0 TO COND-WORD.
           MOVE LEVEL-ARG TO LEVELNUM OF MLEVEL-REC-I.
           READ MLEVEL-I INTO BUF-MLEVEL
               INVALID KEY MOVE 17 TO COND-WORD.
           IF FILE-STATUS-1 = "2"
               MOVE 17 TO COND-WORD
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD.
058100     IF NO-ENTRY
058200         NEXT SENTENCE
058300     ELSE
058400     IF NOT GOOD-CALL
058500         MOVE "DBGET ERR MLEVEL 7070-GM" TO BU-DISPLAY-MSG
058600         PERFORM 2100-BLOWUP.
058700
058800 7100-GET-EMPLOYEE-MMIS.
058900     MOVE DE-EMPL           TO   EMPL-ARG.
059000*    CALL "DBGET" USING MMIS-BASE, DSET-PER-PERSONNEL, MODE7,
059100*      STATUS-AREA, ALL-ITEMS, BUF-PER-PERSONNEL, EMPL-ARG.
           MOVE 0 TO COND-WORD.
           MOVE EMPL-ARG TO PERCCNUM OF PER-PERSONNEL-REC-I.
           READ PER-PERSONNEL-I INTO BUF-PER-PERSONNEL
               INVALID KEY MOVE 17 TO COND-WORD.
           IF FILE-STATUS-1 = "2"
               MOVE 17 TO COND-WORD
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD.
059200     IF GOOD-CALL OR NO-ENTRY
059300         NEXT SENTENCE
059400     ELSE
059500         MOVE "DBGET ERR PERSONNEL 7100-GEM" TO BU-DISPLAY-MSG
059600         PERFORM 2100-BLOWUP.
059700
059800 7150-CALL-CSWITCHF.
059900     CALL "CSWITCHF" USING VIEW-COMAREA, LANGUAGE-PARMS,
060000       FORMFILE, CSF-PARMS, BU-DISPLAY-MSG.
060100     IF BU-DISPLAY-MSG-1 NOT = SPACES
060200         PERFORM 2100-BLOWUP.
060300
060400 7400-EDITS.
060500*------- FIRST MAKE SURE ENTERED LEVEL EXISTS
060600     MOVE DE-LEVEL                 TO   LEVEL-ARG.
           PERFORM 7070-GET-MLEVEL.
060900     IF NO-ENTRY
061000*        "E45: ENTRY DOES NOT EXIST"
061100         MOVE  5                   TO   LANG-SETNUM
061200         MOVE 45                   TO   LANG-MSGNUM
061300         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
061400         MOVE 3                    TO   FIELD-NUMBER
061500         PERFORM 4015-SET-ERROR
061600         GO TO 7490-E-X.
061700
061800     IF MLEVEL-ACTIVE-EMPL > "/"  AND DE-ACTIVE-FLAG = "Y"
061900         IF DE-EMPL NOT = MLEVEL-ACTIVE-EMPL
062000*            "A34: ACTIVE EMPLOYEE ALREADY EXISTS AT THIS LEVEL"
062100             MOVE   1 TO LANG-SETNUM
062200             MOVE  34 TO LANG-MSGNUM
062300             PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
062400             MOVE 3                TO   FIELD-NUMBER
062500             PERFORM 4015-SET-ERROR
062600             GO TO 7490-E-X.
062700
062800 7490-E-X.
062900     EXIT.
063000
063100
063200 7600-ADD-DLEVEL.
063300*------- NOW ADD THE EMPLOYEE AS A MEMBER OF HIS LEVEL.
063400     MOVE DE-EMPL                  TO   DLEVEL-EMPL.
063500     MOVE DE-LEVEL                 TO   DLEVEL-LEVEL-NUM.
063600*    CALL "DBPUT" USING BASE, DSET-DLEVEL, MODE1, STATUS-AREA,
063700*      ALL-ITEMS, BUF-DLEVEL.
           WRITE DLEVEL-REC-O FROM BUF-DLEVEL
               INVALID KEY MOVE 99 TO COND-WORD.
           IF FILE-STATUS NOT = "00"
063900         MOVE "DBPUT ERR DLEVEL 6310-SAF" TO BU-DISPLAY-MSG
064000         PERFORM 2100-BLOWUP.
064100
064200 7650-DELETE-DLEVEL.
064300*    CALL "DBFIND" USING BASE, DSET-DLEVEL, MODE1, STATUS-AREA,
064400*      EMPL-SEARCH, EMPL-ARG.
           MOVE EMPL-ARG TO EMPLOYID OF DLEVEL-REC-O.
           START DLEVEL-O KEY = EMPLOYID OF DLEVEL-REC-O
               INVALID KEY MOVE 0 TO COND-WORD.
           IF FILE-STATUS-1 = "2"
               GO TO 7690-DD-X
           ELSE
064800     IF FILE-STATUS NOT = "00"
064900         MOVE "DBFIND ERR DLEVEL 7650-DD" TO BU-DISPLAY-MSG
065000         PERFORM 2100-BLOWUP.
065100
065200 7660-DELETE-DLEVEL-LOOP.
065300*    CALL "DBGET" USING BASE, DSET-DLEVEL, MODE5, STATUS-AREA,
065400*      ALL-ITEMS, BUF-DLEVEL, EMPL-ARG.
           MOVE 0 TO COND-WORD.
           READ DLEVEL-O NEXT INTO BUF-DLEVEL
               AT END MOVE 15 TO COND-WORD.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   MOVE 15 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.
           IF EMPLOYID OF DLEVEL-REC-O NOT = EMPL-ARG
               MOVE 15 TO COND-WORD.
065500     IF END-OF-CHAIN
065600         GO TO 7680-UNLOCK
065700     ELSE
065800     IF NOT GOOD-CALL
065900         MOVE "DBGET ERR DLEVEL 7660-DDL" TO BU-DISPLAY-MSG
066000         PERFORM 2100-BLOWUP.
066100
066200     IF DLEVEL-EMPL = DE-EMPL
066300         NEXT SENTENCE
066400     ELSE
066500         GO TO 7660-DELETE-DLEVEL-LOOP.
066600
066700*    CALL "DBDELETE" USING BASE, DSET-DLEVEL, MODE1, STATUS-AREA.
           DELETE DLEVEL-O INVALID KEY MOVE "2" TO FILE-STATUS-1.
           IF FILE-STATUS NOT = "00"
066900         MOVE "DBDELETE DLEVEL 7660-DDL" TO BU-DISPLAY-MSG
067000         PERFORM 2100-BLOWUP.
067100
067200     GO TO 7660-DELETE-DLEVEL-LOOP.
067300
       7680-UNLOCK.
      *------- DO A START > HIGH-VALUES TO UNLOCK
           MOVE HIGH-VALUES TO EMPLOYID OF DLEVEL-REC-O.
           START DLEVEL-O KEY > EMPLOYID OF DLEVEL-REC-O
               INVALID KEY MOVE "00" TO FILE-STATUS.

067400 7690-DD-X.
067500     EXIT.
067600
067700 8000-UPDATE-EMPL-LEVELS.
067800*------ SUBPROG WILL UPDATE EACH MPATH ENTRY AND THE MLEVEL ENTRY
067900*------ IF THE EMPL CHANGES LEVELS OR ACTIVE STATE.
           MOVE SPACES                   TO   CEAUPEMP-PARMS.
068000     MOVE DE-EMPL                  TO   CEAU-EMPL.
068100     MOVE OLD-ACTIVE               TO   CEAU-OLD-ACTIVE.
068200     MOVE DE-ACTIVE-FLAG           TO   CEAU-CURRENT-ACTIVE.
068300     MOVE OLD-LEVEL                TO   CEAU-OLD-LEVEL.
068400     MOVE DE-LEVEL                 TO   CEAU-CURRENT-LEVEL.
068500     CALL "CEAUPEMP" USING         BASE,
068600                                   STATUS-AREA,
068700                                   CEAUPEMP-PARMS,
068800                                   BU-DISPLAY-MSG.
068900     IF BU-DISPLAY-MSG-1 NOT = SPACES
069000         PERFORM 2100-BLOWUP.
           MOVE SPACES                   TO   OLD-ACTIVE
                                              OLD-LEVEL.
069100
       COPY DISPCALL IN COPYLIB.
069200 999-CATREAD.
           IF CATREAD-MSG-NUMBER = ZEROS
               MOVE LANG-SETNUM TO CATREAD-MSG-SET
               MOVE LANG-MSGNUM TO CATREAD-MSG-NUM.
           CALL "CCATREAD" USING CATREAD-PARMS.
           MOVE CATREAD-MSG-TEXT TO MESSAGE-BUFFER.
070800 999-CATREAD-EXIT.
070900     EXIT.
