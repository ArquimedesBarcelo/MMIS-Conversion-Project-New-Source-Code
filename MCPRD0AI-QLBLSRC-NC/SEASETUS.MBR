000200 IDENTIFICATION DIVISION.
000300 PROGRAM-ID.          SEASETUS.
000400 AUTHOR.              C HILLES/J COFFMAN (MAINTAINER).
000500 DATE-WRITTEN.        7/1/87.
000600 DATE-COMPILED.
000700*INSTALLATION.        GOODYEAR TIRE AND RUBBER - AKRON.
000800*SECURITY.
000900*REMARKS.
001000*D   ELECTRONIC APPROVAL SYSTEM - USER AUTHORIZATION PROGRAM.
001100
001200
001300 ENVIRONMENT DIVISION.
001400 CONFIGURATION SECTION.
001500 SOURCE-COMPUTER.  HP-3000.
001600 OBJECT-COMPUTER.  HP-3000.
       SPECIAL-NAMES. I-O-FEEDBACK IS I-O-FEEDBACK-AREA.

       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT DISPLAY-FILE
                  ASSIGN TO WORKSTATION-ZEASETUP-SI
                  ORGANIZATION IS TRANSACTION
                  ACCESS IS SEQUENTIAL
                  FILE STATUS IS DISPLAY-STATUS
                  CONTROL-AREA IS WS-CONTROL.

           SELECT MEMPL-O
                  ASSIGN TO DATABASE-MCFLCS4201
                  ORGANIZATION IS INDEXED
                    ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                  FILE STATUS IS FILE-STATUS.

           SELECT MLEVEL-I
                  ASSIGN TO DATABASE-MCFLCS4101
                  ORGANIZATION IS INDEXED
                    ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                  FILE STATUS IS FILE-STATUS.

           SELECT PER-PERSONNEL-I
                  ASSIGN TO DATABASE-MCFLMM0301
                  ORGANIZATION IS INDEXED
                    ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                  FILE STATUS IS FILE-STATUS.

           SELECT DREQQUE-I
                  ASSIGN TO DATABASE-MCFLCS4402
                  ORGANIZATION IS INDEXED
                    ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                    WITH DUPLICATES
                  FILE STATUS IS FILE-STATUS.

           SELECT DLEVEL-O
                  ASSIGN TO DATABASE-MCFLCS4302
                  ORGANIZATION IS INDEXED
                    ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                    WITH DUPLICATES
                  FILE STATUS IS FILE-STATUS.
001700
001800 DATA DIVISION.
       FILE SECTION.
       FD  DISPLAY-FILE
           LABEL RECORDS ARE OMITTED.
       01  DISPLAY-REC        PIC X(1500).

       FD  MEMPL-O
           LABEL RECORDS ARE STANDARD.
       01  MEMPL-REC-O.
           COPY DDS-MCRPCS4200  OF MCFLCS4201.

       FD  MLEVEL-I
           LABEL RECORDS ARE STANDARD.
       01  MLEVEL-REC-I.
           COPY DDS-MCRPCS4100  OF MCFLCS4101.

       FD  PER-PERSONNEL-I
           LABEL RECORDS ARE STANDARD.
       01  PER-PERSONNEL-REC-I.
           COPY DDS-MCRPMM0300  OF MCFLMM0301.

       FD  DREQQUE-I
           LABEL RECORDS ARE STANDARD.
       01  DREQQUE-REC-I.
           COPY DDS-MCRPCS4400  OF MCFLCS4402.

       FD  DLEVEL-O
           LABEL RECORDS ARE STANDARD.
       01  DLEVEL-REC-O.
           COPY DDS-MCRPCS4300  OF MCFLCS4302.

001900 WORKING-STORAGE SECTION.
002000
002100 77  MOD-DEL-FLAG                  PIC X(1).
002200 77  SUB                           PIC S9(4) COMP-4 VALUE 0.
002300 77  EMPL-MATCHED-FLAG             PIC X(1).
002400 77  OLD-LEVEL                     PIC X(2).
002500 77  OLD-ACTIVE                    PIC X(1).
002600
