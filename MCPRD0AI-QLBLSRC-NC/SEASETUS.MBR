       01  FILE-STATUS.
           05  FILE-STATUS-1            PIC X  VALUE "0".
           05  FILE-STATUS-2            PIC X  VALUE "0".
007100
007200 COPY DBSTAT     IN COPYLIB.
007300 01  DSET-NAMES.
007400     05  DSET-NAME               PIC X(16) VALUE SPACES.
007500     05  DSET-MEMPL              PIC X(16) VALUE "MEMPL;".
007600     05  DSET-PER-PERSONNEL      PIC X(16) VALUE "PER-PERSONNEL;".
007700     05  DSET-MLEVEL             PIC X(16) VALUE "MLEVEL;".
007800     05  DSET-DLEVEL             PIC X(16) VALUE "DLEVEL;".
007900     05  DSET-DREQQUE            PIC X(16) VALUE "DREQQUE;".
008000     05  DSET-MPATH              PIC X(16) VALUE "MPATH;".
008100
008200 01  MODE-AREA.
008300     05  MODE1                     PIC S9(4)   COMP       VALUE 1.
008400     05  MODE3                     PIC S9(4)   COMP       VALUE 3.
008500     05  MODE5                     PIC S9(4)   COMP       VALUE 5.
008600     05  MODE7                     PIC S9(4)   COMP       VALUE 7.
008700
008800 01  ALL-ITEMS                     PIC X(2)  VALUE "@;".
008900 01  EMPL-SEARCH                   PIC X(12) VALUE "EMPLOYEE-ID;".
009000 01  LEVEL-SEARCH                  PIC X(10) VALUE "LEVEL-NUM;".
009100 01  EMPL-ARG                      PIC X(4).
009200 01  LEVEL-ARG                     PIC X(2).
009300 01  PATH-ARG.
009400     05  PATH-ARG-PREFIX           PIC X(1)  VALUE "R".
009500     05  PATH-ARG-NUMBER           PIC 9(3).
