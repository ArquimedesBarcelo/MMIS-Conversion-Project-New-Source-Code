       IDENTIFICATION DIVISION.
       PROGRAM-ID.             TRTVCRFT.
       AUTHOR.                 W. ROXBURY.
       INSTALLATION.           GOODYEAR TIRE AND RUBBER COMPANY.
       DATE-WRITTEN.           FEBRUARY 1998.
       DATE-COMPILED.
       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.
       SOURCE-COMPUTER.        IBM-AS400.
       OBJECT-COMPUTER.        IBM-AS400.
       SPECIAL-NAMES.          I-O-FEEDBACK     IS I-O-FEEDBACK-AREA
                               REQUESTOR        IS WORK-STATION
                               SYSTEM-CONSOLE   IS CONSOLE
                               LOCAL-DATA       IS LOCAL-DATA-AREA.

      *C****************************************************************
      *C  02/03/98  WDR
      *C    ADDED SUBFILE SELECTION OF CRAFT FROM VALID CRAFT LIST.
      *C****************************************************************

       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT CRAFTS-REQUIRED
                  ASSIGN       TO DATABASE-MCFLMM0601
                  ORGANIZATION IS INDEXED
                  ACCESS MODE  IS DYNAMIC
                  RECORD KEY   IS EXTERNALLY-DESCRIBED-KEY
                  FILE STATUS  IS FILE-STAT.

           SELECT DISPLAY-FILE
                  ASSIGN       TO WORKSTATION-ZRTVCRFT-SI
                  ORGANIZATION IS TRANSACTION
                  ACCESS MODE  IS DYNAMIC
                  RELATIVE KEY IS RECNO
                  FILE STATUS  IS SCREEN-STATUS
                               MAJOR-MINOR
                  CONTROL-AREA IS SCREEN-CONTROL.

       DATA DIVISION.
       FILE SECTION.
       FD  CRAFTS-REQUIRED
           LABEL RECORDS       ARE STANDARD.
       01  CR-REC.
           COPY DDS-ALL-FORMATS OF MCFLMM0601.

       FD  DISPLAY-FILE
           LABEL RECORDS       ARE OMITTED.
       01  DISPLAY-REC         PIC X(2000).

       WORKING-STORAGE SECTION.
       77  RECNO               PIC 9999  VALUE 0.
       77  TRUE-VAL            PIC 1   VALUE B"1".
       77  NEG-VAL             PIC 1   VALUE B"0".

       01  FILE-STAT.
           05 FILE-STAT-1      PIC X   VALUE "0".
           05 FILE-STAT-2      PIC X   VALUE "0".

       01  SCREEN-DATA.
           05  CRFT-BUF        PIC XX.
           05  SCRN-MSGS.
               10  CMDMSG      PIC X(79).
               10  ERRMSG      PIC X(79).

       01  CRFT-LIST-DATA.
           05  SEL-BUF         PIC X.
           05  LCRFT           PIC XX.

       01  CRFT-ARGUMENT.
           05  C-ARG           PIC X(02).
           05  C-PRT           PIC X(02).
           05  C-PAD           PIC X(12).

       01  DB-ERROR.
           05  DB-FUNC   PIC X(10) VALUE SPACES.
           05  DB-FILE   PIC X(18) VALUE SPACES.
           05  FILLER    PIC X(20) VALUE "ERROR - FILE-STAT = ".
           05  CON-WORD  PIC XX.

           COPY SCREENIO       IN COPYLIB.

           COPY CATREAD        IN COPYLIB.

           COPY JCWAREA        IN COPYLIB.

       01  DBPARAMETERS.
           COPY DBPARMS        IN COPYLIB.

       01  MESSAGE-BUFFER-DATA.
           COPY ERRORLIN       IN COPYLIB.

       LINKAGE SECTION.
       01  CRFT-KEY            PIC XX.

       PROCEDURE DIVISION      USING CRFT-KEY.
       BEGIN-PROC.
           OPEN INPUT          CRAFTS-REQUIRED.
           OPEN I-O            DISPLAY-FILE.

       6-MAIN.
           IF CRFT-KEY = "? " OR " ?" OR "??"
               MOVE SPACES     TO CRFT-KEY
               PERFORM DISPLAY-CRFTS THRU DC-EXIT
               IF CRFT-KEY = SPACES
                   GO TO 6-MAIN
               ELSE
                   MOVE CRFT-KEY TO CRFT-BUF
                   GO TO UPDATE-JCW.

           MOVE SPACES         TO SCREEN-DATA
                                  CRFT-KEY.
           MOVE "VRTVCRFT"     TO SCREEN-NAME.

       61-SHOWFORM.
           MOVE "00"           TO SCREEN-STATUS.
           MOVE SCREEN-DATA    TO DISPLAY-REC.

           WRITE DISPLAY-REC  FORMAT IS SCREEN-NAME
               INDIC ARE SCREEN-INDICATORS.
           IF SCREEN-STATUS NOT = "00"
               DISPLAY "SCREEN WRITE ERROR.  SCREEN-STATUS IS "
                        SCREEN-STATUS
               GO TO END-OF-JOB.

           READ  DISPLAY-FILE FORMAT IS SCREEN-NAME
               INDIC ARE SCREEN-INDICATORS
           IF SCREEN-STATUS NOT = "00"
               DISPLAY "SCREEN READ ERROR.  SCREEN-STATUS IS "
                        SCREEN-STATUS
               GO TO END-OF-JOB.

           MOVE DISPLAY-REC    TO SCREEN-DATA.
           MOVE ALL B"0"       TO SCREEN-INDICATORS.

           IF KEY-HIT = 3 OR 8
               MOVE SPACES     TO CRFT-KEY
               GO TO END-OF-JOB.

           IF KEY-HIT = 4
               PERFORM DISPLAY-CRFTS THRU DC-EXIT
               IF CRFT-KEY = SPACES
                   GO TO 6-MAIN
               ELSE
                   MOVE CRFT-KEY TO CRFT-BUF
                   GO TO UPDATE-JCW.

           IF CRFT-BUF = SPACES
      **********************************************************************
      **    MESSAGE 035/037:
      ** INVALID CRAFT
      **********************************************************************
               MOVE 35         TO CATREAD-MSG-SET
               MOVE 37         TO CATREAD-MSG-NUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER TO ERRMSG
               MOVE TRUE-VAL   TO IND(1) IND(99)
               GO TO 61-SHOWFORM.

           MOVE CRFT-BUF       TO C-ARG.
           MOVE CRFT-ARGUMENT  TO CRAFTREQD OF CRAFTS-REQUIRED.
           START CRAFTS-REQUIRED KEY = EXTERNALLY-DESCRIBED-KEY
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
      **********************************************************************
      **    MESSAGE 035/044:
      ** INVALID CRAFT
      **********************************************************************
               MOVE  35        TO CATREAD-MSG-SET
               MOVE  44        TO CATREAD-MSG-NUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER TO ERRMSG
               MOVE TRUE-VAL   TO IND(1) IND(99)
               GO TO 61-SHOWFORM.

       UPDATE-JCW.
           MOVE CRFT-BUF       TO JCW-CJCW-274 SETJCW-VALUE
                                  CRFT-KEY.
           MOVE 274            TO SETJCW-STARTING-POS.
           MOVE 2              TO SETJCW-LENGTH.

           CALL "SETJCW" USING SETJCW-VALUE,
                               SETJCW-STARTING-POS,
                               SETJCW-LENGTH,
                               SETJCW-STATUS.

           IF SETJCW-STATUS NOT = "00"
               MOVE "  "       TO JCW-CJCW-274.

       END-OF-JOB.
           CLOSE               DISPLAY-FILE.
           CLOSE               CRAFTS-REQUIRED.
           GOBACK.

       DISPLAY-CRFTS.
           MOVE SPACES         TO CRFT-KEY.
           MOVE 0              TO RECNO.
           MOVE NEG-VAL        TO IND(75).
           MOVE TRUE-VAL       TO IND(77) IND(76).
           MOVE SPACES         TO DISPLAY-REC
                                  CRFT-LIST-DATA.
           WRITE DISPLAY-REC   FORMAT "CRFTLIST"
                               INDIC ARE SCREEN-INDICATORS.
           IF SCREEN-STATUS NOT = "00"
               DISPLAY
               "SUBFILE CLEAR WRITE ERROR.  SCREEN-STATUS IS "
                               SCREEN-STATUS.
           MOVE NEG-VAL        TO IND(77).

           MOVE LOW-VALUES     TO CRAFTREQD OF CRAFTS-REQUIRED.
           START CRAFTS-REQUIRED KEY >= CRAFTREQD OF CRAFTS-REQUIRED
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT = "23"
               GO TO DBGET-LOOP
           ELSE
           IF FILE-STAT NOT = "00"
               MOVE "START    "    TO DB-FUNC
               MOVE "CRAFTS-REQUIRED" TO DB-FILE
               MOVE FILE-STAT      TO CON-WORD
               DISPLAY             DB-ERROR
               GO TO DC-EXIT.

       DBGET-LOOP.
           READ CRAFTS-REQUIRED NEXT INTO CRFT-ARGUMENT
               AT END          MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT = "10" OR "14" OR "46"
               GO TO SUBF-CONT
           ELSE
           IF FILE-STAT NOT = "00"
               MOVE "READ     "    TO DB-FUNC
               MOVE "CRAFTS-REQUIRED" TO DB-FILE
               MOVE FILE-STAT      TO CON-WORD
               DISPLAY             DB-ERROR
               GO TO DC-EXIT.

           IF C-ARG = SPACES
               GO TO DBGET-LOOP.

           MOVE SPACES         TO CRFT-LIST-DATA.
           MOVE C-ARG          TO LCRFT.
           ADD 1               TO RECNO.
           MOVE CRFT-LIST-DATA TO DISPLAY-REC.
           MOVE "00"           TO SCREEN-STATUS.
           WRITE SUBFILE       DISPLAY-REC FORMAT "CRAFTS"
                               INDIC ARE SCREEN-INDICATORS
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF SCREEN-STATUS NOT = "00"
               DISPLAY   "SUBFILE 1 WRITE ERROR.  SCREEN STATUS IS "
                   SCREEN-STATUS
               GO TO END-OF-JOB.

           GO TO DBGET-LOOP.

       SUBF-CONT.
           IF RECNO EQUAL 0
               GO TO DC-EXIT.

           WRITE DISPLAY-REC   FORMAT "CRFTCMD"
                               INDIC ARE SCREEN-INDICATORS.
           MOVE TRUE-VAL       TO IND(76).
           IF RECNO GREATER THAN 0
               MOVE TRUE-VAL   TO IND(75)
           ELSE
               MOVE NEG-VAL    TO IND(75).

           WRITE DISPLAY-REC   FORMAT "CRFTLIST"
                               INDIC ARE SCREEN-INDICATORS.
           READ DISPLAY-FILE   FORMAT "CRFTLIST"
                               INDIC ARE SCREEN-INDICATORS.

           MOVE SPACES         TO CRFT-LIST-DATA.
           READ SUBFILE        DISPLAY-FILE
                               NEXT MODIFIED INTO CRFT-LIST-DATA
                               FORMAT "CRAFTS"
                               INDIC ARE SCREEN-INDICATORS.

           IF SEL-BUF NOT = SPACE
               MOVE LCRFT      TO CRFT-KEY.

       DC-EXIT.                EXIT.

       999-CATREAD.
           MOVE SPACES         TO MESSAGE-BUFFER.
           CALL "CCATREAD" USING CATREAD-PARMS.
           MOVE CATREAD-MSG-TEXT TO MESSAGE-BUFFER.

       999-CATREAD-EXIT.    EXIT.

