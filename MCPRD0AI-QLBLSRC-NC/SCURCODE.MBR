       IDENTIFICATION DIVISION.
       PROGRAM-ID.     SCURCODE.
       AUTHOR.         ANNETTE M. KRAUSS.
       INSTALLATION.   THE GOODYEAR TIRE AND RUBBER COMPANY - AKRON.
       DATE-WRITTEN.   MAY 27, 1986.
       DATE-COMPILED.
      *REMARKS.
      **************************************************************
      *                                                            *
      *D   SCURCODE                CURRENCY CODE SUBPROGRAM        *
      *                                                            *
      *D    THIS PROGRAM IS USED TO LOAD CURRENCY CODES INTO       *
      *D    THE STORES DATA BASE FOR STARTUP ON CSIS.              *
      *D                                                           *
      *D    THIS PROGRAM IS CALLED BY:                             *
      *D                      1.  TPLTSTUP                         *
      *D                                                           *
      *D    THIS PROGRAM CALLS:                                    *
      *D                      1.  SCURHELP                         *
      **************************************************************

       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.
       SOURCE-COMPUTER.  IBM-AS400.
       OBJECT-COMPUTER.  IBM-AS400.
       SPECIAL-NAMES. I-O-FEEDBACK IS I-O-FEEDBACK-AREA.
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
            SELECT DISPLAY-FILE
                   ASSIGN TO WORKSTATION-ZPLTSTUP-SI
                   ORGANIZATION IS TRANSACTION
                   ACCESS IS SEQUENTIAL
                   FILE STATUS IS DISPLAY-STATUS
                   CONTROL-AREA IS WS-CONTROL.
            SELECT MPLTINFO-O
                   ASSIGN TO DATABASE-MCFLCS0501
                   ORGANIZATION IS INDEXED
                   ACCESS IS DYNAMIC
                   RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                   FILE STATUS IS FILE-STATUS.
            SELECT MVALIDUM-O
                   ASSIGN TO DATABASE-MCFLCS0401
                   ORGANIZATION IS INDEXED
                   ACCESS IS DYNAMIC
                   RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                   FILE STATUS IS FILE-STATUS.
       DATA DIVISION.
       FILE SECTION.
       FD  DISPLAY-FILE
           LABEL RECORDS ARE OMITTED.
       01  DISPLAY-REC             PIC X(2000).
       FD  MPLTINFO-O
           LABEL RECORDS ARE STANDARD.
       01  MPLTINFO-O-REC.
           COPY DDS-MCRPCS0500 OF MCFLCS0501.
       FD  MVALIDUM-O
           LABEL RECORDS ARE STANDARD.
       01  MVALIDUM-O-REC.
           COPY DDS-MCRPCS0400 OF MCFLCS0401.

       WORKING-STORAGE SECTION.
       77  WS-EDI-INSTAL              PIC X     VALUE SPACE.
       01  FILE-STATUS.
           05  FILE-STATUS-1          PIC X VALUE SPACE.
           05  FILE-STATUS-2          PIC X VALUE SPACE.

       77  EOF-SW                     PIC X(1)  VALUE "N".

       01  TODAY-DATE.
           05  YY                     PIC X(2).
           05  MM                     PIC X(2).
           05  DD                     PIC X(2).

       01  COMPUTER-DATE.
           05  CMM                    PIC X(2).
           05  FILLER                 PIC X(1).
           05  CDD                    PIC X(2).
           05  FILLER                 PIC X(1).
           05  CYY                    PIC X(2).

       01  CLEAR-OUT-AREA.
           05  CLEAR-OUT-AREA-X OCCURS 15 TIMES.
               10  FILLER              PIC X(15)      VALUE SPACES.
               10  RATE-FILLER         PIC 9(5)V9(7)  VALUE ZEROS.
               10  FILLER              PIC X(20)      VALUE SPACES.
       01  CLEAR-OUT-AREA2.
           05  RATE2-FILLER            PIC 9(5)V9(7)  VALUE ZEROS.
           05  FILLER                  PIC X(20)      VALUE SPACES.

      *************************************************************
      *************************************************************
      **                                                         **
      **              D A T A    B A S E    A R E A              **
      **                                                         **
      *************************************************************
      *************************************************************

       COPY MVALIDUM   IN COPYLIB.

       COPY MPLTINFO   IN COPYLIB.

       01  ARG-VALUES.
           05  MVALIDUM-ARG              PIC X(2).
           05  MPLTINFO-ARG              PIC X(4).

       01  CURRENCY-CODE-ARG.
           05  FILLER                    PIC X(2)  VALUE "CC".
           05  CURRENCY-CODE-IN          PIC X(2).

       01  MESSAGE-BUFFER.
           05  MSG-TEXT                  PIC X(64)  VALUE SPACES.
           05  MSG-FLD                   PIC X(12)  VALUE SPACES.

       COPY DBSTAT     IN COPYLIB.

       01  CODE-CTR                      PIC 99    VALUE 1.
       01  NUMBER-OF-CODES               PIC 99    VALUE ZEROS.
       01  BUF-NO                        PIC 9     VALUE ZERO.

       01  LOCAL-DESC-WS         PIC X(12).
       01  EXCHANGE-RATE-AREA-CLEAR      PIC X(1920).
       01  EXCHANGE-RATE-AREA REDEFINES EXCHANGE-RATE-AREA-CLEAR.
           05  EXCHANGE-RATE-WS-TBL OCCURS 60 TIMES
               INDEXED BY Y.
               10  EXCHANGE-RATE-WS      PIC 9(5)V9(7).
               10  FOREIGN-CODE-WS       PIC X(2).
               10  FOREIGN-DESC-WS       PIC X(12).
               10  REF-DATE-WS           PIC X(6).

      *************************************************************
      *************************************************************
      **                                                         **
      **                 TERMINAL I/O DATA AREA                  **
      **                                                         **
      *************************************************************
      *************************************************************

       01  MENU-SCREEN.
           05  MENU-CMDLINE              PIC X(79).
           05  MENU-ERRLINE              PIC X(79).

       01  CURRENCY-SCREEN.
           05  ADD-CURRENCY-CODE.
               10  CURRENCY-CODE1        PIC X(2).
               10  CURRENCY-DESC1        PIC X(12).
           05  CURRENCY-MSGLINE          PIC X(79).
           05  CURRENCY-MSGLINE2         PIC X(79).
           05  CURRENCY-CMDLINE          PIC X(79).
           05  CURRENCY-ERRLINE          PIC X(79).

       01  E-CURRENCY-SCREEN.
           05  E-ADD-CURRENCY-CODE.
               10  E-CURRENCY-CODE1      PIC X(2).
               10  E-CURRENCY-DESC1      PIC X(12).
               10  E-EDI-CURRENCY-CODE   PIC X(3).
           05  E-CURRENCY-MSGLINE        PIC X(79).
           05  E-CURRENCY-MSGLINE2       PIC X(79).
           05  E-CURRENCY-CMDLINE        PIC X(79).
           05  E-CURRENCY-ERRLINE        PIC X(79).

       01  EXCHANGE-RATE-INFO.
           05  CURR-CONV-SW              PIC X(1).
           05  HOME-CURRENCY             PIC X(2).
           05  INFO-MSGLINE              PIC X(79).
           05  INFO-CMDLINE              PIC X(79).
           05  INFO-ERRLINE              PIC X(79).

       01  EXCHANGE-RATE-SINGLE.
           05  FOREIGN-CURRENCY          PIC X(2).
           05  LOCAL-DESC                PIC X(12).
           05  EXCHANGE-RATE             PIC 9(5)V9(7).
           05  FOREIGN-DESC              PIC X(12).
           05  REF-DATE                  PIC X(6).
           05  RATE-MSGLINE              PIC X(79).
           05  RATE-CMDLINE              PIC X(79).
           05  RATE-ERRLINE              PIC X(79).

       01  EXCHANGE-RATE-MULTI-TBL.
           05  EXCHANGE-RATE-MULTI-DATA  PIC X(705).
           05  EXCHANGE-RATE-MULTI REDEFINES EXCHANGE-RATE-MULTI-DATA
               OCCURS 15 TIMES INDEXED BY X.
               10  LOCAL-UNIT            PIC X(3).
               10  LOCAL-DESC-TBL        PIC X(12).
               10  EXCHANGE-RATE-TBL     PIC 9(5)V9(7).
               10  FOREIGN-CODE-TBL      PIC X(2).
               10  FOREIGN-DESC-TBL      PIC X(12).
               10  REF-DATE-TBL          PIC X(6).
           05  TBL-MSGLINE               PIC X(79).
           05  TBL-CMDLINE               PIC X(79).
           05  TBL-ERRLINE               PIC X(79).

       COPY TBLOWUP    IN COPYLIB.
       COPY CATREAD    IN COPYLIB.
       COPY CGENHELP   IN COPYLIB.
       COPY DISPDATA   IN COPYLIB.
       COPY IOFEEDBACK IN COPYLIB.

      *************************************************************
      *************************************************************
      **                                                         **
      **               LINKAGE   SECTION                         **
      **                                                         **
      *************************************************************
      *************************************************************

       LINKAGE SECTION.

       01  BASE                          PIC X(10).
       COPY VCOMLINK   IN COPYLIB.
       COPY LANGSUB    IN COPYLIB.


      *************************************************************
      **#########################################################**
      *************************************************************
      **                                                         **
      **          P R O C E D U R E    D I V I S I O N           **
      **                                                         **
      *************************************************************
      **#########################################################**
      *************************************************************

       PROCEDURE DIVISION USING BASE,
                                VIEW-COMAREA,
                                LANGUAGE-PARMS.

       0-SCURCODE-SEC SECTION 1.

       0-BEGIN-HERE.
           PERFORM 1-HSK.
           PERFORM 6-MAIN THRU 6-MAIN-X.
           PERFORM 2-EOJ.

       1-HSK.
           MOVE "SCURCODE" TO BU-PGM-NAME.
           OPEN I-O DISPLAY-FILE, MPLTINFO-O, MVALIDUM-O.
           ACCEPT TODAY-DATE FROM DATE.
           MOVE "N"        TO WS-EDI-INSTAL.
           MOVE "EDI "     TO PLTINFOKEY OF MPLTINFO-O-REC.
           READ MPLTINFO-O INTO BUF-MPLTINFO.
           IF FILE-STATUS NOT = "00"
               MOVE "READ ERROR EDI MPLTINFO-REC" TO BU-DISPLAY-MSG
               PERFORM 2-BLOWUP.
           IF EDI-INSTAL = "Y" MOVE "Y" TO WS-EDI-INSTAL.

       2-EOJ.
           CLOSE DISPLAY-FILE, MPLTINFO-O, MVALIDUM-O.
           GOBACK.

      ******************************************************
      **                 BLOWUP ROUTINE                   **
      ******************************************************

       2-BLOWUP.
           CALL "TBLOWUP" USING BASE, BU-PGM-NAME, STATUS-AREA,
                 VIEW-COMAREA, FILE-STATUS, BU-DISPLAY-MSG,
                 BU-DISPLAY-AREA.

      **************************************************
      *                                                *
      *                  6 - M A I N                   *
      *                                                *
      **************************************************
       6-MAIN.
           MOVE "CURRMENU" TO VIEW-NFNAME.
           MOVE SPACES     TO MENU-SCREEN.

       6-SHOW-FORM.
           MOVE MENU-SCREEN TO DISPLAY-REC.
           PERFORM 998-WRITE-SCREEN THRU 998-READ-SCREEN.
           MOVE DISPLAY-REC TO MENU-SCREEN.

       6-READ-FIELDS.
           IF VIEW-LASTKEY = 3
               GO TO 6-MAIN-X.
           IF VIEW-LASTKEY = 6 OR
              VIEW-LASTKEY = 7 OR
              VIEW-LASTKEY = 8
      *****    INVALID FUNCTION KEY    *****
               MOVE   9 TO LANG-SETNUM
               MOVE  10 TO LANG-MSGNUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER TO MENU-ERRLINE
               MOVE B"1" TO IND(99)
               GO TO 6-SHOW-FORM
           ELSE
           IF VIEW-LASTKEY = 1
               IF WS-EDI-INSTAL = "Y"
                   PERFORM 61-EDI-CURRENCY THRU 61-EDI-CURRENCY-X
               ELSE
               PERFORM 61-CURRENCY     THRU 61-CURRENCY-X
           ELSE
           IF VIEW-LASTKEY = 2
               PERFORM 62-EXCHANGE-QUEST THRU 62-EXCHANGE-QUEST-X
           ELSE
           IF VIEW-LASTKEY = 4
               PERFORM 63-EXCHANGE-RATE THRU 63-EXCHANGE-RATE-X
           ELSE
           IF VIEW-LASTKEY = 5
               PERFORM 64-EXCHANGE-TBL  THRU 64-EXCHANGE-TBL-X.

           GO TO 6-MAIN.

       6-MAIN-X.
           EXIT.

       61-CURRENCY.
           MOVE SPACES TO CURRENCY-SCREEN.
      ***  INPUT DATA ABOVE AND PRESS 'ENTER'  ***
           MOVE   9 TO LANG-SETNUM.
           MOVE  20 TO LANG-MSGNUM.
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
           MOVE MESSAGE-BUFFER TO CURRENCY-MSGLINE.

      ** PLEASE CONTACT AKRON CME BEFORE ADDING A CURRENCY CODE **
           MOVE  16 TO LANG-SETNUM.
           MOVE 115 TO LANG-MSGNUM.
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
           MOVE MESSAGE-BUFFER TO CURRENCY-MSGLINE2.

       61-SHOW-FORM.
           MOVE "CURRENCY" TO VIEW-NFNAME.
           MOVE CURRENCY-SCREEN TO DISPLAY-REC.
           PERFORM 998-WRITE-SCREEN THRU 998-READ-SCREEN.
           MOVE DISPLAY-REC     TO CURRENCY-SCREEN.

       61-READ-FIELDS.
           IF VIEW-LASTKEY = 3
               GO TO 61-CURRENCY-X.
           IF VIEW-LASTKEY = 1
               MOVE SPACES TO CGENHELP-PARMS, BU-DISPLAY-MSG
               MOVE "CURRCO" TO CGENHELP-TYPE
               CALL "CGENHELP" USING BU-DISPLAY-AREA,
                                     BU-DISPLAY-MSG,
                                     CGENHELP-PARMS,
                                     VIEW-COMAREA
               IF BU-DISPLAY-MSG NOT = SPACES
                   PERFORM 2-BLOWUP
               END-IF
      *        CALL "SCURHELP" USING BASE,
      *                              VIEW-COMAREA,
      *                              LANGUAGE-PARMS
      *                              WS-EDI-INSTAL
               GO TO 61-SHOW-FORM
           ELSE
           IF VIEW-LASTKEY = 2 OR
              VIEW-LASTKEY = 4 OR
              VIEW-LASTKEY = 5 OR
              VIEW-LASTKEY = 6 OR
              VIEW-LASTKEY = 7 OR
              VIEW-LASTKEY = 8
      *****    INVALID FUNCTION KEY    *****
               MOVE   9 TO LANG-SETNUM
               MOVE  10 TO LANG-MSGNUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER TO CURRENCY-ERRLINE
               MOVE B"1" TO IND(99)
               GO TO 61-SHOW-FORM.

       61-EDIT-CHECKS.
           IF CURRENCY-CODE1 NOT = SPACES
              MOVE CURRENCY-CODE1 TO MVALIDUM-ARG
              MOVE MVALIDUM-ARG   TO VALIDUM OF MVALIDUM-O-REC
              START MVALIDUM-O KEY = VALIDUM OF MVALIDUM-O-REC
                  INVALID KEY MOVE FILE-STATUS TO FILE-STATUS
              END-START
              IF FILE-STATUS = "00"
      *------- DO A START > HIGH-VALUES TO UNLOCK
                  MOVE HIGH-VALUES TO VALIDUM OF MVALIDUM-O-REC
                  START MVALIDUM-O KEY > VALIDUM OF MVALIDUM-O-REC
                      INVALID KEY MOVE "00" TO FILE-STATUS
                  END-START
      ****     CURRENCY CODE ALREADY EXITS   ****
                  MOVE   3 TO LANG-SETNUM
                  MOVE  67 TO LANG-MSGNUM
                  PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                  MOVE MESSAGE-BUFFER TO CURRENCY-ERRLINE
                  MOVE B"1" TO IND(99), IND(1)
                  GO TO 61-SHOW-FORM
              ELSE
              IF FILE-STATUS-1 = "2"
                  PERFORM 61-ADD-MVALIDUM
              ELSE
                  MOVE "START MVALIDUM ERROR IN 61-EDIT-CHECK"
                      TO BU-DISPLAY-MSG
                  MOVE CURRENCY-CODE1 TO BU-DISPLAY-FLD (1)
                  PERFORM 2-BLOWUP.

           GO TO 61-CURRENCY.

       61-CURRENCY-X.
           EXIT.

       61-ADD-MVALIDUM.
           MOVE SPACES         TO BUF-MVALIDUM.
           MOVE CURRENCY-CODE1 TO VALID-UM.
           MOVE CURRENCY-DESC1 TO VALID-CURRENCY-DESC.
           WRITE MVALIDUM-O-REC FROM BUF-MVALIDUM
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE "WRT MVALIDUM ERROR IN 61-ADD-MVALIDUM"
                    TO BU-DISPLAY-MSG
               MOVE CURRENCY-CODE1 TO BU-DISPLAY-FLD (1)
               PERFORM 2-BLOWUP.

       61-EDI-CURRENCY.
           MOVE SPACES TO E-CURRENCY-SCREEN.
      ***  INPUT DATA ABOVE AND PRESS 'ENTER'  ***
           MOVE   9 TO LANG-SETNUM.
           MOVE  20 TO LANG-MSGNUM.
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
           MOVE MESSAGE-BUFFER TO E-CURRENCY-MSGLINE.

      ** PLEASE CONTACT AKRON CME BEFORE ADDING A CURRENCY CODE **
           MOVE  16 TO LANG-SETNUM.
           MOVE 115 TO LANG-MSGNUM.
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
           MOVE MESSAGE-BUFFER TO E-CURRENCY-MSGLINE2.

       61-EDI-SHOW-FORM.
           MOVE "ECURRENCY" TO VIEW-NFNAME.
           MOVE E-CURRENCY-SCREEN TO DISPLAY-REC.
           PERFORM 998-WRITE-SCREEN THRU 998-READ-SCREEN.
           MOVE DISPLAY-REC     TO E-CURRENCY-SCREEN.

       61-EDI-READ-FIELDS.
           IF VIEW-LASTKEY = 3
               GO TO 61-EDI-CURRENCY-X.
           IF VIEW-LASTKEY = 1
               MOVE SPACES TO CGENHELP-PARMS, BU-DISPLAY-MSG
               MOVE "CURRCO" TO CGENHELP-TYPE
               CALL "CGENHELP" USING BU-DISPLAY-AREA,
                                     BU-DISPLAY-MSG,
                                     CGENHELP-PARMS,
                                     VIEW-COMAREA
               IF BU-DISPLAY-MSG NOT = SPACES
                   PERFORM 2-BLOWUP
               END-IF
      *        CALL "SCURHELP" USING BASE,
      *                              VIEW-COMAREA,
      *                              LANGUAGE-PARMS
      *                              WS-EDI-INSTAL
               GO TO 61-EDI-SHOW-FORM
           ELSE
           IF VIEW-LASTKEY = 2 OR
              VIEW-LASTKEY = 4 OR
              VIEW-LASTKEY = 5 OR
              VIEW-LASTKEY = 6 OR
              VIEW-LASTKEY = 7 OR
              VIEW-LASTKEY = 8
      *****    INVALID FUNCTION KEY    *****
               MOVE   9 TO LANG-SETNUM
               MOVE  10 TO LANG-MSGNUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER TO CURRENCY-ERRLINE
               MOVE B"1" TO IND(99)
               GO TO 61-EDI-SHOW-FORM.

       61-EDI-EDIT-CHECKS.
           IF E-CURRENCY-CODE1 NOT = SPACES
              MOVE E-CURRENCY-CODE1 TO MVALIDUM-ARG
              MOVE MVALIDUM-ARG   TO VALIDUM OF MVALIDUM-O-REC
              START MVALIDUM-O KEY = VALIDUM OF MVALIDUM-O-REC
                  INVALID KEY MOVE FILE-STATUS TO FILE-STATUS
              END-START
              IF FILE-STATUS = "00"
      *------- DO A START > HIGH-VALUES TO UNLOCK
                  MOVE HIGH-VALUES TO VALIDUM OF MVALIDUM-O-REC
                  START MVALIDUM-O KEY > VALIDUM OF MVALIDUM-O-REC
                      INVALID KEY MOVE "00" TO FILE-STATUS
                  END-START
      ****     CURRENCY CODE ALREADY EXITS   ****
                  MOVE   3 TO LANG-SETNUM
                  MOVE  67 TO LANG-MSGNUM
                  PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                  MOVE MESSAGE-BUFFER TO E-CURRENCY-ERRLINE
                  MOVE B"1" TO IND(99), IND(1)
                  GO TO 61-EDI-SHOW-FORM
              ELSE
              IF FILE-STATUS-1 = "2"
                  PERFORM 61-ADD-MVALIDUM
              ELSE
                  MOVE "START MVALIDUM ERROR IN 61-EDIT-CHECK"
                      TO BU-DISPLAY-MSG
                  MOVE CURRENCY-CODE1 TO BU-DISPLAY-FLD (1)
                  PERFORM 2-BLOWUP.

           GO TO 61-EDI-CURRENCY.

       61-EDI-CURRENCY-X.
           EXIT.

       62-EXCHANGE-QUEST.
           MOVE SPACES TO EXCHANGE-RATE-INFO.
           MOVE "CCHM" TO MPLTINFO-ARG.
           MOVE MPLTINFO-ARG TO PLTINFOKEY OF MPLTINFO-O-REC.
           READ MPLTINFO-O INTO BUF-MPLTINFO
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS = "00"
               MOVE MPLTINFO-HOME-CUR-CODE TO HOME-CURRENCY
               MOVE MPLTINFO-CUR-CONV-SW   TO CURR-CONV-SW
      *------- DO A START > HIGH-VALUES TO UNLOCK
               MOVE HIGH-VALUES TO PLTINFOKEY OF MPLTINFO-O-REC
               START MPLTINFO-O KEY > PLTINFOKEY OF MPLTINFO-O-REC
                   INVALID KEY MOVE "00" TO FILE-STATUS
           ELSE
           IF FILE-STATUS-1 NOT = "2"
               MOVE "READ MPLTINFO ERROR IN 62-LOAD-INFO"
                    TO BU-DISPLAY-MSG
               MOVE "CCHM" TO BU-DISPLAY-FLD (1)
               PERFORM 2-BLOWUP.

       62-PUT-BUFFER.
      ***  INPUT DATA ABOVE AND PRESS 'ENTER'  ***
           MOVE   9 TO LANG-SETNUM.
           MOVE  20 TO LANG-MSGNUM.
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
           MOVE MESSAGE-BUFFER TO INFO-MSGLINE.

       62-SHOW-FORM.
           MOVE "EXCHANGE"         TO VIEW-NFNAME.
           MOVE EXCHANGE-RATE-INFO TO DISPLAY-REC.
           PERFORM 998-WRITE-SCREEN THRU 998-READ-SCREEN.
           MOVE DISPLAY-REC        TO EXCHANGE-RATE-INFO.
           IF VIEW-LASTKEY = 3
               GO TO 62-EXCHANGE-QUEST-X.
           IF VIEW-LASTKEY = 1
               MOVE SPACES TO CGENHELP-PARMS, BU-DISPLAY-MSG
               MOVE "CURRCO" TO CGENHELP-TYPE
               CALL "CGENHELP" USING BU-DISPLAY-AREA,
                                     BU-DISPLAY-MSG,
                                     CGENHELP-PARMS,
                                     VIEW-COMAREA
               IF BU-DISPLAY-MSG NOT = SPACES
                   PERFORM 2-BLOWUP
               END-IF
      *        CALL "SCURHELP" USING BASE,
      *                              VIEW-COMAREA,
      *                              LANGUAGE-PARMS
      *                              WS-EDI-INSTAL
               GO TO 62-SHOW-FORM
           ELSE
           IF VIEW-LASTKEY = 2 OR
              VIEW-LASTKEY = 4 OR
              VIEW-LASTKEY = 5 OR
              VIEW-LASTKEY = 6 OR
              VIEW-LASTKEY = 7 OR
              VIEW-LASTKEY = 8
      *****    INVALID FUNCTION KEY    *****
               MOVE   9 TO LANG-SETNUM
               MOVE  10 TO LANG-MSGNUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER TO INFO-ERRLINE
               MOVE B"1" TO IND(99)
               GO TO 62-SHOW-FORM.

       62-EDIT-CHECKS.
           MOVE HOME-CURRENCY TO MVALIDUM-ARG, BU-DISPLAY-FLD (1).
           MOVE MVALIDUM-ARG   TO VALIDUM OF MVALIDUM-O-REC.
           START MVALIDUM-O KEY = VALIDUM OF MVALIDUM-O-REC
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS = "00"
      *------- DO A START > HIGH-VALUES TO UNLOCK
              MOVE HIGH-VALUES TO VALIDUM OF MVALIDUM-O-REC
              START MVALIDUM-O KEY > VALIDUM OF MVALIDUM-O-REC
                  INVALID KEY MOVE "00" TO FILE-STATUS
              END-START
           ELSE
           IF FILE-STATUS-1 = "2"
      ****     CURR CODE DOES NOT EXIST   *****
               MOVE   3 TO LANG-SETNUM
               MOVE  70 TO LANG-MSGNUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER TO INFO-ERRLINE
               MOVE B"1" TO IND(99), IND(6)
               GO TO 62-SHOW-FORM
           ELSE
               MOVE "START VALIDUM ERROR IN 62-EDIT-CHECK"
                   TO BU-DISPLAY-MSG
               MOVE HOME-CURRENCY TO BU-DISPLAY-FLD (1)
                   PERFORM 2-BLOWUP.

       62-UPDATE-DATA.
           MOVE "CCHM" TO MPLTINFO-ARG,
                          BU-DISPLAY-FLD (1).
           MOVE MPLTINFO-ARG TO PLTINFOKEY OF MPLTINFO-O-REC.
           READ MPLTINFO-O INTO BUF-MPLTINFO
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS-1 = "2"
               MOVE SPACES         TO BUF-MPLTINFO
               MOVE CURR-CONV-SW   TO MPLTINFO-CUR-CONV-SW
               MOVE HOME-CURRENCY  TO MPLTINFO-HOME-CUR-CODE
               MOVE "CCHM"         TO MPLTINFO-KEY
               WRITE MPLTINFO-O-REC FROM BUF-MPLTINFO
                   INVALID KEY MOVE FILE-STATUS TO FILE-STATUS
               END-WRITE
               IF FILE-STATUS NOT = "00"
                   MOVE "WRITE MPLTINFO ERROR IN 62-UPDATE-DATA"
                       TO BU-DISPLAY-MSG
                   PERFORM 2-BLOWUP
               ELSE
                   NEXT SENTENCE
           ELSE
           IF FILE-STATUS = "00"
               MOVE CURR-CONV-SW   TO MPLTINFO-CUR-CONV-SW
               MOVE HOME-CURRENCY  TO MPLTINFO-HOME-CUR-CODE
               REWRITE MPLTINFO-O-REC FROM BUF-MPLTINFO
                   INVALID KEY MOVE FILE-STATUS TO FILE-STATUS
               END-REWRITE
               IF FILE-STATUS NOT = "00"
                   MOVE "REWRITE MPLTINFO ERROR IN 62-UPDATE-DATA"
                       TO BU-DISPLAY-MSG
                   PERFORM 2-BLOWUP
               ELSE
                   NEXT SENTENCE
           ELSE
               MOVE "READ MPLTINFO ERROR IN 62-UPDATE-DATA"
                   TO BU-DISPLAY-MSG
               PERFORM 2-BLOWUP.

       62-EXCHANGE-QUEST-X.
           EXIT.

       63-EXCHANGE-RATE.
           MOVE SPACES TO EXCHANGE-RATE-SINGLE.
           MOVE ZEROS  TO EXCHANGE-RATE.
           MOVE "CCHM" TO MPLTINFO-ARG.
           MOVE MPLTINFO-ARG TO PLTINFOKEY OF MPLTINFO-O-REC.
           READ MPLTINFO-O INTO BUF-MPLTINFO
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS = "00"
               MOVE MPLTINFO-HOME-CUR-CODE TO MVALIDUM-ARG
           ELSE
           IF FILE-STATUS-1 = "2"
               GO TO 63-EXCHANGE-RATE-X
           ELSE
               MOVE "READ MPLTINFO ERROR IN 63-LOAD-INFO"
                    TO BU-DISPLAY-MSG
               MOVE "CCHM" TO BU-DISPLAY-FLD (1)
               PERFORM 2-BLOWUP.

           MOVE MVALIDUM-ARG TO VALIDUM OF MVALIDUM-O-REC.
           READ MVALIDUM-O INTO BUF-MVALIDUM
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS = "00"
                MOVE VALID-CURRENCY-DESC TO LOCAL-DESC
           ELSE
               MOVE "READ VALIDUM ERROR IN 63-GET-HOME-CODE"
                   TO BU-DISPLAY-MSG
               MOVE MVALIDUM-ARG  TO BU-DISPLAY-FLD (1)
                   PERFORM 2-BLOWUP.


       63-PUT-BUFFER.
      ***  INPUT DATA ABOVE AND PRESS 'ENTER'  ***
           MOVE   9 TO LANG-SETNUM.
           MOVE  20 TO LANG-MSGNUM.
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
           MOVE MESSAGE-BUFFER TO RATE-MSGLINE.

       63-SHOW-FORM.
           MOVE "EXCHANGES" TO VIEW-NFNAME.
           MOVE EXCHANGE-RATE-SINGLE TO DISPLAY-REC.
           PERFORM 998-WRITE-SCREEN THRU 998-READ-SCREEN.
           MOVE DISPLAY-REC          TO EXCHANGE-RATE-SINGLE.
           IF VIEW-LASTKEY = 3
               GO TO 63-EXCHANGE-RATE-X.
           IF VIEW-LASTKEY = 1
               MOVE SPACES TO CGENHELP-PARMS, BU-DISPLAY-MSG
               MOVE "CURRCO" TO CGENHELP-TYPE
               CALL "CGENHELP" USING BU-DISPLAY-AREA,
                                     BU-DISPLAY-MSG,
                                     CGENHELP-PARMS,
                                     VIEW-COMAREA
               IF BU-DISPLAY-MSG NOT = SPACES
                   PERFORM 2-BLOWUP
               END-IF
      *        CALL "SCURHELP" USING BASE,
      *                              VIEW-COMAREA,
      *                              LANGUAGE-PARMS
      *                              WS-EDI-INSTAL
               GO TO 63-SHOW-FORM
           ELSE
           IF VIEW-LASTKEY = 2 OR
              VIEW-LASTKEY = 4 OR
              VIEW-LASTKEY = 5 OR
              VIEW-LASTKEY = 6 OR
              VIEW-LASTKEY = 7 OR
              VIEW-LASTKEY = 8
      *****    INVALID FUNCTION KEY    *****
               MOVE   9 TO LANG-SETNUM
               MOVE  10 TO LANG-MSGNUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER TO RATE-ERRLINE
               MOVE B"1" TO IND(99)
               GO TO 63-SHOW-FORM.

       63-EDIT-CHECKS.
           MOVE FOREIGN-CURRENCY TO MVALIDUM-ARG.
           MOVE MVALIDUM-ARG TO VALIDUM OF MVALIDUM-O-REC.
           READ MVALIDUM-O INTO BUF-MVALIDUM
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS = "00"
                MOVE VALID-CURRENCY-DESC TO FOREIGN-DESC
           ELSE
           IF FILE-STATUS-1 = "2"
      ****     CURR CODE DOES NOT EXIST   *****
               MOVE   3 TO LANG-SETNUM
               MOVE  70 TO LANG-MSGNUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER TO RATE-ERRLINE
               MOVE B"1" TO IND(99), IND(26)
               GO TO 63-SHOW-FORM
           ELSE
               MOVE "READ VALIDUM ERROR IN 63-EDIT-CHECK"
                   TO BU-DISPLAY-MSG
               MOVE FOREIGN-CURRENCY TO BU-DISPLAY-FLD (1)
                   PERFORM 2-BLOWUP.

      *------- DO A START > HIGH-VALUES TO UNLOCK
           MOVE HIGH-VALUES TO VALIDUM OF MVALIDUM-O-REC.
           START MVALIDUM-O KEY = VALIDUM OF MVALIDUM-O-REC
               INVALID KEY MOVE "00" TO FILE-STATUS.

           MOVE FOREIGN-CURRENCY TO CURRENCY-CODE-IN.
           MOVE CURRENCY-CODE-ARG TO MPLTINFO-ARG.
           MOVE MPLTINFO-ARG TO PLTINFOKEY OF MPLTINFO-O-REC.
           READ MPLTINFO-O INTO BUF-MPLTINFO
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS  = "00"
               MOVE MPLTINFO-CC-EXCHANGE-RATE TO EXCHANGE-RATE
               MOVE MPLTINFO-CC-REF-DATE   TO REF-DATE
           ELSE
           IF FILE-STATUS-1 NOT = "2"
               MOVE "READ MPLTINFO ERROR IN 63-EDIT-CHECK"
                   TO BU-DISPLAY-MSG
               MOVE CURRENCY-CODE-ARG TO BU-DISPLAY-FLD (1)
               PERFORM 2-BLOWUP.

      *------- DO A START > HIGH-VALUES TO UNLOCK
           MOVE HIGH-VALUES TO PLTINFOKEY OF MPLTINFO-O-REC.
           START MPLTINFO-O KEY = PLTINFOKEY OF MPLTINFO-O-REC
               INVALID KEY MOVE "00" TO FILE-STATUS.

       63-NEXT-FORM.
           MOVE "EXCHANGES2" TO VIEW-NFNAME.
           MOVE EXCHANGE-RATE-SINGLE TO DISPLAY-REC.
           PERFORM 998-WRITE-SCREEN THRU 998-READ-SCREEN.
           MOVE DISPLAY-REC          TO EXCHANGE-RATE-SINGLE.
           IF VIEW-LASTKEY = 3
               GO TO 63-EXCHANGE-RATE-X.
           IF VIEW-LASTKEY = 7
               GO TO 63-DELETE-RECORD
           ELSE
           IF VIEW-LASTKEY = 1 OR
              VIEW-LASTKEY = 2 OR
              VIEW-LASTKEY = 4 OR
              VIEW-LASTKEY = 5 OR
              VIEW-LASTKEY = 6 OR
              VIEW-LASTKEY = 8
      *****    INVALID FUNCTION KEY    *****
               MOVE   9 TO LANG-SETNUM
               MOVE  10 TO LANG-MSGNUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER TO RATE-ERRLINE
               MOVE B"1" TO IND(99)
               GO TO 63-SHOW-FORM.

       63-UPDATE-RECORD.
           MOVE MPLTINFO-ARG TO BU-DISPLAY-FLD (1).
           MOVE MPLTINFO-ARG TO PLTINFOKEY OF MPLTINFO-O-REC.
           READ MPLTINFO-O INTO BUF-MPLTINFO
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS = "00"
               MOVE EXCHANGE-RATE  TO MPLTINFO-CC-EXCHANGE-RATE
               MOVE TODAY-DATE     TO MPLTINFO-CC-REF-DATE
               REWRITE MPLTINFO-O-REC FROM BUF-MPLTINFO
                   INVALID KEY MOVE FILE-STATUS TO FILE-STATUS
               END-REWRITE
               IF FILE-STATUS NOT = "00"
                   MOVE "REWRITE MPLTINFO ERROR IN 63-UPDATE-DATA"
                       TO BU-DISPLAY-MSG
                   PERFORM 2-BLOWUP
               ELSE
                   NEXT SENTENCE
           ELSE
           IF FILE-STATUS-1 = "2"
               MOVE SPACES         TO BUF-MPLTINFO
               MOVE EXCHANGE-RATE  TO MPLTINFO-CC-EXCHANGE-RATE
               MOVE TODAY-DATE     TO MPLTINFO-CC-REF-DATE
               MOVE MPLTINFO-ARG   TO MPLTINFO-KEY
               WRITE MPLTINFO-O-REC FROM BUF-MPLTINFO
                   INVALID KEY MOVE FILE-STATUS TO FILE-STATUS
               END-WRITE
               IF FILE-STATUS NOT = "00"
                   MOVE "WRITE MPLTINFO ERROR IN 63-UPDATE-DATA"
                       TO BU-DISPLAY-MSG
                   PERFORM 2-BLOWUP
               ELSE
                   NEXT SENTENCE
           ELSE
               MOVE "READ MPLTINFO ERROR IN 63-UPDATE-DATA"
                   TO  BU-DISPLAY-MSG
               PERFORM 2-BLOWUP.

           GO TO 63-EXCHANGE-RATE.

       63-DELETE-RECORD.
           MOVE MPLTINFO-ARG TO PLTINFOKEY OF MPLTINFO-O-REC.
           READ MPLTINFO-O INTO BUF-MPLTINFO
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS-1 = "2"
                GO TO 63-EXCHANGE-RATE
           ELSE
           IF FILE-STATUS NOT = "00"
                MOVE "READ MPLTINFO ERROR IN 63-DELETE-RECORD"
                    TO BU-DISPLAY-MSG
                MOVE CURRENCY-CODE-ARG TO BU-DISPLAY-FLD (1)
                PERFORM 2-BLOWUP.
           DELETE MPLTINFO-O
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
                MOVE "DELETE MPLTINFO ERROR IN 63-DELETE-RECORD"
                    TO BU-DISPLAY-MSG
                MOVE CURRENCY-CODE-ARG TO BU-DISPLAY-FLD (1)
                PERFORM 2-BLOWUP.
           GO TO 63-EXCHANGE-RATE.

       63-EXCHANGE-RATE-X.
           EXIT.


       64-EXCHANGE-TBL.
           MOVE 1 TO CODE-CTR.
           MOVE 0 TO NUMBER-OF-CODES, BUF-NO.
           MOVE CLEAR-OUT-AREA2          TO EXCHANGE-RATE-AREA-CLEAR.
           SET X  TO 1.
           SET Y  TO 1.

       64-GET-HOME-CODE.
           MOVE "CCHM" TO MPLTINFO-ARG.
           MOVE MPLTINFO-ARG TO PLTINFOKEY OF MPLTINFO-O-REC.
           READ MPLTINFO-O INTO BUF-MPLTINFO
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS = "00"
               MOVE MPLTINFO-HOME-CUR-CODE TO MVALIDUM-ARG
           ELSE
           IF FILE-STATUS-1 = "2"
               GO TO 64-EXCHANGE-TBL-X
           ELSE
               MOVE "READ MPLTINFO ERROR IN 64-LOAD-INFO"
                    TO BU-DISPLAY-MSG
               MOVE "CCHM" TO BU-DISPLAY-FLD (1)
               PERFORM 2-BLOWUP.

           MOVE MVALIDUM-ARG TO VALIDUM OF MVALIDUM-O-REC.
           READ MVALIDUM-O INTO BUF-MVALIDUM
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS = "00"
                MOVE VALID-CURRENCY-DESC TO LOCAL-DESC-WS
           ELSE
               MOVE "READ VALIDUM ERROR IN 64-GET-HOME-CODE"
                   TO BU-DISPLAY-MSG
               MOVE MVALIDUM-ARG  TO BU-DISPLAY-FLD (1)
                   PERFORM 2-BLOWUP.

       64-LOAD-TBL.
           MOVE CODE-CTR          TO CURRENCY-CODE-IN.
           MOVE CURRENCY-CODE-ARG TO MPLTINFO-ARG.
           MOVE MPLTINFO-ARG TO PLTINFOKEY OF MPLTINFO-O-REC
           READ MPLTINFO-O INTO BUF-MPLTINFO
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS = "00"
               MOVE MPLTINFO-CC-EXCHANGE-RATE TO EXCHANGE-RATE-WS (Y)
               MOVE MPLTINFO-CC-REF-DATE      TO REF-DATE-WS (Y)
           ELSE
           IF FILE-STATUS-1 = "2"
                IF CODE-CTR = 60
                    IF NUMBER-OF-CODES = 0
                        GO TO 64-EXCHANGE-TBL-X
                    ELSE
                        MOVE CLEAR-OUT-AREA TO EXCHANGE-RATE-MULTI-DATA
                        SET X TO 1
                        SET Y TO 1
                        GO TO 64-LOAD-BUFFER
                ELSE
                    ADD 1 TO CODE-CTR
                    GO TO 64-LOAD-TBL
           ELSE
               MOVE "READ MPLTINFO ERROR IN 64-LOAD-INFO"
                    TO BU-DISPLAY-MSG
               MOVE "CCHM" TO BU-DISPLAY-FLD (1)
               PERFORM 2-BLOWUP.


           MOVE CODE-CTR TO MVALIDUM-ARG.
           MOVE MVALIDUM-ARG TO VALIDUM OF MVALIDUM-O-REC.
           READ MVALIDUM-O INTO BUF-MVALIDUM
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS  = "00"
                MOVE VALID-UM            TO FOREIGN-CODE-WS (Y)
                MOVE VALID-CURRENCY-DESC TO FOREIGN-DESC-WS (Y)
           ELSE
               MOVE "READ VALIDUM ERROR IN 64-GET-HOME-CODE"
                   TO BU-DISPLAY-MSG
               MOVE MVALIDUM-ARG  TO BU-DISPLAY-FLD (1)
                   PERFORM 2-BLOWUP.

           IF CODE-CTR = 60
               MOVE CLEAR-OUT-AREA TO EXCHANGE-RATE-MULTI-DATA
               SET X TO 1
               SET Y TO 1
               GO TO 64-LOAD-BUFFER
           ELSE
               SET Y UP BY 1
               ADD 1 TO CODE-CTR
               ADD 1 TO NUMBER-OF-CODES
               GO  TO 64-LOAD-TBL.

       64-LOAD-BUFFER.
           MOVE LOCAL-DESC-WS        TO LOCAL-DESC-TBL (X).
           MOVE "ONE"                TO LOCAL-UNIT (X).
           MOVE EXCHANGE-RATE-WS (Y) TO EXCHANGE-RATE-TBL (X).
           MOVE FOREIGN-CODE-WS (Y)  TO FOREIGN-CODE-TBL (X).
           MOVE FOREIGN-DESC-WS (Y)  TO FOREIGN-DESC-TBL (X).
           MOVE REF-DATE-WS (Y)      TO REF-DATE-TBL (X).
           SET Y UP BY 1.
           SET X UP BY 1.
           IF BUF-NO = 1
               IF X > 15  OR   X > NUMBER-OF-CODES - 15
                   ADD 1 TO BUF-NO
                   GO TO 64-PUT-BUFFER
               ELSE
                   GO TO 64-LOAD-BUFFER
           ELSE
           IF BUF-NO = 2
               IF X > 15   OR  X > NUMBER-OF-CODES - 30
                   ADD 1 TO BUF-NO
                   GO TO 64-PUT-BUFFER
               ELSE
                   GO TO 64-LOAD-BUFFER
           ELSE
           IF BUF-NO = 3
               IF X > 15   OR  X > NUMBER-OF-CODES - 45
                   ADD 1 TO BUF-NO
                   GO TO 64-PUT-BUFFER
               ELSE
               GO TO 64-LOAD-BUFFER.

           IF X > 15 OR X > NUMBER-OF-CODES
                ADD 1 TO BUF-NO
                GO TO 64-PUT-BUFFER
            ELSE
                GO TO 64-LOAD-BUFFER.

      *------- DO A START > HIGH-VALUES TO UNLOCK
           MOVE HIGH-VALUES TO PLTINFOKEY OF MPLTINFO-O-REC.
           MOVE HIGH-VALUES TO VALIDUM    OF MVALIDUM-O-REC.
           START MPLTINFO-O KEY > PLTINFOKEY OF MPLTINFO-O-REC
               INVALID KEY MOVE "00" TO FILE-STATUS.
           START MVALIDUM-O KEY > VALIDUM OF MVALIDUM-O-REC
               INVALID KEY MOVE "00" TO FILE-STATUS.

       64-PUT-BUFFER.
      ***  INPUT DATA ABOVE AND PRESS 'ENTER'  ***
           MOVE   9 TO LANG-SETNUM.
           MOVE  20 TO LANG-MSGNUM.
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
           MOVE MESSAGE-BUFFER TO TBL-MSGLINE.

       64-SHOW-FORM.
           MOVE "EXCHANGEM" TO VIEW-NFNAME.
           MOVE EXCHANGE-RATE-MULTI-TBL TO DISPLAY-REC.
           PERFORM 998-WRITE-SCREEN THRU 998-READ-SCREEN.
           MOVE DISPLAY-REC             TO EXCHANGE-RATE-MULTI-TBL.
           IF VIEW-LASTKEY = 3
               GO TO 64-EXCHANGE-TBL-X.
           IF VIEW-LASTKEY = 1
               IF (BUF-NO = 1 AND NUMBER-OF-CODES > 15)  OR
                  (BUF-NO = 2 AND NUMBER-OF-CODES > 30)  OR
                  (BUF-NO = 3 AND NUMBER-OF-CODES > 45)
                   SET X TO 1
                   MOVE SPACES         TO EXCHANGE-RATE-MULTI-TBL
                   MOVE CLEAR-OUT-AREA TO EXCHANGE-RATE-MULTI-DATA
                   GO TO 64-LOAD-BUFFER
               ELSE
      ****  NO OTHER CODES WERE FOUND ****
                   MOVE  14 TO LANG-SETNUM
                   MOVE 100 TO LANG-MSGNUM
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE MESSAGE-BUFFER TO TBL-ERRLINE
                   MOVE B"1" TO IND(99)
                   GO TO 64-SHOW-FORM
           ELSE
           IF VIEW-LASTKEY = 2 OR
              VIEW-LASTKEY = 4 OR
              VIEW-LASTKEY = 5 OR
              VIEW-LASTKEY = 6 OR
              VIEW-LASTKEY = 7 OR
              VIEW-LASTKEY = 8
      *****    INVALID FUNCTION KEY    *****
               MOVE   9 TO LANG-SETNUM
               MOVE  10 TO LANG-MSGNUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER TO TBL-ERRLINE
               MOVE B"1" TO IND(99)
               GO TO 64-SHOW-FORM.

           PERFORM 64-UPDATE-MPLTINFO.
           IF BUF-NO = 1 AND NUMBER-OF-CODES > 15 OR
              BUF-NO = 2 AND NUMBER-OF-CODES > 30 OR
              BUF-NO = 3 AND NUMBER-OF-CODES > 45
               SET X TO 1
               MOVE SPACES         TO EXCHANGE-RATE-MULTI-TBL
               MOVE CLEAR-OUT-AREA TO EXCHANGE-RATE-MULTI-DATA
               GO TO 64-LOAD-BUFFER
           ELSE
      ****  NO OTHER CODES WERE FOUND ****
               MOVE  14 TO LANG-SETNUM
               MOVE 100 TO LANG-MSGNUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER TO TBL-ERRLINE
               MOVE B"1" TO IND(99)
               GO TO 64-SHOW-FORM.


           GO TO 64-EXCHANGE-TBL.

       64-EXCHANGE-TBL-X.
           EXIT.

       64-UPDATE-MPLTINFO.
           SET X TO 1.
           PERFORM 641-GET-TBL THRU 641-GET-TBL-X
                    UNTIL X > 15 OR X > NUMBER-OF-CODES.

       641-GET-TBL.
           IF FOREIGN-CODE-TBL (X) > "00"
                MOVE FOREIGN-CODE-TBL (X) TO CURRENCY-CODE-IN
           ELSE
                SET X UP BY 15
                GO TO 641-GET-TBL-X.

           MOVE CURRENCY-CODE-ARG TO MPLTINFO-ARG.
           MOVE MPLTINFO-ARG TO PLTINFOKEY OF MPLTINFO-O-REC.
           READ MPLTINFO-O INTO BUF-MPLTINFO
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE "READ MPLTINFO ERROR IN 641-GET-TBL"
                    TO BU-DISPLAY-MSG
               MOVE CURRENCY-CODE-ARG TO BU-DISPLAY-FLD (1)
               PERFORM 2-BLOWUP.

           MOVE EXCHANGE-RATE-TBL (X) TO MPLTINFO-CC-EXCHANGE-RATE.
           MOVE TODAY-DATE          TO MPLTINFO-CC-REF-DATE.
           MOVE MPLTINFO-ARG   TO BU-DISPLAY-FLD (1).

           REWRITE MPLTINFO-O-REC FROM BUF-MPLTINFO
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE "REWRITE MPLTINFO ERROR IN 63-UPDATE-DATA"
                   TO BU-DISPLAY-MSG
               PERFORM 2-BLOWUP.

           SET X UP BY 1.

       641-GET-TBL-X.
           EXIT.

       COPY DISPCALL IN COPYLIB.
      *********************************************************
       999-CATREAD.
           IF CATREAD-MSG-NUMBER = ZEROS
               MOVE LANG-SETNUM TO CATREAD-MSG-SET
               MOVE LANG-MSGNUM TO CATREAD-MSG-NUM.
           CALL "CCATREAD" USING CATREAD-PARMS.
           MOVE CATREAD-MSG-TEXT TO MESSAGE-BUFFER.
       999-CATREAD-EXIT.
           EXIT.
