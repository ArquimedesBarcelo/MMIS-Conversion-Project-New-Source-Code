       IDENTIFICATION DIVISION.
       PROGRAM-ID.    SEASETPH.
       AUTHOR.        C HILLES/JIM COFFMAN (MAINTAINER).
       DATE-WRITTEN.  7/1/87.
       DATE-COMPILED.
      *INSTALLATION.  GOODYEAR TIRE AND RUBBER - AKRON.
      *SECURITY.
      *REMARKS.
      *D   ELECTRONIC APPROVAL SYSTEM - PATH SETUP PROGRAM.
      *D   THIS PROGRAM DEFINES THE FOLLOWING:
      *D       1.  THE TYPE OF REQ THAT USES THIS PATH
      *D       2.  THE APPROVAL LEVEL PATH THE REQ FOLLOWS
      *
      *C   03/27/2003   CA YODER   LAWTON REQUEST
      *C     IN DELETE PATH OPTION, MESSAGE TO CONFIRM DELETE NOT
      *C     WORKING PROPERLY.  CORRECTED LOGIC.
      *C

       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.
       SOURCE-COMPUTER.  HP-3000.
       OBJECT-COMPUTER.  HP-3000.
       SPECIAL-NAMES. I-O-FEEDBACK IS I-O-FEEDBACK-AREA.

       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT DISPLAY-FILE
                  ASSIGN TO WORKSTATION-ZEASETUP-SI
                  ORGANIZATION IS TRANSACTION
                  ACCESS IS SEQUENTIAL
                  FILE STATUS IS DISPLAY-STATUS
                  CONTROL-AREA IS WS-CONTROL.

           SELECT MPATH-O
                  ASSIGN TO DATABASE-MCFLCS3901
                  ORGANIZATION IS INDEXED
                    ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                  FILE STATUS IS FILE-STATUS.

           SELECT MLEVEL-I
                  ASSIGN TO DATABASE-MCFLCS4101
                  ORGANIZATION IS INDEXED
                    ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                  FILE STATUS IS FILE-STATUS.

           SELECT DPATHDEF-O
                  ASSIGN TO DATABASE-MCFLCS4001
                  ORGANIZATION IS INDEXED
                    ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                    WITH DUPLICATES
                  FILE STATUS IS FILE-STATUS.


       DATA DIVISION.
       FILE SECTION.
       FD  DISPLAY-FILE
           LABEL RECORDS ARE OMITTED.
       01  DISPLAY-REC                   PIC X(1500).

       FD  MPATH-O
           LABEL RECORDS ARE STANDARD.
       01  MPATH-REC-O.
           COPY DDS-MCRPCS3900  OF MCFLCS3901.

       FD  MLEVEL-I
           LABEL RECORDS ARE STANDARD.
       01  MLEVEL-REC-I.
           COPY DDS-MCRPCS4100  OF MCFLCS4101.

       FD  DPATHDEF-O
           LABEL RECORDS ARE STANDARD.
       01  DPATHDEF-REC-O.
           COPY DDS-MCRPCS4000  OF MCFLCS4001.

       WORKING-STORAGE SECTION.

       77  MOD-DEL-FLAG                  PIC X(1).
       77  SUB                           PIC S9(4) COMP-4 VALUE 0.
       77  SUB2                          PIC S9(4) COMP-4 VALUE 0.
       77  TABLE-LIMIT                   PIC S9(4) COMP-4 VALUE 0.
       77  SAVE-LAST-PATH                PIC 9(3)  VALUE 0.
       77  CUR-PATH                      PIC 9(3)  VALUE 0.
      *------ TO SAVE ACTIVE EMPL FOUND DURING EDIT FOR LATER ADD TO
      *------ MPATH.
       01  SAVE-ACTIVE-EMPLS.
           05  SAVE-ACTIVE-EMPL OCCURS 10 TIMES PIC X(4).

      **************************************************************
      **                                                          **
      **                S U B P R O G R A M   A R E A S           **
      **                                                          **
      **************************************************************

       COPY TDATECHK   IN COPYLIB.
       COPY TBLOWUP    IN COPYLIB.
       COPY DISPDAT2   IN COPYLIB.
       COPY IOFEEDBACK IN COPYLIB.
       COPY CATREAD    IN COPYLIB.
       COPY CBUDNUM    IN COPYLIB.
       COPY TRSHIFT    IN COPYLIB.
       01  RS-SHIFT-14                   PIC X(14).
       COPY CSWITCHF   IN COPYLIB.
       01  FORMFILE                      PIC X(31) VALUE "FEASETUP".

      **************************************************************
      **                                                          **
      **                  V I E W   W O R K                       **
      **                                                          **
      **************************************************************
       COPY FUNCTDEF IN COPYLIB.

      **  SEE LINKAGE SECTION FOR VIEW-COMAREA

       01  MESSAGE-BUFFER.
           05  MSG-TEXT.
               10  MESSAGE-BUFFER-1      PIC X(1)  VALUE SPACES.
               10  FILLER                PIC X(67) VALUE SPACES.
           05  MSG-FLD                   PIC X(8)  VALUE SPACES.
           05  MSG-FLD-9 REDEFINES MSG-FLD PIC ZZZZZZZ9.

       01  FIELD-NUMBER                  PIC S9(4) COMP VALUE 1.

      **************************************************************
      **                                                          **
      **            D A T A B A S E   W O R K                     **
      **                                                          **
      **************************************************************
       01  FILE-STATUS.
           05  FILE-STATUS-1             PIC X  VALUE "0".
           05  FILE-STATUS-2             PIC X  VALUE "0".

       COPY DBSTAT     IN COPYLIB.
       01  DSET-NAMES.
           05  DSET-MLEVEL               PIC X(16) VALUE "MLEVEL;".
           05  DSET-DLEVEL               PIC X(16) VALUE "DLEVEL;".
           05  DSET-MPATH                PIC X(16) VALUE "MPATH;".
           05  DSET-DPATHDEF             PIC X(16) VALUE "DPATHDEF;".
           05  DSET-MEMPL                PIC X(16) VALUE "MEMPL;".

       01  MODE-AREA.
           05  DB-MODE                   PIC S9(4)   COMP       VALUE 0.
           05  MODE1                     PIC S9(4)   COMP       VALUE 1.
           05  MODE3                     PIC S9(4)   COMP       VALUE 3.
           05  MODE4                     PIC S9(4)   COMP       VALUE 4.
           05  MODE5                     PIC S9(4)   COMP       VALUE 5.
           05  MODE7                     PIC S9(4)   COMP       VALUE 7.

       01  ALL-ITEMS                     PIC X(2)  VALUE "@;".
       01  LEVEL-SEARCH                  PIC X(10) VALUE "LEVEL-NUM;".
       01  LEVEL-ARG                     PIC X(2).
       01  PATH-SEARCH                   PIC X(16) VALUE "PATH-NUM;".
       01  PATH-ARG.
           05  PATH-ARG-PREFIX           PIC X(1)  VALUE "R".
           05  PATH-ARG-NUMBER           PIC 9(3).
       01  NEW-PATH-ARG.
           05  NEW-PATH-ARG-PREFIX       PIC X(1)  VALUE "R".
           05  NEW-PATH-ARG-NUMBER       PIC 9(3).
       01  OLD-PATH-ARG.
           05  OLD-PATH-ARG-PREFIX       PIC X(1)  VALUE "R".
           05  OLD-PATH-ARG-NUMBER       PIC 9(3).
       01  EMPL-ARG                      PIC X(4).

      *------ TABLE FOR STORING ALL PATHDEFS FOR A PATH WHEN MODIFYING
      *------ THEM: SINCE KEY VALUES ARE MODIFIED IN THE DETAIL, THEY
      *------ HAVED TO BE DELETED AND RE-ADDED
       01  PATHDEF-TABLE.
           05  PATHDEF-LINE OCCURS 999 TIMES.
               10  PT-INCL-EXCL-FLAG     PIC X(1).
               10  PT-TYPE               PIC X(1).
               10  PT-LOW-VALUE          PIC X(14).
               10  PT-HIGH-VALUE         PIC X(14).
               10  PT-LEVEL              PIC X(2).
               10  PT-I-S                PIC X(1).
               10  PT-O-E                PIC X(1).

      **************************************************************
      **                                                          **
      **           D A T A B A S E   B U F F E R S                **
      **                                                          **
      **************************************************************

       COPY MLEVEL     IN COPYLIB.
       COPY MPATH      IN COPYLIB.
       COPY DPATHDEF   IN COPYLIB.
       COPY MEMPL      IN COPYLIB.
       COPY DLEVEL     IN COPYLIB.

      **************************************************************
      **                                                          **
      **                  S C R E E N   D A T A                   **
      **                                                          **
      **************************************************************

       01  DE-FIELDS-A.
           05  DE-PATH.
               10  DE-PATH-PREFIX        PIC X(1).
               10  DE-PATH-NUMBER        PIC X(3).
           05  DE-PATH-DESC              PIC X(30).
           05  DE-MIN-VAL                PIC X(14).
           05  DE-MAX-VAL                PIC X(14).
           05  DE-WO-APPROVE             PIC X(1).
           05  DE-PRINT-OPTION           PIC X(1).
           05  DE-CATEGORY               PIC X(1).
           05  DE-PATH-LEVELS OCCURS 10 TIMES.
               10  DE-PATH-LEVEL         PIC X(2).
               10  DE-INORD-SIMEL        PIC X(1).
               10  V-LEVEL-DESC          PIC X(36).
           05  DE-COMMAND-LINE-A         PIC X(79).
           05  DE-MESSAGE-LINE-A         PIC X(79).

       01  DE-FIELDS-B.
           05  V-PATH.
               10  V-PATH-PREFIX         PIC X(1).
               10  V-PATH-NUMBER         PIC X(3).
           05  V-PATH-DESC               PIC X(30).
           05  DE-INCL-EXCL-FLAG         PIC X(1).
           05  DE-TYPE                   PIC X(1).
           05  DE-LOW-VALUE              PIC X(14).
           05  DE-HIGH-VALUE             PIC X(14).
           05  DE-ODD-EVEN-FLAG          PIC X(1).
           05  DE-ADD-LEVEL              PIC X(2).
           05  DE-ADD-I-S                PIC X(1).
           05  DE-COMMAND-LINE-B         PIC X(79).
           05  DE-MESSAGE-LINE-B         PIC X(79).

       01  DE-FIELDS-C.
           05  DE-DOWN-UP                PIC X(4).
           05  DE-SHIFT-PATH.
               10  DE-SHIFT-PREFIX       PIC X(1).
               10  DE-SHIFT-START        PIC 9(3).
           05  DE-COMMAND-LINE-C         PIC X(79).
           05  DE-MESSAGE-LINE-C         PIC X(79).

       01  DE-FIELDS-D.
           05  DE-OLD-PATH.
               10  DE-OLD-PATH-PREFIX    PIC X(1).
               10  DE-OLD-PATH-NUMBER    PIC 9(3).
           05  DE-NEW-PATH.
               10  DE-NEW-PATH-PREFIX    PIC X(1).
               10  DE-NEW-PATH-NUMBER    PIC 9(3).
           05  DE-COMMAND-LINE-D         PIC X(79).
           05  DE-MESSAGE-LINE-D         PIC X(79).

      **************************************************************
      **                                                          **
      **            L I N K A G E   S E C T I O N                 **
      **                                                          **
      **************************************************************

       LINKAGE SECTION.
       01  BASE                          PIC X(10).
       01  MMIS-BASE                     PIC X(13).

       COPY VCOMLINK   IN COPYLIB.
       COPY TSHWSUB2   IN COPYLIB.
       COPY LANGSUB    IN COPYLIB.

       PROCEDURE DIVISION USING BASE
                                MMIS-BASE,
                                VIEW-COMAREA,
                                SRF-COMAREA,
                                LANGUAGE-PARMS.

       1-HSK.
           MOVE 0 TO SUB, SUB2, TABLE-LIMIT, SAVE-LAST-PATH,
             CUR-PATH.
           OPEN I-O DISPLAY-FILE, MPATH-O, DPATHDEF-O.
           OPEN INPUT MLEVEL-I.
           PERFORM 6000-MAIN THRU 6990-MAIN-X.
           CLOSE DISPLAY-FILE, MPATH-O, DPATHDEF-O, MLEVEL-I.
           GOBACK.

       2100-BLOWUP.
           MOVE "SEASETPH"               TO  BU-PGM-NAME.
           CALL "TBLOWUP" USING BASE BU-PGM-NAME STATUS-AREA
             VIEW-COMAREA FILE-STATUS BU-DISPLAY-MSG
             BU-DISPLAY-FLDS.

       4015-SET-ERROR.
           MOVE B"1"                     TO  IND (99).
           MOVE B"1"                     TO  IND (FIELD-NUMBER).
           MOVE MESSAGE-BUFFER TO DE-MESSAGE-LINE-A, DE-MESSAGE-LINE-B,
             DE-MESSAGE-LINE-C, DE-MESSAGE-LINE-D.
           MOVE SPACES TO MESSAGE-BUFFER.

       4017-VALUE-ERR.
           MOVE 20                       TO  LANG-SETNUM.
           MOVE 64                       TO  LANG-MSGNUM.
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
           PERFORM 4015-SET-ERROR.

       4020-CLEAR-FORM-A.
           MOVE SPACES                   TO  MESSAGE-BUFFER.
           MOVE SPACES                   TO  DE-FIELDS-A.
           MOVE "000"                    TO  DE-PATH-NUMBER.
           MOVE "00000000000000"         TO  DE-MIN-VAL, DE-MAX-VAL.
     *     MOVE "00" TO DE-PATH-LEVEL (1), DE-PATH-LEVEL (2),
     *       DE-PATH-LEVEL (3), DE-PATH-LEVEL (4), DE-PATH-LEVEL (5),
     *       DE-PATH-LEVEL (6), DE-PATH-LEVEL (7), DE-PATH-LEVEL (8),
     *       DE-PATH-LEVEL (9), DE-PATH-LEVEL (10).
           MOVE "R"                      TO  DE-PATH-PREFIX.

       4025-CLEAR-FORM-B.
           MOVE SPACES                   TO  MESSAGE-BUFFER.
           MOVE SPACES                   TO  DE-FIELDS-B.
           MOVE "000"                    TO  V-PATH-NUMBER.
           MOVE "00"                     TO  DE-ADD-LEVEL.

      ******************************************************************
      **                                                              **
      **          P A T H     M A I N   M E N U                       **
      **                                                              **
      ******************************************************************
       6000-MAIN.
           MOVE "EAPATHMENU"             TO  VIEW-NFNAME.
           PERFORM 4020-CLEAR-FORM-A.

      *----- f1,f2,f3,f4,f8 APPL,f5 PRT SCR,f6,f7 INVALID,ENTER INVALID
           MOVE 0                        TO  SRF-KEYSET.
           MOVE "N"                      TO  SRF-ENTER-FLAG.
       6010-SHOWFORM.
           MOVE DE-FIELDS-A              TO  DISPLAY-REC.
           PERFORM 998-WRITE-SCREEN THRU 998-READ-SCREEN.
           MOVE DISPLAY-REC              TO  DE-FIELDS-A.
           IF MESSAGE-BUFFER-1 NOT = SPACES
               PERFORM 4015-SET-ERROR
               GO TO 6010-SHOWFORM.

           IF BU-DISPLAY-MSG-1 NOT = SPACES
               PERFORM 2100-BLOWUP.

           IF VIEW-LASTKEY = 3
               GO TO 6990-MAIN-X.

           IF VIEW-LASTKEY = 1
               PERFORM 6300-ADD THRU 6390-A-X
           ELSE
           IF VIEW-LASTKEY = 2
               MOVE "M"                  TO  MOD-DEL-FLAG
               PERFORM 6500-MOD-DEL THRU 6590-MD-X
           ELSE
           IF VIEW-LASTKEY = 4
               PERFORM 6700-PATH-INQUIRY-1 THRU 6710-PI1-X
           ELSE
           IF VIEW-LASTKEY = 5
               PERFORM 6900-COPY-PATHS THRU 6980-CP-X
           ELSE
           IF VIEW-LASTKEY = 6
               PERFORM 6720-PATH-INQUIRY-2 THRU 6730-PI2-X
           ELSE
           IF VIEW-LASTKEY = 7
               PERFORM 6800-SHIFT-PATHS THRU 6890-SP-X
           ELSE
           IF VIEW-LASTKEY = 8
               MOVE "D"                  TO  MOD-DEL-FLAG
               PERFORM 6500-MOD-DEL THRU 6590-MD-X.

           GO TO 6000-MAIN.

      ******************************************************************
      **                                                              **
      **       A D D   P A T H                                        **
      **                                                              **
      ******************************************************************
       6300-ADD.
           MOVE "EAPATHADDA"             TO  VIEW-NFNAME.
           PERFORM 4020-CLEAR-FORM-A.

       6310-SHOW-ADD-FORM.
           MOVE 7                        TO  SRF-KEYSET.
       6310-SHOWFORM.
           MOVE DE-FIELDS-A              TO  DISPLAY-REC.
           PERFORM 998-WRITE-SCREEN THRU 998-READ-SCREEN.
           MOVE DISPLAY-REC              TO  DE-FIELDS-A.
           IF MESSAGE-BUFFER-1 NOT = SPACES
               PERFORM 4015-SET-ERROR
               GO TO 6310-SHOWFORM.

           IF VIEW-LASTKEY = 3
               GO TO 6390-A-X.

      *------ YOU CANT SKIP A PATH.  THE 'DETERMINE PATH' SUBPROGRAM
      *------ SEARCHES SEQUENTIALLY STARTING WITH PATH 01.
           IF DE-PATH-NUMBER = "001" OR "999"
               NEXT SENTENCE
           ELSE
               MOVE DE-PATH              TO  PATH-ARG
               SUBTRACT 1                FROM PATH-ARG-NUMBER
               PERFORM 7000-GET-MPATH
               IF FILE-STATUS NOT = "00"
      *            "C172: CAN'T SKIP PATH"
                   MOVE   3              TO  LANG-SETNUM
                   MOVE 172              TO  LANG-MSGNUM
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE 1                TO  FIELD-NUMBER
                   PERFORM 4015-SET-ERROR
                   GO TO 6310-SHOW-ADD-FORM.

           PERFORM 7010-UNLOCK-MPATH.

           MOVE DE-PATH                  TO  PATH-ARG.
           PERFORM 7000-GET-MPATH.
           IF FILE-STATUS = "00"
               PERFORM 7010-UNLOCK-MPATH
      *        "E44: ENTRY ALREADY EXISTS"
               MOVE   5                  TO  LANG-SETNUM
               MOVE  44                  TO  LANG-MSGNUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE 1                    TO  FIELD-NUMBER
               PERFORM 4015-SET-ERROR
               GO TO 6310-SHOW-ADD-FORM.

      *------ NOW EDIT EACH OF THE 10 POSSIBLE PATHS
           MOVE 0                        TO  SUB.
           MOVE SPACES                   TO  MESSAGE-BUFFER.
           PERFORM 8000-EDIT-LEVELS THRU 8010-EL-X UNTIL SUB > 9 OR
             (MESSAGE-BUFFER-1 NOT = SPACES).
           IF MESSAGE-BUFFER-1 NOT = SPACES
               GO TO 6310-SHOW-ADD-FORM.

           PERFORM 7030-MOVE-TO-DB-A.

      *------ LOAD EACH OF THE LEVELS FROM SCRN1 TO PATH
           PERFORM 7060-ADD-PATH-LEVELS THRU 7069-APL-X.
           IF MESSAGE-BUFFER-1 NOT = SPACES
               GO TO 6310-SHOW-ADD-FORM.

      *    CALL "DBPUT" USING BASE, DSET-MPATH, MODE1, STATUS-AREA,
      *      ALL-ITEMS, BUF-MPATH.
           WRITE MPATH-REC-O FROM BUF-MPATH
               INVALID KEY MOVE 99       TO  COND-WORD.
           IF FILE-STATUS NOT = "00"
               MOVE "DBPUT ERR MLEVEL 6110-SAF" TO BU-DISPLAY-MSG
               PERFORM 2100-BLOWUP.

           MOVE "EAPATHADDB"             TO  VIEW-NFNAME.
           PERFORM 6400-ADD-PATH-DEF THRU 6490-APD-X.

           GO TO 6300-ADD.

       6390-A-X.
           EXIT.

       6400-ADD-PATH-DEF.
           PERFORM 4025-CLEAR-FORM-B.
           MOVE DE-PATH                  TO  V-PATH.
           MOVE DE-PATH-DESC             TO  V-PATH-DESC.

       6410-SHOW-PATHDEF-FORM.
           MOVE 7                        TO  SRF-KEYSET.
       6410-SHOWFORM.
           MOVE DE-FIELDS-B              TO  DISPLAY-REC.
           PERFORM 998-WRITE-SCREEN THRU 998-READ-SCREEN.
           MOVE DISPLAY-REC              TO  DE-FIELDS-B.
           IF MESSAGE-BUFFER-1 NOT = SPACES
               PERFORM 4015-SET-ERROR
               GO TO 6410-SHOWFORM.

           IF VIEW-LASTKEY = 3
               GO TO 6490-APD-X.

           MOVE SPACES                   TO  MESSAGE-BUFFER-1.
           PERFORM 7037-FORMAT-STUFF THRU 7038-FS-X.
           IF MESSAGE-BUFFER-1 NOT = SPACES
               GO TO 6410-SHOWFORM.

           MOVE PATH-ARG                 TO  DPATHD-PATH-NUMBER.
           PERFORM 7035-MOVE-TO-DB-B.

      *    CALL "DBPUT" USING BASE, DSET-DPATHDEF, MODE1, STATUS-AREA,
      *      ALL-ITEMS, BUF-DPATHDEF.
           WRITE DPATHDEF-REC-O FROM BUF-DPATHDEF
               INVALID KEY MOVE 99       TO  COND-WORD.
           IF FILE-STATUS NOT = "00"
               MOVE "DBPUT ERR DPATHDEF 6400-APD" TO BU-DISPLAY-MSG
               PERFORM 2100-BLOWUP.

           GO TO 6400-ADD-PATH-DEF.

       6490-APD-X.
           EXIT.

      ******************************************************************
      **                                                              **
      **      M O D I F Y / D E L E T E   P A T H                     **
      **                                                              **
      ******************************************************************
       6500-MOD-DEL.
      *------ GET THE FATHER FORM FOR MODIFY OR DELETE
           IF MOD-DEL-FLAG = "M"
               MOVE "EAPATHMODA"         TO  VIEW-NFNAME
           ELSE
               MOVE "EAPATHDELA"         TO  VIEW-NFNAME.

       6505-MOD-DEL-GETFORM-1.
           IF MOD-DEL-FLAG = "M"
               MOVE "EAPATHMOD2"         TO  VIEW-NFNAME
           ELSE
               MOVE "EAPATHDEL2"         TO  VIEW-NFNAME.
           PERFORM 4020-CLEAR-FORM-A.

       6510-SHOW-MOD-FORM-1.
           MOVE 7                        TO  SRF-KEYSET.
       6510-SHOWFORM.
           MOVE DE-FIELDS-A              TO  DISPLAY-REC.
           PERFORM 998-WRITE-SCREEN THRU 998-READ-SCREEN.
           MOVE DISPLAY-REC              TO  DE-FIELDS-A.
           IF MESSAGE-BUFFER-1 NOT = SPACES
               PERFORM 4015-SET-ERROR
               GO TO 6010-SHOWFORM.

           IF VIEW-LASTKEY = 3
               GO TO 6590-MD-X.

           MOVE DE-PATH                  TO  PATH-ARG.
           PERFORM 7000-GET-MPATH.
           IF FILE-STATUS NOT = "00"
      *        "E45: ENTRY DOES NOT EXIST"
               MOVE  5                   TO  LANG-SETNUM
               MOVE 45                   TO  LANG-MSGNUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE 1                    TO  FIELD-NUMBER
               PERFORM 4015-SET-ERROR
               GO TO 6510-SHOW-MOD-FORM-1.

           PERFORM 7010-UNLOCK-MPATH.

           IF MOD-DEL-FLAG = "M"
               MOVE "EAPATHMOD3"         TO  VIEW-NFNAME
           ELSE
               MOVE "EAPATHDEL3"         TO  VIEW-NFNAME.

           MOVE MPATH-PATH-DESC          TO  DE-PATH-DESC.
           MOVE MPATH-MIN-VAL            TO  DE-MIN-VAL.
           MOVE MPATH-MAX-VAL            TO  DE-MAX-VAL.
           MOVE MPATH-WO-APPROVE         TO  DE-WO-APPROVE.
           MOVE MPATH-PRINT-OPTION       TO  DE-PRINT-OPTION.
           MOVE MPATH-CATEGORY           TO  DE-CATEGORY.

      *------ GET ALL THE DETAILS OF PATH LEVELS AND LOAD TO SCRN 1
           PERFORM 7080-LOAD-PATH-LEVELS THRU 7089-LPL-X.

           IF MOD-DEL-FLAG = "D"
      *        "P123: PRESS 'ENTER' TO DELETE OR 'f8' TO EXIT
               MOVE  16                  TO  LANG-SETNUM
               MOVE 123                  TO  LANG-MSGNUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.

       6530-SHOW-MOD-FORM-2.
      *----- f1 f2 f3 f6 INVALID, f4 REFRESH, f5 PRT, f7 CLR, f8 EXIT
      *----- IF MODIFY MODE, f1 ALLOWS THEM TO ADD NEW DEFS
           IF MOD-DEL-FLAG = "M"
               MOVE 6                    TO  SRF-KEYSET
               MOVE " AFE"               TO  SRF-FKEY (1)
               MOVE "I"                  TO  SRF-FKEY (2),
                                              SRF-FKEY (7)
           ELSE
               MOVE 7                    TO  SRF-KEYSET.
       6535-SHOWFORM.
           MOVE DE-FIELDS-A              TO  DISPLAY-REC.
           PERFORM 998-WRITE-SCREEN THRU 998-READ-SCREEN.
           MOVE DISPLAY-REC              TO  DE-FIELDS-A.
           IF MESSAGE-BUFFER-1 NOT = SPACES
               PERFORM 4015-SET-ERROR
               GO TO 6535-SHOWFORM.

           IF VIEW-LASTKEY = 3
               PERFORM 4020-CLEAR-FORM-A
               GO TO 6505-MOD-DEL-GETFORM-1.

           IF MOD-DEL-FLAG = "D"
             IF VIEW-LASTKEY = 7
               PERFORM 4020-CLEAR-FORM-A
               GO TO 6505-MOD-DEL-GETFORM-1.

      *------ NOW EDIT EACH OF THE 10 POSSIBLE PATHS
           IF MOD-DEL-FLAG = "M"
               MOVE 0                    TO  SUB
               MOVE SPACES               TO  MESSAGE-BUFFER
               PERFORM 8000-EDIT-LEVELS THRU 8010-EL-X UNTIL SUB > 9 OR
                 (MESSAGE-BUFFER-1 NOT = SPACES)
               IF MESSAGE-BUFFER-1 NOT = SPACES
                   GO TO 6530-SHOW-MOD-FORM-2.

           IF MOD-DEL-FLAG = "M"
               PERFORM 7030-MOVE-TO-DB-A
               PERFORM 7060-ADD-PATH-LEVELS THRU 7069-APL-X
               IF MESSAGE-BUFFER-1 NOT = SPACES
                   GO TO 6530-SHOW-MOD-FORM-2.

      *------ IF MODIFYING, ALLOW USER TO MODIFY EACH DETAIL OF THE
      *------ PATH DEFINITION. DELETE AND RE-ADD LEVELS FROM SCRN 1
      *------ F1 LETS THEM ADD NEW PATH DEFINITIONS TO A PATH.
      *------ (ENTER ONLY LETS THEM MODIFY EXISTING PATH DEFS).
           IF VIEW-LASTKEY = 1
               MOVE "EAPATHADDB"         TO  VIEW-NFNAME
               PERFORM 6400-ADD-PATH-DEF THRU 6490-APD-X
           ELSE
           IF MOD-DEL-FLAG = "M"
               MOVE "EAPATHMODB"         TO  VIEW-NFNAME
               PERFORM 6600-MODIFY-PATHDEF THRU 6690-MP-X
           ELSE
               MOVE DE-PATH              TO  PATH-ARG
               PERFORM 7040-DELETE-DPATHDEFS THRU 7043-DD-X.

      *------ NOW UPDATE OR DELETE THE MASTER SEGMENT
           MOVE PATH-ARG                 TO  PATHNUM OF MPATH-REC-O.
           READ MPATH-O INVALID KEY MOVE 17 TO COND-WORD.
           IF FILE-STATUS NOT = "00"
               MOVE "ERROR RE-READING PATH" TO BU-DISPLAY-MSG
               PERFORM 2100-BLOWUP.

           IF MOD-DEL-FLAG = "M"
      *        CALL "DBUPDATE" USING BASE, DSET-MPATH, MODE1,
      *          STATUS-AREA, ALL-ITEMS, BUF-MPATH
               REWRITE MPATH-REC-O FROM BUF-MPATH
                   INVALID KEY MOVE 99   TO  COND-WORD
               END-REWRITE
               IF FILE-STATUS NOT = "00"
                   MOVE "DBUPDATE ERR 6530-SFM2" TO BU-DISPLAY-MSG
                   PERFORM 2100-BLOWUP
               ELSE
                   NEXT SENTENCE
           ELSE
      *        CALL "DBDELETE" USING BASE, DSET-MPATH, MODE1,
      *          STATUS-AREA
               DELETE MPATH-O
                 INVALID KEY MOVE "2"    TO  FILE-STATUS-1
               END-DELETE
               IF FILE-STATUS NOT = "00"
                   MOVE "DBDELETE ERR 6530-SFM2" TO BU-DISPLAY-MSG
                   PERFORM 2100-BLOWUP.

           GO TO 6505-MOD-DEL-GETFORM-1.

       6590-MD-X.
           EXIT.

      ******************************************************************
      **     M O D I F Y   P A T H   D E F I N I T I O N              **
      ** THIS SECTION LOADS EACH PATHDEF REC INTO A TABLE, AND LETS   **
      ** USER FKEY THRU THEM, MODIFYING.  WHEN DONE IT DELETES EACH   **
      ** PATHDEF REC FOR THAT PATH AND RE-ADDS FROM THE TABLE.        **
      ******************************************************************
       6600-MODIFY-PATHDEF.
           PERFORM 4025-CLEAR-FORM-B.
           PERFORM 7300-LOAD-PATHDEF-TABLE THRU 7390-LPT-X.
           IF TABLE-LIMIT = 0
               GO TO 6690-MP-X.

           MOVE 0                        TO  SUB.
       6610-SHOW-FORM-PATHDEF.
           ADD 1                         TO  SUB.
           IF SUB > TABLE-LIMIT
               GO TO 6650-UPDATE-PATHDEF.

      *------ THIS COULD HAPPEN IF 1ST ENTRY IS DELETED, THEN THEY GO
      *------ BACKWARDS.
           IF SUB < 1
               GO TO 6650-UPDATE-PATHDEF.

      *------ SKIP OVER ITEMS THE USER MAY HAVE DELETED PREVIOUSLY
           IF PT-INCL-EXCL-FLAG (SUB) = "D"
               IF VIEW-LASTKEY = 2
                   SUBTRACT 2            FROM SUB
                   GO TO 6610-SHOW-FORM-PATHDEF
               ELSE
                   GO TO 6610-SHOW-FORM-PATHDEF.

           PERFORM 7055-LOAD-PATHDEF-TO-SCREEN.

           IF SUB < TABLE-LIMIT
               MOVE SPACES               TO  SRF-FKEY (1)
           ELSE
               MOVE "I"                  TO  SRF-FKEY (1).

           IF SUB > 1
               MOVE SPACES               TO  SRF-FKEY (2)
           ELSE
               MOVE "I"                  TO  SRF-FKEY (2).

      *----- f1,f2,f6,f7,f8 APPL,f3 INVALID,f4 REFRESH,f5 PRT
           MOVE 2                        TO  SRF-KEYSET.
       6620-SHOWFORM.
           MOVE DE-FIELDS-B              TO  DISPLAY-REC.
           PERFORM 998-WRITE-SCREEN THRU 998-READ-SCREEN.
           MOVE DISPLAY-REC              TO  DE-FIELDS-B.
           IF MESSAGE-BUFFER-1 NOT = SPACES
               PERFORM 4015-SET-ERROR
               GO TO 6620-SHOWFORM.

      *------ f1 = NEXT, f2 = PREVIOUS, f3 = DELETE,
      *------ 'ENTER' = UPDATE + NEXT

           IF VIEW-LASTKEY = 3
               GO TO 6650-UPDATE-PATHDEF
           ELSE
           IF VIEW-LASTKEY = 1
      *        *** NEXT ***
               GO TO 6610-SHOW-FORM-PATHDEF
           ELSE
           IF VIEW-LASTKEY = 2
      *        *** PREVIOUS ***
               SUBTRACT 2                FROM SUB
               GO TO 6610-SHOW-FORM-PATHDEF
           ELSE
           IF VIEW-LASTKEY = 8
      *        *** DELETE ***
               MOVE "D"                  TO  PT-INCL-EXCL-FLAG (SUB)
               GO TO 6610-SHOW-FORM-PATHDEF.

           MOVE SPACES                   TO  MESSAGE-BUFFER-1.
           PERFORM 7037-FORMAT-STUFF THRU 7038-FS-X.
           IF MESSAGE-BUFFER-1 NOT = SPACES
               GO TO 6620-SHOWFORM.

      *    *** UPDATE ***
           MOVE DE-INCL-EXCL-FLAG        TO  PT-INCL-EXCL-FLAG (SUB)
           MOVE DE-TYPE                  TO  PT-TYPE (SUB)
           MOVE DE-LOW-VALUE             TO  PT-LOW-VALUE (SUB)
           MOVE DE-HIGH-VALUE            TO  PT-HIGH-VALUE (SUB)
           MOVE DE-ODD-EVEN-FLAG         TO  PT-O-E (SUB)
           MOVE DE-ADD-LEVEL             TO  PT-LEVEL (SUB)
           MOVE DE-ADD-I-S               TO  PT-I-S (SUB)

           GO TO 6610-SHOW-FORM-PATHDEF.

       6650-UPDATE-PATHDEF.
      *------ DELETE AND RE-ADD ALL 'DPATHDEF' RECORDS FOR THAT PATH
           MOVE DE-PATH                  TO  PATH-ARG.
           PERFORM 7040-DELETE-DPATHDEFS THRU 7043-DD-X.

           MOVE 0                        TO  SUB.
       6655-RE-ADD-PATHDEFS-LOOP.
           ADD 1                         TO  SUB.
           IF SUB > TABLE-LIMIT
               GO TO 6690-MP-X.

      *------ DONT RE-ADD ANY PATHDEFS THAT WERE DELETED BY USER
           IF PT-INCL-EXCL-FLAG (SUB) = "D"
               GO TO 6655-RE-ADD-PATHDEFS-LOOP.

           MOVE SPACES                   TO  BUF-DPATHDEF.
           MOVE PATH-ARG                 TO  DPATHD-PATH-NUMBER.
           MOVE PT-INCL-EXCL-FLAG (SUB)  TO  DPATHD-INCL-EXCL-FLAG.
           MOVE PT-TYPE (SUB)            TO  DPATHD-TYPE.
           MOVE PT-LOW-VALUE (SUB)       TO  DPATHD-LOW-VALUE.
           MOVE PT-HIGH-VALUE (SUB)      TO  DPATHD-HIGH-VALUE.
           PERFORM 7036-BUILD-DPATHDEF-KEY.
           MOVE PT-LEVEL (SUB)           TO  DPATHD-LEVEL.
           MOVE PT-I-S (SUB)             TO  DPATHD-INORD-SIMEL.
           MOVE PT-O-E (SUB)             TO  DPATHD-ODD-EVEN-FLAG.
           PERFORM 7054-PUT-DPATHDEF.

           GO TO 6655-RE-ADD-PATHDEFS-LOOP.


       6690-MP-X.
           EXIT.

       6700-PATH-INQUIRY-1.
           MOVE "FCSISINQ"               TO  CSF-NEW-FORMFILE-NAME.
           MOVE "N"                      TO  CSF-MODE.
           PERFORM 7150-CALL-CSWITCHF.
           IF CSF-OPENFORM-ERR-SW = "Y"
               GO TO 6710-PI1-X.

           CALL "SEAPHIQ1" USING BASE, MMIS-BASE, VIEW-COMAREA,
             SRF-COMAREA, LANGUAGE-PARMS.

           MOVE "O"                      TO  CSF-MODE.
           PERFORM 7150-CALL-CSWITCHF.

       6710-PI1-X.
           EXIT.

       6720-PATH-INQUIRY-2.
           MOVE "FCSISINQ"               TO  CSF-NEW-FORMFILE-NAME.
           MOVE "N"                      TO  CSF-MODE.
           PERFORM 7150-CALL-CSWITCHF.
           IF CSF-OPENFORM-ERR-SW = "Y"
               GO TO 6730-PI2-X.

           CALL "SEAPHIQ2" USING BASE, MMIS-BASE, VIEW-COMAREA,
             SRF-COMAREA, LANGUAGE-PARMS.

           MOVE "O"                      TO  CSF-MODE.
           PERFORM 7150-CALL-CSWITCHF.

       6730-PI2-X.
           EXIT.

      ******************************************************************
      **                                                              **
      **       S H I F T   P A T H S                                  **
      **                                                              **
      ******************************************************************
       6800-SHIFT-PATHS.
           MOVE "EASHIFTP"               TO  VIEW-NFNAME.
           MOVE ZERO                     TO  DE-SHIFT-START.

       6805-SHOWFORM-SHIFT.
           PERFORM 7010-UNLOCK-MPATH.
           MOVE 7                        TO  SRF-KEYSET.
       6810-SHOWFORM.
           MOVE DE-FIELDS-C              TO  DISPLAY-REC.
           PERFORM 998-WRITE-SCREEN THRU 998-READ-SCREEN.
           MOVE DISPLAY-REC              TO  DE-FIELDS-C.
           IF MESSAGE-BUFFER-1 NOT = SPACES
               PERFORM 4015-SET-ERROR
               GO TO 6810-SHOWFORM.

           IF VIEW-LASTKEY = 3
               GO TO 6890-SP-X.

           MOVE DE-SHIFT-PREFIX          TO  PATH-ARG-PREFIX,
                                             NEW-PATH-ARG-PREFIX,
                                             OLD-PATH-ARG-PREFIX.
           MOVE DE-SHIFT-PATH            TO  PATH-ARG.
           PERFORM 7000-GET-MPATH.
           IF FILE-STATUS NOT = "00"
      *        "E45: ENTRY DOES NOT EXIST"
               MOVE   5                  TO  LANG-SETNUM
               MOVE  45                  TO  LANG-MSGNUM
               MOVE 2                    TO  FIELD-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               PERFORM 4015-SET-ERROR
               GO TO 6805-SHOWFORM-SHIFT.

           IF DE-DOWN-UP = "DOWN"
               SUBTRACT 1 FROM DE-SHIFT-START GIVING PATH-ARG-NUMBER
               PERFORM 7000-GET-MPATH
               IF FILE-STATUS = "00"
      *            "NO ROOM TO SHIFT DOWN - USE DELETE PATH"
                   MOVE  14              TO  LANG-SETNUM
                   MOVE 118              TO  LANG-MSGNUM
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE 2                TO  FIELD-NUMBER
                   PERFORM 4015-SET-ERROR
                   GO TO 6805-SHOWFORM-SHIFT.

           IF DE-DOWN-UP = "UP"
               PERFORM 7002-FIND-LAST-PATH THRU 7005-FLP-X
               MOVE SAVE-LAST-PATH       TO  CUR-PATH
               ADD 1                     TO  CUR-PATH
           ELSE
               SUBTRACT 2 FROM DE-SHIFT-START GIVING CUR-PATH.

       6810-SHIFT-LOOP.
           IF DE-DOWN-UP = "UP"
               SUBTRACT 1 FROM CUR-PATH
               IF CUR-PATH < DE-SHIFT-START
                   GO TO 6800-SHIFT-PATHS
               ELSE
                   NEXT SENTENCE
           ELSE
               ADD 1                     TO  CUR-PATH.

           IF DE-DOWN-UP = "UP"
               ADD 1, CUR-PATH GIVING NEW-PATH-ARG-NUMBER
               MOVE CUR-PATH             TO  OLD-PATH-ARG-NUMBER
           ELSE
               MOVE CUR-PATH             TO  NEW-PATH-ARG-NUMBER
               ADD 1, CUR-PATH GIVING OLD-PATH-ARG-NUMBER.

      *------ THE OLD PATH MUST EXIST, AND THE NEW PATH MUST NOT
      *------ EXIST.  ANY OTHER CONDITION, EXIT LOOP.
           MOVE NEW-PATH-ARG             TO  PATH-ARG.
           PERFORM 7000-GET-MPATH.
           IF FILE-STATUS = "00"
               GO TO 6800-SHIFT-PATHS.

           MOVE OLD-PATH-ARG             TO  PATH-ARG.
           PERFORM 7000-GET-MPATH.
           IF FILE-STATUS NOT = "00"
               GO TO 6800-SHIFT-PATHS.

           PERFORM 7400-COPY-PATH THRU 7490-CP-X.
           MOVE OLD-PATH-ARG             TO  PATH-ARG.
           PERFORM 7500-DELETE-PATH THRU 7510-DP-X.

           GO TO 6810-SHIFT-LOOP.

       6890-SP-X.
           EXIT.


      ******************************************************************
      **                                                              **
      **          C O P Y   P A T H S                                 **
      **                                                              **
      ******************************************************************
       6900-COPY-PATHS.
           MOVE "EAPATHCPY"              TO  VIEW-NFNAME.
           MOVE ZERO TO DE-OLD-PATH-NUMBER, DE-NEW-PATH-NUMBER.

       6910-SHOWFORM-COPY.
           PERFORM 7010-UNLOCK-MPATH.
           MOVE 7                        TO  SRF-KEYSET.
       6910-SHOWFORM.
           MOVE DE-FIELDS-D              TO  DISPLAY-REC.
           PERFORM 998-WRITE-SCREEN THRU 998-READ-SCREEN.
           MOVE DISPLAY-REC              TO  DE-FIELDS-D.
           IF MESSAGE-BUFFER-1 NOT = SPACES
               PERFORM 4015-SET-ERROR
               GO TO 6910-SHOWFORM.

           IF VIEW-LASTKEY = 3
               GO TO 6980-CP-X.

           MOVE DE-OLD-PATH              TO  PATH-ARG.
           PERFORM 7000-GET-MPATH.
           IF FILE-STATUS NOT = "00"
      *        "ENTRY DOES NOT EXIST"
               MOVE   5                  TO  LANG-SETNUM
               MOVE  45                  TO  LANG-MSGNUM
               MOVE   4                  TO  FIELD-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               PERFORM 4015-SET-ERROR
               GO TO 6910-SHOWFORM-COPY.

           MOVE DE-NEW-PATH              TO  PATH-ARG.
           PERFORM 7000-GET-MPATH.
           IF FILE-STATUS = "00"
      *        "ENTRY ALREADY EXISTS"
               MOVE   5                  TO  LANG-SETNUM
               MOVE  44                  TO  LANG-MSGNUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE 5                    TO  FIELD-NUMBER
               PERFORM 4015-SET-ERROR
               GO TO 6910-SHOWFORM-COPY.

           MOVE DE-OLD-PATH              TO  OLD-PATH-ARG.
           MOVE DE-NEW-PATH              TO  NEW-PATH-ARG.
           PERFORM 7400-COPY-PATH THRU 7490-CP-X.

           GO TO 6900-COPY-PATHS.

       6980-CP-X.
           EXIT.


       6990-MAIN-X.
           EXIT.

      ******************************************************************
      **                                                              **
      **      P E R F O R M E D   R O U T I N E S                     **
      **                                                              **
      ******************************************************************
       7000-GET-MPATH.
      *    CALL "DBGET" USING BASE, DSET-MPATH, MODE7, STATUS-AREA,
      *      ALL-ITEMS, BUF-MPATH, PATH-ARG.
           MOVE PATH-ARG                 TO  PATHNUM OF MPATH-REC-O.
           READ MPATH-O INTO BUF-MPATH
               INVALID KEY MOVE 17       TO  COND-WORD.
           IF FILE-STATUS = "00" OR FILE-STATUS-1 = "2"
               NEXT SENTENCE
           ELSE
               MOVE "DBGET ERR 7000-GM"  TO  BU-DISPLAY-MSG
               PERFORM 2100-BLOWUP.

       7002-FIND-LAST-PATH.
           MOVE 999                      TO  PATH-ARG-NUMBER.
       7004-FIND-LP-LOOP.
           SUBTRACT 1 FROM PATH-ARG-NUMBER.
           IF PATH-ARG-NUMBER = 0
               GO TO 7005-FLP-X.
           PERFORM 7000-GET-MPATH.
           IF FILE-STATUS = "00"
               MOVE PATH-ARG-NUMBER      TO  SAVE-LAST-PATH
               GO TO 7005-FLP-X
           ELSE
               GO TO 7004-FIND-LP-LOOP.
       7005-FLP-X.
           EXIT.

       7010-UNLOCK-MPATH.
      *------- DO A START > HIGH-VALUES TO UNLOCK
           MOVE HIGH-VALUES              TO  PATHNUM OF MPATH-REC-O.
           START MPATH-O KEY > PATHNUM OF MPATH-REC-O
               INVALID KEY MOVE "00"     TO  FILE-STATUS.

       7020-UNLOCK-DPATHDEF.
      *------- DO A START > HIGH-VALUES TO UNLOCK
           MOVE HIGH-VALUES              TO  PATHNUM OF DPATHDEF-REC-O.
           START DPATHDEF-O KEY > PATHNUM OF DPATHDEF-REC-O
               INVALID KEY MOVE "00"     TO  FILE-STATUS.

       7030-MOVE-TO-DB-A.
           MOVE PATH-ARG                 TO  MPATH-PATH-NUMBER.
           MOVE DE-PATH-DESC             TO  MPATH-PATH-DESC.
           MOVE DE-MIN-VAL               TO  MPATH-MIN-VAL.
           MOVE DE-MAX-VAL               TO  MPATH-MAX-VAL.
           MOVE DE-WO-APPROVE            TO  MPATH-WO-APPROVE.
           MOVE DE-PRINT-OPTION          TO  MPATH-PRINT-OPTION.
           MOVE DE-CATEGORY              TO  MPATH-CATEGORY.
           MOVE SPACES                   TO  MPATH-PAD.

       7035-MOVE-TO-DB-B.
           MOVE SPACES                   TO  BUF-DPATHDEF.
           MOVE PATH-ARG                 TO  DPATHD-PATH-NUMBER.
           MOVE DE-INCL-EXCL-FLAG        TO  DPATHD-INCL-EXCL-FLAG.
           MOVE DE-TYPE                  TO  DPATHD-TYPE.
           MOVE DE-LOW-VALUE             TO  DPATHD-LOW-VALUE.
           MOVE DE-HIGH-VALUE            TO  DPATHD-HIGH-VALUE.
           PERFORM 7036-BUILD-DPATHDEF-KEY.
           MOVE DE-ADD-LEVEL             TO  DPATHD-LEVEL.
           MOVE DE-ODD-EVEN-FLAG         TO  DPATHD-ODD-EVEN-FLAG.
           MOVE DE-ADD-I-S               TO  DPATHD-INORD-SIMEL.

       7036-BUILD-DPATHDEF-KEY.
           MOVE PATH-ARG-PREFIX          TO  DPATHD-KEY-PATH-TYPE.
           MOVE DPATHD-INCL-EXCL-FLAG    TO  DPATHD-KEY-INC-EX.
           MOVE DPATHD-TYPE              TO  DPATHD-KEY-TYPE.
           MOVE DPATHD-LOW-VALUE         TO  DPATHD-KEY-LOW-VALUE.

       7037-FORMAT-STUFF.
      *------ ALL BUDGET NUMBERS WILL BE STORED IN THE DATABASE WITH
      *------ DASHES STRIPPED, AND NO REVISION NUMBER
           IF DE-TYPE = "B"
               MOVE DE-LOW-VALUE         TO  BUDNUM-IN
               CALL "CBUDNUM" USING BUDNUM-IN, BUDNUM-NODASH-NOREV,
                 BUDNUM-NODASH-REV, BUDNUM-DASH-NOREV, BUDNUM-DASH-REV
      *        MOVE BUDNUM-NODASH-NOREV  TO  DE-LOW-VALUE
               MOVE BUDNUM-NODASH-REV    TO  DE-LOW-VALUE
               IF DE-HIGH-VALUE > SPACES
                   MOVE DE-HIGH-VALUE    TO  BUDNUM-IN
                   CALL "CBUDNUM" USING BUDNUM-IN, BUDNUM-NODASH-NOREV,
                     BUDNUM-NODASH-REV, BUDNUM-DASH-NOREV
                     BUDNUM-DASH-REV
                   MOVE BUDNUM-NODASH-REV    TO   DE-HIGH-VALUE.
      *            MOVE BUDNUM-NODASH-NOREV  TO   DE-HIGH-VALUE.

           IF DE-TYPE = "E"
               MOVE DE-LOW-VALUE         TO  RS-SHIFT-FLD
               CALL "TRSHIFT" USING RS-RET-CODE, RS-SHIFT-FLD
               MOVE RS-SHIFT-FLD-3-8     TO  DE-LOW-VALUE
               IF DE-HIGH-VALUE > SPACES
                   MOVE DE-HIGH-VALUE    TO  RS-SHIFT-FLD
                   CALL "TRSHIFT" USING RS-RET-CODE, RS-SHIFT-FLD
                   MOVE RS-SHIFT-FLD-3-8 TO  DE-HIGH-VALUE.

           IF DE-TYPE = "V"
              MOVE DE-LOW-VALUE          TO  RS-SHIFT-14
              CALL "TRSHIF14" USING RS-RET-CODE, RS-SHIFT-14
              MOVE RS-SHIFT-14           TO  DE-LOW-VALUE
              IF DE-LOW-VALUE NOT NUMERIC
      *           "T63: THIS FIELD MUST BE NUMERIC"
                  MOVE 20                TO  LANG-SETNUM
                  MOVE 63                TO  LANG-MSGNUM
                  PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                  MOVE 3                 TO  FIELD-NUMBER
                  PERFORM 4015-SET-ERROR
                  GO TO 7038-FS-X
              ELSE
                  MOVE DE-HIGH-VALUE     TO  RS-SHIFT-14
                  CALL "TRSHIF14" USING RS-RET-CODE, RS-SHIFT-14
                  MOVE RS-SHIFT-14       TO  DE-HIGH-VALUE
                  IF DE-HIGH-VALUE NOT NUMERIC
      *               "T63: THIS FIELD MUST BE NUMERIC"
                      MOVE 20            TO  LANG-SETNUM
                      MOVE 63            TO  LANG-MSGNUM
                      PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                      MOVE 4             TO  FIELD-NUMBER
                      PERFORM 4015-SET-ERROR
                      GO TO 7038-FS-X.

           IF DE-INCL-EXCL-FLAG = "I" OR "E"
               NEXT SENTENCE
           ELSE
               MOVE 1                    TO  FIELD-NUMBER
               PERFORM 4017-VALUE-ERR
               GO TO 7038-FS-X.

           IF DE-TYPE = "C" OR "D" OR "E" OR "B" OR "V"
               NEXT SENTENCE
           ELSE
               MOVE 2                    TO  FIELD-NUMBER
               PERFORM 4017-VALUE-ERR
               GO TO 7038-FS-X.

           IF DE-ODD-EVEN-FLAG = " " OR "O" OR "E" OR "A"
               NEXT SENTENCE
           ELSE
               MOVE 8                    TO  FIELD-NUMBER
               PERFORM 4017-VALUE-ERR
               GO TO 7038-FS-X.

           IF DE-ADD-I-S = " " OR "O" OR "S"
               NEXT SENTENCE
           ELSE
               MOVE 10                   TO  FIELD-NUMBER
               PERFORM 4017-VALUE-ERR
               GO TO 7038-FS-X.

       7038-FS-X.
           EXIT.

       7040-DELETE-DPATHDEFS.
           PERFORM 7045-FIND-DPATHDEF.
       7041-DELETE-DPATHDEF-LOOP.
           MOVE 0                        TO  COND-WORD.
           READ DPATHDEF-O NEXT INTO BUF-DPATHDEF
               AT END MOVE 15            TO  COND-WORD.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   MOVE 15               TO  COND-WORD
               ELSE
                   MOVE 99               TO  COND-WORD.
           IF PATHNUM OF DPATHDEF-REC-O NOT = PATH-ARG
               MOVE 15                   TO  COND-WORD.
           IF COND-WORD = 15
               PERFORM 7020-UNLOCK-DPATHDEF
               GO TO 7043-DD-X.
           PERFORM 7052-DELETE-DPATHDEF.
           GO TO 7041-DELETE-DPATHDEF-LOOP.
       7043-DD-X.
           EXIT.

       7045-FIND-DPATHDEF.
      *    CALL "DBFIND" USING BASE, DSET-DPATHDEF, MODE1,
      *      STATUS-AREA, PATH-SEARCH, PATH-ARG.
           MOVE PATH-ARG                 TO  PATHNUM OF DPATHDEF-REC-O.
           START DPATHDEF-O KEY = PATHNUM OF DPATHDEF-REC-O
               INVALID KEY MOVE 17       TO  COND-WORD.
           IF (FILE-STATUS NOT = "00") AND (FILE-STATUS-1 NOT = "2")
               MOVE "DBFIND ERR         " TO BU-DISPLAY-MSG
               PERFORM 2100-BLOWUP.

       7050-GET-DPATHDEF.
      *    CALL "DBGET" USING BASE, DSET-DPATHDEF, MODE5,
      *      STATUS-AREA, ALL-ITEMS, BUF-DPATHDEF, PATH-ARG.
           MOVE 0                        TO  COND-WORD.
           READ DPATHDEF-O NEXT INTO BUF-DPATHDEF
               AT END MOVE 15            TO  COND-WORD.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   MOVE 15               TO  COND-WORD
               ELSE
                   MOVE 99               TO  COND-WORD.
           IF PATHNUM OF DPATHDEF-REC-O NOT = PATH-ARG
               MOVE 15                   TO  COND-WORD.
           IF END-OF-CHAIN OR START-OF-CHAIN
               NEXT SENTENCE
           ELSE
           IF NOT GOOD-CALL
               MOVE "DBGET ERR 7050-GD"  TO  BU-DISPLAY-MSG
               PERFORM 2100-BLOWUP.

       7052-DELETE-DPATHDEF.
      *    CALL "DBDELETE" USING BASE, DSET-DPATHDEF, MODE1,
      *      STATUS-AREA.
           DELETE DPATHDEF-O INVALID KEY MOVE "2" TO FILE-STATUS-1.
           IF FILE-STATUS NOT = "00"
               MOVE "DBDELETE ERR 7200-DD" TO BU-DISPLAY-MSG
               PERFORM 2100-BLOWUP.

       7054-PUT-DPATHDEF.
      *    CALL "DBPUT" USING  BASE, DSET-DPATHDEF, MODE1,
      *      STATUS-AREA, ALL-ITEMS, BUF-DPATHDEF.
           WRITE DPATHDEF-REC-O FROM BUF-DPATHDEF
               INVALID KEY MOVE 99       TO  COND-WORD.
           IF FILE-STATUS NOT = "00"
               MOVE "DBPUT ERR DPATHDEF 7210-PD" TO BU-DISPLAY-MSG
               PERFORM 2100-BLOWUP.

       7055-LOAD-PATHDEF-TO-SCREEN.
           MOVE DE-PATH                  TO  V-PATH.
           MOVE DE-PATH-DESC             TO  V-PATH-DESC.
           MOVE PT-INCL-EXCL-FLAG (SUB)  TO  DE-INCL-EXCL-FLAG.
           MOVE PT-TYPE (SUB)            TO  DE-TYPE.
           MOVE PT-LOW-VALUE (SUB)       TO  DE-LOW-VALUE.
           MOVE PT-HIGH-VALUE (SUB)      TO  DE-HIGH-VALUE.
      *    IF PT-LEVEL (SUB) NUMERIC
      *        MOVE PT-LEVEL (SUB)       TO  DE-ADD-LEVEL
      *    ELSE
      *        MOVE "00"                 TO  DE-ADD-LEVEL.
           IF PT-LEVEL (SUB) = "  "
               MOVE "00"                 TO  DE-ADD-LEVEL
           ELSE
           MOVE PT-LEVEL (SUB)           TO  DE-ADD-LEVEL.
           MOVE PT-I-S (SUB)             TO  DE-ADD-I-S.
           MOVE PT-O-E (SUB)             TO  DE-ODD-EVEN-FLAG.

       7060-ADD-PATH-LEVELS.
           MOVE 0                        TO  SUB,
                                              SUB2.
           MOVE SPACES                   TO  MPATH-LEVELS.

       7062-ADD-PATH-LEVEL-LOOP.
           ADD 1                         TO  SUB.
           IF SUB > 10
               GO TO 7069-APL-X.

           IF DE-PATH-LEVEL (SUB) = SPACES OR "00"
               GO TO 7062-ADD-PATH-LEVEL-LOOP.

           ADD 1                         TO  SUB2.

           MOVE DE-PATH-LEVEL (SUB)      TO  MPATH-LEVEL (SUB2).
           MOVE DE-INORD-SIMEL (SUB)     TO  MPATH-LV-O-S (SUB2).
           MOVE SAVE-ACTIVE-EMPL (SUB)   TO  MPATH-EMPL (SUB2).

           GO TO 7062-ADD-PATH-LEVEL-LOOP.

       7069-APL-X.
           EXIT.

       7080-LOAD-PATH-LEVELS.
           MOVE 0                        TO  SUB.

       7082-LOAD-PATH-LEVELS-LOOP.
           ADD 1                         TO  SUB.
           IF SUB > 10
               GO TO 7089-LPL-X.

      *------ NOW GET THAT LEVEL'S DESCRIPTION
           MOVE MPATH-LEVEL (SUB)        TO  LEVEL-ARG.
      *    CALL "DBGET" USING BASE, DSET-MLEVEL, MODE7, STATUS-AREA,
      *      ALL-ITEMS, BUF-MLEVEL, LEVEL-ARG.
           MOVE LEVEL-ARG                TO  LEVELNUM OF MLEVEL-REC-I.
           READ MLEVEL-I INTO BUF-MLEVEL
               INVALID KEY MOVE 17       TO  COND-WORD.
           IF FILE-STATUS-1 = "2"
               MOVE SPACES               TO  BUF-MLEVEL
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE "DBGET ERR MLEVEL 7082-LPLL" TO BU-DISPLAY-MSG
               PERFORM 2100-BLOWUP.

      *    IF MPATH-LEVEL (SUB) NUMERIC
      *        MOVE MPATH-LEVEL (SUB)    TO  DE-PATH-LEVEL (SUB)
      *    ELSE
      *        MOVE "00"                 TO  DE-PATH-LEVEL (SUB).
           IF MPATH-LEVEL (SUB) = "  "
               MOVE "00"                 TO  DE-PATH-LEVEL (SUB)
           ELSE
           MOVE MPATH-LEVEL (SUB)        TO  DE-PATH-LEVEL (SUB).
           MOVE MPATH-LV-O-S (SUB)       TO  DE-INORD-SIMEL (SUB).
           MOVE MLEVEL-LEVEL-DESC        TO  V-LEVEL-DESC (SUB).

           GO TO 7082-LOAD-PATH-LEVELS-LOOP.

       7089-LPL-X.
           EXIT.

       7150-CALL-CSWITCHF.
           CALL "CSWITCHF" USING VIEW-COMAREA, LANGUAGE-PARMS,
             FORMFILE, CSF-PARMS, BU-DISPLAY-MSG.
           IF BU-DISPLAY-MSG-1 NOT = SPACES
               PERFORM 2100-BLOWUP.

       7300-LOAD-PATHDEF-TABLE.
           MOVE 0                        TO  SUB.
           PERFORM 7045-FIND-DPATHDEF.

       7310-LOAD-PATHDEF-TABLE-LOOP.
           PERFORM 7050-GET-DPATHDEF.
           IF END-OF-CHAIN
               MOVE SUB                  TO  TABLE-LIMIT
               GO TO 7380-UNLOCK.

           ADD 1                         TO  SUB.
           MOVE DPATHD-INCL-EXCL-FLAG    TO  PT-INCL-EXCL-FLAG (SUB).
           MOVE DPATHD-TYPE              TO  PT-TYPE (SUB).
           MOVE DPATHD-LOW-VALUE         TO  PT-LOW-VALUE (SUB).
           MOVE DPATHD-HIGH-VALUE        TO  PT-HIGH-VALUE (SUB).
           MOVE DPATHD-LEVEL             TO  PT-LEVEL (SUB).
           MOVE DPATHD-INORD-SIMEL       TO  PT-I-S (SUB).
           MOVE DPATHD-ODD-EVEN-FLAG     TO  PT-O-E (SUB).

           GO TO 7310-LOAD-PATHDEF-TABLE-LOOP.

       7380-UNLOCK.
           PERFORM 7020-UNLOCK-DPATHDEF.
       7390-LPT-X.
           EXIT.

       7400-COPY-PATH.
           MOVE OLD-PATH-ARG             TO  PATH-ARG.
           MOVE NEW-PATH-ARG             TO  MPATH-PATH-NUMBER.
      *    CALL "DBPUT" USING BASE, DSET-MPATH, MODE1, STATUS-AREA,
      *      ALL-ITEMS, BUF-MPATH.
           WRITE MPATH-REC-O FROM BUF-MPATH
               INVALID KEY MOVE 99       TO  COND-WORD.
           IF FILE-STATUS NOT = "00"
               MOVE "DBPUT ERR MPATH 7400-CP" TO BU-DISPLAY-MSG
               PERFORM 2100-BLOWUP.

           MOVE OLD-PATH-ARG             TO  PATH-ARG.
           PERFORM 7045-FIND-DPATHDEF.
       7410-DPATHDEF-LOOP.
      *    CALL "DBGET" USING BASE, DSET-DPATHDEF, MODE4,
      *      STATUS-AREA, ALL-ITEMS, BUF-DPATHDEF, DIRECTED-ADDR.
           MOVE 0                        TO  COND-WORD.
           READ DPATHDEF-O NEXT INTO BUF-DPATHDEF
               AT END MOVE 15            TO  COND-WORD.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   MOVE 15               TO  COND-WORD
               ELSE
                   MOVE 99               TO  COND-WORD.
           IF PATHNUM OF DPATHDEF-REC-O NOT = PATH-ARG
               MOVE 15                   TO  COND-WORD.
           IF COND-WORD = 15
               PERFORM 7020-UNLOCK-DPATHDEF
               GO TO 7490-CP-X
           ELSE
           IF NOT GOOD-CALL
               MOVE "DBGET ERR MODE4 7410-DL" TO BU-DISPLAY-MSG
               PERFORM 2100-BLOWUP.
           MOVE NEW-PATH-ARG             TO  DPATHD-PATH-NUMBER.
           PERFORM 7054-PUT-DPATHDEF.

           GO TO 7410-DPATHDEF-LOOP.

       7490-CP-X.
           EXIT.

       7500-DELETE-PATH.
           PERFORM 7040-DELETE-DPATHDEFS THRU 7043-DD-X.

           PERFORM 7000-GET-MPATH.
      *    CALL "DBDELETE" USING BASE, DSET-MPATH, MODE1,
      *      STATUS-AREA.
           DELETE MPATH-O INVALID KEY MOVE "2" TO FILE-STATUS-1.
           IF FILE-STATUS NOT = "00"
               MOVE "DBDELETE ERR 7500-DP" TO BU-DISPLAY-MSG
               PERFORM 2100-BLOWUP.

       7510-DP-X.
           EXIT.

       8000-EDIT-LEVELS.
           ADD 1                         TO  SUB.
           IF DE-PATH-LEVEL (SUB) = SPACES OR "00"
               GO TO 8010-EL-X.

           MOVE DE-PATH-LEVEL (SUB)      TO  LEVEL-ARG.
      *    CALL "DBGET" USING BASE, DSET-MLEVEL, MODE7, STATUS-AREA,
      *      ALL-ITEMS, BUF-MLEVEL, LEVEL-ARG.
           MOVE LEVEL-ARG                TO  LEVELNUM OF MLEVEL-REC-I.
           READ MLEVEL-I INTO BUF-MLEVEL
               INVALID KEY MOVE 17       TO  COND-WORD.
           IF FILE-STATUS-1 = "2"
      *        "E45: ENTRY DOES NOT EXIST"
               MOVE   5                  TO  LANG-SETNUM
               MOVE  45                  TO  LANG-MSGNUM
               COMPUTE FIELD-NUMBER = (2 * SUB) + 4
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               PERFORM 4015-SET-ERROR
               GO TO 8010-EL-X
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE "DBGET ERR 8000-EL"  TO  BU-DISPLAY-MSG
               PERFORM 2100-BLOWUP.

      *------ CANT ADD A LEVEL TO A PATH UNLESS THERE IS AN ACTIVE EMPL
           IF MLEVEL-ACTIVE-EMPL = SPACES
      *        "N115: NO ACTIVE EMPL AT THIS LEVEL"
               MOVE  14                  TO  LANG-SETNUM
               MOVE 115                  TO  LANG-MSGNUM
               COMPUTE FIELD-NUMBER = (2 * SUB) + 4
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               PERFORM 4015-SET-ERROR
               GO TO 8010-EL-X.

           MOVE MLEVEL-ACTIVE-EMPL       TO  SAVE-ACTIVE-EMPL (SUB).

           IF DE-PATH-LEVEL (SUB) = "00" OR SPACES
               NEXT SENTENCE
           ELSE
           IF DE-INORD-SIMEL (SUB) = "O" OR "S"
               NEXT SENTENCE
           ELSE
      *        "INVALID ENTRY   I105"
               MOVE  35                  TO  LANG-SETNUM
               MOVE 105                  TO  LANG-MSGNUM
               COMPUTE FIELD-NUMBER = SUB + 25
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               PERFORM 4015-SET-ERROR
               GO TO 8010-EL-X.

       8010-EL-X.
           EXIT.


       COPY DISPCALL IN COPYLIB.
       999-CATREAD.
           IF CATREAD-MSG-NUMBER = ZEROS
               MOVE LANG-SETNUM          TO  CATREAD-MSG-SET
               MOVE LANG-MSGNUM          TO  CATREAD-MSG-NUM.
           CALL "CCATREAD" USING CATREAD-PARMS.
           MOVE CATREAD-MSG-TEXT         TO  MESSAGE-BUFFER.
       999-CATREAD-EXIT.
           EXIT.
