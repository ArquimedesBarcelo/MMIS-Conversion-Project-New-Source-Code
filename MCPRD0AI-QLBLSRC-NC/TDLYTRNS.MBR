      ***************************************************************
      * 261-PROCESS-ISS-433:                     11/14/1994         *
      *  THIS PARAGRAPH IS IDENTICAL TO 260-PROCESS-ISS, EXCEPT     *
      *  IT HANDLES TRANSACTION 433 STOREROOM ISSUES.               *
      *                                                             *
      * * N O T E:  IF YOU MAKE A CHANGE TO 261-PROCESS-ISS-433,    *
      *   YOU NEED TO MAKE THE SAME CHANGE TO PARAGRAPH 260-        *
      *   PROCESS-ISS, 262-PROCESS-ISS-335 AND 263-PROCESS-ISS-435. *
      *                                                             *
      ***************************************************************

       261-PROCESS-ISS-433.
           MOVE TC433-DEPARTMENT       TO HOLD-DEPT-CHGD.
           MOVE TC433-CORPCODE         TO MMATL-CODE-ARG.
           PERFORM 520-GET-MMATL-ACCUM.
           MOVE HOLD-DEPT-4            TO DEPT-ARG.
           PERFORM 525-GET-DEPT.
           MOVE TC433-CORPCODE         TO TRANS-STORES-CODE.
           MOVE MATL-CLASS TO TRANS-CLASS.
           MOVE HOLD-DEPT-4            TO TRANS-DEPT.
           IF TC433-EXP-CLASS > "009999"
               MOVE TC433-EXP-CLASS TO TRANS-ACCT
               MOVE "0000" TO TRANS-DEPT
           ELSE
               IF MATL-ACCOUNT = SPACES
                   MOVE TC433-EXP-CLASS TO TRANS-ACCT
               ELSE
                   IF TC433-EXP-CLASS = "000290"
                       MOVE TC433-EXP-CLASS TO TRANS-ACCT
                   ELSE
                       MOVE MATL-ACCOUNT TO TRANS-ACCT.
           IF MCHT-DEPT-TYPE = "CL"
               MOVE SPACES TO TRANS-ACCT.
           PERFORM 410-CHECK-ACCT.
           MOVE SPACES TO TRANS-PO-NUM
                          TRANS-RCVR-NUM
                          TRANS-ITEM-NUM.
           MOVE "ISS" TO TRANS-CODE.
           MOVE TC433-FRAN-ID    TO TRANS-CODE-FRAN-ID.
           MOVE DDAILYTC-DATE    TO TRANS-DATE.
           IF TRANS-YY > "70"
               MOVE "19"         TO TRANS-DATE-CC
           ELSE
               MOVE "20"         TO TRANS-DATE-CC.
           MOVE DDAILYTC-TIME    TO TRANS-TIME.
           MOVE TC433-EMP        TO TRANS-EMP.
           MOVE TC433-QTY        TO TRANS-QTY.
           PERFORM 560-GET-MSTORERM.
           IF NO-ENTRY
               MOVE TC433-AVG-COST TO STR-AVG-COST
                                      STR-STD-COST
           ELSE
               NEXT SENTENCE.
           IF MCHT-DEPT-TYPE = "PR"
               IF (TRANS-CLASS > 099 AND TRANS-CLASS < 200) OR
                  (TRANS-CLASS > 399 AND TRANS-CLASS < 500)
                   COMPUTE TRANS-VALUE ROUNDED = TC433-QTY *
                                         STR-STD-COST
                     IF TRANS-CLASS = 206
                         NEXT SENTENCE
                     ELSE
                        COMPUTE AVG-VALUE ROUNDED = TC433-QTY *
                                                    STR-AVG-COST
                       COMPUTE MATL-TOT-ISS-DOLLARS =
                         MATL-TOT-ISS-DOLLARS +
                         AVG-VALUE
               ELSE
                   COMPUTE TRANS-VALUE ROUNDED = TC433-QTY *
                                         STR-AVG-COST
                     IF TRANS-CLASS = 206
                         NEXT SENTENCE
                     ELSE
                         ADD TRANS-VALUE TO MATL-TOT-ISS-DOLLARS
           ELSE
               COMPUTE TRANS-VALUE ROUNDED = TC433-QTY *
                                     STR-AVG-COST
               IF TRANS-CLASS = 206
                   NEXT SENTENCE
               ELSE
                 ADD TRANS-VALUE TO MATL-TOT-ISS-DOLLARS.
           MOVE TC433-UM TO TRANS-UNIT-MEASURE.
           MOVE TC433-WORK-ORDER TO TRANS-DOCUMENT-NUM.
           MOVE 0 TO TRANS-BALANCE-QTY.
           ADD TC433-QTY TO MATL-ISSUE-UNITS.
           MOVE TRANS-DATE-CN           TO MATL-DATE-LAST-UPDATE-CN.
           MOVE "N"                     TO SUCCESSFUL-PUT-SW.
           PERFORM 500-PUT-DTRANS
               UNTIL SUCCESSFUL-PUT.

