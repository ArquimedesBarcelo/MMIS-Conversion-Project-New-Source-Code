100500***************************************************************
100600**   THIS SECTION PROCESSES ANY PO MODIFICATIONS TO CLASS FOR**
100700**   DIRECT CHARGE PURCHASES AND PRICE CHANGES FOR ALL       **
100800**   DIRECT AND STOREROOM RECEIPTS.                          **
100900**   THE TCs CHECKED ARE TC '321' PRICE CHANGES AND '322'    **
101000**   FOR CLASS CHANGES.                                      **
      **                                                           **
      **   ALL REFERENCES TO TC321 WERE CHANGED TO TC320 BECAUSE   **
      **   OF THE COPYLIB FIELDS THAT WERE ADDED.  (TC320 IS USED  **
      **   FOR TC320, 321, AND 322.)           11/2/1994           **
      **                                                           **
      **   ADDED MOVE FROM TRANSACTION PO TO HOLD PO FIELDS WHEN   **
      **   COPYLIB MEMBERS WERE ADDED IN ORDER TO BE ABLE TO BREAK **
      **   DOWN THE PO TO PERFORM THE READ.    11/2/1994           **
      **                                                           **
      **  * N O T E:  IF YOU MAKE A CHANGE TO ANY OF THE FOLLOWING **
      **    PARAGRAPHS (205 THROUGH 208), MAKE THE SAME CHANGE TO  **
      **    PARAGRAPHS 205B THROUGH 208B.      11/16/1994          **
      **                                                           **
101100***************************************************************
101200
101300 205-PROCESS-PO-MODIFY.
101400     IF DDAILYTC-TC = "321"
101500         IF TC320-PRICE = ZEROS
101600             GO TO 205-PPM-X.
           MOVE TC320-PO-RLS TO HOLD-PO-FULL.
           MOVE HOLD-PO-PART TO PO-ARG.
           PERFORM 9999-DBFIND-DTRANS-PO-O.
102300     IF GOOD-CALL
102400         PERFORM 206-GET-PO-ENTRIES
102500             UNTIL END-OF-CHAIN
102600     ELSE
102700         IF NO-ENTRY
102800             NEXT SENTENCE
102900         ELSE
103000             MOVE "FIND DTRANS * 205-PPM" TO BU-DISPLAY-MSG
103100             MOVE TC320-PO-RLS    TO BU-DISPLAY-FLD (1)
103200             PERFORM 990-BLOWUP.
103300
103400 205-PPM-X.
103500     EXIT.
103600
103700 206-GET-PO-ENTRIES.
      *------ TC321-PO-KEY
           PERFORM 9999-DBGET5-DTRANS-PO-O.
104500     IF GOOD-CALL
104600         IF TRANS-ITEM-NUM = TC320-ITEM-NO
104700             IF DDAILYTC-TC = "321"
104800                 PERFORM 207-PROCESS-PRICE-CHANGE
104900             ELSE
105000             IF DDAILYTC-TC = "322"
105100                 PERFORM 208-PROCESS-CLASS-CHANGE
105200             ELSE
105300                 NEXT SENTENCE
105400         ELSE
105500             NEXT SENTENCE
105600     ELSE
105700         IF END-OF-CHAIN
105800             NEXT SENTENCE
105900         ELSE
106000             MOVE "DBGET DTRANS * 206-GPE" TO BU-DISPLAY-MSG
106100             MOVE TC320-PO-RLS    TO BU-DISPLAY-FLD (1)
106200             PERFORM 990-BLOWUP.
106300
106400 207-PROCESS-PRICE-CHANGE.
106500     IF TRANS-BALANCE-QTY = ZEROS
106600         NEXT SENTENCE
106700     ELSE
106800     IF TRANS-CODE = "DCHG"
106900         COMPUTE TRANS-VALUE ROUNDED = TC320-PRICE *
107000                                       TRANS-QTY
107100         PERFORM 510-UPDATE-DTRANS
107200     ELSE
107300     IF TRANS-CODE = "REC"
107400         MOVE TC320-CORP-CODE    TO MMATL-CODE-ARG
107500         PERFORM 520-GET-MMATL-ACCUM
107600         COMPUTE REC-UNIT-COST ROUNDED = TRANS-VALUE /
107700                                         TRANS-QTY
107800         COMPUTE MATL-RCPT-DOLLARS ROUNDED = MATL-RCPT-DOLLARS -
107900             (REC-UNIT-COST * TRANS-BALANCE-QTY)
108000         COMPUTE MATL-RCPT-DOLLARS ROUNDED = MATL-RCPT-DOLLARS +
108100             (TC320-PRICE * TRANS-BALANCE-QTY)
108200         COMPUTE TRANS-VALUE ROUNDED = TC320-PRICE * TRANS-QTY
108300         PERFORM 510-UPDATE-DTRANS
108400         IF TRANS-CLASS = "206"
108500             NEXT SENTENCE
108600         ELSE
108700             PERFORM 550-UPDATE-MMATL-ACCUM.
108800
108900 208-PROCESS-CLASS-CHANGE.
109000     IF TRANS-CODE = "DCHG"
109100         IF TC322-SUB = TRANS-CLASS
109200             NEXT SENTENCE
109300         ELSE
109400             MOVE TC322-SUB           TO TRANS-CLASS
109500             PERFORM 510-UPDATE-DTRANS.
109600
      ***************************************************************
      **   THIS SECTION PROCESSES ANY PO MODIFICATIONS TO CLASS FOR**
      **   DIRECT CHARGE PURCHASES AND PRICE CHANGES FOR ALL       **
      **   DIRECT AND STOREROOM RECEIPTS.                          **
      **   THE TCs CHECKED ARE TC '421' PRICE CHANGES AND '422'    **
      **   FOR CLASS CHANGES.                                      **
      **                                                           **
      **  * N O T E:  IF YOU MAKE A CHANGE TO ANY OF THE FOLLOWING **
      **    PARAGRAPHS (205B THROUGH 208B), MAKE THE SAME CHANGE   **
      **    TO THE PREVIOUS PARAGRAPHS (205 THROUGH 208). 11/16/94 **
      **                                                           **
      ***************************************************************

       205B-PROCESS-PO-MODIFY.
           ADD 1 TO 4XX-COUNT.
           DISPLAY 4XX-COUNT, ":  TRANSACTION  ", DDAILYTC-TC,
                   "  PROCESSED -- CORPORATE CODE  ",
                   TC420-CORP-CODE.
           IF DDAILYTC-TC = "421"
               IF TC420-PRICE = ZEROS
                   GO TO 205B-PPM-X.
           MOVE TC420-PO-RLS TO HOLD-PO-PART.
           MOVE HOLD-PO-PART TO PO-ARG.
           PERFORM 9999-DBFIND-DTRANS-PO-O.
           IF GOOD-CALL
               PERFORM 206B-GET-PO-ENTRIES
                   UNTIL END-OF-CHAIN
           ELSE
               IF NO-ENTRY
                   NEXT SENTENCE
               ELSE
                   MOVE "FIND DTRANS * 205B-PPM" TO BU-DISPLAY-MSG
                   MOVE TC420-PO-RLS    TO BU-DISPLAY-FLD (1)
                   PERFORM 990-BLOWUP.

       205B-PPM-X.
           EXIT.

       206B-GET-PO-ENTRIES.
      *------ TC421-PO-KEY
           PERFORM 9999-DBGET5-DTRANS-PO-O.
           IF GOOD-CALL
               IF TRANS-ITEM-NUM = TC420-ITEM-NO
                   IF DDAILYTC-TC = "421"
                       PERFORM 207B-PROCESS-PRICE-CHANGE
                   ELSE
                   IF DDAILYTC-TC = "422"
                       PERFORM 208B-PROCESS-CLASS-CHANGE
                   ELSE
                       NEXT SENTENCE
               ELSE
                   NEXT SENTENCE
           ELSE
               IF END-OF-CHAIN
                   NEXT SENTENCE
               ELSE
                   MOVE "DBGET DTRANS * 206B-GPE" TO BU-DISPLAY-MSG
                   MOVE TC420-PO-RLS    TO BU-DISPLAY-FLD (1)
                   PERFORM 990-BLOWUP.

       207B-PROCESS-PRICE-CHANGE.
           IF TRANS-BALANCE-QTY = ZEROS
               NEXT SENTENCE
           ELSE
           IF TRANS-CODE = "DCHG"
               COMPUTE TRANS-VALUE ROUNDED = TC420-PRICE *
                                             TRANS-QTY
               PERFORM 510-UPDATE-DTRANS
           ELSE
           IF TRANS-CODE = "REC"
               MOVE TC420-CORP-CODE    TO MMATL-CODE-ARG
               PERFORM 520-GET-MMATL-ACCUM
               COMPUTE REC-UNIT-COST ROUNDED = TRANS-VALUE /
                                               TRANS-QTY
               COMPUTE MATL-RCPT-DOLLARS ROUNDED = MATL-RCPT-DOLLARS -
                   (REC-UNIT-COST * TRANS-BALANCE-QTY)
               COMPUTE MATL-RCPT-DOLLARS ROUNDED = MATL-RCPT-DOLLARS +
                   (TC420-PRICE * TRANS-BALANCE-QTY)
               COMPUTE TRANS-VALUE ROUNDED = TC420-PRICE * TRANS-QTY
               PERFORM 510-UPDATE-DTRANS
               IF TRANS-CLASS = "206"
                   NEXT SENTENCE
               ELSE
                   PERFORM 550-UPDATE-MMATL-ACCUM.

       208B-PROCESS-CLASS-CHANGE.
           IF TRANS-CODE = "DCHG"
               IF TC422-SUB = TRANS-CLASS
                   NEXT SENTENCE
               ELSE
                   MOVE TC422-SUB           TO TRANS-CLASS
                   PERFORM 510-UPDATE-DTRANS.

