309400     ELSE
               PERFORM 9999-SETJCW-ABORTED-1.

      ***************************************************************
      * 11APR90 - REPLACED THE FOLLOWING LOGIC WITH THE MACHINE
      *           DEPENDENT PERFORMED ROUTINE 9999-SETJCW-ABORTED-1.
      ***************************************************************
309500*        MOVE "SETJCW ABORTED=1"  TO  COMMAND
309600*        CALL INTRINSIC "COMMAND" USING COMMAND-IMAGE,
309700*            COMMAND-ERROR, COMMAND-PARM
309800*        IF COMMAND-ERROR NOT = 0
309900*            DISPLAY "COMMAND (SETJCW ABORTED=1) FAILED"
310000*            DISPLAY "COMMAND-ERROR=", COMMAND-ERROR
310100*            DISPLAY "COMMAND-PARM=", COMMAND-PARM.
      ***************************************************************
310200
310300     MOVE "TDLYTRNS"              TO  BU-PGM-NAME.
310400     MOVE TRANS-FILE-RCD-COUNT    TO  BU-DISPLAY-FLD9 (5).
310500     MOVE MMATL-CODE-ARG          TO  BU-DISPLAY-FLD (5).
310600
310700***************************************************************
310800**   CALL 'CBLOWSRT' INSTEAD OF 'TBLOWUP' WHEN A BLOWUP      **
310900**   SITUATION OCCURS SINCE THIS PROGRAM USES THE 'SORT'     **
311000**   VERB.  'CBLOWSRT' WRITES ALL THE BLOWUP INFORMATION     **
311100**   TO A TEMPORARY FILE 'BLUPDATA' (WHICH WAS OPENED AT     **
311200**   THE BEGINNING OF THE PROGRAM) THE CLOSES IT. THEN IT    **
311300**   CREATESA A SON PROCESS 'XBLOWSRT' THAT READS THE        **
311400**   BLOWUP INFORMATION OUT OF 'BLUPDATA' AND CALLS          **
311500**   'TBLOWUP' USING THIS INFO.  SINCE THE NEW PROCESS       **
311600**   'XBLOWSRT' HAS ITS OWN STACK THE STACK OVERFLOW         **
311700**   PROBLEM IS AVOIDED.                                     **
311800***************************************************************
311900
312000     CALL "CBLOWSRT" USING CBLOWSRT-PARMS,
312100                           ACCTG-BASE,
312200                           BU-PGM-NAME,
312300                           STATUS-AREA,
312400                           DUMMY-VIEW-AREA,
312500                           FILE-STATUS,
312600                           BU-DISPLAY-MSG,
312700                           BU-DISPLAY-FLDS.
312800
313000 995-ERROR-PRT.
313100     PERFORM 996-PRINT-ERR-HEADINGS.
313200     IF ERR-FLAG = 1
313300        WRITE ERR-REC FROM PRT-ERROR-LINE1 AFTER 2
313400     ELSE
313500         IF ERR-FLAG = 2
313600             WRITE ERR-REC FROM PRT-ERROR-LINE1 AFTER 2
313700             WRITE ERR-REC FROM PRT-ERROR-LINE2 AFTER 1
313800             WRITE ERR-REC FROM PRT-ERROR-LINE3 AFTER 1.
313900
314000 996-PRINT-ERR-HEADINGS.
           MOVE 1 TO DATE-MODE.
           CALL "TDATECHK" USING DATE-CHECK-AREA.
314100*****MOVE CURRENT-DATE TO DATE-H1.
           MOVE DATE-SLASH-OUT TO DATE-H1.
314200*****MOVE TIME-OF-DAY TO TIME-DIV.
           MOVE DATE-UNFORMATTED-TIME-OUT TO TIME-DIV.
314300     MOVE HH-DIV TO HH-H2.
314400     MOVE MM-DIV TO MM-H2.
314500     MOVE SS-DIV TO SS-H2.
314600     ADD 1 TO PAGE-CNT-ERR.
314700     MOVE PAGE-CNT-ERR TO PAGE-H2.
314800     MOVE "TRANSACTION ERROR LIST" TO RPT-H2.
314900     WRITE ERR-REC FROM HEADER1 AFTER ADVANCING NEW-PAGE.
315000     WRITE ERR-REC FROM HEADER2 AFTER 1.
315100     WRITE ERR-REC FROM HEADER3 AFTER 2.
315200     WRITE ERR-REC FROM HEADER4 AFTER 1.
315300     WRITE ERR-REC FROM BLANK-LINE AFTER 1.
315400     MOVE 6 TO LINE-CNT-ERR.
315500
315700 1000-CLOSE-FILES.
315800     CLOSE TRANS-FILE
315900           ONLINE-PRT
316000           ONLINE-ERR.
316100
316200*********************************************************
316300**                                                     **
316400**   IF THIS IS A SPECIAL RUN OF TDLYTRNS TO PROCESS   **
316500**   ENTRIES IN THE DHLDTRN1 DATASET THEN DON'T        **
316600**   UPDATE THE CUTOFF SEQ. COUNTER SINCE THIS FILE    **
316700**   WAS NOT CREATED BY 'BCUTOFF' AND HAS A SEQ.       **
316800**   COUNTER OF '99999'                                **
316900**                                                     **
317000*********************************************************
      **   NOTE: ON AS/400 SYSTEM 530-GET-MACCT-SEQ WILL LOCK
      **         THE "SEQ" RECORD OF MACCOUNT-INFO.  HOWEVER;
      **         540-UPDATE-MACCT-INFO WILL REWRITE THE RECORD
      **         AND THEREFORE RELEASE IT.
317000*********************************************************
317100
317200     IF DHOLDFILE-CUTOFF-SW = "Y"
317300         NEXT SENTENCE
317400     ELSE
317500         PERFORM 530-GET-MACCT-SEQ
317600         ADD 1 TO MACCT-ABST-SEQ
317700         PERFORM 540-UPDATE-MACCT-INFO.
317800
317900******************************************************
318000**   UPDATE LATEST TRANS DATE AND TIME IN THE       **
318100**   MACCOUNT-INFO DATA SET (MTED)                  **
318200******************************************************
      **   NOTE: ON AS/400 SYSTEM 535-GET-MACCT-MTED WILL LOCK
      **         THE "MTED" RECORD OF MACCOUNT-INFO.  HOWEVER;
      **         540-UPDATE-MACCT-INFO WILL REWRITE THE RECORD
      **         AND THEREFORE UNLOCK IT.
318200******************************************************
318300     PERFORM 535-GET-MACCT-MTED.
318400     MOVE SAVE-LATEST-CUTOFF-DATE  TO  MACCT-LATEST-CUTOFF-DATE.
318500     MOVE SAVE-LATEST-CUTOFF-TIME  TO  MACCT-LATEST-CUTOFF-TIME.
318600     PERFORM 540-UPDATE-MACCT-INFO.
318700
318800     MOVE "NO"                    TO NO-MORE-ABST
318900                                     NO-MORE-SORT.
           PERFORM 9999-CLOSE-STUFF.

       9999-ROUTINES SECTION 05.

       9999-DBGET7-MACCOUNT-INFO-IK-O.
           MOVE 0 TO COND-WORD.
           MOVE MACCT-KEY TO INFOKEY OF MACCOUNT-INFO-IK-REC-O.
           READ MACCOUNT-INFO-IK-O INTO BUF-MACCT-INFO
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS = "23"
               MOVE 17 TO COND-WORD
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD.

       9999-RESET-MACCOUNT-INFO-IK-O.
           MOVE HIGH-VALUES TO INFOKEY OF MACCOUNT-INFO-IK-REC-O.
           START MACCOUNT-INFO-IK-O KEY > INFOKEY OF
              MACCOUNT-INFO-IK-REC-O
               INVALID KEY MOVE "00" TO FILE-STATUS.

       9999-DBFIND-DTRANS-PO-O.
           MOVE 0 TO COND-WORD.
           MOVE PO-ARG TO PONUM OF DTRANS-PO-REC-O.
           START DTRANS-PO-O KEY = PONUM OF DTRANS-PO-REC-O
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS = "23"
               MOVE 17 TO COND-WORD
           ELSE
           IF (FILE-STATUS NOT = "00") AND (FILE-STATUS-1 NOT = "2")
               MOVE 99 TO COND-WORD.

       9999-DBGET5-DTRANS-PO-O.
           MOVE 0 TO COND-WORD.
           READ DTRANS-PO-O NEXT INTO BUF-DTRANS
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14"
                   PERFORM 9999-RESET-DTRANS-PO-O
                   MOVE 15 TO COND-WORD
               ELSE
               IF FILE-STATUS = "46"
                   MOVE 15 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD
           ELSE
           IF PONUM OF DTRANS-PO-REC-O NOT = PO-ARG
               PERFORM 9999-RESET-DTRANS-PO-O
               MOVE 15 TO COND-WORD.

       9999-RESET-DTRANS-PO-O.
           MOVE HIGH-VALUES TO PONUM OF DTRANS-PO-REC-O.
           START DTRANS-PO-O KEY > PONUM OF DTRANS-PO-REC-O
               INVALID KEY MOVE "00" TO FILE-STATUS.

       9999-DBFIND-DTRANS-MC-O.
           MOVE 0 TO COND-WORD.
           MOVE MMATL-CODE-ARG TO MATLCODE OF DTRANS-MC-REC-O.
           START DTRANS-MC-O KEY = MATLCODE OF DTRANS-MC-REC-O
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS = "23"
               MOVE 17 TO COND-WORD
           ELSE
           IF (FILE-STATUS NOT = "00") AND (FILE-STATUS-1 NOT = "2")
               MOVE 99 TO COND-WORD.

       9999-DBGET5-DTRANS-MC-O.
           MOVE 0 TO COND-WORD.
           READ DTRANS-MC-O NEXT INTO BUF-DTRANS
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14"
                   PERFORM 9999-RESET-DTRANS-MC-O
                   MOVE 15 TO COND-WORD
               ELSE
               IF FILE-STATUS = "46"
                   MOVE 15 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD
           ELSE
           IF MATLCODE OF DTRANS-MC-REC-O NOT = MMATL-CODE-ARG
               PERFORM 9999-RESET-DTRANS-MC-O
               MOVE 15 TO COND-WORD.

       9999-RESET-DTRANS-MC-O.
           MOVE HIGH-VALUES TO MATLCODE OF DTRANS-MC-REC-O.
           START DTRANS-MC-O KEY > MATLCODE OF DTRANS-MC-REC-O
               INVALID KEY MOVE "00" TO FILE-STATUS.

       9999-DBPUT-DTRANS-PO-O.
           MOVE 0 TO COND-WORD.
           WRITE DTRANS-PO-REC-O FROM BUF-DTRANS
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD.

       9999-DBUPDATE-DTRANS-PO-O.
           MOVE 0 TO COND-WORD.
           REWRITE DTRANS-PO-REC-O FROM BUF-DTRANS
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD.

       9999-DBUPDATE-DTRANS-MC-O.
           MOVE 0 TO COND-WORD.
           REWRITE DTRANS-MC-REC-O FROM BUF-DTRANS
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD.

       9999-DBGET7-MCLASS-CL-I.
           MOVE 0 TO COND-WORD.
           MOVE CLASS-ARG TO ACTGCLASS OF MCLASS-CL-REC-I.
           READ MCLASS-CL-I INTO BUF-MCLASS
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS = "23"
               MOVE 17 TO COND-WORD
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD.

       9999-DBPUT-DHOLDTRAN-TD-O.
           MOVE 0 TO COND-WORD.
           WRITE DHOLDTRAN-TD-REC-O FROM BUF-DHOLDTRAN
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD.

       9999-DBGET7-MMATL-ACCUM-MC-I.
           MOVE 0 TO COND-WORD.
           MOVE MMATL-CODE-ARG TO MATLCODE OF MMATL-ACCUM-MC-REC-I.
           READ MMATL-ACCUM-MC-I INTO BUF-MATLACUM
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS = "23"
               MOVE 17 TO COND-WORD
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD.

       9999-DBGET7-MCHT-ACCTS-DP-I.
           MOVE 0 TO COND-WORD.
           MOVE DEPT-ARG TO DEPT OF MCHT-ACCTS-DP-REC-I.
           READ MCHT-ACCTS-DP-I INTO BUF-MCHTACCTS
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS = "23"
               MOVE 17 TO COND-WORD
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD.

       9999-DBUPDATE-MACCOUNT-INFO-O.
           MOVE 0 TO COND-WORD.
           REWRITE MACCOUNT-INFO-IK-REC-O FROM BUF-MACCT-INFO
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD.

       9999-DBGET7-MSTORERM-CD-I.
           MOVE 0 TO COND-WORD.
           MOVE MMATL-CODE-ARG TO CORPCDE OF MSTORERM-CD-REC-I.
           READ MSTORERM-CD-I INTO BUF-MSTORERM
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS = "23"
               MOVE 17 TO COND-WORD
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD.

       9999-DBPUT-MMATL-ACCUM-MC-O.
           MOVE 0 TO COND-WORD.
           WRITE MMATL-ACCUM-MC-REC-O FROM BUF-MATLACUM
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD.

       9999-OPEN-STUFF.
           OPEN I-O   MACCOUNT-INFO-IK-O   .
           OPEN I-O   DTRANS-PO-O          .
           OPEN I-O   DTRANS-MC-O          .
           OPEN INPUT MCLASS-CL-I          .
           OPEN I-O   DHOLDTRAN-TD-O       .
           OPEN INPUT MMATL-ACCUM-MC-I     .
           OPEN INPUT MCHT-ACCTS-DP-I      .
           OPEN INPUT MPLTINFO-I
           OPEN INPUT MSTORERM-CD-I        .
           OPEN I-O   MMATL-ACCUM-MC-O     .

       9999-CLOSE-STUFF.
           CLOSE      MACCOUNT-INFO-IK-O   .
           CLOSE      DTRANS-PO-O          .
           CLOSE      DTRANS-MC-O          .
           CLOSE      MCLASS-CL-I          .
           CLOSE      DHOLDTRAN-TD-O       .
           CLOSE      MMATL-ACCUM-MC-I     .
           CLOSE      MCHT-ACCTS-DP-I      .
           CLOSE      MPLTINFO-I
           CLOSE      MSTORERM-CD-I        .
           CLOSE      MMATL-ACCUM-MC-O     .

       9999-OVERRIDE-FILE.
           MOVE FILE-COMMAND TO COMMAND-WORK.
           CALL "QCMDEXC" USING COMMAND-WORK, COMMAND-LEN.

       9999-SETJCW-ABORTED-1.
           MOVE "1"   TO SETJCW-VALUE.
           MOVE 300   TO SETJCW-STARTING-POS.
           MOVE 1     TO SETJCW-LENGTH.
           CALL "SETJCW" USING SETJCW-VALUE,
                               SETJCW-STARTING-POS,
                               SETJCW-LENGTH,
                               SETJCW-STATUS.
           IF SETJCW-STATUS NOT = "00"
               DISPLAY "COMMAND (SETJCW ABORTED=1) FAILED"
               DISPLAY "SETJCW-STATUS       = ", SETJCW-STATUS
               DISPLAY "SETJCW-VALUE        = ", SETJCW-VALUE
               DISPLAY "SETJCW-STARTING-POS = ", SETJCW-STARTING-POS
               DISPLAY "SETJCW-LENGTH       = ", SETJCW-LENGTH.
