      **   * N O T E:  IF YOU MAKE A CHANGE TO 233-PROCESS-RET-436 **
      **     MAKE THE SAME CHANGE TO 230-PROCESS-RET,   11/15/1994 **
      **     231-PROCESS-RET-430 AND 232-PROCESS-RET-336.          **
      **                                                           **
      ***************************************************************

       233-PROCESS-RET-436.
           MOVE TC436-CORP-CODE TO MMATL-CODE-ARG.
           PERFORM 520-GET-MMATL-ACCUM.
           MOVE TC436-CHARGE-DEPT TO DEPT-ARG.
           PERFORM 525-GET-DEPT.
           MOVE TC436-CORP-CODE TO TRANS-STORES-CODE.
           MOVE MATL-CLASS TO TRANS-CLASS.
           MOVE TC436-CHARGE-DEPT TO TRANS-DEPT.
           IF TC436-EXP-CLASS > "009999"
               MOVE TC436-EXP-CLASS TO TRANS-ACCT
               MOVE "0000" TO TRANS-DEPT
           ELSE
               IF MATL-ACCOUNT = SPACES
                   MOVE TC436-EXP-CLASS TO TRANS-ACCT
               ELSE
                   IF TC436-EXP-CLASS = "000290"
                       MOVE TC436-EXP-CLASS TO TRANS-ACCT
                   ELSE
                       MOVE MATL-ACCOUNT TO TRANS-ACCT.
           IF MCHT-DEPT-TYPE = "CL"
               MOVE SPACES TO TRANS-ACCT.
           MOVE SPACES           TO TRANS-PO-NUM
                                    TRANS-RCVR-NUM
                                    TRANS-ITEM-NUM.
           MOVE "RET"            TO TRANS-CODE.
           MOVE DDAILYTC-DATE    TO TRANS-DATE.
      *------------- ACCOUNT FOR CENTURY.
           IF TRANS-YY > "70"
               MOVE "19"         TO TRANS-DATE-CC
           ELSE
               MOVE "20"         TO TRANS-DATE-CC.
           MOVE DDAILYTC-TIME    TO TRANS-TIME.
           MOVE TC436-EMPL       TO TRANS-EMP.
           MOVE TC436-QTY        TO TRANS-QTY.
           PERFORM 560-GET-MSTORERM.
           IF NO-ENTRY
               MOVE TC436-AVG-COST TO STR-STD-COST
                                      STR-AVG-COST
           ELSE
               NEXT SENTENCE.
           IF MCHT-DEPT-TYPE = "PR"
               IF (TRANS-CLASS > 099 AND TRANS-CLASS < 200) OR
                  (TRANS-CLASS > 399 AND TRANS-CLASS < 500)
                   COMPUTE TRANS-VALUE ROUNDED = TC436-QTY *
                                         STR-STD-COST
                     IF TRANS-CLASS = 206
                         NEXT SENTENCE
                     ELSE
                          COMPUTE AVG-VALUE ROUNDED =
                              TC436-QTY * STR-AVG-COST
                         COMPUTE MATL-RTN-DOLLARS = MATL-RTN-DOLLARS +
                            AVG-VALUE
                ELSE
                    COMPUTE TRANS-VALUE ROUNDED = TC436-QTY *
                                          STR-AVG-COST
                     IF TRANS-CLASS = 206
                         NEXT SENTENCE
                     ELSE
                         ADD TRANS-VALUE TO MATL-RTN-DOLLARS
           ELSE
               COMPUTE TRANS-VALUE ROUNDED = TC436-QTY *
                                     STR-AVG-COST
                IF TRANS-CLASS = 206
                    NEXT SENTENCE
                ELSE
                   ADD TRANS-VALUE TO MATL-RTN-DOLLARS.
           MOVE TC436-UM TO TRANS-UNIT-MEASURE.
           MOVE 0 TO TRANS-BALANCE-QTY.
           MOVE SPACES TO TRANS-DOCUMENT-NUM.
           ADD TC436-QTY TO MATL-RTN-UNITS.
           MOVE TRANS-DATE-CN           TO MATL-DATE-LAST-UPDATE-CN.
           MOVE "N"                     TO SUCCESSFUL-PUT-SW.
           PERFORM 500-PUT-DTRANS
               UNTIL SUCCESSFUL-PUT.
           PERFORM 550-UPDATE-MMATL-ACCUM.
           ADD 1 TO 4XX-COUNT.
           DISPLAY 4XX-COUNT, ":  TRANSACTION  436  PROCESSED --  ",
                   "CORPORATE CODE  ", TC436-CORP-CODE.
           DISPLAY BUF-TC436.

