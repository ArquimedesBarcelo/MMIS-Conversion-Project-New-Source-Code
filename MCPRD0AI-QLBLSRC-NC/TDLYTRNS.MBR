298300         WRITE ERR-REC FROM PRT-ERROR-LINE1 AFTER 1
298400         WRITE ERR-REC FROM BLANK-LINE AFTER 1
298500         ADD 3 TO LINE-CNT-ERR
298600         IF LINE-CNT-ERR > 55
298700             PERFORM 996-PRINT-ERR-HEADINGS
298800         ELSE
298900             NEXT SENTENCE
299000     ELSE
299100         IF SORT-ERR-CODE = 2
