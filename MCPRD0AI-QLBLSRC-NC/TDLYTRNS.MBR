      ******************************************************************
      * 218-PROCESS-423-424:                          11/14/1994       *
      *  THIS PARAGRAPH CHANGES A 423 OR 424 TRANSACTION INTO ITS      *
      *  RESPECTIVE 3XX TRANSACTION.  THE LARGEST VALUE POSSIBLE IS    *
      *  MOVED INTO THE UNIT PRICE FIELD OF THE 3XX TRANSACTION.  A    *
      *  MESSAGE IS DISPLAYED SHOWING THE VALUE OF THE FIELD BEFORE    *
      *  AND AFTER THE CHANGE.                                         *
      ******************************************************************

       218-PROCESS-423-424.
           MOVE BUF-TC423               TO SAVE-TC423-424.
           INITIALIZE                   BUF-TC323.
           MOVE DDAILYTC-TC             TO DISPLAY-TC.
           MOVE SAVE-423-UNIT-PRICE     TO DISPLAY-UNIT-PRICE.
           IF DDAILYTC-TC = "423"
               MOVE "323"               TO DDAILYTC-TC
           ELSE
               MOVE "324"               TO DDAILYTC-TC.
           MOVE SAVE-423-CORPCODE       TO TC323-CORPCODE.
           MOVE SAVE-423-RS             TO HOLD-RS.
           MOVE "P"                     TO HOLD-PO-PREFIX.
           MOVE HOLD-PO-FULL            TO TC323-RS.
           MOVE SAVE-423-ITEM           TO TC323-ITEM.
           MOVE SAVE-423-CODED-RCV-QTY      TO TC323-CODED-RCV-QTY.
           MOVE SAVE-423-UM             TO TC323-UM.
           MOVE 9000000.00              TO TC323-UNIT-PRICE.
           MOVE SAVE-423-PRIME          TO TC323-PRIME.
           MOVE SAVE-423-SUB            TO TC323-SUB.
           MOVE SAVE-423-SUB-DETAIL     TO TC323-SUB-DETAIL.
           MOVE SAVE-423-ADDL-DATA      TO TC323-ADDL-DATA.
           MOVE SAVE-423-CURRENCY-CODE  TO TC323-CURRENCY-CODE.
           MOVE SAVE-423-FLAG-AREA      TO TC323-FLAG-AREA.
           ADD 1 TO 4XX-COUNT.
           DISPLAY 4XX-COUNT, ":  TRANSACTION  ", DISPLAY-TC,
                          "  CHANGED TO  ", DDAILYTC-TC.
           DISPLAY "        UNIT PRICE VALUE  ", DISPLAY-UNIT-PRICE,
                                          "  CHANGED TO $9,000,000.00".
           DISPLAY "        CORPORATE CODE  ", SAVE-423-CORPCODE.
           DISPLAY BUF-TC323.

      ******************************************************************
      * 219-PROCESS-425:                              11/14/1994       *
      *  THIS PARAGRAPH CHANGES A 425 TRANSACTION INTO A 325 TRANS-    *
      *  ACTION.  THE LARGEST VALUE POSSIBLE IS MOVED INTO THE UNIT    *
      *  PRICE FIELD OF THE 325 TRANSACTION.  A MESSAGE IS DISPLAYED   *
      *  SHOWING THE VALUE OF THE FIELD BEFORE AND AFTER THE CHANGE.   *
      ******************************************************************

       219-PROCESS-425.
           MOVE BUF-TC425               TO SAVE-TC425.
           INITIALIZE                   BUF-TC325.
           MOVE DDAILYTC-TC             TO DISPLAY-TC.
           MOVE SAVE-425-PO-UNIT-PRICE  TO DISPLAY-UNIT-PRICE.
           MOVE "325"                   TO DDAILYTC-TC.
           MOVE SAVE-425-CORPCODE       TO TC325-CORPCODE.
           MOVE SAVE-425-RS             TO HOLD-RS.
           MOVE "P"                     TO HOLD-PO-PREFIX.
           MOVE HOLD-PO-FULL            TO TC325-RS.
           MOVE SAVE-425-ITEM           TO TC325-ITEM.
           MOVE SAVE-425-STORED-QTY     TO TC325-STORED-QTY.
           MOVE SAVE-425-UM             TO TC325-UM.
           MOVE 9000000.00              TO TC325-PO-UNIT-PRICE.
           MOVE SAVE-425-KELLY-SEQ      TO TC325-KELLY-SEQ.
           MOVE SAVE-425-CLASS          TO TC325-CLASS.
           MOVE SAVE-425-CORRECTION-FLAG   TO TC325-CORRECTION-FLAG.
           MOVE SAVE-425-CURRENCY-CODE     TO TC325-CURRENCY-CODE.
           MOVE SAVE-425-FRAN-ID           TO TC325-FRAN-ID.
           ADD 1 TO 4XX-COUNT.
           DISPLAY 4XX-COUNT, ":  TRANSACTION  ", DISPLAY-TC,
                   "  CHANGED TO  ", DDAILYTC-TC.
           DISPLAY "        UNIT PRICE VALUE  ", DISPLAY-UNIT-PRICE,
                                          "  CHANGED TO $9,000,000.00".
           DISPLAY "        CORPORATE CODE  ", TC425-CORPCODE.
