       IDENTIFICATION DIVISION.
       PROGRAM-ID. SASBWARN.
       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.
       SOURCE-COMPUTER. AS400.
       OBJECT-COMPUTER. AS400.

      *D*************************************************************
      *D  16-SEP-1994    WILL MCINTYRE    REQUEST#: 94-040
      *D  SASBWARN - DISPLAY ASBESTOS WARNING MESSAGE SCREEN
      *D     THIS PROGRAM, WHEN PASSED A MESSAGE CODE WILL DISPLAY
      *D     THE ASSOCIATED ASBESTOS WARNING MESSAGE, OR DEFULT TO
      *D     A GENERIC MESSAGE.
      *D*************************************************************
      *C 11-JAN-1995     WILL MCINTYRE    REQUEST#: 94-040
      *C    REVISE PROGRAM TO BETTER ACCOMODATE EMPTY MESSAGE FILE
      *C*************************************************************

       SPECIAL-NAMES. I-O-FEEDBACK IS I-O-FEEDBACK-AREA.
       INPUT-OUTPUT SECTION.

       FILE-CONTROL.
           SELECT DISPLAY-FILE
               ASSIGN TO WORKSTATION-ZASBESTOS-SI
               ORGANIZATION IS TRANSACTION
               FILE STATUS IS FILE-STATUS
               CONTROL-AREA IS WS-CONTROL.

           SELECT MASBMSG
               ASSIGN TO DATABASE-MCFLMM4801
               ORGANIZATION IS INDEXED
               ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
               FILE STATUS IS FILE-STATUS.

           SELECT MEQPFILE
               ASSIGN TO DATABASE-MCFLMM0201
               ORGANIZATION IS INDEXED
               ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
               FILE STATUS IS FILE-STATUS.

       DATA DIVISION.
       FILE SECTION.
       FD  DISPLAY-FILE
           LABEL RECORDS ARE OMITTED.
       01  DSPLY-REC                   PIC X(2000).

       FD  MASBMSG
           LABEL RECORDS ARE STANDARD.
       01  MASBMSG-REC.
           COPY DDS-ALL-FORMATS OF MCFLMM4801.

       FD  MEQPFILE
           LABEL RECORDS ARE STANDARD.
       01  MEQPFILE-REC.
           COPY DDS-ALL-FORMATS OF MCFLMM0201.

       WORKING-STORAGE SECTION.

       77  BASE                       PIC X(10).

       COPY CATREAD    OF COPYLIB.
       COPY MASBMSG    IN COPYLIB.
       COPY TDATECHK   IN COPYLIB.
       COPY LANGSUB    IN COPYLIB.
       COPY CPYIND     OF COPYLIB.
       COPY IOFEEDBACK OF COPYLIB.
       COPY WSCONTROL  OF COPYLIB.
       COPY TBLOWUP    OF COPYLIB.
       COPY VCOMLINK   OF COPYLIB.

       COPY DBSTAT IN COPYLIB.

       01  BUF-MEQPFILE.
           COPY MEQPFILE IN COPYLIB.

       01  FILE-STATUS.
           05  FILE-STATUS-1             PIC X     VALUE "0".
           05  FILE-STATUS-2             PIC X     VALUE "0".

       01  SWITCHES.
           05  EOF-SW                    PIC X     VALUE "N".

       01  WS-DISPLAY-AREA.
           05    FILLER                  PIC XX.
           05  WS-DISPLAY-MSG            PIC X(27).
           05    FILLER                  PIC XX.
           05  WS-DISPLAY-STAT           PIC S9(4).
           05    FILLER                  PIC XX.
           05  WS-DISPLAY-FLD            PIC X(14).
           05    FILLER                  PIC XX.

       01  DEFAULT-MESSAGE               PIC X(79)  VALUE
            "                                          ".

       01  WS-DEFAULT-MESSAGES.
           05  WS-DEFAULT1               PIC X(70)  VALUE
                "*************G E N E R I C   W A R N I N G   M E S S A
      -         "G E************".
           05  WS-DEFAULT2               PIC X(70)  VALUE
                "****  THIS EQUIPMENT OR SURROUNDING AREA HAS ASBESTOS C
      -         "ONTAINING  ****".
           05  WS-DEFAULT3               PIC X(70)  VALUE
                "****  MATERIAL.  VERIFY EXACT LOCATION BEFORE PROCEEDIN
      -         "G AND      ****".
           05  WS-DEFAULT4               PIC X(70)  VALUE
                "****  FOLLOW APPROPRIATE PROCEDURES.
      -         "           ****".
           05  WS-DEFAULT5               PIC X(70)  VALUE ALL "*".

       01  MESSAGE-BUFFER.
           05  FILLER                    PIC X(80).

       01  WS-SCREEN.
           05  DISP-EQUIP-CODE           PIC X(06).
           05  DISP-LOCAL-NAME           PIC X(50).
           05  DISP-CORP-NAME            PIC X(50).
           05  DISP-MESSAGE1             PIC X(70).
           05  DISP-MESSAGE2             PIC X(70).
           05  DISP-MESSAGE3             PIC X(70).
           05  DISP-MESSAGE4             PIC X(70).
           05  DISP-MESSAGE5             PIC X(70).
           05  DISP-COMMAND-LINE         PIC X(79).
           05  DISP-MESSAGE-LINE         PIC X(79).

      ***************************************
      *     L I N K A G E  S E C T I O N    *
      ***************************************
       LINKAGE SECTION.

       01  PASS-EQPNUM                   PIC X(06).

       PROCEDURE DIVISION  USING
                                 PASS-EQPNUM.

       START-PROGRAM.
           PERFORM 1-HOUSEKEEPING THRU 1-EXIT.
           PERFORM 6-MAIN         THRU 6-EXIT
           PERFORM 2-END-OF-JOB   THRU 2-EXIT.

       1-HOUSEKEEPING.
           MOVE "FWARNMSG" TO VIEW-NFNAME.
           MOVE SPACES TO BUF-MASBMSG.
           MOVE ZEROS  TO STATUS-AREA.
           MOVE ZEROS  TO FILE-STATUS.
           MOVE SPACES TO WS-SCREEN.
           MOVE "N"    TO   EOF-SW.
           OPEN I-O DISPLAY-FILE.
           OPEN INPUT MASBMSG MEQPFILE.
           MOVE SPACES       TO BU-DISPLAY-MSG.

           MOVE 1                        TO  DATE-MODE.
           CALL "TDATECK2" USING DATE-CHECK-AREA, LANGUAGE-PARMS.

       1-EXIT.
           EXIT.

       2-END-OF-JOB.
           CLOSE MASBMSG MEQPFILE.
           CLOSE DISPLAY-FILE.
           GOBACK.
       2-EXIT.
           EXIT.

       2-BLOWUP.
           MOVE "SASBWARN" TO BU-PGM-NAME.
           CALL "TBLOWUP" USING BASE, BU-PGM-NAME, STATUS-AREA,
             VIEW-COMAREA, FILE-STATUS, BU-DISPLAY-MSG, BU-DISPLAY-AREA.

       6-MAIN.
           MOVE SPACES TO MEQPFILE-REC.
           MOVE PASS-EQPNUM TO EQPNUM OF MEQPFILE-REC.
           START MEQPFILE KEY NOT < EQPNUM OF MEQPFILE-REC
             INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
              PERFORM 2-END-OF-JOB THRU 2-EXIT.
           READ MEQPFILE NEXT INTO BUF-MEQPFILE
             AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
              PERFORM 2-END-OF-JOB THRU 2-EXIT.
           IF EQP-EQUIP-NUM NOT = PASS-EQPNUM
              PERFORM 2-END-OF-JOB THRU 2-EXIT.
           IF EQP-ASBESTOS-FLG = SPACES
              PERFORM 2-END-OF-JOB THRU 2-EXIT.

           MOVE 0 TO COND-WORD.

           MOVE EQP-ASBESTOS-FLG TO MSGCODE OF MASBMSG-REC.

           READ MASBMSG INTO BUF-MASBMSG
             AT END MOVE FILE-STATUS TO FILE-STATUS.

           MOVE SPACES TO WS-SCREEN.
           MOVE PASS-EQPNUM      TO DISP-EQUIP-CODE.
           MOVE EQP-EQUIP-NAME   TO DISP-LOCAL-NAME.
           MOVE EQP-CORP-DESC    TO DISP-CORP-NAME.
           IF  ASB-MSG-CODE = EQP-ASBESTOS-FLG
           AND FILE-STATUS  = "00"
              MOVE ASB-MESSAGE1 TO DISP-MESSAGE1
              MOVE ASB-MESSAGE2 TO DISP-MESSAGE2
              MOVE ASB-MESSAGE3 TO DISP-MESSAGE3
              MOVE ASB-MESSAGE4 TO DISP-MESSAGE4
              MOVE ASB-MESSAGE5 TO DISP-MESSAGE5
           ELSE
              MOVE WS-DEFAULT1  TO DISP-MESSAGE1
              MOVE WS-DEFAULT2  TO DISP-MESSAGE2
              MOVE WS-DEFAULT3  TO DISP-MESSAGE3
              MOVE WS-DEFAULT4  TO DISP-MESSAGE4
              MOVE WS-DEFAULT5  TO DISP-MESSAGE5.

       6-PUT-BUFFER.
           MOVE WS-SCREEN TO DSPLY-REC.

       6-SHOW.
           PERFORM 99-SCREEN-WRITE THRU 99-EXIT.

       6-READ.
           PERFORM 98-SCREEN-READ  THRU 98-EXIT.
           MOVE SPACES TO DISP-MESSAGE-LINE.

       6-EXIT.
           EXIT.

       98-SCREEN-READ.
           READ DISPLAY-FILE FORMAT IS VIEW-NFNAME
               INDICATORS ARE INDICS.
           ACCEPT IOFEEDBACK FROM I-O-FEEDBACK-AREA.
           MOVE ALL B"0" TO INDICS.
           IF FILE-STATUS NOT = "00"
             MOVE 3 TO VIEW-LASTKEY
           ELSE
             MOVE FUNCTION-NUM TO VIEW-LASTKEY.
       98-EXIT.
           EXIT.

       99-SCREEN-WRITE.
           WRITE DSPLY-REC FORMAT IS VIEW-NFNAME
               INDICATORS ARE INDICS.
       99-EXIT.
           EXIT.

       999-CATREAD.
           MOVE SPACES TO MESSAGE-BUFFER.
           CALL "CCATREAD" USING CATREAD-PARMS.
           MOVE CATREAD-MSG-TEXT TO MESSAGE-BUFFER.

       999-CATREAD-EXIT.
           EXIT.

       9999-MOVE-CATREAD-MSG.
            MOVE B"1" TO INDS (99).
            IF CATREAD-MSG-TEXT = SPACES
               MOVE DEFAULT-MESSAGE TO DISP-MESSAGE-LINE
            ELSE
               MOVE MESSAGE-BUFFER  TO DISP-MESSAGE-LINE
            END-IF.
            MOVE SPACES TO MESSAGE-BUFFER.

       9999-EXIT.
            EXIT.
