       IDENTIFICATION DIVISION.
       PROGRAM-ID.    TMTITLES.
      *C
      *C  SEPT 06, 1996    CA YODER
      *C   RE-COMPILED PROGRAM TO PICK UP CENTURY DATABASE CHANGES.
      *C
       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.
       SOURCE-COMPUTER.   AS400.
       OBJECT-COMPUTER.   AS400.
       COPY SPECIALN IN COPYLIB.
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT MASTER-JOBPLAN
               ASSIGN TO DATABASE-MCFLMM3501
               ORGANIZATION IS SEQUENTIAL
               ACCESS MODE IS SEQUENTIAL
               FILE STATUS IS MJ-STATUS.
           SELECT MASTER-PRTPLAN
               ASSIGN TO DATABASE-MCFLMM3701
               ORGANIZATION IS SEQUENTIAL
               ACCESS MODE IS SEQUENTIAL
               FILE STATUS IS MP-STATUS.
           SELECT PFILE ASSIGN TO PRINTER-MCPRT.
           SELECT SFILE ASSIGN TO DISK-SORTFILE.
           SELECT WO-LAST-NUM-USED
               ASSIGN TO DATABASE-MCFPMM0800
               ORGANIZATION IS RELATIVE
               ACCESS MODE IS RANDOM
               RELATIVE KEY IS ARG-NO
               FILE STATUS IS WLNU-STATUS.
       DATA DIVISION.
       FILE SECTION.
       FD  MASTER-JOBPLAN
           LABEL RECORD IS STANDARD
           DATA RECORD IS MJREC.
       01  MJREC.
           COPY DDS-ALL-FORMATS OF MCFLMM3501.
       FD  MASTER-PRTPLAN
           LABEL RECORDS ARE STANDARD
           DATA RECORD IS MPREC.
       01  MPREC.
           COPY DDS-ALL-FORMATS OF MCFLMM3701.
       FD  PFILE
           RECORD CONTAINS 80 CHARACTERS
           LABEL RECORD IS OMITTED
           DATA RECORD IS P-REC.
       01  P-REC                   PIC X(80).
       SD  SFILE
           RECORD CONTAINS 44 CHARACTERS
           DATA RECORD IS S-REC.
       01  S-REC.
           05 S-ORIG               PIC X(4).
           05 S-NAME               PIC X(10).
           05 S-TITLE              PIC X(30).
       FD  WO-LAST-NUM-USED
           LABEL RECORDS ARE STANDARD
           DATA RECORD IS WLNUREC.
       01  WLNUREC.
           COPY DDS-ALL-FORMATS OF MCFPMM0800.
       WORKING-STORAGE SECTION.

       01  ARG-NO                  PIC 9(9).

       01  CURR-RECS               PIC 99.

       COPY TDATESUB OF COPYLIB.

       01  DATE-VALUE              PIC X(8).

       01  DBPARAMETERS.           COPY DBPARMS  OF COPYLIB.

       COPY ESCNAM2 IN COPYLIB.

       01  FILE-STATUSES.
           05  MJ-STATUS           PIC XX.
           05  MP-STATUS           PIC XX.
           05  WLNU-STATUS         PIC XX.

       01  GENERIC-PLANS.          COPY MMASTJOB OF COPYLIB.

       COPY LANGSUB  OF COPYLIB.

       01  LAST-WO-USED-DATA.      COPY MLASTWO  OF COPYLIB.

       01  NORMAL-PRINT            PIC X(8).

       01  OPEN-SW                 PIC X VALUE "N".

       COPY OVRPFDATA IN COPYLIB.

       01  PAGE-NUM                PIC 9999.

       01  PAGE-RECS               PIC 99.

       01  SORT-FILE-SW            PIC X VALUE "N".
           88 END-OF-SORT-FILE           VALUE "Y".

       01  SAVE-ORIG               PIC X(4).

       COPY DBSTAT   OF COPYLIB.

       LINKAGE SECTION.
       01  ACCEPT-FIELDS.
           05 TITLE-FIELD          PIC X.
           05 ORIG-FIELD           PIC X(4).
           05 SPOOLER-FIELD        PIC 9(3).
           05 INCH-FIELD           PIC X.
       PROCEDURE DIVISION USING ACCEPT-FIELDS.
       START-PROGRAM.
           PERFORM 1-HSK.
           PERFORM 6-MAIN.
       2-EOJ.
           IF OPEN-SW = "Y"
             MOVE SPACES TO P-REC
             WRITE P-REC FROM NORMAL-PRINT AFTER ADVANCING NEW-PAGE
             CLOSE PFILE.
           CLOSE MASTER-JOBPLAN.
           CLOSE MASTER-PRTPLAN.
           CLOSE WO-LAST-NUM-USED.
           GOBACK.

       1-HSK.
           OPEN INPUT MASTER-JOBPLAN.
           OPEN INPUT MASTER-PRTPLAN.
           OPEN INPUT WO-LAST-NUM-USED.
           MOVE 0 TO COND-WORD.
           MOVE 1 TO ARG-NO.
           READ WO-LAST-NUM-USED INTO LAST-WO-USED-DATA
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF WLNU-STATUS NOT = "00" MOVE 17 TO COND-WORD.
           IF COND-WORD = 17 MOVE 1 TO DATE-FLAG-SW.
           MOVE DATE-FLAG-SW TO DATE-CODE DATE-FLAG.
           MOVE 1 TO DATE-MODE.
           CALL "TDATECK2" USING DATE-CHECK-AREA LANGUAGE-PARMS.
           MOVE DATE-SLASH-OUT TO DATE-VALUE.
           IF INCH-FIELD = "6" MOVE 50 TO PAGE-RECS
           ELSE
           IF INCH-FIELD = "8" MOVE 70 TO PAGE-RECS.
           CALL "TESCSEQ" USING ESC-NAME.
           MOVE SPOOLER-FIELD TO OVRPRTF-TOFILE-NUM.
           PERFORM 996-OVERRIDE-PRINT-FILE.
           OPEN OUTPUT PFILE.
           MOVE "Y" TO OPEN-SW.

       6-MAIN.
           SORT SFILE ON ASCENDING KEY S-ORIG S-NAME
            INPUT  PROCEDURE INPUT-RECORDS
            OUTPUT PROCEDURE OUTPUT-RECORDS.

       INPUT-RECORDS.
           PERFORM READ-NAMES UNTIL COND-WORD = 11.

       READ-NAMES.
           IF TITLE-FIELD = "J"
             MOVE 0 TO COND-WORD
             READ MASTER-JOBPLAN INTO GENERIC-PLANS
                 AT END    MOVE 11 TO COND-WORD
           ELSE
           IF TITLE-FIELD = "M"
             MOVE 0 TO COND-WORD
             READ MASTER-PRTPLAN INTO GENERIC-PLANS
                 AT END    MOVE 11 TO COND-WORD.

           IF ORIG-FIELD = SPACES
             MOVE MJOBPLAN-NAME TO S-NAME
             MOVE MJOBPLAN-TITLE TO S-TITLE
             MOVE MJOBPLAN-ORIG TO S-ORIG
             RELEASE S-REC
           ELSE
           IF MJOBPLAN-ORIG = ORIG-FIELD
             MOVE MJOBPLAN-NAME TO S-NAME
             MOVE MJOBPLAN-TITLE TO S-TITLE
             MOVE MJOBPLAN-ORIG TO S-ORIG
             RELEASE S-REC.


       OUTPUT-RECORDS.
           RETURN SFILE
            AT END
              DISPLAY "NO RECORDS IN SORT FILE"
              GO TO 2-EOJ.

           MOVE S-ORIG TO SAVE-ORIG.
           MOVE 0 TO PAGE-NUM.
           MOVE 99 TO CURR-RECS.

           PERFORM WRITE-NAMES UNTIL END-OF-SORT-FILE.

       WRITE-NAMES.
           IF S-ORIG NOT = SAVE-ORIG

           OR CURR-RECS > PAGE-RECS

             PERFORM WRITE-NEW-PAGE.

           MOVE SPACES TO P-REC.

           IF CURR-RECS = 1
             STRING "     "       S-ORIG
                    "           " S-NAME
                    "     "       S-TITLE DELIMITED BY SIZE INTO P-REC
           ELSE
             STRING "                    " S-NAME
                    "     "                S-TITLE
                                          DELIMITED BY SIZE INTO P-REC.
           WRITE P-REC.

           ADD 1 TO CURR-RECS.

           RETURN SFILE
            AT END
              MOVE "Y" TO SORT-FILE-SW.

       WRITE-NEW-PAGE.
           ADD 1 TO PAGE-NUM.
           MOVE SPACES TO P-REC.
           STRING "PAGE " PAGE-NUM   DELIMITED BY SIZE INTO P-REC.
           WRITE P-REC AFTER ADVANCING NEW-PAGE.
           MOVE SPACES TO P-REC.
           STRING "DATE " DATE-VALUE DELIMITED BY SIZE INTO P-REC.
           WRITE P-REC.

           MOVE SPACES TO P-REC.
           IF TITLE-FIELD = "J"
             STRING "                     "
                    "*** GENERIC JOB PLANS BY ORIGINATOR ***"
              DELIMITED BY SIZE INTO P-REC
           ELSE
             STRING "                    "
                    "*** GENERIC PART PLANS BY ORIGINATOR ***"
              DELIMITED BY SIZE INTO P-REC.
           WRITE P-REC.

           MOVE SPACES TO P-REC.
           WRITE P-REC.
           WRITE P-REC.

           STRING "     " "Originator"
                  "     " "Name      "
                  "     " "Title     "
            DELIMITED BY SIZE INTO P-REC.
           WRITE P-REC.

           MOVE SPACES TO P-REC.
           WRITE P-REC.

           MOVE 1 TO CURR-RECS.
           MOVE S-ORIG TO SAVE-ORIG.

       COPY OVRPFCALL IN COPYLIB.
