061100
061200     IF STRT-SW = "Y" AND RECD-NUM = "Y" AND STRT-NUM = "Y"
061300         NEXT SENTENCE
061400     ELSE
061500     GO TO 8611-CONT.
061600
061700     MOVE ZONE TO ZONE-BUF-LINK.
061800     MOVE TIME-STRT TO TIME-IN
061900     CALL "TGETSHFT" USING LINK-DATA
062000                           DBPARAMETERS
062200     MOVE CURR-SHIFT TO SHFT-SORT.
062300
062400     IF JUL-DAY-RECD > JUL-DAY-STRT
062500         MOVE DAYS-LAST-YEAR TO JUL-DAY-SAVE
062600     ELSE
062700     MOVE 0 TO JUL-DAY-SAVE.
062800     IF JUL-DAY-RECD NOT = JUL-DAY-STRT
062900         ADD JUL-DAY-STRT TO JUL-DAY-SAVE
063000         SUBTRACT JUL-DAY-RECD FROM JUL-DAY-SAVE
063100         MULTIPLY 1440 BY JUL-DAY-SAVE.
063200     MULTIPLY 60 BY TIME-RECD-HH GIVING TRECD-MIN.
063300     ADD TIME-RECD-MM TO TRECD-MIN.
063400     MULTIPLY 60 BY TIME-STRT-HH GIVING TSTRT-MIN.
063500     ADD TIME-STRT-MM TO TSTRT-MIN.
063600     SUBTRACT TRECD-MIN FROM TSTRT-MIN GIVING TSAVE-MIN.
063700     ADD JUL-DAY-SAVE TO TSAVE-MIN.
063800     IF TSAVE-MIN > 480 GO TO 8611-CONT.
064000     MOVE TSAVE-MIN TO RESP-SORT.
064100     RELEASE SORT-REC.
064200
064300 8611-CONT.
064500     MOVE 0 TO RECD-SORT STRT-SORT COMP-SORT RESP-SORT WORK-SORT.
064700     IF COMP-SW = "Y" AND STRT-NUM = "Y" AND COMP-NUM = "Y"
064800         NEXT SENTENCE
064900     ELSE
065000     GO TO 8611-CN-EXIT.
065100
065200     MOVE ZONE TO ZONE-BUF-LINK.
065300     MOVE TIME-COMP TO TIME-IN
065400     CALL "TGETSHFT" USING LINK-DATA
065500                           DBPARAMETERS.
065700     MOVE CURR-SHIFT TO SHFT-SORT.
065900     IF JUL-DAY-STRT > JUL-DAY-COMP
066000         MOVE DAYS-LAST-YEAR TO JUL-DAY-SAVE
066100     ELSE
066200     MOVE 0 TO JUL-DAY-SAVE.
066300     IF JUL-DAY-STRT NOT = JUL-DAY-COMP
066400         ADD JUL-DAY-COMP TO JUL-DAY-SAVE
066500         SUBTRACT JUL-DAY-STRT FROM JUL-DAY-SAVE
066600         MULTIPLY 1440 BY JUL-DAY-SAVE.
066700     MULTIPLY 60 BY TIME-COMP-HH GIVING TCOMP-MIN.
066800     ADD TIME-COMP-MM TO TCOMP-MIN.
066900     MULTIPLY 60 BY TIME-STRT-HH GIVING TSTRT-MIN.
067000     ADD TIME-STRT-MM TO TSTRT-MIN.
067100     SUBTRACT TSTRT-MIN FROM TCOMP-MIN GIVING TSAVE-MIN.
067200     ADD JUL-DAY-SAVE TO TSAVE-MIN.
067300     IF TSAVE-MIN > 480 GO TO 8611-CN-EXIT.
067500     MOVE TSAVE-MIN TO WORK-SORT.
067600     RELEASE SORT-REC.
067700
067800 8611-CN-EXIT.    EXIT.
068000
       89-READ-WO-BASIC-FILE.
           MOVE 0 TO COND-WORD.
           READ WO-BASIC-FILE NEXT INTO WO-BASIC-DATA
               AT END    MOVE 15 TO COND-WORD.
           IF WOSTATUS OF WBFREC NOT = STAT (S1) MOVE 15 TO COND-WORD.
           IF WBF-STATUS NOT = "00" MOVE 15 TO COND-WORD.

       89-START-WO-BASIC-FILE.
           MOVE 0 TO COND-WORD.
           MOVE STAT (S1) TO WOSTATUS OF WBFREC.
           START WO-BASIC-FILE KEY IS = EXTERNALLY-DESCRIBED-KEY
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF WBF-STATUS NOT = "00" MOVE 17 TO COND-WORD.

