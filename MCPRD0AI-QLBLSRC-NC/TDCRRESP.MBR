029400 01  WORK-CNTR                     PIC 9(10) COMP-4.
029500 01  WO-BASIC-DATA.                COPY DWOBASIC OF COPYLIB.
029600 01  WRITE-K                       PIC 9(4) VALUE 0.
029700 01  ZONE-TABLE.
029800     05 ZT OCCURS 100 TIMES.
029900        10 TZONE                   PIC X(4).
030000        10 EQPNUMS.
030100           15 TEQPNUM OCCURS 5 TIMES
030200                                   PIC X(6).
030300        10 CRAFTS.
030400           15 TCRAFT  OCCURS 5 TIMES
030500                                   PIC X(2).
030800 PROCEDURE DIVISION.
031000 BEGIN-PROC.
           OPEN INPUT  R4FILE.
           OPEN INPUT  WO-BASIC-FILE.
           OPEN INPUT  WO-LAST-NUM-USED.
031300     MOVE SPACES TO ZONE-TABLE.
030900     ACCEPT DATE-BUFF FROM DATE.
031000     ACCEPT TIME-BUFF FROM TIME.
           MOVE YR-BUFF-9 TO STOP-YY.
           MOVE MTH-BUFF-9 TO STOP-MM.
           MOVE DAY-BUFF-9 TO STOP-DD.
           MOVE TIME-HHMM TO STOP-TIME.
031300     MOVE MTH-BUFF-9 TO GREG-MM.
031400     MOVE DAY-BUFF-9 TO GREG-DD.
031500     MOVE YR-BUFF-9  TO GREG-YY.
           IF GREG-YY > "70"
               MOVE "19"   TO GREG-CC
           ELSE
           MOVE "20"       TO GREG-CC.
031700     CALL "JULGREG" USING GREG-DATE, JULIAN-DATE,
                            DAY-DIGIT, LEAP-YEAR-FLAG.
           IF JULIAN-DATE-9 > 1
031800         SUBTRACT 1 FROM JULIAN-DATE-9
           ELSE
032000         MOVE 12 TO GREG-MM
032100         MOVE 31 TO GREG-DD
032200         SUBTRACT 1 FROM GREG-YY-9
               MOVE SPACES TO JULIAN-DATE
               IF GREG-YY > "70"
                   MOVE "19" TO GREG-CC
032300             CALL "JULGREG" USING GREG-DATE, JULIAN-DATE,
                                    DAY-DIGIT, LEAP-YEAR-FLAG
               ELSE
               MOVE "20" TO GREG-CC
               CALL "JULGREG" USING GREG-DATE, JULIAN-DATE
                                DAY-DIGIT, LEAP-YEAR-FLAG.
           MOVE SPACES TO GREG-DATE.
032500     CALL "JULGREG" USING GREG-DATE, JULIAN-DATE,
                            DAY-DIGIT, LEAP-YEAR-FLAG.
032800     MOVE GREG-YY TO STRT-YY.
032900     MOVE GREG-MM TO STRT-MM.
033000     MOVE GREG-DD TO STRT-DD.
033100     MOVE TIME-HHMM TO STRT-TIME.
033300     MOVE MTH-BUFF-9 TO GREG-MM.
033400     MOVE DAY-BUFF-9 TO GREG-DD.
033500     MOVE YR-BUFF-9  TO GREG-YY.
           MOVE SPACES     TO JULIAN-DATE.
           IF GREG-YY > "70"
               MOVE "19"   TO GREG-CC
           ELSE
           MOVE "20"       TO GREG-CC.
033700     CALL "JULGREG" USING GREG-DATE, JULIAN-DATE,
                            DAY-DIGIT, LEAP-YEAR-FLAG.
033800     MOVE 12 TO GREG-MM.
033900     MOVE 31 TO GREG-DD.
034000     SUBTRACT 1 FROM GREG-YY-9.
           MOVE SPACES TO JULIAN-DATE.
034100     CALL "JULGREG" USING GREG-DATE, JULIAN-DATE,
                            DAY-DIGIT, LEAP-YEAR-FLAG.
034200     MOVE JULIAN-DATE-9 TO DAYS-LAST-YEAR.
028900     MOVE SPACES TO ZONE-TABLE.
           MOVE SPACES TO R4-BUFFER.
029100     PERFORM 1-LOAD-OPTIONS THRU 1-LO-EXIT.
           CLOSE R4FILE.
           CALL "MCDLT" USING DELETE-FILE.
031600     SORT SORT-FILE
031700        ASCENDING KEY  ZONE-SORT  CRFT-SORT  SHFT-SORT  PRTY-SORT
031800        INPUT  PROCEDURE 8-INPUT-RECORDS
031900        OUTPUT PROCEDURE 9-WRITE-RECORDS.
032100
032300 2-EOJ.
089000     WRITE PRINTF FROM NORMAL-PRINT AFTER ADVANCING 0 LINES.
           CLOSE PRINT-FILE.
           CLOSE WO-BASIC-FILE.
           CLOSE WO-LAST-NUM-USED.
032900     GOBACK.

035500 1-LOAD-OPTIONS.
           READ R4FILE INTO R4-BUFFER AT END GO TO 1-LO-EXIT.
           IF R4-BUFFER = SPACES GO TO 1-LO-EXIT.
           MOVE R4-DATE-TIME-S TO START-DATE.
           IF STRT-YY > "70"
               MOVE "19" TO STRT-CC
           ELSE
           MOVE "20"     TO STRT-CC.
           READ R4FILE INTO R4-BUFFER AT END GO TO 1-LO-EXIT.
           IF R4-BUFFER = SPACES GO TO 1-LO-EXIT.
           MOVE R4-DATE-TIME-E TO STOP-DATE.
           IF STOP-YY > "70"
               MOVE "19" TO STOP-CC
           ELSE
           MOVE "20"     TO STOP-CC.
           READ R4FILE INTO R4-BUFFER AT END GO TO 1-LO-EXIT.
           MOVE 1 TO S1.
           PERFORM 10-READ-OPTIONS THRU 10-R-O-E.
       1-LO-EXIT.    EXIT.

       10-READ-OPTIONS.
           MOVE R4-BUFFER TO ZT (S1).
           READ R4FILE INTO R4-BUFFER AT END GO TO 10-R-O-E.
           IF R4-BUFFER = SPACES GO TO 10-R-O-E.
           ADD 1 TO S1.
           GO TO 10-READ-OPTIONS.
       10-R-O-E.    EXIT.
033000
041900 8-INPUT-RECORDS.
042000     PERFORM 81-HOUSEKEEPING THRU 81-HOUSEKEEPING-EXIT.
042100     PERFORM 86-MAIN THRU 86-MAIN-EXIT VARYING S1 FROM 1 BY 1
042200         UNTIL S1 > 5.
042500
042700 81-HOUSEKEEPING.
           MOVE 0 TO COND-WORD.
044400     MOVE 1 TO ARG-NO.
           READ WO-LAST-NUM-USED INTO LAST-WO-BUFF
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF WLNU-STATUS NOT = "00" MOVE 17 TO COND-WORD.
           IF COND-WORD = 17 MOVE 1 TO DATE-FLAG-SW.
044700     MOVE DATE-FLAG-SW TO DATE-FLAG.
044800     MOVE 1 TO DATE-MODE.
044900     MOVE DATE-FLAG TO DATE-CODE.
045000     CALL "TDATECK2" USING DATE-CHECK-AREA LANGUAGE-PARMS.
045100     MOVE DATE-SLASH-OUT TO DATE-1-H.
045200 81-HOUSEKEEPING-EXIT.    EXIT.
045400
045600 86-MAIN.
           PERFORM 89-START-WO-BASIC-FILE.
046200     IF COND-WORD = 17 GO TO 86-MAIN-EXIT.
046500     PERFORM 861-DBGET THRU 861-DBGET-EXIT UNTIL COND-WORD = 15.
046600 86-MAIN-EXIT.    EXIT.
046800
047000 861-DBGET.
047100     PERFORM 89-READ-WO-BASIC-FILE.
047300     IF COND-WORD = 15 GO TO 861-DBGET-EXIT.
047900     IF TZONE (1) = SPACES GO TO 861-DBGET-CONT.
048400     PERFORM 8610-LOCATE-ZONE VARYING TABLE-NUM FROM 1 BY 1
              UNTIL (TABLE-NUM > 100) OR
048500           ZONE = TZONE (TABLE-NUM) OR TZONE (TABLE-NUM) = SPACES.
048700     IF TZONE (TABLE-NUM) = SPACES OR TABLE-NUM > 100
048800         GO TO 861-DBGET-EXIT.

049000     IF TEQPNUM (TABLE-NUM, 1) = SPACES
049100         NEXT SENTENCE
049200     ELSE
049300     PERFORM 8610-LOCATE-EQPNUM VARYING TABLE-NUM1 FROM 1 BY 1
              UNTIL (TABLE-NUM1 > 5) OR
049400            (EQUIP-NUM = TEQPNUM (TABLE-NUM, TABLE-NUM1))
049600        IF TABLE-NUM1 > 5
049700         GO TO 861-DBGET-EXIT.
049800
049900     IF TCRAFT (TABLE-NUM, 1) = SPACES
050000         NEXT SENTENCE
050100     ELSE
050200     PERFORM 8610-LOCATE-CRAFT  VARYING TABLE-NUM1 FROM 1 BY 1
              UNTIL (TABLE-NUM1 > 5) OR
050300            (CRAFTS-REQD-1 = TCRAFT (TABLE-NUM, TABLE-NUM1))
050500       IF TABLE-NUM1 > 5
050600         GO TO 861-DBGET-EXIT.
050700
050800 861-DBGET-CONT.
051000     MOVE ZONE TO ZONE-SORT.
051100     MOVE PRIORITY TO PRTY-SORT.
051200     MOVE CRAFTS-REQD-1 TO CRFT-SORT.
051400     PERFORM 8611-CALC-NUMBERS THRU 8611-CN-EXIT.
051500
051600 861-DBGET-EXIT.    EXIT.
052500
       8610-LOCATE-ZONE.

       8610-LOCATE-EQPNUM.

       8610-LOCATE-CRAFT.

052700 8611-CALC-NUMBERS.
052900     MOVE "N" TO RECD-SW STRT-SW COMP-SW
053000                 RECD-NUM STRT-NUM COMP-NUM.
053200     MOVE 0 TO RECD-SORT STRT-SORT COMP-SORT RESP-SORT WORK-SORT.
053400     IF DATE-RECD-CN NUMERIC AND TIME-RECD NUMERIC
053500       MOVE "Y" TO RECD-NUM
053600       STRING DATE-RECD-CN TIME-RECD DELIMITED BY SIZE
                 INTO COMP-DATE
