059900         CALL "JULGREG" USING GREG-DATE, JULIAN-DATE,
                                DAY-DIGIT, LEAP-YEAR-FLAG
060000         MOVE JULIAN-DATE-9     TO JUL-DAY-STRT.
060100
060200     IF COMP-NUM = "Y"
060300         MOVE DATE-COMP-DD      TO GREG-DD
060400         MOVE DATE-COMP-MM      TO GREG-MM
060500         MOVE DATE-COMP-YY      TO GREG-YY
               MOVE SPACES            TO JULIAN-DATE
               IF GREG-YY > "70"
                   MOVE "19"          TO GREG-CC
                   CALL "JULGREG" USING GREG-DATE, JULIAN-DATE,
                                    DAY-DIGIT, LEAP-YEAR-FLAG
                   MOVE JULIAN-DATE-9 TO JUL-DAY-COMP
               ELSE
               MOVE "20"              TO GREG-CC
060700         CALL "JULGREG" USING GREG-DATE, JULIAN-DATE,
                                DAY-DIGIT, LEAP-YEAR-FLAG
060800         MOVE JULIAN-DATE-9     TO JUL-DAY-COMP.
060900
