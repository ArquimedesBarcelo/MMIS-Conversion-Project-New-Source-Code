123700**********************************
123800 1100-READ-PLANT-FILE.
124000     MOVE SPACES           TO BASE-AREA.
124100     MOVE 1                TO DB-SUB.
124200     OPEN INPUT PLANT-FILE.
124300
124400 1150-MULTIDB-READ.
124500     READ PLANT-FILE AT END
124600          CLOSE PLANT-FILE
124700          GO TO 1155-CHECK-HOW-MANY.
124800
124900     MOVE PLANT-ID         TO BASE-PLT    (DB-SUB).
125000     MOVE PLANT-HOMEGRP2   TO BASE-GROUP  (DB-SUB).
125100     MOVE "  STORES."      TO BASE-NAME   (DB-SUB).
125200     MOVE PLANT-LDESC       TO BASE-PLT-DESC (DB-SUB).
125300     ADD 1 TO DB-SUB.
125400     GO TO 1150-MULTIDB-READ.
125500
125600 1155-CHECK-HOW-MANY.
125700     IF DB-SUB - 1 > 1
125800        MOVE "Y" TO MULTIPLE-DB-PLANT.
125900
126000 1199-EXIT.  EXIT.
126100
126200 1200-RS-INQUIRY.
126300     CALL "SRSINQS" USING BASE,
126400                          VIEW-COMAREA,
126500                          LANGUAGE-PARMS.
126600
126700 1210-PO-INQUIRY-BY-CODE.
126800     CALL "TPOINQCS" USING BASE,
126900                           VIEW-COMAREA,
127000                           LANGUAGE-PARMS.
127100
127200 1220-CODE-INQUIRY.
127300     CALL "TMTLSTAT" USING BASE,
127400                           VIEW-COMAREA,
127500                           SAVE-COMPANY,
127600                           PASS-SPOOL-PRT-NO,
127700                           CODE-ARG,
127800                           LANGUAGE-PARMS.
127900
