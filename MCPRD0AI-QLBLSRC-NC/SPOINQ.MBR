           IF DB-SUB > 7
              GO TO 410-WRITE-ALL-DB-SCREEN.
103500     IF BASES (DB-SUB) = SPACES
103600        GO TO 410-WRITE-ALL-DB-SCREEN.
           MOVE 0 TO COND-WORD.
      *-------- MOVED THIS STATEMENT TO AFTER THE OPEN OF THE FILE.
      **** MOVE PO-ARG TO PORCVNO OF DPORECD-REC-I.
      *------JSB 02/05/97, OVERRIDE DBF TO ANOTHER PLANT
           STRING "OVRDBF FILE(MCFLCS0901) TOFILE(" DELIMITED BY SIZE,
             BASE-GROUP (DB-SUB) DELIMITED BY SPACES,
               "/MCFLCS0901) SHARE(*NO)" DELIMITED BY SIZE
             INTO COMMAND-WORK.
           CALL "QCMDEXC" USING COMMAND-WORK, COMMAND-LEN.

           OPEN INPUT DPORECD-I.
           MOVE PO-ARG TO PORCVNO OF DPORECD-REC-I.
           START DPORECD-I KEY = PORCVNO OF DPORECD-REC-I
               INVALID KEY MOVE 17 TO COND-WORD.
           IF FILE-STATUS = "00"
                MOVE BASE-PLT-DESC (DB-SUB) TO PLANTX-PLANT (DB-SUB)
                MOVE BASE-PLT (DB-SUB) TO PLANTX-CODE (DB-SUB)
                MOVE "Y" TO CODE-EXISTS (DB-SUB).
            MOVE "DLTOVR FILE(MCFLCS0901)" TO COMMAND-WORK.
            CALL "QCMDEXC" USING COMMAND-WORK, COMMAND-LEN.
            CLOSE DPORECD-I.
            GO TO 405-LOOP.
