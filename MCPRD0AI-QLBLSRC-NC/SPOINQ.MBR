028900                          LANGUAGE-PARMS.
029000
029100 0-BEGIN.
029200     PERFORM 1-HSK THRU 1-HSK-X.
029300
029400     PERFORM 100-PROCESS-FORMS THRU 199-EXIT.
029800
029900     MOVE BASE-WS TO BASE.
030000
           CLOSE MREQ-I, DREQD-I, DPORECD-I, DISPLAY-FILE.
           CLOSE DPORECDH-I, DPOITEMH-I.
030100     GOBACK.
030200
030300 1-HSK.
9302CK     INITIALIZE BASE-STHIST-OPEN-INDIC.
           OPEN INPUT MREQ-I, DREQD-I.
           OPEN I-O DISPLAY-FILE.
030400     MOVE BASE              TO HOME-BASE, BASE-WS.
030500     PERFORM 1100-READ-PLANT-FILE THRU 1199-EXIT.
030600     IF AKRON-PLANTS
030700        MOVE BASE TO SAVE-BASE.
              MOVE SPACES TO DB-FILES-OPEN-SW.
030800
030900 1-HSK-X.
031000     EXIT.
031100
031200
031300************************************************************
031400************************************************************
031500*                    B L O W U P                           *
031600*     CHECK FOR IMAGE, VIEW, OR SPOOL ERROR.  CLOSE        *
031700*     FILES, GET OUT OF BLOCK MODE, AND DISPLAY            *
031800*     APPROPRIATE ERROR MESSAGE ON SCREEN.                 *
031900*                                                          *
032000*     ALSO APPENDS THE ERROR MESSAGE TO A FILE CALLED      *
032100*     BLOWUP.PUB.  TO READ THIS FILE, RUN "XBLPRT.OBJECT". *
032200*                                                          *
032300*         |||  PROGRAM IS ABORTED IN TBLOWUP  |||          *
032400************************************************************
032500************************************************************
032600 2-BLOWUP.
032700     MOVE "SPOINQ" TO BU-PGM-NAME.
032800     MOVE PO-ARG TO BU-DISPLAY-FLD (1).
032900     MOVE REQ-ARG TO BU-DISPLAY-FLD (2).
           IF FILE-STATUS NUMERIC
               MOVE FILE-STATUS TO COND-WORD.
033000     CALL "TBLOWUP" USING BASE, BU-PGM-NAME, STATUS-AREA,
033100           VIEW-COMAREA, FILE-STATUS,  BU-DISPLAY-MSG,
033200           BU-DISPLAY-FLDS.
033300 2-BLOWUP-X.
033400     EXIT.
033500
033600 100-PROCESS-FORMS.
           IF DB-SWITCH = "Y"
               PERFORM 2100-RESET-DB-SWITCH THRU 2100-EXIT.
           MOVE PO-REQUEST              TO  VIEW-NFNAME.
033700     MOVE SAVE-COMPANY-PASS       TO  SAVE-COMPANY.
035800
035900*************************************
036000** IF MULTI DATABASES, USE F1,F2   **
036100*************************************
036200     MOVE SPACES TO DE-BUFFER1.
           MOVE ZEROS  TO DE1-RLSE, DE1-ITEM-NUMBER.
036300     IF MORE-THAN-ONE-DB
036400*       *** PRESS 'f1' FOR YOUR OWN DATABASE, 'f2' FOR OVERALL
036500*       DATABASE ***
036600        MOVE  16 TO LANG-SETNUM
036700        MOVE  57 TO LANG-MSGNUM
036800        PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
036900        MOVE MESSAGE-BUFFER TO INSTRUCTION1
037000*       *** 'f8' TO EXIT PROGRAM ***
037100        MOVE  16 TO LANG-SETNUM
037200        MOVE  58 TO LANG-MSGNUM
037300        PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
037400        MOVE MESSAGE-BUFFER TO INSTRUCTION2
037500     ELSE
037600*       *** PRESS 'ENTER' TO PROCESS OR 'f8' TO EXIT PROGRAM ***
037700        MOVE  16 TO LANG-SETNUM
037800        MOVE  59 TO LANG-MSGNUM
037900        PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
038000        MOVE MESSAGE-BUFFER TO INSTRUCTION1
038100        MOVE SPACES TO INSTRUCTION2.
039000
039100 105-PROCESS-FORM1.
           MOVE DE-BUFFER1     TO DISPLAY-REC.
           PERFORM 998-WRITE-SCREEN THRU 998-READ-SCREEN.
           MOVE DISPLAY-REC    TO DE-BUFFER1.
039900
040000     IF VIEW-LASTKEY EQUAL 3
040100         GO TO  199-EXIT.
040200
041100     IF VIEW-LASTKEY = 4
041200         PERFORM 1220-CODE-INQUIRY
041300         GO TO 100-PROCESS-FORMS.
042600
040300     IF VIEW-LASTKEY = 6
040400         PERFORM 1200-RS-INQUIRY
040500         GO TO 100-PROCESS-FORMS.
040600
040700     IF VIEW-LASTKEY = 7
040800         PERFORM 1210-PO-INQUIRY-BY-CODE
040900         GO TO 100-PROCESS-FORMS.
041000
044010*----------  VENDOR INQUIRY
044100     IF VIEW-LASTKEY = 8
044200        CALL "TINQVEND" USING BASE, VIEW-COMAREA,
044400                              PASS-SPOOL-PRT-NO, LANGUAGE-PARMS
044500        GO TO 100-PROCESS-FORMS.

042700*-----IF A MULTI DB, THEY MUST CHOOSE 1 OR ALL DATABASES
042800     IF MORE-THAN-ONE-DB
042900         IF VIEW-LASTKEY EQUAL 1 OR 2
043000             NEXT SENTENCE
043300         ELSE
043400*            *** DEPRESS 'f1' OR 'f2' ***
043500             MOVE  16 TO LANG-SETNUM
043600             MOVE  76 TO LANG-MSGNUM
043700             PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE 1 TO FIELD-NUMBER
043800             PERFORM 700-PGM-ERROR THRU 799-EXIT
043900             GO TO 105-PROCESS-FORM1
044000     ELSE
045100     IF VIEW-LASTKEY EQUAL 1  OR
045200        VIEW-LASTKEY EQUAL 2
045300         MOVE 1  TO  FIELD-NUMBER
045400*        ***  INVALID FUNCTION KEY ENTERED  ***
045500         MOVE   9 TO LANG-SETNUM
045600         MOVE  10 TO LANG-MSGNUM
045700         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
045800         PERFORM  700-PGM-ERROR  THRU  799-EXIT
045900         GO TO  105-PROCESS-FORM1.

045100     IF VIEW-LASTKEY EQUAL 5
045300         MOVE 1  TO  FIELD-NUMBER
045400*        ***  INVALID FUNCTION KEY ENTERED  ***
045500         MOVE   9 TO LANG-SETNUM
045600         MOVE  10 TO LANG-MSGNUM
045700         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
045800         PERFORM  700-PGM-ERROR  THRU  799-EXIT
045900         GO TO  105-PROCESS-FORM1.

      *------- FIELD EDITS
           IF DE1-PO = SPACES AND
              DE1-REQ-NUMBER = SPACES
      *        YOU MUST ENTER PO NO. OR REQ. NO.
076900         MOVE  9090  TO CATREAD-MSG-NUMBER
077100         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
077200         MOVE 1  TO  FIELD-NUMBER
077300         PERFORM 700-PGM-ERROR  THRU 799-EXIT
077400         GO TO 105-PROCESS-FORM1.
078700
           IF DE1-PO NOT = SPACES AND
              DE1-REQ-NUMBER NOT = SPACES
      *        CHOOSE ONLY 1 FIELD - PO NO. OR REQ. NO.
076900         MOVE 15023  TO CATREAD-MSG-NUMBER
077100         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
077200         MOVE 1  TO  FIELD-NUMBER
077300         PERFORM 700-PGM-ERROR  THRU 799-EXIT
077400         GO TO 105-PROCESS-FORM1.
078700
           IF DE1-ITEM-NUMBER = ZEROS
               NEXT SENTENCE
           ELSE
           IF DE1-REQ-NUMBER NOT = SPACES
      *        CANNOT SELECT ITEM NO. WHEN INQUIRING BY REQ. NO.
076900         MOVE 66127  TO CATREAD-MSG-NUMBER
077100         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
077200         MOVE 3  TO  FIELD-NUMBER
077300         PERFORM 700-PGM-ERROR  THRU 799-EXIT
077400         GO TO 105-PROCESS-FORM1
           ELSE
           IF DE1-CORPCODE NOT = SPACES
      *         CHOOSE ONLY ONE FIELD ITEM NUMBER OR CORP CODE
076900         MOVE 66128  TO CATREAD-MSG-NUMBER
077100         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
077200         MOVE 3  TO  FIELD-NUMBER
077300         PERFORM 700-PGM-ERROR  THRU 799-EXIT
077400         GO TO 105-PROCESS-FORM1.

            IF DE1-REQ-NUMBER NOT = SPACES
                IF DE1-CORPCODE NOT = SPACES
      *            CANNOT SELECT CORPORATE CODE WHEN INQUIRING BY REQ.
076900              MOVE 66129  TO CATREAD-MSG-NUMBER
077100              PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
077200              MOVE 5  TO  FIELD-NUMBER
077300              PERFORM 700-PGM-ERROR  THRU 799-EXIT
077400              GO TO 105-PROCESS-FORM1.
078700
047900 115-CHECK-WHICH-DB.
048000     IF DE1-HISTORY-INDIC = "X"
048100         IF BASE-STHIST-NAME = "NO DB"
048200             MOVE 19  TO  LANG-SETNUM
048300             MOVE 20  TO  LANG-MSGNUM
048400             MOVE 1   TO  FIELD-NUMBER
048500             PERFORM 999-CATREAD  THRU  999-CATREAD-EXIT
048600             PERFORM 700-PGM-ERROR  THRU  799-EXIT
