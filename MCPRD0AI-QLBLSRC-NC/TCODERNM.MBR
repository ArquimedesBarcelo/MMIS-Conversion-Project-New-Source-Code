               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   GO TO 6515-EXIT
               ELSE
                   MOVE "READN ERROR * 6515-DEL-DCHATNO"
                       TO BU-DISPLAY-MSG
                   PERFORM 2000-BLOWUP.
           IF CORPCDE OF DCHATNO-O-REC NOT = CODE-ARG
                   GO TO 6515-EXIT.

           DELETE DCHATNO-O
              INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE "DELETE ERROR * 6515-DEL-DCHATNO"
                   TO BU-DISPLAY-MSG
               MOVE CODE-ARG             TO BU-DISPLAY-FLD (1)
               PERFORM 2000-BLOWUP.

           GO TO 6515-DEL-DCHATNO.

       6515-EXIT.
           EXIT.


       6516-GET-PUT-DEL-DRCVCORR.
           READ DRCVCORR-O NEXT INTO BUF-DRCVCORR
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   GO TO 6506-EXIT
               ELSE
                   MOVE "READN ERROR * 6516-GPD-DRCVCORR"
                       TO BU-DISPLAY-MSG
                   PERFORM 2000-BLOWUP.
           IF CORPCDE OF DRCVCORR-O-REC NOT = CODE-ARG
                   GO TO 6516-EXIT.

           MOVE RENAME-NEW-CODE          TO CORR-CORP-CODE.
           REWRITE DRCVCORR-O-REC FROM BUF-DRCVCORR
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE "REWRITE ERROR * 6516-GPD-DRCVCORR"
                   TO BU-DISPLAY-MSG
               MOVE RENAME-NEW-CODE      TO BU-DISPLAY-FLD (1)
               PERFORM 2000-BLOWUP.

           GO TO 6516-GET-PUT-DEL-DRCVCORR.

       6516-EXIT.
           EXIT.

       660-DELETE-MSTORERM.
      ***** DELETE THE "MSTORERM" ENTRY FOR THIS CODE *****
           MOVE CODE-ARG TO CORPCDE OF MSTORERM-O-REC.
           READ MSTORERM-O INTO BUF-MSTORERM
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE "READ MSTORERM ERROR IN 660-D-MSTORERM"
                   TO BU-DISPLAY-MSG
               PERFORM 2000-BLOWUP.

           DELETE MSTORERM-O
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE "DELETE MSTORERM ERROR IN 660-D-MSTORERM"
                   TO BU-DISPLAY-MSG
               PERFORM 2000-BLOWUP.

      ***** DELETE USAGE FILE ENTRY FOR THIS CODE *****
           MOVE CODE-ARG  TO CORPCDE OF USAGEFIL-O-REC.
           READ USAGEFIL-O
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE "READ USAGEFIL *62-UUF" TO BU-DISPLAY-MSG
               PERFORM 2000-BLOWUP.

           DELETE USAGEFIL-O
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE "DELETE USAGEFIL ERROR IN 660-D-MSTORERM"
                   TO BU-DISPLAY-MSG
               PERFORM 2000-BLOWUP.

      ***** DELETE RECEIPT FILE ENTRY FOR THIS CODE *****
           MOVE CODE-ARG  TO CORPCDE OF RECEIPTFIL-O-REC.
           READ RECEIPTFIL-O
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE "READ RECEIPTFIL *62-UUF" TO BU-DISPLAY-MSG
               PERFORM 2000-BLOWUP.

           DELETE RECEIPTFIL-O
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE "DELETE RECEIPTFIL ERROR IN 660-D-MSTORERM"
                   TO BU-DISPLAY-MSG
               PERFORM 2000-BLOWUP.

           MOVE SPACES                   TO   BUF-DDAILYTC.
           CALL "TDATECHK" USING DATE-CHECK-AREA.
           MOVE DATE-YMD-OUT             TO   DDAILYTC-DATE.
           MOVE DATE-UNFORMATTED-TIME-OUT TO  DDAILYTC-TIME.
           MOVE MPLTINFO-COMPANY         TO   DDAILYTC-PLT.
           MOVE "105"                    TO   DDAILYTC-TC.
           MOVE RENAME-NEW-CODE          TO   TC105-NEW-CODE.
           MOVE RENAME-OLD-CODE          TO   TC105-OLD-CODE.

           PERFORM 66X-PUT-DDAILYTC THRU 66X-PD-X.

           IF CODE-IS-CORP
               PERFORM 661-PUT-TCS THRU 661-PT-X.

       660-DEL-DRESTRIC.
           IF STR-RESTRICTED-FLG = "X"
               MOVE RENAME-OLD-CODE TO CORPCDE OF DRESTRIC-REC
               DELETE DRESTRIC-O
                   INVALID KEY MOVE FILE-STATUS TO FILE-STATUS
               END-DELETE
               IF FILE-STATUS NOT = "00"
                   MOVE "DELETE USAGEFIL ERROR IN 660-D-DRESTRIC"
                       TO BU-DISPLAY-MSG
                   PERFORM 2000-BLOWUP.

           MOVE "*** CODE SUCCESSFULLY RENAMED ***"
               TO L1-MSG.
           PERFORM 690-WRITE-RPT.

       660-EXIT.
           EXIT.

       661-PUT-TCS.
           MOVE "110"                    TO  DDAILYTC-TC.
           MOVE SPACES                   TO  DDAILYTC-DATA.
           MOVE RENAME-OLD-CODE          TO  TC110-CORP-CODE.
           PERFORM 66X-PUT-DDAILYTC THRU 66X-PD-X.

           MOVE "311"                    TO  DDAILYTC-TC.
           MOVE SPACES                   TO  DDAILYTC-DATA.
           MOVE RENAME-NEW-CODE          TO  TC311-CORP-CODE.
           MOVE "1"                      TO  TC311-ID-1.
           MOVE STR-PREV-CODE            TO  TC311-PREV-CODE.
           MOVE STR-AUTHOR               TO  TC311-AUTHOR.
           MOVE STR-CLASS                TO  TC311-CLASS.
           MOVE STR-DIR-CHRG-DEPT        TO  TC311-DIR-CHRG.
           MOVE STR-DFLT-DEPT            TO  TC311-DEPT-CHG.
           MOVE STR-WR-DOWN              TO  TC311-WR-DOWN.
           MOVE STR-STOCK-OT             TO  TC311-STOCK-OT.
           MOVE STR-IMPORT-IND           TO  TC311-IMPORT.
           MOVE STR-INS-ITM              TO  TC311-INS-ITM.
           MOVE STR-ORD-ENG              TO  TC311-ORD-ENG.
           MOVE STR-OUT-REP              TO  TC311-OUT-REP.
           MOVE STR-MAINT                TO  TC311-MAINT.
           MOVE STR-LOC (1)              TO  TC311-STOCK-LOC.
           PERFORM 66X-PUT-DDAILYTC THRU 66X-PD-X.

           IF TC2-ID-SW = "Y"
               MOVE SPACES               TO TC311-TC-DATA
               MOVE "2"                  TO TC311-ID-2
               MOVE S-LOCAL-DESC         TO TC311-LOC-DESC
               PERFORM 66X-PUT-DDAILYTC THRU 66X-PD-X.

           MOVE SPACES                   TO  TC311-TC-DATA.
           MOVE "3"                      TO  TC311-ID-3.
           MOVE STR-DISB-INSTR           TO  TC311-DISB-INSTR.
           MOVE STR-UM1                  TO  TC311-UM1.
           MOVE STR-UM1-CF               TO  TC311-UM1-CF.
           MOVE STR-UM2                  TO  TC311-UM2.
           MOVE STR-UM2-CF               TO  TC311-UM2-CF.
           PERFORM 66X-PUT-DDAILYTC THRU 66X-PD-X.

           MOVE SPACES                   TO  TC311-TC-DATA.
           MOVE "4"                      TO  TC311-ID-4.
           MOVE STR-PHY-INV-CYL          TO  TC311-PHYS-INV-CYL.
           MOVE STR-EST-LT               TO  TC311-EST-LT.
           MOVE STR-MTH-FCST             TO  TC311-MTH-FCST.
           MOVE STR-REORDER              TO  TC311-REORDER.
           MOVE STR-MAX                  TO  TC311-MAX.
           MOVE STR-SOQ                  TO  TC311-SOQ.
           MOVE STR-EXPEDITE             TO  TC311-EXPEDITE.
           MOVE STR-TAX-CODE             TO  TC311-TAX-ID.
           MOVE STR-TAX-PERCENT          TO  TC311-TAX-PCT.
           PERFORM 66X-PUT-DDAILYTC THRU 66X-PD-X.

           IF STR-AVG-COST > 99999.9999 OR
              STR-MKT-COST > 99999.9999 OR
              STR-STD-COST > 99999.9999
               MOVE SPACES               TO  DDAILYTC-DATA
               MOVE "411"                TO  DDAILYTC-TC
               MOVE RENAME-NEW-CODE      TO  TC411-CORP-CODE
               MOVE STR-AVG-COST         TO  TC411-AVG-COST
               MOVE STR-MKT-COST         TO  TC411-MKT-COST
               MOVE STR-STD-COST         TO  TC411-STD-COST
               MOVE STR-UM               TO  TC411-UM
               MOVE STR-ONHAND           TO  TC411-ONHAND
               MOVE STR-CLASS            TO  TC411-CLASS
               MOVE SPACES               TO  TC411-OLD-UM
               MOVE +0                   TO  TC411-OLD-ONHAND
           ELSE
               MOVE SPACES               TO  TC311-TC-DATA
               MOVE "5"                  TO  TC311-ID-5
               MOVE STR-AVG-COST         TO  TC311-AVG-COST
               MOVE STR-MKT-COST         TO  TC311-MKT-COST
               MOVE STR-STD-COST         TO  TC311-STD-COST
               MOVE STR-UM               TO  TC311-UM
               MOVE STR-ONHAND           TO  TC311-ONHAND
               MOVE STR-CLASS            TO  TC311-CLASS-ID5
               MOVE SPACES               TO  TC311-OLD-UM
               MOVE +0                   TO  TC311-OLD-ONHAND.

           PERFORM 66X-PUT-DDAILYTC THRU 66X-PD-X.

           MOVE SPACES                   TO  DDAILYTC-DATA.
           MOVE "311"                    TO  DDAILYTC-TC.
           MOVE RENAME-NEW-CODE          TO  TC311-CORP-CODE.
           MOVE "6"                      TO  TC311-ID-6.
           MOVE STR-HIGH-USAGE           TO  TC311-HIGH-USAGE.
           MOVE STR-CONS-IND             TO  TC311-CONS-IND.
           PERFORM 66X-PUT-DDAILYTC THRU 66X-PD-X.


      *    MOVE SPACES                   TO  BUF-TC999.
      *    MOVE "999"                    TO  DDAILYTC-TC.
      *    MOVE RENAME-NEW-CODE          TO  TC999-CORP-CODE.
      *    MOVE STR-ONHAND               TO  TC999-ONHAND.
      *    MOVE STR-UM                   TO  TC999-UM.
      *    MOVE STR-ONORDER              TO  TC999-ONORDER.
      *    PERFORM 66X-PUT-DDAILYTC THRU 66X-PD-X.

       661-PT-X.
           EXIT.

       66X-PUT-DDAILYTC.
           WRITE DDAILYTC-O-REC FROM BUF-DDAILYTC
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE "WRITE ERR DDAILYTC" TO BU-DISPLAY-MSG
               PERFORM 2000-BLOWUP.

       66X-PD-X.
           EXIT.

       690-WRITE-HEADERS.
           MOVE "0"                      TO RPT-CTRL.
           ADD   1                       TO PAGE-CTR.
           MOVE PAGE-CTR                 TO HD1-PAGE.
           MOVE HD1                      TO RPT-REC.
           WRITE RENAME-RPT-REC.
           MOVE "2"                      TO RPT-CTRL.
           MOVE HD2                      TO RPT-REC.
           WRITE RENAME-RPT-REC.
           MOVE 3                        TO LINE-CTR.
           MOVE "1"                      TO RPT-CTRL.

       690-WRITE-RPT.
           IF LINE-CTR > 58
               PERFORM 690-WRITE-HEADERS.

           MOVE RENAME-OLD-CODE          TO L1-OLD-CODE.
           MOVE RENAME-NEW-CODE          TO L1-NEW-CODE.
           MOVE LINE1                    TO RPT-REC.
           WRITE RENAME-RPT-REC.
           ADD  1                        TO LINE-CTR.
           MOVE SPACES                   TO L1-MSG.

       690-WRITE-DTL.
           IF LINE-CTR > 58
               PERFORM 690-WRITE-HEADERS
               MOVE "CONTINUATION"       TO L1-MSG
               MOVE LINE1                TO RPT-REC
               WRITE RENAME-RPT-REC
               ADD  1                    TO LINE-CTR.

           MOVE LINE2                    TO RPT-REC.
           WRITE RENAME-RPT-REC.
           ADD  1                        TO LINE-CTR.

       999-CATREAD.
           IF CATREAD-MSG-NUMBER = ZEROS
               MOVE LANG-SETNUM TO CATREAD-MSG-SET
               MOVE LANG-MSGNUM TO CATREAD-MSG-NUM.
           CALL "CCATREAD" USING CATREAD-PARMS.
           MOVE CATREAD-MSG-TEXT TO MESSAGE-BUFFER.

       999-CATREAD-EXIT.
           EXIT.
