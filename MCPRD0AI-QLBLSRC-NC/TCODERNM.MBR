007000     05  STR2-RESERVED              PIC S9(8)  BINARY.
007100     05  STR2-RSRV-ONORD            PIC S9(8)  BINARY.
007200     05  STR2-LOC-AREA.
007300         10  STORE-INVENTORY-INFO OCCURS 6 TIMES.
007400             15  STR2-LOC.
007500                 20  STR2-LOC-1-2.
007600                     25  STR2-LOC-1 PIC X(1).
007700                     25  STR2-LOC-2 PIC X(1).
007800                 20  STR2-LOC-3-12  PIC X(10).
007900             15  STR2-LOC-ONHAND    PIC S9(8)  BINARY.
008000     05  STR2-LAST-PO-RLSE.
008100         10  STR2-LAST-PO           PIC X(7).
008200         10  STR2-LAST-RLSE         PIC X(3).
008300     05  STR2-LAST-VENDOR           PIC X(10).
008400     05  STR2-EXPENSE-CLASS         PIC X(8).
008500     05  STR2-LAST-REQ-NO           PIC X(12).
           05  STR2-LAST-REQ-DATE-CN.
               10  STR2-REQ-DATE-CC       PIC X(2).
008600         10  STR2-LAST-REQ-DATE.
008700             15  STR2-REQ-DATE-YY   PIC X(2).
008800             15  STR2-REQ-DATE-MM   PIC X(2).
008900             15  STR2-REQ-DATE-DD   PIC X(2).
009000     05  STR2-TAX-CODE              PIC X(2).
009100     05  STR2-TAX-PERCENT           PIC S9(2)V9(2) BINARY.
009200     05  STR2-STD-INST.
009300         10  STR2-STD-INSTR         PIC X(3) OCCURS 4 TIMES.
009400     05  STR2-BUYER                 PIC X(4).
009500     05  STR2-HIGH-USAGE.
009600         10 STR2-HIGH-USAGE-AREA    PIC X(2) OCCURS 6 TIMES.
009700     05  STR2-SOQ                   PIC S9(8)  BINARY.
009710     05  STR2-RAW-LOT               PIC 9(4).
009800     05  STR2-LAST-EMPL             PIC X(4).
009810     05  FILLER                     PIC X(12).
009900     05  FILLER                     PIC X(25).

       COPY DDESC      IN COPYLIB.
       COPY DDESC2     IN COPYLIB.
       COPY DVENDITM   IN COPYLIB.
       COPY DPOITEM    IN COPYLIB.
       COPY DRCVITEM   IN COPYLIB.
       COPY DRCVCORR   IN COPYLIB.
       COPY DCHATNO    IN COPYLIB.
       COPY DRESERVE   IN COPYLIB.
       COPY DWLITEM    IN COPYLIB.
       COPY DREQITM    IN COPYLIB.
       COPY DINVITM    IN COPYLIB.
       COPY DSHIPREL   IN COPYLIB.
       COPY MPLT0      IN COPYLIB.
       COPY MPLTP01    IN COPYLIB.
       COPY DTALLY     IN COPYLIB.
       COPY DDAILYTC   IN COPYLIB.
       COPY TC105      IN COPYLIB.
       COPY TC110      IN COPYLIB.
       COPY TC311      IN COPYLIB.
       COPY TC411      IN COPYLIB.
       COPY TC999      IN COPYLIB.

       COPY  DRESTRIC  IN COPYLIB.

      *************************************************************
      *************************************************************
      **                                                         **
      **                  COMMUNICATIONS AREAS                   **
      **                                                         **
      *************************************************************
      *************************************************************

       01  MCXCBLERR-SCOPE               PIC X(1)  VALUE "C".

       COPY TBLOWUP    IN COPYLIB.
       COPY TDATECHK   IN COPYLIB.
       COPY THDPRT     IN COPYLIB.
       COPY CATREAD    IN COPYLIB.

      ***************************************************************
      **                C O M M A N D   A R E A                    **
      ***************************************************************
       COPY CDLTFILE   IN COPYLIB.

      *************************************************************
      *************************************************************
      **                                                         **
      **                  P R I N T    A R E A S                 **
      **                                                         **
      *************************************************************
      *************************************************************

       01  HD1.
           05  FILLER                    PIC X(6)  VALUE "PAGE: ".
           05  HD1-PAGE                  PIC ZZZ9.
           05  FILLER                    PIC X(16) VALUE SPACES.
           05  FILLER                    PIC X(37) VALUE
               "C O D E   R E N A M E   R E P O R T".
           05  FILLER                    PIC X(16) VALUE SPACES.
           05  FILLER                    PIC X(5)  VALUE "DATE ".
           05  HD1-DATE                  PIC X(8).
           05  FILLER                    PIC X(2)  VALUE SPACES.
           05  HD1-TIME                  PIC X(8).

       01  HD2.
           05  FILLER                    PIC X(8)  VALUE "OLD CODE".
           05  FILLER                    PIC X(2)  VALUE SPACES.
           05  FILLER                    PIC X(8)  VALUE "NEW CODE".
           05  HD2-MSG-HDR               PIC X(114) VALUE SPACES.

       01  LINE1.
           05  FILLER                    PIC X(1)  VALUE SPACES.
           05  L1-OLD-CODE               PIC X(7).
           05  FILLER                    PIC X(3)  VALUE SPACES.
           05  L1-NEW-CODE               PIC X(7).
           05  FILLER                    PIC X(3)  VALUE " * ".
           05  L1-MSG                    PIC X(111) VALUE SPACES.
           05  L1-MSG-RDF REDEFINES L1-MSG.
               10  L1-MSG-CODE           PIC X(7).
               10  FILLER                PIC X(3).
               10  L1-ERR-MSG            PIC X(101).

       01  LINE2.
           05  FILLER                    PIC X(21) VALUE SPACES.
           05  L2-MSG                    PIC X(111) VALUE SPACES.

      *************************************************************
      **#########################################################**
      *************************************************************
      **                                                         **
      **           P R O C E D U R E   D I V I S I O N           **
      **                                                         **
      *************************************************************
      **#########################################################**
      *************************************************************

       PROCEDURE DIVISION.

       000-BEGIN-HERE.
           PERFORM 100-HSK               THRU 100-HSK-X.
           PERFORM 600-MAIN              THRU 600-MAIN-X.
           PERFORM 200-EOJ               THRU 200-EOJ-X.
           GOBACK.

       100-HSK.
           MOVE "C"                      TO  MCXCBLERR-SCOPE.
           CALL "MCXCBLERR" USING MCXCBLERR-SCOPE.
           MOVE "TCODERNM"               TO  BU-PGM-NAME.

           OPEN INPUT  RENAME-CODE-FILE,
                       MPLTINFO-I.
           OPEN OUTPUT RENAME-RPT-FILE.
           OPEN I-O DDESC-O, DDESC2-O, DVENDITM-O, DPOITEM-O,
                    DRCVITEM-O, DRESERVE-O, DWLITEM-O, DREQITM-O,
                    DSHIPREL-O, DTALLY-O, DCODE-O, DMANPART-O,
                    DINVITM-O, DDAILYTC-O, MSTORERM-O, USAGEFIL-O,
                    DRESTRIC-O DRCVCORR-O  DCHATNO-O RECEIPTFIL-O.

           MOVE 1                        TO DATE-MODE.
           CALL "TDATECHK" USING DATE-CHECK-AREA.
           MOVE DATE-SLASH-OUT           TO HD1-DATE.
           MOVE DATE-FORMATTED-TIME-OUT  TO HD1-TIME.
           PERFORM 690-WRITE-HEADERS.

           MOVE 0 TO COND-WORD.
           MOVE PLT-ARG TO PLTINFOKEY OF MPLTINFO-I-REC.
           READ MPLTINFO-I INTO BUF-MPLTINFO
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE "READ ERROR MPLTINFO * 100-HSK"
                   TO BU-DISPLAY-MSG
               PERFORM 2000-BLOWUP.

       100-HSK-X.
           EXIT.

       200-EOJ.
           CLOSE RENAME-CODE-FILE, RENAME-RPT-FILE, DRESTRIC-O.

           MOVE "DCDRNFIL"     TO  DLTFILE-FILE-NAME.
           CALL "CDLTFILE" USING DLTFILE-LIB-NAME,
                                 DLTFILE-FILE-NAME,
                                 DLTFILE-RETURN-STATUS.
           IF DLTFILE-RETURN-STATUS NOT = "00"
               MOVE "DELETE(1) COMMAND FAILED"  TO  BU-DISPLAY-MSG
               MOVE DLTFILE-RETURN-STATUS    TO  BU-DISPLAY-FLD (1)
               PERFORM 2000-BLOWUP.

           MOVE "CRACTIVE"     TO  DLTFILE-FILE-NAME.
           CALL "CDLTFILE" USING DLTFILE-LIB-NAME,
                                 DLTFILE-FILE-NAME,
                                 DLTFILE-RETURN-STATUS.
           IF DLTFILE-RETURN-STATUS NOT = "00"
               MOVE "DELETE(2) COMMAND FAILED"  TO  BU-DISPLAY-MSG
               MOVE DLTFILE-RETURN-STATUS    TO  BU-DISPLAY-FLD (1)
               PERFORM 2000-BLOWUP.

           CLOSE DDESC-O, DDESC2-O, DVENDITM-O, DPOITEM-O,
                 DRCVITEM-O, DRESERVE-O, DWLITEM-O, DREQITM-O,
                 DSHIPREL-O, DTALLY-O, DCODE-O, DMANPART-O,
                 DDAILYTC-O, DINVITM-O, MSTORERM-O, MPLTINFO-I,
                 USAGEFIL-O RECEIPTFIL-O DRCVCORR-O DCHATNO-O.

       200-EOJ-X.
           EXIT.

       2000-BLOWUP.
           CALL "TBLOWUP" USING BASE, BU-PGM-NAME, STATUS-AREA,
                 DUMMY-VIEW-AREA, FILE-STATUS, BU-DISPLAY-MSG,
                 BU-DISPLAY-AREA.

      *************************************
      **            600-MAIN             **
      *************************************
       600-MAIN.
           PERFORM 610-READ-RENAME-FILE THRU 610-RRF-X.
           IF AT-END-OF-FILE
               GO TO 600-MAIN-X.

      *------  VERIFY PREVIOUS CODE (OLD CODE)
           PERFORM 620-CHECK-OLD-CODE THRU 620-EXIT.
           IF SKIP-CODE
               MOVE "N"                  TO SKIP-CODE-SW
               GO TO 600-MAIN.

      *------  VERIFY NEW CODE

           PERFORM 630-CHECK-NEW-CODE THRU 630-EXIT.
           IF SKIP-CODE
               MOVE "N"                  TO SKIP-CODE-SW
               GO TO 600-MAIN.

      *------  OLD CODE AND NEW CODE HAVE BEEN VERIFIED
      *------   1. COPY ALL EXISTING 'OLD CODE' DATA BUFFERS OVER TO
      *------      'NEW CODE'.
      *------   2. DELETE ALL 'OLD CODE' DATA BUFFERS

           PERFORM 640-COPY-MSTORERM       THRU 640-EXIT.
           PERFORM 650-GET-PUT-DEL-BUFFERS THRU 650-EXIT.
           PERFORM 660-DELETE-MSTORERM     THRU 660-EXIT.
           GO TO   600-MAIN.

       600-MAIN-X.
           EXIT.

       610-READ-RENAME-FILE.
           READ RENAME-CODE-FILE AT END MOVE "Y" TO EOF-SW.
      *    DISPLAY "READ FILE - ", RENAME-CODE-REC.

       610-RRF-X.
           EXIT.

       620-CHECK-OLD-CODE.

      ******CHECK OLD CODE
           MOVE RENAME-OLD-CODE          TO CODE-ARG,
                                            L1-MSG-CODE,
                                            BU-DISPLAY-FLD (1).
      *    DISPLAY "CHECK OLD CODE - ", CODE-ARG.
           MOVE CODE-ARG TO CORPCDE OF MSTORERM-O-REC.
           READ MSTORERM-O INTO BUF-MSTORERM
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS-1 = "2"
      *****    STORES CODE DOES NOT EXIST    *****
                   MOVE  19 TO LANG-SETNUM
                   MOVE   9 TO LANG-MSGNUM
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE MESSAGE-BUFFER   TO L1-ERR-MSG
                   PERFORM 690-WRITE-RPT
                   MOVE "Y"              TO SKIP-CODE-SW
                   GO TO 620-EXIT
               ELSE
               IF FILE-STATUS NOT = "00"
                   MOVE "READ MSTORERM ERROR * 620-CHECK-OLD-CODE"
                       TO BU-DISPLAY-MSG
                   PERFORM 2000-BLOWUP.

      ***** CHECK TO SEE THAT CODE IS NOT FROZEN *****
           IF STR-STATE = "F"
      *****    CODE FROZEN FOR INVENTORY - NO PROCESSING ALLOWED
               MOVE   3 TO LANG-SETNUM
               MOVE   8 TO LANG-MSGNUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER       TO L1-ERR-MSG
               PERFORM 690-WRITE-RPT
               MOVE "Y"                  TO SKIP-CODE-SW
               GO TO 620-EXIT.

           MOVE RENAME-OLD-CODE TO CORPCDE OF USAGEFIL-O-REC.
           READ USAGEFIL-O
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE "KSAM FILE OUT OF SYNC"
                   TO L1-ERR-MSG
               PERFORM 690-WRITE-RPT
               MOVE "Y"                  TO SKIP-CODE-SW
               GO TO 620-EXIT.

           MOVE RENAME-OLD-CODE TO CORPCDE OF RECEIPTFIL-O-REC.
           READ RECEIPTFIL-O
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE "READ ERROR IN RECEIPTS"
                   TO L1-ERR-MSG
               PERFORM 690-WRITE-RPT
               MOVE "Y"                  TO SKIP-CODE-SW
               GO TO 620-EXIT.

       620-EXIT.
           EXIT.

       630-CHECK-NEW-CODE.
      ***** CHECK NEW CODE
           MOVE RENAME-NEW-CODE          TO CODE-CHK,
                                            CODE-ARG,
                                            L1-MSG-CODE,
                                            BU-DISPLAY-FLD (1).

           IF   ((CODE-CHK-5 IS NUMERIC OR CODE-CHK-5 = SPACE)
             AND (CODE-CHK-6 IS NUMERIC OR CODE-CHK-6 = SPACE)
             AND (CODE-CHK-7 IS NUMERIC OR CODE-CHK-7 = SPACE))
               MOVE "C"                  TO CODE-FLAG.

      *    DISPLAY "CHECK NEW CODE", CODE-ARG.
           MOVE CODE-ARG TO CORPCDE OF MSTORERM-O-REC.
           READ MSTORERM-O INTO BUF-MSTORERM
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF CODE-IS-CORP
               IF FILE-STATUS NOT = "00"
      *****    CORPORATE CODE DOES NOT EXIST    *****
                   MOVE  19 TO LANG-SETNUM
                   MOVE   9 TO LANG-MSGNUM
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE MESSAGE-BUFFER   TO L1-ERR-MSG
                   PERFORM 690-WRITE-RPT
                   MOVE "Y"              TO SKIP-CODE-SW
                   GO TO 630-EXIT
               ELSE
                   NEXT SENTENCE
           ELSE
               IF FILE-STATUS = "00"
                   NEXT SENTENCE
               ELSE
                   MOVE "N"              TO CODE-EXISTS-SW
                   GO TO 630-EXIT.

           MOVE "Y"                      TO CODE-EXISTS-SW.
      ***** CHECK TO SEE THAT CODE IS NOT FROZEN *****
           IF STR-STATE = "F"
      *****    CODE FROZEN FOR INVENTORY - NO PROCESSING ALLOWED
               MOVE   3 TO LANG-SETNUM
               MOVE   8 TO LANG-MSGNUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER       TO L1-ERR-MSG
               PERFORM 690-WRITE-RPT
               MOVE "Y"                  TO SKIP-CODE-SW
               GO TO 630-EXIT.

           MOVE RENAME-NEW-CODE TO CORPCDE OF USAGEFIL-O-REC.
           READ USAGEFIL-O
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE "KSAM FILE OUT OF SYNC"
                   TO L1-ERR-MSG
               PERFORM 690-WRITE-RPT
               MOVE "Y"                  TO SKIP-CODE-SW
               GO TO 630-EXIT.

           MOVE RENAME-NEW-CODE TO CORPCDE OF RECEIPTFIL-O-REC.
           READ RECEIPTFIL-O
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE "READ ERROR IN RECEIPTS"
                   TO L1-ERR-MSG
               PERFORM 690-WRITE-RPT
               MOVE "Y"                  TO SKIP-CODE-SW
               GO TO 630-EXIT.

       630-EXIT.
           EXIT.

       640-COPY-MSTORERM.
      ***** CREATE THE "MSTORERM" ENTRY FOR THE NEW LOCAL CODE     *****
      ***** OR UPDATE THE "MSTORERM" ENTRY FOR A CORP CODE OR      *****
      ***** OR PREVIOUSLY USED LOCAL CODE.                         *****
      *    DISPLAY "640 COPY MSTORERM - ".
      *    DISPLAY "CODE EXISTS SW - ", CODE-EXISTS-SW.

           MOVE RENAME-OLD-CODE          TO CODE-ARG.
           MOVE CODE-ARG TO CORPCDE OF MSTORERM-O-REC.
           READ MSTORERM-O INTO BUF-MSTORERM
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE "READ MSTORERM ERROR * 640-CM"
                   TO BU-DISPLAY-MSG
               PERFORM 2000-BLOWUP.

           IF CODE-IS-NEW
               MOVE RENAME-NEW-CODE TO CORP-CODE
               WRITE MSTORERM-O-REC FROM BUF-MSTORERM
                   INVALID KEY MOVE FILE-STATUS TO FILE-STATUS
               END-WRITE
               IF FILE-STATUS NOT = "00"
                   MOVE "WRITE MSTORERM ERROR * 640-CM"
                       TO BU-DISPLAY-MSG
                   PERFORM 2000-BLOWUP
               ELSE
                   NEXT SENTENCE
           ELSE
               MOVE RENAME-NEW-CODE      TO CODE-ARG
               MOVE CODE-ARG TO CORPCDE OF MSTORERM-O-REC
               READ MSTORERM-O INTO BUF-MSTORERM2
                   INVALID KEY MOVE FILE-STATUS TO FILE-STATUS
               END-READ
               IF FILE-STATUS NOT = "00"
                   MOVE "READ MSTORERM2 ERROR * 640-CM"
                       TO BU-DISPLAY-MSG
                   PERFORM 2000-BLOWUP
               ELSE
                   PERFORM 641-CHECK-RESTRICTIONS THRU 641-CR-X
                   MOVE BUF-MSTORERM     TO BUF-MSTORERM2
                   MOVE RENAME-NEW-CODE  TO CORPCDE2 OF BUF-MSTORERM2
                   REWRITE MSTORERM-O-REC FROM BUF-MSTORERM2
                       INVALID KEY MOVE FILE-STATUS TO FILE-STATUS
                   END-REWRITE
                   IF FILE-STATUS NOT = "00"
                       MOVE "REWRITE MSTORERM2 ERROR * 640-CM"
                           TO BU-DISPLAY-MSG
                       PERFORM 2000-BLOWUP.

      ***** ADD USAGE FILE ENTRY FOR THIS CODE *****
           MOVE RENAME-OLD-CODE TO CORPCDE OF USAGEFIL-O-REC.
           READ USAGEFIL-O INTO BUF-USAGEFIL
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE "READ USAGE ERROR * 640-CM"
                   TO BU-DISPLAY-MSG
               MOVE RENAME-OLD-CODE      TO BU-DISPLAY-FLD (1)
               PERFORM 2000-BLOWUP.

           IF CODE-IS-NEW
               MOVE RENAME-NEW-CODE      TO CORPCDE OF USAGEFIL-O-REC
               WRITE USAGEFIL-O-REC
                   INVALID KEY MOVE FILE-STATUS TO FILE-STATUS
               END-WRITE
               IF FILE-STATUS NOT = "00"
                   MOVE "WRITE USAGE ERROR * 640-CM"
                       TO BU-DISPLAY-MSG
                   MOVE RENAME-NEW-CODE  TO BU-DISPLAY-FLD (1)
                   PERFORM 2000-BLOWUP
               ELSE
                   NEXT SENTENCE
           ELSE
               MOVE RENAME-NEW-CODE     TO CORPCDE OF USAGEFIL-O-REC
               READ USAGEFIL-O INTO BUF-USAGEFIL2
                   INVALID KEY MOVE FILE-STATUS TO FILE-STATUS
               END-READ
               IF FILE-STATUS NOT = "00"
                   MOVE "READ ERROR * 640-CM"
                       TO BU-DISPLAY-MSG
                   MOVE RENAME-NEW-CODE  TO BU-DISPLAY-FLD (1)
                   PERFORM 2000-BLOWUP
               ELSE
                   MOVE BUF-USAGEFIL    TO BUF-USAGEFIL2
                   MOVE RENAME-NEW-CODE TO CORPCDE2 OF BUF-USAGEFIL2
                   REWRITE USAGEFIL-O-REC FROM BUF-USAGEFIL2
                      INVALID KEY MOVE FILE-STATUS TO FILE-STATUS
                   END-REWRITE
                   IF FILE-STATUS NOT = "00"
                       MOVE "REWRITE ERROR * 640-CM"
                           TO BU-DISPLAY-MSG
                       MOVE RENAME-NEW-CODE TO BU-DISPLAY-FLD (1)
                       PERFORM 2000-BLOWUP.

      ***** ADD RECEIPT FILE ENTRY FOR THIS CODE *****
           MOVE RENAME-OLD-CODE TO CORPCDE OF RECEIPTFIL-O-REC.
           READ RECEIPTFIL-O INTO BUF-RECEIPTS
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE "READ RECEIPT ERROR * 640-CM"
                   TO BU-DISPLAY-MSG
               MOVE RENAME-OLD-CODE      TO BU-DISPLAY-FLD (1)
               PERFORM 2000-BLOWUP.

           IF CODE-IS-NEW
               MOVE RENAME-NEW-CODE      TO CORPCDE OF RECEIPTFIL-O-REC
               WRITE RECEIPTFIL-O-REC
                   INVALID KEY MOVE FILE-STATUS TO FILE-STATUS
               END-WRITE
               IF FILE-STATUS NOT = "00"
                   MOVE "WRITE RECEIPT ERROR * 640-CM"
                       TO BU-DISPLAY-MSG
                   MOVE RENAME-NEW-CODE  TO BU-DISPLAY-FLD (1)
                   PERFORM 2000-BLOWUP
               ELSE
                   NEXT SENTENCE
           ELSE
               MOVE RENAME-NEW-CODE     TO CORPCDE OF RECEIPTFIL-O-REC
               READ RECEIPTFIL-O INTO BUF-RECEIPTS2
                   INVALID KEY MOVE FILE-STATUS TO FILE-STATUS
               END-READ
               IF FILE-STATUS NOT = "00"
                   MOVE "READ ERROR * 640-CM"
                       TO BU-DISPLAY-MSG
                   MOVE RENAME-NEW-CODE  TO BU-DISPLAY-FLD (1)
                   PERFORM 2000-BLOWUP
               ELSE
                   MOVE BUF-RECEIPTS    TO BUF-RECEIPTS2
                   MOVE RENAME-NEW-CODE TO R-CORP-CODE2 OF BUF-RECEIPTS2
                   REWRITE RECEIPTFIL-O-REC FROM BUF-RECEIPTS2
                      INVALID KEY MOVE FILE-STATUS TO FILE-STATUS
                   END-REWRITE
                   IF FILE-STATUS NOT = "00"
                       MOVE "REWRITE ERROR * 640-CM"
                           TO BU-DISPLAY-MSG
                       MOVE RENAME-NEW-CODE TO BU-DISPLAY-FLD (1)
                       PERFORM 2000-BLOWUP.

       640-EXIT.
           EXIT.

      *D------ CHECKING CODES FOR WITHDRAWAL RESTRICTION TABLES.
       641-CHECK-RESTRICTIONS.
           IF STR2-RESTRICTED-FLG = "X"
               GO TO 641-CR-X
           ELSE
               IF STR-RESTRICTED-FLG = "X"
                   MOVE RENAME-OLD-CODE TO CORPCDE OF DRESTRIC-REC
                   READ DRESTRIC-O   INTO BUF-DRESTRIC
                        INVALID KEY MOVE FILE-STATUS TO FILE-STATUS
                   END-READ
                   IF FILE-STATUS NOT = "00"
                       MOVE "READ ERROR * 640-CR"
                           TO BU-DISPLAY-MSG
                       MOVE RENAME-OLD-CODE  TO BU-DISPLAY-FLD (1)
                       PERFORM 2000-BLOWUP
                   ELSE
                       MOVE RENAME-NEW-CODE TO RES-CORP-CODE,
                                               CORPCDE OF DRESTRIC-REC
                       WRITE DRESTRIC-REC  FROM BUF-DRESTRIC
                         INVALID KEY MOVE FILE-STATUS TO FILE-STATUS
                       END-WRITE
                       IF FILE-STATUS = "00"
                           NEXT SENTENCE
                       ELSE
                           MOVE "READ ERROR * 640-CR"
                              TO BU-DISPLAY-MSG
                           MOVE RENAME-OLD-CODE  TO BU-DISPLAY-FLD (1)
                           PERFORM 2000-BLOWUP.

       641-CR-X.
           EXIT.

       650-GET-PUT-DEL-BUFFERS.
           MOVE RENAME-OLD-CODE          TO CODE-ARG,
                                            BU-DISPLAY-FLD (1).
      ***** FIND ALL PO'S  THAT CODE IS ON
           MOVE CODE-ARG TO CORPCDE OF DPOITEM-O-REC.
           START DPOITEM-O KEY = CORPCDE OF DPOITEM-O-REC
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
                   NEXT SENTENCE
               ELSE
                   MOVE "START DPOITEM ERROR * 650-GPD-BUFFERS" TO
                       BU-DISPLAY-MSG
                   PERFORM 2000-BLOWUP
           ELSE
               PERFORM 6501-GET-PUT-DEL-DPOITEM THRU 6501-EXIT.

      ***** FIND ALL RESERVATIONS THAT CODE IS ON
           MOVE CODE-ARG TO CORPCDE OF DRESERVE-O-REC.
           START DRESERVE-O KEY = CORPCDE OF DRESERVE-O-REC
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
                   NEXT SENTENCE
               ELSE
                   MOVE "START DRESERVE ERROR * 650-GPD-BUFFERS" TO
                       BU-DISPLAY-MSG
                   PERFORM 2000-BLOWUP
           ELSE
               PERFORM 6502-GET-PUT-DEL-DRESERVE THRU 6502-EXIT.

      ***** FIND ALL WORKSHEETS THAT CODE IS ON
           MOVE CODE-ARG TO CORPCDE OF DWLITEM-O-REC.
           START DWLITEM-O KEY = CORPCDE OF DWLITEM-O-REC
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
                   NEXT SENTENCE
               ELSE
                   MOVE "START DWLITEM ERROR * 650-GPD-BUFFERS" TO
                       BU-DISPLAY-MSG
                   PERFORM 2000-BLOWUP
           ELSE
               PERFORM 6503-GET-PUT-DEL-DWLITEM THRU 6503-EXIT.

      ***** FIND ALL REQUISTIONS THAT CODE IS ON
           MOVE CODE-ARG TO CORPCDE OF DREQITM-O-REC.
           START DREQITM-O KEY = CORPCDE OF DREQITM-O-REC
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
                   NEXT SENTENCE
               ELSE
                   MOVE "START DREQITM ERROR * 650-GPD-BUFFERS" TO
                       BU-DISPLAY-MSG
                   PERFORM 2000-BLOWUP
           ELSE
               PERFORM 6504-GET-PUT-DEL-DREQITM THRU 6504-EXIT.

      ***** FIND ALL INVOICES THAT CODE IS ON
           MOVE CODE-ARG TO CORPCDE OF DINVITM-O-REC.
           START DINVITM-O KEY = CORPCDE OF DINVITM-O-REC
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
                   NEXT SENTENCE
               ELSE
                   MOVE "START DINVITM ERROR * 650-GPD-BUFFERS" TO
                       BU-DISPLAY-MSG
                   PERFORM 2000-BLOWUP
           ELSE
               PERFORM 6505-GET-PUT-DEL-DINVITM THRU 6505-EXIT.

      ***** FIND ALL RECEIVING SLIPS THAT CODE IS ON
           MOVE CODE-ARG TO CORPCDE OF DRCVITEM-O-REC.
           START DRCVITEM-O KEY = CORPCDE OF DRCVITEM-O-REC
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
                   NEXT SENTENCE
               ELSE
                   MOVE "START DRCVITEM ERROR * 650-GPD-BUFFERS" TO
                       BU-DISPLAY-MSG
                   PERFORM 2000-BLOWUP
           ELSE
               PERFORM 6506-GET-PUT-DEL-DRCVITEM THRU 6506-EXIT.

      ***** FIND ALL RECEIVING SLIP CORRECTIONS THAT CODE IS ON
           MOVE CODE-ARG TO CORPCDE OF DRCVCORR-O-REC.
           START DRCVCORR-O KEY = CORPCDE OF DRCVCORR-O-REC
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
                   NEXT SENTENCE
               ELSE
                   MOVE "START DRCVCORR ERROR * 650-GPD-BUFFERS" TO
                       BU-DISPLAY-MSG
                   PERFORM 2000-BLOWUP
           ELSE
               PERFORM 6516-GET-PUT-DEL-DRCVCORR THRU 6516-EXIT.

      ***** FIND ALL VENDORS TIED TO THIS CODE
           MOVE CODE-ARG TO CORPCDE OF DVENDITM-O-REC.
           START DVENDITM-O KEY = CORPCDE OF DVENDITM-O-REC
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
                   NEXT SENTENCE
               ELSE
                   MOVE "START DVENDITM ERROR * 650-GPD-BUFFERS" TO
                       BU-DISPLAY-MSG
                   PERFORM 2000-BLOWUP
           ELSE
               PERFORM 6507-GET-PUT-DEL-DVENDITM THRU 6507-EXIT.

      ***** FIND DESCRIPTION FOR CODE
           MOVE CODE-ARG TO CORPCDE OF DDESC-O-REC.
           START DDESC-O KEY = CORPCDE OF DDESC-O-REC
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
                   NEXT SENTENCE
               ELSE
                   MOVE "START DESC ERROR * 650-GPD-BUFFERS" TO
                       BU-DISPLAY-MSG
                   PERFORM 2000-BLOWUP
           ELSE
               IF CODE-IS-NEW
                   PERFORM 6508-GET-PUT-DEL-DDESC THRU 6508-EXIT
               ELSE
                   PERFORM 6508-DEL-DDESC THRU 6508-DD-EXIT.

           MOVE CODE-ARG TO CORPCDE OF DDESC2-O-REC.
           START DDESC2-O KEY = CORPCDE OF DDESC2-O-REC
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
                   NEXT SENTENCE
               ELSE
                   MOVE "START DESC2 ERROR * 650-GPD-BUFFERS" TO
                       BU-DISPLAY-MSG
                   PERFORM 2000-BLOWUP
           ELSE
               IF CODE-IS-NEW
                   PERFORM 6509-GET-PUT-DEL-DDESC2 THRU 6509-EXIT
               ELSE
                   PERFORM 6509-DEL-DDESC2 THRU 6509-DD-EXIT.

      ***** FIND CODE DETAIL INFO
           MOVE CODE-ARG TO CORPCDE OF DCODE-O-REC.
           START DCODE-O KEY = CORPCDE OF DCODE-O-REC
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
                   NEXT SENTENCE
               ELSE
                   MOVE "START DCODE ERROR * 650-GPD-BUFFERS" TO
                       BU-DISPLAY-MSG
                   PERFORM 2000-BLOWUP
           ELSE
               IF CODE-IS-NEW
                   PERFORM 6510-GET-PUT-DEL-DCODE THRU 6510-EXIT
               ELSE
                   PERFORM 6510-DEL-DCODE THRU 6510-DC-EXIT.

      ***** FIND MANUFACTURER INFO FOR CODE
           MOVE CODE-ARG TO CORPCDE OF DMANPART-O-REC.
           START DMANPART-O KEY = CORPCDE OF DMANPART-O-REC
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
                   NEXT SENTENCE
               ELSE
                   MOVE "START DMANPART ERROR * 650-GPD-BUFFERS" TO
                       BU-DISPLAY-MSG
                   PERFORM 2000-BLOWUP
           ELSE
               IF CODE-IS-NEW
                   PERFORM 6511-GET-PUT-DEL-DMANPART THRU 6511-EXIT
               ELSE
                   PERFORM 6511-DEL-DMANPART THRU 6511-DD-EXIT.

      ***** UPDATE THE SHIPPING RELEASE FILE FOR THE RENAMED CODE
           MOVE LOW-VALUES TO DATECYMD OF DSHIPREL-O-REC.
           START DSHIPREL-O KEY > DATECYMD OF DSHIPREL-O-REC
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
                   NEXT SENTENCE
               ELSE
                   MOVE "START DSHIPREL ERROR * 650-GPD-BUFFERS" TO
                       BU-DISPLAY-MSG
                   PERFORM 2000-BLOWUP
           ELSE
               PERFORM 6512-UPDATE-DSHIPREL THRU 6512-EXIT.

      ***** FIND TALLY INFO FOR CODE
           MOVE CODE-ARG TO CORPCDE OF DTALLY-O-REC.
           START DTALLY-O KEY = CORPCDE OF DTALLY-O-REC
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
                   NEXT SENTENCE
               ELSE
                   MOVE "START DTALLY ERROR * 6513-GPD-BUFFERS" TO
                       BU-DISPLAY-MSG
                   PERFORM 2000-BLOWUP
           ELSE
               PERFORM 6513-GET-PUT-DEL-DTALLY THRU 6513-EXIT.

      ***** FIND DCHATNO INFO FOR CODE
           MOVE CODE-ARG TO CORPCDE OF DCHATNO-O-REC.
           START DCHATNO-O KEY = CORPCDE OF DCHATNO-O-REC
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
                   NEXT SENTENCE
               ELSE
                   MOVE "START DCHATNO ERROR * 650-GPD-BUFFERS" TO
                       BU-DISPLAY-MSG
                   PERFORM 2000-BLOWUP
           ELSE
               PERFORM 6515-DEL-DCHATNO THRU 6515-EXIT.

      ***** FIND ALTERNATE KEYS FOR CODE RENAME
           MOVE SPACES TO BU-DISPLAY-MSG.
           MOVE RENAME-NEW-CODE TO NEW-CODE.
           CALL "SCCALTCH" USING CODE-ARG NEW-CODE
                          BU-DISPLAY-MSG BU-DISPLAY-FLDS.
           IF BU-DISPLAY-MSG NOT = SPACES
               PERFORM 2000-BLOWUP.

      ***** FIND PM JOBPLAN PARTS FOR CODE RENAME
           MOVE SPACES TO BU-DISPLAY-MSG.
           MOVE RENAME-NEW-CODE TO NEW-CODE.
           CALL "SJOBPCOD" USING CODE-ARG NEW-CODE NEW-UM
                NEW-UM-CF BU-DISPLAY-MSG BU-DISPLAY-FLDS.
           IF BU-DISPLAY-MSG NOT = SPACES
               PERFORM 2000-BLOWUP.

      ***** FIND MMISA CORP-CODE-LINKS FOR CODE RENAME
           MOVE SPACES TO BU-DISPLAY-MSG.
           MOVE RENAME-NEW-CODE TO NEW-CODE.
           CALL "SCCLKCHG" USING CODE-ARG NEW-CODE
                          BU-DISPLAY-MSG BU-DISPLAY-FLDS.
           IF BU-DISPLAY-MSG NOT = SPACES
               PERFORM 2000-BLOWUP.

       650-EXIT.
           EXIT.

       6501-GET-PUT-DEL-DPOITEM.
      *    DISPLAY "GET OLD CODE - DPOITEM", CODE-ARG.
           READ DPOITEM-O NEXT INTO BUF-DPOITEM
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   GO TO 6501-EXIT
               ELSE
                   MOVE "READN ERROR * 6501-GPD-DPOITEM"
                       TO BU-DISPLAY-MSG
                   PERFORM 2000-BLOWUP.
           IF CORPCDE OF DPOITEM-O-REC NOT = CODE-ARG
                   GO TO 6501-EXIT.

           IF ITM-PO-NO-1-4 = "ITOV" GO TO 6541-GPDD-ITOV.

           MOVE RENAME-NEW-CODE          TO ITM-CORP-CODE.
           REWRITE DPOITEM-O-REC FROM BUF-DPOITEM
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE "REWRITE ERROR * 6501-GPD-DPOITEM"
                   TO BU-DISPLAY-MSG
               MOVE RENAME-NEW-CODE      TO BU-DISPLAY-FLD (1)
               PERFORM 2000-BLOWUP.

           GO TO 6501-GET-PUT-DEL-DPOITEM.

       6541-GPDD-ITOV.
           DELETE DPOITEM-O
               INVALID KEY    MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE "DPOITEM DELETE FAILURE *6501-GODD-ITOV"
                   TO BU-DISPLAY-MSG
               MOVE RENAME-OLD-CODE TO BU-DISPLAY-FLD (1)
               MOVE RENAME-NEW-CODE TO BU-DISPLAY-FLD (2)
               PERFORM 2000-BLOWUP.

           GO TO 6501-GET-PUT-DEL-DPOITEM.

       6501-EXIT.
           EXIT.

