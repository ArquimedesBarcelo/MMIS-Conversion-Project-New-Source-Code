       IDENTIFICATION DIVISION.
       PROGRAM-ID.          TAKINVCK.
       AUTHOR.              C HILLES.
       DATE-WRITTEN.        5/7/85.
       DATE-COMPILED.
      *INSTALLATION.        GOODYEAR TIRE AND RUBBER - AKRON.
      *D*
      *D* REMARKS.  AKRON UPDATE INVOICE CHECK ADD SUBPROGRAM.
      *D*
      *D* THIS SUBPROGRAM IS CALLED FROM "TAKRUPDT" - THE AKRON UPDATE
      *D* PROGRAM.  THIS IS FOR TRANSACTION CODES "60" FROM THE
      *D* MAINFRAME, WHICH UPDATE INVOICE CHECK NUMBERS IN THE
      *D* "STORES" DATABASE.
      *D*
      *C* CHANGES
      *C*
      *C* JANUARY 25, 1994     CR KALMAN
      *C* REMOVED PORTABLILITY STUFF.
      *C*
      *C* SEPT 16, 1996    CA YODER
      *C*   MODIFIED PROGRAM FOR CENTURY DATABASE CHANGES.
      *C*
DP9801*C* 26JAN1998   DAVE PLUM
DP9801*C*   REVISED TO RESOLVE A PROBLEM WITH THE CONTROL DATE
DP9801*C*   RECORDS WHICH ARE WRITTEN TO FILE DRPTICHK (*980126).
DP9801*C*   THESE RECORDS SHOULD BE WRITTEN TO THE FILE WITH SPACES
DP9801*C*   FILLING THE REMAINDER OF THE PRINT RECORD WHICH FOLLOWS
DP9801*C*   THE YMD DATE FIELD.
      *C*
       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.
       SOURCE-COMPUTER.  HP-3000.
       OBJECT-COMPUTER.  HP-3000.
       SPECIAL-NAMES.
      *    CONDITION-CODE IS C-C.
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.

           SELECT INVCK-RPT-FILE ASSIGN TO DISK-DRPTICHK.
           SELECT DINVRCD-RN-O
               ASSIGN TO DATABASE-MCFLCS2501
               ORGANIZATION IS INDEXED
                 ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                 WITH DUPLICATES
               FILE STATUS IS FILE-STATUS.

           SELECT DVENDOR-VN-I
               ASSIGN TO DATABASE-MCFLCS0701
               ORGANIZATION IS INDEXED
                 ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                 WITH DUPLICATES
               FILE STATUS IS FILE-STATUS.

       DATA DIVISION.
       FILE SECTION.
      *------ FD STATEMENT AREA FOR IBM ONLY ------*
       FD  INVCK-RPT-FILE
           LABEL RECORDS ARE STANDARD.
       01  PRT-RCD.
           05  CONTROL-CHARACTER         PIC X(1).
           05  PRT-LINE.
               10  CONTROL-DATE          PIC X(6).
DP9801         10  CONTROL-LAST-126      PIC X(126).

       FD  DINVRCD-RN-O
           LABEL RECORDS ARE STANDARD.
       01  DINVRCD-RN-REC-O.
           COPY DDS-MCRPCS2500  OF MCFLCS2501.

       FD  DVENDOR-VN-I
           LABEL RECORDS ARE STANDARD.
       01  DVENDOR-VN-REC-I.
           COPY DDS-MCRPCS0700  OF MCFLCS0701.

      *------ FD STATEMENT AREA FOR IBM ONLY ------*
       WORKING-STORAGE SECTION.
       77  FATAL-ERR-SW                  PIC X(1)  VALUE "N".
       77  CHKPRT-FILE                   PIC X(9)  VALUE "DRPTICHK;".
       77  VEN-ERROR-FLAG                PIC X(1)  VALUE "N".

       01  BU-DISPLAY-MSG               PIC X(60).

      *************************************************************
      **                                                          **
      **          C O M M U N I C A T I O N S   A R E A S         **
      **                                                          **
      **************************************************************

       COPY TDATECHK   IN COPYLIB.
       COPY CCRTFILE   IN COPYLIB.
      *---------- PARMS FOR CALL TO FCHECK, FERRMSG INTRINSICS

       01  FCHECK-ERROR-NUM                PIC S9(4) BINARY VALUE 0.
       01  FCHECK-MSG                      PIC X(72) VALUE SPACES.
       01  FCHECK-MSG-LENGTH               PIC S9(4) BINARY VALUE 0.

      *----------  INTRINSIC "COMMAND"
      *01  COMMAND-AREA.
      *    05  COMMAND-IMAGE.
      *        10  COMMAND                 PIC X(81) VALUE SPACES.
      *        10  FILLER                  PIC X(1)   VALUE %15.
      *    05  COMMAND-ERROR               PIC 9(4)  BINARY VALUE 0.
      *    05  COMMAND-PARM                PIC 9(4)  BINARY VALUE 0.
      *
       COPY SETJCW IN COPYLIB.

      **************************************************************
      **                                                          **
      **      D A T A B A S E   B U F F E R S                     **
      **                                                          **
      **************************************************************

       COPY DINVRCD    IN COPYLIB.
       COPY DVENDOR    IN COPYLIB.


      **************************************************************
      **                                                          **
      **            D A T A B A S E   W O R K                     **
      **                                                          **
      **************************************************************
       01  FILE-STATUS.
           05  FILE-STATUS-1            PIC X  VALUE "0".
           05  FILE-STATUS-2            PIC X  VALUE "0".

       01  DSET-NAMES.
           05  DSET-DINVRCD              PIC X(16) VALUE "DINVRCD;".
           05  DSET-DVENDOR              PIC X(16) VALUE "DVENDOR;".

       01  MODE-AREA.
           05  MODE1                  PIC S9(4)   COMP       VALUE 1.
           05  MODE3                  PIC S9(4)   COMP       VALUE 3.
           05  MODE5                  PIC S9(4)   COMP       VALUE 5.
           05  MODE7                  PIC S9(4)   COMP       VALUE 7.

       01  ITEM-LISTINGS.
           05  ALL-ITEM-LIST       PIC XX    VALUE "@;".
           05  REGISTER-SEARCH     PIC X(16) VALUE "REGISTER-NUMBER;".
           05  VEN-SEARCH          PIC X(16) VALUE "VEN-CODE;".

       01  DINVRCD-LIST.
           05  FILLER                 PIC X(9)  VALUE "VEN-CODE,".
           05  FILLER                 PIC X(15) VALUE "INV-CHECK-DATE,".
           05  FILLER                 PIC X(13) VALUE "INV-CHECK-NO;".

       01  REGISTER-ARG                  PIC X(6)  VALUE SPACES.
       01  VEN-ARG                       PIC X(10) VALUE SPACES.

       01  MULTI-LOCK.
           05  NUMBER-OF-LOCK-DESCRIPTORS PIC S9(4) BINARY VALUE 1.
           05  LOCK-MSTORERM.
               10  LOCK-LENGTH        PIC S9(4) BINARY VALUE 24.
               10  LOCK-DSET          PIC X(16)  VALUE "DINVRCD;".
               10  LOCK-ITEM-LIST PIC X(16)  VALUE "REGISTER-NUMBER;".
               10  LOCK-REL-OP        PIC XX     VALUE "= ".
               10  LOCK-VALUE         PIC X(12)  VALUE SPACES.

      **************************************************************
      **                                                          **
      **         H E A D E R   &  D E T A I L   A R E A S         **
      **                                                          **
      **************************************************************

       01  RPT-HD1.
           05  FILLER          PIC X(4)  VALUE "PAGE".
           05  PRT-PAGE        PIC ZZZ9.
           05  FILLER          PIC X(15) VALUE SPACES.
           05  FILLER          PIC X(16) VALUE "I N V O I C E   ".
           05  FILLER          PIC X(12) VALUE "C H E C K   ".
           05  FILLER          PIC X(14) VALUE "N U M B E R   ".
           05  FILLER          PIC X(13) VALUE "U P D A T E S".
           05  FILLER          PIC X(12) VALUE SPACES.
           05  FILLER          PIC X(5)  VALUE "DATE ".
           05  PRT-DT-HD       PIC X(8).
           05  FILLER          PIC X(2)  VALUE SPACES.
           05  PRT-TM-HD       PIC X(8).

       01  RPT-HD2.
           05  FILLER          PIC X(9)  VALUE "REGISTER#".
           05  FILLER          PIC X(3)  VALUE SPACES.
           05  FILLER          PIC X(3)  VALUE "C/E".
           05  FILLER          PIC X(3)  VALUE SPACES.
           05  FILLER          PIC X(7)  VALUE "INVOICE".
           05  FILLER          PIC X(8)  VALUE SPACES.
           05  FILLER          PIC X(2)  VALUE "BC".
           05  FILLER          PIC X(2)  VALUE SPACES.
           05  FILLER          PIC X(6)  VALUE "CHECK#".
           05  FILLER          PIC X(2)  VALUE SPACES.
           05  FILLER          PIC X(10) VALUE "CHECK DATE".
           05  FILLER          PIC X(2)  VALUE SPACES.
           05  FILLER          PIC X(7)  VALUE "MNFST#".
           05  FILLER          PIC X(3)  VALUE SPACES.
           05  FILLER          PIC X(11) VALUE "VENDOR CODE".
           05  FILLER          PIC X(3)  VALUE SPACES.
           05  FILLER          PIC X(7)  VALUE "MESSAGE".

       01  RPT-DETAIL.
           05  PRT-REGISTER    PIC X(5).
           05  FILLER          PIC X(7)  VALUE SPACES.
           05  PRT-CLASS       PIC X(1).
           05  FILLER          PIC X(5)  VALUE SPACES.
           05  PRT-INVOICE     PIC X(14).
           05  FILLER          PIC X(1)  VALUE SPACES.
           05  PRT-BANKCODE    PIC X(1).
           05  FILLER          PIC X(3)  VALUE SPACES.
           05  PRT-CHECK-NO    PIC X(6).
           05  FILLER          PIC X(2)  VALUE SPACES.
           05  PRT-CHK-DATE    PIC X(8).
           05  FILLER          PIC X(4)  VALUE SPACES.
           05  PRT-MANIFEST    PIC X(3)  VALUE SPACES.
           05  FILLER          PIC X(7)  VALUE SPACES.
           05  PRT-VENDOR      PIC X(7).
           05  FILLER          PIC X(7)  VALUE SPACES.
           05  PRT-MESSAGE     PIC X(50) VALUE SPACES.
           05  PRT-MSG-FLD     PIC Z(10) VALUE "0000000000".
           05  PRT-MSG-FLD-X REDEFINES PRT-MSG-FLD PIC X(10).

       01  VEN-HEADER.
           05  FILLER      PIC X(3)  VALUE SPACES.
           05  FILLER      PIC X(13) VALUE "CHECK VN CODE".
           05  FILLER      PIC X(19) VALUE "    INVOICE VN CODE".
           05  FILLER      PIC X(19) VALUE "  CHECK VENDOR NAME".
           05  FILLER      PIC X(29) VALUE SPACES.
           05  FILLER      PIC X(20) VALUE "INVOICE VENDOR NAME".

       01  VEN-DETAIL.
           05  FILLER                    PIC X(3)  VALUE SPACES.
           05  PRT-CHECK-VENDOR          PIC X(7).
           05  FILLER                    PIC X(10) VALUE SPACES.
           05  PRT-INV-VENDOR            PIC X(7).
           05  FILLER                    PIC X(10) VALUE SPACES.
           05  PRT-CHECK-VEN-NAME        PIC X(44).
           05  FILLER                    PIC X(2)  VALUE SPACES.
           05  PRT-INV-VEN-NAME          PIC X(44).

      **************************************************************
      **                                                          **
      **         L I N K A G E   S E C T I O N                    **
      **                                                          **
      **************************************************************

       LINKAGE SECTION.

       01  RET-CODE                      PIC S9(4) BINARY.
       01  CALL-MODE                     PIC S9(4) BINARY.

       01  BASE                          PIC X(10).
       01  STATUS-AREA.
           05  COND-WORD              PIC S9(4)   BINARY.
           05  DATA-LENG              PIC S9(4)   BINARY.
           05  RCD-NO                 PIC S9(9)   BINARY.
           05  CHAIN-LENG             PIC S9(9)   BINARY.
           05  BKWD-ADDR              PIC S9(9)   BINARY.
           05  FWRD-ADDR              PIC S9(9)   BINARY.

       01  INVOICE-CHECK-RECORD.
           05  FILLER                    PIC X(1).
           05  IC-TC                     PIC X(2).
           05  IC-COMPANY                PIC X(3).
           05  IC-REGISTER               PIC X(5).
           05  IC-CLASS                  PIC X(1).
           05  IC-INVOICE                PIC X(14).
           05  IC-BANKCODE               PIC X(1).
           05  IC-CHECK-NO               PIC X(6).
           05  IC-CHK-DATE.
               10  IC-CHK-YY             PIC X(2).
               10  FILLER                PIC X(4).
           05  IC-MANIFEST               PIC X(3).
           05  IC-VENDOR                 PIC X(7).
           05  IC-VENDOR-NAME            PIC X(44).
           05  FILLER                    PIC X(40).

       01  INVCK-DATA.
           05  FILENO-CHKPRT             PIC S9(4) BINARY.
           05  LINE-K                    PIC S9(4) BINARY.
           05  PAGE-K                    PIC S9(4) BINARY.


       PROCEDURE DIVISION USING RET-CODE, CALL-MODE, BASE,
           STATUS-AREA, INVOICE-CHECK-RECORD, INVCK-DATA.
       6000-MAIN.
           MOVE "N" TO FATAL-ERR-SW, VEN-ERROR-FLAG.
           MOVE SPACES TO PRT-MESSAGE.
           OPEN I-O DINVRCD-RN-O.
           OPEN INPUT DVENDOR-VN-I.
      *------ CALL CCRTFILE TO CREATE A TEMPORARY FILE 'DRPTICHK'
           MOVE "*LIBL"       TO CCRTFILE-LIBRARY.
           MOVE "DRPTICHK"    TO CCRTFILE-FILE.
           MOVE "0133"        TO CCRTFILE-RECORD-LENGTH.
           MOVE "01000"       TO CCRTFILE-NO-RECORDS.
           MOVE "01000"       TO CCRTFILE-INCREMENT-AMT.
           MOVE "02"          TO CCRTFILE-NO-INCREMENTS.
           CALL "CCRTFILE" USING CCRTFILE-LIBRARY,
                                 CCRTFILE-FILE,
                                 CCRTFILE-RECORD-LENGTH,
                                 CCRTFILE-NO-RECORDS,
                                 CCRTFILE-INCREMENT-AMT,
                                 CCRTFILE-NO-INCREMENTS,
                                 CCRTFILE-STATUS.
           IF CCRTFILE-STATUS NOT = "00"
               MOVE "CCRTFILE CREATE OF 'DRPTICHK' FAILED"
                  TO BU-DISPLAY-MSG
               MOVE 9 TO RET-CODE
               GO TO 6990-MAIN-X.

           OPEN EXTEND INVCK-RPT-FILE.
           MOVE "1" TO CONTROL-CHARACTER.
           MOVE SPACES                   TO  VEN-NAME.
           IF FILENO-CHKPRT = 0
               MOVE 1 TO FILENO-CHKPRT
               MOVE "Y"          TO SETJCW-VALUE
               MOVE 285          TO SETJCW-STARTING-POS
               MOVE 1            TO SETJCW-LENGTH
               CALL "SETJCW" USING SETJCW-VALUE,
                                   SETJCW-STARTING-POS,
                                   SETJCW-LENGTH,
                                   SETJCW-STATUS
               PERFORM 6560-HEADERS.

       6100-UPDATE-CHECK.
      *H   MOVE IC-REGISTER              TO  LOCK-VALUE.
      *H   CALL "DBLOCK" USING BASE, MULTI-LOCK, MODE5, STATUS-AREA.
      *H   IF COND-WORD NOT = 0
      *H       PERFORM 6570-DATABASE-ERROR
      *H       MOVE 2                    TO  RET-CODE
      *H       GO TO 6990-MAIN-X.
      *H
           MOVE IC-REGISTER              TO  REGISTER-ARG.
           PERFORM 9999-DBFIND-DINVRCD-RN-O.
           IF COND-WORD = 17
               MOVE "* REGISTER NUMBER DOES NOT EXIST *"
                 TO  PRT-MESSAGE
               PERFORM 6500-PRINT-LINE
               PERFORM 6400-UNLOCK
               GO TO 6990-MAIN-X.

           PERFORM 9999-DBGET5-DINVRCD-RN-O.
           IF COND-WORD NOT = 0
               MOVE "* REGISTER NUMBER DOES NOT EXIST *"
                 TO  PRT-MESSAGE
               PERFORM 6500-PRINT-LINE
               PERFORM 6400-UNLOCK
                GO TO 6990-MAIN-X.

           MOVE IC-CHECK-NO              TO  INV-CHECK-NO.
           MOVE IC-CHK-DATE              TO  INV-CHECK-DATE.

      *---------- ACCOUNT FOR CENTURY.
           IF IC-CHK-DATE > SPACES
               IF IC-CHK-YY > "70"
                   MOVE "19"             TO  INV-CHECK-CC
               ELSE
                   MOVE "20"             TO  INV-CHECK-CC.

           PERFORM 9999-DBUPDATE-DINVRCD-RN-O.
           IF COND-WORD NOT = 0
               MOVE "* DBUPDATE ERROR ON REQISTER *"
                 TO  PRT-MESSAGE
               PERFORM 6570-DATABASE-ERROR
               MOVE 4                    TO  RET-CODE
               GO TO 6990-MAIN-X.

           PERFORM 6400-UNLOCK.

           IF IC-VENDOR NOT = INV-VEN-CODE-1-7
               MOVE
               "* VENDOR NUMBER DOES NOT MATCH - STILL UPDATED *"
                 TO PRT-MESSAGE
               MOVE "Y"                 TO  VEN-ERROR-FLAG.

           PERFORM 6600-GET-VENDOR THRU 6690-GV-X
           IF VEN-NAME NOT = IC-VENDOR-NAME
               MOVE
               "* VENDOR NAME DOES NOT MATCH - STILL UPDATED *"
                                         TO  PRT-MESSAGE
               MOVE "Y"                  TO  VEN-ERROR-FLAG.

           PERFORM 6500-PRINT-LINE.
           GO TO 6990-MAIN-X.

       6400-UNLOCK.
      *H   CALL "DBUNLOCK" USING BASE, DSET-DINVRCD, MODE1,
      *H     STATUS-AREA.
      *H   IF COND-WORD NOT = 0
      *H       PERFORM 6570-DATABASE-ERROR
      *H       MOVE 6                    TO  RET-CODE.
      *H
       6500-PRINT-LINE.
           MOVE IC-REGISTER              TO  PRT-REGISTER.
           MOVE IC-CLASS                 TO  PRT-CLASS.
           MOVE IC-INVOICE               TO  PRT-INVOICE.
           MOVE IC-BANKCODE              TO  PRT-BANKCODE.
           MOVE IC-CHECK-NO              TO  PRT-CHECK-NO.
           MOVE IC-BANKCODE              TO  PRT-BANKCODE.
           MOVE IC-CHECK-NO              TO  PRT-CHECK-NO.
           MOVE IC-CHK-DATE              TO  DATE-VALIDATE-IN.
           MOVE 4                        TO  DATE-MODE.
           CALL "TDATECHK" USING DATE-CHECK-AREA.
           MOVE DATE-SLASH-OUT           TO  PRT-CHK-DATE.
           MOVE IC-MANIFEST              TO  PRT-MANIFEST.
           MOVE IC-VENDOR                TO  PRT-VENDOR.

DP9801     MOVE "1"                      TO  CONTROL-CHARACTER.
           MOVE RPT-DETAIL               TO  PRT-LINE.
           PERFORM 6550-WRITE.
           IF VEN-ERROR-FLAG = "Y"
               PERFORM 6565-VENDOR-ERROR.

           ADD 1                         TO  LINE-K.
           IF LINE-K > 60
               PERFORM 6560-HEADERS.

       6550-WRITE.
           IF CONTROL-CHARACTER = SPACES
               MOVE "1" TO CONTROL-CHARACTER.
           WRITE PRT-RCD.

       6560-HEADERS.
           MOVE 1                        TO  DATE-MODE.
           CALL "TDATECHK" USING DATE-CHECK-AREA.
           MOVE DATE-SLASH-OUT           TO  PRT-DT-HD.
           MOVE DATE-FORMATTED-TIME-OUT  TO  PRT-TM-HD.
           MOVE "*"                      TO  CONTROL-CHARACTER.
           MOVE DATE-YMD-OUT             TO  CONTROL-DATE.
DP9801     MOVE SPACES                   TO  CONTROL-LAST-126.
           PERFORM 6550-WRITE.
           ADD 1                         TO  PAGE-K.
           MOVE 3                        TO  LINE-K.
           MOVE PAGE-K                   TO  PRT-PAGE.
           MOVE "0"                      TO  CONTROL-CHARACTER.
           MOVE RPT-HD1                  TO  PRT-LINE.
           PERFORM 6550-WRITE.
           MOVE "2"                      TO  CONTROL-CHARACTER.
           MOVE RPT-HD2                  TO  PRT-LINE.
           PERFORM 6550-WRITE.
           MOVE "1"                      TO  CONTROL-CHARACTER.

       6565-VENDOR-ERROR.
DP9801     MOVE "1"                      TO  CONTROL-CHARACTER.
           MOVE VEN-HEADER               TO  PRT-LINE.
           PERFORM 6550-WRITE.
           MOVE IC-VENDOR                TO  PRT-CHECK-VENDOR.
           MOVE INV-VEN-CODE             TO  PRT-INV-VENDOR.
           IF IC-VENDOR-NAME = SPACES
               MOVE "* NO VENDOR NAME ON CHECK *"
                                         TO PRT-CHECK-VEN-NAME
           ELSE
               MOVE IC-VENDOR-NAME       TO  PRT-CHECK-VEN-NAME.
           IF VEN-NAME = SPACES
DP9801         MOVE "* NO VENDOR NAME ON LOCAL FILE *"
                                         TO  PRT-INV-VEN-NAME
           ELSE
               MOVE VEN-NAME             TO  PRT-INV-VEN-NAME.

DP9801     MOVE "1"                      TO  CONTROL-CHARACTER.
           MOVE VEN-DETAIL               TO  PRT-LINE.
           PERFORM 6550-WRITE.
DP9801     MOVE "1"                      TO  CONTROL-CHARACTER.
           MOVE SPACES                   TO  PRT-LINE.
           PERFORM 6550-WRITE.
           ADD 3                         TO  LINE-K.

       6570-DATABASE-ERROR.
           DISPLAY "******** DATABASE ERROR IN TAKINVCK ********".
           DISPLAY PRT-MESSAGE.
      *H   CALL "DBEXPLAIN" USING STATUS-AREA.
      *H   CALL "DBUNLOCK" USING BASE, DSET-DINVRCD, MODE1,
      *H     STATUS-AREA.
           PERFORM 6500-PRINT-LINE.

       6600-GET-VENDOR.
           MOVE INV-VEN-CODE             TO  VEN-ARG.
           PERFORM 9999-DBFIND-DVENDOR-VN-I.
           IF COND-WORD = 17
               GO TO 6690-GV-X
           ELSE
           IF COND-WORD NOT = 0
               MOVE "DBFIND ERROR DVENDOR" TO PRT-MESSAGE
               PERFORM 6570-DATABASE-ERROR
               MOVE 7                    TO  RET-CODE
               GO TO 6690-GV-X.

           PERFORM 9999-DBGET5-DVENDOR-VN-I.
           IF COND-WORD = 15
               GO TO 6690-GV-X
           ELSE
           IF COND-WORD NOT = 0
               MOVE "DBGET ERROR DVENDOR" TO PRT-MESSAGE
               PERFORM 6570-DATABASE-ERROR
               MOVE 8                    TO  RET-CODE
               GO TO 6690-GV-X.

       6690-GV-X.
           EXIT.

      *---------- WHEN THE FIRST TC-60 TRANSACTION IS ENCOUNTERED,
      *---------- SET THE JCW "INVRPTSW" TO TELL THE JOB STREAM TO
      *---------- RUN "XPRTRPT" TO PRINT THE INVOICE UPDATE REPORT.
      *    MOVE "SETJCW INVRPTSW=1"      TO  COMMAND.
      *    CALL INTRINSIC "COMMAND" USING COMMAND-IMAGE, COMMAND-ERROR,
      *      COMMAND-PARM.
      *    IF COMMAND-ERROR NOT = 0
      *        MOVE 7                    TO  RET-CODE
      *        MOVE "Y"                  TO  FATAL-ERR-SW
      *        DISPLAY "** SETJCW OF INVRPTSW FAILED **".
      *
       6990-MAIN-X.
           CLOSE DINVRCD-RN-O, DVENDOR-VN-I, INVCK-RPT-FILE.
           GOBACK.

       9999-DBFIND-DINVRCD-RN-O.
           MOVE 0 TO COND-WORD.
           MOVE REGISTER-ARG TO REGISTERNO OF DINVRCD-RN-REC-O.
           START DINVRCD-RN-O KEY = REGISTERNO OF DINVRCD-RN-REC-O
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF (FILE-STATUS NOT = "00") AND (FILE-STATUS-1 NOT = "2")
               MOVE "DBFIND ERR 9999-DBFIND-DINVRCD-RN-O"
                   TO BU-DISPLAY-MSG
               MOVE 99 TO COND-WORD.

       9999-DBGET5-DINVRCD-RN-O.
           MOVE 0 TO COND-WORD.
           READ DINVRCD-RN-O NEXT INTO BUF-DINVRCD
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   MOVE 15 TO COND-WORD
               ELSE
                   MOVE "DBGET5 ERR 9999-DBGET5-DINVRCD-RN-O"
                       TO BU-DISPLAY-MSG
                   MOVE 99 TO COND-WORD
           ELSE
           IF REGISTERNO OF DINVRCD-RN-REC-O NOT = REGISTER-ARG
               MOVE 15 TO COND-WORD.

       9999-DBUPDATE-DINVRCD-RN-O.
           MOVE 0 TO COND-WORD.
           REWRITE DINVRCD-RN-REC-O FROM BUF-DINVRCD
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE "DBUPDATE ERR 9999-DBUPDATE-DINVRCD-RN-O"
                   TO BU-DISPLAY-MSG
               MOVE 99 TO COND-WORD.

       9999-DBFIND-DVENDOR-VN-I.
           MOVE 0 TO COND-WORD.
           MOVE VEN-ARG TO VENCDE OF DVENDOR-VN-REC-I.
           START DVENDOR-VN-I KEY = VENCDE OF DVENDOR-VN-REC-I
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF (FILE-STATUS NOT = "00") AND (FILE-STATUS-1 NOT = "2")
               MOVE "DBFIND ERR 9999-DBFIND-DVENDOR-VN-I"
                   TO BU-DISPLAY-MSG
               MOVE 99 TO COND-WORD.

       9999-DBGET5-DVENDOR-VN-I.
           MOVE 0 TO COND-WORD.
           READ DVENDOR-VN-I NEXT INTO BUF-DVENDOR
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   MOVE 15 TO COND-WORD
               ELSE
                   MOVE "DBGET5 ERR 9999-DBGET5-DVENDOR-VN-I"
                       TO BU-DISPLAY-MSG
                   MOVE 99 TO COND-WORD
           ELSE
           IF VENCDE OF DVENDOR-VN-REC-I NOT = VEN-ARG
               MOVE 15 TO COND-WORD.

