000200 IDENTIFICATION DIVISION.
000300 PROGRAM-ID. TEDIMAIN.
000700**************************************************************
000800*                                                            *
000900*   T E D I M A I N   THIS PROGRAM HANDLES THE MAINTENANCE   *
001000*     FOR THE EDI LOG FILE (DEDILOG/MCFPCS4800).             *
001700*                                                            *
001800**************************************************************
      *C
      *C 09/12/96  JEFF BUNGO
      *C   EXPAND DATE FIELDS FOR YEAR 2000 COMPLIANCE.
      *C   RECOMPILE TO PICK UP COPYLIB CHANGES.
      *C
005100 ENVIRONMENT DIVISION.
005200 CONFIGURATION SECTION.
005300 SOURCE-COMPUTER.  IBM-AS400.
005400 OBJECT-COMPUTER.  IBM-AS400.
       SPECIAL-NAMES. I-O-FEEDBACK IS I-O-FEEDBACK-AREA.
005600 INPUT-OUTPUT SECTION.
005700 FILE-CONTROL.
           SELECT DEDILOG-LK-O
               ASSIGN TO DATABASE-MCFLCS4802
               ORGANIZATION IS INDEXED
                 ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                 WITH DUPLICATES
               FILE STATUS IS FILE-STATUS.


           SELECT DISPLAY-FILE
                  ASSIGN TO WORKSTATION-ZEDIABST-SI
                  ORGANIZATION IS TRANSACTION
                  ACCESS IS SEQUENTIAL
                  FILE STATUS IS DISPLAY-STATUS
                  CONTROL-AREA IS WS-CONTROL.

           SELECT MPLTINFO-PK-I
               ASSIGN TO DATABASE-MCFLCS0501
               ORGANIZATION IS INDEXED
                 ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
               FILE STATUS IS FILE-STATUS.


006600 DATA DIVISION.
006700 FILE SECTION.
       FD  DEDILOG-LK-O
           LABEL RECORDS ARE STANDARD.
       01  DEDILOG-LK-REC-O.
           COPY DDS-MCRPCS4800 OF MCFLCS4802.

       FD  DISPLAY-FILE
           LABEL RECORDS ARE OMITTED.
       01  DISPLAY-REC.
           COPY DDS-ALL-FORMATS OF ZEDIABST.
011900
       FD  MPLTINFO-PK-I
           LABEL RECORDS ARE STANDARD.
       01  MPLTINFO-PK-REC-I.
           COPY DDS-MCRPCS0500 OF MCFLCS0501.

012000 WORKING-STORAGE SECTION.
012100 77  COMP-SCREEN-INDIC           PIC X(3)   VALUE SPACES.
       77  DEL-SW                      PIC X      VALUE "N".
       77  DELETE-CTR                  PIC 9(5).
003300 77  HANDLE-BLOWUP-FLAG          PIC X(1)   VALUE "Y".
012300 77  SUB                         PIC S9(4)  VALUE ZEROS COMP-4.
       77  SUB2                        PIC S9(4)  VALUE ZEROS COMP-4.
       77  SUB3                        PIC S9(4)  VALUE ZEROS COMP-4.

       01  ACT-KEY                     PIC 9(9).

028100 01  ARG-VALUES.
028200     05  REQ-ARG                 PIC X(12) VALUE SPACES.
028300     05  PLT-ARG                 PIC X(4)  VALUE SPACES.
028400     05  CODE-ARG                PIC X(8)  VALUE SPACES.
028500     05  PO-ARG                  PIC X(14) VALUE SPACES.
026600
023900 01  BUILD-PO-NUM.
024000     05  FILLER                  PIC X    VALUE "P".
024100     05  PO-NUM                  PIC X(7) VALUE SPACES.
024200     05  PO-RLSE                 PIC X(3) VALUE SPACES.
024300     05  FILLER                  PIC X(3) VALUE "000".
024400
       COPY CATREAD IN COPYLIB.

       COPY CDLTFILE IN COPYLIB.

       COPY CCRTFILE IN COPYLIB.

       COPY CCHKOBJ IN COPYLIB.

       COPY CCHKOBJM IN COPYLIB.

030800 01  DATES-AND-TIMES.
030900     05  HP-CUR-DATE.
031000         10  MM                  PIC XX.
031100         10  FILLER              PIC X.
031200         10  DD                  PIC XX.
031300         10  FILLER              PIC X.
031400         10  YY                  PIC XX.
031500     05  CUR-DATE.
031600         10  YY                  PIC XX.
031700         10  MM                  PIC XX.
031800         10  DD                  PIC XX.
031900
027300 COPY DATAB    IN COPYLIB.
027400
       COPY DEDILOG IN COPYLIB.

       01  DE-FIELDS-0.
           05  DE-COMMAND-LINE-0       PIC X(79).
           05  DE-MESSAGE-LINE-0       PIC X(79).

022600 01  DE-FIELDS-1.
022700     05  DISP-COMPANY-1          PIC X(3)  VALUE SPACES.
           05  DE-BATCH-ENTRIES-1.
023400         10  DE-DISP-ENTRIES-1 OCCURS 16 TIMES.
                   15  FILLER          PIC X.
015000             15  DE1-KEY         PIC X(10).
015100             15  FILLER          PIC X(3).
015200             15  DE1-INIT-DATE   PIC X(6).
015300             15  FILLER          PIC X(3).
015600             15  DE1-SEND-DATE   PIC X(6).
015700             15  FILLER          PIC X(3).
016200             15  DE1-FLAGS       PIC X(6).
016300             15  FILLER          PIC X(2).
016400             15  DE1-VENDOR      PIC X(10).
016500             15  FILLER          PIC X(3).
016600             15  DE1-BATCHNO     PIC X(8).
016700             15  FILLER          PIC X(3).
016800             15  DE1-ITEM-NO     PIC X(4).
016900             15  FILLER          PIC X(11).
           05  DE-MSG-LINE-1           PIC X(79) VALUE SPACES.
           05  DE-COMMAND-LINE-1       PIC X(79) VALUE SPACES.
           05  DE-MESSAGE-LINE-1       PIC X(79) VALUE SPACES.
023700
       01  DE-FIELDS-2.
           05  DE-BATCH-NO-2           PIC X(8)  VALUE SPACES.
           05  DE-PO-NO-2.
               10  DE-PO-NO-7-2        PIC X(7)  VALUE SPACES.
               10  DE-PO-NO-RLSE-2     PIC X(3)  VALUE SPACES.
           05  DE-INITDATE-2           PIC X(6)  VALUE SPACES.
           05  DE-COMMAND-LINE-2       PIC X(79) VALUE SPACES.
           05  DE-MESSAGE-LINE-2       PIC X(79) VALUE SPACES.

       01  DISPLAY-STATUS              PIC XX.
012900
026700 01  DSET-NAMES.
026800     05  DSET-NAME               PIC X(16)  VALUE SPACES.
           05  DSET-DEDILOG            PIC X(16)  VALUE "DEDILOG;".
           05  DSET-MPLTINFO           PIC X(16)  VALUE "MPLTINFO;".
027200
014700 01  EDI-BATCH-TABLE.
014800     05  EDI-BATCH-DETAIL-LINE OCCURS 16 TIMES.
014900         10  EDI-ITEM-INFO.
                   15  FILLER          PIC X.
015000             15  EDI-KEY         PIC X(10).
015100             15  FILLER          PIC X(3).
015200             15  EDI-INIT-DATE   PIC X(6).
015300             15  FILLER          PIC X(3).
015600             15  EDI-SEND-DATE   PIC X(6).
015700             15  FILLER          PIC X(3).
016200             15  EDI-FLAGS       PIC X(6).
016300             15  FILLER          PIC X(3).
016400             15  EDI-VENDOR      PIC X(10).
016500             15  FILLER          PIC X(3).
016600             15  EDI-BATCHNO     PIC X(8).
016700             15  FILLER          PIC X(3).
016800             15  EDI-ITEM-NO     PIC X(4).
016900             15  FILLER          PIC X(10).
017400
       01  FILE-STATUS.
           05  FILE-STATUS-1           PIC X  VALUE "0".
           05  FILE-STATUS-2           PIC X  VALUE "0".
012900
       COPY FUNCTDEF   IN COPYLIB.

       COPY IOFEEDBACK IN COPYLIB.
021200
027500 01 ITEMS-LISTING.
027600     05  ALL-ITEMS               PIC XX    VALUE "@;".
027700     05  CODE-SEARCH             PIC X(10) VALUE "CORP-CODE;".
027800     05  PO-SEARCH               PIC X(10) VALUE "PO-RCV-NO;".
027900     05  REQ-SEARCH              PIC X(12) VALUE "REQ-NUMBER;".
028000
032600 COPY LANGUAGE IN COPYLIB.
032700
       01  MESSAGE-BUFFER              PIC X(80).

018700 01  MESSAGE-BUFFER-1.
018800     05  MSG-TEXT                PIC X(64)    VALUE SPACE.
018900     05  MSG-FLD                 PIC X(12)    VALUE SPACE.
019000     05  MSG-FLD-9  REDEFINES  MSG-FLD      PIC Z(11)9.
019100
       COPY MPLTINFO IN COPYLIB.

024100 01  NO-ENTRIES-QUALIFIED-MSG.
024200     05  FILLER                  PIC X(34).
024300     05  NO-ENTRIES-REQ-NUM      PIC X(7)  VALUE SPACES.
024400     05  FILLER                  PIC X(12).
026000
       01  PO-CHECK-KEY.
           05  FILLER                   PIC X        VALUE "P".
           05  POREL-CHECK              PIC X(10)    VALUE SPACES.
           05  FILLER                   PIC X(3)     VALUE "000".

       COPY SEDIVNCK IN COPYLIB.
032800
013000 01  SWITCH-AREA.
013100     05  FATAL-ERR-SW            PIC X       VALUE "N".
013200     05  F6-VALID-SW             PIC X       VALUE "N".
013300         88  F6-VALID                        VALUE "Y".
013400     05  F7-VALID-SW             PIC X       VALUE "N".
013500         88  F7-VALID                        VALUE "Y".
013600     05  EOF-SW                  PIC X       VALUE "N".
013700     05  ERR-SW                  PIC X       VALUE "N".
013900
032300 COPY TBLOWUP IN COPYLIB.
032500
032000 COPY TDATECHK IN COPYLIB.
032200
011200 COPY TSHWRDFM IN COPYLIB.
011300***** NOTE THAT "TSCRPRT2" ALSO USES PASSED-SPOOL-PRT, *****
011400***** AND VIEW-COMAREA AS PARAMETERS IN ADDITION TO    *****
011500***** THOSE LISTED BELOW.                              *****
011600
011700 01  TSCRPRT2-PARAMETERS.
011800     05  TSCRPRT2-PRINTCNTL      PIC S9(4) COMP VALUE 0.
011900     05  TSCRPRT2-PAGECNTL       PIC S9(4) COMP VALUE 49.
012000     05  TSCRPRT2-SPOOLSW        PIC X(1)  VALUE "N".
012100
012200 01  TSCRPRT2-ERROR-SW           PIC X(1)  VALUE "N".
012300
012400 01  TSCRPRT2-DISPLAY-AREA.
012500     05     FILLER               PIC X(2).
012600     05  TSCRPRT2-MSG            PIC X(27).
012700     05     FILLER               PIC X(2).
012800     05  TSCRPRT2-STAT           PIC S9(4).
012900     05     FILLER               PIC X(2).
013000     05  TSCRPRT2-FLD            PIC X(14).
013100     05     FILLER               PIC X(2).
013200
017500 COPY VCOMAREA IN COPYLIB.
018600
       COPY WSCONTROL IN COPYLIB.

032900 PROCEDURE DIVISION.
033300 BEGIN-HERE.
033400     PERFORM 1-HSK.
033600     PERFORM 6-MAIN THRU 6-M-X UNTIL VIEW-LASTKEY = 3.

       2-EOJ.
           CLOSE DEDILOG-LK-O, DISPLAY-FILE, MPLTINFO-PK-I.
034000     GOBACK.

043900 2100-BLOWUP.
044200     MOVE "TEDIMAIN"              TO  BU-PGM-NAME.
044300     CALL "TBLOWUP" USING BASE, BU-PGM-NAME, STATUS-AREA,
044400         VIEW-COMAREA, FILE-STATUS, BU-DISPLAY-MSG,
044500                 BU-DISPLAY-FLDS.
034100
034200 1-HSK.
           OPEN I-O   DEDILOG-LK-O.
           OPEN I-O   DISPLAY-FILE.
           OPEN INPUT MPLTINFO-PK-I.
038800**************************************************
038900*                                                *
039000*   GET CO. AND PRIME FROM MPLTINFO              *
039100*   USING 'P 01' AS THE ARGUMENT                 *
039200*                                                *
039300**************************************************
039500     MOVE "P 01"  TO  PLT-ARG.
           PERFORM 9999-GETKEY-MPLTINFO-PK-I.
           IF FILE-STATUS NOT = "00"
039900         MOVE "DBGET MPLTINFO 1-HSK P 01"  TO  BU-DISPLAY-MSG
040000         MOVE PLT-ARG                 TO  BU-DISPLAY-FLD (1)
040100         GO TO 2100-BLOWUP.
040200     MOVE MPLTINFO-COMPANY            TO  COMP-SCREEN-INDIC.
           ACCEPT CUR-DATE FROM DATE.
052500**************************************************
052600*                                                *
052700*     6 - M A I N                                *
052800*                                                *
052900**************************************************
053100 6-MAIN.
           MOVE 0 TO SUB.
           MOVE "FEDIFUNC" TO VIEW-NFNAME.
           MOVE SPACES TO DE-COMMAND-LINE-0 DE-MESSAGE-LINE-0.
           MOVE DE-FIELDS-0 TO DISPLAY-REC.
           PERFORM 998-WRITE-SCREEN THRU 998-READ-SCREEN.
           IF VIEW-LASTKEY = 1
               CLOSE DEDILOG-LK-O
               OPEN I-O DEDILOG-LK-O
               PERFORM 61-DISPLAY-BY-PARM THRU 61-DBP-X
               MOVE 0 TO VIEW-LASTKEY
           ELSE
           IF VIEW-LASTKEY = 2
               CLOSE DEDILOG-LK-O
               OPEN I-O DEDILOG-LK-O
               PERFORM 62-PROCESS-DELETE THRU 62-PD-X
               MOVE 0 TO VIEW-LASTKEY.

       6-M-X.    EXIT.

       61-DISPLAY-BY-PARM.
           MOVE "FEDIMAI1" TO VIEW-NFNAME.
           MOVE SPACES TO DE-FIELDS-2.
           MOVE 06027 TO CATREAD-MSG-NUMBER.
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
           MOVE MESSAGE-BUFFER-1 TO DE-COMMAND-LINE-2.
           MOVE DE-FIELDS-2 TO DISPLAY-REC.
           PERFORM 998-WRITE-SCREEN THRU 998-READ-SCREEN.
           MOVE DISPLAY-REC TO DE-FIELDS-2.
           IF VIEW-LASTKEY = 3
               MOVE 0 TO VIEW-LASTKEY
               GO TO 61-DBP-X.
           IF DE-BATCH-NO-2 NOT = SPACES
               MOVE SPACES TO EDI-BATCH-TABLE
               PERFORM 9999-BEGFIL-DEDILOG-LK-O
               PERFORM 610-DISPLAY-BY-BATCH THRU 610-DBB-X
           ELSE
           IF DE-PO-NO-7-2 NOT = SPACES
               MOVE SPACES TO EDI-BATCH-TABLE
               PERFORM 9999-BEGFIL-DEDILOG-LK-O
               PERFORM 611-DISPLAY-BY-PO THRU 611-DBP-X
           ELSE
           IF DE-INITDATE-2 NOT = SPACES
               MOVE SPACES TO EDI-BATCH-TABLE
               PERFORM 9999-BEGFIL-DEDILOG-LK-O
               PERFORM 612-DISPLAY-BY-DATE THRU 612-DBD-X
           ELSE
           MOVE SPACES TO EDI-BATCH-TABLE
           PERFORM 9999-BEGFIL-DEDILOG-LK-O
           PERFORM 61-READ-EDILOG-SER THRU 61-RES-X.
       61-DBP-X.    EXIT.

       610-DISPLAY-BY-BATCH.
           PERFORM 9999-GETSER-DEDILOG-LK-O.
048500     IF END-OF-FILE
               MOVE "FEDIMAIN"      TO VIEW-NFNAME
               MOVE EDI-BATCH-TABLE TO DE-BATCH-ENTRIES-1
037100         MOVE  66 TO LANG-SETNUM
037200         MOVE 122 TO LANG-MSGNUM
037300         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
037400         MOVE MESSAGE-BUFFER-1 TO DE-MSG-LINE-1
               MOVE DE-FIELDS-1 TO DISPLAY-REC
               PERFORM 998-WRITE-SCREEN THRU 998-READ-SCREEN
               MOVE DISPLAY-REC TO DE-FIELDS-1
               GO TO 610-DBB-X.
           IF DE-BATCH-NO-2 = "99999999"
               NEXT SENTENCE
           ELSE
           IF LOG-BATCHNO-X = DE-BATCH-NO-2
               NEXT SENTENCE
           ELSE
           GO TO 610-DISPLAY-BY-BATCH.
           ADD 1 TO SUB.
           IF SUB = 16
      *        MOVE LOG-KEY         TO EDI-KEY (SUB)
               MOVE LOG-KEY         TO PO-CHECK-KEY
               MOVE POREL-CHECK     TO EDI-KEY (SUB)
               MOVE LOG-INIT-DATE   TO EDI-INIT-DATE (SUB)
               MOVE LOG-SEND-DATE   TO EDI-SEND-DATE (SUB)
               MOVE LOG-FLAGS       TO EDI-FLAGS (SUB)
               MOVE LOG-VENDOR      TO EDI-VENDOR (SUB)
               MOVE LOG-BATCHNO-X   TO EDI-BATCHNO (SUB)
               MOVE LOG-ITEM-NO-X   TO EDI-ITEM-NO (SUB)
               MOVE "FEDIMAIN"      TO VIEW-NFNAME
               MOVE EDI-BATCH-TABLE TO DE-BATCH-ENTRIES-1
               MOVE SPACES          TO EDI-BATCH-TABLE
037100         MOVE  66 TO LANG-SETNUM
037200         MOVE 173 TO LANG-MSGNUM
037300         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
037400         MOVE MESSAGE-BUFFER-1 TO DE-MSG-LINE-1
               MOVE SPACES TO DE-COMMAND-LINE-1 SRF-SAVE-COMMAND-LINE
               MOVE DE-FIELDS-1 TO DISPLAY-REC
               PERFORM 998-WRITE-SCREEN THRU 998-READ-SCREEN
               MOVE DISPLAY-REC TO DE-FIELDS-1
               IF VIEW-LASTKEY = 3
                   MOVE 0 TO VIEW-LASTKEY
                   GO TO 610-DBB-X
               ELSE
               MOVE 1               TO SUB.
      *    MOVE LOG-KEY             TO EDI-KEY (SUB).
           MOVE LOG-KEY             TO PO-CHECK-KEY.
           MOVE POREL-CHECK         TO EDI-KEY (SUB).
           MOVE LOG-INIT-DATE       TO EDI-INIT-DATE (SUB).
           MOVE LOG-SEND-DATE       TO EDI-SEND-DATE (SUB).
           MOVE LOG-FLAGS           TO EDI-FLAGS (SUB).
           MOVE LOG-VENDOR          TO EDI-VENDOR (SUB).
           MOVE LOG-BATCHNO-X       TO EDI-BATCHNO (SUB).
           MOVE LOG-ITEM-NO-X       TO EDI-ITEM-NO (SUB).
           GO TO 610-DISPLAY-BY-BATCH.
       610-DBB-X.    EXIT.

       611-DISPLAY-BY-PO.
           MOVE DE-PO-NO-7-2    TO PO-NUM.
           MOVE DE-PO-NO-RLSE-2 TO PO-RLSE.
           IF PO-RLSE = "   " MOVE "000" TO PO-RLSE.
           MOVE BUILD-PO-NUM    TO PO-ARG.
           PERFORM 9999-CHAINHD-DEDILOG-LK-O.
       611-DBP-LOOP.
           PERFORM 9999-GETNEXT-DEDILOG-LK-O.
048500     IF END-OF-CHAIN
               MOVE "FEDIMAIN"      TO VIEW-NFNAME
               MOVE EDI-BATCH-TABLE TO DE-BATCH-ENTRIES-1
037100         MOVE  66 TO LANG-SETNUM
037200         MOVE 122 TO LANG-MSGNUM
037300         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
037400         MOVE MESSAGE-BUFFER-1 TO DE-MSG-LINE-1
               MOVE DE-FIELDS-1 TO DISPLAY-REC
               PERFORM 998-WRITE-SCREEN THRU 998-READ-SCREEN
               MOVE DISPLAY-REC TO DE-FIELDS-1
               GO TO 611-DBP-X.
           ADD 1 TO SUB.
           IF SUB = 16
      *        MOVE LOG-KEY         TO EDI-KEY (SUB)
               MOVE LOG-KEY         TO PO-CHECK-KEY
               MOVE POREL-CHECK     TO EDI-KEY (SUB)
               MOVE LOG-INIT-DATE   TO EDI-INIT-DATE (SUB)
               MOVE LOG-SEND-DATE   TO EDI-SEND-DATE (SUB)
               MOVE LOG-FLAGS       TO EDI-FLAGS (SUB)
               MOVE LOG-VENDOR      TO EDI-VENDOR (SUB)
               MOVE LOG-BATCHNO-X   TO EDI-BATCHNO (SUB)
               MOVE LOG-ITEM-NO-X   TO EDI-ITEM-NO (SUB)
               MOVE "FEDIMAIN"      TO VIEW-NFNAME
               MOVE EDI-BATCH-TABLE TO DE-BATCH-ENTRIES-1
               MOVE SPACES          TO EDI-BATCH-TABLE
037100         MOVE  66 TO LANG-SETNUM
037200         MOVE 173 TO LANG-MSGNUM
037300         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
037400         MOVE MESSAGE-BUFFER-1 TO DE-MSG-LINE-1
               MOVE SPACES TO DE-COMMAND-LINE-1 SRF-SAVE-COMMAND-LINE
               MOVE DE-FIELDS-1 TO DISPLAY-REC
               PERFORM 998-WRITE-SCREEN THRU 998-READ-SCREEN
               MOVE DISPLAY-REC TO DE-FIELDS-1
               IF VIEW-LASTKEY = 3
                   MOVE 0 TO VIEW-LASTKEY
                   GO TO 611-DBP-X
               ELSE
               MOVE 1               TO SUB.
           MOVE LOG-KEY             TO PO-CHECK-KEY.
           MOVE POREL-CHECK         TO EDI-KEY (SUB).
           MOVE LOG-INIT-DATE       TO EDI-INIT-DATE (SUB).
           MOVE LOG-SEND-DATE       TO EDI-SEND-DATE (SUB).
           MOVE LOG-FLAGS           TO EDI-FLAGS (SUB).
           MOVE LOG-VENDOR          TO EDI-VENDOR (SUB).
           MOVE LOG-BATCHNO-X       TO EDI-BATCHNO (SUB).
           MOVE LOG-ITEM-NO-X       TO EDI-ITEM-NO (SUB).
           GO TO 611-DBP-LOOP.
       611-DBP-X.    EXIT.

       612-DISPLAY-BY-DATE.
           PERFORM 9999-GETSER-DEDILOG-LK-O.
048500     IF END-OF-FILE
               MOVE "FEDIMAIN"      TO VIEW-NFNAME
               MOVE EDI-BATCH-TABLE TO DE-BATCH-ENTRIES-1
037100         MOVE  66 TO LANG-SETNUM
037200         MOVE 122 TO LANG-MSGNUM
037300         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
037400         MOVE MESSAGE-BUFFER-1 TO DE-MSG-LINE-1
               MOVE DE-FIELDS-1 TO DISPLAY-REC
               PERFORM 998-WRITE-SCREEN THRU 998-READ-SCREEN
               MOVE DISPLAY-REC TO DE-FIELDS-1
               GO TO 612-DBD-X.
           IF LOG-INIT-DATE = DE-INITDATE-2
               NEXT SENTENCE
           ELSE
           GO TO 612-DISPLAY-BY-DATE.
           ADD 1 TO SUB.
           IF SUB = 16
      *        MOVE LOG-KEY         TO EDI-KEY (SUB)
               MOVE LOG-KEY         TO PO-CHECK-KEY
               MOVE POREL-CHECK     TO EDI-KEY (SUB)
               MOVE LOG-INIT-DATE   TO EDI-INIT-DATE (SUB)
               MOVE LOG-SEND-DATE   TO EDI-SEND-DATE (SUB)
               MOVE LOG-FLAGS       TO EDI-FLAGS (SUB)
               MOVE LOG-VENDOR      TO EDI-VENDOR (SUB)
               MOVE LOG-BATCHNO-X   TO EDI-BATCHNO (SUB)
               MOVE LOG-ITEM-NO-X   TO EDI-ITEM-NO (SUB)
               MOVE "FEDIMAIN"      TO VIEW-NFNAME
               MOVE EDI-BATCH-TABLE TO DE-BATCH-ENTRIES-1
               MOVE SPACES          TO EDI-BATCH-TABLE
037100         MOVE  66 TO LANG-SETNUM
037200         MOVE 173 TO LANG-MSGNUM
037300         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
037400         MOVE MESSAGE-BUFFER-1 TO DE-MSG-LINE-1
               MOVE SPACES TO DE-COMMAND-LINE-1 SRF-SAVE-COMMAND-LINE
               MOVE DE-FIELDS-1 TO DISPLAY-REC
               PERFORM 998-WRITE-SCREEN THRU 998-READ-SCREEN
               MOVE DISPLAY-REC TO DE-FIELDS-1
               IF VIEW-LASTKEY = 3
                   MOVE 0 TO VIEW-LASTKEY
                   GO TO 612-DBD-X
               ELSE
               MOVE 1               TO SUB.
      *    MOVE LOG-KEY             TO EDI-KEY (SUB).
           MOVE LOG-KEY             TO PO-CHECK-KEY.
           MOVE POREL-CHECK         TO EDI-KEY (SUB).
           MOVE LOG-INIT-DATE       TO EDI-INIT-DATE (SUB).
           MOVE LOG-SEND-DATE       TO EDI-SEND-DATE (SUB).
           MOVE LOG-FLAGS           TO EDI-FLAGS (SUB).
           MOVE LOG-VENDOR          TO EDI-VENDOR (SUB).
           MOVE LOG-BATCHNO-X       TO EDI-BATCHNO (SUB).
           MOVE LOG-ITEM-NO-X       TO EDI-ITEM-NO (SUB).
           GO TO 612-DISPLAY-BY-DATE.
       612-DBD-X.    EXIT.

       61-READ-EDILOG-SER.
           PERFORM 9999-GETSER-DEDILOG-LK-O.
048500     IF END-OF-FILE
               MOVE "FEDIMAIN"      TO VIEW-NFNAME
               MOVE EDI-BATCH-TABLE TO DE-BATCH-ENTRIES-1
037100         MOVE  66 TO LANG-SETNUM
037200         MOVE 122 TO LANG-MSGNUM
037300         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
037400         MOVE MESSAGE-BUFFER-1 TO DE-MSG-LINE-1
               MOVE DE-FIELDS-1 TO DISPLAY-REC
               PERFORM 998-WRITE-SCREEN THRU 998-READ-SCREEN
               MOVE DISPLAY-REC TO DE-FIELDS-1
               GO TO 61-RES-X.
           ADD 1 TO SUB.
           IF SUB = 16
      *        MOVE LOG-KEY         TO EDI-KEY (SUB)
               MOVE LOG-KEY         TO PO-CHECK-KEY
               MOVE POREL-CHECK     TO EDI-KEY (SUB)
               MOVE LOG-INIT-DATE   TO EDI-INIT-DATE (SUB)
               MOVE LOG-SEND-DATE   TO EDI-SEND-DATE (SUB)
               MOVE LOG-FLAGS       TO EDI-FLAGS (SUB)
               MOVE LOG-VENDOR      TO EDI-VENDOR (SUB)
               MOVE LOG-BATCHNO-X   TO EDI-BATCHNO (SUB)
               MOVE LOG-ITEM-NO-X   TO EDI-ITEM-NO (SUB)
               MOVE "FEDIMAIN"      TO VIEW-NFNAME
               MOVE EDI-BATCH-TABLE TO DE-BATCH-ENTRIES-1
               MOVE SPACES          TO EDI-BATCH-TABLE
037100         MOVE  66 TO LANG-SETNUM
037200         MOVE 173 TO LANG-MSGNUM
037300         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
037400         MOVE MESSAGE-BUFFER-1 TO DE-MSG-LINE-1
               MOVE SPACES TO DE-COMMAND-LINE-1 SRF-SAVE-COMMAND-LINE
               MOVE DE-FIELDS-1 TO DISPLAY-REC
               PERFORM 998-WRITE-SCREEN THRU 998-READ-SCREEN
               MOVE DISPLAY-REC TO DE-FIELDS-1
               IF VIEW-LASTKEY = 3
                   MOVE 0 TO VIEW-LASTKEY
                   GO TO 61-RES-X
               ELSE
               MOVE 1               TO SUB.
      *    MOVE LOG-KEY             TO EDI-KEY (SUB).
           MOVE LOG-KEY             TO PO-CHECK-KEY.
           MOVE POREL-CHECK         TO EDI-KEY (SUB).
           MOVE LOG-INIT-DATE       TO EDI-INIT-DATE (SUB).
           MOVE LOG-SEND-DATE       TO EDI-SEND-DATE (SUB).
           MOVE LOG-FLAGS           TO EDI-FLAGS (SUB).
           MOVE LOG-VENDOR          TO EDI-VENDOR (SUB).
           MOVE LOG-BATCHNO-X       TO EDI-BATCHNO (SUB).
           MOVE LOG-ITEM-NO-X       TO EDI-ITEM-NO (SUB).
           GO TO 61-READ-EDILOG-SER.

       61-RES-X.    EXIT.

       62-PROCESS-DELETE.
           MOVE 0 TO DELETE-CTR.
           MOVE "FEDIMAI2" TO VIEW-NFNAME.
           MOVE SPACES TO DE-FIELDS-2.
           MOVE 06027 TO CATREAD-MSG-NUMBER.
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
           MOVE MESSAGE-BUFFER-1 TO DE-COMMAND-LINE-2.
           MOVE DE-FIELDS-2 TO DISPLAY-REC.
           PERFORM 998-WRITE-SCREEN THRU 998-READ-SCREEN.
           MOVE DISPLAY-REC TO DE-FIELDS-2.
           IF VIEW-LASTKEY = 3
               MOVE 0 TO VIEW-LASTKEY
               GO TO 62-PD-X.
           IF DE-BATCH-NO-2 NOT = SPACES
               PERFORM 620-DELETE-BY-BATCH THRU 620-DBB-X
           ELSE
           IF DE-PO-NO-7-2 NOT = SPACES
               PERFORM 621-DELETE-BY-PO THRU 621-DBP-X
               IF DEL-SW = "N"
                   NEXT SENTENCE
               ELSE
               MOVE B"1" TO IND (98)
               MOVE 16148 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE DE-PO-NO-2 TO MSG-FLD
               MOVE MESSAGE-BUFFER-1 TO DE-COMMAND-LINE-2
               MOVE DE-FIELDS-2 TO DISPLAY-REC
               PERFORM 998-WRITE-SCREEN
               PERFORM 998-AUTO-READ-SCREEN
               CALL "CLPAUSE2"
               MOVE SPACES TO PO-ARG
           ELSE
           IF DE-INITDATE-2 NOT = SPACES
               PERFORM 622-DELETE-BY-DATE THRU 622-DBD-X
           ELSE
           MOVE 25030 TO CATREAD-MSG-NUMBER
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
           MOVE MESSAGE-BUFFER-1 TO DE-MESSAGE-LINE-2
           MOVE B"1" TO IND (1) IND (99)
           GO TO 62-PROCESS-DELETE.
       62-PD-X.    EXIT.

       620-DELETE-BY-BATCH.
           PERFORM 9999-GETSER-DEDILOG-LK-O.
           IF END-OF-FILE
               MOVE B"1" TO IND (98)
               MOVE 20069 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE DELETE-CTR TO MSG-FLD-9
               MOVE MESSAGE-BUFFER-1 TO DE-COMMAND-LINE-2
               MOVE DE-FIELDS-2 TO DISPLAY-REC
               PERFORM 998-WRITE-SCREEN
               PERFORM 998-AUTO-READ-SCREEN
               CALL "CLPAUSE2"
               GO TO 620-DBB-X.
           IF DE-BATCH-NO-2 = LOG-BATCHNO-X
               DELETE DEDILOG-LK-O RECORD
               ADD 1 TO DELETE-CTR.
           GO TO 620-DELETE-BY-BATCH.
       620-DBB-X.    EXIT.

       621-DELETE-BY-PO.
           MOVE "N" TO DEL-SW.
           MOVE DE-PO-NO-7-2    TO PO-NUM.
           MOVE DE-PO-NO-RLSE-2 TO PO-RLSE.
           IF PO-RLSE = "   " MOVE "000" TO PO-RLSE.
           MOVE BUILD-PO-NUM    TO PO-ARG.
           PERFORM 9999-CHAINHD-DEDILOG-LK-O.
       621-DBP-LOOP.
           PERFORM 9999-GETNEXT-DEDILOG-LK-O.
           IF GOOD-CALL
               DELETE DEDILOG-LK-O RECORD
               MOVE "Y" TO DEL-SW
               GO TO 621-DBP-LOOP.
       621-DBP-X.    EXIT.

       622-DELETE-BY-DATE.
           PERFORM 9999-GETSER-DEDILOG-LK-O.
           IF END-OF-FILE
               MOVE B"1" TO IND (98)
               MOVE 20069 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE DELETE-CTR TO MSG-FLD-9
               MOVE MESSAGE-BUFFER-1 TO DE-COMMAND-LINE-2
               MOVE DE-FIELDS-2 TO DISPLAY-REC
               PERFORM 998-WRITE-SCREEN
               PERFORM 998-AUTO-READ-SCREEN
               CALL "CLPAUSE2"
               GO TO 622-DBD-X.
           IF DE-INITDATE-2 = LOG-INIT-DATE
               DELETE DEDILOG-LK-O RECORD
               ADD 1 TO DELETE-CTR.
           GO TO 622-DELETE-BY-DATE.
       622-DBD-X.    EXIT.

119100 999-CATREAD.
           IF CATREAD-MSG-NUMBER = ZEROS
               MOVE LANG-SETNUM TO CATREAD-MSG-SET
               MOVE LANG-MSGNUM TO CATREAD-MSG-NUM.
           CALL "CCATREAD" USING CATREAD-PARMS.
           MOVE CATREAD-MSG-TEXT TO MESSAGE-BUFFER-1.
120700 999-CATREAD-EXIT.    EXIT.

       9999-CHAINHD-DEDILOG-LK-O.
           MOVE 0 TO COND-WORD.
           MOVE PO-ARG TO EDILOGKEY OF DEDILOG-LK-REC-O.
           START DEDILOG-LK-O KEY = EDILOGKEY OF DEDILOG-LK-REC-O
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF (FILE-STATUS NOT = "00") AND (FILE-STATUS-1 NOT = "2")
               MOVE 99 TO COND-WORD
               IF HANDLE-BLOWUP-FLAG = "Y"
                   MOVE "CHAINHD ERR 9999-CHAINHD-DEDILOG-LK-O"
                       TO BU-MSG-AREA
                   PERFORM 2100-BLOWUP.

       COPY DISPCALL  IN COPYLIB.
       998-AUTO-READ-SCREEN.
           READ  DISPLAY-FILE TERMINAL IS TERMINAL-ID
               INDIC ARE SRF-INDICATORS
                   NO DATA MOVE DISPLAY-STATUS TO DISPLAY-STATUS.
           MOVE ALL B"0" TO SRF-INDICATORS.

       9999-GETKEY-MPLTINFO-PK-I.
           MOVE 0 TO COND-WORD.
           MOVE PLT-ARG TO PLTINFOKEY OF MPLTINFO-PK-REC-I.
           READ MPLTINFO-PK-I INTO BUF-MPLTINFO
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS = "23"
               MOVE 17 TO COND-WORD
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD
               IF HANDLE-BLOWUP-FLAG = "Y"
                   MOVE "GETKEY ERR 9999-GETKEY-MPLTINFO-PK-I"
                       TO BU-MSG-AREA
                   PERFORM 2100-BLOWUP.

       9999-GETNEXT-DEDILOG-LK-O.
           MOVE 0 TO COND-WORD.
           READ DEDILOG-LK-O NEXT INTO BUF-DEDILOG
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14"
                   PERFORM 9999-RESET-DEDILOG-LK-O
                   MOVE 15 TO COND-WORD
               ELSE
               IF FILE-STATUS = "46"
                   MOVE 15 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD
                   IF HANDLE-BLOWUP-FLAG = "Y"
                       MOVE "GETNEXT ERR 9999-GETNEXT-DEDILOG-LK-O"
                           TO BU-MSG-AREA
                       PERFORM 2100-BLOWUP
                   END-IF
           ELSE
           IF EDILOGKEY OF DEDILOG-LK-REC-O NOT = PO-ARG
               PERFORM 9999-RESET-DEDILOG-LK-O
               MOVE 15 TO COND-WORD.

       9999-RESET-DEDILOG-LK-O.
           MOVE HIGH-VALUES TO EDILOGKEY OF DEDILOG-LK-REC-O.
           START DEDILOG-LK-O KEY > EDILOGKEY OF DEDILOG-LK-REC-O
               INVALID KEY MOVE "00" TO FILE-STATUS.

       9999-GETSER-DEDILOG-LK-O.
           MOVE 0 TO COND-WORD.
           READ DEDILOG-LK-O NEXT INTO BUF-DEDILOG
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS-1 = "1"
               MOVE 11 TO COND-WORD
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD
               IF HANDLE-BLOWUP-FLAG = "Y"
                   MOVE "GETSER ERR 9999-GETSER-DEDILOG-LK-O"
                       TO BU-MSG-AREA
                   PERFORM 2100-BLOWUP.

       9999-BEGFIL-DEDILOG-LK-O.
           MOVE SPACES TO EDILOGKEY OF DEDILOG-LK-REC-O.
           START DEDILOG-LK-O KEY >= EDILOGKEY OF DEDILOG-LK-REC-O
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.

