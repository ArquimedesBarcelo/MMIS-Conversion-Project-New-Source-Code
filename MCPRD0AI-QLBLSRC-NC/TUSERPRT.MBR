006800************************************************************
       01  BASE                   PIC X(24).
       01  RELATIVE-RECNO         PIC 9(9).
       01  SUB                    PIC 9(2).
       01  LINE-SUB               PIC 9(2).
       01  EDIT-SW                PIC X(1).
       01  LAST-USER              PIC X(16).
       01  LAST-DSPST             PIC X(10).
       01  LAST-USER-DSPST        PIC X(10).
       01  LAST-DSPST-USER        PIC X(16).
       01  SELECTION              PIC X(1).
       01  CURR-LINE              PIC 9(2).
       01  FIRST-TIME-DSPST       PIC X(1)  VALUE "Y".

       01  USER-PAGE              PIC 9(03).
       01  START-DISPLAY-STATION-PAGES.
           05  START-DISPLAY-STATION OCCURS 100 TIMES PIC X(10).

       01  DSPST-PAGE              PIC 9(03).
       01  START-USER-PAGES.
           05  START-USER OCCURS 100 TIMES PIC X(16).

      *------ WS CONTROL AREA
       01  MAJOR-MINOR                 PIC XXXX.
       01  WS-CONTROL.
           02  FUNCTION-NUM            PIC XX.
                   88  EXIT-KEY-F8-USED                     VALUE "08". LVW000LS
                   88  REFRESH-KEY-F4-USED                  VALUE "04". LVW000LS
                   88  ENTER-KEY-USED                       VALUE "00". LVW000LS
                   88  F1-KEY-USED                          VALUE "01". LVW000LS
                   88  F2-KEY-USED                          VALUE "02". LVW000LS
                   88  F3-KEY-USED                          VALUE "03". LVW000LS
                   88  F4-KEY-USED                          VALUE "04". LVW000LS
                   88  F5-KEY-USED                          VALUE "05". LVW000LS
                   88  F6-KEY-USED                          VALUE "06". LVW000LS
                   88  F7-KEY-USED                          VALUE "07". LVW000LS
                   88  F8-KEY-USED                          VALUE "08". LVW000LS
           02 FUN-KEY REDEFINES FUNCTION-NUM PIC XX.
           02 TERMINAL-ID PIC X(10).
           02 FORMAT-NAME PIC X(10).

       01  DISPLAY-STATUS              PIC X(2).
       01  FILE-STATUS                 PIC X(2).

       01  SRF-INDICATORS.
           05  IND OCCURS 99 TIMES   PIC 1 INDICATOR 01.

       COPY IOFEEDBACK OF COPYLIB.
013000 01  MESSAGE-BUFFER            PIC X(76)    VALUE SPACES.
013100 01  MESSAGE-BUFFER-RD REDEFINES MESSAGE-BUFFER.
013200     05  MSG-BUFFER            PIC X(68).
013300     05  MSG-VALUE             PIC X(8).
013400 01  MESSAGE-BUFLEN            PIC S9(4)    VALUE 76    COMP-4.
013500 01  MESSAGE-ACTLEN            PIC S9(4)    VALUE 0     COMP-4.
013600 01  FIELD-NUMBER              PIC S9(4)    VALUE 1     COMP-4.
013700
013800*---------- VPRINTFORM
013900 01  SCREEN-PRINT-PARMS.
014000     05  PRINT-CTL             PIC S9(4)    VALUE 1     COMP-4.
014100     05  PAGE-CTL              PIC S9(4)    VALUE 49    COMP-4.
014200     05  SPOOL-FIL-OPEN-SW     PIC X        VALUE "Y".

       COPY PRINTERS IN COPYLIB.
014300
014400 COPY TBLOWUP IN COPYLIB.
015900 COPY DBSTAT   IN COPYLIB.
      *01  VIEW-COMAREA.
016200 COPY VCOMAREA IN COPYLIB.
       COPY CATREAD IN COPYLIB.
016300
       01  SCREEN-BUFFER                 PIC X(2000).
019500 01  FORM-NAMES.
019600     05  SELCT                 PIC X(7)     VALUE "SELECT".
           05  USER                  PIC X(7)     VALUE "USER".
           05  DSPST                 PIC X(7)     VALUE "DSPST".
019700
019800**********************************************************
019900*               S C R E E N   B U F F E R                *
020000**********************************************************
       01  SCREEN-USER.
           05  DE-USER              PIC X(16).
           05  DE-USER-DSPST-PRINTERS.
               10  DE-USER-LINE OCCURS 15 TIMES.
                   15  DE-USER-SEL  PIC X(1).
                   15  DE-USER-DSPST PIC X(10).
                   15  DE-USER-PRINTERS.
                       20  DE-USER-PRT1 PIC 9(04).
                       20  DE-USER-PRT2 PIC 9(04).
                       20  DE-USER-PRT3 PIC 9(04).
                       20  DE-USER-PRT4 PIC 9(04).
                       20  DE-USER-PRT5 PIC 9(04).
           05  DE-USER-INST         PIC X(65).
           05  DE-COMMAND-LINE1     PIC X(79).
           05  DE-MESSAGE-LINE1     PIC X(79).
       01  SCREEN-DSPST.
           05  DE-DSPST             PIC X(10).
           05  DE-DSPST-USER-PRINTERS.
               10  DE-DSPT-LINE OCCURS 15 TIMES.
                   15  DE-DSPST-SEL     PIC X(1).
                   15  DE-DSPST-USER    PIC X(16).
                   15  DE-DSPST-PRINTERS.
                       20  DE-DSPST-PRT1    PIC 9(04).
                       20  DE-DSPST-PRT2    PIC 9(04).
                       20  DE-DSPST-PRT3    PIC 9(04).
                       20  DE-DSPST-PRT4    PIC 9(04).
                       20  DE-DSPST-PRT5    PIC 9(04).
           05  DE-DSPST-INST        PIC X(65).
           05  DE-COMMAND-LINE2     PIC X(79).
           05  DE-MESSAGE-LINE2     PIC X(79).

021000**************************************************************
021100*                                                            *
021200*        P R O C E D U R E        D I V I S I O N            *
021300*                                                            *
021400**************************************************************
021500 PROCEDURE DIVISION.
021600 00-CONTROL SECTION 00.
021700 00-RCVEXEC-MAIN.
021800     PERFORM 100-OPEN-ALL THRU 109-EXIT.
021900
022000     PERFORM 130-INITIALIZATION THRU 139-EXIT.
022100
022200     PERFORM 6-DISPLAY-USER THRU 6-EXIT.
022300
022400     PERFORM 110-CLOSE-ALL THRU 119-EXIT.
022500
022600     GOBACK.
022700*************************************************************
022800*              O P E N   A L L   F I L E S                  *
022900*************************************************************
023000 100-OPEN-ALL.
           OPEN I-O DISPLAY-FILE
                    PRINTERS.
           OPEN INPUT PRT-USER
                      PRT-USER-TERM
                      PRT-TERM-USER
                      PRT-DSPST
                      PRINTERS-I.
030700 109-EXIT.  EXIT.
030800***********************************************************
030900*         CLOSE ALL FILES                                 *
031000***********************************************************
031100 110-CLOSE-ALL.
           CLOSE DISPLAY-FILE
                 PRINTERS
                 PRINTERS-I
                 PRT-USER
                 PRT-USER-TERM
                 PRT-TERM-USER
                 PRT-DSPST.
031600 119-EXIT.  EXIT.
031700
032200 130-INITIALIZATION.
           MOVE SPACES TO SCREEN-USER.
           PERFORM VARYING LINE-SUB FROM 1 BY 1
             UNTIL LINE-SUB > 15
               MOVE ZEROS TO DE-USER-PRINTERS (LINE-SUB)
           END-PERFORM.
           MOVE SPACES TO SCREEN-DSPST
           PERFORM VARYING LINE-SUB FROM 1 BY 1
             UNTIL LINE-SUB > 15
               MOVE ZEROS TO DE-DSPST-PRINTERS (LINE-SUB)
           END-PERFORM.
           PERFORM 65-RESET-USER-PAGES THRU 65-EXIT.
           PERFORM 75-RESET-DSPST-PAGES THRU 75-EXIT.
           MOVE USER TO VIEW-NFNAME.
           PERFORM 140-RESET-SRF THRU 140-EXIT.
037000 139-EXIT.  EXIT.

      *-----RESET INDICATORS FOR DISPLAY
      *-----  INDICATORS ARE 1 THROUGH 15
       140-RESET-SRF.
           MOVE SPACES TO EDIT-SW.
           MOVE ALL B"0" TO SRF-INDICATORS.
           PERFORM
             VARYING SUB FROM 1 BY 1
             UNTIL SUB > 15
               MOVE B"1" TO IND (SUB)
           END-PERFORM.
       140-EXIT.
           EXIT.

      *-----SET SELECTION INDICATORS IN DISPLAY
      *-----INDICATORS FOR SEL ARE 31 THRU 45
       141-SET-SEL.
           PERFORM
             VARYING SUB FROM 1 BY 1
             UNTIL SUB > 15
               IF VIEW-NFNAME = USER
                   IF DE-USER-DSPST (SUB) = SPACES OR
                      EDIT-SW NOT = SPACES
                       MOVE B"1" TO IND (SUB + 30)
                   ELSE
                       MOVE B"0" TO IND (SUB + 30)
                   END-IF
               ELSE
                   IF DE-DSPST-USER (SUB) = SPACES OR
                      EDIT-SW NOT = SPACES
                       MOVE B"1" TO IND (SUB + 30)
                   ELSE
                       MOVE B"0" TO IND (SUB + 30)
                   END-IF
               END-IF
           END-PERFORM.
           IF EDIT-SW NOT = SPACES
               MOVE B"0" TO IND (50)
           ELSE
               MOVE B"1" TO IND (50)
           END-IF.
       141-EXIT.
           EXIT.

      *-----SET INDICATORS FOR DELETION OF A USER OR TERMINAL
      *-----  INDICATORS ARE 60 THROUGH 75
       143-SET-ZAP-SRF.
           MOVE B"1" TO IND (60).
           PERFORM VARYING SUB FROM 1 BY 1
             UNTIL SUB > 15
               IF VIEW-NFNAME = USER
                   IF DE-USER-DSPST (SUB) NOT = SPACES
                       MOVE B"1" TO IND (SUB + 60)
                   ELSE
                       MOVE B"0" TO IND (SUB + 60)
                   END-IF
               ELSE
                   IF DE-DSPST-USER (SUB) NOT = SPACES
                       MOVE B"1" TO IND (SUB + 60)
                   ELSE
                       MOVE B"0" TO IND (SUB + 60)
                   END-IF
               END-IF
           END-PERFORM.
       143-EXIT.
           EXIT.

      *-----SET INDICATORS FOR DELETION OF A SCREEN RECORD
      *-----  INDICATORS IS ONE OF 61 THROUGH 75
       144-SET-DELETE-SRF.
           MOVE B"1" TO IND (CURR-LINE + 60).
       144-EXIT.
           EXIT.

       6-DISPLAY-USER.
           PERFORM 141-SET-SEL THRU 141-EXIT.
           MOVE DE-USER TO LAST-USER.
           MOVE SCREEN-USER TO DISPLAY-REC.
           WRITE DISPLAY-REC FORMAT IS VIEW-NFNAME
              INDIC ARE SRF-INDICATORS.

           READ  DISPLAY-FILE FORMAT IS VIEW-NFNAME
               INDIC ARE SRF-INDICATORS.
           ACCEPT IOFEEDBACK FROM I-O-FEEDBACK-AREA.
           MOVE B"0" TO IND (99).
           MOVE DISPLAY-REC TO SCREEN-USER
           MOVE SPACES TO DE-MESSAGE-LINE1.

      *------ A BAD STATUS MAY MEAN USER TURNED OFF TERMINAL.
      *------ IF SO, SIMULATE THE F3 KEY TO EXIT PROGRAM.
           IF DISPLAY-STATUS NOT = "00"
               MOVE 3 TO VIEW-LASTKEY
           ELSE
               MOVE FUNCTION-NUM TO VIEW-LASTKEY.

           IF VIEW-LASTKEY EQUAL 2
              MOVE 9 TO CATREAD-MSG-SET
              MOVE 10 TO CATREAD-MSG-NUM
              PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
              MOVE B"1" TO IND (99)
              MOVE MESSAGE-BUFFER TO DE-MESSAGE-LINE1
              GO TO 6-DISPLAY-USER.

      *-----EXIT PROGRAM
           IF VIEW-LASTKEY = 3
              GO TO 6-EXIT.

      *-----SWITCH TO DISPLAY BY DISPLAY STATION
           IF VIEW-LASTKEY = 1
              MOVE "Y" TO FIRST-TIME-DSPST
              MOVE SPACES TO EDIT-SW
              PERFORM 140-RESET-SRF THRU 140-EXIT
              PERFORM 7-DISPLAY-DSPST THRU 7-EXIT
              IF VIEW-LASTKEY = 3
                  GO TO 6-EXIT
              ELSE
                  MOVE USER TO VIEW-NFNAME
                  PERFORM 140-RESET-SRF THRU 140-EXIT
                  IF DE-USER NOT = SPACES
                      GO TO 6-RESET-USER
                  ELSE
                      GO TO 6-DISPLAY-USER.

      *------ RESET IF EDITING AND ENTER, F1, OR F3 IS NOT PRESSED
           IF EDIT-SW NOT = SPACES AND VIEW-LASTKEY NOT = 0
               IF VIEW-LASTKEY NOT = 5 OR EDIT-SW NOT = "Z"
                   MOVE SPACES TO EDIT-SW
                   PERFORM 140-RESET-SRF THRU 140-EXIT
                   GO TO 6-RESET-USER
               END-IF
           END-IF.

      *-----ADD DISPLAY STATION AND PRINTERS FOR USER
           IF VIEW-LASTKEY = 4
               IF DE-USER NOT = SPACES
                   MOVE DE-USER TO LAST-USER
                   MOVE "I" TO DE-USER-SEL (1)
               ELSE
                   MOVE "USER MUST BE ENTERED FOR ADD"
                     TO DE-MESSAGE-LINE1
                   MOVE B"1" TO IND (99)
                   GO TO 6-DISPLAY-USER.

      *-----DELETE USER AND ITS DISPLAY STATIONS
           IF VIEW-LASTKEY = 5
             IF DE-USER NOT = SPACES
               IF EDIT-SW NOT = "Z"
                  MOVE "Z" TO EDIT-SW
                  PERFORM 143-SET-ZAP-SRF THRU 143-EXIT
      *------------PRESS F5 AGAIN TO CONFIRM DELETE, F8 TO CANCEL
                  MOVE 16 TO CATREAD-MSG-SET
                  MOVE 158 TO CATREAD-MSG-NUM
                  PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                  MOVE MESSAGE-BUFFER TO DE-USER-INST
                  GO TO 6-DISPLAY-USER
               ELSE
                  MOVE SPACES TO EDIT-SW
                  PERFORM 64-ZAP-USER THRU 64-EXIT
                  MOVE SPACES TO SCREEN-USER
                  PERFORM VARYING LINE-SUB FROM 1 BY 1
                   UNTIL LINE-SUB > 15
                     MOVE ZEROS TO DE-USER-PRINTERS (LINE-SUB)
                  END-PERFORM
                  PERFORM 140-RESET-SRF THRU 140-EXIT
                  GO TO 6-DISPLAY-USER
             ELSE
                  MOVE "USER MUST BE ENTERED TO DELETE"
                    TO DE-MESSAGE-LINE1
                    MOVE B"1" TO IND (99)
                    GO TO 6-DISPLAY-USER.

      *-----PAGE BACKWARD
           IF VIEW-LASTKEY = 6
               IF USER-PAGE NOT = 1
                   SUBTRACT 1 FROM USER-PAGE
               END-IF
               GO TO 6-RESET-USER.

      *-----PAGE FORWARD
           IF VIEW-LASTKEY = 7
               MOVE 0 TO SUB
               PERFORM 61-FILL-USER-SCREEN THRU 61-EXIT
               IF DE-MESSAGE-LINE1 = SPACES
                 ADD 1 TO USER-PAGE
                 MOVE DE-USER-DSPST (1)
                    TO START-DISPLAY-STATION (USER-PAGE)
               END-IF
               GO TO 6-DISPLAY-USER.

      *-----REFRESH SCREEN OR CANCEL EDIT
           IF VIEW-LASTKEY = 8
               MOVE SPACES TO EDIT-SW
               PERFORM 140-RESET-SRF THRU 140-EXIT
               GO TO 6-RESET-USER.

           IF DE-USER = SPACES
               GO TO 6-DISPLAY-USER.

           IF DE-USER = LAST-USER
      *-----PERFORM EDITS ON USER
               IF EDIT-SW NOT = SPACES
                   MOVE SPACES TO DE-USER-INST DE-MESSAGE-LINE1
                   PERFORM 63-PROCESS-EDITS THRU 63-EXIT
                   IF DE-USER-INST NOT = SPACES OR
                      DE-MESSAGE-LINE1 NOT = SPACES
                       GO TO 6-DISPLAY-USER
                   END-IF
               ELSE
                   MOVE 0 TO CURR-LINE
                   PERFORM 62-REVIEW-EDITS THRU 62-EXIT
                   IF EDIT-SW NOT = "I"
                       GO TO 6-DISPLAY-USER
                   END-IF
               END-IF
           ELSE
      *-----CHANGE USER
               PERFORM 65-RESET-USER-PAGES THRU 65-EXIT
           END-IF.

       6-RESET-USER.
           MOVE DE-USER TO KPRTUSER OF PRT-USER.
           READ PRT-USER
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "23"
                   MOVE SPACES TO DE-USER-DSPST-PRINTERS
                   PERFORM VARYING LINE-SUB FROM 1 BY 1
                     UNTIL LINE-SUB > 15
                       MOVE ZEROS TO DE-USER-PRINTERS (LINE-SUB)
                   END-PERFORM
                   IF EDIT-SW = SPACES
      *------------USER NOT FOUND, PRESS F4 TO ADD USER
                       MOVE 21 TO CATREAD-MSG-SET
                       MOVE 26 TO CATREAD-MSG-NUM
                       PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                       MOVE MESSAGE-BUFFER TO DE-USER-INST
                   END-IF
                   GO TO 6-DISPLAY-USER
               ELSE
                   MOVE "READ ERR PRT-USER" TO BU-DISPLAY-MSG
                   MOVE DE-USER TO BU-DISPLAY-FLD (1)
                   PERFORM 990-BLOWUP THRU 999-EXIT.

           MOVE SPACES TO DE-USER-DSPST-PRINTERS.
           PERFORM VARYING LINE-SUB FROM 1 BY 1
             UNTIL LINE-SUB > 15
               MOVE ZEROS TO DE-USER-PRINTERS (LINE-SUB)
           END-PERFORM.
           MOVE 0 TO SUB.
           MOVE DE-USER TO KPRTUSER OF PRT-USER-TERM.
           MOVE START-DISPLAY-STATION (USER-PAGE)
               TO KPRTTERM OF PRT-USER-TERM.
           START PRT-USER-TERM KEY NOT < EXTERNALLY-DESCRIBED-KEY
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           PERFORM 61-FILL-USER-SCREEN THRU 61-EXIT.

           IF EDIT-SW = SPACES
      *-----EDIT CODES: M=MODIFY, I=INSERT, D=DELETE
               MOVE  5 TO CATREAD-MSG-SET
               MOVE 74 TO CATREAD-MSG-NUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER TO DE-USER-INST
           END-IF.

           GO TO 6-DISPLAY-USER.

       6-EXIT.
           EXIT.

       61-FILL-USER-SCREEN.
           READ PRT-USER-TERM NEXT INTO BUF-PRINTERS
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   IF SUB = 0
                     MOVE "NO MORE RECORDS TO DISPLAY"
                       TO DE-MESSAGE-LINE1
                     MOVE B"1" TO IND (99)
                   END-IF
                   GO TO 61-EXIT
               ELSE
                   MOVE "READ NEXT ERROR PRT-USER" TO BU-DISPLAY-MSG
                   MOVE DE-USER TO BU-DISPLAY-FLD (1)
                   PERFORM 990-BLOWUP THRU 999-EXIT.
           IF PRNT-USER NOT = DE-USER
               IF SUB = 0
                   MOVE "NO MORE RECORDS TO DISPLAY"
                     TO DE-MESSAGE-LINE1
                   MOVE B"1" TO IND (99)
               END-IF
               GO TO 61-EXIT.

           ADD 1 TO SUB.
           IF SUB = 1
               MOVE SPACES TO DE-USER-DSPST-PRINTERS
               PERFORM VARYING LINE-SUB FROM 1 BY 1
                 UNTIL LINE-SUB > 15
                   MOVE ZEROS TO DE-USER-PRINTERS (LINE-SUB)
               END-PERFORM
           END-IF.
      *-----CREATE BLANK LINE FOR INSERT
           IF EDIT-SW = "I" AND CURR-LINE = SUB
               MOVE SPACES TO DE-USER-DSPST (SUB)
               MOVE ZEROS TO DE-USER-PRT1 (SUB)
               MOVE ZEROS TO DE-USER-PRT2 (SUB)
               MOVE ZEROS TO DE-USER-PRT3 (SUB)
               MOVE ZEROS TO DE-USER-PRT4 (SUB)
               MOVE ZEROS TO DE-USER-PRT5 (SUB)
               ADD 1 TO SUB
               IF SUB > 15
                   GO TO 61-EXIT.
           MOVE PRNT-DISPLAY-STATION TO DE-USER-DSPST (SUB).
           MOVE PRNT-PRINTER1 TO DE-USER-PRT1 (SUB).
           MOVE PRNT-PRINTER2 TO DE-USER-PRT2 (SUB).
           MOVE PRNT-PRINTER3 TO DE-USER-PRT3 (SUB).
           MOVE PRNT-PRINTER4 TO DE-USER-PRT4 (SUB).
           MOVE PRNT-PRINTER5 TO DE-USER-PRT5 (SUB).
           IF SUB NOT = 15
               GO TO 61-FILL-USER-SCREEN.
       61-EXIT.
           EXIT.

       62-REVIEW-EDITS.
           ADD 1 TO CURR-LINE.
           IF CURR-LINE > 15
               GO TO 62-EXIT.
           IF VIEW-NFNAME = USER
               MOVE DE-USER-SEL (CURR-LINE) TO SELECTION
               MOVE DE-USER-DSPST (CURR-LINE) TO LAST-USER-DSPST
           ELSE
               MOVE DE-DSPST-SEL (CURR-LINE) TO SELECTION
               MOVE DE-DSPST-USER (CURR-LINE) TO LAST-DSPST-USER.
           IF SELECTION = SPACES
               GO TO 62-REVIEW-EDITS.
           IF SELECTION = "M" OR "I" OR "D"
               MOVE B"0" TO IND (CURR-LINE)
               MOVE B"1" TO IND (CURR-LINE + 15)
               MOVE SELECTION TO EDIT-SW
           ELSE
               GO TO 62-REVIEW-EDITS.
           IF SELECTION = "D"
      *-----PRESS ENTER TO CONFIRM DELETE OR F8 TO CANCEL
             MOVE 16 TO CATREAD-MSG-SET
             MOVE 160 TO CATREAD-MSG-NUM
             PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
             IF VIEW-NFNAME = USER
                 MOVE MESSAGE-BUFFER TO DE-USER-INST
             ELSE
                 MOVE MESSAGE-BUFFER TO DE-DSPST-INST
             END-IF
             PERFORM 144-SET-DELETE-SRF THRU 144-EXIT
           ELSE
           IF SELECTION = "M"
      *-----PRESS ENTER TO MODIFY OR F8 TO CANCEL
             MOVE 16 TO CATREAD-MSG-SET
             MOVE 161 TO CATREAD-MSG-NUM
             PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
             IF VIEW-NFNAME = USER
                 MOVE MESSAGE-BUFFER TO DE-USER-INST
             ELSE
                 MOVE MESSAGE-BUFFER TO DE-DSPST-INST
             END-IF
           ELSE
           IF SELECTION = "I"
      *-----PRESS ENTER TO INSERT OR F8 TO CANCEL
             MOVE 16 TO CATREAD-MSG-SET
             MOVE 162 TO CATREAD-MSG-NUM
             PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
             IF VIEW-NFNAME = USER
                 MOVE MESSAGE-BUFFER TO DE-USER-INST
             ELSE
                 MOVE MESSAGE-BUFFER TO DE-DSPST-INST
             END-IF
           END-IF
           END-IF
           END-IF.
       62-EXIT.
           EXIT.

       63-PROCESS-EDITS.
           IF EDIT-SW = "M"
               IF VIEW-NFNAME = USER
                   PERFORM 631-MODIFY-USER THRU 631-EXIT
               ELSE
                   PERFORM 731-MODIFY-DSPST THRU 731-EXIT
               END-IF
           ELSE
           IF EDIT-SW = "I"
               IF VIEW-NFNAME = USER
                   PERFORM 632-INSERT-USER THRU 632-EXIT
               ELSE
                   PERFORM 732-INSERT-DSPST THRU 732-EXIT
               END-IF
           ELSE
           IF EDIT-SW = "D"
               IF VIEW-NFNAME = USER
                   PERFORM 633-DELETE-USER THRU 633-EXIT
               ELSE
                   PERFORM 733-DELETE-DSPST THRU 733-EXIT
               END-IF
           END-IF
           END-IF
           END-IF.
           IF VIEW-NFNAME = USER
               IF DE-USER-INST = SPACES AND
                  DE-MESSAGE-LINE1 = SPACES
                   PERFORM 140-RESET-SRF THRU 140-EXIT
               END-IF
           ELSE
               IF DE-DSPST-INST = SPACES AND
                  DE-MESSAGE-LINE2 = SPACES
                   PERFORM 140-RESET-SRF THRU 140-EXIT
               END-IF
           END-IF.
       63-EXIT.
           EXIT.

       631-MODIFY-USER.
           MOVE DE-USER TO KPRTUSER OF PRINTERS.
           MOVE LAST-USER-DSPST TO KPRTTERM OF PRINTERS.
           READ PRINTERS INTO BUF-PRINTERS
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE "631 READ PRINTERS ERROR" TO BU-DISPLAY-MSG
               MOVE DE-USER TO BU-DISPLAY-FLD (1)
               MOVE LAST-USER-DSPST TO BU-DISPLAY-FLD (2)
               PERFORM 990-BLOWUP THRU 999-EXIT.

      *----- IF DISPLAY STATION IS SPACES, MAKE IT "GENERIC"
           IF DE-USER-DSPST (CURR-LINE) = SPACES
               MOVE "GENERIC" TO DE-USER-DSPST (CURR-LINE)
           END-IF.
      *----- EDIT PRINTER NUMBERS
           IF DE-USER-PRT1 (CURR-LINE) = SPACES
               MOVE ZEROS TO DE-USER-PRT1 (CURR-LINE).
           IF DE-USER-PRT1 (CURR-LINE) NOT NUMERIC
               MOVE "PRINTER MUST BE NUMERIC" TO DE-MESSAGE-LINE1
               MOVE B"1" TO IND (99)
               GO TO 631-EXIT.
           IF DE-USER-PRT2 (CURR-LINE) = SPACES
               MOVE ZEROS TO DE-USER-PRT2 (CURR-LINE).
           IF DE-USER-PRT2 (CURR-LINE) NOT NUMERIC
               MOVE "PRINTER MUST BE NUMERIC" TO DE-MESSAGE-LINE1
               MOVE B"1" TO IND (99)
               GO TO 631-EXIT.
           IF DE-USER-PRT3 (CURR-LINE) = SPACES
               MOVE ZEROS TO DE-USER-PRT3 (CURR-LINE).
           IF DE-USER-PRT3 (CURR-LINE) NOT NUMERIC
               MOVE "PRINTER MUST BE NUMERIC" TO DE-MESSAGE-LINE1
               MOVE B"1" TO IND (99)
               GO TO 631-EXIT.
           IF DE-USER-PRT4 (CURR-LINE) = SPACES
               MOVE ZEROS TO DE-USER-PRT4 (CURR-LINE).
           IF DE-USER-PRT4 (CURR-LINE) NOT NUMERIC
               MOVE "PRINTER MUST BE NUMERIC" TO DE-MESSAGE-LINE1
               MOVE B"1" TO IND (99)
               GO TO 631-EXIT.
           IF DE-USER-PRT5 (CURR-LINE) = SPACES
               MOVE ZEROS TO DE-USER-PRT5 (CURR-LINE).
           IF DE-USER-PRT5 (CURR-LINE) NOT NUMERIC
               MOVE "PRINTER MUST BE NUMERIC" TO DE-MESSAGE-LINE1
               MOVE B"1" TO IND (99)
               GO TO 631-EXIT.

           MOVE DE-USER-DSPST (CURR-LINE) TO PRNT-DISPLAY-STATION.
           MOVE DE-USER-PRT1 (CURR-LINE) TO PRNT-PRINTER1.
           MOVE DE-USER-PRT2 (CURR-LINE) TO PRNT-PRINTER2.
           MOVE DE-USER-PRT3 (CURR-LINE) TO PRNT-PRINTER3.
           MOVE DE-USER-PRT4 (CURR-LINE) TO PRNT-PRINTER4.
           MOVE DE-USER-PRT5 (CURR-LINE) TO PRNT-PRINTER5.

           IF DE-USER-DSPST (CURR-LINE) = LAST-USER-DSPST
               REWRITE PRINTERS-REC FROM BUF-PRINTERS
                   INVALID KEY MOVE FILE-STATUS TO FILE-STATUS
               END-REWRITE
               IF FILE-STATUS NOT = "00"
                   MOVE "631 REWRITE PRINTERS ERROR" TO BU-DISPLAY-MSG
                   MOVE DE-USER TO BU-DISPLAY-FLD (1)
                   MOVE LAST-USER-DSPST TO BU-DISPLAY-FLD (2)
                   PERFORM 990-BLOWUP THRU 999-EXIT
               END-IF
           ELSE
               PERFORM 6311-NO-DUPS THRU 6311-EXIT
               IF FILE-STATUS = "00"
                 MOVE "DUPLICATE USER/DISPLAY STATION NOT PERMITTED"
                   TO DE-MESSAGE-LINE1
                 MOVE B"1" TO IND (99)
                 GO TO 631-EXIT
               END-IF
               DELETE PRINTERS
                   INVALID KEY MOVE FILE-STATUS TO FILE-STATUS
               END-DELETE
               IF FILE-STATUS NOT = "00"
                   MOVE "631 DELETE PRINTERS ERROR" TO BU-DISPLAY-MSG
                   MOVE DE-USER TO BU-DISPLAY-FLD (1)
                   MOVE LAST-USER-DSPST TO BU-DISPLAY-FLD (2)
                   PERFORM 990-BLOWUP THRU 999-EXIT
               END-IF
               WRITE PRINTERS-REC FROM BUF-PRINTERS
                   INVALID KEY MOVE FILE-STATUS TO FILE-STATUS
               END-WRITE
               IF FILE-STATUS NOT = "00"
                   MOVE "631 WRITE PRINTERS ERROR" TO BU-DISPLAY-MSG
                   MOVE DE-USER TO BU-DISPLAY-FLD (1)
                   MOVE LAST-USER-DSPST TO BU-DISPLAY-FLD (2)
                   PERFORM 990-BLOWUP THRU 999-EXIT
               END-IF
           END-IF.
       631-EXIT.
           EXIT.

       6311-NO-DUPS.
           IF VIEW-NFNAME = USER
               MOVE DE-USER TO KPRTUSER OF PRINTERS-I
               MOVE DE-USER-DSPST (CURR-LINE) TO KPRTTERM OF PRINTERS-I
           ELSE
               MOVE DE-DSPST-USER (CURR-LINE) TO KPRTUSER OF PRINTERS-I
               MOVE DE-DSPST TO KPRTTERM OF PRINTERS-I
           END-IF.
           READ PRINTERS-I
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
       6311-EXIT.
           EXIT.

       632-INSERT-USER.
      *----- IF DISPLAY STATION IS SPACES, MAKE IT "GENERIC"
           IF DE-USER-DSPST (CURR-LINE) = SPACES
               MOVE "GENERIC" TO DE-USER-DSPST (CURR-LINE)
           END-IF.
      *----- EDIT PRINTER NUMBERS
           IF DE-USER-PRT1 (CURR-LINE) = SPACES
               MOVE ZEROS TO DE-USER-PRT1 (CURR-LINE).
           IF DE-USER-PRT1 (CURR-LINE) NOT NUMERIC
               MOVE "PRINTER MUST BE NUMERIC" TO DE-MESSAGE-LINE1
               MOVE B"1" TO IND (99)
               GO TO 632-EXIT.
           IF DE-USER-PRT2 (CURR-LINE) = SPACES
               MOVE ZEROS TO DE-USER-PRT2 (CURR-LINE).
           IF DE-USER-PRT2 (CURR-LINE) NOT NUMERIC
               MOVE "PRINTER MUST BE NUMERIC" TO DE-MESSAGE-LINE1
               MOVE B"1" TO IND (99)
               GO TO 632-EXIT.
           IF DE-USER-PRT3 (CURR-LINE) = SPACES
               MOVE ZEROS TO DE-USER-PRT3 (CURR-LINE).
           IF DE-USER-PRT3 (CURR-LINE) NOT NUMERIC
               MOVE "PRINTER MUST BE NUMERIC" TO DE-MESSAGE-LINE1
               MOVE B"1" TO IND (99)
               GO TO 632-EXIT.
           IF DE-USER-PRT4 (CURR-LINE) = SPACES
               MOVE ZEROS TO DE-USER-PRT4 (CURR-LINE).
           IF DE-USER-PRT4 (CURR-LINE) NOT NUMERIC
               MOVE "PRINTER MUST BE NUMERIC" TO DE-MESSAGE-LINE1
               MOVE B"1" TO IND (99)
               GO TO 632-EXIT.
           IF DE-USER-PRT5 (CURR-LINE) = SPACES
               MOVE ZEROS TO DE-USER-PRT5 (CURR-LINE).
           IF DE-USER-PRT5 (CURR-LINE) NOT NUMERIC
               MOVE "PRINTER MUST BE NUMERIC" TO DE-MESSAGE-LINE1
               MOVE B"1" TO IND (99)
               GO TO 632-EXIT.
           MOVE DE-USER                  TO PRNT-USER.
           MOVE DE-USER-DSPST (CURR-LINE) TO PRNT-DISPLAY-STATION.
           MOVE DE-USER-PRT1 (CURR-LINE) TO PRNT-PRINTER1.
           MOVE DE-USER-PRT2 (CURR-LINE) TO PRNT-PRINTER2.
           MOVE DE-USER-PRT3 (CURR-LINE) TO PRNT-PRINTER3.
           MOVE DE-USER-PRT4 (CURR-LINE) TO PRNT-PRINTER4.
           MOVE DE-USER-PRT5 (CURR-LINE) TO PRNT-PRINTER5.

           PERFORM 6311-NO-DUPS THRU 6311-EXIT.
           IF FILE-STATUS = "00"
               MOVE "DUPLICATE USER/DISPLAY STATION NOT PERMITTED"
                 TO DE-MESSAGE-LINE1
               MOVE B"1" TO IND (99)
               GO TO 632-EXIT
           END-IF.
           WRITE PRINTERS-REC FROM BUF-PRINTERS
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS
           END-WRITE.
           IF FILE-STATUS NOT = "00"
               MOVE "632 WRITE PRINTERS ERROR" TO BU-DISPLAY-MSG
               MOVE DE-USER TO BU-DISPLAY-FLD (1)
               MOVE DE-USER-DSPST (CURR-LINE) TO BU-DISPLAY-FLD (2)
               PERFORM 990-BLOWUP THRU 999-EXIT
           END-IF.
       632-EXIT.
           EXIT.

       633-DELETE-USER.
           MOVE DE-USER TO KPRTUSER OF PRINTERS.
           MOVE DE-USER-DSPST (CURR-LINE) TO KPRTTERM OF PRINTERS.
           READ PRINTERS INTO BUF-PRINTERS
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE "633 READ PRINTERS ERROR" TO BU-DISPLAY-MSG
               MOVE DE-USER TO BU-DISPLAY-FLD (1)
               MOVE DE-USER-DSPST (CURR-LINE) TO BU-DISPLAY-FLD (2)
               PERFORM 990-BLOWUP THRU 999-EXIT.

           DELETE PRINTERS
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS
           END-DELETE.
           IF FILE-STATUS NOT = "00"
               MOVE "633 DELETE PRINTERS ERROR" TO BU-DISPLAY-MSG
               MOVE DE-USER TO BU-DISPLAY-FLD (1)
               MOVE DE-USER-DSPST (CURR-LINE) TO BU-DISPLAY-FLD (2)
               PERFORM 990-BLOWUP THRU 999-EXIT
           END-IF.
       633-EXIT.
           EXIT.

       64-ZAP-USER.
           MOVE DE-USER TO KPRTUSER OF PRT-USER.
           START PRT-USER KEY = KPRTUSER OF PRT-USER
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               GO TO 64-EXIT.

           READ PRT-USER NEXT INTO BUF-PRINTERS
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   GO TO 64-EXIT
               ELSE
                   MOVE "64 READ NEXT ERROR PRT-USER" TO BU-DISPLAY-MSG
                   MOVE DE-USER TO BU-DISPLAY-FLD (1)
                   PERFORM 990-BLOWUP THRU 999-EXIT.
           IF PRNT-USER NOT = DE-USER
               GO TO 64-EXIT.

           MOVE 1 TO CURR-LINE.
           MOVE PRNT-DISPLAY-STATION TO DE-USER-DSPST (CURR-LINE).
           PERFORM 633-DELETE-USER THRU 633-EXIT.
           GO TO 64-ZAP-USER.
       64-EXIT.
           EXIT.

       65-RESET-USER-PAGES.
           MOVE SPACES TO START-DISPLAY-STATION-PAGES.
           MOVE 1 TO USER-PAGE.
       65-EXIT.
           EXIT.

       7-DISPLAY-DSPST.
           IF FIRST-TIME-DSPST = "Y"
               MOVE "N" TO FIRST-TIME-DSPST
               IF DE-DSPST NOT = SPACES
                   GO TO 7-RESET-DSPST.

           MOVE DSPST TO VIEW-NFNAME.
           PERFORM 141-SET-SEL THRU 141-EXIT.
           MOVE DE-DSPST TO LAST-DSPST.
           MOVE SCREEN-DSPST TO DISPLAY-REC.
           WRITE DISPLAY-REC FORMAT IS VIEW-NFNAME
              INDIC ARE SRF-INDICATORS.

           READ  DISPLAY-FILE FORMAT IS VIEW-NFNAME
               INDIC ARE SRF-INDICATORS.
           ACCEPT IOFEEDBACK FROM I-O-FEEDBACK-AREA.
           MOVE B"0" TO IND (99).
           MOVE DISPLAY-REC TO SCREEN-DSPST.

      *------ A BAD STATUS MAY MEAN USER TURNED OFF TERMINAL.
      *------ IF SO, SIMULATE THE F3 KEY TO EXIT PROGRAM.
           IF DISPLAY-STATUS NOT = "00"
               MOVE 3 TO VIEW-LASTKEY
           ELSE
               MOVE FUNCTION-NUM TO VIEW-LASTKEY.

           IF VIEW-LASTKEY EQUAL 2
              MOVE 9 TO CATREAD-MSG-SET
              MOVE 10 TO CATREAD-MSG-NUM
              PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
              MOVE B"1" TO IND (99)
              MOVE MESSAGE-BUFFER TO DE-MESSAGE-LINE2
              GO TO 7-DISPLAY-DSPST.

      *-----EXIT PROGRAM OR RETURN TO DISPLAY BY USER
           IF VIEW-LASTKEY = 3 OR 1
              MOVE SPACES TO EDIT-SW
              GO TO 7-EXIT.

      *------ RESET IF EDITING AND ENTER, F1, OR F3 IS NOT PRESSED
           IF EDIT-SW NOT = SPACES AND VIEW-LASTKEY NOT = 0
               IF VIEW-LASTKEY NOT = 5 OR EDIT-SW NOT = "Z"
                   MOVE SPACES TO EDIT-SW
                   PERFORM 140-RESET-SRF THRU 140-EXIT
                   GO TO 7-RESET-DSPST
               END-IF
           END-IF.

      *-----ADD USER AND PRINTERS TO A DISPLAY STATION
           IF VIEW-LASTKEY = 4
               IF DE-DSPST NOT = SPACES
                   MOVE DE-DSPST TO LAST-DSPST
                   MOVE "I" TO DE-DSPST-SEL (1)
               ELSE
                   MOVE "DISPLAY STATION MUST BE ENTERED FOR ADD"
                     TO DE-MESSAGE-LINE2
                   MOVE B"1" TO IND (99)
                   GO TO 7-DISPLAY-DSPST.

      *-----DELETE DISPLAY STATION AND ITS USERS
           IF VIEW-LASTKEY = 5
             IF DE-DSPST NOT = SPACES
               IF EDIT-SW NOT = "Z"
                  PERFORM 143-SET-ZAP-SRF THRU 143-EXIT
                  MOVE "Z" TO EDIT-SW
      *------------PRESS F5 AGAIN TO CONFIRM DELETE, F8 TO CANCEL
                  MOVE 16 TO CATREAD-MSG-SET
                  MOVE 159 TO CATREAD-MSG-NUM
                  PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                  MOVE MESSAGE-BUFFER TO DE-DSPST-INST
                  GO TO 7-DISPLAY-DSPST
               ELSE
                  MOVE SPACES TO EDIT-SW
                  PERFORM 74-ZAP-DSPST THRU 74-EXIT
                  MOVE SPACES TO SCREEN-DSPST
                  PERFORM VARYING LINE-SUB FROM 1 BY 1
                    UNTIL LINE-SUB > 15
                      MOVE ZEROS TO DE-DSPST-PRINTERS (LINE-SUB)
                  END-PERFORM
                  PERFORM 140-RESET-SRF THRU 140-EXIT
                  GO TO 7-DISPLAY-DSPST
             ELSE
                  MOVE "DISPLAY STATION MUST BE ENTERED TO DELETE"
                    TO DE-MESSAGE-LINE2
                    MOVE B"1" TO IND (99)
                    GO TO 7-DISPLAY-DSPST.

      *-----PAGE BACKWARD
           IF VIEW-LASTKEY = 6
               IF DSPST-PAGE NOT = 1
                   SUBTRACT 1 FROM DSPST-PAGE
               END-IF
               GO TO 7-RESET-DSPST.

      *-----PAGE FORWARD
           IF VIEW-LASTKEY = 7
               MOVE 0 TO SUB
               PERFORM 71-FILL-DSPST-SCREEN THRU 71-EXIT
               IF DE-MESSAGE-LINE2 = SPACES
                   ADD 1 TO DSPST-PAGE
                   MOVE DE-DSPST-USER (1) TO START-USER (DSPST-PAGE)
               END-IF
               GO TO 7-DISPLAY-DSPST.

      *-----REFRESH SCREEN OR CANCEL EDIT
           IF VIEW-LASTKEY = 8
               MOVE SPACES TO EDIT-SW
               PERFORM 140-RESET-SRF THRU 140-EXIT
               GO TO 7-RESET-DSPST.

           IF DE-DSPST = SPACES
               GO TO 7-DISPLAY-DSPST.

           IF DE-DSPST = LAST-DSPST
      *------PERFORM EDITS ON DISPLAY STATION
               IF EDIT-SW NOT = SPACES
                   MOVE SPACES TO DE-DSPST-INST DE-MESSAGE-LINE2
                   PERFORM 63-PROCESS-EDITS THRU 63-EXIT
                   IF DE-DSPST-INST NOT = SPACES OR
                      DE-MESSAGE-LINE2 NOT = SPACES
                       GO TO 7-DISPLAY-DSPST
                   END-IF
               ELSE
                   MOVE 0 TO CURR-LINE
                   PERFORM 62-REVIEW-EDITS THRU 62-EXIT
                   IF EDIT-SW NOT = "I"
                       GO TO 7-DISPLAY-DSPST
                   END-IF
               END-IF
           ELSE
      *------CHANGE DISPLAY STATION
               PERFORM 75-RESET-DSPST-PAGES THRU 75-EXIT
           END-IF.

       7-RESET-DSPST.
           MOVE DE-DSPST TO KPRTTERM OF PRT-DSPST.
           READ PRT-DSPST
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "23"
                   MOVE SPACES TO DE-DSPST-USER-PRINTERS
                   PERFORM VARYING LINE-SUB FROM 1 BY 1
                     UNTIL LINE-SUB > 15
                       MOVE ZEROS TO DE-DSPST-PRINTERS (LINE-SUB)
                   END-PERFORM
                   IF EDIT-SW = SPACES
      *------------DISPLAY STAION NOT FOUND, PRESS F4 TO ADD
                      MOVE  4 TO CATREAD-MSG-SET
                      MOVE 51 TO CATREAD-MSG-NUM
                      PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                      MOVE MESSAGE-BUFFER TO DE-DSPST-INST
                   END-IF
                   GO TO 7-DISPLAY-DSPST
               ELSE
                   MOVE "READ ERR PRT-DSPST" TO BU-DISPLAY-MSG
                   MOVE DE-DSPST TO BU-DISPLAY-FLD (1)
                   PERFORM 990-BLOWUP THRU 999-EXIT.

           MOVE SPACES TO DE-DSPST-USER-PRINTERS.
           PERFORM VARYING LINE-SUB FROM 1 BY 1
             UNTIL LINE-SUB > 15
               MOVE ZEROS TO DE-DSPST-PRINTERS (LINE-SUB)
           END-PERFORM.
           MOVE 0 TO SUB.
           MOVE DE-DSPST TO KPRTTERM OF PRT-TERM-USER.
           MOVE START-USER (DSPST-PAGE) TO KPRTUSER OF PRT-TERM-USER.
           START PRT-TERM-USER KEY NOT < EXTERNALLY-DESCRIBED-KEY
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           PERFORM 71-FILL-DSPST-SCREEN THRU 71-EXIT.

           IF EDIT-SW = SPACES
      *-----EDIT CODES: M=MODIFY, I=INSERT, D=DELETE
               MOVE  5 TO CATREAD-MSG-SET
               MOVE 74 TO CATREAD-MSG-NUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER TO DE-DSPST-INST
           END-IF.

056600     GO TO 7-DISPLAY-DSPST.
056700
056800 7-EXIT.
           EXIT.

       71-FILL-DSPST-SCREEN.
           READ PRT-TERM-USER NEXT INTO BUF-PRINTERS
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   IF SUB = 0
                       MOVE "NO MORE RECORDS TO DISPLAY"
                         TO DE-MESSAGE-LINE2
                       MOVE B"1" TO IND (99)
                   END-IF
                   GO TO 71-EXIT
               ELSE
                   MOVE "READ NEXT ERROR 71" TO BU-DISPLAY-MSG
                   MOVE DE-DSPST TO BU-DISPLAY-FLD (1)
                   PERFORM 990-BLOWUP THRU 999-EXIT.
           IF PRNT-DISPLAY-STATION NOT = DE-DSPST
               IF SUB = 0
                   MOVE "NO MORE RECORDS TO DISPLAY"
                     TO DE-MESSAGE-LINE2
                   MOVE B"1" TO IND (99)
               END-IF
               GO TO 71-EXIT.

           ADD 1 TO SUB.
           IF SUB = 1
               MOVE SPACES TO DE-DSPST-USER-PRINTERS
               PERFORM VARYING LINE-SUB FROM 1 BY 1
                 UNTIL LINE-SUB > 15
                   MOVE ZEROS TO DE-DSPST-PRINTERS (LINE-SUB)
               END-PERFORM
           END-IF.
      *-----CREATE BLANK LINE FOR INSERT
           IF EDIT-SW = "I" AND CURR-LINE = SUB
               MOVE SPACES TO DE-DSPST-USER (SUB)
               MOVE ZEROS TO DE-DSPST-PRT1 (SUB)
               MOVE ZEROS TO DE-DSPST-PRT2 (SUB)
               MOVE ZEROS TO DE-DSPST-PRT3 (SUB)
               MOVE ZEROS TO DE-DSPST-PRT4 (SUB)
               MOVE ZEROS TO DE-DSPST-PRT5 (SUB)
               ADD 1 TO SUB
               IF SUB > 15
                   GO TO 71-EXIT.
           MOVE PRNT-USER TO DE-DSPST-USER (SUB).
           MOVE PRNT-PRINTER1 TO DE-DSPST-PRT1 (SUB).
           MOVE PRNT-PRINTER2 TO DE-DSPST-PRT2 (SUB).
           MOVE PRNT-PRINTER3 TO DE-DSPST-PRT3 (SUB).
           MOVE PRNT-PRINTER4 TO DE-DSPST-PRT4 (SUB).
           MOVE PRNT-PRINTER5 TO DE-DSPST-PRT5 (SUB).
           IF SUB NOT = 15
               GO TO 71-FILL-DSPST-SCREEN.
       71-EXIT.
           EXIT.

       731-MODIFY-DSPST.
           MOVE LAST-DSPST-USER TO KPRTUSER OF PRINTERS.
           MOVE DE-DSPST TO KPRTTERM OF PRINTERS.
           READ PRINTERS INTO BUF-PRINTERS
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE "731 READ PRINTERS ERROR" TO BU-DISPLAY-MSG
               MOVE LAST-DSPST-USER TO BU-DISPLAY-FLD (1)
               MOVE DE-DSPST TO BU-DISPLAY-FLD (2)
               PERFORM 990-BLOWUP THRU 999-EXIT.

      *----- IF USER IS SPACES, MAKE IT "GENERIC"
           IF DE-DSPST-USER (CURR-LINE) = SPACES
               MOVE "GENERIC" TO DE-DSPST-USER (CURR-LINE)
           END-IF.
      *----- EDIT PRINTER NUMBERS
           IF DE-DSPST-PRT1 (CURR-LINE) = SPACES
               MOVE ZEROS TO DE-DSPST-PRT1 (CURR-LINE).
           IF DE-DSPST-PRT1 (CURR-LINE) NOT NUMERIC
               MOVE "PRINTER MUST BE NUMERIC" TO DE-MESSAGE-LINE2
               MOVE B"1" TO IND (99)
               GO TO 731-EXIT.
           IF DE-DSPST-PRT2 (CURR-LINE) = SPACES
               MOVE ZEROS TO DE-DSPST-PRT2 (CURR-LINE).
           IF DE-DSPST-PRT2 (CURR-LINE) NOT NUMERIC
               MOVE "PRINTER MUST BE NUMERIC" TO DE-MESSAGE-LINE2
               MOVE B"1" TO IND (99)
               GO TO 731-EXIT.
           IF DE-DSPST-PRT3 (CURR-LINE) = SPACES
               MOVE ZEROS TO DE-DSPST-PRT3 (CURR-LINE).
           IF DE-DSPST-PRT3 (CURR-LINE) NOT NUMERIC
               MOVE "PRINTER MUST BE NUMERIC" TO DE-MESSAGE-LINE2
               MOVE B"1" TO IND (99)
               GO TO 731-EXIT.
           IF DE-DSPST-PRT4 (CURR-LINE) = SPACES
               MOVE ZEROS TO DE-DSPST-PRT4 (CURR-LINE).
           IF DE-DSPST-PRT4 (CURR-LINE) NOT NUMERIC
               MOVE "PRINTER MUST BE NUMERIC" TO DE-MESSAGE-LINE2
               MOVE B"1" TO IND (99)
               GO TO 731-EXIT.
           IF DE-DSPST-PRT5 (CURR-LINE) = SPACES
               MOVE ZEROS TO DE-DSPST-PRT5 (CURR-LINE).
           IF DE-DSPST-PRT5 (CURR-LINE) NOT NUMERIC
               MOVE "PRINTER MUST BE NUMERIC" TO DE-MESSAGE-LINE2
               MOVE B"1" TO IND (99)
               GO TO 731-EXIT.

           MOVE DE-DSPST-USER (CURR-LINE) TO PRNT-USER.
           MOVE DE-DSPST-PRT1 (CURR-LINE) TO PRNT-PRINTER1.
           MOVE DE-DSPST-PRT2 (CURR-LINE) TO PRNT-PRINTER2.
           MOVE DE-DSPST-PRT3 (CURR-LINE) TO PRNT-PRINTER3.
           MOVE DE-DSPST-PRT4 (CURR-LINE) TO PRNT-PRINTER4.
           MOVE DE-DSPST-PRT5 (CURR-LINE) TO PRNT-PRINTER5.

           IF DE-DSPST-USER (CURR-LINE) = LAST-DSPST-USER
               REWRITE PRINTERS-REC FROM BUF-PRINTERS
                   INVALID KEY MOVE FILE-STATUS TO FILE-STATUS
               END-REWRITE
               IF FILE-STATUS NOT = "00"
                   MOVE "731 REWRITE PRINTERS ERROR" TO BU-DISPLAY-MSG
                   MOVE LAST-DSPST-USER TO BU-DISPLAY-FLD (1)
                   MOVE DE-DSPST TO BU-DISPLAY-FLD (2)
                   PERFORM 990-BLOWUP THRU 999-EXIT
               END-IF
           ELSE
               PERFORM 6311-NO-DUPS THRU 6311-EXIT
               IF FILE-STATUS = "00"
                 MOVE "DUPLICATE DISPLAY STATION/USER NOT PERMITTED"
                   TO DE-MESSAGE-LINE2
                 MOVE B"1" TO IND (99)
                 GO TO 731-EXIT
               END-IF
               DELETE PRINTERS
                   INVALID KEY MOVE FILE-STATUS TO FILE-STATUS
               END-DELETE
               IF FILE-STATUS NOT = "00"
                   MOVE "731 DELETE PRINTERS ERROR" TO BU-DISPLAY-MSG
                   MOVE LAST-DSPST-USER TO BU-DISPLAY-FLD (1)
                   MOVE DE-DSPST TO BU-DISPLAY-FLD (2)
                   PERFORM 990-BLOWUP THRU 999-EXIT
               END-IF
               WRITE PRINTERS-REC FROM BUF-PRINTERS
                   INVALID KEY MOVE FILE-STATUS TO FILE-STATUS
               END-WRITE
               IF FILE-STATUS NOT = "00"
                   MOVE "731 WRITE PRINTERS ERROR" TO BU-DISPLAY-MSG
                   MOVE LAST-DSPST-USER TO BU-DISPLAY-FLD (1)
                   MOVE DE-DSPST TO BU-DISPLAY-FLD (2)
                   PERFORM 990-BLOWUP THRU 999-EXIT
               END-IF
           END-IF.
       731-EXIT.
           EXIT.

       732-INSERT-DSPST.
      *----- IF USER IS SPACES THEN MAKE IT "GENERIC"
           IF DE-DSPST-USER (CURR-LINE) = SPACES
               MOVE "GENERIC" TO DE-DSPST-USER (CURR-LINE)
           END-IF.
      *----- EDIT PRINTER NUMBERS
           IF DE-DSPST-PRT1 (CURR-LINE) = SPACES
               MOVE ZEROS TO DE-DSPST-PRT1 (CURR-LINE).
           IF DE-DSPST-PRT1 (CURR-LINE) NOT NUMERIC
               MOVE "PRINTER MUST BE NUMERIC" TO DE-MESSAGE-LINE2
               MOVE B"1" TO IND (99)
               GO TO 732-EXIT.
           IF DE-DSPST-PRT2 (CURR-LINE) = SPACES
               MOVE ZEROS TO DE-DSPST-PRT2 (CURR-LINE).
           IF DE-DSPST-PRT2 (CURR-LINE) NOT NUMERIC
               MOVE "PRINTER MUST BE NUMERIC" TO DE-MESSAGE-LINE2
               MOVE B"1" TO IND (99)
               GO TO 732-EXIT.
           IF DE-DSPST-PRT3 (CURR-LINE) = SPACES
               MOVE ZEROS TO DE-DSPST-PRT3 (CURR-LINE).
           IF DE-DSPST-PRT3 (CURR-LINE) NOT NUMERIC
               MOVE "PRINTER MUST BE NUMERIC" TO DE-MESSAGE-LINE2
               MOVE B"1" TO IND (99)
               GO TO 732-EXIT.
           IF DE-DSPST-PRT4 (CURR-LINE) = SPACES
               MOVE ZEROS TO DE-DSPST-PRT4 (CURR-LINE).
           IF DE-DSPST-PRT4 (CURR-LINE) NOT NUMERIC
               MOVE "PRINTER MUST BE NUMERIC" TO DE-MESSAGE-LINE2
               MOVE B"1" TO IND (99)
               GO TO 732-EXIT.
           IF DE-DSPST-PRT5 (CURR-LINE) = SPACES
               MOVE ZEROS TO DE-DSPST-PRT5 (CURR-LINE).
           IF DE-DSPST-PRT5 (CURR-LINE) NOT NUMERIC
               MOVE "PRINTER MUST BE NUMERIC" TO DE-MESSAGE-LINE2
               MOVE B"1" TO IND (99)
               GO TO 732-EXIT.
           MOVE DE-DSPST-USER (CURR-LINE) TO PRNT-USER.
           MOVE DE-DSPST                  TO PRNT-DISPLAY-STATION.
           MOVE DE-DSPST-PRT1 (CURR-LINE) TO PRNT-PRINTER1.
           MOVE DE-DSPST-PRT2 (CURR-LINE) TO PRNT-PRINTER2.
           MOVE DE-DSPST-PRT3 (CURR-LINE) TO PRNT-PRINTER3.
           MOVE DE-DSPST-PRT4 (CURR-LINE) TO PRNT-PRINTER4.
           MOVE DE-DSPST-PRT5 (CURR-LINE) TO PRNT-PRINTER5.

           PERFORM 6311-NO-DUPS THRU 6311-EXIT.
           IF FILE-STATUS = "00"
               MOVE "DUPLICATE DISPLAY STATION/USER NOT PERMITTED"
                 TO DE-MESSAGE-LINE2
               MOVE B"1" TO IND (99)
               GO TO 732-EXIT
           END-IF.
           WRITE PRINTERS-REC FROM BUF-PRINTERS
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS
           END-WRITE.
           IF FILE-STATUS NOT = "00"
               MOVE "732 WRITE PRINTERS ERROR" TO BU-DISPLAY-MSG
               MOVE DE-DSPST TO BU-DISPLAY-FLD (1)
               MOVE DE-DSPST-USER (CURR-LINE) TO BU-DISPLAY-FLD (2)
               PERFORM 990-BLOWUP THRU 999-EXIT
           END-IF.
       732-EXIT.
           EXIT.

       733-DELETE-DSPST.
           MOVE DE-DSPST-USER (CURR-LINE) TO KPRTUSER OF PRINTERS.
           MOVE DE-DSPST TO KPRTTERM OF PRINTERS.
           READ PRINTERS INTO BUF-PRINTERS
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE "733 READ PRINTERS ERROR" TO BU-DISPLAY-MSG
               MOVE DE-DSPST-USER (CURR-LINE) TO BU-DISPLAY-FLD (1)
               MOVE DE-DSPST TO BU-DISPLAY-FLD (2)
               PERFORM 990-BLOWUP THRU 999-EXIT.

           DELETE PRINTERS
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS
           END-DELETE.
           IF FILE-STATUS NOT = "00"
               MOVE "733 DELETE PRINTERS ERROR" TO BU-DISPLAY-MSG
               MOVE DE-DSPST-USER (CURR-LINE) TO BU-DISPLAY-FLD (1)
               MOVE DE-DSPST TO BU-DISPLAY-FLD (2)
               PERFORM 990-BLOWUP THRU 999-EXIT
           END-IF.
       733-EXIT.
           EXIT.

       74-ZAP-DSPST.
           MOVE DE-DSPST TO KPRTTERM OF PRT-DSPST.
           START PRT-DSPST KEY = KPRTTERM OF PRT-DSPST
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               GO TO 74-EXIT.

           READ PRT-DSPST NEXT INTO BUF-PRINTERS
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   GO TO 74-EXIT
               ELSE
                   MOVE "74 READ NEXT ERROR PRT-USER" TO BU-DISPLAY-MSG
                   MOVE DE-DSPST TO BU-DISPLAY-FLD (1)
                   PERFORM 990-BLOWUP THRU 999-EXIT.
           IF PRNT-DISPLAY-STATION NOT = DE-DSPST
               GO TO 74-EXIT.

           MOVE 1 TO CURR-LINE.
           MOVE PRNT-USER TO DE-DSPST-USER (CURR-LINE).
           PERFORM 733-DELETE-DSPST THRU 733-EXIT.
           GO TO 74-ZAP-DSPST.
       74-EXIT.
           EXIT.

       75-RESET-DSPST-PAGES.
           MOVE SPACES TO START-USER-PAGES.
           MOVE 1 TO DSPST-PAGE.
       75-EXIT.
           EXIT.

061200************************************************************
061300*                    B L O W U P                           *
061400*     CHECK FOR IMAGE, VIEW, OR SPOOL ERROR.  CLOSE        *
061500*     FILES, GET OUT OF BLOCK MODE, AND DISPLAY            *
061600*     APPROPRIATE ERROR MESSAGE ON SCREEN.                 *
061700*                                                          *
061800*     ALSO APPENDS THE ERROR MESSAGE TO A FILE CALLED      *
061900*     BLOWUP.PUB.  TO READ THIS FILE, RUN "XBLPRT.OBJECT". *
062000*                                                          *
062100*         |||  PROGRAM IS ABORTED IN TBLOWUP  |||          *
062200************************************************************
062300 990-BLOWUP.
062400     MOVE "TUSERPRT" TO BU-PGM-NAME.
062600     CALL "TBLOWUP" USING BASE, BU-PGM-NAME, STATUS-AREA,
062700           VIEW-COMAREA, FILE-STATUS, BU-DISPLAY-MSG,
062800           BU-DISPLAY-FLDS.
           GOBACK.
062900 999-EXIT.  EXIT.
063000
063100 999-CATREAD.
           CALL "CCATREAD" USING CATREAD-PARMS.
           MOVE CATREAD-MSG-TEXT TO MESSAGE-BUFFER.
064700 999-CATREAD-EXIT.
064800     EXIT.
