000200 IDENTIFICATION DIVISION.
000300 PROGRAM-ID. TUPDTEXC.
000400*REMARKS.    THIS PROGRAM IS THE EXECUTIVE CONTROLLING PROGRAM
000500*            FOR WORK ORDER MODIFY PROGRAMS.
000600 ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.
       SOURCE-COMPUTER.    AS400.
       OBJECT-COMPUTER.    AS400.
       SPECIAL-NAMES.      LOCAL-DATA IS LOCAL-DATA-AREA.
000700 DATA DIVISION.
000800 WORKING-STORAGE SECTION.
000900 01  BLOWUP-BASE                  PIC X(16).
001000 01  ERROR-BUFFER                 PIC X(80).
004000 01  ERROR-SWITCH.
004100     05  ERR-SW                   PIC S9(4) COMP.
       COPY JCWAREA IN COPYLIB.
001500 01  PASSWORD-INFORMATION.
001600     05  NAME-OF-PROGRAM     PIC X(08) VALUE "TUPDTEXC".
001700     05  PROGRAM-TYPE        PIC X(02) VALUE "UP".
001800     05  PROGRAM-RELEASE     PIC X(12) VALUE " E0100010001".
001900     05  PROGRAM-DESCRIPTION.
002000         10  PROG-DESC-A.
                   15  FILLER      PIC X(14) VALUE " UPDATE A W/O ".
                   15  FILLER      PIC X(17) VALUE "EXECUTIVE PROGRAM".
                   15  FILLER      PIC X(29) VALUE SPACES.
002200         10  PROG-DESC-B     PIC X(60) VALUE SPACES.
002400         10  PROG-FUNCTION   PIC X(60) VALUE SPACES.
002600     05  PASSWORD-FLAG       PIC X.
       COPY DBSTAT OF COPYLIB.
       COPY VCOMAREA OF COPYLIB.
002800 COPY TBLOWUP IN COPYLIB.
002900 LINKAGE SECTION.
003600 01  DBPARAMETERS.       COPY DBPARMS OF COPYLIB.
       COPY SCREENIO OF COPYLIB.
       COPY CATREAD  OF COPYLIB.
004200 PROCEDURE DIVISION USING DBPARAMETERS SCREEN-PARMS
004300                      CATREAD-PARMS.
004400 BEGIN-PROCESSING.
           PERFORM 1-HSK.
           PERFORM 6-MAIN UNTIL KEY-HIT = 3.
016900 2-EOJ.
017000     IF ERROR-SWITCH = "88" OR "TP" OR "TE" OR "NP" OR "PZ"
017100         MOVE 0 TO ERR-SW.
017200     GOBACK.
       1-HSK.
004500     CALL "TPWORD" USING PASSWORD-INFORMATION.
004900     IF PASSWORD-FLAG = "N"
005000         MOVE "  PWORD" TO BLOWUP-BASE
005100         MOVE "FAILED PASSWORD CHECK - TUPDTEXC"
005200             TO BU-DISPLAY-MSG
005300         PERFORM 998-BLOWUP.
           ACCEPT MC-LOCAL-DATA-AREA FROM LOCAL-DATA-AREA.
006900***************************************************************
007000*    JCWVALUE = 1 PERMITS ACCESS TO ENGINEER/VERBAL W/O'S     *
007100*    JCWVALUE = 2 PERMITS ACCESS TO PLANNER/VERBAL  W/O'S     *
007200*    JCWVALUE = 3 PERMITS ACCESS TO ALL TYPE        W/O'S     *
007300*    JCWVALUE = 4 PERMITS ACCESS TO ONLY VERBAL     W/O'S     *
007400***************************************************************
008400 6-MAIN.
007500     IF JCW-MJCW-260 < 4
007600         MOVE "FUPDTEX2" TO SCREEN-NAME
007700     ELSE
007800     MOVE "FUPDTEXC" TO SCREEN-NAME.
008500     MOVE SPACES TO SCREEN-BUFFER.
           CALL "TSCREEN" USING SCREEN-PARMS.
           IF SCREEN-STATUS NOT = "00"
               MOVE 3 TO KEY-HIT
           ELSE
           MOVE ALL B"0" TO SCREEN-INDICATORS
           MOVE SPACES TO ERROR-BUFFER.
009600     IF KEY-HIT = 3 GO TO 2-EOJ.
009900     IF KEY-HIT = 1
010000         CALL "TMODEXES" USING DBPARAMETERS SCREEN-PARMS
010100                           CATREAD-PARMS
010300         IF KEY-HIT = 1
010400             GO TO 2-EOJ
010500         ELSE
010600         MOVE 0 TO KEY-HIT
010700         GO TO 6-MAIN.
010900     IF KEY-HIT = 2
011000         CALL "TCONTUPD" USING DBPARAMETERS SCREEN-PARMS
011100                           CATREAD-PARMS
011300         IF KEY-HIT = 1
011400             GO TO 2-EOJ
011500         ELSE
011600         MOVE 0 TO KEY-HIT
011700         GO TO 6-MAIN.
011900     IF KEY-HIT = 4
012000         CALL "TUPDTODW" USING DBPARAMETERS SCREEN-PARMS
012100                           CATREAD-PARMS
012300         IF KEY-HIT = 1
012400             GO TO 2-EOJ
012500         ELSE
012600         MOVE 0 TO KEY-HIT
012700         GO TO 6-MAIN.
012900     IF KEY-HIT = 5
013000         IF JCW-MJCW-260 < 4
013100             CALL "TASPTREQ" USING DBPARAMETERS SCREEN-PARMS
013200                               CATREAD-PARMS
013300             IF KEY-HIT = 1
013400                 GO TO 2-EOJ
013500             ELSE
013600             MOVE 0 TO KEY-HIT
013700             GO TO 6-MAIN.
014700     IF KEY-HIT = 6
014800         CALL "TMUPDEXC" USING DBPARAMETERS SCREEN-PARMS
014900                           CATREAD-PARMS
015100         IF KEY-HIT = 1
015200             GO TO 2-EOJ
015300         ELSE
015400         MOVE 0 TO KEY-HIT
015500         GO TO 6-MAIN.
016300
016400 998-BLOWUP.
016500     MOVE "TUPDTEXC" TO BU-PGM-NAME.
016600     CALL "TBLOWUP" USING BLOWUP-BASE BU-PGM-NAME STATUS-AREA
016700                      VIEW-COMAREA DUMMY-KSAM-STAT
016800                      BU-DISPLAY-MSG BU-DISPLAY-FLDS.
