000200 IDENTIFICATION DIVISION.
000300 PROGRAM-ID.          SMTALLDB.
000400 AUTHOR.              C HILLES.
000500 DATE-WRITTEN.        MARCH, 1982.
000600 DATE-COMPILED.
000700*INSTALLATION.        GOODYEAR TIRE AND RUBBER - AKRON.
000800*SECURITY.
      *REMARKS
      *****************************************************************
      *         MATERIAL STATUS OVERALL DATABASE INQURIY.
      *****************************************************************
      *
      *****************************************************************
      **          M O D I F I C A T I O N    H I S T O R Y
      *****************************************************************
      *C 09/12/96  JEFF BUNGO
      *C   EXPAND DATE FIELDS FOR YEAR 2000 COMPLIANCE.
      *C   INCLUDE CENTURY IN COMPARISON OF CURRENT DATE
      *C   AND PO EXPECT DATE.
      *C---------------------------------------------------------------
      *C MAR 10, 2005  D.RAUCH       DCR01    REQUEST# 2005-78515
      *C    DISPLAY FILE PROCESSING CHANGED FROM USING ZCSISINQ
      *C    NEW DISPLAY FILE ZSMTALLDB  CREATED - FORMATS COPIED
      *C    FROM ZCSISINQ.
      *C---------------------------------------------------------------
      *C MMM DD, CCYY  XXXNAMEXXX    XXX01    REQUEST# 2005-XXXXX
      *C    XXXXXXXXXXXXXXXXXX DESC XXXXXXXXXXXXXXXXXXXXXXXXXXXXX
      *****************************************************************

023800 ENVIRONMENT DIVISION.
023900 CONFIGURATION SECTION.
024000 SOURCE-COMPUTER.  HP-3000.
024100 OBJECT-COMPUTER.  HP-3000.

024300 INPUT-OUTPUT SECTION.
024400 FILE-CONTROL.

           SELECT MSTORERM
                  ASSIGN TO DATABASE-MCFLCS0201
                  ORGANIZATION IS INDEXED
                    ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                  FILE STATUS IS FILE-STATUS.

           SELECT DPOITEM
                  ASSIGN TO DATABASE-MCFLCS1001
                  ORGANIZATION IS INDEXED
                    ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                    WITH DUPLICATES
                  FILE STATUS IS FILE-STATUS.

           SELECT DPORECD
                  ASSIGN TO DATABASE-MCFLCS0901
                  ORGANIZATION IS INDEXED
                    ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                    WITH DUPLICATES
                  FILE STATUS IS FILE-STATUS.

           SELECT DISPLAY-FILE
DCR01          ASSIGN TO WORKSTATION-ZSMTALLDB-SI
               ORGANIZATION IS TRANSACTION
               ACCESS IS SEQUENTIAL
               FILE STATUS IS DISPLAY-STATUS
               CONTROL-AREA IS WS-CONTROL.

024800
024900 DATA DIVISION.
025000 FILE SECTION.
025200
       FD  MSTORERM
           LABEL RECORDS ARE STANDARD.
       01  MSTORERM-REC.
           COPY DDS-MCRPCS0200  OF MCFLCS0201.

       FD  DPOITEM
           LABEL RECORDS ARE STANDARD.
       01  DPOITEM-REC.
           COPY DDS-MCRPCS1000  OF MCFLCS1001.

       FD  DPORECD
           LABEL RECORDS ARE STANDARD.
       01  DPORECD-REC.
           COPY DDS-MCRPCS0900  OF MCFLCS0901.

       FD  DISPLAY-FILE
           LABEL RECORDS ARE OMITTED.
       01  DISPLAY-REC                   PIC X(2000).

025300 WORKING-STORAGE SECTION.
025400
       77  SUB              PIC S9(4) COMP-4.
       77  BLANKET-SUB      PIC S9(4) COMP-4.
       77  NUM-CODES-FOUND  PIC 9.

       01  TEMP-DATE-CN.
           05  TEMP-DATE-CC   PIC X(2).
           05  TEMP-DATE.
               10  TEMP-DATE-YY PIC X(2).
               10  FILLER       PIC X(4).

031700 COPY TDATECHK   IN COPYLIB.
031900 COPY TBLOWUP    IN COPYLIB.
032100 COPY TSHWRDFM   IN COPYLIB.
       COPY CATREAD    IN COPYLIB.

      *------ PARMS FOR CALL TO 'QCMDEXC': EXECUTE A COMMAND
       01  COMMAND-WORK                      PIC X(70).
       01  COMMAND-LEN      PIC S9(10)V9(5) COMP-3 VALUE 70.

032800*************************************************************
032900**                                                         **
033000**      V I E W   C O M M U N I C A T I O N   A R E A      **
033100**                                                         **
033200*************************************************************
033300
       01  SCREEN-BUFFER                 PIC X(2000).

034800 01  MESSAGE-BUFFER.
034900     05  MSG-TEXT                  PIC X(68)    VALUE SPACE.
035000     05  MSG-FLD                   PIC X(8)     VALUE SPACE.
035100     05  MSG-FLD-9  REDEFINES  MSG-FLD      PIC ZZZZZZZ9.
035200
036400*************************************************
036500*                                               *
036600*   SCREEN BUFFER AREAS                         *
036700*                                               *
036800*************************************************
036900
037800 01  SCREEN-1B.
037900     05  SCREEN-1B-COMP                  PIC X(3).
038000     05  TRM-CORP-CODE-1B                PIC X(7).
038100     05  SCREEN-1B-MSG-LINE1             PIC X(65).
038200     05  SCREEN-1B-MSG-LINE2             PIC X(65).
038300     05  PLANTX-INFO    OCCURS 7 TIMES.
038400         10  PLANTX-MORE-INFO            PIC X(1).
038500         10  PLANTX-PLANT                PIC X(4).
038600         10  PLANTX-LOC1                 PIC X(12).
038700         10  PLANTX-LOC2                 PIC X(12).
038800         10  PLANTX-ONHAND               PIC --------9.
038900         10  PLANTX-STR-UM               PIC X(2).
039000         10  PLANTX-REQ-ORDER            PIC X(7).
039100         10  PLANTX-ITEM-NO              PIC ZZZ9.
039200         10  PLANTX-ORD-UM               PIC X(2).
039300         10  PLANTX-REQ-DATE             PIC X(8).
           05  DE-COMMAND-LINE-1B              PIC X(79).
           05  DE-MESSAGE-LINE-1B              PIC X(79).

       01  WS-CONTROL.
           02  FUNCTION-NUM            PIC XX.
                   88  EXIT-KEY-F8-USED                     VALUE "08". LVW000LS
                   88  REFRESH-KEY-F4-USED                  VALUE "04". LVW000LS
                   88  ENTER-KEY-USED                       VALUE "00". LVW000LS
                   88  F1-KEY-USED                          VALUE "01". LVW000LS
                   88  F2-KEY-USED                          VALUE "02". LVW000LS
                   88  F3-KEY-USED                          VALUE "03". LVW000LS
                   88  F4-KEY-USED                          VALUE "04". LVW000LS
                   88  F5-KEY-USED                          VALUE "05". LVW000LS
                   88  F6-KEY-USED                          VALUE "06". LVW000LS
                   88  F7-KEY-USED                          VALUE "07". LVW000LS
                   88  F8-KEY-USED                          VALUE "08". LVW000LS
           02 FUN-KEY REDEFINES FUNCTION-NUM PIC XX.
           02 TERMINAL-ID PIC X(10).
           02 FORMAT-NAME PIC X(10).
039400
053400**************************************************************
053500**                                                          **
053600**            D A T A B A S E   W O R K                     **
053700**                                                          **
053800**************************************************************
053900
       01  FILE-STATUS.
           05  FILE-STATUS-1            PIC X  VALUE "0".
           05  FILE-STATUS-2            PIC X  VALUE "0".
       01  DISPLAY-STATUS               PIC XX.
054000
058800 01  STATUS-AREA.
058900     05  COND-WORD              PIC S9(4) VALUE ZEROS   COMP-4.
059000     05  DATA-LENG              PIC S9(4) VALUE ZEROS   COMP-4.
059100     05  RCD-NO                 PIC S9(9) VALUE ZEROS   COMP-4.
059200     05  CHAIN-LENG             PIC S9(9) VALUE ZEROS   COMP-4.
059300     05  BKWD-ADDR              PIC S9(9) VALUE ZEROS   COMP-4.
059400     05  FWRD-ADDR              PIC S9(9) VALUE ZEROS   COMP-4.
059500
057600**************************************************************
057700**                                                          **
057800**             D A T A B A S E   B U F F E R S              **
057900**                                                          **
058000**************************************************************
058100 COPY MSTORERM IN COPYLIB.
058500 COPY DPOITEM  IN COPYLIB.
       COPY DPORECD  IN COPYLIB.
058700
065300**************************************************************
065400**                                                          **
065500**            L I N K A G E   S E C T I O N                 **
065600**                                                          **
065700**************************************************************
065800
065900 LINKAGE SECTION.
066000 01  BASE                      PIC X(20).
066100
       COPY VCOMLINK IN COPYLIB.
070800 01  MPLTINFO-COMP             PIC X(4).
070900
071000 01  PASSED-SPOOL-PRT          PIC S9(2) COMP-4.
071100 01  CODE-ARG                  PIC X(8).
071200
071300********************************
071400* NATIVE LANGUAGE SUPPORT AREA *
071500********************************
071600
071700 COPY LANGSUB IN COPYLIB.
071800
054100 01  BASE-AREA.
054200     05  BASE-DEF OCCURS 9 TIMES.
054300         10  BASES.
054400             15  BASE-NAME      PIC X(9).
054500             15  BASE-GROUP     PIC X(9).
054600         10  BASE-PLT           PIC X(3).
054700         10  BASE-PLT-DESC      PIC X(4).
054800         10  FILLER             PIC X.
054900
       01  RETURN-BASE                PIC X(9).

071900 PROCEDURE DIVISION USING BASE, VIEW-COMAREA,
072000     MPLTINFO-COMP, PASSED-SPOOL-PRT, CODE-ARG,
072100     LANGUAGE-PARMS, BASE-AREA, RETURN-BASE.
072200
072300 PROC-DIV SECTION.
072400 6000-MAIN.

           MOVE SPACES TO SCREEN-1B.
           MOVE 0 TO SUB.
           MOVE 0 TO NUM-CODES-FOUND.
      *    MOVE BASE-GROUP (1) TO RETURN-BASE.
       6010-LOAD-LOOP.
           ADD 1 TO SUB.
           IF SUB > 7
               GO TO 6100-SHOW-FORM.

      **   IF BASE-PLT(SUB) = MPLTINFO-COMP
      **       MOVE BASE-GROUP(SUB) TO RETURN-BASE
      **       GO TO 6020-SKIP-OVERRIDE.
           IF BASE-GROUP (SUB) = SPACES
               MOVE SPACES TO PLANTX-INFO (SUB)
               GO TO 6010-LOAD-LOOP.

           STRING "OVRDBF FILE(MCFLCS0201) TOFILE(" DELIMITED BY SIZE,
             BASE-GROUP (SUB) DELIMITED BY SPACES,
               "/MCFLCS0201) SHARE(*NO)" DELIMITED BY SIZE
             INTO COMMAND-WORK.
           CALL "QCMDEXC" USING COMMAND-WORK, COMMAND-LEN.

           STRING "OVRDBF FILE(MCFLCS1001) TOFILE(" DELIMITED BY SIZE,
             BASE-GROUP (SUB) DELIMITED BY SPACES,
               "/MCFLCS1001) SHARE(*NO)" DELIMITED BY SIZE
             INTO COMMAND-WORK.
           CALL "QCMDEXC" USING COMMAND-WORK, COMMAND-LEN.

           STRING "OVRDBF FILE(MCFLCS0901) TOFILE(" DELIMITED BY SIZE,
             BASE-GROUP (SUB) DELIMITED BY SPACES,
               "/MCFLCS0901) SHARE(*NO)" DELIMITED BY SIZE
             INTO COMMAND-WORK.
           CALL "QCMDEXC" USING COMMAND-WORK, COMMAND-LEN.

       6020-SKIP-OVERRIDE.
           OPEN INPUT MSTORERM.
           OPEN INPUT DPOITEM.
           OPEN INPUT DPORECD.
           OPEN I-O DISPLAY-FILE.

           MOVE BASE-PLT-DESC (SUB) TO PLANTX-PLANT (SUB).
           MOVE 0 TO COND-WORD.
           MOVE CODE-ARG TO CORPCDE OF MSTORERM-REC.
           READ MSTORERM INTO BUF-MSTORERM
               INVALID KEY MOVE 17 TO COND-WORD.
           IF FILE-STATUS-1 = "2"
               MOVE 17 TO COND-WORD
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD.

           IF COND-WORD = 17
      *        "NOT STOCKED"
               MOVE 14 TO LANG-SETNUM
               MOVE 64 TO LANG-MSGNUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE SPACES TO PLANTX-INFO (SUB)
               MOVE BASE-PLT-DESC (SUB) TO PLANTX-PLANT (SUB)
               MOVE MESSAGE-BUFFER TO PLANTX-LOC1 (SUB)
               GO TO 6050-CLOSE-FILES.

           ADD 1 TO NUM-CODES-FOUND.
           MOVE STR-LOC (1) TO PLANTX-LOC1 (SUB).
           MOVE STR-LOC (2) TO PLANTX-LOC2 (SUB).
           MOVE STR-ONHAND TO PLANTX-ONHAND (SUB).
           MOVE STR-UM      TO PLANTX-STR-UM (SUB).

      *------ CHECK ALL DPOITEM RECORDS FOR THE CODE UNTIL YOU
      *------ FIND 2 REQUIREMENT ORDERS OR UNTIL YOU HAVE LOOKED
      *------ AT ALL DPOITEMS FOR THAT CODE.
       6030-FIND-DPOITEM.
           MOVE 0 TO COND-WORD.
           MOVE 0 TO BLANKET-SUB.
           MOVE CODE-ARG TO CORPCDE OF DPOITEM-REC.
           START DPOITEM KEY = CORPCDE OF DPOITEM-REC
               INVALID KEY MOVE 0 TO COND-WORD.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
                   MOVE 0 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.

       6040-GET-DPOITEM-LOOP.
           MOVE 0 TO COND-WORD.
           READ DPOITEM NEXT INTO BUF-DPOITEM
               AT END MOVE 15 TO COND-WORD.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   MOVE 15 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.
           IF CORPCDE OF DPOITEM-REC NOT = CODE-ARG
               MOVE 15 TO COND-WORD.

           IF COND-WORD = 15
               GO TO 6050-CLOSE-FILES.

           IF ITM-PO-REL = "999"
               PERFORM 9000-GET-EXP-DATE THRU 9090-GED-X
               MOVE 1 TO DATE-MODE
               CALL "TDATECK2" USING DATE-CHECK-AREA, LANGUAGE-PARMS
               MOVE DATE-YMD-OUT TO TEMP-DATE
               IF TEMP-DATE-YY > "70"
                   MOVE "19" TO TEMP-DATE-CC
               ELSE
                   MOVE "20" TO TEMP-DATE-CC
               END-IF
               IF TEMP-DATE-CN < PO-EXPECT-DATE-CN
                   IF BLANKET-SUB > 0
                       GO TO 6050-CLOSE-FILES
                   ELSE
                       MOVE ITM-PO-NO TO PLANTX-REQ-ORDER (SUB)
                       MOVE ITM-NUMBER TO PLANTX-ITEM-NO (SUB)
                       MOVE ITM-UM     TO PLANTX-ORD-UM (SUB)
                       MOVE 4          TO DATE-MODE
                       MOVE PO-EXPECT-DATE TO DATE-VALIDATE-IN
                       CALL "TDATECK2" USING DATE-CHECK-AREA,
                         LANGUAGE-PARMS
                       MOVE DATE-SLASH-OUT TO PLANTX-REQ-DATE (SUB)
                       ADD 1 TO BLANKET-SUB.

           GO TO 6040-GET-DPOITEM-LOOP.

       6050-CLOSE-FILES.
           CLOSE MSTORERM.
           CLOSE DPOITEM.
           CLOSE DPORECD.
      **   IF BASE-PLT(SUB) NOT = MPLTINFO-COMP
               MOVE "DLTOVR FILE(MCFLCS0201)" TO COMMAND-WORK.
               CALL "QCMDEXC" USING COMMAND-WORK, COMMAND-LEN.
               MOVE "DLTOVR FILE(MCFLCS1001)" TO COMMAND-WORK.
               CALL "QCMDEXC" USING COMMAND-WORK, COMMAND-LEN.
               MOVE "DLTOVR FILE(MCFLCS0901)" TO COMMAND-WORK.
               CALL "QCMDEXC" USING COMMAND-WORK, COMMAND-LEN.
           GO TO 6010-LOAD-LOOP.

       6100-SHOW-FORM.
           IF NUM-CODES-FOUND = 0
               MOVE "NOTFOUND" TO RETURN-BASE
               GO TO 6990-MAIN-X.

      *    "PLACE AN 'X' BY THE PROPER PLANT FOR THE BASIC INQUIRY SCR"
           MOVE 16 TO LANG-SETNUM.
           MOVE 113 TO LANG-MSGNUM.
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
           MOVE MESSAGE-BUFFER TO SCREEN-1B-MSG-LINE1.
           MOVE CODE-ARG TO TRM-CORP-CODE-1B.
           MOVE MPLTINFO-COMP TO SCREEN-1B-COMP.

           MOVE 8 TO SRF-KEYSET.
           MOVE "ZCSISINQ" TO VIEW-CFNAME.
           MOVE "FMTLSTAT1B" TO VIEW-NFNAME.

           MOVE SCREEN-1B TO DISPLAY-REC.
           WRITE DISPLAY-REC FORMAT IS VIEW-NFNAME
              INDIC ARE SRF-INDICATORS.
           IF DISPLAY-STATUS NOT = "00"
               GO TO 6990-MAIN-X.

           READ DISPLAY-FILE FORMAT IS VIEW-NFNAME
              INDIC ARE SRF-INDICATORS.
           MOVE MESSAGE-BUFFER TO SCREEN-1B-MSG-LINE2.
           MOVE ALL B"0" TO SRF-INDICATORS.
           IF DISPLAY-STATUS NOT = "00"
               GO TO 6990-MAIN-X
           ELSE
               MOVE FUNCTION-NUM TO VIEW-LASTKEY.

      *    CALL "TSHWRDFM" USING SRF-COMAREA, BU-DISPLAY-MSG,
      *      VIEW-COMAREA, BASE, STATUS-AREA, SRF-SPOOLER-REC,
      *      LANGUAGE-PARMS, SCREEN-BUFFER.
           IF VIEW-LASTKEY = 3 OR 7
               GO TO 6990-MAIN-X.
           IF VIEW-LASTKEY NOT = 0
      *        "INVALID FUNCTION KEY"
               MOVE 9 TO LANG-SETNUM
               MOVE 10 TO LANG-MSGNUM
               MOVE 09010 TO CATREAD-MSG-NUMBER
               MOVE 1 TO SRF-ERROR-FLD
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER TO SCREEN-1B-MSG-LINE2
               GO TO 6100-SHOW-FORM.

           MOVE DISPLAY-REC TO SCREEN-1B.

           MOVE 0 TO SUB.
       6100-DETERMINE-PLANT-LOOP.
           ADD 1 TO SUB.
           IF SUB > 7
               MOVE 7 TO VIEW-LASTKEY
               GO TO 6990-MAIN-X.

           IF PLANTX-MORE-INFO (SUB) = "X"
      *        "NOT STOCKED"
               MOVE 14 TO LANG-SETNUM
               MOVE 64 TO LANG-MSGNUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               IF MESSAGE-BUFFER = PLANTX-LOC1 (SUB)
      *            "STORES CODE DOES NOT EXIST"
                   MOVE 03 TO LANG-SETNUM
                   MOVE 97 TO LANG-MSGNUM
                   MOVE 03097 TO CATREAD-MSG-NUMBER
                   MOVE 1 TO SRF-ERROR-FLD
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE MESSAGE-BUFFER TO SCREEN-1B-MSG-LINE2
                   GO TO 6100-SHOW-FORM
               END-IF
      **       IF BASE-PLT(SUB) NOT = MPLTINFO-COMP
                   MOVE BASE-GROUP (SUB) TO RETURN-BASE
      **       ELSE
      **           MOVE SPACES TO RETURN-BASE
      **       END-IF
               GO TO 6990-MAIN-X.

           GO TO 6100-DETERMINE-PLANT-LOOP.

       6990-MAIN-X.
           CLOSE DISPLAY-FILE.
           GOBACK.

       9000-GET-EXP-DATE.
           MOVE 0 TO COND-WORD.
           MOVE ITM-PO-RCV-NO TO PORCVNO OF DPORECD-REC.
           START DPORECD KEY = PORCVNO OF DPORECD-REC
               INVALID KEY MOVE 17 TO COND-WORD.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
                   MOVE 17 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.
           IF COND-WORD NOT = 0
               MOVE SPACES TO PO-EXPECT-DATE-CN
               GO TO 9090-GED-X.

           MOVE 0 TO COND-WORD.
           READ DPORECD NEXT INTO BUF-DPORECD
               AT END MOVE 15 TO COND-WORD.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   MOVE 15 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.
           IF PORCVNO OF DPORECD-REC NOT = ITM-PO-RCV-NO
               MOVE 15 TO COND-WORD.
           IF COND-WORD NOT = 0
               MOVE SPACES TO PO-EXPECT-DATE-CN
               GO TO 9090-GED-X.

       9090-GED-X.
           EXIT.

216800 999-CATREAD.
           IF CATREAD-MSG-NUMBER = ZEROS
               MOVE LANG-SETNUM TO CATREAD-MSG-SET
               MOVE LANG-MSGNUM TO CATREAD-MSG-NUM.
           CALL "CCATREAD" USING CATREAD-PARMS.
           MOVE CATREAD-MSG-TEXT TO MESSAGE-BUFFER.
218000 999-CATREAD-EXIT.
218100     EXIT.
