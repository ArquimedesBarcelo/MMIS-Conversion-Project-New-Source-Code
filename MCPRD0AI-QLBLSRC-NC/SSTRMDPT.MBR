000200 IDENTIFICATION DIVISION.
000300 PROGRAM-ID.     SSTRMDPT.
000400 AUTHOR.         ANNETTE M. KRAUSS.
000700 INSTALLATION.   THE GOODYEAR TIRE AND RUBBER COMPANY - AKRON.
000500 DATE-WRITTEN.   JUNE 9, 1987.
000600 DATE-COMPILED.
000800*REMARKS.
000900**************************************************************
001000*                                                            *
001100*D   SSTRMDPT     STOREROOM DEPT SUBPROGRAM                  *
001200*D                                                           *
001300**************************************************************
001400 ENVIRONMENT DIVISION.
001500 CONFIGURATION SECTION.
001600 SOURCE-COMPUTER.  IBM-AS400.
001700 OBJECT-COMPUTER.  IBM-AS400.
       SPECIAL-NAMES. I-O-FEEDBACK IS I-O-FEEDBACK-AREA.
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT DISPLAY-FILE
                  ASSIGN TO WORKSTATION-ZPLTSTUP-SI
                  ORGANIZATION IS TRANSACTION
                  ACCESS IS SEQUENTIAL
                  FILE STATUS IS DISPLAY-STATUS
                  CONTROL-AREA IS WS-CONTROL.
           SELECT MPLTINFO-O
                  ASSIGN TO DATABASE-MCFLCS0501
                  ORGANIZATION IS INDEXED
                  ACCESS IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                  FILE STATUS IS FILE-STATUS.
001800
001900 DATA DIVISION.
       FILE SECTION.
       FD  DISPLAY-FILE
           LABEL RECORDS ARE OMITTED.
       01  DISPLAY-REC                      PIC X(2000).
       FD  MPLTINFO-O
           LABEL RECORDS ARE STANDARD.
       01  MPLTINFO-O-REC.
           COPY DDS-MCRPCS0500 OF MCFLCS0501.
002000 WORKING-STORAGE SECTION.
       01  FILE-STATUS.
           05  FILE-STATUS-1                PIC X VALUE SPACE.
           05  FILE-STATUS-2                PIC X VALUE SPACE.
002100
002300*************************************************************
002400**                                                         **
002500**              D A T A    B A S E    A R E A              **
002600**                                                         **
002700*************************************************************
002800*************************************************************
002900
003000 COPY MPLTINFO IN COPYLIB.
003100
004100 01  SAVE-STRMDEPT-AREA.
004200     05  S-STRMDEPT-TBL          PIC X(60) VALUE SPACES.
004300     05  SAVE-STRMDEPT-TABLE REDEFINES S-STRMDEPT-TBL
004400              OCCURS 6 TIMES.
004500         15  SAVE-STRMDEPT-NO    PIC X(4).
004600         15  SAVE-STRMDEPT-DATE  PIC X(6).
004700      05  SAVE-DSTR-FLAG         PIC X(3)  VALUE "NO ".
004800
004900 01  LAST-STRMDEPT-NO            PIC X(4).
005100 01  STRM-INDEX                  PIC 9(1).
005200 01  MPLTINFO-ARG                PIC X(4).
005500 COPY DBSTAT IN COPYLIB.
005900 01  MESSAGE-BUFFER.
006000     05  MSG-TEXT                    PIC X(64)  VALUE SPACES.
006100     05  MSG-FLD                     PIC X(12)  VALUE SPACES.
006200     05  MSG-FLD-9 REDEFINES MSG-FLD
006300                                     PIC Z(11)9.
007300*************************************************************
007400*************************************************************
007500**                                                         **
007600**                 TERMINAL I/O DATA AREA                  **
007700**                                                         **
007800*************************************************************
007900*************************************************************
008000
008100 01  STRMDEPT-SCREEN.
008200     05  STRMDEPT-TABLE.
008300         10  STRMDEPT-GENL OCCURS 6 TIMES.
008400             15  STRMDEPT-NO       PIC X(4).
008500             15  STRMDEPT-DATE     PIC X(6).
008600     05  SPACES-VALID              PIC X(1).
008700     05  STRMDEPT-MSGLINE          PIC X(79).
           05  CMDLINE                   PIC X(79).
           05  ERR-MSGLINE               PIC X(79).
008800
011700 COPY TBLOWUP IN COPYLIB.
       COPY CATREAD IN COPYLIB.
       COPY DISPDATA IN COPYLIB.
       COPY IOFEEDBACK IN COPYLIB.
011800
011900*************************************************************
012000*************************************************************
012100**                                                         **
012200**               LINKAGE   SECTION                         **
012300**                                                         **
012400*************************************************************
012500*************************************************************
012600
012700 LINKAGE SECTION.
012800
012900 01  BASE                          PIC X(10).
013000
013100 COPY VCOMLINK IN COPYLIB.
013200
013300 COPY LANGSUB IN COPYLIB.
013400
013500 01  TODAY-DATE                    PIC X(6).
013600
013700*************************************************************
013800**#########################################################**
013900*************************************************************
014000**                                                         **
014100**          P R O C E D U R E    D I V I S I O N           **
014200**                                                         **
014300*************************************************************
014400**#########################################################**
014500*************************************************************
014600
014700 PROCEDURE DIVISION USING BASE,
014800                          VIEW-COMAREA,
014900                          LANGUAGE-PARMS,
015000                          TODAY-DATE.
015100
015200
015300 MAIN-PGM SECTION 01.
015400
015500 BEGIN-HERE.
015600     PERFORM 1-HSK.
015700     PERFORM 6-MAIN THRU 6-MAIN-X.
015800     PERFORM 2-EOJ.
015900
016000 1-HSK.
016100     MOVE "SSTRMDPT" TO BU-PGM-NAME.
           OPEN I-O DISPLAY-FILE, MPLTINFO-O.
016200
016300 2-EOJ.
           CLOSE DISPLAY-FILE, MPLTINFO-O.
016400     GOBACK.
016500
016600******************************************************
016700**                 BLOWUP ROUTINE                   **
016800******************************************************
016900
017000 2-BLOWUP.
017100     CALL "TBLOWUP" USING BASE, BU-PGM-NAME, STATUS-AREA,
017200         VIEW-COMAREA, FILE-STATUS, BU-DISPLAY-MSG,
017300         BU-DISPLAY-AREA.
017400
021900**************************************************
022000*                                                *
022100*                  6 - M A I N                   *
022200*                                                *
022300**************************************************
022400
022500 6-MAIN.
022600     MOVE "STRMDEPT" TO VIEW-NFNAME.
024200
024300 6-READ-DATABASE.
024400     MOVE SPACES TO STRMDEPT-SCREEN.
024500     PERFORM 61-READ-MPLTINFO.
024600
024700 6-PUT-BUFFER.
024800
024900***  INPUT DATA ABOVE AND PRESS 'ENTER'  ***
025000     MOVE   9 TO LANG-SETNUM.
025100     MOVE  20 TO LANG-MSGNUM.
025200     PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
025300     MOVE MESSAGE-BUFFER TO STRMDEPT-MSGLINE.
026200
026300 6-SHOW-FORM.
           MOVE STRMDEPT-SCREEN TO DISPLAY-REC.
           PERFORM 998-WRITE-SCREEN THRU 998-READ-SCREEN.
           MOVE DISPLAY-REC     TO STRMDEPT-SCREEN.
026900
027000 6-READ-FIELDS.
027700     IF VIEW-LASTKEY = 3
027800         GO TO 6-MAIN-X.
028400     IF VIEW-LASTKEY = 1 OR
028500        VIEW-LASTKEY = 2 OR
028600        VIEW-LASTKEY = 4 OR
028700        VIEW-LASTKEY = 5 OR
028800        VIEW-LASTKEY = 6 OR
028900        VIEW-LASTKEY = 7 OR
              VIEW-LASTKEY = 8
029000*****    INVALID FUNCTION KEY    *****
029100         MOVE   9 TO LANG-SETNUM
029200         MOVE  10 TO LANG-MSGNUM
029300         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER TO ERR-MSGLINE
               MOVE B"1" TO IND(99)
029500         GO TO 6-SHOW-FORM.
029600
031700 6-REPLACE-MPLTINFO.
033400     MOVE "P 03" TO MPLTINFO-ARG, BU-DISPLAY-FLD (1).
           MOVE MPLTINFO-ARG TO PLTINFOKEY OF MPLTINFO-O-REC.
           READ MPLTINFO-O INTO BUF-MPLTINFO
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
033700     IF FILE-STATUS = "00"
033800         MOVE STRMDEPT-NO (1) TO MPLTINFO-STOREROOM
               REWRITE MPLTINFO-O-REC FROM BUF-MPLTINFO
                   INVALID KEY MOVE FILE-STATUS TO FILE-STATUS
               END-REWRITE
               IF FILE-STATUS NOT = "00"
034200             MOVE "1REWRITE ERROR IN 6-REPLACE-MPLTINFO"
034300                 TO BU-DISPLAY-MSG
034400         ELSE
034500             NEXT SENTENCE
034600     ELSE
034700     IF FILE-STATUS-1 = "2"
034800         MOVE SPACES          TO BUF-MPLTINFO
034900         MOVE "P 03"          TO MPLTINFO-KEY
035000         MOVE STRMDEPT-NO (1) TO MPLTINFO-STOREROOM
               WRITE MPLTINFO-O-REC FROM BUF-MPLTINFO
                  INVALID KEY MOVE FILE-STATUS TO FILE-STATUS
               END-WRITE
               IF FILE-STATUS NOT = "00"
035400             MOVE "1WRITE MPLTINFO ERROR IN 6-REPLACE-MPLTINFO"
035500                 TO BU-DISPLAY-MSG
035600             PERFORM 2-BLOWUP
035700         ELSE
035800             NEXT SENTENCE
035900     ELSE
036000         MOVE "1READ MPLTINFO ERROR IN 6-REPLACE-MPLTINFO"
036100             TO BU-DISPLAY-MSG
036200         PERFORM 2-BLOWUP.
036300
036400     MOVE "DSTR" TO MPLTINFO-ARG.
           MOVE MPLTINFO-ARG TO PLTINFOKEY OF MPLTINFO-O-REC.
           READ MPLTINFO-O INTO BUF-MPLTINFO
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
033700     IF FILE-STATUS = "00"
036800         MOVE 1     TO STRM-INDEX
036900         MOVE "YES" TO SAVE-DSTR-FLAG
037000         PERFORM 61-SAVE-DSTR UNTIL STRM-INDEX > 6
037100         MOVE 1     TO STRM-INDEX
037200         PERFORM 61-REPLACE-DSTR UNTIL STRM-INDEX > 6
               REWRITE MPLTINFO-O-REC FROM BUF-MPLTINFO
                   INVALID KEY MOVE FILE-STATUS TO FILE-STATUS
               END-REWRITE
               IF FILE-STATUS NOT = "00"
034200             MOVE "2REWRITE ERROR IN 6-REPLACE-MPLTINFO"
034300                 TO BU-DISPLAY-MSG
034400         ELSE
034500             NEXT SENTENCE
034600     ELSE
034700     IF FILE-STATUS-1 = "2"
038400          MOVE SPACES           TO BUF-MPLTINFO
038500          MOVE "DSTR"           TO MPLTINFO-KEY
038600          MOVE MPLTINFO-KEY     TO BU-DISPLAY-FLD (3)
038700          MOVE 1  TO STRM-INDEX
038800          PERFORM 61-ADD-DSTR UNTIL STRM-INDEX > 6
038900          MOVE MPLTINFO-KEY     TO BU-DISPLAY-FLD (4)
                WRITE MPLTINFO-O-REC FROM BUF-MPLTINFO
                  INVALID KEY MOVE FILE-STATUS TO FILE-STATUS
               END-WRITE
               IF FILE-STATUS NOT = "00"
035400             MOVE "2WRITE MPLTINFO ERROR IN 6-REPLACE-MPLTINFO"
035500                 TO BU-DISPLAY-MSG
035600             PERFORM 2-BLOWUP
035700         ELSE
035800             NEXT SENTENCE
035900     ELSE
036000         MOVE "2READ MPLTINFO ERROR IN 6-REPLACE-MPLTINFO"
036100             TO BU-DISPLAY-MSG
036200         PERFORM 2-BLOWUP.
042300
042400 6-MAIN-X.
042500     EXIT.
042600
042700 61-READ-MPLTINFO.
042800      MOVE "DSTR" TO MPLTINFO-ARG.
           MOVE MPLTINFO-ARG TO PLTINFOKEY OF MPLTINFO-O-REC.
           READ MPLTINFO-O INTO BUF-MPLTINFO
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS = "00"
043200          MOVE MPLTINFO-DEPT-STR (1) TO STRMDEPT-NO (1)
043300          MOVE MPLTINFO-STR-DATE (1) TO STRMDEPT-DATE (1)
043400          MOVE MPLTINFO-DEPT-STR (2) TO STRMDEPT-NO (2)
043500          MOVE MPLTINFO-STR-DATE (2) TO STRMDEPT-DATE (2)
043600          MOVE MPLTINFO-DEPT-STR (3) TO STRMDEPT-NO (3)
043700          MOVE MPLTINFO-STR-DATE (3) TO STRMDEPT-DATE (3)
043800          MOVE MPLTINFO-DEPT-STR (4) TO STRMDEPT-NO (4)
043900          MOVE MPLTINFO-STR-DATE (4) TO STRMDEPT-DATE (4)
044000          MOVE MPLTINFO-DEPT-STR (5) TO STRMDEPT-NO (5)
044100          MOVE MPLTINFO-STR-DATE (5) TO STRMDEPT-DATE (5)
044200          MOVE MPLTINFO-DEPT-STR (6) TO STRMDEPT-NO (6)
044300          MOVE MPLTINFO-STR-DATE (6) TO STRMDEPT-DATE (6)
044400     ELSE
044500     IF FILE-STATUS-1 NOT = "2"
044600         MOVE "READ ERROR IN 61-READ-MPLTINFO"
044700             TO BU-DISPLAY-MSG
044800         MOVE "DSTR" TO BU-DISPLAY-FLD (1)
044900         PERFORM 2-BLOWUP.
      *------- DO A START > HIGH-VALUES TO UNLOCK
           MOVE HIGH-VALUES TO PLTINFOKEY OF MPLTINFO-O-REC.
           START MPLTINFO-O KEY > PLTINFOKEY OF MPLTINFO-O-REC
               INVALID KEY MOVE "00" TO FILE-STATUS.
045000
045100 61-SAVE-DSTR.
045200     MOVE MPLTINFO-DEPT-STR (STRM-INDEX) TO
045300           SAVE-STRMDEPT-NO (STRM-INDEX).
045400     MOVE MPLTINFO-STR-DATE (STRM-INDEX) TO
045500           SAVE-STRMDEPT-DATE (STRM-INDEX).
045600     ADD 1 TO STRM-INDEX.
045700
045800 61-REPLACE-DSTR.
045900     IF STRMDEPT-NO (STRM-INDEX) =  SAVE-STRMDEPT-NO (STRM-INDEX)
046000       AND SAVE-DSTR-FLAG = "YES"
046100          IF STRMDEPT-NO (STRM-INDEX) = SPACES AND
046200           SPACES-VALID = "N"
046300               MOVE LAST-STRMDEPT-NO TO
046400                             MPLTINFO-DEPT-STR (STRM-INDEX)
046500               MOVE TODAY-DATE TO
046600                             MPLTINFO-STR-DATE (STRM-INDEX)
046700           ELSE
046800               MOVE SAVE-STRMDEPT-NO (STRM-INDEX) TO
046900                              MPLTINFO-DEPT-STR (STRM-INDEX),
047000                              LAST-STRMDEPT-NO
047100               MOVE SAVE-STRMDEPT-DATE (STRM-INDEX) TO
047200                              MPLTINFO-STR-DATE (STRM-INDEX)
047300     ELSE
047400         IF STRMDEPT-NO (STRM-INDEX) = SPACES
047500             IF SPACES-VALID = "Y"
047600                 MOVE SPACES TO MPLTINFO-DEPT-STR (STRM-INDEX)
047700                 MOVE TODAY-DATE TO
047800                               MPLTINFO-STR-DATE (STRM-INDEX)
047900             ELSE
048000                 MOVE LAST-STRMDEPT-NO TO
048100                               MPLTINFO-DEPT-STR (STRM-INDEX)
048200                 MOVE TODAY-DATE TO
048300                               MPLTINFO-STR-DATE (STRM-INDEX)
048400         ELSE
048500             MOVE STRMDEPT-NO (STRM-INDEX) TO
048600                                 MPLTINFO-DEPT-STR (STRM-INDEX),
048700                                 LAST-STRMDEPT-NO
048800             MOVE TODAY-DATE  TO MPLTINFO-STR-DATE (STRM-INDEX).
048900
049000     ADD 1 TO STRM-INDEX.
049100
049200 61-ADD-DSTR.
049300     IF STRMDEPT-NO (STRM-INDEX) = SPACES
049400         IF SPACES-VALID = "Y"
049500             MOVE SPACES TO MPLTINFO-DEPT-STR (STRM-INDEX)
049600             MOVE TODAY-DATE TO
049700                           MPLTINFO-STR-DATE (STRM-INDEX)
049800         ELSE
049900             MOVE LAST-STRMDEPT-NO TO
050000                           MPLTINFO-DEPT-STR (STRM-INDEX)
050100             MOVE TODAY-DATE TO
050200                           MPLTINFO-STR-DATE (STRM-INDEX)
050300     ELSE
050400         MOVE STRMDEPT-NO (STRM-INDEX) TO
050500                             MPLTINFO-DEPT-STR (STRM-INDEX),
050600                             LAST-STRMDEPT-NO
050700         MOVE TODAY-DATE  TO MPLTINFO-STR-DATE (STRM-INDEX).
050800
050900     ADD 1 TO STRM-INDEX.
051000
       COPY DISPCALL IN COPYLIB.
051100*********************************************************
051200 999-CATREAD.
           IF CATREAD-MSG-NUMBER = ZEROS
               MOVE LANG-SETNUM TO CATREAD-MSG-SET
               MOVE LANG-MSGNUM TO CATREAD-MSG-NUM.
           CALL "CCATREAD" USING CATREAD-PARMS.
           MOVE CATREAD-MSG-TEXT TO MESSAGE-BUFFER.
052900 999-CATREAD-EXIT.
053000     EXIT.
