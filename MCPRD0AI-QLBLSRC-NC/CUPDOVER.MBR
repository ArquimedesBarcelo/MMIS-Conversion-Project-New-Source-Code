013400
013500 LINKAGE SECTION.
013600
013700 01  BASE                          PIC X(10).
013800
013900 01  AKRON-WS-RCD.
014000     05  FILLER                    PIC X(1).
014100     05  WS-TC                     PIC X(2).
014200         88 ADD-OVERAGE            VALUE "31".
014300         88 DELETE-OVERAGE         VALUE "32".
014400     05  WS-PLT                    PIC X(3).
014500     05  WS-CORPCODE               PIC X(7).
014600     05  WS-FROM-PLT               PIC X(3).
014700     05  WS-QUANTITY               PIC S9(8).
014800     05  WS-PRICE                  PIC S9(11)V9(4).
014900     05  WS-UM                     PIC X(2).
015000     05  WS-CUR-CODE               PIC X(2).
015100     05  FILLER                    PIC X(90).
015200
015300  01 SAVE-PLT-AREA.
015400     05  SAVE-PLT-LINE OCCURS 10 TIMES.
015500         10  SAVE-PLT              PIC X(3).
015600     05  SAVE-STR-DEPT             PIC X(4).
015700     05  SAVE-RECV-DEPT            PIC X(4).
015800     05  TOTAL-COST                PIC 9(14)V9(4).
015900     05  FIRST-TIME-FLAG           PIC X(1).
016000     05  SAVE-PO-PREFIX            PIC X(5).
016100     05  FILLER                    PIC X(29).
016200
016300
016400 PROCEDURE DIVISION USING          BASE,
016500                                   AKRON-WS-RCD,
016600                                   SAVE-PLT-AREA.
016700
016800 1000-START.
           PERFORM 9999-OPEN-STUFF.
016900     MOVE "1"                      TO   SAVE-PARA.
017000     IF FIRST-TIME-FLAG NOT = "N"
017100         MOVE "N"                  TO   FIRST-TIME-FLAG
017200         MOVE ZERO                 TO   TOTAL-COST.
017300
017400     IF SAVE-STR-DEPT = SPACES
017500         MOVE "P 03"               TO   PLT-ARG
017600         PERFORM 9999-DBGET7-MPLTINFO-PK-I
017700         MOVE MPLTINFO-STOREROOM   TO   SAVE-STR-DEPT
017800         MOVE MPLTINFO-RECV-DEPT   TO   SAVE-RECV-DEPT
017900         MOVE "ITOV"               TO   PLT-ARG
018000         PERFORM 9999-DBGET7-MPLTINFO-PK-I
018100         IF GOOD-CALL
018200             MOVE MPLTINFO-DATA    TO   SAVE-PO-PREFIX
018300         ELSE
018400             MOVE "PITOV"          TO   SAVE-PO-PREFIX.
018500
018600     MOVE SAVE-PO-PREFIX           TO   PO-ARG-PREFIX.
018700     MOVE WS-FROM-PLT              TO   PO-ARG-PLT,
018800                                        VEN-ARG-PLT.
018900
019000     PERFORM 6000-MAIN THRU 6990-MAIN-X.
           PERFORM 9999-CLOSE-STUFF.
019100     GOBACK.
019200
019300 2100-BLOWUP.
019400     MOVE "CUPDOVER"               TO   BU-PGM-NAME.
019500     MOVE SAVE-PARA                TO   BU-DISPLAY-PARA.
019600     MOVE CODE-ARG                 TO   BU-DISPLAY-FLD (1).
019700     MOVE PO-ARG                   TO   BU-DISPLAY-FLD (2).
019800     MOVE BUYER-ARG                TO   BU-DISPLAY-FLD (3).
019900     MOVE VEN-ARG                  TO   BU-DISPLAY-FLD (4).
020000     MOVE PLT-ARG             TO   BU-DISPLAY-FLD (5).
020100     CALL "TBLOWUP" USING BASE BU-PGM-NAME STATUS-AREA
020200       DUMMY-VIEW-AREA FILE-STATUS BU-DISPLAY-MSG
020300       BU-DISPLAY-FLDS.
020400
020500
020600 6000-MAIN.
020700     MOVE "2"                      TO   SAVE-PARA.
020800     MOVE WS-CORPCODE              TO   CODE-ARG.
020900     PERFORM 9999-DBGET7-MSTORERM-CD-I.
021000     IF NOT GOOD-CALL
021100*****----DISPLAY "CUPDOVER *** CODE ", CODE-ARG,
021200*****-------" FROM PLANT ", WS-FROM-PLT,
021300*****-------" DOES NOT EXIST ***"
021400         GO TO 6990-MAIN-X.
021500
021600*------ THE REQUIREMENT ORDER AND VENDOR FOR THAT PLANT WILL BE
021700*------ ADDED IF NOT ALREADY THERE.  ONLY CHECK ONCE FOR EACH
021800*------ PLANT CODE ENCOUNTERED TO SAVE ON DISC IO.
021900     PERFORM 7000-CHECK-PLANT THRU 7090-CP-X.
022000     IF ALREADY-CHECKED-FLAG = "N"
022100         PERFORM 7100-CHECK-PO-VENDOR-BUYER THRU 7190-CPV-X.
022200
022300*------ NOW SEE IF THE CODE IS ALREADY ON THE PO.
022400     MOVE "N"                      TO   IN-BATCH-FILE-FLAG.
022500     PERFORM 7200-CHECK-ON-PO THRU 7290-COP-X.
022600     IF ON-PO-FLAG = "Y"
022700         IF DELETE-OVERAGE
022800             PERFORM 7900-CHECK-IN-BATCH THRU 7990-CIB-X
022900             IF IN-BATCH-FILE
023000*****------------DISPLAY "CUPDOVER NOT DELETING ITEM ", HOLD-ITEM,
023100*****-------------" CD ", WS-CORPCODE, " PO ", PO-ARG,
023200*****-------------": IN BATCH FILE"
023300                 MOVE ZERO         TO   WS-QUANTITY
023400                 PERFORM 7400-UPDATE-ITEM THRU 7490-UI-X
023500             ELSE
023600                 PERFORM 7300-DELETE-ITEM THRU 7390-DI-X
023700         ELSE
023800             PERFORM 7400-UPDATE-ITEM THRU 7490-UI-X
023900     ELSE
024000     IF DELETE-OVERAGE
024100*****----DISPLAY "CUPDOVER DELETE FOR CODE ", WS-CORPCODE,
024200*****------" ON PO ", PO-ARG, ": NOT ON PO"
024500         PERFORM 7800-DELETE-DATAITM THRU 7890-DD-X
024300         GO TO 6990-MAIN-X
024400     ELSE
024500         PERFORM 7600-FIND-EMPTY-ITEM THRU 7690-FEI-X
024600         PERFORM 7500-ADD-ITEM THRU 7590-AI-X.
024700
024800 6990-MAIN-X.
024900     GOBACK.
025000
025100 7000-CHECK-PLANT.
025200     MOVE "3"                      TO   SAVE-PARA.
025300     MOVE "N"                      TO   ALREADY-CHECKED-FLAG.
025400     MOVE ZERO                     TO   SUB.
025500     PERFORM UNTIL SUB = 10 OR ALREADY-CHECKED-FLAG = "Y"
025600         ADD 1 TO SUB
025700         IF SAVE-PLT (SUB) = WS-FROM-PLT
025800             MOVE "Y" TO ALREADY-CHECKED-FLAG
025900         END-IF
026000     END-PERFORM.
026100 7090-CP-X.
026200     EXIT.
026300
026400 7100-CHECK-PO-VENDOR-BUYER.
026500     MOVE "4"                      TO   SAVE-PARA.
026600*------ MUST CHECK VEN 1ST, ELSE DPORECD WOULD ADD AUTO MASTER
026700     PERFORM 9999-DBFIND-DVENDOR-VN-O.
           PERFORM 9999-DBGET5-DVENDOR-VN-O.
026800     IF NOT GOOD-CALL
026900*****----DISPLAY "CUPDOVER ADDING VENDOR ", VEN-ARG
027000         PERFORM 7120-ADD-VENDOR
           ELSE
               PERFORM 9999-RESET-DVENDOR-VN-O.
027100     PERFORM 9999-DBGET7-MPORCV-PO-O.
027200     IF NOT GOOD-CALL
027300*****----DISPLAY "CUPDOVER ADDING PO ", PO-ARG
027400         PERFORM 7110-ADD-PO.
027500
027600     MOVE "OVER"                   TO   BUYER-ARG.
027700     PERFORM 9999-DBGET7-MBUYER-BY-O.
027800     IF NOT GOOD-CALL
027900         MOVE "OVER"               TO   BUYER-CODE
028000         MOVE "GOODYR OVERAGE"     TO   BUYER-NAME
028100         MOVE "MBUYER;"            TO   DSET-NAME
028200*****----DISPLAY "CUPDOVER ADDING BUYER 'OVER'"
028300         PERFORM 9930-LOCK
028400         PERFORM 9999-DBPUT-MBUYER-BY-O
028500         PERFORM 9940-UNLOCK.
028600
028700     GO TO 7190-CPV-X.
028800
028900 7110-ADD-PO.
029000     MOVE "5"                      TO   SAVE-PARA.
029100     MOVE SPACES                   TO   BUF-MPORCV.
029200     MOVE PO-ARG                   TO   M-PO-RCV-NO.
029300     MOVE "B000"                   TO   M-PO-RCV-STAT.
029400     MOVE "MPORCV;"                TO   DSET-NAME.
029500     PERFORM 9930-LOCK.
029600     PERFORM 9999-DBPUT-MPORCV-PO-O.
029700     PERFORM 9940-UNLOCK.
029800
029900     MOVE SPACES                   TO   BUF-DPORECD.
030000     MOVE PO-ARG                   TO   PO-RCV-NO.
030100     MOVE SAVE-STR-DEPT            TO   PO-FOR-DEPT.
030200     MOVE SAVE-RECV-DEPT           TO   PO-RCV-DEPT.
030300     CALL "TDATECHK" USING DATE-CHECK-AREA.
030400     MOVE DATE-YMD-OUT             TO   PO-DATE.
           IF PO-DATE-YY > "70"
               MOVE "19" TO PO-DATE-CC
           ELSE
               MOVE "20" TO PO-DATE-CC.
030500     MOVE "99991231"                 TO   PO-EXPECT-DATE-CN.
030600
030700     MOVE "P 01"                   TO   PLT-ARG.
030800     PERFORM 9999-DBGET7-MPLTINFO-PK-I.
030900
031000     MOVE MPLTINFO-COMPANY         TO   PO-CO.
031100     MOVE MPLTINFO-PRIME           TO   PO-PRIME.
031200     MOVE STR-CLASS                TO   PO-SUB.
031300     MOVE PO-FOR-DEPT              TO   PO-SUB-DET.
031400     MOVE "000000"                 TO   PO-ADDL-DATA.
031500     MOVE PO-CO                    TO   BUILD-BUDGET-REST.
031600     MOVE BUILD-BUDGET-NUMBER      TO   PO-BUDGET-NUMBER.
031700     MOVE ZERO                     TO   PO-BUDGET-AMT.
031800     MOVE "1A"                     TO   PO-TERMS.
031900     MOVE "OVER"                   TO   PO-BUYER,
032000                                        PO-BUYER-CODE.
032100     MOVE "AKR"                    TO   PO-TYPIST.
032200     MOVE "BEST WAY"               TO   PO-VIA.
032300     MOVE "SP"                     TO   PO-FOB.
032400     MOVE VEN-ARG                  TO   PO-VEN-CODE.
032500     MOVE WS-CUR-CODE              TO   PO-CURRENCY-CODE.
032600
032700     PERFORM 9931-LOCK-DPORECD.
032800     PERFORM 9999-DBPUT-DPORECD-PO-O.
032900     PERFORM 9940-UNLOCK.
033000
033100 7120-ADD-VENDOR.
033200     MOVE "6"                      TO   SAVE-PARA.
033300     PERFORM 9932-LOCK-DVENDOR.
033400     MOVE SPACES                   TO   BUF-DVENDOR.
033500     MOVE VEN-ARG                  TO   VEN-VEN-CODE.
033600     MOVE ZERO                     TO   VEN-ITM-NO.
033700     MOVE "THE GOODYEAR TIRE & RUBBER COMPANY"
033800                                   TO   VEN-ITM-DATA.
033900     PERFORM 9999-DBPUT-DVENDOR-VN-O.
034000     MOVE 1                        TO   VEN-ITM-NO.
034100     MOVE SPACES                   TO   VEN-ITM-DATA.
034200     STRING "PLANT " DELIMITED BY SIZE,
034300            PO-CO DELIMITED BY SIZE
034400       INTO VEN-ITM-DATA.
034500     PERFORM 9999-DBPUT-DVENDOR-VN-O.
034600     PERFORM 9940-UNLOCK.
034700
034800 7190-CPV-X.
034900     EXIT.
035000
035100 7200-CHECK-ON-PO.
035200     MOVE "7"                      TO   SAVE-PARA.
035300     MOVE "N"                      TO   ON-PO-FLAG.
035400*------ GO DOWN CODE CHAIN WHICH SHOULD BE SHORTER
035500     PERFORM 9999-DBFIND-DPOITEM-CD-O.
035600
035700     MOVE SPACES                   TO   ITM-PO-RCV-NO.
035800     PERFORM UNTIL (NOT GOOD-CALL) OR ITM-PO-RCV-NO = PO-ARG
035900         PERFORM 9999-DBGET5-DPOITEM-CD-O
036000     END-PERFORM.
036100
036200     IF GOOD-CALL
036300         MOVE "Y"                  TO   ON-PO-FLAG
036400         MOVE ITM-NUMBER           TO   HOLD-ITEM-X.
036500
036600 7290-COP-X.
036700     EXIT.
036800
036900 7300-DELETE-ITEM.
037000     MOVE "8"                      TO   SAVE-PARA.
037100*****DISPLAY "CUPDOVER DELETING ITEM ", HOLD-ITEM,
037200*****--" CODE ", WS-CORPCODE, " FROM PO ", PO-ARG.
024500     PERFORM 7800-DELETE-DATAITM THRU 7890-DD-X.
037300     PERFORM 9933-LOCK-DPOITEM.
037400     PERFORM 9999-DBDELETE-DPOITEM-CD-O.
037500     PERFORM 9940-UNLOCK.
037600 7390-DI-X.
037700
037800 7400-UPDATE-ITEM.
037900     MOVE "9"                      TO   SAVE-PARA.
038000*****DISPLAY "CUPDOVER UPDATING ITEM ", ITM-NUMBER,
038100*****--" CODE ", WS-CORPCODE, " ON PO ", PO-ARG.

038500     PERFORM 7800-DELETE-DATAITM THRU 7890-DD-X.

038200     IF WS-UM = STR-UM OR STR-UM1 OR STR-UM2
038300         NEXT SENTENCE
038400     ELSE
038600         PERFORM 7700-ADD-DATAITM THRU 7790-AD-X
038700         MOVE STR-UM               TO   WS-UM.
038800
038900     PERFORM 9933-LOCK-DPOITEM.
039000*------ NOTE: IF WE PUT THE QTY AVAIL AT THE OVERAGE PLANT IN
039100*------ ITM-QTY-ORD, IT WOULD SHOW UP AS ONORDER FOR THE CODE,
039200*------ SO WE PUT IT IN ITM-QTY-PAID, WHICH IS ZEROED OUT ON
039300*------ A RELEASE
039400     MOVE WS-QUANTITY              TO   ITM-QTY-PAID.

039500*------ THE FOLLOWING FIXES A BUG: DEPT/EXP DT WERE NULL
039600     MOVE SAVE-STR-DEPT            TO   ITM-SUB-DETL.
039700     MOVE "99991231"               TO   ITM-EXPECT-DATE-CN.

      *------ IF DELETE-OVERAGE IS TRUE, WE HAVE BEEN FORCED TO UPDATE
      *------ A DPOITEM ENTRY INSTEAD OF DELETING IT BECAUSE THIS ITEM
      *------ IS CURRENTLY IN THE SHIPPING RELEASE BATCH FILE.
      *------ IN THIS CASE, WE HAVE SET THE QTY TO ZERO ABOVE AND WE
      *------ LEAVE THE PRICE AND UM FIELDS ALONE (THE INPUT FILE TO
      *------ THIS PGM FROM THE MAINFRAME CONTAINS ALL ZEROES ON A
      *------ DELETE TRANSACTION, SO WE CANNOT USE THEM).
      *------
      *------ IF DELETE-OVERAGE IS FALSE, WE ARE SIMPLY UPDATING AN
      *------ EXISTING DPOITEM ENTRY.  HERE WE WILL UPDATE THE PRICE
      *------ AND THE 2 UM FIELDS.
           IF DELETE-OVERAGE
               NEXT SENTENCE
           ELSE
               MOVE WS-PRICE             TO   ITM-UNIT-PRICE
               MOVE WS-UM                TO   ITM-PRICE-UM
                                              ITM-UM.

040600     PERFORM 9999-DBUPDATE-DPOITEM-CD-O.
040700     PERFORM 9940-UNLOCK.
040800 7490-UI-X.
040900     EXIT.
041000
041100 7500-ADD-ITEM.
041200     MOVE "10"                     TO   SAVE-PARA.
041300     MULTIPLY WS-PRICE BY WS-QUANTITY GIVING HOLD-EXTENDED-COST.
041400     MOVE HOLD-EXTENDED-COST       TO   DISPLAY-COST.
041500     ADD HOLD-EXTENDED-COST        TO   TOTAL-COST.
041600     MOVE TOTAL-COST               TO   DISPLAY-TOTAL-COST.
041700
041800*****DISPLAY "CUPDOVER ADD ", HOLD-ITEM,
041900*****--" CD ", WS-CORPCODE, " PO ", PO-ARG,
042000*****--" COST ", DISPLAY-COST, " TOT ", DISPLAY-TOTAL-COST.

042100     IF WS-UM = STR-UM OR STR-UM1 OR STR-UM2
042200         NEXT SENTENCE
042300     ELSE
042400         PERFORM 7700-ADD-DATAITM THRU 7790-AD-X
042500         MOVE STR-UM               TO   WS-UM.
042600
042700     MOVE SPACES                   TO   BUF-DPOITEM.
042800     MOVE WS-CORPCODE              TO   ITM-CORP-CODE.
042900     MOVE HOLD-ITEM                TO   ITM-NUMBER.
043000     MOVE WS-UM                    TO   ITM-UM.
043100     MOVE WS-QUANTITY              TO   ITM-QTY-PAID.
043200     MOVE ZERO                     TO   ITM-QTY-ORD,
043300                                        ITM-QTY-DLVR,
043400                                        ITM-QTY-STORED.
043500     MOVE WS-UM                    TO   ITM-PRICE-UM.
043600     MOVE WS-PRICE                 TO   ITM-UNIT-PRICE.
043700     MOVE STR-CLASS                TO   ITM-CLASS.
043800     MOVE SAVE-STR-DEPT            TO   ITM-SUB-DETL.
043900     MOVE "000000"                 TO   ITM-ADDL-DATA.
044000     MOVE PO-ARG                   TO   ITM-PO-RCV-NO.
044100     MOVE ZERO                     TO   ITM-WT.
044200     MOVE "99991231"               TO   ITM-EXPECT-DATE-CN.
044300     MOVE "NO"                     TO   ITM-TAX-CODE.
044400     MOVE "1A"                     TO   ITM-TERMS.
044500     MOVE "SP"                     TO   ITM-FOB.
044600     MOVE ZERO                     TO   ITM-KELLY-PO-QTY.
044700     MOVE ZERO                     TO   ITM-ZBILL-VALUE.
           MOVE ZERO                     TO   ITM-ASN-QTY.
044800
044900     PERFORM 9933-LOCK-DPOITEM.
045000
045100     PERFORM 9999-DBPUT-DPOITEM-CD-O.
045200     PERFORM 9940-UNLOCK.
045300
045400 7590-AI-X.
045500     EXIT.
045600
045700 7600-FIND-EMPTY-ITEM.
045800     MOVE "11"                     TO   SAVE-PARA.
045900     MOVE ZERO                     TO   HOLD-ITEM.
046000     MOVE "0000"                   TO   ITM-NUMBER.
046100     PERFORM 9999-DBFIND-DPOITEM-PO-I.
046200
046300*------ THIS LOOP WILL EITHER FIND A GAP IN THE ITEMS OF THE PO,
046400*------ OR IF NO GAPS, THE NEXT ITEM OF THE PO.
046500     PERFORM UNTIL (NOT GOOD-CALL) OR HOLD-ITEM-X < ITM-NUMBER
046600         PERFORM 9999-DBGET5-DPOITEM-PO-I
046700         ADD 1                     TO   HOLD-ITEM
046800     END-PERFORM.
046900
047000 7690-FEI-X.
047100     EXIT.
047200
047300 7700-ADD-DATAITM.
047400     MOVE "12"                     TO   SAVE-PARA.
047500     MOVE SPACES                   TO   BUF-DPODATAITM.
047600     MOVE PO-ARG                   TO   DATAITM-PO-RCV-NO.
047700     MOVE HOLD-ITEM                TO   DATAITM-ITEM-NO.
047800     MOVE "01"                     TO   DATAITM-LINE-NO.
047900     STRING "*** BAD UM - PLANT " DELIMITED BY SIZE,
048000            WS-FROM-PLT DELIMITED BY SIZE,
048100            " USED FOLLOWING UNIT OF MEASURE: "
048200              DELIMITED BY SIZE,
048300            WS-UM DELIMITED BY SIZE,
048400            " ***" DELIMITED BY SIZE
048500       INTO DATAITM-INFO.

048600*****DISPLAY "CUPDOVER *** BAD UM FROM PLT ", WS-FROM-PLT,
048700*****--" WAS ", WS-UM, ", SUBSTITUTING ", STR-UM, " ***".

048800     PERFORM 9934-LOCK-DPODATAITM.
048900     PERFORM 9999-DBPUT-DPODATAITM-PO-O.
049000     PERFORM 9940-UNLOCK.
049100 7790-AD-X.
049200     EXIT.
049300
049400 7800-DELETE-DATAITM.
049500     MOVE "13"                     TO   SAVE-PARA.
049600     PERFORM 9934-LOCK-DPODATAITM.
049700     PERFORM 9999-DBFIND-DPODATAITM-PO-O.
049800     PERFORM UNTIL (NOT GOOD-CALL)
049900         PERFORM 9999-DBGET5-DPODATAITM-PO-O
050000         IF DATAITM-ITEM-NO = ITM-NUMBER AND GOOD-CALL
050100             PERFORM 9999-DBDELETE-DPODATAITM-PO-O
050200         END-IF
050300     END-PERFORM.
050400     PERFORM 9940-UNLOCK.
050500 7890-DD-X.
050600     EXIT.
050700
050800 7900-CHECK-IN-BATCH.
050900     MOVE "14"                     TO   SAVE-PARA.
051000     PERFORM 9999-INIT-DSHIPREL-DT-I.
051100     MOVE ZERO                     TO   COND-WORD.
051200     MOVE SPACES                   TO   DREL-DSHIPREL-CODE.
051300     PERFORM UNTIL NOT GOOD-CALL
051400     OR DREL-DSHIPREL-CODE = WS-CORPCODE
051500         PERFORM 9999-DBGET2-DSHIPREL-DT-I
051600     END-PERFORM.
051700
051800     IF DREL-DSHIPREL-CODE = WS-CORPCODE
051900         MOVE "Y"                  TO   IN-BATCH-FILE-FLAG.
052000
052100 7990-CIB-X.
052200     EXIT.
052300
       9930-LOCK.
       9931-LOCK-DPORECD.
       9932-LOCK-DVENDOR.
       9933-LOCK-DPOITEM.
       9934-LOCK-DPODATAITM.
       9940-UNLOCK.
       9999-DBFIND-DVENDOR-VN-O.
           MOVE 0 TO COND-WORD.
           MOVE VEN-ARG TO VENCDE OF DVENDOR-VN-REC-O.
           START DVENDOR-VN-O KEY = VENCDE OF DVENDOR-VN-REC-O
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF (FILE-STATUS NOT = "00") AND (FILE-STATUS-1 NOT = "2")
               MOVE "DBFIND ERR 9999-DBFIND-DVENDOR-VN-O"
                   TO BU-MSG-AREA
               MOVE 99 TO COND-WORD
               PERFORM 2100-BLOWUP.

       9999-DBGET5-DVENDOR-VN-O.
           MOVE 0 TO COND-WORD.
           READ DVENDOR-VN-O NEXT INTO BUF-DVENDOR
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14"
                   PERFORM 9999-RESET-DVENDOR-VN-O
                   MOVE 15 TO COND-WORD
               ELSE
               IF FILE-STATUS = "46"
                   MOVE 15 TO COND-WORD
               ELSE
                   MOVE "DBGET5 ERR 9999-DBGET5-DVENDOR-VN-O"
                       TO BU-MSG-AREA
                   MOVE 99 TO COND-WORD
                   PERFORM 2100-BLOWUP
           ELSE
           IF VENCDE OF DVENDOR-VN-REC-O NOT = VEN-ARG
               PERFORM 9999-RESET-DVENDOR-VN-O
               MOVE 15 TO COND-WORD.

       9999-RESET-DVENDOR-VN-O.
           MOVE HIGH-VALUES TO VENCDE OF DVENDOR-VN-REC-O.
           START DVENDOR-VN-O KEY > VENCDE OF DVENDOR-VN-REC-O
               INVALID KEY MOVE "00" TO FILE-STATUS.

       9999-DBGET7-MPORCV-PO-O.
           MOVE 0 TO COND-WORD.
           MOVE PO-ARG TO PORCVNO OF MPORCV-PO-REC-O.
           READ MPORCV-PO-O INTO BUF-MPORCV
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS = "23"
               MOVE 17 TO COND-WORD
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE "DBGET7 ERR 9999-DBGET7-MPORCV-PO-O"
                   TO BU-MSG-AREA
               MOVE 99 TO COND-WORD
               PERFORM 2100-BLOWUP.

       9999-RESET-MPORCV-PO-O.
           MOVE HIGH-VALUES TO PORCVNO OF MPORCV-PO-REC-O.
           START MPORCV-PO-O KEY > PORCVNO OF MPORCV-PO-REC-O
               INVALID KEY MOVE "00" TO FILE-STATUS.

       9999-DBGET7-MBUYER-BY-O.
           MOVE 0 TO COND-WORD.
           MOVE BUYER-ARG TO BUYERCDE OF MBUYER-BY-REC-O.
           READ MBUYER-BY-O INTO BUF-MBUYER
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS = "23"
               MOVE 17 TO COND-WORD
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE "DBGET7 ERR 9999-DBGET7-MBUYER-BY-O"
                   TO BU-MSG-AREA
               MOVE 99 TO COND-WORD
               PERFORM 2100-BLOWUP.

       9999-RESET-MBUYER-BY-O.
           MOVE HIGH-VALUES TO BUYERCDE OF MBUYER-BY-REC-O.
           START MBUYER-BY-O KEY > BUYERCDE OF MBUYER-BY-REC-O
               INVALID KEY MOVE "00" TO FILE-STATUS.

       9999-DBGET7-MPLTINFO-PK-I.
           MOVE 0 TO COND-WORD.
           MOVE PLT-ARG TO PLTINFOKEY OF MPLTINFO-PK-REC-I.
           READ MPLTINFO-PK-I INTO BUF-MPLTINFO
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS = "23"
               MOVE 17 TO COND-WORD
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE "DBGET7 ERR 9999-DBGET7-MPLTINFO-PK-I"
                   TO BU-MSG-AREA
               MOVE 99 TO COND-WORD
               PERFORM 2100-BLOWUP.

       9999-DBPUT-DPORECD-PO-O.
           MOVE 0 TO COND-WORD.
           WRITE DPORECD-PO-REC-O FROM BUF-DPORECD
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE "DBPUT ERR 9999-DBPUT-DPORECD-PO-O"
                   TO BU-MSG-AREA
               MOVE 99 TO COND-WORD
               PERFORM 2100-BLOWUP.

       9999-DBPUT-DVENDOR-VN-O.
           MOVE 0 TO COND-WORD.
           WRITE DVENDOR-VN-REC-O FROM BUF-DVENDOR
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE "DBPUT ERR 9999-DBPUT-DVENDOR-VN-O"
                   TO BU-MSG-AREA
               MOVE 99 TO COND-WORD
               PERFORM 2100-BLOWUP.

       9999-DBFIND-DPOITEM-CD-O.
           MOVE 0 TO COND-WORD.
           MOVE CODE-ARG TO CORPCDE OF DPOITEM-CD-REC-O.
           START DPOITEM-CD-O KEY = CORPCDE OF DPOITEM-CD-REC-O
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF (FILE-STATUS NOT = "00") AND (FILE-STATUS-1 NOT = "2")
               MOVE "DBFIND ERR 9999-DBFIND-DPOITEM-CD-O"
                   TO BU-MSG-AREA
               MOVE 99 TO COND-WORD
               PERFORM 2100-BLOWUP.

       9999-DBGET5-DPOITEM-CD-O.
           MOVE 0 TO COND-WORD.
           READ DPOITEM-CD-O NEXT INTO BUF-DPOITEM
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14"
                   PERFORM 9999-RESET-DPOITEM-CD-O
                   MOVE 15 TO COND-WORD
               ELSE
               IF FILE-STATUS = "46"
                   MOVE 15 TO COND-WORD
               ELSE
                   MOVE "DBGET5 ERR 9999-DBGET5-DPOITEM-CD-O"
                       TO BU-MSG-AREA
                   MOVE 99 TO COND-WORD
                   PERFORM 2100-BLOWUP
           ELSE
           IF CORPCDE OF DPOITEM-CD-REC-O NOT = CODE-ARG
               PERFORM 9999-RESET-DPOITEM-CD-O
               MOVE 15 TO COND-WORD.

       9999-RESET-DPOITEM-CD-O.
           MOVE HIGH-VALUES TO CORPCDE OF DPOITEM-CD-REC-O.
           START DPOITEM-CD-O KEY > CORPCDE OF DPOITEM-CD-REC-O
               INVALID KEY MOVE "00" TO FILE-STATUS.

       9999-DBDELETE-DPOITEM-CD-O.
           MOVE 0 TO COND-WORD.
           DELETE DPOITEM-CD-O
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE "DBDELETE ERR 9999-DBDELETE-DPOITEM-CD-O"
                   TO BU-MSG-AREA
               MOVE 99 TO COND-WORD
               PERFORM 2100-BLOWUP.

       9999-DBUPDATE-DPOITEM-CD-O.
           MOVE 0 TO COND-WORD.
           REWRITE DPOITEM-CD-REC-O FROM BUF-DPOITEM
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE "DBUPDATE ERR 9999-DBUPDATE-DPOITEM-CD-O"
                   TO BU-MSG-AREA
               MOVE 99 TO COND-WORD
               PERFORM 2100-BLOWUP.

       9999-DBPUT-DPOITEM-CD-O.
           MOVE 0 TO COND-WORD.
           WRITE DPOITEM-CD-REC-O FROM BUF-DPOITEM
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE "DBPUT ERR 9999-DBPUT-DPOITEM-CD-O"
                   TO BU-MSG-AREA
               MOVE 99 TO COND-WORD
               PERFORM 2100-BLOWUP.

       9999-DBFIND-DPOITEM-PO-I.
           MOVE 0 TO COND-WORD.
           MOVE PO-ARG TO PORCVNO OF DPOITEM-PO-REC-I.
           START DPOITEM-PO-I KEY = PORCVNO OF DPOITEM-PO-REC-I
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF (FILE-STATUS NOT = "00") AND (FILE-STATUS-1 NOT = "2")
               MOVE "DBFIND ERR 9999-DBFIND-DPOITEM-PO-I"
                   TO BU-MSG-AREA
               MOVE 99 TO COND-WORD
               PERFORM 2100-BLOWUP.

       9999-DBGET5-DPOITEM-PO-I.
           MOVE 0 TO COND-WORD.
           READ DPOITEM-PO-I NEXT INTO BUF-DPOITEM
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   MOVE 15 TO COND-WORD
               ELSE
                   MOVE "DBGET5 ERR 9999-DBGET5-DPOITEM-PO-I"
                       TO BU-MSG-AREA
                   MOVE 99 TO COND-WORD
                   PERFORM 2100-BLOWUP
           ELSE
           IF PORCVNO OF DPOITEM-PO-REC-I NOT = PO-ARG
               MOVE 15 TO COND-WORD.

       9999-DBPUT-DPODATAITM-PO-O.
           MOVE 0 TO COND-WORD.
           WRITE DPODATAITM-PO-REC-O FROM BUF-DPODATAITM
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE "DBPUT ERR 9999-DBPUT-DPODATAITM-PO-O"
                   TO BU-MSG-AREA
               MOVE 99 TO COND-WORD
               PERFORM 2100-BLOWUP.

       9999-DBFIND-DPODATAITM-PO-O.
           MOVE 0 TO COND-WORD.
           MOVE PO-ARG TO PORCVNO OF DPODATAITM-PO-REC-O.
           START DPODATAITM-PO-O KEY = PORCVNO OF DPODATAITM-PO-REC-O
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF (FILE-STATUS NOT = "00") AND (FILE-STATUS-1 NOT = "2")
               MOVE "DBFIND ERR 9999-DBFIND-DPODATAITM-PO-O"
                   TO BU-MSG-AREA
               MOVE 99 TO COND-WORD
               PERFORM 2100-BLOWUP.

       9999-DBGET5-DPODATAITM-PO-O.
           MOVE 0 TO COND-WORD.
           READ DPODATAITM-PO-O NEXT INTO BUF-DPODATAITM
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14"
                   PERFORM 9999-RESET-DPODATAITM-PO-O
                   MOVE 15 TO COND-WORD
               ELSE
               IF FILE-STATUS = "46"
                   MOVE 15 TO COND-WORD
               ELSE
                   MOVE "DBGET5 ERR 9999-DBGET5-DPODATAITM-PO-O"
                       TO BU-MSG-AREA
                   MOVE 99 TO COND-WORD
                   PERFORM 2100-BLOWUP
           ELSE
           IF PORCVNO OF DPODATAITM-PO-REC-O NOT = PO-ARG
               PERFORM 9999-RESET-DPODATAITM-PO-O
               MOVE 15 TO COND-WORD.

       9999-RESET-DPODATAITM-PO-O.
           MOVE HIGH-VALUES TO PORCVNO OF DPODATAITM-PO-REC-O.
           START DPODATAITM-PO-O KEY > PORCVNO OF DPODATAITM-PO-REC-O
               INVALID KEY MOVE "00" TO FILE-STATUS.

       9999-DBGET2-DSHIPREL-DT-I.
           MOVE 0 TO COND-WORD.
           READ DSHIPREL-DT-I NEXT INTO BUF-DSHIPREL
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS-1 = "1" OR FILE-STATUS = "46"
               MOVE 11 TO COND-WORD
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE "DBGET2 ERR 9999-DBGET2-DSHIPREL-DT-I"
                   TO BU-MSG-AREA
               MOVE 99 TO COND-WORD
               PERFORM 2100-BLOWUP.

       9999-INIT-DSHIPREL-DT-I.
           MOVE SPACES TO DATECYMD OF DSHIPREL-DT-REC-I.
           START DSHIPREL-DT-I KEY >= DATECYMD OF DSHIPREL-DT-REC-I
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.

       9999-DBGET7-MSTORERM-CD-I.
           MOVE 0 TO COND-WORD.
           MOVE CODE-ARG TO CORPCDE OF MSTORERM-CD-REC-I.
           READ MSTORERM-CD-I INTO BUF-MSTORERM
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS = "23"
               MOVE 17 TO COND-WORD
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD.

       9999-DBPUT-MBUYER-BY-O.
           MOVE 0 TO COND-WORD.
           WRITE MBUYER-BY-REC-O FROM BUF-MBUYER
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD.

       9999-DBPUT-MPORCV-PO-O.
           MOVE 0 TO COND-WORD.
           WRITE MPORCV-PO-REC-O FROM BUF-MPORCV
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD.

       9999-DBDELETE-DPODATAITM-PO-O.
           MOVE 0 TO COND-WORD.
           DELETE DPODATAITM-PO-O
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD.

       9999-OPEN-STUFF.
           OPEN INPUT MSTORERM-CD-I.
           OPEN I-O   DVENDOR-VN-O         .
           OPEN I-O   MPORCV-PO-O          .
           OPEN I-O   MBUYER-BY-O          .
           OPEN INPUT MPLTINFO-PK-I        .
           OPEN I-O   DPORECD-PO-O         .
           OPEN I-O   DPOITEM-CD-O         .
           OPEN INPUT DPOITEM-PO-I         .
           OPEN I-O   DPODATAITM-PO-O      .
           OPEN INPUT DSHIPREL-DT-I        .

       9999-CLOSE-STUFF.
           CLOSE      MSTORERM-CD-I.
           CLOSE      DVENDOR-VN-O         .
           CLOSE      MPORCV-PO-O          .
           CLOSE      MBUYER-BY-O          .
           CLOSE      MPLTINFO-PK-I        .
           CLOSE      DPORECD-PO-O         .
           CLOSE      DPOITEM-CD-O         .
           CLOSE      DPOITEM-PO-I         .
           CLOSE      DPODATAITM-PO-O      .
           CLOSE      DSHIPREL-DT-I        .
052500************************************************************************
