       IDENTIFICATION DIVISION.
       PROGRAM-ID.             TMASTER.
       AUTHOR.                 R L ENSMINGER.
       INSTALLATION.           GOODYEAR TIRE & RUBBER CO.
       DATE-COMPILED.
       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.
       SOURCE-COMPUTER.        IBM-AS400.
       OBJECT-COMPUTER.        IBM-AS400.

       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT DISPLAY-FILE
                  ASSIGN       TO WORKSTATION-ZMASTER-SI
                  ORGANIZATION IS TRANSACTION
                  ACCESS MODE  IS SEQUENTIAL
                  FILE STATUS  IS SCREEN-STATUS
                  CONTROL-AREA IS SCREEN-CONTROL.

       DATA DIVISION.
       FILE SECTION.
       FD  DISPLAY-FILE
           LABEL RECORDS       ARE OMITTED.
       01  DISPLAY-REC         PIC X(2000).

       WORKING-STORAGE SECTION.
       01  PASSWORD-INFORMATION.
           05  NAME-OF-PROGRAM PIC X(08) VALUE "TMASTER ".
           05  PROGRAM-TYPE    PIC X(02) VALUE "MA".
           05  PROGRAM-RELEASE PIC X(12) VALUE " K0100010001".
           05  PROGRAM-DESCRIPTION.
               10  PROG-DESC-A PIC X(60) VALUE
                  "MAINT PROGRAM FOR MMIS DATAMASE MAINTENANCE.    "   .
               10  PROG-DESC-B PIC X(60) VALUE
                  "  (THIS IS OLD 'XDBMAINT' ON THE HP SYSTEM)     "   .
               10  PROG-FUNC   PIC X(60) VALUE SPACES.
           05  PASSWORD-FLAG   PIC X.

       01  SCREEN-DATA.
           05  CMDMSG          PIC X(79).
           05  ERRMSG          PIC X(79).

           COPY SCREENIO       OF COPYLIB.

       PROCEDURE DIVISION.
       OPEN-PAR.
           OPEN I-O            DISPLAY-FILE.

           CALL "TPWORD" USING PASSWORD-INFORMATION.
           IF PASSWORD-FLAG = "N"
               GO TO END-OF-JOB.

       SHOW-SCREEN.
           MOVE "MAIN_MENU"    TO SCREEN-NAME.
           MOVE SPACES         TO SCREEN-DATA.

       SHOWFORM.
           MOVE "00"           TO SCREEN-STATUS.
           MOVE SCREEN-DATA    TO DISPLAY-REC.

           WRITE DISPLAY-REC   FORMAT IS SCREEN-NAME
                               INDIC ARE SCREEN-INDICATORS.
           IF SCREEN-STATUS NOT = "00"
               DISPLAY "SCREEN WRITE ERROR.  SCREEN-STATUS IS "
                               SCREEN-STATUS
               GO TO END-OF-JOB.

           READ DISPLAY-FILE   FORMAT IS SCREEN-NAME
                               INDIC ARE SCREEN-INDICATORS
           IF SCREEN-STATUS NOT = "00"
               DISPLAY "SCREEN READ ERROR.  SCREEN-STATUS IS "
                               SCREEN-STATUS
               GO TO END-OF-JOB.

           MOVE ALL B"0"       TO SCREEN-INDICATORS.

           IF KEY-HIT = 1
               CALL "TMCRAFT".

           IF KEY-HIT = 2
               CALL "TMCREW".

           IF KEY-HIT = 3
               GO TO END-OF-JOB.

           IF KEY-HIT = 4
               CALL "TMEQP".

           IF KEY-HIT = 5
               GO TO SHOWFORM.

           IF KEY-HIT = 6
               CALL "TDBMZPRT".

           IF KEY-HIT = 7
               CALL "TMLOCALP".

           IF KEY-HIT = 8
               CALL "TMZSHIFT".

           IF KEY-HIT = 9
               CALL "TMSUBSYS".

           IF KEY-HIT = 10
               CALL "TMZONEP".

           GO TO SHOWFORM.

       END-OF-JOB.
           CLOSE               DISPLAY-FILE.
           GOBACK.

