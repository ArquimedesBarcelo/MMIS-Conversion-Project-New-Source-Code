000200 IDENTIFICATION DIVISION.
000300 PROGRAM-ID.    TREQRCVR.
000500 AUTHOR.        KURT MOVSESIAN/JIM COFFMAN (MAINTAINER).
000800
000900**************************************************************
001000*                                                            *
001100*D  T R E Q R C V R    THIS PROGRAMS PLACES ALL THE ENTRIES  *
001200*D    IN 'RQ2FILE' BACK IN THE DATA SET 'MREQFILE'. THIS     *
001300*D    PROGRAN IS USED FOR RECOVERY PURPOSES IN CASE THE      *
001400*D    REQUSITION CREATE PROGRAM 'TREQ' BLOWS DOWN BEFORE     *
001500*D    COMPLETELY PROCESSING THE 'RQ2FILE'.  A OVERRIDE       *
001600*     STATEMENT 'OVRDBF FILE(REQRCVR) TOFILE(MCPRD1/RQ2FILE)"*
001700*     IS REQUIRED TO POINT TO THE CORRECT FILE.              *
001800**************************************************************
001900
002000
002100
002200 ENVIRONMENT DIVISION.
002300 CONFIGURATION SECTION.
002400 SOURCE-COMPUTER.  HP-3000.
002500 OBJECT-COMPUTER.  HP-3000.
002600
002700 INPUT-OUTPUT SECTION.
002800 FILE-CONTROL.
002900     SELECT REQ-FILE ASSIGN TO DISK-REQRCVR.
003000
           SELECT MREQFILE-O
                  ASSIGN TO DATABASE-MCFLCS2801
                  ORGANIZATION IS INDEXED
                    ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                  FILE STATUS IS FILE-STATUS.
003100
003200 DATA DIVISION.
003300 FILE SECTION.
003400
003500 FD  REQ-FILE
003600     LABEL RECORDS ARE OMITTED
003700     RECORD CONTAINS 21 CHARACTERS.
003800 01  REQ-RCD.
003900     05  REQ-CORP-CODE.
004000         10  REQ-CODE-1-2         PIC X(2).
004100         10  REQ-CODE-3-7         PIC X(5).
004200     05  REQ-RETURN-SW            PIC X(2).
004300     05  REQ-NUM-MMIS             PIC X(12).
004400
       FD  MREQFILE-O
           LABEL RECORDS ARE STANDARD.
       01  MREQFILE-REC-O.
           COPY DDS-ALL-FORMATS  OF MCFLCS2801.

004500 WORKING-STORAGE SECTION.
       01  FILE-STATUS.
           05  FILE-STATUS-1            PIC X  VALUE "0".
           05  FILE-STATUS-2            PIC X  VALUE "0".
004600 77  SUB                          PIC S9(4) COMP-4 VALUE ZEROS.
004700
004800 01  ABC-LIST.
004900     05  FILLER                   PIC X(1) VALUE "A".
005000     05  FILLER                   PIC X(1) VALUE "B".
005100     05  FILLER                   PIC X(1) VALUE "C".
005200     05  FILLER                   PIC X(1) VALUE "D".
005300     05  FILLER                   PIC X(1) VALUE "E".
005400     05  FILLER                   PIC X(1) VALUE "F".
005500     05  FILLER                   PIC X(1) VALUE "G".
005600     05  FILLER                   PIC X(1) VALUE "H".
005700     05  FILLER                   PIC X(1) VALUE "I".
005800     05  FILLER                   PIC X(1) VALUE "J".
005900 01  ABC-TABLE REDEFINES ABC-LIST.
006000     05  ABC-LETTER OCCURS 10 TIMES  PIC X(1).
006100
006200
006300**************************************************************
006400**************************************************************
006500**                                                          **
006600**                DATABASE I/O BUFFER AREA                  **
006700**                                                          **
006800**************************************************************
006900**************************************************************
007000
007100 COPY MREQFILE IN COPYLIB.
007400
007500*********************
007600*                   *
007700*   DATA SET NAMES  *
007800*                   *
007900*********************
008000
008100 01  DSET-NAMES.
008300     05  DSET-MREQFILE          PIC X(16)  VALUE "MREQFILE;".
008500
008600 COPY DATAB    IN COPYLIB.
009100
009200 COPY TBLOWUP  IN COPYLIB.
009300
009400
009500 PROCEDURE DIVISION.
009600
009700 PROC-DIV SECTION 01.
009800
009900
010000 1-BEGIN.
010100     PERFORM 1-HSK THRU 1-H-X.
010200
010300     PERFORM 6-MAIN THRU 6-M-X.
010400
010500     PERFORM 2-EOJ  THRU 2-EOJ-X.
010600
010700     GOBACK.
010800
010900
011000
011100 1-HSK.
           OPEN I-O MREQFILE-O.
011600
011700 1-H-X.
011800     EXIT.
011900
012000
012100 2-EOJ.
           CLOSE MREQFILE-O.
012600
012700 2-EOJ-X.
012800     EXIT.
012900
013000*********************************************
013100*                                           *
013200*  BLOWUP ROUTINE EXECUTES WHENEVER A       *
013300*  FATAL ERROR OCCURS                       *
013400*                                           *
013500*********************************************
013600
013700 2-BLOWUP.
013800     MOVE  "TREQRCVR"     TO  BU-PGM-NAME.
013900     CALL "TBLOWUP" USING BASE, BU-PGM-NAME, STATUS-AREA,
014000         DUMMY-VIEW-AREA, FILE-STATUS, BU-DISPLAY-MSG,
014100                 BU-DISPLAY-FLDS.
014200
014300 2-BLOWUP-X.
014400     EXIT.
014500
014600
014700**************************************************
014800*                                                *
014900*     6 - M A I N                                *
015000*                                                *
015100**************************************************
015200
015300
015400 6-MAIN.
015500     OPEN INPUT REQ-FILE.
015600     PERFORM 61-READ-MREQFILE  THRU  61-RM-X.
015700     CLOSE REQ-FILE.
015800
015900 6-M-X.
016000     EXIT.
016100
016200
016300 61-READ-MREQFILE.
017100     READ REQ-FILE AT END
017200         GO TO 61-RM-X.
017300     MOVE ZEROS                   TO  SUB.
017400     MOVE SPACES                  TO  BUF-MREQFILE.
017500     MOVE REQ-CORP-CODE           TO  MREQFILE-CORP-CODE.
017600     MOVE REQ-RETURN-SW           TO  MREQFILE-REQ-STATUS.
017700     MOVE REQ-NUM-MMIS            TO  MREQFILE-REQ-NUM-MMIS.
017800
017900 61-PUT-MREQFILE.
           WRITE MREQFILE-REC-O FROM BUF-MREQFILE
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
018400             ADD 1                TO SUB
018500             IF SUB > 10
018600                 MOVE "PUT MREQFILE SUB>10*61-GM"
018700                                  TO BU-DISPLAY-MSG
018800                 GO TO 2-BLOWUP
018900             ELSE
019000                 MOVE ABC-LETTER (SUB) TO MREQFILE-CORP-CODE-8
019100                 GO TO 61-PUT-MREQFILE
019200         ELSE
019300             MOVE "PUT MREQFILE*61-GM" TO BU-DISPLAY-MSG
019400             GO TO 2-BLOWUP.
019500
019600     GO TO 61-READ-MREQFILE.
019700
020500 61-RM-X.
020600     EXIT.
