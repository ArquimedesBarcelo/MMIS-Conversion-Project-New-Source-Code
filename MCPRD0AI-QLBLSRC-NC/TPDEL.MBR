       IDENTIFICATION DIVISION.
       PROGRAM-ID.    TPDEL.
       INSTALLATION.  GOODYEAR.
      *REMARKS.
      *        ########################################################
      *        #  This is the personnel main delete program ........  #
      *        #  --------------------------------------------------  #
      *        ########################################################.
      *C 09/09/96  JEFF BUNGO
      *C   EXPAND DATE FIELDS FOR YEAR 2000 COMPLIANCE.
      *C   RECOMPILE TO PICK UP COPYLIB CHANGES.
      *C
       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.
       SOURCE-COMPUTER.      AS400.
       OBJECT-COMPUTER.      AS400.
       SPECIAL-NAMES.      I-O-FEEDBACK IS I-O-FEEDBACK-AREA
                           LOCAL-DATA IS LOCAL-DATA-AREA.
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT DISPLAY-FILE
               ASSIGN TO WORKSTATION-ZPERSON-SI
               ORGANIZATION IS TRANSACTION
               ACCESS IS SEQUENTIAL
               FILE STATUS IS DSPLY-STATUS
               CONTROL-AREA IS WS-CONTROL.
           SELECT PER-ABSENCE
               ASSIGN TO DATABASE-MCFLMM3101
               ORGANIZATION IS INDEXED
               ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                   WITH DUPLICATES
               FILE STATUS IS PA-STATUS.
           SELECT PER-CONFIDENTIAL
               ASSIGN TO DATABASE-MCFLMM3301
               ORGANIZATION IS INDEXED
               ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                   WITH DUPLICATES
               FILE STATUS IS PC-STATUS.
           SELECT PER-FREE
               ASSIGN TO DATABASE-MCFLMM3201
               ORGANIZATION IS INDEXED
               ACCESS IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
               FILE STATUS IS PFC-STATUS.
           SELECT PERSONNEL-FILE
               ASSIGN TO DATABASE-MCFLMM0301
               ORGANIZATION IS INDEXED
               ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
               FILE STATUS IS PF-STATUS.
       DATA DIVISION.
       FILE SECTION.
       FD  DISPLAY-FILE
           LABEL RECORDS ARE OMITTED.
       01  DSPLY-REC                   PIC X(2000).
       FD  PER-ABSENCE
           LABEL RECORDS ARE STANDARD
           DATA RECORD IS PAREC.
       01  PAREC.
           COPY DDS-ALL-FORMATS OF MCFLMM3101.
       FD  PER-CONFIDENTIAL
           LABEL RECORDS ARE STANDARD
           DATA RECORD IS PCREC.
       01  PCREC.
           COPY DDS-ALL-FORMATS OF MCFLMM3301.
       FD  PER-FREE
           LABEL RECORDS ARE STANDARD
           DATA RECORD IS PFCREC.
       01  PFCREC.
           COPY DDS-ALL-FORMATS OF MCFLMM3201.
       FD  PERSONNEL-FILE
           LABEL RECORDS ARE STANDARD
           DATA RECORD IS PFREC.
       01  PFREC.
           COPY DDS-ALL-FORMATS OF MCFLMM0301.
       WORKING-STORAGE SECTION.
       01  ABS-KEY.
           05  ABS-CC                   PIC X(4).
           05  ABS-YR                   PIC XX.
       01  BLOWUP-BASE                  PIC X(16).
       COPY CATREAD OF COPYLIB.
       01  CC-SW                        PIC X.
       COPY CPYIND  OF COPYLIB.
       01  DATA-SW                      PIC X.
       01  DD-SW                        PIC X.
       01  ERROR-BUFFER                 PIC X(80).
       01  FILE-STATUSES.
           05  DSPLY-STATUS             PIC XX.
           05  PA-STATUS                PIC XX.
           05  PC-STATUS                PIC XX.
           05  PF-STATUS                PIC XX.
           05  PFC-STATUS               PIC XX.
       COPY IOFEEDBACK OF COPYLIB.
       01  PASSWORD-INFORMATION.
           05  NAME-OF-PROGRAM     PIC X(08) VALUE "TPDEL   ".
           05  PROGRAM-TYPE        PIC X(02) VALUE "MA".
           05  PROGRAM-RELEASE     PIC X(12) VALUE " E0100010001".
           05  PROGRAM-DESCRIPTION.
               10  PROG-DESC-A     PIC X(60) VALUE
                   "PERSONNEL DELETE CONTROL PROGRAM "                 .
               10  PROG-DESC-B     PIC X(60) VALUE SPACES.
               10  PROG-FUNCTION   PIC X(60) VALUE SPACES.
           05  PASSWORD-FLAG       PIC X.
       01  PER-ABSENCE-DATA.            COPY DPERABS  OF COPYLIB.
       01  PER-CONFIDENTIAL-DATA.       COPY DPERCONF OF COPYLIB.
       01  PER-FREE-WS.                 COPY DPERFREE OF COPYLIB.
       01  PER-PERSONNEL.               COPY MPERSONL OF COPYLIB.
       01  RETURN-SW                    PIC X.
       01  S1                           PIC S9(4) COMP-4.
       01  SAVE-KEY                     PIC S9(4) COMP-4.
       01  SCREEN-D.
           05  YR-FIELD                 PIC XX.
           05  PG-FIELD                 PIC XX.
           05  CC-FIELD                 PIC X(4).
           05  SCREEN-CMD-LINE          PIC X(79).
           05  SCREEN-ERR-LINE          PIC X(79).
       COPY DBSTAT IN COPYLIB.
       COPY TBLOWUP IN COPYLIB.
       01  TRUE-VAL                     PIC 1 VALUE B"1".
       01  YEAR-TABLE.
           05 YEAR-TAB OCCURS 3 TIMES   PIC XX.
       COPY WSCONTROL OF COPYLIB.
       LINKAGE SECTION.
       01  DBPARAMETERS.                COPY DBPARMS OF COPYLIB.
       COPY VCOMLINK IN COPYLIB.
       01  PLT-IDT                      PIC X(4).
       PROCEDURE DIVISION USING DBPARAMETERS
                                VIEW-COMAREA
                                PLT-IDT.
       BEGIN-PGM.
           PERFORM 1-HSK.
           PERFORM 6-MAIN THRU 6-MAIN-CONT UNTIL VIEW-LASTKEY = 3.
       2-EOJ.
           CLOSE DISPLAY-FILE.
           CLOSE PER-ABSENCE.
           CLOSE PER-CONFIDENTIAL.
           CLOSE PER-FREE.
           CLOSE PERSONNEL-FILE.
           GOBACK.
       1-HSK.
           OPEN I-O   DISPLAY-FILE.
           OPEN I-O   PER-ABSENCE.
           OPEN I-O   PER-CONFIDENTIAL.
           OPEN I-O   PER-FREE.
           OPEN I-O   PERSONNEL-FILE.
           CALL "TPWORD" USING PASSWORD-INFORMATION.
           IF PASSWORD-FLAG = "N" GO TO 2-EOJ.
           MOVE SPACES TO ERROR-BUFFER SCREEN-D.
       6-MAIN.
           MOVE "FPDEL" TO VIEW-CFNAME.
           IF INDS (99) = TRUE-VAL
               MOVE ERROR-BUFFER TO SCREEN-ERR-LINE.
           MOVE SCREEN-D TO DSPLY-REC.
           PERFORM 99-SCREEN-WRITE.
           PERFORM 98-SCREEN-READ.
           MOVE DSPLY-REC TO SCREEN-D.
           IF VIEW-LASTKEY = 3 GO TO 2-EOJ.
           MOVE VIEW-LASTKEY TO SAVE-KEY.
           MOVE 0 TO COND-WORD.
           MOVE CC-FIELD TO PERCCNUM OF PFREC.
           START PERSONNEL-FILE KEY IS = EXTERNALLY-DESCRIBED-KEY
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF PF-STATUS NOT = "00" MOVE 17 TO COND-WORD.
           IF COND-WORD = 0
               MOVE "Y" TO CC-SW
               READ PERSONNEL-FILE NEXT INTO PER-PERSONNEL
                   AT END    MOVE 15 TO COND-WORD.
           IF COND-WORD = 15 OR 17
               MOVE "N" TO CC-SW
           ELSE
           MOVE "Y" TO CC-SW.
           IF CC-SW = "Y"
               IF PER-CC-NUM OF PER-PERSONNEL = "9999"
                   GO TO 2-EOJ.
           MOVE "N" TO DATA-SW.
           IF PER-YEAR1 = SPACES
               IF CC-SW = "Y"
                   MOVE "XX" TO PER-YEAR1.
           IF PER-YEAR2 = SPACES
               IF CC-SW = "Y"
                   MOVE "XX" TO PER-YEAR2.
           IF PER-YEAR3 = SPACES
               IF CC-SW = "Y"
                   MOVE "XX" TO PER-YEAR3.
           IF SAVE-KEY = 1
               IF CC-SW = "Y"
                   MOVE "N" TO DD-SW
                   CALL "TPDEL1" USING DBPARAMETERS VIEW-COMAREA
                                   PLT-IDT PER-PERSONNEL DD-SW DATA-SW
                                   SCREEN-D
                   MOVE SPACES TO SCREEN-CMD-LINE
                   IF DD-SW = "Y"
                       MOVE PER-YEAR1 TO YEAR-TAB (1)
                       MOVE PER-YEAR2 TO YEAR-TAB (2)
                       MOVE PER-YEAR3 TO YEAR-TAB (3)
                       MOVE 66205 TO CATREAD-MSG-NUMBER
                       PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                       MOVE ERROR-BUFFER TO SCREEN-CMD-LINE
                       MOVE SCREEN-D TO DSPLY-REC
                       MOVE TRUE-VAL TO INDS (98)
                       PERFORM 99-SCREEN-WRITE
                       PERFORM 98A-SCREEN-READ
                       CALL "CLPAUSE2"
                       PERFORM 60-DEL-ABSENCE VARYING S1 FROM 1 BY 1
                           UNTIL S1 > 3
                       MOVE "AL" TO PG-FIELD
                       MOVE 66206 TO CATREAD-MSG-NUMBER
                       PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                       MOVE ERROR-BUFFER TO SCREEN-CMD-LINE
                       MOVE SCREEN-D TO DSPLY-REC
                       MOVE TRUE-VAL TO INDS (98)
                       PERFORM 99-SCREEN-WRITE
                       PERFORM 98A-SCREEN-READ
                       CALL "CLPAUSE2"
                       PERFORM 61-DEL-TRAINING THRU 61-DT-EXIT
                       MOVE 66207 TO CATREAD-MSG-NUMBER
                       PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                       MOVE ERROR-BUFFER TO SCREEN-CMD-LINE
                       MOVE SCREEN-D TO DSPLY-REC
                       MOVE TRUE-VAL TO INDS (98)
                       PERFORM 99-SCREEN-WRITE
                       PERFORM 98A-SCREEN-READ
                       CALL "CLPAUSE2"
                       PERFORM 62-DEL-CONF THRU 62-DC-EXIT
                       PERFORM 63-DEL-MASTER THRU 63-DM-EXIT
                       GO TO 6-MAIN-CONT
                   ELSE
                   GO TO 6-MAIN-CONT
               ELSE
               MOVE 29023 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE TRUE-VAL TO INDS (1) INDS (99)
               GO TO 6-MAIN.
           IF SAVE-KEY = 2
             IF CC-SW = "Y"
               IF YR-FIELD = "AL" OR PER-YEAR1 OR PER-YEAR2 OR PER-YEAR3
                 IF YR-FIELD = "AL"
                   MOVE PER-YEAR1 TO YEAR-TAB (1)
                   MOVE PER-YEAR2 TO YEAR-TAB (2)
                   MOVE PER-YEAR3 TO YEAR-TAB (3)
                   MOVE 66205 TO CATREAD-MSG-NUMBER
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE ERROR-BUFFER TO SCREEN-CMD-LINE
                   MOVE SCREEN-D TO DSPLY-REC
                   MOVE TRUE-VAL TO INDS (98)
                   PERFORM 99-SCREEN-WRITE
                   PERFORM 98A-SCREEN-READ
                   CALL "CLPAUSE2"
                   PERFORM 60-DEL-ABSENCE VARYING S1 FROM 1 BY 1
                       UNTIL S1 > 3
                   GO TO 6-MAIN-CONT
                 ELSE
                 MOVE 1 TO S1
                 MOVE YR-FIELD  TO YEAR-TAB (1)
                 MOVE 66205 TO CATREAD-MSG-NUMBER
                 PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                 MOVE ERROR-BUFFER TO SCREEN-CMD-LINE
                 MOVE SCREEN-D TO DSPLY-REC
                 MOVE TRUE-VAL TO INDS (98)
                 PERFORM 99-SCREEN-WRITE
                 PERFORM 98A-SCREEN-READ
                 CALL "CLPAUSE2"
                 PERFORM 60-DEL-ABSENCE
                 GO TO 6-MAIN-CONT
               ELSE
               MOVE 35032 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE TRUE-VAL TO INDS (1) INDS (99)
               GO TO 6-MAIN
             ELSE
             MOVE 29023 TO CATREAD-MSG-NUMBER
             PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
             MOVE TRUE-VAL TO INDS (3) INDS (99)
             GO TO 6-MAIN.
           IF SAVE-KEY = 4
             IF CC-SW = "Y"
               IF PG-FIELD = "AL"  OR
                  (PG-FIELD > "00" AND PG-FIELD < "11")
                 MOVE 66206 TO CATREAD-MSG-NUMBER
                 PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                 MOVE ERROR-BUFFER TO SCREEN-CMD-LINE
                 MOVE SCREEN-D TO DSPLY-REC
                 MOVE TRUE-VAL TO INDS (98)
                 PERFORM 99-SCREEN-WRITE
                 PERFORM 98A-SCREEN-READ
                 CALL "CLPAUSE2"
                 PERFORM 61-DEL-TRAINING THRU 61-DT-EXIT
                 GO TO 6-MAIN-CONT
               ELSE
               MOVE 35057 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE TRUE-VAL TO INDS (2) INDS (99)
               GO TO 6-MAIN
             ELSE
             MOVE 29023 TO CATREAD-MSG-NUMBER
             PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
             MOVE TRUE-VAL TO INDS (1) INDS (99)
             GO TO 6-MAIN.
           IF SAVE-KEY = 5
             IF CC-SW = "Y"
               MOVE 66207 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE ERROR-BUFFER TO SCREEN-CMD-LINE
               MOVE SCREEN-D TO DSPLY-REC
               MOVE TRUE-VAL TO INDS (98)
               PERFORM 99-SCREEN-WRITE
               PERFORM 98A-SCREEN-READ
               CALL "CLPAUSE2"
               PERFORM 62-DEL-CONF THRU 62-DC-EXIT
               GO TO 6-MAIN-CONT
             ELSE
             MOVE 29023 TO CATREAD-MSG-NUMBER
             PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
             MOVE TRUE-VAL TO INDS (3) INDS (99)
             GO TO 6-MAIN.
       6-MAIN-CONT.
           IF DATA-SW = "N"
             MOVE 40007 TO CATREAD-MSG-NUMBER
             PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
             MOVE ERROR-BUFFER TO SCREEN-CMD-LINE
             MOVE SCREEN-D TO DSPLY-REC
             MOVE TRUE-VAL TO INDS (98)
             PERFORM 99-SCREEN-WRITE
             PERFORM 98A-SCREEN-READ
             CALL "CLPAUSE2"
             GO TO 6-MAIN.
           MOVE SPACES TO SCREEN-D.
           MOVE PER-CC-NUM TO CC-FIELD.
           MOVE 29043 TO CATREAD-MSG-NUMBER.
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
           MOVE ERROR-BUFFER TO SCREEN-CMD-LINE.
           MOVE SCREEN-D TO DSPLY-REC.
           MOVE TRUE-VAL TO INDS (98).
           PERFORM 99-SCREEN-WRITE.
           PERFORM 98A-SCREEN-READ.
           CALL "CLPAUSE2".
       60-DEL-ABSENCE.
           MOVE CC-FIELD TO ABS-CC.
           MOVE YEAR-TAB (S1) TO ABS-YR.
           PERFORM 69-START-PER-ABSENCE.
           IF COND-WORD = 0
               PERFORM 69-READ-PER-ABSENCE
               IF COND-WORD = 15
                   NEXT SENTENCE
               ELSE
               MOVE "Y" TO DATA-SW
               PERFORM 60-DEL-ABSENCE-CONT
               IF COND-WORD = 17
                   NEXT SENTENCE
               ELSE
               PERFORM 60A-DEL-YEAR
               GO TO 60-DEL-ABSENCE.
       60-DEL-ABSENCE-CONT.
           MOVE 0 TO COND-WORD.
           DELETE PER-ABSENCE RECORD
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF PA-STATUS NOT = "00" MOVE 17 TO COND-WORD.
       60A-DEL-YEAR.
           IF PER-YEAR1 = YEAR-TAB (S1) MOVE SPACES TO PER-YEAR1
           ELSE
           IF PER-YEAR2 = YEAR-TAB (S1) MOVE SPACES TO PER-YEAR2
           ELSE
           IF PER-YEAR3 = YEAR-TAB (S1) MOVE SPACES TO PER-YEAR3.
           MOVE 0 TO COND-WORD.
           REWRITE PFREC FROM PER-PERSONNEL
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF PF-STATUS NOT = "00" MOVE 17 TO COND-WORD.
           IF COND-WORD = 17
               PERFORM 998-BLOWUP.
       61-DEL-TRAINING.
           PERFORM 69-START-PER-FREE.
           IF COND-WORD = 17 GO TO 61-DT-EXIT.
           PERFORM 69-READ-PER-FREE.
           IF COND-WORD = 15 GO TO 61-DT-EXIT.
           PERFORM 61-DEL-TRAINING-CONT.
           IF COND-WORD = 17
               GO TO 61-DT-EXIT
           ELSE
           GO TO 61-DEL-TRAINING.
       61-DT-EXIT.    EXIT.
       61-DEL-TRAINING-CONT.
           IF PG-FIELD = "AL" OR PER-FREE-PAGE
             MOVE "Y" TO DATA-SW
             PERFORM 69-DELETE-PER-FREE.
       62-DEL-CONF.
           PERFORM 69-START-PER-CONFIDENTIAL.
           IF COND-WORD = 17 GO TO 62-DC-EXIT.
           PERFORM 69-READ-PER-CONFIDENTIAL.
           IF COND-WORD = 0
               MOVE "Y" TO DATA-SW
               PERFORM 69-DELETE-PER-CONFIDENTIAL
               IF COND-WORD = 17
                   GO TO 62-DC-EXIT
               ELSE
               GO TO 62-DEL-CONF.
       62-DC-EXIT.    EXIT.
       63-DEL-MASTER.
           PERFORM 69-DELETE-PERSONNEL-FILE.
           MOVE "Y" TO DATA-SW.
           MOVE 39008 TO CATREAD-MSG-NUMBER.
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
           MOVE ERROR-BUFFER TO SCREEN-CMD-LINE.
           MOVE SCREEN-D TO DSPLY-REC.
           MOVE TRUE-VAL TO INDS (98).
           PERFORM 99-SCREEN-WRITE.
           PERFORM 98A-SCREEN-READ.
           CALL "CLPAUSE2".
       63-DM-EXIT.    EXIT.

       69-DELETE-PER-ABSENCE.
           MOVE 0 TO COND-WORD.
           DELETE PER-ABSENCE RECORD
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF PA-STATUS NOT = "00" MOVE 17 TO COND-WORD.

       69-READ-PER-ABSENCE.
           MOVE 0 TO COND-WORD.
           READ PER-ABSENCE NEXT INTO PER-ABSENCE-DATA
               AT END    MOVE 15 TO COND-WORD.
           IF PA-STATUS NOT = "00" MOVE 15 TO COND-WORD.

       69-START-PER-ABSENCE.
           MOVE 0 TO COND-WORD.
           MOVE ABS-KEY TO PERABSCCYR OF PAREC.
           START PER-ABSENCE KEY IS = EXTERNALLY-DESCRIBED-KEY
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF PA-STATUS NOT = "00" MOVE 17 TO COND-WORD.

       69-DELETE-PER-CONFIDENTIAL.
           MOVE 0 TO COND-WORD.
           DELETE PER-CONFIDENTIAL RECORD
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF PC-STATUS NOT = "00" MOVE 17 TO COND-WORD.

       69-READ-PER-CONFIDENTIAL.
           MOVE 0 TO COND-WORD.
           READ PER-CONFIDENTIAL NEXT INTO PER-CONFIDENTIAL-DATA
               AT END    MOVE 15 TO COND-WORD.
           IF PC-STATUS NOT = "00" MOVE 15 TO COND-WORD.

       69-START-PER-CONFIDENTIAL.
           MOVE 0 TO COND-WORD.
           MOVE CC-FIELD TO PERCCNUM OF PCREC.
           START PER-CONFIDENTIAL KEY IS = EXTERNALLY-DESCRIBED-KEY
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF PC-STATUS NOT = "00" MOVE 17 TO COND-WORD.

       69-DELETE-PER-FREE.
           MOVE 0 TO COND-WORD.
           DELETE PER-FREE RECORD
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF PFC-STATUS NOT = "00" MOVE 17 TO COND-WORD.

       69-READ-PER-FREE.
           MOVE 0 TO COND-WORD.
           READ PER-FREE NEXT INTO PER-FREE-WS
               AT END    MOVE 15 TO COND-WORD.
           IF PFC-STATUS NOT = "00" MOVE 15 TO COND-WORD.

       69-START-PER-FREE.
           MOVE 0 TO COND-WORD.
           MOVE CC-FIELD TO PERCCNUM OF PFCREC.
           START PER-FREE KEY IS = EXTERNALLY-DESCRIBED-KEY
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF PFC-STATUS NOT = "00" MOVE 17 TO COND-WORD.

       69-DELETE-PERSONNEL-FILE.
           MOVE 0 TO COND-WORD.
           DELETE PERSONNEL-FILE RECORD
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF PF-STATUS NOT = "00" MOVE 17 TO COND-WORD.

       98-SCREEN-READ.
           READ DISPLAY-FILE FORMAT IS VIEW-CFNAME
               INDIC IS INDICS.
           ACCEPT IOFEEDBACK FROM I-O-FEEDBACK-AREA.
           MOVE ALL B"0" TO INDICS.
           IF DSPLY-STATUS NOT = "00"
               MOVE 3 TO VIEW-LASTKEY
           ELSE
           MOVE FUNCTION-NUM TO VIEW-LASTKEY.

       98A-SCREEN-READ.
           READ DISPLAY-FILE TERMINAL IS TERMINAL-ID
               INDIC IS INDICS
                  NO DATA MOVE DSPLY-STATUS TO DSPLY-STATUS.
           MOVE ALL B"0" TO INDICS.

       99-SCREEN-WRITE.
           WRITE DSPLY-REC FORMAT IS VIEW-CFNAME
               INDIC IS INDICS.
           MOVE ALL B"0" TO INDICS.

       998-BLOWUP.
           MOVE "TPDEL" TO BU-PGM-NAME.
           CALL "TBLOWUP" USING BLOWUP-BASE BU-PGM-NAME STATUS-AREA
                            VIEW-COMAREA DUMMY-KSAM-STAT
                            BU-DISPLAY-MSG BU-DISPLAY-FLDS.

       999-CATREAD.
           MOVE SPACES TO ERROR-BUFFER.
           CALL "CCATREAD" USING CATREAD-PARMS.
           MOVE CATREAD-MSG-TEXT TO ERROR-BUFFER.
       999-CATREAD-EXIT.
           EXIT.
