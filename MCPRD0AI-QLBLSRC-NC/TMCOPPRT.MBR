000200 IDENTIFICATION DIVISION.
000300 PROGRAM-ID.    TMCOPPRT.
      *C
      *C 09/12/96  JEFF BUNGO
      *C   EXPAND DATE FIELDS FOR YEAR 2000 COMPLIANCE.
      *C   RECOMPILE TO PICKUP COPYLIB CHANGES.

000600 ENVIRONMENT DIVISION.
000700 CONFIGURATION SECTION.
000800 SOURCE-COMPUTER.   AS400.
000900 OBJECT-COMPUTER.   AS400.
       SPECIAL-NAMES. I-O-FEEDBACK IS I-O-FEEDBACK-AREA
                      LOCAL-DATA IS LOCAL-DATA-AREA.
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT PRTPLAN-BANK
               ASSIGN TO DATABASE-MCFLMM3801
               ORGANIZATION IS INDEXED
               ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
               FILE STATUS IS PB-STATUS.
           SELECT WO-PARTS-FILE
               ASSIGN TO DATABASE-MCFLMM1201
               ORGANIZATION IS INDEXED
               ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY WITH DUPLICATES
               FILE STATUS IS WPFD-STATUS.
001200 DATA DIVISION.
       FILE SECTION.
       FD  PRTPLAN-BANK
           LABEL RECORDS ARE STANDARD
           DATA RECORD IS PBREC.
       01  PBREC.
           COPY DDS-ALL-FORMATS OF MCFLMM3801.
       FD  WO-PARTS-FILE
           LABEL RECORDS ARE STANDARD
           DATA RECORD IS WPFDREC.
       01  WPFDREC.
           COPY DDS-ALL-FORMATS OF MCFLMM1201.
001400 WORKING-STORAGE SECTION.
       01  BLOWUP-BASE             PIC X(16).

       COPY CATREAD OF COPYLIB.

       01  FILE-STATUSES.
           05  PB-STATUS           PIC XX.
           05  WPFD-STATUS         PIC XX.

003300 01  MISC-BUFFER             PIC X(80) VALUE SPACES.
003400
001600 01  PASSWORD-INFORMATION.
001700     05  NAME-OF-PROGRAM     PIC X(08) VALUE "TMCOPPRT".
001800     05  PROGRAM-TYPE        PIC X(02) VALUE "UP".
001900     05  PROGRAM-RELEASE     PIC X(12) VALUE " E0100010001".
002000     05  PROGRAM-DESCRIPTION.
002100         10  PROG-DESC-A     PIC X(60) VALUE
002200           " COPIES A W/O PART PLAN TO A GENERIC PART PLAN    "  .
002300         10  PROG-DESC-B     PIC X(60) VALUE SPACES.
002500         10  PROG-FUNCTION   PIC X(60) VALUE SPACES.
002700     05  PASSWORD-FLAG       PIC X.
002800
004300 01  PRTPLAN-BUFFER1.        COPY DWOPARTS OF COPYLIB.
004400
004500 01  PRTPLAN-BUFFER2.        COPY DPRTBANK OF COPYLIB.
004600
       COPY DBSTAT OF COPYLIB.
003200
       COPY TBLOWUP OF COPYLIB.
005500 LINKAGE SECTION.
005700 01  DBPARAMETERS.           COPY DBPARMS OF COPYLIB.
       COPY VCOMLINK OF COPYLIB.
005900 01  M-PRTPLAN1              PIC X(10).
006000 01  M-PRTPLAN2              PIC X(10).
       COPY LANGSUB OF COPYLIB.
006400 PROCEDURE DIVISION USING    DBPARAMETERS
006500                             VIEW-COMAREA
006600                             M-PRTPLAN1
006700                             M-PRTPLAN2
006800                             LANGUAGE-PARMS.
007000 START-PROGRAM.
007100     PERFORM 1-HSK.
007200     PERFORM 6-MAIN.
007300
007400 2-EOJ.
           CLOSE PRTPLAN-BANK.
           CLOSE WO-PARTS-FILE.
007600     GOBACK.
007900 1-HSK.
           OPEN I-O   WO-PARTS-FILE.
           OPEN INPUT PRTPLAN-BANK.
008000     CALL "TPWORD" USING PASSWORD-INFORMATION.
008400     IF PASSWORD-FLAG = "N" GO TO 2-EOJ.
009300 6-MAIN.
           MOVE 0 TO COND-WORD.
           MOVE M-PRTPLAN1 TO GPRTPNAME OF PBREC.
           START PRTPLAN-BANK KEY IS = EXTERNALLY-DESCRIBED-KEY
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF PB-STATUS NOT = "00" MOVE 17 TO COND-WORD.
           IF COND-WORD = 17 GO TO 2-EOJ.
010400     READ PRTPLAN-BANK NEXT INTO PRTPLAN-BUFFER1
               AT END    MOVE 15 TO COND-WORD.
           IF PB-STATUS NOT = "00" MOVE 15 TO COND-WORD.
010700     IF COND-WORD = 15
               NEXT SENTENCE
           ELSE
010800     PERFORM 61-COPY-PRTPLAN UNTIL COND-WORD = 15.
011800
011900 61-COPY-PRTPLAN.
012000     MOVE M-PRTPLAN2        TO MPRTNAME.
012200     MOVE PRT-STATUS OF PRTPLAN-BUFFER1
012300                            TO PRT-STATUS OF PRTPLAN-BUFFER2.
012400     MOVE PRT-EST-QTY OF PRTPLAN-BUFFER1
012500                            TO PRT-EST-QTY OF PRTPLAN-BUFFER2.
012600     MOVE PRT-NUM OF PRTPLAN-BUFFER1
012700                            TO PRT-NUM OF PRTPLAN-BUFFER2.
012800     MOVE PRT-UNIT-MEAS OF PRTPLAN-BUFFER1
012900                            TO PRT-UNIT-MEAS OF PRTPLAN-BUFFER2.
013000     MOVE PRT-UNIT-COST OF PRTPLAN-BUFFER1
013100                            TO PRT-UNIT-COST OF PRTPLAN-BUFFER2.
013200     MOVE PRT-PRIME OF PRTPLAN-BUFFER1
013300                            TO PRT-PRIME OF PRTPLAN-BUFFER2.
013400     MOVE PRT-SUB OF PRTPLAN-BUFFER1
013500                            TO PRT-SUB OF PRTPLAN-BUFFER2.
013600     MOVE PRT-STAGE OF PRTPLAN-BUFFER1
013700                            TO PRT-STAGE OF PRTPLAN-BUFFER2.
013800     MOVE PRT-ORIGINATOR OF PRTPLAN-BUFFER1
013900                            TO PRT-ORIGINATOR OF PRTPLAN-BUFFER2.
014000     MOVE PRT-ADDL-INFO OF PRTPLAN-BUFFER1
014100                            TO PRT-ADDL-INFO OF PRTPLAN-BUFFER2.
014200     MOVE PRT-SUGG-VENDOR OF PRTPLAN-BUFFER1
014300                            TO PRT-SUGG-VENDOR OF PRTPLAN-BUFFER2.
014400     MOVE PRT-DESC OF PRTPLAN-BUFFER1
014500                            TO PRT-DESC OF PRTPLAN-BUFFER2.
014600     MOVE PRT-DESC-2 OF PRTPLAN-BUFFER1
014700                            TO PRT-DESC-2 OF PRTPLAN-BUFFER2.
014800     MOVE PRT-DESC-3 OF PRTPLAN-BUFFER1
014900                            TO PRT-DESC-3 OF PRTPLAN-BUFFER2.
015000     MOVE PRT-DESC-4 OF PRTPLAN-BUFFER1
015100                            TO PRT-DESC-4 OF PRTPLAN-BUFFER2.
015200     MOVE PRT-DESC-5 OF PRTPLAN-BUFFER1
015300                            TO PRT-DESC-5 OF PRTPLAN-BUFFER2.
015400     MOVE PRT-REMARKS OF PRTPLAN-BUFFER1
015500                            TO PRT-REMARKS OF PRTPLAN-BUFFER2.
015600     MOVE PRT-REMARKS-2 OF PRTPLAN-BUFFER1
015700                            TO PRT-REMARKS-2 OF PRTPLAN-BUFFER2.
015800     MOVE PRT-EST-COST OF PRTPLAN-BUFFER1
015900                            TO PRT-EST-COST OF PRTPLAN-BUFFER2.
016000     MOVE 0 TO COND-WORD.
016100     WRITE WPFDREC FROM PRTPLAN-BUFFER2
016200         INVALID KEY    MOVE 17 TO COND-WORD.
           IF WPFD-STATUS NOT = "00" MOVE 17 TO COND-WORD.
           IF COND-WORD = 17 PERFORM 998-BLOWUP.
016700     READ PRTPLAN-BANK NEXT INTO PRTPLAN-BUFFER1
016800         AT END    MOVE 15 TO COND-WORD.
           IF M-PRTPLAN1 NOT = PRT-WO-NU MOVE 15 TO COND-WORD.
           IF PB-STATUS NOT = "00" MOVE 15 TO COND-WORD.
017400
076200 998-BLOWUP.
076300     MOVE "TMCOPPRT" TO BU-PGM-NAME.
076400     CALL "TBLOWUP" USING BLOWUP-BASE BU-PGM-NAME STATUS-AREA
076500                      VIEW-COMAREA DUMMY-KSAM-STAT
076600                      BU-DISPLAY-MSG BU-DISPLAY-FLDS.

017600 999-CATREAD.
017700     MOVE SPACES TO MISC-BUFFER.
017800     CALL "CCATREAD" USING CATREAD-PARMS.
017900     MOVE CATREAD-MSG-TEXT TO MISC-BUFFER.
018700 999-CATREAD-EXIT.    EXIT.
