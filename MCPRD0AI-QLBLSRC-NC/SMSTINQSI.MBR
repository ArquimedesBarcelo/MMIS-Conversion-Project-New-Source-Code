078000 62-FIND-DETAIL-RECS.
           MOVE CODE-ARG TO MATLCODE OF DTRANS-REC-O.
           START DTRANS-O KEY = MATLCODE OF DTRANS-REC-O
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
                   NEXT SENTENCE
               ELSE
078400             MOVE "FIND DTRANS * 62-FDR" TO BU-DISPLAY-MSG
078500             GO TO 2-BLOWUP
           ELSE
               MOVE 0 TO SAVE-COND
078600         PERFORM 62-GET-DETAIL-RECS
078700             UNTIL SAVE-COND = 15
      *------- DO A START > HIGH-VALUES TO UNLOCK
               MOVE HIGH-VALUES TO MATLCODE OF DTRANS-REC-O
               START DTRANS-O KEY > MATLCODE OF DTRANS-REC-O
                   INVALID KEY MOVE "00" TO FILE-STATUS.
078800     MOVE 0 TO SAVE-COND.
078900
079000 62-GET-DETAIL-RECS.
           MOVE 0 TO COND-WORD.
           READ DTRANS-O NEXT INTO BUF-DTRANS
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   MOVE 15 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.
           IF MATLCODE OF DTRANS-REC-O NOT = CODE-ARG
               MOVE 15 TO COND-WORD.
079300     IF COND-WORD = 0
079400        PERFORM 62-UPDATE-DETAIL-REC
079500     ELSE
079600        IF COND-WORD = 15
079700            MOVE COND-WORD TO SAVE-COND
079800        ELSE
