021000
021100 MODIFY-CODE SECTION 05.
021200
           CALL "QCMDEXC" USING OVERRIDE-ZMSTRINQ, OVERRIDE-PARM2.
           OPEN I-O DISPLAY-FILE.
           OPEN INPUT MSTORERM-I, MATLACUM-I, MREPORT-I,
                      MCHTACCTS-I.
      *****OPEN I-O   DTRANS-O, MATLACUM-O.
           OPEN INPUT   DTRANS-O, MATLACUM-O.
021300
021400     PERFORM 6-MAIN  THRU  6-M-X.
021500
           CLOSE DISPLAY-FILE.
           CLOSE MSTORERM-I, MATLACUM-I, MREPORT-I,
                 MCHTACCTS-I.
           CLOSE DTRANS-O.
021600     GOBACK.
021900
022000
022100*********************************************
022200*                                           *
022300*  BLOWUP ROUTINE EXECUTES WHENEVER A       *
022400*  FATAL ERROR OCCURS                       *
022500*                                           *
022600*********************************************
022700
022800 2-BLOWUP.
022900     MOVE "SMSTINQSI"             TO  BU-PGM-NAME.
023000     CALL "TBLOWUP" USING BASE, BU-PGM-NAME, STATUS-AREA,
023100         VIEW-COMAREA, FILE-STATUS, BU-DISPLAY-MSG,
023200                 BU-DISPLAY-FLDS.
023300
023400 2-BLOWUP-X.
023500     EXIT.
023600
023700
026600 4-PGM-ERROR.
           MOVE B"1" TO IND(99), IND(FIELD-NUMBER).
027400
027500 4-PGM-ERROR-X.
027600     EXIT.
030000
030100
030200****************************************
030300*                                      *
030400*    6  M A I N                        *
030500*                                      *
030600****************************************
030700
030800 6-MAIN.
030900     IF PASS-CORP-CODE  =  SPACES
031000         PERFORM 61-WRITE-FIRST-SCREEN THRU 61-WFS-X
031100     ELSE
031200         MOVE PASS-CORP-CODE    TO  DE-CODE-ENTRY.
031400     IF EOJ-SW = "Y"
031500         GO TO 6-M-X.
031600     PERFORM 62-UPDATE-CORP-CODE THRU 62-UCC-X.
031700     IF PASS-CORP-CODE  NOT = SPACES
031800         MOVE "Y"  TO  EOJ-SW.
031900     IF EOJ-SW = "Y"
032000         GO TO 6-M-X.
032100     GO TO 6-MAIN.
032200
032300 6-M-X.
032400     EXIT.
032500
032600
032700*****************************************
032800*                                       *
032900*    WRITE SCREEN 1 WHICH IS THE CORP   *
033000*    CODE ENTRY SCREEN. THEN CHECK FOR  *
033100*    VALID CORP CODE AND FOR ANY WORK   *
033200*    SHEETS                             *
033300*                                       *
033400*****************************************
033500
033600 61-WRITE-FIRST-SCREEN.
033700     MOVE "MSTRINQ1"  TO  VIEW-NFNAME.
034200
034300     MOVE SPACES  TO  SCREEN-1.
034400     MOVE PASS-COMPANY-CODE  TO  DISP-COMPANY-CODE1.
035900
036000 61-SHOWFORM-SCREEN-1.
           MOVE SCREEN-1                TO  DISPLAY-REC.
           MOVE B"1" TO IND(10).
           PERFORM 998-WRITE-SCREEN THRU 998-READ-SCREEN.
           MOVE DISPLAY-REC             TO  SCREEN-1.
036700
036800     IF VIEW-LASTKEY = 3
036900         MOVE "Y"  TO  EOJ-SW
037000         GO TO 61-WFS-X
037100     ELSE
038400     IF VIEW-LASTKEY = 1 OR
038500        VIEW-LASTKEY = 2 OR
038600        VIEW-LASTKEY = 4 OR
038700        VIEW-LASTKEY = 5 OR
038800        VIEW-LASTKEY = 6 OR
038900        VIEW-LASTKEY = 7 OR
              VIEW-LASTKEY = 8
039100         MOVE   9 TO LANG-SETNUM
039200         MOVE  10 TO LANG-MSGNUM
039300         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER  TO  DE1-MSGLINE
039400         MOVE 2  TO  FIELD-NUMBER
039500         PERFORM 4-PGM-ERROR  THRU  4-PGM-ERROR-X
039600         GO TO 61-SHOWFORM-SCREEN-1.
039700
039800 61-FIELD-EDITS.
           IF DE-CODE-ENTRY = SPACES
      *** MATERIAL CODE IS REQUIRED
               MOVE 66328 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER TO   DE1-MSGLINE
               MOVE  2 TO  FIELD-NUMBER
               PERFORM 4-PGM-ERROR  THRU  4-PGM-ERROR-X
               GO TO 61-SHOWFORM-SCREEN-1.
040800
041700 61-GET-CODE.
      *-----------------------------------------------------------*
      *  10/18/94           C A ZUBEK                             *
      *  LOGIC TO CALL THE SUBROUTINE "TALTKEY" TO SEE IF USER    *
      *  ENTERED AN ALTERNATE KEY.  IF SO, THE CORPORATE CODE     *
      *  WILL BE RETURNED.                                        *
      *-----------------------------------------------------------*

041800     MOVE DE-CODE-ENTRY           TO ALT-KEY-ARG.
           CALL "TALTKEY" USING RET-CODE-TALTKEY,
                                BASE-TALTKEY,
                                STATUS-AREA,
                                ALT-KEY-ARG,
                                ALT-CORP-CODE.
           IF RET-CODE-TALTKEY NOT EQUAL "00"
               MOVE "TALTKEY ERROR 61-GC" TO BU-DISPLAY-MSG
               MOVE ALT-CORP-CODE         TO BU-DISPLAY-FLD (1)
               GO TO 2-BLOWUP.
           MOVE ALT-CORP-CODE           TO CODE-ARG.

           MOVE CODE-ARG TO CORPCDE OF MSTORERM-REC-I.
           READ MSTORERM-I INTO BUF-MSTORERM
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
042100     IF FILE-STATUS NOT = "00"
042200         IF CODE-FST4 IS ALPHABETIC
042300             NEXT SENTENCE
042400         ELSE
                   IF FILE-STATUS-1 = "2"
042600                 MOVE ZEROS       TO STR-AVG-COST,
042700                                     STR-STD-COST,
042800                                     STR-ONHAND
042900                 MOVE SPACES      TO STR-CONS-IND
043000             ELSE
043100                 MOVE "GET MSTORERM 61-GC" TO BU-DISPLAY-MSG
043200                 MOVE CODE-ARG            TO BU-DISPLAY-FLD (1)
043300                 GO TO 2-BLOWUP.
           MOVE CODE-ARG TO MATLCODE OF MATLACUM-REC-I.
           READ MATLACUM-I INTO BUF-MATLACUM
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
043900**           STORES CODES DOES NOT EXIST IN LOCAL ACCT. DATA BASE
044000             MOVE  19 TO LANG-SETNUM
044100             MOVE  36 TO LANG-MSGNUM
044200             PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
044300             MOVE CODE-ARG  TO  MSG-FLD
                   MOVE MESSAGE-BUFFER TO DE1-MSGLINE
044400             MOVE 2         TO  FIELD-NUMBER
044500             PERFORM 4-PGM-ERROR  THRU  4-PGM-ERROR-X
044600             GO TO 61-SHOWFORM-SCREEN-1
044700         ELSE
044800             MOVE "GET MATLACUM 61-GC" TO BU-DISPLAY-MSG
044900             MOVE CODE-ARG            TO BU-DISPLAY-FLD (1)
045000             GO TO 2-BLOWUP.
045100
045200 61-WFS-X.
045300     EXIT.
045400
045500
045600*********************************************
045700*                                           *
045800*    UPDATE CORP CODE SECTION               *
045900*                                           *
046000*********************************************
046100*                                           *
046200*   WRITE SCREEN 2 'MSTRINQ2' AND MOVE ALL  *
046300*   DATA TO SCREEN FOR USER MODIFICATION    *
046400*                                           *
046500*********************************************
046600
046700
046800 62-UPDATE-CORP-CODE.
046900     MOVE CODE-ARG  TO  BU-DISPLAY-FLD (2).
047000     MOVE "MSTRINQ2"  TO  VIEW-NFNAME.
048300
           MOVE CODE-ARG TO CORPCDE OF MSTORERM-REC-I.
           READ MSTORERM-I INTO BUF-MSTORERM
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
042100     IF FILE-STATUS NOT = "00"
048700         IF CODE-FST4  IS ALPHABETIC
048800             MOVE ZEROS           TO STR-AVG-COST,
048900                                     STR-STD-COST,
049000                                     STR-ONHAND
                                           STR-LOC-ONHAND (1)
                                           STR-LOC-ONHAND (2)
                                           STR-LOC-ONHAND (3)
                                           STR-LOC-ONHAND (4)
                                           STR-LOC-ONHAND (5)
                                           STR-LOC-ONHAND (6)
049100             MOVE SPACES          TO STR-CONS-IND
049200         ELSE
049300             IF FILE-STATUS-1 = "2"
                       MOVE ZEROS       TO STR-LOC-ONHAND (1)
                                           STR-LOC-ONHAND (2)
                                           STR-LOC-ONHAND (3)
                                           STR-LOC-ONHAND (4)
                                           STR-LOC-ONHAND (5)
                                           STR-LOC-ONHAND (6)
049500             ELSE
049600                 MOVE "GET MSTORERM 62-UCC" TO BU-DISPLAY-MSG
049700                 GO TO 2-BLOWUP.
049800
           MOVE CODE-ARG TO MATLCODE OF MATLACUM-REC-I.
           READ MATLACUM-I INTO BUF-MATLACUM
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
050100     IF FILE-STATUS NOT = "00"
050200         MOVE "GET MATLACUM 62-UCC" TO BU-DISPLAY-MSG
050300         GO TO 2-BLOWUP.
050400
050500********************************************************
050600**   CALL 'SOPNRAV' TO GET STOREROOM OPEN RECEIVERS
050700**   AND INVOICES
050800********************************************************
050900     MOVE CODE-ARG                TO SOPNRAV-MATL-CODE.
051000     CALL "SOPNRAV" USING BASE-CSACCT,
051100                          SOPNRAV-PARMS,
051200                          STATUS-AREA,
051300                          BU-DISPLAY-MSG,
051400                          BU-DISPLAY-FLDS.
051500     IF BU-DISPLAY-MSG NOT = SPACES
051600         GO TO 2-BLOWUP.
051700
051800     MOVE SPACES                 TO SCREEN-2.
