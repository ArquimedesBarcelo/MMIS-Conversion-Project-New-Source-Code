       IDENTIFICATION DIVISION.
       PROGRAM-ID.     TUPDTCHB.
       AUTHOR.         CA YODER.
       DATE-WRITTEN.   APRIL 2000.
       DATE-COMPILED.
      *INSTALLATION.   THE GOODYEAR TIRE & RUBBER CO.

      ************************************************************
      *D* T U P D T C H B    (MP8)
      *D*
      *D*   THIS PROGRAM PERFORMS UPDATES TO THE TECHNICAL
      *D*   BULLETIN FILE (MCFPCS6900).
      *D*
      ************************************************************
      *
      *C* CHANGES
      *C*
      *C*   02/2002    CA YODER     NAPANEE REQUEST
      *C*     ADDED LOGIC TO DISPLAY AND EDIT COMPLIANCE FILE
      *C*     (MCFPCS7000).
      *C*

       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.
       SOURCE-COMPUTER.    IBM-AS400.
       OBJECT-COMPUTER.    IBM-AS400.

       SPECIAL-NAMES.  I-O-FEEDBACK IS I-O-FEEDBACK-AREA
                       LOCAL-DATA IS LOCAL-DATA-AREA.

       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT DISPLAY-FILE
               ASSIGN         TO WORKSTATION-ZPLTMAST-SI
               ORGANIZATION   IS TRANSACTION
               ACCESS         IS DYNAMIC
               RELATIVE KEY   IS REC-COUNT
               FILE STATUS    IS DISPLAY-STATUS
               CONTROL-AREA   IS WS-CONTROL.

           SELECT MPLTINFO-I
               ASSIGN         TO DATABASE-MCFLCS0501
               ORGANIZATION   IS INDEXED
               ACCESS MODE    IS DYNAMIC
               RECORD KEY     IS EXTERNALLY-DESCRIBED-KEY
               FILE STATUS    IS FILE-STATUS.

           SELECT MSTORERM-I
               ASSIGN         TO DATABASE-MCFLCS0201
               ORGANIZATION   IS INDEXED
               ACCESS MODE    IS DYNAMIC
               RECORD KEY     IS EXTERNALLY-DESCRIBED-KEY
               FILE STATUS    IS FILE-STATUS.

           SELECT DDESC-CD-I
               ASSIGN         TO DATABASE-MCFLCS1401
               ORGANIZATION   IS INDEXED
               ACCESS MODE    IS DYNAMIC
               RECORD KEY     IS EXTERNALLY-DESCRIBED-KEY
                 WITH DUPLICATES
               FILE STATUS    IS FILE-STATUS.

           SELECT DMANPART-CD-I
               ASSIGN         TO DATABASE-MCFLCS3603
               ORGANIZATION   IS INDEXED
               ACCESS MODE    IS DYNAMIC
               RECORD KEY     IS EXTERNALLY-DESCRIBED-KEY
                 WITH DUPLICATES
               FILE STATUS    IS FILE-STATUS.

           SELECT DDESC2-CD-I
               ASSIGN         TO DATABASE-MCFLCS3101
               ORGANIZATION   IS INDEXED
               ACCESS MODE    IS DYNAMIC
               RECORD KEY     IS EXTERNALLY-DESCRIBED-KEY
                 WITH DUPLICATES
               FILE STATUS    IS FILE-STATUS.

           SELECT DTECHBUL-IO
               ASSIGN         TO DATABASE-MCFLCS6901
               ORGANIZATION   IS INDEXED
               ACCESS MODE    IS DYNAMIC
               RECORD KEY     IS EXTERNALLY-DESCRIBED-KEY
                 WITH DUPLICATES
               FILE STATUS    IS FILE-STATUS.

           SELECT DCOMPL-IO
               ASSIGN         TO DATABASE-MCFLCS7001
               ORGANIZATION   IS INDEXED
               ACCESS MODE    IS DYNAMIC
               RECORD KEY     IS EXTERNALLY-DESCRIBED-KEY
                 WITH DUPLICATES
               FILE STATUS    IS FILE-STATUS.

       DATA DIVISION.
       FILE SECTION.

       FD  DISPLAY-FILE
           LABEL RECORDS ARE OMITTED.
       01  DISPLAY-REC       PIC X(2000).

       FD  MPLTINFO-I
           LABEL RECORDS ARE STANDARD.
       01  MPLTINFO-REC-I.
           COPY DDS-ALL-FORMATS  OF MCFLCS0501.

       FD  MSTORERM-I
           LABEL RECORDS ARE STANDARD.
       01  MSTORERM-REC-I.
           COPY DDS-ALL-FORMATS  OF MCFLCS0201.

       FD  DDESC-CD-I
           LABEL RECORDS ARE STANDARD.
       01  DDESC-CD-REC-I.
           COPY DDS-ALL-FORMATS  OF MCFLCS1401.

       FD  DMANPART-CD-I
           LABEL RECORDS ARE STANDARD.
       01  DMANPART-CD-REC-I.
           COPY DDS-MCRPCS3600  OF MCFLCS3603.

       FD  DDESC2-CD-I
           LABEL RECORDS ARE STANDARD.
       01  DDESC2-CD-REC-I.
           COPY DDS-MCRPCS3100  OF MCFLCS3101.

       FD  DTECHBUL-IO
           LABEL RECORDS ARE STANDARD.
       01  DTECHBUL-REC-IO.
           COPY DDS-MCRPCS6900  OF MCFLCS6901.

       FD  DCOMPL-IO
           LABEL RECORDS ARE STANDARD.
       01  DCOMPL-REC-IO.
           COPY DDS-MCRPCS7000  OF MCFLCS7001.

       WORKING-STORAGE SECTION.

       77  SAVE-COMPANY-CODE           PIC X(3)   VALUE SPACES.
       77  EOJ-SW                      PIC X      VALUE "N".
       77  RET-CODE                    PIC X(2)   VALUE "00".
       77  ALT-KEY-ARG                 PIC X(40).
       77  ALT-CORP-CODE               PIC X(8).
       77  BASE-TALTKEY                PIC X(20).
       77  REC-COUNT                   PIC 9(5) VALUE 0.
       77  SUB                         PIC 9    VALUE 0.
       77  DMANPART-EOF-SW             PIC X.
       77  DDESC-EOF-SW                PIC X.
       77  DDESC2-EOF-SW               PIC X.
       77  DTECHBUL-EOF-SW             PIC X.
       77  DCOMPL-EOF-SW               PIC X.
       77  UPDATE-SW                   PIC X.
       77  ERR-MSG                     PIC X.
       77  ADD-SW                      PIC X.
       77  DE3-KW-HOLD                 PIC X(20).
       77  DE3-MOD-HOLD                PIC X(30).

       01  FILE-STATUS.
           05  FILE-STATUS-1            PIC X    VALUE "0".
           05  FILE-STATUS-2            PIC X    VALUE "0".

       01  MESSAGE-BUFFER.
           05  MSG-TEXT              PIC X(68)   VALUE SPACE.
           05  MSG-FLD               PIC X(10)   VALUE SPACE.
           05  MSG-FLD-9  REDEFINES  MSG-FLD     PIC ZZZZZZZZZ9.

       01  FIELD-NUMBER              PIC S9(4)    VALUE 1     COMP-4.

       01  WHO-VARIABLES.
           05  MOD                      PIC S9(4) COMP.
           05  CAP                      PIC S9(8) COMP.
           05  LATTR                    PIC S9(8) COMP.
           05  USERNAME                 PIC X(8).
           05  GRPNAME                  PIC X(8).
           05  ACCTNAME                 PIC X(8).
           05  HOMEGRP                  PIC X(8).
           05  TNUM                     PIC 99 COMP VALUE 0.
           05  FILLER                   PIC XX.

       COPY DDESC    IN COPYLIB.
       COPY DDESC2   IN COPYLIB.
       COPY MPLT0    IN COPYLIB.
       COPY MPLTP01  IN COPYLIB.
       COPY MSTORERM IN COPYLIB.
       COPY DMANPART IN COPYLIB.
       COPY DTECHBUL IN COPYLIB.
       COPY DCOMPL   IN COPYLIB.

       COPY CDESC    IN COPYLIB.
       COPY CFINPTYP IN COPYLIB.
       COPY TDATECHK IN COPYLIB.
       COPY TRSHIFT  IN COPYLIB.
       COPY TBLOWUP  IN COPYLIB.


       01 ARG-VALUES.
           05  CODE-ARG               PIC X(8)  VALUE SPACES.
           05  PLT-ARG                PIC X(4)  VALUE SPACES.

       01  SCREEN-1.
           05  DISP-COMP-1       PIC X(3).
           05  DE-CODE-ENTRY     PIC X(12).
           05  DE1-COMMAND-LINE  PIC X(79).
           05  DE1-MESSAGE-LINE  PIC X(79).

       01  SCREEN-2A.
           05  DISP-COMP-2       PIC X(3).
           05  DE2-CODE          PIC X(7).

       01  SCREEN-2B.
           05  DE2-DESC-LINE               PIC X(79).
           05  FULL-DESC-LINE-MANUF   REDEFINES  DE2-DESC-LINE.
               10 FILLER                   PIC X(1).
               10 FULL-DESC-LINE-P1        PIC X(1).
               10 FULL-DESC-LINE-SEL       PIC X(1).
               10 FULL-DESC-LINE-P2        PIC X(1).
               10 FILLER                   PIC X(1).
               10 FULL-DESC-LINE-MFR       PIC X(26).
               10 FILLER                   PIC X(1).
               10 FULL-DESC-LINE-TYPE      PIC X(3).
               10 FILLER                   PIC X(1).
               10 FULL-DESC-LINE-PARTNO    PIC X(20).
               10 FILLER                   PIC X(23).
           05  FULL-DESC-LINE-KWM      REDEFINES  DE2-DESC-LINE.
               10 FULL-DESC-LINE-KW        PIC X(20).
               10 FILLER                   PIC X(1).
               10 FULL-DESC-LINE-MOD       PIC X(30).
               10 FILLER                   PIC X(28).

       01  SCREEN-2C.
           05  DE2C-DATE                   PIC X(10).
           05  DE2C-USER                   PIC X(8).
           05  DE2C-TB-LINES.
               10  DE2C-TB-LINE  OCCURS  4  TIMES
                                           PIC X(79).

       01  SCREEN-3.
           05  DISP-COMP-3       PIC X(3).
           05  DE3-CODE          PIC X(7).
           05  DE3-DESC-LINE.
               10  DE3-KW        PIC X(20).
               10  FILLER        PIC X(1).
               10  DE3-MOD       PIC X(30).
               10  FILLER        PIC X(28).
           05  DE3-DATE          PIC X(10).
           05  DE3-USER          PIC X(8).
           05  DE3-COMPLIANCE-LINES.
               10  DE3-COMPLIANCE    OCCURS  5 TIMES.
                   15  DE3-REG-BODY  PIC X(20).
                   15  DE3-STANDARD  PIC X(50).

       01  OFF-SWITCH               PIC 1  VALUE B"0".
       01  ON-SWITCH                PIC 1  VALUE B"1".

       COPY DISPDATA    IN COPYLIB.
       COPY IOFEEDBACK  IN COPYLIB.
       COPY CATREAD     IN COPYLIB.
       COPY VCOMAREA    IN COPYLIB.
       COPY DBSTAT      IN COPYLIB.
       COPY LANGSUB     IN COPYLIB.

       01  BASE         PIC X(10).

      *****************************************************************
      ***  P R O C E D U R E   D I V I S I O N
      *****************************************************************

       PROCEDURE DIVISION.

       BEGIN-PARAGRAPH.

           PERFORM 1-HSK.
           PERFORM 6-MAIN  THRU  6-M-X.
           PERFORM 2-EOJ.
           GOBACK.

       1-HSK.
           OPEN INPUT MPLTINFO-I
                      MSTORERM-I
                      DDESC-CD-I
                      DMANPART-CD-I
                      DDESC2-CD-I
                I-O   DISPLAY-FILE
                      DTECHBUL-IO
                      DCOMPL-IO.

           CALL "WHO" USING MOD, CAP, LATTR,
             USERNAME, GRPNAME, ACCTNAME, HOMEGRP, TNUM.

           MOVE "P 01"         TO  PLT-ARG.
           MOVE PLT-ARG TO PLTINFOKEY OF MPLTINFO-REC-I.
           READ MPLTINFO-I INTO BUF-MPLTINFO
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE "1-HSK"   TO  BU-DISPLAY-MSG
               MOVE PLT-ARG   TO  BU-DISPLAY-FLD (1)
               GO TO 2-BLOWUP.
           MOVE MPLTINFO-COMPANY  TO  SAVE-COMPANY-CODE.

       2-EOJ.
           CLOSE MPLTINFO-I,
                 MSTORERM-I,
                 DDESC-CD-I,
                 DMANPART-CD-I,
                 DDESC2-CD-I,
                 DTECHBUL-IO,
                 DCOMPL-IO,
                 DISPLAY-FILE.

       2-BLOWUP.
           MOVE "TUPDTCHB"              TO  BU-PGM-NAME.
           MOVE CODE-ARG                TO  BU-DISPLAY-FLD (1).
           CALL "TBLOWUP" USING BASE, BU-PGM-NAME, STATUS-AREA,
               VIEW-COMAREA, FILE-STATUS, BU-DISPLAY-MSG,
                       BU-DISPLAY-FLDS.

       2-BLOWUP-X.
           EXIT.

       4-PGM-ERROR.
           MOVE B"1" TO IND (FIELD-NUMBER), IND (99).
           MOVE MESSAGE-BUFFER TO DE1-MESSAGE-LINE.

       4-PGM-ERROR-X.
           EXIT.

      *****************************************************************
      ***  M A I N   P A R A G R A P H
      *****************************************************************

       6-MAIN.
           PERFORM 61-WRITE-FIRST-SCREEN THRU 61-WFS-X.
           IF EOJ-SW = "Y"
               GO TO 6-M-X.
           PERFORM 62-LOAD-SCREEN THRU 62-LS-X.
           GO TO 6-MAIN.

       6-M-X.
           EXIT.

      *****************************************************************
      ***  M P 8 - 1   S C R E E N
      *****************************************************************

       61-WRITE-FIRST-SCREEN.
           MOVE "TECHBUL1"  TO  VIEW-NFNAME.
           MOVE SPACES  TO  SCREEN-1.
           MOVE SAVE-COMPANY-CODE  TO  DISP-COMP-1
                                       DISP-COMP-2.
           IF ERR-MSG = "Y"
               PERFORM 4-PGM-ERROR  THRU  4-PGM-ERROR-X
               MOVE "N"        TO  ERR-MSG.

       61-SHOWFORM-SCREEN-1.
           MOVE SCREEN-1       TO DISPLAY-REC.
           PERFORM 998-WRITE-SCREEN THRU 998-READ-SCREEN.
           MOVE DISPLAY-REC    TO SCREEN-1.

           IF VIEW-LASTKEY = 3
               MOVE "Y"  TO  EOJ-SW
               GO TO 61-WFS-X
           ELSE
           IF VIEW-LASTKEY = 1 OR
              VIEW-LASTKEY = 2 OR
              VIEW-LASTKEY = 4 OR
              VIEW-LASTKEY = 5 OR
              VIEW-LASTKEY = 6 OR
              VIEW-LASTKEY = 7 OR
              VIEW-LASTKEY = 8
      ***      INVALID FUNCTION KEY
               MOVE   9 TO LANG-SETNUM
               MOVE  10 TO LANG-MSGNUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE 2  TO  FIELD-NUMBER
               PERFORM 4-PGM-ERROR  THRU  4-PGM-ERROR-X
               GO TO 61-SHOWFORM-SCREEN-1.

      *-------- FIELD EDITS
           IF DE-CODE-ENTRY = SPACES
      *         YOU MUST ENTER A CORPORATE CODE
               MOVE 66170 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE 2  TO FIELD-NUMBER
               PERFORM 4-PGM-ERROR  THRU  4-PGM-ERROR-X
               GO TO 61-SHOWFORM-SCREEN-1.

           MOVE DE-CODE-ENTRY           TO ALT-KEY-ARG.
           CALL "TALTKEY" USING RET-CODE,
                                BASE-TALTKEY,
                                STATUS-AREA,
                                ALT-KEY-ARG,
                                ALT-CORP-CODE.
           MOVE ALT-CORP-CODE           TO CODE-ARG.
           IF RET-CODE NOT EQUAL "00"
               MOVE "TALTKEY ERROR 62-UCC" TO BU-DISPLAY-MSG
               GO TO 2-BLOWUP.
           MOVE ALT-CORP-CODE             TO CODE-ARG.

           MOVE CODE-ARG TO CORPCDE OF MSTORERM-REC-I.
           READ MSTORERM-I INTO BUF-MSTORERM
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
      ***          STORES CODE DOES NOT EXIST
                   MOVE  19 TO LANG-SETNUM
                   MOVE   9 TO LANG-MSGNUM
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE CODE-ARG  TO  MSG-FLD
                   MOVE 2         TO  FIELD-NUMBER
                   PERFORM 4-PGM-ERROR  THRU  4-PGM-ERROR-X
                   GO TO 61-SHOWFORM-SCREEN-1
               ELSE
                   MOVE "DBGET 61-GET-CODE" TO BU-DISPLAY-MSG
                   GO TO 2-BLOWUP.

      *------- DO A START > HIGH-VALUES TO UNLOCK
           MOVE HIGH-VALUES TO CORPCDE OF MSTORERM-REC-I.
           START MSTORERM-I KEY > CORPCDE OF MSTORERM-REC-I
               INVALID KEY MOVE "00" TO FILE-STATUS.

       61-WFS-X.
           EXIT.

      *****************************************************************
      ***  M P 8 - 2   S C R E E N
      *****************************************************************

       62-LOAD-SCREEN.
           MOVE CODE-ARG        TO  DE2-CODE.

           INITIALIZE REC-COUNT.

           PERFORM 999-START-DTECHBUL.
           IF FILE-STATUS = "00"
               MOVE "N"         TO ADD-SW
               MOVE ON-SWITCH   TO IND (30)
           ELSE
               MOVE "Y"         TO ADD-SW.

      *---- SHOW SFLCTL (71) AND CLEAR SFL (72), BUT DON'T SHOW IT (70).

           MOVE ON-SWITCH    TO IND (71)  IND (72).
           MOVE OFF-SWITCH   TO IND (70).

           WRITE SUBFILE DISPLAY-REC FROM SCREEN-2A
               FORMAT IS "TECHSFLC"
               INDICATORS ARE SRF-INDICATORS.
           IF DISPLAY-STATUS NOT = "00"
               MOVE "PROBLEM ON INIT SFL WRITE" TO BU-DISPLAY-MSG
               PERFORM 2-BLOWUP.

      *-------- TURN CLEAR SFL OFF.

           MOVE OFF-SWITCH TO IND (72).

       62-LOAD-DESC.

           MOVE "N" TO DMANPART-EOF-SW.
           PERFORM 999-START-DMANPART.
           PERFORM 999-GETNEXT-DMANPART.
           PERFORM 63-GET-DMANPART
              UNTIL DMANPART-EOF-SW = "Y".

           MOVE "N" TO DDESC-EOF-SW.
           PERFORM 999-START-DDESC.
           PERFORM 999-GETNEXT-DDESC.
           PERFORM 64-GET-DDESC
              UNTIL DDESC-EOF-SW = "Y".

           MOVE "N" TO DDESC2-EOF-SW.
           PERFORM 999-START-DDESC2.
           PERFORM 999-GETNEXT-DDESC2.
           PERFORM 65-GET-DDESC2
              UNTIL DDESC2-EOF-SW = "Y".

       62-SHOW-SCREEN.

           INITIALIZE SCREEN-2C.
           IF ADD-SW = "N"
               MOVE "N"                    TO  DTECHBUL-EOF-SW
               PERFORM 999-GETNEXT-DTECHBUL
               PERFORM 66-LOAD-DTECHBUL
                   UNTIL DTECHBUL-EOF-SW = "Y"
               MOVE ON-SWITCH              TO  IND (30)
           ELSE
               MOVE 1 TO DATE-MODE
               CALL "TDATECHK" USING DATE-CHECK-AREA
               MOVE DATE-SLASH-OUT (1:6)   TO  DE2C-DATE (1:6)
               MOVE "20"                   TO  DE2C-DATE (7:2)
               MOVE DATE-SLASH-OUT (7:2)   TO  DE2C-DATE (9:2)
               MOVE USERNAME               TO  DE2C-USER.

      *--- SHOW FUNCTION KEYS.
           WRITE DISPLAY-REC FROM SCREEN-2C
               FORMAT IS "TECHREC"
               INDICATORS ARE SRF-INDICATORS.
           MOVE ALL B"0" TO SRF-INDICATORS.

           MOVE ON-SWITCH TO IND (70)  IND (71)  IND (73).

      *--- WRITE THE SUBFILE TO SCREEN.
           WRITE SUBFILE DISPLAY-REC FROM SCREEN-2A
               FORMAT IS "TECHSFLC"
               INDICATORS ARE SRF-INDICATORS.
           MOVE ALL B"0" TO SRF-INDICATORS.
           IF DISPLAY-STATUS NOT = "00"
               MOVE "PROBLEM ON SHOW SFL WRITE" TO BU-DISPLAY-MSG
               MOVE REC-COUNT TO BU-DISPLAY-FLD (1)
               MOVE DISPLAY-STATUS TO BU-DISPLAY-FLD (2)
               PERFORM 2-BLOWUP.

      *--- WAIT FOR USER TO PRESS A KEY.
           READ DISPLAY-FILE INTO SCREEN-2C
               FORMAT IS "TECHREC"
               INDICATORS ARE SRF-INDICATORS.
           MOVE ALL B"0" TO SRF-INDICATORS.
           IF DISPLAY-STATUS NOT = "00"
               MOVE "PROBLEM ON READ SFL" TO BU-DISPLAY-MSG
               PERFORM 2-BLOWUP.

       62-ACTION.

           IF F3-KEY-USED
               GO TO 62-LS-X.

           IF F2-KEY-USED
               PERFORM 69-COMPLIANCE-SCREEN THRU 69-CS-X
               GO TO 62-LOAD-SCREEN.

           IF ENTER-KEY-USED
               PERFORM 67-ADD-DTECHBUL
               IF UPDATE-SW = "N" AND DE2C-TB-LINES = SPACES
                   NEXT SENTENCE
               ELSE
               IF ADD-SW = "Y"
      ***  TECHNICAL BULLETIN HAS BEEN ADDED
                   MOVE  75 TO LANG-MSGNUM
               ELSE
      ***  TECHNICAL BULLETIN HAS BEEN UPDATED
                   MOVE  76 TO LANG-MSGNUM
               END-IF
               MOVE  20 TO LANG-SETNUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE "Y" TO ERR-MSG.

           IF F6-KEY-USED
               PERFORM 68-DELETE-DTECHBUL
      ***  TECHNICAL BULLETIN HAS BEEN DELETED
               MOVE  20 TO LANG-SETNUM
               MOVE  77 TO LANG-MSGNUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE "Y" TO ERR-MSG.

       62-LS-X.
           EXIT.

       63-GET-DMANPART.
           MOVE MAN-PARTNO-TYPE          TO  CFINPTYP-TYPE-DB.

           CALL "CFINPTYP" USING CFINPTYP-PARMS.
           MOVE "N"                      TO  CFINPTYP-1ST-CALL.

           IF MAN-PARTNO-SELECT NOT = SPACES
               MOVE "("               TO  FULL-DESC-LINE-P1
               MOVE MAN-PARTNO-SELECT TO  FULL-DESC-LINE-SEL
               MOVE ")"               TO  FULL-DESC-LINE-P2.

           MOVE MAN-NAME              TO  FULL-DESC-LINE-MFR.
           MOVE CFINPTYP-TYPE-SHORT   TO  FULL-DESC-LINE-TYPE.
           MOVE MAN-PARTNO            TO  FULL-DESC-LINE-PARTNO.
           PERFORM 999-WRITE-SFLREC.
           PERFORM 999-GETNEXT-DMANPART.

       64-GET-DDESC.
           IF DESC-ID-NUM = "00"
               MOVE DESC-KW           TO  FULL-DESC-LINE-KW
                                          DE3-KW-HOLD
               MOVE DESC-MOD          TO  FULL-DESC-LINE-MOD
                                          DE3-MOD-HOLD
           ELSE
               MOVE DESC-DATA         TO  DE2-DESC-LINE.

           PERFORM 999-WRITE-SFLREC.
           PERFORM 999-GETNEXT-DDESC.

       65-GET-DDESC2.
           IF DESC2-ID-NUM = "00"
               MOVE DESC2-KW          TO  FULL-DESC-LINE-KW
               MOVE DESC2-MOD         TO  FULL-DESC-LINE-MOD
           ELSE
               MOVE DESC2-DATA        TO  DE2-DESC-LINE.

           PERFORM 999-WRITE-SFLREC.
           PERFORM 999-GETNEXT-DDESC2.

       66-LOAD-DTECHBUL.
           IF TECH-ID-NUM = "00"
               MOVE TECH-LAST-ACT-YMD      TO  DATE-VALIDATE-IN
               MOVE 4                      TO  DATE-MODE
               CALL "TDATECHK" USING DATE-CHECK-AREA
               MOVE DATE-SLASH-OUT (1:6)   TO  DE2C-DATE (1:6)
               MOVE TECH-LAST-ACT-CC       TO  DE2C-DATE (7:2)
               MOVE DATE-SLASH-OUT (7:2)   TO  DE2C-DATE (9:2)
               MOVE TECH-USERID            TO  DE2C-USER
           ELSE
               IF TECH-ID-NUM = "01"
                   MOVE TECH-DATA          TO  DE2C-TB-LINE (1)
           ELSE
               IF TECH-ID-NUM = "02"
                   MOVE TECH-DATA          TO  DE2C-TB-LINE (2)
           ELSE
               IF TECH-ID-NUM = "03"
                   MOVE TECH-DATA          TO  DE2C-TB-LINE (3)
           ELSE
               IF TECH-ID-NUM = "04"
                   MOVE TECH-DATA          TO  DE2C-TB-LINE (4).
           PERFORM 999-GETNEXT-DTECHBUL.

       67-ADD-DTECHBUL.
      *---------- ADD/UPDATE THE "00" RECORD.
           MOVE "00"                  TO  DESCIDNUM OF DTECHBUL-REC-IO.
           PERFORM 999-READ-DTECHBUL.
           IF FILE-STATUS = "00"
               MOVE "Y"               TO  UPDATE-SW
           ELSE
               MOVE "N"               TO  UPDATE-SW.
           INITIALIZE BUF-DTECHBUL.
           MOVE CODE-ARG              TO  TECH-CORP-CODE.
           MOVE 1 TO DATE-MODE.
           CALL "TDATECHK" USING DATE-CHECK-AREA.
           MOVE DATE-YMD-OUT          TO  TECH-LAST-ACT-YMD.
           MOVE "20"                  TO  TECH-LAST-ACT-CC.
           MOVE USERNAME              TO  TECH-USERID.
           MOVE "00"                  TO  TECH-ID-NUM.
           IF UPDATE-SW = "Y" AND DE2C-TB-LINES = SPACES
               DELETE DTECHBUL-IO
                   INVALID KEY MOVE FILE-STATUS TO FILE-STATUS
           ELSE
           IF UPDATE-SW = "Y"
               PERFORM 999-REWRITE-DTECHBUL
           ELSE
           IF UPDATE-SW = "N" AND DE2C-TB-LINES = SPACES
               NEXT SENTENCE
           ELSE
               PERFORM 999-WRITE-DTECHBUL.

      *---------- ADD/UPDATE THE "01" TO "04" RECORDS.
           PERFORM VARYING SUB FROM 1 BY 1 UNTIL SUB > 4
               STRING "0" SUB
                   DELIMITED BY SIZE INTO DESCIDNUM OF DTECHBUL-REC-IO
               PERFORM 999-READ-DTECHBUL
               IF FILE-STATUS = "00"
                   MOVE "Y"  TO  UPDATE-SW
               ELSE
                   MOVE "N"  TO  UPDATE-SW
               END-IF
               IF DE2C-TB-LINE (SUB) > SPACES
                   MOVE DE2C-TB-LINE (SUB)  TO  TECH-DATA
                   STRING "0" SUB
                       DELIMITED BY SIZE  INTO  TECH-ID-NUM
                   IF UPDATE-SW = "Y"
                       PERFORM 999-REWRITE-DTECHBUL
                   ELSE
                       PERFORM 999-WRITE-DTECHBUL
                   END-IF
               END-IF
               IF DE2C-TB-LINE (SUB) = SPACES AND UPDATE-SW = "Y"
                   DELETE DTECHBUL-IO
                       INVALID KEY MOVE FILE-STATUS TO FILE-STATUS
                   END-DELETE
                   IF FILE-STATUS NOT = "00"
                       MOVE "67AD: PROBLEM WITH DELETE DTECHBUL"
                                        TO BU-DISPLAY-MSG
                       MOVE REC-COUNT   TO BU-DISPLAY-FLD (1)
                       MOVE FILE-STATUS TO BU-DISPLAY-FLD (2)
                       PERFORM 2-BLOWUP
                   END-IF
               END-IF
           END-PERFORM.

       68-DELETE-DTECHBUL.
           PERFORM 999-START-DTECHBUL.
           IF FILE-STATUS = "00"
               MOVE "N" TO DTECHBUL-EOF-SW
               PERFORM 999-GETNEXT-DTECHBUL
               PERFORM UNTIL DTECHBUL-EOF-SW = "Y"
                   DELETE DTECHBUL-IO
                       INVALID KEY MOVE FILE-STATUS TO FILE-STATUS
                   END-DELETE
                   IF FILE-STATUS NOT = "00"
                       MOVE "68DD: PROBLEM WITH DELETE DTECHBUL"
                                        TO BU-DISPLAY-MSG
                       MOVE REC-COUNT   TO BU-DISPLAY-FLD (1)
                       MOVE FILE-STATUS TO BU-DISPLAY-FLD (2)
                       PERFORM 2-BLOWUP
                   END-IF
                   PERFORM 999-GETNEXT-DTECHBUL
               END-PERFORM.

      *****************************************************************
      ***  M P 8 - 3   S C R E E N
      *****************************************************************

       69-COMPLIANCE-SCREEN.
           MOVE "CMPLREC"  TO  VIEW-NFNAME.
           MOVE SPACES  TO  SCREEN-3.
           MOVE SAVE-COMPANY-CODE  TO  DISP-COMP-3.
           MOVE CODE-ARG           TO  DE3-CODE.
           MOVE DE3-KW-HOLD        TO  DE3-KW.
           MOVE DE3-MOD-HOLD       TO  DE3-MOD.

           INITIALIZE REC-COUNT.

           PERFORM 999-START-DCOMPL.
           IF FILE-STATUS = "00"
               MOVE "N"         TO ADD-SW
               MOVE ON-SWITCH   TO IND (30)
           ELSE
               MOVE "Y"         TO ADD-SW.

           IF ADD-SW = "N"
               MOVE "N"                    TO  DCOMPL-EOF-SW
               PERFORM 999-GETNEXT-DCOMPL
               PERFORM 71-LOAD-DCOMPL
                   UNTIL DCOMPL-EOF-SW = "Y"
               MOVE ON-SWITCH              TO  IND (30)
           ELSE
               MOVE 1 TO DATE-MODE
               CALL "TDATECHK" USING DATE-CHECK-AREA
               MOVE DATE-SLASH-OUT (1:6)   TO  DE3-DATE (1:6)
               MOVE "20"                   TO  DE3-DATE (7:2)
               MOVE DATE-SLASH-OUT (7:2)   TO  DE3-DATE (9:2)
               MOVE USERNAME               TO  DE3-USER.

      *    IF ERR-MSG = "Y"
      *        PERFORM 4-PGM-ERROR  THRU  4-PGM-ERROR-X
      *        MOVE "N"        TO  ERR-MSG.

       69-SHOWFORM-SCREEN-3.
           MOVE SCREEN-3       TO DISPLAY-REC.
           PERFORM 998-WRITE-SCREEN THRU 998-READ-SCREEN.
           MOVE DISPLAY-REC    TO SCREEN-3.

           IF VIEW-LASTKEY = 3
               GO TO 69-CS-X
           ELSE
           IF ENTER-KEY-USED
               PERFORM 70-ADD-DCOMPL
           ELSE
           IF F6-KEY-USED
               PERFORM 72-DELETE-DCOMPL
      ***  TECHNICAL BULLETIN HAS BEEN DELETED
      *        MOVE  20 TO LANG-SETNUM
      *        MOVE  77 TO LANG-MSGNUM
      *        PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
      *        MOVE "Y" TO ERR-MSG
           ELSE
           IF VIEW-LASTKEY = 1 OR
              VIEW-LASTKEY = 2 OR
              VIEW-LASTKEY = 4 OR
              VIEW-LASTKEY = 5 OR
              VIEW-LASTKEY = 7 OR
              VIEW-LASTKEY = 8
      ***      INVALID FUNCTION KEY
               MOVE   9 TO LANG-SETNUM
               MOVE  10 TO LANG-MSGNUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE 2  TO  FIELD-NUMBER
               PERFORM 4-PGM-ERROR  THRU  4-PGM-ERROR-X
               GO TO 69-SHOWFORM-SCREEN-3.

       69-CS-X.
           EXIT.

       70-ADD-DCOMPL.
      *---------- ADD/UPDATE THE "00" RECORD.
           MOVE "00"                  TO  DESCIDNUM OF DCOMPL-REC-IO.
           PERFORM 999-READ-DCOMPL.
           IF FILE-STATUS = "00"
               MOVE "Y"               TO  UPDATE-SW
           ELSE
               MOVE "N"               TO  UPDATE-SW.
           INITIALIZE BUF-DCOMPL.
           MOVE CODE-ARG              TO  CMPL-CORP-CODE.
           MOVE 1 TO DATE-MODE.
           CALL "TDATECHK" USING DATE-CHECK-AREA.
           MOVE DATE-YMD-OUT          TO  CMPL-LAST-ACT-YMD.
           MOVE "20"                  TO  CMPL-LAST-ACT-CC.
           MOVE USERNAME              TO  CMPL-USERID.
           MOVE "00"                  TO  CMPL-ID-NUM.
           IF UPDATE-SW = "Y" AND DE3-COMPLIANCE-LINES = SPACES
               DELETE DCOMPL-IO
                   INVALID KEY MOVE FILE-STATUS TO FILE-STATUS
           ELSE
           IF UPDATE-SW = "Y"
               PERFORM 999-REWRITE-DCOMPL
           ELSE
           IF UPDATE-SW = "N" AND DE3-COMPLIANCE-LINES = SPACES
               NEXT SENTENCE
           ELSE
               PERFORM 999-WRITE-DCOMPL.

      *---------- ADD/UPDATE THE "01" TO "05" RECORDS.
           PERFORM VARYING SUB FROM 1 BY 1 UNTIL SUB > 5
               STRING "0" SUB
                   DELIMITED BY SIZE INTO DESCIDNUM OF DCOMPL-REC-IO
               PERFORM 999-READ-DCOMPL
               IF FILE-STATUS = "00"
                   MOVE "Y"  TO  UPDATE-SW
               ELSE
                   MOVE "N"  TO  UPDATE-SW
               END-IF
               IF DE3-COMPLIANCE (SUB) > SPACES
                   MOVE DE3-COMPLIANCE (SUB)  TO  CMPL-DATA
                   STRING "0" SUB
                       DELIMITED BY SIZE  INTO  CMPL-ID-NUM
                   IF UPDATE-SW = "Y"
                       PERFORM 999-REWRITE-DCOMPL
                   ELSE
                       PERFORM 999-WRITE-DCOMPL
                   END-IF
               END-IF
               IF DE3-COMPLIANCE (SUB) = SPACES AND UPDATE-SW = "Y"
                   DELETE DCOMPL-IO
                       INVALID KEY MOVE FILE-STATUS TO FILE-STATUS
                   END-DELETE
                   IF FILE-STATUS NOT = "00"
                       MOVE "70AD: PROBLEM WITH DELETE DCOMPL"
                                        TO BU-DISPLAY-MSG
                       MOVE REC-COUNT   TO BU-DISPLAY-FLD (1)
                       MOVE FILE-STATUS TO BU-DISPLAY-FLD (2)
                       PERFORM 2-BLOWUP
                   END-IF
               END-IF
           END-PERFORM.

       71-LOAD-DCOMPL.
           IF CMPL-ID-NUM = "00"
               MOVE CMPL-LAST-ACT-YMD      TO  DATE-VALIDATE-IN
               MOVE 4                      TO  DATE-MODE
               CALL "TDATECHK" USING DATE-CHECK-AREA
               MOVE DATE-SLASH-OUT (1:6)   TO  DE3-DATE (1:6)
               MOVE CMPL-LAST-ACT-CC       TO  DE3-DATE (7:2)
               MOVE DATE-SLASH-OUT (7:2)   TO  DE3-DATE (9:2)
               MOVE CMPL-USERID            TO  DE3-USER
           ELSE
               IF CMPL-ID-NUM = "01"
                   MOVE CMPL-DATA          TO  DE3-COMPLIANCE (1)
           ELSE
               IF CMPL-ID-NUM = "02"
                   MOVE CMPL-DATA          TO  DE3-COMPLIANCE (2)
           ELSE
               IF CMPL-ID-NUM = "03"
                   MOVE CMPL-DATA          TO  DE3-COMPLIANCE (3)
           ELSE
               IF CMPL-ID-NUM = "04"
                   MOVE CMPL-DATA          TO  DE3-COMPLIANCE (4)
           ELSE
               IF CMPL-ID-NUM = "05"
                   MOVE CMPL-DATA          TO  DE3-COMPLIANCE (5).
           PERFORM 999-GETNEXT-DCOMPL.

       72-DELETE-DCOMPL.
           PERFORM 999-START-DCOMPL.
           IF FILE-STATUS = "00"
               MOVE "N" TO DCOMPL-EOF-SW
               PERFORM 999-GETNEXT-DCOMPL
               PERFORM UNTIL DCOMPL-EOF-SW = "Y"
                   DELETE DCOMPL-IO
                       INVALID KEY MOVE FILE-STATUS TO FILE-STATUS
                   END-DELETE
                   IF FILE-STATUS NOT = "00"
                       MOVE "72DD: PROBLEM WITH DELETE DCOMPL"
                                        TO BU-DISPLAY-MSG
                       MOVE REC-COUNT   TO BU-DISPLAY-FLD (1)
                       MOVE FILE-STATUS TO BU-DISPLAY-FLD (2)
                       PERFORM 2-BLOWUP
                   END-IF
                   PERFORM 999-GETNEXT-DCOMPL
               END-PERFORM.

      *****************************************************************
      ***  U T I L I T Y   P A R A G R A P H S
      *****************************************************************

       COPY DISPCALL IN COPYLIB.

       998-AUTO-READ-SCREEN.
           READ  DISPLAY-FILE TERMINAL IS TERMINAL-ID
               INDIC ARE SRF-INDICATORS
                   NO DATA MOVE DISPLAY-STATUS TO DISPLAY-STATUS.
           MOVE ALL B"0" TO SRF-INDICATORS.

       999-CATREAD.
           IF CATREAD-MSG-NUMBER = ZEROS
               MOVE LANG-SETNUM TO CATREAD-MSG-SET
               MOVE LANG-MSGNUM TO CATREAD-MSG-NUM.
           CALL "CCATREAD" USING CATREAD-PARMS.
           MOVE CATREAD-MSG-TEXT TO MESSAGE-BUFFER.

       999-CATREAD-EXIT.
           EXIT.

       999-START-DMANPART.
           MOVE CODE-ARG TO CORPCDE OF DMANPART-CD-REC-I.
           START DMANPART-CD-I KEY = CORPCDE OF DMANPART-CD-REC-I
               INVALID KEY MOVE "Y" TO DMANPART-EOF-SW.

       999-START-DDESC.
           MOVE CODE-ARG TO CORPCDE OF DDESC-CD-REC-I.
           START DDESC-CD-I KEY = CORPCDE OF DDESC-CD-REC-I
               INVALID KEY MOVE "Y" TO DDESC-EOF-SW.

       999-START-DDESC2.
           MOVE CODE-ARG TO CORPCDE OF DDESC2-CD-REC-I.
           START DDESC2-CD-I KEY = CORPCDE OF DDESC2-CD-REC-I
               INVALID KEY MOVE "Y" TO DDESC2-EOF-SW.

       999-START-DTECHBUL.
           MOVE CODE-ARG TO CORPCDE OF DTECHBUL-REC-IO.
           START DTECHBUL-IO KEY = CORPCDE OF DTECHBUL-REC-IO
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.

       999-START-DCOMPL.
           MOVE CODE-ARG TO CORPCDE OF DCOMPL-REC-IO.
           START DCOMPL-IO KEY = CORPCDE OF DCOMPL-REC-IO
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.

       999-GETNEXT-DMANPART.
           READ DMANPART-CD-I NEXT INTO BUF-DMANPART
               AT END MOVE "Y" TO DMANPART-EOF-SW.
           IF CORPCDE OF DMANPART-CD-REC-I NOT = CODE-ARG
               MOVE "Y" TO DMANPART-EOF-SW.

       999-GETNEXT-DDESC.
           READ DDESC-CD-I NEXT INTO BUF-DDESC
               AT END MOVE "Y" TO DDESC-EOF-SW.
           IF CORPCDE OF DDESC-CD-REC-I NOT = CODE-ARG
               MOVE "Y" TO DDESC-EOF-SW.

       999-GETNEXT-DDESC2.
           READ DDESC2-CD-I NEXT INTO BUF-DDESC2
               AT END MOVE "Y" TO DDESC2-EOF-SW.
           IF CORPCDE OF DDESC2-CD-REC-I NOT = CODE-ARG
               MOVE "Y" TO DDESC2-EOF-SW.

       999-GETNEXT-DTECHBUL.
           READ DTECHBUL-IO NEXT INTO BUF-DTECHBUL
               AT END MOVE "Y" TO DTECHBUL-EOF-SW.
           IF CORPCDE OF DTECHBUL-REC-IO NOT = CODE-ARG
               MOVE "Y" TO DTECHBUL-EOF-SW.

       999-GETNEXT-DCOMPL.
           READ DCOMPL-IO NEXT INTO BUF-DCOMPL
               AT END MOVE "Y" TO DCOMPL-EOF-SW.
           IF CORPCDE OF DCOMPL-REC-IO NOT = CODE-ARG
               MOVE "Y" TO DCOMPL-EOF-SW.

       999-WRITE-SFLREC.
           MOVE DE2-DESC-LINE        TO DISPLAY-REC.
           ADD 1                     TO REC-COUNT.
           WRITE SUBFILE DISPLAY-REC FROM SCREEN-2B
               FORMAT IS "TECHSFL"
               INDICATORS ARE SRF-INDICATORS.
           IF DISPLAY-STATUS NOT = "00"
               MOVE "SUBFILE WRITE ERROR" TO BU-DISPLAY-MSG
               MOVE REC-COUNT        TO BU-DISPLAY-FLD (1)
               MOVE DISPLAY-STATUS   TO BU-DISPLAY-FLD (2)
               PERFORM 2-BLOWUP.
           INITIALIZE DE2-DESC-LINE.

       999-WRITE-DTECHBUL.
           WRITE DTECHBUL-REC-IO FROM BUF-DTECHBUL
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           INITIALIZE TECH-DATA.

       999-WRITE-DCOMPL.
           WRITE DCOMPL-REC-IO FROM BUF-DCOMPL
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           INITIALIZE CMPL-DATA.

       999-REWRITE-DTECHBUL.
           REWRITE DTECHBUL-REC-IO FROM BUF-DTECHBUL
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           INITIALIZE TECH-DATA.

       999-REWRITE-DCOMPL.
           REWRITE DCOMPL-REC-IO FROM BUF-DCOMPL
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           INITIALIZE CMPL-DATA.

       999-READ-DTECHBUL.
           MOVE CODE-ARG  TO  CORPCDE OF DTECHBUL-REC-IO.
           READ DTECHBUL-IO INTO BUF-DTECHBUL
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.

       999-READ-DCOMPL.
           MOVE CODE-ARG  TO  CORPCDE OF DCOMPL-REC-IO.
           READ DCOMPL-IO INTO BUF-DCOMPL
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
