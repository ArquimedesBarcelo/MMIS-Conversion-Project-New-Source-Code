000200 IDENTIFICATION DIVISION.
000300 PROGRAM-ID.          TCODEDLM.
000400 AUTHOR.              C HILLES.
000500 DATE-WRITTEN.        04/01/86.
000600 DATE-COMPILED.
000700*INSTALLATION.        GOODYEAR TIRE AND RUBBER - AKRON.
000800*SECURITY.
000900*REMARKS.
001000*D   THIS IS AN EXECUTIVE PROGRAM WHICH CALLS THE CORP CODE
001100*D   DELETE SUBPROGRAM "SCODEDEL".  THIS BECOMES THE STAND-ALONE
001200*D   MODULE FOR CORP CODE DELETE.
001300
001400
001500 ENVIRONMENT DIVISION.
001600 CONFIGURATION SECTION.
001700 SOURCE-COMPUTER.  HP-3000.
001800 OBJECT-COMPUTER.  HP-3000.
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT MPLTINFO-PK-I
               ASSIGN TO DATABASE-MCFLCS0501
               ORGANIZATION IS INDEXED
                 ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
               FILE STATUS IS FILE-STATUS.
001900
002000 DATA DIVISION.
       FILE SECTION.
       FD  MPLTINFO-PK-I
           LABEL RECORDS ARE STANDARD.
       01  MPLTINFO-PK-REC-I.
           COPY DDS-MCRPCS0500  OF MCFLCS0501.

002100 WORKING-STORAGE SECTION.
002200
002300**************************************************************
002400**                                                          **
002500**     C O M M U N I C A T I O N S   A R E A S              **
002600**                                                          **
002700**************************************************************
002800
002900 COPY TBLOWUP    IN COPYLIB.
003000
003100 01  MPLTINFO-PARMS.
003200     05  PLANT-CODE                PIC X(3)  VALUE SPACES.
003300     05  DDESC-LANG                PIC X(3)  VALUE SPACES.
003400     05  DDESC2-LANG               PIC X(3)  VALUE SPACES.
003500
003600**************************************************************
003700**                                                          **
003800**                  V I E W   W O R K                       **
003900**                                                          **
004000**************************************************************
004100
       COPY VCOMAREA IN COPYLIB.
008800 01  FORMFILE.
008900     05  FORM-FNAME                PIC X(8)  VALUE "FDSCMAIN".
009000     05  FILLER                    PIC X     VALUE ".".
009100     05  FORM-GNAME.
009200         10  FORM-GNAME1           PIC X(5)  VALUE "FLANG".
009300         10  FORM-GNAME2           PIC X(3)  VALUE SPACES.
009400     05  FILLER                    PIC X(19) VALUE SPACES.
009500
009600 01  TERMFILENAME         PIC X(11) VALUE "TERMLIST;".
009700
009800 01  MESSAGE-ACTLEN            PIC S9(4)    VALUE ZERO    BINARY.
009900
010000 01  MESSAGE-BUFFER.
010100     05  MSG-TEXT              PIC X(68)    VALUE SPACE.
010200     05  MSG-FLD               PIC X(8)     VALUE SPACE.
010300     05  MSG-FLD-9  REDEFINES  MSG-FLD      PIC ZZZZZZZ9.
010400
010500**************************************************************
010600**                                                          **
010700**            D A T A B A S E   W O R K                     **
010800**                                                          **
010900**************************************************************
       01  FILE-STATUS.
           05  FILE-STATUS-1            PIC X  VALUE "0".
           05  FILE-STATUS-2            PIC X  VALUE "0".
011000
       COPY DBSTAT   IN COPYLIB.
011100 01  BASE                       PIC X(24) VALUE "  STORES;".
011200 01  PASSWORD                   PIC X(5)  VALUE "JADE;".
012100 01  DSET-NAMES.
012200     05  DSET-DUMMY             PIC X(2)  VALUE SPACES.
012300     05  DSET-MPLTINFO          PIC X(16) VALUE "MPLTINFO;".
012400
012500 01  MODE-AREA.
012600     05  MODE1                  PIC S9(4) BINARY VALUE 1.
012700     05  MODE7                  PIC S9(4) BINARY VALUE 7.
012800
012900 01  ALL-ITEM-LIST              PIC X(2)  VALUE "@;".
013000
013100 01  PLT-ARG                    PIC X(4)  VALUE "P 01".
013200
013300**************************************************************
013400**                                                          **
013500**            D A T A B A S E   B U F F E R S               **
013600**                                                          **
013700**************************************************************
013800
013900 COPY MPLTINFO   IN COPYLIB.
014000
014100**************************************
014200*                                    *
014300*    NATIVE LANGUAGE SUPPORT AREA    *
014400*                                    *
014500**************************************
014600
014700 COPY LANGUAGE   IN COPYLIB.
014800
014900
015000 PROCEDURE DIVISION.
015100 1-HOUSEKEEP SECTION.
015200
           PERFORM 9999-OPEN-STUFF.

018700     MOVE "P 01" TO PLT-ARG.
           PERFORM 9999-DBGET7-MPLTINFO-PK-I.
019700
019800     MOVE MPLTINFO-COMPANY TO PLANT-CODE.
019900
020000     MOVE "PLAN" TO PLT-ARG.
           PERFORM 9999-DBGET7-MPLTINFO-PK-I.
020900
021000     MOVE PRIMARY-LANGUAGE    TO DDESC-LANG.
021100     MOVE SECONDARY-LANGUAGE  TO DDESC2-LANG.
021200
021300     CALL "SCODEDEL" USING BASE, VIEW-COMAREA, LANGUAGE-PARMS,
021400       MPLTINFO-PARMS.
021500
021600
021700 1-EOJ.
           PERFORM 9999-CLOSE-STUFF.
           GOBACK.
022400
022500 2100-BLOWUP.
022600     MOVE "TCODEDLM"               TO  BU-PGM-NAME.
022700     CALL "TBLOWUP" USING BASE, BU-PGM-NAME, STATUS-AREA,
022800       VIEW-COMAREA, FILE-STATUS, BU-DISPLAY-MSG,
022900       BU-DISPLAY-FLDS.

       9999-DBGET7-MPLTINFO-PK-I.
           MOVE 0 TO COND-WORD.
           MOVE PLT-ARG TO PLTINFOKEY OF MPLTINFO-PK-REC-I.
           READ MPLTINFO-PK-I INTO BUF-MPLTINFO
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS = "23"
               MOVE 17 TO COND-WORD
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE "DBGET7 ERR 9999-DBGET7-MPLTINFO-PK-I"
                   TO BU-MSG-AREA
               MOVE 99 TO COND-WORD
               PERFORM 2100-BLOWUP.

       9999-OPEN-STUFF.
           OPEN INPUT MPLTINFO-PK-I                              .

       9999-CLOSE-STUFF.
           CLOSE      MPLTINFO-PK-I                              .
