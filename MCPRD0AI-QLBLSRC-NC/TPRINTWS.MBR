           05  TL-LABOR    PIC Z(11).99.
           05  FILLER      PIC X     VALUE SPACE.
           05  FILLER      PIC X(6)  VALUE "T EST ".
           05  TL-TOTAL    PIC Z(11).99.
       01  TOTALS-WORKAREA.
           05  TOTAL-STORES-EST            PIC S9(12)V99.
           05  TOTAL-PURCH-EST             PIC S9(12)V99.
           05  TOTAL-LABOR-EST             PIC S9(12)V99.
           05  TOTAL-DOLLAR-EST            PIC S9(12)V99.
       01  TRUE-VAL                        PIC 1 VALUE B"1".
       01  WHO-PARMS.
           05  USERNAME                    PIC X(10).
           05  TERMNUM                     PIC X(10).
           05  CURRLIB                     PIC X(10).
           05  JOBLIBX                     PIC X.
       01  WO-NUMBER.
           05  WO-NUM-1-10.
               10  WO-NUM-1-7.
                   15  WO-NUM-1-6          PIC X(6).
                   15  WO-NUM-7            PIC X.
               10  FILLER                  PIC XXX.
           05  WO-CMD-LINE                 PIC X(79).
           05  WO-ERR-LINE                 PIC X(79).
       01  WO-MATERIAL-USED-DATA.
         COPY DWOPARTS IN COPYLIB.
       01  WRITE-YEAR-BUFFER.
           05  FILLER                      PIC X(6)  VALUE SPACES.
           05  WRITE-YEAR-BUF-7            PIC X.
           05  FILLER                      PIC X     VALUE SPACES.
           05  FILLER                      PIC XX VALUE SPACES.
       COPY WSCONTROL IN COPYLIB.
       01  ZONE-SPOOLER-WA.
           05  ZONE-KEY                    PIC X(4).
           05  ZONE-SPOOLER-NUM-V          PIC 99.
           05  ZONE-SPOOLER-NUM-P          PIC 99.
           05  ZONE-SPOOLER-NUM-E          PIC 99.
           05  ZONE-SPOOLER-NUM-M          PIC 99.
           05  ZONE-SPOOLER-NUM-X          PIC 99.
       LINKAGE SECTION.
       01 DBPARAMETERS.
         COPY DBPARMS IN COPYLIB.
       01 WO-PLANNED-DATA.
           COPY DWOPLAN IN COPYLIB.
       01  ERROR-SWITCH.
           05  ERR-SW                      PIC S9(4) COMP-4.
       COPY VCOMLINK IN COPYLIB.
       PROCEDURE DIVISION USING DBPARAMETERS WO-PLANNED-DATA
                            ERROR-SWITCH VIEW-COMAREA.
       START-PGM.
           IF WO-START-STATUS = "AA" OR "AR"
               MOVE SPACES TO ERROR-76
               CALL "SPMSCRWS" USING DBPARAMETERS
                                     WO-PLANNED-DATA
                                     VIEW-COMAREA
                                     LANGUAGE-PARMS
                                     ERROR-76
               GO TO 2-EOJ-END.

           PERFORM 1-HSK.
           PERFORM 6-MAIN.
       2-EOJ.
           IF CPF-SW = 1 CLOSE CH-PRINT-FILE.
      *    IF OVRPRTF-TOFILE-NUM = 0
      *        IF ZONE-KEY = SPACES
      *            NEXT SENTENCE
      *        ELSE
      *        MOVE "DLTOVR FILE(MCPRT)" TO OVRPRTF-PARM1
      *        CALL "QCMDEXC" USING OVRPRTF-PARM1, OVRPRTF-PARM2.
           CLOSE DISPLAY-FILE.
           CLOSE JOBPLAN-FILE.
           CLOSE PERSONNEL-FILE.
           CLOSE WO-LAST-NUM-USED.
           CLOSE WO-PARTS-FILE.
           CLOSE WO-PLANNED-FILE.
           CLOSE ZONE-SPOOLER-FILE.

           IF WO-START-STATUS = "AA" OR "AR"
               MOVE SPACES TO ERROR-76
               CALL "SPMSCRWS" USING DBPARAMETERS
                                     WO-PLANNED-DATA
                                     VIEW-COMAREA
                                     LANGUAGE-PARMS
                                     ERROR-76.
       2-EOJ-END.
           GOBACK.
       1-HSK.
           ACCEPT CHECK-YEAR FROM DATE.
           OPEN I-O   DISPLAY-FILE.
           OPEN INPUT JOBPLAN-FILE.
           OPEN INPUT PERSONNEL-FILE.
           OPEN INPUT WO-LAST-NUM-USED.
           OPEN INPUT WO-PARTS-FILE.
           OPEN INPUT WO-PLANNED-FILE.
           OPEN INPUT ZONE-SPOOLER-FILE.
      *    CALL "TPWORD" USING PASSWORD-INFORMATION.
      *    IF PASSWORD-FLAG = "N" GO TO 2-EOJ.
           CALL "CLWHO" USING USERNAME TERMNUM CURRLIB JOBLIBX.
           MOVE 0 TO COND-WORD.
           READ WO-LAST-NUM-USED INTO LAST-WO-BUFF
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF WLNU-STATUS NOT = "00" MOVE 17 TO COND-WORD.
           IF COND-WORD = 17 MOVE 1 TO DATE-FLAG-SW.
           MOVE DATE-FLAG-SW TO DATE-FLAG.
           MOVE DATE-FLAG TO DATE-CODE.
           MOVE ZEROES TO TOTALS-WORKAREA.
           CALL "TESCSEQ" USING ESC-NAME.
           MOVE SPACES TO BASE-STORES.
           MOVE SPACES TO ZONE-SPOOLER-WA PERSONNEL-DATA.
       6-MAIN.
           MOVE 0 TO CMT-HD-SW UMT-HD-SW COND-WORD FST-JB-SW.
           IF WO-PLANNED-DATA NOT = SPACES
               MOVE WO-NUM-PLANNED TO WO-NUMBER
           ELSE
           PERFORM 60-REQUEST-WORK-ORDER THRU 60-RWO-EXIT.
           PERFORM 61-RETRIEVE-PLANNED THRU 61-RP-EXIT.
      *    IF COND-WORD = 17 GO TO 6-MAIN.
           MOVE ERROR-BUFFER TO CH-PRINT-RECORD.
           WRITE CH-PRINT-RECORD.
           ADD 1 TO LINE-CTR.
           MOVE ASTERISK-LINE TO CH-PRINT-RECORD.
           WRITE CH-PRINT-RECORD.
           ADD 1 TO LINE-CTR.
      *    IF ERROR-SWITCH = "PZ" OR "NP"
      *        IF PLANT-IDENT = "111" OR "112" OR "113" OR "129"
      *            OR "131" OR "133" OR "211"
      *                NEXT SENTENCE
      *        ELSE
      *        IF PLANT-IDENT = "126"
      *            IF OVRPRTF-TOFILE-NUM = 04 OR 05 OR 07 OR
      *                    16 OR 30 OR 31 OR 03 OR 12 OR 35 OR 88
      *                 NEXT SENTENCE
      *            ELSE
      *            MOVE SPACES TO CH-PRINT-RECORD
      *            WRITE CH-PRINT-RECORD AFTER ADVANCING NEW-PAGE
      *            ADD 1 TO LINE-CTR
      *            MOVE SPACES TO CH-PRINT-RECORD
      *            GO TO 2-EOJ.
           IF PLANT-IDENT = "133"
               IF ERROR-SWITCH = "TE" OR "TP"
                   MOVE SPACES TO CH-PRINT-RECORD
                   WRITE CH-PRINT-RECORD AFTER ADVANCING NEW-PAGE
                   ADD 1 TO LINE-CTR
                   MOVE SPACES TO CH-PRINT-RECORD
                   GO TO 2-EOJ.
           IF LAST-JOBPLAN-SEQ = "    "
               NEXT SENTENCE
           ELSE
           PERFORM 62-RETRIEVE-JOBPLAN THRU 62-RJ-EXIT
      *    IF JB-SEQ-X = "   "
      *        MOVE ERROR-BUFFER TO CH-PRINT-RECORD
      *        WRITE CH-PRINT-RECORD AFTER ADVANCING 1 LINES
      *        ADD 1 TO LINE-CTR
      *        MOVE ASTERISK-LINE TO CH-PRINT-RECORD
      *        WRITE CH-PRINT-RECORD AFTER ADVANCING 1 LINES
      *        ADD 1 TO LINE-CTR
      *    ELSE
           IF TOTAL-LABOR-EST > 0
               MOVE ASTERISK-LINE TO CH-PRINT-RECORD
               WRITE CH-PRINT-RECORD AFTER ADVANCING 1 LINES
               ADD 1 TO LINE-CTR
           ELSE
           MOVE ERROR-BUFFER TO CH-PRINT-RECORD
           WRITE CH-PRINT-RECORD AFTER ADVANCING 1 LINES
           ADD 1 TO LINE-CTR
           MOVE ASTERISK-LINE TO CH-PRINT-RECORD
           WRITE CH-PRINT-RECORD AFTER ADVANCING 1 LINES
           ADD 1 TO LINE-CTR.
           MOVE 0 TO MT-ITM.
           PERFORM 63-RETRIEVE-STORES  THRU 63-RS-EXIT.
           IF TOTAL-STORES-EST > 0
               MOVE ASTERISK-LINE TO CH-PRINT-RECORD
               WRITE CH-PRINT-RECORD AFTER ADVANCING 1 LINES
               ADD 1 TO LINE-CTR
           ELSE
           MOVE ERROR-BUFFER TO CH-PRINT-RECORD
           WRITE CH-PRINT-RECORD AFTER ADVANCING 1 LINES
           ADD 1 TO LINE-CTR
           MOVE ASTERISK-LINE TO CH-PRINT-RECORD
           WRITE CH-PRINT-RECORD AFTER ADVANCING 1 LINES
           ADD 1 TO LINE-CTR.
           MOVE 0 TO PM-ITM.
           PERFORM 64-RETRIEVE-PURCHASED THRU 64-RP-EXIT.
           ADD 3 TO LINE-CTR.
           MOVE TOTAL-STORES-EST TO TL-STORES.
           MOVE TOTAL-PURCH-EST TO TL-PURCH.
           MOVE TOTAL-LABOR-EST TO TL-LABOR.
           MOVE TOTAL-DOLLAR-EST TO TL-TOTAL.
           MOVE TL-EST-LINE TO CH-PRINT-RECORD.
           WRITE CH-PRINT-RECORD AFTER ADVANCING 2 LINES.
           MOVE ASTERISK-LINE TO CH-PRINT-RECORD.
           WRITE CH-PRINT-RECORD AFTER ADVANCING 1 LINES.
           MOVE SPACES TO CH-PRINT-RECORD.
      *    WRITE CH-PRINT-RECORD AFTER ADVANCING NEW-PAGE.
           ADD 1 TO LINE-CTR.
           MOVE SPACES TO CH-PRINT-RECORD.
       60-REQUEST-WORK-ORDER.
           IF CHECK-YEAR-NUM = 0
               MOVE "A" TO WRITE-YEAR-BUF-7
           ELSE
           IF CHECK-YEAR-NUM = 1
               MOVE "B" TO WRITE-YEAR-BUF-7
           ELSE
           IF CHECK-YEAR-NUM = 2
               MOVE "C" TO WRITE-YEAR-BUF-7
           ELSE
           IF CHECK-YEAR-NUM = 3
               MOVE "D" TO WRITE-YEAR-BUF-7
           ELSE
           IF CHECK-YEAR-NUM = 4
               MOVE "E" TO WRITE-YEAR-BUF-7
           ELSE
           IF CHECK-YEAR-NUM = 5
               MOVE "F" TO WRITE-YEAR-BUF-7
           ELSE
           IF CHECK-YEAR-NUM = 6
               MOVE "G" TO WRITE-YEAR-BUF-7
           ELSE
           IF CHECK-YEAR-NUM = 7
               MOVE "H" TO WRITE-YEAR-BUF-7
           ELSE
           IF CHECK-YEAR-NUM = 8
               MOVE "J" TO WRITE-YEAR-BUF-7
           ELSE
           IF CHECK-YEAR-NUM = 9
               MOVE "K" TO WRITE-YEAR-BUF-7.
           MOVE SPACES TO WO-NUMBER.
           MOVE WRITE-YEAR-BUF-7 TO WO-NUM-7.
           MOVE "FPRINTWS" TO VIEW-CFNAME.
           MOVE ERROR-BUFFER TO WO-ERR-LINE.
           MOVE WO-NUMBER TO DSPLY-REC.
           PERFORM 99-SCREEN-WRITE.
           PERFORM 98-SCREEN-READ.
           MOVE SPACES TO ERROR-BUFFER.
           MOVE DSPLY-REC TO WO-NUMBER.
           IF VIEW-LASTKEY = 1 OR 3 GO TO 2-EOJ.
      *
      *    ALIGN WORK ORDER NUMBER
      *
           CALL "TALWONO" USING WO-NUMBER RETURN-CODE.
           IF RETURN-CODE = "1"
               MOVE "0" TO RETURN-CODE
               MOVE WO-NUMBER TO WO-1-10
               MOVE 47005 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE TRUE-VAL TO INDS (1) INDS (99)
               GO TO 60-REQUEST-WORK-ORDER.
           PERFORM 69-START-WO-PLANNED-FILE.
           IF COND-WORD = 17
               MOVE 29034 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE TRUE-VAL TO INDS (1) INDS (99)
               GO TO 60-REQUEST-WORK-ORDER.
       60-RWO-EXIT.    EXIT.
       61-RETRIEVE-PLANNED.
           IF WO-PLANNED-DATA NOT = SPACES
               NEXT SENTENCE
           ELSE
           PERFORM 69-READ-WO-PLANNED-FILE
           IF COND-WORD = 15
               MOVE 29035 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE TRUE-VAL TO INDS (1) INDS (99)
               GO TO 61-RP-EXIT.
           MOVE SPACES TO ZONE-SPOOLER-WA.
      *    ERROR-SWITCH HAS BEEN SET IN TMODWORK TO 'TE' OR "TP" IF
      *    A USER DECIDES TO TRANSFER A WORK ORDER FROM THE VERBAL
      *    LOOP TO THE PLANNED LOOP, OR FROM THE PLANNED LOOP TO
      *    THE ENGINEERING LOOP.
           IF ERROR-SWITCH = "TE"
               MOVE "ENG " TO ZONE-KEY
           ELSE
           IF PLANT-IDENT = "126"
               IF ERROR-SWITCH = "PZ"
                   IF ZONE-P = "M    "
                       MOVE "SHOP" TO ZONE-KEY
                   ELSE
                   MOVE ZONE-P TO ZONE-KEY
               ELSE
               MOVE ZONE-P TO ZONE-KEY
           ELSE
           MOVE ZONE-P TO ZONE-KEY.
           IF ERROR-SWITCH = "TP"
               PERFORM 69-START-ZONE-SPOOLER-FILE
               IF COND-WORD = 17
      *            MOVE 0 TO OVRPRTF-TOFILE-NUM
                   MOVE "P " TO OVRPRTF-TOFILE-NUM-X
               ELSE
               PERFORM 69-READ-ZONE-SPOOLER-FILE
               IF COND-WORD = 15
      *            MOVE 0 TO OVRPRTF-TOFILE-NUM
                   MOVE "P " TO OVRPRTF-TOFILE-NUM-X
               ELSE
               MOVE ZONE-SPOOLER-NUM-P TO OVRPRTF-TOFILE-NUM
           ELSE
      *    MOVE 0 TO OVRPRTF-TOFILE-NUM.
           MOVE "P " TO OVRPRTF-TOFILE-NUM-X.
           COPY OVRPFCALL IN COPYLIB.
       61-RP-CONT.
           OPEN OUTPUT CH-PRINT-FILE.
           MOVE 1 TO CPF-SW.
           IF WO-START-STATUS = "AA" OR "AR"
               GO TO 2-EOJ.
           MOVE 1 TO DATE-MODE.
           MOVE DATE-FLAG TO DATE-CODE.
           CALL "TDATECHK" USING DATE-CHECK-AREA.
           MOVE DATE-SLASH-OUT TO PL-DAT.
           MOVE PL-HEADER00 TO CH-PRINT-RECORD.
           WRITE CH-PRINT-RECORD AFTER ADVANCING 1 LINES.
           MOVE SPACES TO ERROR-BUFFER.
           MOVE ERROR-BUFFER TO CH-PRINT-RECORD.
           WRITE CH-PRINT-RECORD AFTER ADVANCING 1 LINES.
           MOVE PL-HEADER0 TO CH-PRINT-RECORD.
           WRITE CH-PRINT-RECORD AFTER ADVANCING 1 LINES.
           MOVE SPACES TO ERROR-BUFFER.
           MOVE ERROR-BUFFER TO CH-PRINT-RECORD.
           WRITE CH-PRINT-RECORD AFTER ADVANCING 1 LINES.
           MOVE WO-NUM-P TO PL-WO-7.
           MOVE WO-NUM-SUFF-P TO PL-WO-S.
           MOVE WO-STATUS-P TO PL-ST.
           MOVE WO-START-STATUS TO PL-TY.
           MOVE REQUESTER-P TO PL-REQ.
           MOVE PL-LINE-1 TO CH-PRINT-RECORD.
           WRITE CH-PRINT-RECORD AFTER ADVANCING 1 LINES.
           MOVE EQUIP-NUM-P TO PL-EQP.
           MOVE DEPT-P      TO PL-DEPT.
           MOVE ZONE-P      TO PL-ZONE.
           MOVE LOCATION-P  TO PL-LOC.
           MOVE PRIORITY-P  TO PL-PRTY.
           MOVE RIME-P      TO PL-RIME.
           MOVE PL-LINE-2 TO CH-PRINT-RECORD.
           WRITE CH-PRINT-RECORD AFTER ADVANCING 1 LINES.
           MOVE EQUIP-NAME-P TO PL-ENAM.
           MOVE TYPE-NUM-P   TO PL-TYPE.
           MOVE PL-LINE-3 TO CH-PRINT-RECORD.
           WRITE CH-PRINT-RECORD AFTER ADVANCING 1 LINES.
           MOVE EQUIP-DOWN-P TO PL-EDWN.
           MOVE EXP-CLASS-P  TO PL-EXP.
           IF DATE-REQD = "      "
               MOVE DATE-REQD TO PL-REQD-DATE
           ELSE
           MOVE 4 TO DATE-MODE
           MOVE DATE-REQD TO DATE-VALIDATE-IN
           CALL "TDATECHK" USING DATE-CHECK-AREA
           MOVE DATE-SLASH-OUT TO PL-REQD-DATE.
           MOVE TIME-REQD-P-HH TO PL-HH.
           MOVE TIME-REQD-P-MM TO PL-MI.
           MOVE PL-LINE-4 TO CH-PRINT-RECORD.
           WRITE CH-PRINT-RECORD AFTER ADVANCING 1 LINES.
           MOVE DESCRIPTION-1-P TO PL-DESC.
           MOVE PL-LINE-5 TO CH-PRINT-RECORD.
           WRITE CH-PRINT-RECORD AFTER ADVANCING 1 LINES.
           MOVE DESCRIPTION-2-1-P TO PL-DES2.
           MOVE PL-LINE-6 TO CH-PRINT-RECORD.
           WRITE CH-PRINT-RECORD AFTER ADVANCING 1 LINES.
           MOVE DESCRIPTION-2-2-P TO PL-DES3.
           MOVE PL-LINE-7 TO CH-PRINT-RECORD.
           WRITE CH-PRINT-RECORD AFTER ADVANCING 1 LINES.
           MOVE DESCRIPTION-3-1-P TO PL-DES4.
           MOVE PL-LINE-8 TO CH-PRINT-RECORD.
           WRITE CH-PRINT-RECORD AFTER ADVANCING 1 LINES.
           MOVE DESCRIPTION-3-2-P TO PL-DES5.
           MOVE PL-LINE-9 TO CH-PRINT-RECORD.
           WRITE CH-PRINT-RECORD AFTER ADVANCING 1 LINES.
           MOVE SPECL-INSTR-1 TO PL-SI.
           MOVE PL-LINE-10 TO CH-PRINT-RECORD.
           WRITE CH-PRINT-RECORD AFTER ADVANCING 1 LINES.
           MOVE SPECL-INSTR-2 TO PL-SI2.
           MOVE PL-LINE-11 TO CH-PRINT-RECORD.
           WRITE CH-PRINT-RECORD AFTER ADVANCING 1 LINES.
           MOVE SPECL-EQUIP TO PL-SEQP.
           MOVE PL-LINE-12 TO CH-PRINT-RECORD.
           WRITE CH-PRINT-RECORD AFTER ADVANCING 1 LINES.
           MOVE SAFETY-NOTE TO PL-SNOT.
           MOVE PL-LINE-13 TO CH-PRINT-RECORD.
           WRITE CH-PRINT-RECORD AFTER ADVANCING 1 LINES.
           MOVE ENGINEER-P TO PL-ENG.
           MOVE PLANNER-P TO PL-PLN.
           MOVE SCHEDULER-P TO PL-SCHD.
           IF DATE-SCHD = "      "
               MOVE DATE-SCHD TO PL-SCHD-DATE
           ELSE
           MOVE 4 TO DATE-MODE
           MOVE DATE-SCHD TO DATE-VALIDATE-IN
           CALL "TDATECHK" USING DATE-CHECK-AREA
           MOVE DATE-SLASH-OUT TO PL-SCHD-DATE.
           MOVE TIME-SCHD-P-HH TO PL-SHH.
           MOVE TIME-SCHD-P-MM TO PL-SMI.
           MOVE PL-LINE-14 TO CH-PRINT-RECORD.
           WRITE CH-PRINT-RECORD AFTER ADVANCING 1 LINES.
           IF BUDGET-NO = SPACES
               MOVE SPACES TO PL-BUDGET
           ELSE
           MOVE BUDGET-NO-1-3   TO PL-B1-3
           MOVE "-"             TO PL-D1
           MOVE BUDGET-NO-4-5   TO PL-B4-5
           MOVE "-"             TO PL-D2
           MOVE BUDGET-NO-6-7   TO PL-B6-7
           MOVE "-"             TO PL-D3
           MOVE BUDGET-NO-8-10  TO PL-B8-10
           MOVE "R"             TO PL-REV
           MOVE BUDGET-NO-REVNO TO PL-BRNO.
           MOVE REQUEST-NO      TO PL-RNO.
           IF DATE-STRT-P = "      "
               MOVE DATE-STRT-P TO PL-STRT-DATE
           ELSE
           MOVE 4 TO DATE-MODE
           MOVE DATE-STRT-P TO DATE-VALIDATE-IN
           CALL "TDATECHK" USING DATE-CHECK-AREA
           MOVE DATE-SLASH-OUT TO PL-STRT-DATE.
           IF TIME-STRT-P = "    "
               MOVE "  " TO PL-SHR PL-SMI
           ELSE
           MOVE TIME-STRT-P-HH TO PL-SHR
           MOVE TIME-STRT-P-MM TO PL-SMN.
           MOVE PL-LINE-15 TO CH-PRINT-RECORD.
           WRITE CH-PRINT-RECORD AFTER ADVANCING 1 LINES.
           MOVE FAIL-CODE-REASON-P TO PL-FC1-2.
           MOVE FAIL-CODE-SUBSYS-P TO PL-FC3-6.
           IF DATE-COMP-P = "      "
               MOVE DATE-COMP-P TO PL-COMP-DATE
           ELSE
           MOVE 4 TO DATE-MODE
           MOVE DATE-COMP-P TO DATE-VALIDATE-IN
           CALL "TDATECHK" USING DATE-CHECK-AREA
           MOVE DATE-SLASH-OUT TO PL-COMP-DATE.
           IF TIME-COMP-P = "    "
               MOVE "  " TO PL-CHR PL-CMI
           ELSE
           MOVE TIME-COMP-P-HH TO PL-CHR
           MOVE TIME-COMP-P-MM TO PL-CMI.
           MOVE PL-LINE-16 TO CH-PRINT-RECORD.
           WRITE CH-PRINT-RECORD AFTER ADVANCING 1 LINES.
           MOVE 25 TO LINE-CTR.
       61-RP-EXIT.    EXIT.

       62-RETRIEVE-JOBPLAN.
           MOVE SPACES TO JOBP-KEY.
           MOVE WO-NUMBER TO JOBP-WO-NO.
           MOVE 001 TO JOBP-SEQ-NO.
       62-FIND-JOBPLAN.
           PERFORM 69-START-JOBPLAN-FILE.
           IF COND-WORD = 17
               ADD 1 TO JOBP-SEQ-NO
               IF JOBP-SEQ-NO > LAST-JOBPLAN-SEQ-1-3
                   GO TO 62-RJ-EXIT
               ELSE
               GO TO 62-FIND-JOBPLAN.
           IF FST-JB-SW = 0
               MOVE 1 TO FST-JB-SW
               MOVE JB-HEADER0 TO CH-PRINT-RECORD
               WRITE CH-PRINT-RECORD AFTER ADVANCING 1 LINES
               MOVE JB-HEADER1 TO CH-PRINT-RECORD
               WRITE CH-PRINT-RECORD AFTER ADVANCING 1 LINES
               ADD 2 TO LINE-CTR.
       62-GET-JOBPLAN-LOOP.
           PERFORM 69-READ-JOBPLAN-FILE.
           IF COND-WORD = 15
               IF WO-START-STATUS = "AA" OR "AR"
                   IF TOTAL-LABOR-EST = ZEROES
                       NEXT SENTENCE
                   ELSE
                   MOVE SPACES       TO JB-LINE-2
                   MOVE "PM LEVEL:"  TO JB-PM-LEVEL-LIT
                   MOVE JOBP-LEVEL   TO JB-PM-LEVEL
                   MOVE "PM FLAG:"   TO JB-PM-FLAG-LIT
                   MOVE JOBP-FLAG    TO JB-PM-FLAG
                   MOVE "PM SUBSYS:" TO JB-PM-SUBS-LIT
                   MOVE JOBP-SS      TO JB-PM-SS
                   MOVE JB-LINE-2    TO CH-PRINT-RECORD
                   WRITE CH-PRINT-RECORD AFTER ADVANCING 1 LINES
                   ADD 1 TO LINE-CTR
                   IF LINE-CTR > 59
                       MOVE SPACES TO CH-PRINT-RECORD
                       WRITE CH-PRINT-RECORD AFTER ADVANCING NEW-PAGE
                       WRITE CH-PRINT-RECORD AFTER ADVANCING 2 LINES
                       MOVE 5 TO LINE-CTR
                   ELSE
                   GO TO 62-RJ-EXIT
               ELSE
               GO TO 62-RJ-EXIT
           ELSE
           IF JOBP-DESCRIP-3 = "&&&"
               GO TO 62-GET-JOBPLAN-LOOP
           ELSE
           IF JOBP-DESCRIP-3 = "$  "
               MOVE SPACES TO CH-PRINT-RECORD
               WRITE CH-PRINT-RECORD AFTER ADVANCING NEW-PAGE
               MOVE 5 TO LINE-CTR
               GO TO 62-GET-JOBPLAN-LOOP
           ELSE
           PERFORM 621-PRINT-JOBINFO
           GO TO 62-GET-JOBPLAN-LOOP.
       62-RJ-EXIT.    EXIT.
       621-PRINT-JOBINFO.
           IF JOBPLAN-SEQ-NO-1-3 = SAVE-JOBPSEQ
               MOVE SPACES TO JB-SEQ-X
           ELSE
           IF WO-START-STATUS = "AA" OR "AR"
               MOVE SPACES       TO JB-LINE-2
               MOVE "PM LEVEL:"  TO JB-PM-LEVEL-LIT
               MOVE JOBP-LEVEL   TO JB-PM-LEVEL
               MOVE "PM FLAG:"   TO JB-PM-FLAG-LIT
               MOVE JOBP-FLAG    TO JB-PM-FLAG
               MOVE "PM SUBSYS:" TO JB-PM-SUBS-LIT
               MOVE JOBP-SS      TO JB-PM-SS
               MOVE JB-LINE-2    TO CH-PRINT-RECORD
               WRITE CH-PRINT-RECORD AFTER ADVANCING 1 LINES
               ADD 1 TO LINE-CTR
               IF LINE-CTR > 59
                   MOVE SPACES TO CH-PRINT-RECORD
                   WRITE CH-PRINT-RECORD AFTER ADVANCING NEW-PAGE
                   WRITE CH-PRINT-RECORD AFTER ADVANCING 2 LINES
                   MOVE 5 TO LINE-CTR
               ELSE
               MOVE JOBPLAN-SEQ-NO-1-3 TO JB-SEQ SAVE-JOBPSEQ
               MOVE SPACES TO CH-PRINT-RECORD
               WRITE CH-PRINT-RECORD AFTER ADVANCING 1 LINES
               ADD 1 TO LINE-CTR
           ELSE
           MOVE JOBPLAN-SEQ-NO-1-3 TO JB-SEQ SAVE-JOBPSEQ
           MOVE SPACES TO CH-PRINT-RECORD
           WRITE CH-PRINT-RECORD AFTER ADVANCING 1 LINES
           ADD 1 TO LINE-CTR.
           MOVE JOBPLAN-DESCRIP TO JB-DESC.
           IF JOBPLAN-DT = SPACES
               MOVE SPACES TO JB-MDT-X
           ELSE
           MOVE JOBPLAN-DT-HRS TO JB-MDTH
           MOVE "." TO JB-MDEC
           IF JOBPLAN-DT-PARTIAL-X = " "
               MOVE "0" TO JB-MDTP
           ELSE
           MOVE JOBPLAN-DT-PARTIAL TO JB-MDTP.
           MOVE JOBPLAN-CRAFT TO JB-CRF.
           IF JOBPLAN-MEN-X = SPACES
               MOVE 0 TO JOBPLAN-MEN
               MOVE "  " TO JB-MEN
           ELSE
           MOVE JOBPLAN-MEN TO JB-MEN.
           IF JOBPLAN-EST = SPACES
               MOVE SPACES TO JB-CLK-X
           ELSE
           MOVE JOBPLAN-EST-HRS TO JB-CLKH
           MOVE "." TO JB-CDEC
           MOVE JOBPLAN-EST-PARTIAL TO JB-CLKP
           MULTIPLY JOBPLAN-MEN BY JOBPLAN-EST-TIME
               GIVING JOBPLAN-EST-TIME-WORK ROUNDED
           PERFORM 6211-SET-LABOR-RATE THRU 6211-SLR-EXIT
           MULTIPLY JOBPLAN-EST-TIME-WORK BY PER-LABOR-RATE GIVING
               JOBPLAN-LABOR-EST
           ADD JOBPLAN-LABOR-EST TO TOTAL-LABOR-EST TOTAL-DOLLAR-EST.
           IF PLANT-IDENT = "126"
               IF OVRPRTF-TOFILE-NUM-X = "L " OR "P "
                   NEXT SENTENCE
               ELSE
               IF OVRPRTF-TOFILE-NUM = 00 OR 16
                   NEXT SENTENCE
               ELSE
               MOVE SPACES TO JB-CLK-X
           ELSE
           IF PLANT-IDENT = "133"
               IF OVRPRTF-TOFILE-NUM = 30
                   NEXT SENTENCE
               ELSE
               MOVE SPACES TO JB-CLK-X.
           MOVE JB-LINE-1 TO CH-PRINT-RECORD.
           WRITE CH-PRINT-RECORD AFTER ADVANCING 1 LINES.
           ADD 1 TO LINE-CTR.
           IF LINE-CTR > 59
               MOVE SPACES TO CH-PRINT-RECORD
               WRITE CH-PRINT-RECORD AFTER ADVANCING NEW-PAGE
               WRITE CH-PRINT-RECORD AFTER ADVANCING 2 LINES
               MOVE 5 TO LINE-CTR.
       6211-SET-LABOR-RATE.
           IF JOBPLAN-CRAFT = "  "
               PERFORM 69-READ-PERSONNEL-FILE
               IF COND-WORD = 15
                   CLOSE PERSONNEL-FILE
                   OPEN INPUT PERSONNEL-FILE
                   GO TO 6211-SLR-EXIT
               ELSE
               GO TO 6211-SLR-EXIT.
           IF JOBPLAN-CRAFT = PER-CRAFT GO TO 6211-SLR-EXIT.
           PERFORM 69-READ-PERSONNEL-FILE.
           IF COND-WORD = 15
               CLOSE PERSONNEL-FILE
               OPEN INPUT PERSONNEL-FILE
               GO TO 6211-SLR-EXIT.
           IF JOBPLAN-CRAFT NOT = PER-CRAFT GO TO 6211-SET-LABOR-RATE.
       6211-SLR-EXIT.    EXIT.
       63-RETRIEVE-STORES.
           PERFORM 69-START-WO-PARTS-FILE.
           IF COND-WORD = 17 GO TO 63-RS-EXIT.
       63-RS-LOOP.
           PERFORM 69-READ-WO-PARTS-FILE.
           IF COND-WORD = 14 GO TO 63-RS-EXIT.
           IF PRT-DELETE-FLAG = "D"
               ADD 001 TO MT-ITM
               GO TO 63-RS-LOOP.
           IF PRT-STATUS = "M "
               ADD 001 TO MT-ITM
               GO TO 63-RS-LOOP.
           IF PRT-STATUS = "X " AND PRT-NUM-7 = "       "
               ADD 001 TO MT-ITM
               GO TO 63-RS-LOOP.
           IF CMT-HD-SW > 0
               NEXT SENTENCE
           ELSE
           MOVE 1 TO CMT-HD-SW
           ADD 8 TO LINE-CTR
           IF LINE-CTR > 61
               MOVE SPACES TO CH-PRINT-RECORD
               WRITE CH-PRINT-RECORD AFTER ADVANCING NEW-PAGE
               WRITE CH-PRINT-RECORD AFTER ADVANCING 2 LINES
               MOVE MT-HEADER0 TO CH-PRINT-RECORD
               WRITE CH-PRINT-RECORD AFTER ADVANCING 1 LINES
               PERFORM 63-RSL-PM-DATA
               MOVE MT-HEADER1 TO CH-PRINT-RECORD
               WRITE CH-PRINT-RECORD AFTER ADVANCING 1 LINES
               MOVE 5 TO LINE-CTR
           ELSE
           MOVE MT-HEADER0 TO CH-PRINT-RECORD
           WRITE CH-PRINT-RECORD AFTER ADVANCING 1 LINES
           PERFORM 63-RSL-PM-DATA
           MOVE MT-HEADER1 TO CH-PRINT-RECORD
           WRITE CH-PRINT-RECORD AFTER ADVANCING 1 LINES
           SUBTRACT 6 FROM LINE-CTR.
           MOVE SPACES TO MT-LINE-1-REST.
           ADD 001 TO MT-ITM.
           IF PRT-ACT-QTY = SPACES MOVE 0 TO PRT-ACT-QTY-9.
           IF PRT-ACT-QTY-9 > 0
               IF PLANT-IDENT = "129"
                   IF WO-CURRENT-TYPE = "E"
                       NEXT SENTENCE
                   ELSE
                   GO TO 63-RS-LOOP
               ELSE
               MOVE PRT-ACT-QTY-9 TO MT-QTYU.
           IF PLANT-IDENT = "129"
               IF WO-CURRENT-TYPE = "E"
                   MOVE PRT-ACT-QTY TO MT-QTYU
               ELSE
               MOVE 0 TO MT-QTYU.
           IF PRT-EST-QTY = SPACES
               MOVE 0 TO MT-QTY
           ELSE
           MOVE PRT-EST-QTY-9 TO MT-QTY.
           IF PRT-EST-COST = SPACES
               MOVE ZEROES TO P-EST-COST.
      *    IF PRT-EST-QTY-FLAG = "*"
      *        NEXT SENTENCE
      *    ELSE
           ADD P-EST-COST TO TOTAL-STORES-EST TOTAL-DOLLAR-EST.
           MOVE PRT-UNIT-MEAS TO MT-UM.
           MOVE PRT-NUM TO MT-PART.
           MOVE PRT-STATUS TO MT-STAT.
           MOVE PRT-STAGE TO MT-STG.
           IF WO-START-STATUS = "AA" OR "AR"
               MOVE PRT-LEVEL TO MT-LEV-1
               MOVE PRT-FLAG  TO MT-FLG-1
               MOVE PRT-SS    TO MT-SS-1.
           MOVE MT-LINE-1 TO CH-PRINT-RECORD.
           WRITE CH-PRINT-RECORD AFTER ADVANCING 1 LINES.
           ADD 1 TO LINE-CTR.
           IF LINE-CTR > 61
               MOVE SPACES TO CH-PRINT-RECORD
               WRITE CH-PRINT-RECORD AFTER ADVANCING NEW-PAGE
               WRITE CH-PRINT-RECORD AFTER ADVANCING 2 LINES
               MOVE 3 TO LINE-CTR.
           MOVE "DESC:" TO MT-HD2.
           MOVE PRT-DESC TO MT-DESC.
           MOVE MT-LINE-2 TO CH-PRINT-RECORD.
           WRITE CH-PRINT-RECORD.
           ADD 1 TO LINE-CTR.
           IF LINE-CTR > 61
               MOVE SPACES TO CH-PRINT-RECORD
               WRITE CH-PRINT-RECORD AFTER ADVANCING NEW-PAGE
               WRITE CH-PRINT-RECORD AFTER ADVANCING 2 LINES
               MOVE 3 TO LINE-CTR.
           IF PRT-DESC-2 = SPACES
               MOVE SPACES TO CH-PRINT-RECORD
               WRITE CH-PRINT-RECORD AFTER ADVANCING 1 LINES
               ADD 1 TO LINE-CTR
               IF LINE-CTR > 61
                   MOVE SPACES TO CH-PRINT-RECORD
                   WRITE CH-PRINT-RECORD AFTER ADVANCING NEW-PAGE
                   WRITE CH-PRINT-RECORD AFTER ADVANCING 2 LINES
                   MOVE 3 TO LINE-CTR
                   GO TO 63-RS-LOOP
               ELSE
               GO TO 63-RS-LOOP.
           MOVE SPACES TO MT-HD2.
           MOVE PRT-DESC-2 TO MT-DESC.
           MOVE MT-LINE-2 TO CH-PRINT-RECORD.
           WRITE CH-PRINT-RECORD.
           ADD 1 TO LINE-CTR.
           IF LINE-CTR > 61
               MOVE SPACES TO CH-PRINT-RECORD
               WRITE CH-PRINT-RECORD AFTER ADVANCING NEW-PAGE
               WRITE CH-PRINT-RECORD AFTER ADVANCING 2 LINES
               MOVE 3 TO LINE-CTR.
           IF PRT-DESC-3 = SPACES
               MOVE SPACES TO CH-PRINT-RECORD
               WRITE CH-PRINT-RECORD AFTER ADVANCING 1 LINES
               ADD 1 TO LINE-CTR
               IF LINE-CTR > 61
                   MOVE SPACES TO CH-PRINT-RECORD
                   WRITE CH-PRINT-RECORD AFTER ADVANCING NEW-PAGE
                   WRITE CH-PRINT-RECORD AFTER ADVANCING 2 LINES
                   MOVE 3 TO LINE-CTR
                   GO TO 63-RS-LOOP
               ELSE
               GO TO 63-RS-LOOP.
           MOVE PRT-DESC-3 TO MT-DESC.
           MOVE MT-LINE-2 TO CH-PRINT-RECORD.
           WRITE CH-PRINT-RECORD.
           ADD 1 TO LINE-CTR.
           IF LINE-CTR > 61
               MOVE SPACES TO CH-PRINT-RECORD
               WRITE CH-PRINT-RECORD AFTER ADVANCING NEW-PAGE
               WRITE CH-PRINT-RECORD AFTER ADVANCING 2 LINES
               MOVE 3 TO LINE-CTR.
           IF PRT-DESC-4 = SPACES
               MOVE SPACES TO CH-PRINT-RECORD
               WRITE CH-PRINT-RECORD AFTER ADVANCING 1 LINES
               ADD 1 TO LINE-CTR
               IF LINE-CTR > 61
                   MOVE SPACES TO CH-PRINT-RECORD
                   WRITE CH-PRINT-RECORD AFTER ADVANCING NEW-PAGE
                   WRITE CH-PRINT-RECORD AFTER ADVANCING 2 LINES
                   MOVE 3 TO LINE-CTR
                   GO TO 63-RS-LOOP
               ELSE
               GO TO 63-RS-LOOP.
           MOVE PRT-DESC-4 TO MT-DESC.
           MOVE MT-LINE-2 TO CH-PRINT-RECORD.
           WRITE CH-PRINT-RECORD.
           ADD 1 TO LINE-CTR.
           IF LINE-CTR > 61
               MOVE SPACES TO CH-PRINT-RECORD
               WRITE CH-PRINT-RECORD AFTER ADVANCING NEW-PAGE
               WRITE CH-PRINT-RECORD AFTER ADVANCING 2 LINES
               MOVE 3 TO LINE-CTR.
           IF PRT-DESC-5 = SPACES
               MOVE SPACES TO CH-PRINT-RECORD
               WRITE CH-PRINT-RECORD AFTER ADVANCING 1 LINES
               ADD 1 TO LINE-CTR
               IF LINE-CTR > 61
                   MOVE SPACES TO CH-PRINT-RECORD
                   WRITE CH-PRINT-RECORD AFTER ADVANCING NEW-PAGE
                   WRITE CH-PRINT-RECORD AFTER ADVANCING 2 LINES
                   MOVE 3 TO LINE-CTR
                   GO TO 63-RS-LOOP
               ELSE
               GO TO 63-RS-LOOP.
           MOVE PRT-DESC-5 TO MT-DESC.
           MOVE MT-LINE-2 TO CH-PRINT-RECORD.
           WRITE CH-PRINT-RECORD.
           ADD 1 TO LINE-CTR.
           IF LINE-CTR > 61
               MOVE SPACES TO CH-PRINT-RECORD
               WRITE CH-PRINT-RECORD AFTER ADVANCING NEW-PAGE
               WRITE CH-PRINT-RECORD AFTER ADVANCING 2 LINES
               MOVE 3 TO LINE-CTR.
           GO TO 63-RS-LOOP.
       63-RS-EXIT.    EXIT.
       63-RSL-PM-DATA.
           MOVE SPACES TO MT-HEADER-1-VAR.
           IF WO-START-STATUS = "AA" OR "AR"
               MOVE "PM LEVEL"  TO MT-PM-LEVEL
               MOVE "PM FLAG"   TO MT-PM-FLAG
               MOVE "PM SUBSYS" TO MT-PM-SUBSYS.
       64-RETRIEVE-PURCHASED.
           PERFORM 69-START-WO-PARTS-FILE.
           IF COND-WORD = 17 GO TO 64-RP-EXIT.
       64-RP-LOOP.
           PERFORM 69-READ-WO-PARTS-FILE.
           IF COND-WORD = 14 GO TO 64-RP-EXIT.
           IF PRT-DELETE-FLAG = "D"
               ADD 001 TO PM-ITM
               GO TO 64-RP-LOOP.
           IF UMT-HD-SW > 0
               NEXT SENTENCE
           ELSE
           MOVE 1 TO UMT-HD-SW
           ADD 8 TO LINE-CTR
           IF LINE-CTR > 61
               MOVE SPACES TO CH-PRINT-RECORD
               WRITE CH-PRINT-RECORD AFTER ADVANCING NEW-PAGE
               WRITE CH-PRINT-RECORD AFTER ADVANCING 2 LINES
               MOVE PM-HEADER0 TO CH-PRINT-RECORD
               WRITE CH-PRINT-RECORD AFTER ADVANCING 1 LINES
               PERFORM 64-RPL-PM-DATA
               MOVE PM-HEADER1 TO CH-PRINT-RECORD
               WRITE CH-PRINT-RECORD AFTER ADVANCING 1 LINES
               MOVE 5 TO LINE-CTR
           ELSE
           MOVE PM-HEADER0 TO CH-PRINT-RECORD
           WRITE CH-PRINT-RECORD AFTER ADVANCING 1 LINES
           PERFORM 64-RPL-PM-DATA
           MOVE PM-HEADER1 TO CH-PRINT-RECORD
           WRITE CH-PRINT-RECORD AFTER ADVANCING 1 LINES
           SUBTRACT 6 FROM LINE-CTR.
           IF PRT-STATUS = "M "
               NEXT SENTENCE
           ELSE
           IF PRT-STATUS = "X " AND PRT-NUM-7 = "       "
               NEXT SENTENCE
           ELSE
           ADD 001 TO PM-ITM
           GO TO 64-RP-LOOP.
           ADD 001 TO PM-ITM.
           MOVE PRT-NUM TO PM-PART.
           MOVE PRT-EST-QTY-9 TO PM-QTY.
      *    IF PRT-EST-QTY-FLAG = "*"
      *        NEXT SENTENCE
      *    ELSE
           ADD P-EST-COST TO TOTAL-PURCH-EST TOTAL-DOLLAR-EST.
           IF PRT-ACT-QTY = SPACES
               MOVE 0 TO PM-QTYU
           ELSE
           MOVE PRT-ACT-QTY-9 TO PM-QTYU.
           MOVE PRT-UNIT-MEAS TO PM-UM.
           IF PRT-REQ-NO = SPACES OR "CANCEL"
               MOVE SPACES TO PM-LINE-2 PM-LINE-3
           ELSE
           MOVE "IN" TO CMR-CALL-MODE
           MOVE SPACES TO BU-DISPLAY-MSG
           MOVE SPACES TO CMR-DATA CMR-DESC CMR-REMARKS
               CMR-RETURNED-DATA CMR-MISC-PARMS PM-LINE-2
               PM-LINE-3
           MOVE PRT-REQ-NO TO CMR-REQ-NUMBER
           MOVE WO-NUMBER TO CMR-WO-NUMBER
           CALL "CMANINQ" USING BASE-STORES
                                CMR-CALL-MODE
                                CMR-DATA
                                CMR-DESC
                                CMR-REMARKS
                                CMR-RETURNED-DATA
                                CMR-MISC-PARMS
                                LANGUAGE-PARMS
                                ESC-NAME
                                STATUS-AREA
                                BU-DISPLAY-MSG
           IF CMR-RETURN-STATUS = "OK"
               PERFORM 641-MOVE-CSIS-INFO THRU 641-MCI-EXIT.
           MOVE PRT-STATUS TO PM-STAT.
           MOVE PRT-STAGE TO PM-STG.
           IF WO-START-STATUS = "AA" OR "AR"
               MOVE SPACES TO PM-DATA-1
               MOVE PRT-LEVEL TO PM-LEV-1
               MOVE PRT-FLAG  TO PM-FLG-1
               MOVE PRT-SS    TO PM-SS-1.
           MOVE PM-LINE-1 TO CH-PRINT-RECORD.
           WRITE CH-PRINT-RECORD AFTER ADVANCING 1 LINES.
           ADD 1 TO LINE-CTR.
           IF LINE-CTR > 61
               MOVE SPACES TO CH-PRINT-RECORD
               WRITE CH-PRINT-RECORD AFTER ADVANCING NEW-PAGE
               WRITE CH-PRINT-RECORD AFTER ADVANCING 2 LINES
               MOVE 3 TO LINE-CTR.
           IF PM-LINE-2 = SPACES
               NEXT SENTENCE
           ELSE
           MOVE PM-LINE-2 TO CH-PRINT-RECORD
           WRITE CH-PRINT-RECORD AFTER ADVANCING 1 LINES
           ADD 1 TO LINE-CTR
           IF LINE-CTR > 61
               MOVE SPACES TO CH-PRINT-RECORD
               WRITE CH-PRINT-RECORD AFTER ADVANCING NEW-PAGE
               WRITE CH-PRINT-RECORD AFTER ADVANCING 2 LINES
               MOVE 3 TO LINE-CTR.
           MOVE "DESC:" TO PM-HD3.
           MOVE PRT-DESC TO PM-DESC.
           MOVE PM-LINE-3 TO CH-PRINT-RECORD.
           WRITE CH-PRINT-RECORD AFTER ADVANCING 1 LINES.
           ADD 1 TO LINE-CTR.
           IF LINE-CTR > 61
               MOVE SPACES TO CH-PRINT-RECORD
               WRITE CH-PRINT-RECORD AFTER ADVANCING NEW-PAGE
               WRITE CH-PRINT-RECORD AFTER ADVANCING 2 LINES
               MOVE 3 TO LINE-CTR.
           IF PRT-DESC-2 = SPACES
               MOVE SPACES TO CH-PRINT-RECORD
               WRITE CH-PRINT-RECORD AFTER ADVANCING 1 LINES
               ADD 1 TO LINE-CTR
               IF LINE-CTR > 61
                   MOVE SPACES TO CH-PRINT-RECORD
                   WRITE CH-PRINT-RECORD AFTER ADVANCING NEW-PAGE
                   WRITE CH-PRINT-RECORD AFTER ADVANCING 2 LINES
                   MOVE 3 TO LINE-CTR
                   GO TO 64-RP-LOOP
               ELSE
               GO TO 64-RP-LOOP.
           MOVE SPACES TO PM-HD3.
           MOVE PRT-DESC-2 TO PM-DESC.
           MOVE PM-LINE-3 TO CH-PRINT-RECORD.
           WRITE CH-PRINT-RECORD AFTER ADVANCING 1 LINES.
           ADD 1 TO LINE-CTR.
           IF LINE-CTR > 61
               MOVE SPACES TO CH-PRINT-RECORD
               WRITE CH-PRINT-RECORD AFTER ADVANCING NEW-PAGE
               WRITE CH-PRINT-RECORD AFTER ADVANCING 2 LINES
               MOVE 3 TO LINE-CTR.
           IF PRT-DESC-3 = SPACES
               MOVE SPACES TO CH-PRINT-RECORD
               WRITE CH-PRINT-RECORD AFTER ADVANCING 1 LINES
               ADD 1 TO LINE-CTR
               IF LINE-CTR > 61
                   MOVE SPACES TO CH-PRINT-RECORD
                   WRITE CH-PRINT-RECORD AFTER ADVANCING NEW-PAGE
                   WRITE CH-PRINT-RECORD AFTER ADVANCING 2 LINES
                   MOVE 3 TO LINE-CTR
                   GO TO 64-RP-LOOP
               ELSE
               GO TO 64-RP-LOOP.
           MOVE PRT-DESC-3 TO PM-DESC.
           MOVE PM-LINE-3 TO CH-PRINT-RECORD.
           WRITE CH-PRINT-RECORD AFTER ADVANCING 1 LINES.
           ADD 1 TO LINE-CTR.
           IF LINE-CTR > 61
               MOVE SPACES TO CH-PRINT-RECORD
               WRITE CH-PRINT-RECORD AFTER ADVANCING NEW-PAGE
               WRITE CH-PRINT-RECORD AFTER ADVANCING 2 LINES
               MOVE 3 TO LINE-CTR.
           IF PRT-DESC-4 = SPACES
               MOVE SPACES TO CH-PRINT-RECORD
               WRITE CH-PRINT-RECORD AFTER ADVANCING 1 LINES
               ADD 1 TO LINE-CTR
               IF LINE-CTR > 61
                   MOVE SPACES TO CH-PRINT-RECORD
                   WRITE CH-PRINT-RECORD AFTER ADVANCING NEW-PAGE
                   WRITE CH-PRINT-RECORD AFTER ADVANCING 2 LINES
                   MOVE 3 TO LINE-CTR
                   GO TO 64-RP-LOOP
               ELSE
               GO TO 64-RP-LOOP.
           MOVE PRT-DESC-4 TO PM-DESC.
           MOVE PM-LINE-3 TO CH-PRINT-RECORD.
           WRITE CH-PRINT-RECORD AFTER ADVANCING 1 LINES.
           ADD 1 TO LINE-CTR.
           IF LINE-CTR > 61
               MOVE SPACES TO CH-PRINT-RECORD
               WRITE CH-PRINT-RECORD AFTER ADVANCING NEW-PAGE
               WRITE CH-PRINT-RECORD AFTER ADVANCING 2 LINES
               MOVE 3 TO LINE-CTR.
           IF PRT-DESC-5 = SPACES
               MOVE SPACES TO CH-PRINT-RECORD
               WRITE CH-PRINT-RECORD AFTER ADVANCING 1 LINES
               ADD 1 TO LINE-CTR
               IF LINE-CTR > 61
                   MOVE SPACES TO CH-PRINT-RECORD
                   WRITE CH-PRINT-RECORD AFTER ADVANCING NEW-PAGE
                   WRITE CH-PRINT-RECORD AFTER ADVANCING 2 LINES
                   MOVE 3 TO LINE-CTR
                   GO TO 64-RP-LOOP
               ELSE
               GO TO 64-RP-LOOP.
           MOVE PRT-DESC-5 TO PM-DESC.
           MOVE PM-LINE-3 TO CH-PRINT-RECORD.
           WRITE CH-PRINT-RECORD AFTER ADVANCING 1 LINES.
           ADD 1 TO LINE-CTR.
           IF LINE-CTR > 61
               MOVE SPACES TO CH-PRINT-RECORD
               WRITE CH-PRINT-RECORD AFTER ADVANCING NEW-PAGE
               WRITE CH-PRINT-RECORD AFTER ADVANCING 2 LINES
               MOVE 3 TO LINE-CTR.
           GO TO 64-RP-LOOP.
       64-RP-EXIT.    EXIT.

       64-RPL-PM-DATA.
           MOVE SPACES TO PM-HEADER-1-VAR.
           IF WO-START-STATUS = "AA" OR "AR"
               MOVE "PM LEVEL"  TO PM-PM-LEVEL
               MOVE "PM FLAG"   TO PM-PM-FLAG
               MOVE "PM SUBSYS" TO PM-PM-SUBSYS.
       641-MOVE-CSIS-INFO.
           MOVE CMR-DESC-LINE (1)   TO PRT-DESC.
           MOVE CMR-DESC-LINE (2)   TO PRT-DESC-2.
           MOVE CMR-DESC-LINE (3)   TO PRT-DESC-3.
           MOVE CMR-DESC-LINE (4)   TO PRT-DESC-4.
           MOVE CMR-DESC-LINE (5)   TO PRT-DESC-5.
           MOVE CMR-PO-NO-AND-REL   TO PRT-PO-NO.
           MOVE PRT-REQ-NO          TO PM-REQ.
           MOVE "CSIS REQ:"         TO PML-2-1.
           MOVE SPACES              TO PML-2-2 PM-PO.
           IF PRT-SUGG-VENDOR = SPACES
               MOVE SPACES          TO PML-2-3 PM-SVEN
           ELSE
           MOVE "SUGGESTED VENDOR:" TO PML-2-3
           MOVE PRT-SUGG-VENDOR     TO PM-SVEN.
           IF PLANT-IDENT = "126 "
               NEXT SENTENCE
           ELSE
           MOVE CMR-STAGING-AREA    TO PRT-STAGE.
           IF CMR-PO-NO-AND-REL = SPACES
               MOVE SPACES TO PM-PO PML-2-2 PM-DRCV
           ELSE
           MOVE CMR-PO-NO-AND-REL   TO PM-PO
           MOVE "CSIS PO:"          TO PML-2-2
           IF CMR-PO-DATE-RCVD = SPACES
               MOVE SPACES TO PM-DRCV
           ELSE
           MOVE 4                   TO DATE-MODE
           MOVE CMR-PO-DATE-RCVD    TO DATE-VALIDATE-IN
           CALL "TDATECHK" USING DATE-CHECK-AREA
           MOVE DATE-SLASH-OUT      TO PM-DRCV.

       641-MCI-EXIT.    EXIT.

       69-READ-PERSONNEL-FILE.
           MOVE 0 TO COND-WORD.
           READ PERSONNEL-FILE NEXT INTO PERSONNEL-DATA
               AT END    MOVE 15 TO COND-WORD.
           IF PF-STATUS NOT = "00" MOVE 15 TO COND-WORD.

       69-READ-JOBPLAN-FILE.
           MOVE 0 TO COND-WORD.
           READ JOBPLAN-FILE NEXT INTO JOBPLAN-BUFFER
               AT END    MOVE 15 TO COND-WORD.
           IF JOBPLAN-WO-NO NOT = WO-NUM-1-10 MOVE 15 TO COND-WORD.
           IF JF-STATUS NOT = "00" MOVE 15 TO COND-WORD.

       69-START-JOBPLAN-FILE.
           MOVE 0 TO COND-WORD.
           MOVE JOBP-KEY TO JOBPWOSEQ OF JFREC.
           START JOBPLAN-FILE KEY IS = EXTERNALLY-DESCRIBED-KEY
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF JF-STATUS NOT = "00" MOVE 17 TO COND-WORD.

       69-READ-WO-PARTS-FILE.
           MOVE 0 TO COND-WORD.
           READ WO-PARTS-FILE PRIOR INTO WO-MATERIAL-USED-DATA
               AT END    MOVE 14 TO COND-WORD.
           IF WO-NUM-1-10 NOT = PRT-WO-NU MOVE 14 TO COND-WORD.
           IF WPFD-STATUS NOT = "00" MOVE 14 TO COND-WORD.

       69-START-WO-PARTS-FILE.
           MOVE 0 TO COND-WORD.
           MOVE WO-NUM-1-10 TO WONUM OF WPFDREC.
           START WO-PARTS-FILE KEY IS > EXTERNALLY-DESCRIBED-KEY
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF WPFD-STATUS NOT = "00" MOVE 17 TO COND-WORD.

       69-READ-WO-PLANNED-FILE.
           MOVE 0 TO COND-WORD.
           READ WO-PLANNED-FILE NEXT INTO WO-PLANNED-DATA
               AT END    MOVE 15 TO COND-WORD.
           IF WPF-STATUS NOT = "00" MOVE 15 TO COND-WORD.

       69-START-WO-PLANNED-FILE.
           MOVE 0 TO COND-WORD.
           MOVE WO-NUM-1-10 TO WONUM OF WPFREC.
           START WO-PLANNED-FILE KEY IS = EXTERNALLY-DESCRIBED-KEY
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF WPF-STATUS NOT = "00" MOVE 17 TO COND-WORD.

       69-READ-ZONE-SPOOLER-FILE.
           MOVE 0 TO COND-WORD.
           READ ZONE-SPOOLER-FILE NEXT INTO ZONE-SPOOLER-WA
               AT END    MOVE 15 TO COND-WORD.
           IF ZSF-STATUS NOT = "00" MOVE 15 TO COND-WORD.

       69-START-ZONE-SPOOLER-FILE.
           MOVE 0 TO COND-WORD.
           MOVE ZONE-KEY TO ZONEKEY OF ZSFREC.
           START ZONE-SPOOLER-FILE KEY IS = EXTERNALLY-DESCRIBED-KEY
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF ZSF-STATUS NOT = "00" MOVE 17 TO COND-WORD.

       98-SCREEN-READ.
           READ DISPLAY-FILE FORMAT IS VIEW-CFNAME
               INDIC IS INDICS.
           ACCEPT IOFEEDBACK FROM I-O-FEEDBACK-AREA.
           MOVE ALL B"0" TO INDICS.
           IF DSPLY-STATUS NOT = "00"
               MOVE 3 TO VIEW-LASTKEY
           ELSE
           MOVE FUNCTION-NUM TO VIEW-LASTKEY.

       99-SCREEN-WRITE.
           WRITE DSPLY-REC FORMAT IS VIEW-CFNAME
               INDIC IS INDICS.
           MOVE ALL B"0" TO INDICS.

       999-CATREAD.
           MOVE SPACES TO ERROR-BUFFER.
           CALL "CCATREAD" USING CATREAD-PARMS.
           MOVE CATREAD-MSG-TEXT TO ERROR-BUFFER.
       999-CATREAD-EXIT.    EXIT.
