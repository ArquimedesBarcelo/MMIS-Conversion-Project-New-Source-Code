077500 62-FIND-DPODATAITM.
077700     MOVE DE2-ITEM          TO  ITEM-NO-SAVE.
077800     MOVE ZEROS             TO  LINE-NO-SAVE,
078000                                LINE-SAVE,
078100                                LINE-SUB.
           MOVE SPACES            TO  SAVE-ITEM-SEQ-NO.
           MOVE 0 TO COND-WORD.
           MOVE PO-ARG TO PORCVNO OF DPODATAITM-REC-O.
           START DPODATAITM-O KEY = PORCVNO OF DPODATAITM-REC-O
               INVALID KEY MOVE 0  TO COND-WORD.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
                   MOVE 0 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.
078200*A   CALL "DBFIND" USING BASE, DSET-DPODATAITM, MODE1,
078300*A       STATUS-AREA, PO-SEARCH, PO-ARG.
078400     IF COND-WORD NOT = 0
078500         MOVE "FIND DPODATA * 62-FD" TO BU-DISPLAY-MSG
078600         GO TO 2100-BLOWUP.
079100
079200 62-GET-DPODATAITM.
           IF LINE-SUB = 1
               MOVE DATAITM-LINE  TO SAVE-ITEM-SEQ-NO.
           MOVE 0 TO COND-WORD.
           READ DPODATAITM-O NEXT INTO BUF-DPODATAITM
               AT END MOVE 15 TO COND-WORD.
