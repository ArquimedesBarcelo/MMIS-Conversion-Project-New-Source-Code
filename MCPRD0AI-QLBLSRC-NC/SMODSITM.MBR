156600                        BASE,
156700                        STATUS-AREA,
156800                        BU-DISPLAY-MSG,
156900                        CODE-ARG,
157000                        CDESC-DATA.
157100     IF BU-DISPLAY-MSG-1  NOT = SPACES
157200         MOVE CODE-ARG            TO  BU-DISPLAY-FLD (2)
157300         GO TO 2100-BLOWUP.
157400
157500     IF CDESC-LINES-GOT > 0
157600         MOVE CDESC (1)           TO  DE2-MANUFACTUR-SELECT
                                            DE2-MANUFACTUR-SELECT-L.
157700
157800 621-GOM-X.
157900     EXIT.
158000
158100**********************************************
158200*                                            *
158300*  THIS ROUTINES SEARCHES FOR A REQ WITH     *
158400*  THE SPECIFIED ITEM ON IT BY USING         *
158500*  DREQD TO SEE IF THE PO NUMBER AND ITEM    *
158600*  NUMBER ARE A MATCH                        *
158700*                                            *
158800**********************************************
158900
159000 621-CHECK-FOR-REQ.
           MOVE 0 TO COND-WORD.
           MOVE PO-ARG TO PORCVNO OF DREQD-REC-I.
           START DREQD-I KEY = PORCVNO OF DREQD-REC-I
               INVALID KEY GO TO 621-CFR-X.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
                   GO TO 621-CFR-X
               ELSE
                   MOVE 99 TO COND-WORD.
159100*A   CALL "DBFIND" USING BASE, DSET-DREQD, MODE1,
159200*A       STATUS-AREA, PO-SEARCH, PO-ARG.
159300     IF COND-WORD  NOT = 0
159400         MOVE "FIND DREQD * 621-CFR" TO BU-DISPLAY-MSG
159500         GO TO 2100-BLOWUP.
159600
159700 621-GET-DREQD.
           MOVE 0 TO COND-WORD.
           READ DREQD-I NEXT INTO BUF-DREQD
               AT END MOVE 15 TO COND-WORD.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   MOVE 15 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.
           IF PORCVNO OF DREQD-REC-I NOT = PO-ARG
               MOVE 15 TO COND-WORD.
159800*A   CALL "DBGET" USING BASE, DSET-DREQD, MODE5,
159900*A       STATUS-AREA, ALL-ITEMS, BUF-DREQD, PO-ARG.
160000     IF COND-WORD  NOT = 0
160100         IF COND-WORD = 15
160200             GO TO 621-CFR-X
160300         ELSE
160400             MOVE "GET DREQD * 621-GD" TO BU-DISPLAY-MSG
160500             GO TO 2100-BLOWUP.
160600
160700     IF DREQD-PO-ITM-NO  =  ITM-NUMBER
160800         MOVE DREQD-REQ-NUMBER  TO  DE2-REQ-NO
                                          DE2-REQ-NO-L
160900     ELSE
161000         GO TO 621-GET-DREQD.
161100
161200 621-CFR-X.
161300     EXIT.
162600
       621-LOAD-REQ-ITEM.
           MOVE 0 TO COND-WORD
                     REQITM-BUDGET-AMT.
           MOVE REQ-ARG TO REQNO OF DREQITM-REC-I.
           START DREQITM-I KEY = REQNO OF DREQITM-REC-I
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS = "00"
               READ DREQITM-I NEXT INTO BUF-DREQITM
                   AT END MOVE FILE-STATUS TO FILE-STATUS
               END-READ
               IF REQNO OF DREQITM-REC-I NOT = REQ-ARG
                   MOVE 0 TO REQITM-BUDGET-AMT.
       621-LRI-X.
           EXIT.

