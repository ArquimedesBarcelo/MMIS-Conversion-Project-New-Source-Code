008800 01  HD-RET-CODE                PIC S9(4) COMP-4 VALUE 0.
008900 01  HD-FILE-NAME               PIC X(17) VALUE "DHDR54.PUB".
009000 01  FNUM                       PIC S9(4) COMP-4 VALUE 0.
009200
009300 COPY ESCNAM2   IN COPYLIB.
009400
009500*************************************************************
009600**                                                         **
009700**           D A T A B A S E   W O R K                     **
009800**                                                         **
009900*************************************************************
       01  FILE-STATUS.
           05  FILE-STATUS-1            PIC X  VALUE "0".
           05  FILE-STATUS-2            PIC X  VALUE "0".
010000
010100 01  BASE                          PIC X(10) VALUE "  STORES;".
010200 01  BASE-MMISA                    PIC X(10) VALUE "  MMISA;".
010300 01  PASSWORD                      PIC X(5)  VALUE "JADE;".
010400 01  PASSWORD-MMISA                PIC X(7)  VALUE "DO-ALL;".
010500 01  DSET-NAMES.
010600     05  DSET-NAME                 PIC X(16) VALUE SPACES.
010700     05  DSET-MPATH                PIC X(16) VALUE "MPATH;".
010800     05  DSET-DPATHDEF             PIC X(16) VALUE "DPATHDEF;".
010900     05  DSET-MLEVEL               PIC X(16) VALUE "MLEVEL;".
011000     05  DSET-PER-PERSONNEL  PIC X(16) VALUE "PER-PERSONNEL;".
011100
011200 COPY DBSTAT     IN COPYLIB.
011300 01  PATH-SEARCH                   PIC X(9)  VALUE "PATH-NUM;".
011400 01  REQ-ARG                       PIC X(12) VALUE SPACES.
011500 01  EMPL-ARG                      PIC X(4)  VALUE SPACES.
011600 01  WO-ARG                        PIC X(10) VALUE SPACES.
011700 01  PATH-ARG                      PIC X(4)  VALUE SPACES.
011800 01  LEVEL-ARG                     PIC X(2)  VALUE SPACES.
011900
012000 01  MODE-AREA.
012100     05  DB-MODE                   PIC S9(4)   COMP       VALUE 0.
012200     05  MODE1                     PIC S9(4)   COMP       VALUE 1.
012300     05  MODE2                     PIC S9(4)   COMP       VALUE 2.
012400     05  MODE3                     PIC S9(4)   COMP       VALUE 3.
012500     05  MODE4                     PIC S9(4)   COMP       VALUE 4.
012600     05  MODE5                     PIC S9(4)   COMP       VALUE 5.
012700     05  MODE7                     PIC S9(4)   COMP       VALUE 7.
012800
012900 01  ALL-ITEMS                     PIC X(2)  VALUE "@;".
013000
013100******************************************************************
013200**                                                              **
013300**       D A T A B A S E   B U F F E R S                        **
013400**                                                              **
013500******************************************************************
013600 COPY MPATH      IN COPYLIB.
013700 COPY MLEVEL     IN COPYLIB.
013800 COPY DPATHDEF   IN COPYLIB.
013900
014000 01  BUF-PER-PERSONNEL.            COPY MPERSONL IN COPYLIB.
014100
       COPY MPLT0      IN COPYLIB.
       COPY MPLTPREQ   IN COPYLIB.

014200******************************************************************
014300**                                                              **
014400**      H E A D E R   A N D   D E T A I L   L I N E S           **
014500**                                                              **
014600******************************************************************
014700 01  HDR-1.
014800     05  FILLER  PIC X(6)  VALUE "TEARPT".
014900     05  FILLER  PIC X(16)  VALUE SPACES.
015000     05  FILLER  PIC X(24) VALUE "ONLINE REQUISITION APPRO".
015100     05  FILLER  PIC X(17) VALUE "VAL SETUP REPORT".
015200     05  FILLER  PIC X(16) VALUE SPACES.
015300     05  PRT-DAT PIC X(8).
015400     05  FILLER  PIC X(2)  VALUE SPACES.
015500     05  PRT-TIM PIC X(8).
015600     05  FILLER  PIC X(8)  VALUE "  PAGE ".
015700     05  PRT-PAG PIC ZZ9.
015800
015900 01  PATH-LINE.
016000     05  FILLER                    PIC X(4)  VALUE SPACES.
016100     05  FILLER                    PIC X(5)  VALUE "PATH ".
016200     05  PRT-PATH                  PIC X(4).
016300     05  FILLER                    PIC X(1)  VALUE SPACES.
016400     05  PRT-PATH-DESC             PIC X(30).
016500
016600 01  MAX-MIN-LINE.
016700     05  FILLER              PIC X(14) VALUE "MINIMUM VALUE ".
016800     05  PRT-MIN-VAL         PIC Z(13)9.
016900     05  FILLER              PIC X(4)  VALUE SPACES.
017000     05  FILLER              PIC X(14) VALUE "MAXIMUM VALUE ".
017100     05  PRT-MAX-VAL         PIC Z(13)9.
017200     05  FILLER              PIC X(4)  VALUE SPACES.
017300     05  FILLER              PIC X(13) VALUE "WO APPROVAL? ".
017400     05  PRT-WO-APPROVE      PIC X(1).
017500     05  FILLER              PIC X(4)  VALUE SPACES.
017600     05  FILLER              PIC X(7)  VALUE "PRINT? ".
017700     05  PRT-PRINT-OPTION    PIC X(1).
017800
017900 01  INC-EXC-LINE.
018000     05  PRT-INC-EXC               PIC X(8).
018100     05  PRT-TYPE                  PIC X(11).
018200     05  PRT-LOW-VALUE             PIC X(14).
018300     05  FILLER                    PIC X(1)  VALUE SPACES.
018400     05  PRT-DASH                  PIC X(1).
018500     05  FILLER                    PIC X(1)  VALUE SPACES.
018600     05  PRT-HIGH-VALUE            PIC X(14).
018700     05  FILLER                    PIC X(1)  VALUE SPACES.
018800     05  PRT-ODD-EVEN              PIC X(4)  VALUE SPACES.
018900     05  PRT-ADD-LEVEL-AREA.
019000         10  FILLER                PIC X(1)  VALUE SPACES.
019100         10  PRT-ADD-LIT           PIC X(10) VALUE SPACES.
019200         10  PRT-ADD-LEVEL         PIC X(2)  VALUE SPACES.
019300         10  FIL                   PIC X(1)  VALUE SPACES.
019400         10  PRT-ADD-INORD         PIC X(1)  VALUE SPACES.
019500         10  FIL                   PIC X(1)  VALUE SPACES.
019600         10  PRT-ADD-LEV-DESC      PIC X(36) VALUE SPACES.
019700
019800 01  LEVEL-LINE.
019900     05  PRT-LEVEL                 PIC X(2).
020000     05  FILLER                    PIC X(1)  VALUE SPACES.
020100     05  PRT-O-S                   PIC X(1).
020200     05  FILLER                    PIC X(1)  VALUE SPACES.
020300     05  PRT-ID                    PIC X(4).
020400     05  FILLER                    PIC X(1)  VALUE SPACES.
020500     05  PRT-NAME                  PIC X(16).
020600     05  FILLER                    PIC X(1)  VALUE SPACES.
020700     05  PRT-LEVEL-DESC            PIC X(36).
020800
020900 01  LEVEL-HDR.
021000     05  FILLER  PIC X(2)  VALUE "LV".
021100     05  FILLER  PIC X(1)  VALUE SPACES.
021200     05  FILLER  PIC X(1)  VALUE "I".
021300     05  FILLER  PIC X(1)  VALUE SPACES.
021400     05  FILLER  PIC X(2)  VALUE "ID".
021500     05  FILLER  PIC X(3)  VALUE SPACES.
021600     05  FILLER  PIC X(4)  VALUE "NAME".
021700     05  FILLER  PIC X(13) VALUE SPACES.
021800     05  FILLER  PIC X(17) VALUE "LEVEL DESCRIPTION".
021900
022000 01  DASH-LINE                     PIC X(91) VALUE ALL "-".

       LINKAGE SECTION.
       COPY THDPRTB IN COPYLIB.
022100
007500 01  OPTION-REC                    PIC X(80).
007600
022200 PROCEDURE DIVISION USING HD-ROUTE-DATA, OPTION-REC.
022300
022400 0000-START SECTION.
022500 0010-CONTROL.
      *------ CALL CCRTFILE TO CREATE A TEMPORARY FILE 'DTMPLEV'
           MOVE "QTEMP"       TO CCRTFILE-LIBRARY.
           MOVE "DTMPLEV"     TO CCRTFILE-FILE.
           MOVE "0042"        TO CCRTFILE-RECORD-LENGTH.
           MOVE "01000"       TO CCRTFILE-NO-RECORDS.
           MOVE "01000"       TO CCRTFILE-INCREMENT-AMT.
           MOVE "99"          TO CCRTFILE-NO-INCREMENTS.
           CALL "CCRTFILE" USING CCRTFILE-LIBRARY,
                                 CCRTFILE-FILE,
                                 CCRTFILE-RECORD-LENGTH,
                                 CCRTFILE-NO-RECORDS,
                                 CCRTFILE-INCREMENT-AMT,
                                 CCRTFILE-NO-INCREMENTS,
                                 CCRTFILE-STATUS.
           IF CCRTFILE-STATUS NOT = "00"
               MOVE "CCRTFILE CREATE OF 'DTMPLEV' FAILED"
                  TO BU-DISPLAY-MSG
               PERFORM 2100-BLOWUP.

           OPEN INPUT MPATH-I, MLEVEL-I, PER-PERSONNEL-I,
             DPATHDEF-I, MPLTINFO-I.
022600     CALL "TESCSEQ" USING ESC-NAME.
022700     MOVE CHAR-1636PI TO COMP-ESC-SEQ.
022800     MOVE CHAR-10PI TO STAND-ESC-SEQ.
022900
023000     CALL "TDATECHK" USING DATE-CHECK-AREA.
023100     MOVE DATE-SLASH-OUT           TO   PRT-DAT.
023200     MOVE DATE-FORMATTED-TIME-OUT  TO   PRT-TIM.
023300
           MOVE "PREQ"                   TO  MPLTINFO-ARG.
           MOVE 0 TO COND-WORD.
           MOVE MPLTINFO-ARG TO PLTINFOKEY OF MPLTINFO-I-REC.
           READ MPLTINFO-I INTO BUF-MPLTINFO
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE "N"                      TO SAVE-REQ-SYNR3-SW
           ELSE
               MOVE MPLTINFO-REQ-SYNR3-SW    TO SAVE-REQ-SYNR3-SW.

      *------ OVERRIDE PRINT FILE
           MOVE HD-SPOOLER-NUMBER TO OVRPRTF-TOFILE-NUM.
           MOVE "*YES"            TO OVRPRTF-SHARED.
           MOVE HD-NO-OF-COPIES   TO OVRPRTF-COPIES.
           MOVE "MCPRT"           TO OVRPRTF-FILE.
           PERFORM 996-OVERRIDE-PRINT-FILE.
026700     OPEN OUTPUT PRINT-FILE.
026900
027000     CALL "THDPRT2" USING HD-RET-CODE, HD-FILE-NAME, FNUM
027100       HD-ROUTE-DATA, ESC-NAME.
027200     IF HD-RET-CODE NOT = 0
027300         MOVE "THDPRT2 ERROR IN HSK" TO BU-DISPLAY-MSG
027400         MOVE "HD-RET-CODE = " TO BU-DISPLAY-FLD (1)
027500         MOVE HD-RET-CODE      TO BU-DISPLAY-FLD9 (1)
027600         GO TO 2100-BLOWUP.
027700
027800     IF PAPER-VALUE = 0 OR 80
027900        MOVE COMP-ESC-SEQ TO PRT-REC
028000        WRITE PRT-REC BEFORE ADVANCING 0 LINES.
028100
      *--------- IF PLANT IS USING R3, SORT BY LOW VALUE FIRST.
           IF SAVE-REQ-SYNR3-SW = "Y"
028300         SORT SORT-FILE ON ASCENDING KEY    SORT-PATH,
028500                                            SORT-TYPE,
028400                                            SORT-INCL-EXCL-FLAG,
028600                                            SORT-LOW-VALUE,
028700             INPUT PROCEDURE IS 6000-INPUT-STUFF
028800             OUTPUT PROCEDURE IS 7000-OUTPUT-STUFF
           ELSE
028300     SORT SORT-FILE ON ASCENDING KEY    SORT-PATH,
028400                                        SORT-INCL-EXCL-FLAG,
028500                                        SORT-TYPE,
028600                                        SORT-LOW-VALUE
028700         INPUT PROCEDURE IS 6000-INPUT-STUFF
028800         OUTPUT PROCEDURE IS 7000-OUTPUT-STUFF.
028900
029000     PERFORM 7810-LEVEL-HEADERS.
029100     PERFORM 8000-PRINT-LEVELS THRU 8990-PL-X.
029200
           CLOSE MPATH-I, MLEVEL-I, PER-PERSONNEL-I, DPATHDEF-I,
                 MPLTINFO-I.
029300     CLOSE PRINT-FILE.
029400     GOBACK.
029500
029600 2100-BLOWUP.
029700     MOVE "TEARPT"                 TO   BU-PGM-NAME.
029800     CALL "TBLOWUP" USING BASE BU-PGM-NAME STATUS-AREA
029900       DUMMY-VIEW-AREA, FILE-STATUS BU-DISPLAY-MSG
030000       BU-DISPLAY-FLDS.
030100
030200 6000-INPUT-STUFF SECTION.
030300 6500-SERIAL-LOOP.
      *------ DO A START TO ENSURE WE ARE AT BEGINNING OF FILE
           MOVE SPACES TO PATHNUM OF MPATH-REC-I.
           START MPATH-I KEY > PATHNUM OF MPATH-REC-I
               INVALID KEY MOVE 17 TO COND-WORD.
           IF (FILE-STATUS NOT = "00") AND (FILE-STATUS-1 NOT = "2")
               MOVE "START ERROR ON MPATH 6500-SL" TO BU-DISPLAY-MSG
               PERFORM 2100-BLOWUP.

030400     DISPLAY "STARTING SERIAL-LOOP ".
030500
030600 6510-LOOP.
030700*    CALL "DBGET" USING BASE, DSET-MPATH, MODE2, STATUS-AREA,
030800*      ALL-ITEMS, BUF-MPATH, REQ-ARG.
           READ MPATH-I NEXT INTO BUF-MPATH
               AT END MOVE "2" TO FILE-STATUS-1.
030900     IF FILE-STATUS NOT = "00"
031000         DISPLAY "END OF SERIAL LOOP "
031100         GO TO 6990-IS-X.
031500
031600     MOVE MPATH-PATH-NUMBER        TO   PATH-ARG.
031700*    CALL "DBFIND" USING BASE, DSET-DPATHDEF, MODE1,
031800*      STATUS-AREA, PATH-SEARCH,  PATH-ARG.
           MOVE PATH-ARG TO PATHNUM OF DPATHDEF-REC-I.
           START DPATHDEF-I KEY = PATHNUM OF DPATHDEF-REC-I
               INVALID KEY MOVE 17 TO COND-WORD.
           IF (FILE-STATUS NOT = "00") AND (FILE-STATUS-1 NOT = "2")
032000         MOVE "DBFIND ERR 7100-LPF" TO BU-DISPLAY-MSG
032100         PERFORM 2100-BLOWUP.
032200
032300 6520-PATHDEF-LOOP.
032400*    CALL "DBGET" USING BASE, DSET-DPATHDEF, MODE5,
032500*      STATUS-AREA, ALL-ITEMS, BUF-DPATHDEF, PATH-ARG.
           MOVE 0 TO COND-WORD.
           READ DPATHDEF-I NEXT INTO BUF-DPATHDEF
               AT END MOVE 15 TO COND-WORD.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   MOVE 15 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.
           IF PATHNUM OF DPATHDEF-REC-I NOT = PATH-ARG
               MOVE 15 TO COND-WORD.
032600     IF END-OF-CHAIN
032700         GO TO 6510-LOOP
032800     ELSE
032900     IF NOT GOOD-CALL
033000         MOVE "DBGET ERR DPATHDEF 7110-LPL" TO BU-DISPLAY-MSG
033100         PERFORM 2100-BLOWUP.
033200
033300     MOVE DPATHD-PATH-NUMBER       TO   SORT-PATH.
033400     MOVE DPATHD-INCL-EXCL-FLAG    TO   SORT-INCL-EXCL-FLAG.
033500     MOVE DPATHD-TYPE              TO   SORT-TYPE.
033600     MOVE DPATHD-LOW-VALUE         TO   SORT-LOW-VALUE.
033700     MOVE DPATHD-HIGH-VALUE        TO   SORT-HIGH-VALUE.
033800     MOVE DPATHD-LEVEL             TO   SORT-LEVEL.
033900     MOVE DPATHD-INORD-SIMEL       TO   SORT-I-S.
034000     MOVE DPATHD-ODD-EVEN-FLAG     TO   SORT-ODD-EVEN-FLAG.
034100
034200     RELEASE SORT-REC.
034300
034400     GO TO 6520-PATHDEF-LOOP.
034500
034600 6990-IS-X.
034700     EXIT.
034800
034900 7000-OUTPUT-STUFF SECTION.
035000 7010-START-OUTPUT.
035100     PERFORM 7800-HEADERS.
035200     MOVE "Y"                      TO   FIRST-TIME-FLAG.
035300
035400 7020-READ-LOOP.
035500     PERFORM 7830-RETURN-REC.
035600     IF END-OF-FILE-FLAG = "Y"
035700         GO TO 7500-END-OUTPUT.
035800
035900     IF SORT-PATH NOT = SAVE-PATH
036000         IF FIRST-TIME-FLAG = "Y"
036100             PERFORM 7840-PATH-BREAK
036200             MOVE SORT-PATH        TO   SAVE-PATH
036300             MOVE "N"              TO   FIRST-TIME-FLAG
036400         ELSE
036500             PERFORM 7850-LEVELS THRU 7870-L-X
036600             PERFORM 7840-PATH-BREAK
036700             MOVE SORT-PATH        TO   SAVE-PATH.
036800
036900*------ NOTE: 7840-PATH-BREAK DOES THE DBGET ON MPATH.
037000     IF MPATH-PATH-NUMBER-9 = 999
037100         MOVE "FOR "               TO   PRT-INC-EXC
037200     ELSE
037300     IF SORT-INCL-EXCL-FLAG = "I"
037400         MOVE "INCLUDE"            TO   PRT-INC-EXC
037500     ELSE
037600         MOVE "EXCLUDE"            TO   PRT-INC-EXC.
037700
037800     IF SORT-TYPE = "D"
037900         MOVE "DEPT"               TO   PRT-TYPE
038000     ELSE
038100     IF SORT-TYPE = "E"
038200         MOVE "EXP CLASS"          TO   PRT-TYPE
038300     ELSE
038400     IF SORT-TYPE = "C"
038500         MOVE "ACCT CLASS"         TO   PRT-TYPE
038600     ELSE
038700     IF SORT-TYPE = "V"
038800         MOVE "EST VALUE"          TO   PRT-TYPE
038900     ELSE
039000         MOVE "BUDGET NO"          TO   PRT-TYPE.
039100
039200     MOVE SORT-LOW-VALUE           TO   PRT-LOW-VALUE.
039300     IF SORT-HIGH-VALUE = SPACES
039400         MOVE SPACES               TO   PRT-DASH,
039500                                        PRT-HIGH-VALUE
039600     ELSE
039700         MOVE "-"                  TO   PRT-DASH
039800         MOVE SORT-HIGH-VALUE      TO   PRT-HIGH-VALUE.
039900
040000     IF SORT-ODD-EVEN-FLAG = "O"
040100         MOVE "ODD"                TO   PRT-ODD-EVEN
040200     ELSE
040300     IF SORT-ODD-EVEN-FLAG = "E"
040400         MOVE "EVEN"               TO   PRT-ODD-EVEN
040500     ELSE
040600         MOVE SPACES               TO   PRT-ODD-EVEN.
040700
           IF SORT-LEVEL = "00"
               NEXT SENTENCE
           ELSE
040800*    IF SORT-LEVEL NUMERIC
           IF SORT-LEVEL NOT = "  "
040900         MOVE SORT-LEVEL           TO   LEVEL-ARG
041000         PERFORM 7880-GET-MLEVEL
041100         MOVE "ADD LEVEL "         TO   PRT-ADD-LIT
041200         MOVE SORT-LEVEL           TO   PRT-ADD-LEVEL
041300         MOVE SORT-I-S             TO   PRT-ADD-INORD
041400         MOVE MLEVEL-LEVEL-DESC    TO   PRT-ADD-LEV-DESC
041500     ELSE
041600         MOVE SPACES               TO   PRT-ADD-LEVEL-AREA.
041700
041800     WRITE PRT-REC FROM INC-EXC-LINE AFTER ADVANCING 1.
041900     ADD 1                         TO   LINE-CNT.
042000
042100     IF LINE-CNT > 60
042200         PERFORM 7800-HEADERS.
042300
042400     GO TO 7020-READ-LOOP.
042500
042600 7500-END-OUTPUT.
042700     PERFORM 7850-LEVELS THRU 7870-L-X.
042800     GO TO 7990-OS-X.
042900
043000******************************************************************
043100** OUTPUT SECTION PERFORMED ROUTINES                            **
043200******************************************************************
043300 7800-HEADERS.
043400     ADD 1                         TO   PAGE-CNT.
043500     MOVE PAGE-CNT                 TO   PRT-PAG.
043600     WRITE PRT-REC FROM HDR-1 AFTER ADVANCING NEW-PAGE.
043700     MOVE SPACES                   TO   PRT-REC.
043800     WRITE PRT-REC AFTER ADVANCING 1.
043900     MOVE 2                        TO   LINE-CNT.
044000
044100 7810-LEVEL-HEADERS.
044200     ADD 1                         TO   PAGE-CNT.
044300     MOVE PAGE-CNT                 TO   PRT-PAG.
044400     WRITE PRT-REC FROM HDR-1 AFTER ADVANCING NEW-PAGE.
044500     WRITE PRT-REC FROM LEVEL-HDR AFTER ADVANCING 2.
044600     MOVE 1                        TO   LINE-CNT.
044700
044800 7820-GET-PERNAME.
044900*    CALL "DBGET" USING BASE-MMISA, DSET-PER-PERSONNEL, MODE7,
045000*      STATUS-AREA, ALL-ITEMS, BUF-PER-PERSONNEL, EMPL-ARG.
           MOVE EMPL-ARG TO PERCCNUM OF PER-PERSONNEL-REC-I.
           READ PER-PERSONNEL-I INTO BUF-PER-PERSONNEL
               INVALID KEY MOVE 17 TO COND-WORD.
045100     IF FILE-STATUS NOT = "00"
045200         MOVE SPACES               TO   PRT-NAME
045300     ELSE
045400     IF PER-EMP-NAME < "A"
045500         MOVE SPACES               TO   PRT-NAME
045600     ELSE
045700         MOVE PER-EMP-NAME         TO   PRT-NAME.
045800
045900 7830-RETURN-REC.
046000     RETURN SORT-FILE AT END
046100         MOVE "Y"                  TO   END-OF-FILE-FLAG.
046200
046300
046400 7840-PATH-BREAK.
046500     MOVE SORT-PATH                TO   PATH-ARG.
046600*    CALL "DBGET" USING BASE, DSET-MPATH, MODE7,
046700*      STATUS-AREA, ALL-ITEMS, BUF-MPATH, PATH-ARG.
           MOVE PATH-ARG TO PATHNUM OF MPATH-REC-I.
           READ MPATH-I INTO BUF-MPATH
               INVALID KEY MOVE 17 TO COND-WORD.
046800     IF FILE-STATUS-1 = "2"
046900         MOVE SPACES               TO   BUF-MPATH
047000     ELSE
047100     IF FILE-STATUS NOT = "00"
047200         MOVE "DBGET ERR MODE7  7840-PB" TO BU-DISPLAY-MSG
047300         PERFORM 2100-BLOWUP.
047400
047500     MOVE MPATH-PATH-NUMBER        TO   PRT-PATH.
047600     MOVE MPATH-PATH-DESC          TO   PRT-PATH-DESC.
047700     WRITE PRT-REC FROM PATH-LINE AFTER ADVANCING 1.
047800     MOVE MPATH-MIN-VAL            TO   PRT-MIN-VAL.
047900     MOVE MPATH-MAX-VAL            TO   PRT-MAX-VAL.
048000     MOVE MPATH-WO-APPROVE         TO   PRT-WO-APPROVE.
048100     MOVE MPATH-PRINT-OPTION       TO   PRT-PRINT-OPTION.
048200     WRITE PRT-REC FROM MAX-MIN-LINE AFTER ADVANCING 2.
048300     MOVE SPACES                   TO   PRT-REC.
048400     WRITE PRT-REC AFTER ADVANCING 1.
048500     ADD 5                         TO   LINE-CNT.
048600
048700 7850-LEVELS.
048800     MOVE SPACES                   TO   PRT-REC.
048900     WRITE PRT-REC AFTER ADVANCING 1.
049000     ADD 1                         TO   LINE-CNT.
049100     MOVE 0                        TO   SUB.
049200
049300 7855-LEVEL-LOOP.
049400     ADD 1                         TO   SUB.
049500     IF SUB > 12
049600         GO TO 7860-END-LEVELS.
049700
049800*    IF MPATH-LEVEL (SUB) NUMERIC
049900*        NEXT SENTENCE
050000*    ELSE
050100*        GO TO 7855-LEVEL-LOOP.
050200
           IF MPATH-LEVEL (SUB) = SPACES GO TO 7855-LEVEL-LOOP.

050300     MOVE MPATH-LEVEL (SUB)        TO   PRT-LEVEL.
050400     MOVE MPATH-EMPL (SUB)         TO   PRT-ID.
050500     MOVE MPATH-LV-O-S (SUB)       TO   PRT-O-S.
050600     MOVE MPATH-LEVEL (SUB)        TO   LEVEL-ARG.
050700
050800     PERFORM 7880-GET-MLEVEL.
050900     MOVE MLEVEL-LEVEL-DESC        TO   PRT-LEVEL-DESC.
051000
051100     MOVE MPATH-EMPL (SUB)         TO   EMPL-ARG.
051200     PERFORM 7820-GET-PERNAME.
051300
051400     WRITE PRT-REC FROM LEVEL-LINE AFTER ADVANCING 1.
051500     ADD 1                         TO   LINE-CNT.
051600
051700     IF LINE-CNT > 60
051800         PERFORM 7800-HEADERS.
051900
052000     GO TO 7855-LEVEL-LOOP.
052100
052200 7860-END-LEVELS.
052300     WRITE PRT-REC FROM DASH-LINE AFTER ADVANCING 2.
052400     ADD 2                         TO   LINE-CNT.
052500     IF LINE-CNT > 60
052600         PERFORM 7800-HEADERS.
052700
052800 7870-L-X.
052900     EXIT.
053000
053100 7880-GET-MLEVEL.
053200*    CALL "DBGET" USING BASE, DSET-MLEVEL, MODE7,
053300*      STATUS-AREA, ALL-ITEMS, BUF-MLEVEL, LEVEL-ARG.
           MOVE LEVEL-ARG TO LEVELNUM OF MLEVEL-REC-I.
           READ MLEVEL-I INTO BUF-MLEVEL
               INVALID KEY MOVE 17 TO COND-WORD.
053400     IF FILE-STATUS-1 = "2"
053500         MOVE "ERROR - LEVEL NOT EXIST IN MLEVEL"
053600                                   TO   MLEVEL-LEVEL-DESC
053700     ELSE
053800     IF FILE-STATUS NOT = "00"
053900         MOVE "DBGET ERR MODE7 MLEVEL" TO BU-DISPLAY-MSG
054000         PERFORM 2100-BLOWUP.
054100
054200 7990-OS-X.
054300     EXIT.
054400
054500 8000-PRINT-LEVELS SECTION.
054600 8005-PRINT-LEVEL-START.
054700     OPEN OUTPUT TEMP-LEVEL-FILE.
054800     PERFORM 8810-LOAD-TEMP-LEVELS THRU 8150-LTL-X.
054900     CLOSE TEMP-LEVEL-FILE.
055000
055100     SORT SORT-FILE-2 ON ASCENDING KEY SORT2-LEVEL-NUM
055200         USING TEMP-LEVEL-FILE
055300         GIVING TEMP-LEVEL-FILE.
055400
055500     OPEN INPUT TEMP-LEVEL-FILE.
055600
055700 8010-READ-LOOP.
055800     READ TEMP-LEVEL-FILE AT END
055900         GO TO 8990-PL-X.
056000
056100     MOVE LV-LEVEL-NUM             TO   PRT-LEVEL.
056200     MOVE LV-LEVEL-DESC            TO   PRT-LEVEL-DESC.
056300     MOVE LV-ACTIVE-EMPL           TO   PRT-ID,
056400                                        EMPL-ARG.
056500     PERFORM 7820-GET-PERNAME.
056600     MOVE SPACES                   TO   PRT-O-S.
056700
056800     WRITE PRT-REC FROM LEVEL-LINE AFTER ADVANCING 1.
056900
057000     GO TO 8010-READ-LOOP.
057100
057200******************************************************************
057300** GET LEVELS SECTION PERFORMED ROUTINES                        **
057400******************************************************************
057500 8810-LOAD-TEMP-LEVELS.
057600*------- REWIND THE MASTER DATASET (START FROM BEGINNING)
057700*    CALL "DBCLOSE" USING BASE, DSET-MLEVEL, MODE3,
057800*      STATUS-AREA.
           MOVE SPACES TO LEVELNUM OF MLEVEL-REC-I.
           START MLEVEL-I KEY > LEVELNUM OF MLEVEL-REC-I
               INVALID KEY MOVE 17 TO COND-WORD.
           IF (FILE-STATUS NOT = "00") AND (FILE-STATUS-1 NOT = "2")
058000         MOVE "DBCLOSE ERROR (REWIND) 7800-LS" TO BU-DISPLAY-MSG
058100         PERFORM 2100-BLOWUP.
058200
058300 8120-GET-MLEV-LOOP.
058400*    CALL "DBGET" USING BASE, DSET-MLEVEL, MODE2, STATUS-AREA,
058500*      ALL-ITEMS, BUF-MLEVEL, LEVEL-ARG.
           READ MLEVEL-I NEXT INTO BUF-MLEVEL
               AT END MOVE 15 TO COND-WORD.
           IF FILE-STATUS NOT = "00"
058700         GO TO 8150-LTL-X.
059200
059300     MOVE MLEVEL-LEVEL-NUM         TO   LV-LEVEL-NUM.
059400     MOVE MLEVEL-LEVEL-DESC        TO   LV-LEVEL-DESC.
059500     MOVE MLEVEL-ACTIVE-EMPL       TO   LV-ACTIVE-EMPL.
059600
059700     WRITE TEMP-LEVEL-REC.
059800
059900     GO TO 8120-GET-MLEV-LOOP.
060000
060100 8150-LTL-X.
060200     EXIT.
060300
060400 8990-PL-X.
060500     EXIT.

       COPY OVRPFCALL IN COPYLIB.
