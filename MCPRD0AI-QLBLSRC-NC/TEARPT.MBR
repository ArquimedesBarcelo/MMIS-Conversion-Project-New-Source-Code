000200 IDENTIFICATION DIVISION.
000300 PROGRAM-ID.     TEARPT.
000400 AUTHOR.         C HILLES.
000500 DATE-WRITTEN.   04/06/88.
000600 DATE-COMPILED.
000700*INSTALLATION.   GOODYEAR TIRE AND RUBBER - AKRON.
000800*SECURITY.
000900*REMARKS.
001000*D   THIS PGM REPORTS ON THE PATH DEFINITIONS AND LEVELS THAT ARE
001100*D   SET UP FOR THE ONLINE REQ APPROVAL SYSTEM.
001200
      *C
      *C   03/28/2002   CA YODER   (J. THOMAS REQUEST)
      *C      FOR R3 PLANTS, SORT BY LOW VALUE, TYPE, THEN INCL/EXCL.
      *C

001300 ENVIRONMENT DIVISION.
001400 CONFIGURATION SECTION.
001500 SOURCE-COMPUTER.  HP-3000.
001600 OBJECT-COMPUTER.  HP-3000.
       SPECIAL-NAMES. C01 IS NEW-PAGE.
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT MPATH-I
                  ASSIGN TO DATABASE-MCFLCS3901
                  ORGANIZATION IS INDEXED
                    ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                  FILE STATUS IS FILE-STATUS.

           SELECT MLEVEL-I
                  ASSIGN TO DATABASE-MCFLCS4101
                  ORGANIZATION IS INDEXED
                    ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                  FILE STATUS IS FILE-STATUS.

           SELECT PER-PERSONNEL-I
                  ASSIGN TO DATABASE-MCFLMM0301
                  ORGANIZATION IS INDEXED
                    ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                  FILE STATUS IS FILE-STATUS.

           SELECT DPATHDEF-I
                  ASSIGN TO DATABASE-MCFLCS4001
                  ORGANIZATION IS INDEXED
                    ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                    WITH DUPLICATES
                  FILE STATUS IS FILE-STATUS.

           SELECT MPLTINFO-I
                  ASSIGN TO DATABASE-MCFLCS0501
                  ORGANIZATION IS INDEXED
                    ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                  FILE STATUS IS FILE-STATUS.

002200     SELECT PRINT-FILE ASSIGN TO PRINTER-MCPRT.
002300     SELECT SORT-FILE ASSIGN TO DISK-SORT.
002400     SELECT TEMP-LEVEL-FILE ASSIGN TO DISK-DTMPLEV.
002500     SELECT SORT-FILE-2 ASSIGN TO DISK-SORT2.
002600
002700 DATA DIVISION.
002800 FILE SECTION.
       FD  MPATH-I
           LABEL RECORDS ARE STANDARD.
       01  MPATH-REC-I.
           COPY DDS-MCRPCS3900  OF MCFLCS3901.

       FD  MLEVEL-I
           LABEL RECORDS ARE STANDARD.
       01  MLEVEL-REC-I.
           COPY DDS-MCRPCS4100  OF MCFLCS4101.

       FD  PER-PERSONNEL-I
           LABEL RECORDS ARE STANDARD.
       01  PER-PERSONNEL-REC-I.
           COPY DDS-MCRPMM0300  OF MCFLMM0301.

       FD  DPATHDEF-I
           LABEL RECORDS ARE STANDARD.
       01  DPATHDEF-REC-I.
           COPY DDS-MCRPCS4000  OF MCFLCS4001.

       FD  MPLTINFO-I
           LABEL RECORDS ARE STANDARD.
       01  MPLTINFO-I-REC.
           COPY DDS-MCRPCS0500  OF MCFLCS0501.

002900 FD  PRINT-FILE RECORD CONTAINS 132 CHARACTERS
003000     LABEL RECORD IS OMITTED
003100     DATA RECORD IS PRT-REC.
003200 01  PRT-REC                 PIC X(132).
003300
003400 SD  SORT-FILE.
003500 01  SORT-REC.
003600     05  SORT-PATH                 PIC X(4).
003700     05  SORT-INCL-EXCL-FLAG       PIC X(2).
003800     05  SORT-TYPE                 PIC X(2).
003900     05  SORT-LOW-VALUE            PIC X(14).
004000     05  SORT-HIGH-VALUE           PIC X(14).
004100     05  SORT-LEVEL                PIC X(2).
004200     05  SORT-I-S                  PIC X(1).
004300     05  SORT-ODD-EVEN-FLAG        PIC X(1).
004400
004500 FD  TEMP-LEVEL-FILE
           RECORD CONTAINS 42 CHARACTERS.
004600 01  TEMP-LEVEL-REC.
004700     05  LV-LEVEL-NUM              PIC X(2).
004800     05  LV-LEVEL-DESC             PIC X(36).
004900     05  LV-ACTIVE-EMPL            PIC X(4).
005000
005100 SD  SORT-FILE-2
           RECORD CONTAINS 42 CHARACTERS.
005200 01  SORT-REC-2.
005300     05  SORT2-LEVEL-NUM           PIC X(2).
005400     05  SORT2-LEVEL-DESC          PIC X(36).
005500     05  SORT2-ACTIVE-EMPL         PIC X(4).
005600
005700 WORKING-STORAGE SECTION.
005800 01  FIRST-TIME-FLAG               PIC X(1).
005900 01  END-OF-FILE-FLAG              PIC X(1).
006000 01  COMP-ESC-SEQ                  PIC X(8)  VALUE SPACES.
006100 01  STAND-ESC-SEQ                 PIC X(8)  VALUE SPACES.
006200 01  LINE-CNT                      PIC 9(2)  VALUE 0.
006300 01  PAGE-CNT                      PIC 9(2)  VALUE 0.
006400 01  SUB                           PIC 9(2)  VALUE 0.
006500 01  CONVERT-NUM                   PIC 9(10) VALUE 0.
006600 01  SAVE-PATH                     PIC X(4).
       01  SAVE-REQ-SYNR3-SW             PIC X(1).
       01  MPLTINFO-ARG                  PIC X(4).
006700
006800 01  JCW-PARMS.
006900     05  JCW-NAME                  PIC X(12) VALUE SPACES.
007000     05  JCW-VALUE                 PIC S9(4) COMP-4 VALUE ZEROES.
007100     05  JCW-STATUS                PIC S9(4) COMP-4 VALUE ZEROES.
007200
007300 01  PAPER-VALUE                   PIC S9(4) COMP-4 VALUE ZEROES.
007400
