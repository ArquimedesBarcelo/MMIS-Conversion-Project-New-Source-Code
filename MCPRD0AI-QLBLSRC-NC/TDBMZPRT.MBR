       IDENTIFICATION DIVISION.
       PROGRAM-ID.             TDBMZPRT.
       AUTHOR.                 W. ROXBURY.
       INSTALLATION.           GOODYEAR TIRE & RUBBER CO.
      *REMARKS.                ZONE-PRINTER MAINTENANCE PROGRAM.
      *                            ****.
       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.
       SOURCE-COMPUTER.        IBM-AS400.
       OBJECT-COMPUTER.        IBM-AS400.
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT ZONE-PRINTER
                  ASSIGN       TO DATABASE-MCFLZP0101
                  ORGANIZATION IS INDEXED
                  ACCESS MODE  IS DYNAMIC
                  RECORD KEY   IS EXTERNALLY-DESCRIBED-KEY
                  FILE STATUS  IS FILE-STAT.

           SELECT DISPLAY-FILE
                  ASSIGN       TO WORKSTATION-ZZPRINT-SI
                  ORGANIZATION IS TRANSACTION
                  ACCESS MODE  IS DYNAMIC
                  RELATIVE KEY IS RECNO
                  FILE STATUS  IS SCREEN-STATUS
                               MAJOR-MINOR
                  CONTROL-AREA IS SCREEN-CONTROL.

       DATA DIVISION.
       FILE SECTION.
       FD  ZONE-PRINTER
           LABEL RECORDS       ARE STANDARD.
       01  ZP-REC.
           COPY DDS-ALL-FORMATS OF MCFLZP0101.

       FD  DISPLAY-FILE
           LABEL RECORDS       ARE OMITTED.
       01  DISPLAY-REC         PIC X(2000).

       WORKING-STORAGE SECTION.
       77  SUB1                PIC 99         VALUE 0.
       77  SUB2                PIC 99         VALUE 0.
       77  EOF-SW              PIC 9          VALUE 0.
       77  RECNO               PIC 9999       VALUE 0.
       77  TRUE-VAL            PIC 1          VALUE B"1".
       77  NEG-VAL             PIC 1          VALUE B"0".

       01  PASSWORD-INFORMATION.
           05  NAME-OF-PROG    PIC X(08) VALUE "TDBMZPRT".
           05  PROGRAM-TYPE    PIC X(02) VALUE "MA".
           05  PROGRAM-RELEASE PIC X(12) VALUE " K0100010001".
           05  PROGRAM-DESCRIPTION.
               10  PROG-DESC-A PIC X(60) VALUE
             "CONTROLS MAINTENANCE ON THE ZONE PRINT DATA BASE".
               10  PROG-DESC-B PIC X(60) VALUE SPACES.
               10  PROG-FUNC   PIC X(60) VALUE SPACES.
           05  PASSWORD-FLAG   PIC X VALUE "Y".

       01  FILE-STAT.
           05 FILE-STAT-1      PIC X   VALUE "0".
           05 FILE-STAT-2      PIC X   VALUE "0".

       01  SCREEN-DATA.
           05  ZONE-BUF                  PIC X(04) VALUE SPACES.
           05  PRINTER-BUFFERS.
               10  PRINTER-BUF-V.
                   15  P-BUF-V-1         PIC X     VALUE SPACES.
                   15  P-BUF-V-2         PIC X     VALUE SPACES.
               10  PRINT-BUF-V-9         REDEFINES PRINTER-BUF-V.
                   15  P-BUF-V-1-9       PIC 9.
                   15  P-BUF-V-2-9       PIC 9.
               10  PRINTER-BUF-P.
                   15  P-BUF-P-1         PIC X     VALUE SPACES.
                   15  P-BUF-P-2         PIC X     VALUE SPACES.
               10  PRINT-BUF-P-9         REDEFINES PRINTER-BUF-P.
                   15  P-BUF-P-1-9       PIC 9.
                   15  P-BUF-P-2-9       PIC 9.
               10  PRINTER-BUF-E.
                   15  P-BUF-E-1         PIC X     VALUE SPACES.
                   15  P-BUF-E-2         PIC X     VALUE SPACES.
               10  PRINT-BUF-E-9         REDEFINES PRINTER-BUF-E.
                   15  P-BUF-E-1-9       PIC 9.
                   15  P-BUF-E-2-9       PIC 9.
               10  PRINTER-BUF-M.
                   15  P-BUF-M-1         PIC X     VALUE SPACES.
                   15  P-BUF-M-2         PIC X     VALUE SPACES.
               10  PRINT-BUF-M-9         REDEFINES PRINTER-BUF-M.
                   15  P-BUF-M-1-9       PIC 9.
                   15  P-BUF-M-2-9       PIC 9.
               10  PRINTER-BUF-X.
                   15  P-BUF-X-1         PIC X     VALUE SPACES.
                   15  P-BUF-X-2         PIC X     VALUE SPACES.
               10  PRINT-BUF-X-9         REDEFINES PRINTER-BUF-X.
                   15  P-BUF-X-1-9       PIC 9.
                   15  P-BUF-X-2-9       PIC 9.
           05  MSG-LINE                  PIC X(60) VALUE SPACES.
           05  SCREEN-MSGS.
               10  CMDMSG                PIC X(79).
               10  ERRMSG                PIC X(79).

       01  ZPRT-BUFF.
           05  CMDMSG-01       PIC  X(79).
           05  ERRMSG-01       PIC  X(79).

       01  ZPRT-BUFF-SUB.
           05  Z-DISP          PIC XXXX.
           05  V-DISP          PIC XX.
           05  P-DISP          PIC XX.
           05  E-DISP          PIC XX.
           05  M-DISP          PIC XX.
           05  X-DISP          PIC XX.

       01  DB-ERROR.
           05  DB-FUNC   PIC X(10) VALUE SPACES.
           05  DB-FILE   PIC X(18) VALUE SPACES.
           05  FILLER    PIC X(20) VALUE "ERROR - FILE-STAT = ".
           05  CON-WORD  PIC XX.

           COPY SCREENIO       IN COPYLIB.

           COPY CATREAD        IN COPYLIB.

       01  MESSAGE-BUFF-DATA.
           COPY ERRORLIN       IN COPYLIB.

       01  ZONE-DATA.
           COPY DZONESPL       IN COPYLIB.

       PROCEDURE DIVISION.
       CHECK-PASSWORD.
           CALL "TPWORD"       USING PASSWORD-INFORMATION.
           IF PASSWORD-FLAG NOT = "N"
               GO TO BEGIN.
           GOBACK.

       BEGIN.
           OPEN I-O            DISPLAY-FILE.
           OPEN I-O            ZONE-PRINTER.
           MOVE "ZONPRTMAIN"   TO SCREEN-NAME.

       6-MAIN.
           MOVE 0              TO EOF-SW.
           MOVE SPACES         TO SCREEN-DATA ZONE-DATA.

       61-SHOWFORM.
           MOVE "00"           TO SCREEN-STATUS.
           MOVE SCREEN-DATA    TO DISPLAY-REC.

           WRITE DISPLAY-REC   FORMAT IS SCREEN-NAME
                               INDIC ARE SCREEN-INDICATORS.
           IF SCREEN-STATUS NOT = "00"
               DISPLAY "SCREEN WRITE ERROR.  SCREEN-STATUS IS "
                               SCREEN-STATUS
               GO TO END-OF-JOB.

           READ  DISPLAY-FILE  FORMAT IS SCREEN-NAME
                               INDIC ARE SCREEN-INDICATORS
           IF SCREEN-STATUS NOT = "00"
               DISPLAY "SCREEN READ ERROR.  SCREEN-STATUS IS "
                               SCREEN-STATUS
               GO TO END-OF-JOB.

           MOVE DISPLAY-REC    TO SCREEN-DATA.
           MOVE ALL B"0"       TO SCREEN-INDICATORS.

           IF KEY-HIT = 6
               PERFORM 62-LISTFILE THRU 62-LF-EXIT
               MOVE "ZONPRTMAIN"   TO SCREEN-NAME
               GO TO 6-MAIN.

           IF KEY-HIT = 3
               GO TO END-OF-JOB.

           IF KEY-HIT = 0
      **********************************************************************
      **    MESSAGE 042/017:
      **  PRESS APPROPRIATE FUNCTION KEY TO CONTINUE
      **********************************************************************
               MOVE  42        TO CATREAD-MSG-SET
               MOVE  17        TO CATREAD-MSG-NUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE 3          TO FIELD-NUMBER
               PERFORM 65-ERROR
               GO TO 61-SHOWFORM.

           IF ZONE-BUF = SPACES GO TO 61-SHOWFORM.

           IF KEY-HIT = 8
               GO TO 61-DELETE-RECORD.

           IF PRINTER-BUF-V = SPACES
      **********************************************************************
      **    MESSAGE 045/001:
      **  SPOOLER NUMBER IS REQUIRED
      **********************************************************************
               MOVE  45        TO CATREAD-MSG-SET
               MOVE   1        TO CATREAD-MSG-NUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE 3          TO FIELD-NUMBER
               PERFORM 65-ERROR
               GO TO 61-SHOWFORM.

           IF P-BUF-V-2 = SPACE
               MOVE P-BUF-V-1  TO P-BUF-V-2
               MOVE "0"        TO P-BUF-V-1.

           IF PRINT-BUF-V-9 NOT NUMERIC
      **********************************************************************
      **    MESSAGE 045/014:
      **  SPOOLER NUMBER MUST BE NUMERIC
      **********************************************************************
               MOVE  45        TO CATREAD-MSG-SET
               MOVE  14        TO CATREAD-MSG-NUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE 3          TO FIELD-NUMBER
               PERFORM 65-ERROR
               GO TO 61-SHOWFORM.

           IF PRINTER-BUF-P = SPACES
               MOVE PRINTER-BUF-V TO PRINTER-BUF-P.

           IF P-BUF-P-2 = SPACE
               MOVE P-BUF-P-1  TO P-BUF-P-2
               MOVE "0"        TO P-BUF-P-1.

           IF PRINT-BUF-P-9 NOT NUMERIC
      **********************************************************************
      **    MESSAGE 045/014:
      **  SPOOLER NUMBER MUST BE NUMERIC
      **********************************************************************
               MOVE  45        TO CATREAD-MSG-SET
               MOVE  14        TO CATREAD-MSG-NUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE 4          TO FIELD-NUMBER
               PERFORM 65-ERROR
               GO TO 61-SHOWFORM.

           IF PRINTER-BUF-E = SPACES
               MOVE PRINTER-BUF-V TO PRINTER-BUF-E.

           IF P-BUF-E-2 = SPACE
               MOVE P-BUF-E-1  TO P-BUF-E-2
               MOVE "0"        TO P-BUF-E-1.

           IF PRINT-BUF-E-9 NOT NUMERIC
      **********************************************************************
      **    MESSAGE 045/014:
      **  SPOOLER NUMBER MUST BE NUMERIC
      **********************************************************************
               MOVE  45        TO CATREAD-MSG-SET
               MOVE  14        TO CATREAD-MSG-NUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE 5          TO FIELD-NUMBER
               PERFORM 65-ERROR
               GO TO 61-SHOWFORM.

           IF PRINTER-BUF-M = SPACES
               MOVE PRINTER-BUF-V TO PRINTER-BUF-M.

           IF P-BUF-M-2 = SPACE
               MOVE P-BUF-M-1  TO P-BUF-M-2
               MOVE "0"        TO P-BUF-M-1.

           IF PRINTER-BUF-M = "XX"
               NEXT SENTENCE
           ELSE
           IF PRINT-BUF-M-9 NOT NUMERIC
      **********************************************************************
      **    MESSAGE 045/014:
      **  SPOOLER NUMBER MUST BE NUMERIC
      **********************************************************************
               MOVE  45        TO CATREAD-MSG-SET
               MOVE  14        TO CATREAD-MSG-NUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE 6          TO FIELD-NUMBER
               PERFORM 65-ERROR
               GO TO 61-SHOWFORM.

           MOVE SPACES         TO PRINTER-BUF-X.
      *****************************************************************
      ***  FIFTH AVAILABLE SPOOLER FIELD IS NOT USED AT THIS TIME.  ***
      *****************************************************************
      *    IF PRINTER-BUF-X = SPACES
      *        MOVE PRINTER-BUF-V TO PRINTER-BUF-X.
      *
      *    IF P-BUF-X-2 = SPACE
      *        MOVE P-BUF-X-1  TO P-BUF-X-2
      *        MOVE "0"        TO P-BUF-X-1.
      *
      *    IF PRINT-BUF-X-9 NOT NUMERIC
      **********************************************************************
      **    MESSAGE 045/014:
      **  SPOOLER NUMBER MUST BE NUMERIC
      **********************************************************************
      *        MOVE  45        TO CATREAD-MSG-SET
      *        MOVE  14        TO CATREAD-MSG-NUM
      *        PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
      *        MOVE 7          TO FIELD-NUMBER
      *        PERFORM 65-ERROR
      *        GO TO 61-SHOWFORM.

           IF KEY-HIT = 1
               GO TO 61-ADD-RECORD
           ELSE
           IF KEY-HIT = 2
               GO TO 61-CHANGE-RECORD.

           GO TO 61-SHOWFORM.

       61-ADD-RECORD.
           MOVE ZONE-BUF       TO ZONEKEY OF ZONE-PRINTER.
           START ZONE-PRINTER  KEY = ZONEKEY OF ZONE-PRINTER
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT = "00"
      **********************************************************************
      **    MESSAGE 044/013:
      **  RECORD ALREADY EXISTS
      **********************************************************************
               MOVE  44        TO CATREAD-MSG-SET
               MOVE  13        TO CATREAD-MSG-NUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE 1          TO FIELD-NUMBER
               PERFORM 65-ERROR
               GO TO 61-SHOWFORM.

           MOVE SCREEN-DATA    TO ZONE-DATA.
           WRITE ZP-REC        FROM ZONE-DATA
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT = "00"
      **********************************************************************
      **    MESSAGE 044/006:
      **  RECORD ADDED
      **********************************************************************
               MOVE  44        TO CATREAD-MSG-SET
               MOVE   6        TO CATREAD-MSG-NUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER TO MSG-LINE
               MOVE "00"       TO SCREEN-STATUS
               MOVE SCREEN-DATA TO DISPLAY-REC
               WRITE DISPLAY-REC FORMAT IS SCREEN-NAME
                               INDIC ARE SCREEN-INDICATORS
               IF SCREEN-STATUS NOT = "00"
                   DISPLAY "SCREEN WRITE ERROR.  SCREEN-STATUS IS "
                               SCREEN-STATUS
                   GO TO END-OF-JOB
               ELSE
                   MOVE ALL B"0"   TO SCREEN-INDICATORS
                   CALL "CLPAUSE2"
           ELSE
               MOVE FILE-STAT  TO CON-WORD
               MOVE "WRITE"    TO DB-FUNC
               MOVE "ZONE-PRINTER" TO DB-FILE
               MOVE DB-ERROR   TO MESSAGE-BUFFER
               MOVE 1          TO FIELD-NUMBER
               PERFORM 65-ERROR
               GO TO 61-SHOWFORM.

           GO TO 6-MAIN.

       61-CHANGE-RECORD.
           MOVE ZONE-BUF       TO ZONEKEY OF ZONE-PRINTER.
           READ ZONE-PRINTER   INTO ZONE-DATA
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT = "00"
               NEXT SENTENCE
           ELSE
           IF FILE-STAT-1 = "2"
      **********************************************************************
      **    MESSAGE 044/016:
      **  RECORD DOES NOT EXIST
      **********************************************************************
               MOVE  44        TO CATREAD-MSG-SET
               MOVE  16        TO CATREAD-MSG-NUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE 1          TO FIELD-NUMBER
               PERFORM 65-ERROR
               GO TO 61-SHOWFORM
           ELSE
               MOVE FILE-STAT  TO CON-WORD
               MOVE "READ "    TO DB-FUNC
               MOVE "ZONE-PRINTER" TO DB-FILE
               MOVE DB-ERROR   TO MESSAGE-BUFFER
               MOVE 1          TO FIELD-NUMBER
               PERFORM 65-ERROR
               GO TO 61-SHOWFORM.

           MOVE SCREEN-DATA    TO ZONE-DATA.
           REWRITE ZP-REC      FROM ZONE-DATA
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT = "00"
      **********************************************************************
      **    MESSAGE 044/008:
      **  RECORD CHANGED
      **********************************************************************
               MOVE  44        TO CATREAD-MSG-SET
               MOVE   8        TO CATREAD-MSG-NUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER TO MSG-LINE
               MOVE "00"       TO SCREEN-STATUS
               MOVE SCREEN-DATA TO DISPLAY-REC
               WRITE DISPLAY-REC FORMAT IS SCREEN-NAME
                               INDIC ARE SCREEN-INDICATORS
               IF SCREEN-STATUS NOT = "00"
                   DISPLAY "SCREEN WRITE ERROR.  SCREEN-STATUS IS "
                               SCREEN-STATUS
                   GO TO END-OF-JOB
               ELSE
                   MOVE ALL B"0" TO SCREEN-INDICATORS
                   CALL "CLPAUSE2"
           ELSE
               MOVE FILE-STAT  TO CON-WORD
               MOVE "REWRITE"  TO DB-FUNC
               MOVE "ZONE-PRINTER" TO DB-FILE
               MOVE DB-ERROR   TO MESSAGE-BUFFER
               MOVE 1          TO FIELD-NUMBER
               PERFORM 65-ERROR
               GO TO 61-SHOWFORM.

           GO TO 6-MAIN.

       61-DELETE-RECORD.
           MOVE ZONE-BUF       TO ZONEKEY OF ZONE-PRINTER.
           READ ZONE-PRINTER   INTO ZONE-DATA
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT = "00"
               NEXT SENTENCE
           ELSE
           IF FILE-STAT-1 = "2"
      **********************************************************************
      **    MESSAGE 044/016:
      **  RECORD DOES NOT EXIST
      **********************************************************************
               MOVE  44        TO CATREAD-MSG-SET
               MOVE  16        TO CATREAD-MSG-NUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE 1          TO FIELD-NUMBER
               PERFORM 65-ERROR
               GO TO 61-SHOWFORM
           ELSE
               MOVE FILE-STAT  TO CON-WORD
               MOVE "READ "    TO DB-FUNC
               MOVE "ZONE-PRINTER" TO DB-FILE
               MOVE DB-ERROR   TO MESSAGE-BUFFER
               MOVE 1          TO FIELD-NUMBER
               PERFORM 65-ERROR
               GO TO 61-SHOWFORM.

           DELETE ZONE-PRINTER
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT = "00"
      **********************************************************************
      **    MESSAGE 044/007:
      **  RECORD DELETED
      **********************************************************************
               MOVE  44        TO CATREAD-MSG-SET
               MOVE   7        TO CATREAD-MSG-NUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER TO MSG-LINE
               MOVE "00"       TO SCREEN-STATUS
               MOVE SCREEN-DATA TO DISPLAY-REC
               WRITE DISPLAY-REC  FORMAT IS SCREEN-NAME
                               INDIC ARE SCREEN-INDICATORS
               IF SCREEN-STATUS NOT = "00"
                   DISPLAY "SCREEN WRITE ERROR.  SCREEN-STATUS IS "
                               SCREEN-STATUS
                   GO TO END-OF-JOB
               ELSE
                   MOVE ALL B"0" TO SCREEN-INDICATORS
                   CALL "CLPAUSE2"
           ELSE
               MOVE FILE-STAT  TO CON-WORD
               MOVE "DELETE"   TO DB-FUNC
               MOVE "ZONE-PRINTER" TO DB-FILE
               MOVE DB-ERROR   TO MESSAGE-BUFFER
               MOVE 1          TO FIELD-NUMBER
               PERFORM 65-ERROR
               GO TO 61-SHOWFORM.

           GO TO 6-MAIN.

       62-LISTFILE.
           MOVE SPACES         TO ZONEKEY OF ZONE-PRINTER.
           START ZONE-PRINTER  KEY > ZONEKEY OF ZONE-PRINTER
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.

           MOVE 0              TO RECNO.
           MOVE NEG-VAL        TO IND(75).
           MOVE TRUE-VAL       TO IND(77) IND(76).
           MOVE SPACES         TO ZPRT-BUFF-SUB
                                  DISPLAY-REC.
           WRITE DISPLAY-REC   FORMAT "ZPRTLIST"
                               INDIC ARE SCREEN-INDICATORS.
           IF SCREEN-STATUS NOT = "00"
               DISPLAY
               "SUBFILE CLEAR WRITE ERROR.  SCREEN-STATUS IS "
                               SCREEN-STATUS.
           MOVE NEG-VAL        TO IND(77).

       DBGET-LOOP.
           READ ZONE-PRINTER
               NEXT INTO ZONE-DATA
               AT END          MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT = "10" OR "14" OR "46"
               GO TO SUBF-CONT
           ELSE
           IF FILE-STAT NOT = "00"
               MOVE SPACES     TO MESSAGE-BUFFER
               MOVE "READ ERROR, ZONE-PRINTER               FILE-STAT ="
                               TO MSG-TEXT
               MOVE FILE-STAT  TO MSG-FLD
               MOVE MESSAGE-BUFFER TO ERRMSG-01
               MOVE  1         TO FIELD-NUMBER
               MOVE TRUE-VAL   TO IND(FIELD-NUMBER) IND(99)
               GO TO 61-SHOWFORM.

           MOVE SPACES         TO ZPRT-BUFF-SUB.
           MOVE ZONE-ID        TO Z-DISP.
           MOVE PRINTER-ID-V   TO V-DISP.
           MOVE PRINTER-ID-P   TO P-DISP.
           MOVE PRINTER-ID-E   TO E-DISP.
           MOVE PRINTER-ID-M   TO M-DISP.
           MOVE PRINTER-ID-X   TO X-DISP.

           ADD 1               TO RECNO.
           MOVE ZPRT-BUFF-SUB  TO DISPLAY-REC.
           MOVE "00" TO SCREEN-STATUS.
           WRITE SUBFILE       DISPLAY-REC FORMAT "ZPRTDISP"
                               INDIC ARE SCREEN-INDICATORS
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF SCREEN-STATUS NOT = "00"
               DISPLAY   "SUBFILE 1 WRITE ERROR.  SCREEN STATUS IS "
                               SCREEN-STATUS
               GO TO END-OF-JOB.

           GO TO DBGET-LOOP.

       SUBF-CONT.
           IF RECNO EQUAL 0
               MOVE "ZONPRTMAIN" TO SCREEN-NAME
               GO TO 6-MAIN.

           WRITE DISPLAY-REC   FORMAT "ZPRTSEL"
                               INDIC ARE SCREEN-INDICATORS.
           MOVE TRUE-VAL       TO IND(76).
           IF RECNO GREATER THAN 0
               MOVE TRUE-VAL   TO IND(75)
           ELSE
               MOVE NEG-VAL    TO IND(75).
           MOVE ZPRT-BUFF      TO DISPLAY-REC.
           WRITE DISPLAY-REC   FORMAT "ZPRTLIST"
                               INDIC ARE SCREEN-INDICATORS.
           READ DISPLAY-FILE   FORMAT "ZPRTLIST"
                               INDIC ARE SCREEN-INDICATORS.
           READ SUBFILE DISPLAY-FILE
                               NEXT MODIFIED INTO ZPRT-BUFF-SUB
                               FORMAT "ZPRTDISP"
                               INDIC ARE SCREEN-INDICATORS.
       62-LF-EXIT.             EXIT.

       65-ERROR.
           MOVE MESSAGE-BUFFER TO ERRMSG.
           MOVE TRUE-VAL       TO IND(FIELD-NUMBER) IND(99).

       END-OF-JOB.
           CLOSE               DISPLAY-FILE.
           CLOSE               ZONE-PRINTER.
           GOBACK.

       999-CATREAD.
           MOVE SPACES         TO MESSAGE-BUFFER.
           CALL "CCATREAD"     USING CATREAD-PARMS.
           MOVE CATREAD-MSG-TEXT TO MESSAGE-BUFFER.

       999-CATREAD-EXIT.       EXIT.

