       EDIT-LEVEL-DATA.
           IF W-SAVE1 = " " OR "-"
              MOVE "0"         TO W-SAVE1.

           IF W-SAVE2 = " " OR "-"
              MOVE W-SAVE1     TO W-SAVE2
              MOVE "0"         TO W-SAVE1.

           IF W-SAVE NOT NUMERIC
              MOVE SPACE       TO R-SAVE
              MOVE "--"        TO W-SAVE.

           IF W-SAVE = "00"
              MOVE SPACE       TO R-SAVE
              MOVE "--"        TO W-SAVE.

           IF R-SAVE = SPACE AND R-TAB(SUB) = "*"
              MOVE "*"         TO R-SAVE
           ELSE
           IF R-SAVE = SPACE
              MOVE SPACES      TO RESTRICT(SUB) R-TAB(SUB)
           ELSE
           IF "*"   = R-SAVE AND R-TAB(SUB)
              NEXT SENTENCE
           ELSE
           IF R-SAVE NOT = " "
              MOVE "Y"         TO R-SAVE.

       END-OF-JOB.
           CLOSE               PM-SCHEDULE
                               DISPLAY-FILE.
           GOBACK.

       999-CATREAD.
           MOVE LANG-SETNUM    TO CATREAD-MSG-SET.
           MOVE LANG-MSGNUM    TO CATREAD-MSG-NUM.
           MOVE SPACES         TO MESSAGE-BUFFER,
           CALL "CCATREAD"     USING CATREAD-PARMS.
           IF CATREAD-MSG-NOT-FOUND
               MOVE "***ERROR***" TO MESSAGE-BUFFER
           ELSE
               MOVE CATREAD-MSG-TEXT TO MESSAGE-BUFFER.

       999-CATREAD-EXIT.       EXIT.

       99-ERROR.
           IF SCREEN-NAME = "VCALENDAR"
               MOVE MESSAGE-BUFFER TO SD-ERRMSG
           ELSE
               MOVE MESSAGE-BUFFER TO SR-ERRMSG.
           MOVE TRUE-VAL       TO IND(FIELD-NUMBER) IND(99).

