       UNLOAD-LEVEL-DATA.
           MOVE SPACES         TO PM-SCHED-DATA.
           MOVE LINK-YRMO      TO SCH-RELEASE-YRMO.
           MOVE LD-YEAR        TO SCH-RELEASE-DATE.
           MOVE LD-MONTH       TO SCH-REL-MO.
           MOVE SUB            TO SCH-REL-DAY.
           MOVE "CL  "         TO SCH-REC-TYPE.
           MOVE LINK-EQUIP     TO SCH-EQUIP-NUM.
           MOVE LINK-WONUM     TO SCH-WO-NUM.
           MOVE LINK-ZONE-PRI  TO SCH-ZONE-PRI.
           MOVE SPACES         TO SCH-PREREL-DATE.
           MOVE W-SAVE-9       TO SCH-LEVEL.
           MOVE SPACES         TO SCH-PR-ID.
           MOVE RESTRICT(SUB)  TO SCH-RESTRICT.
           MOVE PM-SCHED-DATA  TO DAY-DATA(SUB).
           IF SCH-RELEASE-DATE < TODAYS-DATE
               MOVE SPACES     TO DAY-DATA(SUB).

       EXPAND-RESTRICTIONS.
           IF SCREEN-NAME NOT = "VRESTRICT"
               MOVE "VRESTRICT" TO SCREEN-NAME.

           MOVE SPACES         TO SCREEN-REST.
           MOVE W-SAVE-9       TO B-LEVEL.
           MOVE LINK-EQUIP     TO B-EQUIP.
           MOVE LINK-WONUM     TO B-WO.
           MOVE MO-NAME        TO B-MONTH.
           MOVE SUB            TO B-DAY.
           MOVE LD-YEAR        TO B-YEAR.

           IF R-PRX(SUB) = SPACES
               MOVE ZEROS      TO PR-CYCLE
           ELSE
               MOVE R-PR(SUB)  TO PR-CYCLE.

           IF R-1(SUB) = "A"
               MOVE "X"        TO R-A
           ELSE
           IF R-1(SUB) = "B"
               MOVE "X"        TO R-B
           ELSE
           IF R-1(SUB) = "C"
               MOVE "X"        TO R-C
           ELSE
           IF R-1(SUB) = "D"
               MOVE "X"        TO R-D.

           MOVE SCREEN-REST    TO DISPLAY-REC.
           PERFORM SHOWFORM-REST THRU SR-EXIT.
           GO TO ER-EXIT.

       SHOWFORM-REST.
           WRITE DISPLAY-REC  FORMAT IS SCREEN-NAME
               INDIC ARE SCREEN-INDICATORS.
           IF SCREEN-STATUS NOT = "00"
               DISPLAY "SCREEN WRITE ERROR.  SCREEN-STATUS IS "
                        SCREEN-STATUS
               GO TO END-OF-JOB.

           READ  DISPLAY-FILE FORMAT IS SCREEN-NAME
               INDIC ARE SCREEN-INDICATORS
           IF SCREEN-STATUS NOT = "00"
               DISPLAY "SCREEN READ ERROR.  SCREEN-STATUS IS "
                        SCREEN-STATUS
               GO TO END-OF-JOB.

           MOVE ALL B"0"       TO SCREEN-INDICATORS.
           MOVE DISPLAY-REC    TO SCREEN-REST.

           IF KEY-HIT = 3 OR 8
               GO TO SR-EXIT.

           IF KEY-HIT = 7
               MOVE 461        TO HELP-SW
               CALL "SPMHELPM" USING HELP-SW
               GO TO SHOWFORM-REST.

           IF PR-2 = SPACE
               MOVE PR-1       TO PR-2
               MOVE 0          TO PR-1.
           IF PR-2 = SPACE
               MOVE PR-1       TO PR-2
               MOVE 0          TO PR-1.
           IF PR-1 = SPACE
               MOVE 0          TO PR-1.

           IF PR-CYC-X NOT NUMERIC
      *M********************************************************************
      *M    MESSAGE 020/047:
      *M T47: THIS ENTRY MUST BE NUMERIC
      *M********************************************************************
               MOVE  20        TO LANG-SETNUM
               MOVE  47        TO LANG-MSGNUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE  12        TO FIELD-NUMBER
               PERFORM 99-ERROR
               GO TO SHOWFORM-REST.

           MOVE 0              TO R-CTR.
           IF R-A NOT = SPACE
               MOVE "X"        TO R-A
               ADD 1           TO R-CTR.
           IF R-B NOT = SPACE
               MOVE "X"        TO R-B
               ADD 1           TO R-CTR.
           IF R-C NOT = SPACE
               MOVE "X"        TO R-C
               ADD 1           TO R-CTR.
           IF R-D NOT = SPACE
               MOVE "X"        TO R-D
               ADD 1           TO R-CTR.

           IF R-CTR > 1
      *M********************************************************************
      *M    MESSAGE 041/026:
      *M ONLY ONE FIELD MAY BE SELECTED
      *M********************************************************************
               MOVE  41        TO LANG-SETNUM
               MOVE  26        TO LANG-MSGNUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               PERFORM 99-ERROR
               GO TO SHOWFORM-REST.

           MOVE PR-CYCLE       TO R-PR(SUB) DD-REST-PR(SUB).
           MOVE SPACE          TO R-1 (SUB) DD-REST-1 (SUB)
                                  R-2 (SUB) DD-REST-2 (SUB).
           MOVE "*"            TO MARK.
           IF R-A NOT = SPACE
               MOVE "A"        TO R-1(SUB) DD-REST-1(SUB).
           IF R-B NOT = SPACE
               MOVE "B"        TO R-1(SUB) DD-REST-1(SUB).
           IF R-C NOT = SPACE
               MOVE "C"        TO R-1(SUB) DD-REST-1(SUB).
           IF R-D NOT = SPACE
               MOVE "D"        TO R-1(SUB) DD-REST-1(SUB).

