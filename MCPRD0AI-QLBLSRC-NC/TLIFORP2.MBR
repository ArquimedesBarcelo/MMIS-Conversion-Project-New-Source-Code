043500
       COPY CCRTFILE IN COPYLIB.
043600
043700 PROCEDURE DIVISION.
043800
043900 001-BEGIN SECTION.
044000
044100 010-MAINLINE.
           MOVE "C" TO MCXCBLERR-SCOPE.
           CALL "MCXCBLERR" USING MCXCBLERR-SCOPE.

044200*******************************************************
044300**   CALL 'CBLOWSRT' FIRST BEFORE GOING INTO THE
044400**   SORT VERB.  THE FIRST CALL TO 'CBLOWSRT' OPENS
044500**   UP A NEW TEMPORARY FILE 'BLUPDATA' THAT IS USED
044600**   TO WRITE THE BLOWUP INFORMATION IF A BLOWUP
044700**   OCCURS
044800*******************************************************
044900
045000     CALL "CBLOWSRT" USING CBLOWSRT-PARMS,
045100                           ACCTG-BASE,
045200                           BU-PGM-NAME,
045300                           STATUS-AREA,
045400                           DUMMY-VIEW-AREA,
045500                           FILE-STATUS,
045600                           BU-DISPLAY-MSG,
045700                           BU-DISPLAY-FLDS.
045800
045900     SORT SORT-FILE ON ASCENDING KEY SORT-CLASS
046000                                     SORT-MATL-CODE
046100         INPUT PROCEDURE IS 050-PROCESS-TRANS
046200         OUTPUT PROCEDURE IS 700-CREATE-REPORT.
046300
046400     PERFORM 1000-CLOSE-FILES.
046500     GOBACK.
046600
046700
046800 050-PROCESS-TRANS SECTION.
       050-PROCESS-TRANS-PARA.
046900     PERFORM 100-BEGIN.
047000     PERFORM 200-PROCESS-DETAIL
047100         UNTIL END-OF-FILE.
047200
047300     PERFORM 250-PROCESS-DCHG.
047400
047500**********************************************************
047600*  TRANSFER CONTROL TO LAST STATEMENT IN INPUT PROCEDURE *
047700*  FOR SORTING OF RECORDS.                               *
047800**********************************************************
047900
048000     GO TO 699-PROCESS-EXIT.
048100
048200 100-BEGIN.
           PERFORM 9999-OPEN-STUFF.
050200
050300******************************************************
050400**   GET IT DEPTS. FROM MACCOUNT-INFO (KEY=IT)
050500******************************************************
050600     MOVE "IT"                    TO MACCT-KEY.
           PERFORM 9999-DBGET7-MACCOUNT-INFO-IK-O.
051400     IF GOOD-CALL
051500         MOVE MACCT-IT-DEPT1      TO IT-DEPT1
051600         MOVE MACCT-IT-DEPT2      TO IT-DEPT2
051700     ELSE
051800         MOVE "GET MACCOUNT-INFO1 * 100-B" TO BU-DISPLAY-MSG
051900         MOVE MACCT-KEY TO BU-DISPLAY-FLD (1)
052000         PERFORM 990-BLOWUP.
052100
      *------ RELEASE MACCOUNT-INFO RECORD LOCKED BY PREVIOUS READ
           PERFORM 9999-RESET-MACCOUNT-INFO-IK-O.

052200     MOVE SPACES                  TO SORT-REC.
           PERFORM 9999-INIT-MMATL-ACCUM-MC-I.
052300     PERFORM 400-GET-MMATL-ACCUM.
052400     MOVE SPACES                  TO  NON-CODED-TABLE,
052500                                      SOPNRAV-PARMS.
052600
052700
052800 200-PROCESS-DETAIL.
052900     IF MATL-STORES-CODE = "NON-STR"
053000         NEXT SENTENCE
053100     ELSE
053200         PERFORM 650-GET-MSTORERM
053300         IF NO-ENTRY
053400             NEXT SENTENCE
053500         ELSE
053600             PERFORM 600-BUILD-SORT-REC.
053700
053800     PERFORM 400-GET-MMATL-ACCUM.
053900
054000 250-PROCESS-DCHG.
054100     MOVE SPACES TO SORT-REC.
054200     MOVE ZEROS                   TO SORT-CONV,
054300                                     SORT-AVG-COST,
054400                                     SORT-ISS-UNITS,
054500                                     SORT-ISS-DOLLARS,
054600                                     SORT-SHIPMENT-UNITS,
054700                                     SORT-SHIPMENT-DOLLARS,
054800                                     SORT-RTN-UNITS,
054900                                     SORT-RTN-DOLLARS,
055000                                     SORT-RTNVAL-UNITS,
055100                                     SORT-RTNVAL-DOLLARS,
055200                                     SORT-END-UNITS,
055300                                     SORT-END-DOLLARS,
055400                                     TABLE-LIMIT.
055500     MOVE "NON-STR"               TO MMATL-CODE-ARG.
           PERFORM 9999-DBFIND-DTRANS-MC-I.
055800     IF NOT GOOD-CALL
055900         IF NO-ENTRY
056000             NEXT SENTENCE
056100         ELSE
056200             MOVE "FIND DTRANS * 250-PD" TO BU-DISPLAY-MSG
056300             PERFORM 990-BLOWUP
056400     ELSE
056500         PERFORM 400-GET-DTRANS
056600         PERFORM 300-PROCESS-DETAIL
056700             UNTIL END-OF-CHAIN
056800         MOVE ZEROS TO SUB
056900         PERFORM 375-RELEASE-DCHG-RCDS
057000             VARYING SUB FROM 1 BY 1
057100                 UNTIL SUB > TABLE-LIMIT.
057200
057300 300-PROCESS-DETAIL.
057400     IF TRANS-CODE = "INV"
057500         IF TRANS-DOCUMENT-NUM NOT = "PROC"
057600             PERFORM 310-UPDATE-DCHG-INV
057700         ELSE
057800             NEXT SENTENCE
057900     ELSE
058000     IF TRANS-CODE = "DCHG"
058100         IF TRANS-BALANCE-QTY = 0
058200             NEXT SENTENCE
058300         ELSE
058400             PERFORM 320-UPDATE-DCHG-REC
058500     ELSE
058600     IF TRANS-CODE = "FRT"
058700         IF TRANS-DOCUMENT-NUM NOT = "PROC"
058800             PERFORM 330-UPDATE-FRT.
058900
059000     PERFORM 400-GET-DTRANS.
059100
059200 310-UPDATE-DCHG-INV.
059300     MOVE ZEROS  TO SUB.
059400     PERFORM 350-FIND-TABLE-ENTRY.
059500     ADD TRANS-QTY                TO NC-INV-UNITS (SUB).
059600     ADD TRANS-VALUE              TO NC-INV-DLRS (SUB).
059700
059800 320-UPDATE-DCHG-REC.
059900     MOVE ZEROS  TO SUB.
060000     PERFORM 350-FIND-TABLE-ENTRY.
060100     COMPUTE SAVE-UNIT-COST ROUNDED =
060200         TRANS-VALUE / TRANS-QTY.
060300     ADD TRANS-BALANCE-QTY        TO NC-DCHG-UNITS (SUB).
060400     COMPUTE NC-DCHG-DLRS (SUB) ROUNDED =
060500         NC-DCHG-DLRS (SUB) +
060600             (TRANS-BALANCE-QTY * SAVE-UNIT-COST).
060700
060800 330-UPDATE-FRT.
060900     MOVE ZEROS  TO SUB.
061000     PERFORM 350-FIND-TABLE-ENTRY.
061100     ADD TRANS-VALUE              TO NC-INV-DLRS (SUB).
061200
061300 350-FIND-TABLE-ENTRY.
061400     ADD 1  TO SUB.
061500     IF SUB > 500
061600         MOVE "TABLE LIMIT EXCEEDED (500) *350-FTE"
061700             TO BU-DISPLAY-MSG
061800         PERFORM 990-BLOWUP.
061900     IF SUB > TABLE-LIMIT
062000         ADD 1   TO TABLE-LIMIT
062100         MOVE ZEROS  TO NC-DCHG-UNITS (SUB),
062200                        NC-DCHG-DLRS (SUB),
062300                        NC-INV-UNITS (SUB),
062400                        NC-INV-DLRS (SUB)
062500         MOVE TRANS-CLASS         TO NC-CLASS (SUB)
062600     ELSE
062700     IF TRANS-CLASS = NC-CLASS (SUB)
062800         NEXT SENTENCE
062900     ELSE
063000         GO TO 350-FIND-TABLE-ENTRY.
063100
063200 375-RELEASE-DCHG-RCDS.
063300     MOVE NC-CLASS (SUB)          TO SORT-CLASS.
063400     MOVE "NON-STR"               TO SORT-MATL-CODE.
063500     MOVE "Non-Storeroom Item"    TO SORT-DESCR.
063600     MOVE "EA"                    TO SORT-UM.
063700     MOVE NC-DCHG-UNITS (SUB)     TO SORT-END-UNITS.
063800     MOVE NC-DCHG-DLRS (SUB)      TO SORT-END-DOLLARS.
063900     MOVE NC-INV-UNITS (SUB)      TO SORT-ISS-UNITS.
064000     MOVE NC-INV-DLRS (SUB)       TO SORT-ISS-DOLLARS.
064100     RELEASE SORT-REC.
064200
064300 400-GET-MMATL-ACCUM.
           PERFORM 9999-DBGET2-MMATL-ACCUM-MC-I.
065100     IF GOOD-CALL
065200         NEXT SENTENCE
065300     ELSE
065400         IF END-OF-FILE
065500             NEXT SENTENCE
065600         ELSE
065700             MOVE "DBGET MMATL-ACCUM * 400-GMA" TO BU-DISPLAY-MSG
065800             PERFORM 990-BLOWUP.
065900
066000 400-GET-DTRANS.
           PERFORM 9999-DBGET5-DTRANS-MC-I.
066300     IF COND-WORD NOT = 0
066400         IF COND-WORD = 15
066500             NEXT SENTENCE
066600         ELSE
066700             MOVE "GET DTRANS *400-GD" TO BU-DISPLAY-MSG
066800             PERFORM 990-BLOWUP.
066900
067000 600-BUILD-SORT-REC.
067100********************************************************
067200**   CALL 'SOPNRAV' TO GETTING ANY DIRECT CHARGE
067300**   OPEN RECEIVERS AND ALL DIRECT CHARGE INVOICES
067400**   PAID FOR THE MONTH.  IT ALSO SUPPLIES STOREROOM
067500**   OPEN RECEIVERS AND STOREROOM OPEN INVOICES.
067600********************************************************
067700     MOVE MATL-STORES-CODE        TO SOPNRAV-MATL-CODE.
067800     CALL "SOPNRAV" USING ACCTG-BASE,
067900                          SOPNRAV-PARMS,
068000                          STATUS-AREA,
068100                          BU-DISPLAY-MSG,
068200                          BU-DISPLAY-FLDS.
068300     IF BU-DISPLAY-MSG NOT = SPACES
068400         PERFORM 990-BLOWUP.
068500     MOVE MATL-STORES-CODE        TO SORT-MATL-CODE.
068600     MOVE MATL-CLASS              TO SORT-CLASS.
068700     MOVE MATL-ISSUE-UNITS        TO SORT-ISS-UNITS.
068800     MOVE MATL-TOT-ISS-DOLLARS    TO SORT-ISS-DOLLARS.
068900
069000**********************************************************
069100**   ADD ANY DIRECT CHARGE INVOICES PAID THIS MONTH
069200**   WHICH IS CALCULATED BY CALLING 'SOPNRAV' ABOVE
069300**********************************************************
069400     ADD S-DIR-PAID-INV-UNITS     TO SORT-ISS-UNITS.
069500     ADD S-DIR-PAID-INV-DLRS      TO SORT-ISS-DOLLARS.
069600     MOVE MATL-RTN-UNITS          TO SORT-RTN-UNITS.
069700     MOVE MATL-RTN-DOLLARS        TO SORT-RTN-DOLLARS.
069800     MOVE MATL-RTNVAL-UNITS       TO SORT-RTNVAL-UNITS.
069900     MOVE MATL-RTNVAL-DOLLARS     TO SORT-RTNVAL-DOLLARS.
070000
070100**********************************************************
070200**   INCLUDE ANY DIRECT CHARGE OPEN RECEIVERS CALCULATED
070300**   BY CALLING 'SOPNRAV' INTO THE ENDING BALANCE
070400**   CALCULATIONS
070500**********************************************************
070600     COMPUTE SORT-END-UNITS =
070700         MATL-BEG-BAL-UNITS +
070800         MATL-RCPT-UNITS +
070900         MATL-ADJ-UNITS +
071000         MATL-RTN-UNITS +
071100         MATL-RTNVAL-UNITS +
071200         MATL-ACCTG-UNIT-CORR -
071300         MATL-ISSUE-UNITS +
071400         S-STR-OPEN-INV-UNITS +
071500         S-STR-OPEN-RCVR-UNITS +
071600         S-DIR-OPEN-RCVR-UNITS +
071700         MATL-INTRANSIT-UNITS.
071800
071900     COMPUTE SORT-END-DOLLARS =
072000         MATL-BEG-BAL-DOLLARS +
072100         MATL-INV-DOLLARS +
072200         MATL-TOT-ADJ-DOLLARS +
072300         MATL-RTN-DOLLARS +
072400         MATL-RTNVAL-DOLLARS +
072500         MATL-ACCTG-DOLLAR-CORR -
072600         MATL-TOT-ISS-DOLLARS +
072700         S-STR-OPEN-INV-DLRS +
072800         S-STR-OPEN-RCVR-DLRS +
072900         S-DIR-OPEN-RCVR-DLRS +
073000         MATL-INTRANSIT-DOLLARS.
073100
073200     IF (MATL-CLASS > 099 AND MATL-CLASS < 200) OR
073300        (MATL-CLASS > 399 AND MATL-CLASS < 500)
073400         MOVE 1                   TO CDESC-LINES-TO-GET
073500         MOVE "N"                 TO CDESC-LOCAL-DESC-OPTION
073600         CALL "CDESC" USING RET-CODE, STORES-BASE, STATUS-AREA,
073700             BU-DISPLAY-MSG, MMATL-CODE-ARG, CDESC-DATA
073800         MOVE CDESC (1)           TO SORT-DESCR
073900     ELSE
074000         MOVE SPACES              TO SORT-DESCR.
074100
074200     PERFORM 670-CALC-SHIPMENTS.
074300
074400     RELEASE SORT-REC.
074500
074600     MOVE SPACES                  TO SORT-REC.
074700
074800 650-GET-MSTORERM.
074900     MOVE MATL-STORES-CODE        TO MMATL-CODE-ARG.
           PERFORM 9999-DBGET7-MSTORERM-CD-I.
075700     IF GOOD-CALL
075800         MOVE STR-UM              TO SORT-UM
075900         MOVE STR-AVG-COST        TO SORT-AVG-COST
076000         MOVE STR-UM1-CF          TO SORT-CONV
076100         MOVE STR-UM1             TO SORT-ALT-UM
076200         MOVE STR-CONS-IND        TO SORT-CONS-IND
076300     ELSE
076400         IF NO-ENTRY
076500             NEXT SENTENCE
076600         ELSE
076700             MOVE "DBGET MSTORERM* 650-GM" TO BU-DISPLAY-MSG
076800             MOVE MMATL-CODE-ARG  TO BU-DISPLAY-FLD (1)
076900             PERFORM 990-BLOWUP.
077000
077100
077200 670-CALC-SHIPMENTS.
077300     MOVE MATL-STORES-CODE        TO MMATL-CODE-ARG.
077400     MOVE ZEROS                   TO SORT-SHIPMENT-UNITS,
077500                                     SORT-SHIPMENT-DOLLARS.
           PERFORM 9999-DBFIND-DTRANS-MC-I.
078200     IF GOOD-CALL
078300         PERFORM 675-GET-DTRANS
078400            UNTIL END-OF-CHAIN
078500     ELSE
078600         IF NO-ENTRY
078700              NEXT SENTENCE
078800         ELSE
078900              MOVE "DBFIND DTRANS * 670-CALC" TO BU-DISPLAY-MSG
079000              MOVE MMATL-CODE-ARG TO BU-DISPLAY-FLD (1)
079100              PERFORM 990-BLOWUP.
079200
079300 675-GET-DTRANS.
           PERFORM 9999-DBGET5-DTRANS-MC-I.
080100     IF GOOD-CALL
080200         PERFORM 680-ACCUMULATE
080300     ELSE
080400         IF END-OF-CHAIN
080500             NEXT SENTENCE
080600         ELSE
080700             MOVE "DBGET DTRANS * 675-GET" TO BU-DISPLAY-MSG
080800             MOVE MMATL-CODE-ARG TO BU-DISPLAY-FLD (1)
080900             PERFORM 990-BLOWUP.
081000
081100 680-ACCUMULATE.
081200     IF TRANS-CODE = "ISS"
081300         IF TRANS-DEPT = IT-DEPT1 OR IT-DEPT2
081400             ADD TRANS-QTY        TO SORT-SHIPMENT-UNITS
081500             ADD TRANS-VALUE      TO SORT-SHIPMENT-DOLLARS.
081600
081700 699-PROCESS-EXIT.
081800     EXIT.
081900
082000
082100 700-CREATE-REPORT SECTION.
       700-CREATE-REPORT-PARA.
082200     DISPLAY "BEGIN REPORT".
082300     PERFORM 710-BEGIN-REPORT.
082400     PERFORM 720-PROCESS-CLASS
082500        UNTIL NO-MORE-SORT = "YES".
082600     PERFORM 725-END-REPORT.
082700     IF TOT-ERRS = 0
082800         PERFORM 780-UPDATE-LIFORPT-SW.
082900
083000**************************************************
083100**  BRANCH TO LAST STATEMENT OF OUTPUT SECTION  **
083200**  TO COMPLETE PROCESSING OF REPORT            **
083300**************************************************
083400
083500     GO TO 799-CREATE-EXIT.
083600
083700 710-BEGIN-REPORT.
      *----- BEFORE OPENING THE TEMP FILE AKRON-TEMP-FILE, IT MAY
      *----- NEED TO BE CREATED DEPENDING ON THE MACHINE WE ARE
      *----- RUNNING ON.  THEREFORE, WE PERFORM A MACHINE DEPENDENT
      *----- ROUTINE TO CREATE THIS FILE IF NEEDED.
           PERFORM 9999-CREATE-AKRNTEMP-FILE.

083800     OPEN OUTPUT ONLINE-PRT, AKRON-TEMP-FILE.
083900     RETURN SORT-FILE
084000        AT END
084100            MOVE "YES" TO NO-MORE-SORT.
084200     PERFORM 750-PRINT-HEADINGS.
084300
084400
084500 720-PROCESS-CLASS.
084600     PERFORM 721-BEGIN-CLASS.
084700     PERFORM 722-PROCESS-TRANS
084800         UNTIL SORT-CLASS NOT = PREV-CLASS
084900             OR NO-MORE-SORT = "YES".
085000     PERFORM 723-END-CLASS.
085100
085200 721-BEGIN-CLASS.
085300     MOVE SORT-CLASS              TO PREV-CLASS.
085400     MOVE 0                       TO CLASS-USAGE-DOLLARS
085500                                     CLASS-END-DOLLARS
085600                                     CLASS-USAGE-UNITS
085700                                     CLASS-END-UNITS.
085800
085900
086000 722-PROCESS-TRANS.
086100     MOVE SPACES                  TO WS-A-DATA.
086200     MOVE SORT-CLASS              TO PRT-CLASS,
086300                                     WS-A-TC30-CLASS.
086400     MOVE SORT-MATL-CODE          TO PRT-CORP-CODE,
086500                                     WS-A-TC30-CORP-CODE.
086600
086700     IF SORT-DESCR1 = "CODE                "
086800         MOVE SORT-DESCR2         TO PRT-CODE-DESC,
086900                                     WS-A-TC30-DESC
087000     ELSE
087100         MOVE SORT-DESCR          TO PRT-CODE-DESC,
087200                                     WS-A-TC30-DESC.
087300
087400     MOVE SORT-UM                 TO PRT-UM,
087500                                     WS-A-TC30-UM.
087600     MOVE SORT-AVG-COST           TO PRT-AVG-COST,
087700                                     WS-A-TC30-AVG-COST.
087800
087900     COMPUTE USAGE-UNITS = SORT-ISS-UNITS -
088000                           SORT-RTN-UNITS -
088100                           SORT-SHIPMENT-UNITS.
088200
088300     COMPUTE ROUNDED-USAGE-DOLLARS ROUNDED =
088400                           SORT-ISS-DOLLARS -
088500                           SORT-RTN-DOLLARS -
088600                           SORT-SHIPMENT-DOLLARS.
088700
088800     COMPUTE USAGE-DOLLARS = SORT-ISS-DOLLARS -
088900                             SORT-RTN-DOLLARS -
089000                             SORT-SHIPMENT-DOLLARS.
089100
089200     COMPUTE ROUNDED-END-DOLLARS ROUNDED =
089300                           SORT-END-DOLLARS * 1.
089400
089500     IF (SORT-CLASS > 099 AND SORT-CLASS < 200) OR
089600        (SORT-CLASS > 399 AND SORT-CLASS < 500)
089700       IF SORT-UM = "LB" OR "EA" OR "RL"
089800         NEXT SENTENCE
089900       ELSE
090000         IF SORT-ALT-UM NOT = SPACES
090100             IF SORT-CONV > 0
090200                 COMPUTE USAGE-UNITS ROUNDED = USAGE-UNITS
090300                                                   / SORT-CONV
090400                 COMPUTE SORT-END-UNITS ROUNDED =
090500                         SORT-END-UNITS / SORT-CONV
090600                 COMPUTE SORT-AVG-COST = SORT-AVG-COST *
090700                                         SORT-CONV
090800                 MOVE SORT-AVG-COST TO PRT-AVG-COST,
090900                                       WS-A-TC30-AVG-COST
091000                 MOVE SORT-ALT-UM   TO PRT-UM,
091100                                       WS-A-TC30-UM
091200             ELSE
091300                 MOVE 1 TO ERR-FLAG
091400                 MOVE "CONVERSION FACTOR FOR THIS CODE IS ZERO - P
091500-                    "LEASE CORRECT" TO ERR-LINE
091600          ELSE
091700              MOVE 1 TO ERR-FLAG
091800              MOVE "NO CONVERSION FACTOR IN CSIS FOR THIS CODE - P
091900-                 "LEASE CORRECT" TO ERR-LINE.
092000
092100**************************************************
092200**   IF USAGE UNITS AND DOLLARS ARE NEGATIVE THEN
092300**   SEND ZEROS
092400**************************************************
092500     IF USAGE-UNITS < 0 AND ROUNDED-USAGE-DOLLARS < 0
092600         MOVE ZEROS               TO USAGE-UNITS,
092700                                     ROUNDED-USAGE-DOLLARS.
092800
092900     MOVE USAGE-UNITS             TO PRT-USAGE-UNITS.
093000     MOVE ROUNDED-USAGE-DOLLARS   TO PRT-USAGE-DLRS.
093100
093200     IF SORT-CONS-IND NOT = SPACES
093300         MOVE ZEROS               TO SORT-END-UNITS,
093400                                     ROUNDED-END-DOLLARS
093500         MOVE "** CONSIGNMENT CODE **" TO PRT-CONS-IND-LIT
093600     ELSE
093700         MOVE SPACES              TO PRT-CONS-IND-LIT.
093800
093900     MOVE SORT-END-UNITS          TO PRT-END-UNITS.
094000     MOVE ROUNDED-END-DOLLARS     TO PRT-END-DLRS.
