148200                           STATUS-AREA,
148300                           DUMMY-VIEW-AREA,
148400                           FILE-STATUS,
148500                           BU-DISPLAY-MSG,
148600                           BU-DISPLAY-FLDS.
148700
148800
148900
149000 1000-CLOSE-FILES.
149100     CLOSE ONLINE-PRT, AKRON-FILE, AKRON-TEMP-FILE.

      **************************************************************
      * 23APR90 - REPLACED THE FOLLOWING LOGIC IN ORDER TO INVOKE
      *           A MACHINE DEPENDENT ROUTINE
      **************************************************************
149200*    IF TOT-ERRS > 0
149300*        MOVE "PURGE AKRNRAW2" TO COMMAND
149400*        PERFORM 1010-CALL-INTRINSIC.
      **************************************************************

           IF TOT-ERRS > 0
               DISPLAY "TOT-ERRS IS GREATER THAN ZERO,"
               DISPLAY "FILE AKRNRAW2 WILL BE DELETED/PURGED."
               PERFORM 9999-DELETE-FILE.

           PERFORM 9999-CLOSE-STUFF.
151300
      **************************************************************
      * 23APR90 - REPLACED THE FOLLOWING LOGIC WITH THE MACHINE
      *           DEPENDENT ROUTINE 9999-DELETE-FILE FOUND IN THE
      *           COPYLIB MEMBER WLIFORP2.
      **************************************************************
151400*1010-CALL-INTRINSIC.
151500*    CALL INTRINSIC "COMMAND" USING COMMAND-IMAGE,
151600*            COMMAND-ERROR, COMMAND-PARM.
151700*    IF COMMAND-ERROR NOT = 0
151800*        MOVE "COMMAND INTRINSIC FAILED" TO BU-DISPLAY-MSG
151900*        MOVE COMMAND-ERROR TO BU-DISPLAY-FLD9 (1)
152000*        MOVE COMMAND-PARM TO BU-DISPLAY-FLD (1)
152100*        PERFORM 990-BLOWUP.
      **************************************************************

       9999-ROUTINES SECTION.

       9930-LOCK.

       9940-UNLOCK.

       9999-DBGET7-MACCOUNT-INFO-IK-O.
           MOVE 0 TO COND-WORD.
           MOVE MACCT-KEY TO INFOKEY OF MACCOUNT-INFO-IK-REC-O.
           READ MACCOUNT-INFO-IK-O INTO BUF-MACCT-INFO
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS = "23"
               MOVE 17 TO COND-WORD
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD.

       9999-RESET-MACCOUNT-INFO-IK-O.
           MOVE HIGH-VALUES TO INFOKEY OF MACCOUNT-INFO-IK-REC-O.
           START MACCOUNT-INFO-IK-O KEY > INFOKEY OF
              MACCOUNT-INFO-IK-REC-O
               INVALID KEY MOVE "00" TO FILE-STATUS.

       9999-DBFIND-DTRANS-MC-I.
           MOVE 0 TO COND-WORD.
           MOVE MMATL-CODE-ARG TO MATLCODE OF DTRANS-MC-REC-I.
           START DTRANS-MC-I KEY = MATLCODE OF DTRANS-MC-REC-I
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF (FILE-STATUS NOT = "00") AND (FILE-STATUS-1 NOT = "2")
               MOVE 99 TO COND-WORD.

       9999-DBGET5-DTRANS-MC-I.
           MOVE 0 TO COND-WORD.
           READ DTRANS-MC-I NEXT INTO BUF-DTRANS
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   MOVE 15 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD
           ELSE
           IF MATLCODE OF DTRANS-MC-REC-I NOT = MMATL-CODE-ARG
               MOVE 15 TO COND-WORD.

       9999-DBGET2-MMATL-ACCUM-MC-I.
           MOVE 0 TO COND-WORD.
           READ MMATL-ACCUM-MC-I NEXT INTO BUF-MATLACUM
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS-1 = "1" OR FILE-STATUS = "46"
               MOVE 11 TO COND-WORD
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD.

       9999-INIT-MMATL-ACCUM-MC-I.
           MOVE SPACES TO MATLCODE OF MMATL-ACCUM-MC-REC-I.
           START MMATL-ACCUM-MC-I KEY >= MATLCODE OF
             MMATL-ACCUM-MC-REC-I
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.

       9999-DBGET7-MSTORERM-CD-I.
           MOVE 0 TO COND-WORD.
           MOVE MMATL-CODE-ARG TO CORPCDE OF MSTORERM-CD-REC-I.
           READ MSTORERM-CD-I INTO BUF-MSTORERM
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS = "23"
               MOVE 17 TO COND-WORD
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD.

       9999-DBGET7-MCLASS-CL-I.
           MOVE 0 TO COND-WORD.
           MOVE CLASS-ARG TO ACTGCLASS OF MCLASS-CL-REC-I.
           READ MCLASS-CL-I INTO BUF-MCLASS
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS = "23"
               MOVE 17 TO COND-WORD
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD.

       9999-DBFIND-DPORECD-PO-I.
           MOVE 0 TO COND-WORD.
           MOVE BUILD-PO-NUM TO PORCVNO OF DPORECD-PO-REC-I.
           START DPORECD-PO-I KEY = PORCVNO OF DPORECD-PO-REC-I
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF (FILE-STATUS NOT = "00") AND (FILE-STATUS-1 NOT = "2")
               MOVE 99 TO COND-WORD.

       9999-DBGET5-DPORECD-PO-I.
           MOVE 0 TO COND-WORD.
           READ DPORECD-PO-I NEXT INTO BUF-DPORECD
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   MOVE 15 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD
           ELSE
           IF PORCVNO OF DPORECD-PO-REC-I NOT = BUILD-PO-NUM
               MOVE 15 TO COND-WORD.

       9999-DBFIND-DRCVITEM-PO-I.
           MOVE 0 TO COND-WORD.
           MOVE BUILD-PO-NUM TO PORCVNO OF DRCVITEM-PO-REC-I.
           START DRCVITEM-PO-I KEY = PORCVNO OF DRCVITEM-PO-REC-I
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF (FILE-STATUS NOT = "00") AND (FILE-STATUS-1 NOT = "2")
               MOVE 99 TO COND-WORD.

       9999-DBGET5-DRCVITEM-PO-I.
           MOVE 0 TO COND-WORD.
           READ DRCVITEM-PO-I NEXT INTO BUF-DRCVITEM
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   MOVE 15 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD
           ELSE
           IF PORCVNO OF DRCVITEM-PO-REC-I NOT = BUILD-PO-NUM
               MOVE 15 TO COND-WORD.

       9999-DBUPDATE-MACCOUNT-INFO-O.
           MOVE 0 TO COND-WORD.
           REWRITE MACCOUNT-INFO-IK-REC-O FROM BUF-MACCT-INFO
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD.

       9999-OPEN-STUFF.
           OPEN I-O   MACCOUNT-INFO-IK-O   .
           OPEN INPUT DTRANS-MC-I          .
           OPEN INPUT MMATL-ACCUM-MC-I     .
           OPEN INPUT MSTORERM-CD-I        .
           OPEN INPUT MCLASS-CL-I          .
           OPEN INPUT DPORECD-PO-I         .
           OPEN INPUT DRCVITEM-PO-I        .

       9999-CLOSE-STUFF.
           CLOSE      MACCOUNT-INFO-IK-O   .
           CLOSE      DTRANS-MC-I          .
           CLOSE      MMATL-ACCUM-MC-I     .
           CLOSE      MSTORERM-CD-I        .
           CLOSE      MCLASS-CL-I          .
           CLOSE      DPORECD-PO-I         .
           CLOSE      DRCVITEM-PO-I        .

       9999-CREATE-AKRNTEMP-FILE.
      *----- CALL CCRTFILE TO CREATE A TEMPORARY FILE
      *----- LIBRARY 'QTEMP' IS USED FOR TEMPORARY FILES
           MOVE SPACES     TO CCRTFILE-PARMS.
           MOVE "QTEMP"    TO CCRTFILE-LIBRARY.
           MOVE "AKRNTEMP" TO CCRTFILE-FILE.
           MOVE "0080"     TO CCRTFILE-RECORD-LENGTH.
           MOVE "01000"    TO CCRTFILE-NO-RECORDS.
           MOVE "01000"    TO CCRTFILE-INCREMENT-AMT.
           MOVE "99"       TO CCRTFILE-NO-INCREMENTS.
           CALL "CCRTFILE" USING CCRTFILE-LIBRARY,
                                 CCRTFILE-FILE,
                                 CCRTFILE-RECORD-LENGTH,
                                 CCRTFILE-NO-RECORDS,
                                 CCRTFILE-INCREMENT-AMT,
                                 CCRTFILE-NO-INCREMENTS,
                                 CCRTFILE-STATUS.
           IF CCRTFILE-STATUS NOT = "00"
               MOVE "CCRTFILE CREATE OF AKRNTEMP FAILED"
                 TO BU-DISPLAY-MSG
               PERFORM 990-BLOWUP.

       9999-DELETE-FILE.
      *----- MACHINE DEPENDENT LOGIC USED TO DELETE/PURGE FILE
      *----- AKRNRAW2 IF ERRORS ARE FOUND IN THE DATA
           MOVE "AKRNRAW2  " TO MCDLT-FILENAME.
           CALL "MCDLT" USING MCDLT-FILENAME.

