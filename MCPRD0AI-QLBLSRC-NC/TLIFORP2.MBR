000200 IDENTIFICATION DIVISION.
000300 PROGRAM-ID.      TLIFORP2.
000400 AUTHOR.          D A PLUM.
000500 DATE-WRITTEN.    DECEMBER 1989.
000600*INSTALLATION.    GOODYEAR TIRE AND RUBBER CO.
000700
000800*REMARKS.         THIS PROGRAM WAS DEVELOPED TO REPLACE TLIFORPT
000900*                 TO MEET NEW AKRON LIFO REPORTING REQUIREMENTS.
001000*                 THIS CODE WAS COPIED FROM TLIFORPT AND MODIFIED
001100*                 TO FUFILL THESE REQUIREMENTS.
001200*
001300*                 THIS PROGRAM WILL READ THROUGH THE
001400*                 MATERIAL ACCUM DATA SET AND CREATE
001500*                 A REPORT SHOWING THE MOVEMENT OF EACH
001600*                 RAW MATERIAL CODE
001700*                 (CLASSES 100-199 AND 400-499)
001800*                 AND A SUMMARY FOR ALL OTHER STORESS
001900*                 CLASSES.
      *C
      *C   28FEB1994    DAVE PLUM
      *C     ADDED CALL TO THE COBOL ERROR HANDLER - MCXCBLERR.
      *C
      *C   06DEC1994    DAVE PLUM
      *C     EXPANDED THE SIZE OF FIELD MCDLT-FILENAME FROM 8 TO
      *C     10 BYTES TO MATCH THE LENGTH OF PARAMETER EXPECTED BY
      *C     THE CL PROGRAM MCDLT.
      *C
      *C   05SEP1996    DAVE PLUM
      *C     RECOMPILED FOR CENTURY DATABASE CHANGES.
      *C     NOTE: THE AKRON-FILE AND AKRON-TEMP-FILE WERE NOT
      *C           REVISED TO PASS 8 CHARACTER DATES.  ULTIMATELY
      *C           THE AKRON-FILE IS SENT TO AKRON VIA RJE, AND THE
      *C           DEFINITION OF THIS FILE IS DETERMINED BY TOM
      *C           GEORGE'S SECTION.  THESE "AKRON" FILES SHOULD ONLY
      *C           BE REVISED BASED ON A REQUEST COMING FROM AKRON.
      *C
      *C   06JAN1999    JIM COFFMAN
      *C     ADDED A CHANGE FOR SPARTANBURG WHERE THEY HAVE A CLASS
      *C     190 ITEM FOR VINYL FILM AND IT'S UNIT OF MEASURE IS 'RL'
      *C     INSTEAD OF 'EA' OR 'LB'.
      *C
002100 ENVIRONMENT DIVISION.
002200 CONFIGURATION SECTION.
002300 SOURCE-COMPUTER.      HP-3000.
002400 OBJECT-COMPUTER.      HP-3000.
       COPY SPECIALN IN COPYLIB.
002600
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT MACCOUNT-INFO-IK-O
               ASSIGN TO DATABASE-MCFLCA0101
               ORGANIZATION IS INDEXED
                 ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
               FILE STATUS IS FILE-STATUS.

           SELECT DTRANS-MC-I
               ASSIGN TO DATABASE-MCFLCA0701
               ORGANIZATION IS INDEXED
                 ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                 WITH DUPLICATES
               FILE STATUS IS FILE-STATUS.

           SELECT MMATL-ACCUM-MC-I
               ASSIGN TO DATABASE-MCFLCA0601
               ORGANIZATION IS INDEXED
                 ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
               FILE STATUS IS FILE-STATUS.

           SELECT MSTORERM-CD-I
               ASSIGN TO DATABASE-MCFLCS0201
               ORGANIZATION IS INDEXED
                 ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
               FILE STATUS IS FILE-STATUS.

           SELECT MCLASS-CL-I
               ASSIGN TO DATABASE-MCFLCS4901
               ORGANIZATION IS INDEXED
                 ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
               FILE STATUS IS FILE-STATUS.

           SELECT DPORECD-PO-I
               ASSIGN TO DATABASE-MCFLCS0901
               ORGANIZATION IS INDEXED
                 ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                 WITH DUPLICATES
               FILE STATUS IS FILE-STATUS.

           SELECT DRCVITEM-PO-I
               ASSIGN TO DATABASE-MCFLCS1201
               ORGANIZATION IS INDEXED
                 ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                 WITH DUPLICATES
               FILE STATUS IS FILE-STATUS.

           SELECT ONLINE-PRT ASSIGN TO PRINTER-MCPRT.

           SELECT SORT-FILE ASSIGN TO DISK-SORT.

           SELECT AKRON-FILE ASSIGN TO DISK-AKRNRAW2.

           SELECT AKRON-TEMP-FILE ASSIGN TO DISK-AKRNTEMP.
