000200 IDENTIFICATION DIVISION.
000300 PROGRAM-ID.
000400      TDCOMMENT.
000500 AUTHOR.
000600      KURT MOVSESIAN.
000800
000900******************************************************
001000*                                                    *
001100*   T D C O M M E N T                                *
001200*                                                    *
001300*   THIS PROGRAM WILL CHECK FOR COMMENTS WITH THE    *
001400*   ESCAPE SEQ. IN THE COMMENT AND CONVERT THEM TO   *
001500*   NEW LITERAL VALUES USED.  THE FOLLOWING WILL     *
      *   CONVERT TO                                       *
      *      REG. -  'ESC&K0S' CHANGE TO '     '           *
      *      EXP. -  'ESC&K1S' CHANGE TO '*EXP*'           *
      *      CMP. -  'ESC&K2S' CHANGE TO '*CMP*'           *
001600******************************************************
001700
002300
002400 ENVIRONMENT DIVISION.
002500 CONFIGURATION SECTION.
002600 SOURCE-COMPUTER.  HP-3000.
002700 OBJECT-COMPUTER.  HP-3000.
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.

           SELECT DCOMMENT-O
                  ASSIGN TO DATABASE-MCFLCS1901
                  ORGANIZATION IS INDEXED
                    ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                     WITH DUPLICATES
                  FILE STATUS IS FILE-STATUS.
002800
003000
003100 DATA DIVISION.
003200 FILE SECTION.
       FD  DCOMMENT-O
           LABEL RECORDS ARE STANDARD.
       01  DCOMMENT-REC-O.
           COPY DDS-ALL-FORMATS OF MCFLCS1901.
003300
003400
003500 WORKING-STORAGE SECTION.
       01  FILE-STATUS.
           05  FILE-STATUS-1            PIC X  VALUE "0".
           05  FILE-STATUS-2            PIC X  VALUE "0".
003600
       01  ERROR-RECORD-CTR             PIC 9(8) COMP-4 VALUE ZEROS.
       01  ESCAPE-SEQ-FOUND-SW          PIC X  VALUE SPACES.

       01  ESCAPE-CHECK-LIT.
           05  ESCAPE-SEQ-1             PIC X(1) VALUE SPACES.
           05  ESCAPE-SEQ-2-5           PIC X(4) VALUE SPACES.

003700**************************************************************
003800**************************************************************
003900**                                                          **
004000**                DATABASE I/O BUFFER AREA                  **
004100**                                                          **
004200**************************************************************
004300**************************************************************
004400
004500 COPY DCOMMENT IN COPYLIB.
007100
       COPY DBSTAT IN COPYLIB.

       01  BASE   PIC X(10) VALUE SPACES.
007400
007500 COPY TBLOWUP IN COPYLIB.
007600
007700 COPY VIEWDUM IN COPYLIB.
007800
008400
008500 PROCEDURE DIVISION.
008600
008700
008800
       BEGIN-HERE.
           OPEN I-O DCOMMENT-O

008900     PERFORM 6-MAIN  THRU  6-M-X.

009000     CLOSE DCOMMENT-O.
009100     GOBACK.
009200
009300
009400*******************************************************
009500**                                                   **
009600**   BLOWUP  ROUTINE                                 **
009700**                                                   **
009800*******************************************************
009900
010000 2-BLOWUP.
010100     MOVE "TDCOMMENT"      TO  BU-PGM-NAME.
010200     MOVE MCOMCOMMNT OF DCOMMENT-REC-O TO BU-DISPLAY-FLD (1).
010400     CALL "TBLOWUP" USING BASE, BU-PGM-NAME, STATUS-AREA,
010500         VIEW-COMAREA, FILE-STATUS, BU-DISPLAY-MSG,
010600             BU-DISPLAY-FLDS.
010700
010800 6-MAIN.
010900     READ DCOMMENT-O FIRST RECORD INTO BUF-DCOMMENT
               AT END GO TO 6-M-X.
           IF FILE-STATUS NOT = "00"
               MOVE "READ FIRST DCOMMENT *6-MAIN" TO BU-DISPLAY-MSG
               GO TO 2-BLOWUP.

011000     PERFORM 61-READ-FILE THRU 61-RF-X.

           DISPLAY "TOTAL NO. OF COMMENT LINES CONVERTED  = ".
           DISPLAY ERROR-RECORD-CTR.

011100
011200 6-M-X.
011300     EXIT.
011400
011500 61-READ-FILE.
           MOVE SPACES  TO ESCAPE-SEQ-FOUND-SW.
           MOVE EXP-PRT-START  TO ESCAPE-CHECK-LIT.
           IF ESCAPE-SEQ-2-5 = "&k1S"
               MOVE "Y" TO ESCAPE-SEQ-FOUND-SW
               MOVE "*EXP*"    TO EXP-PRT-START
               MOVE SPACES     TO EXP-PRT-STOP
           ELSE
           IF ESCAPE-SEQ-2-5 = "&k2S"
               MOVE "Y" TO ESCAPE-SEQ-FOUND-SW
               MOVE "*CMP*"    TO COMP-PRT-START
               MOVE SPACES     TO COMP-PRT-STOP.

           IF ESCAPE-SEQ-FOUND-SW = "Y"
               ADD 1 TO ERROR-RECORD-CTR
               REWRITE DCOMMENT-REC-O FROM BUF-DCOMMENT
               IF FILE-STATUS NOT = "00"
                   MOVE "REWRITE DCOMMENT 61-RF" TO BU-DISPLAY-MSG
                   GO TO 2-BLOWUP.

           READ DCOMMENT-O NEXT RECORD INTO BUF-DCOMMENT
               AT END GO TO 61-RF-X.
           IF FILE-STATUS NOT = "00"
               MOVE "READ NEXT DCOMMNET *61-RF" TO BU-DISPLAY-MSG
               GO TO 2-BLOWUP.

           GO TO 61-READ-FILE.

       61-RF-X.
           EXIT.

