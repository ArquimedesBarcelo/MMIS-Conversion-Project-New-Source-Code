       01  SCREEN-BUFFER                 PIC X(2000).

       01  RETURN-SCREEN.
           05  DE-CODE.
               10  DE-END                PIC XXX.
               10  FILLER                PIC X(4).
           05  CODE-PROMPT               PIC X(45).
           05  V-CODE                    PIC X(7).
           05  V-KWRD-ADJ                PIC X(46).
           05  UM                        PIC XX.
           05  DESC                      PIC X(70).
           05  DE-DOCUMENT               PIC X(10).
           05  DE-VALUE                  PIC X(15).
           05  DE-VALUE-9 REDEFINES DE-VALUE  PIC S9(11)V9(4).
           05  DE-DEPT                   PIC X(4).
           05  DE-EXP-CLASS              PIC X(6).
           05  DE-BOX                    PIC X(1).
           05  DATA-ENTRY-AREA.
               10  DATA-ENTRY-LINE  OCCURS 6 TIMES.
                   15  DE-FRAN           PIC X(4).
                   15  LOC               PIC X(12).
                   15  DE-QTY-X.
                       20  DE-QTY        PIC S9(8).
           05  DE-COMMENT                PIC X(57).
           05  V-DISB-INSTR              PIC X(30).
           05  DE-COMMAND-LINE           PIC X(79).
           05  DE-MESSAGE-LINE           PIC X(79).

       LINKAGE SECTION.
       01  BASE                          PIC X(10).
       COPY VCOMLINK IN COPYLIB.
       COPY LANGSUB  IN COPYLIB.
       COPY ESCSUB   IN COPYLIB.
       COPY MULTSTR  IN COPYLIB.

       01  COMPANY-CODE                  PIC X(3).

      *--- 07MAY1996 ADDED COMPANY-CODE TO THW SET OF PARAMETERS
      *---  BEING PASSED TO THIS PROGRAM.   ---DAVE PLUM
       PROCEDURE DIVISION USING BASE, VIEW-COMAREA,
           LANGUAGE-PARMS, ESC-NAME, MULTIPLE-STR-DATA,
           COMPANY-CODE.
       1-HOUSEKEEP SECTION.
       1-HOUSEKEEPER.
           MOVE 1                        TO  SAVE-PARA-NUMBER.
           MOVE ZERO                     TO  DE-EXP-CLASS.

           MOVE 0 TO SUB, LOC-COUNT, TOTAL-QTY, D-E,
             LINE-ADV, SAVE-ONHAND-BEFORE, SAVE-RSRVD-BEFORE.
           MOVE "N"                      TO  ADD-LOC-SW, PRT-CODE-FLAG.
           MOVE "Y"                      TO  FIRST-TIME-FLAG.

           OPEN INPUT MVALIDPLTDATA, MSTORERM-I MPLTINFO.
           OPEN I-O DDAILYTC, MSTORERM-O.

      *-----5/12/97 JSB, GET VALID FRANCHISERS
           MOVE 0 TO COND-WORD.
           MOVE "FRAN" TO PLTINFOKEY OF MPLTINFO-REC.
           READ MPLTINFO INTO BUF-MPLTINFO
               INVALID KEY MOVE 17 TO COND-WORD.
           IF FILE-STATUS-1 = "2"
               MOVE 17 TO COND-WORD
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD.
           IF COND-WORD NOT = 0
               MOVE SPACES               TO   FRAN-TABLE
           ELSE
           MOVE MPLTINFO-FRANCHISES      TO   FRAN-TABLE.

      *---------- INITIALIZE SUBPROGRAM CALL FIELDS
           MOVE "SRETWVLS"               TO  BU-PGM-NAME.
           MOVE 2                        TO  SRF-MODE.
           MOVE LANG-ERCAT-GNAME2        TO  FORM-GNAME2,
                                              FORM-GNAME2-A.
           PERFORM 6-MAIN              THRU 6-MAIN-X.

           CLOSE DDAILYTC, MSTORERM-I, MSTORERM-O, MVALIDPLTDATA,
                 MPLTINFO.

           GOBACK.

       2-BLOWUP.
           MOVE SAVE-PARA-NUMBER         TO  BU-DISPLAY-PARA.
           MOVE CODE-ARG                 TO  BU-DISPLAY-FLD (1).
           MOVE SRF-RET-CODE             TO  BU-DISPLAY-FLD9 (1).
           CALL "TBLOWUP" USING BASE BU-PGM-NAME
             STATUS-AREA VIEW-COMAREA FILE-STATUS
             BU-DISPLAY-MSG BU-DISPLAY-FLDS.

       4-SET-ERROR.
      *---------- "VFIELDEDITS" IS CALLED WHEN A USER ERROR IS DETECTED
      *---------- TO LEFT-SHIFT NUMERIC FIELDS FOR USER CONVENINECE
      *    CALL "VFIELDEDITS" USING VIEW-COMAREA.
      *     IF VIEW-STATUS NOT = 0
      *         MOVE "VFIELDEDITS ERR 4-SF" TO BU-DISPLAY-MSG
      *         PERFORM 2-BLOWUP.
      *
      *    CALL "VSETERROR" USING VIEW-COMAREA FIELD-NUMBER
      *       MESSAGE-BUFFER MSG-BUFFLEN.
      *    IF VIEW-STATUS NOT = 0
      *        MOVE "VSETERROR ERR 4-WE" TO BU-DISPLAY-MSG
      *        PERFORM 2-BLOWUP.
      *
           MOVE "Y"                      TO  SRF-ERROR-SW.
           MOVE B"1"                     TO  IND (FIELD-NUMBER).
           MOVE MESSAGE-BUFFER           TO  DE-MESSAGE-LINE.

       4-SIZE-ERROR.
      *    "Q20: QUANTITY OVERFLOW - CANNOT PROCESS"
           MOVE  17                      TO  LANG-SETNUM.
           MOVE  20                      TO  LANG-MSGNUM.
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
           COMPUTE FIELD-NUMBER = (2 * SUB) + 10.
           PERFORM 4-SET-ERROR.
           PERFORM 67-UNLOCK-MSTORERM.

       4-SHOW-FORM.
      *    CALL "VSHOWFORM" USING VIEW-COMAREA.
      *    IF VIEW-STATUS NOT = 0
      *        MOVE "VSHOWFORM ERR 64-CS" TO BU-DISPLAY-MSG
      *        PERFORM 2-BLOWUP.
      *
       4-CLEAR-FORM.
           MOVE SPACES                   TO  MESSAGE-BUFFER.
      *    CALL "VPUTWINDOW" USING VIEW-COMAREA MESSAGE-BUFFER
      *      MSG-ACTUALEN.
      *    IF VIEW-STATUS NOT = 0
      *        MOVE "VPUTWINDOW ERR 4-CF " TO BU-DISPLAY-MSG
      *        PERFORM 2-BLOWUP.
      *
           MOVE SPACES TO DE-CODE, V-CODE, V-KWRD-ADJ, UM, DESC,
             DE-DOCUMENT, DE-BOX, DATA-ENTRY-AREA,
             DE-COMMENT, V-DISB-INSTR.
           MOVE ZERO                     TO  DE-VALUE-9.
      *    "K9: KEY STORES CODE AND PRESS 'ENTER'"
           MOVE  11                      TO  LANG-SETNUM.
           MOVE   9                      TO  LANG-MSGNUM.
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
           MOVE MESSAGE-BUFFER           TO  CODE-PROMPT.

      *    CALL "VPUTBUFFER" USING VIEW-COMAREA RETURN-SCREEN
      *      VIEW-DBUFLEN.
      *    IF VIEW-STATUS NOT = 0
      *        MOVE "VPUTBUFFER ERR 4-CF" TO BU-DISPLAY-MSG
      *        PERFORM 2-BLOWUP.
      *
       4-PUTBUFFER.
      *    CALL "VPUTBUFFER" USING VIEW-COMAREA, RETURN-SCREEN,
      *      VIEW-DBUFLEN.
      *    IF VIEW-STATUS NOT = 0
      *        MOVE "VPUTBUFFER ERR 4-P" TO BU-DISPLAY-MSG
      *        PERFORM 2-BLOWUP.
      *
       4-GETBUFFER.
      *    CALL "VGETBUFFER" USING VIEW-COMAREA, RETURN-SCREEN,
      *      VIEW-DBUFLEN.
      *    IF VIEW-STATUS NOT = 0
      *        MOVE "VGETBUFFER ERR 4-G" TO BU-DISPLAY-MSG
      *        PERFORM 2-BLOWUP.
      *
       6-MAIN.
           MOVE 3                        TO  SAVE-PARA-NUMBER.
      *---------- GET THE FATHER FORM.
           MOVE "FRETWVAL1"              TO  VIEW-NFNAME.
      *    CALL "VGETNEXTFORM" USING VIEW-COMAREA.
      *    IF VIEW-STATUS NOT = 0
      *        MOVE "VGETNEXTFORM FATH 6-M" TO BU-DISPLAY-MSG
      *        PERFORM 2-BLOWUP.
      *
       601-GET-SON-FORM.
           MOVE 4                        TO  SAVE-PARA-NUMBER.
           MOVE "FRETWVAL2"              TO  VIEW-NFNAME.
      *    CALL "VGETNEXTFORM" USING VIEW-COMAREA.
      *    IF VIEW-STATUS NOT = 0
      *        MOVE "VGETNEXTFORM ERR SON 601-GSF" TO BU-DISPLAY-MSG
      *        PERFORM 2-BLOWUP.
      *
           PERFORM 4-CLEAR-FORM.
           MOVE ZERO                     TO  SUB.
           PERFORM 6 TIMES
               ADD 1                     TO  SUB
               MOVE ZERO                 TO  DE-QTY (SUB)
           END-PERFORM.

       61-SHOWFORM-1.
           MOVE 5                        TO  SAVE-PARA-NUMBER.
           MOVE 6                        TO  SRF-KEYSET.
           MOVE "I"                      TO  SRF-FKEY (2).
           MOVE RETURN-SCREEN            TO  SCREEN-BUFFER.
           MOVE "ZUDCSTR"                TO  VIEW-CFNAME.
           CALL "TSHWRDFM" USING SRF-COMAREA, BU-DISPLAY-MSG,
             VIEW-COMAREA, BASE, STATUS-AREA,
             SRF-SPOOLER-REC, LANGUAGE-PARMS, SCREEN-BUFFER.
           MOVE SCREEN-BUFFER            TO  RETURN-SCREEN.
           IF SRF-RET-CODE NOT = 0
               PERFORM 2-BLOWUP.

           IF VIEW-LASTKEY = 1
               PERFORM 4-GETBUFFER
               PERFORM 699-MATERIAL-STATUS
               MOVE "FRETWVAL2"          TO  VIEW-NFNAME
      *        CALL "VGETNEXTFORM" USING VIEW-COMAREA
      *        PERFORM 4-PUTBUFFER
               GO TO 61-SHOWFORM-1.

           IF VIEW-LASTKEY = 7
               PERFORM 4-CLEAR-FORM
               GO TO 61-SHOWFORM-1.
           IF VIEW-LASTKEY = 8
               GO TO 6-MAIN-X.

           PERFORM 4-GETBUFFER.

           MOVE DE-CODE                  TO  CODE-ARG.
      *    CALL "DBGET" USING BASE, DSET-MSTORERM, MODE7, STATUS-AREA,
      *            ALL-ITEMS, BUF-MSTORERM, CODE-ARG.
           MOVE 0                        TO  COND-WORD.
           MOVE CODE-ARG                 TO  CORPCDE OF MSTORERM-I-REC.
           READ MSTORERM-I INTO BUF-MSTORERM
               INVALID KEY MOVE 17       TO  COND-WORD.
           IF FILE-STATUS-1 = "2"
               MOVE 17                   TO  COND-WORD
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE 99                   TO  COND-WORD.
           IF COND-WORD NOT = 0
             IF COND-WORD = 17
                MOVE 1                   TO  FIELD-NUMBER
      *         "S9: STORES CODE DOES NOT EXIST"
                MOVE  19                 TO  LANG-SETNUM
                MOVE   9                 TO  LANG-MSGNUM
                PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                MOVE DE-CODE             TO  MSG-FLD
                PERFORM 4-SET-ERROR
                GO TO 61-SHOWFORM-1
             ELSE
                MOVE "DBGET ERR 61-RF"   TO  BU-DISPLAY-MSG
                PERFORM 2-BLOWUP.

      *----- 07MAY1996 COMPANY-CODE WAS ADDED TO THE SET OF PARAMETERS
      *-----  BEING PASSED TO SUBROUTINE CISITRAW.

           IF MULTSTR-ALLOW-RETURN-VALUE = "N"
               CALL "CISITRAW" USING CIR-PARMS, BUF-MSTORERM,
                   COMPANY-CODE
               IF CISITRAW-RET-CODE = "Y"
      *            "Y29: YOU CANNOT RETURN WITH VALUE ON A RAW MAT."
                   MOVE 25               TO  LANG-SETNUM
                   MOVE 29               TO  LANG-MSGNUM
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE DE-CODE          TO  MSG-FLD
                   PERFORM 4-SET-ERROR
                   GO TO 61-SHOWFORM-1.

           IF STR-STATE = "F"
               MOVE 1                    TO  FIELD-NUMBER
      *        "C8: CODE FROZEN FOR INVENTORY - NO PROCESSING ALLOWED"
               MOVE   3                  TO  LANG-SETNUM
               MOVE   8                  TO  LANG-MSGNUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                MOVE DE-CODE             TO  MSG-FLD
                PERFORM 4-SET-ERROR
                GO TO 61-SHOWFORM-1.

      *********************************************************
      *
      *     FIND AND GET THE DESCRIPTION FOR THIS CORP CODE.
      *
      *********************************************************

           MOVE 2                        TO  CDESC-LINES-TO-GET.
           MOVE "N"                      TO  CDESC-LOCAL-DESC-OPTION.
           CALL "CDESC" USING CDESC-RET-CODE, BASE, STATUS-AREA,
             BU-DISPLAY-MSG, CODE-ARG, CDESC-DATA.
           IF BU-DISPLAY-MSG-1 NOT = SPACES
               PERFORM 2-BLOWUP.

           MOVE CDESC (1)                TO  V-KWRD-ADJ.
           MOVE CDESC (2)                TO  DESC.

      *********************************************************
      *
      * WRITE THE SCREEN WITH THE DESCRIPTION, UM AND LOCATIONS.
      *
      *********************************************************


      *    "K10: KEY TRANSACTION DATA THEN PRESS 'ENTER'"
           MOVE  11                      TO  LANG-SETNUM.
           MOVE  10                      TO  LANG-MSGNUM.
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
           MOVE MESSAGE-BUFFER           TO  CODE-PROMPT.
           MOVE CODE-ARG                 TO  V-CODE.
           MOVE STR-UM                   TO  UM.
           MOVE STR-LOC (1)              TO  LOC(1).
           MOVE STR-LOC (2)              TO  LOC(2).
           MOVE STR-LOC (3)              TO  LOC(3).
           MOVE STR-LOC (4)              TO  LOC(4).
           MOVE STR-LOC (5)              TO  LOC(5).
           MOVE STR-LOC (6)              TO  LOC(6).
           MOVE 1 TO SUB.
           PERFORM 900-GET-FRAN-NAME THRU 900-GET-FRAN-NAME-X.
           MOVE 2 TO SUB.
           PERFORM 900-GET-FRAN-NAME THRU 900-GET-FRAN-NAME-X.
           MOVE 3 TO SUB.
           PERFORM 900-GET-FRAN-NAME THRU 900-GET-FRAN-NAME-X.
           MOVE 4 TO SUB.
           PERFORM 900-GET-FRAN-NAME THRU 900-GET-FRAN-NAME-X.
           MOVE 5 TO SUB.
           PERFORM 900-GET-FRAN-NAME THRU 900-GET-FRAN-NAME-X.
           MOVE 6 TO SUB.
           PERFORM 900-GET-FRAN-NAME THRU 900-GET-FRAN-NAME-X.
           MOVE STR-DISB-INSTR           TO  V-DISB-INSTR.
           MOVE ZERO TO DE-VALUE-9, DE-QTY (1), DE-QTY (2),
             DE-QTY (3), DE-QTY (4), DE-QTY (5), DE-QTY (6).

           MOVE SPACES                   TO  MESSAGE-BUFFER.

      *---------- GET THE NEXT SON FORM (WITH DATA ENTRY FIELDS CHANGED
      *---------- FROM DISPLAY ONLY TO OPTIONAL, AND CORP CODE FIELD
      *---------- CHANGED FROM OPTIONAL TO DISPLAY ONLY), AND PUT THE
      *---------- CORP-CODE DATA INTO THE SCREEN.

           MOVE "FRETWVAL3"              TO  VIEW-NFNAME.
      *    CALL "VGETNEXTFORM" USING VIEW-COMAREA.
      *    IF VIEW-STATUS NOT = 0
      *        MOVE "VGETNEXTFORM ERR 6300-BS" TO BU-DISPLAY-MSG
      *        PERFORM 2-BLOWUP.
      *
           PERFORM 4-PUTBUFFER.
       62-SHOWFORM-2.
           MOVE 6                        TO  SAVE-PARA-NUMBER.
      *------ FOR IBM, SOMEHOW THE NEGATIVES REMAIN IN THE SCREEN
      *------ BUFFER BUT DON'T SHOW ON SCREEN.
           MOVE 0                        TO  SUB.
           PERFORM 660-RESET-NEGATIVES 6 TIMES.

      *-----SET INDICATOR FOR FRANCHISE CODE
           IF STR-CODE-OWNER NOT = SPACES
               MOVE B"1" TO IND(95)
           ELSE
               MOVE B"0" TO IND(95).
           MOVE RETURN-SCREEN            TO  SCREEN-BUFFER.
           CALL "TSHWRDFM" USING SRF-COMAREA, BU-DISPLAY-MSG,
             VIEW-COMAREA, BASE, STATUS-AREA,
             SRF-SPOOLER-REC, LANGUAGE-PARMS, SCREEN-BUFFER.
           MOVE SCREEN-BUFFER            TO  RETURN-SCREEN.
           IF SRF-RET-CODE NOT = 0
               PERFORM 2-BLOWUP.

           IF VIEW-LASTKEY = 7
               GO TO 601-GET-SON-FORM.
           IF VIEW-LASTKEY = 8
               GO TO 6-MAIN-X.
           IF VIEW-LASTKEY = 1
               PERFORM 4-GETBUFFER
               PERFORM 699-MATERIAL-STATUS
               MOVE "FRETWVAL3"          TO  VIEW-NFNAME
      *        CALL "VGETNEXTFORM" USING VIEW-COMAREA
      *        PERFORM 4-PUTBUFFER
               GO TO 62-SHOWFORM-2.

      *    PERFORM 4-GETBUFFER.

           MOVE "DP"                     TO  VALID-ARG-1-2.
           MOVE DE-DEPT                  TO  VALID-ARG-3-10.
      *    CALL "DBGET" USING BASE, DSET-MVALIDPLTDATA, MODE7,
      *      STATUS-AREA, ALL-ITEMS, BUF-MVALIDPLTDATA,
      *      VALID-ARG.
           PERFORM 650-GET-MVALID.
           IF NO-ENTRY
      *        "D12: DEPARTMENT CODE DOES NOT EXIST"
               MOVE   4                  TO  LANG-SETNUM
               MOVE  12                  TO  LANG-MSGNUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE DE-DEPT              TO  MSG-FLD
               MOVE 27                   TO  FIELD-NUMBER
               PERFORM 4-SET-ERROR
               GO TO 62-SHOWFORM-2.

      *------ ADDED EXP CLASS TO SCREEN 20 SEP 88, IF THEY ENTER
      *------ SOMETHING, I EDIT, IF NOT I LET IT GO.
           IF DE-EXP-CLASS > SPACES AND DE-EXP-CLASS NOT = "000000"
             MOVE "EC"                   TO  VALID-ARG-1-2
             MOVE DE-EXP-CLASS           TO  VALID-ARG-3-10
      *      CALL "DBGET" USING BASE, DSET-MVALIDPLTDATA, MODE7,
      *        STATUS-AREA, ALL-ITEMS, BUF-MVALIDPLTDATA,
      *        VALID-ARG
             PERFORM 650-GET-MVALID
             IF NO-ENTRY
               MOVE "NW"                 TO  VALID-ARG-1-2
      *        CALL "DBGET" USING BASE, DSET-MVALIDPLTDATA, MODE7,
      *          STATUS-AREA, ALL-ITEMS, BUF-MVALIDPLTDATA,
      *          VALID-ARG
               PERFORM 650-GET-MVALID
               IF NO-ENTRY
      *            "INVALID ACCOUNT"
                   MOVE   9              TO  LANG-SETNUM
                   MOVE  71              TO  LANG-MSGNUM
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE DE-EXP-CLASS     TO  MSG-FLD
                   MOVE 28               TO  FIELD-NUMBER
                   PERFORM 4-SET-ERROR
                   GO TO 62-SHOWFORM-2.

       63-LOCK-MSTORERM.
           MOVE 7                        TO  SAVE-PARA-NUMBER.
      *---------- DATE AND TIME AT THIS INSTANT WILL BE USED FOR ALL
      *---------- ASPECTS OF THE TRANSACTION - LAST ACTIVITY DATE,
      *---------- TRANSACTION DATE & TIME, AND PRINTOUT.
           MOVE 1                        TO  DATE-MODE.
           CALL "TDATECK2" USING DATE-CHECK-AREA, LANGUAGE-PARMS.

           MOVE CODE-ARG                 TO  LOCK-VALUE.
      *    CALL "DBLOCK" USING BASE MULTI-LOCK MODE5 STATUS-AREA.
      *    IF COND-WORD NOT = 0
      *        MOVE "DBLOCK ERR MSTORE 63-LM" TO BU-DISPLAY-MSG
      *        PERFORM 2-BLOWUP.
      *
       64-GET-CODE.
           MOVE 8                        TO  SAVE-PARA-NUMBER.
      *    CALL "DBGET" USING BASE DSET-MSTORERM MODE7 STATUS-AREA
      *      ALL-ITEMS BUF-MSTORERM CODE-ARG.
           MOVE 0                        TO  COND-WORD.
           MOVE CODE-ARG                 TO  CORPCDE OF MSTORERM-O-REC.
           READ MSTORERM-O INTO BUF-MSTORERM
               INVALID KEY MOVE 17       TO  COND-WORD.
           IF FILE-STATUS-1 = "2"
               MOVE 17                   TO  COND-WORD
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE 99                   TO  COND-WORD.
           IF COND-WORD NOT = 0
               MOVE "DBGET ERR MSTORE 64-GC" TO BU-DISPLAY-MSG
               PERFORM 2-BLOWUP.

      **************************************************************
      **   MOVE ONHAND BEFORE ANY ACTIVITY TO SAVE AREA FOR USE   **
      **   OF THE REQFILE UPDATE SUBPROGRAM.                      **
      **************************************************************

           MOVE STR-ONHAND               TO  SAVE-ONHAND-BEFORE.

           MOVE 0                        TO  SUB.
           MOVE 0                        TO  TOTAL-QTY.
           MOVE 9                        TO  SAVE-PARA-NUMBER.
       65-QTY-LOOP.
           ADD 1                         TO  SUB.
           IF SUB > 6
               GO TO 66-UPDATE-MSTORERM.
           IF DE-QTY (SUB) = 0
               GO TO 65-QTY-LOOP.

           IF DE-BOX = "X"
               IF DE-QTY (SUB) > STR-LOC-ONHAND (SUB)
                   MOVE   2              TO  LANG-SETNUM
                   MOVE  13              TO  LANG-MSGNUM
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                    MOVE STR-LOC-ONHAND (SUB) TO MSG-FLD-9
                   COMPUTE FIELD-NUMBER = (2 * SUB) + 10
                   PERFORM 4-SET-ERROR
                   PERFORM 67-UNLOCK-MSTORERM
                   GO TO 62-SHOWFORM-2.

           IF LOC (SUB) = SPACES AND DE-QTY (SUB) > 0
      *        "CANNOT TRANSACT AGAINST NON-EXISTENT LOCATION"
                MOVE   3                 TO  LANG-SETNUM
                MOVE 111                 TO  LANG-MSGNUM
                PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                COMPUTE FIELD-NUMBER = (2 * SUB) + 10
                PERFORM 4-SET-ERROR
                PERFORM 67-UNLOCK-MSTORERM
                GO TO 62-SHOWFORM-2.

      *------5/12/97, RETURN TO GOODYEAR BINS ONLY
           IF DE-FRAN(SUB) NOT = SPACES AND DE-QTY(SUB) > 0
      *        "MUST RETURN TO GOODYEAR BINS ONLY"
                MOVE  13                 TO  LANG-SETNUM
                MOVE  71                 TO  LANG-MSGNUM
                PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                COMPUTE FIELD-NUMBER = (2 * SUB) + 10
                PERFORM 4-SET-ERROR
                PERFORM 67-UNLOCK-MSTORERM
                GO TO 62-SHOWFORM-2.

           IF DE-BOX = "X"
               MULTIPLY DE-QTY (SUB) BY -1 GIVING DE-QTY (SUB)
               MULTIPLY DE-VALUE-9 BY  1 GIVING DE-VALUE-9.

           ADD DE-QTY (SUB) TO STR-LOC-ONHAND (SUB) ON SIZE ERROR
               PERFORM 4-SIZE-ERROR
               GO TO 62-SHOWFORM-2.
           ADD DE-QTY (SUB)              TO  STR-ONHAND ON SIZE ERROR
               PERFORM 4-SIZE-ERROR
               GO TO 62-SHOWFORM-2.
           ADD DE-QTY (SUB)              TO  TOTAL-QTY ON SIZE ERROR
               PERFORM 4-SIZE-ERROR
               GO TO 62-SHOWFORM-2.

           GO TO 65-QTY-LOOP.

       66-UPDATE-MSTORERM.
           MOVE 10                       TO  SAVE-PARA-NUMBER.
           IF TOTAL-QTY = 0
      *        "Q19: QUANTITY IS A REQUIRED FIELD"
               MOVE  17                  TO  LANG-SETNUM
               MOVE  19                  TO  LANG-MSGNUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE 12                   TO  FIELD-NUMBER
               PERFORM 4-SET-ERROR
               PERFORM 67-UNLOCK-MSTORERM
               GO TO 62-SHOWFORM-2.

      *    CALL "DBBEGIN" USING BASE, DBTEXT, MODE1, STATUS-AREA,
      *      DBTEXT-LEN.
      *    IF COND-WORD NOT = 0
      *        MOVE "DBBEGIN ERR 66-UM" TO BU-DISPLAY-MSG
      *        PERFORM 2-BLOWUP.
      *
      *------INCLUDE CENTURY IN ACTIVITY DATE
           MOVE DATE-YMD-OUT             TO  STR-ACT-DATE.
           IF STR-ACT-DATE-YY > "70"
               MOVE "19" TO STR-ACT-DATE-CC
           ELSE
               MOVE "20" TO STR-ACT-DATE-CC.
      *    CALL "DBUPDATE" USING BASE DSET-MSTORERM MODE1 STATUS-AREA
      *      ALL-ITEMS BUF-MSTORERM.
           MOVE 0                        TO  COND-WORD.
           REWRITE MSTORERM-O-REC FROM BUF-MSTORERM
               INVALID KEY MOVE 99       TO  COND-WORD.
           IF FILE-STATUS NOT = "00"
               MOVE 99                   TO  COND-WORD.
           IF COND-WORD NOT = 0
               MOVE "DBUPDATE ERR 66-UM" TO  BU-DISPLAY-MSG
               PERFORM 2-BLOWUP.

       67-UNLOCK-MSTORERM.

           MOVE HIGH-VALUES              TO  CORPCDE OF MSTORERM-O-REC.
           START MSTORERM-O KEY > CORPCDE OF MSTORERM-O-REC
              INVALID KEY MOVE "2"       TO  FILE-STATUS-1.

           MOVE 11                       TO  SAVE-PARA-NUMBER.
      *    CALL "DBUNLOCK" USING BASE MULTI-LOCK MODE1 STATUS-AREA.
      *    IF COND-WORD NOT = 0
      *        MOVE "DBUNLOCK ERR 67-UM" TO BU-DISPLAY-MSG
      *        PERFORM 2-BLOWUP.
      *
      *---------- CALL THE REQUISITION FILE UPDATE SUBPROGRAM, WHICH
      *---------- WILL DECIDE IF A REQ UPDATE IS NEEDED, AND IF SO
      *---------- THE SUBPROG WILL DO THE REQ UPDATE. SINCE RESEVERED QTY
      *---------- CAN'T CHANGE THIS TRANSACTION, SAME NUMBER PASSED FOR
      *---------- RESERVED-BEFORE AND RESERVED-AFTER
           MOVE "01"                     TO  RET-CODE.
           MOVE STR-RESERVED             TO  SAVE-RSRVD-BEFORE.
           CALL "TREQFILU" USING RET-CODE, BASE, REQFILNO, CODE-ARG,
             SAVE-ONHAND-BEFORE, SAVE-RSRVD-BEFORE, STR-ONHAND,
             STR-RESERVED, STR-REORDER, STR-EXPEDITE.
           IF RET-CODE NOT = "00"
               MOVE "TREQFILU ERROR"     TO  BU-DISPLAY-MSG
               PERFORM 2-BLOWUP.

       68-UPDATE-DDAILYTC.
           MOVE 12                       TO  SAVE-PARA-NUMBER.
      *    CALL "DBLOCK" USING BASE, DSET-DDAILYTC, MODE3,
      *        STATUS-AREA.
      *    IF COND-WORD NOT = 0
      *        MOVE "DBLOCK ERR DDAILY" TO BU-DISPLAY-MSG
      *        PERFORM 2-BLOWUP.
      *
           MOVE DATE-YMD-OUT             TO  DDAILYTC-DATE.
           MOVE DATE-UNFORMATTED-TIME-OUT TO  DDAILYTC-TIME.
           MOVE SRF-MPLTINFO-COMPANY     TO  DDAILYTC-PLT.
           MOVE SPACES                   TO  DDAILYTC-DATA.
           IF DE-VALUE-9 > 999999.9999
               MOVE "431"                TO  DDAILYTC-TC
               MOVE CODE-ARG             TO  TC431-CORPCODE
               MOVE TOTAL-QTY            TO  TC431-QTY
               MOVE STR-UM               TO  TC431-UM
               MOVE DE-VALUE-9           TO  TC431-TOT-COST
               MOVE DE-DOCUMENT          TO  TC431-DOCUMENT
               MOVE DE-DEPT              TO  TC431-DEPT
               MOVE DE-EXP-CLASS         TO  TC431-EXP-CLASS
               MOVE STR-CLASS            TO  TC431-CLASS
           ELSE
               MOVE "331"                TO  DDAILYTC-TC
               MOVE CODE-ARG             TO  TC331-CORPCODE
               MOVE TOTAL-QTY            TO  TC331-QTY
               MOVE STR-UM               TO  TC331-UM
               MOVE DE-VALUE-9           TO  TC331-TOT-COST
               MOVE DE-DOCUMENT          TO  TC331-DOCUMENT
               MOVE DE-DEPT              TO  TC331-DEPT
               MOVE DE-EXP-CLASS         TO  TC331-EXP-CLASS
               MOVE STR-CLASS            TO  TC331-CLASS.

      *    CALL "DBPUT" USING BASE, DSET-DDAILYTC, MODE1, STATUS-AREA,
      *        ALL-ITEMS, BUF-DDAILYTC.
           MOVE 0                        TO  COND-WORD.
           WRITE DDAILYTC-REC FROM BUF-DDAILYTC
               INVALID KEY MOVE 99       TO  COND-WORD.
           IF FILE-STATUS NOT = "00"
               MOVE 99                   TO  COND-WORD.
           IF COND-WORD NOT = 0
               MOVE "DBPUT ERR 65-UO"    TO  BU-DISPLAY-MSG
               PERFORM 2-BLOWUP.

      *    CALL "DBUNLOCK" USING BASE, DSET-NAME, MODE1, STATUS-AREA.
      *    IF COND-WORD NOT = 0
      *        MOVE "DBUNLOCK ERR 2 65-UO" TO BU-DISPLAY-MSG
      *        PERFORM 2-BLOWUP.
      *
      *    CALL "DBEND" USING BASE, DBTEXT, MODE1, STATUS-AREA,
      *      DBTEXT-LEN.
      *    IF COND-WORD NOT = 0
      *        MOVE "DBEND ERR 69-UD" TO BU-DISPLAY-MSG
      *        PERFORM 2-BLOWUP.
      *
       69-PRINT.
           MOVE 13                       TO  SAVE-PARA-NUMBER.
           MOVE SRF-SPOOL-NO (1)         TO  SPOOL-PRT.
      *    CALL "SPOOL2631'START" USING SPOOL-STAT, SPOOL-MSG.
      *    IF SPOOL-STAT NOT = 0
      *        MOVE  19 TO LANG-SETNUM
      *        MOVE  17 TO LANG-MSGNUM
      *        PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
      *        MOVE SPOOL-STAT                            TO MSG-FLD-9
      *        PERFORM 4-SET-ERROR
      *        PERFORM 4-SHOW-FORM.
      *
           OPEN OUTPUT ONLINE-PRT.
           MOVE DATE-FORMATTED-TIME-OUT  TO  PRT-TIME.
           MOVE DATE-SLASH-OUT           TO  PRT-DATE.
           WRITE PRINT-RCD FROM HDR-1 AFTER ADVANCING 2.
           MOVE DE-DOCUMENT              TO  PRT-DOC.
           MOVE DE-DEPT                  TO  PRT-DEPT.
           MOVE DE-EXP-CLASS             TO  PRT-EXP-CLASS.
           MOVE DE-VALUE-9               TO  PRT-VALUE.
           WRITE PRINT-RCD FROM HDR-1A AFTER ADVANCING 2.
           WRITE PRINT-RCD FROM HDR-1B AFTER ADVANCING 1.
           WRITE PRINT-RCD FROM HDR-2 AFTER ADVANCING 2.

           MOVE STR-UM                   TO  PRT-UM.
           MOVE 0                        TO  SUB.
           MOVE 0                        TO  LOC-COUNT.
           MOVE "N"                      TO  PRT-CODE-FLAG.
           MOVE 14                       TO  SAVE-PARA-NUMBER.
       691-PRINT-LOOP.
           ADD 1                         TO  SUB.
           IF SUB > 6
               GO TO 692-FINISH-PRINT.
           IF DE-QTY (SUB) NOT = 0
               IF PRT-CODE-FLAG = "N"
                   MOVE CODE-ARG         TO  PRT-CORP-CODE
                   MOVE "Y"              TO  PRT-CODE-FLAG
               ELSE
                   MOVE SPACES           TO  PRT-CORP-CODE.
           IF DE-QTY (SUB) NOT = 0
               MOVE DE-QTY (SUB)         TO  PRT-QTY
               MOVE STR-LOC (SUB)        TO  PRT-LOC
               ADD 1                     TO  LOC-COUNT
               WRITE PRINT-RCD FROM PRT-RET-HDR AFTER ADVANCING 1.

           GO TO 691-PRINT-LOOP.

       692-FINISH-PRINT.
           MOVE 15                       TO  SAVE-PARA-NUMBER.
           IF LOC-COUNT > 1
               MOVE TOTAL-QTY            TO  PRT-TOTAL-QTY
               WRITE PRINT-RCD FROM TOTAL-LINE AFTER ADVANCING 2.

           IF DE-COMMENT NOT = SPACES
               MOVE DE-COMMENT           TO  PRT-COMMENT
               WRITE PRINT-RCD FROM COMMENT-LINE AFTER ADVANCING 2.

           MOVE SPACES                   TO  PRINT-RCD.
      *    WRITE PRINT-RCD AFTER ADVANCING NEW-PAGE.
      *    CALL "SPOOL2631'STOP" USING ONLINE-PRT SPOOL-PRT
      *      SPOOL-COPIES SPOOL-PRIOR SPOOL-STAT SPOOL-MSG.
      *    IF SPOOL-STAT NOT = 0
      *        MOVE  19 TO LANG-SETNUM
      *        MOVE  35 TO LANG-MSGNUM
      *        PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
      *        MOVE SPOOL-STAT                           TO MSG-FLD-9
      *        PERFORM 4-SET-ERROR
      *        PERFORM 4-SHOW-FORM.
      *
           CLOSE ONLINE-PRT.

       70-GO-TO-TOP.

           GO TO 601-GET-SON-FORM.

       6-MAIN-X.
           EXIT.


       650-GET-MVALID.
           MOVE 0                        TO  COND-WORD.
           MOVE VALID-ARG TO VALDTAKEY OF MVALIDPLTDATA-REC.
           READ MVALIDPLTDATA INTO BUF-MVALIDPLTDATA
               INVALID KEY MOVE 17       TO  COND-WORD.
           IF FILE-STATUS-1 = "2"
               MOVE 17                   TO  COND-WORD
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE 99                   TO  COND-WORD.

       660-RESET-NEGATIVES.
           ADD 1                         TO  SUB.
           IF DE-QTY (SUB) < 0
               MULTIPLY DE-QTY (SUB) BY -1 GIVING DE-QTY (SUB).

       699-MATERIAL-STATUS.
           MOVE VIEW-CFNAME              TO  SAVE-FORM.

      *    CALL "VCLOSEFORMF" USING VIEW-COMAREA.
      *    IF VIEW-STATUS NOT = 0
      *        MOVE "VCLOSEFORMF ERR 9070-CT" TO BU-DISPLAY-MSG
      *        PERFORM 2-BLOWUP.
      *
      *    CALL "VOPENFORMF" USING VIEW-COMAREA, MTLSTAT-FORMFILE.
      *    IF VIEW-STATUS NOT = 0
      *        MOVE "VOPENFORMF ERR 9070-CT" TO BU-DISPLAY-MSG
      *        PERFORM 2-BLOWUP.
      *
           MOVE "ZCSISINQ"               TO  VIEW-CFNAME.
           CALL "TMTLSTAT" USING BASE, VIEW-COMAREA,
             SRF-MPLTINFO-COMPANY, SPOOL-PRT, DUMMY-CODE-PARM,
             LANGUAGE-PARMS.
      *    CALL "VCLOSEFORMF" USING VIEW-COMAREA.
      *    IF VIEW-STATUS NOT = 0
      *        MOVE "VCLOSEFORMF ERR 2 9070-CT" TO BU-DISPLAY-MSG
      *        PERFORM 2-BLOWUP.
      *
      *    CALL "VOPENFORMF" USING VIEW-COMAREA, FORMFILE.
      *    IF VIEW-STATUS NOT = 0
      *        MOVE "VOPENFORMF ERR 2 9070-CT" TO BU-DISPLAY-MSG
      *        PERFORM 2-BLOWUP.
      *
      *    MOVE SAVE-FORM                TO  VIEW-NFNAME.
      *    CALL "VGETNEXTFORM" USING VIEW-COMAREA.
      *    IF VIEW-STATUS NOT = 0
      *        MOVE "VGETNEXTFORM ERR 9070-CT" TO BU-DISPLAY-MSG
      *        PERFORM 2-BLOWUP.
      *
           MOVE "ZUDCSTR"                TO  VIEW-CFNAME.

       900-GET-FRAN-NAME.
           IF FRAN-TABLE = SPACES
               MOVE SPACES TO DE-FRAN(SUB)
           ELSE
               SET FRAN-IDX TO 1
               SEARCH FRAN-ENTRY
                 AT END  MOVE SPACES TO DE-FRAN (SUB)
                 WHEN FRAN-ID(FRAN-IDX) = STR-BIN-OWNER (SUB)
                  MOVE FRAN-NAME(FRAN-IDX) TO DE-FRAN(SUB)
               END-SEARCH.
       900-GET-FRAN-NAME-X.
           EXIT.

       999-CATREAD.
           IF CATREAD-MSG-NUMBER = ZEROS
               MOVE LANG-SETNUM          TO  CATREAD-MSG-SET
               MOVE LANG-MSGNUM          TO  CATREAD-MSG-NUM.
           CALL "CCATREAD" USING CATREAD-PARMS.
           MOVE CATREAD-MSG-TEXT         TO  MESSAGE-BUFFER.
       999-CATREAD-EXIT.
           EXIT.
