      **************************************************************

       01  MESSAGE-BUFFER.
           05  MSG-TEXT                  PIC X(68)  VALUE SPACES.
           05  MSG-FLD                   PIC X(8)   VALUE SPACES.
           05  MSG-FLD-9 REDEFINES MSG-FLD PIC ZZZZZZZ9.

       01  MSG-BUFFLEN                   PIC S9(4)  COMP-4 VALUE 76.
       01  MSG-ACTUALEN                  PIC S9(4)  COMP-4 VALUE 76.

       01  FORMFILE.
           05  FORM-FNAME                PIC X(7)  VALUE "FUDCSTR".
           05  FILLER                    PIC X     VALUE ".".
           05  FORM-GNAME.
               10  FORM-GNAME1           PIC X(5)  VALUE "FLANG".
               10  FORM-GNAME2           PIC X(3)  VALUE SPACES.
           05  FILLER                    PIC X(19) VALUE SPACES.

       01  FIELD-NUMBER                  PIC S9(4) COMP-4 VALUE 1.

       01  MULTI-LOCK.
           05  NUMBER-OF-LOCK-DESCRIPTORS PIC S9(4) COMP-4 VALUE 1.
           05  LOCK-MSTORERM.
               10  LOCK-LENGTH           PIC S9(4) COMP-4 VALUE 24.
               10  LOCK-DSET             PIC X(16)  VALUE "MSTORERM;".
               10  LOCK-ITEM-LIST        PIC X(16)  VALUE "CORP-CODE;".
               10  LOCK-REL-OP           PIC XX     VALUE "= ".
               10  LOCK-VALUE            PIC X(12)  VALUE SPACES.

       01  FILE-STATUS.
           05  FILE-STATUS-1             PIC X  VALUE "0".
           05  FILE-STATUS-2             PIC X  VALUE "0".

       01  PASSWORD                      PIC X(8)  VALUE "JADE;".
       01  MODE-AREA.
           05  MODE1                     PIC S9(4)  VALUE +1 COMP-4.
           05  MODE3                     PIC S9(4)  VALUE +3 COMP-4.
           05  MODE5                     PIC S9(4)  VALUE +5 COMP-4.
           05  MODE7                     PIC S9(4)  VALUE +7 COMP-4.

       COPY DBSTAT     IN COPYLIB.
       01  DSET-NAMES.
           05  DSET-NAME                 PIC X(16)  VALUE SPACES.
           05  DSET-DDAILYTC             PIC X(16)  VALUE "DDAILYTC;".
           05  DSET-MSTORERM             PIC X(16)  VALUE "MSTORERM;".
           05  DSET-DDESC                PIC X(16)  VALUE "DDESC;".
           05  DSET-MVALIDPLTDATA PIC X(16)  VALUE "MVALIDPLTDATA;".

       01  ITEM-LISTINGS.
           05  ALL-ITEMS                 PIC XX     VALUE "@;".
           05  CODE-SEARCH               PIC X(10)  VALUE "CORP-CODE;".

       01  DB-LOGGING-STUFF.
           05  DBTEXT                    PIC X(8)  VALUE "SRETWVLS".
           05  DBTEXT-LEN                PIC S9(4) COMP-4 VALUE 8.

       01  VALID-ARG.
           05  VALID-ARG-1-2             PIC X(2).
           05  VALID-ARG-3-10            PIC X(8).

      **************************************************************
      **                                                          **
      **           D A T A B A S E   B U F F E R S                **
      **                                                          **
      **************************************************************

       COPY MSTORERM   IN COPYLIB.
       COPY DDESC      IN COPYLIB.
       COPY DDAILYTC   IN COPYLIB.
       COPY TC331      IN COPYLIB.
       COPY TC431      IN COPYLIB.
       COPY MVALDPLT   IN COPYLIB.
       COPY MPLT0      IN COPYLIB.
       COPY MPLTFRAN   IN COPYLIB.

      **************************************************************
      **                                                          **
      **     H E A D E R   &   D E T A I L   L I N E S            **
      **                                                          **
      **************************************************************

       01  HDR-1.
           05  FILLER                    PIC X(24)  VALUE SPACES.
           05  FILLER    PIC X(14)  VALUE " RETURN   WITH".
           05  FILLER                    PIC X(8)   VALUE "   VALUE".
           05  FILLER                    PIC X(5)   VALUE SPACES.
           05  FILLER                    PIC X(5)   VALUE "DATE ".
           05  PRT-DATE                  PIC X(8).
           05  FILLER                    PIC X(3)   VALUE SPACES.
           05  FILLER                    PIC X(5)   VALUE "TIME ".
           05  PRT-TIME                   PIC X(8).

       01  HDR-1A.
           05  FILLER                    PIC X(3)   VALUE SPACES.
           05  FILLER                    PIC X(10)  VALUE "DOCUMENT: ".
           05  PRT-DOC                   PIC X(10).
           05  FILLER                    PIC X(5)   VALUE SPACES.
           05  FILLER                    PIC X(6)   VALUE "DEPT: ".
           05  PRT-DEPT                  PIC X(4).
           05  FILLER                    PIC X(5)   VALUE SPACES.
           05  FILLER    PIC X(13)  VALUE "TOTAL VALUE: ".
           05  PRT-VALUE                 PIC Z(11)9.9999.

       01  HDR-1B.
           05  FILLER                    PIC X(3)   VALUE SPACES.
           05  FILLER    PIC X(15)  VALUE "EXPENSE CLASS: ".
           05  PRT-EXP-CLASS             PIC X(6).

       01  HDR-2.
           05  FILLER                    PIC X(16)  VALUE SPACES.
           05  FILLER                    PIC X(9)   VALUE "CORP CODE".
           05  FILLER                    PIC X(9)   VALUE SPACES.
           05  FILLER                    PIC X(8)   VALUE "QUANTITY".
           05  FILLER                    PIC X(4)   VALUE "  UM".
           05  FILLER                    PIC X(5)   VALUE SPACES.
           05  FILLER                    PIC X(8)   VALUE "LOCATION".
           05  FILLER                    PIC X(21)  VALUE SPACES.

       01  PRT-RET-HDR.
           05  FILLER                    PIC X(17)  VALUE SPACES.
           05  PRT-CORP-CODE             PIC X(7)   VALUE SPACES.
           05  FILLER                    PIC X(9)   VALUE SPACES.
           05  PRT-QTY                   PIC --------9.
           05  FILLER                    PIC XX     VALUE SPACES.
           05  PRT-UM                    PIC XX     VALUE SPACES.
           05  FILLER                    PIC X(5)   VALUE SPACES.
           05  PRT-LOC                   PIC X(12)  VALUE SPACES.
           05  FILLER                    PIC X(17)  VALUE SPACES.

       01  TOTAL-LINE.
           05  FILLER                    PIC X(28)  VALUE SPACES.
           05  FILLER                    PIC X(5)   VALUE "TOTAL".
           05  PRT-TOTAL-QTY             PIC --------9.

       01  COMMENT-LINE.
           05  FILLER                    PIC X(10)  VALUE " COMMENT: ".
           05  PRT-COMMENT               PIC X(60).

      **************************************************************
