      ***  PARAMETERS FOR CALL TO SLEMMER'S SPOOLER

       01  SPOOLER-AREA.
           05  SPOOL-STAT                PIC S9     VALUE ZEROS COMP-4.
           05  SPOOL-PRT                 PIC S9(2)  COMP-4.
           05  SPOOL-COPIES              PIC S9(2)  COMP-4 VALUE 1.
           05  SPOOL-PRIOR               PIC S9     COMP-4 VALUE 0.
           05  SPOOL-MSG                 PIC X(75)  VALUE  SPACES.

       COPY TSHWRDFM IN COPYLIB.
       COPY TBLOWUP  IN COPYLIB.
       COPY CDESC    IN COPYLIB.
       COPY CATREAD  IN COPYLIB.

       COPY TDATECHK IN COPYLIB.
       01  SAVE-FORM                     PIC X(16) VALUE SPACES.
       01  MTLSTAT-FORMFILE.
           05  FORM-FNAME-A              PIC X(8)  VALUE "FCSISINQ".
           05  FILLER                    PIC X     VALUE ".".
           05  FORM-GNAME-A.
               10  FORM-GNAME1-A         PIC X(5)  VALUE "FLANG".
               10  FORM-GNAME2-A         PIC X(3)  VALUE SPACES.
           05  FILLER                    PIC X(19) VALUE SPACES.

       01  CIR-PARMS.
           05  CISITRAW-RET-CODE         PIC X(1).

      *---5/12/97, JSB HOLDING AREA FOR FRANCHISERS
       01  FRAN-TABLE.
           05  FRAN-ENTRY OCCURS 4 TIMES INDEXED BY FRAN-IDX.
               10  FRAN-ID             PIC X(1).
               10  FRAN-NAME           PIC X(4).
               10  FRAN-VEN0CODE       PIC X(10).

