       IDENTIFICATION DIVISION.
       PROGRAM-ID.   TZONTOBC.
       AUTHOR.       AHK/JIM COFFMAN.
       INSTALLATION. GOODYEAR TIRE & RUBBER LTD.
      *REMARKS.
      *    THIS PROGRAM ACCEPTS FROM & TO ZONES AND UPDATES
      *    ALL RELATED DATASETS.
      *C
      *C 09/05/96  JEFF BUNGO
      *C    EXPAND DATE FIELDS FOR YEAR 2000 COMPLIANCE.
      *C    RECOMPILE TO PICK UP DATABASE CHANGES.
      *C
       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.
       SOURCE-COMPUTER.  AS400.
       OBJECT-COMPUTER.  AS400.
       COPY SPECIALN OF COPYLIB.
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT DISPLAY-FILE
               ASSIGN TO WORKSTATION-ZZONTOBC-SI
               ORGANIZATION IS TRANSACTION
               ACCESS IS SEQUENTIAL
               FILE STATUS IS DSPLY-STATUS
               CONTROL-AREA IS WS-CONTROL.
           SELECT EQP-EQUIPMENT-FILE
               ASSIGN TO DATABASE-MCFPMM0200
               ACCESS IS SEQUENTIAL
               FILE STATUS IS FILE-STATUS.
           SELECT EQP-HOT-CODE-FILE
               ASSIGN TO DATABASE-MCFLMM2001
               ORGANIZATION IS INDEXED
               ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                   WITH DUPLICATES
               FILE STATUS IS FILE-STATUS.
           SELECT NEWS-TABLE-FILE
               ASSIGN TO DATABASE-MCFLMM2802
               ORGANIZATION IS INDEXED
               ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                   WITH DUPLICATES
               FILE STATUS IS FILE-STATUS.
           SELECT PER-PERSONNEL-FILE
               ASSIGN TO DATABASE-MCFPMM0300
               ACCESS IS SEQUENTIAL
               FILE STATUS IS FILE-STATUS.
           SELECT PM-OPEN-QUEUE-FILE
               ASSIGN TO DATABASE-MCFLMM3903
               ORGANIZATION IS INDEXED
               ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                   WITH DUPLICATES
               FILE STATUS IS FILE-STATUS.
           SELECT PRINT-FILE ASSIGN TO PRINTER-QPRINT.
           SELECT WO-BASIC-FILE
               ASSIGN TO DATABASE-MCFLMM1004
               ORGANIZATION IS INDEXED
               ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                   WITH DUPLICATES
               FILE STATUS IS FILE-STATUS.
           SELECT WO-OPEN-QUEUE-FILE
               ASSIGN TO DATABASE-MCFLMM1901
               ORGANIZATION IS INDEXED
               ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                   WITH DUPLICATES
               FILE STATUS IS FILE-STATUS.
           SELECT WO-PLANNED-FILE
               ASSIGN TO DATABASE-MCFPMM1100
               ACCESS IS SEQUENTIAL
               FILE STATUS IS FILE-STATUS.
           SELECT WO-SCHEDULE-FILE
               ASSIGN TO DATABASE-MCFLMM2301
               ORGANIZATION IS INDEXED
               ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                   WITH DUPLICATES
               FILE STATUS IS FILE-STATUS.
           SELECT WO-ZONE-PRTY-FILE
               ASSIGN TO DATABASE-MCFLMM0501
               ORGANIZATION IS INDEXED
               ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
               FILE STATUS IS FILE-STATUS.

       DATA DIVISION.
       FILE SECTION.
       FD   DISPLAY-FILE
            LABEL RECORDS ARE OMITTED.
       01   DSPLY-REC                         PIC X(2000).
       FD   EQP-EQUIPMENT-FILE
            LABEL RECORDS ARE STANDARD
            DATA RECORD IS EEFREC.
       01   EEFREC.
            COPY DDS-ALL-FORMATS OF MCFPMM0200.
       FD   EQP-HOT-CODE-FILE
            LABEL RECORDS ARE STANDARD
            DATA RECORD IS EHCFREC.
       01   EHCFREC.
            COPY DDS-ALL-FORMATS OF MCFLMM2001.
       FD   NEWS-TABLE-FILE
            LABEL RECORDS ARE STANDARD
            DATA RECORD IS NTFREC.
       01   NTFREC.
            COPY DDS-ALL-FORMATS OF MCFLMM2802.
       FD   PER-PERSONNEL-FILE
            LABEL RECORDS ARE STANDARD
            DATA RECORD IS PPFREC.
       01   PPFREC.
            COPY DDS-ALL-FORMATS OF MCFPMM0300.
       FD   PM-OPEN-QUEUE-FILE
            LABEL RECORDS ARE STANDARD
            DATA RECORD IS POQFREC.
       01   POQFREC.
            COPY DDS-ALL-FORMATS OF MCFLMM3903.
       FD   WO-BASIC-FILE
            LABEL RECORDS ARE STANDARD
            DATA RECORD IS WBFREC.
       01   WBFREC.
            COPY DDS-ALL-FORMATS OF MCFLMM1004.
       FD   WO-OPEN-QUEUE-FILE
            LABEL RECORDS ARE STANDARD
            DATA RECORD IS WOQFREC.
       01   WOQFREC.
            COPY DDS-ALL-FORMATS OF MCFLMM1901.
       FD   WO-PLANNED-FILE
            LABEL RECORDS ARE STANDARD
            DATA RECORD IS WPFREC.
       01   WPFREC.
            COPY DDS-ALL-FORMATS OF MCFPMM1100.
       FD   WO-SCHEDULE-FILE
            LABEL RECORDS ARE STANDARD
            DATA RECORD IS WSFREC.
       01   WSFREC.
            COPY DDS-ALL-FORMATS OF MCFLMM2301.
       FD   WO-ZONE-PRTY-FILE
            LABEL RECORDS ARE STANDARD
            DATA RECORD IS WZPFREC.
       01   WZPFREC.
            COPY DDS-ALL-FORMATS OF MCFLMM0501.
       FD   PRINT-FILE
            LABEL RECORDS ARE OMITTED.
       01   PRINT-REC                        PIC X(132).

       WORKING-STORAGE SECTION.
       01  DSPLY-STATUS                      PIC XX.
       01  FILE-STATUS                       PIC XX.
       01  SUB                               PIC 9    VALUE ZEROES.
       01  WS-LINE-COUNTER                   PIC 99   VALUE 55.
       01  WS-PAGE-COUNTER                   PIC 9(4) VALUE 0.
       01  OLD-ZONE-FLAG                     PIC X(1) VALUE SPACES.
           88 OLD-ZONE-EXISTING                       VALUE SPACES.
       01  NEW-ZONE-FLAG                     PIC X(1) VALUE SPACES.
           88 NEW-ZONE-NOT-EXISTING                   VALUE SPACES.
       01  EXIT-FLAG                         PIC X(1) VALUE SPACES.
           88 CHAIN-PROCESSED                         VALUE "Y".

      *NEW FIELDS ADDED ON 23 JULY 1990

       01  NO-OF-RECS-CHANGED                PIC 9(7) VALUE ZEROES.
       01  TOTAL-REC-CHANGED                 PIC 9(7) VALUE ZEROES.
        COPY CPYIND  OF COPYLIB.
        COPY TBLOWUP OF COPYLIB.
        COPY LANGSUB OF COPYLIB.
      **********************
      *                    *
      *  F L A G S         *
      *                    *
      **********************

       01  ZONE-FOUND-FLAG             PIC X          VALUE SPACES.
           88  ZONE-FOUND                             VALUE "Y".
           88  ZONE-NOT-FOUND                         VALUE "N".
       01  ERROR-FLAG                  PIC X          VALUE SPACES.
           88  NO-ERRORS                              VALUE "N".

      *********************
      *                   *
      * IMAGE AREA        *
      *                   *
      *********************
       COPY DBMODES OF COPYLIB.
       COPY DBSTAT  OF COPYLIB.

      *********************
      *                   *
      *   DATA SET NAMES  *
      *                   *
      *********************

       01  DSET-NAMES.
           05  DSET-NAME              PIC X(16) VALUE SPACES.
           05  DSET-WO-ZONE-PRTY      PIC X(16) VALUE "WO-ZONE-PRTY;".
           05  DSET-EQP-EQUIPMENT     PIC X(16) VALUE "EQP-EQUIPMENT;".
           05  DSET-EQP-HOT-CODE      PIC X(16) VALUE "EQP-HOT-CODE;".
           05  DSET-NEWS-TABLE        PIC X(16) VALUE "NEWS-TABLE;".
           05  DSET-PER-PERSONNEL     PIC X(16) VALUE "PER-PERSONNEL;".
           05  DSET-PM-OPEN-QUEUE     PIC X(16) VALUE "PM-OPEN-QUEUE;".
           05  DSET-WO-PLANNED        PIC X(16) VALUE "WO-PLANNED;".
           05  DSET-WO-BASIC          PIC X(16) VALUE "WO-BASIC;".
           05  DSET-WO-OPEN-QUEUE     PIC X(16) VALUE "WO-OPEN-QUEUE;".
           05  DSET-WO-SCHEDULE       PIC X(16) VALUE "WO-SCHEDULE;".

       01  ITEMS-LISTING.
           05  ALL-ITEMS              PIC XX    VALUE "@;".
           05  ZONE-PRIORITY-SEARCH   PIC X(16) VALUE "ZONE-PRIORITY;".

       COPY IOFEEDBACK IN COPYLIB.

       01  ZONE-PRIORITY-VALUE.
           05  ZONE-PRI               PIC X(4)  VALUE SPACES.
           05  ZONE-NUMBER            PIC X(1)  VALUE SPACES.
           05  FILLER                 PIC X     VALUE SPACES.
       01  DUMMY                      PIC X     VALUE SPACES.
       01  SYS-DATE                   PIC 9(06) VALUE ZEROES.
      ****************************************
      **
      **  MMISA DATA BASE BUFFERS
      **
      ****************************************

       01  MMISA-BASE                 PIC X(16) VALUE "  MMISA;".

       01  MMISA-PASSWORD             PIC X(16) VALUE "DO-ALL;".

       01  WO-ZONE-PRTY-BUFFER.    COPY MZONPRTY IN COPYLIB.

       01  EQP-EQUIPMENT-BUFFER.   COPY MEQPFILE IN COPYLIB.

       01  EQP-HOT-CODE-BUFFER.    COPY DHOTCODE IN COPYLIB.

       01  NEWS-TABLE-BUFFER.      COPY DNEWSTBL IN COPYLIB.

       01  PER-PERSONNEL-BUFFER.   COPY MPERSONL IN COPYLIB.

       01  PM-OPEN-QUEUE-BUFFER.   COPY DPMOPENQ IN COPYLIB.

       01  WO-BASIC-BUFFER.        COPY DWOBASIC IN COPYLIB.

       01  WO-PLANNED-BUFFER.      COPY DWOPLAN  IN COPYLIB.

       01  WO-OPEN-QUEUE-BUFFER.   COPY DWOOPENQ IN COPYLIB.

       01  WO-SCHEDULE-BUFFER.     COPY DWOSCHED IN COPYLIB.

      ****************************************
      **
      **  VPLUS AREA
      **
      ****************************************
       COPY VCOMAREA IN COPYLIB.

       01  DE-FIELDS.
           05  DE-DATE                PIC X(8).
           05  DE-OLD-ZONE            PIC X(4).
           05  DE-NEW-ZONE            PIC X(4).
           05  DE-COMMAND-LINE        PIC X(79).
           05  DE-ERROR-LINE          PIC X(79).

       01  OLD-ZONE-FLD-NUM           PIC 99         VALUE 2.
       01  NEW-ZONE-FLD-NUM           PIC 99         VALUE 3.

       01  WS-LAST-KEY                PIC S9(4) COMP VALUE 0.
           88 F3-KEY-IS-PRESSED                      VALUE 3.
           88 ENTER-KEY                              VALUE 0.
       01  MESSAGE-BUFFER             PIC X(79)      VALUE SPACES.
       01  MESSAGE-BUFLEN             PIC S9(4) COMP VALUE 16.
       01  MESSAGE-ACTLEN             PIC S9(4) COMP VALUE 79.
       01  FORMFILE.
           05  FORM-FNAME             PIC X(8)  VALUE "FZONTOBC".
           05  FILLER                 PIC X     VALUE ".".
           05  FORM-GNAME.
               10  FORM-GNAME1        PIC X(5)  VALUE "FLANG".
               10  FORM-GNAME2        PIC X(3)  VALUE SPACES.
           05  FILLER                 PIC X(19) VALUE SPACES.

       01  FIELD-NUMBER               PIC S9(4) COMP VALUE 0.


      ****************************************
      *
      * PRINT LINES
      *
      ****************************************

       01  HEADER-LINE.
           05  FILLER                 PIC X(07)      VALUE
               "DATE : ".
           05  PL-SYS-DATE            PIC 99/99/99.
           05  FILLER                 PIC X(33)      VALUE SPACES.
           05  FILLER                 PIC X(70)      VALUE
               "    ZONE  TO  BUSINESS  CENTERS  ".
           05  FILLER                 PIC X(10)      VALUE
               "   PAGE # ".
           05  PL-PAGE-NO             PIC Z(04)      VALUE ZEROES.

       01  UNDER-LINE.
           05  FILLER                 PIC X(132)     VALUE ALL "-".
       01  FIELD-HEADER.
           05  FILLER                 PIC X(20)      VALUE
               "WORK ORD/EQP.NUMBER".
           05  FILLER                 PIC X(10)      VALUE
               "OLD ZONE".
           05  FILLER                 PIC X(15)      VALUE
               "NEW ZONE".
           05  FILLER                 PIC X(15)      VALUE
               "DATA SET".

       01  DETAIL-LINE.
           05  FILLER                 PIC X(05)      VALUE SPACES.
           05  PL-WORK-EQP-NUM        PIC X(10)B(05).
           05  PL-OLD-ZONE            PIC B(03)X(04)B(03).
           05  PL-NEW-ZONE            PIC B(03)X(04)B(08).
           05  PL-DATA-SET            PIC X(15).

       01  DATE-FORMAT.
           05  DATE-FORMAT-DD         PIC 9(02).
           05  FILLER                 PIC X      VALUE "/".
           05  DATE-FORMAT-MM         PIC 9(02).
           05  FILLER                 PIC X      VALUE "/".
           05  DATE-FORMAT-YY         PIC 9(02).

       01  TIME-FORMAT.
           05  TIME-FORMAT-HH         PIC 9(02).
           05  FILLER                 PIC X      VALUE ":".
           05  TIME-FORMAT-MM         PIC 9(02).

       COPY WSCONTROL IN COPYLIB.
       PROCEDURE DIVISION.
       MAIN-PROCESS.
            MOVE SPACES            TO DETAIL-LINE.
            PERFORM GET-SYS-DATE.
            OPEN I-O    DISPLAY-FILE.
            OPEN I-O    EQP-EQUIPMENT-FILE,
                        EQP-HOT-CODE-FILE,
                        NEWS-TABLE-FILE,
                        PER-PERSONNEL-FILE,
                        PM-OPEN-QUEUE-FILE,
                        WO-BASIC-FILE,
                        WO-OPEN-QUEUE-FILE,
                        WO-PLANNED-FILE,
                        WO-SCHEDULE-FILE,
                        WO-ZONE-PRTY-FILE.
            OPEN OUTPUT PRINT-FILE.
            MOVE "ZONTOBC1"    TO VIEW-CFNAME.
            MOVE SPACES TO DE-FIELDS.
            PERFORM ACCEPT-CHANGE-ZONE
                    UNTIL F3-KEY-IS-PRESSED
            PERFORM SHUT-FILES.
            GOBACK.

       GET-SYS-DATE.
            ACCEPT SYS-DATE FROM DATE.
            MOVE SYS-DATE          TO PL-SYS-DATE.

       ACCEPT-CHANGE-ZONE.
            MOVE DE-FIELDS         TO DSPLY-REC.
            PERFORM 99-SCREEN-WRITE.
            PERFORM 98-SCREEN-READ.
            MOVE DSPLY-REC         TO DE-FIELDS.
            MOVE VIEW-LASTKEY      TO WS-LAST-KEY.
            IF  F3-KEY-IS-PRESSED
                NEXT SENTENCE
            ELSE
            IF  ENTER-KEY
                PERFORM PROCESS-ZONE-CHANGES
            ELSE
            MOVE "INVALID KEY PRESSED     " TO DE-ERROR-LINE
            MOVE "1"                        TO INDS (99).

       SHUT-FILES.
            CLOSE WO-ZONE-PRTY-FILE,
                  EQP-EQUIPMENT-FILE,
                  EQP-HOT-CODE-FILE,
                  NEWS-TABLE-FILE,
                  PER-PERSONNEL-FILE,
                  PM-OPEN-QUEUE-FILE,
                  WO-BASIC-FILE,
                  WO-OPEN-QUEUE-FILE,
                  WO-PLANNED-FILE,
                  WO-SCHEDULE-FILE,
                  PRINT-FILE.


       PROCESS-ZONE-CHANGES.
            PERFORM CHECK-OLD-ZONE.
            IF  OLD-ZONE-EXISTING
                PERFORM CHECK-NEW-ZONE
                IF  NEW-ZONE-NOT-EXISTING
                    MOVE "NOW PROCESSING...." TO DE-COMMAND-LINE
                    MOVE DE-FIELDS            TO DSPLY-REC
                    MOVE "1"                  TO INDS (98)
                    PERFORM 99-SCREEN-WRITE
                    PERFORM 98A-SCREEN-READ
                    PERFORM CREATE-NEW-ZONE-MASTER-RECS
                    PERFORM UPDATE-EQP-EQUIPMENT-DATASET
                    PERFORM UPDATE-PER-PERSONNEL-DATASET
                    PERFORM UPDATE-WO-BASIC-DATASET      VARYING SUB
                                                              FROM 1
                                                                BY 1
                                                       UNTIL SUB > 6
                    PERFORM UPDATE-WO-PLANNED-DATASET
                    PERFORM UPDATE-WO-OPEN-QUEUE-DATASET VARYING SUB
                                                              FROM 1
                                                                BY 1
                                                       UNTIL SUB > 6
                    PERFORM UPDATE-EQP-HOT-CODE-DATASET  VARYING SUB
                                                              FROM 1
                                                                BY 1
                                                       UNTIL SUB > 6
                    PERFORM UPDATE-WO-SCHEDULE-DATASET   VARYING SUB
                                                              FROM 1
                                                                BY 1
                                                       UNTIL SUB > 6
                    PERFORM UPDATE-NEWS-TABLE-DATASET    VARYING SUB
                                                              FROM 1
                                                                BY 1
                                                       UNTIL SUB > 6
                    PERFORM UPDATE-PM-OPEN-QUEUE-DATASET VARYING SUB
                                                              FROM 1
                                                                BY 1
                                                       UNTIL SUB > 6
                    PERFORM DELETE-OLD-ZONE-MASTER-RECS
                    MOVE SPACES               TO DE-OLD-ZONE
                                                 DE-NEW-ZONE
                                                 DE-COMMAND-LINE.

       CHECK-OLD-ZONE.
            IF  DE-OLD-ZONE = SPACES
                MOVE "Y"        TO OLD-ZONE-FLAG
                MOVE "OLD ZONE CANNOT BE SPACES" TO DE-ERROR-LINE
                MOVE "1"                         TO INDS (99)
            ELSE
                MOVE DE-OLD-ZONE    TO ZONE-PRI
                MOVE "1 "           TO ZONE-NUMBER
                PERFORM GET-WO-ZONE-PRTY
                IF  COND-WORD = 0
                    MOVE SPACES     TO OLD-ZONE-FLAG
                ELSE
                    MOVE "Y"        TO OLD-ZONE-FLAG
                    MOVE "OLD ZONE NOT EXISTING" TO DE-ERROR-LINE
                    MOVE "1"                     TO INDS (99).

       CHECK-NEW-ZONE.
            IF  DE-NEW-ZONE = SPACES
                MOVE "Y"            TO NEW-ZONE-FLAG
                MOVE "NEW ZONE CANNOT BE SPACES" TO DE-ERROR-LINE
                MOVE "1"                         TO INDS (99)
            ELSE
                MOVE DE-NEW-ZONE    TO ZONE-PRI
                MOVE "1"            TO ZONE-NUMBER
                PERFORM GET-WO-ZONE-PRTY
                IF  COND-WORD = 0
                    MOVE "Y"        TO NEW-ZONE-FLAG
                    MOVE "NEW ZONE EXISTING" TO DE-ERROR-LINE
                    MOVE "1"                 TO INDS (99)
                ELSE
                    MOVE SPACES     TO NEW-ZONE-FLAG.

       CREATE-NEW-ZONE-MASTER-RECS.
            PERFORM PUT-WO-ZONE-PRTY VARYING SUB FROM 1 BY 1
                                     UNTIL SUB > 6.

       UPDATE-EQP-EQUIPMENT-DATASET.
            PERFORM READ-EQP-EQUIPMENT-SERIALLY.
            PERFORM UPDATE-EQP-EQUIPMENT-RECS UNTIL END-OF-FILE.
            CLOSE EQP-EQUIPMENT-FILE.
            OPEN I-O EQP-EQUIPMENT-FILE.

       UPDATE-PER-PERSONNEL-DATASET.
            PERFORM READ-PER-PERSONNEL-SERIALLY.
            PERFORM UPDATE-PER-PERSONNEL-RECS UNTIL END-OF-FILE.
            CLOSE PER-PERSONNEL-FILE.
            OPEN I-O PER-PERSONNEL-FILE.

       UPDATE-WO-BASIC-DATASET.
            PERFORM FIND-ZONE-ON-WO-BASIC.
            IF  ZONE-FOUND
                PERFORM READ-WO-BASIC-NEXT
                MOVE SPACES TO EXIT-FLAG
                PERFORM UPDATE-WO-BASIC-RECS UNTIL CHAIN-PROCESSED.

       UPDATE-WO-PLANNED-DATASET.
            PERFORM READ-WO-PLANNED-SERIALLY.
            PERFORM UPDATE-WO-PLANNED-RECS UNTIL END-OF-FILE.
            CLOSE WO-PLANNED-FILE.
            OPEN I-O WO-PLANNED-FILE.

       UPDATE-WO-OPEN-QUEUE-DATASET.
            PERFORM FIND-ZONE-ON-WO-OPEN-QUEUE.
            IF  ZONE-FOUND
                PERFORM READ-WO-OPEN-QUEUE-NEXT
                MOVE SPACES TO EXIT-FLAG
                PERFORM UPDATE-WO-OPEN-QUEUE-RECS UNTIL CHAIN-PROCESSED.

       UPDATE-EQP-HOT-CODE-DATASET.
            PERFORM FIND-ZONE-ON-EQP-HOT-CODE.
            IF  ZONE-FOUND
                PERFORM READ-EQP-HOT-CODE-NEXT
                MOVE SPACES TO EXIT-FLAG
                PERFORM UPDATE-EQP-HOT-CODE-RECS UNTIL CHAIN-PROCESSED.

       UPDATE-WO-SCHEDULE-DATASET.
            PERFORM FIND-ZONE-ON-WO-SCHEDULE.
            IF  ZONE-FOUND
                PERFORM READ-WO-SCHEDULE-NEXT
                MOVE SPACES TO EXIT-FLAG
                PERFORM UPDATE-WO-SCHEDULE-RECS UNTIL CHAIN-PROCESSED.

       UPDATE-NEWS-TABLE-DATASET.
            PERFORM FIND-ZONE-ON-NEWS-TABLE.
            IF  ZONE-FOUND
                PERFORM READ-NEWS-TABLE-NEXT
                MOVE SPACES TO EXIT-FLAG
                PERFORM UPDATE-NEWS-TABLE-RECS UNTIL CHAIN-PROCESSED.

       UPDATE-PM-OPEN-QUEUE-DATASET.
            PERFORM FIND-ZONE-ON-PM-OPEN-QUEUE.
            IF  ZONE-FOUND
                PERFORM READ-PM-OPEN-QUEUE-NEXT
                MOVE SPACES TO EXIT-FLAG
                PERFORM UPDATE-PM-OPEN-QUEUE-RECS UNTIL CHAIN-PROCESSED.

       DELETE-OLD-ZONE-MASTER-RECS.
            MOVE DSET-WO-ZONE-PRTY TO DSET-NAME.
            PERFORM DELETE-WO-ZONE-PRTY VARYING SUB FROM 1 BY 1
                                     UNTIL SUB > 6.

       GET-WO-ZONE-PRTY.
            MOVE 0              TO COND-WORD.
            MOVE ZONE-PRIORITY-VALUE TO ZONEPRTY OF WZPFREC.
            READ WO-ZONE-PRTY-FILE INTO WO-ZONE-PRTY-BUFFER
                INVALID KEY    MOVE 17 TO COND-WORD.
            IF FILE-STATUS NOT = "00" MOVE 17 TO COND-WORD.

       PUT-WO-ZONE-PRTY.
            MOVE SPACES TO WO-ZONE-PRTY-BUFFER.
            MOVE DE-NEW-ZONE    TO ZONE-FIELD.
            MOVE SUB            TO PRTY-NUM.
            MOVE 0              TO COND-WORD.
            MOVE WO-ZONE-PRTY-BUFFER TO WZPFREC.
            WRITE WZPFREC    INVALID KEY MOVE 17 TO COND-WORD.
            IF FILE-STATUS NOT = "00" MOVE 17 TO COND-WORD.
            IF  COND-WORD NOT = 0
                DISPLAY "PROGRAM CANNOT PROCEED"
                DISPLAY "PU WO ZONE PRTY FAILED"
                DISPLAY COND-WORD
                GOBACK.

       READ-EQP-EQUIPMENT-SERIALLY.
            MOVE 0 TO COND-WORD.
            READ EQP-EQUIPMENT-FILE NEXT INTO EQP-EQUIPMENT-BUFFER
                AT END    MOVE 11 TO COND-WORD.
            IF FILE-STATUS NOT = "00" MOVE 11 TO COND-WORD.

       UPDATE-EQP-EQUIPMENT-RECS.
            IF  NOT  END-OF-FILE
                IF  EQP-MAINT-ZONE = DE-OLD-ZONE
                    MOVE DE-NEW-ZONE  TO  EQP-MAINT-ZONE
                    PERFORM REWRITE-EQP-EQUIPMENT-FILE
                    IF  COND-WORD = 0
                        MOVE EQP-EQUIP-NUM TO PL-WORK-EQP-NUM
                        MOVE DE-OLD-ZONE  TO PL-OLD-ZONE
                        MOVE DE-NEW-ZONE  TO PL-NEW-ZONE
                        MOVE DSET-EQP-EQUIPMENT TO PL-DATA-SET
                        PERFORM PRINT-DETAILS.
            PERFORM READ-EQP-EQUIPMENT-SERIALLY.

       READ-PER-PERSONNEL-SERIALLY.
            MOVE 0 TO COND-WORD.
            READ PER-PERSONNEL-FILE NEXT INTO PER-PERSONNEL-BUFFER
                AT END    MOVE 11 TO COND-WORD.
            IF FILE-STATUS NOT = "00" MOVE 11 TO COND-WORD.

       UPDATE-PER-PERSONNEL-RECS.
            IF  NOT  END-OF-FILE
                IF  PER-MAINT-ZONE = DE-OLD-ZONE
                    MOVE DE-NEW-ZONE  TO  PER-MAINT-ZONE
                    PERFORM REWRITE-PER-PERSONNEL-FILE
                    IF  COND-WORD = 0
                        MOVE SPACES       TO PL-WORK-EQP-NUM
                        MOVE DE-OLD-ZONE  TO PL-OLD-ZONE
                        MOVE DE-NEW-ZONE  TO PL-NEW-ZONE
                        MOVE DSET-PER-PERSONNEL TO PL-DATA-SET
                        PERFORM PRINT-DETAILS.
            PERFORM READ-PER-PERSONNEL-SERIALLY.

       READ-WO-PLANNED-SERIALLY.
            MOVE 0 TO COND-WORD.
            READ WO-PLANNED-FILE NEXT INTO WO-PLANNED-BUFFER
                AT END    MOVE 11 TO COND-WORD.
            IF FILE-STATUS NOT = "00" MOVE 11 TO COND-WORD.

       UPDATE-WO-PLANNED-RECS.
            IF  NOT  END-OF-FILE
                IF  ZONE-P = DE-OLD-ZONE
                    MOVE DE-NEW-ZONE  TO  ZONE-P
                    PERFORM REWRITE-WO-PLANNED-FILE
                    IF  COND-WORD = 0
                        MOVE WO-NUM-PLANNED TO PL-WORK-EQP-NUM
                        MOVE DE-OLD-ZONE  TO PL-OLD-ZONE
                        MOVE DE-NEW-ZONE  TO PL-NEW-ZONE
                        MOVE DSET-WO-PLANNED TO PL-DATA-SET
                        PERFORM PRINT-DETAILS.
            PERFORM READ-WO-PLANNED-SERIALLY.


       FIND-ZONE-ON-WO-BASIC.
            MOVE DE-OLD-ZONE    TO  ZONE-PRI.
            MOVE SUB            TO  ZONE-NUMBER.
            MOVE ZONE-PRIORITY-VALUE TO ZONEPRTY OF WBFREC.
            MOVE 0              TO  COND-WORD.
            START WO-BASIC-FILE KEY = EXTERNALLY-DESCRIBED-KEY
                INVALID KEY    MOVE 17 TO COND-WORD.
            IF FILE-STATUS NOT = "00" MOVE 17 TO COND-WORD.
            IF  COND-WORD = ZERO
                MOVE "Y"        TO  ZONE-FOUND-FLAG
            ELSE
            MOVE "N"            TO  ZONE-FOUND-FLAG.

       READ-WO-BASIC-NEXT.
            MOVE 0 TO COND-WORD.
            READ WO-BASIC-FILE NEXT INTO WO-BASIC-BUFFER
                AT END    MOVE 15 TO COND-WORD.
            IF ZONEPRTY OF WBFREC NOT = ZONE-PRIORITY-VALUE
                MOVE 15 TO COND-WORD.
            IF FILE-STATUS NOT = "00" MOVE 15 TO COND-WORD.

       UPDATE-WO-BASIC-RECS.
            MOVE 0                TO COND-WORD.
            DELETE WO-BASIC-FILE RECORD
                INVALID KEY    MOVE 17 TO COND-WORD.
            IF FILE-STATUS NOT = "00" MOVE 17 TO COND-WORD.
            IF  COND-WORD = 0
                MOVE DE-NEW-ZONE  TO ZONE-PRI
                MOVE SUB          TO ZONE-NUMBER
                MOVE ZONE-PRIORITY-VALUE TO ZONE-PRIORITY
                PERFORM WRITE-WO-BASIC-FILE
                IF  COND-WORD = 0
                    MOVE WO-NUM       TO PL-WORK-EQP-NUM
                    MOVE DE-OLD-ZONE  TO PL-OLD-ZONE
                    MOVE DE-NEW-ZONE  TO PL-NEW-ZONE
                    MOVE DSET-WO-BASIC TO PL-DATA-SET
                    PERFORM PRINT-DETAILS.

            PERFORM  FIND-ZONE-ON-WO-BASIC.
            IF  ZONE-FOUND
                PERFORM READ-WO-BASIC-NEXT
            ELSE
                MOVE "Y"        TO  EXIT-FLAG.

       FIND-ZONE-ON-WO-OPEN-QUEUE.
            MOVE DE-OLD-ZONE    TO  ZONE-PRI.
            MOVE SUB            TO  ZONE-NUMBER.
            MOVE 0              TO  COND-WORD.
            MOVE ZONE-PRIORITY-VALUE TO ZONEPRTY OF WOQFREC.
            START WO-OPEN-QUEUE-FILE KEY = EXTERNALLY-DESCRIBED-KEY
                INVALID KEY    MOVE 17 TO COND-WORD.
            IF FILE-STATUS NOT = "00" MOVE 17 TO COND-WORD.
            IF  COND-WORD = ZERO
                IF CHAIN-LENG > 0
                   MOVE "Y"        TO  ZONE-FOUND-FLAG
                ELSE
                   MOVE "N"        TO  ZONE-FOUND-FLAG
            ELSE
                MOVE "N"           TO  ZONE-FOUND-FLAG.

       READ-WO-OPEN-QUEUE-NEXT.
            MOVE 0                 TO  COND-WORD.
            READ WO-OPEN-QUEUE-FILE NEXT INTO WO-OPEN-QUEUE-BUFFER
                AT END    MOVE 15 TO COND-WORD.
            IF ZONEPRTY OF WOQFREC NOT = ZONE-PRIORITY-VALUE
                MOVE 15 TO COND-WORD.
            IF FILE-STATUS NOT = "00" MOVE 15 TO COND-WORD.

       UPDATE-WO-OPEN-QUEUE-RECS.
            MOVE 0                TO COND-WORD.
            DELETE WO-OPEN-QUEUE-FILE RECORD
                INVALID KEY    MOVE 17 TO COND-WORD.
            IF FILE-STATUS NOT = "00" MOVE 17 TO COND-WORD.
            IF  COND-WORD = 0
                MOVE DE-NEW-ZONE  TO ZONE-PRI
                MOVE SUB          TO ZONE-NUMBER
                MOVE ZONE-PRIORITY-VALUE TO Q-ZONE-PRI
                PERFORM WRITE-WO-OPEN-QUEUE-FILE
                IF  COND-WORD = 0
                    MOVE Q-WO-NUM     TO PL-WORK-EQP-NUM
                    MOVE DE-OLD-ZONE  TO PL-OLD-ZONE
                    MOVE DE-NEW-ZONE  TO PL-NEW-ZONE
                    MOVE DSET-WO-OPEN-QUEUE TO PL-DATA-SET
                    PERFORM PRINT-DETAILS.

            PERFORM  FIND-ZONE-ON-WO-OPEN-QUEUE.
            IF  ZONE-FOUND
                PERFORM READ-WO-OPEN-QUEUE-NEXT
            ELSE
                MOVE "Y"        TO  EXIT-FLAG.

       FIND-ZONE-ON-EQP-HOT-CODE.
            MOVE DE-OLD-ZONE    TO  ZONE-PRI.
            MOVE SUB            TO  ZONE-NUMBER.
            MOVE 0              TO  COND-WORD.
            MOVE ZONE-PRIORITY-VALUE TO ZONEPRTY OF EHCFREC.
            START EQP-HOT-CODE-FILE KEY = EXTERNALLY-DESCRIBED-KEY
                INVALID KEY    MOVE 17 TO COND-WORD.
            IF FILE-STATUS NOT = "00" MOVE 17 TO COND-WORD.
            IF  COND-WORD = ZERO
                IF CHAIN-LENG > 0
                   MOVE "Y"        TO  ZONE-FOUND-FLAG
                ELSE
                   MOVE "N"        TO  ZONE-FOUND-FLAG
            ELSE
                MOVE "N"           TO  ZONE-FOUND-FLAG.

       READ-EQP-HOT-CODE-NEXT.
            MOVE 0                 TO  COND-WORD.
            READ EQP-HOT-CODE-FILE NEXT INTO EQP-HOT-CODE-BUFFER
                AT END    MOVE 15 TO COND-WORD.
            IF ZONEPRTY OF EHCFREC NOT = ZONE-PRIORITY-VALUE
                MOVE 15 TO COND-WORD.
            IF FILE-STATUS NOT = "00" MOVE 15 TO COND-WORD.

       UPDATE-EQP-HOT-CODE-RECS.
            MOVE 0                TO COND-WORD.
            DELETE EQP-HOT-CODE-FILE RECORD
                INVALID KEY   MOVE 17 TO COND-WORD.
            IF FILE-STATUS NOT = "00" MOVE 17 TO COND-WORD.
            IF  COND-WORD = 0
                MOVE DE-NEW-ZONE  TO ZONE-PRI
                MOVE SUB          TO ZONE-NUMBER
                MOVE ZONE-PRIORITY-VALUE TO HC-ZONE-PRTY
                PERFORM WRITE-EQP-HOT-CODE-FILE
                IF  COND-WORD = 0
                    MOVE Q-WO-NUM     TO PL-WORK-EQP-NUM
                    MOVE DE-OLD-ZONE  TO PL-OLD-ZONE
                    MOVE DE-NEW-ZONE  TO PL-NEW-ZONE
                    MOVE DSET-EQP-HOT-CODE TO PL-DATA-SET
                    PERFORM PRINT-DETAILS.

            PERFORM  FIND-ZONE-ON-EQP-HOT-CODE.
            IF  ZONE-FOUND
                PERFORM READ-EQP-HOT-CODE-NEXT
            ELSE
                MOVE "Y"        TO  EXIT-FLAG.

       FIND-ZONE-ON-NEWS-TABLE.
            MOVE DE-OLD-ZONE    TO  ZONE-PRI.
            MOVE SUB            TO  ZONE-NUMBER.
            MOVE ZONE-PRIORITY-VALUE TO ZONEPRTY OF NTFREC.
            MOVE 0              TO  COND-WORD.
            START NEWS-TABLE-FILE KEY = EXTERNALLY-DESCRIBED-KEY
                INVALID KEY    MOVE 17 TO COND-WORD.
            IF FILE-STATUS NOT = "00" MOVE 17 TO COND-WORD.
            IF  COND-WORD = ZERO
                MOVE "Y"        TO  ZONE-FOUND-FLAG
            ELSE
            MOVE "N"            TO  ZONE-FOUND-FLAG.

       READ-NEWS-TABLE-NEXT.
            MOVE 0                 TO  COND-WORD.
            READ NEWS-TABLE-FILE NEXT INTO NEWS-TABLE-BUFFER
                AT END    MOVE 15 TO COND-WORD.
            IF ZONEPRTY OF NTFREC NOT = ZONE-PRIORITY-VALUE
                MOVE 15 TO COND-WORD.
            IF FILE-STATUS NOT = "00" MOVE 15 TO COND-WORD.

       UPDATE-NEWS-TABLE-RECS.
            MOVE 0                TO COND-WORD.
            DELETE NEWS-TABLE-FILE RECORD
                INVALID KEY    MOVE 17 TO COND-WORD.
            IF FILE-STATUS NOT = "00" MOVE 17 TO COND-WORD.
            IF  COND-WORD = 0
                MOVE DE-NEW-ZONE  TO ZONE-PRI
                MOVE SUB          TO ZONE-NUMBER
                MOVE ZONE-PRIORITY-VALUE TO DIST-ZONE-PRTY
                PERFORM WRITE-NEWS-TABLE-FILE
                IF  COND-WORD = 0
                    MOVE Q-WO-NUM     TO PL-WORK-EQP-NUM
                    MOVE DE-OLD-ZONE  TO PL-OLD-ZONE
                    MOVE DE-NEW-ZONE  TO PL-NEW-ZONE
                    MOVE DSET-NEWS-TABLE TO PL-DATA-SET
                    PERFORM PRINT-DETAILS.

            PERFORM  FIND-ZONE-ON-NEWS-TABLE.
            IF  ZONE-FOUND
                PERFORM READ-NEWS-TABLE-NEXT
            ELSE
                MOVE "Y"        TO  EXIT-FLAG.

       FIND-ZONE-ON-WO-SCHEDULE.
            MOVE DE-OLD-ZONE    TO  ZONE-PRI.
            MOVE SUB            TO  ZONE-NUMBER.
            MOVE 0              TO  COND-WORD.
            MOVE ZONE-PRIORITY-VALUE TO ZONEPRTY OF WSFREC.
            START WO-SCHEDULE-FILE KEY = EXTERNALLY-DESCRIBED-KEY
                INVALID KEY    MOVE 17 TO COND-WORD.
            IF FILE-STATUS NOT = "00" MOVE 17 TO COND-WORD.
            IF  COND-WORD = ZERO
                MOVE "Y"        TO  ZONE-FOUND-FLAG
            ELSE
            MOVE "N"            TO  ZONE-FOUND-FLAG.

       READ-WO-SCHEDULE-NEXT.
            MOVE 0                 TO  COND-WORD.
            READ WO-SCHEDULE-FILE NEXT INTO WO-SCHEDULE-BUFFER
                AT END    MOVE 15 TO COND-WORD.
            IF ZONEPRTY OF WSFREC NOT = ZONE-PRIORITY-VALUE
                MOVE 15 TO COND-WORD.
            IF FILE-STATUS NOT = "00" MOVE 15 TO COND-WORD.

       UPDATE-WO-SCHEDULE-RECS.
            MOVE 0                TO COND-WORD.
            DELETE WO-SCHEDULE-FILE RECORD
                INVALID KEY    MOVE 17 TO COND-WORD.
            IF FILE-STATUS NOT = "00" MOVE 17 TO COND-WORD.
            IF  COND-WORD = 0
                MOVE DE-NEW-ZONE  TO ZONE-PRI
                MOVE SUB          TO ZONE-NUMBER
                MOVE ZONE-PRIORITY-VALUE TO SCHED-ZP
                PERFORM WRITE-WO-SCHEDULE-FILE
                IF  COND-WORD = 0
                    MOVE Q-WO-NUM     TO PL-WORK-EQP-NUM
                    MOVE DE-OLD-ZONE  TO PL-OLD-ZONE
                    MOVE DE-NEW-ZONE  TO PL-NEW-ZONE
                    MOVE DSET-WO-SCHEDULE TO PL-DATA-SET
                    PERFORM PRINT-DETAILS.

            PERFORM  FIND-ZONE-ON-WO-SCHEDULE.
            IF  ZONE-FOUND
                PERFORM READ-WO-SCHEDULE-NEXT
            ELSE
                MOVE "Y"        TO  EXIT-FLAG.


       FIND-ZONE-ON-PM-OPEN-QUEUE.
            MOVE DE-OLD-ZONE    TO  ZONE-PRI.
            MOVE SUB            TO  ZONE-NUMBER.
            MOVE 0              TO  COND-WORD.
            MOVE ZONE-PRIORITY-VALUE TO ZONEPRTY OF POQFREC.
            START PM-OPEN-QUEUE-FILE KEY = EXTERNALLY-DESCRIBED-KEY
                INVALID KEY    MOVE 17 TO COND-WORD.
            IF FILE-STATUS NOT = "00" MOVE 17 TO COND-WORD.
            IF  COND-WORD = ZERO
                MOVE "Y"        TO  ZONE-FOUND-FLAG
            ELSE
            MOVE "N"            TO  ZONE-FOUND-FLAG.

       READ-PM-OPEN-QUEUE-NEXT.
            MOVE 0                 TO  COND-WORD.
            READ PM-OPEN-QUEUE-FILE NEXT INTO PM-OPEN-QUEUE-BUFFER
                AT END    MOVE 15 TO COND-WORD.
            IF ZONEPRTY OF POQFREC NOT = ZONE-PRIORITY-VALUE
                MOVE 15 TO COND-WORD.
            IF FILE-STATUS NOT = "00" MOVE 15 TO COND-WORD.

       UPDATE-PM-OPEN-QUEUE-RECS.
            MOVE 0                TO COND-WORD.
            DELETE PM-OPEN-QUEUE-FILE RECORD
                INVALID KEY    MOVE 17 TO COND-WORD.
            IF FILE-STATUS NOT = "00" MOVE 17 TO COND-WORD.
            IF  COND-WORD = 0
                MOVE DE-NEW-ZONE  TO ZONE-PRI
                MOVE SUB          TO ZONE-NUMBER
                MOVE ZONE-PRIORITY-VALUE TO PMQ-ZONE-PRI
                PERFORM WRITE-PM-OPEN-QUEUE-FILE
                IF  COND-WORD = 0
                    MOVE Q-WO-NUM     TO PL-WORK-EQP-NUM
                    MOVE DE-OLD-ZONE  TO PL-OLD-ZONE
                    MOVE DE-NEW-ZONE  TO PL-NEW-ZONE
                    MOVE DSET-PM-OPEN-QUEUE TO PL-DATA-SET
                    PERFORM PRINT-DETAILS.

            PERFORM  FIND-ZONE-ON-PM-OPEN-QUEUE.
            IF  ZONE-FOUND
                PERFORM READ-PM-OPEN-QUEUE-NEXT
            ELSE
                MOVE "Y"        TO  EXIT-FLAG.

       DELETE-WO-ZONE-PRTY.
            MOVE DE-OLD-ZONE      TO ZONE-PRI.
            MOVE SUB              TO ZONE-NUMBER.
            MOVE ZONE-PRIORITY-VALUE TO ZONEPRTY OF WZPFREC.
            MOVE 0                TO COND-WORD.
            READ WO-ZONE-PRTY-FILE INTO WO-ZONE-PRTY-BUFFER
                INVALID KEY   MOVE 15 TO COND-WORD.
            IF FILE-STATUS NOT = "00" MOVE 15 TO COND-WORD.
            IF  COND-WORD = 0
                PERFORM DELETE-WO-ZONE-PRTY-RECORD
                IF  COND-WORD NOT = 0
                    DISPLAY "COULD NOT DELETE OLD ZONE MASTER RECORD"
                    DISPLAY COND-WORD
                    GOBACK.

       PRINT-DETAILS.
            ADD  2                 TO  WS-LINE-COUNTER.
            IF   WS-LINE-COUNTER  > 55
                 ADD    1          TO WS-PAGE-COUNTER
                 MOVE WS-PAGE-COUNTER TO PL-PAGE-NO
                 WRITE  PRINT-REC FROM HEADER-LINE AFTER NEW-PAGE
                 WRITE  PRINT-REC FROM UNDER-LINE AFTER 1
                 WRITE  PRINT-REC FROM FIELD-HEADER AFTER 1
                 WRITE  PRINT-REC FROM UNDER-LINE AFTER 1
                 MOVE  SPACES TO PRINT-REC
                 WRITE PRINT-REC
                 MOVE 5            TO WS-LINE-COUNTER.
            WRITE PRINT-REC FROM DETAIL-LINE AFTER 2.

       DELETE-WO-ZONE-PRTY-RECORD.
            MOVE 0 TO COND-WORD.
            DELETE WO-ZONE-PRTY-FILE RECORD
                INVALID KEY    MOVE 17 TO COND-WORD.
            IF FILE-STATUS NOT = "00" MOVE 17 TO COND-WORD.

       REWRITE-EQP-EQUIPMENT-FILE.
            MOVE 0 TO COND-WORD.
            REWRITE EEFREC FROM EQP-EQUIPMENT-BUFFER.
      *         INVALID KEY    MOVE 17 TO COND-WORD.
            IF FILE-STATUS NOT = "00" MOVE 17 TO COND-WORD.

       REWRITE-PER-PERSONNEL-FILE.
            MOVE 0 TO COND-WORD.
            REWRITE PPFREC FROM PER-PERSONNEL-BUFFER.
      *         INVALID KEY    MOVE 17 TO COND-WORD.
            IF FILE-STATUS NOT = "00" MOVE 17 TO COND-WORD.

       REWRITE-WO-PLANNED-FILE.
            MOVE 0 TO COND-WORD.
            REWRITE WPFREC FROM WO-PLANNED-BUFFER.
      *         INVALID KEY    MOVE 17 TO COND-WORD.
            IF FILE-STATUS NOT = "00" MOVE 17 TO COND-WORD.

       WRITE-EQP-HOT-CODE-FILE.
            MOVE 0 TO COND-WORD.
            WRITE EHCFREC FROM EQP-HOT-CODE-BUFFER
                INVALID KEY    MOVE 17 TO COND-WORD.
            IF FILE-STATUS NOT = "00" MOVE 17 TO COND-WORD.

       WRITE-NEWS-TABLE-FILE.
            MOVE 0 TO COND-WORD.
            WRITE NTFREC FROM NEWS-TABLE-BUFFER
                INVALID KEY    MOVE 17 TO COND-WORD.
            IF FILE-STATUS NOT = "00" MOVE 17 TO COND-WORD.

       WRITE-PM-OPEN-QUEUE-FILE.
            MOVE 0 TO COND-WORD.
            WRITE POQFREC FROM PM-OPEN-QUEUE-BUFFER
                INVALID KEY    MOVE 17 TO COND-WORD.
            IF FILE-STATUS NOT = "00" MOVE 17 TO COND-WORD.

       WRITE-WO-BASIC-FILE.
            MOVE 0 TO COND-WORD.
            WRITE WBFREC FROM WO-BASIC-BUFFER
                INVALID KEY    MOVE 17 TO COND-WORD.
            IF FILE-STATUS NOT = "00" MOVE 17 TO COND-WORD.

       WRITE-WO-OPEN-QUEUE-FILE.
            MOVE 0 TO COND-WORD.
            WRITE WOQFREC FROM WO-OPEN-QUEUE-BUFFER
                INVALID KEY    MOVE 17 TO COND-WORD.
            IF FILE-STATUS NOT = "00" MOVE 17 TO COND-WORD.

       WRITE-WO-SCHEDULE-FILE.
            MOVE 0 TO COND-WORD.
            WRITE WSFREC FROM WO-SCHEDULE-BUFFER
                INVALID KEY    MOVE 17 TO COND-WORD.
            IF FILE-STATUS NOT = "00" MOVE 17 TO COND-WORD.

       98-SCREEN-READ.
           READ DISPLAY-FILE FORMAT IS VIEW-CFNAME
               INDIC IS INDICS.
           ACCEPT IOFEEDBACK FROM I-O-FEEDBACK-AREA.
           MOVE ALL B"0" TO INDICS.
           IF DSPLY-STATUS NOT = "00"
               MOVE 3 TO VIEW-LASTKEY
           ELSE
           MOVE FUNCTION-NUM TO VIEW-LASTKEY.

       98A-SCREEN-READ.
           READ DISPLAY-FILE TERMINAL IS TERMINAL-ID
               INDIC IS INDICS
                  NO DATA MOVE DSPLY-STATUS TO DSPLY-STATUS.
           MOVE ALL B"0" TO INDICS.

       99-SCREEN-WRITE.
           WRITE DSPLY-REC FORMAT IS VIEW-CFNAME
               INDIC IS INDICS.
           MOVE ALL B"0" TO INDICS.

       2100-BLOWUP.
            MOVE "TZONTOBC" TO  BU-PGM-NAME.
            CALL "TBLOWUP"  USING MMISA-BASE, BU-PGM-NAME,
                                  STATUS-AREA, VIEW-COMAREA,
                                  DUMMY-KSAM-STAT, BU-DISPLAY-MSG,
                                  BU-DISPLAY-FLDS.
