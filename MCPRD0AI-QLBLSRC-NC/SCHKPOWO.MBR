000200 IDENTIFICATION DIVISION.
000300 PROGRAM-ID.    SCHKPOWO.
000500 AUTHOR.        KURT MOVSESIAN/JIM COFFMAN (MAINTAINER).
000700*REMARKS.
000800*
000900******************************************************
001000*                                                    *
001100*     S C H K P O W O                                *
001200*    SUBROUTINE FOR FINDING OUT IF A PARTICULAR      *
001300*    PURCHASE ORDER ITEM IS ASSOCIATED WITH A WORK   *
001400*    ORDER NUMBER.  IF A WORK ORDER IS FOUND THE     *
001500*    WORK ORDER NUMBER AN ITEM NUMBER ARE RETURNED.  *
001600*    THE DATA SET 'DREQD' IS USED TO FIND THE WORK   *
001700*    ORDER NUMBER WHICH MEANS THAT THE ITEM ON THE   *
001800*    PO MUST BE ON A REQUISITION.                    *
001900*                                                    *
002000******************************************************
002100
002200
002300 ENVIRONMENT DIVISION.
002400 CONFIGURATION SECTION.
002500 SOURCE-COMPUTER.  HP-3000.
002600 OBJECT-COMPUTER.  HP-3000.
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT DREQD-PO-I
               ASSIGN TO DATABASE-MCFLCS2102
               ORGANIZATION IS INDEXED
                 ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                 WITH DUPLICATES
               FILE STATUS IS FILE-STATUS.
002700
003000 DATA DIVISION.
       FILE SECTION.
      *------ IBM ONLY ------*
       FD  DREQD-PO-I
           LABEL RECORDS ARE STANDARD.
       01  DREQD-PO-REC-I.
           COPY DDS-MCRPCS2100  OF MCFLCS2102.

003200 WORKING-STORAGE SECTION.
       01 HANDLE-BLOWUP-FLAG      PIC X(1)  VALUE "Y".
003300
003400**************************************************************
003500**************************************************************
003600**                                                          **
003700**                DATABASE I/O BUFFER AREA                  **
003800**                                                          **
003900**************************************************************
004000**************************************************************
       COPY FILESTAT IN COPYLIB.
004100
004200 COPY DREQD IN COPYLIB.
004400 COPY DBMODES IN COPYLIB.
004500
005200 01  DSET-NAMES.
005300     05  DSET-DREQD               PIC X(16)  VALUE "DREQD;".
005400
005500 01  ITEMS-LISTING.
005600     05  ALL-ITEMS                PIC X(2)  VALUE "@;".
005700     05  PO-SEARCH                PIC X(10) VALUE "PO-RCV-NO;".
005800
005900 01  ARG-VALUES.
006000     05  PO-ARG                   PIC X(14) VALUE SPACES.
006100
006200 LINKAGE SECTION.
006400 01  BASE                         PIC X(10).
006500
006600***********************************
006700**  PARAMETERS FOR 'SCHKPOWO'
006800***********************************
006900
007000 COPY SCHKPOWO IN COPYLIB.
007200 COPY DBSTAT   IN COPYLIB.
       COPY BUMSG    IN COPYLIB.
007300
007800 01  BU-DISPLAY-FLDS.
007900     05  BU-DISPLAY-LINE  OCCURS 5 TIMES.
008000         10  BU-DISPLAY-FLD       PIC X(14).
008100         10  BU-DISPLAY-FLD9      PIC S9(8).
008200
008300
008400 PROCEDURE DIVISION USING BASE,
008500                          SCHKPOWO-PARMS,
008600                          STATUS-AREA,
008700                          BU-DISPLAY-MSG,
008800                          BU-DISPLAY-FLDS.
008900
009000 PROC-DIV SECTION 04.
009100
009200 BEGIN-HERE.
           PERFORM 9999-OPEN-STUFF.
009300     PERFORM 60-CHECK-FOR-WO-LINK  THRU 60-CFWL-X.
           PERFORM 9999-CLOSE-STUFF.
009400
009500     GOBACK.
009600
009700
009800******************************************************
009900**                                                  **
010000**   BLOWUP ROUTINE                                 **
010100**                                                  **
010200******************************************************
010300
010400 2100-BLOWUP.
010500     MOVE "SCHKPOWO"              TO BU-DISPLAY-FLD (5).
010600     MOVE SCHKPOWO-PO-NO          TO BU-DISPLAY-FLD (4).
010700     GOBACK.
010800
010900
011000 60-CHECK-FOR-WO-LINK.
011100     MOVE SPACES                  TO SCHKPOWO-WO-NO,
011200                                     SCHKPOWO-WO-ITEM,
011300                                     SCHKPOWO-REQ-NO,
011400                                     BUF-DREQD.
011500     IF SCHKPOWO-PO-NO = SPACES  OR
011600        SCHKPOWO-PO-ITEM = SPACES
011700         GO TO 60-CFWL-X
011800     ELSE
011900         MOVE SCHKPOWO-PO-NO      TO PO-ARG.
           PERFORM 9999-CHAINHD-DREQD-PO-I.
           IF NO-ENTRY
               GO TO 60-CFWL-X.
012800
012900     PERFORM 601-GET-DREQD  THRU 601-GD-X
013000         UNTIL END-OF-CHAIN OR
013100             DREQD-PO-ITM-NO = SCHKPOWO-PO-ITEM.
013200
013300 60-CFWL-X.
013400     EXIT.
013500
013600
013700 601-GET-DREQD.
           PERFORM 9999-GETNEXT-DREQD-PO-I.
014100     IF GOOD-CALL
014700         IF DREQD-PO-ITM-NO = SCHKPOWO-PO-ITEM
014800             MOVE DREQD-WO-NUMBER   TO SCHKPOWO-WO-NO
014900             MOVE DREQD-WO-ITM-NO   TO SCHKPOWO-WO-ITEM
015000             MOVE DREQD-REQ-NUMBER  TO SCHKPOWO-REQ-NO.
015100
015200 601-GD-X.
015300     EXIT.

       9999-OPEN-STUFF.
           OPEN INPUT DREQD-PO-I.

       9999-CLOSE-STUFF.
           CLOSE DREQD-PO-I.

       9999-CHAINHD-DREQD-PO-I.
           MOVE 0 TO COND-WORD.
           MOVE PO-ARG TO PORCVNO OF DREQD-PO-REC-I.
           START DREQD-PO-I KEY = PORCVNO OF DREQD-PO-REC-I
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF (FILE-STATUS NOT = "00") AND (FILE-STATUS-1 NOT = "2")
               MOVE 99 TO COND-WORD
               IF HANDLE-BLOWUP-FLAG = "Y"
                   MOVE "CHAINHD ERR 9999-CHAINHD-DREQD-PO-I"
                       TO BU-MSG-AREA
                   PERFORM 2100-BLOWUP.

       9999-GETNEXT-DREQD-PO-I.
           MOVE 0 TO COND-WORD.
           READ DREQD-PO-I NEXT INTO BUF-DREQD
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   MOVE 15 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD
                   IF HANDLE-BLOWUP-FLAG = "Y"
                       MOVE "GETNEXT ERR 9999-GETNEXT-DREQD-PO-I"
                           TO BU-MSG-AREA
                       PERFORM 2100-BLOWUP
                   END-IF
           ELSE
           IF PORCVNO OF DREQD-PO-REC-I NOT = PO-ARG
               MOVE 15 TO COND-WORD.

