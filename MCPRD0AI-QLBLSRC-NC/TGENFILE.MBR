000200 IDENTIFICATION DIVISION.
000300 PROGRAM-ID.          TGENFILE.
000400 AUTHOR.              C HILLES.
000500 DATE-WRITTEN.        01/09/91.
000600 DATE-COMPILED.
000700*INSTALLATION.        GOODYEAR TIRE AND RUBBER - AKRON.
000800*SECURITY.
000900*REMARKS.
001000*D   AUTOMATIC FILE GENERATION PROGRAM.  GIVEN THE FILENAME
001100*D   AND NUMBER OF GENERATIONS, DOES THE FOLLOWING:
001200*D     1.  MAKES SURE EACH FILE EXISTS.
001300*D     2.  DELETES LAST FILE AND RENAMES EACH FILE BACK ONE.     V

002400 ENVIRONMENT DIVISION.
002500 CONFIGURATION SECTION.
002600 SOURCE-COMPUTER.  HP-3000.
002700 OBJECT-COMPUTER.  HP-3000.
002800
002900 DATA DIVISION.
003000 WORKING-STORAGE SECTION.
       01  BUILD-NAME            PIC X(10).
       01  RENAME-FROM           PIC X(10).
       01  RENAME-TO             PIC X(10).
       01  GEN-COUNT             PIC 9(2).
       01  GEN-COUNT-SHORT       PIC 9(1).
       01  HOLD-STATUS           PIC X(2).
       01  SUB                   PIC S9(4) BINARY.
       01  SUB2                  PIC S9(4) BINARY.
       01  NUM-GENS-BINARY       PIC S9(4) BINARY.
       01  LONG-NAME-FLAG        PIC X(1).
       01  CORE-NAME-WORK        PIC X(8).

003100 LINKAGE SECTION.
       01  MAIN-NAME      PIC X(10).
       01  CORE-NAME.
           05  CORE-NAME-1-6  PIC X(6).
           05  CORE-NAME-7    PIC X(1).
           05  FILLER         PIC X(1).
       01  NUM-GENS       PIC X(2).
       01  LIBRARY-NAME   PIC X(10).
       01  RECORD-LENGTH  PIC 9(4).
       01  NO-RECORDS     PIC 9(5).
       01  INCREMENT-AMT  PIC 9(5).
       01  NO-INCREMENTS  PIC 9(2).
       01  RETURN-STATUS  PIC X(2).

007900 PROCEDURE DIVISION USING MAIN-NAME,
                                CORE-NAME,
                                NUM-GENS,
                                LIBRARY-NAME,
                                RECORD-LENGTH,
                                NO-RECORDS,
                                INCREMENT-AMT,
                                NO-INCREMENTS,
                                RETURN-STATUS.

008400
008500 6000-MAIN.
           IF CORE-NAME-7 > SPACES
               MOVE "Y"  TO LONG-NAME-FLAG
           ELSE
               MOVE "N"  TO LONG-NAME-FLAG.
           MOVE MAIN-NAME TO BUILD-NAME.
           PERFORM 9000-CALL-CCRTFILE.

           MOVE NUM-GENS TO NUM-GENS-BINARY.
           PERFORM VARYING SUB FROM 2 BY 1 UNTIL SUB > NUM-GENS-BINARY
               MOVE SUB TO GEN-COUNT
               MOVE SPACES TO BUILD-NAME
               PERFORM 9010-BUILD-NAME
               PERFORM 9000-CALL-CCRTFILE
           END-PERFORM.

           MOVE NUM-GENS TO GEN-COUNT.
           PERFORM 9010-BUILD-NAME.
           DISPLAY "****** DELETING ", BUILD-NAME, " ******".
           CALL "MCDLT" USING BUILD-NAME.

           PERFORM VARYING SUB FROM NUM-GENS-BINARY BY -1 UNTIL SUB < 2
               IF SUB = 2
                  MOVE MAIN-NAME TO RENAME-FROM
               ELSE
                  SUBTRACT 1 FROM SUB GIVING SUB2
                  MOVE SUB2 TO GEN-COUNT
                  PERFORM 9010-BUILD-NAME
                  MOVE BUILD-NAME TO RENAME-FROM
               END-IF
               MOVE SPACES TO RENAME-TO
               MOVE SUB TO GEN-COUNT
               PERFORM 9010-BUILD-NAME
               MOVE BUILD-NAME TO RENAME-TO
               DISPLAY "****** RENAMING ", RENAME-FROM, " TO ",
                 RENAME-TO, " ******"
               CALL "MCXRENAM" USING RENAME-FROM, RENAME-TO
           END-PERFORM.

012500 6990-MAIN-X.
012600     GOBACK.
012700
       9000-CALL-CCRTFILE.
           DISPLAY "****** CHECKING OR CREATING ",
             BUILD-NAME, " ******".
           CALL "CCRTFILE" USING LIBRARY-NAME,
                                 BUILD-NAME,
                                 RECORD-LENGTH,
                                 NO-RECORDS,
                                 INCREMENT-AMT,
                                 NO-INCREMENTS,
                                 HOLD-STATUS.

       9010-BUILD-NAME.
           MOVE SPACES     TO  BUILD-NAME.
           IF LONG-NAME-FLAG = "N"
               STRING CORE-NAME DELIMITED BY SPACES,
                      GEN-COUNT DELIMITED BY SIZE,
                  INTO BUILD-NAME
           ELSE
           IF GEN-COUNT < 10
               MOVE GEN-COUNT TO GEN-COUNT-SHORT
               STRING CORE-NAME DELIMITED BY SPACES,
                      GEN-COUNT-SHORT DELIMITED BY SIZE
                  INTO BUILD-NAME
           ELSE
               MOVE CORE-NAME-1-6 TO CORE-NAME-WORK
               STRING CORE-NAME-WORK DELIMITED BY SPACES,
                      GEN-COUNT DELIMITED BY SIZE
                  INTO BUILD-NAME.
