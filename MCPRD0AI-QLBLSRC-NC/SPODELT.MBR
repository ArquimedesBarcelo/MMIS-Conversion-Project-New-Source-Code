DCR02 *****************************************************
DCR02 *   MAKE SURE PO LOGGING IS TURNED ON FOR THIS PLANT
DCR02 *****************************************************
DCR02
DCR02      SET  Z000-POLG-ACTIVE-NO TO TRUE.
DCR02
DCR02      MOVE WS-Z000-POLG-KEY   TO PLT-ARG.
DCR02      MOVE PLT-ARG TO PLTINFOKEY OF MPLTINFO-REC-I.
DCR02      READ MPLTINFO-I INTO BUF-MPLTINFO.
DCR02      IF FILE-STATUS = "00"
DCR02         IF  PLTINFODTA OF MPLTINFO-REC-I(1:1) = "Y"
DCR02             SET  Z000-POLG-ACTIVE-YES TO TRUE
DCR02         END-IF
DCR02      END-IF.


           MOVE "P 00"                  TO  PLT-ARG.
           MOVE PLT-ARG TO PLTINFOKEY OF MPLTINFO-REC-I.
           READ MPLTINFO-I INTO BUF-MPLTINFO
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
038500         MOVE "GET MPLTINFO P 00"  TO  BU-DISPLAY-MSG
038600         GO TO 2-BLOWUP.
038700     MOVE MPLTINFO-DATA  TO  HDR2-DATA.

038800     MOVE "P 01"  TO  PLT-ARG.
           MOVE PLT-ARG TO PLTINFOKEY OF MPLTINFO-REC-I.
           READ MPLTINFO-I INTO BUF-MPLTINFO
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
039200         MOVE "GET MPLTINFO P 01"  TO  BU-DISPLAY-MSG
039300         GO TO 2-BLOWUP.

039400     MOVE MPLTINFO-COMPANY        TO  COMPANY-SAVE.
DCR02      MOVE MPLTINFO-COMPANY        TO  WS-Z000-PLANT-CODE.
039500     MOVE MPLTINFO-PLT-NAME       TO  HDR3-DATA.

039600     MOVE "P 10"                  TO  PLT-ARG.
           MOVE PLT-ARG TO PLTINFOKEY OF MPLTINFO-REC-I.
           READ MPLTINFO-I INTO BUF-MPLTINFO
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
040000         MOVE "GET MPLTINFO P 10"  TO  BU-DISPLAY-MSG
040100         GO TO 2-BLOWUP.
040200     MOVE MPLTINFO-DATA           TO  HDR4-DATA.
040300     MOVE "P 11"                  TO  PLT-ARG.
           MOVE PLT-ARG TO PLTINFOKEY OF MPLTINFO-REC-I.
           READ MPLTINFO-I INTO BUF-MPLTINFO
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
040700         MOVE "GET MPLTINFO P 11"  TO  BU-DISPLAY-MSG
040800         GO TO 2-BLOWUP.
040900     MOVE MPLTINFO-DATA           TO  HDR5-DATA.
041000
041100     MOVE   9                     TO LANG-SETNUM.
041200     MOVE  35                     TO LANG-MSGNUM.
041300     PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
041400     MOVE MESSAGE-BUFFER TO PO-ERR-AREA.
