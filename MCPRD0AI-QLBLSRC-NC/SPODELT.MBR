085700*                                        *
085800******************************************
085900
086000 63-LOAD-VENDOR-PRINT.
086100     MOVE ZERO                    TO  VEN-SUB.
086200     MOVE SPACES                  TO  BUILD-VENDOR-PRINT.
086300     MOVE PO-VEN-CODE1-7          TO  P-VENDOR-CD.
086400     MOVE PO-VEN-CODE8-10         TO  P-ORD-VEND.
086500     MOVE PO-VEN-CODE             TO  VEN-ARG.
           MOVE 0 TO COND-WORD.
           MOVE VEN-ARG TO VENCDE OF DVENDOR-REC-I.
           START DVENDOR-I KEY = VENCDE OF DVENDOR-REC-I
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
087000             GO TO 63-LVP-X
               ELSE
087200             MOVE "FIND DVENDOR 63-LVP" TO BU-DISPLAY-MSG
087300             GO TO 2-BLOWUP.
087400
087500 63-GET-DVENDOR-PRINT.
087600     ADD +1                       TO VEN-SUB.
           READ DVENDOR-I NEXT INTO BUF-DVENDOR
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14"
                   GO TO 63-LVP-X
               ELSE
088300             MOVE "GET DVENDOR 63-GDP" TO BU-DISPLAY-MSG
088400             GO TO 2-BLOWUP.
           IF VENCDE OF DVENDOR-REC-I NOT = VEN-ARG
               GO TO 63-LVP-X.
088500     IF VEN-ITM-NO = 7
088600         MOVE VEN-ZIP         TO BUILD-ZIP
088700         MOVE SPACES          TO VEN-ZIP.
088800     IF VEN-ITM-NO < 8
088900         MOVE VEN-ITM-DATA    TO ORDFRM-VEN-INFO (VEN-SUB)
089000         GO TO 63-GET-DVENDOR-PRINT.
089100     IF VEN-ITM-NO = 8
089200         MOVE VEN-COUNTRY     TO BUILD-COUNTRY
089300     ELSE
089400         MOVE SPACES          TO BUILD-COUNTRY.
089500     MOVE BUILD-COUNTRY-ZIP-LINE  TO ORDFRM-VEN-INFO (VEN-SUB).
089600
089700 63-LVP-X.
089800     EXIT.
