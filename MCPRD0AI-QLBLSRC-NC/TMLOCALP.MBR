       IDENTIFICATION DIVISION.
       PROGRAM-ID.             TMLOCALP.
       AUTHOR.                 W. ROXBURY.
       INSTALLATION.           GOODYEAR TIRE AND RUBBER, INC.
       DATE-COMPILED.
       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.
       SOURCE-COMPUTER.        IBM-AS400.
       OBJECT-COMPUTER.        IBM-AS400.

       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT DISPLAY-FILE
                  ASSIGN       TO WORKSTATION-ZMASTER-SI
                  ORGANIZATION IS TRANSACTION
                  ACCESS MODE  IS SEQUENTIAL
                  FILE STATUS  IS SCREEN-STATUS
                               MAJOR-MINOR
                  CONTROL-AREA IS SCREEN-CONTROL.

           SELECT LAST-WO-FILE1
                  ASSIGN       TO DATABASE-MCFPMM0800
                  ORGANIZATION IS RELATIVE
                  ACCESS MODE  IS RANDOM
                  RELATIVE KEY IS PFKEY
                  FILE STATUS  IS FILE-STAT.

           SELECT LAST-WO-FILE2
                  ASSIGN       TO DATABASE-MCFPMM0800
                  ORGANIZATION IS RELATIVE
                  ACCESS MODE  IS RANDOM
                  RELATIVE KEY IS PFKEY
                  FILE STATUS  IS FILE-STAT.

       DATA DIVISION.
       FILE SECTION.
       FD  DISPLAY-FILE
           LABEL RECORDS       ARE OMITTED.
       01  DISPLAY-REC         PIC X(2000).

       FD  LAST-WO-FILE1
           LABEL RECORDS       ARE STANDARD.
       01  LAST-WO-REC1.
           COPY DDS-ALL-FORMATS OF MCFPMM0800.

       FD  LAST-WO-FILE2
           LABEL RECORDS       ARE STANDARD.
       01  LAST-WO-REC2.
           COPY DDS-ALL-FORMATS OF MCFPMM0800.

       WORKING-STORAGE SECTION.
       77  TRUE-VAL            PIC 1 VALUE B"1".
       77  PFKEY               PIC 9(8).

       01  PASSWORD-INFORMATION.
           05  NAME-OF-PROGRAM PIC X(08) VALUE "TMLOCALP".
           05  PROGRAM-TYPE    PIC X(02) VALUE "MA".
           05  PROGRAM-RELEASE PIC X(12) VALUE " K0100010001".
           05  PROGRAM-DESCRIPTION.
               10  PROG-DESC-A.
                   15  FILLER  PIC X(15) VALUE "MAINTAIN PLANT ".
                   15  FILLER  PIC X(13) VALUE "NUMBER, DATE-".
                   15  FILLER  PIC X(10) VALUE "CODE, AND ".
                   15  FILLER  PIC X(15) VALUE "SYSTEM SWITCHES".
                   15  FILLER  PIC X(07) VALUE " IN THE".
               10  PROG-DESC-B PIC X(60) VALUE "MMIS DATABASE." .
               10  PROG-FUNC   PIC X(60) VALUE SPACES.
           05  PASSWORD-FLAG   PIC X.

       01  FILE-STAT.
           05  FILE-STAT-1     PIC X  VALUE "0".
           05  FILE-STAT-2     PIC X  VALUE "0".

       01  SCREEN-DATA.
           05  PLNT-CODE-BUF   PIC XXXX.
           05  DATE-CODE-BUF   PIC 9.
           05  A-SW-BUF        PIC X.
           05  B-SW-BUF        PIC X.
           05  C-SW-BUF        PIC X.
           05  D-SW-BUF        PIC X.
           05  E-SW-BUF        PIC X.
           05  F-SW-BUF        PIC X.
           05  G-SW-BUF        PIC X.
           05  H-SW-BUF        PIC X.
           05  I-SW-BUF        PIC X.
           05  J-SW-BUF        PIC X.
           05  K-SW-BUF        PIC X.
           05  L-SW-BUF        PIC X.
           05  M-SW-BUF        PIC X.
           05  N-SW-BUF        PIC X.
           05  P-SW-BUF        PIC X.
           05  SCREEN-MSGS.
               10  CMDMSG      PIC X(79).
               10  ERRMSG      PIC X(79).

       01  ERROR-BUFFER        PIC X(80).

       COPY SCREENIO           OF COPYLIB.

       01  LAST-WO-BUF1.       COPY MLASTWO IN COPYLIB.

       01  LAST-WO-BUF2.       COPY MLASTWO IN COPYLIB.

       PROCEDURE DIVISION.
       OPEN-PAR.
           OPEN I-O            DISPLAY-FILE.
           OPEN I-O            LAST-WO-FILE2.
           OPEN INPUT          LAST-WO-FILE1.

           CALL "TPWORD"       USING PASSWORD-INFORMATION.
           IF PASSWORD-FLAG = "N"
               GO TO END-OF-JOB.

           MOVE "LOCALSW"      TO SCREEN-NAME.
           MOVE SPACES         TO SCREEN-DATA.
           PERFORM LOAD-SCREEN.

       SHOW-SCREEN.
           MOVE  SCREEN-DATA   TO DISPLAY-REC.

           MOVE "00"           TO SCREEN-STATUS.
           WRITE DISPLAY-REC   FORMAT IS SCREEN-NAME
                               INDIC ARE SCREEN-INDICATORS.
           IF SCREEN-STATUS NOT = "00"
               DISPLAY "SCREEN WRITE ERROR.  SCREEN-STATUS IS "
                               SCREEN-STATUS
               GO TO END-OF-JOB.

           READ  DISPLAY-FILE  FORMAT IS SCREEN-NAME
                               INDIC ARE SCREEN-INDICATORS
           IF SCREEN-STATUS NOT = "00"
               DISPLAY "SCREEN READ ERROR.  SCREEN-STATUS IS "
                               SCREEN-STATUS
               GO TO END-OF-JOB.

           MOVE DISPLAY-REC    TO SCREEN-DATA.
           MOVE ALL B"0"       TO SCREEN-INDICATORS.

           IF KEY-HIT = 3
               GO TO END-OF-JOB.

           IF KEY-HIT NOT = 0
               GO TO SHOW-SCREEN.

           IF PLNT-CODE-BUF = SPACES
             MOVE " PLANT CODE MUST BE ENTERED"
                               TO ERRMSG
             MOVE TRUE-VAL     TO IND(10) IND(99)
             GO TO SHOW-SCREEN.

           IF DATE-CODE-BUF = "1" OR "3"
             NEXT SENTENCE
           ELSE
             MOVE " DATE FLAG MUST BE 1 (MONTH/DAY/YEAR) OR 3 (DAY/MONTH
      -      "/YEAR)"          TO ERRMSG
             MOVE TRUE-VAL     TO IND(20) IND(99)
             GO TO SHOW-SCREEN.

           IF A-SW-BUF = " " OR "O"
             NEXT SENTENCE
           ELSE
             MOVE " ENTER 'O' TO TURN A SWITCH ON OR LEAVE BLANK"
                               TO ERRMSG
             MOVE TRUE-VAL     TO IND(30) IND(99)
             GO TO SHOW-SCREEN.

           IF B-SW-BUF = " " OR "O"
             NEXT SENTENCE
           ELSE
             MOVE " ENTER 'O' TO TURN A SWITCH ON OR LEAVE BLANK"
                               TO ERRMSG
             MOVE TRUE-VAL     TO IND(31) IND(99)
             GO TO SHOW-SCREEN.

           IF C-SW-BUF = " " OR "O"
             NEXT SENTENCE
           ELSE
             MOVE " ENTER 'O' TO TURN A SWITCH ON OR LEAVE BLANK"
                               TO ERRMSG
             MOVE TRUE-VAL     TO IND(32) IND(99)
             GO TO SHOW-SCREEN.

           IF D-SW-BUF = " " OR "O"
             NEXT SENTENCE
           ELSE
             MOVE " ENTER 'O' TO TURN A SWITCH ON OR LEAVE BLANK"
                               TO ERRMSG
             MOVE TRUE-VAL     TO IND(33) IND(99)
             GO TO SHOW-SCREEN.

           IF E-SW-BUF = " " OR "O"
             NEXT SENTENCE
           ELSE
             MOVE " ENTER 'O' TO TURN A SWITCH ON OR LEAVE BLANK"
                               TO ERRMSG
             MOVE TRUE-VAL     TO IND(34) IND(99)
             GO TO SHOW-SCREEN.

           IF F-SW-BUF = " " OR "O"
             NEXT SENTENCE
           ELSE
             MOVE " ENTER 'O' TO TURN A SWITCH ON OR LEAVE BLANK"
                               TO ERRMSG
             MOVE TRUE-VAL     TO IND(35) IND(99)
             GO TO SHOW-SCREEN.

           IF G-SW-BUF = " " OR "O"
             NEXT SENTENCE
           ELSE
             MOVE " ENTER 'O' TO TURN A SWITCH ON OR LEAVE BLANK"
                               TO ERRMSG
             MOVE TRUE-VAL     TO IND(36) IND(99)
             GO TO SHOW-SCREEN.

           IF H-SW-BUF = " " OR "O"
             NEXT SENTENCE
           ELSE
             MOVE " ENTER 'O' TO TURN A SWITCH ON OR LEAVE BLANK"
                               TO ERRMSG
             MOVE TRUE-VAL     TO IND(37) IND(99)
             GO TO SHOW-SCREEN.

           IF I-SW-BUF = " " OR "O"
             NEXT SENTENCE
           ELSE
             MOVE " ENTER 'O' TO TURN A SWITCH ON OR LEAVE BLANK"
                               TO ERRMSG
             MOVE TRUE-VAL     TO IND(38) IND(99)
             GO TO SHOW-SCREEN.

           IF J-SW-BUF = " " OR "O"
             NEXT SENTENCE
           ELSE
             MOVE " ENTER 'O' TO TURN A SWITCH ON OR LEAVE BLANK"
                               TO ERRMSG
             MOVE TRUE-VAL     TO IND(39) IND(99)
             GO TO SHOW-SCREEN.

           IF K-SW-BUF = " " OR "O"
             NEXT SENTENCE
           ELSE
             MOVE " ENTER 'O' TO TURN A SWITCH ON OR LEAVE BLANK"
                               TO ERRMSG
             MOVE TRUE-VAL     TO IND(40) IND(99)
             GO TO SHOW-SCREEN.

           IF L-SW-BUF = " " OR "O"
             NEXT SENTENCE
           ELSE
             MOVE " ENTER 'O' TO TURN A SWITCH ON OR LEAVE BLANK"
                               TO ERRMSG
             MOVE TRUE-VAL     TO IND(41) IND(99)
             GO TO SHOW-SCREEN.

           IF M-SW-BUF = " " OR "O"
             NEXT SENTENCE
           ELSE
             MOVE " ENTER 'O' TO TURN A SWITCH ON OR LEAVE BLANK"
                               TO ERRMSG
             MOVE TRUE-VAL     TO IND(42) IND(99)
             GO TO SHOW-SCREEN.

           IF N-SW-BUF = " " OR "O"
             NEXT SENTENCE
           ELSE
             MOVE " ENTER 'O' TO TURN A SWITCH ON OR LEAVE BLANK"
                               TO ERRMSG
             MOVE TRUE-VAL     TO IND(43) IND(99)
             GO TO SHOW-SCREEN.

           IF P-SW-BUF = " " OR "O"
             NEXT SENTENCE
           ELSE
             MOVE " ENTER 'O' TO TURN A SWITCH ON OR LEAVE BLANK"
                               TO ERRMSG
             MOVE TRUE-VAL     TO IND(44) IND(99)
             GO TO SHOW-SCREEN.

           READ LAST-WO-FILE2  INTO LAST-WO-BUF2
            INVALID KEY
             GO TO END-OF-JOB.

           MOVE PLNT-CODE-BUF  TO PLANT-IDENT  OF LAST-WO-BUF2.
           MOVE DATE-CODE-BUF  TO DATE-FLAG-SW OF LAST-WO-BUF2.
           MOVE A-SW-BUF       TO A-SWITCH     OF LAST-WO-BUF2.
           MOVE B-SW-BUF       TO B-SWITCH     OF LAST-WO-BUF2.
           MOVE C-SW-BUF       TO C-SWITCH     OF LAST-WO-BUF2.
           MOVE D-SW-BUF       TO D-SWITCH     OF LAST-WO-BUF2.
           MOVE E-SW-BUF       TO E-SWITCH     OF LAST-WO-BUF2.
           MOVE F-SW-BUF       TO F-SWITCH     OF LAST-WO-BUF2.
           MOVE G-SW-BUF       TO G-SWITCH     OF LAST-WO-BUF2.
           MOVE H-SW-BUF       TO H-SWITCH     OF LAST-WO-BUF2.
           MOVE I-SW-BUF       TO I-SWITCH     OF LAST-WO-BUF2.
           MOVE J-SW-BUF       TO J-SWITCH     OF LAST-WO-BUF2.
           MOVE K-SW-BUF       TO K-SWITCH     OF LAST-WO-BUF2.
           MOVE L-SW-BUF       TO L-SWITCH     OF LAST-WO-BUF2.
           MOVE M-SW-BUF       TO M-SWITCH     OF LAST-WO-BUF2.
           MOVE N-SW-BUF       TO N-SWITCH     OF LAST-WO-BUF2.
           MOVE P-SW-BUF       TO P-SWITCH     OF LAST-WO-BUF2.

           REWRITE LAST-WO-REC2 FROM LAST-WO-BUF2
            INVALID KEY        GO TO END-OF-JOB.

           PERFORM LOAD-SCREEN.
           GO TO SHOW-SCREEN.

       LOAD-SCREEN.
           MOVE 1              TO PFKEY.
           READ LAST-WO-FILE1  INTO LAST-WO-BUF1
            INVALID KEY        GO TO END-OF-JOB.

           MOVE PLANT-IDENT    OF LAST-WO-BUF1 TO PLNT-CODE-BUF.
           MOVE DATE-FLAG-SW   OF LAST-WO-BUF1 TO DATE-CODE-BUF.
           MOVE A-SWITCH       OF LAST-WO-BUF1 TO A-SW-BUF.
           MOVE B-SWITCH       OF LAST-WO-BUF1 TO B-SW-BUF.
           MOVE C-SWITCH       OF LAST-WO-BUF1 TO C-SW-BUF.
           MOVE D-SWITCH       OF LAST-WO-BUF1 TO D-SW-BUF.
           MOVE E-SWITCH       OF LAST-WO-BUF1 TO E-SW-BUF.
           MOVE F-SWITCH       OF LAST-WO-BUF1 TO F-SW-BUF.
           MOVE G-SWITCH       OF LAST-WO-BUF1 TO G-SW-BUF.
           MOVE H-SWITCH       OF LAST-WO-BUF1 TO H-SW-BUF.
           MOVE I-SWITCH       OF LAST-WO-BUF1 TO I-SW-BUF.
           MOVE J-SWITCH       OF LAST-WO-BUF1 TO J-SW-BUF.
           MOVE K-SWITCH       OF LAST-WO-BUF1 TO K-SW-BUF.
           MOVE L-SWITCH       OF LAST-WO-BUF1 TO L-SW-BUF.
           MOVE M-SWITCH       OF LAST-WO-BUF1 TO M-SW-BUF.
           MOVE N-SWITCH       OF LAST-WO-BUF1 TO N-SW-BUF.
           MOVE P-SWITCH       OF LAST-WO-BUF1 TO P-SW-BUF.

       END-OF-JOB.
           CLOSE               DISPLAY-FILE.
           CLOSE               LAST-WO-FILE2.
           CLOSE               LAST-WO-FILE1.
           GOBACK.

