      *        MOVE "DEPT  "    TO TOTAL-LIT1, TOTAL-LIT2
      *        MOVE "DEPTS    " TO GRAND-TOT-LIT
      *        MOVE DEPT-PAGE   TO CLASS-OUT, CLASS-OUT1
      *    ELSE
      *    MOVE "CLASS "        TO TOTAL-LIT1, TOTAL-LIT2
      *    MOVE "CLASSES  "     TO GRAND-TOT-LIT
088600*    MOVE CLASS-PAGE      TO CLASS-OUT CLASS-OUT1.

088700     MOVE WS-GRAND-TOT    TO GRAND-OUT.
088800     MOVE SPACES          TO PRINT-LINE.
088900     MOVE TOTAL-ITEMS-CLASS TO TOTAL-ITEMS-CLASS-OUT.
089000     MOVE 0                 TO TOTAL-ITEMS-CLASS.
089100*    IF R11-INV-OPTION = "3"
           IF MTLS-TOT-VAL = "X"
089200         WRITE PRINT-RCD FROM TOTAL-LINE-HDR
089300           AFTER ADVANCING 1 LINES
089400     ELSE
               MOVE SPACES TO PRINT-LINE
               WRITE PRINT-RCD
                   AFTER ADVANCING 1 LINE
089500         WRITE PRINT-RCD  FROM TOTAL-LINE-HDR
089600             BEFORE ADVANCING 2 LINES.
089700     ADD WS-GRAND-TOT     TO INVENT-GRAND-TOT.
089800     MOVE ZEROS           TO WS-GRAND-TOT.
089900
090000**************************************************************
090100**   IF PRINTING TOTALS ONLY, WE WANT TO ADD TO THE LINE    **
090200**   COUNTER HERE.                                          **
090300**************************************************************
090400
090500*    IF R11-INV-OPTION = "3"
           IF MTLS-TOT-VAL = "X"
090600         ADD 1 TO ITMS-PER-PAGE.
090700
