000200 IDENTIFICATION DIVISION.
000300 PROGRAM-ID.          CEAAPPRV.
000400 AUTHOR.              C HILLES/JIM COFFMAN (MAINTAINER).
000500 DATE-WRITTEN.        10/21/87.
000600 DATE-COMPILED.
000700*INSTALLATION.        GOODYEAR TIRE AND RUBBER - AKRON.
000800*SECURITY.
000900*REMARKS.
001000*D   ELECTRONIC REQUISITION APPROVALS - APPROVE A REQ SUBPROGRAM.
001100*D   APPROVING REQ FOR AN APPROVER CONSISTS OF UPDATING THE APPRV
001200*D   DATE IN DREQQUE DATASET FOR THAT REQ FOR THAT APPROVER, AND
001300*D   SUBTRACTING FROM THE TOTAL NUYMBER OF APPROVALS LEFT IN THE
001400*D   MREQ DATASET.  NOTE: CALLING PROGRAM MUST HAVE ALREADY GOT
001500*D   THE DREQQUE AND MREQ ENTRIES.  THE SUBPROG WILL DO LOCKING.
      *D
      *D   5/10/94 JEC COFFMAN ADDED THE ABILITY TO UPDATE THE APPROVER
      *D     BUCKETS IN THE MEMPL DATASET IF THE GLOBAL REQUISITIONS
      *D     SWITCH TO DISPLAY APPROVED AMOUNTS WAS TURNED ON.
      *C
      *C   8/14/96  JEFF BUNGO
      *C     EXPAND DATE FIELDS FOR YEAR 2000 COMPLIANCE.
      *C     INCLUDE CENTURY FOR RELEASE TO MAT CONT DATE.
      *C
      *C  11/24/97  JEFF BUNGO
      *C     ADDED CODE TO WRITE A RECORD TO MCORPREQ FILE WHEN THE
      *C     USER HAS IDENTIFIED THE REQUISITION TO GO TO CORPORATE
      *C     PURCHASING THROUGH MA2 AND THE LAST APPROVAL APPROVES
      *C     THE REQUISITION.
      *C
      *C  NOVEMBER 1999 JE COFFMAN
      *C     ADDED CODE TO WRITE A RECORD TO MCORPREQ FILE IF THE
      *C     PLANT IS UPLOADING REQUISITION INFORMATION TO R/3 AT
      *C     THE MAINFRAME.
      *C
001600
001700 ENVIRONMENT DIVISION.
001800 CONFIGURATION SECTION.
001900 SOURCE-COMPUTER.  HP-3000.
002000 OBJECT-COMPUTER.  HP-3000.
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT DREQQUE-O
                  ASSIGN TO DATABASE-MCFLCS4401
                  ORGANIZATION IS INDEXED
                    ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                    WITH DUPLICATES
                  FILE STATUS IS FILE-STATUS.

           SELECT MEMPL-O
                  ASSIGN TO DATABASE-MCFLCS4201
                  ORGANIZATION IS INDEXED
                    ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                  FILE STATUS IS FILE-STATUS.

           SELECT MPLTINFO-I
                  ASSIGN TO DATABASE-MCFLCS0501
                  ORGANIZATION IS INDEXED
                    ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                  FILE STATUS IS FILE-STATUS.

           SELECT MREQ-O
                  ASSIGN TO DATABASE-MCFLCS2001
                  ORGANIZATION IS INDEXED
                    ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                  FILE STATUS IS FILE-STATUS.

           SELECT MCORPREQ-O
                  ASSIGN TO DATABASE-MCFLCS5701
                  ORGANIZATION IS INDEXED
                    ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                  FILE STATUS IS FILE-STATUS.

002100
002200 DATA DIVISION.
       FILE SECTION.
       FD  DREQQUE-O
           LABEL RECORDS ARE STANDARD.
       01  DREQQUE-REC-O.
           COPY DDS-MCRPCS4400  OF MCFLCS4401.

       FD  MEMPL-O
           LABEL RECORDS ARE STANDARD.
       01  MEMPL-REC-O.
           COPY DDS-MCRPCS4200  OF MCFLCS4201.

       FD  MPLTINFO-I
           LABEL RECORDS ARE STANDARD.
       01  MPLTINFO-I-REC.
           COPY DDS-MCRPCS0500  OF MCFLCS0501.

       FD  MREQ-O
           LABEL RECORDS ARE STANDARD.
       01  MREQ-REC-O.
           COPY DDS-MCRPCS2000  OF MCFLCS2001.

       FD  MCORPREQ-O
           LABEL RECORDS ARE STANDARD.
       01  MCORPREQ-REC-O.
           COPY DDS-ALL-FORMATS  OF MCFLCS5701.

002300 WORKING-STORAGE SECTION.
002400 77  SAVE-EMPL-QUEUED              PIC X(4).
002500 77  SAVE-REC-NO                   PIC S9(9) COMP-4.
002600 77  FIRST-TIME-FLAG               PIC X(1).
002700 77  REQ-SEARCH                    PIC X(16) VALUE "REQ-NUMBER;".
       77  SAVE-SYNR3-SW                 PIC X.
002800
002900**************************************************************
003000**                                                          **
003100**            D A T A B A S E   W O R K                     **
003200**                                                          **
003300**************************************************************
       01  FILE-STATUS.
           05  FILE-STATUS-1            PIC X  VALUE "0".
           05  FILE-STATUS-2            PIC X  VALUE "0".
003400
003500 01  DSET-NAMES.
003600     05  DSET-NAME                 PIC X(16) VALUE SPACES.
           05  DSET-MEMPL                PIC X(16) VALUE "MEMPL;".
003700     05  DSET-MREQ                 PIC X(16) VALUE "MREQ;".
003800     05  DSET-DREQQUE              PIC X(16) VALUE "DREQQUE;".
003900
004000 01  MODE-AREA.
004100     05  DB-MODE                   PIC S9(4)   COMP       VALUE 0.
004200     05  MODE1                     PIC S9(4)   COMP       VALUE 1.
004300     05  MODE2                     PIC S9(4)   COMP       VALUE 2.
004400     05  MODE3                     PIC S9(4)   COMP       VALUE 3.
004500     05  MODE4                     PIC S9(4)   COMP       VALUE 4.
004600     05  MODE5                     PIC S9(4)   COMP       VALUE 5.
004700     05  MODE7                     PIC S9(4)   COMP       VALUE 7.
004800
004900 01  ALL-ITEMS                     PIC X(2)  VALUE "@;".
005000
006600******************************************************************
006700**                                                              **
006800**          S U B P R O G R A M   A R E A S                     **
006900**                                                              **
007000******************************************************************
007100 COPY TDATECHK   IN COPYLIB.
007200 COPY CEAQNEXT   IN COPYLIB.
007300 COPY CEASTCHG   IN COPYLIB.

       COPY MEMPL      IN COPYLIB.
       COPY MCORPREQ   IN COPYLIB.
       COPY MPLT0      IN COPYLIB.
       COPY MPLTPREQ   IN COPYLIB.
007400
007500**************************************************************
007600**                                                          **
007700**            L I N K A G E   S E C T I O N                 **
007800**                                                          **
007900**************************************************************
008000
008100 LINKAGE SECTION.
008200 01  BASE                          PIC X(10).
008300 01  BASE-MMISA                    PIC X(24).
008400 01  BASE-BUDGET                   PIC X(24).
008500 COPY DBSTAT     IN COPYLIB.
008600 COPY MREQ       IN COPYLIB.
008700 COPY DREQQUE    IN COPYLIB.
008800 COPY REQGLOBS   IN COPYLIB.
008900 01  EAPP-PARMS.
           05  EAPP-DATA.
               10  EAPP-CC               PIC X(4).
               10  EAPP-DAILY-AMT        PIC Z(7)9.
               10  EAPP-WEEKS-AMT        PIC Z(7)9.
               10  EAPP-TOTAL-AMT        PIC Z(7)9.
           05  FILLER                    PIC XX.
009000 01  BU-DISPLAY-MSG.
009100     05  BU-DISPLAY-MSG-1          PIC X(1).
009200     05  FILLER                    PIC X(57).
           05  BU-DISPLAY-MSG-59-60      PIC X(2).
009300
009400 PROCEDURE DIVISION USING          BASE,
009500                                   BASE-MMISA,
009600                                   BASE-BUDGET,
009700                                   STATUS-AREA,
009800                                   BUF-MREQ,
009900                                   BUF-DREQQUE,
010000                                   REQ-GLOBALS,
010100                                   EAPP-PARMS,
010200                                   BU-DISPLAY-MSG.
010300
010400 6000-MAIN.
010500
           OPEN I-O DREQQUE-O, MEMPL-O, MREQ-O, MCORPREQ-O.
           OPEN INPUT MPLTINFO-I.
           MOVE SPACES TO SAVE-EMPL-QUEUED.
010800
      *------ RETRIEVE SWITCH FROM 'PREQ' RECORD IN MPLTINFO WHICH
      *------ TELLS US WHETHER THE PLANT IS UPLOADING REQUISITION
      *------ INFORMATION TO SYNERGY R/3 AT THE MAINFRAME.
           MOVE "N" TO SAVE-SYNR3-SW.
           MOVE "PREQ" TO PLTINFOKEY OF MPLTINFO-I-REC.
           READ MPLTINFO-I INTO BUF-MPLTINFO
               INVALID KEY    MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS = "00"
               MOVE MPLTINFO-REQ-SYNR3-SW TO SAVE-SYNR3-SW.
011400*------ CHANGE THE 'DREQQUE' ENTRY TO SHOW IT HAS BEEN APPROVED
011500*------ BY PUTTING IN APPROVAL DATE.  THE 'X ' STATUS TAKES IT
011600*------ OUT OF THE UNAPPROVED CHAIN FOR THAT APPROVER AND
011700*------ ORIGINATOR (MASTERS: AEMPLSTQ, AEMPLSTO).  NOTE: EVEN
011800*------ THOUGH THE REQ STATUS IS STILL UNAPPROVED, WE CHANGE
011900*------ THE 'DREQQUE' EMPL/STATUS COMBINATION KEY TO 'X' TO TAKE
012000*------ IT OUT OF THE UNAPPROVED CHAIN.  THIS MAKES THE APPROVAL
012100*------ PROGRAM RUN MUCH FASTER.
012200*    CALL "DBDELETE" USING BASE, DSET-DREQQUE, MODE1,
012300*      STATUS-AREA.
012900     MOVE "X "                     TO   DRQQ-EQ-ST,
013000                                        DRQQ-EO-ST.
013100
013200     MOVE 1                        TO   DATE-MODE.
013300     CALL "TDATECHK" USING DATE-CHECK-AREA.
013400     MOVE DATE-YMD-OUT             TO   DRQQ-APPROVE-DATE.
           IF DRQQ-APPROVE-DATE-YY > "70"
               MOVE "19"                 TO   DRQQ-APPROVE-DATE-CC
           ELSE
           MOVE "20"                     TO   DRQQ-APPROVE-DATE-CC.
013500
013600*    CALL "DBPUT" USING  BASE, DSET-DREQQUE, MODE1,
013700*      STATUS-AREA, ALL-ITEMS, BUF-DREQQUE.
           MOVE DRQQ-REQ-NUMBER TO REQNO OF DREQQUE-REC-O.
           MOVE DRQQ-ORDER      TO QUEORDER OF DREQQUE-REC-O.
           READ DREQQUE-O
               INVALID KEY MOVE 17 TO COND-WORD.
           IF FILE-STATUS NOT = "00"
               MOVE "CEAAPPRV RE-READ DREQQUE ERR" TO BU-DISPLAY-MSG
               GO TO 6990-MAIN-X.
           MOVE DRQQ-EMPL-QUEUED TO SAVE-EMPL-QUEUED.
           REWRITE DREQQUE-REC-O FROM BUF-DREQQUE
               INVALID KEY MOVE 99 TO COND-WORD.
           IF FILE-STATUS NOT = "00"
013900         MOVE "CEAAPPRV REWRITE DREQQUE"
014000                                   TO   BU-DISPLAY-MSG
014100         GO TO 6990-MAIN-X.

014200
014300*------ NOW THAT WE HAVE APPROVED THIS ENTRY, QUEUE UP THE REQ TO
014400*------ THE NEXT APPROVERS.  SEE 'CEAQNEXT' FOR FULL EXPLANATION
014500*------ OF THIS PROCESS. NOTE: THE ENTRIES ALREADY EXIST IN
014600*------ 'DREQQUE', BUT THE 'QUEUED-DATE' IS UPDATED FROM SPACES.
014700*------ NOTE: THE SUBPROG NEED THE CURRENT 'DREQQUE' RECORD
014800*------ ADDRESS (RETURNED FROM ABOVE DBUPDATE) SO IT CAN RE-GET
014900*------ THE RECORD AFTER CHAINING THRU DREQQUE.
015000     MOVE REC-NO                   TO   QNEXT-REC-NO.
015100     CALL "CEAQNEXT" USING         BASE,
015200                                   STATUS-AREA,
015300                                   REQ-GLOBALS,
015400                                   BUF-MREQ,
015500                                   BUF-DREQQUE,
015600                                   QNEXT-PARMS,
015700                                   BU-DISPLAY-MSG.
015800     IF BU-DISPLAY-MSG-1 NOT = SPACES
015900         GO TO 6990-MAIN-X.
016000
      *------ NOTE!!! CEAQNEXT WILL SET THE CORRECT NUM OF APP LEFT.
016700*------ IF THIS IS THE LAST APPROVAL, RELEASE THE REQ TO PURCH.
016800*------ ALSO, CHANGE THE ORIGINATOR DREQQUE ENTRY (LEVEL 00) TO
016900*------ 'X ' STATUS.
017000     IF REQ-APPROVALS-LEFT-9 < 1
017100         MOVE DATE-YMD-OUT         TO   REQ-REL-MC-DATE
               IF REQ-REL-MC-DATE-YY > "70"
                   MOVE "19" TO REQ-REL-MC-DATE-CC
               ELSE
                   MOVE "20" TO REQ-REL-MC-DATE-CC
               END-IF
017200         MOVE "X"                  TO   REQ-RELEASE-STAT
017300         PERFORM 9000-LEV00-STAT THRU 9090-LS-X
017400         IF BU-DISPLAY-MSG-1 NOT = SPACES
017500             GO TO 6990-MAIN-X
               END-IF
      *-----IF REQ TO GO TO CORP PURCH, WRITE RECORD TO MCORPREQ
               IF REQ-TO-CORP-PURCH = "X"
                 MOVE SPACES                TO  BUF-MCORPREQ
                 MOVE MREQ-NUMBER           TO  MCORPREQ-REQ-NUMBER
                 MOVE "A "                  TO  MCORPREQ-REQ-STATUS
                 WRITE MCORPREQ-REC-O FROM BUF-MCORPREQ
                   INVALID KEY    MOVE FILE-STATUS TO FILE-STATUS
                 END-WRITE
                 IF FILE-STATUS NOT = "00"
                   MOVE "*WRITE OF MCORPREQ FAILED*" TO BU-DISPLAY-MSG
                   GO TO 6990-MAIN-X
                 END-IF
               END-IF
      *-----ADDED A WRITE TO MCORPREQ OF RECORD TYPE 'R3' FOR SAP/R3
      *-----REQUISITION DATA
               IF SAVE-SYNR3-SW = "N"
                   NEXT SENTENCE
               ELSE
               MOVE SPACES                  TO  BUF-MCORPREQ
               MOVE MREQ-NUMBER             TO  MCORPREQ-REQ-NUMBER
               MOVE "R3"                    TO  MCORPREQ-REQ-STATUS
               WRITE MCORPREQ-REC-O FROM BUF-MCORPREQ
                   INVALID KEY    MOVE FILE-STATUS TO FILE-STATUS
               END-WRITE
               IF FILE-STATUS NOT = "00"
                   MOVE "*WRITE OF SAP/R3 MCORPREQ FAILED*"
                       TO BU-DISPLAY-MSG
                   GO TO 6990-MAIN-X
               END-IF.
017600
           MOVE MREQ-NUMBER TO REQNO OF MREQ-REC-O.
           READ MREQ-O
               INVALID KEY MOVE 17 TO COND-WORD.
           IF FILE-STATUS NOT = "00"
               MOVE "CEAPPRV RE-READ MREQ ERR" TO BU-DISPLAY-MSG
               GO TO 6990-MAIN-X.
017700*    CALL "DBUPDATE" USING BASE, DSET-MREQ, MODE1, STATUS-AREA,
017800*      ALL-ITEMS, BUF-MREQ.
           REWRITE MREQ-REC-O FROM BUF-MREQ
               INVALID KEY MOVE 99 TO COND-WORD.
           IF FILE-STATUS NOT = "00"
018000         MOVE "CEAPPRV DBUPDATE ERR MREQ 6000-M" TO BU-DISPLAY-MSG
018100         GO TO 6990-MAIN-X.
018200
      *------ IF THE PLANT HAS REQUESTED THAT WE MAINTAIN RUNNING
      *------ DAILY AND MONTHLY DOLLAR AMOUNTS OF WHAT THE APPROVER
      *------ HAS APPROVED, ADD THE BUDGET AMT INTO THE APPROVED DAILY
      *------ AND APPROVED MONTHLY BUCKETS.
           IF DISPLAY-APP-AMTS = "Y"
               PERFORM 9000-UPDATE-MEMPL-BUCKETS THRU 9000-UMB-X.

018800 6990-MAIN-X.
           IF BU-DISPLAY-MSG-1 NOT = SPACES
               MOVE FILE-STATUS TO BU-DISPLAY-MSG-59-60.
           CLOSE DREQQUE-O, MEMPL-O, MREQ-O, MCORPREQ-O.
018900     GOBACK.
019000
       9000-UPDATE-MEMPL-BUCKETS.
           MOVE 0 TO COND-WORD.
           MOVE SAVE-EMPL-QUEUED TO EMPLOYID OF MEMPL-REC-O.
           READ MEMPL-O INTO BUF-MEMPL
               INVALID KEY MOVE 15 TO COND-WORD.
           IF FILE-STATUS NOT = "00" MOVE 15 TO COND-WORD.
           IF SAVE-EMPL-QUEUED NOT = MEMPL-EMPL MOVE 15 TO COND-WORD.
           IF COND-WORD = 15
               MOVE "CEAAPPRV READ ERR MEMPL 900-UMB"
                   TO BU-DISPLAY-MSG
               GO TO 9000-UMB-X.
           IF MEMPL-TODAY-BUCKET-X = SPACES
               MOVE ZEROES TO MEMPL-TODAY-BUCKET.
           IF MEMPL-WEEKS-BUCKET-X = SPACES
               MOVE ZEROES TO MEMPL-WEEKS-BUCKET.
           IF MEMPL-TOTAL-BUCKET-X = SPACES
               MOVE ZEROES TO MEMPL-TOTAL-BUCKET.
           ADD REQ-BUDGET-AMT TO MEMPL-TODAY-BUCKET.
           ADD REQ-BUDGET-AMT TO MEMPL-WEEKS-BUCKET.
           ADD REQ-BUDGET-AMT TO MEMPL-TOTAL-BUCKET.
           REWRITE MEMPL-REC-O FROM BUF-MEMPL
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF FILE-STATUS NOT = "00" MOVE 17 TO COND-WORD.
           IF COND-WORD NOT = 0
               MOVE "CEAAPPRV READ ERR MEMPL 900-UMB"
                   TO BU-DISPLAY-MSG.
           MOVE SPACES             TO  EAPP-PARMS.
           MOVE SAVE-EMPL-QUEUED   TO  EAPP-CC.
           MOVE MEMPL-TODAY-BUCKET TO  EAPP-DAILY-AMT.
           MOVE MEMPL-WEEKS-BUCKET TO  EAPP-WEEKS-AMT.
           MOVE MEMPL-TOTAL-BUCKET TO  EAPP-TOTAL-AMT.
       9000-UMB-X.    EXIT.

019100 9000-LEV00-STAT.
019200*------ UPDATE THE EMPL/STATUS COMBINATION KEYS IN THE
019300*------ DREQQUE DATASET: BECAUSE REQ STATUS HAS CHANGED.
019400*    CALL "DBFIND" USING BASE, DSET-DREQQUE, MODE1,
019500*      STATUS-AREA, REQ-SEARCH, MREQ-NUMBER.
           MOVE 0 TO COND-WORD.
           MOVE MREQ-NUMBER TO REQNO OF DREQQUE-REC-O.
           START DREQQUE-O KEY = REQNO OF DREQQUE-REC-O
               INVALID KEY MOVE 17 TO COND-WORD.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
                   MOVE 17 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.
019600     IF NOT GOOD-CALL
019700         MOVE "CEAAPPRV DBFIND ERR DREQQUE 9000-LS"
019800                                   TO   BU-DISPLAY-MSG
019900         GO TO 9090-LS-X.
020000
020100*    CALL "DBGET" USING BASE, DSET-DREQQUE, MODE5,
020200*      STATUS-AREA, ALL-ITEMS, BUF-DREQQUE, MREQ-NUMBER.
           MOVE 0 TO COND-WORD.
           READ DREQQUE-O NEXT INTO BUF-DREQQUE
               AT END MOVE 15 TO COND-WORD.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   MOVE 15 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.
           IF REQNO OF DREQQUE-REC-O NOT = MREQ-NUMBER
               MOVE 15 TO COND-WORD.
020300     IF END-OF-CHAIN
020400         GO TO 9090-LS-X
020500     ELSE
020600     IF NOT GOOD-CALL
020700         MOVE "CEAAPPRV DBGET ERR DREQQUE 9000-LS"
020800                                   TO   BU-DISPLAY-MSG
020900         GO TO 9090-LS-X.
021000
021100*    CALL "DBDELETE" USING BASE, DSET-DREQQUE, MODE1,
021200*      STATUS-AREA.
021800     MOVE "X "                     TO   DRQQ-EQ-ST,
021900                                        DRQQ-EO-ST.
022000
022100*    CALL "DBPUT" USING  BASE, DSET-DREQQUE, MODE1,
022200*      STATUS-AREA, ALL-ITEMS, BUF-DREQQUE.
           REWRITE DREQQUE-REC-O FROM BUF-DREQQUE
               INVALID KEY MOVE 99 TO COND-WORD.
           IF FILE-STATUS NOT = "00"
               MOVE "CEAAPPRV REWRITE ERR 2" TO BU-DISPLAY-MSG.
022700
022800 9090-LS-X.
022900     EXIT.
