020700
      *LINKAGE SECTION.
       COPY THDPRTB IN COPYLIB.
       COPY MTLSLINK IN COPYLIB.
011000*01  R26-DATA-LINE.
011100*    05  R26-DESC-OPTION      PIC X.
011200*    05  FILLER               PIC X(111).

      *PROCEDURE DIVISION USING HD-ROUTE-DATA, R26-DATA-LINE.
       PROCEDURE DIVISION.
       BEGIN-SORT SECTION.
       1-HOUSEKEEPING.
9406CK     MOVE "C" TO SCOPE.
9406CK     CALL "MCXCBLERR" USING SCOPE.

           ACCEPT HD-ROUTE-DATA.
           ACCEPT MTLS-DATA-LINE-1.
           ACCEPT MTLS-DATA-LINE-1B.
           ACCEPT MTLS-DATA-LINE-2.

      *---------- OPEN THE PRINT FILE, GET THE FILE NUMBER OF THE PRINT
      *---------- FILE, AND PRINT THE HEADER PAGE.
           MOVE HD-SPOOLER-NUMBER TO OVRPRTF-TOFILE-NUM.
           MOVE "*YES"            TO OVRPRTF-SHARED.
           MOVE HD-NO-OF-COPIES   TO OVRPRTF-COPIES.
           MOVE "MCPRT"           TO OVRPRTF-FILE.
           PERFORM 996-OVERRIDE-PRINT-FILE.
021100     OPEN OUTPUT PRINT-FILE.
021300     CALL "TESCSEQ" USING ESC-NAME.
021400     MOVE CHAR-1636PI TO COMPRESS-PRINT.
021500     MOVE CHAR-10PI   TO NORMAL-PRINT.
021600     MOVE TEXT-LENGTH-61 TO ESC-TEXT-61.
021700
           MOVE MTLS-RPT-TITLE     TO PRT-RPT-TITLE.
           MOVE "  TRPTMR"         TO PRT-PGM-NAME.
           IF MTLS-FROM-RANGE > SPACES OR MTLS-TO-RANGE > SPACES
               PERFORM 9-MOVE-HEADING-DESC.
           IF MTLS-COST-OPT = "M"
               MOVE "MKT COST"     TO PRT-COST-LIT
           ELSE
           IF MTLS-COST-OPT = "A"
               MOVE "AVG COST"     TO PRT-COST-LIT
           ELSE
           IF MTLS-COST-OPT = "R"
               MOVE "REP COST"     TO PRT-COST-LIT.

021800     MOVE 1 TO DATE-MODE.
021900     CALL "TDATECHK" USING DATE-CHECK-AREA.
022000     MOVE DATE-SLASH-OUT TO PRT-DATE.
022100     MOVE DATE-FORMATTED-TIME-OUT TO PRT-TIME.
022200
022300*********************************************************
022400**  ACCEPT ROUTE LINE AND THE INPUT LINE TO FIND OUT   **
022500**  PARMS FOR REPORT                                   **
022600*********************************************************
023000
023100     MOVE "DHDR37.PUB" TO HD-FILE-NAME.
023200     CALL "THDPRT2" USING HD-RET-CODE, HD-FILE-NAME, FNUM,
023300          HD-ROUTE-DATA, ESC-NAME.
023400     IF HD-RET-CODE NOT = 0
023500          MOVE "THDPRT2 ERROR IN 1-HSK" TO BU-DISPLAY-MSG
023600          MOVE "HD-RET-CODE = "         TO BU-DISPLAY-FLD (1)
023700          MOVE HD-RET-CODE              TO BU-DISPLAY-FLD9 (1)
023800          GO TO 2-BLOWUP.

            PERFORM 9-MOVE-OPTION-LINES.
            WRITE PRT-REC FROM OPTION-LINE-1  AFTER ADVANCING 3 LINES.
            WRITE PRT-REC FROM OPTION-LINE-2  AFTER ADVANCING 1 LINE.
            WRITE PRT-REC FROM OPTION-LINE-2B AFTER ADVANCING 1 LINE.
            WRITE PRT-REC FROM OPTION-LINE-2C AFTER ADVANCING 1 LINE.
            WRITE PRT-REC FROM OPTION-LINE-3  AFTER ADVANCING 1 LINE.
            WRITE PRT-REC FROM OPTION-LINE-4  AFTER ADVANCING 1 LINE.
            WRITE PRT-REC FROM OPTION-LINE-5  AFTER ADVANCING 1 LINE.
            WRITE PRT-REC FROM OPTION-LINE-6  AFTER ADVANCING 1 LINE.
            WRITE PRT-REC FROM OPTION-LINE-7  AFTER ADVANCING 1 LINE.
            WRITE PRT-REC FROM OPTION-LINE-8  AFTER ADVANCING 1 LINE.

           OPEN INPUT MSTORERM-I, DDESC-I, DMANPART-I.
024300
           COPY MTLSPROC IN COPYLIB.

024400*    SORT SORT-FILE
024500*         ON ASCENDING KEY SRT-CORP-CODE
024600*         INPUT  PROCEDURE IS 8-INPUT-RECORDS
024700*         OUTPUT PROCEDURE IS 9-WRITE-RECORDS.
024800
024900 2-EOJ.
           IF PAPER-IS-132-COLS
               NEXT SENTENCE
           ELSE
025100     WRITE PRT-REC FROM NORMAL-PRINT AFTER ADVANCING 0.
025200     CLOSE PRINT-FILE.
           CLOSE MSTORERM-I, DDESC-I.
025700     GOBACK.
025800
025900 2-BLOWUP.
026000     MOVE "TRPTMR" TO BU-PGM-NAME.
026100     CALL "TBLOWUP" USING BASE, BU-PGM-NAME, STATUS-AREA,
026200         VIEW-COMAREA, FILE-STATUS, BU-DISPLAY-MSG,
026300         BU-DISPLAY-AREA.
026400
026500 7-INPUT-RECORDS SECTION.

       COPY MTLSINPT IN COPYLIB.

      *    READ MSTORERM-I FIRST RECORD INTO BUF-MSTORERM
      *       AT END MOVE FILE-STATUS TO FILE-STATUS.
      *    IF FILE-STATUS NOT = "00"
      *       MOVE "Y" TO END-OF-INPUT-FILE.
026600*    PERFORM 81-PROCESS-INPUT-RECORDS THRU 81-PIR-EXIT UNTIL
026700*            ALL-INPUT-RECORDS-PROCESSED.
026800*    GO TO 8-IR-EXIT.
026900*
027000*81-PROCESS-INPUT-RECORDS.
028100*    IF CORP-CODE = "NON-STR "
028200*        NEXT SENTENCE
028300*    ELSE
028500*    IF STR-MAINT NOT = SPACE
028400*        MOVE SPACES        TO SORT-REC
028600*        MOVE CORP-CODE     TO SRT-CORP-CODE
028700*        MOVE STR-CLASS     TO SRT-CLASS
028800*        MOVE STR-MAINT     TO SRT-MR
028900*        MOVE STR-AVG-COST  TO SRT-AVG-COST
029000*        MOVE STR-UM        TO SRT-UM
029100*        MOVE STR-ONHAND    TO SRT-ONHAND
029200*        RELEASE SORT-REC.
      *
      *    READ MSTORERM-I NEXT INTO BUF-MSTORERM
      *        AT END MOVE FILE-STATUS TO FILE-STATUS.
      *    IF FILE-STATUS NOT = "00"
      *        IF FILE-STATUS = "10" OR "14" OR "46"
027400*           MOVE "Y" TO END-OF-INPUT-FILE
027500*           GO TO 81-PIR-EXIT
027600*        ELSE
027800*            MOVE "DBGET ERROR 81-P-I-R  " TO BU-DISPLAY-MSG
027900*            GO TO 2-BLOWUP.
029300*
029400*81-PIR-EXIT.
029500*    EXIT.
029600
029700 7-IR-EXIT.
029800     EXIT.
029900
030000 8-WRITE-RECORDS SECTION.
030100     IF PAPER-IS-132-COLS
030200         NEXT SENTENCE
030300     ELSE
030400         WRITE PRT-REC FROM COMPRESS-PRINT AFTER ADVANCING 0.
030600
030700     RETURN SORT-FILE AT END
030800         MOVE "Y" TO END-OF-SORT-FILE
030900         MOVE  1  TO PRT-PAGE
               WRITE PRT-REC FROM HEADING-1 AFTER ADVANCING NEW-PAGE
               WRITE PRT-REC FROM HEADING-2 AFTER ADVANCING 1 LINE
031000*        WRITE PRT-REC FROM HDR-1 AFTER ADVANCING NEW-PAGE
031100*        WRITE PRT-REC FROM HDR-2 AFTER ADVANCING 1 LINES
031200         WRITE PRT-REC FROM HDR-3 AFTER ADVANCING 2 LINES
031300         MOVE NO-SORTED-RECORDS TO PRT-REC
031400         WRITE PRT-REC AFTER ADVANCING 2 LINES
031500         GO TO 2-EOJ.
031600
           PERFORM 9-MOVE-CONTROL-BREAK.

031700     PERFORM 82-PROCESS-SORTED-RECORDS THRU 82-PSR-EXIT
031800             UNTIL ALL-SORTED-RECORDS-PROCESSED.
031900
           PERFORM 9-CHECK-HEADINGS.

      *------- DON'T PRINT TOTAL LINE IF BIN LOC OR MANUF SORT BECAUSE
      *------- CODES COULD BE DUPLICATED.
           IF MTLS-SORT-OPT NOT = "06" AND MTLS-SORT-OPT NOT = "08"
               MOVE CODES-RELEASED TO PRT-GRD-ITMS
032000         MOVE GRAND-TOTAL TO PRT-GRD-TOTAL
032100         WRITE PRT-REC FROM GRAND-TOTAL-LINE
032200             AFTER ADVANCING 3 LINES.
032300     GO TO 8-WR-EXIT.
032400
032500 82-PROCESS-SORTED-RECORDS.
           PERFORM 9-CHECK-HEADINGS.
033600     MOVE SPACES        TO PRT-REC, PRT-ITEM-DATA.
033700     MOVE  SRT-CORP-CODE     TO  CODE-ARG.
033800     MOVE 0 TO SUB.
           MOVE SRT-KEYWD-MOD      TO  PRT-DESC.
033900
      *    MOVE CODE-ARG TO CORPCDE OF DDESC-REC-I.
      *    START DDESC-I KEY = CORPCDE OF DDESC-REC-I
      *        INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
      *    IF FILE-STATUS NOT = "00"
      *        MOVE "* NO DESCRIPTION ON FILE *" TO PRT-DESC
      *        GO TO 92-CONT.
      *
      *    READ DDESC-I NEXT INTO BUF-DDESC
      *        AT END MOVE FILE-STATUS TO FILE-STATUS.
      *    IF FILE-STATUS = "00"
      *        MOVE DESC-DATA      TO  PRT-DESC
      *    ELSE
      *        MOVE "* NO DESCRIPTION ON FILE *" TO PRT-DESC.

035200     IF MTLS-DESC-OPT NOT = "X"
035300         MOVE 0 TO TEXT-TO-PRT
035400         GO TO 82-CONT.
035500
035600 82-GET-MULT-DESC.
035700     CALL "CDESC"  USING  RET-CODE,
035800                          BASE,
035900                          STATUS-AREA,
036000                          BU-DISPLAY-MSG,
036100                          CODE-ARG,
036200                          CDESC-DATA.
036300
036400     IF BU-DISPLAY-MSG-1  NOT = SPACES
036500         MOVE CODE-ARG  TO  BU-DISPLAY-FLD (2)
036600         GO TO 2-BLOWUP.
036700     IF CDESC-LINES-GOT > 1
036800         ADD CDESC-LINES-GOT, LINE-K GIVING TEXT-TO-PRT.
036900
037000
037100 82-CONT.
037200     COMPUTE TOTAL-COST = SRT-ONHAND * SRT-COST.
037300     ADD TOTAL-COST TO GRAND-TOTAL.
037400     MOVE SRT-CORP-CODE TO PRT-CODE.
037500     MOVE SRT-CLASS TO PRT-CLASS.
037600*    MOVE SRT-MR TO PRT-MR.
037700     MOVE SRT-ONHAND TO PRT-ONHAND.
037800     MOVE SRT-UM TO PRT-UM.
037900     MOVE SRT-COST TO PRT-AVG-COST.
038000     MOVE TOTAL-COST TO PRT-TOTAL.
038100
           PERFORM 9-CHECK-HEADINGS.
039200
039300     MOVE 1 TO SUB.
039400     ADD 1 TO LINE-K.
039500     WRITE PRT-REC FROM PRT-ITEM-DATA AFTER ADVANCING 1 LINES.
039600
      *---------- PRINT INV LEVELS IF REQUESTED.
           IF MTLS-CODE-OPT = "X"
               PERFORM 9-MOVE-LIMITS
               ADD 1 TO LINE-K
               WRITE PRT-REC FROM USAGE-LIMITS-LINE
                                             AFTER ADVANCING 1 LINE.

039700     IF MTLS-DESC-OPT NOT = "X"
039800         GO TO 822-RTN-SORT-FILE.
039900
040000 821-PRT-MULT-DESC.
040100     ADD 1 TO SUB.
040200     IF SUB > CDESC-LINES-GOT
040300        GO TO 822-RTN-SORT-FILE.
040400     MOVE CDESC (SUB) TO PRT-FULL-DESC.
040500     WRITE PRT-REC FROM FULL-DESC-LINE AFTER ADVANCING 1.
040600     ADD 1 TO LINE-K.
040700
040800     GO TO 821-PRT-MULT-DESC.
040900
041000 822-RTN-SORT-FILE.
041100     RETURN SORT-FILE
041200        AT END
041300          MOVE "Y" TO END-OF-SORT-FILE.
041400
      *--------- PRINT CONTROL BREAKS.
           IF MTLS-SORT-OPT NOT = "01" AND MTLS-SORT-OPT NOT = "  "
               IF END-OF-SORT-FILE NOT = "Y"
                   PERFORM 9-CHECK-CONTROL-BREAK
               END-IF
               IF END-OF-SORT-FILE = "Y" OR CNTL-BREAK-SW = "Y"
                   MOVE SPACES TO PRT-REC
                   WRITE PRT-REC             AFTER ADVANCING 1 LINE
                   PERFORM 9-PRINT-CONTROL-BREAK
                   WRITE PRT-REC FROM CONTROL-BREAK-LINE
                                             AFTER ADVANCING 1 LINE
                   PERFORM 9-MOVE-CONTROL-BREAK
                   IF END-OF-SORT-FILE = "N"
                       MOVE 60            TO  LINE-K
                       PERFORM 9-CHECK-HEADINGS.

041500 82-PSR-EXIT.
041600     EXIT.
041700
041800 8-WR-EXIT.
041900     EXIT.

       9-UTILITY SECTION.

       COPY OVRPFCALL IN COPYLIB.

       COPY MTLSUTIL  IN COPYLIB.

       9-CHECK-HEADINGS.
           IF LINE-K > 59
               ADD     1      TO PAGE-K
               MOVE    1      TO LINE-K
               MOVE PAGE-K    TO PRT-PAGE
               ADD     3      TO LINE-K
               WRITE PRT-REC FROM HEADING-1 AFTER ADVANCING NEW-PAGE
               WRITE PRT-REC FROM HEADING-2 AFTER ADVANCING 1 LINE
               IF MTLS-SORT-OPT > SPACES AND MTLS-SORT-OPT NOT = "01"
                 MOVE CNTL-BREAK-HOLD-FIELD TO PRT-H2B-VALUE
                 WRITE PRT-REC FROM HEADING-2B AFTER ADVANCING 1 LINE
                 ADD   1      TO LINE-K
               END-IF
      *        WRITE PRT-REC FROM HDR-1 AFTER ADVANCING NEW-PAGE
      *        WRITE PRT-REC FROM HDR-2 AFTER ADVANCING 1 LINES
               WRITE PRT-REC FROM HDR-3 AFTER ADVANCING 2 LINES
               MOVE SPACES TO PRT-REC
               WRITE PRT-REC AFTER ADVANCING 1 LINES.

      *------- DUMMY PARAGRAPH; NOT USED IN THIS PROGRAM.
       9-COMPUTE-USAGE.
           EXIT.
