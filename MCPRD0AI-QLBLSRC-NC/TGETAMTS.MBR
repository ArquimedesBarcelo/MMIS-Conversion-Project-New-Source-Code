009300 PROCEDURE DIVISION USING BASE-MMISA BASE-STORES REQUISITION-DATA
009400                      LANGUAGE-PARMS ESC-NAME VIEW-COMAREA.
009500 BEGIN.
009600     PERFORM 1-HSK.
009700     PERFORM 6-MAIN.
009800 2-EOJ.
           CLOSE JOBPLAN-FILE.
           CLOSE PERSONNEL-FILE.
           CLOSE WO-BASIC-FILE.
           CLOSE WO-LABOR-FILE.
           CLOSE WO-PARTS-FILE.
           CLOSE WO-PLANNED-FILE.
009900     GOBACK.
010100****************************************************************
010200*    HOUSEKEEPING                                              *
010300****************************************************************
010400 1-HSK.
           MOVE LOW-VALUES TO STATUS-AREA STATUS-AREA-2.
010500     MOVE "OK" TO REQ-RETBS.
012300     MOVE ZEROES TO TOTAL-EST-TOTAL REQ-WO-AMT-APP
012400                    TOTAL-ACT-TOTAL REQ-WO-AMT-COMM
012500                    TOTAL-REQ-NO-PURCH REQ-AMT-NOT-PUR
012600                    TOTAL-AMT-AVAIL REQ-AMT-AVAIL.
           OPEN INPUT JOBPLAN-FILE.
           OPEN INPUT PERSONNEL-FILE.
           OPEN INPUT WO-BASIC-FILE.
           OPEN INPUT WO-LABOR-FILE.
           OPEN INPUT WO-PARTS-FILE.
           OPEN INPUT WO-PLANNED-FILE.
012800****************************************************************
012900*    MAIN LOGIC                                                *
013000****************************************************************
013100 6-MAIN.
013200     PERFORM 60-FIND-WO THRU 60-FW-EXIT.
013300     IF PLANNED-SW = 0
013400         MOVE "WO" TO REQ-RETBS
013500         GO TO 2-EOJ.
           PERFORM 69-START-WO-LABOR-FILE.
014100     IF COND-WORD = 0
014700*
014800*    GET LABOR DATA
014900*
015000         PERFORM 61-READ-AND-SAVE-1-LBR-REC
015100             UNTIL COND-WORD = 15.
015200*
015300*    GET MATERIAL USED DATA
015400*
           PERFORM 69-START-WO-PARTS-FILE.
016000     IF COND-WORD = 0
016300*
016400*    CLEAR MATERIALS USED WORK AREA AND SAVE DATA
016500*
016600         PERFORM 62-READ-AND-SAVE-1-MAT-REC THRU 62-RAS1MR-EXIT
016700             UNTIL COND-WORD = 15.
016800*
016900*    RETRIEVE JOBPLAN INFORMATION
017000*
           MOVE SPACES TO PERSONNEL-DATA.
017300     MOVE SPACES TO JOBP-KEY.
017400     MOVE REQ-WO TO JOBP-WO-NO.
017500     MOVE 001 TO JOBP-SEQ-NO.
017600     IF PLANNED-SW = 2
               IF LAST-JOBPLAN-SEQ = "    "
                   NEXT SENTENCE
               ELSE
017700         IF LAST-JOBPLAN-SEQ-1-3 > 000
017800             PERFORM 63-READ-AND-SAVE-JOBP-DATA THRU
017900                 63-RASJD-EXIT.
018000     MOVE TOTAL-EST-TOTAL TO REQ-WO-AMT-APP.
018100     MOVE TOTAL-ACT-TOTAL TO REQ-WO-AMT-COMM.
018200     MOVE TOTAL-REQ-NO-PURCH TO REQ-AMT-NOT-PUR.
018300     IF TOTAL-ACT-TOTAL > TOTAL-EST-TOTAL
018400         MOVE ZEROES TO REQ-AMT-AVAIL
018500     ELSE
018600     MOVE REQ-WO-AMT-APP TO REQ-AMT-AVAIL
018700     SUBTRACT REQ-WO-AMT-COMM FROM REQ-AMT-AVAIL
018800     SUBTRACT REQ-AMT-NOT-PUR FROM REQ-AMT-AVAIL.
018900 60-FIND-WO.
019000     MOVE 0 TO PLANNED-SW.
           PERFORM 69-START-WO-BASIC-FILE.
           IF COND-WORD = 17 GO TO 60-FW-PLANNED.
           PERFORM 69-READ-WO-BASIC-FILE.
019800     IF COND-WORD = 15 GO TO 60-FW-PLANNED.
           MOVE 1 TO PLANNED-SW.
           GO TO 60-FW-EXIT.
       60-FW-PLANNED.
020000     PERFORM 69-START-WO-PLANNED-FILE.
020100     IF COND-WORD = 17 GO TO 60-FW-EXIT.
           PERFORM 69-READ-WO-PLANNED-FILE.
           IF COND-WORD = 15 GO TO 60-FW-EXIT.
021000     MOVE 2 TO PLANNED-SW.
021300 60-FW-EXIT.    EXIT.
021400 61-READ-AND-SAVE-1-LBR-REC.
           PERFORM 69-READ-WO-LABOR-FILE.
021700     IF COND-WORD = 0
021800         DIVIDE LBR-CST-CENTS-9 BY 100
021900             GIVING TMP-LBR-CST
022000         ADD LBR-CST-DOLLR-9 TO TMP-LBR-CST
022100         ADD TMP-LBR-CST TO TOTAL-ACT-TOTAL.
023200 62-READ-AND-SAVE-1-MAT-REC.
           PERFORM 69-READ-WO-PARTS-FILE.
           IF COND-WORD = 15 GO TO 62-RAS1MR-EXIT.
023500     IF PRT-REQ-NO = SPACES OR "CANCEL" GO TO 62-RAS1MR-CONT.
023900     MOVE SPACES TO CMR-DATA CMR-DESC CMR-REMARKS
024000         CMR-RETURNED-DATA CMR-MISC-PARMS BU-DISPLAY-MSG.
024100     MOVE "I2" TO CMR-CALL-MODE.
024200     MOVE PRT-REQ-NO TO CMR-REQ-NUMBER.
024300     MOVE PRT-WO-NU TO CMR-WO-NUMBER.
024400     CALL "CMANINQ" USING PASSED-BASE
024500                          CMR-CALL-MODE
024600                          CMR-DATA
024700                          CMR-DESC
024800                          CMR-REMARKS
024900                          CMR-RETURNED-DATA
025000                          CMR-MISC-PARMS
025100                          LANGUAGE-PARMS
025200                          ESC-NAME
025300                          STATUS-AREA-2
025400                          BU-DISPLAY-MSG.
025500     IF CMR-RETURN-STATUS = "OK"
025600         IF CMR-PO-NO-AND-REL = SPACES
025700             MOVE CMR-EST-UNIT-PRICE TO P-UNIT-COST
025800             MULTIPLY CMR-QTY BY P-UNIT-COST
025900                 GIVING P-EST-COST
026000         ELSE
026100         MOVE CMR-PO-NO-AND-REL TO PRT-PO-NO
026200         MOVE CMR-PO-UNIT-PRICE TO P-UNIT-COST
026300         MULTIPLY CMR-QTY BY P-UNIT-COST
026400             GIVING P-ACT-COST.
       62-RAS1MR-CONT.
           IF PRT-EST-QTY = SPACES MOVE ZEROES TO PRT-EST-QTY-9.
           IF PRT-EST-COST = SPACES MOVE ZEROES TO P-EST-COST.
           IF PRT-ACT-QTY = SPACES MOVE ZEROES TO PRT-ACT-QTY-9.
           IF PRT-ACT-COST = SPACES MOVE ZEROES TO P-ACT-COST.
026600*    IF PRT-EST-QTY-FLAG = "*"
      *        NEXT SENTENCE
      *    ELSE
           GO TO 62-RAS1MR-CONT-1.
026700     IF "M" = PRT-STATUS-1 OR PRT-STATUS-2
026800         IF PRT-PO-NO = SPACES
026900             IF PRT-REQ-NO = SPACES
027000                 ADD P-ACT-COST TO TOTAL-ACT-TOTAL
027100             ELSE
027200             ADD P-ACT-COST TO TOTAL-ACT-TOTAL
027300             ADD P-EST-COST TO TOTAL-REQ-NO-PURCH
027400         ELSE
027500         ADD P-ACT-COST TO TOTAL-ACT-TOTAL
027600     ELSE
027700     IF "X" = PRT-STATUS-1 OR PRT-STATUS-2
027800         IF PRT-NUM-7 = "       "
027900             IF PRT-PO-NO = SPACES
028000                 IF PRT-REQ-NO = SPACES
028100                      ADD P-ACT-COST TO TOTAL-ACT-TOTAL
028200                 ELSE
028300                 ADD P-ACT-COST TO TOTAL-ACT-TOTAL
028400                 ADD P-EST-COST TO TOTAL-REQ-NO-PURCH
028500             ELSE
028600             ADD P-ACT-COST TO TOTAL-ACT-TOTAL
028700         ELSE
028800         MOVE SPACES TO STORES-DATA
028900         MOVE PRT-NUM TO CSIS-CODE
029000         CALL "TCODINFO" USING STORES-DATA
029100                           DBPARAMETERS-STORES
029200         IF RET-CODE-INFO = "NS"
029300             IF PRT-PO-NO = SPACES
029400                 IF PRT-REQ-NO = SPACES
029500                     ADD P-ACT-COST TO TOTAL-ACT-TOTAL
029600                 ELSE
029700                 ADD P-ACT-COST TO TOTAL-ACT-TOTAL
029800                 ADD P-EST-COST TO TOTAL-REQ-NO-PURCH
029900             ELSE
030000             ADD P-ACT-COST TO TOTAL-ACT-TOTAL
030100         ELSE
030200         ADD P-ACT-COST TO TOTAL-ACT-TOTAL
030300     ELSE
030400     ADD P-EST-COST TO TOTAL-ACT-TOTAL
030500     ADD P-ACT-COST TO TOTAL-EST-TOTAL.
030600     GO TO 62-RAS1MR-EXIT.
       62-RAS1MR-CONT-1.
030700     IF "M" = PRT-STATUS-1 OR PRT-STATUS-2
030800         IF PRT-PO-NO = SPACES
030900             IF PRT-REQ-NO = SPACES
031000                 ADD P-EST-COST TO TOTAL-EST-TOTAL
031100                 ADD P-ACT-COST TO TOTAL-ACT-TOTAL
031200             ELSE
031300             ADD P-EST-COST TO TOTAL-EST-TOTAL
031400             ADD P-EST-COST TO TOTAL-REQ-NO-PURCH
031500             ADD P-ACT-COST TO TOTAL-ACT-TOTAL
031600         ELSE
031700         ADD P-EST-COST TO TOTAL-EST-TOTAL
031800         ADD P-ACT-COST TO TOTAL-ACT-TOTAL
031900     ELSE
032000     IF "X" = PRT-STATUS-1 OR PRT-STATUS-2
032100         AND PRT-NUM-7 = "       "
032200         IF PRT-PO-NO = SPACES
032300             IF PRT-REQ-NO = SPACES
032400                 ADD P-EST-COST TO TOTAL-EST-TOTAL
032500                 ADD P-ACT-COST TO TOTAL-ACT-TOTAL
032600             ELSE
032700             ADD P-EST-COST TO TOTAL-EST-TOTAL
032800             ADD P-EST-COST TO TOTAL-REQ-NO-PURCH
032900             ADD P-ACT-COST TO TOTAL-ACT-TOTAL
033000         ELSE
033100         ADD P-EST-COST TO TOTAL-EST-TOTAL
033200         ADD P-ACT-COST TO TOTAL-ACT-TOTAL
033300     ELSE
033400     IF "X" = PRT-STATUS-1 OR PRT-STATUS-2
033500         MOVE SPACES TO STORES-DATA
033600         MOVE PRT-NUM TO CSIS-CODE
               CALL "TCODINFO" USING STORES-DATA DBPARAMETERS-STORES
033800         IF RET-CODE-INFO = "NS"
033900             IF PRT-PO-NO = SPACES
034000                 IF PRT-REQ-NO = SPACES
034100                     ADD P-EST-COST TO TOTAL-EST-TOTAL
034200                     ADD P-ACT-COST TO TOTAL-ACT-TOTAL
034300                 ELSE
034400                 ADD P-EST-COST TO TOTAL-EST-TOTAL
034500                 ADD P-EST-COST TO TOTAL-REQ-NO-PURCH
034600                 ADD P-ACT-COST TO TOTAL-ACT-TOTAL
034700             ELSE
034800             ADD P-EST-COST TO TOTAL-EST-TOTAL
034900             ADD P-ACT-COST TO TOTAL-ACT-TOTAL
035000         ELSE
035100         ADD P-EST-COST TO TOTAL-EST-TOTAL
035200         ADD P-ACT-COST TO TOTAL-ACT-TOTAL
035300     ELSE
035400     ADD P-EST-COST TO TOTAL-EST-TOTAL
035500     ADD P-ACT-COST TO TOTAL-ACT-TOTAL.
       62-RAS1MR-EXIT.    EXIT.
036600 63-READ-AND-SAVE-JOBP-DATA.
           PERFORM 69-START-JOBPLAN-FILE.
037200     IF COND-WORD = 17 GO TO 63-RASJD-EXIT.
038100 63-RASJD-LOOP.
           PERFORM 69-READ-JOBPLAN-FILE.
038400     IF COND-WORD = 15
               GO TO 63-RASJD-EXIT
039000     ELSE
039800     MOVE 0 TO SUB
040000     PERFORM 631-SET-LABOR-RATE THRU 631-SLR-EXIT
040100     PERFORM 632-CALC-LABOR-EST THRU 632-CLE-EXIT
040200     GO TO 63-RASJD-LOOP.
040300 63-RASJD-EXIT.    EXIT.
040400 631-SET-LABOR-RATE.
040500     IF JOBPLAN-CRAFT = "  " GO TO 631-SLR-EXIT.
           PERFORM 69-READ-PERSONNEL-FILE THRU 69-RPF-EXIT.
041100 631-SLR-EXIT.    EXIT.
041200 632-CALC-LABOR-EST.
041300     IF JOBPLAN-MEN-X = "  " OR JOBPLAN-EST = "    "
041400         GO TO 632-CLE-EXIT.
041500     MULTIPLY JOBPLAN-MEN BY JOBPLAN-EST-TIME GIVING
041600         JOBPLAN-EST-TIME-WORK ROUNDED.
041700     MULTIPLY JOBPLAN-EST-TIME-WORK BY PLANT-LABOR-RATE
041800         GIVING TMP-LBR-CST.
041900     ADD TMP-LBR-CST TO TOTAL-EST-TOTAL.
042000 632-CLE-EXIT.    EXIT.

       69-START-JOBPLAN-FILE.
           MOVE 0 TO COND-WORD.
           MOVE JOBP-KEY TO JOBPWOSEQ OF JFREC.
           START JOBPLAN-FILE KEY IS = EXTERNALLY-DESCRIBED-KEY
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF JF-STATUS NOT = "00" MOVE 17 TO COND-WORD.

       69-READ-JOBPLAN-FILE.
           MOVE 0 TO COND-WORD.
           READ JOBPLAN-FILE NEXT INTO JOBPLAN-BUFFER
               AT END    MOVE 15 TO COND-WORD.
           IF JOBP-WO-NO NOT = JOBPLAN-WO-NO MOVE 15 TO COND-WORD.
           IF JF-STATUS NOT = "00" MOVE 15 TO COND-WORD.

       69-READ-PERSONNEL-FILE.
           MOVE 0 TO COND-WORD.
           IF PERSONNEL-DATA = SPACES
               READ PERSONNEL-FILE FIRST INTO PERSONNEL-DATA
                   AT END    MOVE 15 TO COND-WORD
           ELSE
           READ PERSONNEL-FILE NEXT INTO PERSONNEL-DATA
               AT END    MOVE 15 TO COND-WORD.
           IF PF-STATUS NOT = "00" MOVE 15 TO COND-WORD.
           IF COND-WORD = 15
               MOVE 35.00 TO PLANT-LABOR-RATE
               MOVE SPACES TO PERSONNEL-DATA
               GO TO 69-RPF-EXIT
           ELSE
           IF JOBPLAN-CRAFT = PER-CRAFT
               MOVE PER-LABOR-RATE TO PLANT-LABOR-RATE
               GO TO 69-RPF-EXIT
           ELSE
           GO TO 69-READ-PERSONNEL-FILE.

       69-RPF-EXIT.    EXIT.

       69-READ-WO-BASIC-FILE.
           MOVE 0 TO COND-WORD.
           READ WO-BASIC-FILE NEXT INTO WO-BASIC-DATA
               AT END    MOVE 15 TO COND-WORD.
           IF WBF-STATUS NOT = "00" MOVE 15 TO COND-WORD.

       69-START-WO-BASIC-FILE.
           MOVE 0 TO COND-WORD.
           MOVE REQ-WO TO WONUM OF WBFREC.
019300     START WO-BASIC-FILE KEY IS = EXTERNALLY-DESCRIBED-KEY
019400         INVALID KEY    MOVE 17 TO COND-WORD.
019500     IF WBF-STATUS NOT = "00" MOVE 17 TO COND-WORD.

       69-READ-WO-LABOR-FILE.
           MOVE 0 TO COND-WORD.
           READ WO-LABOR-FILE NEXT INTO WO-LABOR-DATA
               AT END    MOVE 15 TO COND-WORD.
           IF LBR-WO-NUM NOT = REQ-WO MOVE 15 TO COND-WORD.
           IF WLF-STATUS NOT = "00" MOVE 15 TO COND-WORD.

       69-START-WO-LABOR-FILE.
           MOVE 0 TO COND-WORD.
013800     MOVE REQ-WO TO WONUM OF WLFREC.
013900     START WO-LABOR-FILE KEY IS = EXTERNALLY-DESCRIBED-KEY
014000         INVALID KEY    MOVE 17 TO COND-WORD.
           IF WLF-STATUS NOT = "00" MOVE 17 TO COND-WORD.

       69-READ-WO-PARTS-FILE.
           MOVE 0 TO COND-WORD.
           READ WO-PARTS-FILE NEXT INTO WO-PARTS-DATA
               AT END    MOVE 15 TO COND-WORD.
           IF PRT-WO-NU NOT = REQ-WO MOVE 15 TO COND-WORD.
           IF WPFD-STATUS NOT = "00" MOVE 15 TO COND-WORD.

       69-START-WO-PARTS-FILE.
           MOVE 0 TO COND-WORD.
015700     MOVE REQ-WO TO WONUM OF WPFDREC.
015800     START WO-PARTS-FILE KEY IS = EXTERNALLY-DESCRIBED-KEY
015900         INVALID KEY    MOVE 17 TO COND-WORD.
           IF WPFD-STATUS NOT = "00" MOVE 17 TO COND-WORD.

        69-READ-WO-PLANNED-FILE.
            MOVE 0 TO COND-WORD.
            READ WO-PLANNED-FILE NEXT INTO WO-PLANNED-DATA
                AT END    MOVE 15 TO COND-WORD.
            IF WPF-STATUS NOT = "00" MOVE 15 TO COND-WORD.

       69-START-WO-PLANNED-FILE.
           MOVE 0 TO COND-WORD.
           MOVE REQ-WO TO WONUM OF WPFREC.
           START WO-PLANNED-FILE KEY IS = EXTERNALLY-DESCRIBED-KEY
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF WPF-STATUS NOT = "00" MOVE 17 TO COND-WORD.

