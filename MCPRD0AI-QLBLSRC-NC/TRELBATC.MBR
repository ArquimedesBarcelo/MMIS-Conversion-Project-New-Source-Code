093800     IF PROCESS-ALL-OPTION2 OR PROCESS-ALL-OPTION2X
093900         GO TO 60-AO-X
094000     ELSE
094100     IF PROCESS-INC-OPTION2 OR PROCESS-INC-OPTION2X
094200        OR PROCESS-EXC-OPTION2 OR PROCESS-EXC-OPTION2X
094300         NEXT SENTENCE
094400     ELSE
094500         MOVE "INVALID OPTION SELECT*60-AO" TO BU-DISPLAY-MSG
094600         MOVE PROCESS-FILE-INDICATOR        TO BU-DISPLAY-FLD (1)
094700         GO TO 2-BLOWUP.
094800
094900     MOVE ZEROS          TO  REQ-CTR.
095000     MOVE SPACES         TO  REQUIRE-SEL-TABLE.
095100
095200 60-ACCEPT-REQ-ENTRYS-LOOP.
095300     ACCEPT REQ-SELECTED.
095400     IF REQ-SELECTED = "*******"
095500         IF REQ-CTR = ZEROS
095600             MOVE "NO REQUIRE. SELECTED * 60-AREL"
095700                 TO BU-DISPLAY-MSG
095800             MOVE PROCESS-FILE-INDICATOR  TO BU-DISPLAY-FLD (1)
095900             GO TO 2-BLOWUP
096000         ELSE
096100             GO TO 60-AO-X.
096200     ADD 1  TO  REQ-CTR.
096300     IF REQ-CTR > 999
096400         MOVE "REQUIRE OPTIONS OVERFLOW*60-AREL"
096500             TO BU-DISPLAY-MSG
096600         MOVE REQ-SELECTED  TO  BU-DISPLAY-FLD (1)
096700         GO TO 2-BLOWUP.
096800     MOVE REQ-SELECTED  TO  REQUIRE-SEL-ENTRY (REQ-CTR).
096900     GO TO 60-ACCEPT-REQ-ENTRYS-LOOP.
097000
