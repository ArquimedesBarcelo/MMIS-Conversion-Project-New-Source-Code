089700         MOVE "* NO ERRORS OCCURED WHILE PROCESSING RELEASES *"
089800             TO ERROR-REPORT-LINE
089900         MOVE 3  TO  ERR-CTL
090000         WRITE ERROR-REPORT-RCD.
090100
090200     IF RELEASE-CTR = ZEROS
090300         MOVE "   ***  NO SHIPPING RELEASES PROCESSED  ***"
090400             TO  RELEASE-REPORT-LINE
090500         PERFORM 5-WRITE-CONTROL-REPORT-HEADER
090600         MOVE 2  TO  REL-CTL
090700         WRITE RELEASE-REPORT-RCD
090800     ELSE
090900         MOVE RELEASE-CTR      TO  RELEASE-CTR-OUT
091000         MOVE RELEASE-CTR-MSG  TO  RELEASE-REPORT-LINE
091100         MOVE 3                TO  REL-CTL
091200         WRITE RELEASE-REPORT-RCD.
091300     PERFORM 64-WRITE-CRITERIA-PAGE  THRU  64-WCP-X.
091400
