       1-HSK.

           MOVE "C" TO MCXCBLERR-SCOPE.
           CALL "MCXCBLERR" USING MCXCBLERR-SCOPE.
           OPEN INPUT MPLTINFO-I, MSTORERM-I, DPOITEMC-I.
           OPEN I-O MPORCV-O, DPORECD-O, DPOITEM-O,
                    MREQ-O, DPODATAITM-O, DDAILYTC-O.
           CALL "TESCSEQ" USING ESC-NAME.


DCR02 *----------------------------------------------------------------
DCR02 **                ----- ORDER CONSOLIDATION -----
DCR02 ** CALL ENDBATCHCL - WRITE END OF BATCH RECORD - REQ# = ALL 9'S
DCR02 *----------------------------------------------------------------
DCR02      CALL WS-ENDOFBATCH-CL.


DCR01 **************************************************
DCR01 ** MAKE SURE PO LOGGING IS ENABLED FOR THIS PLANT*
DCR01 **************************************************
DCR01      SET  Z000-POLG-ACTIVE-NO  TO TRUE.
DCR01      MOVE WS-Z000-POLG-KEY  TO PLT-ARG.
DCR01      MOVE PLT-ARG TO PLTINFOKEY OF MPLTINFO-REC-I.
DCR01      READ MPLTINFO-I INTO BUF-MPLTINFO.
DCR01      IF FILE-STATUS = "00"
DCR01         IF  PLTINFODTA OF MPLTINFO-REC-I(1:1) = "Y"
DCR01             SET  Z000-POLG-ACTIVE-YES TO TRUE
DCR01         END-IF
DCR01      END-IF.
072200**************************************************
072300*   RETRIEVE PCPO-SW FROM USER OPTIONS OF PLANT  *
072400*   STARTUP TO DETERMINE IF PLANT IS CARRYING    *
072500*   COMPANY AND PRIME ON PURCHASE ORDER          *
072600*   ACCOUNTING DATA                              *
072700**************************************************
072800
           MOVE "N"     TO  SAVE-PCPO-SW.
072900     MOVE "PCPO"  TO  PLT-ARG.
           MOVE PLT-ARG TO PLTINFOKEY OF MPLTINFO-REC-I.
           READ MPLTINFO-I INTO BUF-MPLTINFO
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
073300         MOVE "DBGET MPLTINFO 1-HSK PCPO"  TO  BU-DISPLAY-MSG
073400         MOVE PLT-ARG             TO BU-DISPLAY-FLD (1)
073500         GO TO 2-BLOWUP.
           IF MPLTINFO-PCPO-SW = " "
               MOVE "N"              TO  SAVE-PCPO-SW
           ELSE
073600     MOVE MPLTINFO-PCPO-SW     TO  SAVE-PCPO-SW.

      *-------- GET SWITCH TO INDICATE IF RELEASE VALUE SHOULD BE
      *-------- CHECKED AGAINST THE MINIMUM ORDER VALUE FOR THE VENDOR.
           MOVE "PODL"  TO  PLT-ARG.
           MOVE PLT-ARG TO  PLTINFOKEY OF MPLTINFO-REC-I.
           READ MPLTINFO-I INTO BUF-MPLTINFO
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS = "00"
               MOVE MPLTINFO-CHECK-RLS-VAL
                                     TO  SAVE-CHECK-RLS-VAL
           ELSE
               MOVE "N"              TO  SAVE-CHECK-RLS-VAL.

           IF SAVE-CHECK-RLS-VAL = "Y"
               OPEN I-O DSHIPREL-RL-O
           ELSE
               OPEN I-O DSHIPREL-O.

072200**************************************************
072300*   RETRIEVE CHAT-SW FROM USER OPTIONS OF PLANT  *
072400*   STARTUP TO DETERMINE IF PLANT WILL RECORD    *
072500*   CHAT NUMBERS FOR CSIS CODED ITEM DOCUMENTS.  *
072700**************************************************
072800
           MOVE "N"     TO  SAVE-CHAT-SW.
072900     MOVE "CHAT"  TO  PLT-ARG.
           MOVE PLT-ARG TO PLTINFOKEY OF MPLTINFO-REC-I.
           READ MPLTINFO-I INTO BUF-MPLTINFO
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE "N"                      TO  SAVE-CHAT-SW
           ELSE
073600     MOVE MPLTINFO-CHAT-PURCH-REQUIRED TO  SAVE-CHAT-SW.

072200**************************************************
072300*                                                *
072400*   GET CO. AND PRIME FROM MPLTINFO              *
072500*   USING 'P 01' AS THE ARGUMENT                 *
072600*                                                *
072700**************************************************
072800
072900     MOVE "P 01"  TO  PLT-ARG.
           MOVE PLT-ARG TO PLTINFOKEY OF MPLTINFO-REC-I.
           READ MPLTINFO-I INTO BUF-MPLTINFO
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
073300         MOVE "DBGET MPLTINFO 1-HSK P 01"  TO  BU-DISPLAY-MSG
073400         MOVE PLT-ARG             TO BU-DISPLAY-FLD (1)
               GO TO 2-BLOWUP.

DCR01      MOVE MPLTINFO-COMPANY TO  WS-Z000-PLANT-CODE.
           MOVE MPLTINFO-COMPANY     TO  COMPANY-SAVE,
073700                                   PRT-CO.
073800
073900********************************************
074000*
074100*   GET SHIPPING RELEASE PRINTER NUMBER
074200*
074300********************************************
074400
074500     MOVE SPACES               TO  PO-PRINT-PARMS.
074600     MOVE 9                    TO  SPOOL-PRINT-NUM,
                                         SAVE-SPOOL-PRINT-NUM.
074700     MOVE "POPT"         TO  PLT-ARG.
           MOVE PLT-ARG TO PLTINFOKEY OF MPLTINFO-REC-I.
           READ MPLTINFO-I INTO BUF-MPLTINFO
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
075200             NEXT SENTENCE
075300         ELSE
075400             MOVE "GET MPLTINFO 'POPT'*1HSK" TO BU-DISPLAY-MSG
075500             MOVE PLT-ARG  TO  BU-DISPLAY-FLD (1)
075600             GO TO 2-BLOWUP
075700     ELSE
               IF MPLTINFO-SHIP-REL-PRT-NO NOT = SPACES
036600             MOVE MPLTINFO-SHIP-REL-PRT-NO TO SPOOL-PRINT-NUM
                                                    SAVE-SPOOL-PRINT-NUM
               ELSE
      *------------- UPDATE SHIP REL PRINTER IF NOT DEFINED
                   MOVE MPLTINFO-PO-PRT-NO TO SPOOL-PRINT-NUM
                                              MPLTINFO-SHIP-REL-PRT-NO
                                              SAVE-SPOOL-PRINT-NUM
                   OPEN I-O MPLTINFO
035500             MOVE "POPT"                  TO  PLT-ARG
                   MOVE PLT-ARG TO PLTINFOKEY OF MPLTINFO-REC
                   READ MPLTINFO
                       INVALID KEY MOVE FILE-STATUS TO FILE-STATUS
                   END-READ
                   REWRITE MPLTINFO-REC FROM BUF-MPLTINFO
                       INVALID KEY MOVE FILE-STATUS TO FILE-STATUS
                   END-REWRITE
                   CLOSE MPLTINFO
               END-IF
           END-IF.
076000
092200**********************************************
092300*  FIND OUT IF THE USER IS USING ISO 9000
092400*  REVIEW OF PURCHASE ORDERS PRIOR TO THEIR
      *  BEING PRINTED/FAXED
092500**********************************************
092600
092700     MOVE "ISO "       TO PLT-ARG.
           MOVE 0 TO COND-WORD.
           MOVE PLT-ARG TO PLTINFOKEY OF MPLTINFO-REC-I.
           READ MPLTINFO-I INTO BUF-MPLTINFO INVALID KEY
                MOVE 17 TO COND-WORD.
           IF FILE-STATUS-1 = "2"
               MOVE 17 TO COND-WORD
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD.
093000     IF COND-WORD NOT = 0
093100         IF COND-WORD = 17
093200             MOVE SPACES TO ISO-9000-PRINT-SW
093300         ELSE
093400         MOVE "GET MPLTINFO 'IS0 ' *1-HSK" TO BU-DISPLAY-MSG
093500         MOVE PLT-ARG             TO BU-DISPLAY-FLD (1)
093600         GO TO 2-BLOWUP
093700     ELSE
093800     MOVE ISO-9000-ON-OFF       TO  ISO-9000-PRINT-SW.

