200600     ELSE
200700     IF PROCESS-INC-OPTION2 OR PROCESS-INC-OPTION2X
200800         MOVE PROCESS-INCLUDE-DETAIL-LINE
200900             TO  RELEASE-REPORT-LINE
201000     ELSE
201100     IF PROCESS-EXC-OPTION2 OR PROCESS-EXC-OPTION2X
201200         MOVE PROCESS-EXCLUDE-DETAIL-LINE
201300             TO  RELEASE-REPORT-LINE.
201400     PERFORM 5-WRITE-CONTROL-REPORT-LINE.
201500     IF PROCESS-ALL-OPTION2 OR PROCESS-ALL-OPTION2X
201600         GO TO 64-WCP-X.
201700     MOVE ZEROS  TO  SUB1.
201800     MOVE SPACES TO  SELECTION-REQUIRE-ORDERS-TABLE.
201900
202000 64-WRITE-SELECT-CRITERIA-LOOP.
202100     ADD 1  TO  SUB1.
202200     IF SUB1 > 999
202300         NEXT SENTENCE
202400     ELSE
202500         MOVE REQUIRE-SEL-ENTRY (SUB1)
202600             TO  REQUIRE-SELECTED-ENTRIES-OUT (SUB1)
202700         GO TO 64-WRITE-SELECT-CRITERIA-LOOP.
202800     MOVE SELECTION-REQUIRE-ORDERS-TABLE
202900         TO  RELEASE-REPORT-LINE.
           MOVE 2 TO REL-CTL.
203000     PERFORM 5-WRITE-CONTROL-REPORT-LINE.
203100
203200 64-WCP-X.
203300     EXIT.
203400
203500**********************************************************
203600**  THIS ROUTINE MOVES ANY DPODATAITM ENTRIES FOUND FOR
203700**  ITEM UNDER THE REQUIREMENT ORDER AN PUTS THEM IN
203800**  A TEMPORARY TABLE SO LATER THEY CAN BE PLACED IN
203900**  DPODATAITM UNDER THE SHIPPING RELEASE NUMBER.
204000**********************************************************
204100
204200 65-COPY-DPODATAITMS.
204300     MOVE "999"                   TO  PO-RLSE.
204400     MOVE BUILD-PO-NUM            TO  PO-ARG.
204500     MOVE SAVE-LAST-RLSE          TO  PO-RLSE.
           MOVE PO-ARG TO PORCVNO OF DPODATAITM-REC-O.
           START DPODATAITM-O KEY = PORCVNO OF DPODATAITM-REC-O
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
                   NEXT SENTENCE
               ELSE
204900             MOVE "FIND DPODATAITM*65-CD" TO BU-DISPLAY-MSG
205000             MOVE PO-ARG              TO  BU-DISPLAY-FLD (1)
205100             GO TO 2-BLOWUP.
205200
205300     MOVE ZEROS                   TO  SUB1.
205400
205500 65-GET-DPODATAITM.
           READ DPODATAITM-O NEXT INTO BUF-DPODATAITM
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   GO TO 65-CD-X
               ELSE
206200             MOVE "GET DPODATAITM *65-GD" TO BU-DISPLAY-MSG
206300             MOVE PO-ARG          TO  BU-DISPLAY-FLD (1)
206400             GO TO 2-BLOWUP.
           IF PORCVNO OF DPODATAITM-REC-O NOT = PO-ARG
               GO TO 65-CD-X.
206500     IF DATAITM-ITEM-NO = ITM-NUMBER
206600         ADD 1                    TO  SUB1
206700         MOVE DATAITM-INFO        TO  DPODATAITM-LINE (SUB1)
206800     ELSE
206900     IF DATAITM-ITEM-NO < ITM-NUMBER
207000         NEXT SENTENCE
207100     ELSE
207200         GO TO 65-CD-X.
207300
207400     GO TO 65-GET-DPODATAITM.
207500
207600 65-CD-X.
207700     EXIT.
207800
207900***************************************************************
208000**   THIS ROUTINE CHECKS FOR ADDITIONAL DESCRIPTION AND PUTS **
208100**   THEM IN THE SAME TABLE AS THE DPODATAITM DESC FROM THE  **
208200**   ITEM                                                    **
208300***************************************************************
208400
208500 65-CHECK-FOR-ADDTL-DESC.
           IF REL-ITEM-SEQ-NO = 99
               MOVE SPACE           TO  REL-HOLD
               MOVE REL-LINE-DATA   TO  STD-INST-SAVED
               PERFORM 621-READ-REL-FILE  THRU 621-RRF-X
           ELSE
208600     IF REL-ITEM-SEQ-NO = ZEROS
208700         MOVE "ITEM-SEQ-NO =0 *65-CFAD" TO BU-DISPLAY-MSG
208800         MOVE REL-BLANKET-NO TO BU-DISPLAY-FLD (1)
208900         MOVE REL-ITEM-NO    TO BU-DISPLAY-FLD (2)
209000         GO TO 2-BLOWUP
209100      ELSE
209200          ADD 1               TO  SUB1
209300          MOVE REL-LINE-DATA  TO  DPODATAITM-LINE (SUB1)
209400          PERFORM 621-READ-REL-FILE  THRU 621-RRF-X.
209500
209600 65-CFAD-X.
209700     EXIT.
209800
209900***************************************************************
210000**   THIS ROUTINE PUTS ALL THE DPODATAITM DESC/COMMENT LINES **
210100**   FOR THE ITEM OUT UNDER THE SHIPPING RELEASE ENTRY       **
210200***************************************************************
210300
210400 65-PROCESS-DPODATAITM.
210500     IF SUB1 = ZEROS
210600         GO TO 65-PD-X.
211700
211800     MOVE ZEROS                   TO  SUB2.
211900     MOVE SPACES                  TO  BUF-DPODATAITM.
212000     MOVE BUILD-PO-NUM            TO  DATAITM-PO-RCV-NO.
212100
212200 65-PUT-DPODATAITM.
212300     ADD 1                        TO  SUB2.
212400     IF SUB2 > SUB1
212500         GO TO 65-UNLOCK-DPODATAITM.
212600     MOVE ITM-NUMBER              TO  DATAITM-ITEM-NO.
      *---------- ONLY USE LAST 2 DIGITS OF SUB2.
212700     MOVE SUB2 (3:2)              TO  DATAITM-LINE-NO.
212800     MOVE DPODATAITM-LINE (SUB2)  TO  DATAITM-INFO.
           WRITE DPODATAITM-REC-O FROM BUF-DPODATAITM
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
213200         MOVE "PUT DPODATAITM *65-PD" TO BU-DISPLAY-MSG
213300         MOVE BUILD-PO-NUM        TO  BU-DISPLAY-FLD (1)
213400         GO TO 2-BLOWUP.
213500
213600     GO TO 65-PUT-DPODATAITM.
213700
213800 65-UNLOCK-DPODATAITM.
214500     IF ITM-CORP-CODE = "NON-STR"
214600         PERFORM 651-CUT-TC370  THRU  651-CT370-X.
214700
214800 65-PD-X.
214900     EXIT.
215000
215100 651-CUT-TC370.
215800     MOVE SPACES                  TO  BUF-DDAILYTC.
215900     MOVE CUR-DATE                TO  DDAILYTC-DATE.
216000     ACCEPT DDAILYTC-TIME FROM TIME.
216100     MOVE "370"                   TO  DDAILYTC-TC.
216200     MOVE COMPANY-SAVE            TO  DDAILYTC-PLT.
216300     MOVE BUILD-PO-NUM            TO  TC370-PO-RLS.
216400     MOVE ITM-NUMBER              TO  TC370-ITEM-NO.
216500     MOVE "01"                    TO  TC370-LINE-NO.
216600     MOVE DPODATAITM-LINE (1)     TO  TC370-NONCODED-DESC.
           WRITE DDAILYTC-REC-O FROM BUF-DDAILYTC
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
217000         MOVE "PUT DDAILYTC * 651-CT370" TO BU-DISPLAY-MSG
217100         GO 2-BLOWUP.
217200
217900 651-CT370-X.
218000     EXIT.

DCR01  COPY POLOGSUBR2 IN COPYLIB.
