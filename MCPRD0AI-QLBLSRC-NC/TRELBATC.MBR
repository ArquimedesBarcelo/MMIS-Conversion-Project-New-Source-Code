097200     EXIT.
097300
      *-------- NOTE: IF A CHANGE IS MADE TO 61-READ-SHIPREL, MAKE
      *--------       THE SAME CHANGE TO 61B-READ-SHIPREL.
097400 61-READ-SHIPREL.
           READ DSHIPREL-O NEXT INTO BUF-DSHIPREL
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14"
099200             GO TO 61-CLOSE-REL-FILE
099300         ELSE
099400             MOVE "GET DSHIPREL 61-GM" TO BU-DISPLAY-MSG
099500             GO TO 2-BLOWUP.
099600
099700     IF PROCESS-ALL-OPTION2 OR PROCESS-ALL-OPTION2X
099800         NEXT SENTENCE
099900     ELSE
100000         PERFORM 611-SELECTION-PROCESS  THRU  611-SP-X
100100         IF ENTRY-QUALIFIES = "Y"
100200             NEXT SENTENCE
100300         ELSE
100400             GO TO 61-READ-SHIPREL.
100500
           IF PROCESS-ALL-OPTION2X OR
               PROCESS-INC-OPTION2X OR PROCESS-EXC-OPTION2X
                  IF DREL-HOLD = "H"
                      NEXT SENTENCE
                  ELSE
                  GO TO 61-READ-SHIPREL
           ELSE
           IF DREL-HOLD = " "
               NEXT SENTENCE
           ELSE
           GO TO 61-READ-SHIPREL.

100600     MOVE DREL-DSHIPREL-CODE      TO  REL-CORP-CODE.
100700     MOVE DREL-NUMBER             TO  REL-BLANKET-NO.
100800     MOVE DREL-ITEM-NO            TO  REL-ITEM-NO.
100900     MOVE DREL-SEQ-NO             TO  REL-ITEM-SEQ-NO.
101000     MOVE DREL-LINE-DATA          TO  REL-LINE-DATA.
           IF SAVE-CHAT-SW = "Y"
               MOVE DREL-CHAT-NO        TO  REL-CHAT-NO
           ELSE
           MOVE SPACES                  TO  REL-CHAT-NO.
           MOVE DREL-NOTIFY-USERID      TO  REL-NOTIFY-USERID.
101100     WRITE REL-RCD.

           DELETE DSHIPREL-O
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
104400         MOVE "DELETE DSHIPREL 61-GMFD" TO BU-DISPLAY-MSG
104500         GO TO 2-BLOWUP.

101200     GO TO 61-READ-SHIPREL.
101300
101400 61-CLOSE-REL-FILE.
101500     CLOSE REL-FILE.
106100
106200 61-RS-X.
106300     EXIT.
106400
      *-------- PARAGRAPH FOR PLANTS VALIDATING RELEASE VALUE AGAINST
      *-------- VENDOR'S MINIMUM ORDER VALUE.
       61B-READ-SHIPREL.
           READ DSHIPREL-RL-O NEXT INTO BUF-DSHIPREL
               AT END MOVE FILE-STATUS TO FILE-STATUS.

       61B-PROCESS-SHIPREL.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14"
                   GO TO 61B-CLOSE-REL-FILE
               ELSE
                   MOVE "GET DSHIPREL 61B-GM" TO BU-DISPLAY-MSG
                   GO TO 2-BLOWUP.

           IF PROCESS-ALL-OPTION2 OR PROCESS-ALL-OPTION2X
               NEXT SENTENCE
           ELSE
               PERFORM 611-SELECTION-PROCESS  THRU  611-SP-X
               IF ENTRY-QUALIFIES = "Y"
                   NEXT SENTENCE
               ELSE
                   GO TO 61B-READ-SHIPREL.

           IF PROCESS-ALL-OPTION2X OR
               PROCESS-INC-OPTION2X OR PROCESS-EXC-OPTION2X
                  IF DREL-HOLD = "H"
                      NEXT SENTENCE
                  ELSE
                  GO TO 61B-READ-SHIPREL
           ELSE
           IF DREL-HOLD = " "
               NEXT SENTENCE
           ELSE
           GO TO 61B-READ-SHIPREL.

           PERFORM 61B-MOVE-DREL.

      *---------- DO NOT CALL SCHKRLSV IF THIS IS A REPAIR ORDER.
           MOVE "N"                 TO  REPAIR-SW.
           PERFORM VARYING SUBR FROM 8 BY -1 UNTIL SUBR = 3
                                                OR REPAIR-SW = "Y"
               IF DREL-NUMBER (SUBR:1) = "M" OR "W" OR "C"
                   MOVE "Y"         TO  REPAIR-SW
                                        SCHKRLSV-MIN-ORD-SW
               END-IF
           END-PERFORM.

      *---------- SEE IF ORDER MEETS VENDOR'S MINIMUM ORDER VALUE.
           IF DREL-SEQ-NO = 0 AND REPAIR-SW = "N"
               MOVE DREL-NUMBER     TO  SCHKRLSV-PO-NUM
               MOVE SPACES          TO  SCHKRLSV-MIN-ORD-SW
                                        SCHKRLSV-VENDOR-CODE
                                        SCHKRLSV-BUYER-CODE
               MOVE 0               TO  SCHKRLSV-MIN-ORD
                                        SCHKRLSV-REL-VAL
               CALL "SCHKRLSV" USING SCHKRLSV-PARMS
               MOVE DREL-NUMBER     TO  LAST-PO-CHKD
               EVALUATE SCHKRLSV-MIN-ORD-SW
                 WHEN "S"
                   GO TO 61B-READ-SHIPREL
                 WHEN "N"
                   PERFORM 621-MIN-ORDER-ERROR THRU 621-MOE-X
                   GO TO 61B-READ-SHIPREL.

           IF SCHKRLSV-MIN-ORD-SW = "Y" AND REPAIR-SW = "N"
               PERFORM UNTIL DREL-NUMBER NOT = LAST-PO-CHKD
                          OR FILE-STATUS NOT = "00"
                   PERFORM 61B-MOVE-DREL
                   WRITE REL-RCD
                   DELETE DSHIPREL-RL-O
                       INVALID KEY MOVE FILE-STATUS TO FILE-STATUS
                   END-DELETE
                   IF FILE-STATUS NOT = "00"
                       MOVE "DELETE DSHIPREL 61B-GMFD" TO BU-DISPLAY-MSG
                       GO TO 2-BLOWUP
                   END-IF
                   READ DSHIPREL-RL-O NEXT INTO BUF-DSHIPREL
                       AT END MOVE FILE-STATUS TO FILE-STATUS
                   END-READ
               END-PERFORM
