080900 5-WRITE-CONTROL-REPORT-LINE.
081000     IF REL-LINE-CTR > 52
               MOVE RELEASE-REPORT-LINE  TO  SAVE-REPORT-LINE
               MOVE 2                    TO  REL-CTL
               MOVE RELEASE-TRLR         TO  RELEASE-REPORT-LINE
               WRITE RELEASE-REPORT-RCD
               MOVE SAVE-REPORT-LINE     TO  RELEASE-REPORT-LINE
081100         PERFORM 5-WRITE-CONTROL-REPORT-HEADER.
081200     ADD REL-CTL  TO  REL-LINE-CTR.
081300     WRITE RELEASE-REPORT-RCD.
081400
081500 5-WRITE-CONTROL-REPORT-HEADER.
081600     MOVE RELEASE-REPORT-LINE      TO  SAVE-REPORT-LINE.
081700     MOVE ZERO                     TO  REL-CTL,
081800                                       REL-LINE-CTR.
081900     ADD 1                         TO  REL-PAGE-CTR.
082000     MOVE REL-PAGE-CTR             TO  PAGE-NO-OUT.
082100     MOVE CONTROL-HEADER           TO  RPT-HEADER.
082200     MOVE HEADER-1                 TO  RELEASE-REPORT-LINE.
082300     WRITE RELEASE-REPORT-RCD.
082400     MOVE RELEASE-HEADER-1         TO  RELEASE-REPORT-LINE.
082500     MOVE 2                        TO  REL-CTL.
082600     WRITE RELEASE-REPORT-RCD.
           IF SAVE-PCPO-SW = "Y"
               MOVE RELEASE-HEADER-2L    TO  RELEASE-REPORT-LINE
           ELSE
082700     MOVE RELEASE-HEADER-2         TO  RELEASE-REPORT-LINE.
082800     MOVE 1                        TO  REL-CTL.
082900     WRITE RELEASE-REPORT-RCD.
083000     MOVE DASH-LINE                TO  RELEASE-REPORT-LINE.
           MOVE 1                        TO  REL-CTL.
083100     WRITE RELEASE-REPORT-RCD.
083200     MOVE SAVE-REPORT-LINE         TO  RELEASE-REPORT-LINE.
           MOVE 1                        TO  REL-CTL.
083300
083400 5-WRITE-ERROR-REPORT-LINE.
083500     IF ERR-LINE-CTR > 54
083600         PERFORM 5-WRITE-ERROR-REPORT-HEADER.
083700     MOVE 2  TO  ERR-CTL.
083800     ADD 2   TO  ERR-LINE-CTR.
           IF SAVE-PCPO-SW = "Y"
               MOVE ERROR-DETAIL-LINE1-L TO ERROR-REPORT-LINE
           ELSE
083900     MOVE ERROR-DETAIL-LINE1   TO  ERROR-REPORT-LINE.
084000     WRITE ERROR-REPORT-RCD.
084100     MOVE 1  TO  ERR-CTL.
084200     ADD  1  TO  ERR-LINE-CTR.
084300     MOVE ERROR-DETAIL-LINE2   TO  ERROR-REPORT-LINE.
084400     WRITE ERROR-REPORT-RCD.
084500
      *------ PRINTS SECOND LINE OF VENDOR INFORMATION AFTER
      *------ RELEASE ITEM INFORMATION.
       5-WRITE-ERROR-REPORT-LINE-2.
           IF ERR-LINE-CTR > 54
               PERFORM 5-WRITE-ERROR-REPORT-HEADER.
           MOVE 2  TO  ERR-CTL.
           ADD 2   TO  ERR-LINE-CTR.
           IF SAVE-PCPO-SW = "Y"
               MOVE ERROR-DETAIL-LINE1-L  TO ERROR-REPORT-LINE
           ELSE
           MOVE ERROR-DETAIL-LINE1        TO  ERROR-REPORT-LINE.
           WRITE ERROR-REPORT-RCD.
      *--------- VENDOR INFO.
           MOVE 1  TO  ERR-CTL.
           ADD  1  TO  ERR-LINE-CTR.
           MOVE MIN-ORDER-VENDOR-LINE     TO  ERROR-REPORT-LINE.
           WRITE ERROR-REPORT-RCD.
           MOVE 1  TO  ERR-CTL.
           ADD  1  TO  ERR-LINE-CTR.
           MOVE ERROR-DETAIL-LINE2        TO  ERROR-REPORT-LINE.
           WRITE ERROR-REPORT-RCD.

084600 5-WRITE-ERROR-REPORT-HEADER.
084700     MOVE ZEROS          TO  ERR-LINE-CTR,
084800                             ERR-CTL.
084900     ADD 1               TO  ERR-PAGE-CTR.
085000     MOVE ERR-PAGE-CTR   TO  PAGE-NO-OUT.
085100     MOVE ERROR-HEADER   TO  RPT-HEADER.
085200     MOVE HEADER-1       TO  ERROR-REPORT-LINE.
085300     WRITE ERROR-REPORT-RCD.
085400     MOVE ERROR-HEADER-1 TO  ERROR-REPORT-LINE.
085500     MOVE 2              TO  ERR-CTL.
085600     WRITE ERROR-REPORT-RCD.
085700     MOVE DASH-LINE      TO  ERROR-REPORT-LINE.
085800     MOVE 1              TO  ERR-CTL.
085900     WRITE ERROR-REPORT-RCD.
086000
