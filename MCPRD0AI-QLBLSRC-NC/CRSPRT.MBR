      *---GET BEFORE AND AFTER RCV INSTRUCTIONS
      *---  STORED IN DPODATAITM "000002" SEQ NO
       600-GET-RCV-INST.
           MOVE SPACES TO RCV-INSTRUCTIONS.
           MOVE PO-ARG TO PORCVNO OF DPODATAITM-REC.
           MOVE "000002" TO ITEMSEQNO OF DPODATAITM-REC.
           READ DPODATAITM INTO BUF-DPODATAITM
               AT END MOVE 17 TO COND-WORD.
           IF FILE-STATUS = "00"
               MOVE DATAITM-INFO  TO  RCV-INSTRUCTIONS.
       600-GRI-X.
           EXIT.


      *---- PRINT BEFORE/AFTER RCV INSTRUCTIONS
       601-PRINT-RCV-INST.
            MOVE RCV-INST-NO(SUB) TO RECEIVE-INSTRUCTION.
            PERFORM 601-PRINT-INST THRU 601-PI-X.
       601-PRI-X.
           EXIT.

       601-PRINT-ITM-RCV-INST.
           MOVE ITM-RCV-STD-INSTR(SUB) TO RECEIVE-INSTRUCTION.
           PERFORM 601-PRINT-INST THRU 601-PI-X.
       601-PIRI-X.
           EXIT.

       601-PRINT-INST.
           IF RECEIVE-INSTRUCTION = SPACES
               GO TO 601-PI-X.

           MOVE RECEIVE-INSTRUCTION TO BUILD-COM-NO.
           MOVE BUILD-COMMENT-NO TO COMMENT-ARG.
           MOVE 0 TO COND-WORD.
           MOVE COMMENT-ARG TO MCOMCOMMNT OF DCOMMENT-REC.
           START DCOMMENT KEY = MCOMCOMMNT OF DCOMMENT-REC
               INVALID KEY MOVE 17 TO COND-WORD.
           IF FILE-STATUS NOT = "00"
               GO TO 601-PI-X.

       601-GET-DCOMMENT.
           MOVE 0 TO COND-WORD.
           READ DCOMMENT NEXT INTO BUF-DCOMMENT
               AT END MOVE 15 TO COND-WORD.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   GO TO 601-PI-X
               ELSE
                   MOVE "READ DCOMMENT *601-PI" TO  BU-DISPLAY-MSG
                   MOVE COMMENT-ARG           TO  BU-DISPLAY-FLD (2)
                   PERFORM 990-BLOWUP THRU 999-EXIT.
           IF MCOMCOMMNT OF DCOMMENT-REC NOT = COMMENT-ARG
               GO TO 601-PI-X.

           MOVE 1                       TO  LINE-ADV.
           ADD  1 TO LINE-CTR.
           MOVE SPACES                  TO  PRTWK-AREA.
           IF EXP-PRT-START = "*EXP*"
               MOVE EXPAND-1            TO  PRTWK-STD-INST-EXP-START
               MOVE EXP-DATA-COMMENT    TO  PRTWK-STD-INST-EXP
               MOVE EXP-1-OFF           TO  PRTWK-STD-INST-EXP-END
           ELSE
           IF EXP-PRT-START = "*CMP*"
               MOVE COMPRESS-1-1        TO  PRTWK-STD-INST-COMP-START
               MOVE COMP-DATA-COMMENT   TO  PRTWK-STD-INST-COMP
               MOVE NORMAL-1A           TO  PRTWK-STD-INST-COMP-END
           ELSE
               MOVE DCOM-DATA-LINE      TO  PRTWK-STD-INST.
           MOVE SPACES                  TO  PRINT-RCD.
           MOVE PRTWK-STD-INST-LINE     TO  PRINT-RCD.
           PERFORM 860-PRT-LINE THRU 869-EXIT.

           GO TO 601-GET-DCOMMENT.
       601-PI-X.
           EXIT.

