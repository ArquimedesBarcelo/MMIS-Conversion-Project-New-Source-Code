                 MOVE 0 TO COND-WORD
                 MOVE EMPL-ARG TO PERCCNUM OF PER-PERSONNEL-REC
                 READ PER-PERSONNEL INTO BUF-PER-PERSONNEL
                    INVALID KEY MOVE 17 TO COND-WORD
                 END-READ
                    IF FILE-STATUS-1 = "2"
                       MOVE 17 TO COND-WORD
                    ELSE
                       IF FILE-STATUS NOT = "00"
                          MOVE 99 TO COND-WORD
                       END-IF
              END-IF
              IF GOOD-CALL
                  MOVE PER-EMP-NAME TO PRT-REQ-ORIG-NAME
              ELSE
                  IF NO-ENTRY
                      MOVE SPACES TO PRT-REQ-ORIG-NAME
                  ELSE
                      MOVE "DBGET ERR PERSONNEL 534-CHECK-HOLD-ITEM" TO
                        BU-DISPLAY-MSG
                      PERFORM 990-BLOWUP THRU 999-EXIT
                  END-IF
              END-IF
