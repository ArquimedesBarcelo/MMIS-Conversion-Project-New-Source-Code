189700     PERFORM 860-PRT-LINE THRU 869-EXIT.
189800
189900     IF DISP-FRT-PO NOT = SPACES
190000         MOVE DISPLAY-FRT-REFER TO PRT-PRIOR-RS
               MOVE HDR-1A   TO PLINE
190200         MOVE 2                 TO LINE-ADV
190300         PERFORM 860-PRT-LINE THRU 869-EXIT.
           MOVE  HDR-2      TO PLINE.
190500     MOVE 1 TO LINE-ADV.
190600     PERFORM 860-PRT-LINE THRU 869-EXIT.
           MOVE HDR-2A     TO   PLINE.
190800     MOVE 1                   TO   LINE-ADV.
190900     PERFORM 860-PRT-LINE THRU 869-EXIT.
           MOVE HDR-2B    TO   PLINE.
191100     MOVE 1                  TO   LINE-ADV.
191200     PERFORM 860-PRT-LINE THRU 869-EXIT.
           MOVE HDR-2C    TO   PLINE.
191400     MOVE 1 TO LINE-ADV.
191500     PERFORM 860-PRT-LINE THRU 869-EXIT.
           MOVE HDR-2D    TO   PLINE.
191700     MOVE 2                  TO   LINE-ADV.
191800     PERFORM 860-PRT-LINE THRU 869-EXIT.
           MOVE  HDR-3      TO PLINE.
192000     MOVE 2 TO LINE-ADV.
192100     PERFORM 860-PRT-LINE THRU 869-EXIT.
192200     IF PRT-Z-BILL  = SPACES
192300         NEXT SENTENCE
192400     ELSE
               MOVE PRT-Z-BILL-NO TO PLINE
192600         MOVE 2             TO LINE-ADV
192700         PERFORM 860-PRT-LINE THRU 869-EXIT.
192800
           MOVE PRT-PO-DATA TO   PLINE.
193000     MOVE 1                   TO  LINE-ADV.
193100     PERFORM 860-PRT-LINE THRU 869-EXIT.
193200
           MOVE HDR-4A TO PLINE.
193400     MOVE 2                   TO   LINE-ADV.
193500     PERFORM 860-PRT-LINE THRU 869-EXIT.
193600*************************************************************
193700*         RETRIEVE VENDOR INFORMATION FOR THE REPORT        *
193800*************************************************************
193900     MOVE VEN-LIT-SAVE        TO   VEN-LIT.
194000     MOVE VEN-ARG             TO   PRT-VEN-ADDR.
194100     MOVE 1                   TO   LINE-ADV.
           MOVE HDR-5      TO   PLINE.
194300     PERFORM 860-PRT-LINE THRU 869-EXIT.
194400
194500     MOVE SPACES              TO   PRT-BUYER, BUYER-LIT.
194600
           MOVE 0 TO COND-WORD.
           MOVE VEN-ARG TO VENCDE OF DVENDOR-REC.
           START DVENDOR KEY = VENCDE OF DVENDOR-REC
               INVALID KEY MOVE 17 TO COND-WORD.
           IF FILE-STATUS = "00" OR FILE-STATUS-1 = "2"
               MOVE 0 TO COND-WORD
           ELSE
               MOVE 99 TO COND-WORD.
194900     IF NOT GOOD-CALL
195000           MOVE "DBFIND DVENDOR -SRSPRT  " TO BU-DISPLAY-MSG
195100           MOVE VEN-ARG                     TO BU-DISPLAY-FLD (5)
195200           PERFORM 990-BLOWUP THRU 999-EXIT.
195400
195500 885-LOAD-VEN-DATA-FOR-PRT.
           MOVE 0 TO COND-WORD.
           READ DVENDOR NEXT INTO BUF-DVENDOR
               AT END MOVE 15 TO COND-WORD.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   MOVE 15 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.
           IF VENCDE OF DVENDOR-REC NOT = VEN-ARG
               MOVE 15 TO COND-WORD.
195800     IF NOT GOOD-CALL
195900         GO TO 886-PRINT.
196000
196100     IF VEN-ITM-NO = "00" OR "07"
196200       IF VEN-ITM-NO = "00"
196300         MOVE SELLER-LIT-SAVE  TO  VEN-LIT
196400         MOVE VEN-NAME         TO  PRT-VEN-ADDR
196500         MOVE 1                TO  LINE-ADV
196600       ELSE
196700         MOVE SPACES           TO  VEN-LIT
196800         MOVE VEN-07-RCD       TO  PRT-VEN-ADDR
196900         MOVE 3                TO  LINE-ADV
197000     ELSE
197100       GO TO 885-LOAD-VEN-DATA-FOR-PRT.
197200
           MOVE HDR-5    TO  PLINE.
197400     PERFORM 860-PRT-LINE THRU 869-EXIT.
197500     GO TO 885-LOAD-VEN-DATA-FOR-PRT.
197600
197700 886-PRINT.
      *----------  PRINT BEFORE RECEIVER INSTRUCTIONS
           IF RCV-BEFORE-INST NOT = SPACES
              PERFORM 601-PRINT-RCV-INST THRU 601-PRI-X
                 VARYING SUB FROM 1 BY 1
                   UNTIL SUB > 6
              MOVE 1 TO LINE-ADV
              ADD  1 TO LINE-CTR
              MOVE SPACES TO PRINT-RCD
              PERFORM 860-PRT-LINE THRU 869-EXIT.

197800     IF PRINT-PRICE-SW = "Y"
197900        MOVE PRICE-QTY-SAVE TO PRICE-QTY-TITLE
198000     ELSE
198100        MOVE SPACES TO PRICE-QTY-TITLE.
198200
           MOVE  HDR-6      TO PLINE.
198400     MOVE 1           TO LINE-ADV.
198500     PERFORM 860-PRT-LINE THRU 869-EXIT.
           MOVE HDR-7  TO PLINE.
198700     PERFORM 860-PRT-LINE THRU 869-EXIT.
198800
198900 889-EXIT.  EXIT.

       COPY OVRPFCALL IN COPYLIB.
200100 990-BLOWUP.
200200     MOVE "CRSPRT"    TO BU-PGM-NAME.
200300     MOVE MISC-RS-ARG TO BU-DISPLAY-FLD (1).
200400     MOVE PO-ARG TO BU-DISPLAY-FLD (2).
200500     MOVE CODE-ARG TO BU-DISPLAY-FLD (3).
200600     CALL "TBLOWUP" USING BASE, BU-PGM-NAME, STATUS-AREA,
200700          VIEW-COMAREA, FILE-STATUS, BU-DISPLAY-MSG,
200800           BU-DISPLAY-FLDS.
200900 999-EXIT.  EXIT.
201000
201100 999-CATREAD.
           IF CATREAD-MSG-NUMBER = ZEROS
               MOVE LANG-SETNUM TO CATREAD-MSG-SET
               MOVE LANG-MSGNUM TO CATREAD-MSG-NUM.
           CALL "CCATREAD" USING CATREAD-PARMS.
           MOVE CATREAD-MSG-TEXT TO MESSAGE-BUFFER.
202700 999-CATREAD-EXIT.  EXIT.
