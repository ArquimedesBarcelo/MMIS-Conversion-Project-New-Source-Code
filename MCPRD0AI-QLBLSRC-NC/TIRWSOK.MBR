055300
055400 COPY DBSTAT     IN COPYLIB.
055500 COPY VCOMLINK   IN COPYLIB.
055600 COPY STCOM      IN COPYLIB.
055700 COPY TSHWSUB    IN COPYLIB.
055800 COPY LANGSUB    IN COPYLIB.
055900 COPY MULTSTR    IN COPYLIB.
056000 COPY ESCNAME   IN COPYLIB.
056100
056200 PROCEDURE DIVISION USING BASE MMIS-BASE STATUS-AREA
056300                          VIEW-COMAREA STORES-COMAREA
056400                          SRF-COMAREA, SRF-SPOOLER-REC,
056500                          LANGUAGE-PARMS, MULTIPLE-STR-DATA,
056600                          ESC-NAME.
056700
056800 MAIN-LINE-LOGIC.
056900
057000     PERFORM 1-INIT.
057100*
057200* GET AND CLEAR AND PROCESS THE FORM
057300*
057400     PERFORM 9999-GETNEXTFORM.
057500     PERFORM 9999-CLEAR-FORM-1.
057600
057700     PERFORM 9999-DO-SCREEN-1.
057800     MOVE DE-PRT-OPT          TO   SAVE-PRT-OPT.
057900     PERFORM UNTIL VIEW-LASTKEY NOT EQUAL F7-KEY
058000       PERFORM 9999-CLEAR-FORM-1
058100       PERFORM 9999-DO-SCREEN-1
058200     END-PERFORM.
058300
      *------ INITIALIZE WARNING-FLAG FOR TQTYEDIT TO BYPASS CHECKS
      *-----  FOR RETURN LIMITS
           MOVE "Y" TO WARNING-FLAG.
058400*
058500* PROCESS WORKSHEETS UNTIL REQUEST TO EXIT PROGRAM OR
058600* F1/F2 KEY PRESSED.
058700*
058800     PERFORM UNTIL VIEW-LASTKEY EQUAL EXIT-PROGRAM OR
058900                   VIEW-LASTKEY EQUAL F1-KEY       OR
059000                   VIEW-LASTKEY EQUAL F2-KEY
059100

059200       MOVE DE-WL-NO TO SHIFT-FLD
059300       CALL "TRSHIFT" USING RET-CODE, SHIFT-FLD
059400       MOVE SHIFT-FLD-5-8 TO DE-WL-NO
059500
059600       MOVE DE-WL-NO TO WRKL-NO-INC
059700*
059800* APPLY LOCKS TO WORKSHEET NUMBER JUST SELECTED
059900*
060000       MOVE WL-ARG TO LOCK-VALUE (1), LOCK-VALUE (2)
060100       MOVE 2 TO NUMBER-OF-LOCK-DESCRIPTORS
060200       PERFORM 9999-MULTI-LOCK
060300
060400*
060500* CHECK TO SEE IF THE WORKSHEET NUMBER EXISTS
060600*
             IF WRKL-NO-INC NOT = ZERO
060700           PERFORM 9999-GETKEY-MWRKLIST-WK-O
             END-IF
060800       IF NO-ENTRY OR WRKL-NO-INC EQUAL ZERO
060900         PERFORM 9999-UNLOCK
061000*
061100* W16: WORKSHEET DOES NOT EXIST
061200*
061300         MOVE 23 TO LANG-SETNUM
061400         MOVE 16 TO LANG-MSGNUM
061500*        MOVE 23016 TO CATREAD-MSG-NUMBER
061600         PERFORM 999-CATREAD
061700         MOVE MESSAGE-BUFFER TO MSG-TEXT
061800         MOVE WRKL-NO-INC TO MSG-FLD-9
061900         MOVE 1 TO SRF-ERROR-FLD
062000       ELSE
062100
062200*    "N72: NOW EDITING"
062300         MOVE 14 TO LANG-SETNUM
062400         MOVE 72 TO LANG-MSGNUM
062500*        MOVE 14072 TO CATREAD-MSG-NUMBER
062600         PERFORM 999-CATREAD
062700         MOVE "Y" TO SRF-MSG-AND-GO
062800         PERFORM 9999-SETERROR-1
062900
063000*
063100* THE WORKSHEET EXISTS -- PROCESS IT
063200*
063300         PERFORM 80-GET-WKSHEET
063400
063500*
063600* LOCK THE WORKSHEET, MSTORERM, DDAILYTC AND POSSIBLY DRESERVE
063700*
063800         COMPUTE NUMBER-OF-LOCK-DESCRIPTORS =
063900               3 + NUMBER-OF-WKSHEET-ENTRIES
064000
064100*
064200* IF AN ISSUE WS, AND IF THERE IS A WORKORDER, THERE IS
064300* A POSSIBILITY OF A RESERVATION UPDATE.  THEREFORE WE
064400* LOCK THE DRESERVE ENTRIES ALSO.
064500*
064600         IF SCOM-PGM-KEY EQUAL "SW4" AND HP
064700           PERFORM 81-BUILD-LOCKS-FOR-DRESERVE
064800         END-IF
064900         PERFORM 9999-UNLOCK
065000         PERFORM 9999-MULTI-LOCK
065100         PERFORM 82-VALIDATE-WORKSHEET
065200         IF MESSAGE-BUFFER-1 NOT EQUAL SPACE
065300
065400*
065500* IF AN ERROR EXISTS ON THE WORKSHEET DISPLAY ANOTHER FORM
065600* AND SPECIFY THE ERROR
065700*
065800           PERFORM 9999-RESET-MWRKLIST-WK-O
065900           PERFORM 9999-UNLOCK
066000           PERFORM 7-ERROR-ROUTINE THRU 7-ER-X
066100           IF VIEW-LASTKEY EQUAL F7-KEY
066200             IF SCOM-PGM-KEY = "SW4"
066300               MOVE "ISWSOK" TO VIEW-NFNAME
066400             ELSE
066500               MOVE "RTWSOK" TO VIEW-NFNAME
066600             END-IF
066700             PERFORM 9999-GETNEXTFORM
066800             PERFORM 9999-CLEAR-FORM-1
066900           END-IF
067000         ELSE
067100
067200*
067300* UPDATE MSTROERM AND DDAILYTC
067400*
067500           MOVE 14 TO LANG-SETNUM
067600           MOVE 2 TO LANG-MSGNUM
067700*          MOVE 14002 TO CATREAD-MSG-NUMBER
067800           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
067900           MOVE "Y" TO SRF-MSG-AND-GO
068000           PERFORM 9999-SETERROR-1
068100           PERFORM VARYING SUB FROM 1 BY 1
068200                   UNTIL SUB GREATER THAN
068300                             NUMBER-OF-WKSHEET-ENTRIES
068400
068500             PERFORM 83-MSTORERM-UPDATE
068600             PERFORM 88-DDAILYTC-UPDATE
                   PERFORM 90-UPDATE-CCS THRU 90-EXIT
068700
068800           END-PERFORM
068900
069000*
069100* DELETE THE WORKSHEET
069200*
069300           PERFORM 84-DELETE-WORKSHEET
069400           PERFORM 9999-UNLOCK
069500           MOVE DSET-MWRKLIST TO DSET-NAME
069600           PERFORM 9999-DSET-LOCK
069700           PERFORM 9999-GETKEY-MWRKLIST-WK-O
069800           IF GOOD-CALL
069900             PERFORM 9999-DELETE-MWRKLIST-WK-O
070000           END-IF
070100           PERFORM 9999-UNLOCK
070200
070300*
070400* UPDATE ISSPARTS AND TREQFILU
070500*
070600           PERFORM VARYING SUB FROM 1 BY 1
070700                   UNTIL SUB GREATER THAN
070800                     NUMBER-OF-WKSHEET-ENTRIES
070900
071000             IF WLT-WO (SUB) NOT EQUAL SPACES
071100               PERFORM 85-ISSPARTS-UPDATE
071200             END-IF
071300             PERFORM 86-TREQFILU-UPDATE
071400
071500           END-PERFORM
071600
071700*
071800* PRINT TRANSACTION RECORDS IF REQUESTED
071900*
072000           IF DE-PRT-OPT EQUAL "Y"
072100             PERFORM 87-PRINT
072200           END-IF
072300
072400           PERFORM 9999-CLEAR-FORM-1
072500           PERFORM 9999-RESET-SCREEN
072600         END-IF
072700
072800       END-IF
072900
073000       IF VIEW-LASTKEY NOT EQUAL F1-KEY AND
073100          VIEW-LASTKEY NOT EQUAL F2-KEY AND
073200          VIEW-LASTKEY NOT EQUAL EXIT-PROGRAM
073300
073400         PERFORM 9999-DO-SCREEN-1
073500         PERFORM UNTIL VIEW-LASTKEY NOT EQUAL F7-KEY
073600           PERFORM 9999-CLEAR-FORM-1
073700           PERFORM 9999-DO-SCREEN-1
073800         END-PERFORM
073900
074000       END-IF
074100
074200     END-PERFORM.
074300
074400     PERFORM 9999-CLOSE-STUFF.
074500     GOBACK.
074600
074700**************************************************************
074800* PARAGRAPH : 1-INIT                                         *
074900* PURPOSE   : TO PERFORM INITIALIZATION FUNCTIONS.           *
075000**************************************************************
075100 1-INIT.
075200     MOVE 0 TO LANG-SETNUM, LANG-MSGNUM, LINE-ADV,
075300               EDIT-SUB, SUB5.
075400     MOVE 1 TO DATE-MODE.
075500     MOVE SAVE-PRT-OPT             TO   DE-PRT-OPT.
075600*
075700* DECIDE WHICH FORM TO DISPLAY AND SETUP HEADERS
075800*
075900     MOVE "ZUDCSTR" TO VIEW-CFNAME.
076000     IF SCOM-PGM-KEY = "SW4"
076100         MOVE "ISWSOK" TO VIEW-NFNAME
076200         MOVE "SW"                     TO  WRKL-NO-KEY
076300         MOVE "W I T H D R A W A L"    TO  PRT-TITLE
076400         MOVE "CHARGE"                 TO  PRT-C-HD
076500     ELSE
076600         MOVE "RTWSOK" TO VIEW-NFNAME
076700         MOVE "ST"                     TO  WRKL-NO-KEY
076800         MOVE "R E T U R N        "    TO  PRT-TITLE
076900         MOVE "CREDIT"                 TO  PRT-C-HD.
077000
077100*
077200* f1, f2 APPLICATION, f3 INVALID, f4 REFRESH, f5 PRINT,          NVALID,
077300* F6 INVALID, f7 APPL, f8 EXIT
077400*
077500     MOVE 6                        TO   SRF-KEYSET.
077600
077700     PERFORM 9999-OPEN-STUFF.
078100     PERFORM VARYING SUB FROM 1 BY 1
078200             UNTIL SUB GREATER THAN 5
078300
078400       MOVE 0 TO BU-DISPLAY-FLD9 (SUB)
078500       MOVE SPACES TO BU-DISPLAY-FLD (SUB)
078600
078700     END-PERFORM.
078800
078900     MOVE SRF-SPOOL-PRT-NO         TO   SPOOL-PRT.
079000
079100     MOVE "MWRKLIST;"   TO  LOCK-DSET (1).
079200     MOVE "WL-KEY;"     TO  LOCK-ITEM-LIST (1).
079300     MOVE "DWLITEM;"    TO  LOCK-DSET (2).
079400     MOVE "WL-KEY;"     TO  LOCK-ITEM-LIST (2).
079500     MOVE "DDAILYTC;"   TO  LOCK-DSET(3).
079600     MOVE "@;"          TO  LOCK-ITEM-LIST(3).

      *-----5/7/97 JSB, GET VALID FRANCHISERS
           MOVE "FRAN"                   TO  PLT-ARG.
           MOVE 0 TO COND-WORD.
           MOVE PLT-ARG TO PLTINFOKEY OF MPLTINFO-REC.
           READ MPLTINFO INTO BUF-MPLTINFO
               INVALID KEY MOVE 17 TO COND-WORD.
           IF FILE-STATUS-1 = "2"
               MOVE 17 TO COND-WORD
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD.
           IF COND-WORD NOT = 0
               MOVE SPACES               TO   FRAN-TABLE
           ELSE
               MOVE MPLTINFO-FRANCHISES  TO   FRAN-TABLE.
079700
079800
079900**************************************************************
080000* PARAGRAPH : 2100-BLOWUP                                    *
080100* PURPOSE   : TO BLOWUP THE PROGRAM AND WRITE TO BLOWUP RPT  *
080200**************************************************************
080300 2100-BLOWUP.
080400     MOVE "TIRWSOK"                TO   BU-PGM-NAME.
080500     MOVE DE-WL-NO               TO   BU-DISPLAY-FLD (1).
080600     MOVE EDIT-TOTAL-QTY           TO   BU-DISPLAY-FLD9 (1).
080700     IF SUB > 0
080800         MOVE WLT-CODE (SUB)       TO   BU-DISPLAY-FLD (2).
080900     MOVE CODE-ARG              TO   BU-DISPLAY-FLD (3).
081000     CALL "TBLOWUP" USING BASE BU-PGM-NAME STATUS-AREA
081100       VIEW-COMAREA FILE-STATUS BU-DISPLAY-MSG
081200       BU-DISPLAY-FLDS.
081300
081400**************************************************************
081500* PARAGRAPH : 7-ERROR-ROUTINE                                *
081600* PURPOSE   : TO DISPLAY ERROR MESSAGE REGARDING WORKSHEET   *
081700**************************************************************
081800 7-ERROR-ROUTINE.
081900     IF SCOM-PGM-KEY = "SW4"
082000         MOVE "ISWSOKERR" TO VIEW-NFNAME
082100     ELSE
082200         MOVE "RTWSOKERR" TO VIEW-NFNAME.
082300
082400     PERFORM 9999-GETNEXTFORM.
082500     MOVE MESSAGE-BUFFER TO DE-ERROR-MSG-2.
082600*
082700* CLEAR NOW PROCESSING MSG IN WINDOW
082800*
082900     MOVE SPACES TO MESSAGE-BUFFER.
083000     PERFORM 9999-PUTWINDOW.
083100     MOVE DE-WL-NO TO V-WL-NO.
083200     MOVE WLT-CODE(SUB - 1) TO V-CODE.
083300     PERFORM 9999-DO-SCREEN-2.
083400     PERFORM UNTIL VIEW-LASTKEY NOT EQUAL ENTER-KEY
083500
083600       PERFORM 9999-DO-SCREEN-2
083700
083800     END-PERFORM.
083900
084000 7-ER-X.
084100     EXIT.
084200
084300**************************************************************
084400* PARAGRAPH : 80-GET-WKSHEET                                 *
084500* PURPOSE   : TO GET THE SELECTED WORKSHEET AND SET THE LOCK *
084600*             DESCRIPTORS FOR THAT WORKSHEET.                *
084700**************************************************************
084800 80-GET-WKSHEET.
084900     MOVE SPACES TO WORK-LIST-TABLE.
085000     PERFORM 9999-CHAINHD-DWLITEM-WK-O.
085100     PERFORM 9999-GETNEXT-DWLITEM-WK-O.
085200     MOVE 0 TO SUB.
085300     PERFORM UNTIL END-OF-CHAIN
085400
085500       ADD 1 TO SUB
085600       MOVE WL-RCD-DATA TO WLT-RCD (SUB)
085700       IF ( WLT-QTY(SUB, 1) EQUAL 0 ) AND
085800          ( WLT-QTY(SUB, 2) EQUAL 0 ) AND
085900          ( WLT-QTY(SUB, 3) EQUAL 0 ) AND
086000          ( WLT-QTY(SUB, 4) EQUAL 0 ) AND
086100          ( WLT-QTY(SUB, 5) EQUAL 0 ) AND
086200          ( WLT-QTY(SUB, 6) EQUAL 0 )
086300         SUBTRACT 1 FROM SUB
086400       ELSE
086500         MOVE WLT-CODE (SUB)  TO  LOCK-VALUE (SUB + 3)
086600         MOVE "MSTORERM;"   TO  LOCK-DSET (SUB + 3)
086700         MOVE "CORP-CODE;"  TO  LOCK-ITEM-LIST (SUB + 3)
086800       END-IF
086900       PERFORM 9999-GETNEXT-DWLITEM-WK-O
087000
087100     END-PERFORM.
087200     MOVE SUB TO NUMBER-OF-WKSHEET-ENTRIES.
087300
087400**************************************************************
087500* PARAGRAPH : 81-BUILD-LOCKS-FOR-DRESERVE                    *
087600* PURPOSE   : TO BUILD THE LOCK DESCRIPTORS FOR DRESERVE FOR *
087700*             THE SELECTED WORKSHEET.                        *
087800**************************************************************
087900 81-BUILD-LOCKS-FOR-DRESERVE.
088000
088100     PERFORM VARYING SUB FROM 1 BY 1
088200             UNTIL SUB GREATER THAN NUMBER-OF-WKSHEET-ENTRIES
088300
088400       IF WLT-WO (SUB) NOT EQUAL SPACES
088500
088600         ADD 1 TO NUMBER-OF-LOCK-DESCRIPTORS
088700         MOVE WLT-CODE(SUB) TO
088800              LOCK-VALUE(NUMBER-OF-LOCK-DESCRIPTORS)
088900         MOVE "DRESERVE;" TO
089000              LOCK-DSET(NUMBER-OF-LOCK-DESCRIPTORS)
089100         MOVE "CORP-CODE;" TO
089200              LOCK-ITEM-LIST(NUMBER-OF-LOCK-DESCRIPTORS)
089300
089400       END-IF
089500
089600     END-PERFORM.
089700
089800**************************************************************
089900* PARAGRAPH : 82-VALIDATE-WORKSHEET                          *
090000* PURPOSE   : TO VALIDATE THE WORKSHEET.                     *
090100**************************************************************
090200 82-VALIDATE-WORKSHEET.
090300     MOVE SPACES TO MESSAGE-BUFFER.
090400     PERFORM VARYING SUB FROM 1 BY 1
090500             UNTIL MESSAGE-BUFFER-1 NOT EQUAL SPACE OR
090600                   SUB GREATER THAN NUMBER-OF-WKSHEET-ENTRIES
090700
090800       MOVE WLT-CODE (SUB) TO CODE-ARG
090900       PERFORM 9999-GETKEY-MSTORERM-CD-O
091000       PERFORM 9999-RESET-MSTORERM-CD-O
091100       IF STR-STATE = "F"
091200         MOVE 3 TO LANG-SETNUM
091300         MOVE 8 TO LANG-MSGNUM
091400*        MOVE 03008 TO CATREAD-MSG-NUMBER
091500         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
091600         MOVE MESSAGE-BUFFER TO MSG-TEXT
091700         MOVE CORP-CODE TO MSG-FLD
091800       ELSE
091900         MOVE SRF-MPLTINFO-COMPANY   TO  EDIT-PLANT-CODE
092000         MOVE CORP-CODE              TO  EDIT-CODE
092100         MOVE WLT-EMPL (SUB)         TO  EDIT-EMPL
092200         MOVE WLT-WO (SUB)           TO  EDIT-WO
092300         MOVE WLT-REQ-DEPT (SUB)     TO  EDIT-REQ-DEPT
092400         MOVE WLT-CHARGE-DEPT (SUB)  TO  EDIT-CHARGE-DEPT
092500         MOVE WLT-EXP-CLASS (SUB, 6) TO  EDIT-EXP-CLASS
092500         MOVE STR-RESTRICTED-FLG     TO  EDIT-RESTRICTED-FLG
045700         MOVE STR-REQ-CHG-OVERRD     TO  EDIT-REQ-CHG-OVERRD
045700         MOVE STR-DIR-CHRG-DEPT      TO  EDIT-DIR-CHRG-DEPT
092600
092700         IF SCOM-PGM-KEY = "SW4"
092800           MOVE "IS" TO RET-CODE
092900         ELSE
093000           MOVE "RT" TO RET-CODE
093100         END-IF
093200         CALL "TIREDIT" USING RET-CODE, BASE, MMIS-BASE,
093300           PART-WORKAREA, STATUS-AREA, EDIT-DATA, MESSAGE-BUFFER,
093400           MULTIPLE-STR-DATA, STORES-COMAREA,
093500           STR-EXPENSE-CLASS, LANGUAGE-PARMS
093600         IF RET-CODE = "BU"
093700           MOVE "TIREDIT ERROR 631-RF" TO BU-DISPLAY-MSG
093800           PERFORM 2100-BLOWUP
093900         END-IF
094000
094100         IF MESSAGE-BUFFER-1 EQUAL SPACE
094200
094300           MOVE EDIT-EMPL        TO  WLT-EMPL (SUB)
094400           MOVE EDIT-WO          TO  WLT-WO (SUB)
094500           MOVE EDIT-REQ-DEPT    TO  WLT-REQ-DEPT (SUB)
094600           MOVE EDIT-CHARGE-DEPT TO  WLT-CHARGE-DEPT (SUB)
094700           MOVE EDIT-EXP-CLASS   TO  WLT-EXP-CLASS (SUB, 6)
094800           IF SCOM-PGM-KEY = "SW4"
094900             MOVE "I2"  TO  RET-CODE
095000           ELSE
095100             MOVE "R2"  TO  RET-CODE
095200           END-IF
095300
               PERFORM VARYING SUB5 FROM 1 BY 1
                       UNTIL SUB5 GREATER THAN 6

                   MOVE WLT-BIN (SUB, SUB5) TO  FIL-BIN (SUB, SUB5)
                   MOVE WLT-QTY (SUB, SUB5) TO  FIL-QTY (SUB, SUB5)
               END-PERFORM
      *------5/7/97 INIT BIN-AREA WITH FRANCHISE FOR BINS
               PERFORM VARYING FRAN-SUB FROM 1 BY 1 UNTIL FRAN-SUB > 6
                   IF FRAN-TABLE = SPACES
                       MOVE SPACES TO FIL-FRAN(SUB FRAN-SUB)
                   ELSE
                       SET FRAN-IDX TO 1
                       SEARCH FRAN-ENTRY
                       AT END  MOVE SPACES TO FIL-FRAN (SUB FRAN-SUB)
                       WHEN FRAN-ID(FRAN-IDX) = STR-BIN-OWNER (FRAN-SUB)
                          MOVE FRAN-NAME(FRAN-IDX) TO
                               FIL-FRAN(SUB FRAN-SUB)
                       END-SEARCH
                   END-IF
               END-PERFORM

095400*--------- THE WLT DATA WAS LOADED DIRECTLY FROM THE DWLITEM BUFFER
095500*--------- IN A LOOP ABOVE.  THE WLT TABLE MATCHES THE DWLITEM BUFFER
095600*--------- (LESS WS KEY) EXACTLY
095700           CALL "TQTYEDIT" USING RET-CODE, BASE, STATUS-AREA,
095800             CODE-ARG, WLT-WO (SUB), STR-ONHAND, STR-RESERVED,
095900             STR-LOC-AREA, FIL-BIN-AREA (SUB), EDIT-TOTAL-QTY,
096000             ISSUED-QTY, RET-SUB, MESSAGE-BUFFER,
096100             MULTIPLE-STR-DATA, LANGUAGE-PARMS, WARNING-FLAG,
                   WARNING-TYPE, WARNING-VALUE, STR-AVG-COST,
                   WLT-CHARGE-DEPT-1-4(SUB), WLT-EXP-CLASS(SUB, 6),
                   WLT-EMPL(SUB), STR-UM, STR-MAX, STR-REORDER
                   STR-CODE-OWNER FRAN-TABLE
096200           IF RET-CODE NOT = "00"
096300             MOVE "TQTYEDIT ERROR" TO BU-DISPLAY-MSG
096400             PERFORM 2100-BLOWUP
096500           END-IF
096600
               PERFORM VARYING SUB5 FROM 1 BY 1
                       UNTIL SUB5 GREATER THAN 6

                   MOVE FIL-BIN (SUB, SUB5) TO  WLT-BIN (SUB, SUB5)
                   MOVE FIL-QTY (SUB, SUB5) TO  WLT-QTY (SUB, SUB5)
               END-PERFORM

096700           IF MESSAGE-BUFFER-1 EQUAL SPACE
096800             MOVE QTY-ISSUED TO  SAVE-MMIS-QTY (SUB)
096900           END-IF
097000
097100         END-IF
097200
097300       END-IF
097400
097500     END-PERFORM.
097600
097700**************************************************************
097800* PARAGRAPH : 83-MSTORERM-UPDATE                             *
097900* PURPOSE   : TO UPDATE MSTORERM DATASET                     *
098000**************************************************************
098100 83-MSTORERM-UPDATE.
098200
