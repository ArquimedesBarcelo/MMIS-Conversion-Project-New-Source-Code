112400       PERFORM 2100-BLOWUP
112500     END-IF.
112600
112700**************************************************************
112800* PARAGRAPH : 87-PRINT                                       *
112900* PURPOSE   : TO PRINT THE TRANSACTION RECORDS               *
113000**************************************************************
113100 87-PRINT.
113200
113300     MOVE "ODD" TO PRT-SW.
113400     MOVE WRKL-NO-INC TO PRT-WS-NO.
113600     PERFORM 996-OVERRIDE-PRINT-FILE.
113700     OPEN OUTPUT ONLINE-PRT.
113800     MOVE 0  TO  LINE-CNT.
113900     IF AKRON-PLANT
114000       MOVE "CNTR" TO CNTR-HD
114100     END-IF.
114200     PERFORM VARYING SUB FROM 1 BY 1
114300             UNTIL SUB GREATER THAN NUMBER-OF-WKSHEET-ENTRIES
114400
114500       MOVE SAVE-FORM-DATE (SUB) TO PRT-DATE
114600       MOVE SAVE-FORM-TIME (SUB) TO PRT-TIME
114700       WRITE PRINT-RCD FROM PRT-HDR1 AFTER ADVANCING 1
114800       WRITE PRINT-RCD FROM PRT-HDR2 AFTER ADVANCING 2
114900       WRITE PRINT-RCD FROM PRT-HDR3 AFTER ADVANCING 1
115000       ADD 4 TO LINE-CNT
115100       MOVE WLT-CODE (SUB) TO PRT-CODE
115200       MOVE WLT-EMPL (SUB) TO PRT-EMPL
115300       MOVE WLT-WO (SUB) TO PRT-WO
115400       MOVE WLT-WORK-CENTER (SUB) TO PRT-WORK-CENTER
115500       MOVE WLT-REQ-DEPT (SUB) TO PRT-REQ-DEPT
115600       MOVE WLT-CHARGE-DEPT-1-4 (SUB) TO PRT-CHARGE-1-4
115700       MOVE WLT-CHARGE-DEPT-5-6 (SUB) TO PRT-CHARGE-5-6
115800       MOVE WLT-EXP-CLASS (SUB, 6) TO PRT-EXP-CLASS
115900       MOVE WLT-UM (SUB) TO PRT-UM
116000       MOVE  2  TO LINE-ADV
116100       PERFORM VARYING SUB2 FROM 1 BY 1
116200               UNTIL SUB2 GREATER THAN 6
116300
116400         IF WLT-QTY (SUB, SUB2) > 0
116500*---------- NOTE: THE ACTUAL LOCATION NAMES ARE NOT STORED IN DWLITEM
116600*---------- ANYMORE: THEY MUST BE GOT FROM MSTORERM
116700           MOVE SAVE-LOC (SUB, SUB2)  TO  PRT-LOC
116800           MOVE WLT-QTY (SUB, SUB2)   TO  PRT-QTY
116900           WRITE PRINT-RCD FROM PRT-DETAIL
117000               AFTER ADVANCING LINE-ADV
117100           ADD LINE-ADV TO LINE-CNT
117200           MOVE SPACES TO PRT-CODE, PRT-EMPL, PRT-WO,
117300                          PRT-REQ-DEPT, PRT-CHARGE-1-4,
117400                          PRT-CHARGE-5-6, PRT-EXP-CLASS
117500           MOVE 1  TO LINE-ADV
117600         END-IF
117700
117800       END-PERFORM
117900
118000       MOVE SAVE-DESC-1 (SUB) TO PRT-KWDADJ
118100       MOVE SAVE-DESC-2 (SUB) TO PRT-DESC
118200       MOVE SAVE-DISB-INSTR (SUB) TO PRT-DISB
118300       MOVE WLT-EMPL (SUB) TO PRT-EMP
118400       WRITE PRINT-RCD FROM PRT-HDR5 AFTER ADVANCING 2
118500       WRITE PRINT-RCD FROM PRT-KWRD-ADJ-LINE AFTER ADVANCING 1
118600       WRITE PRINT-RCD FROM PRT-DESC-LINE AFTER ADVANCING 1
118700       ADD 4 TO LINE-CNT
118800
118900       IF SCOM-PGM-KEY = "SW4"
119000         ADD 2 TO LINE-CNT
119100         WRITE PRINT-RCD FROM PRT-SIG-LINE AFTER ADVANCING 2
119200       END-IF
119300       IF PRT-DISB > SPACES
119400         ADD 2 TO LINE-CNT
119500         WRITE PRINT-RCD FROM PRT-DISB-INSTR AFTER ADVANCING 2
119600       END-IF
119700
119800       MOVE SPACES TO PRINT-RCD
119900       IF ( SRF-SPOOL-NO (5) = 99 ) AND ( HP )
120000           WRITE PRINT-RCD AFTER ADVANCING NEW-PAGE
120100       ELSE
120200         IF PRT-SW = "ODD"
120300           IF HP
120400             MOVE HALF-PAGE  TO  PRINT-RCD
120500             WRITE PRINT-RCD AFTER ADVANCING 0
120600           ELSE
120700             SUBTRACT LINE-CNT FROM 33 GIVING ADV-TO-HALF
120800             WRITE PRINT-RCD AFTER ADVANCING ADV-TO-HALF
120900           END-IF
121000           MOVE "EVEN" TO PRT-SW
121100         ELSE
121200           MOVE SPACES TO PRINT-RCD
121300           WRITE PRINT-RCD AFTER ADVANCING NEW-PAGE
121400           MOVE 0 TO LINE-CNT
121500           MOVE "ODD" TO PRT-SW
121600         END-IF
121700
121800       END-IF
121900
122000     END-PERFORM.
122100
122200     IF HP
122300       MOVE SPACES TO PRINT-LINE
122400       WRITE PRINT-RCD AFTER ADVANCING NEW-PAGE.
122600     CLOSE ONLINE-PRT.
122700
122800**************************************************************
122900* PARAGRAPH : 88-DDAILYTC-UPDATE                             *
123000* PURPOSE   : TO UPDATE DDAILYTC                             *
123100**************************************************************
123200 88-DDAILYTC-UPDATE.
      *------5/7/97 BUILD OWNER/QTY TABLE
           MOVE 0 TO MAX-OWNRS
           INITIALIZE OWNER-TABLE.
           PERFORM VARYING FRAN-SUB FROM 1 BY 1
             UNTIL FRAN-SUB > 6
               IF FIL-QTY(SUB FRAN-SUB) > 0
                   SET OWNR-IDX TO 1
                   SEARCH OWNER-ENTRY
                     AT END
                        ADD 1 TO MAX-OWNRS
                        MOVE FIL-FRAN(SUB FRAN-SUB) TO OWNR(MAX-OWNRS)
                        IF FIL-QTY-X(SUB FRAN-SUB) NUMERIC
                          MOVE FIL-QTY(SUB FRAN-SUB) TO
                               OWNR-QTY(MAX-OWNRS)
                        ELSE
                          MOVE ZEROS        TO OWNR-QTY(MAX-OWNRS)
                        END-IF
                     WHEN OWNR(OWNR-IDX) = FIL-FRAN(SUB FRAN-SUB)
                        MOVE OWNR-IDX TO CURR-OWNR
                        IF MAX-OWNRS = 0
                            MOVE 1 TO MAX-OWNRS
                            MOVE 0 TO OWNR-QTY(CURR-OWNR)
                        END-IF
                        IF FIL-QTY-X(SUB FRAN-SUB) NUMERIC
                         IF OWNR-QTY(CURR-OWNR) NUMERIC
                          ADD FIL-QTY(SUB FRAN-SUB) TO
                              OWNR-QTY(CURR-OWNR)
                         ELSE
                          MOVE FIL-QTY(SUB FRAN-SUB) TO
                               OWNR-QTY(CURR-OWNR)
                         END-IF
                        END-IF
                   END-SEARCH
              END-IF
           END-PERFORM.
123300     MOVE SPACES TO DDAILYTC-DATA.
123400
123500     IF WLT-EXP-CLASS (SUB, 6) = "000000"
123600       MOVE SPACES TO WLT-EXP-CLASS (SUB, 6)
123700     END-IF.
123800
123900     MOVE SAVE-DATE (SUB) TO DDAILYTC-DATE.
124000     MOVE SAVE-TIME (SUB) TO DDAILYTC-TIME.
124100     MOVE SRF-MPLTINFO-COMPANY TO DDAILYTC-PLT.
124200
124300*
124400* AN ISSUE IS A 333 TRANSACTION, A RETURN IS A 330 TRANSACTION   TION.
124500* FOR EACH, IF THE AVERAGE COST EXCEEDS WHAT THE TRANSACTION CAN ON WILL
124600* HANDLE, A SPECIAL 433 OR 430 TRANSACTION IS CUT.
124700*
124800     IF SCOM-PGM-KEY = "SW4"
      *--------5/7/97 WRITE TC FOR EACH OWNER/QTY
            PERFORM VARYING FRAN-SUB FROM 1 BY 1
               UNTIL FRAN-SUB > MAX-OWNRS
124900       IF SAVE-AVG-COST (SUB) > 99999.9999
125000         MOVE "433"                  TO DDAILYTC-TC
125100         MOVE WLT-CODE (SUB)         TO TC433-CORPCODE
125200         MOVE WLT-CHARGE-DEPT (SUB)  TO TC433-DEPARTMENT
125300         MOVE WLT-WO (SUB)           TO TC433-WO
125400         MOVE WLT-WORK-CENTER (SUB)  TO TC433-WORK-CENTER
125500         MOVE WLT-EMPL (SUB)         TO TC433-EMP
125600*        MOVE SAVE-TOTAL-QTY (SUB)   TO TC433-QTY
               MOVE OWNR-QTY(FRAN-SUB)   TO  TC433-QTY
               PERFORM 900-GET-FRAN-ID THRU 900-GET-FRAN-ID-X
               MOVE HOLD-FRAN-ID         TO  TC433-FRAN-ID
125700*        MOVE SAVE-AVG-COST (SUB)    TO TC433-AVG-COST
      *----------GOODYEAR OWNED USES AVG COST
      *----------FRANCHISE OWNED USES MKT COST
               IF STR-CODE-OWNER NOT = SPACES
                 IF HOLD-FRAN-ID NOT = STR-CODE-OWNER
                   MOVE STR-AVG-COST     TO  TC433-AVG-COST
                 ELSE
                   MOVE STR-MKT-COST     TO  TC433-AVG-COST
                 END-IF
               ELSE
                 MOVE STR-AVG-COST       TO  TC433-AVG-COST
               END-IF
125800         MOVE WLT-UM (SUB)           TO TC433-UM
125900         MOVE WLT-EXP-CLASS (SUB, 6) TO TC433-EXP-CLASS
126000         MOVE WLT-REQ-DEPT (SUB)     TO TC433-REQ-DEPT
126100         MOVE SAVE-CLASS (SUB)       TO TC433-CLASS
               PERFORM 9999-PUT-DDAILYTC-DT-O
126200       ELSE
126300         MOVE "333"                  TO DDAILYTC-TC
126400         MOVE WLT-CODE (SUB)         TO TC333-CORPCODE
126500         MOVE WLT-CHARGE-DEPT (SUB)  TO TC333-DEPARTMENT
126600         MOVE WLT-WO (SUB)           TO TC333-WO
126700         MOVE WLT-WORK-CENTER (SUB)  TO TC333-WORK-CENTER
126800         MOVE WLT-EMPL (SUB)         TO TC333-EMP
126900*        MOVE SAVE-TOTAL-QTY (SUB)   TO TC333-QTY
               MOVE OWNR-QTY(FRAN-SUB)   TO  TC333-QTY
               PERFORM 900-GET-FRAN-ID THRU 900-GET-FRAN-ID-X
               MOVE HOLD-FRAN-ID         TO  TC333-FRAN-ID
      *----------GOODYEAR OWNED USES AVG COST
      *----------FRANCHISE OWNED USES MKT COST
               IF STR-CODE-OWNER NOT = SPACES
                 IF HOLD-FRAN-ID NOT = STR-CODE-OWNER
060300             MOVE STR-AVG-COST     TO  TC333-AVG-COST
                 ELSE
                   MOVE STR-MKT-COST     TO  TC333-AVG-COST
                 END-IF
               ELSE
                 MOVE STR-AVG-COST       TO  TC333-AVG-COST
               END-IF
127000*        MOVE SAVE-AVG-COST (SUB)    TO TC333-AVG-COST
127100         MOVE WLT-UM (SUB)           TO TC333-UM
127200         MOVE WLT-EXP-CLASS (SUB, 6) TO TC333-EXP-CLASS
127300         MOVE WLT-REQ-DEPT (SUB)     TO TC333-REQ-DEPT
127400         MOVE SAVE-CLASS (SUB)       TO TC333-CLASS
               PERFORM 9999-PUT-DDAILYTC-DT-O
127500       END-IF
            END-PERFORM
127600     ELSE
127700       IF SAVE-AVG-COST (SUB) > 99999.9999
127800         MOVE "430"                  TO DDAILYTC-TC
127900         MOVE WLT-CODE (SUB)         TO TC430-CORPCODE
128000         MOVE WLT-CHARGE-DEPT (SUB)  TO TC430-DEPARTMENT
128100         MOVE WLT-WO (SUB)           TO TC430-WO
128200         MOVE WLT-WORK-CENTER (SUB)  TO TC430-WORK-CENTER
128300         MOVE WLT-EMPL (SUB)         TO TC430-EMP
128400         MOVE SAVE-TOTAL-QTY (SUB)   TO TC430-QTY
128500         MOVE SAVE-AVG-COST (SUB)    TO TC430-AVG-COST
128600         MOVE WLT-UM (SUB)           TO TC430-UM
128700         MOVE WLT-EXP-CLASS (SUB, 6) TO TC430-EXP-CLASS
128800         MOVE WLT-REQ-DEPT (SUB)     TO TC430-REQ-DEPT
128900         MOVE SAVE-CLASS (SUB)       TO TC430-CLASS
               PERFORM 9999-PUT-DDAILYTC-DT-O
129000       ELSE
129100         MOVE "330"                  TO DDAILYTC-TC
129200         MOVE WLT-CODE (SUB)         TO TC330-CORPCODE
129300         MOVE WLT-CHARGE-DEPT (SUB)  TO TC330-DEPARTMENT
129400         MOVE WLT-WO (SUB)           TO TC330-WO
129500         MOVE WLT-WORK-CENTER (SUB)  TO TC330-WORK-CENTER
129600         MOVE WLT-EMPL (SUB)         TO TC330-EMP
129700         MOVE SAVE-TOTAL-QTY (SUB)   TO TC330-QTY
129800         MOVE SAVE-AVG-COST (SUB)    TO TC330-AVG-COST
129900         MOVE WLT-UM (SUB)           TO TC330-UM
130000         MOVE WLT-EXP-CLASS (SUB, 6) TO TC330-EXP-CLASS
130100         MOVE WLT-REQ-DEPT (SUB)     TO TC330-REQ-DEPT
130200         MOVE SAVE-CLASS (SUB)       TO TC330-CLASS
               PERFORM 9999-PUT-DDAILYTC-DT-O
130300       END-IF
130400     END-IF.

      *--------- SEND USER NOTIFICATION MESSAGE IF SPECIFIED IN
      *--------- MCFPCSUSER.
           IF SCOM-PGM-KEY = "SW4"
               IF USER-FILE-EXISTS = "Y"
                   PERFORM 900-SEND-MESSAGE.
130500
      *-----UPDATE DCCSDATA WITH DATE AND TIME FOR WS
       90-UPDATE-CCS.
           MOVE 0 TO COND-WORD.
           MOVE WL-ARG TO WLKEY OF DCCSDATA-REC.
           MOVE SPACES TO CORPCDE OF DCCSDATA-REC.
           START DCCSDATA KEY NOT < EXTERNALLY-DESCRIBED-KEY INVALID KEY
               MOVE 0 TO COND-WORD.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
                   MOVE 0 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.
           IF COND-WORD NOT = 0
               MOVE 2                    TO  RET-CODE
               MOVE "START ERR 90 CCS" TO BU-DISPLAY-MSG
               GO TO 90-EXIT.

       90-GET-LOOP.
           MOVE 0 TO COND-WORD.
           READ DCCSDATA NEXT INTO BUF-DCCSDATA AT END
               MOVE 15 TO COND-WORD.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   MOVE 15 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.
           IF WLKEY OF DCCSDATA-REC NOT = WL-ARG
               MOVE 15 TO COND-WORD.
           IF COND-WORD = 15
               START DCCSDATA KEY > EXTERNALLY-DESCRIBED-KEY
                  INVALID KEY MOVE 15 TO COND-WORD
               END-START
               GO TO 90-EXIT
           ELSE
           IF COND-WORD NOT = 0
               MOVE 3                    TO  RET-CODE
               MOVE "READ ERR 90" TO BU-DISPLAY-MSG
               GO TO 90-EXIT.
           MOVE DDAILYTC-DATE TO CCS-DATE-YMD.
           IF CCS-DATE-YY > 70
              MOVE "19" TO CCS-DATE-CC
           ELSE
              MOVE "20" TO CCS-DATE-CC.
           MOVE DDAILYTC-TIME TO CCS-TIME.

           MOVE 0 TO COND-WORD.
           REWRITE DCCSDATA-REC FROM BUF-DCCSDATA INVALID KEY
               MOVE 99 TO COND-WORD.
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD.
           IF COND-WORD NOT = 0
               MOVE "REWRITE ERR 90" TO BU-DISPLAY-MSG
               MOVE 4                    TO  RET-CODE
               GO TO 90-EXIT.

           GO TO 90-GET-LOOP.
       90-EXIT.
           EXIT.
130700
130800**************************************************************
130900* PARAGRAPH : 9999-CLEAR-FORM-1                              *
131000* PURPOSE   : TO CLEAR THE FIRST FORM.                       *
131100**************************************************************
131200 9999-CLEAR-FORM-1.
131300     MOVE SPACES TO MESSAGE-BUFFER.
131400     PERFORM 9999-PUTWINDOW.
131500     PERFORM 9999-INITFORM.
131600     MOVE SPACES TO DE-FIELDS-1.
131700     MOVE SAVE-PRT-OPT             TO   DE-PRT-OPT.
131800     PERFORM 9999-PUTBUFFER-1.
131900
132000 COPY OVRPFCAL IN COPYLIB.
132100 COPY HCATREAD IN COPYLIB.
       9999-OPEN-STUFF.
           OPEN I-O DISPLAY-FILE.
           OPEN I-O MSTORERM-CD-O.
           OPEN I-O DWLITEM-WK-O.
           OPEN I-O MWRKLIST-WK-O.
           OPEN I-O DDAILYTC-DT-O.
           OPEN I-O DCCSDATA.
           OPEN INPUT MPLTINFO.

           OPEN INPUT USER-I.
           IF FILE-STATUS NOT = "00"
               MOVE "N" TO USER-FILE-EXISTS
           ELSE
               MOVE "Y" TO USER-FILE-EXISTS.

       9999-CLOSE-STUFF.
           CLOSE DISPLAY-FILE.
           CLOSE MSTORERM-CD-O.
           CLOSE DWLITEM-WK-O.
           CLOSE MWRKLIST-WK-O.
           CLOSE DDAILYTC-DT-O.
           CLOSE MPLTINFO.
           CLOSE DCCSDATA.
           CLOSE USER-I.

132300 COPY SCRNCALL IN COPYLIB.
132400 COPY SCRNCL1  IN COPYLIB.
132500 COPY SCRNCL2  IN COPYLIB.
132800 COPY DLOCKCAL IN COPYLIB.
132900 COPY MLOCKCAL IN COPYLIB.
133000 COPY UNLOCK   IN COPYLIB.
       9999-GETKEY-MWRKLIST-WK-O.
           MOVE 0 TO COND-WORD.
           MOVE WL-ARG TO WLKEY OF MWRKLIST-WK-REC-O.
           READ MWRKLIST-WK-O INTO BUF-MWRKLIST
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS = "23"
               MOVE 17 TO COND-WORD
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD
               IF HANDLE-BLOWUP-FLAG = "Y"
                   MOVE "GETKEY ERR 9999-GETKEY-MWRKLIST-WK-O"
                       TO BU-MSG-AREA
                   PERFORM 2100-BLOWUP.

       9999-RESET-MWRKLIST-WK-O.
           MOVE HIGH-VALUES TO WLKEY OF MWRKLIST-WK-REC-O.
           START MWRKLIST-WK-O KEY > WLKEY OF MWRKLIST-WK-REC-O
               INVALID KEY MOVE "00" TO FILE-STATUS.

       9999-CHAINHD-DWLITEM-WK-O.
           MOVE 0 TO COND-WORD.
           MOVE WL-ARG TO WLKEY OF DWLITEM-WK-REC-O.
           START DWLITEM-WK-O KEY = WLKEY OF DWLITEM-WK-REC-O
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF (FILE-STATUS NOT = "00") AND (FILE-STATUS-1 NOT = "2")
               MOVE 99 TO COND-WORD
               IF HANDLE-BLOWUP-FLAG = "Y"
                   MOVE "CHAINHD ERR 9999-CHAINHD-DWLITEM-WK-O"
                       TO BU-MSG-AREA
                   PERFORM 2100-BLOWUP.

       9999-GETNEXT-DWLITEM-WK-O.
           MOVE 0 TO COND-WORD.
           READ DWLITEM-WK-O NEXT INTO BUF-DWLITEM
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14"
                   PERFORM 9999-RESET-DWLITEM-WK-O
                   MOVE 15 TO COND-WORD
               ELSE
               IF FILE-STATUS = "46"
                   MOVE 15 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD
                   IF HANDLE-BLOWUP-FLAG = "Y"
                       MOVE "GETNEXT ERR 9999-GETNEXT-DWLITEM-WK-O"
                           TO BU-MSG-AREA
                       PERFORM 2100-BLOWUP
                   END-IF
           ELSE
           IF WLKEY OF DWLITEM-WK-REC-O NOT = WL-ARG
               PERFORM 9999-RESET-DWLITEM-WK-O
               MOVE 15 TO COND-WORD.

       9999-RESET-DWLITEM-WK-O.
           MOVE HIGH-VALUES TO WLKEY OF DWLITEM-WK-REC-O.
           START DWLITEM-WK-O KEY > WLKEY OF DWLITEM-WK-REC-O
               INVALID KEY MOVE "00" TO FILE-STATUS.

       9999-DELETE-DWLITEM-WK-O.
           MOVE 0 TO COND-WORD.
           DELETE DWLITEM-WK-O
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD
               IF HANDLE-BLOWUP-FLAG = "Y"
                   MOVE "DELETE ERR 9999-DELETE-DWLITEM-WK-O"
                       TO BU-MSG-AREA
                   PERFORM 2100-BLOWUP.

       9999-DELETE-MWRKLIST-WK-O.
           MOVE 0 TO COND-WORD.
           DELETE MWRKLIST-WK-O
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD
               IF HANDLE-BLOWUP-FLAG = "Y"
                   MOVE "DELETE ERR 9999-DELETE-MWRKLIST-WK-O"
                       TO BU-MSG-AREA
                   PERFORM 2100-BLOWUP.

       9999-GETKEY-MSTORERM-CD-O.
           MOVE 0 TO COND-WORD.
           MOVE CODE-ARG TO CORPCDE OF MSTORERM-CD-REC-O.
           READ MSTORERM-CD-O INTO BUF-MSTORERM
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS = "23"
               MOVE 17 TO COND-WORD
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD
               IF HANDLE-BLOWUP-FLAG = "Y"
                   MOVE "GETKEY ERR 9999-GETKEY-MSTORERM-CD-O"
                       TO BU-MSG-AREA
                   PERFORM 2100-BLOWUP.

       9999-RESET-MSTORERM-CD-O.
           MOVE HIGH-VALUES TO CORPCDE OF MSTORERM-CD-REC-O.
           START MSTORERM-CD-O KEY > CORPCDE OF MSTORERM-CD-REC-O
               INVALID KEY MOVE "00" TO FILE-STATUS.

       9999-UPDATE-MSTORERM-CD-O.
           MOVE 0 TO COND-WORD.
           REWRITE MSTORERM-CD-REC-O FROM BUF-MSTORERM
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD
               IF HANDLE-BLOWUP-FLAG = "Y"
                   MOVE "UPDATE ERR 9999-UPDATE-MSTORERM-CD-O"
                       TO BU-MSG-AREA
                   PERFORM 2100-BLOWUP.

       9999-PUT-DDAILYTC-DT-O.
           MOVE 0 TO COND-WORD.
           WRITE DDAILYTC-DT-REC-O FROM BUF-DDAILYTC
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD
               IF HANDLE-BLOWUP-FLAG = "Y"
                   MOVE "PUT ERR 9999-PUT-DDAILYTC-DT-O"
                       TO BU-MSG-AREA
                   PERFORM 2100-BLOWUP.

       900-SEND-MESSAGE.
           MOVE WLT-CODE (SUB) TO CORPCDE OF USER-I-REC.
           START USER-I KEY = CORPCDE OF USER-I-REC
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS = "00"
               READ USER-I NEXT INTO BUF-USERFILE
                   AT END MOVE FILE-STATUS TO FILE-STATUS
               END-READ
               IF FILE-STATUS = "00"
                   PERFORM UNTIL USR-CORP-CODE NOT = CODE-ARG
                                     OR FILE-STATUS NOT = "00"
                       MOVE SPACES            TO  MCXSNDMSG-PARM
                       MOVE USR-CORP-CODE     TO  MCXSNDMSG-CODE
                       MOVE USR-MESSAGE       TO  MCXSNDMSG-MSG
                       CALL "MCXSNDMSG" USING MCXSNDMSG-PARM
                                              USR-USER-ID
                       READ USER-I NEXT INTO BUF-USERFILE
                           AT END MOVE FILE-STATUS TO FILE-STATUS
                       END-READ
                   END-PERFORM.

       900-GET-FRAN-ID.
           IF FRAN-TABLE = SPACES
               MOVE SPACES TO HOLD-FRAN-ID
           ELSE
               SET FRAN-IDX TO 1
               SEARCH FRAN-ENTRY
                 AT END  MOVE SPACES TO HOLD-FRAN-ID
                 WHEN FRAN-NAME(FRAN-IDX) = OWNR (FRAN-SUB)
                  MOVE FRAN-ID(FRAN-IDX) TO HOLD-FRAN-ID
               END-SEARCH.
       900-GET-FRAN-ID-X.
           EXIT.
