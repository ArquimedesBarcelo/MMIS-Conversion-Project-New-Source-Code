       COPY VCOMLINK   IN COPYLIB.

       COPY LANGSUB    IN COPYLIB.

       01  MPLTINFO-PARMS.
           05  MPLTINFO-PLANT-CODE       PIC X(3).
           05  MPLTINFO-DDESC-LANG       PIC X(3).
           05  MPLTINFO-DDESC2-LANG      PIC X(3).

      *************************************************************
      **#########################################################**
      *************************************************************
      **                                                         **
      **           P R O C E D U R E   D I V I S I O N           **
      **                                                         **
      *************************************************************
      **#########################################################**
      *************************************************************

       PROCEDURE DIVISION USING BASE,
                                VIEW-COMAREA,
                                LANGUAGE-PARMS,
                                MPLTINFO-PARMS.

       1000-HOUSEKEEP.
           MOVE "01" TO BU-DISPLAY-PARA.
           PERFORM 9999-OPEN-STUFF.
           OPEN I-O   DRESTRIC-O.
           MOVE "SCODEDEL"               TO  BU-PGM-NAME.
      *---------- GET THE FATHER FORM.
           MOVE "CODEDEL"                TO  VIEW-NFNAME.
           PERFORM 9951-GETNEXTFORM.
           PERFORM 65-DELETE-CODE THRU 6990-DC-X.
           PERFORM 9999-CLOSE-STUFF.
           CLOSE  DRESTRIC-O.
           GOBACK.

       2100-BLOWUP.
           MOVE CODE-ARG                 TO  BU-DISPLAY-FLD (1).
           CALL "TBLOWUP" USING BASE, BU-PGM-NAME, STATUS-AREA,
                 VIEW-COMAREA, FILE-STATUS, BU-DISPLAY-MSG,
                 BU-DISPLAY-AREA.

       65-DELETE-CODE.
           MOVE "02" TO BU-DISPLAY-PARA.
           MOVE "CODEDEL1" TO VIEW-NFNAME.
           PERFORM 9951-GETNEXTFORM.
           PERFORM 9956-PUTWINDOW.

       65-PUT-BUFFER.
           MOVE SPACES          TO DE-FIELDS.
           PERFORM 9953-PUTBUFFER.

      ***  INPUT STORES CODE AND THEN PRESS 'ENTER'  ***
           MOVE   9 TO LANG-SETNUM.
           MOVE  23 TO LANG-MSGNUM.
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
           MOVE MESSAGE-BUFFER TO CODE-TOP-MSG-LINE.

      ***  IF CODE IS ELIGIBLE FOR DELETION, ITS DESCRIPTION WILL  ***
      ***  BE RETRIEVED                                            ***
           MOVE   9 TO LANG-SETNUM.
           MOVE  24 TO LANG-MSGNUM.
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
           MOVE MESSAGE-BUFFER TO CODE-MSG-LINE1.

      ***  OTHERWISE A MESSAGE WILL BE DISPLAYED BELOW  ***
           MOVE 15 TO LANG-SETNUM.
           MOVE  5 TO LANG-MSGNUM.
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
           MOVE MESSAGE-BUFFER TO CODE-MSG-LINE2.

       65-SHOWFORM .
           PERFORM 9953-PUTBUFFER.
           MOVE "03" TO BU-DISPLAY-PARA.
           MOVE 7 TO SRF-KEYSET
           PERFORM 998-WRITE-SCREEN THRU 9989-WS-X.
           IF MESSAGE-BUFFER-1 NOT = SPACES
               PERFORM 9954-SETERROR
               GO TO 65-SHOWFORM .

           IF VIEW-LASTKEY = 3
               GO TO 6990-DC-X.

           PERFORM 9952-GETBUFFER.

       65-EDIT-CODE.
           MOVE "04" TO BU-DISPLAY-PARA.
           MOVE CODE-STORES TO CODE-CHK-IN.
           MOVE CODE-STORES TO CODE-ARG, SAVE-CODE-STORES.

           PERFORM 9999-DBGET7-MSTORERM-CD-O.
           IF COND-WORD NOT = 0
             IF COND-WORD = 17
      *****    STORES CODE DOES NOT EXIST    *****
               MOVE  19 TO LANG-SETNUM
               MOVE   9 TO LANG-MSGNUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE  2  TO FIELD-NUMBER
               PERFORM 9954-SETERROR
               GO TO 65-SHOWFORM .
           PERFORM 9999-RESET-MSTORERM-CD-O.

      ***** CHECK TO SEE THAT STR-ONHAND = 0 *****

           IF STR-ONHAND NOT = 0
      *****    CODE IS NOT ELIGIBLE FOR DELETION - ONHAND IS NOT ZERO *****
               MOVE   3 TO LANG-SETNUM
               MOVE 149 TO LANG-MSGNUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE  2  TO FIELD-NUMBER
               PERFORM 9954-SETERROR
               GO TO 65-SHOWFORM .

      ***** CHECK TO SEE THAT CODE IS NOT FROZEN *****
           IF STR-STATE = "F"
      *****    CODE FROZEN FOR INVENTORY - NO PROCESSING ALLOWED
               MOVE   3 TO LANG-SETNUM
               MOVE   8 TO LANG-MSGNUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE 2  TO FIELD-NUMBER
               PERFORM 9954-SETERROR
               GO TO 65-SHOWFORM .

      ***** CHECK TO SEE THAT CODE IS NOT ON ANY PO'S *****
           PERFORM 9999-DBFIND-DPOITEM-CD-I.
           PERFORM 9999-DBGET5-DPOITEM-CD-I.
           IF GOOD-CALL
      *****    CODE IS NOT ELIGIBLE FOR DELETION - P.O. EXISTS   *****
               MOVE   3 TO LANG-SETNUM
               MOVE 150 TO LANG-MSGNUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE  2  TO FIELD-NUMBER
               PERFORM 9954-SETERROR
               GO TO 65-SHOWFORM .

      ***** CHECK TO SEE THAT CODE IS NOT ON ANY RESERVATIONS *****
           PERFORM 9999-DBFIND-DRESERVE-CD-I.
           PERFORM 9999-DBGET5-DRESERVE-CD-I.
           IF GOOD-CALL
      *****    CODE IS NOT ELIGIBLE FOR DELETION - RESERVATION EXISTS *****
               MOVE   3 TO LANG-SETNUM
               MOVE 151 TO LANG-MSGNUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE  2  TO FIELD-NUMBER
               PERFORM 9954-SETERROR
               GO TO 65-SHOWFORM .

      ***** CHECK TO SEE THAT CODE IS NOT ON ANY WORKSHEETS *****
           PERFORM 9999-DBFIND-DWLITEM-CD-I.
           PERFORM 9999-DBGET5-DWLITEM-CD-I.
           IF GOOD-CALL
      *****    CODE IS NOT ELIGIBLE FOR DELETION - WORKSHEET EXISTS   *****
               MOVE   3 TO LANG-SETNUM
               MOVE 152 TO LANG-MSGNUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE  2  TO FIELD-NUMBER
               PERFORM 9954-SETERROR
               GO TO 65-SHOWFORM .

      ***** CHECK TO SEE THAT CODE IS NOT ON ANY REQUISITIONS *****
           PERFORM 9999-DBFIND-DREQITM-CD-I.
           PERFORM 9999-DBGET5-DREQITM-CD-I.
           IF GOOD-CALL
      *****    CODE IS NOT ELIGIBLE FOR DELETION - REQUISITION EXISTS *****
               MOVE   3 TO LANG-SETNUM
               MOVE 153 TO LANG-MSGNUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE  2  TO FIELD-NUMBER
               PERFORM 9954-SETERROR
               GO TO 65-SHOWFORM .

      ***** CHECK TO SEE THAT CODE IS NOT ON ANY INVOICES *****
           PERFORM 9999-DBFIND-DINVITM-CD-I.
           PERFORM 9999-DBGET5-DINVITM-CD-I.
           IF GOOD-CALL
      *****    CODE IS NOT ELIGIBLE FOR DELETION - INVOICE EXISTS *****
               MOVE   3 TO LANG-SETNUM
               MOVE 156 TO LANG-MSGNUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE  2  TO FIELD-NUMBER
               PERFORM 9954-SETERROR
               GO TO 65-SHOWFORM .

       65-PREPARE-TO-GET-DDESC.
           MOVE "05" TO BU-DISPLAY-PARA.
           PERFORM 9999-DBFIND-DDESC-CD-O.

           MOVE SPACES TO BUF-DDESC, SAVE-KWM1, SAVE-DESC-TBL.
           SET SDESC-INDEX TO 1.

           PERFORM 7000-GET-DDESC
              UNTIL DESC-ID-NUM IS GREATER THAN "15"
                 OR NOT GOOD-CALL.
           PERFORM 9999-RESET-DDESC-CD-O.

           PERFORM 9999-DBFIND-DDESC2-CD-O.

           MOVE SPACES TO BUF-DDESC2, SAVE-KWM2.

           PERFORM 7100-GET-DDESC2
              UNTIL DESC2-ID-NUM IS GREATER THAN "00"
                 OR NOT GOOD-CALL.
           PERFORM 9999-RESET-DDESC2-CD-O.

           PERFORM 7150-ALLOW-DELETE THRU 7170-AD-X.

           GO TO 65-DELETE-CODE.

       6990-DC-X.
           EXIT.

       7000-GET-DDESC.
           PERFORM 9999-DBGET5-DDESC-CD-O.
           IF NOT GOOD-CALL
               NEXT SENTENCE
           ELSE
           IF DESC-ID-NUM = "00"
               MOVE DESC-DATA TO SAVE-KWM1
           ELSE
               IF DESC-ID-NUM IS LESS THAN "16"
                   MOVE DESC-DATA TO SAVE-DESC (SDESC-INDEX)
                   IF SDESC-INDEX IS LESS THAN 15
                       SET SDESC-INDEX UP BY 1.

       7100-GET-DDESC2.
           PERFORM 9999-DBGET5-DDESC2-CD-O.
           IF NOT GOOD-CALL
               NEXT SENTENCE
           ELSE
           IF DESC2-ID-NUM = "00"
               MOVE DESC2-KWM TO SAVE-KWM2.

       7150-ALLOW-DELETE.
           MOVE "CODEDEL2" TO VIEW-NFNAME.
           PERFORM 9951-GETNEXTFORM.
           MOVE SPACES TO MESSAGE-BUFFER.
           PERFORM 9956-PUTWINDOW.

           MOVE SPACES           TO DE-FIELDS.
           MOVE SAVE-CODE-STORES TO CODE-STORES.
           MOVE STR-LOC (1)      TO CODE-BIN-LOC1.
           MOVE SAVE-KW1         TO CODE-KW1.
           MOVE SAVE-MOD1        TO CODE-MOD1.
           MOVE SAVE-KW2         TO CODE-KW2.
           MOVE SAVE-MOD2        TO CODE-MOD2.
           MOVE SAVE-DESC-TBL    TO CODE-DESC-TBL.

      ***  PRESS 'ENTER' TO DELETE THIS CODE FROM THE DATA BASE  ***
           MOVE  16 TO LANG-SETNUM.
           MOVE  28 TO LANG-MSGNUM.
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
           MOVE MESSAGE-BUFFER TO CODE-MSG-LINE1.

      ***  PRESS   'f8'  TO LEAVE THIS CODE ON THE DATA BASE  ***
           MOVE  16 TO LANG-SETNUM.
           MOVE  29 TO LANG-MSGNUM.
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
           MOVE MESSAGE-BUFFER TO CODE-MSG-LINE2.

       7220-SHOWFORM .
           PERFORM 9953-PUTBUFFER.
           PERFORM 998-WRITE-SCREEN THRU 9989-WS-X.
           IF MESSAGE-BUFFER-1 NOT = SPACES
               PERFORM 9954-SETERROR
               GO TO 7220-SHOWFORM .

           IF VIEW-LASTKEY = 3
               GO TO 7170-AD-X.

           PERFORM 7300-PROCESS-DELETE THRU 7390-PD-X.

       7170-AD-X.
           EXIT.

       7300-PROCESS-DELETE.

      ***** DELETE THE SECONDARY LANGUAGE KEYWORD/MODIFIER *****
      ***** FROM THE DATA BASE IF ONE EXISTS.              *****

           MOVE  5                       TO NUMBER-OF-DSETS-LOCKED.
           MOVE DSET-DVENDITM            TO DSET-NAME-1.
           MOVE DSET-DDESC               TO DSET-NAME-2.
           MOVE DSET-DDESC2              TO DSET-NAME-3.
           MOVE DSET-DMANPART            TO DSET-NAME-4.
           MOVE DSET-DCODE               TO DSET-NAME-5.
           MOVE CODE-SEARCH              TO ITEM-LIST-1,
                                            ITEM-LIST-2,
                                            ITEM-LIST-3,
                                            ITEM-LIST-4,
                                            ITEM-LIST-5.
           MOVE SAVE-CODE-STORES         TO LOCK-VALUE-1,
                                            LOCK-VALUE-2,
                                            LOCK-VALUE-3,
                                            LOCK-VALUE-4,
                                            LOCK-VALUE-5.

           PERFORM 9931-MULTI-LOCK.
      *    CALL "DBBEGIN" USING BASE, DB-LOG-TEXT, MODE1,
      *        STATUS-AREA, DB-LOG-TEXT-LEN.
      *    IF COND-WORD NOT = 0
      *        MOVE "DBBEGIN ERROR IN 7300-PROCESS-DELETE"
      *            TO BU-DISPLAY-MSG
      *        PERFORM 2100-BLOWUP.
      *
           MOVE SAVE-CODE-STORES TO CODE-ARG.

      ***** DELETE ALL ENTRIES FOR THIS CODE IN "DVENDITM" *****
           PERFORM 9999-DBFIND-DVENDITM-CD-O.
           PERFORM 8000-GET-DEL-DVENDITM
              UNTIL NOT GOOD-CALL.

      ***** DELETE ALL ENTRIES FOR THIS CODE IN "DDESC" *****
           PERFORM 9999-DBFIND-DDESC-CD-O.
           PERFORM 8100-GET-DEL-DDESC
              UNTIL NOT GOOD-CALL.

      ***** DELETE ALL ENTRIES FOR THIS CODE IN "DDESC2" *****
           PERFORM 9999-DBFIND-DDESC2-CD-O.
           PERFORM 8200-GET-DEL-DDESC2
              UNTIL NOT GOOD-CALL.

      ***** DELETE ALL ENTRIES FOR THIS CODE IN "DMANPART" *****
           PERFORM 9999-DBFIND-DMANPART-CD-O.
           PERFORM 8210-GET-DEL-DMANPART
              UNTIL NOT GOOD-CALL.

      ***** DELETE ALL ENTRIES FOR THIS CODE IN "DCODE" *****
           PERFORM 9999-DBFIND-DCODE-CD-O.
           PERFORM 8220-GET-DEL-DCODE
              UNTIL NOT GOOD-CALL.

      ***** DELETE RESTRICTION TABLE IN "DRESTRIC" IF RESTRICTED ******
           IF STR-RESTRICTED-FLG = "X"
               PERFORM 9999-DBFIND-DRESTRIC-O
               PERFORM 8230-GET-DEL-DRESTRIC.

       7310-DELETE-MSTORERM.
           PERFORM 9940-UNLOCK.

      ***** DELETE THE "MSTORERM" ENTRY FOR THIS CODE *****

           MOVE "MSTORERM;" TO DSET-NAME.
           PERFORM 9930-LOCK.

           PERFORM 9999-DBGET7-MSTORERM-CD-O.
           PERFORM 9999-DBDELETE-MSTORERM-CD-O.

      *    CALL "DBEND" USING BASE, DB-LOG-TEXT, MODE1,
      *        STATUS-AREA, DB-LOG-TEXT-LEN.
      *    IF COND-WORD NOT = 0
      *        MOVE "DBEND ERROR IN 7300-PROCESS-DELETE"
      *            TO BU-DISPLAY-MSG
      *        PERFORM 2100-BLOWUP.
      *
           PERFORM 9940-UNLOCK.

      ***** DELETE USAGE FILE ENTRY FOR THIS CODE *****
           MOVE CODE-ARG TO KEY-VALUE.
           PERFORM 9999-DBGET7-USAGEFIL-CD-O.
           IF GOOD-CALL
               PERFORM 9999-DBDELETE-USAGEFIL-CD-O.

      ***** DELETE RECEIPT FILE ENTRY FOR THIS CODE *****
           MOVE CODE-ARG TO KEY-VALUE.
           PERFORM 9999-DBGET7-RECEIPTFIL-CD-O.
           IF GOOD-CALL
               PERFORM 9999-DBDELETE-RECEIPTFIL-CD-O.

      ***** DELETE CODE FROM ALTERNATE KEY FILE *****
           MOVE SPACES TO BU-DISPLAY-MSG.
           CALL "SCCALTCH" USING CODE-ARG NEW-CODE
                           BU-DISPLAY-MSG BU-DISPLAY-FLDS.
           IF BU-DISPLAY-MSG NOT = SPACES
               PERFORM 2100-BLOWUP.

      ***** DELETE CODE FROM MMISA PM-JOBPLAN *****
           MOVE SPACES TO BU-DISPLAY-MSG.
           CALL "SJOBPCOD" USING CODE-ARG NEW-CODE NEW-UM NEW-UM-CF
                           BU-DISPLAY-MSG BU-DISPLAY-FLDS.
           IF BU-DISPLAY-MSG NOT = SPACES
               PERFORM 2100-BLOWUP.

      ***** DELETE CODE FROM MMISA CORP-CODE-LINK *****
           MOVE SPACES TO BU-DISPLAY-MSG.
           CALL "SCCLKCHG" USING CODE-ARG NEW-CODE
                           BU-DISPLAY-MSG BU-DISPLAY-FLDS.
           IF BU-DISPLAY-MSG NOT = SPACES
               PERFORM 2100-BLOWUP.

      ***** ADD A 110 TRANSACTION TO THE DATABASE FOR THE CODE DELETE ****

           MOVE "DDAILYTC;" TO DSET-NAME.
           PERFORM 9930-LOCK.

           MOVE SPACES                   TO   BUF-DDAILYTC.
           CALL "TDATECHK" USING DATE-CHECK-AREA.
           MOVE DATE-YMD-OUT             TO   DDAILYTC-DATE.
           MOVE DATE-UNFORMATTED-TIME-OUT TO  DDAILYTC-TIME.
           MOVE "110"                    TO   DDAILYTC-TC.
           MOVE MPLTINFO-PLANT-CODE      TO   DDAILYTC-PLT.
           MOVE CODE-ARG                 TO   TC110-CORP-CODE.

           PERFORM 9999-DBPUT-DDAILYTC-DL-O.

           PERFORM 9940-UNLOCK.

       7390-PD-X.
           EXIT.

       8000-GET-DEL-DVENDITM.
           PERFORM 9999-DBGET5-DVENDITM-CD-O.
           IF GOOD-CALL
               PERFORM 9999-DBDELETE-DVENDITM-CD-O.

       8100-GET-DEL-DDESC.
           PERFORM 9999-DBGET5-DDESC-CD-O.
           IF GOOD-CALL
               PERFORM 9999-DBDELETE-DDESC-CD-O.

       8200-GET-DEL-DDESC2.
           PERFORM 9999-DBGET5-DDESC2-CD-O.
           IF GOOD-CALL
               PERFORM 9999-DBDELETE-DDESC2-CD-O.

       8210-GET-DEL-DMANPART.
           PERFORM 9999-DBGET5-DMANPART-CD-O.
           IF GOOD-CALL
               PERFORM 9999-DBDELETE-DMANPART-CD-O.

       8220-GET-DEL-DCODE.
           PERFORM 9999-DBGET5-DCODE-CD-O.
           IF GOOD-CALL
               PERFORM 9999-DBDELETE-DCODE-CD-O.

       8230-GET-DEL-DRESTRIC.
           PERFORM 9999-DBGET5-DRESTRIC-O.
           IF GOOD-CALL
               PERFORM 9999-DBDELETE-DRESTRIC-O.

       998-WRITE-SCREEN.
           WRITE DISPLAY-REC  FORMAT IS VIEW-NFNAME
               INDIC ARE SRF-INDICATORS.
           MOVE ALL B"0" TO SRF-INDICATORS.

       998-READ-SCREEN.
           READ  DISPLAY-FILE FORMAT IS VIEW-NFNAME
               INDIC ARE SRF-INDICATORS.
           ACCEPT IOFEEDBACK FROM I-O-FEEDBACK-AREA.
           MOVE ALL B"0" TO SRF-INDICATORS.

      *------ A BAD STATUS MAY MEAN USER TURNED OFF TERMINAL.
      *------ IF SO, SIMULATE THE F3 KEY TO EXIT PROGRAM.
           IF DISPLAY-STATUS NOT = "00"
               MOVE 3 TO VIEW-LASTKEY
           ELSE
               MOVE FUNCTION-NUM TO VIEW-LASTKEY.

           MOVE SPACES TO MESSAGE-BUFFER-1.

           IF VIEW-LASTKEY = 3
               GO TO 9989-WS-X.

           IF VIEW-LASTKEY = 1 OR
                           = 2 OR
                           = 4 OR
                           = 5 OR
                           = 6 OR
                           = 7 OR
                           = 8
      *M-----  INVALID FUNCTION KEY
               MOVE   9 TO LANG-SETNUM
               MOVE  10 TO LANG-MSGNUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE   1 TO  FIELD-NUMBER.
               IF MESSAGE-BUFFER-1 = SPACES
                   MOVE SPACES TO SRF-FKEY-AREA, SRF-ENTER-FLAG.

       9989-WS-X.
           EXIT.

       COPY HCATREAD IN COPYLIB.

       9930-LOCK.
       9931-MULTI-LOCK.
       9940-UNLOCK.
       9951-GETNEXTFORM.
       9952-GETBUFFER.
           MOVE DISPLAY-REC TO DE-FIELDS.

       9953-PUTBUFFER.
           MOVE DE-FIELDS TO DISPLAY-REC.

       9954-SETERROR.
           MOVE B"1" TO IND (99).
           MOVE B"1" TO IND (FIELD-NUMBER).
           MOVE MESSAGE-BUFFER TO DE-MESSAGE-LINE.

       9955-CLEAR-FORM.
           MOVE SPACES TO DE-FIELDS, MESSAGE-BUFFER.

       9956-PUTWINDOW.
       9957-FIELDEDITS.
       9958-INITFORM.
       9959-SHOWFORM.
       9960-SETKEYLABEL.
       9961-AUTOREAD.
       9962-OPENFORM.
       9963-CLOSEFORM.
       9964-FINISHFORM.

       9999-DBGET7-MSTORERM-CD-O.
           MOVE 0 TO COND-WORD.
           MOVE CODE-ARG TO CORPCDE OF MSTORERM-CD-REC-O.
           READ MSTORERM-CD-O INTO BUF-MSTORERM
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS = "23"
               MOVE 17 TO COND-WORD
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE "DBGET7 ERR 9999-DBGET7-MSTORERM-CD-O"
                   TO BU-MSG-AREA
               MOVE 99 TO COND-WORD
               PERFORM 2100-BLOWUP.

       9999-RESET-MSTORERM-CD-O.
           MOVE HIGH-VALUES TO CORPCDE OF MSTORERM-CD-REC-O.
           START MSTORERM-CD-O KEY > CORPCDE OF MSTORERM-CD-REC-O
               INVALID KEY MOVE "00" TO FILE-STATUS.

       9999-DBGET7-USAGEFIL-CD-O.
           MOVE 0 TO COND-WORD.
           MOVE CODE-ARG TO CORPCDE OF USAGEFIL-CD-REC-O.
           READ USAGEFIL-CD-O INTO BUF-USAGEFIL
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS = "23"
               MOVE 17 TO COND-WORD
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE "DBGET7 ERR 9999-DBGET7-USAGEFIL-CD-O"
                   TO BU-MSG-AREA
               MOVE 99 TO COND-WORD
               PERFORM 2100-BLOWUP.

       9999-DBGET7-RECEIPTFIL-CD-O.
           MOVE 0 TO COND-WORD.
           MOVE CODE-ARG TO CORPCDE OF RECEIPTFIL-CD-REC-O.
           READ RECEIPTFIL-CD-O INTO BUF-RECEIPTFIL
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS = "23"
               MOVE 17 TO COND-WORD
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE "DBGET7 ERR 9999-DBGET7-RECEIPTFIL-CD-O"
                   TO BU-MSG-AREA
               MOVE 99 TO COND-WORD
               PERFORM 2100-BLOWUP.

       9999-DBDELETE-MSTORERM-CD-O.
           MOVE 0 TO COND-WORD.
           DELETE MSTORERM-CD-O
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE "DBDELETE ERR 9999-DBDELETE-MSTORERM-CD-O"
                   TO BU-MSG-AREA
               MOVE 99 TO COND-WORD
               PERFORM 2100-BLOWUP.

       9999-DBDELETE-USAGEFIL-CD-O.
           MOVE 0 TO COND-WORD.
           DELETE USAGEFIL-CD-O
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE "DBDELETE ERR 9999-DBDELETE-USAGEFIL-CD-O"
                   TO BU-MSG-AREA
               MOVE 99 TO COND-WORD
               PERFORM 2100-BLOWUP.

       9999-DBDELETE-RECEIPTFIL-CD-O.
           MOVE 0 TO COND-WORD.
           DELETE RECEIPTFIL-CD-O
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE "DBDELETE ERR 9999-DBDELETE-RECEIPTFIL-CD-O"
                   TO BU-MSG-AREA
               MOVE 99 TO COND-WORD
               PERFORM 2100-BLOWUP.

       9999-DBFIND-DVENDITM-CD-O.
           MOVE 0 TO COND-WORD.
           MOVE CODE-ARG TO CORPCDE OF DVENDITM-CD-REC-O.
           START DVENDITM-CD-O KEY = CORPCDE OF DVENDITM-CD-REC-O
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF (FILE-STATUS NOT = "00") AND (FILE-STATUS-1 NOT = "2")
               MOVE "DBFIND ERR 9999-DBFIND-DVENDITM-CD-O"
                   TO BU-MSG-AREA
               MOVE 99 TO COND-WORD
               PERFORM 2100-BLOWUP.

       9999-DBGET5-DVENDITM-CD-O.
           MOVE 0 TO COND-WORD.
           READ DVENDITM-CD-O NEXT INTO BUF-DVENDITM
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14"
                   PERFORM 9999-RESET-DVENDITM-CD-O
                   MOVE 15 TO COND-WORD
               ELSE
               IF FILE-STATUS = "46"
                   MOVE 15 TO COND-WORD
               ELSE
                   MOVE "DBGET5 ERR 9999-DBGET5-DVENDITM-CD-O"
                       TO BU-MSG-AREA
                   MOVE 99 TO COND-WORD
                   PERFORM 2100-BLOWUP
           ELSE
           IF CORPCDE OF DVENDITM-CD-REC-O NOT = CODE-ARG
               PERFORM 9999-RESET-DVENDITM-CD-O
               MOVE 15 TO COND-WORD.

       9999-RESET-DVENDITM-CD-O.
           MOVE HIGH-VALUES TO CORPCDE OF DVENDITM-CD-REC-O.
           START DVENDITM-CD-O KEY > CORPCDE OF DVENDITM-CD-REC-O
               INVALID KEY MOVE "00" TO FILE-STATUS.

       9999-DBDELETE-DVENDITM-CD-O.
           MOVE 0 TO COND-WORD.
           DELETE DVENDITM-CD-O
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE "DBDELETE ERR 9999-DBDELETE-DVENDITM-CD-O"
                   TO BU-MSG-AREA
               MOVE 99 TO COND-WORD
               PERFORM 2100-BLOWUP.

       9999-DBFIND-DDESC-CD-O.
           MOVE 0 TO COND-WORD.
           MOVE CODE-ARG TO CORPCDE OF DDESC-CD-REC-O.
           START DDESC-CD-O KEY = CORPCDE OF DDESC-CD-REC-O
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF (FILE-STATUS NOT = "00") AND (FILE-STATUS-1 NOT = "2")
               MOVE "DBFIND ERR 9999-DBFIND-DDESC-CD-O"
                   TO BU-MSG-AREA
               MOVE 99 TO COND-WORD
               PERFORM 2100-BLOWUP.

       9999-DBGET5-DDESC-CD-O.
           MOVE 0 TO COND-WORD.
           READ DDESC-CD-O NEXT INTO BUF-DDESC
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14"
                   PERFORM 9999-RESET-DDESC-CD-O
                   MOVE 15 TO COND-WORD
               ELSE
               IF FILE-STATUS = "46"
                   MOVE 15 TO COND-WORD
               ELSE
                   MOVE "DBGET5 ERR 9999-DBGET5-DDESC-CD-O"
                       TO BU-MSG-AREA
                   MOVE 99 TO COND-WORD
                   PERFORM 2100-BLOWUP
           ELSE
           IF CORPCDE OF DDESC-CD-REC-O NOT = CODE-ARG
               PERFORM 9999-RESET-DDESC-CD-O
               MOVE 15 TO COND-WORD.

       9999-RESET-DDESC-CD-O.
           MOVE HIGH-VALUES TO CORPCDE OF DDESC-CD-REC-O.
           START DDESC-CD-O KEY > CORPCDE OF DDESC-CD-REC-O
               INVALID KEY MOVE "00" TO FILE-STATUS.

       9999-DBDELETE-DDESC-CD-O.
           MOVE 0 TO COND-WORD.
           DELETE DDESC-CD-O
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE "DBDELETE ERR 9999-DBDELETE-DDESC-CD-O"
                   TO BU-MSG-AREA
               MOVE 99 TO COND-WORD
               PERFORM 2100-BLOWUP.

       9999-DBFIND-DDESC2-CD-O.
           MOVE 0 TO COND-WORD.
           MOVE CODE-ARG TO CORPCDE OF DDESC2-CD-REC-O.
           START DDESC2-CD-O KEY = CORPCDE OF DDESC2-CD-REC-O
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF (FILE-STATUS NOT = "00") AND (FILE-STATUS-1 NOT = "2")
               MOVE "DBFIND ERR 9999-DBFIND-DDESC2-CD-O"
                   TO BU-MSG-AREA
               MOVE 99 TO COND-WORD
               PERFORM 2100-BLOWUP.

       9999-DBGET5-DDESC2-CD-O.
           MOVE 0 TO COND-WORD.
           READ DDESC2-CD-O NEXT INTO BUF-DDESC2
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14"
                   PERFORM 9999-RESET-DDESC2-CD-O
                   MOVE 15 TO COND-WORD
               ELSE
               IF FILE-STATUS = "46"
                   MOVE 15 TO COND-WORD
               ELSE
                   MOVE "DBGET5 ERR 9999-DBGET5-DDESC2-CD-O"
                       TO BU-MSG-AREA
