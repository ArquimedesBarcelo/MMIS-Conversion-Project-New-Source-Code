       IDENTIFICATION DIVISION.
       PROGRAM-ID.        TPOLIVE.
       AUTHOR.            ANNETTE M. KRAUSS.
       DATE-WRITTEN.      OCTOBER 1986.
      *REMARKS.
      ***********************************************************
      *                                                         *
      *                     T P O L I V E                       *
      *                                                         *
      *D    THIS PROGRAM IS THE MAIN PROGRAM FOR PURCHASE       *
      *D    ORDER LOAD FROM THE HISTORY DATA BASE 'STHIST' TO   *
      *D    THE LIVE DATA BASE 'STORES'.                        *
      *                                                         *
      ***********************************************************
      *C  21DEC1992    DAVE PLUM     REQUEST #6337
      *C  ADDED LOGIC TO ALLOW "NON-RECEIVABLE" POS TO BE RECALLED
      *C  EVEN WHEN THE QTY DELIVERED IS NOT EQUAL TO THE QTY PAID.
      *C
      *C  02/21/94     JEFF BUNGO    REQUEST #6449
      *C     ADDED NEW FIELDS TO THE HISTORY DATABASES TO MATCH THE
      *C     LIVE DATABASES.  CHANGED THIS PROGRAM TO MOVE THESE
      *C     NEW HISTORY FIELDS BACK TO LIVE ON A RECALL.
      *C
      *C  04/08/97     CA YODER
      *C     PROGRAM WAS CHECKING FOR THE EXISTENCE OF THE MACTINFO
      *C     FILE TO SEE IF CSAS WAS BEING USED.  HOWEVER, THIS WAS
      *C     CAUSING A PROBLEM WITH RECALLING PO'S SINCE THE CSAS
      *C     FILES ALWAYS EXIST, EVEN IF CSAS IS NOT BEING USED.
      *C     CHANGED THIS TO CHECK THE "CSAS" KEY IN MPLTINFO INSTEAD.
      *C
      *C  08/07/98     CA YODER
      *C     ADDED LOGIC TO CHECK FOR DUPLICATE REGISTERS HERE SO THE
      *C     ERROR MESSAGE CAN DISPLAY ON THE SCREEN INSTEAD OF BLOWING
      *C     UP IN SPOLIVE.
      *C

       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.
       SOURCE-COMPUTER.  IBM-AS400.
       OBJECT-COMPUTER.  IBM-AS400.

       SPECIAL-NAMES.   I-O-FEEDBACK IS I-O-FEEDBACK-AREA.

       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT DISPLAY-FILE
                  ASSIGN TO WORKSTATION-ZPOLIVE-SI
                  ORGANIZATION IS TRANSACTION
                  ACCESS IS SEQUENTIAL
                  FILE STATUS IS DISPLAY-STATUS
                  CONTROL-AREA IS WS-CONTROL.

           SELECT MPLTINFO-I
                  ASSIGN TO DATABASE-MCFLCS0501
                  ORGANIZATION IS INDEXED
                    ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                  FILE STATUS IS FILE-STATUS.

           SELECT MSTORERM-I
                  ASSIGN TO DATABASE-MCFLCS0201
                  ORGANIZATION IS INDEXED
                    ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                  FILE STATUS IS FILE-STATUS.

           SELECT DPORECD-I
                  ASSIGN TO DATABASE-MCFLCS0901
                  ORGANIZATION IS INDEXED
                    ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                    WITH DUPLICATES
                  FILE STATUS IS FILE-STATUS.

           SELECT DVENDOR-I
                  ASSIGN TO DATABASE-MCFLCS0701
                  ORGANIZATION IS INDEXED
                    ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                    WITH DUPLICATES
                  FILE STATUS IS FILE-STATUS.

           SELECT DVENDOR-O
                  ASSIGN TO DATABASE-MCFLCS0701
                  ORGANIZATION IS INDEXED
                    ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                    WITH DUPLICATES
                  FILE STATUS IS FILE-STATUS.

           SELECT DPORECDH-I
                  ASSIGN TO DATABASE-MCFLST0301
                  ORGANIZATION IS INDEXED
                    ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                    WITH DUPLICATES
                  FILE STATUS IS FILE-STATUS.

           SELECT DPOITEMH-I
                  ASSIGN TO DATABASE-MCFLST0401
                  ORGANIZATION IS INDEXED
                    ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                    WITH DUPLICATES
                  FILE STATUS IS FILE-STATUS.

           SELECT DVENDORH-I
                  ASSIGN TO DATABASE-MCFLST0201
                  ORGANIZATION IS INDEXED
                    ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                    WITH DUPLICATES
                  FILE STATUS IS FILE-STATUS.

           SELECT MACTINFO-I
                  ASSIGN TO DATABASE-MCFLCA0101
                  ORGANIZATION IS INDEXED
                    ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                  FILE STATUS IS FILE-STATUS.

           SELECT DINVRCD-I
               ASSIGN TO DATABASE-MCFLCS2501
               ORGANIZATION IS INDEXED
                 ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                 WITH DUPLICATES
               FILE STATUS IS FILE-STATUS.

           SELECT DINVRCDH-I
               ASSIGN TO DATABASE-MCFLST0802
               ORGANIZATION IS INDEXED
                 ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                   WITH DUPLICATES
               FILE STATUS IS FILE-STATUS.

       DATA DIVISION.
       FILE SECTION.
       FD  DISPLAY-FILE
           LABEL RECORDS ARE OMITTED.
       01  DISPLAY-REC.
           COPY DDS-ALL-FORMATS OF ZPOLIVE.

       FD  MPLTINFO-I
           LABEL RECORDS ARE STANDARD.
       01  MPLTINFO-I-REC.
           COPY DDS-MCRPCS0500  OF MCFLCS0501.

       FD  MSTORERM-I
           LABEL RECORDS ARE STANDARD.
       01  MSTORERM-I-REC.
           COPY DDS-MCRPCS0200  OF MCFLCS0201.

       FD  DPORECD-I
           LABEL RECORDS ARE STANDARD.
       01  DPORECD-I-REC.
           COPY DDS-MCRPCS0900  OF MCFLCS0901.

       FD  DVENDOR-I
           LABEL RECORDS ARE STANDARD.
       01  DVENDOR-I-REC.
           COPY DDS-MCRPCS0700   OF MCFLCS0701.

       FD  DVENDOR-O
           LABEL RECORDS ARE STANDARD.
       01  DVENDOR-O-REC.
           COPY DDS-MCRPCS0700   OF MCFLCS0701.

       FD  DPORECDH-I
           LABEL RECORDS ARE STANDARD.
       01  DPORECDH-I-REC.
           COPY DDS-MCRPST0300   OF MCFLST0301.

       FD  DPOITEMH-I
           LABEL RECORDS ARE STANDARD.
       01  DPOITEMH-I-REC.
           COPY DDS-MCRPST0400   OF MCFLST0401.

       FD  DVENDORH-I
           LABEL RECORDS ARE STANDARD.
       01  DVENDORH-I-REC.
           COPY DDS-MCRPST0200   OF MCFLST0201.

       FD  MACTINFO-I
           LABEL RECORDS ARE STANDARD.
       01  MACTINFO-I-REC.
           COPY DDS-MCRPCA0100  OF MCFLCA0101.

       FD  DINVRCD-I
           LABEL RECORDS ARE STANDARD.
       01  DINVRCD-REC-I.
           COPY DDS-MCRPCS2500  OF MCFLCS2501.

       FD  DINVRCDH-I
           LABEL RECORDS ARE STANDARD.
       01  DINVRCDH-REC-I.
           COPY DDS-ALL-FORMATS OF MCFLST0802.

       WORKING-STORAGE SECTION.
       01  FILE-STATUS.
           05  FILE-STATUS-1            PIC X  VALUE "0".
           05  FILE-STATUS-2            PIC X  VALUE "0".

       77  SAVE-VEN-NAME              PIC X(44) VALUE SPACES.
       77  PASSED-SPOOL-PRT           PIC S9(2) COMP VALUE 0.
       77  COMPANY-SAVE               PIC X(3)  VALUE SPACES.
       01  SAVE-VEN-CODE.
           05  S-VEN-1                PIC X(1)  VALUE SPACES.
           05  FILLER                 PIC X(6)  VALUE SPACES.
           05  S-VEN-8-10             PIC X(3)  VALUE SPACES.
       01  SAVE-POH-NON-RCV-INDIC     PIC X(1)  VALUE SPACES.

       01  TRY-000-SW                 PIC X(1)  VALUE "N".
           88  TRIED-000-VEN                    VALUE "Y".
       01  ALT-VEN-CODE               PIC X(10) VALUE SPACES.
       01  ADD-TEMP-VEN-SW            PIC X(1)  VALUE "N".
           88  ADD-TEMP-VEN                     VALUE "Y".

       01  CSAS-SW                    PIC X(1)  VALUE "N".
           88  RUNNING-CSAS                     VALUE "Y".

       01  BUILD-POH-NUMBER.
           05  BUILD-POH-NUM          PIC X(7)  VALUE SPACES.
           05  BUILD-POH-REL          PIC X(3)  VALUE SPACES.
           05  BUILD-POH-RCVR         PIC X(3)  VALUE SPACES.
           05  BUILD-POH-DUP-ID       PIC X(1)  VALUE SPACES.

       01  BUILD-PO-NUMBER.
           05  BUILD-PO-PREFIX        PIC X(1)  VALUE "P".
           05  BUILD-PO-NUM           PIC X(7)  VALUE SPACES.
           05  BUILD-PO-REL           PIC X(3)  VALUE SPACES.
           05  BUILD-PO-RCVR          PIC X(3)  VALUE SPACES.

       01  POH-RECALL-SCREEN.
           03  POH-NUM                PIC X(7).
           03  POH-REL                PIC 9(3).
           03  POH-RECALL-MSG1        PIC X(79).
           03  POH-RECALL-MSG2        PIC X(79).
           03  POH-ERRLINE            PIC X(79).
           03  POH-MSGLINE            PIC X(79).

       01  BUILD-POH-MSG.
           05  VENDOR-CODE-LIT        PIC X(14)  VALUE SPACES.
           05  VENDOR-CODE-OUT        PIC X(10)  VALUE SPACES.
           05  FILLER                 PIC X(4)   VALUE SPACES.
           05  VENDOR-NAME-LIT        PIC X(14)  VALUE SPACES.
           05  VENDOR-NAME-OUT        PIC X(28)  VALUE SPACES.
           05  FILLER                 PIC X(2)   VALUE SPACES.
           05  DB-LIT                 PIC X(7)   VALUE SPACES.

       01  CORP-CODE-MESSAGE.
           05  FILLER                 PIC X(21) VALUE SPACES.
           05  CORP-CODE-OUT          PIC X(8)  VALUE SPACES.
           05  FILLER                 PIC X(47) VALUE SPACES.

       01  VENDOR-CODE-MESSAGE.
           05  FILLER                 PIC X(17) VALUE SPACES.
           05  VEN-CODE-OUT           PIC X(10) VALUE SPACES.
           05  FILLER                 PIC X(45) VALUE SPACES.

       01  UNITS-ERROR-MESSAGE.
           05  FILLER                 PIC X(56) VALUE SPACES.
           05  ITEM-NO-OUT            PIC X(4)  VALUE SPACES.
           05  FILLER                 PIC X(16) VALUE SPACES.

       01  UM-ERROR-MESSAGE.
           05  FILLER                 PIC X(17) VALUE SPACES.
           05  UM-ITEM-OUT            PIC X(4)  VALUE SPACES.
           05  FILLER                 PIC X(41) VALUE SPACES.
           05  UM-CORP-CODE-OUT       PIC X(7)  VALUE SPACES.
           05  FILLER                 PIC X(7)  VALUE SPACES.

       01  MESSAGE-BUFFER.
           05  MSG-TEXT               PIC X(64)  VALUE SPACES.
           05  MSG-FLD                PIC X(12)  VALUE SPACES.
           05  MSG-FLD-9 REDEFINES MSG-FLD
                                      PIC Z(11)9.

       01  MESSAGE-BUFLEN             PIC S9(4)  COMP VALUE 76.
       01  MESSAGE-ACTLEN             PIC S9(4)  COMP VALUE 76.

      **************************************************************
      **************************************************************
      **                                                          **
      **                DATABASE I/O BUFFER AREA                  **
      **                                                          **
      **************************************************************
      **************************************************************

       COPY DATAB     IN COPYLIB.

       COPY DBSTHIST  IN COPYLIB.

       COPY DBCSACCT  IN COPYLIB.

       COPY DVENDOR   IN COPYLIB.

       COPY MSTORERM  IN COPYLIB.

       COPY MPLTINFO  IN COPYLIB.

      ************************************************
      *                                              *
      *   I/O BUFFERS FOR STORES HISTORY DATA BASE   *
      *                                              *
      ************************************************

       COPY DPORECDH  IN COPYLIB.

       COPY DPOITEMH  IN COPYLIB.

       COPY DVENDORH  IN COPYLIB.

       COPY DINVRCD   IN COPYLIB.

       COPY DINVRCDH  IN COPYLIB.

       01  ARG-VALUES.
           05  PO-ARG                 PIC X(14) VALUE SPACES.
           05  CODE-ARG               PIC X(8)  VALUE SPACES.
           05  VEN-ARG                PIC X(10) VALUE SPACES.
           05  PLT-ARG                PIC X(4)  VALUE SPACES.
           05  REGISTER-ARG           PIC X(6)  VALUE SPACES.

      *************************************************************
      *************************************************************
      **                                                         **
      **                 CALLED SUBPROGRAMS                      **
      **                                                         **
      *************************************************************
      *************************************************************
       COPY TBLOWUP  IN COPYLIB.
       COPY VCOMAREA IN COPYLIB.
       COPY LANGUAGE IN COPYLIB.
       COPY DISPDATA IN COPYLIB.
       COPY CATREAD  IN COPYLIB.
       COPY IOFEEDBACK IN COPYLIB.

      *************************************************************
      **#########################################################**
      *************************************************************
      **                                                         **
      **          P R O C E D U R E    D I V I S I O N           **
      **                                                         **
      *************************************************************
      **#########################################################**
      *************************************************************


       PROCEDURE DIVISION.

       BEGIN-HERE.

           PERFORM 1-HSK          THRU  1-HSK-X.
           PERFORM 6-MAIN         THRU  6-MAIN-X.
           PERFORM 2-EOJ          THRU  2-EOJ-X.

           GOBACK.



       1-HSK.

      *************************************************************
      *     OPEN STORES AND STHIST DATABASE FILES
      *************************************************************

           OPEN INPUT MPLTINFO-I, MSTORERM-I, DVENDOR-I, DPORECD-I,
                      DPORECDH-I, DPOITEMH-I, DVENDORH-I,
                      DINVRCD-I, DINVRCDH-I.
           OPEN I-O   DISPLAY-FILE, DVENDOR-O.

      *************************************************************
      *     OPEN CSAS DATA BASE FILE
      *************************************************************

      *------- CHANGED TO CHECK MPLTINFO INSTEAD OF EXISTENCE OF
      *------- MACTINFO FILE.
      *****OPEN INPUT MACTINFO-I.
           MOVE "CSAS"       TO PLT-ARG.
           MOVE PLT-ARG      TO PLTINFOKEY OF MPLTINFO-I-REC.
           READ MPLTINFO-I INTO BUF-MPLTINFO
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS  = "00"
               MOVE "Y"                  TO CSAS-SW.

      ******************************************
      *   GET CO. CODE FROM MPLTINFO
      ******************************************

           MOVE "P 01"       TO PLT-ARG.
           MOVE PLT-ARG      TO PLTINFOKEY OF MPLTINFO-I-REC.
           READ MPLTINFO-I INTO BUF-MPLTINFO
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE "READ MPLTINFO 'P 01' *1-HSK" TO BU-DISPLAY-MSG
               GO TO 2-BLOWUP
           ELSE
               MOVE MPLTINFO-COMPANY  TO  COMPANY-SAVE.

       1-HSK-X.
           EXIT.


       2-EOJ.
           CLOSE MPLTINFO-I, MSTORERM-I, DVENDOR-I, DPORECD-I,
                 DPORECDH-I, DPOITEMH-I, DVENDORH-I, DVENDOR-O,
                 DISPLAY-FILE, MACTINFO-I DINVRCD-I, DINVRCDH-I.

       2-EOJ-X.
           EXIT.



      ******************************************************
      **                                                  **
      **   BLOWUP ROUTINE                                 **
      **                                                  **
      ******************************************************

       2-BLOWUP.
           MOVE "TPOLIVE"  TO BU-PGM-NAME.
           CALL "TBLOWUP" USING BASE, BU-PGM-NAME, STATUS-AREA,
               DUMMY-VIEW-AREA, FILE-STATUS, BU-DISPLAY-MSG,
                   BU-DISPLAY-FLDS.


       3-BLOWUP.
           MOVE "TPOLIVE"  TO BU-PGM-NAME.
           CALL "TBLOWUP" USING BASE-STHIST, BU-PGM-NAME, STATUS-AREA,
               DUMMY-VIEW-AREA, FILE-STATUS, BU-DISPLAY-MSG,
                   BU-DISPLAY-FLDS.


       6-MAIN.
           MOVE "PORECALL" TO VIEW-NFNAME.

       6-PUT-BUFFER.
           MOVE SPACES TO POH-RECALL-SCREEN.
           MOVE ZEROS  TO POH-REL.

       6-SHOW-FORM.
           MOVE POH-RECALL-SCREEN  TO DISPLAY-REC.
           PERFORM 998-WRITE-SCREEN THRU 998-READ-SCREEN.
           MOVE DISPLAY-REC        TO POH-RECALL-SCREEN.

       6-READ-FIELDS.
           IF VIEW-LASTKEY = 3
               GO TO 6-MAIN-X.

           IF VIEW-LASTKEY = 1 OR
              VIEW-LASTKEY = 2 OR
              VIEW-LASTKEY = 4 OR
              VIEW-LASTKEY = 5 OR
              VIEW-LASTKEY = 6 OR
              VIEW-LASTKEY = 7 OR
              VIEW-LASTKEY = 8
      *****    INVALID FUNCTION KEY    *****
               MOVE   9 TO LANG-SETNUM
               MOVE  10 TO LANG-MSGNUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER TO POH-MSGLINE
               MOVE B"1"           TO IND(99)
               GO TO 6-SHOW-FORM.

           MOVE POH-NUM TO BUILD-POH-NUM, BUILD-PO-NUM.
           MOVE POH-REL TO BUILD-POH-REL, BUILD-PO-REL.
           MOVE ZEROS   TO BUILD-POH-RCVR, BUILD-PO-RCVR.
           MOVE SPACES  TO BUILD-POH-DUP-ID.

       61-CHECK-HISTORY-DB.
           MOVE BUILD-POH-NUMBER TO PO-ARG.
           MOVE PO-ARG           TO PORCVNO OF DPORECDH-I-REC.
           START DPORECDH-I KEY = PORCVNO OF DPORECDH-I-REC
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
      ***  P.O. DOES NOT EXIST IN HISTORY FILE  ***
                   MOVE  16  TO LANG-SETNUM
                   MOVE  54  TO LANG-MSGNUM
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE MESSAGE-BUFFER TO POH-RECALL-MSG1
                   MOVE SPACES         TO POH-RECALL-MSG2
      ***  ENTER ANOTHER P.O. FOR RECALL OR PRESS 'f8' TO END  ***
                   MOVE   5  TO LANG-SETNUM
                   MOVE  43  TO LANG-MSGNUM
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE MESSAGE-BUFFER TO POH-MSGLINE
                   MOVE B"1"           TO IND(99), IND(1)
                   GO TO 6-SHOW-FORM
               ELSE
                   MOVE "FIND DPORECD-H * 61-CHECK-HISTORY-DB"
                        TO BU-DISPLAY-MSG
                   MOVE BUILD-POH-NUMBER  TO BU-DISPLAY-FLD (1)
                   GO TO 3-BLOWUP.

           READ DPORECDH-I NEXT INTO BUF-DPORECD-H
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE "READN DPORECDH*61-CHECK-HISTORY-DB"
                        TO BU-DISPLAY-MSG
               MOVE PO-ARG            TO BU-DISPLAY-FLD (1)
               GO TO 3-BLOWUP
           ELSE
               MOVE POH-NON-RCV-INDIC TO SAVE-POH-NON-RCV-INDIC
               MOVE POH-VEN-CODE    TO SAVE-VEN-CODE.

           MOVE SAVE-VEN-CODE   TO VEN-ARG.
           MOVE VEN-ARG         TO VENCDE OF DVENDORH-I-REC.
           START DVENDORH-I KEY = VENCDE OF DVENDORH-I-REC
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
      ***  VENDOR CODE ########## DOES NOT EXIST IN HISTORY DATABASE  ***
                   MOVE  22  TO LANG-SETNUM
                   MOVE  17  TO LANG-MSGNUM
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE MESSAGE-BUFFER TO VENDOR-CODE-MESSAGE
                   MOVE SAVE-VEN-CODE  TO VEN-CODE-OUT
                   MOVE VENDOR-CODE-MESSAGE TO POH-RECALL-MSG1
                   MOVE SPACES              TO POH-RECALL-MSG2
      ***  ENTER ANOTHER P.O. FOR RECALL OR PRESS 'f8' TO END  ***
                   MOVE   5  TO LANG-SETNUM
                   MOVE  43  TO LANG-MSGNUM
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE MESSAGE-BUFFER TO POH-MSGLINE
                   MOVE B"1"           TO IND(99), IND(1)
                   GO TO 6-SHOW-FORM
               ELSE
                   MOVE "FIND DVENDOR * 61-CHECK-HISTORY-DB"
                        TO BU-DISPLAY-MSG
                   MOVE VEN-ARG           TO BU-DISPLAY-FLD (1)
                   MOVE "FIND DVENDOR-H * 61-CHECK-HISTORY-DB"
                        TO BU-DISPLAY-MSG
                   MOVE VEN-ARG           TO BU-DISPLAY-FLD (1)
                   GO TO 3-BLOWUP.

           READ DVENDORH-I NEXT INTO BUF-DVENDOR-H
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE "READN DVENDOR * 61-CHECK-HISTORY-DB"
                    TO BU-DISPLAY-MSG
               MOVE SAVE-VEN-CODE TO BU-DISPLAY-FLD (1)
               GO TO 3-BLOWUP
           ELSE
               MOVE VENH-ITM-DATA TO SAVE-VEN-NAME
               GO TO 62-CHECK-LIVE-DB.

       62-CHECK-LIVE-DB.
           MOVE BUILD-PO-NUMBER TO PO-ARG.
           MOVE PO-ARG TO PORCVNO OF DPORECD-I-REC.
           START DPORECD-I KEY = PORCVNO OF DPORECD-I-REC
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
                   NEXT SENTENCE
               ELSE
                   MOVE "FIND DPORECD * 62-CHECK-LIVE-DB"
                        TO BU-DISPLAY-MSG
                   MOVE BUILD-PO-NUMBER   TO BU-DISPLAY-FLD (1)
                   GO TO 2-BLOWUP
           ELSE
      ***  P.O. EXISTS AND HAS NOT BEEN DELETED YET  ***
                   MOVE  16  TO LANG-SETNUM
                   MOVE  53  TO LANG-MSGNUM
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE MESSAGE-BUFFER TO POH-RECALL-MSG1
                   MOVE SPACES         TO POH-RECALL-MSG2
      ***  ENTER ANOTHER P.O. FOR RECALL OR PRESS 'f8' TO END  ***
                   MOVE   5  TO LANG-SETNUM
                   MOVE  43  TO LANG-MSGNUM
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE MESSAGE-BUFFER TO POH-MSGLINE
                   MOVE B"1"           TO IND(99), IND(1)
                   GO TO 6-SHOW-FORM.


       63-CHECK-CODED-ITEMS.
           MOVE BUILD-POH-NUMBER TO PO-ARG.
           MOVE PO-ARG TO PORCVNO OF DPOITEMH-I-REC.
           START DPOITEMH-I KEY = PORCVNO OF DPOITEMH-I-REC
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE "FIND DPOITEM-H * 63-CHECK-CODED-ITEM"
                   TO BU-DISPLAY-MSG
               GO TO 3-BLOWUP.

       631-GET-DPOITEMH.
           READ DPOITEMH-I NEXT INTO BUF-DPOITEM-H
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   MOVE "N" TO TRY-000-SW, ADD-TEMP-VEN-SW
                   MOVE SPACES TO ALT-VEN-CODE
      ************ GO TO 64-CHECK-VENDOR-IN-LIVE-DB
                   GO TO 64A-CHECK-REGISTERS
               ELSE
                   MOVE "GET DPOITEM-H * 631-GD" TO BU-DISPLAY-MSG
                   GO TO 3-BLOWUP.
           IF PORCVNO OF DPOITEMH-I-REC NOT = PO-ARG
               MOVE "N" TO TRY-000-SW, ADD-TEMP-VEN-SW
               MOVE SPACES TO ALT-VEN-CODE
      ******** GO TO 64-CHECK-VENDOR-IN-LIVE-DB.
               GO TO 64A-CHECK-REGISTERS.

           IF RUNNING-CSAS
      *********IF ITMH-QTY-DLVR = ITMH-QTY-PAID  *REPLACED 21DEC1992*
               IF (ITMH-QTY-DLVR = ITMH-QTY-PAID)
                 OR (SAVE-POH-NON-RCV-INDIC = "X")
                   NEXT SENTENCE
               ELSE
      *** UNITS PAID DOES NOT EQUAL UNITS RECEIVED FOR ITEM #### ***
                   MOVE  21  TO LANG-SETNUM
                   MOVE  24  TO LANG-MSGNUM
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE MESSAGE-BUFFER TO UNITS-ERROR-MESSAGE
                   MOVE ITMH-NUMBER    TO ITEM-NO-OUT
                   MOVE UNITS-ERROR-MESSAGE TO POH-RECALL-MSG1
                   MOVE SPACES         TO POH-RECALL-MSG2
      ***  ENTER ANOTHER P.O. FOR RECALL OR PRESS 'f8' TO END  ***
                   MOVE   5  TO LANG-SETNUM
                   MOVE  43  TO LANG-MSGNUM
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE MESSAGE-BUFFER TO POH-MSGLINE
                   MOVE B"1"           TO IND(99), IND(1)
                   GO TO 6-SHOW-FORM.

           IF ITMH-CORP-CODE NOT = SPACES
               MOVE ITMH-CORP-CODE TO CODE-ARG
               GO TO 631-CHECK-MSTORERM.

           GO TO 631-GET-DPOITEMH.


       631-CHECK-MSTORERM.
           MOVE CODE-ARG TO CORPCDE OF MSTORERM-I-REC.
           READ MSTORERM-I INTO BUF-MSTORERM
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
      *** CORPORATE CODE ######## DOES NOT EXIST IN LIVE DATABASE ***
                   MOVE   3  TO LANG-SETNUM
                   MOVE 106  TO LANG-MSGNUM
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE MESSAGE-BUFFER TO CORP-CODE-MESSAGE
                   MOVE CODE-ARG       TO CORP-CODE-OUT
                   MOVE CORP-CODE-MESSAGE TO POH-RECALL-MSG1
                   MOVE SPACES         TO POH-RECALL-MSG2
      ***  ENTER ANOTHER P.O. FOR RECALL OR PRESS 'f8' TO END  ***
                   MOVE   5  TO LANG-SETNUM
                   MOVE  43  TO LANG-MSGNUM
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE MESSAGE-BUFFER TO POH-MSGLINE
                   MOVE B"1"           TO IND(99), IND(1)
                   GO TO 6-SHOW-FORM
               ELSE
                   MOVE "GET MSTORERM * 631-CHECK-MSTORERM"
                       TO BU-DISPLAY-MSG
                   GO TO 2-BLOWUP.

           IF (ITMH-QTY-UM = STR-UM OR STR-UM1 OR STR-UM2) AND
              (ITMH-PRICE-UM = STR-UM OR STR-UM1 OR STR-UM2)
               NEXT SENTENCE
           ELSE
      *** UM FOR ITEM #### NO A LONGER A VALID STOREROOM UM FOR CODE #######
               MOVE  21  TO LANG-SETNUM
               MOVE  23  TO LANG-MSGNUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER TO UM-ERROR-MESSAGE
               MOVE ITMH-NUMBER    TO UM-ITEM-OUT
               MOVE CODE-ARG       TO UM-CORP-CODE-OUT
               MOVE UM-ERROR-MESSAGE TO POH-RECALL-MSG1
               MOVE SPACES         TO POH-RECALL-MSG2
      ***  ENTER ANOTHER P.O. FOR RECALL OR PRESS 'f8' TO END  ***
               MOVE   5  TO LANG-SETNUM
               MOVE  43  TO LANG-MSGNUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER TO POH-MSGLINE
               MOVE B"1"           TO IND(99), IND(1)
               GO TO 6-SHOW-FORM.

           GO TO 631-GET-DPOITEMH.

       64A-CHECK-REGISTERS.
           MOVE BUILD-POH-NUMBER TO PO-ARG.
           MOVE PO-ARG TO PORCVNO OF DINVRCDH-REC-I.
           START DINVRCDH-I KEY = PORCVNO OF DINVRCDH-REC-I
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               GO TO 64-CHECK-VENDOR-IN-LIVE-DB.

       641A-GET-DINVRCD.
           READ DINVRCDH-I NEXT INTO BUF-DINVRCD-H
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               GO TO 64-CHECK-VENDOR-IN-LIVE-DB.
           IF PORCVNO OF DINVRCDH-REC-I NOT = PO-ARG
               GO TO 64-CHECK-VENDOR-IN-LIVE-DB.
           MOVE INVH-REG-NO TO REGISTER-ARG.
           MOVE REGISTER-ARG TO REGISTERNO OF DINVRCD-REC-I.
           START DINVRCD-I KEY = REGISTERNO OF DINVRCD-REC-I
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           READ DINVRCD-I NEXT INTO BUF-DINVRCD
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS = "00"
               MOVE SPACES           TO POH-RECALL-MSG1
               STRING "DUPLICATE REGISTER, CANNOT RECALL PO.  REG #"
                       REGISTER-ARG  DELIMITED BY SIZE
                                     INTO  POH-RECALL-MSG1
               MOVE SPACES           TO POH-RECALL-MSG2
      ***  ENTER ANOTHER P.O. FOR RECALL OR PRESS 'f8' TO END  ***
               MOVE   5  TO LANG-SETNUM
               MOVE  43  TO LANG-MSGNUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER TO POH-MSGLINE
               MOVE B"1"             TO IND(99), IND(1)
               GO TO 6-SHOW-FORM.

           GO TO 641A-GET-DINVRCD.

       64-CHECK-VENDOR-IN-LIVE-DB.
           MOVE SAVE-VEN-CODE TO VEN-ARG.
           MOVE VEN-ARG       TO VENCDE OF DVENDOR-I-REC.
           START DVENDOR-I KEY = VENCDE OF DVENDOR-I-REC
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
                   IF S-VEN-1 = "T"
                       MOVE "Y" TO ADD-TEMP-VEN-SW
      ***  TEMPORARY VENDOR DOES NOT EXIST,
      ***   PRESS 'ENTER' TO CONTINUE
                       MOVE  66281 TO CATREAD-MSG-NUMBER
                       PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                       MOVE SPACES TO POH-RECALL-MSG1
                       MOVE SPACES TO POH-RECALL-MSG2
                       MOVE MESSAGE-BUFFER TO POH-MSGLINE
                       MOVE B"1"           TO IND(99)
                       PERFORM 6-SHOW-FORM
                       GO TO 641-READ-FIELDS
                   ELSE
                   IF TRIED-000-VEN OR S-VEN-8-10 = "000"
      ***  VENDOR CODE ########## DOES NOT EXIST IN LIVE DATABASE  ***
                       MOVE  22  TO LANG-SETNUM
                       MOVE  12  TO LANG-MSGNUM
                       PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                       MOVE MESSAGE-BUFFER TO VENDOR-CODE-MESSAGE
                       MOVE SAVE-VEN-CODE  TO VEN-CODE-OUT
                       MOVE VENDOR-CODE-MESSAGE TO POH-RECALL-MSG1
                       MOVE SPACES              TO POH-RECALL-MSG2
      ***  ENTER ANOTHER P.O. FOR RECALL OR PRESS 'f8' TO END  ***
                       MOVE   5  TO LANG-SETNUM
                       MOVE  43  TO LANG-MSGNUM
                       PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                       MOVE MESSAGE-BUFFER TO POH-MSGLINE
                       MOVE B"1"           TO IND(99), IND(1)
                       GO TO 6-SHOW-FORM
                   ELSE
                       MOVE "000" TO S-VEN-8-10
                       MOVE "Y"   TO TRY-000-SW
                       MOVE SAVE-VEN-CODE TO ALT-VEN-CODE
                       GO TO 64-CHECK-VENDOR-IN-LIVE-DB
              ELSE
                   MOVE "FIND DVENDOR * 64-CHECK-VENDOR-IN-LIVE-DB"
                        TO BU-DISPLAY-MSG
                   MOVE VEN-ARG           TO BU-DISPLAY-FLD (1)
                   GO TO 2-BLOWUP.


       641-SERIALLY-READ-DVENDOR.
           READ DVENDOR-I NEXT INTO BUF-DVENDOR
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
      ***  VENDOR NAME DOESN'T EXIST IN LIVE DB,
      ***   PRESS 'ENTER' TO CONTINUE
                   MOVE  22  TO LANG-SETNUM
                   MOVE  13  TO LANG-MSGNUM
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE SPACES TO POH-RECALL-MSG1
                   MOVE SPACES TO POH-RECALL-MSG2
                   MOVE MESSAGE-BUFFER TO POH-MSGLINE
                   MOVE B"1"           TO IND(99)
                   PERFORM 6-SHOW-FORM
                   GO TO 641-READ-FIELDS
               ELSE
                   MOVE "GET DVENDOR * 64-SERIALLY-READ-DVENDOR"
                        TO BU-DISPLAY-MSG
                   MOVE VEN-ARG           TO BU-DISPLAY-FLD (1)
                   GO TO 2-BLOWUP.
           IF VENCDE OF DVENDOR-I-REC NOT = VEN-ARG
      ***  VENDOR NAME DOESN'T EXIST IN LIVE DB,
      ***   PRESS 'ENTER' TO CONTINUE
               MOVE  22  TO LANG-SETNUM
               MOVE  13  TO LANG-MSGNUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE SPACES TO POH-RECALL-MSG1
               MOVE SPACES TO POH-RECALL-MSG2
               MOVE MESSAGE-BUFFER TO POH-MSGLINE
               MOVE B"1" TO IND(99)
               PERFORM 6-SHOW-FORM
               GO TO 641-READ-FIELDS.

               IF VEN-ITM-NO = "00"
                   IF SAVE-VEN-NAME NOT = VEN-ITM-DATA
      ***  VENDOR CODE:  ***
                       MOVE  22  TO LANG-SETNUM
                       MOVE  10  TO LANG-MSGNUM
                       PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                       MOVE MESSAGE-BUFFER TO VENDOR-CODE-LIT
      ***  VENDOR NAME:  ***
                       MOVE  22  TO LANG-SETNUM
                       MOVE  11  TO LANG-MSGNUM
                       PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                       MOVE MESSAGE-BUFFER TO VENDOR-NAME-LIT
                       MOVE SAVE-VEN-CODE TO VENDOR-CODE-OUT
                       MOVE SAVE-VEN-NAME TO VENDOR-NAME-OUT
                       MOVE "HIST DB"     TO DB-LIT
                       MOVE BUILD-POH-MSG TO POH-RECALL-MSG1
                       MOVE VEN-ITM-DATA  TO VENDOR-NAME-OUT
                       MOVE "LIVE DB"     TO DB-LIT
                       MOVE BUILD-POH-MSG TO POH-RECALL-MSG2
      ***  VENDOR NAMES ARE NOT THE SAME, PRESS 'ENTER' TO CONTINUE  ***
                       MOVE  22  TO LANG-SETNUM
                       MOVE   5  TO LANG-MSGNUM
                       PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                       MOVE MESSAGE-BUFFER TO POH-MSGLINE
                       MOVE B"1" TO IND(99)
                       PERFORM 6-SHOW-FORM
                       GO TO 641-READ-FIELDS
                   ELSE
                       GO TO 6-CALL-SPOLIVE
               ELSE
                   GO TO 641-SERIALLY-READ-DVENDOR.

       641-READ-FIELDS.
           IF VIEW-LASTKEY = 0
               IF ADD-TEMP-VEN
                   GO TO 642-LOAD-DVENDOR
               ELSE
                   GO TO 6-CALL-SPOLIVE
           ELSE
           IF VIEW-LASTKEY = 3
               GO TO 6-MAIN-X
           ELSE
      *****    INVALID FUNCTION KEY    *****
               MOVE   9 TO LANG-SETNUM
               MOVE  10 TO LANG-MSGNUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER TO POH-MSGLINE
               MOVE B"1"           TO IND(99)
               GO TO 6-SHOW-FORM.

       642-LOAD-DVENDOR.
           MOVE SPACES                   TO BUF-DVENDOR.
           MOVE VEN-ARG                  TO VEN-VEN-CODE.
           MOVE "00"                     TO VEN-ITM-NO.
           MOVE "LOADED BY PO RECALL"    TO VEN-ITM-DATA.
           WRITE DVENDOR-O-REC FROM BUF-DVENDOR
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE "PUT DVENDOR * 642-LOAD-DVENDOR"
                   TO BU-DISPLAY-MSG
               GO TO 2-BLOWUP.

       6-CALL-SPOLIVE.
           CALL "SPOLIVE" USING BASE, BUILD-PO-NUMBER, COMPANY-SAVE,
                          ALT-VEN-CODE,
                          BASE-STHIST, BUILD-POH-NUMBER, VIEW-COMAREA.

           CALL "SPOHTDL" USING BASE-STHIST, BUILD-POH-NUMBER.

           GO TO 6-PUT-BUFFER.

       6-MAIN-X.
           EXIT.

       COPY DISPCALL IN COPYLIB.
      *********************************************************
       999-CATREAD.
           IF CATREAD-MSG-NUMBER = ZEROS
               MOVE LANG-SETNUM TO CATREAD-MSG-SET
               MOVE LANG-MSGNUM TO CATREAD-MSG-NUM.
           CALL "CCATREAD" USING CATREAD-PARMS.
           MOVE CATREAD-MSG-TEXT TO MESSAGE-BUFFER.

       999-CATREAD-EXIT.
           EXIT.

