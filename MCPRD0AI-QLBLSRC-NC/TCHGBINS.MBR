014800**************************************
014900*                                    *
015000*    NATIVE LANGUAGE SUPPORT AREA    *
015100*                                    *
015200**************************************
015300
015400 COPY LANGUAGE IN COPYLIB.
015500
015700 PROCEDURE DIVISION.
015800 1-HOUSEKEEP SECTION.
           MOVE "C" TO MCXCBLERR-SCOPE.
           CALL "MCXCBLERR" USING MCXCBLERR-SCOPE.
015900
016000*    CALL "DBOPEN" USING BASE, PASSWORD, MODE1, STATUS-AREA.
016100*    IF COND-WORD NOT = 0
016200*        MOVE "DBOPEN ERROR" TO BU-DISPLAY-MSG
016300*        GO TO 2-BLOWUP.
016400*
016500*    CALL INTRINSIC "FINDJCW" USING LANG-JCW-NAME, LANG-JCW-VALUE,
016600*                               LANG-JCW-STATUS.
016700*    IF LANG-JCW-STATUS NOT = 0
016800*        MOVE 1 TO LANG-JCW-VALUE.
016900*
017000*    CALL INTRINSIC "NLAPPEND" USING FORM-GNAME, LANG-JCW-VALUE,
017100*         LANG-ERROR.
017200*    IF LANG-ERROR1 NOT = 0
017300*        MOVE "001" TO FORM-GNAME2.
017400*
017500*    MOVE FORM-GNAME2 TO LANG-ERCAT-FNAME2, LANG-ERCAT-GNAME2.
017600*
017700*    CALL INTRINSIC "CATOPEN" USING LANG-ERCAT, LANG-ERROR,
017800*        GIVING LANG-INDEX.
017900*    IF LANG-ERROR1 NOT = 0
018000*        MOVE "CATOPEN FAILED * TMTSTEXC" TO BU-DISPLAY-MSG
018100*        GO TO 2-BLOWUP.
018200*
018300*    CALL "VOPENFORMF" USING VIEW-COMAREA FORMFILE.
018400*    IF VIEW-STATUS NOT = 0
018500*        MOVE "VOPENFORMF ERR 1-H" TO BU-DISPLAY-MSG
018600*        GO TO 2-BLOWUP.
018700*
018800*    CALL "VOPENTERM" USING VIEW-COMAREA TERMFILENAME.
018900*    IF VIEW-STATUS NOT = 0
019000*        MOVE "VOPENTERM ERR" TO BU-DISPLAY-MSG
019100*        GO TO 2-BLOWUP.
019200*
019300     CALL "SMCHGBIN" USING BASE, VIEW-COMAREA, LANGUAGE-PARMS.
019400
019500 1-EOJ.
019600*    CALL INTRINSIC "CATCLOSE" USING LANG-INDEX, LANG-ERROR.
019700*    CALL "VCLOSETERM" USING VIEW-COMAREA.
019800*    CALL "VCLOSEFORMF" USING VIEW-COMAREA.
019900*    CALL "DBCLOSE" USING BASE, DSET-DUMMY, MODE1,
020000*        STATUS-AREA.
020100     GOBACK.
020200
020300 2-BLOWUP.
020400     MOVE "TCHGBINS"               TO  BU-PGM-NAME.
020500     CALL "TBLOWUP" USING BASE, BU-PGM-NAME, STATUS-AREA,
020600       VIEW-COMAREA, DUMMY-KSAM-STAT, BU-DISPLAY-MSG,
020700       BU-DISPLAY-FLDS.
020800
