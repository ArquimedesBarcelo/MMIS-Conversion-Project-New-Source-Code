       8-ITEM-INQUIRE.
           MOVE USE-HIST-DB-SW TO DATA-BASE-INDIC.
           IF STORES-HISTORY-DB
               MOVE 8003 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER TO HISTORY-DB-LIT.

           IF VIEW-LASTKEY NOT = 4
             IF STORES-DB
               IF REG-INQ
                 PERFORM 79-READ-NEXT-REG
               ELSE
                 IF VEN-INQ
                   PERFORM 79-READ-NEXT-VEN
                 ELSE
                   IF PO-INQ
                     PERFORM 79-READ-NEXT-PO
                   ELSE
                     PERFORM 79-READ-NEXT-INV
                   END-IF
                 END-IF
               END-IF
             ELSE
               IF REG-INQ
                 PERFORM 79-READ-NEXT-HREG
               ELSE
                 IF VEN-INQ
                   PERFORM 79-READ-NEXT-HVEN
                 ELSE
                   IF PO-INQ
                     PERFORM 79-READ-NEXT-HPO
                   ELSE
                     PERFORM 79-READ-NEXT-HINV
                   END-IF
                 END-IF
               END-IF
               IF FILE-STATUS = "10" OR "14" OR "46"
                 MOVE 8 TO VIEW-LASTKEY, SAVE-VIEW-LASTKEY
                 GO TO 8-ITEM-INQUIRE-X
               END-IF
             END-IF
           END-IF.

           MOVE SPACES TO SCREEN-7.
           IF STORES-DB
               MOVE INV-PO-NO        TO  DE7-PO
               MOVE INV-RLSE         TO  DE7-RLSE
               MOVE INV-NO           TO  DE7-INV-NUM
               MOVE INV-REG-NO-9     TO  DE7-REG-NUM,
                                         REGISTER-ARG,
                                         BU-DISPLAY-FLD (1),
                           REGISTERNO OF DINVITM-I-REC
               MOVE INV-PO-RCV-NO    TO  PO-ARG
               MOVE SPACES TO ITEMNO OF DINVITM-I-REC
               START DINVITM-I KEY = REGISTERNO OF DINVITM-I-REC
                INVALID KEY MOVE FILE-STATUS TO FILE-STATUS
               END-START
           ELSE
               MOVE HISTORY-DB-LIT   TO  DE7-HISTORY-LIT
               MOVE INVH-PO-NO       TO  DE7-PO
               MOVE INVH-RLSE        TO  DE7-RLSE
               MOVE INVH-NO          TO  DE7-INV-NUM
               MOVE INVH-REG-NO-9    TO  DE7-REG-NUM,
                                         REGISTER-ARG,
                                         BU-DISPLAY-FLD (1),
                              REGISTERNO OF DINVITMH-I-REC
               MOVE INVH-PO-RCV-NO   TO  PO-ARG
               MOVE SPACES TO INVITEMNO OF DINVITMH-I-REC
               START DINVITMH-I KEY = REGISTERNO OF DINVITMH-I-REC
                 INVALID KEY MOVE FILE-STATUS TO FILE-STATUS
               END-START.

           IF FILE-STATUS NOT EQUAL "00"
               IF FILE-STATUS-1 = "2"
      *        *** NO ITEMS WERE FOUND ON THIS INVOICE ***
                   MOVE 14014 TO CATREAD-MSG-NUMBER
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE MESSAGE-BUFFER TO   DE7-MSGLINE
                   MOVE B"1"           TO   IND(99)
                   GO TO 8C-SHOW-ITEM-SCREEN
               ELSE
                   MOVE "START DINVITM*8-II" TO BU-DISPLAY-MSG
                   GO TO 2-BLOWUP.

           MOVE SPACES          TO  MESSAGE-BUFFER.
           MOVE ZEROS           TO  VIEW-LASTKEY.
           MOVE "Y"             TO  READ-NEXT-SW.

       8-GET-DINVITM-LOOP.
           IF STORES-DB
             IF READ-NEXT
               PERFORM 89-READ-NEXT-ITEM
             ELSE
               PERFORM 89-READ-PRIOR-ITEM
             END-IF
           ELSE
             IF READ-NEXT
               PERFORM 89-READ-NEXT-HITEM
             ELSE
               PERFORM 89-READ-PRIOR-HITEM
             END-IF
             IF FILE-STATUS = "10" OR "14" OR "46"
               IF READ-ERR-SW = SPACES
                 IF READ-NEXT
                   MOVE "N" TO READ-NEXT-SW, READ-ERR-SW
                   GO TO 8-GET-DINVITM-LOOP
                 ELSE
                   MOVE "Y" TO READ-NEXT-SW
                   MOVE "P" TO READ-ERR-SW
                   GO TO 8-GET-DINVITM-LOOP
                 END-IF
               ELSE
                 MOVE 8 TO VIEW-LASTKEY, SAVE-VIEW-LASTKEY
                 GO TO 8-ITEM-INQUIRE-X
               END-IF
             END-IF
           END-IF.

           IF STORES-DB
             MOVE INVITM-ITEM-NO TO SAVE-INV-ITEM-NO
           ELSE
             IF INVITMH-PO-NUM NOT = INVH-PO-RLSE
               IF VIEW-LASTKEY = 6
                 MOVE "N" TO READ-NEXT-SW
               ELSE
                 MOVE "Y" TO READ-NEXT-SW
               END-IF
               GO TO 8-GET-DINVITM-LOOP
             ELSE
               MOVE INVITMH-ITEM-NO TO SAVE-INV-ITEM-NO
             END-IF
           END-IF.

           IF ITEM-INQ-NUM = SPACES
               NEXT SENTENCE
           ELSE
           IF ITEM-INQ-NUM = SAVE-INV-ITEM-NO
               MOVE SPACES TO ITEM-INQ-NUM
           ELSE
           IF ITEM-INQ-NUM < SAVE-INV-ITEM-NO
      *    *** ITEM NUMBER (    ) DOES NOT EXIST ON THIS INVOICE ***
               MOVE 9003 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER TO ITEM-NOT-FOUND-MSG
               MOVE SPACES TO MESSAGE-BUFFER
               MOVE ITEM-INQ-NUM TO NO-ITEM-OUT
               MOVE SPACES TO ITEM-INQ-NUM
               MOVE ITEM-NOT-FOUND-MSG TO MESSAGE-BUFFER
               GO TO 8-GET-DINVITM-LOOP
           ELSE
               MOVE "Y" TO READ-NEXT-SW
               GO TO 8-GET-DINVITM-LOOP.

           MOVE SPACES TO DE7-ITEM-INFORMATION.
           IF STORES-DB
               PERFORM 80-LOAD-ITEM-INFO THRU 80-LII-X
           ELSE
               PERFORM 81-LOAD-ITEM-INFO-HIST THRU 81-LIIH-X.

       8-FIND-DINVACCT.
           IF STORES-DB
             MOVE REGISTER-ARG TO REGISTERNO OF DINVACCT-I-REC
             START DINVACCT-I KEY = REGISTERNO OF DINVACCT-I-REC
                 INVALID KEY MOVE FILE-STATUS TO FILE-STATUS
             END-START
           ELSE
             MOVE REGISTER-ARG TO REGISTERNO OF DINVACCTH-I-REC
             START DINVACCTH-I KEY = REGISTERNO OF DINVACCTH-I-REC
                 INVALID KEY MOVE FILE-STATUS TO FILE-STATUS
             END-START
           END-IF.
           IF FILE-STATUS NOT = "00"
               MOVE "START DINVACCT*8-FD"  TO  BU-DISPLAY-MSG
               GO TO  2-BLOWUP.

           MOVE ZERO  TO  ACCT-SUB.

       8-GET-DINVACCT-LOOP.
           IF STORES-DB
               READ DINVACCT-I NEXT INTO BUF-DINVACCT
                   AT END MOVE FILE-STATUS TO FILE-STATUS
           ELSE
               READ DINVACCTH-I NEXT INTO BUF-DINVACCT-H
                   AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   GO TO 8-TYPE-OF-CODE
               ELSE
                   MOVE "READN DINVACCT?*8-GDL"  TO  BU-DISPLAY-MSG
                   GO TO  2-BLOWUP.
           IF STORES-DB
               IF REGISTERNO OF DINVACCT-I-REC NOT = REGISTER-ARG
                   GO TO 8-TYPE-OF-CODE
               ELSE
                   NEXT SENTENCE
           ELSE
               IF REGISTERNO OF DINVACCTH-I-REC NOT = REGISTER-ARG
                   GO TO 8-TYPE-OF-CODE.

           IF STORES-DB
             MOVE INVACCT-ITEM TO SAVE-INVACCT-ITEM-NO
           ELSE
             IF INVACCTH-PO-NUM NOT = INVH-PO-RLSE
               GO TO 8-GET-DINVACCT-LOOP
             ELSE
               MOVE INVACCTH-ITEM TO SAVE-INVACCT-ITEM-NO
             END-IF
           END-IF.

           IF SAVE-INV-ITEM-NO = SAVE-INVACCT-ITEM-NO
               NEXT SENTENCE
           ELSE
           IF SAVE-INV-ITEM-NO < SAVE-INVACCT-ITEM-NO
               GO TO 8-TYPE-OF-CODE
           ELSE
               GO TO  8-GET-DINVACCT-LOOP.

           IF STORES-DB
               PERFORM 80-LOAD-ITEM-ACCT-DATA  THRU  80-LIAD-X
           ELSE
               PERFORM 81-LOAD-ITEM-ACCT-DATA-HIST  THRU  81-LIADH-X.
           GO TO  8-GET-DINVACCT-LOOP.

       8-TYPE-OF-CODE.
           IF DE7-CORPCODE  = "NON-STR"
               IF STORES-DB
                   PERFORM 80-LOAD-NONCODED-DESC  THRU  80-LND-X
               ELSE
                   PERFORM 81-LOAD-NONCODED-DESC-HIST THRU 81-LNDH-X
           ELSE
               PERFORM 80-LOAD-CODED-DESC  THRU   80-LCD-X.

       8C-SHOW-ITEM-SCREEN.
           MOVE "INVINQ7"    TO  VIEW-NFNAME.
           IF ( IREAD-NEXT-VALID AND IREAD-PRIOR-VALID ) OR
                STORES-HISTORY-DB

      *
      * PRESS 'f6' TO REVIEW PRIOR ITEM; 'f7' TO REVIEW NEXT ITEM      ***
      *
               MOVE 16102 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER TO DE7-INSTLINE
           ELSE
           IF IREAD-PRIOR-VALID

      *
      * PRESS 'f6' TO REVIEW PRIOR ITEM                                ***
      *
               MOVE 16104 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER TO DE7-INSTLINE

           ELSE
           IF IREAD-NEXT-VALID

      *
      * PRESS 'f7' TO REVIEW NEXT ITEM                                 ***
      *
               MOVE 16103 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER TO DE7-INSTLINE
             ELSE
               MOVE SPACES TO DE7-INSTLINE.

           IF STORES-HISTORY-DB
             IF READ-NEXT-ERR

      *
      * NO MORE ITEMS TO REVIEW
      *
               MOVE 66219 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER TO DE7-MSGLINE
               MOVE B"1" TO IND(99)
               MOVE SPACES TO READ-ERR-SW
             ELSE
               IF READ-PRIOR-ERR

      *
      * NO PRIOR ITEMS TO REVIEW
      *
                 MOVE 66220 TO CATREAD-MSG-NUMBER
                 PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                 MOVE MESSAGE-BUFFER TO DE7-MSGLINE
                 MOVE B"1" TO IND(99)
                 MOVE SPACES TO READ-ERR-SW.

           MOVE SCREEN-7     TO  DISPLAY-REC.
           PERFORM 998-WRITE-SCREEN THRU 998-READ-SCREEN.
           MOVE DISPLAY-REC  TO  SCREEN-7.
           IF VIEW-LASTKEY = 3 OR 4
               GO TO 8-ITEM-INQUIRE-X
           ELSE
           IF VIEW-LASTKEY = 6
               IF IREAD-PRIOR-VALID
                   MOVE "N" TO READ-NEXT-SW
                   GO TO 8-GET-DINVITM-LOOP
               ELSE
      *        *** INVALID FUNCTION KEY ENTERED ***
                   MOVE 9010 TO CATREAD-MSG-NUMBER
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE MESSAGE-BUFFER TO   DE7-MSGLINE
                   MOVE B"1" TO IND(99)
                   GO TO 8C-SHOW-ITEM-SCREEN
           ELSE
           IF VIEW-LASTKEY = 7
               IF IREAD-NEXT-VALID
                   MOVE "Y" TO READ-NEXT-SW
                   GO TO 8-GET-DINVITM-LOOP
               ELSE
      *        *** INVALID FUNCTION KEY ENTERED ***
                   MOVE 9010 TO CATREAD-MSG-NUMBER
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE MESSAGE-BUFFER TO   DE7-MSGLINE
                   MOVE B"1" TO IND(99)
                   GO TO 8C-SHOW-ITEM-SCREEN
           ELSE
           IF VIEW-LASTKEY = 1  OR
              VIEW-LASTKEY = 2  OR
              VIEW-LASTKEY = 5  OR
              VIEW-LASTKEY = 8
      *        *** INVALID FUNCTION KEY ENTERED ***
               MOVE 9010 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER TO   DE7-MSGLINE
               MOVE B"1" TO IND(99)
               GO TO 8C-SHOW-ITEM-SCREEN
           ELSE
      *        ***  SELECT THE APPROPRIATE  'FUNCTION KEY'  ***
               MOVE 19013 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER TO   DE7-MSGLINE
               MOVE B"1" TO IND(99)
               GO TO 8C-SHOW-ITEM-SCREEN.

       8-ITEM-INQUIRE-X.
           EXIT.

       80-LOAD-ITEM-INFO.
           MOVE INVITM-ITEM-NO       TO  DE7-ITEM-NO.
           MOVE INVITM-CORPCODE      TO  DE7-CORPCODE,
                                         CODE-ARG.
           MOVE INVITM-PO-QTY-PD     TO  DE7-PO-UNPD-QTY.
           MOVE INVITM-PO-UM         TO  DE7-PO-UM,
                                         DE7-INV-UM.
           MOVE INVITM-PO-UPRICE     TO  DE7-PO-UPRICE.
           IF INVITM-PO-QTY-PD = ZEROS
               MOVE INVITM-PO-UPRICE TO  DE7-PO-ITEM-EXT
           ELSE
               MULTIPLY INVITM-PO-QTY-PD  BY  INVITM-PO-UPRICE
                   GIVING CALC-ITEM-EXT  ROUNDED
               MOVE CALC-ITEM-EXT     TO  DE7-PO-ITEM-EXT.
           MOVE INVITM-INV-QTY-PD     TO  DE7-INV-UNPD-QTY.
           MOVE INVITM-INV-UPRICE     TO  DE7-INV-UPRICE.
           IF INVITM-INV-QTY-PD = ZEROS
               MOVE INVITM-INV-UPRICE  TO  DE7-INV-ITEM-EXT
           ELSE
               MULTIPLY INVITM-INV-QTY-PD  BY  INVITM-INV-UPRICE
                   GIVING CALC-ITEM-EXT ROUNDED
               MOVE CALC-ITEM-EXT      TO  DE7-INV-ITEM-EXT.
           MOVE INVITM-TAX-CODE        TO  DE7-TAX-CODE.
           IF INVITM-MEMO-INDIC = "X"
      *        *** MEMO QUANTITY  (QTY PAID NOT UPDATE) ***
               MOVE 13034 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER TO DE7-INV-MEMO-MSG
               MOVE SPACES TO MESSAGE-BUFFER.

       80-LII-X.
           EXIT.

       80-LOAD-ITEM-ACCT-DATA.
           ADD +1  TO  ACCT-SUB.
           MOVE INVACCT-PRIME      TO  DE7-PRIME (ACCT-SUB).
           MOVE INVACCT-SUB        TO  DE7-SUB (ACCT-SUB).
           MOVE INVACCT-SUBD       TO  DE7-SUBD (ACCT-SUB).
           MOVE INVACCT-ADDL-DATA  TO  DE7-ADDL-DATA (ACCT-SUB).
           MOVE INVACCT-PCT        TO  DE7-PERCENT (ACCT-SUB).

       80-LIAD-X.
           EXIT.

       80-LOAD-NONCODED-DESC.
           MOVE 4                       TO  CNDESC-LINES-TO-GET.
           MOVE 0                       TO  CNDESC-LINES-GOT.
           CALL "CNDESC" USING BASE, PO-ARG, INVITM-ITEM-NO,
               CNDESC-DATA.

           IF CNDESC-LINES-GOT  =  0
      *        *** NO DESCRIPTION ON FILE ***
               MOVE 14003 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER TO DE7-DESC-LINE (1)
               GO TO  80-LND-X.

           MOVE ZEROS                   TO  DESC-SUB.

       80-GET-NONCODED-LOOP.
           ADD 1                        TO  DESC-SUB.
           IF DESC-SUB > CNDESC-LINES-GOT  OR
              DESC-SUB > 4
               GO TO 80-LND-X.

           MOVE CNDESC (DESC-SUB)       TO  DE7-DESC-LINE (DESC-SUB).
           GO TO 80-GET-NONCODED-LOOP.

       80-LND-X.
           EXIT.

       80-LOAD-CODED-DESC.
      **************************************************
      **  CALL CDESC FOR DESCRIPTION LINES. (CODED)   **
      **************************************************
           MOVE 4                       TO  CDESC-LINES-TO-GET.
           CALL "CDESC" USING RET-CODE,
                              BASE,
                              STATUS-AREA,
                              BU-DISPLAY-MSG,
                              CODE-ARG,
                              CDESC-DATA.
           IF BU-DISPLAY-MSG-1  NOT = SPACES
               MOVE CODE-ARG            TO  BU-DISPLAY-FLD (4)
               GO TO 2-BLOWUP.

           IF CDESC-LINES-GOT  =  0
      *        *** NO DESCRIPTION ON FILE ***
               MOVE 14003 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER TO DE7-DESC-LINE (1)
               GO TO  80-LCD-X.

           MOVE ZEROS                   TO  DESC-SUB.

       80-GET-DESC-LOOP.
           ADD 1                        TO  DESC-SUB.
           IF DESC-SUB > CDESC-LINES-GOT  OR
              DESC-SUB > 4
               GO TO 80-LCD-X.

           MOVE CDESC (DESC-SUB)        TO  DE7-DESC-LINE (DESC-SUB).
           GO TO 80-GET-DESC-LOOP.

       80-LCD-X.
           EXIT.

       81-LOAD-ITEM-INFO-HIST.
           MOVE INVITMH-ITEM-NO       TO  DE7-ITEM-NO.
           MOVE INVITMH-CORPCODE      TO  DE7-CORPCODE,
                                          CODE-ARG.
           MOVE INVITMH-PO-QTY-PD     TO  DE7-PO-UNPD-QTY.
           MOVE INVITMH-PO-UM         TO  DE7-PO-UM,
                                          DE7-INV-UM.
           MOVE INVITMH-PO-UPRICE     TO  DE7-PO-UPRICE.
           IF INVITMH-PO-QTY-PD = ZEROS
               MOVE INVITMH-PO-UPRICE TO  DE7-PO-ITEM-EXT
           ELSE
               MULTIPLY INVITMH-PO-QTY-PD  BY  INVITMH-PO-UPRICE
                   GIVING CALC-ITEM-EXT  ROUNDED
               MOVE CALC-ITEM-EXT     TO  DE7-PO-ITEM-EXT.
           MOVE INVITMH-INV-QTY-PD    TO  DE7-INV-UNPD-QTY.
           MOVE INVITMH-INV-UPRICE    TO  DE7-INV-UPRICE.
           IF INVITMH-INV-QTY-PD = ZEROS
               MOVE INVITMH-INV-UPRICE  TO  DE7-INV-ITEM-EXT
           ELSE
               MULTIPLY INVITMH-INV-QTY-PD  BY  INVITMH-INV-UPRICE
                   GIVING CALC-ITEM-EXT ROUNDED
               MOVE CALC-ITEM-EXT      TO  DE7-INV-ITEM-EXT.
           MOVE INVITMH-TAX-CODE       TO  DE7-TAX-CODE.
           IF INVITMH-MEMO-INDIC = "X"
      *        *** MEMO QUANTITY  (QTY PAID NOT UPDATE) ***
               MOVE 13034 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER TO DE7-INV-MEMO-MSG
               MOVE SPACES TO MESSAGE-BUFFER.

       81-LIIH-X.
           EXIT.

       81-LOAD-ITEM-ACCT-DATA-HIST.
           ADD +1  TO  ACCT-SUB.
           MOVE INVACCTH-PRIME      TO  DE7-PRIME (ACCT-SUB).
           MOVE INVACCTH-SUB        TO  DE7-SUB (ACCT-SUB).
           MOVE INVACCTH-SUBD       TO  DE7-SUBD (ACCT-SUB).
           MOVE INVACCTH-ADDL-DATA  TO  DE7-ADDL-DATA (ACCT-SUB).
           MOVE INVACCTH-PCT        TO  DE7-PERCENT (ACCT-SUB).

       81-LIADH-X.
           EXIT.

       81-LOAD-NONCODED-DESC-HIST.
           MOVE ZEROS  TO  DESC-SUB.
           MOVE PO-ARG TO  PORCVNO OF DPODESCH-I-REC.
           MOVE SAVE-POITEMSEQ TO POITEMSEQ OF DPODESCH-I-REC.
           START DPODESCH-I KEY = EXTERNALLY-DESCRIBED-KEY
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
                   GO TO 81-LNDH-X
               ELSE
               MOVE "START DPODESC*81-LNDH"  TO  BU-DISPLAY-MSG
               MOVE PO-ARG     TO  BU-DISPLAY-FLD (2)
               GO TO  2-BLOWUP.

       81-GET-NCODED-ITEM-LOOP.
           READ DPODESCH-I NEXT INTO BUF-DPODESC-H
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   GO TO 81-LNDH-X
               ELSE
                   MOVE "READN DPODESC*81-GNIL"  TO  BU-DISPLAY-MSG
                   GO TO  2-BLOWUP.
           IF PORCVNO OF DPODESCH-I-REC NOT = PO-ARG
             OR SAVE-INV-ITEM-NO NOT = DPODESCH-ITEM-NO
               GO TO 81-LNDH-X.

           ADD +1  TO  DESC-SUB.
           IF DESC-SUB > +4
               GO TO  81-LNDH-X.

           MOVE PODESCH-DESC  TO  DE7-DESC-LINE (DESC-SUB).
           GO TO 81-GET-NCODED-ITEM-LOOP.

       81-LNDH-X.
           EXIT.

       89-READ-NEXT-ITEM.
           READ DINVITM-I NEXT
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   NEXT SENTENCE
               ELSE
                   MOVE "READN DINVITM-I-REG*89-READ-NEXT-ITEM"
                       TO BU-DISPLAY-MSG
                   MOVE REGISTER-ARG      TO BU-DISPLAY-FLD (1)
                   GO TO 2-BLOWUP.
           IF REGISTERNO OF DINVITM-I-REC NOT = REGISTER-ARG
               MOVE "10" TO FILE-STATUS.

           IF FILE-STATUS = "00"
               MOVE IREAD-NEXT-VALID-SW TO IREAD-PRIOR-VALID-SW
               READ DINVITM-I NEXT
                   AT END MOVE FILE-STATUS TO FILE-STATUS
               END-READ
               IF FILE-STATUS EQUAL "00" AND
                  REGISTERNO OF DINVITM-I-REC EQUAL REGISTER-ARG
                 SET IREAD-NEXT-VALID TO TRUE
               ELSE
                 SET IREAD-NEXT-NOT-VALID TO TRUE
               END-IF
               IF FILE-STATUS EQUAL "10"
                 READ DINVITM-I LAST INTO BUF-DINVITM
                   AT END MOVE FILE-STATUS TO FILE-STATUS
                 END-READ
               ELSE
                 READ DINVITM-I PRIOR INTO BUF-DINVITM
                   AT END MOVE FILE-STATUS TO FILE-STATUS
                 END-READ
               END-IF
               IF FILE-STATUS NOT = "00" OR
                  INVITM-REG-NO NOT EQUAL REGISTER-ARG
                 MOVE "10" TO FILE-STATUS
               END-IF
           END-IF.

       89-READ-PRIOR-ITEM.
           READ DINVITM-I PRIOR
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   NEXT SENTENCE
               ELSE
                   MOVE "READP DINVITM-I-REG*89-READ-PRIOR-ITEM"
                       TO BU-DISPLAY-MSG
                   MOVE REGISTER-ARG      TO BU-DISPLAY-FLD (1)
                   GO TO 2-BLOWUP.
           IF REGISTERNO OF DINVITM-I-REC NOT = REGISTER-ARG
               MOVE "10" TO FILE-STATUS.

           IF FILE-STATUS = "00"
               SET IREAD-NEXT-VALID TO TRUE
               READ DINVITM-I PRIOR
                   AT END MOVE FILE-STATUS TO FILE-STATUS
               END-READ
               IF FILE-STATUS EQUAL "00" AND
                  REGISTERNO OF DINVITM-I-REC EQUAL REGISTER-ARG
                 SET IREAD-PRIOR-VALID TO TRUE
               ELSE
                 SET IREAD-PRIOR-NOT-VALID TO TRUE
                 IF FILE-STATUS NOT EQUAL "00"
                   MOVE REGISTER-ARG TO REGISTERNO OF DINVITM-I-REC
                   START DINVITM-I KEY >=
                     REGISTERNO OF DINVITM-I-REC
                    INVALID KEY MOVE FILE-STATUS TO FILE-STATUS
                   END-START
                 END-IF
               END-IF
               READ DINVITM-I NEXT INTO BUF-DINVITM
                   AT END MOVE FILE-STATUS TO FILE-STATUS
               END-READ
               IF FILE-STATUS NOT = "00" OR
                  INVITM-REG-NO NOT EQUAL REGISTER-ARG
                   MOVE "10" TO FILE-STATUS
               END-IF
           END-IF.

       89-READ-NEXT-HITEM.
           READ DINVITMH-I NEXT INTO BUF-DINVITM-H
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   NEXT SENTENCE
               ELSE
                   MOVE "READN DINVITMH-I-REG*89-READ-NEXT-HITEM"
                       TO BU-DISPLAY-MSG
                   MOVE REGISTER-ARG      TO BU-DISPLAY-FLD (1)
                   GO TO 2-BLOWUP.
           IF REGISTERNO OF DINVITMH-I-REC NOT = REGISTER-ARG
               MOVE "10" TO FILE-STATUS.

       89-READ-PRIOR-HITEM.
           READ DINVITMH-I PRIOR INTO BUF-DINVITM-H
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   NEXT SENTENCE
               ELSE
                   MOVE "READN DINVITMH-I-REG*89-READ-PRIOR-HITEM"
                       TO BU-DISPLAY-MSG
                   MOVE REGISTER-ARG      TO BU-DISPLAY-FLD (1)
                   GO TO 2-BLOWUP.
           IF REGISTERNO OF DINVITMH-I-REC NOT = REGISTER-ARG
               MOVE "10" TO FILE-STATUS.

       COPY DISPCALL IN COPYLIB.

      *------ THIS VERSION OF CATREAD ASSUMES THE SET/MSG NUMBER
      *------ WILL BE IN CATREAD-MSG-NUMBER.
       999-CATREAD.
           CALL "CCATREAD" USING CATREAD-PARMS.
           MOVE CATREAD-MSG-TEXT TO MESSAGE-BUFFER.
           IF MESSAGE-BUFFER-1  = SPACES
               MOVE "* ERROR ON THIS FIELD *" TO MESSAGE-BUFFER.
       999-CATREAD-EXIT.
           EXIT.
