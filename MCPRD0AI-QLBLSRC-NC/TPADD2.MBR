000200 IDENTIFICATION DIVISION.
000300 PROGRAM-ID.    TPADD2.
000400 INSTALLATION.  GOODYEAR.
000500*REMARKS.
000600*       #########################################################
000700*       # This is the personnel absence information add program #
000800*       # ----------------------------------------------------- #
000900*       #########################################################.
      *C
      *C 09/09/96  JEFF BUNGO
      *C   EXPAND DATE FIELDS FOR YEAR 2000 COMPLIANCE.
      *C   INCLUDE CENTURY ON ABSENSE DATE.
      *C
001100 ENVIRONMENT DIVISION.
001200 CONFIGURATION SECTION.
001300 SOURCE-COMPUTER.      AS400.
001400 OBJECT-COMPUTER.      AS400.
       SPECIAL-NAMES.      I-O-FEEDBACK IS I-O-FEEDBACK-AREA
                           LOCAL-DATA IS LOCAL-DATA-AREA.
001000 INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT DISPLAY-FILE
               ASSIGN TO WORKSTATION-ZPERSON-SI
               ORGANIZATION IS TRANSACTION
               ACCESS IS SEQUENTIAL
               FILE STATUS IS DSPLY-STATUS
               CONTROL-AREA IS WS-CONTROL.
           SELECT PER-ABS-DATA-FILE
               ASSIGN TO DATABASE-MCFLMM3102
               ORGANIZATION IS INDEXED
               ACCESS IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY WITH DUPLICATES
               FILE STATUS IS PADF-STATUS.
           SELECT PERSONNEL-FILE
               ASSIGN TO DATABASE-MCFLMM0301
               ORGANIZATION IS INDEXED
               ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
               FILE STATUS IS PF-STATUS.
001500 DATA DIVISION.
       FILE SECTION.
       FD  DISPLAY-FILE
           LABEL RECORDS ARE OMITTED.
       01  DSPLY-REC                     PIC X(2000).
       FD  PER-ABS-DATA-FILE
           LABEL RECORDS ARE STANDARD
           DATA RECORD IS PADFREC.
       01  PADFREC.
           COPY DDS-ALL-FORMATS OF MCFLMM3102.
       FD  PERSONNEL-FILE
           LABEL RECORDS ARE STANDARD
           DATA RECORD IS PFREC.
       01  PFREC.
           COPY DDS-ALL-FORMATS OF MCFLMM0301.
001600 WORKING-STORAGE SECTION.
       COPY CATREAD OF COPYLIB.
       COPY CPYIND  OF COPYLIB.
004100 01  CS                            PIC S9(4) COMP-4.
004300 COPY TDATESUB OF COPYLIB.
003100 01  DATE-HEAD                     PIC X(10).
003200 01  ERROR-SW                      PIC X.
003800 01  ERROR-BUFFER                  PIC X(80) VALUE SPACES.
       01  FILE-STATUSES.
           05  DSPLY-STATUS              PIC XX.
           05  PADF-STATUS               PIC XX.
           05  PF-STATUS                 PIC XX.
       COPY IOFEEDBACK OF COPYLIB.
001800 01  PASSWORD-INFORMATION.
001900     05  NAME-OF-PROGRAM     PIC X(08) VALUE "TPADD2  ".
002000     05  PROGRAM-TYPE        PIC X(02) VALUE "MA".
002100     05  PROGRAM-RELEASE     PIC X(12) VALUE " E0100010001".
002200     05  PROGRAM-DESCRIPTION.
002300         10  PROG-DESC-A     PIC X(60) VALUE
002400             "PERSONNEL ABSENCE INFORMATION ADD PROGRAM "        .
002500         10  PROG-DESC-B     PIC X(60) VALUE SPACES.
002700         10  PROG-FUNCTION   PIC X(60) VALUE SPACES.
002900     05  PASSWORD-FLAG       PIC X.
004400 01  PER-ABSENCE-DATA.            COPY DPERABS  OF COPYLIB.

003600 01  SAVE-KEY                      PIC S9(4) COMP-4.
004200 COPY DBSTAT  OF COPYLIB.
004000 01  SUB1                          PIC S9(4) COMP-4.
004500 01  TERM-BUFFER.
004600     05 T-CC                       PIC X(4).
004700     05 T-YR                       PIC XX.
004800     05 T-PAGE                     PIC 9.
004900     05 T-TITLE                    PIC X(78).
005000     05 T-ABSENCE.
005100        10 T-ABSREC OCCURS 50 TIMES.
005200           15 TREC.
005300              20 TR-CODE           PIC X(2).
005400              20 TR-DATE           PIC X(6).
005500              20 TR-HOUR           PIC X(2).
005600              20 TR-HOUR-NUM REDEFINES TR-HOUR
005700                                   PIC 99.
           05  TERM-CMD-LINE             PIC X(79).
           05  TERM-ERR-LINE             PIC X(79).
005800
005900 01  SCREEN-TABLES.
006000     05 TABLES OCCURS 3 TIMES.
006100         10 TABL.
006200            15 TAB OCCURS 50 TIMES.
006300               20 TCODE            PIC X(2).
                     20 TDATE            PIC X(6).
                     20 THRS             PIC X(2).
006400
       01  TRUE-VAL                      PIC 1 VALUE B"1".
       COPY WSCONTROL OF COPYLIB.
006500 LINKAGE SECTION.
006600 01  DBPARAMETERS.                COPY DBPARMS  OF COPYLIB.
006700 COPY VCOMLINK OF COPYLIB.
006800 01  PLT-IDT                       PIC X(4).
007000 01  PER-PERSONNEL.               COPY MPERSONL OF COPYLIB.
007100
007200 PROCEDURE DIVISION USING DBPARAMETERS
007300                          VIEW-COMAREA
007400                          PLT-IDT
007600                          PER-PERSONNEL.
       START-PGM.
           PERFORM 1-HSK.
           PERFORM 6-MAIN UNTIL VIEW-LASTKEY = 3.
       2-EOJ.
           CLOSE DISPLAY-FILE.
           CLOSE PER-ABS-DATA-FILE.
           CLOSE PERSONNEL-FILE.
           GOBACK.
008600 1-HSK.
           OPEN I-O   DISPLAY-FILE.
           OPEN I-O   PER-ABS-DATA-FILE.
           OPEN I-O   PERSONNEL-FILE.
008700     MOVE SPACES TO ERROR-BUFFER.
007900     CALL "TPWORD" USING PASSWORD-INFORMATION.
008300     IF PASSWORD-FLAG = "N" GO TO 2-EOJ.
009300     MOVE SPACES TO TERM-BUFFER.
       6-MAIN.
008800     MOVE "FPADD2" TO VIEW-CFNAME.
           IF INDS (99) = TRUE-VAL
               MOVE ERROR-BUFFER TO TERM-ERR-LINE.
009400     MOVE PER-CC-NUM TO T-CC.
009500     MOVE 1 TO T-PAGE.
009600     MOVE 31025 TO CATREAD-MSG-NUMBER.
009800     PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
009900     MOVE ERROR-BUFFER TO T-TITLE.
           MOVE TERM-BUFFER TO DSPLY-REC.
           PERFORM 99-SCREEN-WRITE.
           PERFORM 98-SCREEN-READ.
           MOVE DSPLY-REC TO TERM-BUFFER.
012500     IF VIEW-LASTKEY = 3 GO TO 2-EOJ.
012600     IF VIEW-LASTKEY NOT = 0 GO TO 6-MAIN.
014700     IF T-YR = PER-YEAR1 OR PER-YEAR2 OR PER-YEAR3
014800         MOVE 51001 TO CATREAD-MSG-NUMBER
015000         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE TRUE-VAL TO INDS (99)
015600         GO TO 6-MAIN.
010900     PERFORM 60-SHOW1.
011000     PERFORM 61-READ-SCREEN1.
015700 60-SHOW1.
015800     MOVE 1 TO CS.
015900     MOVE SPACES TO SCREEN-TABLES.
016000     IF DATE-FLAG = 1
016100         MOVE 29084 TO CATREAD-MSG-NUMBER
016300         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
016400         MOVE ERROR-BUFFER TO DATE-HEAD
016500         STRING DATE-HEAD "       "
016600                DATE-HEAD "       "
016700                DATE-HEAD "       "
016800                DATE-HEAD "       "
016900                DATE-HEAD "       "
017000         DELIMITED BY SIZE INTO T-TITLE
017100     ELSE
017200     MOVE 29085 TO CATREAD-MSG-NUMBER
017400     PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
017500     MOVE ERROR-BUFFER TO DATE-HEAD
017600     STRING DATE-HEAD "       "
017700            DATE-HEAD "       "
017800            DATE-HEAD "       "
017900            DATE-HEAD "       "
018000            DATE-HEAD "       "
018100     DELIMITED BY SIZE INTO T-TITLE.
018200     MOVE DATE-FLAG TO DATE-CODE.
           MOVE 66185 TO CATREAD-MSG-NUMBER.
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
           MOVE ERROR-BUFFER TO TERM-CMD-LINE.
           MOVE SPACES TO ERROR-BUFFER.
018400     MOVE "FPADD2A" TO VIEW-CFNAME.
           MOVE TERM-BUFFER TO DSPLY-REC.
           PERFORM 99-SCREEN-WRITE.
019400 61-READ-SCREEN1.
019500     PERFORM 98-SCREEN-READ.
           MOVE DSPLY-REC TO TERM-BUFFER.
           MOVE T-ABSENCE TO TABL (CS).
020600     MOVE VIEW-LASTKEY TO SAVE-KEY.
021100     IF SAVE-KEY = 7
021200         IF SCREEN-TABLES = SPACES
021300             GO TO 2-EOJ
021400         ELSE
021500         PERFORM 600-ADD-ABSENCE
021600         GO TO 2-EOJ.
021700
021800     IF SAVE-KEY = 3 GO TO 2-EOJ.
021900
022000     IF SAVE-KEY = 1 OR 2 OR 4 OR 5
022100         NEXT SENTENCE
022200     ELSE
           MOVE 35126 TO CATREAD-MSG-NUMBER
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
           MOVE ERROR-BUFFER TO TERM-ERR-LINE
           MOVE TRUE-VAL TO INDS (99)
022400     GO TO 61-READ-SCREEN1.
022500
022600     IF SAVE-KEY = 1
022700         ADD 1 TO CS
022800         IF CS > 3
022900             SUBTRACT 1 FROM CS
023100             GO TO 61-READ-SCREEN1
023200         ELSE
023300         MOVE TABL (CS) TO T-ABSENCE
023400         MOVE CS TO T-PAGE
               MOVE TERM-BUFFER TO DSPLY-REC
               PERFORM 99-SCREEN-WRITE
023800         GO TO 61-READ-SCREEN1.
023900     IF SAVE-KEY = 2
024000         SUBTRACT 1 FROM CS
024100         IF CS < 1
024200             ADD 1 TO CS
024400             GO TO 61-READ-SCREEN1
024500         ELSE
024600         MOVE TABL (CS) TO T-ABSENCE
024700         MOVE CS TO T-PAGE
               MOVE TERM-BUFFER TO DSPLY-REC
               PERFORM 99-SCREEN-WRITE
025100         GO TO 61-READ-SCREEN1.
025200     IF SAVE-KEY = 4
025300         CALL "TPCONSEC" USING DBPARAMETERS
025400                               VIEW-COMAREA
025600                               SCREEN-TABLES
025700                               T-YR
025800         MOVE TABL (1) TO T-ABSENCE
025900         MOVE 1 TO T-PAGE CS
               MOVE 66185 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE ERROR-BUFFER TO TERM-CMD-LINE
               MOVE SPACES TO ERROR-BUFFER
026000         MOVE "FPADD2A" TO VIEW-CFNAME
               MOVE TERM-BUFFER TO DSPLY-REC
026100         PERFORM 99-SCREEN-WRITE
026500         GO TO 61-READ-SCREEN1.
026600
026700********************
026800* VIEW-LASTKEY = 5 *
026900********************
028600     MOVE "N" TO ERROR-SW.
028800     PERFORM EDIT-ABS-DATA THRU E-A-D-E
028900                           VARYING SUB1 FROM 1 BY 1
029000                           UNTIL SUB1 > 50.
029100     IF ERROR-SW = "Y"
               MOVE TRUE-VAL TO INDS (99)
029900         GO TO 61-READ-SCREEN1.
030000
030100     MOVE T-ABSENCE TO TABL (CS).
           MOVE TERM-BUFFER TO DSPLY-REC.
030200     PERFORM 99-SCREEN-WRITE.
030300     GO TO 61-READ-SCREEN1.
030400
030500 600-ADD-ABSENCE.
030600     MOVE 27005 TO CATREAD-MSG-NUMBER.
030800     PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
           MOVE ERROR-BUFFER TO TERM-CMD-LINE.
           MOVE TRUE-VAL TO INDS (98).
           MOVE TERM-BUFFER TO DSPLY-REC.
           PERFORM 99-SCREEN-WRITE.
           PERFORM 98A-SCREEN-READ.
           CALL "CLPAUSE2".
031900     PERFORM 6000-ADD-ABSENCE-CONT VARYING CS FROM 1 BY 1
032000         UNTIL CS > 3.
           MOVE 0 TO COND-WORD.
           MOVE T-CC TO PERCCNUM OF PFREC.
           START PERSONNEL-FILE KEY IS = EXTERNALLY-DESCRIBED-KEY
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF PF-STATUS NOT = "00" MOVE 17 TO COND-WORD.
           IF COND-WORD = 17
               MOVE TRUE-VAL TO INDS (99)
               GO TO 61-READ-SCREEN1.
           READ PERSONNEL-FILE NEXT INTO PER-PERSONNEL
               AT END    MOVE 15 TO COND-WORD.
           IF PF-STATUS NOT = "00" MOVE 15 TO COND-WORD.
           IF COND-WORD = 15
               MOVE TRUE-VAL TO INDS (99)
               GO TO 61-READ-SCREEN1.
032800     IF PER-YEAR1 = SPACES MOVE T-YR TO PER-YEAR1
032900     ELSE
033000     IF PER-YEAR2 = SPACES MOVE T-YR TO PER-YEAR2
033100     ELSE
033200     IF PER-YEAR3 = SPACES MOVE T-YR TO PER-YEAR3.
           REWRITE PFREC FROM PER-PERSONNEL
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF PF-STATUS NOT = "00" MOVE 17 TO COND-WORD.
           IF COND-WORD = 17
               MOVE TRUE-VAL TO INDS (99)
               GO TO 61-READ-SCREEN1.
033900 6000-ADD-ABSENCE-CONT.
034000     PERFORM ADD-ABSENCE-CONT1 THRU A-A-C-E
034100          VARYING SUB1 FROM 1 BY 1 UNTIL SUB1 > 50.
034200 ADD-ABSENCE-CONT1.
034300     IF TAB (CS, SUB1) = SPACES GO TO A-A-C-E.
           MOVE PER-CC-NUM TO PER-ABS-CC.
           MOVE T-YR TO PER-ABS-YY.
           MOVE TCODE (CS, SUB1) TO PER-ABS-CODE.
           MOVE TDATE (CS, SUB1) TO PER-ABS-DATE.
           MOVE THRS (CS, SUB1) TO PER-ABS-HRS.
034600     MOVE PER-ABS-DATE TO DATE-VALIDATE-IN.
034700     MOVE 3 TO DATE-MODE.
034800     CALL "TDATECHK" USING DATE-CHECK-AREA.
034900     MOVE DATE-DB TO PER-ABS-DATE.
      *-----COMPUTE CENTURY FOR ABS DATE
           IF PER-ABS-DATE-YY > "70"
               MOVE "19" TO PER-ABS-DATE-CC
           ELSE
               MOVE "20" TO PER-ABS-DATE-CC.
           MOVE 0 TO COND-WORD.
           WRITE PADFREC FROM PER-ABSENCE-DATA
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF PADF-STATUS NOT = "00" MOVE 17 TO COND-WORD.
           IF COND-WORD = 17
               MOVE TRUE-VAL TO INDS (99)
               GO TO 61-READ-SCREEN1.
035400 A-A-C-E.
035500     EXIT.
035600 EDIT-ABS-DATA.
035700     IF TREC (SUB1) = SPACES
035900       GO TO E-A-D-E.
           MOVE 0 TO COND-WORD.
           MOVE TR-CODE (SUB1) TO PERABSCODE OF PADFREC.
           START PER-ABS-DATA-FILE KEY IS = EXTERNALLY-DESCRIBED-KEY
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF PADF-STATUS NOT = "00" MOVE 17 TO COND-WORD.
036600     IF COND-WORD = 17
036700         MOVE "Y" TO ERROR-SW
036800         MOVE 35042 TO CATREAD-MSG-NUMBER
037000         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE TRUE-VAL TO INDS (99)
037100         MOVE 51 TO SUB1
037200         GO TO E-A-D-E.
037600     IF TR-DATE (SUB1) = SPACES
037700         MOVE "999999" TO TR-DATE (SUB1).
037800     MOVE 3 TO DATE-MODE.
037900     MOVE TR-DATE (SUB1) TO DATE-VALIDATE-IN.
038000     CALL "TDATECHK" USING DATE-CHECK-AREA.
038100     IF DATE-RET-CODE = 1
038200         MOVE 35028 TO CATREAD-MSG-NUMBER
038400         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
038500         MOVE "Y" TO ERROR-SW
038600         MOVE 51 TO SUB1
038700         GO TO E-A-D-E.
038800     IF DATE-DB-YY NOT = T-YR
038900         MOVE 35032 TO CATREAD-MSG-NUMBER
039100         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
039200         MOVE "Y" TO ERROR-SW
039300         MOVE 51 TO SUB1
039400         GO TO E-A-D-E.
039500     IF TR-HOUR (SUB1) NUMERIC
039600         IF TR-HOUR-NUM (SUB1) > 0
039700             IF TR-HOUR-NUM (SUB1) < 25
039800                 NEXT SENTENCE
039900             ELSE
040000             MOVE "Y" TO ERROR-SW
040100         ELSE
040200         MOVE "Y" TO ERROR-SW
040300     ELSE
040400     MOVE "Y" TO ERROR-SW.
040500     IF ERROR-SW = "Y"
040600       MOVE 51 TO SUB1
040700       MOVE 35055 TO CATREAD-MSG-NUMBER
040900       PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
041000       GO TO E-A-D-E.
041200 E-A-D-E.
041300     EXIT.

       98-SCREEN-READ.
           READ DISPLAY-FILE FORMAT IS VIEW-CFNAME
               INDIC IS INDICS.
           ACCEPT IOFEEDBACK FROM I-O-FEEDBACK-AREA.
           MOVE ALL B"0" TO INDICS.
           IF DSPLY-STATUS NOT = "00"
               MOVE 3 TO VIEW-LASTKEY
           ELSE
           MOVE FUNCTION-NUM TO VIEW-LASTKEY.

       98A-SCREEN-READ.
           READ DISPLAY-FILE TERMINAL IS TERMINAL-ID
               INDIC IS INDICS
                  NO DATA MOVE DSPLY-STATUS TO DSPLY-STATUS.
           MOVE ALL B"0" TO INDICS.

       99-SCREEN-WRITE.
           WRITE DSPLY-REC FORMAT IS VIEW-CFNAME
               INDIC IS INDICS.
           MOVE ALL B"0" TO INDICS.

041400 999-CATREAD.
041500     MOVE SPACES TO ERROR-BUFFER.
041600     CALL "CCATREAD" USING CATREAD-PARMS.
041700     MOVE CATREAD-MSG-TEXT TO ERROR-BUFFER.
042400 999-CATREAD-EXIT.
042500     EXIT.
