000200 IDENTIFICATION DIVISION.
000300 PROGRAM-ID.    TPADD4.
000400 INSTALLATION.  GOODYEAR.
000500*REMARKS.
000600*       #########################################################
000700*       # This is the personnel confidential identification data#
000800*       # add program ------------------------------------------#
000900*       #########################################################.
001100 ENVIRONMENT DIVISION.
001200 CONFIGURATION SECTION.
001300 SOURCE-COMPUTER.      AS400.
001400 OBJECT-COMPUTER.      AS400.
       SPECIAL-NAMES.      I-O-FEEDBACK IS I-O-FEEDBACK-AREA
                           LOCAL-DATA IS LOCAL-DATA-AREA.
001000 INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT DISPLAY-FILE
               ASSIGN TO WORKSTATION-ZPERSON-SI
               ORGANIZATION IS TRANSACTION
               ACCESS IS SEQUENTIAL
               FILE STATUS IS DSPLY-STATUS
               CONTROL-AREA IS WS-CONTROL.
           SELECT PER-CONF-FILE
               ASSIGN TO DATABASE-MCFLMM3001
               ORGANIZATION IS INDEXED
               ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
               FILE STATUS IS PCF-STATUS.
           SELECT PER-CONFIDENTIAL
               ASSIGN TO DATABASE-MCFLMM3301
               ORGANIZATION IS INDEXED
               ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                   WITH DUPLICATES
               FILE STATUS IS PC-STATUS.
001500 DATA DIVISION.
       FILE SECTION.
       FD  DISPLAY-FILE
           LABEL RECORD ARE OMITTED.
       01  DSPLY-REC                         PIC X(2000).
       FD  PER-CONF-FILE
           LABEL RECORDS ARE STANDARD
           DATA RECORD IS PCFREC.
       01  PCFREC.
           COPY DDS-ALL-FORMATS OF MCFLMM3001.
       FD  PER-CONFIDENTIAL
           LABEL RECORDS ARE STANDARD
           DATA RECORD IS PCREC.
       01  PCREC.
           COPY DDS-ALL-FORMATS OF MCFLMM3301.
001600 WORKING-STORAGE SECTION.
003400 01  BYTE-99                      PIC 99.
       COPY CATREAD OF COPYLIB.
       COPY CPYIND  OF COPYLIB.
003200 01  ERROR-BUFFER.
           05  FILLER                   PIC X(12).
           05  ERR-CC                   PIC X(4).
           05  FILLER                   PIC X(64).
       01  FILE-STATUSES.
           05  DSPLY-STATUS             PIC XX.
           05  PC-STATUS                PIC XX.
           05  PCF-STATUS               PIC XX.
       COPY IOFEEDBACK OF COPYLIB.
003700 01  ITEM-BUFFER.
003800     05 ITEM-B                    PIC XX.
003900     05 DEFN-B                    PIC X(30).
001800 01  PASSWORD-INFORMATION.
001900     05  NAME-OF-PROGRAM     PIC X(08) VALUE "TPADD4  ".
002000     05  PROGRAM-TYPE        PIC X(02) VALUE "MA".
002100     05  PROGRAM-RELEASE     PIC X(12) VALUE " E0100010001".
002200     05  PROGRAM-DESCRIPTION.
002300         10  PROG-DESC-A     PIC X(60) VALUE
002400             "PERSONNEL CONFIDENTIAL INFORMATION ADD PROGRAM "   .
002500         10  PROG-DESC-B     PIC X(60) VALUE SPACES.
002700         10  PROG-FUNCTION   PIC X(60) VALUE SPACES.
002900     05  PASSWORD-FLAG       PIC X.
003600 01  PER-IDENTIFICATION.          COPY DPERCONF OF COPYLIB.
003300 01  S1                           PIC S9(4) COMP.
003500 COPY DBSTAT  OF COPYLIB.
004000 01  SCREEN-TABLES.
004100     05 SCREEN-CC                 PIC X(4).
004200     05 SCREEN OCCURS 10 TIMES.
004300         10 SCRN-DEF              PIC X(30).
004400         10 SCRN-VAL              PIC X(20).
           05  SCREEN-CMD-LINE          PIC X(79).
           05  SCREEN-ERR-LINE          PIC X(79).
       01  TRUE-VAL                     PIC 1 VALUE B"1".
004500 COPY WSCONTROL OF COPYLIB.
004600 LINKAGE SECTION.
004700 01  DBPARAMETERS.                COPY DBPARMS  OF COPYLIB.
004800 COPY VCOMLINK OF COPYLIB.
004900 01  PLT-IDT                      PIC X(4).
005100 01  PER-PERSONNEL.               COPY MPERSONL OF COPYLIB.
005300 PROCEDURE DIVISION USING DBPARAMETERS
005400                          VIEW-COMAREA
005500                          PLT-IDT
005700                          PER-PERSONNEL.
006700 START-PROCESSING.
006800     PERFORM 1-HSK.
006900     PERFORM 6-MAIN.
007500 2-EOJ.
           CLOSE DISPLAY-FILE.
           CLOSE PER-CONF-FILE.
           CLOSE PER-CONFIDENTIAL.
007700     GOBACK.
007100 1-HSK.
           OPEN I-O   DISPLAY-FILE.
           OPEN I-O   PER-CONF-FILE.
           OPEN I-O   PER-CONFIDENTIAL.
006000     CALL "TPWORD" USING PASSWORD-INFORMATION.
006400     IF PASSWORD-FLAG = "N" GO TO 2-EOJ.
007300     MOVE SPACES TO SCREEN-TABLES.
007400     MOVE PER-CC-NUM TO SCREEN-CC.
008500     PERFORM 1-READ-CODES THRU 1-EXIT UNTIL COND-WORD = 11.
010400 1-READ-CODES.
           MOVE 0 TO COND-WORD.
           READ PER-CONF-FILE NEXT INTO ITEM-BUFFER
               AT END    MOVE 11 TO COND-WORD.
           IF PCF-STATUS NOT = "00" MOVE 11 TO COND-WORD.
011300     IF COND-WORD = 11 GO TO 1-EXIT.
012000     MOVE ITEM-B TO BYTE-99.
012100     MOVE BYTE-99 TO S1.
012200     MOVE DEFN-B TO SCRN-DEF (S1).
012300 1-EXIT.    EXIT.
012400
007800 6-MAIN.
012600     MOVE "FPADD4" TO VIEW-CFNAME.
           MOVE 66198 TO CATREAD-MSG-NUMBER.
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
           MOVE ERROR-BUFFER TO SCREEN-CMD-LINE.
           MOVE SPACES TO ERROR-BUFFER.
           MOVE SCREEN-TABLES TO DSPLY-REC.
           PERFORM 99-SCREEN-WRITE.
013900     PERFORM 98-SCREEN-READ.
           MOVE DSPLY-REC TO SCREEN-TABLES.
014900     IF VIEW-LASTKEY = 3 GO TO 2-EOJ.
015000     IF VIEW-LASTKEY = 5
015100         NEXT SENTENCE
015200     ELSE
           MOVE 35126 TO CATREAD-MSG-NUMBER
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
           MOVE ERROR-BUFFER TO SCREEN-ERR-LINE
           MOVE TRUE-VAL TO INDS (99)
015300     GO TO 6-MAIN.
010100     PERFORM 60-ADD THRU 60-EXIT VARYING S1 FROM 1 BY 1
010200         UNTIL S1 > 10.
           MOVE 66189 TO CATREAD-MSG-NUMBER.
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
           MOVE SCREEN-CC TO ERR-CC.
           MOVE ERROR-BUFFER TO SCREEN-CMD-LINE.
           MOVE SCREEN-TABLES TO DSPLY-REC.
           MOVE TRUE-VAL TO INDS (98).
           PERFORM 99-SCREEN-WRITE.
           PERFORM 98A-SCREEN-READ.
           CALL "CLPAUSE2".
016200 60-ADD.
016300     IF SCRN-VAL (S1) = SPACES GO TO 60-EXIT.
016400     MOVE PER-CC-NUM TO PER-CONF-CC.
016500     MOVE S1 TO BYTE-99.
016600     MOVE BYTE-99 TO PER-CONF-ITEM.
016700     MOVE SCRN-VAL (S1) TO PER-CONF-DATA.
           MOVE 0 TO COND-WORD.
           WRITE PCREC FROM PER-IDENTIFICATION
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF PC-STATUS NOT = "00" MOVE 17 TO COND-WORD.
           IF COND-WORD = 17 GO TO 2-EOJ.
017500 60-EXIT.    EXIT.

       98-SCREEN-READ.
           READ DISPLAY-FILE FORMAT IS VIEW-CFNAME
               INDIC IS INDICS.
           ACCEPT IOFEEDBACK FROM I-O-FEEDBACK-AREA.
           MOVE ALL B"0" TO INDICS.
           IF DSPLY-STATUS NOT = "00"
               MOVE 3 TO VIEW-LASTKEY
           ELSE
           MOVE FUNCTION-NUM TO VIEW-LASTKEY.

       98A-SCREEN-READ.
           READ DISPLAY-FILE TERMINAL IS TERMINAL-ID
               INDIC IS INDICS
                  NO DATA MOVE DSPLY-STATUS TO DSPLY-STATUS.
           MOVE ALL B"0" TO INDICS.

       99-SCREEN-WRITE.
           WRITE DSPLY-REC FORMAT IS VIEW-CFNAME
               INDIC IS INDICS.
           MOVE ALL B"0" TO INDICS.

018500 999-CATREAD.
018600     MOVE SPACES TO ERROR-BUFFER.
018700     CALL "CCATREAD" USING CATREAD-PARMS.
018800     MOVE CATREAD-MSG-TEXT TO ERROR-BUFFER.
019500 999-CATREAD-EXIT.
019600     EXIT.
