       LINKAGE SECTION.
       01  LINK-DATA.
           05 LINK-DATA-X.
               10  LD-YEAR     PIC X(04).
               10  LD-MONTH    PIC X(02).
           05 LINK-DATA-9 REDEFINES LINK-DATA-X.
               10  LD-YR       PIC 9(04).
               10  LD-YRB REDEFINES LD-YR.
                   15  LDYR3   PIC 9(03).
                   15  LDYRL   PIC 9.
               10  LD-MON      PIC 9(02).
       01 RET-MO-NAME          PIC X(09).
       01 RET-MO-DATA          PIC X(111).
       01 RET-MO-ERROR         PIC X(76).

       PROCEDURE DIVISION USING LINK-DATA
                                RET-MO-NAME
                                RET-MO-DATA
                                RET-MO-ERROR.
       BEGIN-PROC.
           IF LD-YR < 1990
             MOVE "YEAR OUTSIDE OF PROGRAM RANGE."
                 TO RET-MO-ERROR
             GOBACK.

           IF LD-YR > 2059
             MOVE "YEAR OUTSIDE OF PROGRAM RANGE."
                 TO RET-MO-ERROR
             GOBACK.

           MOVE 0              TO SUBMO SUBYR.
           MOVE MONTH(LD-MON)  TO RET-MO-NAME.

           IF LDYR3 = "199"    MOVE YR-199 TO YR-DIGIT.
           IF LDYR3 = "200"    MOVE YR-200 TO YR-DIGIT.
           IF LDYR3 = "201"    MOVE YR-201 TO YR-DIGIT.
           IF LDYR3 = "202"    MOVE YR-202 TO YR-DIGIT.
           IF LDYR3 = "203"    MOVE YR-203 TO YR-DIGIT.
           IF LDYR3 = "204"    MOVE YR-204 TO YR-DIGIT.
           IF LDYR3 = "205"    MOVE YR-205 TO YR-DIGIT.

           MOVE LDYRL          TO SUBYR.
           ADD  1              TO SUBYR.

           IF YR-ALPHA(SUBYR) = "A" MOVE MO-A TO MO-DIGITS.
           IF YR-ALPHA(SUBYR) = "B" MOVE MO-B TO MO-DIGITS.
           IF YR-ALPHA(SUBYR) = "C" MOVE MO-C TO MO-DIGITS.
           IF YR-ALPHA(SUBYR) = "D" MOVE MO-D TO MO-DIGITS.
           IF YR-ALPHA(SUBYR) = "E" MOVE MO-E TO MO-DIGITS.
           IF YR-ALPHA(SUBYR) = "F" MOVE MO-F TO MO-DIGITS.
           IF YR-ALPHA(SUBYR) = "G" MOVE MO-G TO MO-DIGITS.
           IF YR-ALPHA(SUBYR) = "H" MOVE MO-H TO MO-DIGITS.
           IF YR-ALPHA(SUBYR) = "I" MOVE MO-I TO MO-DIGITS.
           IF YR-ALPHA(SUBYR) = "J" MOVE MO-J TO MO-DIGITS.
           IF YR-ALPHA(SUBYR) = "K" MOVE MO-K TO MO-DIGITS.
           IF YR-ALPHA(SUBYR) = "L" MOVE MO-L TO MO-DIGITS.
           IF YR-ALPHA(SUBYR) = "M" MOVE MO-M TO MO-DIGITS.
           IF YR-ALPHA(SUBYR) = "N" MOVE MO-N TO MO-DIGITS.

           IF MO-NUM(LD-MON) = "11"  MOVE  1 TO SUBMO.
           IF MO-NUM(LD-MON) = "12"  MOVE  2 TO SUBMO.
           IF MO-NUM(LD-MON) = "13"  MOVE  3 TO SUBMO.
           IF MO-NUM(LD-MON) = "14"  MOVE  4 TO SUBMO.
           IF MO-NUM(LD-MON) = "15"  MOVE  5 TO SUBMO.
           IF MO-NUM(LD-MON) = "16"  MOVE  6 TO SUBMO.
           IF MO-NUM(LD-MON) = "17"  MOVE  7 TO SUBMO.
           IF MO-NUM(LD-MON) = "21"  MOVE  8 TO SUBMO.
           IF MO-NUM(LD-MON) = "22"  MOVE  9 TO SUBMO.
           IF MO-NUM(LD-MON) = "23"  MOVE 10 TO SUBMO.
           IF MO-NUM(LD-MON) = "24"  MOVE 11 TO SUBMO.
           IF MO-NUM(LD-MON) = "25"  MOVE 12 TO SUBMO.
           IF MO-NUM(LD-MON) = "26"  MOVE 13 TO SUBMO.
           IF MO-NUM(LD-MON) = "27"  MOVE 14 TO SUBMO.
           IF MO-NUM(LD-MON) = "31"  MOVE 15 TO SUBMO.
           IF MO-NUM(LD-MON) = "32"  MOVE 16 TO SUBMO.
           IF MO-NUM(LD-MON) = "33"  MOVE 17 TO SUBMO.
           IF MO-NUM(LD-MON) = "34"  MOVE 18 TO SUBMO.
           IF MO-NUM(LD-MON) = "35"  MOVE 19 TO SUBMO.
           IF MO-NUM(LD-MON) = "36"  MOVE 20 TO SUBMO.
           IF MO-NUM(LD-MON) = "37"  MOVE 21 TO SUBMO.
           IF MO-NUM(LD-MON) = "41"  MOVE 22 TO SUBMO.
           IF MO-NUM(LD-MON) = "42"  MOVE 23 TO SUBMO.
           IF MO-NUM(LD-MON) = "43"  MOVE 24 TO SUBMO.
           IF MO-NUM(LD-MON) = "44"  MOVE 25 TO SUBMO.
           IF MO-NUM(LD-MON) = "45"  MOVE 26 TO SUBMO.
           IF MO-NUM(LD-MON) = "46"  MOVE 27 TO SUBMO.
           IF MO-NUM(LD-MON) = "47"  MOVE 28 TO SUBMO.

           MOVE MONTH-ENTRY(SUBMO) TO RET-MO-DATA.
           GOBACK.

      ************  END  OF  FILE  *****************************************
