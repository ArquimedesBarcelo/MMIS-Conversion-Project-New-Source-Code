       IDENTIFICATION DIVISION.
       PROGRAM-ID.             TCCEXEC.
      *REMARKS.            *** MACHINE CATALOG FILE EXECUTIVE PROGRAM
       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.
       SOURCE-COMPUTER.        IBM-AS400.
       OBJECT-COMPUTER.        IBM-AS400.
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT EQUIPMENT-FILE
                  ASSIGN       TO DATABASE-MCFLMM0201
                  ORGANIZATION IS INDEXED
                  ACCESS MODE  IS DYNAMIC
                  RECORD KEY   IS EXTERNALLY-DESCRIBED-KEY
                  FILE STATUS  IS FILE-STAT.

           SELECT WO-LAST-NUM-USED
                  ASSIGN       TO DATABASE-MCFPMM0800
                  ORGANIZATION IS RELATIVE
                  ACCESS MODE  IS RANDOM
                  RELATIVE KEY IS ARG-NO
                  FILE STATUS  IS FILE-STAT.

           SELECT DISPLAY-FILE
                  ASSIGN       TO WORKSTATION-ZCCLINK-SI
                  ORGANIZATION IS TRANSACTION
                  ACCESS MODE  IS SEQUENTIAL
                  FILE STATUS  IS SCREEN-STATUS
                               MAJOR-MINOR
                  CONTROL-AREA IS SCREEN-CONTROL.

       DATA DIVISION.
       FILE SECTION.
       FD  DISPLAY-FILE
           LABEL RECORDS ARE OMITTED.
       01  DISPLAY-REC         PIC X(2000).

       FD  EQUIPMENT-FILE
           LABEL RECORDS ARE STANDARD
           DATA RECORD IS EFREC.
       01  EFREC.
           COPY DDS-ALL-FORMATS OF MCFLMM0201.

       FD  WO-LAST-NUM-USED
           LABEL RECORDS ARE STANDARD
           DATA RECORD IS WLNUREC.
       01  WLNUREC.
           COPY DDS-ALL-FORMATS OF MCFPMM0800.

       WORKING-STORAGE SECTION.
       77  ARG-NO              PIC 9(9)  VALUE 1.
       77  SCRN-SW             PIC   9   VALUE 1.

       01  PASSWORD-INFORMATION.
           05  NAME-OF-PROGRAM     PIC X(08) VALUE "TCCEXEC ".
           05  PROGRAM-TYPE        PIC X(02) VALUE "MA".
           05  PROGRAM-RELEASE     PIC X(12) VALUE " J0100010001".
           05  PROGRAM-DESCRIPTION.
               10  PROG-DESC-A.
                   15  FILLER      PIC X(12) VALUE "SPARE PARTS ".
                   15  FILLER      PIC X(12) VALUE "MAINTENANCE ".
                   15  FILLER      PIC X(17) VALUE "EXECUTIVE PROGRAM".
                   15  FILLER      PIC X(19) VALUE SPACES.
               10  PROG-DESC-B     PIC X(60) VALUE SPACES.
               10  PROG-FUNCTION   PIC X(60) VALUE SPACES.
           05  PASSWORD-FLAG       PIC X.

       01  FILE-STAT.
           05 FILE-STAT-1      PIC X   VALUE "0".
           05 FILE-STAT-2      PIC X   VALUE "0".

       01  SCREEN-DATA.
           05  EQP-NUM-BUF     PIC X(06).
           05  EQP-TYPE-BUF    PIC X(08).
           05  SUB-SYS-BUF     PIC X(04).
           05  CMDMSG          PIC X(79).
           05  ERRMSG          PIC X(79).

       01  LINK-DATA.
           05  EQP-SUB-LINK.
               10  EQP-NUM-LINK  PIC X(06).
               10  FILLER        PIC X(02).
               10  ESUBSYS-LINK  PIC X(04).
           05  TYPE-SUB-LINK.
               10  TYPE-NUM-LINK PIC X(08).
               10  TSUBSYS-LINK  PIC X(04).

           COPY SCREENIO       IN COPYLIB.

           COPY CATREAD        IN COPYLIB.

       01  DBPARAMETERS.       COPY DBPARMS  OF COPYLIB.

       01  EQUIPMENT-DATA.     COPY MEQPFILE OF COPYLIB.

       01  LAST-WO-USED-DATA.  COPY MLASTWO  OF COPYLIB.

       01  MESSAGE-DATA.       COPY ERRORLIN OF COPYLIB.

       PROCEDURE DIVISION.
       BEGIN-PROC.
           OPEN I-O            DISPLAY-FILE.
           OPEN INPUT          EQUIPMENT-FILE.
           OPEN INPUT          WO-LAST-NUM-USED.

           MOVE 0              TO KEY-HIT FUNC-KEY-NUM.
           MOVE SPACES         TO MESSAGE-BUFFER.
           READ WO-LAST-NUM-USED INTO LAST-WO-USED-DATA
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
               MOVE 1 TO DATE-FLAG-SW.
           MOVE DATE-FLAG-SW   TO DATE-FLAG.

           CALL "TPWORD"       USING PASSWORD-INFORMATION.
           IF PASSWORD-FLAG = "N" GO TO END-OF-JOB.

           MOVE SPACES         TO SCREEN-DATA.
           MOVE "FCCEXEC1"     TO SCREEN-NAME.
           MOVE 1              TO SCRN-SW.

       6-MAIN.
           IF IND(99) = B"1"
               MOVE MESSAGE-BUFFER TO ERRMSG
               GO TO 6-WRITE-SCREEN.

      *M**************************************************************
      *M  MESSAGE:  066/223
      *M  F1-EQP NO.  F2-EQP TYPE  F3-EXIT  F5-MACH. NOTES  F6-ADD
      *M  F7-COPY  F8-DELETE
      *M**************************************************************
           MOVE 66223          TO CATREAD-MSG-NUMBER.
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
           MOVE MESSAGE-BUFFER TO CMDMSG.

       6-WRITE-SCREEN.
           MOVE "00"           TO SCREEN-STATUS.
           MOVE SCREEN-DATA    TO DISPLAY-REC.

           WRITE DISPLAY-REC   FORMAT IS SCREEN-NAME
               INDIC ARE SCREEN-INDICATORS.
           IF SCREEN-STATUS NOT = "00"
               DISPLAY "SCREEN WRITE ERROR.  SCREEN-STATUS IS "
                               SCREEN-STATUS
               GO TO END-OF-JOB.

           READ  DISPLAY-FILE  FORMAT IS SCREEN-NAME
               INDIC ARE SCREEN-INDICATORS
           IF SCREEN-STATUS NOT = "00"
               DISPLAY "SCREEN READ ERROR.  SCREEN-STATUS IS "
                               SCREEN-STATUS
               GO TO END-OF-JOB.

           MOVE ALL B"0"       TO SCREEN-INDICATORS.
           MOVE KEY-HIT        TO FUNC-KEY-NUM.
           MOVE DISPLAY-REC    TO SCREEN-DATA.
           MOVE SPACES         TO CMDMSG ERRMSG.

           IF KEY-HIT = 1
               MOVE "FCCEXEC1" TO SCREEN-NAME
               MOVE 1          TO SCRN-SW
               MOVE SPACES     TO EQP-NUM-BUF EQP-TYPE-BUF
               GO TO 6-MAIN.

           IF KEY-HIT = 2
               MOVE "FCCEXEC2" TO SCREEN-NAME
               MOVE 2          TO SCRN-SW
               MOVE SPACES     TO EQP-NUM-BUF EQP-TYPE-BUF
               GO TO 6-MAIN.

           IF KEY-HIT = 3      GO TO END-OF-JOB.

           IF KEY-HIT = 0
               GO TO 6-MAIN.

           IF SCREEN-DATA = SPACES
               GO TO 6-MAIN.

           IF SPACES = EQP-NUM-BUF AND EQP-TYPE-BUF
      *M**************************************************************
      *M  MESSAGE:  031/092
      *M  EITHER EQUIPMENT NUMBER OR TYPE IS REQUIRED - NOT BOTH
      *M**************************************************************
               MOVE 31092      TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE B"1"       TO IND(1) IND(99)
               GO TO 6-MAIN.

           IF EQP-NUM-BUF NOT = SPACES
               IF EQP-TYPE-BUF NOT = SPACES
      *M**************************************************************
      *M  MESSAGE:  031/092
      *M  EITHER EQUIPMENT NUMBER OR TYPE IS REQUIRED - NOT BOTH
      *M**************************************************************
               MOVE 31092      TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE B"1"       TO IND(1) IND(99)
               GO TO 6-MAIN.

           IF SCRN-SW = 2 OR 3
               GO TO 6-TYPE-NUM.

           IF EQP-NUM-BUF = SPACES
      *M**************************************************************
      *M  MESSAGE:  031/016
      *M  EQUIPMENT NUMBER IS REQUIRED
      *M**************************************************************
               MOVE 31016      TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE B"1"       TO IND(1) IND(99)
               GO TO 6-MAIN.

           MOVE EQP-NUM-BUF    TO EQPNUM OF EQUIPMENT-FILE.
           READ EQUIPMENT-FILE INTO EQUIPMENT-DATA
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
      *M**************************************************************
      *M  MESSAGE:  030/052
      *M  DEVICE NOT IN EQUIPMENT FILE
      *M**************************************************************
               MOVE 30052      TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE B"1"       TO IND(1) IND(99)
               GO TO 6-MAIN.

           GO TO 6-CONTINUE.

       6-TYPE-NUM.
           IF SCRN-SW = 3
               GO TO 6-CONTINUE.

           IF EQP-TYPE-BUF = SPACES
      *M**************************************************************
      *M  MESSAGE:  031/002
      *M  EQUIPMENT TYPE IS REQUIRED
      *M**************************************************************
               MOVE 31002      TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE B"1"       TO IND(3) IND(99)
               GO TO 6-MAIN.

       6-CONTINUE.
           IF SUB-SYS-BUF = SPACES
      *M**************************************************************
      *M  MESSAGE:  045/037
      *M  SUBSYSTEM NUMBER IS REQUIRED
      *M**************************************************************
               MOVE 45037      TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE B"1"       TO IND(3) IND(99)
               GO TO 6-MAIN.

           IF SUB-SYS-BUF NOT NUMERIC
               MOVE SPACES     TO SUB-SYS-BUF
      *M**************************************************************
      *M  MESSAGE:  045/037
      *M  SUBSYSTEM NUMBER IS REQUIRED
      *M**************************************************************
               MOVE 45037      TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE B"1"       TO IND(3) IND(99)
               GO TO 6-MAIN.

       6-GET-NEXT-FUNCTION.
           MOVE EQP-NUM-BUF    TO EQP-NUM-LINK.
           MOVE EQP-TYPE-BUF   TO TYPE-NUM-LINK.
           MOVE SUB-SYS-BUF    TO ESUBSYS-LINK TSUBSYS-LINK.
           IF FUNC-KEY-NUM = 1
               MOVE "FCCEXEC1" TO SCREEN-NAME
               MOVE 1          TO SCRN-SW
               MOVE SPACES     TO EQP-NUM-BUF EQP-TYPE-BUF
               GO TO 6-MAIN
           ELSE
           IF FUNC-KEY-NUM = 2
               MOVE "FCCEXEC2" TO SCREEN-NAME
               MOVE 2          TO SCRN-SW
               MOVE SPACES     TO EQP-NUM-BUF EQP-TYPE-BUF
               GO TO 6-MAIN
           ELSE
           IF FUNC-KEY-NUM = 4
               MOVE "FCCEXEC3" TO SCREEN-NAME
               MOVE 3          TO SCRN-SW
               MOVE SPACES     TO SUB-SYS-BUF
               GO TO 6-MAIN
           ELSE
           IF FUNC-KEY-NUM = 5
               CALL "TCCMACH"  USING DBPARAMETERS
                               LINK-DATA
               GO TO 6-GET-NEXT-FUNCTION
           ELSE
           IF FUNC-KEY-NUM = 6
               CALL "TCCINIT"  USING DBPARAMETERS
                               LINK-DATA
               GO TO 6-GET-NEXT-FUNCTION
           ELSE
           IF FUNC-KEY-NUM = 7
               CALL "TCCCOPY"  USING DBPARAMETERS
                               LINK-DATA
               GO TO 6-GET-NEXT-FUNCTION
           ELSE
           IF FUNC-KEY-NUM = 8
               CALL "TCCDEL"   USING DBPARAMETERS
                               LINK-DATA
               GO TO 6-GET-NEXT-FUNCTION
           ELSE
               MOVE "FCCEXEC1" TO SCREEN-NAME
               MOVE 1          TO SCRN-SW
               MOVE SPACES     TO SCREEN-DATA
               GO TO 6-MAIN.

       END-OF-JOB.
           CLOSE               DISPLAY-FILE.
           CLOSE               EQUIPMENT-FILE.
           CLOSE               WO-LAST-NUM-USED.
           GOBACK.

       999-CATREAD.
           MOVE SPACES         TO MESSAGE-BUFFER.
           CALL "CCATREAD"     USING CATREAD-PARMS.
           MOVE CATREAD-MSG-TEXT TO MESSAGE-BUFFER.

       999-CATREAD-EXIT.       EXIT.

