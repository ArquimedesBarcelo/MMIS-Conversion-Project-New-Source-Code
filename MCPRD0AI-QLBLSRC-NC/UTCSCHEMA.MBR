       IDENTIFICATION DIVISION.
       PROGRAM-ID. UTCSCHEMA.
       AUTHOR.     W. H. JENKINS.
       INSTALLATION.  GOODYEAR TIRE & RUBBER CO.
       DATE-WRITTEN.   08/08/88.
       DATE-COMPILED.  08/08/88.
       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.
       SOURCE-COMPUTER. IBM-S38.
       OBJECT-COMPUTER. IBM-S38.
       SPECIAL-NAMES. I-O-FEEDBACK IS IO-FEEDBACK.
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
            SELECT SCHEMA-FILE   ASSIGN TO DATABASE-SCHEMA
                   FILE STATUS IS SCHEMA-SK.
            SELECT UTFPHPDI-FILE ASSIGN TO DATABASE-UTFPHPDI
                   ORGANIZATION IS INDEXED
                   ACCESS IS DYNAMIC
                   RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                   FILE STATUS IS UTFPHPDI-SK.
            SELECT UTFPHPDS-FILE ASSIGN TO DATABASE-UTFPHPDS
                   ORGANIZATION IS INDEXED
                   ACCESS IS DYNAMIC
                   RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                   FILE STATUS IS UTFPHPDS-SK.
            SELECT UTFPHPDE-FILE ASSIGN TO DATABASE-UTFPHPDE
                   ORGANIZATION IS INDEXED
                   ACCESS IS DYNAMIC
                   RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                   FILE STATUS IS UTFPHPDE-SK.
       DATA DIVISION.
       FILE SECTION.
       FD  SCHEMA-FILE
           LABEL RECORDS ARE STANDARD.
       01  SCHEMA-RECORD.
           COPY DDS-ALL-FORMATS OF QTXTSRC.
       FD  UTFPHPDI-FILE
           LABEL RECORDS ARE STANDARD.
       01  UTRPHPDI-RECORD.
           COPY DDS-ALL-FORMATS OF UTFPHPDI.
       FD  UTFPHPDS-FILE
           LABEL RECORDS ARE STANDARD.
       01  UTRPHPDS-RECORD.
           COPY DDS-ALL-FORMATS OF UTFPHPDS.
       FD  UTFPHPDE-FILE
           LABEL RECORDS ARE STANDARD.
       01  UTRPHPDE-RECORD.
           COPY DDS-ALL-FORMATS OF UTFPHPDE.
       WORKING-STORAGE SECTION.
       01  CONSTANTS-N-SAVES.
           03  CHAR-PTR                PIC S9(3) VALUE ZERO.
           03  DELIM-WS                PIC X     VALUE SPACES.
           03  CHAR-CTR                PIC S9(3) VALUE ZERO.
           03  MAX-SCAN                PIC S9(3) VALUE +72.
           03  DATA-BASE-WS            PIC X(6)  VALUE SPACES.
           03  ITEM-WS                 PIC X(16) VALUE SPACES.
           03  FILLER REDEFINES ITEM-WS.
               05  ITEM-T-WS           PIC X.
               05  ITEM-L-WS           PIC X(15).
           03  FILLER REDEFINES ITEM-WS.
               05  ITEM-BYTE OCCURS 16 TIMES INDEXED BY INDX-I
                                                        INDX-I2
                                       PIC X.
           03  FILE-NAME.
               05  FILE-PFX            PIC X(2).
               05  FILLER              PIC X(2)  VALUE "FP".
               05  DB-PFX              PIC X(2).
               05  FILE-CTR            PIC S9(4) VALUE ZERO.
           03  FIELD-NAME.
               05  FIELD-PFX           PIC XX.
               05  FIELD-CTR           PIC S9(5) VALUE ZERO.
       01  TRSHIFT-PARMS.
           03  NUM-X-WS                PIC X(8).
           03  NUM-WS REDEFINES NUM-X-WS PIC S9(8).
           03  FILLER REDEFINES NUM-X-WS.
               05  NUM-BYTE OCCURS 8 TIMES INDEXED BY INDX-B
                                       PIC X.
           03  RETCODE-WS              PIC X(2).
       01  QCLSCAN-PARMS.
           03  STRING-WS               PIC X(80).
           03  STRING-RDF REDEFINES STRING-WS.
               05  STRING-BYTE OCCURS 80 TIMES INDEXED BY INDX-S
                                       PIC X.
           03  STRLEN-WS               PIC S9(3) COMP-3 VALUE ZERO.
           03  STRPOS-WS               PIC S9(3) COMP-3 VALUE ZERO.
           03  PATTERN-WS              PIC X(20) VALUE SPACES.
           03  PATLEN-WS               PIC S9(3) COMP-3 VALUE ZERO.
           03  TRANSLATE-WS            PIC X     VALUE ZERO.
           03  TRIM-WS                 PIC X     VALUE ZERO.
           03  WILD-WS                 PIC X     VALUE SPACES.
           03  RESULT-WS               PIC S9(3) COMP-3 VALUE ZERO.
       01  SWITCHES.
           03  SW-ON                   PIC 1     VALUE B"1".
           03  SW-OFF                  PIC 1     VALUE B"0".
           03  KEYWORD-SW              PIC 1     VALUE B"0".
           03  BEGIN-DATA-BASE-SW      PIC 1     VALUE B"0".
           03  ITEMS-SW                PIC 1     VALUE B"0".
           03  SETS-SW                 PIC 1     VALUE B"0".
           03  NAME-SW                 PIC 1     VALUE B"0".
           03  ENTRY-SW                PIC 1     VALUE B"0".
           03  CAPACITY-SW             PIC 1     VALUE B"0".
           03  END-SW                  PIC 1     VALUE B"0".
       01  FILE-STATUS-KEYS.
           03  SCHEMA-SK               PIC X(2)  VALUE ZERO.
           03  UTFPHPDI-SK             PIC X(2)  VALUE ZERO.
           03  UTFPHPDS-SK             PIC X(2)  VALUE ZERO.
           03  UTFPHPDE-SK             PIC X(2)  VALUE ZERO.
       LINKAGE SECTION.
       01  FILE-PFX-LS                 PIC X(2).
       01  DB-PFX-LS                   PIC X(2).
       01  DBNAME-LS                   PIC X(10).
       PROCEDURE DIVISION USING FILE-PFX-LS DB-PFX-LS DBNAME-LS.
       A-BEGIN.
           PERFORM 000-INIT THRU 000-EXIT.
           PERFORM 900-MAIN THRU 900-EXIT
                   UNTIL
                       SCHEMA-SK NOT = ZERO
                    OR END-SW = SW-ON.
           PERFORM 999-EOJ THRU 999-EXIT.
       COBOL-EXIT.
           EXIT PROGRAM.
       RPG-CL-EXIT.
           STOP RUN.

       000-INIT.
           OPEN INPUT  SCHEMA-FILE.
           OPEN I-O    UTFPHPDI-FILE
                       UTFPHPDS-FILE
                       UTFPHPDE-FILE.
           MOVE SW-OFF TO BEGIN-DATA-BASE-SW
                          ITEMS-SW
                          SETS-SW
                          NAME-SW
                          ENTRY-SW
                          CAPACITY-SW
                          END-SW
                          KEYWORD-SW.
           MOVE ZERO  TO  FILE-CTR
                          FIELD-CTR.
           MOVE FILE-PFX-LS TO FILE-PFX
           MOVE DB-PFX-LS   TO DB-PFX
                               FIELD-PFX.
       000-EXIT.
           EXIT.

       010-QCLSCAN.
            CALL "QCLSCAN" USING STRING-WS
                                 STRLEN-WS
                                 STRPOS-WS
                                 PATTERN-WS
                                 PATLEN-WS
                                 TRANSLATE-WS
                                 TRIM-WS
                                 WILD-WS
                                 RESULT-WS.
       010-EXIT.
           EXIT.

       020-NON-BLANK.
           SET INDX-S TO CHAR-PTR.
       020-NON-BLANK-CONT.
           IF STRING-BYTE (INDX-S) = SPACES
              IF INDX-S < MAX-SCAN
                 SET INDX-S UP BY 1
                 GO TO 020-NON-BLANK-CONT.
           SET CHAR-PTR TO INDX-S.
       020-EXIT.
           EXIT.

       030-TRSHIFT.
            CALL "TRSHIFT" USING RETCODE-WS
                                 NUM-X-WS.
            IF NUM-WS NUMERIC
               NEXT SENTENCE
            ELSE
               MOVE ZERO TO NUM-WS.
       030-EXIT.
           EXIT.

       040-SCAN-COMMENT.
           MOVE +72                  TO STRLEN-WS.
           MOVE +1                   TO STRPOS-WS.
           MOVE "<<"                 TO PATTERN-WS.
           MOVE +2                   TO PATLEN-WS.
           MOVE ZERO                 TO TRANSLATE-WS.
           MOVE ZERO                 TO TRIM-WS.
           MOVE SPACES               TO WILD-WS.
           MOVE ZERO                 TO RESULT-WS.
           PERFORM 010-QCLSCAN THRU 010-EXIT.
       040-EXIT.
           EXIT.

       300-ITEMS.
           PERFORM 040-SCAN-COMMENT THRU 040-EXIT.
           MOVE +1   TO CHAR-PTR.
           PERFORM 020-NON-BLANK THRU 020-EXIT.
      * ONLY COMMENTS ?
           IF RESULT-WS = CHAR-PTR
              GO TO 300-EXIT.
      * GET ITEM
           MOVE ZERO TO CHAR-CTR.
           UNSTRING STRING-WS DELIMITED BY ","
                    INTO ITEM-WS
                         DELIMITER IN DELIM-WS
                         COUNT     IN CHAR-CTR
                    WITH POINTER CHAR-PTR.
      * READ ITEM
           MOVE DATA-BASE-WS TO DINAME.
           MOVE ITEM-WS      TO DIITEM.
           READ UTFPHPDI-FILE.
      * GET SUB-ITEM COUNT / TYPE DESIGNATOR & SUB-ITEM LENGTH
           PERFORM 020-NON-BLANK THRU 020-EXIT.
           MOVE ZERO TO CHAR-CTR.
           UNSTRING STRING-WS DELIMITED BY ALL SPACES
                                       OR ";"
                                       OR "("
                    INTO ITEM-WS
                         DELIMITER IN DELIM-WS
                         COUNT     IN CHAR-CTR
                    WITH POINTER CHAR-PTR.
      * SUB ITEM COUNT ?
           IF ITEM-T-WS NOT NUMERIC
              MOVE +1         TO DICNT
           ELSE
      * GET SUB ITEM COUNT
              PERFORM 310-SCAN-SUB-ITEM THRU 310-EXIT.
      * GET TYPE DESIGNATOR & SUB-ITEM LENGTH
            MOVE ITEM-T-WS TO DITYPE.
            MOVE ITEM-L-WS TO NUM-X-WS.
            PERFORM 030-TRSHIFT THRU 030-EXIT.
            IF NUM-WS > ZERO
               MOVE NUM-WS     TO DILEN
            ELSE
               MOVE +1         TO DILEN.
           ADD +100 TO FIELD-CTR.
           IF DICNT = +1
              MOVE DIITEM     TO DISITM
           ELSE
              MOVE FIELD-NAME TO DISITM.
           IF UTFPHPDI-SK = ZERO
              REWRITE UTRPHPDI-RECORD
           ELSE
              WRITE UTRPHPDI-RECORD.
       300-EXIT.
           EXIT.

       310-SCAN-SUB-ITEM.
           SET INDX-I TO 1.
           SET INDX-B TO 1.
           MOVE SPACES TO NUM-X-WS.
       310-SCAN-CONT.
           IF ITEM-BYTE (INDX-I) NUMERIC
              MOVE ITEM-BYTE (INDX-I) TO NUM-BYTE (INDX-B)
              IF INDX-B < 8
                 SET INDX-I UP BY 1
                 SET INDX-B UP BY 1
                 GO TO 310-SCAN-CONT.
           PERFORM 030-TRSHIFT THRU 030-EXIT.
           MOVE NUM-WS     TO DICNT.
      * GET TYPE DESIGNATOR & SUB-ITEM LENGTH
           IF ITEM-BYTE (INDX-I) = SPACES
              PERFORM 020-NON-BLANK THRU 020-EXIT
              MOVE ZERO TO CHAR-CTR
              UNSTRING STRING-WS DELIMITED BY ALL SPACES
                                        OR ";"
                                        OR "("
                       INTO ITEM-WS
                           DELIMITER IN DELIM-WS
                           COUNT     IN CHAR-CTR
                       WITH POINTER CHAR-PTR
           ELSE
              PERFORM 320-MOVE-TYPE-N-SUB THRU 320-EXIT.
       310-EXIT.
           EXIT.

       320-MOVE-TYPE-N-SUB.
           SET INDX-I2 TO 1.
       320-MOVE-CONT.
           MOVE ITEM-BYTE (INDX-I) TO ITEM-BYTE (INDX-I2).
           IF INDX-I < 16
              SET INDX-I UP BY 1
              SET INDX-I2 UP BY 1
              GO TO 320-MOVE-CONT.
       320-SPACE-CONT.
           IF INDX-I2 < 16
              MOVE SPACE TO ITEM-BYTE (INDX-I2)
              SET INDX-I2 UP BY 1
              GO TO 320-SPACE-CONT.
       320-EXIT.
           EXIT.

       400-SETS.
           IF NAME-SW = SW-OFF
              PERFORM 410-SCAN-NAME THRU 410-EXIT
           ELSE
           IF ENTRY-SW = SW-OFF
              PERFORM 420-SCAN-ENTRY THRU 420-EXIT
           ELSE
           IF CAPACITY-SW = SW-OFF
              PERFORM 430-SCAN-CAPACITY THRU 430-EXIT
              IF CAPACITY-SW = SW-OFF
                 MOVE +1 TO CHAR-PTR
                 PERFORM 420A-ENTRIES THRU 420A-EXIT.
       400-EXIT.
           EXIT.

       410-SCAN-NAME.
           MOVE +72                  TO STRLEN-WS.
           MOVE +1                   TO STRPOS-WS.
           MOVE "NAME:"              TO PATTERN-WS.
           MOVE +5                   TO PATLEN-WS.
           MOVE ZERO                 TO TRANSLATE-WS.
           MOVE ZERO                 TO TRIM-WS.
           MOVE SPACES               TO WILD-WS.
           MOVE ZERO                 TO RESULT-WS.
           PERFORM 010-QCLSCAN THRU 010-EXIT.
           IF RESULT-WS > ZERO
              MOVE SW-ON  TO NAME-SW
              MOVE SW-OFF TO ENTRY-SW
                             CAPACITY-SW
              PERFORM 410A-GET-NAME THRU 410A-EXIT
              GO TO 410-EXIT.
           MOVE +72                  TO STRLEN-WS.
           MOVE +1                   TO STRPOS-WS.
           MOVE "N:"                 TO PATTERN-WS.
           MOVE +2                   TO PATLEN-WS.
           MOVE ZERO                 TO TRANSLATE-WS.
           MOVE ZERO                 TO TRIM-WS.
           MOVE SPACES               TO WILD-WS.
           MOVE ZERO                 TO RESULT-WS.
           PERFORM 010-QCLSCAN THRU 010-EXIT.
           IF RESULT-WS > ZERO
              MOVE SW-ON  TO NAME-SW
              MOVE SW-OFF TO ENTRY-SW
                             CAPACITY-SW
              PERFORM 410A-GET-NAME THRU 410A-EXIT.
       410-EXIT.
           EXIT.

       410A-GET-NAME.
           COMPUTE CHAR-PTR = RESULT-WS + PATLEN-WS.
           PERFORM 020-NON-BLANK THRU 020-EXIT.
           MOVE ZERO TO CHAR-CTR.
           UNSTRING STRING-WS DELIMITED BY ALL SPACES
                                       OR ","
                    INTO ITEM-WS
                         DELIMITER IN DELIM-WS
                         COUNT     IN CHAR-CTR
                    WITH POINTER CHAR-PTR.
           MOVE DATA-BASE-WS TO DSNAME.
           MOVE ITEM-WS      TO DSSET.
           READ UTFPHPDS-FILE.
           PERFORM 020-NON-BLANK THRU 020-EXIT.
           MOVE ZERO TO CHAR-CTR.
           UNSTRING STRING-WS DELIMITED BY ALL SPACES
                                       OR ";"
                                       OR "("
                    INTO ITEM-WS
                         DELIMITER IN DELIM-WS
                         COUNT     IN CHAR-CTR
                    WITH POINTER CHAR-PTR.
           MOVE ITEM-T-WS TO DSTYPE.
           MOVE ZERO      TO DESEQ.
       410A-EXIT.
           EXIT.

       420-SCAN-ENTRY.
           MOVE +72                  TO STRLEN-WS.
           MOVE +1                   TO STRPOS-WS.
           MOVE "ENTRY:"             TO PATTERN-WS.
           MOVE +6                   TO PATLEN-WS.
           MOVE ZERO                 TO TRANSLATE-WS.
           MOVE ZERO                 TO TRIM-WS.
           MOVE SPACES               TO WILD-WS.
           MOVE ZERO                 TO RESULT-WS.
           PERFORM 010-QCLSCAN THRU 010-EXIT.
           IF RESULT-WS > ZERO
              MOVE SW-ON TO ENTRY-SW
              COMPUTE CHAR-PTR = RESULT-WS + PATLEN-WS
              PERFORM 420A-ENTRIES THRU 420A-EXIT
              GO TO 420-EXIT.
           MOVE +72                  TO STRLEN-WS.
           MOVE +1                   TO STRPOS-WS.
           MOVE "E:"                 TO PATTERN-WS.
           MOVE +2                   TO PATLEN-WS.
           MOVE ZERO                 TO TRANSLATE-WS.
           MOVE ZERO                 TO TRIM-WS.
           MOVE SPACES               TO WILD-WS.
           MOVE ZERO                 TO RESULT-WS.
           PERFORM 010-QCLSCAN THRU 010-EXIT.
           IF RESULT-WS > ZERO
              MOVE SW-ON TO ENTRY-SW
              COMPUTE CHAR-PTR = RESULT-WS + PATLEN-WS
              PERFORM 420A-ENTRIES THRU 420A-EXIT.
       420-EXIT.
           EXIT.

       420A-ENTRIES.
           PERFORM 040-SCAN-COMMENT THRU 040-EXIT.
           PERFORM 020-NON-BLANK THRU 020-EXIT.
      * ONLY COMMENTS ?
           IF RESULT-WS = CHAR-PTR
              GO TO 420A-EXIT.
           MOVE ZERO TO CHAR-CTR.
           UNSTRING STRING-WS DELIMITED BY "("
                                       OR ","
                                       OR ";"
                    INTO ITEM-WS
                         DELIMITER IN DELIM-WS
                         COUNT     IN CHAR-CTR
                    WITH POINTER CHAR-PTR.
      *** EMPTY LINE ?
           IF ITEM-WS NOT = SPACES
              NEXT SENTENCE
           ELSE
              GO TO 420A-EXIT.
           MOVE DATA-BASE-WS TO DENAME.
           MOVE DSSET        TO DESET.
           ADD  +1           TO DESEQ.
           READ UTFPHPDE-FILE.
           MOVE ITEM-WS      TO DEITEM.
           IF DSTYPE NOT = "D"
              PERFORM 420C-MASTER-AUTOMATIC THRU 420C-EXIT
           ELSE
              PERFORM 420D-DETAIL THRU 420D-EXIT.
           IF UTFPHPDE-SK = ZERO
              REWRITE UTRPHPDE-RECORD
           ELSE
              WRITE UTRPHPDE-RECORD.
       420A-EXIT.
           EXIT.

       420C-MASTER-AUTOMATIC.
           IF DELIM-WS = "("
              MOVE "Y" TO DEKEYF
           ELSE
              MOVE "N" TO DEKEYF.
           MOVE SPACES TO DESORT
                          DEMSET.
       420C-EXIT.
           EXIT.

       420D-DETAIL.
           IF DELIM-WS NOT = "("
              MOVE "N" TO    DEKEYF
              MOVE SPACES TO DESORT
                             DEMSET
           ELSE
              MOVE "Y" TO DEKEYF
              UNSTRING STRING-WS DELIMITED BY "("
                                       OR ")"
                    INTO ITEM-WS
                         DELIMITER IN DELIM-WS
                         COUNT     IN CHAR-CTR
                    WITH POINTER CHAR-PTR
              PERFORM 420E-MASTER-SET THRU 420E-EXIT
              IF DELIM-WS = ")"
                 MOVE SPACES TO DESORT
              ELSE
              UNSTRING STRING-WS DELIMITED BY ")"
                    INTO ITEM-WS
                         DELIMITER IN DELIM-WS
                         COUNT     IN CHAR-CTR
                    WITH POINTER CHAR-PTR
              MOVE ITEM-WS TO DESORT.
       420D-EXIT.
           EXIT.

       420E-MASTER-SET.
           IF ITEM-T-WS NOT = "|"
              MOVE ITEM-WS      TO DEMSET
           ELSE
              MOVE ITEM-L-WS    TO DEMSET.
       420E-EXIT.
           EXIT.

       430-SCAN-CAPACITY.
           MOVE +72                  TO STRLEN-WS.
           MOVE +1                   TO STRPOS-WS.
           MOVE "CAPACITY:"          TO PATTERN-WS.
           MOVE +9                   TO PATLEN-WS.
           MOVE ZERO                 TO TRANSLATE-WS.
           MOVE ZERO                 TO TRIM-WS.
           MOVE SPACES               TO WILD-WS.
           MOVE ZERO                 TO RESULT-WS.
           PERFORM 010-QCLSCAN THRU 010-EXIT.
           IF RESULT-WS > ZERO
              MOVE SW-ON TO CAPACITY-SW
              MOVE SW-OFF TO NAME-SW
                             ENTRY-SW
              PERFORM 430A-GET-CAPACITY THRU 430A-EXIT
              GO TO 430-EXIT.
           MOVE +72                  TO STRLEN-WS.
           MOVE +1                   TO STRPOS-WS.
           MOVE "C:"                 TO PATTERN-WS.
           MOVE +2                   TO PATLEN-WS.
           MOVE ZERO                 TO TRANSLATE-WS.
           MOVE ZERO                 TO TRIM-WS.
           MOVE SPACES               TO WILD-WS.
           MOVE ZERO                 TO RESULT-WS.
           PERFORM 010-QCLSCAN THRU 010-EXIT.
           IF RESULT-WS > ZERO
              MOVE SW-ON TO CAPACITY-SW
              MOVE SW-OFF TO NAME-SW
                             ENTRY-SW
              PERFORM 430A-GET-CAPACITY THRU 430A-EXIT.
       430-EXIT.
           EXIT.

       430A-GET-CAPACITY.
           COMPUTE CHAR-PTR = RESULT-WS + PATLEN-WS.
           MOVE ZERO TO CHAR-CTR.
           PERFORM 020-NON-BLANK THRU 020-EXIT.
           UNSTRING STRING-WS DELIMITED BY ALL SPACES
                                        OR ";"
                                        OR "("
                    INTO ITEM-WS
                         DELIMITER IN DELIM-WS
                         COUNT     IN CHAR-CTR
                    WITH POINTER CHAR-PTR.
           MOVE ITEM-WS   TO NUM-X-WS.
           PERFORM 030-TRSHIFT THRU 030-EXIT.
           MOVE NUM-WS     TO DSCAP.
           IF NUM-WS > ZERO
              MOVE NUM-WS  TO DSCAP
           ELSE
              MOVE +10000  TO DSCAP.
           IF DELIM-WS = "("
              UNSTRING STRING-WS DELIMITED BY ")"
                       INTO ITEM-WS
                            DELIMITER IN DELIM-WS
                            COUNT     IN CHAR-CTR
                       WITH POINTER CHAR-PTR
              MOVE ITEM-WS   TO NUM-X-WS
              PERFORM 030-TRSHIFT THRU 030-EXIT
              COMPUTE DSCAP = DSCAP * NUM-WS.
           ADD +10 TO FILE-CTR.
           MOVE FILE-NAME TO DSSSET.
           IF UTFPHPDS-SK = ZERO
              REWRITE UTRPHPDS-RECORD
           ELSE
              WRITE UTRPHPDS-RECORD.
       430A-EXIT.
           EXIT.

       800-SCAN-BEGIN-DATA-BASE.
           MOVE +72                  TO STRLEN-WS.
           MOVE +1                   TO STRPOS-WS.
           MOVE "BEGIN DATA BASE "   TO PATTERN-WS.
           MOVE +16                  TO PATLEN-WS.
           MOVE ZERO                 TO TRANSLATE-WS.
           MOVE ZERO                 TO TRIM-WS.
           MOVE SPACES               TO WILD-WS.
           MOVE ZERO                 TO RESULT-WS.
           PERFORM 010-QCLSCAN THRU 010-EXIT.
           IF RESULT-WS > ZERO
              MOVE SW-ON TO BEGIN-DATA-BASE-SW
                            KEYWORD-SW
              COMPUTE CHAR-PTR = RESULT-WS + PATLEN-WS
              MOVE ZERO TO CHAR-CTR
              UNSTRING STRING-WS DELIMITED BY ALL SPACES
                                           OR ";"
                       INTO DATA-BASE-WS
                         DELIMITER IN DELIM-WS
                         COUNT     IN CHAR-CTR
                       WITH POINTER CHAR-PTR
              MOVE DATA-BASE-WS TO DBNAME-LS.
       800-EXIT.
           EXIT.

       810-SCAN-ITEMS.
           MOVE +72                  TO STRLEN-WS.
           MOVE +1                   TO STRPOS-WS.
           MOVE "ITEMS:"             TO PATTERN-WS.
           MOVE +6                   TO PATLEN-WS.
           MOVE ZERO                 TO TRANSLATE-WS.
           MOVE "1"                  TO TRIM-WS.
           MOVE SPACES               TO WILD-WS.
           MOVE ZERO                 TO RESULT-WS.
           PERFORM 010-QCLSCAN THRU 010-EXIT.
           IF RESULT-WS > ZERO
              MOVE SW-ON TO ITEMS-SW
                            KEYWORD-SW.
       810-EXIT.
           EXIT.

       820-SCAN-SETS.
           MOVE +72                  TO STRLEN-WS.
           MOVE +1                   TO STRPOS-WS.
           MOVE "SETS:"              TO PATTERN-WS.
           MOVE +5                   TO PATLEN-WS.
           MOVE ZERO                 TO TRANSLATE-WS.
           MOVE "1"                  TO TRIM-WS.
           MOVE SPACES               TO WILD-WS.
           MOVE ZERO                 TO RESULT-WS.
           PERFORM 010-QCLSCAN THRU 010-EXIT.
           IF RESULT-WS > ZERO
              MOVE SW-ON TO SETS-SW
                            KEYWORD-SW.
       820-EXIT.
           EXIT.

       830-SCAN-END.
           MOVE +72                  TO STRLEN-WS.
           MOVE +1                   TO STRPOS-WS.
           MOVE "END."               TO PATTERN-WS.
           MOVE +4                   TO PATLEN-WS.
           MOVE ZERO                 TO TRANSLATE-WS.
           MOVE "1"                  TO TRIM-WS.
           MOVE SPACES               TO WILD-WS.
           MOVE ZERO                 TO RESULT-WS.
           PERFORM 010-QCLSCAN THRU 010-EXIT.
           IF RESULT-WS > ZERO
              MOVE SW-ON TO END-SW.
       830-EXIT.
           EXIT.

       900-MAIN.
      * BLANK LINE ?
           IF STRING-WS = SPACES
              GO TO 900-READ-SCHEMA.
           MOVE SW-OFF TO KEYWORD-SW.
      * BEGIN DATA BASE KEYWORD FOUND ?
           IF BEGIN-DATA-BASE-SW = SW-OFF
              PERFORM 800-SCAN-BEGIN-DATA-BASE THRU 800-EXIT
           ELSE
      * ITEMS KEYWORD FOUND ?
           IF ITEMS-SW = SW-OFF
              PERFORM 810-SCAN-ITEMS THRU 810-EXIT
           ELSE
      * SETS KEYWORD FOUND ?
           IF SETS-SW = SW-OFF
              PERFORM 820-SCAN-SETS THRU 820-EXIT
           ELSE
      * END KEYWORD FOUND ?
           IF END-SW = SW-OFF
              PERFORM 830-SCAN-END THRU 830-EXIT.
      * NO KEYWORD FOUND ?
           IF KEYWORD-SW = SW-OFF
              IF END-SW = SW-OFF
                 IF SETS-SW = SW-OFF
                    IF ITEMS-SW = SW-OFF
                       NEXT SENTENCE
                    ELSE
                       PERFORM 300-ITEMS THRU 300-EXIT
                 ELSE
                    PERFORM 400-SETS THRU 400-EXIT.
       900-READ-SCHEMA.
           READ SCHEMA-FILE
                AT END
                     GO TO 900-EXIT.
           MOVE SRCDTA OF SCHEMA-RECORD TO STRING-WS.
       900-EXIT.
           EXIT.

       999-EOJ.
           CLOSE SCHEMA-FILE
                 UTFPHPDI-FILE
                 UTFPHPDS-FILE
                 UTFPHPDE-FILE.
       999-EXIT.
           EXIT.
