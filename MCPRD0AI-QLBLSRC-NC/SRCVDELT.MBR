000900***************************************************************
001000*                                                             *
001100*   S R C V D E L T                                           *
001200*                                                             *
001300*    THIS SUB PROGRAM DELETES ALL RECEIVEING SLIP ITEM        *
001400*    ENTRIES FOR A PO ITEM PASSED.  IF THE ITEM DELETED IS    *
001500*    THE ONLY ITEM ON THE RECEIVEING SLIP THEN THE ENTIRE     *
001600*    RECEIVING SLIP IS DELETED.                               *
001700***************************************************************
      *C 06/12/96   JEFF BUNGO
      *C   EXPAND DATE FIELDS FOR YEAR 2000 COMPLIANCE.
      *C   RECOMPILE PROGRAM TO PICK UP NEW FILE FORMATS.
001700***************************************************************
001800
001900 ENVIRONMENT DIVISION.
002000 CONFIGURATION SECTION.
002100 SOURCE-COMPUTER.  HP-3000.
002200 OBJECT-COMPUTER.  HP-3000.
       SPECIAL-NAMES.  I-O-FEEDBACK IS I-O-FEEDBACK-AREA.
009100
009200 INPUT-OUTPUT SECTION.
       FILE-CONTROL.
009300
           SELECT MPORCV-O
                  ASSIGN TO DATABASE-MCFLCS0101
                  ORGANIZATION IS INDEXED
                    ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                  FILE STATUS IS FILE-STATUS.
003500
           SELECT DRCVITEM-O
                  ASSIGN TO DATABASE-MCFLCS1201
                  ORGANIZATION IS INDEXED
                    ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                    WITH DUPLICATES
                  FILE STATUS IS FILE-STATUS.

           SELECT DPODATAITM-O
                  ASSIGN TO DATABASE-MCFLCS1101
                  ORGANIZATION IS INDEXED
                    ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                    WITH DUPLICATES
                  FILE STATUS IS FILE-STATUS.

           SELECT DTALLY-O
                  ASSIGN TO DATABASE-MCFLCS4702
                  ORGANIZATION IS INDEXED
                    ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                    WITH DUPLICATES
                  FILE STATUS IS FILE-STATUS.

           SELECT DRAWLOT-O
                  ASSIGN TO DATABASE-MCFLCS4602
                  ORGANIZATION IS INDEXED
                    ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                    WITH DUPLICATES
                  FILE STATUS IS FILE-STATUS.

           SELECT DPOFREIGHT-O
                  ASSIGN TO DATABASE-MCFLCS2401
                  ORGANIZATION IS INDEXED
                    ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                    WITH DUPLICATES
                  FILE STATUS IS FILE-STATUS.

       DATA DIVISION.
       FILE SECTION.
       FD  MPORCV-O
           LABEL RECORDS ARE STANDARD.
       01  MPORCV-REC-O.
           COPY DDS-ALL-FORMATS  OF MCFLCS0101.

       FD  DRCVITEM-O
           LABEL RECORDS ARE STANDARD.
       01  DRCVITEM-REC-O.
           COPY DDS-ALL-FORMATS  OF MCFLCS1201.

       FD  DPODATAITM-O
           LABEL RECORDS ARE STANDARD.
       01  DPODATAITM-REC-O.
           COPY DDS-ALL-FORMATS  OF MCFLCS1101.

       FD  DTALLY-O
           LABEL RECORDS ARE STANDARD.
       01  DTALLY-REC-O.
           COPY DDS-ALL-FORMATS  OF MCFLCS4702.

       FD  DRAWLOT-O
           LABEL RECORDS ARE STANDARD.
       01  DRAWLOT-REC-O.
           COPY DDS-ALL-FORMATS  OF MCFLCS4602.

       FD  DPOFREIGHT-O
           LABEL RECORDS ARE STANDARD.
       01  DPOFREIGHT-REC-O.
           COPY DDS-ALL-FORMATS  OF MCFLCS2401.

       WORKING-STORAGE SECTION.
       01  FILE-STATUS.
           05  FILE-STATUS-1            PIC X  VALUE "0".
           05  FILE-STATUS-2            PIC X  VALUE "0".
009700
002700 77  SAVE-LAST-RCVR               PIC 9(3)  VALUE ZEROS.
