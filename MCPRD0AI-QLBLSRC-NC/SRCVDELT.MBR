010700 SRCVDELT SECTION 02.
010800
010900 BEGIN-HERE.
           OPEN I-O DRCVITEM-O, DPODATAITM-O, DTALLY-O, DRAWLOT-O,
                    DPOFREIGHT-O, MPORCV-O.

011000     PERFORM 6-MAIN THRU 6-M-X.
011100
           CLOSE DRCVITEM-O, DPODATAITM-O, DTALLY-O, DRAWLOT-O,
                 DPOFREIGHT-O, MPORCV-O.
011200     GOBACK.
011300
011400
011500******************************************************
011600**                                                  **
011700**   BLOWUP ROUTINE                                 **
011800**                                                  **
011900******************************************************
012000
012100 2-BLOWUP.
012200     MOVE RCVR-ARG                TO BU-DISPLAY-FLD (4).
012300     MOVE "SRCVDELT"              TO BU-DISPLAY-FLD (5).
012400     GOBACK.
012500
012600
012700 6-MAIN.
012800     MOVE SRCVDELT-PO-NUMBER      TO PO-ARG,
012900                                     RCVR-ARG.
           MOVE 0 TO COND-WORD.
           MOVE PO-ARG TO PORCVNO OF MPORCV-REC-O.
           READ MPORCV-O INTO BUF-MPORCV
               INVALID KEY MOVE 17 TO COND-WORD.
           IF FILE-STATUS-1 = "2"
               MOVE 17 TO COND-WORD
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD.
013000*A   CALL "DBGET" USING BASE, DSET-MPORCV, MODE7,
013100*A       STATUS-AREA, ALL-ITEMS, BUF-MPORCV, PO-ARG.
013200     IF COND-WORD NOT = 0
013300         MOVE "GET MPORCV*6-M" TO BU-DISPLAY-MSG
013400         GO TO 2-BLOWUP.
013500
013600     IF M-PO-LAST-RCVR-X NUMERIC
013700         MOVE M-PO-LAST-RCVR    TO  SAVE-LAST-RCVR
013800         PERFORM 60-DELETE-RCVR-ITEM  THRU 60-DRI-X
013900             UNTIL SAVE-LAST-RCVR = RCVR-PO-RCVR.
014100
014200 6-M-X.
014300     EXIT.
014400
014500**************************************************
014600**
014700**
014800**
014900**************************************************
015000
015100 60-DELETE-RCVR-ITEM.
015200     ADD 1                        TO RCVR-PO-RCVR.
015300
           MOVE 0 TO COND-WORD.
           MOVE RCVR-ARG TO PORCVNO OF DRCVITEM-REC-O.
           START DRCVITEM-O KEY = PORCVNO OF DRCVITEM-REC-O
               INVALID KEY MOVE 17 TO COND-WORD.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
                   MOVE 17 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.
015400*A   CALL "DBFIND" USING BASE, DSET-DRCVITEM, MODE1,
015500*A       STATUS-AREA, PO-SEARCH, RCVR-ARG.
015600     IF COND-WORD NOT = 0
015700         IF COND-WORD = 17
015800             NEXT SENTENCE
015900         ELSE
016000             MOVE "FIND DRCVITEM * 60-DRI" TO BU-DISPLAY-MSG
016100             GO TO 2-BLOWUP
016200     ELSE
016300         MOVE SPACES              TO RCV-ITEM-NUMBER
016400         PERFORM 61-GET-DRCVITEM THRU 61-GD-X
016500             UNTIL END-OF-CHAIN OR
016600                   SRCVDELT-ITEM-NUMBER = RCV-ITEM-NUMBER.
016700
016800 60-DRI-X.
016900     EXIT.
017000
017100 61-GET-DRCVITEM.
           MOVE 0 TO COND-WORD.
           READ DRCVITEM-O NEXT INTO BUF-DRCVITEM
               AT END MOVE 15 TO COND-WORD.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   MOVE 15 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.
           IF PORCVNO OF DRCVITEM-REC-O NOT = RCVR-ARG
               MOVE 15 TO COND-WORD.
017200*A   CALL "DBGET" USING BASE, DSET-DRCVITEM, MODE5,
017300*A       STATUS-AREA, ALL-ITEMS, BUF-DRCVITEM, RCVR-ARG.
017400     IF COND-WORD NOT = 0
017500         IF COND-WORD = 15
017600             NEXT SENTENCE
017700         ELSE
017800             MOVE "GET DRCVITEM * 61-GD" TO BU-DISPLAY-MSG
017900             GO TO 2-BLOWUP
018000     ELSE
018100         IF RCV-ITEM-NUMBER = SRCVDELT-ITEM-NUMBER
018200             PERFORM 611-DELETE-DRCVITEM
018300             PERFORM 612-DELETE-DPODATAITM  THRU 612-DD-X
018400             PERFORM 613-DELETE-DTALLY  THRU 613-DD-X
018500             PERFORM 614-DELETE-DRAWLOT  THRU 614-DD-X
018600             PERFORM 62-CHECK-FOR-RCVR-ITEMS  THRU 62-CFRI-X.
018700
018800 61-GD-X.
018900     EXIT.
019000
019100
