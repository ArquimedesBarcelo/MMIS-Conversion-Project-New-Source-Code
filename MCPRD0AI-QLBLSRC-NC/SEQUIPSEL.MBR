       IDENTIFICATION DIVISION.

       PROGRAM-ID.     SEQUIPSEL.
       AUTHOR.         EXLTECH, LLC - DAN RAUCH

      ***************************************************************
      **     MMIS  EQUIPMENT SELECTION PROGRAM
      ***************************************************************
      ** NOTE:  THIS PROGRAM USES A FORWARD LOADING SUBFILE
      **        OS400 HANDLES THE BACKWARD PAGING
      ***************************************************************

      *================================================================
       ENVIRONMENT DIVISION.
      *===============================================================
       CONFIGURATION SECTION.

       SOURCE-COMPUTER.       IBM-AS400.
       OBJECT-COMPUTER.       IBM-AS400.
       SPECIAL-NAMES.         LOCAL-DATA LDA.

       INPUT-OUTPUT SECTION.
       FILE-CONTROL.

           SELECT DISPLAY-FILE  ASSIGN TO WORKSTATION-ZEQUIPSEL-SI
                  ORGANIZATION IS TRANSACTION
                  ACCESS IS DYNAMIC
                  FILE STATUS IS WS-FILE-STATUS
                  RELATIVE KEY IS WS-RRN
                  CONTROL-AREA IS WS-KEYBOARD-RETURN-AREA.

           SELECT EQUIPMENT-FILE ASSIGN TO DATABASE-MCFLMM0201
                  ORGANIZATION IS INDEXED
                  ACCESS IS DYNAMIC
                  FILE STATUS IS WS-FILE-STATUS
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY.

      *================================================================
       DATA DIVISION.
      *================================================================
       FILE SECTION.

       FD  DISPLAY-FILE.
       01  DISPLAY-REC.
       COPY DDS-ALL-FORMATS OF ZEQUIPSEL.

       FD  EQUIPMENT-FILE.
       01  EQUIPMENT-REC.
       COPY DDS-ALL-FORMATS OF MCFLMM0201.

      *----------------------------------------------------------------
       WORKING-STORAGE SECTION.
      *----------------------------------------------------------------
       01  WS-PGM-VERSION          PIC X(13)  VALUE "SEQUIPSELV01".

       COPY FILESTATUS IN COPYLIB.
       COPY KEYBDRTN    IN COPYLIB.

      *****************************************************************
      *  ALL PROGRAM INDICATORS
      *****************************************************************
       01  WS-ALL-INDICATORS.
      **** 03  IN83              PIC 1   INDIC 83   VALUE B"0".
      ****     88  SFLEND-OFF                       VALUE B"0".
      ****     88  SFLEND-ON                        VALUE B"1".

           03  IN84              PIC 1   INDIC 84   VALUE B"0".
               88  SFL-CLEAR-OFF                    VALUE B"0".
               88  SFL-CLEAR-ON                     VALUE B"1".

           03  IN85              PIC 1   INDIC 85   VALUE B"0".
               88  SFL-DISPLAY-OFF                  VALUE B"0".
               88  SFL-DISPLAY-ON                   VALUE B"1".

           03  IN86              PIC 1   INDIC 86   VALUE B"0".
               88  SFLNXTCHG-OFF                    VALUE B"0".
               88  SFLNXTCHG-ON                     VALUE B"1".

           03  IN91              PIC 1   INDIC 91   VALUE B"0".
               88  SFL-PAGE-FWD                     VALUE B"1".

       01  WS-ALL-SCREEN-FIELDS.
            03  WS-H01-FLDS.
                05  VERSION           PIC X(15)          VALUE SPACE.

            03  WS-B01-FLDS.
                05  MSSG              PIC X(65)          VALUE SPACE.
                05  PGMSG             PIC X(10)          VALUE SPACE.

            03  WS-CTL01-FLDS.
                05  CRRN              PIC S9(04)         VALUE +0.
                05  CREC              PIC X(10)          VALUE SPACE.
                05  CFLD              PIC X(10)          VALUE SPACE.
                05  CEQNBR            PIC X(06)          VALUE SPACE.

            03  WS-SFL01-FLDS.
                05  SEL               PIC X(01)          VALUE SPACE.
                05  SFEQNBR           PIC X(06)          VALUE SPACE.
                05  SFEQDSC           PIC X(40)          VALUE SPACE.
                05  SFEQLOC           PIC X(08)          VALUE SPACE.

      *****************************************************************
      *  PROGRAM MESSAGES
      *****************************************************************
       01  WS-PROGRAM-MESSAGES.
           03  WS-NORECS-MSSG       PIC  X(79)         VALUE
               "No Equipment Data Found for Search Criteria Entered".
           03  WS-SELECT-MSSG       PIC  X(79)         VALUE
               "Make Your Selection(X) and Press <ENTER> to Return".

           03  WS-1ST-PAGE          PIC  X(10)         VALUE
               "1st Page  ".
           03  WS-NXT-PAGE          PIC  X(10)         VALUE
               "*More     ".
           03  WS-LST-PAGE          PIC  X(10)         VALUE
               "Last Page ".
           03  WS-ONE-PAGE          PIC  X(10)         VALUE
               "Only Page ".
      *****************************************************************
      *  MISCELLANEOUS WORK FIELDS
      *****************************************************************
       01  WS-MISCELLANEOUS-FIELDS.

           03  WS-RRN            PIC  9(05)         VALUE ZERO.
           03  WS-RRN1           PIC  9(05)         VALUE ZERO.

           03  WS-EQUIP-NBR      PIC  X(06)         VALUE SPACE.
           03  WS-START-KEY      PIC  X(06)         VALUE SPACE.
           03  WS-SFL-CNT        PIC  9(05)         VALUE ZERO.
           03  WS-PAGE-CNT       PIC  9(05)         VALUE ZERO.
           03  WS-PAGE-RRN       PIC  9(05)         VALUE ZERO.
           03  WS-SFLPAGE-MAXX   PIC  9(05)         VALUE 15.

           03  WS-SELECTION-SW   PIC  X(01)         VALUE SPACE.
               88  SELECTION-WAS-MADE-NO            VALUE "N".
               88  SELECTION-WAS-MADE-YES           VALUE "Y".

           03  WS-LAST-PAGE-SW   PIC  X(01)         VALUE SPACE.
               88  LAST-PAGE-NO                     VALUE "N".
               88  LAST-PAGE-YES                    VALUE "Y".

      *================================================================
      *=             L I N K A G E    S E C T I O N
      *================================================================
       LINKAGE SECTION.
       01  LS-EQUIPMENT-NBR        PIC X(06).

      *================================================================
      *=             P R O C E D U R E    D I V I S I O N
      *================================================================
       PROCEDURE DIVISION  USING LS-EQUIPMENT-NBR.
       0000-PROGRAM-ENTRY.

           OPEN  I-O    DISPLAY-FILE
                 INPUT  EQUIPMENT-FILE.

      *----------------------------------------------------------------
      ** DISPLAY EQUIPMENT DESCRIPTIONS FOR SELECTION
      *----------------------------------------------------------------
           PERFORM 0010-INITIALIZE       THRU 0010-EXIT.

           PERFORM 1000-MAIN-LOGIC       THRU 1000-EXIT.

           PERFORM 0099-EOJ-RTN          THRU 0099-EXIT.

           CLOSE        DISPLAY-FILE
                        EQUIPMENT-FILE.

       0000-PROGRAM-END.
           GOBACK.

      *****************************************************************
      ** 1ST TIME PROCESSING ROUTINE
      *****************************************************************
       0010-INITIALIZE.

           SET  SELECTION-WAS-MADE-NO   TO TRUE.

           MOVE  SPACE        TO LS-EQUIPMENT-NBR.

           MOVE LOW-VALUES           TO WS-START-KEY.
           MOVE SPACE                TO CEQNBR  OF WS-CTL01-FLDS.
           PERFORM 1999-LOAD-SFL01       THRU 1999-EXIT.

       0010-EXIT.
            EXIT.

      *****************************************************************
      ** END OF JOB PROCESSING
      *****************************************************************
       0099-EOJ-RTN.

           IF  SELECTION-WAS-MADE-YES
               MOVE  WS-EQUIP-NBR TO LS-EQUIPMENT-NBR
           END-IF.

       0099-EXIT.
            EXIT.

      *****************************************************************
      ***  MAIN PROCESSING LOOP ROUTINE
      *****************************************************************
       1000-MAIN-LOGIC.

           PERFORM 8000-DISPLAY-SCREEN-1  THRU 8000-DSP-EXIT.
           IF  KB-F03-KEY
               GO TO 1000-EXIT
           END-IF.

      ***  CHECK THE SFL FOR USER ENTRY
           IF  WS-RRN1 > ZERO
               PERFORM 1100-CHECK-SFL01       THRU 1100-EXIT
               IF  SELECTION-WAS-MADE-YES
                   GO TO 1000-EXIT
               END-IF
           END-IF.

           IF  SFL-PAGE-FWD

               IF  LAST-PAGE-YES
                   GO TO 1000-REDISPLAY
               END-IF

           END-IF.

           PERFORM 1999-LOAD-SFL01       THRU 1999-EXIT.

       1000-REDISPLAY.

           GO TO 1000-MAIN-LOGIC.

       1000-EXIT.
            EXIT.

      *****************************************************************
      ***  CHECK SFL01 FOR USER SELECTION
      *****************************************************************
       1100-CHECK-SFL01.

           SET  SELECTION-WAS-MADE-NO   TO TRUE.
           MOVE SPACE            TO WS-EQUIP-NBR.

       1100-READN-SFL01.

           PERFORM 8000-READN-SFL01      THRU 8000-READN-EXIT.
           IF  FS-END-OF-FILE
               GO TO 1100-EXIT
           END-IF.

      ***  ACCEPT THE 1ST "X" AND BAIL OUT
           IF  SEL  OF WS-SFL01-FLDS  = "X"
               SET  SELECTION-WAS-MADE-YES  TO TRUE
               MOVE SFEQNBR OF WS-SFL01-FLDS  TO WS-EQUIP-NBR
               GO TO 1100-EXIT
           END-IF.

           SET  SFLNXTCHG-OFF    TO TRUE.
           MOVE SPACE            TO SEL  OF WS-SFL01-FLDS.
           PERFORM 8000-REWRT-SFL01      THRU 8000-REWRT-EXIT.

           GO TO 1100-READN-SFL01.

       1100-EXIT.
           EXIT.

      *****************************************************************
      ***  CLEAR SFL01
      *****************************************************************
       1998-CLEAR-SFL01.

           INITIALIZE  WS-SFL01-FLDS.
           MOVE ZERO             TO WS-RRN
                                    WS-RRN1
                                    WS-PAGE-CNT
                                    WS-PAGE-RRN.

           MOVE 1                TO CRRN  OF WS-CTL01-FLDS.
           MOVE SPACE            TO PGMSG   OF WS-B01-FLDS.

           SET  SFL-DISPLAY-OFF  TO TRUE.

           SET  SFL-CLEAR-ON     TO TRUE.
           PERFORM 8000-WRITE-CTL01      THRU 8000-WRTCR-EXIT.
           SET  SFL-CLEAR-OFF    TO TRUE.

      **** SET  SFLEND-ON        TO TRUE.

       1998-EXIT.
            EXIT.

      *****************************************************************
      ***  LOAD  SFL01
      *****************************************************************
       1999-LOAD-SFL01.

           IF  SFL-PAGE-FWD
               GO TO 1999-LOAD-INIT
           END-IF.

           IF  WS-START-KEY = CEQNBR  OF WS-CTL01-FLDS
               GO TO 1999-EXIT
           END-IF.

           PERFORM 1998-CLEAR-SFL01      THRU 1998-EXIT.

           MOVE CEQNBR  OF WS-CTL01-FLDS TO WS-START-KEY.
           PERFORM 9000-START-EQUIPMENT-FILE THRU 9000-START-EXIT.

       1999-LOAD-INIT.

           MOVE ZERO             TO WS-SFL-CNT.

       1999-LOAD-LOOP.

           PERFORM 9000-READN-EQUIPMENT-FILE  THRU 9000-READN-EXIT.
           IF  FS-END-OF-FILE
               IF  WS-SFL-CNT  > ZERO
                   PERFORM 1999A-SET-PAGE-DISPLAY THRU 1999A-SPD-EXIT
               END-IF
               GO TO 1999-EXIT
           END-IF.

           SET  SFLNXTCHG-OFF    TO TRUE.

           MOVE SPACE                    TO SEL      OF WS-SFL01-FLDS.
           MOVE EQPNUM OF EQUIPMENT-REC  TO SFEQNBR  OF WS-SFL01-FLDS.
           MOVE EQPNAME OF EQUIPMENT-REC TO SFEQDSC  OF WS-SFL01-FLDS.
           MOVE EQPLOC  OF EQUIPMENT-REC TO SFEQLOC  OF WS-SFL01-FLDS.

           ADD  1                  TO WS-RRN  WS-SFL-CNT.
           PERFORM 8000-WRITE-SFL01  THRU 8000-WRITE-EXIT.

           IF  WS-SFL-CNT  = WS-SFLPAGE-MAXX
               PERFORM 1999A-SET-PAGE-DISPLAY THRU 1999A-SPD-EXIT
               GO TO 1999-EXIT
           END-IF.

           GO TO 1999-LOAD-LOOP.

       1999-EXIT.
            EXIT.
      *****************************************************************
      ***  SET PAGE DISPLAY
      *****************************************************************
       1999A-SET-PAGE-DISPLAY.

            ADD  1              TO WS-PAGE-CNT
            IF  WS-PAGE-CNT > 1
                COMPUTE WS-PAGE-RRN =
                      ((WS-PAGE-CNT - 1) * WS-SFLPAGE-MAXX)
            END-IF.

            ADD  1              TO WS-PAGE-RRN.
            PERFORM 2000-CHECK-MORE   THRU 2000-EXIT.

       1999A-SPD-EXIT.
              EXIT.
      *****************************************************************
      ***  SET THE PAGING MSG
      *****************************************************************
       2000-CHECK-MORE.

           SET  LAST-PAGE-NO   TO TRUE.
           MOVE SPACE          TO PGMSG   OF WS-B01-FLDS.
           MOVE LOW-VALUES     TO WS-START-KEY.

      ***  END OF FILE COMING IN HERE
           IF FS-END-OF-FILE

              IF WS-PAGE-CNT = 1
                 MOVE WS-ONE-PAGE    TO PGMSG   OF WS-B01-FLDS
                 SET  LAST-PAGE-YES  TO TRUE
              END-IF

              IF WS-PAGE-CNT > 1
                 MOVE WS-LST-PAGE    TO PGMSG   OF WS-B01-FLDS
                 SET  LAST-PAGE-YES  TO TRUE
              END-IF

              GO TO 2000-EXIT
           END-IF.

      ***  CHECK TO SEE IF THERE IS ONE MORE RECORD
           PERFORM 9000-READN-EQUIPMENT-FILE  THRU 9000-READN-EXIT.
           IF FS-GOOD-FILE-IO

      ***  DISPLAY 1ST PAGE MSG
              IF WS-PAGE-CNT = 1
                 MOVE WS-1ST-PAGE    TO PGMSG   OF WS-B01-FLDS
              END-IF

      ***  DISPLAY *MORE MSG
              IF WS-PAGE-CNT > 1
                 MOVE WS-NXT-PAGE    TO PGMSG   OF WS-B01-FLDS
              END-IF

      ***  RESET THE FILE POINTER BACK TO PRIOR RECORD
           PERFORM 9000-READP-EQUIPMENT-FILE  THRU 9000-READP-EXIT
           GO TO 2000-EXIT
           END-IF.


      ***  END OF FILE
           IF FS-END-OF-FILE

      ***  END OF FILE AND ONE PAGE OR LESS HAS BEEN BUILT
      ***  DISPLAY ONLY PAGE MSG
              IF WS-PAGE-CNT = 1
                 MOVE WS-ONE-PAGE    TO PGMSG   OF WS-B01-FLDS
              SET  LAST-PAGE-YES  TO TRUE
              END-IF

      ***  END OF FILE AND MORE THAN ONE PAGE WAS BUILT
      ***  DISPLAY LAST PAGE MSG
              IF WS-PAGE-CNT > 1
                 MOVE WS-LST-PAGE    TO PGMSG   OF WS-B01-FLDS
              SET  LAST-PAGE-YES  TO TRUE
              END-IF

           END-IF.


       2000-EXIT.
            EXIT.
      *****************************************************************
      ** DISPLAY SCREEN 1 - LIST EQUIP DESCS
      *****************************************************************
       8000-DISPLAY-SCREEN-1.

           MOVE WS-PGM-VERSION     TO VERSION OF WS-H01-FLDS.
           MOVE "-S1"              TO VERSION OF WS-H01-FLDS(13:3).

           MOVE CORR WS-H01-FLDS   TO H01-O.
           WRITE DISPLAY-REC  FORMAT "H01"
           END-WRITE.

           IF  WS-RRN1 = ZERO
               MOVE  WS-NORECS-MSSG  TO  MSSG  OF WS-B01-FLDS
           END-IF.

           IF  WS-RRN1 > ZERO
               SET  SFL-DISPLAY-ON   TO TRUE
               MOVE  WS-SELECT-MSSG  TO  MSSG  OF WS-B01-FLDS
           END-IF.

           MOVE CORR WS-B01-FLDS   TO B01-O.
           WRITE DISPLAY-REC  FORMAT "B01"
                 INDICATORS ARE WS-ALL-INDICATORS
           END-WRITE.

           MOVE WS-PAGE-RRN TO CRRN  OF WS-CTL01-FLDS.
           MOVE CORR WS-CTL01-FLDS  TO CTL01-O.
           WRITE DISPLAY-REC  FORMAT "CTL01"
                 INDICATORS ARE WS-ALL-INDICATORS
           END-WRITE.


           READ  DISPLAY-FILE  FORMAT "CTL01"
                 INDICATORS ARE WS-ALL-INDICATORS
           END-READ.
           MOVE CORR CTL01-I     TO WS-CTL01-FLDS.

           MOVE  SPACE           TO  MSSG  OF WS-B01-FLDS.

       8000-DSP-EXIT.
            EXIT.

      *****************************************************************
      *** CTL01 WRITE CONTROL RECORD
      *****************************************************************
       8000-WRITE-CTL01.

           WRITE DISPLAY-REC  FORMAT "CTL01"
                 INDICATORS ARE WS-ALL-INDICATORS
           END-WRITE.

       8000-WRTCR-EXIT.
            EXIT.
      *****************************************************************
      *** SFL01 READ NEXT MODIFIED RECORD
      *****************************************************************
       8000-READN-SFL01.

           READ SUBFILE DISPLAY-FILE
                NEXT MODIFIED RECORD FORMAT IS "SFL01"
                     INDICATORS ARE WS-ALL-INDICATORS
           END-READ.

           IF FS-GOOD-FILE-IO
               MOVE CORR SFL01-I   TO WS-SFL01-FLDS
           END-IF.

           MOVE WS-RRN              TO WS-RRN1.

       8000-READN-EXIT.
            EXIT.
      *****************************************************************
      *** SFL01 WRITE SUBFILE RECORD
      *****************************************************************
       8000-WRITE-SFL01.

           MOVE CORR WS-SFL01-FLDS  TO SFL01-O.
           WRITE SUBFILE DISPLAY-REC  FORMAT "SFL01"
                         INDICATORS ARE WS-ALL-INDICATORS
           END-WRITE.

           MOVE WS-RRN              TO WS-RRN1.

       8000-WRITE-EXIT.
            EXIT.

      *****************************************************************
      *** SFL01 REWRITE SUBFILE RECORD
      *****************************************************************
       8000-REWRT-SFL01.

           MOVE CORR WS-SFL01-FLDS  TO SFL01-O.
           REWRITE SUBFILE DISPLAY-REC  FORMAT "SFL01"
                         INDICATORS ARE WS-ALL-INDICATORS
           END-REWRITE.

       8000-REWRT-EXIT.
            EXIT.

      *----------------------------------------------------------------
      *
      *            ALL DATABASE FILE I-O'S BELOW THIS POINT
      *
      *----------------------------------------------------------------

      *****************************************************************
      *** START EQUIPMENT-FILE
      *****************************************************************
       9000-START-EQUIPMENT-FILE.

           INITIALIZE  EQUIPMENT-REC.
           MOVE WS-START-KEY        TO EQPNUM  OF EQUIPMENT-REC.

           START EQUIPMENT-FILE
                 KEY IS >= EXTERNALLY-DESCRIBED-KEY
           END-START.

       9000-START-EXIT.
            EXIT.

      *****************************************************************
      *** READ EQUIPMENT FILE SEQUENTIALLY FWD
      *****************************************************************
       9000-READN-EQUIPMENT-FILE.

           READ  EQUIPMENT-FILE  NEXT RECORD
           END-READ.

       9000-READN-EXIT.
            EXIT.

      *****************************************************************
      *** READ EQUIPMENT-FILE SEQUENTIALLY BACKWARDS
      *****************************************************************
       9000-READP-EQUIPMENT-FILE.

           READ  EQUIPMENT-FILE  PRIOR RECORD
           END-READ.

       9000-READP-EXIT.
            EXIT.

      *****************************************************************
      ***              END  OF  SOURCE  MEMBER
      *****************************************************************
