068300 723-END-CLASS.
068400     COMPUTE ROUNDED-BEG-DOLLARS ROUNDED = CLASS-BEG-DOLLARS
068500                                            * 1.
068600     MOVE ROUNDED-BEG-DOLLARS     TO PRT-BEG-BAL.
068700     COMPUTE ROUNDED-RCPT-DOLLARS ROUNDED = CLASS-RCPT-DOLLARS
068800                                            * 1.
068900     MOVE ROUNDED-RCPT-DOLLARS    TO PRT-RCPTS.
069000     COMPUTE ROUNDED-DCHG-DOLLARS ROUNDED = CLASS-DCHG-DOLLARS
069100                                            * 1
069200     MOVE ROUNDED-DCHG-DOLLARS    TO PRT-DIR-CHG-DR
069300                                     PRT-DIR-CHG-CR.
069400     COMPUTE ROUNDED-OPEN-RCVR-DOLLARS ROUNDED =
069500         CLASS-OPEN-RCVR-DOLLARS * 1.
069600     MOVE ROUNDED-OPEN-RCVR-DOLLARS  TO PRT-OPEN-RCVR-DR.
069700     COMPUTE ROUNDED-INV-DLRS-ONDOCK  ROUNDED =
069800         CLASS-INV-DLRS-ONDOCK - CLASS-ONDOCK-CARRY-DOLLARS.
069900     MOVE ROUNDED-INV-DLRS-ONDOCK TO PRT-INV-DLRS-ONDOCK.
070000     COMPUTE CLASS-TOT-DEBITS = ROUNDED-RCPT-DOLLARS +
070100                                ROUNDED-DCHG-DOLLARS +
070200                                ROUNDED-OPEN-RCVR-DOLLARS.
070300     MOVE CLASS-TOT-DEBITS        TO PRT-TOT-DR.
070400     COMPUTE ROUNDED-ISS-DOLLARS ROUNDED = CLASS-ISS-DOLLARS * 1.
070500     MOVE ROUNDED-ISS-DOLLARS     TO PRT-ISSUES.
070600     COMPUTE ROUNDED-ADJ-DOLLARS-CR ROUNDED =
070700                    CLASS-ADJ-DOLLARS-CR * -1.
070800     COMPUTE ROUNDED-ADJ-DOLLARS-DR ROUNDED =
070900                     CLASS-ADJ-DOLLARS-DR * 1.
071000     COMPUTE ROUNDED-ADJ-DOLLARS-CR = ROUNDED-ADJ-DOLLARS-CR -
071100                                      ROUNDED-ADJ-DOLLARS-DR.
071200     MOVE ROUNDED-ADJ-DOLLARS-CR  TO PRT-ADJ-CR.
071300     COMPUTE CLASS-TOT-CREDITS = ROUNDED-DCHG-DOLLARS +
071400                                 ROUNDED-ISS-DOLLARS +
071500                                 ROUNDED-ADJ-DOLLARS-CR.
071600     MOVE CLASS-TOT-CREDITS       TO PRT-TOT-CR.
071700     COMPUTE CLASS-END-DOLLARS = ROUNDED-BEG-DOLLARS +
071800                                 CLASS-TOT-DEBITS -
071900                                 CLASS-TOT-CREDITS.
072000     MOVE CLASS-END-DOLLARS       TO PRT-END-BAL.
072100     COMPUTE ROUNDED-INTRANSIT-DOLLARS ROUNDED =
072200         CLASS-INTRANSIT-DOLLARS * 1.
072300     MOVE ROUNDED-INTRANSIT-DOLLARS TO PRT-INTRANSIT-DOLLARS
072400     COMPUTE ROUNDED-TOTAL-ONDOCK ROUNDED =
072500         CLASS-INV-DLRS-ONDOCK * 1.
072600     MOVE ROUNDED-TOTAL-ONDOCK    TO PRT-TOTAL-ONDOCK.
           COMPUTE ROUNDED-FRAN-ISS-DOLLARS ROUNDED =
                      CLASS-FRAN-ISS-DOLLARS * 1.
           MOVE ROUNDED-FRAN-ISS-DOLLARS TO PRT-FRAN-ISSUES.
072700
