083000 900-ERROR SECTION.
083100
083200 990-BLOWUP.
083300
083400***************************************************************
083500**   CALL 'CBLOWSRT' INSTEAD OF 'TBLOWUP' WHEN A BLOWUP      **
083600**   SITUATION OCCURS SINCE THIS PROGRAM USES THE 'SORT'     **
083700**   VERB.  'CBLOWSRT' WRITES ALL THE BLOWUP INFORMATION     **
083800**   TO A TEMPORARY FILE 'BLUPDATA' (WHICH WAS OPENED AT     **
083900**   THE BEGINNING OF THE PROGRAM) THE CLOSES IT. THEN IT    **
084000**   CREATESA A SON PROCESS 'XBLOWSRT' THAT READS THE        **
084100**   BLOWUP INFORMATION OUT OF 'BLUPDATA' AND CALLS          **
084200**   'TBLOWUP' USING THIS INFO.  SINCE THE NEW PROCESS       **
084300**   'XBLOWSRT' HAS ITS OWN STACK THE STACK OVERFLOW         **
084400**   PROBLEM IS AVOIDED.                                     **
084500***************************************************************
084600
084700     MOVE "TMOVERPT"              TO  BU-PGM-NAME.
084800     CALL "CBLOWSRT" USING CBLOWSRT-PARMS,
084900                           ACCTG-BASE,
085000                           BU-PGM-NAME,
085100                           STATUS-AREA,
085200                           DUMMY-VIEW-AREA,
085300                           FILE-STATUS,
085400                           BU-DISPLAY-MSG,
085500                           BU-DISPLAY-FLDS.
085600
085700
085800
085900
086000 1000-CLOSE-FILES.
086100     CLOSE ONLINE-PRT.
           CLOSE CLASS-EXT.
           PERFORM 9999-CLOSE-STUFF.


       9930-LOCK.

       9940-UNLOCK.

       9999-DBGET2-MMATL-ACCUM-MC-O.
           MOVE 0 TO COND-WORD.
           READ MMATL-ACCUM-MC-O NEXT INTO BUF-MATLACUM
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS-1 = "1" OR FILE-STATUS = "46"
               MOVE 11 TO COND-WORD
           ELSE
               IF FILE-STATUS NOT = "00"
                   MOVE 99 TO COND-WORD.

       9999-INIT-MMATL-ACCUM-MC-O.
           MOVE SPACES TO MATLCODE OF MMATL-ACCUM-MC-REC-O.
           START MMATL-ACCUM-MC-O KEY >= MATLCODE OF MMATL-ACCUM-MC-O
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.

       9999-DBUPDATE-MMATL-ACCUM-MC-O.
           MOVE 0 TO COND-WORD.
           REWRITE MMATL-ACCUM-MC-REC-O FROM BUF-MATLACUM
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD.

       9999-DBGET7-MCLASS-CL-O.
           MOVE 0 TO COND-WORD.
           MOVE CLASS-ARG TO ACTGCLASS OF MCLASS-CL-REC-O.
           READ MCLASS-CL-O INTO BUF-MCLASS
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS = "23"
               MOVE 17 TO COND-WORD
           ELSE
               IF FILE-STATUS NOT = "00"
                   MOVE 99 TO COND-WORD.

       9999-DBUPDATE-MCLASS-CL-O.
           MOVE 0 TO COND-WORD.
           REWRITE MCLASS-CL-REC-O FROM BUF-MCLASS
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD.

       9999-DBGET7-MACCOUNT-INFO-IK-I.
           MOVE 0 TO COND-WORD.
           MOVE MACCT-KEY TO INFOKEY OF MACCOUNT-INFO-IK-REC-I.
           READ MACCOUNT-INFO-IK-I INTO BUF-MACCT-INFO
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS = "23"
               MOVE 17 TO COND-WORD
           ELSE
               IF FILE-STATUS NOT = "00"
                   MOVE 99 TO COND-WORD.

       9999-OPEN-STUFF.
           OPEN I-O   MMATL-ACCUM-MC-O     .
           OPEN I-O   MCLASS-CL-O          .
           OPEN INPUT MACCOUNT-INFO-IK-I   .

       9999-CLOSE-STUFF.
           CLOSE      MMATL-ACCUM-MC-O     .
           CLOSE      MCLASS-CL-O          .
           CLOSE      MACCOUNT-INFO-IK-I   .
