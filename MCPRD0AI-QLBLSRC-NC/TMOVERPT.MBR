029700
030000 PROCEDURE DIVISION.
030100
030200 001-BEGIN SECTION.
030300
030400 010-MAINLINE.
           MOVE "C" TO MCXCBLERR-SCOPE.
           CALL "MCXCBLERR" USING MCXCBLERR-SCOPE.

030500*******************************************************
030600**   CALL 'CBLOWSRT' FIRST BEFORE GOING INTO THE
030700**   SORT VERB.  THE FIRST CALL TO 'CBLOWSRT' OPENS
030800**   UP A NEW TEMPORARY FILE 'BLUPDATA' THAT IS USED
030900**   TO WRITE THE BLOWUP INFORMATION IF A BLOWUP
031000**   OCCURS
031100*******************************************************
031200
031300     CALL "CBLOWSRT" USING CBLOWSRT-PARMS,
031400                           ACCTG-BASE,
031500                           BU-PGM-NAME,
031600                           STATUS-AREA,
031700                           DUMMY-VIEW-AREA,
031800                           FILE-STATUS,
031900                           BU-DISPLAY-MSG,
032000                           BU-DISPLAY-FLDS.
032100
032300     DISPLAY "IS THIS THE FINAL RUN OF THE MONTH?".
032400     ACCEPT  FINAL-OR-NOT.
032500     IF FINAL-OR-NOT = "Y" OR "N"
032600         SORT SORT-FILE ON ASCENDING KEY SORT-CLASS
032700                                         SORT-MATL-CODE
032800         INPUT PROCEDURE IS 050-PROCESS-TRANS
032900         OUTPUT PROCEDURE IS 700-CREATE-REPORT
033000     ELSE
033100         DISPLAY "FINAL RUN PARAMETERS INVALID - MUST BE 'Y' OR 'N
033200-            "'".
033300     PERFORM 1000-CLOSE-FILES.
033400     GOBACK.
033500
033700 050-PROCESS-TRANS SECTION.
       050-PROCESS-TRANS-PARA.
033800     PERFORM 100-BEGIN.
033900     PERFORM 200-PROCESS-DETAIL
034000         UNTIL END-OF-FILE.
034100
034200**********************************************************
034300*  TRANSFER CONTROL TO LAST STATEMENT IN INPUT PROCEDURE *
034400*  FOR SORTING OF RECORDS.                               *
034500**********************************************************
034600
034700     GO TO 699-PROCESS-EXIT.
034800
034900 100-BEGIN.
           PERFORM 9999-OPEN-STUFF.
036000
           PERFORM 9999-INIT-MMATL-ACCUM-MC-O.
036100     PERFORM 400-GET-MMATL-ACCUM.
036200
036300
036400 200-PROCESS-DETAIL.
036500     IF MATL-STORES-CODE = "NON-STR"
036600         NEXT SENTENCE
036700     ELSE
036800         PERFORM 600-BUILD-SORT-REC.
036900     PERFORM 400-GET-MMATL-ACCUM.
037000
037100 400-GET-MMATL-ACCUM.
           PERFORM 9999-DBGET2-MMATL-ACCUM-MC-O.
037900     IF GOOD-CALL
038000         NEXT SENTENCE
038100     ELSE
038200         IF END-OF-FILE
038300             NEXT SENTENCE
038400         ELSE
038500             MOVE "DBGET MMATL-ACCUM * 400-GMA" TO BU-DISPLAY-MSG
038600             PERFORM 990-BLOWUP.
038700
038800
038900 600-BUILD-SORT-REC.
039000********************************************************
039100**   CALL 'SOPNRAV' TO GET STOREROOM OPEN INVOICE
039200**   UNITS
039300********************************************************
039400     MOVE MATL-STORES-CODE        TO SOPNRAV-MATL-CODE.
039500     CALL "SOPNRAV" USING ACCTG-BASE,
039600                          SOPNRAV-PARMS,
039700                          STATUS-AREA,
039800                          BU-DISPLAY-MSG,
039900                          BU-DISPLAY-FLDS.
040000     IF BU-DISPLAY-MSG NOT = SPACES
040100         PERFORM 990-BLOWUP.
040200
040300     MOVE MATL-STORES-CODE        TO SORT-MATL-CODE,
040400                                     BU-DISPLAY-FLD (1).
040500     MOVE MATL-CLASS              TO SORT-CLASS.
040600     MOVE MATL-BEG-BAL-DOLLARS    TO SORT-BEG-DOLLARS.
040700     MOVE MATL-INV-DOLLARS        TO SORT-RCPT-DOLLARS.
040800     MOVE MATL-TOT-ISS-DOLLARS    TO SORT-ISS-DOLLARS.
040900     MOVE MATL-RTN-DOLLARS        TO SORT-RTN-DOLLARS.
041000     MOVE MATL-RTNVAL-DOLLARS     TO SORT-RTNVAL-DOLLARS.
041100     MOVE MATL-TOT-ADJ-DOLLARS    TO SORT-ADJ-DOLLARS.
041200     MOVE MATL-ACCTG-DOLLAR-CORR  TO SORT-DOLLAR-CORR.
041300     MOVE S-STR-OPEN-INV-DLRS     TO SORT-INV-ONDOCK-DOLLARS.
041400     MOVE MATL-INTRANSIT-DOLLARS  TO SORT-INTRANSIT-DOLLARS.
           MOVE S-ISS-FRAN-DLRS         TO SORT-FRAN-ISS-DOLLARS.
041500     IF MATL-STORES-CODE-1-4 = "OPNR"
041600         MOVE MATL-RCPT-DOLLARS   TO SORT-OPEN-RCVR-DOLLARS
041700         MOVE ZEROS               TO SORT-BEG-DOLLARS
041800                                     SORT-RCPT-DOLLARS
041900                                     SORT-ISS-DOLLARS
042000                                     SORT-RTN-DOLLARS
042100                                     SORT-RTNVAL-DOLLARS
042200                                     SORT-ADJ-DOLLARS
042300                                     SORT-DOLLAR-CORR
042400                                     SORT-INV-ONDOCK-DOLLARS
042500                                     SORT-INTRANSIT-DOLLARS
                                           SORT-FRAN-ISS-DOLLARS
042600     ELSE
042700         MOVE ZEROS               TO SORT-OPEN-RCVR-DOLLARS.
042800     IF FINAL-OR-NOT = "Y"
042900         PERFORM 650-UPDATE-MATL
043000     ELSE
043100         NEXT SENTENCE.
043200
043300     RELEASE SORT-REC.
043400
043500 650-UPDATE-MATL.
043600     COMPUTE NEW-BEG-BAL-UNITS = MATL-BEG-BAL-UNITS +
043700                                 MATL-RCPT-UNITS +
043800                                 MATL-ADJ-UNITS +
043900                                 MATL-RTN-UNITS +
044000                                 MATL-RTNVAL-UNITS +
044100                                 MATL-ACCTG-UNIT-CORR -
044200                                 MATL-ISSUE-UNITS.
044300
044400     COMPUTE NEW-BEG-BAL-DOLLARS = MATL-BEG-BAL-DOLLARS +
044500                                   MATL-INV-DOLLARS +
044600                                   MATL-TOT-ADJ-DOLLARS +
044700                                   MATL-RTN-DOLLARS +
044800                                   MATL-RTNVAL-DOLLARS +
044900                                   MATL-ACCTG-DOLLAR-CORR -
045000                                   MATL-TOT-ISS-DOLLARS.
045100
045200     MOVE NEW-BEG-BAL-UNITS       TO MATL-BEG-BAL-UNITS.
045300     MOVE NEW-BEG-BAL-DOLLARS     TO MATL-BEG-BAL-DOLLARS.
045400     MOVE 0                       TO MATL-RCPT-UNITS
045500                                     MATL-INV-DOLLARS
045600                                     MATL-ISSUE-UNITS
