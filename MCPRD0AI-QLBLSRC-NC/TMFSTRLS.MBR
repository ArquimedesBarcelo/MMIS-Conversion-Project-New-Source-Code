000300 IDENTIFICATION DIVISION.
000400 PROGRAM-ID.           TMFSTRLS.
000500 AUTHOR.               MK MADDEN.
000600 DATE-WRITTEN.         SEPTEMBER 11, 1985.
000700*INSTALLATION.         GOODYEAR TIRE AND RUBBER CO.
000800
000900*REMARKS.              THIS PROGRAM WILL READ EACH MANIFEST
001000*                      RELEASE FILE AND PASS THE INVOICE
001100*                      DOLLARS TO BE ACCUMULATED IN THE
001200*                      MMATL-ACCUM DATA SET.  THIS PROGRAM WILL
001300*                      ALSO CREATE A DETAIL ENTRY FOR EACH
001400*                      INVOICE IN THE DTRANS DETAIL DATA SET.
001500*                      A REPORT WILL ALSO BE PRINTED SHOWING
001600*                      EACH INVOICE TRANSACTION.
      *C
      *C   14FEB1994    DAVE PLUM
      *C     ADDED CALL TO THE COBOL ERROR HANDLER - MCXCBLERR.
      *C
      *C   29SEP1994    DAVE PLUM       REQUEST #6532
      *C     ADDED A CLASS OF ENTRY FIELD TO RECORD ID5 OF THE
      *C     MNFST-FILE.  THIS FIELD WILL BE USED TO HELP DETERMINE
      *C     IF THE UNITS PASSED FROM A/P SHOULD BE MULTIPLIED BY -1.
      *C
      *C   16SEP1996    DAVE PLUM
      *C     REVISED FOR CENTURY DATABASE CHANGES (YEAR 2000 PROJECT).
      *C
      *C   29JUL1997    JIM COFFMAN
      *C     UPDATED CLASS CHECKING DUE TO VALLEYFIELD USING CLASS 080
      *C     FOR SOME 2300+ ITEMS.
      *C
001800 ENVIRONMENT DIVISION.
001900 CONFIGURATION SECTION.
002000 SOURCE-COMPUTER.      HP-3000.
002100 OBJECT-COMPUTER.      HP-3000.
       COPY SPECIALN IN COPYLIB.
002300
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT MACCOUNT-INFO-IK-O
               ASSIGN TO DATABASE-MCFLCA0101
               ORGANIZATION IS INDEXED
                 ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
               FILE STATUS IS FILE-STATUS.

           SELECT DTRANS-PO-O
               ASSIGN TO DATABASE-MCFLCA0703
               ORGANIZATION IS INDEXED
                 ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                 WITH DUPLICATES
               FILE STATUS IS FILE-STATUS.

           SELECT MCHT-ACCTS-DP-I
               ASSIGN TO DATABASE-MCFLCA0301
               ORGANIZATION IS INDEXED
                 ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
               FILE STATUS IS FILE-STATUS.

           SELECT MCLASS-CL-I
               ASSIGN TO DATABASE-MCFLCS4901
               ORGANIZATION IS INDEXED
                 ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
               FILE STATUS IS FILE-STATUS.

           SELECT MMATL-ACCUM-MC-O
               ASSIGN TO DATABASE-MCFLCA0601
               ORGANIZATION IS INDEXED
                 ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
               FILE STATUS IS FILE-STATUS.

           SELECT MSTORERM-CD-I
               ASSIGN TO DATABASE-MCFLCS0201
               ORGANIZATION IS INDEXED
                 ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
               FILE STATUS IS FILE-STATUS.

           SELECT MNFST-FILE ASSIGN TO DISK-MFSTFILE.

           SELECT ONLINE-PRT ASSIGN TO PRINTER-MCPRT.

           SELECT SORT-FILE ASSIGN TO DISK-SORT.

           SELECT ONLINE-ERR ASSIGN TO PRINTER-MCPRTA.

