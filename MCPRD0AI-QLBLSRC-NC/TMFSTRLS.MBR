105800             MOVE 0               TO  MATL-INV-DOL-NOT-RCVD
105900             COMPUTE MATL-INV-DOLLARS ROUNDED =
106000                 MATL-INV-DOLLARS + (MULT-QTY * REC-UNIT-COST)
106100             COMPUTE REC-UNIT-COST ROUNDED =
106200                 HOLD-VALUE / ITEM-QUANTITY-WHOLE
106300             COMPUTE MATL-INV-DOLLARS ROUNDED =
106400                 MATL-INV-DOLLARS - (MULT-QTY * REC-UNIT-COST)
106500         ELSE
106600             COMPUTE MATL-INV-DOL-NOT-RCVD ROUNDED =
106700                 MATL-INV-DOL-NOT-RCVD -
106800                     (MULT-QTY * REC-UNIT-COST)
106900             COMPUTE MATL-INV-DOLLARS ROUNDED =
107000                 MATL-INV-DOLLARS + (MULT-QTY * REC-UNIT-COST)
107100             COMPUTE REC-UNIT-COST ROUNDED =
107200                 HOLD-VALUE / ITEM-QUANTITY-WHOLE
107300             COMPUTE MATL-INV-DOLLARS ROUNDED =
107400                 MATL-INV-DOLLARS - (MULT-QTY * REC-UNIT-COST).
107500
107700     PERFORM 510-UPDATE-DTRANS.
107800     IF HOLD-INV-BALANCE  NOT = 0
