           MOVE MANIFEST-DATE-0         TO HOLD-DATE-YYMMDD.

           IF HOLD-DATE-YY > "70"
               MOVE "19" TO HOLD-DATE-CC
           ELSE
               MOVE "20" TO HOLD-DATE-CC
           END-IF.
063400
063600****************************************************
063700**   GET STOREROOM DEPT FROM MACCOUNT-INFO        **
063800**   KEY IS EQUAL TO 'SDPT'.  THE STOREROOM DEPT. **
063900**   IS USED WHEN PROCESSING INVOICE TRANSACTIONS **
064000****************************************************
064100
064200     MOVE "SDPT" TO MACCT-KEY.
           PERFORM 9999-DBGET7-MACCOUNT-INFO-IK-O.
065000     IF GOOD-CALL
065100         MOVE MACCT-STR-DEPT      TO  SAVE-STR-DEPT
065200     ELSE
065300         MOVE "GET MACCOUNT-INFO 'SDPT'* 100"
065400               TO BU-DISPLAY-MSG
065500         MOVE MACCT-KEY           TO  BU-DISPLAY-FLD (1)
065600         PERFORM 990-BLOWUP.
065700
      *----- UNLOCK THE MACCOUNT-INFO RECORD USING A RESET
           PERFORM 9999-RESET-MACCOUNT-INFO-IK-O.

065800     DISPLAY "SAVE-STR-DEPT=", SAVE-STR-DEPT.
065900
066000     PERFORM 575-READ-MNSTFILE.
066100
066300 200-PROCESS-MNFST.
066400*****************************************************
066500*  READ MANIFEST FILE AND PROCESS INVOICES          *
066600*****************************************************
066700     IF RECORD-ID = 1
066800         MOVE SPACES TO HOLD-REMAIN-REC
066900         MOVE ZERO TO HOLD-TAX
067000                      HOLD-FREIGHT
067100                      HOLD-QTY
067200                      HOLD-VALUE
067300                      HOLD-BALANCE-QTY
067400         MOVE REGISTER-NUMBER-1   TO REGISTER-DOC
067500         MOVE INV-DOCUMENT        TO HOLD-DOCUMENT-NUM
067600         MOVE BUDGET-NUMBER-1     TO HOLD-BUDGET
067700         MOVE PO-NUMBER-1         TO HOLD-PO-NUM
067800         MOVE VENDOR-CODE-1       TO HOLD-VENDOR
067900         MOVE NO-CHECK-IND-1      TO HOLD-NO-CHECK-IND
068000     ELSE
068100         IF RECORD-ID = 5
068200             MOVE ITEM-NUMBER-5 TO ITEM-LST3
068300             MOVE ITEM-DIV TO HOLD-ITEM-NUM
068400             MOVE ITEM-UNIT-MEAS-5 TO HOLD-UNIT-MEASURE
068500             COMPUTE HOLD-VALUE = ITEM-VALUE-5 +
068600                                  ITEM-TAX-AMOUNT-5 +
068700                                  ITEM-FREIGHT-AMT-5
068800             PERFORM 450-CHECK-SIGN
068900             MOVE SUB-DETAIL-5 TO HOLD-DEPT
069000             MOVE ADDL-DATA-5 TO HOLD-ACCT
069100             PERFORM 410-CHECK-ACCT
069200             MOVE ITEM-TAX-AMOUNT-5 TO HOLD-TAX
069300             MOVE ITEM-FREIGHT-AMT-5 TO HOLD-FREIGHT
069400             MOVE SUB-5 TO HOLD-CLASS
069500             MOVE MEMO-QTY-IND-5  TO  HOLD-MEMO-QTY-IND
069600             MOVE CORP-CODE-5 TO HOLD-STORES-CODE
069700             MOVE HOLD-STORES-CODE TO MMATL-CODE-ARG
069800             PERFORM 520-GET-MMATL-ACCUM
069900             IF HOLD-STORES-CODE = "NON-STR"
070000                 IF HOLD-ACCT > "009999"
070100                     MOVE "0000" TO HOLD-DEPT
070200                     PERFORM 210-PROCESS-INVOICE
070300                 ELSE
070400                     PERFORM 210-PROCESS-INVOICE
070500             ELSE
070600                 IF HOLD-ACCT > "009999"
070700                     MOVE "0000" TO HOLD-DEPT
070800                     PERFORM 210-PROCESS-INVOICE
070900                 ELSE
071000                     IF HOLD-DEPT = SAVE-STR-DEPT
071100                         IF MATL-ACCOUNT = SPACES
071200                             PERFORM 210-PROCESS-INVOICE
071300                         ELSE
071400                             MOVE MATL-ACCOUNT TO HOLD-ACCT
071500                             PERFORM 210-PROCESS-INVOICE
071600                     ELSE
071700                         PERFORM 210-PROCESS-INVOICE.
071800
071900     PERFORM 575-READ-MNSTFILE.
072000
072200 210-PROCESS-INVOICE.
072300     IF HOLD-STORES-CODE = "NON-STR"
072400         NEXT SENTENCE
072500     ELSE
072600         IF HOLD-ACCT > "009999"
072700             NEXT SENTENCE
072800         ELSE
072900             IF HOLD-CLASS = 206
073000                 MOVE MATL-DEPT TO HOLD-DEPT.
073100
073200**************************************************
073300**   MEMO-QTY-IND MEANS THIS INVOICE WAS AN
073400**   ADJUSTMENT INVOICE AND NO NEW UNITS SHOULD
073500**   BE PROCESSED THERE THE QTY FIELDS ARE SET
073600**   TO ZERO
073700**************************************************
073800
073900     IF HOLD-MEMO-QTY-IND  NOT = SPACES
074000         MOVE ZEROS               TO  HOLD-QTY,
074100                                      ITEM-QUANTITY-WHOLE.
074200
074300**********************************************
074400**NO-CHECK-IND MEANS THAT THIS IS A FREIGHT **
074500**ENTRY.  THE DOLLARS SHOULD BE PASSED TO   **
074600**STORES, BUT NO CHECK WAS CREATED FOR THIS **
074700**ENTRY.                                    **
074800**********************************************
074900     IF HOLD-NO-CHECK-IND = "F" OR HOLD-QTY = 0
075000         MOVE 0 TO HOLD-INV-BALANCE
075100         PERFORM 229-PROC-INV-IS-REC
075200     ELSE
075300         MOVE HOLD-PO-NUM TO PO-ARG
               PERFORM 9999-DBFIND-DTRANS-PO-O
076000         IF GOOD-CALL
076100             IF HOLD-QTY < 0
076200                 PERFORM 220-CHECK-FOR-INV
076300                    UNTIL SAVE-END-OF-CHAIN OR INV-ADDED = 1
076400             ELSE
076500                 PERFORM 220-CHECK-FOR-REC
076600                      UNTIL SAVE-END-OF-CHAIN OR INV-ADDED = 1
076700         ELSE
076800             IF NO-ENTRY
076900                 IF HOLD-QTY < 0
077000                     PERFORM 230-CREATE-REC
077100                     PERFORM 231-UPDATE-INVOICE-TC
077200                 ELSE
077300                     MOVE ZERO      TO  REC-UNITS-HOLD
077400                     MOVE HOLD-QTY  TO  HOLD-INV-BALANCE
077500                     PERFORM 229-PROC-INV-IS-REC
077600             ELSE
077700                 MOVE "DBFIND DTRANS * 220-PROC" TO BU-DISPLAY-MSG
077800                 PERFORM 990-BLOWUP.
077900
078000     MOVE ZEROS                   TO  INV-ADDED,
078100                                      FOUND-FLAG,
078200                                      SAVE-GET-COND.
078300
078500************************************************************
078600**                                                        **
078700**   CALLED FOR A PAYMENT INVOICE (HOLD-QTY > 0)          **
078800**   AND AT LEAST ONE ENTRY IN DTRANS FOR THE PO NUMBER   **
078900**                                                        **
079000************************************************************
079100
079200 220-CHECK-FOR-REC.
           PERFORM 9999-DBGET5-DTRANS-PO-O.
080000     IF GOOD-CALL
080100         IF CORP-CODE-5 = TRANS-STORES-CODE
080200             IF HOLD-ITEM-NUM = TRANS-ITEM-NUM
080300                 IF TRANS-CODE = "REC" OR "DCHG"
080400                     IF TRANS-BALANCE-QTY = 0
080500                         NEXT SENTENCE
080600                     ELSE
080700                         IF HOLD-QTY = TRANS-BALANCE-QTY
080800                             PERFORM 228-UPDATE-REC-EQUAL
080900                         ELSE
081000                             NEXT SENTENCE
081100                 ELSE
081200                     NEXT SENTENCE
081300             ELSE
081400                 NEXT SENTENCE
081500         ELSE
081600             NEXT SENTENCE
081700     ELSE
081800         IF END-OF-CHAIN
081900             MOVE HOLD-PO-NUM TO PO-ARG
                   PERFORM 9999-DBFIND-DTRANS-PO-O
082600             IF GOOD-CALL
082700                 PERFORM 221-CHECK-FOR-REC
082800                     UNTIL SAVE-END-OF-CHAIN OR
082900                             INV-ADDED = 1
083000             ELSE
083100                 MOVE "DBFIND DTRANS * 220-CHECK"
083200                      TO BU-DISPLAY-MSG
083300                 PERFORM 990-BLOWUP
083400         ELSE
083500             MOVE "DBGET DTRANS * 221-CHECK" TO BU-DISPLAY-MSG
083600             PERFORM 990-BLOWUP.
083700
083800************************************************************
083900**                                                        **
084000**   CALLED FOR A CREDIT INVOICE  (HOLD-QTY < 0)          **
084100**   AND AT LEAST ONE ENTRY IN DTRANS FOR THE PO NUMBER   **
084200**   CHECKING FOR OPEN INVOICE TRANSACTIONS 'INV' BEFORE  **
084300**   GOING TO OPEN RECEIVING TRANSACTIONS                 **
084400**                                                        **
084500************************************************************
084600
084700 220-CHECK-FOR-INV.
           PERFORM 9999-DBGET5-DTRANS-PO-O.
085500     IF GOOD-CALL
085600         IF CORP-CODE-5 = TRANS-STORES-CODE
085700             IF HOLD-ITEM-NUM = TRANS-ITEM-NUM
085800                 IF TRANS-CODE = "INV"
085900                     IF TRANS-BALANCE-QTY > 0
086000                         PERFORM 228-MAKE-INV-CLOSED
086100                     ELSE
086200                         NEXT SENTENCE
086300                 ELSE
086400                     NEXT SENTENCE
086500             ELSE
086600                 NEXT SENTENCE
086700         ELSE
086800             NEXT SENTENCE
086900     ELSE
087000         IF END-OF-CHAIN
087100             MOVE HOLD-PO-NUM TO PO-ARG
                   PERFORM 9999-DBFIND-DTRANS-PO-O
087800             IF GOOD-CALL
087900                 PERFORM 222-CHECK-FOR-REC
088000                     UNTIL SAVE-END-OF-CHAIN OR
088100                             INV-ADDED = 1
088200             ELSE
088300                 MOVE "DBFIND DTRANS * 220-CFI"
088400                      TO BU-DISPLAY-MSG
088500                 PERFORM 990-BLOWUP
088600         ELSE
088700             MOVE "DBGET DTRANS * 220-CFI" TO BU-DISPLAY-MSG
088800             PERFORM 990-BLOWUP.
088900
089000************************************************************
089100**                                                        **
089200**   CALLED FOR A PAYMENT INVOICE (HOLD-QTY>0) AND NO     **
089300**   RECEIVER QUANTITY AND INVOICE QUANTITY MATCH WAS     **
089400**   FOUND                                                **
089500**                                                        **
089600************************************************************
089700
089800 221-CHECK-FOR-REC.
           PERFORM 9999-DBGET5-DTRANS-PO-O.
090600     IF GOOD-CALL
090700         IF CORP-CODE-5 = TRANS-STORES-CODE
090800             IF HOLD-ITEM-NUM = TRANS-ITEM-NUM
090900                 IF TRANS-CODE = "REC" OR "DCHG"
091000                     IF TRANS-BALANCE-QTY > 0
091100                         PERFORM 228-UPDATE-REC-NOT-EQUAL
091200                         MOVE 2 TO FOUND-FLAG
091300                     ELSE
091400                         NEXT SENTENCE
091500                 ELSE
091600                     NEXT SENTENCE
091700             ELSE
091800                 NEXT SENTENCE
091900         ELSE
092000             NEXT SENTENCE
092100     ELSE
092200         IF END-OF-CHAIN
092300             MOVE COND-WORD TO SAVE-GET-COND
092400             IF REC-FOUND
092500                 PERFORM 229-PROC-INV-IS-REC
092600             ELSE
092700                 MOVE ZERO        TO  REC-UNITS-HOLD
092800                 MOVE HOLD-QTY    TO  HOLD-INV-BALANCE
092900                 PERFORM 229-PROC-INV-IS-REC
093000         ELSE
093100             MOVE "DBGET DTRANS * 221-CHECK" TO BU-DISPLAY-MSG
093200             PERFORM 990-BLOWUP.
093300
093500************************************************************
093600**                                                        **
093700**   CALLED FOR A CREDIT INVOICE AND AT LEAST ONE ENTRY   **
093800**   IN DTRANS FOR THE PO NUMBER                          **
093900**                                                        **
094000************************************************************
094100
094200 222-CHECK-FOR-REC.
           PERFORM 9999-DBGET5-DTRANS-PO-O.
095000     IF GOOD-CALL
095100         IF CORP-CODE-5 = TRANS-STORES-CODE
095200             IF HOLD-ITEM-NUM = TRANS-ITEM-NUM
095300                 IF TRANS-CODE = "REC" OR "DCHG"
095400                     IF TRANS-BALANCE-QTY < TRANS-QTY
095500                         PERFORM 228-MAKE-RCVR-OPEN
095600                     ELSE
095700                         NEXT SENTENCE
095800                 ELSE
095900                     NEXT SENTENCE
096000             ELSE
096100                 NEXT SENTENCE
096200         ELSE
096300             NEXT SENTENCE
096400     ELSE
096500         IF END-OF-CHAIN
096600             MOVE COND-WORD TO SAVE-GET-COND
096700             PERFORM 230-CREATE-REC
096800             PERFORM 231-UPDATE-INVOICE-TC
096900         ELSE
097000             MOVE "DBGET DTRANS * 222-CHECK" TO BU-DISPLAY-MSG
097100             PERFORM 990-BLOWUP.
097200
097400**********************************************************
097500**                                                      **
097600**   CALLED FOR A PAYMENT INVOICE (HOLD-QTY > 0) AND    **
097700**   THE PAYMENT MATCHES THE OPEN RECEIPT.  WHICH WILL  **
097800**   CLOSE OUT THE RECEIPT AND INVOICE PAYMENT          **
097900**   TRANS-BALANCE-QTY WILL EQUAL ZERO FOR BOTH ENTRIES **
098000**                                                      **
098100**********************************************************
098200
098300 228-UPDATE-REC-EQUAL.
098400     MOVE ZERO                    TO  TRANS-BALANCE-QTY
098500                                      HOLD-INV-BALANCE.
098600     SUBTRACT HOLD-QTY FROM MATL-UNITS-RCVD-NOT-INV.
098700     COMPUTE REC-UNIT-COST ROUNDED = TRANS-VALUE / TRANS-QTY.
098800     IF TRANS-CLASS = 206
098900         NEXT SENTENCE
099000     ELSE
099100         IF MATL-UNITS-RCVD-NOT-INV = 0
099200             MOVE 0 TO MATL-RCPT-DOLLARS
099300         ELSE
099400             COMPUTE MATL-RCPT-DOLLARS ROUNDED =
099500                 MATL-RCPT-DOLLARS - (HOLD-QTY * REC-UNIT-COST).
099600     PERFORM 510-UPDATE-DTRANS.
099700     PERFORM 229-PROC-INV-IS-REC.
099800
099900***************************************************************
100000**                                                           **
100100**   CALLED ON A PAYMENT INVOICE (HOLD-QTY>0) AND A RECEIPT  **
100200**   IS OPEN (TRANS-BALANCE-QTY>0) BUT THE INVOICE-QTY AND   **
100300**   OPEN RECEIPT QUANTITIES DONT MATCH                      **
100400**                                                           **
100500***************************************************************
100600
100700 228-UPDATE-REC-NOT-EQUAL.
100800     COMPUTE REC-UNIT-COST ROUNDED = TRANS-VALUE / TRANS-QTY.
100900     IF HOLD-QTY < TRANS-BALANCE-QTY
101000         MOVE 0 TO HOLD-INV-BALANCE
101100         SUBTRACT HOLD-QTY FROM TRANS-BALANCE-QTY
101200         SUBTRACT HOLD-QTY FROM MATL-UNITS-RCVD-NOT-INV
101300         MOVE HOLD-QTY TO MULT-QTY
101400     ELSE
101500         COMPUTE HOLD-INV-BALANCE = HOLD-QTY - TRANS-BALANCE-QTY
101600         SUBTRACT TRANS-BALANCE-QTY FROM MATL-UNITS-RCVD-NOT-INV
101700         MOVE TRANS-BALANCE-QTY TO MULT-QTY
101800         MOVE 0 TO TRANS-BALANCE-QTY.
101900     IF TRANS-CLASS = 206
102000         NEXT SENTENCE
102100     ELSE
102200         IF MATL-UNITS-RCVD-NOT-INV = 0
102300             MOVE 0 TO MATL-RCPT-DOLLARS
102400         ELSE
102500            COMPUTE MATL-RCPT-DOLLARS ROUNDED =
102600                MATL-RCPT-DOLLARS - (MULT-QTY * REC-UNIT-COST).
102700     ADD MULT-QTY                 TO  REC-UNITS-HOLD.
102800     PERFORM 510-UPDATE-DTRANS.
102900     IF HOLD-INV-BALANCE > 0
103000         MOVE HOLD-INV-BALANCE TO HOLD-QTY
103100     ELSE
103200         PERFORM 229-PROC-INV-IS-REC.
103300
103400***********************************************************
103500**                                                       **
103600**   CALLED ON A CREDIT INVOICE FOR A 'INV' TRANSACTION  **
103700**   THAT IS OPEN AND THEREFORE CAN BE REDUCED OR        **
103800**   COMPLETELY CLOSED OUT BY THE CREDIT                 **
103900**                                                       **
104000***********************************************************
104100
