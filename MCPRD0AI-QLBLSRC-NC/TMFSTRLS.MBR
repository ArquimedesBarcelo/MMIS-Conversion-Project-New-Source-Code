164400          MOVE "02"                TO MATL-REPORT-CODE
164500      ELSE
164600      IF MATL-CLASS > 199 AND MATL-CLASS < 344
164700          MOVE "05"                TO MATL-REPORT-CODE
164800      ELSE
164900      IF (MATL-CLASS > 343 AND MATL-CLASS < 400)  OR
165000         (MATL-CLASS > 499) OR (MATL-CLASS < 100)
165100          MOVE "01"                TO MATL-REPORT-CODE.
165200
            PERFORM 9999-DBPUT-MMATL-ACCUM-MC-O.
166900      IF GOOD-CALL
167000          NEXT SENTENCE
167100      ELSE
167200          MOVE "DBPUT MMATL * 600-ADD" TO BU-DISPLAY-MSG
167300          PERFORM 990-BLOWUP.
167400
      *------ UNLOCK THE MMATL-ACCUM RECORD WHICH WAS JUST WRITTEN
            PERFORM 9999-RESET-MMATL-ACCUM-MC-O.

168600 699-PROCESS-EXIT.
168700     EXIT.
168800
169000 700-CREATE-REPORT SECTION.
       700-CREATE-REPORT-PARA.
169100     DISPLAY "BEGIN REPORT".
169200     PERFORM 710-BEGIN-REPORT.
169300     PERFORM 720-MOVE-DATA
169400        UNTIL NO-MORE-SORT = "YES".
169500     MOVE "* - INVALID DEPARTMENT TRANSACTION ADDED WITH DEFAULT D
169600-      "EPARTMENT '0000'" TO PRT-REC.
169700     WRITE PRT-REC  AFTER ADVANCING 3 LINES.
169800     MOVE "** - INVALID CLASS  -  TRANSACTION ADDED WITH DEFAULT C
169900-       "LASS '000'" TO PRT-REC.
170000     WRITE PRT-REC  AFTER ADVANCING 2 LINES.
170100
170200**************************************************
170300**  BRANCH TO LAST STATEMENT OF OUTPUT SECTION  **
170400**  TO COMPLETE PROCESSING OF REPORT            **
170500**************************************************
170600
170700     GO TO 799-CREATE-EXIT.
170800
170900 710-BEGIN-REPORT.
171000     OPEN OUTPUT ONLINE-PRT.
171100     PERFORM 750-PRINT-HEADINGS.
171200     RETURN SORT-FILE
171300        AT END
171400            MOVE "YES" TO NO-MORE-SORT.
171500
171600 720-MOVE-DATA.
171700     PERFORM 730-PROCESS-CODE
171800        UNTIL NO-MORE-SORT = "YES".
171900     PERFORM 740-TOTAL-CODE.
172000
172100 730-PROCESS-CODE.
172200     MOVE SORT-MANIFEST           TO PRT-MAN.
172300     MOVE SORT-REGISTER           TO PRT-REG.
172400     MOVE SORT-CLASS              TO PRT-CLASS.
172500     MOVE "-"                     TO PRT-DASH.
172600     MOVE SORT-STORES-CODE        TO PRT-CODE.
172700     MOVE SORT-QTY                TO PRT-QTY.
172800     MOVE SORT-VALUE              TO PRT-VALUE.
172900     MOVE SORT-BUDGET             TO PRT-BUDGET.
173000     MOVE SORT-VENDOR             TO PRT-VENDOR.
173100     MOVE SORT-ORDER-NUM          TO PRT-PO.
173200     MOVE SORT-SUFFIX             TO PRT-SUFFIX.
173300     MOVE SORT-RELEASE            TO PRT-RELEASE.
173400     MOVE SORT-ITEM-NUM           TO PRT-ITEM.
173500     MOVE SORT-UNIT-MEASURE       TO PRT-UM.
173600     MOVE SORT-ACCT               TO PRT-ACCT.
173700     MOVE SORT-DEPT               TO PRT-DEPT.
173800     MOVE SORT-YY                 TO PRT-YY.
173900     MOVE SORT-MM                 TO PRT-MM.
174000     MOVE SORT-DD                 TO PRT-DD.
174100     MOVE SORT-TAX                TO PRT-TAX.
174200     MOVE SORT-FREIGHT            TO PRT-FREIGHT.
174300     IF SORT-ERR-DEPT = 1
174400         MOVE "*"                 TO PRT-ERR-DEPT.
174500     IF SORT-ERR-CLASS = 2
174600         MOVE "**"                TO PRT-ERR-CLASS.
174700
174800     WRITE PRT-REC FROM DETAIL-LINE AFTER 1.
174900     ADD 1                        TO LINE-CNT.
175000     IF LINE-CNT > 55
175100         PERFORM 750-PRINT-HEADINGS.
175200     MOVE SPACES                  TO DETAIL-LINE.
175300     ADD SORT-QTY                 TO TRANS-QTY-TOT.
175400     ADD SORT-VALUE               TO TRANS-VALUE-TOT.
175500     RETURN SORT-FILE
175600        AT END
175700            MOVE "YES" TO NO-MORE-SORT.
175800
175900 740-TOTAL-CODE.
176000     MOVE "TOTAL FOR MANIFEST"    TO DETAIL-LINE.
176100     MOVE TRANS-QTY-TOT           TO PRT-QTY.
176200     MOVE TRANS-VALUE-TOT         TO PRT-VALUE.
176300     WRITE PRT-REC FROM DETAIL-LINE AFTER 2.
176400     ADD 2 TO LINE-CNT.
176500     IF LINE-CNT > 55
176600         PERFORM 750-PRINT-HEADINGS.
176700     MOVE SPACES                  TO DETAIL-LINE.
176800     MOVE ZERO                    TO TRANS-QTY-TOT,
176900                                     TRANS-VALUE-TOT.
177000
177200 750-PRINT-HEADINGS.
177300     MOVE 1                       TO DATE-MODE.
177400     CALL "TDATECHK" USING DATE-CHECK-AREA.
177500     MOVE DATE-SLASH-OUT          TO DATE-H1.
177600     MOVE DATE-FORMATTED-TIME-OUT TO TIME-H2.
177700     ADD 1                        TO PAGE-CNT.
177800     MOVE PAGE-CNT                TO PAGE-H2.
177900     MOVE "MANIFEST RELEASE TO STORES"  TO  RPT-H2.
178000     WRITE PRT-REC FROM HEADER1 AFTER ADVANCING NEW-PAGE.
178100     WRITE PRT-REC FROM HEADER2 AFTER 1.
178200     WRITE PRT-REC FROM HEADER3 AFTER 2.
178300     MOVE SPACES                  TO  PRT-REC.
178400     WRITE PRT-REC AFTER 1.
178500     MOVE 5                       TO LINE-CNT.
178600
178800 799-CREATE-EXIT.
178900     EXIT.
179000
179100 900-ERROR SECTION.
179200
179300 990-BLOWUP.
179400     IF ERR-FLAG = 1 OR 2
179500         NEXT SENTENCE
179600     ELSE
               PERFORM 9999-SETJCW-ABORTED-2.

      *********************************************************
      * 04APR90 REPLACED THE FOLLOWING LOGIC WITH THE MACHINE
      *         DEPENDENT PERFORMED ROUTINE 9999-SETJCW-ABORTED-2.
      *********************************************************
179700*        MOVE "SETJCW ABORTED=2"  TO  COMMAND
179800*        CALL INTRINSIC "COMMAND" USING COMMAND-IMAGE,
179900*            COMMAND-ERROR, COMMAND-PARM
180000*        IF COMMAND-ERROR NOT = 0
180100*            DISPLAY "COMMAND (SETJCW ABORTED=2) FAILED"
180200*            DISPLAY "COMMAND-ERROR=", COMMAND-ERROR
180300*            DISPLAY "COMMAND-PARM=", COMMAND-PARM.
      *********************************************************

180500***************************************************************
180600**   CALL 'CBLOWSRT' INSTEAD OF 'TBLOWUP' WHEN A BLOWUP      **
180700**   SITUATION OCCURS SINCE THIS PROGRAM USES THE 'SORT'     **
180800**   VERB.  'CBLOWSRT' WRITES ALL THE BLOWUP INFORMATION     **
180900**   TO A TEMPORARY FILE 'BLUPDATA' (WHICH WAS OPENED AT     **
181000**   THE BEGINNING OF THE PROGRAM) THE CLOSES IT. THEN IT    **
181100**   CREATESA A SON PROCESS 'XBLOWSRT' THAT READS THE        **
181200**   BLOWUP INFORMATION OUT OF 'BLUPDATA' AND CALLS          **
181300**   'TBLOWUP' USING THIS INFO.  SINCE THE NEW PROCESS       **
181400**   'XBLOWSRT' HAS ITS OWN STACK THE STACK OVERFLOW         **
181500**   PROBLEM IS AVOIDED.                                     **
181600***************************************************************
181700
181800     MOVE "TMFSTRLS"              TO  BU-PGM-NAME.
181900     MOVE TRANS-FILE-RCD-COUNT    TO  BU-DISPLAY-FLD9 (5).
182000     CALL "CBLOWSRT" USING CBLOWSRT-PARMS,
182100                           ACCTG-BASE,
182200                           BU-PGM-NAME,
182300                           STATUS-AREA,
182400                           DUMMY-VIEW-AREA,
182500                           FILE-STATUS,
182600                           BU-DISPLAY-MSG,
182700                           BU-DISPLAY-FLDS.
182800
183100 995-ERROR-PRT.
183200     PERFORM 996-PRINT-ERR-HEADINGS.
183300     IF ERR-FLAG = 1
183400        WRITE ERR-REC FROM PRT-ERROR-LINE1 AFTER 2
183500     ELSE
183600         IF ERR-FLAG = 2
183700             WRITE ERR-REC FROM PRT-ERROR-LINE1 AFTER 2
183800             WRITE ERR-REC FROM PRT-ERROR-LINE2 AFTER 1
183900             WRITE ERR-REC FROM PRT-ERROR-LINE3 AFTER 1.
184000
184100 996-PRINT-ERR-HEADINGS.
184200     MOVE 1                       TO DATE-MODE.
184300     CALL "TDATECHK" USING DATE-CHECK-AREA.
184400     MOVE DATE-SLASH-OUT          TO DATE-H1.
184500     MOVE DATE-FORMATTED-TIME-OUT TO TIME-H2.
184600     MOVE 1                       TO  PAGE-H2.
184700     MOVE "TRANSACTION ERROR LIST" TO RPT-H2.
184800     WRITE ERR-REC FROM HEADER1 AFTER ADVANCING NEW-PAGE.
184900     WRITE ERR-REC FROM HEADER2 AFTER 1.
185000     WRITE ERR-REC FROM HEADER3 AFTER 2.
185100     MOVE SPACES                  TO  ERR-REC.
185200     WRITE ERR-REC AFTER 1.
185300
185500 1000-CLOSE-FILES.
185600     CLOSE MNFST-FILE
185700           ONLINE-ERR
185800           ONLINE-PRT.
185900
186000******************************************************
186100**   UPDATE THE MANIFEST FILE SEQ NUMBER BY ONE IN  **
186200**   THE MACCOUNT-INFO SET (SEQ)                    **
186300******************************************************
186400
186500     PERFORM 525-GET-MACCT-SEQ.
      *----- THE MACCOUNT-INFO RECORD REMAINS LOCKED UNTIL IT
      *----- IS REWRITTEN IN 530-UPDATE-MACCT-INFO.

186600     ADD 1   TO  MACCT-MNFST-SEQ.
186700     PERFORM 530-UPDATE-MACCT-INFO.
186800
186900******************************************************
187000**   UPDATE LATEST MANIFEST NUMBER PROCESSED IN THE **
187100**   MACCOUNT-INFO DATA SET (MTED)                  **
187200******************************************************
187300     PERFORM 535-GET-MACCT-MTED.
      *----- THE MACCOUNT-INFO RECORD REMAINS LOCKED UNTIL IT
      *----- IS REWRITTEN IN 530-UPDATE-MACCT-INFO.

187400     MOVE MANIFEST-DOC            TO  MACCT-LAST-MANIFEST.
187500     PERFORM 530-UPDATE-MACCT-INFO.
187600
           PERFORM 9999-CLOSE-STUFF.

       9999-ROUTINES SECTION.

       9999-DBGET7-MACCOUNT-INFO-IK-O.
           MOVE 0 TO COND-WORD.
           MOVE MACCT-KEY TO INFOKEY OF MACCOUNT-INFO-IK-REC-O.
           READ MACCOUNT-INFO-IK-O INTO BUF-MACCT-INFO
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS = "23"
               MOVE 17 TO COND-WORD
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD.

       9999-RESET-MACCOUNT-INFO-IK-O.
           MOVE HIGH-VALUES TO INFOKEY OF MACCOUNT-INFO-IK-REC-O.
           START MACCOUNT-INFO-IK-O KEY > INFOKEY OF
              MACCOUNT-INFO-IK-REC-O
               INVALID KEY MOVE "00" TO FILE-STATUS.

       9999-DBFIND-DTRANS-PO-O.
           MOVE 0 TO COND-WORD.
           MOVE PO-ARG TO PONUM OF DTRANS-PO-REC-O.
           START DTRANS-PO-O KEY = PONUM OF DTRANS-PO-REC-O
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS = "23"
               MOVE 17 TO COND-WORD
           ELSE
           IF (FILE-STATUS NOT = "00") AND (FILE-STATUS-1 NOT = "2")
               MOVE 99 TO COND-WORD.

       9999-DBGET5-DTRANS-PO-O.
           MOVE 0 TO COND-WORD.
           READ DTRANS-PO-O NEXT INTO BUF-DTRANS
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14"
                   PERFORM 9999-RESET-DTRANS-PO-O
                   MOVE 15 TO COND-WORD
               ELSE
               IF FILE-STATUS = "46"
                   MOVE 15 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD
           ELSE
           IF PONUM OF DTRANS-PO-REC-O NOT = PO-ARG
               PERFORM 9999-RESET-DTRANS-PO-O
               MOVE 15 TO COND-WORD.

       9999-RESET-DTRANS-PO-O.
           MOVE HIGH-VALUES TO PONUM OF DTRANS-PO-REC-O.
           START DTRANS-PO-O KEY > PONUM OF DTRANS-PO-REC-O
               INVALID KEY MOVE "00" TO FILE-STATUS.

       9999-DBGET7-MCHT-ACCTS-DP-I.
           MOVE 0 TO COND-WORD.
           MOVE DEPT-ARG TO DEPT OF MCHT-ACCTS-DP-REC-I.
           READ MCHT-ACCTS-DP-I INTO BUF-MCHTACCTS
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS = "23"
               MOVE 17 TO COND-WORD
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD.

       9999-DBGET7-MCLASS-CL-I.
           MOVE 0 TO COND-WORD.
           MOVE CLASS-ARG TO ACTGCLASS OF MCLASS-CL-REC-I.
           READ MCLASS-CL-I INTO BUF-MCLASS
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS = "23"
               MOVE 17 TO COND-WORD
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD.

       9999-DBPUT-DTRANS-PO-O.
           MOVE 0 TO COND-WORD.
           WRITE DTRANS-PO-REC-O FROM BUF-DTRANS
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD.

       9999-DBUPDATE-DTRANS-PO-O.
           MOVE 0 TO COND-WORD.
           REWRITE DTRANS-PO-REC-O FROM BUF-DTRANS
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD.

       9999-DBGET7-MMATL-ACCUM-MC-O.
           MOVE 0 TO COND-WORD.
           MOVE MMATL-CODE-ARG TO MATLCODE OF MMATL-ACCUM-MC-REC-O.
           READ MMATL-ACCUM-MC-O INTO BUF-MATLACUM
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS = "23"
               MOVE 17 TO COND-WORD
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD.

       9999-RESET-MMATL-ACCUM-MC-O.
           MOVE HIGH-VALUES TO MATLCODE OF MMATL-ACCUM-MC-REC-O.
           START MMATL-ACCUM-MC-O KEY > MATLCODE OF
              MMATL-ACCUM-MC-REC-O
               INVALID KEY MOVE "00" TO FILE-STATUS.

       9999-DBUPDATE-MACCOUNT-INFO-O.
           MOVE 0 TO COND-WORD.
           REWRITE MACCOUNT-INFO-IK-REC-O FROM BUF-MACCT-INFO
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD.

       9999-DBGET7-MSTORERM-CD-I.
           MOVE 0 TO COND-WORD.
           MOVE MMATL-CODE-ARG TO CORPCDE OF MSTORERM-CD-REC-I.
           READ MSTORERM-CD-I INTO BUF-MSTORERM
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS = "23"
               MOVE 17 TO COND-WORD
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD.

       9999-DBPUT-MMATL-ACCUM-MC-O.
           MOVE 0 TO COND-WORD.
           WRITE MMATL-ACCUM-MC-REC-O FROM BUF-MATLACUM
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD.

       9999-OPEN-STUFF.
           OPEN I-O   MACCOUNT-INFO-IK-O   .
           OPEN I-O   DTRANS-PO-O          .
           OPEN INPUT MCHT-ACCTS-DP-I      .
           OPEN INPUT MCLASS-CL-I          .
           OPEN I-O   MMATL-ACCUM-MC-O     .
           OPEN INPUT MSTORERM-CD-I        .

       9999-CLOSE-STUFF.
           CLOSE      MACCOUNT-INFO-IK-O   .
           CLOSE      DTRANS-PO-O          .
           CLOSE      MCHT-ACCTS-DP-I      .
           CLOSE      MCLASS-CL-I          .
           CLOSE      MMATL-ACCUM-MC-O     .
           CLOSE      MSTORERM-CD-I        .

       9999-OVERRIDE-FILE.
           MOVE FILE-COMMAND TO COMMAND-WORK.
           CALL "QCMDEXC" USING COMMAND-WORK, COMMAND-LEN.

       9999-SETJCW-ABORTED-2.
           MOVE "2"   TO SETJCW-VALUE.
           MOVE 300   TO SETJCW-STARTING-POS.
           MOVE 1     TO SETJCW-LENGTH.
           CALL "SETJCW" USING SETJCW-VALUE,
                               SETJCW-STARTING-POS,
                               SETJCW-LENGTH,
                               SETJCW-STATUS.
           IF SETJCW-STATUS NOT = "00"
               DISPLAY "COMMAND (SETJCW ABORTED=2) FAILED"
               DISPLAY "SETJCW-STATUS       = ", SETJCW-STATUS
               DISPLAY "SETJCW-VALUE        = ", SETJCW-VALUE
               DISPLAY "SETJCW-STARTING-POS = ", SETJCW-STARTING-POS
               DISPLAY "SETJCW-LENGTH       = ", SETJCW-LENGTH.
