000200 IDENTIFICATION DIVISION.
000300 PROGRAM-ID. TMUPDEXC.
000400*REMARKS.    THIS PROGRAM IS THE EXECUTIVE CONTROLLING PROGRAM
000500*            FOR MISCELLANEOUS WORK ORDER MODIFY PROGRAMS.
000600 ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.
000800 SOURCE-COMPUTER.    AS400.
000900 OBJECT-COMPUTER.    AS400.
       SPECIAL-NAMES. I-O-FEEDBACK IS I-O-FEEDBACK-AREA
                      LOCAL-DATA IS LOCAL-DATA-AREA.
001000 INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT DISPLAY-FILE
               ASSIGN TO WORKSTATION-ZMODIFY-SI
               ORGANIZATION IS TRANSACTION
               ACCESS IS SEQUENTIAL
               FILE STATUS IS DSPLY-STATUS
               CONTROL-AREA IS WS-CONTROL.
001100 DATA DIVISION.
       FILE SECTION.
       FD  DISPLAY-FILE
           LABEL RECORDS ARE OMITTED.
       01  DSPLY-REC                    PIC X(2000).
000800 WORKING-STORAGE SECTION.
000900 01  BLOWUP-BASE                  PIC X(16).
       COPY CATREAD OF COPYLIB.
       COPY CPYIND  OF COPYLIB.
       01  DSPLY-STATUS                 PIC XX.
       01  ERROR-BUFFER                 PIC X(80).
       COPY LANGSUB OF COPYLIB.
029800 01  MASTER-PRTPLAN-DATA.         COPY MMSTPART OF COPYLIB.
       COPY IOFEEDBACK OF COPYLIB.
001900 01  PASSWORD-INFORMATION.
002000     05  NAME-OF-PROGRAM     PIC X(08) VALUE "TMUPDEXC".
002100     05  PROGRAM-TYPE        PIC X(02) VALUE "UP".
002200     05  PROGRAM-RELEASE     PIC X(12) VALUE " E0100010001".
002300     05  PROGRAM-DESCRIPTION.
002400         10  PROG-DESC-A.
                   15  FILLER      PIC X(15) VALUE " MISCELLANEOUS ".
                   15  FILLER      PIC X(17) VALUE "UPDATE EXECUTIVE ".
                   15  FILLER      PIC X(12) VALUE "FOR PLANNER/".
                   15  FILLER      PIC X(16) VALUE "ENGINEER".
002600         10  PROG-DESC-B     PIC X(60) VALUE SPACES.
002800         10  PROG-FUNCTION   PIC X(60) VALUE SPACES.
003000     05  PASSWORD-FLAG       PIC X.
       01  READ-BUFFER.
           05  READ-ITEM-1         PIC X(10).
           05  READ-ITEM-2         PIC X(10).
           05  READ-ITEM-3         PIC X(10).
           05  READ-ITEM-4         PIC X(10).
           05  READ-ITEM-5         PIC X(10).
           05  READ-ITEM-6         PIC X(10).
           05  READ-CMD-LINE       PIC X(79).
           05  READ-ERR-LINE       PIC X(79).
       01  SCREEN-BUFFER.
           05  SCREEN-CMD-LINE     PIC X(79).
           05  SCREEN-ERR-LINE     PIC X(79).
       COPY DBSTAT OF COPYLIB.
003200 COPY TBLOWUP   OF COPYLIB.
       01  TRUE-VAL                PIC 1 VALUE B"1".
       COPY WSCONTROL OF COPYLIB.
003300 LINKAGE SECTION.
004000 01  DBPARAMETERS.       COPY DBPARMS OF COPYLIB.
       COPY VCOMLINK OF COPYLIB.
005100 PROCEDURE DIVISION USING DBPARAMETERS VIEW-COMAREA.
005300 BEGIN-PROCESSING.
           PERFORM 1-HSK.
           PERFORM 6-MAIN UNTIL VIEW-LASTKEY = 3.
011900 2-EOJ.
           CLOSE DISPLAY-FILE.
012000     GOBACK.
       1-HSK.
           OPEN I-O   DISPLAY-FILE.
005400     CALL "TPWORD" USING PASSWORD-INFORMATION.
005800     IF PASSWORD-FLAG = "N"
005900         MOVE "  PWORD" TO BLOWUP-BASE
006000         MOVE "FAILED PASSWORD CHECK - TMUPDEXC"
006100             TO BU-DISPLAY-MSG
006200         PERFORM 998-BLOWUP.
           MOVE SPACES TO DSPLY-REC.
006900 6-MAIN.
006300     MOVE "FMUPDEXC" TO VIEW-CFNAME.
           MOVE 66346 TO CATREAD-MSG-NUMBER.
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
           MOVE ERROR-BUFFER TO SCREEN-CMD-LINE.
           MOVE SCREEN-BUFFER TO DSPLY-REC.
           PERFORM 99-SCREEN-WRITE.
           PERFORM 98-SCREEN-READ.
008100     IF VIEW-LASTKEY = 3 GO TO 2-EOJ.
008400     IF VIEW-LASTKEY = 1
009600         CALL "TIEREXES" USING DBPARAMETERS VIEW-COMAREA
010100         MOVE 0 TO VIEW-LASTKEY
010200         GO TO 6-MAIN.
010400     IF VIEW-LASTKEY = 2
010500         CALL "TDUPLSUB" USING DBPARAMETERS VIEW-COMAREA
010700         IF VIEW-LASTKEY = 1
010800             GO TO 2-EOJ
010900         ELSE
011000         MOVE 0 TO VIEW-LASTKEY
011100         GO TO 6-MAIN.
           IF VIEW-LASTKEY = 4
               MOVE "FMUPDEX1" TO VIEW-CFNAME
               PERFORM 60-DO-GENERICS UNTIL VIEW-LASTKEY = 3
               MOVE 0 TO VIEW-LASTKEY
               GO TO 6-MAIN.

       60-DO-GENERICS.
           IF INDS (99) = TRUE-VAL
               NEXT SENTENCE
           ELSE
           MOVE SPACES TO DSPLY-REC READ-BUFFER ERROR-BUFFER.
           MOVE READ-BUFFER TO DSPLY-REC.
           PERFORM 99-SCREEN-WRITE.
           PERFORM 98-SCREEN-READ.
           MOVE DSPLY-REC TO READ-BUFFER.
           IF VIEW-LASTKEY = 1
               IF READ-ITEM-1 = SPACES
                   MOVE 66120 TO CATREAD-MSG-NUMBER
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE ERROR-BUFFER TO READ-ERR-LINE
                   MOVE TRUE-VAL TO INDS (1) INDS (99)
                   GO TO 60-DO-GENERICS
               ELSE
               CALL "TMJOBPLN" USING DBPARAMETERS VIEW-COMAREA
                                 READ-BUFFER
               MOVE 0 TO VIEW-LASTKEY
               MOVE "FMUPDEX1" TO VIEW-CFNAME
           ELSE
           IF VIEW-LASTKEY = 2
               IF READ-ITEM-2 = SPACES
                   MOVE 66120 TO CATREAD-MSG-NUMBER
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE ERROR-BUFFER TO READ-ERR-LINE
                   MOVE TRUE-VAL TO INDS (2) INDS (99)
                   GO TO 60-DO-GENERICS
               ELSE
               CALL "TMMODMAT" USING DBPARAMETERS VIEW-COMAREA
                                 LANGUAGE-PARMS MASTER-PRTPLAN-DATA
               MOVE 0 TO VIEW-LASTKEY
               MOVE "FMUPDEX1" TO VIEW-NFNAME.
012100
       98-SCREEN-READ.
           READ DISPLAY-FILE FORMAT IS VIEW-CFNAME
               INDIC IS INDICS.
           ACCEPT IOFEEDBACK FROM I-O-FEEDBACK-AREA.
           MOVE ALL B"0" TO INDICS.
           IF DSPLY-STATUS NOT = "00"
               MOVE 3 TO VIEW-LASTKEY
           ELSE
           MOVE FUNCTION-NUM TO VIEW-LASTKEY.

       99-SCREEN-WRITE.
           WRITE DSPLY-REC FORMAT IS VIEW-CFNAME
               INDIC IS INDICS.
           MOVE ALL B"0" TO INDICS.

012900 998-BLOWUP.
013000     MOVE "TMUPDEXC" TO BU-PGM-NAME.
013100     CALL "TBLOWUP" USING BLOWUP-BASE BU-PGM-NAME STATUS-AREA
013200                      VIEW-COMAREA DUMMY-KSAM-STAT
013300                      BU-DISPLAY-MSG BU-DISPLAY-FLDS.

       999-CATREAD.
           MOVE SPACES TO ERROR-BUFFER.
           CALL "CCATREAD" USING CATREAD-PARMS.
           MOVE CATREAD-MSG-TEXT TO ERROR-BUFFER.
       999-CATREAD-EXIT.    EXIT.
