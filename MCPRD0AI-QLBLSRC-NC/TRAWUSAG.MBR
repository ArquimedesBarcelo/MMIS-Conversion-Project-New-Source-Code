           05  SORT-ONORDER         PIC S9(8).
           05  SORT-SHIP-MTD        PIC S9(8).
           05  SORT-SHIP-TODAY      PIC S9(8).
           05  SORT-NAME            PIC X(20).

       SD  SORT-FILE2
           RECORD CONTAINS 16 CHARACTERS.
       01  SORT-RCD2.
           05  SORT-CODE-2          PIC X(7).
           05  SORT-USED-TODAY      PIC S9(8).
           05  SROT-SHIP-TC-INDIC   PIC X(1).

       FD  USED-TODAY-FILE
           RECORD CONTAINS 16 CHARACTERS.
       01  USED-TODAY-RCD.
           05  TC-CODE              PIC X(7).
           05  TC-USED-TODAY        PIC S9(8).
           05  TC-SHIP-TO-INDIC     PIC X(1).

       FD  CODE-FILE
           RECORD CONTAINS 97 CHARACTERS.
       01  CODE-RCD.
           05  C-CODE               PIC X(7).
           05  C-CLASS              PIC X(3).
           05  C-UM                 PIC X(2).
           05  C-ONHAND             PIC S9(8).
           05  C-RECEIPT-MTD        PIC S9(8).
           05  C-RECEIPT-YESTER     PIC S9(8).
           05  C-MTD-USAGE          PIC S9(9).
           05  C-USED-TODAY         PIC S9(8).
           05  C-ONORDER            PIC S9(8).
           05  C-SHIP-MTD           PIC S9(8).
           05  C-SHIP-TODAY         PIC S9(8).
           05  C-NAME               PIC X(20).

