000300 IDENTIFICATION DIVISION.
000400 PROGRAM-ID.    TSUBCRFT.
000800*REMARKS.       CRAFTSMAN SUMMARY REPORT.
001000 ENVIRONMENT DIVISION.
001100 CONFIGURATION SECTION.
001200 SOURCE-COMPUTER.   AS400.
001300 OBJECT-COMPUTER.   AS400.
001400 COPY SPECIALN IN COPYLIB.
001600 INPUT-OUTPUT SECTION.
001700 FILE-CONTROL.
001800     SELECT OUT-FILE
001900         ASSIGN TO DATABASE-FILEOUT
               ORGANIZATION IS RELATIVE
002000         ACCESS MODE IS RANDOM
002100         RELATIVE KEY IS ACT-KEY
               FILE STATUS IS OF-STATUS.
002200
002300     SELECT PRINT-FILE
002400         ASSIGN TO PRINTER-MCPRT.
002500
002600     SELECT SORT-FILE
002700         ASSIGN TO DISK-SORTFILE.
002800
           SELECT SUM-FILE
               ASSIGN TO DATABASE-MCFPSUMFIL
               ORGANIZATION IS SEQUENTIAL
               ACCESS MODE IS SEQUENTIAL
               FILE STATUS IS SUM-STATUS.

           SELECT WO-BASIC-FILE
               ASSIGN TO DATABASE-MCFLMM1001
               ORGANIZATION IS INDEXED
               ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
               FILE STATUS IS WBF-STATUS.

           SELECT WO-LABOR-FILE
               ASSIGN TO DATABASE-MCFLMM1301
               ORGANIZATION IS INDEXED
               ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY WITH DUPLICATES
               FILE STATUS IS WLF-STATUS.

           SELECT WO-LAST-NUM-USED-FILE
               ASSIGN TO DATABASE-MCFPMM0800
               ORGANIZATION IS RELATIVE
               ACCESS MODE IS RANDOM
               RELATIVE KEY IS ARG-NO-9
               FILE STATUS IS WLNU-STATUS.

           SELECT WO-PLANNED-FILE
               ASSIGN TO DATABASE-MCFLMM1101
               ORGANIZATION IS INDEXED
               ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
               FILE STATUS IS WPF-STATUS.

