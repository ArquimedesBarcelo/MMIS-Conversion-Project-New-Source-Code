120000     MOVE DATE-WA-SAV2 TO LBR-COMPL-DATE.
120100     IF DATE-WA-9 = LBR-COMPL-DATE
120200         IF SHIFT-BUF = "A" OR LBR-SHIFT-1
120300             NEXT SENTENCE
120400         ELSE
120500         GO TO 7-SORT-DBGET
120600     ELSE
120700     GO TO 7-SORT-DBGET.
120800     MOVE LBR-WO-NUM       TO SORT-WO-NUM.
120900     MOVE LBR-EMPL-NAME    TO SORT-NAME.
121000     MOVE LBR-EMPL-NUM     TO SORT-NUM.
121100     MOVE PRIORITY         TO SORT-PRTY.
121200     MOVE ZONE             TO SORT-ZONE.
121300     MOVE LBR-SHIFT-1      TO SORT-SHIFT.
121400     COMPUTE HOLD-HRS = (LBR-HRS1-99 * 60) +
121500                        (LBR-HRS2-9 * 6).
121600     MOVE HOLD-HRS         TO SORT-HRS.
121700     IF ZONE-BUF = SPACES AND CRAFT-BUF NOT = SPACES
121800       MOVE "ALL " TO SORT-ZONE.
121900     RELEASE SORT-REC.
           GO TO 7-SORT-DBGET.
122500
       79-READ-WO-BASIC-FILE.
           MOVE 0 TO COND-WORD.
           READ WO-BASIC-FILE NEXT INTO WO-BASIC-DATA
               AT END    MOVE 15 TO COND-WORD.
           IF WBF-STATUS NOT = "00" MOVE 15 TO COND-WORD.
           IF ARG-NO NOT = WO-NUM MOVE 15 TO COND-WORD.

       79-READ-WO-PLANNED-FILE.
           MOVE 0 TO COND-WORD.
           READ WO-PLANNED-FILE NEXT INTO WO-PLANNED-DATA
               AT END    MOVE 15 TO COND-WORD.
           IF WPF-STATUS NOT = "00" MOVE 15 TO COND-WORD.
           IF ARG-NO NOT = WO-NUM-PLANNED MOVE 15 TO COND-WORD.

       79-START-WO-BASIC-FILE.
           MOVE 0 TO COND-WORD.
           MOVE ARG-NO TO WONUM OF WBFREC.
           START WO-BASIC-FILE KEY = EXTERNALLY-DESCRIBED-KEY
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF WBF-STATUS NOT = "00" MOVE 17 TO COND-WORD.

       79-START-WO-PLANNED-FILE.
           MOVE 0 TO COND-WORD.
           MOVE ARG-NO TO WONUM OF WPFREC.
           START WO-PLANNED-FILE KEY = EXTERNALLY-DESCRIBED-KEY
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF WPF-STATUS NOT = "00" MOVE 17 TO COND-WORD.

       7-SD-X.    EXIT.

       7-SORT-OUT.
123100     MOVE 0 TO ACT-KEY, RECS-WRITTEN-CTR.
123200     PERFORM 7-READ-SORT-FILE THRU 7-RSF-EXIT.
123400
123600 7-READ-SORT-FILE.
123700     RETURN SORT-FILE AT END
123800         MOVE 1 TO EOS-SW
123900         PERFORM 7-SORT-WRITE-REC THRU 7-SWR-EXIT
               MOVE ACT-KEY TO RECS-WRITTEN-CTR
124000         GO TO 7-RSF-EXIT.
124100     IF FIRST-SW-ON
124200         GO TO 7-FIRST-WRITE-PREP.
124300     IF SORT-ZONE = ZONE-SAVE
124400         IF SORT-SHIFT = SHIFT-SAVE
124500             IF SORT-NAME = NAME-SAVE
124600                 PERFORM 7-SORT-ADD-REC
124700             ELSE
124800             PERFORM 7-SORT-WRITE-REC THRU 7-SWR-EXIT
124900         ELSE
125000         PERFORM 7-SORT-WRITE-REC   THRU 7-SWR-EXIT
125100     ELSE
125200     PERFORM 7-SORT-WRITE-REC     THRU 7-SWR-EXIT.
125300     GO TO 7-READ-SORT-FILE.
125500
126000 7-FIRST-WRITE-PREP.
126100     MOVE 0 TO FIRST-SW.
126200     MOVE SORT-ZONE TO ZONE-SAVE.
126300     MOVE SORT-SHIFT TO SHIFT-SAVE.
126400     MOVE SORT-NAME TO NAME-SAVE.
126500     MOVE SORT-WO-NUM TO WO-NUM-SAVE.
126600     MOVE SPACES TO OUT-REC-X.
126700     MOVE ZEROS TO OUT-REC-9.
126800     MOVE SORT-NAME TO OUT-CRFT-NAME.
126900     MOVE SORT-NUM  TO OUT-CC-NUM.
127000     MOVE SORT-ZONE TO OUT-ZONE.
127100     MOVE SORT-SHIFT TO OUT-SHIFT.
127200     IF SORT-PRTY = 1
127300         ADD 1        TO OUT-P1-WOS
127400         ADD SORT-HRS TO OUT-P1-RETM
127500     ELSE
127600     IF SORT-PRTY = 2
127700         ADD 1        TO OUT-P2-WOS
127800         ADD SORT-HRS TO OUT-P2-RETM
127900     ELSE
128000     IF SORT-PRTY = 3
128100         ADD 1        TO OUT-P3-WOS
128200         ADD SORT-HRS TO OUT-P3-RETM
128300     ELSE
128400         ADD 1        TO OUT-PX-WOS
128500         ADD SORT-HRS TO OUT-PX-RETM.
128600     GO TO 7-READ-SORT-FILE.
128700
128900 7-SORT-ADD-REC.
129000     IF SORT-WO-NUM = WO-NUM-SAVE
129100         IF SORT-PRTY = 1
129200             ADD SORT-HRS TO OUT-P1-RETM
129300         ELSE
129400         IF SORT-PRTY = 2
129500             ADD SORT-HRS TO OUT-P2-RETM
129600         ELSE
129700         IF SORT-PRTY = 3
129800             ADD SORT-HRS TO OUT-P3-RETM
129900         ELSE
130000         ADD SORT-HRS TO OUT-PX-RETM
130100     ELSE
130200     MOVE SORT-WO-NUM TO WO-NUM-SAVE
130300     IF SORT-PRTY = 1
130400         ADD 1        TO OUT-P1-WOS
130500         ADD SORT-HRS TO OUT-P1-RETM
130600     ELSE
130700     IF SORT-PRTY = 2
130800         ADD 1        TO OUT-P2-WOS
130900         ADD SORT-HRS TO OUT-P2-RETM
131000     ELSE
131100     IF SORT-PRTY = 3
131200         ADD 1        TO OUT-P3-WOS
131300         ADD SORT-HRS TO OUT-P3-RETM
131400     ELSE
131500     ADD 1        TO OUT-PX-WOS
131600     ADD SORT-HRS TO OUT-PX-RETM.
131700
131900 7-SORT-WRITE-REC.
132000     IF FIRST-SW-ON GO TO 7-SWR-EXIT.
132100     ADD 1 TO ACT-KEY.
132200     WRITE OUT-REC INVALID KEY
132400         GO TO 2-END-OF-JOB.
132500     IF EOS-SW-ON GO TO 7-SWR-EXIT.
132600     MOVE SORT-ZONE TO ZONE-SAVE.
132700     MOVE SORT-SHIFT TO SHIFT-SAVE.
132800     MOVE SORT-NAME TO NAME-SAVE.
132900     MOVE SORT-WO-NUM TO WO-NUM-SAVE.
133000     MOVE SPACES TO OUT-REC-X.
133100     MOVE ZEROS TO OUT-REC-9.
133200     MOVE SORT-NAME TO OUT-CRFT-NAME.
133300     MOVE SORT-ZONE TO OUT-ZONE.
133400     MOVE SORT-SHIFT TO OUT-SHIFT.
133500     MOVE SORT-NUM  TO OUT-CC-NUM.
133600     IF SORT-PRTY = 1
133700         ADD 1        TO OUT-P1-WOS
133800         ADD SORT-HRS TO OUT-P1-RETM
133900     ELSE
134000     IF SORT-PRTY = 2
134100         ADD 1        TO OUT-P2-WOS
134200         ADD SORT-HRS TO OUT-P2-RETM
134300     ELSE
134400     IF SORT-PRTY = 3
