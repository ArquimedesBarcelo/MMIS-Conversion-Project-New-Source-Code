022000 01 SCREEN-INPUT.
022100     05  MERCHANT             PIC X(10).
022200     05  O-A-R-OPTION         PIC X.
           05  LOW-DATE.
               10  Y1               PIC XX.
               10  M1               PIC XX.
               10  D1               PIC XX.
           05  HI-DATE.
               10  Y2               PIC XX.
               10  M2               PIC XX.
               10  D2               PIC XX.
           05  RCVDEPT1             PIC X(6).
           05  RCVDEPT2             PIC X(6).
           05  RCVDEPT3             PIC X(6).
022300     05     FILLER            PIC X(39).
057800
057900 PROCEDURE DIVISION USING HD-ROUTE-DATA SCREEN-INPUT.
058000
058100 100-INPUT-AND-PASS-TO-XRSCREEN.

      *-----  IF DATE(S) PASSED TO PROGRAM ARE NUMERIC, THEN DETERMINE
      *-----  CENTURY AND FORMAT IN CYMD FORMAT, ELSE MOVE SPACES

           IF LOW-DATE NUMERIC
              MOVE LOW-DATE TO WL-YMD
              IF Y1 > "70"
                 MOVE "19" TO WL-CC
              ELSE
                 MOVE "20" TO WL-CC
           ELSE
              MOVE SPACES  TO WORK-LOW-DATE.
           IF HI-DATE NUMERIC
              MOVE HI-DATE TO WH-YMD
              IF Y2 > "70"
                 MOVE "19" TO WH-CC
              ELSE
                 MOVE "20" TO WH-CC
           ELSE
              MOVE SPACES  TO WORK-HI-DATE.

           MOVE MERCHANT TO VEN-ARG, PRT-VEND-CODE.
059200     IF O-A-R-OPTION = "O"
059300       MOVE "OPEN PURCHASE ORDERS" TO REPORT-TYPE
059400     ELSE
059500          IF O-A-R-OPTION = "A"
059600            MOVE "ALL PURCHASE ORDERS" TO REPORT-TYPE
059700     ELSE
059800          IF O-A-R-OPTION = "R"
059900            MOVE SPACES TO PRT-NOTE-1, PRT-NOTE-2
060000            MOVE "REQUIREMENT ORDERS" TO REPORT-TYPE.
060100
060200 175-REPORT-DATE.
060300       MOVE 1 TO DATE-MODE.
060400       CALL "TDATECHK" USING DATE-CHECK-AREA.
060500       MOVE DATE-SLASH-OUT TO ACT-DATE, SYS-DATE-X.
060600       MOVE DATE-YMD-OUT TO CUR-DATE2.
060700
       180-SET-UP-SELECTION-CRITERIA.
             MOVE Y1            TO PRT-Y1.
             MOVE M1            TO PRT-M1.
             MOVE D1            TO PRT-D1.
             MOVE Y2            TO PRT-Y2.
             MOVE M2            TO PRT-M2.
             MOVE D2            TO PRT-D2.
             MOVE RCVDEPT1      TO PRT-RCVDEPT1.
             MOVE RCVDEPT2      TO PRT-RCVDEPT2.
             MOVE RCVDEPT3      TO PRT-RCVDEPT3.


060800 200-OPEN-FILES-DBASE.
061800
      *------ CALL CCRTFILE TO CREATE A TEMPORARY FILE 'VENDOUT'
           MOVE "QTEMP"       TO CCRTFILE-LIBRARY.
           MOVE "VENDOUT"     TO CCRTFILE-FILE.
           MOVE "0043"        TO CCRTFILE-RECORD-LENGTH.
           MOVE "01000"       TO CCRTFILE-NO-RECORDS.
           MOVE "01000"       TO CCRTFILE-INCREMENT-AMT.
           MOVE "99"          TO CCRTFILE-NO-INCREMENTS.
           CALL "CCRTFILE" USING CCRTFILE-LIBRARY,
                                 CCRTFILE-FILE,
                                 CCRTFILE-RECORD-LENGTH,
                                 CCRTFILE-NO-RECORDS,
                                 CCRTFILE-INCREMENT-AMT,
                                 CCRTFILE-NO-INCREMENTS,
                                 CCRTFILE-STATUS.
           IF CCRTFILE-STATUS NOT = "00"
              DISPLAY "CCRTFILE CREATE OF 'VENDOUT' FAILED"
              GO TO 2000-BLOWUP.

033300*----------  PRINT HEADER PAGE
078400*----------  OPEN OUTPUT FILE
           MOVE HD-SPOOLER-NUMBER TO OVRPRTF-TOFILE-NUM.
           MOVE "*YES"       TO OVRPRTF-SHARED.
028100     MOVE HD-NO-OF-COPIES TO OVRPRTF-COPIES.
           MOVE "MCPRT"      TO OVRPRTF-FILE.
           PERFORM 996-OVERRIDE-PRINT-FILE.
021100     OPEN OUTPUT ONLINE-PRT.
033500     MOVE "DHDRPT6.PUB" TO HD-FILE-NAME.
033600     CALL "THDPRT2" USING HD-RET-CODE, HD-FILE-NAME,
033700        FNUM, HD-ROUTE-DATA, ESC-NAME.
033800     IF PAPER-IS-132-COLS
033900          NEXT SENTENCE
034000     ELSE
034100         WRITE PRINT-REC FROM COMPRESS-PRINT AFTER ADVANCING 0
034200         WRITE PRINT-REC FROM ESC-TEXT-61 AFTER ADVANCING 0.
034300     IF HD-RET-CODE NOT = 0
034400         DISPLAY "THDRPT ERROR".
062000       OPEN OUTPUT PO-HEADER-FILE.
062300
062400       MOVE 1 TO RET-CODE.
062500
063200      OPEN INPUT DVENDOR DPORECD DPOITEM.
063700 300-FIND-VENDOR.
           MOVE 0 TO COND-WORD.
           MOVE VEN-ARG TO VENCDE OF DVENDOR-REC.
           START DVENDOR KEY = VENCDE OF DVENDOR-REC
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
                   MOVE 17 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.
064000
064100         IF COND-WORD NOT EQUAL ZERO
064300             MOVE "*** VENDOR CODE DOES NOT EXIST ***"
064400               TO PRT-VEN-NAME
064500             PERFORM 880-START-PRINT
064600             PERFORM 900-CLOSE-ALL.
065000
065100 400-GET-VENDOR.
           MOVE 0 TO COND-WORD.
           READ DVENDOR NEXT INTO BUF-DVENDOR
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   MOVE 15 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.
           IF VENCDE OF DVENDOR-REC NOT = VEN-ARG
               MOVE 15 TO COND-WORD.
065400
065900         IF NOT GOOD-CALL
066000            GO TO 400-GET-VENDOR-X.
066100
066200
066300          IF VEN-ITM-NO = 0
066400             MOVE VEN-NAME           TO PRT-VEN-NAME.
066500
066600          IF VEN-ITM-NO = 1
066700             MOVE VEN-ADDRESS        TO PRT-VEN-STREET.
066800
066900          IF VEN-ITM-NO = 7
067000             MOVE VEN-STATE-CODE     TO PRT-VEN-STATE-CODE
067100             MOVE VEN-CITY           TO PRT-VEN-CITY
067200             MOVE VEN-PROV-CODE      TO PRT-VEN-PROV-CODE
067300             MOVE VEN-ZIP            TO PRT-VEN-ZIP.
067400
067500          IF VEN-ITM-NO = 8
067600             MOVE VEN-COUNTRY        TO PRT-VEN-COUNTRY.
067700
067800          IF VEN-ITM-NO = 9
067900             MOVE VEN-CONTACT        TO PRT-VEN-CONTACT
068000             MOVE VEN-CONTACT-PHONE  TO PRT-VEN-CONTACT-PHONE.
068100
068200       GO TO 400-GET-VENDOR.
068300
068400 400-GET-VENDOR-X.
068500       EXIT.
068600
068700 500-FIND-PO-HEADER.
           MOVE 0 TO COND-WORD.
           MOVE VEN-ARG TO VENCDE OF DPORECD-REC.
           START DPORECD KEY = VENCDE OF DPORECD-REC
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
                   MOVE 17 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.
069300
069400 550-GET-PO-HEADER.
           MOVE 0 TO COND-WORD.
           READ DPORECD NEXT INTO BUF-DPORECD
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   MOVE 15 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.
           IF VENCDE OF DPORECD-REC NOT = VEN-ARG
               MOVE 15 TO COND-WORD.
070200
070300     IF END-OF-CHAIN
               PERFORM 880-START-PRINT
               GO TO   700-READ-FILE
           ELSE
               IF GOOD-CALL
                   PERFORM 575-CHECK-CRITERIA THRU 575-CC-EXIT
                   IF CRITERIA-WORD = 15
                      MOVE 0 TO CRITERIA-WORD
                      GO TO 550-GET-PO-HEADER
070200             ELSE
                      NEXT SENTENCE
               ELSE
070500             GO TO   2000-BLOWUP.
070600
070700
070800           MOVE PO-RCV-NO       TO  PO-ARG, PO-KEY-OUT.
070900           MOVE PO-PO-NO        TO  PO-NO-OUT.
071000           MOVE PO-RLS-NO       TO  PO-RLSE-OUT.
071100           MOVE PO-DATE         TO  PO-DATE-OUT.
                 IF PO-SHIP-DATE = "AS REL" OR "BELOW "
                         OR "REC'D "
                     MOVE PO-DATE     TO  PO-SHIP-DATE-OUT
                                          PO-SHIP-DATE
                 ELSE
071200           MOVE PO-SHIP-DATE    TO  PO-SHIP-DATE-OUT.
071300           MOVE PO-EXPECT-DATE  TO  PO-EXPECT-DATE-OUT.
071400
071500       IF O-A-R-OPTION EQUAL "O"
071600           PERFORM 600-FIND-STR-OPEN-ITEMS
071700                      THRU 600-EXIT
071800            PERFORM 625-GET-STR-OPEN-ITEMS
071900                      THRU 625-EXIT UNTIL END-OF-CHAIN
072000             PERFORM 690-WRITE-OPEN-PO-HEADERS THRU 690-EXIT
072100              GO TO   550-GET-PO-HEADER
072200       ELSE
072300            WRITE PO-HEAD-REC
072400             GO TO 550-GET-PO-HEADER.
072500
093000 575-CHECK-CRITERIA.
070200     IF CRITERIA-WORD = 0
070200         IF SPACES = RCVDEPT1 AND
070200                     RCVDEPT2 AND
070200                     RCVDEPT3
070200             NEXT SENTENCE
070200         ELSE
070200             IF PO-RCV-DEPT = RCVDEPT1 OR
070200                              RCVDEPT2 OR
070200                              RCVDEPT3
070200                 NEXT SENTENCE
070200             ELSE
070200                 MOVE 15 TO CRITERIA-WORD.
070200
070200     IF CRITERIA-WORD = 0
070200         IF LOW-DATE = SPACES
070200             IF HI-DATE = SPACES
070200                 NEXT SENTENCE
070200             ELSE
070200                 IF PO-DATE-CN <= WORK-HI-DATE
070200                     NEXT SENTENCE
070200                 ELSE
070200                     MOVE 15 TO CRITERIA-WORD
070200         ELSE
070200             IF HI-DATE = SPACES
070200                 IF PO-DATE-CN >= WORK-LOW-DATE
070200                     NEXT SENTENCE
070200                 ELSE
070200                     MOVE 15 TO CRITERIA-WORD
070200             ELSE
070200                 IF (PO-DATE-CN >= WORK-LOW-DATE)
                     AND
070200                    (PO-DATE-CN <= WORK-HI-DATE)
070200                     NEXT SENTENCE
070200                 ELSE
070200                     MOVE 15 TO CRITERIA-WORD.

       575-CC-EXIT.
           EXIT.

072600
072700 600-FIND-STR-OPEN-ITEMS.
           MOVE 0 TO COND-WORD.
           MOVE PO-ARG TO PORCVNO OF DPOITEM-REC.
           START DPOITEM KEY = PORCVNO OF DPOITEM-REC
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
                   MOVE 17 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.
073000
073400 600-EXIT.
073500      EXIT.
073600
073700 625-GET-STR-OPEN-ITEMS.
           MOVE 0 TO COND-WORD.
           READ DPOITEM NEXT INTO BUF-DPOITEM
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   MOVE 15 TO COND-WORD
               ELSE
                   MOVE 15 TO COND-WORD.
           IF PORCVNO OF DPOITEM-REC NOT = PO-ARG
               MOVE 15 TO COND-WORD.
074200
074800          IF ITM-QTY-DLVR LESS THAN ITM-QTY-ORD
074900            MOVE "X" TO OPEN-ITEM-FLAG.
075000
075100 625-EXIT.
075200      EXIT.
075300
075400 690-WRITE-OPEN-PO-HEADERS.
075500        IF OPEN-ITEM-FLAG = "X"
075600          WRITE PO-HEAD-REC
075700          MOVE SPACE TO OPEN-ITEM-FLAG.
075800 690-EXIT.
075900        EXIT.
076000
076100*---------- END OF WRITE PO HEADER FILE ROUTINE.
076200
076300
076400*---------- START OF READ PO HEADER FILE ROUTINE.
076500
076600 700-READ-FILE.
076700       READ PO-HEADER-FILE; AT END
076800                               PERFORM 1300-SUMMARY-PAGE
076900                                       THRU 1300-EXIT
077000                               GO TO 900-CLOSE-ALL.
077100
077200     MOVE PO-KEY-OUT         TO PO-ARG.
077300     MOVE PO-NO-OUT          TO PRT-PO-NO.
077400     MOVE PO-RLSE-OUT        TO PRT-PO-RLSE.
077500     MOVE 4 TO DATE-MODE.
077600     IF PO-DATE-OUT NOT NUMERIC
077700       MOVE SPACES TO PRT-PO-DATE
077800     ELSE
077900       MOVE PO-DATE-OUT TO DATE-VALIDATE-IN
078000       CALL "TDATECHK" USING DATE-CHECK-AREA
