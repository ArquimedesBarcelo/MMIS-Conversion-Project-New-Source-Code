000200 IDENTIFICATION DIVISION.
000300 PROGRAM-ID.    TDELTPO.
000500 AUTHOR.        KUT MOVSESIAN/JIM COFFMAN (MAINTAINER).

000800***************************************************************
000900**                                                           **
001000**   TDELTPO.UTIL   - UTILITY PROGRAM FOR CALLING THE        **
001100**                    SUBROUTINE 'SDELTPO' WHICH DELETES     **
001200**                    A PURCHASE ORDER.                      **
001300**                                                           **
001400***************************************************************
      *
      *C  07/22/96   CA YODER
      *C    RE-COMPILED PROGRAM TO PICK UP CENTURY DATABASE CHANGES.
001600
001700 ENVIRONMENT DIVISION.
001800 CONFIGURATION SECTION.
001900 SOURCE-COMPUTER.  HP-3000.
002000 OBJECT-COMPUTER.  HP-3000.
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.

           SELECT DPORECD-I
                  ASSIGN TO DATABASE-MCFLCS0901
                  ORGANIZATION IS INDEXED
                    ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                    WITH DUPLICATES
                  FILE STATUS IS FILE-STATUS.

           SELECT MPORCV-O
                  ASSIGN TO DATABASE-MCFLCS0101
                  ORGANIZATION IS INDEXED
                    ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                  FILE STATUS IS FILE-STATUS.

           SELECT MPLTINFO-I
                  ASSIGN TO DATABASE-MCFLCS0501
                  ORGANIZATION IS INDEXED
                    ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                  FILE STATUS IS FILE-STATUS.

003600 DATA DIVISION.
       FILE SECTION.
       FD  DPORECD-I
           LABEL RECORDS ARE STANDARD.
       01  DPORECD-REC-I.
           COPY DDS-ALL-FORMATS  OF MCFLCS0901.

       FD  MPORCV-O
           LABEL RECORDS ARE STANDARD.
       01  MPORCV-REC-O.
           COPY DDS-ALL-FORMATS  OF MCFLCS0101.

       FD  MPLTINFO-I
           LABEL RECORDS ARE STANDARD.
       01  MPLTINFO-REC-I.
           COPY DDS-ALL-FORMATS  OF MCFLCS0501.


011200 WORKING-STORAGE SECTION.
       01  FILE-STATUS.
           05  FILE-STATUS-1            PIC X  VALUE "0".
           05  FILE-STATUS-2            PIC X  VALUE "0".
002100
002400 77 PUT-PO-IN-HIST-SW             PIC X(1)  VALUE SPACES.
002500
002600
002700**************************************************************
002800**************************************************************
002900**                                                          **
003000**                DATABASE I/O BUFFER AREA                  **
003100**                                                          **
003200**************************************************************
003300**************************************************************
003400
003500 COPY MPLTINFO IN COPYLIB.
003600
003700 COPY DPORECD IN COPYLIB.
003800
003900 COPY MPORCV IN COPYLIB.
004000
005400
005500 COPY DATAB IN COPYLIB.
005600
005700 COPY DBSTHIST IN COPYLIB.
005800
005900 01 ITEMS-LISTING.
006000     05  ALL-ITEMS                PIC XX    VALUE "@;".
006100     05  PO-SEARCH                PIC X(10) VALUE "PO-RCV-NO;".
006200
006300 01  ARG-VALUES.
006400     05  PLT-ARG                  PIC X(4)  VALUE SPACES.
006500     05  PO-ARG                   PIC X(14) VALUE SPACES.
006600
006900 01  PO-NUMBER                    PIC X(10).
007000
007100 01  BUILD-PO-NUM.
007200     05  FILLER                   PIC X(1)  VALUE "P".
007300     05  PO-NUM-REL               PIC X(10) VALUE SPACES.
007400     05  FILLER                   PIC X(3)  VALUE "000".
007500
007600 01  COMPANY-SAVE                 PIC X(3)  VALUE SPACES.
007700
007800 COPY TBLOWUP IN COPYLIB.
007900
008000 COPY VIEWDUM IN COPYLIB.
008100
008200 PROCEDURE DIVISION.
008300
008400 PROC-DIV SECTION 01.
008500
008600
008700 1-BEGIN.
008800     PERFORM 1-HSK THRU 1-H-X.
008900
009000     PERFORM 6-MAIN THRU 6-M-X.
009100
009200     PERFORM 2-EOJ  THRU 2-EOJ-X.
009300
009400     STOP RUN.
009500
009600 1-HSK.
009700
           OPEN INPUT MPLTINFO-I, DPORECD-I.
           OPEN I-O MPORCV-O.
011600
011700******************************************
011800*   GET CO. CODE FROM MPLTINFO
011900******************************************
012000
012100     MOVE "P 01"       TO PLT-ARG.
           MOVE PLT-ARG TO PLTINFOKEY OF MPLTINFO-REC-I.
           READ MPLTINFO-I INTO BUF-MPLTINFO
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
012500         MOVE "GET MPLTINFO 'P 01' *1-HSK" TO BU-DISPLAY-MSG
012600         GO TO 2-BLOWUP
012700     ELSE
012800         MOVE MPLTINFO-COMPANY  TO  COMPANY-SAVE.
012900
013000 1-H-X.
013100     EXIT.
013200
013300
013400 2-EOJ.
           CLOSE DPORECD-I, MPORCV-O, MPLTINFO-I.
014500
014600 2-EOJ-X.
014700     EXIT.
014800
014900*********************************************
015000*                                           *
015100*  BLOWUP ROUTINE EXECUTES WHENEVER A       *
015200*  FATAL ERROR OCCURS                       *
015300*                                           *
015400*********************************************
015500
015600 2-BLOWUP.
015700     MOVE "TDELTPO"  TO  BU-PGM-NAME.
015800     CALL "TBLOWUP" USING BASE, BU-PGM-NAME, STATUS-AREA,
015900         VIEW-COMAREA, FILE-STATUS, BU-DISPLAY-MSG,
016000             BU-DISPLAY-FLDS.
016100
016200
016300
016400**************************************************
016500*                                                *
016600*     6 - M A I N                                *
016700*                                                *
016800**************************************************
016900
017000
017100 6-MAIN.
017200     MOVE SPACES                  TO PO-NUMBER.
017300     DISPLAY "ENTER PO NUMBER TO DELETE X(10)".
017400     ACCEPT PO-NUMBER.
017500     IF PO-NUMBER = SPACES
017600         GO TO 6-M-X.
017700
017800     DISPLAY "PUT PO INTO THE HISTORY DATA BASE? (Y OR N)".
017900     ACCEPT PUT-PO-IN-HIST-SW.
018000     IF PUT-PO-IN-HIST-SW = "Y" OR "N"
018100         NEXT SENTENCE
018200     ELSE
018300         DISPLAY "INVALID RESPONSE; LETS TRY IT AGAIN"
018400         GO TO 6-MAIN.
018500
018600     MOVE PO-NUMBER               TO  PO-NUM-REL.
018700     MOVE BUILD-PO-NUM            TO  PO-ARG.
           MOVE 0 TO COND-WORD.
           MOVE PO-ARG TO PORCVNO OF DPORECD-REC-I.
           START DPORECD-I KEY = PORCVNO OF DPORECD-REC-I
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
019200             DISPLAY "PO DOESN'T EXIST; TRY AGAIN  ",
019300                 PO-NUMBER
019400             GO TO 6-MAIN
019500         ELSE
019600             MOVE "FIND DPORECD * 6-MAIN" TO BU-DISPLAY-MSG
019700             GO TO 2-BLOWUP.
           READ DPORECD-I NEXT INTO BUF-DPORECD
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14"
020200             DISPLAY "NO PO HEADER ENTRY; CANT PUT IN HISTORY"
020300             MOVE "N"             TO PUT-PO-IN-HIST-SW
020400         ELSE
020500             MOVE "GET DPORECD * 6-MAIN" TO BU-DISPLAY-MSG
020600             GO TO 2-BLOWUP.
           IF PORCVNO OF DPORECD-REC-I NOT = PO-ARG
020200         DISPLAY "NO PO HEADER ENTRY; CANT PUT IN HISTORY"
020300         MOVE "N"             TO PUT-PO-IN-HIST-SW.
020700
020800     IF PUT-PO-IN-HIST-SW = "Y"
020900         PERFORM 60-UPDATE-STORES-HISTORY  THRU 60-USH-X.
021000
021100     CALL "SDELTPO" USING BASE,
021200                           PO-ARG,
021300                           COMPANY-SAVE.
021400     DISPLAY "SUCCESSFUL CALL TO SDELTPO".
021500     GO TO 6-MAIN.
021600
021700 6-M-X.
021800     EXIT.
021900
022000 60-UPDATE-STORES-HISTORY.
           MOVE PO-ARG TO PORCVNO OF MPORCV-REC-O.
           READ MPORCV-O INTO BUF-MPORCV
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
023400         MOVE "GET MPORCV*60-USH" TO BU-DISPLAY-MSG
023500         GO TO 2-BLOWUP.
023600
023700********* IF 'PO-RCV-SEQ' IS = 'HISTOK' ON THE PO MASTER
023800********* 'MPORCV' THEN THIS MEANS THE PO HAS ALREADY BEEN
023900********* MOVED TO THE HISTORY DATA BASE AND THEREFORE IS
024000********* NOT COPIED OVER AGAIN.  OTHERWISE MARK 'PO-RCV-SEQ'
024100********* WITH 'HISTSP' AND CALL 'SPOHIST'.  IF 'SPOHIST'
024200********* SUCCESSFULLY COPYS THE PO OVER INTO THE HISTORY DB
024300********* THEN IT WILL MARK 'PO-RCV-SEQ' WITH A 'HISTOK'
024400********* INDICATOR
      ********* NOTE ADDED A REWRITE OF MPORCV EVEN IF PO-RCV-SEQ
      ********* WAS EQUAL TO 'HISTOK' SO THAT IT WOULD UNLOCK THE
      ********* RECORD FOR 'MPORCV'  KURT MOVSESIAN 10/23/91
024500
024600     IF M-PO-RCV-SEQ = "HISTOK"
               REWRITE MPORCV-REC-O FROM BUF-MPORCV
                   INVALID KEY MOVE FILE-STATUS TO FILE-STATUS
                      END-REWRITE
               IF FILE-STATUS NOT = "00"
025400             MOVE "UPDATE1 MPORCV * 60-USH" TO BU-DISPLAY-MSG
025500             GO TO 2-BLOWUP
               ELSE
024800             GO TO 60-USH-X.
024900
025000     MOVE "HISTSP" TO  M-PO-RCV-SEQ.
           REWRITE MPORCV-REC-O FROM BUF-MPORCV
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
025400         MOVE "UPDATE2 MPORCV*60-USH" TO BU-DISPLAY-MSG
025500         GO TO 2-BLOWUP.
025600
025900     CALL "SPOHIST" USING BASE,
026000                          BASE-STHIST,
026100                          BUF-DPORECD,
026200                          PO-ARG.
026300
026400 60-USH-X.
026500     EXIT.
