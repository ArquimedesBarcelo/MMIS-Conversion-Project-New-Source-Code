032400 6-MAIN.
           MOVE 0 TO LINE-CTR.
           OPEN INPUT MSTORERM, DRESERVE.
032500
032600
032700********************************
032800*                              *
032900*  MSTOREROOM - ONORDER & UM   *
033000*                              *
033100********************************
033200
033300 63-GET-STOREROOM.
033400
033500*    CALL "DBGET" USING BASE, DSET-STOREROOM, MODE7, STATUS-AREA,
033600*            ALL-ITEM-LIST, BUF-MSTORERM, CODE-ARG.
           MOVE 0 TO COND-WORD.
           MOVE CODE-ARG TO CORPCDE OF MSTORERM-REC.
           READ MSTORERM INTO BUF-MSTORERM
               INVALID KEY MOVE 17 TO COND-WORD.
           IF FILE-STATUS-1 = "2"
               MOVE 17 TO COND-WORD
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD.
033700
033800     IF COND-WORD NOT = 0
033900           MOVE "DBGET MSTORERM  -TRSRVINQ" TO BU-DISPLAY-MSG
034000           MOVE COND-WORD                   TO BU-DISPLAY-STAT
034100           MOVE CODE-ARG                    TO BU-DISPLAY-FLD
034200           MOVE "Y"                         TO FATAL-ERR-SW
034300           GO TO  999-GOBACK.
034400
034500     MOVE SPACES    TO      SCREEN-RESERVATION-INQUIRY.
034600
034700     MOVE STR-ONHAND             TO      SCREEN-ONHAND.
034800     MOVE STR-RESERVED           TO      SCREEN-RESERVED.
034900     MOVE CODE-ARG               TO      SCREEN-CODE.
035000     MOVE COMP-SCREEN-INDIC      TO      SCREEN-COMPANY.
035100
035200     SUBTRACT STR-RESERVED FROM STR-ONHAND
035300              GIVING SCREEN-AVAILABLE.
035400
035500
035600********************************
035700*                              *
035800*  DRESERVE - ALL OTHER DATA   *
035900*                              *
036000********************************
036100
036200 64-FIND-GET-DRESERVE.
036300
036400*    CALL "DBFIND" USING BASE, DSET-DRESERVE, MODE1, STATUS-AREA,
036500*            CODE-SEARCH, CODE-ARG.
           MOVE 0 TO COND-WORD.
           MOVE CODE-ARG TO CORPCDE OF DRESERVE-REC.
           START DRESERVE KEY >= CORPCDE OF DRESERVE-REC
               INVALID KEY MOVE 0 TO COND-WORD.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
                   MOVE 0 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.
036600
036700     IF COND-WORD NOT = 0
036800           MOVE "DBFIND DRESERVE -TRSRVINQ" TO BU-DISPLAY-MSG
036900           MOVE COND-WORD                   TO BU-DISPLAY-STAT
037000           MOVE CODE-ARG                    TO BU-DISPLAY-FLD
037100           MOVE "Y"                         TO FATAL-ERR-SW
037200           GO TO  999-GOBACK.
037300
037400
037500     MOVE 1    TO  LINE-CTR.
037600
037700 64-GET-RESERVE.
037800
037900*    CALL "DBGET" USING BASE, DSET-DRESERVE, MODE5, STATUS-AREA,
038000*            ALL-ITEM-LIST, BUF-DRESERVE, CODE-ARG.
           MOVE 0 TO COND-WORD.
           READ DRESERVE NEXT INTO BUF-DRESERVE
               AT END MOVE 15 TO COND-WORD.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   MOVE 15 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.
           IF CORPCDE OF DRESERVE-REC NOT = CODE-ARG
               MOVE 15 TO COND-WORD.
038100
038200     IF COND-WORD NOT = 0
038300         IF COND-WORD = 15
038400            GO TO 64-FIND-GET-RESERVE-X
038500         ELSE
038600           MOVE "DBGET  DRESERVE -TRSRVINQ" TO BU-DISPLAY-MSG
038700           MOVE COND-WORD                   TO BU-DISPLAY-STAT
038800           MOVE CODE-ARG                    TO BU-DISPLAY-FLD
038900           MOVE "Y"                         TO FATAL-ERR-SW
039000           GO TO  999-GOBACK.
039100
039200
039300     MOVE SPACES          TO  HOLD-SCREEN-DATA-LINE.
039400
039500     MOVE RSRV-WONO       TO  SCREEN-WORKORDER.
039600     MOVE RSRV-QTY        TO  SCREEN-QUANTITY.
039700     MOVE RSRV-MACH       TO  SCREEN-MACHINE.
039800     MOVE RSRV-STAGE-LOC  TO  SCREEN-STAGE-LOC.
039900     MOVE RSRV-DATE       TO  DATE-VALIDATE-IN.
040000     MOVE 4               TO  DATE-MODE.
040100     CALL "TDATECK2" USING DATE-CHECK-AREA, LANGUAGE-PARMS.
040200     MOVE DATE-SLASH-OUT  TO  SCREEN-DATE-RSVD.
040300
040400     MOVE HOLD-SCREEN-DATA-LINE TO SCREEN-DATA (LINE-CTR).
040500
040600
040700     ADD 1 TO LINE-CTR.
040800
040900     IF LINE-CTR > 15
041000         GO TO 64-FIND-GET-RESERVE-X.
041100
041200
041300     GO TO 64-GET-RESERVE.
041400
041500 64-FIND-GET-RESERVE-X.
