           COPY DWOOPENQ       IN COPYLIB.

       01  LABOR-CURR-DATA.
           COPY DCURRLBR       IN COPYLIB.

       01  MESSAGE-BUFFER-DATA.
           COPY ERRORLIN       IN COPYLIB.

       LINKAGE SECTION.
       01  DBPARAMETERS.
           COPY DBPARMS        IN COPYLIB.

       01  WO-TRACK-DATA.
           COPY DWOTRACK       IN COPYLIB.

       01  WO-NUMBER-WORK.
           05  WO-NUM-WORK-1-6         PIC X(6).
           05  WO-NUM-WORK-7           PIC X.
           05  WO-NUM-WORK-8-10        PIC XXX.

       01  SCREEN-DATA.
           05  CRAFT-BUF               PIC X(04).
           05  STAT-BUF                PIC XX.
           05  WO-NUM-BUF.
               10  WO-BUF-6            PIC X(06).
               10  WO-YR-BUF           PIC X.
               10  WO-SUF-BUF          PIC XXX.
           05  FAIL-BUF.
               10  FAIL-BUF-1-2.
                   15  FAIL-BUF-1      PIC X.
                   15  FAIL-BUF-2      PIC X.
               10  FAIL-BUF-3-6.
                   15  FAIL-BUF-3      PIC X.
                   15  FAIL-BUF-4      PIC X.
                   15  FAIL-BUF-5      PIC X.
                   15  FAIL-BUF-6      PIC X.
           05  TIME-BUF.
               10  HRS-BUF             PIC XX.
               10  MIN-BUF             PIC XX.
           05  DATE-BUF.
               10  MM-BUF              PIC XX.
               10  DD-BUF              PIC XX.
               10  YY-BUF              PIC XX.
           05  COMM-BUF                PIC X(60).
           05  ERR-MSG-A.
               10  MSGA-1-38           PIC X(38).
               10  MSGA-39-76          PIC X(38).
           05  ERR-MSG-B.
               10  MSGB-1-38           PIC X(38).
               10  MSGB-39-76          PIC X(38).
           05  ERR-MSG-C.
               10  MSGC1               PIC X(10).
               10  I-DATE.
                   15  I-MM            PIC XX.
                   15  I-DD            PIC XX.
                   15  I-YY            PIC XX.
