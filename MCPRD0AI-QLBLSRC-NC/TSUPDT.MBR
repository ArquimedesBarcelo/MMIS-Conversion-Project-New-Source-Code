       77  QUEUE-PRTY          PIC 9      VALUE ZEROS.
       77  QUEUE-SW            PIC X.
       77  QUEUE-ERROR         PIC X(76).
       77  JUL-DAY-RECD        PIC S9(8)  VALUE ZEROS.
       77  JUL-DAY-STRT        PIC S9(8)  VALUE ZEROS.
       77  JUL-DAY-COMP        PIC S9(8)  VALUE ZEROS.
       77  JUL-DAY-SAVE        PIC S9(8)  VALUE ZEROS.
       77  TCOMP-MIN           PIC S9(6)  VALUE ZEROS.
       77  TRECD-MIN           PIC S9(6)  VALUE ZEROS.
       77  TSAVE-MIN           PIC S9(6)  VALUE ZEROS.
       77  TSTRT-MIN           PIC S9(6)  VALUE ZEROS.
       77  TRUE-VAL            PIC 1      VALUE B"1".
       77  FALS-VAL            PIC 1      VALUE B"0".
       77  D-PARM              PIC X.
       77  L-PARM              PIC X.

