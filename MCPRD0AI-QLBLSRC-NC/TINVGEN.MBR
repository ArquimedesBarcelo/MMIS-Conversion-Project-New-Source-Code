           05  PIC X(6).
           05  PIC X(19) VALUE "     UNIT PRICE    ".
           05  PIC X(4).
           05  PIC X(15) VALUE "    QUANTITY   ".
           05  PIC X(4).
           05  PIC X(2)  VALUE "UM".
           05  PIC X(25).

       01  PRT-RAW-HDG-4U.
           05  PIC X(38).
           05  PIC X(4)  VALUE ALL "-".
           05  PIC X(6).
           05  PIC X(9)  VALUE ALL "-".
           05  PIC X(6).
           05  PIC X(19) VALUE ALL "-".
           05  PIC X(4).
           05  PIC X(15)  VALUE ALL "-".
           05  PIC X(4).
           05  PIC X(2) VALUE ALL "-".
           05  PIC X(25).

       01  PRT-RAW-DTL-1.
           05                     PIC X(2).
           05  PRT-RAW-DTL-1-CHK  PIC X(8).
           05                     PIC X(3).
           05  PRT-RAW-DTL-1-DUE  PIC Z,ZZZ,ZZZ,ZZZ,ZZ9.99-.
           05                     PIC X(4).
           05  PRT-RAW-DTL-1-VEN  PIC X(44).
           05                     PIC X(4).
           05  PRT-RAW-DTL-1-PO   PIC X(7).
           05                     PIC X    VALUE "-".
           05  PRT-RAW-DTL-1-RLS  PIC X(3).
           05                     PIC X    VALUE "-".
