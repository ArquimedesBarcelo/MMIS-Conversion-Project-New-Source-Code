      ******************************************************************
       PROCEDURE DIVISION.
      ******************************************************************

      *-----------------------------------------------------------------
       1-ABSTFILE SECTION.
      *-----------------------------------------------------------------

       1-0-START-HERE.
           PERFORM 1-1-HSK.

      *----CONFIRM PLANT IS USING CSIS INVOICE PROCESSING

           IF S-INVOICE-IND = "Y"
              PERFORM 1-6-MAIN THRU 1-6-M-X
           ELSE
              DISPLAY "CSIS INVOICE PROCESSING NOT ACTIVE".
           PERFORM 1-2-EOJ.
           GOBACK.

       1-1-HSK.
9406CK     MOVE "C" TO SCOPE.
9406CK     CALL "MCXCBLERR" USING SCOPE.

           OPEN INPUT   ABSTFILE-I   MPLTINFO-I     MSTORERM-I
                        DRCVITEM-I   DPOFREIGHT-I   DINVRCD-I
                        MTAX-I       DINVITM-I      DINVACCT-I
                        DVENDOR-I    DPOITEM-I      DPORECD-I
9301CK                  DINVRCD-I-INV.
           OPEN I-O     MPLTINFO-O   DINVACCT-O     DINVRCD-O
                        DINVITM-O    DPOITEM-O      DPORECD-O.
           OPEN EXTEND  REPORT-ERR   REPORT-SUM     REPORT-RAW
                        REPORT-NCHK.

           ACCEPT CURRENT-DATE FROM DATE.
      *---------- ACCOUNT FOR CENTURY.
           IF CURRENT-YY > "70"
               MOVE "19"    TO  CURRENT-CC
           ELSE
               MOVE "20"    TO  CURRENT-CC.
           ACCEPT CURRENT-TIME FROM TIME.

      *----GET ABSTFILE SEQUENCE NUMBER TO LOOK FOR
      *----AND CSIS INVOICE PROCESSING INDICATOR.

           MOVE "PODL" TO PLT-ARG.
           PERFORM 9999-READ-MPLTINFO-I.
           IF FILE-STATUS-1 = "2"
              MOVE "MPLTINFO: PODL NOT FOUND*1-1-H" TO BU-DISPLAY-MSG
              GO TO 9999-BLOWUP.
           MOVE MPLTINFO-INV-ABST-SEQ TO S-EXPECTED-ABST-SEQ.
           IF MPLTINFO-INV-LAST-ABST NOT NUMERIC
              MOVE 2 TO S-LAST-ABST-NUMERIC
           ELSE
              MOVE MPLTINFO-INV-LAST-ABST TO S-LAST-ABST-NUMERIC.
           MOVE MPLTINFO-INVOICE-IND TO S-INVOICE-IND.
           IF MPLTINFO-NON-RAWMTL-DLR-LMT NOT NUMERIC
              MOVE ZEROS TO S-NON-RAWMTL-DOLLAR-LIMIT
           ELSE
9405CK        MOVE MPLTINFO-NON-RAWMTL-DLR-LMT
9405CK             TO S-NON-RAWMTL-DOLLAR-LIMIT.

           MOVE "*" TO           ERR-CTL   SUM-CTL   RAW-CTL
                                 NCHK-CTL.
           STRING CURRENT-DATE " " CURRENT-DATE-CN DELIMITED BY SIZE
                                 INTO SUM-LINE.
           STRING CURRENT-DATE " " CURRENT-DATE-CN DELIMITED BY SIZE
                                 INTO NCHK-LINE.
      **** MOVE CURRENT-DATE TO  ERR-LINE  SUM-LINE  RAW-LINE.
           MOVE CURRENT-DATE TO  ERR-LINE  RAW-LINE.
           WRITE REPORT-ERR-REC.
           WRITE REPORT-SUM-REC.
           WRITE REPORT-RAW-REC.
           WRITE REPORT-NCHK-REC.

      *----GET ALL TAX TYPES, SET UP GST INDEX AND CHECK FOR
      *----DOUBLE TAXATION. PTX1 MUST EXIST. PTX2 DOESN'T HAVE TO.

           INITIALIZE S-TAX-TABLE
                      923-TABLE.
           MOVE "PTX1" TO PLT-ARG.
           PERFORM 9999-READ-MPLTINFO-I.
           IF FILE-STATUS-1  = "2"
              MOVE "MPLTINFO: PTX1 NOT FOUND*1-1-H" TO BU-DISPLAY-MSG
              GO TO 9999-BLOWUP.

           MOVE MPLTINFO-TAX-DISTRICT (1) TO S-TAX-DISTRICT (1).
           MOVE MPLTINFO-TAX-CE-ACCTG (1)
              TO S-TAX-DISTRICT-CE-ACCTG (1).
           MOVE MPLTINFO-TAX-DISTRICT (2) TO S-TAX-DISTRICT (2).
           MOVE MPLTINFO-TAX-CE-ACCTG (2)
              TO S-TAX-DISTRICT-CE-ACCTG (2).

           MOVE "PTX2" TO PLT-ARG.
           PERFORM 9999-READ-MPLTINFO-I.
           IF FILE-STATUS-1 NOT = "2"
              MOVE MPLTINFO-TAX-DISTRICT (1) TO S-TAX-DISTRICT (3)
              MOVE MPLTINFO-TAX-CE-ACCTG (1)
                 TO S-TAX-DISTRICT-CE-ACCTG (3)
              MOVE MPLTINFO-TAX-DISTRICT (2) TO S-TAX-DISTRICT (4)
              MOVE MPLTINFO-TAX-CE-ACCTG (2)
                 TO S-TAX-DISTRICT-CE-ACCTG (4).

           INITIALIZE GST-IX.
           PERFORM VARYING TEMP-IX FROM 1 BY 1
              UNTIL TEMP-IX > 4  OR  GST-IX > 0
              IF S-TAX-DISTRICT (TEMP-IX) = "GST"
                 MOVE TEMP-IX TO GST-IX
              END-IF
           END-PERFORM.

      *----CHECK FOR EXISTENCE OF TAXGST FILE. IF IT EXITS THIS MEANS
      *----TO APPLY TAXES OTHER THAN GST ON BASE + GST (DBL TAXATION).

           OPEN INPUT TAXGST-I.
           IF FILE-STATUS  = "00"
              MOVE "Y" TO TAX-ON-GST
           ELSE
              MOVE "N" TO TAX-ON-GST
           CLOSE TAXGST-I.

9405CK*----CHECK IF THE PLANT IS ALLOWED BY THE STATE TO
  .   *----REDUCE ACCRUED TAXES.
  .
  .        MOVE "PREG" TO PLT-ARG.
  .        PERFORM 9999-READ-MPLTINFO-I.
9405CK     MOVE MPLTINFO-DISCOUNT-TAX-SW TO S-DISCOUNT-TAX-SW.

      *----CREATE TEMPORARY FILE TO HOLD RECEIVING
      *----TRANSACTIONS FROM THE ABSTFILE BEING PROCESSED.

           INITIALIZE          CCRTFILE-PARMS.
           MOVE "QTEMP"     TO CCRTFILE-LIBRARY.
           MOVE "RECEIVER"  TO CCRTFILE-FILE.
           MOVE "0035"      TO CCRTFILE-RECORD-LENGTH.
           MOVE "03000"     TO CCRTFILE-NO-RECORDS.
           MOVE "00500"     TO CCRTFILE-INCREMENT-AMT.
           MOVE  04         TO CCRTFILE-NO-INCREMENTS.
           CALL "CCRTFILE" USING CCRTFILE-LIBRARY,
                                 CCRTFILE-FILE,
                                 CCRTFILE-RECORD-LENGTH,
                                 CCRTFILE-NO-RECORDS,
                                 CCRTFILE-INCREMENT-AMT,
                                 CCRTFILE-NO-INCREMENTS,
                                 CCRTFILE-STATUS.
           IF CCRTFILE-STATUS NOT = "00"
              MOVE "CCRTFILE RECEIVER FAILED*1-1-H" TO BU-DISPLAY-MSG
              GO TO 9999-BLOWUP.

      *----CREATE TEMPORARY FILE TO HOLD INVOICE SUMMARY
      *----INFORMATION USED TO PRODUCE SUMMARY REPORT.

           INITIALIZE          CCRTFILE-PARMS.
           MOVE "QTEMP"     TO CCRTFILE-LIBRARY.
           MOVE "SUMFILE "  TO CCRTFILE-FILE.
           MOVE "0102"      TO CCRTFILE-RECORD-LENGTH.
           MOVE "03000"     TO CCRTFILE-NO-RECORDS.
           MOVE "00500"     TO CCRTFILE-INCREMENT-AMT.
           MOVE  04         TO CCRTFILE-NO-INCREMENTS.
           CALL "CCRTFILE" USING CCRTFILE-LIBRARY,
                                 CCRTFILE-FILE,
                                 CCRTFILE-RECORD-LENGTH,
                                 CCRTFILE-NO-RECORDS,
                                 CCRTFILE-INCREMENT-AMT,
                                 CCRTFILE-NO-INCREMENTS,
                                 CCRTFILE-STATUS.
           IF CCRTFILE-STATUS NOT = "00"
              MOVE "CCRTFILE SUMFILE FAILED*1-1-H" TO BU-DISPLAY-MSG
              GO TO 9999-BLOWUP.

      *----CREATE TEMPORARY FILE TO HOLD RAW MATERIAL INVOICE
      *----INFORMATION USED TO PRODUCE RAW MATERIAL REPORT.

           INITIALIZE          CCRTFILE-PARMS.
           MOVE "QTEMP"     TO CCRTFILE-LIBRARY.
           MOVE "RAWFILE "  TO CCRTFILE-FILE.
           MOVE "0146"      TO CCRTFILE-RECORD-LENGTH.
           MOVE "03000"     TO CCRTFILE-NO-RECORDS.
           MOVE "00500"     TO CCRTFILE-INCREMENT-AMT.
           MOVE  04         TO CCRTFILE-NO-INCREMENTS.
           CALL "CCRTFILE" USING CCRTFILE-LIBRARY,
                                 CCRTFILE-FILE,
                                 CCRTFILE-RECORD-LENGTH,
                                 CCRTFILE-NO-RECORDS,
                                 CCRTFILE-INCREMENT-AMT,
                                 CCRTFILE-NO-INCREMENTS,
                                 CCRTFILE-STATUS.
           IF CCRTFILE-STATUS NOT = "00"
              MOVE "CCRTFILE RAWFILE FAILED*1-1-H" TO BU-DISPLAY-MSG
              GO TO 9999-BLOWUP.

      *----CREATE TEMPORARY FILE TO HOLD NO-CHECK INVOICE
      *----INFORMATION USED TO PRODUCE NO-CHECK REPORT.

           INITIALIZE          CCRTFILE-PARMS.
           MOVE "QTEMP"     TO CCRTFILE-LIBRARY.
           MOVE "NOCHECK "  TO CCRTFILE-FILE.
           MOVE "0148"      TO CCRTFILE-RECORD-LENGTH.
           MOVE "03000"     TO CCRTFILE-NO-RECORDS.
           MOVE "00500"     TO CCRTFILE-INCREMENT-AMT.
           MOVE  04         TO CCRTFILE-NO-INCREMENTS.
           CALL "CCRTFILE" USING CCRTFILE-LIBRARY,
                                 CCRTFILE-FILE,
                                 CCRTFILE-RECORD-LENGTH,
                                 CCRTFILE-NO-RECORDS,
                                 CCRTFILE-INCREMENT-AMT,
                                 CCRTFILE-NO-INCREMENTS,
                                 CCRTFILE-STATUS.
           IF CCRTFILE-STATUS NOT = "00"
              MOVE "CCRTFILE NOCHECK FAILED*1-1-H" TO BU-DISPLAY-MSG
              GO TO 9999-BLOWUP.

       1-2-EOJ.
           CLOSE   ABSTFILE-I   MPLTINFO-I     MSTORERM-I
                   DRCVITEM-I   DPOFREIGHT-I   DINVRCD-I
                   MTAX-I       DINVITM-I      DINVACCT-I
                   DVENDOR-I    DPOITEM-I      DPORECD-I
                   MPLTINFO-O   DINVACCT-O     DINVRCD-O
                   DINVITM-O    DPOITEM-O      DPORECD-O
                   REPORT-ERR   REPORT-SUM     REPORT-RAW
                   REPORT-NCHK.

       1-6-MAIN.
           MOVE "N" TO LAST-FILE-PROCESSED.

      *----CHECK ALL ABSTFILES FROM ABSTFI10 DOWN TO ABSTFIL2

           PERFORM VARYING CUR-ABST FROM 9 BY -1
              UNTIL LAST-FILE-PROCESSED = "Y"

      *-------EDIT FIRST RECORD OF ABSTFILE FOR ERRORS

              PERFORM 9999-READ-ABSTFILE-I
              IF ABSTFILE-EOF = "Y"
                 MOVE "FOUND EMPTY ABSTFILE*1-6-M" TO BU-DISPLAY-MSG
                 MOVE OVR-FILE-NAME       TO BU-DISPLAY-FLD (1)
                 MOVE "LOOKNG FOR SEQ"    TO BU-DISPLAY-FLD (2)
                 MOVE S-EXPECTED-ABST-SEQ TO BU-DISPLAY-FLD (3)
                 GO TO 9999-BLOWUP
              END-IF
              MOVE TC900-CUTOFF-SEQ TO S-001-CUTOFF-SEQ
              MOVE DDAILYTC-DATE TO S-CUTOFF-DATE
      *------------ ACCOUNT FOR CENTURY.
              IF S-CUTOFF-YY > "70"
                  MOVE "19"                 TO S-CUTOFF-CC
              ELSE
                  MOVE "20"                 TO S-CUTOFF-CC
              END-IF
              IF DDAILYTC-TC NOT = "001"
                 MOVE "ABSTFILE MISSING 001 REC*1-6-M"
                    TO BU-DISPLAY-MSG
                 MOVE OVR-FILE-NAME         TO BU-DISPLAY-FLD (1)
                 MOVE "LOOKNG FOR SEQ"      TO BU-DISPLAY-FLD (2)
                 MOVE S-EXPECTED-ABST-SEQ   TO BU-DISPLAY-FLD (3)
                 GO TO 9999-BLOWUP
              END-IF
              IF S-001-CUTOFF-SEQ > S-EXPECTED-ABST-SEQ
                 MOVE "CORRECT ABSTFILE NOT FOUND*1-6-M"
                    TO BU-DISPLAY-MSG
                 MOVE "LOOKNG FOR SEQ"    TO BU-DISPLAY-FLD (1)
                 MOVE S-EXPECTED-ABST-SEQ TO BU-DISPLAY-FLD (2)
                 MOVE "STARTED AT SEQ"    TO BU-DISPLAY-FLD (3)
                 MOVE S-001-CUTOFF-SEQ    TO BU-DISPLAY-FLD (4)
                 GO TO 9999-BLOWUP
              END-IF

      *-------IF SEQ NUMBER MATCHES EXPECTED SEQ NUMBER, PROCESS FILE

              IF S-001-CUTOFF-SEQ = S-EXPECTED-ABST-SEQ
                 DISPLAY "** USING ABSTFILE SEQUENCE # "
                                                 S-001-CUTOFF-SEQ
                 OPEN OUTPUT RECEIVER-T

      *----------READ ALL RECORDS TO FIND TRAILER RECORD (TC900)

                 MOVE "N" TO FILE-OK
                 PERFORM UNTIL FILE-OK = "Y"
                    PERFORM 9999-READ-ABSTFILE-I
                    IF ABSTFILE-EOF = "Y"
                       MOVE "TC900 REC NOT FOUND*1-6-M"
                         TO BU-DISPLAY-MSG
                       MOVE OVR-FILE-NAME TO BU-DISPLAY-FLD (1)
                       GO TO 9999-BLOWUP
                    END-IF

      *-------------WHILE READING THRU RECORDS PUT NEEDED RECEIVER
      *-------------RECORDS INTO TEMP FILE

      *------------ ADDED CHECK FOR BATCH RECEIVING TRANSACTIONS.
                    IF DDAILYTC-TC = "323" OR "324" OR "523" OR "524"
                       INITIALIZE BUF-RECEIVER
                       MOVE TC323-RS      TO RECEIVER-RS-FULL
                       MOVE TC323-ITEM    TO RECEIVER-ITEM
      *--------------- KEEP TRACK OF THE RECORD NUMBER SO THAT THE
      *--------------- PROGRAM CAN LATER MATCH THEM UP WITH THE 9XX
      *--------------- TRANSACTIONS.     06/22/1995
                       ADD 1              TO LAST-REC-NUM
                       MOVE LAST-REC-NUM  TO RECEIVER-REC-NUM
                       MOVE TC323-UM      TO RECEIVER-UM
                       IF TC323-CORPCODE = "NON-STR"
                          MOVE TC323-NONCODED-RCV-QTY
                             TO RECEIVER-NET-CHG-QTY
                       ELSE
                          MOVE TC323-CODED-RCV-QTY
                             TO RECEIVER-NET-CHG-QTY
                       END-IF
                       WRITE RECEIVER-T-REC FROM BUF-RECEIVER
                    END-IF
      *------------ ADDED CHECK FOR BATCH RECEIVING TRANSACTIONS.
                    IF DDAILYTC-TC = "423" OR "424" OR "623" OR "624"
                       INITIALIZE BUF-RECEIVER
                       MOVE "P"           TO RECEIVER-PREFIX
                       MOVE TC423-RS      TO RECEIVER-RS-PART
                       MOVE TC423-ITEM    TO RECEIVER-ITEM
                       ADD 1              TO LAST-REC-NUM
                       MOVE LAST-REC-NUM  TO RECEIVER-REC-NUM
                       MOVE TC423-UM      TO RECEIVER-UM
                       IF TC423-CORPCODE = "NON-STR"
                          MOVE TC423-NONCODED-RCV-QTY
                             TO RECEIVER-NET-CHG-QTY
                       ELSE
                          MOVE TC423-CODED-RCV-QTY
                             TO RECEIVER-NET-CHG-QTY
                       END-IF
                       WRITE RECEIVER-T-REC FROM BUF-RECEIVER
                    END-IF
9506CY*------------ MOVE 923 AND 924 TO TABLE.
  .                 IF DDAILYTC-TC = "923" OR "924"
  .                    MOVE TC923-RS         TO TBL-9-RCVR-RS-FULL (SUB)
  .                    MOVE TC923-ITEM       TO TBL-9-RCVR-ITEM (SUB)
  .   *--------------- SINCE LAST-REC-NUM WAS NOT INCREMENTED SINCE THE
  .   *--------------- LAST WRITE, IT WILL CONTAIN THE RECORD NUMBER OF
  .   *--------------- TRANSACTION WHICH CORRESPONDS WITH THIS 923 OR 924.
  .                    MOVE LAST-REC-NUM     TO TBL-9-REC-NUM   (SUB)
  .                    MOVE TC923-UM         TO TBL-9-RCVR-UM   (SUB)
  .                    MOVE TC923-RCV-QTY
  .                                   TO TBL-9-RCVR-NET-CHG-QTY (SUB)
  .                    MOVE "Y" TO 923-924-FOUND-SW
  .                    ADD 1 TO SUB
  .                    IF SUB > 200
  .                        MOVE "923 TABLE SIZE EXCEEDED*1-6-M"
  .                            TO BU-DISPLAY-MSG
  .                        GO TO 9999-BLOWUP
  .                    END-IF
9506CY              END-IF

      *-------------IF TRAILER REC FOUND, MATCH IT TO HEADER

                    IF DDAILYTC-TC = "900"

      *----------------IF HEADER AND TRAILER SEQ MATCH, THEN
      *----------------CLOSE, SORT AND PROCESS TEMPORARY FILE

                       IF TC900-CUTOFF-SEQ = S-001-CUTOFF-SEQ
                          MOVE "Y" TO FILE-OK
                          CLOSE RECEIVER-T
                          SORT SORT-FILE ON ASCENDING KEY SORT-KEY
                             USING RECEIVER-T
                             OUTPUT PROCEDURE IS 8-RECEIVER
                                            THRU 8-RECEIVER-X

      *-------------------UPDATE MPLTINFO "PODL" ABSTFILE SEQ NUMBER

                          MOVE "PODL" TO PLT-ARG
                          PERFORM 9999-READ-MPLTINFO-O
                          IF FILE-STATUS-1 = "2"
                             MOVE "MPLTINFO: PODL NOT FOUND*1-6-M"
                                TO BU-DISPLAY-MSG
                             GO TO 9999-BLOWUP
                          END-IF
                          ADD 1 TO MPLTINFO-INV-ABST-SEQ
                          MOVE MPLTINFO-INV-ABST-SEQ
                             TO S-EXPECTED-ABST-SEQ
                          REWRITE MPLTINFO-O-REC FROM BUF-MPLTINFO
                             INVALID KEY MOVE FILE-STATUS TO FILE-STATUS
                          END-REWRITE
                          IF FILE-STATUS NOT = "00"
                             MOVE "REWRITE MPLTINFO*1-6-M"
                                                  TO BU-DISPLAY-MSG
                             MOVE "TRYING TO UPD" TO BU-DISPLAY-FLD (1)
                             MOVE "ABST SEQ TO"   TO BU-DISPLAY-FLD (2)
                             MOVE MPLTINFO-INV-ABST-SEQ
                                                  TO BU-DISPLAY-FLD (3)
                             GO TO 9999-BLOWUP
                          END-IF
                          IF OVR-FILE-NUMBER = S-LAST-ABST-ALPHA
                             MOVE "Y" TO LAST-FILE-PROCESSED
                          END-IF
                       ELSE
                          MOVE "BEG/END SEQ UNEQUAL*1-6-M"
                             TO BU-DISPLAY-MSG
                          MOVE OVR-FILE-NAME TO BU-DISPLAY-FLD (1)
                          MOVE "BEGINNING SEQ" TO BU-DISPLAY-FLD (2)
                          MOVE S-001-CUTOFF-SEQ TO BU-DISPLAY-FLD (3)
                          MOVE "ENDING SEQ" TO BU-DISPLAY-FLD (4)
                          MOVE TC900-CUTOFF-SEQ TO BU-DISPLAY-FLD (5)
                          GO TO 9999-BLOWUP
                       END-IF
                    END-IF
                 END-PERFORM
              END-IF

      *-------GET NEXT FILE TO CHECK

              IF LAST-FILE-PROCESSED = "N"
                 CLOSE ABSTFILE-I
                 MOVE CUR-ABST TO OVR-FILE-NUMBER
                 IF CUR-ABST < S-LAST-ABST-NUMERIC
                    MOVE "CORRECT ABSTFILE NOT FOUND*1-6-M"
                       TO BU-DISPLAY-MSG
                    MOVE S-EXPECTED-ABST-SEQ TO BU-DISPLAY-FLD (1)
                    GO TO 9999-BLOWUP
                 END-IF
                 CALL "QCMDEXC" USING OVRRIDE-CMD  OVRRIDE-CMD-LEN
                 OPEN INPUT ABSTFILE-I
              END-IF
           END-PERFORM.

       1-6-M-X.
           EXIT.

       1-ABSTFILE-X.
           EXIT.

      *-----------------------------------------------------------------
       8-RECEIVER SECTION.
      *-----------------------------------------------------------------

       8-1-HSK.

           OPEN INPUT RECEIVER-T.
           OPEN OUTPUT SUMFILE-T, RAWFILE-T, NOCHECK-T.

      *----SET UP HEADINGS FOR ALL REPORTS.

           MOVE CURRENT-MM TO PRT-ERR-HDG-1-MM
                              PRT-SUM-HDG-1-MM
                              PRT-NCHK-HDG-1-MM
                              PRT-RAW-HDG-1-MM.
           MOVE CURRENT-DD TO PRT-ERR-HDG-1-DD
                              PRT-SUM-HDG-1-DD
                              PRT-NCHK-HDG-1-DD
                              PRT-RAW-HDG-1-DD.
           MOVE CURRENT-YY TO PRT-ERR-HDG-1-YY
                              PRT-SUM-HDG-1-YY
                              PRT-NCHK-HDG-1-YY
                              PRT-RAW-HDG-1-YY.
           MOVE CURRENT-HR TO PRT-ERR-HDG-2-HR
                              PRT-SUM-HDG-2-HR
                              PRT-RAW-HDG-2-HR.
           MOVE CURRENT-MIN TO PRT-ERR-HDG-2-MIN
                               PRT-SUM-HDG-2-MIN
                               PRT-RAW-HDG-2-MIN.
           MOVE CURRENT-SEC TO PRT-ERR-HDG-2-SEC
                               PRT-SUM-HDG-2-SEC
                               PRT-RAW-HDG-2-SEC.
           MOVE S-CUTOFF-YY TO PRT-ERR-HDG-2-YY
                               PRT-SUM-HDG-2-YY
                               PRT-RAW-HDG-2-YY.
           MOVE S-CUTOFF-MM TO PRT-ERR-HDG-2-MM
                               PRT-SUM-HDG-2-MM
                               PRT-RAW-HDG-2-MM.
           MOVE S-CUTOFF-DD TO PRT-ERR-HDG-2-DD
                               PRT-SUM-HDG-2-DD
                               PRT-RAW-HDG-2-DD.
           MOVE S-001-CUTOFF-SEQ TO PRT-ERR-HDG-2-SEQ
                                    PRT-SUM-HDG-2-SEQ
                                    PRT-RAW-HDG-2-SEQ.

      *----SET UP VARIABLES FOR ERROR REPORT HERE BECAUSE IT WILL NOT
      *----BE WRITTEN ALL AT ONCE. ERRORS WILL BE WRITTEN TO IT AS
      *----THEY ARE FOUND DURING RECEIVER PROCESSING.

           INITIALIZE   INVOICE-TABLE     CURRENT-ITEM
                        PAGE-COUNT-ERR    CURRENT-RECEIVER
                        PRT-SUM-HDG-2-PG  PRT-ERR-HDG-2-PG
                        PRT-RAW-HDG-2-PG.
           MOVE 60 TO LINE-COUNT-ERR.
           MOVE "N" TO  RECEIVER-EOF.
           MOVE "N" TO LAST-INVOICE-TO-GEN.

           PERFORM 9999-READ-RECEIVER-T.
           IF RECEIVER-EOF = "N"
              MOVE "Y" TO  FIRST-PASS
              MOVE "N" TO  INVOICES-GENERATED  ERRORS-FOUND
9301CK                     RAW-MATL-INVOICES-GENERATED
9506CY        MOVE 1   TO SUB
              PERFORM 8-6-MAIN THRU 8-6-M-X
                 UNTIL LAST-INVOICE-TO-GEN = "Y"
              CLOSE SUMFILE-T, RAWFILE-T, RECEIVER-T
              IF INVOICES-GENERATED = "N"
      *----------NO INVOICES WERE GENERATED AND THEREFORE,
      *----------NO RAW MATERIAL INVOICES WERE GENERATED
                 PERFORM 8-5-WRITE-SUM-HDGS
                 PERFORM 8-3-WRITE-RAW-HDGS
                 PERFORM 8-6-WRITE-NCHK-HDGS
                 MOVE "4" TO SUM-CTL, RAW-CTL, NCHK-CTL
                 MOVE NO-GEN-MSG TO SUM-LINE   NCHK-LINE
                 MOVE NO-RAW-MSG TO RAW-LINE
                 WRITE REPORT-SUM-REC
                 WRITE REPORT-RAW-REC
                 WRITE REPORT-NCHK-REC
              ELSE
      *----------INVOICES WERE GENERATED
                 PERFORM 8-5-WRITE-SUM-REPORT
9301CK           IF RAW-MATL-INVOICES-GENERATED = "Y"
                    PERFORM 8-3-WRITE-RAW-REPORT
9301CK           ELSE
  .   *-------------NONE OF THE INVOICES GENERATED WERE FOR RAW MATERIALS
  .                 PERFORM 8-3-WRITE-RAW-HDGS
  .                 MOVE "4" TO RAW-CTL
  .                 MOVE NO-RAW-MSG TO RAW-LINE
  .                 WRITE REPORT-RAW-REC
9301CK           END-IF
              END-IF
              IF ERRORS-FOUND = "N"
      *----------NO ERRORS WERE FOUND WHILE GENERATING INVOICES
                 PERFORM 8-4-WRITE-ERR-HDGS
                 MOVE "4" TO ERR-CTL
                 MOVE NO-ERRS-MSG TO ERR-LINE
                 WRITE REPORT-ERR-REC
              END-IF
           ELSE
      *-------NO RECEIVERS WERE FOUND IN TODAY'S RUN
              PERFORM 8-5-WRITE-SUM-HDGS
              PERFORM 8-4-WRITE-ERR-HDGS
              PERFORM 8-3-WRITE-RAW-HDGS
              PERFORM 8-6-WRITE-NCHK-HDGS
              MOVE "4" TO  SUM-CTL  ERR-CTL  RAW-CTL
                                    NCHK-CTL
              MOVE NO-RCVRS-MSG TO  SUM-LINE  ERR-LINE  RAW-LINE
                                    NCHK-LINE
              WRITE REPORT-SUM-REC
              WRITE REPORT-ERR-REC
              WRITE REPORT-RAW-REC
              WRITE REPORT-NCHK-REC
              CLOSE RECEIVER-T, RAWFILE-T, SUMFILE-T.


           GO TO 8-RECEIVER-X.

       8-3-WRITE-RAW-REPORT.
           INITIALIZE PAGE-COUNT-RAW.
           MOVE 60 TO LINE-COUNT-RAW.

           SORT SORT-FILE-3 ON DESCENDING KEY SORT-KEY-3A
                               ASCENDING  KEY SORT-KEY-3B
              USING RAWFILE-T
              GIVING RAWFILE-T.

           OPEN INPUT RAWFILE-T.
           INITIALIZE BUF-RAWFILE.
           MOVE "N" TO RAWFILE-EOF.
           PERFORM 9999-READ-RAWFILE-T.

           PERFORM UNTIL RAWFILE-EOF = "Y"

              IF RAW-REG NOT EQUAL PRT-RAW-DTL-1-REG
                 MOVE "N" TO CONTINUE-INV
                 PERFORM 8-3-WRITE-INV-LINE
                 MOVE "Y" TO CONTINUE-INV
              END-IF

              PERFORM 8-3-WRITE-ITEM-LINE

              PERFORM 9999-READ-RAWFILE-T

           END-PERFORM.

           CLOSE RAWFILE-T.

       8-3-CHK-PAGE.
           IF LINE-COUNT-RAW > 59
              MOVE 0 TO LINE-COUNT-RAW
              PERFORM 8-3-WRITE-RAW-HDGS
              IF SAME-INV
                 PERFORM 8-3-WRITE-INV-LINE.

       8-3-WRITE-RAW-HDGS.
           ADD 1 TO PAGE-COUNT-RAW.
           MOVE PAGE-COUNT-RAW TO PRT-RAW-HDG-2-PG.

           MOVE "0" TO RAW-CTL.
           MOVE PRT-RAW-HDG-1 TO RAW-LINE.
           WRITE REPORT-RAW-REC.

           MOVE "1" TO RAW-CTL.
           MOVE PRT-RAW-HDG-2 TO RAW-LINE.
           WRITE REPORT-RAW-REC.

           MOVE "3" TO RAW-CTL.
           MOVE PRT-RAW-HDG-3 TO RAW-LINE.
           WRITE REPORT-RAW-REC.

           MOVE "1" TO RAW-CTL.
           MOVE PRT-RAW-HDG-3U TO RAW-LINE.
           WRITE REPORT-RAW-REC.

           MOVE "1" TO RAW-CTL.
           MOVE PRT-RAW-HDG-4 TO RAW-LINE.
           WRITE REPORT-RAW-REC.

           MOVE "1" TO RAW-CTL.
           MOVE PRT-RAW-HDG-4U TO RAW-LINE.
           WRITE REPORT-RAW-REC.

           MOVE 8 TO LINE-COUNT-RAW.

       8-3-WRITE-INV-LINE.

           PERFORM 8-3-CHK-PAGE.

           MOVE RAW-CHK TO PRT-RAW-DTL-1-CHK.
           MOVE RAW-DUE TO PRT-RAW-DTL-1-DUE.
           MOVE RAW-VEN TO PRT-RAW-DTL-1-VEN.
           MOVE RAW-PO TO PRT-RAW-DTL-1-PO.
           MOVE RAW-RLSE TO PRT-RAW-DTL-1-RLS.
           MOVE RAW-RCVR TO PRT-RAW-DTL-1-RCV.
           MOVE RAW-INV TO PRT-RAW-DTL-1-INV.
           MOVE RAW-REG TO PRT-RAW-DTL-1-REG.
           MOVE "2" TO RAW-CTL.
           MOVE PRT-RAW-DTL-1 TO RAW-LINE.
           WRITE REPORT-RAW-REC.

           MOVE "1" TO RAW-CTL.
           MOVE SPACE-LINE TO RAW-LINE.
           WRITE REPORT-RAW-REC.

           ADD 2 TO LINE-COUNT-RAW.

       8-3-WRITE-ITEM-LINE.

           PERFORM 8-3-CHK-PAGE.

           MOVE RAW-ITEM TO PRT-RAW-DTL-2-ITM.
           MOVE RAW-CODE TO PRT-RAW-DTL-2-CC.
           MOVE RAW-QTY  TO PRT-RAW-DTL-2-QTY.
           MOVE RAW-UM   TO PRT-RAW-DTL-2-UM.
           MOVE RAW-UPR  TO PRT-RAW-DTL-2-UPR.

           MOVE "1" TO RAW-CTL.
           MOVE PRT-RAW-DTL-2 TO RAW-LINE.
           WRITE REPORT-RAW-REC.

           ADD 1 TO LINE-COUNT-RAW.

       8-4-WRITE-ERROR-REPORT.

           MOVE "N" TO  CONTINUE-RCVR  CONTINUE-ITEM.
           PERFORM 8-4-WRITE-RCVR-LINE.
           MOVE "Y" TO CONTINUE-RCVR.

           PERFORM 8-4-WRITE-RCVR-MSGS.

           PERFORM VARYING SUM-IX FROM 1 BY 1 UNTIL SUM-IX > 1000
                                  OR TBL-ITEM (SUM-IX) = SPACES
              IF TBL-ITEM (SUM-IX) > SPACES
                 MOVE "N" TO CONTINUE-ITEM
                 PERFORM 8-4-WRITE-ITEM-LINE
                 MOVE "Y" TO CONTINUE-ITEM

                 PERFORM 8-4-CHK-PAGE
                 MOVE "1" TO ERR-CTL
                 MOVE SPACE-LINE TO ERR-LINE
                 WRITE REPORT-ERR-REC
                 ADD 1 TO LINE-COUNT-ERR

                 PERFORM 8-4-WRITE-ITEM-MSGS
              END-IF
           END-PERFORM.

       8-4-CHK-PAGE.
           IF LINE-COUNT-ERR > 59
              MOVE 0 TO LINE-COUNT-ERR
              PERFORM 8-4-WRITE-ERR-HDGS
              IF SAME-RCVR
                 PERFORM 8-4-WRITE-RCVR-LINE
                 IF SAME-ITEM
                    PERFORM 8-4-WRITE-ITEM-LINE
                    PERFORM 8-4-CHK-PAGE
                    MOVE "1" TO ERR-CTL
                    MOVE SPACE-LINE TO ERR-LINE
                    WRITE REPORT-ERR-REC
                    ADD 1 TO LINE-COUNT-ERR.

       8-4-WRITE-ERR-HDGS.
           ADD 1 TO PAGE-COUNT-ERR.
           MOVE PAGE-COUNT-ERR TO PRT-ERR-HDG-2-PG.

           MOVE "0" TO ERR-CTL.
           MOVE PRT-ERR-HDG-1 TO ERR-LINE.
           WRITE REPORT-ERR-REC.

           MOVE "1" TO ERR-CTL.
           MOVE PRT-ERR-HDG-2 TO ERR-LINE.
           WRITE REPORT-ERR-REC.

           MOVE "3" TO ERR-CTL.
           MOVE PRT-ERR-HDG-3 TO ERR-LINE.
           WRITE REPORT-ERR-REC.

           MOVE "1" TO ERR-CTL.
           MOVE PRT-ERR-HDG-3U TO ERR-LINE.
           WRITE REPORT-ERR-REC.

           MOVE "1" TO ERR-CTL.
           MOVE PRT-ERR-HDG-4 TO ERR-LINE.
           WRITE REPORT-ERR-REC.

           MOVE "1" TO ERR-CTL.
           MOVE PRT-ERR-HDG-4U TO ERR-LINE.
           WRITE REPORT-ERR-REC.

           MOVE 8 TO LINE-COUNT-ERR.

       8-4-WRITE-RCVR-LINE.

           PERFORM 8-4-CHK-PAGE.

           MOVE CUR-PO TO PRT-ERR-DTL-1-PO.
           MOVE CUR-RLSE TO PRT-ERR-DTL-1-RLS.
           MOVE CUR-RCVR TO PRT-ERR-DTL-1-RCV.
9301CK     MOVE TBL-PACK-SLIP TO PRT-ERR-DTL-1-PK.
9310CK     MOVE PO-VEN-CODE TO VEN-ARG.
  .        MOVE "00" TO VEN-TYPE-ARG.
  .        PERFORM 9999-READ-DVENDOR-I.
  .        IF FILE-STATUS-1 = "2"
  .           MOVE "READ DVENDOR*9-6-M" TO BU-DISPLAY-MSG
  .           MOVE VEN-ARG TO BU-DISPLAY-FLD(1)
  .           MOVE VEN-TYPE-ARG TO BU-DISPLAY-FLD(2)
  .           GO TO 9999-BLOWUP.
9310CK     MOVE VEN-NAME TO PRT-ERR-DTL-1-VEN.

           MOVE "2" TO ERR-CTL.
           MOVE PRT-ERR-DTL-1 TO ERR-LINE.
           WRITE REPORT-ERR-REC.
           ADD 2 TO LINE-COUNT-ERR.

       8-4-WRITE-RCVR-MSGS.

           PERFORM 8-4-CHK-PAGE.
           IF TBL-DPORECD-OK = "N"
              MOVE "PO INFORMATION IS MISSING (DPORECD)"
                 TO PRT-ERR-DTL-3-MSG
              MOVE "1" TO ERR-CTL
              MOVE PRT-ERR-DTL-3 TO ERR-LINE
              WRITE REPORT-ERR-REC
              ADD 1 TO LINE-COUNT-ERR.

           PERFORM 8-4-CHK-PAGE.
           IF TBL-DPOFREIGHT-OK = "N"
              MOVE "RECEIVING INFORMATION IS MISSING (DPOFREIGHT)"
                 TO PRT-ERR-DTL-3-MSG
              MOVE "1" TO ERR-CTL
              MOVE PRT-ERR-DTL-3 TO ERR-LINE
              WRITE REPORT-ERR-REC
              ADD 1 TO LINE-COUNT-ERR.

9301CK     PERFORM 8-4-CHK-PAGE.
  .        IF TBL-DPOFREIGHT-OK = "X"
  .           MOVE
  .           "RECEIVING INFO IS MISSING (DPOFREIGHT-FRTREFERBCK LEVEL)"
  .              TO PRT-ERR-DTL-3-MSG
  .           MOVE "1" TO ERR-CTL
  .           MOVE PRT-ERR-DTL-3 TO ERR-LINE
  .           WRITE REPORT-ERR-REC
9301CK        ADD 1 TO LINE-COUNT-ERR.

           PERFORM 8-4-CHK-PAGE.
9301CK     IF TBL-PACK-SLIP = SPACES
              MOVE "PACKING SLIP IS MISSING"
                 TO PRT-ERR-DTL-3-MSG
              MOVE "1" TO ERR-CTL
              MOVE PRT-ERR-DTL-3 TO ERR-LINE
              WRITE REPORT-ERR-REC
              ADD 1 TO LINE-COUNT-ERR.

9301CK     PERFORM 8-4-CHK-PAGE.
  .        IF NEW-INV-PREFIX-2 = "*"
  .           MOVE "NO AUTOMATIC PREFIXES AVAILABLE FOR INVOICE NUMBER"
  .              TO PRT-ERR-DTL-3-MSG
  .           MOVE "1" TO ERR-CTL
  .           MOVE PRT-ERR-DTL-3 TO ERR-LINE
  .           WRITE REPORT-ERR-REC
9301CK        ADD 1 TO LINE-COUNT-ERR.

           PERFORM 8-4-CHK-PAGE.
           IF TBL-BOUNDS-EXCEEDED = "Y"
              MOVE "MORE THAN 1000 ITEMS FOUND ON RECEIVER"
                 TO PRT-ERR-DTL-3-MSG
              MOVE "1" TO ERR-CTL
              MOVE PRT-ERR-DTL-3 TO ERR-LINE
              WRITE REPORT-ERR-REC
              ADD 1 TO LINE-COUNT-ERR.

9506CY     PERFORM 8-4-CHK-PAGE.
  .        IF TBL-MSTORERM-OK = "N"
  .           MOVE "STOREROOM INFO IS MISSING (MSTORERM-CORP CODE)"
  .              TO PRT-ERR-DTL-3-MSG
  .           MOVE "1" TO ERR-CTL
  .           MOVE PRT-ERR-DTL-3 TO ERR-LINE
  .           WRITE REPORT-ERR-REC
9506CY        ADD 1 TO LINE-COUNT-ERR.

9507CY     PERFORM 8-4-CHK-PAGE.
  .        IF TBL-DVENDOR-OK = "N"
  .           MOVE "PO IS INVOICELESS, BUT VENDOR IS NOT"
  .              TO PRT-ERR-DTL-3-MSG
  .           MOVE "1" TO ERR-CTL
  .           MOVE PRT-ERR-DTL-3 TO ERR-LINE
  .           WRITE REPORT-ERR-REC
9507CY        ADD 1 TO LINE-COUNT-ERR.

       8-4-WRITE-ITEM-LINE.

           PERFORM 8-4-CHK-PAGE.

           MOVE TBL-ITEM (SUM-IX) TO PRT-ERR-DTL-2-ITEM.
           MOVE TBL-CORP-CODE (SUM-IX) TO PRT-ERR-DTL-2-CODE.
           MOVE TBL-QTY-RCVD (SUM-IX) TO PRT-ERR-DTL-2-QTY.
           MOVE TBL-QTY-RCVD-UM (SUM-IX) TO PRT-ERR-DTL-2-Q-UM.
           MOVE TBL-UNIT-PRICE (SUM-IX) TO PRT-ERR-DTL-2-PRICE.
           MOVE TBL-UNIT-PRICE-UM (SUM-IX) TO PRT-ERR-DTL-2-P-UM.
           MOVE TBL-QTY-RCVD-HOLD (SUM-IX) TO U-OLD-QTY.
           MOVE TBL-QTY-RCVD-UM-HOLD (SUM-IX) TO U-OLD-UM.
           MOVE TBL-UNIT-PRICE-UM (SUM-IX) TO U-NEW-UM.
           MOVE TBL-CORP-CODE (SUM-IX) TO U-CORP-CODE.
           PERFORM 9999-CONVERT-QTY THRU 9999-CQ-X.
           MULTIPLY U-NEW-QTY BY TBL-UNIT-PRICE (SUM-IX)
              GIVING PRT-ERR-DTL-2-EXT.
           SUBTRACT TBL-TOTAL-QTY-PAID (SUM-IX)
              FROM TBL-TOTAL-QTY-RCVD(SUM-IX)
              GIVING PRT-ERR-DTL-2-UNPAID.

           MOVE "2" TO ERR-CTL.
           MOVE PRT-ERR-DTL-2 TO ERR-LINE.
           WRITE REPORT-ERR-REC.
           ADD 2 TO LINE-COUNT-ERR.

       8-4-WRITE-ITEM-MSGS.

           PERFORM 8-4-CHK-PAGE.
           IF TBL-DRCVITEM-OK (SUM-IX) = "N"
              MOVE "RECEIVING INFORMATION IS MISSING (DRCVITEM)"
                 TO PRT-ERR-DTL-3-MSG
              MOVE "1" TO ERR-CTL
              MOVE PRT-ERR-DTL-3 TO ERR-LINE
              WRITE REPORT-ERR-REC
              ADD 1 TO LINE-COUNT-ERR.

           PERFORM 8-4-CHK-PAGE.
           IF TBL-DPOITEM-OK (SUM-IX) = "N"
              MOVE "PO INFORMATION IS MISSING (DPOITEM)"
                 TO PRT-ERR-DTL-3-MSG
              MOVE "1" TO ERR-CTL
              MOVE PRT-ERR-DTL-3 TO ERR-LINE
              WRITE REPORT-ERR-REC
              ADD 1 TO LINE-COUNT-ERR.

           PERFORM 8-4-CHK-PAGE.
           IF TBL-QTY-TO-PAY-OK (SUM-IX) = "N"
              MOVE "QUANTITY TO PAY IS GREATER THAN UNPAID QUANTITY AVAI
      -          "LABLE" TO PRT-ERR-DTL-3-MSG
              MOVE "1" TO ERR-CTL
              MOVE PRT-ERR-DTL-3 TO ERR-LINE
              WRITE REPORT-ERR-REC
              ADD 1 TO LINE-COUNT-ERR.

           PERFORM 8-4-CHK-PAGE.
           IF TBL-UNIT-PRICE-OK (SUM-IX) = "N"
              MOVE "UNIT PRICE IS TOO HIGH TO PAY AUTOMATICALLY"
                 TO PRT-ERR-DTL-3-MSG
              MOVE "1" TO ERR-CTL
              MOVE PRT-ERR-DTL-3 TO ERR-LINE
              WRITE REPORT-ERR-REC
              ADD 1 TO LINE-COUNT-ERR.

           PERFORM 8-4-CHK-PAGE.
9310CK     IF TBL-NEGATIVE-QTY (SUM-IX) = "Y"
9310CK        MOVE "NET QUANTITY RECEIVED IS NEGATIVE"
                 TO PRT-ERR-DTL-3-MSG
              MOVE "1" TO ERR-CTL
              MOVE PRT-ERR-DTL-3 TO ERR-LINE
              WRITE REPORT-ERR-REC
              ADD 1 TO LINE-COUNT-ERR.

       8-5-WRITE-SUM-REPORT.
9303CK     INITIALIZE PAGE-COUNT-SUM, REG-COUNT, TOTAL-DUE,
                      PAGE-COUNT-NCHK, REG-COUNT-NCHK, TOTAL-DUE-NCHK.
           MOVE 61 TO LINE-COUNT-SUM
                      LINE-COUNT-NCHK.

           SORT SORT-FILE-2 ON DESCENDING KEY SORT-KEY-2
              USING SUMFILE-T
              GIVING SUMFILE-T.

           OPEN INPUT SUMFILE-T.
           INITIALIZE BUF-SUMFILE.
           MOVE "N" TO SUMFILE-EOF.
           PERFORM 9999-READ-SUMFILE-T.

           PERFORM UNTIL SUMFILE-EOF = "Y"
              ADD 1 TO REG-COUNT
              ADD SUM-DUE TO TOTAL-DUE
              IF LINE-COUNT-SUM > 60
                 MOVE 0 TO LINE-COUNT-SUM
                 PERFORM 8-5-WRITE-SUM-HDGS
              END-IF
              IF LINE-COUNT-NCHK > 60
                 MOVE 0 TO LINE-COUNT-NCHK
                 PERFORM 8-6-WRITE-NCHK-HDGS
              END-IF

      *-------WRITE OUT DETAIL LINE FOR SUMMARY REPORT

              MOVE SUM-CHK TO PRT-SUM-DTL-1-CHK
              MOVE SUM-DUE TO PRT-SUM-DTL-1-DUE
              MOVE SUM-VEN TO PRT-SUM-DTL-1-VEN
              MOVE SUM-PO TO PRT-SUM-DTL-1-PO
              MOVE SUM-RLSE TO PRT-SUM-DTL-1-RLS
              MOVE SUM-RCVR TO PRT-SUM-DTL-1-RCV
              MOVE SUM-INV TO PRT-SUM-DTL-1-INV
              MOVE SUM-REG TO PRT-SUM-DTL-1-REG
              MOVE SUM-TERMS TO PRT-SUM-DTL-1-TRM
              MOVE "2" TO SUM-CTL
              MOVE PRT-SUM-DTL-1 TO SUM-LINE
              WRITE REPORT-SUM-REC

              ADD 1 TO LINE-COUNT-SUM

      *--------- WRITE NO-CHECK INVOICE LINE TO TEMPORARY REPORT FILE.
              IF SUM-CHK = "NO CHECK" OR SUM-CHK = "NC/DP=0 "
                 ADD 1 TO REG-COUNT-NCHK
                 ADD SUM-DUE TO TOTAL-DUE-NCHK
                 MOVE "2" TO NCHK-CTL
                 MOVE PRT-SUM-DTL-1 TO NCHK-LINE
                 MOVE REPORT-NCHK-REC TO NCHK-PRINT-LINE
                 MOVE SUM-DUE TO NCHK-AMT
                 WRITE NOCHECK-T-REC FROM BUF-NOCHECK
              END-IF

              PERFORM 9999-READ-SUMFILE-T

           END-PERFORM.

9303CK     IF LINE-COUNT-SUM > 59
  .           MOVE 0 TO LINE-COUNT-SUM
  .           PERFORM 8-5-WRITE-SUM-HDGS.
  .
  .        MOVE TOTAL-DUE TO PRT-SUM-TTL-1-DUE.
  .        MOVE REG-COUNT TO PRT-SUM-TTL-1-REG.
  .        MOVE "2" TO SUM-CTL.
  .        MOVE PRT-SUM-TTL-1 TO SUM-LINE.
9303CK     WRITE REPORT-SUM-REC.

      *--------- PRINT NO-CHECK REPORT SORTED BY PURCHASE ORDER.
           CLOSE NOCHECK-T.
           IF REG-COUNT-NCHK > 0
               SORT SORT-FILE-4 ON ASCENDING KEY SORT-KEY-4A
                   USING  NOCHECK-T
                   GIVING NOCHECK-T
               OPEN INPUT NOCHECK-T
               MOVE "N" TO NOCHECK-EOF
               PERFORM 9999-READ-NOCHECK-T
               MOVE NCHK-PO TO HOLD-PO
               MOVE 0 TO SUBT-DUE-NCHK
                         SUBT-REG-COUNT-NCHK
               PERFORM UNTIL NOCHECK-EOF = "Y"
                   ADD NCHK-AMT TO SUBT-DUE-NCHK
                   ADD 1 TO SUBT-REG-COUNT-NCHK
                   WRITE REPORT-NCHK-REC FROM NCHK-PRINT-LINE
                   ADD 2 TO LINE-COUNT-NCHK
                   PERFORM 9999-READ-NOCHECK-T
                   IF NCHK-PO NOT = HOLD-PO
                       MOVE SUBT-DUE-NCHK TO PRT-SUM-TTL-1-DUE-NCHK
                       MOVE SUBT-REG-COUNT-NCHK
                                          TO PRT-SUM-TTL-1-REG-NCHK
                       PERFORM 9999-WRITE-NCHK-TOT
                       MOVE NCHK-PO TO HOLD-PO
                       MOVE 0 TO SUBT-DUE-NCHK
                                 SUBT-REG-COUNT-NCHK
                   END-IF
                   IF LINE-COUNT-NCHK > 59
                       MOVE 0 TO LINE-COUNT-NCHK
                       PERFORM 8-6-WRITE-NCHK-HDGS
                   END-IF
               END-PERFORM
               MOVE SUBT-DUE-NCHK TO PRT-SUM-TTL-1-DUE-NCHK
               MOVE SUBT-REG-COUNT-NCHK TO PRT-SUM-TTL-1-REG-NCHK
               PERFORM 9999-WRITE-NCHK-TOT
               MOVE TOTAL-DUE-NCHK TO PRT-SUM-TTL-1-DUE
               MOVE REG-COUNT-NCHK TO PRT-SUM-TTL-1-REG
               MOVE "2" TO NCHK-CTL
               MOVE PRT-SUM-TTL-1 TO NCHK-LINE
               WRITE REPORT-NCHK-REC
           ELSE
               MOVE "2" TO NCHK-CTL
               MOVE NO-CHECK-MSG TO NCHK-LINE
               WRITE REPORT-NCHK-REC.

           CLOSE SUMFILE-T.

       8-5-WRITE-SUM-HDGS.
           ADD 1 TO PAGE-COUNT-SUM.
           MOVE PAGE-COUNT-SUM TO PRT-SUM-HDG-2-PG.

           MOVE "0" TO SUM-CTL.
           MOVE PRT-SUM-HDG-1 TO SUM-LINE.
           WRITE REPORT-SUM-REC.

           MOVE "1" TO SUM-CTL.
           MOVE PRT-SUM-HDG-2 TO SUM-LINE.
           WRITE REPORT-SUM-REC.

           MOVE "3" TO SUM-CTL.
           MOVE PRT-SUM-HDG-3 TO SUM-LINE.
           WRITE REPORT-SUM-REC.

           MOVE "1" TO SUM-CTL.
           MOVE PRT-SUM-HDG-3U TO SUM-LINE.
           WRITE REPORT-SUM-REC.

           MOVE 6 TO LINE-COUNT-SUM.

       8-6-WRITE-NCHK-HDGS.
           ADD 1 TO PAGE-COUNT-NCHK.
           MOVE PAGE-COUNT-NCHK TO PRT-SUM-HDG-2-PG.

           MOVE "0" TO NCHK-CTL.
           MOVE PRT-NCHK-HDG-1 TO NCHK-LINE.
           WRITE REPORT-NCHK-REC.

           MOVE "1" TO NCHK-CTL.
           MOVE PRT-SUM-HDG-2 TO NCHK-LINE.
           WRITE REPORT-NCHK-REC.

           MOVE "3" TO NCHK-CTL.
           MOVE PRT-SUM-HDG-3 TO NCHK-LINE.
           WRITE REPORT-NCHK-REC.

           MOVE "1" TO NCHK-CTL.
           MOVE PRT-SUM-HDG-3U TO NCHK-LINE.
           WRITE REPORT-NCHK-REC.

           MOVE 6 TO LINE-COUNT-NCHK.

       8-6-MAIN.

      *----STILL NEED TO PROCESS LAST INVOICE BUILT IN
      *----TABLE SO CAN'T END LOOPING OF 8-6-MAIN ON EOF
      *----OF RECEIVER-T. USE LAST-INVOICE-TO-GEN TO CONTROL
      *----END OF LOOP.

           IF RECEIVER-EOF = "Y"
              MOVE "Y" TO LAST-INVOICE-TO-GEN
              INITIALIZE BUF-RECEIVER.

      *----IF RECEIVER-T REC STARTS THE NEXT RECEIVER, EDIT AND
      *----PROCESS CURRENT INVOICE-TABLE AND GET READY FOR NEXT ONE.

           IF RECEIVER-RS-FULL NOT = CURRENT-RECEIVER

      *-------EDIT CURRENT INVOICE-TABLE AND FLAG ERRORS
      *-------(SKIP EDITS IF JUST READ FIRST RECORD OF RECEIVER-T)

              IF FIRST-PASS = "Y"
                 MOVE "N" TO FIRST-PASS
              ELSE
                 PERFORM VARYING TEMP-IX FROM 1 BY 1
                                         UNTIL TEMP-IX > 1000
                                         OR TBL-ITEM (TEMP-IX) = SPACES

      *------------ CONVERT TABLE QUANTITY TO PO UNIT OF MEASURE QUANTITY.
                    MOVE TBL-QTY-RCVD-UM (TEMP-IX)    TO U-OLD-UM
                    MOVE TBL-QTY-RCVD (TEMP-IX)       TO U-OLD-QTY
                    MOVE TBL-ITM-UM (TEMP-IX)         TO U-NEW-UM
                    MOVE TBL-CORP-CODE (TEMP-IX)      TO U-CORP-CODE
                    PERFORM 9999-CONVERT-QTY  THRU  9999-CQ-X
                    MOVE U-NEW-QTY     TO TBL-QTY-RCVD (TEMP-IX)
                    MOVE U-NEW-UM      TO TBL-QTY-RCVD-UM (TEMP-IX)

                    IF TBL-ITEM (TEMP-IX) > SPACES

      *----------------EDIT 1: RECEIVING SLIP ITEM QTY MUST
      *----------------HAVE BEEN REC'D AND NOT YET PAID FOR

                       IF TBL-QTY-RCVD (TEMP-IX) <=
                          TBL-TOTAL-QTY-RCVD (TEMP-IX) -
                          TBL-TOTAL-QTY-PAID (TEMP-IX)
                             MOVE "Y" TO TBL-QTY-TO-PAY-OK (TEMP-IX)
                       ELSE
                          MOVE "N" TO TBL-QTY-TO-PAY-OK (TEMP-IX)
                          MOVE "Y" TO CURRENT-INVOICE-BAD
                       END-IF

9310CK*----------------EDIT 2: QUANTITY RECEIVED MUST BE
  .   *----------------POSITIVE TO PAY ( >= 0)
  .
  .                    IF TBL-QTY-RCVD (TEMP-IX) < ZERO
  .                       MOVE "Y" TO TBL-NEGATIVE-QTY (TEMP-IX)
  .                       MOVE "Y" TO CURRENT-INVOICE-BAD
  .                    ELSE
  .                       MOVE "N" TO TBL-NEGATIVE-QTY (TEMP-IX)
9310CK                 END-IF

      *----------------EDIT 3: IF ITEM UNIT PRICE IS TOO
      *----------------LARGE, INVOICE SHOULD NOT BE PAID

                       IF TBL-UNIT-PRICE (TEMP-IX) > 9999999.9999
                          MOVE "N" TO TBL-UNIT-PRICE-OK (TEMP-IX)
                          MOVE "Y" TO CURRENT-INVOICE-BAD
                       ELSE
                          MOVE "Y" TO TBL-UNIT-PRICE-OK (TEMP-IX)
                       END-IF
                    END-IF
                 END-PERFORM

9301CK*----------EDIT 4: THIS EDIT WAS MOVED TO ANOTHER AREA.
  .
  .   *          IF FRT-PACK-SLIP = SPACES
  .   *             MOVE "N" TO TBL-PACK-SLIP-OK
  .   *             MOVE "Y" TO CURRENT-INVOICE-BAD
  .   *          ELSE
  .   *             MOVE "Y" TO TBL-PACK-SLIP-OK
9301CK*          END-IF

      *----------EDIT 5: PO MUST BE DESIGNATED AS AUTOMATIC
      *----------INVOICE --> INDICATOR SHOULD BE "X"

                 IF PO-INVOICELESS-IND  = SPACE
                    MOVE "X" TO CURRENT-INVOICE-BAD
                 END-IF

      *----------EDIT 6: VENDOR MUST BE DESIGNATED AS AUTOMATIC
      *----------INVOICE --> INDICATOR SHOULD BE "Y"

                 IF VEN-INVLESS-IND  = SPACE OR "N"
                    MOVE "X" TO CURRENT-INVOICE-BAD
                 END-IF

9507CY*--------- EDIT 7:  MOVE INDICATOR TO PRINT ERROR MESSAGE FOR AN
  .   *--------- INVOICELESS PO WITHOUT AN INVOICELESS VENDOR.
  .              IF   (PO-INVOICELESS-IND = "X" AND
  .                    VEN-INVLESS-IND NOT = "Y")
  .                  MOVE "N" TO TBL-DVENDOR-OK
  .                  MOVE "Y" TO CURRENT-INVOICE-BAD
  .              ELSE
  .                  MOVE "Y" TO TBL-DVENDOR-OK
9507CY           END-IF

      *----------EDIT 8: TOTAL QTY OF ITEMS RECEIVED MUST
      *----------NOT BE ZERO

                 IF TBL-TOTAL-ITEM-QTY = 0
                    MOVE "X" TO CURRENT-INVOICE-BAD
                 END-IF

      *----------PROCESS CURRENT INVOICE-TABLE.
      *----------IF CURRENT-INVOICE-BAD = Y, WRITE ERROR REPORT.
      *----------IF CURRENT-INVOICE-BAD = N, GENERATE INVOICE.
      *----------IF CURRENT-INVOICE-BAD = X, SKIP RECEIVER TOTALLY
      *----------BECAUSE EITHER THE VENDOR OR THE PO WAS NOT MARKED
      *----------AS AUTOMATIC INVOICE. (THIS IS NOT GOOD OR BAD.)

                 IF CURRENT-INVOICE-BAD  = "N"
                    MOVE "Y" TO INVOICES-GENERATED
                    PERFORM 9-INVOICE THRU 9-INVOICE-X
                 END-IF
                 IF CURRENT-INVOICE-BAD  = "Y"
                    MOVE "Y" TO ERRORS-FOUND
                    PERFORM  8-4-WRITE-ERROR-REPORT
                 END-IF
              END-IF

      *-------AFTER LAST INVOICE PROCESSED, CAN END LOOP AT THIS POINT
              IF LAST-INVOICE-TO-GEN = "Y"
                 GO TO 8-6-M-X
              END-IF

              INITIALIZE  INVOICE-TABLE  CURRENT-ITEM
              MOVE 0 TO RCV-IX
              MOVE "N" TO CURRENT-INVOICE-BAD
              MOVE RECEIVER-RS-FULL TO CURRENT-RECEIVER
              MOVE RECEIVER-RCVR TO S-RCVR

      *-------FIND RELATED HEADER RECS IN DPOFREIGHT, DPORECD
      *-------& DVENDOR FOR NEW RECEIVER

              MOVE RECEIVER-RS-FULL TO RS-ARG
              MOVE ZEROS TO RS-RCVR-ARG
              PERFORM 9999-READ-DPORECD-I
              IF FILE-STATUS-1 = "2"
                 MOVE "N" TO TBL-DPORECD-OK
                 MOVE "Y" TO CURRENT-INVOICE-BAD
                 INITIALIZE BUF-DPORECD
              ELSE
                 MOVE "Y" TO TBL-DPORECD-OK
              END-IF

              MOVE RECEIVER-RS-FULL TO RS-ARG
              PERFORM 9999-READ-DPOFREIGHT-I
              IF FILE-STATUS-1 = "2"
                 MOVE "N" TO TBL-DPOFREIGHT-OK
                 MOVE "Y" TO CURRENT-INVOICE-BAD
                 INITIALIZE BUF-DPOFREIGHT, TBL-PACK-SLIP
              ELSE
                 MOVE "Y" TO TBL-DPOFREIGHT-OK
              END-IF

9301CK        IF TBL-DPOFREIGHT-OK = "Y"
  .   *----------PACKING SLIP NUMBER MUST BE AVAILABLE
  .   *----------TO CREATE INVOICE NUMBER
  .              IF FRT-PACK-SLIP = SPACES
  .   *-------------CHECK FOR "REFER BACK"
  .                 IF FRT-REFERBACK = SPACES
  .   *----------------NO "REFER BACK" FOUND
  .                    INITIALIZE TBL-PACK-SLIP
  .                    MOVE "Y" TO CURRENT-INVOICE-BAD
  .                 ELSE
  .   *----------------FOUND "REFER BACK" SO CHECK FOR PACKING SLIP
  .                    MOVE FRT-REFERBACK TO RS-ARG
  .                    PERFORM 9999-READ-DPOFREIGHT-I
  .                    IF FILE-STATUS-1 = "2"
  .   *-------------------"REFER BACK" REC NOT FOUND
  .                       MOVE "X" TO TBL-DPOFREIGHT-OK
  .                       MOVE "Y" TO CURRENT-INVOICE-BAD
  .                       INITIALIZE BUF-DPOFREIGHT, TBL-PACK-SLIP
  .                    ELSE
  .   *-------------------"REFER BACK" REC FOUND
  .                       IF FRT-PACK-SLIP = SPACES
  .                          INITIALIZE TBL-PACK-SLIP
  .                          MOVE "Y" TO CURRENT-INVOICE-BAD
  .                       ELSE
  .                          MOVE FRT-PACK-SLIP TO TBL-PACK-SLIP
  .                       END-IF
  .                    END-IF
  .                 END-IF
  .              ELSE
  .                 MOVE FRT-PACK-SLIP TO TBL-PACK-SLIP
  .              END-IF
  .           END-IF
  .
  .           IF TBL-PACK-SLIP > SPACES
  .              MOVE TBL-PACK-SLIP TO NEW-INV-PACK-SLIP
  .              MOVE "K" TO NEW-INV-PREFIX-2
  .
  .              INITIALIZE INVOICE-FOUND, LTR-IX
  .              PERFORM UNTIL INVOICE-FOUND = "N"
  .                 MOVE  NEW-INVOICE-NO TO INVOICE-ARG
  .                 PERFORM 9999-START-DINVRCD-I-INV
  .                 IF FILE-STATUS-1  = "2"
  .                    MOVE "N" TO INVOICE-FOUND
  .                 ELSE
  .                    INITIALIZE INVOICE-FOUND
  .                    PERFORM UNTIL INVOICE-FOUND = "Y" OR "N"
  .                       PERFORM 9999-READ-NEXT-DINVRCD-I-INV
  .                       IF DINVRCD-EOF  = "Y"
  .                          MOVE "N" TO INVOICE-FOUND
  .                       ELSE
  .                          IF INV-NO = INVOICE-ARG
  .                             IF INV-VEN-CODE-1-7 = PO-VEN-CODE1-7
  .                                MOVE "Y" TO INVOICE-FOUND
  .                                ADD 1 TO LTR-IX
  .                                IF LTR-IX > 25
  .                                   MOVE "N" TO INVOICE-FOUND
  .                                   MOVE "*" TO NEW-INV-PREFIX-2
  .                                   MOVE "Y" TO CURRENT-INVOICE-BAD
  .                                ELSE
  .                                   MOVE LETTER (LTR-IX)
  .                                      TO NEW-INV-PREFIX-2
  .                                END-IF
  .                             END-IF
  .                          ELSE
  .                             MOVE "N" TO INVOICE-FOUND
  .                          END-IF
  .                       END-IF
  .                    END-PERFORM
  .                 END-IF
  .              END-PERFORM
  .
  .              MOVE NEW-INVOICE-NO TO TBL-PACK-SLIP
9301CK        END-IF

              MOVE PO-VEN-CODE TO VEN-ARG
              MOVE "10" TO VEN-TYPE-ARG
              PERFORM 9999-READ-DVENDOR-I
              IF FILE-STATUS-1 = "2"
                 INITIALIZE BUF-DVENDOR
              END-IF
           END-IF.

      *----IF RECEIVER-T REC STARTS A NEW ITEM, FIND
      *----RELATED ITEM RECS AND LOAD TABLE WITH ALL INFO

           IF RECEIVER-ITEM NOT = CURRENT-ITEM
              MOVE RECEIVER-ITEM TO CURRENT-ITEM
              ADD 1 TO RCV-IX

      *-------ONLY SUPPOSED TO BE 12 SEPARATE ITEMS PER RECEIVER.
      *-------IF THERE ARE MORE, MARK THE INVOICE AS BAD. SKIP THE
      *-------RECORD SINCE IT WILL BLOW THE TABLE.
      *------------- NOW, RECEIVER CAN CONTAIN UP TO 999 ITEMS.

              IF RCV-IX > 1000
                 MOVE "Y" TO TBL-BOUNDS-EXCEEDED
                 MOVE "Y" TO CURRENT-INVOICE-BAD
                 PERFORM 9999-READ-RECEIVER-T
                 GO TO 8-6-M-X
              END-IF

      *-------FIND RELATED ITEM RECS IN DRCVITEM & DPOITEM

              MOVE RECEIVER-RS-FULL TO RS-ARG
              MOVE RECEIVER-ITEM TO RS-ITEM-ARG

              PERFORM 9999-READ-DRCVITEM-I
              IF FILE-STATUS-1 = "2"
                 MOVE "N" TO TBL-DRCVITEM-OK (RCV-IX)
                 MOVE "Y" TO CURRENT-INVOICE-BAD
                 INITIALIZE BUF-DRCVITEM
              ELSE
                 MOVE "Y" TO TBL-DRCVITEM-OK (RCV-IX)
              END-IF

              MOVE RECEIVER-RS-FULL TO RS-ARG
              MOVE ZEROS TO RS-RCVR-ARG
              PERFORM 9999-READ-DPOITEM-I
              IF FILE-STATUS-1 = "2"
                 MOVE "N" TO TBL-DPOITEM-OK (RCV-IX)
                 MOVE "Y" TO CURRENT-INVOICE-BAD
                 INITIALIZE BUF-DPOITEM
              ELSE
                 MOVE "Y" TO TBL-DPOITEM-OK (RCV-IX)
              END-IF

      *-------LOAD THE REC INTO TABLE

              MOVE RECEIVER-ITEM   TO TBL-ITEM (RCV-IX)
              MOVE RCV-CORP-CODE   TO TBL-CORP-CODE (RCV-IX)

9504CZ*------ COMMENTED OUT.  IF A PLANT USES THE DELAY FACTOR,
  .   *------ WE CANNOT USE RCV-QTY-DLVR FOR THE QUANTITY IN CASE
  .   *------ CHANGES ARE MADE BEFORE THE DELAY IS UP.   04/20/1995
  .   *       IF RECEIVER-TC = "323" OR "423"
  .   *          MOVE RCV-QTY-DLVR TO TBL-QTY-RCVD (RCV-IX)
  .   *       ELSE
  .   *          ADD RECEIVER-NET-CHG-QTY TO TBL-QTY-RCVD (RCV-IX)
9504CZ*       END-IF
9506CY*------ CHECK TABLE TO SEE IF A 923 EXISTS FOR THE ITEM.
  .           IF 923-924-FOUND-SW = "Y"
  .               SET TBL-IX TO 1
  .               SEARCH 923-TABLE-DATA VARYING TBL-IX
  .                   AT END
  .                       ADD RECEIVER-NET-CHG-QTY TO
  .                           TBL-QTY-RCVD (RCV-IX)
  .                           TBL-QTY-RCVD-HOLD (RCV-IX)
  .                   WHEN TBL-9-REC-NUM (TBL-IX) = RECEIVER-REC-NUM
  .                       ADD TBL-9-RCVR-NET-CHG-QTY (TBL-IX) TO
  .                           TBL-QTY-RCVD (RCV-IX)
  .                           TBL-QTY-RCVD-HOLD (RCV-IX)
  .               END-SEARCH
  .           ELSE
  .               ADD RECEIVER-NET-CHG-QTY TO TBL-QTY-RCVD (RCV-IX)
  .                                           TBL-QTY-RCVD-HOLD (RCV-IX)
9506CY        END-IF

              ADD TBL-QTY-RCVD (RCV-IX) TO TBL-TOTAL-ITEM-QTY

9506CY*------ MOVE ABSTFILE UM TO TABLE INSTEAD OF RECEIVER UM. 04/27/95
9506CY*       MOVE RCV-ITEM-UM     TO TBL-QTY-RCVD-UM (RCV-IX)
              MOVE RECEIVER-UM     TO TBL-QTY-RCVD-UM (RCV-IX)
                                      TBL-QTY-RCVD-UM-HOLD (RCV-IX)
              MOVE ITM-UM          TO TBL-ITM-UM (RCV-IX)
              MOVE ITM-UNIT-PRICE  TO TBL-UNIT-PRICE (RCV-IX)
              MOVE ITM-PRICE-UM    TO TBL-UNIT-PRICE-UM (RCV-IX)
              MOVE ITM-QTY-DLVR    TO TBL-TOTAL-QTY-RCVD (RCV-IX)
              MOVE ITM-QTY-PAID    TO TBL-TOTAL-QTY-PAID (RCV-IX)
              MOVE ITM-TAX-CODE    TO TBL-TAX-CODE (RCV-IX)
              MOVE ITM-CLASS       TO TBL-ACCTG-SUB (RCV-IX)
              MOVE ITM-SUB-DETL    TO TBL-ACCTG-SUBD (RCV-IX)

              IF ITM-ADDL-DATA = SPACES
                 MOVE ZEROES       TO TBL-ACCTG-ADDL-DATA (RCV-IX)
              ELSE
                 MOVE ITM-ADDL-DATA TO TBL-ACCTG-ADDL-DATA (RCV-IX)
              END-IF

9504CZ*------ DON'T NEED THIS SWITCH.             04/20/1995
  .   *       IF RECEIVER-TC = "323" OR "423"
  .   *          MOVE "Y"           TO TBL-323-OR-423-FOUND (RCV-IX)
9504CZ*       END-IF

      *----OTHERWISE, RECEIVER-T REC CONTINUES SAME ITEM. IF
      *----ORIGINAL RECEIVING ENTRY (323/423) WAS FOUND IN THIS
      *----ABSTFILE (TBL-323-OR-423-FOUND = Y), IGNORE ALL
      *----RECEIVING MODIFICATIONS (324/424). IF ORIGINAL WASN'T
      *----FOUND, ADD QTY MODIFICATIONS TO GET NET CHANGE QTY FOR
      *----THIS ITEM.
9504CZ*----  DON'T NEED TO IGNORE 323 OR 423 CORRECTIONS SINCE WE ARE
  .   *----  NOW USING ALL THE TRANSACTIONS IN THE ABSTFILE INSTEAD OF
9504CZ*----  PROCESSING 323 AND 423 TC'S DIFFERENTLY.   04/20/1995

           ELSE
9506CY         IF 923-924-FOUND-SW = "Y"
  .                SET TBL-IX TO 1
  .                SEARCH 923-TABLE-DATA VARYING TBL-IX
  .                    AT END
  .                        ADD RECEIVER-NET-CHG-QTY TO
  .                            TBL-QTY-RCVD (RCV-IX)
  .                            TBL-QTY-RCVD-HOLD (RCV-IX)
  .                            TBL-TOTAL-ITEM-QTY
  .                    WHEN TBL-9-REC-NUM (TBL-IX) = RECEIVER-REC-NUM
  .                        ADD TBL-9-RCVR-NET-CHG-QTY (TBL-IX) TO
  .                            TBL-QTY-RCVD (RCV-IX)
  .                            TBL-QTY-RCVD-HOLD (RCV-IX)
  .                            TBL-TOTAL-ITEM-QTY
  .                END-SEARCH
9506CY         ELSE
                   ADD RECEIVER-NET-CHG-QTY TO TBL-QTY-RCVD (RCV-IX)
                                          TBL-QTY-RCVD-HOLD (RCV-IX)
                                          TBL-TOTAL-ITEM-QTY
               END-IF

           END-IF.


      *----GET NEXT RECEIVER-T REC.
           PERFORM 9999-READ-RECEIVER-T.

       8-6-M-X.
           EXIT.

       8-RECEIVER-X.
           EXIT.

      *-----------------------------------------------------------------
       9-INVOICE SECTION.
      *-----------------------------------------------------------------

       9-1-HSK.

      *----ASSIGN REGISTER NUMBER. MAKE SURE IT IS NOT USED IN
      *----DINVRCD, DINVITM, OR DINVACCT. IF IT IS, GET NEXT NUMBER.

           MOVE "PREG" TO PLT-ARG.
           PERFORM 9999-READ-MPLTINFO-O.
           IF FILE-STATUS-1 = "2"
              MOVE "MPLTINFO: PREG NOT FOUND*9-1-HSK" TO BU-DISPLAY-MSG
              GO TO 9999-BLOWUP.

           MOVE "N" TO REGISTER-OK
           PERFORM UNTIL REGISTER-OK = "Y"
      *----------- START REGISTER NUMBERS OVER IF MAXIMUM NUMBER IS
      *----------- REACHED.
              IF MPLTINFO-REGNUM = 99999
                  MOVE +00001  TO  MPLTINFO-REGNUM
              ELSE
                  ADD 1        TO  MPLTINFO-REGNUM
              END-IF
              MOVE MPLTINFO-REGNUM TO REGISTER-ARG
              PERFORM 9999-READ-DINVRCD-I
              IF FILE-STATUS-1 = "2"
                 PERFORM 9999-START-DINVITM-I
                 IF FILE-STATUS-1 = "2"
                    PERFORM 9999-START-DINVACCT-I
                    IF FILE-STATUS-1 = "2"
                       MOVE "Y" TO REGISTER-OK
                       REWRITE MPLTINFO-O-REC FROM BUF-MPLTINFO
                          INVALID KEY MOVE FILE-STATUS TO FILE-STATUS
                       END-REWRITE
                       IF FILE-STATUS NOT = "00"
                          MOVE "REWRITE MPLTINFO*9-1-H"
                             TO BU-DISPLAY-MSG
                          MOVE "TRYING TO UPD" TO BU-DISPLAY-FLD (1)
                          MOVE "REGISTER NO TO" TO BU-DISPLAY-FLD (2)
                          MOVE MPLTINFO-REGNUM TO BU-DISPLAY-FLD (3)
                          GO TO 9999-BLOWUP
                       END-IF
                       MOVE MPLTINFO-REGNUM TO S-REGISTER
                    END-IF
                 END-IF
              END-IF
           END-PERFORM.

           INITIALIZE TOTAL-MATL-EXT
                      ITEM-MATL-EXT
                      TOTAL-ATAX-AMT
                      TOTAL-GST-TAX
                      BUF-DINVRCD
                      BUF-DINVITM
                      BUF-DINVACCT.

9405CK*----FIND THE DISCOUNT AMOUNT ALLOWED ON THE PO TO USE IN
  .   *----CALCULATING THE ACCRUED TAX.
  .
  .        MOVE PO-TERMS-PCT TO DISC-PCT-ARG.
  .        MOVE DISCOUNT-ARG TO PLT-ARG.
  .        PERFORM 9999-READ-MPLTINFO-I.
  .        IF FILE-STATUS = "00"
  .           MOVE MPLTINFO-DISC-AMNT TO S-DISCOUNT-AMT
  .        ELSE
9405CK        MOVE ZERO               TO S-DISCOUNT-AMT.

           PERFORM 9-6-MAIN THRU 9-6-M-X.
           GO TO 9-INVOICE-X.

        9-6-MAIN.

           PERFORM VARYING INV-IX FROM 1 BY 1 UNTIL INV-IX > 1000
                                         OR TBL-ITEM (INV-IX) = SPACES
              IF TBL-ITEM (INV-IX) > SPACES
      *------------ CHECK TO MAKE SURE QTY NOT ZERO.
                IF TBL-QTY-RCVD-HOLD (INV-IX) > 0

      *----------CREATE DINVITM

                 INITIALIZE                          INVITM-ITEM-STATUS
                 MOVE S-REGISTER                  TO INVITM-REG-NO
                 MOVE TBL-CORP-CODE (INV-IX)      TO INVITM-CORPCODE
                 MOVE TBL-UNIT-PRICE-UM (INV-IX)  TO INVITM-PO-UM
                 MOVE TBL-UNIT-PRICE (INV-IX)     TO INVITM-PO-UPRICE
                                                     INVITM-INV-UPRICE
                 MOVE TBL-ITEM (INV-IX)           TO INVITM-ITEM-NO
                 MOVE TBL-TAX-CODE (INV-IX)       TO INVITM-TAX-CODE

                 MOVE TBL-QTY-RCVD-HOLD (INV-IX) TO U-OLD-QTY
                 MOVE TBL-QTY-RCVD-UM-HOLD (INV-IX) TO U-OLD-UM
                 MOVE TBL-UNIT-PRICE-UM (INV-IX) TO U-NEW-UM
                 MOVE TBL-CORP-CODE (INV-IX) TO U-CORP-CODE
                 PERFORM 9999-CONVERT-QTY THRU 9999-CQ-X
                 MOVE U-NEW-QTY                   TO INVITM-PO-QTY-PD
                                                     INVITM-INV-QTY-PD

                 COMPUTE ITEM-MATL-EXT =
                    INVITM-PO-QTY-PD * INVITM-PO-UPRICE
                 ADD ITEM-MATL-EXT TO TOTAL-MATL-EXT

                 PERFORM 9-7-CALC-TAXES THRU 9-7-CT-X

                 WRITE DINVITM-O-REC FROM BUF-DINVITM
                    INVALID KEY MOVE FILE-STATUS TO FILE-STATUS
                 END-WRITE
                 IF FILE-STATUS NOT = "00"
                    MOVE "WRITE DINVITM*9-6-M" TO BU-DISPLAY-MSG
                    MOVE S-REGISTER TO BU-DISPLAY-FLD (1)
                    MOVE CURRENT-RECEIVER TO BU-DISPLAY-FLD (2)
                    MOVE TBL-ITEM (INV-IX) TO BU-DISPLAY-FLD (3)
                    GO TO 9999-BLOWUP
                 END-IF


      *----------CREATE DINVACCT

                 MOVE S-REGISTER                   TO INVACCT-REG-NO
                 MOVE PO-PRIME                     TO INVACCT-PRIME
                 MOVE TBL-ACCTG-SUB (INV-IX)       TO INVACCT-SUB
                 MOVE TBL-ACCTG-SUBD (INV-IX)      TO INVACCT-SUBD
                 MOVE TBL-ACCTG-ADDL-DATA(INV-IX)  TO INVACCT-ADDL-DATA
                 MOVE 100.00                       TO INVACCT-PCT
                 MOVE TBL-ITEM (INV-IX)            TO INVACCT-ITEM
                 MOVE 01                           TO INVACCT-LINE

                 WRITE DINVACCT-O-REC FROM BUF-DINVACCT
                    INVALID KEY MOVE FILE-STATUS TO FILE-STATUS
                 END-WRITE
                 IF FILE-STATUS NOT = "00"
                    MOVE "WRITE DINVACCT*9-6-M" TO BU-DISPLAY-MSG
                    MOVE S-REGISTER TO BU-DISPLAY-FLD (1)
                    MOVE CURRENT-RECEIVER TO BU-DISPLAY-FLD (2)
                    MOVE TBL-ITEM (INV-IX)  TO BU-DISPLAY-FLD (3)
                    GO TO 9999-BLOWUP
                 END-IF

      *----------UPDATE DPOITEM

                 MOVE CURRENT-RECEIVER TO RS-ARG
                 MOVE ZEROES TO RS-RCVR-ARG
                 MOVE TBL-ITEM (INV-IX) TO RS-ITEM-ARG
                 PERFORM 9999-READ-DPOITEM-O
                 IF FILE-STATUS-1 = "2"
                    MOVE "READ DPOITEM*9-6-M" TO BU-DISPLAY-MSG
                    MOVE RS-ARG TO BU-DISPLAY-FLD (1)
                    MOVE RS-ITEM-ARG TO BU-DISPLAY-FLD(2)
                    GO TO 9999-BLOWUP
                 END-IF

                 ADD TBL-QTY-RCVD (INV-IX) TO ITM-QTY-PAID

                 REWRITE DPOITEM-O-REC FROM BUF-DPOITEM
                    INVALID KEY MOVE FILE-STATUS TO FILE-STATUS
                 END-REWRITE
                 IF FILE-STATUS NOT = "00"
                    MOVE "REWRITE DPOITEM*9-6-M" TO BU-DISPLAY-MSG
                    MOVE RS-ARG TO BU-DISPLAY-FLD (1)
                    MOVE RS-ITEM-ARG TO BU-DISPLAY-FLD (2)
                    GO TO 9999-BLOWUP
                 END-IF
                END-IF
              END-IF
           END-PERFORM.

      *----------CREATE DINVRCD

           INITIALIZE                         INV-ADD-VFRT
                                              INV-ADD-CTNRS
                                              INV-ADD-INS
                                              INV-ADD-OTHER
                                              INV-MOD-CN
                                              INV-CHECK-CN
                                              INV-CHECK-NO
                                              INV-MFEST-NO
                                              INV-MFEST-YY
                                              INV-CE-LIST
                                              INV-CPW-CODE
                                              INV-TOTAL-CFRT
                                              INV-ADJ-OTHER
                                              INV-MOD-CLERK
                                              INV-TAX-ON-FRT
                                              INV-FREE-VERB.
9306CK*                                       INV-TAX-CODE.
           MOVE S-REGISTER                 TO INV-REG-NO.
           MOVE PO-RCV-NO                  TO INV-PO-RCV-NO.
           MOVE "000"                      TO INV-RS.
           MOVE ZEROES                     TO INV-VEN-CODE.
           MOVE PO-VEN-CODE1-7             TO INV-VEN-CODE-1-7.
           MOVE "P "                       TO INV-STATUS.
           MOVE TBL-PACK-SLIP              TO INV-NO.
9306CK     MOVE TBL-TAX-CODE (1)           TO INV-TAX-CODE.
           MOVE FRT-DATE-RCVD              TO INV-DATE.
      *--------- ACCOUNT FOR CENTURY.
           IF INV-DATE (1:2) > "70"
               MOVE "19"                   TO INV-DATE-CC
           ELSE
               MOVE "20"                   TO INV-DATE-CC.
           MOVE CURRENT-DATE-CN            TO INV-ENTRY-CN.
           MOVE PO-TERMS                   TO INV-TERMS.

           MOVE INV-DATE TO SINVDUED-INV-DATE.
           MOVE INV-TERMS TO SINVDUED-INV-TERMS.
           CALL "SINVDUED" USING BASE  SINVDUED-PARMS  BU-DISPLAY-MSG
                                       STATUS-AREA     BU-DISPLAY-FLDS.
           MOVE SINVDUED-DUE-DATE          TO INV-DUE-DATE.
      *--------- ACCOUNT FOR CENTURY.
           IF INV-DUE-DATE (1:2) > "70"
               MOVE "19"                   TO INV-DUE-CC
           ELSE
               MOVE "20"                   TO INV-DUE-CC.

           MOVE TOTAL-MATL-EXT             TO INV-I-MATL-EXT
                                              INV-P-MATL-EXT.
           MOVE "P "                       TO INV-PAYMENT-IND.
           COMPUTE INV-NET-DUE-VENDOR =  TOTAL-MATL-EXT + INV-ADD-TAX.
           MOVE "1"                        TO CE1-CODE.
           MOVE INV-NET-DUE-VENDOR         TO CE1-TOTAL.

           MOVE "120" TO ACCTG-1.
           MOVE TBL-ACCTG-SUB(1) TO ACCTG-2.
           MOVE "000" TO ACCTG-3.
           MOVE NEW-ACCTG-DATA             TO CE1-ACCTG-DATA.

           MOVE TOTAL-GST-TAX              TO INV-ADD-GST.

           PERFORM VARYING TEMP-IX FROM 1 BY 1 UNTIL TEMP-IX > 4
              ADD INV-ATAX-AMT (TEMP-IX) TO TOTAL-ATAX-AMT
              MOVE S-TAX-DISTRICT-CE-ACCTG (TEMP-IX)
                 TO INV-ATAX-ACCTG (TEMP-IX)
           END-PERFORM.

           COMPUTE INV-DIST-COST = INV-NET-DUE-VENDOR + TOTAL-ATAX-AMT.
           MOVE "AUTO"                     TO INV-ADD-CLERK.
           MOVE PO-NO-CHECK-INDIC          TO INV-NO-CHECK-INDIC.
           MOVE S-RCVR                     TO INV-RCVR-NO.
           MOVE SPACES                     TO INV-MOD-CN
                                              INV-CHECK-CN.

           WRITE DINVRCD-O-REC FROM BUF-DINVRCD
              INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
              MOVE "WRITE DINVRCD*9-6-M" TO BU-DISPLAY-MSG
              MOVE S-REGISTER TO BU-DISPLAY-FLD (1)
              MOVE CURRENT-RECEIVER TO BU-DISPLAY-FLD (2)
              GO TO 9999-BLOWUP.

      *----UPDATE DPORECD

           PERFORM 9999-READ-DPORECD-O.
           IF FILE-STATUS-1 = "2"
              MOVE "READ DPORECD*9-6-M" TO BU-DISPLAY-MSG
              MOVE RS-ARG TO BU-DISPLAY-FLD (1)
              GO TO 9999-BLOWUP.

           MOVE CURRENT-DATE-CN TO PO-LAST-PAYMENT-CN.

           REWRITE DPORECD-O-REC FROM BUF-DPORECD
              INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
              MOVE "REWRITE DPORECD*9-6-M" TO BU-DISPLAY-MSG
              MOVE RS-ARG TO BU-DISPLAY-FLD(1)
              GO TO 9999-BLOWUP.

      *----WRITE A RECORD FOR EACH GENERATED INVOICE
      *----TO SUMFILE-T FOR LATER REPORTING PURPOSES.

           MOVE INV-NET-DUE-VENDOR TO SUM-DUE.
           MOVE INV-VEN-CODE TO VEN-ARG.
           MOVE "00" TO VEN-TYPE-ARG.
           PERFORM 9999-READ-DVENDOR-I.

9410CZ*----MOVE ERROR MESSAGE TO VENDOR NAME ON GENSUMFL REPORT
  .   *----IF NO VENDOR NAME IS FOUND IN DVENDOR.
  .
  .        IF FILE-STATUS-1 = "2"
  .           MOVE INV-VEN-CODE       TO ERR-VENDOR-CODE
  .           MOVE NO-VENDOR-ERR-MSG  TO SUM-VEN
  .        ELSE
9410CZ        MOVE VEN-NAME           TO SUM-VEN.

           IF INV-NO-CHECK-INDIC = "X" AND INVACCT-SUBD = "0000"
              MOVE "NC/DP=0 " TO SUM-CHK
           ELSE
           IF INV-NO-CHECK-INDIC = "X"
              MOVE "NO CHECK" TO SUM-CHK
           ELSE
              IF INVACCT-SUBD = "0000"
                  MOVE "DEPT=0  " TO SUM-CHK
           ELSE
              MOVE SPACES TO SUM-CHK.

9405CK*----THE FOLLOWING LARGE "IF" STMT WAS CREATED TO WARN A/P THAT
  .   *----A NON RAW MATERIAL INVOICE WAS CRT'D WITH AN AMOUNT THAT WAS
  .   *----OVER THE LIMIT IN MPLTINFO-NON-RAMMTL-DLR-LMT (PODL). IF
  .   *----THIS LIMIT IS SET AT ZERO, THEN THE WARNING SYSTEM IS
  .   *----ASSUMED NOT TO BE IN USE.
  .
  .        IF SUM-CHK = SPACES
  .           IF S-NON-RAWMTL-DOLLAR-LIMIT > ZERO
  .              MOVE TBL-CORP-CODE (1) TO SHORT-CORP-CODE
  .              IF NOT RAW-MATERIAL
  .                 IF SUM-DUE >= S-NON-RAWMTL-DOLLAR-LIMIT
9405CK                 MOVE "**OVER**" TO SUM-CHK
                    END-IF
                 ELSE
      *----IF RAW MATERIAL IS IN 200 OR 300 RANGE OF CLASSES, CHECK
      *----TO SEE IF IT EXCEEDS DOLLAR LIMIT.  IF IT DOES, PRINT
      *----"**OVER**" MESSAGE.
                    IF INVACCT-SUB (1:1) = "2" OR
                       INVACCT-SUB (1:1) = "3"
                       IF SUM-DUE >= S-NON-RAWMTL-DOLLAR-LIMIT
                          MOVE "**OVER**" TO SUM-CHK.

           MOVE INV-PO-RCV-NO TO SUM-PO-RCVR.
           MOVE INV-RCVR-NO TO SUM-RCVR.
           MOVE INV-NO TO SUM-INV.
           MOVE INV-REG-NO TO SUM-REG.
           MOVE INV-TERMS TO SUM-TERMS.
           WRITE SUMFILE-T-REC FROM BUF-SUMFILE.

      *----IF THIS IS A RAW MATERIAL RECEIVER WRITE A RECORD FOR
      *----EACH ITEM TO RAWFILE-T FOR LATER REPORTING PURPOSES.

           MOVE TBL-CORP-CODE (1) TO SHORT-CORP-CODE.
           IF RAW-MATERIAL
9301CK        MOVE "Y" TO RAW-MATL-INVOICES-GENERATED
              MOVE SUM-DUE TO RAW-DUE
              MOVE SUM-VEN TO RAW-VEN
              MOVE SUM-CHK TO RAW-CHK
              MOVE SUM-PO-RCVR TO RAW-PO-RCVR
              MOVE SUM-INV TO RAW-INV
              MOVE SUM-REG TO RAW-REG
              PERFORM VARYING INV-IX FROM 1 BY 1 UNTIL INV-IX > 1000
                                     OR TBL-ITEM (INV-IX) = SPACES
                 IF TBL-ITEM (INV-IX) > SPACES
                    MOVE TBL-ITEM (INV-IX) TO RAW-ITEM
                    MOVE TBL-CORP-CODE (INV-IX) TO RAW-CODE
                    MOVE TBL-UNIT-PRICE-UM (INV-IX) TO RAW-UM
                    MOVE TBL-UNIT-PRICE (INV-IX) TO RAW-UPR

                    MOVE TBL-QTY-RCVD-HOLD (INV-IX) TO U-OLD-QTY
                    MOVE TBL-QTY-RCVD-UM-HOLD (INV-IX) TO U-OLD-UM
                    MOVE TBL-UNIT-PRICE-UM (INV-IX) TO U-NEW-UM
                    MOVE TBL-CORP-CODE (INV-IX) TO U-CORP-CODE
                    PERFORM 9999-CONVERT-QTY THRU 9999-CQ-X
                    MOVE U-NEW-QTY TO RAW-QTY

                    WRITE RAWFILE-T-REC FROM BUF-RAWFILE
                 END-IF
              END-PERFORM
           END-IF.

       9-6-M-X.
           EXIT.

       9-7-CALC-TAXES.

      *----CALCULATE ALL APPLICABLE TAXES AND COSTS

           MOVE INVITM-TAX-CODE TO TAX-ARG.
           PERFORM 9999-READ-MTAX-I.
           IF FILE-STATUS-1 = "2"
              MOVE "TAX CODE NOT FOUND*9-7-CT" TO BU-DISPLAY-MSG
              MOVE TAX-ARG TO BU-DISPLAY-FLD (1)
              MOVE RS-ARG TO BU-DISPLAY-FLD (1)
              GO TO 9999-BLOWUP.

      *----CALCULATE GST TAX.
           IF GST-IX EQUAL ZERO
              MOVE 0 TO GST-TAX
           ELSE
              COMPUTE GST-TAX ROUNDED =
                 (MTAX-PERCENT(GST-IX) / 100.0000000) * ITEM-MATL-EXT

      *-------THEN FIND OUT WHO TO PAY TAX TO
              EVALUATE MTAX-PAY-INDIC(GST-IX)

      *----------GST TAX GETS PAID DIRECTLY TO VENDOR
                 WHEN "P"
                    ADD GST-TAX TO INV-ADD-TAX
                    ADD GST-TAX TO TOTAL-GST-TAX

      *----------GST TAX GETS ACCRUED TO BE PAID BY GOODYEAR LATER
                 WHEN "A"
                    ADD GST-TAX TO INV-ATAX-AMT (GST-IX)
             END-EVALUATE
           END-IF.

      *----IF DOUBLE TAXATION SHOULD OCCUR, APPLY ALL OTHER TAXES
      *----TO BASE ITEM COST + GST
           IF TAX-ON-GST = "Y"
              PERFORM VARYING TEMP-IX FROM 1 BY 1 UNTIL TEMP-IX > 4
                 IF TEMP-IX NOT EQUAL GST-IX
                    COMPUTE REGULAR-TAX ROUNDED =
                       (MTAX-PERCENT(TEMP-IX) / 100.0000000) *
                       (ITEM-MATL-EXT + GST-TAX)

      *-------------THEN FIND OUT WHO TO PAY TAX TO
                    EVALUATE MTAX-PAY-INDIC(TEMP-IX)

      *----------------TAX GETS PAID DIRECTLY TO VENDOR
                       WHEN "P"
                          ADD REGULAR-TAX TO INV-ADD-TAX

      *----------------TAX GETS ACCRUED TO BE PAID BY GOODYEAR LATER
                       WHEN "A"
                          ADD REGULAR-TAX TO INV-ATAX-AMT (TEMP-IX)
                    END-EVALUATE
                 END-IF
              END-PERFORM
           END-IF.

      *----IF NO DOUBLE TAXATION OCCURS JUST APPLY ALL OTHER
      *----TAXES TO THE NORMAL BASE ITEM COST.
9405CK*----AT THIS POINT, REDUCING THE ACCRUED TAX AMOUNTS BY THE
  .   *----PO DISCOUNT AMOUNT CAN OCCUR  BECAUSE GST IS NOT INVOLVED.
  .   *----WILL NOT MESS WITH GST AND REDUCING ACCRUED TAXES UNLESS
9405CK*----TOLD SPECIFICALLY TO DO SO.
           IF TAX-ON-GST = "N"
              PERFORM VARYING TEMP-IX FROM 1 BY 1 UNTIL TEMP-IX > 4
                 IF TEMP-IX NOT EQUAL GST-IX
                    COMPUTE REGULAR-TAX ROUNDED =
                       (MTAX-PERCENT(TEMP-IX) / 100.0000000) *
                       (ITEM-MATL-EXT)

      *-------------THEN FIND OUT WHO TO PAY TAX TO
                    EVALUATE MTAX-PAY-INDIC(TEMP-IX)

      *----------------TAX GETS PAID DIRECTLY TO VENDOR
                       WHEN "P"
                          ADD REGULAR-TAX TO INV-ADD-TAX

      *----------------TAX GETS ACCRUED TO BE PAID BY GOODYEAR LATER
                       WHEN "A"
9405CK                    IF S-DISCOUNT-TAX-SW = "Y"
  .                          COMPUTE REGULAR-TAX ROUNDED =
  .                             REGULAR-TAX -
  .                            (REGULAR-TAX * S-DISCOUNT-AMT)
9405CK                    END-IF
                          ADD REGULAR-TAX TO INV-ATAX-AMT (TEMP-IX)
                    END-EVALUATE
                 END-IF
              END-PERFORM
           END-IF.

       9-7-CT-X.
           EXIT.

       9-INVOICE-X.
           EXIT.

       9999-UTILITY SECTION.

       9999-BLOWUP.
           MOVE "TINVGEN" TO BU-PGM-NAME.
           CALL "TBLOWUP" USING BASE, BU-PGM-NAME, STATUS-AREA,
              VIEW-COMAREA, FILE-STATUS, BU-DISPLAY-MSG,
              BU-DISPLAY-FLDS.

       9999-CONVERT-QTY.

      *----IF CORP CODE IS NON-STR, THEN NO RECORDS IN
      *----MSTORERM. DO NOT CONVERT.

           IF U-CORP-CODE = "NON-STR "
              MOVE U-OLD-QTY  TO  U-NEW-QTY
              GO TO  9999-CQ-X.

      *----IF OLD UM AND NEW UM ARE EQUAL, NO NEED TO CONVERT.

           IF U-NEW-UM = U-OLD-UM
              MOVE U-OLD-QTY TO U-NEW-QTY
              GO TO  9999-CQ-X.

9310CK*----IF OLD QTY IS ZERO, NO NEED TO CONVERT.
  .
  .        IF U-OLD-QTY = 0
  .           MOVE U-OLD-QTY TO U-NEW-QTY
9310CK        GO TO  9999-CQ-X.

           MOVE U-CORP-CODE TO CODE-ARG.
           PERFORM 9999-READ-MSTORERM-I.
9506CY     IF FILE-STATUS-1 = "2"
  .           MOVE "N" TO TBL-MSTORERM-OK
  .           MOVE "Y" TO CURRENT-INVOICE-BAD
  .           MOVE ZERO TO U-NEW-QTY
  .           GO TO 9999-CQ-X
  .        ELSE
  .           MOVE "Y" TO TBL-MSTORERM-OK
9506CY     END-IF.

           IF U-OLD-UM = STR-UM
              IF U-NEW-UM = STR-UM1
                 DIVIDE U-OLD-QTY BY STR-UM1-CF GIVING U-NEW-QTY ROUNDED
              ELSE
                 DIVIDE U-OLD-QTY BY STR-UM2-CF GIVING U-NEW-QTY ROUNDED

           ELSE
           IF U-NEW-UM = STR-UM
              IF U-OLD-UM = STR-UM1
                 MULTIPLY U-OLD-QTY BY STR-UM1-CF
                    GIVING U-NEW-QTY ROUNDED
              ELSE
                 MULTIPLY U-OLD-QTY BY STR-UM2-CF
                    GIVING U-NEW-QTY ROUNDED

           ELSE
           IF U-NEW-UM = STR-UM1
              DIVIDE STR-UM2-CF BY STR-UM1-CF GIVING U-ALT-CF ROUNDED
              MULTIPLY U-OLD-QTY BY U-ALT-CF GIVING U-NEW-QTY ROUNDED
           ELSE
              DIVIDE STR-UM1-CF BY STR-UM2-CF GIVING U-ALT-CF ROUNDED
              MULTIPLY U-OLD-QTY BY U-ALT-CF GIVING U-NEW-QTY ROUNDED.

       9999-CQ-X.
           EXIT.

       9999-READ-ABSTFILE-I.
           READ ABSTFILE-I INTO BUF-DDAILYTC
              AT END MOVE "Y" TO ABSTFILE-EOF.

       9999-READ-DINVRCD-I.
           MOVE REGISTER-ARG TO REGISTERNO OF DINVRCD-I-REC.
           READ DINVRCD-I INTO BUF-DINVRCD
              INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
              IF FILE-STATUS-1 NOT = "2"
                 MOVE "READ DINVRCD*9999-RDI" TO BU-DISPLAY-MSG
                 MOVE RS-ARG TO BU-DISPLAY-FLD (1)
                 GO TO 9999-BLOWUP.

       9999-READ-DPOFREIGHT-I.
           MOVE RS-ARG      TO PORCVNO OF DPOFREIGHT-I-REC.
           READ DPOFREIGHT-I INTO BUF-DPOFREIGHT
              INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
              IF FILE-STATUS-1 NOT = "2"
                 MOVE "READ DPOFREIGHT*9999-RDI" TO BU-DISPLAY-MSG
                 MOVE RS-ARG TO BU-DISPLAY-FLD (1)
                 GO TO 9999-BLOWUP.

       9999-READ-DPOITEM-I.
           MOVE RS-ARG      TO PORCVNO OF DPOITEM-I-REC.
           MOVE RS-ITEM-ARG TO ITEMNO  OF DPOITEM-I-REC.
           READ DPOITEM-I INTO BUF-DPOITEM
              INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
              IF FILE-STATUS-1 NOT = "2"
                 MOVE "READ DPOITEM*9999-RDI" TO BU-DISPLAY-MSG
                 MOVE RS-ARG TO BU-DISPLAY-FLD (1)
                 MOVE RS-ITEM-ARG TO BU-DISPLAY-FLD (2)
                 GO TO 9999-BLOWUP.

       9999-READ-DPOITEM-O.
           MOVE RS-ARG      TO PORCVNO OF DPOITEM-O-REC.
           MOVE RS-ITEM-ARG TO ITEMNO  OF DPOITEM-O-REC.
           READ DPOITEM-O INTO BUF-DPOITEM
              INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
              IF FILE-STATUS-1 NOT = "2"
                 MOVE "READ DPOITEM*9999-RDO" TO BU-DISPLAY-MSG
                 MOVE RS-ARG TO BU-DISPLAY-FLD (1)
                 MOVE RS-ITEM-ARG TO BU-DISPLAY-FLD (2)
                 GO TO 9999-BLOWUP.

       9999-READ-DPORECD-I.
           MOVE RS-ARG      TO PORCVNO OF DPORECD-I-REC.
           READ DPORECD-I INTO BUF-DPORECD
              INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
              IF FILE-STATUS-1 NOT = "2"
                 MOVE "READ DPORECD*9999-RDI" TO BU-DISPLAY-MSG
                 MOVE RS-ARG TO BU-DISPLAY-FLD (1)
                 GO TO 9999-BLOWUP.

       9999-READ-DPORECD-O.
           MOVE RS-ARG      TO PORCVNO OF DPORECD-O-REC.
           READ DPORECD-O INTO BUF-DPORECD
              INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
              IF FILE-STATUS-1 NOT = "2"
                 MOVE "READ DPORECD*9999-RDO" TO BU-DISPLAY-MSG
                 MOVE RS-ARG TO BU-DISPLAY-FLD (1)
                 GO TO 9999-BLOWUP.

       9999-READ-DRCVITEM-I.
           MOVE RS-ARG      TO PORCVNO OF DRCVITEM-I-REC.
           MOVE RS-ITEM-ARG TO ITEMNO  OF DRCVITEM-I-REC.
           READ DRCVITEM-I INTO BUF-DRCVITEM
              INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
              IF FILE-STATUS-1 NOT = "2"
                 MOVE "READ DRCVITEM*9999-RDI" TO BU-DISPLAY-MSG
                 MOVE RS-ARG TO BU-DISPLAY-FLD (1)
                 MOVE RS-ITEM-ARG TO BU-DISPLAY-FLD (2)
                 GO TO 9999-BLOWUP.

       9999-READ-DVENDOR-I.
           MOVE VEN-ARG TO VENCDE OF DVENDOR-I-REC.
           MOVE VEN-TYPE-ARG TO VENITMNO OF DVENDOR-I-REC.
           READ DVENDOR-I INTO BUF-DVENDOR
              INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
              IF FILE-STATUS-1 NOT = "2"
                 MOVE "READ DVENDOR*9999-RDI" TO BU-DISPLAY-MSG
                 MOVE VEN-ARG TO BU-DISPLAY-FLD (1)
                 MOVE VEN-TYPE-ARG TO BU-DISPLAY-FLD (2)
                 GO TO 9999-BLOWUP.

       9999-READ-MPLTINFO-I.
           MOVE PLT-ARG TO PLTINFOKEY OF MPLTINFO-I-REC.
           READ MPLTINFO-I INTO BUF-MPLTINFO
              INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
              IF FILE-STATUS-1 NOT = "2"
                 MOVE "READ MPLTINFO*9999-RMI" TO BU-DISPLAY-MSG
                 MOVE PLT-ARG TO BU-DISPLAY-FLD (1)
                 GO TO 9999-BLOWUP.

       9999-READ-MPLTINFO-O.
           MOVE PLT-ARG TO PLTINFOKEY OF MPLTINFO-O-REC.
           READ MPLTINFO-O INTO BUF-MPLTINFO
              INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
              IF FILE-STATUS-1 NOT = "2"
                 MOVE "READ MPLTINFO*9999-RMO" TO BU-DISPLAY-MSG
                 MOVE PLT-ARG TO BU-DISPLAY-FLD (1)
                 GO TO 9999-BLOWUP.

       9999-READ-MSTORERM-I.
           MOVE CODE-ARG TO CORPCDE OF MSTORERM-I-REC.
           READ MSTORERM-I INTO BUF-MSTORERM
              INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
              IF FILE-STATUS-1 NOT = "2"
                 MOVE "READ MSTORERM*9999-RMI" TO BU-DISPLAY-MSG
                 MOVE CODE-ARG TO BU-DISPLAY-FLD (1)
                 GO TO  9999-BLOWUP.

       9999-READ-MTAX-I.
           MOVE TAX-ARG TO TAXCDE OF MTAX-I-REC.
           READ MTAX-I INTO BUF-MTAX
              INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
              IF FILE-STATUS-1 NOT = "2"
                 MOVE "READ MTAX*9999-RMI" TO BU-DISPLAY-MSG
                 MOVE TAX-ARG TO BU-DISPLAY-FLD (1)
                 GO TO 9999-BLOWUP.

       9999-READ-RAWFILE-T.
           READ RAWFILE-T INTO BUF-RAWFILE
              AT END MOVE "Y" TO RAWFILE-EOF.

       9999-READ-RECEIVER-T.
           RETURN SORT-FILE INTO BUF-RECEIVER
              AT END MOVE "Y" TO RECEIVER-EOF.

       9999-READ-SUMFILE-T.
           READ SUMFILE-T INTO BUF-SUMFILE
              AT END MOVE "Y" TO SUMFILE-EOF.

       9999-READ-NOCHECK-T.
           READ NOCHECK-T INTO BUF-NOCHECK
               AT END MOVE "Y" TO NOCHECK-EOF.

       9999-WRITE-NCHK-TOT.
           MOVE "2" TO NCHK-CTL.
           MOVE PRT-SUM-TTL-1-NCHK TO NCHK-LINE.
           WRITE REPORT-NCHK-REC.
           ADD 2 TO LINE-COUNT-NCHK.

9301CK 9999-READ-NEXT-DINVRCD-I-INV.
  .        INITIALIZE DINVRCD-EOF.
  .        READ DINVRCD-I-INV NEXT INTO BUF-DINVRCD
9301CK        AT END MOVE "Y" TO DINVRCD-EOF.

       9999-START-DINVACCT-I.
           MOVE REGISTER-ARG TO REGISTERNO OF DINVACCT-I-REC.
           START DINVACCT-I KEY = REGISTERNO OF DINVACCT-I-REC
              INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
              IF FILE-STATUS-1 NOT = "2"
                 MOVE "START DINVACCT*9999-SDI" TO BU-DISPLAY-MSG
                 MOVE REGISTER-ARG TO BU-DISPLAY-FLD (1)
                 GO TO 9999-BLOWUP.

       9999-START-DINVITM-I.
           MOVE REGISTER-ARG TO REGISTERNO OF DINVITM-I-REC.
           START DINVITM-I KEY = REGISTERNO OF DINVITM-I-REC
              INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
              IF FILE-STATUS-1 NOT = "2"
                 MOVE "START DINVITM*9999-SDI" TO BU-DISPLAY-MSG
                 MOVE REGISTER-ARG TO BU-DISPLAY-FLD (1)
                 GO TO 9999-BLOWUP.

9301CK 9999-START-DINVRCD-I-INV.
  .        MOVE INVOICE-ARG TO INVOICENO OF DINVRCD-I-REC-INV.
  .        START DINVRCD-I-INV KEY = INVOICENO OF DINVRCD-I-REC-INV
  .           INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
  .        IF FILE-STATUS NOT = "00"
  .           IF FILE-STATUS-1 NOT = "2"
  .              MOVE "START DINVRCD*9999-SDII" TO BU-DISPLAY-MSG
  .              MOVE INVOICE-ARG TO BU-DISPLAY-FLD (1)
9301CK           GO TO 9999-BLOWUP.

       9999-UNLOCK-MPLTINFO-O.
           MOVE HIGH-VALUES TO PLTINFOKEY OF MPLTINFO-O-REC.
           START MPLTINFO-O KEY > PLTINFOKEY OF MPLTINFO-O-REC
              INVALID KEY MOVE "00" TO FILE-STATUS.

       9999-UTILITY-X.
           EXIT.
