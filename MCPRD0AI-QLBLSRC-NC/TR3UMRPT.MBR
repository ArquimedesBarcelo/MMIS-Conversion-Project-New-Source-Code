       IDENTIFICATION DIVISION.
       PROGRAM-ID.        TR3UMRPT.
       AUTHOR.            CA YODER.
       DATE-WRITTEN.      APRIL 1999.
       DATE-COMPILED.
      *INSTALLATION.      THE GOODYEAR TIRE & RUBBER COMPANY.
      *REMARKS.
      *
      ******************************************************************
      *D   T R 3 U M R P T                                             *
      *D                                                               *
      *D     THIS PROGRAM READS THROUGH FILE UMQRYMAST AND CREATES     *
      *D     A REPORT SHOWING UNIT OF MEASURE FOR EVERY PLANT LINKED   *
      *D     TO A CERTAIN CODE.                                        *
      *D                                                               *
      ******************************************************************
      *                                                                *
      *C                                                               *
      *C 05/06/2004   CA YODER                                         *
      *C    CHANGED PLANTS TO REFLECT CURRENT R/3 SITUATION.           *
      *C                                                               *
      *C 05/20/2004   CA YODER                                         *
      *C    REMOVED KELLY PLANTS; INSERTED "R3" PLANT INSTEAD.         *
      *C                                                               *

       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.
       SOURCE-COMPUTER.     IBM-AS400.
       OBJECT-COMPUTER.     IBM-AS400.

       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT UMFILE-I
               ASSIGN        TO DATABASE-UMQRYMAST1
               ORGANIZATION  IS INDEXED
               ACCESS MODE   IS DYNAMIC
               RECORD KEY    IS EXTERNALLY-DESCRIBED-KEY
                                WITH DUPLICATES
               FILE STATUS   IS FILE-STATUS.

           SELECT REPORT-FILE
               ASSIGN TO PRINTER-MCPRT.

           SELECT OUTPUT-FILE
               ASSIGN        TO DISK-R3UMRPTFL
               ORGANIZATION  IS SEQUENTIAL
               ACCESS MODE   IS SEQUENTIAL
               FILE STATUS   IS FILE-STATUS.

       DATA DIVISION.
       FILE SECTION.
       FD  UMFILE-I
           LABEL RECORDS ARE STANDARD.
       01  UMFILE-REC-I.
           COPY DDS-ALL-FORMATS OF UMQRYMAST1.

       FD  REPORT-FILE
           DATA RECORD IS REPORT-FILE-REC.
       01  REPORT-FILE-REC      PIC X(132).

       FD  OUTPUT-FILE
           LABEL RECORDS ARE OMITTED
           RECORD CONTAINS 80 CHARACTERS
           DATA RECORD IS R3UMRPTFL-REC.
       COPY R3UMRPTFL IN COPYLIB.

       WORKING-STORAGE SECTION.

       77  SAVE-CODE            PIC X(8).
       77  SAVE-UM              PIC X(2).
       77  DIFF-UM-SW           PIC X.
       77  NUM-LINKS            PIC 9(2).
       77  TOT-CODES            PIC 9(6)    VALUE 0.
       77  TOT-DIF-CODES        PIC 9(6)    VALUE 0.

      *----------------------------------------------------------------*
      *             D A T A B A S E   B U F F E R S                    *
      *----------------------------------------------------------------*

       COPY TDATECHK IN COPYLIB.

       01  UM-REC.
           05  UM-CODE          PIC X(8).
           05  UM-PLT           PIC X(3).
           05  UM-DESC          PIC X(50).
           05  UM-UM            PIC X(2).

      *----------------------------------------------------------------*
      *                    H O L D   A R E A S                         *
      *----------------------------------------------------------------*

       01  PAGE-NUM                      PIC 9(3) VALUE 0.
       01  NUM-LINES                     PIC 9(2) VALUE 0.

       01  FILE-STATUS.
           05  FILE-STATUS-1             PIC X    VALUE "0".
           05  FILE-STATUS-2             PIC X    VALUE "0".

       01  UMFILE-EOF-SW                 PIC X    VALUE "N".

       01  DATE-ARG.
           05  ARG-CC                    PIC X(2).
           05  ARG-YMD.
               10  ARG-YY                PIC X(2).
               10  ARG-MM                PIC X(2).
               10  ARG-DD                PIC X(2).

       01  CURRENT-DATE                    VALUE SPACES.
           05  CUR-YY             PIC X(2).
           05  CUR-YY-9   REDEFINES  CUR-YY  PIC 9(2).
           05  CUR-MM             PIC X(2).
           05  CUR-MM-9   REDEFINES  CUR-MM  PIC 9(2).
           05  CUR-DD             PIC X(2).

       01  CURRENT-TIME                    VALUE SPACES.
           05  CUR-HR             PIC X(2).
           05  CUR-MIN            PIC X(2).
           05  CUR-SEC            PIC X(2).

      *----------------------------------------------------------------*
      *               R E P O R T   L I N E S                          *
      *----------------------------------------------------------------*

       01  HEADING-1.
           05  FILLER             PIC X(2)  VALUE SPACES.
           05  H1-DATE            PIC X(8).
           05  FILLER             PIC X(38) VALUE SPACES.
           05  FILLER             PIC X(33) VALUE
             "UNIT OF MEASURE COMPARISON REPORT".
           05  FILLER             PIC X(38) VALUE SPACES.
           05  FILLER             PIC X(8)  VALUE "TR3UMRPT".
           05  FILLER             PIC X(5)  VALUE SPACES.

       01  HEADING-2.
           05  FILLER             PIC X(2)  VALUE SPACES.
           05  H2-HR              PIC X(2).
           05  FILLER             PIC X     VALUE ":".
           05  H2-MIN             PIC X(2).
           05  FILLER             PIC X     VALUE ":".
           05  H2-SEC             PIC X(2).
           05  FILLER             PIC X(109) VALUE SPACES.
           05  FILLER             PIC X(5)  VALUE "PAGE ".
           05  H2-PAGE-NUM        PIC ZZ9.
           05  FILLER             PIC X(5)  VALUE SPACES.

       01  HEADING-3.
           05  FILLER             PIC X(2)  VALUE SPACES.
           05  FILLER             PIC X(9)  VALUE "CSIS CODE".
           05  FILLER             PIC X(2)  VALUE SPACES.
           05  FILLER             PIC X(11) VALUE "DESCRIPTION".
           05  FILLER             PIC X(39) VALUE SPACES.
           05  FILLER             PIC X(2)  VALUE SPACES.
           05  FILLER             PIC X(32) VALUE
               "R/3 131 153 112 126 129 133 155 ".
           05  FILLER             PIC X(30) VALUE
               "629 631 637         (**=NO UM)".
           05  FILLER             PIC X(4)  VALUE SPACES.

      *01  HEADING-4.
      *    05  FILLER             PIC X(7)  VALUE SPACES.
      *    05  FILLER             PIC X(4)  VALUE "RLSE".
      *    05  FILLER             PIC X(9)  VALUE SPACES.
      *    05  FILLER             PIC X(26) VALUE
      *                            "ITEM  CODE        DATE    ".
      *    05  FILLER             PIC X(26) VALUE
      *                            "USER         PRICE      UM".
      *    05  FILLER             PIC X(26) VALUE
      *                            "  VENDOR     PO NUM   ITEM".
      *    05  FILLER             PIC X(26) VALUE
      *                            "      PRICE     UM  VENDOR".
      *    05  FILLER             PIC X(8)  VALUE SPACES.

       01  HEADING-5.
           05  FILLER             PIC X(2)  VALUE SPACES.
           05  FILLER             PIC X(9)  VALUE "---------".
           05  FILLER             PIC X(2)  VALUE SPACES.
           05  FILLER             PIC X(50) VALUE ALL "-".
           05  FILLER             PIC X(2)  VALUE SPACES.
           05  FILLER             PIC X(36) VALUE
               "--- --- --- --- --- --- --- --- --- ".
           05  FILLER             PIC X(19) VALUE
               "--- ---            ".
           05  FILLER             PIC X(4)  VALUE SPACES.

       01  DETAIL-LINE.
           05  FILLER             PIC X(2).
           05  DET-CODE           PIC X(8).
           05  FILLER             PIC X(3).
           05  DET-DESC           PIC X(50).
           05  FILLER             PIC X(2).
           05  DET-R3             PIC X(2).
           05  FILLER             PIC X(2).
           05  DET-131            PIC X(2).
           05  FILLER             PIC X(2).
           05  DET-153            PIC X(2).
           05  FILLER             PIC X(2).
           05  DET-112            PIC X(2).
           05  FILLER             PIC X(2).
           05  DET-126            PIC X(2).
           05  FILLER             PIC X(2).
           05  DET-129            PIC X(2).
           05  FILLER             PIC X(2).
           05  DET-133            PIC X(2).
           05  FILLER             PIC X(2).
           05  DET-155            PIC X(2).
           05  FILLER             PIC X(2).
           05  DET-629            PIC X(2).
           05  FILLER             PIC X(2).
           05  DET-631            PIC X(2).
           05  FILLER             PIC X(2).
           05  DET-637            PIC X(2).
           05  FILLER             PIC X(2).
           05  DET-CHG            PIC X(2).
           05  FILLER             PIC X(5).

       01  TOTAL-LINE-1.
           05  FILLER             PIC X(40)  VALUE
               "TOTAL CODES WITH MULTIPLE PLANT LINKS:  ".
           05  TOT-LINE-CODES     PIC ZZZ,ZZ9.

       01  TOTAL-LINE-2.
           05  FILLER             PIC X(40)  VALUE
               "      CODES WITH DIFFERENT PRIMARY UM:  ".
           05  TOT-LINE-DIF       PIC ZZZ,ZZ9.

      *----------------------------------------------------------------*
      *               U T I L I T Y   A R E A                          *
      *----------------------------------------------------------------*

       COPY TBLOWUP    IN COPYLIB.

       COPY VCOMAREA   IN COPYLIB.

       COPY DATAB      IN COPYLIB.


      *--------- P R O C E D U R E   D I V I S I O N ------------------*

       PROCEDURE DIVISION.

       MAINLINE SECTION.
       0-MAINLINE-BEGIN.
           PERFORM 1-HSK.
           PERFORM 6-MAIN UNTIL UMFILE-EOF-SW = "Y".
           PERFORM 2-EOJ.
           GOBACK.

       1-HSK.
           OPEN INPUT  UMFILE-I
                OUTPUT REPORT-FILE
                       OUTPUT-FILE.

           ACCEPT CURRENT-DATE FROM DATE.
           ACCEPT CURRENT-TIME FROM TIME.

           MOVE 1            TO  DATE-MODE.
           CALL "TDATECHK" USING DATE-CHECK-AREA.
           MOVE DATE-SLASH-OUT   TO  H1-DATE.
           MOVE CUR-HR       TO  H2-HR.
           MOVE CUR-MIN      TO  H2-MIN.
           MOVE CUR-SEC      TO  H2-SEC.

           PERFORM 61-PRINT-HEADINGS.

           MOVE LOW-VALUES   TO  CODE OF UMFILE-REC-I
                                 PLT  OF UMFILE-REC-I.

           START UMFILE-I KEY >= EXTERNALLY-DESCRIBED-KEY
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           READ UMFILE-I NEXT INTO UM-REC
               AT END MOVE "Y" TO UMFILE-EOF-SW.
           MOVE UM-CODE      TO  SAVE-CODE.
           MOVE 0            TO  NUM-LINKS.
           MOVE SPACES       TO  DETAIL-LINE.
           MOVE UM-CODE      TO  DET-CODE.
           MOVE UM-DESC      TO  DET-DESC.
           MOVE UM-UM        TO  SAVE-UM.
           MOVE "N"          TO  DIFF-UM-SW.

       2-EOJ.
           MOVE TOT-CODES     TO  TOT-LINE-CODES.
           MOVE TOT-DIF-CODES TO  TOT-LINE-DIF.
           WRITE REPORT-FILE-REC FROM TOTAL-LINE-1 AFTER ADVANCING 2.
           WRITE REPORT-FILE-REC FROM TOTAL-LINE-2 AFTER ADVANCING 1.
           CLOSE       UMFILE-I
                       REPORT-FILE
                       OUTPUT-FILE.

      *----------------------------------------------------------------*
      *              M A I N   P A R A G R A P H                       *
      *----------------------------------------------------------------*

       6-MAIN.

           ADD 1 TO NUM-LINKS.
           IF UM-UM = SPACES
               MOVE "**" TO UM-UM.
           EVALUATE UM-PLT
               WHEN "R3 "         MOVE UM-UM   TO DET-R3
               WHEN "112"         MOVE UM-UM   TO DET-112
               WHEN "126"         MOVE UM-UM   TO DET-126
               WHEN "129"         MOVE UM-UM   TO DET-129
               WHEN "131"         MOVE UM-UM   TO DET-131
               WHEN "133"         MOVE UM-UM   TO DET-133
               WHEN "153"         MOVE UM-UM   TO DET-153
               WHEN "155"         MOVE UM-UM   TO DET-155
               WHEN "629"         MOVE UM-UM   TO DET-629
               WHEN "631"         MOVE UM-UM   TO DET-631
               WHEN "637"         MOVE UM-UM   TO DET-637.
           READ UMFILE-I NEXT INTO UM-REC
               AT END MOVE "Y" TO UMFILE-EOF-SW.
           IF UM-CODE NOT = SAVE-CODE
               IF NUM-LINKS > 1 AND SAVE-CODE NOT = "NON-STR"
                   PERFORM 60-WRITE-DETAIL
                   MOVE UM-CODE  TO  SAVE-CODE
                   MOVE UM-UM    TO  SAVE-UM
               ELSE
                   MOVE UM-CODE  TO  SAVE-CODE
                   MOVE UM-UM    TO  SAVE-UM
               END-IF
               MOVE 0            TO  NUM-LINKS
               MOVE SPACES       TO  DETAIL-LINE
               MOVE UM-CODE      TO  DET-CODE
               MOVE UM-DESC      TO  DET-DESC
               MOVE "N"          TO  DIFF-UM-SW
           ELSE
               IF DET-DESC = SPACES AND UM-DESC > SPACES
                   MOVE UM-DESC  TO  DET-DESC
               END-IF
               IF SAVE-UM = SPACES AND UM-UM > SPACES
                   MOVE UM-UM    TO  SAVE-UM
               END-IF
               IF UM-UM NOT = SAVE-UM AND UM-UM NOT = SPACES
                   MOVE "Y"      TO  DIFF-UM-SW.

       60-WRITE-DETAIL.
           IF DIFF-UM-SW = "Y"
      ****     MOVE "<<"         TO  DET-CHG
      *------------- J THOMAS WANTED TO SEE ONLY CODES WITH DIFFERENCES,
      *------------- SO THE CHANGE INDICATOR IS NOT NECESSARY.
               MOVE "  "         TO  DET-CHG
               ADD 1             TO  TOT-DIF-CODES
               WRITE REPORT-FILE-REC FROM DETAIL-LINE AFTER ADVANCING 1
               PERFORM 62-WRITE-UM-FL
               ADD 1             TO  NUM-LINES.
           ADD 1                 TO  TOT-CODES
           IF NUM-LINES > 55
               PERFORM 61-PRINT-HEADINGS.

       61-PRINT-HEADINGS.
           ADD 1                 TO  PAGE-NUM.
           MOVE PAGE-NUM         TO  H2-PAGE-NUM.
           WRITE REPORT-FILE-REC FROM HEADING-1 AFTER ADVANCING PAGE.
           WRITE REPORT-FILE-REC FROM HEADING-2 AFTER ADVANCING 1.
           WRITE REPORT-FILE-REC FROM HEADING-3 AFTER ADVANCING 2.
      **** WRITE REPORT-FILE-REC FROM HEADING-4 AFTER ADVANCING 1.
           WRITE REPORT-FILE-REC FROM HEADING-5 AFTER ADVANCING 1.
      **** MOVE 5                TO  NUM-LINES.
           MOVE 4                TO  NUM-LINES.

       62-WRITE-UM-FL.
           MOVE DET-CODE         TO  R3UM-CORP-CODE.
           MOVE DET-DESC         TO  R3UM-DESC.
           MOVE DET-R3           TO  R3UM-R3-UM.
           MOVE DET-131          TO  R3UM-131-UM.
           MOVE DET-153          TO  R3UM-153-UM.
           MOVE DET-112          TO  R3UM-112-UM.
           MOVE DET-126          TO  R3UM-126-UM.
           MOVE DET-129          TO  R3UM-129-UM.
           MOVE DET-133          TO  R3UM-133-UM.
           MOVE DET-155          TO  R3UM-155-UM.
           MOVE DET-629          TO  R3UM-629-UM.
           MOVE DET-631          TO  R3UM-631-UM.
           MOVE DET-637          TO  R3UM-637-UM.
           WRITE R3UMRPTFL-REC.

