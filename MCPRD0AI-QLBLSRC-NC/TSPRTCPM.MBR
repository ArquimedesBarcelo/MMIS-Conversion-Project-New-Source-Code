       IDENTIFICATION DIVISION.
       PROGRAM-ID.    TSPRTCPM.
       AUTHOR.        R L ENSMINGER.
       INSTALLATION.  GTR.
       DATE-COMPILED.
       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.
       SOURCE-COMPUTER. IBM-AS400.
       OBJECT-COMPUTER. IBM-AS400.
       SPECIAL-NAMES. I-O-FEEDBACK IS I-O-FEEDBACK-AREA
                      LOCAL-DATA IS LOCAL-DATA-AREA.
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT DISPLAY-FILE
               ASSIGN TO WORKSTATION-ZSUFFIX-SI
               ORGANIZATION IS TRANSACTION
               ACCESS IS SEQUENTIAL
               FILE STATUS IS DSPLY-STATUS
               CONTROL-AREA IS WS-CONTROL.
           SELECT FILE1
               ASSIGN TO DATABASE-MCFLMM3801
               ORGANIZATION IS INDEXED
               ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY WITH DUPLICATES
               FILE STATUS IS FILE-STATUS.
           SELECT FILE2
               ASSIGN TO DATABASE-MCFLMM1201
               ORGANIZATION IS INDEXED
               ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY WITH DUPLICATES
               FILE STATUS IS FILE-STATUS.
       DATA DIVISION.
       FILE SECTION.
       FD  DISPLAY-FILE
           LABEL RECORDS ARE OMITTED.
       01  DSPLY-REC               PIC X(2000).
       FD  FILE1
           LABEL RECORDS ARE STANDARD.
       01  REC1.
           COPY DDS-ALL-FORMATS OF MCFLMM3801.
       FD  FILE2
           LABEL RECORDS ARE STANDARD.
       01  REC2.
           COPY DDS-ALL-FORMATS OF MCFLMM1201.
       WORKING-STORAGE SECTION.
       COPY CATREAD OF COPYLIB.
       COPY CPYIND  OF COPYLIB.
       01  DSPLY-STATUS            PIC XX.
       01  ERROR-SW                PIC X.
       01  FILE-STATUS             PIC XX.
       01  FLAG-FIELD              PIC S9(4) COMP-4.
       01  GENERIC-PART-TABLE.
           05 GENERIC-PARTS OCCURS 10 TIMES.
              10 GEN-NAME          PIC X(10).
              10 GEN-STATUS        PIC X(2).
              10 GEN-QTY           PIC 9(8).
              10 GEN-CODE          PIC X(8).
              10 GEN-UM            PIC X(2).
              10 GEN-UNIT-COST     PIC 9(16).
              10 GEN-UNIT-COST-9 REDEFINES GEN-UNIT-COST
                                   PIC 9(12)V9999.
              10 GEN-PRIME         PIC X(4).
              10 GEN-SUB           PIC X(4).
              10 GEN-STAGE         PIC X(4).
              10 GEN-ORIG          PIC X(4).
              10 GEN-INFO          PIC X(14).
              10 GEN-VENDOR        PIC X(30).
              10 GEN-DESC          PIC X(80).
              10 GEN-DESC2         PIC X(80).
              10 GEN-DESC3         PIC X(80).
              10 GEN-DESC4         PIC X(80).
              10 GEN-DESC5         PIC X(80).
              10 GEN-REM           PIC X(80).
              10 GEN-REM2          PIC X(80).
              10 GEN-TOTL-COST     PIC X(16).
       COPY IOFEEDBACK OF COPYLIB.
       01  LEVEL-FIELD             PIC S9(4) COMP-4.
       01  PRTPLAN-KEY1            PIC X(10).
       01  PRTPLAN-KEY2            PIC X(10).
       01  PRTPLAN-FILE1.
           COPY DPRTBANK OF COPYLIB.
       01  PRTPLAN-FILE2.
           COPY DWOPARTS OF COPYLIB.
       01  SS-FIELD                PIC S9(4) COMP-4.
       01  STOP-COPY               PIC X.
       01  S1                      PIC S9(4) COMP-4.
       01  S2                      PIC S9(4) COMP-4.
       01  S3                      PIC S9(4) COMP-4.
       01  S4                      PIC S9(4) COMP-4.
       01  S5                      PIC S9(4) COMP-4.
       01  SAVE-ITEM               PIC 9999.
       01  SCREEN-DATA.
           05 GENERIC-PLAN         PIC X(10).
           05 MASTER-PM            PIC X(10).
           05 SCREEN-LINE OCCURS 10 TIMES.
              10 S-ITEM            PIC X(4).
              10 S-STATUS          PIC X.
              10 S-QUANTITY        PIC 9(5).
              10 S-CODE            PIC X(7).
              10 S-UM              PIC X(2).
              10 S-DESCRIPTION     PIC X(35).
              10 S-LEVEL           PIC X(2).
              10 S-FLAG            PIC X(2).
              10 S-SUBSYSTEM       PIC X(4).
           05 SCREEN-CMD-LINE      PIC X(79).
           05 SCREEN-ERR-LINE      PIC X(79).
       01  TRUE-VAL                PIC 1 VALUE B"1".
       COPY VCOMLINK  OF COPYLIB.

       COPY WSCONTROL OF COPYLIB.
       LINKAGE SECTION.
       01  DBPARAMETERS.
           COPY DBPARMS OF COPYLIB.
       01  MASTER-NAMES.
           05 MASTER-NAME OCCURS 15 TIMES
                                   PIC X(10).
       01  PLANNED-WO-NUM          PIC X(10).
       PROCEDURE DIVISION USING    DBPARAMETERS
                                   MASTER-NAMES
                                   PLANNED-WO-NUM.
       START-PROGRAM.
           PERFORM 1-HSK.
           PERFORM 6-MAIN THRU 6-MAIN-EXIT
               VARYING S1 FROM 1 BY 1
                  UNTIL S1 > 15 OR MASTER-NAME (S1) = SPACES.

       2-EOJ.
           CLOSE DISPLAY-FILE.
           CLOSE FILE1 FILE2.
           GOBACK.

       1-HSK.
           OPEN I-O   DISPLAY-FILE.
           OPEN INPUT FILE1.
           OPEN I-O   FILE2.
           MOVE SPACES TO PRTPLAN-KEY1 PRTPLAN-KEY2.

       6-MAIN.
           MOVE MASTER-NAME (S1) TO PRTPLAN-KEY1.
           MOVE 0 TO SAVE-ITEM.
           MOVE PRTPLAN-KEY1 TO GPRTPNAME.
           START FILE1 KEY = GPRTPNAME.
           IF FILE-STATUS NOT = "00" GO TO 6-MAIN-EXIT.
           MOVE 0 TO VIEW-LASTKEY.
           PERFORM 60-COPY-PRTPLAN THRU 60-COPY-EXIT
               UNTIL VIEW-LASTKEY = 3.

       6-MAIN-EXIT.    EXIT.

       60-COPY-PRTPLAN.
           MOVE SPACES TO GENERIC-PART-TABLE SCREEN-DATA.
           PERFORM 601-GET-PRTPLAN THRU 601-GP-EXIT
               VARYING S2 FROM 1 BY 1
                   UNTIL S2 > 10 OR STOP-COPY = "Y".
           IF GEN-NAME (1) = SPACES GO TO 60-COPY-EXIT.
           PERFORM 602-SHOW-SCREEN.
           PERFORM 603-READ-SCREEN.
           PERFORM 604-ADD-PRTPLAN THRU 604-ADD-EXIT
               VARYING S5 FROM 1 BY 1
                   UNTIL S5 > 10 OR GEN-NAME (S5) = SPACES.

       60-COPY-EXIT.    EXIT.

       601-GET-PRTPLAN.
           READ FILE1 NEXT RECORD INTO PRTPLAN-FILE1.
           IF FILE-STATUS NOT = "00"
             MOVE 3 TO VIEW-LASTKEY
             GO TO 601-GP-EXIT.
           IF MPRTNAME NOT = MASTER-NAME (S1)
             MOVE 3 TO VIEW-LASTKEY
             GO TO 601-GP-EXIT.
           MOVE PRTPLAN-FILE1 TO GENERIC-PARTS (S2).
           ADD 1 TO SAVE-ITEM.
           MOVE SAVE-ITEM       TO S-ITEM        (S2).
           MOVE GEN-STATUS (S2) TO S-STATUS      (S2).
           MOVE GEN-QTY    (S2) TO S-QUANTITY    (S2).
           MOVE GEN-CODE   (S2) TO S-CODE        (S2).
           MOVE GEN-UM     (S2) TO S-UM          (S2).
           MOVE GEN-DESC   (S2) TO S-DESCRIPTION (S2).

       601-GP-EXIT.    EXIT.

       602-SHOW-SCREEN.
           MOVE MASTER-NAME (S1) TO GENERIC-PLAN.
           MOVE PLANNED-WO-NUM   TO MASTER-PM.

       603-READ-SCREEN.
           MOVE "FSPRTCPM" TO VIEW-CFNAME.
           MOVE SCREEN-DATA TO DSPLY-REC.
           PERFORM 99-SCREEN-WRITE.
           PERFORM 98-SCREEN-READ.
           MOVE DSPLY-REC TO SCREEN-DATA.
           IF VIEW-LASTKEY = 3 GO TO 2-EOJ.
           MOVE "N" TO ERROR-SW.
           MOVE 10  TO LEVEL-FIELD.
           MOVE 11  TO FLAG-FIELD.
           MOVE 12  TO SS-FIELD.
           PERFORM 6030-CHECK-LEVELS THRU 6030-LEVEL-EXIT
               VARYING S3 FROM 1 BY 1
               UNTIL S3 > 10 OR S-ITEM (S3) = SPACES OR ERROR-SW = "Y".
           IF ERROR-SW = "Y" GO TO 603-READ-SCREEN.

       6030-CHECK-LEVELS.
           IF S-LEVEL (S3) NOT NUMERIC
             MOVE "Y" TO ERROR-SW
             MOVE 35086 TO CATREAD-MSG-NUMBER
             CALL "CCATREAD" USING CATREAD-PARMS
             MOVE CATREAD-MSG-TEXT TO SCREEN-ERR-LINE
             MOVE TRUE-VAL TO INDS (LEVEL-FIELD) INDS (99)
             GO TO 6030-LEVEL-EXIT.

           IF S-FLAG (S3) NOT NUMERIC
             MOVE "Y" TO ERROR-SW
             MOVE 00022 TO CATREAD-MSG-NUMBER
             CALL "CCATREAD" USING CATREAD-PARMS
             MOVE CATREAD-MSG-TEXT TO SCREEN-ERR-LINE
             MOVE TRUE-VAL TO INDS (FLAG-FIELD) INDS (99)
             GO TO 6030-LEVEL-EXIT.

           IF S-SUBSYSTEM (S3) NOT NUMERIC
             MOVE "Y" TO ERROR-SW
             MOVE 27016 TO CATREAD-MSG-NUMBER
             CALL "CCATREAD" USING CATREAD-PARMS
             MOVE CATREAD-MSG-TEXT TO SCREEN-ERR-LINE
             MOVE TRUE-VAL TO INDS (SS-FIELD) INDS (99)
             GO TO 6030-LEVEL-EXIT.

           IF S-FLAG (S3) = "00"
             MOVE "99" TO S-FLAG (S3).

           IF S-LEVEL (S3) > "00"
             NEXT SENTENCE
           ELSE
             MOVE "Y" TO ERROR-SW
             MOVE 35086 TO CATREAD-MSG-NUMBER
             CALL "CCATREAD" USING CATREAD-PARMS
             MOVE CATREAD-MSG-TEXT TO SCREEN-ERR-LINE
             MOVE TRUE-VAL TO INDS (LEVEL-FIELD) INDS (99)
             GO TO 6030-LEVEL-EXIT.

           IF S-FLAG (S3) > S-LEVEL (S3)
             NEXT SENTENCE
           ELSE
             MOVE "Y" TO ERROR-SW
             MOVE 35086 TO CATREAD-MSG-NUMBER
             CALL "CCATREAD" USING CATREAD-PARMS
             MOVE CATREAD-MSG-TEXT TO SCREEN-ERR-LINE
             MOVE TRUE-VAL TO INDS (LEVEL-FIELD) INDS (99)
             GO TO 6030-LEVEL-EXIT.

           ADD 3 TO LEVEL-FIELD
                    FLAG-FIELD
                    SS-FIELD.

       6030-LEVEL-EXIT.    EXIT.

       604-ADD-PRTPLAN.
           MOVE SPACES TO PRTPLAN-FILE2.
           MOVE PLANNED-WO-NUM TO PRT-WO-NU.
           MOVE GEN-STATUS    (S5) TO PRT-STATUS OF PRTPLAN-FILE2.
           MOVE GEN-QTY       (S5) TO PRT-EST-QTY OF PRTPLAN-FILE2.
           MOVE GEN-CODE      (S5) TO PRT-NUM OF PRTPLAN-FILE2.
           MOVE GEN-UM        (S5) TO PRT-UNIT-MEAS OF PRTPLAN-FILE2.
           MOVE GEN-UNIT-COST (S5) TO PRT-UNIT-COST OF PRTPLAN-FILE2.
           MOVE GEN-PRIME     (S5) TO PRT-PRIME OF PRTPLAN-FILE2.
           MOVE GEN-SUB       (S5) TO PRT-SUB OF PRTPLAN-FILE2.
           MOVE GEN-STAGE     (S5) TO PRT-STAGE OF PRTPLAN-FILE2.
           MOVE GEN-ORIG      (S5) TO PRT-ORIGINATOR OF PRTPLAN-FILE2.
           MOVE GEN-INFO      (S5) TO PRT-ADDL-INFO OF PRTPLAN-FILE2.
           MOVE GEN-VENDOR    (S5) TO PRT-SUGG-VENDOR OF PRTPLAN-FILE2.
           MOVE GEN-DESC      (S5) TO PRT-DESC OF PRTPLAN-FILE2.
           MOVE GEN-DESC2     (S5) TO PRT-DESC-2 OF PRTPLAN-FILE2.
           MOVE GEN-DESC3     (S5) TO PRT-DESC-3 OF PRTPLAN-FILE2.
           MOVE GEN-DESC4     (S5) TO PRT-DESC-4 OF PRTPLAN-FILE2.
           MOVE GEN-DESC5     (S5) TO PRT-DESC-5 OF PRTPLAN-FILE2.
           MOVE GEN-REM       (S5) TO PRT-REMARKS OF PRTPLAN-FILE2.
           MOVE GEN-REM2      (S5) TO PRT-REMARKS-2 OF PRTPLAN-FILE2.
           MOVE GEN-TOTL-COST (S5) TO PRT-EST-COST OF PRTPLAN-FILE2.
           MOVE S-LEVEL       (S5) TO PRT-LEVEL OF PRTPLAN-FILE2.
           MOVE S-FLAG        (S5) TO PRT-FLAG OF PRTPLAN-FILE2.
           MOVE S-SUBSYSTEM   (S5) TO PRT-SS OF PRTPLAN-FILE2.
           WRITE REC2 FROM PRTPLAN-FILE2.
           IF FILE-STATUS NOT = "00"
            DISPLAY "ERROR: FILE STATUS = "
                    FILE-STATUS
                    " ON WRITE TO FILE2"
            GO TO 2-EOJ.

       604-ADD-EXIT.    EXIT.

       98-SCREEN-READ.
           READ DISPLAY-FILE FORMAT IS VIEW-CFNAME
               INDIC IS INDICS.
           ACCEPT IOFEEDBACK FROM I-O-FEEDBACK-AREA.
           MOVE ALL B"0" TO INDICS.
           IF DSPLY-STATUS NOT = "00"
               MOVE 3 TO VIEW-LASTKEY
           ELSE
           MOVE FUNCTION-NUM TO VIEW-LASTKEY.

       99-SCREEN-WRITE.
           WRITE DSPLY-REC FORMAT IS VIEW-CFNAME
               INDIC IS INDICS.
           MOVE ALL B"0" TO INDICS.
