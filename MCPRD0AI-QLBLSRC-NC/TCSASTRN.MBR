       77  COMP-ESC-SEQ                  PIC X(8)  VALUE SPACES.
       77  STAND-ESC-SEQ                 PIC X(8)  VALUE SPACES.
       77  END-OF-FILE-FLAG              PIC X(1).
       77  FOUND-DEPT-FLAG               PIC X(1).
       77  SAVE-TOTAL-COST               PIC S9(14)V9(4) VALUE 0.
       77  FIRST-TIME-FLAG               PIC X(1).
       77  SAVE-DEPT                     PIC X(4).
       77  RPT-TOTAL-FLAG                PIC X(1).
       77  MCXCBLERR-SCOPE               PIC X(1)  VALUE "C".
       77  SAVE-STR-DEPT                 PIC X(6)  VALUE SPACES.
       77  INVALID-DATE-FLAG             PIC X(1)  VALUE "N".

      *-------- ACCOUNT FOR CENTURY.
       01  SAVE-LOW-DATE-CN.
           05  SAVE-LOW-DATE-CC          PIC XX.
           05  SAVE-LOW-DATE.
               10  SAVE-LOW-DATE-YY      PIC XX.
               10  FILLER                PIC X(4).

       01  SAVE-HIGH-DATE-CN.
           05  SAVE-HIGH-DATE-CC         PIC XX.
           05  SAVE-HIGH-DATE.
               10  SAVE-HIGH-DATE-YY     PIC XX.
               10  FILLER                PIC X(4).

       01  JUST-1-TC                     PIC X(1).
       01  FOUND-TC                      PIC X(1).
DP0401 01  NUM-TCS-FOUND                 PIC 9(3)  VALUE 0.
       01  TC-TOTAL-ARRAY.
DP0401     05  TC-TOTAL-LINE OCCURS 900 TIMES.
               10  TC-TOTAL-TYPE         PIC X(4).
               10  TC-TOTAL              PIC S9(14)V9(4).
               10  TC-COUNT              PIC 9(5).
       01  CHECK-DTRANS2-SW              PIC X     VALUE "N".
       01  DTRANS-EOF-SW                 PIC X     VALUE "N".
       01  HOLD-ACCT                     PIC X(6).
      *--- THIS TABLE HOLDS THE VALUES TO BE ACCUMULATED FOR THE SUMMARY
      *--- REPORT.
       01  SUMMARY-TABLE.
           05  TBL-DATA OCCURS 400 TIMES.
               10  TBL-ACCT              PIC X(6).
               10  TBL-VALUE             PIC S9(12)V99.
       01  TEMP-ACCT                     PIC X(6).
       01  TEMP-VALUE                    PIC S9(12)V99.
       01  ADDR1                         PIC 9(3).
       01  ADDR2                         PIC 9(3).
       01  ADDR3                         PIC 9(3).
       01  ADDR4                         PIC 9(3).
       01  SUM-TOT-HOLD                  PIC S9(12)V99.
       01  HOLD-DEPT-VALUE               PIC S9(12)V99.
       01  HOLD-OPR-VALUE                PIC S9(12)V99.
       01  DEPT-TOTAL-TABLE.
           05  DEPT-TOTAL-LINE OCCURS 6 TIMES.
               10  DEPT-TRANS            PIC X(4).
               10  DEPT-TOTALS.
                   15  DEPT-ENG          PIC S9(12)V99.
                   15  DEPT-OPR          PIC S9(12)V99.

       01  BREAK-TOTALS-WORK.
           05  L1-COUNT                  PIC 9(8)  VALUE 0.
           05  L1-TOTAL-COST             PIC S9(14)V9(4) VALUE 0.
           05  L2-COUNT                  PIC 9(8)  VALUE 0.
           05  L2-TOTAL-COST             PIC S9(14)V9(4) VALUE 0.
           05  RPT-COUNT                 PIC 9(8)  VALUE 0.
           05  RPT-TOTAL-COST            PIC S9(14)V9(4) VALUE 0.
           05  BREAK-FLD-L1              PIC X(14).
           05  BREAK-FLD-L2              PIC X(14).
           05  TEST-BREAK-L1             PIC X(14).
           05  TEST-BREAK-L2             PIC X(14).
           05  BREAK-FLAG-L1             PIC X(1).
           05  BREAK-FLAG-L2             PIC X(1).

       01  LAWTON-ENG-ACCT               PIC X(6).
           88  ENG-ACCT      VALUE "000001" THRU "000099", "000242",
                                                 "000250", "000254".

      *-------- DON'T INCLUDE 242 & 254 IN 250 ON SUMMARY REPORT.
       01  LAWTON-ENG-ACCT-RPT           PIC X(6).
           88  ENG-ACCT-RPT  VALUE "000001" THRU "000099", "000250".

