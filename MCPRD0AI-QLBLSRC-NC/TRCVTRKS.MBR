       IDENTIFICATION DIVISION.
       PROGRAM-ID.             TRCVTRKS.
       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.
       SOURCE-COMPUTER.        IBM-AS400.
       OBJECT-COMPUTER.        IBM-AS400.

      *****************************************************************
      *C   NOVEMBER 4, 1997   JEFF BUNGO
      *C     ADDED CALL TO THE COBOL ERROR HANDLER ROUTINE - MCXCBLERR.
      *C
      *****************************************************************

       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT RCVTRK-FILE
                  ASSIGN       TO DATABASE-MCFPCSRCVT
                  ORGANIZATION IS RELATIVE
                  ACCESS MODE  IS RANDOM
                  RELATIVE KEY IS ARG-NO
                  FILE STATUS  IS FILE-STAT.

       DATA DIVISION.
       FILE SECTION.
       FD  RCVTRK-FILE
           RECORD CONTAINS     152 CHARACTERS
           LABEL RECORDS       ARE OMITTED
           DATA RECORD         IS RCVTRK-REC.
       01  RCVTRK-REC.
           COPY DDS-ALL-FORMATS OF MCFPCSRCVT.

       WORKING-STORAGE SECTION.
       77  ARG-NO              PIC 9(9).
       77  MCXCBLERR-SCOPE             PIC X(1)  VALUE "C".

       01  FILE-STAT.
           05  FILE-STAT-1     PIC X VALUE "0".
           05  FILE-STAT-2     PIC X VALUE "0".

       01  PASSED-SELECTION-DATA.
           05  FILLER          PIC X(151).
           05  AUTO-MANUAL     PIC X(01).

       PROCEDURE DIVISION.
       MAIN.
           MOVE "C" TO MCXCBLERR-SCOPE.
           CALL "MCXCBLERR" USING MCXCBLERR-SCOPE.
           OPEN I-O            RCVTRK-FILE.
           MOVE 1              TO ARG-NO.
           READ RCVTRK-FILE    INTO PASSED-SELECTION-DATA
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
               DISPLAY "  OPEN ERROR, TRCVTRKS, RCVTRK-FILE/MAIN"
               DISPLAY "    FILE-STATUS = " FILE-STAT
               GO TO END-OF-JOB.

           MOVE SPACES         TO PASSED-SELECTION-DATA.
           MOVE "A"            TO AUTO-MANUAL.

           REWRITE RCVTRK-REC  FROM PASSED-SELECTION-DATA
               INVALID KEY
               DISPLAY "  TRCVTRKS, REWRITE FAILED ON RCVTRK-FILE"
               DISPLAY "    FILE-STATUS = " FILE-STAT.

       END-OF-JOB.
           CLOSE               RCVTRK-FILE.
           CALL "SRCVTRKR".
           GOBACK.

