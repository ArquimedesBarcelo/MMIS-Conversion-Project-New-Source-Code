       LINKAGE SECTION.

       01  BASE                          PIC X(10).
       01  MMIS-BASE                     PIC X(13).

       COPY DBSTAT     IN COPYLIB.
       COPY VCOMLINK   IN COPYLIB.
       COPY STCOM      IN COPYLIB.
       COPY TSHWSUB    IN COPYLIB.
       COPY LANGSUB    IN COPYLIB.
       COPY MULTSTR    IN COPYLIB.
       COPY ESCNAME   IN COPYLIB.

       PROCEDURE DIVISION USING BASE MMIS-BASE STATUS-AREA
                                VIEW-COMAREA STORES-COMAREA
                                SRF-COMAREA, SRF-SPOOLER-REC,
                                LANGUAGE-PARMS, MULTIPLE-STR-DATA,
                                ESC-NAME.

       1-HSK.

           MOVE 0 TO SUB2.
           MOVE 0 TO SUB3.
           MOVE 0 TO SUB4.
           MOVE 0 TO SUB5.
           MOVE 0 TO TABLE-LIMIT.
           MOVE 0 TO RET-SUB.
           MOVE SPACES TO RET-CODE.
           MOVE 0 TO EDIT-SUB.
           MOVE 0 TO SAVE-SUB.
           MOVE "N" TO WARNING-FLAG.
           MOVE " " TO WARNING-TYPE.
           MOVE 0   TO WARNING-VALUE.

           PERFORM 9999-OPEN-STUFF.

           PERFORM VARYING SUB FROM 1 BY 1
                   UNTIL SUB GREATER THAN 5

             MOVE 0 TO BU-DISPLAY-FLD9 (SUB)
             MOVE SPACES TO BU-DISPLAY-FLD (SUB)

           END-PERFORM.

           IF SCOM-PGM-KEY = "ST2"
               MOVE "ST"                       TO WRKL-NO-KEY
           ELSE
               MOVE "SW"                       TO WRKL-NO-KEY.

           MOVE SPACES                         TO WORK-LIST-TABLE.

      *------5/6/97 GET FRANCHISE TABLE.
           MOVE "FRAN" TO PLTINFOKEY OF MPLTINFO-REC.
           READ MPLTINFO INTO BUF-MPLTINFO.
           IF FILE-STATUS NOT = "00"
               MOVE SPACES               TO   FRAN-TABLE
           ELSE
               MOVE MPLTINFO-FRANCHISES  TO   FRAN-TABLE.

           GO TO 6-MAIN.

       2100-BLOWUP.
           MOVE SAVE-PARA-NUMBER         TO   BU-DISPLAY-PARA.
           MOVE "TIRWSBLD" TO BU-PGM-NAME.
           CALL "TBLOWUP" USING BASE BU-PGM-NAME STATUS-AREA
             VIEW-COMAREA FILE-STATUS BU-DISPLAY-MSG
             BU-DISPLAY-FLDS.

       6-MAIN.
           MOVE 1 TO SAVE-PARA-NUMBER.
      *---------- THE AKRON PLANTS HAVE A SPECIAL FORM
           IF SCOM-PGM-KEY = "SW2"
               IF AKRON-PLANT
                   MOVE "ISWSBLD_AK"     TO   VIEW-NFNAME
               ELSE
                   MOVE "ISWSBLD"        TO   VIEW-NFNAME
           ELSE
               IF AKRON-PLANT
                   MOVE "RTWSBLD_AK"     TO   VIEW-NFNAME
               ELSE
                   MOVE "RTWSBLD"        TO   VIEW-NFNAME.

           PERFORM 9999-GETNEXTFORM.
           PERFORM 7000-CLEAR-FORM.

       61-SHOWFORM-1.
           MOVE 2 TO SAVE-PARA-NUMBER.
           MOVE SPACES TO WORK-LIST-TABLE.
      *---------- f1, f1 APPLICATIONS, f3, f6 INVALID, f4 REFRESH,
      *---------- f5 PRINT, f7 CLEAR
           MOVE 5                        TO   SRF-KEYSET.
       6110-SHOWFORM.
           PERFORM 9999-DO-SCREEN-1.

           IF VIEW-LASTKEY = EXIT-PROGRAM OR F1-KEY OR F2-KEY
               GO TO 6-MAIN-X.

      *
      * N2:NOW EDITING
      *
           MOVE 14072 TO CATREAD-MSG-NUMBER.
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
           MOVE "Y" TO SRF-MSG-AND-GO.
           PERFORM 9999-SETERROR-1.
      *

           MOVE 15 TO SUB.
       612-DETERMINE-TABLE-LIMIT.
           MOVE 3 TO SAVE-PARA-NUMBER.
           SUBTRACT 1 FROM SUB.
           IF SUB < 1
               MOVE 03103 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE 1 TO SRF-ERROR-FLD
               GO TO 61-SHOWFORM-1.
           IF DE-CODE (SUB) = SPACES
               GO TO 612-DETERMINE-TABLE-LIMIT.
           MOVE SUB TO TABLE-LIMIT.

           MOVE 0 TO SUB.
       62-DEFAULT-LOAD.
           MOVE 4 TO SAVE-PARA-NUMBER.
           ADD 1 TO SUB.
           IF SUB > TABLE-LIMIT
               GO TO 6-CONTINUE.
           IF DE-CODE (SUB) = SPACES
               GO TO 62-DEFAULT-LOAD.
           IF DE-EMPL (SUB)      = SPACES    AND
              DE-WO (SUB)        = SPACES    AND
              DE-REQ-DEPT (SUB)       = SPACES    AND
              DE-CHARGE-DEPT (SUB)    = SPACES    AND
              DE-EXP-CLASS (SUB) = SPACES
                 MOVE DE-EMPL (1)           TO DE-EMPL (SUB)
                 MOVE DE-WO (1)             TO DE-WO (SUB)
                 MOVE DE-REQ-DEPT (1)       TO DE-REQ-DEPT (SUB)
                 MOVE DE-CHARGE-DEPT (1)    TO DE-CHARGE-DEPT (SUB)
                 MOVE DE-EXP-CLASS (1)      TO DE-EXP-CLASS (SUB)
                 MOVE DE-WORK-CENTER (1)    TO DE-WORK-CENTER (SUB).

           MOVE SUB TO SUB2.
           PERFORM 621-CHECK-DUPLICATES UNTIL SUB2 = 1.

           GO TO 62-DEFAULT-LOAD.

       621-CHECK-DUPLICATES.
           SUBTRACT 1 FROM SUB2.
           IF DE-CODE (SUB2) = DE-CODE (SUB)
               MOVE 03108 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               COMPUTE SRF-ERROR-FLD = (9 * (SUB - 1)) + 1
               GO TO 61-SHOWFORM-1.

       6-CONTINUE.
           MOVE 0  TO SUB, SUB4.
           MOVE 5 TO SAVE-PARA-NUMBER.
       63-EDIT-LOOP.
           ADD 1 TO SUB.
           IF SUB > TABLE-LIMIT
               GO TO 64-CREATE-WORKSHEET.

           IF DE-CODE (SUB) = SPACES
               GO TO 63-EDIT-LOOP.

           MOVE DE-CODE (SUB) TO CODE-ARG.
           PERFORM 9999-GETKEY-MSTORERM-CD-I.
           IF NO-ENTRY
               MOVE 19009 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER TO MSG-TEXT
               MOVE DE-CODE (SUB)                TO MSG-FLD
               COMPUTE SRF-ERROR-FLD = (9 * (SUB - 1)) + 1
               GO TO 61-SHOWFORM-1.

           IF STR-STATE = "F"
               MOVE 13032 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER TO MSG-TEXT
               MOVE DE-CODE (SUB)               TO MSG-FLD
               COMPUTE SRF-ERROR-FLD = (9 * (SUB - 1)) + 1
               GO TO 61-SHOWFORM-1.

           MOVE SRF-MPLTINFO-COMPANY      TO  EDIT-PLANT-CODE.
           MOVE DE-CODE (SUB)             TO  EDIT-CODE.
           MOVE DE-EMPL (SUB)             TO  EDIT-EMPL.
           MOVE DE-WO (SUB)               TO  EDIT-WO.
           MOVE DE-REQ-DEPT (SUB)         TO  EDIT-REQ-DEPT.
           MOVE DE-CHARGE-DEPT (SUB)      TO  EDIT-CHARGE-DEPT.
           MOVE DE-EXP-CLASS (SUB)        TO  EDIT-EXP-CLASS.
           MOVE STR-RESTRICTED-FLG        TO  EDIT-RESTRICTED-FLG.
           MOVE STR-REQ-CHG-OVERRD        TO  EDIT-REQ-CHG-OVERRD.
           MOVE STR-DIR-CHRG-DEPT         TO  EDIT-DIR-CHRG-DEPT.

           IF SCOM-PGM-KEY = "SW2"
               MOVE "IS" TO RET-CODE
           ELSE
               MOVE "RT" TO RET-CODE.
           CALL "TIREDIT" USING RET-CODE, BASE, MMIS-BASE, PART-WORKAREA,
             STATUS-AREA, EDIT-DATA, MESSAGE-BUFFER, MULTIPLE-STR-DATA,
             STORES-COMAREA, STR-EXPENSE-CLASS, LANGUAGE-PARMS.
           IF RET-CODE = "BU"
               MOVE "TIREDIT ERROR 631-RF" TO BU-DISPLAY-MSG
               PERFORM 2100-BLOWUP.

           MOVE EDIT-CODE                   TO  DE-CODE (SUB).
           MOVE EDIT-EMPL                   TO  DE-EMPL (SUB).
           MOVE EDIT-WO                     TO  DE-WO (SUB).
           MOVE EDIT-REQ-DEPT               TO  DE-REQ-DEPT (SUB).
           MOVE EDIT-CHARGE-DEPT            TO  DE-CHARGE-DEPT (SUB).
           MOVE EDIT-EXP-CLASS              TO  DE-EXP-CLASS (SUB).

           IF MESSAGE-BUFFER NOT = SPACES
               COMPUTE SRF-ERROR-FLD = (9 * (SUB - 1)) + EDIT-SUB + 2
               GO TO 61-SHOWFORM-1.

           IF RET-CODE = "BU"
               MOVE "TIREDIT ERROR 631-RF" TO BU-DISPLAY-MSG
               PERFORM 2100-BLOWUP.

           MOVE DE-QTY-X (SUB) TO EDIT-TOTAL-QTY-X.
           MOVE DE-WO (SUB)    TO QEDIT-WO.

           IF SCOM-PGM-KEY = "SW2"
               MOVE "I4"     TO  RET-CODE
           ELSE
               MOVE "R4"     TO  RET-CODE.

      *-----  INITIALIZE WARNING-FLAG FOR TQTYEDIT FOR RETURN LIMITS
      *-----  FOR CURRENT ENTRY (SUB) ONLY IF IT IS BEYOND ANY PRIOR
      *-----  ENTRIES IN ERROR (SAVE-SUB)  {SAVE-SUB = 0 IF NO ERRORS}
           IF SUB > SAVE-SUB
              MOVE "N" TO WARNING-FLAG.

      *------5/2/97 INIT BIN-AREA WITH FRANCHISE FOR BINS
           PERFORM VARYING FRAN-SUB FROM 1 BY 1 UNTIL FRAN-SUB > 6
               IF FRAN-TABLE = SPACES
                   MOVE SPACES TO DE-FRAN(FRAN-SUB)
               ELSE
                   SET FRAN-IDX TO 1
                   SEARCH FRAN-ENTRY
                     AT END  MOVE SPACES TO DE-FRAN (FRAN-SUB)
                     WHEN FRAN-ID(FRAN-IDX) = STR-BIN-OWNER (FRAN-SUB)
                      MOVE FRAN-NAME(FRAN-IDX) TO DE-FRAN(FRAN-SUB)
                   END-SEARCH
               END-IF
           END-PERFORM.

      *---------- TQTYEDIT RETURNS THE BIN AREA - IT SPREADS THE TOTAL QTY
      *---------- OUT BETWEEN THE BINS AS REQUIRED.
           CALL "TQTYEDIT" USING RET-CODE, BASE, STATUS-AREA,
             CODE-ARG, QEDIT-WO, STR-ONHAND, STR-RESERVED,
             STR-LOC-AREA, BIN-AREA , EDIT-TOTAL-QTY, ISSUED-QTY,
             RET-SUB, MESSAGE-BUFFER, MULTIPLE-STR-DATA,
             LANGUAGE-PARMS, WARNING-FLAG, WARNING-TYPE,
             WARNING-VALUE, STR-AVG-COST, DE-CHARGE-DEPT-1-4(SUB),
             DE-EXP-CLASS(SUB), DE-EMPL(SUB), STR-UM, STR-MAX,
             STR-REORDER
             STR-CODE-OWNER FRAN-TABLE.
           IF RET-CODE NOT = "00"
               MOVE "TQTYEDIT ERROR " TO BU-DISPLAY-MSG
               PERFORM 2100-BLOWUP.

      *------ IF WARNING-FLAG IS "Y", THEN A UNIT QTY/VALUE LIMITS HAS
      *------ BEEN SURPASSED.  IF CURRENT WORKSHEET ENTRY IN ERROR (SUB)
      *------ IS GREATER THAN LAST ENTRY FLAGGED FOR ERROR (SAVE-SUB),
      *------ THEN THIS IS FIRST CHECK ON THIS ENTRY.  MOVE THIS ENTRY
      *------ NUMBER TO SAVE-SUB.  IF CURRENT ENTRY NOT GREATER, THAN
      *------ THIS ENTRY HAS ALREADY BEEN CHECKED AND ACCEPTED BY USER.
      *------ IN THIS CASE, DO NOT MOVE NUMBER TO SAVE-SUB, AS THIS WILL
      *------ KEEP THE WARNING-FLAG SET TO "Y" UNTIL WE REACH THE FIRST
      *------ LIMIT CHECK ON AN ENTRY ( I.E. SUB > SAVE-SUB)
           IF WARNING-FLAG = "Y"
              IF SUB > SAVE-SUB
                 MOVE SUB TO SAVE-SUB.

           IF MESSAGE-BUFFER NOT = SPACES
               COMPUTE SRF-ERROR-FLD = (9 * (SUB - 1)) + 2
               GO TO 61-SHOWFORM-1.

           MOVE EDIT-TOTAL-QTY-X  TO  DE-QTY-X (SUB).

           ADD 1                     TO  SUB4.
           MOVE DE-CODE (SUB)        TO  WLT-CODE (SUB4).
           MOVE DE-CHARGE-DEPT (SUB) TO  WLT-CHARGE-DEPT (SUB4).
           MOVE DE-WO (SUB)          TO  WLT-WO (SUB4).
           MOVE DE-WORK-CENTER (SUB) TO  WLT-WORK-CENTER (SUB4).
           MOVE DE-EMPL (SUB)        TO  WLT-EMPL (SUB4).
           MOVE STR-UM               TO  WLT-UM (SUB4).
           MOVE BIN-AREA             TO  FIL-BIN-AREA (SUB4).
           PERFORM VARYING SUB5 FROM 1 BY 1
                   UNTIL SUB5 GREATER THAN 6

               MOVE FIL-BIN (SUB4, SUB5) TO  WLT-BIN (SUB4, SUB5)
               MOVE FIL-QTY (SUB4, SUB5) TO  WLT-QTY (SUB4, SUB5)
           END-PERFORM.
           MOVE DE-REQ-DEPT (SUB)    TO  WLT-REQ-DEPT (SUB4).
           MOVE STR-DISB-INSTR       TO  WLT-DISB-INSTR (SUB4).
           MOVE DE-EXP-CLASS (SUB)   TO  WLT-EXP-CLASS (SUB4).

           GO TO 63-EDIT-LOOP.

       64-CREATE-WORKSHEET.
           MOVE 6 TO SAVE-PARA-NUMBER.
      *
      * LOCK THE DATA-SET AND GET THE WORKSHEET NUMBER
      *
           MOVE DSET-MWRKLIST TO DSET-NAME.
           PERFORM 9999-DSET-LOCK.
           MOVE 0 TO WRKL-NO-INC.
           PERFORM 9999-GETKEY-MWRKLIST-WK-O.

      ***  WORKSHEET NUMBER IS INCREMENTED BY ONE FROM LAST WS
      ***  CREATED.  (STORED IN THE SW0000 KEY IN MWRKLIST).
      ***  NOTE THAT IF THE LAST WORKSHEET WAS #9999, THE NEXT
      ***  INCREMENT WOULD BE ZERO.  ATTEMPTING TO CREATE A
      ***  0000 WORKSHEET WOULD RESULT IN DUPLICATE KEY ERROR.

           MOVE WRKLIST-DATE-CN TO  WL-ARG-CN.
           ADD 1             TO  WRKL-NO-INC.
           IF WRKL-NO-INC = 0
               ADD 1         TO  WRKL-NO-INC.
           MOVE WL-ARG-CN TO  WRKLIST-DATE-CN.
           PERFORM 9999-UPDATE-MWRKLIST-WK-O.

      ************************************************************
      **   GIVE A "NOW PROCESSING" OR "OVERRIDDEN...."  MESSAGE **
      ************************************************************
           IF MP1-OVERRD-CHG-DEPT = "Y"  OR
              STR-REQ-CHG-OVERRD = "X"   OR
              (ENTRY-OVERRD-EXP = "N"  AND  WO-OVERRD-EXP = "N")
               MOVE 05069                TO  CATREAD-MSG-NUMBER
           ELSE
               MOVE 14002 TO CATREAD-MSG-NUMBER.
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
           MOVE MESSAGE-BUFFER TO MSG-TEXT.
           MOVE WRKL-NO-INC TO MSG-FLD-9.
           MOVE "Y" TO SRF-MSG-AND-GO.
           PERFORM 9999-SETERROR-1.
      *


           CALL "TDATECK2" USING DATE-CHECK-AREA, LANGUAGE-PARMS.

           MOVE WL-ARG        TO  WRKLIST-KEY.
           MOVE DATE-YMD-OUT      TO  WORK-DATE-YMD.
           IF WORK-DATE-YY > "70"
               MOVE "19" TO WORK-DATE-CC
           ELSE
               MOVE "20" TO WORK-DATE-CC.
           MOVE WORK-DATE-CYMD TO WRKLIST-DATE-CN.
           PERFORM 9999-PUT-MWRKLIST-WK-O.
           PERFORM 9999-UNLOCK.
           MOVE WL-ARG TO LOCK-VALUE.
           PERFORM 9999-MULTI-LOCK.
           MOVE 0            TO  SUB.
           MOVE WL-ARG TO  WL-KEY.
           MOVE 7 TO SAVE-PARA-NUMBER.
       65-PUT-WL-DTL-LOOP.
           ADD 1 TO SUB.
           IF SUB > SUB4
               GO TO 66-PRINT-WORKSHEET.

           MOVE WLT-RCD (SUB)         TO  WL-RCD-DATA.
           MOVE WLT-EXP-CLASS (SUB)   TO  WL-EXP-CLASS.

           PERFORM 9999-PUT-DWLITEM-WK-O.

           GO TO 65-PUT-WL-DTL-LOOP.

       66-PRINT-WORKSHEET.

      *-----9/16/97 JSB, IF RESEARCH (119) GET CCS INFO
           IF SRF-MPLTINFO-COMPANY = '119'
               PERFORM 8000-CCS THRU 8000-EXIT.

           MOVE 8 TO SAVE-PARA-NUMBER.
           PERFORM 9999-UNLOCK.

           IF SRF-SPOOL-NO (5) = "99"
               MOVE "H"   TO  HALF-SHEET-FLAG.
           IF SCOM-PGM-KEY = "ST2"
               MOVE "R"  TO  RETURN-FLAG
           ELSE
               MOVE SPACES TO RETURN-FLAG.
           IF AKRON-PLANT
               MOVE "Y"  TO  AKRON-FLAG.
           CALL "TWSPRT" USING RET-CODE, BASE, MMIS-BASE, STATUS-AREA,
             SRF-SPOOL-PRT-NO, WL-ARG, WORK-LIST-TABLE, WS-PARMS,
             LANGUAGE-PARMS, ESC-NAME, BU-DISPLAY-MSG,
             MULTIPLE-STR-DATA.
           IF BU-DISPLAY-MSG-1 NOT = SPACES
               PERFORM 2100-BLOWUP.


       67-CLEAR-FORM.
           MOVE 9 TO SAVE-PARA-NUMBER.
           PERFORM 7000-CLEAR-FORM.
           PERFORM 9999-RESET-SCREEN.

      *-----  INITIALIZE WARNING-FLAG FOR TQTYEDIT FOR RETURN LIMITS
      *-----  DONE HERE SO EACH QTY ON WORKSHEET CHECKED AT LEAST ONCE
      *-----  ALSO SET SAVE-SUB TO 0
           MOVE "N" TO WARNING-FLAG.
           MOVE 0  TO SAVE-SUB.

           GO TO 61-SHOWFORM-1.

       6-MAIN-X.
           MOVE 10 TO SAVE-PARA-NUMBER.
           PERFORM 7000-CLEAR-FORM.
           PERFORM 9999-CLOSE-STUFF.
           GOBACK.

       7000-CLEAR-FORM.
           MOVE SPACES                   TO   MESSAGE-BUFFER.
           PERFORM 9999-PUTWINDOW.
           MOVE SPACES                   TO   DE-FIELDS-1.
           PERFORM 9999-PUTBUFFER-1.

       8000-CCS.
           PERFORM 8100-CLEAR-SFL THRU 8100-EXIT.
           MOVE 0 TO SFL-PTR.
           MOVE ALL B"0" TO SRF-INDICATORS.
           MOVE 0 TO TOTAL-CCS.
           PERFORM 8200-SETUP-SFL THRU 8200-EXIT
             VARYING SUB FROM 1 BY 1
               UNTIL SUB > TABLE-LIMIT.
            MOVE SPACES TO CCS-MSG.
        8000-CCS-DISPLAY.
           IF SFL-PTR > 0
               PERFORM 8300-DISPLAY-SFL THRU 8300-EXIT
               MOVE "N" TO ENTRY-ERROR
               MOVE B"0" TO IND(99)
               MOVE SPACES TO CCS-MSG
               MOVE SPACES TO LAST-SFL-USER
               MOVE SPACES TO LAST-SFL-BLD
               MOVE SPACES TO LAST-SFL-ROOM
               PERFORM 8401-EDIT-SFL THRU 8401-EXIT
                  VARYING SFL-PTR FROM 1 BY 1
                  UNTIL SFL-PTR > TOTAL-CCS OR
                        ENTRY-ERROR = "Y"
               IF ENTRY-ERROR = "Y"
                   GO TO 8000-CCS-DISPLAY
               END-IF
               PERFORM 8400-PROCESS-SFL THRU 8400-EXIT
                  VARYING SFL-PTR FROM 1 BY 1
                  UNTIL SFL-PTR > TOTAL-CCS.
       8000-EXIT.
           EXIT.

       8100-CLEAR-SFL.
           MOVE B"1" TO IND(71).
           MOVE B"1" TO IND(72).
           MOVE B"0" TO IND(73).
           WRITE SUBFILE DISPLAY-REC FROM CCS-SFL
              FORMAT IS "CCSSFLC"
              INDICATORS ARE SRF-INDICATORS.
           IF DISPLAY-STATUS NOT = "00"
              MOVE "PROBLEM ON INIT SFL WRITE 8100" TO BU-DISPLAY-MSG
              MOVE DISPLAY-STATUS TO FILE-STATUS
              PERFORM 2100-BLOWUP.
           MOVE B"0" TO IND(72).
       8100-EXIT.
           EXIT.

       8200-SETUP-SFL.
           MOVE WLT-CODE(SUB) TO SFL-CODE.
           PERFORM 8201-CCS-CODE-MATCH THRU 8201-EXIT.
           IF CCS-CODE-MATCH
      *----------WRITE N SFL RECORDS FOR THE CODE, WHERE N = TOTAL QTY
               MOVE SPACES TO SFL-USER
                              SFL-CONTAINER
                              SFL-LOCATION
               ADD 1 TO SFL-PTR
               MOVE B"0" TO IND(81)
               WRITE SUBFILE DISPLAY-REC FROM CCS-SFL
                 FORMAT IS "CCSSFL"
                 INDICATORS ARE SRF-INDICATORS
               END-WRITE
               IF DISPLAY-STATUS NOT = "00"
                 MOVE "PROBLEM ON SFL WRITE 8200" TO BU-DISPLAY-MSG
                 MOVE DISPLAY-STATUS TO FILE-STATUS
                 PERFORM 2100-BLOWUP
               END-IF
               COMPUTE TOTAL-QTY = WLT-QTY(SUB 1) + WLT-QTY(SUB 2) +
                                   WLT-QTY(SUB 3) + WLT-QTY(SUB 4) +
                                   WLT-QTY(SUB 5) + WLT-QTY(SUB 6)
               ADD TOTAL-QTY TO TOTAL-CCS
               IF TOTAL-QTY > 1
                 PERFORM VARYING SUB2 FROM 2 BY 1
                  UNTIL SUB2 > TOTAL-QTY
                  ADD 1 TO SFL-PTR
                  MOVE B"1" TO IND(81)
                  WRITE SUBFILE DISPLAY-REC FROM CCS-SFL
                     FORMAT IS "CCSSFL"
                     INDICATORS ARE SRF-INDICATORS
                  END-WRITE
                  IF DISPLAY-STATUS NOT = "00"
                    MOVE "PROBLEM ON SFL WRITE 8200" TO BU-DISPLAY-MSG
                    MOVE DISPLAY-STATUS TO FILE-STATUS
                    PERFORM 2100-BLOWUP
                  END-IF
                 END-PERFORM
               END-IF
           END-IF.
       8200-EXIT.
           EXIT.

       8201-CCS-CODE-MATCH.
           IF SFL-CODE-1-4 = "2890"
               MOVE "Y" TO CCS-CODE-MATCH-SW
           ELSE
DP9158       IF SFL-CODE = SPACES
DP9158         MOVE "N" TO CCS-CODE-MATCH-SW
DP9158       ELSE
               CALL "MCXRTVDTAA" USING CCS-DTAARA-NAME CCS-DTAARA
               SET CCS-IDX TO 1
               SEARCH CCS-CODE-SEARCH
                   AT END
                     MOVE "N" TO CCS-CODE-MATCH-SW
                   WHEN CCS-CODE-ENTRY(CCS-IDX) = SFL-CODE
                     MOVE "Y" TO CCS-CODE-MATCH-SW
               END-SEARCH
DP9158       END-IF
           END-IF.
       8201-EXIT.
           EXIT.

       8300-DISPLAY-SFL.
           WRITE SUBFILE DISPLAY-REC FROM CCS-SCREEN
              FORMAT IS "CCS"
              INDICATORS ARE SRF-INDICATORS.
           MOVE B"1" TO IND(70).
           MOVE B"1" TO IND(71).
           MOVE B"0" TO IND(72).
           MOVE B"1" TO IND(73).
           WRITE SUBFILE DISPLAY-REC FROM CCS-SFL
              FORMAT IS "CCSSFLC"
              INDICATORS ARE SRF-INDICATORS.
           IF DISPLAY-STATUS NOT = "00"
              MOVE "ERROR ON SHOW SFL WRITE" TO BU-DISPLAY-MSG
              MOVE DISPLAY-STATUS TO FILE-STATUS
              PERFORM 2100-BLOWUP.
           MOVE B"1" TO IND(70).
           MOVE B"1" TO IND(71).
           MOVE B"0" TO IND(72).
           MOVE B"1" TO IND(73).
           READ DISPLAY-FILE
              FORMAT IS "CCSSFLC"
              INDICATORS ARE SRF-INDICATORS.
           IF DISPLAY-STATUS NOT = "00"
              MOVE "ERROR ON SHOW SFL READ" TO BU-DISPLAY-MSG
              MOVE DISPLAY-STATUS TO FILE-STATUS
              PERFORM 2100-BLOWUP.
           IF VIEW-LASTKEY NOT = 0
               GO TO 8300-DISPLAY-SFL.
       8300-EXIT.
           EXIT.

       8400-PROCESS-SFL.
           READ SUBFILE DISPLAY-FILE
              INTO CCS-SFL
              FORMAT IS "CCSSFL"
              INDICATORS ARE SRF-INDICATORS.
           IF DISPLAY-STATUS = "12" OR "23"
               NEXT SENTENCE
           ELSE
               IF DISPLAY-STATUS NOT = "00"
                  MOVE "ERROR ON PROC SFL READ" TO BU-DISPLAY-MSG
                  MOVE DISPLAY-STATUS TO FILE-STATUS
                  PERFORM 2100-BLOWUP
               ELSE
                  MOVE WL-KEY TO CCS-WS
                  MOVE SFL-CODE TO CCS-CODE
                  MOVE SFL-USER TO CCS-USER
                  MOVE SFL-CONTAINER TO CCS-CONTAINER
                  MOVE SFL-LOCATION TO CCS-LOCATION
                  WRITE DCCSDATA-REC FROM BUF-DCCSDATA
                    INVALID KEY MOVE FILE-STATUS TO FILE-STATUS
                  END-WRITE
                  IF FILE-STATUS NOT = "00"
                    MOVE "ERROR ON DCCSDATA WRITE" TO BU-DISPLAY-MSG
                    MOVE DISPLAY-STATUS TO FILE-STATUS
                    PERFORM 2100-BLOWUP
                  END-IF.
       8400-EXIT.
           EXIT.

       8401-EDIT-SFL.
           READ SUBFILE DISPLAY-FILE
              INTO CCS-SFL
              FORMAT IS "CCSSFL"
              INDICATORS ARE SRF-INDICATORS.
           IF DISPLAY-STATUS = "12" OR "23"
               NEXT SENTENCE
           ELSE
               IF DISPLAY-STATUS NOT = "00"
                  MOVE "ERROR ON PROC SFL READ" TO BU-DISPLAY-MSG
                  MOVE DISPLAY-STATUS TO FILE-STATUS
                  PERFORM 2100-BLOWUP
               ELSE
                  MOVE "N" TO USE-DEFAULT
      *-------------DEFAULT BLANK USER TO LAST USER ENTERED
                  IF SFL-USER = SPACES AND LAST-SFL-USER NOT = SPACES
                     MOVE "Y" TO USE-DEFAULT
                     MOVE LAST-SFL-USER TO SFL-USER
                  ELSE
                     MOVE SFL-USER TO LAST-SFL-USER
                  END-IF
      *-------------DEFAULT BLANK BUILDING TO LAST BUILDING ENTERED
                  IF SFL-BLD = SPACES AND LAST-SFL-BLD NOT = SPACES
                     MOVE "Y" TO USE-DEFAULT
                     MOVE LAST-SFL-BLD TO SFL-BLD
                  ELSE
                     MOVE SFL-BLD TO LAST-SFL-BLD
                  END-IF
      *-------------DEFAULT BLANK ROOM TO LAST ROOM ENTERED
                  IF SFL-ROOM = SPACES AND LAST-SFL-BLD NOT = SPACES
                     MOVE "Y" TO USE-DEFAULT
                     MOVE LAST-SFL-ROOM TO SFL-ROOM
                  ELSE
                     MOVE SFL-ROOM TO LAST-SFL-ROOM
                  END-IF
                  IF USE-DEFAULT = "Y"
                      REWRITE SUBFILE DISPLAY-REC FROM CCS-SFL
                         FORMAT IS "CCSSFL"
                         INDICATORS ARE SRF-INDICATORS
                      END-REWRITE
                  END-IF
                  IF SFL-USER = SPACES OR
                     SFL-CONTAINER = SPACES OR
                     SFL-BLD = SPACES OR
                     SFL-ROOM = SPACES
               MOVE "USER, CONTAINER, BUILDING, AND ROOM ARE REQUIRED"
                           TO CCS-MSG
                       MOVE B"1" TO IND(99)
                       MOVE "Y" TO ENTRY-ERROR.
       8401-EXIT.
           EXIT.

       9999-OPEN-STUFF.
           OPEN INPUT MSTORERM-CD-I.
           OPEN I-O   DWLITEM-WK-O.
           OPEN I-O   MWRKLIST-WK-O.
           OPEN I-O   DISPLAY-FILE.
           OPEN INPUT MPLTINFO.
           OPEN I-O DCCSDATA.

       9999-CLOSE-STUFF.
           CLOSE MSTORERM-CD-I,
                 MPLTINFO,
                 DWLITEM-WK-O,
                 MWRKLIST-WK-O,
                 DCCSDATA
                 DISPLAY-FILE.

       COPY HCATREAD IN COPYLIB.
       COPY SCRNCALL IN COPYLIB.
       COPY SCRNCL1B IN COPYLIB.
       COPY MLOCKCAL IN COPYLIB.
       COPY DLOCKCAL IN COPYLIB.
       COPY UNLOCK   IN COPYLIB.
       9999-GETKEY-MSTORERM-CD-I.
           MOVE 0 TO COND-WORD.
           MOVE CODE-ARG TO CORPCDE OF MSTORERM-CD-REC-I.
           READ MSTORERM-CD-I INTO BUF-MSTORERM
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS = "23"
               MOVE 17 TO COND-WORD
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD
               IF HANDLE-BLOWUP-FLAG = "Y"
                   MOVE "GETKEY ERR 9999-GETKEY-MSTORERM-CD-I"
                       TO BU-MSG-AREA
                   PERFORM 2100-BLOWUP.

       9999-GETKEY-MWRKLIST-WK-O.
           MOVE 0 TO COND-WORD.
           MOVE WL-ARG TO WLKEY OF MWRKLIST-WK-REC-O.
           READ MWRKLIST-WK-O INTO BUF-MWRKLIST
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS = "23"
               MOVE 17 TO COND-WORD
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD
               IF HANDLE-BLOWUP-FLAG = "Y"
                   MOVE "GETKEY ERR 9999-GETKEY-MWRKLIST-WK-O"
                       TO BU-MSG-AREA
                   PERFORM 2100-BLOWUP.

       9999-RESET-MWRKLIST-WK-O.
           MOVE HIGH-VALUES TO WLKEY OF MWRKLIST-WK-REC-O.
           START MWRKLIST-WK-O KEY > WLKEY OF MWRKLIST-WK-REC-O
               INVALID KEY MOVE "00" TO FILE-STATUS.

       9999-UPDATE-MWRKLIST-WK-O.
           MOVE 0 TO COND-WORD.
           REWRITE MWRKLIST-WK-REC-O FROM BUF-MWRKLIST
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD
               IF HANDLE-BLOWUP-FLAG = "Y"
                   MOVE "UPDATE ERR 9999-UPDATE-MWRKLIST-WK-O"
                       TO BU-MSG-AREA
                   PERFORM 2100-BLOWUP.

       9999-PUT-MWRKLIST-WK-O.
           MOVE 0 TO COND-WORD.
           WRITE MWRKLIST-WK-REC-O FROM BUF-MWRKLIST
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD
               IF HANDLE-BLOWUP-FLAG = "Y"
                   MOVE "PUT ERR 9999-PUT-MWRKLIST-WK-O"
                       TO BU-MSG-AREA
                   PERFORM 2100-BLOWUP.

       9999-PUT-DWLITEM-WK-O.
           MOVE 0 TO COND-WORD.
           WRITE DWLITEM-WK-REC-O FROM BUF-DWLITEM
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD
               IF HANDLE-BLOWUP-FLAG = "Y"
                   MOVE "PUT ERR 9999-PUT-DWLITEM-WK-O"
                       TO BU-MSG-AREA
                   PERFORM 2100-BLOWUP.

