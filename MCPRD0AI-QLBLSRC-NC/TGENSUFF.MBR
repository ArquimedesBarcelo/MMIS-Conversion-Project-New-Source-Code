       IDENTIFICATION DIVISION.
       PROGRAM-ID.    TGENSUFF.
       AUTHOR.        R L ENSMINGER.
       INSTALLATION.  GTR.
       DATE-COMPILED.
      *C
      *C 09/10/96  JEFF BUNGO
      *C   EXPAND DATE FIELDS FOR YEAR 2000 COMPLIANCE.
      *C   INCLUDE CENTURY ON DATE SCHEDULED, REQUIRED,
      *C   AND RECEIVED AND PASS AS PARAMETERS.
      *C
       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.
       SOURCE-COMPUTER. IBM-AS400.
       OBJECT-COMPUTER. IBM-AS400.
       SPECIAL-NAMES. I-O-FEEDBACK IS I-O-FEEDBACK-AREA
                      LOCAL-DATA IS LOCAL-DATA-AREA.
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT DISPLAY-FILE
               ASSIGN TO WORKSTATION-ZSUFFIX-SI
               ORGANIZATION IS TRANSACTION
               ACCESS IS SEQUENTIAL
               FILE STATUS IS DSPLY-STATUS
               CONTROL-AREA IS WS-CONTROL.
           SELECT FILE1
               ASSIGN TO DATABASE-MCFLMM0201
               ORGANIZATION IS INDEXED
               ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
               FILE STATUS IS FILE-STATUS.
           SELECT FILE2
               ASSIGN TO DATABASE-MCFLMM0301
               ORGANIZATION IS INDEXED
               ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
               FILE STATUS IS FILE-STATUS.
           SELECT FILE3
               ASSIGN TO DATABASE-MCFLMM0501
               ORGANIZATION IS INDEXED
               ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
               FILE STATUS IS FILE-STATUS.
           SELECT FILE5
               ASSIGN TO DATABASE-MCFLCS1701
               ORGANIZATION IS INDEXED
               ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
               FILE STATUS IS FILE-STATUS.
           SELECT FILE7
               ASSIGN TO DATABASE-MCFPMM0800
               ORGANIZATION IS RELATIVE
               ACCESS MODE IS RANDOM
               RELATIVE KEY IS PFKEY
               FILE STATUS IS FILE-STATUS.
           SELECT FILE8
               ASSIGN TO DATABASE-MCFLMM3501
               ORGANIZATION IS INDEXED
               ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
               FILE STATUS IS FILE-STATUS.
           SELECT FILE9
               ASSIGN TO DATABASE-MCFLMM3701
               ORGANIZATION IS INDEXED
               ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
               FILE STATUS IS FILE-STATUS.
           SELECT FILE10
               ASSIGN TO DATABASE-MCFLMM1101
               ORGANIZATION IS INDEXED
               ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                   WITH DUPLICATES
               FILE STATUS IS FILE-STATUS.
       DATA DIVISION.
       FILE SECTION.
       FD  DISPLAY-FILE
           LABEL RECORDS ARE OMITTED.
       01  DSPLY-REC               PIC X(2000).
       FD  FILE1
           LABEL RECORDS ARE STANDARD.
       01  REC1.
           COPY DDS-ALL-FORMATS OF MCFLMM0201.
       FD  FILE2
           LABEL RECORDS ARE STANDARD.
       01  REC2.
           COPY DDS-ALL-FORMATS OF MCFLMM0301.
       FD  FILE3
           LABEL RECORDS ARE STANDARD.
       01  REC3.
           COPY DDS-ALL-FORMATS OF MCFLMM0501.
       FD  FILE5
           LABEL RECORDS ARE STANDARD.
       01  REC5.
           COPY DDS-ALL-FORMATS OF MCFLCS1701.
       FD  FILE7
           LABEL RECORDS ARE STANDARD.
       01  REC7.
           COPY DDS-ALL-FORMATS OF MCFPMM0800.
       FD  FILE8
           LABEL RECORDS ARE STANDARD.
       01  REC8.
           COPY DDS-ALL-FORMATS OF MCFLMM3501.
       FD  FILE9
           LABEL RECORDS ARE STANDARD.
       01  REC9.
           COPY DDS-ALL-FORMATS OF MCFLMM3701.
       FD  FILE10
           LABEL RECORDS ARE STANDARD.
       01  REC10.
           COPY DDS-ALL-FORMATS OF MCFLMM1101.
       WORKING-STORAGE SECTION.
       01  APPROVAL-SW             PIC X.
       01  BUD-NUM                 PIC X(16).
       COPY CATREAD      OF COPYLIB.
       01  CDATE.
           05 YY.
              10 FILLER            PIC X.
              10 DATE-YEAR         PIC 9.
           05 MM                   PIC 99.
           05 DD                   PIC 99.
       COPY CPYIND       OF COPYLIB.
       01  CURLIB                  PIC X(10).
       01  COND-CODE               PIC X.
       01  CTIME.
           05 HH                   PIC 99.
           05 MN                   PIC 99.
           05 FILLER               PIC X(4).
       01  DBPARAMETERS.
           COPY DBPARMS  OF COPYLIB.
       01  DATE-SCHD-SAVE          PIC X(6).
       01  DATE-REQD-SAVE          PIC X(6).
       COPY TDATESUB  OF COPYLIB.
       01  DSPLY-STATUS            PIC XX.
       01  ERROR-SW                PIC X.
       01  ERROR-SWITCH            PIC S9(4) COMP-4.
       01  EQP-BUFFER.
           COPY MEQPFILE OF COPYLIB.
       01  EXPCLASS-1.
           05 EX1                  PIC X.
           05 EX2                  PIC X.
           05 FILLER               PIC X(8).
       01  EXPCLASS-2              PIC X(8).
       01  EQP                     PIC X(6).
       01  ESTIMATES.
           05 LABOR-ESTIMATE       PIC 9(16).
           05 STORE-ESTIMATE       PIC 9(16).
           05 PURCH-ESTIMATE       PIC 9(16).
       01  FIELDNUM                PIC S9(4) COMP-4.
       01  FILE-STATUS             PIC XX.
       COPY IOFEEDBACK OF COPYLIB.
       01  JOBLIBX                 PIC X.
       COPY LANGSUB    OF COPYLIB.
       01  MASTER-JOBPLAN.
           COPY MMASTJOB OF COPYLIB.
       01  MASTER-PRTPLAN.
           COPY MMSTPART OF COPYLIB.
       01  NAME-FIELD              PIC S9(4) COMP-4.
       01  PFKEY                   PIC 9(9).
       01  PLANT-DATA.
           COPY MLASTWO  OF COPYLIB.
       01  P-WONUM                 PIC X(10).
       01  PERSONNEL-DATA.
           COPY MPERSONL OF COPYLIB.
       01  RIME-CALC               PIC 99.
       01  REREAD-SW               PIC X.
       01  RET-CODE                PIC XX.
       01  R-BYTE                  PIC X.
       01  SAVE-MESSAGE            PIC X(79).
       COPY DBSTAT       OF COPYLIB.
       01  SAVE-SUFFIX.
           05 SAVE-SUFFIX-NUM      PIC 9(3).
           05 FILLER               PIC X.
       01  SAVE-CC                 PIC X(4).
       01  SCREEN-BUFFER.
           05 SCREEN-DATA.
               10 MASTER           PIC X(10).
               10 SUFF             PIC X(3).
               10 REQUESTER-S      PIC X(16).
               10 PRIORITY         PIC X.
               10 EQPNUM           PIC X(6).
               10 DWN              PIC X.
               10 EXPCLASS-S       PIC X(8).
               10 SCHD-DATE        PIC X(6).
               10 SCHD-TIME.
                  15 HR-SCHD       PIC XX.
                  15 MN-SCHD       PIC XX.
               10 REQD-DATE        PIC X(6).
               10 REQD-TIME.
                  15 HR-REQD       PIC XX.
                  15 MN-REQD       PIC XX.
               10 BUDGET-NUMBER.
                  15 B1            PIC X(3).
                  15 B2            PIC X(2).
                  15 B3            PIC X(2).
                  15 B4            PIC X(3).
                  15 B5            PIC X(2).
               10 REQUEST-NUMBER   PIC X(12).
               10 PLNR             PIC X(4).
               10 ENGR             PIC X(4).
               10 SCHD             PIC X(4).
               10 DESC1-S          PIC X(30).
               10 DESC2-S          PIC X(66).
               10 DESC3-S          PIC X(66).
               10 COPY-JOB-BYTE    PIC X.
               10 COPY-MAT-BYTE    PIC X.
           05 SCREEN-CMD-LINE      PIC X(79).
           05 SCREEN-ERR-LINE      PIC X(79).
       01  SCREEN-BUFFER1.
           05  SCREEN-DATA1.
               10 WORKNUMBER       PIC X(10).
               10 SEQ-INT          PIC X(2).
               10 MASTER-NAMES.
                  15 MASTER-NAME OCCURS 15 TIMES
                                   PIC X(10).
           05 SCREEN-CMD-LINE1     PIC X(79).
           05 SCREEN-ERR-LINE1     PIC X(79).
       01  SCREEN-BUFFER2.
           05  SCREEN-DATA2.
               10 WORKNUMBER2      PIC X(10).
               10 MASTER-NAMES2.
                  15 MASTER-NAME2 OCCURS 15 TIMES
                                   PIC X(10).
           05 SCREEN-CMD-LINE2     PIC X(79).
           05 SCREEN-ERR-LINE2     PIC X(79).
       01  STORES-BUFFER           PIC X(20).
       01  SAVE-KEY                PIC S9(4) COMP-4.
       01  S1                      PIC S9(4) COMP-4.
       01  S3                      PIC S9(4) COMP-4.
       01  TIME-SW                 PIC X.
       01  TIME-BUFF.
           05 TIME-HHMM            PIC X(4).
           05 TIME-SECS            PIC XX.
       01  TERMID                  PIC X(10).
       01  TRUE-VAL                PIC 1 VALUE B"1".
       01  USERNAME                PIC X(10).
       COPY VCOMLINK     OF COPYLIB.
       01  WO-TRACK-DATA.
           COPY DWOTRACK OF COPYLIB.
       01  WO-PLANNED-DATA.
           COPY DWOPLAN  OF COPYLIB.
       COPY WSCONTROL OF COPYLIB.
       LINKAGE SECTION.
       01  WO-NUMBER-DATA          PIC X(10).
       01  SUFFIX-NUMBER           PIC X(3).
       PROCEDURE DIVISION USING    WO-NUMBER-DATA
                                   SUFFIX-NUMBER.
       START-PROGRAM.
           OPEN I-O   DISPLAY-FILE.
           OPEN INPUT FILE1 FILE2 FILE3 FILE5 FILE7 FILE8 FILE9.
           OPEN I-O   FILE10.
           MOVE 1 TO PFKEY.
           READ FILE7 INTO PLANT-DATA.
           MOVE DATE-FLAG-SW TO DATE-FLAG.
           CALL "CLWHO" USING USERNAME TERMID CURLIB JOBLIBX.
           MOVE SPACES TO WO-TRACK-DATA.
           MOVE "TGENSUFF" TO PROGRAM-NAME.
           MOVE "OO" TO WO-STATUS-TRACK.
           MOVE USERNAME TO USER-NAME.
           MOVE TERMID TO USER-TERM.
           MOVE SPACES TO SAVE-MESSAGE.
           MOVE 0 TO VIEW-LASTKEY.
           MOVE SPACES TO SCREEN-BUFFER SCREEN-BUFFER1 SCREEN-BUFFER2.
           PERFORM 6-MAIN UNTIL VIEW-LASTKEY = 3.
       2-EOJ.
           CLOSE DISPLAY-FILE.
           CLOSE FILE1 FILE2 FILE3 FILE5 FILE7 FILE8 FILE9.
           CLOSE FILE10.
           GOBACK.

       6-MAIN.
           PERFORM 61-SHOW-SCREEN.
           PERFORM 62-READ-SCREEN.
           PERFORM 63-ADD-SUFFIX.
           MOVE SPACES TO SCREEN-BUFFER SCREEN-BUFFER1 SCREEN-BUFFER2.

       61-SHOW-SCREEN.
           MOVE SPACES TO SCREEN-DATA.
           MOVE SAVE-MESSAGE TO SCREEN-ERR-LINE.
           MOVE WO-NUMBER-DATA TO MASTER.
           MOVE SUFFIX-NUMBER  TO SUFF.
           MOVE "Y" TO COPY-JOB-BYTE COPY-MAT-BYTE.

       62-READ-SCREEN.
           MOVE "FGENSUF1" TO VIEW-CFNAME.
           MOVE 66353 TO CATREAD-MSG-NUMBER.
           CALL "CCATREAD" USING CATREAD-PARMS.
           MOVE CATREAD-MSG-TEXT TO SCREEN-CMD-LINE.
           MOVE SCREEN-BUFFER TO DSPLY-REC.
           PERFORM 99-SCREEN-WRITE.
           PERFORM 98-SCREEN-READ.
           MOVE DSPLY-REC TO SCREEN-BUFFER.
           IF VIEW-LASTKEY = 3 GO TO 2-EOJ.
           IF REQUESTER-S = SPACES
             MOVE 66115 TO CATREAD-MSG-NUMBER
             CALL "CCATREAD" USING CATREAD-PARMS
             MOVE CATREAD-MSG-TEXT TO SCREEN-ERR-LINE
             MOVE TRUE-VAL TO INDS (01) INDS (99)
             GO TO 62-READ-SCREEN.

           IF PRIORITY = "1" OR "2" OR "3" OR "4" OR "5"
             NEXT SENTENCE
           ELSE
             MOVE 35080 TO CATREAD-MSG-NUMBER
             CALL "CCATREAD" USING CATREAD-PARMS
             MOVE CATREAD-MSG-TEXT TO SCREEN-ERR-LINE
             MOVE TRUE-VAL TO INDS (02) INDS (99)
             GO TO 62-READ-SCREEN.

           IF EQPNUM OF SCREEN-BUFFER = SPACES
             MOVE 00030 TO CATREAD-MSG-NUMBER
             CALL "CCATREAD" USING CATREAD-PARMS
             MOVE CATREAD-MSG-TEXT TO SCREEN-ERR-LINE
             MOVE TRUE-VAL TO INDS (03) INDS (99)
             GO TO 62-READ-SCREEN.

           MOVE SPACES TO EQP-BUFFER.
           MOVE EQPNUM OF SCREEN-BUFFER TO EQPNUM OF REC1.
           READ FILE1 INTO EQP-BUFFER.
           IF FILE-STATUS NOT = "00"
             MOVE 00030 TO CATREAD-MSG-NUMBER
             CALL "CCATREAD" USING CATREAD-PARMS
             MOVE CATREAD-MSG-TEXT TO SCREEN-ERR-LINE
             MOVE TRUE-VAL TO INDS (03) INDS (99)
             GO TO 62-READ-SCREEN
           ELSE
             MOVE SPACES TO ZONEPRTY OF REC3
             STRING EQP-MAINT-ZONE PRIORITY
              DELIMITED BY SIZE INTO ZONEPRTY OF REC3
             READ FILE3
             IF FILE-STATUS NOT = "00"
               MOVE 00016 TO CATREAD-MSG-NUMBER
               CALL "CCATREAD" USING CATREAD-PARMS
               MOVE CATREAD-MSG-TEXT TO SCREEN-ERR-LINE
               MOVE TRUE-VAL TO INDS (02) INDS (99)
               GO TO 62-READ-SCREEN.

           IF DWN = "Y" OR "N" OR "?"
             NEXT SENTENCE
           ELSE
             MOVE 35079 TO CATREAD-MSG-NUMBER
             CALL "CCATREAD" USING CATREAD-PARMS
             MOVE CATREAD-MSG-TEXT TO SCREEN-ERR-LINE
             MOVE TRUE-VAL TO INDS (21) INDS (99)
             GO TO 62-READ-SCREEN.

           IF EXPCLASS-S = SPACES
             MOVE EQP-EXP-CLASS TO EXPCLASS-S.
           MOVE EXPCLASS-S TO EXPCLASS-1 EXPCLASS-2.
           MOVE "E" TO EX1.
           MOVE "C" TO EX2.
           MOVE EXPCLASS-1 TO VALDTAKEY.
           READ FILE5.
           IF FILE-STATUS NOT = "00"
             MOVE "N" TO EX1
             MOVE "W" TO EX2
             MOVE EXPCLASS-1 TO VALDTAKEY
             READ FILE5
             IF FILE-STATUS NOT = "00"
               MOVE 00032 TO CATREAD-MSG-NUMBER
               CALL "CCATREAD" USING CATREAD-PARMS
               MOVE CATREAD-MSG-TEXT TO SCREEN-ERR-LINE
               MOVE TRUE-VAL TO INDS (04) INDS (99)
               GO TO 62-READ-SCREEN.

           MOVE "N" TO TIME-SW.

           IF SCHD-DATE = SPACES
             MOVE "Y" TO TIME-SW
             MOVE SPACES TO SCHD-TIME DATE-SCHD-SAVE
           ELSE
             MOVE DATE-FLAG TO DATE-CODE
             MOVE 3         TO DATE-MODE
             MOVE SCHD-DATE TO DATE-VALIDATE-IN
             CALL "TDATECK2" USING DATE-CHECK-AREA LANGUAGE-PARMS
             IF DATE-RET-CODE = 1
               MOVE DATE-MSG TO SCREEN-ERR-LINE
               MOVE TRUE-VAL TO INDS (05) INDS (99)
               GO TO 62-READ-SCREEN
             ELSE
              MOVE DATE-DB TO DATE-SCHD-SAVE
              IF (HR-SCHD > "00" OR HR-SCHD = "00" ) AND HR-SCHD < "24"
              IF (MN-SCHD > "00" OR MN-SCHD = "00" ) AND MN-SCHD < "60"
                MOVE "Y" TO TIME-SW.

           IF TIME-SW = "N"
             MOVE 35029 TO CATREAD-MSG-NUMBER
             CALL "CCATREAD" USING CATREAD-PARMS
             MOVE CATREAD-MSG-TEXT TO SCREEN-ERR-LINE
             MOVE TRUE-VAL TO INDS (06) INDS (99)
             GO TO 62-READ-SCREEN.

           MOVE "N" TO TIME-SW.

           IF REQD-DATE = SPACES
             MOVE "Y" TO TIME-SW
             MOVE SPACES TO REQD-TIME DATE-REQD-SAVE
           ELSE
             MOVE DATE-FLAG TO DATE-CODE
             MOVE 3         TO DATE-MODE
             MOVE REQD-DATE TO DATE-VALIDATE-IN
             CALL "TDATECK2" USING DATE-CHECK-AREA LANGUAGE-PARMS
             IF DATE-RET-CODE = 1
               MOVE DATE-MSG TO SCREEN-ERR-LINE
               MOVE TRUE-VAL TO INDS (07) INDS (99)
               GO TO 62-READ-SCREEN
             ELSE
              MOVE DATE-DB TO DATE-REQD-SAVE
              IF (HR-REQD > "00" OR HR-REQD = "00" ) AND HR-REQD < "24"
              IF (MN-REQD > "00" OR MN-REQD = "00" ) AND MN-REQD < "60"
                MOVE "Y" TO TIME-SW.

           IF TIME-SW = "N"
             MOVE 35029 TO CATREAD-MSG-NUMBER
             CALL "CCATREAD" USING CATREAD-PARMS
             MOVE CATREAD-MSG-TEXT TO SCREEN-ERR-LINE
             MOVE TRUE-VAL TO INDS (08) INDS (99)
             GO TO 62-READ-SCREEN.

           STRING B1 "-" B2 "-" B3 "-" B4 "R" B5
            DELIMITED BY SIZE INTO BUD-NUM.

           IF PLNR = SPACES AND ENGR = SPACES
             MOVE 31013 TO CATREAD-MSG-NUMBER
             CALL "CCATREAD" USING CATREAD-PARMS
             MOVE CATREAD-MSG-TEXT TO SCREEN-ERR-LINE
             MOVE TRUE-VAL TO INDS (15) INDS (99)
             GO TO 62-READ-SCREEN.

           IF PLNR NOT = SPACES
             IF ENGR NOT = SPACES
               MOVE 31013 TO CATREAD-MSG-NUMBER
               CALL "CCATREAD" USING CATREAD-PARMS
               MOVE CATREAD-MSG-TEXT TO SCREEN-ERR-LINE
               MOVE TRUE-VAL TO INDS (15) INDS (99)
               GO TO 62-READ-SCREEN.

           IF PLNR NOT = SPACES
             MOVE PLNR TO SAVE-CC
             MOVE 15 TO FIELDNUM
           ELSE
             MOVE ENGR TO SAVE-CC
             MOVE 16 TO FIELDNUM.

           MOVE SAVE-CC TO PERCCNUM.
           READ FILE2.
           IF FILE-STATUS NOT = "00"
             MOVE 35047 TO CATREAD-MSG-NUMBER
             CALL "CCATREAD" USING CATREAD-PARMS
             MOVE CATREAD-MSG-TEXT TO SCREEN-ERR-LINE
             MOVE TRUE-VAL TO INDS (FIELDNUM) INDS (99)
             GO TO 62-READ-SCREEN.

           IF DESC1-S OF SCREEN-BUFFER = SPACES
             MOVE 66115 TO CATREAD-MSG-NUMBER
             CALL "CCATREAD" USING CATREAD-PARMS
             MOVE CATREAD-MSG-TEXT TO SCREEN-ERR-LINE
             MOVE TRUE-VAL TO INDS (18) INDS (99)
             GO TO 62-READ-SCREEN.

       63-ADD-SUFFIX.
           MOVE WO-NUMBER-DATA TO WONUM OF REC10.
           READ FILE10 INTO WO-PLANNED-DATA.
           IF FILE-STATUS NOT = "00"
             DISPLAY "ERROR: FILE STATUS = "
                     FILE-STATUS
                     " ON READ OF MASTER WORK ORDER"
             GO TO 2-EOJ.

           IF WO-STATUS-P NOT = "OO"
             DISPLAY "ERROR: MASTER STATUS IS NOT 'OO'"
             GO TO 2-EOJ.

           MOVE LAST-SUFFIX-INIT TO SAVE-SUFFIX.
           IF SAVE-SUFFIX-NUM NUMERIC
             IF SAVE-SUFFIX-NUM > 998
               DISPLAY "ERROR: MASTER WORK ORDER HAS 999 SUFFIXES"
               GO TO 2-EOJ.

           IF SAVE-SUFFIX-NUM NUMERIC
             ADD  1 TO SAVE-SUFFIX-NUM
           ELSE
             MOVE 1 TO SAVE-SUFFIX-NUM.

           MOVE SAVE-SUFFIX TO LAST-SUFFIX-INIT.
           MOVE SAVE-SUFFIX-NUM TO SUFFIX-NUMBER.

           REWRITE REC10 FROM WO-PLANNED-DATA.
           IF FILE-STATUS NOT = "00"
             DISPLAY "ERROR: FILE STATUS = "
                     FILE-STATUS
                     " ON MODIFY OF FILE10"
             GO TO 2-EOJ.

           MOVE "U" TO APPROVAL-SW.
           IF APPROVAL-CODE-P = "A "
             MOVE "A" TO APPROVAL-SW.

           MOVE SPACES         TO    WO-PLANNED-DATA.

           MOVE WO-NUMBER-DATA TO    WO-NUM-PLANNED.
           MOVE SAVE-SUFFIX    TO    WO-NUM-SUFF-P.
           MOVE "OO"           TO    WO-STATUS-P.

           IF APPROVAL-SW = "A"
             MOVE "**" TO WO-REOPEN-DELAY.

           ACCEPT CDATE FROM DATE.
           ACCEPT CTIME FROM TIME.

           MOVE CDATE          TO    DATE-RECD-P.
           IF DATE-RECD-P-YY > 70
               MOVE 19 TO DATE-RECD-P-CC
           ELSE
               MOVE 20 TO DATE-RECD-P-CC.
           MOVE CTIME          TO    TIME-RECD-P.
           MOVE "U"            TO    APPROVAL-CODE-P.
           MOVE REQUESTER-S    TO    REQUESTER-P.
           MOVE EQP-EQUIP-NUM  TO    EQUIP-NUM-P.
           MOVE EQP-EQUIP-NAME TO    EQUIP-NAME-P.
           MOVE EQP-TYPE       TO    TYPE-NUM-P.
           MOVE EQP-DEPT       TO    DEPT-P.
           MOVE EQP-MAINT-ZONE TO    ZONE-P.
           MOVE PRIORITY       TO    PRIORITY-P.
           MOVE EQP-LOCATION   TO    LOCATION-P.
           MOVE DWN            TO    EQUIP-DOWN-P.
           MOVE EXPCLASS-S     TO    EXP-CLASS-P.

           IF RIME-NO NUMERIC
             MOVE RIME-NO TO RIME-CALC
           ELSE
             MOVE 1       TO RIME-CALC.

           IF PRIORITY = 1 COMPUTE RIME-CALC = RIME-CALC * 9.
           IF PRIORITY = 2 COMPUTE RIME-CALC = RIME-CALC * 6.
           IF PRIORITY = 3 COMPUTE RIME-CALC = RIME-CALC * 4.
           IF PRIORITY = 4 COMPUTE RIME-CALC = RIME-CALC * 2.
           IF PRIORITY = 5 COMPUTE RIME-CALC = RIME-CALC * 1.

           MOVE RIME-CALC      TO    RIME-P.

           MOVE DATE-REQD-SAVE TO    DATE-REQD.
           IF DATE-REQD = SPACES
               NEXT SENTENCE
           ELSE
           IF DATE-REQD-P-YY > 70
               MOVE 19 TO DATE-REQD-P-CC
           ELSE
               MOVE 20 TO DATE-REQD-P-CC.
           MOVE REQD-TIME      TO    TIME-REQD.
           MOVE DESC1-S        TO    DESCRIPTION-1-P.
           MOVE DESC2-S        TO    DESCRIPTION-2-1-P.
           MOVE DESC3-S        TO    DESCRIPTION-2-2-P.
           MOVE PLNR           TO    PLANNER-P.
           MOVE ENGR           TO    ENGINEER-P.
           MOVE SCHD           TO    SCHEDULER-P.

           IF PLNR NOT = SPACES
             MOVE "R"  TO PLNR-RESP-IND
             MOVE "PP" TO WO-START-STATUS
                          WO-TYPE-STATUS
           ELSE
             MOVE "R"  TO ENGR-RESP-IND
             MOVE "EE" TO WO-START-STATUS
                          WO-TYPE-STATUS.

           MOVE DATE-SCHD-SAVE TO DATE-SCHD.
           IF DATE-SCHD = SPACES
               NEXT SENTENCE
           ELSE
           IF DATE-SCHD-P-YY > 70
               MOVE 19 TO DATE-SCHD-P-CC
           ELSE
               MOVE 20 TO DATE-SCHD-P-CC.
           MOVE SCHD-TIME      TO TIME-SCHD.
           MOVE BUD-NUM        TO BUDGET-NO.
           MOVE REQUEST-NUMBER TO REQUEST-NO.

           CALL "TADDWOII" USING DBPARAMETERS
                                 STATUS-AREA
                                 WO-PLANNED-DATA
                                 COND-CODE
                                 ERROR-SWITCH.

           MOVE WO-NUM-PLANNED TO WO-NUM-TRACK.
           MOVE CDATE TO DATE-STAMP.
           IF DATE-STAMP-YY > "70"
               MOVE "19" TO DATE-STAMP-CC
           ELSE
           MOVE "20"     TO DATE-STAMP-CC.
           MOVE CTIME TO TIME-STAMP.
           CALL "TWOTRACK" USING WO-TRACK-DATA.

           MOVE 45030 TO CATREAD-MSG-NUMBER.
           CALL "CCATREAD" USING CATREAD-PARMS.
           MOVE SPACES TO SAVE-MESSAGE.
           STRING WO-NUM-PLANNED SPACE CATREAD-MSG-TEXT
            DELIMITED BY SIZE INTO SAVE-MESSAGE.
           IF VIEW-CFNAME = "FGENSUF1"
               MOVE SAVE-MESSAGE TO SCREEN-CMD-LINE SCREEN-CMD-LINE1
                   SCREEN-CMD-LINE2
               MOVE SCREEN-BUFFER TO DSPLY-REC
           ELSE
           IF VIEW-CFNAME = "FGENSUF2"
               MOVE SAVE-MESSAGE TO SCREEN-CMD-LINE1
               MOVE SCREEN-BUFFER1 TO DSPLY-REC
           ELSE
           MOVE SAVE-MESSAGE TO SCREEN-CMD-LINE2
           MOVE SCREEN-BUFFER2 TO DSPLY-REC.
           MOVE TRUE-VAL TO INDS (98).
           PERFORM 99-SCREEN-WRITE.
           PERFORM 98A-SCREEN-READ.
           CALL "CLPAUSE2".

           IF COPY-JOB-BYTE NOT = SPACE
             MOVE SPACES TO SCREEN-DATA1
             MOVE WO-NUM-PLANNED TO WORKNUMBER
             MOVE "01" TO SEQ-INT
             PERFORM COPY-JOBPLANS THRU C-J-E.

           IF COPY-MAT-BYTE NOT = SPACE
             MOVE SPACES TO SCREEN-DATA2
             MOVE WO-NUM-PLANNED TO WORKNUMBER2
             PERFORM COPY-MATPLANS THRU C-M-E.

       COPY-JOBPLANS.
           MOVE "FGENSUF2" TO VIEW-CFNAME.
           MOVE SCREEN-BUFFER1 TO DSPLY-REC.
           PERFORM 99-SCREEN-WRITE.
           PERFORM 98-SCREEN-READ.
           MOVE DSPLY-REC TO SCREEN-BUFFER1.
           IF VIEW-LASTKEY = 3 GO TO C-J-E.
           IF SEQ-INT NUMERIC
             IF SEQ-INT > "00"
               NEXT SENTENCE
             ELSE
               MOVE 66118 TO CATREAD-MSG-NUMBER
               CALL "CCATREAD" USING CATREAD-PARMS
               MOVE CATREAD-MSG-TEXT TO SCREEN-ERR-LINE1
               MOVE TRUE-VAL TO INDS (02) INDS (99)
               GO TO COPY-JOBPLANS
           ELSE
             MOVE 66118 TO CATREAD-MSG-NUMBER
             CALL "CCATREAD" USING CATREAD-PARMS
             MOVE CATREAD-MSG-TEXT TO SCREEN-ERR-LINE1
             MOVE TRUE-VAL TO INDS (02) INDS (99)
             GO TO COPY-JOBPLANS.

           MOVE "N" TO ERROR-SW.
           MOVE 3 TO NAME-FIELD.

           PERFORM CHECK-NAMES THRU NAME-EXIT VARYING S3 FROM 1 BY 1
            UNTIL S3 > 15 OR
                  MASTER-NAME (S3) = SPACES OR
                  ERROR-SW = "Y".

           IF ERROR-SW = "Y" GO TO COPY-JOBPLANS.

           CALL "TSJOBCOP" USING DBPARAMETERS
                                 SEQ-INT
                                 MASTER-NAMES
                                 WO-NUM-PLANNED.

       C-J-E.    EXIT.

       CHECK-NAMES.
           MOVE MASTER-NAME (S3) TO GJOBPNAME.

           READ FILE8.
           IF FILE-STATUS NOT = "00"
             MOVE "Y" TO ERROR-SW
             MOVE 35135 TO CATREAD-MSG-NUMBER
             CALL "CCATREAD" USING CATREAD-PARMS
             MOVE CATREAD-MSG-TEXT TO SCREEN-ERR-LINE1
             MOVE TRUE-VAL TO INDS (NAME-FIELD) INDS (99).

           ADD 1 TO NAME-FIELD.

       NAME-EXIT.    EXIT.

       COPY-MATPLANS.
           MOVE "FGENSUF3" TO VIEW-CFNAME.
           MOVE SCREEN-BUFFER2 TO DSPLY-REC.
           PERFORM 99-SCREEN-WRITE.
           PERFORM 98-SCREEN-READ.
           MOVE DSPLY-REC TO SCREEN-BUFFER2.
           IF VIEW-LASTKEY = 3 GO TO C-M-E.
           MOVE "N" TO ERROR-SW.
           MOVE 3 TO NAME-FIELD.
           PERFORM CHECK-NAMES2 THRU NAME-EXIT2 VARYING S3 FROM 1 BY 1
            UNTIL S3 > 15 OR
                  MASTER-NAME2 (S3) = SPACES OR
                  ERROR-SW = "Y".
           IF ERROR-SW = "Y" GO TO COPY-MATPLANS.

           CALL "TSPRTCOP" USING DBPARAMETERS
                                 MASTER-NAMES2
                                 WO-NUM-PLANNED.

       C-M-E.    EXIT.

       CHECK-NAMES2.
           MOVE MASTER-NAME2 (S3) TO GPRTPNAME.

           READ FILE9.
           IF FILE-STATUS NOT = "00"
             MOVE "Y" TO ERROR-SW
             MOVE 35135 TO CATREAD-MSG-NUMBER
             CALL "CCATREAD" USING CATREAD-PARMS
             MOVE CATREAD-MSG-TEXT TO SCREEN-ERR-LINE2
             MOVE TRUE-VAL TO INDS (NAME-FIELD) INDS (99).

           ADD 1 TO NAME-FIELD.

       NAME-EXIT2.    EXIT.

       98-SCREEN-READ.
           READ DISPLAY-FILE FORMAT IS VIEW-CFNAME
               INDIC IS INDICS.
           ACCEPT IOFEEDBACK FROM I-O-FEEDBACK-AREA.
           MOVE ALL B"0" TO INDICS.
           IF DSPLY-STATUS NOT = "00"
               MOVE 3 TO VIEW-LASTKEY
           ELSE
           MOVE FUNCTION-NUM TO VIEW-LASTKEY.

       98A-SCREEN-READ.
           READ DISPLAY-FILE TERMINAL IS TERMINAL-ID
               INDIC IS INDICS
                  NO DATA MOVE DSPLY-STATUS TO DSPLY-STATUS.
           MOVE ALL B"0" TO INDICS.

       99-SCREEN-WRITE.
           WRITE DSPLY-REC FORMAT IS VIEW-CFNAME
               INDIC IS INDICS.
           MOVE ALL B"0" TO INDICS.
