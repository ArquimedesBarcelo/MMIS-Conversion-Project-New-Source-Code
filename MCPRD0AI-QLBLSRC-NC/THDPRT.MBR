020000
020100**************************************************************
020200**                                                          **
020300**         L I N K A G E   S E C T I O N                    **
020400**                                                          **
020500**************************************************************
020600
020700 LINKAGE SECTION.
020800
020900 01  RET-CODE             PIC S9(4) COMP-4.
021000 01  FILE-NAME                     PIC X(17).
021100 01  FNUM                          PIC S9(4) COMP-4.
021200 01  ROUTE-DATA.
021300     05  ROUTE-NAME                PIC X(15).
021400     05  ROUTE-DEPT                PIC X(4).
021500     05  ROUTE-LP                  PIC X(3).
021600     05  ROUTE-USER                PIC X(8).
021700     05  ROUTE-ACCOUNT             PIC X(8).
021800     05  ROUTE-GROUP               PIC X(8).
021900     05  ROUTE-TERM                PIC X(4).
022000     05  ROUTE-PAPER-FLAG          PIC X(1).
022100     05  ROUTE-PRTRPT-FLAG         PIC X(1).
022200     05  FILLER                    PIC X(28).
022300
022400 PROCEDURE DIVISION USING RET-CODE, FILE-NAME, FNUM,
022500     ROUTE-DATA.
022600
022700 6000-MAIN.
022800     MOVE RET-CODE                 TO  SAVE-RET-CODE.
022900     MOVE 0                        TO  RET-CODE.
023000
023100*---------- REDIRECT THE HEADER FILE TO THE CORRECT FILE FOR
023200*---------- THE REPORT.
023300*    MOVE FILE-NAME   TO  COMMAND-FILE-NAME.
023400*    MOVE FILE-COMMAND       TO  COMMAND.
023500*     DISPLAY COMMAND.
023600*    CALL INTRINSIC "COMMAND" USING COMMAND-IMAGE, COMMAND-ERROR,
023700*      COMMAND-PARM.
023800*    IF COMMAND-ERROR NOT = 0
023900*        MOVE COMMAND-ERROR  TO  RET-CODE
024000*        DISPLAY "COMMMAND ERROR IN THDPRT"
024100*        DISPLAY "ERROR = ", COMMAND-ERROR
024200*        GO TO 6990-MAIN-X.
      *------ FOR IBM, WE USE THE OVERRIDE DATABASE FILE COMMAND.
           STRING FILE-NAME DELIMITED BY "." INTO FILE-NAME2.
           STRING "OVRDBF FILE(DHDFILE) TOFILE(MCHEADERS) ",
             "MBR(", FILE-NAME2, ")" DELIMITED BY SIZE INTO COMMAND.
           CALL "QCMDEXC" USING COMMAND, COMMAND-LEN.
           OPEN OUTPUT PRT-FILE.
024300
024400*---------- IF CALLED IN MODE2, SKIP ALL PROCESSING EXCEPT THE PART
024500*---------- WHICH PRINTS THE FILE.
024600     IF SAVE-RET-CODE = 2
024700         GO TO 6100-PRINT-FILE.
024800
024900
025000*---------- IF WE ARE NOT USING "TPRTRPT", AND IF OUR PAPER-FLAG
025100*---------- IS 80-COLUMN (FLAG = SPACES), THEN USE COMPRESSED
025200*---------- PRINT ON THE HEADER.  "TPRTRPT" WILL HANDLE THIS
025300*---------- ITSELF IF IT IS USED.
025400     IF ROUTE-PRTRPT-FLAG = " "
025500         IF ROUTE-PAPER-FLAG NOT = "X"
025600             MOVE COMPRESS-ESC-SEQ TO PRT-REC
                   WRITE PRT-REC AFTER ADVANCING 0.
025700
025800*---------- PAGE EJECT. FOR IBM EVERYTHING IS SPOOLED, NO EJECT
025900*---------- IF "TPRTRPT" IS TO BE USED, MOVE "0" (PAGE EJECT FOR
026000*---------- THE PROGRAM) TO THE "TPRTRPT" CONTROL CHARACTER.
026100*    MOVE "E"                  TO  CONTROL-CHARACTER.
026200*    IF ROUTE-PRTRPT-FLAG = "Y"
026300*        MOVE "0"                  TO  CONTROL-CHARACTER.
026400*    PERFORM 9000-FWRITE.
026500
026600*---------- GO BACK TO SINGLE SPACING
026700*---------- IF "TRPTRPT" IS USED, MOVE "1" (SINGE SPACING CONTROL)
026800*---------- TO THE "TPRTRPT" CONTROL CHARACTER.
026900     MOVE "S"                      TO  CONTROL-CHARACTER.
027000     IF ROUTE-PRTRPT-FLAG = "Y"
027100         MOVE "1"                  TO CONTROL-CHARACTER.
027200
027300*---------- PRINT THE ROUTING INFORMATION.
027400     MOVE ROUTE-NAME               TO  PRT-NAME.
027500     MOVE ROUTE-DEPT               TO  PRT-DEPT.
027600     MOVE ROUTE-USER               TO  PRT-USER.
027700     MOVE ROUTE-ACCOUNT      TO  PRT-ACCT.
027800     MOVE ROUTE-GROUP        TO  PRT-GROUP.
027900     MOVE ROUTE-TERM         TO  PRT-TRM.
028000
028100     PERFORM 9000-PRINT-ROUTE.
028200
028300*---------- SKIP SOME SPACES.
028400     MOVE SPACES             TO  TG-MIDDLE.
028500     PERFORM 9000-FWRITE 3 TIMES.
028600
028700**************************************************************
028800**  THIS PORTION OF THE PROGRAM PRINTS THE FILE TO THE      **
028900**  REPORT.                                                 **
029000**************************************************************
029100
029200 6100-PRINT-FILE.
029300     OPEN INPUT HEADER-FILE.
029400
029500 6200-READ-LOOP.
029600     READ HEADER-FILE AT END
029700         GO TO 6300-PRINT-BOTTOM.
029710
029720*------- IF CALLED IN MODE 2, DONT PRINT IN THE MIDDLE, PRINT
029730*------- FROM THE LEFT.  OTHERWISE, PRINT THE HEADER IN THE MIDDLE
029740*------- OF A 132-CHARACTER REPORT.
029750     IF SAVE-RET-CODE = 2
029760         MOVE HEADER-AREA          TO  TG-AREA
029770     ELSE
029780         MOVE HEADER-AREA          TO  TG-MIDDLE.
029790
030000     PERFORM 9000-FWRITE.
030100
030200     GO TO 6200-READ-LOOP.
030300
030400 6300-PRINT-BOTTOM.
030500*---------- IF CALLED IN MODE 2, SKIP ANY FURTHER PRINTING AFTER
030600*---------- THE FILE IS PRINTED.
030700     IF SAVE-RET-CODE = 2
030800         GO TO 6990-MAIN-X.
030900
031000*---------- SKIP SOME SPACES.
031100
031200     MOVE SPACES TO TG-MIDDLE.
031300     PERFORM 9000-FWRITE 3 TIMES.
031400
031500*---------- PRINT THE ROUTING INFO AGAIN
031600     PERFORM 9000-PRINT-ROUTE.
031700
031800*---------- IF WE USED COMPRESSED PRINT, RETURN TO STANDARD PRINT
031900     IF ROUTE-PRTRPT-FLAG = " "
032000         IF ROUTE-PAPER-FLAG = " "
032100             MOVE STANDARD-ESC-SEQ TO TG-MIDDLE
032200             PERFORM 9000-FWRITE.
032300
032400 6990-MAIN-X.
           CLOSE HEADER-FILE.
           CLOSE PRT-FILE.
032500     GOBACK.
032600
032700*************************************************************
032800**                                                         **
032900**           P E R F O R M E D   R O U T I N E S           **
033000**                                                         **
033100*************************************************************
033200
033300 9000-FWRITE.
           MOVE TG-AREA TO PRT-REC.
           IF CONTROL-CHARACTER = "E"
               WRITE PRT-REC AFTER ADVANCING NEW-PAGE
           ELSE
               WRITE PRT-REC AFTER ADVANCING 1.

033400*    CALL INTRINSIC "FWRITE" USING FNUM, TARGET, %64, %1.
033500*    IF C-C NOT = 0
033600*       CALL INTRINSIC "PRINTFILEINFO" USING FNUM
033700*       CALL INTRINSIC "FCHECK" USING FNUM, FCHECK-ERROR-NUM
033800*       CALL INTRINSIC "FERRMSG" USING FCHECK-ERROR-NUM,
033900*         FCHECK-MSG, FCHECK-MSG-LENGTH
034000*       CALL INTRINSIC "PRINT" USING FCHECK-MSG, -72, 0
034100*        DISPLAY "FWRITE FAILED",
034200*        MOVE 2   TO  RET-CODE
034300*        GOBACK.
034400
034500 9000-PRINT-ROUTE.
034600     MOVE ALL-ASTERISKS  TO  TG-MIDDLE.
034700     PERFORM 9000-FWRITE.
034800     MOVE RT-HDR-1           TO  TG-MIDDLE.
034900     PERFORM 9000-FWRITE.
035000     MOVE RT-HDR-2           TO  TG-MIDDLE.
035100     PERFORM 9000-FWRITE.
035200     MOVE RT-HDR-3           TO  TG-MIDDLE.
035300     PERFORM 9000-FWRITE.
035400     MOVE RT-HDR-4           TO  TG-MIDDLE.
035500     PERFORM 9000-FWRITE.
035600     MOVE ALL-ASTERISKS      TO  TG-MIDDLE.
035700     PERFORM 9000-FWRITE.
035800
