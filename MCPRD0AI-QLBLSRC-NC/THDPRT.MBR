015500
015600 01  ALL-ASTERISKS.
015700     05  FILLER  PIC X(4)   VALUE SPACES.
015800     05  FILLER  PIC X(65)  VALUE ALL "*".
015900     05  FILLER  PIC X(4)   VALUE SPACES.
016000
016100 01  RT-HDR-1.
016200     05  FILLER     PIC X(4)  VALUE SPACES.
016300     05  FILLER     PIC X(12) VALUE "**          ".
016400     05  FILLER     PIC X(12) VALUE "R O U T E   ".
016500     05  FILLER     PIC X(17) VALUE "P R I N T   T O :".
016600     05  FILLER     PIC X(22) VALUE SPACES.
016700     05  FILLER     PIC X(2)  VALUE "**".
016800     05  FILLER     PIC X(4)  VALUE SPACES.
016900
017000 01  RT-HDR-2.
017100     05  FILLER     PIC X(4)  VALUE SPACES.
017200     05  FILLER     PIC X(4)  VALUE "**  ".
017300     05  FILLER     PIC X(6)  VALUE "NAME: ".
017400     05  PRT-NAME   PIC X(15) VALUE SPACES.
017500     05  FILLER     PIC X(38) VALUE SPACES.
017600     05  FILLER     PIC X(2)  VALUE "**".
017700     05  FILLER     PIC X(4)  VALUE SPACES.
017800
017900 01  RT-HDR-3.
018000     05  FILLER    PIC X(4)  VALUE SPACES.
018100     05  FILLER    PIC X(10) VALUE "**  DEPT: ".
018200     05  PRT-DEPT  PIC X(4).
018300     05  FILLER    PIC X(49) VALUE SPACES.
018400     05  FILLER    PIC X(2)  VALUE "**".
018500     05  FILLER    PIC X(4)  VALUE SPACES.
018600
018700 01  RT-HDR-4.
018800     05  FILLER    PIC X(4)  VALUE SPACES.
018900     05  FILLER    PIC X(10) VALUE "**  USER: ".
019000     05  PRT-USER  PIC X(8).
019100     05  FILLER    PIC X(1)  VALUE ".".
019200     05  PRT-ACCT  PIC X(8).
019300     05  FILLER    PIC X(1)  VALUE ",".
019400     05  PRT-GROUP PIC X(8).
019500     05  FILLER    PIC X(10) VALUE "    TERM: ".
019600     05  PRT-TRM   PIC X(4).
019700     05  FILLER    PIC X(13) VALUE SPACES.
