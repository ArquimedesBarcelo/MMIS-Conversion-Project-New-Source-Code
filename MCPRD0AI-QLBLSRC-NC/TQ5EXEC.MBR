000200 IDENTIFICATION DIVISION.
000300 PROGRAM-ID.         TQ5EXEC.
000600*REMARKS.   ****THIS PROGRAM TESTS SUBROUTINE TEQPHIER;
000700*               SUBROUTINES CALLED:
000800*                   TEQPHIER
000900*                   ****.
001000 ENVIRONMENT DIVISION.
001100 CONFIGURATION SECTION.
001200 SOURCE-COMPUTER.    AS400.
001300 OBJECT-COMPUTER.    AS400.
001400 INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT DISPLAY-FILE
               ASSIGN TO WORKSTATION-ZINQUIRY-SI
               ORGANIZATION IS TRANSACTION
               FILE STATUS IS DSPLY-STATUS
               CONTROL-AREA IS WS-CONTROL.
           SELECT EQUIPMENT-FILE
               ASSIGN TO DATABASE-MCFLMM0201
               ORGANIZATION IS INDEXED
               ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
               FILE STATUS IS EF-STATUS.
           SELECT WO-EQUIP-HIER
               ASSIGN TO DATABASE-MCFLMM1701
               ORGANIZATION IS INDEXED
               ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
               FILE STATUS IS WEH-STATUS.
           SELECT WO-LAST-NUM-USED
               ASSIGN TO DATABASE-MCFPMM0800
               ORGANIZATION IS RELATIVE
               ACCESS MODE IS RANDOM
               RELATIVE KEY IS ARG-NO
               FILE STATUS IS WLNU-STATUS.
001500 DATA DIVISION.
001600 FILE SECTION.
       FD  DISPLAY-FILE
           LABEL RECORDS ARE OMITTED.
       01  DSPLY-REC                   PIC X(2000).
       FD  EQUIPMENT-FILE
           LABEL RECORDS ARE STANDARD
           DATA RECORD IS EFREC.
       01  EFREC.
           COPY DDS-ALL-FORMATS OF MCFLMM0201.
       FD  WO-EQUIP-HIER
           LABEL RECORDS ARE STANDARD
           DATA RECORD IS WEHREC.
       01  WEHREC.
           COPY DDS-ALL-FORMATS OF MCFLMM1701.
       FD  WO-LAST-NUM-USED
           LABEL RECORDS ARE STANDARD
           DATA RECORD IS WLNUREC.
       01  WLNUREC.
           COPY DDS-ALL-FORMATS OF MCFPMM0800.
001700 WORKING-STORAGE SECTION.
001800 77  ARG-NO                          PIC 9(9).
001900 77  EOF-SW                          PIC 9 VALUE 0.
002200 77  SUB                             PIC 99.
003200
       COPY CATREAD OF COPYLIB.

       COPY CPYIND  OF COPYLIB.

       COPY TDATESUB OF COPYLIB.
003400
003500 01  DBPARAMETERS.       COPY DBPARMS OF COPYLIB.
003600
003700 01  DESC-BUFFER.
003800     05  DESCBUFF.
003900         10  SUB-BUF-1               PIC X.
004000         10  DESC-BUF-1              PIC X(40).
004100         10  SUB-BUF-2               PIC X.
004200         10  DESC-BUF-2              PIC X(40).
004300         10  SUB-BUF-3               PIC X.
004400         10  DESC-BUF-3              PIC X(40).
004500         10  SUB-BUF-4               PIC X.
004600         10  DESC-BUF-4              PIC X(40).
004700         10  SUB-BUF-5               PIC X.
004800         10  DESC-BUF-5              PIC X(40).
004900         10  SUB-BUF-6               PIC X.
005000         10  DESC-BUF-6              PIC X(40).
005100         10  SUB-BUF-7               PIC X.
005200         10  DESC-BUF-7              PIC X(40).
005300         10  SUB-BUF-8               PIC X.
005400         10  DESC-BUF-8              PIC X(40).
005500         10  SUB-BUF-9               PIC X.
005600         10  DESC-BUF-9              PIC X(40).
005700         10  SUB-BUF-10              PIC X.
005800         10  DESC-BUF-10             PIC X(40).
005900     05  DDESC-BUF REDEFINES DESCBUFF.
006000         10  DDESC-B OCCURS 10 TIMES.
006100             15  DBUF-SUB            PIC X.
006200             15  DBUF-DESC           PIC X(40).
006300
006400 01  EQP-DISPLAY.
006500     05  C-DATE                      PIC X(8).
006600     05  E-TYPE                      PIC X(8).
006700     05  E-NAME                      PIC X(50).
006800     05  E-SUBSYS                    PIC XXXX.
006900     05  E-DESC-BUFF.
007000         10  EDESC-BUFF OCCURS 10 TIMES.
007100             15  E-SUB               PIC X.
007200             15  FILLER              PIC X.
007300             15  E-DASH              PIC X.
007400             15  FILLER              PIC X.
007500             15  E-DESC              PIC X(40).
           05  E-CMD-LINE                  PIC X(79).
           05  E-MSG-LINE                  PIC X(79).
007600
007700 01  EQP-EQUIPMENT.      COPY MEQPFILE OF COPYLIB.
007800
       01  ERROR-BUFFER                    PIC X(80).

007900 01  FAILURE-CODE.
008000     05  TYPE-FAILURE                PIC XX.
008100     05  SUBSYSTEMS-INDICATOR.
008200         10  LEVEL-1-SUBSYS          PIC X.
008300         10  LEVEL-2-SUBSYS          PIC X.
008400         10  LEVEL-3-SUBSYS          PIC X.
008500         10  LEVEL-4-SUBSYS          PIC X.
008600
       01  FILE-STATUSES.
           05  DSPLY-STATUS                PIC XX.
           05  EF-STATUS                   PIC XX.
           05  WEH-STATUS                  PIC XX.
           05  WLNU-STATUS                 PIC XX.

009700 01  HIER-KEY-WA.
009800     05  HIER-KEY.
009900         10  EQUIP-TYPE-NUM          PIC X(8).
010000         10  EQUIP-HIER-POINT        PIC X(6).
           05  HIER-CMD-LINE               PIC X(79).
           05  HIER-MSG-LINE               PIC X(79).
010100
010200 01  HIGHEST-SUB                     PIC 99.
010300
010400 01  LAST-WO-BUFF.       COPY MLASTWO OF COPYLIB.
010500
010600 01  PASSED-SPOOL-PRT             PIC S9(2) VALUE ZERO  COMP.
010700
010800 01  PASSWORD-INFORMATION.
010900     05  NAME-OF-PROGRAM     PIC X(08) VALUE "TEXCHIER".
011000     05  PROGRAM-TYPE        PIC X(02) VALUE "IN".
011100     05  PROGRAM-RELEASE     PIC X(12) VALUE " E0100010001".
011200     05  PROGRAM-DESCRIPTION.
011300         10  PROG-DESC-A     PIC X(60) VALUE
011400             "EXECUTIVE CALLING PROGRAM OF Q5 INQUIRY    "       .
011500         10  PROG-DESC-B     PIC X(60) VALUE SPACES.
011700         10  PROG-FUNCTION   PIC X(60) VALUE SPACES.
011900     05  PASSWORD-FLAG       PIC X.
012100
012500 01  SCREEN-PRINT-PARMS.
012600     05  PRINTCNTL                PIC S9(4) VALUE ZERO  COMP.
012700     05  PAGECNTL                 PIC S9(4) VALUE 49    COMP.
012800     05  SPOOLFIL-OPEN-SW         PIC X   VALUE "N".
012900
       COPY DBSTAT OF COPYLIB.
013100
013200 01  TRUE-VAL                        PIC 1 VALUE B"1".
013300
       COPY VCOMAREA OF COPYLIB.
013500
       COPY WSCONTROL OF COPYLIB.
013900 PROCEDURE DIVISION.
014000 BEGIN-PGM.
014100     PERFORM 1-HSK.
014200     PERFORM 6-MAIN THRU 6-MAIN-X UNTIL HIER-KEY = "END".
       2-EOJ.
           CLOSE DISPLAY-FILE.
           CLOSE EQUIPMENT-FILE.
           CLOSE WO-EQUIP-HIER.
           CLOSE WO-LAST-NUM-USED.
014900     GOBACK.
015000
015100 1-HSK.
           OPEN I-O    DISPLAY-FILE.
           OPEN INPUT  EQUIPMENT-FILE.
           OPEN INPUT  WO-LAST-NUM-USED.
           OPEN INPUT  WO-EQUIP-HIER.
016700     CALL "TPWORD" USING PASSWORD-INFORMATION.
017100     IF PASSWORD-FLAG = "N" GO TO 2-EOJ.
           MOVE 0 TO COND-WORD.
017800     MOVE 1 TO ARG-NO.
           READ WO-LAST-NUM-USED INTO LAST-WO-BUFF
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF WLNU-STATUS NOT = "00" MOVE 17 TO COND-WORD.
           IF COND-WORD = 17 MOVE 1 TO DATE-FLAG-SW.
018100     MOVE DATE-FLAG-SW TO DATE-FLAG.
018200     MOVE 1 TO DATE-MODE.
018300     MOVE DATE-FLAG TO DATE-CODE.
018400     CALL "TDATECHK" USING DATE-CHECK-AREA.
018500     MOVE DATE-SLASH-OUT TO C-DATE.
           MOVE SPACES TO ERROR-BUFFER.
022400 6-MAIN.
           MOVE SPACES TO HIER-KEY-WA.
022500     PERFORM 61-GET-KEY THRU 61-READ-EQUIPMENT.
022600     IF HIER-KEY = "END           " GO TO 6-MAIN-X.
022800     MOVE "              " TO SUBSYSTEMS-INDICATOR.
033700     MOVE "XXXX" TO E-SUBSYS.
022900     PERFORM 62-DISPLAY-HIER THRU 62-DH-EXIT.
023000
023100 6-MAIN-X.    EXIT.
023300
023400 61-GET-KEY.
023500     MOVE "FQ5INQ" TO VIEW-CFNAME.
           MOVE ERROR-BUFFER TO HIER-CMD-LINE.
           MOVE HIER-KEY-WA TO DSPLY-REC.
           PERFORM 99-SCREEN-WRITE.
           PERFORM 98-SCREEN-READ.
           MOVE DSPLY-REC TO HIER-KEY-WA.
026400     IF VIEW-LASTKEY = 3 GO TO 2-EOJ.
026800     MOVE "0000  " TO EQUIP-HIER-POINT.
           MOVE 0 TO COND-WORD.
026900     MOVE HIER-KEY-WA TO HIERKEY OF WEHREC.
           START WO-EQUIP-HIER KEY IS = EXTERNALLY-DESCRIBED-KEY
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF WEH-STATUS NOT = "00" MOVE 17 TO COND-WORD.
027400     IF COND-WORD = 17
027500         MOVE 31004 TO CATREAD-MSG-NUMBER
027700         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE TRUE-VAL TO INDS (99)
028200         GO TO 61-GET-KEY.
028300     MOVE EQUIP-TYPE-NUM TO E-TYPE.
028500 61-READ-EQUIPMENT.
           MOVE 0 TO COND-WORD.
           IF EOF-SW = 0
028600         READ EQUIPMENT-FILE NEXT INTO EQP-EQUIPMENT
                   AT END MOVE 11 TO COND-WORD.
           IF EOF-SW = 1
               READ EQUIPMENT-FILE PRIOR INTO EQP-EQUIPMENT
                   AT END MOVE 10 TO COND-WORD.
028700     IF EF-STATUS NOT = "00" MOVE 17 TO COND-WORD.
028800     IF COND-WORD = 11
028900       ADD 1 TO EOF-SW
029000       IF EOF-SW = 2
029100         MOVE 31005 TO CATREAD-MSG-NUMBER
029300         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
029800         MOVE 0 TO EOF-SW
029900         GO TO 61-GET-KEY
030000       ELSE
030200       GO TO 61-READ-EQUIPMENT
030300     ELSE
030400     IF COND-WORD = 10
030500       ADD 1 TO EOF-SW
030600       IF EOF-SW = 2
030700         MOVE 31005 TO CATREAD-MSG-NUMBER
030900         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
031400         MOVE 0 TO EOF-SW
031500         GO TO 61-GET-KEY
031600       ELSE
031800       GO TO 61-READ-EQUIPMENT
031900     ELSE
032000     IF COND-WORD = 0
032100         IF EQP-TYPE NOT = EQUIP-TYPE-NUM
032200             GO TO 61-READ-EQUIPMENT
032300         ELSE
032400         MOVE EQP-CORP-DESC TO E-NAME.
       62-DISPLAY-HIER.
032800     MOVE "FQ5INQ2" TO VIEW-CFNAME.
           MOVE EQP-DISPLAY TO DSPLY-REC.
           PERFORM 99-SCREEN-WRITE.
           PERFORM 98-SCREEN-READ.
           MOVE DSPLY-REC TO EQP-DISPLAY.
035500     IF VIEW-LASTKEY = 3
035600         MOVE SPACES TO E-SUBSYS E-DESC-BUFF
035700         GO TO 62-DH-EXIT.
038200     MOVE E-SUBSYS TO SUBSYSTEMS-INDICATOR.
038300     IF E-SUBSYS = "0000"
038400         MOVE 45042 TO CATREAD-MSG-NUMBER
038600         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE TRUE-VAL TO INDS (99)
039100         GO TO 62-DISPLAY-HIER.
039200     IF SUBSYSTEMS-INDICATOR NOT = "END"
039300         CALL "TEQPHIER" USING DBPARAMETERS
                                     EQUIP-TYPE-NUM
                                     FAILURE-CODE
                                     DESC-BUFFER
                                     HIGHEST-SUB
               MOVE SPACES TO E-DESC-BUFF E-CMD-LINE E-MSG-LINE
039700         PERFORM 621-MOVE-HIERS VARYING SUB FROM 1 BY 1
039800             UNTIL SUB > 10
040300         GO TO 62-DISPLAY-HIER.
040400
040500 62-DH-EXIT.    EXIT.
040600 621-MOVE-HIERS.
040700     IF DBUF-SUB (SUB) = " " OR "0"
040800         NEXT SENTENCE
040900     ELSE
041000     MOVE DBUF-SUB (SUB) TO E-SUB (SUB)
041100     MOVE "-" TO E-DASH (SUB)
041200     MOVE DBUF-DESC (SUB) TO E-DESC (SUB).

       98-SCREEN-READ.
           READ DISPLAY-FILE INDIC IS INDICS
               MOVE FUNCTION-NUM TO VIEW-LASTKEY
               MOVE ALL B"0" TO INDICS.
       99-SCREEN-WRITE.
           WRITE DSPLY-REC FORMAT IS VIEW-CFNAME
               INDIC IS INDICS.

042500 999-CATREAD.
042600     MOVE SPACES TO ERROR-BUFFER.
042700     CALL "CCATREAD" USING CATREAD-PARMS.
042800     MOVE CATREAD-MSG-TEXT TO ERROR-BUFFER.
043500 999-CATREAD-EXIT.    EXIT.
