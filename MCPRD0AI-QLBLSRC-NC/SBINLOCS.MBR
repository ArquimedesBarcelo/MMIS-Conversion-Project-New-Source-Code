015600 01  DE-FIELDS.
015700     05  DE-CORP-CODE             PIC X(7).
015800     05  V-INSTRUCTION            PIC X(40).
015900     05  DE-DATA.
016000         10  V-CORP-CODE          PIC X(7).
016100         10  V-DESC-1             PIC X(55).
016200         10  V-UM                 PIC XX.
016300         10  V-DESC-2             PIC X(78).
016400         10  V-DESC-3             PIC X(78).
016500         10  DE-LOC-AREA.
016600             15  DE-LOC-LINE OCCURS 6 TIMES.
016700                 20  DE-LOC       PIC X(12).
016800                 20  V-LOC-ONHAND PIC -------9.
                       20  DE-FRAN-ID   PIC X(1).
                       20  DE-FRAN-NAME PIC X(4).
016900         10  INPUT-TRANSFERS OCCURS 6 TIMES.
017000             15  DE-TRANS-QTY     PIC X(8).
017100             15  DE-TRANS-QTY-9 REDEFINES DE-TRANS-QTY PIC 9(8).
017200             15  DE-FROM-BIN      PIC XX.
017300             15  DE-TO-BIN        PIC XX.
017400     05  DE-COMMAND-LINE          PIC X(79).
017500     05  DE-MESSAGE-LINE          PIC X(79).
017600
017700
