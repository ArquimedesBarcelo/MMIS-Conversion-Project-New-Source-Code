000200 IDENTIFICATION DIVISION.
000300 PROGRAM-ID.          SBINLOCS.
000400 AUTHOR.              C HILLES.
000500 DATE-WRITTEN.        03/07/90.
000600 DATE-COMPILED.
000700*INSTALLATION.        GOODYEAR TIRE AND RUBBER - AKRON.
000800*SECURITY.
000900*REMARKS.
001000*D   CHANGE BIN LOCATIONS AND TRANSFER BIN LOCATIONS SUBPROG.
001100*D   THIS NEW SUBPROG REPLACES SMCHGBIN - CHANGE BIN LOCATIONS,
001200*    AND SMTRBQTY - TRANSFER BIN QUANTITIES SUBPROGRAMS.
001300*    FORMS:
001400*      FBINLOC   FATHER FORM (HP ONLY)
001500*      FBINLOC1  CORPORATE CODE ENTRY
001600*      FBINLOC2  LOCATIONS ONLY
001700*      FBINLOC3  TRANSFERS ONLY
001800*      FBINLOC4  LOCATIONS AND TRANSFERS
      ****************************************************************
      *C 06/12/96  JEFF BUNGO
      *C     EXPAND DATE FIELDS FOR YEAR 2000 COMPLIANCE.
      *C     RECOMPILE PROGRAM TO PICK UP NEW FILE FORMATS.
      *C
      *C 04/15/97  JEFF BUNGO
      *C     ADD FRANCHISE (OWNER) FOR EACH BIN LOCATION.  USE
      *C     MPLTINFO "FRAN" FOR VALIDATION AND NAME RETRIEVAL.
001900
002000 ENVIRONMENT DIVISION.
002100 CONFIGURATION SECTION.
002200 SOURCE-COMPUTER.  HP-3000.
002300 OBJECT-COMPUTER.  HP-3000.
002400 COPY SPECIALN IN COPYLIB.
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT MSTORERM-CD-O
               ASSIGN TO DATABASE-MCFLCS0201
               ORGANIZATION IS INDEXED
                 ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
               FILE STATUS IS FILE-STATUS.

           SELECT DDAILYTC-DT-O
               ASSIGN TO DATABASE-MCFLCS1601
               ORGANIZATION IS INDEXED
                 ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                 WITH DUPLICATES
               FILE STATUS IS FILE-STATUS.

           SELECT DWLITEM-CD-I
               ASSIGN TO DATABASE-MCFLCS1502
               ORGANIZATION IS INDEXED
                 ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                 WITH DUPLICATES
               FILE STATUS IS FILE-STATUS.

           SELECT MPLTINFO
               ASSIGN TO DATABASE-MCFLCS0501
               ORGANIZATION IS INDEXED
                 ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
               FILE STATUS IS FILE-STATUS.

           SELECT DISPLAY-FILE
               ASSIGN TO WORKSTATION-ZUDCSTR-SI
               ORGANIZATION IS TRANSACTION
               ACCESS IS SEQUENTIAL
               FILE STATUS IS DISPLAY-STATUS
               CONTROL-AREA IS WS-CONTROL.
002600
