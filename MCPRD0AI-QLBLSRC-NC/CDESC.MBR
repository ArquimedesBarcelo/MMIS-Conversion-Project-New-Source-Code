000200 IDENTIFICATION DIVISION.
000300 PROGRAM-ID.          CDESC.
000400 AUTHOR.              C HILLES.
000500 DATE-WRITTEN.        7/1/83.
000600 DATE-COMPILED.
000700*INSTALLATION.        GOODYEAR TIRE AND RUBBER - AKRON.
000800 SECURITY.
000900*REMARKS.   THIS SUBPROGRAM RETURNS UP TO 25 LINES OF DESCRIPTION
001000*           FOR ANY CORPORATE CODE PASSED TO IT.
001100*
      *C**************************************************************
      *C  06/06/96   JEFF BUNGO
      *C     EXPANDED DATE FIELDS FOR YEAR 2000 COMPLIANCE.
      *C     RECOMPILE PROGRAM TO PICK UP NEW FILE FORMAT.
      *C
      *C  07/17/97   JEFF BUNGO
      *C     IF KEYWORD/MODIFIER NOT FOUND IN DESC ID "00",
      *C     THEN MOVE SPACES TO DESCRIPTION LINE AND
      *C     INCREMENT COUNTER.
      *C**************************************************************
001200 ENVIRONMENT DIVISION.
001300 CONFIGURATION SECTION.
001400 SOURCE-COMPUTER.  HP-3000.
001500 OBJECT-COMPUTER.  HP-3000.
001600
002000 INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT DDESC
                  ASSIGN TO DATABASE-MCFLCS1401
                  ORGANIZATION IS INDEXED
                    ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                  FILE STATUS IS FILE-STATUS.

           SELECT DDESC2
                  ASSIGN TO DATABASE-MCFLCS3101
                  ORGANIZATION IS INDEXED
                    ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                  FILE STATUS IS FILE-STATUS.

           SELECT DMANPART
                  ASSIGN TO DATABASE-MCFLCS3603
                  ORGANIZATION IS INDEXED
                    ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                  FILE STATUS IS FILE-STATUS.

           SELECT MSTORERM
                  ASSIGN TO DATABASE-MCFLCS0201
                  ORGANIZATION IS INDEXED
                    ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                  FILE STATUS IS FILE-STATUS.

001700 DATA DIVISION.
       FILE SECTION.
       FD  DDESC
           LABEL RECORDS ARE STANDARD.
       01  DDESC-REC.
           COPY DDS-MCRPCS1400 OF MCFLCS1401.

       FD  DDESC2
           LABEL RECORDS ARE STANDARD.
       01  DDESC2-REC.
           COPY DDS-MCRPCS3100 OF MCFLCS3101.

       FD  DMANPART
           LABEL RECORDS ARE STANDARD.
       01  DMANPART-REC.
           COPY DDS-MCRPCS3600 OF MCFLCS3603.

       FD  MSTORERM
           LABEL RECORDS ARE STANDARD.
       01  MSTORERM-REC.
           COPY DDS-MCRPCS0200 OF MCFLCS0201.

001900
001800 WORKING-STORAGE SECTION.
002000 77  SUB                     PIC 9(2)  VALUE 0.
002100 77  DESC-LIMIT              PIC 9(2)  VALUE 0.
002200 77  FOUND-LOCAL-DESC-FLAG   PIC X(1)  VALUE "N".
       77  DESCIDNUM-WORK          PIC X(2).
002300
002400 COPY CFINPTYP IN COPYLIB.
002500**************************************************************
002600**                                                          **
002700**            D A T A B A S E   W O R K                     **
002800**                                                          **
002900**************************************************************
003000
003100 01  DSET-NAMES.
003200     05  DSET-DMANPART       PIC X(16) VALUE "DMANPART;".
003300     05  DSET-DDESC          PIC X(16) VALUE "DDESC;".
003400
003500 01  MODE-AREA.
003600     05  MODE1               PIC S9(4) COMP VALUE 1.
003700     05  MODE5               PIC S9(4) COMP VALUE 5.
003800     05  MODE6               PIC S9(4) COMP VALUE 6.
003900     05  MODE7               PIC S9(4) COMP VALUE 7.
004000
004100 01  CODE-ARG                PIC X(8)  VALUE SPACES.
004200
004300 01  ALL-ITEM-LIST           PIC X(2)  VALUE "@;".
004400
004500 01  CODE-SEARCH             PIC X(10) VALUE "CORP-CODE;".
004600
       01  FILE-STATUS.
           05  FILE-STATUS-1            PIC X  VALUE "0".
           05  FILE-STATUS-2            PIC X  VALUE "0".

004700**************************************************************
004800**                                                          **
004900**           D A T A B A S E   B U F F E R S                **
005000**                                                          **
005100**************************************************************
005200
005300 COPY DMANPART IN COPYLIB.
005400 COPY DDESC    IN COPYLIB.
       COPY MSTORERM IN COPYLIB.

005500**************************************************************
005600**                                                          **
005700**                L I N K A G E   S E C T I O N             **
005800**                                                          **
005900**************************************************************
006000
006100 LINKAGE SECTION.
006200
006300 01  RET-CODE                   PIC X(2).
006400 01  BASE                       PIC X(10).
006500
006600 01  STATUS-AREA.
006700     05  COND-WORD              PIC S9(4) COMP-4.
006800     05  DATA-LENG              PIC S9(4) COMP-4.
006900     05  RCD-NO                 PIC S9(9) COMP-4.
007000     05  CHAIN-LENG             PIC S9(9) COMP-4.
007100     05  BKWD-ADDR              PIC S9(9) COMP-4.
007200     05  FWRD-ADDR              PIC S9(9) COMP-4.
007300
007400 01  BU-DISPLAY-MSG             PIC X(60).
007500
007600 01  DE-CODE                     PIC X(8).
007700
007800*---------- CDESC-OPTIONS
007900*   CDESC-LINES-TO-GET       PASS MAX NUMBER OF LINES YOU WISH
008000*                            RETURNED
008100*
008200*   FDES-LINES-GOT           RETURNS ACUTAL NUMBER OF LINES GOT
008300*
008400*   CDESC-LANGUAGE-OPITON    P  -  PRIMARY LANGUAGE
008500*                            S  -  SECONDARY LANGUAGE
008600*
008700*   CDESC-DESC-OPTION        F  -  FULL DESC (KEYWORD, MAN, DDESC)
008800*                            D  -  JUST DDESC OR DDESC2
008900*                            M  -  JUST MANUFACTURERS
009000*                            K  -  JUST KEYWORD/ADJECTIVE
009100*
009200*  CDESC-MANUFACT-OPTION     S  -  RETURN ONLY THE SELECTED
009300*                                  MANUFACTURERS
009400*                            A  -  RETURN ALL MANUFACTURERS
009500*  CDESC-LOCAL-OPTION        R  -  LOCAL DESC REQUIRED AS PART OF
009600*                                  DESC
009700*                            N  -  LOCAL DESC NOT REQUIRED
009800*
009900 01  CDESC-DATA.
010000     05  CDESC-LINES-TO-GET        PIC S9(4) COMP-4.
010100     05  CDESC-LINES-GOT           PIC S9(4) COMP-4.
010200     05  CDESC-LANGUAGE-OPTION     PIC X(1).
010300     05  CDESC-DESC-OPTION         PIC X(1).
010400     05  CDESC-MANUFACT-OPTION     PIC X(1).
010500     05  CDESC-LOCAL-DESC-OPTION   PIC X(1).
010600     05  CDESC-PAD                 PIC X(10).
010700     05  CDESC-LINE OCCURS 25 TIMES.
010800         10  CDESC-TYPE            PIC X(1).
010900         10  CDESC-MAN-SELCT  PIC X(1).
011000         10  CDESC          PIC X(80).
011100*-------- CDESC-TYPE = "K"
011200         10  CDESC-KWM-DATA REDEFINES CDESC.
011300             15 CDESC-KWM.
011400                20 CDESC-KEYWORD   PIC X(19).
011500                20   FILLER        PIC X(1).
011600                20 CDESC-MODIFIER  PIC X(30).
011700             15 FILLER             PIC X(30).
011800*--------- CDESC-TYPE = "M"
011900         10  CDESC-MFR-DATA REDEFINES CDESC.
012000             15 CDESC-MFR-NAME     PIC X(26).
012100             15   FILLER           PIC X(1).
012200             15 CDESC-MFR-TYPE     PIC X(3).
012300             15   FILLER           PIC X(1).
012400             15 CDESC-MFR-PART     PIC X(20).
012500             15   FILLER           PIC X(29).
012600
012700 PROCEDURE DIVISION USING RET-CODE, BASE, STATUS-AREA,
012800     BU-DISPLAY-MSG, DE-CODE, CDESC-DATA.
012900
013000 6-MAIN.
           MOVE 0 TO SUB, DESC-LIMIT.
           MOVE "N" TO FOUND-LOCAL-DESC-FLAG.
           IF CDESC-LINES-TO-GET > 25
               MOVE 25 TO CDESC-LINES-TO-GET.
013100
           IF CDESC-LANGUAGE-OPTION = "S"
               OPEN INPUT DDESC2
           ELSE
               OPEN INPUT DDESC.
           OPEN INPUT DMANPART, MSTORERM.
013200     MOVE SPACES TO CDESC (1), CDESC (2), CDESC (3), CDESC (4).
013300     MOVE "00"                     TO   RET-CODE.
013400     MOVE DE-CODE                  TO   CODE-ARG.
013500
013600*---------- DETERMINE WHETHER TO LOOK AT PRIMARY OR SECONDARY
013700*---------- LANGUAGE.  PRIMARY WILL DEFAULT IF CALLING PROGRAM
013800*---------- HAS WRONG PARAMETER.
013900*    IF CDESC-LANGUAGE-OPTION = "S"
014000*        MOVE "DDESC2;"            TO  DSET-DDESC
014100*    ELSE
014200*        MOVE "DDESC;"             TO  DSET-DDESC.
014300
      *------ FOR IBM ONLY, WE HAVE TO VALIDATE THE EXISTENCE OF THE
      *------ CORPORATE CODE.
           MOVE CODE-ARG TO CORPCDE OF MSTORERM-REC.
           READ MSTORERM INTO BUF-MSTORERM
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS-1 = "2"
               MOVE "NF" TO RET-CODE
               GO TO 6990-MAIN-X
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE "CDESC START ERR MSTORERM" TO BU-DISPLAY-MSG
               GO TO 6990-MAIN-X.

014400     IF CDESC-DESC-OPTION = "F" OR "D" OR "K"
014500         PERFORM 6100-GET-KEYWORD THRU 6190-GK-X.
014600
014700     IF CDESC-DESC-OPTION = "F" OR "M"
014800         PERFORM 6200-GET-MANUFACT THRU 6290-GM-X.
014900
015000     IF CDESC-DESC-OPTION = "F" OR "D"
015100         PERFORM 6300-GET-DESC THRU 6390-GD-X.
015200
015300     MOVE SUB                      TO   CDESC-LINES-GOT.
015400
015500     GO TO 6990-MAIN-X.
015600
015700 6100-GET-KEYWORD.
      *------ FOR IBM WE CAN GO DIRECTLY TO THE CODE/ID NUM KEY
           MOVE "00" TO DESCIDNUM-WORK.
           PERFORM 9050-DIRECT-READ-DDESC THRU 9070-DRD-X.
      *--------07/17/97, IF KWRD/MOD NOT FOUND, USE SPACES
           IF COND-WORD NOT = 0
               IF CDESC-LANGUAGE-OPTION = "P"
                  PERFORM 9010-START-DDESC
               ELSE
                  PERFORM 9020-START-DDESC2
               END-IF
               MOVE SPACES TO DESC-DATA.

017900     ADD 1                         TO   SUB.
018000     MOVE "K"                      TO   CDESC-TYPE (SUB)
018100     MOVE SPACES                   TO   CDESC-MAN-SELCT (SUB)
018200     MOVE DESC-DATA                TO   CDESC (SUB).
018300
018400 6190-GK-X.
018500     EXIT.
018600
018700 6200-GET-MANUFACT.
018800     IF (SUB = CDESC-LINES-TO-GET) OR (SUB > CDESC-LINES-TO-GET)
018900         GO TO 6290-GM-X.
019000
019100*    CALL "DBFIND" USING BASE, DSET-DMANPART, MODE1,
019200*      STATUS-AREA, CODE-SEARCH, CODE-ARG.
           MOVE 0 TO COND-WORD.
           MOVE CODE-ARG TO CORPCDE OF DMANPART-REC.
           START DMANPART KEY = EXTERNALLY-DESCRIBED-KEY INVALID KEY
               MOVE 17 TO COND-WORD.
           IF COND-WORD = 17
               GO TO 6290-GM-X
           ELSE
019300     IF COND-WORD NOT = 0
019400         MOVE "CDESC DBFIND ERR DMAN 6200-GM" TO BU-DISPLAY-MSG
019500         GO TO 6990-MAIN-X.
019600
019700 6210-GET-MANUFACT-LOOP.
019800*---------- THE DMANPART SELECTION INDICATOR CAN BE THE
019900*---------- THE FOLLOWING:
020000*----------    P      PRIMARY LANGUAGE
020100*----------    S      SECONDARY LANGUAGE
020200*----------    B      BOTH LANGUAGES
020300*    CALL "DBGET" USING BASE, DSET-DMANPART, MODE5,
020400*      STATUS-AREA, ALL-ITEM-LIST, BUF-DMANPART, CODE-ARG.
           MOVE 0 TO COND-WORD.
           READ DMANPART NEXT INTO BUF-DMANPART AT END
               MOVE 15 TO COND-WORD.
           IF CORPCDE OF DMANPART-REC NOT = CODE-ARG
               MOVE 15 TO COND-WORD.
020500     IF COND-WORD = 15
020600         GO TO 6290-GM-X
020700     ELSE
020800     IF COND-WORD NOT = 0
020900         MOVE "CDESC DBGET ERR DMAN 6210-GML" TO BU-DISPLAY-MSG
021000         GO TO 6990-MAIN-X.
021100
021200*---------- IF ALL MANUFACTURERS ARE WANTED (OPT 'A'), LET THEM
021300*---------- ALL THRU.  IF ONLY SELECTED MANUFACTURERES ARE
021400*---------- WANTED (OPT 'S'), THEN IF THE SELECTION FOR THAT
021500*---------- MANUFACTURER IS BOTH LANGUAGES (INICATOR 'B'),
021600*---------- LET IT THRU.  BUT IF THE INDICATOR IS FOR ONLY
021700*---------- ONE LANGUAGE ('P' OR 'S'), LET IT THRU ONLY IF
021800*---------- THAT IS THE LANGUAGE BEING PRINTED (LANGUAGE OPTION).
021900     IF CDESC-MANUFACT-OPTION = "A"
022000         NEXT SENTENCE
022100     ELSE
022200     IF MAN-PARTNO-SELECT = "B"
022300         NEXT SENTENCE
022400     ELSE
022500     IF MAN-PARTNO-SELECT = CDESC-LANGUAGE-OPTION
022600         NEXT SENTENCE
022700     ELSE
022800         GO TO 6210-GET-MANUFACT-LOOP.
022900
023000     ADD 1                         TO   SUB.
023100     MOVE SPACES                   TO   CDESC-MFR-DATA (SUB).
023200     MOVE MAN-NAME                 TO   CDESC-MFR-NAME (SUB).
023300     MOVE MAN-PARTNO-TYPE          TO   CFINPTYP-TYPE-DB.
023400     CALL "CFINPTYP" USING CFINPTYP-PARMS.
023500     MOVE CFINPTYP-TYPE-SHORT      TO   CDESC-MFR-TYPE (SUB).
023600     MOVE "N"                      TO   CFINPTYP-1ST-CALL.
023700     MOVE MAN-PARTNO               TO   CDESC-MFR-PART (SUB).
023800     MOVE "M"                      TO   CDESC-TYPE (SUB).
023900     MOVE MAN-PARTNO-SELECT        TO   CDESC-MAN-SELCT (SUB).
024000
024100     IF (SUB = CDESC-LINES-TO-GET) OR (SUB > CDESC-LINES-TO-GET)
024200         GO TO 6290-GM-X
024300     ELSE
024400         GO TO 6210-GET-MANUFACT-LOOP.
024500
024600 6290-GM-X.
024700     EXIT.
024800
024900 6300-GET-DESC.
025000 6310-GET-DESC-LOOP.
025100     IF (SUB = CDESC-LINES-TO-GET) OR (SUB > CDESC-LINES-TO-GET)
025200         GO TO 6350-CHECK-LOCAL-DESC.
025300
 25400*    CALL "DBGET" USING BASE, DSET-DDESC, MODE5, STATUS-AREA,
025500*      ALL-ITEM-LIST, BUF-DDESC, CODE-ARG.
           MOVE 0 TO COND-WORD.
           IF CDESC-LANGUAGE-OPTION = "S"
               PERFORM 9040-READ-DDESC2
           ELSE
               PERFORM 9030-READ-DDESC.
025600     IF COND-WORD = 15
025700         GO TO 6350-CHECK-LOCAL-DESC
025800     ELSE
025900     IF COND-WORD NOT = 0
026000         MOVE "CDESC DBGET ERR DDESC 6310-GDL" TO BU-DISPLAY-MSG
026100         GO TO 6990-MAIN-X.
026200
026300     IF DESC-ID-NUM = "99"
026400         MOVE "Y"                  TO   FOUND-LOCAL-DESC-FLAG.
026500
026600     ADD 1                         TO   SUB.
026700     IF SUB > CDESC-LINES-TO-GET
026800         NEXT SENTENCE
026900     ELSE
027000         MOVE SPACES               TO   CDESC-TYPE (SUB)
027100         MOVE SPACES               TO   CDESC-MAN-SELCT (SUB)
027200         MOVE DESC-DATA            TO   CDESC (SUB).
027300     GO TO 6310-GET-DESC-LOOP.
027400
027500 6350-CHECK-LOCAL-DESC.
027600*---------- IF THE LOCAL DESCRIPTION IS REQUIRED IN THE RETURNED DESC,
027700*---------- AND IF IT HAS NOT YET BEEN FOUND, GET IT BY DOING A SINGLE
027800*---------- BACKWARD FIND ON THE CHAIN (LOCAL DESC, "99", WILL ALWAYS BE
027900*---------- LAST ON THE CHAIN)
028000     IF FOUND-LOCAL-DESC-FLAG = "Y"
028100         GO TO 6390-GD-X.
028200
028300     IF CDESC-LOCAL-DESC-OPTION = "R"
028400         NEXT SENTENCE
028500     ELSE
028600         GO TO 6390-GD-X.
028700
           MOVE "99" TO DESCIDNUM-WORK.
           PERFORM 9050-DIRECT-READ-DDESC THRU 9070-DRD-X.
           IF COND-WORD NOT = 0
               GO TO 6390-GD-X.

030800     MOVE SPACES      TO   CDESC-TYPE (CDESC-LINES-TO-GET).
030900     MOVE SPACES      TO   CDESC-MAN-SELCT (CDESC-LINES-TO-GET).
031000     MOVE DESC-DATA   TO   CDESC (CDESC-LINES-TO-GET).
031100
031200 6390-GD-X.
031300     EXIT.
031400
031500 6990-MAIN-X.
           IF CDESC-LANGUAGE-OPTION = "S"
               CLOSE DDESC2
           ELSE
               CLOSE DDESC.
           CLOSE DMANPART, MSTORERM.
031600     GOBACK.

       9000-READ-DDESC-LAST.
           IF CDESC-LANGUAGE-OPTION = "S"
               READ DDESC2 LAST RECORD AT END
                   MOVE 17 TO COND-WORD
           ELSE
               READ DDESC LAST RECORD AT END
                   MOVE 17 TO COND-WORD.

       9010-START-DDESC.
           MOVE CODE-ARG TO CORPCDE OF DDESC-REC.
           START DDESC KEY = CORPCDE OF DDESC-REC INVALID KEY
               MOVE 17 TO COND-WORD.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
                   MOVE 17 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.

       9020-START-DDESC2.
            MOVE CODE-ARG TO CORPCDE OF DDESC2-REC.
            START DDESC2 KEY = CORPCDE OF DDESC2-REC INVALID KEY
                MOVE 17 TO COND-WORD.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
                   MOVE 17 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.

       9030-READ-DDESC.
           MOVE 0 TO COND-WORD.
           READ DDESC NEXT INTO BUF-DDESC AT END
               MOVE 15 TO COND-WORD.
      *    IF CORPCDE OF DDESC-REC NOT = CODE-ARG
           IF DESC-CORP-CODE NOT = CODE-ARG
               MOVE 15 TO COND-WORD.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   MOVE 15 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.

       9040-READ-DDESC2.
           MOVE 0 TO COND-WORD.
           READ DDESC2 NEXT INTO BUF-DDESC AT END
               MOVE 15 TO COND-WORD.
      *    IF CORPCDE OF DDESC2-REC NOT = CODE-ARG
           IF DESC-CORP-CODE NOT = CODE-ARG
               MOVE 15 TO COND-WORD.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   MOVE 15 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.

       9050-DIRECT-READ-DDESC.
           IF CDESC-LANGUAGE-OPTION = "S"
               PERFORM 9060-DIRECT-READ-DDESC2
               GO TO 9070-DRD-X.
           MOVE DESCIDNUM-WORK TO DESCIDNUM OF DDESC-REC.
           MOVE 0 TO COND-WORD.
           MOVE CODE-ARG TO CORPCDE OF DDESC-REC.
           READ DDESC INTO BUF-DDESC
               INVALID KEY MOVE 17 TO COND-WORD.
           IF CODE-ARG NOT = DESC-CORP-CODE
               MOVE 17 TO COND-WORD.
           IF FILE-STATUS-1 = "2"
               MOVE 17 TO COND-WORD
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD.

           GO TO 9070-DRD-X.

       9060-DIRECT-READ-DDESC2.
           MOVE DESCIDNUM-WORK TO DESCIDNUM OF DDESC2-REC.
           MOVE 0 TO COND-WORD.
           MOVE CODE-ARG TO CORPCDE OF DDESC2-REC.
           READ DDESC2 INTO BUF-DDESC
               INVALID KEY MOVE 17 TO COND-WORD.
           IF CODE-ARG NOT = DESC-CORP-CODE
               MOVE 17 TO COND-WORD.
           IF FILE-STATUS-1 = "2"
               MOVE 17 TO COND-WORD
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD.

       9070-DRD-X.
           EXIT.
