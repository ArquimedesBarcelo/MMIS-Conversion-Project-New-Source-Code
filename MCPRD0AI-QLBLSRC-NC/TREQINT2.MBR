000200 IDENTIFICATION DIVISION.
000300 PROGRAM-ID. TREQINTF.
000400 ENVIRONMENT DIVISION.
000500 CONFIGURATION SECTION.
000600 SOURCE-COMPUTER.   AS400.
000700 OBJECT-COMPUTER.   AS400.
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT WO-PARTS-FILE
               ASSIGN TO DATABASE-MCFLMM1201
               ORGANIZATION IS INDEXED
               ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                   WITH DUPLICATES
               FILE STATUS IS WPFD-STATUS.
000800 DATA DIVISION.
       FILE SECTION.
       FD  WO-PARTS-FILE
           LABEL RECORDS ARE STANDARD
           DATA RECORD IS WPFDREC.
       01  WPFDREC.
           COPY DDS-ALL-FORMATS OF MCFLMM1201.
000900 WORKING-STORAGE SECTION.
001000 77  UPDATE-SW                    PIC 9.
001100 01  DBPARAMETERS.        COPY DBPARMS IN COPYLIB.
       01  KEY-HIGH                     PIC X(10).
002000 01  WO-PARTS-DATA.       COPY DWOPARTS IN COPYLIB.
       01  WPFD-STATUS                  PIC XX.
002100 LINKAGE SECTION.
002200 01  BASE-MMISA                   PIC X(24).
       COPY TREQINTF IN COPYLIB.
003500                          COPY DBSTAT  IN COPYLIB.
003600 PROCEDURE DIVISION USING BASE-MMISA, MMIS-REQ-STATUS-PARMS,
                            STATUS-AREA.
003700 START-PGM.
003800     PERFORM 1-HSK.
003900     PERFORM 6-MAIN THRU 6-MAIN-EXIT.
004000 2-EOJ.
           CLOSE WO-PARTS-FILE.
004200     GOBACK.
004300 1-HSK.
           OPEN I-O WO-PARTS-FILE.
005400     MOVE "OK" TO MMIS-ERR-STATUS.
005900     MOVE 0 TO UPDATE-SW.
006000     MOVE LOW-VALUES TO STATUS-AREA.
           MOVE HIGH-VALUES TO KEY-HIGH.
006200 6-MAIN.
           MOVE 0 TO COND-WORD.
005800     MOVE MMIS-WO-NO TO WONUM OF WPFDREC.
006300     START WO-PARTS-FILE KEY IS = EXTERNALLY-DESCRIBED-KEY
006400         INVALID KEY    MOVE 17 TO COND-WORD.
           IF WPFD-STATUS NOT = "00" MOVE 17 TO COND-WORD.
006500     IF COND-WORD = 17
006600         MOVE "WO" TO MMIS-ERR-STATUS
               MOVE KEY-HIGH TO WONUM OF WPFDREC
               START WO-PARTS-FILE KEY IS > EXTERNALLY-DESCRIBED-KEY
006700         GO TO 6-MAIN-EXIT.
006800 6-MAIN-CONT.
           MOVE 0 TO COND-WORD.
           READ WO-PARTS-FILE NEXT INTO WO-PARTS-DATA
               AT END    MOVE 17 TO COND-WORD.
           IF PRT-WO-NU NOT = MMIS-WO-NO MOVE 17 TO COND-WORD.
           IF WPFD-STATUS NOT = "00" MOVE 17 TO COND-WORD.
007100     IF COND-WORD = 17
007200         MOVE "PT" TO MMIS-ERR-STATUS
               MOVE KEY-HIGH TO WONUM OF WPFDREC
               START WO-PARTS-FILE KEY IS > EXTERNALLY-DESCRIBED-KEY
007300         GO TO 6-MAIN-EXIT.
007400     IF MMIS-CORP-CODE NOT = SPACES
007500         IF MMIS-CORP-CODE = PRT-NUM
007600             NEXT SENTENCE
007700         ELSE
007800         GO TO 6-MAIN-CONT
007900     ELSE
008000     IF MMIS-WO-ITM-NO = PRT-ITEM-NO
008100         NEXT SENTENCE
008200     ELSE
008300     GO TO 6-MAIN-CONT.
008400     IF MMIS-REQ-STATUS = "RS" OR "UR"
008500         PERFORM 60-RSV-UNRSV-ITEM
008600         GO TO 6-MAIN-EXIT.
008700     IF MMIS-REQ-STATUS = "CA"
008800         MOVE 1 TO UPDATE-SW
008900         MOVE SPACES TO MMIS-REQ-NO MMIS-PO-NUM
009000         MOVE "CANCEL" TO PRT-REQ-NO.
009100     IF MMIS-REQ-STATUS = "HD" OR "IP" GO TO 6-MAIN-EXIT.
009200     IF MMIS-REQ-NO = SPACES
009300         NEXT SENTENCE
009400     ELSE
009500     MOVE 1 TO UPDATE-SW
009600     MOVE MMIS-REQ-NO TO PRT-REQ-NO.
009700     IF MMIS-PO-NUM = SPACES
009800         NEXT SENTENCE
009900     ELSE
010000     MOVE 1 TO UPDATE-SW
010100     MOVE MMIS-PO-QTY TO PRT-ACT-QTY-9
010200     MOVE MMIS-PO-PRICE TO P-ACT-COST
010300     MOVE MMIS-PO-NUM TO PRT-PO-NO.
010400     IF UPDATE-SW = 1
               NEXT SENTENCE
           ELSE
           GO TO 6-MAIN-EXIT.
           MOVE 0 TO COND-WORD.
010000     REWRITE WPFDREC FROM WO-PARTS-DATA
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF WPFD-STATUS NOT = "00" MOVE 17 TO COND-WORD.
           IF COND-WORD = 17
               MOVE "PT" TO MMIS-ERR-STATUS.
010700 6-MAIN-EXIT.    EXIT.
010800 60-RSV-UNRSV-ITEM.
           MOVE 0 TO COND-WORD.
010300     DELETE WO-PARTS-FILE RECORD
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF WPFD-STATUS NOT = "00" MOVE 17 TO COND-WORD.
           IF COND-WORD = 17
               MOVE "PT" TO MMIS-ERR-STATUS
               GO TO 2-EOJ.
010400     IF MMIS-REQ-STATUS = "RS"
010500         MOVE "R" TO PRT-STATUS-1
010600     ELSE
010700     MOVE "S" TO PRT-STATUS-1.
010800     MOVE SPACES TO PRT-REQ-NO.
           MOVE 0 TO COND-WORD.
           WRITE WPFDREC FROM WO-PARTS-DATA
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF WPFD-STATUS NOT = "00" MOVE 17 TO COND-WORD.
011100     IF COND-WORD = 17
011200         MOVE "PT" TO MMIS-ERR-STATUS.
