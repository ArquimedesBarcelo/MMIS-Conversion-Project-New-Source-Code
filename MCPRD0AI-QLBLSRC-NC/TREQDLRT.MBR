       IDENTIFICATION DIVISION.
       PROGRAM-ID. TREQDLRT.
       AUTHOR.         CA YODER.
       INSTALLATION.   THE GOODYEAR TIRE AND RUBBER COMPANY - AKRON.
       DATE-WRITTEN.   JANUARY 1998.

      *D
      *D  THIS PROGRAM DELETES ALL REQUISITIONS RETURNED TO ORIGINATOR
      *D  AFTER A CERTAIN PERIOD OF TIME SPECIFIED IN MPLTINFO.
      *D
      *C
      *C  COMMENTS:
      *C

       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.
       SOURCE-COMPUTER.       IBM-AS400.
       OBJECT-COMPUTER.       IBM-AS400.
       COPY SPECIALN OF COPYLIB.

       INPUT-OUTPUT SECTION.
       FILE-CONTROL.

           SELECT MPLTINFO-I
                  ASSIGN TO DATABASE-MCFLCS0501
                  ORGANIZATION IS INDEXED
                  ACCESS IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                  FILE STATUS IS FILE-STATUS.

           SELECT MREQ
                  ASSIGN TO DATABASE-MCFLCS2001
                  ORGANIZATION IS INDEXED
                    ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                  FILE STATUS IS FILE-STATUS.

           SELECT DREQD
                  ASSIGN TO DATABASE-MCFLCS2101
                  ORGANIZATION IS INDEXED
                    ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                    WITH DUPLICATES
                  FILE STATUS IS FILE-STATUS.

           SELECT DREQITM
                  ASSIGN TO DATABASE-MCFLCS2201
                  ORGANIZATION IS INDEXED
                    ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                    WITH DUPLICATES
                  FILE STATUS IS FILE-STATUS.

           SELECT DREQDESC
                  ASSIGN TO DATABASE-MCFLCS2301
                  ORGANIZATION IS INDEXED
                    ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                    WITH DUPLICATES
                  FILE STATUS IS FILE-STATUS.

           SELECT DREQQUE
                  ASSIGN TO DATABASE-MCFLCS4401
                  ORGANIZATION IS INDEXED
                    ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                    WITH DUPLICATES
                  FILE STATUS IS FILE-STATUS.

           SELECT ONLINE-PRT ASSIGN TO PRINTER-MCPRT.

       DATA DIVISION.
       FILE SECTION.

       FD  MPLTINFO-I
           LABEL RECORDS ARE STANDARD.
       01  MPLTINFO-I-REC.
           COPY DDS-MCRPCS0500 OF MCFLCS0501.

       FD  MREQ
           LABEL RECORDS ARE STANDARD.
       01  MREQ-REC.
           COPY DDS-MCRPCS2000  OF MCFLCS2001.

       FD  DREQD
           LABEL RECORDS ARE STANDARD.
       01  DREQD-REC.
           COPY DDS-MCRPCS2100  OF MCFLCS2101.

       FD  DREQITM
           LABEL RECORDS ARE STANDARD.
       01  DREQITM-REC.
           COPY DDS-MCRPCS2200  OF MCFLCS2201.

       FD  DREQDESC
           LABEL RECORDS ARE STANDARD.
       01  DREQDESC-REC.
           COPY DDS-MCRPCS2300  OF MCFLCS2301.

       FD  DREQQUE
           LABEL RECORDS ARE STANDARD.
       01  DREQQUE-REC.
           COPY DDS-MCRPCS4400  OF MCFLCS4401.

       FD  ONLINE-PRT
           LABEL RECORDS ARE OMITTED
           RECORD CONTAINS 132 CHARACTERS
           DATA RECORD IS PRINT-RCD.
       01  PRINT-RCD.
           05  PRINT-LINE           PIC X(132).

       WORKING-STORAGE SECTION.
       77  DELETED-REQS-CTR      PIC 9(5) VALUE 0.
       77  LINE-CTR              PIC 99   VALUE 59.
       77  REQS-TO-DELETE-CTR    PIC 9(5) VALUE 0.
       77  SAVE-DEL-SW           PIC X    VALUE "N".
       77  SAVE-DEL-MTH          PIC 9(2) VALUE 0.

       01  FILE-STATUS.
           05  FILE-STATUS-1     PIC X.
           05  FILE-STATUS-2     PIC X.

       01  DETAIL-1.
           05  FILLER            PIC X(5)  VALUE SPACES.
           05  D-REQ             PIC X(12) VALUE SPACES.
           05  FILLER            PIC X(63) VALUE SPACES.

       01  HEADER-0.
           05  FILLER            PIC X(5)  VALUE SPACES.
           05  FILLER            PIC X(29)
               VALUE "REQUISITIONS DELETED FROM THE".
           05  FILLER            PIC X(33)
               VALUE " SYSTEM".
           05  FILLER            PIC X(5)  VALUE SPACES.
           05  H0-DATE.
               10  H0-MM         PIC XX    VALUE SPACES.
               10  FILLER        PIC X     VALUE "/".
               10  H0-DD         PIC XX    VALUE SPACES.
               10  FILLER        PIC X     VALUE "/".
               10  H0-YY         PIC XX    VALUE SPACES.

       01  HEADER-1.
           05  FILLER            PIC X(5)  VALUE SPACES.
           05  FILLER            PIC X(29)
               VALUE "REQUISITIONS RETURNED TO ORIG".
           05  FILLER            PIC X(18)
               VALUE "INATOR OLDER THAN ".
           05  FILLER            PIC X(2)  VALUE SPACES.
           05  H0-DATE.
               10  H1-MM         PIC XX    VALUE SPACES.
               10  FILLER        PIC X     VALUE "/".
               10  H1-DD         PIC XX    VALUE SPACES.
               10  FILLER        PIC X     VALUE "/".
               10  H1-YY         PIC XX    VALUE SPACES.

       01  HEADER-U.
           05  FILLER            PIC X(80) VALUE ALL "-".

       01  CUR-DATE-CN.
           05  CUR-DATE-CC         PIC X(2).
           05  CUR-DATE-YMD.
               10  CUR-DATE-YY     PIC X(2).
               10  CUR-DATE-MM     PIC X(2).
               10  CUR-DATE-DD     PIC X(2).

       01  CUR-DATE-R    REDEFINES   CUR-DATE-CN.
           05  CUR-DATE-YEAR       PIC 9(4).
           05  FILLER              PIC X(4).

       01  DEL-DATE-CN.
           05  DEL-DATE-CC         PIC 9(2).
           05  DEL-DATE-YMD.
               10  DEL-DATE-YY     PIC 9(2).
               10  DEL-DATE-MM     PIC 9(2).
               10  DEL-DATE-DD     PIC 9(2).

       01  DEL-DATE-R    REDEFINES   DEL-DATE-CN.
           05  DEL-DATE-YEAR       PIC 9(4).
           05  FILLER              PIC 9(4).

       COPY IOFEEDBACK IN COPYLIB.

       COPY OVRPFDATA  IN COPYLIB.

      **************************************************************
      **                DATABASE I/O BUFFER AREA                  **
      **************************************************************

       COPY MPLTINFO   IN COPYLIB.

       COPY MREQ       IN COPYLIB.

       COPY DREQD      IN COPYLIB.

       COPY DREQITM    IN COPYLIB.

       COPY DREQDESC   IN COPYLIB.

       COPY DREQQUE    IN COPYLIB.

       COPY DATAB      IN COPYLIB.

      **************************************************************
      **                   DATASET NAMES                          **
      **************************************************************

       01  DSET-NAMES.
           05  DSET-NAME              PIC X(16)  VALUE SPACES.
           05  DSET-MREQ              PIC X(16)  VALUE "MREQ;".
           05  DSET-DREQITM           PIC X(16)  VALUE "DREQITM;".
           05  DSET-DREQD             PIC X(16)  VALUE "DREQD;".
           05  DSET-DREQDESC          PIC X(16)  VALUE "DREQDESC;".
           05  DSET-DREQQUE           PIC X(16)  VALUE "DREQQUE;".

       01 ITEMS-LISTING.
           05  ALL-ITEMS              PIC XX    VALUE "@;".
           05  REQ-SEARCH             PIC X(11) VALUE "REQ-NUMBER;".

       01 ARG-VALUES.
           05  REQ-ARG                PIC X(12) VALUE SPACES.
           05  PLT-ARG                PIC X(4)  VALUE SPACES.

       COPY MULTLOCK  IN COPYLIB.

       COPY TBLOWUP   IN COPYLIB.

      **************************************************************
      **                PROCEDURE DIVISION                        **
      **************************************************************

       PROCEDURE DIVISION.

       BEGIN-HERE.
           PERFORM 1-HSK THRU 1-H-X.
           IF SAVE-DEL-SW = "Y" AND SAVE-DEL-MTH > 0
               PERFORM 6-MAIN  THRU 6-M-X
           ELSE
               DISPLAY "*PARMS NOT SET IN MPLTINFO--NO REQS DELETED*".

       2-EOJ.
           CLOSE MPLTINFO-I, MREQ, DREQD, DREQITM, DREQDESC, DREQQUE.
           CLOSE ONLINE-PRT.
           GOBACK.

       1-HSK.
           OPEN INPUT    MPLTINFO-I

                I-O      MREQ       DREQD
                         DREQITM    DREQDESC    DREQQUE

                OUTPUT   ONLINE-PRT.

           ACCEPT CUR-DATE-YMD  FROM  DATE.
           IF CUR-DATE-YY > "70"
               MOVE "19"      TO  CUR-DATE-CC
           ELSE
               MOVE "20"      TO  CUR-DATE-CC.

           MOVE CUR-DATE-MM    TO H0-MM.
           MOVE CUR-DATE-DD    TO H0-DD.
           MOVE CUR-DATE-YY    TO H0-YY.
           MOVE 59 TO LINE-CTR.

           MOVE "PREQ" TO PLT-ARG.
           MOVE PLT-ARG TO PLTINFOKEY OF MPLTINFO-I-REC.
           READ MPLTINFO-I INTO BUF-MPLTINFO
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE "DBGET MPLTINFO 1-HSK PDER"  TO  BU-DISPLAY-MSG
               MOVE PLT-ARG                TO  BU-DISPLAY-FLD (1)
               GO TO 2-BLOWUP.
           MOVE MPLTINFO-REQ-DEL-SW        TO  SAVE-DEL-SW.
           IF MPLTINFO-REQ-DEL-MTH NOT NUMERIC
               MOVE 0                      TO  SAVE-DEL-MTH
           ELSE
               MOVE MPLTINFO-REQ-DEL-MTH   TO  SAVE-DEL-MTH.

      *------- DO A START > HIGH-VALUES TO UNLOCK
           MOVE HIGH-VALUES TO PLTINFOKEY OF MPLTINFO-I-REC
           START MPLTINFO-I KEY > PLTINFOKEY OF MPLTINFO-I-REC
               INVALID KEY MOVE "00" TO FILE-STATUS.

       1-H-X.
           EXIT.

      *********************************************
      *                                           *
      *  BLOWUP ROUTINE EXECUTES WHENEVER A       *
      *  FATAL ERROR OCCURS                       *
      *                                           *
      *********************************************

       2-BLOWUP.
           MOVE "TREQDLRT"  TO  BU-PGM-NAME.
           CALL "TBLOWUP" USING BASE, BU-PGM-NAME, STATUS-AREA,
               DUMMY-VIEW-AREA, DUMMY-KSAM-STAT, BU-DISPLAY-MSG,
                       BU-DISPLAY-FLDS.

       6-MAIN.

           MOVE CUR-DATE-CN       TO  DEL-DATE-CN.
           PERFORM UNTIL DEL-DATE-MM > SAVE-DEL-MTH
               SUBTRACT 1         FROM DEL-DATE-YEAR
               ADD 12             TO DEL-DATE-MM
           END-PERFORM.
           SUBTRACT SAVE-DEL-MTH  FROM  DEL-DATE-MM.
           DISPLAY "DEL-DATE-CN:  " DEL-DATE-CN.
           MOVE DEL-DATE-MM       TO H1-MM.
           MOVE DEL-DATE-DD       TO H1-DD.
           MOVE DEL-DATE-YY       TO H1-YY.

           PERFORM 61-GET-REQS-TO-DELETE  THRU  61-GRTD-X.

           DISPLAY "REQS-TO-DELETE-CTR:  " REQS-TO-DELETE-CTR.
           DISPLAY "DELETED-REQS-CTR:  " DELETED-REQS-CTR.

       6-M-X.
           EXIT.

      *************************************************
      *                                               *
      *   SERIAL GET OF MREQ (MODE2)                  *
      *                                               *
      *************************************************

       61-GET-REQS-TO-DELETE.
           MOVE 0 TO COND-WORD.
           READ MREQ NEXT INTO BUF-MREQ
               AT END MOVE 11 TO COND-WORD.
           IF FILE-STATUS NOT = "00" MOVE 11 TO COND-WORD.
           IF COND-WORD NOT = 0
               IF COND-WORD = 11
                   GO TO 61-GRTD-X
               ELSE
               MOVE MREQ-NUMBER  TO  BU-DISPLAY-FLD (1)
               MOVE "DBGET 61-GRTD"  TO  BU-DISPLAY-MSG
               GO TO 2-BLOWUP.

      **************************************************
      *                                                *
      *   CHECK TO SEE IF REQ. HAS BEEN RETURNED TO    *
      *   ORIGINATOR AND MEETS DATE CRITERIA.          *
      *                                                *
      **************************************************

           IF REQ-HOLD-STATUS-CODE NOT = "RT"
               GO TO 61-GET-REQS-TO-DELETE.

           IF REQ-DATE-RETURN-CN > DEL-DATE-CN
               GO TO 61-GET-REQS-TO-DELETE.

           IF REQ-PURCH-RELEASE  =  "X"
               GO TO 61-GET-REQS-TO-DELETE.

           MOVE MREQ-NUMBER  TO  REQ-ARG, BU-DISPLAY-FLD (1).
           ADD 1 TO REQS-TO-DELETE-CTR.
           DISPLAY "**** REQ WILL BE DELETED:  " MREQ-NUMBER.
           PERFORM 62-DELETE-REQ  THRU  62-DR-X.

           GO TO 61-GET-REQS-TO-DELETE.

       61-GRTD-X.
           EXIT.

       62-DELETE-REQ.

           MOVE REQ-ARG TO REQNO OF MREQ-REC.
           READ MREQ INTO BUF-MREQ
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE "GET MREQ 62-LRS" TO BU-DISPLAY-MSG
               GO TO 2-BLOWUP.

       62-DELETE-DREQD-SEGS.
           MOVE 0       TO COND-WORD.
           MOVE REQ-ARG TO REQNO OF DREQD-REC.
           START DREQD KEY = REQNO OF DREQD-REC
               INVALID KEY    MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
                   GO TO 62-DELETE-DREQITM-SEGS
               ELSE
               MOVE "DELETE DREQD SEGS" TO BU-DISPLAY-MSG
               GO TO 2-BLOWUP.

           PERFORM 620-DELETE-DREQD  THRU  620-DD-X
               UNTIL COND-WORD = 15.

       62-DELETE-DREQITM-SEGS.
           MOVE 0 TO COND-WORD.
           MOVE REQ-ARG TO REQNO OF DREQITM-REC.
           START DREQITM KEY = REQNO OF DREQITM-REC
               INVALID KEY    MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
                   GO TO 62-DELETE-DREQDESC-SEGS
               ELSE
               MOVE "DELETE DREQITM SEGS" TO BU-DISPLAY-MSG
               GO TO 2-BLOWUP.

           PERFORM 621-DELETE-DREQITM THRU 621-DD-X
               UNTIL COND-WORD = 15.

       62-DELETE-DREQDESC-SEGS.
           MOVE 0 TO COND-WORD.
           MOVE REQ-ARG TO REQNO OF DREQDESC-REC.
           START DREQDESC KEY = REQNO OF DREQDESC-REC
               INVALID KEY    MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
                   GO TO 62-DELETE-DREQQUE-SEGS
               ELSE
               MOVE "DELETE DREQDESC SEGS" TO BU-DISPLAY-MSG
               GO TO 2-BLOWUP.

           PERFORM 622-DELETE-DREQDESC  THRU  622-DD-X
               UNTIL COND-WORD = 15.

       62-DELETE-DREQQUE-SEGS.
           MOVE 0 TO COND-WORD.
           MOVE REQ-ARG TO REQNO OF DREQQUE-REC.
           START DREQQUE KEY = REQNO OF DREQQUE-REC
               INVALID KEY    MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
                   GO TO 62-DELETE-MREQ
               ELSE
               MOVE "DELETE DREQQUE SEGS" TO BU-DISPLAY-MSG
               GO TO 2-BLOWUP.

           PERFORM 623-DELETE-DREQQUE THRU 623-DD-X
               UNTIL COND-WORD = 15.

       62-DELETE-MREQ.
           DELETE MREQ
           IF FILE-STATUS NOT = "00"
               MOVE "DELETE MREQ SEGS" TO BU-DISPLAY-MSG
               GO TO 2-BLOWUP.
           ADD 1 TO DELETED-REQS-CTR.
           MOVE REQ-ARG TO D-REQ.
           ADD 1 TO LINE-CTR.
           IF LINE-CTR > 59
               WRITE PRINT-RCD FROM HEADER-0 AFTER ADVANCING NEW-PAGE
               WRITE PRINT-RCD FROM HEADER-1 AFTER ADVANCING 1 LINE
               WRITE PRINT-RCD FROM HEADER-U AFTER ADVANCING 1 LINES
               WRITE PRINT-RCD FROM DETAIL-1 AFTER ADVANCING 1 LINES
               MOVE 3 TO LINE-CTR
           ELSE
           WRITE PRINT-RCD FROM DETAIL-1 AFTER ADVANCING 1 LINES.

       62-DR-X.     EXIT.

       620-DELETE-DREQD.
           MOVE 0 TO COND-WORD.
           READ DREQD NEXT INTO BUF-DREQD
               AT END    MOVE 15 TO COND-WORD.
           IF FILE-STATUS NOT = "00" MOVE 15 TO COND-WORD.
           IF DREQD-REQ-NUMBER NOT = REQ-ARG MOVE 15 TO COND-WORD.
           IF COND-WORD NOT = 0
               IF COND-WORD = 15
                   NEXT SENTENCE
               ELSE
                   MOVE "GET DREQD 620-DD" TO BU-DISPLAY-MSG
                   GO TO 2-BLOWUP
           ELSE
           DELETE DREQD
           IF FILE-STATUS NOT = "00"
               MOVE "DELETE DREQD" TO BU-DISPLAY-MSG
               GO TO 2-BLOWUP.

       620-DD-X.    EXIT.

       621-DELETE-DREQITM.
           MOVE 0 TO COND-WORD.
           READ DREQITM NEXT INTO BUF-DREQITM
               AT END    MOVE 15 TO COND-WORD.
           IF FILE-STATUS NOT = "00" MOVE 15 TO COND-WORD.
           IF REQITM-REQ-NUMBER NOT = REQ-ARG MOVE 15 TO COND-WORD.
           IF COND-WORD NOT = 0
               IF COND-WORD = 15
                   NEXT SENTENCE
               ELSE
                   MOVE "GET DREQITM 621-DD" TO BU-DISPLAY-MSG
                   GO TO 2-BLOWUP
           ELSE
           DELETE DREQITM
           IF FILE-STATUS NOT = "00"
               MOVE "DELETE DREQITM" TO BU-DISPLAY-MSG
               GO TO 2-BLOWUP.
       621-DD-X.    EXIT.

       622-DELETE-DREQDESC.
           MOVE 0 TO COND-WORD.
           READ DREQDESC NEXT INTO BUF-DREQDESC
               AT END    MOVE 15 TO COND-WORD.
           IF FILE-STATUS NOT = "00" MOVE 15 TO COND-WORD.
           IF REQDESC-REQ-NUMBER NOT = REQ-ARG MOVE 15 TO COND-WORD.
           IF COND-WORD NOT = 0
               IF COND-WORD = 15
                   NEXT SENTENCE
               ELSE
                   MOVE "GET DREQDESC 622-DD" TO BU-DISPLAY-MSG
                   GO TO 2-BLOWUP
           ELSE
           DELETE DREQDESC
           IF FILE-STATUS NOT = "00"
               MOVE "DELETE DREQDESC" TO BU-DISPLAY-MSG
               GO TO 2-BLOWUP.
       622-DD-X.    EXIT.

       623-DELETE-DREQQUE.
           MOVE 0 TO COND-WORD.
           READ DREQQUE NEXT INTO BUF-DREQQUE
               AT END    MOVE 15 TO COND-WORD.
           IF FILE-STATUS NOT = "00" MOVE 15 TO COND-WORD.
           IF DRQQ-REQ-NUMBER NOT = REQ-ARG MOVE 15 TO COND-WORD.
           IF COND-WORD NOT = 0
               IF COND-WORD = 15
                   NEXT SENTENCE
               ELSE
                   MOVE "GET DREQQUE 623-DD" TO BU-DISPLAY-MSG
                   GO TO 2-BLOWUP
           ELSE
           DELETE DREQQUE
           IF FILE-STATUS NOT = "00"
               MOVE "DELETE DREQQUE" TO BU-DISPLAY-MSG
               GO TO 2-BLOWUP.
       623-DD-X.    EXIT.

       COPY OVRPFCALL IN COPYLIB.
