       IDENTIFICATION DIVISION.
       PROGRAM-ID.             SPMSCRWS.
       AUTHOR.                 W. ROXBURY.
      *REMARKS.                CRAFTSMAN WORKSHEET.

      *C****************************************************************
      *C   5/13/93.  M.L.MITCHELL REQUEST #6308
      *C     ADDED LOGIC TO CHANGE CRAFTMAN'S WORKSHEET TO PRINT
      *C     WORKORDER ONLY ON PAGE ONE ALONG WITH A LIST OF THE
      *C     CRAFTS REQUIRED FOR THE JOBPLAN AND EACH CRAFT'S
      *C     SECTION WILL INCLUDE ONLY CERTAIN KEY DATA FROM THE
      *C     WORKORDER AT THE BEGINNING OF THE SORTED TASK LISTS.
      *C****************************************************************
      *C  5/10/95  -  W. ROXBURY
      *C  CHANGED PAGE HEADER INFORMATION PER DANVILLE PM LIST
      *C****************************************************************

       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.
       SOURCE-COMPUTER.        IBM-AS400.
       OBJECT-COMPUTER.        IBM-AS400.
       SPECIAL-NAMES.          C01 IS NEW-PAGE
                               I-O-FEEDBACK IS I-O-FEEDBACK-AREA.

       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT DISPLAY-FILE
                  ASSIGN       TO WORKSTATION-ZPMMAINT-SI
                  ORGANIZATION IS TRANSACTION
                  ACCESS MODE  IS SEQUENTIAL
                  FILE STATUS  IS DISPLAY-STATUS
                  CONTROL-AREA IS WS-CONTROL.

           SELECT PER-PERSONNEL
                  ASSIGN       TO DATABASE-MCFLMM0301
                  ORGANIZATION IS SEQUENTIAL
                  ACCESS MODE  IS SEQUENTIAL
                  FILE STATUS  IS FILE-STATUS.

           SELECT PM-JOBPLAN
                  ASSIGN       TO DATABASE-MCFLMM4101
                  ORGANIZATION IS INDEXED
                  ACCESS MODE  IS DYNAMIC
                  RECORD KEY   IS EXTERNALLY-DESCRIBED-KEY
                  FILE STATUS  IS FILE-STATUS.

           SELECT PM-JOBPLAN-KEYS
                  ASSIGN       TO DATABASE-MCFLMM4002
                  ORGANIZATION IS INDEXED
                  ACCESS MODE  IS DYNAMIC
                  RECORD KEY   IS EXTERNALLY-DESCRIBED-KEY
                  FILE STATUS  IS FILE-STATUS.

           SELECT WO-PLANNED
                  ASSIGN       TO DATABASE-MCFLMM1101
                  ORGANIZATION IS INDEXED
                  ACCESS MODE  IS DYNAMIC
                  RECORD KEY   IS EXTERNALLY-DESCRIBED-KEY
                  FILE STATUS  IS FILE-STATUS.

           SELECT CH-PRINT-FILE
                  ASSIGN       TO PRINTER-MCPRT
                  FILE STATUS  IS FILE-STATUS.

           SELECT OUT-FILE
                  ASSIGN       TO DISK-OPMSCRWS
                  ORGANIZATION IS RELATIVE
                  ACCESS MODE  IS DYNAMIC
                  RELATIVE KEY IS ACT-KEY
                  FILE STATUS  IS FILE-STATUS.

           SELECT SORT-FILE
                  ASSIGN       TO DISK-SORTFILE.

       DATA DIVISION.
       FILE SECTION.
       FD  DISPLAY-FILE
           LABEL RECORDS ARE OMITTED.
       01  DISPLAY-REC         PIC X(2000).

       FD  PER-PERSONNEL
           LABEL RECORDS ARE STANDARD.
       01  PER-PERSONNEL-REC.
           COPY DDS-ALL-FORMATS OF MCFLMM0301.

       FD  PM-JOBPLAN
           LABEL RECORDS ARE STANDARD.
       01  PM-JOBPLAN-REC.
           COPY DDS-ALL-FORMATS OF MCFLMM4101.

       FD  PM-JOBPLAN-KEYS
           LABEL RECORDS ARE STANDARD.
       01  PM-JOBP-KEYS-REC.
           COPY DDS-ALL-FORMATS OF MCFLMM4002.

       FD  WO-PLANNED
           LABEL RECORDS ARE STANDARD.
       01  WO-PLANNED-REC.
           COPY DDS-ALL-FORMATS OF MCFLMM1101.

       FD  CH-PRINT-FILE
           LABEL RECORD IS OMITTED
           RECORD CONTAINS 132 CHARACTERS.
       01  CH-PRINT-RECORD.
           05  CH-CARRIAGE-CTL PIC X.
           05  CH-PRINT-AREA   PIC X(131).

       FD  OUT-FILE RECORD CONTAINS 200 CHARACTERS
           LABEL RECORDS ARE OMITTED
           DATA RECORD IS OUT-REC.
       01  OUT-REC.
           05  OUT-KEY         PIC X(18).
           05  OUT-CRAFT       PIC X(02).
           05  OUT-DATA        PIC X(180).

       SD  SORT-FILE RECORD CONTAINS 200 CHARACTERS
           DATA RECORD IS SORT-REC.
       01  SORT-REC.
           05  SORT-KEY.
               10  SORT-KEY-NAME      PIC X(10).
               10  SORT-KEY-SEQ-LINE  PIC X(08).
           05  SORT-CRAFT             PIC XX.
           05  SORT-DATA              PIC X(180).

       WORKING-STORAGE SECTION.
       77  ACT-KEY             PIC 9(4).
       77  ASTERISK-LINE       PIC X(85) VALUE ALL "*".
       77  BOX-VALUE           PIC X(16) VALUE "( ) ( ) ( ) ( ) ".
       77  COMP-VALUE          PIC X(50)
           VALUE "                                                 >".
       77  CRAFT-SAVE          PIC XX.
       77  DISPLAY-SW          PIC 9  VALUE 0.
           88  DISPLAY-ON             VALUE 1.
       77  EJECT-SW            PIC 9  VALUE 0.
           88  EJECT-ON               VALUE 1.
       77  FIRST-SW            PIC 9  VALUE 0.
       77  LINE-CTR            PIC 99 VALUE 0.
       77  LINES-LINE          PIC X(85) VALUE ALL "=".
       77  MAX-KEY             PIC 9(4).
       77  NAME-BUF            PIC X(10).
       77  NUM-COPIES          PIC S99 COMP VALUE 1.
       77  PAGE-CTR            PIC 99 VALUE 0.
       77  PRTY                PIC S9  COMP VALUE 0.
       77  RET-CODE            PIC XX.
       77  RETURN-COD          PIC XX.
       77  RTN-STATUS          PIC S9  COMP VALUE 0.
       77  RTN-ERR-MSG         PIC X(75) VALUE SPACES.
       77  SAVE-JOBPSEQ        PIC 9999 VALUE 0.
       77  SELECT-LEVEL        PIC 99 VALUE 0.
       77  YEAR-BUF            PIC X.
       77  BASE                PIC X(24).

