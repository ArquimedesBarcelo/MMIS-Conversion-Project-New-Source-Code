           COPY CMANREQ        IN COPYLIB.

           COPY ESCNAM2        IN COPYLIB.

           COPY TBLOWUP        IN COPYLIB.

           COPY CDESC          IN COPYLIB.

           COPY DBSTAT         IN COPYLIB.

           COPY TDATESUB       IN COPYLIB.

       01  MESSAGE-FILE-DATA.  COPY ERRORLIN IN COPYLIB.

       01  WO-MATL-USED-DATA.  COPY DWOPARTS IN COPYLIB.

       01  PERSONNEL-DATA.     COPY MPERSONL IN COPYLIB.

       01  LAST-WO-BUFF.       COPY MLASTWO  IN COPYLIB.

       01  JOBPLAN-BUFFER.     COPY DJOBPLAN IN COPYLIB.

       01  PM-JOBPLAN-DATA.    COPY DPMJBPLN IN COPYLIB.

       01  PM-JP-KEY-DATA.     COPY DPMJBKEY IN COPYLIB.

       LINKAGE SECTION.
       01  DBPARAMETERS.       COPY DBPARMS  IN COPYLIB.

       01  WO-PLANNED-DATA.    COPY DWOPLAN  IN COPYLIB.

           COPY VCOMLINK       IN COPYLIB.

           COPY LANGSUB        IN COPYLIB.

       01  ERROR-BUFFER        PIC X(76).

       PROCEDURE DIVISION      USING DBPARAMETERS
                               WO-PLANNED-DATA
                               VIEW-COMAREA
                               LANGUAGE-PARMS
                               ERROR-BUFFER.
       1-START-PGM SECTION 01.
       START-PGM.
           ACCEPT CHECK-YEAR   FROM DATE.
           IF CHECK-YEAR-NUM = 0
               MOVE "A"        TO YEAR-BUF
           ELSE
           IF CHECK-YEAR-NUM = 1
               MOVE "B"        TO YEAR-BUF
           ELSE
           IF CHECK-YEAR-NUM = 2
               MOVE "C"        TO YEAR-BUF
           ELSE
           IF CHECK-YEAR-NUM = 3
               MOVE "D"        TO YEAR-BUF
           ELSE
           IF CHECK-YEAR-NUM = 4
               MOVE "E"        TO YEAR-BUF
           ELSE
           IF CHECK-YEAR-NUM = 5
               MOVE "F"        TO YEAR-BUF
           ELSE
           IF CHECK-YEAR-NUM = 6
               MOVE "G"        TO YEAR-BUF
           ELSE
           IF CHECK-YEAR-NUM = 7
               MOVE "H"        TO YEAR-BUF
           ELSE
           IF CHECK-YEAR-NUM = 8
               MOVE "J"        TO YEAR-BUF
           ELSE
           IF CHECK-YEAR-NUM = 9
               MOVE "K"        TO YEAR-BUF.

           CALL "CLWHO"        USING USERNAME TERMNUM CURLIB JOBLIBX.

           MOVE DATE-FLAG      TO DATE-CODE.
           MOVE SPACES         TO CRAFT-TABLE.
           MOVE 0              TO DISPLAY-SW EJECT-SW CRAFT-INDEX
                               ACT-KEY PAGE-CTR SELECT-LEVEL.
           MOVE "00"           TO FILE-STATUS.

           CALL "TESCSEQ"      USING ESC-NAME.

           CALL "CLPMSCRWS".

           OPEN I-O            DISPLAY-FILE.
           OPEN INPUT          PER-PERSONNEL
                               PM-JOBPLAN
                               PM-JOBPLAN-KEYS
                               WO-PLANNED.

       6-MAIN.
      *    MOVE 0              TO OVRPRTF-TOFILE-NUM.
           MOVE "P "           TO OVRPRTF-TOFILE-NUM-X.
           MOVE "MCPRT"        TO OVRPRTF-FILE.
           PERFORM 996-OVERRIDE-PRINT-FILE.
           OPEN OUTPUT         CH-PRINT-FILE.

           IF WO-NUM-PLANNED = SPACES
               MOVE 1          TO DISPLAY-SW
               PERFORM 60-REQUEST-WORK-ORDER THRU 60-RWO-EXIT
               MOVE WO-NUMBER  TO PMWONO DT2-WO
           ELSE
               MOVE 0          TO DISPLAY-SW
               MOVE WO-NUM-PLANNED TO WO-NUMBER PMWONO DT2-WO.

           MOVE 1              TO DATE-MODE.
           MOVE PAGE-CTR       TO ZPAGE.
           MOVE DATE-FLAG      TO DATE-CODE.
           CALL "TDATECHK"     USING DATE-CHECK-AREA.
           MOVE DATE-SLASH-OUT TO PL-DAT.

           ACCEPT TIME-BUF     FROM TIME.
           MOVE HRS            TO TIME-H.
           MOVE MIN            TO TIME-M.
           MOVE SEC            TO TIME-S.
           MOVE TIME-EXP       TO PL-TIM.

           PERFORM 61-PRINT-WO THRU 61-PW-EXIT.

           MOVE SPACES         TO ERROR-BUFFER.
           PERFORM 62-PRINT-JOBPLAN THRU 62-PJ-EXIT.
           IF ERROR-BUFFER NOT = SPACES
               GO TO 2-EOJ.

           MOVE ASTERISK-LINE  TO CH-PRINT-RECORD.
           WRITE CH-PRINT-RECORD AFTER ADVANCING 1 LINES.

           CLOSE               CH-PRINT-FILE.
           CLOSE               OUT-FILE.

           IF DISPLAY-ON
               MOVE SPACES     TO WO-NUM-PLANNED
                                  CRAFT-TABLE
               MOVE ZEROS      TO CRAFT-INDEX
               GO TO 6-MAIN
           ELSE
               GO TO 2-EOJ-END.

       2-EOJ.
           CLOSE               CH-PRINT-FILE
                               DISPLAY-FILE
                               PER-PERSONNEL
                               PM-JOBPLAN
                               PM-JOBPLAN-KEYS
                               WO-PLANNED.

       2-EOJ-END.
           GOBACK.

       60-REQUEST-WORK-ORDER.
           MOVE "VPMCRWS"      TO VIEW-NFNAME.
           MOVE SPACES         TO SCREEN-BUFFER.
           MOVE YEAR-BUF       TO WONUMY.

       60-SHOWFORM.
           PERFORM 999-SHOWFORM.
           IF VIEW-LASTKEY = 3 OR 8
               GO TO 2-EOJ.

           IF VIEW-LASTKEY = 1 OR 2 OR 4 OR 5 OR 6 OR 7
               GO TO 60-SHOWFORM.

           IF WO-NUM-NO = SPACES
               GO TO 60-SHOWFORM.

           IF WO-SUFF-NO NOT NUMERIC
      *M********************************************************************
      *M    MESSAGE 045/053:
      *M  SUFFIX FIELD IS REQUIRED FOR PM WORKORDERS - '000' IS PM MASTER
      *M********************************************************************
               MOVE  45        TO LANG-SETNUM
               MOVE 153        TO LANG-MSGNUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE B"1"       TO IND (3)  IND (99)
               GO TO 60-SHOWFORM.

           MOVE "0"            TO RETURN-COD.
           CALL "TALWONO"      USING WO-NUMBER RETURN-COD.
           IF RETURN-COD = "1"
               MOVE "0"        TO RETURN-COD
      *M********************************************************************
      *M    MESSAGE 035/040:
      *M INVALID WORKORDER NUMBER
      *M********************************************************************
               MOVE  35        TO LANG-SETNUM
               MOVE  40        TO LANG-MSGNUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE B"1"       TO IND (99)
               GO TO 60-SHOWFORM.

           MOVE WO-NUMBER      TO WONUM OF WO-PLANNED.
           READ WO-PLANNED     INTO WO-PLANNED-DATA
               INVALID KEY     MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
      *M********************************************************************
      *M    MESSAGE 029/034:
      *M CANNOT FIND WORK ORDER IN PLANNED FILE
      *M********************************************************************
               MOVE  29        TO LANG-SETNUM
               MOVE  34        TO LANG-MSGNUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE B"1"       TO IND (99)
               GO TO 60-SHOWFORM.

           IF WO-START-STATUS NOT = "AA"
      **********************************************************************
      **    MESSAGE 049/053:
      ** WORKORDER IS NOT DESIGNATED AS A `PM' WORKORDER
      **********************************************************************
               MOVE  49        TO LANG-SETNUM
               MOVE  53        TO LANG-MSGNUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE B"1"       TO IND (1)  IND (99)
               GO TO 60-SHOWFORM.

       60-RWO-EXIT.            EXIT.

       61-PRINT-WO.
           IF WO-NUM-SUFF-P = "000"
               NEXT SENTENCE
           ELSE
               MOVE DESCRIPTION-1-P TO LEVEL-MSG
               IF FL-1 = SPACE
                   MOVE "0"    TO FL-1
                   MOVE FLAG-LEVEL TO SELECT-LEVEL
                   ADD 1           TO SELECT-LEVEL
               ELSE
                   MOVE FLAG-LEVEL TO SELECT-LEVEL
                   ADD 1           TO SELECT-LEVEL.

           ADD  1              TO PAGE-CTR.
           MOVE PAGE-CTR       TO ZPAGE.
           MOVE HEADER-DT      TO CH-PRINT-RECORD.
           WRITE CH-PRINT-RECORD AFTER ADVANCING NEW-PAGE.
           MOVE LINES-LINE     TO CH-PRINT-RECORD.
           WRITE CH-PRINT-RECORD AFTER ADVANCING 1 LINES.
           MOVE PL-HEADER0     TO CH-PRINT-RECORD.
           WRITE CH-PRINT-RECORD AFTER ADVANCING 1 LINES.
           MOVE LINES-LINE     TO CH-PRINT-RECORD.
           WRITE CH-PRINT-RECORD AFTER ADVANCING 1 LINES.
           MOVE WO-NUM-P       TO PL-WO-7.
           MOVE WO-NUM-SUFF-P  TO PL-WO-S.
           MOVE WO-STATUS-P    TO PL-ST.
           MOVE WO-START-STATUS TO PL-TY.
           MOVE REQUESTER-P    TO PL-REQ.
           MOVE PL-LINE-1      TO CH-PRINT-RECORD.
           WRITE CH-PRINT-RECORD AFTER ADVANCING 1 LINES.

           MOVE EQUIP-NUM-P    TO PL-EQP
                                  HT2-EQP
                                  DT2-EQP.
           MOVE DEPT-P         TO PL-DEPT.
           MOVE ZONE-P         TO PL-ZONE.
           MOVE LOCATION-P     TO PL-LOC.
           MOVE PRIORITY-P     TO PL-PRTY.
           MOVE RIME-P         TO PL-RIME.
           MOVE PL-LINE-2      TO CH-PRINT-RECORD.
           WRITE CH-PRINT-RECORD AFTER ADVANCING 1 LINES.

           MOVE EQUIP-NAME-P   TO PL-ENAM.
           MOVE TYPE-NUM-P     TO PL-TYPE.
           MOVE PL-LINE-3      TO CH-PRINT-RECORD.
           WRITE CH-PRINT-RECORD AFTER ADVANCING 1 LINES.
           MOVE EQUIP-DOWN-P   TO PL-EDWN.
           MOVE EXP-CLASS-P    TO PL-EXP.

           IF DATE-REQD = "      "
               MOVE DATE-REQD  TO PL-REQD-DATE
           ELSE
           MOVE 4              TO DATE-MODE
           MOVE DATE-REQD      TO DATE-VALIDATE-IN
           CALL "TDATECHK" USING DATE-CHECK-AREA
           MOVE DATE-SLASH-OUT TO PL-REQD-DATE.

           MOVE TIME-REQD-P-HH TO PL-HH.
           MOVE TIME-REQD-P-MM TO PL-MI.
           MOVE PL-LINE-4      TO CH-PRINT-RECORD.
           WRITE CH-PRINT-RECORD AFTER ADVANCING 1 LINES.
           MOVE DESCRIPTION-1-P TO PL-DESC.
           MOVE PL-LINE-5      TO CH-PRINT-RECORD.
           WRITE CH-PRINT-RECORD AFTER ADVANCING 1 LINES.
           MOVE DESCRIPTION-2-1-P TO PL-DES2.
           MOVE PL-LINE-6      TO CH-PRINT-RECORD.
           WRITE CH-PRINT-RECORD AFTER ADVANCING 1 LINES.
           MOVE DESCRIPTION-2-2-P TO PL-DES3.
           MOVE PL-LINE-7      TO CH-PRINT-RECORD.
           WRITE CH-PRINT-RECORD AFTER ADVANCING 1 LINES.
           MOVE DESCRIPTION-3-1-P TO PL-DES4.
           MOVE PL-LINE-8      TO CH-PRINT-RECORD.
           WRITE CH-PRINT-RECORD AFTER ADVANCING 1 LINES.
           MOVE DESCRIPTION-3-2-P TO PL-DES5.
           MOVE PL-LINE-9      TO CH-PRINT-RECORD.
           WRITE CH-PRINT-RECORD AFTER ADVANCING 1 LINES.
           MOVE SPECL-INSTR-1  TO PL-SI.
           MOVE PL-LINE-10     TO CH-PRINT-RECORD.
           WRITE CH-PRINT-RECORD AFTER ADVANCING 1 LINES.
           MOVE SPECL-INSTR-2  TO PL-SI2.
           MOVE PL-LINE-11     TO CH-PRINT-RECORD.
           WRITE CH-PRINT-RECORD AFTER ADVANCING 1 LINES.
           MOVE SPECL-EQUIP    TO PL-SEQP.
           MOVE PL-LINE-12     TO CH-PRINT-RECORD.
           WRITE CH-PRINT-RECORD AFTER ADVANCING 1 LINES.
           MOVE SAFETY-NOTE    TO PL-SNOT.
           MOVE PL-LINE-13     TO CH-PRINT-RECORD.
           WRITE CH-PRINT-RECORD AFTER ADVANCING 1 LINES.
           MOVE ENGINEER-P     TO PL-ENG.
           MOVE PLANNER-P      TO PL-PLN.
           MOVE SCHEDULER-P    TO PL-SCHD.

           IF DATE-SCHD = "      "
               MOVE DATE-SCHD  TO PL-SCHD-DATE
           ELSE
           MOVE 4              TO DATE-MODE
           MOVE DATE-SCHD      TO DATE-VALIDATE-IN
           CALL "TDATECHK" USING DATE-CHECK-AREA
           MOVE DATE-SLASH-OUT TO PL-SCHD-DATE
                                 HT2-SCHD-DATE
                                 DT2-SCHD-DATE.
           IF TIME-SCHD-P-HH NUMERIC
             MOVE TIME-SCHD-P-HH TO PL-SHH HT2-SHH DT2-SHH.
           IF TIME-SCHD-P-MM NUMERIC
             MOVE TIME-SCHD-P-MM TO PL-SMI HT2-SMI DT2-SMI.
           MOVE PL-LINE-14     TO CH-PRINT-RECORD.
           WRITE CH-PRINT-RECORD AFTER ADVANCING 1 LINES.

           IF BUDGET-NO = SPACES
               MOVE SPACES     TO PL-BUDGET
           ELSE
           MOVE BUDGET-NO-1-3  TO PL-B1-3
           MOVE "-"            TO PL-D1
           MOVE BUDGET-NO-4-5  TO PL-B4-5
           MOVE "-"            TO PL-D2
           MOVE BUDGET-NO-6-7  TO PL-B6-7
           MOVE "-"            TO PL-D3
           MOVE BUDGET-NO-8-10 TO PL-B8-10
           MOVE "R"            TO PL-REV
           MOVE BUDGET-NO-REVNO TO PL-BRNO.
           MOVE REQUEST-NO     TO PL-RNO.

           IF DATE-STRT-P = "      "
               MOVE DATE-STRT-P TO PL-STRT-DATE
           ELSE
           MOVE 4              TO DATE-MODE
           MOVE DATE-STRT-P    TO DATE-VALIDATE-IN
           CALL "TDATECHK"     USING DATE-CHECK-AREA
           MOVE DATE-SLASH-OUT TO PL-STRT-DATE.

           IF TIME-STRT-P = "    "
               MOVE "  "       TO PL-SHR PL-SMI
           ELSE
           MOVE TIME-STRT-P-HH TO PL-SHR
           MOVE TIME-STRT-P-MM TO PL-SMN.

           MOVE PL-LINE-15     TO CH-PRINT-RECORD.
           WRITE CH-PRINT-RECORD AFTER ADVANCING 1 LINES.
           MOVE FAIL-CODE-REASON-P TO PL-FC1-2.
           MOVE FAIL-CODE-SUBSYS-P TO PL-FC3-6.
           MOVE PM-JOBPLAN-KEY     TO     JP-NAM
                                      HT2-JP-NAM.
           MOVE PM-SCHEDULE-KEY    TO SC-NAM.

           IF DATE-COMP-P = "      "
               MOVE DATE-COMP-P TO PL-COMP-DATE
           ELSE
           MOVE 4              TO DATE-MODE
           MOVE DATE-COMP-P    TO DATE-VALIDATE-IN
           CALL "TDATECHK"     USING DATE-CHECK-AREA
           MOVE DATE-SLASH-OUT TO PL-COMP-DATE.

           IF TIME-COMP-P = "    "
               MOVE "  "       TO PL-CHR PL-CMI
           ELSE
           MOVE TIME-COMP-P-HH TO PL-CHR
           MOVE TIME-COMP-P-MM TO PL-CMI.

           MOVE PL-LINE-16     TO CH-PRINT-RECORD.
           WRITE CH-PRINT-RECORD AFTER ADVANCING 1 LINES.

           MOVE PL-LINE-17     TO CH-PRINT-RECORD.
           WRITE CH-PRINT-RECORD AFTER ADVANCING 1 LINES.

       61-PRINT-CRATF-LIST-HEADER.
           MOVE LINES-LINE     TO CH-PRINT-RECORD.
           WRITE CH-PRINT-RECORD AFTER ADVANCING 1 LINES.
           MOVE LINES-LINE     TO CH-PRINT-RECORD.
           WRITE CH-PRINT-RECORD AFTER ADVANCING 1 LINES.
           MOVE CRAFT-LIST-HEADER TO CH-PRINT-RECORD.
           WRITE CH-PRINT-RECORD AFTER ADVANCING 2 LINES.
           MOVE CRAFT-LIST-HEADER-UNDER TO CH-PRINT-RECORD.
           WRITE CH-PRINT-RECORD AFTER ADVANCING 1 LINES.
           MOVE 26             TO LINE-CTR.

       61-PW-EXIT.             EXIT.

       62-PRINT-JOBPLAN.
           MOVE PM-JOBPLAN-KEY TO NAME-BUF.
           MOVE NAME-BUF       TO PMJOBPKEY OF PM-JOBPLAN-KEYS.
           START PM-JOBPLAN-KEYS KEY = PMJOBPKEY OF PM-JOBPLAN-KEYS
               INVALID KEY     MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
      *M********************************************************************
      *M    MESSAGE 036/008:
      *M JOBPLAN DOES NOT EXIST
      *M********************************************************************
               MOVE  36        TO LANG-SETNUM
               MOVE   8        TO LANG-MSGNUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE ERRMSG     TO ERROR-BUFFER
               GO TO 62-PJ-EXIT.

           READ PM-JOBPLAN-KEYS NEXT INTO PM-JP-KEY-DATA
               AT END          MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS = "10" OR "14" OR "46"
      *M********************************************************************
      *M    MESSAGE 036/008:
      *M JOBPLAN DOES NOT EXIST
      *M********************************************************************
               MOVE  36        TO LANG-SETNUM
               MOVE   8        TO LANG-MSGNUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE ERRMSG     TO ERROR-BUFFER
               GO TO 62-PJ-EXIT
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE FILE-STATUS TO CON-WORD
               MOVE "DBGET  K" TO DB-TYPE
               MOVE DB-ERROR   TO ERROR-BUFFER
               GO TO 62-PJ-EXIT.

           IF PMJPK-JOBP-KEY NOT = NAME-BUF
               MOVE "10"       TO FILE-STATUS
      *M********************************************************************
      *M    MESSAGE 036/008:
      *M JOBPLAN DOES NOT EXIST
      *M********************************************************************
               MOVE  36        TO LANG-SETNUM
               MOVE   8        TO LANG-MSGNUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE ERRMSG     TO ERROR-BUFFER
               GO TO 62-PJ-EXIT.

           IF RECORD-KEY NOT = "KEYREC"
      *M********************************************************************
      *M    MESSAGE 036/008:
      *M JOBPLAN DOES NOT EXIST
      *M********************************************************************
               MOVE  36        TO LANG-SETNUM
               MOVE   8        TO LANG-MSGNUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE ERRMSG     TO ERROR-BUFFER
               GO TO 62-PJ-EXIT.

           IF PROCESS-FLAG NOT = "  "
               MOVE NAME-BUF   TO RENUM-JP-BUF
               MOVE 9999       TO RENUM-START-BUF
                                  RENUM-INCR-BUF
               MOVE SPACES     TO RENUM-EDITOR
               CALL "SPMRENUM" USING DBPARAMETERS
                                     RETURN-MSG
                                     VIEW-COMAREA
                                     LANGUAGE-PARMS
                                     RENUM-JP-BUF
                                     RENUM-START-BUF
                                     RENUM-INCR-BUF
                                     RENUM-EDITOR
               IF RETURN-BYTE NOT = "0"
      *M********************************************************************
      *M    MESSAGE 036/014:
      *M JOBPLAN IS CORRUPTED - A PRIOR RENUMBERING SEQUENCE HAS FAILED
      *M********************************************************************
                   MOVE  36    TO LANG-SETNUM
                   MOVE  14    TO LANG-MSGNUM
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE ERRMSG TO ERROR-BUFFER
                   GO TO 62-PJ-EXIT.

       62-SORT-ROUTINE.
           OPEN OUTPUT OUT-FILE.
           MOVE 0              TO ACT-KEY.
           SORT SORT-FILE      ASCENDING KEY SORT-CRAFT
                                             SORT-KEY
               INPUT  PROCEDURE SORTIN-PROC
               OUTPUT PROCEDURE SORTOUT-PROC.
           CLOSE OUT-FILE.

           IF ACT-KEY = 0
      *M********************************************************************
      *M    MESSAGE 036/009:
      *M JOBPLAN DOES NOT HAVE ANY TASKS
      *M********************************************************************
               MOVE  36        TO LANG-SETNUM
               MOVE   9        TO LANG-MSGNUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE ERRMSG     TO CH-PRINT-RECORD
               WRITE CH-PRINT-RECORD AFTER ADVANCING 2
               GO TO 62-PJ-EXIT
           ELSE
               PERFORM 620-CRAFT-LIST THRU 620-EXIT.

           OPEN INPUT OUT-FILE.

       62-OUTPUTROUTINE.
           MOVE 0              TO ACT-KEY.
           PERFORM 63-GET-JOBPLAN-LOOP THRU 63-GJL-EXIT.
           MOVE ASTERISK-LINE  TO CH-PRINT-RECORD.
           WRITE CH-PRINT-RECORD AFTER ADVANCING 2 LINES.

       62-PJ-EXIT.             EXIT.

       620-CRAFT-LIST.
           MOVE CRAFT-INDEX    TO CLT-TOTAL.
           MOVE 1              TO CRAFT-INDEX.
           IF CLT-TOTAL NOT > 0
             GO TO 620-EXIT.

       620-CRAFT-DETAIL.
           MOVE CRAFT-INDEX    TO CLD-NUM.
           MOVE CRAFT-ENTRIES(CRAFT-INDEX) TO CLD-CRAFT.
           MOVE CRAFT-LIST-DETAIL TO CH-PRINT-RECORD.
           WRITE CH-PRINT-RECORD AFTER ADVANCING 1 LINES.
           ADD 1               TO CRAFT-INDEX.
           IF CRAFT-INDEX > CLT-TOTAL
             MOVE CRAFT-LIST-TOTAL TO CH-PRINT-RECORD
             WRITE CH-PRINT-RECORD AFTER ADVANCING 2 LINES
             MOVE LINES-LINE   TO CH-PRINT-RECORD
             WRITE CH-PRINT-RECORD AFTER ADVANCING 1 LINES
             ADD CRAFT-INDEX   TO LINE-CTR
             ADD 3             TO LINE-CTR
             GO TO 620-EXIT
           ELSE
             GO TO 620-CRAFT-DETAIL.

       620-EXIT.               EXIT.

       63-GET-JOBPLAN-LOOP.
           ADD 1               TO ACT-KEY.
           MOVE SPACES         TO OUT-REC.
           READ OUT-FILE       INVALID KEY
               GO TO 63-GJL-EXIT.
           IF ACT-KEY > MAX-KEY
               GO TO 63-GJL-EXIT.

           MOVE OUT-DATA       TO PM-JOBPLAN-DATA.
           IF ACT-KEY = 1
               MOVE OUT-CRAFT  TO CRAFT-SAVE JP-CFT DT2-CFT
               MOVE CRAFT-DISP TO CFTDIS
               MOVE 1          TO EJECT-SW
               PERFORM 64-PRINT-HEADING THRU 64-PH-EXIT.

           PERFORM 65-PRINT-JOBINFO.
           GO TO 63-GET-JOBPLAN-LOOP.

       63-GJL-EXIT.            EXIT.

       64-PRINT-HEADING.
           IF EJECT-ON
               ADD  1          TO PAGE-CTR
               MOVE PAGE-CTR   TO ZPAGE
               MOVE HEADER-DT  TO CH-PRINT-RECORD
               WRITE CH-PRINT-RECORD AFTER ADVANCING NEW-PAGE
               MOVE 1          TO FIRST-SW
               MOVE 0          TO LINE-CTR.

           MOVE 0              TO EJECT-SW.

           MOVE DANVILLE-TITLE   TO CH-PRINT-RECORD
           WRITE CH-PRINT-RECORD AFTER ADVANCING 1 LINES.
      *    MOVE LINES-LINE       TO CH-PRINT-RECORD.
      *    WRITE CH-PRINT-RECORD AFTER ADVANCING 1 LINES.
           MOVE JB-HEADER        TO CH-PRINT-RECORD.
           WRITE CH-PRINT-RECORD AFTER ADVANCING 1 LINES.
           ADD 3                 TO LINE-CTR.

      *C****************************************************************
      *C  5/10/95  -  W. ROXBURY
      *C  CHANGED PAGE HEADER INFORMATION PER DANVILLE PM LIST
      *C****************************************************************
      *    MOVE LINES-LINE       TO CH-PRINT-RECORD.
      *    WRITE CH-PRINT-RECORD AFTER ADVANCING 1 LINES.
      *    MOVE HEADER-TITLE-1   TO CH-PRINT-RECORD.
      *    WRITE CH-PRINT-RECORD AFTER ADVANCING 1 LINES.
      *    MOVE HEADER-TITLE-2   TO CH-PRINT-RECORD.
      *    WRITE CH-PRINT-RECORD AFTER ADVANCING 1 LINES.
      *    MOVE LINES-LINE       TO CH-PRINT-RECORD.
      *    WRITE CH-PRINT-RECORD AFTER ADVANCING 1 LINES.
      *    MOVE JB-HEADER        TO CH-PRINT-RECORD.
      *    WRITE CH-PRINT-RECORD AFTER ADVANCING 1 LINES.
      *    ADD 7                 TO LINE-CTR.

       64-PH-EXIT.             EXIT.

       65-PRINT-JOBINFO.
           IF OUT-CRAFT NOT = CRAFT-SAVE
               MOVE OUT-CRAFT  TO CRAFT-SAVE JP-CFT DT2-CFT
               MOVE CRAFT-DISP TO CFTDIS
               MOVE 1          TO EJECT-SW
               PERFORM 64-PRINT-HEADING THRU 64-PH-EXIT.

           IF PMJP-SEQ = SAVE-JOBPSEQ
               IF FIRST-SW = 1
                   MOVE PMJP-SEQ   TO JB-SEQ-Z
                   MOVE BOX-VALUE  TO BOX-LIT
                   MOVE PMJP-LEVEL TO JB-LEVL
                   MOVE PMJP-SS    TO JB-SS
               ELSE
                   MOVE SPACES TO JB-SEQ-X TEXT-B
           ELSE
               MOVE 1          TO FIRST-SW
               MOVE PMJP-SEQ   TO JB-SEQ-Z SAVE-JOBPSEQ
               MOVE BOX-VALUE  TO BOX-LIT
               MOVE PMJP-LEVEL TO JB-LEVL
               MOVE PMJP-SS    TO JB-SS
               IF LINE-CTR > 54
                   MOVE 1      TO EJECT-SW
                   PERFORM 64-PRINT-HEADING THRU 64-PH-EXIT.

           MOVE PMJP-DESC      TO JB-DESC.
           IF JB-DESC NOT = COMP-VALUE
               IF FIRST-SW = 1
                   IF JB-DESC = SPACES
                       NEXT SENTENCE
                   ELSE
                   MOVE 0      TO FIRST-SW
                   MOVE JB-LINE-1 TO CH-PRINT-RECORD
                   WRITE CH-PRINT-RECORD AFTER ADVANCING 2 LINES
                   ADD 2       TO LINE-CTR
               ELSE
                   MOVE SPACES TO JB-SEQ-X TEXT-B
                   MOVE JB-LINE-1 TO CH-PRINT-RECORD
                   WRITE CH-PRINT-RECORD AFTER ADVANCING 1 LINES
                   ADD 1       TO LINE-CTR
           ELSE
               IF FIRST-SW = 1
                   MOVE 0       TO FIRST-SW
                   MOVE "PART:" TO JB-DESC
                   MOVE JB-LINE-1 TO CH-PRINT-RECORD
                   WRITE CH-PRINT-RECORD AFTER ADVANCING 2 LINES
                   ADD 2        TO LINE-CTR.

           IF PMJP-PRT-NUM NOT = SPACES
               MOVE PMJP-PRT-NUM   TO PT-PART
               IF PMJP-EST-QTY = "        "
                   MOVE ZEROES     TO PMJP-EST-QTY-9
               END-IF
               MOVE PMJP-EST-QTY-9 TO PT-QTY
               MOVE PMJP-UNIT-MEAS TO PT-UM
               MOVE PMJP-TEXT      TO PT-TEXT
               MOVE PT-LINE-1      TO CH-PRINT-RECORD
               WRITE CH-PRINT-RECORD AFTER ADVANCING 1 LINES
               ADD 1               TO LINE-CTR

               MOVE 1          TO CDESC-LINES-TO-GET
               MOVE "K"        TO CDESC-DESC-OPTION
               CALL "CDESC"    USING CDESC-RET-CODE, BASE, STATUS-AREA,
                               BU-DISPLAY-MSG, PMJP-PRT-NUM,
                               CDESC-DATA
               MOVE CDESC-KEYWORD (1) TO PTKWD
               MOVE CDESC-MODIFIER (1) TO PTMOD
               MOVE PT-LINE-2  TO CH-PRINT-RECORD
               WRITE CH-PRINT-RECORD AFTER ADVANCING 1 LINES
               ADD 1           TO LINE-CTR.

           IF LINE-CTR > 59
               MOVE 1          TO EJECT-SW
               PERFORM 64-PRINT-HEADING THRU 64-PH-EXIT.

       999-CATREAD.
           MOVE SPACES         TO CATREAD-MSG-TEXT.
           MOVE LANG-SETNUM    TO CATREAD-MSG-SET.
           MOVE LANG-MSGNUM    TO CATREAD-MSG-NUM.
           CALL "CCATREAD"     USING CATREAD-PARMS.
           IF CATREAD-MSG-NOT-FOUND
                MOVE "**ERROR ON THIS FIELD**" TO ERRMSG
           ELSE
                MOVE CATREAD-MSG-TEXT TO ERRMSG.

       999-CATREAD-EXIT.       EXIT.

       999-SHOWFORM.
           MOVE SCREEN-BUFFER  TO DISPLAY-REC.
           WRITE DISPLAY-REC   FORMAT IS VIEW-NFNAME
               INDIC ARE SRF-INDICATORS.
           IF DISPLAY-STATUS NOT = "00"
               GO TO 2-EOJ.
           MOVE ALL B"0"       TO SRF-INDICATORS.

           READ DISPLAY-FILE   FORMAT IS VIEW-NFNAME
               INDIC ARE SRF-INDICATORS.
           ACCEPT IOFEEDBACK   FROM I-O-FEEDBACK-AREA.
           IF DISPLAY-STATUS NOT = "00"
               MOVE 3          TO VIEW-LASTKEY
           ELSE
               MOVE FUNCTION-NUM TO VIEW-LASTKEY.
           MOVE DISPLAY-REC    TO SCREEN-BUFFER.

       COPY OVRPFCALL          IN COPYLIB.

       SORTIN-PROC SECTION 02.
       SORTIN.
           PERFORM SORT-MAIN   THRU SORT-M-EXIT.
           GO TO SORT-IP-EXIT.

       SORT-MAIN.
           MOVE NAME-BUF       TO PMJOBPKEY OF PM-JOBPLAN.
           START PM-JOBPLAN    KEY = PMJOBPKEY OF PM-JOBPLAN
               INVALID KEY     MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               GO TO SORT-M-EXIT.

           PERFORM SORT-DBGET  THRU SORT-DBGET-EXIT
                               UNTIL FILE-STATUS NOT = "00".

       SORT-M-EXIT.            EXIT.

       SORT-DBGET.
           MOVE SPACES         TO SORT-REC.
           READ PM-JOBPLAN     NEXT INTO PM-JOBPLAN-DATA
               AT END          MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS = "10" OR "14" OR "46"
               GO TO SORT-DBGET-EXIT
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE "DBGET   " TO DB-TYPE
               MOVE FILE-STATUS TO CON-WORD
               MOVE DB-ERROR   TO ERROR-BUFFER
               GO TO SORT-DBGET-EXIT.

           IF JOBPLAN-KEY NOT = NAME-BUF
               MOVE "10"       TO FILE-STATUS
               GO TO SORT-DBGET-EXIT.

           IF WO-NUM-SUFF-P = "000"
               NEXT SENTENCE
           ELSE
           IF PMJP-LEVEL < SELECT-LEVEL
               IF PMJP-FLAG > FLAG-LEVEL
                   NEXT SENTENCE
               ELSE
                   GO TO SORT-DBGET-EXIT
           ELSE
               GO TO SORT-DBGET-EXIT.

           MOVE JOBPLAN-KEY    TO  SORT-KEY-NAME.
           MOVE PMJP-SEQ-LINE  TO  SORT-KEY-SEQ-LINE.
           MOVE PMJP-CFT1      TO  SORT-CRAFT.
           MOVE PM-JOBPLAN-DATA TO  SORT-DATA.
           RELEASE SORT-REC.

           IF PMJP-CFT2 NOT = "  "
               MOVE PMJP-CFT2  TO SORT-CRAFT
               RELEASE SORT-REC
               IF PMJP-CFT3 NOT = "  "
                   MOVE PMJP-CFT3 TO SORT-CRAFT
                   RELEASE SORT-REC.

       SORT-DBGET-EXIT.        EXIT.

       SORT-IP-EXIT.           EXIT.

       SORTOUT-PROC SECTION 03.
       SORTOUT.
           RETURN SORT-FILE    AT END
               MOVE ACT-KEY    TO MAX-KEY
               GO TO SORT-WF-EXIT.
           ADD 1               TO ACT-KEY.
           MOVE SORT-REC       TO OUT-REC.
           IF OUT-CRAFT NOT EQUAL TO CRAFT-STORE
               ADD 1           TO CRAFT-INDEX
               MOVE OUT-CRAFT  TO CRAFT-STORE
                                  CRAFT-ENTRIES (CRAFT-INDEX).
           WRITE OUT-REC       INVALID KEY
               MOVE "WRITE OUT-FILE ERR"
                               TO ERROR-BUFFER
               GO TO SORT-WF-EXIT.
           GO TO SORTOUT-PROC.

       SORT-WF-EXIT.           EXIT.

      ******************  END OF FILE  ********************************
