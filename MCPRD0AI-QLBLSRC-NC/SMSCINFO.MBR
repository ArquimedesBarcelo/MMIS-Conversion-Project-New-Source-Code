       IDENTIFICATION DIVISION.
       PROGRAM-ID.     SMSCINFO.
       AUTHOR.         ANNETTE M. KRAUSS.
       INSTALLATION.   THE GOODYEAR TIRE AND RUBBER COMPANY - AKRON.
       DATE-WRITTEN.   JUNE 9, 1987.
       DATE-COMPILED.
      *REMARKS.
      **************************************************************
      *                                                            *
      *D   SMSCINFO     MISC INFORMATION SUBPROGRAM                *
      *                                                            *
      *D    THIS PROGRAM IS USED TO ENTER THE RECV DEPT, ORDER     *
      *D    AND CARRY COST, LANGUAGE AND DATE AND DECIMAL OPTION,  *
      *D    AND TAX DISTRICT INFORMATION.                          *
      *D                                                           *
      **************************************************************
       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.
       SOURCE-COMPUTER.  IBM-AS400.
       OBJECT-COMPUTER.  IBM-AS400.
       SPECIAL-NAMES. I-O-FEEDBACK IS I-O-FEEDBACK-AREA,
                      LOCAL-DATA   IS LOCAL-DATA-AREA.
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
            SELECT DISPLAY-FILE
                   ASSIGN TO WORKSTATION-ZPLTSTUP-SI
                   ORGANIZATION IS TRANSACTION
                   ACCESS IS SEQUENTIAL
                   FILE STATUS IS DISPLAY-STATUS
                   CONTROL-AREA IS WS-CONTROL.
            SELECT MPLTINFO-O
                   ASSIGN TO DATABASE-MCFLCS0501
                   ORGANIZATION IS INDEXED
                   ACCESS IS DYNAMIC
                   RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                   FILE STATUS IS FILE-STATUS.
       DATA DIVISION.
       FILE SECTION.
       FD  DISPLAY-FILE
           LABEL RECORDS ARE OMITTED.
       01  DISPLAY-REC             PIC X(2000).
       FD  MPLTINFO-O
           LABEL RECORDS ARE STANDARD.
       01  MPLTINFO-O-REC.
           COPY DDS-MCRPCS0500 OF MCFLCS0501.

       WORKING-STORAGE SECTION.
       01  FILE-STATUS.
           05  FILE-STATUS-1        PIC X VALUE SPACE.
           05  FILE-STATUS-2        PIC X VALUE SPACE.
       01  CARRY-COST-FIGURES.
           05  CARRY-COST-PERCENT     PIC 9V9(2)  VALUE ZEROES.
           05  CARRY-COST-OUT         PIC 9(2)    VALUE ZEROES.
       01  SAVE-EURO-DATE-FORMAT      PIC X(3)    VALUE "NO ".
      *************************************************************
      **                                                         **
      **              D A T A    B A S E    A R E A              **
      **                                                         **
      *************************************************************
      *************************************************************

       COPY MPLTINFO IN COPYLIB.
       COPY DBSTAT   IN COPYLIB.
       01  MPLTINFO-ARG                    PIC X(4).
       01  MESSAGE-BUFFER.
           05  MSG-TEXT                    PIC X(64)  VALUE SPACES.
           05  MSG-FLD                     PIC X(12)  VALUE SPACES.
           05  MSG-FLD-9 REDEFINES MSG-FLD
                                           PIC Z(11)9.

      **************************************************************
      **                                                          **
      **            C O M M A N D   A R E A                       **
      **                                                          **
      **************************************************************
       COPY CCHKOBJ IN COPYLIB.
       COPY CCRTFILE IN COPYLIB.
       COPY CDLTFILE IN COPYLIB.
      *************************************************************
      *************************************************************
      **                                                         **
      **                 TERMINAL I/O DATA AREA                  **
      **                                                         **
      *************************************************************
      *************************************************************

       01  MISC-SCREEN.
           05  RECV-DEPT                 PIC X(4).
           05  ORDER-COST                PIC 9(6).
           05  LANG-INFO.
               10  LANG1                 PIC X(3).
               10  LANG2                 PIC X(3).
           05  CARRY-COST                PIC 9(2).
           05  ALT-DECI-FORMAT           PIC X(1).
           05  EURO-DATE-FORMAT          PIC X(1).
           05  TAX-DISTRICT-INFO.
               10  TAX-DIST1             PIC X(15).
               10  TAX-ACCT1             PIC X(9).
               10  TAX-DIST2             PIC X(15).
               10  TAX-ACCT2             PIC X(9).
               10  TAX-DIST3             PIC X(15).
               10  TAX-ACCT3             PIC X(9).
               10  TAX-DIST4             PIC X(15).
               10  TAX-ACCT4             PIC X(9).
           05  MISC-MSGLINE              PIC X(79).
           05  CMDLINE                   PIC X(79).
           05  ERR-MSGLINE               PIC X(79).

       COPY TBLOWUP    IN COPYLIB.
       COPY CATREAD    IN COPYLIB.
       COPY DISPDATA   IN COPYLIB.
       COPY IOFEEDBACK IN COPYLIB.
       COPY JCWAREA    IN COPYLIB.

      *************************************************************
      *************************************************************
      **                                                         **
      **               LINKAGE   SECTION                         **
      **                                                         **
      *************************************************************
      *************************************************************

       LINKAGE SECTION.

       01  BASE                          PIC X(10).
       COPY VCOMLINK IN COPYLIB.
       COPY LANGSUB IN COPYLIB.


      *************************************************************
      **#########################################################**
      *************************************************************
      **                                                         **
      **          P R O C E D U R E    D I V I S I O N           **
      **                                                         **
      *************************************************************
      **#########################################################**
      *************************************************************

       PROCEDURE DIVISION USING BASE,
                                VIEW-COMAREA,
                                LANGUAGE-PARMS.


       MAIN-PGM SECTION 01.

       BEGIN-HERE.
           PERFORM 1-HSK.
           PERFORM 6-MAIN THRU 6-MAIN-X.
           PERFORM 2-EOJ.

       1-HSK.
           MOVE "SMSCINFO" TO BU-PGM-NAME.
           OPEN I-O DISPLAY-FILE, MPLTINFO-O.
           ACCEPT MC-LOCAL-DATA-AREA FROM LOCAL-DATA-AREA.

       2-EOJ.
           CLOSE DISPLAY-FILE, MPLTINFO-O.
           GOBACK.

      ******************************************************
      **                 BLOWUP ROUTINE                   **
      ******************************************************

       2-BLOWUP.
           CALL "TBLOWUP" USING BASE, BU-PGM-NAME, STATUS-AREA,
               VIEW-COMAREA, FILE-STATUS, BU-DISPLAY-MSG,
               BU-DISPLAY-AREA.


      **************************************************
      *                                                *
      *                  6 - M A I N                   *
      *                                                *
      **************************************************

       6-MAIN.
           INITIALIZE     MISC-SCREEN.
           PERFORM 61-READ-MPLTINFO.

       6-PUT-BUFFER.

      ***  INPUT DATA ABOVE AND PRESS 'ENTER'  ***
           MOVE   9 TO LANG-SETNUM.
           MOVE  20 TO LANG-MSGNUM.
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
           MOVE MESSAGE-BUFFER TO MISC-MSGLINE.

       6-SHOW-FORM.
           MOVE "MISCINFO"  TO VIEW-NFNAME.
           MOVE MISC-SCREEN TO DISPLAY-REC.
           PERFORM 998-WRITE-SCREEN THRU 998-READ-SCREEN.
           MOVE DISPLAY-REC TO MISC-SCREEN.

       6-READ-FIELDS.
           IF VIEW-LASTKEY = 3
               GO TO 6-MAIN-X.
           IF VIEW-LASTKEY = 1
               PERFORM 62-HELP-SCREEN THRU 62-HELP-SCREEN-X
               GO TO 6-SHOW-FORM
           ELSE
           IF VIEW-LASTKEY = 2 OR
              VIEW-LASTKEY = 4 OR
              VIEW-LASTKEY = 5 OR
              VIEW-LASTKEY = 6 OR
              VIEW-LASTKEY = 7 OR
              VIEW-LASTKEY = 8
      *****    INVALID FUNCTION KEY    *****
               MOVE   9 TO LANG-SETNUM
               MOVE  10 TO LANG-MSGNUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER TO ERR-MSGLINE
               MOVE B"1" TO IND(99)
               GO TO 6-SHOW-FORM.

       6-REPLACE-MPLTINFO.
           MOVE "P 03" TO MPLTINFO-ARG, BU-DISPLAY-FLD (1).
           MOVE MPLTINFO-ARG TO PLTINFOKEY OF MPLTINFO-O-REC.
           READ MPLTINFO-O INTO BUF-MPLTINFO
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS-1 = "2"
               MOVE SPACES         TO BUF-MPLTINFO
               MOVE "P 03"         TO MPLTINFO-KEY
               MOVE RECV-DEPT      TO MPLTINFO-RECV-DEPT
               WRITE MPLTINFO-O-REC FROM BUF-MPLTINFO
                   INVALID KEY MOVE FILE-STATUS TO FILE-STATUS
               END-WRITE
               IF FILE-STATUS NOT = "00"
                   MOVE "1WRT MPLTINFO ERROR IN 6-REPLACE-MPLTINFO"
                       TO BU-DISPLAY-MSG
                   PERFORM 2-BLOWUP
               ELSE
                   NEXT SENTENCE
           ELSE
           IF FILE-STATUS  = "00"
               MOVE RECV-DEPT      TO MPLTINFO-RECV-DEPT
               REWRITE MPLTINFO-O-REC FROM BUF-MPLTINFO
                   INVALID KEY MOVE FILE-STATUS TO FILE-STATUS
               END-REWRITE
               IF FILE-STATUS NOT = "00"
                   MOVE "1REWRITE  ERROR IN 6-REPLACE-MPLTINFO"
                       TO BU-DISPLAY-MSG
               ELSE
                   NEXT SENTENCE
           ELSE
               MOVE "1READ  MPLTINFO ERROR IN 6-REPLACE-MPLTINFO"
                   TO BU-DISPLAY-MSG
               PERFORM 2-BLOWUP.

           MOVE "P 20" TO MPLTINFO-ARG, BU-DISPLAY-FLD (1).
           MOVE MPLTINFO-ARG TO PLTINFOKEY OF MPLTINFO-O-REC.
           READ MPLTINFO-O INTO BUF-MPLTINFO
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS-1 = "2"
               MOVE SPACES     TO BUF-MPLTINFO
               MOVE "P 20"     TO MPLTINFO-KEY
               MOVE ZEROS      TO MPLTINFO-ORDER-COST
               MOVE ORDER-COST TO MPLTINFO-EXP-ORDER-COST
               DIVIDE CARRY-COST BY 100 GIVING CARRY-COST-PERCENT
               MOVE CARRY-COST-PERCENT TO MPLTINFO-CARRY-COST
               WRITE MPLTINFO-O-REC FROM BUF-MPLTINFO
                   INVALID KEY MOVE FILE-STATUS TO FILE-STATUS
               END-WRITE
               IF FILE-STATUS NOT = "00"
                   MOVE "2WRT MPLTINFO ERROR IN 6-REPLACE-MPLTINFO"
                        TO BU-DISPLAY-MSG
                   PERFORM 2-BLOWUP
               ELSE
                   NEXT SENTENCE
           ELSE
           IF FILE-STATUS = "00"
               MOVE ORDER-COST TO MPLTINFO-EXP-ORDER-COST
               MOVE ZEROS      TO MPLTINFO-ORDER-COST
               DIVIDE CARRY-COST BY 100 GIVING CARRY-COST-PERCENT
               MOVE CARRY-COST-PERCENT TO MPLTINFO-CARRY-COST
               REWRITE MPLTINFO-O-REC FROM BUF-MPLTINFO
                   INVALID KEY MOVE FILE-STATUS TO FILE-STATUS
               END-REWRITE
               IF FILE-STATUS NOT = "00"
                   MOVE "2REWRITE ERROR IN 6-REPLACE-MPLTINFO"
                       TO BU-DISPLAY-MSG
               ELSE
                   NEXT SENTENCE
           ELSE
               MOVE "2READ MPLTINFO ERROR IN 6-REPLACE-MPLTINFO"
                   TO BU-DISPLAY-MSG
               PERFORM 2-BLOWUP.

           MOVE "PTX1" TO MPLTINFO-ARG, BU-DISPLAY-FLD (1).
           MOVE MPLTINFO-ARG TO PLTINFOKEY OF MPLTINFO-O-REC.
           READ MPLTINFO-O INTO BUF-MPLTINFO
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS-1 = "2"
               MOVE SPACES    TO BUF-MPLTINFO
               MOVE "PTX1"    TO MPLTINFO-KEY
               MOVE TAX-DIST1 TO MPLTINFO-TAX-DISTRICT(1)
               MOVE TAX-ACCT1 TO MPLTINFO-TAX-CE-ACCTG(1)
               MOVE TAX-DIST2 TO MPLTINFO-TAX-DISTRICT(2)
               MOVE TAX-ACCT2 TO MPLTINFO-TAX-CE-ACCTG(2)
               WRITE MPLTINFO-O-REC FROM BUF-MPLTINFO
                   INVALID KEY MOVE FILE-STATUS TO FILE-STATUS
               END-WRITE
               IF FILE-STATUS NOT = "00"
                   MOVE "3WRT MPLTINFO ERROR IN 6-REPLACE-MPLTINFO"
                       TO BU-DISPLAY-MSG
                   PERFORM 2-BLOWUP
               ELSE
                   NEXT SENTENCE
           ELSE
           IF FILE-STATUS = "00"
               MOVE TAX-DIST1 TO MPLTINFO-TAX-DISTRICT(1)
               MOVE TAX-ACCT1 TO MPLTINFO-TAX-CE-ACCTG(1)
               MOVE TAX-DIST2 TO MPLTINFO-TAX-DISTRICT(2)
               MOVE TAX-ACCT2 TO MPLTINFO-TAX-CE-ACCTG(2)
               REWRITE MPLTINFO-O-REC FROM BUF-MPLTINFO
                   INVALID KEY MOVE FILE-STATUS TO FILE-STATUS
               END-REWRITE
               IF FILE-STATUS NOT = "00"
                   MOVE "3REWRITE ERROR IN 6-REPLACE-MPLTINFO"
                       TO BU-DISPLAY-MSG
               ELSE
                   NEXT SENTENCE
           ELSE
               MOVE "3READ MPLTINFO ERROR IN 6-REPLACE-MPLTINFO"
                   TO BU-DISPLAY-MSG
               PERFORM 2-BLOWUP.

           MOVE "PTX2" TO MPLTINFO-ARG, BU-DISPLAY-FLD (1).
           MOVE MPLTINFO-ARG TO PLTINFOKEY OF MPLTINFO-O-REC.
           READ MPLTINFO-O INTO BUF-MPLTINFO
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS-1 = "2"
               MOVE SPACES    TO BUF-MPLTINFO
               MOVE "PTX2"    TO MPLTINFO-KEY
               MOVE TAX-DIST3 TO MPLTINFO-TAX-DISTRICT(1)
               MOVE TAX-ACCT3 TO MPLTINFO-TAX-CE-ACCTG(1)
               MOVE TAX-DIST4 TO MPLTINFO-TAX-DISTRICT(2)
               MOVE TAX-ACCT4 TO MPLTINFO-TAX-CE-ACCTG(2)
               WRITE MPLTINFO-O-REC FROM BUF-MPLTINFO
                   INVALID KEY MOVE FILE-STATUS TO FILE-STATUS
               END-WRITE
               IF FILE-STATUS NOT = "00"
                   MOVE "4WRT MPLTINFO ERROR IN 6-REPLACE-MPLTINFO"
                       TO BU-DISPLAY-MSG
                   PERFORM 2-BLOWUP
               ELSE
                   NEXT SENTENCE
           ELSE
           IF FILE-STATUS = "00"
               MOVE TAX-DIST3 TO MPLTINFO-TAX-DISTRICT(1)
               MOVE TAX-ACCT3 TO MPLTINFO-TAX-CE-ACCTG(1)
               MOVE TAX-DIST4 TO MPLTINFO-TAX-DISTRICT(2)
               MOVE TAX-ACCT4 TO MPLTINFO-TAX-CE-ACCTG(2)
               REWRITE MPLTINFO-O-REC FROM BUF-MPLTINFO
                   INVALID KEY MOVE FILE-STATUS TO FILE-STATUS
               END-REWRITE
               IF FILE-STATUS NOT = "00"
                   MOVE "4REWRITE ERROR IN 6-REPLACE-MPLTINFO"
                       TO BU-DISPLAY-MSG
               ELSE
                   NEXT SENTENCE
           ELSE
               MOVE "4READ MPLTINFO ERROR IN 6-REPLACE-MPLTINFO"
                   TO BU-DISPLAY-MSG
               PERFORM 2-BLOWUP.

           MOVE "PLAN" TO MPLTINFO-ARG, BU-DISPLAY-FLD (1).
           MOVE MPLTINFO-ARG TO PLTINFOKEY OF MPLTINFO-O-REC.
           READ MPLTINFO-O INTO BUF-MPLTINFO
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS-1 = "2"
               MOVE SPACES TO BUF-MPLTINFO
               MOVE "PLAN" TO MPLTINFO-KEY
               MOVE LANG1  TO PRIMARY-LANGUAGE
               MOVE LANG2  TO SECONDARY-LANGUAGE
               WRITE MPLTINFO-O-REC FROM BUF-MPLTINFO
                   INVALID KEY MOVE FILE-STATUS TO FILE-STATUS
               END-WRITE
               IF FILE-STATUS NOT = "00"
                   MOVE "5WRT MPLTINFO ERROR IN 6-REPLACE-MPLTINFO"
                       TO BU-DISPLAY-MSG
                   PERFORM 2-BLOWUP
               ELSE
                   NEXT SENTENCE
           ELSE
           IF FILE-STATUS = "00"
               MOVE LANG1  TO PRIMARY-LANGUAGE
               MOVE LANG2  TO SECONDARY-LANGUAGE
               REWRITE MPLTINFO-O-REC FROM BUF-MPLTINFO
                   INVALID KEY MOVE FILE-STATUS TO FILE-STATUS
               END-REWRITE
               IF FILE-STATUS NOT = "00"
                   MOVE "5REWRITE ERROR IN 6-REPLACE-MPLTINFO"
                       TO BU-DISPLAY-MSG
               ELSE
                   NEXT SENTENCE
           ELSE
               MOVE "5READ MPLTINFO ERROR IN 6-REPLACE-MPLTINFO"
                   TO BU-DISPLAY-MSG
               PERFORM 2-BLOWUP.


           MOVE "PDEC" TO MPLTINFO-ARG, BU-DISPLAY-FLD (1).
           MOVE MPLTINFO-ARG TO PLTINFOKEY OF MPLTINFO-O-REC.
           READ MPLTINFO-O INTO BUF-MPLTINFO
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS = "00"
               IF ALT-DECI-FORMAT = SPACES
                   DELETE MPLTINFO-O
                       INVALID KEY MOVE FILE-STATUS TO FILE-STATUS
                   END-DELETE
                   IF FILE-STATUS NOT = "00"
                      MOVE "6DEL MPLTINFO ERROR IN 6-REPLACE-MPLTINFO"
                          TO BU-DISPLAY-MSG
                      PERFORM 2-BLOWUP
                   ELSE
                      NEXT SENTENCE
               ELSE
                   NEXT SENTENCE
           ELSE
           IF FILE-STATUS-1 = "2"
               IF ALT-DECI-FORMAT = "X"
                   MOVE "PDEC" TO MPLTINFO-KEY
                   MOVE SPACES TO MPLTINFO-DATA
                   WRITE MPLTINFO-O-REC FROM BUF-MPLTINFO
                      INVALID KEY MOVE FILE-STATUS TO FILE-STATUS
                   END-WRITE
                   IF FILE-STATUS NOT = "00"
                       MOVE "7WRT ERR IN 6-REPLACE-MPLTINFO"
                           TO BU-DISPLAY-MSG
                       PERFORM 2-BLOWUP
                   ELSE
                       NEXT SENTENCE
               ELSE
                   NEXT SENTENCE
           ELSE
               MOVE "7READ MPLTINFO ERROR IN 6-REPLACE-MPLTINFO"
                   TO BU-DISPLAY-MSG
               PERFORM 2-BLOWUP.

           IF SAVE-EURO-DATE-FORMAT = "YES"
               MOVE "NO" TO SAVE-EURO-DATE-FORMAT
               IF EURO-DATE-FORMAT = "X"
                   NEXT SENTENCE
               ELSE
      **************************************
      **
      **   EUROPEAN DATECODE NO LONGER WANTED
      **
      **************************************
                  MOVE "DATECODE"      TO  DLTFILE-FILE-NAME
                  CALL "CDLTFILE" USING DLTFILE-LIB-NAME,
                                        DLTFILE-FILE-NAME,
                                        DLTFILE-RETURN-STATUS
                  IF DLTFILE-RETURN-STATUS NOT = "00"
                   MOVE "DLTFILE DATECODE FAILED" TO BU-DISPLAY-MSG
                   MOVE DLTFILE-RETURN-STATUS     TO BU-DISPLAY-FLD (1)
                   GO TO 2-BLOWUP
               ELSE
                   NEXT SENTENCE
           ELSE
           IF EURO-DATE-FORMAT = "X"
      **************************************
      **
      **   EUROPEAN DATE FORMAT WANTED
      **
      **************************************
               MOVE "DATECODE" TO  CCRTFILE-FILE
               MOVE 1          TO  CCRTFILE-RECORD-LENGTH,
                                   CCRTFILE-NO-RECORDS,
                                   CCRTFILE-INCREMENT-AMT,
                                   CCRTFILE-NO-INCREMENTS
               CALL "CCRTFILE" USING CCRTFILE-LIBRARY,
                                     CCRTFILE-FILE,
                                     CCRTFILE-RECORD-LENGTH,
                                     CCRTFILE-NO-RECORDS,
                                     CCRTFILE-INCREMENT-AMT,
                                     CCRTFILE-NO-INCREMENTS,
                                     CCRTFILE-STATUS
               IF CCRTFILE-STATUS NOT = "00"
                   MOVE "CCRTFILE CREATE FAILED"  TO  BU-DISPLAY-MSG
                   MOVE CCRTFILE-STATUS          TO  BU-DISPLAY-FLD (1)
                   GO TO 2-BLOWUP.

       6-MAIN-X.
           EXIT.

       61-DELETE-MPLTINFO.
           DELETE MPLTINFO-O
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 NOT = "2"
                   MOVE "DELETE MPLTINFO ERROR IN 6-DELETE-MPLTINFO"
                       TO BU-DISPLAY-MSG
                   PERFORM 2-BLOWUP.

       61-READ-MPLTINFO.
           MOVE "P 03" TO MPLTINFO-ARG.
           MOVE MPLTINFO-ARG TO PLTINFOKEY OF MPLTINFO-O-REC.
           READ MPLTINFO-O INTO BUF-MPLTINFO
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS = "00"
               MOVE MPLTINFO-RECV-DEPT TO RECV-DEPT
           ELSE
           IF FILE-STATUS-1 NOT = "2"
               MOVE "1READ MPLTINFO ERROR IN 61-READ-MPLTINFO"
                   TO BU-DISPLAY-MSG
               MOVE "P 03" TO BU-DISPLAY-FLD (1)
               PERFORM 2-BLOWUP.

           MOVE "P 20" TO MPLTINFO-ARG.
           MOVE MPLTINFO-ARG TO PLTINFOKEY OF MPLTINFO-O-REC.
           READ MPLTINFO-O INTO BUF-MPLTINFO
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS = "00"
               MULTIPLY MPLTINFO-CARRY-COST BY 100
                                GIVING CARRY-COST-OUT
               MOVE CARRY-COST-OUT TO CARRY-COST
               IF MPLTINFO-ORDER-COST = ZEROS
                   MOVE MPLTINFO-EXP-ORDER-COST TO ORDER-COST
               ELSE
                   MOVE MPLTINFO-ORDER-COST     TO ORDER-COST
           ELSE
           IF FILE-STATUS-1 NOT = "2"
               MOVE "2READ MPLTINFO ERROR IN 61-READ-MPLTINFO"
                   TO BU-DISPLAY-MSG
               MOVE "P 03" TO BU-DISPLAY-FLD (1)
               PERFORM 2-BLOWUP.

           MOVE "PTX1" TO MPLTINFO-ARG.
           MOVE MPLTINFO-ARG TO PLTINFOKEY OF MPLTINFO-O-REC.
           READ MPLTINFO-O INTO BUF-MPLTINFO
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS = "00"
               MOVE MPLTINFO-TAX-DISTRICT(1) TO TAX-DIST1
               MOVE MPLTINFO-TAX-CE-ACCTG(1) TO TAX-ACCT1
               MOVE MPLTINFO-TAX-DISTRICT(2) TO TAX-DIST2
               MOVE MPLTINFO-TAX-CE-ACCTG(2) TO TAX-ACCT2
           ELSE
           IF FILE-STATUS-1 NOT = "2"
               MOVE "3READ MPLTINFO ERROR IN 61-READ-MPLTINFO"
                   TO BU-DISPLAY-MSG
               MOVE "P 03" TO BU-DISPLAY-FLD (1)
               PERFORM 2-BLOWUP.

           MOVE "PTX2" TO MPLTINFO-ARG.
           MOVE MPLTINFO-ARG TO PLTINFOKEY OF MPLTINFO-O-REC.
           READ MPLTINFO-O INTO BUF-MPLTINFO
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS = "00"
               MOVE MPLTINFO-TAX-DISTRICT(1) TO TAX-DIST3
               MOVE MPLTINFO-TAX-CE-ACCTG(1) TO TAX-ACCT3
               MOVE MPLTINFO-TAX-DISTRICT(2) TO TAX-DIST4
               MOVE MPLTINFO-TAX-CE-ACCTG(2) TO TAX-ACCT4
           ELSE
           IF FILE-STATUS-1 NOT = "2"
               MOVE "4READ MPLTINFO ERROR IN 61-READ-MPLTINFO"
                   TO BU-DISPLAY-MSG
               MOVE "P 03" TO BU-DISPLAY-FLD (1)
               PERFORM 2-BLOWUP.

           MOVE "PLAN" TO MPLTINFO-ARG.
           MOVE MPLTINFO-ARG TO PLTINFOKEY OF MPLTINFO-O-REC.
           READ MPLTINFO-O INTO BUF-MPLTINFO
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS = "00"
               MOVE PRIMARY-LANGUAGE   TO LANG1
               MOVE SECONDARY-LANGUAGE TO LANG2
           ELSE
           IF FILE-STATUS-1 NOT = "2"
               MOVE "5READ MPLTINFO ERROR IN 61-READ-MPLTINFO"
                   TO BU-DISPLAY-MSG
               MOVE "PLAN" TO BU-DISPLAY-FLD (1)
               PERFORM 2-BLOWUP.

           MOVE "PDEC" TO MPLTINFO-ARG.
           MOVE MPLTINFO-ARG TO PLTINFOKEY OF MPLTINFO-O-REC.
           READ MPLTINFO-O INTO BUF-MPLTINFO
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS = "00"
               MOVE "X" TO ALT-DECI-FORMAT
           ELSE
           IF FILE-STATUS-1 NOT = "2"
               MOVE "6READ MPLTINFO ERROR IN 61-READ-MPLTINFO"
                   TO BU-DISPLAY-MSG
               MOVE "PDEC" TO BU-DISPLAY-FLD (1)
               PERFORM 2-BLOWUP.

      *------- DO A START > HIGH-VALUES TO UNLOCK
           MOVE HIGH-VALUES TO PLTINFOKEY OF MPLTINFO-O-REC.
           START MPLTINFO-O KEY > PLTINFOKEY OF MPLTINFO-O-REC
               INVALID KEY MOVE "00" TO FILE-STATUS.

           MOVE "DATECODE"   TO  CHKOBJ-FILE-NAME.
           CALL "CCHKOBJ" USING CHKOBJ-FILE-NAME,
                                CHKOBJ-RETURN-STATUS.
           IF CHKOBJ-RETURN-STATUS  = "00"
               MOVE "YES" TO SAVE-EURO-DATE-FORMAT
               MOVE "X"   TO EURO-DATE-FORMAT.

       62-HELP-SCREEN.
           MOVE "HELP" TO VIEW-NFNAME.
           PERFORM 998-WRITE-SCREEN THRU 998-READ-SCREEN.

       62-HELP-SCREEN-X.
            EXIT.

       COPY DISPCALL IN COPYLIB.
      *********************************************************
       999-CATREAD.
           IF CATREAD-MSG-NUMBER = ZEROS
               MOVE LANG-SETNUM TO CATREAD-MSG-SET
               MOVE LANG-MSGNUM TO CATREAD-MSG-NUM.
           CALL "CCATREAD" USING CATREAD-PARMS.
           MOVE CATREAD-MSG-TEXT TO MESSAGE-BUFFER.

       999-CATREAD-EXIT.
           EXIT.
