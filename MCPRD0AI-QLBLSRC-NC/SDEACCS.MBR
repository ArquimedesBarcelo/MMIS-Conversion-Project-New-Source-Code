       01  HOLD-RESTRICT.
           05  FILLER             PIC X(7).
           05  HOLD-RESTRICT-8    PIC X(1).
019400
       COPY MCLASS     IN COPYLIB.
019400
       COPY TBLOWUP IN COPYLIB.
019500
021100 LINKAGE SECTION.
021200 01  BASE                          PIC X(10).

021400 COPY VCOMLINK IN COPYLIB.

021300 COPY LANGSUB IN COPYLIB.
021500
021600 PROCEDURE DIVISION USING BASE, VIEW-COMAREA, LANGUAGE-PARMS.
021700
021800 PROC-DIV SECTION 01.
021900
022000 BEGIN-HERE.
022100     PERFORM 1-HSK THRU 1-H-X.
022300     PERFORM 6-MAIN THRU 6-M-X.
022500     PERFORM 2-EOJ THRU 2-EOJ-X.
022600     GOBACK.
022800
022900 1-HSK.
           OPEN INPUT MPLTINFO-I, MCLASS-I.
           OPEN I-O MVALIDPLTDATA-O, MCLASS-O, DISPLAY-FILE DRESTRICT.

023000**************************************************
023100*                                                *
023200*   GET CO. AND PRIME FROM MPLTINFO              *
023300*   USING 'P 01' AS THE ARGUMENT                 *
023400*                                                *
023500**************************************************
023600
023700     MOVE "P 01"  TO  PLT-ARG.
           MOVE PLT-ARG TO PLTINFOKEY OF MPLTINFO-REC-I.
           READ MPLTINFO-I INTO BUF-MPLTINFO
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
024100         MOVE "DBGET MPLTINFO 1-HSK P 01"  TO  BU-DISPLAY-MSG
024200         MOVE PLT-ARG                      TO  BU-DISPLAY-FLD (1)
024300         GO TO 2-BLOWUP.
024400
      *----------- FIND OUT IF PLANT IS ON SAP/R3.
           MOVE "PREQ"  TO  PLT-ARG.
           MOVE PLT-ARG TO PLTINFOKEY OF MPLTINFO-REC-I.
           READ MPLTINFO-I INTO BUF-MPLTINFO
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE "N"                        TO SAVE-REQ-SYNR3-SW
           ELSE
               MOVE MPLTINFO-REQ-SYNR3-SW      TO SAVE-REQ-SYNR3-SW.

024500 1-H-X.
024600     EXIT.
024700
024800
024900 2-EOJ.
           CLOSE MVALIDPLTDATA-O, DISPLAY-FILE, MPLTINFO-I, MCLASS-I,
                        MCLASS-O, DRESTRICT.
027200 2-EOJ-X.
027300      EXIT.
027400
027500******************************************************
027600**                                                  **
027700**   BLOWUP ROUTINE                                 **
027800**                                                  **
027900******************************************************
028000
046700 2-BLOWUP.
046800     MOVE "SDEACCS"              TO  BU-PGM-NAME.
047200     CALL "TBLOWUP" USING BASE, BU-PGM-NAME, STATUS-AREA,
047300         VIEW-COMAREA, FILE-STATUS, BU-DISPLAY-MSG,
047400                 BU-DISPLAY-FLDS.
047500
047600 2-BLOWUP-X.
047700     EXIT.
038000
038100 4-PGM-ERROR.
           MOVE B"1" TO IND (FIELD-NUMBER), IND (99).
           MOVE MESSAGE-BUFFER TO DE1-MESSAGE-LINE,
                                  DE2-MESSAGE-LINE,
                                  DE4-MESSAGE-LINE,
                                  DE6-MESSAGE-LINE,
                                  DE7-MESSAGE-LINE,
                                  DE8-MESSAGE-LINE,
                                  DE9-MESSAGE-LINE.
038900
039000 4-PGM-ERROR-X.
039100     EXIT.
039200
041200
041300**************************************************
041400*                                                *
041500*     6 - M A I N                                *
041600*                                                *
041700**************************************************
041800
041900 6-MAIN.
           IF SAVE-REQ-SYNR3-SW = "Y"
               MOVE "MENU_R3"    TO  VIEW-NFNAME
           ELSE
042000     MOVE "DEACCMENU"      TO  VIEW-NFNAME.
043800     MOVE SPACES           TO  SCREEN-MENU.
043900     MOVE MPLTINFO-COMPANY TO  DISP-COMPANY-MENU.
044700
044800 6-SHOWFORM-SCREEN-MENU.
           MOVE SCREEN-MENU    TO DISPLAY-REC.
           PERFORM 998-WRITE-SCREEN THRU 998-READ-SCREEN.
           MOVE DISPLAY-REC    TO SCREEN-MENU.
046400     IF VIEW-LASTKEY = 3
046500         GO TO 6-M-X
046600     ELSE
046700     IF VIEW-LASTKEY = 1 OR
                             2 OR
                             4 OR
                             5 OR
                             6 OR
                             7 OR
                             8
076500*------  *** INVALID FUNCTION KEY ENTERED ***
076600         MOVE   9 TO LANG-SETNUM
076700         MOVE  10 TO LANG-MSGNUM
076800         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
076900         MOVE 99 TO  FIELD-NUMBER
077000         PERFORM 4-PGM-ERROR  THRU  4-PGM-ERROR-X
077100         GO TO 6-SHOWFORM-SCREEN-MENU.
047800
047900 6-PERFORM-SELECTION.
048000     IF DISP-CODE-CHOICE (1) = "A"
048100         PERFORM 61-ADD-DEPT-CODE  THRU  61-ADC-X
048200     ELSE
048000     IF DISP-CODE-CHOICE (1) = "D"
048400         PERFORM 61-DELETE-DEPT-CODE  THRU  61-DDC-X
048500     ELSE
048000     IF DISP-CODE-CHOICE (2) = "A"
048700         PERFORM 62-ADD-EXP-CLASS  THRU  62-AEC-X
048800     ELSE
048000     IF DISP-CODE-CHOICE (2) = "D"
049000         PERFORM 62-DELETE-EXP-CLASS  THRU  62-DEC-X
049100     ELSE
048000     IF DISP-CODE-CHOICE (3) = "A"
049300         PERFORM 63-ADD-NW-CODE  THRU  63-ANC-X
049400     ELSE
048000     IF DISP-CODE-CHOICE (3) = "D"
049600         PERFORM 63-DELETE-NW-CODE  THRU  63-DNC-X
049700     ELSE
048000     IF DISP-CODE-CHOICE (4) = "A"
049300         PERFORM 64-ADD-COMPANY-CODE  THRU  64-ACC-X
049400     ELSE
048000     IF DISP-CODE-CHOICE (4) = "D"
049600         PERFORM 64-DELETE-COMPANY-CODE  THRU  64-DCC-X
049700     ELSE
048000     IF DISP-CODE-CHOICE (5) = "A"
049300         PERFORM 65-ADD-PRIME-CODE  THRU  65-APC-X
049400     ELSE
048000     IF DISP-CODE-CHOICE (5) = "D"
049600         PERFORM 65-DELETE-PRIME-CODE  THRU  65-DPC-X
049700     ELSE
048000     IF DISP-CODE-CHOICE (6) = "A"
049300         PERFORM 66-ADD-CLASS-CODE  THRU  66-ACLC-X
049400     ELSE
048000     IF DISP-CODE-CHOICE (6) = "D"
049600         PERFORM 66-DELETE-CLASS-CODE  THRU  66-DCLC-X
049700     ELSE
048000     IF DISP-CODE-CHOICE (6) = "E"
049600         PERFORM 66-CHANGE-CLASS-CODE  THRU  66-CCLC-X
049700     ELSE
050200         GO TO 6-SHOWFORM-SCREEN-MENU.

           GO TO 6-MAIN.
050300
050900 6-M-X.
051000     EXIT.
051100
051200*********************************************************
051300*                                                       *
051400*   A D D   D E P A R T M E N T  C O D E S              *
051500*                                                       *
051600*********************************************************
051700
051800 61-ADD-DEPT-CODE.
051900     MOVE "DEACC1A"     TO  VIEW-NFNAME.
053500
053700     MOVE SPACES        TO  SCREEN-1.
053800     MOVE MPLTINFO-COMPANY TO  DISP-COMPANY-1.
054600
054700 61-SHOWFORM-SCREEN-1A.
           MOVE SCREEN-1       TO DISPLAY-REC.
           PERFORM 998-WRITE-SCREEN THRU 998-READ-SCREEN.
           MOVE DISPLAY-REC    TO SCREEN-1.
056300     IF VIEW-LASTKEY = 3
056400         GO TO 61-ADC-X
056500     ELSE
057900     IF VIEW-LASTKEY = 1 OR
058000                       2 OR
058100                       4 OR
058200                       5 OR
058300                       6 OR
058400                       7 OR
                             8
      *M------  INVALID FUNCTION KEY
058600         MOVE   9 TO LANG-SETNUM
058600         MOVE  10 TO LANG-MSGNUM
058700         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
058800         MOVE 2  TO  FIELD-NUMBER
058900         PERFORM 4-PGM-ERROR  THRU  4-PGM-ERROR-X
059000         GO TO 61-SHOWFORM-SCREEN-1A.

           IF DE-DEPT = SPACES
      *M-----  NO DATA ENTERED HIT 'RESET' AND TRY AGAIN
076900         MOVE  66120 TO CATREAD-MSG-NUMBER
077100         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
077200         MOVE 2  TO  FIELD-NUMBER
077300         PERFORM 4-PGM-ERROR  THRU  4-PGM-ERROR-X
077400         GO TO 61-SHOWFORM-SCREEN-1A.
059100
061300 61-EDIT-DEPT-1A.
061400     MOVE DE-DEPT                TO  DP-DATA-CLASS-CODE.
061500     MOVE BUILD-DEPT             TO  MVALIDPLT-ARG.
           MOVE MVALIDPLT-ARG TO VALDTAKEY OF MVALIDPLTDATA-REC-O.
           READ MVALIDPLTDATA-O INTO BUF-MVALIDPLTDATA
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
062100             NEXT SENTENCE
062200         ELSE
062300             MOVE "GET PLTDATA * 61-ED" TO BU-DISPLAY-MSG
062400             MOVE MVALIDPLT-ARG          TO BU-DISPLAY-FLD (1)
062600             GO TO 2-BLOWUP
062700     ELSE
      *M------  DEPARTMENT ALREADY EXISTS
062800         MOVE   4 TO LANG-SETNUM
062900         MOVE  11 TO LANG-MSGNUM
063000         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
063100         MOVE MESSAGE-BUFFER TO MSG-TEXT
063200         MOVE DE-DEPT  TO  MSG-FLD
063300         MOVE 2        TO  FIELD-NUMBER
063400         PERFORM 4-PGM-ERROR  THRU  4-PGM-ERROR-X
      *--------- DO A START > HIGH-VALUES TO UNLOCK
               MOVE HIGH-VALUES TO VALDTAKEY OF MVALIDPLTDATA-REC-O
               START MVALIDPLTDATA-O KEY > VALDTAKEY OF
                   MVALIDPLTDATA-REC-O
                       INVALID KEY MOVE "0" TO FILE-STATUS
063500         GO TO 61-SHOWFORM-SCREEN-1A.
063600
      *-----  THIS PARAGRAPH EDITS THE COMPANY AND PRIME ENTRY TO BE
      *       LINKED TO THE DEPARTMENT ENTRY.  COMPANY AND PRIME ARE
      *       BOTH REQUIRED TO MAKE A LINKAGE.  IF BOTH ARE NOT PRESENT
      *       THE LINKAGE WILL NOT OCCUR.
       61-EDIT-LINKAGE.
           IF DE-CO-PR = SPACES
               MOVE SPACES      TO  VALID-DATA-CO-PR
               GO TO 61-PUT-DEPT-1A.

           IF DE-LINK-COMP = SPACES
      *M----- "COMPANY IS A REQUIRED FIELD
062800         MOVE   3 TO LANG-SETNUM
062900         MOVE 196 TO LANG-MSGNUM
063000         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
063300         MOVE   5 TO  FIELD-NUMBER
063400         PERFORM 4-PGM-ERROR  THRU  4-PGM-ERROR-X
063500         GO TO 61-SHOWFORM-SCREEN-1A.

075000     MOVE DE-LINK-COMP           TO  CO-DATA-CLASS-CODE.
075100     MOVE BUILD-COMPANY          TO  MVALIDPLT-ARG.
           MOVE MVALIDPLT-ARG TO VALDTAKEY OF MVALIDPLTDATA-REC-O.
           READ MVALIDPLTDATA-O INTO BUF-MVALIDPLTDATA
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
      *M----- CODE DOES NOT EXIST
075700             MOVE  29 TO LANG-SETNUM
