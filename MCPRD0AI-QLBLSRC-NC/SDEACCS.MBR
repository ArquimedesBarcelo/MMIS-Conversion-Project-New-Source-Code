134000*********************************************************
134100*                                                       *
134200*   PUT AN ENTRY OUT TO MCLASS                          *
134300*                                                       *
134400*********************************************************
       660-PUT-MCLASS.
           MOVE 0 TO COND-WORD.
           WRITE MCLASS-REC-O FROM BUF-MCLASS
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD.

           IF NOT GOOD-CALL
               MOVE "DBPUT MCLASS * 660-PUT-MCLASS"
                   TO BU-DISPLAY-MSG
               GO TO 2-BLOWUP.

       660-PM-X.
           EXIT.

134000*********************************************************
134100*                                                       *
134200*   DELETE AN ENTRY IN  MCLASS                          *
134300*                                                       *
134400*********************************************************
       661-DELETE-MCLASS.
           MOVE 0 TO COND-WORD.
           DELETE MCLASS-O
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD.

           IF NOT GOOD-CALL
               MOVE "DBDELETE MCLASS * 661-DELETE-MCLASS"
                   TO BU-DISPLAY-MSG
               GO TO 2-BLOWUP.

       661-DM-X.
           EXIT.

       661-DELETE-RESTRICTIONS.
           MOVE DE-CLASS TO HOLD-RESTRICT.
           MOVE "C" TO HOLD-RESTRICT-8.
           MOVE HOLD-RESTRICT TO CORPCDE OF DRESTRICT.
           READ DRESTRICT
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS = "00"
               DELETE DRESTRICT
                   INVALID KEY MOVE FILE-STATUS TO FILE-STATUS
               END-DELETE
               IF FILE-STATUS NOT = "00"
                 MOVE "DBDELETE DRESTRICT * 661-DELETE-RESTRICTIONS"
                   TO BU-DISPLAY-MSG
                 GO TO 2-BLOWUP.
       661-DR-X.
           EXIT.

134000*********************************************************
134100*                                                       *
134200*   UPDATE AN ENTRY IN  MCLASS                          *
134300*                                                       *
134400*********************************************************
       662-UPDATE-MCLASS.
           MOVE 0 TO COND-WORD.
           REWRITE MCLASS-REC-O FROM BUF-MCLASS
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD.

           IF NOT GOOD-CALL
               MOVE "DBUPDATE MCLASS * 661-UPDATE-MCLASS"
                   TO BU-DISPLAY-MSG
               GO TO 2-BLOWUP.

       662-UM-X.
           EXIT.

