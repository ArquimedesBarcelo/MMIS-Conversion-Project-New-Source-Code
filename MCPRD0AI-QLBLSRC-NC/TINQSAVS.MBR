000200 IDENTIFICATION DIVISION.
000300 PROGRAM-ID. TINQSAVS.
000400 ENVIRONMENT DIVISION.
000500 CONFIGURATION SECTION.
000600 SOURCE-COMPUTER.   AS400.
000700 OBJECT-COMPUTER.   AS400.
       SPECIAL-NAMES. I-O-FEEDBACK IS I-O-FEEDBACK-AREA
                      LOCAL-DATA IS LOCAL-DATA-AREA.
001000 INPUT-OUTPUT SECTION.
001100 FILE-CONTROL.
           SELECT DISPLAY-FILE
               ASSIGN TO WORKSTATION-ZINQUIRY-SI
               ORGANIZATION IS TRANSACTION
               ACCESS IS SEQUENTIAL
               FILE STATUS IS DSPLY-STATUS
               CONTROL-AREA IS WS-CONTROL.
           SELECT EQUIPMENT-FILE
               ASSIGN TO DATABASE-MCFLMM0201
               ORGANIZATION IS INDEXED
               ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
               FILE STATUS IS EF-STATUS.
001200     SELECT OUT-FILE
               ASSIGN TO DATABASE-QINQSAVS
               ORGANIZATION IS RELATIVE
001300         ACCESS MODE IS RANDOM
001400         RELATIVE KEY IS ACT-KEY
               FILE STATUS IS OF-STATUS.
001600     SELECT PRINT-FILE
001700         ASSIGN TO PRINTER-MCPRT.
001500     SELECT SORT-FILE
               ASSIGN TO DISK-SORTFILE.
           SELECT WO-PLANNED-FILE
               ASSIGN TO DATABASE-MCFLMM1102
               ORGANIZATION IS INDEXED
               ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY WITH DUPLICATES
               FILE STATUS IS WPF-STATUS.
001800 DATA DIVISION.
001900 FILE SECTION.
       FD  DISPLAY-FILE
           LABEL RECORDS ARE OMITTED.
       01  DSPLY-REC                      PIC X(2000).
       FD  EQUIPMENT-FILE
           LABEL RECORDS ARE STANDARD
           DATA RECORD IS EFREC.
       01  EFREC.
           COPY DDS-ALL-FORMATS OF MCFLMM0201.
002500 FD  OUT-FILE
002600     RECORD CONTAINS 80 CHARACTERS
002700     LABEL RECORDS ARE OMITTED
002800     DATA RECORD IS OUTF.
002900 01  OUTF.
           05  OUT-DATA.
003000         10  OUT-WO                  PIC X(10).
003100         10  OUT-DESC                PIC X(30).
003200         10  OUT-PLANNER             PIC X(4).
003300         10  OUT-ENGINEER            PIC X(4).
003400         10  OUT-SCHEDULER           PIC X(4).
003500         10  OUT-ZONE                PIC X(4).
003600         10  OUT-EQPNUM              PIC X(6).
003700         10  FILLER                  PIC X(18).
002000 FD  PRINT-FILE
002100     RECORD CONTAINS 80 CHARACTERS
002200     LABEL RECORDS ARE OMITTED
002300     DATA RECORD IS PRINTF.
002400 01  PRINTF                          PIC X(80).
003800 SD  SORT-FILE
003900     RECORD CONTAINS 80 CHARACTERS
004000     DATA RECORD IS SORTF.
004100 01  SORTF.
004200     05  SORT-WO                     PIC X(10).
004300     05  SORT-DESC                   PIC X(30).
004400     05  SORT-PLANNER                PIC X(4).
004500     05  SORT-ENGINEER               PIC X(4).
004600     05  SORT-SCHEDULER              PIC X(4).
004700     05  SORT-ZONE                   PIC X(4).
004800     05  SORT-EQPNUM                 PIC X(6).
004900     05  FILLER                      PIC X(18).
       FD  WO-PLANNED-FILE
           LABEL RECORDS ARE STANDARD
           DATA RECORD IS WPFREC.
       01  WPFREC.
           COPY DDS-ALL-FORMATS OF MCFLMM1102.
005000 WORKING-STORAGE SECTION.
       77  ARG-DEF                         PIC XX.
005300 77  REL-RECS-CTR                    PIC 9(4).
005400 77  SUB1                            PIC S9(4) COMP-4.
005500 01  ACT-KEY                         PIC 9(9).
       COPY CPYIND  IN COPYLIB.
006800 01  EQP-EQUIPMENT.        COPY MEQPFILE OF COPYLIB.
006900 01  ERROR-BUFFER.
007000     05  ERROR-LIT                   PIC X(26).
007100     05  ERROR-NUM                   PIC 9(4).
007200     05  FILLER                      PIC X(42).
007300     05  ERROR-DELAY                 PIC X(6).
007400     05  FILLER                      PIC XX.
007500 01  ERROR-SWITCH                    PIC S9(4) COMP-4.
       01  FILE-STATUSES.
           05  DSPLY-STATUS                PIC XX.
           05  EF-STATUS                   PIC XX.
           05  OF-STATUS                   PIC XX.
           05  WPF-STATUS                  PIC XX.
       COPY IOFEEDBACK IN COPYLIB.
       COPY OVRPFDATA IN COPYLIB.
007800 01  SCREEN-IN.
           05  SCREEN-DATA.
007900         10  SCREEN-PL               PIC X(4).
008000         10  SCREEN-EN               PIC X(4).
008100         10  SCREEN-SC               PIC X(4).
008200         10  SCREEN-ZON              PIC X(4).
008300         10  SCREEN-EQUIP            PIC X(6).
           05  SCREEN-CMD-IN               PIC X(79).
           05  SCREEN-ERR-IN               PIC X(79).
008500 01  SCREEN-OUT.
008600     05  SCREEN-LINES OCCURS 16 TIMES.
008700         10  SCREEN-WO               PIC X(10).
008800         10  FILLER                  PIC XX.
008900         10  SCREEN-DESC             PIC X(30).
009000         10  FILLER                  PIC XX.
009100         10  SCREEN-PLANNER          PIC X(4).
009200         10  FILLER                  PIC XX.
009300         10  SCREEN-ENGINEER         PIC X(4).
009400         10  FILLER                  PIC XX.
009500         10  SCREEN-SCHEDULER        PIC X(4).
009600         10  FILLER                  PIC XX.
009700         10  SCREEN-ZONE             PIC X(4).
009800         10  FILLER                  PIC XX.
009900         10  SCREEN-EQPNUM           PIC X(6).
010000         10  FILLER                  PIC X(5).
010100     05  SCREEN-MESSAGE              PIC X(79).
           05  SCREEN-CMD-OUT              PIC X(79).
           05  SCREEN-ERR-OUT              PIC X(79).
       COPY DBSTAT OF COPYLIB.
       01  TRUE-VAL                        PIC 1 VALUE B"1".
010700 01  WO-PLANNED-DATA.      COPY DWOPLAN OF COPYLIB.
       COPY WSCONTROL IN COPYLIB.
010800 LINKAGE SECTION.
011500 01  DBPARAMETERS.         COPY DBPARMS OF COPYLIB.
       COPY VCOMLINK OF COPYLIB.
       COPY CATREAD  OF COPYLIB.
011800 PROCEDURE DIVISION USING DBPARAMETERS VIEW-COMAREA
011900                      CATREAD-PARMS.
012000 STARTUP.
012100     PERFORM 1-HSK.
012200     PERFORM 6-MAIN THRU 6-MAIN-EXIT.
012300 2-EOJ.
           CLOSE DISPLAY-FILE.
           CLOSE EQUIPMENT-FILE.
012400     CLOSE OUT-FILE.
           IF REL-RECS-CTR > 0 CLOSE PRINT-FILE.
           CLOSE WO-PLANNED-FILE.
012500     GOBACK.
012600 1-HSK.
           OPEN I-O   DISPLAY-FILE.
           OPEN INPUT EQUIPMENT-FILE.
012800     OPEN OUTPUT OUT-FILE.
           OPEN INPUT WO-PLANNED-FILE.
           MOVE SPACES TO ERROR-BUFFER.
012900 6-MAIN.
           MOVE SPACES TO SCREEN-IN.
013000     MOVE "FINQSAVS" TO VIEW-CFNAME.
           MOVE ERROR-BUFFER TO SCREEN-ERR-IN.
           MOVE SCREEN-IN TO DSPLY-REC.
           PERFORM 99-SCREEN-WRITE.
           PERFORM 98-SCREEN-READ.
           MOVE SPACES TO ERROR-BUFFER.
           MOVE DSPLY-REC TO SCREEN-IN.
014300     IF VIEW-LASTKEY = 3 GO TO 2-EOJ.
016100     IF SCREEN-EQUIP = "      "
016200         NEXT SENTENCE
016300     ELSE
           PERFORM 69-START-EQUIPMENT-FILE
016800     IF COND-WORD = 0
016900         NEXT SENTENCE
017000     ELSE
017300     MOVE 31010 TO CATREAD-MSG-NUMBER
017500     PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
           MOVE TRUE-VAL TO INDS (5) INDS (99)
           GO TO 6-MAIN.
017900     SORT SORT-FILE ON ASCENDING KEY SORT-WO
018000         INPUT PROCEDURE  7-GET-RECORDS
018100         OUTPUT PROCEDURE 8-WRITE-RECORDS.
018200     MOVE 0 TO ACT-KEY.
018300     MOVE 0 TO SUB1.
018400     MOVE SPACES TO SCREEN-OUT.
018500     MOVE "FOUTSAVS" TO VIEW-CFNAME.
018700     IF REL-RECS-CTR = 0
018800         MOVE 40022 TO CATREAD-MSG-NUMBER
019000         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
019100         MOVE ERROR-BUFFER TO SCREEN-MESSAGE
               MOVE SCREEN-OUT TO DSPLY-REC
               PERFORM 99-SCREEN-WRITE
               PERFORM 98-SCREEN-READ
020400         GO TO 6-MAIN-EXIT.
           MOVE 0 TO COND-WORD.
           CLOSE OUT-FILE.
           OPEN INPUT OUT-FILE.
      *    MOVE 0                TO  OVRPRTF-TOFILE-NUM.
           MOVE "P "             TO  OVRPRTF-TOFILE-NUM-X.
           PERFORM 996-OVERRIDE-PRINT-FILE.
           OPEN OUTPUT PRINT-FILE.
020500 6-MAIN-READ-OUTF.
020600     ADD 1 TO ACT-KEY.
020700     IF ACT-KEY > REL-RECS-CTR
020800         MOVE 66122 TO CATREAD-MSG-NUMBER
021000         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
021100         MOVE ERROR-BUFFER TO SCREEN-MESSAGE
               MOVE SCREEN-OUT TO DSPLY-REC
               PERFORM 99-SCREEN-WRITE
               PERFORM 98-SCREEN-READ
               MOVE SPACES TO DSPLY-REC
021600         GO TO 2-EOJ.
021700     READ OUT-FILE     INVALID KEY
021800         MOVE 66122 TO CATREAD-MSG-NUMBER
022000         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
022100         MOVE ERROR-BUFFER TO SCREEN-MESSAGE
               MOVE SCREEN-OUT TO DSPLY-REC
               PERFORM 99-SCREEN-WRITE
               PERFORM 98-SCREEN-READ
               MOVE SPACES TO DSPLY-REC
021600         GO TO 2-EOJ.
022800     ADD 1 TO SUB1.
022900     MOVE OUT-WO           TO  SCREEN-WO (SUB1).
023000     MOVE OUT-DESC         TO  SCREEN-DESC (SUB1).
023100     MOVE OUT-PLANNER      TO  SCREEN-PLANNER (SUB1).
023200     MOVE OUT-ENGINEER     TO  SCREEN-ENGINEER (SUB1).
023300     MOVE OUT-SCHEDULER    TO  SCREEN-SCHEDULER (SUB1).
023400     MOVE OUT-ZONE         TO  SCREEN-ZONE (SUB1).
023500     MOVE OUT-EQPNUM       TO  SCREEN-EQPNUM (SUB1).
023600     IF SUB1 = 16
023700         MOVE 42071 TO CATREAD-MSG-NUMBER
023900         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
024000         MOVE ERROR-BUFFER TO SCREEN-MESSAGE
               MOVE SCREEN-OUT TO DSPLY-REC
               PERFORM 99-SCREEN-WRITE
               PERFORM 98-SCREEN-READ
024500         MOVE 0 TO SUB1
024600         MOVE SPACES TO SCREEN-OUT ERROR-BUFFER.
027400     GO TO 6-MAIN-READ-OUTF.
030100
030200 6-MAIN-EXIT.    EXIT.
030300
       69-START-EQUIPMENT-FILE.
           MOVE 0 TO COND-WORD.
           MOVE SCREEN-EQUIP TO EQPNUM OF EFREC.
           START EQUIPMENT-FILE KEY IS = EXTERNALLY-DESCRIBED-KEY
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF EF-STATUS NOT = "00" MOVE 17 TO COND-WORD.

       98-SCREEN-READ.
           READ DISPLAY-FILE FORMAT IS VIEW-CFNAME
               INDIC IS INDICS.
           ACCEPT IOFEEDBACK FROM I-O-FEEDBACK-AREA.
           MOVE ALL B"0" TO INDICS.
           IF DSPLY-STATUS NOT = "00"
               MOVE 3 TO VIEW-LASTKEY
           ELSE
           MOVE FUNCTION-NUM TO VIEW-LASTKEY.

       99-SCREEN-WRITE.
           WRITE DSPLY-REC FORMAT IS VIEW-CFNAME
               INDIC IS INDICS.
           MOVE ALL B"0" TO INDICS.

       COPY OVRPFCALL IN COPYLIB.

030400 999-CATREAD.
030500     MOVE SPACES TO ERROR-BUFFER.
           CALL "CCATREAD" USING CATREAD-PARMS.
           MOVE CATREAD-MSG-TEXT TO ERROR-BUFFER.
031400 999-CATREAD-EXIT.    EXIT.
031500
031600 7-GET-RECORDS.
           PERFORM 7-GET-RECS THRU 7-GR-EXIT.
       7-GET-RECS.
032000     MOVE 0 TO REL-RECS-CTR.
           MOVE 0 TO COND-WORD.
032300     MOVE "FF" TO ARG-DEF.
           MOVE ARG-DEF TO WOSTATUS OF WPFREC.
032400     START WO-PLANNED-FILE KEY IS = EXTERNALLY-DESCRIBED-KEY
032500         INVALID KEY    MOVE 17 TO COND-WORD.
032600     IF COND-WORD = 17 GO TO 7-GR-EXIT.
032700 7-GR-CONT.
032800     READ WO-PLANNED-FILE NEXT INTO WO-PLANNED-DATA
032900         AT END    MOVE 15 TO COND-WORD.
           IF WO-STATUS-P NOT = ARG-DEF
               MOVE 15 TO COND-WORD.
033100     IF COND-WORD = 15 GO TO 7-GR-EXIT.
033300     IF SAVE-HIST-SW = "  " GO TO 7-GR-CONT.
           IF SCREEN-DATA = SPACES
               PERFORM 7-GR-CONT-1
               GO TO 7-GR-CONT.
033400     IF SCREEN-PL = "    "
033500         NEXT SENTENCE
033600     ELSE
033700     IF SCREEN-PL = PLANNER-P
033800         PERFORM 7-GR-CONT-1
033900         GO TO 7-GR-CONT.
034000     IF SCREEN-EN = "    "
034100         NEXT SENTENCE
034200     ELSE
034300     IF SCREEN-EN = ENGINEER-P
034400         PERFORM 7-GR-CONT-1
034500         GO TO 7-GR-CONT.
034600     IF SCREEN-SC = "    "
034700         NEXT SENTENCE
034800     ELSE
034900     IF SCREEN-SC = SCHEDULER-P
035000         PERFORM 7-GR-CONT-1
035100         GO TO 7-GR-CONT.
035200     IF SCREEN-ZON = "    "
035300         NEXT SENTENCE
035400     ELSE
035500     IF SCREEN-ZON = ZONE-P
035600         PERFORM 7-GR-CONT-1
035700         GO TO 7-GR-CONT.
035800     IF SCREEN-EQUIP = "      "
035900         NEXT SENTENCE
036000     ELSE
036100     IF SCREEN-EQUIP = EQUIP-NUM-P
036200         PERFORM 7-GR-CONT-1.
036300     GO TO 7-GR-CONT.
036400
036500 7-GR-CONT-1 .
036600     MOVE SPACES TO SORTF.
036700     MOVE WO-NUM-PLANNED TO SORT-WO.
036800     MOVE DESCRIPTION-1-P TO SORT-DESC.
037000     MOVE PLANNER-P TO SORT-PLANNER.
037100     MOVE ENGINEER-P TO SORT-ENGINEER.
037200     MOVE SCHEDULER-P TO SORT-SCHEDULER.
037300     MOVE ZONE-P TO SORT-ZONE.
036900     MOVE EQUIP-NUM-P TO SORT-EQPNUM.
037400     RELEASE SORTF.
037500     ADD 1 TO REL-RECS-CTR.
037600
037700 7-GR-EXIT.    EXIT.
037800
037900 8-WRITE-RECORDS.
           MOVE 0 TO ACT-KEY.
           PERFORM 8-WR-CONT THRU 8-WR-EXIT.
       8-WR-CONT.
038000     RETURN SORT-FILE AT END GO TO 8-WR-EXIT.
038100     MOVE SPACES TO OUTF.
038400     ADD 1 TO ACT-KEY.
038200     MOVE SORTF TO OUT-DATA.
038300     WRITE OUTF    INVALID KEY GO TO 8-WR-EXIT.
038500     GO TO 8-WR-CONT.
038600 8-WR-EXIT.    EXIT.
