052800 400-GET-DTRANS.
           READ DTRANS-O NEXT INTO BUF-DTRANS
               AT END MOVE "Y" TO DTRANS-EOF-SW.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   NEXT SENTENCE
               ELSE
                   MOVE "READ DTRANS * 400-GD" TO
                        BU-DISPLAY-MSG
                   PERFORM 990-BLOWUP.

052800 400-GET-FIRST-DTRANS.
           READ DTRANS-O FIRST INTO BUF-DTRANS
               AT END MOVE "Y" TO DTRANS-EOF-SW.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   NEXT SENTENCE
               ELSE
                   MOVE "READ FIRST DTRANS * 400-GFD" TO
                        BU-DISPLAY-MSG
                   PERFORM 990-BLOWUP.

       400-GET-DPOITEM.
           READ DPOITEM-I NEXT INTO BUF-DPOITEM
               AT END MOVE "Y" TO DPOITEM-EOF-SW.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   NEXT SENTENCE
               ELSE
                   MOVE "READ DPOITEM * 400-GD" TO
                        BU-DISPLAY-MSG
                   PERFORM 990-BLOWUP.

       400-GET-FIRST-DPOITEM.
           READ DPOITEM-I FIRST INTO BUF-DPOITEM
               AT END MOVE "Y" TO DPOITEM-EOF-SW.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   NEXT SENTENCE
               ELSE
                   MOVE "READ FIRST DPOITEM * 400-GFD" TO
                        BU-DISPLAY-MSG
                   PERFORM 990-BLOWUP.

