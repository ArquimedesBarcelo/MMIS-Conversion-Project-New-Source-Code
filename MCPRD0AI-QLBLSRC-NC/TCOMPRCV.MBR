027700 PROCEDURE DIVISION.
027800
027900 001-BEGIN SECTION.
028000
028100 010-MAINLINE.
           PERFORM 1000-OPEN-FILES.
028200     SORT SORT-FILE ON ASCENDING KEY SORT-STORES-CODE
028300                                     SORT-PO-NUM
028400                                     SORT-ITEM-NUM
028500                                     SORT-DATA-BASE-INDIC
028600     INPUT PROCEDURE IS 050-PROCESS-TRANS
028700     OUTPUT PROCEDURE IS 700-CREATE-REPORT.
028800     PERFORM 1000-CLOSE-FILES.
028900     GOBACK.
029100
029200 050-PROCESS-TRANS SECTION.
       050-BEGIN.
029300     PERFORM 100-BEGIN.
029400     PERFORM 200-PROCESS-DTRANS
029500         UNTIL DTRANS-EOF-SW = "Y".
029600
      *    MOVE DUMMY-ARG TO CORPCDE OF DPOITEM-REC-I.
      *    START DPOITEM-I KEY > CORPCDE OF DPOITEM-REC-I
      *        INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
      *    IF FILE-STATUS NOT = "00"
      *        IF FILE-STATUS-1 = "2"
      *            GO TO 699-PROCESS-EXIT
      *        ELSE
      *            MOVE "START DPOITEM * 050-PTS" TO BU-DISPLAY-MSG
      *            PERFORM 990-BLOWUP.

           PERFORM 400-GET-FIRST-DPOITEM.
029800     PERFORM 300-PROCESS-DPOITEM
029900         UNTIL DPOITEM-EOF-SW = "Y".
030000
030100**********************************************************
030200*  TRANSFER CONTROL TO LAST STATEMENT IN INPUT PROCEDURE *
030300*  FOR SORTING OF RECORDS.                               *
030400**********************************************************
030500
030600     GO TO 699-PROCESS-EXIT.
030700
030800 100-BEGIN.
030900     DISPLAY "UPDATE CODES OUT OF BALANCE? (YES OR NO)".
031000     ACCEPT UPDATE-RESPONSE.
031100     DISPLAY UPDATE-RESPONSE.
031200     IF UPDATE-RESPONSE = "YES" OR "NO"
031300         NEXT SENTENCE
031400     ELSE
031500         MOVE "INVALID RESPONSE TO UPDATE QUESTION"
031600             TO BU-DISPLAY-MSG
031700         MOVE UPDATE-RESPONSE  TO BU-DISPLAY-FLD (1)
031800         PERFORM 990-BLOWUP.
031900
032000     DISPLAY "IS THIS AN INITIAL LOAD? (YES OR NO)".
032100     ACCEPT INIT-LOAD-SW.
032200     DISPLAY INIT-LOAD-SW.
032300     IF INIT-LOAD-SW = "YES" OR "NO"
032400         NEXT SENTENCE
032500     ELSE
032600         MOVE "INVALID RESPONSE TO INITIAL LOAD QUESTION"
032700             TO BU-DISPLAY-MSG
032800         MOVE INIT-LOAD-SW  TO BU-DISPLAY-FLD (1)
032900         PERFORM 990-BLOWUP.
035200
035300****************************************************
035400**   GET OVERAGE PO PREFIX FROM MPLTINFO          **
035500**   KEY IS EQUAL TO 'ITOV'.  IF IT DOES NOT      **
035600**   EXIST THEN 'PITOV' IS THE OVERAGE PO PREFIX. **
035700****************************************************
035800
035900     MOVE "ITOV" TO MPLTINFO-ARG.
           MOVE MPLTINFO-ARG TO PLTINFOKEY OF MPLTINFO-REC-I.
           READ MPLTINFO-I INTO BUF-MPLTINFO
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
036200     IF FILE-STATUS = "00"
036300         MOVE MPLTINFO-DATA TO SAVE-OV-PO-PREFIX
036400     ELSE
036500         MOVE "PITOV"       TO SAVE-OV-PO-PREFIX.
036600     DISPLAY "SAVE-OV-PO-PREFIX= ", SAVE-OV-PO-PREFIX.
036700
036800****************************************************
036900**   GET STOREROOM DEPT FROM MACCOUNT-INFO        **
037000**   KEY IS EQUAL TO 'SDPT'.  THE STOREROOM DEPT. **
037100****************************************************
037200
037300     MOVE "SDPT" TO MACCT-KEY.
           MOVE MACCT-KEY TO INFOKEY OF MACTINFO-REC-I.
           READ MACTINFO-I INTO BUF-MACCT-INFO
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
038100     IF FILE-STATUS = "00"
038200         MOVE MACCT-STR-DEPT      TO  SAVE-STR-DEPT
038300     ELSE
038400         MOVE "GET MACCOUNT-INFO 'SDPT'* 100"
038500               TO BU-DISPLAY-MSG
038600         MOVE MACCT-KEY           TO  BU-DISPLAY-FLD (1)
038700         PERFORM 990-BLOWUP.
038800
038900     DISPLAY "SAVE-STR-DEPT=", SAVE-STR-DEPT.
039000
      *    MOVE DUMMY-ARG TO PONUM OF DTRANS-REC-O.
      *    START DTRANS-O KEY > PONUM OF DTRANS-REC-O
      *        INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
      *    IF FILE-STATUS NOT = "00"
      *        IF FILE-STATUS-1 NOT = "2"
      *            MOVE "START DTRANS * 100-B" TO
      *                 BU-DISPLAY-MSG
      *            PERFORM 990-BLOWUP.

           PERFORM 400-GET-FIRST-DTRANS.
039200
039400 200-PROCESS-DTRANS.
039500     IF TRANS-CODE = "INV" OR "DCHG" OR "REC"
039600         IF TRANS-BALANCE-QTY > 0
039700             MOVE TRANS-STORES-CODE  TO SORT-STORES-CODE
039800             MOVE TRANS-PO-NUM       TO SORT-PO-NUM
039900             MOVE TRANS-ITEM-NUM     TO SORT-ITEM-NUM
040000             MOVE TRANS-RCVR-NUM     TO SORT-RCVR-NUM
040100             MOVE TRANS-BALANCE-QTY  TO SORT-BALANCE-QTY
040200             COMPUTE SORT-UNIT-PRICE ROUNDED =
040300                 TRANS-VALUE / TRANS-QTY
040400             MOVE TRANS-CODE         TO SORT-TYPE
040500             MOVE TRANS-CLASS        TO SORT-CLASS
040600             MOVE TRANS-DEPT         TO SORT-DEPT
040700             MOVE TRANS-ACCT         TO SORT-ACCOUNT
040800             MOVE TRANS-UNIT-MEASURE TO SORT-UM
040900             MOVE "CSAS"             TO SORT-DATA-BASE-INDIC
041000             RELEASE SORT-REC.
041100
041200     PERFORM 400-GET-DTRANS.
041300
041400 300-PROCESS-DPOITEM.
041500     MOVE ITM-PO-NO TO SAVE-PO-NO.
041600     IF SAVE-PO-NO1-4 = SAVE-OV-PO-PREFIX2-5
