                               PIC 99.
           05  REST-NS.
               10  R-A         PIC X.
               10  R-B         PIC X.
               10  R-C         PIC X.
               10  R-D         PIC X.

       01  MO-DATA.
           05  WEEK-1          PIC X(21).
           05  WEEK-2          PIC X(21).
           05  WEEK-3          PIC X(21).
           05  WEEK-4          PIC X(21).
           05  WEEK-5          PIC X(21).
           05  WEEK-6          PIC X(06).

       01  HEADER.
           05  HD-MONTH        PIC X(09)  VALUE SPACES.
           05  FILLER          PIC X(02)  VALUE SPACES.
           05  HD-YEAR         PIC X(04)  VALUE SPACES.
           05  FILLER          PIC X(29)
               VALUE     "                EQUIPMENT:  ".
           05  HD-EQUIP        PIC X(06)  VALUE SPACES.

       01  BU-DISPLAY-AREA.
           05  FILLER                 PIC XX.
           05  BU-DISPLAY-MSG         PIC X(27).
           05  FILLER                 PIC XX.
           05  BU-DISPLAY-STAT        PIC S9(4).
           05  FILLER                 PIC XX.
           05  BU-DISPLAY-FLD         PIC X(14).
           05  FILLER                 PIC XX.

       01  MESSAGE-DATA.
           COPY ERRORLIN       IN COPYLIB.

       01  PM-SCHED-DATA.
           COPY DPMSCHED       IN COPYLIB.

           COPY DAYTABLE       IN COPYLIB.

           COPY VCOMLINK       IN COPYLIB.

       LINKAGE SECTION.
       01  LINK-DATA.
           05 LINK-EQUIP           PIC X(06).
           05 LINK-WONUM           PIC X(10).
           05 LINK-ZONE-PRI        PIC X(06).
           05 LINK-YRMO.
               10 LINK-DATA-X.
                   15  LD-YEAR     PIC X(04).
                   15  LD-MONTH    PIC X(02).
               10 LINK-DATA-9 REDEFINES LINK-DATA-X.
                   15  LD-YR       PIC 9(04).
                   15  LD-YRB REDEFINES LD-YR.
                       20  LDYR3   PIC 9(03).
                       20  LDYRL   PIC 9.
                   15  LD-MON      PIC 9(02).

       01  DBPARAMETERS.
           COPY DBPARMS        IN COPYLIB.

           COPY LANGSUB        IN COPYLIB.

       PROCEDURE DIVISION USING LINK-DATA
                                DBPARAMETERS
                                LANGUAGE-PARMS.
       BEGIN-PROC.
           OPEN INPUT PM-SCHEDULE.
           OPEN I-O   DISPLAY-FILE.

           MOVE "VCALNDRDSP"   TO SCREEN-NAME.
           MOVE SPACES         TO SCREEN-DATA MESSAGE-BUFFER
                                  PM-SCHED-DATA SAVE-DATA
                                  END-SW.

           PERFORM GET-SCREEN-DATA THRU GSD-EXIT.
           IF MESSAGE-BUFFER NOT = SPACES
             MOVE MESSAGE-BUFFER  TO ERRMSG.


       SHOWFORM.
           MOVE SCREEN-DATA     TO DISPLAY-REC.

           WRITE DISPLAY-REC  FORMAT IS SCREEN-NAME
               INDIC ARE SCREEN-INDICATORS.
           IF SCREEN-STATUS NOT = "00"
               DISPLAY "SCREEN WRITE ERROR.  SCREEN-STATUS IS "
                        SCREEN-STATUS
               GO TO END-OF-JOB.

           READ  DISPLAY-FILE FORMAT IS SCREEN-NAME
               INDIC ARE SCREEN-INDICATORS
           IF SCREEN-STATUS NOT = "00"
               DISPLAY "SCREEN READ ERROR.  SCREEN-STATUS IS "
                        SCREEN-STATUS
               GO TO END-OF-JOB.

           MOVE ALL B"0"       TO SCREEN-INDICATORS.
           MOVE DISPLAY-REC    TO SCREEN-DATA.

           IF KEY-HIT      = 3 OR 8
               GO TO END-OF-JOB.

           IF KEY-HIT      = 1
               PERFORM SUBTRACT-MONTH
               MOVE MESSAGE-BUFFER TO ERRMSG
               GO TO SHOWFORM.

           IF KEY-HIT      = 2
               PERFORM ADD-MONTH
               MOVE MESSAGE-BUFFER TO ERRMSG
               GO TO SHOWFORM.

           IF KEY-HIT = 6
               MOVE SPACES TO SCREEN-DATA
               CALL "SPMEXPND" USING LINK-DATA
                                     DBPARAMETERS
                                     LANGUAGE-PARMS
               MOVE "VCALNDRDSP" TO SCREEN-NAME
               MOVE MESSAGE-BUFFER TO ERRMSG
               PERFORM GET-SCREEN-DATA THRU GSD-EXIT
               GO TO SHOWFORM.

           IF KEY-HIT = 7
               MOVE 45         TO HELP-SW
               CALL "SPMHELPM" USING HELP-SW
               GO TO SHOWFORM.

           PERFORM EDIT-SCREEN THRU ES-EXIT.

           IF SCREEN-NAME NOT = "VCALNDRDSP"
               MOVE "VCALNDRDSP" TO SCREEN-NAME.

           GO TO SHOWFORM.

       ADD-MONTH.
           MOVE LINK-YRMO      TO SAVE-DATA.
           ADD 1               TO LD-MON.
           IF LD-MON > 12
             MOVE 1          TO LD-MON
             ADD  1          TO LD-YR.
           MOVE SPACES         TO SCREEN-DATA MO-ERROR.
           PERFORM GET-SCREEN-DATA THRU GSD-EXIT.
           IF MO-ERROR NOT = SPACES
             MOVE SAVE-DATA  TO LINK-YRMO
             MOVE SPACES     TO SCREEN-DATA
             PERFORM GET-SCREEN-DATA THRU GSD-EXIT
               MOVE MO-NAME        TO HD-MONTH
               MOVE LD-YEAR        TO HD-YEAR
               MOVE LINK-EQUIP     TO HD-EQUIP
               MOVE HEADER         TO SD-TITLE
               MOVE WEEK-1         TO SD-WK1
               MOVE WEEK-2         TO SD-WK2
               MOVE WEEK-3         TO SD-WK3
               MOVE WEEK-4         TO SD-WK4
               MOVE WEEK-5         TO SD-WK5
               MOVE WEEK-6         TO SD-WK6
               MOVE SPACES         TO MO-ERROR DAY-TABLE-DATA
               CALL "SPMMODAT" USING DAY-TABLE-DATA
                                   LINK-DATA
                                   DBPARAMETERS
                                   MO-ERROR
               IF MO-ERROR NOT = SPACES
                 MOVE MO-ERROR   TO MESSAGE-BUFFER
                 PERFORM 999-ERROR
               ELSE
                 PERFORM LOAD-LEVELS.

       SUBTRACT-MONTH.
           MOVE LINK-YRMO      TO SAVE-DATA.
           SUBTRACT 1          FROM LD-MON.
           IF LD-MON < 1
             MOVE 12         TO LD-MON
             SUBTRACT 1      FROM LD-YR.
           MOVE SPACES         TO SCREEN-DATA MO-ERROR.
           PERFORM GET-SCREEN-DATA THRU GSD-EXIT.
           IF MO-ERROR NOT = SPACES
             MOVE SAVE-DATA  TO LINK-YRMO
             MOVE SPACES     TO SCREEN-DATA
             PERFORM GET-SCREEN-DATA THRU GSD-EXIT
               MOVE MO-NAME        TO HD-MONTH
               MOVE LD-YEAR        TO HD-YEAR
               MOVE LINK-EQUIP     TO HD-EQUIP
               MOVE HEADER         TO SD-TITLE
               MOVE WEEK-1         TO SD-WK1
               MOVE WEEK-2         TO SD-WK2
               MOVE WEEK-3         TO SD-WK3
               MOVE WEEK-4         TO SD-WK4
               MOVE WEEK-5         TO SD-WK5
               MOVE WEEK-6         TO SD-WK6
               MOVE SPACES         TO MO-ERROR DAY-TABLE-DATA
               CALL "SPMMODAT" USING DAY-TABLE-DATA
                                   LINK-DATA
                                   DBPARAMETERS
                                   MO-ERROR
               IF MO-ERROR NOT = SPACES
                 MOVE MO-ERROR   TO MESSAGE-BUFFER
                 PERFORM 999-ERROR
               ELSE
                 PERFORM LOAD-LEVELS.

       GET-SCREEN-DATA.
           CALL "CALENDAR" USING LINK-YRMO
                                 MO-NAME
                                 MO-DATA
                                 MO-ERROR.
           IF MO-ERROR NOT = SPACES
               MOVE MO-ERROR   TO MESSAGE-BUFFER
               PERFORM 999-ERROR
               GO TO  GSD-EXIT.

           MOVE MO-NAME        TO HD-MONTH.
           MOVE LD-YEAR        TO HD-YEAR.
           MOVE LINK-EQUIP     TO HD-EQUIP.
           MOVE HEADER         TO SD-TITLE.
           MOVE WEEK-1         TO SD-WK1.
           MOVE WEEK-2         TO SD-WK2.
           MOVE WEEK-3         TO SD-WK3.
           MOVE WEEK-4         TO SD-WK4.
           MOVE WEEK-5         TO SD-WK5.
           MOVE WEEK-6         TO SD-WK6.

           MOVE SPACES         TO MO-ERROR DAY-TABLE-DATA.
           CALL "SPMMODAT" USING DAY-TABLE-DATA
                                 LINK-DATA
                                 DBPARAMETERS
                                 MO-ERROR.
           IF MO-ERROR NOT = SPACES
               MOVE MO-ERROR   TO MESSAGE-BUFFER
               PERFORM 999-ERROR
               GO TO GSD-EXIT.

           PERFORM LOAD-LEVELS.

       GSD-EXIT.    EXIT.

       LOAD-LEVELS.
           MOVE 0              TO SUB.
           IF SDWK11 NOT = "  "
               PERFORM LOAD-LEVEL-DATA
               MOVE R-SAVE     TO W1-R1
               MOVE W-SAVE     TO W1-L1.
           IF SDWK12 NOT = "  "
               PERFORM LOAD-LEVEL-DATA
               MOVE R-SAVE     TO W1-R2
               MOVE W-SAVE     TO W1-L2.
           IF SDWK13 NOT = "  "
               PERFORM LOAD-LEVEL-DATA
               MOVE R-SAVE     TO W1-R3
               MOVE W-SAVE     TO W1-L3.
           IF SDWK14 NOT = "  "
               PERFORM LOAD-LEVEL-DATA
               MOVE R-SAVE     TO W1-R4
               MOVE W-SAVE     TO W1-L4.
           IF SDWK15 NOT = "  "
               PERFORM LOAD-LEVEL-DATA
               MOVE R-SAVE     TO W1-R5
               MOVE W-SAVE     TO W1-L5.
           IF SDWK16 NOT = "  "
               PERFORM LOAD-LEVEL-DATA
               MOVE R-SAVE     TO W1-R6
               MOVE W-SAVE     TO W1-L6.
           IF SDWK17 NOT = "  "
               PERFORM LOAD-LEVEL-DATA
               MOVE R-SAVE     TO W1-R7
               MOVE W-SAVE     TO W1-L7.
           IF SDWK21 NOT = "  "
               PERFORM LOAD-LEVEL-DATA
               MOVE R-SAVE     TO W2-R1
               MOVE W-SAVE     TO W2-L1.
           IF SDWK22 NOT = "  "
               PERFORM LOAD-LEVEL-DATA
               MOVE R-SAVE     TO W2-R2
               MOVE W-SAVE     TO W2-L2.
           IF SDWK23 NOT = "  "
               PERFORM LOAD-LEVEL-DATA
               MOVE R-SAVE     TO W2-R3
               MOVE W-SAVE     TO W2-L3.
           IF SDWK24 NOT = "  "
               PERFORM LOAD-LEVEL-DATA
               MOVE R-SAVE     TO W2-R4
               MOVE W-SAVE     TO W2-L4.
           IF SDWK25 NOT = "  "
               PERFORM LOAD-LEVEL-DATA
               MOVE R-SAVE     TO W2-R5
               MOVE W-SAVE     TO W2-L5.
           IF SDWK26 NOT = "  "
               PERFORM LOAD-LEVEL-DATA
               MOVE R-SAVE     TO W2-R6
               MOVE W-SAVE     TO W2-L6.
           IF SDWK27 NOT = "  "
               PERFORM LOAD-LEVEL-DATA
               MOVE R-SAVE     TO W2-R7
               MOVE W-SAVE     TO W2-L7.
           IF SDWK31 NOT = "  "
               PERFORM LOAD-LEVEL-DATA
               MOVE R-SAVE     TO W3-R1
               MOVE W-SAVE     TO W3-L1.
           IF SDWK32 NOT = "  "
               PERFORM LOAD-LEVEL-DATA
               MOVE R-SAVE     TO W3-R2
               MOVE W-SAVE     TO W3-L2.
           IF SDWK33 NOT = "  "
               PERFORM LOAD-LEVEL-DATA
               MOVE R-SAVE     TO W3-R3
               MOVE W-SAVE     TO W3-L3.
           IF SDWK34 NOT = "  "
               PERFORM LOAD-LEVEL-DATA
               MOVE R-SAVE     TO W3-R4
               MOVE W-SAVE     TO W3-L4.
           IF SDWK35 NOT = "  "
               PERFORM LOAD-LEVEL-DATA
               MOVE R-SAVE     TO W3-R5
               MOVE W-SAVE     TO W3-L5.
           IF SDWK36 NOT = "  "
               PERFORM LOAD-LEVEL-DATA
               MOVE R-SAVE     TO W3-R6
               MOVE W-SAVE     TO W3-L6.
           IF SDWK37 NOT = "  "
               PERFORM LOAD-LEVEL-DATA
               MOVE R-SAVE     TO W3-R7
               MOVE W-SAVE     TO W3-L7.
           IF SDWK41 NOT = "  "
               PERFORM LOAD-LEVEL-DATA
               MOVE R-SAVE     TO W4-R1
               MOVE W-SAVE     TO W4-L1.
           IF SDWK42 NOT = "  "
               PERFORM LOAD-LEVEL-DATA
               MOVE R-SAVE     TO W4-R2
               MOVE W-SAVE     TO W4-L2.
           IF SDWK43 NOT = "  "
               PERFORM LOAD-LEVEL-DATA
               MOVE R-SAVE     TO W4-R3
               MOVE W-SAVE     TO W4-L3.
           IF SDWK44 NOT = "  "
               PERFORM LOAD-LEVEL-DATA
               MOVE R-SAVE     TO W4-R4
               MOVE W-SAVE     TO W4-L4.
           IF SDWK45 NOT = "  "
               PERFORM LOAD-LEVEL-DATA
               MOVE R-SAVE     TO W4-R5
               MOVE W-SAVE     TO W4-L5.
           IF SDWK46 NOT = "  "
               PERFORM LOAD-LEVEL-DATA
               MOVE R-SAVE     TO W4-R6
               MOVE W-SAVE     TO W4-L6.
           IF SDWK47 NOT = "  "
               PERFORM LOAD-LEVEL-DATA
               MOVE R-SAVE     TO W4-R7
               MOVE W-SAVE     TO W4-L7.
           IF SDWK51 NOT = "  "
               PERFORM LOAD-LEVEL-DATA
               MOVE R-SAVE     TO W5-R1
               MOVE W-SAVE     TO W5-L1.
           IF SDWK52 NOT = "  "
               PERFORM LOAD-LEVEL-DATA
               MOVE R-SAVE     TO W5-R2
               MOVE W-SAVE     TO W5-L2.
           IF SDWK53 NOT = "  "
               PERFORM LOAD-LEVEL-DATA
               MOVE R-SAVE     TO W5-R3
               MOVE W-SAVE     TO W5-L3.
           IF SDWK54 NOT = "  "
               PERFORM LOAD-LEVEL-DATA
               MOVE R-SAVE     TO W5-R4
               MOVE W-SAVE     TO W5-L4.
           IF SDWK55 NOT = "  "
               PERFORM LOAD-LEVEL-DATA
               MOVE R-SAVE     TO W5-R5
               MOVE W-SAVE     TO W5-L5.
           IF SDWK56 NOT = "  "
               PERFORM LOAD-LEVEL-DATA
               MOVE R-SAVE     TO W5-R6
               MOVE W-SAVE     TO W5-L6.
           IF SDWK57 NOT = "  "
               PERFORM LOAD-LEVEL-DATA
               MOVE R-SAVE     TO W5-R7
               MOVE W-SAVE     TO W5-L7.
           IF SDWK61 NOT = "  "
               PERFORM LOAD-LEVEL-DATA
               MOVE R-SAVE     TO W6-R1
               MOVE W-SAVE     TO W6-L1.
           IF SDWK62 NOT = "  "
               PERFORM LOAD-LEVEL-DATA
               MOVE R-SAVE     TO W6-R2
               MOVE W-SAVE     TO W6-L2.

       LOAD-LEVEL-DATA.
           ADD 1               TO SUB.
           MOVE "--"           TO W-SAVE.
           MOVE SPACE          TO R-SAVE.
           IF DAY-DATA(SUB) NOT = SPACES
               MOVE DD-LEVEL(SUB) TO W-SAVE.
           IF DD-REST-1(SUB) NOT = SPACES
             MOVE "*"          TO R-SAVE.
           IF DD-REST-PR(SUB) IS NUMERIC AND DD-REST-PR(SUB) > 0
             MOVE "*"          TO R-SAVE.

       EDIT-SCREEN.
           MOVE 0              TO SUB.
           IF SDWK11 NOT = "   "
               ADD 1           TO SUB
               IF W1-L1 = "--" OR "  "
                   MOVE SPACE  TO W1-R1
               ELSE
               IF W1-R1 = " " OR "*"
                   NEXT SENTENCE
               ELSE
                   MOVE "*"    TO W1-R1
                   PERFORM EXPAND-RESTRICTIONS THRU ER-EXIT
           ELSE
               MOVE SPACES     TO W1-R1.

           IF SDWK12 NOT = "   "
               ADD 1           TO SUB
               IF W1-L2 = "--" OR "  "
                   MOVE SPACE  TO W1-R2
               ELSE
               IF W1-R2 = " " OR "*"
                   NEXT SENTENCE
               ELSE
                   MOVE "*"    TO W1-R2
                   PERFORM EXPAND-RESTRICTIONS THRU ER-EXIT
           ELSE
               MOVE SPACES     TO W1-R2.

           IF SDWK13 NOT = "   "
               ADD 1           TO SUB
               IF W1-L3 = "--" OR "  "
                   MOVE SPACE  TO W1-R3
               ELSE
               IF W1-R3 = " " OR "*"
                   NEXT SENTENCE
               ELSE
                   MOVE "*"    TO W1-R3
                   PERFORM EXPAND-RESTRICTIONS THRU ER-EXIT
           ELSE
               MOVE SPACES     TO W1-R3.

           IF SDWK14 NOT = "   "
               ADD 1           TO SUB
               IF W1-L4 = "--" OR "  "
                   MOVE SPACE  TO W1-R4
               ELSE
