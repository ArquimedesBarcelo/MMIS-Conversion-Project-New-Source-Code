016500*                                                *
016600*     6 - M A I N                                *
016700*                                                *
016800**************************************************
016900
017000
017100 6-MAIN.
           MOVE "DELTPO" TO VIEW-NFNAME.

       6-PUT-BUFFER.
           MOVE SPACES TO PO-DELETE-SCREEN.
           MOVE ZEROS  TO SC-PO-REL.

       6-SHOW-FORM.
      *------- SHOW DELETE QUESTION IF USER IS ALLOWED TO DELETE PO.
           IF DELETE-ALLOWED
               MOVE B"1"          TO IND(10).

           MOVE PO-DELETE-SCREEN  TO DISPLAY-REC.
           PERFORM 998-WRITE-SCREEN THRU 998-READ-SCREEN.
           MOVE DISPLAY-REC       TO PO-DELETE-SCREEN.

       6-READ-FIELDS.
           IF VIEW-LASTKEY = 3
               GO TO 6-M-X.

           IF VIEW-LASTKEY = 1 OR
              VIEW-LASTKEY = 2 OR
              VIEW-LASTKEY = 4 OR
              VIEW-LASTKEY = 5 OR
              VIEW-LASTKEY = 6 OR
              VIEW-LASTKEY = 7 OR
              VIEW-LASTKEY = 8
      *****    INVALID FUNCTION KEY    *****
               MOVE   9 TO LANG-SETNUM
               MOVE  10 TO LANG-MSGNUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER TO SC-PO-MSGLINE
               MOVE B"1"           TO IND(99)
               GO TO 6-SHOW-FORM.

017200***  MOVE SPACES                  TO PO-NUMBER.
017300***  DISPLAY "ENTER PO NUMBER TO DELETE X(10)".
017400***  ACCEPT PO-NUMBER.
017500***  IF PO-NUMBER = SPACES
017600***      GO TO 6-M-X.
017700***
017800***  DISPLAY "PUT PO INTO THE HISTORY DATA BASE? (Y OR N)".
017900***  ACCEPT PUT-PO-IN-HIST-SW.
018000***  IF PUT-PO-IN-HIST-SW = "Y" OR "N"
018100***      NEXT SENTENCE
018200***  ELSE
018300***      DISPLAY "INVALID RESPONSE; LETS TRY IT AGAIN"
018400***      GO TO 6-MAIN.
018500
           IF DELETE-NOT-ALLOWED
               MOVE "Y"                 TO  PUT-PO-IN-HIST-SW
           ELSE
           IF SC-PO-DELETE-SW = "Y"
               MOVE "N"                 TO  PUT-PO-IN-HIST-SW
           ELSE
               MOVE "Y"                 TO  PUT-PO-IN-HIST-SW.

           IF SC-PO-NUM = SPACES
      ***  ENTER A PO NUMBER ***
               MOVE  05  TO LANG-SETNUM
               MOVE 104  TO LANG-MSGNUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER TO SC-PO-MSGLINE
               MOVE B"1"           TO IND(99)  IND(01)
               GO TO 6-SHOW-FORM.

018600     MOVE SC-PO-NUM-REL           TO  PO-NUM-REL.
018700     MOVE BUILD-PO-NUM            TO  PO-ARG.
           MOVE 0 TO COND-WORD.
           MOVE PO-ARG TO PORCVNO OF DPORECD-REC-I.
           START DPORECD-I KEY = PORCVNO OF DPORECD-REC-I
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
      ***  PO DOES NOT EXIST IN PLANT DATABASE  ***
                   MOVE  16  TO LANG-SETNUM
                   MOVE  60  TO LANG-MSGNUM
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE MESSAGE-BUFFER TO SC-PO-DELETE-MSG1
                   MOVE SPACES         TO SC-PO-DELETE-MSG2
      ***  ENTER ANOTHER P.O. TO MOVE TO HISTORY OR PRESS 'F3' TO END  ***
                   MOVE   5  TO LANG-SETNUM
                   MOVE 105  TO LANG-MSGNUM
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE MESSAGE-BUFFER TO SC-PO-MSGLINE
                   MOVE B"1"           TO IND(99), IND(1)
                   GO TO 6-SHOW-FORM
019200***          DISPLAY "PO DOESN'T EXIST; TRY AGAIN  ",
019300***              PO-NUMBER
019400***          GO TO 6-MAIN
019500         ELSE
019600             MOVE "FIND DPORECD * 6-MAIN" TO BU-DISPLAY-MSG
019700             GO TO 2-BLOWUP.
           READ DPORECD-I NEXT INTO BUF-DPORECD
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14"
      ***  PO DOES NOT EXIST IN PLANT DATABASE  ***
                   MOVE  16  TO LANG-SETNUM
                   MOVE  60  TO LANG-MSGNUM
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE MESSAGE-BUFFER TO SC-PO-DELETE-MSG1
                   MOVE SPACES         TO SC-PO-DELETE-MSG2
020200***          DISPLAY "NO PO HEADER ENTRY; CANT PUT IN HISTORY"
020300***          MOVE "N"             TO PUT-PO-IN-HIST-SW
                   GO TO 6-SHOW-FORM
020400         ELSE
020500             MOVE "GET DPORECD * 6-MAIN" TO BU-DISPLAY-MSG
020600             GO TO 2-BLOWUP.
           IF PORCVNO OF DPORECD-REC-I NOT = PO-ARG
      ***  PO DOES NOT EXIST IN PLANT DATABASE  ***
                   MOVE  16  TO LANG-SETNUM
                   MOVE  60  TO LANG-MSGNUM
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE MESSAGE-BUFFER TO SC-PO-DELETE-MSG1
                   MOVE SPACES         TO SC-PO-DELETE-MSG2
020200***      DISPLAY "NO PO HEADER ENTRY; CANT PUT IN HISTORY"
020300***          MOVE "N"             TO PUT-PO-IN-HIST-SW
                   GO TO 6-SHOW-FORM.
020700
020800     IF PUT-PO-IN-HIST-SW = "Y"
      *------------- SKIP EDITS FOR CALL FROM MCXTDELTPY.
               IF DELETE-CAPABILITY-SW = "Y"
                   MOVE "Y" TO PO-COMPLETE-SW
               ELSE
                   PERFORM 61-CHECK-ITEMS  THRU  61-CI-X
               END-IF
               IF PO-COMPLETE-SW = "Y"
020900             PERFORM 60-UPDATE-STORES-HISTORY THRU 60-USH-X
               ELSE
                   MOVE MESSAGE-BUFFER     TO SC-PO-MSGLINE
                   MOVE B"1"               TO IND(99)
                   IF DISPLAY-ITEM-SW = "Y"
                       MOVE ITEM-INFO-LINE TO SC-PO-DELETE-MSG1
                   ELSE
                       MOVE SPACES         TO SC-PO-DELETE-MSG1
                   END-IF
                   IF DISPLAY-REG-SW = "Y"
                       MOVE REGISTER-LINE  TO SC-PO-DELETE-MSG2
                   ELSE
                       MOVE SPACES         TO SC-PO-DELETE-MSG2
                   END-IF
                   GO TO 6-SHOW-FORM.
021000
      *------- SWITCH TO INDICATE ITEM MOVE TO HISTORY.  RESET IN
      *------- SDELTPO.
           MOVE "H" TO BASE (1:1).

021100     CALL "SDELTPO" USING BASE,
021200                           PO-ARG,
021300                           COMPANY-SAVE.


DCR01 *===============================================================
DCR01 *=== DON'T NEED THE DELETE TRANSACTION ASSOCIATED WITH A MOVE
DCR01 *=== TO HISTORY - SO RMV THE "DELETE" TRIGGER RECORD
DCR01 *===============================================================
DCR01      PERFORM Z110-RMV-USER-TRIGGER    THRU Z110-EXIT.


           MOVE SPACES TO PO-DELETE-SCREEN.
           MOVE ZEROS  TO SC-PO-REL.

021400***  DISPLAY "SUCCESSFUL CALL TO SDELTPO".
      ***  PO SUCCESSFULLY MOVED TO HISTORY  ***
           IF PUT-PO-IN-HIST-SW = "Y"
               MOVE  16  TO LANG-SETNUM
               MOVE 178  TO LANG-MSGNUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER TO SC-PO-DELETE-MSG1
               MOVE SPACES         TO SC-PO-DELETE-MSG2
           ELSE
      ***  PO SUCCESSFULLY DELETED  ***
               MOVE  16  TO LANG-SETNUM
               MOVE 179  TO LANG-MSGNUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER TO SC-PO-DELETE-MSG1
               MOVE SPACES         TO SC-PO-DELETE-MSG2.
021500     GO TO 6-SHOW-FORM.
021600
021700 6-M-X.
021800     EXIT.
021900
022000 60-UPDATE-STORES-HISTORY.
           MOVE PO-ARG TO PORCVNO OF MPORCV-REC-O.
           READ MPORCV-O INTO BUF-MPORCV
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
023400         MOVE "GET MPORCV*60-USH" TO BU-DISPLAY-MSG
023500         GO TO 2-BLOWUP.
023600
023700********* IF 'PO-RCV-SEQ' IS = 'HISTOK' ON THE PO MASTER
023800********* 'MPORCV' THEN THIS MEANS THE PO HAS ALREADY BEEN
023900********* MOVED TO THE HISTORY DATA BASE AND THEREFORE IS
024000********* NOT COPIED OVER AGAIN.  OTHERWISE MARK 'PO-RCV-SEQ'
024100********* WITH 'HISTSP' AND CALL 'SPOHIST'.  IF 'SPOHIST'
024200********* SUCCESSFULLY COPYS THE PO OVER INTO THE HISTORY DB
024300********* THEN IT WILL MARK 'PO-RCV-SEQ' WITH A 'HISTOK'
024400********* INDICATOR
      ********* NOTE ADDED A REWRITE OF MPORCV EVEN IF PO-RCV-SEQ
      ********* WAS EQUAL TO 'HISTOK' SO THAT IT WOULD UNLOCK THE
      ********* RECORD FOR 'MPORCV'  KURT MOVSESIAN 10/23/91
024500
024600     IF M-PO-RCV-SEQ = "HISTOK"
               REWRITE MPORCV-REC-O FROM BUF-MPORCV
                   INVALID KEY MOVE FILE-STATUS TO FILE-STATUS
                      END-REWRITE
               IF FILE-STATUS NOT = "00"
025400             MOVE "UPDATE1 MPORCV * 60-USH" TO BU-DISPLAY-MSG
025500             GO TO 2-BLOWUP
               ELSE
024800             GO TO 60-USH-X.
024900
025000     MOVE "HISTSP" TO  M-PO-RCV-SEQ.
           REWRITE MPORCV-REC-O FROM BUF-MPORCV
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
025400         MOVE "UPDATE2 MPORCV*60-USH" TO BU-DISPLAY-MSG
025500         GO TO 2-BLOWUP.
025600
025900     CALL "SPOHIST" USING BASE,
026000                          BASE-STHIST,
026100                          BUF-DPORECD,
026200                          PO-ARG.
026300
026400 60-USH-X.
026500     EXIT.

       61-CHECK-ITEMS.
           MOVE "N"                  TO DISPLAY-ITEM-SW
                                        DISPLAY-REG-SW.
           MOVE  09                  TO LANG-SETNUM.
           MOVE 114                  TO LANG-MSGNUM.
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
           MOVE MESSAGE-BUFFER       TO ITEM-INFO-LINE.
           MOVE "N"                  TO PO-COMPLETE-SW.
           MOVE SPACES               TO MESSAGE-BUFFER.
           MOVE PO-ARG TO PORCVNO OF DPOITEM-REC-I.
           START DPOITEM-I KEY = PORCVNO OF DPOITEM-REC-I
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
                   NEXT SENTENCE
               ELSE
                   MOVE "FIND DPOITEM *61-CI" TO BU-DISPLAY-MSG
                   GO TO 2-BLOWUP.

      **************************************
      *                                    *
      *  CHECK EACH ITEM IN DPOITEM TO SEE *
      *  IF THE P.O. IS COMPLETE           *
      *                                    *
      **************************************

       61-GET-DPOITEM.
           READ DPOITEM-I NEXT INTO BUF-DPOITEM
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   GO TO 61-CHECK-OPEN-INVOICES
               ELSE
                   MOVE "GET DPOITEM*61-GD" TO BU-DISPLAY-MSG
                   GO TO 2-BLOWUP.

           IF PORCVNO OF DPOITEM-REC-I NOT = PO-ARG
               GO TO 61-CHECK-OPEN-INVOICES.

           IF ITM-QTY-DLVR = ITM-QTY-STORED
               NEXT SENTENCE
           ELSE
               MOVE  03  TO LANG-SETNUM
               MOVE 633  TO LANG-MSGNUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE ITM-NUMBER       TO IIL-ITEM
               MOVE ITM-QTY-DLVR     TO IIL-DLV
               MOVE ITM-QTY-STORED   TO IIL-STR
               MOVE ITM-QTY-PAID     TO IIL-PAID
               MOVE "Y"              TO DISPLAY-ITEM-SW
               GO TO 61-CI-X.

           IF INVOICING
               IF PO-NONPAY-IND > SPACES
                   NEXT SENTENCE
               ELSE
               IF ITM-QTY-DLVR = ITM-QTY-PAID
                   NEXT SENTENCE
               ELSE
                   MOVE  03  TO LANG-SETNUM
                   MOVE 634  TO LANG-MSGNUM
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE ITM-NUMBER       TO IIL-ITEM
                   MOVE ITM-QTY-DLVR     TO IIL-DLV
                   MOVE ITM-QTY-STORED   TO IIL-STR
                   MOVE ITM-QTY-PAID     TO IIL-PAID
                   MOVE "Y"              TO DISPLAY-ITEM-SW
                   GO TO 61-CI-X.

           GO TO 61-GET-DPOITEM.

      *****************************************************
      *
      *  EVEN THOUGH THE PO HAS PASSED THE CHECK FOR
      *  (QUANTITY PAID = QUANTITY ORDERED) I CHECK TO
      *  MAKE SURE ALL THE INVOICES ASSOCIATED WITH THE PO
      *  HAVE BEEN MANIFESTED COMPLETELY (INV-STATUS = 2)
      *
      *****************************************************

       61-CHECK-OPEN-INVOICES.
           IF INVOICING
               IF PO-NONPAY-IND > SPACES
                   MOVE "Y"  TO  PO-COMPLETE-SW
               ELSE
                   PERFORM 62-CHECK-OPEN-INVOICES  THRU  62-COI-X
               END-IF
           ELSE
               MOVE "Y"  TO  PO-COMPLETE-SW.

       61-CI-X.
           EXIT.

      *****************************************************
      *
      *  EVEN THOUGH THE PO HAS PASSED THE CHECK FOR
      *  (QUANTITY PAID = QUANTITY ORDERED) I CHECK TO
      *  MAKE SURE ALL THE INVOICES ASSOCIATED WITH THE PO
      *  HAVE BEEN MANIFESTED COMPLETELY (INV-STATUS = 2)
      *
      *****************************************************

       62-CHECK-OPEN-INVOICES.
           MOVE PO-ARG TO PORCVNO OF DINVRCD-REC-I.
           START DINVRCD-I KEY = PORCVNO OF DINVRCD-REC-I
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
                   NEXT SENTENCE
               ELSE
                   MOVE "FIND DINVRCD *62-COI" TO BU-DISPLAY-MSG
                   GO TO 2-BLOWUP.

       62-GET-DINVRCD.
           READ DINVRCD-I NEXT INTO BUF-DINVRCD
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   MOVE "Y"  TO  PO-COMPLETE-SW
                   GO TO 62-COI-X
               ELSE
                   MOVE "GET DINVRCD*62-GD" TO BU-DISPLAY-MSG
                   GO TO 2-BLOWUP.
           IF PORCVNO OF DINVRCD-REC-I NOT = PO-ARG
               MOVE "Y"  TO  PO-COMPLETE-SW
               GO TO 62-COI-X.

      ********  INVOICE IS COMPLETE (MANIFESTED) IF INV-STATUS = 2

           IF INV-STATUS = "2"
               GO TO 62-GET-DINVRCD
           ELSE
               MOVE  18  TO LANG-SETNUM
               MOVE 093  TO LANG-MSGNUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER TO REGISTER-LINE
               MOVE INV-REG-NO     TO REG-NUM
               MOVE  03  TO LANG-SETNUM
               MOVE 635  TO LANG-MSGNUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE "Y"  TO DISPLAY-REG-SW
               GO TO 62-COI-X.

       62-COI-X.
           EXIT.

        COPY DISPCALL IN COPYLIB.
      *********************************************************
       999-CATREAD.
           IF CATREAD-MSG-NUMBER = ZEROS
               MOVE LANG-SETNUM TO CATREAD-MSG-SET
               MOVE LANG-MSGNUM TO CATREAD-MSG-NUM.
           CALL "CCATREAD" USING CATREAD-PARMS.
           MOVE CATREAD-MSG-TEXT TO MESSAGE-BUFFER.

       999-CATREAD-EXIT.
           EXIT.


DCR01  COPY POLOGSUBR  IN COPYLIB.


