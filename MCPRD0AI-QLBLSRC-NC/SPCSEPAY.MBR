018800
018900 PROCEDURE DIVISION USING BASE,
019000                          VIEW-COMAREA,
019100                          LANGUAGE-PARMS.
019200
019300 0-SBUYRCODE-SEC SECTION 1.
019400
019500 0-BEGIN-HERE.
019600     PERFORM 1-HSK.
019700     PERFORM 6-MAIN THRU 6-MAIN-X.
019800     PERFORM 2-EOJ.
019900
020000 1-HSK.
020100     MOVE "SPCSEPAY" TO BU-PGM-NAME.
017500     OPEN I-O DISPLAY-FILE, MPLTINFO-PK-O.
           PERFORM 9999-RESET-MPLTINFO-PK-O.
           MOVE "N"          TO WS-EDI-INSTAL.
020300     MOVE "EDI "       TO MPLTINFO-ARG PLT-ARG.
020400     PERFORM 9999-GETKEY-MPLTINFO-PK-O.
020500     IF  COND-WORD = 0
020600         IF  EDI-INSTAL = "Y"
020700             MOVE  "Y"  TO  WS-EDI-INSTAL.
           PERFORM 9999-RESET-MPLTINFO-PK-O.

021200 2-EOJ.
           CLOSE DISPLAY-FILE, MPLTINFO-PK-O.
021300     GOBACK.
021400
021500******************************************************
021600**                 BLOWUP ROUTINE                   **
021700******************************************************
021800
021900 2100-BLOWUP.
022000     CALL "TBLOWUP" USING BASE, BU-PGM-NAME, STATUS-AREA,
022100           VIEW-COMAREA, DUMMY-KSAM-STAT, BU-DISPLAY-MSG,
022200           BU-DISPLAY-AREA.
022300
022400
024400**************************************************
024500*                                                *
024600*                  6 - M A I N                   *
024700*                                                *
024800**************************************************
024900 6-MAIN.
025000     MOVE "EPAYTERMSM" TO VIEW-NFNAME.
025100     PERFORM 9999-GETNEXTFORM.
025200
025300 6-PUT-WINDOW.
025400     MOVE SPACES TO MESSAGE-BUFFER.
025500     PERFORM 9999-PUTWINDOW.
025600
025700 6-SHOW-FORM.
025800     MOVE 4                  TO SRF-KEYSET.
025900     MOVE "I"                TO SRF-FKEY(7).
026000     PERFORM 9999-DO-SCREEN-1.
026100
026200     IF VIEW-LASTKEY = EXIT-PROGRAM
026300         GO TO 6-MAIN-X.
026400
026900     IF VIEW-LASTKEY = F1-KEY
027000        PERFORM  65-HELP-SCREEN THRU 65-HELP-SCREEN-X
027100        GO TO 6-MAIN
027200     ELSE
027300     IF VIEW-LASTKEY = F2-KEY
027400         MOVE  "A"  TO  WS-MODE
027500         PERFORM 61-ADD-EDI-PAYTERMS THRU 61-ADD-EDI-PAYTERMS-X
027600     ELSE
027700     IF VIEW-LASTKEY = F4-KEY
027800         MOVE  "M"  TO  WS-MODE
027900         PERFORM 62-MODIFY-EDI-PAYTERMS THRU
028000                 62-MODIFY-EDI-PAYTERMS-X
028100     ELSE
028200     IF VIEW-LASTKEY = F5-KEY
028300         MOVE  "D"  TO  WS-MODE
028400         PERFORM 63-DELETE-EDI-PAYTERMS THRU
028500                 63-DELETE-EDI-PAYTERMS-X.
028600
028700     GO TO 6-MAIN.
028800
028900 6-MAIN-X.
029000     EXIT.
029100
029200
029300 61-ADD-EDI-PAYTERMS.
029400     MOVE "EPAYTERMCD" TO VIEW-NFNAME.
029500     PERFORM 9999-GETNEXTFORM.
029600     MOVE SPACES                  TO DE-FIELDS-1 DE-FIELDS-2.
029700     MOVE "A  D  D    O  N  L  Y" TO SCREEN-MODE.
029800     PERFORM 99-GET-EDI-CODE THRU 99-GET-EDI-CODE-EXIT.
029900     IF  VIEW-LASTKEY = EXIT-PROGRAM
030000         GO TO 61-ADD-EDI-PAYTERMS-X.
030100 61-GET-EDI-ADD-FORM.
030200     MOVE "EPAYTERMSA"            TO VIEW-NFNAME.
030300     PERFORM 9999-GETNEXTFORM.
030400*** INPUT DATA ABOVE AND THEN PRESS ENTER
           MOVE 09020              TO CATREAD-MSG-NUMBER.
030700     PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
030800     MOVE MESSAGE-BUFFER     TO WS-MESSAGE-LINE.
030900     MOVE SPACES             TO MESSAGE-BUFFER.
031000     PERFORM 9999-PUTWINDOW.
031100     MOVE 01                 TO PAY-TERMS-TYPE.
031200     MOVE 05                 TO PAY-TIME-REF.
031300     MOVE 03                 TO TIME-RELATION.
           MOVE ZEROES             TO NO-OF-PERIODS
                                      NO-OF-PERIODS-P
                                      PERCENT-DISCOUNT-INT
                                      PAYMENT-NET-DAYS.
031400     MOVE 6                  TO SRF-KEYSET.
031500     MOVE "I"                TO SRF-FKEY(7)
031600                                SRF-FKEY(2).
031700*    MOVE " AFE"             TO SRF-FKEY(1).
031800 61-ADD-EDI-ACCEPT-SCREEN.
031900     PERFORM 9999-DO-SCREEN-2.
032000
032100     IF VIEW-LASTKEY = EXIT-PROGRAM
032200         GO TO 61-ADD-EDI-PAYTERMS-X.
032300
032800     IF VIEW-LASTKEY = F1-KEY
032900         PERFORM 65-HELP-SCREEN THRU 65-HELP-SCREEN-X
033000         GO TO 61-GET-EDI-ADD-FORM.
033100
033200     IF VIEW-LASTKEY = ENTER-KEY
033300        PERFORM 99-MOVE-SCREEN1-TO-BUFFER
033400        MOVE DSET-MPLTINFO           TO DSET-NAME
033500        PERFORM 9999-DSET-LOCK
033600        PERFORM 9999-PUT-MPLTINFO-PK-O
033700        PERFORM 9999-UNLOCK.
033800
033900     GO TO 61-ADD-EDI-PAYTERMS.
034000
034100 61-ADD-EDI-PAYTERMS-X.
034200     EXIT.
034300
034400 62-MODIFY-EDI-PAYTERMS.
034500     MOVE "EPAYTERMCD"               TO VIEW-NFNAME.
034600     PERFORM 9999-GETNEXTFORM.
034700     MOVE SPACES                     TO DE-FIELDS-1 DE-FIELDS-2.
034800     MOVE "M  O  D  I  F  Y    O  N  L  Y" TO SCREEN-MODE.
034900     PERFORM 99-GET-EDI-CODE THRU 99-GET-EDI-CODE-EXIT.
035000     IF  VIEW-LASTKEY = EXIT-PROGRAM
035100         GO TO 62-MODIFY-EDI-PAYTERMS-X.
035200 62-GET-EDI-MODIFY-FORM.
035300     MOVE "EPAYTERMSA"               TO VIEW-NFNAME.
035400     PERFORM 9999-GETNEXTFORM.
           MOVE 09020                      TO CATREAD-MSG-NUMBER.
035500*** INPUT DATA ABOVE AND THEN PRESS ENTER
035800     PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
035900     MOVE MESSAGE-BUFFER             TO WS-MESSAGE-LINE.
036000     MOVE SPACES                     TO MESSAGE-BUFFER.
036100     PERFORM 9999-PUTWINDOW.
036200     PERFORM 99-MOVE-BUFFER-TO-SCREEN1.
036300     MOVE 6                          TO SRF-KEYSET.
036400     MOVE "I"                        TO SRF-FKEY(7)
036500                                        SRF-FKEY(2).
036600*    MOVE " AFE"                     TO SRF-FKEY(1).
036700 62-MODIFY-EDI-ACCEPT-SCREEN.
036800     PERFORM 9999-DO-SCREEN-2.
036900
037000     IF VIEW-LASTKEY = EXIT-PROGRAM
037100         GO TO 62-MODIFY-EDI-PAYTERMS-X.
037200
037700     IF VIEW-LASTKEY = F1-KEY
037800         PERFORM 65-HELP-SCREEN THRU 65-HELP-SCREEN-X
037900         GO TO 62-GET-EDI-MODIFY-FORM.
038000
038100     IF VIEW-LASTKEY = ENTER-KEY
038200        MOVE SPACES                 TO BUF-MPLTINFO
038300        PERFORM 99-MOVE-SCREEN1-TO-BUFFER
038400        MOVE DSET-MPLTINFO          TO DSET-NAME
038500        PERFORM 9999-DSET-LOCK
038600        PERFORM 9999-UPDATE-MPLTINFO-PK-O
038700        PERFORM 9999-UNLOCK.
038800
038900     GO TO 62-MODIFY-EDI-PAYTERMS.
039000
039100 62-MODIFY-EDI-PAYTERMS-X.
039200     EXIT.
039300
039400 63-DELETE-EDI-PAYTERMS.
039500     MOVE "EPAYTERMCD"              TO VIEW-NFNAME.
039600     PERFORM 9999-GETNEXTFORM.
039700     MOVE SPACES                    TO DE-FIELDS-1 DE-FIELDS-2.
039800     MOVE "D  E  L  E  T  E    O  N  L  Y" TO SCREEN-MODE.
039900     PERFORM 99-GET-EDI-CODE THRU 99-GET-EDI-CODE-EXIT.
040000     IF  VIEW-LASTKEY = EXIT-PROGRAM
040100         GO TO 63-DELETE-EDI-PAYTERMS-X.
040200 63-GET-EDI-DELETE-FORM.
040300     MOVE "EPAYTERMSD"              TO VIEW-NFNAME.
040400     PERFORM 9999-GETNEXTFORM.
           MOVE 16082                     TO CATREAD-MSG-NUMBER.
040500***  PRESS 'f2' TO DELETE OR 'f8' TO EXIT (LEAVE UNCHANGED)  ***
040800     PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
040900     MOVE MESSAGE-BUFFER            TO WS-MESSAGE-LINE.
041000     MOVE SPACES                    TO MESSAGE-BUFFER.
041100     PERFORM 9999-PUTWINDOW.
041200     PERFORM 99-MOVE-BUFFER-TO-SCREEN1.
041300     MOVE 6                         TO SRF-KEYSET.
041400     MOVE "I"                       TO SRF-FKEY(7)
041500                                       SRF-FKEY(1).
041600 63-DELETE-EDI-ACCEPT-SCREEN.
041700     PERFORM 9999-DO-SCREEN-2.
041800
041900     IF VIEW-LASTKEY = EXIT-PROGRAM
042000         GO TO 63-DELETE-EDI-PAYTERMS-X.
042100
042600     IF VIEW-LASTKEY = F2-KEY
042700        MOVE DSET-MPLTINFO          TO DSET-NAME
042800        PERFORM 9999-DSET-LOCK
042900        PERFORM 9999-DELETE-MPLTINFO-PK-O
043000        PERFORM 9999-UNLOCK.
043100
043200     GO TO 63-DELETE-EDI-PAYTERMS.
043300
043400 63-DELETE-EDI-PAYTERMS-X.
043500     EXIT.
043600
043700 65-HELP-SCREEN.
043800     MOVE "HELP6"                   TO VIEW-NFNAME.
043900     PERFORM 9999-GETNEXTFORM.
044000     MOVE SPACES                    TO DE-FIELDS-1.
044100 65-PUT-WINDOW.
044200     MOVE SPACES                    TO MESSAGE-BUFFER.
044300     PERFORM 9999-PUTWINDOW.
044400
044500 65-SHOW-FORM.
044600     MOVE 8                         TO SRF-KEYSET.
044700     MOVE "I"                       TO SRF-FKEY(7).
044800     PERFORM 9999-DO-SCREEN-1.
044900
045300 65-HELP-SCREEN-X.
045400     EXIT.
045500
       999-CATREAD.
           MOVE SPACES                    TO MESSAGE-BUFFER.
           CALL "CCATREAD" USING CATREAD-PARMS.
           MOVE CATREAD-MSG-TEXT          TO MESSAGE-BUFFER.
       999-CATREAD-EXIT.    EXIT.
047500
047600 99-GET-EDI-CODE.
047700     MOVE 8                         TO SRF-KEYSET.
047800     MOVE "I"                       TO SRF-FKEY(7).
047900     PERFORM 9999-DO-SCREEN-2.
048000
048100     IF VIEW-LASTKEY = EXIT-PROGRAM
048200         GO TO 99-GET-EDI-CODE-EXIT.
048300
048800     MOVE EDI-PAY-CODE             TO WS-EDI-PAY-CODE TM-CODE-IN.
048900     MOVE WS-TMP-CODE               TO TMP-CODE-IN.
049000     MOVE WS-TMD-CODE               TO TMD-CODE-IN.
049100
049200     MOVE TMP-CODE-ARG              TO MPLTINFO-ARG, PLT-ARG.
049300     PERFORM 9999-GETKEY-MPLTINFO-PK-O.
049400     IF  COND-WORD = 17
               MOVE 03192                 TO CATREAD-MSG-NUMBER
049500*    CSIS CODES DOES NOT EXIST
049800         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
049900         MOVE MESSAGE-BUFFER        TO WS-MESSAGE-LINE
050000         MOVE SPACES                TO MESSAGE-BUFFER
050100         GO TO 99-GET-EDI-CODE.
050200
050300     MOVE TMD-CODE-ARG   TO MPLTINFO-ARG, PLT-ARG.
050400     PERFORM 9999-GETKEY-MPLTINFO-PK-O.
050500     IF  COND-WORD = 17
               MOVE 03192                 TO CATREAD-MSG-NUMBER
050600*    CSIS CODES DOES NOT EXIST
050900         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
051000         MOVE MESSAGE-BUFFER        TO WS-MESSAGE-LINE
051100         MOVE SPACES                TO MESSAGE-BUFFER
051200         GO TO 99-GET-EDI-CODE.
051300
051400     MOVE TM-CODE-ARG               TO MPLTINFO-ARG, PLT-ARG.
051500     PERFORM 9999-GETKEY-MPLTINFO-PK-O.
051600     IF  COND-WORD = 0
051700         IF  MODIFY-MODE OR DELETE-MODE
051800             NEXT SENTENCE
051900         ELSE
               MOVE 05053                 TO CATREAD-MSG-NUMBER
052000*EDI CODES EXIST CANNOT ADD
052300         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
052400         MOVE MESSAGE-BUFFER        TO WS-MESSAGE-LINE
052500         MOVE SPACES                TO MESSAGE-BUFFER
052600         GO TO 99-GET-EDI-CODE
052700     ELSE
052800     IF  MODIFY-MODE OR DELETE-MODE
               MOVE 05054                 TO CATREAD-MSG-NUMBER
052900*EDI CODES DOES NOT EXIST CANNOT MODIFY OR DELETE
053200         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
053300         MOVE MESSAGE-BUFFER        TO WS-MESSAGE-LINE
053400         MOVE SPACES                TO MESSAGE-BUFFER
053500         GO TO 99-GET-EDI-CODE
053600     ELSE
053700     NEXT SENTENCE.
053800
053900 99-GET-EDI-CODE-EXIT.
054000     EXIT.
054100
054200 99-MOVE-SCREEN1-TO-BUFFER.
054300     MOVE TM-CODE-ARG               TO MPLTINFO-KEY.
054400     MOVE PAY-TERMS-TYPE            TO MPLTINFO-PAY-TERMS-TYPE.
054500     MOVE PAY-TIME-REF              TO MPLTINFO-PAY-TIME-REF.
054600     MOVE TIME-RELATION             TO MPLTINFO-TIME-RELATION.
054700     MOVE TYPE-OF-PERIOD            TO MPLTINFO-TYPE-OF-PERIOD.
           IF N-O-P-X = "   "
               MOVE ZEROES                TO MPLTINFO-NO-OF-PERIODS
           ELSE
054800     MOVE NO-OF-PERIODS             TO MPLTINFO-NO-OF-PERIODS.
           IF N-O-P-P-X = "   "
               MOVE ZEROES                TO MPLTINFO-NO-OF-PERIODS-P
           ELSE
           MOVE NO-OF-PERIODS-P           TO MPLTINFO-NO-OF-PERIODS-P.
           IF P-D-I-X = "  "
               MOVE ZEROES                TO FMT-PER-DISC-INT
           ELSE
054900     MOVE PERCENT-DISCOUNT-INT      TO FMT-PER-DISC-INT.
           IF P-D-I-X = "   "
               MOVE ZEROES                TO FMT-PER-DIS-FRAC
           ELSE
055000     MOVE PERCENT-DISCOUNT-FRAC     TO FMT-PER-DIS-FRAC.
055100     MOVE FPD-9                     TO MPLTINFO-PERCENT-DISCOUNT.
           IF P-N-D-X = "   "
               MOVE ZEROES                TO MPLTINFO-PAYMENT-NET-DAYS
           ELSE
055200     MOVE PAYMENT-NET-DAYS          TO MPLTINFO-PAYMENT-NET-DAYS.
055300
055400 99-MOVE-BUFFER-TO-SCREEN1.
055500     MOVE MPLTINFO-PAY-TERMS-TYPE   TO PAY-TERMS-TYPE.
055600     MOVE MPLTINFO-PAY-TIME-REF     TO PAY-TIME-REF.
055700     MOVE MPLTINFO-TIME-RELATION    TO TIME-RELATION.
055800     MOVE MPLTINFO-TYPE-OF-PERIOD   TO TYPE-OF-PERIOD.
055900     MOVE MPLTINFO-NO-OF-PERIODS    TO NO-OF-PERIODS.
           MOVE MPLTINFO-NO-OF-PERIODS-P  TO NO-OF-PERIODS-P.
056000     MOVE MPLTINFO-PERCENT-DISCOUNT TO FPD-9.
056100     MOVE FMT-PER-DISC-INT          TO PERCENT-DISCOUNT-INT.
056200     MOVE FMT-PER-DIS-FRAC          TO PERCENT-DISCOUNT-FRAC.
056300     MOVE MPLTINFO-PAYMENT-NET-DAYS TO PAYMENT-NET-DAYS.
056400
       9999-GETKEY-MPLTINFO-PK-O.
           MOVE 0 TO COND-WORD.
           MOVE PLT-ARG TO PLTINFOKEY OF MPLTINFO-PK-REC-O.
           READ MPLTINFO-PK-O INTO BUF-MPLTINFO
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS = "23"
               MOVE 17 TO COND-WORD
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD
               IF HANDLE-BLOWUP-FLAG = "Y"
                   MOVE "GETKEY ERR 9999-GETKEY-MPLTINFO-PK-O"
                       TO BU-MSG-AREA
                   PERFORM 2100-BLOWUP.

       9999-RESET-MPLTINFO-PK-O.
           MOVE HIGH-VALUES TO PLTINFOKEY OF MPLTINFO-PK-REC-O.
           START MPLTINFO-PK-O KEY > PLTINFOKEY OF MPLTINFO-PK-REC-O
               INVALID KEY MOVE "00" TO FILE-STATUS.

       9999-DELETE-MPLTINFO-PK-O.
           MOVE 0 TO COND-WORD.
           DELETE MPLTINFO-PK-O
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD
               IF HANDLE-BLOWUP-FLAG = "Y"
                   MOVE "DELETE ERR 9999-DELETE-MPLTINFO-PK-O"
                       TO BU-MSG-AREA
                   PERFORM 2100-BLOWUP.

       9999-PUT-MPLTINFO-PK-O.
           MOVE 0 TO COND-WORD.
           WRITE MPLTINFO-PK-REC-O FROM BUF-MPLTINFO
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD
               IF HANDLE-BLOWUP-FLAG = "Y"
                   MOVE "PUT ERR 9999-PUT-MPLTINFO-PK-O"
                       TO BU-MSG-AREA
                   PERFORM 2100-BLOWUP.

056800 COPY MLOCKCAL IN COPYLIB.
056900 COPY UNLOCK   IN COPYLIB.
057000 COPY DLOCKCAL IN COPYLIB.
057100 COPY SCRNCALL IN COPYLIB.
057200 COPY SCRNCL1  IN COPYLIB.
057300 COPY SCRNCL2  IN COPYLIB.
       9999-UPDATE-MPLTINFO-PK-O.
           MOVE 0 TO COND-WORD.
           REWRITE MPLTINFO-PK-REC-O FROM BUF-MPLTINFO
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD
               IF HANDLE-BLOWUP-FLAG = "Y"
                   MOVE "UPDATE ERR 9999-UPDATE-MPLTINFO-PK-O"
                       TO BU-MSG-AREA
                   PERFORM 2100-BLOWUP.

