       LINKAGE SECTION.
       01  REQUESTOR                   PIC X.

029500 PROCEDURE DIVISION USING REQUESTOR.

029600 START-PROCESSING.
           CALL "CLRETLAB".
           IF REQUESTOR = "C"
               CALL "TPERPASS" USING CC-BUFFER,
                                     NAME-BUFFER,
                                     PWORD-BUFFER,
                                     PWORD-SWITCH
               IF PWORD-SWITCH = "N"
                   GO TO 2-EOJ
               END-IF
           END-IF.
           PERFORM 1-HSK.
           PERFORM 6-MAIN THRU 6-MAIN-X
                   UNTIL VIEW-LASTKEY = 3.

       2-EOJ.
           IF PWORD-SWITCH = "N"
               GOBACK
           END-IF.
           CLOSE DISPLAY-FILE.
           CLOSE OUT-FILE.
           CLOSE SHIFT-STRUCTURE-FILE.
           CLOSE WO-BASIC-FILE.
           CLOSE WO-LABOR-FILE.
           CLOSE WO-LAST-NUM-USED.
           CLOSE WO-PLANNED-FILE.
053600     GOBACK.

       1-HSK.
           OPEN I-O    DISPLAY-FILE.
           OPEN INPUT  SHIFT-STRUCTURE-FILE.
           OPEN INPUT  WO-BASIC-FILE.
           OPEN INPUT  WO-LABOR-FILE.
           OPEN INPUT  WO-LAST-NUM-USED.
           OPEN INPUT  WO-PLANNED-FILE.
           MOVE 0 TO VIEW-LASTKEY.
029700     MOVE LOW-VALUES TO STATUS-AREA.
029800     MOVE SPACES TO DATE-RANGE, CC-WORK-AREA, WORK-DATE.
034400     MOVE 1 TO ARG-NO.
           READ WO-LAST-NUM-USED INTO LAST-WO-BUFF
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF WLNU-STATUS NOT = "00" MOVE 17 TO COND-WORD.
           IF COND-WORD = 17 MOVE 1 TO DATE-FLAG-SW.
034700     MOVE DATE-FLAG-SW TO DATE-FLAG.
034800     MOVE 1 TO DATE-MODE.
034900     MOVE DATE-FLAG TO DATE-CODE.
035000     CALL "TDATECHK" USING DATE-CHECK-AREA.
035100     MOVE DATE-SLASH-OUT TO DATE-BUFF.
           MOVE MTH-BUFF TO WORK-MNTH.
           MOVE DAY-BUFF TO WORK-DAY.
           MOVE YR-BUFF TO WORK-YR.
035500     CALL "TPWORD" USING PASSWORD-INFORMATION.
035900     IF PASSWORD-FLAG = "N" GO TO 2-EOJ.
036000     MOVE "CLRL" TO ZONE-ARG.
036100     MOVE SPACES TO SHIFT-STRUCTURE.
           MOVE ZONE-ARG TO SHIFTZONE OF SSFREC.
           START SHIFT-STRUCTURE-FILE KEY IS = EXTERNALLY-DESCRIBED-KEY
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF SSF-STATUS NOT = "00" MOVE 17 TO COND-WORD.
           IF COND-WORD = 17
               MOVE 66137 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE TRUE-VAL TO INDS (99)
               PERFORM 99-SCREEN-WRITE
               PERFORM 98-SCREEN-READ
               GO TO 2-EOJ.
036200     READ SHIFT-STRUCTURE-FILE NEXT INTO SHIFT-STRUCTURE
036300         AT END    MOVE 15 TO COND-WORD.
           IF SSF-STATUS NOT = "00" MOVE 15 TO COND-WORD.
           IF COND-WORD = 15
               MOVE 66137 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE TRUE-VAL TO INDS (99)
               PERFORM 99-SCREEN-WRITE
               PERFORM 98-SCREEN-READ
               GO TO 2-EOJ.
           ACCEPT MC-LOCAL-DATA-AREA FROM LOCAL-DATA-AREA.
038700     IF DATE-FLAG = 3
038800         MOVE MTH-BUFF-9 TO GREG-DD
038900         MOVE DAY-BUFF-9 TO GREG-MM
039000         MOVE YR-BUFF-9  TO GREG-YY
039100     ELSE
039200     MOVE MTH-BUFF-9 TO GREG-MM
039300     MOVE DAY-BUFF-9 TO GREG-DD
039400     MOVE YR-BUFF-9  TO GREG-YY.
           MOVE SPACES     TO JULIAN-DATE.
           IF GREG-YY > "70"
               MOVE "19"   TO GREG-CC
           ELSE
           MOVE "20"       TO GREG-CC.
039600     CALL "JULGREG" USING GREG-DATE, JULIAN-DATE,
                            DAY-DIGIT, LEAP-YEAR-FLAG.
039700     ACCEPT TIME-BUFF FROM TIME.
           IF CODE-VALUE = "2"
               IF TIME-HHMM > "0000" AND < FRST-SHIFT
                   SUBTRACT 1 FROM JULIAN-DATE-9
                   MOVE JULIAN-DATE-9 TO CUR-JUL-DAY
               ELSE
               MOVE JULIAN-DATE-9 TO CUR-JUL-DAY
           ELSE
039800     IF TIME-HHMM > "0000" AND < THRD-SHIFT
039900         SUBTRACT 1 FROM JULIAN-DATE-9
040000         MOVE JULIAN-DATE-9 TO CUR-JUL-DAY
040600     ELSE
040700     MOVE JULIAN-DATE-9 TO CUR-JUL-DAY.
           MOVE SPACES TO GREG-DATE.
040800     CALL "JULGREG" USING GREG-DATE, JULIAN-DATE,
                            DAY-DIGIT, LEAP-YEAR-FLAG.
041100     MOVE GREG-YY TO YY-CUR-9.
           IF YY-CUR-9 > 70
               MOVE 19 TO CC-CUR
           ELSE
           MOVE 20 TO CC-CUR.
041200     MOVE GREG-MM TO MM-CUR-9.
041300     MOVE GREG-DD TO DD-CUR-9.
           IF CODE-VALUE = "2"
               ADD 1 TO FRST-SHIFT GIVING TIME-CUR-9
           ELSE
041400     ADD 1 THRD-SHIFT GIVING TIME-CUR-9.
042200     MOVE CUR-JUL-DAY TO JUL-SAVE.
042300     IF JUL-SAVE < 1
042400         MOVE 12 TO GREG-MM
042500         MOVE 31 TO GREG-DD
042600         SUBTRACT 1 FROM GREG-YY-9
042700         CALL "JULGREG" USING GREG-DATE, JULIAN-DATE,
                                DAY-DIGIT, LEAP-YEAR-FLAG
042900         ADD JUL-SAVE TO JULIAN-DATE-9.
           MOVE SPACES TO GREG-DATE.
043100     CALL "JULGREG" USING GREG-DATE, JULIAN-DATE,
                            DAY-DIGIT, LEAP-YEAR-FLAG.
043400     MOVE GREG-YY TO YY-24HR-9.
           IF YY-24HR-9 > 70
               MOVE 19 TO CC-24HR
           ELSE
           MOVE 20 TO CC-24HR.
043500     MOVE GREG-MM TO MM-24HR-9.
043600     MOVE GREG-DD TO DD-24HR-9.
           IF CODE-VALUE = "2"
               MOVE FRST-SHIFT TO TIME-24HR-9
           ELSE
043700     MOVE THRD-SHIFT TO TIME-24HR-9.

043800 6-MAIN.
           MOVE ALL B"0" TO SCREEN-INDICATORS.
043900     MOVE "FRETLAB1" TO VIEW-CFNAME.
045100     MOVE SPACES TO CC-WORK-AREA.
045200     IF DATE-FLAG = 3
045300         MOVE "DDMMYY" TO CC-DATE-FORMAT
045400     ELSE
045500     MOVE "MMDDYY" TO CC-DATE-FORMAT.
046500     MOVE SPACES TO ZONE-WORK-1 ZONE-WORK-2 ZONE-WORK-3.
046600     MOVE 0 TO RECS-TO-SRT-CTR.
      *--- IF REQUESTOR IS CRAFTSMAN, MOVE CLOCK CARD NUMBER
      *--- INTO SCREEN AND PROTECT FIELD
           IF REQUESTOR = "C"
               MOVE SPACES    TO CC-PRT-DESC
               MOVE SPACES    TO CC-PRT-NUM
               MOVE CC-BUFFER TO CC-NO
               MOVE B"1" TO IND(08)
           ELSE
               MOVE "ENTER PRINTER/SPOOLER NUMBER" TO CC-PRT-DESC
               MOVE SPACES TO CC-PRT-NUM
               MOVE B"1"   TO IND(30)
           END-IF.

       6-MAIN-2.
           MOVE CC-WORK-AREA TO DSPLY-REC.
           PERFORM 99-SCREEN-WRITE.
           PERFORM 98-SCREEN-READ.
           MOVE DSPLY-REC TO CC-WORK-AREA.
047800     IF VIEW-LASTKEY = 3
               GO TO 6-MAIN-X
           END-IF.
048500     IF DATE-FLAG = 3
048600         MOVE CC-DATE-MD TO CUR-DATE-LBR-DM
048700         MOVE CC-DATE-DM TO CUR-DATE-LBR-MD
048800         MOVE CC-DATE-YY TO CUR-DATE-LBR-YY
048900     ELSE
049000     MOVE CC-DATE-MD TO CUR-DATE-LBR-MD
049100     MOVE CC-DATE-DM TO CUR-DATE-LBR-DM
049200     MOVE CC-DATE-YY TO CUR-DATE-LBR-YY.
           IF CUR-DATE-LBR-YY > "70"
               MOVE "19" TO CUR-DATE-LBR-CC
           ELSE
           MOVE "20" TO CUR-DATE-LBR-CC.
           IF CC-NO = "XXXX"
               PERFORM 990-VALIDATE-PRINTER
               IF CHKOBJ-STATUS NOT = "00"
      *        "I91: INVALID PRTR: USE ANOTHER OR 'LP' FOR LINE PRTR"
                   MOVE 09                   TO  CATREAD-MSG-SET
                   MOVE 091                  TO  CATREAD-MSG-NUM
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE ERROR-BUFFER TO CC-CMD-LINE
                   MOVE B"1"         TO IND(30), IND(31)
                   GO TO 6-MAIN-2
               END-IF
               MOVE RS-SHIFT-FLD-7-8 TO OVRPRTF-TOFILE-NUM-X
               MOVE 66               TO OVRPRTF-PAGESIZE
               MOVE 60               TO OVRPRTF-OVRFLW
               MOVE 6                TO OVRPRTF-LPI
               PERFORM 996-OVERRIDE-PRINT-FILE
               OPEN OUTPUT PRINT-FILE
049400         IF CC-DATE IS NUMERIC
049500             PERFORM 60-SET-DATE-RANGE THRU 60-SDR-EXIT
049700             SORT SORT-FILE ON ASCENDING KEY SORT-CC-NO
049800                 INPUT PROCEDURE  63-SORT-LABOR
049900                 OUTPUT PROCEDURE 64-WRITE-LABOR
                       MOVE 1 TO ACT-KEY
                       CLOSE OUT-FILE
                       OPEN INPUT OUT-FILE
                       PERFORM 65-SPOOL-OUTFILE
                       CLOSE PRINT-FILE
                       MOVE 3 TO VIEW-LASTKEY
050100                 GO TO 6-MAIN-X
050200         ELSE
050300         PERFORM 61-GET-DATE-RANGE THRU 61-GDR-EXIT
050500         SORT SORT-FILE ON ASCENDING KEY SORT-KEY
050600             INPUT PROCEDURE  63-SORT-LABOR
050700             OUTPUT PROCEDURE 64-WRITE-LABOR
                   MOVE 1 TO ACT-KEY
                   CLOSE OUT-FILE
                   OPEN INPUT OUT-FILE
                   PERFORM 65-SPOOL-OUTFILE
                   CLOSE PRINT-FILE
                   MOVE 3 TO VIEW-LASTKEY
050900             GO TO 6-MAIN-X.
           MOVE 0 TO COND-WORD.
           MOVE CC-NO TO LBRCCNUM OF WLFREC.
           START WO-LABOR-FILE KEY IS = EXTERNALLY-DESCRIBED-KEY
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF WLF-STATUS NOT = "00" MOVE 17 TO COND-WORD.
051200     IF COND-WORD NOT = 0
051300         MOVE 29023 TO CATREAD-MSG-NUMBER
051500         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE TRUE-VAL TO INDS (1) INDS (99)
052000         GO TO 6-MAIN.
052100     MOVE 1 TO SUB.
052200     MOVE SPACES TO WO-LABOR-SCREEN.
052300     MOVE "FRETPRNT" TO VIEW-CFNAME.
052900     PERFORM 62-GET-LABOR THRU 62-GL-X.

       6-MAIN-X.
           EXIT.
053700
055000 60-SET-DATE-RANGE.
055100     IF DATE-FLAG = 3
055200         MOVE CC-DATE-MD TO GREG-DD DD-CUR-9
055300         MOVE CC-DATE-DM TO GREG-MM MM-CUR-9
055400         MOVE CC-DATE-YY TO GREG-YY YY-CUR-9
055500     ELSE
055600     MOVE CC-DATE-MD TO GREG-MM MM-CUR-9
055700     MOVE CC-DATE-DM TO GREG-DD DD-CUR-9
055800     MOVE CC-DATE-YY TO GREG-YY YY-CUR-9.
           IF YY-CUR-9 > 70
               MOVE 19 TO CC-CUR
           ELSE
           MOVE 20 TO CC-CUR.
           MOVE SPACES TO JULIAN-DATE.
           IF GREG-YY > "70"
               MOVE "19" TO GREG-CC
           ELSE
           MOVE "20"     TO GREG-CC.
           IF CODE-VALUE = "2"
               ADD 1 TO SCND-SHIFT GIVING TIME-CUR-9
           ELSE
055900     ADD 1 THRD-SHIFT GIVING TIME-CUR-9.
056100     CALL "JULGREG" USING GREG-DATE, JULIAN-DATE,
                            DAY-DIGIT, LEAP-YEAR-FLAG.
056200     SUBTRACT 1 FROM JULIAN-DATE-9.
           MOVE SPACES TO GREG-DATE.
056300     CALL "JULGREG" USING GREG-DATE, JULIAN-DATE,
                            DAY-DIGIT, LEAP-YEAR-FLAG.
           IF CODE-VALUE = "2"
               MOVE SCND-SHIFT TO TIME-24HR-9
           ELSE
056500     MOVE THRD-SHIFT TO TIME-24HR-9.
056600     MOVE GREG-YY TO YY-24HR-9.
           IF YY-24HR-9 > 70
               MOVE 19 TO CC-24HR
           ELSE
           MOVE 20 TO CC-24HR.
056700     MOVE GREG-MM TO MM-24HR-9.
056800     MOVE GREG-DD TO DD-24HR-9.

056900 60-SDR-EXIT.
           EXIT.

057000 61-GET-DATE-RANGE.
057100     MOVE "FRETLAB2" TO VIEW-CFNAME.
058300     MOVE SPACES TO DATE-RANGE.
058400     IF DATE-FLAG = 3
058500         MOVE "DDMMYY" TO DR-FROM-FORMAT DR-TO-FORMAT
058600     ELSE
058700     MOVE "MMDDYY" TO DR-FROM-FORMAT DR-TO-FORMAT.

       61-GDR-LOOP.
           MOVE DATE-RANGE TO DSPLY-REC.
059400     PERFORM 99-SCREEN-WRITE.
059500     PERFORM 98-SCREEN-READ.
           MOVE DSPLY-REC TO DATE-RANGE.
060500     IF VIEW-LASTKEY = 3 GO TO 2-EOJ.
061100     IF DR-FROM-TIME = "    "
               IF CODE-VALUE = "2"
                   MOVE SCND-SHIFT TO TIME-24HR-9
               ELSE
061200             MOVE THRD-SHIFT TO TIME-24HR-9
               END-IF
061300     ELSE
061400     MOVE DR-FROM-TIME TO TIME-24HR-9.
061500     IF DR-TO-TIME = "    "
               IF CODE-VALUE = "2"
                   ADD 1 TO SCND-SHIFT GIVING TIME-CUR-9
               ELSE
061600             ADD 1 TO THRD-SHIFT GIVING TIME-CUR-9
               END-IF
061700     ELSE
061800     MOVE DR-TO-TIME TO TIME-CUR-9.
           IF DATE-FLAG = 3
               IF DR-FROM-MD > 00 AND < 32
                   IF DR-FROM-DM > 00 AND < 13
                       IF DR-FROM-YY IS NUMERIC
                           NEXT SENTENCE
                       ELSE
                       MOVE 35032 TO CATREAD-MSG-NUMBER
                       PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                       MOVE ERROR-BUFFER TO DATE-ERR-LINE
                       MOVE TRUE-VAL TO INDS (1) INDS (99)
                       GO TO 61-GDR-LOOP
                   ELSE
                   MOVE 35031 TO CATREAD-MSG-NUMBER
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE ERROR-BUFFER TO DATE-ERR-LINE
                   MOVE TRUE-VAL TO INDS (1) INDS (99)
                   GO TO 61-GDR-LOOP
               ELSE
               MOVE 35030 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE ERROR-BUFFER TO DATE-ERR-LINE
               MOVE TRUE-VAL TO INDS (1) INDS (99)
               GO TO 61-GDR-LOOP
           ELSE
           IF DR-FROM-MD > 00 AND < 13
               IF DR-FROM-DM > 00 AND < 32
                   IF DR-FROM-YY IS NUMERIC
                       NEXT SENTENCE
                   ELSE
                   MOVE 35032 TO CATREAD-MSG-NUMBER
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE ERROR-BUFFER TO DATE-ERR-LINE
                   MOVE TRUE-VAL TO INDS (1) INDS (99)
                   GO TO 61-GDR-LOOP
               ELSE
               MOVE 35030 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE ERROR-BUFFER TO DATE-ERR-LINE
               MOVE TRUE-VAL TO INDS (1) INDS (99)
               GO TO 61-GDR-LOOP
           ELSE
           MOVE 35031 TO CATREAD-MSG-NUMBER
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
           MOVE ERROR-BUFFER TO DATE-ERR-LINE
           MOVE TRUE-VAL TO INDS (1) INDS (99)
           GO TO 61-GDR-LOOP.
061900     MOVE 3 TO DATE-MODE.
062000     MOVE DATE-FROM TO DATE-VALIDATE-IN.
062100     CALL "TDATECHK" USING DATE-CHECK-AREA.
062200     MOVE DATE-DB TO YYMMDD-24HR.
           IF YY-24HR-9 > 70
               MOVE 19 TO CC-24HR
           ELSE
           MOVE 20 TO CC-24HR.
           IF DATE-FLAG = 3
               IF DR-TO-MD > 00 AND < 32
                   IF DR-TO-DM > 00 AND < 13
                       IF DR-TO-YY IS NUMERIC
                           NEXT SENTENCE
                       ELSE
                       MOVE 35032 TO CATREAD-MSG-NUMBER
                       PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                       MOVE ERROR-BUFFER TO DATE-ERR-LINE
                       MOVE TRUE-VAL TO INDS (2) INDS (99)
                       GO TO 61-GDR-LOOP
                   ELSE
                   MOVE 35031 TO CATREAD-MSG-NUMBER
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE ERROR-BUFFER TO DATE-ERR-LINE
                   MOVE TRUE-VAL TO INDS (2) INDS (99)
                   GO TO 61-GDR-LOOP
               ELSE
               MOVE 35030 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE ERROR-BUFFER TO DATE-ERR-LINE
               MOVE TRUE-VAL TO INDS (2) INDS (99)
               GO TO 61-GDR-LOOP
           ELSE
           IF DR-TO-MD > 00 AND < 13
               IF DR-TO-DM > 00 AND < 32
                   IF DR-TO-YY IS NUMERIC
                       NEXT SENTENCE
                   ELSE
                   MOVE 35032 TO CATREAD-MSG-NUMBER
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE ERROR-BUFFER TO DATE-ERR-LINE
                   MOVE TRUE-VAL TO INDS (2) INDS (99)
                   GO TO 61-GDR-LOOP
               ELSE
               MOVE 35030 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE ERROR-BUFFER TO DATE-ERR-LINE
               MOVE TRUE-VAL TO INDS (2) INDS (99)
               GO TO 61-GDR-LOOP
           ELSE
           MOVE 35031 TO CATREAD-MSG-NUMBER
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
           MOVE ERROR-BUFFER TO DATE-ERR-LINE
           MOVE TRUE-VAL TO INDS (2) INDS (99)
           GO TO 61-GDR-LOOP.
062300     MOVE DATE-TO TO DATE-VALIDATE-IN.
062400     CALL "TDATECHK" USING DATE-CHECK-AREA.
062500     MOVE DATE-DB TO YYMMDD-CUR.
           IF YY-CUR-9 > 70
               MOVE 19 TO CC-CUR
           ELSE
           MOVE 20 TO CC-CUR.
           IF 24-HR-CHECK > CUR-CHECK
               MOVE 04056 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE ERROR-BUFFER TO DATE-ERR-LINE
               MOVE TRUE-VAL TO INDS (1) INDS (99)
               GO TO 61-GDR-LOOP.

062600 61-GDR-EXIT.
           EXIT.

062700 62-GET-LABOR.
           MOVE 0 TO COND-WORD.
           READ WO-LABOR-FILE NEXT INTO WO-LABOR-BUFF
               AT END    MOVE 15 TO COND-WORD.
           IF CC-NO NOT = LBRCCNUM OF WLFREC MOVE 15 TO COND-WORD.
           IF WLF-STATUS NOT = "00" MOVE 15 TO COND-WORD.
063100     IF COND-WORD = 15
               MOVE 66124 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE ERROR-BUFFER TO WLS-CMD-LINE
               MOVE WO-LABOR-SCREEN TO DSPLY-REC
               PERFORM 99-SCREEN-WRITE
063600         PERFORM 98-SCREEN-READ
064400         GO TO 62-GL-X.
066600     IF LBR-COMPL-DATE-CN NOT = CUR-DATE-LBR-CN
               GO TO 62-GET-LABOR.
066700     MOVE LBR-WO-NUM TO LBR-WO-NUM-S (SUB).
066800     MOVE LBR-EMPL-NUM TO LBR-EMPL-NUM-S (SUB).
066900     MOVE LBR-EMPL-NAME TO LBR-EMPL-NAME-S (SUB).
067000     MOVE LBR-CRAFT TO LBR-CRAFT-S (SUB).
067100     MOVE LABOR-HRS TO LBR-HRS-S (SUB).
067200     MOVE LBR-SHIFT TO LBR-SHIFT-S (SUB).
067300     MOVE LBR-START-DATE TO LBR-STDT-S (SUB).
067400     MOVE LBR-START-TIME TO LBR-STTM-S (SUB).
067500     MOVE LBR-COMPL-DATE TO LBR-CODT-S (SUB).
067600     MOVE LBR-COMPL-TIME TO LBR-COTM-S (SUB).
           PERFORM 62-GET-FAILURE-CODE THRU 62-GFC-EXIT.
067800     IF SUB = 20
               MOVE 66229 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE ERROR-BUFFER TO WLS-CMD-LINE
               MOVE WO-LABOR-SCREEN TO DSPLY-REC
               PERFORM 99-SCREEN-WRITE
               PERFORM 98-SCREEN-READ
069100         IF VIEW-LASTKEY = 3
                   GO TO 62-GL-X
070800         ELSE
070900         IF VIEW-LASTKEY = 2
071000             MOVE "FRETLAB1" TO VIEW-CFNAME
071200             GO TO 62-GL-X
               ELSE
               MOVE 1 TO SUB
               MOVE SPACES TO WLS-DATA
               GO TO 62-GET-LABOR.
067700     ADD 1 TO SUB.
071700     GO TO 62-GET-LABOR.

       62-GL-X.
           EXIT.

       62-GET-FAILURE-CODE.
           MOVE SPACES TO WO-BASIC-DATA, WO-PLANNED-DATA.
           MOVE 0 TO COND-WORD.
           MOVE LBR-WO-NUM TO WONUM OF WBFREC.
           START WO-BASIC-FILE KEY IS = EXTERNALLY-DESCRIBED-KEY
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF WBF-STATUS NOT = "00"
               MOVE 17 TO COND-WORD
           END-IF.
           IF COND-WORD = 17
               GO TO 62-CHECK-PLANNED
           END-IF.
           READ WO-BASIC-FILE NEXT INTO WO-BASIC-DATA
               AT END    MOVE 15 TO COND-WORD.
           IF WBF-STATUS NOT = "00"
               MOVE 15 TO COND-WORD
           END-IF.
           IF COND-WORD = 15
               GO TO 62-CHECK-PLANNED
           END-IF.
           MOVE FAILURE-CODE TO LBR-FAIL-CDE (SUB).
           GO TO 62-GFC-EXIT.

       62-CHECK-PLANNED.
           MOVE 0 TO COND-WORD.
           MOVE LBR-WO-NUM TO WONUM OF WPFREC.
           START WO-PLANNED-FILE KEY IS = EXTERNALLY-DESCRIBED-KEY
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF WPF-STATUS NOT = "00"
               MOVE 17 TO COND-WORD
           END-IF.
           IF COND-WORD = 17
               GO TO 62-GFC-EXIT
           END-IF.
           READ WO-PLANNED-FILE NEXT INTO WO-PLANNED-DATA
               AT END    MOVE 15 TO COND-WORD.
           IF WPF-STATUS NOT = "00"
               MOVE 15 TO COND-WORD
           END-IF.
           IF COND-WORD = 15
               GO TO 62-GFC-EXIT
           END-IF.
           MOVE FAILURE-CODE-P TO LBR-FAIL-CDE (SUB).

       62-GFC-EXIT.
           EXIT.
071800
       98-SCREEN-READ.
           READ DISPLAY-FILE FORMAT IS VIEW-CFNAME
               INDIC ARE SCREEN-INDICATORS
               MOVE FUNCTION-NUM TO VIEW-LASTKEY
               MOVE ALL B"0" TO SCREEN-INDICATORS.

       99-SCREEN-WRITE.
           WRITE DSPLY-REC FORMAT IS VIEW-CFNAME
               INDIC ARE SCREEN-INDICATORS.


       990-VALIDATE-PRINTER.
      *------ VALIDATE THAT THE PRINTER ENTERED BY THE USER EXISTS
      *------ AS AN FILE OBJECT STARTING WITH MCPRT AT THE PLANT.
           MOVE CC-PRT-NUM               TO  LS-SHIFT-FLD.
           CALL "TLSHIFT" USING LS-RET-CODE, LS-SHIFT-FLD.
           MOVE LS-SHIFT-FLD             TO  RS-SHIFT-FLD.
           CALL "TRSHIFT" USING LS-RET-CODE, RS-SHIFT-FLD.
           MOVE SPACES                   TO  HOLD-PRINT-FILE
                                             CHKOBJ-STATUS.
           STRING "MCPRT" DELIMITED BY SIZE,
                  RS-SHIFT-FLD-7-8 DELIMITED BY SPACES,
             INTO HOLD-PRINT-FILE.
           CALL "CCHKOBJ3" USING HOLD-PRINT-FILE, FILE-TYPE,
                                 CHKOBJ-STATUS.

       COPY OVRPFCALL IN COPYLIB.

       999-CATREAD.
           MOVE SPACES TO ERROR-BUFFER.
           CALL "CCATREAD" USING CATREAD-PARMS.
           MOVE CATREAD-MSG-TEXT TO ERROR-BUFFER.

       999-CATREAD-EXIT.
           EXIT.

085600 63-SORT-LABOR.
           MOVE 0 TO ACT-KEY.
           OPEN OUTPUT OUT-FILE.
           PERFORM 63A-SL-CONT THRU 63A-SL-EXIT.

       63A-SL-CONT.
           MOVE 0 TO COND-WORD.
           READ WO-LABOR-FILE NEXT INTO WO-LABOR-BUFF
               AT END    MOVE 15 TO COND-WORD.
           IF WLF-STATUS NOT = "00" MOVE 15 TO COND-WORD.
085900     IF COND-WORD = 15
086000         MOVE SPACES TO WO-LABOR-BUFF
086100         GO TO 63A-SL-EXIT.
086200     MOVE LBR-COMPL-DATE-CN TO LBR-DATE-WA.
086300     MOVE LBR-COMPL-TIME    TO LBR-TIME-WA.
086400     IF LBR-DATE-TIME-WA > 24-HR-CHECK
086500         AND < CUR-CHECK
086600             NEXT SENTENCE
086700     ELSE
086800     GO TO 63A-SL-CONT.
086900     PERFORM 63A-LOCATE-WO THRU 63A-LW-EXIT.
087000     IF ZONE-READ = "BC  "
087100         MOVE "B3  " TO ZONE-WORK-1
087200         MOVE "C1  " TO ZONE-WORK-2
087300         MOVE "C2  " TO ZONE-WORK-3
087400     ELSE
087500     IF ZONE-READ = "AA  "
087600         MOVE "A2  " TO ZONE-WORK-1
087700         MOVE "A3  " TO ZONE-WORK-2
087800         MOVE "XXXX" TO ZONE-WORK-3
087900     ELSE
088000     IF ZONE-READ = "BB  "
088100         MOVE "B1  " TO ZONE-WORK-1
088200         MOVE "B2  " TO ZONE-WORK-2
088300         MOVE "XXXX" TO ZONE-WORK-3
088400     ELSE
088500     IF ZONE-READ = "CC  "
088600         MOVE "C1  " TO ZONE-WORK-1
088700         MOVE "C2  " TO ZONE-WORK-2
088800         MOVE "XXXX" TO ZONE-WORK-3
088900     ELSE
089000     IF ZONE-READ = "A   "
               MOVE "A   " TO ZONE-WORK-1
089100         MOVE "A1  " TO ZONE-WORK-2
089200         MOVE "A2  " TO ZONE-WORK-3
089300         MOVE "A3  " TO ZONE-WORK-4
089400     ELSE
           IF ZONE-READ = "C   "
               MOVE "C   " TO ZONE-WORK-1
               MOVE "C1  " TO ZONE-WORK-2
               MOVE "C2  " TO ZONE-WORK-3
           ELSE
           IF ZONE-READ = "D   "
               MOVE "D   " TO ZONE-WORK-1
               MOVE "D1  " TO ZONE-WORK-2
               MOVE "D2  " TO ZONE-WORK-3
               MOVE "D3  " TO ZONE-WORK-4
           ELSE
           IF ZONE-READ = "F   "
               MOVE "F   " TO ZONE-WORK-1
               MOVE "F3  " TO ZONE-WORK-2
               MOVE "F4  " TO ZONE-WORK-3
           ELSE
089500     IF ZONE-READ = "    "
089600         MOVE SORT-ZONE TO ZONE-WORK-1
089700     ELSE
089800     MOVE ZONE-READ TO ZONE-WORK-1.
089900     IF SORT-ZONE = "    " OR ZONE-WORK-1 OR ZONE-WORK-2
090000         OR ZONE-WORK-3 OR ZONE-WORK-4
090100             NEXT SENTENCE
090200     ELSE
090300     GO TO 63A-SL-CONT.
090400     IF ZONE-READ = "A    " MOVE "A    " TO SORT-ZONE.
090500     MOVE LBR-WO-NUM TO SORT-WO-NO.
090600     MOVE LBR-EMPL-NUM TO SORT-CC-NO.
090700     MOVE LBR-EMPL-NAME TO SORT-EMPL-NAME.
090800     MOVE LBR-CRAFT TO SORT-CRAFT.
090900     MOVE LABOR-HRS TO SORT-HRS.
091000     MOVE LBR-DATE TO SORT-DATE.
091200     MOVE LBR-START-DATE TO SORT-START-DATE.
091300     MOVE LBR-START-TIME TO SORT-START-TIME.
091400     MOVE LBR-COMPL-DATE TO SORT-COMPL-DATE.
091500     MOVE LBR-COMPL-TIME TO SORT-COMPL-TIME.
091600     ADD 1 TO RECS-TO-SRT-CTR.
091700     RELEASE SORTF.
091800     GO TO 63A-SL-CONT.
091900
092000 63A-LOCATE-WO.
092100     MOVE SPACES TO WO-BASIC-DATA WO-PLANNED-DATA.
           MOVE 0 TO COND-WORD.
           MOVE LBR-WO-NUM TO WONUM OF WBFREC.
           START WO-BASIC-FILE KEY IS = EXTERNALLY-DESCRIBED-KEY
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF WBF-STATUS NOT = "00" MOVE 17 TO COND-WORD.
092700     IF COND-WORD = 17 GO TO 63A-CHECK-PLANNED.
           MOVE 0 TO COND-WORD.
           READ WO-BASIC-FILE NEXT INTO WO-BASIC-DATA
               AT END    MOVE 15 TO COND-WORD.
           IF WBF-STATUS NOT = "00" MOVE 15 TO COND-WORD.
093000     IF COND-WORD = 15 GO TO 63A-CHECK-PLANNED.
093100     MOVE ZONE TO SORT-ZONE.
           MOVE FAILURE-CODE TO SORT-FAILURE-CODE.
093200     GO TO 63A-LW-EXIT.

093300 63A-CHECK-PLANNED.
           MOVE 0 TO COND-WORD.
           MOVE LBR-WO-NUM TO WONUM OF WPFREC.
           START WO-PLANNED-FILE KEY IS = EXTERNALLY-DESCRIBED-KEY
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF WPF-STATUS NOT = "00" MOVE 17 TO COND-WORD.
093700     IF COND-WORD = 17 GO TO 63A-LW-EXIT.
           READ WO-PLANNED-FILE NEXT INTO WO-PLANNED-DATA
               AT END    MOVE 15 TO COND-WORD.
           IF WPF-STATUS NOT = "00" MOVE 15 TO COND-WORD.
094000     IF COND-WORD = 15 GO TO 63A-LW-EXIT.
094100     MOVE ZONE-P TO SORT-ZONE.

094200 63A-LW-EXIT.
           EXIT.
094300
094400 63A-SL-EXIT.
           EXIT.

094500 64-WRITE-LABOR.
094800     IF DATE-FLAG = 3
094900         MOVE MM-24HR-9 TO FROM-DM
095000         MOVE DD-24HR-9 TO FROM-MD
095100         MOVE YY-24HR-9 TO FROM-YY
095200         MOVE MM-CUR-9  TO TO-DM
095300         MOVE DD-CUR-9  TO TO-MD
095400         MOVE YY-CUR-9  TO TO-YY
095500     ELSE
095600     MOVE MM-24HR-9 TO FROM-MD
095700     MOVE DD-24HR-9 TO FROM-DM
095800     MOVE YY-24HR-9 TO FROM-YY
095900     MOVE MM-CUR-9  TO TO-MD
096000     MOVE DD-CUR-9  TO TO-DM
096100     MOVE YY-CUR-9  TO TO-YY.
           IF CODE-VALUE = "2"
               MOVE FRST-SHIFT TO FROM-T TO-T
           ELSE
096200     MOVE THRD-SHIFT TO FROM-T TO-T.
           IF DATE-RANGE = SPACES
               NEXT SENTENCE
           ELSE
           IF DATE-FLAG = 3
               MOVE DR-FROM-DM   TO FROM-DM
               MOVE DR-FROM-MD   TO FROM-MD
               MOVE DR-FROM-YY   TO FROM-YY
               MOVE DR-FROM-TIME TO FROM-T
               MOVE DR-TO-DM     TO TO-DM
               MOVE DR-TO-MD     TO TO-MD
               MOVE DR-TO-YY     TO TO-YY
               MOVE DR-TO-TIME   TO TO-T
           ELSE
           MOVE DR-FROM-MD       TO FROM-MD
           MOVE DR-FROM-DM       TO FROM-DM
           MOVE DR-FROM-YY       TO FROM-YY
           MOVE DR-FROM-TIME     TO FROM-T
           MOVE DR-TO-MD         TO TO-MD
           MOVE DR-TO-DM         TO TO-DM
           MOVE DR-TO-YY         TO TO-YY
           MOVE DR-TO-TIME       TO TO-T.
           PERFORM 64B-WL-BALANCE THRU 64B-WL-EXIT.

       64A-WL-EXIT.
           EXIT.

       64B-WL-BALANCE.
096900     RETURN SORT-FILE AT END GO TO 64B-WL-EXIT.
097500     ADD 1 TO ACT-KEY.
097100     MOVE SORTF TO OUT-DATA.
097200     WRITE OUTF    INVALID KEY GO TO 64B-WL-EXIT.
097700     GO TO 64B-WL-BALANCE.

097800 64B-WL-EXIT.
           EXIT.

071900 65-SPOOL-OUTFILE.
072000     IF RECS-TO-SRT-CTR = 0 GO TO 65-SO-EXIT.
           PERFORM 66-HEADING-RTN.
           PERFORM 65-SPOOL-OUTFILE-CONT THRU 65-SO-EXIT
               UNTIL ACT-KEY > RECS-TO-SRT-CTR.
           PERFORM 65-CLOSE-SPOOL.

073700 65-SPOOL-OUTFILE-CONT.
           IF LINE-CTR > 60
               MOVE SPACES TO PRINTF
               WRITE PRINTF AFTER ADVANCING NEWPAGE
               PERFORM 66-HEADING-RTN
           END-IF.
           READ OUT-FILE
               INVALID KEY GO TO 65-SO-EXIT.
074100     MOVE SPACES TO PRINTF PRINT-BUFF.
074200     IF OUT-CC-NO NOT = SAVE-CC-NO
               IF ACT-KEY = 1
074400             MOVE OUT-CC-NO TO SAVE-CC-NO PRINT-CC-NO
074700             MOVE ZEROS TO CC-TOTAL
074800         ELSE
074900         MOVE SPACES TO PRINTF PRINT-BUFF
075000         MOVE "_____" TO PRINT-HRS-REDF
075100         MOVE PRINT-BUFF TO PRINTF
075200         WRITE PRINTF BEFORE ADVANCING LINE-ADV
               ADD LINE-ADV TO LINE-CTR
075300         IF CC-TOTAL > 08.0
075400             MOVE ASTERISK-LINE TO PRINT-BUFF
075500             MOVE " " TO PRT-FILL1 PRT-FILL2
075600             MOVE CC-TOTAL TO PRINT-HRS
075700             MOVE PRINT-BUFF TO PRINTF
075800             WRITE PRINTF BEFORE ADVANCING LINE-ADV
                   ADD LINE-ADV TO LINE-CTR
                   MOVE 1 TO LINE-ADV
075900             MOVE SPACES TO PRINTF PRINT-BUFF
076100             MOVE OUT-CC-NO TO SAVE-CC-NO PRINT-CC-NO
076200             MOVE ZEROS TO CC-TOTAL
076300         ELSE
076400         MOVE CC-TOTAL TO PRINT-HRS
076500         MOVE PRINT-BUFF TO PRINTF
076600         WRITE PRINTF BEFORE ADVANCING LINE-ADV
               ADD LINE-ADV TO LINE-CTR
076700         MOVE SPACES TO PRINTF PRINT-BUFF
076900         MOVE OUT-CC-NO TO SAVE-CC-NO PRINT-CC-NO
077000         MOVE ZEROS TO CC-TOTAL
077100     ELSE
077200     MOVE SPACES TO PRINT-CC-NO.
077300     IF DATE-RANGE = SPACES
077400         NEXT SENTENCE
077500     ELSE
077600     IF OUT-ZONE NOT = SAVE-ZONE
077700         IF ACT-KEY = 1
077800             MOVE OUT-ZONE TO SAVE-ZONE ZONE-PRT
077900             MOVE ZONE-HDR TO PRINTF
078000             WRITE PRINTF AFTER ADVANCING LINE-ADV
                   ADD LINE-ADV TO LINE-CTR
                   MOVE 2 TO LINE-ADV
078100             MOVE SPACES TO PRINTF
078300         ELSE
078400         MOVE OUT-ZONE TO SAVE-ZONE ZONE-PRT
078500         MOVE SPACES TO PRINTF
078700         MOVE ZONE-HDR TO PRINTF
078800         WRITE PRINTF AFTER ADVANCING LINE-ADV
               ADD LINE-ADV TO LINE-CTR.
079100     MOVE OUT-WO-NO TO PRINT-WO-NO.
079200     MOVE OUT-EMPL-NAME TO PRINT-EMPL-NAME.
079300     MOVE OUT-CRAFT     TO PRINT-CRAFT.
           MOVE OUT-HRS        TO PRINT-HRS.
079500     ADD OUT-HRS         TO TOTAL-HOURS.
079600     MOVE OUT-SHIFT      TO PRINT-SHIFT.
079800     MOVE OUT-START-DATE TO PRINT-STDT.
079900     MOVE OUT-START-TIME TO PRINT-STTM.
080000     MOVE OUT-COMPL-DATE TO PRINT-CODT.
080100     MOVE OUT-COMPL-TIME TO PRINT-COTM.
           MOVE OUT-FAIL-CODE  TO PRINT-FAIL-CDE.
080200     MOVE PRINT-BUFF TO PRINTF.
080300     WRITE PRINTF AFTER ADVANCING LINE-ADV.
           ADD LINE-ADV TO LINE-CTR.
080400     ADD OUT-HRS TO CC-TOTAL.
           MOVE 1 TO LINE-ADV.
           ADD 1 TO ACT-KEY.

       65-SO-EXIT.
           EXIT.

080700 65-CLOSE-SPOOL.
080800     MOVE SPACES TO PRINTF PRINT-BUFF.
080900     MOVE "_____" TO PRINT-HRS-REDF.
081000     MOVE PRINT-BUFF TO PRINTF.
081100     WRITE PRINTF BEFORE ADVANCING 1 LINES.
081200     IF CC-TOTAL > 08.0
081300         MOVE ASTERISK-LINE TO PRINT-BUFF
081400         MOVE " " TO PRT-FILL1 PRT-FILL2
081500         MOVE CC-TOTAL TO PRINT-HRS
081600         MOVE PRINT-BUFF TO PRINTF
081700         WRITE PRINTF BEFORE ADVANCING 1 LINES
081800         MOVE TOTAL-HOURS TO PRT-TOT-HRS
081900         MOVE PRINT-TOTAL TO PRINTF
082000         WRITE PRINTF AFTER ADVANCING 1 LINES
082300         MOVE SPACES TO PRINTF PRINT-BUFF
082400         MOVE " END OF REPORT  " TO PRINT-EMPL-NAME
               MOVE WORK-DATE TO PRINT-STDT
082600         MOVE TIME-HHMM TO PRINT-HRS-REDF
082700         MOVE PRINT-BUFF TO PRINTF
082800         WRITE PRINTF AFTER ADVANCING 3 LINES
083200     ELSE
083300     MOVE CC-TOTAL TO PRINT-HRS
083400     MOVE PRINT-BUFF TO PRINTF
083500     WRITE PRINTF BEFORE ADVANCING 1 LINES
083600     MOVE TOTAL-HOURS TO PRT-TOT-HRS
083700     MOVE PRINT-TOTAL TO PRINTF
083800     WRITE PRINTF AFTER ADVANCING 1 LINES
083900     MOVE SPACES TO PRINTF PRINT-BUFF
084000     WRITE PRINTF AFTER ADVANCING 1 LINES
084100     MOVE SPACES TO PRINTF PRINT-BUFF
084200     MOVE " END OF REPORT  " TO PRINT-EMPL-NAME
           MOVE WORK-DATE TO PRINT-STDT
084400     MOVE TIME-HHMM TO PRINT-HRS-REDF
084500     MOVE PRINT-BUFF TO PRINTF
084600     WRITE PRINTF AFTER ADVANCING 3 LINES.

       66-HEADING-RTN.
           MOVE ZEROS TO LINE-CTR.
           MOVE SPACES TO PRINTF PRINT-BUFF.
           MOVE REPORT-HDR TO PRINTF.
           WRITE PRINTF AFTER ADVANCING 3 LINES.
           MOVE SPACES TO PRINTF PRINT-BUFF.
           MOVE PRINT-HDR1 TO PRINTF.
           WRITE PRINTF AFTER ADVANCING 2 LINES.
           MOVE SPACES TO PRINTF PRINT-BUFF.
           MOVE PRINT-HDR2 TO PRINTF.
           WRITE PRINTF AFTER ADVANCING 1 LINE.
           ADD 5 TO LINE-CTR.
           MOVE 2 TO LINE-ADV.

