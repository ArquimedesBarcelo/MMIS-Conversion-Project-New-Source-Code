000200 IDENTIFICATION DIVISION.
000300 PROGRAM-ID. TRETLABR.
      *REMARKS.    RETRIEVE LABOR REPORT.
      **********************************************************
      *                                                        *
      *   MMIS SYSTEM - REPORT WILL RETRIEVE LABOR BASED       *
      *   ON A CRAFTSMAN NUMBER OR DATE AND TIME.              *
      *                                                        *
      **********************************************************
      *C
      *C 05/28/2003  WR FONAGY
      *C   ADDED THE FAILURE CODE TO THE REPORT.  ALSO, ADDED
      *C   THE ABILITY OF THE CRAFTSMAN TO GENERATE THIS
      *C   REPORT BASE ON THEIR OWN CLOCK NUMBER.  THIS WAS A
      *C   REQUEST FROM STEVE VAUGHN IN LAWTON.
      *C

000400 ENVIRONMENT DIVISION.
000500 CONFIGURATION SECTION.
000600 SOURCE-COMPUTER.   AS400.
000700 OBJECT-COMPUTER.   AS400.
       SPECIAL-NAMES.    LOCAL-DATA IS LOCAL-DATA-AREA
                         C01 IS NEWPAGE.

001000 INPUT-OUTPUT SECTION.
001100 FILE-CONTROL.
           SELECT DISPLAY-FILE
               ASSIGN TO WORKSTATION-ZOFFLINE-SI
               ORGANIZATION IS TRANSACTION
               FILE STATUS IS DSPLY-STATUS
               CONTROL-AREA IS WS-CONTROL.

001200     SELECT OUT-FILE
               ASSIGN TO DATABASE-OUTRETLB
               ORGANIZATION IS RELATIVE
               ACCESS MODE IS RANDOM
               RELATIVE KEY IS ACT-KEY
               FILE STATUS IS OF-STATUS.

001500     SELECT PRINT-FILE
001600         ASSIGN TO PRINTER-MCPRT.

           SELECT SHIFT-STRUCTURE-FILE
               ASSIGN TO DATABASE-MCFLMM2501
               ORGANIZATION IS INDEXED
               ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
               FILE STATUS IS SSF-STATUS.

001700     SELECT SORT-FILE
               ASSIGN TO DISK-SORTFILE.

           SELECT WO-BASIC-FILE
               ASSIGN TO DATABASE-MCFLMM1001
               ORGANIZATION IS INDEXED
               ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
               WITH DUPLICATES
               FILE STATUS IS WBF-STATUS.

           SELECT WO-LABOR-FILE
               ASSIGN TO DATABASE-MCFLMM1302
               ORGANIZATION IS INDEXED
               ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY WITH DUPLICATES
               FILE STATUS IS WLF-STATUS.

           SELECT WO-LAST-NUM-USED
               ASSIGN TO DATABASE-MCFPMM0800
               ORGANIZATION IS RELATIVE
               ACCESS MODE IS RANDOM
               RELATIVE KEY IS ARG-NO
               FILE STATUS IS WLNU-STATUS.

           SELECT WO-PLANNED-FILE
               ASSIGN TO DATABASE-MCFLMM1101
               ORGANIZATION IS INDEXED
               ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
               WITH DUPLICATES
               FILE STATUS IS WPF-STATUS.

