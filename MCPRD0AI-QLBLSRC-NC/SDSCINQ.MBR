014700**                                                         **
014800**                VIEW COMMUNICATION AREA                  **
014900**                                                         **
015000**      ------ ALSO SEE WORKING STORAGE SECTION ------     **
015100**                                                         **
015200*************************************************************
015300*************************************************************
015400
015500 COPY VCOMLINK   IN COPYLIB.
015600 COPY LANGSUB    IN COPYLIB.
015700
015800 01  MPLTINFO-PARMS.
015900     05  MPLTINFO-PLANT-CODE       PIC X(3).
016000     05  MPLTINFO-DDESC-LANG       PIC X(3).
016100     05  MPLTINFO-DDESC2-LANG      PIC X(3).
016200
016300*************************************************************
016400**#########################################################**
016500*************************************************************
016600**                                                         **
016700**           P R O C E D U R E   D I V I S I O N           **
016800**                                                         **
016900*************************************************************
017000**#########################################################**
017100*************************************************************
017200
017300 PROCEDURE DIVISION USING BASE,
017400                          VIEW-COMAREA,
017500                          LANGUAGE-PARMS
017600                          MPLTINFO-PARMS.
017700
017800 INQUIRY SECTION.
017900
018000 BEGIN-HERE.
018100     PERFORM 1-HSK.
018200     PERFORM 6-MAIN THRU 6-MAIN-X.
           PERFORM 9999-CLOSES.
018300     GOBACK.
018400
018500 1-HSK.
018800     MOVE MPLTINFO-PLANT-CODE      TO   TMTLSTAT-COMPANY.
           PERFORM 9999-OPENS.
018900
019000 2100-BLOWUP.
018600     MOVE "SDSCINQ"                TO   BU-PGM-NAME.
019100     CALL "TBLOWUP" USING BASE, BU-PGM-NAME, STATUS-AREA,
019200           VIEW-COMAREA, DUMMY-KSAM-STAT, BU-DISPLAY-MSG,
019300           BU-DISPLAY-AREA.
019400
      *********************************************************
      *                      6 - M A I N                      *
      *********************************************************
       6-MAIN.
           MOVE "INQMENU" TO VIEW-NFNAME.

       6-PUT-WINDOW.
       6-SHOW-FORM.
      *----- f1,f2,f3, APPLICATION, f4 REFRESH,f5 PRT, f6,f7 INVALID, f8 EXIT
           MOVE 1                        TO   SRF-KEYSET.
           MOVE "I" TO SRF-FKEY (6), SRF-FKEY (7).
           PERFORM 9999-DO-SCREEN-1.

           IF VIEW-LASTKEY = EXIT-PROGRAM
               GO TO 6-MAIN-X.

       6-PERFORM-SELECTION.
           IF VIEW-LASTKEY = F1-KEY
               MOVE SPACES TO TMTLSTAT-CODE
               CALL "TMTLSTAT" USING BASE,
                                     VIEW-COMAREA,
                                     TMTLSTAT-COMPANY,
023800                               PASS-SPOOL-PRT,
023900                               TMTLSTAT-CODE,
024000                               LANGUAGE-PARMS
024100     ELSE
024200     IF VIEW-LASTKEY = F2-KEY
024300         MOVE "K"                  TO   SINQMFR-MFR-KWM-FLAG
024400         CALL "SINQMFR" USING BASE,
024500                              VIEW-COMAREA,
024600                              LANGUAGE-PARMS,
024700                              MPLTINFO-PARMS,
024800                              SINQMFR-PARMS
024900     ELSE
024200     IF VIEW-LASTKEY = HP-F3-KEY
025100         MOVE "M"                  TO   SINQMFR-MFR-KWM-FLAG
025200         CALL "SINQMFR" USING BASE,
025300                              VIEW-COMAREA,
025400                              LANGUAGE-PARMS,
025500                              MPLTINFO-PARMS,
025600                              SINQMFR-PARMS.
025700     GO TO 6-MAIN.
025800
025900 6-MAIN-X.
026000     EXIT.

       9999-OPENS.
           OPEN I-O DISPLAY-FILE.

       9999-CLOSES.
           CLOSE DISPLAY-FILE.

       999-CATREAD.
           CALL "CCATREAD" USING CATREAD-PARMS.
           MOVE CATREAD-MSG-TEXT TO MESSAGE-BUFFER.
           IF MESSAGE-BUFFER-1  = SPACES
               MOVE "* ERROR ON THIS FIELD *" TO MESSAGE-BUFFER.
       999-CATREAD-EXIT.
           EXIT.

       COPY SCRNCALL OF COPYLIB.
       COPY SCRNCL1  OF COPYLIB.
