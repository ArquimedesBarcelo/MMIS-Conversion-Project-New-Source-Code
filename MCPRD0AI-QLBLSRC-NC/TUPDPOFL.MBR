       IDENTIFICATION DIVISION.
       PROGRAM-ID.           TUPDPOFL.
       AUTHOR.               CA YODER.
       DATE-WRITTEN.         MAY 1997.
      *INSTALLATION.         GOODYEAR TIRE AND RUBBER CO.

      *D* REMARKS.
      *D*     THIS PROGRAM ALLOWS THE USER TO INQUIRE AND CHANGE
      *D*     MCFPPOFILE RECORDS.  IT CALLS PROGRAM "SUPDPOFL" TO
      *D*     UPDATE THE RECORDS.
      *C*

       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.
       SPECIAL-NAMES.      I-O-FEEDBACK IS I-O-FEEDBACK-AREA.

      ******************************************************************
       INPUT-OUTPUT SECTION.
      ******************************************************************
       FILE-CONTROL.
           SELECT DISPLAY-FILE
                  ASSIGN TO WORKSTATION-ZUPDPOFL-SI
                  ORGANIZATION IS TRANSACTION
                  ACCESS IS DYNAMIC
                  RELATIVE KEY IS SUBFILE-IX
                  FILE STATUS IS DISPLAY-STATUS
                  CONTROL-AREA IS WS-CONTROL.
           SELECT MPLTINFO-I
                  ASSIGN TO DATABASE-MCFLCS0501
                  ORGANIZATION IS INDEXED
                    ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                  FILE STATUS IS FILE-STATUS.
           SELECT MVALIDUM-I
                  ASSIGN TO DATABASE-MCFLCS0401
                  ORGANIZATION IS INDEXED
                    ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                  FILE STATUS IS FILE-STATUS.
           SELECT POFILE-I
                  ASSIGN TO DISK-MCFPPOFILE
                  ORGANIZATION IS RELATIVE
                  ACCESS MODE IS SEQUENTIAL
                  RELATIVE KEY IS POFILE-IX
                  FILE STATUS IS FILE-STATUS.

      ******************************************************************
       DATA DIVISION.
      ******************************************************************

       FILE SECTION.

       FD  DISPLAY-FILE
           LABEL RECORDS ARE OMITTED.
       01  DISPLAY-REC         PIC X(2000).

       FD  MVALIDUM-I
           LABEL RECORDS ARE STANDARD.
       01  MVALIDUM-REC-I.
           COPY DDS-ALL-FORMATS  OF MCFLCS0401.

       FD  MPLTINFO-I
           LABEL RECORDS ARE STANDARD.
       01  MPLTINFO-REC-I.
           COPY DDS-ALL-FORMATS  OF MCFLCS0501.

       FD  POFILE-I
           LABEL RECORDS ARE OMITTED
           RECORD CONTAINS 202 CHARACTERS
           DATA RECORD IS POFILE-REC-I.
       01  POFILE-REC-I          PIC X(202).

      ******************************************************************
       WORKING-STORAGE SECTION.
      ******************************************************************

      *-----------------------------------------------------------------
      *  A R G U M E N T   V A L U E S
      *-----------------------------------------------------------------

       01  PLT-ARG                  PIC X(4)  VALUE SPACES.
       01  RECNUM-ARG               PIC S9(4) COMP-4.
       01  DATE-ARG                 PIC X(8).

      *-----------------------------------------------------------------
      *  F L A G S   A N D   S W I T C H E S
      *-----------------------------------------------------------------

       01  POFILE-EOF               PIC X.

       01  RTN-CODE                 PIC 9.

       01  UM-CODE                  PIC X.

       01  SAVE-RECNUM              PIC S9(4) COMP-4.

      *-----------------------------------------------------------------
      *  I N D E X E S
      *-----------------------------------------------------------------

       01  SUBFILE-IX                    PIC  9(5).
       01  POFILE-IX                     PIC  9(4) COMP-4.
       01  POFILE-OPT                    PIC  X.

      *-----------------------------------------------------------------
      *  A C C U M U L A T O R S
      *-----------------------------------------------------------------

       01  LOAD-LIMIT                    PIC 999.
           88  LOAD-LIMIT-REACHED        VALUE 51.
       01  SUBFILE-REC-CNT               PIC 9(4).

      *-----------------------------------------------------------------
      *  B U F F E R S
      *-----------------------------------------------------------------

      *SFL SCREEN.
       01  BUF-SCREEN1.
           05  S1-OPTION          PIC X(1).
           05  S1-RETRANS-FLAG    PIC X(1).
           05  FILLER             PIC X(1)  VALUE SPACE.
           05  S1-DATE            PIC X(8).
           05  FILLER             PIC X(1)  VALUE SPACE.
           05  S1-REQ-NO          PIC X(10).
           05  FILLER             PIC X(1)  VALUE SPACE.
           05  S1-PO-NUM          PIC X(7).
           05  FILLER             PIC X(1)  VALUE SPACE.
           05  S1-PO-RLSE         PIC X(3).
           05  FILLER             PIC X(1)  VALUE SPACES.
           05  S1-PO-ITEM         PIC X(4).
           05  FILLER             PIC X(1)  VALUE SPACES.
           05  S1-ERROR-MSG       PIC X(37).
           05  S1-RECNUM          PIC S9(4) COMP-4.

      *SFLCTL SCREEN.
       01  BUF-SCREEN2.
           05  S2-RELRCD          PIC S9(5).
           05  S2-DSPREC          PIC S9(4).

      *FKEY & ERR MSG SCREEN FOR SFL.
       01  BUF-SCREEN3.
           05  S3-MSG-LINE        PIC X(79).

       01  SAVE-BUF-POFILE        PIC X(202).

       COPY POFILE OF COPYLIB.

       COPY MPLT0 OF COPYLIB.

       COPY MPLTP01 OF COPYLIB.

      *-----------------------------------------------------------------
      *  D A T A B A S E   S T A T U S   A R E A
      *-----------------------------------------------------------------

       01  FILE-STATUS.
           05  FILE-STATUS-1             PIC X.
           05  FILE-STATUS-2             PIC X.

       COPY DBCSACCT OF COPYLIB.

       COPY DATAB    OF COPYLIB.

       01  IOFEEDBACK.
           05  IO-OFFSET                       PIC S9(4) COMP-4.
           05  IO-OUT-COUNT                    PIC S9(8) COMP-4.
           05  IO-GET-COUNT                    PIC S9(8) COMP-4.
           05  IO-PUT-GET-COUNT                PIC S9(8) COMP-4.
           05  IO-OTHER-COUNT                  PIC S9(8) COMP-4.
           05  FILLER                          PIC X.
           05  IO-OPERATION                    PIC X.
           05  IO-FORMAT                       PIC X(10).
           05  IO-DEV-CLASS                    PIC X(2).
           05  IO-PGM-DEVICE                   PIC X(10).
           05  IO-REC-LEN                      PIC S9(8) COMP-4.
           05  IO-RTG-DTA                      PIC X(80).
           05  IO-BLK-REC                      PIC S9(4) COMP-4.
           05  IO-RESV                         PIC X(4).
           05  IO-BLK-CNT                      PIC S9(8) COMP-4.
           05  FILLER                          PIC X(8).

           05  FEEDBACK-SIZE                   PIC S9(8) COMP-4.
           05  JOIN-LOGICAL                    PIC X(4).
           05  KEY-OFFSET                      PIC S9(4) COMP-4.
           05  LOCKED-RECORDS                  PIC S9(4) COMP-4.
           05  MAX-FIELDS                      PIC S9(4) COMP-4.
           05  FIELD-MAPPING-OFFSET            PIC S9(8) COMP-4.
           05  CURRENT-FILE-POSITION           PIC X(1).
           05  CURRENT-RECORD-DELETE           PIC X(1).
           05  NO-OF-KEYS                      PIC S9(4) COMP-4.
           05  RESERVED-FIELD                  PIC X(4).
           05  KEY-LENGTH                      PIC S9(4) COMP-4.
           05  DATA-MEMBER-NO                  PIC S9(4) COMP-4.
           05  IO-RECNUM                       PIC S9(8) COMP-4.

      *-----------------------------------------------------------------
      *  U T I L I T Y   A R E A
      *-----------------------------------------------------------------

       COPY CATREAD OF COPYLIB.

       COPY TBLOWUP OF COPYLIB.

       COPY TDATECHK OF COPYLIB.

       COPY VCOMAREA OF COPYLIB.

       COPY LANGSUB  OF COPYLIB.

       COPY PLANTS   OF COPYLIB.

      *COPY DISPDATA OF COPYLIB.
       01  WS-CONTROL.
           05  FUNCTION-KEY       PIC XX.
               88  ENTER-KEY-USED                       VALUE "00".
               88  F1-KEY-USED                          VALUE "01".
               88  F2-KEY-USED                          VALUE "02".
               88  F3-KEY-USED                          VALUE "03".
               88  F4-KEY-USED                          VALUE "04".
               88  F5-KEY-USED                          VALUE "05".
               88  F6-KEY-USED                          VALUE "06".
               88  F7-KEY-USED                          VALUE "07".
               88  F8-KEY-USED                          VALUE "08".
               88  F9-KEY-USED                          VALUE "09".
               88  F10-KEY-USED                         VALUE "10".
               88  F11-KEY-USED                         VALUE "11".
               88  F12-KEY-USED                         VALUE "12".
               88  ROLLUP-KEY-USED                      VALUE "RU".
           05  TERMINAL-ID        PIC X(10).
           05  FORMAT-NAME        PIC X(10).

       01  DISPLAY-STATUS         PIC X(2).

       01  SRF-INDICATORS.
           05  IND                PIC 1
                                  OCCURS 99 TIMES
                                  INDICATOR 1.
               88  IND-OFF        VALUE B"0".
               88  IND-ON         VALUE B"1".

       01  OFF-SWITCH             PIC 1  VALUE B"0".
       01  ON-SWITCH              PIC 1  VALUE B"1".

      ******************************************************************
       PROCEDURE DIVISION.
      ******************************************************************

      *-----------------------------------------------------------------
       MAIN SECTION.
      *-----------------------------------------------------------------

       0-CONTROL.
           PERFORM 1-HSK.

           PERFORM 6-LOOP THRU 6-LOOP-X.

           PERFORM 2-EOJ.

           GOBACK.

       1-HSK.
           OPEN INPUT      MPLTINFO-I
                I-O        POFILE-I
                           DISPLAY-FILE.

           MOVE "P 01"         TO  PLT-ARG.
           MOVE PLT-ARG        TO PLTINFOKEY OF MPLTINFO-REC-I.
           READ MPLTINFO-I INTO BUF-MPLTINFO
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE "READ FAILED IN TUPDPOFL" TO  BU-DISPLAY-MSG
               MOVE PLT-ARG                   TO  BU-DISPLAY-FLD (1)
               GO TO 9999-BLOWUP.
           MOVE MPLTINFO-COMPANY              TO  WHICH-PLANT.

           MOVE  1  TO S2-DSPREC.

       2-EOJ.
           CLOSE           POFILE-I
                           MPLTINFO-I
                           DISPLAY-FILE.

      *-----------------------------------------------------------------
       6-LOOP SECTION.
      *-----------------------------------------------------------------

       60-LOAD-SCREEN.

           INITIALIZE POFILE-EOF, SUBFILE-IX, SUBFILE-REC-CNT.

      *----SHOW SFLCTL (71) AND CLEAR SFL (72), BUT DON'T SHOW IT (70).

           MOVE ON-SWITCH  TO IND (71)  IND (72).
           MOVE OFF-SWITCH TO IND (70).

           WRITE SUBFILE DISPLAY-REC FROM BUF-SCREEN2
              FORMAT IS "POINQSFLC"
              INDICATORS ARE SRF-INDICATORS.
           IF DISPLAY-STATUS NOT = "00"
              MOVE "PROBLEM ON INIT SFL WRITE" TO BU-DISPLAY-MSG
              GO TO 9999-BLOWUP.

      *----TURN CLEAR SFL OFF.

           MOVE OFF-SWITCH TO IND (72).

       60A-GET-LIST.

           INITIALIZE BUF-SCREEN1, LOAD-LIMIT.
           MOVE SUBFILE-REC-CNT TO SUBFILE-IX.

           PERFORM 601-LIST-BY-PO.
           MOVE BUF-POFILE   TO SAVE-BUF-POFILE.
           MOVE IO-RECNUM    TO SAVE-RECNUM.

       61-SHOW-SCREEN.

      *----PUT UP FUNCTION KEY SCREEN.

           WRITE DISPLAY-REC FROM BUF-SCREEN3
                 FORMAT IS "POINQREC"
                 INDICATORS ARE SRF-INDICATORS.
           MOVE ALL B"0" TO SRF-INDICATORS.

      *----OVERLAY WITH SFLCTL AND SFL SCREENS.

           IF SUBFILE-IX = ZERO
              MOVE OFF-SWITCH TO IND (70)
           ELSE
              MOVE ON-SWITCH TO IND (70).
           MOVE ON-SWITCH TO IND (71).

           IF POFILE-EOF = "Y"
              MOVE ON-SWITCH  TO IND (73)
           ELSE
              MOVE OFF-SWITCH TO IND (73).

           WRITE SUBFILE DISPLAY-REC FROM BUF-SCREEN2
              FORMAT IS "POINQSFLC"
              INDICATORS ARE SRF-INDICATORS.
           MOVE ALL B"0" TO SRF-INDICATORS.
           IF DISPLAY-STATUS NOT = "00"
              MOVE "PROBLEM ON SHOW SFL WRITE" TO BU-DISPLAY-MSG
              MOVE SUBFILE-IX TO BU-DISPLAY-FLD (1)
              MOVE DISPLAY-STATUS TO BU-DISPLAY-FLD (2)
              GO TO 9999-BLOWUP.

      *----READ USER INPUT.
           READ DISPLAY-FILE INTO BUF-SCREEN2
              FORMAT IS "POINQSFLC"
              INDICATORS ARE SRF-INDICATORS.
           IF IND-ON (75)
              SET ROLLUP-KEY-USED TO TRUE.
           MOVE ALL B"0" TO SRF-INDICATORS.
           IF DISPLAY-STATUS NOT = "00"
              MOVE "PROBLEM ON READ SFL" TO BU-DISPLAY-MSG
              GO TO 9999-BLOWUP.

       62-ACTION.

           IF ROLLUP-KEY-USED
              COMPUTE S2-DSPREC = SUBFILE-REC-CNT + 1
              MOVE SAVE-BUF-POFILE   TO BUF-POFILE
              MOVE SAVE-RECNUM       TO IO-RECNUM
              GO TO 60A-GET-LIST.

           IF ENTER-KEY-USED
              PERFORM 621-CALL-SUPDPOFL
              GO TO 61-SHOW-SCREEN.

           IF F3-KEY-USED
              GO TO 6-LOOP-X.

       601-LIST-BY-PO.

           IF NOT ROLLUP-KEY-USED
              READ POFILE-I INTO BUF-POFILE
                  AT END MOVE "Y" TO  POFILE-EOF
              END-READ
              IF POFILE-EOF NOT = "Y"
                  ACCEPT IOFEEDBACK FROM I-O-FEEDBACK-AREA
              ELSE
      *       ***  NO DATA TO DISPLAY  **
                   MOVE 14134 TO CATREAD-MSG-NUMBER
                   PERFORM 9999-CATREAD
                   MOVE CATREAD-MSG-TEXT TO S3-MSG-LINE
                   MOVE ON-SWITCH  TO IND (99)
              END-IF

           PERFORM UNTIL POFILE-EOF = "Y" OR LOAD-LIMIT-REACHED
             IF PO-TRANS = "3" OR PO-TRANS = "4"
              MOVE SPACES               TO  BUF-SCREEN1
              IF POFL-FLAG = "X"
                  MOVE "*"              TO  S1-RETRANS-FLAG
              ELSE
                  MOVE " "              TO  S1-RETRANS-FLAG
              END-IF
              MOVE POFL-YMD             TO  DATE-VALIDATE-IN
              MOVE 4                    TO  DATE-MODE
              CALL "TDATECK2" USING DATE-CHECK-AREA, LANGUAGE-PARMS
              MOVE DATE-SLASH-OUT       TO  S1-DATE
              MOVE PO-NUM-1-7           TO  S1-PO-NUM
              MOVE PO-RLSE-8-10         TO  S1-PO-RLSE
              IF PO-TRANS = "3"
                  IF KELLY-PLANT
                      MOVE K-ITM-NUM        TO  S1-PO-ITEM
                      MOVE K-ITM-REQ-NO     TO  S1-REQ-NO
                  ELSE
                      MOVE IN-ITM-NUM       TO  S1-PO-ITEM
                      MOVE IN-ITM-REQ-NO    TO  S1-REQ-NO
                  END-IF
              END-IF
              IF PO-TRANS = "4"
                  IF KELLY-PLANT
                      MOVE K-NSTR-ITM-NUM   TO  S1-PO-ITEM
                      MOVE K-NSTR-REQ-NO    TO  S1-REQ-NO
                  ELSE
                      MOVE IN-NSTR-ITM-NUM  TO  S1-PO-ITEM
                      MOVE IN-NSTR-REQ-NO   TO  S1-REQ-NO
                  END-IF
              END-IF
              MOVE POFL-TLOADPO-ERROR   TO  S1-ERROR-MSG
              MOVE IO-RECNUM            TO  S1-RECNUM
              ADD 1 TO SUBFILE-IX, SUBFILE-REC-CNT, LOAD-LIMIT
              IF SUBFILE-IX > 9999
                 MOVE "SUBFILE TOO SMALL-INCREASE ZUPDPOFL"
                    TO BU-DISPLAY-MSG
                 MOVE SUBFILE-IX TO BU-DISPLAY-FLD (1)
                 GO TO 9999-BLOWUP
              END-IF
              WRITE SUBFILE DISPLAY-REC FROM BUF-SCREEN1
                 FORMAT IS "POINQSFL"
                 INDICATORS ARE SRF-INDICATORS
              END-WRITE
              IF DISPLAY-STATUS NOT = "00"
                 MOVE "PROBLEM ON LOAD SFL WRITE -- #1"
                                                  TO BU-DISPLAY-MSG
                 MOVE SUBFILE-IX TO BU-DISPLAY-FLD (1)
                 MOVE S1-PO-NUM  TO BU-DISPLAY-FLD (2)
                 MOVE S1-RECNUM  TO BU-DISPLAY-FLD (3)
                 MOVE DISPLAY-STATUS TO BU-DISPLAY-FLD (4)
                 GO TO 9999-BLOWUP
              END-IF
              READ POFILE-I NEXT INTO BUF-POFILE
                  AT END MOVE "Y" TO  POFILE-EOF
              END-READ
              IF POFILE-EOF NOT = "Y"
                  ACCEPT IOFEEDBACK FROM I-O-FEEDBACK-AREA
              END-IF
             ELSE
              READ POFILE-I NEXT INTO BUF-POFILE
                  AT END MOVE "Y" TO  POFILE-EOF
              END-READ
              IF POFILE-EOF NOT = "Y"
                  ACCEPT IOFEEDBACK FROM I-O-FEEDBACK-AREA
              END-IF
             END-IF
           END-PERFORM.

       621-CALL-SUPDPOFL.

      *----FIND FIRST SUBFILE REC TO INQUIRE.
      *------- OPTIONS AVAILABLE:
      *-------    C = CANCEL RE-TRANSMISSION INDICATOR
      *-------    R = MARK FOR RE-TRANSMISSION TO CSIS
      *-------    X = UPDATE UM ON ERROR RECORD

           PERFORM UNTIL S1-OPTION = "C" OR S1-OPTION = "R" OR
                         S1-OPTION = "X" OR DISPLAY-STATUS NOT = ZERO
              READ SUBFILE DISPLAY-FILE NEXT MODIFIED RECORD
                   INTO BUF-SCREEN1
                   FORMAT IS "POINQSFL"
           END-PERFORM

           IF S1-OPTION = "C" OR "R" OR "X"
              MOVE SUBFILE-IX TO S2-DSPREC
           ELSE
              MOVE S2-RELRCD TO S2-DSPREC.
           IF S2-DSPREC < 1
              MOVE 1 TO S2-DSPREC.

           PERFORM UNTIL DISPLAY-STATUS NOT = ZERO

              MOVE S1-OPTION TO POFILE-OPT
              MOVE 0         TO RTN-CODE
              MOVE " "       TO UM-CODE

              CALL "SUPDPOFL" USING POFILE-OPT, S1-RECNUM, RTN-CODE,
                              UM-CODE, BU-DISPLAY-MSG, BU-DISPLAY-FLDS

              IF RTN-CODE NOT = 0
                 GO TO 9999-BLOWUP
              END-IF

      *-------UPDATE THE SUBFILE RECORD

      *---------- UM-CODE OF "X" MEANS THAT THE UM MODIFY FUNCTION
      *---------- WAS INVOKED.  IT WAS REQUESTED THAT THE RECORD BE
      *---------- AUTOMATICALLY RE-TRANSMITTED IF THIS IS THE CASE.

              IF S1-OPTION = "R" OR UM-CODE = "X"
                  MOVE "*"       TO  S1-RETRANS-FLAG
              END-IF
              IF S1-OPTION = "C"
                  MOVE " "       TO  S1-RETRANS-FLAG
              END-IF
              INITIALIZE S1-OPTION

              REWRITE SUBFILE DISPLAY-REC FROM BUF-SCREEN1
                 FORMAT IS "POINQSFL"
                 INDICATORS ARE SRF-INDICATORS
                 INVALID KEY MOVE FILE-STATUS TO FILE-STATUS
              END-REWRITE

      *-------GET NEXT SUBFILE RECORD TO INQUIRE

              PERFORM UNTIL S1-OPTION = "C" OR S1-OPTION = "R" OR
                            S1-OPTION = "X" OR DISPLAY-STATUS NOT = ZERO
                 READ SUBFILE DISPLAY-FILE NEXT MODIFIED RECORD
                      INTO BUF-SCREEN1
                      FORMAT IS "POINQSFL"
                 END-READ
              END-PERFORM

           END-PERFORM.

       6-LOOP-X.
           EXIT.

      *-----------------------------------------------------------------
       9999-UTILITY SECTION.
      *-----------------------------------------------------------------

       9999-BLOWUP.
           MOVE "TUPDPOFL" TO BU-PGM-NAME.
           CALL "TBLOWUP" USING BASE, BU-PGM-NAME, STATUS-AREA,
              VIEW-COMAREA, FILE-STATUS, BU-DISPLAY-MSG,
              BU-DISPLAY-FLDS.

       9999-WRITE-SCREEN.
           WRITE DISPLAY-REC FORMAT IS VIEW-NFNAME
              INDIC ARE SRF-INDICATORS.
      *??? MOVE ALL B"0" TO SRF-INDICATORS.

       9999-READ-SCREEN.
           READ  DISPLAY-FILE FORMAT IS VIEW-NFNAME
              INDIC ARE SRF-INDICATORS.
      *??? MOVE ALL B"0" TO SRF-INDICATORS.

      *--- A BAD STATUS MAY MEAN USER TURNED OFF TERMINAL.
      *--- IF SO, SIMULATE THE F3 KEY TO EXIT PROGRAM.

           IF DISPLAY-STATUS NOT = "00"
               MOVE "03" TO FUNCTION-KEY.

       9999-CATREAD.
           CALL "CCATREAD" USING CATREAD-PARMS.

