016000**************************************************************
016100**                                                          **
016200**            E S C A P E   S E Q U E N C E S               **
016300**                                                          **
016400**************************************************************
016500
016600 COPY ESCNAM2 OF COPYLIB.
016700
016800 01  COMPRESS-PRINT             PIC X(8).
016900
017000 01  NORMAL-PRINT               PIC X(8).
017100
017200 01  ESC-TEXT-61                PIC X(8).
017300
017400 01  ESC-TEXT-60                PIC X(8).
017500
       LINKAGE SECTION.
       COPY THDPRTB OF COPYLIB.
006700 01  USER-OPTIONS.
006800     05  USER-SORT-KEY            PIC X.
006900     05  FILLER                   PIC X(79).
007000
017700********************************************************************
017800*
017900*            P R O C E D U R E   D I V I S I O N
018000********************************************************************
018100
018200 PROCEDURE DIVISION USING HD-ROUTE-DATA USER-OPTIONS.
018300 0-BEGIN.
018400     PERFORM 1-HSK  THRU  1-HSK-X.
018500
018600     PERFORM 6-SORT-PROCEDURE  THRU  6-SORT-PROCEDURE-X.
018700
018800     PERFORM 2-CLOSE-FILES  THRU  2-CLOSE-FILES-X.
018900
019000     GOBACK.
019100
019200 1-HSK.
           MOVE "C" TO MCXCBLERR-SCOPE.
           CALL "MCXCBLERR" USING MCXCBLERR-SCOPE.

019300     CALL "TESCSEQ" USING ESC-NAME.
019400     MOVE CHAR-1636PI     TO COMPRESS-PRINT.
019500     MOVE CHAR-10PI       TO NORMAL-PRINT.
019600     MOVE TEXT-LENGTH-61 TO ESC-TEXT-61.
019700     MOVE TEXT-LENGTH-60 TO ESC-TEXT-60.
019800
           OPEN INPUT DFREIGHT.
021100
021200 1-HSK-X.
021300     EXIT.
021400
021500 6-SORT-PROCEDURE.
021600     IF USER-SORT-KEY = "A"
021700         SORT SORT-FILE ON ASCENDING KEY SRT-CARRIER
021800                                           SRT-BILL-NO
021900             INPUT PROCEDURE IS THE-INPUT THRU INPUT-EXIT
022000             OUTPUT PROCEDURE IS THE-OUTPUT THRU OUTPUT-EXIT
022100     ELSE
022200         IF USER-SORT-KEY = "B"
022300             SORT SORT-FILE ON ASCENDING KEY SRT-BILL-NO
022400                  INPUT PROCEDURE IS THE-INPUT THRU INPUT-EXIT
022500                  OUTPUT PROCEDURE IS THE-OUTPUT THRU OUTPUT-EXIT
022600     ELSE
022700         SORT SORT-FILE ON ASCENDING KEY SRT-PO-RCV-NO
022800             INPUT PROCEDURE IS THE-INPUT THRU INPUT-EXIT
022900             OUTPUT PROCEDURE IS THE-OUTPUT THRU OUTPUT-EXIT.
023000
023100 6-SORT-PROCEDURE-X.
023200     EXIT.
023300
023400 2-CLOSE-FILES.
           CLOSE DFREIGHT.
024300 2-CLOSE-FILES-X.
024400     EXIT.
024500
024700******************************************************
024800**                                                  **
024900**   BLOWUP ROUTINE                                 **
025000**                                                  **
025100******************************************************
025200
025300 2-BLOWUP.
025400     MOVE "TFRGTRPT"              TO  BU-PGM-NAME.
025500     CALL "TBLOWUP" USING BASE, BU-PGM-NAME, STATUS-AREA,
025600         DUMMY-VIEW-AREA, FILE-STATUS, BU-DISPLAY-MSG,
025700             BU-DISPLAY-FLDS.
025800
026000 THE-INPUT.
033800     MOVE 1                       TO  DATE-MODE.
034000     CALL "TDATECHK" USING DATE-CHECK-AREA.
034100     MOVE DATE-SLASH-OUT          TO  SAVE-DATE.
026100
           MOVE 0 TO COND-WORD.
           MOVE LOW-VALUES TO PORCVNO OF DFREIGHT-REC.
           START DFREIGHT KEY  >=  PORCVNO OF DFREIGHT-REC
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
                   MOVE 17 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.
026200 6-MAIN.
           MOVE 0 TO COND-WORD.
           READ DFREIGHT NEXT INTO BUF-DPOFREIGHT
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   MOVE 15 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.
           IF NOT GOOD-CALL
              GO TO INPUT-EXIT.
027100
027200     IF FRT-PAID-FLAG = SPACE
027300         IF FRT-TYPE = "C" OR FRT-TYPE = "G"
027400             PERFORM 4-WRITE-TO-SORT.
027500     GO TO 6-MAIN.
027600
027700 4-WRITE-TO-SORT.
027800     MOVE FRT-PO-NUM              TO  SRT-PO.
027900     MOVE FRT-PO-RLSE             TO  SRT-RLSE-NO.
028000     MOVE FRT-PO-RS               TO  SRT-RCV-NO.
028100     MOVE FRT-CARRIER             TO  SRT-CARRIER.
028200     MOVE FRT-BILL-NO             TO  SRT-BILL-NO.
028300     MOVE FRT-PACK-SLIP           TO  SRT-PACK-SLIP.
           IF FRT-CHARGES-9 < 0
              MOVE ZEROES               TO  SRT-CHARGES
           ELSE
028400     MOVE FRT-CHARGES-9           TO  SRT-CHARGES.
028500     MOVE FRT-BILL-DATE           TO  SRT-BILL-DATE.
028600     MOVE FRT-DATE-RCVD           TO  SRT-DATE-RCVD.
028700     MOVE FRT-SPLC                TO  SRT-SPLC.
028800     MOVE FRT-RAIL-CAR            TO  SRT-RAIL-CAR.
028900     RELEASE SORT-RECORD.
029000
029100 6-M-X.
029200     EXIT.
       INPUT-EXIT.
           EXIT.
029300
029400 THE-OUTPUT.
030600
031000     MOVE "DHDR84.PUB"            TO  HD-FILE-NAME.
065000*---------- OPEN THE PRINT FILE, GET THE FILE NUMBER OF THE PRINT
065100*---------- FILE, AND PRINT THE HEADER PAGE.
           MOVE HD-SPOOLER-NUMBER TO OVRPRTF-TOFILE-NUM.
           MOVE "*YES"       TO OVRPRTF-SHARED.
028100     MOVE HD-NO-OF-COPIES TO OVRPRTF-COPIES.
           MOVE "MCPRT"      TO OVRPRTF-FILE.
           PERFORM 996-OVERRIDE-PRINT-FILE.
065300     OPEN OUTPUT PRINT-FILE.
031100     CALL "THDPRT2" USING HD-RET-CODE, HD-FILE-NAME, FNUM,
031200           HD-ROUTE-DATA, ESC-NAME.
031300     IF HD-RET-CODE NOT = 0
031400         MOVE "THDPRT2 ERR 1-HSK" TO BU-DISPLAY-MSG
031500         MOVE HD-RET-CODE       TO BU-DISPLAY-FLD (1)
031600         GO TO 2-BLOWUP.
031700
031800     IF PAPER-IS-132-COLS
031900          NEXT SENTENCE
032000     ELSE
032100         WRITE PRINT-RECORD FROM COMPRESS-PRINT AFTER ADVANCING 0
032200         WRITE PRINT-RECORD  FROM ESC-TEXT-61 AFTER ADVANCING 0.
032300
032400 70-READ-SORT-RECORD.
032500     RETURN SORT-FILE   AT END
032600         GO TO 70-FINISH-REPORT.
032700
032800     PERFORM 701-CHECK-PAGE.
032900     MOVE SPACES                  TO  PRT-LINE.
033000     MOVE SRT-PO                  TO  PRT-PO.
033100     MOVE SRT-RLSE-NO             TO  PRT-RLSE-NO.
033200     MOVE "-"                     TO  PRT-DASH.
033300     MOVE SRT-RCV-NO              TO  PRT-RCV-NO.
033400     MOVE SRT-PACK-SLIP           TO  PRT-PACK-SLIP.
033500     MOVE SRT-CARRIER             TO  PRT-CARRIER.
033600     MOVE SRT-BILL-NO             TO  PRT-BILL-NO.
033700     MOVE SRT-CHARGES             TO  PRT-CHARGES.
033800     MOVE 4                       TO  DATE-MODE.
033900     MOVE SRT-BILL-DATE           TO  DATE-VALIDATE-IN.
034000     CALL "TDATECHK" USING DATE-CHECK-AREA.
034100     MOVE DATE-SLASH-OUT          TO  PRT-BILL-DATE.
034200     MOVE SRT-DATE-RCVD           TO  DATE-VALIDATE-IN.
034300     CALL "TDATECHK" USING DATE-CHECK-AREA.
034400     MOVE DATE-SLASH-OUT          TO  PRT-DATE-RCVD.
034500     MOVE SRT-SPLC                TO  PRT-SPLC.
034600     MOVE SRT-RAIL-CAR            TO  PRT-RAIL-CAR.
034700     WRITE PRINT-RECORD FROM PRT-LINE AFTER ADVANCING 1.
034800     ADD 1                        TO  LINE-CTR.
034900     GO TO 70-READ-SORT-RECORD.
035000
035100
035200 701-CHECK-PAGE.
035300*------CHECK FOR TOP OF PAGE
035400     IF LINE-CTR > 55
035500         MOVE ZERO                TO  LINE-CTR
035600         ADD 1                    TO  PAGE-CTR
035700         ADD 8                    TO  LINE-CTR
035800         MOVE PAGE-CTR            TO  PAGE-NO
035900         MOVE SAVE-DATE           TO  PRT-DATE
036000         WRITE PRINT-RECORD FROM HEADER-1 AFTER
036100              ADVANCING NEW-PAGE
036200         WRITE PRINT-RECORD FROM HEADER-4 AFTER
036300              ADVANCING 3
036400         WRITE PRINT-RECORD FROM HEADER-2 AFTER
036500              ADVANCING 1
036600         WRITE PRINT-RECORD FROM HEADER-3 AFTER
036700              ADVANCING 1
036800         MOVE SPACES              TO  PRINT-RECORD
036900         WRITE PRINT-RECORD AFTER ADVANCING 1.
037000
037100 70-FINISH-REPORT.
037200     MOVE SPACES                  TO  PRINT-RECORD.
037300     WRITE PRINT-RECORD AFTER ADVANCING NEW-PAGE.
037400
037500     IF PAPER-IS-132-COLS
037600         NEXT SENTENCE
037700     ELSE
037800         WRITE PRINT-RECORD FROM NORMAL-PRINT AFTER ADVANCING 0
037900         WRITE PRINT-RECORD FROM ESC-TEXT-60 AFTER ADVANCING 0.
038900     CLOSE PRINT-FILE.
039000
039200 OUTPUT-EXIT.
039300     EXIT.
       COPY OVRPFCALL OF COPYLIB.
