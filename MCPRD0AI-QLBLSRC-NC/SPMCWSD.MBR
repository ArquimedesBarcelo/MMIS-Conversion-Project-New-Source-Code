       IDENTIFICATION DIVISION.
       PROGRAM-ID.             SPMCWSD.
       AUTHOR.                 W. ROXBURY.
       INSTALLATION.           GOODYEAR TIRE & RUBBER CO.
      *REMARKS.           **** UPDATES THE PM-OPEN-QUEUE FOR A WORKORDER
      *                        STATUS TRANSACTION OF 'IP', 'CW' OR 'SD'.
      *                        ****.
      *C****************************************************************
      *C  ADDED CENTURY TO WORKORDER DATES FOR END-OF-CENTURY CONVERSION
      *C    REQUEST#:  6604    W. ROXBURY
      *C****************************************************************

       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.
       SOURCE-COMPUTER.        HP-3000.
       OBJECT-COMPUTER.        HP-3000.

       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT WO-PLANNED
                  ASSIGN       TO DATABASE-MCFLMM1101
                  ORGANIZATION IS INDEXED
                  ACCESS MODE  IS DYNAMIC
                  RECORD KEY   IS EXTERNALLY-DESCRIBED-KEY
                               WITH DUPLICATES
                  FILE STATUS  IS FILE-STAT.

           SELECT WO-PLANNED2
                  ASSIGN       TO DATABASE-MCFLMM1101
                  ORGANIZATION IS INDEXED
                  ACCESS MODE  IS DYNAMIC
                  RECORD KEY   IS EXTERNALLY-DESCRIBED-KEY
                               WITH DUPLICATES
                  FILE STATUS  IS FILE-STAT.

           SELECT PM-SCHEDULE
                  ASSIGN       TO DATABASE-MCFLMM4401
                  ORGANIZATION IS INDEXED
                  ACCESS MODE  IS DYNAMIC
                  RECORD KEY   IS EXTERNALLY-DESCRIBED-KEY
                               WITH DUPLICATES
                  FILE STATUS  IS FILE-STAT.

           SELECT PM-SCHEDULE2
                  ASSIGN       TO DATABASE-MCFLMM4403
                  ORGANIZATION IS INDEXED
                  ACCESS MODE  IS DYNAMIC
                  RECORD KEY   IS EXTERNALLY-DESCRIBED-KEY
                               WITH DUPLICATES
                  FILE STATUS  IS FILE-STAT.

           SELECT PM-MASTER-SCHED
                  ASSIGN       TO DATABASE-MCFLMM4301
                  ORGANIZATION IS INDEXED
                  ACCESS MODE  IS DYNAMIC
                  RECORD KEY   IS EXTERNALLY-DESCRIBED-KEY
                               WITH DUPLICATES
                  FILE STATUS  IS FILE-STAT.

           SELECT PM-OPEN-QUEUE
                  ASSIGN       TO DATABASE-MCFLMM3901
                  ORGANIZATION IS INDEXED
                  ACCESS MODE  IS DYNAMIC
                  RECORD KEY   IS EXTERNALLY-DESCRIBED-KEY
                               WITH DUPLICATES
                  FILE STATUS  IS FILE-STAT.

           SELECT PM-OPEN-QUEUE2
                  ASSIGN       TO DATABASE-MCFLMM3902
                  ORGANIZATION IS INDEXED
                  ACCESS MODE  IS DYNAMIC
                  RECORD KEY   IS EXTERNALLY-DESCRIBED-KEY
                               WITH DUPLICATES
                  FILE STATUS  IS FILE-STAT.

       DATA DIVISION.
       FILE SECTION.
       FD  WO-PLANNED
           LABEL RECORDS       ARE STANDARD.
       01  WO-PLANNED-REC.
           COPY DDS-ALL-FORMATS OF MCFLMM1101.

       FD  WO-PLANNED2
           LABEL RECORDS       ARE STANDARD.
       01  WO-PLANNED-REC2.
           COPY DDS-ALL-FORMATS OF MCFLMM1101.

       FD  PM-SCHEDULE
           LABEL RECORDS       ARE STANDARD.
       01  SCH-REC.
           COPY DDS-ALL-FORMATS OF MCFLMM4401.

       FD  PM-SCHEDULE2
           LABEL RECORDS       ARE STANDARD.
       01  SCH-REC2.
           COPY DDS-ALL-FORMATS OF MCFLMM4403.

       FD  PM-MASTER-SCHED
           LABEL RECORDS       ARE STANDARD.
       01  PMS-REC.
           COPY DDS-ALL-FORMATS OF MCFLMM4301.

       FD  PM-OPEN-QUEUE
           LABEL RECORDS       ARE STANDARD.
       01  PMOQ-REC.
           COPY DDS-ALL-FORMATS OF MCFLMM3901.

       FD  PM-OPEN-QUEUE2
           LABEL RECORDS       ARE STANDARD.
       01  PMOQ-REC2.
           COPY DDS-ALL-FORMATS OF MCFLMM3902.

       WORKING-STORAGE SECTION.
       77  SUB                 PIC S9(4)   VALUE 0    COMP.
       77  CUR-LEVEL           PIC S9(4)   VALUE 0    COMP.
       77  REL-LEVEL           PIC S9(4)   VALUE 0    COMP.
       77  FIND-SW             PIC 9(04)   VALUE 0    COMP.
           88  RECORD-NOT-FOUND            VALUE 0.
           88  RECORD-FOUND                VALUE 1.
       77  LAST-PR-TIME        PIC 9(07)   VALUE 0.
       77  CENTURY-P           PIC S9(4).
       77  UPDATE-SW           PIC X       VALUE "A".
       77  CHECK-SW            PIC XX      VALUE "  ".
       77  SCHED-KEY           PIC X(10).
       77  PREL-KEY            PIC X(08).
       77  EQUIP-KEY           PIC X(06).
       77  PR-ID-SAVE          PIC X(10).
       77  PR-DT-HOLD          PIC X(08).
       77  PR-ID-HOLD          PIC X(10).
       77  LEAST-DATE          PIC X(08).
       77  MSG-SW              PIC X       VALUE "3".
       77  BASE                PIC X(16).
       77  SAVE-REC-TYPE       PIC X(04).
       77  SAVE-PMQ-DATE       PIC X(08).
       77  D-PARM              PIC X.
       77  L-PARM              PIC X.

       01  FILE-STAT.
           05  FILE-STAT-1     PIC X.
           05  FILE-STAT-2     PIC X.

       01  WONUM-KEY.
           05  WOKEY-7         PIC X(07).
           05  WOKEY-SUF       PIC X(03).

       01  WONUM-SAVE.
           05  WOSAV-7         PIC X(07).
           05  WOSAV-SUF       PIC X(03).

       01  WO-LINK-DATA.
           05  LINK-WO         PIC X(10).
           05  LINK-EQUIP      PIC X(06).
           05  LINK-DESC       PIC X(30).

       01  RMSG-TXT.
           05  RMSG-1          PIC X(28)
               VALUE "PROGRAM TPMNEWYR HAS GENERAT".
           05  RMSG-2          PIC X(28)
               VALUE "ED A NEW MASTER WO NUMBER:  ".

       01  REPMSG.
           05  RMSG            PIC X(56).
           05  RWONUM          PIC X(10).

       01  PR-DATE.
           05  PR-DATE-YRMO.
               10  PR-DATE-YYYY.
                   15  PR-DATE-CT  PIC 99.
                   15  PR-DATE-YY  PIC 99.
               10  PR-DATE-MM      PIC 99.
           05  PR-DATE-DD          PIC 99.

       01  PR-ID.
           05  PR-DAY          PIC 9(03) VALUE 999.
           05  PR-TIME         PIC 9(07) VALUE 0.

       01  CURDATE-BUFF.
           05 Y-BUFF           PIC 9(2).
           05 M-BUFF           PIC 9(2).
           05 D-BUFF           PIC 9(2).

       01  TODAYS-DATE.
           05  TD-CT           PIC 99.
           05  DH-YY           PIC 99.
           05  DH-MM           PIC 99.
           05  DH-DD           PIC 99.

       01  TIME-BUF.
           05  TIME-HHMM       PIC 9(04).
           05  TIME-REST       PIC 9(04).

       01  TIME-IN.
           05  TI-7            PIC 9(07).

       01  GREG-DATE.
           05  G-YEAR          PIC XXXX.
           05  G-MONTH         PIC XX.
           05  G-DAY           PIC XX.

       01  JUL-SIGN            PIC S9(06).
       01  JUL-DATE            PIC  X(07).
       01  JULIAN-DATE         REDEFINES JUL-DATE
                               PIC  9(07).
       01  FILLER              REDEFINES JUL-DATE.
           05  J-YEAR          PIC 9999.
           05  J-DAY           PIC 999.

       01  LEVEL-TABLE.
           05  LEV-TAB         OCCURS 12 TIMES.
               10  L-ENTRY     PIC X(58).

       01  ICS-DATE.
           05  ICS-CT          PIC 99.
           05  ICS-YMD.
               10  ICS-YY      PIC 99.
               10  ICS-MM      PIC 99.
               10  ICS-DD      PIC 99.

       01  ICS-REFRAME.
           05  ICS-YRMO.
               10  IYM-CT      PIC 99.
               10  IYM-YY      PIC 99.
               10  IYM-MM      PIC 99.
           05  IYM-DD          PIC 99.

       01  INIT-DATE.
           05  INIT-YRMO.
               10 INIT-CT      PIC 99.
               10 INIT-YY      PIC 99.
               10 INIT-MM      PIC 99.
           05 INIT-DD          PIC 99.

       01  LOOK-AHEAD.
           05  LOOK-AHEAD-YYYY.
             10  LOOK-AHEAD-CT PIC 99.
             10  LOOK-AHEAD-YY PIC 99.
           05  LOOK-AHEAD-MM   PIC 99.
           05  LOOK-AHEAD-DD   PIC 99.

       01  HOLD-PRTY.
           05  PRT-1           PIC 9.
           05  PRT-2           PIC X.

           COPY TBLOWUP        IN COPYLIB.

           COPY DBSTAT         IN COPYLIB.

           COPY VCOMLINK       IN COPYLIB.

       01  WO-PLANNED-DATA.    COPY DWOPLAN  IN COPYLIB.

       01  WO-PLANNED-DATA2.   COPY DWOPLAN  IN COPYLIB.

       01  MESSAGE-DATA.       COPY DWOMSG   IN COPYLIB.

       01  WO-TRACK-DATA.      COPY DWOTRACK IN COPYLIB.

       01  PM-MASTER-DATA.     COPY DPMMSTSC IN COPYLIB.

       01  PM-SCHED-DATA.      COPY DPMSCHED IN COPYLIB.

       01  PM-QUEUE-DATA.      COPY DPMOPENQ IN COPYLIB.

       01  PM-AUDIT-DATA.      COPY DPMAUDIT IN COPYLIB.

           COPY DAYTABLE       IN COPYLIB.

       LINKAGE SECTION.
       01  WO-PLANNED-NUM      PIC X(10).
       01  TRANS-SW            PIC X(02).
       01  IPCWSD-DATE         PIC X(06).

       01  DBPARAMETERS.       COPY DBPARMS IN COPYLIB.

       01  RET-CODE            PIC S9(4) COMP.
       01  RETURN-ERROR.
           05  ERROR-TEXT      PIC X(68).
           05  ERROR-NUM       PIC X(08).
           05  ERROR-CODE      REDEFINES ERROR-NUM PIC Z(7)9.

       PROCEDURE DIVISION      USING WO-PLANNED-NUM
                               TRANS-SW
                               IPCWSD-DATE
                               DBPARAMETERS
                               RET-CODE
                               RETURN-ERROR.

       BEGIN.
           OPEN I-O            WO-PLANNED
                               PM-SCHEDULE
                               PM-SCHEDULE2
                               PM-OPEN-QUEUE
                               PM-OPEN-QUEUE2.
           OPEN INPUT          PM-MASTER-SCHED
                               WO-PLANNED2.

           MOVE 0              TO RET-CODE.
           ACCEPT CURDATE-BUFF FROM DATE.
           MOVE SPACES         TO WO-TRACK-DATA.
           MOVE ZEROS          TO DATE-STAMP TIME-STAMP.
           MOVE Y-BUFF         TO DATE-STAMP-YY DH-YY.
           MOVE M-BUFF         TO DATE-STAMP-MM DH-MM.
           MOVE D-BUFF         TO DATE-STAMP-DD DH-DD.
           MOVE 20             TO TD-CT.
           IF DH-YY > 90
               MOVE 19         TO TD-CT.

           IF IPCWSD-DATE = "      "
               MOVE CURDATE-BUFF TO IPCWSD-DATE.

           MOVE IPCWSD-DATE    TO ICS-YMD.
           MOVE 20             TO ICS-CT.
           IF ICS-YY NOT NUMERIC
               MOVE DH-YY      TO ICS-YY.
           IF ICS-YY > 90
               MOVE 19         TO ICS-CT.

           IF TRANS-SW = "IP"
               PERFORM PROCESS-IP-TRANSACTIONS
               GO TO END-OF-JOB
           ELSE
           IF TRANS-SW = "CW"
               PERFORM PROCESS-CW-TRANSACTIONS
               PERFORM WRITE-MSG-PROG
               GO TO END-OF-JOB
           ELSE
           IF TRANS-SW = "SD"
               PERFORM PROCESS-SD-TRANSACTIONS
               GO TO END-OF-JOB
           ELSE
               MOVE 1          TO   RET-CODE
               MOVE
               "INVALID TRANSACTION - MUST BE 'IP', 'CW' OR 'SD'"
                               TO   RETURN-ERROR
               GOBACK.

       PROCESS-IP-TRANSACTIONS.
           PERFORM GET-Q-RECORD              THRU GQR-EXIT.
           PERFORM WRITE-IP-AUDIT            THRU WIP-EXIT.
           IF PMQ-REC-PR = "PR"
               MOVE "  "       TO PMQ-REC-PR
               MOVE PMQ-PR-ID  TO PR-ID-SAVE
               MOVE SPACES     TO PMQ-PR-ID
           ELSE
               GO TO END-OF-JOB.

           PERFORM UPDATE-Q-RECORD           THRU UQR-EXIT.
           PERFORM GET-PM-SCHED-REC          THRU GPMSR-EXIT.
           IF RECORD-FOUND
               PERFORM DELETE-PM-SCHED-REC   THRU DPSR-EXIT.
           MOVE "IP"           TO CHECK-SW.
           MOVE PMQ-WO-NUM     TO WONUM-SAVE.
           MOVE PMQ-REC-TYPE   TO SAVE-REC-TYPE.
           PERFORM CHECK-FOR-ACTIVES         THRU CFA-EXIT.

       PROCESS-CW-TRANSACTIONS.
           PERFORM GET-Q-RECORD              THRU GQR-EXIT.
           PERFORM DELETE-Q-RECORD           THRU DQR-EXIT.
           PERFORM WRITE-CW-AUDIT            THRU WCW-EXIT.
           IF PMQ-REC-PR = "PR"
               MOVE PMQ-PR-ID  TO PR-ID-SAVE
               PERFORM GET-PM-SCHED-REC      THRU GPMSR-EXIT
               IF RECORD-FOUND
                   PERFORM DELETE-PM-SCHED-REC THRU DPSR-EXIT.

           IF PMQ-REC-TYP = "DN"
               MOVE WO-PLANNED-NUM TO WONUM-KEY
               PERFORM GET-WO-SUFFIX         THRU GWS-EXIT
               MOVE SPECL-EQUIP OF WO-PLANNED-DATA TO REPMSG
               IF RMSG = RMSG-TXT
                   MOVE RWONUM TO WONUM-KEY
               END-IF
               PERFORM GET-WO-MASTER         THRU GWM-EXIT
               PERFORM SCHED-NEXT-RELEASE    THRU SNR-EXIT.

       PROCESS-SD-TRANSACTIONS.
           PERFORM GET-Q-RECORD              THRU GQR-EXIT.
           IF PMQ-REC-PR = "PR"
               MOVE "  "       TO PMQ-REC-PR
               MOVE PMQ-PR-ID  TO PR-ID-SAVE
               MOVE PMQ-DATE   TO SAVE-PMQ-DATE
               MOVE ICS-DATE   TO PMQ-DATE
               PERFORM UPDATE-Q-RECORD       THRU UQR-EXIT.

           MOVE SAVE-PMQ-DATE  TO PMQ-DATE.
           PERFORM GET-PM-SCHED-REC          THRU GPMSR-EXIT.
           IF RECORD-FOUND
               PERFORM DELETE-PM-SCHED-REC   THRU DPSR-EXIT
           END-IF.

       WRITE-MSG-PROG.
           MOVE SPACES         TO RETURN-ERROR.
           MOVE "3"            TO MSG-SW.
           MOVE WO-PLANNED-NUM TO LINK-WO.
           MOVE PMQ-EQUIP-NUM  TO LINK-EQUIP.
           MOVE PMQ-DESCRIPTION TO LINK-DESC.

           CALL "SPMWRTMS"     USING MSG-SW
                               WO-LINK-DATA
                               RETURN-ERROR.
           IF RETURN-ERROR NOT = SPACES
               MOVE RETURN-ERROR TO BU-DISPLAY-MSG
               PERFORM 999-BLOWUP.

       GET-Q-RECORD.
           MOVE WO-PLANNED-NUM TO WONUM-KEY.
           MOVE WONUM-KEY      TO WONUM OF PM-OPEN-QUEUE.
           READ PM-OPEN-QUEUE  INTO PM-QUEUE-DATA
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT = "23"
               GO TO END-OF-JOB
           ELSE
           IF FILE-STAT NOT = "00"
               MOVE "READ ERROR, PM-OPEN-QUEUE" TO BU-DISPLAY-MSG
               MOVE WONUM-KEY  TO BU-DISPLAY-FLD(1)
               PERFORM 999-BLOWUP.

           MOVE PMQ-LEVEL      TO CUR-LEVEL.

       GQR-EXIT.               EXIT.

       GET-WO-MASTER.
           MOVE "000"          TO WOKEY-SUF.
           MOVE WONUM-KEY      TO WONUM OF WO-PLANNED.
           READ WO-PLANNED     INTO WO-PLANNED-DATA
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
               MOVE 1          TO RET-CODE
               GO TO GWM-EXIT.

           MOVE PM-SCHEDULE-KEY OF WO-PLANNED-DATA TO SCHED-KEY.

       GWM-EXIT.               EXIT.

       GET-WO-SUFFIX.
           MOVE WONUM-KEY      TO WONUM OF WO-PLANNED.
           READ WO-PLANNED     INTO WO-PLANNED-DATA
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
               MOVE 1          TO RET-CODE
               GO TO GWS-EXIT.

       GWS-EXIT.               EXIT.

       GET-PM-SCHED-REC.
           MOVE 0              TO FIND-SW.
           MOVE PMQ-DATE       TO PREL-KEY.
           MOVE PREL-KEY       TO PMRLSEDATE OF PM-SCHEDULE.
           START PM-SCHEDULE   KEY = PMRLSEDATE OF PM-SCHEDULE
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
               GO TO GPMSR-EXIT.

       DBGET-PM-SCHED-REC.
           READ PM-SCHEDULE    NEXT INTO PM-SCHED-DATA
               AT END          MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT = "10" OR "14" OR "46"
               GO TO GPMSR-EXIT
           ELSE
           IF FILE-STAT NOT = "00"
               MOVE "READ ERROR, PM-SCHEDULE" TO BU-DISPLAY-MSG
               MOVE PREL-KEY   TO BU-DISPLAY-FLD(1)
               PERFORM 999-BLOWUP.

           IF SCH-RELEASE-DATE NOT = PREL-KEY
               MOVE "10"       TO FILE-STAT
               GO TO GPMSR-EXIT.

           IF SCH-EQUIP-NUM NOT = PMQ-EQUIP-NUM
               GO TO DBGET-PM-SCHED-REC.

           IF SCH-PR-ID NOT = PR-ID-SAVE
               GO TO DBGET-PM-SCHED-REC.

           MOVE 1              TO FIND-SW.

       GPMSR-EXIT.             EXIT.

       UPDATE-PM-SCHED-REC.
           WRITE SCH-REC       FROM PM-SCHED-DATA
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
               MOVE "ERROR, WRITE PM-SCHEDULE" TO BU-DISPLAY-MSG
               MOVE SCH-RELEASE-DATE TO BU-DISPLAY-FLD(1)
               MOVE SCH-RELEASE-YRMO TO BU-DISPLAY-FLD(2)
               MOVE SCH-EQUIP-NUM    TO BU-DISPLAY-FLD(3)
               MOVE SCH-WO-NUM       TO BU-DISPLAY-FLD(4)
               MOVE SCH-LEVEL        TO BU-DISPLAY-FLD(5)
               PERFORM 999-BLOWUP.

       UPSR-EXIT.              EXIT.

       SCHED-NEXT-RELEASE.
           MOVE 0              TO FIND-SW.

      *********************************************************************
      ** LOAD EXISTING SCHEDULE INTO TABLE AND DELETE ALL ACTUAL ENTRIES
      ** INCLUDING PRE-RELEASE ENTRIES FOR THIS SCHEDULE
           PERFORM GET-SCHEDULE-RECORDS      THRU GSR-EXIT.

      *********************************************************************
      ** CHECK FOR ANY LEVEL DUE TO RELEASE ON OR BEFORE INIT-DATE
           PERFORM CALC-INIT-DATE            THRU CID-EXIT.
           PERFORM CHECK-SCHED-FOR-INIT      THRU CSFI-EXIT
                               VARYING SUB FROM 1 BY 1
                               UNTIL SUB > 12.

      *********************************************************************
      ** IF LEVEL FOUND THEN REWRITE SCHEDULE RECORDS WITHOUT CHANGES
      ** INCLUDING RE-CALCULATION OF PRE-RELEASE ENTRIES
           IF RECORD-FOUND
               MOVE 0          TO FIND-SW
               GO TO RE-WRITE-SCHEDULE-RECS.

      *********************************************************************
      ** CHECK FOR ANY LEVEL DUE TO RELEASE ON OR BEFORE LOOK-AHEAD DATE
           PERFORM CALC-LOOK-AHEAD           THRU CLA-EXIT.
           PERFORM CHECK-SCHED-FOR-LKAH      THRU CSFL-EXIT
                               VARYING SUB FROM 1 BY 1
                               UNTIL SUB > 12.
           IF RECORD-NOT-FOUND PERFORM BUILD-LEVEL-RECORD.

      *********************************************************************
      ** CHECK PM-OPEN-QUEUE FOR ANY LOWER LEVEL ACTIVE WO'S AND
      ** IF FOUND, CLOSE INCOMPLETE
           MOVE "DN"           TO CHECK-SW.
           MOVE SCH-WO-NUM     TO WONUM-SAVE.
           MOVE SCH-REC-TYPE   TO SAVE-REC-TYPE.
           PERFORM CHECK-FOR-ACTIVES         THRU CFA-EXIT.

       RE-WRITE-SCHEDULE-RECS.
      *********************************************************************
      ** LOAD CHANGED SCHEDULE BACK INTO FILE INCLUDING RE-CALCULATION OF
      ** LOWER LEVEL ENTRIES AND PRE-RELEASE ENTRIES
           IF CUR-LEVEL > 1
               PERFORM GET-MASTER-SCHEDULES  THRU GMS-EXIT
               MOVE "99999999" TO LEAST-DATE
               PERFORM FIND-LEAST-LEVEL      THRU FLL-EXIT
                               VARYING SUB FROM 12 BY -1
                               UNTIL SUB = 0.
               PERFORM CALC-LOWER-LEVELS     THRU CLL-EXIT
                               VARYING SUB FROM 1 BY 1
                               UNTIL SUB = CUR-LEVEL.
           PERFORM WRITE-SCHEDULE-RECS       THRU WSR-EXIT
                               VARYING SUB FROM 1 BY 1
                               UNTIL SUB > 12.

       SNR-EXIT.               EXIT.

       CHECK-FOR-ACTIVES.
           MOVE PMQ-EQUIP-NUM  TO EQUIP-KEY.
           MOVE EQUIP-KEY      TO EQPNUM OF PM-OPEN-QUEUE2.
           START PM-OPEN-QUEUE2 KEY = EQPNUM OF PM-OPEN-QUEUE2
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
               GO TO CFA-EXIT.

       DBGET-ACTIVES.
           READ PM-OPEN-QUEUE2 NEXT INTO PM-QUEUE-DATA
               AT END          MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT = "10" OR "14" OR "46"
               GO TO CFA-EXIT
           ELSE
           IF FILE-STAT NOT = "00"
               MOVE "READ ERROR, PM-OPEN-QUEUE2 " TO BU-DISPLAY-MSG
               MOVE EQUIP-KEY  TO BU-DISPLAY-FLD(1)
               PERFORM 999-BLOWUP.

           IF PMQ-EQUIP-NUM NOT = EQUIP-KEY
               MOVE "10"       TO FILE-STAT
               GO TO CFA-EXIT.

           IF PMQ-WO-NUM = WONUM-SAVE
               GO TO DBGET-ACTIVES.

           IF PMQ-REC-TYPE = "MR  " OR "    " OR "CLPR"
               GO TO DBGET-ACTIVES.

           IF SAVE-REC-TYPE = "FX  "
               IF PMQ-REC-TYPE = "FX  " OR "FXPR"
                   NEXT SENTENCE
               ELSE
                   GO TO DBGET-ACTIVES.

           IF SAVE-REC-TYPE = "DN  "
               IF PMQ-REC-TYPE = "DN  " OR "DNPR"
                   NEXT SENTENCE
               ELSE
                   GO TO DBGET-ACTIVES.

           IF SAVE-REC-TYPE = "CL  "
               IF PMQ-REC-TYPE NOT = "CL  "
                   GO TO DBGET-ACTIVES.

           IF CHECK-SW = "DN"
               IF PMQ-REC-TYPE = "DN  " OR "DNPR"
                   NEXT SENTENCE
               ELSE
                   GO TO DBGET-ACTIVES.

           IF PMQ-WONUM7 = WOSAV-7
               NEXT SENTENCE
           ELSE
           MOVE PMQ-WO-NUM     TO WONUM OF WO-PLANNED2
           READ WO-PLANNED2    INTO WO-PLANNED-DATA2
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT
           END-READ
           IF FILE-STAT NOT = "00"
               GO TO DBGET-ACTIVES
           ELSE
           IF WOSAV-7 NOT = MASTERWO-7 OF WO-PLANNED-DATA2
               GO TO DBGET-ACTIVES.

           IF PMQ-LEVEL > CUR-LEVEL
               GO TO DBGET-ACTIVES.

           PERFORM CLOSE-ACTIVES             THRU CLOSE-EXIT.
           PERFORM DELETE-Q2-RECORD          THRU DQ2R-EXIT.
           GO TO DBGET-ACTIVES.

       CFA-EXIT.               EXIT.

       CALC-LOWER-LEVELS.
           IF SUB = CUR-LEVEL  GO TO CLL-EXIT.

           MOVE L-ENTRY(SUB)   TO PM-MASTER-DATA.
           MOVE PMS-CYCLE      TO PMQ-CYCLE.
           PERFORM CALC-INIT-DATE            THRU CID-EXIT.
           IF INIT-DATE IS GREATER THAN OR EQUAL TO LEAST-DATE
               MOVE SPACES     TO DAY-DATA(SUB)
               GO TO CLL-EXIT.

           MOVE INIT-DATE      TO DD-REL-DT(SUB).
           MOVE INIT-YRMO      TO DD-REL-YRMO(SUB).
           MOVE "DN  "         TO DD-REC-TYPE(SUB).
           MOVE PMQ-EQUIP-NUM  TO DD-EQUIP-NUM(SUB).
           MOVE "000"          TO PMQ-WO-SUF.
           MOVE PMQ-WO-NUM     TO DD-WO-NUM(SUB).
           MOVE PMQ-ZONE-PRI   TO DD-ZONE-PRI(SUB).
           MOVE SUB            TO DD-LEVEL(SUB).
           MOVE PMS-CRITICAL   TO DD-CRITICAL(SUB).
           MOVE PMS-CYCLE      TO DD-CYCLE(SUB).
           MOVE PMS-LOOK-AHEAD TO DD-LOOK-AHEAD(SUB).
           MOVE PMS-PRE-REL    TO DD-PRE-REL(SUB).
           MOVE PMS-PRTY       TO DD-PRIORITY(SUB).
           MOVE SPACES         TO DD-RESTRICT(SUB)
                                  DD-PRE-REL-DT(SUB)
                                  DD-PR-ID(SUB).

       CLL-EXIT.               EXIT.

       FIND-LEAST-LEVEL.
           IF DAY-DATA(SUB) = SPACES
               GO TO FLL-EXIT.

           IF DD-REL-DT(SUB) < LEAST-DATE
               MOVE DD-REL-DT(SUB) TO LEAST-DATE.

       FLL-EXIT.               EXIT.

       GET-MASTER-SCHEDULES.
           MOVE SPACES         TO LEVEL-TABLE.
           MOVE SCHED-KEY      TO PMSCHEDKEY OF PM-MASTER-SCHED.
           START PM-MASTER-SCHED KEY = PMSCHEDKEY OF PM-MASTER-SCHED
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
               GO TO GMS-EXIT.

       DBGET-MASTERS.
           READ PM-MASTER-SCHED NEXT INTO PM-MASTER-DATA
               AT END          MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT = "10" OR "14" OR "46"
               GO TO GMS-EXIT
           ELSE
           IF FILE-STAT NOT = "00"
               MOVE "READ ERROR, PM-MASTER-SCHED" TO BU-DISPLAY-MSG
               MOVE SCHED-KEY  TO BU-DISPLAY-FLD(1)
               PERFORM 999-BLOWUP.

           IF PMS-SCHED-KEY NOT = SCHED-KEY
               GO TO GMS-EXIT.

           MOVE PM-MASTER-DATA TO L-ENTRY(PMS-LEVEL).
           GO TO DBGET-MASTERS.

       GMS-EXIT.               EXIT.

       CHECK-SCHED-FOR-INIT.
           IF DAY-DATA(SUB) = SPACES
               GO TO CSFI-EXIT.

           IF DD-REL-DT(SUB) LESS THAN OR EQUAL TO INIT-DATE
               MOVE DD-LEVEL(SUB) TO REL-LEVEL
               MOVE 1          TO FIND-SW
               MOVE 13         TO SUB.

       CSFI-EXIT.              EXIT.

       CHECK-SCHED-FOR-LKAH.
           IF DAY-DATA(SUB) = SPACES
               GO TO CSFL-EXIT.

           IF DD-REL-DT(SUB) LESS THAN OR EQUAL TO LOOK-AHEAD
               MOVE INIT-DATE  TO DD-REL-DT(SUB)
               MOVE INIT-YRMO  TO DD-REL-YRMO(SUB)
               MOVE DD-LEVEL(SUB) TO REL-LEVEL
               MOVE 1          TO FIND-SW
               MOVE 13         TO SUB.

       CSFL-EXIT.              EXIT.

       BUILD-LEVEL-RECORD.
           MOVE INIT-DATE      TO DD-REL-DT(CUR-LEVEL).
           MOVE INIT-YRMO      TO DD-REL-YRMO(CUR-LEVEL).
           MOVE "DN  "         TO DD-REC-TYPE(CUR-LEVEL).
           MOVE PMQ-EQUIP-NUM  TO DD-EQUIP-NUM(CUR-LEVEL).
           MOVE "000"          TO PMQ-WO-SUF.
           MOVE PMQ-WO-NUM     TO DD-WO-NUM(CUR-LEVEL).
           MOVE PMQ-ZONE-PRI   TO DD-ZONE-PRI(CUR-LEVEL).
           MOVE CUR-LEVEL      TO DD-LEVEL(CUR-LEVEL) REL-LEVEL.
           MOVE PMQ-CRITICAL   TO DD-CRITICAL(CUR-LEVEL).
           MOVE PMQ-CYCLE      TO DD-CYCLE(CUR-LEVEL).
           MOVE PMQ-LOOK-AHEAD TO DD-LOOK-AHEAD(CUR-LEVEL).
           MOVE PMQ-PRE-REL    TO DD-PRE-REL(CUR-LEVEL).
           MOVE PMQ-PRTY       TO HOLD-PRTY.
           MOVE PRT-1          TO DD-PRIORITY(CUR-LEVEL).
           MOVE SPACES         TO DD-RESTRICT(CUR-LEVEL)
                                  DD-PRE-REL-DT(CUR-LEVEL)
                                  DD-PR-ID(CUR-LEVEL).
           MOVE 1              TO FIND-SW.

       BLR-EXIT.               EXIT.

       GET-SCHEDULE-RECORDS.
           MOVE SPACES         TO DAY-STORAGE.
           MOVE PMQ-EQUIP-NUM  TO EQUIP-KEY.
           MOVE EQUIP-KEY      TO PMEQPNUM OF PM-SCHEDULE2.
           START PM-SCHEDULE2  KEY = PMEQPNUM OF PM-SCHEDULE2
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
               GO TO GSR-EXIT.

       DBGET-SCHEDULE.
           READ PM-SCHEDULE2   NEXT INTO PM-SCHED-DATA
               AT END          MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT = "10" OR "14" OR "46"
               GO TO GSR-EXIT
           ELSE
           IF FILE-STAT NOT = "00"
               MOVE "READ ERROR, PM-SCHEDULE2" TO BU-DISPLAY-MSG
               MOVE EQUIP-KEY  TO BU-DISPLAY-FLD(1)
               PERFORM 999-BLOWUP.

           IF SCH-EQUIP-NUM NOT = EQUIP-KEY
               MOVE "10"       TO FILE-STAT
               GO TO GSR-EXIT.

           IF SCH-REC-TYPE = "DN  " OR "DNPR"
               NEXT SENTENCE
           ELSE
               GO TO DBGET-SCHEDULE.

           IF WOKEY-7 NOT = SCH-WO
               GO TO DBGET-SCHEDULE.

           IF SCH-REC-TYPE = "DN  "
               MOVE PM-SCHED-DATA TO DAY-DATA(SCH-LEVEL).

           PERFORM DELETE-PM-SCHED-REC2      THRU DPSR2-EXIT.
           GO TO DBGET-SCHEDULE.

       GSR-EXIT.               EXIT.

       WRITE-SCHEDULE-RECS.
           IF DAY-DATA(SUB) = SPACES
               GO TO WSR-EXIT.

           MOVE SPACES         TO PR-DT-HOLD PR-ID-HOLD.
           MOVE DAY-DATA(SUB)  TO PM-SCHED-DATA.

           IF SCH-PRE-REL NOT NUMERIC
               MOVE 0          TO SCH-PRE-REL.

           IF SCH-LEVEL > REL-LEVEL
             IF SCH-REC-PR NOT = "PR"
               IF SCH-PR-ID NOT = SPACES
                   MOVE SCH-PR-ID TO PR-ID-HOLD
                   MOVE SCH-PREREL-DATE TO PR-DT-HOLD.

           IF SCH-PRE-REL > 0
             IF SCH-REC-PR NOT = "PR"
               PERFORM CALC-PR-DATE          THRU CPD-EXIT
               PERFORM CALC-PR-ID            THRU CPI-EXIT
               MOVE PR-ID      TO SCH-PR-ID
               MOVE PR-DATE    TO SCH-PREREL-DATE.

           IF PR-ID-HOLD NOT = SPACES
               PERFORM UPDATE-PRE-REL-RECORD THRU UPRR-EXIT.

           WRITE SCH-REC       FROM PM-SCHED-DATA
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
               MOVE "WRITE ERROR, PM-SCHEDULE" TO BU-DISPLAY-MSG
               MOVE SCH-RELEASE-DATE TO BU-DISPLAY-FLD(1)
               MOVE SCH-EQUIP-NUM TO BU-DISPLAY-FLD(2)
               MOVE SCH-WO-NUM TO BU-DISPLAY-FLD(3)
               MOVE SCH-LEVEL  TO BU-DISPLAY-FLD(4)
               MOVE SCH-PREREL-DATE TO BU-DISPLAY-FLD(5)
               PERFORM 999-BLOWUP.

           IF SCH-PRE-REL = 0
               GO TO WSR-EXIT.

           IF SCH-PREREL-DATE IS LESS THAN OR EQUAL TO TODAYS-DATE
               GO TO WSR-EXIT.

           MOVE "PR"           TO SCH-REC-PR.
           MOVE SCH-RELEASE-DATE TO SCH-PREREL-DATE.
           MOVE PR-DATE        TO SCH-RELEASE-DATE.
           MOVE PR-DATE-YRMO   TO SCH-RELEASE-YRMO.

           WRITE SCH-REC       FROM PM-SCHED-DATA
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
               MOVE "WRITE ERROR, PM-SCHEDULE PREREL" TO BU-DISPLAY-MSG
               MOVE SCH-RELEASE-DATE TO BU-DISPLAY-FLD(1)
               MOVE SCH-EQUIP-NUM TO BU-DISPLAY-FLD(2)
               MOVE SCH-WO-NUM TO BU-DISPLAY-FLD(3)
               MOVE SCH-LEVEL  TO BU-DISPLAY-FLD(4)
               MOVE SCH-PREREL-DATE TO BU-DISPLAY-FLD(5)
               PERFORM 999-BLOWUP.

       WSR-EXIT.               EXIT.

       CALC-INIT-DATE.
           MOVE ICS-DATE       TO GREG-DATE.
           MOVE SPACES         TO JUL-DATE D-PARM L-PARM.
           CALL "JULGREG"      USING
                               GREG-DATE
                               JUL-DATE
                               D-PARM
                               L-PARM.

           MOVE J-DAY          TO JUL-SIGN.
           ADD PMQ-CYCLE       TO JUL-SIGN.
           PERFORM UNTIL       JUL-SIGN < 366
               SUBTRACT 365    FROM JUL-SIGN
               ADD 1           TO   J-YEAR
           END-PERFORM.

           MOVE JUL-SIGN       TO J-DAY.
           MOVE SPACES         TO GREG-DATE.
           CALL "JULGREG"      USING
                               GREG-DATE
                               JUL-DATE
                               D-PARM
                               L-PARM.

           MOVE GREG-DATE      TO INIT-DATE.

       CID-EXIT.               EXIT.

       CALC-LOOK-AHEAD.
           MOVE INIT-DATE      TO GREG-DATE.
           MOVE SPACES         TO JUL-DATE D-PARM L-PARM.
           CALL "JULGREG"      USING
                               GREG-DATE
                               JUL-DATE
                               D-PARM
                               L-PARM.

           MOVE J-DAY          TO JUL-SIGN.
           ADD PMQ-LOOK-AHEAD  TO JUL-SIGN.
           PERFORM UNTIL       JUL-SIGN < 366
               SUBTRACT 365    FROM JUL-SIGN
               ADD 1           TO   J-YEAR
           END-PERFORM.

           MOVE SPACES         TO GREG-DATE.
           CALL "JULGREG"      USING
                               GREG-DATE
                               JUL-DATE
                               D-PARM
                               L-PARM.

           MOVE GREG-DATE      TO LOOK-AHEAD.

       CLA-EXIT.               EXIT.

       CALC-PR-DATE.
           MOVE SCH-RELEASE-DATE TO GREG-DATE.
           MOVE SPACES         TO JUL-DATE D-PARM L-PARM.
           CALL "JULGREG"      USING
                               GREG-DATE
                               JUL-DATE
                               D-PARM
                               L-PARM.

           MOVE J-DAY          TO JUL-SIGN.
           SUBTRACT SCH-PRE-REL FROM JUL-SIGN.
           PERFORM UNTIL       JUL-SIGN > 0
               ADD 365         TO JUL-SIGN
               SUBTRACT 1      FROM J-YEAR
           END-PERFORM.

           MOVE JUL-SIGN       TO J-DAY.
           MOVE SPACES         TO GREG-DATE.
           CALL "JULGREG"      USING
                               GREG-DATE
                               JUL-DATE
                               D-PARM
                               L-PARM.

           MOVE GREG-DATE      TO PR-DATE.

       CPD-EXIT.               EXIT.

       CALC-PR-ID.
           MOVE INIT-DATE      TO GREG-DATE.
           MOVE SPACES         TO JUL-DATE D-PARM L-PARM.
           CALL "JULGREG"      USING
                               GREG-DATE
                               JUL-DATE
                               D-PARM
                               L-PARM.

           MOVE J-DAY          TO PR-DAY.
           ACCEPT TIME-IN      FROM TIME.
           MOVE TI-7           TO PR-TIME.
           IF PR-TIME NOT > LAST-PR-TIME
               ADD 1           TO LAST-PR-TIME GIVING PR-TIME.
           MOVE PR-TIME        TO LAST-PR-TIME.

       CPI-EXIT.               EXIT.

       UPDATE-PRE-REL-RECORD.
           MOVE EQUIP-KEY      TO EQPNUM OF PM-OPEN-QUEUE2.
           START PM-OPEN-QUEUE2 KEY = EQPNUM OF PM-OPEN-QUEUE2
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
               GO TO UPRR-EXIT.

       DBGET-PRE-REL.
           READ PM-OPEN-QUEUE2 NEXT INTO PM-QUEUE-DATA
               AT END          MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "10" OR "14" OR "46"
               GO TO UPRR-EXIT
           ELSE
           IF FILE-STAT NOT = "00"
               MOVE "READ ERROR, PM-OPEN-QUEUE2" TO BU-DISPLAY-MSG
               MOVE EQUIP-KEY  TO BU-DISPLAY-FLD(1)
               PERFORM 999-BLOWUP.

           IF PMQ-EQUIP-NUM NOT = EQUIP-KEY
               MOVE "10"       TO FILE-STAT
               GO TO UPRR-EXIT.

           IF PMQ-PR-ID NOT = PR-ID-HOLD
               GO TO DBGET-PRE-REL.

           MOVE SCH-PR-ID      TO PMQ-PR-ID
           MOVE SCH-RELEASE-DATE TO PMQ-DATE
           PERFORM UPDATE-Q-RECORD2          THRU UQR2-EXIT.

       UPRR-EXIT.              EXIT.

       DELETE-PM-SCHED-REC.
           DELETE PM-SCHEDULE
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
               MOVE "DELETE ERROR, PM-SCHEDULE" TO BU-DISPLAY-MSG
               MOVE SCH-RELEASE-DATE TO BU-DISPLAY-FLD(1)
               MOVE SCH-EQUIP-NUM TO BU-DISPLAY-FLD(2)
               MOVE SCH-WO-NUM TO BU-DISPLAY-FLD(3)
               MOVE SCH-LEVEL  TO BU-DISPLAY-FLD(4)
               PERFORM 999-BLOWUP.

       DPSR-EXIT.              EXIT.

       DELETE-PM-SCHED-REC2.
           DELETE PM-SCHEDULE2
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
               MOVE "DELETE ERROR, PM-SCHEDULE2" TO BU-DISPLAY-MSG
               MOVE SCH-RELEASE-DATE TO BU-DISPLAY-FLD(1)
               MOVE SCH-EQUIP-NUM TO BU-DISPLAY-FLD(2)
               MOVE SCH-WO-NUM TO BU-DISPLAY-FLD(3)
               MOVE SCH-LEVEL  TO BU-DISPLAY-FLD(4)
               PERFORM 999-BLOWUP.

       DPSR2-EXIT.             EXIT.

       UPDATE-Q-RECORD.
           REWRITE PMOQ-REC    FROM PM-QUEUE-DATA
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
               MOVE "REWRITE PM-OPEN-QUEUE"  TO BU-DISPLAY-MSG
               MOVE PMQ-WO-NUM TO BU-DISPLAY-FLD(1)
               MOVE PMQ-EQUIP-NUM TO BU-DISPLAY-FLD(2)
               MOVE PMQ-DATE   TO BU-DISPLAY-FLD(3)
               PERFORM 999-BLOWUP.

       UQR-EXIT.               EXIT.

       UPDATE-Q-RECORD2.
           REWRITE PMOQ-REC2   FROM PM-QUEUE-DATA
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
               MOVE "REWRITE PM-OPEN-QUEUE2"  TO BU-DISPLAY-MSG
               MOVE PMQ-WO-NUM TO BU-DISPLAY-FLD(1)
               MOVE PMQ-EQUIP-NUM TO BU-DISPLAY-FLD(2)
               MOVE PMQ-DATE   TO BU-DISPLAY-FLD(3)
               PERFORM 999-BLOWUP.

       UQR2-EXIT.              EXIT.

       DELETE-Q-RECORD.
           DELETE PM-OPEN-QUEUE
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
               MOVE "DELETE ERR PM-OPEN-QUEUE, DEL-Q-RECORD"
                               TO BU-DISPLAY-MSG
               MOVE PMQ-WO-NUM TO BU-DISPLAY-FLD(1)
               MOVE PMQ-EQUIP-NUM TO BU-DISPLAY-FLD(2)
               PERFORM 999-BLOWUP.

       DQR-EXIT.               EXIT.

       DELETE-Q2-RECORD.
           DELETE PM-OPEN-QUEUE2
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
               MOVE "DELETE ERR PM-OPEN-QUEUE2, DEL-Q2-RECORD"
                               TO BU-DISPLAY-MSG
               MOVE PMQ-WO-NUM TO BU-DISPLAY-FLD(1)
               MOVE PMQ-EQUIP-NUM TO BU-DISPLAY-FLD(2)
               PERFORM 999-BLOWUP.

       DQ2R-EXIT.              EXIT.

       CLOSE-ACTIVES.
           MOVE PMQ-WO-NUM     TO WONUM-KEY.
           MOVE WONUM-KEY      TO WONUM OF WO-PLANNED.
           READ WO-PLANNED     INTO WO-PLANNED-DATA
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
               MOVE "CLOSE ACTIVE READ ERR WO-PLANNED" TO BU-DISPLAY-MSG
               MOVE WONUM-KEY  TO BU-DISPLAY-FLD(1)
               PERFORM 999-BLOWUP.

           MOVE "DW"           TO WO-STATUS-P OF WO-PLANNED-DATA.
           MOVE "AR"           TO WO-START-STATUS OF WO-PLANNED-DATA.
           MOVE "000000"       TO FAILURE-CODE-P OF WO-PLANNED-DATA.
           MOVE TODAYS-DATE    TO DATE-COMP-P-CN OF WO-PLANNED-DATA.
           ACCEPT TIME-BUF     FROM TIME.
           MOVE TIME-HHMM      TO TIME-COMP-P OF WO-PLANNED-DATA.

           REWRITE WO-PLANNED-REC FROM WO-PLANNED-DATA
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
               MOVE "REWRITE WO-PLANNED, CLOSE-ACTIVE" TO BU-DISPLAY-MSG
               MOVE WONUM-KEY  TO BU-DISPLAY-FLD(1)
               PERFORM 999-BLOWUP.

           MOVE TODAYS-DATE    TO DATE-INIT-CN.
           ACCEPT TIME-BUF     FROM TIME.
           MOVE TIME-HHMM      TO TIME-INIT.
           MOVE "9999"         TO TO-CC FROM-CC.
           MOVE "PM SCHEDULER - REPLACED CW" TO FROM-SIGNON.
           MOVE WO-NUM-PLANNED OF WO-PLANNED-DATA TO TO-WO.
           MOVE SPACES         TO MESSAGES-1-5.
           MOVE "WORKORDER REPLACED BY NEXT SCHEDULED LEVEL"
                               TO MESSAGE-1.
           MOVE "  WORKORDER CLOSED INCOMPLETE"
                               TO MESSAGE-2.

           CALL "TUPDATEM"     USING
                               MESSAGE-DATA
                               UPDATE-SW
                               RETURN-ERROR.

           IF RETURN-ERROR NOT = SPACES
               STRING "CALLING PROGRAM:  SPMCWSD  "
                      "ERROR IN PROGRAM TUPDATEM  "
               DELIMITED BY SIZE INTO RETURN-ERROR
               MOVE 1          TO   RET-CODE
               GO TO CLOSE-EXIT.

           MOVE SPACES         TO T-WO-DATA T-STATUS-DATA.
           MOVE "SPMCWSD "     TO PROGRAM-NAME.
           MOVE WO-NUM-PLANNED OF WO-PLANNED-DATA TO WO-NUM-TRACK.
           MOVE TODAYS-DATE    TO DATE-STAMP-CN.
           ACCEPT TIME-BUF     FROM TIME.
           MOVE TIME-HHMM      TO TIME-STAMP.
           MOVE WO-START-STATUS OF WO-PLANNED-DATA
                               TO WO-TYPE-STATUS.
           MOVE SPACES         TO USER-ID CLOCK-CARD.
           MOVE SPACES         TO USER-NAME.
           MOVE "    "         TO USER-TERM.
           MOVE "DW"           TO WO-STATUS-TRACK TRANS-STATUS.
           CALL "TWOTRACK"     USING WO-TRACK-DATA.

       WRITE-CI-AUDIT.
           MOVE SPACES         TO  PM-AUDIT-DATA RETURN-ERROR.
           MOVE TODAYS-DATE    TO  AUDIT-DATE AUDIT-YRMO.
           ACCEPT TIME-BUF     FROM TIME.
           MOVE TIME-HHMM      TO  AUDIT-TIME.
           MOVE "CI"           TO  AUDIT-TRANS.
           MOVE EQUIP-NUM-P    OF  WO-PLANNED-DATA
                               TO  AUDIT-EQUIP-NUM.
           MOVE WO-NUM-PLANNED OF WO-PLANNED-DATA
                               TO  AUDIT-WO-NUM.
           MOVE WO-STATUS-P    OF WO-PLANNED-DATA
                               TO  AUDIT-WO-STATUS.
           MOVE PMQ-LEVEL      TO  AUDIT-PM-LEVEL.
           IF CHECK-SW = "DN"
               MOVE SCH-LEVEL  TO  AUDIT-PM-LEVEL.
           MOVE "WO REPLACED, CLOSED INCOMPLETE"
                               TO  AUDIT-DESC.

           CALL "SPMAUDIT"     USING PM-AUDIT-DATA
                               DBPARAMETERS
                               RETURN-ERROR.

           IF RETURN-ERROR NOT = SPACES
               STRING "CALLING PROGRAM:  SPMCWSD  "
                      "ERROR IN PROGRAM SPMAUDIT  "
               DELIMITED BY SIZE INTO RETURN-ERROR
               MOVE 1          TO   RET-CODE.

       CLOSE-EXIT.             EXIT.

       WRITE-IP-AUDIT.
           MOVE SPACES         TO  PM-AUDIT-DATA RETURN-ERROR.
           MOVE TODAYS-DATE    TO  AUDIT-DATE AUDIT-YRMO.
           ACCEPT TIME-BUF     FROM TIME.
           MOVE TIME-HHMM      TO  AUDIT-TIME.
           MOVE "IP"           TO  AUDIT-TRANS AUDIT-WO-STATUS.
           MOVE PMQ-EQUIP-NUM  TO  AUDIT-EQUIP-NUM.
           MOVE PMQ-WO-NUM     TO  AUDIT-WO-NUM.
           MOVE CUR-LEVEL      TO  AUDIT-PM-LEVEL.
           MOVE "WORKORDER MOVED IN-PROGRESS.  "
                               TO  AUDIT-DESC.

           CALL "SPMAUDIT"     USING PM-AUDIT-DATA
                               DBPARAMETERS
                               RETURN-ERROR.

           IF RETURN-ERROR NOT = SPACES
               STRING "CALLING PROGRAM:  SPMCWSD  "
                      "ERROR IN PROGRAM SPMAUDIT  "
               DELIMITED BY SIZE INTO RETURN-ERROR
               MOVE 1          TO   RET-CODE.

       WIP-EXIT.               EXIT.

       WRITE-CW-AUDIT.
           MOVE SPACES         TO  PM-AUDIT-DATA RETURN-ERROR.
           MOVE TODAYS-DATE    TO  AUDIT-DATE AUDIT-YRMO.
           ACCEPT TIME-BUF     FROM TIME.
           MOVE TIME-HHMM      TO  AUDIT-TIME.
           MOVE "CW"           TO  AUDIT-TRANS AUDIT-WO-STATUS.
           MOVE PMQ-EQUIP-NUM  TO  AUDIT-EQUIP-NUM.
           MOVE PMQ-WO-NUM     TO  AUDIT-WO-NUM.
           MOVE CUR-LEVEL      TO  AUDIT-PM-LEVEL.
           MOVE "WORKORDER CLOSED.             "
                               TO  AUDIT-DESC.

           CALL "SPMAUDIT"     USING PM-AUDIT-DATA
                               DBPARAMETERS
                               RETURN-ERROR.

           IF RETURN-ERROR NOT = SPACES
               STRING "CALLING PROGRAM:  SPMCWSD  "
                      "ERROR IN PROGRAM SPMAUDIT  "
               DELIMITED BY SIZE INTO RETURN-ERROR
               MOVE 1          TO   RET-CODE.

       WCW-EXIT.               EXIT.

       999-BLOWUP.
           MOVE "SPMCWSD"      TO BU-PGM-NAME.
           MOVE WO-NUM-PLANNED OF WO-PLANNED-DATA
                               TO BU-DISPLAY-FLD (1).
           CALL "TBLOWUP"      USING BASE
                               BU-PGM-NAME
                               STATUS-AREA
                               VIEW-COMAREA
                               FILE-STAT
                               BU-DISPLAY-MSG
                               BU-DISPLAY-FLDS.

       END-OF-JOB.
           CLOSE               WO-PLANNED
                               PM-SCHEDULE
                               PM-SCHEDULE2
                               PM-MASTER-SCHED
                               PM-OPEN-QUEUE
                               PM-OPEN-QUEUE2.
                               GOBACK.

