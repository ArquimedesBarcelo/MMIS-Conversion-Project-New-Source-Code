021400 PROCEDURE DIVISION.
021500 BEGIN SECTION.
       BEGIN-HERE.
021700     PERFORM 1-HSK  THRU  1-HSK-X.
021800     PERFORM 6-MAIN  THRU  6-MAIN-X.
021900     PERFORM 2-CLOSE-FILES  THRU  2-CLOSE-FILES-X.
022000     GOBACK.
022100
022200
022300 1-HSK.
DP9502     MOVE "C" TO MCXCBLERR-SCOPE.
DP9502     CALL "MCXCBLERR" USING MCXCBLERR-SCOPE.
           OPEN INPUT MPLTINFO-I, MVALIDPLTDATA-I, DPORECD-I, DPOITEM-I,
               DINVRCD-I, DREQD-I, WO-NUMBER-I.
           OPEN I-O MPORCV-O.

DCR01 *---------------------------------------------------------
DCR01      PERFORM Z000-PGM-SETUP         THRU Z000-PS-EXIT.
DCR01 *---------------------------------------------------------

024400******************************************
024500*   GET CO. CODE FROM MPLTINFO
024600******************************************
024700
024800     MOVE "P 01"       TO PLT-ARG.
           MOVE PLT-ARG TO PLTINFOKEY OF MPLTINFO-REC-I.
           READ MPLTINFO-I INTO BUF-MPLTINFO
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
025200         MOVE "GET MPLTINFO 'P 01' *1-HSK" TO BU-DISPLAY-MSG
025300         GO TO 2-BLOWUP
025400     ELSE
025500         MOVE MPLTINFO-COMPANY  TO  COMPANY-SAVE.
025600
025700**********************************************
025800*  GET NO. OF MONTHS PO SHOULD STAY AFTER
025900*  DELETION REQUIREMENTS MEET AND THE INDICATOR
026000*  THAT DENOTES IF PLANT HAS INVOICE SOFTWARE
026100**********************************************
026200
026300     MOVE "PODL"       TO PLT-ARG.
           MOVE PLT-ARG TO PLTINFOKEY OF MPLTINFO-REC-I.
           READ MPLTINFO-I INTO BUF-MPLTINFO
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
026700         MOVE "GET MPLTINFO 'PODL' *1-HSK" TO BU-DISPLAY-MSG
026800         GO TO 2-BLOWUP
026900     ELSE
027000         MOVE MPLTINFO-PO-DEL-MTH   TO  PO-DELETE-MONTHS
027100         MOVE MPLTINFO-INVOICE-IND  TO  INVOICE-INDIC-SW
               MOVE MPLTINFO-NWACTIVE-SW  TO  NWO-ACTIVE-SW.
027200
027300***********************************************
027400*  CALL 'TDATECHK' FOR TODAYS DATE
027500***********************************************
027600
027700     MOVE 1            TO  DATE-MODE.
027800     CALL "TDATECHK" USING DATE-CHECK-AREA.
027900     MOVE DATE-YMD-OUT    TO  TODAYS-DATE-YMD.
           IF TODAYS-DATE-YY > "70"
               MOVE "19"        TO  TODAYS-DATE-CC
           ELSE
           MOVE "20"            TO  TODAYS-DATE-CC.
028000     MOVE TODAYS-DATE-CYMD TO  DELETE-DATE-CYMD.
028100     MOVE ZERO            TO  DELETE-DATE-DD.
028200
028300     IF DELETE-DATE-MM > PO-DELETE-MONTHS
028400         NEXT SENTENCE
028500     ELSE
028600         SUBTRACT 1 FROM DELETE-DATE-CCYY
028700         ADD 12 TO DELETE-DATE-MM.
028800     SUBTRACT PO-DELETE-MONTHS  FROM  DELETE-DATE-MM.
028900     DISPLAY "DELETE DATE ", DELETE-DATE-CYMD.
029000
           MOVE DELETE-DATE-CYMD TO  24MO-OLD-DATE-CYMD.
           SUBTRACT 2 FROM 24MO-OLD-DATE-CCYY.
           DISPLAY "24 MONTH OLD DATE ", 24MO-OLD-DATE-CYMD.

029100 1-HSK-X.
029200     EXIT.
029300
DCR01  Z000-PGM-SETUP.
DCR01
DCR01 *****************************************************
DCR01 *   MAKE SURE PO LOGGING IS ACTIVE FOR THIS PLANT
DCR01 *****************************************************
DCR01      SET  Z000-POLG-ACTIVE-NO TO TRUE.
DCR01
DCR01      MOVE WS-Z000-POLG-KEY   TO  PLT-ARG.
DCR01      READ MPLTINFO-I INTO BUF-MPLTINFO.
DCR01      IF FILE-STATUS = "00"
DCR01         IF  PLTINFODTA(1:1) = "Y"
DCR01             SET  Z000-POLG-ACTIVE-YES TO TRUE
DCR01         END-IF
DCR01      END-IF.
DCR01
DCR01      IF   Z000-POLG-ACTIVE-NO
DCR01           GO TO Z000-PS-EXIT
DCR01      END-IF.
DCR01
DCR01 ******************************************************************
DCR01 * GET PLANT CODE                                                 *
DCR01 ******************************************************************
DCR01      MOVE  WS-Z000-CMPNY-KEY  TO PLT-ARG.
DCR01      READ MPLTINFO-I INTO BUF-MPLTINFO.

DCR01      MOVE PLTINFODTA(1:3)  TO WS-Z000-PLANT-CODE.

DCR01      PERFORM Z001-SETUP-PO-LOGGING  THRU Z001-EXIT.
DCR01      PERFORM Z110-RMV-USER-TRIGGER  THRU Z110-EXIT.

DCR01  Z000-PS-EXIT.
DCR01      EXIT.
029400
029500 2-CLOSE-FILES.
           CLOSE MPLTINFO-I, DPORECD-I, DPOITEM-I, DINVRCD-I,
                 MPORCV-O, DREQD-I, WO-NUMBER-I.
030600
030700 2-CLOSE-FILES-X.
030800     EXIT.
030900
031000
031100
031200******************************************************
031300**                                                  **
031400**   BLOWUP ROUTINE                                 **
031500**                                                  **
031600******************************************************
031700
031800 2-BLOWUP.
031900     MOVE "TAPODELT" TO BU-PGM-NAME.
032000     CALL "TBLOWUP" USING BASE, BU-PGM-NAME, STATUS-AREA,
032100         DUMMY-VIEW-AREA, DUMMY-KSAM-STAT, BU-DISPLAY-MSG,
032200             BU-DISPLAY-FLDS.
032300
032400
032500
032600 6-MAIN.
      *************************************************
      **   COMMENT OUT THE CAPACITY CHECK ON DDAILYTC
      **   SINCE FILES ON THE AS/400 WONT HAVE A
      **   CAPACITY LIMIT.
      *************************************************
032700**   PERFORM 60-CHECK-DDAILYTC-CAPACITY  THRU 60-CDC-X.
      *******************************************************
032800
      *----- CALL CCRTFILE TO CREATE A FILE 'PODELT'
      *----- LIBRARY '*LIBL' IS USED.
           MOVE SPACES        TO CCRTFILE-PARMS.
           MOVE "PODELT"      TO CCRTFILE-FILE.
           MOVE "0014"        TO CCRTFILE-RECORD-LENGTH.
           MOVE "01000"       TO CCRTFILE-NO-RECORDS.
           MOVE "01000"       TO CCRTFILE-INCREMENT-AMT.
           MOVE "30"          TO CCRTFILE-NO-INCREMENTS.
           CALL "CCRTFILE" USING CCRTFILE-LIBRARY,
                                 CCRTFILE-FILE,
                                 CCRTFILE-RECORD-LENGTH,
                                 CCRTFILE-NO-RECORDS,
                                 CCRTFILE-INCREMENT-AMT,
                                 CCRTFILE-NO-INCREMENTS,
                                 CCRTFILE-STATUS.
           IF CCRTFILE-STATUS NOT = "00"
               MOVE "CCRTFILE CREATE OF 'PODELT' FAILED"
                   TO BU-DISPLAY-MSG
               GO TO 2-BLOWUP.
032900     OPEN OUTPUT PO-DELETE-FILE.
033000     PERFORM 61-READ-PO-HEADER-DSET  THRU 61-RPHD-X.
033100     CLOSE PO-DELETE-FILE.
033200
033300     OPEN INPUT PO-DELETE-FILE.
033400     PERFORM 62-DELETE-PO  THRU  62-DP-X.
033500     CLOSE PO-DELETE-FILE.
033600
033700 6-MAIN-X.
033800     EXIT.
033900
034000***********************************************
034100**   CALL 'CINFO202' TO SEE HOW FULL THE DATA
034200**   SET 'DDAILYTC' IS.  THE TOLERANCE LEVEL
034300**   CHOOSEN IS 2,500 THIS SHOULD ALLOW PLENTY
034400**   OF ROOM FOR NORMAL DAILY TRANSACTIONS
034500***********************************************
      *************************************************
      **   THE CALL TO THIS PARA HAS BEEN COMMENTED OUT
      **   SINCE FILES ON THE AS/400 WONT HAVE A
      **   CAPACITY LIMIT.
      *************************************************
034600
034700*60-CHECK-DDAILYTC-CAPACITY.
034800*    MOVE 1                       TO DSET-NUMBER.
034900*    MOVE "DDAILYTC;"             TO DSET-INFO-NAME (1).
035000*    MOVE 3000                    TO LEEWAY-NUMBER (1).
035100*    CALL "CINFO202" USING BASE, DSET-ARRAY.
035200*    IF GO-AHEAD-FLAG (1) = "N"
035300*        DISPLAY "TC FILE IS NEAR CAPACITY TRY AFTER BCUTOFF"
035400*        MOVE "TC FILE IS NEAR CAPACITY; TRY LATER AFTER BCUTOFF"
035500*            TO BU-DISPLAY-MSG
035600*        MOVE "ENTRIES"           TO BU-DISPLAY-FLD (1)
035700*        MOVE CURRENT-ENTRIES (1) TO BU-DISPLAY-FLD9 (1)
035800*        MOVE "CAPACITY"          TO BU-DISPLAY-FLD (2)
035900*        MOVE SET-CAPACITY (1)    TO BU-DISPLAY-FLD9 (2)
036000*        GO TO 2-BLOWUP.
036100*
036200*60-CDC-X.
036300*    EXIT.
036400
036500
036600 61-READ-PO-HEADER-DSET.
036700**************************************
036800*                                    *
036900*  SERIAL READ ON DPORECD TO FIND    *
037000*  HEADER DATA                       *
037100*                                    *
037200**************************************
037300
           READ DPORECD-I NEXT INTO BUF-DPORECD
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
037800             GO TO 61-RPHD-X
037900         ELSE
038000             MOVE "GET DPORECD *61-RPHD" TO BU-DISPLAY-MSG
038100             GO TO 2-BLOWUP.
038200     MOVE PO-RCV-NO  TO  PO-ARG,
038300                         BU-DISPLAY-FLD (1).
038400
      ********** THIS LOGIC WILL PREVENT PURCHASE ORDERS FROM BEING
      ********** DELETED AS LONG AS MATERIALS CONTROL LEAVES A NEW
      ********** WORK ORDER ACTIVE IN MVALIDPLTDATA
           IF ACTIVE-NWO
               IF PO-ADDL-DATA > "00009999"
                   MOVE "NW" TO VALID-ARG-1-2
                   MOVE PO-ADDL-DATA TO VALID-ARG-3-10
                   MOVE VALID-ARG TO VALDTAKEY OF MVALIDPLTDATA-REC-I
                   READ MVALIDPLTDATA-I INTO BUF-MVALIDPLTDATA
                       INVALID KEY MOVE FILE-STATUS TO FILE-STATUS
                   END-READ
                   IF FILE-STATUS = "00"
      *                DISPLAY "NWO IS STILL ACTIVE FOR PO = " PO-ARG
                       GO TO 61-READ-PO-HEADER-DSET.

      ********** PREVENT PURCHASE ORDERS FROM BEING DELETED IF THE
      ********** PURCHASE ORDER WAS CREATED FROM A REQUISTION ON A
      ********** MMIS WORKORDER AND THAT WORKORDER STILL EXISTS.
           MOVE PO-RCV-NO TO PORCVNO OF DREQD-REC-I.
           READ DREQD-I INTO BUF-DREQD
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS
           END-READ.
           IF FILE-STATUS = "00"
               IF DREQD-WO-NUMBER NOT = SPACES
                   MOVE DREQD-WO-NUMBER TO WONUM OF WO-NUMBER-REC-I
                   READ WO-NUMBER-I INTO BUF-DWONUM
                       INVALID KEY MOVE FILE-STATUS TO FILE-STATUS
                   END-READ
                   IF FILE-STATUS = "00"
      *             DISPLAY PO-RCV-NO " HAS AN ACTIVE WO FOR ITS REQ"
                       GO TO 61-READ-PO-HEADER-DSET
                   END-IF
               END-IF
           END-IF.

038500********** CHECK RELEASE FIELD FOR '999' WHICH MEANS THIS
038600********** THIS IS A REQUIREMENT ORDER AND THEY ARE
038700********** DELETED BASED ON THE EXPIRATION DATE OF THE ORDER
038800
038900     IF PO-RLS-NO = "999"
039000         IF PO-EXPECT-DATE-CN < DELETE-DATE-CYMD
039100             MOVE "Y"             TO PO-COMPLETE-SW
039200             GO TO 61-CALL-SPOHIST
039300         ELSE
039400             GO TO 61-READ-PO-HEADER-DSET.
039500
039600******* CHECK PO DATE TO SEE IF IT IS OLDER THAN DELETE
039700******* DATE. IF IT ISNT THEN THE PO COULD'NT POSSIBLY MEET
039800******* THE DELETE REQUIREMENTS.
039900
040000     IF PO-DATE-CN < DELETE-DATE-CYMD
040100         NEXT SENTENCE
040200     ELSE
040300         GO TO 61-READ-PO-HEADER-DSET.
040400
040500*******  IF THE PLANT IS USING INVOICE PROCESSING CHECK
040600*******  LAST PAYMENT DATE TO BE SURE IT IS LESS THAN THE
040700*******  DELETE DATE
040800
040900     IF INVOICING
041000         IF PO-LAST-PAYMENT = SPACES
      **************************************************************
      **   THE FOLLOWING THREE IF STATEMENTS WERE ADDED TO TRY    **
      **   TO ALLEVIATE A SITUATION WHEREBY NON-RECEIVEABLE P.O'S **
      **   WERE NOT GETTING CLEARED FROM THE SYSTEM. ALSO, IT     **
      **   APPEARS AS THOUGH P.O'S THAT HAD BEEN COMPLETED VIA    **
      **   SCOMPPO (WHICH WERE MARKED AS RECEIVABLE) WERE SETTING **
      **   THE QUANTITY ORDERED FIELDS TO ZERO AND THESE WOULD    **
      **   NEVER GET RECEIVED AGAINST OR PAID AGAINST.            **
      **************************************************************
                   IF PO-NON-RCV-INDIC NOT = SPACES
                       NEXT SENTENCE
                   ELSE
      *            IF PO-INTERNAL-ORDER-INDIC NOT = SPACES
      *                NEXT SENTENCE
      *            ELSE
                   IF PO-EXPECT-DATE-CN = SPACES
                       IF PO-DATE-CN < 24MO-OLD-DATE-CYMD
                           DISPLAY "PO PASSED > 24 MONTH OLD CHECK "
                               PO-RCV-NO
                       ELSE
                       GO TO 61-READ-PO-HEADER-DSET
                   ELSE
                   IF PO-EXPECT-DATE-CN < DELETE-DATE-CYMD
                       NEXT SENTENCE
                   ELSE
041100             GO TO 61-READ-PO-HEADER-DSET
041200         ELSE
041300             MOVE PO-LAST-PAYMENT-CN  TO  BUILD-PO-LAST-PAY-CYM
041400             IF BUILD-PO-LAST-PAYMENT < DELETE-DATE-CYMD
041500                 NEXT SENTENCE
041600             ELSE
041700             GO TO 61-READ-PO-HEADER-DSET.
041800
041900******* IF THIS IS A NON-RECEIVABLE PO THEN CHECK THE EXPIRATION
042000******* DATE TO SEE IF IT IS LESS THAN THE DELETE DATE. IF IT IS
042100******* THEN THIS PO CAN BE DELETED
042200
042300     MOVE "N"                   TO  PO-COMPLETE-SW.
042400     IF PO-NON-RCV-INDIC NOT = SPACES
042500         IF PO-EXPECT-DATE-CN < DELETE-DATE-CYMD
042600             IF INVOICING
042700                 PERFORM 614-CHECK-OPEN-INVOICES THRU 614-COI-X
042800                 GO TO 61-CALL-SPOHIST
042900             ELSE
043000                 MOVE "Y"  TO  PO-COMPLETE-SW
043100                 GO TO 61-CALL-SPOHIST
043200         ELSE
043300             GO TO 61-READ-PO-HEADER-DSET.
043400
041900******* COMMENTED OUT INTERNAL ORDER CHECKS. WAS CAUSING PO'S TO
042000******* TO MOVE TO HISTORY TOO FAST.   GEISER 11/24/2003
042400*    IF PO-INTERNAL-ORDER-INDIC NOT = SPACES
042500*        IF PO-EXPECT-DATE-CN < DELETE-DATE-CYMD
042600*            IF INVOICING
042700*                PERFORM 614-CHECK-OPEN-INVOICES THRU 614-COI-X
042800*                GO TO 61-CALL-SPOHIST
042900*            ELSE
043000*                MOVE "Y"  TO  PO-COMPLETE-SW
043100*                GO TO 61-CALL-SPOHIST
043200*        ELSE
043300*            GO TO 61-READ-PO-HEADER-DSET.
043400
043500*********  CHECK THE PO ITEMS TO SEE IF THE DELETION
043600*********  REQUIREMENTS ARE MEET
043700
043800     PERFORM 611-CHECK-ITEMS  THRU  611-CI-X.
043900
044000*********  IF THE PO IS COMPLETE CALL 'SPOHIST' TO ABSTRACT
044100*********  ALL OF THE PO, RECEIVING & INVOICE DATA AND PLACE
044200*********  IT IN THE HISTORY DATA BASE
044300
044400 61-CALL-SPOHIST.
044500     IF PO-COMPLETE
044600         PERFORM 613-UPDATE-STORES-HISTORY  THRU  613-USH-X
044700     ELSE
044800         GO TO 61-READ-PO-HEADER-DSET.
044900
045000 61-WRITE-PO-DELETE-FILE.
045100     MOVE PO-RCV-NO       TO PO-DEL-NUM.
045200     WRITE PO-DEL-RCD.
045300     GO TO 61-READ-PO-HEADER-DSET.
045400
045500 61-RPHD-X.
045600     EXIT.
045700
045800
045900
046000
046100******************************************
046200*                                        *
046300*  CONDITIONS FOR A COMPLETE P.O.        *
046400*                                        *
046500*   A. THE FOLLOWING RULES ARE FOR A     *
046600*      PLANT USING THE INVOICE           *
046700*      PROCESSING SYSTEM                 *
046800*      1) QTY DLVR IS GREATER OR = TO    *
046900*         QTY ORDERED OR THE ITEM HAS    *
047000*         BEEN MARKED COMPLETE           *
047100*      2) QTY DLVR IS = QTY STORED       *
047200*         (CODED ITEM ONLY)              *
047300*      3) QTY PAID = QTY DLVR            *
047400*                                        *
047500*   B. THE FOLLOWING RULES ARE FOR A     *
047600*      PLANT NOT USING THE INVOICE       *
047700*      PROCESSING SYSTEM                 *
047800*      1) QTY DLVR IS GREATER OR = TO    *
047900*         QTY ORDERED OR THE ITEM HAS    *
048000*         BEEN MARKED COMPLETE           *
048100*      2) QTY DLVR IS = QTY STORED       *
048200*          (CODED ITEM ONLY)             *
048300*      3) LAST DATE STORED MUST BE LESS  *
048400*         THAN THE DELETION DATE FOR A   *
048500*         CODED ITEM OR LAST DATE        *
048600*         RECEIVED MUST BE LESS THAN     *
048700*         THE DELETION DATE FOR A        *
048800*         NON-CODED ITEM.                *
048900*                                        *
049000******************************************
049100
049200 611-CHECK-ITEMS.
           MOVE PO-ARG TO PORCVNO OF DPOITEM-REC-I.
           START DPOITEM-I KEY = PORCVNO OF DPOITEM-REC-I
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
                   NEXT SENTENCE
               ELSE
049600             MOVE "FIND DPOITEM *611-CI" TO BU-DISPLAY-MSG
049700             GO TO 2-BLOWUP.
049800
049900**************************************
050000*                                    *
050100*  CHECK EACH ITEM IN DPOITEM TO SEE *
050200*  IF THE P.O. IS COMPLETE           *
050300*                                    *
050400**************************************
050500
050600 611-GET-DPOITEM.
           READ DPOITEM-I NEXT INTO BUF-DPOITEM
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
051100             GO TO 611-CHECK-OPEN-INVOICES
051200         ELSE
051300             MOVE "GET DPOITEM*611-GD" TO BU-DISPLAY-MSG
051400             GO TO 2-BLOWUP.
051500
           IF PORCVNO OF DPOITEM-REC-I NOT = PO-ARG
051100         GO TO 611-CHECK-OPEN-INVOICES.
051500
051600     IF ITM-QTY-DLVR < ITM-QTY-ORD
051700         IF ITM-COMPLETE-FLAG  NOT = SPACES
051800             NEXT SENTENCE
051900         ELSE
052000             GO TO 611-CI-X.
052100
052200     IF ITM-CORP-CODE = "NON-STR"
052300         NEXT SENTENCE
052400     ELSE
052500     IF ITM-QTY-DLVR = ITM-QTY-STORED
052600         NEXT SENTENCE
052700     ELSE
052800         GO TO 611-CI-X.
052900
053000     IF INVOICING
      *------------ CHECK FOR "X" INSTEAD OF > SPACES.
      ******** IF PO-NONPAY-IND > SPACES
               IF PO-NONPAY-IND = "X"
                   NEXT SENTENCE
               ELSE
053100         IF ITM-QTY-DLVR = ITM-QTY-PAID
053200              NEXT SENTENCE
      *--------- FOR NAPANEE, IF PO IS OLDER THAN 01/1998, MOVE TO
      *--------- HISTORY EVEN THOUGH PAID NOT = DELIVERED.
               ELSE
               IF COMPANY-SAVE = "631" AND PO-DATE-CN < "19980101"
                   NEXT SENTENCE
053300         ELSE
      *--------- FOR VALLEYFIELD, IF PO IS INTERNAL ORDER AND QTY PAID
      *--------- NOT EQUAL QTY DELIVERED, LET IT MOVE TO HISTORY.
               IF COMPANY-SAVE = "629"
                   IF PO-INTERNAL-ORDER-INDIC = "X"
                       NEXT SENTENCE
                   ELSE
                   GO TO 611-CI-X
               ELSE
053400             GO TO 611-CI-X
053500     ELSE
053600         IF ITM-DATE-STORED = "  DD  "  OR
053700            ITM-CORP-CODE = "NON-STR"
053800             IF ITM-DATE-RCVD-CN < DELETE-DATE-CYMD
053900                 NEXT SENTENCE
054000             ELSE
054100                 GO TO 611-CI-X
054200         ELSE
054300             IF ITM-DATE-STORED-CN < DELETE-DATE-CYMD
054400                 NEXT SENTENCE
054500             ELSE
054600                 GO TO 611-CI-X.
054700
054800     GO TO 611-GET-DPOITEM.
054900
055000*****************************************************
055100*
055200*  EVEN THOUGH THE PO HAS PASSED THE CHECK FOR
055300*  (QUANTITY PAID = QUANTITY ORDERED) I CHECK TO
055400*  MAKE SURE ALL THE INVOICES ASSOCIATED WITH THE PO
055500*  HAVE BEEN MANIFESTED COMPLETELY (INV-STATUS = 2)
055600*
055700*****************************************************
055800
055900 611-CHECK-OPEN-INVOICES.
056000     IF INVOICING
      *------------ CHECK FOR "X" INSTEAD OF > SPACES.
      ******** IF PO-NONPAY-IND > SPACES
               IF PO-NONPAY-IND = "X"
                   MOVE "Y"  TO  PO-COMPLETE-SW
               ELSE
056100             PERFORM 614-CHECK-OPEN-INVOICES  THRU  614-COI-X
               END-IF
056200     ELSE
056300         MOVE "Y"  TO  PO-COMPLETE-SW.
056400
056500 611-CI-X.
056600     EXIT.
056700
056800
056900*********************************************
057000*                                           *
057100*   THE NEXT PROCEDURE CALLS 'SPOHIST'      *
057200*   WHICH IS THE SUBROUTINE WHICH ABSTRACTS *
057300*   ALL THE PO HISTORY FOR A GIVEN PO AND   *
057400*   PLACES THIS INFO. IN THE HISTORY DB     *
057500*   'STHIST'                                *
057600*                                           *
057700*********************************************
057800
057900
058000 613-UPDATE-STORES-HISTORY.
           MOVE PO-ARG TO PORCVNO OF MPORCV-REC-O.
           READ MPORCV-O INTO BUF-MPORCV
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
059400         MOVE "GET MPORCV*613-USH" TO BU-DISPLAY-MSG
059500         GO TO 2-BLOWUP.
059600
059700********* IF 'PO-RCV-SEQ' IS = 'HISTOK' ON THE PO MASTER
059800********* 'MPORCV' THEN THIS MEANS THE PO HAS ALREADY BEEN
059900********* MOVED TO THE HISTORY DATA BASE AND THEREFORE IS
060000********* NOT COPIED OVER AGAIN.  OTHERWISE MARK 'PO-RCV-SEQ'
060100********* WITH 'HISTSP' AND CALL 'SPOHIST'.  IF 'SPOHIST'
060200********* SUCCESSFULLY COPYS THE PO OVER INTO THE HISTORY DB
060300********* THEN IT WILL MARK 'PO-RCV-SEQ' WITH A 'HISTOK'
060400********* INDICATOR
060500
060600     IF M-PO-RCV-SEQ = "HISTOK"
060800         GO TO 613-USH-X.
060900
061000     MOVE "HISTSP" TO  M-PO-RCV-SEQ.
           REWRITE MPORCV-REC-O FROM BUF-MPORCV
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
061400         MOVE "UPDATE MPORCV*613-USH" TO BU-DISPLAY-MSG
061500         GO TO 2-BLOWUP.
061600
061900     CALL "SPOHIST" USING BASE,
062000                          BASE-STHIST,
062100                          BUF-DPORECD,
062200                          PO-ARG.
062300
062400 613-USH-X.
062500     EXIT.
062600
063700
063800*****************************************************
063900*
064000*  EVEN THOUGH THE PO HAS PASSED THE CHECK FOR
064100*  (QUANTITY PAID = QUANTITY ORDERED) I CHECK TO
064200*  MAKE SURE ALL THE INVOICES ASSOCIATED WITH THE PO
064300*  HAVE BEEN MANIFESTED COMPLETELY (INV-STATUS = 2)
064400*
064500*****************************************************
064600
064700 614-CHECK-OPEN-INVOICES.
           MOVE PO-ARG TO PORCVNO OF DINVRCD-REC-I.
           START DINVRCD-I KEY = PORCVNO OF DINVRCD-REC-I
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
                   NEXT SENTENCE
               ELSE
065100             MOVE "FIND DINVRCD *614-COI" TO BU-DISPLAY-MSG
065200             GO TO 2-BLOWUP.
065300
065400 614-GET-DINVRCD.
           READ DINVRCD-I NEXT INTO BUF-DINVRCD
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
065900             MOVE "Y"  TO  PO-COMPLETE-SW
066000             GO TO 614-COI-X
066100         ELSE
066200             MOVE "GET DINVRCD*614-GD" TO BU-DISPLAY-MSG
066300             GO TO 2-BLOWUP.
           IF PORCVNO OF DINVRCD-REC-I NOT = PO-ARG
065900         MOVE "Y"  TO  PO-COMPLETE-SW
066000         GO TO 614-COI-X.
066400
066500********  INVOICE IS COMPLETE (MANIFESTED) IF INV-STATUS = 2
066600
066700     IF INV-STATUS = "2"
066800         GO TO 614-GET-DINVRCD
066900     ELSE
067000         GO TO 614-COI-X.
067100
067200 614-COI-X.
067300     EXIT.
067400
067500*******************************************
067600*                                         *
067700*  THIS PROCEDURE CALLS 'SDELTPO' WHICH   *
067800*  DOES THE ACTUAL DELETION OF A PO FROM  *
067900*  THE STORES DATA BASE.  BY THE TIME     *
068000*  THIS SUBROUTINE IS CALLED THE PO HAS   *
068100*  ALREADY BEEN COPIED OVER TO THE        *
068200*  HISTORY DATA BASE 'STHIST'             *
068300*                                         *
068400*******************************************
068500
068600
068700 62-DELETE-PO.
068800     READ PO-DELETE-FILE
068900         AT END  GO TO 62-DP-X.
069000
069100     MOVE PO-DEL-NUM            TO  PO-ARG.
      *------- SWITCH TO INDICATE ITEM MOVE TO HISTORY.  RESET IN
      *------- SDELTPO.
           MOVE "H" TO BASE (1:1).
069200     CALL "SDELTPO" USING BASE,
069300                          PO-ARG,
069400                          COMPANY-SAVE.

