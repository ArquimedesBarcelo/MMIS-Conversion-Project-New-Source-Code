       IDENTIFICATION DIVISION.
       PROGRAM-ID.     TSCSHOW.
       AUTHOR.         W ROXBURY.
       DATE-WRITTEN.   06/20/1994.
       DATE-COMPILED.
      *REMARKS.        INQUIRY OF THE SAFETY CONTACT FILE
      *                BASED ON LOCATION.
      *C
      *C 06/03/2003 WR FONAGY
      *C   ADDED THE TWO NEW SAFETY CONTACT TYPES TO THE REPORT
      *C   (5 - ERGONOMICS AND 6 - REPAIR HOSPITAL, WO REQUIRED)
      *C
       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.
       SOURCE-COMPUTER.        IBM-AS400.
       OBJECT-COMPUTER.        IBM-AS400.
       SPECIAL-NAMES.          I-O-FEEDBACK IS I-O-FEEDBACK-AREA
                               C01 IS NEW-PAGE.

       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT DISPLAY-FILE
                  ASSIGN       TO WORKSTATION-ZSCSYSTEM-SI
                  ORGANIZATION IS TRANSACTION
                  ACCESS MODE  IS DYNAMIC
                  RELATIVE KEY IS RECNO
                  FILE STATUS  IS SCREEN-STATUS
                               MAJOR-MINOR
                  CONTROL-AREA IS SCREEN-CONTROL.

           SELECT SAFETY-DATE
                  ASSIGN       TO DATABASE-MCFLSC0104
                  ORGANIZATION IS INDEXED
                  ACCESS MODE  IS DYNAMIC
                  RECORD KEY   IS EXTERNALLY-DESCRIBED-KEY
                               WITH DUPLICATES
                  FILE STATUS  IS FILE-STAT.

           SELECT EQP-EQUIPMENT
                  ASSIGN       TO DATABASE-MCFLMM0201
                  ORGANIZATION IS INDEXED
                  ACCESS MODE  IS DYNAMIC
                  RECORD KEY   IS EXTERNALLY-DESCRIBED-KEY
                  FILE STATUS  IS FILE-STAT.

       DATA DIVISION.
       FILE SECTION.
       FD  DISPLAY-FILE
           LABEL RECORDS       ARE OMITTED.
       01  DISPLAY-REC         PIC X(2000).

       FD  SAFETY-DATE
           LABEL RECORDS       ARE STANDARD.
       01  SD-REC.
           COPY DDS-ALL-FORMATS OF MCFLSC0104.

       FD  EQP-EQUIPMENT
           LABEL RECORDS       ARE STANDARD.
       01  EQP-REC.
           COPY DDS-ALL-FORMATS OF MCFLMM0201.

       WORKING-STORAGE SECTION.
       77  SUB                 PIC 99    VALUE 0.
       77  SUBT                PIC 99    VALUE 0.
       77  RECNO               PIC 9999  VALUE 0.
       77  TYPESAVE            PIC X(30) VALUE SPACES.
       77  LOCKEY              PIC X(18) VALUE SPACES.
       77  TRUE-VAL            PIC 1     VALUE B"1".
       77  NEG-VAL             PIC 1     VALUE B"0".
       77  DELIMS              PIC X(22) VALUE ALL "=".

       01  FILE-STAT.
           05  FILE-STAT-1     PIC X.
           05  FILE-STAT-2     PIC X.

       01  SCREEN-DATA.
           05  LOCATION-DATA   PIC X(396).
           05  LOCATION-TABLE  REDEFINES LOCATION-DATA.
               10  LOCATN      OCCURS 18 TIMES.
                   15  NUM     PIC X(04).
                   15  LOC     PIC X(18).
           05  CONTACT.
               10  CONT1       PIC X.
               10  CONT2       PIC X.
           05  CONT-9          REDEFINES CONTACT
                               PIC 99.
           05  DATE-BUF.
               10  DATE-MM     PIC XX.
               10  SLASH1      PIC X.
               10  DATE-DD     PIC XX.
               10  SLASH2      PIC X.
               10  DATE-CT     PIC XX.
               10  DATE-YY     PIC XX.
           05  CCNUM-BUF       PIC X(04).
           05  CMDMSG          PIC X(79).
           05  ERRMSG          PIC X(79).

       01  SCREEN-SHOW.
           05  LOCATION        PIC X(18).
           05  DISDATE         PIC X(10).
           05  DISMSG          PIC X(14).

       01  MSG-BUF.
           05  FILLER          PIC X(10) VALUE "FOR CC NO-".
           05  CC-MSG          PIC X(04).

       01  PLACE.
           05  CTR             PIC 99.
           05  ZCTR            REDEFINES CTR.
               10  ZCTR1       PIC X.
               10  ZCTR2       PIC X.
           05  FILLER          PIC XX    VALUE " -".

       01  CURR-DATE.
           05  CURR-YY         PIC 9(02).
           05  CURR-MM         PIC 9(02).
           05  CURR-DD         PIC 9(02).

       01  DATE-KEY.
           05  DKEY-CT         PIC 9(02).
           05  DKEY-YY         PIC 9(02).
           05  DKEY-MM         PIC 9(02).
           05  DKEY-DD         PIC 9(02).

       01  EQUIP-BUFFER.
           05  EQUIP-VALUES.
               10  EQP01       PIC X(06) VALUE "SAFE01".
               10  EQP02       PIC X(06) VALUE "SAFE02".
               10  EQP03       PIC X(06) VALUE "SAFE03".
               10  EQP04       PIC X(06) VALUE "SAFE04".
               10  EQP05       PIC X(06) VALUE "SAFE05".
               10  EQP06       PIC X(06) VALUE "SAFE06".
               10  EQP07       PIC X(06) VALUE "SAFE07".
               10  EQP08       PIC X(06) VALUE "SAFE08".
               10  EQP09       PIC X(06) VALUE "SAFE09".
               10  EQP10       PIC X(06) VALUE "SAFE10".
               10  EQP11       PIC X(06) VALUE "SAFE11".
               10  EQP12       PIC X(06) VALUE "SAFE12".
               10  EQP13       PIC X(06) VALUE "SAFE13".
               10  EQP14       PIC X(06) VALUE "SAFE14".
               10  EQP15       PIC X(06) VALUE "SAFE15".
               10  EQP16       PIC X(06) VALUE "SAFE16".
               10  EQP17       PIC X(06) VALUE "SAFE17".
               10  EQP18       PIC X(06) VALUE "SAFE18".
           05  EQP-VAL         REDEFINES EQUIP-VALUES.
               10  EQPVAL      OCCURS 18 TIMES  PIC X(06).

       01  TABLE-BUFFER.
           05  TABLE-VALUES.
               10  SUB01       PIC 99 VALUE  1.
               10  SUB02       PIC 99 VALUE  4.
               10  SUB03       PIC 99 VALUE  7.
               10  SUB04       PIC 99 VALUE 10.
               10  SUB05       PIC 99 VALUE 13.
               10  SUB06       PIC 99 VALUE 16.
               10  SUB07       PIC 99 VALUE  2.
               10  SUB08       PIC 99 VALUE  5.
               10  SUB09       PIC 99 VALUE  8.
               10  SUB10       PIC 99 VALUE 11.
               10  SUB11       PIC 99 VALUE 14.
               10  SUB12       PIC 99 VALUE 17.
               10  SUB13       PIC 99 VALUE  3.
               10  SUB14       PIC 99 VALUE  6.
               10  SUB15       PIC 99 VALUE  9.
               10  SUB16       PIC 99 VALUE 12.
               10  SUB17       PIC 99 VALUE 15.
               10  SUB18       PIC 99 VALUE 18.
           05  SUB-VAL         REDEFINES TABLE-VALUES.
               10  SUBV        OCCURS 18 TIMES  PIC 99.

       01  RPT-CTRS.
           05  TYPE-CTRS.
               10  TP1         PIC 9(08).
               10  TP2         PIC 9(08).
               10  TP3         PIC 9(08).
               10  TP4         PIC 9(08).
               10  TP5         PIC 9(08).
               10  TP6         PIC 9(08).
               10  TPT         PIC 9(08).

       01  HEADER-RPT1.
           05  FILLER          PIC X(18) VALUE SPACES.
           05  FILLER          PIC X(06) VALUE "UNSAFE".
           05  FILLER          PIC X(06) VALUE SPACES.
           05  FILLER          PIC X(06) VALUE "UNSAFE".
           05  FILLER          PIC X(17) VALUE SPACES.
           05  FILLER          PIC X(06) VALUE "REPAIR".
           05  FILLER          PIC X(06) VALUE SPACES.
           05  FILLER          PIC X(05) VALUE "TOTAL".
           05  FILLER          PIC X(08) VALUE SPACES.

       01  HEADER-RPT2.
           05  FILLER          PIC X(08) VALUE "POSITIVE".
           05  FILLER          PIC X(01) VALUE SPACES.
           05  FILLER          PIC X(07) VALUE "AT-RISK".
           05  FILLER          PIC X(02) VALUE SPACES.
           05  FILLER          PIC X(09) VALUE "CONDITION".
           05  FILLER          PIC X(03) VALUE SPACES.
           05  FILLER          PIC X(09) VALUE "CONDITION".
           05  FILLER          PIC X(14) VALUE SPACES.
           05  FILLER          PIC X(08) VALUE "HOSPITAL".
           05  FILLER          PIC X(04) VALUE SPACES.
           05  RH-LOC          PIC X(13) VALUE SPACES.

       01  HEADER-RPT3.
           05  FILLER          PIC X(07) VALUE "CONTACT".
           05  FILLER          PIC X(02) VALUE SPACES.
           05  FILLER          PIC X(08) VALUE "BEHAVIOR".
           05  FILLER          PIC X     VALUE SPACES.
           05  FILLER          PIC X(11) VALUE "(CORRECTED)".
           05  FILLER          PIC X     VALUE SPACES.
           05  FILLER          PIC X(11) VALUE "WO REQUIRED".
           05  FILLER          PIC X     VALUE SPACES.
           05  FILLER          PIC X(10) VALUE "ERGONOMICS".
           05  FILLER          PIC X     VALUE SPACES.
           05  FILLER          PIC X(11) VALUE "WO REQUIRED".
           05  FILLER          PIC X     VALUE SPACES.
           05  FILLER          PIC X(08) VALUE "CONTACTS".
           05  FILLER          PIC X(05) VALUE SPACES.

       01  REPORT-CTRS.
           05  PCT             PIC ZZ,ZZ9.
           05  FILLER          PIC X(03) VALUE SPACES.
           05  ARB             PIC ZZ,ZZ9.
           05  FILLER          PIC X(05) VALUE SPACES.
           05  UCC             PIC ZZ,ZZ9.
           05  FILLER          PIC X(05) VALUE SPACES.
           05  UCM             PIC ZZ,ZZ9.
           05  FILLER          PIC X(06) VALUE SPACES.
           05  ERG             PIC ZZ,ZZ9.
           05  FILLER          PIC X(06) VALUE SPACES.
           05  RHM             PIC ZZ,ZZ9.
           05  FILLER          PIC X(03) VALUE SPACES.
           05  TCT             PIC ZZ,ZZ9.
           05  FILLER          PIC X(05) VALUE SPACES.

       01  PRINT-REC           PIC X(78).
       01  P-REC-1             REDEFINES PRINT-REC.
           05  DELIM1          PIC X(22).
           05  FILLER          PIC XX.
           05  P-TYPE          PIC X(30).
           05  FILLER          PIC XX.
           05  DELIM2          PIC X(22).
       01  P-REC-2             REDEFINES PRINT-REC.
           05  P-TIME.
               10  P-H         PIC XX.
               10  COLON       PIC X.
               10  P-M         PIC XX.
           05  FILLER          PIC X.
           05  P-CCNUM         PIC XXXX.
           05  FILLER          PIC XX.
           05  OB-ACT          PIC X(66).

       01  DB-ERROR.
           05  DB-FUNC         PIC X(10) VALUE SPACES.
           05  DB-FILE         PIC X(18) VALUE SPACES.
           05  FILLER          PIC X(20) VALUE "ERROR - FILE-STAT = ".
           05  CON-WORD        PIC XX.

           COPY SCREENIO       IN COPYLIB.

           COPY CATREAD        IN COPYLIB.

           COPY SAFECONT       IN COPYLIB.

       01  EQUIPMENT-DATA.
           COPY MEQPFILE       IN COPYLIB.

       01  MESSAGE-DATA.
           COPY ERRORLIN       IN COPYLIB.

       PROCEDURE DIVISION.
       BEGIN-PGM.
           OPEN I-O            DISPLAY-FILE.
           OPEN INPUT          SAFETY-DATE.
           OPEN INPUT          EQP-EQUIPMENT.

       MAIN.
           MOVE 0              TO RECNO.
           MOVE SPACES         TO SCREEN-DATA
                                  MESSAGE-BUFFER
                                  SCREEN-SHOW.
           ACCEPT CURR-DATE    FROM DATE.
      **********************************************************
      *    MOVE "940621"       TO CURR-DATE.
      **********************************************************
           MOVE CURR-YY        TO DATE-YY DKEY-YY.
           MOVE CURR-MM        TO DATE-MM DKEY-MM.
           MOVE CURR-DD        TO DATE-DD DKEY-DD.
           MOVE "/"            TO SLASH1 SLASH2.
           MOVE 20             TO DATE-CT DKEY-CT.
           IF DATE-YY > 60
               MOVE 19         TO DATE-CT DKEY-CT.

           PERFORM LOAD-LOOP   VARYING SUB FROM 1 BY 1
                               UNTIL SUB > 18.

       SHOWFORM.
           MOVE "SELSHOW"      TO SCREEN-NAME.
           MOVE "00"           TO SCREEN-STATUS.
           MOVE SCREEN-DATA    TO DISPLAY-REC.

           WRITE DISPLAY-REC   FORMAT IS SCREEN-NAME
                               INDIC ARE SCREEN-INDICATORS.
           IF SCREEN-STATUS NOT = "00"
               DISPLAY "SCREEN WRITE ERROR.  SCREEN-STATUS IS "
                               SCREEN-STATUS
               GO TO END-OF-JOB.

           READ  DISPLAY-FILE  FORMAT IS SCREEN-NAME
                               INDIC ARE SCREEN-INDICATORS
           IF SCREEN-STATUS NOT = "00"
               DISPLAY "SCREEN READ ERROR.  SCREEN-STATUS IS "
                               SCREEN-STATUS
               GO TO END-OF-JOB.

           MOVE DISPLAY-REC    TO SCREEN-DATA.
           MOVE ALL B"0"       TO SCREEN-INDICATORS.

           IF KEY-HIT = 3
               GO TO END-OF-JOB.

       EDIT-CHECKS.
           IF CONTACT = "**"
               GO TO DISPLAY-RECS.

           IF CONTACT = SPACES OR "00" OR "0 " OR " 0"
               MOVE
               "LOCATION NUMBER IS REQUIRED, ENTER NUMBER FROM LIST"
                               TO MESSAGE-BUFFER
               MOVE  1         TO FIELD-NUMBER
               PERFORM ERROR-PROC
               GO TO SHOWFORM.

           IF CONT1 = SPACE
               MOVE "0"        TO CONT1.

           IF CONT2 = SPACE
               MOVE CONT1      TO CONT2
               MOVE "0"        TO CONT1.

           IF CONTACT NOT NUMERIC
               MOVE
               "LOCATION NUMBER MUST BE NUMERIC, ENTER NUMBER FROM LIST"
                               TO MESSAGE-BUFFER
               MOVE  1         TO FIELD-NUMBER
               PERFORM ERROR-PROC
               GO TO SHOWFORM.

           IF CONTACT > "18"
               MOVE
               "LOCATION NUMBER IS INVALID, ENTER NUMBER FROM LIST"
                               TO MESSAGE-BUFFER
               MOVE  1         TO FIELD-NUMBER
               PERFORM ERROR-PROC
               GO TO SHOWFORM.

           IF CONTACT = "01"   MOVE  1 TO SUB.
           IF CONTACT = "02"   MOVE  4 TO SUB.
           IF CONTACT = "03"   MOVE  7 TO SUB.
           IF CONTACT = "04"   MOVE 10 TO SUB.
           IF CONTACT = "05"   MOVE 13 TO SUB.
           IF CONTACT = "06"   MOVE 16 TO SUB.
           IF CONTACT = "07"   MOVE  2 TO SUB.
           IF CONTACT = "08"   MOVE  5 TO SUB.
           IF CONTACT = "09"   MOVE  8 TO SUB.
           IF CONTACT = "10"   MOVE 11 TO SUB.
           IF CONTACT = "11"   MOVE 14 TO SUB.
           IF CONTACT = "12"   MOVE 17 TO SUB.
           IF CONTACT = "13"   MOVE  3 TO SUB.
           IF CONTACT = "14"   MOVE  6 TO SUB.
           IF CONTACT = "15"   MOVE  9 TO SUB.
           IF CONTACT = "16"   MOVE 12 TO SUB.
           IF CONTACT = "17"   MOVE 15 TO SUB.
           IF CONTACT = "18"   MOVE 18 TO SUB.
           MOVE LOC(SUB)       TO LOCKEY.

           IF LOC(SUB) = SPACES
               MOVE
               "LOCATION NUMBER IS INVALID, ENTER NUMBER FROM LIST"
                               TO MESSAGE-BUFFER
               MOVE  1         TO FIELD-NUMBER
               PERFORM ERROR-PROC
               GO TO SHOWFORM.

       DISPLAY-RECS.
           MOVE 0              TO RECNO.
           MOVE NEG-VAL        TO IND(75).
           MOVE TRUE-VAL       TO IND(77) IND(76).
           MOVE ZEROS          TO TYPE-CTRS.
           MOVE SPACES         TO DISPLAY-REC TYPESAVE.

           WRITE DISPLAY-REC   FORMAT "SCSHOW"
                               INDIC ARE SCREEN-INDICATORS.
           IF SCREEN-STATUS NOT = "00"
               DISPLAY
               "SUBFILE CLEAR WRITE ERROR.  SCREEN-STATUS IS "
                               SCREEN-STATUS.

           MOVE NEG-VAL        TO IND(77).
           MOVE SPACES         TO SCREEN-SHOW.
           MOVE LOCKEY         TO LOCATION RH-LOC.
           IF CONTACT = "**"
               MOVE "> ALL LOCATIONS < " TO LOCATION
               MOVE "ALL LOCATION      " TO RH-LOC.

           MOVE DATE-BUF       TO DISDATE.
           IF CCNUM-BUF NOT = SPACES
               MOVE CCNUM-BUF  TO CC-MSG
               MOVE MSG-BUF    TO DISMSG.

           MOVE SPACES         TO SD-REC.
           MOVE DATE-KEY       TO SCDATESTMP OF SAFETY-DATE.
           START SAFETY-DATE   KEY = SCDATESTMP OF SAFETY-DATE
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
      **********************************************************************
      **    MESSAGE 040/015:
      **  NO RECORDS FOUND
      **********************************************************************
               MOVE  40        TO CATREAD-MSG-SET
               MOVE  15        TO CATREAD-MSG-NUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER TO ERRMSG
               MOVE TRUE-VAL   TO IND(99)
               GO TO SHOWFORM.

       DBGET-LOOP.
           READ SAFETY-DATE    NEXT INTO CONTACT-DATA
               AT END          MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
               IF FILE-STAT = "10" OR "14" OR "46"
                   GO TO SUBF-CONT
               ELSE
                   MOVE "READ    " TO DB-FUNC
                   MOVE "NEWS-TABLE" TO DB-FILE
                   MOVE FILE-STAT  TO CON-WORD
                   MOVE DB-ERROR   TO ERRMSG
                   MOVE TRUE-VAL   TO IND(99)
                   GO TO SHOWFORM.

           IF SC-DATE NOT = DATE-KEY
               GO TO SUBF-CONT.

           IF CONTACT = "**"
               NEXT SENTENCE
           ELSE
           IF SC-EQUIP-NAME NOT = LOCKEY
               GO TO DBGET-LOOP.

           IF CCNUM-BUF NOT = SPACES
               IF CCNUM-BUF NOT = SC-CC
                   GO TO DBGET-LOOP.

           IF SC-DESC-1 = "POSITIVE CONTACT              "
               ADD  1          TO TP1 TPT
           ELSE
           IF SC-DESC-1 = "AT-RISK BEHAVIOR              "
               ADD  1          TO TP2 TPT
           ELSE
           IF SC-DESC-1 = "UNSAFE CONDITION (CORRECTED)  "
               ADD  1          TO TP3 TPT
           ELSE
           IF SC-DESC-1 = "UNSAFE CONDITION, WO REQUIRED "
               ADD  1          TO TP4 TPT
           ELSE
           IF SC-DESC-1 = "ERGONOMICS                    "
               ADD  1          TO TP5 TPT
           ELSE
           IF SC-DESC-1 = "REPAIR HOSPITAL, WO REQUIRED  "
               ADD  1          TO TP6 TPT.

           IF SC-DESC-1 NOT = TYPESAVE
               MOVE SPACES         TO PRINT-REC
               MOVE PRINT-REC      TO DISPLAY-REC
               ADD  1              TO RECNO
               MOVE "00"           TO SCREEN-STATUS
               WRITE SUBFILE       DISPLAY-REC FORMAT "RDSF"
                                   INDIC ARE SCREEN-INDICATORS
                   INVALID KEY     MOVE FILE-STAT TO FILE-STAT
               END-WRITE
               IF SCREEN-STATUS NOT = "00"
                   DISPLAY "SUBFILE 1A WRITE ERROR.  SCREEN-STATUS IS "
                                   SCREEN-STATUS
                   GO TO END-OF-JOB
               END-IF
               MOVE SC-DESC-1      TO P-TYPE TYPESAVE
               MOVE DELIMS         TO DELIM1 DELIM2
               MOVE PRINT-REC      TO DISPLAY-REC
               ADD  1              TO RECNO
               MOVE "00"           TO SCREEN-STATUS
               WRITE SUBFILE       DISPLAY-REC FORMAT "RDSF"
                                   INDIC ARE SCREEN-INDICATORS
                   INVALID KEY     MOVE FILE-STAT TO FILE-STAT
               END-WRITE
               IF SCREEN-STATUS NOT = "00"
                   DISPLAY "SUBFILE 1B WRITE ERROR.  SCREEN-STATUS IS "
                                   SCREEN-STATUS
                   GO TO END-OF-JOB.

           MOVE SPACES         TO PRINT-REC.
           MOVE SC-TIME-HH     TO P-H.
           MOVE SC-TIME-MM     TO P-M.
           MOVE ":"            TO COLON.
           MOVE SC-CC          TO P-CCNUM.
           MOVE OBSERVATION    TO OB-ACT.
           MOVE PRINT-REC      TO DISPLAY-REC.
           ADD  1              TO RECNO.
           MOVE "00"           TO SCREEN-STATUS.
           WRITE SUBFILE       DISPLAY-REC FORMAT "RDSF"
                               INDIC ARE SCREEN-INDICATORS
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF SCREEN-STATUS NOT = "00"
               DISPLAY "SUBFILE 2 WRITE ERROR.  SCREEN-STATUS IS "
                               SCREEN-STATUS
               GO TO END-OF-JOB.

           IF ACTION NOT = SPACES
               MOVE SPACES     TO PRINT-REC
               MOVE ACTION     TO OB-ACT
               MOVE PRINT-REC  TO DISPLAY-REC
               ADD  1          TO RECNO
               MOVE "00"       TO SCREEN-STATUS
               WRITE SUBFILE   DISPLAY-REC FORMAT "RDSF"
                               INDIC ARE SCREEN-INDICATORS
                   INVALID KEY MOVE FILE-STAT TO FILE-STAT
               END-WRITE
               IF SCREEN-STATUS NOT = "00"
                   DISPLAY "SUBFILE 4 WRITE ERROR.  SCREEN-STATUS IS "
                               SCREEN-STATUS
                   GO TO END-OF-JOB.

           GO TO DBGET-LOOP.

       SUBF-CONT.
           IF RECNO = 0
      **********************************************************************
      **    MESSAGE 040/015:
      **  NO RECORDS FOUND
      **********************************************************************
               MOVE  40        TO CATREAD-MSG-SET
               MOVE  15        TO CATREAD-MSG-NUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER TO ERRMSG
               MOVE TRUE-VAL   TO IND(99)
               GO TO SHOWFORM.

           MOVE TP1            TO PCT.
           MOVE TP2            TO ARB.
           MOVE TP3            TO UCC.
           MOVE TP4            TO UCM.
           MOVE TP5            TO ERG.
           MOVE TP6            TO RHM.
           MOVE TPT            TO TCT.

           MOVE SPACES         TO DISPLAY-REC.
           ADD  1              TO RECNO.
           MOVE "00"           TO SCREEN-STATUS.
           WRITE SUBFILE       DISPLAY-REC FORMAT "RDSF"
                               INDIC ARE SCREEN-INDICATORS
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF SCREEN-STATUS NOT = "00"
               DISPLAY "SUBFILE WRITE ERROR.  SCREEN-STATUS IS "
                               SCREEN-STATUS
               GO TO END-OF-JOB.

           MOVE HEADER-RPT1    TO DISPLAY-REC.
           ADD  1              TO RECNO.
           MOVE "00"           TO SCREEN-STATUS.
           WRITE SUBFILE       DISPLAY-REC FORMAT "RDSF"
                               INDIC ARE SCREEN-INDICATORS
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF SCREEN-STATUS NOT = "00"
               DISPLAY "SUBFILE 2 WRITE ERROR.  SCREEN-STATUS IS "
                               SCREEN-STATUS
               GO TO END-OF-JOB.

           MOVE HEADER-RPT2    TO DISPLAY-REC.
           ADD  1              TO RECNO.
           MOVE "00"           TO SCREEN-STATUS.
           WRITE SUBFILE       DISPLAY-REC FORMAT "RDSF"
                               INDIC ARE SCREEN-INDICATORS
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF SCREEN-STATUS NOT = "00"
               DISPLAY "SUBFILE 2 WRITE ERROR.  SCREEN-STATUS IS "
                               SCREEN-STATUS
               GO TO END-OF-JOB.

           MOVE HEADER-RPT3    TO DISPLAY-REC.
           ADD  1              TO RECNO.
           MOVE "00"           TO SCREEN-STATUS.
           WRITE SUBFILE       DISPLAY-REC FORMAT "RDSF"
                               INDIC ARE SCREEN-INDICATORS
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF SCREEN-STATUS NOT = "00"
               DISPLAY "SUBFILE 2 WRITE ERROR.  SCREEN-STATUS IS "
                               SCREEN-STATUS
               GO TO END-OF-JOB.

           MOVE REPORT-CTRS    TO DISPLAY-REC.
           ADD  1              TO RECNO.
           MOVE "00"           TO SCREEN-STATUS.
           WRITE SUBFILE       DISPLAY-REC FORMAT "RDSF"
                               INDIC ARE SCREEN-INDICATORS
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF SCREEN-STATUS NOT = "00"
               DISPLAY "SUBFILE 2 WRITE ERROR.  SCREEN-STATUS IS "
                               SCREEN-STATUS
               GO TO END-OF-JOB.

           WRITE DISPLAY-REC   FORMAT "RDSB"
                               INDIC ARE SCREEN-INDICATORS.
           MOVE TRUE-VAL       TO IND(76).
           IF RECNO > 0
               MOVE TRUE-VAL   TO IND(75)
           ELSE
               MOVE NEG-VAL    TO IND(75).

           MOVE SCREEN-SHOW    TO DISPLAY-REC.
           WRITE DISPLAY-REC   FORMAT "SCSHOW"
                               INDIC ARE SCREEN-INDICATORS.
           READ DISPLAY-FILE   FORMAT "SCSHOW"
                               INDIC ARE SCREEN-INDICATORS.
           GO TO MAIN.

       LOAD-LOOP.
           MOVE EQPVAL(SUB)    TO EQPNUM OF EQP-EQUIPMENT.
           READ  EQP-EQUIPMENT INTO EQUIPMENT-DATA
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT = "00"
               MOVE SUB        TO CTR
               IF ZCTR1 = "0"  MOVE " " TO ZCTR1 END-IF
               MOVE SUBV(SUB)  TO SUBT
               MOVE PLACE      TO NUM(SUBT)
               MOVE EQP-EQUIP-NAME TO LOC(SUBT)
               IF LOC(SUBT) = "SKIP              "
                   MOVE SPACES TO LOC(SUBT)
               END-IF
           ELSE
               MOVE SUBV(SUB)  TO SUBT
               MOVE SPACES     TO NUM(SUBT)
               MOVE SPACES     TO LOC(SUBT).

       ERROR-PROC.
           MOVE MESSAGE-BUFFER TO ERRMSG.
           MOVE TRUE-VAL       TO IND(FIELD-NUMBER) IND(99).

       END-OF-JOB.
           CLOSE               DISPLAY-FILE.
           CLOSE               SAFETY-DATE.
           CLOSE               EQP-EQUIPMENT.
           GOBACK.

       999-CATREAD.
           MOVE SPACES         TO MESSAGE-BUFFER.
           CALL "CCATREAD"     USING CATREAD-PARMS.
           MOVE CATREAD-MSG-TEXT TO MESSAGE-BUFFER.

       999-CATREAD-EXIT.       EXIT.

