000200 IDENTIFICATION DIVISION.
000300 PROGRAM-ID.    TR6OPT.
000400 ENVIRONMENT DIVISION.
000500 CONFIGURATION SECTION.
000600 SOURCE-COMPUTER.   AS400.
000700 OBJECT-COMPUTER.   AS400.
       COPY SPECIALN IN COPYLIB.
000800 INPUT-OUTPUT SECTION.
000900 FILE-CONTROL.
           SELECT DISPLAY-FILE
               ASSIGN TO WORKSTATION-ZREPORT-SI
               ORGANIZATION IS TRANSACTION
               ACCESS IS SEQUENTIAL
               FILE STATUS IS DSPLY-STATUS
               CONTROL-AREA IS WS-CONTROL.
001000     SELECT R6FILE
001100         ASSIGN TO DATABASE-MCFPMR6FIL
               ORGANIZATION IS SEQUENTIAL
001200         ACCESS MODE IS SEQUENTIAL
               FILE STATUS IS R6-STATUS.
           SELECT WO-LAST-NUM-USED
               ASSIGN TO DATABASE-MCFPMM0800
               ORGANIZATION IS RELATIVE
               ACCESS MODE IS RANDOM
               RELATIVE KEY IS ARG-NO
               FILE STATUS IS WLNU-STATUS.
001500 DATA DIVISION.
001600 FILE SECTION.
       FD  DISPLAY-FILE
           LABEL RECORDS ARE OMITTED.
       01  DSPLY-REC                 PIC X(2000).
001700 FD  R6FILE
001800     RECORD CONTAINS 44 CHARACTERS
001900     DATA RECORD IS R6REC.
002000 01  R6REC                     PIC X(44).
       FD  WO-LAST-NUM-USED
           LABEL RECORDS ARE STANDARD.
       01  LAST-NUM-USED-REC.
           COPY DDS-ALL-FORMATS OF MCFPMM0800.
002300 WORKING-STORAGE SECTION.
002500 01  ARG-NO                    PIC 9(9).
002600 01  BEG-DATE-REC              PIC X(6).
002700 01  BEG-TIME-REC              PIC X(4).
       01  BLOWUP-BASE               PIC X(16).
       COPY CATREAD  IN COPYLIB.
       COPY CPYIND   IN COPYLIB.
       COPY CCRTFILE IN COPYLIB.
002900 01  DBPARAMETERS.             COPY DBPARMS OF COPYLIB.
       COPY TDATESUB OF COPYLIB.
003200 01  END-DATE-REC              PIC X(6).
003300 01  END-TIME-REC              PIC X(4).
002800 01  ERROR-BUFFER              PIC X(80).
       01  FILE-STATUSES.
           05  DSPLY-STATUS          PIC XX.
           05  R6-STATUS             PIC XX.
           05  WLNU-STATUS           PIC XX.
       COPY JCWAREA    IN COPYLIB.
       COPY IOFEEDBACK IN COPYLIB.
004200 01  LAST-WO-BUFF.             COPY MLASTWO OF COPYLIB.
       COPY LANGSUB OF COPYLIB.
005400 01  SCREEN-BUFFER.
005500     05 BEG-DATE               PIC X(6).
005600     05 BEG-TIME               PIC X(4).
005700     05 END-DATE               PIC X(6).
005800     05 END-TIME               PIC X(4).
005900     05 RESTRICTIONS OCCURS 5 TIMES.
006000        10 ZONE-R  OCCURS 1 TIMES
006100                               PIC X(4).
006200        10 EQPNUMS OCCURS 5 TIMES.
006300           15 EQPNUM-R         PIC X(6).
006400        10 CRAFTS  OCCURS 5 TIMES.
006500           15 CRAFT-R          PIC X(2).
           05  SCREEN-CMD-LINE       PIC X(79).
           05  SCREEN-ERR-LINE       PIC X(79).
       COPY DBSTAT OF COPYLIB.
006600 01  SUB1                      PIC S9(4) COMP-4.
006700 01  SUB2                      PIC S9(4) COMP-4.
       COPY TBLOWUP   IN COPYLIB.
       01  TRUE-VAL                  PIC 1 VALUE B"1".
       COPY VCOMLINK OF COPYLIB.
007400 COPY WSCONTROL IN COPYLIB.
007600 PROCEDURE DIVISION.
007700 START-PAR.
007800     PERFORM 1-HSK.
007900     PERFORM 6-MAIN THRU 6-MAIN-EXIT
008000         UNTIL VIEW-LASTKEY = 3.
008200
008400 2-EOJ.
           CLOSE DISPLAY-FILE.
008800     CLOSE R6FILE.
           CLOSE WO-LAST-NUM-USED.
           MOVE "053"       TO SETJCW-VALUE.
           MOVE 278         TO SETJCW-STARTING-POS.
           MOVE 3           TO SETJCW-LENGTH.
           CALL "SETJCW" USING SETJCW-VALUE,
                               SETJCW-STARTING-POS,
                               SETJCW-LENGTH,
                               SETJCW-STATUS.
           IF SETJCW-STATUS NOT = "00"
               MOVE "SETJCW ERROR" TO BU-DISPLAY-MSG
               PERFORM 998-BLOWUP.

           CALL "TRSCREN2".

009600     GOBACK.
009700
009900 1-HSK.
           MOVE "*CURLIB"     TO CCRTFILE-LIBRARY.
           MOVE "MCFPMR6FIL"  TO CCRTFILE-FILE.
           MOVE "0044"        TO CCRTFILE-RECORD-LENGTH.
           MOVE "00010"       TO CCRTFILE-NO-RECORDS.
           MOVE "00001"       TO CCRTFILE-INCREMENT-AMT.
           MOVE "03"          TO CCRTFILE-NO-INCREMENTS.
           CALL "CCRTFILE" USING CCRTFILE-LIBRARY,
                                 CCRTFILE-FILE,
                                 CCRTFILE-RECORD-LENGTH,
                                 CCRTFILE-NO-RECORDS,
                                 CCRTFILE-INCREMENT-AMT,
                                 CCRTFILE-NO-INCREMENTS,
                                 CCRTFILE-STATUS.
           IF CCRTFILE-STATUS NOT = "00"
               MOVE "CCRTFILE CREATE OF 'MCFPMR6FIL' FAILED"
                  TO BU-DISPLAY-MSG
               PERFORM 998-BLOWUP.
           OPEN I-O    DISPLAY-FILE.
014200     OPEN OUTPUT R6FILE.
           OPEN INPUT WO-LAST-NUM-USED.
013600     MOVE 1 TO ARG-NO.
           MOVE 0 TO COND-WORD VIEW-LASTKEY.
           READ WO-LAST-NUM-USED INTO LAST-WO-BUFF
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF WLNU-STATUS NOT = "00" MOVE 17 TO COND-WORD.
           IF COND-WORD = 17 MOVE 1 TO DATE-FLAG-SW.
           MOVE DATE-FLAG-SW TO DATE-CODE.
017100     MOVE SPACES TO SCREEN-BUFFER.

015600 6-MAIN.
           IF TRUE-VAL = INDS (99)
               MOVE ERROR-BUFFER TO SCREEN-ERR-LINE.
015700     IF VIEW-CFNAME = "R3"
015800           MOVE "R3A" TO VIEW-CFNAME
015900     ELSE
016000     MOVE "R3"  TO VIEW-CFNAME.
           MOVE SCREEN-BUFFER TO DSPLY-REC.
           PERFORM 99-SCREEN-WRITE.
           PERFORM 98-SCREEN-READ.
           MOVE DSPLY-REC TO SCREEN-BUFFER.
           IF VIEW-LASTKEY = 3 GO TO 6-MAIN-EXIT.
           MOVE 1 TO SUB1.
021500     IF BEG-DATE = SPACES
021600          MOVE "000000" TO BEG-DATE.
021700     MOVE BEG-DATE TO DATE-VALIDATE-IN.
021800     MOVE 3 TO DATE-MODE.
021900     CALL "TDATECK2" USING DATE-CHECK-AREA LANGUAGE-PARMS.
022000     IF DATE-RET-CODE = 1
022100         MOVE DATE-MSG TO ERROR-BUFFER
022200         MOVE TRUE-VAL TO INDS (56) INDS (99)
022400         GO TO 6-MAIN.
022500     MOVE DATE-DB TO BEG-DATE-REC.
022600     IF BEG-TIME NUMERIC
022700         MOVE BEG-TIME TO BEG-TIME-REC
022800     ELSE
022900     MOVE 35029 TO CATREAD-MSG-NUMBER
023100     PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
023200     MOVE TRUE-VAL TO INDS (57) INDS (99)
023400     GO TO 6-MAIN.
023600     IF END-DATE = SPACES
023700         MOVE "000000" TO END-DATE.
023800     MOVE END-DATE TO DATE-VALIDATE-IN.
023900     MOVE 3 TO DATE-MODE.
024000     CALL "TDATECK2" USING DATE-CHECK-AREA LANGUAGE-PARMS.
024100     IF DATE-RET-CODE = 1
024200         MOVE DATE-MSG TO ERROR-BUFFER
024300         MOVE TRUE-VAL TO INDS (58) INDS (99)
024500         GO TO 6-MAIN.
024600     MOVE DATE-DB TO END-DATE-REC.
024700     IF END-TIME NUMERIC
024800         MOVE END-TIME TO END-TIME-REC
024900     ELSE
025000     MOVE 35029 TO CATREAD-MSG-NUMBER
025200     PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
025300     MOVE TRUE-VAL TO INDS (59) INDS (99)
025500     GO TO 6-MAIN.
026100
026300 WRITE-DATES.
026400     STRING BEG-DATE-REC BEG-TIME-REC DELIMITED BY SIZE
026500        INTO R6REC.
026600     WRITE R6REC.
027100     STRING END-DATE-REC END-TIME-REC DELIMITED BY SIZE
027200        INTO R6REC.
027300     WRITE R6REC.
027800
028000 WRITE-OPTIONS.
028100     IF SUB1 > 5 OR ZONE-R (SUB1, 1) = SPACES
028200         GO TO 6-MAIN-EXIT.
028300     MOVE RESTRICTIONS (SUB1) TO R6REC.
028400     WRITE R6REC.
028900     ADD 1 TO SUB1.
029000     GO TO WRITE-OPTIONS.
029100
029200 6-MAIN-EXIT.    EXIT.
029400
       98-SCREEN-READ.
           READ DISPLAY-FILE FORMAT IS VIEW-CFNAME
               INDIC IS INDICS.
           ACCEPT IOFEEDBACK FROM I-O-FEEDBACK-AREA.
           MOVE ALL B"0" TO INDICS.
           IF DSPLY-STATUS NOT = "00"
               MOVE 3 TO VIEW-LASTKEY
           ELSE
           MOVE FUNCTION-NUM TO VIEW-LASTKEY.

       99-SCREEN-WRITE.
           WRITE DSPLY-REC FORMAT IS VIEW-CFNAME
               INDIC IS INDICS.
           MOVE ALL B"0" TO INDICS.

045400 998-BLOWUP.
045500     MOVE "TR6OPT" TO BU-PGM-NAME.
045600     CALL "TBLOWUP" USING BLOWUP-BASE BU-PGM-NAME STATUS-AREA
045700                      VIEW-COMAREA DUMMY-KSAM-STAT
045800                      BU-DISPLAY-MSG BU-DISPLAY-FLDS.

031300 999-CATREAD.
031400     MOVE SPACES TO ERROR-BUFFER.
031500     CALL "CCATREAD" USING CATREAD-PARMS.
           MOVE CATREAD-MSG-TEXT TO ERROR-BUFFER.
032100 999-CATREAD-EXIT.    EXIT.
