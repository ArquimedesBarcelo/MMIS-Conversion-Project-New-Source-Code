       IDENTIFICATION DIVISION.
       PROGRAM-ID.     TDELTKWM.
      *AUTHOR.         DAVE PLUM.
      *DATE-WRITTEN.   MARCH 1997.
      *REMARKS.
      ****************************************************************
      *D  TDELTKWM - KEYWORD/MODIFIER CLEAN UP PROGRAM
      *
      *   THIS PROGRAM DELETES THOSE KEYWORD/MODIFIERS WHICH EXIST
      *   IN THE VALID KEYWORD/MODIFIER FILE (MKEYADJ - MCFPCS3300),
      *   THAT DO NOT EXIST IN THE CODE-KEYWORD/MODIFIER FILE
      *   (DCODE - MCFPCS3400).  IN OTHER WORDS, WE ARE DELETING
      *   THOSE KEYWORD/MODIFIERS WHICH ARE ASSOCIATED WITH EXACTLY
      *   ZERO STOREROOM CODES.
      *
      *   THIS PROGRAM WILL BE ESPECIALLY HELPFUL TO THOSE PLANTS
      *   WHICH DO NOT USE THE CP1 LOCAL CODING FUNCTION TO CONTROL
      *   THEIR SET OF "VALID KEYWORD/MODIFIERS".  THESE PLANTS
      *   OBTAIN ALL OF THEIR STOREROOM CODES AND DESCRIPTIONS FROM
      *   THE MAINFRAME PAW00000 APPLICATION.  THIS PROGRAM WILL
      *   ALLOW THESE PLANTS TO LIMIT THEIR SET OF VALID
      *   KEYWORD/MODIFIERS TO THOSE THAT ARE ACTUALLY IN USE.
      ****************************************************************
       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.
       SOURCE-COMPUTER.  AS400.
       OBJECT-COMPUTER.  AS400.

       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT MKEYADJ-O
                  ASSIGN TO DATABASE-MCFLCS3301
                  ORGANIZATION IS INDEXED
                    ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                  FILE STATUS IS FILE-STATUS.

           SELECT DCODE-K-I
                  ASSIGN TO DATABASE-MCFLCS3401
                  ORGANIZATION IS INDEXED
                    ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                    WITH DUPLICATES
                  FILE STATUS IS FILE-STATUS.

       DATA DIVISION.
       FILE SECTION.
       FD  MKEYADJ-O
           LABEL RECORDS ARE STANDARD.
       01  MKEYADJ-REC-O.
           COPY DDS-MCRPCS3300  OF MCFLCS3301.

       FD  DCODE-K-I
           LABEL RECORDS ARE STANDARD.
       01  DCODE-K-REC-I.
           COPY DDS-MCRPCS3400  OF MCFLCS3401.

       WORKING-STORAGE SECTION.
       77  MCXCBLERR-SCOPE             PIC X(1)         VALUE "C".
       77  EOF-MKEYADJ                 PIC X(1)         VALUE "N".
       77  COUNT-MKEYADJ               PIC S9(9)        VALUE +0.
       77  COUNT-DELETES               PIC S9(9)        VALUE +0.
       77  DISPLAY-COUNT               PIC ZZZ,ZZZ,ZZ9.

       01  CURRENT-DATE.
           05  CURRENT-CC              PIC X(2)  VALUE SPACES.
           05  CURRENT-YYMMDD.
               10  CURRENT-YY          PIC X(2)  VALUE SPACES.
               10  CURRENT-MM          PIC X(2)  VALUE SPACES.
               10  CURRENT-DD          PIC X(2)  VALUE SPACES.

       01  CURRENT-TIME.
           05  CURRENT-HOUR            PIC X(2)  VALUE SPACES.
           05  CURRENT-MIN             PIC X(2)  VALUE SPACES.
           05  CURRENT-SEC             PIC X(2)  VALUE SPACES.

       01  DISPLAY-DATE.
           05  DISPLAY-CC              PIC X(2)  VALUE SPACES.
           05  DISPLAY-YY              PIC X(2)  VALUE SPACES.
           05     FILLER               PIC X(1)  VALUE "/".
           05  DISPLAY-MM              PIC X(2)  VALUE SPACES.
           05     FILLER               PIC X(1)  VALUE "/".
           05  DISPLAY-DD              PIC X(2)  VALUE SPACES.

       01  DISPLAY-TIME.
           05  DISPLAY-HOUR            PIC X(2)  VALUE SPACES.
           05     FILLER               PIC X(1)  VALUE ":".
           05  DISPLAY-MIN             PIC X(2)  VALUE SPACES.
           05     FILLER               PIC X(1)  VALUE ":".
           05  DISPLAY-SEC             PIC X(2)  VALUE SPACES.

       01  FILE-STATUS.
           05  FILE-STATUS-1           PIC X(1)  VALUE "0".
           05  FILE-STATUS-2           PIC X(1)  VALUE "0".

       COPY MKEYADJ    OF COPYLIB.

       COPY DATAB      OF COPYLIB.

       COPY TBLOWUP    OF COPYLIB.

       PROCEDURE DIVISION.
       0-MAINLINE.
           PERFORM 1-HSK.
           PERFORM 6-MAIN
              UNTIL EOF-MKEYADJ = "Y".
           PERFORM 2-EOJ.
           GOBACK.

       1-HSK.
           DISPLAY "--- BEGIN PROGRAM ---".
           PERFORM 11-GET-DISPLAY-DATE-TIME.
           DISPLAY " ".

           MOVE "C" TO MCXCBLERR-SCOPE.
           CALL "MCXCBLERR" USING MCXCBLERR-SCOPE.

           MOVE +0  TO  DISPLAY-COUNT.

           OPEN I-O   MKEYADJ-O.
           OPEN INPUT DCODE-K-I.

      *------ PREPARE TO READ THE FIRST RECORD FROM MKEYADJ
           MOVE LOW-VALUES TO KEYWORDADJ OF MKEYADJ-REC-O.
           START MKEYADJ-O KEY >= KEYWORDADJ OF MKEYADJ-REC-O
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE "START OF MKEYADJ FAILED" TO BU-DISPLAY-MSG
               PERFORM 2-BLOWUP.

      *------ READ THE FIRST RECORD FROM MKEYADJ
           PERFORM 3-READ-MKEYADJ.
           IF EOF-MKEYADJ = "Y"
               DISPLAY "FIRST READ OF MKEYADJ OF RESULTED IN "
               DISPLAY "END OF FILE.  NO DATA TO PROCESS.".

       11-GET-DISPLAY-DATE-TIME.
           ACCEPT CURRENT-YYMMDD FROM DATE.
           IF CURRENT-YY > "70"
               MOVE "19" TO CURRENT-CC
           ELSE
               MOVE "20" TO CURRENT-CC.

           ACCEPT CURRENT-TIME FROM TIME.

           MOVE CURRENT-CC    TO  DISPLAY-CC.
           MOVE CURRENT-YY    TO  DISPLAY-YY.
           MOVE CURRENT-MM    TO  DISPLAY-MM.
           MOVE CURRENT-DD    TO  DISPLAY-DD.

           MOVE CURRENT-HOUR  TO  DISPLAY-HOUR.
           MOVE CURRENT-MIN   TO  DISPLAY-MIN.
           MOVE CURRENT-SEC   TO  DISPLAY-SEC.

           DISPLAY "DATE: ", DISPLAY-DATE, " TIME: ", DISPLAY-TIME.

       2-BLOWUP.
           MOVE "TDELTKWM"  TO  BU-PGM-NAME.
           CALL "TBLOWUP" USING BASE, BU-PGM-NAME, STATUS-AREA,
              DUMMY-VIEW-AREA, FILE-STATUS, BU-DISPLAY-MSG,
              BU-DISPLAY-FLDS.

       2-EOJ.
           CLOSE MKEYADJ-O, DCODE-K-I.

           DISPLAY " ".
           MOVE COUNT-MKEYADJ  TO  DISPLAY-COUNT.
           DISPLAY "MKEYADJ RECORDS READ    = ", DISPLAY-COUNT.
           MOVE COUNT-DELETES  TO  DISPLAY-COUNT.
           DISPLAY "MKEYADJ RECORDS DELETED = ", DISPLAY-COUNT.

           DISPLAY " ".
           DISPLAY "--- END OF PGM ---".
           PERFORM 11-GET-DISPLAY-DATE-TIME.

       3-READ-MKEYADJ.
           READ MKEYADJ-O NEXT INTO BUF-MKEYADJ
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS = "00"
               ADD +1 TO COUNT-MKEYADJ
           ELSE
               IF FILE-STATUS = "10" OR "14" OR "46"
                   MOVE "Y" TO EOF-MKEYADJ
               ELSE
                   MOVE "READ MKEYADJ ERROR * 3-R-M" TO BU-DISPLAY-MSG
                   PERFORM 2-BLOWUP.

       3-READ-DCODE.
           MOVE KEYADJ-KEYWORD-MOD TO KEYWORDADJ OF DCODE-K-REC-I.
           START DCODE-K-I KEY = KEYWORDADJ OF DCODE-K-REC-I
              INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
                   NEXT SENTENCE
               ELSE
                   MOVE "READ DCODE ERROR * 3-R-D" TO BU-DISPLAY-MSG
                   PERFORM 2-BLOWUP.

       6-MAIN.
           PERFORM 3-READ-DCODE.
           IF FILE-STATUS-1 = "2"
               PERFORM 61-DELETE-MKEYADJ.

           PERFORM 3-READ-MKEYADJ.

       61-DELETE-MKEYADJ.
           ADD +1 TO COUNT-DELETES.
           DISPLAY "DELETING KWM: ", KEYADJ-KEYWORD-MOD.
           DELETE MKEYADJ-O
              INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE "DELETE MKEYADJ ERROR * 61-D-M"
                  TO BU-DISPLAY-MSG
               MOVE KEYADJ-KEYWORD  TO BU-DISPLAY-FLD (1)
               MOVE KEYADJ-MODIFIER TO BU-DISPLAY-FLD (2)
               PERFORM 2-BLOWUP.
