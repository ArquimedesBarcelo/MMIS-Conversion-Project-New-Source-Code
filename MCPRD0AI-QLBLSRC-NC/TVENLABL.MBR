001100 IDENTIFICATION DIVISION.
001200 PROGRAM-ID.          TVENLABL.
001300 AUTHOR.              BK DISMUKES.
001400 DATE-WRITTEN.        1/11/93.
001500 DATE-COMPILED.
001600*INSTALLATION.        GOODYEAR TIRE AND RUBBER - AKRON.
001700*REMARKS.
001700*D  ********************************************************
001700*D  *  PRINTS VENDOR LABELS.  CAN BE CALLED AS STANDALONE  *
001700*D  *  OR "f6" FROM MASTER VENDOR MENU.                    *
001700*D  *                                                      *
001700*D  *  TVENLABL USES FVENLABL FORM FILE TO AQUIRE USER     *
001700*D  *  CHOICES, SETS UP JOB STREAM AND CALLS SVENLABL      *
001700*D  *  IN BATCH.                                           *
001700*D  *                                                      *
001700*D  ********************************************************
001700*
004600 ENVIRONMENT DIVISION.
004700 CONFIGURATION SECTION.
004800 SOURCE-COMPUTER.  AS-400.
004900 OBJECT-COMPUTER.  AS-400.
       COPY SPECIALN IN COPYLIB.
005000 INPUT-OUTPUT SECTION.
005100 FILE-CONTROL.
           SELECT DISPLAY-FILE
               ASSIGN TO WORKSTATION-ZVENLABL-SI
               ORGANIZATION IS TRANSACTION
               ACCESS IS SEQUENTIAL
               FILE STATUS IS DISPLAY-STATUS
               CONTROL-AREA IS WS-CONTROL.

           SELECT CODEFILE ASSIGN TO DISK-CODEFILE.
005500
005600 DATA DIVISION.
005700 FILE SECTION.
      *------ FD STATEMENT AREA FOR IBM ONLY ------*
       FD  DISPLAY-FILE
           LABEL RECORDS ARE OMITTED.
       01  DISPLAY-REC        PIC X(1500).

       FD  CODEFILE
           RECORD CONTAINS 80 CHARACTERS.
       01  CODEFILE-REC       PIC X(80).

      *------ FD STATEMENT AREA FOR IBM ONLY ------*
007400
007500 WORKING-STORAGE SECTION.
007700 77  SUB                      PIC 9(2) VALUE 0.
007800
009800**************************************************************
009900**                                                          **
010000**        S U B P R O G R A M   A R E A S                   **
010100**                                                          **
010200**************************************************************
       01  FILE-STATUS.
           05  FILE-STATUS-1            PIC X  VALUE "0".
           05  FILE-STATUS-2            PIC X  VALUE "0".
       01  BASE                         PIC X(10).
       COPY DBSTAT     IN COPYLIB.
010300
010400 COPY TBLOWUP    IN COPYLIB.
       COPY TSHWRDFM   IN COPYLIB.
       COPY DISPDAT2   IN COPYLIB.
       COPY IOFEEDBACK IN COPYLIB.
       COPY CATREAD    IN COPYLIB.
       COPY CCRTFILE   IN COPYLIB.
       COPY CSTRMJB2   IN COPYLIB.
022300
022400 01  CONTROL-FIELDS.
022500     05  CF-PRINTER-OPTION            PIC X(2).
022600     05  CF-LABEL-SIZE                PIC X(1).
022900     05  CF-SORT-OPTION               PIC X(1).
023000     05  CF-SELECT-OPTION             PIC X(1).
023100     05  CF-LOW-VALUE                 PIC X(12).
023200     05  CF-HIGH-VALUE                PIC X(12).
010500
012800**************************************************************
012900**                                                          **
013000**                V I E W   W O R K                         **
013100**                                                          **
013200**************************************************************
013300
014700 01  PRINTCNTL                 PIC S9(4)    VALUE 0       BINARY.
014800 01  PAGECNTL                  PIC S9(4)    VALUE 49      BINARY.
014900 01  FNUM                      PIC S9(4)    VALUE ZERO    BINARY.
015000
       COPY VCOMAREA IN COPYLIB.

       COPY HMSGBUF IN COPYLIB.
       COPY FUNCTDEF IN COPYLIB.
020400
020500 01  FORMFILE.
020600     05  FORM-FNAME                PIC X(7)  VALUE "FVENLABL".
020700     05  FILLER                    PIC X     VALUE ".".
020800     05  FORM-GNAME.
020900        10  FORM-GNAME1           PIC X(5)  VALUE "FLANG".
021000        10  FORM-GNAME2           PIC X(3)  VALUE SPACES.
021100    05  FILLER                    PIC X(19) VALUE SPACES.
021200
021300 01  TERMFILENAME         PIC X(11) VALUE SPACES.
021400 01  FIELD-NUMBER         PIC S9(4) BINARY VALUE ZERO.
021500 01  SCREEN-BUFFLEN       PIC S9(4) BINARY VALUE 28.
021600 01  SCREEN-BUFFLEN2      PIC S9(4) BINARY VALUE 480.
021700
021800**************************************************************
021900**                                                          **
022000**                 S C R E E N   D A T A                    **
022100**                                                          **
022200**************************************************************
022300
022400 01  DE-FIELDS-1.
022500     05  DE-PRINTER-OPTION            PIC X(2).
022600     05  DE-LABEL-SIZE                PIC X(1).
022900     05  DE-SORT-OPTION               PIC X(1).
023000     05  DE-SELECT-OPTION             PIC X(1).
023100     05  DE-LOW-VALUE                 PIC X(10).
023200     05  DE-HIGH-VALUE                PIC X(10).
           05  DE-COMMAND-LINE-1            PIC X(79).
           05  DE-MESSAGE-LINE-1            PIC X(79).

023300 01  DE-FIELDS-2.
023400     05  ITEM-ENTRIES  OCCURS 48 TIMES.
023500         10  VEND-CODE-ITEM           PIC X(10).
           05  DE-COMMAND-LINE-2            PIC X(79).
           05  DE-MESSAGE-LINE-2            PIC X(79).
023600
026200 COPY LANGUAGE IN COPYLIB.
026300
026400
026500 PROCEDURE DIVISION.
026700 1-BEGIN-HOUSKEEP.
           PERFORM 9999-OPEN-STUFF.
029600
029700     MOVE SPACES TO CONTROL-FIELDS.
029700     MOVE SPACES TO DE-FIELDS-2.
029800     MOVE "LABELS1" TO VIEW-NFNAME.
029900     PERFORM 6100-DETERMINE-PARMS THRU 6190-DP-X.
           IF VIEW-LASTKEY = EXIT-PROGRAM
               GO TO 2000-EOJ.
           IF DE-SELECT-OPTION = "3"
               PERFORM 6400-SELECT-CODES THRU 6490-SC-X
               IF VIEW-LASTKEY = EXIT-PROGRAM
                   GO TO 2000-EOJ.

      *------ NOW STREAM THE JOB BASED ON THE ABOVE OPTIONS
           MOVE SPACES TO CSTRMJB2-PARMS.
           MOVE "BVENDTOP" TO CSTRM-TOP-FILE.
           MOVE "BVENDBOT" TO CSTRM-BOTTOM-FILE.
022500     MOVE DE-PRINTER-OPTION  TO  CF-PRINTER-OPTION.
022600     MOVE DE-LABEL-SIZE      TO  CF-LABEL-SIZE.
022900     MOVE DE-SORT-OPTION     TO  CF-SORT-OPTION.
023000     MOVE DE-SELECT-OPTION   TO  CF-SELECT-OPTION.
023100     MOVE DE-LOW-VALUE       TO  CF-LOW-VALUE.
023200     MOVE DE-HIGH-VALUE      TO  CF-HIGH-VALUE.
           MOVE CONTROL-FIELDS  TO CSTRM-RUN-CARD (1).
           IF DE-SELECT-OPTION = "3"
               MOVE "CODEFILE" TO CSTRM-DATA-FILE.
           CALL "CSTRMJB2" USING CSTRMJB2-PARMS, VIEW-COMAREA.
030300
       2000-EOJ.
           PERFORM 9999-CLOSE-STUFF.
           GOBACK.
031900
030400 2100-BLOWUP.
030700     MOVE "TVENLABL" TO BU-PGM-NAME.
030800     CALL "TBLOWUP" USING BASE, BU-PGM-NAME, STATUS-AREA,
030900         VIEW-COMAREA, FILE-STATUS, BU-DISPLAY-MSG,
031000         BU-DISPLAY-AREA.
031100
037500 6100-DETERMINE-PARMS.
           PERFORM 9951-GETNEXTFORM.
           PERFORM 9958-INITFORM.
           MOVE "00" TO DE-PRINTER-OPTION.
038500
038600 6100-SHOWFORM.
           PERFORM 9953-PUTBUFFER-A
           PERFORM 998-WRITE-SCREEN THRU 9989-WS-X.
           PERFORM 9952-GETBUFFER-A
           IF MESSAGE-BUFFER-1 NOT = SPACES
               PERFORM 9954-SETERROR
               GO TO 6100-SHOWFORM.

039800     IF VIEW-LASTKEY = EXIT-PROGRAM
039900         GO TO 6190-DP-X.
045000
045100     IF DE-SELECT-OPTION = "1"
045200         IF DE-LOW-VALUE > SPACES
045300             MOVE   4 TO LANG-SETNUM
045400             MOVE  31 TO LANG-MSGNUM
      *M ----- DO NOT SELECT LOW VALUES IF SELECTING ALL ITEMS
045500             PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
045600             MOVE 4  TO FIELD-NUMBER
045700             PERFORM 9954-SETERROR
045800             GO TO 6100-SHOWFORM.
045900
046000     IF DE-SELECT-OPTION = "1"
046100         IF DE-HIGH-VALUE > SPACES
046200             MOVE   4 TO LANG-SETNUM
046300             MOVE  30 TO LANG-MSGNUM
      *M ----- DO NOT SELECT HIGH VALUES IF SELECTING ALL ITEMS
046400             PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
046500             MOVE 4  TO FIELD-NUMBER
046600             PERFORM 9954-SETERROR
046700             GO TO 6100-SHOWFORM.
046800
046900     IF DE-SELECT-OPTION = "2"
047300         IF DE-HIGH-VALUE = SPACES
047400             MOVE   9 TO LANG-SETNUM
047500             MOVE  82 TO LANG-MSGNUM
      *M ----- IF SELECTING ON A RANGE, MUST ENTER HIGH VALUE
047600             PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
047700             MOVE 5  TO FIELD-NUMBER
047800             PERFORM 9954-SETERROR
047900             GO TO 6100-SHOWFORM.
048000
048100     IF DE-HIGH-VALUE < DE-LOW-VALUE
048200         MOVE   8 TO LANG-SETNUM
048300         MOVE   6 TO LANG-MSGNUM
      *M ----- HIGH VALUE IS LESS THAN LOW VALUE
048400         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
048500         MOVE 5  TO FIELD-NUMBER
048600         PERFORM 9954-SETERROR
048700         GO TO 6100-SHOWFORM.
048800
           IF DE-SORT-OPTION < "1" OR DE-SORT-OPTION > "2"
               MOVE 35 TO LANG-SETNUM
               MOVE 105 TO LANG-MSGNUM
      *M ----- INVALID ENTRY
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE 2 TO FIELD-NUMBER
               PERFORM 9954-SETERROR
               GO TO 6100-SHOWFORM.

           IF DE-SELECT-OPTION < "1" OR DE-SELECT-OPTION > "3"
               MOVE 35 TO LANG-SETNUM
               MOVE 105 TO LANG-MSGNUM
      *M ----- INVALID ENTRY
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE 3 TO FIELD-NUMBER
               PERFORM 9954-SETERROR
               GO TO 6100-SHOWFORM.

       6190-DP-X.
           EXIT.

048900 6400-SELECT-CODES.
049300     MOVE "LABELS2" TO VIEW-NFNAME.
           PERFORM 9951-GETNEXTFORM.
           PERFORM 9958-INITFORM.

       6400-SHOWFORM.
           PERFORM 9953-PUTBUFFER-B.
           PERFORM 998-WRITE-SCREEN THRU 9989-WS-X.
           IF MESSAGE-BUFFER-1 NOT = SPACES
               PERFORM 9954-SETERROR
               GO TO 6400-SHOWFORM.
           PERFORM 9952-GETBUFFER-B.

051900     IF VIEW-LASTKEY = EXIT-PROGRAM
052000         GO TO 6490-SC-X.
054900
      *------ CALL CCRTFILE TO CREATE A TEMPORARY FILE 'XXXXXXXXXX'
           MOVE "QTEMP"       TO CCRTFILE-LIBRARY.
           MOVE "CODEFILE"    TO CCRTFILE-FILE.
           MOVE "0080"        TO CCRTFILE-RECORD-LENGTH.
           MOVE "00100"       TO CCRTFILE-NO-RECORDS.
           MOVE "00001"       TO CCRTFILE-INCREMENT-AMT.
           MOVE "01"          TO CCRTFILE-NO-INCREMENTS.
           CALL "CCRTFILE" USING CCRTFILE-LIBRARY,
                                 CCRTFILE-FILE,
                                 CCRTFILE-RECORD-LENGTH,
                                 CCRTFILE-NO-RECORDS,
                                 CCRTFILE-INCREMENT-AMT,
                                 CCRTFILE-NO-INCREMENTS,
                                 CCRTFILE-STATUS.
           IF CCRTFILE-STATUS NOT = "00"
               MOVE "CCRTFILE CREATE OF 'CODEFILE' FAILED"
                  TO BU-DISPLAY-MSG
               PERFORM 2100-BLOWUP.

           OPEN OUTPUT CODEFILE.
           MOVE ZERO TO SUB.
           PERFORM 48 TIMES
               ADD 1 TO SUB
               IF VEND-CODE-ITEM (SUB) > SPACES
                   MOVE VEND-CODE-ITEM (SUB) TO CODEFILE-REC
                   WRITE CODEFILE-REC
               END-IF
           END-PERFORM.
           MOVE "0000000000" TO CODEFILE-REC.
           WRITE CODEFILE-REC.
           CLOSE CODEFILE.
       6490-SC-X.
           EXIT.
055200
       COPY DISPCALL IN COPYLIB.
       COPY DISPCAL2 IN COPYLIB.
       COPY HCATREAD IN COPYLIB.

       9951-GETNEXTFORM.
       9952-GETBUFFER-A.
           MOVE DISPLAY-REC TO DE-FIELDS-1.

       9952-GETBUFFER-B.
           MOVE DISPLAY-REC TO DE-FIELDS-2.

       9953-PUTBUFFER-A.
           MOVE DE-FIELDS-1 TO DISPLAY-REC.

       9953-PUTBUFFER-B.
           MOVE DE-FIELDS-2 TO DISPLAY-REC.

       9954-SETERROR.
           MOVE B"1" TO IND (99).
           MOVE B"1" TO IND (FIELD-NUMBER).
           MOVE MESSAGE-BUFFER TO DE-MESSAGE-LINE-1,
                                  DE-MESSAGE-LINE-2.

       9955-CLEAR-FORM.
           MOVE SPACES TO DE-FIELDS-1, DE-FIELDS-2,
             MESSAGE-BUFFER.

       9956-PUTWINDOW.
       9957-FIELDEDITS.
       9958-INITFORM.
       9959-SHOWFORM.
       9960-SETKEYLABEL.
       9961-AUTOREAD.
       9962-OPENFORM.
       9963-CLOSEFORM.
       9964-FINISHFORM.

       9999-OPEN-STUFF.
           OPEN I-O   DISPLAY-FILE.

       9999-CLOSE-STUFF.
           CLOSE DISPLAY-FILE.
062600
