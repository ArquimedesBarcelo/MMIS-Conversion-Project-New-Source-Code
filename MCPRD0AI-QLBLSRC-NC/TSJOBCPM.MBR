       IDENTIFICATION DIVISION.
       PROGRAM-ID.    TSJOBCPM.
       AUTHOR.        R L ENSMINGER.
       INSTALLATION.  GTR.
       DATE-COMPILED.
       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.
       SOURCE-COMPUTER. IBM-AS400.
       OBJECT-COMPUTER. IBM-AS400.
       SPECIAL-NAMES. I-O-FEEDBACK IS I-O-FEEDBACK-AREA
                      LOCAL-DATA IS LOCAL-DATA-AREA.
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT DISPLAY-FILE
               ASSIGN TO WORKSTATION-ZSUFFIX-SI
               ORGANIZATION IS TRANSACTION
               ACCESS IS SEQUENTIAL
               FILE STATUS IS DSPLY-STATUS
               CONTROL-AREA IS WS-CONTROL.
           SELECT FILE1
               ASSIGN TO DATABASE-MCFLMM3601
               ORGANIZATION IS INDEXED
               ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY WITH DUPLICATES
               FILE STATUS IS FILE-STATUS.
           SELECT FILE2
               ASSIGN TO DATABASE-MCFLMM1801
               ORGANIZATION IS INDEXED
               ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY WITH DUPLICATES
               FILE STATUS IS FILE-STATUS.
           SELECT FILE3
               ASSIGN TO DATABASE-MCFLMM1101
               ORGANIZATION IS INDEXED
               ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
               FILE STATUS IS FILE-STATUS.
       DATA DIVISION.
       FILE SECTION.
       FD  DISPLAY-FILE
           LABEL RECORDS ARE OMITTED.
       01  DSPLY-REC               PIC X(2000).
       FD  FILE1
           LABEL RECORDS ARE STANDARD.
       01  REC1.
           COPY DDS-ALL-FORMATS OF MCFLMM3601.
       FD  FILE2
           LABEL RECORDS ARE STANDARD.
       01  REC2.
           COPY DDS-ALL-FORMATS OF MCFLMM1801.
       FD  FILE3
           LABEL RECORDS ARE STANDARD.
       01  REC3.
           COPY DDS-ALL-FORMATS OF MCFLMM1101.
       WORKING-STORAGE SECTION.
       COPY CATREAD OF COPYLIB.
       COPY CPYIND  OF COPYLIB.
       01  DSPLY-STATUS            PIC XX.
       01  ERROR-SW                PIC X.
       01  FILE-STATUS             PIC XX.
       01  FLAG-FIELD              PIC S9(4) COMP-4.
       01  FIELDNUM                PIC S9(4) COMP-4.
       01  FATAL-ERR-SW            PIC X.
       01  INTERVAL                PIC 99.
       COPY IOFEEDBACK OF COPYLIB.
       01  JOB-CMP-SEQ2            PIC 9999.
       01  JOBPLAN-KEY1.
           05 JOBP-WO-NO1          PIC X(10).
           05 JOBP-SEQ-NO1         PIC 999.
           05 FILLER               PIC X.
       01  JOBPLAN-KEY2.
           05 JOBP-WO-NO2          PIC X(10).
           05 JOBP-SEQ-NO2         PIC 999.
           05 FILLER               PIC X.
       01  JOBPLAN-FILE1.
           COPY DJOBBANK OF COPYLIB.
       01  JOBPLAN-FILE2.
           COPY DJOBPLAN OF COPYLIB.
       01  JOBPLAN-FILE3.
           COPY DJOBBANK OF COPYLIB.
       01  LEVEL-FIELD             PIC S9(4) COMP-4.
       01  STOP-READ               PIC X.
       01  SS-FIELD                PIC S9(4) COMP-4.
       01  SCREEN-DATA.
           05 GENERIC              PIC X(10).
           05 MASTER-WORK          PIC X(10).
           05 SEQUENCES.
             10 SEQUENCE-DATA OCCURS 10 TIMES.
                15 OLD-SEQ         PIC X(3).
                15 NEW-SEQ         PIC X(3).
                15 DESCRIPTION     PIC X(36).
                15 DWN             PIC X(3).
                15 CRAFT           PIC X(2).
                15 MEN             PIC X(2).
                15 HOURS           PIC X(3).
                15 LEVEL           PIC X(2).
                15 FLAG            PIC X(2).
                15 SUBSYSTEM       PIC X(4).
             10 SCREEN-CMD-LINE    PIC X(79).
             10 SCREEN-ERR-LINE    PIC X(79).
       01  S1                      PIC S9(4) COMP-4.
       01  S2                      PIC S9(4) COMP-4.
       01  S3                      PIC S9(4) COMP-4.
       01  S4                      PIC S9(4) COMP-4.
       01  TRUE-VAL                PIC 1 VALUE B"1".
       COPY VCOMLINK  OF COPYLIB.
       01  WO-PLANNED-DATA.
           COPY DWOPLAN OF COPYLIB.
       COPY WSCONTROL OF COPYLIB.
       LINKAGE SECTION.
       01  DBPARAMETERS.
           COPY DBPARMS OF COPYLIB.
       01  SEQ-INT                 PIC X(2).
       01  MASTER-NAMES.
           05 MASTER-NAME OCCURS 15 TIMES
                                   PIC X(10).
       01  PLANNED-WO-NUM          PIC X(10).
       PROCEDURE DIVISION USING    DBPARAMETERS
                                   SEQ-INT
                                   MASTER-NAMES
                                   PLANNED-WO-NUM.
       START-PROGRAM.
           PERFORM 1-HSK.
           PERFORM 6-MAIN VARYING S1 FROM 1 BY 1 UNTIL
               S1 > 15 OR MASTER-NAME (S1) = SPACES.
           PERFORM UPDATE-MASTER.

       2-EOJ.
           CLOSE DISPLAY-FILE.
           CLOSE FILE1 FILE2 FILE3.
           GOBACK.

       1-HSK.
           OPEN I-O   DISPLAY-FILE.
           OPEN INPUT FILE1.
           OPEN I-O FILE2 FILE3.
           MOVE SEQ-INT TO INTERVAL.
           MOVE SPACES TO JOBPLAN-KEY1 JOBPLAN-KEY2.
           MOVE 0 TO JOB-CMP-SEQ2.
           MOVE 0 TO S2.
           MOVE SPACES TO SCREEN-DATA.

       UPDATE-MASTER.
           MOVE PLANNED-WO-NUM TO WONUM.
           READ FILE3 INTO WO-PLANNED-DATA.
           IF FILE-STATUS NOT = "00"
             DISPLAY "ERROR: FILE STATUS = "
                     FILE-STATUS
                     " ON READ OF FILE3"
             GO TO 2-EOJ.

           MOVE JOB-CMP-SEQ2 TO LAST-JOBPLAN-SEQ-1-3.

           REWRITE REC3 FROM WO-PLANNED-DATA.
           IF FILE-STATUS NOT = "00"
             DISPLAY "ERROR: FILE STATUS = "
                     FILE-STATUS
                     " ON WRITE TO FILE3"
             GO TO 2-EOJ.

       6-MAIN.
           MOVE MASTER-NAME (S1) TO JOBP-WO-NO1.
           MOVE 0 TO JOBP-SEQ-NO1.
           MOVE "N" TO STOP-READ.
           PERFORM 61-COPY-JOBPLAN THRU 61-CJ-EXIT
            UNTIL STOP-READ = "Y".

           PERFORM GET-PM-DATA THRU GET-PM-EXIT.

           MOVE 0 TO S2.

           MOVE SPACES TO SEQUENCES.

       61-COPY-JOBPLAN.
           MOVE JOBPLAN-KEY1 TO GJOBPSEQ.

           START FILE1
            KEY IS GREATER THAN GJOBPSEQ.
           IF FILE-STATUS NOT = "00"
             MOVE "Y" TO STOP-READ
             GO TO 61-CJ-EXIT.

           READ FILE1 NEXT RECORD INTO JOBPLAN-FILE1.
           IF FILE-STATUS NOT = "00"
             MOVE "Y" TO STOP-READ
             GO TO 61-CJ-EXIT.

           IF JOBPLAN-NAME OF JOBPLAN-FILE1 NOT = MASTER-NAME (S1)
             MOVE "Y" TO STOP-READ
             GO TO 61-CJ-EXIT.

           ADD INTERVAL TO JOB-CMP-SEQ2.

           IF JOB-CMP-SEQ2 > 998
             SUBTRACT INTERVAL FROM JOB-CMP-SEQ2
             PERFORM GET-PM-DATA THRU GET-PM-EXIT
             PERFORM UPDATE-MASTER
             GO TO 2-EOJ.

           ADD 1 TO S2.
           IF S2 > 10
             PERFORM GET-PM-DATA THRU GET-PM-EXIT
             MOVE 1 TO S2
             MOVE SPACES TO SEQUENCES.

           MOVE JOBPLAN-SEQ-NO-1-3 OF JOBPLAN-FILE1
                                   TO OLD-SEQ (S2).
           MOVE JOB-CMP-SEQ2       TO JOBP-SEQ-NO2.
           MOVE JOBP-SEQ-NO2       TO NEW-SEQ (S2).
           MOVE JOBPLAN-DESCRIP    OF JOBPLAN-FILE1
                                   TO DESCRIPTION (S2).
           MOVE JOBPLAN-DT         OF JOBPLAN-FILE1
                                   TO DWN (S2).
           MOVE JOBPLAN-CRAFT      OF JOBPLAN-FILE1
                                   TO CRAFT (S2).
           MOVE JOBPLAN-MEN        OF JOBPLAN-FILE1
                                   TO MEN (S2).
           MOVE JOBPLAN-EST        OF JOBPLAN-FILE1
                                   TO HOURS (S2).

           MOVE JOBPLAN-SEQ-NO-1-3 OF JOBPLAN-FILE1 TO JOBP-SEQ-NO1.

       61-CJ-EXIT.
           EXIT.

       GET-PM-DATA.
           IF OLD-SEQ (1) = SPACES GO TO GET-PM-EXIT.

           MOVE MASTER-NAME (S1) TO GENERIC.
           MOVE PLANNED-WO-NUM   TO MASTER-WORK.

       READ-PM-DATA.
           MOVE "FSJOBCPM" TO VIEW-CFNAME.
           MOVE SCREEN-DATA TO DSPLY-REC.
           PERFORM 99-SCREEN-WRITE.
           PERFORM 98-SCREEN-READ.
           MOVE DSPLY-REC TO SCREEN-DATA.
           IF VIEW-LASTKEY = 3 GO TO 2-EOJ.

           MOVE "N" TO ERROR-SW.
           MOVE 10  TO LEVEL-FIELD.
           MOVE 11  TO FLAG-FIELD.
           MOVE 12  TO SS-FIELD.

           PERFORM CHECK-LEVELS THRU LEVEL-EXIT VARYING S3 FROM 1 BY 1
           UNTIL S3 > 10 OR OLD-SEQ (S3) = SPACES OR ERROR-SW = "Y".

           IF ERROR-SW = "Y"
             GO TO READ-PM-DATA.

           PERFORM ADD-MASTER-JOBPLAN THRU ADD-MASTER-EXIT VARYING S3
           FROM 1 BY 1 UNTIL S3 > 10 OR OLD-SEQ (S3) = SPACES.

       GET-PM-EXIT.
           EXIT.

       CHECK-LEVELS.
           IF LEVEL (S3) NOT NUMERIC
             MOVE "Y" TO ERROR-SW
             MOVE 35086 TO CATREAD-MSG-NUMBER
             CALL "CCATREAD" USING CATREAD-PARMS
             MOVE CATREAD-MSG-TEXT TO SCREEN-ERR-LINE
             MOVE TRUE-VAL TO INDS (LEVEL-FIELD) INDS (99)
             GO TO LEVEL-EXIT.

           IF FLAG (S3) NOT NUMERIC
             MOVE "Y" TO ERROR-SW
             MOVE 00022 TO CATREAD-MSG-NUMBER
             CALL "CCATREAD" USING CATREAD-PARMS
             MOVE CATREAD-MSG-TEXT TO SCREEN-ERR-LINE
             MOVE TRUE-VAL TO INDS (FLAG-FIELD) INDS (99)
             GO TO LEVEL-EXIT.

           IF SUBSYSTEM (S3) NOT NUMERIC
             MOVE "Y" TO ERROR-SW
             MOVE 27016 TO CATREAD-MSG-NUMBER
             CALL "CCATREAD" USING CATREAD-PARMS
             MOVE CATREAD-MSG-TEXT TO SCREEN-ERR-LINE
             MOVE TRUE-VAL TO INDS (SS-FIELD) INDS (99)
             GO TO LEVEL-EXIT.

           IF FLAG (S3) = "00"
             MOVE "99" TO FLAG (S3).

           IF LEVEL (S3) > "00"
             NEXT SENTENCE
           ELSE
             MOVE "Y" TO ERROR-SW
             MOVE 35086 TO CATREAD-MSG-NUMBER
             CALL "CCATREAD" USING CATREAD-PARMS
             MOVE CATREAD-MSG-TEXT TO SCREEN-ERR-LINE
             MOVE TRUE-VAL TO INDS (LEVEL-FIELD) INDS (99)
             GO TO LEVEL-EXIT.

           IF FLAG (S3) > LEVEL (S3)
             NEXT SENTENCE
           ELSE
             MOVE "Y" TO ERROR-SW
             MOVE 35086 TO CATREAD-MSG-NUMBER
             CALL "CCATREAD" USING CATREAD-PARMS
             MOVE CATREAD-MSG-TEXT TO SCREEN-ERR-LINE
             MOVE TRUE-VAL TO INDS (LEVEL-FIELD) INDS (99)
             GO TO LEVEL-EXIT.

           ADD 3 TO LEVEL-FIELD
                    FLAG-FIELD
                    SS-FIELD.

       LEVEL-EXIT.
           EXIT.

       ADD-MASTER-JOBPLAN.
           MOVE OLD-SEQ (S3) TO JOBP-SEQ-NO1.
           MOVE JOBPLAN-KEY1 TO GJOBPSEQ.

           START FILE1
            KEY IS = GJOBPSEQ.
           IF FILE-STATUS  NOT = "00"
             GO TO ADD-MASTER-EXIT.

       ADD-LOOP.
           READ FILE1 NEXT RECORD INTO JOBPLAN-FILE3.
           IF FILE-STATUS NOT = "00"
             GO TO ADD-MASTER-EXIT.

           IF JOBPLAN-SEQ-NO-1-3 OF JOBPLAN-FILE3 NOT = OLD-SEQ (S3)
             GO TO ADD-MASTER-EXIT.

           MOVE JOBPLAN-FILE3  TO JOBPLAN-FILE2.
           MOVE PLANNED-WO-NUM TO JOBPLAN-WO-NO.
           MOVE NEW-SEQ   (S3) TO JOBPLAN-SEQ-NO OF JOBPLAN-FILE2.
           MOVE LEVEL     (S3) TO JOBP-LEVEL.
           MOVE FLAG      (S3) TO JOBP-FLAG.
           MOVE SUBSYSTEM (S3) TO JOBP-SS.

           WRITE REC2 FROM JOBPLAN-FILE2.
           IF FILE-STATUS NOT = "00"
             DISPLAY "ERROR: FILE STATUS = "
                     FILE-STATUS
                     " ON WRITE TO FILE2"
             GO TO 2-EOJ.

           GO TO ADD-LOOP.

       ADD-MASTER-EXIT.
           EXIT.

       98-SCREEN-READ.
           READ DISPLAY-FILE FORMAT IS VIEW-CFNAME
               INDIC IS INDICS.
           ACCEPT IOFEEDBACK FROM I-O-FEEDBACK-AREA.
           MOVE ALL B"0" TO INDICS.
           IF DSPLY-STATUS NOT = "00"
               MOVE 3 TO VIEW-LASTKEY
           ELSE
           MOVE FUNCTION-NUM TO VIEW-LASTKEY.

       99-SCREEN-WRITE.
           WRITE DSPLY-REC FORMAT IS VIEW-CFNAME
               INDIC IS INDICS.
           MOVE ALL B"0" TO INDICS.
