           05  DW-YY                   PIC 9(4).
           05  DW-DDD                  PIC 9(3).
013700
013800*----------  KEEPS TRACK OF CORRECT YEAR IF DATE WANTED BECOMES
013900*            GREATER THAN 365 JULIAN DAYS
014000 01  J-CURRENT-YY                PIC S9(4)  COMP VALUE ZEROS.
014100
014200 01  PAGE-NUM                    PIC 9(4)   VALUE 1.
014300 01  LINE-CTR                    PIC 9(4)   VALUE 99.
014400
014500 01  CUR-DATE.
014600     05  YY                  PIC XX.
014700     05  MM                  PIC XX.
014800     05  DD                  PIC XX.
014900 01  CUR-DATE-9  REDEFINES  CUR-DATE.
015000     05  YY-9                PIC 99.
015100     05  MM-9                PIC 99.
015200     05  DD-9                PIC 99.
015300
015400 01  MESSAGE-AREA.
015500     05  NO-SORTED-RECORDS      PIC X(33) VALUE
015600                             "ZERO RECORDS QUALIFIED FOR REPORT".
015700
015800 01  SWITCH-AREA.
015900     05  END-OF-INPUT-FILE      PIC X VALUE "N".
016000         88  ALL-INPUT-RECORDS-PROCESSED       VALUE "Y".
016100     05  END-OF-SORT-FILE       PIC X VALUE "N".
016200         88  ALL-SORTED-RECORDS-PROCESSED      VALUE "Y".
016400
016500*----------  FUTURE DATE TO COMPARE EXPIRATION DATES AGAINST
016600 01  DATE-COMPARE-CN.
           05  CC-COMPARE          PIC XX.
016700     05  YY-COMPARE          PIC XX.
016800     05  MM-COMPARE          PIC XX.
016900     05  DD-COMPARE          PIC XX.
017000
017800**************************************************************
017900*                 C A L L E D  R O U T I N E S               *
018000**************************************************************
      *----------  DATE ROUTINE JULGREG
       01  GREGDATE.
           05  GREGDATE-CC             PIC X(2).
           05  GREGDATE-YMD            PIC X(6).
       01  JULDATE.
           05  JULYEAR                 PIC 9(4).
           05  JULDAY                  PIC 9(3).
       01  DAYDIGIT                    PIC X.
       01  LEAPYEAR                    PIC X.
018800
018900*------ TBLOWUP (PRINTS ERRORS TO AN ERROR FILE "BLOWUP.PUB" AND)
019000*------ (ABORTS PROGRAM.  RUN XBLPRT.OBJECT TO READ ERRORS.)
019100 01  BU-DISPLAY-MSG              PIC X(60)   VALUE SPACES.
019200 01  BU-PGM-NAME                 PIC X(8)    VALUE "TBKREXP".
019300 01  BU-DISPLAY-AREA             PIC X(110)  VALUE ALL "0".
019400 01  BU-DISPLAY-FLDS REDEFINES BU-DISPLAY-AREA.
019500     05  BU-DISPLAY-LINE OCCURS 5 TIMES.
019600         10  BU-DISPLAY-FLD      PIC X(14).
019700         10  BU-DISPLAY-FLD9     PIC S9(8).
019900 01  VIEW-COMAREA.
020000     05  FILLER                  PIC X(118)  VALUE ALL "0".
020100     05  FILLER                  PIC S9(4)   COMP VALUE 9999.
020300
021200 01  SPOOL-LIMIT                PIC S9(8)    VALUE 50000  COMP.
021300 01  SPOOL-FEQ-NAME             PIC X(8)     VALUE "SXXXXXXX".
021400
021500
021600*----------  E S C A P E   S E Q U E N C E S
021700 01  COMPRESS-PRINT             PIC X(8).
021800 01  NORMAL-PRINT               PIC X(8).
021900 01  ESC-TEXT-61                PIC X(8).
022000 01  ESC-TEXT-60                PIC X(8).
022100
022200 COPY ESCNAM2 OF COPYLIB.
       COPY CCHKOBJ OF COPYLIB.
       COPY OVRPFDATA IN COPYLIB.
022300 COPY THDPRTA OF COPYLIB.
022400 COPY TDATECHK OF COPYLIB.
022500**************************************************************
022600*                    D A T A  B A S E                        *
022700**************************************************************
022800 COPY DATAB OF COPYLIB.
022900 01  DATA-BASE-VALUES.
023000     03  CODE-ARG                PIC X(8)    VALUE SPACES.
023100     03  VEN-ARG                 PIC X(10)   VALUE SPACES.
023200     03  BUYER-ARG               PIC X(4)    VALUE SPACES.
023300     03  PO-ARG                  PIC X(14)   VALUE SPACES.
023400
024700 COPY DVENDOR OF COPYLIB.
       COPY DPOITEM OF COPYLIB.
024900 COPY DPORECD OF COPYLIB.
025200 COPY MBUYER  OF COPYLIB.
025400 COPY DDESC   OF COPYLIB.
       LINKAGE SECTION.
       COPY THDPRTB OF COPYLIB.
017100*----------  ACCEPT VALUES FROM JOB STREAM
017200 01  ACCEPT-DATA.
017300     05  OPTION-REPORT               PIC 9(2).
017400     05  OPTION-DAYS-XX              PIC X(3).
017500     05  OPTION-DAYS REDEFINES OPTION-DAYS-XX    PIC 9(3).
017600     05  OPTION-SORT                 PIC 9.
017700     05  FILLER                      PIC X(74).
025500**************************************************************
025600**************************************************************
025700*        P R O C E D U R E        D I V I S I O N            *
025800*                                                            *
025900*    READ THE USER OPTIONS TO DETERMINE THE RANGE OF REQ-    *
026000*    UIREMENT ORDERS TO RETRIEVE FROM THE DATASET DPORECD.   *
026100*    SORT THE REQUIREMENT NUMBERS IN THE ORDER THE USER      *
026200*    REQUESTED AND PRINT THE REPORT TO DISC.                 *
026300*                                                            *
026400*       SORT OPTIONS ARE:                                    *
026500*            1 = SORTED BY REQUIREMENT NUMBER                *
026600*            2 = SORTED BY EXPIRATION DATE                   *
026700*            3 = SORTED BY VENDOR CODE                       *
026800**************************************************************
026900**************************************************************
027000 PROCEDURE DIVISION USING HD-ROUTE-DATA ACCEPT-DATA.
       00-MAIN-SECTION SECTION.
027200 00-MAIN.
027300     PERFORM 100-READ-OPTIONS THRU 199-EXIT.
027400
027500     IF OPTION-SORT = 1
027600        SORT SORT-FILE  ASCENDING KEY           SORT-REQNUM
027700             INPUT  PROCEDURE IS 200-PROCESS-REQS
027800             OUTPUT PROCEDURE IS 300-PRINT-REPORT
027900     ELSE
028000       IF OPTION-SORT = 2
028100          SORT SORT-FILE  ASCENDING KEY         SORT-DATE-CN
028200             INPUT  PROCEDURE IS 200-PROCESS-REQS
028300               OUTPUT PROCEDURE IS 300-PRINT-REPORT
028400     ELSE
028500       IF OPTION-SORT = 3
028600          SORT SORT-FILE  ASCENDING KEY         SORT-VENCODE
028700             INPUT  PROCEDURE IS 200-PROCESS-REQS
028800               OUTPUT PROCEDURE IS 300-PRINT-REPORT.
028900
029000
029100*----------  PRINT REPORT, CLOSE FILES, AND QUIT
029200     IF PAPER-IS-132-COLS
029300         NEXT SENTENCE
029400     ELSE
029500         WRITE PRT-REC FROM NORMAL-PRINT AFTER ADVANCING 0
029600         WRITE PRT-REC FROM ESC-TEXT-60 AFTER ADVANCING 0.
030200
030300     CLOSE PRINT-FILE.
030400     CLOSE DVENDOR-I DPORECD-I MBUYER-I.
030500     GOBACK.
030600*************************************************************
030700*************************************************************
030800*     THE COMPARE DATE IS COMPUTED AS FOLLOWS:              *
030900*  THE NUMBER OF DAYS MUST BE ADDED TO TODAYS JULIAN DATE   *
031000*  AND THE YEAR, MONTH, AND DAY MUST BE COMPUTED FROM THAT  *
031100*  TO DETERMINE THE COMPARE DATE.  THIS COMPARE DATE IS THE *
031200*  THE FINAL EXPIRATION DATE WANTED.  ANY REQS FOUND      *
031300*  THAT HAVE AN EXPIRATION DATE THAT IS BEFORE THIS COMPARE *
031400*  DATE WILL BE PRINTED ON THE REPORT.                      *
031500*************************************************************
031600*************************************************************
031700 100-READ-OPTIONS.
031800     CALL "TESCSEQ" USING ESC-NAME.
031900     MOVE CHAR-1636PI     TO COMPRESS-PRINT.
032000     MOVE CHAR-10PI       TO NORMAL-PRINT.
032100     MOVE TEXT-LENGTH-61 TO ESC-TEXT-61.
032200     MOVE TEXT-LENGTH-60 TO ESC-TEXT-60.
032600
033300*----------  PRINT HEADER PAGE
078400*----------  OPEN OUTPUT FILE
           MOVE HD-SPOOLER-NUMBER TO OVRPRTF-TOFILE-NUM.
           MOVE "*YES"       TO OVRPRTF-SHARED.
028100     MOVE HD-NO-OF-COPIES TO OVRPRTF-COPIES.
           MOVE "MCPRT"      TO OVRPRTF-FILE.
           PERFORM 996-OVERRIDE-PRINT-FILE.
021100     OPEN OUTPUT PRINT-FILE.
033500     MOVE "DHDR76.PUB" TO HD-FILE-NAME.
033600     CALL "THDPRT2" USING HD-RET-CODE, HD-FILE-NAME,
033700        FNUM, HD-ROUTE-DATA, ESC-NAME.
033800     IF PAPER-IS-132-COLS
033900          NEXT SENTENCE
034000     ELSE
034100         WRITE PRT-REC FROM COMPRESS-PRINT AFTER ADVANCING 0
034200         WRITE PRT-REC FROM ESC-TEXT-61 AFTER ADVANCING 0.
034300     IF HD-RET-CODE NOT = 0
034400         DISPLAY "THDRPT ERROR".
034600*----------  SET UP HEADING LITERALS FOR REPORT
034700     MOVE "R E Q U I R E M E N T   E X P I R A T I O N   R E P O R"&
034800-             " T" TO HEAD1-TITLE.
034900     MOVE "  QR5 - "             TO HEAD2-PROGRAM.
035000     MOVE 1 TO DATE-MODE.
035100     CALL "TDATECHK" USING DATE-CHECK-AREA.
035200     MOVE DATE-SLASH-OUT TO HEAD2-DATE.
035300     MOVE "PAGE "                TO HEAD2-PAGE.
035400     MOVE "for   "               TO HEAD3-FOR.
035500     MOVE OPTION-DAYS            TO HEAD3-DAYS-NUM.
035600     MOVE "   days"              TO HEAD3-DAYS.
035700     MOVE "  REQUIREMENT  "      TO HEAD4-REQ.
035800     MOVE "EXPIRATION  "         TO HEAD4-EXP.
035900     MOVE "VENDOR CODE"          TO HEAD4-VENCODE.
036000     MOVE "BUYER CODE"           TO HEAD4-BUYER-CODE.
036100     MOVE "NUMBER OF ITEMS"      TO HEAD4-NUM.
           MOVE SPACES                 TO HEAD4-NUM.
036200     MOVE "  NUMBER  "           TO HEAD5-NUMBER.
036300     MOVE "        DATE"         TO HEAD5-DATE.
036400     MOVE "     VENDOR NAME"     TO HEAD5-VEN-NAME.
036500     MOVE "BUYER NAME"           TO HEAD5-BUYER-NAME.
036600     MOVE " ON REQUIREMENT"      TO HEAD5-BLANKET.
           MOVE SPACES                 TO HEAD5-BLANKET.
036700
036800     MOVE SPACES TO DATE-COMPARE-CN.
036900     MOVE DATE-YMD-OUT TO CUR-DATE.
037000
037100*----------  COMPUTE TODAYS JULIAN DATE AND ADD THIS TO
037200*            THE NUMBER OF DAYS THE REPORT IS TO COVER.
           MOVE CUR-DATE TO GREGDATE-YMD.
           IF YY > "70"
               MOVE "19" TO GREGDATE-CC
           ELSE
               MOVE "20" TO GREGDATE-CC.
           MOVE SPACES TO JULDATE.
           CALL "JULGREG" USING GREGDATE JULDATE DAYDIGIT LEAPYEAR.
038200     MOVE JULDATE         TO  TODAYS-JULIAN, DATE-WANTED-JULIAN.
038300     ADD OPTION-DAYS, TJ-DDD GIVING DW-DDD.
      *----4/16/97 JSB, LOOP IN CASE OPTION DAYS COVER MORE THAN 1 YR
       100-OPTION-LOOP.
038400     IF DW-DDD > 365
              SUBTRACT 365 FROM DW-DDD
              ADD 1 TO DW-YY
              GO TO 100-OPTION-LOOP.
038500     MOVE DATE-WANTED-JULIAN    TO JULDATE.
038600
039600*----------  CHANGE THE JULIAN DATE INTO CCYYMMDD
           MOVE SPACES TO GREGDATE.
           CALL "JULGREG" USING GREGDATE JULDATE DAYDIGIT LEAPYEAR.
           MOVE GREGDATE TO DATE-COMPARE-CN.
040400 199-EXIT.  EXIT.
040500*************************************************************
040600*    FIND ALL BLANKET REQUIREMENT ORDERS BY READING DPORECD *
040700*    AND COMPARING RELEASE NUMBER FOR "999".  THEN COMPARE  *
040800*    THE EXPIRATION DATE WITH THE COMPARE DATE TO SEE IF    *
040900*    THE ORDER WILL EXPIRE BEFORE THE COMPARE DATE.  WRITE  *
041000*    ALL THOSE THAT WILL EXPIRE TO THE FILE "EXPWORK".      *
041100*************************************************************
       200-PROCESS-REQS SECTION.
041300 200-FIND-ALL-REQS.
041400     OPEN INPUT MBUYER-I DVENDOR-I DPORECD-I DPOITEM-I.
041900     MOVE SPACES TO CODE-ARG.
           MOVE 0 TO COND-WORD.
           MOVE LOW-VALUES TO PORCVNO OF DPORECD-REC-I.
           START DPORECD-I KEY > PORCVNO OF DPORECD-REC-I
             INVALID KEY MOVE 17 TO COND-WORD.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
                   MOVE 17 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.
           IF NOT GOOD-CALL
              MOVE "START DPORECD AT 200 IN TBKREXP" TO BU-DISPLAY-MSG
              PERFORM 990-BLOWUP THRU 999-EXIT.

042000     PERFORM 205-READ-DPORECD-LOOP THRU 219-EXIT
042100        UNTIL ALL-INPUT-RECORDS-PROCESSED.
042200
042300     GO TO 299-EXIT.
042400 205-READ-DPORECD-LOOP.
           READ DPORECD-I NEXT INTO BUF-DPORECD
                AT END MOVE 15 TO COND-WORD.
           IF FILE-STATUS NOT = "00"
              IF FILE-STATUS = "10" OR "14" OR "46"
                 MOVE 15 TO COND-WORD
              ELSE
                 MOVE 99 TO COND-WORD.
           IF END-OF-CHAIN
042800        MOVE "Y" TO END-OF-INPUT-FILE
042900        GO TO 219-EXIT.
           IF NOT GOOD-CALL
              MOVE "READ NEXT DPORECD AT 200 TBKREXP" TO BU-DISPLAY-MSG
              MOVE PORCVNO OF DPORECD-REC-I TO BU-DISPLAY-FLD (1)
              PERFORM 990-BLOWUP THRU 999-EXIT.

043300     IF PO-RLS-NO NOT = "999"
043400        GO TO 205-READ-DPORECD-LOOP.
043500
043600*----------  TEST IF THIS ENTRY IS WANTED BY ON EXPIRATION DATE
043700     IF PO-EXPECT-DATE-CN = SPACES
043800        GO TO  205-READ-DPORECD-LOOP.
043900
044000     IF PO-EXPECT-DATE-CN > DATE-COMPARE-CN
044100        GO TO 205-READ-DPORECD-LOOP.
044200
044300     MOVE PO-VEN-CODE        TO SORT-VENCODE.
044400     MOVE PO-EXPECT-DATE-CN  TO SORT-DATE-CN.
044500     MOVE PO-RCV-NO          TO SORT-REQNUM.
044600     MOVE PO-BUYER-CODE      TO SORT-BUYER.
044700     RELEASE SORT-REC.

044900 219-EXIT.  EXIT.
045000 299-EXIT.  EXIT.
045100*************************************************************
045200*************************************************************
045300*       PRINT REPORT TO DISC.  THEN CALL THE ROUTINE        *
045400*       "PRTRPT" TO PRINT THE REPORT TO THE PRINTER.        *
045500*       THIS REPORT IS 132 CHARACTERS WIDE, BUT "PRTRPT"    *
045600*       HAS THE CAPABILITY OF COMPACTING THE CHARACTERS     *
045700*       TO FIT ON AN 80 COLUMN PRINTER.                     *
045800*************************************************************
045900*************************************************************
046000 300-PRINT-REPORT SECTION 02.
046100 300-IS-FILE-EMPTY.
046200     MOVE SPACES TO PRT-REC.
046300     RETURN SORT-FILE
046400            AT END
046500               PERFORM 340-PRT-HEADINGS THRU 349-EXIT
046600               MOVE "0 RECORDS FOUND FOR THIS REPORT" TO
046700                               HEAD1-TITLE
046800               WRITE PRT-REC FROM HEAD1-TITLE
046900                    AFTER ADVANCING 1 LINE
047000               GO TO 399-EXIT.
047100
047200     PERFORM 302-FIND-REST-OF-DATA THRU 329-EXIT
047300        UNTIL ALL-SORTED-RECORDS-PROCESSED.
047400
047500     GO TO 399-EXIT.
047600
047700 302-FIND-REST-OF-DATA.
047800     IF LINE-CTR > 60
047900        PERFORM 340-PRT-HEADINGS THRU 349-EXIT.
048000
048100*----------  FILL IN FIRST DATA LINE
048200     MOVE OUT-REQNUM            TO LINE1-REQNUM.
048300     MOVE SORT-DATE             TO DATE-VALIDATE-IN.
048400     MOVE 4                     TO DATE-MODE.
048500     CALL "TDATECHK" USING DATE-CHECK-AREA.
048600     MOVE DATE-SLASH-OUT        TO LINE1-DATE.
048700     MOVE SORT-VENCODE          TO LINE1-VEN-CODE.
048800     MOVE SORT-BUYER            TO LINE1-BUYER-CODE.
048900
049000*----------  FIND NUMBER OF ITEMS ON REQUIREMENT ORDER
           MOVE 0                     TO ITEMS-CTR.
           MOVE 0                     TO COND-WORD.
049100     MOVE SORT-REQNUM           TO PO-ARG.
           MOVE PO-ARG                TO PORCVNO OF DPOITEM-REC-I.
           START DPOITEM-I KEY = PORCVNO OF DPOITEM-REC-I
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF FILE-STATUS NOT = "00" MOVE 17 TO COND-WORD.
           IF NOT GOOD-CALL
               MOVE ITEMS-CTR         TO LINE1-ITEMS
               GO TO 302-FROD-CONT.
       302-FROD-LOOP.
           READ DPOITEM-I NEXT INTO BUF-DPOITEM
               AT END    MOVE 15 TO COND-WORD.
           IF FILE-STATUS NOT = "00" MOVE 15 TO COND-WORD.
           IF ITM-PO-RCV-NO NOT = PO-ARG MOVE 15 TO COND-WORD.
           IF END-OF-CHAIN
               MOVE ITEMS-CTR         TO LINE1-ITEMS
               GO TO 302-FROD-CONT.
           ADD 1                      TO ITEMS-CTR.
           GO TO 302-FROD-LOOP.
       302-FROD-CONT.
049800     WRITE PRT-REC FROM LINE1 AFTER ADVANCING 1 LINE.
049900
050000*----------  FILL IN SECOND DATA LINE
050100     MOVE SPACES TO PRT-REC.
050200     MOVE SORT-VENCODE TO VEN-ARG.
           MOVE 0 TO COND-WORD.
           MOVE VEN-ARG TO VENCDE OF DVENDOR-REC-I.
      *------ 05JAN1998 REPLACED THE FOLLOWING BLOCK OF LOGIC.
      *------  IF THE START ON DVENDOR SHOULD FAIL, LET THE READ
      *------  NEXT HANDLE IT WHEN A FILE STATUS OF 46 IS RETURNED.
      *****START DVENDOR-I KEY = VENCDE OF DVENDOR-REC-I
      *****    INVALID KEY MOVE 17 TO COND-WORD.
      *****IF FILE-STATUS NOT = "00"
      *****    IF FILE-STATUS-1 = "2"
      *****        MOVE 17 TO COND-WORD
      *****    ELSE
      *****        MOVE 99 TO COND-WORD.
050500*****IF NOT GOOD-CALL
050600*****   MOVE "DBFIND DVENDOR AT 305 IN TBKREXP" TO BU-DISPLAY-MSG
      *****  MOVE VEN-ARG TO BU-DISPLAY-FLD (5)
050700*****   PERFORM 990-BLOWUP THRU 999-EXIT.
           START DVENDOR-I KEY = VENCDE OF DVENDOR-REC-I
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
050800
050900 305-GET-VENDOR-NAME.
           MOVE 0 TO COND-WORD.
           READ DVENDOR-I NEXT INTO BUF-DVENDOR
               AT END MOVE 15 TO COND-WORD.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   MOVE 15 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.
           IF VENCDE OF DVENDOR-REC-I NOT = VEN-ARG
               MOVE 15 TO COND-WORD.
051200     IF END-OF-CHAIN
051300        MOVE "WARNING - NO VENDOR NAME!!!!" TO LINE2-VEN-NAME
051400        MOVE "*" TO LINE2-ERROR
051500        GO TO 307-GET-BUYER.
051600     IF NOT GOOD-CALL
051700        MOVE "DBGET FAILED AT 305 IN TBKREXP" TO BU-DISPLAY-MSG
051800        PERFORM 990-BLOWUP THRU 999-EXIT.
051900
052000     IF VEN-ITM-NO NOT = 00
052100        GO TO 305-GET-VENDOR-NAME.
           MOVE SPACE                        TO LINE2-ERROR.
052200     MOVE VEN-ITM-DATA                 TO LINE2-VEN-NAME.
052300 307-GET-BUYER.
052400     MOVE SORT-BUYER   TO BUYER-ARG.
           MOVE 0 TO COND-WORD.
           MOVE BUYER-ARG TO BUYERCDE OF MBUYER-REC-I.
           READ MBUYER-I INTO BUF-MBUYER
               INVALID KEY MOVE 17 TO COND-WORD.
           IF FILE-STATUS-1 = "2"
               MOVE 17 TO COND-WORD
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD.
052700     IF COND-WORD = 17
052800        MOVE "WARNING - NO BUYER NAME!!!!" TO LINE2-BUYER-NAME
052900        MOVE "*" TO LINE2-ERROR
053000        GO TO 309-WRITE-LINE.
053100     IF NOT GOOD-CALL
053200        MOVE "DBGET MBUYER FAILED AT 305 IN TBKREXP" TO
053300                     BU-DISPLAY-MSG
053400        PERFORM 990-BLOWUP THRU 999-EXIT.
           MOVE SPACE      TO LINE2-ERROR.
053500     MOVE BUYER-NAME TO LINE2-BUYER-NAME.
053700
053800 309-WRITE-LINE.
053900     WRITE PRT-REC FROM LINE2 AFTER ADVANCING 1 LINE.
054000     ADD 4 TO LINE-CTR.
054100     MOVE SPACES TO PRT-REC.
054200     RETURN SORT-FILE
054300            AT END
054400            MOVE "Y" TO END-OF-SORT-FILE
054500            GO TO 329-EXIT.
054600     GO TO 302-FIND-REST-OF-DATA.
054700 329-EXIT.  EXIT.
054800*----------  PRINT HEADINGS
054900 340-PRT-HEADINGS.
055000     MOVE SPACES TO PRT-REC.
055100     WRITE PRT-REC FROM HEAD1 AFTER ADVANCING NEWPAGE.
055200     MOVE SPACES TO PRT-REC.
055300     MOVE PAGE-NUM               TO HEAD2-PAGE-NO.
055400     WRITE PRT-REC FROM HEAD2 AFTER ADVANCING 1 LINE.
055500
055600     MOVE SPACES TO PRT-REC.
055700     MOVE "for   "               TO HEAD3-FOR.
055800     MOVE OPTION-DAYS            TO HEAD3-DAYS-NUM.
055900     MOVE "   days"              TO HEAD3-DAYS.
056000     WRITE PRT-REC FROM HEAD3 AFTER ADVANCING 1 LINE.
056100
056200     MOVE SPACES TO PRT-REC.
056300     WRITE PRT-REC FROM HEAD4 AFTER ADVANCING 3 LINE.
056400
056500     MOVE SPACES TO PRT-REC.
056600     WRITE PRT-REC FROM HEAD5 AFTER ADVANCING 1 LINE.
056700
056800     MOVE SPACES TO PRT-REC.
056900     WRITE PRT-REC AFTER ADVANCING 2 LINES.
057000
057100     MOVE 2 TO LINE-CTR.
057200     ADD 1 TO PAGE-NUM.
057300
057400 349-EXIT.  EXIT.
057500 399-EXIT.  EXIT.
058900 900-ERROR-ROUTINES SECTION 03.
046400 COPY OVRPFCALL IN COPYLIB.
059000 990-BLOWUP.
059100     CALL "TBLOWUP" USING BASE, BU-PGM-NAME, STATUS-AREA,
059200           VIEW-COMAREA, FILE-STATUS, BU-DISPLAY-MSG,
059300           BU-DISPLAY-FLDS.
059400 999-EXIT.  EXIT.
