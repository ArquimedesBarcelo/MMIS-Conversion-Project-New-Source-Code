041600 COPY CATREAD OF COPYLIB.
041800 PROCEDURE DIVISION USING DBPARAMETERS VIEW-COMAREA
041900                      CATREAD-PARMS.
042000 START-PGM.
           PERFORM 1-HSK.
           PERFORM 6-MAIN UNTIL VIEW-LASTKEY = 3.
       2-EOJ.
           CLOSE DISPLAY-FILE.
           IF PRINT-BUF NOT = " "
               MOVE SPACES TO PRINT-REC
               WRITE PRINT-REC AFTER ADVANCING NEW-PAGE
               CLOSE PRINT-FILE.
           CLOSE WO-BASIC-FILE.
           CLOSE WO-LAST-NUM-USED.
           CLOSE WO-PLANNED-FILE.
           CLOSE WO-ZONE-PRTY-FILE.
119700*    IF ERROR-PASS NOT = SPACES OR KEY-HIT = 3
119800*      MOVE 0 TO KEY-HIT
119900*      MOVE SPACE TO PRINT-BUF.
120000*    IF KEY-HIT = 2  OR PRINT-BUF = "P"
120100*      GO TO WRITE-SCREEN.
120200*    IF ERROR-PASS = SPACES
120300*      NEXT SENTENCE
120400*    ELSE
120500*    CALL "TERRORD" USING ERROR-PASS LANGUAGE-PARMS.
           GOBACK.
       1-HSK.
           OPEN I-O    DISPLAY-FILE.
           OPEN INPUT WO-BASIC-FILE.
           OPEN INPUT WO-LAST-NUM-USED.
           OPEN INPUT WO-PLANNED-FILE.
           OPEN INPUT WO-ZONE-PRTY-FILE.
042100     CALL "TPWORD" USING PASSWORD-INFORMATION.
042500     IF PASSWORD-FLAG = "N" GO TO 2-EOJ.
           MOVE 0 TO COND-WORD.
043100     MOVE 1 TO ARG-NO.
           READ WO-LAST-NUM-USED INTO LAST-WO-BUFF
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF WLNU-STATUS NOT = "00" MOVE 17 TO COND-WORD.
           IF COND-WORD = 17 MOVE 1 TO DATE-FLAG-SW.
043900     MOVE DATE-FLAG-SW TO DATE-CODE.
044000     MOVE 1 TO DATE-MODE.
044100     CALL "TDATECHK" USING DATE-CHECK-AREA.
044200     MOVE DATE-SLASH-OUT TO SM-DATE.
