       IDENTIFICATION DIVISION.
       PROGRAM-ID.    CARIBDEL.
       AUTHOR.        B FONAGY.

      ******************************************************
      *                                                    *
      *   C A R I B D E L                                  *
      *                                                    *
      *   THIS SUBROUTINE DELETES A SPECIFIED PURCHASE     *
      *   ORDER AND ALL OTHER RELETED DOCUMENTS WHICH      *
      *   WERE CREATED BY ARIBA BUYER. THIS IS CALLED DUE  *
      *   TO 'TARIBAPO' FAILING TO LOAD THE 'STORES'       *
      *   DATA BASE.                                       *
      *           SUBROUTINE CALLED BY:                    *
      *           1.) TARIBAPO                             *
      *                                                    *
      ******************************************************

       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.
       SOURCE-COMPUTER.  HP-3000.
       OBJECT-COMPUTER.  HP-3000.

       SPECIAL-NAMES.         LOCAL-DATA IS LDA.

       INPUT-OUTPUT SECTION.
       FILE-CONTROL.

           SELECT DPORECD-FILE      ASSIGN TO DATABASE-MCFLCS0901
                  ORGANIZATION IS INDEXED
                  ACCESS IS DYNAMIC
                  FILE STATUS WS-FILE-STATUS
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY.

           SELECT MPORCV-FILE       ASSIGN TO DATABASE-MCFLCS0101
                  ORGANIZATION IS INDEXED
                  ACCESS IS DYNAMIC
                  FILE STATUS WS-FILE-STATUS
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY.

           SELECT MREQ-FILE         ASSIGN TO DATABASE-MCFLCS2001
                  ORGANIZATION IS INDEXED
                  ACCESS IS DYNAMIC
                  FILE STATUS WS-FILE-STATUS
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY.

           SELECT DREQD-FILE         ASSIGN TO DATABASE-MCFLCS2102
                  ORGANIZATION IS INDEXED
                  ACCESS IS DYNAMIC
                  FILE STATUS WS-FILE-STATUS
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY.

           SELECT DREQITM-FILE       ASSIGN TO DATABASE-MCFLCS2201
                  ORGANIZATION IS INDEXED
                  ACCESS IS DYNAMIC
                  FILE STATUS WS-FILE-STATUS
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY.

           SELECT DPODATA-FILE      ASSIGN TO DATABASE-MCFLCS1101
                  ORGANIZATION IS INDEXED
                  ACCESS IS DYNAMIC
                  FILE STATUS WS-FILE-STATUS
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY.

           SELECT DPOITEM-FILE      ASSIGN TO DATABASE-MCFLCS1002
                  ORGANIZATION IS INDEXED
                  ACCESS IS DYNAMIC
                  FILE STATUS WS-FILE-STATUS
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY.

           SELECT MVENDOR-FILE      ASSIGN TO DATABASE-MCFLCS0701
                  ORGANIZATION IS INDEXED
                  ACCESS IS DYNAMIC
                  FILE STATUS WS-FILE-STATUS
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY.

           SELECT DVENDITM-FILE   ASSIGN TO DATABASE-MCFLCS0801
                  ORGANIZATION IS INDEXED
                  ACCESS IS DYNAMIC
                  FILE STATUS WS-FILE-STATUS
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY.

           SELECT MSTORERM-FILE     ASSIGN TO DATABASE-MCFLCS0201
                  ORGANIZATION IS INDEXED
                  ACCESS IS DYNAMIC
                  FILE STATUS WS-FILE-STATUS
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY.

           SELECT DDAILYTC-FILE     ASSIGN TO DATABASE-MCFLCS1601
                  ORGANIZATION IS INDEXED
                  ACCESS IS DYNAMIC
                  FILE STATUS WS-FILE-STATUS
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY.

       DATA DIVISION.
       FILE SECTION.

       FD  DPORECD-FILE.
       01  DPORECD-REC.
       COPY DDS-ALL-FORMATS OF MCFLCS0901.
       COPY DPORECD  IN COPYLIB.

       FD  MPORCV-FILE.
       01  MPORCV-REC.
       COPY DDS-ALL-FORMATS OF MCFLCS0101.
       COPY MPORCV   IN COPYLIB.

       FD  MSTORERM-FILE.
       01  MSTORERM-REC.
       COPY DDS-ALL-FORMATS OF MCFLCS0201.
       COPY MSTORERM IN COPYLIB.

       FD  MREQ-FILE.
       01  MREQ-REC.
       COPY DDS-ALL-FORMATS OF MCFLCS2001.
       COPY MREQ     IN COPYLIB.

       FD  DREQD-FILE.
       01  DREQD-REC.
       COPY DDS-ALL-FORMATS OF MCFLCS2102.
       COPY DREQD     IN COPYLIB.

       FD  DREQITM-FILE.
       01  DREQITM-REC.
       COPY DDS-ALL-FORMATS OF MCFLCS2201.
       COPY DREQITM   IN COPYLIB.

       FD  MVENDOR-FILE.
       01  MVENDOR-REC.
       COPY DDS-ALL-FORMATS OF MCFLCS0701.
       COPY AVENCODE IN COPYLIB.
       COPY DVENDOR  IN COPYLIB.

       FD  DVENDITM-FILE.
       01  DVENDITM-REC.
       COPY DDS-ALL-FORMATS OF MCFLCS0801.
       COPY DVENDITM   IN COPYLIB.

       FD  DPODATA-FILE.
       01  DPODATA-REC.
       COPY DDS-ALL-FORMATS OF MCFLCS1101.
       COPY DPODATA  IN COPYLIB.

       FD  DPOITEM-FILE.
       01  DPOITEM-REC.
       COPY DDS-ALL-FORMATS OF MCFLCS1002.
       COPY DPOITEM  IN COPYLIB.

       FD  DDAILYTC-FILE.
       01  DDAILYTC-REC.
       COPY DDS-ALL-FORMATS OF MCFLCS1601.
       COPY DDAILYTC IN COPYLIB.
       COPY TC370    IN COPYLIB.
       COPY TC32D      IN COPYLIB.

      *************************************************************
      **              W O R K I N G    S T O R A G E
      *************************************************************
       WORKING-STORAGE SECTION.

       77  SUB                        PIC S9(4) COMP VALUE ZEROS.
       77  ITM-QTY-ADJUST             PIC S9(8)V9(4) VALUE ZEROS.
       77  STR-QTY-ADJUST             PIC S9(8)      VALUE ZEROS.


       COPY FILESTATUS  IN COPYLIB.

       COPY DTSPARMS2   IN COPYLIB.


       01  WORK-AREA.
           05  PO-FOUND-SW            PIC X     VALUE SPACES.
               88  PO-NOT-FOUND                 VALUE "N".

      *********************
      *                   *
      *   DATA SET NAMES  *
      *                   *
      *********************

       01  DSET-NAMES.
           05  DSET-DPORECD           PIC X(16)  VALUE "DPORECD;".
           05  DSET-MPORCV            PIC X(16)  VALUE "MPORCV;".
           05  DSET-MREQ              PIC X(16)  VALUE "MREQ;".
           05  DSET-DREQD             PIC X(16)  VALUE "DREQD;".
           05  DSET-DREQITM           PIC X(16)  VALUE "DREQITM;".
           05  DSET-DPOITEM           PIC X(16)  VALUE "DPOITEM;".
           05  DSET-DVENDOR           PIC X(16)  VALUE "DVENDOR;".
           05  DSET-DVENDITM          PIC X(16)  VALUE "DVENDITM;".
           05  DSET-MSTORERM          PIC X(16)  VALUE "MSTORERM;".
           05  DSET-DDAILYTC          PIC X(16)  VALUE "DDAILYTC;".

       01  ARG-VALUES.
           05  REQ-ARG                PIC X(12) VALUE SPACES.
           05  VEN-ARG                PIC X(10) VALUE SPACES.

       COPY DBMODES    IN COPYLIB.
       COPY DBSTAT     IN COPYLIB.

      ************************************
      *
      *  PARAMETERS FOR CALLING
      *  STC320.SOURCE
      *
      ************************************

       COPY STC320     IN COPYLIB.

       COPY TBLOWUP    IN COPYLIB.

      *************************************************************
      **             L I N K A G E    S E C T I O N
      *************************************************************
       LINKAGE SECTION.

       01  BASE             PIC X(10).

       01  PO-ARG           PIC X(14).

       01  COMPANY-SAVE     PIC X(3).

       01  MESSAGE-BUFFER.
           05  MSG-TXT      PIC X(66).
           05  MSG-FLD      PIC X(14).

      *************************************************************
      **           P R O C E D U R E    D I V I S I O N
      *************************************************************
       PROCEDURE DIVISION USING  BASE  PO-ARG  COMPANY-SAVE
                                 MESSAGE-BUFFER.
       0000-PROGRAM-ENTRY.

           OPEN  I-O       MREQ-FILE
                           MVENDOR-FILE
                           MSTORERM-FILE
                           MPORCV-FILE
                           DPORECD-FILE
                           DVENDITM-FILE
                           DREQD-FILE
                           DREQITM-FILE
                           DPOITEM-FILE
                           DDAILYTC-FILE
                           DPODATA-FILE.


           PERFORM 1-HSK            THRU  1-HSK-X.
           PERFORM 6-MAIN           THRU  6-MAIN-X.

           CLOSE           MVENDOR-FILE
                           MREQ-FILE
                           MSTORERM-FILE
                           MPORCV-FILE
                           DVENDITM-FILE
                           DREQD-FILE
                           DREQITM-FILE
                           DPORECD-FILE
                           DPOITEM-FILE
                           DDAILYTC-FILE
                           DPODATA-FILE.

       0000-PROGRAM-EXIT.
           GOBACK.

      *************************************************************
      **  HOUSEKEEPING
      *************************************************************
       1-HSK.

           PERFORM 8000-GET-DATE-TIME     THRU 8000-GDT-EXIT.

       1-HSK-X.
           EXIT.

      *************************************************************
      **  MAIN LOGIC LOOP
      *************************************************************
       6-MAIN.

           PERFORM 61-DELETE-PO-DATA     THRU 61-DPD-X.

       6-MAIN-X.
           EXIT.

      *************************************************************
      **  DELETE PO DATA PROCESS
      *************************************************************
       61-DELETE-PO-DATA.

           PERFORM 9000-READK-DPORECD     THRU 9000-READK-EXIT.
           IF  FS-RECORD-NOT-FOUND
               GO TO 61-DPD-X
           END-IF.

           MOVE PO-VEN-CODE          TO VEN-ARG.
           MOVE PO-REQ-NUMBER        TO REQ-ARG.


           PERFORM 9000-DELET-DPORECD     THRU 9000-DELET-EXIT.

      *----------------------------------------------------------------
      **  CHECK TEMP VENDOR
      *----------------------------------------------------------------
           IF PO-VEN-CODE-T = "T"
               PERFORM 611-DELETE-TEMP-VENDOR THRU 611-DTV-X
           END-IF.

      *----------------------------------------------------------------
      **  DELETE ITEMS
      *----------------------------------------------------------------
           PERFORM 612-DELETE-PO-ITEMS      THRU 612-DPI-X.
           PERFORM 62-MODIFY-REQUISITIONS   THRU 62-MR-X.
           PERFORM 63-DELETE-MPORCV-ENTRIES THRU 63-DME-X.

       61-DPD-X.
           EXIT.

      *************************************************************
      ** PROCESS A TEMPORARY VENDOR
      *************************************************************
       611-DELETE-TEMP-VENDOR.

           PERFORM 9001-READK-MVENDOR    THRU 9001-READK-EXIT.
           IF FS-RECORD-NOT-FOUND
               GO TO 611-DTV-X
           END-IF.

           PERFORM 9001-DELET-MVENDOR    THRU 9001-DELET-EXIT.
           PERFORM 9002-START-DVENDITM   THRU 9002-START-EXIT.

       611-GET-DVENDITM.

           PERFORM 9002-READN-DVENDITM   THRU 9002-READN-EXIT.
           IF FS-END-OF-FILE
               GO TO 611-DTV-X
           END-IF.

           PERFORM 9002-DELET-DVENDITM   THRU 9002-DELET-EXIT.

           GO TO 611-GET-DVENDITM.

       611-DTV-X.
           EXIT.

      *************************************************************
      ** PROCESS PO ITEMS
      *************************************************************
       612-DELETE-PO-ITEMS.

           PERFORM 9003-START-DPOITEM    THRU 9003-START-EXIT.

       612-GET-DPOITEM.

           PERFORM 9003-READN-DPOITEM    THRU 9003-READN-EXIT.
           IF FS-END-OF-FILE
               GO TO 612-DPI-X
           END-IF.

           IF ITM-QTY-DLVR < ITM-QTY-ORD
               PERFORM 6121-ADJUST-ONORDER THRU 6121-AO-X
           END-IF.

           PERFORM 612A-PROCESS-DPODATA  THRU 612A-EXIT.
           PERFORM 612B-PROCESS-DDAILYTC THRU 612B-EXIT.

           PERFORM 9003-DELET-DPOITEM    THRU 9003-DELET-EXIT.

           GO TO 612-GET-DPOITEM.

       612-DPI-X.
           EXIT.

      *************************************************************
      ** PROCESS DPODATA FILE
      *************************************************************
       612A-PROCESS-DPODATA.

           PERFORM 9005-START-DPODATA    THRU 9005-START-EXIT.

       612A-READN-DPODATA.

           PERFORM 9005-READN-DPODATA    THRU 9005-READN-EXIT.
           IF FS-END-OF-FILE
               GO TO 612A-EXIT
           END-IF.

           PERFORM 9005-DELET-DPODATA    THRU 9005-DELET-EXIT.

           GO TO 612A-READN-DPODATA.

       612A-EXIT.
           EXIT.

      *************************************************************
      ** PROCESS DDAILYTC
      *************************************************************
       612B-PROCESS-DDAILYTC.

           PERFORM 8000-GET-DATE-TIME     THRU 8000-GDT-EXIT.

           MOVE WS-SYSTEM-DATE2-YMD   TO  DDAILYTC-DATE.
           MOVE WS-SYSTEM-TIME2       TO  DDAILYTC-TIME.
           MOVE "32D"                 TO  DDAILYTC-TC.
           MOVE COMPANY-SAVE          TO  DDAILYTC-PLT.
           MOVE ITM-CORP-CODE         TO  TC32D-CORP-CODE.
           MOVE ITM-PO-RCV-NO         TO  TC32D-PO-RLS.
           MOVE ITM-NUMBER            TO  TC32D-ITEM-NO.
           PERFORM 9004-WRITE-DDAILYTC   THRU 9004-WRITE-EXIT.

       612B-EXIT.
           EXIT.

      *************************************************************
      ** ADJUST ON ORDER
      *************************************************************
       6121-ADJUST-ONORDER.

           INITIALIZE MSTORERM-REC.
           IF ITM-CORP-CODE = "NON-STR"
               GO TO 6121-CUT-DDAILYTC-321
           END-IF.

           PERFORM 9006-READK-MSTORERM   THRU 9006-READK-EXIT.
           IF FS-RECORD-NOT-FOUND
               GO TO 6121-AO-X
           END-IF.

       6121-CUT-DDAILYTC-321.

           INITIALIZE STC320-PARMS.
           MOVE "21"                    TO  STC320-ITEM-TC-ID.
           MOVE COMPANY-SAVE            TO  STC320-COMPANY-SAVE.

           IF ITM-CORP-CODE = "NON-STR"
               MOVE "NC"                TO  STC320-CODE
           ELSE
               MOVE ITM-CORP-CODE       TO  STC320-CODE
           END-IF.

           MOVE ITM-PO-RCV-NO           TO  STC320-PO-NUM.
           MOVE ITM-NUMBER              TO  STC320-ITEM.

           IF ITM-CORP-CODE = "NON-STR"
               MOVE ITM-QTY-DLVR        TO  STC320-QTY
               MOVE ITM-UM              TO  STC320-QTY-UM
           ELSE
           IF ITM-UM = STR-UM
               MOVE ITM-QTY-DLVR        TO  STC320-QTY
               MOVE ITM-UM              TO  STC320-QTY-UM
           ELSE
           IF ITM-UM = STR-UM1
               MULTIPLY ITM-QTY-DLVR       BY  STR-UM1-CF
                                       GIVING STC320-QTY ROUNDED
               MULTIPLY ITM-QTY-ORD        BY  STR-UM1-CF
                                       GIVING ITM-QTY-ORD ROUNDED
               MOVE STR-UM              TO  STC320-QTY-UM
           ELSE
           IF ITM-UM = STR-UM2
               MULTIPLY ITM-QTY-DLVR       BY  STR-UM2-CF
                                       GIVING STC320-QTY ROUNDED
               MULTIPLY ITM-QTY-ORD        BY  STR-UM2-CF
                                       GIVING ITM-QTY-ORD ROUNDED
               MOVE STR-UM              TO  STC320-QTY-UM
           ELSE
               MOVE ZEROS               TO  STC320-QTY
               MOVE STR-UM              TO  STC320-QTY-UM.


           IF ITM-CORP-CODE = "NON-STR"
               MOVE ITM-UNIT-PRICE      TO  STC320-PRICE
               MOVE ITM-PRICE-UM        TO  STC320-PRICE-UM
           ELSE
           IF ITM-PRICE-UM = STR-UM
               MOVE ITM-UNIT-PRICE      TO  STC320-PRICE
               MOVE ITM-PRICE-UM        TO  STC320-PRICE-UM
             ELSE
           IF ITM-PRICE-UM = STR-UM1
               DIVIDE ITM-UNIT-PRICE    BY  STR-UM1-CF
                                       GIVING STC320-PRICE  ROUNDED
               MOVE STR-UM              TO  STC320-PRICE-UM
             ELSE
           IF ITM-PRICE-UM = STR-UM2
               DIVIDE ITM-UNIT-PRICE    BY  STR-UM2-CF
                                       GIVING STC320-PRICE ROUNDED
               MOVE STR-UM              TO  STC320-PRICE-UM
           ELSE
               MOVE ZEROS               TO  STC320-PRICE
               MOVE STR-UM              TO  STC320-PRICE-UM.


           MULTIPLY ITM-QTY-ORD  BY  STC320-PRICE
                                GIVING STC320-OLD-BUDGET-AMT ROUNDED.

           MOVE ITM-TAX-CODE            TO  STC320-TAX-CODE.
           MOVE ITM-CLASS               TO  STC320-SUB.

           IF ITM-CORP-CODE = "NON-STR"
               NEXT SENTENCE
           ELSE
               IF STC320-SUB = SPACES
                   MOVE STR-CLASS       TO  STC320-SUB
               END-IF
           END-IF.

           MOVE ITM-SUB-DETL            TO  STC320-SUBD.
           MOVE ITM-ADDL-DATA           TO  STC320-ADDTL-DATA.
           MOVE PO-BUDGET-NUMBER        TO  STC320-BUDGET-NO.
           MOVE PO-CURRENCY-CODE        TO  STC320-CUR-CODE.
           CALL "STC320" USING BASE,
                               STC320-PARMS,
                               STATUS-AREA,
                               BU-DISPLAY-MSG,
                               BU-DISPLAY-FLDS.
           IF BU-DISPLAY-MSG-1  NOT = SPACES
               MOVE BU-DISPLAY-MSG TO MESSAGE-BUFFER
               GO TO 6121-AO-X
           END-IF.

       6121-AO-X.
           EXIT.

      *******************************************
      *                                         *
      *  MODIFY ALL REQUISITIONS ASSOCIATED     *
      *  WITH THE P.O. BY GOING THROUGH         *
      *  DREQD                                  *
      *                                         *
      *******************************************
       62-MODIFY-REQUISITIONS.

           PERFORM 9007-START-DREQD      THRU 9007-START-EXIT.

       62-GET-DREQD.

           PERFORM 9007-READN-DREQD      THRU 9007-READN-EXIT.
           IF FS-END-OF-FILE
               GO TO 62-MR-X
           END-IF.

           MOVE SPACES TO DREQD-PO-RCV-NO.
           PERFORM 9007-UPDAT-DREQD      THRU 9007-UPDAT-EXIT.

           PERFORM 62A-PROCESS-MREQ      THRU 62A-X.

           GO TO 62-GET-DREQD.

       62-MR-X.
           EXIT.

      *******************************************
      ** PROCESS MREQ UPDATE
      *******************************************
       62A-PROCESS-MREQ.

           PERFORM 9008-READK-MREQ       THRU 9008-READK-EXIT.
           IF FS-RECORD-NOT-FOUND
               GO TO 62A-X
           END-IF.

           MOVE "AR" TO REQ-HOLD-STATUS-CODE.
           MOVE "IN ARIBA" TO REQ-HOLD-STATUS.
           MOVE "X " TO REQ-RELEASE-STAT.
           PERFORM 9008-UPDAT-MREQ       THRU 9008-UPDAT-EXIT.

       62A-X.
           EXIT.

      *******************************************
      ** PROCESS MPORCV DELETE
      *******************************************
       63-DELETE-MPORCV-ENTRIES.

           PERFORM 9009-READK-MPORCV     THRU 9009-READK-EXIT.
           IF FS-RECORD-NOT-FOUND
               GO TO 63-DME-X
           END-IF.

           PERFORM 9009-DELET-MPORCV     THRU 9009-DELET-EXIT.

       63-DME-X.
           EXIT.

      *****************************************************************
      ***  CALL DATE AND TIME STAMP CL
      *****************************************************************
       8000-GET-DATE-TIME.

      **** CALL WS-DTS-PGM2  USING WS-SYSTEM-DATE-TIME2.
           CALL "GETDTSTMP2" USING WS-SYSTEM-DATE-TIME2.

       8000-GDT-EXIT.
           EXIT.

      *************************************************************
      **            ALL  FILE  I-O  BELOW HERE
      *************************************************************


      *****************************************************************
      ***  READ BY KEY DPORECD
      *****************************************************************
       9000-READK-DPORECD.

           INITIALIZE DPORECD-REC.
           MOVE PO-ARG           TO PO-RCV-NO  OF BUF-DPORECD.

           READ   DPORECD-FILE
           END-READ.

       9000-READK-EXIT.
           EXIT.
      *****************************************************************
      ***  DELETE  DPORECD
      *****************************************************************
       9000-DELET-DPORECD.

           DELETE DPORECD-FILE
           END-DELETE.

       9000-DELET-EXIT.
           EXIT.
      *****************************************************************
      ***  READ BY KEY MVENDOR
      *****************************************************************
       9001-READK-MVENDOR.

           INITIALIZE MVENDOR-REC.
           MOVE VEN-ARG          TO PO-RCV-NO.

           READ   MVENDOR-FILE
           END-READ.

       9001-READK-EXIT.
           EXIT.
      *****************************************************************
      ***  DELETE  MVENDOR
      *****************************************************************
       9001-DELET-MVENDOR.

           DELETE MVENDOR-FILE
           END-DELETE.

       9001-DELET-EXIT.
           EXIT.
      *****************************************************************
      ***  START VENDOR ITEM FILE
      *****************************************************************
       9002-START-DVENDITM.

           INITIALIZE DVENDITM-REC.
           MOVE VEN-ARG                 TO VEN-ITM-VENCODE.

           START DVENDITM-FILE
                 KEY IS >= EXTERNALLY-DESCRIBED-KEY
           END-START.

       9002-START-EXIT.
            EXIT.
      *****************************************************************
      ***  READ DVENDITM NEXT RECORD
      *****************************************************************
       9002-READN-DVENDITM.

           READ   DVENDITM-FILE  NEXT RECORD
           END-READ.

           IF  FS-END-OF-FILE
               GO TO 9002-READN-EXIT
           END-IF.

           IF  VEN-ITM-VENCODE  NOT = VEN-ARG
               SET FS-END-OF-FILE   TO TRUE
               GO TO 9002-READN-EXIT
           END-IF.


       9002-READN-EXIT.
           EXIT.
      *****************************************************************
      ***  DELETE  DVENDITM
      *****************************************************************
       9002-DELET-DVENDITM.

           DELETE DVENDITM-FILE
           END-DELETE.

       9002-DELET-EXIT.
           EXIT.
      *****************************************************************
      ***  START DPOITEM FILE
      *****************************************************************
       9003-START-DPOITEM.

           INITIALIZE DPOITEM-REC.
           MOVE PO-ARG           TO ITM-PO-RCV-NO OF BUF-DPOITEM.

           START DPOITEM-FILE
                 KEY IS >= EXTERNALLY-DESCRIBED-KEY
           END-START.

       9003-START-EXIT.
            EXIT.
      *****************************************************************
      ***  READ DPOITEM  NEXT RECORD
      *****************************************************************
       9003-READN-DPOITEM.

           READ   DPOITEM-FILE  NEXT RECORD
           END-READ.

           IF  FS-END-OF-FILE
               GO TO 9003-READN-EXIT
           END-IF.

           IF  ITM-PO-RCV-NO  OF BUF-DPOITEM NOT = PO-ARG
               SET FS-END-OF-FILE   TO TRUE
               GO TO 9003-READN-EXIT
           END-IF.

       9003-READN-EXIT.
           EXIT.
      *****************************************************************
      ***  DELETE  DPOITEM
      *****************************************************************
       9003-DELET-DPOITEM.

           DELETE DPOITEM-FILE
           END-DELETE.

       9003-DELET-EXIT.
           EXIT.
      *****************************************************************
      ***  WRITE   DDAILYTC
      *****************************************************************
       9004-WRITE-DDAILYTC.

           WRITE  DDAILYTC-REC
           END-WRITE.

       9004-WRITE-EXIT.
           EXIT.
      *****************************************************************
      ***  START DPODATA FILE
      *****************************************************************
       9005-START-DPODATA.

           INITIALIZE DPODATA-REC.
           MOVE PO-ARG                  TO DATAITM-PO-RCV-NO.
           MOVE ITM-NUMBER              TO DATAITM-ITEM-NO.
           MOVE ZERO                    TO DATAITM-LINE-NO.

           START DPODATA-FILE
                 KEY IS >= EXTERNALLY-DESCRIBED-KEY
           END-START.

       9005-START-EXIT.
            EXIT.
      *****************************************************************
      ***  READ DPODATA  NEXT RECORD
      *****************************************************************
       9005-READN-DPODATA.

           READ   DPODATA-FILE  NEXT RECORD
           END-READ.

           IF  FS-END-OF-FILE
               GO TO 9005-READN-EXIT
           END-IF.


           IF  DATAITM-PO-RCV-NO NOT = PO-ARG
               SET FS-END-OF-FILE   TO TRUE
               GO TO 9005-READN-EXIT
           END-IF.

           IF  DATAITM-ITEM-NO   NOT = ITM-NUMBER
               SET FS-END-OF-FILE   TO TRUE
               GO TO 9005-READN-EXIT
           END-IF.

       9005-READN-EXIT.
           EXIT.
      *****************************************************************
      ***  DELETE  DPOITEM
      *****************************************************************
       9005-DELET-DPODATA.

           DELETE DPODATA-FILE
           END-DELETE.

       9005-DELET-EXIT.
           EXIT.
      *****************************************************************
      ***  READ BY KEY MSTORERM
      *****************************************************************
       9006-READK-MSTORERM.

           INITIALIZE MSTORERM-REC.
           MOVE ITM-CORP-CODE    TO CORP-CODE  OF BUF-MSTORERM.

           READ   MSTORERM-FILE
           END-READ.

       9006-READK-EXIT.
           EXIT.
      *****************************************************************
      ***  START DREQD  FILE
      *****************************************************************
       9007-START-DREQD.

           INITIALIZE DREQD-REC.
           MOVE PO-ARG                  TO DREQD-PO-RCV-NO.

           START DREQD-FILE
                 KEY IS >= EXTERNALLY-DESCRIBED-KEY
           END-START.

       9007-START-EXIT.
            EXIT.
      *****************************************************************
      ***  READ DPODATA  NEXT RECORD
      *****************************************************************
       9007-READN-DREQD.

           READ   DREQD-FILE    NEXT RECORD
           END-READ.

           IF  FS-END-OF-FILE
               GO TO 9007-READN-EXIT
           END-IF.


           IF  DREQD-PO-RCV-NO   NOT = PO-ARG
               SET FS-END-OF-FILE   TO TRUE
               GO TO 9007-READN-EXIT
           END-IF.

           IF  DREQD-PO-ITM-NO  NOT = ITM-NUMBER
               SET FS-END-OF-FILE   TO TRUE
               GO TO 9007-READN-EXIT
           END-IF.


       9007-READN-EXIT.
           EXIT.

      *****************************************************************
      ***  UPDATE  DREQD
      *****************************************************************
       9007-UPDAT-DREQD.

           REWRITE DREQD-REC
           END-REWRITE.

       9007-UPDAT-EXIT.
           EXIT.

      *****************************************************************
      ***  READ BY KEY MREQ
      *****************************************************************
       9008-READK-MREQ.

           INITIALIZE MREQ-REC.
           MOVE DREQD-REQ-NUMBER TO MREQ-NUMBER OF BUF-MREQ.

           READ   MREQ-FILE
           END-READ.

       9008-READK-EXIT.
           EXIT.
      *****************************************************************
      ***  UPDATE  MREQ
      *****************************************************************
       9008-UPDAT-MREQ.

           REWRITE MREQ-REC
           END-REWRITE.

       9008-UPDAT-EXIT.
           EXIT.

      *****************************************************************
      ***  READ BY KEY MPORCV
      *****************************************************************
       9009-READK-MPORCV.

           INITIALIZE MPORCV-REC.
           MOVE PO-ARG           TO M-PO-RCV-NO OF BUF-MPORCV.

           READ   MPORCV-FILE
           END-READ.

       9009-READK-EXIT.
           EXIT.
      *****************************************************************
      ***  DELETE  MPORCV
      *****************************************************************
       9009-DELET-MPORCV.

           DELETE MPORCV-FILE
           END-DELETE.

       9009-DELET-EXIT.
           EXIT.
      *****************************************************************
      ***                 END  OF  SOURCE  MEMBER
      *****************************************************************
