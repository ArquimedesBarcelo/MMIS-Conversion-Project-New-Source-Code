000200 IDENTIFICATION DIVISION.
000300 PROGRAM-ID.  SCOMPPO.
000500 AUTHOR.      KURT MOVSESIAN/JIM COFFMAN(MAINTAINER).
000800
000900******************************************************
001000*                                                    *
001100*D  S C O M P P O                                    *
001200*                                                    *
001300*D  THIS SUB PROGRAM ADJUSTS ALL DIFFERENCES IN      *
001400*D  QUANTITY ORDERED AND QUANTITY DELIVERED SUCH     *
001500*D  QUANTITY ORDERED EQUALS QUANTITY DELIVERED       *
001600*D  SO THAT THE PO WILL BE SHOWN AS COMPLETED        *
001700*                                                    *
001800******************************************************
001900*   N O T E    T H I S   S U B R O U T I N E   I S   *
002000*         C A L L E D    B Y :                       *
002100*      1. SPOMOD                                     *
002200*      2. TPOPRTSL                                   *
002300******************************************************
      *
      * 04/03/1995    CA ZUBEK    REQ. # 95-009
      *   ADDED CALL TO 'SPOTRACK' TO WRITE TO THE AUDIT
      *   TRAIL FILE WHEN THE ORDER QUANTITY IS CHANGED.
      *
      * 07/10/1995    CA YODER
      *   ADDED PO ITEM NUMBER FIELD TO 'SPOTRACK' PARAMETERS.
      *
      * 07/22/1996    CA YODER
      *   MODIFIED FOR CENTURY DATABASE CHANGES.
      *
      * 05/21/98  CA YODER
      *   ADDED CALL TO "SCALCBGT" TO CALCULATE THE CORRECT
      *   BUDGET AMOUNT FOR THE PO.  DECATUR FOUND THAT THE
      *   TAX WAS NOT BEING INCLUDED IN THE CALCULATION.
      *
      ******************************************************
002400
004800
004900 ENVIRONMENT DIVISION.
005000 CONFIGURATION SECTION.
005100 SOURCE-COMPUTER.  HP-3000.
005200 OBJECT-COMPUTER.  HP-3000.
       SPECIAL-NAMES.  I-O-FEEDBACK IS I-O-FEEDBACK-AREA.
009100
009200 INPUT-OUTPUT SECTION.
       FILE-CONTROL.

           SELECT MSTORERM-I
                  ASSIGN TO DATABASE-MCFLCS0201
                  ORGANIZATION IS INDEXED
                    ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                  FILE STATUS IS FILE-STATUS.

           SELECT DINVRCD-I
                  ASSIGN TO DATABASE-MCFLCS2502
                  ORGANIZATION IS INDEXED
                    ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                    WITH DUPLICATES
                  FILE STATUS IS FILE-STATUS.

           SELECT DREQD-I
                  ASSIGN TO DATABASE-MCFLCS2102
                  ORGANIZATION IS INDEXED
                    ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                    WITH DUPLICATES
                  FILE STATUS IS FILE-STATUS.

           SELECT DPOITEM-O
                  ASSIGN TO DATABASE-MCFLCS1002
                  ORGANIZATION IS INDEXED
                    ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                    WITH DUPLICATES
                  FILE STATUS IS FILE-STATUS.


           SELECT DPORECD-O
                  ASSIGN TO DATABASE-MCFLCS0901
                  ORGANIZATION IS INDEXED
                    ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                  FILE STATUS IS FILE-STATUS.

       DATA DIVISION.
       FILE SECTION.
       FD  MSTORERM-I
           LABEL RECORDS ARE STANDARD.
       01  MSTORERM-REC-I.
           COPY DDS-ALL-FORMATS  OF MCFLCS0201.

       FD  DINVRCD-I
           LABEL RECORDS ARE STANDARD.
       01  DINVRCD-REC-I.
           COPY DDS-ALL-FORMATS  OF MCFLCS2502.

       FD  DREQD-I
           LABEL RECORDS ARE STANDARD.
       01  DREQD-REC-I.
           COPY DDS-ALL-FORMATS  OF MCFLCS2102.

       FD  DPOITEM-O
           LABEL RECORDS ARE STANDARD.
       01  DPOITEM-REC-O.
           COPY DDS-ALL-FORMATS  OF MCFLCS1002.

       FD  DPORECD-O
           LABEL RECORDS ARE STANDARD.
       01  DPORECD-REC-O.
           COPY DDS-ALL-FORMATS  OF MCFLCS0901.

       WORKING-STORAGE SECTION.
       01  FILE-STATUS.
           05  FILE-STATUS-1            PIC X  VALUE "0".
           05  FILE-STATUS-2            PIC X  VALUE "0".
005300
       77  INV-RCDS-CTR            PIC S9(8)  VALUE ZEROS.
       77  ITM-QTY-ORD-SAVE        PIC S9(8)  VALUE ZEROS COMP-3.
       77  ITM-NET-PAID-AMT        PIC S9(12) VALUE ZEROS COMP-3.
006000 77  ORD-QTY-SAVE            PIC S9(8)  VALUE ZEROS COMP-3.
006100 77  PO-STR-PRICE            PIC S9(11)V9(4) COMP-3 VALUE ZEROS.
006200 77  OLD-BUDGET-AMT          PIC S9(11) COMP-3 VALUE ZEROS.
006300 77  SAVE-REQ-NO             PIC X(6)  VALUE SPACES.
006400
       01  CURR-DATE-WA.
           05  C-D-YY              PIC 99.
           05  C-D-MM              PIC 99.
           05  C-D-DD              PIC 99.
006500
