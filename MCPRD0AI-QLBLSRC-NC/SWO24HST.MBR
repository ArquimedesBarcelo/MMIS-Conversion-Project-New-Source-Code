       IDENTIFICATION DIVISION.
       PROGRAM-ID.             SWO24HST.
       AUTHOR.                 W. ROXBURY.
       INSTALLATION.           GOODYEAR TIRE & RUBBER COMPANY.
       DATE-WRITTEN.           DECEMBER 1997.
       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.
       SOURCE-COMPUTER.        IBM-AS400.
       OBJECT-COMPUTER.        IBM-AS400.

       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT WO-BASIC
                  ASSIGN       TO DATABASE-MCFLMM1003
                  ORGANIZATION IS INDEXED
                  ACCESS MODE  IS DYNAMIC
                  RECORD KEY   IS EXTERNALLY-DESCRIBED-KEY
                               WITH DUPLICATES
                  FILE STATUS  IS FILE-STAT.

           SELECT WO-BASIC-WO
                  ASSIGN       TO DATABASE-MCFLMM1001
                  ORGANIZATION IS INDEXED
                  ACCESS MODE  IS DYNAMIC
                  RECORD KEY   IS EXTERNALLY-DESCRIBED-KEY
                               WITH DUPLICATES
                  FILE STATUS  IS FILE-STAT.

           SELECT DISPLAY-FILE
                  ASSIGN       TO WORKSTATION-ZWO24HST-SI
                  ORGANIZATION IS TRANSACTION
                  ACCESS MODE  IS DYNAMIC
                  RELATIVE KEY IS RECNO
                  FILE STATUS  IS SCREEN-STATUS
                               MAJOR-MINOR
                  CONTROL-AREA IS SCREEN-CONTROL.

       DATA DIVISION.
       FILE SECTION.
       FD  WO-BASIC
           LABEL RECORDS       ARE STANDARD.
       01  VWO-REC.
           COPY DDS-ALL-FORMATS OF MCFLMM1003.

       FD  WO-BASIC-WO
           LABEL RECORDS       ARE STANDARD.
       01  VWO-WOC.
           COPY DDS-ALL-FORMATS OF MCFLMM1001.

       FD  DISPLAY-FILE
           LABEL RECORDS       ARE OMITTED.
       01  DISPLAY-REC         PIC X(2000).

       WORKING-STORAGE SECTION.
       77  RECNO               PIC 9999      VALUE 0.
       77  FILE-SW             PIC X         VALUE "B".
       77  D-PARM              PIC X.
       77  L-PARM              PIC X.
       77  TRUE-VAL            PIC 1         VALUE B"1".
       77  NEG-VAL             PIC 1         VALUE B"0".

       01  FILE-STAT.
           05 FILE-STAT-1      PIC X   VALUE "0".
           05 FILE-STAT-2      PIC X   VALUE "0".

       01  GREG-DATE.
           05  G-YEAR          PIC XXXX.
           05  G-MONTH         PIC XX.
           05  G-DAY           PIC XX.

       01  JUL-SIGN            PIC S9(06).
       01  JUL-DATE            PIC  X(07).
       01  JULIAN-DATE         REDEFINES JUL-DATE
                               PIC  9(07).
       01  FILLER              REDEFINES JUL-DATE.
           05  J-YEAR          PIC 9999.
           05  J-DAY           PIC 999.

       01  SCREEN-BUFF.
           05  EQUIP-BUF       PIC  X(06).
           05  CMDMSG-01       PIC  X(79).
           05  ERRMSG-01       PIC  X(79).

       01  SCREEN-BUFF-SUB.
           05  WO-SEL          PIC X.
           05  WONUMBER        PIC X(07).
           05  WO-STAT         PIC XX.
           05  DESCRIPT        PIC X(30).
           05  SKILL-A         PIC XX.
           05  SKILL-B         PIC XX.
           05  SKILL-C         PIC XX.
           05  FAIL-CODE       PIC X(07).
           05  DATE-TIME       PIC X(11).

       01  SCREEN-REMAP.
           05  F-CODE.
               10  FC1         PIC X(02).
               10  DASH        PIC X.
               10  FC2         PIC X(04).
           05  DT-BUFFER.
               10  DMM         PIC X(02).
               10  SLASH       PIC X.
               10  DDD         PIC X(02).
               10  FILLER      PIC X.
               10  THH         PIC X(02).
               10  COLON       PIC X.
               10  TMM         PIC X(02).

       01  COMPARE-DATES.
           05  TODAY.
               10  CUR-CC      PIC X(02).
               10  CUR-DATE.
                   15  CUR-YY  PIC X(02).
                   15  CUR-MM  PIC X(02).
                   15  CUR-DD  PIC X(02).
           05  YESTERDAY       PIC X(08).

           COPY SCREENIO       IN COPYLIB.

       01  WO-BASIC-DATA.
           COPY DWOBASIC       IN COPYLIB.

       01  WO-PLANNED-DATA.
           COPY DWOPLAN        IN COPYLIB.

       LINKAGE SECTION.
       01  LINKAGE-DATA.
           05  EQP-NUM-BUF     PIC X(06).

       01  DBPARAMETERS.
           COPY DBPARMS        IN COPYLIB.

       PROCEDURE DIVISION      USING LINKAGE-DATA
                               DBPARAMETERS.
       INITIALIZATION.
           MOVE 1              TO DATE-FLAG.
           ACCEPT CUR-DATE FROM DATE
           MOVE 20             TO CUR-CC.
           IF CUR-YY > 70
               MOVE 19         TO CUR-CC.

           MOVE TODAY          TO GREG-DATE.
           MOVE SPACES         TO JUL-DATE D-PARM L-PARM.
           CALL "JULGREG"      USING
                               GREG-DATE
                               JUL-DATE
                               D-PARM
                               L-PARM.

           MOVE J-DAY          TO JUL-SIGN.
           SUBTRACT 1          FROM JUL-SIGN.
           PERFORM UNTIL       JUL-SIGN > 0
               ADD 365         TO JUL-SIGN
               SUBTRACT 1      FROM J-YEAR
           END-PERFORM.

           MOVE JUL-SIGN       TO J-DAY.
           MOVE SPACES         TO GREG-DATE.
           CALL "JULGREG"      USING
                               GREG-DATE
                               JUL-DATE
                               D-PARM
                               L-PARM.

           MOVE GREG-DATE      TO YESTERDAY.
           OPEN I-O            DISPLAY-FILE.
           OPEN INPUT          WO-BASIC.
           OPEN INPUT          WO-BASIC-WO.

       DISPLAY-DATA.
           MOVE SPACES         TO SCREEN-BUFF.
           MOVE EQP-NUM-BUF    TO EQUIP-BUF
                                  EQPNUM OF WO-BASIC.
           START WO-BASIC
               KEY NOT LESS    THAN EQPNUM OF WO-BASIC
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
               GO TO END-OF-JOB.

           MOVE 0              TO RECNO.
           MOVE NEG-VAL        TO IND(75).
           MOVE TRUE-VAL       TO IND(77) IND(76).
           MOVE SPACES         TO SCREEN-BUFF-SUB
                                  DISPLAY-REC.
           MOVE EQP-NUM-BUF    TO EQUIP-BUF.
           MOVE SCREEN-BUFF    TO DISPLAY-REC.
           WRITE DISPLAY-REC   FORMAT "FWO24HST"
                               INDIC ARE SCREEN-INDICATORS.
           IF SCREEN-STATUS NOT = "00"
               DISPLAY
               "SUBFILE CLEAR WRITE ERROR.  SCREEN-STATUS IS "
                               SCREEN-STATUS.
           MOVE NEG-VAL        TO IND(77).

       DBGET-LOOP.
           READ WO-BASIC       NEXT INTO WO-BASIC-DATA
               AT END          MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT = "10" OR "14" OR "46"
               GO TO SUBF-CONT
           ELSE
           IF FILE-STAT NOT = "00"
               GO TO END-OF-JOB.

           IF EQUIP-NUM NOT = EQP-NUM-BUF
               GO TO SUBF-CONT.

           IF DATE-COMP-CN = YESTERDAY OR TODAY
               GO TO DBGET-CONT.

           IF DATE-RECD-CN = YESTERDAY OR TODAY
               GO TO DBGET-CONT.

           GO TO DBGET-LOOP.

       DBGET-CONT.
           MOVE SPACES         TO SCREEN-BUFF-SUB.
           MOVE WO-NUM-PRIM    TO WONUMBER.
           MOVE WO-STATUS      TO WO-STAT.
           MOVE DESCRIPTION-1  TO DESCRIPT.
           MOVE CRAFTS-REQD-1  TO SKILL-A.
           MOVE CRAFTS-REQD-2  TO SKILL-B.
           MOVE CRAFTS-REQD-3  TO SKILL-C.
           MOVE SPACES         TO F-CODE DT-BUFFER.

           IF FAILURE-CODE NOT = SPACES
               MOVE "-"              TO DASH
               MOVE FAIL-CODE-REASON TO FC1
               MOVE FAIL-CODE-SUBSYS TO FC2.
           MOVE F-CODE         TO FAIL-CODE.

           IF FAILURE-CODE NOT = SPACES
               MOVE "/"          TO SLASH
               MOVE DATE-COMP-MM TO DMM
               MOVE DATE-COMP-DD TO DDD
               MOVE ":"          TO COLON
               MOVE TIME-COMP-HH TO THH
               MOVE TIME-COMP-MM TO TMM.
           MOVE DT-BUFFER      TO DATE-TIME.

           ADD 1               TO RECNO.
           MOVE SCREEN-BUFF-SUB TO DISPLAY-REC.
           MOVE "00" TO SCREEN-STATUS.
           WRITE SUBFILE       DISPLAY-REC FORMAT "F24DISP"
                               INDIC ARE SCREEN-INDICATORS
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF SCREEN-STATUS NOT = "00"
               DISPLAY   "SUBFILE 1 WRITE ERROR.  SCREEN STATUS IS "
                               SCREEN-STATUS
               GO TO END-OF-JOB.

           GO TO DBGET-LOOP.

       SUBF-CONT.
           IF RECNO EQUAL 0
               GO TO END-OF-JOB.

           WRITE DISPLAY-REC   FORMAT "F24SEL"
                               INDIC ARE SCREEN-INDICATORS.
           MOVE TRUE-VAL       TO IND(76).
           IF RECNO GREATER THAN 0
               MOVE TRUE-VAL   TO IND(75)
           ELSE
               MOVE NEG-VAL    TO IND(75).
           MOVE SCREEN-BUFF    TO DISPLAY-REC.
           WRITE DISPLAY-REC   FORMAT "FWO24HST"
                               INDIC ARE SCREEN-INDICATORS.
           READ DISPLAY-FILE   FORMAT "FWO24HST"
                               INDIC ARE SCREEN-INDICATORS.
           PERFORM UNTIL SCREEN-BUFF-SUB = SPACES
               MOVE SPACES     TO SCREEN-BUFF-SUB
               READ SUBFILE DISPLAY-FILE
                               NEXT MODIFIED INTO SCREEN-BUFF-SUB
                               FORMAT "F24DISP"
                               INDIC ARE SCREEN-INDICATORS
               END-READ
               IF WO-SEL NOT = " "
                   MOVE " "    TO WO-SEL
                   PERFORM DISPLAY-PROC THRU DP-EXIT
               END-IF
           END-PERFORM.

           IF KEY-HIT = 3 OR 8
               GO TO END-OF-JOB.

           GO TO DISPLAY-DATA.

       END-OF-JOB.
           CLOSE               WO-BASIC.
           CLOSE               WO-BASIC-WO.
           CLOSE               DISPLAY-FILE.
           GOBACK.

       DISPLAY-PROC.
           MOVE SPACES         TO WO-BASIC-DATA WO-PLANNED-DATA.
           MOVE WONUMBER       TO WONUM OF WO-BASIC-WO.
           READ WO-BASIC-WO    INTO WO-BASIC-DATA
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
               GO TO DP-EXIT.

           CALL "TDISPWO"      USING DBPARAMETERS
                               WO-BASIC-DATA
                               WO-PLANNED-DATA
                               FILE-SW.

       DP-EXIT.                EXIT.

