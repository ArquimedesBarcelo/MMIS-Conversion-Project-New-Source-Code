       IDENTIFICATION DIVISION.
       PROGRAM-ID.             TDISPMES.
       AUTHOR.                 W. ROXBURY.
       INSTALLATION.           GOODYEAR TIRE & RUBBER CO.
       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.
       SOURCE-COMPUTER.        IBM-AS400.
       OBJECT-COMPUTER.        IBM-AS400.
       SPECIAL-NAMES.          C01 IS NEW-PAGE.
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT PER-PERSONNEL
                  ASSIGN       TO DATABASE-MCFLMM0301
                  ORGANIZATION IS INDEXED
                  ACCESS MODE  IS DYNAMIC
                  RECORD KEY   IS EXTERNALLY-DESCRIBED-KEY
                  FILE STATUS  IS FILE-STAT.

           SELECT ZONE-PRINTER
                  ASSIGN       TO DATABASE-MCFLZP0101
                  ORGANIZATION IS INDEXED
                  ACCESS MODE  IS DYNAMIC
                  RECORD KEY   IS EXTERNALLY-DESCRIBED-KEY
                  FILE STATUS  IS FILE-STAT.

           SELECT WO-MESSAGE-CC
                  ASSIGN       TO DATABASE-MCFLMM2402
                  ORGANIZATION IS INDEXED
                  ACCESS MODE  IS DYNAMIC
                  RECORD KEY   IS EXTERNALLY-DESCRIBED-KEY
                               WITH DUPLICATES
                  FILE STATUS  IS FILE-STAT.

           SELECT WO-MESSAGE-WO
                  ASSIGN       TO DATABASE-MCFLMM2403
                  ORGANIZATION IS INDEXED
                  ACCESS MODE  IS DYNAMIC
                  RECORD KEY   IS EXTERNALLY-DESCRIBED-KEY
                               WITH DUPLICATES
                  FILE STATUS  IS FILE-STAT.

           SELECT DISPLAY-FILE
                  ASSIGN       TO WORKSTATION-ZMESSAGE-SI
                  ORGANIZATION IS TRANSACTION
                  ACCESS MODE  IS SEQUENTIAL
                  FILE STATUS  IS SCREEN-STATUS
                               MAJOR-MINOR
                  CONTROL-AREA IS SCREEN-CONTROL.

           SELECT CH-PRINT-FILE
                  ASSIGN       TO PRINTER-MCPRT.

       DATA DIVISION.
       FILE SECTION.
       FD  PER-PERSONNEL
           LABEL RECORDS ARE STANDARD.
       01  PERS-REC.
           COPY DDS-ALL-FORMATS OF MCFLMM0301.

       FD  ZONE-PRINTER
           LABEL RECORDS ARE STANDARD.
       01  ZP-REC.
           COPY DDS-ALL-FORMATS OF MCFLZP0101.

       FD  WO-MESSAGE-CC
           LABEL RECORDS ARE STANDARD.
       01  MCC-REC.
           COPY DDS-ALL-FORMATS OF MCFLMM2402.

       FD  WO-MESSAGE-WO
           LABEL RECORDS ARE STANDARD.
       01  MWO-REC.
           COPY DDS-ALL-FORMATS OF MCFLMM2403.

       FD  DISPLAY-FILE
           LABEL RECORDS ARE OMITTED.
       01  DISPLAY-REC         PIC X(2000).

       FD  CH-PRINT-FILE
           LABEL RECORD IS OMITTED
           RECORD CONTAINS 80 CHARACTERS
           DATA RECORD IS PRINT-REC.
       01  PRINT-REC           PIC X(80).

       WORKING-STORAGE SECTION.
       77  UPDATE-SW           PIC X.
       77  UPDATE-ERROR        PIC X(76).
       77  ZONE-KEY            PIC X(04).
       77  FIELD-NUMBER        PIC 99.
       77  CCWO-LIT            PIC X(10).
       77  CCWO-BUF            PIC X(10).
       77  TRUE-VALUE          PIC 1       VALUE B"1".
       77  D-PARM              PIC X.
       77  L-PARM              PIC X.

       01  FILE-STAT.
           05  FILE-STAT-1     PIC X  VALUE "0".
           05  FILE-STAT-2     PIC X  VALUE "0".

       01  PASSWORD-INFORMATION.
           05  NAME-OF-PROGRAM     PIC X(08) VALUE "TDISPMES".
           05  PROGRAM-TYPE        PIC X(02) VALUE "IN".
           05  PROGRAM-RELEASE     PIC X(12) VALUE " E0100010001".
           05  PROGRAM-DESCRIPTION.
               10  PROG-DESC-A1    PIC X(30) VALUE
                   "DISPLAYS MMIS CRAFTSMAN OR WOR".
               10  PROG-DESC-A2    PIC X(30) VALUE
                   "KORDER MESSAGES TO THE SCREEN.".
               10  PROG-DESC-B1    PIC X(30) VALUE
                   "CALLED FROM ALL MESSAGE HANDLI".
               10  PROG-DESC-B2    PIC X(30) VALUE
                   "NG PROGRAMS.                  ".
               10  PROG-FUNCTION   PIC X(60) VALUE SPACES.
           05  PASSWORD-FLAG       PIC X.

       01  SCREEN-DATA.
           05  DATE-BUF.
               10  DATE-BUF-MM PIC XX.
               10  SLASH1      PIC X.
               10  DATE-BUF-DD PIC XX.
               10  SLASH2      PIC X.
               10  DATE-BUF-YY PIC XX.
           05  TIME-BUF        PIC X(04).
           05  TO-CC-BUF       PIC X(04).
           05  TO-WO-BUF.
               10  WO-BUF-NUM  PIC X(06).
               10  WO-BUF-YR   PIC X.
               10  WO-BUF-SUF  PIC X(03).
           05  FROM-CC-BUF     PIC X(04).
           05  FROM-SIGNON-BUF.
               10  USER-BUF    PIC X(08).
               10  GROUP-BUF   PIC X(08).
               10  ACCT-BUF    PIC X(08).
               10  TNUM-BUF    PIC X(04).
           05  MESSAGE-BUF.
               10  MESSAGE-1-BUF  PIC X(70).
               10  MESSAGE-2-BUF  PIC X(70).
               10  MESSAGE-3-BUF  PIC X(70).
               10  MESSAGE-4-BUF  PIC X(70).
               10  MESSAGE-5-BUF  PIC X(70).
           05  PRINT-BUF       PIC X.
           05  DATE-DISP-X     PIC X(08).
           05  DATE-DISP       REDEFINES DATE-DISP-X.
               10  DISP-BUF-MM PIC 99.
               10  SLASH3      PIC X.
               10  DISP-BUF-DD PIC 99.
               10  SLASH4      PIC X.
               10  DISP-BUF-YY PIC 99.
           05  DATE-DEL.
               10  DD-MM       PIC 99.
               10  DD-DD       PIC 99.
               10  DD-YY       PIC 99.
           05  CMDMSG          PIC X(79).
           05  ERRMSG          PIC X(78).

       01  ZONE-PRT-BUFFER.
           05  ZONE-BUF           PIC X(04) VALUE SPACES.
           05  PRINTER-BUFFERS.
               10  PRINTER-BUF-V.
                   15  P-BUF-V-1  PIC X     VALUE SPACES.
                   15  P-BUF-V-2  PIC X     VALUE SPACES.
               10  PRINT-BUF-V-9  REDEFINES PRINTER-BUF-V PIC 99.
               10  PRINTER-BUF-P.
                   15  P-BUF-P-1  PIC X     VALUE SPACES.
                   15  P-BUF-P-2  PIC X     VALUE SPACES.
               10  PRINT-BUF-P-9  REDEFINES PRINTER-BUF-P PIC 99.
               10  PRINTER-BUF-E.
                   15  P-BUF-E-1  PIC X     VALUE SPACES.
                   15  P-BUF-E-2  PIC X     VALUE SPACES.
               10  PRINT-BUF-E-9  REDEFINES PRINTER-BUF-E PIC 99.
               10  PRINTER-BUF-M.
                   15  P-BUF-M-1  PIC X     VALUE SPACES.
                   15  P-BUF-M-2  PIC X     VALUE SPACES.
               10  PRINT-BUF-M-9  REDEFINES PRINTER-BUF-M PIC 99.
               10  PRINTER-BUF-X.
                   15  P-BUF-X-1  PIC X     VALUE SPACES.
                   15  P-BUF-X-2  PIC X     VALUE SPACES.
               10  PRINT-BUF-X-9  REDEFINES PRINTER-BUF-X PIC 99.

       01  BLANK-LINE.
           05  FILLER          PIC XX     VALUE "**".
           05  FILLER          PIC X(76)  VALUE SPACES.
           05  FILLER          PIC XX     VALUE "**".

       01  CUR-DATE-CN.
           05  CUR-DATE-CC     PIC 99.
           05  CUR-DATE.
               10  CUR-DATE-YY PIC 99.
               10  CUR-DATE-MM PIC 99.
               10  CUR-DATE-DD PIC 99.

       01  C-DATE.
           05  C-MM            PIC XX.
           05  SLASH-1         PIC X.
           05  C-DD            PIC XX.
           05  SLASH-2         PIC X.
           05  C-YY            PIC XX.

       01  DATE-HOLD.
           05  DH-MM           PIC 99.
           05  DH-DD           PIC 99.
           05  DH-YY           PIC 99.

       01  DB-DATE.
           05  DB-CC           PIC 99.
           05  DB-YY           PIC 99.
           05  DB-MM           PIC 99.
           05  DB-DD           PIC 99.

       01  CURR-TIME.
           05  CUR-HRS         PIC XX.
           05  CUR-MIN         PIC XX.
           05  CUR-SEC         PIC XX.
           05  FILLER          PIC XX.

       01  C-TIME.
           05  C-HH            PIC XX.
           05  COLON-1         PIC X.
           05  C-MN            PIC XX.
           05  COLON-2         PIC X.
           05  C-SC            PIC XX.

       01  GREG-DATE.
           05  G-YEAR          PIC XXXX.
           05  G-MONTH         PIC XX.
           05  G-DAY           PIC XX.

       01  JULDATE-FIELDS.
           05  JUL-NEW-DELETE  PIC S9(8).
           05  JUL-OLD-DELETE  PIC S9(8).
           05  JUL-TODAY       PIC S9(8).
           05  JUL-PLUS-14     PIC S9(8).

       01  JUL-SIGN            PIC S9(06).
       01  JUL-DATE            PIC  X(07).
       01  JULIAN-DATE         REDEFINES JUL-DATE
                               PIC  9(07).
       01  FILLER              REDEFINES JUL-DATE.
           05  J-YEAR          PIC 9999.
           05  J-DAY           PIC 999.

       01  DB-ERROR.
           05  DB-FUNC   PIC X(10) VALUE SPACES.
           05  DB-FILE   PIC X(18) VALUE SPACES.
           05  FILLER    PIC X(20) VALUE "ERROR - FILE-STAT = ".
           05  CON-WORD  PIC XX.

           COPY SCREENIO       IN COPYLIB.

           COPY CATREAD        IN COPYLIB.

           COPY OVRPFDATA      IN COPYLIB.

           COPY CCHKOBJ        IN COPYLIB.

       01  WO-PERS-DATA.
           COPY MPERSONL       IN COPYLIB.

       01  WO-MESSAGE-DATA.
           COPY DWOMSG         IN COPYLIB.

       LINKAGE SECTION.
       01  DBPARAMETERS.
           COPY DBPARMS        IN COPYLIB.

       01  MSG-AREA.
           05  CNUM-MSG        PIC XXXX.
           05  WONUM-MSG       PIC X(10).
           05  MESSAGE-BUFFER  PIC X(76).

       PROCEDURE DIVISION      USING DBPARAMETERS
                               MSG-AREA.

       CHECK-PASSWORD.
           CALL "TPWORD"       USING PASSWORD-INFORMATION.
           IF PASSWORD-FLAG NOT = "N"
               GO TO BEGIN.
           GOBACK.

       BEGIN.
           OPEN I-O            DISPLAY-FILE.
           OPEN INPUT          PER-PERSONNEL.
           OPEN INPUT          WO-MESSAGE-CC.
           OPEN INPUT          WO-MESSAGE-WO.
           OPEN INPUT          ZONE-PRINTER.
           MOVE ZEROS          TO JULDATE-FIELDS.
      *    MOVE 0              TO OVRPRTF-TOFILE-NUM.
           MOVE "P "           TO OVRPRTF-TOFILE-NUM-X.
           IF CNUM-MSG = SPACES
               MOVE "OMSGWO"   TO SCREEN-NAME
           ELSE
               MOVE "OMSGCC"   TO SCREEN-NAME.

           ACCEPT CUR-DATE     FROM DATE.
           MOVE 20             TO CUR-DATE-CC.
           IF CUR-DATE-YY > 70
               MOVE 19         TO CUR-DATE-CC.

           MOVE "/"            TO SLASH-1 SLASH-2.
           MOVE CUR-DATE-MM    TO C-MM.
           MOVE CUR-DATE-DD    TO C-DD.
           MOVE CUR-DATE-YY    TO C-YY.
           IF DATE-FLAG = 3
              MOVE CUR-DATE-MM TO C-DD
              MOVE CUR-DATE-DD TO C-MM.

           ACCEPT CURR-TIME    FROM TIME.
           MOVE ":"            TO COLON-1 COLON-2.
           MOVE CUR-HRS        TO C-HH.
           MOVE CUR-MIN        TO C-MN.
           MOVE CUR-SEC        TO C-SC.

           MOVE CUR-DATE-CN    TO GREG-DATE.
           MOVE SPACES         TO JUL-DATE D-PARM L-PARM.
           CALL "JULGREG"      USING
                               GREG-DATE
                               JUL-DATE
                               D-PARM
                               L-PARM.
           MOVE JUL-DATE       TO JUL-TODAY.
           MOVE J-DAY          TO JUL-SIGN.
           ADD 14              TO JUL-SIGN.
           PERFORM UNTIL       JUL-SIGN < 366
               SUBTRACT 365    FROM JUL-SIGN
               ADD 1           TO   J-YEAR
           END-PERFORM.
           MOVE JUL-SIGN       TO J-DAY.
           MOVE JUL-DATE       TO JUL-PLUS-14.

           IF WONUM-MSG = SPACES
               MOVE CNUM-MSG      TO PERCCNUM OF PER-PERSONNEL
               READ PER-PERSONNEL INTO WO-PERS-DATA
                   INVALID KEY    MOVE FILE-STAT TO FILE-STAT
                   END-READ
               IF FILE-STAT NOT = "00"
                   MOVE FILE-STAT  TO CON-WORD
                   MOVE "READ    " TO DB-FUNC
                   MOVE "PER-PERSONNEL" TO DB-FILE
                   DISPLAY DB-ERROR
                   GO TO END-OF-JOB
               ELSE
               MOVE PER-MAINT-ZONE TO ZONEKEY OF ZONE-PRINTER
               READ ZONE-PRINTER   INTO ZONE-PRT-BUFFER
                   INVALID KEY     MOVE FILE-STAT TO FILE-STAT
                   END-READ
               IF FILE-STAT NOT = "00"
      *            MOVE 0      TO OVRPRTF-TOFILE-NUM
                   MOVE "P "   TO OVRPRTF-TOFILE-NUM-X
               ELSE
                   MOVE PRINT-BUF-V-9 TO OVRPRTF-TOFILE-NUM
           ELSE
               MOVE DBPARM-PAD   TO ZONEKEY OF ZONE-PRINTER
               READ ZONE-PRINTER INTO ZONE-PRT-BUFFER
                   INVALID KEY   MOVE FILE-STAT TO FILE-STAT
                   END-READ
               IF FILE-STAT NOT = "00"
      *            MOVE 0      TO OVRPRTF-TOFILE-NUM
                   MOVE "P "   TO OVRPRTF-TOFILE-NUM-X
               ELSE
                   MOVE PRINT-BUF-V-9 TO OVRPRTF-TOFILE-NUM.

           IF OVRPRTF-TOFILE-NUM NOT NUMERIC
      *        MOVE 0          TO OVRPRTF-TOFILE-NUM.
               MOVE "P "       TO OVRPRTF-TOFILE-NUM-X.

           COPY OVRPFCALL      IN COPYLIB.

       FIND-CNUM-MSG.
           IF CNUM-MSG = SPACES
               GO TO FIND-WONUM-MSG.
           MOVE CNUM-MSG       TO TOCC OF WO-MESSAGE-CC.
           START WO-MESSAGE-CC KEY > TOCC OF WO-MESSAGE-CC
               INVALID KEY     GO TO 61-READ-END-CC.
           IF FILE-STAT NOT = "00"
               GO TO END-OF-JOB.
           GO TO 61-DBGET-LOOP.

       FIND-WONUM-MSG.
           MOVE WONUM-MSG      TO TOWO OF WO-MESSAGE-WO.
           START WO-MESSAGE-WO KEY > TOWO OF WO-MESSAGE-WO
               INVALID KEY     GO TO 61-READ-END-WO.
           IF FILE-STAT NOT = "00"
               GO TO END-OF-JOB.
           GO TO 61-DBGET-LOOP.

       61-READ-END-CC.
           READ WO-MESSAGE-CC  LAST INTO WO-MESSAGE-DATA
               AT END          MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
               GO TO END-OF-JOB.
           GO TO 61-DBGET-CONT.

       61-READ-END-WO.
           READ WO-MESSAGE-WO  LAST INTO WO-MESSAGE-DATA
               AT END          MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
               GO TO END-OF-JOB.
           GO TO 61-DBGET-CONT.

       61-DBGET-LOOP.
           MOVE SPACE          TO PRINT-BUF.
           IF WONUM-MSG = SPACES
               READ WO-MESSAGE-CC PRIOR RECORD INTO WO-MESSAGE-DATA
                   AT END      MOVE FILE-STAT TO FILE-STAT
                   END-READ
           ELSE
               READ WO-MESSAGE-WO PRIOR RECORD INTO WO-MESSAGE-DATA
                   AT END      MOVE FILE-STAT TO FILE-STAT.

       61-DBGET-CONT.
           IF FILE-STAT NOT = "00"
               GO TO END-OF-JOB.

           IF WONUM-MSG = SPACES
               IF CNUM-MSG NOT = TO-CC
                   GO TO END-OF-JOB
               ELSE
                   NEXT SENTENCE
           ELSE
               IF WONUM-MSG NOT = TO-WO
                   GO TO END-OF-JOB.

           MOVE SPACES         TO SCREEN-DATA MESSAGE-BUFFER.
           MOVE "/"            TO SLASH1 SLASH2.

           MOVE DATE-INIT-MM   TO DATE-BUF-MM.
           MOVE DATE-INIT-DD   TO DATE-BUF-DD.
           MOVE DATE-INIT-YY   TO DATE-BUF-YY.
           IF DATE-FLAG = 3
             MOVE DATE-INIT-MM TO DATE-BUF-DD
             MOVE DATE-INIT-DD TO DATE-BUF-MM.

           MOVE TIME-INIT      TO TIME-BUF.
           MOVE FROM-SIGNON    TO FROM-SIGNON-BUF.
           MOVE MESSAGES-1-5   TO MESSAGE-BUF.

           IF FROM-CC = "9999"
               MOVE SPACES     TO FROM-CC-BUF
           ELSE
               MOVE FROM-CC    TO FROM-CC-BUF.

           IF CNUM-MSG = SPACES
               MOVE 0          TO JUL-OLD-DELETE
               MOVE SPACES     TO TO-CC-BUF
               MOVE TO-WO      TO TO-WO-BUF
           ELSE
               MOVE TO-CC      TO TO-CC-BUF
               MOVE SPACES     TO TO-WO-BUF
               IF DEL-DATE = SPACES
                   MOVE " **NOW**" TO DATE-DISP-X
                   MOVE 0      TO JUL-OLD-DELETE
               ELSE
                   MOVE DEL-DATE     TO DB-DATE
                   MOVE DB-DATE      TO GREG-DATE
                   MOVE SPACES       TO JUL-DATE D-PARM L-PARM
                   CALL "JULGREG"    USING
                                     GREG-DATE
                                     JUL-DATE
                                     D-PARM
                                     L-PARM
                   MOVE JUL-DATE     TO JUL-OLD-DELETE
                   IF JUL-OLD-DELETE > JUL-TODAY
                       MOVE "/"      TO SLASH3 SLASH4
                       MOVE DB-MM    TO DISP-BUF-MM
                       MOVE DB-DD    TO DISP-BUF-DD
                       MOVE DB-YY    TO DISP-BUF-YY
                       IF DATE-FLAG = 3
                           MOVE DB-MM TO DISP-BUF-DD
                           MOVE DB-DD TO DISP-BUF-MM
                       ELSE
                           NEXT SENTENCE
                   ELSE
                       MOVE " **NOW**" TO DATE-DISP-X
                       MOVE 0          TO JUL-OLD-DELETE.

       61-SHOWFORM.
           MOVE SCREEN-DATA    TO DISPLAY-REC.
           MOVE "00"           TO SCREEN-STATUS.

           WRITE DISPLAY-REC   FORMAT IS SCREEN-NAME
               INDIC ARE SCREEN-INDICATORS.
           IF SCREEN-STATUS NOT = "00"
               DISPLAY "SCREEN WRITE ERROR.  SCREEN-STATUS IS "
                               SCREEN-STATUS
               GO TO END-OF-JOB.

           READ  DISPLAY-FILE  FORMAT IS SCREEN-NAME
               INDIC ARE SCREEN-INDICATORS
           IF SCREEN-STATUS NOT = "00"
               DISPLAY "SCREEN READ ERROR.  SCREEN-STATUS IS "
                               SCREEN-STATUS
               GO TO END-OF-JOB.

           MOVE DISPLAY-REC    TO SCREEN-DATA.
           MOVE ALL B"0"       TO SCREEN-INDICATORS.

           IF KEY-HIT = 1 OR 3
               GO TO END-OF-JOB.

           IF KEY-HIT = 2 OR 4 OR 5 OR 6 OR 7 OR 8
               GO TO 61-SHOWFORM.

      ****************************************************************
      *    IF PRINT-BUF NOT = " "
      * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *
      * *  REQUIRES SPECIAL PROGRAMMING TO FORMAT SCREEN PRINT!   * *
      * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *
      *        GO TO 61-SHOWFORM.
      ****************************************************************

           IF PRINT-BUF NOT = " "
               OPEN OUTPUT     CH-PRINT-FILE
               PERFORM         PRINT-LOOP
               CLOSE           CH-PRINT-FILE
               MOVE SPACE      TO PRINT-BUF
               GO TO 61-SHOWFORM.

           IF CNUM-MSG = SPACES
               GO TO 61-DBGET-LOOP.

           IF SPACES = DD-MM AND DD-DD AND DD-YY
               IF JUL-OLD-DELETE = 0
                   MOVE "D"    TO UPDATE-SW
                   GO TO UPDATE-FILE
               ELSE
               IF JUL-OLD-DELETE > JUL-TODAY
                   GO TO 61-DBGET-LOOP
               ELSE
                   MOVE "D"    TO UPDATE-SW
                   GO TO UPDATE-FILE.

           IF DATE-FLAG = 1
               IF DD-MM NOT NUMERIC
                   MOVE  35    TO CATREAD-MSG-SET
                   MOVE  31    TO CATREAD-MSG-NUM
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE 27     TO FIELD-NUMBER
                   PERFORM 65-ERROR
                   GO TO 61-SHOWFORM
               ELSE
               IF DD-DD NOT NUMERIC
                   MOVE  35    TO CATREAD-MSG-SET
                   MOVE  30    TO CATREAD-MSG-NUM
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE 29     TO FIELD-NUMBER
                   PERFORM 65-ERROR
                   GO TO 61-SHOWFORM
           ELSE
               IF DD-MM NOT NUMERIC
                   MOVE  35    TO CATREAD-MSG-SET
                   MOVE  30    TO CATREAD-MSG-NUM
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE 27     TO FIELD-NUMBER
                   PERFORM 65-ERROR
                   GO TO 61-SHOWFORM
               ELSE
               IF DD-DD NOT NUMERIC
                   MOVE  35    TO CATREAD-MSG-SET
                   MOVE  31    TO CATREAD-MSG-NUM
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE 29     TO FIELD-NUMBER
                   PERFORM 65-ERROR
                   GO TO 61-SHOWFORM.

           IF DD-YY IS NUMERIC
               IF DATE-FLAG = 1
                   IF DD-MM > 0 AND DD-MM < 13
                       IF DD-DD > 0 AND DD-DD < 32
                           NEXT SENTENCE
                       ELSE
                           MOVE  35 TO CATREAD-MSG-SET
                           MOVE  30 TO CATREAD-MSG-NUM
                           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                           MOVE 29  TO FIELD-NUMBER
                           PERFORM 65-ERROR
                           GO TO 61-SHOWFORM
                   ELSE
                       MOVE 35 TO CATREAD-MSG-SET
                       MOVE 31 TO CATREAD-MSG-NUM
                       PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                       MOVE 27 TO FIELD-NUMBER
                       PERFORM 65-ERROR
                       GO TO 61-SHOWFORM
               ELSE
                   IF DD-MM > 0 AND DD-MM < 32
                       IF DD-DD > 0 AND DD-DD < 13
                           NEXT SENTENCE
                       ELSE
                           MOVE  35 TO CATREAD-MSG-SET
                           MOVE  31 TO CATREAD-MSG-NUM
                           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                           MOVE 29  TO FIELD-NUMBER
                           PERFORM 65-ERROR
                           GO TO 61-SHOWFORM
                   ELSE
                       MOVE 35 TO CATREAD-MSG-SET
                       MOVE 30 TO CATREAD-MSG-NUM
                       PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                       MOVE 27 TO FIELD-NUMBER
                       PERFORM 65-ERROR
                       GO TO 61-SHOWFORM
           ELSE
               MOVE  35        TO CATREAD-MSG-SET
               MOVE  32        TO CATREAD-MSG-NUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE 30         TO FIELD-NUMBER
               PERFORM 65-ERROR
               GO TO 61-SHOWFORM.

           IF DATE-FLAG = 1
               MOVE DD-YY      TO DB-YY
               MOVE DD-MM      TO DB-MM
               MOVE DD-DD      TO DB-DD
           ELSE
               MOVE DD-YY      TO DB-YY
               MOVE DD-DD      TO DB-MM
               MOVE DD-MM      TO DB-DD.

           MOVE 20             TO DB-CC.
           IF DB-YY > 70
               MOVE 19         TO DB-CC.

           MOVE DB-DATE        TO GREG-DATE.
           MOVE SPACES         TO JUL-DATE D-PARM L-PARM.
           CALL "JULGREG"      USING
                               GREG-DATE
                               JUL-DATE
                               D-PARM
                               L-PARM.
           MOVE JUL-DATE       TO JUL-NEW-DELETE.

           IF JUL-NEW-DELETE < JUL-TODAY
               MOVE  30        TO CATREAD-MSG-SET
               MOVE  22        TO CATREAD-MSG-NUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE 27         TO FIELD-NUMBER
               PERFORM 65-ERROR
               GO TO 61-SHOWFORM.

           IF JUL-NEW-DELETE > JUL-PLUS-14
               MOVE  39        TO CATREAD-MSG-SET
               MOVE  10        TO CATREAD-MSG-NUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE 27         TO FIELD-NUMBER
               PERFORM 65-ERROR
               GO TO 61-SHOWFORM.

           MOVE DB-DATE        TO DEL-DATE.
           MOVE "U"            TO UPDATE-SW.

       UPDATE-FILE.
           CALL "TUPDATEM"     USING WO-MESSAGE-DATA
                               UPDATE-SW
                               UPDATE-ERROR.
           IF UPDATE-ERROR NOT = SPACES
               MOVE UPDATE-ERROR TO MESSAGE-BUFFER
               IF KEY-HIT = 1 OR 3
                   DISPLAY MESSAGE-BUFFER
                   GO TO END-OF-JOB
               ELSE
                   MOVE 27     TO FIELD-NUMBER
                   PERFORM 65-ERROR
                   GO TO 61-SHOWFORM.

           GO TO 61-DBGET-LOOP.

       END-OF-JOB.
           IF MESSAGE-BUFFER NOT = SPACES
               GO TO GOBACK-FUNCTION.

      ***********************************************************
      ***  MESSAGE:  NO MESSAGES AT THIS TIME
      ***********************************************************
           MOVE  40            TO CATREAD-MSG-SET.
           MOVE  36            TO CATREAD-MSG-NUM.
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.

       GOBACK-FUNCTION.
      *    IF OVRPRTF-TOFILE-NUM NOT = 0
      *        MOVE "DLTOVR FILE(MCPRT)" TO OVRPRTF-PARM1
      *        CALL "QCMDEXC"  USING OVRPRTF-PARM1, OVRPRTF-PARM2.
           IF OVRPRTF-TOFILE-NUM-X = "F "
               NEXT SENTENCE
           ELSE
           IF OVRPRTF-TOFILE-NUM = 0
               NEXT SENTENCE
           ELSE
           MOVE "DLTOVR FILE(MCPRT)" TO OVRPRTF-PARMS
           CALL "QCMDEXC" USING OVRPRTF-PARM1, OVRPRTF-PARM2.
           CLOSE               DISPLAY-FILE.
           CLOSE               PER-PERSONNEL.
           CLOSE               WO-MESSAGE-CC.
           CLOSE               WO-MESSAGE-WO.
           CLOSE               ZONE-PRINTER.
           GOBACK.

       PRINT-LOOP.
           STRING "        DATE:  " C-DATE "               "
                  "                    TIME:  " C-TIME
                  DELIMITED BY SIZE INTO PRINT-REC.
           WRITE PRINT-REC     AFTER ADVANCING 4.

           MOVE ALL "*"        TO PRINT-REC.
           WRITE PRINT-REC     AFTER ADVANCING 2.

           STRING "*****                    MMIS ELECTRONIC"
                  " MESSAGE SYSTEM                   ******"
                  DELIMITED BY SIZE INTO PRINT-REC.
           WRITE               PRINT-REC.

           MOVE ALL "*"        TO PRINT-REC.
           WRITE PRINT-REC.

           MOVE BLANK-LINE     TO PRINT-REC.
           WRITE PRINT-REC.

           STRING
               "**  MESSAGE SENT ON:    " DATE-BUF " AT:  " TIME-BUF
               "                                    **"
               DELIMITED BY SIZE INTO PRINT-REC.
           WRITE               PRINT-REC.

           MOVE BLANK-LINE     TO PRINT-REC.
           WRITE PRINT-REC.

           IF CNUM-MSG = SPACES
               MOVE "WORKORDER " TO CCWO-LIT
               MOVE TO-WO-BUF    TO CCWO-BUF
           ELSE
               MOVE "CLOCK CARD" TO CCWO-LIT
               MOVE TO-CC-BUF    TO CCWO-BUF.

           STRING "**  MESSAGE SENT TO:    " CCWO-LIT " " CCWO-BUF
               "                                 **"
                  DELIMITED BY SIZE INTO PRINT-REC.
           WRITE               PRINT-REC.

           MOVE BLANK-LINE     TO PRINT-REC.
           WRITE               PRINT-REC.

           STRING "**  MESSAGE SENT FROM:  " FROM-CC-BUF
                  " " FROM-SIGNON-BUF
               "                     **"
                  DELIMITED BY SIZE INTO PRINT-REC.
           WRITE               PRINT-REC.

           MOVE BLANK-LINE     TO PRINT-REC.
           WRITE               PRINT-REC.

           STRING "**  MESSAGE:                            "
                  "                                      **"
                  DELIMITED BY SIZE INTO PRINT-REC.
           WRITE               PRINT-REC.

           MOVE BLANK-LINE     TO PRINT-REC.
           WRITE               PRINT-REC.

           STRING "**   " MESSAGE-1-BUF
               "   **"
               DELIMITED BY SIZE INTO PRINT-REC.
           WRITE               PRINT-REC.

           STRING "**   " MESSAGE-2-BUF
               "   **"
               DELIMITED BY SIZE INTO PRINT-REC.
           WRITE               PRINT-REC.

           STRING "**   " MESSAGE-3-BUF
               "   **"
               DELIMITED BY SIZE INTO PRINT-REC.
           WRITE               PRINT-REC.

           STRING "**   " MESSAGE-4-BUF
               "   **"
               DELIMITED BY SIZE INTO PRINT-REC.
           WRITE               PRINT-REC.

           STRING "**   " MESSAGE-5-BUF
               "   **"
               DELIMITED BY SIZE INTO PRINT-REC.
           WRITE               PRINT-REC.

           MOVE BLANK-LINE     TO PRINT-REC.
           WRITE               PRINT-REC.

           MOVE ALL "*"        TO PRINT-REC.
           WRITE               PRINT-REC.

       65-ERROR.
           MOVE MESSAGE-BUFFER TO ERRMSG.
           MOVE TRUE-VALUE     TO IND (FIELD-NUMBER) IND (99).

       999-CATREAD.
           MOVE SPACES         TO MESSAGE-BUFFER.
           CALL "CCATREAD"     USING CATREAD-PARMS.
           MOVE CATREAD-MSG-TEXT TO MESSAGE-BUFFER.

       999-CATREAD-EXIT.       EXIT.

