       IDENTIFICATION DIVISION.
       PROGRAM-ID.             TIERCHTP.
       AUTHOR.                 W. ROXBURY.
       INSTALLATION.           GOODYEAR TIRE & RUBBER CO.
      *REMARKS.           ***  THIS PROGRAM ALLOWS MASS CHANGES OF
      *                        ALL RECORDS IN THE EQUIPMENT REFERENCE
      *                        FILE TO MATCH A CHANGED EQUIPMENT TYPE
      *                        NUMBER IN THE MMIS EQUIPMENT FILE
      *                        ****.
       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.
       SOURCE-COMPUTER.        IBM-AS400.
       OBJECT-COMPUTER.        IBM-AS400.

       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT EQP-REFERENCE
                  ASSIGN       TO DATABASE-MCFLER0101
                  ORGANIZATION IS INDEXED
                  ACCESS MODE  IS DYNAMIC
                  RECORD KEY   IS EXTERNALLY-DESCRIBED-KEY
                  FILE STATUS  IS FILE-STAT.

           SELECT EQP-EQUIPMENT
                  ASSIGN       TO DATABASE-MCFLMM0201
                  ORGANIZATION IS INDEXED
                  ACCESS MODE  IS DYNAMIC
                  RECORD KEY   IS EXTERNALLY-DESCRIBED-KEY
                  FILE STATUS  IS FILE-STAT.

           SELECT PRINT-FILE
                  ASSIGN       TO PRINTER-MCPRT.

       DATA DIVISION.
       FILE SECTION.
       FD  EQP-REFERENCE
           LABEL RECORDS ARE STANDARD.
       01  ERREC.
           COPY DDS-ALL-FORMATS OF MCFLER0101.

       FD  EQP-EQUIPMENT
           LABEL RECORDS ARE STANDARD.
       01  EEREC.
           COPY DDS-ALL-FORMATS OF MCFLMM0201.

       FD  PRINT-FILE RECORD   CONTAINS 80 CHARACTERS
           LABEL RECORD        IS OMITTED
           DATA RECORD         IS PRINT-REC.
       01  PRINT-REC           PIC X(80).

       WORKING-STORAGE SECTION.
       77  COUNTER             PIC 9(08) VALUE 0.
       77  CNTR                PIC ZZZZZZZ9.
       77  STARLINE            PIC X(50) VALUE ALL "*".
       77  CURRENT-DATE        PIC X(08).
       77  TIME-OF-DAY         PIC X(06).
       77  DSET-REF            PIC X(14) VALUE "EQP-REFERENCE".
       77  DSET-EQP            PIC X(14) VALUE "EQP-EQUIPMENT".

       01  FILE-STAT.
           05  FILE-STAT-1         PIC X.
           05  FILE-STAT-2         PIC X.

       01  EQUIP-BUFFER.
           05  EQUIP-BUF       PIC X(06).
           05  EQUIP-SS        PIC X(04).

       01  ERROR-FILE-DATA.
           05  ERROR-LINE-1.
               10  TRANS-TYPE  PIC  X(44) VALUE SPACES.
           05  ERROR-LINE-2.
               10  FILLER      PIC  X(22)
                               VALUE "          PARAGRAPH:  ".
               10  PARA        PIC  X(24).
           05  ERROR-LINE-3.
               10  FILLER      PIC  X(20)
                               VALUE "               BASE:".
               10  DATA-BASE   PIC  X(06).
           05  ERROR-LINE-4.
               10  FILLER      PIC  X(22)
                               VALUE "            DATASET:  ".
               10  DATA-SET    PIC  X(16).
           05  ERROR-LINE-5.
               10  FILLER      PIC  X(22)
                               VALUE "         ERROR CODE:  ".
               10  COND-CODE   PIC XX.

       01  MESSAGE-BUFFER-DATA.
           COPY ERRORLIN       IN COPYLIB.

       01  EQP-EQUIPMENT-DATA.
           COPY MEQPFILE       IN COPYLIB.

      *01  DBPARAMETERS.
      *    COPY DBPARMS        IN COPYLIB.

           COPY MEQPREF        IN COPYLIB.

           COPY OVRPFDATA      IN COPYLIB.

       PROCEDURE DIVISION.
       INITIALIZATION.
           MOVE SPACES         TO EQUIP-BUFFER.
           MOVE  0             TO COUNTER.
           OPEN I-O            EQP-REFERENCE.
           OPEN INPUT          EQP-EQUIPMENT.

      *    MOVE 0              TO OVRPRTF-TOFILE-NUM.
           MOVE "P "           TO OVRPRTF-TOFILE-NUM-X.
           COPY OVRPFCALL      IN COPYLIB.
           OPEN OUTPUT         PRINT-FILE.

       READ-FIRST-RECORD.
           READ EQP-REFERENCE  FIRST INTO BUF-EQP-REF
               AT END          MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT = "10" OR "14" OR "46"
               GO TO END-OF-JOB
           ELSE
           IF FILE-STAT NOT = "00"
               MOVE  "     READ   /FIRST ERROR IN PROGRAM TIERCHTP"
                               TO TRANS-TYPE
               MOVE """READ-FIRST-RECORD."""
                               TO PARA
               MOVE "EQPREF"   TO DATA-BASE
               MOVE DSET-REF   TO DATA-SET
               PERFORM WRITE-DB-ERROR
               GO TO END-OF-JOB.

           GO TO MAIN-PROC-CONT.

       MAIN-PROCESSING.
           READ EQP-REFERENCE  NEXT INTO BUF-EQP-REF
               AT END          MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT = "10" OR "14" OR "46"
               GO TO END-OF-JOB
           ELSE
           IF FILE-STAT NOT = "00"
               MOVE  "     READ   /NEXT  ERROR IN PROGRAM TIERCHTP"
                               TO TRANS-TYPE
               MOVE """MAIN-PROCESSING."""
                               TO PARA
               MOVE "EQPREF"   TO DATA-BASE
               MOVE DSET-REF   TO DATA-SET
               PERFORM WRITE-DB-ERROR
               GO TO END-OF-JOB.

       MAIN-PROC-CONT.
           IF ESK-EQUIP NOT = EQUIP-BUFFER
               MOVE EQP-SUB-KEY TO EQUIP-BUFFER
               PERFORM GET-TYPE-NUMBER THRU GTN-EXIT
               IF FILE-STAT = "23"
                   GO TO MAIN-PROCESSING.

           IF EQP-CORP-TYPE = EQP-TYPE
               GO TO MAIN-PROCESSING.

           MOVE SPACES         TO PRINT-REC.
           WRITE               PRINT-REC.
           STRING "FOR EQUIPMENT " EQUIP-BUF
                   "  SUBSYSTEM " EQUIP-SS
                               DELIMITED BY SIZE
                               INTO PRINT-REC.
           WRITE               PRINT-REC.
           STRING "  TYPE NUMBER """ EQP-CORP-TYPE
                   """ IN THE EQUIPMENT REFERENCE FILE"
                               DELIMITED BY SIZE
                               INTO PRINT-REC.
           WRITE               PRINT-REC.
           STRING "  HAS BEEN CHANGED TO """ EQP-TYPE """"
                   " TO MATCH THE MMISA EQUIPMENT FILE."
                               DELIMITED BY SIZE
                               INTO PRINT-REC.
           WRITE               PRINT-REC.

           ADD  1              TO COUNTER.
           MOVE EQP-TYPE       TO EQP-CORP-TYPE.

           REWRITE ERREC       FROM BUF-EQP-REF
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
               MOVE  "    REWRITE RECORD ERROR IN PROGRAM TIERCHTP"
                               TO TRANS-TYPE
               MOVE """MAIN-PROC-CONT."""
                               TO PARA
               MOVE "EQPREF"   TO DATA-BASE
               MOVE DSET-REF   TO DATA-SET
               PERFORM WRITE-DB-ERROR
               GO TO END-OF-JOB.

           GO TO MAIN-PROCESSING.

       GET-TYPE-NUMBER.
           MOVE EQUIP-BUF      TO EQPNUM OF EQP-EQUIPMENT.
           READ EQP-EQUIPMENT  INTO EQP-EQUIPMENT-DATA
                INVALID KEY    MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT = "23"
               GO TO GTN-EXIT
           ELSE
           IF FILE-STAT NOT = "00"
               MOVE  "     READ ERROR IN PROGRAM TIERCHTP"
                               TO TRANS-TYPE
               MOVE """GET-TYPE-NUMBER."""
                               TO PARA
               MOVE " MMISA"   TO DATA-BASE
               MOVE DSET-EQP   TO DATA-SET
               PERFORM WRITE-DB-ERROR
               GO TO END-OF-JOB.

       GTN-EXIT.               EXIT.

       END-OF-JOB.
           IF COUNTER > 0
               MOVE COUNTER    TO CNTR
               MOVE SPACES     TO PRINT-REC
               WRITE           PRINT-REC
               MOVE STARLINE   TO PRINT-REC
               WRITE           PRINT-REC
               STRING "    TOTAL NUMBER OF RECORDS CHANGED:  " CNTR
                               DELIMITED BY SIZE
                               INTO PRINT-REC
               WRITE           PRINT-REC
               MOVE STARLINE   TO PRINT-REC
               WRITE           PRINT-REC
           ELSE
               MOVE SPACES     TO PRINT-REC
               WRITE           PRINT-REC
               MOVE STARLINE   TO PRINT-REC
               WRITE           PRINT-REC
               MOVE "  TYPE NUMBERS IN THE EQUIPMENT REFERENCE FILE"
                               TO PRINT-REC
               WRITE           PRINT-REC
               MOVE "  MATCH THE MMISA EQUIPMENT FILE."
                               TO PRINT-REC
               WRITE           PRINT-REC
               MOVE "  >> NO RECORDS WERE CHANGED <<"
                               TO PRINT-REC
               WRITE           PRINT-REC
               MOVE STARLINE   TO PRINT-REC
               WRITE           PRINT-REC.

           CLOSE               EQP-REFERENCE.
           CLOSE               EQP-EQUIPMENT.
           CLOSE               PRINT-FILE.
           GOBACK.

       WRITE-DB-ERROR.
           MOVE FILE-STAT      TO COND-CODE.
           MOVE SPACES         TO PRINT-REC.
           WRITE               PRINT-REC.
           ACCEPT CURRENT-DATE FROM DATE.
           ACCEPT TIME-OF-DAY  FROM TIME.
           STRING              "    " CURRENT-DATE
                               "                        "
                               TIME-OF-DAY
                               DELIMITED BY SIZE
                               INTO PRINT-REC.
           WRITE               PRINT-REC.
           WRITE               PRINT-REC.
           MOVE STARLINE       TO PRINT-REC.
           WRITE               PRINT-REC.
           MOVE ERROR-LINE-1   TO PRINT-REC.
           WRITE               PRINT-REC.
           MOVE STARLINE       TO PRINT-REC.
           WRITE               PRINT-REC.
           DISPLAY             "            RUN MODULE:  XCHGTYPE".
           WRITE               PRINT-REC.
           MOVE ERROR-LINE-2   TO PRINT-REC.
           WRITE               PRINT-REC.
           MOVE ERROR-LINE-3   TO PRINT-REC.
           WRITE               PRINT-REC.
           MOVE ERROR-LINE-4   TO PRINT-REC.
           WRITE               PRINT-REC.
           MOVE ERROR-LINE-5   TO PRINT-REC.
           WRITE               PRINT-REC.
           MOVE STARLINE       TO PRINT-REC.
           WRITE               PRINT-REC.

      *******************  END OF FILE TIERCHTP  ************************
