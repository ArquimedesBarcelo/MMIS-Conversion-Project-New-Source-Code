000200 IDENTIFICATION DIVISION.
000300 PROGRAM-ID. TREQRPT.
000400 AUTHOR.     KURT MOVSESIAN/JIM COFFMAN (MAINTAINER).

000600*     THIS PROGRAM GIVES A LISTING OF ALL REQUISITIONS NOT ACTED
000700*     UPON BY MATERIALS CONTROL. THE INPUT USED IS THE DATA BASE
000800*     THE OUTPUT IS A REPORT.
      *
      *C  JUNE 23, 1994   CR KALMAN
      *C   ADDED CALL TO COBOL ERROR HANDLER -MCXCBLERR.
      *C
      *C  MAY 2, 1996     CA YODER    REQ #95-041
      *C   ADDED THE DATE THAT THE REQ WAS RETURNED BY PURCHASING TO
      *C   MATERIALS CONTROL TO THE REPORT.
      *C
      *C  SEPT 05, 1996   CA YODER
      *C   MODIFIED PROGRAM FOR CENTURY DATABASE CHANGES.
      *C
000900
002700
002800
002900 ENVIRONMENT DIVISION.
003000 CONFIGURATION SECTION.
003100 SOURCE-COMPUTER.  HP-3000.
003200 OBJECT-COMPUTER.  HP-3000.
003300
003400 SPECIAL-NAMES. C01 IS NEW-PAGE.
003600
003700 INPUT-OUTPUT SECTION.
003800 FILE-CONTROL.
003900     SELECT ONLINE-PRT ASSIGN TO PRINTER-MCPRT.
004000     SELECT SORT-FILE ASSIGN TO DISK-SORT.

           SELECT MPLTINFO-I
                  ASSIGN TO DATABASE-MCFLCS0501
                  ORGANIZATION IS INDEXED
                    ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                  FILE STATUS IS FILE-STATUS.

           SELECT MREQ-I
                  ASSIGN TO DATABASE-MCFLCS2001
                  ORGANIZATION IS INDEXED
                    ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                  FILE STATUS IS FILE-STATUS.

           SELECT MSTORERM-I
                  ASSIGN TO DATABASE-MCFLCS0201
                  ORGANIZATION IS INDEXED
                    ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                  FILE STATUS IS FILE-STATUS.

           SELECT DREQITM-I
                  ASSIGN TO DATABASE-MCFLCS2201
                  ORGANIZATION IS INDEXED
                    ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                    WITH DUPLICATES
                  FILE STATUS IS FILE-STATUS.
026200
           SELECT DREQDESC-I
                  ASSIGN TO DATABASE-MCFLCS2301
                  ORGANIZATION IS INDEXED
                    ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                    WITH DUPLICATES
                  FILE STATUS IS FILE-STATUS.
004100
004200 DATA DIVISION.
004300 FILE SECTION.
004400
004500 FD  ONLINE-PRT
004600     LABEL RECORDS ARE OMITTED
004700     RECORD CONTAINS 132 CHARACTERS
004800     DATA RECORD IS PRINT-RCD.
004900 01  PRINT-RCD.
005000     05  PRINT-LINE        PIC X(132).
005100
005200 SD  SORT-FILE
005300     RECORD CONTAINS 58 CHARACTERS.
005400 01  SORT-RCD.
005500     05  SORT-REQ-NO           PIC X(7).
           05  SORT-REQ-DATE-CN.
               10  SORT-DATE-CC      PIC X(2).
005600         10  SORT-REQ-DATE     PIC X(6).
           05  SORT-REQ-DATE-WANT-CN.
               10  SORT-WANT-CC        PIC X(2).
005700         10  SORT-REQ-DATE-WANT  PIC X(6).
           05  SORT-REQ-DATE-RET-CN.
               10  SORT-RET-CC       PIC X(2).
               10  SORT-REQ-DATE-RET PIC X(6).
005800     05  SORT-REQ-CODE         PIC X(7).
005900     05  SORT-SOQ              PIC S9(8).
006000     05  SORT-QTY-UM           PIC XX.
006100     05  SORT-HOLD-STATUS      PIC X(10).
006200
       FD  MPLTINFO-I
           LABEL RECORDS ARE STANDARD.
       01  MPLTINFO-REC-I.
           COPY DDS-ALL-FORMATS  OF MCFLCS0501.

       FD  MREQ-I
           LABEL RECORDS ARE STANDARD.
       01  MREQ-REC-I.
           COPY DDS-ALL-FORMATS  OF MCFLCS2001.

       FD  MSTORERM-I
           LABEL RECORDS ARE STANDARD.
       01  MSTORERM-REC-I.
           COPY DDS-ALL-FORMATS  OF MCFLCS0201.

       FD  DREQITM-I
           LABEL RECORDS ARE STANDARD.
       01  DREQITM-REC-I.
           COPY DDS-ALL-FORMATS  OF MCFLCS2201.

       FD  DREQDESC-I
           LABEL RECORDS ARE STANDARD.
       01  DREQDESC-REC-I.
           COPY DDS-ALL-FORMATS  OF MCFLCS2301.

006400 WORKING-STORAGE SECTION.
       01  FILE-STATUS.
           05  FILE-STATUS-1            PIC X  VALUE "0".
           05  FILE-STATUS-2            PIC X  VALUE "0".
9406CK 01  SCOPE   PIC X.
006500
