       IDENTIFICATION DIVISION.
       PROGRAM-ID.             TMCREW.
       AUTHOR.                 W. ROXBURY.
       INSTALLATION.           GOODYEAR TIRE & RUBBER CO.
       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.
       SOURCE-COMPUTER.        IBM-AS400.
       OBJECT-COMPUTER.        IBM-AS400.

      *C****************************************************************
      *C*  01/28/97  WDR
      *C*  RE-WROTE ENTIRE PROGRAM TO MAKE MORE USER-FRIENDLY.
      *C****************************************************************

       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT CREW-FILE
                  ASSIGN TO DATABASE-MCFLMM3401
                  ORGANIZATION IS INDEXED
                  ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                  FILE STATUS  IS FILE-STAT.

           SELECT DISPLAY-FILE
                  ASSIGN       TO WORKSTATION-ZMASTER-SI
                  ORGANIZATION IS TRANSACTION
                  ACCESS MODE  IS DYNAMIC
                  RELATIVE KEY IS RECNO
                  FILE STATUS  IS SCREEN-STATUS
                               MAJOR-MINOR
                  CONTROL-AREA IS SCREEN-CONTROL.

       DATA DIVISION.
       FILE SECTION.
       FD  CREW-FILE
           LABEL RECORDS       ARE STANDARD.
       01  CREW-REC.
           COPY DDS-ALL-FORMATS OF MCFLMM3401.

       FD  DISPLAY-FILE
           LABEL RECORDS ARE OMITTED.
       01  DISPLAY-REC         PIC X(2000).

       WORKING-STORAGE SECTION.
       77  MSG-SW              PIC  X(01).
       77  MSG-BUFFER          PIC  X(76).
       77  CREW-KEY            PIC  X(01).
       77  RECNO               PIC  9999   VALUE 0.
       77  DISP-CNTR           PIC  99     VALUE 0.
       77  TRUE-VAL            PIC  1      VALUE B"1".
       77  NEG-VAL             PIC  1      VALUE B"0".

       01  PASSWORD-INFORMATION.
           05  NAME-OF-PROGRAM     PIC X(08) VALUE "TMCREW  ".
           05  PROGRAM-TYPE        PIC X(02) VALUE "MA".
           05  PROGRAM-RELEASE     PIC X(12) VALUE " K0100010001".
           05  PROGRAM-DESCRIPTION.
               10  PROG-DESC-A     PIC X(60) VALUE
           "MAINTENANCE OF THE MMIS CREW FILE IN THE MMIS DATABASE. ".
               10  PROG-DESC-B     PIC X(60) VALUE SPACES.
               10  PROG-FUNCTION   PIC X(60) VALUE SPACES.
           05  PASSWORD-FLAG       PIC X.

       01  FILE-STAT.
           05  FILE-STAT-1     PIC X  VALUE "0".
           05  FILE-STAT-2     PIC X  VALUE "0".

       01  SCREEN-MENU.
           05  CREW-ADD        PIC X(01).
           05  CREW-DEL        PIC X(01).
           05  MSGFLDM         PIC X(76).
           05  CMDMSGM         PIC X(79).
           05  ERRMSGM         PIC X(79).

       01  SCREEN-ADD.
           05  ADD-SCREEN.
               10  ACREW       PIC X(01).
           05  CMDMSGA         PIC X(79).
           05  ERRMSGA         PIC X(79).

       01  SCREEN-DELETE.
           05  DEL-SCREEN.
               10  DCREW       PIC X(01).
           05  CMDMSGD         PIC X(79).
           05  ERRMSGD         PIC X(79).

       01  SCREEN-DISPLAY.
           05  SCREW           PIC X(01).

       01  SCREEN-MSG.
           05  MSG1            PIC X(10) VALUE "THE CREW '".
           05  MSG2            PIC X(11) VALUE "' HAS BEEN ".
           05  MSG3            PIC X(15) VALUE "YOUR CREW FILE.".
           05  MSGA            PIC X(09) VALUE "ADDED TO ".
           05  MSGD            PIC X(13) VALUE "DELETED FROM ".

       01  CREW-DATA.
           05  CREW-MSTR       PIC X(01).
           05  CREW-FILL       PIC X(01).

           COPY SCREENIO       IN COPYLIB.

       01  MESSAGE-FILE-DATA.
           COPY ERRORLIN       IN COPYLIB.

       PROCEDURE DIVISION.
       OPEN-PARAGRAPH.
           MOVE SPACE          TO MSG-SW.
           OPEN I-O            DISPLAY-FILE.
           OPEN I-O            CREW-FILE.

           CALL "TPWORD"       USING PASSWORD-INFORMATION.
           IF PASSWORD-FLAG = "N"
               GO TO END-OF-JOB.

      *C****************************************************************
      *-- DISPLAY MAIN MENU/INPUT SCREEN (OR HELP/INPUT SCREEN)
      *C****************************************************************

       SETUP-MENU-SCREEN.
           MOVE SPACES         TO SCREEN-MENU
                                  SCREEN-ADD
                                  SCREEN-DELETE.

           MOVE "CREWMENU"     TO SCREEN-NAME.

       SHOW-MENU-SCREEN.
           IF MSG-SW NOT = SPACE
               MOVE SPACE      TO MSG-SW
               MOVE MSG-BUFFER TO MSGFLDM
           ELSE
               MOVE SPACES     TO MSGFLDM.

           MOVE "00"           TO SCREEN-STATUS.
           MOVE  SCREEN-MENU   TO DISPLAY-REC.

           WRITE DISPLAY-REC   FORMAT IS SCREEN-NAME
                               INDIC ARE SCREEN-INDICATORS.
           IF SCREEN-STATUS NOT = "00"
               DISPLAY "SCREEN WRITE ERROR.  SCREEN-STATUS IS "
                               SCREEN-STATUS
               GO TO END-OF-JOB.

           READ  DISPLAY-FILE  FORMAT IS SCREEN-NAME
                               INDIC ARE SCREEN-INDICATORS
           IF SCREEN-STATUS NOT = "00"
               DISPLAY "SCREEN READ ERROR.  SCREEN-STATUS IS "
                               SCREEN-STATUS
               GO TO END-OF-JOB.

           MOVE ALL B"0"       TO SCREEN-INDICATORS.
           MOVE DISPLAY-REC    TO SCREEN-MENU.

           IF KEY-HIT = 3 OR 8
               GO TO END-OF-JOB.

           IF KEY-HIT = 9
               GO TO SETUP-MENU-SCREEN.

           IF KEY-HIT = 1 OR 2 OR 4 OR 5 OR 6 OR 7
               GO TO READ-SCREEN-CONT.

      *C****************************************************************
      *-- DETERMINE IF ONLY ONE FIELD IS FILLED AND SET FUNCTION KEY
      *-- SO 'ENTER' KEY WILL FUNCTION FOR THAT FIELD ONLY.
      *C****************************************************************

           MOVE  0             TO DISP-CNTR.
           IF CREW-ADD NOT = SPACES
               ADD 1           TO DISP-CNTR.

           IF CREW-DEL NOT = SPACES
               ADD 3           TO DISP-CNTR.

      *C****************************************************************
      *-- IF MORE THAN ONE FIELD IS FILLED, DISPLAY ERROR DESIGNATING
      *-- THAT USER PRESS THE DESIRED FUNCTION KEY.
      *C****************************************************************

           IF DISP-CNTR = 1 OR 3
               NEXT SENTENCE
           ELSE
      *M****************************************************************
      *M    MESSAGE 042/017:
      *M  PRESS APPROPRIATE FUNCTION KEY TO CONTINUE
      *M****************************************************************
               MOVE "PRESS APPROPRIATE FUNCTION KEY TO CONTINUE"
                               TO ERRMSGM
               MOVE TRUE-VAL   TO IND(99)
               GO TO SHOW-MENU-SCREEN.

           IF DISP-CNTR = 1
               MOVE 1          TO KEY-HIT
           ELSE
           IF DISP-CNTR = 3
               MOVE 4          TO KEY-HIT.

      *C****************************************************************
      *-- EDIT FIELDS FILLED AND DETERMINE VALID INPUT FOR FUNCTION
      *-- REQUESTED.  IF VALID, PERFORM FUNCTION.
      *C****************************************************************

       READ-SCREEN-CONT.
           IF KEY-HIT = 1
               IF CREW-ADD = SPACES
      *M********************************************************************
      *M    MESSAGE 029/032:
      *M CREW IS REQUIRED
      *M********************************************************************
                   MOVE "CREW IS REQUIRED"
                                 TO ERRMSGM
                   MOVE TRUE-VAL TO IND(1) IND(99)
                   GO TO SHOW-MENU-SCREEN
               ELSE
                   MOVE CREW-ADD TO CREW-KEY
                   PERFORM CHECK-CREW THRU CHECK-CREW-EXIT
                   IF FILE-STAT = "23"
                       PERFORM ADD-CREW THRU ADD-CREW-EXIT
                       GO TO SETUP-MENU-SCREEN
                   ELSE
                   IF FILE-STAT = "00"
      *M********************************************************************
      *M    MESSAGE 000/003:
      *M CREW ALREADY EXISTS
      *M********************************************************************
                       MOVE "CREW ALREADY EXISTS"
                                       TO ERRMSGM
                       MOVE TRUE-VAL   TO IND(1) IND(99)
                       GO TO SHOW-MENU-SCREEN
                   ELSE
                       MOVE MESSAGE-BUFFER TO ERRMSGM
                       MOVE TRUE-VAL   TO IND(1) IND(99)
                       GO TO SHOW-MENU-SCREEN.

           IF KEY-HIT = 4
               IF CREW-DEL = SPACES
      *M********************************************************************
      *M    MESSAGE 029/032:
      *M CREW IS REQUIRED
      *M********************************************************************
                   MOVE "CREW IS REQUIRED"
                                 TO ERRMSGM
                   MOVE TRUE-VAL TO IND(3) IND(99)
                   GO TO SHOW-MENU-SCREEN
               ELSE
                   MOVE CREW-DEL TO CREW-KEY
                   PERFORM CHECK-CREW THRU CHECK-CREW-EXIT
                   IF FILE-STAT = "00"
                       PERFORM DEL-CREW THRU DEL-CREW-EXIT
                       GO TO SETUP-MENU-SCREEN
                   ELSE
                   IF FILE-STAT = "23"
      *M********************************************************************
      *M    MESSAGE 000/021:
      *M INVALID CREW
      *M********************************************************************
                       MOVE "INVALID CREW"
                                       TO ERRMSGM
                       MOVE TRUE-VAL   TO IND(3) IND(99)
                       GO TO SHOW-MENU-SCREEN
                   ELSE
                       MOVE MESSAGE-BUFFER TO ERRMSGM
                       MOVE TRUE-VAL   TO IND(3) IND(99)
                       GO TO SHOW-MENU-SCREEN.

           IF KEY-HIT = 5
               PERFORM DISP-CREW THRU DISP-CREW-EXIT
               GO TO SETUP-MENU-SCREEN.

           IF KEY-HIT = 7
               MOVE "CREWHELP" TO SCREEN-NAME
               GO TO SHOW-MENU-SCREEN.

           GO TO SETUP-MENU-SCREEN.

       ADD-CREW.
      *C****************************************************************
      *--    >>  ADD CREW RECORD TO FILE  <<
      *--  ADD-CREW EDITS FOR VALID INPUT AND WRITES A CREW
      *--  RECORD TO THE CREW FILE (MCFPMM0600) ONLY.
      *C****************************************************************

           MOVE "CREWADD"      TO SCREEN-NAME.

       SHOW-ADD-SCREEN.
           MOVE "00"           TO SCREEN-STATUS.
           MOVE CREW-ADD       TO ACREW.
           MOVE  SCREEN-ADD    TO DISPLAY-REC.

           WRITE DISPLAY-REC   FORMAT IS SCREEN-NAME
                               INDIC ARE SCREEN-INDICATORS.
           IF SCREEN-STATUS NOT = "00"
               DISPLAY "SCREEN WRITE ERROR.  SCREEN-STATUS IS "
                               SCREEN-STATUS
               GO TO END-OF-JOB.

           READ  DISPLAY-FILE  FORMAT IS SCREEN-NAME
                               INDIC ARE SCREEN-INDICATORS
           IF SCREEN-STATUS NOT = "00"
               DISPLAY "SCREEN READ ERROR.  SCREEN-STATUS IS "
                               SCREEN-STATUS
               GO TO END-OF-JOB.

           MOVE ALL B"0"       TO SCREEN-INDICATORS.
           MOVE DISPLAY-REC    TO SCREEN-ADD.

           IF KEY-HIT = 3 OR 8
             GO TO END-OF-JOB.

           IF KEY-HIT = 1
             GO TO ADD-CREW-EXIT.

           MOVE SPACES         TO CREW-DATA.
           MOVE ACREW          TO CREW-MSTR.

           WRITE CREW-REC      FROM CREW-DATA
               INVALID KEY
      *M****************************************************************
      *M    MESSAGE 000/004:
      *M  ADD FAILED
      *M****************************************************************
                   MOVE "ADD FAILED"
                                   TO ERRMSGA
                   MOVE TRUE-VAL   TO IND(99)
                   GO TO SHOW-ADD-SCREEN.

           MOVE "X"            TO MSG-SW.
           MOVE SPACES         TO MSG-BUFFER.
           STRING MSG1 CREW-ADD MSG2 MSGA MSG3
                               DELIMITED BY SIZE
                               INTO MSG-BUFFER.

       ADD-CREW-EXIT.         EXIT.

       DEL-CREW.
      *C****************************************************************
      *--    >>  DELETE CREW RECORD IN FILE  <<
      *--  DEL-CREW DELETES THE CREW RECORD FROM THE CREW FILE
      *--  (MCFPMM0600) BUT DOES NOT DELETE ASSOCIATED RECORDS IN
      *--  OTHER FILES.  NO NEW ASSOCIATED RECORDS MAY BE CREATED LINKED
      *--  TO THE OLD (DELETED) CREW RECORD.
      *C****************************************************************

           MOVE "CREWDELETE"   TO SCREEN-NAME.
           MOVE CREW-MSTR      TO  DCREW.

       SHOW-DELETE-SCREEN.
           MOVE "00"           TO SCREEN-STATUS.
           MOVE  SCREEN-DELETE TO DISPLAY-REC.

           WRITE DISPLAY-REC   FORMAT IS SCREEN-NAME
                               INDIC ARE SCREEN-INDICATORS.
           IF SCREEN-STATUS NOT = "00"
               DISPLAY "SCREEN WRITE ERROR.  SCREEN-STATUS IS "
                               SCREEN-STATUS
               GO TO END-OF-JOB.

           READ  DISPLAY-FILE  FORMAT IS SCREEN-NAME
                               INDIC ARE SCREEN-INDICATORS
           IF SCREEN-STATUS NOT = "00"
               DISPLAY "SCREEN READ ERROR.  SCREEN-STATUS IS "
                               SCREEN-STATUS
               GO TO END-OF-JOB.

           MOVE ALL B"0"       TO SCREEN-INDICATORS.
           MOVE DISPLAY-REC    TO SCREEN-DELETE.

           IF KEY-HIT = 3 OR 8
             GO TO END-OF-JOB.

           IF KEY-HIT NOT = 4
               GO TO DEL-CREW-EXIT.

           MOVE DCREW          TO CREWMASTER OF CREW-REC.
           READ CREW-FILE
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
               MOVE "DELETE FAILED"
                               TO ERRMSGD
               MOVE TRUE-VAL   TO IND(99)
               GO TO SHOW-DELETE-SCREEN.

           DELETE CREW-FILE
               INVALID KEY
                   MOVE "DELETE FAILED"
                                   TO ERRMSGD
                   MOVE TRUE-VAL   TO IND(99)
                   GO TO SHOW-DELETE-SCREEN.

           MOVE "X"            TO MSG-SW.
           MOVE SPACES         TO MSG-BUFFER.
           STRING MSG1 CREW-MSTR MSG2 MSGD MSG3
                               DELIMITED BY SIZE
                               INTO MSG-BUFFER.

       DEL-CREW-EXIT.         EXIT.

       DISP-CREW.
      *C****************************************************************
      *--    >>  DISPLAY A LIST OF CREW RECORDS IN FILE  <<
      *--  DISP-CREW LISTS THE CREW RECORDS FROM THE CREW FILE
      *--  (MCFPMM0600) TO THE SCREEN.  IF THE INPUT FIELD IS LEFT
      *--  BLANK, THE ENTIRE LIST WILL DISPLAY (USING SUB-FILES); IF A
      *--  CREW (OR LETTER) IS ENTERED, THE LIST WILL START AT THAT POINT.
      *C****************************************************************

           MOVE 0              TO RECNO.
           MOVE NEG-VAL        TO IND(75).
           MOVE TRUE-VAL       TO IND(77) IND(76).
           MOVE SPACES         TO DISPLAY-REC
                                  SCREEN-DISPLAY.
           WRITE DISPLAY-REC   FORMAT "CREW"
                               INDIC ARE SCREEN-INDICATORS.
           IF SCREEN-STATUS NOT = "00"
               DISPLAY
               "SUBFILE CLEAR WRITE ERROR.  SCREEN-STATUS IS "
                               SCREEN-STATUS.
           MOVE NEG-VAL        TO IND(77).

           MOVE LOW-VALUES     TO CREWMASTER OF CREW-FILE.
           START CREW-FILE     KEY >= CREWMASTER OF CREW-FILE
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT = "23"
               GO TO DBGET-LOOP
           ELSE
           IF FILE-STAT NOT = "00"
               DISPLAY
               "START CREW-FILE ERROR.  FILE-STATUS IS "
                               FILE-STAT
               GO TO DISP-CREW-EXIT.

       DBGET-LOOP.
           READ CREW-FILE      NEXT INTO CREW-DATA
               AT END          MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT = "10" OR "14" OR "46"
               GO TO SUBF-CONT
           ELSE
           IF FILE-STAT NOT = "00"
               DISPLAY
               "READ CREW-FILE ERROR.  FILE-STATUS IS "
                               FILE-STAT
               GO TO DISP-CREW-EXIT.

           IF CREW-MSTR = SPACES
               GO TO DBGET-LOOP.

           MOVE CREW-MSTR      TO  SCREW.

           ADD 1               TO RECNO.
           MOVE SCREEN-DISPLAY TO DISPLAY-REC.
           MOVE "00"           TO SCREEN-STATUS.
           WRITE SUBFILE       DISPLAY-REC FORMAT "CREWDISP"
                               INDIC ARE SCREEN-INDICATORS
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF SCREEN-STATUS NOT = "00"
               DISPLAY   "SUBFILE 1 WRITE ERROR.  SCREEN STATUS IS "
                               SCREEN-STATUS
               GO TO END-OF-JOB.

           GO TO DBGET-LOOP.

       SUBF-CONT.
           IF RECNO EQUAL 0
               GO TO DISP-CREW-EXIT.

           WRITE DISPLAY-REC   FORMAT "ENDSUBF"
                               INDIC ARE SCREEN-INDICATORS.
           MOVE TRUE-VAL       TO IND(76).

           IF RECNO GREATER THAN 0
               MOVE TRUE-VAL   TO IND(75)
           ELSE
               MOVE NEG-VAL    TO IND(75).

           WRITE DISPLAY-REC   FORMAT "CREW"
                               INDIC ARE SCREEN-INDICATORS.
           READ DISPLAY-FILE   FORMAT "CREW"
                               INDIC ARE SCREEN-INDICATORS.

           READ SUBFILE        DISPLAY-FILE NEXT MODIFIED
                               INTO SCREEN-DISPLAY
                               FORMAT "CREWDISP"
                               INDIC ARE SCREEN-INDICATORS.

       DISP-CREW-EXIT.        EXIT.

       CHECK-CREW.
           MOVE CREW-KEY       TO CREWMASTER OF CREW-REC.
           READ CREW-FILE      INTO CREW-DATA
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT = "00" OR "23"
               GO TO CHECK-CREW-EXIT
           ELSE
               STRING "READ ERROR IN CREW-FILE         FILE STATUS = "
                               FILE-STAT
                               DELIMITED BY SIZE
                               INTO MESSAGE-BUFFER.

       CHECK-CREW-EXIT.        EXIT.

       END-OF-JOB.
           CLOSE               DISPLAY-FILE.
           CLOSE               CREW-FILE.
           GOBACK.

      *************  END OF FILE  ************************************
