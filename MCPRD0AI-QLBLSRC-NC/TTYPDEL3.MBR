000200 IDENTIFICATION DIVISION.
000300 PROGRAM-ID.    TTYPDEL3.
000600*REMARKS.  ***  THIS PROGRAM DELETES ALL RECORDS OF
000700*               SELECTED GENERIC SUBSYSTEMS FROM THE
000800*               EQUIPMENT REFERENCE FILE
001100*                   ****.
001200 ENVIRONMENT DIVISION.
001300 CONFIGURATION SECTION.
001400 SOURCE-COMPUTER.    AS400.
001500 OBJECT-COMPUTER.    AS400.
       SPECIAL-NAMES. I-O-FEEDBACK IS I-O-FEEDBACK-AREA
                      LOCAL-DATA IS LOCAL-DATA-AREA.
001000 INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT TYPE-OPERATIONS
               ASSIGN TO DATABASE-MCFLER0601
               ORGANIZATION IS INDEXED
               ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                   WITH DUPLICATES
               FILE STATUS IS TOPE-STATUS.
           SELECT TYPE-REFERENCE
               ASSIGN TO DATABASE-MCFLER0201
               ORGANIZATION IS INDEXED
               ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
               FILE STATUS IS TREF-STATUS.
           SELECT TYPE-REMARKS
               ASSIGN TO DATABASE-MCFLER0401
               ORGANIZATION IS INDEXED
               ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                   WITH DUPLICATES
               FILE STATUS IS TREM-STATUS.
001700 DATA DIVISION.
       FILE SECTION.
       FD  TYPE-OPERATIONS
           LABEL RECORDS ARE STANDARD
           DATA RECORD IS TOPEREC.
       01  TOPEREC.
           COPY DDS-ALL-FORMATS OF MCFLER0601.
       FD  TYPE-REFERENCE
           LABEL RECORDS ARE STANDARD
           DATA RECORD IS TREFREC.
       01  TREFREC.
           COPY DDS-ALL-FORMATS OF MCFLER0201.
       FD  TYPE-REMARKS
           LABEL RECORDS ARE STANDARD
           DATA RECORD IS TREMREC.
       01  TREMREC.
           COPY DDS-ALL-FORMATS OF MCFLER0401.
001800 WORKING-STORAGE SECTION.
001900 77  DEL-SW                    PIC S9(4) COMP-4.
002000
       01  BLOWUP-BASE               PIC X(16).

       COPY CATREAD OF COPYLIB.

       COPY CPYIND  OF COPYLIB.

       01  FILE-STATUSES.
           05  TOPE-STATUS         PIC XX.
           05  TREF-STATUS         PIC XX.
           05  TREM-STATUS         PIC XX.

       COPY IOFEEDBACK OF COPYLIB.

002100 01  PASSWORD-INFORMATION.
002200     05  NAME-OF-PROGRAM     PIC X(08) VALUE "TTYPDEL3".
002300     05  PROGRAM-TYPE        PIC X(02) VALUE "UP".
002400     05  PROGRAM-RELEASE     PIC X(12) VALUE " E0100010001".
002500     05  PROGRAM-DESCRIPTION.
002600         10  PROG-DESC-A.
                   15  FILLER      PIC X(12) VALUE "DELETES ALL ".
                   15  FILLER      PIC X(16) VALUE "GENERIC RECORDS ".
                   15  FILLER      PIC X(16) VALUE "OF THE SELECTED ".
                   15  FILLER      PIC X(16) VALUE "EQUIPMENT TYPE  ".
002800         10  PROG-DESC-B.
                   15  FILLER      PIC X(16) VALUE "SUBSYSTEM NUMBER".
                   15  FILLER      PIC X(10) VALUE " FROM THE ".
                   15  FILLER      PIC X(10) VALUE "EQUIPMENT ".
                   15  FILLER      PIC X(24) VALUE "REFERENCE FILE ".
003000         10  PROG-FUNCTION.
                   15  FILLER      PIC X(16) VALUE "RUNS FROM THE F4".
                   15  FILLER      PIC X(12) VALUE " KEY OF THE ".
                   15  FILLER      PIC X(08) VALUE "GENERIC ".
                   15  FILLER      PIC X(24) VALUE "DELETION MENU ".
003200     05  PASSWORD-FLAG       PIC X.
003300
       COPY DBSTAT OF COPYLIB.

       COPY TBLOWUP IN COPYLIB.

008700 01  TYPE-OPER-DATA.
008800     05  TYPE-SUB-KEY-OPS.
008900         10  TYPE-SUB-OPS      PIC X(08).
009000         10  SUB-SYS-OPS       PIC X(04).
009100     05  OPS-COR-12.
009200         10  EQP-OPS-1         PIC X(66).
009300         10  EQP-OPS-2         PIC X(66).
009400         10  EQP-OPS-3         PIC X(66).
009500         10  EQP-OPS-4         PIC X(66).
009600         10  EQP-OPS-5         PIC X(66).
009700         10  EQP-OPS-6         PIC X(66).
009800         10  EQP-COR-1         PIC X(66).
009900         10  EQP-COR-2         PIC X(66).
010000         10  EQP-COR-3         PIC X(66).
010100         10  EQP-COR-4         PIC X(66).
010200         10  EQP-COR-5         PIC X(66).
010300         10  EQP-COR-6         PIC X(66).
010400
004300 01  TYPE-REF-DATA.
004400     05  TYPE-SUB-KEY-REF.
004500         10  TYPE-NUM-REF      PIC X(08).
004600         10  SUB-SYS-REF       PIC X(04).
004700     05  TYPE-REF-VALUES.
004800         10  EQP-MFG           PIC X(16).
004900         10  EQP-MOD           PIC X(16).
005000         10  EQP-SER           PIC X(16).
005100         10  EQP-PROP-NUM      PIC X(08).
005200         10  EQP-NAME-1        PIC X(16).
005300         10  EQP-FIELD-1       PIC X(16).
005400         10  EQP-NAME-2        PIC X(16).
005500         10  EQP-FIELD-2       PIC X(16).
005600         10  EQP-NAME-3        PIC X(16).
005700         10  EQP-FIELD-3       PIC X(16).
005800         10  EQP-NAME-4        PIC X(16).
005900         10  EQP-FIELD-4       PIC X(16).
006000         10  EQP-NAME-5        PIC X(16).
006100         10  EQP-FIELD-5       PIC X(16).
006200         10  EQP-NAME-6        PIC X(16).
006300         10  EQP-FIELD-6       PIC X(16).
006400         10  EQP-NAME-7        PIC X(16).
006500         10  EQP-FIELD-7       PIC X(16).
006600         10  EQP-NAME-8        PIC X(16).
006700         10  EQP-FIELD-8       PIC X(16).
006800
006900 01  TYPE-REMARKS-DATA.
007000     05  TYPE-SUB-KEY-REM.
007100         10  TYPE-SUB-REM      PIC X(08).
007200         10  SUB-SYS-REM       PIC X(04).
007300     05  REMARKS-12.
007400         10  EQP-REM-1         PIC X(66).
007500         10  EQP-REM-2         PIC X(66).
007600         10  EQP-REM-3         PIC X(66).
007700         10  EQP-REM-4         PIC X(66).
007800         10  EQP-REM-5         PIC X(66).
007900         10  EQP-REM-6         PIC X(66).
008000         10  EQP-REM-7         PIC X(66).
008100         10  EQP-REM-8         PIC X(66).
008200         10  EQP-REM-9         PIC X(66).
008300         10  EQP-REM-10        PIC X(66).
008400         10  EQP-REM-11        PIC X(66).
008500         10  EQP-REM-12        PIC X(66).
008600
003900 01  TYPE-SUB-KEY.
004000     05  TYPE-EQUIP-NUM        PIC X(08).
004100     05  SUB-SYS-NUM           PIC X(04).
004200
       COPY WSCONTROL OF COPYLIB.
012500 LINKAGE SECTION.
       COPY VCOMLINK OF COPYLIB.
012700 01  DBPARAMETERS.        COPY DBPARMS OF COPYLIB.
013000 01  EQP-SUB-BUFFER.
013100     05  EQP-NUM-BUF           PIC X(06).
013200     05  SUB-SYS-BUF           PIC X(04).
013300     05  EQP-SUB-DESC-BUF      PIC X(40).
013400     05  EQP-TYPE-BUF          PIC X(08).
013500     05  ACD-FUNCTION          PIC X(06).
013600     05  ACD-SW                PIC X(01).
013700
013800 PROCEDURE DIVISION USING VIEW-COMAREA
013900                          DBPARAMETERS
014200                          EQP-SUB-BUFFER.
014300 BEGIN-PGM.
           PERFORM 1-HSK.
           PERFORM 6-MAIN THRU 6-MAIN-EXIT UNTIL VIEW-LASTKEY > 0.
       2-EOJ.
           CLOSE TYPE-OPERATIONS.
           CLOSE TYPE-REFERENCE.
           CLOSE TYPE-REMARKS.
           GOBACK.
       1-HSK.
           MOVE LOW-VALUES TO STATUS-AREA.
           OPEN I-O   TYPE-OPERATIONS.
           OPEN I-O   TYPE-REFERENCE.
           OPEN I-O   TYPE-REMARKS.
           MOVE 0 TO DEL-SW.
014500     CALL "TPWORD" USING PASSWORD-INFORMATION.
014900     IF PASSWORD-FLAG = "N" GO TO 2-EOJ.
015500     MOVE EQP-TYPE-BUF TO TYPE-EQUIP-NUM.
015600     MOVE SUB-SYS-BUF TO SUB-SYS-NUM.
           MOVE 0 TO VIEW-LASTKEY.
015900
016000 6-MAIN.
           PERFORM 69-START-TYPE-REFERENCE.
017100     IF COND-WORD = 17
017200         MOVE COND-WORD TO VIEW-LASTKEY
017400**MESSAGE******************************************************
017500** NO RECORDS FOUND FOR THIS TYPE NUMBER                     **
017600***************************************************************
               GO TO 6-MAIN-EXIT.
016100     PERFORM 69-READ-TYPE-REFERENCE.
           IF COND-WORD = 15
               MOVE COND-WORD TO VIEW-LASTKEY
               GO TO 6-MAIN-EXIT.
016400     PERFORM 61-DEL-REM THRU 61-DR-EXIT
016500                      UNTIL DEL-SW = 1.
016600     PERFORM 61-DEL-OPS THRU 61-DO-EXIT
016700                      UNTIL DEL-SW = 2.
016800     PERFORM 69-DELETE-TYPE-REFERENCE.
           IF COND-WORD = 17
               MOVE "ERROR DETECTED DELETING TYPE RECORD * TTYPDEL3 *"
                   TO BU-DISPLAY-MSG
               PERFORM 998-BLOWUP.
           MOVE COND-WORD TO VIEW-LASTKEY.
           IF VIEW-LASTKEY = 0 MOVE 3 TO VIEW-LASTKEY.
020200
       6-MAIN-EXIT.    EXIT.

020300 61-DEL-REM.
020400     PERFORM 69-START-TYPE-REMARKS.
020800     IF COND-WORD = 0
020900         PERFORM 61-GET-REM UNTIL COND-WORD = 15
021000         MOVE 1 TO DEL-SW
021100         GO TO 61-DR-EXIT
021200     ELSE
021300     MOVE 1 TO DEL-SW
021400     GO TO 61-DR-EXIT.
021500
021600 61-GET-REM.
021700     PERFORM 69-READ-TYPE-REMARKS.
021900     IF COND-WORD = 0
022800         PERFORM 69-DELETE-TYPE-REMARKS
022900         IF COND-WORD = 17
                   MOVE "ERROR DETECTED DELETING REMARKS * TTYPDEL3 *"
                       TO BU-DISPLAY-MSG
023600             PERFORM 998-BLOWUP.
025400
025500 61-DR-EXIT.    EXIT.
025600
025700 61-DEL-OPS.
025800     PERFORM 69-START-TYPE-OPERATIONS.
026200     IF COND-WORD = 0
026300         PERFORM 61-GET-OPS UNTIL COND-WORD = 15
026400         MOVE 2 TO DEL-SW
026500         GO TO 61-DO-EXIT
026600     ELSE
026700     MOVE 2 TO DEL-SW
026800     GO TO 61-DO-EXIT.
026900
027000 61-GET-OPS.
027100     PERFORM 69-READ-TYPE-OPERATIONS.
027300     IF COND-WORD = 0
028200         PERFORM 69-DELETE-TYPE-OPERATIONS
028300         IF COND-WORD = 17
                   MOVE "ERROR DETECTED DELETING OP-SETS * TTYPDEL3 *"
                       TO BU-DISPLAY-MSG
029000             PERFORM 998-BLOWUP.
030900
031000 61-DO-EXIT.    EXIT.
033700
       69-DELETE-TYPE-OPERATIONS.
           MOVE 0 TO COND-WORD.
           DELETE TYPE-OPERATIONS RECORD
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF TOPE-STATUS NOT = "00" MOVE 17 TO COND-WORD.

       69-START-TYPE-OPERATIONS.
           MOVE 0 TO COND-WORD.
           MOVE TYPE-SUB-KEY TO EQRTYSUBK OF TOPEREC.
           START TYPE-OPERATIONS KEY = EXTERNALLY-DESCRIBED-KEY
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF TOPE-STATUS NOT = "00" MOVE 17 TO COND-WORD.

       69-READ-TYPE-OPERATIONS.
           MOVE 0 TO COND-WORD.
           READ TYPE-OPERATIONS NEXT INTO TYPE-OPER-DATA
               AT END    MOVE 15 TO COND-WORD.
           IF TYPE-SUB-KEY NOT = EQRTYSUBK OF TOPEREC
               MOVE 15 TO COND-WORD.
           IF TOPE-STATUS NOT = "00" MOVE 15 TO COND-WORD.

       69-DELETE-TYPE-REFERENCE.
           MOVE 0 TO COND-WORD.
           DELETE TYPE-REFERENCE RECORD
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF TREF-STATUS NOT = "00" MOVE 17 TO COND-WORD.

       69-READ-TYPE-REFERENCE.
           MOVE 0 TO COND-WORD.
           READ TYPE-REFERENCE INTO TYPE-REF-DATA
               AT END    MOVE 15 TO COND-WORD.
           IF TYPE-SUB-KEY NOT = EQRTYSUBK OF TREFREC
               MOVE 15 TO COND-WORD.
           IF TREF-STATUS NOT = "00" MOVE 15 TO COND-WORD.

       69-START-TYPE-REFERENCE.
           MOVE 0 TO COND-WORD.
           MOVE TYPE-SUB-KEY TO EQRTYSUBK OF TREFREC.
           START TYPE-REFERENCE KEY = EXTERNALLY-DESCRIBED-KEY
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF TREF-STATUS NOT = "00" MOVE 17 TO COND-WORD.

       69-DELETE-TYPE-REMARKS.
           MOVE 0 TO COND-WORD.
           DELETE TYPE-REMARKS RECORD
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF TREM-STATUS NOT = "00" MOVE 17 TO COND-WORD.

       69-START-TYPE-REMARKS.
           MOVE 0 TO COND-WORD.
           MOVE TYPE-SUB-KEY TO EQRTYSUBK OF TREMREC.
           START TYPE-REMARKS KEY = EXTERNALLY-DESCRIBED-KEY
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF TREM-STATUS NOT = "00" MOVE 17 TO COND-WORD.

       69-READ-TYPE-REMARKS.
           MOVE 0 TO COND-WORD.
           READ TYPE-REMARKS NEXT INTO TYPE-REMARKS-DATA
               AT END    MOVE 15 TO COND-WORD.
           IF TYPE-SUB-KEY NOT = EQRTYSUBK OF TREMREC
               MOVE 15 TO COND-WORD.
           IF TREM-STATUS NOT = "00" MOVE 15 TO COND-WORD.

076200 998-BLOWUP.
076300     MOVE "TTYPDEL3" TO BU-PGM-NAME.
076400     CALL "TBLOWUP" USING BLOWUP-BASE BU-PGM-NAME STATUS-AREA
076500                      VIEW-COMAREA DUMMY-KSAM-STAT
076600                      BU-DISPLAY-MSG BU-DISPLAY-FLDS.
