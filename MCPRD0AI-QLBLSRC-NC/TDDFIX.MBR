000200 IDENTIFICATION DIVISION.
000300 PROGRAM-ID.     TDDFIX.
000400 AUTHOR.         C HILLES.
000500 DATE-WRITTEN.   04/12/88.
000600 DATE-COMPILED.
000700*INSTALLATION.   GOODYEAR TIRE AND RUBBER - AKRON.
000800*SECURITY.
000900*REMARKS.
001000*D   THIS WILL FIX RECEIVING SLIPS THAT SHOULD HAVE BEEN DIRECT
001100*D   DELIVERY BUT ARENT, OR SHOULDN'T BE DIRECT DELIVERY BUT ARE.

      *C 06/12/96  JEFF BUNGO
      *C   EXPAND DATE FIELDS FOR YEAR 2000 COMPLIANCE.
      *C   INCLUDE CENTURY ON DATE STORED FOR DRCVITEM AND DPOITEM.
      *C   ALSO FIGURE CENTURY FOR LOW AND HIGH DATES ENTERED.
001200
001300 ENVIRONMENT DIVISION.
001400 CONFIGURATION SECTION.
001500 SOURCE-COMPUTER.  HP-3000.
001600 OBJECT-COMPUTER.  HP-3000.
       COPY SPECIALN IN COPYLIB.
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT MPLTINFO-PK-I
               ASSIGN TO DATABASE-MCFLCS0501
               ORGANIZATION IS INDEXED
                 ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
               FILE STATUS IS FILE-STATUS.

           SELECT DRCVITEM-PO-O
               ASSIGN TO DATABASE-MCFLCS1201
               ORGANIZATION IS INDEXED
                 ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                 WITH DUPLICATES
               FILE STATUS IS FILE-STATUS.

           SELECT DPOITEM-PO-O
               ASSIGN TO DATABASE-MCFLCS1002
               ORGANIZATION IS INDEXED
                 ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                 WITH DUPLICATES
               FILE STATUS IS FILE-STATUS.

           SELECT MPORCV-PO-O
               ASSIGN TO DATABASE-MCFLCS0101
               ORGANIZATION IS INDEXED
                 ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
               FILE STATUS IS FILE-STATUS.

           SELECT MSTORERM-CD-I
               ASSIGN TO DATABASE-MCFLCS0201
               ORGANIZATION IS INDEXED
                 ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
               FILE STATUS IS FILE-STATUS.

           SELECT DPORECD-PO-I
               ASSIGN TO DATABASE-MCFLCS0901
               ORGANIZATION IS INDEXED
                 ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                 WITH DUPLICATES
               FILE STATUS IS FILE-STATUS.

           SELECT PRINT-FILE ASSIGN TO PRINTER-MCPRT.
001700
001800 DATA DIVISION.
       FILE SECTION.
       FD  MPLTINFO-PK-I
           LABEL RECORDS ARE STANDARD.
       01  MPLTINFO-PK-REC-I.
           COPY DDS-MCRPCS0500  OF MCFLCS0501.

       FD  DRCVITEM-PO-O
           LABEL RECORDS ARE STANDARD.
       01  DRCVITEM-PO-REC-O.
           COPY DDS-MCRPCS1200  OF MCFLCS1201.

       FD  DPOITEM-PO-O
           LABEL RECORDS ARE STANDARD.
       01  DPOITEM-PO-REC-O.
           COPY DDS-MCRPCS1000  OF MCFLCS1002.

       FD  MPORCV-PO-O
           LABEL RECORDS ARE STANDARD.
       01  MPORCV-PO-REC-O.
           COPY DDS-MCRPCS0100  OF MCFLCS0101.

       FD  MSTORERM-CD-I
           LABEL RECORDS ARE STANDARD.
       01  MSTORERM-CD-REC-I.
           COPY DDS-MCRPCS0200  OF MCFLCS0201.

       FD  DPORECD-PO-I
           LABEL RECORDS ARE STANDARD.
       01  DPORECD-PO-REC-I.
           COPY DDS-MCRPCS0900  OF MCFLCS0901.

010500 FD  PRINT-FILE
010600     LABEL RECORDS ARE OMITTED
010700     RECORD CONTAINS 132 CHARACTERS
010800     DATA RECORD IS PRINT-REC.
010900 01  PRINT-REC                PIC X(132).
011100
001900 WORKING-STORAGE SECTION.
002000 01  UPDATE-SHOULD-FLAG            PIC X(1)  VALUE "N".
002100 01  UPDATE-SHOULDNT-FLAG          PIC X(1)  VALUE "N".
       01  LOW-DATE-RCVD-CN.
           05  LOW-DATE-RCVD-CC          PIC X(2)  VALUE "00".
002200     05  LOW-DATE-RCVD.
               10  LOW-DATE-RCVD-YY      PIC X(2)  VALUE "00".
               10  FILLER                PIC X(4)  VALUE "0000".
       01  HIGH-DATE-RCVD-CN.
           05  HIGH-DATE-RCVD-CC         PIC X(2)  VALUE "99".
002300     05  HIGH-DATE-RCVD.
               10  HIGH-DATE-RCVD-YY     PIC X(2)  VALUE "99".
               10  FILLER                PIC X(4)  VALUE "9999".
002400 01  SUB                           PIC S9(4) BINARY VALUE 0.
       01  WORK-LINE                     PIC X(132) VALUE SPACES.
002500
002600******************************************************************
002700**                                                              **
002800**          S U B P R O G R A M   A R E A S                     **
002900**                                                              **
003000******************************************************************
003100
003200 COPY TBLOWUP    IN COPYLIB.
003300
003400 01  CDD-PLANT                  PIC X(3).
003500*----------  DIRECT DELIVERY ITEMS FOR SUBPLANTS
003600 01  DIRDEL-AREA                PIC X(60).
003700 01  DIRDEL-TABLE REDEFINES DIRDEL-AREA.
003800     02  PLANT-AREA OCCURS 6 TIMES INDEXED BY I.
003900         03  DIRDEL-STR-DEPT    PIC X(4).
004000         03  DIRDEL-DATE        PIC X(6).
004100 01  CDD-ITM-SUB-DETL           PIC X(4).
004200 01  CDD-PO-ADDL-DATA           PIC X(8).
004300 01  CDD-PO-PRIME               PIC X(3).
004400 01  CDD-INTERNAL-PO            PIC X.
004500 01  CDD-PO-CO                  PIC X(3).
004600 01  CDD-STR-CLASS              PIC X(4).
004700 01  RETURN-FLAGS.
004800     05  RETURN-DD              PIC X.
004900     05  FILLER                 PIC X.
005000
005100
005200*************************************************************
005300**                                                         **
005400**           D A T A B A S E   W O R K                     **
005500**                                                         **
005600*************************************************************
       01  FILE-STATUS.
           05  FILE-STATUS-1            PIC X  VALUE "0".
           05  FILE-STATUS-2            PIC X  VALUE "0".
005700
005800 01  BASE                          PIC X(10) VALUE "  STORES;".
005900 01  PASSWORD                      PIC X(5)  VALUE "JADE;".
006000 01  DSET-NAMES.
006100     05  DSET-NAME                 PIC X(16) VALUE SPACES.
006200     05  DSET-MPORCV               PIC X(16) VALUE "MPORCV;".
006300     05  DSET-DPOITEM              PIC X(16) VALUE "DPOITEM;".
006400     05  DSET-DRCVITEM             PIC X(16) VALUE "DRCVITEM;".
006500     05  DSET-MSTORERM             PIC X(16) VALUE "MSTORERM;".
006600     05  DSET-MPLTINFO             PIC X(16) VALUE "MPLTINFO;".
006700     05  DSET-DPORECD              PIC X(16) VALUE "DPORECD;".
006800
006900 COPY DBSTAT     IN COPYLIB.
007000 01  PO-SEARCH                     PIC X(16) VALUE "PO-RCV-NO;".
007100 01  PO-ARG.
007200     05  PO-ARG-PO                 PIC X(8).
007300     05  PO-ARG-REL                PIC X(3).
007400     05  PO-ARG-RS                 PIC X(3).
007500 01  PO-RCV-ARG.
007600     05  PO-RCV-ARG-PO             PIC X(8).
007700     05  PO-RCV-ARG-REL            PIC X(3).
007800     05  PO-RCV-ARG-RS             PIC X(3).
007900 01  CODE-ARG                      PIC X(8)  VALUE SPACES.
008000 01  PLT-ARG                       PIC X(4)  VALUE SPACES.
008100
008200 01  MODE-AREA.
008300     05  DB-MODE                   PIC S9(4)   COMP       VALUE 0.
008400     05  MODE1                     PIC S9(4)   COMP       VALUE 1.
008500     05  MODE2                     PIC S9(4)   COMP       VALUE 2.
008600     05  MODE3                     PIC S9(4)   COMP       VALUE 3.
008700     05  MODE4                     PIC S9(4)   COMP       VALUE 4.
008800     05  MODE5                     PIC S9(4)   COMP       VALUE 5.
008900     05  MODE7                     PIC S9(4)   COMP       VALUE 7.
009000
009100 01  ALL-ITEMS                     PIC X(2)  VALUE "@;".
009200
009300 COPY MPORCV     IN COPYLIB.
009400 COPY DPOITEM    IN COPYLIB.
009500 COPY DRCVITEM   IN COPYLIB.
009600 COPY DPORECD    IN COPYLIB.
009700 COPY MPLT0      IN COPYLIB.
009800 COPY MPLTP01   IN COPYLIB.
009900 COPY MPLTDSTR   IN COPYLIB.
010000 COPY MSTORERM   IN COPYLIB.
010100
010200 PROCEDURE DIVISION.
010300
010400 0000-START.
           PERFORM 9999-OPEN-STUFF.
010500     PERFORM 6000-MAIN THRU 6990-MAIN-X.
           PERFORM 9999-CLOSE-STUFF.
010600     GOBACK.
010700
010800 2100-BLOWUP.
010900     MOVE "TDDFIX"                 TO   BU-PGM-NAME.
011000     CALL "TBLOWUP" USING BASE BU-PGM-NAME STATUS-AREA
011100       DUMMY-VIEW-AREA, FILE-STATUS BU-DISPLAY-MSG
011200       BU-DISPLAY-FLDS.
011300
011400 6000-MAIN.
011500     DISPLAY "UPDATE RCV SLIPS THAT SHOULD BE 'DD' BUT AREN'T?".
011600     ACCEPT UPDATE-SHOULD-FLAG.
011700
011800     DISPLAY "UPDATE RCV SLIPS THAT SHOULD'NT BE 'DD' BUT ARE?".
011900     ACCEPT UPDATE-SHOULDNT-FLAG.
012000
012100     DISPLAY "ENTER LOW DATE RECEIVED TO CHECK".
012200     DISPLAY "YYMMDD".
012300     ACCEPT LOW-DATE-RCVD.
           IF LOW-DATE-RCVD-YY > "70"
               MOVE "19" TO LOW-DATE-RCVD-CC
           ELSE
               MOVE "20" TO LOW-DATE-RCVD-CC.
012400
012500     DISPLAY "ENTER HIGH DATE RECEIVED TO CHECK".
012600     DISPLAY "YYMMDD".
012700     ACCEPT HIGH-DATE-RCVD.
           IF HIGH-DATE-RCVD-YY > "70"
               MOVE "19" TO HIGH-DATE-RCVD-CC
           ELSE
               MOVE "20" TO HIGH-DATE-RCVD-CC.
012800
013400     MOVE "P 01"                   TO   PLT-ARG.
           PERFORM 9999-DBGET7-MPLTINFO-PK-I.
013900
014000*----------  FIND THE STOREROOM DEPARTMENTS FOR DIRECT DELIVERY
014100     MOVE "DSTR" TO PLT-ARG.
           PERFORM 9999-DBGET7-MPLTINFO-PK-I.
014700
014800     MOVE 1                        TO   SUB.
014900 137-READ-DIRDEL-FILE.
015000     MOVE MPLTINFO-DEPT-STR (SUB)  TO DIRDEL-STR-DEPT (SUB).
015100     IF SUB = 6
              DISPLAY "STARTING SERIAL LOOP"
              PERFORM 9999-INIT-DRCVITEM-PO-O
015200        GO TO 6100-SERIAL-LOOP.
015300     ADD 1 TO SUB.
015400     GO TO 137-READ-DIRDEL-FILE.
015500
015700 6100-SERIAL-LOOP.
           PERFORM 9999-DBGET2-DRCVITEM-PO-O.
016000     IF END-OF-FILE
016100         DISPLAY "END OF SERIAL LOOP"
016200         GO TO 6990-MAIN-X.
016600
016700     IF RCV-DATE-RCVD-CN < LOW-DATE-RCVD-CN
016800         GO TO 6100-SERIAL-LOOP.
016900     IF RCV-DATE-RCVD-CN > HIGH-DATE-RCVD-CN
017000         GO TO 6100-SERIAL-LOOP.
017100
017200     IF RCV-CORP-CODE = "NON-STR"
017300         GO TO 6100-SERIAL-LOOP.
017400
017500     MOVE RCV-PO-RCV-NO            TO   PO-RCV-ARG,
017600                                        PO-ARG.
017700     MOVE "000"                    TO   PO-ARG-RS.
017800
           PERFORM 9999-DBFIND-DPOITEM-PO-O.
018800
018900 6110-GET-DPOITEM-LOOP.
           PERFORM 9999-DBGET5-DPOITEM-PO-O.
019200     IF END-OF-CHAIN
               MOVE SPACES TO WORK-LINE
019300         STRING  "|| NO DPOITEM ITEM FOR RCV SLIP ", PO-RCV-ARG,
019400           " ITEM ", RCV-ITEM-NUMBER DELIMITED BY SIZE
                 INTO WORK-LINE
               WRITE PRINT-REC FROM WORK-LINE AFTER ADVANCING 1
019500         GO TO 6100-SERIAL-LOOP.
019900
020000     IF RCV-ITEM-NUMBER = ITM-NUMBER
020100         NEXT SENTENCE
020200     ELSE
020300         GO TO 6110-GET-DPOITEM-LOOP.
020400
           PERFORM 9999-DBFIND-DPORECD-PO-I.
021400     PERFORM 9999-DBGET5-DPORECD-PO-I.
021700     IF END-OF-CHAIN
               MOVE SPACES TO WORK-LINE
021800         STRING  "|| NO DPORECD ENTRY FOR RCV SLIP ", PO-RCV-ARG,
021900           " ||" DELIMITED BY SIZE INTO WORK-LINE
               WRITE PRINT-REC FROM WORK-LINE AFTER ADVANCING 1
022000         GO TO 6100-SERIAL-LOOP.
022400
022500     MOVE RCV-CORP-CODE            TO   CODE-ARG.
           PERFORM 9999-DBGET7-MSTORERM-CD-I.
023000
           PERFORM 9999-DBGET7-MPORCV-PO-O.
023500
023600     MOVE PO-ADDL-DATA             TO   CDD-PO-ADDL-DATA.
023700     MOVE PO-PRIME                 TO   CDD-PO-PRIME.
023800     MOVE PO-INTERNAL-ORDER-INDIC  TO   CDD-INTERNAL-PO.
023900     MOVE STR-CLASS                TO   CDD-STR-CLASS.
024000
024100     CALL "CDDCHECK" USING CDD-PLANT, DIRDEL-AREA,
024200       ITM-SUB-DETL, CDD-PO-ADDL-DATA, CDD-PO-PRIME,
024300       CDD-INTERNAL-PO, PO-CO, CDD-STR-CLASS, RETURN-FLAGS
             PO-SUB.
024400
024500     IF RETURN-DD = "N"
024600         IF RCV-DATE-STORED = "  DD  "
024700             PERFORM 7100-SHOULD-NOT-BE-DD THRU 7190-SNBD-X
024800         ELSE
024900             GO TO 6100-SERIAL-LOOP
025000     ELSE
025100         IF RCV-DATE-STORED = "  DD  "
025200             GO TO 6100-SERIAL-LOOP
025300         ELSE
025400             PERFORM 7000-SHOULD-BE-DD THRU 7090-SBD-X.
025500
025600     GO TO 6100-SERIAL-LOOP.
025700
025800
025900 6990-MAIN-X.
026000     EXIT.
026100
026200 7000-SHOULD-BE-DD.
           MOVE SPACES TO WORK-LINE.
026300     STRING  "RCV SLIP ", RCV-PO-RCV-NO, " ITEM ", RCV-ITEM-NUMBER,
026400      " RCV DATE ", RCV-DATE-RCVD, " SHOULD BE DD BUT ISN'T"
            DELIMITED BY SIZE INTO WORK-LINE.
           WRITE PRINT-REC FROM WORK-LINE AFTER ADVANCING 1.
026500     IF UPDATE-SHOULD-FLAG = "Y"
026600         NEXT SENTENCE
026700     ELSE
026800         GO TO 7090-SBD-X.
026900
027000 7090-SBD-X.
027100     EXIT.
027200
027300 7100-SHOULD-NOT-BE-DD.
027400     STRING  "RCV SLIP ", RCV-PO-RCV-NO, " ITEM ", RCV-ITEM-NUMBER,
027500      " RCV DATE ", RCV-DATE-RCVD, " SHOULD'NT BE 'DD' BUT IS"
            DELIMITED BY SIZE INTO WORK-LINE.
           WRITE PRINT-REC FROM WORK-LINE AFTER ADVANCING 1.
027600     IF UPDATE-SHOULDNT-FLAG = "Y"
027700         NEXT SENTENCE
027800     ELSE
027900         GO TO 7190-SNBD-X.
028000
028100     MOVE SPACES                   TO   RCV-DATE-STORED-CN.
028200     SUBTRACT RCV-QTY-STORED FROM ITM-QTY-STORED.
028300     MOVE ZERO                     TO   RCV-QTY-STORED.
028400     IF ITM-DATE-STORED = "  DD  "
028500         MOVE SPACES               TO   ITM-DATE-STORED-CN.
028600
028700     MOVE SPACES                   TO   M-PO-RCV-STAT.
028800
028900     MOVE "DRCVITEM;"              TO   DSET-NAME.
029000     PERFORM 9930-LOCK.
           PERFORM 9999-DBUPDATE-DRCVITEM-PO-O.
029500     PERFORM 9940-UNLOCK.
029600
029700     MOVE "DPOITEM;"              TO   DSET-NAME.
029800     PERFORM 9930-LOCK.
           PERFORM 9999-DBUPDATE-DPOITEM-PO-O.
030300     PERFORM 9940-UNLOCK.
030400
030500     MOVE "MPORCV;"              TO   DSET-NAME.
030600     PERFORM 9930-LOCK.
           PERFORM 9999-DBUPDATE-MPORCV-PO-O.
031100     PERFORM 9940-UNLOCK.
031200
031300 7190-SNBD-X.
031400     EXIT.
031500
       9930-LOCK.
       9940-UNLOCK.
       9999-DBGET7-MPLTINFO-PK-I.
           MOVE 0 TO COND-WORD.
           MOVE PLT-ARG TO PLTINFOKEY OF MPLTINFO-PK-REC-I.
           READ MPLTINFO-PK-I INTO BUF-MPLTINFO
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS = "23"
               MOVE 17 TO COND-WORD
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE "DBGET7 ERR 9999-DBGET7-MPLTINFO-PK-I"
                   TO BU-MSG-AREA
               MOVE 99 TO COND-WORD
               PERFORM 2100-BLOWUP.

       9999-DBGET2-DRCVITEM-PO-O.
           MOVE 0 TO COND-WORD.
           READ DRCVITEM-PO-O NEXT INTO BUF-DRCVITEM
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS-1 = "1" OR FILE-STATUS = "46"
               MOVE 11 TO COND-WORD
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE "DBGET2 ERR 9999-DBGET2-DRCVITEM-PO-O"
                   TO BU-MSG-AREA
               MOVE 99 TO COND-WORD
               PERFORM 2100-BLOWUP.

       9999-INIT-DRCVITEM-PO-O.
           MOVE SPACES TO PORCVNO OF DRCVITEM-PO-REC-O.
           START DRCVITEM-PO-O KEY >= PORCVNO OF DRCVITEM-PO-REC-O
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.

       9999-DBUPDATE-DRCVITEM-PO-O.
           MOVE 0 TO COND-WORD.
           REWRITE DRCVITEM-PO-REC-O FROM BUF-DRCVITEM
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE "DBUPDATE ERR 9999-DBUPDATE-DRCVITEM-PO-O"
                   TO BU-MSG-AREA
               MOVE 99 TO COND-WORD
               PERFORM 2100-BLOWUP.

       9999-DBFIND-DPOITEM-PO-O.
           MOVE 0 TO COND-WORD.
           MOVE PO-ARG TO PORCVNO OF DPOITEM-PO-REC-O.
           START DPOITEM-PO-O KEY = PORCVNO OF DPOITEM-PO-REC-O
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF (FILE-STATUS NOT = "00") AND (FILE-STATUS-1 NOT = "2")
               MOVE "DBFIND ERR 9999-DBFIND-DPOITEM-PO-O"
                   TO BU-MSG-AREA
               MOVE 99 TO COND-WORD
               PERFORM 2100-BLOWUP.

       9999-DBGET5-DPOITEM-PO-O.
           MOVE 0 TO COND-WORD.
           READ DPOITEM-PO-O NEXT INTO BUF-DPOITEM
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14"
                   PERFORM 9999-RESET-DPOITEM-PO-O
                   MOVE 15 TO COND-WORD
               ELSE
               IF FILE-STATUS = "46"
                   MOVE 15 TO COND-WORD
               ELSE
                   MOVE "DBGET5 ERR 9999-DBGET5-DPOITEM-PO-O"
                       TO BU-MSG-AREA
                   MOVE 99 TO COND-WORD
                   PERFORM 2100-BLOWUP
           ELSE
           IF PORCVNO OF DPOITEM-PO-REC-O NOT = PO-ARG
               PERFORM 9999-RESET-DPOITEM-PO-O
               MOVE 15 TO COND-WORD.

       9999-RESET-DPOITEM-PO-O.
           MOVE HIGH-VALUES TO PORCVNO OF DPOITEM-PO-REC-O.
           START DPOITEM-PO-O KEY > PORCVNO OF DPOITEM-PO-REC-O
               INVALID KEY MOVE "00" TO FILE-STATUS.

       9999-DBUPDATE-DPOITEM-PO-O.
           MOVE 0 TO COND-WORD.
           REWRITE DPOITEM-PO-REC-O FROM BUF-DPOITEM
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE "DBUPDATE ERR 9999-DBUPDATE-DPOITEM-PO-O"
                   TO BU-MSG-AREA
               MOVE 99 TO COND-WORD
               PERFORM 2100-BLOWUP.

       9999-DBGET7-MPORCV-PO-O.
           MOVE 0 TO COND-WORD.
           MOVE PO-RCV-ARG TO PORCVNO OF MPORCV-PO-REC-O.
           READ MPORCV-PO-O INTO BUF-MPORCV
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS = "23"
               MOVE 17 TO COND-WORD
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE "DBGET7 ERR 9999-DBGET7-MPORCV-PO-O"
                   TO BU-MSG-AREA
               MOVE 99 TO COND-WORD
               PERFORM 2100-BLOWUP.

       9999-RESET-MPORCV-PO-O.
           MOVE HIGH-VALUES TO PORCVNO OF MPORCV-PO-REC-O.
           START MPORCV-PO-O KEY > PORCVNO OF MPORCV-PO-REC-O
               INVALID KEY MOVE "00" TO FILE-STATUS.

       9999-DBUPDATE-MPORCV-PO-O.
           MOVE 0 TO COND-WORD.
           REWRITE MPORCV-PO-REC-O FROM BUF-MPORCV
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE "DBUPDATE ERR 9999-DBUPDATE-MPORCV-PO-O"
                   TO BU-MSG-AREA
               MOVE 99 TO COND-WORD
               PERFORM 2100-BLOWUP.

       9999-DBGET7-MSTORERM-CD-I.
           MOVE 0 TO COND-WORD.
           MOVE CODE-ARG TO CORPCDE OF MSTORERM-CD-REC-I.
           READ MSTORERM-CD-I INTO BUF-MSTORERM
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS = "23"
               MOVE 17 TO COND-WORD
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE "DBGET7 ERR 9999-DBGET7-MSTORERM-CD-I"
                   TO BU-MSG-AREA
               MOVE 99 TO COND-WORD
               PERFORM 2100-BLOWUP.

       9999-DBFIND-DPORECD-PO-I.
           MOVE 0 TO COND-WORD.
           MOVE PO-ARG TO PORCVNO OF DPORECD-PO-REC-I.
           START DPORECD-PO-I KEY = PORCVNO OF DPORECD-PO-REC-I
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF (FILE-STATUS NOT = "00") AND (FILE-STATUS-1 NOT = "2")
               MOVE "DBFIND ERR 9999-DBFIND-DPORECD-PO-I"
                   TO BU-MSG-AREA
               MOVE 99 TO COND-WORD
               PERFORM 2100-BLOWUP.

       9999-DBGET5-DPORECD-PO-I.
           MOVE 0 TO COND-WORD.
           READ DPORECD-PO-I NEXT INTO BUF-DPORECD
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   MOVE 15 TO COND-WORD
               ELSE
                   MOVE "DBGET5 ERR 9999-DBGET5-DPORECD-PO-I"
                       TO BU-MSG-AREA
                   MOVE 99 TO COND-WORD
                   PERFORM 2100-BLOWUP
           ELSE
           IF PORCVNO OF DPORECD-PO-REC-I NOT = PO-ARG
               MOVE 15 TO COND-WORD.

       9999-OPEN-STUFF.
           OPEN INPUT MPLTINFO-PK-I         MSTORERM-CD-I
                      DPORECD-PO-I.
           OPEN I-O   DRCVITEM-PO-O         DPOITEM-PO-O
                      MPORCV-PO-O.
           OPEN OUTPUT PRINT-FILE.

       9999-CLOSE-STUFF.
           CLOSE      MPLTINFO-PK-I         DRCVITEM-PO-O
                      DPOITEM-PO-O          MPORCV-PO-O
                      MSTORERM-CD-I         DPORECD-PO-I.
           CLOSE PRINT-FILE.
