       IDENTIFICATION DIVISION.
       PROGRAM-ID.             TNEWWONU.
       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.
       SOURCE-COMPUTER.        IBM-AS400.
       OBJECT-COMPUTER.        IBM-AS400.

       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT WO-LAST-NUM-USED
                  ASSIGN       TO DATABASE-MCFPMM0800
                  ORGANIZATION IS RELATIVE
                  ACCESS MODE  IS RANDOM
                  RELATIVE KEY IS ARG-NO
                  FILE STATUS  IS FILE-STAT.

           SELECT WO-NUMBER
                  ASSIGN       TO DATABASE-MCFLMM0101
                  ORGANIZATION IS INDEXED
                  ACCESS MODE  IS RANDOM
                  RECORD KEY   IS EXTERNALLY-DESCRIBED-KEY
                  FILE STATUS  IS FILE-STAT.

       DATA DIVISION.
       FILE SECTION.
       FD  WO-LAST-NUM-USED
           LABEL RECORDS       ARE STANDARD.
       01  WO-REC.
           COPY DDS-ALL-FORMATS OF MCFPMM0800.

       FD  WO-NUMBER
           LABEL RECORDS       ARE STANDARD.
       01  WO-NUMBER-REC.
           COPY DDS-ALL-FORMATS OF MCFLMM0101.

       WORKING-STORAGE SECTION.
       77  ARG-VALUE           PIC 9(8).
       77  SUB1                PIC S9(4) COMP-4.
       77  ARG-NO              PIC 9(9).
       77  BLOWUP-BASE         PIC X(16).

       01  FILE-STAT.
           05  FILE-STAT-1     PIC X.
           05  FILE-STAT-2     PIC X.
       01  FILE-STAT-99        REDEFINES FILE-STAT  PIC 99.

       01  CUR-DATE.
           02  CUR-YR.
               03  CUR-YR-DEC  PIC 9.
               03  CUR-YR-DIG  PIC 9.
           02  CUR-YR-9        REDEFINES CUR-YR    PIC 99.
           02  CUR-MM          PIC 99.
           02  CUR-DD          PIC 99.

       01  WORK-YR.
           05  WORK-YR-1       PIC 9.
           05  WORK-YR-2       PIC 9.
       01  WORK-YR-9 REDEFINES WORK-YR  PIC 99.

       01  WO-NUMBER-KEY.
           05  WO-NUM-1-6      PIC X(6).
           05  WO-NUM-7        PIC X.
           05  FILLER          PIC X(3).

       01 YR-CONV-TABLE.
          02  YCT-DATA.
              03  FILLER       PIC XX VALUE "A0".
              03  FILLER       PIC XX VALUE "B1".
              03  FILLER       PIC XX VALUE "C2".
              03  FILLER       PIC XX VALUE "D3".
              03  FILLER       PIC XX VALUE "E4".
              03  FILLER       PIC XX VALUE "F5".
              03  FILLER       PIC XX VALUE "G6".
              03  FILLER       PIC XX VALUE "H7".
              03  FILLER       PIC XX VALUE "J8".
              03  FILLER       PIC XX VALUE "K9".

          02  YCT-DATA-R       REDEFINES YCT-DATA.
              03  YCT-ENTRY    OCCURS 10 TIMES.
                  04  YCT-ALPHA  PIC X.
                  04  YCT-NUMB   PIC 9.

       01  LAST-WO-BUFF.
           COPY MLASTWO        OF COPYLIB.

           COPY TBLOWUP        OF COPYLIB.

           COPY VCOMLINK       OF COPYLIB.

       LINKAGE SECTION.
       01  DBPARAMETERS.
           COPY DBPARMS        OF COPYLIB.

           COPY DBSTAT         OF COPYLIB.

       01  WORK-ORDER-NUMBER.
           05  WO-NUM-ALL      PIC X(10).
           05  WO-NUM-DIV      REDEFINES WO-NUM-ALL.
               10  WO-NUM-PRIMARY.
                   15  WO-NUM-NUMBER    PIC X(6).
                   15  WO-NUM-NUMBER-9  REDEFINES WO-NUM-NUMBER
                                        PIC 9(6).
                   15  WO-NUM-YEAR      PIC X.
               10  WO-SUFFIX.
                   15  WO-SUFFIX-9      PIC 999.

       01  ERROR-SW            PIC S9(4) COMP-4.

       PROCEDURE DIVISION USING DBPARAMETERS
                                STATUS-AREA
                                WORK-ORDER-NUMBER
                                ERROR-SW.
       BEGIN-PROCESSING.
           PERFORM 1-HSK.
           PERFORM 6-MAIN.

       2-EOJ.
           CLOSE               WO-LAST-NUM-USED.
           GOBACK.

       1-HSK.
           MOVE LOW-VALUES     TO VIEW-COMAREA.
           OPEN I-O            WO-LAST-NUM-USED.
           OPEN INPUT          WO-NUMBER.
           MOVE SPACES         TO LAST-WO-BUFF.

           ACCEPT CUR-DATE     FROM DATE.
           IF CUR-YR = "00"
               MOVE "99"       TO WORK-YR
           ELSE
           SUBTRACT 1 FROM CUR-YR-9 GIVING WORK-YR-9.

           MOVE 0              TO ERROR-SW.
           MOVE 0              TO SUB1.
           MOVE SPACES         TO WORK-ORDER-NUMBER.

       6-MAIN.
           MOVE 1              TO ARG-NO.
           READ WO-LAST-NUM-USED INTO LAST-WO-BUFF
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
               MOVE "COULD NOT READ LAST-WO-NUM-USED RECORD"
                               TO BU-DISPLAY-MSG
               PERFORM 998-BLOWUP.

           IF WORK-YR-2 EQUAL TO LYU-9
               PERFORM 60-CONV-YR THRU 60-CY-EXIT.

           ADD 1               TO LWN-9.
           PERFORM 61-CHECK-FOR-WO THRU 61-CFW-X.

           MOVE LAST-WO-BUFF   TO WO-REC.
           REWRITE WO-REC
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
               MOVE "COULD NOT REWRITE WO-LAST-NUM-USED"
                               TO BU-DISPLAY-MSG
               MOVE "PLEASE CHECK THIS OUT" TO BU-DISPLAY-AREA
               PERFORM 998-BLOWUP.

           MOVE LAST-WO-NO     TO WO-NUM-NUMBER.
           MOVE LYU-X          TO WO-NUM-YEAR.
           MOVE SPACES         TO WO-SUFFIX.

       60-CONV-YR.
           ADD 1               TO SUB1.
           IF CUR-YR-DIG NOT EQUAL TO YCT-NUMB(SUB1)
               GO TO 60-CONV-YR.

           MOVE YCT-ENTRY(SUB1) TO LAST-YR-USED.
           IF PLANT-IDENT = "126 "
               MOVE 010001     TO LWN-9
           ELSE
           IF PLANT-IDENT = "129 "
               MOVE 000500     TO LWN-9
           ELSE
               MOVE 000001     TO LWN-9.

       60-CY-EXIT.             EXIT.

       61-CHECK-FOR-WO.
           MOVE SPACES         TO WO-NUMBER-KEY.
           MOVE LAST-WO-NO     TO WO-NUM-1-6.
           MOVE LYU-X          TO WO-NUM-7.
           MOVE WO-NUMBER-KEY  TO WONUM OF WO-NUMBER-REC.
           READ WO-NUMBER
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT = "00"
               ADD 1           TO LWN-9
               GO TO 61-CHECK-FOR-WO.

       61-CFW-X.               EXIT.

       998-BLOWUP.
           MOVE FILE-STAT-99   TO COND-WORD.
           MOVE "TNEWWONU"     TO BU-PGM-NAME.
           CALL "TBLOWUP" USING BLOWUP-BASE BU-PGM-NAME STATUS-AREA
                               VIEW-COMAREA DUMMY-KSAM-STAT
                               BU-DISPLAY-MSG BU-DISPLAY-FLDS.

