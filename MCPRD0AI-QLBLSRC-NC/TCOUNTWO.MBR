       01  ZONE-BUFF-AREA.             COPY MZONPRTY OF COPYLIB.

       PROCEDURE DIVISION.
       START-PGM.
           PERFORM 1-HSK.
           PERFORM 6-MAIN UNTIL VIEW-LASTKEY = 3.
       2-EOJ.
           IF VIEW-LASTKEY = 2  OR PRINT-BUF = "P"
               GO TO 6-MAIN.
           CLOSE DISPLAY-FILE.
           CLOSE PRINT-FILE.
           CLOSE WO-BASIC-FILE.
           CLOSE WO-LAST-NUM-USED.
           CLOSE WO-PLANNED-FILE.
           CLOSE WO-ZONE-PRTY-FILE.
           GOBACK.
       1-HSK.
           OPEN I-O    DISPLAY-FILE.
           OPEN OUTPUT PRINT-FILE.
           OPEN INPUT  WO-BASIC-FILE.
           OPEN INPUT  WO-LAST-NUM-USED.
           OPEN INPUT  WO-PLANNED-FILE.
           OPEN INPUT WO-ZONE-PRTY-FILE.
           MOVE LOW-VALUES TO STATUS-AREA.
           MOVE "Y" TO TERM-SW.
           MOVE 0 TO COND-WORD.
           MOVE 1 TO ARG-NO.
           READ WO-LAST-NUM-USED INTO LAST-WO-BUFF
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF WLNU-STATUS NOT = "00" MOVE 17 TO COND-WORD.
           IF COND-WORD = 17 MOVE 1 TO DATE-FLAG-SW.
           MOVE DATE-FLAG-SW TO DATE-CODE.
           MOVE 1 TO DATE-MODE.
           CALL "TDATECHK" USING DATE-CHECK-AREA.
           MOVE DATE-SLASH-OUT TO SM-DATE.
           MOVE 0 TO SUBT.
           MOVE 1 TO ADV-CTR.
           MOVE ZEROS TO COUNTERS-SAVE TOTAL-PRTYS.
           ACCEPT TIME-BUFFER FROM TIME.
           MOVE CUR-TIME TO SM-TIME.
           MOVE SPACES TO WORK-ARGUMENTS.
           MOVE SPACES TO BUFFER-DEFN.
           MOVE SPACES TO SUMM-DET VPE-HEADINGS.
           MOVE 0 TO CW-DET HA-DET HM-DET IP-DET OO-DET TOT-DET.
           MOVE 0 TO HS-DET SD-DET HL-DET.
           MOVE "N" TO RECORDS-PROCESSED-SW.
           MOVE "N" TO CLOSE-SW.
           MOVE ZEROS TO COUNTERS.
           MOVE SPACES TO VPE-BUF DSPLY-REC.
           MOVE 0 TO VIEW-LASTKEY.
       6-MAIN.
           MOVE "WORKSCN1" TO VIEW-CFNAME.
           MOVE MISC-BUFFER TO BUFFER-ERR-LINE.
           MOVE BUFFER-DEFN TO DSPLY-REC.
           PERFORM 99-SCREEN-WRITE.
           PERFORM 98-SCREEN-READ.
           MOVE DSPLY-REC TO BUFFER-DEFN.
           IF VIEW-LASTKEY = 3 GO TO 2-EOJ.
      *    IF PRINT-BUF = "P"
      *      CALL "TROUTE"  USING DBPARAMETERS
      *                           VIEW-COMMAREA
      *                           LANGUAGE-PARMS
      *                           HD-ROUTE-DATA
           IF VPE-BUF = SPACES
               MOVE TRUE-VAL TO INDS (2) INDS (99)
               MOVE 39004 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               GO TO 6-MAIN.
           IF V-BUF NOT = SPACE
               MOVE 48001 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MISC-BUFFER TO V-HEAD.
           IF P-BUF NOT = SPACE
               MOVE 42053 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MISC-BUFFER TO P-HEAD.
           IF E-BUF NOT = SPACE
               MOVE 31027 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MISC-BUFFER TO E-HEAD.
           IF ZONE-BUF = SPACES
               NEXT SENTENCE
           ELSE
           IF Z-BUF-1 = "A" AND (Z-BUF-2 = " " OR "A" OR "O")
               NEXT SENTENCE
           ELSE
           IF Z-BUF-1 = "B" AND (Z-BUF-2 = " " OR "B" OR "C"
                                               OR "D" OR "O")
               NEXT SENTENCE
           ELSE
           IF Z-BUF-1 = "C" AND (Z-BUF-2 = " " OR "O")
               NEXT SENTENCE
           ELSE
           MOVE 0 TO COND-WORD
           MOVE ZONE-BUF TO Z-ARG-4
           PERFORM 69-START-WO-ZONE-PRTY-FILE
           IF COND-WORD = 17
               MOVE TRUE-VAL TO INDS (5) INDS (99)
               MOVE 35044 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               GO TO 6-MAIN.
           IF Z-BUF-1 = "A" AND Z-BUF-2 = " "
               MOVE "A   " TO ZONE-BUF1
               MOVE "A1  " TO ZONE-BUF2
               MOVE "A2  " TO ZONE-BUF3
               MOVE "A3  " TO ZONE-BUF4
           ELSE
           IF Z-BUF-1 = "A" AND Z-BUF-2 = "A"
               MOVE "A1  " TO ZONE-BUF1
               MOVE "A2  " TO ZONE-BUF2
           ELSE
           IF Z-BUF-1 = "A" AND Z-BUF-2 = "O"
               MOVE "A   " TO ZONE-BUF1
           ELSE
           IF Z-BUF-1 = "B" AND Z-BUF-2 = " "
               MOVE "B   " TO ZONE-BUF1
               MOVE "B1  " TO ZONE-BUF2
               MOVE "B2  " TO ZONE-BUF3
               MOVE "B3  " TO ZONE-BUF4
           ELSE
           IF Z-BUF-1 = "B" AND Z-BUF-2 = "B"
               MOVE "B1  " TO ZONE-BUF1
               MOVE "B2  " TO ZONE-BUF2
           ELSE
           IF Z-BUF-1 = "B" AND Z-BUF-2 = "D"
               MOVE "B2  " TO ZONE-BUF1
               MOVE "B3  " TO ZONE-BUF2
           ELSE
           IF Z-BUF-1 = "B" AND Z-BUF-2 = "C"
               MOVE "B3  " TO ZONE-BUF1
               MOVE "C1  " TO ZONE-BUF2
               MOVE "C2  " TO ZONE-BUF3
           ELSE
           IF Z-BUF-1 = "B" AND Z-BUF-2 = "O"
               MOVE "B   " TO ZONE-BUF1
           ELSE
           IF Z-BUF-1 = "C" AND Z-BUF-2 = " "
               MOVE "C   " TO ZONE-BUF1
               MOVE "C1  " TO ZONE-BUF2
               MOVE "C2  " TO ZONE-BUF3
               MOVE "C3  " TO ZONE-BUF4
           ELSE
           IF Z-BUF-1 = "C" AND Z-BUF-2 = "O"
               MOVE "C   " TO ZONE-BUF1
           ELSE
           IF ZONE-BUF = "Z1  "
               MOVE "Z1  " TO ZONE-BUF1
               MOVE "Z1A " TO ZONE-BUF2
           ELSE
               MOVE ZONE-BUF TO ZONE-BUF1.
           IF DATE-BUF-MM = "X " OR " X" OR "XX"
               MOVE 4 TO DATE-MODE
               ACCEPT DATE-VALIDATE-IN FROM DATE
               CALL "TDATECHK" USING DATE-CHECK-AREA
               MOVE DATE-OUT TO DATE-BUF.
           IF DATE-BUF = SPACES
             IF SHIFT-BUF NOT = SPACE
                 MOVE TRUE-VAL TO INDS (6) INDS (99)
                 MOVE 29006 TO CATREAD-MSG-NUMBER
                 PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                 GO TO 6-MAIN.
           IF SHIFT-BUF = SPACES
             IF DATE-BUF NOT = SPACE
                 MOVE TRUE-VAL TO INDS (7) INDS (99)
                 MOVE 29007 TO CATREAD-MSG-NUMBER
                 PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                 GO TO 6-MAIN.
           IF DATE-BUF = SPACES
               NEXT SENTENCE
           ELSE
           MOVE 3 TO DATE-MODE
           MOVE DATE-BUF TO DATE-VALIDATE-IN
           CALL "TDATECHK" USING DATE-CHECK-AREA
           IF DATE-RET-CODE = 1
               MOVE TRUE-VAL TO INDS (6) INDS (99)
               MOVE DATE-MSG TO MISC-BUFFER
                 GO TO 6-MAIN
           ELSE
           MOVE DATE-DB TO DATE-WA.
           IF SHIFT-BUF = SPACES
               NEXT SENTENCE
           ELSE
           IF SHIFT-BUF = "A" OR "1" OR "2" OR "3" OR "4"
               NEXT SENTENCE
               ELSE
               MOVE TRUE-VAL TO INDS (7) INDS (99)
               MOVE 35034 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               GO TO 6-MAIN.
           MOVE 0 TO SUBT.
           PERFORM 6-SELECT-MAIN THRU 6-SELECT-M-EXIT UNTIL
                   RECORDS-PROCESSED-SW = "Y".
           IF ZONE-BUF = SPACES
               MOVE "ALL " TO ZONE-SUMM
           ELSE
           MOVE ZONE-BUF     TO ZONE-SUMM.
           IF DEPT-BUF = SPACES
               MOVE "ALL " TO DEPT-SUMM
           ELSE
           MOVE DEPT-BUF     TO DEPT-SUMM.
           IF EQNUM-BUF = SPACES
               MOVE "ALL   " TO EQNUM-SUMM
           ELSE
           MOVE EQNUM-BUF    TO EQNUM-SUMM.
           IF DATE-BUF = SPACES
               MOVE "ALL   " TO DATE-SUMM
           ELSE
           MOVE DATE-BUF     TO DATE-SUMM.
           IF SHIFT-BUF = SPACE
               MOVE "A" TO SHIFT-SUMM
           ELSE
           MOVE SHIFT-BUF TO SHIFT-SUMM.
           IF PRINT-BUF NOT = "P"
             MOVE SM-DATE TO MDY1
             MOVE SM-TIME TO TIMEB
             MOVE V-HEAD TO VERB
             MOVE P-HEAD TO PLND
             MOVE E-HEAD TO ENGN
             MOVE ZONE-SUMM TO ZONEB
             MOVE DEPT-SUMM TO DEPTB
             MOVE EQNUM-SUMM TO EQPNUM OF SHOW-BUFF
             MOVE DATE-SUMM TO MDY2
             MOVE SHIFT-SUMM TO SHIFT
           ELSE
             MOVE 2 TO ADV-CTR
             MOVE SPACES TO PRINT-REC
             WRITE PRINT-REC AFTER ADVANCING 0 LINES
             MOVE SUMMARY-DT-TM TO HOLD-BUFFER
             PERFORM PRINT-FUNCTION
             MOVE SUMMARY-TITLE TO HOLD-BUFFER
             PERFORM PRINT-FUNCTION
             MOVE SUMMARY-SEL1 TO HOLD-BUFFER
             PERFORM PRINT-FUNCTION
             MOVE SUMMARY-SEL2 TO HOLD-BUFFER
             PERFORM PRINT-FUNCTION
             MOVE SUMMARY-COL-HD TO HOLD-BUFFER
             PERFORM PRINT-FUNCTION.
           MOVE "1" TO PRT-DET.
           MOVE P1CW  TO CW-DET PRTYB (1, 1).
           ADD  P1CW  TO FIRST-TOT.
           ADD  P1CW  TO TOT-DET-9.
           MOVE P1HA  TO HA-DET PRTYB (1, 2).
           ADD  P1HA  TO SECND-TOT.
           ADD  P1HA  TO TOT-DET-9.
           MOVE P1HL  TO HL-DET PRTYB (1, 3).
           ADD  P1HL  TO THIRD-TOT.
           ADD  P1HL  TO TOT-DET-9.
           MOVE P1HM  TO HM-DET PRTYB (1, 4).
           ADD  P1HM  TO FORTH-TOT.
           ADD  P1HM  TO TOT-DET-9.
           MOVE P1HS  TO HS-DET PRTYB (1, 5).
           ADD  P1HS  TO FIFTH-TOT.
           ADD  P1HS  TO TOT-DET-9.
           MOVE P1IP  TO IP-DET PRTYB (1, 6).
           ADD  P1IP  TO SIXTH-TOT.
           ADD  P1IP  TO TOT-DET-9.
           MOVE P1OO  TO OO-DET PRTYB (1, 7).
           ADD  P1OO  TO SEVTH-TOT.
           ADD  P1OO  TO TOT-DET-9.
           MOVE P1SD  TO SD-DET PRTYB (1, 8).
           ADD  P1SD  TO EIGTH-TOT.
           ADD  P1SD  TO TOT-DET-9.
           MOVE P1PR  TO PR-DET PRTYB (1, 9).
           ADD  P1PR  TO NINTH-TOT.
           ADD  P1PR  TO TOT-DET-9.
           MOVE TOT-DET-9 TO TOT-DET TOTAL (1).
           IF PRINT-BUF NOT = "P"
               NEXT SENTENCE
           ELSE
           MOVE SUMMARY-DETAIL TO HOLD-BUFFER
           PERFORM PRINT-FUNCTION.
           MOVE ZEROS TO TOT-DET-9.
           MOVE "2" TO PRT-DET.
           MOVE P2CW  TO CW-DET PRTYB (2, 1).
           ADD  P2CW  TO FIRST-TOT.
           ADD  P2CW  TO TOT-DET-9.
           MOVE P2HA  TO HA-DET PRTYB (2, 2).
           ADD  P2HA  TO SECND-TOT.
           ADD  P2HA  TO TOT-DET-9.
           MOVE P2HL  TO HL-DET PRTYB (2, 3).
           ADD  P2HL  TO THIRD-TOT.
           ADD  P2HL  TO TOT-DET-9.
           MOVE P2HM  TO HM-DET PRTYB (2, 4).
           ADD  P2HM  TO FORTH-TOT.
           ADD  P2HM  TO TOT-DET-9.
           MOVE P2HS  TO HS-DET PRTYB (2, 5).
           ADD  P2HS  TO FIFTH-TOT.
           ADD  P2HS  TO TOT-DET-9.
           MOVE P2IP  TO IP-DET PRTYB (2, 6).
           ADD  P2IP  TO SIXTH-TOT.
           ADD  P2IP  TO TOT-DET-9.
           MOVE P2OO  TO OO-DET PRTYB (2, 7).
           ADD  P2OO  TO SEVTH-TOT.
           ADD  P2OO  TO TOT-DET-9.
           MOVE P2SD  TO SD-DET PRTYB (2, 8).
           ADD  P2SD  TO EIGTH-TOT.
           ADD  P2SD  TO TOT-DET-9.
           MOVE P2PR  TO PR-DET PRTYB (2, 9).
           ADD  P2PR  TO NINTH-TOT.
           ADD  P2PR  TO TOT-DET-9.
           MOVE TOT-DET-9 TO TOT-DET TOTAL (2).
           IF PRINT-BUF NOT = "P"
               NEXT SENTENCE
           ELSE
           MOVE SUMMARY-DETAIL TO HOLD-BUFFER
           PERFORM PRINT-FUNCTION.
           MOVE ZEROS TO TOT-DET-9.
           MOVE "3" TO PRT-DET.
           MOVE P3CW  TO CW-DET PRTYB (3, 1).
           ADD  P3CW  TO FIRST-TOT.
           ADD  P3CW  TO TOT-DET-9.
           MOVE P3HA  TO HA-DET PRTYB (3, 2).
           ADD  P3HA  TO SECND-TOT.
           ADD  P3HA  TO TOT-DET-9.
           MOVE P3HL  TO HL-DET PRTYB (3, 3).
           ADD  P3HL  TO THIRD-TOT.
           ADD  P3HL  TO TOT-DET-9.
           MOVE P3HM  TO HM-DET PRTYB (3, 4).
           ADD  P3HM  TO FORTH-TOT.
           ADD  P3HM  TO TOT-DET-9.
           MOVE P3HS  TO HS-DET PRTYB (3, 5).
           ADD  P3HS  TO FIFTH-TOT.
           ADD  P3HS  TO TOT-DET-9.
           MOVE P3IP  TO IP-DET PRTYB (3, 6).
           ADD  P3IP  TO SIXTH-TOT.
           ADD  P3IP  TO TOT-DET-9.
           MOVE P3OO  TO OO-DET PRTYB (3, 7).
           ADD  P3OO  TO SEVTH-TOT.
           ADD  P3OO  TO TOT-DET-9.
           MOVE P3SD  TO SD-DET PRTYB (3, 8).
           ADD  P3SD  TO EIGTH-TOT.
           ADD  P3SD  TO TOT-DET-9.
           MOVE P3PR  TO PR-DET PRTYB (3, 9).
           ADD  P3PR  TO NINTH-TOT.
           ADD  P3PR  TO TOT-DET-9.
           MOVE TOT-DET-9 TO TOT-DET TOTAL (3).
           IF PRINT-BUF NOT = "P"
               NEXT SENTENCE
           ELSE
           MOVE SUMMARY-DETAIL TO HOLD-BUFFER
           PERFORM PRINT-FUNCTION.
           MOVE ZEROS TO TOT-DET-9.
           MOVE "4" TO PRT-DET.
           MOVE P4CW  TO CW-DET PRTYB (4, 1).
           ADD  P4CW  TO FIRST-TOT.
           ADD  P4CW  TO TOT-DET-9.
           MOVE P4HA  TO HA-DET PRTYB (4, 2).
           ADD  P4HA  TO SECND-TOT.
           ADD  P4HA  TO TOT-DET-9.
           MOVE P4HL  TO HL-DET PRTYB (4, 3).
           ADD  P4HL  TO THIRD-TOT.
           ADD  P4HL  TO TOT-DET-9.
           MOVE P4HM  TO HM-DET PRTYB (4, 4).
           ADD  P4HM  TO FORTH-TOT.
           ADD  P4HM  TO TOT-DET-9.
           MOVE P4HS  TO HS-DET PRTYB (4, 5).
           ADD  P4HS  TO FIFTH-TOT.
           ADD  P4HS  TO TOT-DET-9.
           MOVE P4IP  TO IP-DET PRTYB (4, 6).
           ADD  P4IP  TO SIXTH-TOT.
           ADD  P4IP  TO TOT-DET-9.
           MOVE P4OO  TO OO-DET PRTYB (4, 7).
           ADD  P4OO  TO SEVTH-TOT.
           ADD  P4OO  TO TOT-DET-9.
           MOVE P4SD  TO SD-DET PRTYB (4, 8).
           ADD  P4SD  TO EIGTH-TOT.
           ADD  P4SD  TO TOT-DET-9.
           MOVE P4PR  TO PR-DET PRTYB (4, 9).
           ADD  P4PR  TO NINTH-TOT.
           ADD  P4PR  TO TOT-DET-9.
           MOVE TOT-DET-9 TO TOT-DET TOTAL (4).
           IF PRINT-BUF NOT = "P"
               NEXT SENTENCE
           ELSE
           MOVE SUMMARY-DETAIL TO HOLD-BUFFER
           PERFORM PRINT-FUNCTION.
           MOVE ZEROS TO TOT-DET-9.
           MOVE "5" TO PRT-DET.
           MOVE P5CW  TO CW-DET PRTYB (5, 1).
           ADD  P5CW  TO FIRST-TOT.
           ADD  P5CW  TO TOT-DET-9.
           MOVE P5HA  TO HA-DET PRTYB (5, 2).
           ADD  P5HA  TO SECND-TOT.
           ADD  P5HA  TO TOT-DET-9.
           MOVE P5HL  TO HL-DET PRTYB (5, 3).
           ADD  P5HL  TO THIRD-TOT.
           ADD  P5HL  TO TOT-DET-9.
           MOVE P5HM  TO HM-DET PRTYB (5, 4).
           ADD  P5HM  TO FORTH-TOT.
           ADD  P5HM  TO TOT-DET-9.
           MOVE P5HS  TO HS-DET PRTYB (5, 5).
           ADD  P5HS  TO FIFTH-TOT.
           ADD  P5HS  TO TOT-DET-9.
           MOVE P5IP  TO IP-DET PRTYB (5, 6).
           ADD  P5IP  TO SIXTH-TOT.
           ADD  P5IP  TO TOT-DET-9.
           MOVE P5OO  TO OO-DET PRTYB (5, 7).
           ADD  P5OO  TO SEVTH-TOT.
           ADD  P5OO  TO TOT-DET-9.
           MOVE P5SD  TO SD-DET PRTYB (5, 8).
           ADD  P5SD  TO EIGTH-TOT.
           ADD  P5SD  TO TOT-DET-9.
           MOVE P5PR  TO PR-DET PRTYB (5, 9).
           ADD  P5PR  TO NINTH-TOT.
           ADD  P5PR  TO TOT-DET-9.
           MOVE TOT-DET-9 TO TOT-DET TOTAL (5).
           IF PRINT-BUF NOT = "P"
               NEXT SENTENCE
           ELSE
           MOVE SUMMARY-DETAIL TO HOLD-BUFFER
           PERFORM PRINT-FUNCTION.
           MOVE ZEROS TO TOT-DET-9.
           MOVE "TOTAL" TO DET-HDR.
           MOVE FIRST-TOT  TO CW-DET TOTAL-COL (1).
           ADD  FIRST-TOT  TO TOTAL-TOT.
           MOVE SECND-TOT  TO HA-DET TOTAL-COL (2).
           ADD  SECND-TOT  TO TOTAL-TOT.
           MOVE THIRD-TOT  TO HL-DET TOTAL-COL (3).
           ADD  THIRD-TOT  TO TOTAL-TOT.
           MOVE FORTH-TOT  TO HM-DET TOTAL-COL (4).
           ADD  FORTH-TOT  TO TOTAL-TOT.
           MOVE FIFTH-TOT  TO HS-DET TOTAL-COL (5).
           ADD  FIFTH-TOT  TO TOTAL-TOT.
           MOVE SIXTH-TOT  TO IP-DET TOTAL-COL (6).
           ADD  SIXTH-TOT  TO TOTAL-TOT.
           MOVE SEVTH-TOT  TO OO-DET TOTAL-COL (7).
           ADD  SEVTH-TOT  TO TOTAL-TOT.
           MOVE EIGTH-TOT  TO SD-DET TOTAL-COL (8).
           ADD  EIGTH-TOT  TO TOTAL-TOT.
           MOVE NINTH-TOT  TO PR-DET TOTAL-COL (9).
           ADD  NINTH-TOT  TO TOTAL-TOT.
           MOVE TOTAL-TOT TO TOT-DET GRAND-TOT.
           IF PRINT-BUF NOT = "P"
               NEXT SENTENCE
           ELSE
           MOVE HEADING-DOTS TO HOLD-BUFFER
           PERFORM PRINT-FUNCTION
           MOVE SUMMARY-DETAIL TO HOLD-BUFFER
           PERFORM PRINT-FUNCTION
           MOVE SPACES TO PRINT-REC
           WRITE PRINT-REC BEFORE ADVANCING 0 LINES
           GO TO 2-EOJ.
           MOVE 1 TO ADV-CTR.
           MOVE "WORKSCN2" TO VIEW-CFNAME.
           MOVE 66124 TO CATREAD-MSG-NUMBER.
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
           MOVE MISC-BUFFER TO SHOW-CMD-LINE.
           MOVE SHOW-BUFF TO DSPLY-REC.
           PERFORM 99-SCREEN-WRITE.
           PERFORM 98-SCREEN-READ.
           IF VIEW-LASTKEY = 2 OR 3
               MOVE "WORKSCN1" TO VIEW-CFNAME
               MOVE SPACES TO VPE-BUF DSPLY-REC
               MOVE 0 TO SUBT
               MOVE 1 TO ADV-CTR
               MOVE ZEROS TO COUNTERS-SAVE TOTAL-PRTYS
               ACCEPT TIME-BUFFER FROM TIME
               MOVE CUR-TIME TO SM-TIME
               MOVE SPACES TO WORK-ARGUMENTS
               MOVE SPACES TO BUFFER-DEFN
               MOVE SPACES TO SUMM-DET VPE-HEADINGS
               MOVE 0 TO CW-DET HA-DET HM-DET IP-DET OO-DET TOT-DET
               MOVE 0 TO HS-DET SD-DET HL-DET
               MOVE "N" TO RECORDS-PROCESSED-SW
               MOVE "N" TO CLOSE-SW
               MOVE ZEROS TO COUNTERS
               MOVE 0 TO VIEW-LASTKEY
               MOVE 0 TO COND-WORD
               GO TO 6-MAIN.

       PRINT-FUNCTION.
           MOVE HOLD-BUFFER TO PRINT-REC.
           WRITE PRINT-REC AFTER ADVANCING ADV-CTR.

       6-SELECT-MAIN.
           ADD 1 TO SUBT.
           IF SUBT > 9
               MOVE "Y" TO RECORDS-PROCESSED-SW
               GO TO 6-SELECT-M-EXIT.
           MOVE ZEROS TO COUNTERS.
           MOVE TABLE-STAT (SUBT) TO ARG-DEFN.
           IF V-BUF = SPACE GO TO 6-SELECT-CONT.
           PERFORM 69-START-WO-BASIC-FILE.
           IF COND-WORD = 17
               IF SUBT > 9
                   MOVE "Y" TO RECORDS-PROCESSED-SW
                   GO TO 6-SELECT-M-EXIT
               ELSE
               GO TO 6-SELECT-CONT.
           PERFORM 6-SELECT-BASIC THRU 6-SELECT-B-EXIT
                                UNTIL COND-WORD = 15.

       6-SELECT-CONT.
           IF P-BUF = SPACE AND E-BUF = SPACE
               GO TO 6-SELECT-M-COUNT.
           PERFORM 69-START-WO-PLANNED-FILE.
           IF COND-WORD = 17
               IF SUBT > 9
                   MOVE "Y" TO RECORDS-PROCESSED-SW
                   GO TO 6-SELECT-M-EXIT
               ELSE
               GO TO 6-SELECT-M-COUNT.
           PERFORM 6-SELECT-PLANNED THRU 6-SELECT-P-EXIT
                   UNTIL COND-WORD = 15.

       6-SELECT-M-COUNT.
           MOVE COUNTERS TO COUNTER-TABLE (SUBT).

       6-SELECT-M-EXIT.    EXIT.

       6-SELECT-BASIC.
           PERFORM 69-READ-WO-BASIC-FILE.
           IF COND-WORD = 15 GO TO 6-SELECT-B-EXIT.
           MOVE EQUIP-NUM   TO SELECT-BUF.
           PERFORM 6-SELECT-COUNT THRU 6-SELECT-C-EXIT.

       6-SELECT-B-EXIT.    EXIT.

       6-SELECT-PLANNED.
           PERFORM 69-READ-WO-PLANNED-FILE.
           IF COND-WORD = 15 GO TO 6-SELECT-P-EXIT.
           IF WO-CURRENT-TYPE = "P" AND P-BUF = SPACE
               GO TO 6-SELECT-P-EXIT.
           IF WO-CURRENT-TYPE = "E" AND E-BUF = SPACE
               GO TO 6-SELECT-P-EXIT.
           MOVE SPACES         TO WO-BASIC-DATA.
           MOVE ZONE-P         TO ZONE.
           MOVE EQUIP-NUM-P    TO SELECT-BUF.
           MOVE DEPT-P         TO DEPT.
           MOVE TIME-COMP-P    TO TIME-COMP.
           MOVE DATE-COMP-P-CN TO DATE-COMP-CN.
           MOVE PRIORITY-P     TO PRIORITY.
           PERFORM 6-SELECT-COUNT THRU 6-SELECT-C-EXIT.

       6-SELECT-P-EXIT.    EXIT.

       6-SELECT-COUNT.
           IF ARG-DEFN NOT = "CW" GO TO 6-SELECT-C-CONT.
           IF DATE-BUF = SPACES   GO TO 6-SELECT-C-CONT.
           IF DATE-COMP NUMERIC
               NEXT SENTENCE
           ELSE GO TO 6-SELECT-C-EXIT.
           IF TIME-COMP NUMERIC
               NEXT SENTENCE
           ELSE GO TO 6-SELECT-C-EXIT.

           MOVE ZONE TO ZONE-BUFF.
           MOVE TIME-COMP TO TIME-IN.
           CALL "TGETSHFT" USING LINK-DATA DBPARAMETERS
           IF S-1 > E-1 MOVE S-1 TO LABOR-DAY-START
           ELSE
           IF S-2 > E-2 MOVE S-2 TO LABOR-DAY-START
           ELSE
           IF S-3 > E-3 MOVE S-3 TO LABOR-DAY-START
           ELSE
           IF S-4 > E-4 MOVE S-4 TO LABOR-DAY-START
           ELSE
           MOVE 0000 TO LABOR-DAY-START.

           MOVE DATE-COMP-CN TO GREGDATE.
           MOVE SPACES TO JULDATE.
           CALL "JULGREG" USING GREGDATE JULDATE DAYDIGIT LEAPYEAR.
           IF LEAPYEAR = "Y"
               IF JULDAY = 366
                  MOVE 1 TO JULDAY
                  ADD 1 TO JULYEAR
               ELSE
                  ADD 1 TO JULDAY
               END-IF
           ELSE
               IF JULDAY = 365
                  MOVE 1 TO JULDAY
                  ADD 1 TO JULYEAR
               ELSE
                  ADD 1 TO JULDAY
               END-IF
           END-IF.
           MOVE SPACES TO GREGDATE.
           CALL "JULGREG" USING GREGDATE JULDATE DAYDIGIT LEAPYEAR.
           MOVE GREGDATE-YMD TO DATE-WA-2.

           IF LABOR-DAY-START = 0000
               NEXT SENTENCE
           ELSE
           IF TIME-COMP < LABOR-DAY-START
               NEXT SENTENCE
           ELSE
           MOVE DATE-WA-2 TO DATE-COMP.
           IF DATE-WA = DATE-COMP
               IF SHIFT-BUF = "A" OR CURR-SHIFT
                   NEXT SENTENCE
               ELSE
               GO TO 6-SELECT-C-EXIT
           ELSE
           GO TO 6-SELECT-C-EXIT.

       6-SELECT-C-CONT.
           IF EQ1 = SELECT-EQ1 OR SPACE
             IF EQ2 = SELECT-EQ2 OR SPACE
               IF EQ3 = SELECT-EQ3 OR SPACE
                 IF EQ4 = SELECT-EQ4 OR SPACE
                   IF EQ5 = SELECT-EQ5 OR SPACE
                     IF EQ6 = SELECT-EQ6 OR SPACE
                       NEXT SENTENCE
                     ELSE
                       GO TO 6-SELECT-C-EXIT
                   ELSE
                     GO TO 6-SELECT-C-EXIT
                 ELSE
                   GO TO 6-SELECT-C-EXIT
               ELSE
                 GO TO 6-SELECT-C-EXIT
             ELSE
               GO TO 6-SELECT-C-EXIT
           ELSE
             GO TO 6-SELECT-C-EXIT.

           IF ZONE-BUF = SPACES
               NEXT SENTENCE
           ELSE
           IF ZONE = ZONE-BUF1 OR ZONE-BUF2 OR ZONE-BUF3 OR ZONE-BUF4
               NEXT SENTENCE
           ELSE
           GO TO 6-SELECT-C-EXIT.
           IF DEPT-BUF = DEPT OR SPACES
               NEXT SENTENCE
           ELSE
           GO TO 6-SELECT-C-EXIT.
           IF PRIORITY = "1 "
               ADD 1 TO PRTY1-K
           ELSE
           IF PRIORITY = "2 "
               ADD 1 TO PRTY2-K
           ELSE
           IF PRIORITY = "3 "
               ADD 1 TO PRTY3-K
           ELSE
           IF PRIORITY = "4 "
               ADD 1 TO PRTY4-K
           ELSE
           IF PRIORITY = "5 "
               ADD 1 TO PRTY5-K.

       6-SELECT-C-EXIT.    EXIT.

       69-READ-WO-BASIC-FILE.
           MOVE 0 TO COND-WORD.
           READ WO-BASIC-FILE NEXT INTO WO-BASIC-DATA
               AT END    MOVE 15 TO COND-WORD.
           IF ARG-DEFN NOT = WOSTATUS OF WBFREC MOVE 15 TO COND-WORD.
           IF WBF-STATUS NOT = "00" MOVE 15 TO COND-WORD.

       69-START-WO-BASIC-FILE.
           MOVE 0 TO COND-WORD.
           MOVE ARG-DEFN TO WOSTATUS OF WBFREC.
           START WO-BASIC-FILE KEY IS = EXTERNALLY-DESCRIBED-KEY
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF WBF-STATUS NOT = "00" MOVE 17 TO COND-WORD.

       69-READ-WO-PLANNED-FILE.
           MOVE 0 TO COND-WORD.
           READ WO-PLANNED-FILE NEXT INTO WO-PLANNED-DATA
               AT END    MOVE 15 TO COND-WORD.
           IF ARG-DEFN NOT = WOSTATUS OF WPFREC MOVE 15 TO COND-WORD.
           IF WPF-STATUS NOT = "00" MOVE 15 TO COND-WORD.

       69-START-WO-PLANNED-FILE.
           MOVE 0 TO COND-WORD.
           MOVE ARG-DEFN TO WOSTATUS OF WPFREC.
           START WO-PLANNED-FILE KEY IS = EXTERNALLY-DESCRIBED-KEY
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF WPF-STATUS NOT = "00" MOVE 17 TO COND-WORD.

       69-START-WO-ZONE-PRTY-FILE.
           MOVE 0 TO COND-WORD.
           MOVE ZONE-ARGUMENT TO ZONEPRTY OF WZPFREC.
           START WO-ZONE-PRTY-FILE KEY IS = EXTERNALLY-DESCRIBED-KEY
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF WZPF-STATUS NOT = "00" MOVE 17 TO COND-WORD.

       98-SCREEN-READ.
           READ DISPLAY-FILE FORMAT IS VIEW-CFNAME
               INDIC IS INDICS.
           ACCEPT IOFEEDBACK FROM I-O-FEEDBACK-AREA.
           MOVE ALL B"0" TO INDICS.
           IF DSPLY-STATUS NOT = "00"
               MOVE 3 TO VIEW-LASTKEY
           ELSE
           MOVE FUNCTION-NUM TO VIEW-LASTKEY.

       99-SCREEN-WRITE.
           WRITE DSPLY-REC FORMAT IS VIEW-CFNAME
               INDIC IS INDICS.
           MOVE ALL B"0" TO INDICS.

       999-CATREAD.
           MOVE SPACES TO MISC-BUFFER.
           CALL "CCATREAD" USING CATREAD-PARMS.
           MOVE CATREAD-MSG-TEXT TO MISC-BUFFER.
       999-CATREAD-EXIT.    EXIT.
