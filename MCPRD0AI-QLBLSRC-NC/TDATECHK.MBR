026100 PROCEDURE DIVISION USING DATE-CHECK-AREA.
026200 START-PROCESSING.
026300 6000-MAIN.
026400     IF DATE-MODE = 0
026500         PERFORM 6100-FLIP-DATES THRU 6100-FD-X
026600         GOBACK.
026700
026800     IF DATE-CODE = 0
026900         PERFORM 7000-GET-DATE-CODE THRU 7090-GDC-X.
027000
027100     MOVE SPACES                   TO  FORMATTED-TIME-OUT.
027200     MOVE SPACES                   TO  UNFORMATTED-TIME-OUT.
027300     MOVE "/"                      TO  DATE-SLASH-OUT-S1.
027400     MOVE "/"                      TO  DATE-SLASH-OUT-S2.
027500     MOVE 0                        TO  DATE-RET-CODE.
027600
027700     IF DATE-MODE = 1
               ACCEPT IBM-DATE-WORK      FROM DATE
               MOVE IBM-DATE-WORK-MM TO DATE-SLASH-OUT-MD
               MOVE IBM-DATE-WORK-DD TO DATE-SLASH-OUT-DM
               MOVE IBM-DATE-WORK-YY TO DATE-SLASH-OUT-YY
027900         PERFORM 6200-CURRENT-DATE THRU 6290-CD-X.
028000     IF DATE-MODE = 2
028100         MOVE DATE-VALIDATE-IN     TO  DATE-SLASH-OUT
028200         PERFORM 6200-CURRENT-DATE THRU 6290-CD-X.
028300     IF DATE-MODE = 3
028400         PERFORM 6300-DISPLAY-DATE THRU 6390-DD-X
028500         IF DATE-RET-CODE = 1
028600             IF DATE-CODE = 3
028700                 MOVE
028800                 "The field must be a valid date, in DMY order."
028900                 TO  DATE-MSG
029000             ELSE
029100                 MOVE
029200                 "The field must be a valid date, in MDY order."
029300                 TO DATE-MSG.
029400     IF DATE-MODE = 4
029500         PERFORM 6400-DATABASE-DATE THRU 6490-DD-X.
029600
029700     GOBACK.
029800
029900 6100-FLIP-DATES.
030000     MOVE DATE-IN TO DATE-OUT.
030100     IF DATE-CODE = 3 OR 5 OR 6 OR 8
030200         MOVE DATE-IN-MD TO DATE-OUT-DM
030300         MOVE DATE-IN-DM TO DATE-OUT-MD.
030400
030500 6100-FD-X.
030600     EXIT.
030700
030800 6200-CURRENT-DATE.
030900     MOVE ":"                      TO  FORMATTED-TIME-C1.
031000     MOVE ":"                      TO  FORMATTED-TIME-C2.
031100     MOVE DATE-SLASH-OUT-MD        TO  DATE-YMD-OUT-MM.
031200     MOVE DATE-SLASH-OUT-DM        TO  DATE-YMD-OUT-DD.
031300     MOVE DATE-SLASH-OUT-YY        TO  DATE-YMD-OUT-YY.
031400
031500     MOVE DATE-SLASH-OUT-MD        TO  DATE-OUT-MD.
031600     MOVE DATE-SLASH-OUT-DM        TO  DATE-OUT-DM.
031700     MOVE DATE-SLASH-OUT-YY        TO  DATE-OUT-YY.
031800
031900     IF DATE-CODE = 3
032000         PERFORM 7100-FLIP-DATE-SLASH-OUT
032100         PERFORM 7200-FLIP-DATE-OUT.
032200
032300     ACCEPT UNFORMATTED-TIME-OUT   FROM TIME.
032400     MOVE UNFORMATTED-TIME-HH      TO  FORMATTED-TIME-HH.
032500     MOVE UNFORMATTED-TIME-MN      TO  FORMATTED-TIME-MN.
032600     MOVE UNFORMATTED-TIME-SS      TO  FORMATTED-TIME-SS.
032700
032800 6290-CD-X.
032900     EXIT.
033000
033100 6300-DISPLAY-DATE.
033200
033300     IF DATE-NUMERIC = SPACES
033400         MOVE SPACES               TO  DATE-YMD-OUT
033500         MOVE SPACES               TO  DATE-SLASH-OUT
033600         GO TO 6390-DD-X.
033700
033800*---------- THE DATE SEPERATOR (I.E. 3/5/85) COULD BE ANY ASCII
033900*---------- CHARACTER LESS THAN "0" - THAT IS "/", ".", "-",
034000*---------- SPACE, ETC.
034100     IF DATE-NUMERIC NUMERIC
034200         MOVE DATE-NUMERIC         TO  DATE-WORK
034300     ELSE
034400     IF DT1-S2 < "0"
034500       IF DT1-MD NUMERIC AND DT1-DM NUMERIC AND DT1-YY NUMERIC
034600         MOVE DT1-MD               TO  DATE-WORK-MD
034700         MOVE DT1-DM               TO  DATE-WORK-DM
034800         MOVE DT1-YY               TO  DATE-WORK-YY
034900       ELSE
035000         MOVE 1                    TO  DATE-RET-CODE
035100         GO TO 6390-DD-X
035200     ELSE
035300     IF DT2-S1 < "0"
035400       IF DT2-MD NUMERIC AND DT2-DM NUMERIC AND DT2-YY NUMERIC
035500         MOVE DT2-MD               TO  DATE-WORK-MD
035600         MOVE DT2-DM               TO  DATE-WORK-DM
035700         MOVE DT2-YY               TO  DATE-WORK-YY
035800       ELSE
035900         MOVE 1                    TO  DATE-RET-CODE
036000         GO TO 6390-DD-X
036100     ELSE
036200     IF DT3-S2 < "0"
036300       IF DT3-MD NUMERIC AND DT3-DM NUMERIC AND DT3-YY NUMERIC
036400         MOVE DT3-MD               TO  DATE-WORK-MD
036500         MOVE DT3-DM               TO  DATE-WORK-DM
036600         MOVE DT3-YY               TO  DATE-WORK-YY
036700       ELSE
036800         MOVE 1                    TO  DATE-RET-CODE
036900         GO TO 6390-DD-X
037000     ELSE
037100     IF DT4-S2 < "0"
037200       IF DT4-MD NUMERIC AND DT4-DM NUMERIC AND DT4-YY NUMERIC
037300         MOVE DT4-MD               TO  DATE-WORK-MD
037400         MOVE DT4-DM               TO  DATE-WORK-DM
037500         MOVE DT4-YY               TO  DATE-WORK-YY
037600       ELSE
037700         MOVE 1                    TO  DATE-RET-CODE
037800         GO TO 6390-DD-X
037900     ELSE
038000         MOVE 1                    TO  DATE-RET-CODE
038100         GO TO 6390-DD-X.
038200
038300     MOVE DATE-WORK-MD             TO  DATE-SLASH-OUT-MD.
038400     MOVE DATE-WORK-DM             TO  DATE-SLASH-OUT-DM.
038500     MOVE DATE-WORK-YY             TO  DATE-SLASH-OUT-YY.
038600     MOVE DATE-WORK-MD             TO  DATE-OUT-MD.
038700     MOVE DATE-WORK-DM             TO  DATE-OUT-DM.
038800     MOVE DATE-WORK-YY             TO  DATE-OUT-YY.
038900
039000     IF DATE-CODE = 3
039100         MOVE DATE-WORK-MD         TO  DATE-YMD-OUT-DD
039200         MOVE DATE-WORK-DM         TO  DATE-YMD-OUT-MM
039300         MOVE DATE-WORK-YY         TO  DATE-YMD-OUT-YY
039400     ELSE
039500         MOVE DATE-WORK-MD         TO  DATE-YMD-OUT-MM
039600         MOVE DATE-WORK-DM         TO  DATE-YMD-OUT-DD
039700         MOVE DATE-WORK-YY         TO  DATE-YMD-OUT-YY.
039800
039900     IF DATE-YMD-OUT-MM = "02"
040000         IF DATE-WORK-YY > 00
040100             DIVIDE DATE-WORK-YY BY 4 GIVING LEAP-TEST
040200             IF LEAP-TEST-DEC > 0
040300                 MOVE "N"          TO  LEAP-YEAR-FLAG
040400             ELSE
040500                 MOVE "Y"          TO  LEAP-YEAR-FLAG
040600         ELSE
040700             MOVE "Y"              TO  LEAP-YEAR-FLAG.
040800
040900     IF DATE-YMD-OUT-MM = "02"
041000         IF LEAP-YEAR-FLAG = "Y"
041100             IF DATE-YMD-OUT-DD < "01" OR > "29"
041200                 MOVE 1            TO  DATE-RET-CODE
041300                 GO TO 6390-DD-X
041400             ELSE
041500                 NEXT SENTENCE
041600         ELSE
041700         IF DATE-YMD-OUT-DD < "01" OR > "28"
041800             MOVE 1                TO  DATE-RET-CODE
041900             GO TO 6390-DD-X
042000         ELSE
042100             NEXT SENTENCE
042200     ELSE
042300     IF DATE-YMD-OUT-MM = "04" OR "06" OR "09" OR "11"
042400         IF DATE-YMD-OUT-DD < "01" OR > "30"
042500             MOVE 1                TO  DATE-RET-CODE
042600             GO TO 6390-DD-X
042700         ELSE
042800             NEXT SENTENCE
042900     ELSE
043000     IF DATE-YMD-OUT-MM = "01" OR "03" OR "05" OR "07" OR
043100                          "08" OR "10" OR "12"
043200         IF DATE-YMD-OUT-DD < "01" OR > "31"
043300             MOVE 1                TO  DATE-RET-CODE
043400             GO TO 6390-DD-X
043500         ELSE
043600             NEXT SENTENCE
043700     ELSE
043800         MOVE 1                    TO  DATE-RET-CODE
043900         GO TO 6390-DD-X.
044000
044100 6390-DD-X.
044200     EXIT.
044300
044400 6400-DATABASE-DATE.
044500     MOVE DATE-VALIDATE-IN         TO  DATE-YMD-OUT.
044600     MOVE DATE-YMD-OUT-YY          TO  DATE-SLASH-OUT-YY.
044700     MOVE DATE-YMD-OUT-MM          TO  DATE-SLASH-OUT-MD.
044800     MOVE DATE-YMD-OUT-DD          TO  DATE-SLASH-OUT-DM.
044900
045000     MOVE DATE-YMD-OUT-YY          TO  DATE-OUT-YY.
045100     MOVE DATE-YMD-OUT-MM          TO  DATE-OUT-MD.
045200     MOVE DATE-YMD-OUT-DD          TO  DATE-OUT-DM.
045300
045400     IF DATE-CODE = 3
045500         PERFORM 7100-FLIP-DATE-SLASH-OUT
045600        PERFORM 7200-FLIP-DATE-OUT.
045700
045800     IF DATE-SLASH-OUT = "  /  /  "
045900         MOVE SPACES               TO  DATE-SLASH-OUT.
046000
      *------ THEY CAN ALSO PASS AN UNFORMATTED TIME FROM THE
      *------ DATABASE AND GET A FORMATTED TIME BACK.
           IF UNFORMATTED-TIME-OUT > SPACES
               MOVE UNFORMATTED-TIME-HH  TO  FORMATTED-TIME-HH
               MOVE ":"                  TO  FORMATTED-TIME-C1
               MOVE UNFORMATTED-TIME-MN  TO  FORMATTED-TIME-MN
               MOVE ":"                  TO  FORMATTED-TIME-C2
               MOVE UNFORMATTED-TIME-SS  TO  FORMATTED-TIME-SS.

046100 6490-DD-X.
046200     EXIT.
046300
046400 7000-GET-DATE-CODE.
           MOVE "DATECODE"   TO  CHKOBJ-FILE-NAME.
           CALL "CCHKOBJ" USING CHKOBJ-FILE-NAME,
                                CHKOBJ-RETURN-STATUS.
           IF CHKOBJ-RETURN-STATUS  = "00"
               MOVE 3                    TO  DATE-CODE
           ELSE
               MOVE 1                    TO  DATE-CODE
           END-IF.

046500*    CALL INTRINSIC "FOPEN" USING DDATECOD-FILE, %7, %0,
046600*      \\,\\,\\,\\,\\,\\,\\,\\,\\,\\
046700*        GIVING DDATECOD-FNUM.
046800*    IF C-C = 0
046900*        MOVE 3                    TO  DATE-CODE
047000*    ELSE
047100*        MOVE 1                    TO  DATE-CODE.
047200*
047300*    CALL INTRINSIC "FCLOSE" USING DDATECOD-FNUM, 0, 0.
047400*
047500 7090-GDC-X.
047600     EXIT.
047700
047800 7100-FLIP-DATE-SLASH-OUT.
047900     MOVE DATE-SLASH-OUT-MD        TO  SAVE-AREA.
048000     MOVE DATE-SLASH-OUT-DM        TO  DATE-SLASH-OUT-MD.
048100     MOVE SAVE-AREA                TO  DATE-SLASH-OUT-DM.
048200
048300 7200-FLIP-DATE-OUT.
048400     MOVE DATE-OUT-MD              TO  SAVE-AREA.
048500     MOVE DATE-OUT-DM              TO  DATE-OUT-MD.
048600     MOVE SAVE-AREA                TO  DATE-OUT-DM.
