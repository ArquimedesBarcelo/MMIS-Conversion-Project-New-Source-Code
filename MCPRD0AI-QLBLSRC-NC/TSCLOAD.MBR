       IDENTIFICATION DIVISION.
       PROGRAM-ID.     TSCLOAD.
       AUTHOR.         W. ROXBURY.
       DATE-WRITTEN.   05/15/1989.
       DATE-COMPILED.
       INSTALLATION.   GOODYEAR TIRE & RUBBER CO.
      *REMARKS.        THIS PROGRAM LOADS SAFETY EQUIPMENT
      *                INTO THE MMIS DATABASE
      *C
      *C 05/20/2003 WR FONAGY
      *C   ADDED THE ABILITY OF THE SAFETY COORIDINATOR TO SET
      *C   UP THE SAFETY CONTACT PASSWORD FLAG.  THIS WILL PROMPT
      *C   THE USER TO ENTER THEIR CLOCK CARD AND THAT WILL BE
      *C   USED AS A VALIDATION CHECK.
      *C
      *
       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.
       SOURCE-COMPUTER.        IBM-AS400.
       OBJECT-COMPUTER.        IBM-AS400.
       SPECIAL-NAMES.          REQUESTOR IS WORK-STATION
                               SYSTEM-CONSOLE IS CONSOLE
                               LOCAL-DATA IS LOCAL-DATA-AREA.
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT EQP-EQUIPMENT
                  ASSIGN       TO DATABASE-MCFLMM0201
                  ORGANIZATION IS INDEXED
                  ACCESS MODE  IS DYNAMIC
                  RECORD KEY   IS EXTERNALLY-DESCRIBED-KEY
                  FILE STATUS  IS FILE-STAT.

           SELECT WO-ZONE-PRTY
                  ASSIGN       TO DATABASE-MCFLMM0501
                  ORGANIZATION IS INDEXED
                  ACCESS MODE  IS DYNAMIC
                  RECORD KEY   IS EXTERNALLY-DESCRIBED-KEY
                  FILE STATUS  IS FILE-STAT.

           SELECT WO-CRAFTS-REQD
                  ASSIGN       TO DATABASE-MCFLMM0601
                  ORGANIZATION IS INDEXED
                  ACCESS MODE  IS DYNAMIC
                  RECORD KEY   IS EXTERNALLY-DESCRIBED-KEY
                  FILE STATUS  IS FILE-STAT.

           SELECT DISPLAY-FILE
                  ASSIGN       TO WORKSTATION-ZSCSYSTEM-SI
                  ORGANIZATION IS TRANSACTION
                  ACCESS MODE  IS SEQUENTIAL
                  FILE STATUS  IS SCREEN-STATUS
                               MAJOR-MINOR
                  CONTROL-AREA IS SCREEN-CONTROL.

       DATA DIVISION.
       FILE SECTION.
       FD  EQP-EQUIPMENT
           LABEL RECORDS       ARE STANDARD.
       01  EQP-REC.
           COPY DDS-ALL-FORMATS OF MCFLMM0201.

       FD  WO-ZONE-PRTY
           LABEL RECORDS ARE STANDARD.
       01  ZP-REC.
           COPY DDS-ALL-FORMATS OF MCFLMM0501.

       FD  WO-CRAFTS-REQD
           LABEL RECORDS ARE STANDARD.
       01  CFT-REC.
           COPY DDS-ALL-FORMATS OF MCFLMM0601.

       FD  DISPLAY-FILE
           LABEL RECORDS       ARE OMITTED.
       01  DISPLAY-REC         PIC X(2000).

       WORKING-STORAGE SECTION.
       77  FILE-STAT           PIC XX.
       77  CFT-HOLD            PIC XX.
       77  SYSTEM-SW           PIC 99  VALUE 0.
           88  SYSTEM-ON               VALUE 1.
       77  SAFETY-PWORD-SW     PIC X   VALUE "N".
       77  CHAR                PIC 99  VALUE 0.
       77  SUB                 PIC 99  VALUE 0.
       77  SUBS                PIC 99  VALUE 0.
       77  SUBT                PIC 99  VALUE 0.
       77  CYC-CTR             PIC 9   VALUE 0.
       77  SCREEN-SAVE         PIC X(576).
       77  SCREEN-HOLD         PIC X(576).
       77  TRUE-VAL            PIC 1   VALUE B"1".

       01  SCREEN-DATA.
           05  LOCATION-DATA   PIC X(396).
           05  LOCATION-TABLE  REDEFINES LOCATION-DATA.
               10  SC-LOC      OCCURS 18 TIMES.
                   15  LOC     PIC X(18).
                   15  ZON     PIC X(04).
           05  CMDMSG          PIC X(79).
           05  ERRMSG          PIC X(79).

       01  PREVIEW-SCREEN.
           05  PREVIEW-DATA    PIC X(396).
           05  PREVIEW-TABLE   REDEFINES PREVIEW-DATA.
               10  PS-LOC      OCCURS 18 TIMES.
                   15  PSNUM   PIC X(04).
                   15  PSLOC   PIC X(18).
           05  CMDMSGPS        PIC X(79).
           05  ERRMSGPS        PIC X(79).

       01  EXIT-SCREEN.
           05  LOC-DATA        PIC X(396).
           05  LOC-TABLE       REDEFINES LOC-DATA.
               10  ES-LOC      OCCURS 18 TIMES.
                   15  ESNUM   PIC X(04).
                   15  ESLOC   PIC X(18).
           05  SW-BUFF         PIC XX.
           05  DFLT-BUFF       PIC XX.
           05  SW-DISP         PIC XXX.
           05  SW-PWORD        PIC X.
           05  CMDMSGES        PIC X(79).
           05  ERRMSGES        PIC X(79).

       01  CRAFT-SCREEN.
           05  DFLT-CFT        PIC XX.
           05  CMDMSGDC        PIC X(79).
           05  ERRMSGDC        PIC X(79).

       01  CYCLE-SCREEN.
           05  CYCLE-BUF.
               10  CYC-1       PIC X.
               10  CYC-2       PIC X.
               10  CYC-3       PIC X.
               10  CYC-4       PIC X.
           05  DFLT-CYC        PIC XX.
           05  CMDMSGCY        PIC X(79).
           05  ERRMSGCY        PIC X(79).

       01  HOLD-BUFFER.
           05  HOLD-DATA       OCCURS 19 TIMES PIC X(22).

       01  EQUIP-BUFFER.
           05  EQUIP-VALUES.
               10  EQP01       PIC X(06) VALUE "SAFE01".
               10  EQP02       PIC X(06) VALUE "SAFE02".
               10  EQP03       PIC X(06) VALUE "SAFE03".
               10  EQP04       PIC X(06) VALUE "SAFE04".
               10  EQP05       PIC X(06) VALUE "SAFE05".
               10  EQP06       PIC X(06) VALUE "SAFE06".
               10  EQP07       PIC X(06) VALUE "SAFE07".
               10  EQP08       PIC X(06) VALUE "SAFE08".
               10  EQP09       PIC X(06) VALUE "SAFE09".
               10  EQP10       PIC X(06) VALUE "SAFE10".
               10  EQP11       PIC X(06) VALUE "SAFE11".
               10  EQP12       PIC X(06) VALUE "SAFE12".
               10  EQP13       PIC X(06) VALUE "SAFE13".
               10  EQP14       PIC X(06) VALUE "SAFE14".
               10  EQP15       PIC X(06) VALUE "SAFE15".
               10  EQP16       PIC X(06) VALUE "SAFE16".
               10  EQP17       PIC X(06) VALUE "SAFE17".
               10  EQP18       PIC X(06) VALUE "SAFE18".
           05  EQP-VAL         REDEFINES EQUIP-VALUES.
               10  EQPVAL      OCCURS 18 TIMES  PIC X(06).

       01  TABLE-BUFFER.
           05  TABLE-VALUES.
               10  SUB01       PIC 99 VALUE  1.
               10  SUB02       PIC 99 VALUE  4.
               10  SUB03       PIC 99 VALUE  7.
               10  SUB04       PIC 99 VALUE 10.
               10  SUB05       PIC 99 VALUE 13.
               10  SUB06       PIC 99 VALUE 16.
               10  SUB07       PIC 99 VALUE  2.
               10  SUB08       PIC 99 VALUE  5.
               10  SUB09       PIC 99 VALUE  8.
               10  SUB10       PIC 99 VALUE 11.
               10  SUB11       PIC 99 VALUE 14.
               10  SUB12       PIC 99 VALUE 17.
               10  SUB13       PIC 99 VALUE  3.
               10  SUB14       PIC 99 VALUE  6.
               10  SUB15       PIC 99 VALUE  9.
               10  SUB16       PIC 99 VALUE 12.
               10  SUB17       PIC 99 VALUE 15.
               10  SUB18       PIC 99 VALUE 18.
           05  SUB-VAL         REDEFINES TABLE-VALUES.
               10  SUBV        OCCURS 18 TIMES  PIC 99.

       01  SKIP-TABLE          VALUE SPACES.
           05  SKIP            OCCURS 18 TIMES  PIC X.

       01  PLACE.
           05  CTR             PIC 99.
           05  ZCTR            REDEFINES CTR.
               10  ZCTR1       PIC X.
               10  ZCTR2       PIC X.
           05  FILLER          PIC XX    VALUE " -".

       01  DB-ERROR.
           05  DB-FUNC         PIC X(10) VALUE SPACES.
           05  DB-FILE         PIC X(18) VALUE SPACES.
           05  FILLER          PIC X(20) VALUE "ERROR - FILE-STAT = ".
           05  CON-WORD        PIC XX.

           COPY CATREAD        IN COPYLIB.

           COPY SCREENIO       IN COPYLIB.

       01  DBPARAMETERS.
           COPY DBPARMS        IN COPYLIB.

       01  EQUIPMENT-DATA.
           COPY MEQPFILE       IN COPYLIB.

       01  WO-ZONE-DATA.
           COPY MZONPRTY       IN COPYLIB.

       01  MESSAGE-BUFFER-DATA.
           COPY ERRORLIN       IN COPYLIB.

       PROCEDURE DIVISION.
       BEGIN.
           OPEN I-O            DISPLAY-FILE.
           OPEN I-O            EQP-EQUIPMENT.
           OPEN INPUT          WO-CRAFTS-REQD.
           OPEN INPUT          WO-ZONE-PRTY.

       PRELOAD.
           MOVE SPACES         TO SCREEN-DATA
                                  CRAFT-SCREEN
                                  EXIT-SCREEN
                                  SCREEN-SAVE
                                  SCREEN-HOLD
                                  CFT-HOLD
                                  DISPLAY-REC
                                  DBPARAMETERS.

           MOVE 0              TO SYSTEM-SW.
           MOVE "N"            TO SAFETY-PWORD-SW.
           PERFORM LOAD-LOOP   VARYING SUB FROM 1 BY 1
                               UNTIL SUB > 18.
           MOVE EQP-RIME       TO DFLT-CYC.
           MOVE SCREEN-DATA    TO SCREEN-SAVE.

       MAIN.
           MOVE "INITLOAD"     TO SCREEN-NAME.
           MOVE SPACES         TO MESSAGE-BUFFER.
           MOVE ALL B"0"       TO SCREEN-INDICATORS.

       SHOWFORM.
           MOVE "00"           TO SCREEN-STATUS.
           MOVE SCREEN-DATA    TO DISPLAY-REC.

           WRITE DISPLAY-REC   FORMAT IS SCREEN-NAME
               INDIC ARE SCREEN-INDICATORS.
           IF SCREEN-STATUS NOT = "00"
               DISPLAY "SCREEN WRITE ERROR.  SCREEN-STATUS IS "
                        SCREEN-STATUS
               GO TO END-OF-JOB.

           READ  DISPLAY-FILE  FORMAT IS SCREEN-NAME
               INDIC ARE SCREEN-INDICATORS
           IF SCREEN-STATUS NOT = "00"
               DISPLAY "SCREEN READ ERROR.  SCREEN-STATUS IS "
                        SCREEN-STATUS
               GO TO END-OF-JOB.

           MOVE DISPLAY-REC    TO SCREEN-DATA.
           MOVE ALL B"0"       TO SCREEN-INDICATORS.
           MOVE SPACES         TO ERRMSG MESSAGE-BUFFER.

           IF KEY-HIT = 3
               PERFORM EDIT-CHECKS
               IF ERRMSG NOT = SPACES GO TO SHOWFORM END-IF
               PERFORM SCREEN-ADJUST THRU SA-EXIT
               MOVE SCREEN-DATA TO SCREEN-SAVE
               GO TO EXIT-DISPLAY.

           IF KEY-HIT = 1
               MOVE SCREEN-SAVE TO SCREEN-DATA
               GO TO MAIN.

           IF KEY-HIT = 5
               GO TO PRELOAD.

           IF KEY-HIT = 7
               PERFORM EDIT-CHECKS
               IF ERRMSG NOT = SPACES GO TO SHOWFORM END-IF
               PERFORM SCREEN-ADJUST THRU SA-EXIT
               MOVE SCREEN-DATA TO SCREEN-SAVE
               GO TO PREVIEW.

           IF KEY-HIT = 9
               MOVE SCREEN-DATA TO SCREEN-HOLD
               PERFORM DEFAULT-CRAFT THRU DC-EXIT
               MOVE SCREEN-HOLD TO SCREEN-DATA
               GO TO MAIN.

           PERFORM EDIT-CHECKS.
           IF ERRMSG NOT = SPACES GO TO SHOWFORM.
           PERFORM SCREEN-ADJUST THRU SA-EXIT.
           MOVE SCREEN-DATA    TO SCREEN-SAVE.
           GO TO MAIN.

       EDIT-CHECKS.
           PERFORM EDIT-SKIP   THRU ES-EXIT
                               VARYING SUB FROM 1 BY 1
                               UNTIL SUB > 18.
           PERFORM EDIT-ZONE   THRU EZ-EXIT
                               VARYING SUB FROM 1 BY 1
                               UNTIL SUB > 18.

       EDIT-SKIP.
           IF LOC(SUB) = SPACES GO TO ES-EXIT.
           MOVE LOC(SUB)       TO SKIP-TABLE.
           MOVE 0              TO CHAR.
           PERFORM COUNT-CHAR  VARYING SUBT FROM 1 BY 1
                               UNTIL SUBT > 18.
           IF CHAR = 4
               PERFORM CHECK-SKIP VARYING SUBT FROM 1 BY 1
                               UNTIL SUBT > 15.

       ES-EXIT.                EXIT.

       COUNT-CHAR.
           IF SKIP(SUBT) NOT = " " ADD 1 TO CHAR.

       CHECK-SKIP.
           IF SKIP(SUBT)     = "S" AND
              SKIP(SUBT + 1) = "K" AND
              SKIP(SUBT + 2) = "I" AND
              SKIP(SUBT + 3) = "P"
               MOVE "SKIP              " TO LOC(SUB)
               MOVE 18         TO SUBT.

       EDIT-ZONE.
           IF LOC(SUB) = SPACES
               MOVE SPACES     TO ZON(SUB)
               GO TO EZ-EXIT.

           IF ZON(SUB) = SPACES
               GO TO EZ-EXIT.

           MOVE ZON(SUB)       TO ZONE-FIELD.
           MOVE "1 "           TO PRTY-FIELD.
           MOVE WO-ZONE-DATA   TO ZONEPRTY OF WO-ZONE-PRTY.
           START WO-ZONE-PRTY  KEY = ZONEPRTY OF WO-ZONE-PRTY
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
      *M********************************************************************
      *M      MESSAGE 035/044:
      *M   INVALID ZONE
      *M********************************************************************
               MOVE  35        TO CATREAD-MSG-SET
               MOVE  44        TO CATREAD-MSG-NUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE SUB        TO FIELD-NUMBER
               PERFORM SET-ERROR
               MOVE 20         TO SUB.

       EZ-EXIT.                EXIT.

       LOAD-LOOP.
           MOVE EQPVAL(SUB)    TO EQPNUM OF EQP-EQUIPMENT.
           READ  EQP-EQUIPMENT INTO EQUIPMENT-DATA
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT = "00"
               MOVE EQP-EQUIP-NAME TO LOC(SUB)
               MOVE EQP-MAINT-ZONE TO ZON(SUB)
               MOVE EQP-DEPT       TO CFT-HOLD
               IF EQP-LOCATION = "SAFETY "
                   MOVE 1          TO SYSTEM-SW
                   IF EQP-SAFETY-PWORD-FLG = "Y"
                       MOVE "Y"    TO SAFETY-PWORD-SW
                   END-IF
               END-IF
           ELSE
               MOVE SPACES         TO LOC(SUB)
               MOVE SPACES         TO ZON(SUB).

       PREVIEW.
           MOVE "INITVIEW"     TO SCREEN-NAME.
           MOVE SPACES         TO PREVIEW-SCREEN
                                  MESSAGE-BUFFER.
           PERFORM LOAD-PREV   VARYING SUB FROM 1 BY 1
                               UNTIL SUB > 17.
           MOVE ALL B"0"       TO SCREEN-INDICATORS.

       PREVIEW-SHOWFORM.
           MOVE "00"           TO SCREEN-STATUS.
           MOVE PREVIEW-SCREEN TO DISPLAY-REC.

           WRITE DISPLAY-REC   FORMAT IS SCREEN-NAME
               INDIC ARE SCREEN-INDICATORS.
           IF SCREEN-STATUS NOT = "00"
               DISPLAY "SCREEN WRITE ERROR.  SCREEN-STATUS IS "
                        SCREEN-STATUS
               GO TO END-OF-JOB.

           READ  DISPLAY-FILE  FORMAT IS SCREEN-NAME
               INDIC ARE SCREEN-INDICATORS
           IF SCREEN-STATUS NOT = "00"
               DISPLAY "SCREEN READ ERROR.  SCREEN-STATUS IS "
                        SCREEN-STATUS
               GO TO END-OF-JOB.

           MOVE ALL B"0"       TO SCREEN-INDICATORS.
           GO TO MAIN.

       SCREEN-ADJUST.
           MOVE SPACES         TO HOLD-BUFFER.
           MOVE LOCATION-DATA  TO HOLD-BUFFER.
           MOVE "END------------END" TO HOLD-DATA(19).

       SCREEN-FILL.
           PERFORM FILL-BLANKS VARYING SUB FROM 1 BY 1
                               UNTIL SUB > 19.
           IF SUB NOT > 87
               GO TO SCREEN-FILL.

           MOVE HOLD-BUFFER    TO LOCATION-DATA.

       SA-EXIT.                EXIT.

       FILL-BLANKS.
           IF HOLD-DATA(SUB) = "END------------END"
               MOVE SPACES     TO HOLD-DATA(SUB)
               MOVE 88         TO SUB
           ELSE
           IF HOLD-DATA(SUB) = SPACES
               COMPUTE SUBT = SUB + 1
               PERFORM MOVE-UP VARYING SUBT FROM SUBT BY 1
                               UNTIL SUBT > 19
               MOVE 20         TO SUB.

       MOVE-UP.
           COMPUTE SUBS = SUBT - 1
           MOVE HOLD-DATA(SUBT) TO HOLD-DATA(SUBS).
           IF SUBT = 19        MOVE SPACES TO HOLD-DATA(SUBT).

       EXIT-DISPLAY.
           MOVE "SYSTEMSW"     TO SCREEN-NAME.
           MOVE SPACES         TO PREVIEW-SCREEN.
           PERFORM LOAD-EXIT   VARYING SUB FROM 1 BY 1
                               UNTIL SUB > 17.

           IF SYSTEM-ON
               MOVE "ON "      TO SW-BUFF SW-DISP
           ELSE
               MOVE SPACES     TO SW-BUFF
               MOVE "OFF"      TO SW-DISP.

           IF SAFETY-PWORD-SW = "Y"
               MOVE "Y"        TO SW-PWORD
           ELSE
               MOVE "N"        TO SW-PWORD
           END-IF.

           IF DFLT-CYC = "30" OR "45" OR "60" OR "90"
               MOVE DFLT-CYC   TO DFLT-BUFF
           ELSE
               MOVE "45"       TO DFLT-BUFF.

           MOVE ALL B"0"       TO SCREEN-INDICATORS.

       EXIT-SHOWFORM.
           MOVE "00"           TO SCREEN-STATUS.
           MOVE EXIT-SCREEN    TO DISPLAY-REC.

           WRITE DISPLAY-REC   FORMAT IS SCREEN-NAME
               INDIC ARE SCREEN-INDICATORS.
           IF SCREEN-STATUS NOT = "00"
               DISPLAY "SCREEN WRITE ERROR.  SCREEN-STATUS IS "
                        SCREEN-STATUS
               GO TO END-OF-JOB.

           READ  DISPLAY-FILE  FORMAT IS SCREEN-NAME
               INDIC ARE SCREEN-INDICATORS
           IF SCREEN-STATUS NOT = "00"
               DISPLAY "SCREEN READ ERROR.  SCREEN-STATUS IS "
                        SCREEN-STATUS
               GO TO END-OF-JOB.

           MOVE DISPLAY-REC    TO EXIT-SCREEN.
           MOVE ALL B"0"       TO SCREEN-INDICATORS.

           IF SW-BUFF NOT = "ON"
               MOVE 0          TO SYSTEM-SW
               MOVE SPACES     TO SW-BUFF
               MOVE "OFF"      TO SW-DISP
           ELSE
               MOVE 1          TO SYSTEM-SW
               MOVE "ON "      TO SW-DISP.

           IF SW-PWORD = "N"
               MOVE "N"        TO SAFETY-PWORD-SW
               MOVE "N"        TO SW-PWORD
           ELSE
               MOVE "Y"        TO SAFETY-PWORD-SW
               MOVE "Y"        TO SW-PWORD
           END-IF.

           IF KEY-HIT = 3
               GO TO WRITE-DATA.

           IF KEY-HIT = 1
               GO TO MAIN.

           IF KEY-HIT = 5
               GO TO CYCLE-DISPLAY.

           GO TO EXIT-SHOWFORM.

       WRITE-DATA.
           PERFORM WRITE-LOOP  THRU WL-EXIT
                               VARYING SUB FROM 1 BY 1
                               UNTIL SUB > 18.

       END-OF-JOB.
           CLOSE               EQP-EQUIPMENT.
           CLOSE               WO-ZONE-PRTY.
           CLOSE               WO-CRAFTS-REQD.
           CLOSE               DISPLAY-FILE.
           GOBACK.

       CYCLE-DISPLAY.
           MOVE "DELCYCLE"     TO SCREEN-NAME.
           MOVE SPACES         TO CYCLE-BUF.
           MOVE ALL B"0"       TO SCREEN-INDICATORS.

           IF DFLT-CYC = "30" OR "45" OR "60" OR "90"
               NEXT SENTENCE
           ELSE
               MOVE "45"       TO DFLT-CYC.

       CYCLE-SHOWFORM.
           MOVE "00"           TO SCREEN-STATUS.
           MOVE CYCLE-SCREEN   TO DISPLAY-REC.

           WRITE DISPLAY-REC   FORMAT IS SCREEN-NAME
               INDIC ARE SCREEN-INDICATORS.
           IF SCREEN-STATUS NOT = "00"
               DISPLAY "SCREEN WRITE ERROR.  SCREEN-STATUS IS "
                        SCREEN-STATUS
               GO TO END-OF-JOB.

           READ  DISPLAY-FILE  FORMAT IS SCREEN-NAME
               INDIC ARE SCREEN-INDICATORS
           IF SCREEN-STATUS NOT = "00"
               DISPLAY "SCREEN READ ERROR.  SCREEN-STATUS IS "
                        SCREEN-STATUS
               GO TO END-OF-JOB.

           MOVE DISPLAY-REC    TO CYCLE-SCREEN.
           MOVE ALL B"0"       TO SCREEN-INDICATORS.

           IF KEY-HIT = 3
               GO TO EXIT-DISPLAY.

           IF CYCLE-BUF = SPACES
      **********************************************************************
      **    MESSAGE 041/016:
      ** ONE ENTRY REQUIRED:
      **********************************************************************
               MOVE  41        TO CATREAD-MSG-SET
               MOVE  16        TO CATREAD-MSG-NUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE 1          TO FIELD-NUMBER
               MOVE MESSAGE-BUFFER TO ERRMSGCY
               PERFORM SET-ERROR
               GO TO CYCLE-SHOWFORM.

           MOVE 0              TO CYC-CTR.
           IF CYC-1 NOT = " "  ADD 1 TO CYC-CTR.
           IF CYC-2 NOT = " "  ADD 1 TO CYC-CTR.
           IF CYC-3 NOT = " "  ADD 1 TO CYC-CTR.
           IF CYC-4 NOT = " "  ADD 1 TO CYC-CTR.

           IF CYC-CTR > 1
      **********************************************************************
      **    MESSAGE 041/017:
      ** ONLY ONE ENTRY PERMITTED:
      **********************************************************************
               MOVE  41        TO CATREAD-MSG-SET
               MOVE  17        TO CATREAD-MSG-NUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE 1          TO FIELD-NUMBER
               MOVE MESSAGE-BUFFER TO ERRMSGCY
               PERFORM SET-ERROR
               GO TO CYCLE-SHOWFORM.

           IF CYC-1 NOT = " "  MOVE "30" TO DFLT-CYC.
           IF CYC-2 NOT = " "  MOVE "45" TO DFLT-CYC.
           IF CYC-3 NOT = " "  MOVE "60" TO DFLT-CYC.
           IF CYC-4 NOT = " "  MOVE "90" TO DFLT-CYC.
           MOVE SPACES         TO CYCLE-BUF.
           GO TO CYCLE-SHOWFORM.

       WRITE-LOOP.
           MOVE EQPVAL(SUB)    TO EQPNUM OF EQP-EQUIPMENT.
           READ EQP-EQUIPMENT  INTO EQUIPMENT-DATA
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT = "00"
               DELETE EQP-EQUIPMENT
                   INVALID KEY MOVE FILE-STAT TO FILE-STAT.

           IF LOC(SUB) = SPACES
               GO TO WL-EXIT.

           MOVE SPACES         TO EQUIPMENT-DATA.
           MOVE EQPVAL(SUB)    TO EQP-EQUIP-NUM.
           MOVE LOC(SUB)       TO EQP-EQUIP-NAME.
           MOVE ZON(SUB)       TO EQP-MAINT-ZONE.
           MOVE CFT-HOLD       TO EQP-DEPT.
           MOVE "00000000"     TO EQP-TYPE.
           MOVE DFLT-CYC       TO EQP-RIME.
           MOVE "00000001"     TO EQP-EXP-CLASS.
           MOVE "X"            TO EQP-SAFETY-FLG.
           MOVE SPACES         TO EQP-DOWN-COST
                                  EQP-CORP-DESC
                                  EQP-LOCATION.
           IF SYSTEM-ON
               MOVE "SAFETY  " TO EQP-LOCATION.

           IF SAFETY-PWORD-SW = "Y"
               MOVE "Y"        TO EQP-SAFETY-PWORD-FLG
           ELSE
               MOVE "N"        TO EQP-SAFETY-PWORD-FLG
           END-IF.

           WRITE EQP-REC       FROM EQUIPMENT-DATA
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.

       WL-EXIT.                EXIT.

       DEFAULT-CRAFT.
           MOVE "DFTCRAFT"     TO SCREEN-NAME.
           MOVE CFT-HOLD       TO DFLT-CFT.

       DC-SHOWFORM.
           MOVE "00"           TO SCREEN-STATUS.
           MOVE CRAFT-SCREEN   TO DISPLAY-REC.

           WRITE DISPLAY-REC  FORMAT IS SCREEN-NAME
               INDIC ARE SCREEN-INDICATORS.
           IF SCREEN-STATUS NOT = "00"
               DISPLAY "SCREEN WRITE ERROR.  SCREEN-STATUS IS "
                        SCREEN-STATUS
               GO TO END-OF-JOB.

           READ  DISPLAY-FILE FORMAT IS SCREEN-NAME
               INDIC ARE SCREEN-INDICATORS
           IF SCREEN-STATUS NOT = "00"
               DISPLAY "SCREEN READ ERROR.  SCREEN-STATUS IS "
                        SCREEN-STATUS
               GO TO END-OF-JOB.

           MOVE DISPLAY-REC    TO CRAFT-SCREEN.
           MOVE ALL B"0"       TO SCREEN-INDICATORS.

           IF KEY-HIT = 3
               MOVE DFLT-CFT   TO CFT-HOLD
               GO TO DC-EXIT.

           IF DFLT-CFT = SPACES
               GO TO DC-SHOWFORM.

           MOVE DFLT-CFT       TO CRAFTREQD OF WO-CRAFTS-REQD.
           START WO-CRAFTS-REQD KEY = EXTERNALLY-DESCRIBED-KEY
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
      *M********************************************************************
      *M      MESSAGE 035/037:
      *M   INVALID CRAFT
      *M********************************************************************
               MOVE  35        TO CATREAD-MSG-SET
               MOVE  37        TO CATREAD-MSG-NUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER TO ERRMSGDC
               MOVE TRUE-VAL   TO IND(1) IND(99)
               GO TO DC-SHOWFORM.

           GO TO DC-SHOWFORM.

       DC-EXIT.                EXIT.

       LOAD-PREV.
           IF LOC(SUB) NOT = SPACES
               MOVE SUB        TO CTR
               IF ZCTR1 = "0"  MOVE " " TO ZCTR1 END-IF
               MOVE SUBV(SUB)  TO SUBT
               MOVE PLACE      TO PSNUM(SUBT)
               MOVE LOC(SUB)   TO PSLOC(SUBT)
               IF LOC(SUB) = "SKIP              "
                   MOVE SPACES TO PSLOC(SUBT).

       LOAD-EXIT.
           IF LOC(SUB) NOT = SPACES
               MOVE SUB        TO CTR
               IF ZCTR1 = "0"  MOVE " " TO ZCTR1 END-IF
               MOVE SUBV(SUB)  TO SUBT
               MOVE PLACE      TO ESNUM(SUBT)
               MOVE LOC(SUB)   TO ESLOC(SUBT)
               IF LOC(SUB) = "SKIP              "
                   MOVE SPACES TO ESLOC(SUBT).

       SET-ERROR.
           MOVE MESSAGE-BUFFER TO ERRMSG.
           MOVE TRUE-VAL       TO IND(FIELD-NUMBER) IND(99).

       999-CATREAD.
           MOVE SPACES         TO MESSAGE-BUFFER.
           CALL "CCATREAD" USING CATREAD-PARMS.
           MOVE CATREAD-MSG-TEXT TO MESSAGE-BUFFER.

       999-CATREAD-EXIT.    EXIT.

