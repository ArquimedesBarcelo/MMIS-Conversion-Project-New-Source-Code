       IDENTIFICATION DIVISION.
       PROGRAM-ID.       TINVCODE.
       AUTHOR.           JEFF BUNGO.
      *INSTALLATION.     GOODYEAR TIRE & RUBBER CO.
      *DATE-WRITTEN.     JANUARY 1997.
      *DATE-COMPILED.    CURRENT-DATE.
      *REMARKS.      UPDATE STOREROOM INVENTORY FOR SINGLE CODE.
      *              ENTER CODE TO BE PASSED TO SINVUP PROGRAM
      *              WITH PARM TO FREEZE TO CODE.
      *
      *C
      *C 01/14/98 JEFF BUNGO
      *C   RETRIEVE THE LOCAL DATAAREA TO FIND ORIGINATING GLOBAL MENU
      *C   TRANSACTION.  PASS THE 4TH CHARACTER OF THE TRANSACTION ON
      *C   THE FREEZE CODE PARM TO SINVUP.  IF THE 4TH CHARACTER WILL
      *C   IDENTIFY THE FRANCHISER THAT A CODE IS BEING ADJUSTED FOR
      *C   THE FRANCHISER'S USE (NO COST TO GOODYEAR).  IF BLANK THEN
      *C   PASS A "Y" TO SINVUP FOR NORMAL OPERATION.
      *C
       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.
       SOURCE-COMPUTER.   AS400.
       OBJECT-COMPUTER.   AS400.
       SPECIAL-NAMES. I-O-FEEDBACK IS I-O-FEEDBACK-AREA
                       LOCAL-DATA IS LOCAL-DATA-AREA.
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT DISPLAY-FILE
                  ASSIGN TO WORKSTATION-ZINVUP-SI
                  ORGANIZATION IS TRANSACTION
                  ACCESS IS SEQUENTIAL
                  FILE STATUS IS DISPLAY-STATUS
                  CONTROL-AREA IS WS-CONTROL.

           SELECT MSTORERM
                  ASSIGN TO DATABASE-MCFLCS0201
                  ORGANIZATION IS INDEXED
                    ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                  FILE STATUS IS FILE-STATUS.

           SELECT MPLTINFO
                  ASSIGN TO DATABASE-MCFLCS0501
                  ORGANIZATION IS INDEXED
                    ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                  FILE STATUS IS FILE-STATUS.

       DATA DIVISION.
       FILE SECTION.
       FD  DISPLAY-FILE
           LABEL RECORDS ARE OMITTED.
       01  DISPLAY-REC                   PIC X(1500).

       FD  MSTORERM
           LABEL RECORDS ARE STANDARD.
       01  MSTORERM-REC.
           COPY DDS-MCRPCS0200  OF MCFLCS0201.

       FD  MPLTINFO
           LABEL RECORDS ARE STANDARD.
       01  MPLTINFO-REC.
           COPY DDS-MCRPCS0500  OF MCFLCS0501.

       WORKING-STORAGE SECTION.

       01  EXIT-MAIN-SCRN                PIC X(1).
       01  FREEZE-CODE                   PIC X(1) VALUE "Y".

       01  LDA.
           05  FILLER                   PIC X(107).
           05  SC-CURRENT-TRAN.
               10  FILLER               PIC X(3).
               10  SC-CURRENT-TRAN-4    PIC X(1).
           05  FILLER                   PIC X(401).

       01  FRAN-TABLE.
           05  FRAN-ENTRY OCCURS 4 TIMES INDEXED BY FRAN-IDX.
               10  FRAN-ID             PIC X(1).
               10  FRAN-NAME           PIC X(4).
               10  FRAN-VEN0CODE       PIC X(10).

      **************************************************************
      **                                                          **
      **          S U B P R O G R A M   A R E A S                 **
      **                                                          **
      **************************************************************
       COPY TSHWRDFM   IN COPYLIB.
       COPY DISPDAT2   IN COPYLIB.
       COPY CATREAD    IN COPYLIB.
       COPY IOFEEDBACK IN COPYLIB.
       COPY TBLOWUP    IN COPYLIB.
       COPY CDESC      IN COPYLIB.

      *****************************************************************
      **                                                             **
      **    D A T A B A S E   B U F F E R S                          **
      **                                                             **
      *****************************************************************
       COPY MSTORERM IN COPYLIB.
       COPY MPLT0    IN COPYLIB.
       COPY MPLTFRAN IN COPYLIB.

      *****************************************************************
      **                                                             **
      **     D A T A B A S E   W O R K                               **
      **                                                             **
      *****************************************************************
       01  BASE                          PIC X(10) VALUE SPACES.
       COPY DBSTAT IN COPYLIB.

       01  FILE-STATUS.
           05  FILE-STATUS-1             PIC X  VALUE "0".
           05  FILE-STATUS-2             PIC X  VALUE "0".

      **************************************************************
      *                      VIEW                                  *
      **************************************************************

       COPY VCOMAREA   IN COPYLIB.

       01  MESSAGE-BUFFER.
           05  MESSAGE-BUFFER-1          PIC X(1).
           05  FILLER                    PIC X(75).
       01  FIELD-NUMBER                PIC S9(4)   VALUE 1      COMP-4.
       COPY FUNCTDEF IN COPYLIB.


      ************************************************************
      *             SCREEN BUFFERS                               *
      ************************************************************
       01  DE-FIELDS-1.
           05  DE-CORP-CODE              PIC X(7).
           05  DE-FRAN-ID                PIC X(4).
           05  DE-COMMAND-LINE-1         PIC X(79).
           05  DE-MESSAGE-LINE-1         PIC X(79).


       COPY LANGUAGE   IN COPYLIB.

       PROCEDURE DIVISION.
       0000-START.
      *------GET ORIGINATING GLOBAL TRANSACTION TO SEE IF INVENTORY
      *------ADJUSTMENT IS FOR FRANCHISE USE ONLY (NO COST TO
      *------GOODYEAR.  PASS 4TH CHARACTER OF TRANSACTION TO SINVUP.
      *------IF BLANK PASS "Y" FOR A NORMAL ADJUSTMENT.
           ACCEPT LDA FROM LOCAL-DATA-AREA.
           MOVE 2                        TO  SRF-KEYSET.
           OPEN I-O DISPLAY-FILE.
           OPEN INPUT MSTORERM
                      MPLTINFO.

           MOVE "FRAN" TO PLTINFOKEY OF MPLTINFO-REC.
           READ MPLTINFO INTO BUF-MPLTINFO
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE SPACES               TO   FRAN-TABLE
           ELSE
               MOVE MPLTINFO-FRANCHISES  TO   FRAN-TABLE
           END-IF.

           MOVE "N"                      TO  EXIT-MAIN-SCRN.
           MOVE SPACES                   TO  DE-CORP-CODE.
           PERFORM 6000-MAIN THRU 6990-MAIN-X
             UNTIL EXIT-MAIN-SCRN = "Y".
           CLOSE MSTORERM, MPLTINFO, DISPLAY-FILE.
           GOBACK.

       2100-BLOWUP.
           MOVE "TINVCODE"               TO  BU-PGM-NAME.
           MOVE DE-CORP-CODE             TO  BU-DISPLAY-FLD (1).
           CALL "TBLOWUP" USING BASE BU-PGM-NAME STATUS-AREA
             VIEW-COMAREA FILE-STATUS BU-DISPLAY-MSG
             BU-DISPLAY-FLDS.

       4030-SETERROR.
           MOVE B"1"                     TO  IND (99).
           MOVE B"1"                     TO  IND (FIELD-NUMBER).
           MOVE MESSAGE-BUFFER           TO DE-MESSAGE-LINE-1.

       6000-MAIN.
           PERFORM 7000-GET-FRAN-ID THRU 7000-EXIT.
           MOVE "GETCODE"                TO  VIEW-NFNAME.
           MOVE DE-FIELDS-1              TO  DISPLAY-REC.
           PERFORM 998-WRITE-SCREEN THRU 9989-WS-X.
           MOVE DISPLAY-REC              TO  DE-FIELDS-1.
           IF MESSAGE-BUFFER-1 NOT = SPACES
               PERFORM 4030-SETERROR
               GO TO 6000-MAIN.

           IF VIEW-LASTKEY = EXIT-PROGRAM
               MOVE "Y"                  TO  EXIT-MAIN-SCRN
               GO TO 6990-MAIN-X.

      *------ SEE IF THE CORP CODE EXISTS
           MOVE DE-CORP-CODE             TO  CORPCDE OF MSTORERM-REC.
           READ MSTORERM INTO BUF-MSTORERM.
           IF FILE-STATUS = "23"
      *        "CODE DOES NOT EXIST IN THIS STOREROOM"
               MOVE 3                    TO  LANG-SETNUM
               MOVE 97                   TO  LANG-MSGNUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE 1                    TO  FIELD-NUMBER
               PERFORM 4030-SETERROR
           ELSE
      *------ SEE IF CODE ALREADY FROZEN
           IF STR-STATE = "F"
      *        "CODE ALREADY FROZEN"
               MOVE 3                    TO  LANG-SETNUM
               MOVE 114                  TO  LANG-MSGNUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE 1                    TO  FIELD-NUMBER
               PERFORM 4030-SETERROR
           ELSE
               IF SC-CURRENT-TRAN-4 = SPACES
                   MOVE "Y" TO FREEZE-CODE
               ELSE
                   MOVE SC-CURRENT-TRAN-4 TO FREEZE-CODE
               END-IF
               CALL "SINVUP" USING DE-CORP-CODE FREEZE-CODE
                                   VIEW-COMAREA
               MOVE SPACES TO DE-CORP-CODE
           END-IF.
       6990-MAIN-X.
           EXIT.

       7000-GET-FRAN-ID.
           IF SC-CURRENT-TRAN-4 = SPACES
               MOVE SPACES TO DE-FRAN-ID
           ELSE
               MOVE B"1" TO IND(91)
               IF FRAN-TABLE = SPACES
                   MOVE "****" TO DE-FRAN-ID
               ELSE
                   SET FRAN-IDX TO 1
                   SEARCH FRAN-ENTRY
                     AT END  MOVE "****" TO DE-FRAN-ID
                     WHEN FRAN-ID(FRAN-IDX) = SC-CURRENT-TRAN-4
                      MOVE FRAN-NAME(FRAN-IDX) TO DE-FRAN-ID
                   END-SEARCH.
        7000-EXIT.
           EXIT.

       COPY DISPCALL IN COPYLIB.
       COPY DISPCAL2 IN COPYLIB.

       999-CATREAD.
           IF CATREAD-MSG-NUMBER = ZEROS
               MOVE LANG-SETNUM          TO  CATREAD-MSG-SET
               MOVE LANG-MSGNUM          TO  CATREAD-MSG-NUM.
           CALL "CCATREAD" USING CATREAD-PARMS.
           MOVE CATREAD-MSG-TEXT         TO  MESSAGE-BUFFER.
       999-CATREAD-EXIT.
           EXIT.
