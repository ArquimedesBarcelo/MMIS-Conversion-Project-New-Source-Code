000200 IDENTIFICATION DIVISION.
000300 PROGRAM-ID.      TDISPSAV.
000400 ENVIRONMENT DIVISION.
000500 CONFIGURATION SECTION.
000600 SOURCE-COMPUTER.   AS400.
000700 OBJECT-COMPUTER.   AS400.
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT DISPLAY-FILE
               ASSIGN TO WORKSTATION-ZDISPSAV-SI
               ORGANIZATION IS TRANSACTION
               FILE STATUS IS DSPLY-STATUS
               CONTROL-AREA IS WS-CONTROL.
           SELECT WO-PLANNED-FILE
               ASSIGN TO DATABASE-MCFLMM1102
               ORGANIZATION IS INDEXED
               ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY WITH DUPLICATES
               FILE STATUS IS WPF-STATUS.
000800 DATA DIVISION.
       FILE SECTION.
       FD  DISPLAY-FILE
           LABEL RECORDS ARE OMITTED.
       01  DSPLY-REC               PIC X(2000).
       01  DSPSAV-FORM.
           COPY DDS-ALL-FORMATS OF ZDISPSAV.
       FD  WO-PLANNED-FILE
           LABEL RECORDS ARE STANDARD
           DATA RECORD IS WPFREC.
       01  WPFREC.
           COPY DDS-ALL-FORMATS OF MCFLMM1102.
000900 WORKING-STORAGE SECTION.
001000 77  SAVE-CTR                 PIC 9 VALUE 0.
       77  SUB                      PIC 99.
001100 01  DBPARAMETERS.     COPY DBPARMS OF COPYLIB.
       01  FILE-STATUSES.
           05  DSPLY-STATUS         PIC XX.
           05  WPF-STATUS           PIC XX.
       COPY SCREENIO OF COPYLIB.
001200 01  SCREEN-LIT-TABLE.
           05  SCREEN-LINES OCCURS 15 TIMES.
001300         10  SCREEN-WO        PIC X(10).
001400         10  SCREEN-LIT       PIC X(50).
               10  FILLER           PIC X(19).
           05  SCREEN-CMD-LINE      PIC X(79).
           05  SCREEN-MSG-LINE      PIC X(79).
       COPY DBSTAT  OF COPYLIB.
001600 01  STATUS-ARG               PIC XX VALUE "FF".
001700 01  WO-PLANNED-DATA.  COPY DWOPLAN OF COPYLIB.
       COPY WSCONTROL OF COPYLIB.
       COPY CPYIND     OF COPYLIB.
002000 PROCEDURE DIVISION.
002100 START-PGM.
002200     PERFORM 1-HSK.
002300     PERFORM 6-MAIN THRU 6-MAIN-EXIT.
002400 2-EOJ.
           CLOSE DISPLAY-FILE.
002500     CLOSE WO-PLANNED-FILE.
002600     GOBACK.
002700 1-HSK.
002800     MOVE LOW-VALUES TO STATUS-AREA.
           MOVE 0 TO SUB.
           MOVE SPACES TO SCREEN-LIT-TABLE.
           MOVE "ZDISPSAV" TO SCREEN-FILE.
           MOVE "FDISPSAV" TO SCREEN-NAME.
           OPEN I-O   DISPLAY-FILE.
           OPEN INPUT WO-PLANNED-FILE.
004200 6-MAIN.
004300     MOVE 0 TO COND-WORD.
004400     MOVE STATUS-ARG TO WOSTATUS OF WPFREC.
           START WO-PLANNED-FILE KEY IS = EXTERNALLY-DESCRIBED-KEY
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF WPF-STATUS NOT = "00" MOVE 17 TO COND-WORD.
004500     IF COND-WORD = 17
               ADD 1 TO SUB
004600         MOVE "NO WORK ORDERS ON 'FF' STATUS CHAIN"
                   TO SCREEN-LIT (SUB)
               MOVE "PRESS F3 TO EXIT PROGRAM" TO SCREEN-CMD-LINE
               MOVE SCREEN-LIT-TABLE TO DSPLY-REC
               PERFORM 99-SCREEN-WRITE
               PERFORM 98-SCREEN-READ
004700         GO TO 2-EOJ.
004800 6-MAIN-LOOP.
004900     READ WO-PLANNED-FILE NEXT INTO WO-PLANNED-DATA
               AT END    MOVE 17 TO COND-WORD.
           IF WPF-STATUS NOT = "00" MOVE 17 TO COND-WORD.
           IF WOSTATUS OF WPFREC NOT = STATUS-ARG MOVE 17 TO COND-WORD.
005100     IF COND-WORD = 17
005200         IF SAVE-CTR = 0
005300             MOVE "NO WORK ORDERS HAVE BEEN SAVED"
                       TO SCREEN-LIT (SUB)
                   MOVE "PRESS F3 TO EXIT PROGRAM" TO SCREEN-CMD-LINE
                   MOVE SCREEN-LIT-TABLE TO DSPLY-REC
                   PERFORM 99-SCREEN-WRITE
                   PERFORM 98-SCREEN-READ
005400             GO TO 2-EOJ
005500         ELSE
               MOVE "END OF DATA PRESS F3 TO EXIT" TO SCREEN-CMD-LINE
               MOVE SCREEN-LIT-TABLE TO DSPLY-REC
               PERFORM 99-SCREEN-WRITE
               PERFORM 98-SCREEN-READ
005600         GO TO 2-EOJ.
006100     IF SAVE-HIST-SW = "  " GO TO 6-MAIN-LOOP.
           ADD 1 TO SUB.
006200     MOVE WONUM OF WPFREC TO SCREEN-WO (SUB).
006300     MOVE " IS A SAVED WORK ORDER" TO SCREEN-LIT (SUB).
006500     ADD 1 TO SAVE-CTR.
           IF SUB  > 14
               MOVE "F1 TO CONTINUE, F3 TO EXIT PROGRAM"
                   TO SCREEN-CMD-LINE
               MOVE SCREEN-LIT-TABLE TO DSPLY-REC
               PERFORM 99-SCREEN-WRITE
               PERFORM 98-SCREEN-READ
               MOVE 0 TO SUB
               MOVE SPACES TO SCREEN-LIT-TABLE.
006600     GO TO 6-MAIN-LOOP.
006700 6-MAIN-EXIT.    EXIT.
       98-SCREEN-READ.
           READ DISPLAY-FILE INDIC IS INDICS
               MOVE ALL B"0" TO INDICS.
       99-SCREEN-WRITE.
           WRITE DSPLY-REC FORMAT IS SCREEN-NAME
               INDIC IS INDICS.
      *    MOVE B"0" TO INDS (99).
