       IDENTIFICATION DIVISION.
       PROGRAM-ID.         TEXECPLN.
       INSTALLATION.  GOODYEAR TIRE & RUBBER CO.
       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.
       SOURCE-COMPUTER.    AS400.
       OBJECT-COMPUTER.    AS400.
       SPECIAL-NAMES. I-O-FEEDBACK IS I-O-FEEDBACK-AREA
                      LOCAL-DATA IS LOCAL-DATA-AREA.
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT DISPLAY-FILE
               ASSIGN TO WORKSTATION-ZPLANNER-SI
               ORGANIZATION IS TRANSACTION
               ACCESS IS SEQUENTIAL
               FILE STATUS IS DSPLY-STATUS
               CONTROL-AREA IS WS-CONTROL.
           SELECT MEMPL
               ASSIGN TO DATABASE-MCFLCS4202
               ORGANIZATION IS INDEXED
               ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                 WITH DUPLICATES
               FILE STATUS IS MEM-STATUS.
           SELECT MPLTINFO-KEY-FILE
               ASSIGN TO DATABASE-MCFLCS0501
               ORGANIZATION IS INDEXED
               ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
               FILE STATUS IS MKF-STATUS.
           SELECT WO-LAST-NUM-USED
               ASSIGN TO DATABASE-MCFPMM0800
               ORGANIZATION IS RELATIVE
               ACCESS MODE IS RANDOM
               RELATIVE KEY IS ARG-NO
               FILE STATUS IS WLNU-STATUS.
       DATA DIVISION.
       FILE SECTION.
       FD  DISPLAY-FILE
           LABEL RECORDS ARE OMITTED.
       01  DSPLY-REC                   PIC X(2000).
       FD  MEMPL
           LABEL RECORDS ARE STANDARD.
       01  MEMPL-REC.
           COPY DDS-MCRPCS4200  OF MCFLCS4202.
       FD  MPLTINFO-KEY-FILE
           LABEL RECORDS ARE STANDARD
           DATA RECORD IS MKFREC.
       01  MKFREC.
           COPY DDS-ALL-FORMATS OF MCFLCS0501.
       FD  WO-LAST-NUM-USED
           LABEL RECORDS ARE STANDARD.
       01  LAST-NUM-USED-REC.
           COPY DDS-ALL-FORMATS OF MCFPMM0800.
       WORKING-STORAGE SECTION.
       01  ARG-NO                       PIC 9(9).
       01  BASE                         PIC X(24).
       01  BASE-BUDGET                  PIC X(24).
       01  BASE-MMISA                   PIC X(24).
       01  BASE-STHIST                  PIC X(24).
       01  BLOWUP-BASE                  PIC X(16).
       COPY CATREAD OF COPYLIB.
       COPY CPYIND  OF COPYLIB.
       01  DBPARAMETERS.              COPY DBPARMS OF COPYLIB.
       01  ERROR-BUFFER.
           05  E-LIT                    PIC X(70).
           05  E-ERROR                  PIC 9(4).
           05  E-DELAY                  PIC X(6).
       01  ERROR-SWITCH.
           05  ERROR-SW                 PIC S9(4) COMP-4.
       COPY ESCNAM2 IN COPYLIB.
       01  EXECUTIVE-DATA               PIC X(76).
       01  FILE-STATUSES.
           05  DSPLY-STATUS             PIC XX.
           05  MEM-STATUS               PIC XX.
           05  MKF-STATUS               PIC XX.
           05  MR-STATUS                PIC XX.
           05  WLNU-STATUS              PIC XX.

       COPY IOFEEDBACK IN COPYLIB.

       COPY JCWAREA IN COPYLIB.

       COPY LANGSUB IN COPYLIB.
       01  LAST-WO-BUFF.              COPY MLASTWO OF COPYLIB.
       COPY MEMPL   IN COPYLIB.
       01  MPLTINFO-COMP.
           05  MPLTINFO-COMP-1-2        PIC XX.
           05  FILLER                   PIC XX.
       01  MPLTINFO-PARMS.
           05  MPLTINFO-PLANT-CODE      PIC X(3).
           05  MPLTINFO-DDESC-LANG      PIC X(3).
           05  MPLTINFO-DDESC2-LANG     PIC X(3).
       COPY MPLTINFO IN COPYLIB.
       COPY MPLTRQGB IN COPYLIB.
       01  PASSED-CODE                  PIC X(7).
       01  PASSED-SPOOL-PRT             PIC S9(2) COMP-4.
       01  PASS-SPOOL-PRT-NO            PIC S99 COMP-4.
       01  PASSWORD-INFORMATION.
           05  NAME-OF-PROGRAM     PIC X(08) VALUE "TEXECPLN".
           05  PROGRAM-TYPE        PIC X(02) VALUE "MA".
           05  PROGRAM-RELEASE     PIC X(12) VALUE " E0100010001".
           05  PROGRAM-DESCRIPTION.
               10  PROG-DESC-A     PIC X(60) VALUE
             " PLANNER MODULE EXECUTIVE PROGRAM  - DISPLAYS THE SCREEN".
               10  PROG-DESC-B     PIC X(60) VALUE
             " TO ALLOW USER TO CHOOSE WHICH PLANNER/ENGINEER FUNCTION".
               10  PROG-FUNCTION   PIC X(60) VALUE " TO EXECUTE".
           05  PASSWORD-FLAG       PIC X.

       01  PLANT-ID                     PIC XXX.
       COPY REQGLOBS OF COPYLIB.
       COPY SMREQINQ OF COPYLIB.
       01  REQI-RET-CODE                PIC S9(4) COMP-4.
       01  SCREEN-BUFFER.
           05  SCREEN-CMD-LINE          PIC X(79).
           05  SCREEN-ERR-LINE          PIC X(79).
       COPY SINQMFR IN COPYLIB.
       COPY DBSTAT  IN COPYLIB.
       01  TRUE-VAL                     PIC 1 VALUE B"1".
       COPY TBLOWUP IN COPYLIB.
       COPY VCOMLINK IN COPYLIB.
       01  WHO-PARMS.
           05  USERNAME                 PIC X(10).
           05  TERMNUM                  PIC X(10).
           05  CURRLIB                  PIC X(10).
           05  JOBLIBX                  PIC X.
       01  WO-PLANNED-DATA.           COPY DWOPLAN OF COPYLIB.
       COPY WSCONTROL OF COPYLIB.
       PROCEDURE DIVISION.
       BEGIN.
           PERFORM 1-HSK.
           PERFORM 6-MAIN UNTIL VIEW-LASTKEY = 3.
       2-EOJ.
           CLOSE DISPLAY-FILE.
           CLOSE MEMPL.
           CLOSE MPLTINFO-KEY-FILE.
           CLOSE WO-LAST-NUM-USED.
           GOBACK.
      ****************************************************************
      *    HOUSEKEEPING                                              *
      ****************************************************************
       1-HSK.
           MOVE SPACES TO DBPARAMETERS BU-DISPLAY-MSG
               BU-DISPLAY-AREA ENG-PL-SCHD-ID.
           MOVE LOW-VALUES TO STATUS-AREA VIEW-COMAREA.
           OPEN I-O   DISPLAY-FILE.
           OPEN INPUT MEMPL.
           OPEN INPUT MPLTINFO-KEY-FILE.
           OPEN INPUT WO-LAST-NUM-USED.
           MOVE 0 TO COND-WORD.
           MOVE 1 TO ARG-NO.
           READ WO-LAST-NUM-USED INTO LAST-WO-BUFF
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF WLNU-STATUS NOT = "00" MOVE 17 TO COND-WORD.
           IF COND-WORD = 17 MOVE 1 TO DATE-FLAG-SW.
           IF DATE-FLAG-SW IS NUMERIC
               MOVE DATE-FLAG-SW TO DATE-FLAG
           ELSE
           MOVE 1 TO DATE-FLAG.
           MOVE PLANT-IDENT TO PLANT-ID.
           CALL "TPWORD" USING PASSWORD-INFORMATION.
           IF PASSWORD-FLAG = "N"
               MOVE "  PWORD" TO BLOWUP-BASE
               MOVE "FAILED PASSWORD CHECK - TEXECPLN"
                   TO BU-DISPLAY-MSG
               PERFORM 998-BLOWUP.
           MOVE 0 TO VIEW-LASTKEY.
           MOVE SPACES TO SCREEN-BUFFER.
           ACCEPT MC-LOCAL-DATA-AREA FROM LOCAL-DATA-AREA.
      *****************************************************************
      *    MAIN LOGIC                                                 *
      *****************************************************************
       6-MAIN.
           MOVE 0 TO ERROR-SW.
           IF VIEW-LASTKEY = 0
               IF JCW-MJCW-260 = "1"
                   MOVE "FENGFUNC" TO VIEW-CFNAME
                   MOVE 66347 TO CATREAD-MSG-NUMBER
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE ERROR-BUFFER TO SCREEN-CMD-LINE
                   MOVE SCREEN-BUFFER TO DSPLY-REC
                   PERFORM 99-SCREEN-WRITE
                   PERFORM 98-SCREEN-READ
               ELSE
               MOVE "FPLNFUNC" TO VIEW-CFNAME
               MOVE 66347 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE ERROR-BUFFER TO SCREEN-CMD-LINE
               MOVE SCREEN-BUFFER TO DSPLY-REC
               PERFORM 99-SCREEN-WRITE
               PERFORM 98-SCREEN-READ.
           IF VIEW-LASTKEY = 1
               CALL "TINITEXC" USING DBPARAMETERS
                                     LAST-WO-BUFF
                                     ERROR-SWITCH
                                     VIEW-COMAREA
               MOVE 0 TO VIEW-LASTKEY
               IF ERROR-SW = 99
                   GO TO 2-EOJ
               ELSE
               IF ERROR-SW NOT = 0
                   MOVE "  MMISA" TO BLOWUP-BASE
                   MOVE "ERROR ENCOUNTERED IN TINITEXC SUBROUTINE"
                       TO BU-DISPLAY-MSG
                   MOVE "ERROR CODE = " TO BU-DISPLAY-FLD (1)
                   MOVE ERROR-SW        TO BU-DISPLAY-FLD9 (1)
                   PERFORM 998-BLOWUP
                   MOVE 1 TO VIEW-LASTKEY
               ELSE
               MOVE 0 TO VIEW-LASTKEY.
           IF VIEW-LASTKEY = 2
               PERFORM 62-PROCESS-UPDATE-FX THRU 62-PUF-EXIT
               MOVE 0 TO VIEW-LASTKEY.
           IF VIEW-LASTKEY = 4
               CALL "TDISPEXS" USING DBPARAMETERS
                                     LAST-WO-BUFF
                                     ERROR-SWITCH
                                     VIEW-COMAREA
               MOVE 0 TO VIEW-LASTKEY
               IF ERROR-SW = 99
                   GO TO 2-EOJ
               ELSE
               IF ERROR-SW NOT = 0
                   MOVE "  MMISA" TO BLOWUP-BASE
                   MOVE "ERROR ENCOUNTERED IN TDISPEXS SUBROUTINE"
                       TO BU-DISPLAY-MSG
                   MOVE "ERROR CODE = " TO BU-DISPLAY-FLD (1)
                   MOVE ERROR-SW        TO BU-DISPLAY-FLD9 (1)
                   PERFORM 998-BLOWUP
                   MOVE 1 TO VIEW-LASTKEY
               ELSE
               MOVE 0 TO VIEW-LASTKEY.
           IF VIEW-LASTKEY = 5
               PERFORM 62-PROCESS-STORES-FX THRU 62-PSF-EXIT
               MOVE 0 TO VIEW-LASTKEY.
           IF VIEW-LASTKEY = 6
               CALL "TINQEXES" USING DBPARAMETERS
                                     ERROR-SWITCH
                                     VIEW-COMAREA
               MOVE 0 TO VIEW-LASTKEY
               IF ERROR-SW = 99
                   GO TO 2-EOJ
               ELSE
               IF ERROR-SW NOT = 0
                   MOVE "  MMISA" TO BLOWUP-BASE
                   MOVE "ERROR ENCOUNTERED IN TINQEXES SUBROUTINE"
                       TO BU-DISPLAY-MSG
                   MOVE "ERROR CODE = " TO BU-DISPLAY-FLD (1)
                   MOVE ERROR-SW        TO BU-DISPLAY-FLD9 (1)
                   PERFORM 998-BLOWUP
                   MOVE 1 TO VIEW-LASTKEY
               ELSE
               MOVE 0 TO VIEW-LASTKEY.
           IF VIEW-LASTKEY = 7
               MOVE 0 TO ERROR-SW
               CALL "TMULTPRT" USING DBPARAMETERS
                                     VIEW-COMAREA
               MOVE 0 TO VIEW-LASTKEY.
       62-PROCESS-UPDATE-FX.
           IF JCW-MJCW-260 = "4"
               MOVE SPACES TO SCREEN-BUFFER
               MOVE "FMODSEL1" TO VIEW-CFNAME
               MOVE 66049 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE ERROR-BUFFER TO SCREEN-CMD-LINE
               MOVE SCREEN-BUFFER TO DSPLY-REC
               PERFORM 99-SCREEN-WRITE
               PERFORM 98-SCREEN-READ
               MOVE DSPLY-REC TO SCREEN-BUFFER
           ELSE
           MOVE SPACES TO SCREEN-BUFFER
           MOVE "FMODSEL2" TO VIEW-CFNAME
           MOVE 66048 TO CATREAD-MSG-NUMBER
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
           MOVE ERROR-BUFFER TO SCREEN-CMD-LINE
           MOVE SCREEN-BUFFER TO DSPLY-REC
           PERFORM 99-SCREEN-WRITE
           PERFORM 98-SCREEN-READ
           MOVE DSPLY-REC TO SCREEN-BUFFER.
           IF VIEW-LASTKEY = 3 GO TO 62-PUF-EXIT.
           IF VIEW-LASTKEY = 1
               MOVE 0 TO ERROR-SW
               CALL "TMODEXES" USING DBPARAMETERS
                                     ERROR-SWITCH
                                     VIEW-COMAREA
               IF VIEW-LASTKEY = 1
                   GO TO 62-PUF-EXIT
               ELSE
               MOVE 0 TO VIEW-LASTKEY
               GO TO 62-PROCESS-UPDATE-FX.
           IF VIEW-LASTKEY = 2
               CALL "TCONTUPD" USING DBPARAMETERS
                                     ERROR-SWITCH
                                     VIEW-COMAREA
               IF VIEW-LASTKEY = 1
                   GO TO 62-PUF-EXIT
               ELSE
               MOVE 0 TO VIEW-LASTKEY
               GO TO 62-PROCESS-UPDATE-FX.
           IF VIEW-LASTKEY = 4
               CALL "TUPDTODW" USING DBPARAMETERS
                                     ERROR-SWITCH
                                     VIEW-COMAREA
               IF VIEW-LASTKEY = 1
                   GO TO 62-PUF-EXIT
               ELSE
               MOVE 0 TO VIEW-LASTKEY
               GO TO 62-PROCESS-UPDATE-FX.
           IF VIEW-LASTKEY = 5
               IF JCW-MJCW-260 < 4
                   CALL "TASPTREQ" USING DBPARAMETERS
                                         VIEW-COMAREA
                   IF VIEW-LASTKEY = 1
                       GO TO 62-PUF-EXIT
                   ELSE
                   MOVE 0 TO VIEW-LASTKEY
                   GO TO 62-PROCESS-UPDATE-FX.
           IF VIEW-LASTKEY = 6
               CALL "TMUPDEXC" USING DBPARAMETERS
                                     VIEW-COMAREA
               IF VIEW-LASTKEY = 1
                   GO TO 62-PUF-EXIT
               ELSE
               MOVE 0 TO VIEW-LASTKEY
               GO TO 62-PROCESS-UPDATE-FX.
       62-PUF-EXIT.    EXIT.

       62-PROCESS-STORES-FX.
           MOVE SPACES TO PASSED-CODE EXECUTIVE-DATA.
           MOVE 0 TO PASSED-SPOOL-PRT.
           MOVE SPACES TO DSPLY-REC.
           MOVE "FCSISEXC" TO VIEW-CFNAME.
           PERFORM 99-SCREEN-WRITE.
           PERFORM 98-SCREEN-READ.
           IF VIEW-LASTKEY = 3 GO TO 62-PSF-EXIT.
           MOVE 0 TO COND-WORD.
           MOVE "PLAN" TO PLTINFOKEY OF MKFREC.
           READ MPLTINFO-KEY-FILE NEXT INTO BUF-MPLTINFO
               AT END    MOVE MKF-STATUS TO MKF-STATUS.
           IF MKF-STATUS NOT = "00" GO TO 62-PSF-EXIT.
           MOVE PLANT-IDENT TO MPLTINFO-PLANT-CODE.
           MOVE PRIMARY-LANGUAGE   TO MPLTINFO-DDESC-LANG.
           MOVE SECONDARY-LANGUAGE TO MPLTINFO-DDESC2-LANG.
           MOVE SPACES TO BASE BASE-BUDGET BASE-MMISA BASE-STHIST.
           CALL "TESCSEQ" USING ESC-NAME.
       62-PSF-READ.
           IF VIEW-LASTKEY = 3
               GO TO 62-PSF-EXIT
           ELSE
           IF VIEW-LASTKEY = 1
               MOVE 0 TO PASSED-SPOOL-PRT
               CALL "TMTLSTAT" USING BASE VIEW-COMAREA
                                 MPLTINFO-COMP PASSED-SPOOL-PRT
                                 PASSED-CODE LANGUAGE-PARMS
               MOVE 0 TO VIEW-LASTKEY
               GO TO 62-PROCESS-STORES-FX
           ELSE
           IF VIEW-LASTKEY = 2
               MOVE 0 TO ERROR-SWITCH
               CALL "TSUBCRWS" USING ERROR-SWITCH BASE BASE-MMISA
                                 STATUS-AREA VIEW-COMAREA
                                 LANGUAGE-PARMS EXECUTIVE-DATA
                                 PLANT-ID ESC-NAME
               MOVE 0 TO VIEW-LASTKEY
               GO TO 62-PROCESS-STORES-FX
           ELSE
           IF VIEW-LASTKEY = 4
               CALL "SPOINQ" USING BASE BASE-MMISA
                               VIEW-COMAREA PLANT-ID LANGUAGE-PARMS
               MOVE 0 TO VIEW-LASTKEY
               GO TO 62-PROCESS-STORES-FX
           ELSE
           IF VIEW-LASTKEY = 5
               CALL "TPOINQCS" USING BASE VIEW-COMAREA
                                 LANGUAGE-PARMS
               MOVE 0 TO VIEW-LASTKEY
               GO TO 62-PROCESS-STORES-FX
           ELSE
           IF VIEW-LASTKEY = 6
               MOVE ZEROES TO REQI-RET-CODE
               MOVE LOW-VALUES TO STATUS-AREA
               MOVE SPACES TO REQI-DATA
               MOVE PLANT-IDENT TO MPLTINFO-COMP
               MOVE 0 TO PASS-SPOOL-PRT-NO
               PERFORM 620-SET-PARMS
               CALL "SMREQINQ" USING REQI-RET-CODE
                                     BASE
                                     BASE-STHIST
                                     BASE-MMISA
                                     BASE-BUDGET
                                     STATUS-AREA
                                     VIEW-COMAREA
                                     LANGUAGE-PARMS
                                     REQI-DATA
                                     REQ-GLOBALS
                                     MPLTINFO-COMP
                                     PASS-SPOOL-PRT-NO
                                     ESC-NAME
               MOVE 0 TO VIEW-LASTKEY
               GO TO 62-PROCESS-STORES-FX
           ELSE
           IF VIEW-LASTKEY = 7
               MOVE "M" TO SINQMFR-MFR-KWM-FLAG
               MOVE PLANT-ID TO INQ-MPLT-PLANT-CODE
               CALL "SINQMFR" USING BASE VIEW-COMAREA
                                LANGUAGE-PARMS INQ-MPLT-PARMS
                                SINQMFR-PARMS
               MOVE 0 TO VIEW-LASTKEY
               GO TO 62-PROCESS-STORES-FX
           ELSE
           IF VIEW-LASTKEY = 8
               MOVE "K" TO SINQMFR-MFR-KWM-FLAG
               MOVE PLANT-ID TO INQ-MPLT-PLANT-CODE
               CALL "SINQMFR" USING BASE VIEW-COMAREA
                                LANGUAGE-PARMS INQ-MPLT-PARMS
                                SINQMFR-PARMS
               MOVE 0 TO VIEW-LASTKEY
               GO TO 62-PROCESS-STORES-FX.
       62-PSF-EXIT.    EXIT.

       620-SET-PARMS.
           CALL "CLWHO" USING USERNAME TERMNUM CURRLIB JOBLIBX.
           MOVE "RQGB" TO PLTINFOKEY OF MKFREC.
           MOVE SPACES TO REQ-GLOBALS.
           READ MPLTINFO-KEY-FILE INTO BUF-MPLTINFO
               INVALID KEY    MOVE MKF-STATUS TO MKF-STATUS.
           IF MKF-STATUS NOT = "00"
               NEXT SENTENCE
           ELSE
           MOVE MPLTINFO-RQGB TO REQ-GLOBALS.
           MOVE SPACES TO INQ-CC-INPUT.
           MOVE USERNAME TO USERID OF MEMPL-REC.
           READ MEMPL INTO BUF-MEMPL
               INVALID KEY     MOVE MEM-STATUS TO MEM-STATUS.
           IF MEM-STATUS = "00"
               IF MEMPL-INQUIRE-CAP = "Y"
                   MOVE SPACES TO INQ-CC-INPUT
                   MOVE "Y"    TO INQ-INQ-FLAG
               ELSE
               MOVE MEMPL-EMPL TO INQ-CC-INPUT
               MOVE "N"        TO INQ-INQ-FLAG
           ELSE
           MOVE SPACES         TO INQ-CC-INPUT
           MOVE "Y"            TO INQ-INQ-FLAG.

       98-SCREEN-READ.
           READ DISPLAY-FILE FORMAT IS VIEW-CFNAME
               INDIC IS INDICS.
           ACCEPT IOFEEDBACK FROM I-O-FEEDBACK-AREA.
           MOVE ALL B"0" TO INDICS.
           IF DSPLY-STATUS NOT = "00"
               MOVE 3 TO VIEW-LASTKEY
           ELSE
           MOVE FUNCTION-NUM TO VIEW-LASTKEY.

       99-SCREEN-WRITE.
           WRITE DSPLY-REC FORMAT IS VIEW-CFNAME
               INDIC IS INDICS.
           MOVE ALL B"0" TO INDICS.

       998-BLOWUP.
           MOVE "TEXECPLN" TO BU-PGM-NAME.
           CALL "TBLOWUP" USING BLOWUP-BASE BU-PGM-NAME STATUS-AREA
                            VIEW-COMAREA DUMMY-KSAM-STAT
                            BU-DISPLAY-MSG BU-DISPLAY-FLDS.
       999-CATREAD.
           MOVE SPACES TO ERROR-BUFFER.
           CALL "CCATREAD" USING CATREAD-PARMS.
           MOVE CATREAD-MSG-TEXT TO ERROR-BUFFER.
       999-CATREAD-EXIT.    EXIT.
