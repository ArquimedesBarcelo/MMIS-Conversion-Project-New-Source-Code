       9100-CALL-SINQMFR.
           MOVE "FCSISINQ"               TO  CSF-NEW-FORMFILE-NAME.
           MOVE "N"                      TO  CSF-MODE.
           PERFORM 9200-CALL-CSWITCHF.
           IF CSF-OPENFORM-ERR-SW = "Y"
               GO TO 9110-CS-X.
           IF VIEW-LASTKEY = HP-F3-KEY
               MOVE "M"                  TO  SINQMFR-MFR-KWM-FLAG
           ELSE
               MOVE "K"                  TO  SINQMFR-MFR-KWM-FLAG.

           MOVE SRF-MPLTINFO-COMPANY     TO  INQ-MPLT-PLANT-CODE.
           CALL "SINQMFR" USING BASE, VIEW-COMAREA, LANGUAGE-PARMS,
             INQ-MPLT-PARMS, SINQMFR-PARMS.

           MOVE "O"                      TO  CSF-MODE.
           PERFORM 9200-CALL-CSWITCHF.

           MOVE 1 TO SUB2.
           PERFORM VARYING SUB FROM 1 BY 1 UNTIL SUB > 15
               IF INQ-CORP-CODE (SUB) > SPACES
                   MOVE "N" TO MOVED-IT-FLAG
                   PERFORM UNTIL MOVED-IT-FLAG = "Y" OR SUB2 > 15
                       IF DE-CODE (SUB2) = SPACES
                           MOVE INQ-CORP-CODE (SUB) TO DE-CODE (SUB2)
                           MOVE "Y" TO MOVED-IT-FLAG
                       END-IF
                       ADD 1 TO SUB2
                   END-PERFORM
               END-IF
           END-PERFORM.

       9110-CS-X.
           EXIT.

       9120-MATERIAL-STATUS.
           MOVE "FCSISINQ"               TO  CSF-NEW-FORMFILE-NAME.
           MOVE "N"                      TO  CSF-MODE.
           PERFORM 9200-CALL-CSWITCHF.
           IF CSF-OPENFORM-ERR-SW = "Y"
               GO TO 9130-MS-X.

           PERFORM VARYING SUB FROM 1 BY 1 UNTIL SUB > 15
               IF DE-CODE (SUB) > SPACES OR SUB = 1
                   MOVE DE-CODE (SUB) TO MTLSTAT-CODE-PARM
                   CALL "TMTLSTAT" USING BASE, VIEW-COMAREA,
                     SRF-MPLTINFO-COMPANY, SPOOL-PRT,
                     MTLSTAT-CODE-PARM, LANGUAGE-PARMS
               END-IF
           END-PERFORM.

           MOVE "O"                      TO  CSF-MODE.
           PERFORM 9200-CALL-CSWITCHF.

       9130-MS-X.
           EXIT.

       9200-CALL-CSWITCHF.
           CALL "CSWITCHF" USING VIEW-COMAREA, LANGUAGE-PARMS,
             FORMFILE, CSF-PARMS, BU-DISPLAY-MSG.
           IF BU-DISPLAY-MSG-1 NOT = SPACES
               PERFORM 2100-BLOWUP.

       9999-OPENS.
           OPEN I-O   MSTORERM-CD-O.
           OPEN I-O   DDAILYTC-DT-O.
           OPEN I-O   DISPLAY-FILE.
           OPEN INPUT MPLTINFO-PK-I.

           OPEN INPUT USER-I.
           IF FILE-STATUS NOT = "00"
               MOVE "N" TO USER-FILE-EXISTS
           ELSE
               MOVE "Y" TO USER-FILE-EXISTS.

       9999-CLOSES.
           CLOSE      MSTORERM-CD-O.
           CLOSE      DDAILYTC-DT-O.
           CLOSE      DISPLAY-FILE.
           CLOSE      MPLTINFO-PK-I.
           CLOSE      USER-I.

070600 COPY HCATREAD   IN COPYLIB.
070700 COPY SCRNCALL   IN COPYLIB.
070800 COPY SCRNCL1B   IN COPYLIB.
070900 COPY DLOCKCAL   IN COPYLIB.
071000 COPY MLOCKCAL   IN COPYLIB.
071100 COPY UNLOCK     IN COPYLIB.
       9999-GETKEY-MSTORERM-CD-O.
           MOVE 0 TO COND-WORD.
           MOVE CODE-ARG TO CORPCDE OF MSTORERM-CD-REC-O.
           READ MSTORERM-CD-O INTO BUF-MSTORERM
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS = "23"
               MOVE 17 TO COND-WORD
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD
               IF HANDLE-BLOWUP-FLAG = "Y"
                   MOVE "GETKEY ERR 9999-GETKEY-MSTORERM-CD-O"
                       TO BU-MSG-AREA
                   PERFORM 2100-BLOWUP.

       9999-RESET-MSTORERM-CD-O.
           MOVE HIGH-VALUES TO CORPCDE OF MSTORERM-CD-REC-O.
           START MSTORERM-CD-O KEY > CORPCDE OF MSTORERM-CD-REC-O
               INVALID KEY MOVE "00" TO FILE-STATUS.

       9999-PUT-DDAILYTC-DT-O.
           MOVE 0 TO COND-WORD.
           WRITE DDAILYTC-DT-REC-O FROM BUF-DDAILYTC
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD
               IF HANDLE-BLOWUP-FLAG = "Y"
                   MOVE "PUT ERR 9999-PUT-DDAILYTC-DT-O"
                       TO BU-MSG-AREA
                   PERFORM 2100-BLOWUP.

       9999-UPDATE-MSTORERM-CD-O.
           MOVE 0 TO COND-WORD.
           REWRITE MSTORERM-CD-REC-O FROM BUF-MSTORERM
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD
               IF HANDLE-BLOWUP-FLAG = "Y"
                   MOVE "UPDATE ERR 9999-UPDATE-MSTORERM-CD-O"
                       TO BU-MSG-AREA
                   PERFORM 2100-BLOWUP.

       9999-GETKEY-MPLTINFO-PK-I.
           MOVE 0 TO COND-WORD.
           MOVE PLT-ARG TO PLTINFOKEY OF MPLTINFO-PK-REC-I.
           READ MPLTINFO-PK-I INTO BUF-MPLTINFO
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS = "23"
               MOVE 17 TO COND-WORD
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD
               IF HANDLE-BLOWUP-FLAG = "Y"
                   MOVE "GETKEY ERR 9999-GETKEY-MPLTINFO-PK-I"
                       TO BU-MSG-AREA
                   PERFORM 2100-BLOWUP.

       900-SEND-MESSAGE.
           MOVE CODE-ARG TO CORPCDE OF USER-I-REC.
           START USER-I KEY = CORPCDE OF USER-I-REC
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS = "00"
               READ USER-I NEXT INTO BUF-USERFILE
                   AT END MOVE FILE-STATUS TO FILE-STATUS
               END-READ
               IF FILE-STATUS = "00"
                   PERFORM UNTIL USR-CORP-CODE NOT = CODE-ARG
                                     OR FILE-STATUS NOT = "00"
                       MOVE SPACES            TO  MCXSNDMSG-PARM
                       MOVE USR-CORP-CODE     TO  MCXSNDMSG-CODE
                       MOVE USR-MESSAGE       TO  MCXSNDMSG-MSG
                       CALL "MCXSNDMSG" USING MCXSNDMSG-PARM
                                              USR-USER-ID
                       READ USER-I NEXT INTO BUF-USERFILE
                           AT END MOVE FILE-STATUS TO FILE-STATUS
                       END-READ
                   END-PERFORM.

       900-GET-FRAN-ID.
           IF FRAN-TABLE = SPACES
               MOVE SPACES TO HOLD-FRAN-ID
           ELSE
               SET FRAN-IDX TO 1
               SEARCH FRAN-ENTRY
                 AT END  MOVE SPACES TO HOLD-FRAN-ID
                 WHEN FRAN-NAME(FRAN-IDX) = OWNR (FRAN-SUB)
                  MOVE FRAN-ID(FRAN-IDX) TO HOLD-FRAN-ID
               END-SEARCH.
       900-GET-FRAN-ID-X.
           EXIT.
