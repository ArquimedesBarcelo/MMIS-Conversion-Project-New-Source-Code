021800
021900 LINKAGE SECTION.
022000 01  BASE                          PIC X(10).
022100 01  MMIS-BASE                     PIC X(13).
022200
022300 COPY DBSTAT     IN COPYLIB.
022400 COPY VCOMLINK   IN COPYLIB.
022500 COPY STCOM      IN COPYLIB.
022600 COPY TSHWSUB    IN COPYLIB.
022700 COPY LANGSUB    IN COPYLIB.
022800 COPY MULTSTR    IN COPYLIB.
022900 COPY ESCSUB     IN COPYLIB.
023000 COPY TISSCRWS   IN COPYLIB.
023100
023200 PROCEDURE DIVISION USING BASE MMIS-BASE STATUS-AREA
023300                          VIEW-COMAREA STORES-COMAREA
023400                          SRF-COMAREA, SRF-SPOOLER-REC,
023500                          LANGUAGE-PARMS, MULTIPLE-STR-DATA,
023600                          ESC-NAME, ISCR-DATA.
023700
023800 1-HSK.
           MOVE ZERO                     TO  VIEW-LASTKEY.
023900     MOVE ZERO                     TO  SRF-ERROR-FLD.
024000     MOVE ZERO                     TO  LANG-SETNUM.
024100     MOVE SRF-MODE                 TO  SAVE-SRF-MODE.
024200     MOVE 2                        TO  SRF-MODE.
024300     MOVE SPACES                   TO  DE-FIELDS-1.
024400     PERFORM 9999-OPENS.
      *------5/6/97 GET FRANCHISE TABLE.
           MOVE "FRAN"                   TO  PLT-ARG.
           MOVE 0 TO COND-WORD.
           PERFORM 9999-GETKEY-MPLTINFO-PK-I.
           IF NO-ENTRY
               MOVE SPACES               TO   FRAN-TABLE
           ELSE
               MOVE MPLTINFO-FRANCHISES  TO   FRAN-TABLE.
024500*------ IF THIS IS CALLED BY THE CRAFTSMEN PROGRAM, THE MULT-STR
024600*------ DATA HAS NOT ALREADY BEEN GOTTEN
024700     IF WO-OVERRD-ENTRY = SPACES
024800         MOVE "STST"               TO  PLT-ARG
024900         PERFORM 9999-GETKEY-MPLTINFO-PK-I
025000         MOVE MPLTINFO-DATA        TO  MULTIPLE-STR-DATA.
025100
           MOVE "PLAN"                   TO  PLT-ARG.
           PERFORM 9999-GETKEY-MPLTINFO-PK-I.
           MOVE PRIMARY-LANGUAGE         TO  INQ-MPLT-DDESC-LANG.
           MOVE SECONDARY-LANGUAGE       TO  INQ-MPLT-DDESC2-LANG.

025200     IF MULT-STR-PLANT
025300         IF SCOM-PGM-KEY = "SW6"
025400             MOVE "FIRMULT_ST"     TO  VIEW-NFNAME
025500         ELSE
025600             MOVE "FRTMULT_ST"     TO  VIEW-NFNAME
025700     ELSE
025800         IF SCOM-PGM-KEY = "SW6"
025900             MOVE "FIRMULT"        TO  VIEW-NFNAME
026000         ELSE
026100             MOVE "FRTMULT"        TO  VIEW-NFNAME.
026200
026300*------ IF SIGNED ON AS 'STORESA', ETC, DEFAULT TO THE DESIGNATED
026400*------ STOREROOM, IF SIGNED ON AS 'CFA', ETC, DEFAULT TO THE
      *------ DESIGNATED STOREROOM, ELSE DEFAULT TO STOREROOM 'A'.
026500     IF MULT-STR-PLANT
026600         IF SRF-USER-1-6 = "STORES"
026700             MOVE SRF-USER-7       TO  DE-STOREROOM
026800         ELSE
                   IF MULTI-INSTEAD-RW = "Y"
                       MOVE SRF-USERNAME TO USER-INSTEAD-RW
                       IF USER-INSTEAD-RW-1-2 = "CF"
                           MOVE USER-INSTEAD-RW-3 TO DE-STOREROOM
                       ELSE
                           MOVE "A"               TO DE-STOREROOM
                       END-IF
                   ELSE
026900                 MOVE "A"              TO  DE-STOREROOM.
027000
027100*------ THE OTHER ISSUE PROGRAMS USE USERNAME TO DETERMINE STOREROOM
027200*------ FOR THE MULT. STR SITUATION: STORESA IS STOREROOM A, ETC.
027300*------ HOWEVER THIS ONE USES THE SAME WAY AS CRAFT WS: THE USER
027400*------ INPUTS THE STOREROOM.  'TUDCSTR' DETERMINES THE MULT-STR-STR
027500*------ FOR THE OTHER PROGRAMS, SO WE HAVE TO SAVE IT AND RESTORE
027600*------ IT.
027700     MOVE MULT-STR-STR             TO  SAVE-STR.
027800
027900     PERFORM 9999-GETNEXTFORM.
028000
028100     IF ISCR-WO-NUM = SPACES AND ISCR-PART (1) = SPACES
028200         NEXT SENTENCE
028300     ELSE
               MOVE ISCR-WO-NUM              TO    DE-WO (1)
028800         MOVE ISCR-CC-NUM              TO    DE-EMPL (1)
028400         PERFORM VARYING SUB FROM 1 BY 1 UNTIL SUB > 8
028500             IF ISCR-PART (SUB) > SPACES
028600                 MOVE ISCR-PART (SUB)  TO    DE-CODE (SUB)
028900             END-IF
029000         END-PERFORM.
029100
029200     PERFORM 6000-MAIN THRU 6990-MAIN-X
029300       UNTIL VIEW-LASTKEY = EXIT-PROGRAM.
029400     PERFORM 9999-CLOSES.
029500     MOVE SAVE-SRF-MODE            TO  SRF-MODE.
029600     MOVE SAVE-STR                 TO  MULT-STR-STR.
029700     GOBACK.
029800
029900 2100-BLOWUP.
030000     MOVE SAVE-PARA-NUMBER         TO  BU-DISPLAY-PARA.
030100     MOVE "SIRMULT"                TO  BU-PGM-NAME.
030200     MOVE CODE-ARG                 TO  BU-DISPLAY-FLD (2).
030300     MOVE CORP-CODE                TO  BU-DISPLAY-FLD (3).
030400     CALL "TBLOWUP" USING BASE BU-PGM-NAME STATUS-AREA
030500       VIEW-COMAREA FILE-STATUS BU-DISPLAY-MSG
030600       BU-DISPLAY-FLDS.
030700
030800 6000-MAIN.
030900*------ SKIP PAST DE-STOREROOM FIELD, SINCE HE WILL RETAIN DEFAULT
           IF DE-STOREROOM NOT = SPACES
031000         MOVE 1                    TO  SRF-CURSOR-FLD.
           MOVE 2 TO SRF-KEYSET.
031100     PERFORM 9999-DO-SCREEN-1.
031200     IF VIEW-LASTKEY = EXIT-PROGRAM
031300         GO TO 6990-MAIN-X.
031400
           IF VIEW-LASTKEY = HP-F3-KEY OR F6-KEY
               PERFORM 9100-CALL-SINQMFR THRU 9110-CS-X
               MOVE ZERO TO VIEW-LASTKEY
               GO TO 6990-MAIN-X.
           IF VIEW-LASTKEY = F2-KEY
               PERFORM 9120-MATERIAL-STATUS THRU 9130-MS-X
               MOVE ZERO TO VIEW-LASTKEY
               GO TO 6990-MAIN-X.

031500*    "N72: NOW EDITING"
031600     MOVE 14072 TO CATREAD-MSG-NUMBER.
031700     PERFORM 999-CATREAD.
031800     MOVE "Y" TO SRF-MSG-AND-GO.
031900     PERFORM 9999-SETERROR-1.
032000
032100*------ IF CHARGE DATA (EMPL, WO, REQ-DEPT, CHARGE-DEPT, EXP
032200*------ CLASS) ARE LEFT BLANK, DEFAULT TO THE FIRST LINE ABOVE IT
032300*------ THAT HAS ANY CHARGE DATA
032400     MOVE 1                        TO  SUB.
032500     PERFORM 14 TIMES
032600         ADD 1                     TO  SUB
032700         IF DE-CHARGE-DATA (SUB) = SPACES AND DE-CODE (SUB) > " "
032800             MOVE SUB              TO  SUB2
032900             MOVE "N"              TO  FOUND-ONE
033000             PERFORM UNTIL SUB2 = 1 OR FOUND-ONE = "Y"
033100                 SUBTRACT 1 FROM SUB2
033200                 IF DE-CHARGE-DATA (SUB2) > SPACES
033300                     MOVE DE-CHARGE-DATA (SUB2)
033400                                   TO  DE-CHARGE-DATA (SUB)
033500                     MOVE "Y"      TO  FOUND-ONE
033600                 END-IF
033700             END-PERFORM
033800         END-IF
033900     END-PERFORM.
034000
034100********************************************
034200**      EDIT ENTIRE SCREEN                **
034300********************************************
034400     MOVE ZERO                     TO  SUB.
      *------  SET TQTYEDIT RETURN LIMIT CHECK FLAG TO "Y" TO BYPASS
      *------  LIMIT CHECKS UNTIL NEXT PERFORM GROUP
           MOVE "Y"                      TO  WARNING-FLAG.
034500     PERFORM UNTIL SUB = 15 OR MESSAGE-BUFFER-1 > SPACES
034600         ADD 1                     TO  SUB
034700         IF DE-CODE (SUB) > SPACES
034800             MOVE DE-CODE (SUB)    TO  HOLD-CODE
034900             MOVE DE-QTY (SUB)     TO  HOLD-QTY
035000             MOVE DE-CHARGE-DATA (SUB) TO HOLD-CHARGE-DATA
035100             PERFORM 9000-ALTKEY
035200             PERFORM 7000-EDIT-CODE THRU 7990-EC-X
035300             MOVE HOLD-CODE        TO  DE-CODE (SUB)
035400             MOVE HOLD-QTY         TO  DE-QTY (SUB)
035500             MOVE HOLD-CHARGE-DATA TO  DE-CHARGE-DATA (SUB)
035600             IF MESSAGE-BUFFER-1 NOT = SPACES
035700                 PERFORM 9999-RESET-MSTORERM-CD-O
035800                 IF EDIT-SUB = 6
035900                     MOVE 5        TO  EDIT-SUB
036000                 END-IF
036100                 COMPUTE SRF-ERROR-FLD =
036200                   ((SUB - 1) * 8) + EDIT-SUB + 2
036300             END-IF
036400         ELSE
036500             MOVE SPACES           TO  DE-LINE (SUB)
036600         END-IF
036700     END-PERFORM.
036800     IF MESSAGE-BUFFER-1 NOT = SPACES
036900         GO TO 6990-MAIN-X.
037000
      *-----  INITIALIZE WARNING-FLAG FOR TQTYEDIT FOR RETURN LIMITS
      *-----  DONE HERE SO EACH QTY ON WORKSHEET WILL BE CHECKED AT
      *-----  LEAST ONCE IN NEXT SET OF LOGIC.
           MOVE "N"          TO WARNING-FLAG.

037100*    "N73: NOW PROCESSING"
037200     MOVE 14073 TO CATREAD-MSG-NUMBER.
037300     PERFORM 999-CATREAD.
037400     MOVE "Y" TO SRF-MSG-AND-GO.
037500     PERFORM 9999-SETERROR-1.
037600
037700********************************************
037800**      EDIT AND ISSUE INDIVIUAL CODES    **
037900********************************************
038000     MOVE ZERO                     TO  SUB.
038100     PERFORM UNTIL SUB = 15 OR MESSAGE-BUFFER-1 > SPACES
038200         ADD 1                     TO  SUB
038300         IF DE-CODE (SUB) > SPACES
038400             MOVE DE-CODE (SUB)    TO  HOLD-CODE
038500             MOVE DE-QTY (SUB)     TO  HOLD-QTY
038600             MOVE DE-CHARGE-DATA (SUB) TO HOLD-CHARGE-DATA
038700             PERFORM 9000-ALTKEY
038800             MOVE 1                TO  NUMBER-OF-LOCK-DESCRIPTORS
038900             MOVE CODE-ARG         TO  LOCK-VALUE
039000             PERFORM 9999-MULTI-LOCK
039100             PERFORM 7000-EDIT-CODE THRU 7990-EC-X
                   PERFORM 60000-CHECK-LIMITS THRU 60000-CL-X
039200             MOVE HOLD-CODE        TO  DE-CODE (SUB)
039300             MOVE HOLD-QTY         TO  DE-QTY (SUB)
039400             MOVE HOLD-CHARGE-DATA TO  DE-CHARGE-DATA (SUB)
039500             IF MESSAGE-BUFFER-1 NOT = SPACES
039600                 PERFORM 9999-RESET-MSTORERM-CD-O
039700                 PERFORM 9999-UNLOCK
039800                 IF EDIT-SUB = 6
039900                     MOVE 5        TO  EDIT-SUB
040000                 END-IF
040100                 COMPUTE SRF-ERROR-FLD =
040200                   ((SUB - 1) * 8) + EDIT-SUB + 2
040300             ELSE
040400                 PERFORM 8000-ISSUE-CODE THRU 8990-IC-X
040500                 MOVE SPACES       TO  DE-LINE (SUB)
      *-----  INITIALIZE WARNING-FLAG FOR TQTYEDIT FOR RETURN LIMITS
      *-----  DONE HERE SO EACH QTY ON WORKSHEET CHECKED AT LEAST ONCE
                       MOVE "N" TO WARNING-FLAG
040600             END-IF
040700         END-IF
040800     END-PERFORM.
040900     IF MESSAGE-BUFFER-1 NOT = SPACES
041000         GO TO 6990-MAIN-X.
041100
041200     MOVE DE-STOREROOM             TO  SAVE-STOREROOM.
041300     MOVE SPACES                   TO  DE-FIELDS-1.
041400     PERFORM 9999-RESET-SCREEN.
041500     MOVE SAVE-STOREROOM           TO  DE-STOREROOM.
      *-----  INITIALIZE WARNING-FLAG FOR TQTYEDIT FOR RETURN LIMITS
      *-----  DONE HERE SO EACH QTY ON WORKSHEET CHECKED AT LEAST ONCE
      *-----  ALSO SET SAVE-SUB TO 0
           MOVE "N" TO WARNING-FLAG.
           MOVE 0 TO SAVE-SUB.
041600
041700 6990-MAIN-X.
041800     EXIT.
041900
042000*****************************************************************
042200**        E D I T   R E T U R N   L I M I T S                  **
042400*****************************************************************
       60000-CHECK-LIMITS.
      *------ IF WARNING-FLAG IS "Y", THEN A UNIT QTY/VALUE LIMITS HAS
      *------ BEEN SURPASSED.  IF CURRENT WORKSHEET ENTRY IN ERROR (SUB)
      *------ IS EQUAL TO THE LAST-ENTRY FLAGGED FOR ERROR (SAVE-SUB),
      *------ THEN USER HAS SEEN THE MESSAGE AND WANTS TO ACCEPT THE
      *------ ENTRY, SO OVERRIDE THE WARNING BY CLEARING MSG BUFFER. IF
      *------ CURRENT ENTRY FLAGGED FOR SURPASSING RETURN LIMIT DOES
      *------ NOT EQUAL THE LAST ENTRY FLAGGED, THEN THIS IS THE FIRST
      *------ CHECK ON THIS FIELD, DO NOT OVERRIDE WARNING.
           IF WARNING-FLAG = "Y"
              IF SAVE-SUB = SUB
                 MOVE SPACES TO MESSAGE-BUFFER-1
              ELSE
                 MOVE SUB TO SAVE-SUB.

       60000-CL-X.
           EXIT.

042000*****************************************************************
042100**                                                             **
042200**     E D I T   C O R P O R A T E   C O D E                   **
042300**                                                             **
042400*****************************************************************
042500 7000-EDIT-CODE.
042600     PERFORM 9999-GETKEY-MSTORERM-CD-O.
042700     IF NO-ENTRY
042800*        "S9: STORES CODE DOES NOT EXIST"
042900         MOVE 19009                TO  CATREAD-MSG-NUMBER
043000         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
043100         MOVE MESSAGE-BUFFER       TO  MSG-TEXT
043200         MOVE HOLD-CODE            TO  MSG-FLD
043300         MOVE -1                   TO  EDIT-SUB
043400         GO TO 7990-EC-X.
043500
043600     IF STR-STATE = "F"
043700*        "M32: MATERIAL BEING INVENTORIED"
043800         MOVE 13032                TO  CATREAD-MSG-NUMBER
043900         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
044000         MOVE MESSAGE-BUFFER       TO  MSG-TEXT
044100         MOVE HOLD-CODE            TO  MSG-FLD
044200         MOVE -1                   TO  EDIT-SUB
044300         GO TO 7990-EC-X.
