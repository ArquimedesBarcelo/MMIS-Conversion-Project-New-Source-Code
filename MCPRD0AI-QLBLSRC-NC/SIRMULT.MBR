055600         MOVE HOLD-EMPL            TO  STR-LAST-EMPL
055700         IF AKRON-PLANT
055800             IF IT-J-Z-CHECK = "I" OR "J" OR "Z"
055900                 MOVE HOLD-WO      TO  STR-LAST-CHARGE
056000             ELSE
056100             IF STATIONERY-CHECK = "R" OR "D" OR "T" OR "S"
056200                 MOVE HOLD-REQ-DEPT  TO  STR-LAST-CHARGE
056300             ELSE
056400             IF HOLD-CHARGE-TYPE = "4" OR "5"
056500                 MOVE HOLD-REQ-DEPT  TO  STR-LAST-CHARGE
056600             ELSE
056700                 MOVE HOLD-CHARGE-DEPT TO  STR-LAST-CHARGE
056800         ELSE
056900             MOVE HOLD-CHARGE-DEPT TO  STR-LAST-CHARGE.
057000
057100     PERFORM 9999-UPDATE-MSTORERM-CD-O.
057200
057300     PERFORM 9999-UNLOCK.
057400
057500 64-UPDATE-DDAILYTC.
057600     MOVE 10                       TO  SAVE-PARA-NUMBER.
      *------5/2/97 BUILD OWNER/QTY TABLE
           IF SCOM-PGM-KEY = "SW6"
             MOVE 0 TO MAX-OWNRS
             INITIALIZE OWNER-TABLE
             PERFORM VARYING FRAN-SUB FROM 1 BY 1
             UNTIL FRAN-SUB > 6
               IF DE-QTY-9(FRAN-SUB) > 0
                   SET OWNR-IDX TO 1
                   SEARCH OWNER-ENTRY
                     AT END
                        ADD 1 TO MAX-OWNRS
                        MOVE DE-FRAN(FRAN-SUB) TO OWNR(MAX-OWNRS)
                        IF DE-QTY-X(FRAN-SUB) NUMERIC
                          MOVE DE-QTY-9(FRAN-SUB) TO OWNR-QTY(MAX-OWNRS)
                        ELSE
                          MOVE ZEROS        TO OWNR-QTY(MAX-OWNRS)
                        END-IF
                     WHEN OWNR(OWNR-IDX) = DE-FRAN(FRAN-SUB)
                        MOVE OWNR-IDX TO CURR-OWNR
                        IF MAX-OWNRS = 0
                            MOVE 1 TO MAX-OWNRS
                            MOVE 0 TO OWNR-QTY(CURR-OWNR)
                        END-IF
                        IF DE-QTY-X(FRAN-SUB) NUMERIC
                         IF OWNR-QTY(CURR-OWNR) NUMERIC
                          ADD DE-QTY-9(FRAN-SUB) TO OWNR-QTY(CURR-OWNR)
                         ELSE
                          MOVE DE-QTY-9(FRAN-SUB) TO OWNR-QTY(CURR-OWNR)
                         END-IF
                        END-IF
                   END-SEARCH
              END-IF
             END-PERFORM
           END-IF.
057700     IF HOLD-EXP-CLASS = "000000"
057800         MOVE SPACES               TO  HOLD-EXP-CLASS.
057900
