000300 IDENTIFICATION DIVISION.
000400 PROGRAM-ID. TITEM.
000800*REMARKS.
000900*        ########################################################
001000*        # Personnel item definition maintenance .............. #
001100*        ########################################################.
001200*
001500 ENVIRONMENT DIVISION.
001600 CONFIGURATION SECTION.
001700 SOURCE-COMPUTER. AS400.
001800 OBJECT-COMPUTER. AS400.
       SPECIAL-NAMES.   I-O-FEEDBACK IS I-O-FEEDBACK-AREA
                        LOCAL-DATA IS LOCAL-DATA-AREA.
001000 INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT DISPLAY-FILE
               ASSIGN TO WORKSTATION-ZPERSON-SI
               ORGANIZATION IS TRANSACTION
               ACCESS IS SEQUENTIAL
               FILE STATUS IS DSPLY-STATUS
               CONTROL-AREA IS WS-CONTROL.
           SELECT PER-CONF-MSTR
               ASSIGN TO DATABASE-MCFLMM3001
               ORGANIZATION IS INDEXED
               ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
               FILE STATUS IS PCM-STATUS.
002200 DATA DIVISION.
       FILE SECTION.
       FD  DISPLAY-FILE
           LABEL RECORDS ARE OMITTED.
       01  DSPLY-REC                     PIC X(2000).
       FD  PER-CONF-MSTR
           LABEL RECORDS ARE STANDARD
           DATA RECORD IS PCMREC.
       01  PCMREC.
           COPY DDS-ALL-FORMATS OF MCFLMM3001.
002300 WORKING-STORAGE SECTION.
       COPY CATREAD OF COPYLIB.
       COPY CPYIND  OF COPYLIB.
003700 01  ERROR-SW                      PIC X.
003800 01  ERROR-BUFFER                  PIC X(80) VALUE SPACES.
       01  DSPLY-STATUS                  PIC XX.
       COPY IOFEEDBACK OF COPYLIB.
005100 01  ITEM-99                       PIC 99.
005200 01  ITEM-BUFFER.
005300     05  ITEM-B                    PIC XX.
005400     05  DEFN-B                    PIC X(30).
           05  ITEM-CMD-LINE             PIC X(79).
           05  ITEM-ERR-LINE             PIC X(79).
       01  ITEM-VALUE                    PIC XX.
004700 01  OVERRIDE-TABLE.
004800     05 OVERRIDE OCCURS  10 TIMES  PIC X.
005900 01  PASSED-SPOOL-PRT              PIC S9(2) COMP VALUE 0.
002400 01  PASSWORD-INFORMATION.
002500     05  NAME-OF-PROGRAM     PIC X(08) VALUE "TITEM   ".
002600     05  PROGRAM-TYPE        PIC X(02) VALUE "MA".
002700     05  PROGRAM-RELEASE     PIC X(12) VALUE " E0100010001".
002800     05  PROGRAM-DESCRIPTION.
002900         10  PROG-DESC-A.
                   15  FILLER      PIC X(17) VALUE "PERSONNEL SYSTEM ".
                   15  FILLER      PIC X(15) VALUE "IDENTIFICATION ".
                   15  FILLER      PIC X(16) VALUE "ITEM DEFINITION ".
                   15  FILLER      PIC X(12) VALUE "PROGRAM".
003100         10  PROG-DESC-B     PIC X(60) VALUE SPACES.
003300         10  PROG-FUNCTION   PIC X(60) VALUE SPACES.
003500     05  PASSWORD-FLAG       PIC X.
       01  PCM-STATUS                    PIC XX.
004300 01  SAVE-DEFS.
004400     05 SAVE-DEFN OCCURS 10 TIMES  PIC X(30).
004200 01  SAVE-KEY                      PIC S9(4) COMP-4.
004500 01  SCREEN-DEFS.
004600     05 SCRN-DEFN OCCURS 10 TIMES  PIC X(30).
           05  SCREEN-CMD-LINE           PIC X(79).
           05  SCREEN-ERR-LINE           PIC X(79).
005500 01  SCREEN-PRINT-PARMS.
005600     05 PRINTCNTL                  PIC S9(4) COMP VALUE 0.
005700     05 PAGECNTL                   PIC S9(4) COMP VALUE 49.
005800     05 SPOOLFIL-OPEN-SW           PIC X VALUE "N".
006900 COPY DBSTAT    OF COPYLIB.
004900 01  S1                            PIC S9(4) COMP-4.
005000 01  S2                            PIC S9(4) COMP-4.
       01  TRUE-VAL                      PIC 1 VALUE B"1".
       COPY WSCONTROL OF COPYLIB.
007200 LINKAGE SECTION.
007300 01  DBPARAMETERS.                 COPY DBPARMS  OF COPYLIB.
007400 COPY VCOMLINK  OF COPYLIB.
007500 01  PLT-IDT                       PIC X(4).
008000 PROCEDURE DIVISION USING DBPARAMETERS
008100                          VIEW-COMAREA
008200                          PLT-IDT.
       START-PGM.
           PERFORM 1-HSK.
           PERFORM 6-MAIN.
       2-EOJ.
           CLOSE DISPLAY-FILE.
           CLOSE PER-CONF-MSTR.
           GOBACK.
008700 1-HSK.
           OPEN I-O   DISPLAY-FILE.
           OPEN I-O   PER-CONF-MSTR.
008800     CALL "TPWORD" USING PASSWORD-INFORMATION.
009200     IF PASSWORD-FLAG = "N" GO TO 2-EOJ.
010200     MOVE SPACES TO SAVE-DEFS SCREEN-DEFS.
010300     MOVE 0 TO S2.
010400     MOVE SPACES TO OVERRIDE-TABLE.
011200 6-MAIN.
011900     PERFORM 61-READ-CODES THRU 61-EXIT UNTIL COND-WORD = 11.
012000     PERFORM 62-DISPLAY-SCREEN.
012400 61-READ-CODES.
012500     MOVE 0 TO COND-WORD.
012600     READ PER-CONF-MSTR NEXT INTO ITEM-BUFFER
012700         AT END    MOVE 11 TO COND-WORD.
           IF PCM-STATUS NOT = "00" MOVE 11 TO COND-WORD.
013300     IF COND-WORD = 11 GO TO 61-EXIT.
014000     MOVE ITEM-B TO ITEM-99.
014100     MOVE ITEM-99 TO S1.
014200     MOVE DEFN-B TO SAVE-DEFN (S1) SCRN-DEFN (S1).
014500 61-EXIT.    EXIT.
014900 62-DISPLAY-SCREEN.
015000     MOVE "FITEM" TO VIEW-CFNAME.
           MOVE 66196 TO CATREAD-MSG-NUMBER.
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
           MOVE ERROR-BUFFER TO SCREEN-CMD-LINE.
           MOVE SCREEN-DEFS TO DSPLY-REC.
           PERFORM 99-SCREEN-WRITE.
           PERFORM 98-SCREEN-READ.
           MOVE DSPLY-REC TO SCREEN-DEFS.
017500     IF VIEW-LASTKEY = 3 GO TO 2-EOJ.
018800     IF S2 NOT = 0
018900         IF VIEW-LASTKEY = 0
019000             MOVE 5 TO VIEW-LASTKEY
019100             MOVE 0 TO S2
019200         ELSE
019300         MOVE 0 TO VIEW-LASTKEY
019400         SUBTRACT 1 FROM S1
019500         MOVE SPACE TO OVERRIDE (S1)
019600         MOVE 0 TO S2.
019700     IF VIEW-LASTKEY = 1 OR 5
019800         MOVE VIEW-LASTKEY TO SAVE-KEY
019900     ELSE
020100     GO TO 6-MAIN.
020900     IF SAVE-KEY = 1
021000         PERFORM HELP-ITEMS
021100         PERFORM 62-DISPLAY-SCREEN
021200         GO TO 6-MAIN.
021500     MOVE "N" TO ERROR-SW.
021700     PERFORM EDIT-ITEMS THRU EDIT-EXIT VARYING S1 FROM 1 BY 1
021800         UNTIL S1 > 10 OR ERROR-SW = "Y".
021900     IF ERROR-SW = "Y" GO TO 6-MAIN.
022900     PERFORM UPDT-ITEMS THRU UPDT-EXIT VARYING S1 FROM 1 BY 1
023000         UNTIL S1 > 10.
023400 EDIT-ITEMS.
023500     IF SCRN-DEFN (S1) NOT = SPACES
023600         IF SAVE-DEFN (S1) = SPACES
023700             NEXT SENTENCE
023800         ELSE
023900         IF SCRN-DEFN (S1) = SAVE-DEFN (S1)
024000             NEXT SENTENCE
024100         ELSE
024400         MOVE S1                  TO ITEM-99
024500         MOVE ITEM-99             TO ITEM-VALUE
024600         PERFORM 69-START-PER-CONF-MSTR
024800         IF COND-WORD = 0
025200             IF OVERRIDE (S1) = "O"
025300                 NEXT SENTENCE
025400             ELSE
025500             MOVE 1 TO S2
025600             MOVE "O" TO OVERRIDE (S1)
025700             MOVE "Y" TO ERROR-SW
025800             MOVE 44003 TO CATREAD-MSG-NUMBER
026000             PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
026100             GO TO EDIT-EXIT
026200         ELSE
026300         NEXT SENTENCE
026400     ELSE
026500     IF SAVE-DEFN (S1) NOT = SPACES
026800         MOVE S1                  TO ITEM-99
026900         MOVE ITEM-99             TO ITEM-VALUE
027000         PERFORM 69-START-PER-CONF-MSTR
027200         IF COND-WORD = 0
027600             MOVE "Y" TO ERROR-SW
027700             MOVE 42007 TO CATREAD-MSG-NUMBER
027900             PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
028000             GO TO EDIT-EXIT.
028400 EDIT-EXIT.    EXIT.

028800 UPDT-ITEMS.
028900     IF SCRN-DEFN (S1) NOT = SPACES
029000         IF SAVE-DEFN (S1) = SPACES
029200             MOVE S1 TO ITEM-99
029300             MOVE ITEM-99 TO ITEM-B
029400             MOVE SCRN-DEFN (S1) TO DEFN-B
029500             PERFORM 69-WRITE-PER-CONF-MSTR
029800             IF COND-WORD = 0
030000                 MOVE 35098 TO CATREAD-MSG-NUMBER
                       PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                       MOVE ERROR-BUFFER TO SCREEN-CMD-LINE
                       MOVE SCREEN-DEFS TO DSPLY-REC
                       MOVE TRUE-VAL TO INDS (98)
                       PERFORM 99-SCREEN-WRITE
                       PERFORM 98A-SCREEN-READ
                       CALL "CLPAUSE2"
                   ELSE
                   GO TO 2-EOJ
030100         ELSE
030200         IF SCRN-DEFN (S1) = SAVE-DEFN (S1)
030300             NEXT SENTENCE
030400         ELSE
030600         MOVE S1 TO ITEM-99
030700         MOVE ITEM-99 TO ITEM-B
030800         PERFORM 69-READ-PER-CONF-MSTR
031100         IF COND-WORD NOT = 0
                   GO TO 2-EOJ
031200         ELSE
031300         MOVE SCRN-DEFN (S1) TO DEFN-B
031400         PERFORM 69-REWRITE-PER-CONF-MSTR
031700         IF COND-WORD NOT = 0
                   GO TO 2-EOJ
031800         ELSE
031900         MOVE 35101 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE ERROR-BUFFER TO SCREEN-CMD-LINE
               MOVE SCREEN-DEFS TO DSPLY-REC
               MOVE TRUE-VAL TO INDS (98)
               PERFORM 99-SCREEN-WRITE
               PERFORM 98A-SCREEN-READ
               CALL "CLPAUSE2"
032000     ELSE
032100     IF SAVE-DEFN (S1) NOT = SPACES
032300         MOVE S1 TO ITEM-99
032400         MOVE ITEM-99 TO ITEM-B
032500         PERFORM 69-READ-PER-CONF-MSTR
               IF COND-WORD NOT = 0
                   GO TO 2-EOJ
               ELSE
               PERFORM 69-DELETE-PER-CONF-MSTR
               IF COND-WORD NOT = 0
                   GO TO 2-EOJ
               ELSE
               MOVE 35103 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE ERROR-BUFFER TO SCREEN-CMD-LINE
               MOVE SCREEN-DEFS TO DSPLY-REC
               MOVE TRUE-VAL TO INDS (98)
               PERFORM 99-SCREEN-WRITE
               PERFORM 98A-SCREEN-READ
               CALL "CLPAUSE2".
033500 UPDT-EXIT.    EXIT.

036400 HELP-ITEMS.
036500     MOVE "FITEMHLP" TO VIEW-CFNAME.
           MOVE SPACES TO DSPLY-REC.
           PERFORM 99-SCREEN-WRITE.
           PERFORM 98-SCREEN-READ.

       69-DELETE-PER-CONF-MSTR.
           MOVE 0 TO COND-WORD.
           DELETE PER-CONF-MSTR RECORD
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF PCM-STATUS NOT = "00" MOVE 17 TO COND-WORD.

       69-READ-PER-CONF-MSTR.
           MOVE 0 TO COND-WORD.
           READ PER-CONF-MSTR INTO ITEM-BUFFER
               AT END    MOVE 15 TO COND-WORD.
           IF PCM-STATUS NOT = "00" MOVE 15 TO COND-WORD.

       69-REWRITE-PER-CONF-MSTR.
           MOVE 0 TO COND-WORD.
           REWRITE PCMREC FROM ITEM-BUFFER
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF PCM-STATUS NOT = "00" MOVE 17 TO COND-WORD.

       69-START-PER-CONF-MSTR.
           MOVE 0 TO COND-WORD.
           MOVE ITEM-VALUE TO PERCONFITM OF PCMREC.
           START PER-CONF-MSTR KEY IS = EXTERNALLY-DESCRIBED-KEY
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF PCM-STATUS NOT = "00" MOVE 17 TO COND-WORD.

       69-WRITE-PER-CONF-MSTR.
           MOVE 0 TO COND-WORD.
           WRITE PCMREC FROM ITEM-BUFFER
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF PCM-STATUS NOT = "00" MOVE 17 TO COND-WORD.

       98-SCREEN-READ.
           READ DISPLAY-FILE FORMAT IS VIEW-CFNAME
               INDIC IS INDICS.
           ACCEPT IOFEEDBACK FROM I-O-FEEDBACK-AREA.
           MOVE ALL B"0" TO INDICS.
           IF DSPLY-STATUS NOT = "00"
               MOVE 3 TO VIEW-LASTKEY
           ELSE
           MOVE FUNCTION-NUM TO VIEW-LASTKEY.

       98A-SCREEN-READ.
           READ DISPLAY-FILE TERMINAL IS TERMINAL-ID
               INDIC IS INDICS
                  NO DATA MOVE DSPLY-STATUS TO DSPLY-STATUS.
           MOVE ALL B"0" TO INDICS.

       99-SCREEN-WRITE.
           WRITE DSPLY-REC FORMAT IS VIEW-CFNAME
               INDIC IS INDICS.
           MOVE ALL B"0" TO INDICS.

025900 999-CATREAD.
026000     MOVE SPACES TO ERROR-BUFFER.
026100     CALL "CCATREAD" USING CATREAD-PARMS.
026200     MOVE CATREAD-MSG-TEXT TO ERROR-BUFFER.
027000 999-CATREAD-EXIT.
027100     EXIT.
