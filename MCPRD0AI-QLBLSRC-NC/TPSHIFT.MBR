000200 IDENTIFICATION DIVISION.
000300 PROGRAM-ID.    TPSHIFT.
000500*REMARKS.
000600*        ###############################################
000700*        #  Mass changes personnel shift assignments  ##
000800*        ###############################################.
001000 ENVIRONMENT DIVISION.
001100 CONFIGURATION SECTION.
001200 SOURCE-COMPUTER. AS400.
001300 OBJECT-COMPUTER. AS400.
       SPECIAL-NAMES.      I-O-FEEDBACK IS I-O-FEEDBACK-AREA
                           LOCAL-DATA IS LOCAL-DATA-AREA.
001000 INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT DISPLAY-FILE
               ASSIGN TO WORKSTATION-ZPERSON-SI
               ORGANIZATION IS TRANSACTION
               ACCESS IS SEQUENTIAL
               FILE STATUS IS DSPLY-STATUS
               CONTROL-AREA IS WS-CONTROL.
           SELECT PERSONNEL-FILE
               ASSIGN TO DATABASE-MCFLMM0301
               ORGANIZATION IS INDEXED
               ACCESS IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
               FILE STATUS IS PF-STATUS.
001400 DATA DIVISION.
       FILE SECTION.
       FD  DISPLAY-FILE
           LABEL RECORDS ARE OMITTED.
       01  DSPLY-REC                   PIC X(2000).
       FD  PERSONNEL-FILE
           LABEL RECORDS ARE STANDARD
           DATA RECORD IS PFREC.
       01  PFREC.
           COPY DDS-ALL-FORMATS OF MCFLMM0301.
001600 WORKING-STORAGE SECTION.
       COPY CATREAD OF COPYLIB.
       COPY CPYIND  OF COPYLIB.
       01  DSPLY-STATUS              PIC XX.
003400 01  ERROR-BUFFER.
           05  FILLER                PIC X(12).
           05  ERR-CC                PIC X(4).
           05  FILLER                PIC X(64).
       COPY IOFEEDBACK OF COPYLIB.
001700 01  PASSWORD-INFORMATION.
001800     05  NAME-OF-PROGRAM       PIC X(08) VALUE "TPSHIFT ".
001900     05  PROGRAM-TYPE          PIC X(02) VALUE "MA".
002000     05  PROGRAM-RELEASE       PIC X(12) VALUE " E0100010001".
002100     05  PROGRAM-DESCRIPTION.
002200         10  PROG-DESC-A       PIC X(60) VALUE
002300            "CHANGES THE SHIFTS IN THE PERSONNEL FILE "          .
002400         10  PROG-DESC-B       PIC X(60) VALUE SPACES.
002600         10  PROG-FUNCTION     PIC X(60) VALUE SPACES.
002800     05  PASSWORD-FLAG         PIC X.
004100 01  PER-PERSONNEL.            COPY MPERSONL OF COPYLIB.
       01  PF-STATUS                 PIC XX.
003100 01  SUB1                      PIC S9(4) COMP.
003200 01  SUB2                      PIC S9(4) COMP.
003500 01  SCREEN-BUFFER.
003600     05 SHIFT1                 PIC X.
003700     05 SHIFT2                 PIC X.
003800     05 ZONE                   PIC X(4).
003900     05 DEPT                   PIC X(4).
004000     05 CRAFT                  PIC X(2).
           05  SCREEN-CMD-LINE       PIC X(79).
           05  SCREEN-ERR-LINE       PIC X(79).
004200 COPY DBSTAT    OF COPYLIB.
004300 01  TEMP-SHIFT-CREW.
004400     05 TEMP-SHIFT             PIC X.
004500     05 TEMP-CREW              PIC X.
       01  TRUE-VAL                  PIC 1 VALUE B"1".
004600 COPY WSCONTROL OF COPYLIB.
004700 LINKAGE SECTION.
004800 01  DBPARAMETERS.             COPY DBPARMS  OF COPYLIB.
004900 COPY VCOMLINK  OF COPYLIB.
005000 01  PLT-IDT                   PIC X(4).
005400 PROCEDURE DIVISION USING DBPARAMETERS VIEW-COMAREA
005500                      PLT-IDT.
005600 START-PGM.
           PERFORM 1-HSK.
           PERFORM 6-MAIN.
       2-EOJ.
           CLOSE DISPLAY-FILE.
           CLOSE PERSONNEL-FILE.
           GOBACK.
005700 1-HSK.
           OPEN I-O   DISPLAY-FILE.
           OPEN I-O   PERSONNEL-FILE.
005800     CALL "TPWORD" USING PASSWORD-INFORMATION.
006200     IF PASSWORD-FLAG = "N" GO TO 2-EOJ.
       6-MAIN.
008000     MOVE "FPSHIFT" TO VIEW-CFNAME.
008400     MOVE SPACES TO SCREEN-BUFFER.
008500     MOVE SCREEN-BUFFER TO DSPLY-REC.
           PERFORM 99-SCREEN-WRITE.
010000     PERFORM 61-READ-AND-UPDATE-PERSONNEL THRU 61-RAUP-EXIT.
010200
010300 61-READ-AND-UPDATE-PERSONNEL.
010400     PERFORM 98-SCREEN-READ.
011400     IF VIEW-LASTKEY = 3 GO TO 61-RAUP-EXIT.
           MOVE DSPLY-REC TO SCREEN-BUFFER.

015000 61-RAUP-CONT.
015100     MOVE 0 TO COND-WORD.
015200     READ PERSONNEL-FILE NEXT INTO PER-PERSONNEL
015300         AT END    MOVE 11 TO COND-WORD.
           IF PF-STATUS NOT = "00" MOVE 11 TO COND-WORD.
015400     IF COND-WORD = 11 GO TO 61-RAUP-EXIT.
016000     MOVE PER-SHIFT-CREW TO TEMP-SHIFT-CREW.
016200     IF SHIFT1 = TEMP-SHIFT
016300         NEXT SENTENCE
016400     ELSE
016500     GO TO 61-RAUP-CONT.
016600
016700     IF ZONE = SPACES
016800         NEXT SENTENCE
016900     ELSE
017000     IF ZONE = PER-MAINT-ZONE
017100         NEXT SENTENCE
017200     ELSE
017300     GO TO 61-RAUP-CONT.
017400
017500     IF DEPT = SPACES
017600         NEXT SENTENCE
017700     ELSE
017800     IF DEPT = PER-DEPT
017900         NEXT SENTENCE
018000     ELSE
018100     GO TO 61-RAUP-CONT.
018200
018300     IF CRAFT = SPACES
018400         NEXT SENTENCE
018500     ELSE
018600     IF CRAFT = PER-CRAFT
018700         NEXT SENTENCE
018800     ELSE
018900     GO TO 61-RAUP-CONT.
019000
019100     MOVE SHIFT2 TO TEMP-SHIFT.
019200     MOVE TEMP-SHIFT-CREW TO PER-SHIFT-CREW.
019300
019400     MOVE 0 TO COND-WORD.
019500     REWRITE PFREC FROM PER-PERSONNEL
019600         INVALID KEY    MOVE 17 TO COND-WORD.
           IF PF-STATUS NOT = "00" MOVE 17 TO COND-WORD.
019700     IF COND-WORD = 17 GO TO 2-EOJ.
           MOVE 66192 TO CATREAD-MSG-NUMBER.
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
           MOVE PERCCNUM OF PFREC TO ERR-CC.
           MOVE ERROR-BUFFER TO SCREEN-CMD-LINE.
           MOVE SCREEN-BUFFER TO DSPLY-REC.
019900     MOVE TRUE-VAL TO INDS (98).
           PERFORM 99-SCREEN-WRITE.
           PERFORM 98A-SCREEN-READ.
           CALL "CLPAUSE2".
020000     GO TO 61-RAUP-CONT.
020100
020200 61-RAUP-EXIT.    EXIT.
020400
       98-SCREEN-READ.
           READ DISPLAY-FILE FORMAT IS VIEW-CFNAME
               INDIC IS INDICS.
           ACCEPT IOFEEDBACK FROM I-O-FEEDBACK-AREA.
           MOVE ALL B"0" TO INDICS.
           IF DSPLY-STATUS NOT = "00"
               MOVE 3 TO VIEW-LASTKEY
           ELSE
           MOVE FUNCTION-NUM TO VIEW-LASTKEY.

       98A-SCREEN-READ.
           READ DISPLAY-FILE TERMINAL IS TERMINAL-ID
               INDIC IS INDICS
                  NO DATA MOVE DSPLY-STATUS TO DSPLY-STATUS.
           MOVE ALL B"0" TO INDICS.

       99-SCREEN-WRITE.
           WRITE DSPLY-REC FORMAT IS VIEW-CFNAME
               INDIC IS INDICS.
           MOVE ALL B"0" TO INDICS.

051100 999-CATREAD.
024000     MOVE SPACES TO ERROR-BUFFER.
024100     CALL "CCATREAD" USING CATREAD-PARMS.
024200     MOVE CATREAD-MSG-TEXT TO ERROR-BUFFER.
052100 999-CATREAD-EXIT.
052200     EXIT.
