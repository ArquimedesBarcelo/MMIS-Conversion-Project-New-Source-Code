000200 IDENTIFICATION DIVISION.
000300 PROGRAM-ID.     TCHKLOCK.
000400 AUTHOR.         C HILLES.
000500 DATE-WRITTEN.   JULY, 1982.
000600*REMARKS.        THIS PROGRAM FINDS ANY RECORD LOCKS ON THE
000700* AS/400 SYSTEM
001100*
      *C***********************************************************
      *C   05/03/94                                               *
      *C      REMOVED ALL REFERENCES TO PORTABILITY COPYLIB       *
      *C      MEMBERS.                              W.L.M.        *
      *C***********************************************************
002100 ENVIRONMENT DIVISION.
002200 CONFIGURATION SECTION.
002300 SOURCE-COMPUTER.
002400 OBJECT-COMPUTER.
002500 SPECIAL-NAMES. C01 IS NEW-PAGE.
002700 INPUT-OUTPUT SECTION.
002800 FILE-CONTROL.
003000     SELECT PRINT-FILE ASSIGN TO PRINTER-MCPRT.
           SELECT ACT-JOB-FILE ASSIGN TO DISK-MCFPACTJOB.
      *    COPY SLMPLPKI IN COPY DBCS.
           SELECT MPLTINFO-PK-I
               ASSIGN TO DATABASE-MCFLCS0501
               ORGANIZATION IS INDEXED
                 ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
               FILE STATUS IS FILE-STATUS.

003300
003400 DATA DIVISION.
003500 FILE SECTION.
003600 FD  PRINT-FILE
003700     LABEL RECORDS ARE OMITTED
003800     RECORD CONTAINS 132 CHARACTERS
003900     DATA RECORD IS PRINT-REC.
004000 01  PRINT-REC            PIC X(132).
004100
       FD  ACT-JOB-FILE
           RECORD CONTAINS 132 CHARACTERS
           DATA RECORD IS ACT-JOB-REC.
       01  ACT-JOB-REC.
           05  FILLER               PIC X(1).
           05  AJ-SUBSYSTEM.
               10  AJ-SUBSYS-1-2    PIC X(2).
               10  AJ-JOB           PIC X(10).
               10  FILLER           PIC X(3).
           05  AJ-USER              PIC X(10).
           05  FILLER               PIC X(2).
           05  AJ-NUMBER            PIC X(6).
           05  FILLER               PIC X(3).
           05  AJ-TYPE              PIC X(3).
           05  FILLER               PIC X(5).
           05  AJ-POOL              PIC X(1).
           05  FILLER               PIC X(4).
           05  AJ-PRIORITY          PIC X(2).
           05  FILLER               PIC X(6).
           05  AJ-CPU               PIC X(4).
           05  FILLER               PIC X(3).
           05  AJ-INT               PIC X(3).
           05  FILLER               PIC X(3).
           05  AJ-RSP               PIC X(4).
           05  FILLER               PIC X(4).
           05  AJ-AUXIO             PIC X(4).
           05  FILLER               PIC X(2).
           05  AJ-CPU-PCT           PIC X(4).
           05  FILLER               PIC X(3).
           05  AJ-FUNCTION.
               10  AJ-FUNCTION-TYPE PIC X(3).
               10  FILLER           PIC X(1).
               10  AJ-FUNCTION-F    PIC X(10).
           05  FILLER               PIC X(4).
           05  AJ-STATUS            PIC X(4).
           05  FILLER               PIC X(18).
008500
       FD  MPLTINFO-PK-I
           LABEL RECORDS ARE STANDARD.
       01  MPLTINFO-PK-REC-I.
           COPY DDS-MCRPCS0500  OF MCFLCS0501.

008600 WORKING-STORAGE SECTION.
       COPY CCRTFILE   IN COPYLIB.
       COPY COMMAND    IN COPYLIB.
       COPY MPLT0      IN COPYLIB.
       COPY MPLTP01    IN COPYLIB.
       01  PLT-ARG       PIC X(4).
       COPY FILESTAT   IN COPYLIB.
       COPY DBSTAT     IN COPYLIB.
       01  HANDLE-BLOWUP-FLAG PIC X(1)  VALUE "Y".
       COPY TBLOWUP    IN COPYLIB.
008900
       01  PRINT-HDR.
           05  PRT-COMPANY  PIC X(4).
           05  FILLER       PIC X(1)  VALUE SPACES.
           05  PRT-PLT-NAME PIC X(25).
           05  FILLER    PIC X(3)  VALUE SPACES.
           05  FILLER    PIC X(26) VALUE "SESSIONS WITH RECORD LOCKS".
           05  FILLER    PIC X(10)  VALUE SPACES.
           05  FILLER    PIC X(6)  VALUE "DATE: ".
           05  PRT-DATE  PIC X(8).
           05  FILLER    PIC X(5).
           05  FILLER    PIC X(6)  VALUE "TIME: ".
           05  PRT-TIME  PIC X(8).

       01  LOCK-FLAG         PIC X(1).
       01  LOCKED-FILE       PIC X(10).
       01  EOF-FLAG          PIC X(1).
       01  OPENED-PRINT      PIC X(1).

       01  JOB-SPEC          PIC X(28).
       01  PGM-NAMES.
           05  PGM-NAME OCCURS 5 TIMES  PIC X(10).
       01  NUM-PGM-NAMES     PIC 9(1).

039600 PROCEDURE DIVISION.
       0000-START.
           MOVE "N" TO OPENED-PRINT.
           OPEN INPUT MPLTINFO-PK-I.
           MOVE "P 01" TO PLT-ARG.
           PERFORM 9999-GETKEY-MPLTINFO-PK-I.
           MOVE MPLTINFO-COMPANY TO PRT-COMPANY.
           MOVE MPLTINFO-PLT-NAME TO PRT-PLT-NAME.
           CLOSE MPLTINFO-PK-I.
           PERFORM 6000-MAIN THRU 6990-MAIN-X.
           GOBACK.

       2100-BLOWUP.
           DISPLAY "FATAL ERROR, BU-DISPLAY-MSG = ", BU-DISPLAY-MSG.
           STOP RUN.

       6000-MAIN.
      *------ CALL CCRTFILE TO CREATE A TEMPORARY FILE 'MCFPACTJOB'
           MOVE "QTEMP"       TO CCRTFILE-LIBRARY.
           MOVE "MCFPACTJOB"  TO CCRTFILE-FILE.
           MOVE "0132"        TO CCRTFILE-RECORD-LENGTH.
           MOVE "01000"       TO CCRTFILE-NO-RECORDS.
           MOVE "01000"       TO CCRTFILE-INCREMENT-AMT.
           MOVE "10"          TO CCRTFILE-NO-INCREMENTS.
           CALL "CCRTFILE" USING CCRTFILE-LIBRARY,
                                 CCRTFILE-FILE,
                                 CCRTFILE-RECORD-LENGTH,
                                 CCRTFILE-NO-RECORDS,
                                 CCRTFILE-INCREMENT-AMT,
                                 CCRTFILE-NO-INCREMENTS,
                                 CCRTFILE-STATUS.
           IF CCRTFILE-STATUS NOT = "00"
               DISPLAY "FILE CREATE OF 'MCFPACTJOB' FAILED"
               GO TO 6990-MAIN-X.

           MOVE "WRKACTJOB *PRINT" TO COMMAND-WORK.
           CALL "QCMDEXC" USING COMMAND-WORK, COMMAND-LEN.
           MOVE "CPYSPLF FILE(QPDSPAJB) TOFILE(MCFPACTJOB)"
              TO COMMAND-WORK.
           CALL "QCMDEXC" USING COMMAND-WORK, COMMAND-LEN.
           MOVE "DLTSPLF FILE(QPDSPAJB)" TO COMMAND-WORK.
           CALL "QCMDEXC" USING COMMAND-WORK, COMMAND-LEN.

043900     OPEN INPUT ACT-JOB-FILE.

           ACCEPT PRT-DATE FROM DATE.
           ACCEPT PRT-TIME FROM TIME.

           MOVE "N" TO EOF-FLAG.
           READ ACT-JOB-FILE AT END MOVE "Y" TO EOF-FLAG.
           PERFORM UNTIL EOF-FLAG = "Y"
               READ ACT-JOB-FILE AT END
                   MOVE "Y" TO EOF-FLAG
               END-READ
               IF AJ-NUMBER NUMERIC
                   CALL "CFINDLCK" USING AJ-NUMBER, AJ-USER, AJ-JOB,
                      LOCK-FLAG, LOCKED-FILE
                   IF LOCK-FLAG = "Y" AND OPENED-PRINT = "N"
                       MOVE "Y" TO OPENED-PRINT
                       OPEN OUTPUT PRINT-FILE
                       WRITE PRINT-REC FROM PRINT-HDR AFTER ADVANCING 1
                   END-IF
                   IF LOCK-FLAG = "Y"
                       MOVE SPACES TO JOB-SPEC
                       STRING AJ-NUMBER DELIMITED BY SPACES,
                              "/" DELIMITED BY SIZE,
                              AJ-USER DELIMITED BY SPACES,
                              "/" DELIMITED BY SIZE,
                              AJ-JOB DELIMITED BY SPACES
                                INTO JOB-SPEC
                       MOVE SPACES TO PGM-NAMES
                       CALL "CFINDPGM" USING JOB-SPEC, PGM-NAMES,
                         NUM-PGM-NAMES
                       MOVE SPACES TO PRINT-REC
                       STRING "JOB ", AJ-NUMBER, "/", AJ-USER,
                       "/", AJ-JOB, " HAD FILE ",
                         LOCKED-FILE " LOCKED    ",
                         PGM-NAME (1), " ", PGM-NAME (2), " ",
                         PGM-NAME (3), " ", PGM-NAME (4), " ",
                         PGM-NAME (5) DELIMITED BY SIZE INTO PRINT-REC
                       WRITE PRINT-REC AFTER ADVANCING 1
                   END-IF
               END-IF
           END-PERFORM.
           IF OPENED-PRINT = "Y"
               CLOSE PRINT-FILE.
           CLOSE ACT-JOB-FILE.
       6990-MAIN-X.
           EXIT.

      *COPY GKMPLPKI IN COPY DBCS.
       9999-GETKEY-MPLTINFO-PK-I.
           MOVE 0 TO COND-WORD.
           MOVE PLT-ARG TO PLTINFOKEY OF MPLTINFO-PK-REC-I.
           READ MPLTINFO-PK-I INTO BUF-MPLTINFO
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS = "23"
               MOVE 17 TO COND-WORD
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD
               IF HANDLE-BLOWUP-FLAG = "Y"
                   MOVE "GETKEY ERR 9999-GETKEY-MPLTINFO-PK-I"
                       TO BU-MSG-AREA
                   PERFORM 2100-BLOWUP.

