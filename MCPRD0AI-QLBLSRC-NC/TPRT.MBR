       IDENTIFICATION DIVISION.
       PROGRAM-ID.          TPRT.
       AUTHOR.              C HILLES.
       DATE-WRITTEN.        12/18/90.
       DATE-COMPILED.
      *INSTALLATION.        GOODYEAR TIRE AND RUBBER - AKRON.
      *SECURITY.
      *REMARKS.
      *
      *    PRINT A SOURCE FILE MEMBER TO A PRINTER IN NICER FORMAT.
      *    FOR LASER PRINTER.
       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.
       SOURCE-COMPUTER.  HP-3000.
       OBJECT-COMPUTER.  HP-3000.
       COPY SPECIALN IN COPYLIB.
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT PRINT-FILE ASSIGN TO PRINTER-PCDDS2.
           SELECT MEMBER-FILE ASSIGN TO DATABASE-DHDFILE.
       DATA DIVISION.
       FILE SECTION.
       FD  PRINT-FILE
           RECORD CONTAINS 132 CHARACTERS.
       01  PRINT-REC.
           05  PRINT-REC-FIRST           PIC X(5).
           05  PRINT-REC-LAST            PIC X(127).

       FD  MEMBER-FILE
           RECORD CONTAINS 92 CHARACTERS.
       01  MEMBER-REC.
           05  FILLER                    PIC X(12).
           05  MEMBER-AREA               PIC X(80).

       WORKING-STORAGE SECTION.
       01  SUB                           PIC 9(1).
       01  LINE-COUNT                    PIC 9(2).
       01  PAGE-COUNT                    PIC 9(2).
       01  EOF-FLAG                      PIC X(1).
       01  WORK-LINE                     PIC X(80).
       01  FIRST-TIME-FLAG               PIC X(1).

       COPY TDATECHK IN COPYLIB.

      *------ FOR IBM COMMAND TO OVERRIDE DATABASE FILE
       01  COMMAND                       PIC X(80).
       01  COMMAND-LEN     PIC S9(10)V9(5) COMP-3 VALUE 80.

       01  HEADING-LINE.
           05  PRT-DATE                  PIC X(8).
           05  FILLER                    PIC X(1)  VALUE SPACES.
           05  PRT-TIME                  PIC X(8).
           05  FILLER                    PIC X(10) VALUE SPACES.
           05  PRT-TITLE                 PIC X(32).
           05  FILLER                    PIC X(10) VALUE SPACES.
           05  FILLER                    PIC X(5)  VALUE "PAGE ".
           05  PRT-PAGE                  PIC ZZZ9.

       LINKAGE SECTION.
       01  FILE-NAME                     PIC X(10).
       01  LIBRARY-NAME                  PIC X(10).
       01  MEMBER-NAME                   PIC X(10).
       01  OUTQ-NAME                     PIC X(10).
       01  HEADING-LIT                   PIC X(32).
       01  HEADING-FLAG                  PIC X(1).
       01  COLUMN132                     PIC X(1).

       PROCEDURE DIVISION USING FILE-NAME, LIBRARY-NAME,
           MEMBER-NAME, OUTQ-NAME, HEADING-LIT, HEADING-FLAG,
           COLUMN132.

       6000-MAIN.
           MOVE "Y" TO FIRST-TIME-FLAG.
           MOVE SPACES TO COMMAND.
           IF COLUMN132 NOT = "Y"
             STRING "OVRPRTF FILE(PCDDS2) OUTQ("
                    DELIMITED BY SIZE,
                  OUTQ-NAME DELIMITED BY SPACES,
                  ") PAGESIZE(*N 80)" DELIMITED BY SIZE
                  " PRTTXT(*BLANK)" DELIMITED BY SIZE
             INTO COMMAND
           ELSE
             STRING "OVRPRTF FILE(PCDDS2) OUTQ("
                    DELIMITED BY SIZE,
                  OUTQ-NAME DELIMITED BY SPACES,
                  ") PAGESIZE(*N 132)" DELIMITED BY SIZE
                  " PRTTXT(*BLANK)" DELIMITED BY SIZE
             INTO COMMAND.
           CALL "QCMDEXC" USING COMMAND, COMMAND-LEN.

           MOVE SPACES TO COMMAND.
           STRING "OVRDBF FILE(DHDFILE) TOFILE(" DELIMITED BY SIZE,
                  LIBRARY-NAME DELIMITED BY SPACES,
                  "/" DELIMITED BY SIZE,
                  FILE-NAME DELIMITED BY SPACES,
                  ") MBR(" DELIMITED BY SIZE,
                  MEMBER-NAME DELIMITED BY SPACES,
                  ")" DELIMITED BY SIZE INTO COMMAND.
           CALL "QCMDEXC" USING COMMAND, COMMAND-LEN.
           OPEN INPUT MEMBER-FILE.
           OPEN OUTPUT PRINT-FILE.
           MOVE SPACES                   TO  PRINT-REC.

           IF HEADING-LIT = "*FILE"
               MOVE SPACES TO WORK-LINE
               STRING LIBRARY-NAME DELIMITED BY SPACES,
                      "/" DELIMITED BY SIZE,
                      FILE-NAME DELIMITED BY SPACES,
                      "." DELIMITED BY SIZE
                      MEMBER-NAME DELIMITED BY SPACES
                 INTO WORK-LINE
               MOVE WORK-LINE TO PRT-TITLE
           ELSE
               MOVE HEADING-LIT TO PRT-TITLE.

           CALL "TDATECHK" USING DATE-CHECK-AREA.
           MOVE DATE-SLASH-OUT TO PRT-DATE.
           MOVE DATE-FORMATTED-TIME-OUT TO PRT-TIME.
           MOVE ZERO TO PAGE-COUNT.
           PERFORM 7000-PRINT-HEADING.

           MOVE ZERO                     TO  LINE-COUNT.
           MOVE "N"                      TO  EOF-FLAG.
           PERFORM UNTIL EOF-FLAG = "Y"
               READ MEMBER-FILE AT END
                   MOVE "Y"              TO  EOF-FLAG
               END-READ
               IF EOF-FLAG = "N"
                   IF OUTQ-NAME = "A030902D"
                       MOVE MEMBER-AREA      TO  PRINT-REC
                   ELSE
                       MOVE MEMBER-AREA      TO  PRINT-REC-LAST
                   END-IF
                   WRITE PRINT-REC AFTER ADVANCING 1
                   ADD 1                 TO  LINE-COUNT
                   IF LINE-COUNT > 55
                       PERFORM 7000-PRINT-HEADING
                   END-IF
               END-IF
           END-PERFORM.
           CLOSE PRINT-FILE.

       6990-MAIN-X.
           GOBACK.

       7000-PRINT-HEADING.
           ADD 1 TO PAGE-COUNT.
           MOVE PAGE-COUNT TO PRT-PAGE.
           IF HEADING-FLAG = "Y"
               MOVE HEADING-LINE TO PRINT-REC
           ELSE
               MOVE SPACES TO PRINT-REC.
           IF FIRST-TIME-FLAG = "Y"
               WRITE PRINT-REC AFTER ADVANCING 1
               MOVE "N" TO FIRST-TIME-FLAG
           ELSE
               WRITE PRINT-REC AFTER ADVANCING NEW-PAGE.
           MOVE SPACES TO PRINT-REC.
           WRITE PRINT-REC AFTER ADVANCING 1.
           MOVE 2 TO LINE-COUNT.
