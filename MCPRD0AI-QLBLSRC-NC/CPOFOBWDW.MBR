       IDENTIFICATION DIVISION.

       PROGRAM-ID.     CPOFOBWDW.
       AUTHOR.         EXLTECH, INC - DAN RAUCH

      ***************************************************************
      **             FOB PROMPT SELECTION WINDOW
      **       --------------------------------------
      ** THIS PROGRAM HAS 2 EXECUTION MODES:
      **
      ** MODE #1 ==> DISPLAYS FOB DESCRIPTIONS IN A PROMPT WINDOW
      **             ALLOWING USER SELECTIONS.
      **
      ** MODE #2 ==> VALIDATES A PASSED FOB CODE OR DESCRIPTION
      **             AGAINST FILE MCFPPOFOB & RETURNS ERR FLAG
      **       --------------------------------------
      ** NOTE:
      ** CALL THIS PGM USING COPY MBRS ZFOBCDWS  ZFOBCDM1  ZFOBCDM2
      ***************************************************************

      *================================================================
       ENVIRONMENT DIVISION.
      *===============================================================
       CONFIGURATION SECTION.

       SOURCE-COMPUTER.       IBM-AS400.
       OBJECT-COMPUTER.       IBM-AS400.
       SPECIAL-NAMES.         LOCAL-DATA LDA.

       INPUT-OUTPUT SECTION.
       FILE-CONTROL.

           SELECT DISPLAY-FILE  ASSIGN TO WORKSTATION-ZDFOBWDW-SI
                  ORGANIZATION IS TRANSACTION
                  ACCESS IS DYNAMIC
                  FILE STATUS IS WS-FILE-STATUS
                  RELATIVE KEY IS WS-RRN
                  CONTROL-AREA IS WS-KEYBOARD-RETURN-AREA.


      ** LOGICAL  KEYED BY SORTCODE
           SELECT PO-FOBSRT-FILE  ASSIGN TO DATABASE-MCFLCS7201
                  ORGANIZATION IS INDEXED
                  ACCESS IS DYNAMIC
                  FILE STATUS IS WS-FILE-STATUS
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY.

      ** PHYSICAL KEYED BY FOB CODE X(03)
           SELECT PO-FOBCDE-FILE  ASSIGN TO DATABASE-MCFPCS7200
                  ORGANIZATION IS INDEXED
                  ACCESS IS DYNAMIC
                  FILE STATUS IS WS-FILE-STATUS
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY.

      ** LOGICAL  KEYED BY FOB DESC X(20)
           SELECT PO-FOBDSC-FILE  ASSIGN TO DATABASE-MCFLCS7202
                  ORGANIZATION IS INDEXED
                  ACCESS IS DYNAMIC
                  FILE STATUS IS WS-FILE-STATUS
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY.

      *================================================================
       DATA DIVISION.
      *================================================================
       FILE SECTION.

       FD  DISPLAY-FILE.
       01  DISPLAY-REC.
       COPY DDS-ALL-FORMATS OF ZDFOBWDW.

       FD  PO-FOBSRT-FILE.
       01  PO-FOBSRT-REC.
       COPY DDS-ALL-FORMATS OF MCFLCS7201.

       FD  PO-FOBCDE-FILE.
       01  PO-FOBCDE-REC.
       COPY DDS-ALL-FORMATS OF MCFPCS7200.

       FD  PO-FOBDSC-FILE.
       01  PO-FOBDSC-REC.
       COPY DDS-ALL-FORMATS OF MCFLCS7202.

      *----------------------------------------------------------------
       WORKING-STORAGE SECTION.
      *----------------------------------------------------------------
       COPY FILESTATUS IN COPYLIB.

      *****************************************************************
      *  KEYBOARD RETURN AREA
      *****************************************************************
       01  WS-KEYBOARD-RETURN.
           03  WS-KEYBOARD-RETURN-AREA  PIC XX     VALUE SPACE.
               88  KB-ENTER-KEY                VALUE "00".
               88  KB-F01-KEY                  VALUE "01".
               88  KB-F02-KEY                  VALUE "02".
               88  KB-F03-KEY                  VALUE "03".
               88  KB-F04-KEY                  VALUE "04".
               88  KB-F05-KEY                  VALUE "05".
               88  KB-F06-KEY                  VALUE "06".
               88  KB-F07-KEY                  VALUE "07".
               88  KB-F08-KEY                  VALUE "08".
               88  KB-F09-KEY                  VALUE "09".
               88  KB-F10-KEY                  VALUE "10".
               88  KB-F11-KEY                  VALUE "11".
               88  KB-F12-KEY                  VALUE "12".
               88  KB-F13-KEY                  VALUE "13".
               88  KB-F14-KEY                  VALUE "14".
               88  KB-F15-KEY                  VALUE "15".
               88  KB-F16-KEY                  VALUE "16".
               88  KB-F17-KEY                  VALUE "17".
               88  KB-F18-KEY                  VALUE "18".
               88  KB-F19-KEY                  VALUE "19".
               88  KB-F20-KEY                  VALUE "20".
               88  KB-F21-KEY                  VALUE "21".
               88  KB-F22-KEY                  VALUE "22".
               88  KB-F23-KEY                  VALUE "23".
               88  KB-F24-KEY                  VALUE "24".

      *****************************************************************
      *  ALL PROGRAM INDICATORS
      *****************************************************************
       01  WS-ALL-INDICATORS.
           03  IN70              PIC 1   INDIC 70   VALUE B"0".
               88  SFL-CLEAR-OFF                    VALUE B"0".
               88  SFL-CLEAR-ON                     VALUE B"1".

           03  IN71              PIC 1   INDIC 71   VALUE B"0".
               88  SFL-DISPLAY-OFF                  VALUE B"0".
               88  SFL-DISPLAY-ON                   VALUE B"1".


           03  IN72              PIC 1   INDIC 72   VALUE B"0".
               88  SFLEND-OFF                       VALUE B"0".
               88  SFLEND-ON                        VALUE B"1".

       01  WS-ALL-SCREEN-FIELDS.

            03  WS-CTL01-FLDS.
                05  TITLE1            PIC X(25)          VALUE SPACE.
                05  TITLE2            PIC X(25)          VALUE SPACE.

            03  WS-SFL01-FLDS.
                05  SFSEL             PIC X(01)          VALUE SPACE.
                05  SFDESC            PIC X(20)          VALUE SPACE.
                05  SFCODE            PIC X(03)          VALUE SPACE.

      *****************************************************************
      *  MISCELLANEOUS WORK FIELDS
      *****************************************************************
       01  WS-MISCELLANEOUS-FIELDS.
           03  WS-TITLE1         PIC  X(25)         VALUE
               " (X) Sel FOB Description".
           03  WS-TITLE2         PIC  X(25)         VALUE
               "F12-Cancel".

           03  WS-RRN            PIC  9(05)         VALUE ZERO.
           03  WS-RRN1           PIC  9(05)         VALUE ZERO.

           03  WS-FOB-CODE       PIC  X(03)         VALUE SPACE.
           03  WS-FOB-DESC       PIC  X(20)         VALUE SPACE.
           03  WS-FOB-ERR        PIC  X(01)         VALUE SPACE.

           03  WS-SELECTION-SW   PIC  X(01)         VALUE SPACE.
               88  SELECTION-WAS-MADE-NO            VALUE "N".
               88  SELECTION-WAS-MADE-YES           VALUE "Y".

      *================================================================
      *=             L I N K A G E    S E C T I O N
      *================================================================
       LINKAGE SECTION.
       01  LS-FOB-MODE          PIC X(01).
       01  LS-FOB-CODE          PIC X(03).
       01  LS-FOB-DESC          PIC X(20).
       01  LS-FOB-ERR           PIC X(01).


      *================================================================
      *=             P R O C E D U R E    D I V I S I O N
      *================================================================
       PROCEDURE DIVISION  USING LS-FOB-MODE  LS-FOB-CODE  LS-FOB-DESC
                                 LS-FOB-ERR.
       0000-PROGRAM-ENTRY.


           OPEN  INPUT  PO-FOBSRT-FILE
                        PO-FOBCDE-FILE
                        PO-FOBDSC-FILE.


      *----------------------------------------------------------------
      ** DISPLAY FOB PROMPT\SELECTION WINDOW
      *----------------------------------------------------------------
           IF  LS-FOB-MODE = "1"
               OPEN  I-O    DISPLAY-FILE
               PERFORM 0010-INITIALIZE-1     THRU 0010-1-EXIT
               PERFORM 1000-PROCESS-SCREEN-1 THRU 1000-EXIT
               PERFORM 0099-EOJ-RTN-1        THRU 0099-1-EXIT
               CLOSE        DISPLAY-FILE
           END-IF.

      *----------------------------------------------------------------
      ** VALIDATE A PASSED FOB CODE OR DESC - PASS BACK ERR IF NFND
      *----------------------------------------------------------------
           IF  LS-FOB-MODE = "2"
               PERFORM 0010-INITIALIZE-2     THRU 0010-2-EXIT
               PERFORM 2000-CHECK-FOB        THRU 2000-EXIT
               PERFORM 0099-EOJ-RTN-2        THRU 0099-2-EXIT
           END-IF.


           CLOSE        PO-FOBSRT-FILE
                        PO-FOBCDE-FILE
                        PO-FOBDSC-FILE.

       0000-PROGRAM-END.
           GOBACK.

      *****************************************************************
      ** 1ST TIME PROCESSING ROUTINE - MODE = '1'
      *****************************************************************
       0010-INITIALIZE-1.

           SET  SELECTION-WAS-MADE-NO TO TRUE.
           MOVE  SPACE        TO LS-FOB-CODE  LS-FOB-DESC LS-FOB-ERR.

           PERFORM 1999-LOAD-SFL01       THRU 1999-EXIT.

       0010-1-EXIT.
            EXIT.

      *****************************************************************
      ** 1ST TIME PROCESSING ROUTINE - MODE = '2'
      *****************************************************************
       0010-INITIALIZE-2.

           MOVE  LS-FOB-CODE  TO WS-FOB-CODE.
           MOVE  LS-FOB-DESC  TO WS-FOB-DESC.
           MOVE  SPACE        TO WS-FOB-ERR.

       0010-2-EXIT.
            EXIT.

      *****************************************************************
      ** END OF JOB PROCESSING - MODE = '1'
      *****************************************************************
       0099-EOJ-RTN-1.

           IF  SELECTION-WAS-MADE-YES
               MOVE  WS-FOB-CODE  TO LS-FOB-CODE
               MOVE  WS-FOB-DESC  TO LS-FOB-DESC
           END-IF.

       0099-1-EXIT.
            EXIT.

      *****************************************************************
      ** END OF JOB PROCESSING - MODE = '2'
      *****************************************************************
       0099-EOJ-RTN-2.

           IF  WS-FOB-ERR = SPACE
               MOVE  WS-FOB-CODE  TO LS-FOB-CODE
               MOVE  WS-FOB-DESC  TO LS-FOB-DESC
           END-IF.

           MOVE  WS-FOB-ERR   TO LS-FOB-ERR.

       0099-2-EXIT.
            EXIT.

      *****************************************************************
      ***  MAIN PROCESSING LOOP ROUTINE
      *****************************************************************
       1000-PROCESS-SCREEN-1.

           PERFORM 8000-DISPLAY-SCREEN-1  THRU 8000-DSP-EXIT.
           IF  KB-F12-KEY
               GO TO 1000-EXIT
           END-IF.

      ***  CHECK THE SFL FOR USER ENTRY
           PERFORM 1100-CHECK-SFL01       THRU 1100-EXIT.
           IF  SELECTION-WAS-MADE-YES
               GO TO 1000-EXIT
           END-IF.

           GO TO 1000-PROCESS-SCREEN-1.
       1000-EXIT.
            EXIT.

      *****************************************************************
      ***  CHECK SFL01 FOR USER SELECTION
      *****************************************************************
       1100-CHECK-SFL01.

           MOVE SPACE            TO WS-FOB-CODE  WS-FOB-DESC.

       1100-READN-SFL01.

           PERFORM 8000-READN-SFL01      THRU 8000-READN-EXIT.
           IF  FS-END-OF-FILE
               GO TO 1100-EXIT
           END-IF.

           IF  SFSEL  OF WS-SFL01-FLDS  = "X"
               SET  SELECTION-WAS-MADE-YES  TO TRUE
               MOVE SFDESC  OF WS-SFL01-FLDS  TO WS-FOB-DESC
               MOVE SFCODE  OF WS-SFL01-FLDS  TO WS-FOB-CODE
               GO TO 1100-EXIT
           END-IF.

           MOVE SPACE            TO SFSEL  OF WS-SFL01-FLDS.
           PERFORM 8000-REWRT-SFL01      THRU 8000-REWRT-EXIT.

           GO TO 1100-READN-SFL01.

       1100-EXIT.
           EXIT.

      *****************************************************************
      ***  CLEAR SFL01
      *****************************************************************
       1998-CLEAR-SFL01.

           INITIALIZE  WS-SFL01-FLDS.
           MOVE ZERO             TO WS-RRN  WS-RRN1.

           SET  SFL-DISPLAY-OFF  TO TRUE.

           SET  SFL-CLEAR-ON     TO TRUE.
           PERFORM 8000-WRITE-CTL01      THRU 8000-WRTCR-EXIT.
           SET  SFL-CLEAR-OFF    TO TRUE.

           SET  SFLEND-ON        TO TRUE.

       1998-EXIT.
            EXIT.

      *****************************************************************
      ***  CLEAR SFL01
      *****************************************************************
       1999-LOAD-SFL01.

           PERFORM 1998-CLEAR-SFL01      THRU 1998-EXIT.
           PERFORM 9000-START-PO-FOBSRT  THRU 9000-START-EXIT.

       1999-LOAD-LOOP.

           PERFORM 9000-READN-PO-FOBSRT  THRU 9000-READN-SRT-EXIT.
           IF  FS-END-OF-FILE
               GO TO 1999-EXIT
           END-IF.

           ADD  1                  TO WS-RRN.
           MOVE SPACE              TO SFSEL    OF WS-SFL01-FLDS.
           MOVE FOBCODE OF PO-FOBSRT-REC TO SFCODE  OF WS-SFL01-FLDS.
           MOVE FOBDESC OF PO-FOBSRT-REC TO SFDESC  OF WS-SFL01-FLDS.
           PERFORM 8000-WRITE-SFL01  THRU 8000-WRITE-EXIT.

           GO TO 1999-LOAD-LOOP.

       1999-EXIT.
            EXIT.
      *****************************************************************
      ***  RETRIEVE\VALIDATE FOB FLDS
      *****************************************************************
       2000-CHECK-FOB.

      ***  READK BY FOB CODE  OR  DESCRIPTION
           IF  WS-FOB-DESC  = SPACE
               PERFORM 9000-READK-PO-FOBCDE  THRU 9000-READK-CDE-EXIT
           ELSE
               PERFORM 9000-READK-PO-FOBDSC  THRU 9000-READK-DSC-EXIT
           END-IF.

           IF  FS-RECORD-NOT-FOUND
               MOVE "E"         TO WS-FOB-ERR
               MOVE SPACE       TO WS-FOB-DESC
           END-IF.

       2000-EXIT.
            EXIT.
      *****************************************************************
      ** DISPLAY SCREEN 1 - LIST FOB'S & ALLOW SELECTION
      *****************************************************************
       8000-DISPLAY-SCREEN-1.

           WRITE DISPLAY-REC  FORMAT "H01"
           END-WRITE.

           IF  WS-RRN1 > ZERO
               SET  SFL-DISPLAY-ON   TO TRUE
           END-IF.

           MOVE WS-TITLE1       TO TITLE1  OF WS-CTL01-FLDS.
           MOVE WS-TITLE2       TO TITLE2  OF WS-CTL01-FLDS.

           MOVE CORR WS-CTL01-FLDS  TO CTL01-O.
           WRITE DISPLAY-REC  FORMAT "CTL01"
                 INDICATORS ARE WS-ALL-INDICATORS
           END-WRITE.


           READ  DISPLAY-FILE  FORMAT "CTL01"
                 INDICATORS ARE WS-ALL-INDICATORS
           END-READ.


       8000-DSP-EXIT.
            EXIT.

      *****************************************************************
      *** CTL01 WRITE CONTROL RECORD
      *****************************************************************
       8000-WRITE-CTL01.

           WRITE DISPLAY-REC  FORMAT "CTL01"
                 INDICATORS ARE WS-ALL-INDICATORS
           END-WRITE.


       8000-WRTCR-EXIT.
            EXIT.
      *****************************************************************
      *** SFL01 READ NEXT MODIFIED RECORD
      *****************************************************************
       8000-READN-SFL01.

           READ SUBFILE DISPLAY-FILE
                NEXT MODIFIED RECORD FORMAT IS "SFL01"
                     INDICATORS ARE WS-ALL-INDICATORS
           END-READ.
           MOVE CORR SFL01          TO WS-SFL01-FLDS.
           MOVE WS-RRN              TO WS-RRN1.

       8000-READN-EXIT.
            EXIT.
      *****************************************************************
      *** SFL01 WRITE SUBFILE RECORD
      *****************************************************************
       8000-WRITE-SFL01.

           MOVE CORR WS-SFL01-FLDS  TO SFL01.
           WRITE SUBFILE DISPLAY-REC  FORMAT "SFL01"
                         INDICATORS ARE WS-ALL-INDICATORS
           END-WRITE.

           MOVE WS-RRN              TO WS-RRN1.

       8000-WRITE-EXIT.
            EXIT.

      *****************************************************************
      *** SFL01 REWRITE SUBFILE RECORD
      *****************************************************************
       8000-REWRT-SFL01.

           MOVE CORR WS-SFL01-FLDS  TO SFL01.
           REWRITE SUBFILE DISPLAY-REC  FORMAT "SFL01"
                         INDICATORS ARE WS-ALL-INDICATORS
           END-REWRITE.

       8000-REWRT-EXIT.
            EXIT.

      *----------------------------------------------------------------
      *
      *            ALL DATABASE FILE I-O'S BELOW THIS POINT
      *
      *----------------------------------------------------------------

      *****************************************************************
      *** START FOB DESC FILE BY SORT CODE\FOBCODE
      *****************************************************************
       9000-START-PO-FOBSRT.

           INITIALIZE  PO-FOBSRT-REC.

           START PO-FOBSRT-FILE
                 KEY IS >= EXTERNALLY-DESCRIBED-KEY
           END-START.

       9000-START-EXIT.
            EXIT.

      *****************************************************************
      *** READ FOB SRT FILE SEQUENTIALLY
      *****************************************************************
       9000-READN-PO-FOBSRT.

           READ  PO-FOBSRT-FILE  NEXT RECORD
           END-READ.

       9000-READN-SRT-EXIT.
            EXIT.

      *****************************************************************
      *** READ FOB CDE FILE BY KEY
      *****************************************************************
       9000-READK-PO-FOBCDE.

           INITIALIZE  PO-FOBCDE-REC.
           MOVE WS-FOB-CODE       TO FOBCODE  OF PO-FOBCDE-REC.

           READ  PO-FOBCDE-FILE
           END-READ.

           IF  FS-GOOD-FILE-IO
               MOVE FOBDESC  OF PO-FOBCDE-REC  TO WS-FOB-DESC
           END-IF.

       9000-READK-CDE-EXIT.
            EXIT.

      *****************************************************************
      *** READ FOB DSC FILE BY KEY
      *****************************************************************
       9000-READK-PO-FOBDSC.

           INITIALIZE  PO-FOBDSC-REC.
           MOVE WS-FOB-DESC       TO FOBDESC  OF PO-FOBDSC-REC.

           READ  PO-FOBDSC-FILE
           END-READ.

           IF  FS-GOOD-FILE-IO
               MOVE FOBCODE  OF PO-FOBDSC-REC  TO WS-FOB-CODE
           END-IF.

       9000-READK-DSC-EXIT.
            EXIT.

      *****************************************************************
      ***              END  OF  SOURCE  MEMBER
      *****************************************************************
