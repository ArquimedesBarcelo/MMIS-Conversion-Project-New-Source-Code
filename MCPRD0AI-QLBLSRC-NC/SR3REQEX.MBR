               VALUE "WAS GENERATED TO FILE (R3REQSDATA) ".
           05  FILLER             PIC X(39)
               VALUE "FOR TRANSMISSION TO SYNERGY VIA SAPCOMM".
           05  FILLER             PIC X(46) VALUE SPACES.

       01  OVRDBF-RQ-CMD.
           05  PIC X(23) VALUE "OVRDBF FILE(R3REQDATA) ".
           05  PIC X(24) VALUE "TOFILE(*LIBL/R3REQDATA) ".
           05  PIC X(09) VALUE "MBR(R3REQ".
           05  OVRDBF-SEQ         PIC 9(5).
           05  PIC X(1)  VALUE ")".

       01  OVRDBF-RQ-LEN          PIC S9(10)V9(5) COMP-3
                                         VALUE 62.

       01  PAGE-CTR               PIC 99.

       01  PLANT-ENTRIES.
           05  FILLER             PIC X(10) VALUE "111N515 AK".
           05  FILLER             PIC X(10) VALUE "284N514CAK".
           05  FILLER             PIC X(10) VALUE "126N501DAK".
           05  FILLER             PIC X(10) VALUE "631N510ECA".
           05  FILLER             PIC X(10) VALUE "281N506FAK".
           05  FILLER             PIC X(10) VALUE "131N502GAK".
           05  FILLER             PIC X(10) VALUE "637N509HAK".
           05  FILLER             PIC X(10) VALUE "211N505KAK".
           05  FILLER             PIC X(10) VALUE "153N508LAK".
           05  FILLER             PIC X(10) VALUE "133N503PAK".
           05  FILLER             PIC X(10) VALUE "285N507TAK".
           05  FILLER             PIC X(10) VALUE "129N504UAK".
           05  FILLER             PIC X(10) VALUE "629N511VCA".

       01  PLANT-TABLE REDEFINES PLANT-ENTRIES.
           05  PLANT-DATA-LINE  OCCURS 13 TIMES  INDEXED BY I.
               10  CSIS-PLT-NO    PIC X(3).
               10  SAP-PLT-NO     PIC X(4).
               10  SAP-PO-PREFIX  PIC X.
               10  SAP-LEGACY-ID  PIC X(2).

       01  PRINT-HDR1.
           05  FILLER       PIC X(6)  VALUE " PAGE ".
           05  PAGE-NO-OUT  PIC ZZZ9  VALUE ZEROS.
           05  FILLER       PIC X(5)  VALUE SPACES.
           05  FILLER       PIC X(21) VALUE "R E Q U I S I T I O N".
           05  FILLER       PIC X(20) VALUE "     R E P O R T    ".
           05  FILLER       PIC X(4)  VALUE SPACES.
           05  PRT-CO       PIC X(3)  VALUE SPACES.
           05  FILLER       PIC X(10) VALUE "     DATE ".
           05  PRT-DATE     PIC X(8)  VALUE SPACES.
           05  FILLER       PIC X(2)  VALUE SPACES.
           05  PRT-TIME     PIC X(8)  VALUE SPACES.
           05  FILLER       PIC X(15) VALUE SPACES.
           05  FILLER       PIC X(8)  VALUE "SR3REQEX".

       01  PRINT-HDR2.
           05  FILLER       PIC X(12) VALUE "   REQ NO   ".
           05  FILLER       PIC X(120) VALUE SPACES.

       01  REQ-ARG                PIC X(12).

       01  RTN-CODE               PIC X.

       01  SAVE-DATE              PIC X(6).

       01  SAVE-SEQ               PIC 9(5).

       01  SAVE-TIME              PIC X(6).

       01  SEND-SEQ               PIC 9(5).

       01  TIME-BUF.
           05  T-HHMMSS           PIC X(6).
           05  FILLER             PIC XX.

