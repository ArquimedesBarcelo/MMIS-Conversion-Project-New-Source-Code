059400         NEXT SENTENCE
059500     ELSE
060900     IF VIEW-LASTKEY = 3
061000         MOVE "Y"                 TO  EOJ-SW
061100         GO TO 62-PDS-X
061200     ELSE
061300     IF VIEW-LASTKEY = 2 OR
061400        VIEW-LASTKEY = 4 OR
061500        VIEW-LASTKEY = 5 OR
061600        VIEW-LASTKEY = 6 OR
061700        VIEW-LASTKEY = 7 OR
              VIEW-LASTKEY = 8
061900*        "* INVALID FUNCTION KEY ENTERED *"
062000         MOVE   9 TO LANG-SETNUM
062100         MOVE  10 TO LANG-MSGNUM
062200         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER  TO  DE2-MSGLINE
062300         MOVE 15  TO  FIELD-NUMBER
062400         PERFORM 4-PGM-ERROR  THRU 4-PGM-ERROR-X
062500         GO TO 62-SHOWFORM-SCREEN-2
062600     ELSE
062700*        ***  SELECT THE APPROPRIATE  'FUNCTION KEY'  ***
062800         MOVE  19 TO LANG-SETNUM
062900         MOVE  13 TO LANG-MSGNUM
063000         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER  TO  DE2-MSGLINE
063100         MOVE 15  TO FIELD-NUMBER
063200         PERFORM  4-PGM-ERROR  THRU  4-PGM-ERROR-X
063300         GO TO  62-SHOWFORM-SCREEN-2.
063400
063500 62-FIELD-EDITS.
           IF DE2-NEW-MONTH-END-DATE = SPACES
061900*        "* NEXT MONTHS CUTOFF DATE IS REQUIRED *"
062000         MOVE  66344 TO CATREAD-MSG-NUMBER
062200         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER  TO  DE2-MSGLINE
062300         MOVE 15  TO  FIELD-NUMBER
062400         PERFORM 4-PGM-ERROR  THRU 4-PGM-ERROR-X
062500         GO TO 62-SHOWFORM-SCREEN-2.
065300
065400 62-EDIT-CUTOFF-DATE.
065500     MOVE 3                       TO  DATE-MODE.
065600     MOVE DE2-NEW-MONTH-END-DATE  TO  DATE-VALIDATE-IN.
065700     CALL "TDATECK2" USING DATE-CHECK-AREA, LANGUAGE-PARMS.
065800     IF DATE-RET-CODE NOT = 0
065900         MOVE DATE-MSG            TO  MESSAGE-BUFFER
066000         MOVE 15                  TO  FIELD-NUMBER
066100         PERFORM 4-PGM-ERROR  THRU  4-PGM-ERROR-X
066200         GO TO 62-SHOWFORM-SCREEN-2
066300     ELSE
066400         MOVE DATE-SLASH-OUT      TO  DE2-NEW-MONTH-VERIFY
066500         MOVE DATE-YMD-OUT        TO  SAVE-CUTOFF-DATE
               IF S-C-D-YY > "70"
                   MOVE "19"            TO  S-C-D-CC
               ELSE
               MOVE "20"                TO  S-C-D-CC.

           MOVE MACCT-MONTH-END-DATE    TO  WORK-DATE-YYMMDD.
           IF W-D-YY > "70"
               MOVE "19"                TO  W-D-CC
           ELSE
           MOVE "20"                    TO  W-D-CC.

066700     IF SAVE-CUTOFF-DATE-CCYYMMDD > WORK-DATE-CCYYMMDD
066800         NEXT SENTENCE
066900     ELSE
