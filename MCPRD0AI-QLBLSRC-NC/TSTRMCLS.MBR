074400        VIEW-LASTKEY = 5 OR
074500        VIEW-LASTKEY = 6 OR
074600        VIEW-LASTKEY = 7 OR
              VIEW-LASTKEY = 8
074800*        "* INVALID FUNCTION KEY ENTERED *"
074900         MOVE   9 TO LANG-SETNUM
075000         MOVE  10 TO LANG-MSGNUM
075100         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER  TO  DE2-MSGLINE
075200         MOVE 14  TO  FIELD-NUMBER
075300         PERFORM 4-PGM-ERROR  THRU  4-PGM-ERROR-X
075400         GO TO 62-SHOWFORM-SCREEN-2B
075500     ELSE
075600*        ***  SELECT THE APPROPRIATE  'FUNCTION KEY'  ***
075700         MOVE  19 TO LANG-SETNUM
075800         MOVE  13 TO LANG-MSGNUM
075900         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER  TO  DE2-MSGLINE
076000         MOVE 14  TO  FIELD-NUMBER
076100         PERFORM  4-PGM-ERROR  THRU  4-PGM-ERROR-X
076200         GO TO  62-SHOWFORM-SCREEN-2B.
076300
       62-GET-BUFFER-2B.
           IF DE2-CONTINUE-RESPONSE = "Y"
               NEXT SENTENCE
           ELSE
               GO TO 62-PROCESS-DATE-SCREEN.

078700 62-UPDATE-NEW-CUTOFF-DATE.
079800     MOVE "MTED" TO MACCT-KEY.
           MOVE MACCT-KEY TO INFOKEY OF MACTINFO-REC-O.
           READ MACTINFO-O INTO BUF-MACCT-INFO
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
080900         MOVE "DBGET MACCT 'MTED'* 62-UNCD" TO BU-DISPLAY-MSG
081000         MOVE MACCT-KEY           TO BU-DISPLAY-FLD (1)
081100         GO TO 2-BLOWUP.
081200
081300     MOVE SAVE-CUTOFF-DATE        TO  MACCT-NEXT-MTH-END-DATE.
           IF COMPANY-SAVE = "129"
               MOVE "070000"            TO  MACCT-NEXT-MTH-END-TIME
           ELSE
081400     MOVE "240000"                TO  MACCT-NEXT-MTH-END-TIME.
           MOVE "Y"                     TO  MACCT-FINCLS-SW.
           REWRITE MACTINFO-REC-O FROM BUF-MACCT-INFO
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
082400         MOVE "DBUPDATE MACCT * 62-UNCD" TO BU-DISPLAY-MSG
082500         MOVE MACCT-KEY           TO BU-DISPLAY-FLD (1)
082600         GO TO 2-BLOWUP.
083600
083700     PERFORM 63-LAUNCH-BATCH-JOB  THRU  63-LBJ-X.
083800
083900 62-PDS-X.
084000     EXIT.
084100
084200
084300 63-LAUNCH-BATCH-JOB.
           CALL "QCMDEXC" USING STRDBRDR-BXFINCLS, DBR-BXFINCLS-PARM2.

086700 63-LBJ-X.
086800     EXIT.
086900
087000 COPY DISPCALL IN COPYLIB.
087100 999-CATREAD.
           IF CATREAD-MSG-NUMBER = ZEROS
               MOVE LANG-SETNUM TO CATREAD-MSG-SET
               MOVE LANG-MSGNUM TO CATREAD-MSG-NUM.
           CALL "CCATREAD" USING CATREAD-PARMS.
           MOVE CATREAD-MSG-TEXT TO MESSAGE-BUFFER.
088700 999-CATREAD-EXIT.
088800     EXIT.
