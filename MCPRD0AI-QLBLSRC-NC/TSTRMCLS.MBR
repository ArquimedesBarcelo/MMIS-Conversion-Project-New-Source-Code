036600*     6 - M A I N                                *
036700*                                                *
036800**************************************************
036900
037000 6-MAIN.
037100     PERFORM 61-PROCESS-OPTION-SCREEN  THRU  61-POS-X.
037200     IF EOJ-SW = "Y"
037300         GO TO 6-M-X.
037400
037500     PERFORM 62-PROCESS-DATE-SCREEN  THRU  62-PDS-X.
037600
037700 6-M-X.
037800     EXIT.
037900
038000
038100 61-PROCESS-OPTION-SCREEN.
038200     MOVE "STRMCLS1"  TO  VIEW-NFNAME.
039500
039600 61-PUT-BUFFER-1.
039700     MOVE SPACES                  TO  SCREEN-1.
039800     MOVE COMPANY-SAVE            TO  DE1-COMPANY.
039900     PERFORM 611-GET-SCREEN-INFO  THRU  611-GSI-X.
040600
040700 61-SHOWFORM-SCREEN-1.
           MOVE SCREEN-1                TO  DISPLAY-REC.
           PERFORM 998-WRITE-SCREEN THRU 998-READ-SCREEN.
           MOVE DISPLAY-REC             TO  SCREEN-1.
041500
041600     IF VIEW-LASTKEY = 1
041700         NEXT SENTENCE
041800     ELSE
043200     IF VIEW-LASTKEY = 3
043300         MOVE "Y"                 TO  EOJ-SW
043400         GO TO 61-POS-X
043500     ELSE
043600     IF VIEW-LASTKEY = 2 OR
043700        VIEW-LASTKEY = 4 OR
043800        VIEW-LASTKEY = 5 OR
043900        VIEW-LASTKEY = 6 OR
044000        VIEW-LASTKEY = 7 OR
              VIEW-LASTKEY = 8
044200*        "* INVALID FUNCTION KEY ENTERED *"
044300         MOVE   9 TO LANG-SETNUM
044400         MOVE  10 TO LANG-MSGNUM
044500         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER  TO  DE1-MSGLINE
               MOVE B"1"            TO  IND(99)
044700         GO TO 61-SHOWFORM-SCREEN-1
044800     ELSE
044900*        ***  SELECT THE APPROPRIATE  'FUNCTION KEY'  ***
045000         MOVE  19 TO LANG-SETNUM
045100         MOVE  13 TO LANG-MSGNUM
045200         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER  TO  DE1-MSGLINE
               MOVE B"1"            TO  IND(99)
045400         GO TO  61-SHOWFORM-SCREEN-1.
047400
047500 61-POS-X.
047600     EXIT.
047700
047800
047900 611-GET-SCREEN-INFO.
048000     MOVE "MTED"                  TO  MACCT-KEY.
           MOVE MACCT-KEY TO INFOKEY OF MACTINFO-REC-I.
           READ MACTINFO-I INTO BUF-MACCT-INFO
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE "GET MACCT-INFO * 611-GSI" TO BU-DISPLAY-MSG
               MOVE MACCT-KEY           TO BU-DISPLAY-FLD (1)
               GO TO 2-BLOWUP.
048700
048800     MOVE 4                         TO  DATE-MODE.
048900     MOVE MACCT-LATEST-CUTOFF-DATE  TO  DATE-VALIDATE-IN.
049000     CALL "TDATECK2" USING DATE-CHECK-AREA, LANGUAGE-PARMS.
049100     MOVE DATE-SLASH-OUT          TO  DE1-DATE-LAST-TC.
049200
049300     MOVE MACCT-LATEST-CUTOFF-TIME  TO  TIME-WORKAREA.
049400     MOVE CORR TIME-WORKAREA      TO  DISPLAY-TIME.
049500     MOVE DISPLAY-TIME            TO  DE1-TIME-LAST-TC.
049600
049700     MOVE MACCT-LAST-MANIFEST     TO  DE1-LAST-MFST-CSAS.
049800
049900     MOVE MACCT-MONTH-END-DATE    TO  DATE-VALIDATE-IN.
050000     CALL "TDATECK2" USING DATE-CHECK-AREA, LANGUAGE-PARMS.
050100     MOVE DATE-SLASH-OUT          TO  DE1-CUTOFF-DATE.
050200
050300**********************************************
050400**   CHECK TO SEE IF AVERAGE COST CALCULATION
050500**   FOR RAW MATERIALS IS COMPLETE
050600**********************************************
050700     IF MACCT-AVG-COST-CALC-SW = SPACES
050800*     "NOT COMPLETE"
050900         MOVE 14  TO  LANG-SETNUM
051000         MOVE 74  TO  LANG-MSGNUM
051100         PERFORM 999-CATREAD  THRU  999-CATREAD-EXIT
051200         MOVE MESSAGE-BUFFER  TO  DE1-AVERAGE-COST-CALC
051300     ELSE
051400*     "COMPLETE"
051500         MOVE 3   TO  LANG-SETNUM
051600         MOVE 164 TO  LANG-MSGNUM
051700         PERFORM 999-CATREAD  THRU  999-CATREAD-EXIT
051800         MOVE MESSAGE-BUFFER  TO  DE1-AVERAGE-COST-CALC.
051900
052000**********************************************
052100**   CHECK TO SEE IF MONTHEND BALANCE DOLLARS
052200**   WRITEOFF IS COMPLETE
052300**********************************************
052400     IF MACCT-BALWOFF-SW = SPACES
052500*     "NOT COMPLETE"
052600         MOVE 14  TO  LANG-SETNUM
052700         MOVE 74  TO  LANG-MSGNUM
052800         PERFORM 999-CATREAD  THRU  999-CATREAD-EXIT
052900         MOVE MESSAGE-BUFFER  TO  DE1-BALANCE-WRITEOFF
053000     ELSE
053100*     "COMPLETE"
053200         MOVE 3   TO  LANG-SETNUM
053300         MOVE 164 TO  LANG-MSGNUM
053400         PERFORM 999-CATREAD  THRU  999-CATREAD-EXIT
053500         MOVE MESSAGE-BUFFER  TO  DE1-BALANCE-WRITEOFF.
053600
053700**********************************************
053800**   CHECK TO SEE IF A SUCCESSFULL LIFO REPORT
053900**   FOR RAW MATERIALS WAS GENERATED
054000**********************************************
054100     IF MACCT-LIFORPT-SW = SPACES
054200*     "NOT COMPLETE"
054300         MOVE 14  TO  LANG-SETNUM
054400         MOVE 74  TO  LANG-MSGNUM
054500         PERFORM 999-CATREAD  THRU  999-CATREAD-EXIT
054600         MOVE MESSAGE-BUFFER  TO  DE1-LIFO-REPORT
054700     ELSE
054800*     "COMPLETE"
054900         MOVE 3   TO  LANG-SETNUM
055000         MOVE 164 TO  LANG-MSGNUM
055100         PERFORM 999-CATREAD  THRU  999-CATREAD-EXIT
055200         MOVE MESSAGE-BUFFER  TO  DE1-LIFO-REPORT.
055300
055400 611-GSI-X.
055500     EXIT.
055600
055700
055800 62-PROCESS-DATE-SCREEN.
055900     MOVE "STRMCLS2"  TO  VIEW-NFNAME.
057200
