                AT END MOVE 15 TO COND-WORD.
           IF FILE-STATUS NOT = "00"
              IF FILE-STATUS = "10" OR "14" OR "46"
                 MOVE 15 TO COND-WORD
              ELSE
                 MOVE 99 TO COND-WORD.
           IF QUOTENUM OF DQUOTEXT-REC-O NOT = QUOTE-ARG
              REWRITE DQUOTEXT-REC-O FROM BUF-DQUOTEXT
              MOVE 15 TO COND-WORD.
           IF END-OF-CHAIN
              GO TO 751-ADD.

           IF V4-DESC (LOOP-X) = DQUOTEXT-DATA
              GO TO 754-UPDATE
           ELSE
              IF V4-DESC (LOOP-X) = SPACES
                 GO TO 752-DELETE
              ELSE
                 GO TO 754-UPDATE.
       751-ADD.
185700*------  CHECK IF A NEW LINE SHOULD BE ADDED AT THE END
