032500*******************************************************************
032600*                     PROCEDURE DIVISION
032700*******************************************************************
032800 PROCEDURE DIVISION USING   BASE,
032900                            PASS-SPOOL,
033000                            VIEW-COMAREA,
033100                            FORMFILE,
033200                            LANGUAGE-PARMS.
033300
033400 00-MAIN.
           OPEN I-O DISPLAY-FILE.
           OPEN INPUT DVENDITM DVENDOR MSTORERM MVALIDUM
                      DVENDITM2 DVENDITM3 DVENDITM4 USAGEFIL
                      MPLTINFO
                      MBUYER DREQITM DREQDESC DQUOTEXT.
           OPEN I-O DVENDITM-O DQUOTEXT-O.
           OPEN EXTEND DVENDITM2-O.
033500     MOVE 1 TO DATE-MODE.
033600     CALL "TDATECK2" USING DATE-CHECK-AREA, LANGUAGE-PARMS.
033700     MOVE DATE-YMD-OUT TO TODAY-DATE.
033800
      *-----  FORMAT DATE WITH CENTURY

           IF TODAY-YEAR > "70"
              MOVE "19" TO TODAY-CENT
           ELSE
              MOVE "20" TO TODAY-CENT.

033900     MOVE 60                    TO LANG-SETNUM.
034000     MOVE 38                    TO LANG-MSGNUM.
034100     PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
034200     MOVE MESSAGE-BUFFER        TO WS-OUT-FOR-BID.
034300     MOVE 39                    TO LANG-MSGNUM.
034400     PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
034500     MOVE MESSAGE-BUFFER        TO WS-NOT-RETURNED.
034600     MOVE 40                    TO LANG-MSGNUM.
034700     PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
034800     MOVE MESSAGE-BUFFER        TO WS-WORKSHEET.
034900     MOVE 41                    TO LANG-MSGNUM.
035000     PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
035100     MOVE MESSAGE-BUFFER        TO WS-CURRENT.
035200     MOVE 42                    TO LANG-MSGNUM.
035300     PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
035400     MOVE MESSAGE-BUFFER        TO WS-EXPIRED.
035500
035600     MOVE SPACES TO MESSAGE-BUFFER.
035700     PERFORM 100-GET-ENTRY   THRU 199-EXIT.
035800
           CLOSE DISPLAY-FILE.
           CLOSE      DVENDITM DVENDOR MSTORERM MVALIDUM
                      DVENDITM2 DVENDITM3 DVENDITM4 USAGEFIL
                      DVENDITM-O DVENDITM2-O MPLTINFO DQUOTEXT-O
                      MBUYER DREQITM DREQDESC DQUOTEXT.
033200
035900 09-EXIT.
            GOBACK.
036000
036100*************************************************************
036200*       READ AND VALIDATE INPUT                             *
036300*************************************************************
036400 100-GET-ENTRY.
036500     MOVE SPACES  TO CODE-ARG, SCREEN-BUFFER, SCREEN2-BUFFER2,
036600                  SV-DATE1, SV-DATE2, SV-DATE4, SQTUPD2-PARMS.
           MOVE 0 TO NO-NEXT, NO-PREV.
           MOVE "000000" TO VIEW-QUOTE.
           MOVE "0000"   TO VIEW-ITEM.
036700     MOVE MAIN-SCREEN TO VIEW-NFNAME.
       150-SHOW-FORM.
           MOVE SCREEN-BUFFER TO DISPLAY-REC.
           WRITE DISPLAY-REC FORMAT IS VIEW-NFNAME
              INDIC ARE SRF-INDICATORS.
           MOVE ALL B"0" TO SRF-INDICATORS.

           READ  DISPLAY-FILE FORMAT IS VIEW-NFNAME
               INDIC ARE SRF-INDICATORS.
           ACCEPT IOFEEDBACK FROM I-O-FEEDBACK-AREA.
           MOVE ALL B"0" TO SRF-INDICATORS.
           MOVE DISPLAY-REC TO SCREEN-BUFFER.

      *------ A BAD STATUS MAY MEAN USER TURNED OFF TERMINAL.
      *------ IF SO, SIMULATE THE F3 KEY TO EXIT PROGRAM.
           IF DISPLAY-STATUS NOT = "00"
               MOVE 3 TO VIEW-LASTKEY
           ELSE
               MOVE FUNCTION-NUM TO VIEW-LASTKEY.
035800
035900     IF VIEW-LASTKEY EQUAL 3
036000        GO TO 199-EXIT.
036100
036200     IF VIEW-LASTKEY EQUAL 1 OR
036300        VIEW-LASTKEY EQUAL 2 OR
036400        VIEW-LASTKEY EQUAL 8 OR
036500        VIEW-LASTKEY EQUAL 4 OR
036600        VIEW-LASTKEY EQUAL 7 OR
036700        VIEW-LASTKEY EQUAL 6
              MOVE 9 TO LANG-SETNUM
              MOVE 10 TO LANG-MSGNUM
036800        PERFORM 940-VSETERROR THRU 949-EXIT
036900        GO TO 150-SHOW-FORM.
039200
      *-----  IF QUOTE NUMBER NOT ENTERED, THE SCREEN WILL RETURN
      *-----  SPACES FOR THE QUOTE NUMBER DUE TO NUMERIC EDIT.  IN
      *-----  THIS CASE, MOVE ZEROS TO SCREEN FIELD TO SIGNIFY NO ENTRY

           IF VIEW-QUOTE = SPACES
              MOVE "000000" TO VIEW-QUOTE.

      *-----  CHECK TO SEE THAT AT LEAST ONE OPTION HAS BEEN SELECTED

           IF  (VIEW-QUOTE = "000000")
           AND (VIEW-CORPCODE = SPACES)
           AND (VIEW-VENDOR   = SPACES)
           AND (VIEW-REQ      = SPACES)
           AND (VIEW-X        = SPACES)
           AND (VIEW-NC-DESC  = SPACES)
      *** YOU MUST ENTER ONE OF THE SELECTION CRITERIA
              MOVE 157 TO LANG-MSGNUM
              MOVE 66  TO LANG-SETNUM
              MOVE B"1" TO IND (02)
              MOVE B"1" TO IND (05)
              MOVE B"1" TO IND (03)
              MOVE B"1" TO IND (04)
              MOVE B"1" TO IND (07)
              MOVE 1    TO FIELD-NUMBER
              PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
              PERFORM 940-VSETERROR THRU 949-EXIT
              GO TO 150-SHOW-FORM.

      *-----  IF CHANGE QUOTE DEFAULTS OR NON-CODED DESCRIPTION
      *-----  SELECTED, QUOTE NUMBER MUST BE ENTERED

           IF (VIEW-NC-DESC > SPACES OR VIEW-X > SPACES)
               IF VIEW-QUOTE = "000000"
      *** QUOTE NUMBER MUST BE ENTERED
                  MOVE 24 TO LANG-MSGNUM
                  MOVE 17 TO LANG-SETNUM
                  MOVE B"1" TO IND(04)
                  MOVE B"1" TO IND(07)
                  MOVE 1  TO FIELD-NUMBER
                  PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                  PERFORM 940-VSETERROR THRU 949-EXIT
                  GO TO 150-SHOW-FORM.

039900     MOVE VIEW-QUOTE       TO QUOTE-ARG-NUM.
040000     MOVE VIEW-CORPCODE    TO CODE-ARG.
040100     MOVE VIEW-VENDOR      TO VENDOR-ARG.
040200     MOVE VIEW-REQ         TO REQ-ARG.

      ***********************************************************
      *  MOVE ZERO TO COND-WORD TO AVOID  A BLOW-UP IN THE CASE *
      *  WHERE FILE-STATUS IS '00' AND SO COND-WORD IS NOT SET. *
      *  THIS CAUSES A BLOW-UP IF COND-WORD WAS PREVIOUSLY SET  *
      *  TO A NON-ZERO VALUE SUCH AS END-OF-CHAIN.              *
      ***********************************************************
           MOVE ZERO TO COND-WORD.
040300
040400*----------  VALIDATE QUOTE NUMBER
040500     IF VIEW-QUOTE  = "000000"
              GO TO 152-VENDOR.
           MOVE 0 TO COND-WORD.
           MOVE VIEW-QUOTE TO QUOTENUM OF DVENDITM-REC3.
           START DVENDITM3 KEY = QUOTENUM OF DVENDITM-REC3
               INVALID KEY MOVE 17 TO COND-WORD.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
                   MOVE 17 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.
038200     IF NOT GOOD-CALL
040900*** QUOTE DOES NOT EXIST
041000        MOVE 08 TO LANG-MSGNUM
041100        MOVE 17 TO LANG-SETNUM
041200        PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
041300        PERFORM 940-VSETERROR THRU 949-EXIT
041400        GO TO 150-SHOW-FORM.
041500
       152-VENDOR.
041600*----------  VALIDATE VENDOR CODE
039100     IF VIEW-VENDOR = SPACES
              GO TO 153-CORPCODE.
      *-----  CALL ALT KEY SUB-PGM TO GET ALT KEY IF ONE EXISTS
           MOVE VIEW-VENDOR TO ALT-KEY-ARG.
           CALL "TALTVENK" USING RET-CODE-TALTVENK,
                                 BASE-TALTVENK,
                                 STATUS-AREA,
                                 ALT-KEY-ARG,
                                 ALT-VEND-CODE.
           IF RET-CODE-TALTVENK NOT EQUAL "00"
              MOVE "TALTVENK ERROR 152-V" TO BU-DISPLAY-MSG
              PERFORM 990-BLOWUP THRU 999-EXIT.
           MOVE ZEROS TO COND-WORD.
           MOVE ALT-VEND-CODE   TO VIEW-VENDOR VENDOR-ARG.
039200     MOVE VIEW-VENDOR TO VENCDE OF DVENDOR-REC.
039300     START DVENDOR KEY = VENCDE OF DVENDOR-REC
               INVALID KEY MOVE 17 TO COND-WORD.
           IF FILE-STATUS NOT = "00"
              IF FILE-STATUS-1 = "2"
                 MOVE 17 TO COND-WORD
              ELSE
                 MOVE 99 TO COND-WORD.
042000     IF NO-ENTRY
042100*** VENDOR CODE DOES NOT EXIST
042200        MOVE 03 TO LANG-MSGNUM
042300        MOVE 22 TO LANG-SETNUM
042400        PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
042500        PERFORM 940-VSETERROR THRU 949-EXIT
042600        GO TO 150-SHOW-FORM.
042700
       153-CORPCODE.
040200     IF VIEW-CORPCODE = SPACES
              GO TO 154-QUOTE.
040300     MOVE VIEW-CORPCODE                  TO CODE-ARG.
           MOVE CODE-ARG TO CORPCDE OF MSTORERM-REC
           START MSTORERM KEY = CORPCDE OF MSTORERM-REC
              INVALID KEY MOVE 17 TO COND-WORD.
           IF FILE-STATUS NOT = "00"
              IF FILE-STATUS-1 = "2"
                 MOVE 17 TO COND-WORD
              ELSE
                 MOVE 99 TO COND-WORD.
040400*----------  VALIDATE CORPORATE CODE IF ENTERED
040700     IF NO-ENTRY
040800*** CODE DOES NOT EXIST
040900           MOVE 23 TO LANG-MSGNUM
041000           MOVE  3 TO LANG-SETNUM
041100           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
041200           PERFORM 940-VSETERROR THRU 949-EXIT
041300           GO TO 150-SHOW-FORM
041400      ELSE
041500           IF NOT GOOD-CALL
041600              MOVE "DBGET MSTORERM SQUOTUPD 153" TO BU-DISPLAY-MSG
041700              PERFORM 990-BLOWUP THRU 999-EXIT.
041800
044700 154-QUOTE.
044500     IF VIEW-ITEM NOT = "0000"
044600        MOVE "NON-STR" TO VIEW-CORPCODE.

044410     IF VIEW-NC-DESC = "X"
             IF VIEW-CORPCODE = "NON-STR"
044420        PERFORM 700-NONCODED-DESC THRU 799-EXIT
044421        IF LASTREC-READ = ZEROES
044422*** DESCRIPTION DOES NOT EXIST OR IS ON A REQUISITION
044423           MOVE 18 TO LANG-MSGNUM
044424           MOVE  4 TO LANG-SETNUM
044425           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
044426           PERFORM 940-VSETERROR THRU 949-EXIT
044427           GO TO 150-SHOW-FORM
044428         ELSE
044430           GO TO 100-GET-ENTRY.

044800     IF VIEW-QUOTE NOT = "000000"
044900       IF VIEW-CORPCODE NOT = SPACES
045000          MOVE 2 TO LOOK-FOR
045100       ELSE
045200          IF VIEW-REQ NOT = SPACES
045300             MOVE 8 TO LOOK-FOR
045400          ELSE
045500             MOVE 1 TO LOOK-FOR
045600     ELSE
045700       IF VIEW-VENDOR NOT = SPACES
045800          IF VIEW-CORPCODE NOT = SPACES
045900             MOVE 4 TO LOOK-FOR
046000          ELSE
046100             IF VIEW-REQ NOT = SPACES
046200                MOVE 9 TO LOOK-FOR
046300             ELSE
046400                MOVE 3 TO LOOK-FOR
046500       ELSE
046600           IF VIEW-REQ NOT = SPACES
046700              MOVE 7 TO LOOK-FOR
046800           ELSE
046900             MOVE 5 TO LOOK-FOR.
047000
047100     IF VIEW-X = "X"
047200        MOVE 6 TO LOOK-FOR.
047300     MOVE SPACES TO MESSAGE-BUFFER.
047400     MOVE 0 TO WHICH-TIME.
047500     IF QUOTE-ONLY
047600        PERFORM 200-GET-QUOTE THRU 299-EXIT
047700        GO TO 170-AFTER-DATA.
047800     IF QUOTE-AND-CODE
047900        MOVE 1 TO WHICH-TIME
048000        PERFORM 200-GET-QUOTE THRU 299-EXIT
048100        GO TO 170-AFTER-DATA.
048200
048300     IF QUOTE-AND-REQ
048400        MOVE 2 TO WHICH-TIME
048500        PERFORM 200-GET-QUOTE THRU 299-EXIT
048600        GO TO 170-AFTER-DATA.
048700
048800     IF VENDOR-ONLY
048900        PERFORM 300-GET-VENDOR THRU 399-EXIT
049000        GO TO 170-AFTER-DATA.
049100
049200     IF VENDOR-AND-CODE
049300        MOVE 1 TO WHICH-TIME
049400        PERFORM 300-GET-VENDOR THRU 399-EXIT
049500        GO TO 170-AFTER-DATA.
049600
049700     IF VENDOR-AND-REQ
049800        MOVE 2 TO WHICH-TIME
049900        PERFORM 300-GET-VENDOR THRU 399-EXIT
050000        GO TO 170-AFTER-DATA.
050100
050200     IF CODE-ONLY OR REQ-ONLY
050300        PERFORM 400-GET-CODE THRU 499-EXIT
050400        GO TO 170-AFTER-DATA.
050500
050600     IF UPDATE-DEFAULTS
050700        PERFORM 200-GET-QUOTE THRU 299-EXIT
050800        PERFORM 660-UPDATE-DEFAULTS THRU 669-EXIT
050900        IF SAVE-VIEW-LASTKEY = 8 OR 1
051000           MOVE 1 TO LOOK-FOR
      *----------  DON'T SKIP FIRST RECORD THAT WAS ALREADY READ
                 PERFORM 850-BACK-QUOTE
051100           PERFORM 200-GET-QUOTE THRU 299-EXIT
051200           GO TO 170-AFTER-DATA
051300        ELSE
051400           IF SAVE-VIEW-LASTKEY = 2 OR 7
051500              GO TO 100-GET-ENTRY
051600           ELSE
051700              GO TO 199-EXIT.
051800        GO TO 100-GET-ENTRY.
051900
052000 170-AFTER-DATA.
052100     IF MESSAGE-BUFFER NOT = SPACES
052200        GO TO 150-SHOW-FORM.
052300     MOVE 60                    TO LANG-SETNUM.
052400     MOVE 43                    TO LANG-MSGNUM.
052500     PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
052600     MOVE MESSAGE-BUFFER        TO V2-TITLE.
052700     MOVE SPACES TO MESSAGE-BUFFER.
052800     PERFORM 500-GET-ITEM-DATA THRU 599-EXIT.
052900     IF VIEW-LASTKEY = 7
053000        GO TO 100-GET-ENTRY.
053100     IF VIEW-LASTKEY = 3
053200        GO TO 199-EXIT.
053300
053400     IF MESSAGE-BUFFER NOT = SPACES
053500        GO TO 150-SHOW-FORM.
053600
053700     GO TO 100-GET-ENTRY.
053800 199-EXIT.  EXIT.
053900
051100 200-GET-QUOTE.
053100     MOVE SPACES                     TO MESSAGE-BUFFER.
053200     MOVE ZEROES                     TO V2-ITEM-NO.
053300 210-GET-ITEMS.
           MOVE 0 TO COND-WORD.
           READ DVENDITM3 NEXT INTO BUF-DVENDITM
               AT END MOVE 15 TO COND-WORD.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   MOVE 15 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.
           IF QUOTENUM OF DVENDITM-REC3  NOT = QUOTE-ARG
               MOVE 15 TO COND-WORD.
053600     IF END-OF-CHAIN
053700        IF FIRST-TIME-CODE OR FIRST-TIME-REQ
053800******** CODE DOES NOT EXIST ON THIS QUOTE
053900         MOVE 17 TO LANG-SETNUM
054000         MOVE 15 TO LANG-MSGNUM
054100         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
054200         PERFORM 940-VSETERROR THRU 949-EXIT
054300         GO TO 299-EXIT
054400        ELSE
054500******* QUOTE HAS NO ITEMS
054600          MOVE 17 TO LANG-SETNUM
054700          MOVE 09 TO LANG-MSGNUM
054800          PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
054900          PERFORM 940-VSETERROR THRU 949-EXIT
055000          GO TO 299-EXIT.
055100     IF NOT GOOD-CALL
055200        MOVE "DBGET DVENDITM 210 SQUOTUPD" TO BU-DISPLAY-MSG
055300        PERFORM 990-BLOWUP THRU 999-EXIT.
055400
055500     IF FIRST-TIME-CODE
055600        IF VEN-ITM-CORPCODE = VIEW-CORPCODE
               IF VEN-NONCODED-ITEM = VIEW-ITEM
055700          IF VEN-QUOTE-FLAG = "Q"
055800           NEXT SENTENCE
055900          ELSE
                 GO TO 210-GET-ITEMS
               ELSE
056000           GO TO 210-GET-ITEMS
056100        ELSE
056200           GO TO 210-GET-ITEMS.
056300
056400     IF FIRST-TIME-REQ
056500        IF VEN-REQ = VIEW-REQ
056600          IF VEN-QUOTE-FLAG = "Q"
056700           NEXT SENTENCE
056800          ELSE
056900           GO TO 210-GET-ITEMS
057000        ELSE
057100           GO TO 210-GET-ITEMS.
057200
            ACCEPT IOFEEDBACK FROM I-O-FEEDBACK-AREA.
            MOVE IO-REL-NO TO RELATIVE-KEY.
057300 299-EXIT.  EXIT.
057400
057500 300-GET-VENDOR.
           MOVE 0 TO COND-WORD.
           MOVE VENDOR-ARG TO VENCDE OF DVENDITM-REC.
           START DVENDITM KEY = VENCDE OF DVENDITM-REC
               INVALID KEY MOVE 17 TO COND-WORD.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
                   MOVE 17 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.
057800     IF NO-ENTRY
057900******* VENDOR IS NOT LINKED TO ANY CODES
058000          MOVE 22 TO LANG-SETNUM
058100          MOVE 04 TO LANG-MSGNUM
058200          PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
058300          PERFORM 940-VSETERROR THRU 949-EXIT
058400          GO TO 399-EXIT.
058500     IF NOT GOOD-CALL
058600        MOVE "DBFIND DVENDITM 330 SQUOTUPD" TO BU-DISPLAY-MSG
058700        PERFORM 990-BLOWUP THRU 999-EXIT.
058800
059600     MOVE ZEROES TO V2-ITEM-NO.
059700 310-GET-ITEMS.
           MOVE 0 TO COND-WORD.
           READ DVENDITM NEXT INTO BUF-DVENDITM
               AT END MOVE 15 TO COND-WORD.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   MOVE 15 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.
           IF VENCDE OF DVENDOR-REC NOT = VENDOR-ARG
               MOVE 15 TO COND-WORD.
060000     IF END-OF-CHAIN
060100        IF FIRST-TIME-CODE OR FIRST-TIME-REQ
060200******** CODE DOES NOT EXIST WITH VENDOR ON QUOTE
060300         MOVE  3 TO LANG-SETNUM
060400         MOVE 157 TO LANG-MSGNUM
060500         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
060600         PERFORM 940-VSETERROR THRU 949-EXIT
060700         GO TO 399-EXIT
060800        ELSE
060900******* VENDOR IS NOT LINKED TO ANY CODES
061000          MOVE 22 TO LANG-SETNUM
061100          MOVE 04 TO LANG-MSGNUM
061200          PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
061300          PERFORM 940-VSETERROR THRU 949-EXIT
061400          GO TO 399-EXIT.
061500     IF NOT GOOD-CALL
061600        MOVE "DBGET DVENDITM 310 SQUOTUPD" TO BU-DISPLAY-MSG
061700        PERFORM 990-BLOWUP THRU 999-EXIT.
061800
061900     IF FIRST-TIME-CODE
062000        IF VEN-ITM-CORPCODE = VIEW-CORPCODE
062100          IF VEN-QUOTE-FLAG = "Q"
062200           NEXT SENTENCE
062300          ELSE
062400            GO TO 310-GET-ITEMS
062500        ELSE
062600           GO TO 310-GET-ITEMS.
062700
062800     IF FIRST-TIME-REQ
062900        IF VEN-REQ = VIEW-REQ
063000          IF VEN-QUOTE-FLAG = "Q"
063100           NEXT SENTENCE
063200          ELSE
063300            GO TO 310-GET-ITEMS
063400        ELSE
063500           GO TO 310-GET-ITEMS.
063600      MOVE VEN-QUOTE-NUM TO QUOTE-ARG.
            ACCEPT IOFEEDBACK FROM I-O-FEEDBACK-AREA.
            MOVE IO-REL-NO TO RELATIVE-KEY.
063700 399-EXIT.  EXIT.
063800
063900 400-GET-CODE.
064000     IF REQ-ONLY
064100       PERFORM 470-FIND-REQ
064300     ELSE
