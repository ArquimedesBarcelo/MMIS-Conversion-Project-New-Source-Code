           COPY OVRPFDATA      IN COPYLIB.

           COPY CCHKOBJ        IN COPYLIB.

           COPY DBSTAT         IN COPYLIB.

           COPY CDESC          IN COPYLIB.

           COPY DVENDOR        IN COPYLIB.

           COPY DVENDORH       IN COPYLIB.

           COPY KVENDOR        IN COPYLIB.

           COPY MALTVEN        IN COPYLIB.

           COPY TBLOWUP        IN COPYLIB.

           COPY DRCVTRAK       IN COPYLIB.

           COPY DRCVTRAKH      IN COPYLIB.

           COPY MPLTINFO       IN COPYLIB.

       01  DBPARAMETERS.
           COPY DBPARMS        IN COPYLIB.

       01  MESSAGE-DATA.
           COPY ERRORLIN       IN COPYLIB.

       PROCEDURE DIVISION.
       INITIALIZATION-SECTION  SECTION 01.
       INITIALIZATION.
           MOVE SPACES         TO PO-ITM-SAVE
                                  PO-ITM-COMP
                                  VENDOR-CODE-TABLE.
           ACCEPT CURDATE-BUFFER FROM DATE.
           ACCEPT TIME-BUFFER  FROM TIME.
           MOVE 20             TO CC-BUFFER.
           IF YY-BUFFER > 70
               MOVE 19         TO CC-BUFFER.
           MOVE MM-BUFFER      TO DH-MM.
           MOVE DD-BUFFER      TO DH-DD.
           MOVE YY-BUFFER      TO DH-YY.
           MOVE "/"            TO SLASH1 SLASH2.
           MOVE CUR-TIME       TO P-TIME.
           MOVE DATE-HOLD      TO P-DATE.

           OPEN I-O            RCV-TRACKING.
           IF FILE-STAT NOT = "00"
               MOVE SPACES     TO MESSAGE-BUFFER
               MOVE "OPEN ERROR, RCV-TRACKING/INIT.        FILE-STAT ="
                               TO MSG-TEXT
               MOVE FILE-STAT  TO MSG-FLD
               DISPLAY MESSAGE-BUFFER
               GO TO END-OF-JOB.

           OPEN INPUT          RCV-TRACKING-HIST.
           IF FILE-STAT NOT = "00"
               MOVE SPACES     TO MESSAGE-BUFFER
               MOVE "OPEN ERROR, RCV-TRACKING-HIST/INIT.   FILE-STAT ="
                               TO MSG-TEXT
               MOVE FILE-STAT  TO MSG-FLD
               DISPLAY MESSAGE-BUFFER
               GO TO END-OF-JOB.

           OPEN INPUT          RCVTRK-FILE.
           IF FILE-STAT NOT = "00"
               MOVE SPACES     TO MESSAGE-BUFFER
               MOVE "OPEN ERROR, RCVTRK-FILE/INIT.         FILE-STAT ="
                               TO MSG-TEXT
               MOVE FILE-STAT  TO MSG-FLD
               DISPLAY MESSAGE-BUFFER
               GO TO END-OF-JOB.

           OPEN INPUT          DVENDOR
           IF FILE-STAT NOT = "00"
               MOVE SPACES     TO MESSAGE-BUFFER
               MOVE "OPEN ERROR, DVENDOR/INIT.             FILE-STAT ="
                               TO MSG-TEXT
               MOVE FILE-STAT  TO MSG-FLD
               DISPLAY MESSAGE-BUFFER
               GO TO END-OF-JOB.

           OPEN INPUT          DVENDORH.
           IF FILE-STAT NOT = "00"
               MOVE SPACES     TO MESSAGE-BUFFER
               MOVE "OPEN ERROR, DVENDORH/INIT.            FILE-STAT ="
                               TO MSG-TEXT
               MOVE FILE-STAT  TO MSG-FLD
               DISPLAY MESSAGE-BUFFER
               GO TO END-OF-JOB.

           OPEN INPUT          VENDOR-NAME.
           IF FILE-STAT NOT = "00"
               MOVE SPACES     TO MESSAGE-BUFFER
               MOVE "OPEN ERROR, VENDOR-NAME/INIT.         FILE-STAT ="
                               TO MSG-TEXT
               MOVE FILE-STAT  TO MSG-FLD
               DISPLAY MESSAGE-BUFFER
               GO TO END-OF-JOB.

           OPEN INPUT          VENDOR-ALTNAME.
           IF FILE-STAT NOT = "00"
               MOVE SPACES     TO MESSAGE-BUFFER
               MOVE "OPEN ERROR, VENDOR-ALTNAME/INIT.      FILE-STAT ="
                               TO MSG-TEXT
               MOVE FILE-STAT  TO MSG-FLD
               DISPLAY MESSAGE-BUFFER
               GO TO END-OF-JOB.

      *------ MOVE ISO DOCUMENT # TO HEADING.
           OPEN INPUT MPLTINFO-I.
           MOVE SPACES TO P-DOC.
           MOVE "ISO " TO PLT-ARG.
           MOVE PLT-ARG TO PLTINFOKEY OF MPLTINFO-I-REC.
           READ MPLTINFO-I INTO BUF-MPLTINFO
              INVALID KEY MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT = "00"
               MOVE ISO-DOC-NUM TO P-DOC.

           MOVE 1              TO ARG-NO.
           MOVE SPACES         TO PASSED-SELECTION-DATA.
           READ RCVTRK-FILE    INTO PASSED-SELECTION-DATA
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT = "23"
               PERFORM PRINT-HEADINGS
               MOVE ALL "*"    TO PRINT-REC
               WRITE PRINT-REC AFTER ADVANCING 4
               MOVE SPACES     TO PRINT-REC
               STRING "RCVTRK-FILE (MCFPCSRCVT) NOT FOUND  FILE-STAT = "
                   FILE-STAT   DELIMITED BY SPACES
                               INTO PRINT-REC
               WRITE PRINT-REC AFTER ADVANCING 1
               MOVE ALL "*"    TO PRINT-REC
               WRITE PRINT-REC AFTER ADVANCING 1
               GO TO END-OF-JOB
           ELSE
           IF FILE-STAT NOT = "00"
               PERFORM PRINT-HEADINGS
               MOVE ALL "*"    TO PRINT-REC
               WRITE PRINT-REC AFTER ADVANCING 4
               MOVE SPACES     TO PRINT-REC
               STRING "READ FAILED ON RCVTRK-FILE  FILE-STAT = "
                   FILE-STAT   DELIMITED BY SPACES
                               INTO PRINT-REC
               WRITE PRINT-REC AFTER ADVANCING 1
               MOVE ALL "*"    TO PRINT-REC
               WRITE PRINT-REC AFTER ADVANCING 1
               GO TO END-OF-JOB.

           IF AUTORPT
               OPEN OUTPUT     PRINT-FILE
               GO TO MAIN-FUNCTIONS.

           ACCEPT HD-ROUTE-DATA.
           MOVE HD-SPOOLER-NUMBER   TO OVRPRTF-TOFILE-NUM.
      **** MOVE 0              TO OVRPRTF-TOFILE-NUM.
           COPY OVRPFCALL      IN COPYLIB.
           OPEN OUTPUT         PRINT-FILE.

       MAIN-FUNCTIONS.
           CALL "CLRCVTRKR".
           MOVE ZEROS          TO SELECTION-SWITCHES.
           MOVE  0             TO PAGE-CTR ACT-KEY.
           MOVE "Y"            TO PAGE-SKIP.
           MOVE 60             TO LINE-CTR.
           MOVE  1             TO ADV-CTR.

           IF AUTORPT
               MOVE SPACES     TO PASSED-SELECTION-DATA
               MOVE  3         TO CODE-SW
               MOVE "N"        TO PAGE-SKIP
               MOVE "A"        TO AUTO-MANUAL
               GO TO SORT-FUNCTIONS.

       EDIT-FUNCTIONS.
           IF VC-FRST NOT = SPACES
               MOVE  1         TO CODE-SW.

           IF VC-LAST NOT = SPACES
               MOVE  2         TO CODE-SW.

           IF VC-FRST = "*ALL"
               MOVE  3         TO CODE-SW.

           IF CODE-SW > 0
               MOVE SPACES     TO VEND-NAMES.

           IF VN-LAST NOT = SPACES
               MOVE  2         TO NAME-SW
               PERFORM VENDOR-LOOKUP THRU VL-EXIT.

           IF VN-FRST NOT = SPACES
               MOVE  1         TO NAME-SW
               PERFORM VENDOR-LOOKUP THRU VL-EXIT.

           IF S-DATE NOT = SPACES
               MOVE  1         TO DATE-SW.

           IF E-DATE NOT = SPACES
               MOVE  2         TO DATE-SW.

           IF PO-FRST NOT = SPACES
               MOVE  1         TO PO-SW.

           IF PO-LAST NOT = SPACES
               MOVE  2         TO PO-SW.

       SORT-FUNCTIONS.
           SORT SORT-FILE      ASCENDING KEY
                               SORT-VEN-NAME
                               SORT-KEY
                               SORT-MOD
                               SORT-CORPCODE
               INPUT PROCEDURE SORT-RCV-RECORDS
              OUTPUT PROCEDURE SORT-TRK-RECORDS.

           OPEN INPUT          OUT-FILE.

           IF MANUAL
               PERFORM PRINT-SELECTIONS.

           IF ACT-KEY = 0
               PERFORM PRINT-HEADINGS.

           MOVE  0             TO ACT-KEY.

       READ-LOOP.
           ADD 1               TO ACT-KEY.
           READ OUT-FILE       INVALID KEY
               GO TO END-OF-JOB.

           IF LINE-CTR > 54
               PERFORM PRINT-HEADINGS.

           MOVE  SPACES          TO  DETAIL-REC-C.
           MOVE  OUT-PO          TO                PO-COMP.
           MOVE  OUT-PO-10       TO  PUR-ORD.
           MOVE  OUT-PO-3        TO  PUR-RCVR.
           MOVE  OUT-PO-ITM      TO  PUR-ITM       POI-COMP.
           MOVE  OUT-VEN-NAME    TO  VEND-NAME.
           MOVE  OUT-CORPCODE    TO  CORPCODE.

           MOVE  SPACES          TO  KEY-MOD.
           STRING                OUT-KEYWORD
                                 DELIMITED BY SPACES
                                 ", "
                                 DELIMITED BY SIZE
                                 OUT-MODIFIER
                                 DELIMITED BY SPACES
                                 INTO KEY-MOD.

           MOVE  OUT-QTY-EXP     TO  QTY-EXP.
           MOVE  OUT-EXP-YY      TO  DH-YY.
           MOVE  OUT-EXP-MM      TO  DH-MM.
           MOVE  OUT-EXP-DD      TO  DH-DD.
           MOVE  DATE-HOLD       TO  EXP-DATE.
           MOVE  OUT-DAYS-EARLY  TO  DAYS-EARLY.
           MOVE  OUT-DAYS-LATE   TO  DAYS-LATE.
           MOVE  OUT-CARR-CODE   TO  CARRIER-CODE.
           MOVE  OUT-DEL-YY      TO  DH-YY.
           MOVE  OUT-DEL-MM      TO  DH-MM.
           MOVE  OUT-DEL-DD      TO  DH-DD.
           MOVE  DATE-HOLD       TO  DEL-DATE.
           MOVE  OUT-QTY-DEL     TO  QTY-DEL.
           IF OUT-QTY-DEL = 0.0
               MOVE  SPACES      TO  QTY-DEL-X.
           MOVE  OUT-RCVR-NO     TO  RCVR-NO.
           MOVE  OUT-CORR-ACT    TO  CORR-ACTION.
           IF OUT-E-L-CNT > 0
               MOVE  OUT-E-L-CNT TO  E-L-CNT.
           MOVE  OUT-E-L         TO  E-L.

           IF PO-ITM-COMP NOT = PO-ITM-SAVE
               MOVE  OUT-PO      TO PO-SAVE
               MOVE  OUT-PO-ITM  TO POI-SAVE
               IF LINE-CTR > 54
                   PERFORM PRINT-HEADINGS
               END-IF
               MOVE ALL "-"      TO PRINT-REC
               WRITE PRINT-REC   AFTER ADVANCING ADV-CTR
               MOVE DETAIL-REC-A TO PRINT-REC
               WRITE PRINT-REC   AFTER ADVANCING ADV-CTR
               MOVE DETAIL-REC-B TO PRINT-REC
               WRITE PRINT-REC   AFTER ADVANCING ADV-CTR
               ADD 3             TO LINE-CTR.

           MOVE DETAIL-REC-C     TO PRINT-REC.
           WRITE PRINT-REC       AFTER ADVANCING ADV-CTR.
           ADD 1                 TO LINE-CTR.

           IF OUT-EXPD-CARR NOT = SPACE
               MOVE EXPD-CARR-REC TO PRINT-REC
               WRITE PRINT-REC   AFTER ADVANCING ADV-CTR
               ADD 1             TO LINE-CTR.

           GO TO READ-LOOP.

       PRINT-HEADINGS.
           MOVE "PAGE: "       TO PAGE-T.
           ADD  1              TO PAGE-CTR.
           MOVE PAGE-CTR       TO PAGENO.
           MOVE HEADING-DT-TM  TO PRINT-REC.
           IF PAGE-SKIP = "Y"
               WRITE PRINT-REC AFTER ADVANCING NEW-PAGE
               MOVE ALL "="    TO PRINT-REC
           ELSE
               MOVE "Y"        TO PAGE-SKIP
               WRITE PRINT-REC AFTER ADVANCING 0
               MOVE ALL "="    TO PRINT-REC.
           WRITE PRINT-REC     AFTER ADVANCING ADV-CTR.
           MOVE HEAD-TITLE-1   TO PRINT-REC.
           WRITE PRINT-REC     AFTER ADVANCING ADV-CTR.
           MOVE HEAD-TITLE-2   TO PRINT-REC.
           WRITE PRINT-REC     AFTER ADVANCING ADV-CTR.
           MOVE ALL "="        TO PRINT-REC.
           WRITE PRINT-REC     AFTER ADVANCING ADV-CTR.
           MOVE HEADING-A      TO PRINT-REC.
           WRITE PRINT-REC     AFTER ADVANCING ADV-CTR.
           MOVE HEADING-B      TO PRINT-REC.
           WRITE PRINT-REC     AFTER ADVANCING ADV-CTR.
           MOVE  7             TO LINE-CTR.

           IF ACT-KEY = 0
               IF AUTORPT
                   MOVE ALL "-"      TO PRINT-REC
                   WRITE PRINT-REC   AFTER ADVANCING 1
                   MOVE ALL "*"      TO PRINT-REC
                   WRITE PRINT-REC   AFTER ADVANCING 4
                   MOVE SEL-NO-REC-A TO PRINT-REC
                   WRITE PRINT-REC   AFTER ADVANCING 1
                   MOVE ALL "*"      TO PRINT-REC
                   WRITE PRINT-REC   AFTER ADVANCING 1
                   GO TO END-OF-JOB.

      *SRCVTRKR                PRINT DATE:  00/00/00        TIME:  0000
      **************************************************************************
      *       D E L I V E R Y   T R A C K I N G   S Y S T E M   R E P O R T
      **************************************************************************
      *EXPECTED    EXPECTED  EARLY LATE         DELIVERED  DELIVERED     ACTION
      *QUANTITY      DATE    DAYS  DAYS CARRIER   DATE     QUANTITY  RCVR (Y/N)
      **************************************************************************

       PRINT-SELECTIONS.
           MOVE VC-FRST        TO V-CODE-F.
           MOVE VC-LAST        TO V-CODE-T.
           MOVE VN-FRST        TO V-NAME-F.
           MOVE VN-LAST        TO V-NAME-T.

           MOVE S-CC           TO DF-CC.
           MOVE S-YY           TO DF-YY.
           MOVE S-MM           TO DF-MM.
           MOVE S-DD           TO DF-DD.
           MOVE E-CC           TO DT-CC.
           MOVE E-YY           TO DT-YY.
           MOVE E-MM           TO DT-MM.
           MOVE E-DD           TO DT-DD.

           MOVE PO-FRST        TO PO-F.
           MOVE PO-LAST        TO PO-T.

           IF VC-FRST = SPACES MOVE ALL "_" TO V-CODE-F.
           IF VC-LAST = SPACES MOVE ALL "_" TO V-CODE-T.
           IF VN-FRST = SPACES MOVE ALL "_" TO V-NAME-F.
           IF VN-LAST = SPACES MOVE ALL "_" TO V-NAME-T.
           IF S-CC    = SPACES MOVE ALL "_" TO DF-CC.
           IF S-YY    = SPACES MOVE ALL "_" TO DF-YY.
           IF S-MM    = SPACES MOVE ALL "_" TO DF-MM.
           IF S-DD    = SPACES MOVE ALL "_" TO DF-DD.
           IF E-CC    = SPACES MOVE ALL "_" TO DT-CC.
           IF E-YY    = SPACES MOVE ALL "_" TO DT-YY.
           IF E-MM    = SPACES MOVE ALL "_" TO DT-MM.
           IF E-DD    = SPACES MOVE ALL "_" TO DT-DD.
           IF PO-FRST = SPACES MOVE ALL "_" TO PO-F.
           IF PO-LAST = SPACES MOVE ALL "_" TO PO-T.

           MOVE SPACES         TO PAGE-T.
           MOVE HEADING-DT-TM  TO PRINT-REC.
           WRITE PRINT-REC     AFTER ADVANCING ADV-CTR.
           MOVE ALL "="        TO PRINT-REC.
           WRITE PRINT-REC     AFTER ADVANCING ADV-CTR.
           MOVE HEAD-TITLE-1   TO PRINT-REC.
           WRITE PRINT-REC     AFTER ADVANCING ADV-CTR.
           MOVE HEAD-TITLE-2   TO PRINT-REC.
           WRITE PRINT-REC     AFTER ADVANCING ADV-CTR.
           MOVE ALL "="        TO PRINT-REC.
           WRITE PRINT-REC     AFTER ADVANCING ADV-CTR.

           MOVE SEL-A          TO PRINT-REC.
           WRITE PRINT-REC     AFTER ADVANCING 4.
           MOVE ALL "-"        TO PRINT-REC.
           WRITE PRINT-REC     AFTER ADVANCING 1.
           MOVE SEL-B          TO PRINT-REC.
           WRITE PRINT-REC     AFTER ADVANCING 2.
           MOVE SEL-C          TO PRINT-REC.
           WRITE PRINT-REC     AFTER ADVANCING 2.
           MOVE SEL-D          TO PRINT-REC.
           WRITE PRINT-REC     AFTER ADVANCING 2.
           MOVE SEL-E          TO PRINT-REC.
           WRITE PRINT-REC     AFTER ADVANCING 2.
           MOVE SEL-F          TO PRINT-REC.
           WRITE PRINT-REC     AFTER ADVANCING 2.
           IF HISTORY-SW = " "
               MOVE SEL-HN         TO PRINT-REC
               WRITE PRINT-REC     AFTER ADVANCING 3
               MOVE SEL-HU         TO PRINT-REC
               WRITE PRINT-REC     AFTER ADVANCING 1
           ELSE
               MOVE SEL-HA         TO PRINT-REC
               WRITE PRINT-REC     AFTER ADVANCING 3
               MOVE SEL-HU         TO PRINT-REC
               WRITE PRINT-REC     AFTER ADVANCING 1.

           IF ACT-KEY = 0
               IF MANUAL
                   MOVE ALL "*"      TO PRINT-REC
                   WRITE PRINT-REC   AFTER ADVANCING 4
                   MOVE SEL-NO-REC-M TO PRINT-REC
                   WRITE PRINT-REC   AFTER ADVANCING 1
                   MOVE ALL "*"      TO PRINT-REC
                   WRITE PRINT-REC   AFTER ADVANCING 1
                   GO TO END-OF-JOB.

       END-OF-JOB.
           IF AUTORPT
               PERFORM SET-REPORTED-FLAG THRU SET-FLAG-EXIT.

           CLOSE               OUT-FILE.
           CLOSE               PRINT-FILE.
           CLOSE               RCV-TRACKING.
           CLOSE               RCV-TRACKING-HIST.
           CLOSE               RCVTRK-FILE.
           CLOSE               DVENDOR.
           CLOSE               DVENDORH.
           CLOSE               VENDOR-NAME.
           CLOSE               VENDOR-ALTNAME.
           CLOSE               MPLTINFO-I.
           GOBACK.

       SET-REPORTED-FLAG.
           MOVE LOW-VALUES     TO PORCVNO OF RCV-TRACKING
                                  ITEMNO  OF RCV-TRACKING.
           MOVE ZEROES         TO SEQNO   OF RCV-TRACKING.
           START RCV-TRACKING  KEY NOT LESS THAN PORCVNO OF RCV-TRACKING
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT = "23"
               GO TO SET-FLAG-EXIT
           ELSE
           IF FILE-STAT NOT = "00"
               MOVE SPACES     TO MESSAGE-BUFFER
               MOVE "START ERROR, RCV-TRACKING/SET-FLAG    FILE-STAT ="
                               TO MSG-TEXT
               MOVE FILE-STAT  TO MSG-FLD
               DISPLAY MESSAGE-BUFFER
               GO TO END-OF-JOB.

       SET-FLAG-LOOP.
           READ RCV-TRACKING   NEXT INTO BUF-DRCVTRAK
               AT END          MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
               IF FILE-STAT = "10" OR "14" OR "46"
                   GO TO SET-FLAG-EXIT
               ELSE
                   MOVE SPACES TO MESSAGE-BUFFER
                   MOVE
                   "READ ERROR, RCV-TRACKING/SET-FLAG    FILE-STAT ="
                               TO MSG-TEXT
                   MOVE FILE-STAT TO MSG-FLD
                   DISPLAY MESSAGE-BUFFER
                   GO TO END-OF-JOB.

           IF RCVTRAK-ALREADY-REPORTED NOT = SPACE
               GO TO SET-FLAG-LOOP.

      *------------- DON'T SET THE FLAG IF THE RECEIPT HASN'T BEEN
      *------------- ENTERED YET.
           IF RCVTRAK-DLVR-DATE = SPACE
               GO TO SET-FLAG-LOOP.

           MOVE "X"            TO RCVTRAK-ALREADY-REPORTED.

           REWRITE RTRK-REC    FROM BUF-DRCVTRAK
               INVALID KEY
               DISPLAY "  SRCVTRKR, REWRITE FAILED ON RCV-TRACKING"
               DISPLAY "    FILE-STATUS = " FILE-STAT
               GO TO SET-FLAG-EXIT.

           GO TO SET-FLAG-LOOP.

       SET-FLAG-EXIT.          EXIT.

       VENDOR-LOOKUP.
           IF SELALL           GO TO VL-EXIT.

           MOVE 1              TO SUB.
           MOVE VN-FRST        TO TRAK-VEN-NAME
                                  KVENNAME OF VENDOR-NAME.
           MOVE VN-LAST        TO TRAK-VEN-NAME2.
           MOVE TRAK-VEN-ALT   TO VENCALTKEY OF VENDOR-ALTNAME.
           START VENDOR-NAME   KEY NOT LESS THAN KVENNAME OF VENDOR-NAME
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT = "23"
               START VENDOR-ALTNAME KEY NOT LESS THAN
                               VENCALTKEY OF VENDOR-ALTNAME
                   INVALID KEY MOVE FILE-STAT TO FILE-STAT
               END-START
               IF FILE-STAT = "23"
                   GO TO VL-EXIT
               ELSE
               IF FILE-STAT NOT = "00"
                   MOVE SPACES TO MESSAGE-BUFFER
                   MOVE
               "START ERROR, VENDOR-ALTNAME/VENDOR-LOOKUP   FILE-STAT ="
                               TO MSG-TEXT
                   MOVE FILE-STAT TO MSG-FLD
                   DISPLAY MESSAGE-BUFFER
                   GO TO VL-EXIT
               ELSE
                   MOVE NAME-SW TO ALT-SW
                   MOVE 0      TO NAME-SW
                   GO TO VLOOKUP-ALT-LOOP
           ELSE
           IF FILE-STAT NOT = "00"
               MOVE SPACES     TO MESSAGE-BUFFER
               MOVE
               "START ERROR, VENDOR-NAME/VENDOR-LOOKUP      FILE-STAT ="
                               TO MSG-TEXT
               MOVE FILE-STAT  TO MSG-FLD
               DISPLAY MESSAGE-BUFFER
               GO TO VL-EXIT.

       VLOOKUP-NAME-LOOP.
           READ VENDOR-NAME    NEXT INTO BUF-KVENDOR
               AT END          MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT = "10" OR "14" OR "46"
               GO TO VL-EXIT
           ELSE
           IF FILE-STAT NOT = "00"
               MOVE SPACES     TO MESSAGE-BUFFER
               MOVE
               "READ ERROR, VENDOR-NAME/VLOOKUP-NAME-LOOP   FILE-STAT ="
                               TO MSG-TEXT
               MOVE FILE-STAT  TO MSG-FLD
               DISPLAY MESSAGE-BUFFER
               GO TO VL-EXIT.

           IF SELNAME
               IF KVENNAME NOT = TRAK-VEN-NAME
                   GO TO VL-EXIT.

           IF SELNAME-R
               IF KVENNAME = TRAK-VEN-NAME
                   NEXT SENTENCE
               ELSE
               IF KVENNAME > TRAK-VEN-NAME AND
                  KVENNAME < TRAK-VEN-NAME2
                   NEXT SENTENCE
               ELSE
               IF KVENNAME = TRAK-VEN-NAME2
                   NEXT SENTENCE
               ELSE
                   GO TO VLOOKUP-NAME-LOOP.

           IF SELNAME
               MOVE KVENCDE    TO TRAK-VEN-CODE
           ELSE
               MOVE KVENCDE    TO VCODE(SUB)
               ADD 1           TO SUB
               IF SUB > 500
                   GO TO VL-EXIT.

           GO TO VLOOKUP-NAME-LOOP.

       VLOOKUP-ALT-LOOP.
           READ VENDOR-ALTNAME NEXT INTO BUF-MALTVEN
               AT END          MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT = "10" OR "14" OR "46"
               GO TO VL-EXIT
           ELSE
           IF FILE-STAT NOT = "00"
               MOVE SPACES     TO MESSAGE-BUFFER
               MOVE
               "READ ERROR, VENDOR-ALTNAME/VLOOKUP-ALT-LOOP FILE-STAT ="
                               TO MSG-TEXT
               MOVE FILE-STAT  TO MSG-FLD
               DISPLAY MESSAGE-BUFFER
               GO TO VL-EXIT.

           IF SELALT
               IF VENCALTKEY NOT = TRAK-VEN-ALT
                   GO TO VL-EXIT.

           IF SELALT-R
               IF VENCALTKEY = TRAK-VEN-ALT
                   NEXT SENTENCE
               ELSE
               IF VENCALTKEY > TRAK-VEN-ALT AND
                  VENCALTKEY < TRAK-VEN-ALT2
                   NEXT SENTENCE
               ELSE
               IF VENCALTKEY = TRAK-VEN-ALT2
                   NEXT SENTENCE
               ELSE
                   GO TO VLOOKUP-ALT-LOOP.

           IF SELALT
               MOVE KVENCDE    TO TRAK-VEN-CODE
           ELSE
               MOVE KVENCDE    TO VCODE(SUB)
               ADD 1           TO SUB
               IF SUB > 500
                   GO TO VL-EXIT.

           GO TO VLOOKUP-ALT-LOOP.

       VL-EXIT.                EXIT.

       SORT-RCV-RECORDS-SECT   SECTION 02.
       SORT-RCV-RECORDS.
           PERFORM SORT-MAIN   THRU SORT-M-EXIT.

       SORT-MAIN.
           MOVE LOW-VALUES     TO PORCVNO OF RCV-TRACKING
                                  ITEMNO  OF RCV-TRACKING.
           MOVE ZEROES         TO SEQNO   OF RCV-TRACKING.
           START RCV-TRACKING  KEY NOT LESS THAN PORCVNO OF RCV-TRACKING
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT = "23"
               GO TO SORT-MAIN-CONT
           ELSE
           IF FILE-STAT NOT = "00"
               MOVE SPACES     TO MESSAGE-BUFFER
               MOVE "START ERROR, RCV-TRACKING/SORT-MAIN   FILE-STAT ="
                               TO MSG-TEXT
               MOVE FILE-STAT  TO MSG-FLD
               DISPLAY MESSAGE-BUFFER
               GO TO END-OF-JOB.

           PERFORM SORT-DBGET  THRU SORT-DBGET-EXIT.

       SORT-MAIN-CONT.
           IF HISTORY-SW = SPACE
               GO TO SORT-M-EXIT.

           MOVE LOW-VALUES     TO PORCVNO OF RCV-TRACKING-HIST
                                  ITMNO   OF RCV-TRACKING-HIST.
           MOVE ZEROES         TO SEQNO   OF RCV-TRACKING-HIST.
           START RCV-TRACKING-HIST
               KEY NOT LESS THAN PORCVNO OF RCV-TRACKING-HIST
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT = "23"
               GO TO SORT-M-EXIT
           ELSE
           IF FILE-STAT NOT = "00"
               MOVE SPACES     TO MESSAGE-BUFFER
               MOVE "START ERROR, RCV-TRACKING-HIST         FILE-STAT ="
                               TO MSG-TEXT
               MOVE FILE-STAT  TO MSG-FLD
               DISPLAY MESSAGE-BUFFER
               GO TO END-OF-JOB.

           PERFORM SORT-DBGET-H THRU SORT-DBGET-H-EXIT.

       SORT-M-EXIT.            EXIT.

       SORT-DBGET.
           MOVE SPACES         TO SORT-REC.
           READ RCV-TRACKING   NEXT INTO BUF-DRCVTRAK
               AT END          MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
               IF FILE-STAT = "10" OR "14" OR "46"
                   GO TO SORT-DBGET-EXIT
               ELSE
                   MOVE SPACES TO MESSAGE-BUFFER
                   MOVE
                   "READ ERROR, RCV-TRACKING/SORT-MAIN   FILE-STAT ="
                               TO MSG-TEXT
                   MOVE FILE-STAT TO MSG-FLD
                   DISPLAY MESSAGE-BUFFER
                   GO TO END-OF-JOB.

           IF AUTORPT
               IF RCVTRAK-ALREADY-REPORTED NOT = SPACE
                   GO TO SORT-DBGET.

           IF RCVTRAK-DLVR-DATE = SPACES
               GO TO SORT-DBGET.

           IF SELCODE
               IF VC-FRST NOT = RCVTRAK-VEN-CODE
                   GO TO SORT-DBGET.

           IF SELCODE-R
               IF RCVTRAK-VEN-CODE < VC-FRST OR
                  RCVTRAK-VEN-CODE > VC-LAST
                   GO TO SORT-DBGET.

           IF SELNAME OR SELALT
               IF TRAK-VEN-CODE NOT = RCVTRAK-VEN-CODE
                   GO TO SORT-DBGET.

           IF SELNAME-R OR SELALT-R
               MOVE SPACES     TO TRAK-VEN-CODE
               PERFORM VARYING SUB FROM 1 BY 1 UNTIL SUB > 500
                   IF VCODE(SUB) = RCVTRAK-VEN-CODE
                       MOVE VCODE(SUB) TO TRAK-VEN-CODE
                       MOVE 600        TO SUB
                   END-IF
                   IF VCODE(SUB) = SPACES
                       MOVE 600        TO SUB
                   END-IF
               END-PERFORM
               IF TRAK-VEN-CODE = SPACES
                   GO TO SORT-DBGET.

           IF SELPO
               MOVE RCVTRAK-PO-RCV-NO TO TRAK-PO
               IF TRAK-PO-NO NOT = PO-FRST
                   GO TO SORT-DBGET.

           IF SELPO-R
               MOVE RCVTRAK-PO-RCV-NO TO TRAK-PO
               IF TRAK-PO-NO < VC-FRST OR
                  TRAK-PO-NO > VC-LAST
                   GO TO SORT-DBGET.

           IF SELDATE
               IF S-DATE NOT = RCVTRAK-DLVR-DATE
                   GO TO SORT-DBGET.

           IF SELDATE-R
               IF RCVTRAK-DLVR-DATE < S-DATE OR
                  RCVTRAK-DLVR-DATE > E-DATE
                   GO TO SORT-DBGET.

           MOVE RCVTRAK-EXPECT-DATE    TO SORT-EXP-DATE  CS-DATE.
           MOVE RCVTRAK-DLVR-DATE      TO SORT-DEL-DATE  CE-DATE.
           PERFORM CHECK-E-L-COUNT     THRU CHECK-EXIT.

           IF RCVTRAK-EARLY-DAYS < SORT-E-L-CNT AND
              SORT-E-L = "E"
               GO TO SORT-CONT1.

           IF RCVTRAK-LATE-DAYS < SORT-E-L-CNT AND
              SORT-E-L = "L"
               GO TO SORT-CONT1.

           IF RCVTRAK-EXPD-CARR NOT = SPACE
               GO TO SORT-CONT1.

           GO TO SORT-DBGET.

       SORT-CONT1.
           MOVE RCVTRAK-PO-RCV-NO      TO SORT-PO.
           MOVE RCVTRAK-ITEM-NUMBER    TO SORT-PO-ITM.
           MOVE RCVTRAK-VEN-CODE       TO TRAK-VEN-CODE.

           MOVE TRAK-VEN-CODE  TO VENCDE   OF DVENDOR-REC.
           MOVE "00"           TO VENITMNO OF DVENDOR-REC.
           READ DVENDOR        INTO BUF-DVENDOR
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
               MOVE TRAK-VEN-CODE TO SORT-VEN-NAME
               GO TO SORT-GET-HIST-VENDOR
           ELSE
               MOVE VEN-NAME   TO SORT-VEN-NAME.

           GO TO SORT-CONT2.

       SORT-GET-HIST-VENDOR.
           MOVE TRAK-VEN-CODE  TO VENCDE   OF DVENDORH-REC.
           MOVE "00"           TO VENITMNO OF DVENDORH-REC.
           READ DVENDORH       INTO BUF-DVENDOR-H
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
               GO TO SORT-CONT2
           ELSE
               MOVE VENH-NAME  TO SORT-VEN-NAME.

       SORT-CONT2.
           MOVE RCVTRAK-CORP-CODE TO SORT-CORPCODE TRAK-CORP-CODE.
           MOVE "K"            TO CDESC-DESC-OPTION.
           CALL "CDESC" USING  RET-CODE
                               BASE
                               STATUS-AREA
                               BU-DISPLAY-MSG
                               TRAK-CORP-CODE
                               CDESC-DATA.
           IF RET-CODE = "00"
               MOVE CDESC-KWM(1)      TO SORT-KEY-MOD
           ELSE
               MOVE SPACES            TO SORT-KEY-MOD.

           MOVE RCVTRAK-EXPECT-QTY     TO SORT-QTY-EXP.
           MOVE RCVTRAK-EARLY-DAYS     TO SORT-DAYS-EARLY.
           MOVE RCVTRAK-LATE-DAYS      TO SORT-DAYS-LATE.
           MOVE RCVTRAK-CARRIER        TO SORT-CARR-CODE.
           MOVE RCVTRAK-DLVR-QTY       TO SORT-QTY-DEL.
           MOVE RCVTRAK-RCV-RCVR       TO SORT-RCVR-NO.
           MOVE RCVTRAK-ACTION-NEEDED  TO SORT-CORR-ACT.
           MOVE RCVTRAK-EXPD-CARR      TO SORT-EXPD-CARR.
           RELEASE SORT-REC.
           GO TO SORT-DBGET.

       SORT-DBGET-EXIT.        EXIT.

       SORT-DBGET-H.
           MOVE SPACES         TO SORT-REC.
           READ RCV-TRACKING-HIST NEXT INTO BUF-DRCVTRAKH
               AT END          MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
               IF FILE-STAT = "10" OR "14" OR "46"
                   GO TO SORT-DBGET-H-EXIT
               ELSE
                   MOVE SPACES TO MESSAGE-BUFFER
                   MOVE
                   "READ ERROR, RCV-TRACKING-HIST/SORT-MAIN FILE-STAT ="
                               TO MSG-TEXT
                   MOVE FILE-STAT TO MSG-FLD
                   DISPLAY MESSAGE-BUFFER
                   GO TO END-OF-JOB.

           IF RCVTRAKH-DLVR-DATE = SPACES
               GO TO SORT-DBGET-H.

           IF SELCODE
               IF VC-FRST NOT = RCVTRAKH-VEN-CODE
                   GO TO SORT-DBGET-H.

           IF SELCODE-R
               IF RCVTRAKH-VEN-CODE < VC-FRST OR
                  RCVTRAKH-VEN-CODE > VC-LAST
                   GO TO SORT-DBGET-H.

           IF SELNAME OR SELALT
               IF TRAK-VEN-CODE NOT = RCVTRAKH-VEN-CODE
                   GO TO SORT-DBGET-H.

           IF SELNAME-R OR SELALT-R
               MOVE SPACES     TO TRAK-VEN-CODE
               PERFORM VARYING SUB FROM 1 BY 1 UNTIL SUB > 500
                   IF VCODE(SUB) = RCVTRAKH-VEN-CODE
                       MOVE VCODE(SUB) TO TRAK-VEN-CODE
                       MOVE 600        TO SUB
                   END-IF
                   IF VCODE(SUB) = SPACES
                       MOVE 600        TO SUB
                   END-IF
               END-PERFORM
               IF TRAK-VEN-CODE = SPACES
                   GO TO SORT-DBGET-H.

           IF SELPO
               MOVE RCVTRAKH-PO-RCV-NO TO TRAK-PO-H
               IF TRAK-PO-NO-H NOT = PO-FRST
                   GO TO SORT-DBGET-H.

           IF SELPO-R
               MOVE RCVTRAKH-PO-RCV-NO TO TRAK-PO-H
               IF TRAK-PO-NO-H < VC-FRST OR
                  TRAK-PO-NO-H > VC-LAST
                   GO TO SORT-DBGET-H.

           IF SELDATE
               IF S-DATE NOT = RCVTRAKH-DLVR-DATE
                   GO TO SORT-DBGET-H.

           IF SELDATE-R
               IF RCVTRAKH-DLVR-DATE < S-DATE OR
                  RCVTRAKH-DLVR-DATE > E-DATE
                   GO TO SORT-DBGET-H.

      ******** FIXED PROBLEM OF BINARY DATE IN HISTORY FIELD.
      **** MOVE RCVTRAKH-EXPECT-DATE    TO SORT-EXP-DATE  CS-DATE.
           MOVE RCVTRAKH-EXPECT-DATE    TO FORMAT-DATE.
           MOVE FORMAT-DATE             TO SORT-EXP-DATE  CS-DATE.
           MOVE RCVTRAKH-DLVR-DATE      TO SORT-DEL-DATE  CE-DATE.
           PERFORM CHECK-E-L-COUNT     THRU CHECK-EXIT.

           IF RCVTRAKH-EARLY-DAYS < SORT-E-L-CNT AND
              SORT-E-L = "E"
               GO TO SORT-CONT1-H.

           IF RCVTRAKH-LATE-DAYS < SORT-E-L-CNT AND
              SORT-E-L = "L"
               GO TO SORT-CONT1-H.

           IF RCVTRAKH-EXPD-CARR NOT = SPACE
               GO TO SORT-CONT1-H.

           GO TO SORT-DBGET-H.

       SORT-CONT1-H.
           MOVE RCVTRAKH-PO-RCV-NO      TO SORT-PO.
           MOVE RCVTRAKH-ITEM-NUMBER    TO SORT-PO-ITM.
           MOVE RCVTRAKH-VEN-CODE       TO TRAK-VEN-CODE.

           MOVE TRAK-VEN-CODE  TO VENCDE   OF DVENDOR-REC.
           MOVE "00"           TO VENITMNO OF DVENDOR-REC.
           READ DVENDOR        INTO BUF-DVENDOR
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
               MOVE TRAK-VEN-CODE TO SORT-VEN-NAME
               GO TO SORT-GET-HIST-VENDOR-H
           ELSE
               MOVE VEN-NAME   TO SORT-VEN-NAME.

           GO TO SORT-CONT2-H.

       SORT-GET-HIST-VENDOR-H.
           MOVE TRAK-VEN-CODE  TO VENCDE   OF DVENDORH-REC.
           MOVE "00"           TO VENITMNO OF DVENDORH-REC.
           READ DVENDORH       INTO BUF-DVENDOR-H
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
               GO TO SORT-CONT2-H
           ELSE
               MOVE VENH-NAME  TO SORT-VEN-NAME.

       SORT-CONT2-H.
           MOVE RCVTRAKH-CORP-CODE TO SORT-CORPCODE TRAK-CORP-CODE.
           MOVE "K"            TO CDESC-DESC-OPTION.
           CALL "CDESC" USING  RET-CODE
                               BASE
                               STATUS-AREA
                               BU-DISPLAY-MSG
                               TRAK-CORP-CODE
                               CDESC-DATA.
           IF RET-CODE = "00"
               MOVE CDESC-KWM(1)      TO SORT-KEY-MOD
           ELSE
               MOVE SPACES            TO SORT-KEY-MOD.

           MOVE RCVTRAKH-EXPECT-QTY     TO SORT-QTY-EXP.
           MOVE RCVTRAKH-EARLY-DAYS     TO SORT-DAYS-EARLY.
           MOVE RCVTRAKH-LATE-DAYS      TO SORT-DAYS-LATE.
           MOVE RCVTRAKH-CARRIER        TO SORT-CARR-CODE.
           MOVE RCVTRAKH-DLVR-QTY       TO SORT-QTY-DEL.
           MOVE RCVTRAKH-RCV-RCVR       TO SORT-RCVR-NO.
           MOVE RCVTRAKH-ACTION-NEEDED  TO SORT-CORR-ACT.
           MOVE RCVTRAKH-EXPD-CARR      TO SORT-EXPD-CARR.
           RELEASE SORT-REC.
           GO TO SORT-DBGET-H.

       SORT-DBGET-H-EXIT.        EXIT.

       CHECK-E-L-COUNT.
           MOVE CS-DATE        TO GREG-DATE.
           MOVE SPACES         TO JUL-DATE D-PARM L-PARM.
           CALL "JULGREG"      USING
                               GREG-DATE
                               JUL-DATE
                               D-PARM
                               L-PARM.
           MOVE JULIAN-DATE    TO JUL-EXP.

           MOVE CE-DATE        TO GREG-DATE.
           MOVE SPACES         TO JUL-DATE D-PARM L-PARM.
           CALL "JULGREG"      USING
                               GREG-DATE
                               JUL-DATE
                               D-PARM
                               L-PARM.
           MOVE JULIAN-DATE    TO JUL-DEL.

           IF JE-YEAR = JD-YEAR
               GO TO CHECK-CONT.

           IF JE-YEAR > JD-YEAR
               MOVE JE-DAY     TO JUL-SIGN
               PERFORM UNTIL   JE-YEAR = JD-YEAR
                   ADD 365     TO JUL-SIGN
                   SUBTRACT 1  FROM JE-YEAR
               END-PERFORM
               MOVE JUL-SIGN   TO JE-DAY
               GO TO CHECK-CONT.

           IF JD-YEAR > JE-YEAR
               MOVE JD-DAY     TO JUL-SIGN
               PERFORM UNTIL   JE-YEAR = JD-YEAR
                   ADD 365     TO JUL-SIGN
                   SUBTRACT 1  FROM JD-YEAR
               END-PERFORM
               MOVE JUL-SIGN   TO JD-DAY.

       CHECK-CONT.
           IF JUL-EXP > JUL-DEL
               COMPUTE JUL-E-L = JUL-EXP - JUL-DEL
               MOVE JUL-E-L    TO SORT-E-L-CNT
               MOVE "E"        TO SORT-E-L
               GO TO CHECK-EXIT.

           IF JUL-DEL > JUL-EXP
               COMPUTE JUL-E-L = JUL-DEL - JUL-EXP
               MOVE JUL-E-L    TO SORT-E-L-CNT
               MOVE "L"        TO SORT-E-L
               GO TO CHECK-EXIT.

           MOVE 0              TO SORT-E-L-CNT.
           MOVE " "            TO SORT-E-L.

       CHECK-EXIT.             EXIT.

       SORT-TRK-RECORDS-SECT   SECTION 03.
       SORT-TRK-RECORDS.
           OPEN OUTPUT         OUT-FILE.
           PERFORM SORT-READ-LOOP THRU SORT-RL-EXIT.
           CLOSE               OUT-FILE.

       SORT-READ-LOOP.
           RETURN SORT-FILE    AT END
               GO TO SORT-RL-EXIT.
           ADD 1               TO ACT-KEY.
           MOVE SORT-REC       TO OUT-REC.
           WRITE OUT-REC       INVALID KEY
               DISPLAY "WRITE OUT-FILE ERR"
               GO TO SORT-RL-EXIT.
           GO TO SORT-READ-LOOP.

       SORT-RL-EXIT.           EXIT.

