       IDENTIFICATION DIVISION.
       PROGRAM-ID.             SRCVTRKR.
       AUTHOR.                 W. ROXBURY.
       INSTALLATION.           GOODYEAR TIRE & RUBBER COMPANY.

      *C
      *C  10/24/97   CA YODER
      *C    THE PROGRAM WAS NOT ACCEPTING THE ROUTE PARAMETERS, AND
      *C    SO THE JOB WAS TRYING TO EXECUTE THEM AS A COMMAND.
      *C    ADDED AN "ACCEPT" STATEMENT AND CHANGED THE PROGRAM TO
      *C    USE THE ROUTE DATA TO OVERRIDE TO THE CORRECT PRINTER FILE.
      *C
      *C  11/06/97   CA YODER
      *C    PROGRAM WAS NOT HANDLING THE BINARY EXPECT DATE FIELD IN
      *C    THE HISTORY DATABASE CORRECTLY.  FIXED THE PROBLEM.
      *C
      *C  06/22/98   CA YODER
      *C    WHEN SET-REPORTED-FLAG WAS BEING PERFORMED, IT WAS SETTING
      *C    RCVTRAK-ALREADY-REPORTED FLAG TO "X" IN ALL RECORDS THAT
      *C    DID NOT ALREADY HAVE AN "X" IN IT.  CHANGED THE LOGIC TO
      *C    ONLY SET THE FLAG IF IT'S THE AUTO REPORT AND IF THE
      *C    RCVTRAK-DLVR-DATE > SPACES.
      *C
      *C  10/26/00    CA YODER
      *C    ADDED PLACE FOR ISO DOCUMENT NUMBER IN HEADING ON REPORT.
      *C    THE DOCUMENT NUMBER IS LOCATED IN MPLTINFO, KEY=ISO.
      *C

       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.
       SOURCE-COMPUTER.        IBM-AS400.
       OBJECT-COMPUTER.        IBM-AS400.
       SPECIAL-NAMES.          C01              IS NEW-PAGE
                               I-O-FEEDBACK     IS I-O-FEEDBACK-AREA
                               REQUESTOR        IS WORK-STATION
                               SYSTEM-CONSOLE   IS CONSOLE
                               LOCAL-DATA       IS LOCAL-DATA-AREA.

       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT RCVTRK-FILE
                  ASSIGN       TO DATABASE-MCFPCSRCVT
                  ORGANIZATION IS RELATIVE
                  ACCESS MODE  IS RANDOM
                  RELATIVE KEY IS ARG-NO
                  FILE STATUS  IS FILE-STAT.

           SELECT RCV-TRACKING
                  ASSIGN       TO DATABASE-MCFLCS6402
                  ORGANIZATION IS INDEXED
                  ACCESS MODE  IS DYNAMIC
                  RECORD KEY   IS EXTERNALLY-DESCRIBED-KEY
                               WITH DUPLICATES
                  FILE STATUS  IS FILE-STAT.

           SELECT RCV-TRACKING-HIST
                  ASSIGN       TO DATABASE-MCFLST6402
                  ORGANIZATION IS INDEXED
                  ACCESS MODE  IS DYNAMIC
                  RECORD KEY   IS EXTERNALLY-DESCRIBED-KEY
                               WITH DUPLICATES
                  FILE STATUS  IS FILE-STAT.

           SELECT DVENDOR
                  ASSIGN       TO DATABASE-MCFLCS0701
                  ORGANIZATION IS INDEXED
                  ACCESS MODE  IS DYNAMIC
                  RECORD KEY   IS EXTERNALLY-DESCRIBED-KEY
                               WITH DUPLICATES
                  FILE STATUS  IS FILE-STAT.

           SELECT DVENDORH
                  ASSIGN       TO DATABASE-MCFLST0201
                  ORGANIZATION IS INDEXED
                  ACCESS MODE  IS DYNAMIC
                  RECORD KEY   IS EXTERNALLY-DESCRIBED-KEY
                               WITH DUPLICATES
                  FILE STATUS  IS FILE-STAT.

           SELECT VENDOR-NAME
                  ASSIGN       TO DATABASE-MCFLCSVEND
                  ORGANIZATION IS INDEXED
                  ACCESS MODE  IS DYNAMIC
                  RECORD KEY   IS EXTERNALLY-DESCRIBED-KEY
                               WITH DUPLICATES
                  FILE STATUS  IS FILE-STAT.

           SELECT VENDOR-ALTNAME
                  ASSIGN       TO DATABASE-MCFLCS5801
                  ORGANIZATION IS INDEXED
                  ACCESS MODE  IS DYNAMIC
                  RECORD KEY   IS EXTERNALLY-DESCRIBED-KEY
                  FILE STATUS  IS FILE-STAT.

           SELECT MPLTINFO-I
                  ASSIGN       TO DATABASE-MCFLCS0501
                  ORGANIZATION IS INDEXED
                  ACCESS MODE  IS DYNAMIC
                  RECORD KEY   IS EXTERNALLY-DESCRIBED-KEY
                  FILE STATUS  IS FILE-STAT.

           SELECT PRINT-FILE
                  ASSIGN       TO PRINTER-MCPRT.

           SELECT OUT-FILE
                  ASSIGN       TO DISK-TRCVTRK
                  ORGANIZATION IS RELATIVE
                  ACCESS MODE  IS DYNAMIC
                  RELATIVE KEY IS ACT-KEY
                  FILE STATUS  IS FILE-STAT.

           SELECT SORT-FILE
                  ASSIGN       TO DISK-SORTFILE.

       DATA DIVISION.
       FILE SECTION.
       FD  RCVTRK-FILE
           RECORD CONTAINS     152 CHARACTERS
           LABEL RECORDS       ARE OMITTED
           DATA RECORD         IS RCVTRK-REC.
       01  RCVTRK-REC.
           COPY DDS-ALL-FORMATS OF MCFPCSRCVT.

       FD  RCV-TRACKING
           LABEL RECORDS       ARE STANDARD.
       01  RTRK-REC.
           COPY DDS-ALL-FORMATS OF MCFLCS6402.

       FD  RCV-TRACKING-HIST
           LABEL RECORDS       ARE STANDARD.
       01  RTRK-HIST-REC.
           COPY DDS-ALL-FORMATS OF MCFLST6402.

       FD  DVENDOR
           LABEL RECORDS       ARE STANDARD.
       01  DVENDOR-REC.
           COPY DDS-MCRPCS0700 OF MCFLCS0701.

       FD  DVENDORH
           LABEL RECORDS       ARE STANDARD.
       01  DVENDORH-REC.
           COPY DDS-MCRPST0200 OF MCFLST0201.

       FD  VENDOR-NAME
           LABEL RECORDS       ARE STANDARD.
       01  VENDNAME-REC.
           COPY DDS-ALL-FORMATS OF MCFLCSVEND.

       FD  VENDOR-ALTNAME
           LABEL RECORDS       ARE STANDARD.
       01  VENDALT-REC.
           COPY DDS-ALL-FORMATS OF MCFLCS5801.

       FD  MPLTINFO-I
           LABEL               RECORDS ARE STANDARD.
       01  MPLTINFO-I-REC.
           COPY DDS-ALL-FORMATS OF MCFLCS0501.

       FD  PRINT-FILE RECORD   CONTAINS 80 CHARACTERS
           LABEL RECORDS       ARE OMITTED
           DATA RECORD         IS PRINT-REC.
       01  PRINT-REC           PIC X(80).

       FD  OUT-FILE RECORD     CONTAINS 174 CHARACTERS
           LABEL RECORDS       ARE OMITTED
           DATA RECORD         IS OUT-REC.
       01  OUT-REC.
           05  OUT-PO.
               10  OUT-PO-1    PIC X(01).
               10  OUT-PO-10   PIC X(10).
               10  OUT-PO-3    PIC X(03).
           05  OUT-PO-ITM      PIC X(06).
           05  OUT-VEN-NAME    PIC X(44).
           05  OUT-CORPCODE    PIC X(08).
           05  OUT-KEYWORD     PIC X(20).
           05  OUT-MODIFIER    PIC X(20).
           05  OUT-QTY-EXP     PIC 9(8)V9(4).
           05  OUT-EXP-DATE.
               10  OUT-EXP-CC  PIC XX.
               10  OUT-EXP-YY  PIC XX.
               10  OUT-EXP-MM  PIC XX.
               10  OUT-EXP-DD  PIC XX.
           05  OUT-DAYS-EARLY  PIC 9(04).
           05  OUT-DAYS-LATE   PIC 9(04).
           05  OUT-CARR-CODE   PIC X(04).
           05  OUT-DEL-DATE.
               10  OUT-DEL-CC  PIC XX.
               10  OUT-DEL-YY  PIC XX.
               10  OUT-DEL-MM  PIC XX.
               10  OUT-DEL-DD  PIC XX.
           05  OUT-QTY-DEL     PIC 9(8)V9(4).
           05  OUT-RCVR-NO     PIC X(03).
           05  OUT-CORR-ACT    PIC X(01).
           05  OUT-E-L-CNT     PIC 9(04).
           05  OUT-E-L         PIC X(01).
           05  OUT-EXPD-CARR   PIC X(01).

       SD  SORT-FILE RECORD    CONTAINS 174 CHARACTERS
           DATA RECORD         IS SORT-REC.
       01  SORT-REC.
           05  SORT-PO.
               10  SORT-PO-1   PIC X(01).
               10  SORT-PO-10  PIC X(10).
               10  SORT-PO-3   PIC X(03).
           05  SORT-PO-ITM     PIC X(06).
           05  SORT-VEN-NAME   PIC X(44).
           05  SORT-CORPCODE   PIC X(08).
           05  SORT-KEY-MOD.
               10  SORT-KEY    PIC X(20).
               10  SORT-MOD    PIC X(20).
           05  SORT-QTY-EXP    PIC 9(8)V9(4).
           05  SORT-EXP-DATE   PIC X(08).
           05  SORT-DAYS-EARLY PIC 9(04).
           05  SORT-DAYS-LATE  PIC 9(04).
           05  SORT-CARR-CODE  PIC X(04).
           05  SORT-DEL-DATE   PIC X(08).
           05  SORT-QTY-DEL    PIC 9(8)V9(4).
           05  SORT-RCVR-NO    PIC X(03).
           05  SORT-CORR-ACT   PIC X(01).
           05  SORT-E-L-CNT    PIC 9(04).
           05  SORT-E-L        PIC X(01).
           05  SORT-EXPD-CARR  PIC X(01).

