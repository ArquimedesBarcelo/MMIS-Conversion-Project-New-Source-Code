000200 IDENTIFICATION DIVISION.
000300 PROGRAM-ID.    TPDISP2.
000400 INSTALLATION.  GOODYEAR.
000500*REMARKS.
000600*       #########################################################
000700*       # This is the personnel absence information display pro #
000800*       # gram ------------------------------------------------ #
000900*       #########################################################.
      *C
      *C  09/09/96  JEFF BUNGO
      *C   EXPAND DATE FIELDS FOR YEAR 2000 COMPLIANCE.
      *C   INCLUDE CENTURY ON ABS DATE AND INCLUDE
      *C   CENTURY ON THE SORTED FILE.
      *C
001100 ENVIRONMENT DIVISION.
001200 CONFIGURATION SECTION.
001300 SOURCE-COMPUTER.      AS400.
001400 OBJECT-COMPUTER.      AS400.
       SPECIAL-NAMES.      I-O-FEEDBACK IS I-O-FEEDBACK-AREA
                           LOCAL-DATA IS LOCAL-DATA-AREA.
001500 INPUT-OUTPUT SECTION.
001600 FILE-CONTROL.
           SELECT DISPLAY-FILE
               ASSIGN TO WORKSTATION-ZPERSON-SI
               ORGANIZATION IS TRANSACTION
               ACCESS IS SEQUENTIAL
               FILE STATUS IS DSPLY-STATUS
               CONTROL-AREA IS WS-CONTROL.
           SELECT PER-ABSENCE
               ASSIGN TO DATABASE-MCFLMM3101
               ORGANIZATION IS INDEXED
               ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                   WITH DUPLICATES
               FILE STATUS IS PA-STATUS.
           SELECT PERSONNEL-FILE
               ASSIGN TO DATABASE-MCFLMM0301
               ORGANIZATION IS INDEXED
               ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
               FILE STATUS IS PF-STATUS.
001700     SELECT SORT-FILE ASSIGN TO DISK-SORTFILE.
001900 DATA DIVISION.
002100 FILE SECTION.
       FD  DISPLAY-FILE
           LABEL RECORDS ARE OMITTED.
       01  DSPLY-REC                   PIC X(2000).
       FD  PER-ABSENCE
           LABEL RECORDS ARE STANDARD
           DATA RECORD IS PAREC.
       01  PAREC.
           COPY DDS-ALL-FORMATS OF MCFLMM3101.
       FD  PERSONNEL-FILE
           LABEL RECORDS ARE STANDARD
           DATA RECORD IS PFREC.
       01  PFREC.
           COPY DDS-ALL-FORMATS OF MCFLMM0301.
002200 SD  SORT-FILE RECORD CONTAINS 12 CHARACTERS
002300     DATA RECORD IS SORT-REC.
002400 01  SORT-REC.
002500     05  S-CC                     PIC X(2).
002600     05  S-DATE-CN.
               10  S-CENTURY            PIC X(2).
               10  S-DATE.
002700             15  S-YY             PIC X(2).
002800             15  S-MM             PIC X(2).
002900             15  S-DD             PIC X(2).
003000     05  S-HH                     PIC X(2).
003200 WORKING-STORAGE SECTION.
007200 01  ABS-YR                       PIC XX.
007500 01  ARG-KEY                      PIC X(6).
       COPY CATREAD OF COPYLIB.
       COPY CPYIND  OF COPYLIB.
009000 01  CS                           PIC S9(4) COMP-4.
009200 COPY TDATESUB IN COPYLIB.
007700 01  DATE-HEAD                    PIC X(10).
007900 01  END-SW                       PIC X.
008600 01  ERROR-BUFFER                 PIC X(80) VALUE SPACES.
       01  ERROR-SW                     PIC X.
       01  FILE-STATUSES.
           05  DSPLY-STATUS             PIC XX.
           05  PA-STATUS                PIC XX.
           05  PF-STATUS                PIC XX.
       COPY IOFEEDBACK OF COPYLIB.
007800 01  MODIFY-SW                    PIC X.
003400 01  PASSWORD-INFORMATION.
003500     05  NAME-OF-PROGRAM     PIC X(08) VALUE "TPDISP2 ".
003600     05  PROGRAM-TYPE        PIC X(02) VALUE "MA".
003700     05  PROGRAM-RELEASE     PIC X(12) VALUE " E0100010001".
003800     05  PROGRAM-DESCRIPTION.
003900         10  PROG-DESC-A     PIC X(60) VALUE
004000            "PERSONNEL ABSENCE DISPLAY PROGRAM "                 .
004100         10  PROG-DESC-B     PIC X(60) VALUE SPACES.
004300         10  PROG-FUNCTION   PIC X(60) VALUE SPACES.
004500     05  PASSWORD-FLAG       PIC X.
004600 01  PASSWORD-INFORMATION1.
004700     05  NAME-OF-PROGRAM     PIC X(08) VALUE "TPMOD2  ".
004800     05  PROGRAM-TYPE        PIC X(02) VALUE "MA".
004900     05  PROGRAM-RELEASE     PIC X(12) VALUE " C0100010001".
005000     05  PROGRAM-DESCRIPTION.
005100         10  PROG-DESC-A     PIC X(60) VALUE
005200             "PERSONNEL ABSENCE MODIFY PROGRAM "                 .
005300         10  PROG-DESC-B     PIC X(60) VALUE SPACES.
005500         10  PROG-FUNCTION   PIC X(60) VALUE SPACES.
005700     05  PASSWORD-FLAG       PIC X.
005800 01  SCREEN-PRINT-PARMS.
005900     05 PRINTCNTL                 PIC S9(4) COMP VALUE 0.
006000     05 PAGECNTL                  PIC S9(4) COMP VALUE 49.
006100     05 SPOOLFIL-OPEN-SW          PIC X VALUE "N".
006200 01  PASSED-SPOOL-PRT             PIC S9(2) COMP VALUE 0.
009300 01  PER-ABSENCE-DATA.            COPY DPERABS  OF COPYLIB.
008400 01  SAVE-KEY                     PIC S9(4) COMP.
010800 01  SCREEN-TABLES.
010900     05 TABLES OCCURS 3 TIMES.
011000         10 TABL.
011100            15 TAB OCCURS 50 TIMES.
                     20 TCODE           PIC X(2).
                     20 TDATE           PIC X(6).
                     20 THRS            PIC X(2).
008800 01  SUB1                         PIC S9(4) COMP-4.
008900 01  SUB2                         PIC S9(4) COMP-4.
009100 COPY DBSTAT IN COPYLIB.
009400 01  TERM-BUFFER.
009500     05 T-CC                      PIC X(4).
009600     05 T-YR                      PIC XX.
009700     05 T-PAGE                    PIC 9.
009800     05 T-TITLE                   PIC X(78).
009900     05 T-ABSENCE.
010000        10 T-ABSREC OCCURS 50 TIMES.
010100           15 TREC.
010200              20 TR-CODE          PIC X(2).
010300              20 TR-DATE          PIC X(6).
010400              20 TR-HOUR          PIC X(2).
010500              20 TR-HOUR-NUM REDEFINES TR-HOUR
010600                                  PIC 99.
           05  TERM-CMD-LINE            PIC X(79).
           05  TERM-ERR-LINE            PIC X(79).
       01  TRUE-VAL                     PIC 1 VALUE B"1".
007300 01  TT1                          PIC X(15).
007400 01  TT2                          PIC X(15).
       COPY WSCONTROL OF COPYLIB.
011400 LINKAGE SECTION.
011500 01  DBPARAMETERS.                COPY DBPARMS  OF COPYLIB.
011600 COPY VCOMLINK IN COPYLIB.
011700 01  PLT-IDT                      PIC X(4).
011900 01  PER-PERSONNEL.               COPY MPERSONL OF COPYLIB.
012100 PROCEDURE DIVISION USING DBPARAMETERS
012200                          VIEW-COMAREA
012300                          PLT-IDT
012500                          PER-PERSONNEL.
012700 BEGIN-PGM.
           PERFORM 1-HSK.
           PERFORM 6-MAIN THRU 6-MAIN-CONT.
013500 2-EOJ.
           CLOSE DISPLAY-FILE.
           CLOSE PER-ABSENCE.
           CLOSE PERSONNEL-FILE.
           GOBACK.
013600 1-HSK.
           OPEN I-O   DISPLAY-FILE.
           OPEN I-O   PER-ABSENCE.
           OPEN I-O   PERSONNEL-FILE.
012900     CALL "TPWORD" USING PASSWORD-INFORMATION.
013300     IF PASSWORD-FLAG OF PASSWORD-INFORMATION = "N"
013400         GO TO 2-EOJ.
014700     MOVE SPACES TO ERROR-BUFFER.
015300     MOVE SPACES TO TERM-BUFFER.
014400 6-MAIN.
014500     MOVE DATE-FLAG TO DATE-CODE.
014600     MOVE "N" TO MODIFY-SW.
014800     MOVE "FPDISP2" TO VIEW-CFNAME.
015400     MOVE PER-CC-NUM TO T-CC.
015500     MOVE 1 TO T-PAGE.
015600     MOVE 31035 TO CATREAD-MSG-NUMBER.
015800     PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
015900     MOVE ERROR-BUFFER TO TT1.
016000     MOVE SPACES TO ERROR-BUFFER.
016100     MOVE 42043 TO CATREAD-MSG-NUMBER.
016300     PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
016400     MOVE ERROR-BUFFER TO TT2.
016500     STRING TT1 "   " PER-YEAR1 "," PER-YEAR2 "," PER-YEAR3 "   "
016600            TT2 DELIMITED BY SIZE INTO T-TITLE.
           MOVE TERM-BUFFER TO DSPLY-REC.
           PERFORM 99-SCREEN-WRITE.
           PERFORM 98-SCREEN-READ.
           MOVE DSPLY-REC TO TERM-BUFFER.
018900     IF VIEW-LASTKEY = 3 GO TO 2-EOJ.
019000     IF VIEW-LASTKEY NOT = 0 GO TO 6-MAIN.
021100     IF T-YR = PER-YEAR1 OR PER-YEAR2 OR PER-YEAR3
021200         NEXT SENTENCE
021300     ELSE
021400     MOVE 35032 TO CATREAD-MSG-NUMBER
021600     PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
           MOVE ERROR-BUFFER TO TERM-ERR-LINE
           MOVE TRUE-VAL TO INDS (99)
022200     GO TO 6-MAIN.
022400     MOVE SPACES TO SCREEN-TABLES.
022500     IF DATE-FLAG = 1
022600       MOVE 29084 TO CATREAD-MSG-NUMBER
022800       PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
022900       MOVE ERROR-BUFFER TO DATE-HEAD
023000       STRING DATE-HEAD "       "
023100              DATE-HEAD "       "
023200              DATE-HEAD "       "
023300              DATE-HEAD "       "
023400              DATE-HEAD "       "
023500       DELIMITED BY SIZE INTO T-TITLE
023600     ELSE
023700     MOVE 29085 TO CATREAD-MSG-NUMBER
023900     PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
024000     MOVE ERROR-BUFFER TO DATE-HEAD
024100     STRING DATE-HEAD "       "
024200            DATE-HEAD "       "
024300            DATE-HEAD "       "
024400            DATE-HEAD "       "
024500            DATE-HEAD "       "
024600     DELIMITED BY SIZE INTO T-TITLE.
024700     MOVE 33001 TO CATREAD-MSG-NUMBER.
024900     PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
           MOVE ERROR-BUFFER TO TERM-CMD-LINE.
           MOVE TRUE-VAL TO INDS (98).
           MOVE TERM-BUFFER TO DSPLY-REC.
           PERFORM 99-SCREEN-WRITE.
           PERFORM 98A-SCREEN-READ.
           CALL "CLPAUSE2".
026100     SORT SORT-FILE ASCENDING KEY S-DATE
026200                                  S-CC
026300                    INPUT  PROCEDURE 7-INPUT-RECORDS
026400                    OUTPUT PROCEDURE 8-WRITE-RECORDS.
031900     MOVE "FPDISP2A" TO VIEW-CFNAME.
           MOVE 66187 TO CATREAD-MSG-NUMBER.
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
           MOVE ERROR-BUFFER TO TERM-CMD-LINE.
           MOVE SPACES TO ERROR-BUFFER.
031600     MOVE 1 TO CS.
031800     MOVE TABL (CS) TO T-ABSENCE.
           MOVE TERM-BUFFER TO DSPLY-REC.
           PERFORM 99-SCREEN-WRITE.
       6-MAIN-CONT.
033000     PERFORM 98-SCREEN-READ.
           MOVE DSPLY-REC TO TERM-BUFFER.
           MOVE T-ABSENCE TO TABL (CS).
034100     MOVE VIEW-LASTKEY TO SAVE-KEY.
034600     IF SAVE-KEY = 6
034700       IF MODIFY-SW = "Y"
034800           PERFORM 60-DEL-ADD-ABSENCE THRU 60-DEL-ADD-EXIT
                 MOVE SPACES TO ERROR-BUFFER TERM-BUFFER
034900           GO TO 6-MAIN
035000       ELSE
             MOVE SPACES TO ERROR-BUFFER TERM-BUFFER
035100       GO TO 6-MAIN.
036800     IF SAVE-KEY = 3 GO TO 2-EOJ.
037500     IF SAVE-KEY = 1 OR 2 OR 4 OR 5
               NEXT SENTENCE
           ELSE
           MOVE 35126 TO CATREAD-MSG-NUMBER
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
           MOVE ERROR-BUFFER TO TERM-ERR-LINE
           MOVE TRUE-VAL TO INDS (99)
           PERFORM 99-SCREEN-WRITE
           GO TO 6-MAIN-CONT.
037600     IF SAVE-KEY = 1
037700         ADD 1 TO CS
037800         IF CS > 3
037900             SUBTRACT 1 FROM CS
                   PERFORM 99-SCREEN-WRITE
038100             GO TO 6-MAIN-CONT
038200         ELSE
038300         MOVE TABL (CS) TO T-ABSENCE
038400         MOVE CS TO T-PAGE
               MOVE TERM-BUFFER TO DSPLY-REC
               PERFORM 99-SCREEN-WRITE
038500         GO TO 6-MAIN-CONT.
038900
039000     IF SAVE-KEY = 2
039100         SUBTRACT 1 FROM CS
039200         IF CS < 1
039300             ADD 1 TO CS
                   PERFORM 99-SCREEN-WRITE
039500             GO TO 6-MAIN-CONT
039600         ELSE
039700         MOVE TABL (CS) TO T-ABSENCE
039800         MOVE CS TO T-PAGE
               MOVE TERM-BUFFER TO DSPLY-REC
               PERFORM 99-SCREEN-WRITE
039900         GO TO 6-MAIN-CONT.
040300
040400     IF SAVE-KEY = 4
040500         IF MODIFY-SW = "Y"
040600             CALL "TPCONSEC" USING DBPARAMETERS
040700                                   VIEW-COMAREA
040900                                   SCREEN-TABLES
041000                                   T-YR
041100             MOVE TABL (1) TO T-ABSENCE
041200             MOVE 1 TO T-PAGE CS
041300             MOVE "FPDISP2B" TO VIEW-CFNAME
                   MOVE 66202 TO CATREAD-MSG-NUMBER
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE ERROR-BUFFER TO TERM-CMD-LINE
                   MOVE TERM-BUFFER TO DSPLY-REC
                   PERFORM 99-SCREEN-WRITE
041400             GO TO 6-MAIN-CONT
042000         ELSE
               PERFORM 99-SCREEN-WRITE
042100         GO TO 6-MAIN-CONT.
042200
042300********************
042400* VIEW-LASTKEY = 5 *
042500********************
042600     IF MODIFY-SW = "N"
042700         CALL "TPWORD" USING PASSWORD-INFORMATION1
043100         IF PASSWORD-FLAG OF PASSWORD-INFORMATION1 = "N"
043200             GO TO 2-EOJ
043300         ELSE
043400         MOVE "FPDISP2B" TO VIEW-CFNAME
043500         MOVE "Y" TO MODIFY-SW
               MOVE 66202 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE ERROR-BUFFER TO TERM-CMD-LINE
               MOVE TERM-BUFFER TO DSPLY-REC
               PERFORM 99-SCREEN-WRITE
043600         GO TO 6-MAIN-CONT.
           MOVE "N" TO ERROR-SW.
046100     PERFORM 61-EDIT-ABS-DATA THRU 61-E-A-D-E
046200                           VARYING SUB1 FROM 1 BY 1
046300                           UNTIL SUB1 > 50.
046400     IF ERROR-SW = "Y"
047200       GO TO 6-MAIN-CONT.
047300
047400     MOVE T-ABSENCE TO TABL (CS).
           PERFORM 99-SCREEN-WRITE.
047600     GO TO 6-MAIN-CONT.
047700
047800 60-DEL-ADD-ABSENCE.
047900     MOVE 39015 TO CATREAD-MSG-NUMBER.
048100     PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
           MOVE ERROR-BUFFER TO TERM-CMD-LINE.
           MOVE TRUE-VAL TO INDS (98).
           PERFORM 99-SCREEN-WRITE.
           PERFORM 98A-SCREEN-READ.
           CALL "CLPAUSE2".
049200     PERFORM 601-DEL-ABSENCE.
049300     PERFORM 602-ADD-ABSENCE VARYING CS FROM 1 BY 1
049400         UNTIL CS > 3.
049600     IF SCREEN-TABLES = SPACES
049700         NEXT SENTENCE
049800     ELSE
049900     GO TO 60-DEL-ADD-EXIT.
050000     MOVE 0 TO COND-WORD.
050100     MOVE T-CC TO PERCCNUM OF PFREC.
050200     START PERSONNEL-FILE KEY IS = EXTERNALLY-DESCRIBED-KEY
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF PF-STATUS NOT = "00" MOVE 17 TO COND-WORD.
           IF COND-WORD = 17 GO TO 2-EOJ.
050300     READ PERSONNEL-FILE NEXT INTO PER-PERSONNEL
050400         AT END    MOVE 15 TO COND-WORD.
           IF PF-STATUS NOT = "00" MOVE 15 TO COND-WORD.
050500     IF COND-WORD = 15 GO TO 2-EOJ.
050600     IF PER-YEAR1 = T-YR MOVE SPACES TO PER-YEAR1
050700     ELSE
050800     IF PER-YEAR2 = T-YR MOVE SPACES TO PER-YEAR2
050900     ELSE
051000     IF PER-YEAR3 = T-YR MOVE SPACES TO PER-YEAR3.
051100     MOVE 0 TO COND-WORD.
051200     REWRITE PFREC FROM PER-PERSONNEL
051300         INVALID KEY    MOVE 17 TO COND-WORD.
051400     IF COND-WORD = 17 GO TO 2-EOJ.
051700 60-DEL-ADD-EXIT.    EXIT.
051800
051900 601-DEL-ABSENCE.
052100     STRING T-CC T-YR DELIMITED BY SIZE INTO ARG-KEY.
           MOVE 0 TO COND-WORD.
           MOVE ARG-KEY TO PERABSCCYR OF PAREC.
           START PER-ABSENCE KEY IS = EXTERNALLY-DESCRIBED-KEY
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF PA-STATUS NOT = "00" MOVE 17 TO COND-WORD.
053000     IF COND-WORD = 0
053100         PERFORM 69-READ-PER-ABSENCE
053400         IF COND-WORD = 0 OR 15
053500             PERFORM 6010-DEL-ABSENCE-CONT UNTIL COND-WORD = 15.
053900 6010-DEL-ABSENCE-CONT.
054000     MOVE 0 TO COND-WORD.
054100     DELETE PER-ABSENCE RECORD
054200         INVALID KEY    MOVE 17 TO COND-WORD.
           IF PA-STATUS NOT = "00" MOVE 17 TO COND-WORD.
           IF COND-WORD = 17
               NEXT SENTENCE
           ELSE
054300     MOVE 0 TO COND-WORD
054400     PERFORM 69-READ-PER-ABSENCE
054600     IF COND-WORD = 0 OR 15
054700         NEXT SENTENCE
054800     ELSE
054900     GO TO 2-EOJ.
055000 602-ADD-ABSENCE.
055100     PERFORM 6020-ADD-ABSENCE-CONT THRU 6020-A-A-C-E
055200         VARYING SUB1 FROM 1 BY 1 UNTIL SUB1 > 50.
055300 6020-ADD-ABSENCE-CONT.
055400     IF TAB (CS, SUB1) = SPACES GO TO 6020-A-A-C-E.
           MOVE PER-CC-NUM     TO PER-ABS-CC.
           MOVE T-YR           TO PER-ABS-YY.
           MOVE TCODE (CS, SUB1) TO PER-ABS-CODE.
055700     MOVE TDATE (CS, SUB1) TO DATE-VALIDATE-IN.
055800     MOVE 3 TO DATE-MODE.
055900     CALL "TDATECHK" USING DATE-CHECK-AREA.
056000     MOVE DATE-DB TO PER-ABS-DATE.
      *------COMPUTE CENTURY
           IF PER-ABS-DATE-YY > "70"
               MOVE "19" TO PER-ABS-DATE-CC
           ELSE
               MOVE "20" TO PER-ABS-DATE-CC.
           MOVE THRS (CS, SUB1) TO PER-ABS-HRS.
056100     MOVE 0 TO COND-WORD.
056200     WRITE PAREC FROM PER-ABSENCE-DATA
056300         INVALID KEY    MOVE 17 TO COND-WORD.
           IF PA-STATUS NOT = "00" MOVE 17 TO COND-WORD.
056400     IF COND-WORD = 17 GO TO 2-EOJ.
056500 6020-A-A-C-E.    EXIT.
056600
056700 61-EDIT-ABS-DATA.
056800     IF TREC (SUB1) = SPACES
057000         GO TO 61-E-A-D-E.
057300     MOVE TR-CODE (SUB1) TO ARG-KEY.
057400     PERFORM 69-START-PER-ABSENCE.
057700     IF COND-WORD = 17
057800         MOVE "Y" TO ERROR-SW
057900         MOVE 35042 TO CATREAD-MSG-NUMBER
058100         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
058200         MOVE 51 TO SUB1
058300         GO TO 61-E-A-D-E.
058700     IF TR-DATE (SUB1) = SPACES
058800         MOVE "999999" TO TR-DATE (SUB1).
058900     MOVE 3 TO DATE-MODE.
059000     MOVE TR-DATE (SUB1) TO DATE-VALIDATE-IN.
059100     CALL "TDATECHK" USING DATE-CHECK-AREA.
059200     IF DATE-RET-CODE = 1
059300         MOVE 35028 TO CATREAD-MSG-NUMBER
059500         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
059600         MOVE "Y" TO ERROR-SW
059700         MOVE 51 TO SUB1
059800         GO TO 61-E-A-D-E.
059900     IF DATE-DB-YY NOT = T-YR
060000         MOVE 35032 TO CATREAD-MSG-NUMBER
060200         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
060300         MOVE "Y" TO ERROR-SW
060400         MOVE 51 TO SUB1
060500         GO TO 61-E-A-D-E.
060600     IF TR-HOUR (SUB1) NUMERIC
060700         IF TR-HOUR-NUM (SUB1) > 0
060800             IF TR-HOUR-NUM (SUB1) < 25
060900                 NEXT SENTENCE
061000             ELSE
061100             MOVE "Y" TO ERROR-SW
061200         ELSE
061300         MOVE "Y" TO ERROR-SW
061400     ELSE
061500     MOVE "Y" TO ERROR-SW.
061600     IF ERROR-SW = "Y"
061700         MOVE 51 TO SUB1
061800         MOVE 35055 TO CATREAD-MSG-NUMBER
062000         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
062100         GO TO 61-E-A-D-E.
062300 61-E-A-D-E.    EXIT.

       69-START-PER-ABSENCE.
           MOVE 0 TO COND-WORD.
           MOVE ARG-KEY TO PERABSCCYR OF PAREC.
           START PER-ABSENCE KEY IS = EXTERNALLY-DESCRIBED-KEY
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF PA-STATUS NOT = "00" MOVE 17 TO COND-WORD.

       69-READ-PER-ABSENCE.
           MOVE 0 TO COND-WORD.
           READ PER-ABSENCE NEXT INTO PER-ABSENCE-DATA
               AT END    MOVE 15 TO COND-WORD.
           IF PER-ABS-CC-YR NOT = ARG-KEY MOVE 15 TO COND-WORD.
           IF PA-STATUS NOT = "00" MOVE 15 TO COND-WORD.

026500 7-INPUT-RECORDS.
           PERFORM 70-GET-RECORDS THRU 70-GR-EXIT.
       70-GET-RECORDS.
026800     STRING T-CC T-YR DELIMITED BY SIZE INTO ARG-KEY.
026900     PERFORM 69-START-PER-ABSENCE.
027200     IF COND-WORD = 17
027300         NEXT SENTENCE
027400     ELSE
027700     IF COND-WORD = 0
027800         PERFORM 69-READ-PER-ABSENCE
028100         IF COND-WORD = 0 OR 15
028200             PERFORM 701-GET-ABS-DATA UNTIL COND-WORD = 15.
       70-GR-EXIT.    EXIT.
028700 701-GET-ABS-DATA.
           MOVE PER-ABS-CODE TO S-CC.
           MOVE PER-ABS-DATE-CN TO S-DATE-CN.
           MOVE PER-ABS-HRS  TO S-HH.
029000     RELEASE SORT-REC.
029100     PERFORM 69-READ-PER-ABSENCE.

029800 8-WRITE-RECORDS.
029900     MOVE "N" TO END-SW.
030000     MOVE 1 TO SUB1 SUB2.
           PERFORM 8-WR-CONT THRU 8-WR-EXIT.
       8-WR-CONT.
030100     RETURN SORT-FILE AT END MOVE "Y" TO END-SW.
030200     PERFORM 8-LOAD-SCREEN-TABLES UNTIL END-SW = "Y".
       8-WR-EXIT.    EXIT.

030400 8-LOAD-SCREEN-TABLES.
030500     MOVE 4 TO DATE-MODE.
030600     MOVE S-DATE TO DATE-VALIDATE-IN.
030700     CALL "TDATECHK" USING DATE-CHECK-AREA.
030800     MOVE DATE-OUT TO TDATE (SUB1, SUB2).
           MOVE S-CC TO TCODE (SUB1, SUB2).
           MOVE S-HH TO THRS (SUB1, SUB2).
031000     RETURN SORT-FILE AT END MOVE "Y" TO END-SW.
031100     ADD 1 TO SUB2.
031200     IF SUB2 > 50
031300         ADD 1 TO SUB1
031400         MOVE 1 TO SUB2.

       98-SCREEN-READ.
           READ DISPLAY-FILE FORMAT IS VIEW-CFNAME
               INDIC IS INDICS.
           ACCEPT IOFEEDBACK FROM I-O-FEEDBACK-AREA.
           MOVE ALL B"0" TO INDICS.
           IF DSPLY-STATUS NOT = "00"
               MOVE 3 TO VIEW-LASTKEY
           ELSE
           MOVE FUNCTION-NUM TO VIEW-LASTKEY.

       98A-SCREEN-READ.
           READ DISPLAY-FILE TERMINAL IS TERMINAL-ID
               INDIC IS INDICS
                  NO DATA MOVE DSPLY-STATUS TO DSPLY-STATUS.
           MOVE ALL B"0" TO INDICS.

       99-SCREEN-WRITE.
           WRITE DSPLY-REC FORMAT IS VIEW-CFNAME
               INDIC IS INDICS.
           MOVE ALL B"0" TO INDICS.

062500 999-CATREAD.
           MOVE SPACES TO ERROR-BUFFER.
           CALL "CCATREAD" USING CATREAD-PARMS.
           MOVE CATREAD-MSG-TEXT TO ERROR-BUFFER.
063500 999-CATREAD-EXIT.
063600     EXIT.
