           MOVE EMPLOYEE-NUM TO LBR-EMPL-NUM.
           MOVE PER-EMP-NAME TO LBR-EMPL-NAME.
           MOVE PER-CRAFT TO LBR-CRAFT.
           MOVE SPACES TO LBR-HRS.
           MOVE 3 TO DATE-MODE.
           MOVE EMPLOYEE-START-DATE TO DATE-VALIDATE-IN.
           CALL "TDATECHK" USING DATE-CHECK-AREA.
           MOVE DATE-DB TO LBR-START-DATE.
           IF LBR-START-DATE-YY > "70"
               MOVE "19" TO LBR-START-DATE-CC
           ELSE
           MOVE "20" TO LBR-START-DATE-CC.
           MOVE EMPLOYEE-STTM TO LBR-START-TIME.
           MOVE 3 TO DATE-MODE.
           MOVE EMPLOYEE-COMPL-DATE TO DATE-VALIDATE-IN.
           CALL "TDATECHK" USING DATE-CHECK-AREA.
           MOVE DATE-DB TO LBR-COMPL-DATE LBR-DATE.
           IF LBR-COMPL-DATE-YY > "70"
               MOVE "19" TO LBR-COMPL-DATE-CC, LBR-DATE-CC
           ELSE
           MOVE "20" TO LBR-COMPL-DATE-CC, LBR-DATE-CC.
           MOVE EMPLOYEE-COTM TO LBR-COMPL-TIME.
           MOVE 0 TO MIN-DIFF.
           IF DATE-FLAG = 3
               MOVE E-STDT-MD TO GREG-DD
               MOVE E-STDT-DM TO GREG-MM
           ELSE
           MOVE E-STDT-MD TO GREG-MM
           MOVE E-STDT-DM TO GREG-DD.
           MOVE E-STDT-YY TO GREG-YY.
           IF GREG-YY > "70"
               MOVE "19"  TO GREG-CC
           ELSE
           MOVE "20"      TO GREG-CC.
           CALL "JULGREG" USING GREG-DATE, JULIAN-DATE,
                            DAY-DIGIT, LEAP-YEAR-FLAG.
           MOVE JULIAN-DATE-9 TO JUL-START-DATE.
           IF DATE-FLAG = 3
               MOVE E-CODT-MD TO GREG-DD
               MOVE E-CODT-DM TO GREG-MM
           ELSE
           MOVE E-CODT-MD TO GREG-MM
           MOVE E-CODT-DM TO GREG-DD.
           MOVE E-CODT-YY TO GREG-YY.
           IF GREG-YY > "70"
               MOVE "19"  TO GREG-CC
           ELSE
           MOVE "20"      TO GREG-CC.
           CALL "JULGREG" USING GREG-DATE, JULIAN-DATE,
                            DAY-DIGIT, LEAP-YEAR-FLAG.
           MOVE JULIAN-DATE-9 TO JUL-COMP-DATE.
           IF JUL-COMP-DATE < JUL-START-DATE
               MOVE 30015 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE ERROR-BUFFER TO EDIT-ERROR
               MOVE TRUE-VAL TO INDS (99)
               GO TO 62-READ-SCREEN
           ELSE
           IF JUL-COMP-DATE > JUL-START-DATE
               SUBTRACT JUL-START-DATE FROM JUL-COMP-DATE
                   GIVING JUL-WORK-DATE
               IF JUL-WORK-DATE > 1
                   MOVE 35029 TO CATREAD-MSG-NUMBER
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE ERROR-BUFFER TO EDIT-ERROR
                   MOVE TRUE-VAL TO INDS (99)
                   GO TO 62-READ-SCREEN
               ELSE
                   IF TIME-STRT-COMP < 0 AND
                      TIME-END-COMP > -1
                       NEXT SENTENCE
                   ELSE
                   MOVE 35029 TO CATREAD-MSG-NUMBER
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE ERROR-BUFFER TO EDIT-ERROR
                   MOVE TRUE-VAL TO INDS (99)
                   GO TO 62-READ-SCREEN
           ELSE
