      *--- CHECK TO SEE IF MONTH, DAY, AND YEAR ARE NUMERIC.  04/18/1995
           IF E-STDT-MD NOT NUMERIC
               MOVE 35031 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE ERROR-BUFFER TO EDIT-ERROR
               MOVE TRUE-VAL TO INDS (6) INDS (99)
               GO TO 64-READ-SCREEN
           ELSE
           IF E-STDT-DM NOT NUMERIC
               MOVE 35030 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE ERROR-BUFFER TO EDIT-ERROR
               MOVE TRUE-VAL TO INDS (6) INDS (99)
               GO TO 64-READ-SCREEN
           ELSE
           IF E-STDT-YY NOT NUMERIC
               MOVE 35032 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE ERROR-BUFFER TO EDIT-ERROR
               MOVE TRUE-VAL TO INDS (6) INDS (99)
               GO TO 64-READ-SCREEN
           ELSE
           IF DATE-FLAG = 3
               IF E-STDT-MD > 31
                   MOVE 35030 TO CATREAD-MSG-NUMBER
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE ERROR-BUFFER TO EDIT-ERROR
                   MOVE TRUE-VAL TO INDS (6) INDS (99)
                   GO TO 64-READ-SCREEN
               ELSE
               NEXT SENTENCE
           ELSE
           IF E-STDT-MD > 12
               MOVE 35031 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE ERROR-BUFFER TO EDIT-ERROR
               MOVE TRUE-VAL TO INDS (6) INDS (99)
               GO TO 64-READ-SCREEN.
           IF DATE-FLAG = 3
               IF E-STDT-DM > 12
                   MOVE 35031 TO CATREAD-MSG-NUMBER
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE ERROR-BUFFER TO EDIT-ERROR
                   MOVE TRUE-VAL TO INDS (6) INDS (99)
                   GO TO 64-READ-SCREEN
               ELSE
               NEXT SENTENCE
           ELSE
           IF E-STDT-DM > 31
               MOVE 35030 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE ERROR-BUFFER TO EDIT-ERROR
               MOVE TRUE-VAL TO INDS (6) INDS (99)
               GO TO 64-READ-SCREEN.
           IF E-STDT-YY NOT NUMERIC
               MOVE 35032 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE ERROR-BUFFER TO EDIT-ERROR
               MOVE TRUE-VAL TO INDS (6) INDS (99)
               GO TO 64-READ-SCREEN.
      *--- CHECK FOR NUMERIC TIME.      04/18/1995
           IF EMPLOYEE-STTM NOT NUMERIC
               MOVE 46009 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE ERROR-BUFFER TO EDIT-ERROR
               MOVE TRUE-VAL TO INDS (7) INDS (99)
               GO TO 64-READ-SCREEN.
           IF EMP-STTM-MI > 59
               MOVE 35029 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE ERROR-BUFFER TO EDIT-ERROR
               MOVE TRUE-VAL TO INDS (7) INDS (99)
               GO TO 64-READ-SCREEN.
           IF EMPLOYEE-STTM > 2259
               MOVE EMPLOYEE-STTM TO TIME-STRT-COMP
               SUBTRACT 2360 FROM TIME-STRT-COMP
           ELSE
           MOVE EMPLOYEE-STTM TO TIME-STRT-COMP.
           IF EMPLOYEE-STTM < SHIFT-STRT
               IF EMPLOYEE-STTM < SHIFT-END
                   NEXT SENTENCE
               ELSE
               MOVE 35017 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE ERROR-BUFFER TO EDIT-ERROR
               MOVE TRUE-VAL TO INDS (7) INDS (99)
               GO TO 64-READ-SCREEN
           ELSE
           IF EMPLOYEE-STTM > SHIFT-END
               IF TIME-STRT-COMP < 0
                   NEXT SENTENCE
               ELSE
               MOVE 35017 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE ERROR-BUFFER TO EDIT-ERROR
               MOVE TRUE-VAL TO INDS (7) INDS (99)
               GO TO 64-READ-SCREEN.
           IF DATE-FLAG = 3
               MOVE E-STDT-YY TO HOLD-YY
               MOVE E-STDT-MD TO HOLD-DM
               MOVE E-STDT-DM TO HOLD-MD
           ELSE
           MOVE E-STDT-YY     TO HOLD-YY
           MOVE E-STDT-MD     TO HOLD-MD
           MOVE E-STDT-DM     TO HOLD-DM.
           IF HOLD-YY > "70"
               MOVE "19"      TO HOLD-CC
           ELSE
           MOVE "20"          TO HOLD-CC.
           IF DATE-RECD-CN = SPACES
               MOVE "  MMISA" TO BLOWUP-BASE
               MOVE "W/O HAS NO RECEIVE DATE - NO LABOR CAN BE WRITTEN"
                   TO BU-DISPLAY-MSG
               MOVE "W/O = " TO BU-DISPLAY-FLD (1)
               MOVE WO-NUMBER-BUF TO BU-DISPLAY-FLD (2)
               PERFORM 998-BLOWUP.
           MOVE DATE-RECD-YY    TO SAVE-YY
           MOVE DATE-RECD-MM    TO SAVE-MD
           MOVE DATE-RECD-DD    TO SAVE-DM.
           IF SAVE-YY > "70"
               MOVE "19"        TO SAVE-CC
           ELSE
           MOVE "20"            TO SAVE-CC.
           MOVE EMPLOYEE-STTM   TO TIME-HOLD.
           MOVE TIME-RECD       TO TIME-SAVE.
           MOVE "S" TO SC-SW.
           PERFORM 62-3-DATE-EDIT THRU 62-3-DT-EXIT.
           IF DATE-SW = 1
               GO TO 64-READ-SCREEN.
           IF DATE-SW = 2
               GO TO 64-READ-SCREEN.
      *--- CHECK FOR NUMERIC MONTH, DAY, AND YEAR.   04/18/1995
           IF E-CODT-MD NOT NUMERIC
               MOVE 35031 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE ERROR-BUFFER TO EDIT-ERROR
               MOVE TRUE-VAL TO INDS (8) INDS (99)
               GO TO 64-READ-SCREEN
           ELSE
           IF E-CODT-DM NOT NUMERIC
               MOVE 35030 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE ERROR-BUFFER TO EDIT-ERROR
               MOVE TRUE-VAL TO INDS (8) INDS (99)
               GO TO 64-READ-SCREEN
           ELSE
           IF E-CODT-YY NOT NUMERIC
               MOVE 35032 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE ERROR-BUFFER TO EDIT-ERROR
               MOVE TRUE-VAL TO INDS (8) INDS (99)
               GO TO 64-READ-SCREEN
           ELSE
           IF DATE-FLAG = 3
               IF E-CODT-MD > 31
                   MOVE 35030 TO CATREAD-MSG-NUMBER
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE ERROR-BUFFER TO EDIT-ERROR
                   MOVE TRUE-VAL TO INDS (8) INDS (99)
                   GO TO 64-READ-SCREEN
               ELSE
               NEXT SENTENCE
           ELSE
           IF E-CODT-MD > 12
               MOVE 35031 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE ERROR-BUFFER TO EDIT-ERROR
               MOVE TRUE-VAL TO INDS (8) INDS (99)
               GO TO 64-READ-SCREEN.
           IF DATE-FLAG = 3
               IF E-CODT-DM > 12
                   MOVE 35031 TO CATREAD-MSG-NUMBER
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE ERROR-BUFFER TO EDIT-ERROR
                   MOVE TRUE-VAL TO INDS (8) INDS (99)
                   GO TO 64-READ-SCREEN
               ELSE
               NEXT SENTENCE
           ELSE
           IF E-CODT-DM > 31
               MOVE 35030 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE ERROR-BUFFER TO EDIT-ERROR
               MOVE TRUE-VAL TO INDS (8) INDS (99)
               GO TO 64-READ-SCREEN.
           IF E-CODT-YY NOT NUMERIC
               MOVE 35032 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE ERROR-BUFFER TO EDIT-ERROR
               MOVE TRUE-VAL TO INDS (8) INDS (99)
               GO TO 64-READ-SCREEN.
      *--- CHECK FOR NUMERIC TIME.      04/18/1995
           IF EMPLOYEE-COTM NOT NUMERIC
               MOVE 46009 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE ERROR-BUFFER TO EDIT-ERROR
               MOVE TRUE-VAL TO INDS (9) INDS (99)
               GO TO 64-READ-SCREEN.
           IF EMP-COTM-MI > 59
               MOVE 35029 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE ERROR-BUFFER TO EDIT-ERROR
               MOVE TRUE-VAL TO INDS (9) INDS (99)
               GO TO 64-READ-SCREEN.
           IF EMPLOYEE-COTM > 2259
               MOVE EMPLOYEE-COTM TO TIME-END-COMP
               SUBTRACT 2360 FROM TIME-END-COMP
           ELSE
           MOVE EMPLOYEE-COTM TO TIME-END-COMP
           IF EMPLOYEE-COMPL-DATE > EMPLOYEE-START-DATE
               IF EMPLOYEE-COTM < EMPLOYEE-STTM
                   ADD 2400 TO TIME-END-COMP.
           IF EMPLOYEE-COTM < SHIFT-STRT
               IF EMPLOYEE-COTM NOT > SHIFT-END
                   NEXT SENTENCE
               ELSE
               MOVE 35018 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE ERROR-BUFFER TO EDIT-ERROR
               MOVE TRUE-VAL TO INDS (9) INDS (99)
               GO TO 64-READ-SCREEN
           ELSE
           IF EMPLOYEE-COTM > SHIFT-END
               IF TIME-END-COMP < 0
                   NEXT SENTENCE
               ELSE
               MOVE 35018 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE ERROR-BUFFER TO EDIT-ERROR
               MOVE TRUE-VAL TO INDS (9) INDS (99)
               GO TO 64-READ-SCREEN.
           IF DATE-FLAG = 3
               MOVE E-CODT-YY TO HOLD-YY
               MOVE E-CODT-MD TO HOLD-DM
               MOVE E-CODT-DM TO HOLD-MD
           ELSE
           MOVE E-CODT-YY     TO HOLD-YY
           MOVE E-CODT-MD     TO HOLD-MD
           MOVE E-CODT-DM     TO HOLD-DM.
           IF HOLD-YY > "70"
               MOVE "19"      TO HOLD-CC
           ELSE
           MOVE "20"          TO HOLD-CC.
           IF DATE-STRT-CN = SPACES
               MOVE 49062 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE ERROR-BUFFER TO EDIT-ERROR
               MOVE TRUE-VAL TO INDS (99)
               GO TO 62-READ-SCREEN.
           MOVE DATE-STRT-YY    TO SAVE-YY
           MOVE DATE-STRT-MM    TO SAVE-MD
           MOVE DATE-STRT-DD    TO SAVE-DM.
           IF SAVE-YY > "70"
               MOVE "19"        TO SAVE-CC
           ELSE
           MOVE "20"            TO SAVE-CC.
           MOVE EMPLOYEE-COTM   TO TIME-HOLD.
           MOVE TIME-STRT       TO TIME-SAVE.
           MOVE "C" TO SC-SW.
           PERFORM 62-3-DATE-EDIT THRU 62-3-DT-EXIT.
           IF DATE-SW = 1
               GO TO 64-READ-SCREEN.
           IF DATE-SW = 2
               GO TO 64-READ-SCREEN.
      *    PERFORM 69-MATCH-SEQUENCE THRU 69-MS-EXIT.
           MOVE EMPLOYEE-NUM TO LBR-EMPL-NUM.
           MOVE EMPLOYEE-NAME TO LBR-EMPL-NAME.
           MOVE EMPLOYEE-CRAFT TO LBR-CRAFT.
           MOVE SPACES TO LBR-SHIFT.
           MOVE EMPLOYEE-SHIFT TO LBR-SHIFT-1.
           MOVE 3 TO DATE-MODE.
           MOVE EMPLOYEE-START-DATE TO DATE-VALIDATE-IN.
           CALL "TDATECHK" USING DATE-CHECK-AREA.
           MOVE DATE-DB TO LBR-START-DATE.
           IF LBR-START-DATE-YY > "70"
               MOVE "19" TO LBR-START-DATE-CC
           ELSE
           MOVE "20" TO LBR-START-DATE-CC.
           MOVE EMPLOYEE-STTM TO LBR-START-TIME.
           MOVE 3 TO DATE-MODE.
           MOVE EMPLOYEE-COMPL-DATE TO DATE-VALIDATE-IN.
           CALL "TDATECHK" USING DATE-CHECK-AREA.
           MOVE DATE-DB TO LBR-COMPL-DATE LBR-DATE.
           IF LBR-COMPL-DATE-YY > "70"
               MOVE "19" TO LBR-COMPL-DATE-CC, LBR-DATE-CC
           ELSE
           MOVE "20" TO LBR-COMPL-DATE-CC, LBR-DATE-CC.
           MOVE EMPLOYEE-COTM TO LBR-COMPL-TIME.
           MOVE 0 TO MIN-DIFF.
           IF DATE-FLAG = 3
               MOVE E-STDT-MD TO GREG-DD
               MOVE E-STDT-DM TO GREG-MM
           ELSE
           MOVE E-STDT-MD TO GREG-MM
           MOVE E-STDT-DM TO GREG-DD.
           MOVE E-STDT-YY TO GREG-YY.
           IF GREG-YY > "70"
               MOVE "19"  TO GREG-CC
           ELSE
           MOVE "20"      TO GREG-CC.
           CALL "JULGREG" USING GREG-DATE, JULIAN-DATE,
                            DAY-DIGIT, LEAP-YEAR-FLAG.
           MOVE JULIAN-DATE-9 TO JUL-START-DATE.
           IF DATE-FLAG = 3
               MOVE E-CODT-MD TO GREG-DD
               MOVE E-CODT-DM TO GREG-MM
           ELSE
           MOVE E-CODT-MD TO GREG-MM
           MOVE E-CODT-DM TO GREG-DD.
           MOVE E-CODT-YY TO GREG-YY.
           IF GREG-YY > "70"
               MOVE "19"  TO GREG-CC
           ELSE
           MOVE "20"      TO GREG-CC.
           CALL "JULGREG" USING GREG-DATE, JULIAN-DATE,
                            DAY-DIGIT, LEAP-YEAR-FLAG.
           MOVE JULIAN-DATE-9 TO JUL-COMP-DATE.
           IF JUL-COMP-DATE < JUL-START-DATE
               MOVE 30015 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE ERROR-BUFFER TO EDIT-ERROR
               MOVE TRUE-VAL TO INDS (99)
               GO TO 64-READ-SCREEN
           ELSE
           IF JUL-COMP-DATE > JUL-START-DATE
               SUBTRACT JUL-START-DATE FROM JUL-COMP-DATE
                   GIVING JUL-WORK-DATE
               IF JUL-WORK-DATE > 1
                   MOVE 46010 TO CATREAD-MSG-NUMBER
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE ERROR-BUFFER TO EDIT-ERROR
                   MOVE TRUE-VAL TO INDS (99)
                   GO TO 64-READ-SCREEN
               ELSE
                   IF TIME-STRT-COMP < 0 AND
                      TIME-END-COMP > -1
                       NEXT SENTENCE
                   ELSE
                   MOVE 35029 TO CATREAD-MSG-NUMBER
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE ERROR-BUFFER TO EDIT-ERROR
                   MOVE TRUE-VAL TO INDS (99)
                   GO TO 64-READ-SCREEN
           ELSE
           IF TIME-STRT-COMP < 0 AND
                      TIME-END-COMP > -1
               MOVE 35029 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE ERROR-BUFFER TO EDIT-ERROR
               MOVE TRUE-VAL TO INDS (99)
               GO TO 64-READ-SCREEN.
           IF TIME-END-COMP < TIME-STRT-COMP
               MOVE 46021 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE ERROR-BUFFER TO EDIT-ERROR
               MOVE TRUE-VAL TO INDS (99)
               GO TO 64-READ-SCREEN.
           IF E-HRS NOT = LBR-HRS1-99
               MOVE E-HRS TO LBR-HRS1-99
               MOVE E-PARTIAL-HRS TO LBR-HRS2-9
           ELSE
           MULTIPLY EMP-STTM-HH BY 60 GIVING STTM-MINS
           ADD EMP-STTM-MI TO STTM-MINS
           MULTIPLY EMP-COTM-HH BY 60 GIVING COTM-MINS
           ADD EMP-COTM-MI TO COTM-MINS
           IF STTM-MINS > COTM-MINS
               ADD 1440 TO COTM-MINS.
      *    IF STTM-MINS > 1379 AND COTM-MINS < 421
      *        SUBTRACT 1440 FROM STTM-MINS.
           SUBTRACT STTM-MINS FROM COTM-MINS.
           ADD COTM-MINS TO MIN-DIFF.
           DIVIDE MIN-DIFF BY 60 GIVING EMPLOYEE-HRS-WORKED ROUNDED.
           MOVE E-HRS TO LBR-HRS1-99.
           MOVE E-PARTIAL-HRS TO LBR-HRS2-9.
           MULTIPLY PER-LABOR-RATE BY EMPLOYEE-HRS-WORKED
               GIVING EMP-COST ROUNDED.
           MOVE E-COST-DOLS TO LBR-CST-DOLLR-9.
           MOVE E-COST-CENTS TO LBR-CST-CENTS-9.
           MOVE WO-NUMBER-BUF TO LBR-WO-NUM.
           REWRITE WLFREC FROM WO-LABOR-DATA
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF COND-WORD = 17
               MOVE 29060 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE LBR-EMPL-NUM TO CAT-TEXT4A
               MOVE ERROR-BUFFER TO REQ-CMD-LINE
               MOVE TRUE-VAL TO INDS (98)
               MOVE REQUIRED-INPUT TO DSPLY-REC
               PERFORM 99-SCREEN-WRITE
               PERFORM 98A-SCREEN-READ
               CALL "CLPAUSE2"
               GO TO 64-CL-EXIT.
           MOVE 38002 TO CATREAD-MSG-NUMBER.
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
           MOVE LBR-EMPL-NUM TO CAT-TEXT2A.
           MOVE LBR-EMPL-NAME TO CAT-TEXT2B.
           MOVE TRUE-VAL TO INDS (98).
           MOVE ERROR-BUFFER TO REQ-CMD-LINE.
           MOVE REQUIRED-INPUT TO DSPLY-REC.
           PERFORM 99-SCREEN-WRITE.
           PERFORM 98A-SCREEN-READ.
           CALL "CLPAUSE2".
           IF B-OR-P-SW = 0 GO TO 64-CL-EXIT.
       64-CL-EXIT.    EXIT.
       62-3-DATE-EDIT.
           MOVE 0 TO DATE-SW.
           IF DATE-HOLD > CUR-DATE-CN
               MOVE 30023 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE ERROR-BUFFER TO EDIT-ERROR
               MOVE TRUE-VAL TO INDS (99)
               MOVE 1 TO DATE-SW
               GO TO 62-3-DT-EXIT.
           IF DATE-HOLD = CUR-DATE-CN AND
                   TIME-HOLD > CUR-TIME
               MOVE 46015 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE ERROR-BUFFER TO EDIT-ERROR
               MOVE TRUE-VAL TO INDS (99)
               MOVE 2 TO DATE-SW
               GO TO 62-3-DT-EXIT.
           IF DATE-HOLD < DATE-SAVE AND
                      SC-SW = "S"
               MOVE 30021 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE ERROR-BUFFER TO EDIT-ERROR
               MOVE TRUE-VAL TO INDS (99)
               MOVE 1 TO DATE-SW
               GO TO 62-3-DT-EXIT.
           IF DATE-HOLD < DATE-SAVE AND
                      SC-SW = "C"
               MOVE 30024 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE ERROR-BUFFER TO EDIT-ERROR
               MOVE TRUE-VAL TO INDS (99)
               MOVE 1 TO DATE-SW
               GO TO 62-3-DT-EXIT.
           IF DATE-HOLD = DATE-SAVE AND
                   TIME-HOLD < TIME-SAVE AND
                            SC-SW = "S"
               MOVE 46023 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE ERROR-BUFFER TO EDIT-ERROR
               MOVE TRUE-VAL TO INDS (99)
               MOVE 2 TO DATE-SW
               GO TO 62-3-DT-EXIT.
           IF DATE-HOLD = DATE-SAVE AND
                   TIME-HOLD < TIME-SAVE AND
                            SC-SW = "C"
               MOVE 46022 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE ERROR-BUFFER TO EDIT-ERROR
               MOVE TRUE-VAL TO INDS (99)
               MOVE 2 TO DATE-SW
               GO TO 62-3-DT-EXIT.
       62-3-DT-EXIT.    EXIT.
       65-DELETE-LABOR.
           MOVE "FMODLDEL" TO VIEW-CFNAME.
           IF EDIT-ERROR = SPACES
                MOVE SPACES TO ITEM-BUFFER.
           MOVE 66069 TO CATREAD-MSG-NUMBER.
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
           MOVE ERROR-BUFFER TO ITEM-CMD-LINE.
           MOVE EDIT-ERROR TO ITEM-ERR-LINE.
           MOVE ITEM-BUFFER TO DSPLY-REC.
           PERFORM 99-SCREEN-WRITE.
           PERFORM 98-SCREEN-READ.
           MOVE SPACES TO ERROR-BUFFER EDIT-ERROR.
           MOVE DSPLY-REC TO ITEM-BUFFER.
           IF VIEW-LASTKEY = 1 OR 3 GO TO 2-EOJ.
           IF VIEW-LASTKEY NOT = 0 GO TO 65-DL-EXIT.
           MOVE ITEM-BUFFER TO ITEM-WA.
           PERFORM 68-RIGHT-ADJUST-ITEMNO THRU 68-RAI-EXIT.
      *--- CHECK TO SEE IF ITEM NUMBER IS NUMERIC.  04/18/1995
           IF IT-BYTES-9 NOT NUMERIC
               MOVE 66104 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE ERROR-BUFFER TO EDIT-ERROR
               MOVE TRUE-VAL TO INDS (1) INDS (99)
               GO TO 65-DELETE-LABOR
           ELSE
               MOVE IT-BYTES-9 TO ITEM-BUFF-9.
           MOVE SPACES TO WO-LABOR-DATA.
           PERFORM 69-MATCH-SEQUENCE THRU 69-MS-EXIT.
           IF ERR-SW = 1
               MOVE 35078 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE ERROR-BUFFER TO EDIT-ERROR
               MOVE TRUE-VAL TO INDS (1) INDS (99)
               GO TO 65-DELETE-LABOR.
           IF ERR-SW = 2
               MOVE 0 TO COND-WORD ERR-SW CHAIN-CTR
               GO TO 65-DELETE-LABOR.
           MOVE SPACES TO REQUIRED-DATA RET-LINE.
           MOVE ITEM-BUFF-9 TO REQ-SEQ.
           MOVE LBR-EMPL-NUM TO EMPLOYEE-NUM.
           MOVE LBR-EMPL-NAME TO EMPLOYEE-NAME.
           MOVE LBR-CRAFT TO EMPLOYEE-CRAFT.
           MOVE LBR-SHIFT-1 TO EMPLOYEE-SHIFT.
           MOVE 4 TO DATE-MODE.
           MOVE LBR-START-DATE TO DATE-VALIDATE-IN.
           CALL "TDATECHK" USING DATE-CHECK-AREA.
           MOVE DATE-OUT TO EMPLOYEE-START-DATE.
           MOVE 4 TO DATE-MODE.
           MOVE LBR-COMPL-DATE TO DATE-VALIDATE-IN.
           CALL "TDATECHK" USING DATE-CHECK-AREA.
           MOVE DATE-OUT TO EMPLOYEE-COMPL-DATE.
           MOVE LBR-START-TIME TO EMPLOYEE-STTM.
           MOVE LBR-COMPL-TIME TO EMPLOYEE-COTM.
           MOVE LABOR-HRS TO EMPLOYEE-HRS-WORKED.
           MOVE LABOR-COST TO EMP-COST.
       65-DL-CONT.
           MOVE "FMODLDE2" TO VIEW-CFNAME.
           MOVE 66069 TO CATREAD-MSG-NUMBER.
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
           MOVE ERROR-BUFFER TO REQ-CMD-LINE.
           MOVE EDIT-ERROR TO REQ-ERR-LINE.
           MOVE REQUIRED-INPUT TO DSPLY-REC.
           PERFORM 99-SCREEN-WRITE.
           PERFORM 98-SCREEN-READ.
           MOVE SPACES TO ERROR-BUFFER EDIT-ERROR.
           MOVE DSPLY-REC TO REQUIRED-INPUT.
           IF VIEW-LASTKEY = 1 OR 3 GO TO 2-EOJ.
           IF VIEW-LASTKEY NOT = 0 GO TO 65-DL-EXIT.
           DELETE WO-LABOR-FILE RECORD    INVALID KEY
               MOVE 17 TO COND-WORD.
           IF WLF-STATUS NOT = "00" MOVE 17 TO COND-WORD.
           IF COND-WORD = 17
               MOVE "  MMISA" TO BLOWUP-BASE
               MOVE "DBDELETE FAILURE * TMODLABR *"
                   TO BU-DISPLAY-MSG
               MOVE "WO LABOR FILE" TO BU-DISPLAY-FLD (1)
               PERFORM 998-BLOWUP.
           MOVE 38003 TO CATREAD-MSG-NUMBER.
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
           MOVE LBR-EMPL-NUM TO CAT-TEXT2A.
           MOVE LBR-EMPL-NAME TO CAT-TEXT2B.
           MOVE TRUE-VAL TO INDS (98).
           MOVE ERROR-BUFFER TO REQ-CMD-LINE.
           MOVE REQUIRED-INPUT TO DSPLY-REC.
           PERFORM 99-SCREEN-WRITE.
           PERFORM 98A-SCREEN-READ.
           CALL "CLPAUSE2".
           IF B-OR-P-SW = 0 GO TO 65-DL-EXIT.
       65-DL-EXIT.    EXIT.
       66-RETRIEVE-DATA.
           MOVE 0 TO COND-WORD.
           MOVE WO-NUMBER-BUF TO WONUM OF WLFREC.
           START WO-LABOR-FILE KEY IS > EXTERNALLY-DESCRIBED-KEY
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF WLF-STATUS NOT = "00" MOVE 17 TO COND-WORD.
           IF COND-WORD = 17
               MOVE 40010 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE ERROR-BUFFER TO EDIT-ERROR
               MOVE TRUE-VAL TO INDS (98)
               MOVE EDIT-ERROR TO SCREEN-CMD-LINE
               MOVE SCREEN-CMD-ERR TO DSPLY-REC
               PERFORM 99-SCREEN-WRITE
               PERFORM 98A-SCREEN-READ
               CALL "CLPAUSE2"
               MOVE 0 TO VIEW-LASTKEY
               GO TO 66-RD-EXIT.
           MOVE SPACES TO PRT-LINE1.
       66-RD-LOOP.
           READ WO-LABOR-FILE PRIOR INTO WO-LABOR-DATA
               AT END    MOVE 14 TO COND-WORD.
           IF WLF-STATUS NOT = "00" MOVE 14 TO COND-WORD.
           IF LBR-WO-NUM NOT = WO-NUMBER-BUF
      *        IF VIEW-LASTKEY = 2
      *            MOVE 15 TO COND-WORD
      *            REWRITE WLFREC    INVALID KEY MOVE 15 TO COND-WORD
      *        ELSE
               MOVE 14 TO COND-WORD.
           IF COND-WORD = 14 AND VIEW-LASTKEY = 6
               AND CHAIN-CTR LESS THAN 1
               MOVE 40010 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE ERROR-BUFFER TO EDIT-ERROR
               MOVE TRUE-VAL TO INDS (98)
               MOVE EDIT-ERROR TO SCREEN-CMD-LINE
               MOVE SCREEN-CMD-ERR TO DSPLY-REC
               PERFORM 99-SCREEN-WRITE
               PERFORM 98A-SCREEN-READ
               CALL "CLPAUSE2"
               MOVE 0 TO VIEW-LASTKEY
               GO TO 66-RD-EXIT.
           IF COND-WORD = 14 AND VIEW-LASTKEY = 6
               MOVE REQ-DATE-WO TO P-REQ-DATA
               MOVE 30077 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE ERROR-BUFFER TO P-DEPRESS-LINE
               MOVE 66057 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE ERROR-BUFFER TO P-CMD-LINE
               MOVE "FMODLIST" TO VIEW-CFNAME
               MOVE PRT-LINE1 TO DSPLY-REC
               PERFORM 99-SCREEN-WRITE
               PERFORM 98-SCREEN-READ
               MOVE DSPLY-REC TO PRT-LINE1
               IF VIEW-LASTKEY = 1 OR 3
                   GO TO 2-EOJ.
           IF COND-WORD = 14 GO TO 66-RD-EXIT.
           ADD 1 TO CHAIN-CTR.
           IF VIEW-LASTKEY NOT = 6 GO TO 66-RD-LOOP.
           ADD 1 TO SUB.
           MOVE CHAIN-CTR TO P-CTR (SUB).
           MOVE LBR-EMPL-NUM TO P-LABR-NUM (SUB).
           MOVE LBR-EMPL-NAME TO P-LABR-NAME (SUB).
           MOVE LBR-CRAFT TO P-LABR-CRAFT (SUB).
           MOVE LBR-SHIFT-1 TO P-LABR-SHIFT (SUB).
           MOVE 4 TO DATE-MODE.
           MOVE LBR-START-DATE TO DATE-VALIDATE-IN.
           CALL "TDATECHK" USING DATE-CHECK-AREA.
           MOVE DATE-OUT TO P-LABR-STDATE (SUB).
           MOVE LBR-START-TIME    TO P-LABR-STTM (SUB).
           MOVE 4 TO DATE-MODE.
           MOVE LBR-COMPL-DATE TO DATE-VALIDATE-IN.
           CALL "TDATECHK" USING DATE-CHECK-AREA.
           MOVE DATE-OUT TO P-LABR-CODATE (SUB).
           MOVE LBR-COMPL-TIME    TO P-LABR-COTM (SUB).
           MOVE LBR-HRS1-99 TO P-LABR-HRS (SUB).
           MOVE LBR-HRS2-9 TO P-LABR-PARTIAL-HRS (SUB).
           MOVE LBR-CST-DOLLR-9 TO P-LABR-DOLS (SUB).
           MOVE LBR-CST-CENTS-9 TO P-LABR-CENTS (SUB).
           MOVE "." TO P-LABR-HRS-DEC (SUB) P-LABR-DOLS-DEC (SUB).
           IF SUB NOT = 15
               GO TO 66-RD-LOOP
           ELSE
           MOVE 0 TO SUB
           MOVE "FMODLIST" TO VIEW-CFNAME
           MOVE REQ-DATE-WO TO P-REQ-DATA
           MOVE 30077 TO CATREAD-MSG-NUMBER
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
           MOVE ERROR-BUFFER TO P-DEPRESS-LINE
           MOVE 66057 TO CATREAD-MSG-NUMBER
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
           MOVE ERROR-BUFFER TO P-CMD-LINE
           MOVE PRT-LINE1 TO DSPLY-REC
           PERFORM 99-SCREEN-WRITE
           PERFORM 98-SCREEN-READ
           MOVE DSPLY-REC TO PRT-LINE1
           IF VIEW-LASTKEY = 1 OR 3
               GO TO 2-EOJ
           ELSE
           IF VIEW-LASTKEY = 6
               MOVE SPACES TO PRT-LINE1
               MOVE REQ-DATE-WO TO P-REQ-DATA
               MOVE 0 TO SUB
               GO TO 66-RD-LOOP
           ELSE
           MOVE 0 TO COND-WORD
           MOVE 0 TO SUB.
       66-RD-EXIT.    EXIT.
       68-RIGHT-ADJUST-ITEMNO.
           MOVE 4 TO SUB1, SUB2.
           IF ITB (SUB1) NOT = " " GO TO 68-ZEROFILL-FIELD.
       68-RAI-FIRST.
           IF ITB (SUB1) NOT = " " GO TO 68-MOVE-BYTE.
           IF SUB1 = 1 GO TO 68-ZEROFILL-FIELD.
           SUBTRACT 1 FROM SUB1.
           GO TO 68-RAI-FIRST.
       68-MOVE-BYTE.
           IF ITB (SUB1) = " " GO TO 68-ZEROFILL-FIELD.
           MOVE ITB (SUB1) TO ITB (SUB2).
           MOVE " " TO ITB (SUB1).
           IF SUB1 = 1 GO TO 68-ZEROFILL-FIELD.
           SUBTRACT 1 FROM SUB1, SUB2.
           GO TO 68-MOVE-BYTE.
      *--- CHANGE SUBSCRIPTS IN THIS PARAGRAPH BECAUSE THE LOGIC WAS
      *--- BACKWARDS.    04/18/1995
       68-ZEROFILL-FIELD.
           IF ITB (1) = " "
               IF ITB (2) = " "
                   IF ITB (3) = " "
                       IF ITB (4) = " "
                           MOVE "0" TO ITB (1) ITB (2)
                              ITB (3) ITB (4)
                       ELSE
                       MOVE "0" TO ITB (1) ITB (2) ITB (3)
                   ELSE
                   MOVE "0" TO ITB (1) ITB (2)
               ELSE
               MOVE "0" TO ITB (1).
       68-RAI-EXIT.    EXIT.
       69-MATCH-SEQUENCE.
           MOVE 0 TO CHAIN-CTR ERR-SW COND-WORD.
           MOVE WO-NUMBER-BUF TO WONUM OF WLFREC.
           START WO-LABOR-FILE KEY IS > EXTERNALLY-DESCRIBED-KEY
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF WLF-STATUS NOT = "00" MOVE 17 TO COND-WORD.
           IF COND-WORD = 17
               MOVE 1 TO ERR-SW
               GO TO 69-MS-EXIT.
       69-MS-LOOP.
           READ WO-LABOR-FILE PRIOR INTO WO-LABOR-DATA
               AT END MOVE 15 TO COND-WORD.
           IF WLF-STATUS NOT = "00" MOVE 15 TO COND-WORD.
           IF LBR-WO-NUM NOT = WO-NUMBER-BUF MOVE 15 TO COND-WORD.
           IF COND-WORD = 15
               MOVE 1 TO ERR-SW
               GO TO 69-MS-EXIT.
           ADD 1 TO CHAIN-CTR.
           IF CHAIN-CTR NOT = ITEM-BUFF-9 GO TO 69-MS-LOOP.
       69-MS-EXIT.    EXIT.

       98-SCREEN-READ.
           READ DISPLAY-FILE FORMAT IS VIEW-CFNAME
               INDIC IS INDICS.
           ACCEPT IOFEEDBACK FROM I-O-FEEDBACK-AREA.
           MOVE ALL B"0" TO INDICS.
           IF DSPLY-STATUS NOT = "00"
               MOVE 3 TO VIEW-LASTKEY
           ELSE
           MOVE FUNCTION-NUM TO VIEW-LASTKEY.

       98A-SCREEN-READ.
           READ DISPLAY-FILE TERMINAL IS TERMINAL-ID
               INDIC IS INDICS
                  NO DATA MOVE DSPLY-STATUS TO DSPLY-STATUS.
           MOVE ALL B"0" TO INDICS.

       99-SCREEN-WRITE.
           WRITE DSPLY-REC FORMAT IS VIEW-CFNAME
               INDIC IS INDICS.
           MOVE ALL B"0" TO INDICS.

       998-BLOWUP.
           MOVE "TMODLABR" TO BU-PGM-NAME.
           CALL "TBLOWUP" USING BLOWUP-BASE BU-PGM-NAME STATUS-AREA
                            VIEW-COMAREA DUMMY-KSAM-STAT
                            BU-DISPLAY-MSG BU-DISPLAY-FLDS.

       999-CATREAD.
           MOVE SPACES TO ERROR-BUFFER.
           CALL "CCATREAD" USING CATREAD-PARMS.
           MOVE CATREAD-MSG-TEXT TO ERROR-BUFFER.
       999-CATREAD-EXIT.    EXIT.
