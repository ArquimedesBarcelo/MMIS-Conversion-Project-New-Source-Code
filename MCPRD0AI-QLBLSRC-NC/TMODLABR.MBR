           05  CURR-SHIFT                   PIC 9.
       01  PASSED-SPOOL-PRT             PIC S9(2) VALUE ZERO  COMP.
       01  PASSWORD-INFORMATION.
           05  NAME-OF-PROGRAM     PIC X(08) VALUE "TMODLABR".
           05  PROGRAM-TYPE        PIC X(02) VALUE "UP".
           05  PROGRAM-RELEASE     PIC X(12) VALUE " E0100010001".
           05  PROGRAM-DESCRIPTION.
               10  PROG-DESC-A.
                   15  FILLER      PIC X(14) VALUE " LABOR MODIFY ".
                   15  FILLER      PIC X(16) VALUE "PROGRAM - ALLOWS".
                   15  FILLER      PIC X(14) VALUE " USER TO ADD, ".
                   15  FILLER      PIC X(16) VALUE "CHANGE, DELETE, ".
               10  PROG-DESC-B.
                   15  FILLER      PIC X(15) VALUE "AND LIST LABOR ".
                   15  FILLER      PIC X(13) VALUE "ENTRIES ON A ".
                   15  FILLER      PIC X(32) VALUE "WORK ORDER  ".
               10  PROG-FUNCTION   PIC X(60) VALUE SPACES.
           05  PASSWORD-FLAG       PIC X.
       01  PERSONNEL-DATA.     COPY MPERSONL OF COPYLIB.
       01  PRT-LINE1.
           05  P-REQ-DATA                   PIC X(18).
           05  PLINE OCCURS 15 TIMES.
               10  P-CTR                    PIC 9999.
               10  FILLER                   PIC X.
               10  P-LABR-NUM               PIC X(4).
               10  FILLER                   PIC X.
               10  P-LABR-NAME              PIC X(16).
               10  FILLER                   PIC X.
               10  P-LABR-CRAFT             PIC XX.
               10  FILLER                   PIC XX.
               10  P-LABR-SHIFT             PIC Z.
               10  FILLER                   PIC XX.
               10  P-LABR-STDATE            PIC X(6).
               10  FILLER                   PIC X.
               10  P-LABR-STTM              PIC X(4).
               10  FILLER                   PIC X.
               10  P-LABR-CODATE            PIC X(6).
               10  FILLER                   PIC X.
               10  P-LABR-COTM              PIC X(4).
               10  FILLER                   PIC XX.
               10  P-LABR-HRS               PIC Z9.
               10  P-LABR-HRS-DEC           PIC X.
               10  P-LABR-PARTIAL-HRS       PIC 9.
               10  FILLER                   PIC XX.
               10  P-LABR-DOLS              PIC ZZZZZZZZZ9.
               10  P-LABR-DOLS-DEC          PIC X.
               10  P-LABR-CENTS             PIC 99.
               10  FILLER                   PIC X.
           05  P-DEPRESS-LINE               PIC X(79).
           05  P-CMD-LINE                   PIC X(79).
           05  P-MSG-LINE                   PIC X(79).
       01  REQUIRED-INPUT.
           02  REQ-DATE-WO.
               03  REQ-DATE                 PIC X(8).
               03  REQ-WO                   PIC X(10).
           02  REQUIRED-DATA.
               03  REQ-SEQ                  PIC 9999.
               03  REQ-SEQ-X REDEFINES REQ-SEQ PIC XXXX.
               03  FILLER                   PIC X(58).
           02  REQUIRED-LIT REDEFINES REQUIRED-DATA.
               03  FILLER                   PIC XXXX.
               03  EMPLOYEE-NUM             PIC X(4).
               03  EMPLOYEE-NAME            PIC X(16).
               03  EMPLOYEE-CRAFT           PIC XX.
               03  EMPLOYEE-SHIFT           PIC X.
               03  EMPLOYEE-START-DATE.
                   04  E-STDT-MD            PIC 99.
                   04  E-STDT-DM            PIC 99.
                   04  E-STDT-YY            PIC 99.
               03  EMPLOYEE-STTM.
                   04  EMP-STTM-HH          PIC 99.
                   04  EMP-STTM-MI          PIC 99.
               03  EMPLOYEE-COMPL-DATE.
                   04  E-CODT-MD            PIC 99.
                   04  E-CODT-DM            PIC 99.
                   04  E-CODT-YY            PIC 99.
               03  EMPLOYEE-COTM.
                   04  EMP-COTM-HH          PIC 99.
                   04  EMP-COTM-MI          PIC 99.
               03  EMPLOYEE-HRS.
                   04  E-HRS                PIC 99.
                   04  E-PARTIAL-HRS        PIC 9.
               03  EMPLOYEE-HRS-WORKED REDEFINES EMPLOYEE-HRS
                                            PIC 99V9.
               03  EMPLOYEE-COST.
                   04  E-COST-DOLS          PIC 9(10).
                   04  E-COST-CENTS         PIC 99.
               03  EMP-COST REDEFINES EMPLOYEE-COST  PIC 9(10)V99.
           02  RET-LINE                     PIC X(79).
           02  REQ-CMD-LINE                 PIC X(79).
           02  REQ-ERR-LINE                 PIC X(79).
       01  SCREEN-CMD-ERR.
           05  SCREEN-CMD-LINE          PIC X(79).
           05  SCREEN-ERR-LINE          PIC X(79).
       01  SCREEN-PRINT-PARMS.
           05  PRINTCNTL                PIC S9(4) VALUE ZERO  COMP.
           05  PAGECNTL                 PIC S9(4) VALUE 49    COMP.
           05  SPOOLFIL-OPEN-SW         PIC X   VALUE "N".
       COPY DBSTAT OF COPYLIB.
       COPY TBLOWUP IN COPYLIB.
       01  TIME-HOLD                        PIC X(4).
       01  TIME-SAVE                        PIC X(4).
       01  TRUE-VAL                         PIC 1 VALUE B"1".
       01  WO-BASIC-DATA.      COPY DWOBASIC OF COPYLIB.
       01  WO-LABOR-DATA.      COPY DWOLABOR OF COPYLIB.
       01  WO-PLANNED-DATA.    COPY DWOPLAN OF COPYLIB.
       COPY WSCONTROL IN COPYLIB.
       01  ZONE-LINK                        PIC X(4).
       LINKAGE SECTION.
       01  DBPARAMETERS.       COPY DBPARMS OF COPYLIB.
       01  WO-NUMBER-BUF                    PIC X(10).
       COPY VCOMLINK OF COPYLIB.
       PROCEDURE DIVISION USING DBPARAMETERS WO-NUMBER-BUF
                            VIEW-COMAREA.
       BEGIN-PROCESSING.
           PERFORM 1-HSK.
           PERFORM 6-MAIN UNTIL VIEW-LASTKEY = 3.
       2-EOJ.
           CLOSE DISPLAY-FILE.
           CLOSE PERSONNEL-FILE.
           CLOSE WO-BASIC-FILE.
           CLOSE WO-LABOR-FILE.
           CLOSE WO-LAST-NUM-USED.
           CLOSE WO-PLANNED-FILE.
           GOBACK.
       1-HSK.
           OPEN I-O   DISPLAY-FILE.
           OPEN INPUT PERSONNEL-FILE.
           OPEN INPUT WO-BASIC-FILE.
           OPEN I-O   WO-LABOR-FILE.
           OPEN INPUT WO-LAST-NUM-USED.
           OPEN INPUT WO-PLANNED-FILE.
           CALL "TPWORD" USING PASSWORD-INFORMATION.
           IF PASSWORD-FLAG = "N"
               MOVE "  PWORD" TO BLOWUP-BASE
               MOVE "FAILED PASSWORD CHECK - TMODLABR"
                   TO BU-DISPLAY-MSG
               PERFORM 998-BLOWUP.
           MOVE 0 TO COND-WORD.
           MOVE 1 TO ARG-NUM.
           READ WO-LAST-NUM-USED INTO LAST-WO-BUFF
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF WLNU-STATUS NOT = "00" MOVE 17 TO COND-WORD.
           IF COND-WORD = 17
               MOVE 1 TO DATE-FLAG
           ELSE
           MOVE DATE-FLAG-SW TO DATE-FLAG.
           ACCEPT CURRENT-DATE-WA FROM DATE.
           IF CURRENT-DATE-WA-YY > "70"
               MOVE "19" TO CURRENT-DATE-WA-CC
           ELSE
           MOVE "20" TO CURRENT-DATE-WA-CC.
           MOVE CURRENT-DATE-WA-CN TO CUR-DATE-CN.
           MOVE DATE-FLAG TO DATE-CODE.
           MOVE 4 TO DATE-MODE.
           MOVE CUR-DATE TO DATE-VALIDATE-IN.
           CALL "TDATECHK" USING DATE-CHECK-AREA.
           MOVE SPACES TO REQUIRED-INPUT.
           MOVE ZEROS TO EMPLOYEE-START-DATE
                         EMPLOYEE-STTM
                         EMPLOYEE-COMPL-DATE
                         EMPLOYEE-COTM
                         EMPLOYEE-HRS
                         EMPLOYEE-COST.
           MOVE SPACES TO WO-BASIC-DATA WO-PLANNED-DATA.
           PERFORM 1-START-WO-BASIC-FILE.
           IF COND-WORD = 0
               PERFORM 1-READ-WO-BASIC-FILE.
           IF COND-WORD = 17
               MOVE SPACES TO WO-BASIC-DATA
               PERFORM 1-START-WO-PLANNED-FILE
               IF COND-WORD = 17
                   MOVE 29020 TO CATREAD-MSG-NUMBER
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE TRUE-VAL TO INDS (1) INDS (99)
               ELSE
               PERFORM 1-READ-WO-PLANNED-FILE
               IF COND-WORD = 15
                   MOVE 29020 TO CATREAD-MSG-NUMBER
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE TRUE-VAL TO INDS (1) INDS (99)
               ELSE
               MOVE ZONE-P           TO ZONE
               MOVE DATE-TIME-RECD-P TO DATE-TIME-RECD
               MOVE DATE-STRT-P-CN   TO DATE-STRT-CN
               MOVE TIME-STRT-P      TO TIME-STRT
               MOVE DATE-COMP-P-CN   TO DATE-COMP-CN
               MOVE TIME-COMP-P      TO TIME-COMP.
           MOVE ZONE TO ZONE-BUF.
           MOVE 0 TO VIEW-LASTKEY.
       1-START-WO-BASIC-FILE.
           MOVE 0 TO COND-WORD.
           MOVE WO-NUMBER-BUF TO WONUM OF WBFREC.
           START WO-BASIC-FILE KEY IS = EXTERNALLY-DESCRIBED-KEY
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF WBF-STATUS NOT = "00" MOVE 17 TO COND-WORD.
       1-READ-WO-BASIC-FILE.
           MOVE 0 TO COND-WORD.
           MOVE 0 TO B-OR-P-SW.
           READ WO-BASIC-FILE INTO WO-BASIC-DATA
               INVALID KEY    MOVE 15 TO COND-WORD.
           IF WBF-STATUS NOT = "00" MOVE 15 TO COND-WORD.
       1-START-WO-PLANNED-FILE.
           MOVE 0 TO COND-WORD.
           MOVE WO-NUMBER-BUF TO WONUM OF WPFREC.
           START WO-PLANNED-FILE KEY IS = EXTERNALLY-DESCRIBED-KEY
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF WPF-STATUS NOT = "00" MOVE 17 TO COND-WORD.
       1-READ-WO-PLANNED-FILE.
           MOVE 0 TO COND-WORD.
           MOVE 1 TO B-OR-P-SW.
           READ WO-PLANNED-FILE INTO WO-PLANNED-DATA
               INVALID KEY    MOVE 15 TO COND-WORD.
           IF WPF-STATUS NOT = "00" MOVE 15 TO COND-WORD.
       6-MAIN.
           IF VIEW-LASTKEY > 0
               NEXT SENTENCE
           ELSE
           MOVE "FMODLABR" TO VIEW-CFNAME
           ACCEPT CURRENT-TIME FROM TIME
           MOVE 66066 TO CATREAD-MSG-NUMBER
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
           MOVE ERROR-BUFFER TO SCREEN-CMD-LINE
           MOVE EDIT-ERROR TO SCREEN-ERR-LINE
           MOVE SCREEN-CMD-ERR TO DSPLY-REC
           PERFORM 99-SCREEN-WRITE
           PERFORM 98-SCREEN-READ
           MOVE SPACES TO ERROR-BUFFER EDIT-ERROR
           IF VIEW-LASTKEY = 1 OR 3 GO TO 2-EOJ.
      **************************************************************
      *     PROCESS THE FUNCTION CHOSEN BY THE USER                *
      *                                                            *
      *     F2 - ADD    LABOR ENTRIES                              *
      *     F4 - CHANGE LABOR ENTRIES                              *
      *     F5 - DELETE LABOR ENTRIES                              *
      *     F6 - LIST   LABOR ENTRIES                              *
      *                                                            *
      **************************************************************
           IF VIEW-LASTKEY = 2
               MOVE 0 TO CHAIN-CTR ERR-SW SUB
               MOVE SPACES TO REQUIRED-INPUT
               MOVE ZEROS TO EMPLOYEE-START-DATE
                             EMPLOYEE-STTM
                             EMPLOYEE-COMPL-DATE
                             EMPLOYEE-COTM
                             EMPLOYEE-HRS
                             EMPLOYEE-COST
               MOVE WO-NUMBER-BUF TO REQ-WO
               MOVE DATE-SLASH-OUT TO REQ-DATE
               PERFORM 66-RETRIEVE-DATA THRU 66-RD-EXIT
      **************************************************************
      *    ADDED THE ABOVE LINE TO SET THE ENTRY NUMBER            *
      *               11-25-86                                     *
      **************************************************************
               PERFORM 62-ADD-LABOR THRU 62-AL-EXIT
           ELSE
           IF VIEW-LASTKEY = 4
               PERFORM 64-CHANGE-LABOR THRU 64-CL-EXIT
           ELSE
           IF VIEW-LASTKEY = 5
               PERFORM 65-DELETE-LABOR THRU 65-DL-EXIT
           ELSE
           IF VIEW-LASTKEY = 6
               MOVE 0 TO CHAIN-CTR ERR-SW SUB
               MOVE SPACES TO REQUIRED-INPUT
               MOVE ZEROS TO EMPLOYEE-START-DATE
                             EMPLOYEE-STTM
                             EMPLOYEE-COMPL-DATE
                             EMPLOYEE-COTM
                             EMPLOYEE-HRS
                             EMPLOYEE-COST
               MOVE WO-NUMBER-BUF TO REQ-WO
               MOVE DATE-SLASH-OUT TO REQ-DATE
               PERFORM 66-RETRIEVE-DATA THRU 66-RD-EXIT
           ELSE
           MOVE 35126 TO CATREAD-MSG-NUMBER
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
           MOVE TRUE-VAL TO INDS (99)
           MOVE 0 TO VIEW-LASTKEY.
       62-ADD-LABOR.
           IF B-OR-P-SW = 1
               IF EXP-CLASS-P = "        "
                   MOVE 31075 TO CATREAD-MSG-NUMBER
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE ERROR-BUFFER TO EDIT-ERROR
                   MOVE TRUE-VAL TO INDS (99)
                   MOVE 0 TO VIEW-LASTKEY
                   GO TO 62-AL-EXIT
               ELSE
               IF APPROVAL-CODE-P = "U"
                   MOVE 38011 TO CATREAD-MSG-NUMBER
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE ERROR-BUFFER TO EDIT-ERROR
                   MOVE TRUE-VAL TO INDS (99)
                   MOVE 0 TO VIEW-LASTKEY
                   GO TO 62-AL-EXIT.
       62-READ-SCREEN.
           MOVE "FMODLADD" TO VIEW-CFNAME.
           IF INDS (99) = TRUE-VAL
               MOVE EDIT-ERROR TO REQ-ERR-LINE
               MOVE SPACES     TO RET-LINE
           ELSE
           MOVE 35115 TO CATREAD-MSG-NUMBER
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
           MOVE ERROR-BUFFER TO RET-LINE
           ADD 1 TO CHAIN-CTR
           MOVE CHAIN-CTR TO REQ-SEQ.
           MOVE 66067 TO CATREAD-MSG-NUMBER.
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
           MOVE ERROR-BUFFER TO REQ-CMD-LINE.
           MOVE REQUIRED-INPUT TO DSPLY-REC.
           PERFORM 99-SCREEN-WRITE.
           PERFORM 98-SCREEN-READ.
           MOVE DSPLY-REC TO REQUIRED-INPUT.
           MOVE SPACES TO ERROR-BUFFER EDIT-ERROR.
           MOVE 0 TO DATE-SW.
           IF VIEW-LASTKEY = 1 OR 3 GO TO 2-EOJ.
           IF VIEW-LASTKEY NOT = 0 GO TO 62-AL-EXIT.
           MOVE 0 TO COND-WORD.
           MOVE EMPLOYEE-NUM TO PERCCNUM OF PERSREC.
           START PERSONNEL-FILE KEY IS = EXTERNALLY-DESCRIBED-KEY
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF PF-STATUS NOT = "00" MOVE 17 TO COND-WORD.
           IF COND-WORD = 17
               MOVE 35047 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE EMPLOYEE-NUM TO CAT-TEXT1A
               MOVE ERROR-BUFFER TO EDIT-ERROR
               MOVE TRUE-VAL TO INDS (1) INDS (99)
               GO TO 62-READ-SCREEN.
           READ PERSONNEL-FILE NEXT INTO PERSONNEL-DATA
               AT END    MOVE 15 TO COND-WORD.
           IF PF-STATUS NOT = "00" MOVE 15 TO COND-WORD.
           MOVE PER-EMP-NAME TO EMPLOYEE-NAME.
           IF EMPLOYEE-SHIFT NOT NUMERIC
               MOVE 35107 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE ERROR-BUFFER TO EDIT-ERROR
               MOVE TRUE-VAL TO INDS (5) INDS (99)
               GO TO 62-READ-SCREEN.
           IF EMPLOYEE-SHIFT < "1" OR > "4"
               MOVE 35108 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE ERROR-BUFFER TO EDIT-ERROR
               MOVE TRUE-VAL TO INDS (5) INDS (99)
               GO TO 62-READ-SCREEN.
           MOVE ZEROES TO TIME-IN.
           CALL "TGETSHFT" USING LINK-DATA DBPARAMETERS.
           IF EMPLOYEE-SHIFT = "1"
               MOVE S-1 TO SHIFT-STRT
               MOVE E-1 TO SHIFT-END
               IF SHIFT-END < SHIFT-STRT
                   ADD 2400 TO SHIFT-END
               END-IF
           ELSE
           IF EMPLOYEE-SHIFT = "2"
               MOVE S-2 TO SHIFT-STRT
               MOVE E-2 TO SHIFT-END
               IF SHIFT-END < SHIFT-STRT
                   ADD 2400 TO SHIFT-END
               END-IF
           ELSE
           IF EMPLOYEE-SHIFT = "3"
               MOVE S-3 TO SHIFT-STRT
               MOVE E-3 TO SHIFT-END
               IF SHIFT-END < SHIFT-STRT
                   ADD 2400 TO SHIFT-END
               END-IF
           ELSE
           MOVE S-4 TO SHIFT-STRT
           MOVE E-4 TO SHIFT-END
           IF SHIFT-END < SHIFT-STRT
               ADD 2400 TO SHIFT-END.
      *--- CHECK TO SEE IF MONTH, DAY, AND YEAR ARE NUMERIC.  04/18/1995
           IF E-STDT-MD NOT NUMERIC
               MOVE 35031 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE ERROR-BUFFER TO EDIT-ERROR
               MOVE TRUE-VAL TO INDS (6) INDS (99)
