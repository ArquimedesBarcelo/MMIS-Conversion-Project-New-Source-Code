029800 PROCEDURE DIVISION.
029900
030000 PROC-DIV SECTION 01.
030100
030200 BEGIN-HERE.
030300     PERFORM 1-HSK THRU 1-H-X.
030400
030500     PERFORM 6-MAIN THRU 6-M-X.
030600
030700     PERFORM 2-EOJ  THRU 2-EOJ-X.
030800
030900     GOBACK.
031000
031100 1-HSK.
034600     CALL "TESCSEQ" USING ESC-NAME.
034700
           OPEN INPUT MPLTINFO-I, MBUYER-I, DPOITEM-I, DVENDOR-I,
                      MCOMMENT-I.
           OPEN I-O DPORECD-O, DISPLAY-FILE.
035200
035300**************************************************
035400*                                                *
035500*   GET CO. AND PRIME FROM MPLTINFO              *
035600*   USING 'P 01' AS THE ARGUMENT                 *
035700*                                                *
035800**************************************************
035900
036000     MOVE "P 01"  TO  PLT-ARG.
           MOVE PLT-ARG TO PLTINFOKEY OF MPLTINFO-REC-I.
           READ MPLTINFO-I INTO BUF-MPLTINFO
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
036400         MOVE "DBGET MPLTINFO 1-HSK P 01"  TO  BU-DISPLAY-MSG
036500         MOVE PLT-ARG                 TO  BU-DISPLAY-FLD (1)
036600         GO TO 2-BLOWUP.
036700     MOVE MPLTINFO-COMPANY        TO  COMPANY-SAVE.
036800
036900****************************************************
037000**
037100**   GET THE PO FOLLOWUP PRINTER NUMBER FROM THE
037200**   DATA SET MPLTINFO KEY='POPT'.  USE THE
037300**   SAME PRINTER NUMBER AS THE QUOTES TO
037400**   PRINT THE FOLLOWUPS
037500**
037600****************************************************
037700
037800     MOVE 9                       TO  SAVE-FLWUP-PRINT-NUM.
037900     MOVE "POPT"                  TO  PLT-ARG.
           MOVE PLT-ARG TO PLTINFOKEY OF MPLTINFO-REC-I.
           READ MPLTINFO-I INTO BUF-MPLTINFO
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
038400             NEXT SENTENCE
038500         ELSE
038600             MOVE "GET MPLTINFO 'POPT'*1HSK" TO BU-DISPLAY-MSG
038700             MOVE PLT-ARG  TO  BU-DISPLAY-FLD (1)
038800             GO TO 2-BLOWUP
038900     ELSE
           IF COMPANY-SAVE = "631"
               MOVE MPLTINFO-PO-PRT-NO        TO  SAVE-FLWUP-PRINT-NUM
           ELSE
039000         MOVE MPLTINFO-01-QUOTE-PRT-NO  TO  SAVE-FLWUP-PRINT-NUM.
039100
039200****************************************************
039300**
039400**   GET THE PO FOLLOWUP DEFAULT STD. INSTRUCTIONS
039500**   FROM THE DATA SET MPLTINFO KEY='PFLP'.
039600**
039700****************************************************
039800
039900     MOVE SPACES                  TO  SAVE-STD-INST-TABLE.
040000     MOVE "PFLP"                  TO  PLT-ARG.
           MOVE PLT-ARG TO PLTINFOKEY OF MPLTINFO-REC-I.
           READ MPLTINFO-I INTO BUF-MPLTINFO
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
040500             NEXT SENTENCE
040600         ELSE
040700             MOVE "GET MPLTINFO 'PFLP'*1HSK" TO BU-DISPLAY-MSG
040800             MOVE PLT-ARG  TO  BU-DISPLAY-FLD (1)
040900             GO TO 2-BLOWUP
041000     ELSE
041100         MOVE MPLTINFO-FLLOWUP       TO  SAVE-STD-INST-TABLE.
041200
041300 1-H-X.
041400     EXIT.
041500
041600 2-EOJ.
           CLOSE MPLTINFO-I, MBUYER-I, DPOITEM-I, DVENDOR-I,
                 MCOMMENT-I, DPORECD-O, DISPLAY-FILE.
043600
043700 2-EOJ-X.
043800      EXIT.
043900
044000******************************************************
044100**                                                  **
044200**   BLOWUP ROUTINE                                 **
044300**                                                  **
044400******************************************************
044500
044600 2-BLOWUP.
044700     MOVE "TFLLOWUP"            TO  BU-PGM-NAME.
044800     CALL "TBLOWUP" USING BASE, BU-PGM-NAME, STATUS-AREA,
044900         VIEW-COMAREA, FILE-STATUS, BU-DISPLAY-MSG,
045000                 BU-DISPLAY-FLDS.
045100
045200 2-BLOWUP-X.
045300     EXIT.
045400
048200 4-PGM-ERROR.
           MOVE B"1" TO IND(FIELD-NUMBER) IND(99).
           MOVE MESSAGE-BUFFER TO DE1-MESSAGE-LINE,
                                  DE2-MESSAGE-LINE.
049000
049100 4-PGM-ERROR-X.
049200     EXIT.
049300
051300
