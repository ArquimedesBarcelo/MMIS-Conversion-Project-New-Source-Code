000200 IDENTIFICATION DIVISION.
000300 PROGRAM-ID.    TFLLOWUP.
000400 AUTHOR.        KURT MOVSESIAN/JIM COFFMAN (MAINTAINER).
000600
000700**************************************************************
000800*                                                            *
000900*   T F L L O W U P  PURCHASE ORDER FOLLOWUP ONLINE CREATION *
001000*    PROGRAM.  THIS PROGRAM ALLOWS A BUYER TO REVIEW ALL     *
001100*    OPEN ORDERS AND PRINT A FOLLOWUP NOTICE.  THE OPEN      *
001200*    ORDER FILE MUST FIRST BE CREATED BY A BATCH PROGRAM     *
001300*    CALLED 'TFLUPFIL.SOURCE'.  THE BUYER FILE NAME IS       *
001400*    'DPOBnnnn' WHERE 'nnnn' IS THE BUYER CODE DESIRED.      *
001500*                                                            *
001600**************************************************************
      *C
      *C 09/12/96  JEFF BUNGO
      *C    EXPAND DATE FIELD FOR YEAR 2000 COMPLIANCE.
      *C    INCLUDE CENTURY ON PO FOLLOW UP DATE.
      *C
001700
001800
001900 ENVIRONMENT DIVISION.
002000 CONFIGURATION SECTION.
002100 SOURCE-COMPUTER.  HP-3000.
002200 OBJECT-COMPUTER.  HP-3000.
002300
       SPECIAL-NAMES. I-O-FEEDBACK IS I-O-FEEDBACK-AREA.

       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT DISPLAY-FILE
                  ASSIGN TO WORKSTATION-ZFLLOWUP-SI
                  ORGANIZATION IS TRANSACTION
                  ACCESS IS SEQUENTIAL
                  FILE STATUS IS DISPLAY-STATUS
                  CONTROL-AREA IS WS-CONTROL.

           SELECT DPORECD-O
                  ASSIGN TO DATABASE-MCFLCS0901
                  ORGANIZATION IS INDEXED
                    ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                    WITH DUPLICATES
                  FILE STATUS IS FILE-STATUS.

           SELECT MBUYER-I
                  ASSIGN TO DATABASE-MCFLCS0601
                  ORGANIZATION IS INDEXED
                    ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                  FILE STATUS IS FILE-STATUS.

           SELECT MPLTINFO-I
                  ASSIGN TO DATABASE-MCFLCS0501
                  ORGANIZATION IS INDEXED
                    ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                  FILE STATUS IS FILE-STATUS.

           SELECT DPOITEM-I
                  ASSIGN TO DATABASE-MCFLCS1002
                  ORGANIZATION IS INDEXED
                    ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                    WITH DUPLICATES
                  FILE STATUS IS FILE-STATUS.
           SELECT MCOMMENT-I
                  ASSIGN TO DATABASE-MCFLCS1801
                  ORGANIZATION IS INDEXED
                    ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                  FILE STATUS IS FILE-STATUS.

           SELECT DVENDOR-I
                  ASSIGN TO DATABASE-MCFLCS0701
                  ORGANIZATION IS INDEXED
                    ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                    WITH DUPLICATES
                  FILE STATUS IS FILE-STATUS.

003200     SELECT FOLLOWUP-FILE ASSIGN TO DATABASE-DPOBUYER
                  ORGANIZATION IS RELATIVE
                    ACCESS MODE IS DYNAMIC
                  RELATIVE KEY IS RELATIVE-KEY
                  FILE STATUS IS FILE-STATUS.
