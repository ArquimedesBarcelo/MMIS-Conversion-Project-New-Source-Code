051600*     6 - M A I N                                *
051700*                                                *
051800**************************************************
051900
052000 6-MAIN.
052100     PERFORM 61-PROCESS-SCREEN-1  THRU  61-PS1-X.
052200     IF EOJ-SW = "Y"
052300         GO TO 6-M-X.
052400
052500     PERFORM 62-PROCESS-SCREEN-2  THRU  62-PS2-X.
052600     GO TO 6-MAIN.
052700
052800 6-M-X.
052900     EXIT.
053000
053100
053200
053300 61-PROCESS-SCREEN-1.
053400     MOVE "FLWUP1"  TO  VIEW-NFNAME.
054900     MOVE SPACES                  TO  SCREEN-1.
055000     MOVE COMPANY-SAVE            TO  DE1-COMPANY.
055100     MOVE SAVE-STD-INST-TABLE     TO  DE1-STD-INST-TABLE.
055800
055900 61-SHOWFORM-SCREEN-1.
           MOVE SCREEN-1       TO DISPLAY-REC.
           PERFORM 998-WRITE-SCREEN THRU 998-READ-SCREEN.
           MOVE DISPLAY-REC    TO SCREEN-1.
056600
056700     IF VIEW-LASTKEY = 3
056800         MOVE "Y"                 TO  EOJ-SW
056900         GO TO 61-PS1-X
057000     ELSE
058400     IF VIEW-LASTKEY = 1 OR
058500        VIEW-LASTKEY = 2 OR
058600        VIEW-LASTKEY = 4 OR
058700        VIEW-LASTKEY = 5 OR
058800        VIEW-LASTKEY = 6 OR
058900        VIEW-LASTKEY = 7 OR
              VIEW-LASTKEY = 8
059100*        "* INVALID FUNCTION KEY ENTERED *"
059200         MOVE   9 TO LANG-SETNUM
059300         MOVE  10 TO LANG-MSGNUM
059400         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
059500         MOVE 2  TO  FIELD-NUMBER
059600         PERFORM 4-PGM-ERROR  THRU  4-PGM-ERROR-X
059700         GO TO 61-SHOWFORM-SCREEN-1.
059800
      *------ FIELD EDITS
           IF DE1-BUYER-CODE = SPACES
      *         YOU MUST ENTER A BUYER CODE
               MOVE 44036 TO CATREAD-MSG-NUMBER
069800         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
069900         MOVE 2  TO FIELD-NUMBER
070000         PERFORM 4-PGM-ERROR  THRU  4-PGM-ERROR-X
070100         GO TO 61-SHOWFORM-SCREEN-1.
061700
061800*****************************************************
061900*                                                   *
062000*    EDIT BUYER CODE                                *
062100*                                                   *
062200*****************************************************
062300
062400 61-EDIT-BUYER-CODE.
062500     IF DE1-BUYER-CODE = "****"
062600         MOVE SPACES              TO  DE1-BUYER-CODE.
062700     MOVE DE1-BUYER-CODE          TO  BUYER-ARG.
           MOVE BUYER-ARG TO BUYERCDE OF MBUYER-REC-I.
           START MBUYER-I KEY = BUYERCDE OF MBUYER-REC-I
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
063200*            "BUYER CODE DOES NOT EXIST"
063300             MOVE   2 TO LANG-SETNUM
063400             MOVE   4 TO LANG-MSGNUM
063500             PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
063600             MOVE MESSAGE-BUFFER TO MSG-TEXT
063700             MOVE BUYER-ARG  TO  MSG-FLD
063800             MOVE 2       TO  FIELD-NUMBER
063900             PERFORM 4-PGM-ERROR  THRU  4-PGM-ERROR-X
064000             GO TO 61-SHOWFORM-SCREEN-1
064100         ELSE
064200             MOVE "GET MBUYER * 61-EBC"  TO  BU-DISPLAY-MSG
064300             MOVE BUYER-ARG             TO  BU-DISPLAY-FLD (2)
064400             GO TO 2-BLOWUP.
064500
064600 61-EDIT-STD-INSTS.
064700     MOVE DE1-STD-INST (1)        TO  STD-INST (1).
064800     MOVE DE1-STD-INST (2)        TO  STD-INST (2).
064900     MOVE DE1-STD-INST (3)        TO  STD-INST (3).
065000     MOVE 2                       TO  FIELD-NUMBER.
065100     PERFORM 63-EDIT-STD-INST  THRU  63-ESI-X.
065200     IF ERR-SW = "Y"
065300         GO TO 61-SHOWFORM-SCREEN-1.
065400
065500 61-OPEN-BUYER-FILE.
065600     PERFORM 611-LEFT-SHIFT-BUYER-CODE  THRU  611-LSBC-X.
065700     MOVE BUYER-CODE-WORK-AREA    TO  BUYER-CODE-PART.
065800
           MOVE BUYER-FILE-NAME TO CHKOBJ-FILE-NAME.
           CALL "CCHKOBJ" USING CHKOBJ-FILE-NAME,
                                CHKOBJ-RETURN-STATUS.
           IF CHKOBJ-RETURN-STATUS NOT = "00"
067700*        "FOLLOWUP FILE DOES NOT EXIST FOR BUYER CODE"
067800         MOVE 6   TO LANG-SETNUM
067900         MOVE 19  TO LANG-MSGNUM
