       IDENTIFICATION DIVISION.
       PROGRAM-ID.             TEQRFSPR.
       AUTHOR.                 W. ROXBURY.
       INSTALLATION.           GOODYEAR TIRE & RUBBER CO.
      *REMARKS.                THIS PROGRAM DISPLAYS THE SPARE PARTS LIST
      *                        FOR A GIVEN EQUIPMENT/SUBSYSTEM
      *                        SUBROUTINES CALLED:
      *                          TSUBCRWS
      *                          TMNPARCD
      *                          CDESC
      *                          ****.
      *C
      *C****************************************************************
      *C  08-28-92  BK DISMUKES  REQUEST# 6254
      *C    1. ADDED CALL TO MPLTINFO TO PASS COMPANY NUMBER TO
      *C       SUB-PROGRAMS.
      *C****************************************************************
      *C
       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.
       SOURCE-COMPUTER.        IBM-AS400.
       OBJECT-COMPUTER.        IBM-AS400.

       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT CORP-CODE-LINK
                  ASSIGN       TO DATABASE-MCFLMM2101
                  ORGANIZATION IS INDEXED
                  ACCESS MODE  IS DYNAMIC
                  RECORD KEY   IS EXTERNALLY-DESCRIBED-KEY
                               WITH DUPLICATES
                  FILE STATUS  IS FILE-STAT.

           SELECT CC-NOTE-MSTR
                  ASSIGN       TO DATABASE-MCFLMM2201
                  ORGANIZATION IS INDEXED
                  ACCESS MODE  IS DYNAMIC
                  RECORD KEY   IS EXTERNALLY-DESCRIBED-KEY
                  FILE STATUS  IS FILE-STAT.

           SELECT MPLTINFO-I
                  ASSIGN       TO DATABASE-MCFLCS0501
                  ORGANIZATION IS INDEXED
                  ACCESS MODE  IS DYNAMIC
                  RECORD KEY   IS EXTERNALLY-DESCRIBED-KEY
                  FILE STATUS  IS FILE-STAT.

           SELECT DISPLAY-FILE
                  ASSIGN       TO WORKSTATION-ZEQPREFI-SI
                  ORGANIZATION IS TRANSACTION
                  ACCESS MODE  IS SEQUENTIAL
                  FILE STATUS  IS SCREEN-STATUS
                               MAJOR-MINOR
                  CONTROL-AREA IS SCREEN-CONTROL.

           SELECT OUT-FILE
                  ASSIGN       TO DISK-FEQRFSPR
                  ORGANIZATION IS RELATIVE
                  ACCESS MODE  IS DYNAMIC
                  RELATIVE KEY IS ACT-KEY
                  FILE STATUS  IS FILE-STAT.

           SELECT SORT-FILE
                  ASSIGN       TO DISK-SORTFILE.

       DATA DIVISION.
       FILE SECTION.
       FD  CORP-CODE-LINK
           LABEL RECORDS       ARE STANDARD.
       01  CC-REC.
           COPY DDS-ALL-FORMATS OF MCFLMM2101.

       FD  CC-NOTE-MSTR
           LABEL RECORDS       ARE STANDARD.
       01  MN-REC.
           COPY DDS-ALL-FORMATS OF MCFLMM2201.

       FD  MPLTINFO-I
           LABEL RECORDS       ARE STANDARD.
       01  MPLTINFO-REC-I.
           COPY DDS-ALL-FORMATS OF MCFLCS0501.

       FD  DISPLAY-FILE
           LABEL RECORDS       ARE OMITTED.
       01  DISPLAY-REC         PIC X(2000).

       FD  OUT-FILE RECORD     CONTAINS 254 CHARACTERS
           LABEL RECORDS       ARE OMITTED
           DATA RECORD         IS OUT-REC.
       01  OUT-REC.
           05  CORP-CODE-OUT   PIC X(07).
           05  KEYWORD-OUT     PIC X(20).
           05  LINKFLAG-OUT    PIC X(01).
           05  ADJECTIVE-OUT   PIC X(30).
           05  MFG-OUT         PIC X(31).
           05  PART-NO-OUT     PIC X(15).
           05  MACH-NOTE-OUT   PIC X(70).
           05  DESC1-OUT       PIC X(80).

       SD  SORT-FILE RECORD    CONTAINS 254 CHARACTERS
           DATA RECORD         IS SORT-REC.
       01  SORT-REC.
           05  CORP-CODE-SORT  PIC X(07).
           05  KEYWORD-SORT    PIC X(20).
           05  LINKFLAG-SORT   PIC X(01).
           05  ADJECTIVE-SORT  PIC X(30).
           05  MFG-SORT        PIC X(31).
           05  PART-NO-SORT    PIC X(15).
           05  MACH-NOTE-SORT  PIC X(70).
           05  DESC1-SORT      PIC X(80).

       WORKING-STORAGE SECTION.
       77  PASS                PIC 9           VALUE 1.
           88  FIRSTPASS                       VALUE 1.
       77  HIER-KEY-KEY        PIC X(14).
       77  EOF-CTR             PIC 9           VALUE 0.
       77  EOF-SW              PIC 9           VALUE 0.
       77  MAX-SW              PIC 9           VALUE 0.
       77  FIND-SW             PIC 9           VALUE 0.
       77  OUT-FILE-SW         PIC 9           VALUE 0.
           88  FILE-OPEN                       VALUE 1.
       77  SUB                 PIC 9999        VALUE 0.
       77  ACT-KEY             PIC 9(08).
       77  MAX-KEY             PIC 9(08).
       77  SCR-CTR             PIC 999.
       77  SCR-MAX             PIC 999.
       77  LINK-FLAG           PIC X(01).
       77  BASE                PIC X(10).
       77  BASE2-10            PIC X(10).
       77  BU-DISP-MSG         PIC X(60).

       01  PASSWORD-INFORMATION.
           05  NAME-OF-PROGRAM     PIC X(08) VALUE "TEQRFSPR".
           05  PROGRAM-TYPE        PIC X(02) VALUE "IN".
           05  PROGRAM-RELEASE     PIC X(12) VALUE " E0100010001".
           05  PROGRAM-DESCRIPTION.
               10  PROG-DESC-A1    PIC X(30) VALUE
                   "EQUIPMENT REFERENCE FILE SPARE".
               10  PROG-DESC-A2    PIC X(30) VALUE
                   " PARTS LINKAGE INQUIRY.       ".
               10  PROG-DESC-B1    PIC X(30) VALUE
                   "DISPLAYS SPARE PARTS LISTS LIN".
               10  PROG-DESC-B2    PIC X(30) VALUE
                   "KED TO SPECIFIC SUBSYSTEMS.   ".
               10  PROG-FUNCTION1  PIC X(30) VALUE
                   "RUNS FROM THE f5 KEY OF THE EQ".
               10  PROG-FUNCTION2  PIC X(30) VALUE
                   "UIP. REF. INQUIRY PROGRAM MENU".
           05  PASSWORD-FLAG   PIC X.

       01  FILE-STAT.
           05  FILE-STAT-1     PIC X  VALUE "0".
           05  FILE-STAT-2     PIC X  VALUE "0".

       01 ARG-VALUES.
           05  PLT-ARG         PIC X(4)  VALUE SPACES.

       01  RET-MNPARCD-DATA.
           05  RET-MFG         PIC X(26).
           05  RET-PRT         PIC X(20).
           05  RET-KEYWD       PIC X(20).
           05  RET-ADJ         PIC X(30).

       01  CSIS-PARMS.
           05  MPLANT          PIC X(4).
           05  RET-CODE        PIC XX.
           05  RETURN-COD      PIC S9(4) COMP-4.
           05  FUNC-SW         PIC S9(4) COMP-4 VALUE 4.
           05  BASE1           PIC X(24).
           05  BASE2           PIC X(24).
           05  RET-CC          PIC X(8).

       01  SCREEN-DATA.
           05  EQP-NUM-BUFFER        PIC X(06).
           05  DISP-SUB-SYS.
               10  SUB-SYS-DISP      PIC X(04).
               10  SUB-SYS-DESC      PIC X(50).
           05  DISP-BUFFER.
               10  DES1-BUF.
                   15  SEL1-B        PIC X(01).
                   15  DES1-B        PIC X(78).
               10  DES2-BUF.
                   15  SEL2-B        PIC X(01).
                   15  DES2-B        PIC X(78).
               10  DES3-BUF.
                   15  SEL3-B        PIC X(01).
                   15  DES3-B        PIC X(78).
               10  DES4-BUF.
                   15  SEL4-B        PIC X(01).
                   15  DES4-B        PIC X(78).
               10  DES5-BUF.
                   15  SEL5-B        PIC X(01).
                   15  DES5-B        PIC X(78).
               10  DES6-BUF.
                   15  SEL6-B        PIC X(01).
                   15  DES6-B        PIC X(78).
               10  DES7-BUF.
                   15  SEL7-B        PIC X(01).
                   15  DES7-B        PIC X(78).
               10  DES8-BUF.
                   15  SEL8-B        PIC X(01).
                   15  DES8-B        PIC X(78).
               10  DES9-BUF.
                   15  SEL9-B        PIC X(01).
                   15  DES9-B        PIC X(78).
               10  DES10-BUF.
                   15  SEL10-B       PIC X(01).
                   15  DES10-B       PIC X(78).
               10  DES11-BUF.
                   15  SEL11-B       PIC X(01).
                   15  DES11-B       PIC X(78).
               10  DES12-BUF.
                   15  SEL12-B       PIC X(01).
                   15  DES12-B       PIC X(78).
               10  DES13-BUF.
                   15  SEL13-B       PIC X(01).
                   15  DES13-B       PIC X(78).
               10  DES14-BUF.
                   15  SEL14-B       PIC X(01).
                   15  DES14-B       PIC X(78).
               10  DES15-BUF.
                   15  SEL15-B       PIC X(01).
                   15  DES15-B       PIC X(78).
           05  SCREEN-MSGS.
               10  CMDMSG            PIC X(79).
               10  ERRMSG            PIC X(79).

       01  PAGE-TABLE.
           05  SCRN            OCCURS 300 TIMES PIC 9(08).

       01  DESC-TABLE.
           05  DESX            OCCURS 15 TIMES  PIC X(79).

       01  HOLD-BUFFER.
           05  DES1-HOLD.
               10  SEL1-H      PIC X(01).
               10  CHK1-H      PIC X(01).
               10  DES1-H      PIC X(77).
           05  DES2-HOLD.
               10  SEL2-H      PIC X(01).
               10  CHK2-H      PIC X(01).
               10  DES2-H      PIC X(77).
           05  DES3-HOLD.
               10  SEL3-H      PIC X(01).
               10  CHK3-H      PIC X(01).
               10  DES3-H      PIC X(77).
           05  DES4-HOLD.
               10  SEL4-H      PIC X(01).
               10  CHK4-H      PIC X(01).
               10  DES4-H      PIC X(77).
           05  DES5-HOLD.
               10  SEL5-H      PIC X(01).
               10  CHK5-H      PIC X(01).
               10  DES5-H      PIC X(77).
           05  DES6-HOLD.
               10  SEL6-H      PIC X(01).
               10  CHK6-H      PIC X(01).
               10  DES6-H      PIC X(77).
           05  DES7-HOLD.
               10  SEL7-H      PIC X(01).
               10  CHK7-H      PIC X(01).
               10  DES7-H      PIC X(77).
           05  DES8-HOLD.
               10  SEL8-H      PIC X(01).
               10  CHK8-H      PIC X(01).
               10  DES8-H      PIC X(77).
           05  DES9-HOLD.
               10  SEL9-H      PIC X(01).
               10  CHK9-H      PIC X(01).
               10  DES9-H      PIC X(77).
           05  DES10-HOLD.
               10  SEL10-H     PIC X(01).
               10  CHK10-H     PIC X(01).
               10  DES10-H     PIC X(77).
           05  DES11-HOLD.
               10  SEL11-H     PIC X(01).
               10  CHK11-H     PIC X(01).
               10  DES11-H     PIC X(77).
           05  DES12-HOLD.
               10  SEL12-H     PIC X(01).
               10  CHK12-H     PIC X(01).
               10  DES12-H     PIC X(77).
           05  DES13-HOLD.
               10  SEL13-H     PIC X(01).
               10  CHK13-H     PIC X(01).
               10  DES13-H     PIC X(77).
           05  DES14-HOLD.
               10  SEL14-H     PIC X(01).
               10  CHK14-H     PIC X(01).
               10  DES14-H     PIC X(77).
           05  DES15-HOLD.
               10  SEL15-H     PIC X(01).
               10  CHK15-H     PIC X(01).
               10  DES15-H     PIC X(77).

       01  CORP-CODE-DATA.
           05  HIER-KEY        PIC X(14).
           05  CC-LINK         PIC X(08).

       01  CORP-CODE-CHECK.
           05  HIER-KEY-CHECK.
               10  HIER-KEY-TYPE.
                   15  HIER-KEY-EQP  PIC X(06).
                   15  FILLER        PIC X(02).
               10  HIER-KEY-SUBS     PIC X(04).
               10  FILLER            PIC XX.
           05  CC-LINK-CHECK         PIC X(08).

       01  PART-TABLE.
           05  PART            OCCURS 8 TIMES   PIC X(07).

       01  CC-NOTE-DATA.
           05  NOTE-KEY        PIC X(22).
           05  MACH-NOTE       PIC X(76).
           05  NOTE-PAD        PIC X(10).

       01  DATA-LINE.
           05  CC-DATA         PIC X(07).
           05  FILLER          PIC X.
           05  KEYWORD         PIC X(20).
           05  FILLER          PIC X.
           05  ADJECT          PIC X(18).
           05  FILLER          PIC X.
           05  MFG             PIC X(15).
           05  FILLER          PIC X.
           05  PART-NO         PIC X(14).
           05  LINKFLAG        PIC X(01).

       01  NOTE-LINE.
           05  FILLER          PIC X(09) VALUE "  NOTE:  ".
           05  M-NOTE          PIC X(70).

       01  CDESC-LINE.
           05  FILLER          PIC XX    VALUE "  ".
           05  DESC-LINE       PIC X(77).
           05  FILLER          PIC X(03).

       01  DB-ERROR.
           05  DB-FUNC         PIC X(10) VALUE SPACES.
           05  DB-FILE         PIC X(18) VALUE SPACES.
           05  FILLER          PIC X(20) VALUE "ERROR - FILE-STAT = ".
           05  CON-WORD        PIC XX.

       01  CDESC-DATA.
           05  CDESC-LINES-TO-GET        PIC S9(4) COMP-4.
           05  CDESC-LINES-GOT           PIC S9(4) COMP-4.
           05  CDESC-LANGUAGE-OPTION     PIC X(1).
           05  CDESC-DESC-OPTION         PIC X(1).
           05  CDESC-MANUFACT-OPTION     PIC X(1).
           05  CDESC-LOCAL-DESC-OPTION   PIC X(1).
           05  CDESC-PAD                 PIC X(10).
           05  CDESC-TABLE               OCCURS 25 TIMES.
               10  CDESC-TYPE            PIC X(1).
               10  CDESC-MAN-SELCT       PIC X(1).
               10  CDESC                 PIC X(80).

           COPY SCREENIO       IN COPYLIB.

           COPY CATREAD        IN COPYLIB.

           COPY ESCNAM2        IN COPYLIB.

           COPY MPLT0          IN COPYLIB.

           COPY MPLTP01        IN COPYLIB.

           COPY TBLOWUP        IN COPYLIB.

           COPY ERRORLIN       IN COPYLIB.

       COPY DBSTAT    IN COPYLIB.

       COPY VCOMLINK  IN COPYLIB.

       COPY LANGSUB   IN COPYLIB.

       LINKAGE SECTION.
       01  DBPARAMETERS.
           COPY DBPARMS        IN COPYLIB.

       01  EQP-SUB-BUFFER.
           05  EQP-NUM-BUF         PIC X(06).
           05  SUB-SYS-BUF         PIC X(04).
           05  EQP-SUB-DESC-BUF    PIC X(50).
           05  EQP-TYPE-BUF        PIC X(08).

       01  SWITCHES.
           05  EQPREF-SW       PIC X.
           05  EQPREM-SW       PIC X.
           05  EQPOPS-SW       PIC X.
           05  PARTS-SW        PIC X.
           05  ACTIVE-KEY      PIC 99.

       01  EXECUTIVE-DATA.
           05  X-WO-NUM        PIC X(10).
           05  X-CC-NUM        PIC X(04).
           05  X-EQUIP-NUM     PIC X(06).
           05  X-PARTS.
               10  PART-1      PIC X(07).
               10  PART-2      PIC X(07).
               10  PART-3      PIC X(07).
               10  PART-4      PIC X(07).
               10  PART-5      PIC X(07).
               10  PART-6      PIC X(07).
               10  PART-7      PIC X(07).
               10  PART-8      PIC X(07).

       PROCEDURE DIVISION      USING DBPARAMETERS
                               EQP-SUB-BUFFER
                               SWITCHES
                               EXECUTIVE-DATA.

       BEGIN-SORT-PROC         SECTION 01.
           CALL "TPWORD"       USING PASSWORD-INFORMATION.
           IF PASSWORD-FLAG NOT = "N"
               GO TO START-PROC.
           GOBACK.

       2-BLOWUP.
           MOVE "TEQRFSPR"     TO  BU-PGM-NAME.
           CALL "TBLOWUP"      USING
                               BASE
                               BU-PGM-NAME
                               STATUS-AREA
                               VIEW-COMAREA
                               FILE-STAT
                               BU-DISPLAY-MSG
                               BU-DISPLAY-FLDS.

       2-BLOWUP-X.             EXIT.

       START-PROC.
           CALL "CLEQRFSPR".
           OPEN I-O            DISPLAY-FILE.
           OPEN INPUT          CORP-CODE-LINK,
                               CC-NOTE-MSTR,
                               MPLTINFO-I.

           MOVE SPACES         TO SCREEN-DATA, BU-DISP-MSG.
           MOVE "VSPRPAGE"     TO SCREEN-NAME.

           CALL "TESCSEQ"      USING ESC-NAME.
           MOVE ZEROS          TO PAGE-TABLE.
           MOVE 0              TO EOF-CTR EOF-SW FIND-SW
                                  OUT-FILE-SW MAX-SW
                                  SCR-CTR SCR-MAX KEY-HIT.
           MOVE 2              TO CDESC-LINES-TO-GET.
           MOVE "P"            TO CDESC-LANGUAGE-OPTION.
           MOVE "D"            TO CDESC-DESC-OPTION.
           MOVE " "            TO CDESC-MANUFACT-OPTION.
           MOVE "N"            TO CDESC-LOCAL-DESC-OPTION.

           MOVE "P 01"         TO  PLT-ARG.
           MOVE PLT-ARG        TO PLTINFOKEY OF MPLTINFO-REC-I.
           READ MPLTINFO-I     INTO BUF-MPLTINFO
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
               MOVE "GET PLT CODE" TO  BU-DISPLAY-MSG
               MOVE PLT-ARG        TO  BU-DISPLAY-FLD (1)
               GO TO 2-BLOWUP.

           MOVE MPLTINFO-COMPANY   TO  MPLANT.

       6-MAIN.
           MOVE "VSPRPAGE"     TO SCREEN-NAME.
           MOVE EQP-NUM-BUF    TO EQP-NUM-BUFFER.
           MOVE SUB-SYS-BUF    TO SUB-SYS-DISP.
           MOVE EQP-SUB-DESC-BUF TO SUB-SYS-DESC.

           IF EQP-TYPE-BUF = "00000000"
               MOVE SPACES     TO DISP-BUFFER DESC-TABLE
               MOVE SPACES     TO HOLD-BUFFER MESSAGE-BUFFER
               MOVE  40        TO CATREAD-MSG-SET
               MOVE  70        TO CATREAD-MSG-NUM
      **MESSAGE******************************************************
      ** NO SPARE PARTS LINKED FOR THIS SUBSYSTEM                  **
      ***************************************************************
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER TO CMDMSG
               GO TO 61-SHOWFORM.

           MOVE 0              TO ACT-KEY.
           MOVE SPACES         TO MESSAGE-BUFFER.
           SORT SORT-FILE      ASCENDING KEY
                               KEYWORD-SORT ADJECTIVE-SORT
             INPUT PROCEDURE   SORT-IN-RECS
             OUTPUT PROCEDURE  SORT-OUT-RECS.

           IF MESSAGE-BUFFER NOT = SPACES
               MOVE MESSAGE-BUFFER TO CMDMSG
               GO TO 61-SHOWFORM.

           IF ACT-KEY = 0
               MOVE SPACES     TO DISP-BUFFER DESC-TABLE
               MOVE SPACES     TO HOLD-BUFFER MESSAGE-BUFFER
               MOVE  40        TO CATREAD-MSG-SET
               MOVE  11        TO CATREAD-MSG-NUM
      **MESSAGE******************************************************
      ** NO RECORDS FOUND WHICH MATCH YOUR SELECTION               **
      ***************************************************************
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER TO CMDMSG
               GO TO 61-SHOWFORM.

           OPEN INPUT          OUT-FILE.
           MOVE 1              TO SCR-CTR OUT-FILE-SW.
           MOVE 0              TO ACT-KEY.

       61-RESET-SCREEN.
           MOVE SPACES         TO DISP-BUFFER DESC-TABLE.
           MOVE SPACES         TO HOLD-BUFFER MESSAGE-BUFFER.
           MOVE 0              TO SUB EOF-CTR.
           PERFORM 62-FILL-SCREEN THRU 62-FS-EXIT
                               UNTIL SUB = 15.
           IF EOF-CTR = 0
               GO TO 61-RESET-SCREEN.
           MOVE DESC-TABLE     TO DISP-BUFFER HOLD-BUFFER.

       61-SHOWFORM.
           IF EQPREF-SW = "Y"
               MOVE B"1"       TO IND(50).
           IF EQPREM-SW = "Y"
               MOVE B"1"       TO IND(51).
           IF EQPOPS-SW = "Y"
               MOVE B"1"       TO IND(52).

           MOVE "00"           TO SCREEN-STATUS.
           MOVE SCREEN-DATA    TO DISPLAY-REC.

           WRITE DISPLAY-REC  FORMAT IS SCREEN-NAME
               INDIC ARE SCREEN-INDICATORS.
           IF SCREEN-STATUS NOT = "00"
               DISPLAY "SCREEN WRITE ERROR.  SCREEN-STATUS IS "
                        SCREEN-STATUS
               GO TO END-OF-JOB.

           READ  DISPLAY-FILE FORMAT IS SCREEN-NAME
               INDIC ARE SCREEN-INDICATORS
           IF SCREEN-STATUS NOT = "00"
               DISPLAY "SCREEN READ ERROR.  SCREEN-STATUS IS "
                        SCREEN-STATUS
               GO TO END-OF-JOB.

           MOVE DISPLAY-REC    TO SCREEN-DATA.
           MOVE ALL B"0"       TO SCREEN-INDICATORS.

           IF KEY-HIT = 1 OR 2 OR 3
               MOVE KEY-HIT    TO ACTIVE-KEY
               GO TO END-OF-JOB.

           IF KEY-HIT = 4
               IF EQPREF-SW = "Y"
                   MOVE KEY-HIT TO ACTIVE-KEY
                   GO TO END-OF-JOB
               ELSE
                   GO TO 61-SHOWFORM
           ELSE
           IF KEY-HIT = 5
               IF EQPREM-SW = "Y"
                   MOVE KEY-HIT TO ACTIVE-KEY
                   GO TO END-OF-JOB
               ELSE
                   GO TO 61-SHOWFORM
           ELSE
           IF KEY-HIT = 6
               IF EQPOPS-SW = "Y"
                   MOVE KEY-HIT TO ACTIVE-KEY
                   GO TO END-OF-JOB
               ELSE
                   GO TO 61-SHOWFORM
           ELSE
           IF FILE-OPEN
               IF KEY-HIT = 9
                   SUBTRACT 1             FROM SCR-CTR
                   IF SCR-CTR = 0
                       MOVE SCR-MAX       TO SCR-CTR
                       MOVE 0             TO EOF-SW
                       MOVE SCRN(SCR-CTR) TO ACT-KEY
                   ELSE
                       MOVE 0             TO EOF-SW
                       MOVE SCRN(SCR-CTR) TO ACT-KEY
               ELSE
                   ADD 1                  TO SCR-CTR
                   IF MAX-SW = 1
                       IF SCR-CTR > SCR-MAX
                           MOVE 1         TO SCR-CTR.

           IF FILE-OPEN
               NEXT SENTENCE
           ELSE
               GO TO 61-SHOWFORM.

           IF DESC-TABLE = DISP-BUFFER
               IF EOF-SW = 1
                   MOVE 0      TO EOF-SW
                   MOVE 0      TO ACT-KEY
                   GO TO 61-RESET-SCREEN
               ELSE
                   GO TO 61-RESET-SCREEN
           ELSE
               PERFORM 63-MATLSTAT THRU 63-MATLSTAT-EXIT
               MOVE DESC-TABLE TO DISP-BUFFER
               MOVE "VSPRPAGE" TO SCREEN-NAME
               GO TO 61-SHOWFORM.

       62-FILL-SCREEN.
           ADD 1               TO SUB.
           IF SUB > 13
               GO TO 62-FS-EXIT.

           PERFORM 62-READ-FILE THRU 62-RF-EXIT.
           IF EOF-SW = 1
               IF EOF-CTR = 0
                   MOVE 0      TO EOF-SW
                   MOVE 0      TO ACT-KEY
                   GO TO 62-FS-EXIT
               ELSE
                   GO TO 62-FS-EXIT.

           IF KEY-HIT = 9
               NEXT SENTENCE
           ELSE
           IF MAX-SW = 0
             IF SUB = 1
               MOVE ACT-KEY    TO   SCRN(SCR-CTR)
               SUBTRACT 1      FROM SCRN(SCR-CTR)
               MOVE SCR-CTR    TO   SCR-MAX.

           MOVE DATA-LINE      TO DESX(SUB).
           IF DESC-LINE NOT = SPACES
               ADD 1           TO SUB
               MOVE CDESC-LINE TO DESX(SUB).
           IF M-NOTE NOT = SPACES
               ADD 1           TO SUB
               MOVE NOTE-LINE  TO DESX(SUB).

           IF SUB = 14 MOVE 15 TO SUB.

       62-FS-EXIT.             EXIT.

       62-READ-FILE.
           ADD 1               TO ACT-KEY.
           MOVE SPACES         TO OUT-REC.
           READ OUT-FILE       INVALID KEY
               MOVE 1          TO EOF-SW MAX-SW
               MOVE 15         TO SUB
               GO TO 62-RF-EXIT.
           IF ACT-KEY > MAX-KEY
               MOVE 1          TO EOF-SW MAX-SW
               MOVE 15         TO SUB
               GO TO 62-RF-EXIT.

           MOVE 1              TO EOF-CTR.
           MOVE SPACES         TO DATA-LINE M-NOTE CDESC-LINE.
           MOVE CORP-CODE-OUT  TO CC-DATA.
           MOVE LINKFLAG-OUT   TO LINKFLAG.
           MOVE KEYWORD-OUT    TO KEYWORD.
           MOVE ADJECTIVE-OUT  TO ADJECT.
           MOVE MFG-OUT        TO MFG.
           MOVE PART-NO-OUT    TO PART-NO.
           MOVE MACH-NOTE-OUT  TO M-NOTE.
           MOVE DESC1-OUT      TO DESC-LINE.

       62-RF-EXIT.             EXIT.

       63-MATLSTAT.
           MOVE 0              TO SUB.
           MOVE SPACES         TO X-PARTS PART-TABLE.

           IF SEL1-B = SEL1-H
               NEXT SENTENCE
           ELSE
           IF CHK1-H NOT = SPACES
               ADD 1           TO SUB
               MOVE DES1-HOLD  TO DATA-LINE
               MOVE CC-DATA    TO PART(SUB).

           IF SEL2-B = SEL2-H
               NEXT SENTENCE
           ELSE
           IF CHK2-H NOT = SPACES
               ADD 1           TO SUB
               MOVE DES2-HOLD  TO DATA-LINE
               MOVE CC-DATA    TO PART(SUB).

           IF SEL3-B = SEL3-H
               NEXT SENTENCE
           ELSE
           IF CHK3-H NOT = SPACES
               ADD 1           TO SUB
               MOVE DES3-HOLD  TO DATA-LINE
               MOVE CC-DATA    TO PART(SUB).

           IF SEL4-B = SEL4-H
               NEXT SENTENCE
           ELSE
           IF CHK4-H NOT = SPACES
               ADD 1           TO SUB
               MOVE DES4-HOLD  TO DATA-LINE
               MOVE CC-DATA    TO PART(SUB).

           IF SEL5-B = SEL5-H
               NEXT SENTENCE
           ELSE
           IF CHK5-H NOT = SPACES
               ADD 1           TO SUB
               MOVE DES5-HOLD  TO DATA-LINE
               MOVE CC-DATA    TO PART(SUB).

           IF SEL6-B = SEL6-H
               NEXT SENTENCE
           ELSE
           IF CHK6-H NOT = SPACES
               ADD 1           TO SUB
               MOVE DES6-HOLD  TO DATA-LINE
               MOVE CC-DATA    TO PART(SUB).

           IF SEL7-B = SEL7-H
               NEXT SENTENCE
           ELSE
           IF CHK7-H NOT = SPACES
               ADD 1           TO SUB
               MOVE DES7-HOLD  TO DATA-LINE
               MOVE CC-DATA    TO PART(SUB).

           IF SEL8-B = SEL8-H
               NEXT SENTENCE
           ELSE
           IF CHK8-H NOT = SPACES
               ADD 1           TO SUB
               MOVE DES8-HOLD  TO DATA-LINE
               MOVE CC-DATA    TO PART(SUB).

           IF SEL9-B = SEL9-H
               NEXT SENTENCE
           ELSE
           IF SUB = 8
               GO TO 63-MATLSTAT-CONT
           ELSE
           IF CHK9-H NOT = SPACES
               ADD 1           TO SUB
               MOVE DES9-HOLD  TO DATA-LINE
               MOVE CC-DATA    TO PART(SUB).

           IF SEL10-B = SEL10-H
               NEXT SENTENCE
           ELSE
           IF SUB = 8
               GO TO 63-MATLSTAT-CONT
           ELSE
           IF CHK10-H NOT = SPACES
               ADD 1           TO SUB
               MOVE DES10-HOLD TO DATA-LINE
               MOVE CC-DATA    TO PART(SUB).

           IF SEL11-B = SEL11-H
               NEXT SENTENCE
           ELSE
           IF SUB = 8
               GO TO 63-MATLSTAT-CONT
           ELSE
           IF CHK11-H NOT = SPACES
               ADD 1           TO SUB
               MOVE DES11-HOLD TO DATA-LINE
               MOVE CC-DATA    TO PART(SUB).

           IF SEL12-B = SEL12-H
               NEXT SENTENCE
           ELSE
           IF SUB = 8
               GO TO 63-MATLSTAT-CONT
           ELSE
           IF CHK12-H NOT = SPACES
               ADD 1           TO SUB
               MOVE DES12-HOLD TO DATA-LINE
               MOVE CC-DATA    TO PART(SUB).

           IF SEL13-B = SEL13-H
               NEXT SENTENCE
           ELSE
           IF SUB = 8
               GO TO 63-MATLSTAT-CONT
           ELSE
           IF CHK13-H NOT = SPACES
               ADD 1           TO SUB
               MOVE DES13-HOLD TO DATA-LINE
               MOVE CC-DATA    TO PART(SUB).

           IF SEL14-B = SEL14-H
               NEXT SENTENCE
           ELSE
           IF SUB = 8
               GO TO 63-MATLSTAT-CONT
           ELSE
           IF CHK14-H NOT = SPACES
               ADD 1           TO SUB
               MOVE DES14-HOLD TO DATA-LINE
               MOVE CC-DATA    TO PART(SUB).

           IF SEL15-B = SEL15-H
               NEXT SENTENCE
           ELSE
           IF SUB = 8
               GO TO 63-MATLSTAT-CONT
           ELSE
           IF CHK15-H NOT = SPACES
               ADD 1           TO SUB
               MOVE DES15-HOLD TO DATA-LINE
               MOVE CC-DATA    TO PART(SUB).

       63-MATLSTAT-CONT.
           IF PART-TABLE = SPACES
               GO TO 63-MATLSTAT-EXIT
           ELSE
               PERFORM 63-CALL-MATL.

       63-MATLSTAT-EXIT.       EXIT.

       63-CALL-MATL.
           MOVE PART-TABLE     TO X-PARTS
           MOVE 1              TO RETURN-COD.

           CALL "TSUBCRWS" USING RETURN-COD
                                 BASE2
                                 BASE1
                                 STATUS-AREA
                                 VIEW-COMAREA
                                 LANGUAGE-PARMS
                                 EXECUTIVE-DATA
                                 MPLANT
                                 ESC-NAME.

       END-OF-JOB.
           CLOSE               DISPLAY-FILE,
                               CORP-CODE-LINK,
                               CC-NOTE-MSTR,
                               MPLTINFO-I.
           IF FILE-OPEN
               CLOSE           OUT-FILE.
           GOBACK.

       999-CATREAD.
           MOVE SPACES         TO MESSAGE-BUFFER.
           CALL "CCATREAD" USING CATREAD-PARMS.
           MOVE CATREAD-MSG-TEXT TO MESSAGE-BUFFER.

       999-CATREAD-EXIT.       EXIT.

       SORT-IN-RECS SECTION 02.
           MOVE 0              TO FIND-SW.
           MOVE SPACES         TO CORP-CODE-DATA CORP-CODE-CHECK
                                  HIER-KEY-KEY.
           MOVE 1              TO PASS.
           MOVE EQP-NUM-BUF    TO HIER-KEY-EQP.
           MOVE SUB-SYS-BUF    TO HIER-KEY-SUBS.
           MOVE SPACE          TO LINK-FLAG.
           PERFORM SORT-MAIN   THRU SORT-M-EXIT.

           MOVE 2              TO PASS.
           MOVE EQP-TYPE-BUF   TO HIER-KEY-TYPE.
           MOVE SUB-SYS-BUF    TO HIER-KEY-SUBS.
           MOVE "<"            TO LINK-FLAG.
           PERFORM SORT-MAIN   THRU SORT-M-EXIT.
           GO TO SORT-IP-EXIT.

       SORT-MAIN.
           MOVE HIER-KEY-CHECK TO HIER-KEY HIER-KEY-KEY
                                  HIERKEY OF CORP-CODE-LINK.
           START CORP-CODE-LINK KEY = HIERKEY OF CORP-CODE-LINK
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
               IF FILE-STAT-1 = "2"
                   IF FIND-SW = 1
                       GO TO SORT-M-EXIT
                   ELSE
                   IF FIRSTPASS
                       GO TO SORT-M-EXIT
                   ELSE
                       MOVE SPACES TO DISP-BUFFER DESC-TABLE
                       MOVE SPACES TO HOLD-BUFFER MESSAGE-BUFFER
                       MOVE  40    TO CATREAD-MSG-SET
                       MOVE  70    TO CATREAD-MSG-NUM
      **MESSAGE******************************************************
      ** NO SPARE PARTS LINKED FOR THIS SUBSYSTEM                  **
      ***************************************************************
                       PERFORM SORT-CATREAD THRU SORT-CATREAD-EXIT
                       GO TO SORT-M-EXIT
               ELSE
                   MOVE "CORP-CODE-LINK" TO DB-FILE
                   MOVE "START   " TO DB-FUNC
                   MOVE FILE-STAT  TO CON-WORD
                   MOVE DB-ERROR   TO MESSAGE-BUFFER
                   GO TO SORT-M-EXIT.

           PERFORM SORT-DBGET THRU SORT-DBGET-EXIT.

       SORT-M-EXIT.            EXIT.

       SORT-DBGET.
           MOVE SPACES         TO SORT-REC.
           READ CORP-CODE-LINK NEXT INTO CORP-CODE-CHECK
               AT END          MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
             IF FILE-STAT-1 = "1" OR "2" OR "4"
               IF FIND-SW = 1
                   GO TO SORT-DBGET-EXIT
               ELSE
               IF FIRSTPASS
                   GO TO SORT-DBGET-EXIT
               ELSE
                   MOVE SPACES TO DISP-BUFFER DESC-TABLE
                   MOVE SPACES TO HOLD-BUFFER MESSAGE-BUFFER
                   MOVE  40    TO CATREAD-MSG-SET
                   MOVE  70    TO CATREAD-MSG-NUM
      **MESSAGE******************************************************
      ** NO SPARE PARTS LINKED FOR THIS SUBSYSTEM                  **
      ***************************************************************
                   PERFORM SORT-CATREAD THRU SORT-CATREAD-EXIT
                   GO TO SORT-DBGET-EXIT
           ELSE
               MOVE "CORP-CODE-LINK" TO DB-FILE
               MOVE "READ    " TO DB-FUNC
               MOVE FILE-STAT  TO CON-WORD
               MOVE DB-ERROR   TO MESSAGE-BUFFER
               GO TO SORT-DBGET-EXIT.

           IF HIER-KEY-KEY NOT = HIER-KEY-CHECK
               IF FIND-SW = 1
                   GO TO SORT-DBGET-EXIT
               ELSE
               IF FIRSTPASS
                   GO TO SORT-DBGET-EXIT
               ELSE
                   MOVE SPACES TO DISP-BUFFER DESC-TABLE
                   MOVE SPACES TO HOLD-BUFFER MESSAGE-BUFFER
                   MOVE  40    TO CATREAD-MSG-SET
                   MOVE  70    TO CATREAD-MSG-NUM
      **MESSAGE******************************************************
      ** NO SPARE PARTS LINKED FOR THIS SUBSYSTEM                  **
      ***************************************************************
                   PERFORM SORT-CATREAD THRU SORT-CATREAD-EXIT
                   GO TO SORT-DBGET-EXIT.

           MOVE CC-LINK-CHECK  TO CC-LINK CORP-CODE-SORT.
           MOVE CC-LINK        TO RET-CC.
           MOVE SPACES         TO RET-CODE.

           CALL "TMNPARCD" USING RET-CODE FUNC-SW BASE2
                   STATUS-AREA RET-CC RET-MNPARCD-DATA
                   LANGUAGE-PARMS.

           IF RET-CODE = "NF"
               MOVE "CORPORATE CODE IS NO" TO KEYWORD-SORT
               MOVE "LONGER VALID     " TO ADJECTIVE-SORT
               MOVE 1          TO FIND-SW
               MOVE LINK-FLAG  TO LINKFLAG-SORT
               RELEASE SORT-REC
               GO TO SORT-DBGET
           ELSE
           IF RET-CODE = "BU"
               MOVE "**  DBERROR GETTING "   TO KEYWORD-SORT
               MOVE "STORES INFORMATION  **" TO ADJECTIVE-SORT
               MOVE 1                        TO FIND-SW
               RELEASE SORT-REC
               GO TO SORT-DBGET.

           MOVE RET-KEYWD      TO KEYWORD-SORT.
           MOVE LINK-FLAG      TO LINKFLAG-SORT.
           MOVE RET-ADJ        TO ADJECTIVE-SORT.
           MOVE RET-MFG        TO MFG-SORT.
           MOVE RET-PRT        TO PART-NO-SORT.
           MOVE SPACES         TO DESC1-SORT CDESC-TABLE(2) BU-DISP-MSG.
           MOVE BASE2          TO BASE2-10.
           MOVE SPACES         TO RET-CODE.

           CALL "CDESC" USING RET-CODE BASE2-10 STATUS-AREA
                              BU-DISP-MSG RET-CC CDESC-DATA.

           IF RET-CODE = "BU"
               MOVE BU-DISP-MSG    TO DESC1-SORT
           ELSE
           IF CDESC-LINES-GOT  =  0
               MOVE SPACES         TO DESC1-SORT
           ELSE
               MOVE CDESC-TABLE(2) TO CDESC-LINE
               MOVE DESC-LINE      TO DESC1-SORT.

           MOVE CORP-CODE-CHECK TO NOTEKEY OF CC-NOTE-MSTR.
           READ CC-NOTE-MSTR   INTO CC-NOTE-DATA
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
             IF FILE-STAT = "10" OR "14" OR "46" OR "23"
               MOVE 1          TO FIND-SW
               RELEASE SORT-REC
               GO TO SORT-DBGET
             ELSE
               MOVE "CC-NOTE-MSTR" TO DB-FILE
               MOVE "READ    "     TO DB-FUNC
               MOVE FILE-STAT      TO CON-WORD
               MOVE DB-ERROR       TO MESSAGE-BUFFER
               GO TO SORT-DBGET-EXIT.

           MOVE MACH-NOTE      TO MACH-NOTE-SORT.
           MOVE 1              TO FIND-SW.
           RELEASE SORT-REC.
           GO TO SORT-DBGET.

       SORT-DBGET-EXIT.        EXIT.

       SORT-CATREAD.
           MOVE SPACES         TO MESSAGE-BUFFER.
           CALL "CCATREAD" USING CATREAD-PARMS.
           MOVE CATREAD-MSG-TEXT TO MESSAGE-BUFFER.

       SORT-CATREAD-EXIT.      EXIT.

       SORT-IP-EXIT.           EXIT.

       SORT-OUT-RECS SECTION 03.
           OPEN OUTPUT         OUT-FILE.
           PERFORM SORT-READ-LOOP THRU SRL-EXIT.
           CLOSE               OUT-FILE.
           GO TO SORT-WF-EXIT.

       SORT-READ-LOOP.
           RETURN SORT-FILE AT END
               MOVE ACT-KEY    TO MAX-KEY
               GO TO SRL-EXIT.
           ADD 1               TO ACT-KEY.
           MOVE SORT-REC       TO OUT-REC.
           WRITE OUT-REC INVALID KEY
               DISPLAY "WRITE OUT-FILE ERR"
               GO TO SRL-EXIT.
           GO TO SORT-READ-LOOP.

       SRL-EXIT.               EXIT.

       SORT-WF-EXIT.           EXIT.

