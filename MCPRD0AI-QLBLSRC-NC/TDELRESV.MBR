000200 IDENTIFICATION DIVISION.
000300 PROGRAM-ID.      TDELRESV.
000400 ENVIRONMENT DIVISION.
000500 CONFIGURATION SECTION.
000600 SOURCE-COMPUTER.   AS400.
000700 OBJECT-COMPUTER.   AS400.
      ***************************************************************
      *C 06/06/96
      *C   EXPAND DATE FIELDS FOR YEAR 2000 COMPLIANCE.
      *C   PARMS TO CRESERVE CHANGED TO INCLUDE CENTURY IN DATE FIELD.
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT DISPLAY-FILE
               ASSIGN TO WORKSTATION-ZOFFLINE-SI
               ORGANIZATION IS TRANSACTION
               FILE STATUS IS DSPLY-STATUS
               CONTROL-AREA IS WS-CONTROL.
           SELECT WO-PARTS-FILE
               ASSIGN TO DATABASE-MCFLMM1201
               ORGANIZATION IS INDEXED
               ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY WITH DUPLICATES
               FILE STATUS IS WPFD-STATUS.
000800 DATA DIVISION.
       FILE SECTION.
       FD  DISPLAY-FILE
           LABEL RECORDS ARE OMITTED.
       01  DSPLY-REC                   PIC X(1200).
       FD  WO-PARTS-FILE
           LABEL RECORDS ARE STANDARD
           DATA RECORD IS WPFDREC.
       01  WPFDREC.
           COPY DDS-ALL-FORMATS OF MCFLMM1201.
000900 WORKING-STORAGE SECTION.
001000 77  HOLD-YR                    PIC X.
       01  BASE-MMISA                 PIC X(24).
       01  BLOWUP-BASE                PIC X(16).
       COPY CATREAD IN COPYLIB.
001800 01  CUR-DATE-WA.
001900     05  FILLER                 PIC X.
002000     05  CUR-DATE-YR-DIG        PIC X.
           05  FILLER                 PIC XXXX.
002100 01  DBPARAMETERS.      COPY DBPARMS OF COPYLIB.
002200 01  DBPARAMETERS-STORES.
002300     05  BASE2                  PIC X(24).
002400     05  PASSWORD-S             PIC X(8).
002500     05  DSET-NAME-S            PIC X(16).
001200 01  ERROR-BUFFER.
001300     05  BUF-LIT1               PIC X(24).
001400     05  BUF-PRTNUM             PIC X(8).
001500     05  BUF-LIT2               PIC X(30).
001600     05  BUF-WONUM              PIC X(10).
001700     05  BUF-FILL               PIC X(8).
       01  FILE-STATUSES.
           05  DSPLY-STATUS           PIC XX.
           05  WPFD-STATUS            PIC XX.
003300 01  INBUF.
003400     05  INPUT-WO.
003500         10  FILLER             PIC X(6).
003600         10  INPUT-WO7          PIC X.
003700         10  FILLER             PIC XXX.
003800     05  INPUT-PARTNO           PIC X(8).
           05  INPUT-CMD-LINE         PIC X(79).
           05  INPUT-MSG-LINE         PIC X(79).
       COPY LANGSUB OF COPYLIB.
004000 01  PASSWORD-INFORMATION.
004100     05  NAME-OF-PROGRAM     PIC X(08) VALUE "TDELRESV".
004200     05  PROGRAM-TYPE        PIC X(02) VALUE "UP".
004300     05  PROGRAM-RELEASE     PIC X(12) VALUE " E0100010001".
004400     05  PROGRAM-DESCRIPTION.
004500         10  PROG-DESC-A.
                   15  FILLER      PIC X(14) VALUE " DELETES PART ".
                   15  FILLER      PIC X(13) VALUE "RESERVED AND ".
                   15  FILLER      PIC X(13) VALUE "MOVES TO 'S' ".
                   15  FILLER      PIC X(15) VALUE "STATUS    ".
004700         10  PROG-DESC-B     PIC X(60) VALUE SPACES.
004900         10  PROG-FUNCTION   PIC X(60) VALUE SPACES.
005100     05  PASSWORD-FLAG       PIC X.
        COPY CRESERVE OF COPYLIB.
006300 01  RET-CODE                   PIC X.
       COPY DBSTAT OF COPYLIB.
       COPY TBLOWUP IN COPYLIB.
       01  TRUE-VAL                   PIC 1 VALUE B"1".
007000 COPY VCOMAREA OF COPYLIB.
007100 01  WO-PARTS-DATA.     COPY DWOPARTS OF COPYLIB.
       COPY WSCONTROL OF COPYLIB.
       COPY CPYIND OF COPYLIB.
007200 PROCEDURE DIVISION.
007300 START-PGM.
007400     PERFORM 1-HSK.
007500     PERFORM 6-MAIN THRU 6-MAIN-EXIT.
007600 2-EOJ.
           CLOSE DISPLAY-FILE.
           CLOSE WO-PARTS-FILE.
008100     GOBACK.
008200 1-HSK.
           OPEN I-O   DISPLAY-FILE.
           OPEN I-O   WO-PARTS-FILE.
008300     MOVE LOW-VALUES TO STATUS-AREA.
009600     CALL "TPWORD" USING PASSWORD-INFORMATION.
010000     IF PASSWORD-FLAG = "N" GO TO 2-EOJ.
014600     ACCEPT CUR-DATE-WA FROM DATE.
014700     IF CUR-DATE-YR-DIG = 0
014800         MOVE "A" TO HOLD-YR
014900     ELSE
015000     IF CUR-DATE-YR-DIG = 1
015100         MOVE "B" TO HOLD-YR
015200     ELSE
015300     IF CUR-DATE-YR-DIG = 2
015400         MOVE "C" TO HOLD-YR
015500     ELSE
015600     IF CUR-DATE-YR-DIG = 3
015700         MOVE "D" TO HOLD-YR
015800     ELSE
015900     IF CUR-DATE-YR-DIG = 4
016000         MOVE "E" TO HOLD-YR
016100     ELSE
016200     IF CUR-DATE-YR-DIG = 5
016300         MOVE "F" TO HOLD-YR
016400     ELSE
016500     IF CUR-DATE-YR-DIG = 6
016600         MOVE "G" TO HOLD-YR
016700     ELSE
016800     IF CUR-DATE-YR-DIG = 7
016900         MOVE "H" TO HOLD-YR
017000     ELSE
017100     IF CUR-DATE-YR-DIG = 8
017200         MOVE "J" TO HOLD-YR
017300     ELSE
017400     MOVE "K" TO HOLD-YR.
018300     MOVE SPACES TO INBUF DSPLY-REC.
017500 6-MAIN.
           MOVE ERROR-BUFFER TO INPUT-MSG-LINE.
014100     MOVE "FDELRESV" TO VIEW-CFNAME.
018400     MOVE HOLD-YR TO INPUT-WO7.
           MOVE INBUF TO DSPLY-REC.
           PERFORM 99-SCREEN-WRITE.
           PERFORM 98-SCREEN-READ.
           MOVE DSPLY-REC TO INBUF.
019400     IF VIEW-LASTKEY = 3 GO TO 2-EOJ.
020100     CALL "TALWONO" USING INPUT-WO RET-CODE.
           MOVE 0 TO COND-WORD.
           MOVE INPUT-WO TO WONUM OF WPFDREC.
           START WO-PARTS-FILE KEY IS = EXTERNALLY-DESCRIBED-KEY
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF WPFD-STATUS NOT = "00" MOVE 17 TO COND-WORD.
020800     IF COND-WORD = 17
020900         MOVE 47004 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE TRUE-VAL TO INDS (1) INDS (99)
021400         GO TO 6-MAIN.
021500 6-MAIN-LOOP.
021600     READ WO-PARTS-FILE NEXT INTO WO-PARTS-DATA
021700         AT END    MOVE 17 TO COND-WORD.
           IF INPUT-WO NOT = WONUM OF WPFDREC MOVE 17 TO COND-WORD.
           IF WPFD-STATUS NOT = "00" MOVE 17 TO COND-WORD.
021900     IF COND-WORD = 17
022000         MOVE 29020 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE TRUE-VAL TO INDS (1) INDS (99)
022500         GO TO 6-MAIN.
022600     IF PRT-STATUS = "R "
022700         NEXT SENTENCE
022800     ELSE
022900     GO TO 6-MAIN-LOOP.
023000     IF PRT-NUM = INPUT-PARTNO
023100         NEXT SENTENCE
023200     ELSE
023300     GO TO 6-MAIN-LOOP.
023400     MOVE SPACES TO RESERVATION-DATA.
023500     MOVE "UR" TO RESERVE-TYPE.
023600     MOVE INPUT-PARTNO TO R-CORP-CODE.
023700     MOVE INPUT-WO TO R-WONO.
023800     MOVE PRT-EST-QTY-9 TO R-QTY.
023900     CALL "CRESERVE" USING BASE2 BASE-MMISA RESERVATION-DATA
024000          R-MESSAGE  VIEW-COMAREA LANGUAGE-PARMS.
024200     MOVE 0 TO COND-WORD.
           DELETE WO-PARTS-FILE RECORD
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF WPFD-STATUS NOT = "00" MOVE 17 TO COND-WORD.
024300     IF COND-WORD = 17
045800         MOVE "  MMISA" TO BLOWUP-BASE
045900         MOVE "W/O DELETE OF RESERVATION FAILED * TDELRESV *     "
046000             TO BU-DISPLAY-MSG
046100         MOVE "WO-PARTS-FILE" TO BU-DISPLAY-FLD (1)
046500         MOVE "WORK ORDER = " TO BU-DISPLAY-FLD (2)
046600         MOVE INPUT-WO        TO BU-DISPLAY-FLD (3)
046700         PERFORM 998-BLOWUP
025100     MOVE "S " TO PRT-STATUS.
025200     MOVE 0 TO COND-WORD.
           WRITE WPFDREC FROM WO-PARTS-DATA
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF WPFD-STATUS NOT = "00" MOVE 17 TO COND-WORD.
025400     IF COND-WORD = 17
061100         MOVE "  MMISA" TO BLOWUP-BASE
061200         MOVE "WRITE FAILED ON WO-PARTS * TDELRESV *"
061300             TO BU-DISPLAY-MSG
061400         MOVE "WO-PARTS-FILE"  TO BU-DISPLAY-FLD (1)
061800         MOVE "WORK ORDER = " TO BU-DISPLAY-FLD (2)
061900         MOVE INPUT-WO        TO BU-DISPLAY-FLD (3)
062000         PERFORM 998-BLOWUP
           MOVE SPACES TO ERROR-BUFFER.
026100     MOVE "******      PART NUMBER " TO BUF-LIT1.
026200     MOVE PRT-NUM TO BUF-PRTNUM.
026300     MOVE " HAS BEEN UNRESERVED FROM W/O " TO BUF-LIT2.
026400     MOVE INPUT-WO TO BUF-WONUM.
           MOVE TRUE-VAL TO INDS (99).
           MOVE SPACES TO INBUF DSPLY-REC.
027300     GO TO 6-MAIN.
027400 6-MAIN-EXIT.    EXIT.

       98-SCREEN-READ.
           READ DISPLAY-FILE INDIC IS INDICS
               MOVE FUNCTION-NUM TO VIEW-LASTKEY
               MOVE ALL B"0" TO INDICS.

       99-SCREEN-WRITE.
           WRITE DSPLY-REC FORMAT IS VIEW-CFNAME
               INDIC IS INDICS.

045400 998-BLOWUP.
045500     MOVE "TDUPLOPT" TO BU-PGM-NAME.
045600     CALL "TBLOWUP" USING BLOWUP-BASE BU-PGM-NAME STATUS-AREA
045700                      VIEW-COMAREA DUMMY-KSAM-STAT
045800                      BU-DISPLAY-MSG BU-DISPLAY-FLDS.

       999-CATREAD.
           MOVE SPACES TO ERROR-BUFFER.
           CALL "CCATREAD" USING CATREAD-PARMS.
           MOVE CATREAD-MSG-TEXT TO ERROR-BUFFER.
       999-CATREAD-EXIT.    EXIT.
