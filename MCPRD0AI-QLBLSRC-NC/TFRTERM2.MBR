001100 IDENTIFICATION DIVISION.
001200 PROGRAM-ID.     TFRTERM2.
001300 AUTHOR.         BARBARA WINTER.
001400*INSTALLATION.   GOODYEAR TIRE & RUBBER COMPANY.
001500 DATE-WRITTEN.   MAY 1989.
001600*REMARKS.        THIS PROGRAM PRINTS A REPORT OF FREIGHT TERMS
001900*                THAT WERE BLANK ON THE PURCHASE ORDER.
002000*
      *C   10FEB1994    DAVE PLUM
      *C     ADDED CALL TO THE COBOL ERROR HANDLER - MCXCBLERR.
      *C
      *C   10/30/1997   CA YODER
      *C     MODIFIED FOR CENTURY DATABASE CHANGE TO MCFPCSTERM.
      *C
002100 ENVIRONMENT DIVISION.
002200 CONFIGURATION SECTION.
002300 SOURCE-COMPUTER.    HP-3000.
002400 OBJECT-COMPUTER.    HP-3000.
002500 SPECIAL-NAMES.  C01 IS NEW-PAGE.
002700
002800 INPUT-OUTPUT SECTION.
002900 FILE-CONTROL.
003000     SELECT PRINT-FILE ASSIGN TO  PRINTER-MCPRT.
003200     SELECT SORT-FILE ASSIGN TO   DISK-SORT.
003300     SELECT KFRTERMS-FILE   ASSIGN TO DATABASE-MCFLCSTERM
003400                            ORGANIZATION IS INDEXED
003500                            ACCESS MODE IS DYNAMIC
003600                            RECORD KEY IS KFRTERMS-DATE
003700                                STATUS IS KFRTERMS-STATUS.
003800
            SELECT DVENDOR
              ASSIGN TO DATABASE-MCFLCS0701
              ORGANIZATION IS INDEXED
                 ACCESS MODE IS DYNAMIC
              RECORD KEY IS EXTERNALLY-DESCRIBED-KEY WITH DUPLICATES
              FILE STATUS IS FILE-STATUS.
003900 DATA DIVISION.
004000 FILE SECTION.
004100 FD  PRINT-FILE RECORD CONTAINS 132 CHARACTERS.
004200 01  PRT-REC                    PIC X(132).
004300
004400 SD  SORT-FILE RECORD CONTAINS 78 CHARACTERS.
004500 01  SORT-REC.
004600     05  SRT-VEN-NAME           PIC X(44).
004700     05  SRT-VEN-CODE           PIC X(10).
004800     05  SRT-DATE               PIC X(8).
004900     05  SRT-PO                 PIC X(14).
005000     05  SRT-PO-TERM            PIC X.
005100     05  SRT-RCVR-TERM          PIC X.
005200
005300 FD  KFRTERMS-FILE.
005400 01  KFRTERMS-RECORD.
005500     05  KFRTERMS-DATE.
005600         07  DATE1              PIC X(8).
005700         07  DATE2              PIC X(6).
005800     05  KFRTERMS-VENDOR        PIC X(10).
005900     05  KFRTERMS-PO.
006000         07  FILLER             PIC X.
006100         07  KFRT-PO            PIC X(7).
006200         07  FILLER             PIC X(6).
006300     05  KFRTERMS-PO-TERM       PIC X.
006400     05  KFRTERMS-RCVR-TERM     PIC X.
006500
       FD  DVENDOR
           LABEL RECORDS ARE STANDARD.
       01  DVENDOR-REC.
           COPY DDS-MCRPCS0700  OF MCFLCS0701.

006600 WORKING-STORAGE SECTION.
       01  MCXCBLERR-SCOPE           PIC X(1)  VALUE "C".
006700 01  KFRTERMS-STATUS           PIC X(2).
       01  FILE-STATUS.
           05  FILE-STATUS-1         PIC X.
           05  FILE-STATUS-2         PIC X.
006800 01  LINE-K                     PIC 99    VALUE 60 COMP-4.
006900 01  PAGE-K                     PIC 9(3)  VALUE 0  COMP-4.
007200 01  CODE-ARG                   PIC X(10) VALUE SPACES.
007210 01  NO-ARG                     PIC X(10) VALUE SPACES.
       01  DE-DATE-HOLD-CN.
           05  DE-DATE-CC             PIC X(2).
           05  DE-DATE-YMD.
               10  DE-DATE-YY         PIC X(2).
               10  DE-DATE-MM         PIC X(2).
               10  DE-DATE-DD         PIC X(2).
007300
008100*----------  E S C A P E   S E Q U E N C E S
008200 01  COMPRESS-PRINT             PIC X(8).
008300 01  NORMAL-PRINT               PIC X(8).
008400 01  ESC-TEXT-61                PIC X(8).
008500 01  ESC-TEXT-60                PIC X(8).
008600
       COPY OVRPFDATA OF COPYLIB.
       COPY CCHKOBJ   OF COPYLIB.
       COPY THDPRTA   OF COPYLIB.
008700 COPY ESCNAM2  IN COPYLIB.
008800 COPY TDATECHK IN COPYLIB.
009000 COPY TBLOWUP  IN COPYLIB.
009100
010300 01  MESSAGE-AREA.
010400     05  NO-SORTED-RECORDS      PIC X(33) VALUE
010500                             "ZERO RECORDS QUALIFIED FOR REPORT".
010600
010700 01  SWITCH-AREA.
010800     05  END-OF-INPUT-FILE      PIC X VALUE "N".
010900         88  ALL-INPUT-RECORDS-PROCESSED       VALUE "Y".
011000     05  END-OF-SORT-FILE       PIC X VALUE "N".
011100         88  ALL-SORTED-RECORDS-PROCESSED      VALUE "Y".
011500
011600 COPY DATAB     IN COPYLIB.
011700 COPY DVENDOR   IN COPYLIB.
011800 COPY VCOMAREA  IN COPYLIB.
011900
012000 01  HDR-1.
012100     05  H1-DATE                PIC X(8).
012200     05  FILLER                 PIC X(5)   VALUE SPACES.
012300     05  H1-TIME                PIC X(8).
012400     05  FILLER                 PIC X(31)  VALUE SPACES.
012500     05  H1-TITLE               PIC X(27).
012600     05  FILLER                 PIC X(42)  VALUE SPACES.
012700     05  H1-PAGE                PIC X(5).
012800     05  H1-PAGE-NO             PIC ZZZZ9  VALUE ZEROES.
012900     05  FILLER                 PIC X      VALUE SPACE.
013000
013100 01  HDR-2.
013200     05  FILLER                 PIC X(28)  VALUE SPACES.
013300     05  FILLER                 PIC X(14)  VALUE
013400         "SELECTED:  PO ".
013500     05  HD2-PO                 PIC X(7)    VALUE SPACES.
013600     05  FILLER                 PIC X(9)    VALUE "  VENDOR ".
013700     05  HD2-VENDOR             PIC X(10)   VALUE SPACES.
013800     05  FILLER                 PIC X(7)    VALUE "  DATE ".
013900     05  HD2-DATE               PIC X(8)    VALUE SPACES.
014000     05  FILLER                 PIC X(17)   VALUE
014100            "    SORTED BY:  ".
014200     05  HD2-SORT               PIC X(6)     VALUE SPACES.
014300     05  FILLER                 PIC X(26)    VALUE SPACES.
014400
014500 01  HDR-3.
014600     05  FILLER                 PIC X(10)  VALUE SPACES.
014700     05  H3-PO                  PIC X(14) VALUE "PURCHASE ORDER".
014800     05  FILLER                 PIC X(5)   VALUE SPACES.
014900     05  H3-VENDOR              PIC X(6) VALUE "VENDOR".
015000     05  FILLER                 PIC X(43)  VALUE SPACES.
015100     05  H3-DATE-RCVD           PIC X(13) VALUE "DATE RECEIVED".
015200     05  FILLER                 PIC X(5)   VALUE SPACES.
015300     05  H3-TERMS-PO            PIC X(8) VALUE "PO TERMS".
015400     05  FILLER                 PIC X(5)   VALUE SPACES.
015500     05  H3-TERMS-RCVR          PIC X(14) VALUE "RECEIVER TERMS".
015600     05  FILLER                 PIC X(9)  VALUE SPACES.
015700 01  HDR-6.
015800     05  FILLER                 PIC X(10)  VALUE SPACES.
015900     05  H6-DASH1               PIC X(14).
016000     05  FILLER                 PIC X(5)   VALUE SPACES.
016100     05  H6-DASH2               PIC X(44).
016200     05  FILLER                 PIC X(5)   VALUE SPACES.
016300     05  H6-DASH3               PIC X(13).
016400     05  FILLER                 PIC X(5)   VALUE SPACES.
016500     05  H6-DASH4               PIC X(8).
016600     05  FILLER                 PIC X(5)   VALUE SPACES.
016700     05  H6-DASH5               PIC X(14).
016800     05  FILLER                 PIC X(9).
016900
017000 01  LINE1.
017100     05  FILLER                 PIC X(10)  VALUE SPACES.
017200     05  L1-PO                  PIC X(14).
017300     05  FILLER                 PIC X(5)   VALUE SPACES.
017400     05  L1-NAME                PIC X(44).
017500     05  FILLER                 PIC X(8)   VALUE SPACES.
017600     05  L1-DATE-RCVD           PIC X(8).
017700     05  FILLER                 PIC X(11)  VALUE SPACES.
017800     05  L1-PO-TERMS            PIC X(1).
017900     05  FILLER                 PIC X(15)  VALUE SPACES.
018000     05  L1-RCVR-TERMS          PIC X      VALUE SPACE.
018100     05  FILLER                 PIC X(15)  VALUE SPACES.
018200
       LINKAGE SECTION.
       COPY THDPRTB OF COPYLIB.
007400 01  SORT-DATA.
007500     05  DE-PO                  PIC X(7).
007600     05  DE-VENDOR              PIC X(10).
007700     05  DE-DATE                PIC X(6).
007800     05  DE-SORT                PIC X.
007900     05  FILLER                 PIC X(56).
008000
018300 PROCEDURE DIVISION USING HD-ROUTE-DATA SORT-DATA.
018400 BEGIN-SORT.
           MOVE "C" TO MCXCBLERR-SCOPE.
           CALL "MCXCBLERR" USING MCXCBLERR-SCOPE.
018500
018600*----------  SET UP PRINTER ESCAPE SEQUENCES
018700     CALL "TESCSEQ" USING ESC-NAME.
018800     MOVE CHAR-1636PI     TO COMPRESS-PRINT.
018900     MOVE CHAR-10PI       TO NORMAL-PRINT.
019000     MOVE TEXT-LENGTH-61 TO ESC-TEXT-61.
019100     MOVE TEXT-LENGTH-60 TO ESC-TEXT-60.
           MOVE HD-SPOOLER-NUMBER TO OVRPRTF-TOFILE-NUM.
           MOVE "*YES"       TO OVRPRTF-SHARED.
028100     MOVE HD-NO-OF-COPIES TO OVRPRTF-COPIES.
           MOVE "MCPRT"      TO OVRPRTF-FILE.
           PERFORM 996-OVERRIDE-PRINT-FILE.
019400     OPEN OUTPUT PRINT-FILE.
020100
020200*----------  PRINT HEADER PAGE
020400     MOVE "DHDR57.PUB" TO HD-FILE-NAME.
020500     CALL "THDPRT2" USING HD-RET-CODE, HD-FILE-NAME,
020600        FNUM, HD-ROUTE-DATA, ESC-NAME.
020700     IF PAPER-IS-132-COLS
020800          NEXT SENTENCE
020900     ELSE
021000         WRITE PRT-REC FROM COMPRESS-PRINT AFTER ADVANCING 0
021100         WRITE PRT-REC FROM ESC-TEXT-61 AFTER ADVANCING 0.
021200     IF HD-RET-CODE NOT = 0
021300         DISPLAY "THDRPT ERROR".
021500
021600*----------  SET UP HEADING LITERALS FOR REPORT
021700     MOVE 1 TO DATE-MODE.
021800     CALL "TDATECHK" USING DATE-CHECK-AREA.
021900     MOVE DATE-SLASH-OUT                 TO H1-DATE.
022000     MOVE DATE-FORMATTED-TIME-OUT        TO H1-TIME.
022100     MOVE DE-PO         TO HD2-PO.
022200     MOVE DE-VENDOR     TO HD2-VENDOR.
022300     MOVE DE-DATE       TO HD2-DATE.
022400
022500     IF DE-SORT = "D"
022600        MOVE "DATE  " TO HD2-SORT
022700     ELSE
022800        IF DE-SORT = "V"
022900           MOVE "VENDOR" TO HD2-SORT
023000        ELSE
023100           MOVE "PO    " TO HD2-SORT.
023200
023300     MOVE ALL "=" TO H6-DASH1, H6-DASH2, H6-DASH3,
023400                     H6-DASH4, H6-DASH5.
023500
           IF DE-DATE NOT = "ALL"
               MOVE DE-DATE    TO  DE-DATE-YMD
               IF DE-DATE-YY > "70"
                   MOVE "19"   TO  DE-DATE-CC
               ELSE
                   MOVE "20"   TO  DE-DATE-CC.

023910     OPEN INPUT DVENDOR.
024000
024010 110-LOOP.
024100*----------  PROCESS REPORT DATA
024200     IF DE-SORT = "D"
024300     SORT SORT-FILE
024400          ON ASCENDING KEY SRT-DATE
024500          INPUT  PROCEDURE IS 200-INPUT-RECORDS THRU 299-EXIT
024600          OUTPUT PROCEDURE IS 300-WRITE-RECORDS THRU 399-EXIT
024700      ELSE
024800      IF DE-SORT = "V"
024900      SORT SORT-FILE
025000          ON ASCENDING KEY SRT-VEN-NAME
025100          INPUT  PROCEDURE IS 200-INPUT-RECORDS THRU 299-EXIT
025200          OUTPUT PROCEDURE IS 300-WRITE-RECORDS THRU 399-EXIT
025300      ELSE
025400      SORT SORT-FILE
025500          ON ASCENDING KEY SRT-PO
025600          INPUT  PROCEDURE IS 200-INPUT-RECORDS THRU 299-EXIT
025700          OUTPUT PROCEDURE IS 300-WRITE-RECORDS THRU 399-EXIT.
025800
025900*----------  PRINT REPORT, CLOSE FILES, AND QUIT
026000      IF PAPER-IS-132-COLS
026100         NEXT SENTENCE
026200      ELSE
026300         WRITE PRT-REC FROM NORMAL-PRINT AFTER ADVANCING 0
026400         WRITE PRT-REC FROM ESC-TEXT-60 AFTER ADVANCING 0.
026500
027100     CLOSE PRINT-FILE.
027200     CLOSE DVENDOR.
027300     GOBACK.
027400
027500********************************************************************
027600*    INPUT SECTION:  RETRIEVE VENDOR RECORDS FOR SORTING           *
027700********************************************************************
027800 200-INPUT-RECORDS.
027810     OPEN INPUT KFRTERMS-FILE.
027811     MOVE SPACES TO KFRTERMS-DATE.
027820     START KFRTERMS-FILE
027830           KEY IS GREATER OR EQUAL KFRTERMS-DATE
027840           INVALID KEY MOVE "Y" TO END-OF-INPUT-FILE.
028100     PERFORM 210-PROCESS-INPUT-RECORDS THRU 290-EXIT UNTIL
028200             ALL-INPUT-RECORDS-PROCESSED.
028210     CLOSE KFRTERMS-FILE.
028300     GO TO 299-EXIT.
028400
028500 210-PROCESS-INPUT-RECORDS.
028510     READ KFRTERMS-FILE NEXT RECORD
028520          AT END MOVE "Y" TO END-OF-INPUT-FILE
028530          GO TO 290-EXIT.
028600     MOVE SPACES TO SORT-REC.
028700     IF DE-PO NOT = "ALL"
028800        IF DE-PO NOT = KFRT-PO
028900           GO TO 210-PROCESS-INPUT-RECORDS.
029000
029100     IF DE-VENDOR NOT = "ALL"
029200       IF DE-VENDOR NOT = KFRTERMS-VENDOR
029300          GO TO 210-PROCESS-INPUT-RECORDS.
029400
029500     IF DE-DATE NOT = "ALL"
029600       IF DATE1 < DE-DATE-HOLD-CN
029700          GO TO 210-PROCESS-INPUT-RECORDS.
029800
029890     IF KFRTERMS-PO-TERM NOT = " "
029891        GO TO 210-PROCESS-INPUT-RECORDS.
029892
029900*----------  BUILD SORT RECORD
030000     MOVE DATE1 TO SRT-DATE.
030100     MOVE KFRTERMS-VENDOR TO SRT-VEN-CODE.
030200     MOVE KFRTERMS-PO     TO SRT-PO.
030300     MOVE KFRTERMS-PO-TERM TO SRT-PO-TERM.
030400     MOVE KFRTERMS-RCVR-TERM TO SRT-RCVR-TERM.
030500
030600*-----  GET VENDOR NAME
030700     MOVE KFRTERMS-VENDOR TO CODE-ARG.
           MOVE 0 TO COND-WORD.
           MOVE CODE-ARG TO VENCDE OF DVENDOR-REC.
           START DVENDOR KEY = VENCDE OF DVENDOR-REC
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
                   MOVE 17 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.
031000     IF COND-WORD NOT = 0
031100        GO TO 216-RELEASE.
031200
031300 215-GET-NAME.
           MOVE 0 TO COND-WORD.
           READ DVENDOR NEXT INTO BUF-DVENDOR
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   MOVE 15 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.
           IF VENCDE OF DVENDOR-REC NOT = CODE-ARG
               MOVE 15 TO COND-WORD.
031600     IF NOT GOOD-CALL
031700        GO TO 216-RELEASE.
031800
031900     IF VEN-ITM-NO = "00"
032000        MOVE VEN-NAME TO SRT-VEN-NAME
032100     ELSE
032200        GO TO 215-GET-NAME.
032300
032400 216-RELEASE.
032500     RELEASE SORT-REC.
032900
033000 290-EXIT.  EXIT.
033100 299-EXIT.  EXIT.
033200
033300***********************************************************************
033400*     OUTPUT SECTION:  WRITE VENDOR RECORDS TO CREATE REPORT          *
033500***********************************************************************
033600 300-WRITE-RECORDS.
033700     RETURN SORT-FILE AT END
033800         MOVE "Y" TO END-OF-SORT-FILE
033900         PERFORM 940-PRINT-HEADINGS THRU 949-EXIT
034000         MOVE NO-SORTED-RECORDS TO PRT-REC
034100         WRITE PRT-REC AFTER ADVANCING 2 LINES
034200         GO TO 399-EXIT.
034300
034400     PERFORM 310-PROCESS-SORTED-RECORDS THRU 390-EXIT
034500             UNTIL ALL-SORTED-RECORDS-PROCESSED.
034600     GO TO 399-EXIT.
034700
034800 310-PROCESS-SORTED-RECORDS.
034900     IF LINE-K > 50
035000         PERFORM 940-PRINT-HEADINGS THRU 949-EXIT.
035100
035200     MOVE SPACES TO LINE1.
035210     MOVE SRT-VEN-NAME TO L1-NAME.
035220     MOVE SRT-DATE     TO L1-DATE-RCVD.
035230     MOVE SRT-PO       TO L1-PO.
035240     MOVE SRT-PO-TERM  TO L1-PO-TERMS.
035250     MOVE SRT-RCVR-TERM TO L1-RCVR-TERMS.
035300
035400 320-PRINT-LINES.
035500     ADD      1        TO LINE-K.
035600     MOVE SPACES       TO PRT-REC.
035700     WRITE PRT-REC FROM LINE1 AFTER ADVANCING 1 LINES.
035800
035900
036000 325-READ-FILE.
036100     RETURN SORT-FILE AT END
036200         MOVE "Y"                           TO END-OF-SORT-FILE.
036300
036400 390-EXIT.  EXIT.
036500 399-EXIT.  EXIT.
036700 940-PRINT-HEADINGS.
036800     ADD 1 TO PAGE-K.
036900     MOVE PAGE-K TO H1-PAGE-NO.
036940     MOVE "   BLANK PO FREIGHT TERMS" TO H1-TITLE.
037000     WRITE PRT-REC FROM HDR-1 AFTER ADVANCING NEW-PAGE.
037100     WRITE PRT-REC FROM HDR-2 AFTER ADVANCING 1 LINE.
037200     WRITE PRT-REC FROM HDR-3 AFTER ADVANCING 3 LINES.
037300     WRITE PRT-REC FROM HDR-6 AFTER ADVANCING 1 LINE.
037400     MOVE 7 TO LINE-K.
037500 949-EXIT.  EXIT.
037600
       COPY OVRPFCALL OF COPYLIB.
037700*************************************************************
037800*                    BLOWUP   ROUTINE                       *
037900*************************************************************
038000 990-BLOWUP.
038100     WRITE PRT-REC FROM ESC-TEXT-61  AFTER ADVANCING 0.
038200     WRITE PRT-REC FROM NORMAL-PRINT AFTER ADVANCING 0.
038300
038400     MOVE "TFRTERMS" TO BU-PGM-NAME.
038500     MOVE CODE-ARG TO BU-DISPLAY-FLD (1).
038600     MOVE SRT-VEN-CODE TO BU-DISPLAY-FLD (2).
038700     CALL "TBLOWUP" USING BASE, BU-PGM-NAME, STATUS-AREA,
038800           VIEW-COMAREA, FILE-STATUS, BU-DISPLAY-MSG,
038900           BU-DISPLAY-AREA.
039000
039100 999-EXIT.  EXIT.
