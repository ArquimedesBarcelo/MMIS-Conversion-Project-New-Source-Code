       IDENTIFICATION DIVISION.
       PROGRAM-ID.             TSETCRFT.
       AUTHOR.                 R L ENSMINGER.
       INSTALLATION.           GTR.
       DATE-COMPILED.
      ****************************************************************
      * CREATES A TABLE OF PERSONNEL LABOR RATES FOR EACH MMIS CRAFT *
      ****************************************************************
      *C  3/8/93 - WDR  **********************************************
      *C  ADDED EDIT FOR RESERVED CC NUMBERS '9999' AND '#$%&'
      *C**************************************************************
       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.
       SOURCE-COMPUTER.        IBM-AS400.
       OBJECT-COMPUTER.        IBM-AS400.

       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT WO-CRAFTS-REQD
                  ASSIGN       TO DATABASE-MCFLMM0601
                  ORGANIZATION IS INDEXED
                  ACCESS MODE  IS DYNAMIC
                  RECORD KEY   IS EXTERNALLY-DESCRIBED-KEY
                  FILE STATUS  IS FILE-STAT.

           SELECT PER-PERSONNEL
                  ASSIGN       TO DATABASE-MCFLMM0301
                  ORGANIZATION IS INDEXED
                  ACCESS MODE  IS DYNAMIC
                  RECORD KEY   IS EXTERNALLY-DESCRIBED-KEY
                  FILE STATUS  IS FILE-STAT.

       DATA DIVISION.
       FILE SECTION.
       FD  WO-CRAFTS-REQD
           LABEL RECORDS       ARE STANDARD.
       01  WCR-REC.
           COPY DDS-ALL-FORMATS OF MCFLMM0601.

       FD  PER-PERSONNEL
           LABEL RECORDS       ARE STANDARD.
       01  PP-REC.
           COPY DDS-ALL-FORMATS OF MCFLMM0301.

       WORKING-STORAGE SECTION.
       77  SAVE-LABOR-RATE     PIC 9(6)V99.
       77  S1                  PIC S9(4) COMP-4.
       77  CRAFT-SW            PIC X.
       77  STOP-READ           PIC X.

       01  FILE-STAT.
           05  FILE-STAT-1     PIC X.
           05  FILE-STAT-2     PIC X.

       01  PER-BUFFER.
           COPY MPERSONL       IN COPYLIB.

       01  CRAFT-BUFFER.
           COPY MWOCRAFT       IN COPYLIB.

       LINKAGE SECTION.
       01  DBPARAMETERS.
           COPY DBPARMS        IN COPYLIB.

       01  CRAFT-TABLE.
           05 C-R-ENTRY        OCCURS 200 TIMES
                               INDEXED BY CRAFT-INDEX.
              10 CRAFT         PIC X(2).
              10 RATE          PIC 999999V99.

       PROCEDURE DIVISION USING DBPARAMETERS
                                CRAFT-TABLE.
       START-PROGRAM.
           OPEN INPUT          WO-CRAFTS-REQD PER-PERSONNEL.
           PERFORM             6-MAIN.
           PERFORM             2-EOJ.

       2-EOJ.
           CLOSE               WO-CRAFTS-REQD PER-PERSONNEL.
           GOBACK.

       6-MAIN.
           MOVE SPACES         TO CRAFTREQD.
           START WO-CRAFTS-REQD KEY IS GREATER THAN CRAFTREQD
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
               DISPLAY "ERROR: FILE STATUS = " FILE-STAT
                               " ON START TO WO-CRAFTS-REQD"
             GO TO 2-EOJ.

           MOVE 1              TO S1.
           MOVE SPACES         TO CRAFT-TABLE.
           MOVE "N"            TO STOP-READ.
           PERFORM LOAD-CRAFTS THRU LOAD-CRAFTS-EXIT
                               UNTIL STOP-READ = "Y".
           MOVE 1              TO S1.
           PERFORM SET-CRAFT-RATES
                               UNTIL CRAFT (S1) = SPACES.

       LOAD-CRAFTS.
           READ WO-CRAFTS-REQD NEXT RECORD INTO CRAFT-BUFFER
               AT END          MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
               MOVE "Y"        TO STOP-READ
               GO TO LOAD-CRAFTS-EXIT.

           MOVE CRAFT-MSTR     TO CRAFT (S1).
           ADD 1               TO S1.

       LOAD-CRAFTS-EXIT.       EXIT.

       SET-CRAFT-RATES.
           MOVE SPACES         TO PERCCNUM.
           START PER-PERSONNEL KEY IS GREATER THAN PERCCNUM
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
               DISPLAY "ERROR: FILE STATUS = " FILE-STAT
                               " ON START TO PER-PERSONNEL"
             GO TO 2-EOJ.

           MOVE "N"            TO STOP-READ.
           PERFORM S-C-R-CONT  THRU S-C-R-CONT-EXIT
                               UNTIL STOP-READ = "Y".
           ADD 1               TO S1.

       S-C-R-CONT.
           READ PER-PERSONNEL  NEXT RECORD INTO PER-BUFFER
               AT END          MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
               MOVE "Y"        TO STOP-READ
               GO TO S-C-R-CONT-EXIT.

           IF PER-CC-NUM = "9999" OR "#$%&"
               GO TO S-C-R-CONT.

           IF PER-CRAFT = CRAFT (S1)
               MOVE PER-LABOR-RATE TO RATE (S1) SAVE-LABOR-RATE
               MOVE "Y"        TO STOP-READ
               GO TO S-C-R-CONT-EXIT
           ELSE
               MOVE SAVE-LABOR-RATE TO RATE (S1).

       S-C-R-CONT-EXIT.        EXIT.

