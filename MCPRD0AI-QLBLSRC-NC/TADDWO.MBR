       IDENTIFICATION DIVISION.
       PROGRAM-ID.             TADDWO.
      *REMARKS.            *** THIS PROGRAM ADDS W/O'S TO WO-BASIC FILE.
       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.
       SOURCE-COMPUTER.        AS-400.
       OBJECT-COMPUTER.        AS-400.

       INPUT-OUTPUT            SECTION.
       FILE-CONTROL.
           SELECT WO-NUMBER
                  ASSIGN       TO DATABASE-MCFLMM0101
                  ORGANIZATION IS INDEXED
                  ACCESS MODE  IS RANDOM
                  RECORD KEY   IS EXTERNALLY-DESCRIBED-KEY
                  FILE STATUS  IS FILE-STAT.

           SELECT WO-BASIC
                  ASSIGN       TO DATABASE-MCFLMM1001
                  ORGANIZATION IS INDEXED
                  ACCESS MODE  IS RANDOM
                  RECORD KEY   IS EXTERNALLY-DESCRIBED-KEY
                               WITH DUPLICATES
                  FILE STATUS  IS FILE-STAT.

       DATA DIVISION.
       FILE SECTION.
       FD  WO-NUMBER
           LABEL RECORDS       ARE STANDARD.
       01  WO-NUMBER-REC.
           COPY DD-MCRPMM0100  OF MCFLMM0101.

       FD  WO-BASIC
           LABEL RECORDS       ARE STANDARD.
       01  WO-BASIC-REC.
           COPY DD-MCRPMM1000  OF MCFLMM1001.

       WORKING-STORAGE         SECTION.
       77  WO-NUM-KEY          PIC X(10).

       01  FILE-STAT.
           05 FILE-STAT-9      PIC 99.

       LINKAGE SECTION.
       01  DBPARAMETERS.       COPY DBPARMS  IN COPYLIB.

       01  WO-BASIC-DATA.      COPY DWOBASIC IN COPYLIB.

       01  CONDIT-CODE         PIC X.
       01  ERROR-SWITCH.
           05  ERROR-SW        PIC S9(4) COMP.

       PROCEDURE DIVISION      USING DBPARAMETERS
                               WO-BASIC-DATA
                               CONDIT-CODE
                               ERROR-SWITCH.

       BEGIN-PROCEDURE.
           MOVE WO-NUM         TO WO-NUM-KEY.
           MOVE ZERO           TO ERROR-SW.
           OPEN I-O            WO-NUMBER.
           OPEN I-O            WO-BASIC.

           IF CONDIT-CODE NOT = "1"
               PERFORM WRITE-MASTER-RECORDS.

       WRITE-BASIC-DETAIL-RECORDS.
           WRITE WO-BASIC-REC  FROM WO-BASIC-DATA
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
               MOVE "WO-BASIC"  TO DBPARM-PAD
               MOVE FILE-STAT-9 TO ERROR-SW.

           GO TO END-ROUTINE.

       WRITE-MASTER-RECORDS.
           WRITE WO-NUMBER-REC FROM WO-NUM-KEY
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
               MOVE "WO-NUMBER" TO DBPARM-PAD
               MOVE FILE-STAT-9 TO ERROR-SW
               GO TO END-ROUTINE.

       END-ROUTINE.
           CLOSE               WO-NUMBER.
           CLOSE               WO-BASIC.
           GOBACK.

