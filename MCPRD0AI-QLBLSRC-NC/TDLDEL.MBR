       IDENTIFICATION DIVISION.
       PROGRAM-ID.             TDLDEL.
       AUTHOR.                 W. ROXBURY.
       INSTALLATION.           GOODYEAR TIRE & RUBBER CO.
       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.
       SOURCE-COMPUTER.        IBM-AS400.
       OBJECT-COMPUTER.        IBM-AS400.
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT BULLETIN-BOARD
                  ASSIGN TO DATABASE-MCFLMM2701
                  ORGANIZATION IS INDEXED
                  ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                  FILE STATUS IS FILE-STAT.

           SELECT NEWS-TABLE
                  ASSIGN TO DATABASE-MCFLMM2801
                  ORGANIZATION IS INDEXED
                  ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                  WITH DUPLICATES
                  FILE STATUS IS FILE-STAT.

           SELECT DISPLAY-FILE
                  ASSIGN TO WORKSTATION-ZBBNEW-SI
                  ORGANIZATION IS TRANSACTION
                  ACCESS IS DYNAMIC
                  RELATIVE KEY IS RECNO
                  FILE STATUS IS SCREEN-STATUS
                  MAJOR-MINOR
                  CONTROL-AREA IS SCREEN-CONTROL.

       DATA DIVISION.
       FILE SECTION.
       FD  BULLETIN-BOARD
           LABEL RECORDS ARE STANDARD.
       01  BB-REC.
           COPY DDS-ALL-FORMATS OF MCFLMM2701.

       FD  NEWS-TABLE
           LABEL RECORDS ARE STANDARD.
       01  DL-REC.
           COPY DDS-ALL-FORMATS OF MCFLMM2801.

       FD  DISPLAY-FILE
           LABEL RECORDS ARE OMITTED.
       01  DISPLAY-REC         PIC X(2000).

       WORKING-STORAGE SECTION.
       77  DEL-SW                PIC 9999   VALUE 0     BINARY.
       77  MODEX                 PIC 9999   VALUE 5     BINARY.
       77  RECNO                 PIC 9999   VALUE 0     BINARY.
       77  TRUE-VAL              PIC 1      VALUE B"1".
       77  NEG-VAL               PIC 1      VALUE B"0".

       01  PASSWORD-INFORMATION.
           05  NAME-OF-PROGRAM     PIC X(08) VALUE "TDLDEL  ".
           05  PROGRAM-TYPE        PIC X(02) VALUE "UP".
           05  PROGRAM-RELEASE     PIC X(12) VALUE " E0100010001".
           05  PROGRAM-DESCRIPTION.
               10  PROG-DESC-A     PIC X(60) VALUE
         "ALLOWS SPECIFIC RECORDS OF A DISTRIBUTION LIST OR THE WHOLE ".
               10  PROG-DESC-B     PIC X(60) VALUE
         "DISTRIBUTION CODE TO BE DELETED IF THERE ARE NO NEWS RECORDS".
               10  PROG-FUNCTION   PIC X(60) VALUE
         "OUTSTANDING.  RUNS FROM `f4' KEY OF DISTRIBUTION MAINT. MENU".
           05  PASSWORD-FLAG       PIC X.

       01  FILE-STAT.
           05 FILE-STAT-1      PIC X   VALUE "0".
           05 FILE-STAT-2      PIC X   VALUE "0".

       01  HELP-DATA.
           05  HELP-SW             PIC 9(04) BINARY VALUE ZEROS.
           05  HELP-LOCA           PIC X(40).
           05  HELP-MSGLINE        PIC X(70).

       01  SCREEN-DATA  .
           05  LOCA-ID                         PIC X(40).
           05  DLIST-CODE                      PIC X(06).
           05  DISTRIBUTION-LIST.
               10  DIST-CC-BUF                 PIC X(04).
               10  DIST-ZONE-BUF               PIC X(04).
               10  DIST-CRFT-BUF               PIC X(02).
           05  DELETE-MSG                      PIC X(74).
           05  HELP-LINE                       PIC X(70).
           05  SCREEN-MSGS.
               10  CMDMSG                      PIC X(79).
               10  ERRMSG                      PIC X(79).

       01  DEFAULT-MESSAGE.
           05  FILLER  PIC X(25) VALUE
                      "ALL RECORDS will be delet".
           05  FILLER  PIC X(25) VALUE
                      "ed, Press f6 to delete.  ".
           05  FILLER  PIC X(24) VALUE
                      "Press `ENTER' to cancel.".

       01  DLIST-LINE.
           05  DIST-CC PIC X(04).
           05  DIST-ZN PIC X(04).
           05  DIST-CR PIC X(02).

       01  DB-ERROR.
           05  DB-FUNC   PIC X(10) VALUE SPACES.
           05  DB-FILE   PIC X(18) VALUE SPACES.
           05  FILLER    PIC X(20) VALUE "ERROR - FILE-STAT = ".
           05  CON-WORD  PIC XX.

           COPY SCREENIO       IN COPYLIB.

           COPY CATREAD        IN COPYLIB.

       01  NEWS-FILE-DATA.
           COPY DBBOARD        IN COPYLIB.

       01  DISTRIBUTION-TABLE.
           COPY DNEWSTBL       IN COPYLIB.

       01  MESSAGE-BUFFER-DATA.
           COPY ERRORLIN       IN COPYLIB.

       LINKAGE SECTION.
       01  DBPARAMETERS.
           COPY DBPARMS        IN COPYLIB.

       01  DLIST-DATA.
           05  DIST-CODE           PIC X(06).
           05  DIST-LOCA           PIC X(40).
           05  DIST-HELP           PIC X(70).

       PROCEDURE DIVISION USING DBPARAMETERS
                                DLIST-DATA.
       CHECK-PASSWORD.
           CALL "TPWORD" USING PASSWORD-INFORMATION.
           IF PASSWORD-FLAG NOT = "N"
               GO TO BEGIN-PROC.
           GOBACK.

       BEGIN-PROC.
           OPEN INPUT          BULLETIN-BOARD.
           OPEN I-O            NEWS-TABLE.
           OPEN I-O            DISPLAY-FILE.

           MOVE "VDLDEL"       TO SCREEN-NAME.
           MOVE SPACES         TO SCREEN-DATA MESSAGE-BUFFER.
           MOVE DIST-LOCA      TO LOCA-ID HELP-LOCA.
           MOVE DIST-HELP      TO HELP-LINE HELP-MSGLINE.
           MOVE 5              TO MODEX.

       DBFIND-LOOP.
           MOVE 0              TO DEL-SW RECNO.
           MOVE DIST-CODE      TO DLIST-CODE
                                  NEWSKEY OF NEWS-TABLE.

           IF MODEX = 5
               START NEWS-TABLE KEY = NEWSKEY OF NEWS-TABLE
           ELSE
               START NEWS-TABLE KEY > NEWSKEY OF NEWS-TABLE.

           IF FILE-STAT NOT = "00"
               IF FILE-STAT-1 NOT = "0"
      **********************************************************************
      **    MESSAGE 040/015:
      **  NO RECORDS FOUND
      **********************************************************************
                   MOVE  40        TO CATREAD-MSG-SET
                   MOVE  15        TO CATREAD-MSG-NUM
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE MESSAGE-BUFFER TO ERRMSG
                   MOVE TRUE-VAL   TO IND(99)
                   GO TO SHOWFORM
               ELSE
                   MOVE "START   " TO DB-FUNC
                   MOVE "NEWS-TABLE" TO DB-FILE
                   MOVE FILE-STAT  TO CON-WORD
                   MOVE DB-ERROR   TO ERRMSG
                   MOVE TRUE-VAL   TO IND(99)
                   GO TO SHOWFORM.

       DBGET-LOOP.
           IF MODEX = 5
               GO TO FORWARD-READ
           ELSE
               GO TO REVERSE-READ.

       DBGET-CONTINUE.
           MOVE DIST-ZONE      TO DIST-ZONE-BUF.

           IF DIST-CC-NUM = "9999"
               MOVE SPACES     TO DIST-CC-BUF
           ELSE
               MOVE DIST-CC-NUM TO DIST-CC-BUF.

           MOVE DIST-CRFT      TO DIST-CRFT-BUF.

       SHOWFORM.
           MOVE "00"           TO SCREEN-STATUS.
           MOVE SCREEN-DATA    TO DISPLAY-REC.

           WRITE DISPLAY-REC  FORMAT IS SCREEN-NAME
               INDIC ARE SCREEN-INDICATORS.
           IF SCREEN-STATUS NOT = "00"
               DISPLAY "SCREEN WRITE ERROR.  SCREEN-STATUS IS "
                        SCREEN-STATUS
               GO TO END-OF-JOB.

           READ  DISPLAY-FILE FORMAT IS SCREEN-NAME
               INDIC ARE SCREEN-INDICATORS
           IF SCREEN-STATUS NOT = "00"
               DISPLAY "SCREEN READ ERROR.  SCREEN-STATUS IS "
                        SCREEN-STATUS
               GO TO END-OF-JOB.

           MOVE DISPLAY-REC    TO SCREEN-DATA.
           MOVE ALL B"0"       TO SCREEN-INDICATORS.

           IF KEY-HIT = 1 OR 3
               GO TO END-OF-JOB.

           IF DEL-SW = 1
               IF KEY-HIT = 0
                   MOVE 0      TO DEL-SW
                   MOVE SPACES TO DELETE-MSG
                   GO TO SHOWFORM
               ELSE
               IF KEY-HIT NOT = 6
                   GO TO SHOWFORM.

           IF KEY-HIT = 0 OR 8
               MOVE SPACES     TO DELETE-MSG
               MOVE 0          TO DEL-SW
               MOVE 6          TO MODEX
               GO TO DBGET-LOOP.

           IF KEY-HIT = 4
               MOVE SPACES     TO DELETE-MSG
               MOVE 0          TO DEL-SW
               MOVE 5          TO MODEX
               GO TO DBGET-LOOP.

           IF KEY-HIT = 5
               MOVE SPACES     TO DELETE-MSG
               MOVE 0          TO DEL-SW
               PERFORM SUBF-CLEAR
               PERFORM GET-DLIST THRU GDL-EXIT
               GO TO SHOWFORM.

           IF KEY-HIT = 6
               PERFORM DELETE-CODE THRU DC-EXIT
               GO TO SHOWFORM.

           IF KEY-HIT = 7
               MOVE 0          TO DEL-SW
               MOVE 60         TO HELP-SW
               CALL "TBBHELP" USING HELP-DATA
               MOVE "VDLDEL"   TO SCREEN-NAME
               MOVE SPACES     TO DELETE-MSG
               GO TO SHOWFORM.

           IF KEY-HIT NOT = 2
               MOVE SPACES     TO DELETE-MSG
               MOVE 0          TO DEL-SW
               GO TO SHOWFORM.

       DELETE-RECORD.
           DELETE NEWS-TABLE.
           IF FILE-STAT NOT = "00"
               MOVE FILE-STAT  TO CON-WORD
               MOVE "DELETE  " TO DB-FUNC
               MOVE "NEWS-TABLE" TO DB-FILE
               MOVE DB-ERROR   TO ERRMSG
               MOVE TRUE-VAL   TO IND(99)
               GO TO SHOWFORM.

           GO TO DBGET-LOOP.

       DELETE-CODE.
           IF DEL-SW = 1
               MOVE 0          TO DEL-SW
               GO TO DBFIND-DELETE.

           MOVE DIST-CODE      TO NEWSKEY OF BULLETIN-BOARD.
           START BULLETIN-BOARD KEY = NEWSKEY OF BULLETIN-BOARD.
           IF FILE-STAT NOT = "00"
               MOVE 1          TO DEL-SW
      **********************************************************************
      **    MESSAGE 027/004:
      **  ALL RECORDS WILL BE DELETED, PRESS F6 TO DELETE.
      **                  PRESS 'ENTER' TO CANCEL.
      **********************************************************************
               MOVE  27        TO CATREAD-MSG-SET
               MOVE   4        TO CATREAD-MSG-NUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               IF MSG-TEXT = SPACES
                   MOVE DEFAULT-MESSAGE TO DELETE-MSG
                   GO TO DC-EXIT
               ELSE
                   MOVE MESSAGE-BUFFER TO DELETE-MSG
                   MOVE SPACES TO MESSAGE-BUFFER
                   GO TO DC-EXIT.

      **********************************************************************
      **    MESSAGE 029/008:
      **  CANNOT DELETE, DETAIL ENTRIES EXIST
      **********************************************************************
           MOVE  29            TO CATREAD-MSG-SET.
           MOVE   8            TO CATREAD-MSG-NUM.
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
           MOVE MESSAGE-BUFFER TO ERRMSG.
           MOVE TRUE-VAL       TO IND(99).
           GO TO DC-EXIT.

       DBFIND-DELETE.
           MOVE DIST-CODE      TO NEWSKEY OF NEWS-TABLE.
           START NEWS-TABLE    KEY = NEWSKEY OF NEWS-TABLE.
           IF FILE-STAT NOT = "00"
               GO TO END-OF-JOB.

       DBGET-DELETE.
           READ NEWS-TABLE NEXT INTO DISTRIBUTION-TABLE.
           IF FILE-STAT NOT = "00"
               IF FILE-STAT = "10" OR "14" OR "46"
                   GO TO END-OF-JOB
               ELSE
                   MOVE 0          TO DEL-SW
                   MOVE SPACES     TO DELETE-MSG
                   MOVE "READ    " TO DB-FUNC
                   MOVE "NEWS-TABLE" TO DB-FILE
                   MOVE FILE-STAT  TO CON-WORD
                   MOVE DB-ERROR   TO ERRMSG
                   MOVE TRUE-VAL   TO IND(99)
                   GO TO DC-EXIT.

           IF DIST-KEY NOT = DIST-CODE
               GO TO END-OF-JOB.

           DELETE NEWS-TABLE.
           IF FILE-STAT NOT = "00"
               MOVE 0          TO DEL-SW
               MOVE SPACES     TO DELETE-MSG
               MOVE FILE-STAT  TO CON-WORD
               MOVE "DELETE  " TO DB-FUNC
               MOVE "NEWS-TABLE" TO DB-FILE
               MOVE DB-ERROR   TO ERRMSG
               MOVE TRUE-VAL   TO IND(99)
               GO TO DC-EXIT.

           GO TO DBGET-DELETE.

       DC-EXIT.    EXIT.

       REVERSE-READ.
           READ NEWS-TABLE PRIOR RECORD INTO DISTRIBUTION-TABLE
            AT END GO TO DBFIND-LOOP.
           IF FILE-STAT NOT = "00"
             IF FILE-STAT-1 = "2" OR "4"
                 GO TO DBFIND-LOOP
             ELSE
                 MOVE "READ PRI" TO DB-FUNC
                 MOVE "NEWS-TABLE" TO DB-FILE
                 MOVE FILE-STAT  TO CON-WORD
                 MOVE DB-ERROR   TO ERRMSG
                 MOVE TRUE-VAL   TO IND(99)
                 GO TO SHOWFORM.

           IF DIST-KEY NOT = DIST-CODE
               GO TO DBFIND-LOOP.

           GO TO DBGET-CONTINUE.

       FORWARD-READ.
           READ NEWS-TABLE NEXT RECORD INTO DISTRIBUTION-TABLE
            AT END GO TO DBFIND-LOOP.
           IF FILE-STAT NOT = "00"
             IF FILE-STAT-1 = "2" OR "4"
                 GO TO DBFIND-LOOP
             ELSE
                 MOVE "READ NXT" TO DB-FUNC
                 MOVE "NEWS-TABLE" TO DB-FILE
                 MOVE FILE-STAT  TO CON-WORD
                 MOVE DB-ERROR   TO ERRMSG
                 MOVE TRUE-VAL   TO IND(99)
                 GO TO SHOWFORM.

           IF DIST-KEY NOT = DIST-CODE
               GO TO DBFIND-LOOP.

           GO TO DBGET-CONTINUE.

       GET-DLIST.
           MOVE DIST-CODE      TO NEWSKEY OF NEWS-TABLE.
           START NEWS-TABLE    KEY = NEWSKEY OF NEWS-TABLE.
           IF FILE-STAT NOT = "00"
      **********************************************************************
      **    MESSAGE 040/015:
      **  NO RECORDS FOUND
      **********************************************************************
               MOVE  40        TO CATREAD-MSG-SET
               MOVE  15        TO CATREAD-MSG-NUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER TO ERRMSG
               MOVE TRUE-VAL   TO IND(99)
               GO TO GDL-EXIT.

       DBGET-DLIST.
           READ NEWS-TABLE NEXT INTO DISTRIBUTION-TABLE.
           IF FILE-STAT NOT = "00"
               IF FILE-STAT = "10" OR "14" OR "46"
                   GO TO GDL-CONT
               ELSE
                   MOVE "READ    " TO DB-FUNC
                   MOVE "NEWS-TABLE" TO DB-FILE
                   MOVE FILE-STAT  TO CON-WORD
                   MOVE DB-ERROR   TO ERRMSG
                   MOVE TRUE-VAL   TO IND(99)
                   GO TO GDL-EXIT.

           IF DIST-KEY NOT = DIST-CODE
               GO TO GDL-CONT.

           IF DIST-CC-NUM = "9999"
               MOVE SPACES     TO DIST-CC
           ELSE
              MOVE DIST-CC-NUM TO DIST-CC.

           MOVE DIST-ZONE      TO DIST-ZN.
           MOVE DIST-CRFT      TO DIST-CR.
           MOVE DLIST-LINE     TO DISPLAY-REC.
           ADD  1              TO RECNO.
           WRITE SUBFILE DISPLAY-REC FORMAT "RDSF"
               INDIC ARE SCREEN-INDICATORS.
           GO TO DBGET-DLIST.

       GDL-CONT.
           WRITE DISPLAY-REC FORMAT "RDSB"
               INDIC ARE SCREEN-INDICATORS.
           MOVE B"1"           TO IND(76).
           IF RECNO > 0
               MOVE TRUE-VAL   TO IND(75)
           ELSE
               MOVE NEG-VAL    TO IND(75).
           MOVE DIST-CODE      TO DISPLAY-REC.
           WRITE DISPLAY-REC FORMAT "RDSC"
               INDIC ARE SCREEN-INDICATORS.
           READ DISPLAY-FILE FORMAT "RDSC"
               INDIC ARE SCREEN-INDICATORS.

       GDL-EXIT.    EXIT.

       SUBF-CLEAR.
           MOVE 0              TO RECNO.
           MOVE NEG-VAL        TO IND(75) IND(76).
           MOVE TRUE-VAL       TO IND(77).
           MOVE SPACES         TO DISPLAY-REC.
           WRITE DISPLAY-REC FORMAT "RDSC"
               INDIC ARE SCREEN-INDICATORS.
           MOVE NEG-VAL        TO IND(77).

       END-OF-JOB.
           CLOSE               BULLETIN-BOARD.
           CLOSE               NEWS-TABLE.
           CLOSE               DISPLAY-FILE.
           GOBACK.

       999-CATREAD.
           MOVE SPACES         TO MESSAGE-BUFFER.
           CALL "CCATREAD" USING CATREAD-PARMS.
           MOVE CATREAD-MSG-TEXT TO MESSAGE-BUFFER.

       999-CATREAD-EXIT.    EXIT.

