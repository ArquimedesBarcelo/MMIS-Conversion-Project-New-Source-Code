000200 IDENTIFICATION DIVISION.
000300 PROGRAM-ID.           TTRANCHK.
000400 AUTHOR.               K MOVSESIAN.
000500 DATE-WRITTEN.         MAR 17, 1988.
000600*INSTALLATION.         GOODYEAR TIRE AND RUBBER CO.
000800*REMARKS.
001000**************************************************************
001100*                                                            *
001200*   T T R A N C H K    THIS PROGRAM CHECKS THE DETAIL        *
001300*    TRANSACTIONS (DTRANS) IN CSAS FOR THE FOLLOWING INVALID *
001400*    ACCOUNTING INFORMATION:                                 *
001500*        CLASS - SHOULD NEVER BE '000' OR BLANK              *
001600*        DEPT  - SHOULD NEVER BE BLANK                       *
001700*                SHOULD NEVER BE '0000' IF ADDITIONAL DATA   *
001800*                    IS LESS THAN '010000'                   *
001900*                SHOULD BE '0000' IF ADDITIONAL DATA IS      *
002000*                    GREATER THAN '009999'                   *
002100*        ACCOUNT - SHOULD NEVER BE BLANK                     *
002200*                  SHOULD NEVER BE '000000' UNLESS THE DEPT  *
002300*                      TYPE IS 'PR' (PROCESS) OR             *
002400*                              'MU' (UTILITY)                *
002500*                              'MS' (MISC)                   *
002600*    THE TRANSACTIONS CHECKED ARE 'ISS', 'RET', 'RETV',      *
002700*        'SADJ', 'AADJ', 'INV' (NON-STORES), 'DCHG'          *
002800*    ONLY MONTH TO DATE TRANSACTIONS ARE CHECKED (NO 'PROC'  *
002900*        TCs IN DOCUMENT NUM)                                *
003000*                                                            *
003100**************************************************************
      *C
      *C   07MAR1994    DAVE PLUM
      *C     ADDED CALL TO THE COBOL ERROR HANDLER - MCXCBLERR.
      *C
      *C   05SEP1996    DAVE PLUM
      *C     REVISED PROGRAM FOR CENTURY DATABASE CHANGES.

003400 ENVIRONMENT DIVISION.
003500 CONFIGURATION SECTION.
003600 SOURCE-COMPUTER.      HP-3000.
003700 OBJECT-COMPUTER.      HP-3000.
       COPY SPECIALN IN COPYLIB.
003900
004000 INPUT-OUTPUT SECTION.
004100 FILE-CONTROL.
           SELECT MACCOUNT-INFO-IK-I
               ASSIGN TO DATABASE-MCFLCA0101
               ORGANIZATION IS INDEXED
                 ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
               FILE STATUS IS FILE-STATUS.

           SELECT DTRANS-MC-I
               ASSIGN TO DATABASE-MCFLCA0701
               ORGANIZATION IS INDEXED
                 ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                 WITH DUPLICATES
               FILE STATUS IS FILE-STATUS.

           SELECT MCHT-ACCTS-DP-I
               ASSIGN TO DATABASE-MCFLCA0301
               ORGANIZATION IS INDEXED
                 ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
               FILE STATUS IS FILE-STATUS.

           SELECT ONLINE-PRT ASSIGN TO PRINTER-MCPRT.

           SELECT SORT-FILE  ASSIGN TO DISK-SORT.

