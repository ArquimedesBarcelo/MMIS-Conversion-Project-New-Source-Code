025100******************************************
025200**   PARAMETERS FOR CALLING 'CBLOWSRT'
025300******************************************
025400
025500 COPY CBLOWSRT IN COPYLIB.
025600
025700 COPY TBLOWUP IN COPYLIB.
025800
026100 PROCEDURE DIVISION.
026200
026300 001-BEGIN SECTION.
026400
026500 010-MAINLINE.
           MOVE "C" TO MCXCBLERR-SCOPE.
           CALL "MCXCBLERR" USING MCXCBLERR-SCOPE.

026600*******************************************************
026700**   CALL 'CBLOWSRT' FIRST BEFORE GOING INTO THE
026800**   SORT VERB.  THE FIRST CALL TO 'CBLOWSRT' OPENS
026900**   UP A NEW TEMPORARY FILE 'BLUPDATA' THAT IS USED
027000**   TO WRITE THE BLOWUP INFORMATION IF A BLOWUP
027100**   OCCURS
027200*******************************************************
027300
027400     CALL "CBLOWSRT" USING CBLOWSRT-PARMS,
027500                           ACCTG-BASE,
027600                           BU-PGM-NAME,
027700                           STATUS-AREA,
027800                           DUMMY-VIEW-AREA,
027900                           FILE-STATUS,
028000                           BU-DISPLAY-MSG,
028100                           BU-DISPLAY-FLDS.
028200
028300     SORT SORT-FILE ON ASCENDING KEY SORT-CLASS
028400                                     SORT-MATL-CODE
028500         INPUT PROCEDURE IS 050-PROCESS-TRANS
028600         OUTPUT PROCEDURE IS 700-CREATE-REPORT.
028700     PERFORM 1000-CLOSE-FILES.
028800     GOBACK.
028900
029100 050-PROCESS-TRANS SECTION.
       050-PROCESS-TRANS-PARA.
029200     PERFORM 100-BEGIN.
029300     PERFORM 200-PROCESS-DETAIL
029400         UNTIL END-OF-FILE.
029500
029600**********************************************************
029700*  TRANSFER CONTROL TO LAST STATEMENT IN INPUT PROCEDURE *
029800*  FOR SORTING OF RECORDS.                               *
029900**********************************************************
030000
030100     GO TO 699-PROCESS-EXIT.
030200
030300 100-BEGIN.
030400     PERFORM 9999-OPEN-STUFF.
031300
031400     MOVE "SDPT"                  TO MACCT-KEY.
031500     PERFORM 9999-DBGET7-MACCOUNT-INFO-IK-I.
032200     IF GOOD-CALL
032300         MOVE MACCT-STR-DEPT      TO SAVE-STR-DEPT
032400     ELSE
032500         MOVE "GET MACCOUNT INFO SDPT* 100-B" TO BU-DISPLAY-MSG
032600         MOVE MACCT-KEY TO BU-DISPLAY-FLD (1)
032700         PERFORM 990-BLOWUP.
032800
032900     MOVE "MY"                    TO MACCT-KEY.
031500     PERFORM 9999-DBGET7-MACCOUNT-INFO-IK-I.
033700     IF GOOD-CALL
033800         MOVE MACCT-MONTH         TO MONTH-PARM
033900         MOVE MACCT-YEAR          TO YEAR-PARM
034000     ELSE
034100         MOVE "GET MACCOUNT-INFO MY* 100-B" TO BU-DISPLAY-MSG
034200         MOVE MACCT-KEY TO BU-DISPLAY-FLD (1)
034300         PERFORM 990-BLOWUP.
034400
034500     PERFORM 400-GET-DTRANS.
034600
034800 200-PROCESS-DETAIL.
034900     IF TRANS-DOCUMENT-NUM = "PROC"
035000         NEXT SENTENCE
035100     ELSE
035200     IF TRANS-CODE = "RET " OR "RETV" OR "SADJ" OR
035300                     "AADJ" OR "DCHG"
035400         PERFORM 500-CHECK-ACCTG-DATA
035500     ELSE
035200     IF TRANS-CODE-TRANS = "ISS"
035400         PERFORM 500-CHECK-ACCTG-DATA
035500     ELSE
035600     IF TRANS-CODE = "INV"
035700         IF TRANS-STORES-CODE = "NON-STR"
035800             PERFORM 500-CHECK-ACCTG-DATA
035900         ELSE
036000         IF TRANS-DEPT NOT = SAVE-STR-DEPT
036100             PERFORM 500-CHECK-ACCTG-DATA.
036200
036300     PERFORM 400-GET-DTRANS.
036400
036500 400-GET-DTRANS.
036600     PERFORM 9999-DBGET2-DTRANS-MC-I.
037300     IF GOOD-CALL
037400         NEXT SENTENCE
037500     ELSE
037600         IF END-OF-FILE
037700             NEXT SENTENCE
037800         ELSE
037900             MOVE "DBGET DTRANS * 400-GD" TO BU-DISPLAY-MSG
038000             PERFORM 990-BLOWUP.
038100
038300 500-CHECK-ACCTG-DATA.
038400     MOVE SPACES                  TO SORT-REC.
038500     MOVE "N"                     TO ERR-SW.
038600     IF TRANS-CLASS = "000" OR SPACES
038700         MOVE "Y"                 TO SORT-CLASS-ERR-SW
038800         MOVE "Y"                 TO ERR-SW.
038900
039000     IF TRANS-DEPT = SPACES
039100         MOVE "Y"                 TO SORT-DEPT-ERR-SW
039200         MOVE "Y"                 TO ERR-SW
039300     ELSE
039400     IF TRANS-DEPT = "0000"
039500         IF TRANS-ACCT < "010000"
039600             MOVE "Y"             TO SORT-DEPT-ERR-SW
039700             MOVE "Y"             TO ERR-SW
039800         ELSE
039900             NEXT SENTENCE
040000     ELSE
040100         IF TRANS-ACCT > "009999"
040200             MOVE "Y"             TO SORT-DEPT-ERR-SW
040300             MOVE "Y"             TO ERR-SW.
040400
040500     IF TRANS-ACCT = SPACES
040600         MOVE "Y"                 TO SORT-ACCT-ERR-SW
040700         MOVE "Y"                 TO ERR-SW
040800     ELSE
040900     IF TRANS-ACCT = "000000"
041000         MOVE TRANS-DEPT          TO DEPT-ARG
041100         PERFORM 525-GET-DEPT
041200         IF MCHT-DEPT-TYPE = "PR" OR "MU" OR "MS"
041300             NEXT SENTENCE
041400         ELSE
041500             MOVE "Y"             TO SORT-ACCT-ERR-SW
041600             MOVE "Y"             TO ERR-SW.
041700
041800     IF ERR-SW = "Y"
041900         PERFORM 600-BUILD-SORT-REC.
042000
042200 525-GET-DEPT.
042300     MOVE SPACES                  TO BUF-MCHTACCTS.
042400     PERFORM 9999-DBGET7-MCHT-ACCTS-DP-I.
043100     IF GOOD-CALL
043200         NEXT SENTENCE
043300     ELSE
043400         IF NO-ENTRY
043500             NEXT SENTENCE
043600         ELSE
043700             MOVE "DBGET MMATL-ACCUM * 525-GD" TO BU-DISPLAY-MSG
043800             MOVE DEPT-ARG                  TO BU-DISPLAY-FLD (1)
043900             PERFORM 990-BLOWUP.
044000
044100 600-BUILD-SORT-REC.
044200     MOVE TRANS-DOCUMENT-NUM      TO SORT-DOCUMENT-NUM.
044300     MOVE TRANS-PO-NUM            TO SORT-PO-NUM.
044400     MOVE TRANS-CODE              TO SORT-TRANS-CODE.
044500     MOVE TRANS-ITEM-NUM          TO SORT-ITEM-NUM.
044600     MOVE TRANS-CLASS             TO SORT-CLASS.
044700     MOVE TRANS-DEPT              TO SORT-DEPT.
044800     MOVE TRANS-ACCT              TO SORT-ACCT.
044900     MOVE TRANS-STORES-CODE       TO SORT-MATL-CODE.
045000     MOVE TRANS-QTY               TO SORT-QTY.
045100     MOVE TRANS-UNIT-MEASURE      TO SORT-UNIT-MEASURE.
045200     MOVE TRANS-VALUE             TO SORT-VALUE.
045300     MOVE TRANS-DATE-CN           TO SORT-DATE.
045400     RELEASE SORT-REC.
045500
045800 699-PROCESS-EXIT.
045900     EXIT.
046000
046100 700-CREATE-REPORT SECTION.
       700-CREATE-REPORT-PARA.
046200     PERFORM 710-BEGIN-REPORT.
046300     PERFORM 720-PROCESS-CLASS
046400        UNTIL NO-MORE-SORT = "YES".
046500     IF AT-LEAST-ONE-FOUND = "Y"
046600         NEXT SENTENCE
046700     ELSE
046800         WRITE PRT-REC FROM NO-TRANSACTIONS-FOUND
046900             AFTER ADVANCING 3 LINES.
047000
047100**************************************************
047200**  BRANCH TO LAST STATEMENT OF OUTPUT SECTION  **
047300**  TO COMPLETE PROCESSING OF REPORT            **
047400**************************************************
047500
047600     GO TO 799-CREATE-EXIT.
047700
047800 710-BEGIN-REPORT.
047900     OPEN OUTPUT ONLINE-PRT.
048000     RETURN SORT-FILE
048100        AT END
048200            MOVE "YES" TO NO-MORE-SORT.
048300     PERFORM 750-PRINT-HEADINGS.
048400
048600 720-PROCESS-CLASS.
048700     MOVE SORT-CLASS              TO PREV-CLASS.
048800     PERFORM 722-PROCESS-TRANS
048900         UNTIL SORT-CLASS NOT = PREV-CLASS
049000             OR  NO-MORE-SORT = "YES".
049100     PERFORM 730-END-CLASS.
049200
049400 722-PROCESS-TRANS.
049500     MOVE "Y"                     TO AT-LEAST-ONE-FOUND.
049600     MOVE SORT-TRANS-CODE         TO PRT-TRANS.
049700     MOVE SORT-DOCUMENT-NUM       TO PRT-DOCUMENT.
049800     MOVE SORT-PO-NUM             TO PRT-PO-NUM.
049900     MOVE SORT-ITEM-NUM           TO PRT-ITEM-NUM.
050000     MOVE SORT-CLASS              TO PRT-CLASS.
050100     MOVE SORT-DEPT               TO PRT-DEPT.
050200     MOVE SORT-ACCT               TO PRT-ACCT.
050300     MOVE 4                       TO DATE-MODE.
050400     MOVE SORT-DATE-YYMMDD        TO DATE-VALIDATE-IN.
050500     CALL "TDATECHK" USING DATE-CHECK-AREA.
050600     MOVE DATE-SLASH-OUT          TO PRT-TRANS-DATE.
050700     MOVE SORT-MATL-CODE          TO PRT-MATL-CODE.
050800     MOVE SORT-QTY                TO PRT-QTY.
050900     MOVE SORT-UNIT-MEASURE       TO PRT-UNIT-MEASURE.
051000     MOVE SORT-VALUE              TO PRT-VALUE.
051100     WRITE PRT-REC FROM DETAIL-LINE AFTER 1.
051200     ADD 1                        TO LINE-CNT.
051300
051400     IF SORT-CLASS-ERR-SW NOT = SPACES
051500         WRITE PRT-REC FROM ACCTG-CLASS-ERR-MSG
051600             AFTER ADVANCING 1
051700         ADD 1                    TO LINE-CNT.
051800
051900     IF SORT-DEPT-ERR-SW NOT = SPACES
052000         WRITE PRT-REC FROM DEPT-ERR-MSG1
052100             AFTER ADVANCING 1
052200         WRITE PRT-REC FROM DEPT-ERR-MSG2
052300             AFTER ADVANCING 1
052400         ADD 2                    TO LINE-CNT.
052500
052600     IF SORT-ACCT-ERR-SW NOT = SPACES
052700         WRITE PRT-REC FROM ACCT-ERR-MSG
052800             AFTER ADVANCING 1
052900         ADD 1                    TO LINE-CNT.
053000
053100     IF LINE-CNT > 55
053200         PERFORM 750-PRINT-HEADINGS.
053300     MOVE SPACES                  TO DETAIL-LINE.
053400
053500     RETURN SORT-FILE
053600        AT END
053700             MOVE "YES" TO NO-MORE-SORT.
053800
054000 730-END-CLASS.
054100     WRITE PRT-REC FROM BLANK-LINE AFTER ADVANCING 2 LINES.
054200     ADD 2                        TO LINE-CNT.
054300     IF NO-MORE-SORT = "YES"
054400         NEXT SENTENCE
054500     ELSE
054600         IF LINE-CNT > 55
054700             PERFORM 750-PRINT-HEADINGS.
054800
055000 750-PRINT-HEADINGS.
055100     MOVE 1                       TO DATE-MODE.
055200     CALL "TDATECHK" USING DATE-CHECK-AREA.
055300     MOVE DATE-SLASH-OUT          TO DATE-H1.
055400     MOVE DATE-FORMATTED-TIME-OUT TO TIME-H2.
055500     ADD 1                        TO PAGE-CNT.
055600     MOVE PAGE-CNT                TO PAGE-H2.
055700     MOVE MONTH-T (MONTH-PARM)    TO MONTH-H3.
055800     MOVE YEAR-PARM               TO YEAR-H3B.
055900     WRITE PRT-REC FROM HEADER1 AFTER ADVANCING NEW-PAGE.
056000     WRITE PRT-REC FROM HEADER2 AFTER ADVANCING 1.
056100     WRITE PRT-REC FROM HEADER3 AFTER ADVANCING 1.
056200     WRITE PRT-REC FROM HEADER4 AFTER ADVANCING 2.
056300     WRITE PRT-REC FROM BLANK-LINE AFTER ADVANCING 2.
056400     MOVE 7                       TO LINE-CNT.
056500
056900 799-CREATE-EXIT.
057000     EXIT.
057100
057200 900-ERROR SECTION.
057300
057400 990-BLOWUP.
057500
057600***************************************************************
057700**   CALL 'CBLOWSRT' INSTEAD OF 'TBLOWUP' WHEN A BLOWUP      **
057800**   SITUATION OCCURS SINCE THIS PROGRAM USES THE 'SORT'     **
057900**   VERB.  'CBLOWSRT' WRITES ALL THE BLOWUP INFORMATION     **
058000**   TO A TEMPORARY FILE 'BLUPDATA' (WHICH WAS OPENED AT     **
058100**   THE BEGINNING OF THE PROGRAM) THE CLOSES IT. THEN IT    **
058200**   CREATESA A SON PROCESS 'XBLOWSRT' THAT READS THE        **
058300**   BLOWUP INFORMATION OUT OF 'BLUPDATA' AND CALLS          **
058400**   'TBLOWUP' USING THIS INFO.  SINCE THE NEW PROCESS       **
058500**   'XBLOWSRT' HAS ITS OWN STACK THE STACK OVERFLOW         **
058600**   PROBLEM IS AVOIDED.                                     **
058700***************************************************************
058800
058900     MOVE "TTRANCHK"              TO  BU-PGM-NAME.
059000     CALL "CBLOWSRT" USING CBLOWSRT-PARMS,
059100                           ACCTG-BASE,
059200                           BU-PGM-NAME,
059300                           STATUS-AREA,
059400                           DUMMY-VIEW-AREA,
059500                           FILE-STATUS,
059600                           BU-DISPLAY-MSG,
059700                           BU-DISPLAY-FLDS.
060000
060100 1000-CLOSE-FILES.
060200     CLOSE ONLINE-PRT.
060300     PERFORM 9999-CLOSE-STUFF.

       9999-DBGET7-MACCOUNT-INFO-IK-I.
           MOVE 0 TO COND-WORD.
           MOVE MACCT-KEY TO INFOKEY OF MACCOUNT-INFO-IK-REC-I.
           READ MACCOUNT-INFO-IK-I INTO BUF-MACCT-INFO
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS = "23"
               MOVE 17 TO COND-WORD
           ELSE
               IF FILE-STATUS NOT = "00"
                   MOVE 99 TO COND-WORD.

       9999-DBGET2-DTRANS-MC-I.
           MOVE 0 TO COND-WORD.
           READ DTRANS-MC-I NEXT INTO BUF-DTRANS
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS-1 = "1" OR FILE-STATUS = "46"
               MOVE 11 TO COND-WORD
           ELSE
               IF FILE-STATUS NOT = "00"
                   MOVE 99 TO COND-WORD.

       9999-DBGET7-MCHT-ACCTS-DP-I.
           MOVE 0 TO COND-WORD.
           MOVE DEPT-ARG TO DEPT OF MCHT-ACCTS-DP-REC-I.
           READ MCHT-ACCTS-DP-I INTO BUF-MCHTACCTS
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS = "23"
               MOVE 17 TO COND-WORD
           ELSE
               IF FILE-STATUS NOT = "00"
                   MOVE 99 TO COND-WORD.

       9999-OPEN-STUFF.
           OPEN INPUT MACCOUNT-INFO-IK-I   .
           OPEN INPUT DTRANS-MC-I          .
           OPEN INPUT MCHT-ACCTS-DP-I      .

       9999-CLOSE-STUFF.
           CLOSE      MACCOUNT-INFO-IK-I   .
           CLOSE      DTRANS-MC-I          .
           CLOSE      MCHT-ACCTS-DP-I      .
