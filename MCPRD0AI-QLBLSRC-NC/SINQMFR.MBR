035900 BEGIN-HERE.
036000     PERFORM 1000-HSK.
036100     PERFORM 6000-MAIN THRU 6990-MAIN-X.
           CLOSE DMANPART-MAN, DMANPART-PART, DCODE-KEY, DCODE-CODE,
             DISPLAY-FILE.
036200     GOBACK.
036300
036400 1000-HSK.
036500     MOVE "SINQMFR" TO BU-PGM-NAME.
           MOVE 0 TO SUB.

           OPEN INPUT DMANPART-MAN, DMANPART-PART,
             DCODE-KEY, DCODE-CODE, MMANUFACT, MKEYADJ.
           OPEN I-O DISPLAY-FILE.
036600
           MOVE SPACES TO RETURN-CODES, VENDOR-TABLE.
           MOVE ZEROS TO RET-SUB.

036700     MOVE MPLTINFO-PLANT-CODE TO TMTLSTAT-COMPANY.
036800
041100*********************************************************
041200**                  BLOWUP ROUTINE                     **
041300*********************************************************
041400
041500 2100-BLOWUP.
041600     MOVE DE-MANUFACTURER          TO   BU-DISPLAY-FLD (1).
041700     MOVE DE-MAN-PARTNO            TO   BU-DISPLAY-FLD (2).
041800     MOVE DE-KW-SELECT             TO   BU-DISPLAY-FLD (3).
041900     MOVE DE-MOD-SELECT            TO   BU-DISPLAY-FLD (4).
042000     MOVE DE-CODE-1-5              TO   BU-DISPLAY-FLD (5).
042100     CALL "TBLOWUP" USING BASE, BU-PGM-NAME, STATUS-AREA,
042200           VIEW-COMAREA, FILE-STATUS, BU-DISPLAY-MSG,
042300           BU-DISPLAY-AREA.
042400
044500 4100-SETERROR.
           MOVE B"1" TO IND (99).
           MOVE B"1" TO IND (FIELD-NUMBER).
           MOVE MESSAGE-BUFFER TO DE-MESSAGE-LINE-1.
051300
045500 4110-S-X.
045600     EXIT.
045700
045800 4120-GET-FORM-1.
045900*------ CALLING MODES:  'M' = MANUFACTURER INQUIRY
046000*------                 'K' = KEYWORD/MODIFIER INQUIRY
046100     IF MFR-KWM-FLAG = "M"
046200         MOVE "INQMFR"             TO   VIEW-NFNAME
046300     ELSE
046400         MOVE "INQKWM"             TO   VIEW-NFNAME.
047800*********************************************************
047900*                                                       *
048000*                      6 - M A I N                      *
048100*                                                       *
048200*********************************************************
048300
048400 6000-MAIN.
           MOVE "N" TO SEARCH-KSAM.
           MOVE ALL B"0" TO SRF-INDICATORS.
048500     PERFORM 4120-GET-FORM-1.
048600 6010-PUT-WINDOW.
048700     MOVE SPACES TO MESSAGE-BUFFER.
048900
049000 6020-PUT-BUFFER.
049100     MOVE SPACES TO DE-FIELDS-1.
050000 6100-SHOW-FORM.
050100*----- f1 APPL, f2,f3,f6,f7 INVALID, f4 REFRESH, f5 PRINT
050200*----- NOTE: FOR FKEY 1, WE WANT TO FIELDEDIT.
050300     MOVE 6                        TO   SRF-KEYSET.
050400     MOVE "I"                      TO   SRF-FKEY (7).
050500     MOVE " AFE"                   TO   SRF-FKEY (1).
           MOVE DE-FIELDS-1 TO DISPLAY-REC.
           PERFORM 998-WRITE-SCREEN THRU 998-READ-SCREEN.
           MOVE DISPLAY-REC TO DE-FIELDS-1.
           MOVE DE-FIELD1   TO V-MFR.
051100
051200*------ MAJOR GROUP HELP SCREENS
      *------ ADDED MOVE STMTS INVOLVING VIEW-CFNAME TO RESOLVE A
      *------ PROGRAM BUG.  THE F2 KEY WAS NOT FUNCTIONAL IN THE
      *------ AS/400 VERSION OF THIS PROGRAM UNTIL THIS CHANGE WAS
      *------ MADE.   16FEB1993  DAVE PLUM
051300     IF VIEW-LASTKEY = 2
               MOVE "ZCSISINQ" TO VIEW-CFNAME
051400         CALL "SHELPSCR" USING VIEW-COMAREA, LANGUAGE-PARMS,
051500           HELP-FORM-PREFIX
               MOVE "ZINQMFR"  TO VIEW-CFNAME
051600         PERFORM 4120-GET-FORM-1
051700         GO TO 6100-SHOW-FORM.
051800
051900     IF VIEW-LASTKEY = EXIT-PROGRAM
052000         MOVE SPACES TO MESSAGE-BUFFER
052200         GO TO 6990-MAIN-X.
052300
052400     MOVE VIEW-LASTKEY TO SAVE-VIEW-LASTKEY.
052500
053500 6120-EDIT-MFR.
053600*------- DO A DBFIND ON EITHER MANUFACTURER OR KEYWORD MODIFIER
053700     IF MFR-KWM-FLAG = "M"
053800         MOVE DE-MANUFACTURER      TO   SEND-MFR
053900         CALL "CRFMTMFR" USING REFORMAT-MFR-AREA, BASE,
054000           VIEW-COMAREA
054100         MOVE RETURN-MFR           TO   KWM-OR-MFR-ARG,
054200                                        DE-MANUFACTURER
054300         MOVE "MANUFACTURER;"      TO   KWM-OR-MFR-SEARCH
054400         MOVE "DMANPART;"          TO   DSET-NAME
054500     ELSE
054600         MOVE DE-KEYWORD           TO   SEND-KW
054700         MOVE DE-MODIFIER          TO   SEND-MOD
054800         CALL "CRFMTKWM" USING REFORMAT-KWM-AREA, BASE,
054900           VIEW-COMAREA
055000         MOVE RETURN-KWM           TO   KWM-OR-MFR-ARG,
055100         MOVE RETURN-KW            TO   DE-KEYWORD
055200         MOVE RETURN-MOD           TO   DE-MODIFIER
055300         MOVE "KEYWORD-ADJ;"       TO   KWM-OR-MFR-SEARCH
055400         MOVE "DCODE;"             TO   DSET-NAME.
055500
           IF MFR-KWM-FLAG = "M" AND DE-MANUFACTURER = SPACES
           AND DE-MAN-PARTNO > SPACES
               NEXT SENTENCE
           ELSE
055700*        CALL "DBFIND" USING BASE, DSET-NAME, MODE1,
055800*          STATUS-AREA, KWM-OR-MFR-SEARCH, KWM-OR-MFR-ARG
               PERFORM 9000-DBGET-7
055900         IF NO-ENTRY
056000             GO TO 9200-KSAM-SEARCH
056100         ELSE
056200         IF NOT GOOD-CALL
056300             MOVE "DBFIND DCODE ERROR IN 6120-EDIT-MFR"
056400                 TO BU-DISPLAY-MSG
056500             PERFORM 2100-BLOWUP.
056600
056700***** ALTHOUGH THE DBFIND ON "DMANPART" MAY RETURN A     *****
056800***** COND-WORD OF 0, THERE MAY BE ZERO ENTRIES FOR THE  *****
056900***** MANUFACTURER IN "DMANPART".  CHAIN-LENG = 0        *****
057000***** IDENTIFIES THE SITUATION WHERE THE MANUFACTURER    *****
057100***** EXISTS IN THE DATA SET "MMANUFACT", BUT IS NOT     *****
057200***** LINKED TO ANY CODES.                               *****
057300*****                                                    *****
057400
           PERFORM 9010-DBFIND.
057500     IF DE-MANUFACTURER > SPACES
057600         IF COND-WORD NOT = 0
057700             IF MFR-KWM-FLAG = "M"
057800***              MANUFACTURER EXISTS, BUT NOT LINKED TO ANY CODES*
057900                 MOVE  13 TO LANG-SETNUM
058000                 MOVE  19 TO LANG-MSGNUM
058100                 PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
058200                 MOVE  1  TO FIELD-NUMBER
058300                 PERFORM 4100-SETERROR THRU 4110-S-X
058400                 GO TO 6100-SHOW-FORM
058500             ELSE
058600***             KEYWORD/MODIFIER EXISTS BUT NOT LINKED TO ANY CODES *
058700                 MOVE  11 TO LANG-SETNUM
058800                 MOVE   6 TO LANG-MSGNUM
058900                 PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
059000                 MOVE   1 TO FIELD-NUMBER
059100                 PERFORM 4100-SETERROR THRU 4110-S-X
059200                 GO TO 6100-SHOW-FORM.
059300
059400*------ IF INQUIRE BY MANUFACTURER AND PARTNO, THE SMALLER CHAIN
059500*------ IS PROBABLY THE PARTNO CHAIN.
059600     IF DE-MAN-PARTNO > SPACES AND MFR-KWM-FLAG = "M"
               PERFORM 9121-DETIRMINE-PARTIAL THRU 9121-DP-X
059700         MOVE "MAN-PARTNO;"        TO   KWM-OR-MFR-SEARCH
059800         MOVE DE-MAN-PARTNO        TO   KWM-OR-MFR-ARG
059900*        CALL "DBFIND" USING BASE, DSET-NAME, MODE1,
060000*          STATUS-AREA, KWM-OR-MFR-SEARCH, KWM-OR-MFR-ARG
               PERFORM 9010-DBFIND
060100         IF NO-ENTRY
060200***          "MANUFACTURER'S NUMBER DOES NOT EXIST"
060300             MOVE  13              TO   LANG-SETNUM
060400             MOVE  20              TO   LANG-MSGNUM
060500             PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
060600             MOVE 9                TO   FIELD-NUMBER
060700             PERFORM 4100-SETERROR THRU 4110-S-X
060800             GO TO 6100-SHOW-FORM
060900         ELSE
061000         IF NOT GOOD-CALL
061100             MOVE "DBFIND ERR MANPARTNO 6-EF" TO BU-DISPLAY-MSG
061200             PERFORM 2100-BLOWUP.
061300
062200     MOVE SPACES                   TO   DE-SUBFILE.
062300
       6200-LOAD-SUBFILE.
           PERFORM 7300-CLEAR-SUBFILE THRU 7310-CS-X.
           MOVE 0 TO RELATIVE-RECNO.

       6205-NEXT-SCREEN.
      *------ WE READ UP TO 9 RECORDS AHEAD, AT END OF CHAIN WE
      *------ TELL SUBFILE NO MORE RECORDS BY SETTING INDICATOR 74
           PERFORM 6500-MOVE-FORWARD THRU 6510-MF-X.
           IF COND-WORD NOT = 0
               MOVE B"0" TO IND(74)
           ELSE
               MOVE B"1" TO IND(74).

       6210-DISPLAY-SUBFILE.
           WRITE DISPLAY-REC FORMAT "RDSB" INDICATORS SRF-INDICATORS.
           MOVE B"1" TO IND(76).
           IF RELATIVE-RECNO > ZERO
               MOVE B"1" TO IND(75)
           ELSE
               MOVE B"0" TO IND(75).
           MOVE SUBFILE-CONTROL TO DISPLAY-REC.
           WRITE DISPLAY-REC FORMAT "RDSC" INDICATORS SRF-INDICATORS.
           READ DISPLAY-FILE FORMAT "RDSC" INDICATORS SRF-INDICATORS.

      *------ THE SUBFILE IS SET FOR ONLY 9 RECORDS. IF ROLLUP IS
      *------ HIT (NEXT SCREEN ASKED FOR), IND 78 IS SET
           IF (IND (78) = B"1")
               GO TO 6205-NEXT-SCREEN
           ELSE
           IF (IND (03) = B"1")
               PERFORM 8000-LOAD-SELECTED-CODES
               IF SEARCH-KSAM = "Y"
                   GO TO 9200-KSAM-SEARCH
               ELSE
                   GO TO 6000-MAIN.

075800 6220-EDIT-REQUESTS.
           MOVE RELATIVE-RECNO TO SAVE-RELATIVE-RECNO.
       6225-EDIT-REQUESTS-LOOP.
           READ SUBFILE DISPLAY-FILE NEXT MODIFIED RECORD
             FORMAT "RDSF" INDICATORS SRF-INDICATORS
             AT END GO TO 6230-ER-X.
           IF DISPLAY-STATUS NOT = "00"
               GO TO 6230-ER-X.
           MOVE DISPLAY-REC TO DE-SUBFILE.
      *    *** SUBFILE WONT LET YOU REWRITE IDENTICAL REC.
      *    *** IF AN 'S' AND HIT ENTER, MUST FORCE MODIFIED REC
           IF DE-SELECT-FLAG = "S"
               MOVE "Y" TO DE-SELECT-FLAG
               MOVE DE-SUBFILE TO DISPLAY-REC
               MOVE B"1" TO IND(14)
               REWRITE SUBFILE DISPLAY-REC FORMAT "RDSF"
                 INDICATORS SRF-INDICATORS
               END-REWRITE
               GO TO 6225-EDIT-REQUESTS-LOOP
           ELSE
           IF DE-SELECT-FLAG = "Y"
               MOVE "S" TO DE-SELECT-FLAG
               MOVE DE-SUBFILE TO DISPLAY-REC
               MOVE B"1" TO IND(14)
               REWRITE SUBFILE DISPLAY-REC FORMAT "RDSF"
                 INDICATORS SRF-INDICATORS
               END-REWRITE
               GO TO 6225-EDIT-REQUESTS-LOOP
           ELSE
           IF DE-SELECT-FLAG = "X" AND V-CODE > SPACES
               NEXT SENTENCE
           ELSE
               GO TO 6225-EDIT-REQUESTS-LOOP.
      *------ MARK THIS CODE AS SELECTED TO RETURN TO CALLER
           MOVE B"1" TO IND(14).
           MOVE "S"    TO DE-SELECT-FLAG.
           MOVE DE-SUBFILE TO DISPLAY-REC.
           REWRITE SUBFILE DISPLAY-REC FORMAT "RDSF"
             INDICATORS SRF-INDICATORS.

085400     MOVE V-CODE TO TMTLSTAT-CODE.
085600     CALL "TMTLSTAT" USING BASE,
085700                           VIEW-COMAREA,
085800                           TMTLSTAT-COMPANY,
085900                           PASSED-SPOOL-PRT,
086000                           TMTLSTAT-CODE,
086100                           LANGUAGE-PARMS.
086400
           GO TO 6225-EDIT-REQUESTS-LOOP.

077700 6230-ER-X.
      *------ THE READ MODIFIED REC CHANGED THE CURRENT RELATIVE
      *------ RECNO IN THE SUBFILE, SO WE GET THAT BACK. ALSO WE WANT
      *------ TO RETURN TO THE SCREEN WE WERE ON, WHICH CAN BE
      *------ CALCULATED BY THE RELATIVE RECNO OF THE CODE INQUIRED ON.
           COMPUTE SUBFILE-CONTROL-RECNO =
             RELATIVE-RECNO / (NUM-CODES-PER-SCREEN + 1).
           COMPUTE SUBFILE-CONTROL-RECNO =
             SUBFILE-CONTROL-RECNO * NUM-CODES-PER-SCREEN + 1.
           MOVE SAVE-RELATIVE-RECNO TO RELATIVE-RECNO.
           GO TO 6210-DISPLAY-SUBFILE.

086500 6500-MOVE-FORWARD.
           MOVE 0 TO SUB.
           MOVE "Y" TO FIRST-TIME-FLAG.
       6510-MOVE-FORWARD-LOOP.
           IF SUB > 8
               GO TO 6510-MF-X.
           PERFORM 9020-DBGET.
           IF COND-WORD NOT = 0
               GO TO 6510-MF-X.
           PERFORM 7100-CHECK-SELECTIONS THRU 7110-CS-X.
           IF LAST-SCRN-FLAG = "Y"
               GO TO 6510-MF-X.
           IF CODE-SELECTED-FLAG NOT = "Y"
               GO TO 6510-MOVE-FORWARD-LOOP.
           ADD 1 TO RELATIVE-RECNO.
           ADD 1 TO SUB.
      *------ THE SUBFILE CONTROL RECORD NUMBER ALLOWS US TO POSITION
      *------ THE SUBFILE AT A CERTAIN RELATIVE RECNO. AFTER WE COME
      *------ OUT OF A SCRN WITH A ROLLDOWN PAST END, WE WANT TO
      *------ POSITION TO THE 1ST REC OF NEXT SCRN.
           IF FIRST-TIME-FLAG = "Y"
               MOVE "N" TO FIRST-TIME-FLAG
               MOVE RELATIVE-RECNO TO SUBFILE-CONTROL-RECNO.
           PERFORM 6600-MOVE-TO-SCRN.
           MOVE SPACES TO DE-SELECT-FLAG.
           MOVE DE-SUBFILE TO DISPLAY-REC.
           WRITE SUBFILE DISPLAY-REC FORMAT "RDSF"
             INDICATORS SRF-INDICATORS.
           GO TO 6510-MOVE-FORWARD-LOOP.

089900 6510-MF-X.
090000     EXIT.
093300
       6600-MOVE-TO-SCRN.
099900     MOVE CODE-WORK                TO   V-CODE.
100000     IF MFR-KWM-FLAG = "M"
100100*------- CONVERT THE MANUFACTURER PART TYPE ABBREV TO SHORT DESC
100200         MOVE MAN-PARTNO-TYPE      TO   CFINPTYP-TYPE-DB
100300         CALL "CFINPTYP" USING CFINPTYP-PARMS
100400         MOVE CFINPTYP-TYPE-SHORT  TO   V-TYPE
100500         MOVE MAN-PARTNO           TO   V-PARTNO
100600     ELSE
100700         MOVE SPACES               TO   V-TYPE
100800                                        V-PARTNO.
100900
101000*------- GET 1 LINE DESC FOR SCRN. IF USER HIT F1 FROM MFR ENTRY
101100*------- SCRN, GET SECONDARY DESC.
101200     MOVE 2                        TO   CDESC-LINES-TO-GET.
101300     IF SAVE-VIEW-LASTKEY = 1
101400         MOVE "S"                  TO   CDESC-LANGUAGE-OPTION
101500     ELSE
101600         MOVE "P"                  TO   CDESC-LANGUAGE-OPTION.
101700     MOVE "D"                      TO   CDESC-DESC-OPTION.
101800     MOVE "N"                      TO   CDESC-LOCAL-DESC-OPTION.
101900     MOVE V-CODE               TO   CODE-ARG.
           MOVE COND-WORD TO SAVE-COND-WORD.
102000     CALL "CDESC" USING CDESC-RET-CODE, BASE, STATUS-AREA,
102100       BU-DISPLAY-MSG, CODE-ARG, CDESC-DATA.
           MOVE SAVE-COND-WORD TO COND-WORD.
102200     IF BU-DISPLAY-MSG-1 NOT = SPACES
102300         PERFORM 2100-BLOWUP.
103000     MOVE CDESC (2) TO   V-DESC-LN.
102400
102500     IF MFR-KWM-FLAG = "M"
102600         MOVE CDESC (1) TO   V-KWM
102700     ELSE
               MOVE 1 TO CDESC-LINES-TO-GET
               MOVE "M"  TO CDESC-DESC-OPTION
               CALL "CDESC" USING CDESC-RET-CODE, BASE, STATUS-AREA,
                 BU-DISPLAY-MSG, CODE-ARG, CDESC-DATA
      *********MOVE CDESC (1) TO V-KWM.
               MOVE CDESC (1) TO V-MNF-LINE.
102900
103100
104100 6990-MAIN-X.
104200     EXIT.
104300
107800 7100-CHECK-SELECTIONS.
107900     MOVE "Y"                      TO   CODE-SELECTED-FLAG.
           MOVE "N"                      TO   LAST-SCRN-FLAG.
108000     IF DE-MAJOR-GROUP > SPACES
108100         IF CODE-MAJOR-GROUP NOT = DE-MAJOR-GROUP
108200             MOVE "N"              TO   CODE-SELECTED-FLAG
108300             GO TO 7105-CHECK-LAST.
108400     IF DE-SUB-GROUP > SPACES
108500         IF CODE-SUB-GROUP NOT = DE-SUB-GROUP
108600             MOVE "N"              TO   CODE-SELECTED-FLAG
108700             GO TO 7105-CHECK-LAST.
108800     IF DE-SEQUENCE-1 > SPACES
108900         IF CODE-SEQUENCE-1 NOT = DE-SEQUENCE-1
109000             MOVE "N"              TO   CODE-SELECTED-FLAG
109100             GO TO 7105-CHECK-LAST.
109200     IF MFR-KWM-FLAG = "M"
109300         IF DE-MANUFACTURER > SPACES
109400             IF MAN-NAME NOT = DE-MANUFACTURER
109500                 MOVE "N"          TO   CODE-SELECTED-FLAG
109600                 GO TO 7105-CHECK-LAST.
109700     IF DE-KW-SELECT > SPACES OR DE-MOD-SELECT > SPACES
109800         PERFORM 7200-FIND-GET-DCODE THRU 7290-FGD-X.
109900     IF DE-KW-SELECT > SPACES
110000         IF CODE-KEYWORD NOT = DE-KW-SELECT
110100             MOVE "N"              TO   CODE-SELECTED-FLAG
110200             GO TO 7105-CHECK-LAST.
110300     IF DE-MOD-SELECT > SPACES
110400         IF CODE-MODIFIER NOT = DE-MOD-SELECT
110500             MOVE "N"              TO   CODE-SELECTED-FLAG
110600             GO TO 7105-CHECK-LAST.
110700
110800*------- FOR INQUIRY BY KEYWORD MODIFIER, WE ONLY WANT CODES
110900*------- LINKED TO THAT KWM FOR THE PROPER LANGUAGE (OTHERWISE YOU
111000*------- WOULD GET 2 IF CODE WAS LINKED FOR BOTH LANGUAGES).
111100     IF MFR-KWM-FLAG = "K"
111200         IF SAVE-VIEW-LASTKEY = 1
111300             IF CODE-LANGUAGE-IND = "2"
111400                 NEXT SENTENCE
111500             ELSE
111600                 MOVE "N"          TO   CODE-SELECTED-FLAG
111700         ELSE
111800         IF CODE-LANGUAGE-IND = "1"
111900             NEXT SENTENCE
112000         ELSE
112100             MOVE "N"              TO   CODE-SELECTED-FLAG.
112200
112300 7105-CHECK-LAST.
112400*------- KEYWORD/MOD CHAIN IS SORTED BY CODE, SO IF SELECTING
112500*------- BY MAJOR GROUP/SUB GROUP, QUIT WHEN BEYOND LARGEST
112600*------- POSSIBLE CODE
112700     IF MFR-KWM-FLAG = "K"
112900         IF DE-MAJOR-GROUP > SPACES AND DE-SUB-GROUP > SPACES
113000          AND DE-SEQUENCE-1 > SPACES
113100          AND CODE-WORK-1-5 > DE-CODE-1-5
113200             MOVE "Y"          TO   LAST-SCRN-FLAG
113300         ELSE
113400         IF DE-MAJOR-GROUP > SPACES AND DE-SUB-GROUP > SPACES
113500          AND CODE-MAJOR-GROUP > DE-MAJOR-GROUP
113600          AND CODE-SUB-GROUP > DE-SUB-GROUP
113700             MOVE "Y"          TO   LAST-SCRN-FLAG
113800         ELSE
113900         IF DE-MAJOR-GROUP > SPACES
114000          AND CODE-MAJOR-GROUP > DE-MAJOR-GROUP
114100             MOVE "Y"          TO   LAST-SCRN-FLAG.
114200
114300 7110-CS-X.
114400     EXIT.
114500
114600 7200-FIND-GET-DCODE.
114700*------ THIS SECTION CAN BE EXECUTED FROM MANUFACTURER INQUIRY
114800*------ ONLY.  THEY CAN SELECT ON KEYWORD/MOD, SO HAVE TO
114900*------ GET THE DETAIL FOR THAT CODE
115000*    CALL "DBFIND" USING BASE, DSET-DCODE, MODE1, STATUS-AREA,
115100*      CODE-SEARCH, MAN-CORPCODE.
           MOVE 0 TO COND-WORD.
           MOVE MAN-CORPCODE TO CORPCDE OF DCODE-CODE-REC.
           START DCODE-CODE KEY = CORPCDE OF DCODE-CODE-REC
               INVALID KEY MOVE 0 TO COND-WORD.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
                   MOVE 0 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.
115200     IF NOT GOOD-CALL
115300         MOVE "DBFIND ERR 7200-FGD" TO BU-DISPLAY-MSG
115400         PERFORM 2100-BLOWUP.
115500
115600 7210-GET-DCODE-LOOP.
115700*    CALL "DBGET" USING BASE, DSET-DCODE, MODE5, STATUS-AREA,
115800*      ALL-ITEMS, BUF-DCODE, MAN-CORPCODE.
           MOVE 0 TO COND-WORD.
           READ DCODE-CODE NEXT INTO BUF-DCODE
               AT END MOVE 15 TO COND-WORD.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   MOVE 15 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.
           IF CORPCDE OF DCODE-CODE-REC NOT = MAN-CORPCODE
               MOVE 15 TO COND-WORD.
115900     IF END-OF-CHAIN
116000         MOVE SPACES               TO   BUF-DCODE
116100         GO TO 7290-FGD-X
116200     ELSE
116300     IF NOT GOOD-CALL
116400         MOVE "DBGET ERR DCODE 7210-GDL" TO BU-DISPLAY-MSG
116500         PERFORM 2100-BLOWUP.
116600
116700     IF SAVE-VIEW-LASTKEY = 1
116800         IF CODE-LANGUAGE-IND = "2"
116900             NEXT SENTENCE
117000         ELSE
117100             GO TO 7210-GET-DCODE-LOOP
117200     ELSE
117300     IF CODE-LANGUAGE-IND = "1"
117400         NEXT SENTENCE
117500     ELSE
117600         GO TO 7210-GET-DCODE-LOOP.
117700
       7290-FGD-X.
           EXIT.

       7300-CLEAR-SUBFILE.
           MOVE B"0" TO IND (75), IND (76).
           MOVE B"1" TO IND (77).
           MOVE SUBFILE-CONTROL TO DISPLAY-REC.
           WRITE DISPLAY-REC FORMAT "RDSC" INDICATORS SRF-INDICATORS.
           MOVE B"0" TO IND (77).
           MOVE ZERO TO RELATIVE-RECNO.
       7310-CS-X.
           EXIT.

       8000-LOAD-SELECTED-CODES.
      *------JSB 3/20/97 TO ALLOW RETRIEVAL FROM MULTIPLE SCREENS
      *    MOVE ZERO TO RET-SUB.
           MOVE "N" TO END-SUBFILE.
           PERFORM UNTIL END-SUBFILE = "Y"
               READ SUBFILE DISPLAY-FILE NEXT MODIFIED RECORD
                 FORMAT "RDSF" INDICATORS SRF-INDICATORS
                 AT END MOVE "Y" TO END-SUBFILE
               END-READ
               IF DISPLAY-STATUS NOT = "00"
                   MOVE "Y" TO END-SUBFILE
               END-IF
               IF END-SUBFILE = "N"
                   MOVE DISPLAY-REC TO DE-SUBFILE
                   IF DE-SELECT-FLAG = "S" OR "Y"
                       IF RET-SUB > 14
                           MOVE 15 TO RET-SUB
                       ELSE
                           ADD 1 TO RET-SUB
                       END-IF
                       MOVE V-CODE TO RET-CODE (RET-SUB)
                   END-IF
               END-IF
           END-PERFORM.

       9000-DBGET-7.
           IF DSET-NAME = "DMANPART;"
               MOVE 0 TO COND-WORD
               MOVE KWM-OR-MFR-ARG TO MANUFACT OF MMANUFACT-REC
               READ MMANUFACT INTO BUF-MMANUFACT
                   INVALID KEY MOVE 17 TO COND-WORD
               END-READ
               IF FILE-STATUS-1 = "2"
                   MOVE 17 TO COND-WORD
               ELSE
               IF FILE-STATUS NOT = "00"
                   MOVE 99 TO COND-WORD
               ELSE
                   NEXT SENTENCE
           ELSE
               MOVE 0 TO COND-WORD
               MOVE KWM-OR-MFR-ARG TO KEYWORDADJ OF MKEYADJ-REC
               READ MKEYADJ INTO BUF-MKEYADJ
                   INVALID KEY MOVE 17 TO COND-WORD
               END-READ
               IF FILE-STATUS-1 = "2"
                   MOVE 17 TO COND-WORD
               ELSE
               IF FILE-STATUS NOT = "00"
                   MOVE 99 TO COND-WORD.

       9010-DBFIND.
            IF DSET-NAME = "DCODE;"
               MOVE 0 TO COND-WORD
               MOVE KWM-OR-MFR-ARG TO KEYWORDADJ OF DCODE-KEY-REC
               START DCODE-KEY KEY = KEYWORDADJ OF DCODE-KEY-REC
                   INVALID KEY MOVE 17 TO COND-WORD
               END-START
               IF FILE-STATUS-1 = "2"
                   MOVE 17 TO COND-WORD
               ELSE
               IF FILE-STATUS NOT = "00"
                   MOVE 99 TO COND-WORD
               ELSE
                   NEXT SENTENCE
            ELSE
            IF KWM-OR-MFR-SEARCH = "MAN-PARTNO;"
               MOVE 0 TO COND-WORD
               MOVE KWM-OR-MFR-ARG TO MANPARTNO OF DMANPART-PART-REC
               START DMANPART-PART
                   KEY NOT < MANPARTNO OF DMANPART-PART-REC
                   INVALID KEY MOVE 17 TO COND-WORD
               END-START
               MOVE SPACES TO MAN-NAME
               PERFORM UNTIL COND-WORD NOT = 0
                               OR MAN-NAME = DE-MANUFACTURER
                   READ DMANPART-PART NEXT INTO BUF-DMANPART
                       AT END MOVE 17 TO COND-WORD
                   END-READ
               END-PERFORM
               IF COND-WORD NOT = 17
                   PERFORM 9122-PARTIAL-CHECK THRU 9122-PC-X
                   IF PARTIAL-FOUND = "N"
                       MOVE 17 TO COND-WORD
                   ELSE
                       START DMANPART-PART
                         KEY NOT < MANPARTNO OF DMANPART-PART-REC
                       END-START
                   END-IF
               END-IF
           ELSE
               MOVE 0 TO COND-WORD
               MOVE KWM-OR-MFR-ARG TO MANUFACT OF DMANPART-MAN-REC
               START DMANPART-MAN KEY = MANUFACT OF DMANPART-MAN-REC
                   INVALID KEY MOVE 17 TO COND-WORD
               END-START
               IF FILE-STATUS-1 = "2"
                   MOVE 17 TO COND-WORD
               ELSE
               IF FILE-STATUS NOT = "00"
                   MOVE 99 TO COND-WORD.

       9011-DBFIND-MANPART.
       9011-DM-X.
           EXIT.

       9020-DBGET.
           IF DSET-NAME = "DCODE;"
               PERFORM 9100-DBGET5-DCODE-KEY
           ELSE
           IF KWM-OR-MFR-SEARCH = "MAN-PARTNO;"
               PERFORM 9120-DBGET5-DMANPART-PART
           ELSE
               PERFORM 9140-DBGET5-DMANPART-MAN.

       9100-DBGET5-DCODE-KEY.
           MOVE 0 TO COND-WORD.
           READ DCODE-KEY NEXT INTO BUF-DCODE
               AT END MOVE 15 TO COND-WORD.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   MOVE 15 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.
           IF KEYWORDADJ OF DCODE-KEY-REC NOT = KWM-OR-MFR-ARG
               MOVE 15 TO COND-WORD.
           IF COND-WORD = 0
               MOVE CORPCDE OF DCODE-KEY-REC TO CODE-WORK.

       9120-DBGET5-DMANPART-PART.
           MOVE 0 TO COND-WORD.
           READ DMANPART-PART NEXT INTO BUF-DMANPART
               AT END MOVE 15 TO COND-WORD.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   MOVE 15 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.
           PERFORM 9122-PARTIAL-CHECK THRU 9122-PC-X.
           IF PARTIAL-FOUND = "N"
      *    IF MANPARTNO OF DMANPART-PART-REC NOT = KWM-OR-MFR-ARG
               MOVE 15 TO COND-WORD.
           IF COND-WORD = 0
               MOVE CORPCDE OF DMANPART-PART-REC TO CODE-WORK.

       9121-DETIRMINE-PARTIAL.
           MOVE DE-MAN-PARTNO TO CHECK-PARTNO.
           PERFORM VARYING PSUB FROM 1 BY 1
               UNTIL PSUB > 20
                 IF CHECK-PARTNO-CHAR (PSUB) NOT = SPACES
                     MOVE PSUB TO LAST-CHECK
                 END-IF
           END-PERFORM.
       9121-DP-X.
           EXIT.

       9122-PARTIAL-CHECK.
           MOVE "Y" TO PARTIAL-FOUND.
           MOVE MANPARTNO OF DMANPART-PART-REC TO PARTIAL-CHECK.
           PERFORM VARYING PSUB FROM LAST-CHECK BY -1
             UNTIL PSUB = 0
              IF PARTIAL-CHECK-CHAR(PSUB) NOT = CHECK-PARTNO-CHAR(PSUB)
                  MOVE "N" TO PARTIAL-FOUND
              END-IF
           END-PERFORM.
       9122-PC-X.
           EXIT.

       9140-DBGET5-DMANPART-MAN.
           MOVE 0 TO COND-WORD.
           READ DMANPART-MAN NEXT INTO BUF-DMANPART
               AT END MOVE 15 TO COND-WORD.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   MOVE 15 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.
           IF MANUFACT OF DMANPART-MAN-REC NOT = KWM-OR-MFR-ARG
               MOVE 15 TO COND-WORD.
           IF COND-WORD = 0
               MOVE CORPCDE OF DMANPART-MAN-REC TO CODE-WORK.

077900 9200-KSAM-SEARCH.
           IF SEARCH-KSAM = "N"
078000         MOVE SPACES TO MANUFACT-KEYWORD-INQUIRY
078100         IF MFR-KWM-FLAG = "M"
078200           MOVE "M" TO MKW-TYPE
078300         ELSE
078400           MOVE "K" TO MKW-TYPE
               END-IF
078500         MOVE KWM-OR-MFR-ARG TO MKW-PASS-AREA
               MOVE "Y" TO SEARCH-KSAM
           END-IF.
078600     CALL "SMKWINQ" USING VIEW-COMAREA MANUFACT-KEYWORD-INQUIRY
078700                          BASE LANGUAGE-PARMS VENDOR-TABLE.
078800     PERFORM 4120-GET-FORM-1
078900     IF MFR-KWM-FLAG = "M"
079000         MOVE MKW-RETURN-AREA      TO   DE-MANUFACTURER
                                              V-MFR
079100     ELSE
079200         MOVE MKW-RETURN-AREA      TO   DE-FIELD1,
                                              V-MFR.
080200     IF MKW-MESSAGE-AREA NOT = SPACES
080300        MOVE MKW-MESSAGE-AREA TO MESSAGE-BUFFER
080400        MOVE  1  TO FIELD-NUMBER
080500        PERFORM 4100-SETERROR THRU 4110-S-X
080600        GO TO 6100-SHOW-FORM
080700     ELSE
080800*-----  NONE WERE SELECTED
080900        IF MKW-RETURN-STATUS = "N"
081000           GO TO 6000-MAIN
081100        ELSE
081200           IF MFR-KWM-FLAG = "M"
081300              MOVE MKW-RETURN-MANUFCT TO DE-MANUFACTURER
081400              GO TO 6120-EDIT-MFR
081500           ELSE
081600              MOVE MKW-RETURN-KEYWORD  TO DE-KEYWORD
081700              MOVE MKW-RETURN-MODIFIER TO DE-MODIFIER
081800              GO TO 6120-EDIT-MFR.

       COPY DISPCALL IN COPYLIB.
       COPY DISPCAL2  IN COPYLIB.
119300 999-CATREAD.
           IF CATREAD-MSG-NUMBER = ZEROS
               MOVE LANG-SETNUM TO CATREAD-MSG-SET
               MOVE LANG-MSGNUM TO CATREAD-MSG-NUM.
           CALL "CCATREAD" USING CATREAD-PARMS.
           MOVE CATREAD-MSG-TEXT TO MESSAGE-BUFFER.
121000 999-CATREAD-EXIT.
121100     EXIT.
