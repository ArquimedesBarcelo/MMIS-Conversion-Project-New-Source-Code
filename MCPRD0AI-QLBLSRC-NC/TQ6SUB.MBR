       COPY CATREAD  OF COPYLIB.
040400
040500 PROCEDURE DIVISION USING DBPARAMETERS VIEW-COMAREA
040600                      CATREAD-PARMS.
       START-PGM.
           PERFORM 1-HSK.
           PERFORM 6-MAIN.
061800 2-EOJ.
           CLOSE DISPLAY-FILE.
           CLOSE WO-BASIC-FILE.
           CLOSE WO-LAST-NUM-USED.
063200     GOBACK.
       1-HSK.
           OPEN I-O DISPLAY-FILE.
           OPEN INPUT WO-BASIC-FILE.
           OPEN INPUT WO-LAST-NUM-USED.
040900     CALL "TPWORD" USING PASSWORD-INFORMATION.
041300     IF PASSWORD-FLAG = "N" GO TO 2-EOJ.
041400     ACCEPT CURDATE-BUFF FROM DATE.
041500     ACCEPT CURRENT-TIME-BUFF FROM TIME.
041600     MOVE SPACES TO SCREEN-BUFF.
           MOVE 0 TO COND-WORD.
041800     MOVE 1 TO ARG-NO.
041900     READ WO-LAST-NUM-USED INTO LAST-WO-BUFF
042000         INVALID KEY    MOVE 17 TO COND-WORD.
           IF WLNU-STATUS NOT = "00" MOVE 17 TO COND-WORD.
           IF COND-WORD = 17 MOVE 1 TO DATE-FLAG-SW.
042100     MOVE DATE-FLAG-SW TO DATE-FLAG.
042200     MOVE 1 TO DATE-MODE.
042300     MOVE DATE-FLAG TO DATE-CODE.
042400     CALL "TDATECHK" USING DATE-CHECK-AREA.
042500     MOVE DATE-DB TO CURDATE-BUFF.
042700**************************************************************
042800*                                                            *
042900*    TEST TO FIND THE LAST JULIAN DAY OF THE PRECEEDING      *
043000*    YEAR. THE RESULT OF JUL-DAY-LYR WILL NOT NESCESSARY     *
043100*    BE 365.                                                 *
043200*                                                            *
043300**************************************************************
043400     MOVE 12             TO GREG-MM.
043500     MOVE 31             TO GREG-DD.
043600     MOVE CUR-YY-BUFF    TO GREG-YY.
           MOVE SPACES         TO JULIAN-DATE.
           IF GREG-YY > "70"
               MOVE "19"       TO GREG-CC
           ELSE
           MOVE "20"           TO GREG-CC.
043900     CALL "JULGREG" USING GREG-DATE, JULIAN-DATE,
                            DAY-DIGIT, LEAP-YEAR-FLAG.
044000     MOVE JULIAN-DATE-9  TO JUL-DAY-LYR.
044100**************************************************************
044200*                                                            *
044300*    THE FOLLOWING 18 LINES IS A TEST TO DETERMINE LAST      *
044400*    24 HR. CHECK EITHER DURING THE YEAR OR AT 1ST OF        *
044500*    JANUARY.                                                *
044600*                                                            *
044700**************************************************************
044800*    IF DATE-FLAG = 3
044900*        MOVE CUR-MD-BUFF TO GREG-DD
045000*        MOVE CUR-DM-BUFF TO GREG-MM
045100*        MOVE CUR-YY-BUFF TO GREG-YY
045200*    ELSE
045300     MOVE CUR-MD-BUFF     TO GREG-MM.
045400     MOVE CUR-DM-BUFF     TO GREG-DD.
045500     MOVE CUR-YY-BUFF     TO GREG-YY.
           MOVE SPACES          TO JULIAN-DATE.
           IF GREG-YY > "70"
               MOVE "19"        TO GREG-CC
           ELSE
           MOVE "20"            TO GREG-CC.
045700     CALL "JULGREG" USING GREG-DATE, JULIAN-DATE,
                            DAY-DIGIT, LEAP-YEAR-FLAG.
045800     IF JULIAN-DATE-9 > 1
045900          SUBTRACT 1   FROM JULIAN-DATE-9
046000     ELSE
046200     MOVE JUL-DAY-LYR TO JULIAN-DATE-9.
046300**************************************************************
046400*                                                            *
046500*    THE FOLLOWING 2 LINES WILL CAUSE ALL WORK-ORDERS        *
046600*    INITIATED OR STARTED DURING THE WEEKEND AND THOSE       *
046700*    FROM FRIDAY'S ( DEPENDING ON THE 24 HR. CHECK )         *
046800*    TO BE OMITTED FROM MONDAY'S REPORT THUS GIVING THEM     *
046900*    ENOUGH TIME TO BE PROCESSED.                            *
047000*                                                            *
047100**************************************************************
           MOVE SPACES          TO GREG-DATE.
047400     CALL "JULGREG" USING GREG-DATE, JULIAN-DATE,
                            DAY-DIGIT, LEAP-YEAR-FLAG.
           MOVE GREG-CC         TO CC-L24HR-9.
047600     MOVE GREG-YY         TO YY-L24HR-9.
047700     MOVE GREG-MM         TO MM-L24HR-9.
047800     MOVE GREG-DD         TO DD-L24HR-9.
047900     MOVE CUR-TIME        TO TIME-L24HR-9.
           ACCEPT MC-LOCAL-DATA-AREA FROM LOCAL-DATA-AREA.
           MOVE "ALL " TO ZONE-KEY.
050800*    PERFORM 10-MATCH-PRTR-TO-ZONE THRU 10-MPTZ-EXIT.
051700
051800 10-MATCH-PRTR-TO-ZONE.
           MOVE 0 TO COND-WORD.
      *    READ OF ZONPRT FILE GOES HERE
052100     IF COND-WORD = 17
052200         PERFORM 100-SELECT-INFO THRU 100-SI-EXIT
052300         GO TO 10-MPTZ-EXIT.
052400     IF PRT-COMP = ZONPRT-PRTR
052500         IF USERNAME-1-3 = "MAN" OR "MGR" OR "PLA" OR "ENG"
052600             PERFORM 100-SELECT-INFO THRU 100-SI-EXIT
052700             GO TO 10-MPTZ-EXIT
052800         ELSE
052900         MOVE ZONPRT-ZONE TO ZONE-KEY
053000         GO TO 10-MPTZ-EXIT.
053100     GO TO 10-MATCH-PRTR-TO-ZONE.
053200 10-MPTZ-EXIT.    EXIT.
053300
053400 100-SELECT-INFO.
           MOVE SPACES TO SCREEN-BUFF.
053500     MOVE "FQ6INQ" TO VIEW-CFNAME.
           MOVE SCREEN-BUFF TO DSPLY-REC.
           PERFORM 99-SCREEN-WRITE.
           PERFORM 98-SCREEN-READ.
           MOVE SPACES TO ERROR-BUFFER.
           MOVE DSPLY-REC TO SCREEN-BUFF.
056500     IF VIEW-LASTKEY = 3 GO TO 2-EOJ.
057200     IF ZONE-BUFF-S NOT = SPACES
057300         MOVE ZONE-BUFF-S TO ZONE-KEY
057400     ELSE
057500     MOVE "ALL " TO ZONE-KEY.
057600 100-SI-EXIT.    EXIT.
057700
057800 6-MAIN.
057900     SORT SORT-FILE ASCENDING  KEY SRT-ZONE
058000                    DESCENDING KEY SRT-WO-STATUS
058100                    ASCENDING  KEY SRT-PRIORITY
058200             INPUT  PROCEDURE  7-INPUT-RECORDS
058300             OUTPUT PROCEDURE  8-WRITE-SORT-RECORDS.
           MOVE 0 TO COND-WORD.
           MOVE 0 TO ACT-KEY ACT-KEY-2 IL-KEY SM-KEY.
           CLOSE OUT-FILE.
           OPEN INPUT OUT-FILE.
           OPEN OUTPUT IL-FILE.
           OPEN OUTPUT SM-FILE.
061000     MOVE 1 TO SUB.
061100     PERFORM 3-PROCESS-OUTPUT-RECORDS THRU 3-POR-X
061200             UNTIL ALL-OUTPUT-REC-ARE-PROCESSED.
061300     PERFORM 4-PROCESS-IL-RECORDS THRU 4-PIL-EXIT.
061400     PERFORM 5-PROCESS-SM-RECORDS THRU 5-PSM-EXIT.
           CLOSE IL-FILE SM-FILE OUT-FILE.
061700
063400 3-PROCESS-OUTPUT-RECORDS.
063500     IF OUT-CRAFT-IL NOT = "Y" GO TO 3-POR-NOT-IL.
063900     MOVE SPACES TO ILF.
064000     ADD 1 TO IL-KEY.
063600     MOVE OUT-DATA TO IL-DATA.
063700     WRITE ILF    INVALID KEY GO TO 3-POR-CONT.
064100     GO TO 3-POR-CONT.
064200 3-POR-NOT-IL.
064300     IF OUT-CRAFT-IL NOT = "Z" GO TO 3-POR-NOT-SM.
064700     MOVE SPACES TO SMF.
064800     ADD 1 TO SM-KEY.
064400     MOVE OUT-DATA TO SM-DATA.
064500     WRITE SMF    INVALID KEY  GO TO 3-POR-CONT.
064900     GO TO 3-POR-CONT.
065000 3-POR-NOT-SM.
065100     IF PLANT-IDENT = "126" OR "153" OR "211" OR "111"
065200         IF ZONE-BUFF-S = SPACES
065300             NEXT SENTENCE
065400         ELSE
065500         MOVE ZONE-BUFF-S TO PREV-MAINT-ZONE
065600     ELSE
065700     IF ZONPRT-ZONE = "IL" GO TO 3-POR-CONT.
065800**** THE ABOVE CHECK IS INCORPORATED TO ALLOW ONLY 'IL" ****
065900**** CRAFT DATA TO BE PROCESSED FOR THE INSTRUMENT LAB AREA*
066000**** IN UNION CITY                                   *******
066100     IF       OUT-ZONE     NOT = PREV-MAINT-ZONE
066200         IF PREV-MAINT-ZONE = LOW-VALUES
066300             MOVE OUT-ZONE        TO PREV-MAINT-ZONE DTL-ZONE
066400             MOVE OUT-WO-STATUS   TO PREV-WO-STATUS
066500         ELSE
