       IDENTIFICATION DIVISION.
       PROGRAM-ID.             TOPENCFT.
       AUTHOR.                 W. ROXBURY.
       INSTALLATION.           GOODYEAR TIRE & RUBBER CO.
       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.
       SOURCE-COMPUTER.        IBM-AS400.
       OBJECT-COMPUTER.        IBM-AS400.
       SPECIAL-NAMES.          REQUESTOR    IS CCW-REQUESTOR
                               C01          IS NEW-PAGE
                               CONSOLE      IS CCW-CONSOLE
                               LOCAL-DATA   IS LOCAL-DATA-AREA
                               I-O-FEEDBACK IS I-O-FEEDBACK-AREA.
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT WO-CRAFTS-REQD
                  ASSIGN TO DATABASE-MCFLMM0601
                  ORGANIZATION IS INDEXED
                  ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                  FILE STATUS IS FILE-STAT.

           SELECT WO-OPEN-QUEUE
                  ASSIGN TO DATABASE-MCFLMM1905
                  ORGANIZATION IS INDEXED
                  ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                  WITH DUPLICATES
                  FILE STATUS IS FILE-STAT.

           SELECT OUT-FILE
                  ASSIGN TO DISK-FOPENCFT
                  ORGANIZATION IS RELATIVE
                  ACCESS MODE IS DYNAMIC
                  RELATIVE KEY IS ACT-KEY
                  FILE STATUS IS FILE-STAT.

           SELECT DISPLAY-FILE
                  ASSIGN TO WORKSTATION-ZCFTHELP-SI
                  ORGANIZATION IS TRANSACTION
                  ACCESS IS SEQUENTIAL
                  FILE STATUS IS SCREEN-STATUS
                  MAJOR-MINOR
                  CONTROL-AREA IS SCREEN-CONTROL.

           SELECT SORT-FILE
                  ASSIGN TO DISK-SORTFILE.

           SELECT PRINT-FILE
                  ASSIGN TO PRINTER-MCPRT.

       DATA DIVISION.
       FILE SECTION.
       FD  WO-CRAFTS-REQD
           LABEL RECORDS ARE STANDARD.
       01  CFTS-REC.
           COPY DDS-ALL-FORMATS OF MCFLMM0601.

       FD  WO-OPEN-QUEUE
           LABEL RECORDS ARE STANDARD.
       01  WOQ-REC.
           COPY DDS-ALL-FORMATS OF MCFLMM1905.

       FD  DISPLAY-FILE
           LABEL RECORDS ARE OMITTED.
       01  DISPLAY-REC         PIC X(2000).

       FD  PRINT-FILE RECORD CONTAINS 80 CHARACTERS
           LABEL RECORDS ARE OMITTED
           DATA RECORD IS PRINT-REC.
       01  PRINT-REC           PIC X(80).

       FD  OUT-FILE RECORD CONTAINS 59 CHARACTERS
           LABEL RECORDS ARE OMITTED
           DATA RECORD IS OUT-REC.
       01  OUT-REC.
           05  OUT-WO-QUEUE    PIC 99.
           05  OUT-CC-NUM      PIC XXXX.
           05  OUT-EQUIP       PIC X(06).
           05  OUT-DOWN        PIC X.
           05  OUT-WO-NUM      PIC X(10).
           05  OUT-DESC        PIC X(30).
           05  OUT-SKILL-1     PIC XX.
           05  OUT-SKILL-2     PIC XX.
           05  OUT-SKILL-3     PIC XX.

       SD  SORT-FILE RECORD CONTAINS 59 CHARACTERS
           DATA RECORD IS SORT-REC.
       01  SORT-REC.
           05  SORT-WO-QUEUE   PIC 99.
           05  SORT-CC-NUM     PIC XXXX.
           05  SORT-EQUIP.
               10  SORT-EQ1    PIC X.
               10  SORT-EQ2    PIC X.
               10  SORT-EQ3    PIC X.
               10  SORT-EQ4    PIC X.
               10  SORT-EQ5    PIC X.
               10  SORT-EQ6    PIC X.
           05  SORT-DOWN       PIC X.
           05  SORT-WO-NUM     PIC X(10).
           05  SORT-DESC       PIC X(30).
           05  SORT-SKILL-1    PIC XX.
           05  SORT-SKILL-2    PIC XX.
           05  SORT-SKILL-3    PIC XX.

       WORKING-STORAGE SECTION.
       77  ACT-KEY             PIC 9999   VALUE 0.
       77  MAX-KEY             PIC 9999   VALUE 0.
       77  SAVE-KEY            PIC 9999   VALUE 0.
       77  LINE-C              PIC 9999   VALUE 60.
       77  EOF-SW              PIC 9      VALUE 0.
       77  QUEUE-SW            PIC X.
       77  QUEUE-ERROR         PIC X(76).

       01  FILE-STAT.
           05 FILE-STAT-1      PIC X   VALUE "0".
           05 FILE-STAT-2      PIC X   VALUE "0".

       01  CURR-DATE.
           05  CD-YY           PIC XX.
           05  CD-MM           PIC XX.
           05  CD-DD           PIC XX.

       01  TIME-BUFFER.
           05  CUR-TIME.
               10  CUR-HRS     PIC XX.
               10  CUR-MINS    PIC XX.
           05  CUR-SECS        PIC XX.
           05  FILLER          PIC XX.

       01  SCREEN-DATA.
           05  CRAFT-BUF       PIC XX.
           05  SCREEN-MSGS.
               10  CMDMSG      PIC X(79).
               10  ERRMSG      PIC X(79).

       01  HEADING-DT-TM.
           05  FILLER          PIC X(18) VALUE SPACES.
           05  FILLER          PIC X(13) VALUE "PRINT DATE:  ".
           05  P-DATE.
               10  DT-MM       PIC XX.
               10  SLASH1      PIC X    VALUE "/".
               10  DT-DD       PIC XX.
               10  SLASH2      PIC X    VALUE "/".
               10  DT-YY       PIC XX.
           05  FILLER          PIC X(15) VALUE "        TIME:  ".
           05  P-HRS           PIC XX.
           05  FILLER          PIC X     VALUE ":".
           05  P-MIN           PIC XX.
           05  FILLER          PIC X     VALUE ":".
           05  P-SEC           PIC XX.
           05  FILLER          PIC X(18) VALUE SPACES.

       01  HEADING-DOTS.
           05  FILLER          PIC X(80) VALUE ALL "*".

       01  HEADING-1.
           05  FILLER          PIC X(18) VALUE "        O P E N   ".
           05  FILLER          PIC X(20) VALUE "W O R K O R D E R   ".
           05  FILLER          PIC X(20) VALUE "Q U E U E   F O R   ".
           05  FILLER          PIC X(12) VALUE "C R A F T   ".
           05  CFT-HD          PIC X(02).
           05  FILLER          PIC X(08) VALUE SPACES.

       01  HEADING-2.
           05  FILLER          PIC X(05) VALUE "QUEUE".
           05  FILLER          PIC X(75) VALUE SPACES.

       01  HEADING-3.
           05  FILLER          PIC X(15) VALUE "FACTOR  CC #   ".
           05  FILLER          PIC X(16) VALUE "EQUIP  DOWN  WO ".
           05  FILLER          PIC X(19) VALUE "NUMBER  DESCRIPTION".
           05  FILLER          PIC X(22) VALUE SPACES.
           05  FILLER          PIC X(08) VALUE "SKILLS  ".

       01  DETAIL-REC.
           05  FILLER          PIC X(02).
           05  Q-FACT          PIC X(02).
           05  FILLER          PIC X(04).
           05  CFT-NO          PIC X(04).
           05  FILLER          PIC X(03).
           05  EQP-NO          PIC X(06).
           05  FILLER          PIC X(03).
           05  E-DOWN          PIC X.
           05  FILLER          PIC X(03).
           05  WO-NUM          PIC X(10).
           05  FILLER          PIC X.
           05  DESCP           PIC X(30).
           05  FILLER          PIC X(02).
           05  CFT-01          PIC X(02).
           05  FILLER          PIC X.
           05  CFT-02          PIC X(02).
           05  FILLER          PIC X.
           05  CFT-03          PIC X(02).
           05  FILLER          PIC X.

       01  NO-REC-MSG.
           05  FILLER          PIC X(05) VALUE SPACES.
           05  FILLER          PIC X(10) VALUE "  ******  ".
           05  FILLER          PIC X(20) VALUE "THERE ARE NO RECORDS".
           05  FILLER          PIC X(20) VALUE " IN THE BACKLOG FOR ".
           05  FILLER          PIC X(20) VALUE "THIS CRAFT  ******  ".
           05  FILLER          PIC X(05) VALUE SPACES.

       01  DB-ERROR.
           05  DB-FUNC         PIC X(10) VALUE SPACES.
           05  DB-FILE         PIC X(18) VALUE SPACES.
           05  FILLER          PIC X(21) VALUE " ERROR - FILE-STAT = ".
           05  CON-WORD        PIC XX.

           COPY CATREAD        IN COPYLIB.

           COPY SCREENIO       IN COPYLIB.

       01  DBPARAMETERS.
           COPY DBPARMS        IN COPYLIB.

       01  WO-QUEUE-DATA.
           COPY DWOOPENQ       IN COPYLIB.

       01  CRAFT-DATA.
           COPY MWOCRAFT       IN COPYLIB.

       01  MESSAGE-DATA.
           COPY ERRORLIN       IN COPYLIB.

       PROCEDURE DIVISION.
       BEGIN-SORT SECTION 01.
       OPEN-FILES.
           CALL "CLOPENCFT".
           OPEN INPUT          WO-CRAFTS-REQD.
           OPEN INPUT          WO-OPEN-QUEUE.
           OPEN I-O            DISPLAY-FILE.
           OPEN OUTPUT         PRINT-FILE.

       BEGIN-PROC.
           PERFORM HOUSEKEEPING THRU EXIT-HSK.
           GO TO MAIN.

       HOUSEKEEPING.
           MOVE SPACES         TO MESSAGE-BUFFER SCREEN-DATA.
           ACCEPT CURR-DATE    FROM DATE.
           MOVE CD-YY          TO DT-YY.
           MOVE CD-MM          TO DT-MM.
           MOVE CD-DD          TO DT-DD.
           ACCEPT TIME-BUFFER  FROM TIME.
           MOVE CUR-HRS        TO P-HRS.
           MOVE CUR-MINS       TO P-MIN.
           MOVE CUR-SECS       TO P-SEC.
           MOVE "VGETCRFT"     TO SCREEN-NAME.

       SHOWFORM.
           MOVE "00"           TO SCREEN-STATUS.
           MOVE SCREEN-DATA    TO DISPLAY-REC.

           WRITE DISPLAY-REC  FORMAT IS SCREEN-NAME
               INDIC ARE SCREEN-INDICATORS.
           IF SCREEN-STATUS NOT = "00"
               DISPLAY "SCREEN WRITE ERROR.  SCREEN-STATUS IS "
                        SCREEN-STATUS
               GO TO END-OF-JOB.

           READ  DISPLAY-FILE FORMAT IS SCREEN-NAME
               INDIC ARE SCREEN-INDICATORS
           IF SCREEN-STATUS NOT = "00"
               DISPLAY "SCREEN READ ERROR.  SCREEN-STATUS IS "
                        SCREEN-STATUS
               GO TO END-OF-JOB.

           MOVE DISPLAY-REC    TO SCREEN-DATA.
           MOVE ALL B"0"       TO SCREEN-INDICATORS.

           IF KEY-HIT = 3
               GO TO END-OF-JOB.

           IF KEY-HIT NOT = 0
               GO TO SHOWFORM.

           IF CRAFT-BUF = SPACES
      **********************************************************************
      **    MESSAGE 035/037:
      ** INVALID CRAFT
      **********************************************************************
               MOVE  35        TO CATREAD-MSG-SET
               MOVE  37        TO CATREAD-MSG-NUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER TO ERRMSG
               MOVE B"1"       TO IND(1) IND(99)
               GO TO SHOWFORM.

           MOVE CRAFT-BUF      TO CRAFTREQD OF WO-CRAFTS-REQD.
           READ WO-CRAFTS-REQD INTO CRAFT-DATA.
           IF FILE-STAT NOT = "00"
      **********************************************************************
      **    MESSAGE 035/037:
      ** INVALID CRAFT
      **********************************************************************
               MOVE  35        TO CATREAD-MSG-SET
               MOVE  37        TO CATREAD-MSG-NUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER TO ERRMSG
               MOVE B"1"       TO IND(1) IND(99)
               GO TO SHOWFORM.

           MOVE CRAFT-BUF      TO CFT-HD.

       EXIT-HSK.    EXIT.

       MAIN.
           MOVE 0              TO ACT-KEY.
           SORT SORT-FILE DESCENDING KEY SORT-WO-QUEUE
                            SORT-EQUIP SORT-WO-NUM
               INPUT PROCEDURE SORT-INPUT-RECORDS
               OUTPUT PROCEDURE SORT-WRITE-FILE.

           IF ACT-KEY = 0
               PERFORM WRITE-HEADINGS
               MOVE NO-REC-MSG TO PRINT-REC
               WRITE PRINT-REC AFTER ADVANCING 4
               GO TO END-OF-JOB.

           OPEN I-O            OUT-FILE.
           MOVE 0              TO ACT-KEY.

       GET-DATA.
           ADD 1               TO ACT-KEY.
           MOVE SPACES         TO OUT-REC.
           READ OUT-FILE INVALID KEY
               MOVE 1          TO EOF-SW
               GO TO END-OF-JOB.
           IF ACT-KEY > MAX-KEY
               MOVE 1          TO EOF-SW
               GO TO END-OF-JOB.

           MOVE SPACES         TO DETAIL-REC.
           MOVE OUT-WO-QUEUE   TO Q-FACT.
           MOVE OUT-CC-NUM     TO CFT-NO.
           MOVE OUT-EQUIP      TO EQP-NO.
           MOVE OUT-DOWN       TO E-DOWN.
           MOVE OUT-WO-NUM     TO WO-NUM.
           MOVE OUT-DESC       TO DESCP.
           MOVE OUT-SKILL-1    TO CFT-01.
           MOVE OUT-SKILL-2    TO CFT-02.
           MOVE OUT-SKILL-3    TO CFT-03.
           PERFORM WRITE-DATA.
           GO TO GET-DATA.

       WRITE-DATA.
           IF LINE-C > 56
               PERFORM WRITE-HEADINGS.
           MOVE DETAIL-REC     TO PRINT-REC.
           WRITE PRINT-REC.
           ADD 1               TO LINE-C.

       WRITE-HEADINGS.
           MOVE SPACES         TO PRINT-REC.
           WRITE PRINT-REC AFTER ADVANCING NEW-PAGE.
           MOVE HEADING-DT-TM  TO PRINT-REC.
           WRITE PRINT-REC.
           MOVE HEADING-DOTS   TO PRINT-REC.
           WRITE PRINT-REC.
           MOVE HEADING-1      TO PRINT-REC.
           WRITE PRINT-REC.
           MOVE HEADING-2      TO PRINT-REC.
           WRITE PRINT-REC.
           MOVE HEADING-3      TO PRINT-REC.
           WRITE PRINT-REC.
           MOVE HEADING-DOTS   TO PRINT-REC.
           WRITE PRINT-REC.
           MOVE SPACES         TO PRINT-REC.
           WRITE PRINT-REC.
           MOVE 8              TO LINE-C.

       END-OF-JOB.
           CLOSE               WO-CRAFTS-REQD.
           CLOSE               WO-OPEN-QUEUE.
           CLOSE               DISPLAY-FILE.
           CLOSE               OUT-FILE.
           CLOSE               PRINT-FILE.
           GOBACK.

       999-CATREAD.
           MOVE SPACES         TO MESSAGE-BUFFER.
           CALL "CCATREAD" USING CATREAD-PARMS.
           MOVE CATREAD-MSG-TEXT TO MESSAGE-BUFFER.

       999-CATREAD-EXIT.    EXIT.

       SORT-INPUT-RECORDS SECTION 02.
           PERFORM SORT-MAIN THRU SORT-M-EXIT.
           GO TO SORT-IP-EXIT.

       SORT-MAIN.
           MOVE CRAFT-MSTR     TO CRAFTREQD1 OF WO-OPEN-QUEUE.
           START WO-OPEN-QUEUE KEY = CRAFTREQD1 OF WO-OPEN-QUEUE.
           IF FILE-STAT NOT = "00"
               IF FILE-STAT-1 = "2"
                   GO TO SORT-M-EXIT
               ELSE
                   MOVE "START   " TO DB-FUNC
                   MOVE "WO-OPEN-QUEUE" TO DB-FILE
                   MOVE FILE-STAT  TO CON-WORD
                   MOVE DB-ERROR   TO ERRMSG
                   MOVE 1          TO FIELD-NUMBER
                   MOVE B"1"       TO IND(1) IND(99)
                   GO TO END-OF-JOB.

           PERFORM SORT-DBGET THRU SORT-DBGET-EXIT.

       SORT-M-EXIT.    EXIT.

       SORT-DBGET.
           MOVE SPACES         TO SORT-REC.
           READ WO-OPEN-QUEUE NEXT INTO WO-QUEUE-DATA.
           IF FILE-STAT NOT = "00"
               IF FILE-STAT = "10" OR "14" OR "46"
                   GO TO SORT-DBGET-EXIT
               ELSE
                   MOVE "READ    " TO DB-FUNC
                   MOVE "WO-OPEN-QUEUE" TO DB-FILE
                   MOVE FILE-STAT  TO CON-WORD
                   MOVE DB-ERROR   TO ERRMSG
                   MOVE 1          TO FIELD-NUMBER
                   MOVE B"1"       TO IND(1) IND(99)
                   GO TO END-OF-JOB.

           IF CRAFT-MSTR NOT = Q-SKILL-1
               GO TO SORT-DBGET-EXIT.

           IF Q-RESERVE = "XX"
               MOVE " * * *  R E S E R V E D  * * *"
                               TO Q-DESCRIPTION.

           MOVE QUEUE-FACTOR   TO SORT-WO-QUEUE.
           MOVE Q-EQUIP-NUM    TO SORT-EQUIP.
           MOVE Q-WO-NUM       TO SORT-WO-NUM.
           IF Q-CC-NUM NOT = "9999"
               MOVE Q-CC-NUM   TO SORT-CC-NUM.
           IF Q-EQP-DN = "Y"
               MOVE "D"        TO SORT-DOWN.
           MOVE Q-DESCRIPTION  TO SORT-DESC.
           MOVE Q-SKILL-1      TO SORT-SKILL-1.
           MOVE Q-SKILL-2      TO SORT-SKILL-2.
           MOVE Q-SKILL-3      TO SORT-SKILL-3.
           RELEASE SORT-REC.

           GO TO SORT-DBGET.

       SORT-DBGET-EXIT.    EXIT.

       SORT-IP-EXIT.    EXIT.

       SORT-WRITE-FILE SECTION 03.
           OPEN OUTPUT         OUT-FILE.
           PERFORM SORT-READ-LOOP THRU SORT-RL-EXIT.
           CLOSE               OUT-FILE.
           GO TO SORT-WF-EXIT.

       SORT-READ-LOOP.
           RETURN SORT-FILE AT END
               MOVE ACT-KEY    TO MAX-KEY
               GO TO SORT-RL-EXIT.
           ADD 1               TO ACT-KEY.
           MOVE SORT-REC       TO OUT-REC.
           WRITE OUT-REC INVALID KEY
               DISPLAY "WRITE OUT-FILE ERR"
               GO TO SORT-RL-EXIT.
           GO TO SORT-READ-LOOP.

       SORT-RL-EXIT.    EXIT.

       SORT-WF-EXIT.    EXIT.

      ************  END OF FILE  ********************************
