       IDENTIFICATION DIVISION.
       PROGRAM-ID.             TBBUPDT.
       AUTHOR.                 W. ROXBURY.
       INSTALLATION.           GOODYEAR TIRE & RUBBER CO.
       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.
       SOURCE-COMPUTER.        IBM-AS400.
       OBJECT-COMPUTER.        IBM-AS400.
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT BULLETIN-BOARD
                  ASSIGN TO DATABASE-MCFLMM2701
                  ORGANIZATION IS INDEXED
                  ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                  WITH DUPLICATES
                  FILE STATUS IS FILE-STAT.

           SELECT NEWS-TABLE
                  ASSIGN TO DATABASE-MCFLMM2801
                  ORGANIZATION IS INDEXED
                  ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                  WITH DUPLICATES
                  FILE STATUS IS FILE-STAT.

           SELECT DISPLAY-FILE
                  ASSIGN TO WORKSTATION-ZBBNEW-SI
                  ORGANIZATION IS TRANSACTION
                  ACCESS MODE IS DYNAMIC
                  RELATIVE KEY IS RECNO
                  FILE STATUS IS SCREEN-STATUS
                  MAJOR-MINOR
                  CONTROL-AREA IS SCREEN-CONTROL.

       DATA DIVISION.
       FILE SECTION.
       FD  BULLETIN-BOARD
           LABEL RECORDS ARE STANDARD.
       01  BB-REC.
           COPY DDS-ALL-FORMATS OF MCFLMM2701.

       FD  NEWS-TABLE
           LABEL RECORDS ARE STANDARD.
       01  DL-REC.
           COPY DDS-ALL-FORMATS OF MCFLMM2801.

       FD  DISPLAY-FILE
           LABEL RECORDS ARE OMITTED.
       01  DISPLAY-REC         PIC X(2000).

       WORKING-STORAGE SECTION.
       77  DLIST-HOLD                PIC X(06).
       77  FIND-SW                   PIC 9     VALUE 0.
       77  RECNO                     PIC 9999  VALUE 0.
       77  MODEX                     PIC S9(4) VALUE 3.
       77  REC-SW                    PIC 9     VALUE 0.
           88  FILE-EMPTY                      VALUE 1.
       77  TRUE-VAL                  PIC 1     VALUE B"1".
       77  NEG-VAL                   PIC 1     VALUE B"0".

       01  PASSWORD-INFORMATION.
           05  NAME-OF-PROGRAM     PIC X(08) VALUE "TBBUPDT ".
           05  PROGRAM-TYPE        PIC X(02) VALUE "UP".
           05  PROGRAM-RELEASE     PIC X(12) VALUE " E0100010001".
           05  PROGRAM-DESCRIPTION.
               10  PROG-DESC-A     PIC X(60) VALUE
         "MODIFICATION MODULE OF THE MMIS BULLETIN BOARD PROGRAM.     ".
               10  PROG-DESC-B     PIC X(60) VALUE
         "ALLOWS CHANGES TO BE MADE TO EXISTING MMIS NEWS RECORDS.    ".
               10  PROG-FUNCTION   PIC X(60) VALUE
         "RUNS FROM THE f2 KEY OF THE BULLETIN BOARD MENU.            ".
           05  PASSWORD-FLAG       PIC X.

       01  FILE-STAT.
           05 FILE-STAT-1      PIC X   VALUE "0".
           05 FILE-STAT-2      PIC X   VALUE "0".

       01  DLIST-DATA.
           05  DIST-CODE           PIC X(06).
           05  DIST-LOCA           PIC X(40).
           05  DIST-HELP           PIC X(70).

       01  SCREEN-DATA.
           05  LOCA-ID                         PIC X(40).
           05  MESSAGE-BUF.
               10  DIST-LIST                   PIC X(06).
               10  MESSAGE-1-BUF               PIC X(70).
               10  MESSAGE-2-BUF               PIC X(70).
               10  MESSAGE-3-BUF               PIC X(70).
               10  MESSAGE-4-BUF               PIC X(70).
               10  MESSAGE-5-BUF               PIC X(70).
               10  MESSAGE-6-BUF               PIC X(70).
               10  MESSAGE-7-BUF               PIC X(70).
               10  MESSAGE-8-BUF               PIC X(70).
               10  MESSAGE-9-BUF               PIC X(70).
               10  MESSAGE-0-BUF               PIC X(70).
           05  HELP-LINE                       PIC X(70).
           05  SCREEN-MSGS.
               10  CMDMSG                      PIC X(79).
               10  ERRMSG                      PIC X(79).

       01  DLIST-LINE.
           05  DIST-CC PIC X(04).
           05  DIST-ZN PIC X(04).
           05  DIST-CR PIC X(02).

       01  DB-ERROR.
           05  DB-FUNC   PIC X(10) VALUE SPACES.
           05  DB-FILE   PIC X(18) VALUE SPACES.
           05  FILLER    PIC X(20) VALUE "ERROR - FILE-STAT = ".
           05  CON-WORD  PIC XX.

           COPY SCREENIO       IN COPYLIB.

           COPY CATREAD        IN COPYLIB.

       01  NEWS-FILE-DATA.
           COPY DBBOARD        IN COPYLIB.

       01  DISTRIBUTION-TABLE.
           COPY DNEWSTBL       IN COPYLIB.

       01  MESSAGE-BUFFER-DATA.
           COPY ERRORLIN       IN COPYLIB.

       LINKAGE SECTION.
       01  DBPARAMETERS.
           COPY DBPARMS        IN COPYLIB.

       01  HELP-DATA.
           05  HELP-SW             PIC 9(04) BINARY.
           05  HELP-LOCA           PIC X(40).
           05  HELP-MSGLINE        PIC X(70).

       PROCEDURE DIVISION USING DBPARAMETERS
                                HELP-DATA.
       CHECK-PASSWORD.
           CALL "TPWORD" USING PASSWORD-INFORMATION.
           IF PASSWORD-FLAG NOT = "N"
               GO TO BEGIN-PROC.
           GOBACK.

       BEGIN-PROC.
           OPEN I-O            BULLETIN-BOARD.
           OPEN INPUT          NEWS-TABLE.
           OPEN I-O            DISPLAY-FILE.
           MOVE "VBBUPDT"      TO SCREEN-NAME.
           MOVE SPACES         TO SCREEN-DATA MESSAGE-BUFFER.
           MOVE SPACES         TO NEWS-FILE-DATA DLIST-HOLD.
           MOVE HELP-LOCA      TO LOCA-ID DIST-LOCA.
           MOVE HELP-MSGLINE   TO HELP-LINE DIST-HELP.
           MOVE 0              TO REC-SW FIND-SW RECNO.
           MOVE 3              TO MODEX.

           READ BULLETIN-BOARD LAST RECORD INTO NEWS-FILE-DATA
                AT END GO TO NO-RECORD-RESET.
           IF FILE-STAT NOT = "00"
               IF FILE-STAT-1 = "2" OR "4"
      **********************************************************************
      **    MESSAGE 040/035:
      **  NO NEWS ITEMS AT THIS TIME
      **********************************************************************
                   MOVE  40    TO CATREAD-MSG-SET
                   MOVE  35    TO CATREAD-MSG-NUM
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE FILE-STAT  TO MSG-FLD
                   MOVE MESSAGE-BUFFER TO ERRMSG
                   MOVE TRUE-VAL   TO IND(99)
                   GO TO SHOWFORM
               ELSE
                 MOVE "READ LST" TO DB-FUNC
                 MOVE "BULLETIN-BOARD" TO DB-FILE
                 MOVE FILE-STAT  TO CON-WORD
                 MOVE DB-ERROR   TO ERRMSG
                 MOVE TRUE-VAL   TO IND(99)
                 GO TO SHOWFORM.

           GO TO DBGET-CONTINUE.

       DBGET-LOOP.
           IF MODEX = 3
               GO TO REVERSE-READ
           ELSE
               GO TO FORWARD-READ.

       DBGET-CONTINUE.
           IF NEWS-KEY = "111111"
               GO TO DBGET-LOOP.

           MOVE 1              TO FIND-SW.
           MOVE NEWS-KEY       TO DLIST-HOLD.

           IF NEWS-KEY NOT = "000000"
               MOVE NEWS-KEY   TO DIST-LIST
           ELSE
               MOVE SPACES     TO DIST-LIST.

           MOVE NEWS-1         TO MESSAGE-1-BUF.
           MOVE NEWS-2         TO MESSAGE-2-BUF.
           MOVE NEWS-3         TO MESSAGE-3-BUF.
           MOVE NEWS-4         TO MESSAGE-4-BUF.
           MOVE NEWS-5         TO MESSAGE-5-BUF.
           MOVE NEWS-6         TO MESSAGE-6-BUF.
           MOVE NEWS-7         TO MESSAGE-7-BUF.
           MOVE NEWS-8         TO MESSAGE-8-BUF.
           MOVE NEWS-9         TO MESSAGE-9-BUF.
           MOVE NEWS-0         TO MESSAGE-0-BUF.

       SHOWFORM.
           MOVE "00"           TO SCREEN-STATUS.
           MOVE SCREEN-DATA    TO DISPLAY-REC.

           WRITE DISPLAY-REC  FORMAT IS SCREEN-NAME
               INDIC ARE SCREEN-INDICATORS.
           IF SCREEN-STATUS NOT = "00"
               DISPLAY "SCREEN WRITE ERROR.  SCREEN-STATUS IS "
                        SCREEN-STATUS
               GO TO END-OF-JOB.

           READ  DISPLAY-FILE FORMAT IS SCREEN-NAME
               INDIC ARE SCREEN-INDICATORS
           IF SCREEN-STATUS NOT = "00"
               DISPLAY "SCREEN READ ERROR.  SCREEN-STATUS IS "
                        SCREEN-STATUS
               GO TO END-OF-JOB.

           MOVE DISPLAY-REC    TO SCREEN-DATA.
           MOVE ALL B"0"       TO SCREEN-INDICATORS.

           IF KEY-HIT = 1 OR 3
               GO TO END-OF-JOB.

           IF KEY-HIT = 0 OR 8
               MOVE 3          TO MODEX
               GO TO DBGET-LOOP.

           IF KEY-HIT = 4
               MOVE 2          TO MODEX
               GO TO DBGET-LOOP.

           IF KEY-HIT = 5
               IF NEWS-KEY = "000000"
                   GO TO SHOWFORM
               ELSE
                   PERFORM SUBF-CLEAR
                   PERFORM GET-DLIST THRU GDL-EXIT
                   GO TO SHOWFORM.

           IF KEY-HIT = 7
               MOVE 20         TO HELP-SW
               CALL "TBBHELP" USING HELP-DATA
               MOVE "VBBUPDT"  TO SCREEN-NAME
               GO TO SHOWFORM.

           IF KEY-HIT NOT = 2
               GO TO SHOWFORM.

           IF MESSAGE-BUF = SPACES
               GO TO DELETE-RECORD.

       UPDATE-RECORD.
           IF DIST-LIST = SPACES
               MOVE "000000"   TO NEWS-KEY
           ELSE
               MOVE DIST-LIST  TO NEWS-KEY.

           MOVE MESSAGE-1-BUF  TO NEWS-1.
           MOVE MESSAGE-2-BUF  TO NEWS-2.
           MOVE MESSAGE-3-BUF  TO NEWS-3.
           MOVE MESSAGE-4-BUF  TO NEWS-4.
           MOVE MESSAGE-5-BUF  TO NEWS-5.
           MOVE MESSAGE-6-BUF  TO NEWS-6.
           MOVE MESSAGE-7-BUF  TO NEWS-7.
           MOVE MESSAGE-8-BUF  TO NEWS-8.
           MOVE MESSAGE-9-BUF  TO NEWS-9.
           MOVE MESSAGE-0-BUF  TO NEWS-0.

           REWRITE BB-REC      FROM NEWS-FILE-DATA.
           IF FILE-STAT NOT = "00"
               MOVE FILE-STAT  TO CON-WORD
               MOVE "REWRITE " TO DB-FUNC
               MOVE "BULLETIN-BOARD" TO DB-FILE
               MOVE DB-ERROR   TO ERRMSG
               MOVE TRUE-VAL   TO IND(6) IND(99)
               GO TO SHOWFORM.

           IF NEWS-KEY = "000000"
               GO TO DBGET-LOOP.

       CHECK-DISTRIBUTION.
           IF DIST-LIST = DLIST-HOLD
               GO TO DBGET-LOOP.

           MOVE DIST-LIST      TO NEWSKEY OF NEWS-TABLE.
           READ NEWS-TABLE     INTO DISTRIBUTION-TABLE.
           IF FILE-STAT = "00"
               GO TO DBGET-LOOP.

           MOVE DIST-LIST      TO DIST-CODE.
           CALL "TDLINIT" USING DBPARAMETERS
                                DLIST-DATA.

               IF KEY-HIT = 3
                   GO TO END-OF-JOB.

           MOVE "VBBUPDT"      TO SCREEN-NAME.
           MOVE SPACES         TO SCREEN-DATA MESSAGE-BUFFER.
           MOVE SPACES         TO NEWS-FILE-DATA.
           GO TO DBGET-LOOP.

       DELETE-RECORD.
           IF FILE-EMPTY
               GO TO NO-RECORD-RESET.

           DELETE BULLETIN-BOARD.
           IF FILE-STAT NOT = "00"
               MOVE FILE-STAT  TO CON-WORD
               MOVE "DELETE  " TO DB-FUNC
               MOVE "BULLETIN-BOARD" TO DB-FILE
               MOVE DB-ERROR   TO ERRMSG
               MOVE TRUE-VAL   TO IND(6) IND(99)
               GO TO SHOWFORM.

           GO TO DBGET-LOOP.

       GET-DLIST.
           MOVE DIST-LIST      TO NEWSKEY OF NEWS-TABLE.
           START NEWS-TABLE    KEY = NEWSKEY OF NEWS-TABLE.
           IF FILE-STAT NOT = "00"
      **********************************************************************
      **    MESSAGE 040/015:
      **  NO RECORDS FOUND
      **********************************************************************
               MOVE  40        TO CATREAD-MSG-SET
               MOVE  15        TO CATREAD-MSG-NUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER TO ERRMSG
               MOVE TRUE-VAL   TO IND(99)
               GO TO GDL-EXIT.

       DBGET-DLIST.
           READ NEWS-TABLE NEXT INTO DISTRIBUTION-TABLE.
           IF FILE-STAT NOT = "00"
               IF FILE-STAT = "10" OR "14" OR "46"
                   GO TO GDL-CONT
               ELSE
                   MOVE "READ    " TO DB-FUNC
                   MOVE "NEWS-TABLE" TO DB-FILE
                   MOVE FILE-STAT  TO CON-WORD
                   MOVE DB-ERROR   TO ERRMSG
                   MOVE TRUE-VAL   TO IND(99)
                   GO TO GDL-EXIT.

           IF DIST-KEY NOT = DIST-LIST
               GO TO GDL-CONT.

           IF DIST-CC-NUM = "9999"
               MOVE SPACES     TO DIST-CC
           ELSE
              MOVE DIST-CC-NUM TO DIST-CC.

           MOVE DIST-ZONE      TO DIST-ZN.
           MOVE DIST-CRFT      TO DIST-CR.
           MOVE DLIST-LINE     TO DISPLAY-REC.
           ADD  1              TO RECNO.
           WRITE SUBFILE DISPLAY-REC FORMAT "RDSF"
               INDIC ARE SCREEN-INDICATORS.
           GO TO DBGET-DLIST.

       GDL-CONT.
           WRITE DISPLAY-REC FORMAT "RDSB"
               INDIC ARE SCREEN-INDICATORS.
           MOVE B"1"           TO IND(76).
           IF RECNO > 0
               MOVE TRUE-VAL   TO IND(75)
           ELSE
               MOVE NEG-VAL    TO IND(75).
           MOVE DIST-LIST      TO DISPLAY-REC.
           WRITE DISPLAY-REC FORMAT "RDSC"
               INDIC ARE SCREEN-INDICATORS.
           READ DISPLAY-FILE FORMAT "RDSC"
               INDIC ARE SCREEN-INDICATORS.

       GDL-EXIT.    EXIT.

       SUBF-CLEAR.
           MOVE 0              TO RECNO.
           MOVE NEG-VAL        TO IND(75) IND(76).
           MOVE TRUE-VAL       TO IND(77).
           MOVE SPACES         TO DISPLAY-REC.
           WRITE DISPLAY-REC FORMAT "RDSC"
               INDIC ARE SCREEN-INDICATORS.
           MOVE NEG-VAL        TO IND(77).

       REVERSE-READ.
           READ BULLETIN-BOARD PRIOR RECORD INTO NEWS-FILE-DATA
            AT END GO TO RE-START-REVERSE.

           IF FILE-STAT NOT = "00"
             IF FILE-STAT-1 = "2" OR "4"
               IF FIND-SW = 0
      **********************************************************************
      **    MESSAGE 040/035:
      **  NO NEWS ITEMS AT THIS TIME
      **********************************************************************
                   MOVE  40    TO CATREAD-MSG-SET
                   MOVE  35    TO CATREAD-MSG-NUM
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE FILE-STAT  TO MSG-FLD
                   MOVE MESSAGE-BUFFER TO ERRMSG
                   MOVE TRUE-VAL   TO IND(99)
                   GO TO SHOWFORM
               ELSE
                   GO TO RE-START-REVERSE
             ELSE
                 MOVE "READ PRI" TO DB-FUNC
                 MOVE "BULLETIN-BOARD" TO DB-FILE
                 MOVE FILE-STAT  TO CON-WORD
                 MOVE DB-ERROR   TO ERRMSG
                 MOVE TRUE-VAL   TO IND(99)
                 GO TO SHOWFORM.

           GO TO DBGET-CONTINUE.

       FORWARD-READ.
           READ BULLETIN-BOARD NEXT RECORD INTO NEWS-FILE-DATA
            AT END GO TO RE-START-FORWARD.

           IF FILE-STAT NOT = "00"
             IF FILE-STAT-1 = "2" OR "4"
               IF FIND-SW = 0
      **********************************************************************
      **    MESSAGE 040/035:
      **  NO NEWS ITEMS AT THIS TIME
      **********************************************************************
                   MOVE  40    TO CATREAD-MSG-SET
                   MOVE  35    TO CATREAD-MSG-NUM
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE FILE-STAT  TO MSG-FLD
                   MOVE MESSAGE-BUFFER TO ERRMSG
                   MOVE TRUE-VAL   TO IND(99)
                   GO TO SHOWFORM
               ELSE
                   GO TO RE-START-FORWARD
             ELSE
                 MOVE "READ NXT" TO DB-FUNC
                 MOVE "BULLETIN-BOARD" TO DB-FILE
                 MOVE FILE-STAT  TO CON-WORD
                 MOVE DB-ERROR   TO ERRMSG
                 MOVE TRUE-VAL   TO IND(99)
                 GO TO SHOWFORM.

           GO TO DBGET-CONTINUE.

       RE-START-REVERSE.
           MOVE 0              TO FIND-SW.
           READ BULLETIN-BOARD LAST RECORD INTO NEWS-FILE-DATA
                AT END GO TO NO-RECORD-RESET.
           IF NEWS-KEY = "111111"
               READ BULLETIN-BOARD PRIOR RECORD INTO NEWS-FILE-DATA
                AT END GO TO NO-RECORD-RESET.
           GO TO DBGET-CONTINUE.

       RE-START-FORWARD.
           MOVE 0              TO FIND-SW.
           READ BULLETIN-BOARD FIRST RECORD INTO NEWS-FILE-DATA
                AT END GO TO NO-RECORD-RESET.
           IF NEWS-KEY = "111111"
               READ BULLETIN-BOARD NEXT RECORD INTO NEWS-FILE-DATA
                AT END GO TO NO-RECORD-RESET.
           GO TO DBGET-CONTINUE.

       NO-RECORD-RESET.
           MOVE 1              TO REC-SW.
           MOVE SPACES         TO SCREEN-DATA.
      **********************************************************************
      **    MESSAGE 040/035:
      **  NO NEWS ITEMS AT THIS TIME
      **********************************************************************
           MOVE  40            TO CATREAD-MSG-SET.
           MOVE  35            TO CATREAD-MSG-NUM.
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
           MOVE FILE-STAT      TO MSG-FLD.
           MOVE MESSAGE-BUFFER TO ERRMSG.
           MOVE TRUE-VAL       TO IND(99).
           GO TO SHOWFORM.

       END-OF-JOB.
           CLOSE               BULLETIN-BOARD.
           CLOSE               NEWS-TABLE.
           CLOSE               DISPLAY-FILE.
           GOBACK.

       999-CATREAD.
           MOVE SPACES         TO MESSAGE-BUFFER.
           CALL "CCATREAD" USING CATREAD-PARMS.
           MOVE CATREAD-MSG-TEXT TO MESSAGE-BUFFER.

       999-CATREAD-EXIT.    EXIT.

