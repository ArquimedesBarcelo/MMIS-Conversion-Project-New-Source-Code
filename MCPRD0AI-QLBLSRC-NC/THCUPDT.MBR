       IDENTIFICATION DIVISION.
       PROGRAM-ID.             THCUPDT.
       AUTHOR.                 W. ROXBURY.
       INSTALLATION.           GOODYEAR TIRE & RUBBER CO.
       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.
       SOURCE-COMPUTER.        IBM-AS400.
       OBJECT-COMPUTER.        IBM-AS400.
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT EQP-HOT-CODE
                  ASSIGN       TO DATABASE-MCFLMM2002
                  ORGANIZATION IS INDEXED
                  ACCESS MODE  IS DYNAMIC
                  RECORD KEY   IS EXTERNALLY-DESCRIBED-KEY
                               WITH DUPLICATES
                  FILE STATUS  IS FILE-STAT.

           SELECT EQP-EQUIPMENT
                  ASSIGN       TO DATABASE-MCFLMM0201
                  ORGANIZATION IS INDEXED
                  ACCESS MODE  IS DYNAMIC
                  RECORD KEY   IS EXTERNALLY-DESCRIBED-KEY
                  FILE STATUS  IS FILE-STAT.

           SELECT DISPLAY-FILE
                  ASSIGN       TO WORKSTATION-ZHOTCODE-SI
                  ORGANIZATION IS TRANSACTION
                  ACCESS MODE  IS SEQUENTIAL
                  FILE STATUS  IS SCREEN-STATUS
                               MAJOR-MINOR
                  CONTROL-AREA IS SCREEN-CONTROL.

       DATA DIVISION.
       FILE SECTION.
       FD  EQP-HOT-CODE
           LABEL RECORDS ARE STANDARD.
       01  HC-REC.
           COPY DDS-ALL-FORMATS OF MCFLMM2002.

       FD  EQP-EQUIPMENT
           LABEL RECORDS ARE STANDARD.
       01  EQP-REC.
           COPY DDS-ALL-FORMATS OF MCFLMM0201.

       FD  DISPLAY-FILE
           LABEL RECORDS ARE OMITTED.
       01  DISPLAY-REC         PIC X(2000).

       WORKING-STORAGE SECTION.
       77  DATA-SW                   PIC 9      VALUE 0.
       77  FIELD-NUMBER              PIC S9(4)  VALUE 1   COMP-4.
       77  TRUE-VAL  VALUE B"1"      PIC 1.

       01  PASSWORD-INFORMATION.
           05  NAME-OF-PROGRAM     PIC X(08) VALUE "THCUPDT ".
           05  PROGRAM-TYPE        PIC X(02) VALUE "UP".
           05  PROGRAM-RELEASE     PIC X(12) VALUE " E0100010001".
           05  PROGRAM-DESCRIPTION.
               10  PROG-DESC-A1    PIC X(30) VALUE
              "ALLOWS MODIFICATIONS TO BE MAD".
               10  PROG-DESC-A2    PIC X(30) VALUE
             "E TO EXISTING HOT-CODE ENTRIES".
               10  PROG-DESC-B1    PIC X(30) VALUE
             "IN THE EQUIPMENT HOT CODE FILE".
               10  PROG-DESC-B2    PIC X(30) VALUE
             " FOR MMIS WORKORDER QUEUE.    ".
               10  PROG-FUNC1      PIC X(30) VALUE
             "RUNS FROM THE f2 KEY OF THE HO".
               10  PROG-FUNCT2     PIC X(30) VALUE
             "T CODE MAINTENANCE MENU.      ".
           05  PASSWORD-FLAG       PIC X.

       01  FILE-STAT.
           05 FILE-STAT-1      PIC X   VALUE "0".
           05 FILE-STAT-2      PIC X   VALUE "0".

       01  SCREEN-DATA.
           05  EQP-NUM                PIC X(06).
           05  S-DATE.
               10  S-MM               PIC XX.
               10  S-DD               PIC XX.
               10  S-YY               PIC XX.
           05  S-TIME.
               10  S-HH               PIC XX.
               10  S-MN               PIC XX.
           05  E-DATE.
               10  E-MM               PIC XX.
               10  E-DD               PIC XX.
               10  E-YY               PIC XX.
           05  E-TIME.
               10  E-HH               PIC XX.
               10  E-MN               PIC XX.
           05  REM                    PIC X(30).
           05  MSG-LINE               PIC X(70).
           05  CMDMSG                 PIC X(79).
           05  ERRMSG                 PIC X(79).

       01  DATE-HOLD.
           05  DH-MM                        PIC 99.
           05  DH-DD                        PIC 99.
           05  DH-YY                        PIC 99.

       01  TIME-HOLD.
           05  TH-HH                        PIC 99.
           05  TH-MM                        PIC 99.

       01  DATE-NUM-1.
           05  DN-1-CC                       PIC 99.
           05  DN-1-YY                       PIC 99.
           05  DN-1-MM                       PIC 99.
           05  DN-1-DD                       PIC 99.

       01  DATE-NUM-2.
           05  DN-2-CC                       PIC 99.
           05  DN-2-YY                       PIC 99.
           05  DN-2-MM                       PIC 99.
           05  DN-2-DD                       PIC 99.

       01  TIME-NUM-1                        PIC 9999.
       01  TIME-NUM-2                        PIC 9999.

           COPY SCREENIO       IN COPYLIB.

           COPY CATREAD        IN COPYLIB.

       01  EQP-EQUIP-DATA.
           COPY MEQPFILE       IN COPYLIB.

       01  HOT-CODE-DATA.
           COPY DHOTCODE       IN COPYLIB.

       LINKAGE SECTION.
       01  DBPARAMETERS.
           COPY DBPARMS        IN COPYLIB.

       PROCEDURE DIVISION USING DBPARAMETERS.

       CHECK-PASSWORD.
           CALL "TPWORD" USING PASSWORD-INFORMATION.
           IF PASSWORD-FLAG = "Y"
               GO TO BEGIN-PROC.
           GOBACK.

       BEGIN-PROC.
           OPEN I-O            DISPLAY-FILE.
           OPEN I-O            EQP-HOT-CODE.
           OPEN INPUT          EQP-EQUIPMENT.
           MOVE ALL B"0"       TO SCREEN-INDICATORS.
           MOVE "VHCUPDATE"    TO SCREEN-NAME.

       6-MAIN.
           MOVE SPACES         TO SCREEN-DATA.
           MOVE 0              TO DATA-SW.
           MOVE TRUE-VAL       TO IND (90).

       61-SHOWFORM.
           MOVE "00"           TO SCREEN-STATUS.
           MOVE SCREEN-DATA    TO DISPLAY-REC.
           WRITE DISPLAY-REC  FORMAT IS SCREEN-NAME
               INDIC ARE SCREEN-INDICATORS.
           IF SCREEN-STATUS NOT = "00"
               DISPLAY "SCREEN WRITE ERROR.  SCREEN-STATUS IS "
                        SCREEN-STATUS
               GO TO END-OF-JOB.

           READ  DISPLAY-FILE FORMAT IS SCREEN-NAME
               INDIC ARE SCREEN-INDICATORS.
           IF SCREEN-STATUS NOT = "00"
               DISPLAY "SCREEN READ ERROR.  SCREEN-STATUS IS "
                        SCREEN-STATUS
               GO TO END-OF-JOB.

           MOVE ALL B"0"       TO SCREEN-INDICATORS.
           MOVE DISPLAY-REC    TO SCREEN-DATA.

           IF KEY-HIT = 1 OR 3
               GO TO END-OF-JOB.

           IF KEY-HIT = 12
               GO TO 6-MAIN.

           IF KEY-HIT = 0
               NEXT SENTENCE
           ELSE
               GO TO 6-MAIN.

           IF SCREEN-DATA = SPACES
               MOVE TRUE-VAL   TO IND (90)
               GO TO 61-SHOWFORM.

           IF DATA-SW = 1
               GO TO 62-EDIT-DATES.

           IF EQP-NUM = SPACES
               MOVE TRUE-VAL   TO IND (90)
               GO TO 61-SHOWFORM.

           MOVE EQP-NUM        TO EQPNUM OF EQP-EQUIPMENT
                                  EQPNUM OF EQP-HOT-CODE.
           READ EQP-EQUIPMENT INTO EQP-EQUIP-DATA.
           IF FILE-STAT NOT = "00"
               MOVE 35004      TO CATREAD-MSG-NUMBER
               CALL "CCATREAD" USING CATREAD-PARMS
               MOVE CATREAD-MSG-TEXT TO ERRMSG
               MOVE TRUE-VAL   TO IND (99) IND (1) IND (90)
               GO TO 61-SHOWFORM.

           READ EQP-HOT-CODE   INTO HOT-CODE-DATA.
           IF FILE-STAT NOT = "00"
               MOVE 31040      TO CATREAD-MSG-NUMBER
               CALL "CCATREAD" USING CATREAD-PARMS
               MOVE CATREAD-MSG-TEXT TO ERRMSG
               MOVE TRUE-VAL   TO IND (99) IND (1) IND (90)
               GO TO 61-SHOWFORM.

           MOVE HC-STRT-DATE-YY TO S-YY.
           MOVE HC-STRT-DATE-MM TO S-MM.
           MOVE HC-STRT-DATE-DD TO S-DD.
           IF DATE-FLAG = 3
               MOVE HC-STRT-DATE-MM TO S-DD
               MOVE HC-STRT-DATE-DD TO S-MM.

           MOVE HC-END-DATE-YY TO E-YY.
           MOVE HC-END-DATE-MM TO E-MM.
           MOVE HC-END-DATE-DD TO E-DD.
           IF DATE-FLAG = 3
               MOVE HC-END-DATE-MM TO E-DD
               MOVE HC-END-DATE-DD TO E-MM.

           MOVE HC-STRT-TIME   TO S-TIME.
           MOVE HC-END-TIME    TO E-TIME.
           MOVE HC-REMARKS     TO REM.

           MOVE 42058          TO CATREAD-MSG-NUMBER.
           CALL "CCATREAD"     USING CATREAD-PARMS.
           MOVE CATREAD-MSG-TEXT TO MSG-LINE.
           MOVE 1              TO DATA-SW.
           MOVE TRUE-VAL       TO IND (91).
           GO TO 61-SHOWFORM.

       62-EDIT-DATES.
           MOVE 0              TO FIELD-NUMBER.
           MOVE S-DATE         TO DATE-HOLD.
           PERFORM 62-TEST-VALID-DATE THRU 62-TVD-EXIT.
           IF FIELD-NUMBER > 0
               MOVE TRUE-VAL   TO IND (99) IND (FIELD-NUMBER) IND (91)
               GO TO 61-SHOWFORM.

           MOVE S-TIME         TO TIME-HOLD.
           PERFORM 62-TEST-VALID-TIME THRU 62-TVT-EXIT.
           IF FIELD-NUMBER > 0
               MOVE TRUE-VAL   TO IND (99) IND (FIELD-NUMBER) IND (91)
               GO TO 61-SHOWFORM.

           PERFORM 62-TEST-VALID-DATE THRU 62-TVD-EXIT.
           IF FIELD-NUMBER > 0
               ADD 5           TO FIELD-NUMBER
               MOVE TRUE-VAL   TO IND (99) IND (FIELD-NUMBER) IND (91)
               GO TO 61-SHOWFORM.

           MOVE E-TIME         TO TIME-HOLD.
           PERFORM 62-TEST-VALID-TIME THRU 62-TVT-EXIT.
           IF FIELD-NUMBER > 0
               ADD 5           TO FIELD-NUMBER
               MOVE TRUE-VAL   TO IND (99) IND (FIELD-NUMBER) IND (91)
               GO TO 61-SHOWFORM.

           MOVE S-DATE         TO DATE-HOLD.
           MOVE DH-YY          TO DN-1-YY.
           MOVE DH-MM          TO DN-1-MM.
           MOVE DH-DD          TO DN-1-DD.
           IF DATE-FLAG = 3
               MOVE DH-MM      TO DN-1-DD
               MOVE DH-DD      TO DN-1-MM.
           MOVE 20             TO DN-1-CC.
           IF DN-1-YY > 70
               MOVE 19         TO DN-1-CC.

           MOVE E-DATE         TO DATE-HOLD.
           MOVE DH-YY          TO DN-2-YY.
           MOVE DH-MM          TO DN-2-MM.
           MOVE DH-DD          TO DN-2-DD.
           IF DATE-FLAG = 3
               MOVE DH-MM      TO DN-2-DD
               MOVE DH-DD      TO DN-2-MM.
           MOVE 20             TO DN-2-CC.
           IF DN-2-YY > 70
               MOVE 19         TO DN-2-CC.

           MOVE S-TIME         TO TIME-NUM-1.
           MOVE E-TIME         TO TIME-NUM-2.

           IF DATE-NUM-1 > DATE-NUM-2
               MOVE 30033      TO CATREAD-MSG-NUMBER
               CALL "CCATREAD" USING CATREAD-PARMS
               MOVE CATREAD-MSG-TEXT TO ERRMSG
               MOVE 2          TO FIELD-NUMBER
               MOVE TRUE-VAL   TO IND (99) IND (FIELD-NUMBER) IND (91)
               GO TO 61-SHOWFORM.

           IF DATE-NUM-1 = DATE-NUM-2
               IF TIME-NUM-1 > TIME-NUM-2
                   MOVE 46019      TO CATREAD-MSG-NUMBER
                   CALL "CCATREAD" USING CATREAD-PARMS
                   MOVE CATREAD-MSG-TEXT TO ERRMSG
                   MOVE 5          TO FIELD-NUMBER
                   MOVE TRUE-VAL   TO IND(99) IND(FIELD-NUMBER) IND(91)
                   GO TO 61-SHOWFORM.

       62-UPDATE.
           MOVE S-YY           TO HC-STRT-DATE-YY.
           MOVE S-MM           TO HC-STRT-DATE-MM.
           MOVE S-DD           TO HC-STRT-DATE-DD.
           IF DATE-FLAG = 3
               MOVE S-MM       TO HC-STRT-DATE-DD
               MOVE S-DD       TO HC-STRT-DATE-MM.
           MOVE 20             TO HC-STRT-DATE-CC.
           IF HC-STRT-DATE-YY > "70"
               MOVE 19         TO HC-STRT-DATE-CC.

           MOVE E-YY           TO HC-END-DATE-YY.
           MOVE E-MM           TO HC-END-DATE-MM.
           MOVE E-DD           TO HC-END-DATE-DD.
           IF DATE-FLAG = 3
               MOVE E-MM       TO HC-END-DATE-DD
               MOVE E-DD       TO HC-END-DATE-MM.
           MOVE 20             TO HC-END-DATE-CC.
           IF HC-END-DATE-YY > "70"
               MOVE 19         TO HC-END-DATE-CC.

           MOVE S-TIME         TO HC-STRT-TIME.
           MOVE E-TIME         TO HC-END-TIME.
           MOVE REM            TO HC-REMARKS.

           REWRITE HC-REC      FROM HOT-CODE-DATA.
           IF FILE-STAT NOT = "00"
                DISPLAY "  REWRITE OF HOT-CODE FILE ERROR: " FILE-STAT
                        " RECORD NOT CHANGED.".
           GO TO 6-MAIN.

       62-TEST-VALID-DATE.
           IF DATE-HOLD NOT NUMERIC
               MOVE 35028      TO CATREAD-MSG-NUMBER
               CALL "CCATREAD" USING CATREAD-PARMS
               MOVE CATREAD-MSG-TEXT TO ERRMSG
               MOVE 2          TO FIELD-NUMBER
               GO TO 62-TVD-EXIT.

           IF DH-YY IS NUMERIC
               IF DATE-FLAG = 1
                   IF DH-MM > 0 AND DH-MM < 13
                       IF DH-DD > 0 AND DH-DD < 32
                           NEXT SENTENCE
                       ELSE
                           MOVE 35028 TO CATREAD-MSG-NUMBER
                           CALL "CCATREAD" USING CATREAD-PARMS
                           MOVE CATREAD-MSG-TEXT TO ERRMSG
                           MOVE 3 TO FIELD-NUMBER
                           GO TO 62-TVD-EXIT
                   ELSE
                       MOVE 35031 TO CATREAD-MSG-NUMBER
                       CALL "CCATREAD" USING CATREAD-PARMS
                       MOVE CATREAD-MSG-TEXT TO ERRMSG
                       MOVE 2  TO FIELD-NUMBER
                       GO TO 62-TVD-EXIT
               ELSE
                   IF DH-MM > 0 AND DH-MM < 32
                       IF DH-DD > 0 AND DH-DD < 13
                           NEXT SENTENCE
                       ELSE
                           MOVE 35031 TO CATREAD-MSG-NUMBER
                           CALL "CCATREAD" USING CATREAD-PARMS
                           MOVE CATREAD-MSG-TEXT TO ERRMSG
                           MOVE 3 TO FIELD-NUMBER
                           GO TO 62-TVD-EXIT
                   ELSE
                       MOVE 35030 TO CATREAD-MSG-NUMBER
                       CALL "CCATREAD" USING CATREAD-PARMS
                       MOVE CATREAD-MSG-TEXT TO ERRMSG
                       MOVE 2  TO FIELD-NUMBER
                       GO TO 62-TVD-EXIT
           ELSE
               MOVE 35032 TO CATREAD-MSG-NUMBER
               CALL "CCATREAD" USING CATREAD-PARMS
               MOVE CATREAD-MSG-TEXT TO ERRMSG
               MOVE 4          TO FIELD-NUMBER
               GO TO 62-TVD-EXIT.

       62-TVD-EXIT.    EXIT.

       62-TEST-VALID-TIME.
           IF TIME-HOLD NOT NUMERIC
               MOVE 35029 TO CATREAD-MSG-NUMBER
               CALL "CCATREAD" USING CATREAD-PARMS
               MOVE CATREAD-MSG-TEXT TO ERRMSG
               MOVE 2          TO FIELD-NUMBER
               GO TO 62-TVT-EXIT.
           IF TH-HH < 24
               IF TH-MM < 60
                   NEXT SENTENCE
               ELSE
                   MOVE 35054 TO CATREAD-MSG-NUMBER
                   CALL "CCATREAD" USING CATREAD-PARMS
                   MOVE CATREAD-MSG-TEXT TO ERRMSG
                   MOVE 2      TO FIELD-NUMBER
                   GO TO 62-TVT-EXIT
           ELSE
               MOVE 35055 TO CATREAD-MSG-NUMBER
               CALL "CCATREAD" USING CATREAD-PARMS
               MOVE CATREAD-MSG-TEXT TO ERRMSG
               MOVE 2          TO FIELD-NUMBER
               GO TO 62-TVT-EXIT.

       62-TVT-EXIT.    EXIT.

       END-OF-JOB.
           CLOSE               EQP-EQUIPMENT.
           CLOSE               EQP-HOT-CODE.
           CLOSE               DISPLAY-FILE.
           GOBACK.

