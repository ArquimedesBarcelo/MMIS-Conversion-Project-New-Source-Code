       IDENTIFICATION DIVISION.
       PROGRAM-ID. TSTRMBAL.
       AUTHOR. KURT MOVSESIAN.
       DATE-WRITTEN.    FEBUARY 10, 1988.
      *REMARKS.

      **************************************************************
      *                                                            *
      *   T S T R M B A L  (SR20) THIS IS AN ONLINE PROGRAM THAT   *
      *    LAUNCHES THE JOB THAT PERFORMS THE MONTHEND BALANCE     *
      *    DOLLAR WRITEOFF.  THE JOB IS 'BBALWOFF'.  THIS          *
      *    PROCEDURE IS PART OF THE MONTH-END CLOSING PROCEDURE    *
      *    FOR THE CORPORATE STORES ACCOUNTING SYSTEM (CSAS)       *
      *                                                            *
      **************************************************************


       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.
       SOURCE-COMPUTER.  IBM-AS400.
       OBJECT-COMPUTER.  IBM-AS400.
       SPECIAL-NAMES.    I-O-FEEDBACK IS I-O-FEEDBACK-AREA.

       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT DISPLAY-FILE
                  ASSIGN TO WORKSTATION-ZSTRMBAL-SI
                  ORGANIZATION IS TRANSACTION
                  ACCESS IS SEQUENTIAL
                  FILE STATUS IS DISPLAY-STATUS
                  CONTROL-AREA IS WS-CONTROL.
           SELECT MACTINFO-I
                  ASSIGN TO DATABASE-MCFLCA0101
                  ORGANIZATION IS INDEXED
                    ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                  FILE STATUS IS FILE-STATUS.
           SELECT MPLTINFO-I
                  ASSIGN TO DATABASE-MCFLCS0501
                  ORGANIZATION IS INDEXED
                    ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                  FILE STATUS IS FILE-STATUS.

       DATA DIVISION.
       FILE SECTION.
       FD  DISPLAY-FILE
           LABEL RECORDS ARE OMITTED.
       01  DISPLAY-REC           PIC X(2000).
       FD  MACTINFO-I
           LABEL RECORDS ARE STANDARD.
       01  MACTINFO-REC-I.
           COPY DDS-ALL-FORMATS OF MCFLCA0101.
       FD  MPLTINFO-I
           LABEL RECORDS ARE STANDARD.
       01  MPLTINFO-REC-I.
           COPY DDS-ALL-FORMATS OF MCFLCS0501.

       WORKING-STORAGE SECTION.
       77  COMPANY-SAVE                 PIC X(3)   VALUE SPACES.
       77  FATAL-ERR-SW                 PIC X(1)   VALUE SPACES.
       01  FILE-STATUS.
           05  FILE-STATUS-1            PIC X      VALUE SPACES.
           05  FILE-STATUS-2            PIC X      VALUE SPACES.

       COPY CCHKOBJ IN COPYLIB.
       COPY CCRTFILE IN COPYLIB.
       COPY TDATECHK IN COPYLIB.

       01  TIME-WORKAREA.
           05  HH                       PIC X(2)  VALUE SPACES.
           05  MIN                      PIC X(2)  VALUE SPACES.
           05  SEC                      PIC X(2)  VALUE SPACES.

       01  DISPLAY-TIME.
           05  HH                       PIC X(2)  VALUE SPACES.
           05  FILLER                   PIC X(1)  VALUE ":".
           05  MIN                      PIC X(2)  VALUE SPACES.
           05  FILLER                   PIC X(1)  VALUE ":".
           05  SEC                      PIC X(2).

       COPY VCOMAREA IN COPYLIB.

       01  FORMFILE.
           05  FORM-FNAME                PIC X(8)  VALUE "FSTRMBAL".
           05  FILLER                    PIC X     VALUE ".".
           05  FORM-GNAME.
               10  FORM-GNAME1           PIC X(5)  VALUE "FLANG".
               10  FORM-GNAME2           PIC X(3)  VALUE SPACES.
           05  FILLER                    PIC X(19) VALUE SPACES.

       01  MESSAGE-BUFFER.
           05  MSG-TEXT              PIC X(64)    VALUE SPACE.
           05  MSG-FLD               PIC X(12)    VALUE SPACE.
           05  MSG-FLD-9  REDEFINES  MSG-FLD      PIC Z(11)9.

       01  MESSAGE-BUFLEN            PIC S9(4)    VALUE 76  COMP-4.

       01  MESSAGE-ACTLEN            PIC S9(4)    VALUE 76  COMP-4.

       01  FIELD-NUMBER              PIC S9(4)    VALUE 1   COMP-4.


       01  PASSED-SPOOL-PRT          PIC S9(2)    VALUE ZEROS COMP-4.

      *************************************************************
      **    PARAMETER AREA FOR 'TSHWRDFM'                        **
      *************************************************************
       COPY DISPDATA   IN COPYLIB.
       COPY IOFEEDBACK IN COPYLIB.

      **************************************************************
      **************************************************************
      **                                                          **
      **             TERMINAL I/O DATA AREA                       **
      **                                                          **
      **************************************************************
      **************************************************************

       01  SCREEN-1.
           05  DE1-COMPANY              PIC X(3).
           05  DE1-DATE-LAST-TC         PIC X(8).
           05  DE1-TIME-LAST-TC         PIC X(8).
           05  DE1-LAST-MFST-CSAS       PIC X(3).
           05  DE1-CUTOFF-DATE          PIC X(8).
           05  DE1-AVERAGE-COST-CALC    PIC X(15).
           05  DE1-BALANCE-WRITEOFF     PIC X(15).
           05  DE1-LIFO-REPORT          PIC X(15).
           05  DE1-CMDLINE              PIC X(79).
           05  DE1-MSGLINE              PIC X(79).


      **************************************************************
      **************************************************************
      **                                                          **
      **                DATABASE I/O BUFFER AREA                  **
      **                                                          **
      **************************************************************
      **************************************************************

       COPY MACTINFO  IN COPYLIB.

       COPY MPLT0     IN COPYLIB.

       COPY MPLTP01   IN COPYLIB.

      *********************
      *                   *
      *   DATA SET NAMES  *
      *                   *
      *********************

       01  DSET-NAMES.
           05  DSET-NAME                PIC X(16)  VALUE SPACES.
           05  DSET-MPLTINFO            PIC X(16)  VALUE "MPLTINFO;".
           05  DSET-MACCT           PIC X(16)  VALUE "MACCOUNT-INFO;".

       COPY DATAB IN COPYLIB.

       COPY DBCSACCT IN COPYLIB.

       01 ITEMS-LISTING.
           05  ALL-ITEMS                PIC XX    VALUE "@;".

       01 ARG-VALUES.
           05  MACCT-KEY              PIC X(4)  VALUE SPACES.
           05  PLT-ARG                PIC X(4)  VALUE SPACES.


       01  COMMAND-AREA.
           05  QCMDEXC-BBALWOFF.
               10  STRDBRDR-BBALWOFF   PIC X(36) VALUE
               "STRDBRDR FILE(QJOBSRC) MBR(BBALWOFF)".
               10  DBR-BBALWOFF-PARM2 PIC S9(10)V9(5) COMP-3 VALUE 36.
           05  OVERRIDE-ZSTRMBAL      PIC X(34) VALUE
               "OVRDSPF FILE(ZSTRMBAL) SHARE(*YES)".
           05  OVERRIDE-PARM2         PIC S9(10)V9(5) COMP-3 VALUE 34.

       COPY TBLOWUP  IN COPYLIB.
       COPY LANGUAGE IN COPYLIB.
       COPY CATREAD  IN COPYLIB.

       PROCEDURE DIVISION.

       PROC-DIV SECTION 01.

       BEGIN-HERE.
           PERFORM 1-HSK THRU 1-H-X.

           PERFORM 6-MAIN THRU 6-M-X.

           PERFORM 2-EOJ  THRU 2-EOJ-X.

           GOBACK.

       1-HSK.
           CALL "QCMDEXC" USING OVERRIDE-ZSTRMBAL, OVERRIDE-PARM2.
           OPEN I-O DISPLAY-FILE.

           OPEN INPUT MPLTINFO-I, MACTINFO-I.

      **************************************************
      *                                                *
      *   GET CO. FROM MPLTINFO                        *
      *   USING 'P 01' AS THE ARGUMENT                 *
      *                                                *
      **************************************************

           MOVE "P 01"  TO  PLT-ARG.
           MOVE PLT-ARG TO  PLTINFOKEY OF MPLTINFO-REC-I.
           READ MPLTINFO-I INTO BUF-MPLTINFO
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE "DBGET MPLTINFO 1-HSK P 01"  TO  BU-DISPLAY-MSG
               MOVE PLT-ARG             TO  BU-DISPLAY-FLD (1)
               MOVE BASE                TO  ACCTG-BASE
               GO TO 2-BLOWUP.
           MOVE MPLTINFO-COMPANY        TO  COMPANY-SAVE.

       1-H-X.
           EXIT.

       2-EOJ.
           CLOSE DISPLAY-FILE.
           CLOSE MPLTINFO-I, MACTINFO-I.

       2-EOJ-X.
            EXIT.

      ******************************************************
      **                                                  **
      **   BLOWUP ROUTINE                                 **
      **                                                  **
      ******************************************************

       2-BLOWUP.
           MOVE "TSTRMBAL"              TO  BU-PGM-NAME.
           CALL "TBLOWUP" USING ACCTG-BASE, BU-PGM-NAME, STATUS-AREA,
               VIEW-COMAREA, FILE-STATUS, BU-DISPLAY-MSG,
                       BU-DISPLAY-FLDS.

       2-BLOWUP-X.
           EXIT.

       4-PGM-ERROR.
           MOVE B"1" TO IND(99), IND(FIELD-NUMBER).

       4-PGM-ERROR-X.
           EXIT.


      **************************************************
      *                                                *
      *     6 - M A I N                                *
      *                                                *
      **************************************************

       6-MAIN.
           PERFORM 61-PROCESS-OPTION-SCREEN  THRU  61-POS-X.

       6-M-X.
           EXIT.


       61-PROCESS-OPTION-SCREEN.
           MOVE "STRMBAL1"  TO  VIEW-NFNAME.

       61-PUT-BUFFER-1.
           MOVE SPACES                  TO  SCREEN-1.
           MOVE COMPANY-SAVE            TO  DE1-COMPANY.
           PERFORM 611-GET-SCREEN-INFO  THRU  611-GSI-X.

       61-SHOWFORM-SCREEN-1.
           MOVE SCREEN-1                TO  DISPLAY-REC.
           PERFORM 998-WRITE-SCREEN THRU 998-READ-SCREEN.
           MOVE DISPLAY-REC             TO  SCREEN-1.
           MOVE ZEROS                   TO  VIEW-SHOWCONTROL.

           IF VIEW-LASTKEY = 1
               NEXT SENTENCE
           ELSE
           IF VIEW-LASTKEY = 3
                   GO TO 61-POS-X
           ELSE
           IF VIEW-LASTKEY = 2 OR
              VIEW-LASTKEY = 4 OR
              VIEW-LASTKEY = 5 OR
              VIEW-LASTKEY = 6 OR
              VIEW-LASTKEY = 7 OR
              VIEW-LASTKEY = 8
      *        "* INVALID FUNCTION KEY ENTERED *"
               MOVE   9 TO LANG-SETNUM
               MOVE  10 TO LANG-MSGNUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER  TO  DE1-MSGLINE
               MOVE B"1"            TO  IND(99)
               GO TO 61-SHOWFORM-SCREEN-1
           ELSE
      *        ***  SELECT THE APPROPRIATE  'FUNCTION KEY'  ***
               MOVE  19 TO LANG-SETNUM
               MOVE  13 TO LANG-MSGNUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER  TO  DE1-MSGLINE
               MOVE B"1"            TO  IND(99)
               GO TO  61-SHOWFORM-SCREEN-1.

           PERFORM 63-LAUNCH-BATCH-JOB  THRU 63-LBJ-X.

       61-POS-X.
           EXIT.


       611-GET-SCREEN-INFO.
           MOVE "MTED"                  TO  MACCT-KEY.
           MOVE MACCT-KEY TO INFOKEY OF MACTINFO-REC-I.
           READ MACTINFO-I INTO BUF-MACCT-INFO
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE "GET MACCT-INFO * 611-GSI" TO BU-DISPLAY-MSG
               MOVE MACCT-KEY           TO BU-DISPLAY-FLD (1)
               GO TO 2-BLOWUP.

           MOVE 4                         TO  DATE-MODE.
           MOVE MACCT-LATEST-CUTOFF-DATE  TO  DATE-VALIDATE-IN.
           CALL "TDATECK2" USING DATE-CHECK-AREA, LANGUAGE-PARMS.
           MOVE DATE-SLASH-OUT          TO  DE1-DATE-LAST-TC.

           MOVE MACCT-LATEST-CUTOFF-TIME  TO  TIME-WORKAREA.
           MOVE CORR TIME-WORKAREA      TO  DISPLAY-TIME.
           MOVE DISPLAY-TIME            TO  DE1-TIME-LAST-TC.

           MOVE MACCT-LAST-MANIFEST     TO  DE1-LAST-MFST-CSAS.

           MOVE MACCT-MONTH-END-DATE    TO  DATE-VALIDATE-IN.
           CALL "TDATECK2" USING DATE-CHECK-AREA, LANGUAGE-PARMS.
           MOVE DATE-SLASH-OUT          TO  DE1-CUTOFF-DATE.

      **********************************************
      **   CHECK TO SEE IF AVERAGE COST CALCULATION
      **   FOR RAW MATERIALS IS COMPLETE
      **********************************************
           IF MACCT-AVG-COST-CALC-SW = SPACES
      *     "NOT COMPLETE"
               MOVE 14  TO  LANG-SETNUM
               MOVE 74  TO  LANG-MSGNUM
               PERFORM 999-CATREAD  THRU  999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER  TO  DE1-AVERAGE-COST-CALC
           ELSE
      *     "COMPLETE"
               MOVE 3   TO  LANG-SETNUM
               MOVE 164 TO  LANG-MSGNUM
               PERFORM 999-CATREAD  THRU  999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER  TO  DE1-AVERAGE-COST-CALC.

      **********************************************
      **   CHECK TO SEE IF MONTHEND BALANCE DOLLARS
      **   WRITEOFF IS COMPLETE
      **********************************************
           IF MACCT-BALWOFF-SW = SPACES
      *     "NOT COMPLETE"
               MOVE 14  TO  LANG-SETNUM
               MOVE 74  TO  LANG-MSGNUM
               PERFORM 999-CATREAD  THRU  999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER  TO  DE1-BALANCE-WRITEOFF
           ELSE
      *     "COMPLETE"
               MOVE 3   TO  LANG-SETNUM
               MOVE 164 TO  LANG-MSGNUM
               PERFORM 999-CATREAD  THRU  999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER  TO  DE1-BALANCE-WRITEOFF.

      **********************************************
      **   CHECK TO SEE IF A SUCCESSFULL LIFO REPORT
      **   FOR RAW MATERIALS WAS GENERATED
      **********************************************
           IF MACCT-LIFORPT-SW = SPACES
      *     "NOT COMPLETE"
               MOVE 14  TO  LANG-SETNUM
               MOVE 74  TO  LANG-MSGNUM
               PERFORM 999-CATREAD  THRU  999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER  TO  DE1-LIFO-REPORT
           ELSE
      *     "COMPLETE"
               MOVE 3   TO  LANG-SETNUM
               MOVE 164 TO  LANG-MSGNUM
               PERFORM 999-CATREAD  THRU  999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER  TO  DE1-LIFO-REPORT.

       611-GSI-X.
           EXIT.


       63-LAUNCH-BATCH-JOB.
           CALL "QCMDEXC" USING STRDBRDR-BBALWOFF, DBR-BBALWOFF-PARM2.

       63-LBJ-X.
           EXIT.

       COPY DISPCALL IN COPYLIB.
       999-CATREAD.
           IF CATREAD-MSG-NUMBER = ZEROS
               MOVE LANG-SETNUM TO CATREAD-MSG-SET
               MOVE LANG-MSGNUM TO CATREAD-MSG-NUM.
           CALL "CCATREAD" USING CATREAD-PARMS.
           MOVE CATREAD-MSG-TEXT TO MESSAGE-BUFFER.
       999-CATREAD-EXIT.
           EXIT.
