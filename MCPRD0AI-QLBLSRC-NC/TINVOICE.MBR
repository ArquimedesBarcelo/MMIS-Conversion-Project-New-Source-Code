           05  KS-EMPLOYEE-ID        PIC X(4)     VALUE SPACE.
       01  ITEM-SEQ-SAVE-NO.
           05  ITEM-NO               PIC 9(4)     VALUE ZEROS.
           05  SEQ-NO                PIC 9(2)     VALUE ZEROS.
       01  PGM-FUNCTION              PIC X        VALUE SPACE.
       01  PREPAY-SW                 PIC X        VALUE "N".
           88  ALLOW-PREPAYS                      VALUE "Y".
9207CK 01  PAY-REQ-SW                PIC X        VALUE SPACES.
       01  COMMAND-AREA.
           05  OVERRIDE-ZINVOICE     PIC X(34)    VALUE
               "OVRDSPF FILE(ZINVOICE) SHARE(*YES)".
           05  OVERRIDE-PARM2        PIC S9(10)V9(5) COMP-3 VALUE 34.
       01  INDX                      PIC 99       VALUE ZERO.
       01  PRIME-REDEFINED.
           05  PRIME-BYTE            PIC X(1)     OCCURS 3 TIMES.
       01  SUB-REDEFINED.
           05  SUB-BYTE              PIC X(1)     OCCURS 3 TIMES.
       01  CONT-SW                   PIC X.
       01  DUMMY-BUYER               PIC X(4)     VALUE SPACES.
