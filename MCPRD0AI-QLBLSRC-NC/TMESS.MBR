       IDENTIFICATION DIVISION.
       PROGRAM-ID.    TMESS.
       AUTHOR.        R L ENSMINGER.
       INSTALLATION.  GTR.
       DATE-COMPILED.
       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.
       SOURCE-COMPUTER. IBM-AS400.
       OBJECT-COMPUTER. IBM-AS400.
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT TERMINAL-FILE
                  ASSIGN TO WORKSTATION-ZMESS-SI
                  ORGANIZATION IS TRANSACTION
                  ACCESS IS SEQUENTIAL.
           SELECT MESSAGE-FILE-PF
                  ASSIGN TO DATABASE-MCFP000100
                  ORGANIZATION IS INDEXED
                  ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                  FILE STATUS IS MSGFILEP-STATUS.
           SELECT MESSAGE-FILE-LF
                  ASSIGN TO DATABASE-MCFL000101
                  ORGANIZATION IS INDEXED
                  ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                  WITH DUPLICATES
                  FILE STATUS IS MSGFILEL-STATUS.

       DATA DIVISION.
       FILE SECTION.
       FD  TERMINAL-FILE
           LABEL RECORDS ARE OMITTED.
       01  TERMINAL-REC.
           COPY DDS-ALL-FORMATS OF ZMESS.
       FD  MESSAGE-FILE-PF
           LABEL RECORDS ARE STANDARD.
       01  MESSAGE-RCD-NO.
           COPY DDS-ALL-FORMATS OF MCFP000100.
       FD  MESSAGE-FILE-LF
           LABEL RECORDS ARE STANDARD.
       01  MESSAGE-RCD-TEXT.
           COPY DDS-ALL-FORMATS OF MCFL000101.
       EJECT
       WORKING-STORAGE SECTION.
       01  MSGFILEP-STATUS                    PIC XX.
       01  MSGFILEL-STATUS                    PIC XX.

       01  TRUE-VAL                           PIC 1 VALUE B"1".
       01  FALS-VAL                           PIC 1 VALUE B"0".

       01  ADD-SW                             PIC X.
       01  REUSE-SW                           PIC X.
       01  MOD-SW                             PIC X.
       01  CONTINUE-SW                        PIC X.

       01  SCREEN-INDICATORS.
           05 IN03                            PIC 1 INDICATOR 03.
           05 IN04                            PIC 1 INDICATOR 04.
           05 IN05                            PIC 1 INDICATOR 05.
           05 IN06                            PIC 1 INDICATOR 06.
           05 IN07                            PIC 1 INDICATOR 07.
           05 IN10                            PIC 1 INDICATOR 10.
           05 IN20                            PIC 1 INDICATOR 20.
           05 IN30                            PIC 1 INDICATOR 30.
           05 IN40                            PIC 1 INDICATOR 40.

       01  WS-MESSAGE.
           05 FILLER                          PIC X(5).
           05 LAST-MESSAGE-NUMBER             PIC 9(5).
           05 FILLER                          PIC X(75).

       01  LAST-MESSAGE                       PIC X(80).

       01  S1                                 PIC 99 COMP-3.

       01  WS-SCREEN.
           05 WS-MSGTXT1                      PIC X(20).
           05 WS-MSGNONEW                     PIC S9(5).
           05 WS-MSGTXTNEW                    PIC X(79).
           05 WS-MODMSGNUM                    PIC S9(5).
           05 MESSAGES OCCURS 10 TIMES.
              10 WS-MSGNO                     PIC S9(5).
              10 WS-TEXT                      PIC X(72).
           05 WS-ERRMSG                       PIC X(79).
       EJECT
       PROCEDURE DIVISION.
       OPEN-PAR.
           OPEN I-O   TERMINAL-FILE.
           OPEN I-O   MESSAGE-FILE-PF.
           OPEN INPUT MESSAGE-FILE-LF.

           MOVE SPACES TO ZMESS-RECORD.
           MOVE 0 TO MSGNO1    OF SCREEN1-O
                     MSGNO2    OF SCREEN1-O
                     MSGNO3    OF SCREEN1-O
                     MSGNO4    OF SCREEN1-O
                     MSGNO5    OF SCREEN1-O
                     MSGNO6    OF SCREEN1-O
                     MSGNO7    OF SCREEN1-O
                     MSGNO8    OF SCREEN1-O
                     MSGNO9    OF SCREEN1-O
                     MSGNO10   OF SCREEN1-O
                     MODMSGNUM OF SCREEN1-O
                     MSGNONEW  OF SCREEN1-O.

           MOVE SPACES TO LAST-MESSAGE.
           MOVE "N" TO MOD-SW.

           PERFORM SHOW-SCREEN UNTIL IN03 = TRUE-VAL.
           PERFORM END-PAR.
       EJECT
       SHOW-SCREEN.
           WRITE TERMINAL-REC  FORMAT IS "SCREEN1"
                 INDIC ARE SCREEN-INDICATORS.
           READ  TERMINAL-FILE FORMAT IS "SCREEN1"
                 INDIC ARE SCREEN-INDICATORS.

           MOVE FALS-VAL TO IN10 IN20 IN30.

           IF IN04 = TRUE-VAL
             PERFORM START-LIST THRU START-LIST-EXIT.

           IF IN05 = TRUE-VAL
             PERFORM CONTINUE-LIST THRU CONTINUE-LIST-EXIT.

           IF IN06 = TRUE-VAL
             IF MSGTXTNEW OF SCREEN1-O NOT = SPACES
               PERFORM ADD-MESSAGE THRU ADD-MESSAGE-EXIT
             ELSE GO TO SHOW-SCREEN.

           IF IN07 = TRUE-VAL
             PERFORM MOD-MESSAGE THRU MOD-MESSAGE-EXIT
             GO TO SHOW-SCREEN.

           MOVE "N" TO MOD-SW.
           MOVE FALS-VAL TO IN40.

       END-PAR.
           CLOSE TERMINAL-FILE.
           CLOSE MESSAGE-FILE-PF.
           CLOSE MESSAGE-FILE-LF.
           STOP RUN.
       EJECT
       ADD-MESSAGE.
           MOVE "N" TO ADD-SW.
           MOVE MSGTXTNEW OF SCREEN1-O TO MESSAG OF MESSAGE-RCD-TEXT.
           READ MESSAGE-FILE-LF
            INVALID KEY
             MOVE "Y" TO ADD-SW.
           IF ADD-SW = "N"
             MOVE "MESSAGE ALREADY EXISTS" TO ERRMSG
             MOVE TRUE-VAL TO IN30
             GO TO ADD-MESSAGE-EXIT.

           MOVE "Y" TO REUSE-SW.
           PERFORM REUSE-MESSAGE THRU REUSE-MESSAGE-EXIT.
           IF REUSE-SW = "N"
             PERFORM NEW-MESSAGE THRU NEW-MESSAGE-EXIT.

       ADD-MESSAGE-EXIT.
           EXIT.
       EJECT
       REUSE-MESSAGE.
           MOVE SPACES TO MESSAG OF MESSAGE-RCD-TEXT.
           READ MESSAGE-FILE-LF
            INVALID KEY
             MOVE "N" TO REUSE-SW
             GO TO REUSE-MESSAGE-EXIT.

           MOVE MESSAGE-RCD-TEXT TO MESSAGE-RCD-NO.
           READ MESSAGE-FILE-PF
            INVALID KEY
             GO TO END-PAR.
           IF MESSAG OF MESSAGE-RCD-NO NOT = SPACES
             GO TO REUSE-MESSAGE.

           MOVE MSGTXTNEW OF SCREEN1-O TO MESSAG OF MESSAGE-RCD-NO.
           REWRITE MESSAGE-RCD-NO
            INVALID KEY
             MOVE "ADD FAILED" TO ERRMSG
             MOVE TRUE-VAL TO IN30
             GO TO REUSE-MESSAGE-EXIT.

           MOVE "MESSAGE ADDED" TO ERRMSG.
           MOVE TRUE-VAL TO IN30.
           MOVE MSGNUM OF MESSAGE-RCD-NO TO MSGNONEW OF SCREEN1-O.

       REUSE-MESSAGE-EXIT.
           EXIT.
       EJECT
       NEW-MESSAGE.
           MOVE 0 TO MSGNUM OF MESSAGE-RCD-NO.
           READ MESSAGE-FILE-PF
            INVALID KEY
             GO TO END-PAR.
           MOVE MESSAGE-RCD-NO TO WS-MESSAGE.
           ADD 1 TO LAST-MESSAGE-NUMBER.
           MOVE WS-MESSAGE TO MESSAGE-RCD-NO.
           REWRITE MESSAGE-RCD-NO
            INVALID KEY
             GO TO END-PAR.

           MOVE LAST-MESSAGE-NUMBER TO MSGNUM OF MESSAGE-RCD-NO.
           MOVE MSGTXTNEW OF SCREEN1-O TO MESSAG OF MESSAGE-RCD-NO.
           WRITE MESSAGE-RCD-NO
            INVALID KEY
             MOVE "ADD FAILED" TO ERRMSG
             MOVE TRUE-VAL TO IN30
             GO TO NEW-MESSAGE-EXIT.

           MOVE "MESSAGE ADDED" TO ERRMSG.
           MOVE TRUE-VAL TO IN30.
           MOVE MSGNUM OF MESSAGE-RCD-NO TO MSGNONEW OF SCREEN1-O.

       NEW-MESSAGE-EXIT.
           EXIT.
       EJECT
       MOD-MESSAGE.
           IF MOD-SW = "Y"
             MOVE "N" TO MOD-SW
             MOVE FALS-VAL TO IN40
             PERFORM MOD-MESSAGE1 THRU MOD-MESSAGE1-EXIT
             GO TO MOD-MESSAGE-EXIT.

           IF MODMSGNUM OF SCREEN1-O > 0
             NEXT SENTENCE
           ELSE
             MOVE TRUE-VAL TO IN20
             GO TO MOD-MESSAGE-EXIT.

           MOVE MODMSGNUM OF SCREEN1-O TO MSGNUM OF MESSAGE-RCD-NO.
           READ MESSAGE-FILE-PF
            INVALID KEY
             MOVE TRUE-VAL TO IN20
             GO TO MOD-MESSAGE-EXIT.
           REWRITE MESSAGE-RCD-NO
            INVALID KEY
             GO TO END-PAR.

           MOVE "Y" TO MOD-SW.
           MOVE MESSAG OF MESSAGE-RCD-NO TO MSGTXTNEW OF SCREEN1-O.
           MOVE MESSAGE-RCD-NO TO WS-MESSAGE.
           MOVE "MAKE CHANGES - PRESS F7 TO COMPLETE MODIFY" TO ERRMSG.
           MOVE TRUE-VAL TO IN30 IN40.

       MOD-MESSAGE-EXIT.
           EXIT.
       EJECT
       MOD-MESSAGE1.
           MOVE MODMSGNUM OF SCREEN1-O TO MSGNUM OF MESSAGE-RCD-NO.
           READ MESSAGE-FILE-PF
            INVALID KEY
             GO TO END-PAR.

           IF MESSAGE-RCD-NO NOT = WS-MESSAGE
             PERFORM MOD-MESSAGE2
             GO TO MOD-MESSAGE1-EXIT.

           MOVE MODMSGNUM OF SCREEN1-O TO MSGNUM OF MESSAGE-RCD-NO.
           MOVE MSGTXTNEW OF SCREEN1-O TO MESSAG OF MESSAGE-RCD-NO.
           REWRITE MESSAGE-RCD-NO
            INVALID KEY
             MOVE "MODIFY FAILED" TO ERRMSG
             MOVE TRUE-VAL TO IN30
             GO TO MOD-MESSAGE1-EXIT.

           MOVE "MESSAGE MODIFIED" TO ERRMSG.
           MOVE TRUE-VAL TO IN30.

       MOD-MESSAGE1-EXIT.
           EXIT.
       EJECT
       MOD-MESSAGE2.
           MOVE SPACES TO ERRMSG.
           STRING "MESSAGE "
                   MSGNUM OF MESSAGE-RCD-NO
                  " HAS BEEN CHANGED BY ANOTHER PROGRAMMER"
                  " - PRESS F7 TO START AGAIN"
            DELIMITED BY SIZE INTO ERRMSG.
           MOVE TRUE-VAL TO IN30.

           REWRITE MESSAGE-RCD-NO
            INVALID KEY
             GO TO END-PAR.
       EJECT
       START-LIST.
           MOVE "Y" TO CONTINUE-SW.
           MOVE MSGTXTI OF SCREEN1-O TO MESSAG OF MESSAGE-RCD-TEXT.
           START MESSAGE-FILE-LF
            KEY IS NOT LESS THAN MESSAG OF MESSAGE-RCD-TEXT
             INVALID KEY
              MOVE "N" TO CONTINUE-SW.
           IF CONTINUE-SW = "N"
             MOVE TRUE-VAL TO IN10
             GO TO START-LIST-EXIT.
           MOVE SCREEN1-O TO WS-SCREEN.
           PERFORM INIT-VALUES VARYING S1 FROM 1 BY 1
            UNTIL S1 > 10.
           PERFORM MESSAGE-LIST THRU MESSAGE-LIST-EXIT
            VARYING S1 FROM 1 BY 1 UNTIL S1 > 10.
           MOVE WS-SCREEN TO SCREEN1-O.

       START-LIST-EXIT.
           EXIT.
       EJECT
       CONTINUE-LIST.
           MOVE "Y" TO CONTINUE-SW.
           MOVE LAST-MESSAGE TO MESSAG OF MESSAGE-RCD-TEXT.
           START MESSAGE-FILE-LF
            KEY IS GREATER THAN MESSAG OF MESSAGE-RCD-TEXT
             INVALID KEY
              MOVE "N" TO CONTINUE-SW.
           IF CONTINUE-SW = "N"
             MOVE TRUE-VAL TO IN10
             GO TO CONTINUE-LIST-EXIT.
           MOVE SCREEN1-O TO WS-SCREEN.
           PERFORM INIT-VALUES VARYING S1 FROM 1 BY 1
            UNTIL S1 > 10.
           PERFORM MESSAGE-LIST THRU MESSAGE-LIST-EXIT
            VARYING S1 FROM 1 BY 1 UNTIL S1 > 10.
           MOVE WS-SCREEN TO SCREEN1-O.

       CONTINUE-LIST-EXIT.
           EXIT.
       EJECT
       MESSAGE-LIST.
           READ MESSAGE-FILE-LF NEXT RECORD
            AT END
             MOVE 11 TO S1
             GO TO MESSAGE-LIST-EXIT.
           IF MSGNUM OF MESSAGE-RCD-TEXT = 0
             GO TO MESSAGE-LIST.
           MOVE MESSAGE-RCD-TEXT TO MESSAGES (S1).
           MOVE MESSAG OF MESSAGE-RCD-TEXT TO LAST-MESSAGE.

       MESSAGE-LIST-EXIT.
           EXIT.

       INIT-VALUES.
           MOVE 0 TO WS-MSGNO (S1).
           MOVE SPACES TO WS-TEXT (S1).
