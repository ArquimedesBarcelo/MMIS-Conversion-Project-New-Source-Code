000200 IDENTIFICATION DIVISION.
000300 PROGRAM-ID. TCHKLABR.
000400 ENVIRONMENT DIVISION.
000500 CONFIGURATION SECTION.
000600 SOURCE-COMPUTER.   AS400.
000700 OBJECT-COMPUTER.   AS400.
000800 INPUT-OUTPUT SECTION.
000900 FILE-CONTROL.
001000     SELECT PRINT-FILE
               ASSIGN TO PRINTER-QPRINT.
001100     SELECT SORT-FILE
               ASSIGN TO DISK-SORTFILE.
           SELECT WO-BASIC-FILE
               ASSIGN TO DATABASE-MCFLMM1001
               ORGANIZATION IS INDEXED
               ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
               FILE STATUS IS WBF-STATUS.
           SELECT WO-LABOR-FILE
               ASSIGN TO DATABASE-MCFLMM1301
               ORGANIZATION IS INDEXED
               ACCESS IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY WITH DUPLICATES
               FILE STATUS IS WLF-STATUS.
           SELECT WO-LAST-NUM-USED
               ASSIGN TO DATABASE-MCFPMM0800
               ORGANIZATION IS RELATIVE
               ACCESS MODE IS RANDOM
               RELATIVE KEY IS ARG-NO
               FILE STATUS IS WLNU-STATUS.
           SELECT WO-PLANNED-FILE
               ASSIGN TO DATABASE-MCFLMM1101
               ORGANIZATION IS INDEXED
               ACCESS IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
               FILE STATUS IS WPF-STATUS.
001200 DATA DIVISION.
001300 FILE SECTION.
001400 FD  PRINT-FILE RECORD CONTAINS 132 CHARACTERS
001500     LABEL RECORD IS OMITTED
001600     DATA RECORD IS PRT-REC.
001700 01  PRT-REC               PIC X(132).
001800 SD  SORT-FILE RECORD CONTAINS 68 CHARACTERS
001900     DATA RECORD IS SORT-REC.
002000 01  SORT-REC.
002100     05  SRT-WO            PIC X(10).
002200     05  SRT-CC            PIC X(4).
002300     05  SRT-NM            PIC X(16).
002400     05  SRT-CR            PIC XX.
002500     05  SRT-HRS.
002600         10  SRT-HR        PIC 99.
002700         10  SRT-MI        PIC 9.
002800     05  SRT-SF            PIC X.
002900     05  SRT-COST.
003000         10  SRT-DO        PIC 9(10).
003100         10  SRT-CT        PIC 99.
003200     05  SRT-STD           PIC X(6).
003300     05  SRT-STT           PIC X(4).
003400     05  SRT-COD           PIC X(6).
003500     05  SRT-COT           PIC X(4).
       FD  WO-BASIC-FILE
           LABEL RECORDS ARE STANDARD
           DATA RECORD IS WBFREC.
       01  WBFREC.
           COPY DDS-ALL-FORMATS OF MCFLMM1001.
       FD  WO-LABOR-FILE
           LABEL RECORDS ARE STANDARD
           DATA RECORD IS WLFREC.
       01  WLFREC.
           COPY DDS-ALL-FORMATS OF MCFLMM1301.
       FD  WO-LAST-NUM-USED
           LABEL RECORDS ARE STANDARD
           DATA RECORD IS WLNUREC.
       01  WLNUREC.
           COPY DDS-ALL-FORMATS OF MCFPMM0800.
       FD  WO-PLANNED-FILE
           LABEL RECORDS ARE STANDARD
           DATA RECORD IS WPFREC.
       01  WPFREC.
           COPY DDS-ALL-FORMATS OF MCFLMM1101.
003600 WORKING-STORAGE SECTION.
003700 77  LABOR-SEQ             PIC 999.
003800 77  LINE-CTR              PIC 99    VALUE 60.
003900 01  ARG-NO                PIC 9(9).
004000 01  DBPARAMETERS.       COPY DBPARMS OF COPYLIB.
       01  FILE-STATUSES.
           05  WBF-STATUS        PIC XX.
           05  WLF-STATUS        PIC XX.
           05  WLNU-STATUS       PIC XX.
           05  WPF-STATUS        PIC XX.
004300 01  HEADER-1.
004400     05  FILLER  PIC X(35) VALUE SPACES.
004500     05  FILLER  PIC X(17) VALUE "EXCEPTIONS REPORT".
004600     05  FILLER  PIC X(80) VALUE SPACES.
004700 01  HEADER-2.
004800     05  FILLER  PIC X     VALUE SPACE.
004900     05  FILLER  PIC X(10) VALUE "W/O NUMBER".
005000     05  FILLER  PIC XX    VALUE SPACES.
005100     05  FILLER  PIC X(4)  VALUE "EMP#".
005200     05  FILLER  PIC X(3)  VALUE SPACES.
005300     05  FILLER  PIC X(13) VALUE "EMPLOYEE NAME".
005400     05  FILLER  PIC X(4)  VALUE SPACES.
005500     05  FILLER  PIC XX    VALUE "CR".
005600     05  FILLER  PIC XX    VALUE SPACES.
005700     05  FILLER  PIC X(3)  VALUE "HRS".
005800     05  FILLER  PIC XX    VALUE SPACES.
005900     05  FILLER  PIC X(3)  VALUE "SFT".
006000     05  FILLER  PIC XX    VALUE SPACES.
006100     05  FILLER  PIC X(12)  VALUE "LBR COST".
006200     05  FILLER  PIC XX    VALUE SPACES.
006300     05  FILLER  PIC X(6)  VALUE "STDATE".
006400     05  FILLER  PIC XX    VALUE SPACES.
006500     05  FILLER  PIC X(4)  VALUE "STTM".
006600     05  FILLER  PIC XX    VALUE SPACES.
006700     05  FILLER  PIC X(6)  VALUE "CODATE".
006800     05  FILLER  PIC XX    VALUE SPACES.
006900     05  FILLER  PIC X(4)  VALUE "COTM".
007000     05  FILLER  PIC XX    VALUE SPACES.
007100     05  FILLER  PIC XXX   VALUE "SEQ".
007200     05  FILLER  PIC X(36) VALUE SPACES.
007300 01  HEADER-3.
007400     05  FILLER  PIC X     VALUE SPACE.
007500     05  FILLER  PIC X(10) VALUE ALL "_".
007600     05  FILLER  PIC XX    VALUE SPACES.
007700     05  FILLER  PIC X(4)  VALUE "____".
007800     05  FILLER  PIC XX    VALUE SPACES.
007900     05  FILLER  PIC X(16) VALUE ALL "_".
008000     05  FILLER  PIC XX    VALUE SPACES.
008100     05  FILLER  PIC XX    VALUE "__".
008200     05  FILLER  PIC XX    VALUE SPACES.
008300     05  FILLER  PIC X(3)  VALUE "___".
008400     05  FILLER  PIC XX    VALUE SPACES.
008500     05  FILLER  PIC X(3)  VALUE "___".
008600     05  FILLER  PIC XX    VALUE SPACES.
008700     05  FILLER  PIC X(12)  VALUE "____________".
008800     05  FILLER  PIC XX    VALUE SPACES.
008900     05  FILLER  PIC X(6)  VALUE "______".
009000     05  FILLER  PIC XX    VALUE SPACES.
009100     05  FILLER  PIC X(4)  VALUE "____".
009200     05  FILLER  PIC XX    VALUE SPACES.
009300     05  FILLER  PIC X(6)  VALUE "______".
009400     05  FILLER  PIC XX    VALUE SPACES.
009500     05  FILLER  PIC X(4)  VALUE "____".
009600     05  FILLER  PIC XX    VALUE SPACES.
009700     05  FILLER  PIC X(3)  VALUE "___".
009800     05  FILLER  PIC X(36) VALUE SPACES.
009900 01  LAST-WO-BUFF.       COPY MLASTWO OF COPYLIB.
010000 01  PRINT-LINE.
010100     05  FILLER  PIC X     VALUE SPACE.
010200     05  PRT-WO  PIC X(10) VALUE SPACES.
010300     05  FILLER  PIC XX    VALUE SPACES.
010400     05  PRT-CC  PIC X(4)  VALUE SPACES.
010500     05  FILLER  PIC XX    VALUE SPACES.
010600     05  PRT-NM  PIC X(16) VALUE SPACES.
010700     05  FILLER  PIC XX    VALUE SPACES.
010800     05  PRT-CR  PIC XX    VALUE SPACES.
010900     05  FILLER  PIC XX    VALUE SPACES.
011000     05  PRT-HR  PIC 99.
011100     05  PRT-DEC PIC X     VALUE ".".
011200     05  PRT-MI  PIC 9.
011300     05  FILLER  PIC XX    VALUE SPACES.
011400     05  PRT-SF  PIC X     VALUE SPACE.
011500     05  FILLER  PIC XX   VALUE SPACES.
011600     05  PRT-DO  PIC 9(10).
011700     05  PRT-PT  PIC X     VALUE ".".
011800     05  PRT-CT  PIC 99.
011900     05  FILLER  PIC XX    VALUE SPACES.
012000     05  PRT-STD PIC X(6)  VALUE SPACES.
012100     05  FILLER  PIC XX    VALUE SPACES.
012200     05  PRT-STT PIC X(4)  VALUE SPACES.
012300     05  FILLER  PIC XX    VALUE SPACES.
012400     05  PRT-COD PIC X(6)  VALUE SPACES.
012500     05  FILLER  PIC XX    VALUE SPACES.
012600     05  PRT-COT PIC X(4)  VALUE SPACES.
012700     05  FILLER  PIC XX    VALUE SPACES.
012800     05  PRT-SEQ PIC 999.
012900     05  FILLER  PIC X(36) VALUE SPACES.
013000 01  RETURN-CODE           PIC X.
013100 COPY DBSTAT  OF COPYLIB.
013800 01  WO-BASIC-DATA.      COPY DWOBASIC OF COPYLIB.
013900 01  WO-LABOR-DATA.      COPY DWOLABOR OF COPYLIB.
014000 01  WO-PLANNED-DATA.    COPY DWOPLAN  OF COPYLIB.
014100 PROCEDURE DIVISION.
014200 START-PROCESSING.
014300     PERFORM 1-HSK.
014400     SORT SORT-FILE ON ASCENDING KEY SRT-WO
014500                 INPUT PROCEDURE 7-SORT-INPUT
014600                 OUTPUT PROCEDURE 8-WRITE-OUTPUT.
014700 2-EOJ.
           CLOSE WO-BASIC-FILE.
           CLOSE WO-LABOR-FILE.
           CLOSE WO-LAST-NUM-USED.
           CLOSE WO-PLANNED-FILE.
014900     CLOSE PRINT-FILE.
015000     GOBACK.
015100 1-HSK.
015200     OPEN OUTPUT PRINT-FILE.
           OPEN INPUT WO-BASIC-FILE.
           OPEN INPUT WO-LABOR-FILE.
           OPEN INPUT WO-LAST-NUM-USED.
           OPEN INPUT WO-PLANNED-FILE.
015300     MOVE LOW-VALUES TO STATUS-AREA.
           MOVE 0 TO COND-WORD.
           MOVE 1 TO ARG-NO.
           READ WO-LAST-NUM-USED INTO LAST-WO-BUFF
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF WLNU-STATUS NOT = "00" MOVE 17 TO COND-WORD.
017100     MOVE " " TO RETURN-CODE.
           READ WO-LABOR-FILE FIRST    AT END
               MOVE 17 TO COND-WORD.
           IF COND-WORD = 17 GO TO 2-EOJ.
017200 7-SORT-INPUT.
           PERFORM 7-SI-CONT THRU 7-SORT-INPUT-X UNTIL COND-WORD = 17.
       7-SI-CONT.
           MOVE 0 TO COND-WORD.
017300     READ WO-LABOR-FILE NEXT INTO WO-LABOR-DATA
017400         AT END    MOVE 17 TO COND-WORD.
           IF WLF-STATUS NOT = "00" MOVE 17 TO COND-WORD.
017500     IF COND-WORD = 17 GO TO 7-SORT-INPUT-X.
017700     IF PLANT-IDENT = "129 "
017800         IF LBR-HRS > "120"
017900             NEXT SENTENCE
018000         ELSE
018100         GO TO 7-SI-CONT
018200     ELSE
018300     IF LBR-HRS > "080" NEXT SENTENCE
018400         ELSE GO TO 7-SI-CONT.
018500     PERFORM 71-CHECK-BASIC THRU 71-CB-EXIT.
018600     IF RETURN-CODE = "N"
018700         MOVE " " TO RETURN-CODE
018800         PERFORM 72-CHECK-PLANNED THRU 72-CP-EXIT
018900         IF RETURN-CODE = "N"
019000             MOVE " " TO RETURN-CODE
019100             GO TO 7-SI-CONT
019200         ELSE
019300         PERFORM 73-MOVE-AND-WRITE-OUTPUT
019400         MOVE " " TO RETURN-CODE
019500         GO TO 7-SI-CONT
019600     ELSE
019700     PERFORM 73-MOVE-AND-WRITE-OUTPUT
019800     MOVE " " TO RETURN-CODE
019900     GO TO 7-SI-CONT.
020000 71-CHECK-BASIC.
           MOVE 0 TO COND-WORD.
020100     MOVE LBR-WO-NUM TO WONUM OF WBFREC.
020300     START WO-BASIC-FILE KEY IS = EXTERNALLY-DESCRIBED-KEY
020400         INVALID KEY    MOVE 17 TO COND-WORD.
           IF WBF-STATUS NOT = "00" MOVE 17 TO COND-WORD.
020500     IF COND-WORD = 17
020600         MOVE "N" TO RETURN-CODE
020700         GO TO 71-CB-EXIT.
020800     MOVE 0 TO COND-WORD.
020900     READ WO-BASIC-FILE NEXT INTO WO-BASIC-DATA
               AT END    MOVE 17 TO COND-WORD.
           IF WBF-STATUS NOT = "00" MOVE 17 TO COND-WORD.
021000     IF COND-WORD = 17
021100         MOVE "N" TO RETURN-CODE
021200         GO TO 71-CB-EXIT.
021300     IF WO-STATUS = "FF"
021400         MOVE "N" TO RETURN-CODE
021500         GO TO 71-CB-EXIT.
021600     MOVE "Y" TO RETURN-CODE.
021700 71-CB-EXIT.    EXIT.
021800 72-CHECK-PLANNED.
021900     IF PLANT-IDENT = "153 "
022000         MOVE "N" TO RETURN-CODE
022100         GO TO 72-CP-EXIT.
           MOVE 0 TO COND-WORD.
022200     MOVE LBR-WO-NUM TO WONUM OF WPFREC.
022400     START WO-PLANNED-FILE KEY IS = EXTERNALLY-DESCRIBED-KEY
022500         INVALID KEY    MOVE 17 TO COND-WORD.
           IF WPF-STATUS NOT = "00" MOVE 17 TO COND-WORD.
022600     IF COND-WORD = 17
022700         MOVE "N" TO RETURN-CODE
022800         GO TO 72-CP-EXIT.
           MOVE 0 TO COND-WORD.
022900     READ WO-PLANNED-FILE NEXT INTO WO-PLANNED-DATA
023000         AT END    MOVE 17 TO COND-WORD.
023100     IF COND-WORD = 17
023200         MOVE "N" TO RETURN-CODE
023300         GO TO 72-CP-EXIT.
023400     IF WO-STATUS-P = "FF"
023500         MOVE "N" TO RETURN-CODE
023600         GO TO 72-CP-EXIT.
023700     MOVE "Y" TO RETURN-CODE.
023800 72-CP-EXIT.    EXIT.
023900 73-MOVE-AND-WRITE-OUTPUT.
024000     MOVE LBR-WO-NUM TO SRT-WO.
024100     MOVE LBR-EMPL-NUM TO SRT-CC.
024200     MOVE LBR-EMPL-NAME TO SRT-NM.
024300     MOVE LBR-CRAFT TO SRT-CR.
024400     MOVE LBR-HRS1-99 TO SRT-HR.
024500     MOVE LBR-HRS2-9 TO SRT-MI.
024600     MOVE LBR-SHIFT-1 TO SRT-SF.
024700     MOVE LBR-CST-DOLLR-9 TO SRT-DO.
024800     MOVE LBR-CST-CENTS-9 TO SRT-CT.
024900     MOVE LBR-START-DATE TO SRT-STD.
025000     MOVE LBR-START-TIME TO SRT-STT.
025100     MOVE LBR-COMPL-DATE TO SRT-COD.
025200     MOVE LBR-COMPL-TIME TO SRT-COT.
025300     RELEASE SORT-REC.
025400 7-SORT-INPUT-X.    EXIT.

025500 8-WRITE-OUTPUT.
           PERFORM 8-WO-CONT THRU 8-WO-EXIT.
       8-WO-CONT.
025600     RETURN SORT-FILE AT END GO TO 2-EOJ.
025700     IF LINE-CTR > 59
025800         MOVE HEADER-1 TO PRT-REC
025900         WRITE PRT-REC AFTER ADVANCING 0 LINES
026000         MOVE HEADER-2 TO PRT-REC
026100         WRITE PRT-REC AFTER ADVANCING 1 LINES
026200         MOVE HEADER-3 TO PRT-REC
026300         WRITE PRT-REC AFTER ADVANCING 1 LINES
026400         MOVE 3 TO LINE-CTR.
026500     PERFORM 81-RETRIEVE-SEQ THRU 81-RS-EXIT.
026600     MOVE SRT-WO TO PRT-WO.
026700     MOVE SRT-CC TO PRT-CC.
026800     MOVE SRT-NM TO PRT-NM.
026900     MOVE SRT-CR TO PRT-CR.
027000     MOVE SRT-HR TO PRT-HR.
027100     MOVE SRT-MI TO PRT-MI.
027200     MOVE SRT-SF TO PRT-SF.
027300     MOVE SRT-DO TO PRT-DO.
027400     MOVE SRT-CT TO PRT-CT.
027500     MOVE SRT-STD TO PRT-STD.
027600     MOVE SRT-STT TO PRT-STT.
027700     MOVE SRT-COD TO PRT-COD.
027800     MOVE SRT-COT TO PRT-COT.
027900     MOVE PRINT-LINE TO PRT-REC.
028000     WRITE PRT-REC AFTER ADVANCING 1 LINES.
028100     ADD 1 TO LINE-CTR.
028200     GO TO 8-WO-CONT.
028300 81-RETRIEVE-SEQ.
           MOVE 0 TO COND-WORD.
028400     MOVE SRT-WO TO WONUM OF WLFREC.
028700     START WO-LABOR-FILE KEY IS = EXTERNALLY-DESCRIBED-KEY
028800         INVALID KEY    MOVE 17 TO COND-WORD.
           IF WLF-STATUS NOT = "00" MOVE 17 TO COND-WORD.
028900     IF COND-WORD = 17
029000         MOVE 000 TO PRT-SEQ
029100         GO TO 81-RS-EXIT.
029200     MOVE 0 TO LABOR-SEQ.
029300 81-LOOP-RETRIEVE.
           MOVE 0 TO COND-WORD.
           READ WO-LABOR-FILE NEXT INTO WO-LABOR-DATA
               AT END    MOVE 17 TO COND-WORD.
           IF WLF-STATUS NOT = "00" MOVE 17 TO COND-WORD.
029700     IF COND-WORD = 17
029800         MOVE 000 TO PRT-SEQ
029900         GO TO 81-RS-EXIT.
030000     ADD 1 TO LABOR-SEQ.
030100     IF SRT-CC = LBR-EMPL-NUM
030200         IF SRT-STD = LBR-START-DATE
030300             IF SRT-STT = LBR-START-TIME
030400                 IF SRT-COD = LBR-COMPL-DATE
030500                      IF SRT-COT = LBR-COMPL-TIME
030600                          MOVE LABOR-SEQ TO PRT-SEQ
030700                      ELSE
030800                      GO TO 81-LOOP-RETRIEVE
030900                 ELSE
031000                 GO TO 81-LOOP-RETRIEVE
031100              ELSE
031200             GO TO 81-LOOP-RETRIEVE
031300         ELSE
031400         GO TO 81-LOOP-RETRIEVE
031500     ELSE
031600     GO TO 81-LOOP-RETRIEVE.
031700 81-RS-EXIT.    EXIT.

031800 8-WO-EXIT.    EXIT.
