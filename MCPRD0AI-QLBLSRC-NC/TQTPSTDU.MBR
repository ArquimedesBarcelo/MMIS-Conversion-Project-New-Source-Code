001100 IDENTIFICATION DIVISION.
001200 PROGRAM-ID.     TQTPSTDU.
001300 AUTHOR.         BARBARA WINTER.
001400*INSTALLATION.   GOODYEAR TIRE & RUBBER COMPANY.
001500*DATE-WRITTEN.   SEPTEMBER 1987.
001600*REMARKS.        THIS PROGRAM PRINTS A LISTING OF VENDORS SORTED BY
001700*                CORPORATE CODE OR BY VENDOR CODE THAT HAVE NOT
001800*                RETURNED A QUOTE BID BY THE DATE THE BUYER
001900*                REQUESTED.
002000*
      *C   09/11/96    WL MCINTYRE
      *C   MAKE REVISIONS FOR YEAR 2000 COMPATABILITY
      *C
002100 ENVIRONMENT DIVISION.
002200 CONFIGURATION SECTION.
002300 SOURCE-COMPUTER.    HP-3000.
002400 OBJECT-COMPUTER.    HP-3000.
002500 SPECIAL-NAMES.  C01 IS NEWPAGE.
002700
002800 INPUT-OUTPUT SECTION.
002900 FILE-CONTROL.
            SELECT PRINT-FILE   ASSIGN TO PRINTER-MCPRT.
003200      SELECT SORT-FILE    ASSIGN TO DISK-SORTFILE.
            SELECT DVENDOR-I
              ASSIGN TO DATABASE-MCFLCS0701
              ORGANIZATION IS INDEXED
                 ACCESS MODE IS DYNAMIC
              RECORD KEY IS EXTERNALLY-DESCRIBED-KEY WITH DUPLICATES
              FILE STATUS IS FILE-STATUS.
            SELECT DVENDITM-I
              ASSIGN TO DATABASE-MCFLCS0803
              ORGANIZATION IS INDEXED
                 ACCESS MODE IS DYNAMIC
              RECORD KEY IS EXTERNALLY-DESCRIBED-KEY WITH DUPLICATES
              FILE STATUS IS FILE-STATUS.
003300
003400 DATA DIVISION.
003500 FILE SECTION.
003600 FD  PRINT-FILE RECORD CONTAINS 132 CHARACTERS.
003700 01  PRT-REC                    PIC X(132).
003800
003900 SD  SORT-FILE RECORD CONTAINS 72 CHARACTERS.
004000 01  SORT-REC.
004100      05  SRT-VEN-NAME          PIC X(44).
004200      05  SRT-VEN-CODE          PIC X(10).
004300      05  SRT-QUOTE             PIC 9(6).
004400      05  SRT-ITEMS             PIC 9(4).
            05  SRT-CY-DATE.
                10  SRT-CY-CENT       PIC X(2).
                10  SRT-DATE          PIC X(6).
004600
       FD  DVENDOR-I
           LABEL RECORDS ARE STANDARD.
       01  DVENDOR-REC-I.
           COPY DDS-MCRPCS0700  OF MCFLCS0701.
       FD  DVENDITM-I
           LABEL RECORDS ARE STANDARD.
       01  DVENDITM-REC-I.
           COPY DDS-MCRPCS0800  OF MCFLCS0803.

004700 WORKING-STORAGE SECTION.
       01  FILE-STATUS.
           05  FILE-STATUS-1          PIC X.
           05  FILE-STATUS-2          PIC X.
004800 01  LINE-K                     PIC 99    VALUE 70 COMP.
004900 01  PAGE-K                     PIC 9(3)  VALUE 0  COMP.
005000 01  TODAYS-JULIAN              PIC 9(7).
005100 01  RET-JULIAN                 PIC 9(7).
005200 01  DAYS-LATE                  PIC S9(4) VALUE ZEROES.
005300 01  SAVE-SRT-DATE.
005400     05  SYY                    PIC 99    VALUE ZEROES.
005500     05  SMM                    PIC 99    VALUE ZEROES.
005600     05  SDD                    PIC 99    VALUE ZEROES.
005700 01  SAVE-CURRENT-DATE.
005800     05  CYY                    PIC 99    VALUE ZEROES.
005900     05  CMM                    PIC 99    VALUE ZEROES.
006000     05  CDD                    PIC 99    VALUE ZEROES.
       01  CY-CURRENT-DATE.
           05  CURRENT-CENT           PIC X(2)  VALUE SPACES.
           05  CURRENT-DATE.
               10  CURRENT-YEAR       PIC X(2)  VALUE SPACES.
               10  FILLER             PIC X(4)  VALUE SPACES.
       01  J1-WORK-AREA.
           05  JW1-YEAR               PIC 9(4).
           05  JW1-DAY                PIC 9(3).
       01  J2-WORK-AREA.
           05  JW2-YEAR               PIC 9(4).
           05  JW2-DAY                PIC 9(3).

      *--------- PARAMETERS FOR "JULGREG" ROUTINE.
       01  JULGREG-PARMS.
           05  GREG-DATE.
               10  GREG-CC          PIC X(2).
               10  GREG-YMD.
                   15  GREG-YY      PIC X(2).
                   15  GREG-MM      PIC X(2).
                   15  GREG-DD      PIC X(2).
           05  JULIAN-DATE.
               10  JUL-CC           PIC X(2).
               10  JUL-YY           PIC X(2).
               10  JUL-DDD          PIC X(3).
           05  JULIAN-DATE-9  REDEFINES  JULIAN-DATE.
               10  JUL-CC-9         PIC 9(2).
               10  JUL-YY-9         PIC 9(2).
               10  JUL-DDD-9        PIC 9(3).
           05  DAY-DIGIT            PIC X.
           05  LEAP-YEAR-FLAG       PIC X.

007400*----------  E S C A P E   S E Q U E N C E S
007500 01  COMPRESS-PRINT             PIC X(8).
007600 01  NORMAL-PRINT               PIC X(8).
007700 01  ESC-TEXT-61                PIC X(8).
007800 01  ESC-TEXT-60                PIC X(8).
007900
