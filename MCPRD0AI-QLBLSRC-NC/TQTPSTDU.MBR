       COPY THDPRTA  IN COPYLIB.
       COPY OVRPFDATA IN COPYLIB.
       COPY CCHKOBJ OF COPYLIB.
008500
008600*---------- SPOOL2631
008700 01  SPOOLER-AREA.
008800     03  SPOOL-STAT             PIC S9      VALUE 0      COMP.
008900     03  SPOOL-PRT              PIC S9(2)   VALUE 0      COMP.
009000     03  SPOOL-COPIES           PIC S9(2)   VALUE 1      COMP.
009100     03  SPOOL-PRIOR            PIC S9      VALUE 0      COMP.
009200     03  SPOOL-MSG              PIC X(75)   VALUE SPACES.
009300
009400 01  SPOOL-LIMIT                PIC S9(8)    VALUE 50000  COMP.
009500 01  SPOOL-FEQ-NAME             PIC X(8)     VALUE "SXXXXXXX".
009600
009700 01  MESSAGE-AREA.
009800     05  NO-SORTED-RECORDS      PIC X(33) VALUE
009900                             "ZERO RECORDS QUALIFIED FOR REPORT".
010000
010100 01  SWITCH-AREA.
010200     05  END-OF-INPUT-FILE      PIC X VALUE "N".
010300         88  ALL-INPUT-RECORDS-PROCESSED       VALUE "Y".
010400     05  END-OF-SORT-FILE       PIC X VALUE "N".
010500         88  ALL-SORTED-RECORDS-PROCESSED      VALUE "Y".
010600
011400 01  VEN-ARG                    PIC X(10) VALUE SPACES.
011500 01  NO-ARG                     PIC X(10) VALUE SPACES.
011600 01  QUOTE-ARG.
011700     05  QUOTE-ARG-NUM          PIC X(6)  VALUE SPACES.
011800     05  QUOTE-ARG-NUM9  REDEFINES QUOTE-ARG-NUM
011900                                PIC 9(6).
012000     05  FILLER                 PIC X(4)  VALUE SPACES.
012100 01  COMPARE-QUOTE              PIC X(10) VALUE "??????????".
012200
012300 COPY DATAB     IN COPYLIB.
012500 COPY DVENDOR   IN COPYLIB.
012600 COPY DVENDITM  IN COPYLIB.
012700 COPY VCOMAREA  IN COPYLIB.
012800
012900 01  HDR-1.
013000     05  H1-DATE                PIC X(8).
013100     05  FILLER                 PIC X(5)   VALUE SPACES.
013200     05  H1-TIME                PIC X(8).
013300     05  FILLER                 PIC X(25)  VALUE SPACES.
013400     05  H1-TITLE               PIC X(37).
013500     05  FILLER                 PIC X(17)  VALUE SPACES.
013600     05  H1-PROGRAM             PIC X(16).
013700     05  FILLER                 PIC X(5)   VALUE SPACES.
013800     05  H1-PAGE                PIC X(5).
013900     05  H1-PAGE-NO             PIC ZZZ9  VALUE ZEROES.
014000     05  FILLER                 PIC X(2)  VALUE SPACES.
014100
014200 01  HDR-2.
014300     05  FILLER                 PIC X(53)  VALUE SPACES.
014400     05  H2-TITLE               PIC X(12).
014500     05  H2-SORT                PIC X(11).
014600     05  FILLER                 PIC X(56)  VALUE SPACES.
014700
014800 01  HDR-3.
014900     05  FILLER                 PIC X(7)   VALUE SPACES.
015000     05  H3-VENDOR              PIC X(6).
015100     05  FILLER                 PIC X(25)  VALUE SPACES.
015200     05  H3-NAME                PIC X(6).
015300     05  FILLER                 PIC X(24)  VALUE SPACES.
015400     05  H3-QUOTE               PIC X(5).
015500     05  FILLER                 PIC X(7)   VALUE SPACES.
015600     05  H3-NUMBER-ITEMS        PIC X(9).
015700     05  FILLER                 PIC X(7)   VALUE SPACES.
015800     05  H3-DUE                 PIC X(3).
015900     05  FILLER                 PIC X(9)   VALUE SPACES.
016000     05  H3-NUMBER-DAYS         PIC X(9).
016100
016200 01  HDR-4.
016300     05  FILLER                 PIC X(7)   VALUE SPACES.
016400     05  H4-CODE                PIC X(4).
016500     05  FILLER                 PIC X(27)  VALUE SPACES.
016600     05  H4-NAME                PIC X(4).
016700     05  FILLER                 PIC X(38)  VALUE SPACES.
016800     05  H4-NUMBER-ITEMS        PIC X(11).
016900     05  FILLER                 PIC X(5)   VALUE SPACES.
017000     05  H4-DATE                PIC X(4).
017100     05  FILLER                 PIC X(8)   VALUE SPACES.
017200     05  H4-NUMBER-DAYS         PIC X(9).
017300
017400 01  HDR-6.
017500     05  FILLER                 PIC X(4)   VALUE SPACES.
017600     05  H6-DASH1               PIC X(10).
017700     05  FILLER                 PIC X(5)   VALUE SPACES.
017800     05  H6-DASH2               PIC X(44).
017900     05  FILLER                 PIC X(5)   VALUE SPACES.
018000     05  H6-DASH3               PIC X(6).
018100     05  FILLER                 PIC X(6)   VALUE SPACES.
018200     05  H6-DASH4               PIC X(11).
018300     05  FILLER                 PIC X(3)   VALUE SPACES.
018400     05  H6-DASH5               PIC X(8).
018500     05  FILLER                 PIC X(6)   VALUE SPACES.
018600     05  H6-DASH6               PIC X(9).
018700
018800 01  LINE1.
018900     05  FILLER                 PIC X(4)   VALUE SPACES.
019000     05  L1-CODE                PIC X(10).
019100     05  FILLER                 PIC X(5)   VALUE SPACES.
019200     05  L1-NAME                PIC X(44).
019300     05  FILLER                 PIC X(5)   VALUE SPACES.
019400     05  L1-QUOTE               PIC ZZZZZ9.
019500     05  FILLER                 PIC X(9)   VALUE SPACES.
019600     05  L1-NUMBER-ITEMS        PIC ZZZ9   VALUE ZEROES.
019700     05  FILLER                 PIC X(7)   VALUE SPACES.
019800     05  L1-DUE-DATE            PIC X(8).
019900     05  FILLER                 PIC X(8)   VALUE SPACES.
020000     05  L1-DAYS-LATE           PIC ZZZ9   VALUE ZEROES.
020100     05  FILLER                 PIC X(16)  VALUE SPACES.
020200 LINKAGE SECTION.
008300 COPY THDPRTB  IN COPYLIB.
007000 01  SORT-DATA.
007100     05  DE-KEY                 PIC X.
007200     05  FILLER                 PIC X(79).
020300 PROCEDURE DIVISION USING HD-ROUTE-DATA SORT-DATA.
       BEGINNING SECTION.
020400 BEGIN-SORT.
020500
020600*----------  SET UP PRINTER ESCAPE SEQUENCES
020700     CALL "TESCSEQ" USING ESC-NAME.
020800     MOVE CHAR-1636PI     TO COMPRESS-PRINT.
020900     MOVE CHAR-10PI       TO NORMAL-PRINT.
021000     MOVE TEXT-LENGTH-61 TO ESC-TEXT-61.
021100     MOVE TEXT-LENGTH-60 TO ESC-TEXT-60.
021500
078400*----------  OPEN OUTPUT FILE
           MOVE HD-SPOOLER-NUMBER TO OVRPRTF-TOFILE-NUM.
           MOVE "*YES"       TO OVRPRTF-SHARED.
028100     MOVE HD-NO-OF-COPIES TO OVRPRTF-COPIES.
           MOVE "MCPRT"      TO OVRPRTF-FILE.
           PERFORM 996-OVERRIDE-PRINT-FILE.
021100     OPEN OUTPUT PRINT-FILE.
022200*----------  PRINT HEADER PAGE
022400     MOVE "DHDR74.PUB" TO HD-FILE-NAME.
022500     CALL "THDPRT2" USING HD-RET-CODE, HD-FILE-NAME,
022600        FNUM, HD-ROUTE-DATA, ESC-NAME.
022700     IF PAPER-IS-132-COLS
022800          NEXT SENTENCE
022900     ELSE
023000         WRITE PRT-REC FROM COMPRESS-PRINT AFTER ADVANCING 0
023100         WRITE PRT-REC FROM ESC-TEXT-61 AFTER ADVANCING 0.
023200     IF HD-RET-CODE NOT = 0
023300         DISPLAY "THDRPT ERROR".
023500
023600*----------  SET UP HEADING LITERALS FOR REPORT
023700     MOVE 1 TO DATE-MODE.
023800     CALL "TDATECHK" USING DATE-CHECK-AREA.
023900     MOVE DATE-YMD-OUT                   TO SAVE-CURRENT-DATE.

      *-----  FORMAT DATE WITH CENTURY

           MOVE SAVE-CURRENT-DATE              TO CURRENT-DATE.
           IF CURRENT-YEAR > "70"
              MOVE "19"                        TO CURRENT-CENT
           ELSE
              MOVE "20"                        TO CURRENT-CENT.

024000     MOVE DATE-SLASH-OUT                 TO H1-DATE.
024100     MOVE DATE-FORMATTED-TIME-OUT        TO H1-TIME.
024200     MOVE 4 TO DATE-MODE.
024300     MOVE "---  QUOTES PAST DUE FROM VENDOR  ---"
024400                                         TO H1-TITLE.
024500     MOVE "PROGRAM TQTPSTDU"             TO H1-PROGRAM.
024600     MOVE "PAGE "                        TO H1-PAGE.
024700     MOVE "SORTED BY:  "                 TO H2-TITLE.
024800     IF DE-KEY = "C"
024900        MOVE "VENDOR CODE"               TO H2-SORT
025000     ELSE
025100        IF DE-KEY = "N"
025200           MOVE "VENDOR NAME"            TO H2-SORT
025300        ELSE
025400           MOVE "DUE DATE"               TO H2-SORT.
025500
025600     MOVE "VENDOR"                       TO H3-VENDOR, H3-NAME.
025700     MOVE "QUOTE"                        TO H3-QUOTE.
025800     MOVE "NUMBER OF"                    TO H3-NUMBER-ITEMS,
025900                                            H3-NUMBER-DAYS
026000     MOVE "DUE"                          TO H3-DUE.
026100     MOVE "CODE"                         TO H4-CODE.
026200     MOVE "NAME"                         TO H4-NAME.
026300     MOVE "QUOTE ITEMS"                  TO H4-NUMBER-ITEMS.
026400     MOVE "DATE"                         TO H4-DATE.
026500     MOVE "DAYS LATE"                    TO H4-NUMBER-DAYS.
026600     MOVE ALL "=" TO H6-DASH1, H6-DASH2, H6-DASH3,
026700                     H6-DASH4, H6-DASH5, H6-DASH6.
027300
           OPEN INPUT DVENDOR-I DVENDITM-I.
027400*----------  PROCESS REPORT DATA
027500     IF DE-KEY = "C"
027600     SORT SORT-FILE
027700          ON ASCENDING KEY SRT-VEN-CODE
027800          INPUT  PROCEDURE IS 200-INPUT-RECORDS
027900          OUTPUT PROCEDURE IS 300-WRITE
028000     ELSE
028100     IF DE-KEY = "D"
028200        SORT SORT-FILE
028300             ON ASCENDING KEY SRT-CY-DATE
028400             INPUT  PROCEDURE IS 200-INPUT-RECORDS
028500             OUTPUT PROCEDURE IS 300-WRITE
028600     ELSE
028700     SORT SORT-FILE
028800          ON ASCENDING KEY SRT-VEN-NAME
028900          INPUT  PROCEDURE IS 200-INPUT-RECORDS
029000          OUTPUT PROCEDURE IS 300-WRITE.
029100
029200*----------  PRINT REPORT, CLOSE FILES, AND QUIT
029300     IF PAPER-IS-132-COLS
029400         NEXT SENTENCE
029500     ELSE
029600         WRITE PRT-REC FROM NORMAL-PRINT AFTER ADVANCING 0
029700         WRITE PRT-REC FROM ESC-TEXT-60 AFTER ADVANCING 0.
029800
030300     CLOSE DVENDOR-I DVENDITM-I.
030400     CLOSE PRINT-FILE.
030600     GOBACK.
030700
030800***********************************************************************
030900*       INPUT SECTION:  RETRIEVE VENDOR RECORDS FOR SORTING           *
031000***********************************************************************
031100 200-INPUT-RECORDS SECTION.
       200-INPUT.
           MOVE 0 TO COND-WORD.
           READ DVENDITM-I FIRST INTO BUF-DVENDITM
                AT END MOVE 15 TO COND-WORD.
           IF FILE-STATUS NOT = "00"
              IF FILE-STATUS = "10" OR "14" OR "46"
                 MOVE 15 TO COND-WORD
              ELSE
                 MOVE 99 TO COND-WORD.
031200     PERFORM 210-PROCESS-INPUT-RECORDS THRU 290-EXIT UNTIL
031300             ALL-INPUT-RECORDS-PROCESSED.
031400     GO TO 299-EXIT.
031500
031600 210-PROCESS-INPUT-RECORDS.
031700     MOVE SPACES TO SORT-REC.
032000     IF COND-WORD NOT = 0
032100         MOVE "Y" TO END-OF-INPUT-FILE
032200         GO TO 290-EXIT.
032700
032800     IF VEN-QUOTE-FLAG  NOT = "Q"
032900        GO TO 215-READ.
034400
           IF VEN-QUOTE-NUM = COMPARE-QUOTE
              GO TO 215-READ.

           IF VEN-RETURN-DATE = SPACES
              GO TO 215-READ.

034500     IF VEN-RETURN-DATE-CN < CY-CURRENT-DATE
034600        IF VEN-ACTUAL-DATE-RETURNED  = SPACES
034700           NEXT SENTENCE
034800        ELSE
034900           GO TO 215-READ
035000      ELSE
035100         GO TO 215-READ.
035200
           MOVE VEN-QUOTE-NUM TO COMPARE-QUOTE, QUOTE-ARG.
035300     MOVE VEN-RETURN-DATE-CN TO SRT-CY-DATE.
           IF QUOTE-ARG-NUM = SPACES
              MOVE "000000" TO SRT-QUOTE
           ELSE
035400        MOVE QUOTE-ARG-NUM9 TO SRT-QUOTE.
035500
035600     MOVE VEN-ITM-VENCODE TO VEN-ARG, SRT-VEN-CODE.
           MOVE 0 TO COND-WORD.
           MOVE VEN-ARG TO VENCDE OF DVENDOR-REC-I.
           MOVE "00"    TO VENITMNO OF DVENDOR-REC-I.
           READ DVENDOR-I INTO BUF-DVENDOR
               INVALID KEY MOVE 17 TO COND-WORD.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
                   MOVE 17 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.
035900     IF NOT GOOD-CALL
036000        GO TO 215-READ.
036100
036200     MOVE VEN-NAME TO SRT-VEN-NAME.
036300     RELEASE SORT-REC.

       215-READ.
           MOVE 0 TO COND-WORD.
           READ DVENDITM-I NEXT INTO BUF-DVENDITM
                AT END MOVE 15 TO COND-WORD.
           IF FILE-STATUS NOT = "00"
              IF FILE-STATUS = "10" OR "14" OR "46"
                 MOVE 15 TO COND-WORD
              ELSE
                 MOVE 99 TO COND-WORD.
036400
036500     GO TO 210-PROCESS-INPUT-RECORDS.
038500
038600 290-EXIT.  EXIT.
038700 299-EXIT.  EXIT.
038800
038900***********************************************************************
039000*     OUTPUT SECTION:  WRITE VENDOR RECORDS TO CREATE REPORT          *
039100***********************************************************************
039200 300-WRITE SECTION.
       300-WRITE-RECORDS.
039300     RETURN SORT-FILE AT END
039400         MOVE "Y" TO END-OF-SORT-FILE
039500         PERFORM 940-PRINT-HEADINGS THRU 949-EXIT
039600         MOVE NO-SORTED-RECORDS TO PRT-REC
039700         WRITE PRT-REC AFTER ADVANCING 2 LINES
039800         GO TO 399-EXIT.
039900
040000     PERFORM 310-PROCESS-SORTED-RECORDS THRU 390-EXIT
040100             UNTIL ALL-SORTED-RECORDS-PROCESSED.
040200     GO TO 399-EXIT.
040300
040400 310-PROCESS-SORTED-RECORDS.
040500     IF LINE-K > 60
040600         PERFORM 940-PRINT-HEADINGS THRU 949-EXIT.
040700
040800     MOVE SPACES TO LINE1.
040900
041000     MOVE SRT-VEN-NAME          TO L1-NAME.
041100     MOVE SRT-VEN-CODE          TO L1-CODE.
041200     MOVE SRT-QUOTE             TO L1-QUOTE.
041300*    MOVE SRT-ITEMS             TO L1-NUMBER-ITEMS.
041400     MOVE SRT-DATE              TO DATE-VALIDATE-IN.
041500     CALL "TDATECK2" USING DATE-CHECK-AREA LANGUAGE-PARMS.
041600     MOVE DATE-SLASH-OUT        TO L1-DUE-DATE.
041700
041800*----------  DETERMINE NUMBER OF DAYS LATE BY SUBTRACTING
041900*----------  RETURN DATE FROM CURRENT DATE
           MOVE SPACES                TO JULGREG-PARMS.
           MOVE CY-CURRENT-DATE       TO GREG-DATE.
           CALL "JULGREG"  USING GREG-DATE, JULIAN-DATE,
                                 DAY-DIGIT, LEAP-YEAR-FLAG.
           MOVE JULIAN-DATE           TO TODAYS-JULIAN, J1-WORK-AREA.

           MOVE SPACES                TO JULGREG-PARMS.
           MOVE SRT-CY-DATE           TO GREG-DATE.
           CALL "JULGREG"  USING GREG-DATE, JULIAN-DATE,
                                 DAY-DIGIT, LEAP-YEAR-FLAG.
           MOVE JULIAN-DATE           TO RET-JULIAN, J2-WORK-AREA.
043700
043800     MOVE 0 TO DAYS-LATE.
043900 315-LOOP.
044000     IF JW1-YEAR > JW2-YEAR
044100        ADD 365 TO DAYS-LATE
              ADD 1 TO JW2-YEAR
              GO TO 315-LOOP.
            COMPUTE DAYS-LATE = DAYS-LATE + (JW1-DAY - JW2-DAY).
            MOVE DAYS-LATE TO L1-DAYS-LATE.
044200
044300     ADD 1             TO LINE-K.
044400     MOVE SPACES       TO PRT-REC.
044500     WRITE PRT-REC FROM LINE1 AFTER ADVANCING 1 LINES.
044600
044700     RETURN SORT-FILE AT END
044800         MOVE "Y"                           TO END-OF-SORT-FILE.
044900
045000 390-EXIT.  EXIT.
045100 399-EXIT.  EXIT.
045200
045300 900-MISC SECTION.
045400 940-PRINT-HEADINGS.
045500     ADD 1 TO PAGE-K.
045600     MOVE PAGE-K TO H1-PAGE-NO.
045700     WRITE PRT-REC FROM HDR-1 AFTER ADVANCING NEWPAGE.
045800     WRITE PRT-REC FROM HDR-2 AFTER ADVANCING 1 LINE.
045900     WRITE PRT-REC FROM HDR-3 AFTER ADVANCING 3 LINES.
046000     WRITE PRT-REC FROM HDR-4 AFTER ADVANCING 1 LINE.
046100     WRITE PRT-REC FROM HDR-6 AFTER ADVANCING 1 LINE.
046200     MOVE 8 TO LINE-K.
046300 949-EXIT.  EXIT.
046400 COPY OVRPFCALL IN COPYLIB.
046500*************************************************************
046600*                    BLOWUP   ROUTINE                       *
046700*************************************************************
046800 990-BLOWUP.
046900     WRITE PRT-REC FROM ESC-TEXT-61  AFTER ADVANCING 0.
047000     WRITE PRT-REC FROM NORMAL-PRINT AFTER ADVANCING 0.
047100
047200     MOVE "TQTPSTDU" TO BU-PGM-NAME.
047300     MOVE QUOTE-ARG TO BU-DISPLAY-FLD (1).
047400     MOVE SRT-VEN-CODE TO BU-DISPLAY-FLD (2).
047500     CALL "TBLOWUP" USING BASE, BU-PGM-NAME, STATUS-AREA,
047600           VIEW-COMAREA, FILE-STATUS, BU-DISPLAY-MSG,
047700           BU-DISPLAY-AREA.
047800
047900 999-EXIT.  EXIT.
