000200 IDENTIFICATION DIVISION.
000300 PROGRAM-ID.    TDBCOMP.
000400 AUTHOR.        C.I.HILLES.
000500 DATE-WRITTEN.  APRIL, 1986.
000600*INSTALLATION.        GOODYEAR TIRE AND RUBBER - AKRON.
000700*REMARKS.
000800*
000900*    THIS PROGRAM WILL COMPARE SELECTED DATASETS IN
001000*    2 DATABASE, FOR USE IN TESTING OLD AND NEW VERSIONS
001100*    OF PROGRAMS.
001200 ENVIRONMENT DIVISION.
001300 CONFIGURATION SECTION.
001400 SOURCE-COMPUTER.  HP-3000.
001500 OBJECT-COMPUTER.  HP-3000.
001600 INPUT-OUTPUT SECTION.
001700 FILE-CONTROL.
001800     SELECT PRINT-FILE ASSIGN TO PRINTER-MCPRT.
           SELECT DB-FILE-1 ASSIGN TO DATABASE-THEDB1
             FILE STATUS IS FILE-STATUS.
           SELECT DB-FILE-2 ASSIGN TO DATABASE-THEDB2
             FILE STATUS IS FILE-STATUS.
002000
002100 DATA DIVISION.
002200 FILE SECTION.
002300 FD  PRINT-FILE
002400     LABEL RECORDS ARE OMITTED
002500     RECORD CONTAINS 132 CHARACTERS
002600     DATA RECORD IS PRINT-REC.
002700 01  PRINT-REC.
002800     05  PRINT-LINE             PIC X(132).
002900
       FD  DB-FILE-1
           LABEL RECORDS ARE OMITTED
           RECORD CONTAINS 600 CHARACTERS.
       01  DB-REC-1                   PIC X(600).

       FD  DB-FILE-2
           LABEL RECORDS ARE OMITTED
           RECORD CONTAINS 600 CHARACTERS.
       01  DB-REC-2                   PIC X(600).

003000 WORKING-STORAGE SECTION.
       01  FILE-STATUS.
           05  FILE-STAT-1               PIC X(1).
               88  END-OF-FILE                     VALUE "1".
           05  FILE-STAT-2               PIC X(1).
       01  ANY-KEY                       PIC X(1).
003100 01  WORK-LINE                     PIC X(132).
003200 01  WORK-MATCH                    PIC X(20).
003300 01  SUB                           PIC 9(2).
003400 01  ALL-ITEMS                     PIC X(2)  VALUE "@;".
003500 01  DUMMY-ARG                     PIC X(1)  VALUE SPACES.
003600 01  COMPARE-ERRORS                PIC 9(6)  VALUE ZERO.
003700 01  BIG-BUFF1.
003800     05  BIG-BUFF1-1-79            PIC X(79).
003900     05  FILLER                    PIC X(521).
004000 01  BIG-BUFF1-BYTES REDEFINES BIG-BUFF1.
004100     05  BB1-BYTE OCCURS 600 TIMES PIC X(1).
004200
004300 01  BIG-BUFF2.
004400     05  BIG-BUFF2-1-79            PIC X(79).
004500     05  FILLER                    PIC X(521).
004600 01  BIG-BUFF2-BYTES REDEFINES BIG-BUFF2.
004700     05  BB2-BYTE OCCURS 600 TIMES PIC X(1).
004800
004900 01  BASE1.
005000     05  FILLER                    PIC X(2).
005100     05  BASE1-3-26                PIC X(24).
005200
005300 01  BASE2.
005400     05  FILLER                    PIC X(2).
005500     05  BASE2-3-26                PIC X(24).
005600
005700 01  PASSWORD                      PIC X(2)  VALUE ";".
006100 01  DSET-NUM                      PIC 9(2).
007100 01  DISP-ENTRIES                  PIC Z(8)9.
007200 01  DISP-CAPACITY                 PIC Z(8)9.
007400
007500 01  BUF-DDAILYTC1.
007600     05  FILLER                    PIC X(12).
007700     05  DDAILYTC1-REST            PIC X(68).
007800
007900 01  BUF-DDAILYTC2.
008000     05  FILLER                    PIC X(12).
008100     05  DDAILYTC2-REST            PIC X(68).
008200
       COPY COMMAND IN COPYCSIS.

008300 PROCEDURE DIVISION.
008400 6000-MAIN.
008500     OPEN OUTPUT PRINT-FILE.
009500
009600     MOVE ZERO                     TO  DSET-NUM.
009700     PERFORM 47 TIMES
009800         ADD 1                     TO  DSET-NUM
               MOVE SPACES TO WORK-LINE
               STRING "OVRDBF FILE(THEDB1) TOFILE(MCPRD1/MCFPCS",
                DSET-NUM, "00)" DELIMITED BY SIZE INTO WORK-LINE
               MOVE WORK-LINE TO COMMAND-WORK
               CALL "QCMDEXC" USING COMMAND-WORK, COMMAND-LEN
               OPEN INPUT DB-FILE-1
               IF FILE-STATUS NOT = "00"
                   DISPLAY "ERROR OPENING DB-FILE-1, DSET = ", DSET-NUM
                   PERFORM 990-BLOWUP
               END-IF
               STRING "OVRDBF FILE(THEDB2) TOFILE(MCPRD2/MCFPCS",
                DSET-NUM, "00)" DELIMITED BY SIZE INTO WORK-LINE
               MOVE WORK-LINE TO COMMAND-WORK
               CALL "QCMDEXC" USING COMMAND-WORK, COMMAND-LEN
               OPEN INPUT DB-FILE-2
               IF FILE-STATUS NOT = "00"
                   DISPLAY "ERROR OPENING DB-FILE-2, DSET = ", DSET-NUM
                   PERFORM 990-BLOWUP
               END-IF
               PERFORM 7000-COMPARE THRU 7990-C-X
               CLOSE DB-FILE-1, DB-FILE-2
010800     END-PERFORM.
010900
011000     IF COMPARE-ERRORS = ZERO
011100         DISPLAY "******* T H E Y   M A T C H E D | *******"
011200     ELSE
011300         DISPLAY COMPARE-ERRORS, " ERRORS FOUND|".
011400
011500     CLOSE PRINT-FILE.
011600     STOP RUN.
011700
011800 7000-COMPARE.
011900     MOVE SPACES TO BIG-BUFF1, BIG-BUFF2.
012000     PERFORM 9999-DBGET2-1.
012100     IF END-OF-FILE
012200         PERFORM 9999-DBGET2-2
012300         IF END-OF-FILE
012400             GO TO 7990-C-X
012500         ELSE
012600             PERFORM UNTIL END-OF-FILE
                       MOVE "ENTRY EXISTS IN BASE2 BUT NOT BASE1"
                         TO PRINT-REC
                       WRITE PRINT-REC AFTER ADVANCING 1
                       MOVE BIG-BUFF2 TO PRINT-REC
                       WRITE PRINT-REC AFTER ADVANCING 1
013000                 PERFORM 9999-DBGET2-2
013100                 ADD 1             TO  COMPARE-ERRORS
013200             END-PERFORM
013300             GO TO 7990-C-X.
013400
013500     PERFORM 9999-DBGET2-2.
013600     IF END-OF-FILE
               MOVE SPACES TO FILE-STATUS
013800         PERFORM UNTIL END-OF-FILE
                   MOVE "ENTRY EXISTS IN BASE1 BUT NOT BASE2"
                     TO PRINT-REC
                   WRITE PRINT-REC AFTER ADVANCING 1
                   MOVE BIG-BUFF1 TO PRINT-REC
                   WRITE PRINT-REC AFTER ADVANCING 1
014200             PERFORM 9999-DBGET2-1
014300             ADD 1                 TO  COMPARE-ERRORS
014400         END-PERFORM
014500         GO TO 7990-C-X.
014600
014700     IF DSET-NUM = 16
014800         MOVE BIG-BUFF1            TO  BUF-DDAILYTC1
014900         MOVE BIG-BUFF2            TO  BUF-DDAILYTC2
015000         IF DDAILYTC1-REST NOT = DDAILYTC2-REST
                   MOVE SPACES TO WORK-LINE
                   STRING "* NON MATCH FOR DSET ", DSET-NUM, " *"
                     DELIMITED BY SIZE INTO WORK-LINE
                   MOVE WORK-LINE TO PRINT-REC
                   WRITE PRINT-REC AFTER ADVANCING 1
015400             MOVE BIG-BUFF1        TO  PRINT-REC
015500             WRITE PRINT-REC AFTER ADVANCING 1
015600             MOVE BIG-BUFF2        TO  PRINT-REC
015700             WRITE PRINT-REC AFTER ADVANCING 1
015800             ADD 1                 TO  COMPARE-ERRORS
015900             MOVE ZERO TO SUB
016000*            PERFORM 80 TIMES
016100*                ADD 1 TO SUB
016200*                MOVE SPACES       TO  WORK-LINE, WORK-MATCH
016300*                IF BB1-BYTE (SUB) = BB2-BYTE (SUB)
016400*                    MOVE "THEY MATCHED" TO WORK-MATCH
016500*                ELSE
016600*                    MOVE "THEY DIDN'T MATCH|" TO WORK-MATCH
016700*                END-IF
016800*                STRING "DDAILYTC1-BYTE (", SUB,
016900*                  ") = ", BB1-BYTE (SUB), "     ",
017000*                  "DDAILYTC2-BYTE (", SUB, ") = ",
017100*                  BB2-BYTE (SUB), "  ", WORK-MATCH
017200*                    DELIMITED BY SIZE INTO WORK-LINE
017300*                WRITE PRINT-REC FROM WORK-LINE AFTER ADVANCING 1
017400*            END-PERFORM
017500         END-IF
017600     ELSE
017700         IF BIG-BUFF1 NOT = BIG-BUFF2
                   MOVE SPACES TO WORK-LINE
                   STRING "* NON MATCH FOR DSET ", DSET-NUM, " *"
                     DELIMITED BY SIZE INTO WORK-LINE
                   MOVE WORK-LINE TO PRINT-REC
                   WRITE PRINT-REC AFTER ADVANCING 1
015400             MOVE BIG-BUFF1        TO  PRINT-REC
015500             WRITE PRINT-REC AFTER ADVANCING 1
015600             MOVE BIG-BUFF2        TO  PRINT-REC
015700             WRITE PRINT-REC AFTER ADVANCING 1
018100             ADD 1                 TO  COMPARE-ERRORS.
018200
018300     GO TO 7000-COMPARE.
018400
018500 7990-C-X.
018600     EXIT.
018700
019200 990-BLOWUP.
019300     DISPLAY "********BLOWUP**********".
019400     DISPLAY "FILE-STATUS = ", FILE-STATUS.
           DISPLAY "DSET = ", DSET-NUM.
           DISPLAY "HIT RETURN TO CONTINUE".
           ACCEPT ANY-KEY.
019600     STOP RUN.
019700
019800 9999-DBGET2-1.
           READ DB-FILE-1 INTO BIG-BUFF1 AT END
             MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STAT-1 = "1"
               NEXT SENTENCE
           ELSE
           IF FILE-STAT-1 NOT = "0"
               DISPLAY "ERROR READING DB-FILE-1 INTO BIG-BUFF1"
               PERFORM 990-BLOWUP.
020500
020600 9999-DBGET2-2.
           READ DB-FILE-2 INTO BIG-BUFF2 AT END
             MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STAT-1 = "1"
               NEXT SENTENCE
           ELSE
           IF FILE-STAT-1 NOT = "0"
               DISPLAY "ERROR READING DB-FILE-2 INTO BIG-BUFF2"
               PERFORM 990-BLOWUP.
020500
