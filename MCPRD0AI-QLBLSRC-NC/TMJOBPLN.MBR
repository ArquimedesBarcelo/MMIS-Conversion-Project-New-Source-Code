000200 IDENTIFICATION DIVISION.
000300 PROGRAM-ID.    TMJOBPLN.
000600 ENVIRONMENT DIVISION.
000700 CONFIGURATION SECTION.
000800 SOURCE-COMPUTER.   AS400.
000900 OBJECT-COMPUTER.   AS400.
       SPECIAL-NAMES. I-O-FEEDBACK IS I-O-FEEDBACK-AREA
                      LOCAL-DATA IS LOCAL-DATA-AREA.
001000 INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT DISPLAY-FILE
               ASSIGN TO WORKSTATION-ZSUFFIX-SI
               ORGANIZATION IS TRANSACTION
               ACCESS IS SEQUENTIAL
               FILE STATUS IS DSPLY-STATUS
               CONTROL-AREA IS WS-CONTROL.
           SELECT JOBPLAN-BANK
               ASSIGN TO DATABASE-MCFLMM3601
               ORGANIZATION IS INDEXED
               ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                   WITH DUPLICATES
               FILE STATUS IS JB-STATUS.
           SELECT MASTER-JOBPLAN
               ASSIGN TO DATABASE-MCFLMM3501
               ORGANIZATION IS INDEXED
               ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
               FILE STATUS IS MJ-STATUS.
           SELECT PERSONNEL-FILE
               ASSIGN TO DATABASE-MCFLMM0301
               ORGANIZATION IS INDEXED
               ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
               FILE STATUS IS PF-STATUS.
001200 DATA DIVISION.
       FILE SECTION.
       FD  DISPLAY-FILE
           LABEL RECORDS ARE OMITTED.
       01  DSPLY-REC                   PIC X(2000).
       FD  JOBPLAN-BANK
           LABEL RECORDS ARE STANDARD
           DATA RECORD JBREC.
       01  JBREC.
           COPY DDS-ALL-FORMATS OF MCFLMM3601.
       FD  MASTER-JOBPLAN
           LABEL RECORDS ARE STANDARD
           DATA RECORD IS MJREC.
       01  MJREC.
           COPY DDS-ALL-FORMATS OF MCFLMM3501.
       FD  PERSONNEL-FILE
           LABEL RECORDS ARE STANDARD
           DATA RECORD IS PFREC.
       01  PFREC.
           COPY DDS-ALL-FORMATS OF MCFLMM0301.
001300 WORKING-STORAGE SECTION.
001400
       01  BLOWUP-BASE             PIC X(16).

001700 01  CHECK-SEQ               PIC 999.

       COPY CATREAD OF COPYLIB.
       COPY CPYIND  OF COPYLIB.
004300
004400 COPY TDATESUB OF COPYLIB.
004500
004800 01  FORM-NAMES.
004900     05 MAIN                 PIC X(15) VALUE "FSUFHELP".
005000     05 PREFIX0              PIC X(15) VALUE "FSUFGEN".
005100     05 PREFIX1              PIC X(15) VALUE "FSUFADD".
005200     05 PREFIX2              PIC X(15) VALUE "FSUFAPP".
005300     05 PREFIX3              PIC X(15) VALUE "FSUFBRW".
005400     05 PREFIX4              PIC X(15) VALUE "FSUFMOD".
005500     05 PREFIX5              PIC X(15) VALUE "FSUFDEL".
005600     05 PREFIX6              PIC X(15) VALUE "FSUFREN".
005700     05 PREFIX7              PIC X(15) VALUE "FSUFMOV".
005800
       01  FILE-STATUSES.
           05  DSPLY-STATUS        PIC XX.
           05  JB-STATUS           PIC XX.
           05  MJ-STATUS           PIC XX.
           05  PF-STATUS           PIC XX.
006000
       COPY IOFEEDBACK OF COPYLIB.

       01  JOBPLAN-BUFFER.
         COPY DJOBBANK OF COPYLIB.

006100 01  JOBPLAN-KEY.
006200     05 JOBP-WO-NO           PIC X(10).
006300     05 JOBP-SEQ-NO          PIC 999.
006400     05 FILLER               PIC X.
006500
       COPY LANGSUB OF COPYLIB.

011700 01 MASTER-JOBPLAN-DATA.  COPY MMASTJOB OF COPYLIB.

007200 01  MC-BYTE                 PIC X.
007300
007000 01  MISC-BUFFER.
           05  MISC-MSG1.
               10  FILLER          PIC X(18).
               10  MISC-SEQ        PIC 9(4).
               10  FILLER          PIC X(58).
           05  MISC-MSG2 REDEFINES MISC-MSG1.
               10  FILLER          PIC X(17).
               10  ERR-SEQ2        PIC X(4).
               10  FILLER          PIC X(51).
               10  ERR-SEQ3        PIC X(4).
               10  FILLER          PIC X(4).
007100
       01  MPLAN-DATA.
           05  MPLAN-NAME          PIC X(10).
           05  MPLAN-TITLE         PIC X(30).
           05  MPLAN-ORIG          PIC X(4).
           05  MPLAN-CMD-LINE      PIC X(79).
           05  MPLAN-ERR-LINE      PIC X(79).

007400 01  PASSWORD-INFORMATION.
007500     05  NAME-OF-PROGRAM     PIC X(08) VALUE "TMJOBPLN".
007600     05  PROGRAM-TYPE        PIC X(02) VALUE "UP".
007700     05  PROGRAM-RELEASE     PIC X(12) VALUE " E0100010001".
007800     05  PROGRAM-DESCRIPTION.
007900         10  PROG-DESC-A     PIC X(60) VALUE
008000             " GENERIC WORK ORDER JOBPLAN MAINTENANCE  "         .
008100         10  PROG-DESC-B     PIC X(60) VALUE
008200             " ADD AND MODIFY JOBPLANS  "                        .
008300         10  PROG-FUNCTION   PIC X(60) VALUE SPACES.
008500     05  PASSWORD-FLAG       PIC X.
008600
008700 01  REREAD                  PIC X.
008800
008900 01  RETURN-SWITCH           PIC X VALUE "N".
009000
009100 COPY DBSTAT OF COPYLIB.
009200
009300 01  SCREEN-DATA.
009400     05  SCREEN-JNAME        PIC X(10).
009500     05  SCREEN-TITLE        PIC X(30).
009600     05  SCREEN-ORIG         PIC X(4).
009700     05  SCREEN-LAST-SEQ     PIC X(3).
009800
009900     05  SCREEN-SEQ1         PIC X(3).
010000     05  SCREEN-M-C          PIC X.
010100     05  SCREEN-SEQ2         PIC X(3).
010200     05  SCREEN-SEQ3         PIC X(3).
           05  SCREEN-CMD-LINE     PIC X(79).
           05  SCREEN-ERR-LINE     PIC X(79).
010300
010600 01  SEQ2                    PIC 999.
010700
010800 01  SEQ3                    PIC 999.
010900
011000 01  SCREEN-NAME             PIC X(16).

       COPY TBLOWUP   OF COPYLIB.

       01  TRUE-VAL                PIC 1 VALUE B"1".

       COPY WSCONTROL OF COPYLIB.

       01  WORK-SEQ-3.
           05  WS OCCURS 3         PIC X.

011200 LINKAGE SECTION.
011400 01  DBPARAMETERS.           COPY DBPARMS OF COPYLIB.
011500 COPY VCOMLINK OF COPYLIB.
006400 01  READ-BUFFER.
           05  READ-ITEM-1         PIC X(10).
           05  READ-ITEM-2         PIC X(10).
           05  READ-ITEM-3         PIC X(10).
           05  READ-ITEM-4         PIC X(10).
           05  READ-ITEM-5         PIC X(10).
           05  READ-ITEM-6         PIC X(10).
           05  READ-CMD-LINE       PIC X(79).
           05  READ-ERR-LINE       PIC X(79).
011800
012000 PROCEDURE DIVISION USING    DBPARAMETERS
012100                             VIEW-COMAREA
012400                             READ-BUFFER.
012500 START-PROGRAM.
012600     PERFORM 1-HSK.
012700     PERFORM 6-MAIN-ROUTINE THRU 6-MAIN-CONT
012800         UNTIL RETURN-SWITCH = "Y".

012900 2-EOJ.
           CLOSE DISPLAY-FILE.
           CLOSE JOBPLAN-BANK.
           CLOSE MASTER-JOBPLAN.
           CLOSE PERSONNEL-FILE.
013100     GOBACK.
013200
013400 1-HSK.
           OPEN I-O   DISPLAY-FILE.
           OPEN I-O   JOBPLAN-BANK.
           OPEN I-O   MASTER-JOBPLAN.
           OPEN INPUT PERSONNEL-FILE.
013500     CALL "TPWORD" USING PASSWORD-INFORMATION.
013900     IF PASSWORD-FLAG = "N" GO TO 2-EOJ.
014100     MOVE SPACES TO SCREEN-DATA.
014200
014400 6-MAIN-ROUTINE.
           MOVE 0 TO COND-WORD.
           MOVE READ-ITEM-1 TO MJOBPLAN-NAME.
           PERFORM 69-START-MASTER-JOBPLAN.
           IF COND-WORD = 17
               MOVE SPACES TO MPLAN-DATA MASTER-JOBPLAN-DATA
               MOVE READ-ITEM-1 TO MPLAN-NAME MJOBPLAN-NAME
           ELSE
           PERFORM 69-READ-MASTER-JOBPLAN
           IF COND-WORD = 15
               GO TO 2-EOJ
           ELSE
015000     MOVE MJOBPLAN-NAME TO SCREEN-JNAME
015100     MOVE MJOBPLAN-TITLE TO SCREEN-TITLE
015200     MOVE MJOBPLAN-ORIG TO SCREEN-ORIG
015300     MOVE MJOBPLAN-LASTSEQ TO SCREEN-LAST-SEQ
           GO TO 6-MAIN-CONT.
       6-MAIN-ROUTINE-CONT.
           MOVE "FMJOBPL9" TO VIEW-CFNAME.
           MOVE MPLAN-DATA TO DSPLY-REC.
           PERFORM 99-SCREEN-WRITE.
           PERFORM 98-SCREEN-READ.
           IF VIEW-LASTKEY = 3 GO TO 2-EOJ.
           MOVE DSPLY-REC TO MPLAN-DATA.
           MOVE 0 TO COND-WORD.
           MOVE MPLAN-ORIG TO PERCCNUM OF PFREC.
           START PERSONNEL-FILE KEY IS = EXTERNALLY-DESCRIBED-KEY
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF PF-STATUS NOT = "00" MOVE 17 TO COND-WORD.
           IF COND-WORD = 17
               MOVE 35047 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MISC-BUFFER TO MPLAN-ERR-LINE
               MOVE TRUE-VAL TO INDS (3) INDS (99)
               GO TO 6-MAIN-ROUTINE-CONT.
           MOVE MPLAN-NAME TO SCREEN-JNAME MJOBPLAN-NAME.
           MOVE MPLAN-TITLE TO SCREEN-TITLE MJOBPLAN-TITLE.
           MOVE MPLAN-ORIG TO SCREEN-ORIG MJOBPLAN-ORIG.
           MOVE 0 TO SCREEN-LAST-SEQ MJOBPLAN-LASTSEQ.
           WRITE MJREC FROM MASTER-JOBPLAN-DATA
               INVALID KEY    GO TO 2-EOJ.
       6-MAIN-CONT.
016200     MOVE "FMJOBPL1" TO VIEW-CFNAME.
           IF INDS (99) = TRUE-VAL
               MOVE SCREEN-DATA TO DSPLY-REC
           ELSE
           MOVE SPACES TO SCREEN-ERR-LINE MISC-BUFFER SCREEN-SEQ1
           MOVE SCREEN-DATA TO DSPLY-REC.
           PERFORM 99-SCREEN-WRITE.
018100     PERFORM 98-SCREEN-READ.
019200     IF VIEW-LASTKEY = 3 GO TO 2-EOJ.
019400     IF VIEW-LASTKEY = 0
019500         CALL "TSUFHELP"  USING VIEW-COMAREA
                                      FORM-NAMES
019700         MOVE 0 TO VIEW-LASTKEY
020000         GO TO 6-MAIN-CONT.
022500     MOVE DSPLY-REC TO SCREEN-DATA.
023000     MOVE "N" TO REREAD.
           IF SCREEN-SEQ1 = "   "
              NEXT SENTENCE
           ELSE
           MOVE SCREEN-SEQ1 TO WORK-SEQ-3
           PERFORM 60-RIGHT-ADJUST-SEQ THRU 60-RAS-EXIT
           MOVE WORK-SEQ-3 TO SCREEN-SEQ1.
023200     IF VIEW-LASTKEY = 1
023300         PERFORM    61-ADD-SEQUENCE    THRU 61-ADD-EXIT
023400     ELSE
023500     IF VIEW-LASTKEY = 2
023600         PERFORM    62-APPEND-SEQUENCE THRU 62-APPEND-EXIT
023700     ELSE
023800     IF VIEW-LASTKEY = 4
023900         PERFORM    64-BROWSE-JOBPLAN  THRU 64-BROWSE-EXIT
024000     ELSE
024100     IF VIEW-LASTKEY = 5
024200         PERFORM    65-MODIFY-SEQUENCE THRU 65-MODIFY-EXIT
024300     ELSE
024400     IF VIEW-LASTKEY = 6
024500         PERFORM    66-DELETE-SEQUENCE THRU 66-DELETE-EXIT
024600     ELSE
024700     IF VIEW-LASTKEY = 7
024800         PERFORM    67-NUMBER-SEQUENCE THRU 67-NUMBER-EXIT
024900     ELSE
025000     IF VIEW-LASTKEY = 8
025100         PERFORM    68-MOVCOP-SEQUENCE THRU 68-MOVCOP-EXIT.
025200
025300     IF REREAD = "Y" GO TO 6-MAIN-CONT.
025500
       60-RIGHT-ADJUST-SEQ.
           IF WS (3) = " "
               IF WS (2) = " "
                   IF WS (1) = " "
                       MOVE "0" TO WS (1) WS (2) WS (3)
                   ELSE
                   MOVE WS (1) TO WS (3)
                   MOVE "0" TO WS (1) WS (2)
               ELSE
               MOVE WS (2) TO WS (3)
               MOVE WS (1) TO WS (2)
               MOVE "0" TO WS (1)
           ELSE
           IF WS (2) = " "
               IF WS (1) = " "
                   MOVE "0" TO WS (1) WS (2)
               ELSE
               MOVE "0" TO WS (2).

       60-RAS-EXIT.    EXIT.

025700 61-ADD-SEQUENCE.
           PERFORM 69-START-MASTER-JOBPLAN.
           IF COND-WORD = 17 GO TO 61-ADD-EXIT.
           PERFORM 69-READ-MASTER-JOBPLAN.
           IF COND-WORD = 15 GO TO 61-ADD-EXIT.
026900     IF SCREEN-SEQ1 NUMERIC
027000         MOVE SCREEN-SEQ1 TO CHECK-SEQ
027100     ELSE
027200     MOVE MJOBPLAN-LASTSEQ TO CHECK-SEQ
027300     ADD 1 TO CHECK-SEQ.
027400     IF CHECK-SEQ > 0 AND CHECK-SEQ > MJOBPLAN-LASTSEQ
027500                      AND CHECK-SEQ < 999
027600         MOVE CHECK-SEQ TO MJOBPLAN-LASTSEQ
               PERFORM 69-REWRITE-MASTER-JOBPLAN
               IF COND-WORD = 17
                   PERFORM 998-BLOWUP
               ELSE
               NEXT SENTENCE
028400     ELSE
028500     MOVE 35066 TO CATREAD-MSG-NUMBER
028700     PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
           MOVE MISC-BUFFER TO SCREEN-ERR-LINE
028800     MOVE TRUE-VAL TO INDS (26) INDS (99)
029000     MOVE "Y" TO REREAD
029200     GO TO 61-ADD-EXIT.
029800     MOVE SPACES          TO JOBPLAN-KEY.
029900     MOVE MJOBPLAN-NAME   TO JOBP-WO-NO.
030000     MOVE CHECK-SEQ       TO JOBP-SEQ-NO.
031400     CALL "TJADDSEQ" USING DBPARAMETERS   VIEW-COMAREA
031500                           LANGUAGE-PARMS MASTER-JOBPLAN-DATA
031600                           JOBPLAN-KEY.
032100
032200 61-ADD-EXIT.    EXIT.
032400
032600 62-APPEND-SEQUENCE.
           PERFORM 69-START-MASTER-JOBPLAN.
           IF COND-WORD = 17 GO TO 62-APPEND-EXIT.
           PERFORM 69-READ-MASTER-JOBPLAN.
           IF COND-WORD = 15 GO TO 62-APPEND-EXIT.
033700     IF SCREEN-SEQ1 NUMERIC
033800          MOVE SCREEN-SEQ1 TO CHECK-SEQ
033900     ELSE
034000     MOVE 35066 TO CATREAD-MSG-NUMBER
034200     PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
           MOVE MISC-BUFFER TO SCREEN-ERR-LINE
034300     MOVE TRUE-VAL TO INDS (26) INDS (99)
034500     MOVE "Y" TO REREAD
034600     GO TO 62-APPEND-EXIT.
034800     IF CHECK-SEQ > MJOBPLAN-LASTSEQ OR CHECK-SEQ < 1
034900         MOVE 45031 TO CATREAD-MSG-NUMBER
035100         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MISC-BUFFER TO SCREEN-ERR-LINE
035200         MOVE TRUE-VAL TO INDS (26) INDS (99)
035400         MOVE "Y" TO REREAD
035500         GO TO 62-APPEND-EXIT.
035900     MOVE SPACES          TO JOBPLAN-KEY.
036000     MOVE CHECK-SEQ TO MJOBPLAN-LASTSEQ.
029900     MOVE MJOBPLAN-NAME   TO JOBP-WO-NO.
030000     MOVE CHECK-SEQ       TO JOBP-SEQ-NO.
037700     CALL "TJADDSEQ" USING DBPARAMETERS   VIEW-COMAREA
037800                           LANGUAGE-PARMS MASTER-JOBPLAN-DATA
037900                           JOBPLAN-KEY.
038400
038500 62-APPEND-EXIT.    EXIT.
038700
038900 64-BROWSE-JOBPLAN.
           PERFORM 69-START-MASTER-JOBPLAN.
           IF COND-WORD = 17 GO TO 64-BROWSE-EXIT.
           PERFORM 69-READ-MASTER-JOBPLAN.
           IF COND-WORD = 15 GO TO 64-BROWSE-EXIT.
040000     IF SCREEN-SEQ1 NUMERIC
040100         MOVE SCREEN-SEQ1 TO CHECK-SEQ
040200         IF CHECK-SEQ > MJOBPLAN-LASTSEQ
040300             MOVE 45031 TO CATREAD-MSG-NUMBER
040500             PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE MISC-BUFFER TO SCREEN-ERR-LINE
040600             MOVE TRUE-VAL TO INDS (26) INDS (99)
040800             MOVE "Y" TO REREAD
040900             GO TO 64-BROWSE-EXIT.
041100     IF SCREEN-SEQ1 NUMERIC
041200         MOVE CHECK-SEQ TO SEQ2 SEQ3
041300         MOVE "FMJOBPL5" TO SCREEN-NAME
041400     ELSE
041500     MOVE "FMJOBPL4" TO SCREEN-NAME
041600     MOVE 1 TO SEQ2
041700     MOVE MJOBPLAN-LASTSEQ TO SEQ3.
041900     MOVE SPACES TO JOBPLAN-KEY.
029900     MOVE MJOBPLAN-NAME   TO JOBP-WO-NO.
030000     MOVE CHECK-SEQ       TO JOBP-SEQ-NO.
042200     CALL "TJBRWSEQ" USING DBPARAMETERS   VIEW-COMAREA
042300                           LANGUAGE-PARMS MASTER-JOBPLAN-DATA
042400                           JOBPLAN-KEY    SEQ2
042500                           SEQ3           SCREEN-NAME.
042800
042900 64-BROWSE-EXIT.    EXIT.
043100
043300 65-MODIFY-SEQUENCE.
           PERFORM 69-START-MASTER-JOBPLAN.
           IF COND-WORD = 17 GO TO 65-MODIFY-EXIT.
           PERFORM 69-READ-MASTER-JOBPLAN.
           IF COND-WORD = 15 GO TO 65-MODIFY-EXIT.
044400     IF SCREEN-SEQ1 NUMERIC
044500         MOVE SCREEN-SEQ1 TO CHECK-SEQ
044600     ELSE
044700     MOVE 35066 TO CATREAD-MSG-NUMBER
044900     PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
           MOVE MISC-BUFFER TO SCREEN-ERR-LINE
045000     MOVE TRUE-VAL TO INDS (26) INDS (99)
045200     MOVE "Y" TO REREAD
045300     GO TO 65-MODIFY-EXIT.
045400
045500     IF CHECK-SEQ > MJOBPLAN-LASTSEQ
045600         MOVE 45031 TO CATREAD-MSG-NUMBER
045800         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MISC-BUFFER TO SCREEN-ERR-LINE
045900         MOVE TRUE-VAL TO INDS (26) INDS (99)
046100         MOVE "Y" TO REREAD
046200         GO TO 65-MODIFY-EXIT.
046600     MOVE SPACES          TO JOBPLAN-KEY.
029900     MOVE MJOBPLAN-NAME   TO JOBP-WO-NO.
030000     MOVE CHECK-SEQ       TO JOBP-SEQ-NO.
046700     MOVE CHECK-SEQ TO MJOBPLAN-LASTSEQ.
048300     CALL "TJMODSEQ" USING DBPARAMETERS   VIEW-COMAREA
048400                           LANGUAGE-PARMS MASTER-JOBPLAN-DATA
048500                           JOBPLAN-KEY.
049000
049100 65-MODIFY-EXIT.    EXIT.
049300
049500 66-DELETE-SEQUENCE.
           PERFORM 69-START-MASTER-JOBPLAN.
           IF COND-WORD = 17 GO TO 66-DELETE-EXIT.
           PERFORM 69-READ-MASTER-JOBPLAN.
           IF COND-WORD = 15 GO TO 66-DELETE-EXIT.
050600     IF SCREEN-SEQ1 NUMERIC
050700         MOVE SCREEN-SEQ1 TO CHECK-SEQ
050800     ELSE
050900     MOVE 35066 TO CATREAD-MSG-NUMBER
051100     PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
           MOVE MISC-BUFFER TO SCREEN-ERR-LINE
051200     MOVE TRUE-VAL TO INDS (26) INDS (99)
051400     MOVE "Y" TO REREAD
051500     GO TO 66-DELETE-EXIT.
051600
051700     IF CHECK-SEQ > MJOBPLAN-LASTSEQ
051800         MOVE 45031 TO CATREAD-MSG-NUMBER
052000         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MISC-BUFFER TO SCREEN-ERR-LINE
052100         MOVE TRUE-VAL TO INDS (26) INDS (99)
052300         MOVE "Y" TO REREAD
052400         GO TO 66-DELETE-EXIT.
052500
052800     MOVE SPACES          TO JOBPLAN-KEY.
029900     MOVE MJOBPLAN-NAME   TO JOBP-WO-NO.
030000     MOVE CHECK-SEQ       TO JOBP-SEQ-NO.
052900     MOVE CHECK-SEQ TO MJOBPLAN-LASTSEQ.
054500     CALL "TJDELSEQ" USING DBPARAMETERS   VIEW-COMAREA
054600                           LANGUAGE-PARMS JOBPLAN-KEY
                                 MASTER-JOBPLAN-DATA.
           MOVE "FMJOBPL1" TO VIEW-CFNAME.
           MOVE 66240 TO CATREAD-MSG-NUMBER.
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
           MOVE MJOBPLAN-LASTSEQ TO MISC-SEQ.
           MOVE MISC-BUFFER TO SCREEN-CMD-LINE.
           MOVE TRUE-VAL TO INDS (98).
           MOVE SCREEN-DATA TO DSPLY-REC.
           PERFORM 99-SCREEN-WRITE.
           PERFORM 98A-SCREEN-READ.
           CALL "CLPAUSE2".
           MOVE SPACES TO SCREEN-CMD-LINE MISC-BUFFER.
055100
055200 66-DELETE-EXIT.    EXIT.
055400
055600 67-NUMBER-SEQUENCE.
           PERFORM 69-START-MASTER-JOBPLAN.
           IF COND-WORD = 17 GO TO 67-NUMBER-EXIT.
           PERFORM 69-READ-MASTER-JOBPLAN.
           IF COND-WORD = 15 GO TO 67-NUMBER-EXIT.
056700     IF SCREEN-SEQ1 NUMERIC
056800         MOVE SCREEN-SEQ1 TO CHECK-SEQ
056900     ELSE
057000     MOVE 35066 TO CATREAD-MSG-NUMBER
057200     PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
           MOVE MISC-BUFFER TO SCREEN-ERR-LINE
057300     MOVE TRUE-VAL TO INDS (26) INDS (99)
057500     MOVE "Y" TO REREAD
057600     GO TO 67-NUMBER-EXIT.
057800     IF CHECK-SEQ > MJOBPLAN-LASTSEQ
057900         MOVE 45031 TO CATREAD-MSG-NUMBER
058100         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MISC-BUFFER TO SCREEN-ERR-LINE
058200         MOVE TRUE-VAL TO INDS (26) INDS (99)
058400         MOVE "Y" TO REREAD
058500         GO TO 67-NUMBER-EXIT.
058900     MOVE SPACES          TO JOBPLAN-KEY.
029900     MOVE MJOBPLAN-NAME   TO JOBP-WO-NO.
030000     MOVE CHECK-SEQ       TO JOBP-SEQ-NO.
059000     MOVE CHECK-SEQ TO MJOBPLAN-LASTSEQ.
060600     CALL "TJNUMSEQ" USING DBPARAMETERS   VIEW-COMAREA
060700                           LANGUAGE-PARMS JOBPLAN-KEY.
           MOVE 66239 TO CATREAD-MSG-NUMBER.
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
           MOVE MJOBPLAN-LASTSEQ TO MISC-SEQ.
           MOVE MISC-BUFFER TO SCREEN-CMD-LINE.
           MOVE TRUE-VAL TO INDS (98).
           MOVE SCREEN-DATA TO DSPLY-REC.
           PERFORM 99-SCREEN-WRITE.
           PERFORM 98A-SCREEN-READ.
           CALL "CLPAUSE2".
           MOVE SPACES TO SCREEN-CMD-LINE MISC-BUFFER.
061200
061300 67-NUMBER-EXIT.    EXIT.
061500
061700 68-MOVCOP-SEQUENCE.
061800     IF SCREEN-M-C = "M" OR "C"
061900         MOVE SCREEN-M-C TO MC-BYTE
062000     ELSE
062100     MOVE 31014 TO CATREAD-MSG-NUMBER
062300     PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
           MOVE MISC-BUFFER TO SCREEN-ERR-LINE
062400     MOVE TRUE-VAL TO INDS (36) INDS (99)
062600     MOVE "Y" TO REREAD
062700     GO TO 68-MOVCOP-EXIT.

           MOVE SCREEN-SEQ2 TO WORK-SEQ-3.
           PERFORM 60-RIGHT-ADJUST-SEQ THRU 60-RAS-EXIT.
           MOVE WORK-SEQ-3 TO SCREEN-SEQ2.
062800
062900     IF SCREEN-SEQ2 NUMERIC
063000         MOVE SCREEN-SEQ2 TO CHECK-SEQ
063100     ELSE
063200     MOVE 35066 TO CATREAD-MSG-NUMBER
063400     PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
           MOVE MISC-BUFFER TO SCREEN-ERR-LINE
063500     MOVE TRUE-VAL TO INDS (27) INDS (99)
063700     MOVE "Y" TO REREAD
063800     GO TO 68-MOVCOP-EXIT.
063900
064000     IF CHECK-SEQ > 0 AND CHECK-SEQ < 999
064100         NEXT SENTENCE
064200     ELSE
064300     MOVE 45031 TO CATREAD-MSG-NUMBER
064500     PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
           MOVE MISC-BUFFER TO SCREEN-ERR-LINE
064600     MOVE TRUE-VAL TO INDS (27) INDS (99)
064800     MOVE "Y" TO REREAD
064900     GO TO 68-MOVCOP-EXIT.
065000
           MOVE SCREEN-SEQ3 TO WORK-SEQ-3.
           PERFORM 60-RIGHT-ADJUST-SEQ THRU 60-RAS-EXIT.
           MOVE WORK-SEQ-3 TO SCREEN-SEQ3.
062800
065100     IF SCREEN-SEQ3 NUMERIC
065200         MOVE SCREEN-SEQ3 TO CHECK-SEQ
065300     ELSE
065400     MOVE 35066 TO CATREAD-MSG-NUMBER
065600     PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
           MOVE MISC-BUFFER TO SCREEN-ERR-LINE
065700     MOVE TRUE-VAL TO INDS (28) INDS (99)
065900     MOVE "Y" TO REREAD
066000     GO TO 68-MOVCOP-EXIT.
066100
066200     IF CHECK-SEQ > 0 AND CHECK-SEQ < 999
066300         NEXT SENTENCE
066400     ELSE
066500     MOVE 45031 TO CATREAD-MSG-NUMBER
066700     PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
           MOVE MISC-BUFFER TO SCREEN-ERR-LINE
066800     MOVE TRUE-VAL TO INDS (28) INDS (99)
067000     MOVE "Y" TO REREAD
067100     GO TO 68-MOVCOP-EXIT.
           MOVE SPACES TO JOBPLAN-KEY.
029900     MOVE MJOBPLAN-NAME   TO JOBP-WO-NO.
030000     MOVE SCREEN-SEQ2     TO JOBP-SEQ-NO.
067900     MOVE 0 TO COND-WORD.
           MOVE JOBPLAN-KEY TO GJOBPSEQ OF JBREC.
           START JOBPLAN-BANK KEY IS > EXTERNALLY-DESCRIBED-KEY
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF JB-STATUS NOT = "00" MOVE 17 TO COND-WORD.
068200     IF COND-WORD = 17
068300         MOVE 44004 TO CATREAD-MSG-NUMBER
068500         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MISC-BUFFER TO SCREEN-ERR-LINE
068600         MOVE TRUE-VAL TO INDS (27) INDS (99)
068800         MOVE "Y" TO REREAD
068900         GO TO 68-MOVCOP-EXIT.
           MOVE SPACES TO JOBPLAN-KEY.
           MOVE MJOBPLAN-NAME    TO JOBP-WO-NO.
           MOVE SCREEN-SEQ3      TO JOBP-SEQ-NO.
069700     MOVE 0 TO COND-WORD.
           MOVE JOBPLAN-KEY TO GJOBPSEQ OF JBREC.
           START JOBPLAN-BANK KEY IS > EXTERNALLY-DESCRIBED-KEY
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF JB-STATUS NOT = "00" MOVE 17 TO COND-WORD.
070000     IF COND-WORD = 17 GO TO 68-MOVCOP-EXIT.
           READ JOBPLAN-BANK NEXT INTO JOBPLAN-BUFFER
               AT END    MOVE 15 TO COND-WORD.
           IF JOBP-N-S NOT = JOBPLAN-KEY MOVE 15 TO COND-WORD.
           IF JB-STATUS NOT = "00" MOVE 15 TO COND-WORD.
           IF COND-WORD = 0
070100         MOVE 44005 TO CATREAD-MSG-NUMBER
070300         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MISC-BUFFER TO SCREEN-ERR-LINE
070400         MOVE TRUE-VAL TO INDS (28) INDS (99)
070600         MOVE "Y" TO REREAD
070700         GO TO 68-MOVCOP-EXIT.
           MOVE HIGH-VALUES TO GJOBPSEQ OF JBREC.
           START JOBPLAN-BANK KEY > EXTERNALLY-DESCRIBED-KEY.
071300     MOVE SCREEN-SEQ2 TO SEQ2.
071400     MOVE SCREEN-SEQ3 TO SEQ3.
           PERFORM 69-START-MASTER-JOBPLAN.
           IF COND-WORD = 17 GO TO 68-MOVCOP-EXIT.
           PERFORM 69-READ-MASTER-JOBPLAN.
           IF COND-WORD = 15 GO TO 68-MOVCOP-EXIT.
072800     IF SEQ3 > MJOBPLAN-LASTSEQ
072900         MOVE SEQ3 TO MJOBPLAN-LASTSEQ
               MOVE 0 TO COND-WORD
               REWRITE MJREC FROM MASTER-JOBPLAN-DATA
                   INVALID KEY    MOVE 17 TO COND-WORD.
075800     CALL "TJMOVCOP" USING DBPARAMETERS    VIEW-COMAREA
075900                           LANGUAGE-PARMS  MJOBPLAN-NAME
076000                           SEQ2            SEQ3
076100                           MC-BYTE.
           IF MC-BYTE = "C"
               MOVE 66370 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE SEQ2 TO ERR-SEQ2
               MOVE SEQ3 TO ERR-SEQ3
               MOVE MISC-BUFFER TO SCREEN-CMD-LINE
               MOVE TRUE-VAL TO INDS (98)
               MOVE SCREEN-DATA TO DSPLY-REC
               PERFORM 99-SCREEN-WRITE
               PERFORM 98A-SCREEN-READ
               CALL "CLPAUSE2"
               MOVE SPACES TO SCREEN-CMD-LINE MISC-BUFFER
                   SCREEN-M-C SCREEN-SEQ2 SCREEN-SEQ3
           ELSE
           IF MC-BYTE = "M"
               MOVE 66371 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE SEQ2 TO ERR-SEQ2
               MOVE SEQ3 TO ERR-SEQ3
               MOVE MISC-BUFFER TO SCREEN-CMD-LINE
               MOVE TRUE-VAL TO INDS (98)
               MOVE SCREEN-DATA TO DSPLY-REC
               PERFORM 99-SCREEN-WRITE
               PERFORM 98A-SCREEN-READ
               CALL "CLPAUSE2"
               MOVE SPACES TO SCREEN-CMD-LINE MISC-BUFFER
                   SCREEN-M-C SCREEN-SEQ2 SCREEN-SEQ3.
076200
076700 68-MOVCOP-EXIT.    EXIT.
078800
       69-READ-MASTER-JOBPLAN.
           MOVE 0 TO COND-WORD.
           READ MASTER-JOBPLAN NEXT INTO MASTER-JOBPLAN-DATA
               AT END    MOVE 15 TO COND-WORD.
           IF MJ-STATUS NOT = "00" MOVE 15 TO COND-WORD.

       69-REWRITE-MASTER-JOBPLAN.
027700     MOVE 0 TO COND-WORD.
027800     REWRITE MJREC FROM MASTER-JOBPLAN-DATA
027900         INVALID KEY    MOVE 17 TO COND-WORD.
           IF MJ-STATUS NOT = "00" MOVE 17 TO COND-WORD.

       69-START-MASTER-JOBPLAN.
           MOVE 0 TO COND-WORD.
           MOVE MJOBPLAN-NAME TO GJOBPNAME OF MJREC.
           START MASTER-JOBPLAN KEY = EXTERNALLY-DESCRIBED-KEY
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF MJ-STATUS NOT = "00" MOVE 17 TO COND-WORD.

       98-SCREEN-READ.
           READ DISPLAY-FILE FORMAT IS VIEW-CFNAME
               INDIC IS INDICS.
           ACCEPT IOFEEDBACK FROM I-O-FEEDBACK-AREA.
           MOVE ALL B"0" TO INDICS.
           IF DSPLY-STATUS NOT = "00"
               MOVE 3 TO VIEW-LASTKEY
           ELSE
           MOVE FUNCTION-NUM TO VIEW-LASTKEY.

       98A-SCREEN-READ.
           READ DISPLAY-FILE TERMINAL IS TERMINAL-ID
               INDIC IS INDICS
                  NO DATA MOVE DSPLY-STATUS TO DSPLY-STATUS.
           MOVE ALL B"0" TO INDICS.

       99-SCREEN-WRITE.
           WRITE DSPLY-REC FORMAT IS VIEW-CFNAME
               INDIC IS INDICS.
           MOVE ALL B"0" TO INDICS.

076200 998-BLOWUP.
076300     MOVE "TJADDSEQ" TO BU-PGM-NAME.
076400     CALL "TBLOWUP" USING BLOWUP-BASE BU-PGM-NAME STATUS-AREA
076500                      VIEW-COMAREA DUMMY-KSAM-STAT
076600                      BU-DISPLAY-MSG BU-DISPLAY-FLDS.

049700 999-CATREAD.
049800     MOVE SPACES TO MISC-BUFFER.
049900     CALL "CCATREAD" USING CATREAD-PARMS.
           MOVE CATREAD-MSG-TEXT TO MISC-BUFFER.
050800 999-CATREAD-EXIT.    EXIT.
