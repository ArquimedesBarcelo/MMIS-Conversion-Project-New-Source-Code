       IDENTIFICATION DIVISION.
       PROGRAM-ID.             TBBEXEC.
       AUTHOR.                 W. ROXBURY.
       INSTALLATION.           GOODYEAR TIRE & RUBBER CO.
      *REMARKS.           **** BULLETIN BOARD MAINTENANCE
      *                        EXECUTIVE PROGRAM
      *                        WITH DISTRIBUTION TABLE
      *                        ****.
       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.
       SOURCE-COMPUTER.        IBM-AS400.
       OBJECT-COMPUTER.        IBM-AS400.
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT WO-LAST-NUM-USED
                  ASSIGN       TO DATABASE-MCFPMM0800
                  ORGANIZATION IS RELATIVE
                  ACCESS MODE  IS RANDOM
                  RELATIVE KEY IS ARG-NO
                  FILE STATUS  IS FILE-STAT.

           SELECT BULLETIN-BOARD
                  ASSIGN       TO DATABASE-MCFLMM2701
                  ORGANIZATION IS INDEXED
                  ACCESS MODE  IS DYNAMIC
                  RECORD KEY   IS EXTERNALLY-DESCRIBED-KEY
                               WITH DUPLICATES
                  FILE STATUS  IS FILE-STAT.

           SELECT DISPLAY-FILE
                  ASSIGN       TO WORKSTATION-ZBBNEW-SI
                  ORGANIZATION IS TRANSACTION
                  ACCESS MODE  IS SEQUENTIAL
                  FILE STATUS  IS SCREEN-STATUS
                               MAJOR-MINOR
                  CONTROL-AREA IS SCREEN-CONTROL.

       DATA DIVISION.
       FILE SECTION.
       FD  WO-LAST-NUM-USED
           LABEL RECORDS ARE STANDARD.
       01  WO-REC.
           COPY DD-ALL-FORMATS OF MCFPMM0800.

       FD  BULLETIN-BOARD
           LABEL RECORDS ARE STANDARD.
       01  BB-REC.
           COPY DDS-ALL-FORMATS OF MCFLMM2701.

       FD  DISPLAY-FILE
           LABEL RECORDS ARE OMITTED.
       01  DISPLAY-REC         PIC X(2000).

       WORKING-STORAGE SECTION.
       77  ARG-NO                  PIC 9999  VALUE 1.

       01  PASSWORD-INFORMATION.
           05  NAME-OF-PROGRAM PIC X(08) VALUE "TBBEXEC ".
           05  PROGRAM-TYPE    PIC X(02) VALUE "UP".
           05  PROGRAM-RELEASE PIC X(12) VALUE " J0100010001".
           05  PROGRAM-DESCRIPTION.
               10  PROG-DESC1  PIC X(30) VALUE
                   "PRIMARY MODULE OF THE BULLETIN".
               10  PROG-DESC2  PIC X(30) VALUE
                   " BOARD MAINTENANCE PROGRAM.   ".
               10  PROG-DESC3  PIC X(30) VALUE
                   "DISPLAYS MENU TO MAINTAIN MMIS".
               10  PROG-DESC4  PIC X(30) VALUE
                   " NEWS MESSAGES AND DISTRIB.   ".
               10  PROG-FUNC1  PIC X(30) VALUE
                   "LISTS.  RUNS FROM `NEWS' ON TH".
               10  PROG-FUNC2  PIC X(30) VALUE
                   "E MANAGER's MENU.             ".
           05  PASSWORD-FLAG   PIC X.

       01  FILE-STAT.
           05 FILE-STAT-1      PIC X   VALUE "0".
           05 FILE-STAT-2      PIC X   VALUE "0".

       01  HELP-DATA.
           05  HELP-SW         PIC 9(04) BINARY VALUE ZEROS.
           05  HELP-LOCA       PIC X(40).
           05  HELP-MSGLINE    PIC X(70).

       01  LOCATION.
           05  LOCATN          PIC X(40).
           05  FILLER          PIC X(30).

           COPY SCREENIO       IN COPYLIB.

       01  DBPARAMETERS.
           COPY DBPARMS        IN COPYLIB.

       01  LAST-WO-USED-DATA.
           COPY MLASTWO        IN COPYLIB.

       01  NEWS-FILE-DATA.
           COPY DBBOARD        IN COPYLIB.

       PROCEDURE DIVISION.
       CHECK-PASSWORD.
           CALL "TPWORD" USING PASSWORD-INFORMATION.
           IF PASSWORD-FLAG NOT = "N"
               GO TO BEGIN.
           GOBACK.

       BEGIN.
           MOVE SPACES         TO LAST-WO-USED-DATA
                                  NEWS-FILE-DATA.
           MOVE 1              TO DATE-FLAG-SW.
           OPEN I-O            DISPLAY-FILE.
           OPEN INPUT          BULLETIN-BOARD.
           OPEN INPUT          WO-LAST-NUM-USED.
           READ  WO-LAST-NUM-USED INTO LAST-WO-USED-DATA
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = ZEROS
               DISPLAY "UNABLE TO GET LAST-WO-USED DATA."
                       "    FILE-STATUS = " FILE-STAT
               CLOSE           WO-LAST-NUM-USED
               GO TO END-OF-JOB.

           MOVE DATE-FLAG-SW   TO DATE-FLAG.
           CLOSE               WO-LAST-NUM-USED.

       DBFIND-SETUP.
           MOVE "111111"       TO NEWSKEY OF BULLETIN-BOARD.
           READ BULLETIN-BOARD INTO NEWS-FILE-DATA
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
               MOVE SPACES     TO NEWS-FILE-DATA
               GO TO MAIN.

           MOVE NEWS-1         TO LOCATION.
           MOVE LOCATN         TO HELP-LOCA.
           MOVE NEWS-0         TO HELP-MSGLINE.

       MAIN.
           MOVE "VBBMENU"      TO SCREEN-NAME.
           MOVE "00"           TO SCREEN-STATUS.
           MOVE SPACES         TO DISPLAY-REC.

           WRITE DISPLAY-REC   FORMAT IS SCREEN-NAME
                               INDIC ARE SCREEN-INDICATORS.
           IF SCREEN-STATUS NOT = "00"
               DISPLAY "SCREEN WRITE ERROR.  SCREEN-STATUS IS "
                               SCREEN-STATUS
               GO TO END-OF-JOB.

           READ  DISPLAY-FILE  FORMAT IS SCREEN-NAME
                               INDIC ARE SCREEN-INDICATORS
           IF SCREEN-STATUS NOT = "00"
               DISPLAY "SCREEN READ ERROR.  SCREEN-STATUS IS "
                               SCREEN-STATUS
               GO TO END-OF-JOB.

           MOVE ALL B"0"       TO SCREEN-INDICATORS.

           IF KEY-HIT = 3
               GO TO END-OF-JOB
           ELSE
           IF KEY-HIT = 1
               CALL "TBBINIT"  USING DBPARAMETERS
                                     HELP-DATA
               IF KEY-HIT = 3
                   GO TO END-OF-JOB
               ELSE
                   GO TO MAIN
           ELSE
           IF KEY-HIT = 2
               CALL "TBBUPDT"  USING DBPARAMETERS
                                     HELP-DATA
               IF KEY-HIT = 3
                   GO TO END-OF-JOB
               ELSE
                   GO TO MAIN
           ELSE
           IF KEY-HIT = 8
               CALL "TBBDEL"   USING DBPARAMETERS
                                     HELP-DATA
               IF KEY-HIT = 3
                   GO TO END-OF-JOB
               ELSE
                   GO TO MAIN
           ELSE
           IF KEY-HIT = 4
               CALL "TBBDISP"  USING DBPARAMETERS
                                     HELP-DATA
               IF KEY-HIT = 3
                   GO TO END-OF-JOB
               ELSE
                   GO TO MAIN
           ELSE
           IF KEY-HIT = 5
               CALL "TBBMAST"  USING DBPARAMETERS
                                     HELP-DATA
               IF KEY-HIT = 3
                   GO TO END-OF-JOB
               ELSE
                   GO TO MAIN
           ELSE
           IF KEY-HIT = 6
               CALL "TDLMAIN"  USING DBPARAMETERS
                                     HELP-DATA
               IF KEY-HIT = 3
                   GO TO END-OF-JOB
               ELSE
                   GO TO MAIN
           ELSE
           IF KEY-HIT = 7
               MOVE 0          TO HELP-SW
               CALL "TBBHELP"  USING HELP-DATA
               GO TO MAIN
           ELSE
               GO TO MAIN.

       END-OF-JOB.
           CLOSE               BULLETIN-BOARD.
           CLOSE               DISPLAY-FILE.
           GOBACK.

