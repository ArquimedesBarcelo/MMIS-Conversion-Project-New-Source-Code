           MOVE MESSAGE-BUFFER              TO MSG25.
           MOVE 54               TO LANG-SETNUM.
           MOVE 60                          TO LANG-MSGNUM.
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
           MOVE MESSAGE-BUFFER              TO MSG24.
084600*************************************************************
084700*         OPEN THREE SPOOLFILES AND START THE PRINTER       *
084800*************************************************************
           MOVE SPOOL-PRT-NO TO OVRPRTF-TOFILE-NUM.
           MOVE "MCPRT"      TO OVRPRTF-FILE.
           PERFORM 996-OVERRIDE-PRINT-FILE.
090800     OPEN OUTPUT ONLINE-PRT.
090900
           IF ACCTG-PRT-NO NOT = ZEROES
              MOVE ACCTG-PRT-NO TO OVRPRTF-TOFILE-NUM
              MOVE "MCPRT2"     TO OVRPRTF-FILE
              PERFORM 996-OVERRIDE-PRINT-FILE
              OPEN OUTPUT ACCTG-PRT.

092100     IF PRINT-PRT-NO NOT = ZEROES
              MOVE PRINT-PRT-NO TO OVRPRTF-TOFILE-NUM
              MOVE "MCPRT3"     TO OVRPRTF-FILE
              PERFORM 996-OVERRIDE-PRINT-FILE
088400        OPEN OUTPUT THIRD-PRT.
088500     MOVE SPACES TO PRINT-RCD.
088600     MOVE 1 TO LINE-ADV.
088700     PERFORM 900-PRINT-LINE THRU 909-EXIT.
088800     MOVE DATE-FORMATTED-TIME-OUT TO PRT-TIME.
088900     MOVE  DE-PO      TO DISP-PO.
089000     MOVE  DE-RLSE    TO DISP-RLSE.
