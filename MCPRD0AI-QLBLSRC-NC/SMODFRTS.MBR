081200
           MOVE 0 TO COND-WORD.
           READ DPOFREIGHT-O NEXT INTO BUF-DPOFREIGHT
               AT END MOVE 15 TO COND-WORD.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   MOVE 15 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.
           IF PORCVNO OF DPOFREIGHT-REC-O NOT = PO-ARG
               MOVE 15 TO COND-WORD.
081500     IF NOT GOOD-CALL
081600           MOVE "DBGET3 DFREIGHT SMODFRTS 335" TO BU-DISPLAY-MSG
081700           PERFORM 990-BLOWUP THRU 999-EXIT.
081800
           MOVE 0 TO COND-WORD.
           DELETE DPOFREIGHT-O
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD.
081820     IF NOT GOOD-CALL
081830        MOVE "DBDELETE DPOFREIGHT SMODFRTS 335" TO BU-DISPLAY-MSG
081840        PERFORM 990-BLOWUP THRU 999-EXIT.
081850
081900         MOVE TYPE-FREIGHT-BUF            TO  FRT-TYPE.
082000         MOVE EMPLOYEE-BUF                TO  FRT-EMPL.
082100         MOVE P-SLIP-NO-BUF               TO  FRT-PACK-SLIP.
082200         MOVE CARRIER-BUF                 TO  FRT-CARRIER.
082300         MOVE FREIGHT-NO-BUF              TO  FRT-BILL-NO.
               MOVE FREIGHT-CHARGES-BUF9        TO  FRT-CHARGES-9.
               IF FRT-CHARGES-9 < 1
                  MOVE ZEROES                   TO  FRT-CHARGES-9.
082500         MOVE ORIGIN-BUF                  TO  FRT-SPLC.
082600         MOVE CARR-WT-BUF                 TO  FRT-CARRIER-WT.
082700         MOVE OUR-WT-BUF                  TO  FRT-OUR-WT.
082800         MOVE CAR-NO-BUF                  TO  FRT-RAIL-CAR.
082900         MOVE LOT-NO-BUF                  TO  FRT-LOT.
083000         MOVE SEALS-BUF                   TO  FRT-SEALS.
083100         MOVE OSD-NO-BUF                  TO  FRT-OSD.
               MOVE COMMENT-BUF                 TO  FRT-OSD-CLAIM.
083200         MOVE SAVE-PRO-DATE               TO FRT-BILL-DATE.
               IF SAVE-PRO-DATE-YY = "  "
                   MOVE "  " TO FRT-CC
               ELSE
               IF SAVE-PRO-DATE-YY > "70"
                   MOVE "19" TO FRT-CC
               ELSE
                   MOVE "20" TO FRT-CC.
083300         MOVE Z-BILL-BUF                  TO  FRT-ZBILL.
083400         MOVE SPACES                      TO  FRT-REFERBACK.
083500
           MOVE 0 TO COND-WORD.
           WRITE DPOFREIGHT-REC-O FROM BUF-DPOFREIGHT
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD.
083800     IF NOT GOOD-CALL
083900           MOVE "DBUPDT3 DFREIGHT SMODFRTS 335" TO BU-DISPLAY-MSG
084000           PERFORM 990-BLOWUP THRU 999-EXIT.

