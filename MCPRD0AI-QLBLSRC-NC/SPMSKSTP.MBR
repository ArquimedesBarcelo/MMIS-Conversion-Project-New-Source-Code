       IDENTIFICATION DIVISION.
       PROGRAM-ID.             SPMSKSTP.
       AUTHOR.                 J.S. BUNGO.
       INSTALLATION.           GOODYEAR TIRE & RUBBER CO.
      *REMARKS.                PREVENTIVE MAINTENANCE PM SCHEDULE
      *                        STOP FOR A MASTER WORKORDER.
      *                        ****.
       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.
       SOURCE-COMPUTER.        IBM-AS400.
       OBJECT-COMPUTER.        IBM-AS400.

       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT PM-SCHEDULE-WO
                  ASSIGN       TO DATABASE-MCFLMM4404
                  ORGANIZATION IS INDEXED
                  ACCESS MODE  IS DYNAMIC
                  RECORD KEY   IS EXTERNALLY-DESCRIBED-KEY
                               WITH DUPLICATES
                  FILE STATUS  IS FILE-STAT.

           SELECT PM-SCHEDULE-WO2
                  ASSIGN       TO DATABASE-MCFLMM4404
                  ORGANIZATION IS INDEXED
                  ACCESS MODE  IS DYNAMIC
                  RECORD KEY   IS EXTERNALLY-DESCRIBED-KEY
                               WITH DUPLICATES
                  FILE STATUS  IS FILE-STAT.

           SELECT PM-OPEN-QUEUE
                  ASSIGN       TO DATABASE-MCFLMM3901
                  ORGANIZATION IS INDEXED
                  ACCESS MODE  IS DYNAMIC
                  RECORD KEY   IS EXTERNALLY-DESCRIBED-KEY
                               WITH DUPLICATES
                  FILE STATUS  IS FILE-STAT.

           SELECT WO-PLANNED-WO
                  ASSIGN       TO DATABASE-MCFLMM1101
                  ORGANIZATION IS INDEXED
                  ACCESS MODE  IS DYNAMIC
                  RECORD KEY   IS EXTERNALLY-DESCRIBED-KEY
                               WITH DUPLICATES
                  FILE STATUS  IS FILE-STAT.

           SELECT WO-PLANNED-WO2
                  ASSIGN       TO DATABASE-MCFLMM1101
                  ORGANIZATION IS INDEXED
                  ACCESS MODE  IS DYNAMIC
                  RECORD KEY   IS EXTERNALLY-DESCRIBED-KEY
                               WITH DUPLICATES
                  FILE STATUS  IS FILE-STAT.

       DATA DIVISION.
       FILE SECTION.
       FD  PM-SCHEDULE-WO
           LABEL RECORDS ARE STANDARD.
       01  PM-SCHED-WO-REC.
           COPY DDS-ALL-FORMATS OF MCFLMM4404.

       FD  PM-SCHEDULE-WO2
           LABEL RECORDS ARE STANDARD.
       01  PM-SCHED-WO-REC2.
           COPY DDS-ALL-FORMATS OF MCFLMM4404.

       FD  PM-OPEN-QUEUE
           LABEL RECORDS ARE STANDARD.
       01  PMQ-REC.
           COPY DDS-ALL-FORMATS OF MCFLMM3901.

       FD  WO-PLANNED-WO
           LABEL RECORDS ARE STANDARD.
       01  WO-WO-REC.
           COPY DDS-ALL-FORMATS OF MCFLMM1101.

       FD  WO-PLANNED-WO2
           LABEL RECORDS ARE STANDARD.
       01  WO-WO2-REC.
           COPY DDS-ALL-FORMATS OF MCFLMM1101.

       WORKING-STORAGE SECTION.
       77  BASE                PIC X(24).
       77  MSG-SW              PIC X.

       01  FILE-STAT.
           05 FILE-STAT-1      PIC X   VALUE "0".
           05 FILE-STAT-2      PIC X   VALUE "0".

       01  WO-LINK-DATA.
           05  LINK-WO         PIC X(10).
           05  LINK-EQUIP      PIC X(06).
           05  LINK-DESC       PIC X(30).

       01  CD-YMD.
           05  CD-YY           PIC 99.
           05  CD-MM           PIC 99.
           05  CD-DD           PIC 99.

       01  CHANGE-DATE.
           05  CHANGE-YYYY.
               10  CHANGE-CT   PIC 99.
               10  CHANGE-YY   PIC 99.
           05  CHANGE-MM       PIC 99.
           05  CHANGE-DD       PIC 99.

       01  ERROR-MESSAGE.
           05  ERROR-TEXT      PIC X(70).
           05  ERROR-FILL      PIC X(06) VALUE "000000".
           05  ERROR-CODE      REDEFINES ERROR-FILL PIC 9(06).

           COPY DBSTAT         IN COPYLIB.

       01  WO-PLANNED-DATA.
           COPY DWOPLAN        IN COPYLIB.

       01  WO-PLANNED-DATA2.
           COPY DWOPLAN        IN COPYLIB.

       01  WO-TRACK-DATA.
           COPY DWOTRACK       IN COPYLIB.

       01  PM-SCHED-DATA.
           COPY DPMSCHED       IN COPYLIB.

       01  PMQ-DATA.
           COPY DPMOPENQ       IN COPYLIB.

       LINKAGE SECTION.
       01  DBPARAMETERS.
           COPY DBPARMS        IN COPYLIB.

       01  PASSED-WO.
           05  PASSED-WO-7     PIC X(07).
           05  PASSED-WO-SUF   PIC X(03).
       01  STOP-CALENDAR-SW    PIC X(01).
       01  PM-QUEUE-MSG-SW     PIC X(01).
       01  BU-DISPLAY-MSG      PIC X(60).

       01  BU-DISPLAY-FLDS.
           05  BU-DISPLAY-LINE OCCURS 5 TIMES.
               10  BU-DISPLAY-FLD       PIC X(14).
               10  BU-DISPLAY-FLD9      PIC S9(8).

       PROCEDURE DIVISION      USING DBPARAMETERS PASSED-WO
                               STOP-CALENDAR-SW
                               PM-QUEUE-MSG-SW
                               BU-DISPLAY-MSG
                               BU-DISPLAY-FLDS.
       BEGIN.
           MOVE SPACES         TO BU-DISPLAY-MSG.
           OPEN I-O            PM-SCHEDULE-WO
                               WO-PLANNED-WO2
                               PM-OPEN-QUEUE.
           OPEN INPUT          PM-SCHEDULE-WO2
                               WO-PLANNED-WO.

           ACCEPT CD-YMD       FROM DATE.
           IF CD-YY > 70
               MOVE 19         TO CHANGE-CT
           ELSE
               MOVE 20         TO CHANGE-CT.
           MOVE CD-YY          TO CHANGE-YY.
           MOVE CD-MM          TO CHANGE-MM.
           MOVE CD-DD          TO CHANGE-DD.

           IF STOP-CALENDAR-SW = "&"
               MOVE "Y"        TO STOP-CALENDAR-SW
               MOVE "N"        TO PM-QUEUE-MSG-SW.

           PERFORM STOP-SCHEDULE THRU STOP-SCHEDULE-EXIT.
           GO TO END-OF-JOB.

       STOP-SCHEDULE.
           MOVE PASSED-WO      TO WONUM OF WO-PLANNED-WO.
           READ WO-PLANNED-WO  INTO WO-PLANNED-DATA
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT = "23"
               NEXT SENTENCE
           ELSE
           IF FILE-STAT NOT = "00"
               GO TO STOP-SCHEDULE-EXIT
           ELSE
           IF WO-NUM-SUFF-P OF WO-PLANNED-DATA NOT = "000"
               GO TO STOP-SCHEDULE-EXIT.

      *-----WRITE QUEUE MESSAGE EVEN IF NOT INITIATED ALREADY
           IF PM-QUEUE-MSG-SW = "Y"
               MOVE SPACES     TO PMQ-DATA
               MOVE WO-NUM-PLANNED OF WO-PLANNED-DATA TO PMQ-WO-NUM
               MOVE EQUIP-NUM-P OF WO-PLANNED-DATA TO PMQ-EQUIP-NUM
               MOVE ZONE-PRIORITY-P OF WO-PLANNED-DATA TO PMQ-ZONE-PRI
               MOVE "1 "       TO PMQ-PRTY
               MOVE "*SCHEDULE CHANGED - REINITIATE" TO PMQ-DESCRIPTION
               MOVE 99         TO PM-QUEUE-FACTOR
               MOVE CHANGE-DATE TO PMQ-DATE

               WRITE PMQ-REC   FROM PMQ-DATA
                   INVALID KEY MOVE FILE-STAT TO FILE-STAT
               END-WRITE
               IF FILE-STAT NOT = "00"
                  MOVE "WRITE PM-OPEN-QUEUE STOP-LOOP" TO BU-DISPLAY-MSG
                   MOVE PMQ-WO-NUM TO BU-DISPLAY-FLD (1)
                   MOVE FILE-STAT TO BU-DISPLAY-FLD (4)
                   GO TO END-OF-JOB
               END-IF
               PERFORM WRITE-MSG-PROG
           END-IF.

           PERFORM CHECK-INITIATION THRU CHECK-INITIATION-EXIT.
           IF FILE-STAT NOT = "00"
               GO TO STOP-SCHEDULE-EXIT.

           MOVE PASSED-WO      TO WONUM OF PM-SCHEDULE-WO.
           START PM-SCHEDULE-WO KEY = WONUM OF PM-SCHEDULE-WO
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
               GO TO STOP-SCHEDULE-EXIT.

       SCH-PURGE-LOOP.
           READ PM-SCHEDULE-WO NEXT INTO PM-SCHED-DATA
               AT END          MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT = "10" OR "14" OR "46"
               GO TO STOP-SCHEDULE-EXIT
           ELSE
           IF FILE-STAT NOT = "00"
               MOVE "READ PM-SCHEDULE-WO STOP-LOOP" TO BU-DISPLAY-MSG
               MOVE WO-NUM-PLANNED OF WO-PLANNED-DATA
                               TO BU-DISPLAY-FLD (1)
               MOVE FILE-STAT  TO BU-DISPLAY-FLD (4)
               GO TO END-OF-JOB.

           IF SCH-WO NOT = PASSED-WO-7
               GO TO STOP-SCHEDULE-EXIT.

           IF STOP-CALENDAR-SW NOT = "Y"
               IF SCH-REC-TYP = "CL"
                   GO TO SCH-PURGE-LOOP.

           DELETE PM-SCHEDULE-WO
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
               MOVE "DELETE TO PM-SCHEDULE STOP-LOOP" TO BU-DISPLAY-MSG
               MOVE WO-NUM-PLANNED OF WO-PLANNED-DATA
                               TO BU-DISPLAY-FLD (1)
               MOVE FILE-STAT  TO BU-DISPLAY-FLD (4)
               GO TO END-OF-JOB.

           IF SCH-PR-ID NOT = SPACES AND SCH-REC-PR = SPACES
               IF SCH-WO-SUFF NOT = "000"
                   PERFORM GET-WO THRU GET-WO-EXIT
                   IF FILE-STAT = "00"
                     IF WO-STATUS-P OF WO-PLANNED-DATA2 = "PR" OR "HS"
                       MOVE SPACES       TO WO-TRACK-DATA
                       MOVE SCH-WO-NUM   TO WO-NUM-TRACK
                       MOVE CHANGE-DATE  TO DATE-STAMP-CN
                       ACCEPT TIME-STAMP FROM TIME
                       MOVE WO-START-STATUS OF WO-PLANNED-DATA2
                                         TO WO-TYPE-STATUS
                       MOVE "STOP SCH"   TO USER-NAME
                       MOVE WO-STATUS-P OF WO-PLANNED-DATA2
                                         TO WO-STATUS-TRACK
                       MOVE "CW" TO WO-STATUS-P OF WO-PLANNED-DATA2
                                         TRANS-STATUS
                       MOVE "AS" TO WO-START-STATUS OF WO-PLANNED-DATA2
                       PERFORM WO-UPDATE THRU WO-UPDATE-EXIT
                       CALL "TWOTRACK" USING DBPARAMETERS STATUS-AREA
                                             WO-TRACK-DATA
                       MOVE "AA" TO WO-STATUS-TRACK
                       MOVE "AS" TO TRANS-STATUS
                       CALL "TWOTRACK" USING DBPARAMETERS STATUS-AREA
                                       WO-TRACK-DATA
                       PERFORM PMQ-DELETE THRU PMQ-DELETE-EXIT
                     END-IF
                   END-IF
               END-IF
           END-IF.
           GO TO SCH-PURGE-LOOP.

       STOP-SCHEDULE-EXIT.     EXIT.

       CHECK-INITIATION.
           MOVE PASSED-WO      TO WONUM OF PM-SCHEDULE-WO2.
           READ PM-SCHEDULE-WO2
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.

       CHECK-INITIATION-EXIT.  EXIT.

       GET-WO.
           MOVE SCH-WO-NUM     TO WONUM OF WO-PLANNED-WO2.
           READ WO-PLANNED-WO2 INTO WO-PLANNED-DATA2
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT
           END-READ.

       GET-WO-EXIT.            EXIT.

       WO-UPDATE.
           REWRITE WO-WO2-REC  FROM WO-PLANNED-DATA2
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
               MOVE "REWRITE ERR, WO-PLANNED-WO2" TO BU-DISPLAY-MSG
               MOVE SCH-WO-NUM TO BU-DISPLAY-FLD (1)
               MOVE WO-STATUS-P OF WO-PLANNED-DATA2
                               TO BU-DISPLAY-FLD (2)
               MOVE WO-START-STATUS OF WO-PLANNED-DATA2
                               TO BU-DISPLAY-FLD (3)
               MOVE FILE-STAT  TO BU-DISPLAY-FLD (4)
               GO TO END-OF-JOB.

       WO-UPDATE-EXIT.         EXIT.

       PMQ-DELETE.
           MOVE SCH-WO-NUM     TO WONUM OF PM-OPEN-QUEUE.
           READ PM-OPEN-QUEUE  INTO PMQ-DATA
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
               GO TO PMQ-DELETE-EXIT.

           DELETE PM-OPEN-QUEUE
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
               MOVE "DELETE ERR, PM-OPEN-QUEUE" TO BU-DISPLAY-MSG
               MOVE SCH-WO-NUM TO BU-DISPLAY-FLD (3)
               MOVE FILE-STAT  TO BU-DISPLAY-FLD (4)
               GO TO END-OF-JOB.

       PMQ-DELETE-EXIT.        EXIT.

       WRITE-MSG-PROG.
           MOVE SPACES         TO ERROR-MESSAGE.
           MOVE "4"            TO MSG-SW.
           MOVE PMQ-WO-NUM     TO LINK-WO.
           MOVE PMQ-EQUIP-NUM  TO LINK-EQUIP.
           MOVE PMQ-DESCRIPTION TO LINK-DESC.

           CALL "SPMWRTMS"     USING MSG-SW
                               WO-LINK-DATA
                               ERROR-MESSAGE.

       END-OF-JOB.
           CLOSE               WO-PLANNED-WO
                               WO-PLANNED-WO2
                               PM-SCHEDULE-WO
                               PM-OPEN-QUEUE.
           GOBACK.
