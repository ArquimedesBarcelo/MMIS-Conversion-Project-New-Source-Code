       IDENTIFICATION DIVISION.
       PROGRAM-ID.      TCPYBLK.
       AUTHOR.          CA YODER.
       DATE-WRITTEN.    AUGUST 2002.
      **************************************************************
      *                                                            *
      *D  T C P Y B L K                                            *
      *                                                            *
      *D    THIS PROGRAM COPIES THE ITEMS FROM EXISTING BLANKET    *
      *D    ORDERS TO CREATE A NEW BLANKET ORDER CONTAINING ALL    *
      *D    OF THE ITEMS.                                          *
      *                                                            *
      **************************************************************
      *C
      *C  CHANGES:
      *C

       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.
       SOURCE-COMPUTER.  HP-3000.
       OBJECT-COMPUTER.  HP-3000.
       SPECIAL-NAMES.  I-O-FEEDBACK IS I-O-FEEDBACK-AREA.


       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT SORT-FILE ASSIGN TO DISK-SORT.

           SELECT ITEM-FILE ASSIGN TO DATABASE-ITEMFILE.

           SELECT DPORECD-O
                  ASSIGN TO DATABASE-MCFLCS0901
                  ORGANIZATION IS INDEXED
                    ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                    WITH DUPLICATES
                  FILE STATUS IS FILE-STATUS.

           SELECT MPORCV-O
                  ASSIGN TO DATABASE-MCFLCS0101
                  ORGANIZATION IS INDEXED
                    ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                  FILE STATUS IS FILE-STATUS.

           SELECT DPOITEM-O
                  ASSIGN TO DATABASE-MCFLCS1002
                  ORGANIZATION IS INDEXED
                    ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                    WITH DUPLICATES
                  FILE STATUS IS FILE-STATUS.

           SELECT DPODATAITM-O
                  ASSIGN TO DATABASE-MCFLCS1101
                  ORGANIZATION IS INDEXED
                    ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                    WITH DUPLICATES
                  FILE STATUS IS FILE-STATUS.

           SELECT MSTORERM-I
                  ASSIGN TO DATABASE-MCFLCS0201
                  ORGANIZATION IS INDEXED
                    ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                  FILE STATUS IS FILE-STATUS.

           SELECT MPLTINFO-I
                  ASSIGN TO DATABASE-MCFLCS0501
                  ORGANIZATION IS INDEXED
                    ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                  FILE STATUS IS FILE-STATUS.

           SELECT DISPLAY-FILE
                  ASSIGN TO WORKSTATION-ZCPYBLK-SI
                  ORGANIZATION IS TRANSACTION
                  ACCESS IS SEQUENTIAL
                  FILE STATUS IS DISPLAY-STATUS
                  CONTROL-AREA IS WS-CONTROL.

       DATA DIVISION.

       FILE SECTION.

       SD  SORT-FILE
           RECORD CONTAINS 25 CHARACTERS.
       01  SORT-RCD.
           05  SORT-CORP-CODE            PIC X(7).
           05  SORT-NUMBER               PIC 9(4).
           05  SORT-PO-NUM               PIC X(14).

       FD  ITEM-FILE
           RECORD CONTAINS 25 CHARACTERS
           LABEL RECORD IS OMITTED
           DATA RECORD IS ITEM-RCD.
       01  ITEM-RCD.
           05  ITEM-CORP-CODE            PIC X(7).
           05  ITEM-NUMBER               PIC 9(4).
           05  ITEM-PO-NUM               PIC X(14).

       FD  DPORECD-O
           LABEL RECORDS ARE STANDARD.
       01  DPORECD-REC-O.
           COPY DDS-ALL-FORMATS  OF MCFLCS0901.

       FD  MPORCV-O
           LABEL RECORDS ARE STANDARD.
       01  MPORCV-REC-O.
           COPY DDS-ALL-FORMATS  OF MCFLCS0101.

       FD  DPOITEM-O
           LABEL RECORDS ARE STANDARD.
       01  DPOITEM-REC-O.
           COPY DDS-ALL-FORMATS  OF MCFLCS1002.

       FD  DPODATAITM-O
           LABEL RECORDS ARE STANDARD.
       01  DPODATAITM-REC-O.
           COPY DDS-ALL-FORMATS  OF MCFLCS1101.

       FD  MSTORERM-I
           LABEL RECORDS ARE STANDARD.
       01  MSTORERM-REC-I.
           COPY DDS-ALL-FORMATS  OF MCFLCS0201.

       FD  MPLTINFO-I
           LABEL RECORDS ARE STANDARD.
       01  MPLTINFO-REC-I.
           COPY DDS-ALL-FORMATS  OF MCFLCS0501.

       FD  DISPLAY-FILE
           LABEL RECORDS ARE OMITTED.
       01  DISPLAY-REC.
           COPY DD-CPYSCRN-O OF ZCPYBLK.


       WORKING-STORAGE SECTION.
       77  BLANKET-SW                    PIC 9.
       77  TOTAL-ITEM-CTR                PIC 9(4)   VALUE ZEROS.
       77  PGM-ERROR-SW                  PIC X      VALUE "N".
       77  DUP-BLKTS-SW                  PIC X      VALUE "N".
       77  MAX-BLKTS                     PIC 99     VALUE 12.
       77  HOLD-CORP-CODE                PIC X(7)   VALUE SPACES.

       01  FILE-STATUS.
           05  FILE-STATUS-1             PIC X      VALUE "0".
           05  FILE-STATUS-2             PIC X      VALUE "0".

       01  SWITCH-AREA.
           05  EOJ-SW                    PIC X      VALUE "N".
           05  DONE-PROCESS-ITEMS        PIC X      VALUE SPACES.
           05  BLANKET-ENTERED-SW        PIC X      VALUE "N".

       01  SUB-AREA  COMP-4.
           05  SUB                       PIC S99    VALUE ZEROS.
           05  SUB-B                     PIC S99    VALUE ZEROS.
           05  HOLD-SUB                  PIC S99    VALUE ZEROS.

       COPY TDATECHK IN COPYLIB.

       01  SAVE-NEW-PO-NUM               PIC X(14).

       01  SAVE-EXP-DATE-CYMD.
           05  SAVE-EXP-DATE-CC          PIC X(2).
           05  SAVE-EXP-DATE.
               10  SAVE-EXP-DATE-YY      PIC X(2).
               10  FILLER                PIC X(4).

       01  BUILD-PO-SEARCH.
           05  PO-PREFIX                 PIC X      VALUE "P".
           05  PO-NO                     PIC X(7)   VALUE SPACES.
           05  PO-REL                    PIC X(3)   VALUE SPACES.
           05  PO-RCV                    PIC X(3)   VALUE SPACES.

       COPY VCOMAREA IN COPYLIB.

       01  LANG-BUFFER.
           05  LB-MT-1R                  PIC X(28).
           05  LB-MT-2R                  PIC X(6).
           05  LB-MT-3R                  PIC X(34).

       01  MESSAGE-BUFFER.
           05  MSG-TEXT                  PIC X(68)  VALUE SPACE.
           05  MSG-FLD                   PIC X(8)   VALUE SPACE.
           05  MSG-FLD-9  REDEFINES  MSG-FLD      PIC ZZZZZZZ9.
       01  MESSAGE-BUFFER-R  REDEFINES  MESSAGE-BUFFER.
           05  MSG-TEXT-1R               PIC X(28).
           05  MSG-ITEM-NO               PIC ZZZ9.
           05  MSG-TEXT-2R               PIC X(6).
           05  MSG-TEXT-HP.
               10  MSG-ITEM-TOT          PIC ZZZ9.
               10  MSG-TEXT-3R           PIC X(34).
           05  MSG-TEXT-AS400 REDEFINES MSG-TEXT-HP
                                         PIC X(38).


       01  FIELD-NUMBER                  PIC S9(4)  VALUE 1 COMP-4.

       COPY DISPDATA IN COPYLIB.

       COPY IOFEEDBACK IN COPYLIB.

       COPY CATREAD IN COPYLIB.

      **************************************************************
      **             TERMINAL I/O DATA AREA                       **
      **************************************************************

       01  SCREEN-1.
           05  TRM-FROM-BLKTS    OCCURS 12 TIMES
                                        PIC X(7).
           05  TRM-NEW-BLKT             PIC X(7).
           05  TRM-EXP-DATE             PIC X(6).
           05  TRM-COMMAND-LINE         PIC X(79).
           05  TRM-MESSAGE-LINE         PIC X(79).

      **************************************************************
      **                DATABASE I/O BUFFER AREA                  **
      **************************************************************

       COPY MSTORERM IN COPYLIB.

       COPY MPORCV IN COPYLIB.

       COPY DPODATA IN COPYLIB.

       COPY DPORECD IN COPYLIB.

       COPY DPOITEM IN COPYLIB.

       COPY MPLT0    IN COPYLIB.
       COPY MPLTP01  IN COPYLIB.

       COPY DATAB IN COPYLIB.

       01 ARG-VALUES.
           05  CODE-ARG               PIC X(8)  VALUE SPACES.
           05  PLT-ARG                PIC X(4)  VALUE SPACES.
           05  PO-ARG                 PIC X(14) VALUE SPACES.

       COPY STC320 IN COPYLIB.

       01  STC360-TC                    PIC X(3) VALUE SPACES.
       01  STC360-COMPANY-SAVE          PIC X(3) VALUE SPACES.

       COPY CCRTFILE IN COPYLIB.

       COPY LANGUAGE IN COPYLIB.

       COPY TBLOWUP IN COPYLIB.

      **************************************************************
      **           P R O C E D U R E   D I V I S I O N            **
      **************************************************************

       PROCEDURE DIVISION.

       0-BEGIN.
           PERFORM 1-HSK.

           PERFORM 6-MAIN THRU 6-M-X.

           PERFORM 2-EOJ.

           GOBACK.

      **************************************************************
       1-HSK.
      **************************************************************
           OPEN I-O  DISPLAY-FILE, MPORCV-O, DPORECD-O, DPOITEM-O,
                     DPODATAITM-O.
           OPEN INPUT MPLTINFO-I, MSTORERM-I.

           MOVE "P 01"         TO  PLT-ARG.
           MOVE PLT-ARG TO PLTINFOKEY OF MPLTINFO-REC-I.
           READ MPLTINFO-I INTO BUF-MPLTINFO
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE "1-HSK"   TO  BU-DISPLAY-MSG
               MOVE PLT-ARG   TO  BU-DISPLAY-FLD (3)
               PERFORM 2-BLOWUP.

      **************************************************************
       2-EOJ.
      **************************************************************
           CLOSE  DISPLAY-FILE, MPORCV-O, DPORECD-O, DPOITEM-O,
                  DPODATAITM-O, MPLTINFO-I, MSTORERM-I.

      **************************************************************
       2-BLOWUP.
      **************************************************************
           MOVE "TCPYBLK"  TO  BU-PGM-NAME.
           CALL "TBLOWUP" USING BASE, BU-PGM-NAME, STATUS-AREA,
               VIEW-COMAREA, FILE-STATUS, BU-DISPLAY-MSG,
                   BU-DISPLAY-FLDS.

      **************************************************************
       4-PGM-ERROR.
      **************************************************************
           MOVE B"1" TO IND (FIELD-NUMBER) IND (99).
           MOVE MESSAGE-BUFFER TO TRM-MESSAGE-LINE.

      **************************************************************
       6-MAIN.
      **************************************************************
           PERFORM 61-CHANGE-BLK-NO  THRU  61-CBN-X.
           IF EOJ-SW  =  "Y"
               GO TO 6-M-X.
           GO TO 6-MAIN.

       6-M-X.
           EXIT.

      **************************************************************
       61-CHANGE-BLK-NO.
      **************************************************************
           MOVE "CPYSCRN"  TO  VIEW-NFNAME.
           MOVE SPACES  TO  SCREEN-1.

       61-SHOWFORM-SCREEN-1.
           MOVE SCREEN-1       TO DISPLAY-REC.
           PERFORM 998-WRITE-SCREEN THRU 998-READ-SCREEN.
           MOVE DISPLAY-REC    TO SCREEN-1.

           IF VIEW-LASTKEY = 3
               MOVE "Y"  TO  EOJ-SW
               GO TO 61-CBN-X
           ELSE
           IF VIEW-LASTKEY = 1 OR
              VIEW-LASTKEY = 2 OR
              VIEW-LASTKEY = 4 OR
              VIEW-LASTKEY = 5 OR
              VIEW-LASTKEY = 6 OR
              VIEW-LASTKEY = 7 OR
              VIEW-LASTKEY = 8
               MOVE   9 TO LANG-SETNUM
               MOVE  10 TO LANG-MSGNUM
               PERFORM 999-CATREAD
               MOVE 1  TO  FIELD-NUMBER
               PERFORM 4-PGM-ERROR
               GO TO 61-SHOWFORM-SCREEN-1.

      *------ FIELD EDITS
           MOVE "N"       TO BLANKET-ENTERED-SW.
           PERFORM VARYING SUB-B FROM 1 BY 1 UNTIL SUB-B > MAX-BLKTS
             IF TRM-FROM-BLKTS (SUB-B) > SPACES
                 MOVE "Y" TO BLANKET-ENTERED-SW
             END-IF
           END-PERFORM.
           IF BLANKET-ENTERED-SW = "N"
      *           OLD REQUIREMENT ORDER REQUIRED
               MOVE 66153 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD
               MOVE 1  TO FIELD-NUMBER
               PERFORM 4-PGM-ERROR
               GO TO 61-SHOWFORM-SCREEN-1.

           IF TRM-NEW-BLKT = SPACES
      *         NEW REQUIREMENT ORDER REQUIRED
               MOVE 66154 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD
               MOVE 13 TO FIELD-NUMBER
               PERFORM 4-PGM-ERROR
               GO TO 61-SHOWFORM-SCREEN-1.

           IF TRM-EXP-DATE = SPACES
      *         EXPIRATION DATE IS REQUIRED
               MOVE 66155 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD
               MOVE 14 TO FIELD-NUMBER
               PERFORM 4-PGM-ERROR
               GO TO 61-SHOWFORM-SCREEN-1.

           MOVE "N"                     TO  DUP-BLKTS-SW.
           MOVE 1                       TO  HOLD-SUB.
           PERFORM VARYING SUB FROM 1 BY 1 UNTIL SUB > MAX-BLKTS
                                OR DUP-BLKTS-SW = "Y"
               ADD 1                    TO  HOLD-SUB
               PERFORM VARYING SUB-B FROM HOLD-SUB BY 1
                                           UNTIL SUB-B > MAX-BLKTS
                                OR DUP-BLKTS-SW = "Y"
                   IF TRM-FROM-BLKTS (SUB) > SPACES
                       IF TRM-FROM-BLKTS (SUB) = TRM-FROM-BLKTS (SUB-B)
                           MOVE "Y" TO DUP-BLKTS-SW
                       END-IF
                   END-IF
               END-PERFORM
           END-PERFORM.

           IF DUP-BLKTS-SW = "Y"
      *         DUPLICATE BLANKET ORDER ENTERED
               MOVE "DUPLICATE BLANKET ORDER ENTERED" TO MESSAGE-BUFFER
               COMPUTE HOLD-SUB = SUB-B - 1
               MOVE HOLD-SUB TO FIELD-NUMBER
               PERFORM 4-PGM-ERROR
               GO TO 61-SHOWFORM-SCREEN-1.

       61-EDIT-BLK-NO.
           MOVE "999"                   TO  PO-REL.
           MOVE "000"                   TO  PO-RCV.
           MOVE "N"                     TO  PGM-ERROR-SW.
           PERFORM VARYING SUB-B FROM 1 BY 1 UNTIL SUB-B > MAX-BLKTS
             IF TRM-FROM-BLKTS (SUB-B) > SPACES
               MOVE TRM-FROM-BLKTS (SUB-B) TO  PO-NO
               MOVE BUILD-PO-SEARCH      TO  PO-ARG,
                                             BU-DISPLAY-FLD (1)
               MOVE PO-ARG TO PORCVNO OF MPORCV-REC-O
               READ MPORCV-O INTO BUF-MPORCV
                   INVALID KEY MOVE FILE-STATUS TO FILE-STATUS
               END-READ
               IF FILE-STATUS NOT = "00"
                   IF FILE-STATUS-1 = "2"
                       MOVE 0 TO BLANKET-SW
                       PERFORM 610-CHECK-4-BLANKET
                       IF BLANKET-SW = 0
                           IF PO-REL = "999"
                               MOVE  18 TO LANG-SETNUM
                               MOVE  20 TO LANG-MSGNUM
                               PERFORM 999-CATREAD
                               MOVE SUB-B TO  FIELD-NUMBER
                               PERFORM 4-PGM-ERROR
                               MOVE "Y"  TO PGM-ERROR-SW
                           ELSE
                               MOVE   2 TO LANG-SETNUM
                               MOVE   9 TO LANG-MSGNUM
                               PERFORM 999-CATREAD
                               MOVE SUB-B TO  FIELD-NUMBER
                               PERFORM 4-PGM-ERROR
                               MOVE "Y"  TO PGM-ERROR-SW
                           END-IF
                       ELSE
                           NEXT SENTENCE
                       END-IF
                   ELSE
                       MOVE "GET MPORCV * 61-EBN"  TO  BU-DISPLAY-MSG
                       PERFORM 2-BLOWUP
                   END-IF
               END-IF
             END-IF
           END-PERFORM.

           IF PGM-ERROR-SW = "Y"
               GO TO 61-SHOWFORM-SCREEN-1.

      *------- DO A START > HIGH-VALUES TO UNLOCK
           MOVE HIGH-VALUES TO PORCVNO OF MPORCV-REC-O.
           START MPORCV-O KEY > PORCVNO OF MPORCV-REC-O
               INVALID KEY MOVE "00" TO FILE-STATUS.

           IF M-PO-BLK-INDIC  NOT = "B"
               MOVE  14 TO LANG-SETNUM
               MOVE  19 TO LANG-MSGNUM
               PERFORM 999-CATREAD
               MOVE 1  TO  FIELD-NUMBER
               PERFORM 4-PGM-ERROR
               GO TO 61-SHOWFORM-SCREEN-1.

       61-EDIT-NEW-NUM.
           MOVE TRM-NEW-BLKT                 TO  PO-NO.
           MOVE BUILD-PO-SEARCH              TO  PO-ARG,
                                                 SAVE-NEW-PO-NUM,
                                                 BU-DISPLAY-FLD (2).
           MOVE PO-ARG TO PORCVNO OF MPORCV-REC-O.
           READ MPORCV-O INTO BUF-MPORCV
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
                   NEXT SENTENCE
               ELSE
                   MOVE "GET MPORCV * 61-ENN" TO BU-DISPLAY-MSG
                   PERFORM 2-BLOWUP
           ELSE
               MOVE  18 TO LANG-SETNUM
               MOVE  25 TO LANG-MSGNUM
               PERFORM 999-CATREAD
               MOVE 13 TO  FIELD-NUMBER
               PERFORM 4-PGM-ERROR
      *------- DO A START > HIGH-VALUES TO UNLOCK
               MOVE HIGH-VALUES TO PORCVNO OF MPORCV-REC-O
               START MPORCV-O KEY > PORCVNO OF MPORCV-REC-O
                   INVALID KEY MOVE "00" TO FILE-STATUS END-START
               GO TO 61-SHOWFORM-SCREEN-1.

       61-EDIT-PO-STATUS.
           PERFORM VARYING SUB-B FROM 1 BY 1 UNTIL SUB-B > MAX-BLKTS
             IF TRM-FROM-BLKTS (SUB-B) > SPACES
               MOVE TRM-FROM-BLKTS (SUB-B)       TO  PO-NO
               MOVE BUILD-PO-SEARCH              TO  PO-ARG
               MOVE PO-ARG TO PORCVNO OF DPORECD-REC-O
               START DPORECD-O KEY = PORCVNO OF DPORECD-REC-O
                   INVALID KEY MOVE FILE-STATUS TO FILE-STATUS
               END-START
               IF FILE-STATUS NOT = "00"
                   MOVE "FIND * 61-EPS"  TO  BU-DISPLAY-MSG
                   PERFORM 2-BLOWUP
               END-IF

               READ DPORECD-O NEXT INTO BUF-DPORECD
                   AT END MOVE FILE-STATUS TO FILE-STATUS
               END-READ
               IF FILE-STATUS NOT = "00" OR
                   PORCVNO OF DPORECD-REC-O NOT = PO-ARG
                   MOVE "GET * 61-EPS"   TO  BU-DISPLAY-MSG
                   PERFORM 2-BLOWUP
               END-IF
             END-IF
           END-PERFORM.

      *------- DO A START > HIGH-VALUES TO UNLOCK
           MOVE HIGH-VALUES TO PORCVNO OF DPORECD-REC-O.
           START DPORECD-O KEY > PORCVNO OF DPORECD-REC-O
               INVALID KEY MOVE "00" TO FILE-STATUS.

      *------- EDIT EXPIRATION DATE.
           MOVE TRM-EXP-DATE            TO DATE-VALIDATE-IN.
           MOVE 3                       TO DATE-MODE.
           CALL "TDATECK2" USING DATE-CHECK-AREA, LANGUAGE-PARMS.
           IF DATE-RET-CODE NOT = 0
               MOVE DATE-MSG            TO MESSAGE-BUFFER
               MOVE 14                  TO FIELD-NUMBER
               PERFORM 4-PGM-ERROR
               GO TO 61-SHOWFORM-SCREEN-1
           ELSE
           MOVE DATE-YMD-OUT            TO SAVE-EXP-DATE
           IF SAVE-EXP-DATE-YY > "70"
               MOVE "19"                TO SAVE-EXP-DATE-CC
           ELSE
           MOVE "20"                    TO SAVE-EXP-DATE-CC.

      *      NOW PROCESSING
           MOVE  14 TO LANG-SETNUM.
           MOVE   2 TO LANG-MSGNUM.
           PERFORM 999-CATREAD.
           MOVE MESSAGE-BUFFER TO TRM-COMMAND-LINE.
           MOVE B"1" TO IND (98).
           MOVE SCREEN-1 TO DISPLAY-REC.
           PERFORM 998-WRITE-SCREEN.
           PERFORM 998-AUTO-READ-SCREEN.

       61-BUILD-NEW-BLKT.
           MOVE SPACES                  TO  BUF-MPORCV.
           MOVE SAVE-NEW-PO-NUM         TO  M-PO-RCV-NO.
           IF PO-REL = "999"
               MOVE "B000"              TO  M-PO-RCV-STAT.
           WRITE MPORCV-REC-O FROM BUF-MPORCV
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE "PUT * 61-BNB"  TO  BU-DISPLAY-MSG
               PERFORM 2-BLOWUP.

       61-BUILD-DPORECD.
           MOVE SAVE-NEW-PO-NUM         TO  PO-RCV-NO.
           MOVE SAVE-EXP-DATE-CYMD      TO  PO-EXPECT-DATE-CN.
           ACCEPT PO-DATE FROM DATE.
           IF PO-DATE-YY > "70"
               MOVE "19"                TO  PO-DATE-CC
           ELSE
           MOVE "20"                    TO  PO-DATE-CC.
           MOVE SPACES                  TO  PO-LAST-PAYMENT.
           WRITE DPORECD-REC-O FROM BUF-DPORECD
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE "PUT DPORECD * 61-BD"  TO  BU-DISPLAY-MSG
               PERFORM 2-BLOWUP.

      *------- CREATE TC 360
           MOVE "360"                TO  STC360-TC.
           MOVE MPLTINFO-COMPANY     TO  STC360-COMPANY-SAVE.
           CALL "STC360" USING BASE,
                               STC360-COMPANY-SAVE,
                               STC360-TC,
                               BUF-DPORECD,
                               STATUS-AREA,
                               BU-DISPLAY-MSG,
                               BU-DISPLAY-FLDS.
           IF BU-DISPLAY-MSG NOT = SPACES
               PERFORM 2-BLOWUP.

           PERFORM 62-CREATE-BLKT  THRU  62-CB-X.

      *------- DO A START > HIGH-VALUES TO UNLOCK BOTH DPOITEM-O AND
      *------- DPODATAITM-O SINCE THEY ARE READ IN 62-CREATE-BLKT
           MOVE HIGH-VALUES TO PORCVNO OF DPOITEM-REC-O.
           START DPOITEM-O KEY > PORCVNO OF DPOITEM-REC-O
               INVALID KEY MOVE "00" TO FILE-STATUS.
           MOVE HIGH-VALUES TO PORCVNO OF DPODATAITM-REC-O.
           START DPODATAITM-O KEY > PORCVNO OF DPODATAITM-REC-O
               INVALID KEY MOVE "00" TO FILE-STATUS.

           MOVE SPACES  TO SCREEN-1.
      *  PROCESS COMPLETE; ENTER NEXT ORDERS OR 'F3' TO EXIT
           MOVE  16 TO LANG-SETNUM.
           MOVE  86 TO LANG-MSGNUM.
           PERFORM 999-CATREAD.
           MOVE MESSAGE-BUFFER TO TRM-COMMAND-LINE.
           MOVE B"1" TO IND (98).
           GO TO 61-SHOWFORM-SCREEN-1.

       61-CBN-X.
           EXIT.

      **************************************************************
       610-CHECK-4-BLANKET.
      **************************************************************
           MOVE "000"             TO PO-REL.
           MOVE BUILD-PO-SEARCH   TO PO-ARG,
                                     BU-DISPLAY-FLD (1).
           MOVE TRM-FROM-BLKTS (SUB-B) TO PO-NO.
           MOVE BUILD-PO-SEARCH   TO PORCVNO OF DPORECD-REC-O.
           READ DPORECD-O INTO BUF-DPORECD
               INVALID KEY    MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               NEXT SENTENCE
           ELSE
           IF PO-NON-RCV-INDIC = "X"
               IF PO-EXPECT-MM = "12"
                   IF PO-EXPECT-DD > "29"
                       MOVE 1     TO BLANKET-SW.
           MOVE HIGH-VALUES       TO PORCVNO OF DPORECD-REC-O,
                                                MPORCV-REC-O.
           START DPORECD-O KEY > PORCVNO OF DPORECD-REC-O
               INVALID KEY    MOVE "00" TO FILE-STATUS.
           START MPORCV-O KEY > PORCVNO OF MPORCV-REC-O
               INVALID KEY    MOVE "00" TO FILE-STATUS.

      **************************************************************
       62-CREATE-BLKT.
      **************************************************************
           PERFORM 622-CREATE-SORT-FILE.
           PERFORM 620-GET-ITEMS VARYING SUB-B FROM 1 BY 1
               UNTIL SUB-B > MAX-BLKTS.

           CLOSE ITEM-FILE.

      ***   SORTING REQUIREMENT ITEMS BY CORPORATE CODE
           MOVE  19 TO LANG-SETNUM.
           MOVE  21 TO LANG-MSGNUM.
           PERFORM 999-CATREAD.
           MOVE MESSAGE-BUFFER TO TRM-COMMAND-LINE.
           MOVE B"1" TO IND (98).
           MOVE SCREEN-1 TO DISPLAY-REC.
           PERFORM 998-WRITE-SCREEN.
           PERFORM 998-AUTO-READ-SCREEN.

           SORT SORT-FILE ON ASCENDING KEY SORT-CORP-CODE
               USING ITEM-FILE
               GIVING ITEM-FILE.

           OPEN INPUT ITEM-FILE.

           MOVE SPACES          TO  DONE-PROCESS-ITEMS.
           MOVE ZEROS           TO  TOTAL-ITEM-CTR.
           MOVE   8 TO LANG-SETNUM.
           MOVE   2 TO LANG-MSGNUM.
           PERFORM 999-CATREAD.
           MOVE MESSAGE-BUFFER TO LB-MT-1R.
           MOVE  66163 TO CATREAD-MSG-NUMBER.
           PERFORM 999-CATREAD.
           MOVE MESSAGE-BUFFER TO LB-MT-2R.
           MOVE  66162 TO CATREAD-MSG-NUMBER.
           PERFORM 999-CATREAD.
           MOVE MESSAGE-BUFFER TO LB-MT-3R.
           MOVE SPACES TO MESSAGE-BUFFER.
           MOVE LB-MT-1R  TO  MSG-TEXT-1R.
           MOVE LB-MT-2R  TO  MSG-TEXT-2R.
           MOVE LB-MT-3R  TO  MSG-TEXT-AS400.

       62-START-READING-ITEMS.
           MOVE 0               TO  SUB.

       62-GET-DPOITEM-CALC.
           ADD 1  TO  SUB.
           IF SUB > 10
               GO TO 62-DISPLAY-MESSAGE.

           PERFORM 621-READ-ITEM-FILE.

           IF DONE-PROCESS-ITEMS = "Y"
               GO TO 62-DISPLAY-MESSAGE.

           ADD 1                        TO  TOTAL-ITEM-CTR.

           MOVE SAVE-NEW-PO-NUM         TO  ITM-PO-RCV-NO.
           MOVE TOTAL-ITEM-CTR          TO  ITM-NUMBER.

           IF ITM-CORP-CODE = "NON-STR"
               NEXT SENTENCE
           ELSE
               MOVE ITM-CORP-CODE       TO  CODE-ARG
               MOVE CODE-ARG TO CORPCDE OF MSTORERM-REC-I
               READ MSTORERM-I INTO BUF-MSTORERM
                   INVALID KEY MOVE FILE-STATUS TO FILE-STATUS END-READ
               IF FILE-STATUS NOT = "00"
                   MOVE "GET * 62-GDC"  TO  BU-DISPLAY-MSG
                   PERFORM 2-BLOWUP.

           IF ITM-CORP-CODE = "NON-STR"
               NEXT SENTENCE
           ELSE
               IF ITM-CLASS = SPACES
                   MOVE STR-CLASS       TO ITM-CLASS.

           MOVE 0      TO ITM-QTY-DLVR
                          ITM-QTY-STORED
                          ITM-QTY-PAID.
           MOVE SPACES TO ITM-DATE-RCVD
                          ITM-DATE-STORED.

           WRITE DPOITEM-REC-O FROM BUF-DPOITEM
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE "PUT DPOITEM * 62-GDC"  TO  BU-DISPLAY-MSG
               PERFORM 2-BLOWUP.

           PERFORM 63-LOAD-DPODATAITM  THRU 63-LD-X.

       62-BUILD-DDAILYTC-320.
           MOVE SPACES                  TO  STC320-PARMS.
           MOVE MPLTINFO-COMPANY        TO  STC320-COMPANY-SAVE.
           MOVE "20"                    TO  STC320-ITEM-TC-ID.
           MOVE ITM-PO-RCV-NO           TO  STC320-PO-NUM.
           MOVE ITM-NUMBER              TO  STC320-ITEM.
           IF ITM-CORP-CODE = "NON-STR"
               MOVE "NC"                TO  STC320-CODE
               MOVE ITM-PRICE-UM        TO  STC320-QTY-UM,
                                            STC320-PRICE-UM
               MOVE ITM-UNIT-PRICE      TO  STC320-PRICE
           ELSE
               MOVE ITM-CORP-CODE       TO  STC320-CODE
               MOVE STR-UM              TO  STC320-QTY-UM,
                                            STC320-PRICE-UM
               IF ITM-PRICE-UM = STR-UM
                   MOVE ITM-UNIT-PRICE  TO  STC320-PRICE
               ELSE
               IF ITM-PRICE-UM = STR-UM1
                   DIVIDE ITM-UNIT-PRICE  BY STR-UM1-CF
                                        GIVING STC320-PRICE ROUNDED
               ELSE
               IF ITM-PRICE-UM = STR-UM2
                   DIVIDE ITM-UNIT-PRICE  BY STR-UM2-CF
                                        GIVING STC320-PRICE ROUNDED
               ELSE
                   MOVE ZEROS           TO  STC320-PRICE.
           MOVE ZEROS                   TO  STC320-QTY.
           MOVE ITM-TAX-CODE            TO  STC320-TAX-CODE.
           MOVE ZEROS                   TO  STC320-OLD-BUDGET-AMT.
           IF ITM-CLASS = SPACES
               IF ITM-CORP-CODE = "NON-STR"
                   NEXT SENTENCE
               ELSE
                   MOVE STR-CLASS       TO  STC320-SUB
           ELSE
               MOVE ITM-CLASS           TO  STC320-SUB.
           MOVE ITM-COMPANY             TO  STC320-COMPANY.
           MOVE ITM-PRIME               TO  STC320-PRIME.
           MOVE ITM-SUB-DETL            TO  STC320-SUBD.
           MOVE ITM-ADDL-DATA           TO  STC320-ADDTL-DATA.
           MOVE PO-BUDGET-NUMBER        TO  STC320-BUDGET-NO.
           MOVE PO-CURRENCY-CODE        TO  STC320-CUR-CODE.
           CALL "STC320" USING BASE,
                               STC320-PARMS,
                               STATUS-AREA,
                               BU-DISPLAY-MSG,
                               BU-DISPLAY-FLDS.
           IF BU-DISPLAY-MSG-1  NOT = SPACES
               PERFORM 2-BLOWUP.

           GO TO 62-GET-DPOITEM-CALC.

       62-DISPLAY-MESSAGE.
           MOVE TOTAL-ITEM-CTR   TO  MSG-ITEM-NO.
           MOVE MESSAGE-BUFFER TO TRM-COMMAND-LINE.
           MOVE B"1" TO IND (98).
           MOVE SCREEN-1 TO DISPLAY-REC.
           PERFORM 998-WRITE-SCREEN.
           PERFORM 998-AUTO-READ-SCREEN.

           IF DONE-PROCESS-ITEMS = "Y"
               NEXT SENTENCE
           ELSE
               GO TO 62-START-READING-ITEMS.

       62-UPDATE-DPODATAITM.
           CLOSE ITEM-FILE.

           MOVE PO-ARG TO PORCVNO OF DPODATAITM-REC-O.
           START DPODATAITM-O KEY = PORCVNO OF DPODATAITM-REC-O
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
                   GO TO 62-CB-X
               ELSE
                   MOVE "FIND * 62-UD"  TO  BU-DISPLAY-MSG
                   PERFORM 2-BLOWUP.

       62-GET-DPODATAITM.
           READ DPODATAITM-O NEXT INTO BUF-DPODATAITM
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   GO TO 62-CB-X
               ELSE
                   MOVE "READ DPODATAITM *62-GD" TO BU-DISPLAY-MSG
                   PERFORM 2-BLOWUP.
           IF PORCVNO OF DPODATAITM-REC-O NOT = PO-ARG
               GO TO 62-CB-X.

      *------ ONLY LOAD ITEM NUMBER ZEROS (STD INSTR) SINCE THE
      *------ ITEM DESCRIPTIONS WERE LOADED PREVIOUSLY
           IF DATAITM-ITEM-NO-9 = ZEROS
               NEXT SENTENCE
           ELSE
               GO TO 62-CB-X.

           MOVE SAVE-NEW-PO-NUM       TO  DATAITM-PO-RCV-NO.
           WRITE DPODATAITM-REC-O FROM BUF-DPODATAITM
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE "PUT DPODATAITM * 62-GD"  TO  BU-DISPLAY-MSG
               PERFORM 2-BLOWUP.

           GO TO 62-GET-DPODATAITM.

       62-CB-X.
           EXIT.

      **************************************************************
       620-GET-ITEMS.
      **************************************************************
           IF TRM-FROM-BLKTS (SUB-B) > SPACES
             MOVE TRM-FROM-BLKTS (SUB-B)       TO  PO-NO
             MOVE BUILD-PO-SEARCH              TO  PO-ARG
             MOVE PO-ARG TO PORCVNO OF DPOITEM-REC-O
             START DPOITEM-O KEY = PORCVNO OF DPOITEM-REC-O
                 INVALID KEY MOVE FILE-STATUS TO FILE-STATUS
             END-START
             IF FILE-STATUS NOT = "00"
                 IF FILE-STATUS-1 = "2"
                     NEXT SENTENCE
                 ELSE
                     MOVE "FIND * 62-CB"  TO  BU-DISPLAY-MSG
                     PERFORM 2-BLOWUP
                 END-IF
             END-IF
             PERFORM 63-SORT-ITEMS.

      **************************************************************
       621-READ-ITEM-FILE.
      **************************************************************
           READ ITEM-FILE
               AT END MOVE "Y" TO DONE-PROCESS-ITEMS.

           IF ITEM-CORP-CODE = HOLD-CORP-CODE
               PERFORM UNTIL ITEM-CORP-CODE NOT = HOLD-CORP-CODE
                          OR DONE-PROCESS-ITEMS = "Y"
                   READ ITEM-FILE
                       AT END MOVE "Y" TO DONE-PROCESS-ITEMS
                   END-READ
               END-PERFORM.

           IF DONE-PROCESS-ITEMS NOT = "Y"
               MOVE ITEM-PO-NUM      TO  PORCVNO OF DPOITEM-REC-O
                                         PO-ARG
               MOVE ITEM-NUMBER      TO  ITEMNO OF DPOITEM-REC-O
               READ DPOITEM-O INTO BUF-DPOITEM
                   INVALID KEY MOVE FILE-STATUS TO FILE-STATUS
               END-READ
               IF FILE-STATUS NOT = "00"
                   MOVE "READ DPOITEM * 621-RIF" TO BU-DISPLAY-MSG
                   PERFORM 2-BLOWUP
               END-IF
               MOVE ITEM-CORP-CODE TO HOLD-CORP-CODE.

      **************************************************************
       622-CREATE-SORT-FILE.
      **************************************************************
      *----- CALL CCRTFILE TO CREATE A TEMPORARY FILE 'ITEMFILE'
      *----- LIBRARY 'QTEMP' IS USED FOR TEMPORARY FILES
           MOVE SPACES        TO CCRTFILE-PARMS.
           MOVE "QTEMP"       TO CCRTFILE-LIBRARY.
           MOVE "ITEMFILE"    TO CCRTFILE-FILE.
           MOVE "0025"        TO CCRTFILE-RECORD-LENGTH.
           MOVE "01000"       TO CCRTFILE-NO-RECORDS.
           MOVE "00100"       TO CCRTFILE-INCREMENT-AMT.
           MOVE "10"          TO CCRTFILE-NO-INCREMENTS.
           CALL "CCRTFILE" USING CCRTFILE-LIBRARY,
                                 CCRTFILE-FILE,
                                 CCRTFILE-RECORD-LENGTH,
                                 CCRTFILE-NO-RECORDS,
                                 CCRTFILE-INCREMENT-AMT,
                                 CCRTFILE-NO-INCREMENTS,
                                 CCRTFILE-STATUS.
           IF CCRTFILE-STATUS NOT = "00"
               MOVE "CCRTFILE CREATE OF 'PRNTWORK' FAILED"
                  TO BU-DISPLAY-MSG
               PERFORM 2-BLOWUP.

           OPEN OUTPUT ITEM-FILE.

      **************************************************************
       63-SORT-ITEMS.
      **************************************************************
      ***   READING REQUIREMENT ITEMS AND LOADING SORT FILE
           MOVE  18 TO LANG-SETNUM.
           MOVE  50 TO LANG-MSGNUM.
           PERFORM 999-CATREAD.
           MOVE MESSAGE-BUFFER TO TRM-COMMAND-LINE.
           MOVE B"1" TO IND (98).
           MOVE SCREEN-1 TO DISPLAY-REC.
           PERFORM 998-WRITE-SCREEN.
           PERFORM 998-AUTO-READ-SCREEN.

           MOVE ZEROS TO COND-WORD.
           PERFORM 64-LOAD-ITEM-FILE
               UNTIL END-OF-CHAIN.


      **************************************************************
       63-LOAD-DPODATAITM.
      **************************************************************
           MOVE PO-ARG TO PORCVNO OF DPODATAITM-REC-O.
           START DPODATAITM-O KEY = PORCVNO OF DPODATAITM-REC-O
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
                   GO TO 63-LD-X
               ELSE
                   MOVE "FIND * 63-LD"  TO  BU-DISPLAY-MSG
                   PERFORM 2-BLOWUP.

       63-GET-DPODATAITM.
           READ DPODATAITM-O NEXT INTO BUF-DPODATAITM
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   GO TO 63-LD-X
               ELSE
                   MOVE "GET DPODATAITM * 63-GET-DPODATA"
                       TO  BU-DISPLAY-MSG
                   PERFORM 2-BLOWUP.
           IF PORCVNO OF DPODATAITM-REC-O NOT = PO-ARG
               GO TO 63-LD-X.

           IF DATAITM-ITEM-NO-9 < ITEM-NUMBER
               NEXT SENTENCE
           ELSE
           IF DATAITM-ITEM-NO-9 > ITEM-NUMBER
               GO TO 63-LD-X
           ELSE
               MOVE SAVE-NEW-PO-NUM     TO  DATAITM-PO-RCV-NO
               MOVE TOTAL-ITEM-CTR      TO  DATAITM-ITEM-NO-9
               WRITE DPODATAITM-REC-O FROM BUF-DPODATAITM
                   INVALID KEY MOVE FILE-STATUS TO FILE-STATUS
                       END-WRITE
               IF FILE-STATUS NOT = "00"
                   MOVE "PUT DPODATAITM * 63-GD"  TO  BU-DISPLAY-MSG
                   PERFORM 2-BLOWUP.

           GO TO 63-GET-DPODATAITM.

       63-LD-X.
           EXIT.


      **************************************************************
       64-LOAD-ITEM-FILE.
      **************************************************************
           MOVE 0 TO COND-WORD.
           READ DPOITEM-O NEXT INTO BUF-DPOITEM
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   MOVE 15 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.
           IF PORCVNO OF DPOITEM-REC-O NOT = PO-ARG
               MOVE 15 TO COND-WORD.
           IF COND-WORD NOT = 0
               IF END-OF-CHAIN
                   NEXT SENTENCE
               ELSE
                   MOVE "GET DPOITEM * 64-LIF" TO BU-DISPLAY-MSG
                   PERFORM 2-BLOWUP
           ELSE
               MOVE ITM-NUMBER          TO ITEM-NUMBER
               MOVE ITM-CORP-CODE       TO ITEM-CORP-CODE
               MOVE ITM-PO-RCV-NO       TO ITEM-PO-NUM
               WRITE ITEM-RCD.

       COPY DISPCALL IN COPYLIB.

      **************************************************************
       998-AUTO-READ-SCREEN.
      **************************************************************
           READ  DISPLAY-FILE TERMINAL IS TERMINAL-ID
               INDIC ARE SRF-INDICATORS
                   NO DATA MOVE DISPLAY-STATUS TO DISPLAY-STATUS.
           MOVE ALL B"0" TO SRF-INDICATORS.

      **************************************************************
       999-CATREAD.
      **************************************************************
           IF CATREAD-MSG-NUMBER = ZEROS
               MOVE LANG-SETNUM TO CATREAD-MSG-SET
               MOVE LANG-MSGNUM TO CATREAD-MSG-NUM.
           CALL "CCATREAD" USING CATREAD-PARMS.
           MOVE CATREAD-MSG-TEXT TO MESSAGE-BUFFER.
