000200 IDENTIFICATION DIVISION.
000300 PROGRAM-ID. TFREEUSG.
000400*REMARKS.    THIS PROGRAM CHECKS THE MSTORERM DATASET FOR
      *D           FREE STORES INFORMATION.
      *C
      *C 09/12/96  JEFF BUNGO
      *C    EXPAND DATE FIELDS FOR YEAR 2000 COMPLIANCE.
      *C    RECOMPILE TO PICK UP COPYLIB CHANGES.
      *C
      *C  11/25/97    JEFF BUNGO   REQ #97-017
      *C     ADD USAGE FIELDS FOR DIRECT DELIVERY.  DD USAGE
      *C     TO BE STORED IN ADDITIONAL FIELD AND TOTAL USAGE.
      *C     STORE ISSUE USAGE CALCULATED BY TOTAL USAGE - DD USAGE.
      *C
000500 ENVIRONMENT DIVISION.
000600 CONFIGURATION SECTION.
000700 SOURCE-COMPUTER. AS400.
000800 OBJECT-COMPUTER. AS400.
       COPY SPECIALN OF COPYLIB.
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT DCODE-FILE
               ASSIGN TO DATABASE-MCFLCS3402
               ORGANIZATION IS INDEXED
               ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
               FILE STATUS IS FILE-STATUS.
           SELECT MSTORERM-FILE
               ASSIGN TO DATABASE-MCFLCS0201
               ORGANIZATION IS INDEXED
               ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
               FILE STATUS IS FILE-STATUS.
           SELECT SORT-FILE
               ASSIGN TO DISK-SORTFILE.
           SELECT USAGE-FILE
               ASSIGN TO DATABASE-MCFLCSUSAG
               ORGANIZATION IS INDEXED
               ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
               FILE STATUS IS FILE-STATUS.
           SELECT ONLINE-PRT ASSIGN TO PRINTER-MCPRT.
000900 DATA DIVISION.
       FILE SECTION.
       FD  DCODE-FILE
           LABEL RECORDS ARE STANDARD.
       01  DF-REC.
           COPY DDS-ALL-FORMATS OF MCFLCS3402.
       FD  MSTORERM-FILE
           LABEL RECORDS ARE STANDARD.
       01  MF-REC.
           COPY DDS-ALL-FORMATS OF MCFLCS0201.
       FD  ONLINE-PRT
           LABEL RECORDS ARE OMITTED
           RECORD CONTAINS 132 CHARACTERS
           DATA RECORD IS PRINT-RCD.
       01  PRINT-RCD.
           05  PRINT-LINE           PIC X(132).
       SD  SORT-FILE RECORD CONTAINS 180 CHARACTERS
           DATA RECORD IS SORT-REC.
       01  SORT-REC.
           05  SORT-CORPCDE         PIC X(8).
           05  SORT-KEYADJ          PIC X(50).
           05  SORT-YRLYUSAG        PIC 9(9).
           05  SORT-MKTCOST         PIC 9(8)V9(4).
           05  SORT-YRLYCOST        PIC 9(8)V9(4).
           05  SORT-DESC            PIC X(80).
           05  FILLER               PIC X(9).
       FD  USAGE-FILE
           LABEL RECORDS ARE STANDARD.
       01  UF-REC.
           COPY DDS-ALL-FORMATS OF MCFLCSUSAG.
001000 WORKING-STORAGE SECTION.
       77  FREE-STORES-SW           PIC X.
       77  LINE-CTR                 PIC 99.
       77  SAVE-DESC                PIC X(80).
       77  SAVE-CODE                PIC X(8)   VALUE SPACES.
       77  SUB1                     PIC S9(4) COMP-4.
       77  SUB2                     PIC S9(4) COMP-4.
       77  SUB-TOTAL-RCDS           PIC S9(5) COMP-4.
       77  SUB-TOTAL-YRLYCOST       PIC S9(11)V9(4).
       77  TOTAL-RCDS               PIC S9(5) COMP-4.
       77  TOTAL-YRLYCOST           PIC S9(11)V9(4).

001300 01  BLOWUP-BASE              PIC X(16).
       01  CDATE.
           05 YY                    PIC 99.
           05 MM                    PIC 99.
           05 DD                    PIC 99.
       COPY CDESC      IN COPYLIB.
       01  CODE-ARG                 PIC X(8).
006000 01  COMP-ESC-SEQ             PIC X(8)  VALUE SPACES.
       COPY DATAB      IN COPYLIB.
       01  DDATE.
           05 DMM                   PIC 99.
           05 FILLER                PIC X      VALUE "/".
           05 DDD                   PIC 99.
           05 FILLER                PIC X      VALUE "/".
           05 DYY                   PIC 99.
       01  DESC-WA.
           05  D-WA OCCURS 80 TIMES PIC X.
       01  DETAIL-1.
           05  D-CORPCDE            PIC X(8)   VALUE SPACES.
           05  FILLER               PIC X(2)   VALUE SPACES.
           05  D-KEYADJ             PIC X(50)  VALUE SPACES.
           05  FILLER               PIC X(3)   VALUE SPACES.
           05  D-YRLYUSAG           PIC Z(9).
           05  FILLER               PIC X(10)  VALUE SPACES.
           05  D-MKTCOST            PIC $$,$$$,$$9.9(4).
           05  FILLER               PIC X(10)  VALUE SPACES.
           05  D-YRLYCOST           PIC $$,$$$,$$$,$$9.9(4).
           05  FILLER               PIC X(9)   VALUE SPACES.
       COPY DCODE      IN COPYLIB.
       COPY ESCMAIN    IN COPYLIB.
       01  FILE-STATUS.
           05  FILE-STATUS-1        PIC X.
           05  FILE-STATUS-2        PIC X.

008700*------ PARMS FOR CALL TO "THDPRT2" - HEADER PAGE SUBPROG.
008800 01  HD-RET-CODE                PIC S9(4) COMP-4 VALUE 0.
008900 01  HD-FILE-NAME               PIC X(17) VALUE "DFREEUSG".
009000 01  FNUM                       PIC S9(4) COMP-4 VALUE 0.
009200
       01  HEADER-1.
            05  FILLER              PIC X(30) VALUE SPACES.
            05  FILLER              PIC X(25)
                VALUE "Free Stores Usage Report ".
            05  FILLER              PIC X(26)
                VALUE "for the Previous 12 Month ".
            05  FILLER              PIC X(6)
                VALUE "Period".
            05  FILLER              PIC X(45) VALUE SPACES.
       01  HEADER-2.
           05  FILLER               PIC X(7)
               VALUE "CORPCDE".
           05  FILLER               PIC X(3)  VALUE SPACES.
           05  FILLER               PIC X(50)
               VALUE "KEYWORDADJ".
           05  FILLER               PIC X(3)  VALUE SPACES.
           05  FILLER               PIC X(10)
               VALUE "YEARLYUSAG".
           05  FILLER               PIC X(11) VALUE SPACES.
           05  FILLER               PIC X(7)
               VALUE "MKTCOST".
           05  FILLER               PIC X(16) VALUE SPACES.
           05  FILLER               PIC X(10)
               VALUE "YEARLYCOST".
           05  FILLER               PIC X(15) VALUE SPACES.
       01  HEADER-U.
           05  FILLER               PIC X(132) VALUE ALL "-".
       COPY IOFEEDBACK IN COPYLIB.
003800 COPY LANGSUB    IN COPYLIB.
       COPY MSTORERM   IN COPYLIB.
       COPY OVRPFDATA  IN COPYLIB.
007300 01  PAPER-VALUE              PIC S9(4) COMP-4 VALUE ZEROES.
006100 01  STAND-ESC-SEQ            PIC X(8)  VALUE SPACES.
004900 COPY TBLOWUP    IN COPYLIB.
       COPY TDATECHK   IN COPYLIB.
       01  TOTAL-LINE.
           05  FILLER               PIC X(12) VALUE "TOTAL CODES ".
           05  TOTAL-CODES          PIC Z(9).
           05  FILLER               PIC X(86) VALUE SPACES.
           05  TOTAL-YRCOST         PIC $$,$$$,$$$,$$9.9(4).
           05  FILLER               PIC X(09) VALUE SPACES.
       COPY VCOMLINK   IN COPYLIB.
       LINKAGE SECTION.
       COPY THDPRTB    IN COPYLIB.
022100
007500 01  OPTION-REC                    PIC X(80).
007600
005200 PROCEDURE DIVISION USING HD-ROUTE-DATA, OPTION-REC.
005300 START-PGM SECTION.
       BEGIN-PGM.
005400     PERFORM 1-HSK.
005500     PERFORM 6-MAIN THRU 6-MAIN-X.
005600 2-EOJ.
           MOVE STAND-ESC-SEQ TO PRINT-RCD.
           WRITE PRINT-RCD AFTER ADVANCING 0 LINES.
           CLOSE DCODE-FILE.
           CLOSE MSTORERM-FILE.
           CLOSE ONLINE-PRT.
           CLOSE USAGE-FILE.
006000     GOBACK.
023200 2-BLOWUP.
023300     MOVE "TFREEUSG"   TO BU-PGM-NAME.
023400     CALL "TBLOWUP" USING BLOWUP-BASE BU-PGM-NAME STATUS-AREA
023500                      VIEW-COMAREA DUMMY-KSAM-STAT
023600                      BU-DISPLAY-MSG BU-DISPLAY-FLDS.
006100 1-HSK.
           OPEN INPUT  DCODE-FILE.
           OPEN INPUT  MSTORERM-FILE.

           CALL "TESCSEQ" USING ESC-NAME.
022700     MOVE CHAR-1636PI TO COMP-ESC-SEQ.
022800     MOVE CHAR-10PI TO STAND-ESC-SEQ.

           MOVE HD-SPOOLER-NUMBER TO OVRPRTF-TOFILE-NUM.
           MOVE "*YES"            TO OVRPRTF-SHARED.
           MOVE HD-NO-OF-COPIES   TO OVRPRTF-COPIES.
           MOVE "MCPRT"        TO OVRPRTF-FILE.
           PERFORM 996-OVERRIDE-PRINT-FILE.
           OPEN OUTPUT ONLINE-PRT.
027000     CALL "THDPRT2" USING HD-RET-CODE, HD-FILE-NAME, FNUM
027100       HD-ROUTE-DATA, ESC-NAME.
027200     IF HD-RET-CODE NOT = 0
027300         MOVE "THDPRT2 ERROR IN HSK" TO BU-DISPLAY-MSG
027400         MOVE "HD-RET-CODE = " TO BU-DISPLAY-FLD (1)
027500         MOVE HD-RET-CODE      TO BU-DISPLAY-FLD9 (1)
027600         GO TO 2-BLOWUP.
027700
027800     IF PAPER-VALUE = 0 OR 80
027900        MOVE COMP-ESC-SEQ TO PRINT-RCD
028000        WRITE PRINT-RCD BEFORE ADVANCING 0 LINES.

           OPEN INPUT  USAGE-FILE.
           MOVE 55             TO LINE-CTR.
           MOVE ZEROES         TO SUB-TOTAL-RCDS,
                                  SUB-TOTAL-YRLYCOST,
                                  TOTAL-RCDS,
                                  TOTAL-YRLYCOST.
           MOVE SPACES         TO SAVE-DESC.

       COPY OVRPFCALL IN COPYLIB.

       6-MAIN.
           SORT SORT-FILE ASCENDING SORT-DESC,
                                    SORT-CORPCDE
               INPUT  PROCEDURE 7-INPUT-RECORDS
               OUTPUT PROCEDURE 8-WRITE-OUTPUT.
       6-MAIN-X.    EXIT.

       7-INPUT-RECORDS SECTION.
       7-IR.
           READ MSTORERM-FILE NEXT INTO BUF-MSTORERM
               AT END    MOVE 11 TO COND-WORD.
           IF FILE-STATUS NOT = "00" MOVE 11 TO COND-WORD.
           IF COND-WORD = 11 GO TO 7-IR-X.
           IF CORP-CODE = "NON-STR " GO TO 7-IR.
           IF STR-DFLT-DEPT = "9912  "
               IF STR-DIR-CHRG-DEPT = "9912  "
                   NEXT SENTENCE
               ELSE
               GO TO 7-IR
           ELSE
           GO TO 7-IR.

           MOVE CORP-CODE      TO  CODE-ARG.
           MOVE 25             TO  CDESC-LINES-TO-GET.
           MOVE "R"            TO  CDESC-LOCAL-DESC-OPTION.
           CALL "CDESC" USING CDESC-RET-CODE, BASE, STATUS-AREA,
                          BU-DISPLAY-MSG, CODE-ARG, CDESC-DATA.
           IF BU-DISPLAY-MSG-1 NOT = SPACES
               PERFORM 2-BLOWUP.

           MOVE "N"            TO FREE-STORES-SW.
           MOVE 0              TO SUB1.
           PERFORM 70-CHECK-LITERAL THRU 70-CL-X.
           IF FREE-STORES-SW = "N" GO TO 7-IR.

           MOVE CORP-CODE      TO CORPCDE OF DF-REC.
           START DCODE-FILE KEY = EXTERNALLY-DESCRIBED-KEY
               INVALID KEY    MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00" GO TO 7-IR.
       7-IR-LOOP.
           READ DCODE-FILE NEXT INTO BUF-DCODE
               AT END    MOVE FILE-STATUS TO FILE-STATUS.
           IF CORP-CODE NOT = CODE-KEY-CODE GO TO 7-IR.
           IF FILE-STATUS NOT = "00" GO TO 7-IR.

           MOVE CORP-CODE        TO SORT-CORPCDE.
           MOVE CODE-KEYWORD-MOD TO SORT-KEYADJ.
           MOVE STR-MKT-COST     TO SORT-MKTCOST.
           MOVE CORP-CODE        TO CORPCDE OF UF-REC.
           READ USAGE-FILE
               INVALID KEY    MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
                   MOVE ZEROES   TO SORT-YRLYUSAG
                                    SORT-YRLYCOST
                   RELEASE SORT-REC
                   GO TO 7-IR.
           COMPUTE SORT-YRLYUSAG = USAGJAN + USAGFEB + USAGMAR +
               USAGAPR + USAGMAY + USAGJUN + USAGJUL + USAGAUG +
               USAGSEP + USAGOCT + USAGNOV + USAGDEC.
           MULTIPLY SORT-YRLYUSAG BY SORT-MKTCOST
               GIVING SORT-YRLYCOST.
           RELEASE SORT-REC.
           GO TO 7-IR.

       70-CHECK-LITERAL.
           ADD 1             TO SUB1.
           IF SUB1 > 25 GO TO 70-CL-X.
           MOVE CDESC (SUB1) TO DESC-WA.
           MOVE 0            TO SUB2.
           PERFORM 700-CK-LITERAL-VALUE THRU 700-CLV-X.
           GO TO 70-CHECK-LITERAL.
       70-CL-X.    EXIT.

       700-CK-LITERAL-VALUE.
           ADD 1 TO SUB2.
           IF SUB2 > 80 GO TO 700-CLV-X.
           IF D-WA (SUB2) = "F"
               NEXT SENTENCE
           ELSE
           GO TO 700-CK-LITERAL-VALUE.
           ADD 1 TO SUB2,
           IF D-WA (SUB2) = "R"
               NEXT SENTENCE
           ELSE
           GO TO 700-CK-LITERAL-VALUE.
           ADD 1 TO SUB2.
           IF D-WA (SUB2) = "E"
               NEXT SENTENCE
           ELSE
           GO TO 700-CK-LITERAL-VALUE.
           ADD 1 TO SUB2.
           IF D-WA (SUB2) = "E"
               NEXT SENTENCE
           ELSE
           GO TO 700-CK-LITERAL-VALUE.
           ADD 2 TO SUB2.
           IF D-WA (SUB2) = "S"
               NEXT SENTENCE
           ELSE
           GO TO 700-CK-LITERAL-VALUE.
           ADD 1 TO SUB2.
           IF D-WA (SUB2) = "T"
               NEXT SENTENCE
           ELSE
           GO TO 700-CK-LITERAL-VALUE.
           ADD 1 TO SUB2.
           IF D-WA (SUB2) = "O"
               NEXT SENTENCE
           ELSE
           GO TO 700-CK-LITERAL-VALUE.
           ADD 1 TO SUB2.
           IF D-WA (SUB2) = "R"
               NEXT SENTENCE
           ELSE
           GO TO 700-CK-LITERAL-VALUE.
           ADD 1 TO SUB2.
           IF D-WA (SUB2) = "E"
               NEXT SENTENCE
           ELSE
           GO TO 700-CK-LITERAL-VALUE.
           ADD 1 TO SUB2.
           IF D-WA (SUB2) = "S"
               MOVE DESC-WA TO SORT-DESC
               MOVE 80  TO SUB2
               MOVE "Y" TO FREE-STORES-SW
               MOVE 25  TO SUB1.
           GO TO 700-CK-LITERAL-VALUE.
       700-CLV-X.    EXIT.

       7-IR-X.    EXIT.

       8-WRITE-OUTPUT SECTION.
       8-WO.
           RETURN SORT-FILE AT END
               WRITE PRINT-RCD FROM HEADER-U AFTER ADVANCING 1 LINES
               ADD SUB-TOTAL-RCDS      TO  TOTAL-RCDS
               ADD SUB-TOTAL-YRLYCOST  TO  TOTAL-YRLYCOST
               MOVE TOTAL-RCDS         TO  TOTAL-CODES
               MOVE TOTAL-YRLYCOST     TO  TOTAL-YRCOST
               WRITE PRINT-RCD FROM TOTAL-LINE AFTER ADVANCING 1 LINES
               GO TO 8-WO-X.
           IF SAVE-DESC = SPACES
               MOVE SORT-DESC          TO  SAVE-DESC
               ADD 1                   TO  SUB-TOTAL-RCDS
               ADD SORT-YRLYCOST       TO  SUB-TOTAL-YRLYCOST
           ELSE
           IF SORT-DESC = SAVE-DESC
               ADD 1                   TO  SUB-TOTAL-RCDS
               ADD SORT-YRLYCOST       TO  SUB-TOTAL-YRLYCOST
           ELSE
           ADD 2 TO LINE-CTR
           IF LINE-CTR > 55
               WRITE PRINT-RCD FROM HEADER-1 AFTER ADVANCING NEW-PAGE
               WRITE PRINT-RCD FROM HEADER-2 AFTER ADVANCING 2 LINES
               WRITE PRINT-RCD FROM HEADER-U AFTER ADVANCING 1 LINES
               ADD SUB-TOTAL-RCDS      TO  TOTAL-RCDS
               ADD SUB-TOTAL-YRLYCOST  TO  TOTAL-YRLYCOST
               MOVE SUB-TOTAL-RCDS     TO  TOTAL-CODES
               MOVE SUB-TOTAL-YRLYCOST TO  TOTAL-YRCOST
               WRITE PRINT-RCD FROM TOTAL-LINE AFTER ADVANCING 1 LINES
               MOVE 0                  TO  SUB-TOTAL-RCDS
                                           SUB-TOTAL-YRLYCOST
               MOVE 4                  TO  LINE-CTR
               MOVE SORT-DESC          TO  SAVE-DESC
               ADD 1                   TO  SUB-TOTAL-RCDS
               ADD SORT-YRLYCOST       TO  SUB-TOTAL-YRLYCOST
           ELSE
           WRITE PRINT-RCD FROM HEADER-U AFTER ADVANCING 1 LINES
           ADD SUB-TOTAL-RCDS          TO  TOTAL-RCDS
           ADD SUB-TOTAL-YRLYCOST      TO  TOTAL-YRLYCOST
           MOVE SUB-TOTAL-RCDS         TO  TOTAL-CODES
           MOVE SUB-TOTAL-YRLYCOST     TO  TOTAL-YRCOST
           WRITE PRINT-RCD FROM TOTAL-LINE AFTER ADVANCING 1 LINES
           MOVE 0                      TO  SUB-TOTAL-RCDS
                                           SUB-TOTAL-YRLYCOST
           WRITE PRINT-RCD FROM HEADER-1 AFTER ADVANCING NEW-PAGE
           WRITE PRINT-RCD FROM HEADER-2 AFTER ADVANCING 2 LINES
           MOVE SPACES                 TO  PRINT-RCD
           WRITE PRINT-RCD AFTER ADVANCING 1 LINES
           MOVE 4                      TO  LINE-CTR
           MOVE SORT-DESC              TO  SAVE-DESC
           ADD 1                       TO  SUB-TOTAL-RCDS
           ADD SORT-YRLYCOST           TO  SUB-TOTAL-YRLYCOST.

           MOVE SORT-CORPCDE           TO  D-CORPCDE.
           MOVE SORT-KEYADJ            TO  D-KEYADJ.
           MOVE SORT-YRLYUSAG          TO  D-YRLYUSAG.
           MOVE SORT-MKTCOST           TO  D-MKTCOST.
           MOVE SORT-YRLYCOST          TO  D-YRLYCOST.
           ADD 1                       TO  LINE-CTR.
           IF LINE-CTR > 55
               WRITE PRINT-RCD FROM HEADER-1 AFTER ADVANCING NEW-PAGE
               WRITE PRINT-RCD FROM HEADER-2 AFTER ADVANCING 2 LINES
               MOVE SPACES             TO  PRINT-RCD
               WRITE PRINT-RCD AFTER ADVANCING 1 LINES
               MOVE 5                  TO  LINE-CTR.
           WRITE PRINT-RCD FROM DETAIL-1 AFTER ADVANCING 1 LINES.
           GO TO 8-WO.
       8-WO-X.    EXIT.

