025800         10  UNFORMATTED-TIME-MN   PIC 9(2).
025900         10  UNFORMATTED-TIME-SS   PIC 9(2).
026000     05  VIEW-OPEN-FLAG            PIC X(1).
026100     05  SAVE-VIEW-COMAREALEN      PIC X(2).
026200     05  SAVE-VIEW-WINDOWENH       PIC X(2).
026300     05  SAVE-V5                   PIC S9(4) COMP-4.
026400     05  DATE-MSG                  PIC X(45).
026500
026600 COPY LANGSUB IN COPYLIB.
026700
026800 PROCEDURE DIVISION USING DATE-CHECK-AREA, LANGUAGE-PARMS.
026900 START-PROCESSING.
027000 6000-MAIN.
027100     IF DATE-MODE = 0
027200         PERFORM 6100-FLIP-DATES THRU 6100-FD-X
027300         GOBACK.
027400
027500     IF DATE-CODE = 0
027600         PERFORM 7000-GET-DATE-CODE THRU 7090-GDC-X.
027700
027800     MOVE SPACES                   TO  FORMATTED-TIME-OUT.
027900     MOVE SPACES                   TO  UNFORMATTED-TIME-OUT.
028000     MOVE "/"                      TO  DATE-SLASH-OUT-S1.
028100     MOVE "/"                      TO  DATE-SLASH-OUT-S2.
028200     MOVE 0                        TO  DATE-RET-CODE.
028300
028400     IF DATE-MODE = 1
               ACCEPT IBM-DATE-WORK FROM DATE
               MOVE IBM-DATE-WORK-MM TO DATE-SLASH-OUT-MD
               MOVE IBM-DATE-WORK-DD TO DATE-SLASH-OUT-DM
               MOVE IBM-DATE-WORK-YY TO DATE-SLASH-OUT-YY
028500*        MOVE CURRENT-DATE         TO  DATE-SLASH-OUT
028600         PERFORM 6200-CURRENT-DATE THRU 6290-CD-X.
028700     IF DATE-MODE = 2
028800         MOVE DATE-VALIDATE-IN     TO  DATE-SLASH-OUT
028900         PERFORM 6200-CURRENT-DATE THRU 6290-CD-X.
029000     IF DATE-MODE = 3
029100         PERFORM 6300-DISPLAY-DATE THRU 6390-DD-X
029200         IF DATE-RET-CODE = 1
029300             IF DATE-CODE = 3
                       MOVE
                       "THE FIELD MUST BE A VALID DATE, IN DMY ORDER"
                         TO DATE-MSG
029400                 MOVE  20 TO LANG-SETNUM  MOVE  52 TO LANG-MSGNUM
029500                 PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
029600             ELSE
                       MOVE
                       "THE FIELD MUST BE A VALID DATE, IN MDY ORDER"
                         TO DATE-MSG
029700                 MOVE  20 TO LANG-SETNUM  MOVE  53 TO LANG-MSGNUM
029800                 PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.

029900     IF DATE-MODE = 4
030000         PERFORM 6400-DATABASE-DATE THRU 6490-DD-X.
030100
030200     GOBACK.
030300
030400 6100-FLIP-DATES.
030500     MOVE DATE-IN TO DATE-OUT.
030600     IF DATE-CODE = 3 OR 5 OR 6 OR 8
030700         MOVE DATE-IN-MD TO DATE-OUT-DM
030800         MOVE DATE-IN-DM TO DATE-OUT-MD.
030900
031000 6100-FD-X.
031100     EXIT.
031200
031300 6200-CURRENT-DATE.
031400     MOVE ":"                      TO  FORMATTED-TIME-C1.
031500     MOVE ":"                      TO  FORMATTED-TIME-C2.
031600     MOVE DATE-SLASH-OUT-MD        TO  DATE-YMD-OUT-MM.
031700     MOVE DATE-SLASH-OUT-DM        TO  DATE-YMD-OUT-DD.
031800     MOVE DATE-SLASH-OUT-YY        TO  DATE-YMD-OUT-YY.
031900
032000     MOVE DATE-SLASH-OUT-MD        TO  DATE-OUT-MD.
032100     MOVE DATE-SLASH-OUT-DM        TO  DATE-OUT-DM.
032200     MOVE DATE-SLASH-OUT-YY        TO  DATE-OUT-YY.
032300
032400     IF DATE-CODE = 3
032500         PERFORM 7100-FLIP-DATE-SLASH-OUT
032600         PERFORM 7200-FLIP-DATE-OUT.
032700
           ACCEPT UNFORMATTED-TIME-OUT FROM TIME.
032800*    MOVE TIME-OF-DAY              TO  UNFORMATTED-TIME-OUT.
032900     MOVE UNFORMATTED-TIME-HH      TO  FORMATTED-TIME-HH.
033000     MOVE UNFORMATTED-TIME-MN      TO  FORMATTED-TIME-MN.
033100     MOVE UNFORMATTED-TIME-SS      TO  FORMATTED-TIME-SS.
033200
033300 6290-CD-X.
033400     EXIT.
033500
033600 6300-DISPLAY-DATE.
033700
033800     IF DATE-NUMERIC = SPACES
033900         MOVE SPACES               TO  DATE-YMD-OUT
034000         MOVE SPACES               TO  DATE-SLASH-OUT
034100         GO TO 6390-DD-X.
034200
034300*---------- THE DATE SEPERATOR (I.E. 3/5/85) COULD BE ANY ASCII
034400*---------- CHARACTER LESS THAN "0" - THAT IS "/", ".", "-",
034500*---------- SPACE, ETC.
034600     IF DATE-NUMERIC NUMERIC
034700         MOVE DATE-NUMERIC         TO  DATE-WORK
034800     ELSE
034900     IF DT1-S2 < "0"
035000       IF DT1-MD NUMERIC AND DT1-DM NUMERIC AND DT1-YY NUMERIC
035100         MOVE DT1-MD               TO  DATE-WORK-MD
035200         MOVE DT1-DM               TO  DATE-WORK-DM
035300         MOVE DT1-YY               TO  DATE-WORK-YY
035400       ELSE
035500         MOVE 1                    TO  DATE-RET-CODE
035600         GO TO 6390-DD-X
035700     ELSE
035800     IF DT2-S1 < "0"
035900       IF DT2-MD NUMERIC AND DT2-DM NUMERIC AND DT2-YY NUMERIC
036000         MOVE DT2-MD               TO  DATE-WORK-MD
036100         MOVE DT2-DM               TO  DATE-WORK-DM
036200         MOVE DT2-YY               TO  DATE-WORK-YY
036300       ELSE
036400         MOVE 1                    TO  DATE-RET-CODE
036500         GO TO 6390-DD-X
036600     ELSE
036700     IF DT3-S2 < "0"
036800       IF DT3-MD NUMERIC AND DT3-DM NUMERIC AND DT3-YY NUMERIC
036900         MOVE DT3-MD               TO  DATE-WORK-MD
037000         MOVE DT3-DM               TO  DATE-WORK-DM
037100         MOVE DT3-YY               TO  DATE-WORK-YY
037200       ELSE
037300         MOVE 1                    TO  DATE-RET-CODE
037400         GO TO 6390-DD-X
037500     ELSE
037600     IF DT4-S2 < "0"
037700       IF DT4-MD NUMERIC AND DT4-DM NUMERIC AND DT4-YY NUMERIC
037800         MOVE DT4-MD               TO  DATE-WORK-MD
037900         MOVE DT4-DM               TO  DATE-WORK-DM
038000         MOVE DT4-YY               TO  DATE-WORK-YY
038100       ELSE
038200         MOVE 1                    TO  DATE-RET-CODE
038300         GO TO 6390-DD-X
038400     ELSE
038500         MOVE 1                    TO  DATE-RET-CODE
038600         GO TO 6390-DD-X.
038700
038800     MOVE DATE-WORK-MD             TO  DATE-SLASH-OUT-MD.
038900     MOVE DATE-WORK-DM             TO  DATE-SLASH-OUT-DM.
039000     MOVE DATE-WORK-YY             TO  DATE-SLASH-OUT-YY.
039100     MOVE DATE-WORK-MD             TO  DATE-OUT-MD.
039200     MOVE DATE-WORK-DM             TO  DATE-OUT-DM.
039300     MOVE DATE-WORK-YY             TO  DATE-OUT-YY.
039400
039500     IF DATE-CODE = 3
039600         MOVE DATE-WORK-MD         TO  DATE-YMD-OUT-DD
039700         MOVE DATE-WORK-DM         TO  DATE-YMD-OUT-MM
039800         MOVE DATE-WORK-YY         TO  DATE-YMD-OUT-YY
039900     ELSE
040000         MOVE DATE-WORK-MD         TO  DATE-YMD-OUT-MM
040100         MOVE DATE-WORK-DM         TO  DATE-YMD-OUT-DD
040200         MOVE DATE-WORK-YY         TO  DATE-YMD-OUT-YY.
040300
040400     IF DATE-YMD-OUT-MM = "02"
040500         IF DATE-WORK-YY > 00
040600             DIVIDE DATE-WORK-YY BY 4 GIVING LEAP-TEST
040700             IF LEAP-TEST-DEC > 0
040800                 MOVE "N"          TO  LEAP-YEAR-FLAG
040900             ELSE
041000                 MOVE "Y"          TO  LEAP-YEAR-FLAG
041100         ELSE
041200             MOVE "Y"              TO  LEAP-YEAR-FLAG.
041300
041400     IF DATE-YMD-OUT-MM = "02"
041500         IF LEAP-YEAR-FLAG = "Y"
041600             IF DATE-YMD-OUT-DD < "01" OR > "29"
041700                 MOVE 1            TO  DATE-RET-CODE
041800                 GO TO 6390-DD-X
041900             ELSE
042000                 NEXT SENTENCE
042100         ELSE
042200         IF DATE-YMD-OUT-DD < "01" OR > "28"
042300             MOVE 1                TO  DATE-RET-CODE
042400             GO TO 6390-DD-X
042500         ELSE
042600             NEXT SENTENCE
042700     ELSE
042800     IF DATE-YMD-OUT-MM = "04" OR "06" OR "09" OR "11"
042900         IF DATE-YMD-OUT-DD < "01" OR > "30"
043000             MOVE 1                TO  DATE-RET-CODE
043100             GO TO 6390-DD-X
043200         ELSE
043300             NEXT SENTENCE
043400     ELSE
043500     IF DATE-YMD-OUT-MM = "01" OR "03" OR "05" OR "07" OR
043600                          "08" OR "10" OR "12"
043700         IF DATE-YMD-OUT-DD < "01" OR > "31"
043800             MOVE 1                TO  DATE-RET-CODE
043900             GO TO 6390-DD-X
044000         ELSE
044100             NEXT SENTENCE
044200     ELSE
044300         MOVE 1                    TO  DATE-RET-CODE
044400         GO TO 6390-DD-X.
044500
044600 6390-DD-X.
044700     EXIT.
044800
044900 6400-DATABASE-DATE.
045000     MOVE DATE-VALIDATE-IN         TO  DATE-YMD-OUT.
045100     MOVE DATE-YMD-OUT-YY          TO  DATE-SLASH-OUT-YY.
045200     MOVE DATE-YMD-OUT-MM          TO  DATE-SLASH-OUT-MD.
045300     MOVE DATE-YMD-OUT-DD          TO  DATE-SLASH-OUT-DM.
045400
045500     MOVE DATE-YMD-OUT-YY          TO  DATE-OUT-YY.
045600     MOVE DATE-YMD-OUT-MM          TO  DATE-OUT-MD.
045700     MOVE DATE-YMD-OUT-DD          TO  DATE-OUT-DM.
045800
045900     IF DATE-CODE = 3
046000         PERFORM 7100-FLIP-DATE-SLASH-OUT
046100        PERFORM 7200-FLIP-DATE-OUT.
046200
046300     IF DATE-SLASH-OUT = "  /  /  "
046400         MOVE SPACES               TO  DATE-SLASH-OUT.
046500
      *------ THEY CAN ALSO PASS AN UNFORMATTED TIME FROM THE
      *------ DATABASE AND GET A FORMATTED TIME BACK.
           IF UNFORMATTED-TIME-OUT > SPACES
               MOVE UNFORMATTED-TIME-HH  TO  FORMATTED-TIME-HH
               MOVE ":"                  TO  FORMATTED-TIME-C1
               MOVE UNFORMATTED-TIME-MN  TO  FORMATTED-TIME-MN
               MOVE ":"                  TO  FORMATTED-TIME-C2
               MOVE UNFORMATTED-TIME-SS  TO  FORMATTED-TIME-SS.

046600 6490-DD-X.
046700     EXIT.
046800
046900 7000-GET-DATE-CODE.
           MOVE "DATECODE"   TO  CHKOBJ-FILE-NAME.
           CALL "CCHKOBJ" USING CHKOBJ-FILE-NAME,
                                CHKOBJ-RETURN-STATUS.
           IF CHKOBJ-RETURN-STATUS  = "00"
               MOVE 3                    TO  DATE-CODE
           ELSE
               MOVE 1                    TO  DATE-CODE
           END-IF.
047000*    CALL INTRINSIC "FOPEN" USING DDATECOD-FILE, %7, %0,
047100*      \\,\\,\\,\\,\\,\\,\\,\\,\\,\\
047200*        GIVING DDATECOD-FNUM.
047300*    IF C-C = 0
047400*        MOVE 3                    TO  DATE-CODE
047500*    ELSE
047600*        MOVE 1                    TO  DATE-CODE.
047700*
047800*    CALL INTRINSIC "FCLOSE" USING DDATECOD-FNUM, 0, 0.
047900
048000 7090-GDC-X.
048100     EXIT.
048200
048300 7100-FLIP-DATE-SLASH-OUT.
048400     MOVE DATE-SLASH-OUT-MD        TO  SAVE-AREA.
048500     MOVE DATE-SLASH-OUT-DM        TO  DATE-SLASH-OUT-MD.
048600     MOVE SAVE-AREA                TO  DATE-SLASH-OUT-DM.
048700
048800 7200-FLIP-DATE-OUT.
048900     MOVE DATE-OUT-MD              TO  SAVE-AREA.
049000     MOVE DATE-OUT-DM              TO  DATE-OUT-MD.
049100     MOVE SAVE-AREA                TO  DATE-OUT-DM.
049200
049300
049400 999-CATREAD.
           MOVE LANG-SETNUM TO CATREAD-MSG-SET.
           MOVE LANG-MSGNUM TO CATREAD-MSG-NUM.
           CALL "CCATREAD" USING CATREAD-PARMS.
           MOVE CATREAD-MSG-TEXT TO DATE-MSG.
050200 999-CATREAD-EXIT.
050300     EXIT.
