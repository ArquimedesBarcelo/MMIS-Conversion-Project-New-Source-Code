       IDENTIFICATION DIVISION.
       PROGRAM-ID.    TMODWORK.

      *****************************************************************
      *REMARKS. THIS PROGRAM IS DESIGNED TO MODIFY BASIC WORK ORDER
      *           INFORMATION CONTAINED IN THE CORPORATE ENGINEERING
      *           DATABASE. THE PROGRAM ITSELF IS A PART OF AN OVERLAY
      *           STRUCTURE TO HANDLE ALL FACETS OF WORK ORDER
      *           MODIFICATION (PARTS,LABOR AND BASIC WORK ORDER DATA).
      *****************************************************************


      *****************************************************************
      **                   MODIFICATION   HISTORY
      *****************************************************************
      *    1-7-90 - modified CALL to pgm TGETESTM.  Removed VIEW-COMAREA AND
      *             LANGUAGE-PARMS  FROM parameter list.
      *           - modified CALL to pgm TBGAPPE.  Removed VIEW-COMAREA AND
      *             LANGUAGE-PARMS  FROM parameter list.
      *   PD Raglow
      *----------------------------------------------------------------
      *C 06/03/92  BK DISMUKES  REQUEST 6193
      *C    1. ADDED LOGIC TO CHECK FOR SAFETY EQUIPMENT FLAG
      *C       IN CHECK EDITS PARAGRAPH.
      *----------------------------------------------------------------
      *C 02/25/93 JSB REQ #6306
      *C    ADDED "PR" AS A NEW WO STATUS FOR PRE-RELEASE.
      *C    WRITE WO TO PM QUEUE IF "PR" STATUS CHANGED TO "IP".
      *C    MAKE CALL TO SPMCWSD TO UPDATE PREV-MAINT AND TRANS-FILE
      *C    SCHED-DATE FOR WO.
      *----------------------------------------------------------------
      *C 08/23/93 JSB
      *C    REMOVED CALL TO SPMNEWWO FOR IP A PR STATUS, THE CALL
      *C    TO SPMCWSD WITH IP USER-CODE WILL RELEASE THE RECORD
      *C    TO THE QUEUE.
      *----------------------------------------------------------------
      *C 04/14/1995   CAZ
      *C    ADDED LOGIC TO CHECK IF THE DATE AND TIME ENTERED ARE
      *C    NUMERIC TO AVOID DATA DECIMAL ERRORS.
      *----------------------------------------------------------------
      *C SEPTEMBER 1996  JE COFFMAN  REQ# 6619
      *C    EXPAND DATE FIELDS FOR YEAR 2000 COMPLIANCE.
      *----------------------------------------------------------------
      *C JANUARY   2001  JE COFFMAN
      *C    ADDED LOGIC TO CHECK THE M-SWITCH IN WO-LAST-NUM-USED
      *C    BUFFER. IF ON, FORCE THE USER TO INPUT THEIR PERSONAL
      *C    PASSWORD.
      *----------------------------------------------------------------
      *C JUNE 06 2002  GEISER
      *C    ADDED LOGIC TO SET THE UPDATE QUEUE SWITCH IF KEY
      *C    FIELDS WERE CHANGED ON THE WORK ORDER.
DCR01 *----------------------------------------------------------------
DCR01 *C APR 19, 2005  DCR01  DAN RAUCH       REQUEST# 2005-78291
DCR01 *C    ADDED CALL TO CRAFT SELECTION PGM SMCRAFT
DCR01 *C    ADDED CALL TO EQUIP SELECTION PGM SEQUIPSEL
      *****************************************************************

       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.

       SOURCE-COMPUTER.  AS400.
       OBJECT-COMPUTER.  AS400.
       SPECIAL-NAMES.    LOCAL-DATA IS LOCAL-DATA-AREA
                         I-O-FEEDBACK IS I-O-FEEDBACK-AREA.

       INPUT-OUTPUT SECTION.
       FILE-CONTROL.

           SELECT DISPLAY-FILE
               ASSIGN TO WORKSTATION-ZTMODWORK-SI
               ORGANIZATION IS TRANSACTION
               ACCESS IS SEQUENTIAL
               FILE STATUS IS DSPLY-STATUS
               CONTROL-AREA IS WS-CONTROL.

           SELECT EQUIP-FILE
               ASSIGN TO DATABASE-MCFLMM0201
               ORGANIZATION IS INDEXED
               ACCESS IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
               FILE STATUS IS EF-STATUS.

           SELECT MPLTINFO-FILE
               ASSIGN TO DATABASE-MCFLCS0501
               ORGANIZATION IS INDEXED
               ACCESS IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
               FILE STATUS IS MF-STATUS.

           SELECT MVALIDPLTDATA-FILE
               ASSIGN TO DATABASE-MCFLCS1701
               ORGANIZATION IS INDEXED
               ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
               FILE STATUS IS MVPD-STATUS.

           SELECT WO-BASIC-FILE
               ASSIGN TO DATABASE-MCFLMM1001
               ORGANIZATION IS INDEXED
               ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY WITH DUPLICATES
               FILE STATUS IS WBF-STATUS.

           SELECT WO-CRAFTS-REQD-FILE
               ASSIGN TO DATABASE-MCFLMM0601
               ORGANIZATION IS INDEXED
               ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
               FILE STATUS IS WCRF-STATUS.

           SELECT WO-LAST-NUM-USED
               ASSIGN TO DATABASE-MCFPMM0800
               ORGANIZATION IS RELATIVE
               ACCESS MODE IS RANDOM
               RELATIVE KEY IS ARG-NUM
               FILE STATUS IS WLNU-STATUS.

           SELECT WO-OPEN-QUEUE-FILE
               ASSIGN TO DATABASE-MCFLMM1902
               ORGANIZATION IS INDEXED
               ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY WITH DUPLICATES
               FILE STATUS IS WOQF-STATUS.

           SELECT WO-PARTS-FILE
               ASSIGN TO DATABASE-MCFLMM1201
               ORGANIZATION IS INDEXED
               ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                   WITH DUPLICATES
               FILE STATUS IS WPFD-STATUS.

           SELECT WO-PARTS-FILE-PF
               ASSIGN TO DATABASE-MCFPMM1200
               ORGANIZATION IS RELATIVE
               ACCESS MODE IS RANDOM
               RELATIVE KEY IS PFKEY
               FILE STATUS IS WPFDP-STATUS.

           SELECT WO-PLANNED-FILE
               ASSIGN TO DATABASE-MCFLMM1101
               ORGANIZATION IS INDEXED
               ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY WITH DUPLICATES
               FILE STATUS IS WPF-STATUS.

           SELECT WO-STATUS-MSTR-FILE
               ASSIGN TO DATABASE-MCFLMM0401
               ORGANIZATION IS INDEXED
               ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
               FILE STATUS IS WSMF-STATUS.

           SELECT WO-ZONE-PRTY-FILE
               ASSIGN TO DATABASE-MCFLMM0501
               ORGANIZATION IS INDEXED
               ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
               FILE STATUS IS WZPF-STATUS.

