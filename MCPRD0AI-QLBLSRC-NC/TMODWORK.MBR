               IF WO-DATE-REQD-P-DM > 0 AND < 32
                   MOVE WO-DATE-REQD-P TO WA-DATE
                   MOVE "Y" TO DAYS-OK-SW
                   PERFORM 6215-VALID-DAYS-IN-MONTH
                       VARYING SUB1 FROM 1 BY 1 UNTIL SUB1 > 12
                   IF DAYS-OK-SW = "N"
                       MOVE 35030 TO CATREAD-MSG-NUMBER
                       PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                       MOVE ERROR-BUFFER TO EDIT-ERROR
                       MOVE TRUE-VAL TO INDS (23) INDS (99)
                       PERFORM 69-READ-SCREEN
                       GO TO 621-CK-KEY-MODIFICATIONS
                   ELSE
                   IF WO-DATE-REQD-P-YY NUMERIC
                       NEXT SENTENCE
                   ELSE
                   MOVE 35032 TO CATREAD-MSG-NUMBER
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE ERROR-BUFFER TO EDIT-ERROR
                   MOVE TRUE-VAL TO INDS (24) INDS (99)
                   PERFORM 69-READ-SCREEN
                   GO TO 621-CK-KEY-MODIFICATIONS
               ELSE
               MOVE 35030 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE ERROR-BUFFER TO EDIT-ERROR
               MOVE TRUE-VAL TO INDS (23) INDS (99)
               PERFORM 69-READ-SCREEN
               GO TO 621-CK-KEY-MODIFICATIONS
           ELSE
           MOVE 35031 TO CATREAD-MSG-NUMBER
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
           MOVE ERROR-BUFFER TO EDIT-ERROR
           MOVE TRUE-VAL TO INDS (22) INDS (99)
           PERFORM 69-READ-SCREEN
           GO TO 621-CK-KEY-MODIFICATIONS.

           IF WO-DATE-REQD-P = "      "
               NEXT SENTENCE
           ELSE
           IF DATE-REQD-BUF-CN < DATE-RECD-BUF-CN
               MOVE 30026 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE ERROR-BUFFER TO EDIT-ERROR
               MOVE TRUE-VAL TO INDS (22) INDS (99)
               PERFORM 69-READ-SCREEN
               GO TO 621-CK-KEY-MODIFICATIONS
           ELSE
           IF WO-START-STATUS = "AA" OR "AR"
               IF DATE-REQD = "      "
                   NEXT SENTENCE
               ELSE
               MOVE 3 TO DATE-MODE
               MOVE WO-DATE-REQD-P TO DATE-VALIDATE-IN
               CALL "TDATECHK" USING DATE-CHECK-AREA
               IF DATE-DB = DATE-REQD
                   NEXT SENTENCE
               ELSE
               MOVE 30027 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE ERROR-BUFFER TO EDIT-ERROR
               MOVE TRUE-VAL TO INDS (22) INDS (99)
               PERFORM 69-READ-SCREEN
               GO TO 621-CK-KEY-MODIFICATIONS.

      ******************************************************************
      *    TIME PROMISED CHECK
      ******************************************************************
           IF WO-TIME-REQD-P = "    "
               NEXT SENTENCE
      *--- CHECK FOR NUMERIC TIME.              04/14/1995
           ELSE
