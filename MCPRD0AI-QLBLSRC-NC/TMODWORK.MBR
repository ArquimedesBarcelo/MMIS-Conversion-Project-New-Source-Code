               10  FILLER  PIC X(4) VALUE "0531".
               10  FILLER  PIC X(4) VALUE "0630".
               10  FILLER  PIC X(4) VALUE "0731".
               10  FILLER  PIC X(4) VALUE "0831".
               10  FILLER  PIC X(4) VALUE "0930".
               10  FILLER  PIC X(4) VALUE "1031".
               10  FILLER  PIC X(4) VALUE "1130".
               10  FILLER  PIC X(4) VALUE "1231".
           05  MDM REDEFINES MONTH-DAY-MAX.
               10  MONTH-DAY-ENTRY OCCURS 12 TIMES.
                   15  MONTH-TAB         PIC XX.
                   15  DAY-TAB           PIC XX.
       COPY MPLT0    IN COPYLIB.
       COPY MPLTRQGB IN COPYLIB.
       01  MPLTINFO-ARG                            PIC X(4).
       COPY MVALDPLT IN COPYLIB.
       01  P-CHG-LIT.
           02  FILLER  PIC X(11) VALUE SPACES.
           02  WO-CHG  PIC X(10) VALUE SPACES.
           02  FILLER  PIC X(59) VALUE SPACES.
       01  P-CHG-LIT2.
           02  FILLER  PIC X(11) VALUE SPACES.
           02  WO-CHG2 PIC X(10) VALUE SPACES.
           02  FILLER  PIC X(59) VALUE SPACES.
       01  P-COMP-LIT.
           02  FILLER                PIC X(20) VALUE SPACES.
           02  WO-COMP-LIT           PIC X(10) VALUE SPACES.
           02  FILLER                PIC X(50) VALUE SPACES.
       01  PASS-COMP                 PIC X(4).
       01  PASSED-BASE                             PIC X(10).
       01  PASSED-SPOOL-PRT            PIC S9(2) VALUE ZERO  COMP.
       01  PASSWORD-INFORMATION.
           05  NAME-OF-PROGRAM     PIC X(08) VALUE "TMODWORK".
           05  PROGRAM-TYPE        PIC X(02) VALUE "UP".
           05  PROGRAM-RELEASE     PIC X(12) VALUE " E0100010001".
           05  PROGRAM-DESCRIPTION.
               10  PROG-DESC-A     PIC X(60) VALUE
                  " WORK ORDER MODIFICATION PROGRAM             "      .
               10  PROG-DESC-B     PIC X(60) VALUE SPACES.
               10  PROG-FUNCTION   PIC X(60) VALUE SPACES.
           05  PASSWORD-FLAG       PIC X.
      *------ PARMS FOR CALL TO "TPERPASS" - PASSWORD SUBPROGRAM
       01  CC-BUFFER               PIC X(4).
       01  NAME-BUFFER             PIC X(16).
       01  PWORD-BUFFER            PIC X(10).
       01  PWORD-SWITCH            PIC X(1).
       01  PFKEY                   PIC 9(9) COMP-4.
       01  PM-WO-NUMBER            PIC X(10).
       01  PM-UPDATE-CODE          PIC XX.
       01  PM-UPDATE-DATE          PIC X(6).
       01  PM-RETURN-CODE          PIC S9(4) COMP.
       01  PM-RETURN-ERROR         PIC X(76).
       COPY REQGLOBS IN COPYLIB.
       01  REQ-ISSUED-MSG.
           05  FILLER  PIC X(20) VALUE SPACES.
           05  REQ-ISS PIC X(12) VALUE SPACES.
           05  FILLER  PIC X(23) VALUE SPACES.
           05  REQU-WO PIC X(10) VALUE SPACES.
           05  FILLER  PIC X(14) VALUE SPACES.
       01  RETURN-CODE-B                     PIC 9999.
       01  RETURN-ERROR-B                    PIC X(76).
       01  SAVE-WO-FIELDS.
           05  SAVE-WO-STAT.
               10  SAVE-WO-STAT-1-2          PIC XX.
               10  SAVE-WO-STAT-3            PIC X.
               10  SAVE-WO-STAT-4            PIC X.
           05  SAVE-CRAFTS-REQD-1            PIC XX.
           05  SAVE-CRAFTS-REQD-2            PIC XX.
           05  SAVE-CRAFTS-REQD-3            PIC XX.
           05  SAVE-EXPCLASS                       PIC X(8).
       01  SCREEN-PRINT-PARMS.
           05  PRINTCNTL                PIC S9(4) VALUE ZERO  COMP.
           05  PAGECNTL                 PIC S9(4) VALUE 49    COMP.
           05  SPOOLFIL-OPEN-SW         PIC X   VALUE "N".
       01  START-PARTS-KEY                         PIC X(10).
       COPY DBSTAT  IN COPYLIB.
       COPY TBLOWUP IN COPYLIB.
       01  TRUE-VAL                                PIC 1 VALUE B"1".
       01  WHO-PARMS.
           05  USERNAME                            PIC X(10).
           05  TERMNUM                             PIC X(10).
           05  CURRLIB                             PIC X(10).
           05  JOBLIBX                             PIC X.
       01  WO-BASIC-DATA.               COPY DWOBASIC OF COPYLIB.
       01  WA-DATE.
           05  WA-DATE-MD                          PIC 99.
           05  WA-DATE-DM                          PIC 99.
           05  WA-DATE-YY                          PIC 99.
       01  WO-PARTS-DATA.               COPY DWOPARTS OF COPYLIB.
       01  WO-PLANNED-DATA.             COPY DWOPLAN OF COPYLIB.
       01  WO-PLANNED-DATA3.
           05  FILLER                              PIC X(24).
           05  APPROVAL-CODE3                      PIC XX.
           05  FILLER                              PIC X(818).
       01  WO-QUEUE-DATA.               COPY DWOOPENQ OF COPYLIB.
       01  WO-QUEUE-HOLD.
           05  FILLER                              PIC X(18).
           05  H-CC-NUM                            PIC X(4).
           05  H-FACTOR                            PIC 99.
           05  FILLER                              PIC X(38).
       01  WO-TRACK-DATA.               COPY DWOTRACK OF COPYLIB.
       COPY WSCONTROL IN COPYLIB.
      *----FOR CALL TO SPMNEWWO, RELEASE TO PM QUEUE
       01  SAVE-WO-STATUS               PIC X(2)  VALUE SPACES.
       01  SAVE-PRIORITY.
           05  PRIORITY-1               PIC X.
           05  PRIORITY-2               PIC X.
       01  TRAN-FILE-DATA.              COPY TRANSFIL OF COPYLIB.
       01  CRAFT-TABLE                  PIC X(2000) VALUE SPACES.
       01  USER-CODE                    PIC X(8)    VALUE SPACES.
       01  PRINT-DATA                   PIC X(800)  VALUE SPACES.

       LINKAGE SECTION.
       01  DBPARAMETERS.                COPY DBPARMS OF COPYLIB.
       01  WO-NUMBER-BUF                           PIC X(10).
       COPY VCOMLINK OF COPYLIB.

       PROCEDURE DIVISION USING DBPARAMETERS WO-NUMBER-BUF
                            VIEW-COMAREA.
       PROCESS-MODIFY.
           PERFORM 1-HSK.
           PERFORM 6-MAIN.

       2-EOJ.
           CLOSE DISPLAY-FILE.
           CLOSE EQUIP-FILE.
           CLOSE MPLTINFO-FILE.
           CLOSE MVALIDPLTDATA-FILE.
           CLOSE WO-BASIC-FILE.
           CLOSE WO-CRAFTS-REQD-FILE.
           CLOSE WO-LAST-NUM-USED.
           CLOSE WO-OPEN-QUEUE-FILE.
           CLOSE WO-PARTS-FILE.
           CLOSE WO-PARTS-FILE-PF.
           CLOSE WO-PLANNED-FILE.
           CLOSE WO-STATUS-MSTR-FILE.
           CLOSE WO-ZONE-PRTY-FILE.
           GOBACK.

       1-HSK.
           OPEN I-O   DISPLAY-FILE.
           OPEN INPUT EQUIP-FILE.
           OPEN INPUT MPLTINFO-FILE.
           OPEN INPUT MVALIDPLTDATA-FILE.
           OPEN I-O   WO-BASIC-FILE.
           OPEN INPUT WO-CRAFTS-REQD-FILE.
           OPEN INPUT WO-LAST-NUM-USED.
           OPEN INPUT WO-OPEN-QUEUE-FILE.
           OPEN I-O   WO-PARTS-FILE.
           OPEN I-O   WO-PARTS-FILE-PF.
           OPEN I-O   WO-PLANNED-FILE.
           OPEN INPUT WO-STATUS-MSTR-FILE.
           OPEN INPUT WO-ZONE-PRTY-FILE.

           CALL "TPWORD" USING PASSWORD-INFORMATION.
           IF PASSWORD-FLAG = "N"
               MOVE "  PWORD" TO BLOWUP-BASE
               MOVE "FAILED PASSWORD CHECK - TMODWORK"
                   TO BU-DISPLAY-MSG
               PERFORM 998-BLOWUP.

           MOVE 0 TO Q-CHGSW.
           MOVE 0 TO DATE-COMPARE-BUFFER.
           MOVE SPACES TO BUFFER.
           MOVE SPACES TO ARG-NO.
           MOVE SPACES TO SAVE-WO-FIELDS BUDGET-WA.
           MOVE SPACES TO BASE-BG BASE-DUMMY BASE-MMISA BASE-STORES.
           MOVE DATE-FLAG TO DATE-CODE.
           ACCEPT DATE-WORK-AREA FROM DATE.

      *    IF DATE-FLAG = 3
      *        MOVE DATE-WA-MD TO DATE-BUFFER-DM T-BUF-DD
      *        MOVE DATE-WA-DM TO DATE-BUFFER-MD T-BUF-MM
      *        MOVE DATE-WA-YY TO DATE-BUFFER-YY T-BUF-YY
      *    ELSE
           MOVE DATE-WA-MM TO DATE-BUFFER-MD T-BUF-MM.
           MOVE DATE-WA-DD TO DATE-BUFFER-DM T-BUF-DD.
           MOVE DATE-WA-YY TO DATE-BUFFER-YY T-BUF-YY.

           IF DATE-WA-YY > "70"
               MOVE "19" TO DATE-BUFFER-CC,
                            T-BUF-CC
           ELSE
           MOVE "20" TO DATE-BUFFER-CC,
                        T-BUF-CC.

           CALL "CLWHO" USING USERNAME TERMNUM CURRLIB JOBLIBX.
           MOVE 0 TO COND-WORD.
           MOVE 1 TO ARG-NUM.
           READ WO-LAST-NUM-USED INTO LAST-WO-BUFF
               INVALID KEY MOVE 17 TO COND-WORD.
           IF WLNU-STATUS NOT = "00" MOVE 17 TO COND-WORD.
           IF ENG-PL-SCHD-ID = "    "
               IF M-SWITCH = "O"
                   MOVE SPACES TO CC-BUFFER, NAME-BUFFER,
                                  PWORD-BUFFER, PWORD-SWITCH
                   CALL "TPERPASS" USING CC-BUFFER, NAME-BUFFER,
                                     PWORD-BUFFER, PWORD-SWITCH
                   IF PWORD-SWITCH = "N"
                       MOVE 0 TO VIEW-LASTKEY
                       GO TO 2-EOJ
                   ELSE
                   MOVE CC-BUFFER TO ENG-PL-SCHD-ID.
           MOVE PLANT-IDENT TO PASS-COMP.
           PERFORM 68-START-MPLTINFO-FILE.

           IF COND-WORD = 17
               MOVE "Y" TO MPLT-PRINT-WO-REQPK
               MOVE "N" TO MPLT-WOAP-TO-CUT-REQ
               MOVE "N" TO MPLT-WOAP-TO-APP-REQ
               MOVE MPLTINFO-RQGB TO REQ-GLOBALS
           ELSE
           PERFORM 68-READ-MPLTINFO-FILE
           IF COND-WORD = 15
               MOVE "Y" TO MPLT-PRINT-WO-REQPK
               MOVE "N" TO MPLT-WOAP-TO-CUT-REQ
               MOVE "N" TO MPLT-WOAP-TO-APP-REQ
               MOVE MPLTINFO-RQGB TO REQ-GLOBALS
           ELSE
           MOVE MPLTINFO-RQGB TO REQ-GLOBALS.

           ACCEPT MC-LOCAL-DATA-AREA FROM LOCAL-DATA-AREA.
           MOVE HIGH-VALUES TO START-PARTS-KEY.
      ***************************************************************
      *    JCW-MJCW = 1 PERMITS ACCESS TO ENGINEER/VERBAL W/O'S     *
      *    JCW-MJCW = 2 PERMITS ACCESS TO PLANNER/VERBAL  W/O'S     *
      *    JCW-MJCW = 3 PERMITS ACCESS TO ALL TYPE        W/O'S     *
      *    JCW-MJCW = 4 PERMITS ACCESS TO ONLY VERBAL     W/O'S     *
      *    JCW-AREQJCW-259 IS THE JOB CONTROL WORD FOR REQUISITIONS *
      *    0 INDICATES NO REQUISITIONS MAY BE CUT , 1 INDICATES     *
      *    REQUISITIONS MAY BE CUT                                  *
      ***************************************************************
           CALL "TESCSEQ" USING ESC-NAME.

       6-MAIN.
           PERFORM 60-GET-WO-ASKED4-PARA THRU 60-GWAP-EXIT.
           PERFORM 61-GET-FORM-UP THRU 61-GFU-CONT.
           PERFORM 62-HANDLE-MODIFY.
           PERFORM 64-UOM-VERBAL THRU 64-UOM-EXIT.
           PERFORM 65-PASS-PM-DATA THRU 65-PPD-EXIT.

       60-GET-WO-ASKED4-PARA.
           MOVE 0 TO PLANNED-SW.
           PERFORM 68-START-WO-BASIC-FILE.
           IF COND-WORD = 17 GO TO 601-CHECK-WO-PLANNED.
           PERFORM 68-READ-WO-BASIC-FILE.
           IF COND-WORD = 15 GO TO 601-CHECK-WO-PLANNED.
           MOVE SPACES TO WO-PLANNED-DATA.
           GO TO 60-GWAP-EXIT.

       601-CHECK-WO-PLANNED.
           MOVE 1 TO PLANNED-SW.
           MOVE WO-NUMBER-BUF TO WONUM OF WPFREC.
           PERFORM 68-START-WO-PLANNED-FILE.
           IF COND-WORD = 17 GO TO 2-EOJ.

      *        MOVE "  MMISA" TO BLOWUP-BASE
      *        MOVE "UNRETRIEVABLE WO NUMBER ENTERED * TMODWORK *"
      *            TO BU-DISPLAY-MSG
      *        PERFORM 998-BLOWUP.

           PERFORM 68-READ-WO-PLANNED-FILE.
           MOVE WO-PLANNED-DATA3 TO WO-PLANNED-DATA.
           IF COND-WORD = 15
               MOVE "  MMISA" TO BLOWUP-BASE
               MOVE "UNRETRIEVABLE WO NUMBER ENTERED * TMODWORK *"
                   TO BU-DISPLAY-MSG
               PERFORM 998-BLOWUP.
           MOVE SPACES TO WO-BASIC-DATA.

       60-GWAP-EXIT.    EXIT.

       61-GET-FORM-UP.
           IF PLANNED-SW = 1 GO TO 61-GFU-PLANNED.
           MOVE WO-NUM TO WO-NUM-B.
           MOVE WO-STATUS TO WO-STAT SAVE-WO-STAT.
           MOVE WO-STRT-STATUS TO WO-TYPE-B.

           IF DATE-RECD = "      "
               MOVE SPACES TO WO-DATE-REC
           ELSE
           MOVE 4 TO DATE-MODE
           MOVE DATE-RECD TO DATE-VALIDATE-IN
           CALL "TDATECHK" USING DATE-CHECK-AREA
           MOVE DATE-OUT TO WO-DATE-REC.

           MOVE TIME-RECD TO WO-TIME-REC.
           MOVE APPROVAL-CODE TO WO-APPR-CODE.
           MOVE REQUESTER-B TO WO-REQUESTER.
           MOVE EQUIP-NUM TO WO-EQPNUM.
           MOVE EQUIP-NAME TO WO-EQPNAME.
           MOVE TYPE-NUM TO WO-EQPTYP.
           MOVE DEPT TO WO-DEPT.
           MOVE ZONE TO WO-MAINT-ZONE.
           MOVE LOCATION OF WO-BASIC-DATA TO WO-LOC.
           MOVE PRIORITY TO WO-PRIORITY.
           MOVE EQUIP-DOWN TO WO-EQPDWN.

           MOVE CRAFTS-REQD-1 TO WO-CRAFTS-REQD-1
               SAVE-CRAFTS-REQD-1.
           MOVE CRAFTS-REQD-2 TO WO-CRAFTS-REQD-2
               SAVE-CRAFTS-REQD-2.
           MOVE CRAFTS-REQD-3 TO WO-CRAFTS-REQD-3
               SAVE-CRAFTS-REQD-3.

           MOVE EXP-CLASS TO WO-EXPCLASS SAVE-EXPCLASS.
           MOVE DESCRIPTION-1 TO WO-DESC-1.
           MOVE DESCRIPTION-2-1 TO WO-DESC-2.
           MOVE DESCRIPTION-2-2 TO WO-DESC-3.
           MOVE CRAFTSMEN-1 TO WO-CRAFTSMEN-1.
           MOVE CRAFTSMEN-2 TO WO-CRAFTSMEN-2.
           MOVE CRAFTSMEN-3 TO WO-CRAFTSMEN-3.

           IF DATE-STRT = "      "
               MOVE SPACES TO WO-DATE-STRT
           ELSE
           MOVE 4 TO DATE-MODE
           MOVE DATE-STRT TO DATE-VALIDATE-IN
           CALL "TDATECHK" USING DATE-CHECK-AREA
           MOVE DATE-OUT TO WO-DATE-STRT.

           MOVE TIME-STRT TO WO-TIME-STRT.
           MOVE FAILURE-CODE TO WO-FAILURE.
           IF DATE-COMP = "      "
               MOVE SPACES TO WO-DATE-COMP
           ELSE
           MOVE 4 TO DATE-MODE
           MOVE DATE-COMP TO DATE-VALIDATE-IN
           CALL "TDATECHK" USING DATE-CHECK-AREA
           MOVE DATE-OUT TO WO-DATE-COMP.

           MOVE TIME-COMP TO WO-TIME-COMP.
DCR01 *****MOVE 66053 TO CATREAD-MSG-NUMBER.
DCR01      MOVE 66384 TO CATREAD-MSG-NUMBER.
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
           MOVE ERROR-BUFFER TO CMDLINE-B.
           GO TO 61-GFU-CONT.

       61-GFU-PLANNED.
           MOVE WO-NUM-PLANNED TO WO-NUM-PL.
           MOVE WO-STATUS-P TO WO-STAT-P SAVE-WO-STAT.
           MOVE WO-START-STATUS TO WO-TYPE-P.

           IF DATE-RECD-P = "      "
               MOVE SPACES TO WO-DATE-REC-P
           ELSE
           MOVE 4 TO DATE-MODE
           MOVE DATE-RECD-P TO DATE-VALIDATE-IN
           CALL "TDATECHK" USING DATE-CHECK-AREA
           MOVE DATE-OUT TO WO-DATE-REC-P.

           MOVE TIME-RECD-P TO WO-TIME-REC-P.
           MOVE APPROVAL-CODE-P TO WO-APPR-CODE-P.
           MOVE REQUESTER-P TO WO-REQUESTER-P.
           MOVE EQUIP-NUM-P TO WO-EQPNUM-P.
           MOVE EQUIP-NAME-P TO WO-EQPNAME-P.
           MOVE TYPE-NUM-P TO WO-EQPTYP-P.
           MOVE DEPT-P TO WO-DEPT-P.
           MOVE ZONE-P TO WO-MAINT-ZONE-P.
           MOVE LOCATION-P TO WO-LOC-P.
           MOVE PRIORITY-P TO WO-PRIORITY-P.
           MOVE EQUIP-DOWN-P TO WO-EQPDWN-P.
           MOVE EXP-CLASS-P TO WO-EXPCLASS-P SAVE-EXPCLASS.
           MOVE RIME-P TO WO-RIME-P.
           MOVE DESCRIPTION-1-P TO WO-DESC-1-P.
           MOVE DESCRIPTION-2-1-P TO WO-DESC-2-P.
           MOVE DESCRIPTION-2-2-P TO WO-DESC-3-P.
           MOVE DESCRIPTION-3-1-P TO WO-DESC-4-P.
           MOVE DESCRIPTION-3-2-P TO WO-DESC-5-P.

           IF DATE-STRT-P = "      "
               MOVE SPACES TO WO-DATE-STRT-P
           ELSE
           MOVE 4 TO DATE-MODE
           MOVE DATE-STRT-P TO DATE-VALIDATE-IN
           CALL "TDATECHK" USING DATE-CHECK-AREA
           MOVE DATE-OUT TO WO-DATE-STRT-P.

           MOVE TIME-STRT-P TO WO-TIME-STRT-P.
           MOVE FAILURE-CODE-P TO WO-FAILURE-P.
           MOVE PM-JOBPLAN-KEY TO JOBPLAN-NAME.
           MOVE PM-SCHEDULE-KEY TO MASTER-SCHED-NAME.
           IF DATE-COMP-P = "      "
               MOVE SPACES TO WO-DATE-COMP-P
           ELSE
           MOVE 4 TO DATE-MODE
           MOVE DATE-COMP-P TO DATE-VALIDATE-IN
           CALL "TDATECHK" USING DATE-CHECK-AREA
           MOVE DATE-OUT TO WO-DATE-COMP-P.

           MOVE TIME-COMP-P TO WO-TIME-COMP-P.
           MOVE SPECL-INSTR-1 TO WO-SPECL-INSTR-1-P.
           MOVE SPECL-INSTR-2 TO WO-SPECL-INSTR-2-P.
           MOVE SPECL-EQUIP TO WO-SPECL-EQUIP-P.
           MOVE SAFETY-NOTE TO WO-SFTYNOTE-P.
           IF DATE-REQD = "      "
               MOVE SPACES TO WO-DATE-REQD-P
           ELSE
           MOVE 4 TO DATE-MODE
           MOVE DATE-REQD TO DATE-VALIDATE-IN
           CALL "TDATECHK" USING DATE-CHECK-AREA
           MOVE DATE-OUT TO WO-DATE-REQD-P.

           MOVE TIME-REQD TO WO-TIME-REQD-P.
           MOVE ENGINEER TO WO-ENGINEER-P.
           MOVE ENGR-RESP-IND TO WO-ENGINEER-IND.
           MOVE PLANNER TO WO-PLANNER-P.
           MOVE PLNR-RESP-IND TO WO-PLANNER-IND.
           MOVE SCHEDULER TO WO-SCHEDULER-P.
           MOVE SCHD-RESP-IND TO WO-SCHEDULER-IND.
           MOVE BUDGET-NO-1-3 TO WO-BGT-NO-P-1-3 B-WA-1-3.
           MOVE BUDGET-NO-4-5 TO WO-BGT-NO-P-4-5 B-WA-4-5.
           MOVE BUDGET-NO-6-7 TO WO-BGT-NO-P-6-7 B-WA-6-7.
           MOVE BUDGET-NO-8-10 TO WO-BGT-NO-P-8-10 B-WA-8-10.
           MOVE BUDGET-NO-REVNO TO WO-BGT-NO-REVNO B-WA-REVNO.
           MOVE REQUEST-NO TO WO-REQ-NO-P.

           IF DATE-SCHD = "      "
               MOVE SPACES TO WO-DATE-SCHD-P
           ELSE
           MOVE 4 TO DATE-MODE
           MOVE DATE-SCHD TO DATE-VALIDATE-IN
           CALL "TDATECHK" USING DATE-CHECK-AREA
           MOVE DATE-OUT TO WO-DATE-SCHD-P.

           MOVE TIME-SCHD TO WO-TIME-SCHD-P.
           MOVE 66052 TO CATREAD-MSG-NUMBER.
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
           MOVE ERROR-BUFFER TO CMDLINE-P.

       61-GFU-CONT.
           PERFORM 69-READ-SCREEN.

       62-HANDLE-MODIFY.
           MOVE SPACES TO EDIT-ERROR.
           IF JCW-MJCW-260 = 9
               NEXT SENTENCE
           ELSE
           IF PLANT-IDENT = "111 "
               NEXT SENTENCE
           ELSE
           IF PLANNED-SW = 1
               IF WO-STAT-TEMP = "FF"
                   MOVE WO-STAT-TEMP TO EDIT-WO-STAT
                   MOVE 29080 TO CATREAD-MSG-NUMBER
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE ERROR-BUFFER TO EDIT-ERROR
                   MOVE TRUE-VAL TO INDS (3) INDS (99)
                   PERFORM 69-READ-SCREEN
                   GO TO 62-HANDLE-MODIFY
               ELSE
               IF EDIT-WO-STAT = "DW" OR "FF"
                   MOVE 49022 TO CATREAD-MSG-NUMBER
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE EDIT-WO-STAT TO ERROR-STATUS
                   MOVE ERROR-BUFFER TO EDIT-ERROR
                   MOVE TRUE-VAL TO INDS (3) INDS (99)
                   PERFORM 69-READ-SCREEN
                   GO TO 62-HANDLE-MODIFY
               ELSE
               NEXT SENTENCE
           ELSE
           IF WO-STAT-TEMP = "DW" OR "FF"
               MOVE WO-STAT-TEMP TO EDIT-WO-STAT
               MOVE 29080 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE ERROR-BUFFER TO EDIT-ERROR
               MOVE TRUE-VAL TO INDS (3) INDS (99)
               PERFORM 69-READ-SCREEN
               GO TO 62-HANDLE-MODIFY.

           MOVE SPACES TO ERROR-BUFFER.
           PERFORM 621-CK-KEY-MODIFICATIONS THRU 621-CKM-EXIT.

       621-CK-KEY-MODIFICATIONS.
           IF EDIT-WO-STAT = SAVE-WO-STAT GO TO 6211-BEGIN-EDIT-CHECKS.
           PERFORM 68-START-WO-STATUS-MSTR.
           IF COND-WORD = 17
               MOVE 35001 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE ERROR-BUFFER TO EDIT-ERROR
               MOVE TRUE-VAL TO INDS (3) INDS (99)
               PERFORM 69-READ-SCREEN
               GO TO 621-CK-KEY-MODIFICATIONS.

           IF PLANNED-SW = 0
               IF EDIT-WO-STAT = "SW"
                   MOVE 48006 TO CATREAD-MSG-NUMBER
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE ERROR-BUFFER TO EDIT-ERROR
                   MOVE TRUE-VAL TO INDS (3) INDS (99)
                   PERFORM 69-READ-SCREEN
                   GO TO 621-CK-KEY-MODIFICATIONS
               ELSE
               IF EDIT-WO-STAT = "CW"
                   IF EDIT-DATE-STRT = "      "
                       MOVE 30031 TO CATREAD-MSG-NUMBER
                       PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                       MOVE ERROR-BUFFER TO EDIT-ERROR
                       MOVE TRUE-VAL TO INDS (50) INDS (99)
                       PERFORM 69-READ-SCREEN
                       GO TO 621-CK-KEY-MODIFICATIONS
                   ELSE
                   IF EDIT-TIME-STRT = "    "
                       MOVE 30036 TO CATREAD-MSG-NUMBER
                       PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                       MOVE ERROR-BUFFER TO EDIT-ERROR
                       MOVE TRUE-VAL TO INDS (53) INDS (99)
                       PERFORM 69-READ-SCREEN
                       GO TO 621-CK-KEY-MODIFICATIONS
                   ELSE
                   IF EDIT-DATE-COMP = "      "
                       MOVE 30013 TO CATREAD-MSG-NUMBER
                       PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                       MOVE ERROR-BUFFER TO EDIT-ERROR
                       MOVE TRUE-VAL TO INDS (57) INDS (99)
                       PERFORM 69-READ-SCREEN
                       GO TO 621-CK-KEY-MODIFICATIONS
                   ELSE
                   IF EDIT-TIME-COMP = "    "
                       MOVE 30012 TO CATREAD-MSG-NUMBER
                       PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                       MOVE ERROR-BUFFER TO EDIT-ERROR
                       MOVE TRUE-VAL TO INDS (60) INDS (99)
                       PERFORM 69-READ-SCREEN
                       GO TO 621-CK-KEY-MODIFICATIONS
                   ELSE
                   IF WO-FAILURE = "      "
                       MOVE 32003 TO CATREAD-MSG-NUMBER
                       PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                       MOVE ERROR-BUFFER TO EDIT-ERROR
                       MOVE TRUE-VAL TO INDS (55) INDS (99)
                       PERFORM 69-READ-SCREEN
                       GO TO 621-CK-KEY-MODIFICATIONS.

           IF PLANNED-SW = 1
               IF WO-NUM-SUFF-P = "000"
                   IF EDIT-WO-STAT = "DW"
                       MOVE 39047 TO CATREAD-MSG-NUMBER
                       PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                       MOVE ERROR-BUFFER TO EDIT-ERROR
                       MOVE TRUE-VAL TO INDS (3) INDS (99)
                       PERFORM 69-READ-SCREEN
                       GO TO 621-CK-KEY-MODIFICATIONS
                   ELSE
                   IF EDIT-WO-STAT = "OO" OR "CW"
                        NEXT SENTENCE
                   ELSE
                   MOVE 39043 TO CATREAD-MSG-NUMBER
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE ERROR-BUFFER TO EDIT-ERROR
                   MOVE TRUE-VAL TO INDS (3) INDS (99)
                   PERFORM 69-READ-SCREEN
                   GO TO 621-CK-KEY-MODIFICATIONS
               ELSE
               IF EDIT-WO-STAT = "IP"
                   IF WO-STATUS-P  = "SD" OR "HS" OR "PR"
                       IF WO-EXPCLASS-P = SPACES
                           MOVE 49016 TO CATREAD-MSG-NUMBER
                           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                           MOVE ERROR-BUFFER TO EDIT-ERROR
                           MOVE TRUE-VAL TO INDS (21) INDS (99)
                           PERFORM 69-READ-SCREEN
                           GO TO 621-CK-KEY-MODIFICATIONS
                       ELSE
                       NEXT SENTENCE
                   ELSE
                   MOVE 35092 TO CATREAD-MSG-NUMBER
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE ERROR-BUFFER TO EDIT-ERROR
                   MOVE TRUE-VAL TO INDS (3) INDS (99)
                   PERFORM 69-READ-SCREEN
                   GO TO 621-CK-KEY-MODIFICATIONS
               ELSE
               IF WO-START-STATUS = "AA" OR "AR"
                   IF EDIT-WO-STAT = "SD"
                       IF WO-DATE-SCHD-P = "      "
                           MOVE 30025 TO CATREAD-MSG-NUMBER
                           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                           MOVE ERROR-BUFFER TO EDIT-ERROR
                           MOVE TRUE-VAL TO INDS (39) INDS (99)
                           PERFORM 69-READ-SCREEN
                           GO TO 621-CK-KEY-MODIFICATIONS
                       ELSE
                       NEXT SENTENCE
                   ELSE
                   IF EDIT-WO-STAT = "OO" OR "SD" OR "IP" OR "CW"
                       NEXT SENTENCE
                   ELSE
                   MOVE 42136 TO CATREAD-MSG-NUMBER
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE ERROR-BUFFER TO EDIT-ERROR
                   MOVE TRUE-VAL TO INDS (3) INDS (99)
                   PERFORM 69-READ-SCREEN
                   GO TO 621-CK-KEY-MODIFICATIONS.

           IF EDIT-WO-STAT = "DW"
               IF EDIT-DATE-COMP = "      "
                   MOVE 29098 TO CATREAD-MSG-NUMBER
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE ERROR-BUFFER TO EDIT-ERROR
                   MOVE TRUE-VAL TO INDS (3) INDS (99)
                   PERFORM 69-READ-SCREEN
                   GO TO 621-CK-KEY-MODIFICATIONS.

           IF EDIT-WO-STAT = "VO" OR "DW"
               IF JCW-MJCW-260 = 9
                   NEXT SENTENCE
               ELSE
               PERFORM 6216-CK-VO-PARTS THRU 6216-CVP-EXIT
               IF INDS (99) = TRUE-VAL
                   PERFORM 69-READ-SCREEN
                   GO TO 621-CK-KEY-MODIFICATIONS.

       6211-BEGIN-EDIT-CHECKS.
      ******************************************************************
      *    DATE RECD CHECK
      ******************************************************************
      *--- CHECK TO SEE IF DATE IS NUMERIC.    04/14/1995
           IF EDIT-DATE-RECD-MD NOT NUMERIC
               MOVE 35031 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE ERROR-BUFFER TO EDIT-ERROR
               MOVE TRUE-VAL TO INDS (5) INDS (99)
               PERFORM 69-READ-SCREEN
               GO TO 621-CK-KEY-MODIFICATIONS.

           IF EDIT-DATE-RECD-DM NOT NUMERIC
               MOVE 35030 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE ERROR-BUFFER TO EDIT-ERROR
               MOVE TRUE-VAL TO INDS (6) INDS (99)
               PERFORM 69-READ-SCREEN
               GO TO 621-CK-KEY-MODIFICATIONS.

           IF EDIT-DATE-RECD-YY NOT NUMERIC
               MOVE 35032 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE ERROR-BUFFER TO EDIT-ERROR
               MOVE TRUE-VAL TO INDS (7) INDS (99)
               PERFORM 69-READ-SCREEN
               GO TO 621-CK-KEY-MODIFICATIONS.

           IF DATE-FLAG = 3
               IF EDIT-DATE-RECD-MD > 0 AND < 32
                   MOVE EDIT-DATE-RECD TO WA-DATE
                   MOVE "Y" TO DAYS-OK-SW
                   PERFORM 6215-VALID-DAYS-IN-MONTH
                       VARYING SUB1 FROM 1 BY 1 UNTIL SUB1 > 12
                   IF DAYS-OK-SW = "N"
                       MOVE 35030 TO CATREAD-MSG-NUMBER
                       PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                       MOVE ERROR-BUFFER TO EDIT-ERROR
                       MOVE TRUE-VAL TO INDS (5) INDS (99)
                       PERFORM 69-READ-SCREEN
                       GO TO 621-CK-KEY-MODIFICATIONS
                   ELSE
                   IF EDIT-DATE-RECD-DM > 0 AND < 13
                       IF EDIT-DATE-RECD-YY NUMERIC
                           NEXT SENTENCE
                       ELSE
                       MOVE 35032 TO CATREAD-MSG-NUMBER
                       PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                       MOVE ERROR-BUFFER TO EDIT-ERROR
                       MOVE TRUE-VAL TO INDS (7) INDS (99)
                       PERFORM 69-READ-SCREEN
                       GO TO 621-CK-KEY-MODIFICATIONS
                   ELSE
                   MOVE 35031 TO CATREAD-MSG-NUMBER
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE TRUE-VAL TO INDS (6) INDS (99)
                   PERFORM 69-READ-SCREEN
                   GO TO 621-CK-KEY-MODIFICATIONS
               ELSE
               MOVE 35030 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE ERROR-BUFFER TO EDIT-ERROR
               MOVE TRUE-VAL TO INDS (5) INDS (99)
               PERFORM 69-READ-SCREEN
               GO TO 621-CK-KEY-MODIFICATIONS
           ELSE
           IF EDIT-DATE-RECD-MD > 0 AND < 13
               IF EDIT-DATE-RECD-DM > 0 AND < 32
                   MOVE EDIT-DATE-RECD TO WA-DATE
                   MOVE "Y" TO DAYS-OK-SW
                   PERFORM 6215-VALID-DAYS-IN-MONTH
                       VARYING SUB1 FROM 1 BY 1 UNTIL SUB1 > 12
                   IF DAYS-OK-SW = "N"
                       MOVE 35030 TO CATREAD-MSG-NUMBER
                       PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                       MOVE ERROR-BUFFER TO EDIT-ERROR
                       MOVE TRUE-VAL TO INDS (6) INDS (99)
                       PERFORM 69-READ-SCREEN
                       GO TO 621-CK-KEY-MODIFICATIONS
                   ELSE
                   IF EDIT-DATE-RECD-YY NUMERIC
                       NEXT SENTENCE
                   ELSE
                   MOVE 35032 TO CATREAD-MSG-NUMBER
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE ERROR-BUFFER TO EDIT-ERROR
                   MOVE TRUE-VAL TO INDS (7) INDS (99)
                   PERFORM 69-READ-SCREEN
                   GO TO 621-CK-KEY-MODIFICATIONS
               ELSE
               MOVE 35030 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE ERROR-BUFFER TO EDIT-ERROR
               MOVE TRUE-VAL TO INDS (6) INDS (99)
               PERFORM 69-READ-SCREEN
               GO TO 621-CK-KEY-MODIFICATIONS
           ELSE
           MOVE 35031 TO CATREAD-MSG-NUMBER
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
           MOVE ERROR-BUFFER TO EDIT-ERROR
           MOVE TRUE-VAL TO INDS (5) INDS (99)
           PERFORM 69-READ-SCREEN
           GO TO 621-CK-KEY-MODIFICATIONS.

           IF DATE-RECD-BUF-CN > DATE-CURR-BUF-CN
               MOVE 30009 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE ERROR-BUFFER TO EDIT-ERROR
               MOVE TRUE-VAL TO INDS (5) INDS (99)
               PERFORM 69-READ-SCREEN
               GO TO 621-CK-KEY-MODIFICATIONS.

      ******************************************************************
      *    TIME RECD CHECK
      ******************************************************************
      *--- CHECK IF TIME RECEIVED IS NUMERIC.      04/14/1995
           IF EDIT-TIME-RECD NOT NUMERIC
               MOVE 46009 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE ERROR-BUFFER TO EDIT-ERROR
               MOVE TRUE-VAL TO INDS (8) INDS (99)
               PERFORM 69-READ-SCREEN
               GO TO 621-CK-KEY-MODIFICATIONS.

           IF EDIT-TIME-RECD-HH < 24
               NEXT SENTENCE
           ELSE
           MOVE 35055 TO CATREAD-MSG-NUMBER
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
           MOVE ERROR-BUFFER TO EDIT-ERROR
           MOVE TRUE-VAL TO INDS (8) INDS (99)
           PERFORM 69-READ-SCREEN
           GO TO 621-CK-KEY-MODIFICATIONS.

           IF EDIT-TIME-RECD-MM < 60
               NEXT SENTENCE
           ELSE
           MOVE 35054 TO CATREAD-MSG-NUMBER
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
           MOVE ERROR-BUFFER TO EDIT-ERROR
           MOVE TRUE-VAL TO INDS (9) INDS (99)
           PERFORM 69-READ-SCREEN
           GO TO 621-CK-KEY-MODIFICATIONS.

      *****************************************************************
      *    APPROVAL CODE CHECK.
      *****************************************************************
           IF EDIT-APPROVAL-CODE = "A" OR "U" OR "R"
               NEXT SENTENCE
           ELSE
           MOVE 35023 TO CATREAD-MSG-NUMBER
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
           MOVE ERROR-BUFFER TO EDIT-ERROR
           MOVE TRUE-VAL TO INDS (10) INDS (99)
           PERFORM 69-READ-SCREEN
           GO TO 621-CK-KEY-MODIFICATIONS.

      *    IF PLANT-IDENT = "126 "
      *        NEXT SENTENCE
      *    ELSE
           IF EDIT-APPROVAL-CODE = "U"
               IF WO-NUM-SUFF-P = "000"
                   IF APPROVAL-CODE-P = "U"
                       NEXT SENTENCE
                   ELSE
                   MOVE 39045 TO CATREAD-MSG-NUMBER
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE ERROR-BUFFER TO EDIT-ERROR
                   MOVE TRUE-VAL TO INDS (10) INDS (99)
                   PERFORM 69-READ-SCREEN
                   GO TO 621-CK-KEY-MODIFICATIONS
               ELSE
               IF WO-START-STATUS = "AA" OR "AR"
                   MOVE 42137 TO CATREAD-MSG-NUMBER
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE ERROR-BUFFER TO EDIT-ERROR
                   MOVE TRUE-VAL TO INDS (10) INDS (99)
                   PERFORM 69-READ-SCREEN
                   GO TO 621-CK-KEY-MODIFICATIONS
               ELSE
               IF EDIT-WO-STAT = "HE" OR "HP" OR "HV" OR "VO" OR "HA"
                   OR "OO" or "EO" OR "EC"
                       NEXT SENTENCE
                   ELSE
                   MOVE 35082 TO CATREAD-MSG-NUMBER
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE ERROR-BUFFER TO EDIT-ERROR
                   MOVE TRUE-VAL TO INDS (3) INDS (99)
                   PERFORM 69-READ-SCREEN
                   GO TO 621-CK-KEY-MODIFICATIONS.

           IF EDIT-APPROVAL-CODE = "A"
               IF WO-NUM-SUFF-P = "   "
                   NEXT SENTENCE
               ELSE
               IF WO-NUM-SUFF-P = "000"
                   IF APPROVAL-CODE-P = "A"
                      NEXT SENTENCE
                   ELSE
                   MOVE 39046 TO CATREAD-MSG-NUMBER
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE ERROR-BUFFER TO EDIT-ERROR
                   MOVE TRUE-VAL TO INDS (10) INDS (99)
                   PERFORM 69-READ-SCREEN
                   GO TO 621-CK-KEY-MODIFICATIONS
               ELSE
               MOVE WO-NUM-PLANNED TO MASTER-WO
               MOVE "000" TO MASTER-SUFF
               MOVE MASTER-WO TO WONUM OF WPFREC
               PERFORM 68-START-WO-PLANNED-FILE
               IF COND-WORD = 17
                   MOVE 40071 TO CATREAD-MSG-NUMBER
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE ERROR-BUFFER TO EDIT-ERROR
                   MOVE TRUE-VAL TO INDS (10) INDS (99)
                   PERFORM 69-READ-SCREEN
                   GO TO 621-CK-KEY-MODIFICATIONS
               ELSE
               PERFORM 68-READ-WO-PLANNED-FILE
               IF COND-WORD = 15
                    MOVE 40071 TO CATREAD-MSG-NUMBER
                    PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                    MOVE ERROR-BUFFER TO EDIT-ERROR
                    MOVE TRUE-VAL TO INDS (10) INDS (99)
                    PERFORM 69-READ-SCREEN
                    GO TO 621-CK-KEY-MODIFICATIONS
               ELSE
               IF APPROVAL-CODE3 = "U"
                   MOVE 39042 TO CATREAD-MSG-NUMBER
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE ERROR-BUFFER TO EDIT-ERROR
                   MOVE TRUE-VAL TO INDS (10) INDS (99)
                   PERFORM 69-READ-SCREEN
                   GO TO 621-CK-KEY-MODIFICATIONS.

      ******************************************************************
      *    EQUIP-NUM CHECK
      ******************************************************************
           IF WO-NUM-SUFF-P = "000"
               IF EQUIP-NUM-P = "      "
                   GO TO 6212-CHECK-EQUIP-DOWN
               ELSE
               IF EDIT-EQUIP-NUM = "      "
                   MOVE SPACES TO EDIT-EQUIP-NAME
                                  EDIT-TYPE-NUM
                                  EDIT-TYPE-NUM
                                  EDIT-ZONE-PRIORITY
                                  EDIT-LOCATION
                   MOVE 01 TO WO-RIME-P WO-RIME-SAVE
                   GO TO 6212-CHECK-EQUIP-DOWN.

           IF WO-START-STATUS = "AA" OR "AR"
               GO TO 6212-CHECK-EQUIP-DOWN.

      *****************************************************************
      *    DETERMINE IF EQUIP-NUMBER IS IN DATABASE.
      *****************************************************************
           PERFORM 68-START-EQUIP-FILE.
           IF COND-WORD = 17
               MOVE 66051 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE ERROR-BUFFER TO EDIT-ERROR
               MOVE TRUE-VAL TO INDS (12) INDS (99)
               PERFORM 69-READ-SCREEN
               GO TO 621-CK-KEY-MODIFICATIONS.

           PERFORM 68-READ-EQUIP-FILE.
           IF COND-WORD = 15
               MOVE 66051 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE ERROR-BUFFER TO EDIT-ERROR
               MOVE TRUE-VAL TO INDS (12) INDS (99)
               PERFORM 69-READ-SCREEN
               GO TO 621-CK-KEY-MODIFICATIONS.

           MOVE EQP-EQUIP-NAME   TO EDIT-EQUIP-NAME.
           MOVE EQP-TYPE         TO EDIT-TYPE-NUM.
           MOVE EQP-DEPT         TO EDIT-DEPT.
           MOVE EQP-MAINT-ZONE   TO EDIT-ZONE.
           MOVE EQP-LOCATION     TO EDIT-LOCATION.

           IF PLANNED-SW = 0
               MOVE EDIT-EQUIP-NAME TO WO-EQPNAME
               MOVE EDIT-TYPE-NUM TO WO-EQPTYP
               MOVE EDIT-DEPT TO WO-DEPT
               MOVE EDIT-ZONE TO WO-MAINT-ZONE
               MOVE EDIT-LOCATION TO WO-LOC
               MOVE SPACES TO MESSAGE-LINE-B
               MOVE BUFFER TO DSPLY-REC
               PERFORM 99-SCREEN-WRITE
               PERFORM 98A-SCREEN-READ
           ELSE
           MOVE EDIT-EQUIP-NAME TO WO-EQPNAME-P
           MOVE EDIT-TYPE-NUM TO WO-EQPTYP-P
           MOVE EDIT-DEPT TO WO-DEPT-P
           MOVE EDIT-ZONE TO WO-MAINT-ZONE-P
           MOVE EDIT-LOCATION TO WO-LOC-P
           MOVE SPACES TO MESSAGE-LINE-P
           MOVE BUFFER TO DSPLY-REC
           PERFORM 99-SCREEN-WRITE
           PERFORM 98A-SCREEN-READ.

      *****************************************************************
      *    THE FOLLOWING CHECK IS PLACED HERE SO THAT EQP-EQUIPMENT   *
      *    COULD BE LOADED WITH EQP-EXP-CLASS FOR DEFAULT PURPOSES    *
      *    IN PARAGRAPH 6221-CHECK-HE-HV-HP                           *
      *****************************************************************
           IF EDIT-WO-STAT NOT = SAVE-WO-STAT-1-2
               PERFORM 622-CHECK-HISTORY-STATUS THRU 622-CHS-EXIT
               IF INDS (99) = TRUE-VAL
                   MOVE ERROR-BUFFER TO EDIT-ERROR
                   MOVE TRUE-VAL TO INDS (3) INDS (99)
                   PERFORM 69-READ-SCREEN
                   GO TO 621-CK-KEY-MODIFICATIONS.

      *****************************************************************
      *    SAFETY EQUIPMENT CHECK.
      *****************************************************************
           IF EQP-SAFETY-FLG = "X"
               MOVE 29125 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE ERROR-BUFFER TO EDIT-ERROR
               MOVE TRUE-VAL TO INDS (12) INDS (99)
               PERFORM 69-READ-SCREEN
               GO TO 621-CK-KEY-MODIFICATIONS.

      *****************************************************************
      *    PRIORITY CHECK.
      *****************************************************************
      *****************************************************************
      *    DETERMINE IF ZONE-PRIORITY IS IN DATABASE.
      *****************************************************************
           PERFORM 68-START-WO-ZONE-PRTY.
           IF COND-WORD = 17
               MOVE 35080 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE ERROR-BUFFER TO EDIT-ERROR
               MOVE TRUE-VAL TO INDS (18) INDS (99)
               PERFORM 69-READ-SCREEN
               GO TO 621-CK-KEY-MODIFICATIONS.

           IF PLANNED-SW = 0
               GO TO 6212-CHECK-EQUIP-DOWN
           ELSE
           IF EQP-RIME NOT NUMERIC
               GO TO 6212-CHECK-EQUIP-DOWN
           ELSE
           IF EDIT-PRI = 1
               MULTIPLY 9 BY RIME-NO GIVING WO-RIME-SAVE
           ELSE
           IF EDIT-PRI = 2
               MULTIPLY 6 BY RIME-NO GIVING WO-RIME-SAVE
           ELSE
           IF EDIT-PRI = 3
               MULTIPLY 4 BY RIME-NO GIVING WO-RIME-SAVE
           ELSE
           IF EDIT-PRI = 4
               MULTIPLY 2 BY RIME-NO GIVING WO-RIME-SAVE
           ELSE
           MOVE RIME-NO TO WO-RIME-SAVE.

           IF WO-RIME-P = RIME-P
               IF WO-RIME-SAVE = RIME-P
                   NEXT SENTENCE
               ELSE
               MOVE WO-RIME-SAVE TO WO-RIME-P
           ELSE
           IF WO-RIME-P > 81
               MOVE 44042 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE ERROR-BUFFER TO EDIT-ERROR
               MOVE TRUE-VAL TO INDS (19) INDS (99)
               PERFORM 69-READ-SCREEN
               GO TO 621-CK-KEY-MODIFICATIONS
           ELSE
           IF WO-RIME-P = 0
               MOVE WO-RIME-SAVE TO WO-RIME-P
           ELSE
           IF WO-RIME-P = 79 OR 80
               MOVE 44041 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE ERROR-BUFFER TO EDIT-ERROR
               MOVE TRUE-VAL TO INDS (19) INDS (99)
               PERFORM 69-READ-SCREEN
               GO TO 621-CK-KEY-MODIFICATIONS.

      *****************************************************************
      *     CHECK EQUIPMENT DOWN CODE
      *****************************************************************
       6212-CHECK-EQUIP-DOWN.
           IF EDIT-EQUIP-DOWN = "Y" OR "N" OR "?" OR " "
               NEXT SENTENCE
           ELSE
           IF WO-NUM-SUFF-P = "000"
               NEXT SENTENCE
           ELSE
           MOVE 31033 TO CATREAD-MSG-NUMBER
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
           MOVE ERROR-BUFFER TO EDIT-ERROR
           MOVE TRUE-VAL TO INDS (20) INDS (99)
           PERFORM 69-READ-SCREEN
           GO TO 621-CK-KEY-MODIFICATIONS.

           IF PLANNED-SW = 1 GO TO 6213-CHECK-EXPCLASS.

      ******************************************************************
      *    CHECK CRAFTS FOR VALIDITY
      ******************************************************************
           IF SAVE-CRAFTS-REQD-1 NOT = WO-CRAFTS-REQD-1
               MOVE WO-CRAFTS-REQD-1 TO ARG-NO
               PERFORM 6217-VERIFY-CRAFT
               IF COND-WORD = 0
                   NEXT SENTENCE
               ELSE
               MOVE 35037 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE ERROR-BUFFER TO EDIT-ERROR
               MOVE TRUE-VAL TO INDS (22) INDS (99)
               PERFORM 69-READ-SCREEN
               GO TO 621-CK-KEY-MODIFICATIONS.

           IF SAVE-CRAFTS-REQD-2 NOT = WO-CRAFTS-REQD-2
               MOVE WO-CRAFTS-REQD-2 TO ARG-NO
               PERFORM 6217-VERIFY-CRAFT
               IF COND-WORD = 0
                   NEXT SENTENCE
               ELSE
               MOVE 35037 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE ERROR-BUFFER TO EDIT-ERROR
               MOVE TRUE-VAL TO INDS (23) INDS (99)
               PERFORM 69-READ-SCREEN
               GO TO 621-CK-KEY-MODIFICATIONS.

           IF SAVE-CRAFTS-REQD-3 NOT = WO-CRAFTS-REQD-3
               MOVE WO-CRAFTS-REQD-3 TO ARG-NO
               PERFORM 6217-VERIFY-CRAFT
               IF COND-WORD = 0
                   NEXT SENTENCE
               ELSE
               MOVE 35037 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE ERROR-BUFFER TO EDIT-ERROR
               MOVE TRUE-VAL TO INDS (24) INDS (99)
               PERFORM 69-READ-SCREEN
               GO TO 621-CK-KEY-MODIFICATIONS.

      *****************************************************************
      *    EXP-CLASS CHECK.
      *****************************************************************
       6213-CHECK-EXPCLASS.
           IF WO-START-STATUS = "AA" OR "AR"
               GO TO 6214-CHECK-DATEREQD.

           IF EDIT-EXPCLASS = "        "
               IF WO-NUM-SUFF-P = "000"
                  GO TO 6214-CHECK-DATEREQD
               ELSE
               IF PLANT-IDENT = "129 "
                   IF EDIT-WO-STAT = "VO"
                       NEXT SENTENCE
                   ELSE
                   MOVE 35009 TO CATREAD-MSG-NUMBER
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE ERROR-BUFFER TO EDIT-ERROR
                   MOVE TRUE-VAL TO INDS (21) INDS (99)
                   PERFORM 69-READ-SCREEN
                   GO TO 621-CK-KEY-MODIFICATIONS
               ELSE
               MOVE 35009 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE ERROR-BUFFER TO EDIT-ERROR
               MOVE TRUE-VAL TO INDS (21) INDS (99)
               PERFORM 69-READ-SCREEN
               GO TO 621-CK-KEY-MODIFICATIONS.

           IF ECB-1 NUMERIC
               IF ECB-2 NUMERIC
                   IF ECB-3 NUMERIC
                       IF ECB-4 NUMERIC
                           IF ECB-5 NUMERIC
                               IF ECB-6 NUMERIC
                                   IF ECB-7 NUMERIC
                                       IF ECB-8 NUMERIC
                                           NEXT SENTENCE
                                       ELSE
                                       MOVE ECB-7 TO ECB-8
                                       MOVE ECB-6 TO ECB-7
                                       MOVE ECB-5 TO ECB-6
                                       MOVE ECB-4 TO ECB-5
                                       MOVE ECB-3 TO ECB-4
                                       MOVE ECB-2 TO ECB-3
                                       MOVE ECB-1 TO ECB-2
                                       MOVE "0" TO ECB-1
                                   ELSE
                                   MOVE ECB-6 TO ECB-8
                                   MOVE ECB-5 TO ECB-7
                                   MOVE ECB-4 TO ECB-6
                                   MOVE ECB-3 TO ECB-5
                                   MOVE ECB-2 TO ECB-4
                                   MOVE ECB-1 TO ECB-3
                                   MOVE "0" TO ECB-2 ECB-1
                               ELSE
                               MOVE ECB-5 TO ECB-8
                               MOVE ECB-4 TO ECB-7
                               MOVE ECB-3 TO ECB-6
                               MOVE ECB-2 TO ECB-5
                               MOVE ECB-1 TO ECB-4
                               MOVE "0" TO ECB-3 ECB-2 ECB-1
                           ELSE
                           MOVE ECB-4 TO ECB-8
                           MOVE ECB-3 TO ECB-7
                           MOVE ECB-2 TO ECB-6
                           MOVE ECB-1 TO ECB-5
                           MOVE "0" TO ECB-4 ECB-3 ECB-2 ECB-1
                       ELSE
                       MOVE ECB-3 TO ECB-8
                       MOVE ECB-2 TO ECB-7
                       MOVE ECB-1 TO ECB-6
                       MOVE "0" TO ECB-5 ECB-4 ECB-3 ECB-2 ECB-1
                   ELSE
                   MOVE ECB-2 TO ECB-8
                   MOVE ECB-1 TO ECB-7
                   MOVE "0" TO ECB-6 ECB-5 ECB-4 ECB-3 ECB-2 ECB-1
               ELSE
               MOVE ECB-1 TO ECB-8
               MOVE "0" TO ECB-7 ECB-6 ECB-5 ECB-4 ECB-3 ECB-2 ECB-1
           ELSE
           MOVE 35024 TO CATREAD-MSG-NUMBER
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
           MOVE ERROR-BUFFER TO EDIT-ERROR
           MOVE TRUE-VAL TO INDS (21) INDS (99)
           PERFORM 69-READ-SCREEN
           GO TO 621-CK-KEY-MODIFICATIONS.

           IF EDIT-EXPCLASS = "        "
               NEXT SENTENCE
           ELSE
           IF PLANT-IDENT = "112"
               NEXT SENTENCE
           ELSE
           IF ECB-1-2 = "NW"
               NEXT SENTENCE
           ELSE
           MOVE EDIT-EXPCLASS TO ARG-DEFN
           MOVE "E" TO ARG-1-4
           MOVE "C" TO ARG-2-4
           PERFORM 68-START-MVALIDPLTDATA-REC
           IF COND-WORD = 17
               MOVE "N" TO ARG-1-4
               MOVE "W" TO ARG-2-4
               PERFORM 68-START-MVALIDPLTDATA-REC
               IF COND-WORD = 17
                   MOVE 35009 TO CATREAD-MSG-NUMBER
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE ERROR-BUFFER TO EDIT-ERROR
                   MOVE TRUE-VAL TO INDS (21) INDS (99)
                   PERFORM 69-READ-SCREEN
                   GO TO 621-CK-KEY-MODIFICATIONS.

           IF PLANNED-SW = 0 GO TO 6215-DATE-START-CHECK.

       6213-CHECK-NO-CHANGE.
           IF EDIT-EXPCLASS NOT = EXP-CLASS-P
               PERFORM 6216-CK-VO-PARTS THRU 6216-CVP-EXIT
               IF INDS (99) = TRUE-VAL
                   MOVE ERROR-BUFFER TO EDIT-ERROR
                   MOVE TRUE-VAL TO INDS (20) INDS (99)
                   PERFORM 99-SCREEN-WRITE
                   PERFORM 69-READ-SCREEN
                   GO TO 621-CK-KEY-MODIFICATIONS.

      *****************************************************************
      *    DATE-REQD CHECK.
      *****************************************************************
       6214-CHECK-DATEREQD.
           IF WO-DATE-REQD-P = "      "
               NEXT SENTENCE
           ELSE
      *------- CHECK FOR NUMERIC DATE.     04/18/1995
               IF WO-DATE-REQD-P-MD NOT NUMERIC
                   MOVE 35031 TO CATREAD-MSG-NUMBER
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE ERROR-BUFFER TO EDIT-ERROR
                   MOVE TRUE-VAL TO INDS (22) INDS (99)
                   PERFORM 69-READ-SCREEN
                   GO TO 621-CK-KEY-MODIFICATIONS
           ELSE
               IF WO-DATE-REQD-P-DM NOT NUMERIC
                   MOVE 35030 TO CATREAD-MSG-NUMBER
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE ERROR-BUFFER TO EDIT-ERROR
                   MOVE TRUE-VAL TO INDS (23) INDS (99)
                   PERFORM 69-READ-SCREEN
                   GO TO 621-CK-KEY-MODIFICATIONS
           ELSE
               IF WO-DATE-REQD-P-YY NOT NUMERIC
                   MOVE 35032 TO CATREAD-MSG-NUMBER
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE ERROR-BUFFER TO EDIT-ERROR
                   MOVE TRUE-VAL TO INDS (24) INDS (99)
                   PERFORM 69-READ-SCREEN
                   GO TO 621-CK-KEY-MODIFICATIONS
           ELSE
           IF DATE-FLAG = 3
               IF WO-DATE-REQD-P-MD > 0 AND < 32
                   MOVE WO-DATE-REQD-P TO WA-DATE
                   MOVE "Y" TO DAYS-OK-SW
                   PERFORM 6215-VALID-DAYS-IN-MONTH
                       VARYING SUB1 FROM 1 BY 1 UNTIL SUB1 > 12
                   IF DAYS-OK-SW = "N"
                       MOVE 35030 TO CATREAD-MSG-NUMBER
                       PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                       MOVE ERROR-BUFFER TO EDIT-ERROR
                       MOVE TRUE-VAL TO INDS (23) INDS (99)
                       PERFORM 69-READ-SCREEN
                       GO TO 621-CK-KEY-MODIFICATIONS
                   ELSE
                   IF WO-DATE-REQD-P-DM > 0 AND < 13
                       IF WO-DATE-REQD-P-YY NUMERIC
                           NEXT SENTENCE
                       ELSE
                       MOVE 35032 TO CATREAD-MSG-NUMBER
                       PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                       MOVE ERROR-BUFFER TO EDIT-ERROR
                       MOVE TRUE-VAL TO INDS (24) INDS (99)
                       PERFORM 69-READ-SCREEN
                       GO TO 621-CK-KEY-MODIFICATIONS
                   ELSE
                   MOVE 35031 TO CATREAD-MSG-NUMBER
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE ERROR-BUFFER TO EDIT-ERROR
                   MOVE TRUE-VAL TO INDS (23) INDS (99)
                   PERFORM 69-READ-SCREEN
                   GO TO 621-CK-KEY-MODIFICATIONS
               ELSE
               MOVE 35030 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE ERROR-BUFFER TO EDIT-ERROR
               MOVE TRUE-VAL TO INDS (22) INDS (99)
               PERFORM 69-READ-SCREEN
               GO TO 621-CK-KEY-MODIFICATIONS
           ELSE
