                       MOVE 35032 TO CATREAD-MSG-NUMBER
                       PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                       MOVE ERROR-BUFFER TO EDIT-ERROR
                       MOVE TRUE-VAL TO INDS (59) INDS (99)
                       PERFORM 69-READ-SCREEN
                       GO TO 621-CK-KEY-MODIFICATIONS
                   ELSE
                   MOVE 35031 TO CATREAD-MSG-NUMBER
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE ERROR-BUFFER TO EDIT-ERROR
                   MOVE TRUE-VAL TO INDS (57) INDS (99)
                   PERFORM 69-READ-SCREEN
                   GO TO 621-CK-KEY-MODIFICATIONS
               ELSE
               MOVE 35030 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE ERROR-BUFFER TO EDIT-ERROR
               MOVE TRUE-VAL TO INDS (58) INDS (99)
               PERFORM 69-READ-SCREEN
               GO TO 621-CK-KEY-MODIFICATIONS
           ELSE
           IF EDIT-DATE-COMP-MD > 0 AND < 13
               IF EDIT-DATE-COMP-DM > 0 AND < 32
                   MOVE EDIT-DATE-COMP TO WA-DATE
                   MOVE "Y" TO DAYS-OK-SW
                   PERFORM 6215-VALID-DAYS-IN-MONTH
                       VARYING SUB1 FROM 1 BY 1 UNTIL SUB1 > 12
                   IF DAYS-OK-SW = "N"
                       MOVE 35030 TO CATREAD-MSG-NUMBER
                       PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                       MOVE ERROR-BUFFER TO EDIT-ERROR
                       MOVE TRUE-VAL TO INDS (58) INDS (99)
                       PERFORM 69-READ-SCREEN
                       GO TO 621-CK-KEY-MODIFICATIONS
                   ELSE
                   IF EDIT-DATE-COMP-YY NUMERIC
                       NEXT SENTENCE
                   ELSE
                   MOVE 35032 TO CATREAD-MSG-NUMBER
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE ERROR-BUFFER TO EDIT-ERROR
                   MOVE TRUE-VAL TO INDS (59) INDS (99)
                   PERFORM 69-READ-SCREEN
                   GO TO 621-CK-KEY-MODIFICATIONS
               ELSE
               MOVE 35030 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE ERROR-BUFFER TO EDIT-ERROR
               MOVE TRUE-VAL TO INDS (58) INDS (99)
               PERFORM 69-READ-SCREEN
               GO TO 621-CK-KEY-MODIFICATIONS
           ELSE
           MOVE 35031 TO CATREAD-MSG-NUMBER
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
           MOVE ERROR-BUFFER TO EDIT-ERROR
           MOVE TRUE-VAL TO INDS (57) INDS (99)
           PERFORM 69-READ-SCREEN
           GO TO 621-CK-KEY-MODIFICATIONS.

           IF EDIT-DATE-COMP = "      "
               NEXT SENTENCE
           ELSE
           IF DATE-COMP-BUF-CN < DATE-STRT-BUF-CN
               MOVE 30010 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE ERROR-BUFFER TO EDIT-ERROR
               MOVE TRUE-VAL TO INDS (57) INDS (99)
               PERFORM 69-READ-SCREEN
               GO TO 621-CK-KEY-MODIFICATIONS
           ELSE
           IF DATE-COMP-BUF-CN > DATE-CURR-BUF-CN
               MOVE 30011 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE ERROR-BUFFER TO EDIT-ERROR
               MOVE TRUE-VAL TO INDS (57) INDS (99)
               PERFORM 69-READ-SCREEN
               GO TO 621-CK-KEY-MODIFICATIONS.

      *****************************************************************
      *    TIME COMPLETED CHECK
      *****************************************************************
           IF ETC-MM = "  "
               IF ETC-HH = "  "
                   NEXT SENTENCE
               ELSE
               MOVE "00" TO ETC-MM.

           IF EDIT-TIME-COMP = "    "
               NEXT SENTENCE
      *--- CHECK FOR NUMERIC TIME COMPLETED.    04/14/1995
           ELSE
           IF EDIT-TIME-COMP NOT NUMERIC
               MOVE 46009 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE ERROR-BUFFER TO EDIT-ERROR
               MOVE TRUE-VAL TO INDS (60) INDS (99)
               PERFORM 69-READ-SCREEN
               GO TO 621-CK-KEY-MODIFICATIONS
           ELSE
           IF EDIT-TIME-COMP-HH < 24
               NEXT SENTENCE
           ELSE
           MOVE 35055 TO CATREAD-MSG-NUMBER
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
           MOVE ERROR-BUFFER TO EDIT-ERROR
           MOVE TRUE-VAL TO INDS (60) INDS (99)
           PERFORM 69-READ-SCREEN
           GO TO 621-CK-KEY-MODIFICATIONS.

           IF EDIT-TIME-COMP = "    "
               NEXT SENTENCE
           ELSE
           IF EDIT-TIME-COMP-MM < 60
               NEXT SENTENCE
           ELSE
           MOVE 35054 TO CATREAD-MSG-NUMBER
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
           MOVE ERROR-BUFFER TO EDIT-ERROR
           MOVE TRUE-VAL TO INDS (61) INDS (99)
           PERFORM 69-READ-SCREEN
           GO TO 621-CK-KEY-MODIFICATIONS.

           IF EDIT-TIME-COMP = "    " AND
               EDIT-DATE-COMP NOT = "      "
                   MOVE 30012 TO CATREAD-MSG-NUMBER
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE ERROR-BUFFER TO EDIT-ERROR
                   MOVE TRUE-VAL TO INDS (57) INDS (99)
                   PERFORM 69-READ-SCREEN
                   GO TO 621-CK-KEY-MODIFICATIONS.

           IF DATE-COMP-BUF-CN = DATE-STRT-BUF-CN AND
               WO-TIME-COMP-P < WO-TIME-STRT-P
                   MOVE 46021 TO CATREAD-MSG-NUMBER
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE ERROR-BUFFER TO EDIT-ERROR
                   MOVE TRUE-VAL TO INDS (57) INDS (99)
                   PERFORM 69-READ-SCREEN
                   GO TO 621-CK-KEY-MODIFICATIONS.

       621-CKM-EXIT.   EXIT.

       6215-VALID-DAYS-IN-MONTH.
           IF DATE-FLAG = 3
               IF MONTH-TAB (SUB1) = WA-DATE-DM
                   IF WA-DATE-MD > DAY-TAB (SUB1)
                       MOVE "N" TO DAYS-OK-SW
                   ELSE
                   NEXT SENTENCE
               ELSE
               NEXT SENTENCE
           ELSE
           IF MONTH-TAB (SUB1) = WA-DATE-MD
               IF WA-DATE-DM > DAY-TAB (SUB1)
                   MOVE "N" TO DAYS-OK-SW.

       6216-CK-VO-PARTS.
           PERFORM 68-START-WO-PARTS-FILE.
           IF COND-WORD = 17 GO TO 6216-CVP-EXIT.

       6216-CVP-LOOP.
           PERFORM 68-READ-WO-PARTS-FILE.
           IF COND-WORD = 15 GO TO 6216-CVP-EXIT.
           IF EDIT-WO-STAT = "VO" OR "DW"
               NEXT SENTENCE
           ELSE
           IF PRT-REQ-NO = "      " OR "CANCEL"
               GO TO 6216-CVP-LOOP
           ELSE
           IF PRT-DELETE-FLAG = "D"
               GO TO 6216-CVP-LOOP
           ELSE
           MOVE SPACES TO CMR-DATA CMR-RETURNED-DATA CMR-DESC
               CMR-REMARKS CMR-MISC-PARMS
           MOVE "IN" TO CMR-CALL-MODE
           MOVE PRT-WO-NU TO CMR-WO-NUMBER
           MOVE PRT-REQ-NO TO CMR-REQ-NUMBER
           CALL "CMANINQ" USING BASE-STORES
                                CMR-CALL-MODE
                                CMR-DATA
                                CMR-DESC
                                CMR-REMARKS
                                CMR-RETURNED-DATA
                                CMR-MISC-PARMS
                                LANGUAGE-PARMS
                                ESC-NAME
                                STATUS-AREA
                                BU-DISPLAY-MSG
           IF CMR-RETURN-STATUS = "C1" OR "C2" OR "C3"
               MOVE TRUE-VAL TO INDS (20) INDS (99)
               MOVE 40078 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE ERROR-BUFFER TO EDIT-ERROR
               GO TO 6216-CVP-EXIT
           ELSE
           GO TO 6216-CVP-LOOP.

           IF PRT-STATUS-1 = "R"
               MOVE 29095 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE ERROR-BUFFER TO EDIT-ERROR
               MOVE TRUE-VAL TO INDS (3) INDS (99)
               GO TO 6216-CVP-EXIT.

           IF PRT-REQ-NO = "      " OR "CANCEL" GO TO 6216-CVP-LOOP.
           IF PRT-DELETE-FLAG = "D" GO TO 6216-CVP-LOOP.
           MOVE SPACES TO CMR-DATA CMR-RETURNED-DATA CMR-DESC
               CMR-REMARKS CMR-MISC-PARMS.
           MOVE "IN" TO CMR-CALL-MODE.
           MOVE PRT-WO-NU TO CMR-WO-NUMBER.
           MOVE PRT-REQ-NO TO CMR-REQ-NUMBER.

           CALL "CMANINQ" USING BASE-STORES
                                CMR-CALL-MODE
                                CMR-DATA
                                CMR-DESC
                                CMR-REMARKS
                                CMR-RETURNED-DATA
                                CMR-MISC-PARMS
                                LANGUAGE-PARMS
                                ESC-NAME
                                STATUS-AREA
                                BU-DISPLAY-MSG.

           IF CMR-RETURN-STATUS = "C1" OR "C2"
               MOVE 29 TO CATREAD-MSG-SET
               PERFORM 62161-SET-VO-OR-DW-MSG
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE TRUE-VAL TO INDS (3) INDS (99)
               GO TO 6216-CVP-EXIT.

           IF CMR-REQ-RELEASE-STAT = "  " OR "X "
               MOVE 29 TO CATREAD-MSG-SET
               PERFORM 62161-SET-VO-OR-DW-MSG
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE TRUE-VAL TO INDS (3) INDS (99)
               GO TO 6216-CVP-EXIT.

           IF CMR-REQ-RELEASE-STAT = "XX"
               IF CMR-PO-QTY-DLVR > CMR-PO-QTY-ORD
                   NEXT SENTENCE
               ELSE
               IF CMR-PO-QTY-DLVR = CMR-PO-QTY-ORD
                   NEXT SENTENCE
               ELSE
               MOVE 29 TO CATREAD-MSG-SET
               PERFORM 62161-SET-VO-OR-DW-MSG
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE TRUE-VAL TO INDS (3) INDS (99)
               GO TO 6216-CVP-EXIT.

           GO TO 6216-CVP-LOOP.

       6216-CVP-EXIT.    EXIT.

       62161-SET-VO-OR-DW-MSG.
           IF EDIT-WO-STAT = "VO"
               MOVE 95001 TO CATREAD-MSG-NUMBER
           ELSE
           MOVE 96001 TO CATREAD-MSG-NUMBER.

       6217-VERIFY-CRAFT.
           MOVE ARG-NO TO CRAFTREQD OF WCRFREC.
           PERFORM 68-START-WO-CRAFTS-FILE.

       622-CHECK-HISTORY-STATUS.
           PERFORM 6221-CHECK-HE-HP-HV THRU 6221-CHHHS-EXIT.

       622-CHS-EXIT.    EXIT.

       6221-CHECK-HE-HP-HV.
           IF EDIT-WO-STAT = "HE" OR "HV" OR "HP"
               NEXT SENTENCE
           ELSE
           GO TO 6221-CHHHS-EXIT.

           IF PLANNED-SW = 1
               IF WO-NUM-SUFF-P = SPACES
                   NEXT SENTENCE
               ELSE
      *******************************************************************
      *    SUFFIXED WORK ORDERS CANNOT BE SHIFTED TO VERBAL LOOP        *
      *                (CODE ADDED 5-11-88)                             *
      *******************************************************************
               IF EDIT-WO-STAT = "HV"
                   MOVE TRUE-VAL TO INDS (3) INDS (99)
                   MOVE 45049 TO CATREAD-MSG-NUMBER
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   GO TO 6221-CHHHS-EXIT.

           IF EDIT-WO-STAT = "HP"
               IF PLANNED-SW = 1
                   MOVE "P" TO EDIT-WO-CURRENT-TYPE WO-CURRENT-TYPE
                   MOVE "R" TO PLNR-RESP-IND
                   MOVE "  " TO ENGR-RESP-IND SCHD-RESP-IND
                   PERFORM 62212-SET-P-OR-E
                   ACCEPT DATE-WORK-AREA FROM DATE
                   MOVE DATE-WA-MM TO DATE-RECD-P-MM
                   MOVE DATE-WA-DD TO DATE-RECD-P-DD
                   MOVE DATE-WA-YY TO DATE-RECD-P-YY
                   PERFORM 62212-SET-DATE-RECD-P-CC
                   ACCEPT TIME-BUFFER FROM TIME
                   MOVE TIME-BUFF TO TIME-RECD-P
                   MOVE 1 TO TP-SW
                   MOVE "OO" TO WO-STATUS-P EDIT-WO-STAT
                   MOVE "TP" TO ERROR-SWITCH
                   CALL "TPRINTWS" USING DBPARAMETERS WO-PLANNED-DATA
                                     ERROR-SWITCH VIEW-COMAREA
                   MOVE 0 TO ERR-SW
                   GO TO 6221-CHHHS-EXIT
               ELSE
               MOVE SPACES TO WO-PLANNED-DATA
               MOVE 1 TO PLANNED-SW
               PERFORM 68-DELETE-WO-BASIC-FILE
               MOVE "DBDELETE FAILURE * TMODWORK *" TO BU-DISPLAY-MSG
               PERFORM 62219-CK-AND-RECORD-ERROR
      *        UNLOCK OF WO-BASIC OCCURRED HERE
               MOVE WO-NUM TO WO-NUM-PLANNED
               ACCEPT DATE-WORK-AREA FROM DATE
               MOVE DATE-WA-MM TO DATE-RECD-P-MM
               MOVE DATE-WA-DD TO DATE-RECD-P-DD
               MOVE DATE-WA-YY TO DATE-RECD-P-YY
               PERFORM 62212-SET-DATE-RECD-P-CC
               ACCEPT TIME-BUFFER FROM TIME
               MOVE TIME-BUFF TO TIME-RECD-P
               MOVE REQUESTER-B TO REQUESTER-P
               MOVE "U" TO APPROVAL-CODE-P
               MOVE EQUIP-NUM TO EQUIP-NUM-P
               MOVE EQUIP-NAME TO EQUIP-NAME-P
               MOVE TYPE-NUM TO TYPE-NUM-P
               MOVE DEPT TO DEPT-P
               MOVE EDIT-ZONE TO ZONE-P
               MOVE EDIT-PRIORITY TO PRIORITY-P
               MOVE LOCATION OF WO-BASIC-DATA TO LOCATION-P
               MOVE EQUIP-DOWN TO EQUIP-DOWN-P
               MOVE EXP-CLASS  TO EXP-CLASS-P
               MOVE DESCRIPTION-1 TO DESCRIPTION-1-P
               MOVE DESCRIPTION-2 TO DESCRIPTION-2-P
               MOVE SPACES TO DATE-REQD-CN TIME-REQD
               MOVE SPACES TO DATE-STRT-P-CN TIME-STRT-P
               MOVE SPACES TO FAILURE-CODE-P
               MOVE SPACES TO DATE-COMP-P-CN TIME-COMP-P
               MOVE WO-STRT-STATUS TO WO-START-STATUS
               MOVE "P" TO WO-CURRENT-TYPE
               MOVE "R" TO PLNR-RESP-IND
               MOVE "  " TO ENGR-RESP-IND SCHD-RESP-IND
               PERFORM 62212-SET-P-OR-E
               MOVE "OO" TO WO-STATUS-P EDIT-WO-STAT
               MOVE "TP" TO ERROR-SWITCH
               CALL "TPRINTWS" USING DBPARAMETERS WO-PLANNED-DATA
                                 ERROR-SWITCH VIEW-COMAREA
               MOVE 0 TO ERR-SW
               PERFORM 68-WRITE-WO-PLANNED-FILE
               MOVE "DBPUT FAILURE * TMODWORK *" TO BU-DISPLAY-MSG
               PERFORM 62219-CK-AND-RECORD-ERROR
               MOVE 49035 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE ERROR-BUFFER TO P-CHG-LIT
               MOVE WO-NUM-PLANNED TO WO-CHG
               MOVE P-CHG-LIT TO CMDLINE-B
               MOVE TRUE-VAL TO INDS (98)
               MOVE WO-BASIC-BUF TO DSPLY-REC
               PERFORM 99-SCREEN-WRITE
               PERFORM 98A-SCREEN-READ
               CALL "CLPAUSE2"
               MOVE SPACES TO WO-TRACK-DATA
               MOVE USERNAME TO USER-NAME
               MOVE TERMNUM TO USER-TERM
               MOVE WO-NUM-PLANNED TO WO-NUM-TRACK
               MOVE T-BUF-CC TO DATE-STAMP-CC
               MOVE T-BUF-YY TO DATE-STAMP-YY
               MOVE T-BUF-MM TO DATE-STAMP-MM
               MOVE T-BUF-DD TO DATE-STAMP-DD
               ACCEPT TIME-BUFFER FROM TIME
               MOVE TIME-BUFF TO TIME-STAMP
               MOVE WO-START-STATUS TO WO-TYPE-STATUS
               MOVE USERNAME TO USER-ID
               MOVE "    " TO CLOCK-CARD
      *        IF M-SWITCH = "O"
      *            MOVE CC-BUFFER TO CLOCK-CARD
      *        END-IF
               MOVE ENG-PL-SCHD-ID TO CLOCK-CARD
               MOVE WO-STATUS-P TO WO-STATUS-TRACK
               MOVE "HP" TO TRANS-STATUS
               MOVE "TMODWORK" TO PROGRAM-NAME
               CALL "TWOTRACK" USING WO-TRACK-DATA
               MOVE SPACES TO WO-QUEUE-DATA
               MOVE WO-NUM-PLANNED TO Q-WO-NUM
               MOVE "D" TO QUEUE-SW
               CALL "TQUPDATE" USING DBPARAMETERS WO-QUEUE-DATA
                                 QUEUE-SW ERROR-76
               GO TO 2-EOJ.

           IF EDIT-WO-STAT = "HE"
               IF PLANNED-SW = 1
                   MOVE "E" TO EDIT-WO-CURRENT-TYPE WO-CURRENT-TYPE
                   MOVE "R" TO ENGR-RESP-IND
                   MOVE "  " TO PLNR-RESP-IND SCHD-RESP-IND
                   PERFORM 62212-SET-P-OR-E
                   ACCEPT DATE-WORK-AREA FROM DATE
                   MOVE DATE-WA-MM TO DATE-RECD-P-MM
                   MOVE DATE-WA-DD TO DATE-RECD-P-DD
                   MOVE DATE-WA-YY TO DATE-RECD-P-YY
                   PERFORM 62212-SET-DATE-RECD-P-CC
                   ACCEPT TIME-BUFFER FROM TIME
                   MOVE TIME-BUFF TO TIME-RECD-P
                   MOVE 1 TO TE-SW
                   IF WO-STATUS-P = "CW"
                       IF PLANT-IDENT = "129 " OR "111 "
                           MOVE "CW" TO EDIT-WO-STAT
                           MOVE "TE" TO ERROR-SWITCH
                           CALL "TPRINTWS" USING DBPARAMETERS
                                       WO-PLANNED-DATA ERROR-SWITCH
                                       VIEW-COMAREA
                           GO TO 6221-CHHHS-EXIT
                       ELSE
                       MOVE "TE" TO ERROR-SWITCH
                       MOVE "OO" TO WO-STATUS-P EDIT-WO-STAT
                       CALL "TPRINTWS" USING DBPARAMETERS
                                         WO-PLANNED-DATA ERROR-SWITCH
                                         VIEW-COMAREA
                       GO TO 6221-CHHHS-EXIT
                   ELSE
                   MOVE "TE" TO ERROR-SWITCH
                   MOVE "OO" TO WO-STATUS-P EDIT-WO-STAT
                   CALL "TPRINTWS" USING DBPARAMETERS
                                     WO-PLANNED-DATA ERROR-SWITCH
                                     VIEW-COMAREA
                   MOVE 0 TO ERR-SW
                   GO TO 6221-CHHHS-EXIT
               ELSE
               MOVE 29052 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE TRUE-VAL TO INDS (3) INDS (99)
               PERFORM 69-READ-SCREEN
               GO TO 621-CK-KEY-MODIFICATIONS.

           IF EDIT-WO-STAT = "HV"
               IF PLANNED-SW = 1
                 IF WO-CURRENT-TYPE = "P"
                   MOVE VIEW-CFNAME TO SAVE-VIEW-CFNAME
                   PERFORM 62211-GET-CRAFT THRU 62211-GC-EXIT
                   MOVE SAVE-VIEW-CFNAME TO VIEW-CFNAME
                   MOVE SPACES TO WO-BASIC-DATA
                   PERFORM 68-DELETE-WO-PLANNED-FILE
                   MOVE "DBDELETE FAILURE * TMODWORK * "
                       TO BU-DISPLAY-MSG
                   PERFORM 62219-CK-AND-RECORD-ERROR
                   MOVE WO-NUM-PLANNED TO WO-NUM
                   MOVE "OO" TO WO-STATUS EDIT-WO-STAT
                   ACCEPT DATE-WORK-AREA FROM DATE
                   MOVE DATE-WA-MM TO DATE-RECD-MM
                   MOVE DATE-WA-DD TO DATE-RECD-DD
                   MOVE DATE-WA-YY TO DATE-RECD-YY
                   PERFORM 62212-SET-DATE-RECD-CC
                   ACCEPT TIME-BUFFER FROM TIME
                   MOVE TIME-BUFF TO TIME-RECD
                   MOVE REQUESTER-P TO REQUESTER-B
                   MOVE "A" TO APPROVAL-CODE
                   MOVE EQUIP-NUM-P TO EQUIP-NUM
                   MOVE EQUIP-NAME-P TO EQUIP-NAME
                   MOVE TYPE-NUM-P TO TYPE-NUM
                   MOVE DEPT-P TO DEPT
                   MOVE EDIT-ZONE TO ZONE
                   MOVE EDIT-PRI TO PRIORITY
                   MOVE LOCATION-P TO LOCATION OF WO-BASIC-DATA
                   MOVE EQUIP-DOWN-P TO EQUIP-DOWN
                   MOVE CRAFT-1-BUF TO CRAFTS-REQD-1
                   MOVE CRAFT-2-BUF TO CRAFTS-REQD-2
                   MOVE CRAFT-3-BUF TO CRAFTS-REQD-3
                   PERFORM 62211-SET-VERBAL-EXPCLASS
                   MOVE DESCRIPTION-1-P TO DESCRIPTION-1
                   MOVE DESCRIPTION-2-P TO DESCRIPTION-2
                   MOVE WO-START-STATUS TO WO-STRT-STATUS
                   MOVE "V" TO WO-CURR-TYPE
                   MOVE SPACES TO DATE-STRT-CN TIME-STRT FAILURE-CODE
                       DATE-COMP-CN TIME-COMP
                   PERFORM 68-WRITE-WO-BASIC-FILE
                   MOVE "DBPUT FAILURE * TMODWORK *" TO BU-DISPLAY-MSG
                   PERFORM 62219-CK-AND-RECORD-ERROR
                   MOVE 49036 TO CATREAD-MSG-NUMBER
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE ERROR-BUFFER TO P-CHG-LIT2
                   MOVE WO-NUM TO WO-CHG2
                   MOVE P-CHG-LIT2 TO CMDLINE-P
                   MOVE TRUE-VAL TO INDS (98)
                   MOVE WO-PLANNED-BUF TO DSPLY-REC
                   PERFORM 99-SCREEN-WRITE
                   PERFORM 98A-SCREEN-READ
                   CALL "CLPAUSE2"
                   MOVE SPACES TO WO-TRACK-DATA
                   MOVE USERNAME TO USER-NAME
                   MOVE TERMNUM TO USER-TERM
                   MOVE WO-NUM TO WO-NUM-TRACK
                   MOVE T-BUF-CC TO DATE-STAMP-CC
                   MOVE T-BUF-YY TO DATE-STAMP-YY
                   MOVE T-BUF-MM TO DATE-STAMP-MM
                   MOVE T-BUF-DD TO DATE-STAMP-DD
                   ACCEPT TIME-BUFFER FROM TIME
                   MOVE TIME-BUFF TO TIME-STAMP
                   MOVE WO-STRT-STATUS TO WO-TYPE-STATUS
                   MOVE USERNAME TO USER-ID
                   MOVE "    " TO CLOCK-CARD
      *            IF M-SWITCH = "O"
      *                MOVE CC-BUFFER TO CLOCK-CARD
      *            END-IF
                   MOVE ENG-PL-SCHD-ID TO CLOCK-CARD
                   MOVE WO-STATUS TO WO-STATUS-TRACK
                   MOVE "HV" TO TRANS-STATUS
                   MOVE "TMODWORK" TO PROGRAM-NAME
                   CALL "TWOTRACK" USING WO-TRACK-DATA
                   MOVE "0" TO CONDIT-CODE
                   CALL "TPRTWO" USING DBPARAMETERS WO-BASIC-DATA
                                   WO-NUMBER-BUF CONDIT-CODE
                                   VIEW-COMAREA
                   PERFORM 62211-QUEUE-DATA
                   GO TO 2-EOJ
                 ELSE
                 MOVE 29053 TO CATREAD-MSG-NUMBER
                 PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                 MOVE TRUE-VAL TO INDS (3) INDS (99)
                 PERFORM 69-READ-SCREEN
                 GO TO 621-CK-KEY-MODIFICATIONS
               ELSE
               ACCEPT DATE-WORK-AREA FROM DATE
               MOVE DATE-WA-MM TO DATE-RECD-MM
               MOVE DATE-WA-DD TO DATE-RECD-DD
               MOVE DATE-WA-YY TO DATE-RECD-YY
               PERFORM 62212-SET-DATE-RECD-CC
               ACCEPT TIME-BUFFER FROM TIME
               MOVE TIME-BUFF TO TIME-RECD-P
               MOVE SPACES TO DATE-STRT-CN TIME-STRT FAILURE-CODE
                    DATE-COMP-CN TIME-COMP
               MOVE "0" TO CONDIT-CODE
               CALL "TPRTWO" USING DBPARAMETERS WO-BASIC-DATA
                               WO-NUMBER-BUF CONDIT-CODE
                               VIEW-COMAREA.

       6221-CHHHS-EXIT.    EXIT.

       62211-GET-CRAFT.
           MOVE "FADDCRFT" TO VIEW-CFNAME.

       62211-WRITE-SCREEN.
           MOVE SPACES TO CRAFT-BUF ERROR-76 DSPLY-REC.
           PERFORM 99-SCREEN-WRITE.

       62211-SHOWFORM.
           PERFORM 98-SCREEN-READ.
           MOVE DSPLY-REC TO CRAFT-BUF.
           IF VIEW-LASTKEY = 3 GO TO 62211-GC-EXIT.

           IF CRAFT-BUF = SPACES
               MOVE 29032 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE ERROR-BUFFER TO CRAFT-ERR-LINE
               MOVE CRAFT-BUF TO DSPLY-REC
               MOVE TRUE-VAL TO INDS (1) INDS (99)
               PERFORM 99-SCREEN-WRITE
               GO TO 62211-SHOWFORM.

           IF CRAFT-1-BUF = SPACES
               NEXT SENTENCE
           ELSE
           MOVE CRAFT-1-BUF TO CRAFTREQD OF WCRFREC
           PERFORM 68-START-WO-CRAFTS-FILE
           IF COND-WORD = 17
               MOVE 35035 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE ERROR-BUFFER TO CRAFT-CMD-LINE
               MOVE CRAFT-BUF TO DSPLY-REC
               MOVE TRUE-VAL TO INDS (1) INDS (99)
               PERFORM 99-SCREEN-WRITE
               GO TO 62211-SHOWFORM.

           IF CRAFT-2-BUF = SPACES
               NEXT SENTENCE
           ELSE
           MOVE CRAFT-2-BUF TO CRAFTREQD OF WCRFREC
           PERFORM 68-START-WO-CRAFTS-FILE
           IF COND-WORD = 17
               MOVE 35035 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE ERROR-BUFFER TO CRAFT-CMD-LINE
               MOVE CRAFT-BUF TO DSPLY-REC
               MOVE TRUE-VAL TO INDS (1) INDS (99)
               PERFORM 99-SCREEN-WRITE
               GO TO 62211-SHOWFORM.

           IF CRAFT-3-BUF = SPACES
               NEXT SENTENCE
           ELSE
           MOVE CRAFT-3-BUF TO CRAFTREQD OF WCRFREC
           PERFORM 68-START-WO-CRAFTS-FILE
           IF COND-WORD = 17
               MOVE 35035 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE ERROR-BUFFER TO CRAFT-CMD-LINE
               MOVE CRAFT-BUF TO DSPLY-REC
               MOVE TRUE-VAL TO INDS (1) INDS (99)
               PERFORM 99-SCREEN-WRITE
               GO TO 62211-SHOWFORM.

       62211-GC-EXIT.    EXIT.

       62212-SET-P-OR-E.
           IF WO-CURRENT-TYPE = "P"
               IF PLANNER = "    "
                   MOVE "INIT" TO PLANNER.

           IF WO-CURRENT-TYPE = "E"
               IF ENGINEER = "    "
                   MOVE "INIT" TO ENGINEER.

       62212-SET-DATE-RECD-CC.
            IF DATE-RECD-YY > "70"
                MOVE "19" TO DATE-RECD-CC
            ELSE
            MOVE "20" TO DATE-RECD-CC.

       62212-SET-DATE-RECD-P-CC.
            IF DATE-RECD-P-YY > "70"
                MOVE "19" TO DATE-RECD-P-CC
           ELSE
           MOVE "20" TO DATE-RECD-P-CC.

       62211-QUEUE-DATA.
           MOVE EQUIP-NUM TO EQPNUM OF EFREC.
           PERFORM 68-START-EQUIP-FILE.
           MOVE SPACES TO WO-QUEUE-DATA.
           MOVE ZONE          TO Q-ZONE.
           MOVE "1 "          TO Q-PRTY.
           MOVE WO-NUM        TO Q-WO-NUM.
           MOVE EQUIP-DOWN    TO Q-EQP-DOWN.
           MOVE "9999"        TO Q-CC-NUM.
           MOVE EQUIP-NUM     TO Q-EQUIP-NUM.
           MOVE DESCRIPTION-1 TO Q-DESCRIPTION.
           MOVE CRAFTS-REQD-1 TO Q-SKILL-1.
           MOVE CRAFTS-REQD-2 TO Q-SKILL-2.
           MOVE CRAFTS-REQD-3 TO Q-SKILL-3.
           IF PRIORITY = "1 " MOVE 9 TO QUEUE-PRTY.
           IF PRIORITY = "2 " MOVE 6 TO QUEUE-PRTY.
           IF PRIORITY = "3 " MOVE 4 TO QUEUE-PRTY.
           IF PRIORITY = "4 " MOVE 2 TO QUEUE-PRTY.
           IF PRIORITY = "5 " MOVE 1 TO QUEUE-PRTY.

           COMPUTE QUEUE-FACTOR = RIME-NO * QUEUE-PRTY.
           MOVE "A" TO QUEUE-SW.
           CALL "TQUPDATE" USING DBPARAMETERS WO-QUEUE-DATA
                             QUEUE-SW ERROR-76.

       62211-SET-VERBAL-EXPCLASS.
           IF PLANT-IDENT = "126 "
               IF EDIT-EXPCLASS NOT = EXP-CLASS-P
                   MOVE EDIT-EXPCLASS TO EXP-CLASS
               ELSE
               IF EQP-EXP-CLASS = "        "
                   MOVE "00000010" TO EXP-CLASS
               ELSE
               MOVE EQP-EXP-CLASS TO EXP-CLASS
           ELSE
           IF PLANT-IDENT = "129 "
               IF EDIT-EXPCLASS NOT = EXP-CLASS-P
                   MOVE EDIT-EXPCLASS TO EXP-CLASS
               ELSE
               IF EQP-EXP-CLASS = "        "
                   MOVE "00000001" TO EXP-CLASS
               ELSE
               MOVE EQP-EXP-CLASS TO EXP-CLASS
           ELSE
           IF PLANT-IDENT = "153 "
               IF EDIT-EXPCLASS NOT = EXP-CLASS-P
                   MOVE EDIT-EXPCLASS TO EXP-CLASS
               ELSE
               IF EQP-EXP-CLASS = "        "
                   MOVE "00000001" TO EXP-CLASS
               ELSE
               MOVE EQP-EXP-CLASS TO EXP-CLASS
           ELSE
           IF EDIT-EXPCLASS NOT = EXP-CLASS-P
               MOVE EDIT-EXPCLASS TO EXP-CLASS
           ELSE
           IF EQP-EXP-CLASS = "        "
               MOVE "        " TO EXP-CLASS
           ELSE
           MOVE EQP-EXP-CLASS TO EXP-CLASS.

       62219-CK-AND-RECORD-ERROR.
           IF COND-WORD = 17
               MOVE "  MMISA" TO BLOWUP-BASE
               MOVE "ERROR VALIDATING CRAFTS - * TMODWORK *"
                   TO BU-DISPLAY-MSG
               MOVE "WO-CRAFTS-REQD" TO BU-DISPLAY-FLD (2)
               PERFORM 998-BLOWUP.

       64-UOM-VERBAL.
           IF PLANNED-SW = 1 GO TO 64-UOM-PLANNED.
           MOVE WO-NUM TO ARG-NO.
           PERFORM 68-START-WO-BASIC-FILE.
           IF COND-WORD = 17
               MOVE "  MMISA" TO BLOWUP-BASE
               MOVE "BASIC WO FIND FOR UPDATE FAILED * TMODWORK *"
                   TO BU-DISPLAY-MSG
               MOVE "WO-BASIC"     TO BU-DISPLAY-FLD (2)
               PERFORM 998-BLOWUP.

           PERFORM 68-READ-WO-BASIC-FILE.
           IF COND-WORD = 15
               MOVE "  MMISA" TO BLOWUP-BASE
               MOVE "BASIC WO GET FOR UPDATE FAILED * TMODWORK *"
                   TO BU-DISPLAY-MSG
               MOVE "WO-BASIC"     TO BU-DISPLAY-FLD (2)
               PERFORM 998-BLOWUP.

           MOVE PRIORITY  TO PRTY-HOLD.
           MOVE EQUIP-NUM TO EQUIP-HOLD.
           IF EDIT-WO-STAT = "CW"
               IF WO-STATUS = "CW"
                   NEXT SENTENCE
               ELSE
               MOVE 2 TO Q-CHGSW.

           MOVE EDIT-WO-STAT TO WO-STATUS.
           IF EDIT-DATE-RECD = "      "
               MOVE SPACES TO DATE-RECD-CN
           ELSE
           MOVE 3 TO DATE-MODE
           MOVE EDIT-DATE-RECD TO DATE-VALIDATE-IN
           CALL "TDATECHK" USING DATE-CHECK-AREA
           MOVE DATE-DB TO DATE-RECD
           IF DATE-RECD-YY > "70"
               MOVE "19" TO DATE-RECD-CC
           ELSE
           MOVE "20" TO DATE-RECD-CC.

           IF WO-NUM = SPACES MOVE WO-NUMBER-BUF TO WO-NUM.
           MOVE EDIT-TIME-RECD TO TIME-RECD.
           MOVE EDIT-APPROVAL-CODE TO APPROVAL-CODE.
           MOVE EDIT-REQUESTER TO REQUESTER-B.
           IF EDIT-EQUIP-NUM NOT = EQUIP-NUM
               MOVE 1 TO Q-CHGSW.
           MOVE EDIT-EQUIP-NUM TO EQUIP-NUM.
           MOVE EDIT-EQUIP-NAME TO EQUIP-NAME.
           MOVE EDIT-TYPE-NUM TO TYPE-NUM.
           MOVE EDIT-DEPT TO DEPT.
           IF EDIT-ZONE NOT = ZONE
               MOVE 1 TO Q-CHGSW.
           MOVE EDIT-ZONE TO ZONE.
           MOVE EDIT-LOCATION TO LOCATION OF WO-BASIC-DATA.
           IF EDIT-PRIORITY NOT = PRIORITY
               MOVE 1 TO Q-CHGSW.
           MOVE EDIT-PRIORITY TO PRIORITY.
           IF EDIT-EQUIP-DOWN NOT = EQUIP-DOWN
               MOVE 1 TO Q-CHGSW.
           MOVE EDIT-EQUIP-DOWN TO EQUIP-DOWN.
           MOVE EDIT-EXPCLASS TO EXP-CLASS.

           IF WO-DESC-1 NOT = DESCRIPTION-1
               MOVE 1 TO Q-CHGSW.
           MOVE WO-DESC-1 TO DESCRIPTION-1.
           MOVE WO-DESC-2 TO DESCRIPTION-2-1.
           MOVE WO-DESC-3 TO DESCRIPTION-2-2.

           IF WO-CRAFTS-REQD-1 NOT = CRAFTS-REQD-1
               MOVE 1            TO Q-CHGSW.
           IF WO-CRAFTS-REQD-2 NOT = CRAFTS-REQD-2
               MOVE 1            TO Q-CHGSW.
           IF WO-CRAFTS-REQD-3 NOT = CRAFTS-REQD-3
               MOVE 1            TO Q-CHGSW.

           MOVE WO-CRAFTS-REQD-1 TO CRAFTS-REQD-1.
           MOVE WO-CRAFTS-REQD-2 TO CRAFTS-REQD-2.
           MOVE WO-CRAFTS-REQD-3 TO CRAFTS-REQD-3.
           MOVE WO-CRAFTSMEN-1 TO CRAFTSMEN-1.
           MOVE WO-CRAFTSMEN-2 TO CRAFTSMEN-2.
           MOVE WO-CRAFTSMEN-3 TO CRAFTSMEN-3.

           IF EDIT-DATE-STRT = "      "
               MOVE SPACES TO DATE-STRT-CN
           ELSE
           MOVE 3 TO DATE-MODE
           MOVE EDIT-DATE-STRT TO DATE-VALIDATE-IN
           CALL "TDATECHK" USING DATE-CHECK-AREA
           MOVE DATE-DB TO DATE-STRT
           IF DATE-STRT-YY > "70"
               MOVE "19" TO DATE-STRT-CC
           ELSE
           MOVE "20" TO DATE-STRT-CC.

           MOVE EDIT-TIME-STRT TO TIME-STRT.
           MOVE WO-FAILURE TO FAILURE-CODE.
           IF EDIT-DATE-COMP = "      "
               MOVE SPACES TO DATE-COMP-CN
           ELSE
           MOVE 3 TO DATE-MODE
           MOVE EDIT-DATE-COMP TO DATE-VALIDATE-IN
           CALL "TDATECHK" USING DATE-CHECK-AREA
           MOVE DATE-DB TO DATE-COMP
           IF DATE-COMP-YY > "70"
               MOVE "19" TO DATE-COMP-CC
           ELSE
           MOVE "20" TO DATE-COMP-CC.

           MOVE EDIT-TIME-COMP TO TIME-COMP.
           PERFORM 68-DELETE-WO-BASIC-FILE.
           IF COND-WORD = 17
               MOVE "  MMISA" TO BLOWUP-BASE
               MOVE "DBDELETE OF BASIC WO FAILED * TMODWORK *"
                   TO BU-DISPLAY-MSG
               MOVE "WO-BASIC"     TO BU-DISPLAY-FLD (2)
               MOVE ARG-NO         TO BU-DISPLAY-FLD (3)
               PERFORM 998-BLOWUP.

           PERFORM 68-WRITE-WO-BASIC-FILE.
           IF COND-WORD = 17
               MOVE "  MMISA" TO BLOWUP-BASE
               MOVE "DBPUT OF BASIC WO FAILED * TMODWORK *"
                   TO BU-DISPLAY-MSG
               MOVE "WO-BASIC"     TO BU-DISPLAY-FLD (2)
               MOVE ARG-NO         TO BU-DISPLAY-FLD (3)
               PERFORM 998-BLOWUP.

      **************************************************************************
      *    CODE ADDED 5-8-87 TO UPDATE REQUSITION EXPENSE CLASS DATA  *        *
      *    IF IT HAS BEEN MODIFIED                                    *        *
      **************************************************************************
           IF SAVE-EXPCLASS = SPACES
               NEXT SENTENCE
           ELSE
           IF SAVE-EXPCLASS = EDIT-EXPCLASS
               NEXT SENTENCE
           ELSE
           MOVE 1 TO UPLOAD-SW
           PERFORM 644-UPDATE-REQ-INFO THRU 644-URI-EXIT.

           MOVE 42075 TO CATREAD-MSG-NUMBER.
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
           MOVE ERROR-BUFFER TO P-COMP-LIT.
           MOVE WO-NUMBER-BUF TO WO-COMP-LIT.
           MOVE P-COMP-LIT TO MESSAGE-LINE-B.
           MOVE BUFFER TO DSPLY-REC.
           MOVE TRUE-VAL TO INDS (98).
           PERFORM 99-SCREEN-WRITE.
           PERFORM 98A-SCREEN-READ.
           CALL "CLPAUSE2".
           MOVE 0 TO UPLOAD-SW.
           MOVE SPACES TO WO-TRACK-DATA.
           MOVE USERNAME TO USER-NAME.
           MOVE TERMNUM TO USER-TERM.
           MOVE WO-NUM TO WO-NUM-TRACK.
           MOVE T-BUF-CC TO DATE-STAMP-CC.
           MOVE T-BUF-YY TO DATE-STAMP-YY.
           MOVE T-BUF-MM TO DATE-STAMP-MM.
           MOVE T-BUF-DD TO DATE-STAMP-DD.
           ACCEPT TIME-BUFFER FROM TIME.
           MOVE TIME-BUFF TO TIME-STAMP.
           MOVE WO-STRT-STATUS TO WO-TYPE-STATUS.
           MOVE USERNAME TO USER-ID.
           MOVE "    " TO CLOCK-CARD.
      *    IF M-SWITCH = "O"
      *        MOVE CC-BUFFER TO CLOCK-CARD.
           MOVE ENG-PL-SCHD-ID TO CLOCK-CARD.
           MOVE WO-STATUS TO WO-STATUS-TRACK.
           MOVE "TMODWORK" TO PROGRAM-NAME.
           CALL "TWOTRACK" USING WO-TRACK-DATA.

      *    IF WO-STATUS = "VO"
      *        CALL "TPRTWO" USING DBPARAMETERS WO-BASIC-DATA
      *                        WO-NUMBER-BUF CONDIT-CODE.

           IF Q-CHGSW > 0
               PERFORM 6411-UPDATE-OPENQ THRU 6411-UO-EXIT
               MOVE 0 TO Q-CHGSW.

           GO TO 64-UOM-EXIT.

       6411-UPDATE-OPENQ.
           MOVE WO-NUMBER-BUF TO WONUM OF WOQFREC.
           PERFORM 68-START-WO-OPEN-QUEUE-FILE.
           IF COND-WORD = 17 GO TO 6411-UO-EXIT.
           PERFORM 68-READ-WO-OPEN-QUEUE-FILE.
           IF COND-WORD = 15 GO TO 6411-UO-EXIT.
           MOVE WO-QUEUE-DATA TO WO-QUEUE-HOLD.
           MOVE "D" TO QUEUE-SW.
           CALL "TQUPDATE" USING DBPARAMETERS WO-QUEUE-DATA
                             QUEUE-SW ERROR-76.
           IF Q-CHGSW = 2 GO TO 6411-UO-EXIT.
           MOVE SPACES TO WO-QUEUE-DATA.
           MOVE ZONE          TO Q-ZONE.
           MOVE PRIORITY      TO Q-PRTY.
           MOVE WO-NUM        TO Q-WO-NUM.
           MOVE EQUIP-DOWN    TO Q-EQP-DOWN.
           MOVE "9999"        TO Q-CC-NUM.
           MOVE EQUIP-NUM     TO Q-EQUIP-NUM.
           MOVE DESCRIPTION-1 TO Q-DESCRIPTION.
           MOVE CRAFTS-REQD-1 TO Q-SKILL-1.
           MOVE CRAFTS-REQD-2 TO Q-SKILL-2.
           MOVE CRAFTS-REQD-3 TO Q-SKILL-3.
           IF PRIORITY = "1 " MOVE 9 TO QUEUE-PRTY.
           IF PRIORITY = "2 " MOVE 6 TO QUEUE-PRTY.
           IF PRIORITY = "3 " MOVE 4 TO QUEUE-PRTY.
           IF PRIORITY = "4 " MOVE 2 TO QUEUE-PRTY.
           IF PRIORITY = "5 " MOVE 1 TO QUEUE-PRTY.
           COMPUTE QUEUE-FACTOR = RIME-NO * QUEUE-PRTY.
           IF H-CC-NUM NOT = "9999"
               MOVE H-CC-NUM TO Q-CC-NUM.
           IF PRIORITY = PRTY-HOLD AND EQUIP-NUM = EQUIP-HOLD
               MOVE H-FACTOR TO QUEUE-FACTOR.
           MOVE "A" TO QUEUE-SW.
           CALL "TQUPDATE" USING DBPARAMETERS WO-QUEUE-DATA
                             QUEUE-SW ERROR-76.
           IF ERROR-76 NOT = SPACES
               MOVE ERROR-76 TO ERROR-BUFFER.

       6411-UO-EXIT.    EXIT.

       64-UOM-PLANNED.
           MOVE WO-NUM-PLANNED TO WONUM OF WPFREC.
           PERFORM 68-START-WO-PLANNED-FILE.
           IF COND-WORD = 17
               MOVE "  MMISA" TO BLOWUP-BASE
               MOVE "START PLANNED W/O FOR UPDATE FAILED * TMODWORK *"
                   TO BU-DISPLAY-MSG
               MOVE "WO-PLANNED"   TO BU-DISPLAY-FLD (2)
               MOVE WO-NUM-PLANNED TO BU-DISPLAY-FLD (3)
               PERFORM 998-BLOWUP.

           PERFORM 68-READ-WO-PLANNED-FILE.
           MOVE WO-PLANNED-DATA3 TO WO-PLANNED-DATA.
           IF COND-WORD = 15
               MOVE "  MMISA" TO BLOWUP-BASE
               MOVE "READ PLANNED W/O FOR UPDATE FAILED * TMODWORK *"
                   TO BU-DISPLAY-MSG
               MOVE "WO-PLANNED"   TO BU-DISPLAY-FLD (2)
               MOVE WO-NUM-PLANNED TO BU-DISPLAY-FLD (3)
               PERFORM 998-BLOWUP.

           MOVE WO-STATUS-P TO SAVE-WO-STATUS.
           MOVE EDIT-WO-STAT TO WO-STATUS-P.
           IF EDIT-DATE-RECD = "      "
               MOVE SPACES TO DATE-RECD-P-CN
           ELSE
           MOVE 3 TO DATE-MODE
           MOVE EDIT-DATE-RECD TO DATE-VALIDATE-IN
           CALL "TDATECHK" USING DATE-CHECK-AREA
           MOVE DATE-DB TO DATE-RECD-P
           IF DATE-RECD-P-YY > "70"
               MOVE "19" TO DATE-RECD-P-CC
           ELSE
           MOVE "20" TO DATE-RECD-P-CC.

           IF WO-NUM-PLANNED = SPACES
               MOVE WO-NUMBER-BUF TO WO-NUM-PLANNED.
           MOVE EDIT-TIME-RECD TO TIME-RECD-P.
           MOVE EDIT-REQUESTER TO REQUESTER-P.
           MOVE EDIT-EQUIP-NUM TO EQUIP-NUM-P.
           MOVE EDIT-EQUIP-NAME TO EQUIP-NAME-P.
           MOVE EDIT-TYPE-NUM TO TYPE-NUM-P.
           MOVE EDIT-DEPT TO DEPT-P.
           MOVE EDIT-ZONE TO ZONE-P.
           MOVE EDIT-LOCATION TO LOCATION-P.
           MOVE EDIT-PRIORITY TO PRIORITY-P.
           MOVE EDIT-EQUIP-DOWN TO EQUIP-DOWN-P.
           MOVE EDIT-EXPCLASS TO EXP-CLASS-P.
           MOVE WO-RIME-P TO RIME-P.
           MOVE WO-DESC-1-P TO DESCRIPTION-1-P.
           MOVE WO-DESC-2-P TO DESCRIPTION-2-1-P.
           MOVE WO-DESC-3-P TO DESCRIPTION-2-2-P.
           MOVE WO-DESC-4-P TO DESCRIPTION-3-1-P.
           MOVE WO-DESC-5-P TO DESCRIPTION-3-2-P.
           MOVE WO-SPECL-INSTR-1-P TO SPECL-INSTR-1.
           MOVE WO-SPECL-INSTR-2-P TO SPECL-INSTR-2.
           MOVE WO-SPECL-EQUIP-P TO SPECL-EQUIP.
           MOVE WO-SFTYNOTE-P TO SAFETY-NOTE.
           IF WO-DATE-REQD-P = "      "
               MOVE SPACES TO DATE-REQD-CN
           ELSE
           MOVE 3 TO DATE-MODE
           MOVE WO-DATE-REQD-P TO DATE-VALIDATE-IN
           CALL "TDATECHK" USING DATE-CHECK-AREA
           MOVE DATE-DB TO DATE-REQD
           IF DATE-REQD-P-YY > "70"
               MOVE "19" TO DATE-REQD-P-CC
           ELSE
           MOVE "20" TO DATE-REQD-P-CC.

           MOVE WO-TIME-REQD-P TO TIME-REQD.
           MOVE WO-ENGINEER-P TO ENGINEER-P.
           MOVE WO-PLANNER-P TO PLANNER-P
           MOVE WO-SCHEDULER-P TO SCHEDULER-P.
           IF EDIT-WO-CURRENT-TYPE = "E"
               IF ENGR-RESP-IND = "R "
                   NEXT SENTENCE
               ELSE
               MOVE "R " TO ENGR-RESP-IND
               MOVE "  " TO PLNR-RESP-IND SCHD-RESP-IND
           ELSE
           IF EDIT-WO-CURRENT-TYPE = "P"
               IF PLNR-RESP-IND = "R "
                   NEXT SENTENCE
               ELSE
               MOVE "R " TO PLNR-RESP-IND
               MOVE "  " TO ENGR-RESP-IND SCHD-RESP-IND
           ELSE
           IF WO-STATUS-P = "SD" OR "PR"
               MOVE "R " TO SCHD-RESP-IND
               MOVE "  " TO PLNR-RESP-IND ENGR-RESP-IND.

           IF WO-DATE-SCHD-P = "      "
               MOVE SPACES TO DATE-SCHD-CN
           ELSE
           MOVE 3 TO DATE-MODE
           MOVE WO-DATE-SCHD-P TO DATE-VALIDATE-IN
           CALL "TDATECHK" USING DATE-CHECK-AREA
           MOVE DATE-DB TO DATE-SCHD
           IF DATE-SCHD-P-YY > "70"
               MOVE "19" TO DATE-SCHD-P-CC
           ELSE
           MOVE "20" TO DATE-SCHD-P-CC.

           MOVE WO-TIME-SCHD-P TO TIME-SCHD.
           IF APPROVAL-CODE-P = "U" AND EDIT-APPROVAL-CODE = "A"
               MOVE 0 TO WS-SW REQS-CUT-SW
               PERFORM 6421-KICK-REQS-LOOSE THRU 6421-KRL-EXIT
               IF REQS-CUT-SW = 0
                   NEXT SENTENCE
               ELSE
               IF WO-STATUS-P = "OO" OR "HA"
                   MOVE "HM" TO WO-STATUS-P.

           MOVE EDIT-APPROVAL-CODE TO APPROVAL-CODE-P.
           MOVE WO-BGT-NO-P-1-3 TO BUDGET-NO-1-3.
           MOVE WO-BGT-NO-P-4-5 TO BUDGET-NO-4-5.
           MOVE WO-BGT-NO-P-6-7 TO BUDGET-NO-6-7.
           MOVE WO-BGT-NO-P-8-10 TO BUDGET-NO-8-10.
           MOVE "-" TO BUDGET-NO-DASH-1 BUDGET-NO-DASH-2
               BUDGET-NO-DASH-3.
           MOVE "R" TO BUDGET-NO-REV.
           MOVE WO-BGT-NO-REVNO TO BUDGET-NO-REVNO.
           MOVE WO-REQ-NO-P TO REQUEST-NO.
           IF EDIT-DATE-STRT = "      "
               MOVE SPACES TO DATE-STRT-P-CN
           ELSE
           MOVE 3 TO DATE-MODE
           MOVE EDIT-DATE-STRT TO DATE-VALIDATE-IN
           CALL "TDATECHK" USING DATE-CHECK-AREA
           MOVE DATE-DB TO DATE-STRT-P
           IF DATE-STRT-P-YY > "70"
               MOVE "19" TO DATE-STRT-P-CC
           ELSE
           MOVE "20" TO DATE-STRT-P-CC.

           MOVE EDIT-TIME-STRT TO TIME-STRT-P.
           MOVE WO-FAILURE-P TO FAILURE-CODE-P.
           MOVE JOBPLAN-NAME TO PM-JOBPLAN-KEY.
           MOVE MASTER-SCHED-NAME TO PM-SCHEDULE-KEY.
           IF EDIT-DATE-COMP = "      "
               MOVE SPACES TO DATE-COMP-P-CN
           ELSE
           MOVE 3 TO DATE-MODE
           MOVE EDIT-DATE-COMP TO DATE-VALIDATE-IN
           CALL "TDATECHK" USING DATE-CHECK-AREA
           MOVE DATE-DB TO DATE-COMP-P
           IF DATE-COMP-P-YY > "70"
               MOVE "19" TO DATE-COMP-P-CC
           ELSE
           MOVE "20" TO DATE-COMP-P-CC.

           MOVE EDIT-TIME-COMP TO TIME-COMP-P.
           MOVE EDIT-WO-CURRENT-TYPE TO WO-CURRENT-TYPE.
           PERFORM 68-DELETE-WO-PLANNED-FILE.
           IF COND-WORD = 17
               MOVE "  MMISA" TO BLOWUP-BASE
               MOVE "DELETE OF PLANNED W/O FAILED * TMODWORK *"
                   TO BU-DISPLAY-MSG
               MOVE "WO-PLANNED"   TO BU-DISPLAY-FLD (2)
               MOVE WO-NUM-PLANNED TO BU-DISPLAY-FLD (3)
               PERFORM 998-BLOWUP.

           PERFORM 68-WRITE-WO-PLANNED-FILE.
           IF COND-WORD = 17
               MOVE "  MMISA" TO BLOWUP-BASE
               MOVE "PUT OF PLANNED WO FAILED * TMODWORK *"
                   TO BU-DISPLAY-MSG
               MOVE "WO-PLANNED"   TO BU-DISPLAY-FLD (2)
               MOVE WO-NUM-PLANNED TO BU-DISPLAY-FLD (3)
               PERFORM 998-BLOWUP.

      *-WRITE TO THE PM QUEUE IF "PR" CHANGED TO "IP",UPDATE SCHED DATE
           IF SAVE-WO-STATUS = "PR" AND WO-STATUS-P = "IP"
      *------RELEASE TO QUEUE AND REMOVE FROM PM-SCHEDULE.
               MOVE "IP" TO PM-UPDATE-CODE
               MOVE DATE-SCHD TO PM-UPDATE-DATE
               MOVE 0 TO PM-RETURN-CODE
               MOVE SPACES TO PM-RETURN-ERROR
               CALL "SPMCWSD" USING WO-NUM-PLANNED PM-UPDATE-CODE
                            PM-UPDATE-DATE DBPARAMETERS
                            PM-RETURN-CODE PM-RETURN-ERROR
           END-IF.

      *************************************************************************
      *    CODED ADDED 5-8-87 TO UPGRADE EITHER BUDGET NUMBER AND/OR EXPENSE  *
      *    CLASS ON ALL REQUISITIONS FOR THE W/O IF IT HAS CHANGED            *
      *************************************************************************
           MOVE 0 TO UPLOAD-SW.
           IF WO-BGT-NO-P = SPACES
               IF SAVE-EXPCLASS = SPACES
                   NEXT SENTENCE
               ELSE
               IF SAVE-EXPCLASS = EDIT-EXPCLASS
                   NEXT SENTENCE
               ELSE
               MOVE 1 TO UPLOAD-SW
               PERFORM 644-UPDATE-REQ-INFO THRU 644-URI-EXIT
           ELSE
           IF WO-BGT-NO-P = BUDGET-WA
               IF SAVE-EXPCLASS = SPACES
                   NEXT SENTENCE
               ELSE
               IF SAVE-EXPCLASS = EDIT-EXPCLASS
                   NEXT SENTENCE
               ELSE
               MOVE 1 TO UPLOAD-SW
               PERFORM 644-UPDATE-REQ-INFO THRU 644-URI-EXIT
           ELSE
           IF SAVE-EXPCLASS = SPACES
               MOVE 2 TO UPLOAD-SW
               PERFORM 644-UPDATE-REQ-INFO THRU 644-URI-EXIT
           ELSE
           IF SAVE-EXPCLASS = EDIT-EXPCLASS
               MOVE 2 TO UPLOAD-SW
               PERFORM 644-UPDATE-REQ-INFO THRU 644-URI-EXIT
           ELSE
           MOVE 3 TO UPLOAD-SW
           PERFORM 644-UPDATE-REQ-INFO THRU 644-URI-EXIT.

           MOVE 42075 TO CATREAD-MSG-NUMBER.
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
           MOVE ERROR-BUFFER TO P-COMP-LIT.
           MOVE WO-NUMBER-BUF TO WO-COMP-LIT.
           MOVE P-COMP-LIT TO MESSAGE-LINE-P.
           MOVE BUFFER TO DSPLY-REC.
           MOVE TRUE-VAL TO INDS (98).
           PERFORM 99-SCREEN-WRITE.
           PERFORM 98A-SCREEN-READ.
           CALL "CLPAUSE2".
           MOVE SPACES TO WO-TRACK-DATA.
           MOVE USERNAME TO USER-NAME.
           MOVE TERMNUM TO USER-TERM.
           MOVE WO-NUM-PLANNED TO WO-NUM-TRACK.
           MOVE T-BUF-CC TO DATE-STAMP-CC.
           MOVE T-BUF-YY TO DATE-STAMP-YY.
           MOVE T-BUF-MM TO DATE-STAMP-MM.
           MOVE T-BUF-DD TO DATE-STAMP-DD.
           ACCEPT TIME-BUFFER FROM TIME.
           MOVE TIME-BUFF TO TIME-STAMP.
           MOVE WO-START-STATUS TO WO-TYPE-STATUS.
           MOVE USERNAME TO USER-ID.
           MOVE "    " TO CLOCK-CARD.
      *    IF M-SWITCH = "O"
      *        MOVE CC-BUFFER TO CLOCK-CARD.
           MOVE ENG-PL-SCHD-ID TO CLOCK-CARD.
           MOVE WO-STATUS-P TO WO-STATUS-TRACK.

           IF TE-SW = 1
               MOVE 0 TO TE-SW
               MOVE "HE" TO TRANS-STATUS.

           IF TP-SW = 1
               MOVE 0 TO TP-SW
               MOVE "HP" TO TRANS-STATUS.

           MOVE "TMODWORK" TO PROGRAM-NAME.
           CALL "TWOTRACK" USING WO-TRACK-DATA.
      *    IF WO-STATUS-P = "VO"
      *        CALL "TPRINTWS" USING DBPARAMETERS WO-PLANNED-DATA
      *                          ERROR-SWITCH VIEW-COMAREA.

       64-UOM-EXIT.  EXIT.

       644-UPDATE-REQ-INFO.
           PERFORM 68-START-WO-PARTS-FILE.
           IF COND-WORD = 17 GO TO 644-URI-EXIT.

       644-URI-CONT.
           PERFORM 68-READ-WO-PARTS-FILE.
           IF COND-WORD = 15 GO TO 644-URI-EXIT.
           IF PRT-REQ-NO = "      " OR "CANCEL" GO TO 644-URI-CONT.

           MOVE "IN" TO CMR-CALL-MODE.
           MOVE SPACES TO CMR-DATA CMR-RETURNED-DATA CMR-DESC
               CMR-REMARKS CMR-MISC-PARMS.
           MOVE PRT-REQ-NO TO CMR-REQ-NUMBER.
           MOVE PRT-WO-NU  TO CMR-WO-NUMBER.
           CALL "CMANINQ" USING PASSED-BASE
                                CMR-CALL-MODE
                                CMR-DATA
                                CMR-DESC
                                CMR-REMARKS
                                CMR-RETURNED-DATA
                                CMR-MISC-PARMS
                                LANGUAGE-PARMS
                                ESC-NAME
                                STATUS-AREA
                                BU-DISPLAY-MSG.
           IF CMR-RETURN-STATUS NOT = "OK" GO TO 644-URI-CONT.

           IF UPLOAD-SW = 1
               MOVE EDIT-EXPCLASS TO CMR-EXPENSE-CLASS
           ELSE
           IF UPLOAD-SW = 2
               MOVE SPACES           TO CMR-BUDGET-NUMBER
               MOVE WO-BGT-NO-P-1-3  TO CMR-BUDGET1
               MOVE WO-BGT-NO-P-4-5  TO CMR-BUDGET2
               MOVE WO-BGT-NO-P-6-7  TO CMR-BUDGET3
               MOVE WO-BGT-NO-P-8-10 TO CMR-BUDGET4
               MOVE "-"              TO CMR-BUDGET-DASH1,
                                        CMR-BUDGET-DASH2,
                                        CMR-BUDGET-DASH3
               MOVE "R"              TO CMR-BUDGET-SPACE
               MOVE WO-BGT-NO-REVNO  TO CMR-BUDGET5
           ELSE
           IF UPLOAD-SW = 3
               MOVE EDIT-EXPCLASS    TO CMR-EXPENSE-CLASS
               MOVE SPACES           TO CMR-BUDGET-NUMBER
               MOVE WO-BGT-NO-P-1-3  TO CMR-BUDGET1
               MOVE WO-BGT-NO-P-4-5  TO CMR-BUDGET2
               MOVE WO-BGT-NO-P-6-7  TO CMR-BUDGET3
               MOVE WO-BGT-NO-P-8-10 TO CMR-BUDGET4
               MOVE "-" TO CMR-BUDGET-DASH1 CMR-BUDGET-DASH2
                   CMR-BUDGET-DASH3
               MOVE "R"              TO CMR-BUDGET-SPACE
               MOVE WO-BGT-NO-REVNO  TO CMR-BUDGET5.

           MOVE "UP" TO CMR-CALL-MODE.
           MOVE 0    TO CMR-SPOOL-PRT.
           CALL "CMANREQ" USING PASSED-BASE
                                BASE-MMISA
                                BASE-BG
                                BASE-DUMMY
                                ERROR-76
                                CMR-CALL-MODE
                                CMR-DATA
                                CMR-DESC
                                CMR-REMARKS
                                CMR-RETURNED-DATA
                                CMR-MISC-PARMS
                                REQ-GLOBALS
                                LANGUAGE-PARMS
                                ESC-NAME
                                VIEW-COMAREA.

           GO TO 644-URI-CONT.

       644-URI-EXIT.    EXIT.

       6421-KICK-REQS-LOOSE.
           IF JCW-AREQJCW-259 = "1"
               NEXT SENTENCE
           ELSE
           GO TO 6421-KRL-EXIT.
           MOVE 0 TO PRT-SEQ.
           PERFORM 68-START-WO-PARTS-FILE.
           IF COND-WORD = 17 GO TO 6421-KRL-EXIT.

       6421-KRL-CONT.
           PERFORM 68-READ-WO-PARTS-FILE.
           IF COND-WORD = 15 GO TO 6421-KRL-EXIT.
           ADD 1 TO PRT-SEQ.
           IF PRT-STATUS-1 NOT = "M" GO TO 6421-KRL-CONT.
           IF PRT-REQ-NO NOT = "      "
               PERFORM 64211-CALL-CEAWOAP
               GO TO 6421-KRL-CONT.
           IF PRT-PO-NO NOT = "          " GO TO 6421-KRL-CONT.

      **************************************************************
      *    THE FOLLOWING CALL TO TPRINTWS WAS ADDED 5-12-86        *
      *    TO PRINT THE WORKSHEET THEN RESET THE DBCB ON WO-PARTS  *
      *    AND ASSIGN THE REQUISITIONS THROUGH CSIS WHEN THE       *
      *    WORK ORDER IS APPROVED                                  *
      **************************************************************
           IF WS-SW > 0
               NEXT SENTENCE
           ELSE
           IF PRINT-WO-REQPK = "Y"
               CALL "TPRINTWS" USING DBPARAMETERS WO-PLANNED-DATA
                                 ERROR-SWITCH VIEW-COMAREA
               MOVE 1 TO WS-SW
               GO TO 6421-KICK-REQS-LOOSE.

           ACCEPT IOFEEDBACK FROM I-O-FEEDBACK-AREA.
           MOVE IO-REL-NO TO PFKEY.
           MOVE 0 TO COND-WORD.
           MOVE START-PARTS-KEY TO WONUM OF WPFDREC.
           START WO-PARTS-FILE KEY IS > EXTERNALLY-DESCRIBED-KEY
               INVALID KEY     MOVE 17 TO COND-WORD.
           MOVE SPACES TO CMR-DATA CMR-DESC CMR-REMARKS
               CMR-RETURNED-DATA CMR-MISC-PARMS.

           PERFORM 64210-PRINT-REQS THRU 64210-PR-EXIT.
           IF RETURN-CODE-B NOT = 0
               MOVE 49061 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE ERROR-BUFFER TO EDIT-ERROR
               MOVE 0 TO RETURN-CODE-B
               MOVE SPACES TO ERROR-BUFFER RETURN-ERROR-B
               GO TO 6421-KRL-CONT.

           READ WO-PARTS-FILE-PF INTO WO-PARTS-DATA
               INVALID KEY    MOVE 15 TO COND-WORD.
           IF WPFDP-STATUS NOT = "00" MOVE 15 TO COND-WORD.
           IF COND-WORD = 15
               MOVE "  MMISA" TO BLOWUP-BASE
               MOVE "PHYS. READ/WO-PARTS FAILED * TAPPRVWO *"
                   TO BU-DISPLAY-MSG
               PERFORM 998-BLOWUP.

           MOVE CMR-REQ-NUMBER TO PRT-REQ-NO.
           MOVE CMR-QTY TO PRT-ACT-QTY-9.
           MOVE PRT-SEQ TO PRT-ITEM-NO.
           MOVE 0 TO COND-WORD.

           REWRITE WPFDPREC FROM WO-PARTS-DATA
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF WPFDP-STATUS NOT = "00" MOVE 17 TO COND-WORD.
           IF COND-WORD = 17
               MOVE "  MMISA" TO BLOWUP-BASE
               MOVE "WO-PARTS UPDATE FAILED * TMODWORK *"
                   TO BU-DISPLAY-MSG
               MOVE "WO-PARTS"     TO BU-DISPLAY-FLD (1)
               MOVE PRT-REQ-NO     TO BU-DISPLAY-FLD (2)
               PERFORM 998-BLOWUP.

           PERFORM 64211-CALL-CEAWOAP.
           GO TO 6421-KICK-REQS-LOOSE.

       6421-KRL-EXIT.    EXIT.

       64210-PRINT-REQS.
           MOVE "CR" TO CMR-CALL-MODE.
           MOVE PRT-WO-NU TO CMR-WO-NUMBER.
           MOVE PRT-SEQ TO CMR-WO-ITEM-NUMBER.
           MOVE PRT-NUM-7 TO CMR-CORP-CODE.
           MOVE DEPT-P TO CMR-FOR-DEPT.
           MOVE PRT-DATE-USED-CN TO CMR-DATE-REQUIRED-CN.
           MOVE PRT-STAGE TO CMR-STAGING-AREA.

           IF PRT-EST-QTY = SPACES
               IF PRT-ACT-QTY = SPACES
                   MOVE 0 TO PRT-EST-QTY-9 CMR-QTY
               ELSE
               MOVE PRT-ACT-QTY-9 TO PRT-EST-QTY-9 CMR-QTY
           ELSE
           MOVE PRT-EST-QTY-9 TO CMR-QTY PRT-ACT-QTY-9.

           MOVE PRT-UNIT-MEAS TO CMR-UM.
           MOVE BUDGET-NO TO CMR-BUDGET-NUMBER.
           MOVE SPACES TO CMR-DESC.
           MOVE SPACES TO CMR-MISC-PARMS.
           MOVE SPACES TO CMR-RETURNED-DATA.
           MOVE 0 TO CMR-SPOOL-PRT.
           MOVE P-UNIT-COST TO CMR-EST-UNIT-PRICE.
           MOVE PRT-DESC TO CMR-DESC-LINE (1).
           MOVE PRT-DESC-2 TO CMR-DESC-LINE (2).
           MOVE PRT-DESC-3 TO CMR-DESC-LINE (3).
           MOVE PRT-DESC-4 TO CMR-DESC-LINE (4).
           MOVE PRT-DESC-5 TO CMR-DESC-LINE (5).
           MOVE PRT-REMARKS   TO CMR-REMARK-1.
           MOVE PRT-REMARKS-2 TO CMR-REMARK-2.
           MOVE PRT-ADDL-INFO TO CMR-ADDTL-INFO.
           MOVE PRT-SUGG-VENDOR TO CMR-SUGGESTED-VENDOR.
           MOVE PRT-SEQ TO CMR-WO-ITEM-NUMBER.
           MOVE PRT-SUB-1-3 TO CMR-SUB.
           MOVE PRT-ORIGINATOR TO CMR-REQ-ORIG.
           MOVE EXP-CLASS-P TO CMR-EXPENSE-CLASS.

      *    OLD LOGIC UNLOCKED MMIS RECORD HERE                         .
           CALL "CMANREQ" USING PASSED-BASE
                                BASE-MMISA
                                BASE-BG
                                BASE-DUMMY
                                ERROR-76
                                CMR-CALL-MODE
                                CMR-DATA
                                CMR-DESC
                                CMR-REMARKS
                                CMR-RETURNED-DATA
                                CMR-MISC-PARMS
                                REQ-GLOBALS
                                LANGUAGE-PARMS
                                ESC-NAME
                                VIEW-COMAREA.

           IF CMR-RETURN-STATUS = "OK"
               MOVE 44110 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE ERROR-BUFFER TO REQ-ISSUED-MSG
               MOVE CMR-WO-NUMBER TO REQU-WO
               MOVE CMR-REQ-NUMBER TO REQ-ISS
               MOVE REQ-ISSUED-MSG TO MESSAGE-LINE-P
               MOVE BUFFER TO DSPLY-REC
               MOVE TRUE-VAL TO INDS (98)
               PERFORM 99-SCREEN-WRITE
               PERFORM 98A-SCREEN-READ
               CALL "CLPAUSE2"
      *        LOCK MMIS RECORD AGAIN HAPPENED HERE
           ELSE
           IF CMR-RETURN-STATUS = "RE"
               MOVE 44025 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE ERROR-BUFFER TO MESSAGE-LINE-P
               MOVE TRUE-VAL TO INDS (98)
               MOVE BUFFER TO DSPLY-REC
               PERFORM 99-SCREEN-WRITE
               PERFORM 98A-SCREEN-READ
               CALL "CLPAUSE2"
           ELSE
           IF CMR-RETURN-STATUS = "DE"
               MOVE "CSIS FILE ERROR - PLEASE CONTACT STAFF"
                       TO ERROR-BUFFER
               MOVE ERROR-BUFFER TO MESSAGE-LINE-P
               MOVE TRUE-VAL TO INDS (98)
               MOVE BUFFER TO DSPLY-REC
               PERFORM 99-SCREEN-WRITE
               PERFORM 98A-SCREEN-READ
               CALL "CLPAUSE2"
           ELSE
           IF CMR-RETURN-STATUS = "BB"
             MOVE 28021 TO CATREAD-MSG-NUMBER
             PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
             MOVE ERROR-BUFFER TO MESSAGE-LINE-P
             MOVE TRUE-VAL TO INDS (98)
             MOVE BUFFER TO DSPLY-REC
             PERFORM 99-SCREEN-WRITE
             PERFORM 98A-SCREEN-READ
             CALL "CLPAUSE2"
           ELSE
           MOVE 45048 TO CATREAD-MSG-NUMBER
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
           MOVE ERROR-BUFFER TO MESSAGE-LINE-P
           MOVE TRUE-VAL TO INDS (98)
           MOVE BUFFER TO DSPLY-REC
           PERFORM 99-SCREEN-WRITE
           PERFORM 98A-SCREEN-READ
           CALL "CLPAUSE2".

       64210-PR-EXIT.    EXIT.

       64211-CALL-CEAWOAP.
      *    UNLOCK OF MMIS OCCURRED HERE
           MOVE PRT-REQ-NO TO EAWOAP-REQ-NUMBER.
           MOVE SPACES TO EAWOAP-RET-CODE.
           MOVE SPACES TO BU-DISPLAY-MSG BU-DISPLAY-FLDS.
           MOVE 0 TO PASSED-SPOOL-PRT.
           CALL "CEAWOAP" USING PASSED-BASE
                                BASE-MMISA
                                BASE-BG
                                STATUS-AREA
                                REQ-GLOBALS
                                PASSED-SPOOL-PRT
                                PASS-COMP
                                EAWOAP-PARMS
                                ESC-NAME
                                VIEW-COMAREA
                                LANGUAGE-PARMS
                                BU-DISPLAY-MSG
                                BU-DISPLAY-FLDS.

      *    RE-LOCK OF MMIS SETS OCCURRED HERE

       65-PASS-PM-DATA.
           IF WO-START-STATUS = "AA" OR "AR"
               NEXT SENTENCE
           ELSE
           GO TO 65-PPD-EXIT.
           IF EDIT-WO-STAT = "SD" OR "CW"
               NEXT SENTENCE
           ELSE
           GO TO 65-PPD-EXIT.

           MOVE EDIT-WO-STAT TO PM-UPDATE-CODE.
           MOVE WO-NUMBER-BUF TO PM-WO-NUMBER.
           IF EDIT-WO-STAT = "CW"
               MOVE DATE-COMP-P TO PM-UPDATE-DATE
           ELSE
           MOVE DATE-SCHD TO PM-UPDATE-DATE.

           MOVE 0 TO PM-RETURN-CODE.
           MOVE SPACES TO PM-RETURN-ERROR.
           CALL "SPMCWSD" USING PM-WO-NUMBER PM-UPDATE-CODE
                            PM-UPDATE-DATE DBPARAMETERS
                            PM-RETURN-CODE PM-RETURN-ERROR.

       65-PPD-EXIT.    EXIT.

       68-READ-EQUIP-FILE.
           MOVE 0 TO COND-WORD.
           READ EQUIP-FILE NEXT INTO EQP-EQUIPMENT
               AT END    MOVE 15 TO COND-WORD.
           IF EF-STATUS NOT = "00" MOVE 15 TO COND-WORD.

       68-START-EQUIP-FILE.
           MOVE 0 TO COND-WORD.
           MOVE EDIT-EQUIP-NUM TO EQPNUM OF EFREC.
           START EQUIP-FILE KEY IS = EXTERNALLY-DESCRIBED-KEY
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF EF-STATUS NOT = "00" MOVE 17 TO COND-WORD.

       68-READ-MPLTINFO-FILE.
           MOVE 0 TO COND-WORD.
           READ MPLTINFO-FILE INTO BUF-MPLTINFO
               INVALID KEY MOVE 15 TO COND-WORD.
           IF MF-STATUS NOT = "00" MOVE 15 TO COND-WORD.

       68-START-MPLTINFO-FILE.
           MOVE 0 TO COND-WORD.
           MOVE "RQGB" TO PLTINFOKEY OF MFREC.
           START MPLTINFO-FILE KEY IS = EXTERNALLY-DESCRIBED-KEY
               INVALID KEY     MOVE 17 TO COND-WORD.
           IF MF-STATUS NOT = "00" MOVE 17 TO COND-WORD.

       68-START-MVALIDPLTDATA-REC.
           MOVE 0 TO COND-WORD.
           MOVE ARG-DEFN TO VALDTAKEY OF MVPFREC.
           START MVALIDPLTDATA-FILE KEY IS = EXTERNALLY-DESCRIBED-KEY
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF MVPD-STATUS NOT = "00" MOVE 17 TO COND-WORD.

       68-DELETE-WO-BASIC-FILE.
           MOVE 0 TO COND-WORD.
           DELETE WO-BASIC-FILE RECORD
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF WBF-STATUS NOT = "00" MOVE 17 TO COND-WORD.

       68-READ-WO-BASIC-FILE.
           MOVE 0 TO COND-WORD.
           READ WO-BASIC-FILE INTO WO-BASIC-DATA
               INVALID KEY    MOVE 15 TO COND-WORD.
           IF WBF-STATUS NOT = "00" MOVE 15 TO COND-WORD.

       68-START-WO-BASIC-FILE.
           MOVE 0 TO COND-WORD.
           MOVE WO-NUMBER-BUF TO WONUM OF WBFREC.
           START WO-BASIC-FILE KEY IS = EXTERNALLY-DESCRIBED-KEY
               INVALID KEY MOVE 17 TO COND-WORD.
           IF WBF-STATUS NOT = "00" MOVE 17 TO COND-WORD.

       68-WRITE-WO-BASIC-FILE.
           MOVE 0 TO COND-WORD.
           WRITE WBFREC FROM WO-BASIC-DATA
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF WBF-STATUS NOT = "00" MOVE 17 TO COND-WORD.

       68-START-WO-CRAFTS-FILE.
           MOVE 0 TO COND-WORD.
           START WO-CRAFTS-REQD-FILE KEY IS = EXTERNALLY-DESCRIBED-KEY
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF WCRF-STATUS NOT = "00" MOVE 17 TO COND-WORD.

       68-READ-WO-OPEN-QUEUE-FILE.
           MOVE 0 TO COND-WORD.
           READ WO-OPEN-QUEUE-FILE INTO WO-QUEUE-DATA
               INVALID KEY    MOVE 15 TO COND-WORD.
           IF WO-NUMBER-BUF NOT = WONUM OF WOQFREC
               MOVE 15 TO COND-WORD.
           IF WOQF-STATUS NOT = "00" MOVE 15 TO COND-WORD.

       68-START-WO-OPEN-QUEUE-FILE.
           MOVE 0 TO COND-WORD.
           MOVE WO-NUMBER-BUF TO WONUM OF WOQFREC.
           START WO-OPEN-QUEUE-FILE KEY IS = EXTERNALLY-DESCRIBED-KEY
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF WOQF-STATUS NOT = "00" MOVE 17 TO COND-WORD.

       68-READ-WO-PARTS-FILE.
           MOVE 0 TO COND-WORD.
           READ WO-PARTS-FILE NEXT INTO WO-PARTS-DATA
               AT END     MOVE 15 TO COND-WORD.
           IF WO-NUMBER-BUF NOT = PRT-WO-NU
               MOVE 15 TO COND-WORD.
           IF WPFD-STATUS NOT = "00" MOVE 15 TO COND-WORD.

       68-START-WO-PARTS-FILE.
           MOVE 0 TO COND-WORD.
           MOVE WO-NUMBER-BUF TO WONUM OF WPFDREC.
           START WO-PARTS-FILE KEY IS = EXTERNALLY-DESCRIBED-KEY
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF WPFD-STATUS NOT = "00" MOVE 17 TO COND-WORD.

       68-DELETE-WO-PLANNED-FILE.
           MOVE 0 TO COND-WORD.
           DELETE WO-PLANNED-FILE RECORD
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF WPF-STATUS NOT = "00" MOVE 17 TO COND-WORD.

       68-READ-WO-PLANNED-FILE.
           MOVE 0 TO COND-WORD.
           READ WO-PLANNED-FILE INTO WO-PLANNED-DATA3
               INVALID KEY     MOVE 15 TO COND-WORD.
           IF WPF-STATUS NOT = "00" MOVE 15 TO COND-WORD.

       68-REWRITE-WO-PLANNED-FILE.
           MOVE 0 TO COND-WORD.
           REWRITE WPFREC FROM WO-PLANNED-DATA
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF WPF-STATUS NOT = "00" MOVE 17 TO COND-WORD.

       68-START-WO-PLANNED-FILE.
           MOVE 0 TO COND-WORD.
           START WO-PLANNED-FILE KEY IS = EXTERNALLY-DESCRIBED-KEY
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF WPF-STATUS NOT = "00" MOVE 17 TO COND-WORD.

       68-WRITE-WO-PLANNED-FILE.
           MOVE 0 TO COND-WORD.
           WRITE WPFREC FROM WO-PLANNED-DATA
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF WPF-STATUS NOT = "00" MOVE 17 TO COND-WORD.

       68-START-WO-STATUS-MSTR.
           MOVE 0 TO COND-WORD.
           MOVE EDIT-WO-STAT TO WOSTATUS OF WSMFREC.
           START WO-STATUS-MSTR-FILE KEY IS = EXTERNALLY-DESCRIBED-KEY
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF WSMF-STATUS NOT = "00" MOVE 17 TO COND-WORD.

       68-START-WO-ZONE-PRTY.
           MOVE 0 TO COND-WORD.
           MOVE SPACES TO ARG-NO.
           MOVE EDIT-ZONE TO ARG-NO-1-4.
           MOVE EDIT-PRIORITY TO ARG-NO-5.
           MOVE ARG-NO TO ZONEPRTY OF WZPFREC.
           START WO-ZONE-PRTY-FILE KEY IS = EXTERNALLY-DESCRIBED-KEY
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF WZPF-STATUS NOT = "00" MOVE 17 TO COND-WORD.

       69-READ-SCREEN.
           MOVE SPACES TO EDIT-WORK-AREA.
           IF PLANNED-SW = 0
               MOVE "FMODBASC" TO VIEW-CFNAME
               MOVE 31043 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE ERROR-BUFFER TO MESSAGE-LINE-B
               MOVE EDIT-ERROR TO ERRLINEB
               MOVE WO-BASIC-BUF TO DSPLY-REC
               PERFORM 99-SCREEN-WRITE
               PERFORM 98-SCREEN-READ
               MOVE WO-STAT TO WO-STAT-TEMP
               MOVE DSPLY-REC TO WO-BASIC-BUF
           ELSE
           IF WO-START-STATUS = "AA" OR "AR"
               MOVE "FMODPLA3" TO VIEW-CFNAME
               MOVE 31043 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE ERROR-BUFFER TO MESSAGE-LINE-P
               MOVE EDIT-ERROR TO ERRLINE-P
               MOVE WO-STAT-P TO WO-STAT-TEMP
               MOVE WO-PLANNED-BUF TO DSPLY-REC
               PERFORM 99-SCREEN-WRITE
               PERFORM 98-SCREEN-READ
               MOVE DSPLY-REC TO WO-PLANNED-BUF
           ELSE
           IF EXP-CLASS-P > "00009999"
               MOVE "FMODPLA2" TO VIEW-CFNAME
               MOVE 31043 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE ERROR-BUFFER TO MESSAGE-LINE-P
               MOVE EDIT-ERROR TO ERRLINE-P
               MOVE WO-STAT-P TO WO-STAT-TEMP
               MOVE WO-PLANNED-BUF TO DSPLY-REC
               PERFORM 99-SCREEN-WRITE
               PERFORM 98-SCREEN-READ
               MOVE DSPLY-REC TO WO-PLANNED-BUF
           ELSE
           MOVE "FMODPLAN" TO VIEW-CFNAME
           MOVE 31043 TO CATREAD-MSG-NUMBER
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
           MOVE ERROR-BUFFER TO MESSAGE-LINE-P
           MOVE EDIT-ERROR TO ERRLINE-P
           MOVE WO-STAT-P TO WO-STAT-TEMP
           MOVE WO-PLANNED-BUF TO DSPLY-REC
           PERFORM 99-SCREEN-WRITE
           PERFORM 98-SCREEN-READ
           MOVE DSPLY-REC TO WO-PLANNED-BUF.

           MOVE SPACES TO EDIT-ERROR.
      *    IF VIEW-LASTKEY = 1 OR 3 GO TO 2-EOJ.
           IF VIEW-LASTKEY = 0
               NEXT SENTENCE
           ELSE
DCR01 **** IF VIEW-LASTKEY = 4 OR 6
           IF VIEW-LASTKEY = 4
DCR01         PERFORM 8000-CALL-EQUIP-SELECTION THRU 8000-EQ-XIT
DCR01         GO TO 69-READ-SCREEN
           ELSE
DCR01      IF VIEW-LASTKEY = 6
DCR01         PERFORM 8000-CALL-CRAFT-SELECTION THRU 8000-CS-XIT
DCR01         GO TO 69-READ-SCREEN
DCR01      ELSE
           GO TO 2-EOJ.

           IF PLANNED-SW = 0
               MOVE WO-STAT            TO      EDIT-WO-STAT
               MOVE WO-DATE-REC        TO      EDIT-DATE-RECD
               PERFORM 690-SET-REC-BUF
               MOVE WO-TIME-REC        TO      EDIT-TIME-RECD
               MOVE WO-APPR-CODE       TO      EDIT-APPROVAL-CODE
               MOVE WO-REQUESTER       TO      EDIT-REQUESTER
               MOVE WO-EQPNUM          TO      EDIT-EQUIP-NUM
               MOVE WO-EQPNAME         TO      EDIT-EQUIP-NAME
               MOVE WO-EQPTYP          TO      EDIT-TYPE-NUM
               MOVE WO-DEPT            TO      EDIT-DEPT
               MOVE WO-MAINT-ZONE      TO      EDIT-ZONE
               MOVE WO-LOC             TO      EDIT-LOCATION
               MOVE WO-PRIORITY        TO      EDIT-PRIORITY
               MOVE WO-EQPDWN          TO      EDIT-EQUIP-DOWN
               MOVE WO-EXPCLASS        TO      EDIT-EXPCLASS
               MOVE WO-DATE-STRT       TO      EDIT-DATE-STRT
               PERFORM 693-SET-STRT-BUF
               MOVE WO-TIME-STRT       TO      EDIT-TIME-STRT
               MOVE WO-DATE-COMP       TO      EDIT-DATE-COMP
               PERFORM 694-SET-COMP-BUF
               MOVE WO-TIME-COMP       TO      EDIT-TIME-COMP
           ELSE
           MOVE WO-STAT-P              TO      EDIT-WO-STAT
           MOVE WO-DATE-REC-P          TO      EDIT-DATE-RECD
           PERFORM 690-SET-REC-BUF
           MOVE WO-TIME-REC-P          TO      EDIT-TIME-RECD
           MOVE WO-APPR-CODE-P         TO      EDIT-APPROVAL-CODE
           MOVE WO-REQUESTER-P         TO      EDIT-REQUESTER
           MOVE WO-EQPNUM-P            TO      EDIT-EQUIP-NUM
           MOVE WO-EQPNAME-P           TO      EDIT-EQUIP-NAME
           MOVE WO-EQPTYP-P            TO      EDIT-TYPE-NUM
           MOVE WO-DEPT-P              TO      EDIT-DEPT
           MOVE WO-MAINT-ZONE-P        TO      EDIT-ZONE
           MOVE WO-LOC-P               TO      EDIT-LOCATION
           MOVE WO-PRIORITY-P          TO      EDIT-PRIORITY
           PERFORM 691-SET-REQD-BUF
           MOVE WO-EQPDWN-P            TO      EDIT-EQUIP-DOWN
           MOVE WO-EXPCLASS-P          TO      EDIT-EXPCLASS
           PERFORM 692-SET-SCHD-BUF
           MOVE WO-DATE-STRT-P         TO      EDIT-DATE-STRT
           PERFORM 693-SET-STRT-BUF
           MOVE WO-TIME-STRT-P         TO      EDIT-TIME-STRT
           MOVE WO-DATE-COMP-P         TO      EDIT-DATE-COMP
           PERFORM 694-SET-COMP-BUF
           MOVE WO-TIME-COMP-P         TO      EDIT-TIME-COMP
           MOVE WO-CURRENT-TYPE        TO      EDIT-WO-CURRENT-TYPE.

       690-SET-REC-BUF.
           IF PLANNED-SW = 0
               MOVE 3 TO DATE-MODE
               MOVE WO-DATE-REC TO DATE-VALIDATE-IN
               CALL "TDATECHK" USING DATE-CHECK-AREA
               MOVE DATE-DB TO DATE-RECD-BUF
           ELSE
           MOVE 3 TO DATE-MODE
           MOVE WO-DATE-REC-P TO DATE-VALIDATE-IN
           CALL "TDATECHK" USING DATE-CHECK-AREA
           MOVE DATE-DB TO DATE-RECD-BUF.

           IF DATE-RECD-BUF-YY > "70"
               MOVE "19" TO DATE-RECD-BUF-CC,
                            EDIT-DATE-RECD-CC
           ELSE
           MOVE "20" TO DATE-RECD-BUF-CC,
                        EDIT-DATE-RECD-CC.

       691-SET-REQD-BUF.
           IF WO-DATE-REQD-P = "      "
               NEXT SENTENCE
           ELSE
           MOVE 3 TO DATE-MODE
           MOVE WO-DATE-REQD-P TO DATE-VALIDATE-IN
           CALL "TDATECHK" USING DATE-CHECK-AREA
           MOVE DATE-DB TO DATE-REQD-BUF
           IF DATE-REQD-BUF-YY > "70"
               MOVE "19" TO DATE-REQD-BUF-CC
           ELSE
           MOVE "20" TO DATE-REQD-BUF-CC.

           IF WO-TIME-REQD-P = "    "
               NEXT SENTENCE
           ELSE
           INSPECT WO-TIME-REQD-P REPLACING ALL " " BY "0".

       692-SET-SCHD-BUF.
           IF WO-DATE-SCHD-P = "      "
               NEXT SENTENCE
           ELSE
           MOVE 3 TO DATE-MODE
           MOVE WO-DATE-SCHD-P TO DATE-VALIDATE-IN
           CALL "TDATECHK" USING DATE-CHECK-AREA
           MOVE DATE-DB TO DATE-PROM-BUF
           IF DATE-PROM-BUF-YY > "70"
               MOVE "19" TO DATE-PROM-BUF-CC
           ELSE
           MOVE "20" TO DATE-PROM-BUF-CC.

           IF WO-TIME-SCHD-P = "    "
               NEXT SENTENCE
           ELSE
           INSPECT WO-TIME-SCHD-P REPLACING ALL " " BY "0".

       693-SET-STRT-BUF.
           IF PLANNED-SW = 0
               MOVE 3 TO DATE-MODE
               MOVE WO-DATE-STRT TO DATE-VALIDATE-IN
               CALL "TDATECHK" USING DATE-CHECK-AREA
               MOVE DATE-DB TO DATE-STRT-BUF
           ELSE
           MOVE 3 TO DATE-MODE
           MOVE WO-DATE-STRT-P TO DATE-VALIDATE-IN
           CALL "TDATECHK" USING DATE-CHECK-AREA
           MOVE DATE-DB TO DATE-STRT-BUF.

           IF DATE-STRT-BUF-YY > "70"
               MOVE "19" TO DATE-STRT-BUF-CC,
                            EDIT-DATE-STRT-CC
           ELSE
           MOVE "20" TO DATE-STRT-BUF-CC,
                        EDIT-DATE-STRT-CC.

       694-SET-COMP-BUF.
           IF PLANNED-SW = 0
               MOVE 3 TO DATE-MODE
               MOVE WO-DATE-COMP TO DATE-VALIDATE-IN
               CALL "TDATECHK" USING DATE-CHECK-AREA
               MOVE DATE-DB TO DATE-COMP-BUF
           ELSE
           MOVE 3 TO DATE-MODE
           MOVE WO-DATE-COMP-P TO DATE-VALIDATE-IN
           CALL "TDATECHK" USING DATE-CHECK-AREA
           MOVE DATE-DB TO DATE-COMP-BUF.

           IF DATE-COMP-BUF-YY > "70"
               MOVE "19" TO DATE-COMP-BUF-CC,
                            EDIT-DATE-COMP-CC
           ELSE
           MOVE "20" TO DATE-COMP-BUF-CC,
                        EDIT-DATE-COMP-CC.

       98-SCREEN-READ.
           READ DISPLAY-FILE FORMAT IS VIEW-CFNAME
               INDIC IS INDICS.
           ACCEPT IOFEEDBACK FROM I-O-FEEDBACK-AREA.
           MOVE ALL B"0" TO INDICS.
           IF DSPLY-STATUS NOT = "00"
               MOVE 3 TO VIEW-LASTKEY
           ELSE
           MOVE FUNCTION-NUM TO VIEW-LASTKEY.

       98A-SCREEN-READ.
           READ DISPLAY-FILE TERMINAL IS TERMINAL-ID
               INDIC IS INDICS
                  NO DATA MOVE DSPLY-STATUS TO DSPLY-STATUS.
           MOVE ALL B"0" TO INDICS.

       99-SCREEN-WRITE.
           WRITE DSPLY-REC FORMAT IS VIEW-CFNAME
               INDIC IS INDICS.
           MOVE ALL B"0" TO INDICS.

       998-BLOWUP.
           MOVE "TMODWORK" TO BU-PGM-NAME.
           CALL "TBLOWUP" USING BLOWUP-BASE BU-PGM-NAME STATUS-AREA
                            VIEW-COMAREA DUMMY-KSAM-STAT
                            BU-DISPLAY-MSG BU-DISPLAY-FLDS.

       999-CATREAD.
           MOVE SPACES TO ERROR-BUFFER.
           CALL "CCATREAD" USING CATREAD-PARMS.
           MOVE CATREAD-MSG-TEXT TO ERROR-BUFFER.

       999-CATREAD-EXIT.       EXIT.


DCR01 **************************************************************
DCR01 ** CALL CRAFT SELECTION PGM
DCR01 **************************************************************
DCR01  8000-CALL-CRAFT-SELECTION.

           MOVE SPACE         TO  WS-CRAFT.
           MOVE SPACE         TO  WS-CRAFT-FLAG.
           MOVE SPACE         TO  WS-CRAFT-DESC.
           MOVE "S"           TO  WS-CRAFT-DISP.
           CALL WS-CRAFT-SEL-PGM  USING WS-CRAFT  WS-CRAFT-FLAG
                                        WS-CRAFT-DESC   WS-CRAFT-DISP.

           IF WS-CRAFT(1:2) NOT = SPACES
              MOVE WS-CRAFT(1:2) TO WO-CRAFTS-REQD-1
           END-IF.

           IF WS-CRAFT(3:2) NOT = SPACES
              MOVE WS-CRAFT(3:2) TO WO-CRAFTS-REQD-2
           END-IF.

           IF WS-CRAFT(5:2) NOT = SPACES
              MOVE WS-CRAFT(5:2) TO WO-CRAFTS-REQD-3
           END-IF.

DCR01  8000-CS-XIT.
DCR01       EXIT.

DCR01 **************************************************************
DCR01 ** CALL EQUIP SELECTION PGM
DCR01 **************************************************************
DCR01  8000-CALL-EQUIP-SELECTION.

           MOVE SPACE         TO  WS-EQUIP-NBR.
           CALL WS-EQUIP-SEL-PGM  USING WS-EQUIP-NBR.

           IF WS-EQUIP-NBR NOT = SPACES
              MOVE WS-EQUIP-NBR  TO WO-EQPNUM
           END-IF.

DCR01  8000-EQ-XIT.
DCR01       EXIT.
