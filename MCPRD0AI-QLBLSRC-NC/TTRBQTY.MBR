015000*                                    *
015100*    NATIVE LANGUAGE SUPPORT AREA    *
015200*                                    *
015300**************************************
015400
015500 COPY LANGUAGE IN COPYCSIS.
015600
015700
015800 PROCEDURE DIVISION.
015900 1-HOUSEKEEP SECTION.
016000
016100*    CALL "DBOPEN" USING BASE, PASSWORD, MODE1, STATUS-AREA.
016200*    IF COND-WORD NOT = 0
016300*        MOVE "DBOPEN ERROR" TO BU-DISPLAY-MSG
016400*        GO TO 2-BLOWUP.
016500*
016600*    CALL INTRINSIC "FINDJCW" USING LANG-JCW-NAME, LANG-JCW-VALUE,
016700*                               LANG-JCW-STATUS.
016800*    IF LANG-JCW-STATUS NOT = 0
016900*        MOVE 1 TO LANG-JCW-VALUE.
017000*
017100*    CALL INTRINSIC "NLAPPEND" USING FORM-GNAME, LANG-JCW-VALUE,
017200*         LANG-ERROR.
017300*    IF LANG-ERROR1 NOT = 0
017400*        MOVE "001" TO FORM-GNAME2.
017500*
017600*    MOVE FORM-GNAME2 TO LANG-ERCAT-FNAME2, LANG-ERCAT-GNAME2.
017700*
017800*    CALL INTRINSIC "CATOPEN" USING LANG-ERCAT, LANG-ERROR,
017900*        GIVING LANG-INDEX.
018000*    IF LANG-ERROR1 NOT = 0
018100*        MOVE "CATOPEN FAILED * TMTSTEXC" TO BU-DISPLAY-MSG
018200*        GO TO 2-BLOWUP.
018300*
018400*    CALL "VOPENFORMF" USING VIEW-COMAREA FORMFILE.
018500*    IF VIEW-STATUS NOT = 0
018600*        MOVE "VOPENFORMF ERR 1-H" TO BU-DISPLAY-MSG
018700*        GO TO 2-BLOWUP.
018800*
018900*    CALL "VOPENTERM" USING VIEW-COMAREA TERMFILENAME.
019000*    IF VIEW-STATUS NOT = 0
019100*        MOVE "VOPENTERM ERR" TO BU-DISPLAY-MSG
019200*        GO TO 2-BLOWUP.
019300*
019400     CALL "SMTRBQTY" USING BASE, VIEW-COMAREA, LANGUAGE-PARMS.
019500
019600 1-EOJ.
019700*    CALL INTRINSIC "CATCLOSE" USING LANG-INDEX, LANG-ERROR.
019800*    CALL "VCLOSETERM" USING VIEW-COMAREA.
019900*    CALL "VCLOSEFORMF" USING VIEW-COMAREA.
020000*    CALL "DBCLOSE" USING BASE, DSET-DUMMY, MODE1,
020100*        STATUS-AREA.
020200     GOBACK.
020300
020400 2-BLOWUP.
020500     MOVE "TTRBQTY"                TO  BU-PGM-NAME.
020600     CALL "TBLOWUP" USING BASE, BU-PGM-NAME, STATUS-AREA,
020700       VIEW-COMAREA, DUMMY-KSAM-STAT, BU-DISPLAY-MSG,
020800       BU-DISPLAY-FLDS.
020900
