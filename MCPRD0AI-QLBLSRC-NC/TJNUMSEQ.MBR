000200 IDENTIFICATION DIVISION.
000300 PROGRAM-ID. TJNUMSEQ.
000400 ENVIRONMENT DIVISION.
000500 CONFIGURATION SECTION.
000600 SOURCE-COMPUTER.  AS400.
000700 OBJECT-COMPUTER.  AS400.
       SPECIAL-NAMES. I-O-FEEDBACK IS I-O-FEEDBACK-AREA
                      LOCAL-DATA IS LOCAL-DATA-AREA.
001000 INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT JOBPLAN-BANK
               ASSIGN TO DATABASE-MCFLMM3601
               ORGANIZATION IS INDEXED
               ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                   WITH DUPLICATES
               FILE STATUS IS JB-STATUS.
           SELECT JOBPLAN-BANK-PF
               ASSIGN TO DATABASE-MCFPMM3600
               ORGANIZATION IS RELATIVE
               ACCESS MODE IS RANDOM
               RELATIVE KEY IS PFKEY
               FILE STATUS IS JBPF-STATUS.
001200 DATA DIVISION.
       FILE SECTION.
       FD  JOBPLAN-BANK
           LABEL RECORDS ARE STANDARD
           DATA RECORD JBREC.
       01  JBREC.
           COPY DDS-ALL-FORMATS OF MCFLMM3601.
       FD  JOBPLAN-BANK-PF
           LABEL RECORDS ARE STANDARD
           DATA RECORD JBPFREC.
       01  JBPFREC.
           COPY DDS-ALL-FORMATS OF MCFPMM3600.
001100 WORKING-STORAGE SECTION.
       01  BLOWUP-BASE             PIC X(16).

       01  FILE-STATUSES.
           05  JB-STATUS           PIC XX.
           05  JBPF-STATUS         PIC XX.

       COPY IOFEEDBACK OF COPYLIB.

001300 01  JOBPLAN-BUFFER.         COPY DJOBBANK OF COPYLIB.
001400
001500 01  MISC-BUFFER             PIC X(80) VALUE SPACES.
001600
001700 01  PASSWORD-INFORMATION.
001800     05  NAME-OF-PROGRAM     PIC X(08) VALUE "TJNUMSEQ".
001900     05  PROGRAM-TYPE        PIC X(02) VALUE "UP".
002000     05  PROGRAM-RELEASE     PIC X(12) VALUE " E0100010001".
002100     05  PROGRAM-DESCRIPTION.
002200         10  PROG-DESC-A     PIC X(60) VALUE
002300            " RENUMBER THE LINES OF A JOBPLAN SEQUENCE  "        .
002400         10  PROG-DESC-B     PIC X(60) VALUE SPACES.
002600         10  PROG-FUNCTION   PIC X(60) VALUE SPACES.
002800     05  PASSWORD-FLAG       PIC X.
002900
       01  PFKEY                   PIC 9(9).

003000 01  RECORD-TABLE.
003100     05 RECORD-NUMBER OCCURS 1000 TIMES
003200                             PIC 9(9).
003300
003400 01  S1                      PIC S9(4) COMP-4.
003500
003600 01  S2                      PIC S9(4) COMP-4.
003700
003800 01  S3                      PIC S9(4) COMP-4.
003900
       COPY DBSTAT OF COPYLIB.

       COPY TBLOWUP   OF COPYLIB.

004200 LINKAGE SECTION.
004400 01  DBPARAMETERS.           COPY DBPARMS OF COPYLIB.
       COPY VCOMLINK OF COPYLIB.
       COPY LANGSUB OF COPYLIB.
004700 01  JOBPLAN-KEY.
004800     05 JOBP-WO-NO           PIC X(10).
004900     05 JOBP-SEQ-NO          PIC 999.
005000     05 FILLER               PIC X.
005100
005300 PROCEDURE DIVISION USING    DBPARAMETERS
005400                             VIEW-COMAREA
005500                             LANGUAGE-PARMS
005600                             JOBPLAN-KEY.
005700
005800 START-PROGRAM.
005900     PERFORM 1-HSK.
006000     PERFORM 6-MAIN.
006200
006300 2-EOJ.
           CLOSE JOBPLAN-BANK.
           CLOSE JOBPLAN-BANK-PF.
006400     GOBACK.
006500
006700 1-HSK.
           OPEN I-O   JOBPLAN-BANK.
           OPEN I-O   JOBPLAN-BANK-PF.
006800     CALL "TPWORD" USING PASSWORD-INFORMATION.
007200     IF PASSWORD-FLAG = "N" GO TO 2-EOJ.
007700     MOVE 0 TO S1 S2 S3.
007800
008000 6-MAIN.
008200     PERFORM 61-GET-REC-NUMBERS THRU 61-G-R-N-E.
008300     PERFORM 62-NUMBER-SEQUENCE THRU 62-N-S-E S1 TIMES.
008400
008600 61-GET-REC-NUMBERS.
           MOVE 0 TO COND-WORD.
           MOVE JOBPLAN-KEY TO GJOBPSEQ OF JBREC.
           START JOBPLAN-BANK KEY IS > EXTERNALLY-DESCRIBED-KEY
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF JB-STATUS NOT = "00" MOVE 17 TO COND-WORD.
008900     IF COND-WORD = 17 GO TO 61-G-R-N-E.
009700
009800 61-SAVE-NUMBER.
           MOVE 0 TO COND-WORD.
           READ JOBPLAN-BANK NEXT INTO JOBPLAN-BUFFER
               AT END    MOVE 15 TO COND-WORD.
           IF JOBPLAN-KEY NOT = GJOBPSEQ OF JBREC
               MOVE 15 TO COND-WORD.
           IF JB-STATUS NOT = "00" MOVE 15 TO COND-WORD.
010100     IF COND-WORD = 15
010200         GO TO 61-G-R-N-E
010300     ELSE
010400     IF COND-WORD = 0
010500         ADD 1 TO S1
               ACCEPT IOFEEDBACK FROM I-O-FEEDBACK-AREA
010600         MOVE IO-REL-NO TO RECORD-NUMBER (S1).
011100     GO TO 61-SAVE-NUMBER.
011200
011300 61-G-R-N-E.    EXIT.
011500
011700 62-NUMBER-SEQUENCE.
011800     ADD 1 TO S2.
           MOVE RECORD-NUMBER (S2) TO PFKEY.
           MOVE 0 TO COND-WORD.
           READ JOBPLAN-BANK-PF INTO JOBPLAN-BUFFER
               INVALID KEY    MOVE 15 TO COND-WORD.
           IF JBPF-STATUS NOT = "00" MOVE 15 TO COND-WORD.
012100     IF COND-WORD = 0
012200         NEXT SENTENCE
012300     ELSE
012400     PERFORM 998-BLOWUP.
012600     DELETE JOBPLAN-BANK-PF RECORD
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF JBPF-STATUS NOT = "00" MOVE 17 TO COND-WORD.
           IF COND-WORD NOT = 0
               PERFORM 998-BLOWUP.
013200     ADD 10 TO S3.
013300     MOVE S3 TO JOBP-LINE-NUM.
           MOVE 0 TO COND-WORD.
           WRITE JBPFREC FROM JOBPLAN-BUFFER
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF JBPF-STATUS NOT = "00" MOVE 17 TO COND-WORD.
           IF COND-WORD = 17 PERFORM 998-BLOWUP.

014000 62-N-S-E.    EXIT.

076200 998-BLOWUP.
076300     MOVE "TJNUMSEQ" TO BU-PGM-NAME.
076400     CALL "TBLOWUP" USING BLOWUP-BASE BU-PGM-NAME STATUS-AREA
076500                      VIEW-COMAREA DUMMY-KSAM-STAT
076600                      BU-DISPLAY-MSG BU-DISPLAY-FLDS.
