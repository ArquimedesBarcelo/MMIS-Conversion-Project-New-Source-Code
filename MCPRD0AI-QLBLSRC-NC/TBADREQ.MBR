000200 IDENTIFICATION DIVISION.
000300 PROGRAM-ID.     TBADREQ.
000400 AUTHOR.         C HILLES/JIM COFFMAN (MAINTAINER).
000500 DATE-WRITTEN.   11/30/87.
000600 DATE-COMPILED.
000700*INSTALLATION.   GOODYEAR TIRE AND RUBBER - AKRON.
000800*SECURITY.
000900*REMARKS.
001000*
001100*D   PROGRAM CHECKS FOR REQS WITH NO DREQD OR DREQITM DETAIL, AND
001200*D   GIVES THE OPTION TO DELETE.
001300
001400 ENVIRONMENT DIVISION.
001500 CONFIGURATION SECTION.
001600 SOURCE-COMPUTER.  HP-3000.
001700 OBJECT-COMPUTER.  HP-3000.
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT MREQ-RQ-O
               ASSIGN TO DATABASE-MCFLCS2001
               ORGANIZATION IS INDEXED
                 ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
               FILE STATUS IS FILE-STATUS.

           SELECT DREQDESC-RQ-O
               ASSIGN TO DATABASE-MCFLCS2301
               ORGANIZATION IS INDEXED
                 ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                 WITH DUPLICATES
               FILE STATUS IS FILE-STATUS.

           SELECT DREQITM-RQ-O
               ASSIGN TO DATABASE-MCFLCS2201
               ORGANIZATION IS INDEXED
                 ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                 WITH DUPLICATES
               FILE STATUS IS FILE-STATUS.

           SELECT DREQD-RQ-O
               ASSIGN TO DATABASE-MCFLCS2101
               ORGANIZATION IS INDEXED
                 ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                 WITH DUPLICATES
               FILE STATUS IS FILE-STATUS.

           SELECT DREQQUE-RQ-O
               ASSIGN TO DATABASE-MCFLCS4401
               ORGANIZATION IS INDEXED
                 ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                 WITH DUPLICATES
               FILE STATUS IS FILE-STATUS.

           SELECT DVENDITM-RQ-O
               ASSIGN TO DATABASE-MCFLCS0804
               ORGANIZATION IS INDEXED
                 ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                 WITH DUPLICATES
               FILE STATUS IS FILE-STATUS.

001800
001900 DATA DIVISION.
       FILE SECTION.
      *------ FD STATEMENT AREA FOR IBM ONLY ------*
       FD  MREQ-RQ-O
           LABEL RECORDS ARE STANDARD.
       01  MREQ-RQ-REC-O.
           COPY DDS-MCRPCS2000  OF MCFLCS2001.

       FD  DREQDESC-RQ-O
           LABEL RECORDS ARE STANDARD.
       01  DREQDESC-RQ-REC-O.
           COPY DDS-MCRPCS2300  OF MCFLCS2301.

       FD  DREQITM-RQ-O
           LABEL RECORDS ARE STANDARD.
       01  DREQITM-RQ-REC-O.
           COPY DDS-MCRPCS2200  OF MCFLCS2201.

       FD  DREQD-RQ-O
           LABEL RECORDS ARE STANDARD.
       01  DREQD-RQ-REC-O.
           COPY DDS-MCRPCS2100  OF MCFLCS2101.

       FD  DREQQUE-RQ-O
           LABEL RECORDS ARE STANDARD.
       01  DREQQUE-RQ-REC-O.
           COPY DDS-MCRPCS4400  OF MCFLCS4401.

       FD  DVENDITM-RQ-O
           LABEL RECORDS ARE STANDARD.
       01  DVENDITM-RQ-REC-O.
           COPY DDS-MCRPCS0800  OF MCFLCS0804.

      *------ FD STATEMENT AREA FOR IBM ONLY ------*
002000 WORKING-STORAGE SECTION.
002100 01  UPDATE-FLAG                   PIC X(1)  VALUE "N".
002200 01  SUB                           PIC 9(4)  VALUE 0.
002300 01  SUB2                          PIC 9(4)  VALUE 0.
002400 01  EMPL-LIMIT                    PIC 9(4)  VALUE 0.
002500 01  APPROVALS-LEFT-COUNT          PIC 9(4)  VALUE 0.
002600 01  DIRECTED-ADDR                 PIC S9(9) BINARY VALUE 0.
002700 01  FUNCTION-OPTION               PIC X(1)  VALUE "I".
002800 01  DELETE-ANSWER                 PIC X(1)  VALUE "N".
002900
003000 01  EMPL-TABLE.
003100     05  SAVE-LINE OCCURS 50 TIMES.
003200         10  SAVE-EMPL             PIC X(4).
003300         10  SAVE-ADDR             PIC S9(9) BINARY.
003400
003500**************************************************************
003600**                                                          **
003700**            D A T A B A S E   W O R K                     **
003800**                                                          **
003900**************************************************************
       01  FILE-STATUS.
           05  FILE-STATUS-1            PIC X  VALUE "0".
           05  FILE-STATUS-2            PIC X  VALUE "0".
004000
004100 01  BASE                          PIC X(10) VALUE "  STORES;".
004200 01  PASSWORD                      PIC X(5)  VALUE "JADE;".
004300 01  DSET-NAMES.
004400     05  DSET-NAME                 PIC X(16) VALUE SPACES.
004500     05  DSET-MREQ                 PIC X(16) VALUE "MREQ;".
004600     05  DSET-DREQQUE              PIC X(16) VALUE "DREQQUE;".
004700     05  DSET-MEMPL                PIC X(16) VALUE "MEMPL;".
004800     05  DSET-DREQD                PIC X(16) VALUE "DREQD;".
004900     05  DSET-DREQITM              PIC X(16) VALUE "DREQITM;".
005000     05  DSET-DREQDESC             PIC X(16) VALUE "DREQDESC;".
005100
005200 COPY DBSTAT     IN COPYLIB.
005300 01  REQ-SEARCH                    PIC X(16) VALUE "REQ-NUMBER;".
005400 01  REQ-ARG                       PIC X(12) VALUE SPACES.
005500
005600 01  MODE-AREA.
005700     05  DB-MODE                   PIC S9(4)   COMP       VALUE 0.
005800     05  MODE1                     PIC S9(4)   COMP       VALUE 1.
005900     05  MODE2                     PIC S9(4)   COMP       VALUE 2.
006000     05  MODE3                     PIC S9(4)   COMP       VALUE 3.
006100     05  MODE4                     PIC S9(4)   COMP       VALUE 4.
006200     05  MODE5                     PIC S9(4)   COMP       VALUE 5.
006300     05  MODE7                     PIC S9(4)   COMP       VALUE 7.
006400
006500 01  ALL-ITEMS                     PIC X(2)  VALUE "@;".
006600
006700 01  MULTI-LOCK.
006800     05  NUMBER-OF-DSETS-LOCKED PIC S9(4) BINARY VALUE 2.
006900     05  LOCK1.
007000         10  LENGTH-1           PIC S9(4) BINARY VALUE 24.
007100         10  DSET-NAME-1        PIC X(16)  VALUE "MREQ;".
007200         10  ITEM-LIST-1        PIC X(16)  VALUE "REQ-NUMBER;".
007300         10  REL-OP-1           PIC XX     VALUE "= ".
007400         10  LOCK-VALUE-1       PIC X(12)  VALUE SPACES.
007500     05  LOCK2.
007600         10  LENGTH-2           PIC S9(4) BINARY VALUE 24.
007700         10  DSET-NAME-2        PIC X(16)  VALUE "DREQQUE;".
007800         10  ITEM-LIST-2        PIC X(16)  VALUE "REQ-NUMBER;".
007900         10  REL-OP-2           PIC XX     VALUE "= ".
008000         10  LOCK-VALUE-2       PIC X(12)  VALUE SPACES.
008100
008200 COPY MREQ       IN COPYLIB.
008300 COPY DREQQUE    IN COPYLIB.
       COPY DREQDESC   IN COPYLIB.
       COPY DREQITM    IN COPYLIB.
       COPY DVENDITM   IN COPYLIB.
       COPY DREQD      IN COPYLIB.
008400
008500******************************************************************
008600**                                                              **
008700**          S U B P R O G R A M   A R E A S                     **
008800**                                                              **
008900******************************************************************
009000 COPY TBLOWUP    IN COPYLIB.
009100
009200 PROCEDURE DIVISION.
009300
009400 6000-MAIN.
           MOVE "01" TO BU-DISPLAY-PARA.
           PERFORM 9999-OPEN-STUFF.

010100     DISPLAY "THIS PROGRAM DELETES ANY BAD REQUISITIONS:".
010200     DISPLAY "  - ANY REQ WITH NO DREQITM SEGMENT       ".
           DISPLAY
010300     "  - ANY REQ OF RELEASE STAT 'X ' OR 'XX' WITH NO DREQD"    .
010400     DISPLAY " ".
010500     DISPLAY "ENTER ONE OF THE FOLLOWING OPTIONS".
010600     DISPLAY "'I' - REVIEW EACH REQ INDIVIDUALLY".
010700     DISPLAY "'D' - CONTINOUS DISPLAY".
010800     DISPLAY "'C' - CONTINOUS DELETE"
010900     MOVE "I"                      TO   FUNCTION-OPTION.
011000     ACCEPT FUNCTION-OPTION.
011100
011200 6100-SERIAL-LOOP.
           MOVE "02" TO BU-DISPLAY-PARA.
           PERFORM 9999-DBGET2-MREQ-RQ-O.
011500     IF END-OF-FILE
011600         GO TO 6990-MAIN-X.
           PERFORM 9999-REWRITE-MREQ-RQ-O.
012000
012100     MOVE MREQ-NUMBER              TO   REQ-ARG.
           PERFORM 9999-DBFIND-DREQITM-RQ-O.
           PERFORM 9999-DBGET5-DREQITM-RQ-O.
           IF NOT GOOD-CALL
012800         DISPLAY "REQ ", MREQ-NUMBER, " HAS NO DREQITM SEGMENT "
012900         PERFORM 7000-DELETE-QUESTION THRU 7090-DQ-X
013000         GO TO 6100-SERIAL-LOOP
           ELSE
               PERFORM 9999-RESET-DREQITM-RQ-O.
013100
013200*------ REQS NOT YET RELEASED TO PURCH MAY NOT HAVE A DREQD
013300     IF REQ-RELEASE-STAT = "  " OR "U "
013400         GO TO 6120-SKIP-DREQD-CHECK.
013500
           PERFORM 9999-DBFIND-DREQD-RQ-O.
           PERFORM 9999-DBGET5-DREQD-RQ-O.
           IF NOT GOOD-CALL
014200         DISPLAY "REQ ", MREQ-NUMBER, " HAS NO DREQD SEGMENT "
014300         PERFORM 7000-DELETE-QUESTION THRU 7090-DQ-X
014400         GO TO 6100-SERIAL-LOOP
           ELSE
               PERFORM 9999-RESET-DREQD-RQ-O.
014500
014600 6120-SKIP-DREQD-CHECK.
014700     IF DELETE-ANSWER = "Q"
014800         GO TO 6990-MAIN-X.
014900
015000     GO TO 6100-SERIAL-LOOP.
015100
015300
015400 7000-DELETE-QUESTION.
           MOVE "03" TO BU-DISPLAY-PARA.
015500     DISPLAY "REQ-DATE = ", REQ-DATE.
015600     DISPLAY "REQ-RELEASE-STAT = ", REQ-RELEASE-STAT.
015700     DISPLAY "REQ-STATUS = ", REQ-STATUS.
015800     DISPLAY "REQ-RCV-DEPT = ", REQ-RCV-DEPT.
015900     DISPLAY "REQ-DATE-WANTED = ", REQ-DATE-WANTED.
016000
016100     IF FUNCTION-OPTION = "I"
016200         NEXT SENTENCE
016300     ELSE
016400     IF FUNCTION-OPTION = "D"
016500         GO TO 7090-DQ-X
016600     ELSE
016700     IF FUNCTION-OPTION = "C"
016800         GO TO 7010-DELETE-REQ
016900     ELSE
017000         NEXT SENTENCE.
017100
017200     DISPLAY "'D' TO DELETE, 'Q' TO QUIT, 'RETURN' TO SKIP".
017300     MOVE SPACES                   TO   DELETE-ANSWER.
017400     ACCEPT DELETE-ANSWER.
017500     IF DELETE-ANSWER = "D"
017600         NEXT SENTENCE
017700     ELSE
017800         GO TO 7090-DQ-X.
017900
018000 7010-DELETE-REQ.
           PERFORM 9999-DBFIND-DREQDESC-RQ-O.
           MOVE 0 TO COND-WORD.
           PERFORM UNTIL NOT GOOD-CALL
               PERFORM 9999-DBGET5-DREQDESC-RQ-O
               IF GOOD-CALL
                   PERFORM 9999-DBDELETE-DREQDESC-RQ-O
               END-IF
           END-PERFORM.
018900
           PERFORM 9999-DBFIND-DREQITM-RQ-O.
           MOVE 0 TO COND-WORD.
           PERFORM UNTIL NOT GOOD-CALL
               PERFORM 9999-DBGET5-DREQITM-RQ-O
               IF GOOD-CALL
                   PERFORM 9999-DBDELETE-DREQITM-RQ-O
               END-IF
           END-PERFORM.
019400
           PERFORM 9999-DBFIND-DREQD-RQ-O.
           MOVE 0 TO COND-WORD.
           PERFORM UNTIL NOT GOOD-CALL
               PERFORM 9999-DBGET5-DREQD-RQ-O
               IF GOOD-CALL
                   PERFORM 9999-DBDELETE-DREQD-RQ-O
               END-IF
           END-PERFORM.
019400
           PERFORM 9999-DBFIND-DREQQUE-RQ-O.
           MOVE 0 TO COND-WORD.
           PERFORM UNTIL NOT GOOD-CALL
               PERFORM 9999-DBGET5-DREQQUE-RQ-O
               IF GOOD-CALL
                   PERFORM 9999-DBDELETE-DREQQUE-RQ-O
               END-IF
           END-PERFORM.
019400
      *------ NOTE: WE SHOULD PUT A DELETE/PUT OF DVENDITM SEGMENT
      *------ HERE.  IF THE REQ WAS ON A DVENDITM, HP VERSION WOULD
      *------ BLOW UP, IBM VERSION WOULD LEAVE A NON-EXISTENT REQ
      *------ IN DVENDITM
019400
           MOVE "MREQ;" TO DSET-NAME.
           PERFORM 9930-LOCK.
           PERFORM 9999-DBDELETE-MREQ-RQ-O.
           PERFORM 9940-UNLOCK.

      *------- THIS DELETE FOR IBM LOSES THE CURRENT REC, SO WE
      *------- RE-POSITION WITH A START.
           PERFORM 9999-REPOS-MREQ-RQ-O.

021400 7090-DQ-X.
021500     EXIT.
021600
021700
021800 6990-MAIN-X.
           PERFORM 9999-CLOSE-STUFF.
021900     GOBACK.
022000
022100 2100-BLOWUP.
022200     DISPLAY "FATAL ERROR, FILE-STATUS = ", FILE-STATUS.
           DISPLAY BU-DISPLAY-MSG.
022300     GOBACK.

       9930-LOCK.
       9940-UNLOCK.
       9999-DBGET2-MREQ-RQ-O.
           MOVE 0 TO COND-WORD.
           READ MREQ-RQ-O NEXT INTO BUF-MREQ
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS-1 = "1" OR FILE-STATUS = "46"
               MOVE 11 TO COND-WORD
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE "DBGET2 ERR 9999-DBGET2-MREQ-RQ-O"
                   TO BU-MSG-AREA
               MOVE 99 TO COND-WORD
               PERFORM 2100-BLOWUP.

       9999-INIT-MREQ-RQ-O.
           MOVE SPACES TO REQNO OF MREQ-RQ-REC-O.
           START MREQ-RQ-O KEY >= REQNO OF MREQ-RQ-REC-O
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.

       9999-REPOS-MREQ-RQ-O.
           MOVE REQ-ARG TO REQNO OF MREQ-RQ-REC-O.
           START MREQ-RQ-O KEY >= REQNO OF MREQ-RQ-REC-O
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.

       9999-DBDELETE-MREQ-RQ-O.
           MOVE 0 TO COND-WORD.
           DELETE MREQ-RQ-O
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE "DBDELETE ERR 9999-DBDELETE-MREQ-RQ-O"
                   TO BU-MSG-AREA
               MOVE 99 TO COND-WORD
               PERFORM 2100-BLOWUP.

       9999-REWRITE-MREQ-RQ-O.
           MOVE 0 TO COND-WORD.
           REWRITE MREQ-RQ-REC-O FROM BUF-MREQ
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD.

       9999-DBFIND-DREQDESC-RQ-O.
           MOVE 0 TO COND-WORD.
           MOVE REQ-ARG TO REQNO OF DREQDESC-RQ-REC-O.
           START DREQDESC-RQ-O KEY = REQNO OF DREQDESC-RQ-REC-O
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF (FILE-STATUS NOT = "00") AND (FILE-STATUS-1 NOT = "2")
               MOVE "DBFIND ERR 9999-DBFIND-DREQDESC-RQ-O"
                   TO BU-MSG-AREA
               MOVE 99 TO COND-WORD
               PERFORM 2100-BLOWUP.

       9999-DBGET5-DREQDESC-RQ-O.
           MOVE 0 TO COND-WORD.
           READ DREQDESC-RQ-O NEXT INTO BUF-DREQDESC
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14"
                   PERFORM 9999-RESET-DREQDESC-RQ-O
                   MOVE 15 TO COND-WORD
               ELSE
               IF FILE-STATUS = "46"
                   MOVE 15 TO COND-WORD
               ELSE
                   MOVE "DBGET5 ERR 9999-DBGET5-DREQDESC-RQ-O"
                       TO BU-MSG-AREA
                   MOVE 99 TO COND-WORD
                   PERFORM 2100-BLOWUP
           ELSE
           IF REQNO OF DREQDESC-RQ-REC-O NOT = REQ-ARG
               PERFORM 9999-RESET-DREQDESC-RQ-O
               MOVE 15 TO COND-WORD.

       9999-RESET-DREQDESC-RQ-O.
           MOVE HIGH-VALUES TO REQNO OF DREQDESC-RQ-REC-O.
           START DREQDESC-RQ-O KEY > REQNO OF DREQDESC-RQ-REC-O
               INVALID KEY MOVE "00" TO FILE-STATUS.

       9999-DBDELETE-DREQDESC-RQ-O.
           MOVE 0 TO COND-WORD.
           DELETE DREQDESC-RQ-O
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE "DBDELETE ERR 9999-DBDELETE-DREQDESC-RQ-O"
                   TO BU-MSG-AREA
               MOVE 99 TO COND-WORD
               PERFORM 2100-BLOWUP.

       9999-DBFIND-DREQITM-RQ-O.
           MOVE 0 TO COND-WORD.
           MOVE REQ-ARG TO REQNO OF DREQITM-RQ-REC-O.
           START DREQITM-RQ-O KEY = REQNO OF DREQITM-RQ-REC-O
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF (FILE-STATUS NOT = "00") AND (FILE-STATUS-1 NOT = "2")
               MOVE "DBFIND ERR 9999-DBFIND-DREQITM-RQ-O"
                   TO BU-MSG-AREA
               MOVE 99 TO COND-WORD
               PERFORM 2100-BLOWUP.

       9999-DBGET5-DREQITM-RQ-O.
           MOVE 0 TO COND-WORD.
           READ DREQITM-RQ-O NEXT INTO BUF-DREQITM
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14"
                   PERFORM 9999-RESET-DREQITM-RQ-O
                   MOVE 15 TO COND-WORD
               ELSE
               IF FILE-STATUS = "46"
                   MOVE 15 TO COND-WORD
               ELSE
                   MOVE "DBGET5 ERR 9999-DBGET5-DREQITM-RQ-O"
                       TO BU-MSG-AREA
                   MOVE 99 TO COND-WORD
                   PERFORM 2100-BLOWUP
           ELSE
           IF REQNO OF DREQITM-RQ-REC-O NOT = REQ-ARG
               PERFORM 9999-RESET-DREQITM-RQ-O
               MOVE 15 TO COND-WORD.

       9999-RESET-DREQITM-RQ-O.
           MOVE HIGH-VALUES TO REQNO OF DREQITM-RQ-REC-O.
           START DREQITM-RQ-O KEY > REQNO OF DREQITM-RQ-REC-O
               INVALID KEY MOVE "00" TO FILE-STATUS.

       9999-DBDELETE-DREQITM-RQ-O.
           MOVE 0 TO COND-WORD.
           DELETE DREQITM-RQ-O
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE "DBDELETE ERR 9999-DBDELETE-DREQITM-RQ-O"
                   TO BU-MSG-AREA
               MOVE 99 TO COND-WORD
               PERFORM 2100-BLOWUP.

       9999-DBFIND-DREQD-RQ-O.
           MOVE 0 TO COND-WORD.
           MOVE REQ-ARG TO REQNO OF DREQD-RQ-REC-O.
           START DREQD-RQ-O KEY = REQNO OF DREQD-RQ-REC-O
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF (FILE-STATUS NOT = "00") AND (FILE-STATUS-1 NOT = "2")
               MOVE "DBFIND ERR 9999-DBFIND-DREQD-RQ-O"
                   TO BU-MSG-AREA
               MOVE 99 TO COND-WORD
               PERFORM 2100-BLOWUP.

       9999-DBGET5-DREQD-RQ-O.
           MOVE 0 TO COND-WORD.
           READ DREQD-RQ-O NEXT INTO BUF-DREQD
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14"
                   PERFORM 9999-RESET-DREQD-RQ-O
                   MOVE 15 TO COND-WORD
               ELSE
               IF FILE-STATUS = "46"
                   MOVE 15 TO COND-WORD
               ELSE
                   MOVE "DBGET5 ERR 9999-DBGET5-DREQD-RQ-O"
                       TO BU-MSG-AREA
                   MOVE 99 TO COND-WORD
                   PERFORM 2100-BLOWUP
           ELSE
           IF REQNO OF DREQD-RQ-REC-O NOT = REQ-ARG
               PERFORM 9999-RESET-DREQD-RQ-O
               MOVE 15 TO COND-WORD.

       9999-RESET-DREQD-RQ-O.
           MOVE HIGH-VALUES TO REQNO OF DREQD-RQ-REC-O.
           START DREQD-RQ-O KEY > REQNO OF DREQD-RQ-REC-O
               INVALID KEY MOVE "00" TO FILE-STATUS.

       9999-DBDELETE-DREQD-RQ-O.
           MOVE 0 TO COND-WORD.
           DELETE DREQD-RQ-O
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE "DBDELETE ERR 9999-DBDELETE-DREQD-RQ-O"
                   TO BU-MSG-AREA
               MOVE 99 TO COND-WORD
               PERFORM 2100-BLOWUP.

       9999-DBFIND-DREQQUE-RQ-O.
           MOVE 0 TO COND-WORD.
           MOVE REQ-ARG TO REQNO OF DREQQUE-RQ-REC-O.
           START DREQQUE-RQ-O KEY = REQNO OF DREQQUE-RQ-REC-O
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF (FILE-STATUS NOT = "00") AND (FILE-STATUS-1 NOT = "2")
               MOVE "DBFIND ERR 9999-DBFIND-DREQQUE-RQ-O"
                   TO BU-MSG-AREA
               MOVE 99 TO COND-WORD
               PERFORM 2100-BLOWUP.

       9999-DBGET5-DREQQUE-RQ-O.
           MOVE 0 TO COND-WORD.
           READ DREQQUE-RQ-O NEXT INTO BUF-DREQQUE
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14"
                   PERFORM 9999-RESET-DREQQUE-RQ-O
                   MOVE 15 TO COND-WORD
               ELSE
               IF FILE-STATUS = "46"
                   MOVE 15 TO COND-WORD
               ELSE
                   MOVE "DBGET5 ERR 9999-DBGET5-DREQQUE-RQ-O"
                       TO BU-MSG-AREA
                   MOVE 99 TO COND-WORD
                   PERFORM 2100-BLOWUP
           ELSE
           IF REQNO OF DREQQUE-RQ-REC-O NOT = REQ-ARG
               PERFORM 9999-RESET-DREQQUE-RQ-O
               MOVE 15 TO COND-WORD.

       9999-RESET-DREQQUE-RQ-O.
           MOVE HIGH-VALUES TO REQNO OF DREQQUE-RQ-REC-O.
           START DREQQUE-RQ-O KEY > REQNO OF DREQQUE-RQ-REC-O
               INVALID KEY MOVE "00" TO FILE-STATUS.

       9999-DBDELETE-DREQQUE-RQ-O.
           MOVE 0 TO COND-WORD.
           DELETE DREQQUE-RQ-O
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE "DBDELETE ERR 9999-DBDELETE-DREQQUE-RQ-O"
                   TO BU-MSG-AREA
               MOVE 99 TO COND-WORD
               PERFORM 2100-BLOWUP.

       9999-DBFIND-DVENDITM-RQ-O.
           MOVE 0 TO COND-WORD.
           MOVE REQ-ARG TO REQNO OF DVENDITM-RQ-REC-O.
           START DVENDITM-RQ-O KEY = REQNO OF DVENDITM-RQ-REC-O
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF (FILE-STATUS NOT = "00") AND (FILE-STATUS-1 NOT = "2")
               MOVE "DBFIND ERR 9999-DBFIND-DVENDITM-RQ-O"
                   TO BU-MSG-AREA
               MOVE 99 TO COND-WORD
               PERFORM 2100-BLOWUP.

       9999-DBGET5-DVENDITM-RQ-O.
           MOVE 0 TO COND-WORD.
           READ DVENDITM-RQ-O NEXT INTO BUF-DVENDITM
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14"
                   PERFORM 9999-RESET-DVENDITM-RQ-O
                   MOVE 15 TO COND-WORD
               ELSE
               IF FILE-STATUS = "46"
                   MOVE 15 TO COND-WORD
               ELSE
                   MOVE "DBGET5 ERR 9999-DBGET5-DVENDITM-RQ-O"
                       TO BU-MSG-AREA
                   MOVE 99 TO COND-WORD
                   PERFORM 2100-BLOWUP
           ELSE
           IF REQNO OF DVENDITM-RQ-REC-O NOT = REQ-ARG
               PERFORM 9999-RESET-DVENDITM-RQ-O
               MOVE 15 TO COND-WORD.

       9999-RESET-DVENDITM-RQ-O.
           MOVE HIGH-VALUES TO REQNO OF DVENDITM-RQ-REC-O.
           START DVENDITM-RQ-O KEY > REQNO OF DVENDITM-RQ-REC-O
               INVALID KEY MOVE "00" TO FILE-STATUS.

       9999-DBDELETE-DVENDITM-RQ-O.
           MOVE 0 TO COND-WORD.
           DELETE DVENDITM-RQ-O
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE "DBDELETE ERR 9999-DBDELETE-DVENDITM-RQ-O"
                   TO BU-MSG-AREA
               MOVE 99 TO COND-WORD
               PERFORM 2100-BLOWUP.

       9999-OPEN-STUFF.
           OPEN I-O   MREQ-RQ-O             DREQDESC-RQ-O
                      DREQITM-RQ-O          DREQD-RQ-O
                      DREQQUE-RQ-O          DVENDITM-RQ-O        .

       9999-CLOSE-STUFF.
           CLOSE      MREQ-RQ-O             DREQDESC-RQ-O
                      DREQITM-RQ-O          DREQD-RQ-O
                      DREQQUE-RQ-O          DVENDITM-RQ-O        .
