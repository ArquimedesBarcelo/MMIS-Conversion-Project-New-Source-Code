       IDENTIFICATION DIVISION.
       PROGRAM-ID.             TDBMMAST.
       AUTHOR.                 W. ROXBURY.
       INSTALLATION.           GOODYEAR TIRE & RUBBER COMPANY.
       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.
       SOURCE-COMPUTER.        IBM-AS400.
       OBJECT-COMPUTER.        IBM-AS400.
       SPECIAL-NAMES.          C01              IS NEW-PAGE
                               I-O-FEEDBACK     IS I-O-FEEDBACK-AREA
                               REQUESTOR        IS WORK-STATION
                               SYSTEM-CONSOLE   IS CONSOLE
                               LOCAL-DATA       IS LOCAL-DATA-AREA.
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT WO-LAST-NUM-USED
                  ASSIGN       TO DATABASE-MCFPMM0800
                  ORGANIZATION IS SEQUENTIAL
                  ACCESS MODE  IS SEQUENTIAL
                  FILE STATUS  IS FILE-STAT.

           SELECT WO-STATUS
                  ASSIGN       TO DATABASE-MCFPMM0400
                  ORGANIZATION IS SEQUENTIAL
                  ACCESS MODE  IS SEQUENTIAL
                  FILE STATUS  IS FILE-STAT.

           SELECT WO-ZONE-PRTY
                  ASSIGN       TO DATABASE-MCFPMM0500
                  ORGANIZATION IS SEQUENTIAL
                  ACCESS MODE  IS SEQUENTIAL
                  FILE STATUS  IS FILE-STAT.

           SELECT WO-CRAFTS-REQD
                  ASSIGN       TO DATABASE-MCFPMM0600
                  ORGANIZATION IS SEQUENTIAL
                  ACCESS MODE  IS SEQUENTIAL
                  FILE STATUS  IS FILE-STAT.

           SELECT WO-PRT-STATUS
                  ASSIGN       TO DATABASE-MCFPMM0700
                  ORGANIZATION IS SEQUENTIAL
                  ACCESS MODE  IS SEQUENTIAL
                  FILE STATUS  IS FILE-STAT.

           SELECT SHIFT-STRUCTURE
                  ASSIGN       TO DATABASE-MCFPMM2500
                  ORGANIZATION IS SEQUENTIAL
                  ACCESS MODE  IS SEQUENTIAL
                  FILE STATUS  IS FILE-STAT.

           SELECT OUT-FILE
                  ASSIGN       TO DISK-FDBVIEW
                  ORGANIZATION IS RELATIVE
                  ACCESS MODE  IS DYNAMIC
                  RELATIVE KEY IS ACT-KEY
                  FILE STATUS  IS FILE-STAT.

           SELECT SORT-FILE
                  ASSIGN       TO DISK-SORTFILE.

           SELECT PRINT-FILE
                  ASSIGN       TO PRINTER-MCPRT.

       DATA DIVISION.
       FILE SECTION.
       FD  WO-LAST-NUM-USED
           LABEL RECORDS ARE STANDARD.
       01  WO-REC.
           COPY DDS-ALL-FORMATS OF MCFPMM0800.

       FD  WO-STATUS
           LABEL RECORDS ARE STANDARD.
       01  ST-REC.
           COPY DDS-ALL-FORMATS OF MCFPMM0400.

       FD  WO-ZONE-PRTY
           LABEL RECORDS ARE STANDARD.
       01  ZP-REC.
           COPY DDS-ALL-FORMATS OF MCFPMM0500.

       FD  WO-CRAFTS-REQD
           LABEL RECORDS ARE STANDARD.
       01  CR-REC.
           COPY DDS-ALL-FORMATS OF MCFPMM0600.

       FD  WO-PRT-STATUS
           LABEL RECORDS ARE STANDARD.
       01  PS-REC.
           COPY DDS-ALL-FORMATS OF MCFPMM0700.

       FD  SHIFT-STRUCTURE
           LABEL RECORDS ARE STANDARD.
       01  SS-REC.
           COPY DDS-ALL-FORMATS OF MCFPMM2500.

       FD  PRINT-FILE RECORD CONTAINS 80 CHARACTERS
           LABEL RECORDS ARE OMITTED
           DATA RECORD IS PRINT-REC.
       01  PRINT-REC              PIC X(80).

       FD  OUT-FILE RECORD CONTAINS 31 CHARACTERS
           LABEL RECORDS ARE OMITTED
           DATA RECORD IS OUT-REC.
       01  OUT-REC.
           05  OUT-FIELD          PIC X(06).
           05  OUT-DISPLAY.
               10  OUT-2          PIC XX.
               10  OUT-6          PIC X(06).
               10  OUT-1          PIC X.
               10  OUT-4-1        PIC XXXX.
               10  OUT-4-2        PIC XXXX.
               10  OUT-4-3        PIC XXXX.
               10  OUT-4-4        PIC XXXX.

       SD  SORT-FILE RECORD CONTAINS 31 CHARACTERS
           DATA RECORD IS SORT-REC.
       01  SORT-REC.
           05  SORT-FIELD         PIC X(06).
           05  SORT-DISPLAY.
               10  SORT-2         PIC XX.
               10  SORT-6         PIC X(06).
               10  SORT-1         PIC X.
               10  SORT-4-1       PIC XXXX.
               10  SORT-4-2       PIC XXXX.
               10  SORT-4-3       PIC XXXX.
               10  SORT-4-4       PIC XXXX.

       WORKING-STORAGE SECTION.
       77  ACT-KEY                PIC 9999   VALUE 0.
       77  MAX-KEY                PIC 9999   VALUE 0.
       77  EOF-SW                 PIC 9      VALUE 0.
           88  EOF                           VALUE 1.
       77  EOL-SW                 PIC 9      VALUE 0.
           88  EOL                           VALUE 1.
       77  STAT-HOLD              PIC XX.
       77  Z-SAVE                 PIC XXXX   VALUE SPACES.
       77  FNAMEP                 PIC X(8)   VALUE "VIEWDB".

       01  PASSWORD-INFORMATION.
           05  NAME-OF-PROGRAM     PIC X(08) VALUE "TDBMMAST".
           05  PROGRAM-TYPE        PIC X(02) VALUE "RE".
           05  PROGRAM-RELEASE     PIC X(12) VALUE " J0100010001".
           05  PROGRAM-DESCRIPTION.
               10  PROG-DESC-A     PIC X(60) VALUE
                  "DUMPS CERTAIN MASTER FILES TO A PRINTER.".
               10  PROG-DESC-B     PIC X(60) VALUE
                  "                                        ".
               10  PROG-FUNCTION   PIC X(60) VALUE
                  "                                        ".
           05  PASSWORD-FLAG       PIC X VALUE "Y".

       01  FILE-STAT.
           05 FILE-STAT-1      PIC X   VALUE "0".
           05 FILE-STAT-2      PIC X   VALUE "0".

       01  ZP-HOLD.
           05  Z-HOLD           PIC XXXX.
           05  P-HOLD           PIC XX.

       01  CRAFT-HOLD.
           05  C-HOLD           PIC XX.
           05  C-FLAG           PIC X.

       01  DATE-BUFFER.
           05  DB-YY             PIC XX.
           05  DB-MM             PIC XX.
           05  DB-DD             PIC XX.

       01  TIME-BUFFER.
           05  CUR-TIME.
               10  CUR-HRS       PIC XX.
               10  CUR-MINS      PIC XX.
           05  CUR-SECS          PIC XX.
           05  FILLER            PIC XX.

       01  WO-NUM-YEAR.
           05  WO-NUM-BUF       PIC X(06).
           05  WO-YEAR          PIC X.

       01  SINGLE-REC.
           05  FILLER   PIC X(20).
           05  LABEL-1  PIC X(30).
           05  INFO-1   PIC X(20).
           05  FILLER   PIC X(10).

       01  HEADING-DT-TM.
           05  FILLER  PIC X(18) VALUE SPACES.
           05  FILLER  PIC X(13) VALUE "PRINT DATE:  ".
           05  P-DATE.
               10  PD-MM   PIC XX.
               10  FILLER  PIC X   VALUE "/".
               10  PD-DD   PIC XX.
               10  FILLER  PIC X   VALUE "/".
               10  PD-YY   PIC XX.
           05  FILLER  PIC X(15) VALUE "        TIME:  ".
           05  P-HRS   PIC XX.
           05  FILLER  PIC X     VALUE ":".
           05  P-MIN   PIC XX.
           05  FILLER  PIC X     VALUE ":".
           05  P-SEC   PIC XX.
           05  FILLER  PIC X(18) VALUE SPACES.

       01  HEADING-DOTS.
           05  FILLER  PIC X(80) VALUE ALL "*".

       01  HEADING-1.
           05  FILLER      PIC X(12) VALUE SPACES.
           05  FILLER      PIC X(20) VALUE "M M I S A   D A T A ".
           05  FILLER      PIC X(20) VALUE "B A S E   M A S T E ".
           05  FILLER      PIC X(15) VALUE "R   V A L U E S".
           05  FILLER      PIC X(13) VALUE SPACES.

       01  HEADING-2.
           05  FILLER      PIC X(12) VALUE SPACES.
           05  FILLER      PIC X(20) VALUE "V A L I D   W O R K ".
           05  FILLER      PIC X(20) VALUE "O R D E R   S T A T ".
           05  FILLER      PIC X(15) VALUE "U S   L I S T  ".
           05  FILLER      PIC X(13) VALUE SPACES.

       01  HEADING-3.
           05  FILLER      PIC X(12) VALUE SPACES.
           05  FILLER      PIC X(20) VALUE "    V A L I D   Z O ".
           05  FILLER      PIC X(20) VALUE "N E   P R I O R I T ".
           05  FILLER      PIC X(15) VALUE "Y   L I S T    ".
           05  FILLER      PIC X(13) VALUE SPACES.

       01  HEADING-4.
           05  FILLER      PIC X(20) VALUE SPACES.
           05  FILLER      PIC X(20) VALUE "      V A L I D   C ".
           05  FILLER      PIC X(20) VALUE "R A F T   L I S T   ".
           05  FILLER      PIC X(20) VALUE SPACES.

       01  HEADING-5.
           05  FILLER      PIC X(37) VALUE
               "A '1' indicates plant wide (print WO)".
           05  FILLER      PIC X(6)  VALUE SPACES.
           05  FILLER      PIC X(37) VALUE
               "A '2' indicates plant wide (no print)".

       01  HEADING-6.
           05  FILLER      PIC X(12) VALUE SPACES.
           05  FILLER      PIC X(20) VALUE "    V A L I D   P A ".
           05  FILLER      PIC X(20) VALUE "R T S   S T A T U S ".
           05  FILLER      PIC X(15) VALUE "   L I S T     ".
           05  FILLER      PIC X(13) VALUE SPACES.

       01  HEADING-7.
           05  FILLER      PIC X(12) VALUE SPACES.
           05  FILLER      PIC X(20) VALUE "   V A L I D   Z O N".
           05  FILLER      PIC X(20) VALUE " E / S H I F T   S T".
           05  FILLER      PIC X(15) VALUE " R U C T U R E ".
           05  FILLER      PIC X(13) VALUE SPACES.

       01  HEADING-8.
           05  FILLER   PIC X(12)  VALUE SPACES.
           05  FILLER   PIC XXXX   VALUE "ZONE".
           05  FILLER   PIC X(06)  VALUE SPACES.
           05  FILLER   PIC XXXX   VALUE "CODE".
           05  FILLER   PIC X(05)  VALUE SPACES.
           05  FILLER   PIC XXXX   VALUE "1st.".
           05  FILLER   PIC X(07)  VALUE SPACES.
           05  FILLER   PIC XXXX   VALUE "2nd.".
           05  FILLER   PIC X(07)  VALUE SPACES.
           05  FILLER   PIC XXXX   VALUE "3rd.".
           05  FILLER   PIC X(07)  VALUE SPACES.
           05  FILLER   PIC XXXX   VALUE "4th.".
           05  FILLER   PIC X(12)  VALUE SPACES.

       01  DETAIL-STATUS.
           05  FILLER  PIC X(10) VALUE SPACES.
           05  STAT-1  PIC XX.
           05  FILLER  PIC XXX   VALUE SPACES.
           05  STAT-2  PIC XX.
           05  FILLER  PIC XXX   VALUE SPACES.
           05  STAT-3  PIC XX.
           05  FILLER  PIC XXX   VALUE SPACES.
           05  STAT-4  PIC XX.
           05  FILLER  PIC XXX   VALUE SPACES.
           05  STAT-5  PIC XX.
           05  FILLER  PIC XXX   VALUE SPACES.
           05  STAT-6  PIC XX.
           05  FILLER  PIC XXX   VALUE SPACES.
           05  STAT-7  PIC XX.
           05  FILLER  PIC XXX   VALUE SPACES.
           05  STAT-8  PIC XX.
           05  FILLER  PIC XXX   VALUE SPACES.
           05  STAT-9  PIC XX.
           05  FILLER  PIC XXX   VALUE SPACES.
           05  STAT-10 PIC XX.
           05  FILLER  PIC XXX   VALUE SPACES.
           05  STAT-11 PIC XX.
           05  FILLER  PIC XXX   VALUE SPACES.
           05  STAT-12 PIC XX.
           05  FILLER  PIC X(13) VALUE SPACES.

       01  DETAIL-CRAFT.
           05  FILLER   PIC X(10) VALUE SPACES.
           05  CRAFT-1  PIC XXX.
           05  FILLER   PIC XX   VALUE SPACES.
           05  CRAFT-2  PIC XXX.
           05  FILLER   PIC XX   VALUE SPACES.
           05  CRAFT-3  PIC XXX.
           05  FILLER   PIC XX   VALUE SPACES.
           05  CRAFT-4  PIC XXX.
           05  FILLER   PIC XX   VALUE SPACES.
           05  CRAFT-5  PIC XXX.
           05  FILLER   PIC XX   VALUE SPACES.
           05  CRAFT-6  PIC XXX.
           05  FILLER   PIC XX   VALUE SPACES.
           05  CRAFT-7  PIC XXX.
           05  FILLER   PIC XX   VALUE SPACES.
           05  CRAFT-8  PIC XXX.
           05  FILLER   PIC XX   VALUE SPACES.
           05  CRAFT-9  PIC XXX.
           05  FILLER   PIC XX   VALUE SPACES.
           05  CRAFT-10 PIC XXX.
           05  FILLER   PIC XX   VALUE SPACES.
           05  CRAFT-11 PIC XXX.
           05  FILLER   PIC XX   VALUE SPACES.
           05  CRAFT-12 PIC XXX.
           05  FILLER   PIC X(13) VALUE SPACES.

       01  DETAIL-ZONE-PRI.
           05  FILLER   PIC X(11) VALUE SPACES.
           05  ZONEP-1  PIC X(06).
           05  FILLER   PIC X(07) VALUE SPACES.
           05  ZONEP-2  PIC X(06).
           05  FILLER   PIC X(07) VALUE SPACES.
           05  ZONEP-3  PIC X(06).
           05  FILLER   PIC X(07) VALUE SPACES.
           05  ZONEP-4  PIC X(06).
           05  FILLER   PIC X(07) VALUE SPACES.
           05  ZONEP-5  PIC X(06).
           05  FILLER   PIC X(11) VALUE SPACES.

       01  DETAIL-ZONE-SHIFT.
           05  FILLER   PIC X(12).
           05  ZONE-1   PIC XXXX.
           05  FILLER   PIC X(07).
           05  CODE-1   PIC X.
           05  FILLER   PIC X(07).
           05  FRST-T   PIC XXXX.
           05  FILLER   PIC X(07).
           05  SCND-T   PIC XXXX.
           05  FILLER   PIC X(07).
           05  THRD-T   PIC XXXX.
           05  FILLER   PIC X(07).
           05  FRTH-T   PIC XXXX.
           05  FILLER   PIC X(12).

       01  SHIFT-STRUC-DATA.
           COPY MSHFTSTR       IN COPYLIB.

       01  WO-STATUS-DATA.
           COPY MWOSTAT        IN COPYLIB.

       01  ZONE-PRI-DATA.
           COPY MZONPRTY       IN COPYLIB.

       01  CRAFT-DATA.
           COPY MWOCRAFT       IN COPYLIB.

       01  PARTS-DATA.
           COPY MPRTSTAT       IN COPYLIB.

       01  LAST-WO-USED-DATA.
           COPY MLASTWO        IN COPYLIB.

       PROCEDURE DIVISION.
       INITIALIZATION SECTION 01.
       CHECK-PASSWORD.
           CALL "TPWORD" USING PASSWORD-INFORMATION.
           IF PASSWORD-FLAG = "Y"
               GO TO INITIALIZE-FUNCTIONS.
           GOBACK.

       INITIALIZE-FUNCTIONS.
           CALL "CLDBVIEW".
           ACCEPT DATE-BUFFER  FROM DATE.
           MOVE DB-YY          TO PD-YY.
           MOVE DB-MM          TO PD-MM.
           MOVE DB-DD          TO PD-DD.
           ACCEPT TIME-BUFFER  FROM TIME.
           MOVE CUR-HRS        TO P-HRS.
           MOVE CUR-MINS       TO P-MIN.
           MOVE CUR-SECS       TO P-SEC.
           OPEN INPUT          WO-LAST-NUM-USED.
           OPEN INPUT          WO-STATUS.
           OPEN INPUT          WO-ZONE-PRTY.
           OPEN INPUT          WO-CRAFTS-REQD.
           OPEN INPUT          WO-PRT-STATUS.
           OPEN INPUT          SHIFT-STRUCTURE.
           OPEN OUTPUT         PRINT-FILE.

       MAIN-FUNCTIONS.
           MOVE SPACES         TO LAST-WO-USED-DATA.
           OPEN INPUT          WO-LAST-NUM-USED.
           READ WO-LAST-NUM-USED INTO LAST-WO-USED-DATA
               AT END          MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
               DISPLAY "UNABLE TO GET LAST-WO-USED DATA."
                       "    FILE-STATUS = " FILE-STAT
               CLOSE           WO-LAST-NUM-USED
               GO TO END-OF-JOB.
           CLOSE               WO-LAST-NUM-USED.

           MOVE SPACES         TO PRINT-REC.
           WRITE PRINT-REC     AFTER ADVANCING NEW-PAGE.
           MOVE HEADING-DT-TM  TO PRINT-REC.
           WRITE PRINT-REC.
           MOVE HEADING-DOTS   TO PRINT-REC.
           WRITE PRINT-REC     AFTER ADVANCING 2.
           MOVE HEADING-1      TO PRINT-REC.
           WRITE PRINT-REC.
           MOVE HEADING-DOTS   TO PRINT-REC.
           WRITE PRINT-REC.
           MOVE SPACES         TO PRINT-REC.
           WRITE PRINT-REC     AFTER ADVANCING 2.

           MOVE SPACES         TO SINGLE-REC.
           MOVE "  PLANT IDENTIFICATION CODE:  "
                               TO LABEL-1.
           MOVE PLANT-IDENT    TO INFO-1.
           MOVE SINGLE-REC     TO PRINT-REC.
           WRITE PRINT-REC.
           MOVE SPACES         TO PRINT-REC.
           WRITE PRINT-REC.
           MOVE SPACES         TO SINGLE-REC.
           MOVE "          DISPLAY DATE FLAG:  "
                               TO LABEL-1.
           MOVE DATE-FLAG-SW   TO INFO-1.
           MOVE SINGLE-REC     TO PRINT-REC.
           WRITE PRINT-REC.
           MOVE SPACES         TO PRINT-REC.
           WRITE PRINT-REC.
           MOVE SPACES         TO SINGLE-REC.
           MOVE " LAST WORKORDER NUMBER USED:  "
                               TO LABEL-1.
           MOVE LAST-WO-NO     TO WO-NUM-BUF.
           MOVE LYU-X          TO WO-YEAR.
           MOVE WO-NUM-YEAR    TO INFO-1.
           MOVE SINGLE-REC     TO PRINT-REC.
           WRITE PRINT-REC.
           MOVE HEADING-DOTS   TO PRINT-REC.
           WRITE PRINT-REC     AFTER ADVANCING 2.

       STATUS-MASTER.
           MOVE 0              TO EOF-SW.
           MOVE HEADING-2      TO PRINT-REC.
           WRITE PRINT-REC     AFTER ADVANCING 2.
           SORT SORT-FILE ASCENDING KEY SORT-FIELD
               INPUT PROCEDURE SORT-STATUS-IN
               OUTPUT PROCEDURE SORT-STATUS-OUT.
           MOVE 0              TO ACT-KEY.
           OPEN INPUT          OUT-FILE.

       DISPLAY-STATUS.
           MOVE SPACES         TO DETAIL-STATUS.
           PERFORM READ-STATUS THRU RS-EXIT.
           IF EOF GO TO PRINT-STATUS.
           MOVE STAT-HOLD      TO STAT-1.
           PERFORM READ-STATUS THRU RS-EXIT.
           IF EOF GO TO PRINT-STATUS.
           MOVE STAT-HOLD      TO STAT-2.
           PERFORM READ-STATUS THRU RS-EXIT.
           IF EOF GO TO PRINT-STATUS.
           MOVE STAT-HOLD      TO STAT-3.
           PERFORM READ-STATUS THRU RS-EXIT.
           IF EOF GO TO PRINT-STATUS.
           MOVE STAT-HOLD      TO STAT-4.
           PERFORM READ-STATUS THRU RS-EXIT.
           IF EOF GO TO PRINT-STATUS.
           MOVE STAT-HOLD      TO STAT-5.
           PERFORM READ-STATUS THRU RS-EXIT.
           IF EOF GO TO PRINT-STATUS.
           MOVE STAT-HOLD      TO STAT-6.
           PERFORM READ-STATUS THRU RS-EXIT.
           IF EOF GO TO PRINT-STATUS.
           MOVE STAT-HOLD      TO STAT-7.
           PERFORM READ-STATUS THRU RS-EXIT.
           IF EOF GO TO PRINT-STATUS.
           MOVE STAT-HOLD      TO STAT-8.
           PERFORM READ-STATUS THRU RS-EXIT.
           IF EOF GO TO PRINT-STATUS.
           MOVE STAT-HOLD      TO STAT-9.
           PERFORM READ-STATUS THRU RS-EXIT.
           IF EOF GO TO PRINT-STATUS.
           MOVE STAT-HOLD      TO STAT-10.
           PERFORM READ-STATUS THRU RS-EXIT.
           IF EOF GO TO PRINT-STATUS.
           MOVE STAT-HOLD      TO STAT-11.
           PERFORM READ-STATUS THRU RS-EXIT.
           IF EOF GO TO PRINT-STATUS.
           MOVE STAT-HOLD      TO STAT-12.

       PRINT-STATUS.
           MOVE DETAIL-STATUS  TO PRINT-REC.
           WRITE PRINT-REC     AFTER ADVANCING 2.
           IF EOF NEXT SENTENCE
               ELSE GO TO DISPLAY-STATUS.
           MOVE HEADING-DOTS   TO PRINT-REC.
           WRITE PRINT-REC     AFTER ADVANCING 2.

       ZONE-PRIORITY-MASTER.
           CLOSE               OUT-FILE.
           MOVE 0              TO EOF-SW.
           MOVE HEADING-3      TO PRINT-REC.
           WRITE PRINT-REC     AFTER ADVANCING 2.
           SORT SORT-FILE ASCENDING KEY SORT-FIELD
               INPUT PROCEDURE SORT-ZONE-PRI-IN
               OUTPUT PROCEDURE SORT-ZONE-PRI-OUT.
           MOVE 0              TO ACT-KEY.
           OPEN INPUT          OUT-FILE.

       DISPLAY-ZONE-PRI.
           MOVE SPACES         TO DETAIL-ZONE-PRI.
           PERFORM READ-ZONE-PRI THRU RZP-EXIT.
           IF EOF OR EOL GO TO PRINT-ZONE-PRI.
           MOVE ZP-HOLD        TO ZONEP-1.
           PERFORM READ-ZONE-PRI THRU RZP-EXIT.
           IF EOF OR EOL GO TO PRINT-ZONE-PRI.
           MOVE ZP-HOLD        TO ZONEP-2.
           PERFORM READ-ZONE-PRI THRU RZP-EXIT.
           IF EOF OR EOL GO TO PRINT-ZONE-PRI.
           MOVE ZP-HOLD        TO ZONEP-3.
           PERFORM READ-ZONE-PRI THRU RZP-EXIT.
           IF EOF OR EOL GO TO PRINT-ZONE-PRI.
           MOVE ZP-HOLD        TO ZONEP-4.
           PERFORM READ-ZONE-PRI THRU RZP-EXIT.
           IF EOF OR EOL GO TO PRINT-ZONE-PRI.
           MOVE ZP-HOLD        TO ZONEP-5.

       PRINT-ZONE-PRI.
           IF EOL
               MOVE 0          TO EOL-SW
               SUBTRACT 1      FROM ACT-KEY.
           MOVE DETAIL-ZONE-PRI TO PRINT-REC.
           WRITE PRINT-REC.
           IF EOF NEXT SENTENCE
               ELSE GO TO DISPLAY-ZONE-PRI.
           MOVE HEADING-DOTS   TO PRINT-REC.
           WRITE PRINT-REC     AFTER ADVANCING 2.

       CRAFT-MASTER.
           CLOSE               OUT-FILE.
           MOVE 0              TO EOF-SW.
           MOVE HEADING-4      TO PRINT-REC.
           WRITE PRINT-REC     AFTER ADVANCING 2.
           SORT SORT-FILE ASCENDING KEY SORT-FIELD
               INPUT PROCEDURE SORT-CRAFT-IN
               OUTPUT PROCEDURE SORT-CRAFT-OUT.
           MOVE 0              TO ACT-KEY.
           OPEN INPUT          OUT-FILE.

       DISPLAY-CRAFT.
           MOVE SPACES         TO DETAIL-CRAFT.
           PERFORM READ-CRAFT THRU RC-EXIT.
           IF EOF GO TO PRINT-CRAFT.
           MOVE CRAFT-HOLD     TO CRAFT-1.
           PERFORM READ-CRAFT THRU RC-EXIT.
           IF EOF GO TO PRINT-CRAFT.
           MOVE CRAFT-HOLD     TO CRAFT-2.
           PERFORM READ-CRAFT THRU RC-EXIT.
           IF EOF GO TO PRINT-CRAFT.
           MOVE CRAFT-HOLD     TO CRAFT-3.
           PERFORM READ-CRAFT THRU RC-EXIT.
           IF EOF GO TO PRINT-CRAFT.
           MOVE CRAFT-HOLD     TO CRAFT-4.
           PERFORM READ-CRAFT THRU RC-EXIT.
           IF EOF GO TO PRINT-CRAFT.
           MOVE CRAFT-HOLD     TO CRAFT-5.
           PERFORM READ-CRAFT THRU RC-EXIT.
           IF EOF GO TO PRINT-CRAFT.
           MOVE CRAFT-HOLD     TO CRAFT-6.
           PERFORM READ-CRAFT THRU RC-EXIT.
           IF EOF GO TO PRINT-CRAFT.
           MOVE CRAFT-HOLD     TO CRAFT-7.
           PERFORM READ-CRAFT THRU RC-EXIT.
           IF EOF GO TO PRINT-CRAFT.
           MOVE CRAFT-HOLD     TO CRAFT-8.
           PERFORM READ-CRAFT THRU RC-EXIT.
           IF EOF GO TO PRINT-CRAFT.
           MOVE CRAFT-HOLD     TO CRAFT-9.
           PERFORM READ-CRAFT THRU RC-EXIT.
           IF EOF GO TO PRINT-CRAFT.
           MOVE CRAFT-HOLD     TO CRAFT-10.
           PERFORM READ-CRAFT THRU RC-EXIT.
           IF EOF GO TO PRINT-CRAFT.
           MOVE CRAFT-HOLD     TO CRAFT-11.
           PERFORM READ-CRAFT THRU RC-EXIT.
           IF EOF GO TO PRINT-CRAFT.
           MOVE CRAFT-HOLD     TO CRAFT-12.

       PRINT-CRAFT.
           MOVE DETAIL-CRAFT   TO PRINT-REC.
           WRITE PRINT-REC     AFTER ADVANCING 2.
           IF EOF NEXT SENTENCE
               ELSE GO TO DISPLAY-CRAFT.
           MOVE HEADING-5      TO PRINT-REC.
           WRITE PRINT-REC     AFTER ADVANCING 2.
           MOVE HEADING-DOTS   TO PRINT-REC.
           WRITE PRINT-REC     AFTER ADVANCING 2.

       PRT-STATUS-MASTER.
           CLOSE               OUT-FILE.
           MOVE 0              TO EOF-SW.
           MOVE HEADING-6      TO PRINT-REC.
           WRITE PRINT-REC     AFTER ADVANCING 2.
           SORT SORT-FILE ASCENDING KEY SORT-FIELD
               INPUT PROCEDURE SORT-PRT-STATUS-IN
               OUTPUT PROCEDURE SORT-PRT-STATUS-OUT.
           MOVE 0              TO ACT-KEY.
           OPEN INPUT          OUT-FILE.

       DISPLAY-PRT-STATUS.
           MOVE SPACES         TO DETAIL-STATUS.
           PERFORM READ-STATUS THRU RS-EXIT.
           IF EOF GO TO PRINT-PRT-STATUS.
           MOVE STAT-HOLD      TO STAT-1.
           PERFORM READ-STATUS THRU RS-EXIT.
           IF EOF GO TO PRINT-PRT-STATUS.
           MOVE STAT-HOLD      TO STAT-2.
           PERFORM READ-STATUS THRU RS-EXIT.
           IF EOF GO TO PRINT-PRT-STATUS.
           MOVE STAT-HOLD      TO STAT-3.
           PERFORM READ-STATUS THRU RS-EXIT.
           IF EOF GO TO PRINT-PRT-STATUS.
           MOVE STAT-HOLD      TO STAT-4.
           PERFORM READ-STATUS THRU RS-EXIT.
           IF EOF GO TO PRINT-PRT-STATUS.
           MOVE STAT-HOLD      TO STAT-5.
           PERFORM READ-STATUS THRU RS-EXIT.
           IF EOF GO TO PRINT-PRT-STATUS.
           MOVE STAT-HOLD      TO STAT-6.
           PERFORM READ-STATUS THRU RS-EXIT.
           IF EOF GO TO PRINT-PRT-STATUS.
           MOVE STAT-HOLD      TO STAT-7.
           PERFORM READ-STATUS THRU RS-EXIT.
           IF EOF GO TO PRINT-PRT-STATUS.
           MOVE STAT-HOLD      TO STAT-8.
           PERFORM READ-STATUS THRU RS-EXIT.
           IF EOF GO TO PRINT-PRT-STATUS.
           MOVE STAT-HOLD      TO STAT-9.
           PERFORM READ-STATUS THRU RS-EXIT.
           IF EOF GO TO PRINT-PRT-STATUS.
           MOVE STAT-HOLD      TO STAT-10.
           PERFORM READ-STATUS THRU RS-EXIT.
           IF EOF GO TO PRINT-PRT-STATUS.
           MOVE STAT-HOLD      TO STAT-11.
           PERFORM READ-STATUS THRU RS-EXIT.
           IF EOF GO TO PRINT-PRT-STATUS.
           MOVE STAT-HOLD      TO STAT-12.

       PRINT-PRT-STATUS.
           MOVE DETAIL-STATUS  TO PRINT-REC.
           WRITE PRINT-REC     AFTER ADVANCING 2.
           IF EOF NEXT SENTENCE
               ELSE GO TO DISPLAY-PRT-STATUS.
           MOVE HEADING-DOTS   TO PRINT-REC.
           WRITE PRINT-REC     AFTER ADVANCING 2.

       ZONE-SHIFT-MASTER.
           CLOSE               OUT-FILE.
           MOVE 0              TO EOF-SW.
           MOVE HEADING-7      TO PRINT-REC.
           WRITE PRINT-REC     AFTER ADVANCING 2.
           MOVE HEADING-8      TO PRINT-REC.
           WRITE PRINT-REC     AFTER ADVANCING 2.
           SORT SORT-FILE ASCENDING KEY SORT-FIELD
               INPUT PROCEDURE SORT-ZONE-SHIFT-IN
               OUTPUT PROCEDURE SORT-ZONE-SHIFT-OUT.
           MOVE 0              TO ACT-KEY.
           OPEN INPUT          OUT-FILE.
           PERFORM READ-ZONE-SHIFT THRU RZS-EXIT UNTIL EOF.

       END-OF-JOB.
           MOVE HEADING-DOTS   TO PRINT-REC.
           WRITE PRINT-REC     AFTER ADVANCING 2.
           CLOSE               WO-LAST-NUM-USED.
           CLOSE               WO-STATUS.
           CLOSE               WO-ZONE-PRTY.
           CLOSE               WO-CRAFTS-REQD.
           CLOSE               WO-PRT-STATUS.
           CLOSE               SHIFT-STRUCTURE.
           CLOSE               PRINT-FILE.
           CLOSE               OUT-FILE.
           GOBACK.

       READ-STATUS.
           ADD 1               TO ACT-KEY.
           MOVE SPACES         TO OUT-REC.
           READ OUT-FILE       INVALID KEY
               MOVE 1          TO EOF-SW
               GO TO RS-EXIT.
           IF ACT-KEY > MAX-KEY
               MOVE 1          TO EOF-SW
               GO TO RS-EXIT.
           MOVE OUT-2          TO STAT-HOLD.

       RS-EXIT.    EXIT.

       READ-ZONE-PRI.
           ADD 1               TO ACT-KEY.
           MOVE SPACES         TO OUT-REC.
           READ OUT-FILE       INVALID KEY
               MOVE 1          TO EOF-SW
               GO TO RZP-EXIT.
           IF ACT-KEY > MAX-KEY
               MOVE 1          TO EOF-SW
               GO TO RZP-EXIT.
           MOVE OUT-6          TO ZP-HOLD.
           IF Z-HOLD = Z-SAVE
               NEXT SENTENCE
           ELSE
               MOVE Z-HOLD     TO Z-SAVE
               MOVE 1          TO EOL-SW.

       RZP-EXIT.    EXIT.

       READ-CRAFT.
           ADD 1               TO ACT-KEY.
           MOVE SPACES         TO OUT-REC.
           READ OUT-FILE       INVALID KEY
               MOVE 1          TO EOF-SW
               GO TO RC-EXIT.
           IF ACT-KEY > MAX-KEY
               MOVE 1          TO EOF-SW
               GO TO RC-EXIT.
           MOVE OUT-2          TO C-HOLD.
           MOVE OUT-1          TO C-FLAG.

       RC-EXIT.    EXIT.

       READ-ZONE-SHIFT.
           ADD 1               TO ACT-KEY.
           MOVE SPACES         TO OUT-REC DETAIL-ZONE-SHIFT.
           READ OUT-FILE       INVALID KEY
               MOVE 1          TO EOF-SW
               GO TO RZS-EXIT.
           IF ACT-KEY > MAX-KEY
               MOVE 1          TO EOF-SW
               GO TO RZS-EXIT.
           MOVE OUT-6          TO ZONE-1.
           MOVE OUT-1          TO CODE-1.
           MOVE OUT-4-1        TO FRST-T.
           MOVE OUT-4-2        TO SCND-T.
           MOVE OUT-4-3        TO THRD-T.
           MOVE OUT-4-4        TO FRTH-T.
           MOVE DETAIL-ZONE-SHIFT TO PRINT-REC.
           WRITE PRINT-REC     AFTER ADVANCING 2.

       RZS-EXIT.    EXIT.

       SORT-STATUS-IN SECTION 02.
           MOVE 0              TO ACT-KEY.
           PERFORM SORT-DBGET-S THRU SORT-S-EXIT.
           GO TO SORT-IP-S-EXIT.

       SORT-DBGET-S.
           MOVE SPACES         TO SORT-REC.
           ADD 1               TO ACT-KEY.
           READ WO-STATUS      INTO WO-STATUS-DATA
               AT END          MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
               GO TO SORT-S-EXIT.

           MOVE WO-STATUS-MSTR TO SORT-FIELD SORT-2.
           RELEASE SORT-REC.
           GO TO SORT-DBGET-S.

       SORT-S-EXIT.    EXIT.

       SORT-IP-S-EXIT.    EXIT.

       SORT-STATUS-OUT SECTION 03.
           MOVE 0              TO ACT-KEY.
           OPEN OUTPUT         OUT-FILE.
           PERFORM SORT-SO-LOOP THRU SORT-SORL-EXIT.
           CLOSE               OUT-FILE.
           GO TO SORT-SO-EXIT.

       SORT-SO-LOOP.
           RETURN SORT-FILE AT END
               MOVE ACT-KEY    TO MAX-KEY
               GO TO SORT-SORL-EXIT.
           ADD 1               TO ACT-KEY.
           MOVE SORT-REC       TO OUT-REC.
           WRITE OUT-REC       INVALID KEY
               DISPLAY "WRITE OUT-FILE ERR"
               GO TO SORT-SORL-EXIT.
           GO TO SORT-SO-LOOP.

       SORT-SORL-EXIT.    EXIT.

       SORT-SO-EXIT.    EXIT.

       SORT-ZONE-PRI-IN SECTION 04.
           MOVE 0              TO ACT-KEY.
           PERFORM SORT-DBGET-ZP THRU SORT-ZP-EXIT.
           GO TO SORT-IP-ZP-EXIT.

       SORT-DBGET-ZP.
           MOVE SPACES         TO SORT-REC.
           ADD 1               TO ACT-KEY.
           READ WO-ZONE-PRTY   INTO ZONE-PRI-DATA
               AT END          MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
               GO TO SORT-ZP-EXIT.

           MOVE ZONE-PRTY-FIELD TO SORT-FIELD SORT-6.
           RELEASE SORT-REC.
           GO TO SORT-DBGET-ZP.

       SORT-ZP-EXIT.    EXIT.

       SORT-IP-ZP-EXIT.    EXIT.

       SORT-ZONE-PRI-OUT SECTION 05.
           MOVE 0              TO ACT-KEY.
           OPEN OUTPUT         OUT-FILE.
           PERFORM SORT-ZP-LOOP THRU SORT-ZPRL-EXIT.
           CLOSE               OUT-FILE.
           GO TO SORT-ZPO-EXIT.

       SORT-ZP-LOOP.
           RETURN SORT-FILE AT END
               MOVE ACT-KEY    TO MAX-KEY
               GO TO SORT-ZPRL-EXIT.
           ADD 1               TO ACT-KEY.
           MOVE SORT-REC       TO OUT-REC.
           WRITE OUT-REC       INVALID KEY
               DISPLAY "WRITE OUT-FILE ERR"
               GO TO SORT-ZPRL-EXIT.
           GO TO SORT-ZP-LOOP.

       SORT-ZPRL-EXIT.    EXIT.

       SORT-ZPO-EXIT.    EXIT.

       SORT-CRAFT-IN SECTION 06.
           MOVE 0              TO ACT-KEY.
           PERFORM SORT-DBGET-C THRU SORT-C-EXIT.
           GO TO SORT-IP-C-EXIT.

       SORT-DBGET-C.
           MOVE SPACES         TO SORT-REC.
           ADD 1               TO ACT-KEY.
           READ WO-CRAFTS-REQD INTO CRAFT-DATA
               AT END          MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
               GO TO SORT-C-EXIT.

           MOVE CRAFT-MSTR     TO SORT-FIELD SORT-2.
           IF CRAFT-FLAG = "1"
               MOVE "1"        TO SORT-1.
           IF CRAFT-FLAG = "2"
               MOVE "2"        TO SORT-1.
           RELEASE SORT-REC.
           GO TO SORT-DBGET-C.

       SORT-C-EXIT.    EXIT.

       SORT-IP-C-EXIT.    EXIT.

       SORT-CRAFT-OUT SECTION 07.
           MOVE 0              TO ACT-KEY.
           OPEN OUTPUT         OUT-FILE.
           PERFORM SORT-CR-LOOP THRU SORT-CRRL-EXIT.
           CLOSE               OUT-FILE.
           GO TO SORT-CO-EXIT.

       SORT-CR-LOOP.
           RETURN SORT-FILE AT END
               MOVE ACT-KEY    TO MAX-KEY
               GO TO SORT-CRRL-EXIT.
           ADD 1               TO ACT-KEY.
           MOVE SORT-REC       TO OUT-REC.
           WRITE OUT-REC       INVALID KEY
               DISPLAY "WRITE OUT-FILE ERR"
               GO TO SORT-CRRL-EXIT.
           GO TO SORT-CR-LOOP.

       SORT-CRRL-EXIT.    EXIT.

       SORT-CO-EXIT.    EXIT.

       SORT-PRT-STATUS-IN SECTION 08.
           MOVE 0              TO ACT-KEY.
           PERFORM SORT-DBGET-PS THRU SORT-PS-EXIT.
           GO TO SORT-IP-PS-EXIT.

       SORT-DBGET-PS.
           MOVE SPACES         TO SORT-REC.
           ADD 1               TO ACT-KEY.
           READ WO-PRT-STATUS  INTO PARTS-DATA
               AT END          MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
               GO TO SORT-PS-EXIT.

           MOVE PART-STATUS-MSTR TO SORT-FIELD SORT-2.
           RELEASE SORT-REC.
           GO TO SORT-DBGET-PS.

       SORT-PS-EXIT.    EXIT.

       SORT-IP-PS-EXIT.    EXIT.

       SORT-PRT-STATUS-OUT SECTION 09.
           MOVE 0              TO ACT-KEY.
           OPEN OUTPUT         OUT-FILE.
           PERFORM SORT-PS-LOOP THRU SORT-PSRL-EXIT.
           CLOSE               OUT-FILE.
           GO TO SORT-PS-EXIT.

       SORT-PS-LOOP.
           RETURN SORT-FILE AT END
               MOVE ACT-KEY    TO MAX-KEY
               GO TO SORT-PSRL-EXIT.
           ADD 1               TO ACT-KEY.
           MOVE SORT-REC       TO OUT-REC.
           WRITE OUT-REC       INVALID KEY
               DISPLAY "WRITE OUT-FILE ERR"
               GO TO SORT-PSRL-EXIT.
           GO TO SORT-PS-LOOP.

       SORT-PSRL-EXIT.    EXIT.

       SORT-PS-EXIT.    EXIT.

       SORT-ZONE-SHIFT-IN SECTION 10.
           MOVE 0              TO ACT-KEY.
           PERFORM SORT-DBGET-ZS THRU SORT-ZS-EXIT.
           GO TO SORT-IP-ZS-EXIT.

       SORT-DBGET-ZS.
           MOVE SPACES         TO SORT-REC.
           ADD 1               TO ACT-KEY.
           READ SHIFT-STRUCTURE INTO SHIFT-STRUC-DATA
               AT END          MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
               GO TO SORT-ZS-EXIT.

           MOVE SHIFT-ZONE     TO SORT-FIELD SORT-6.
           MOVE CODE-VALUE     TO SORT-1.
           MOVE FRST-SHIFT     TO SORT-4-1.
           MOVE SCND-SHIFT     TO SORT-4-2.
           MOVE THRD-SHIFT     TO SORT-4-3.
           MOVE FRTH-SHIFT     TO SORT-4-4.
           RELEASE SORT-REC.
           GO TO SORT-DBGET-ZS.

       SORT-ZS-EXIT.    EXIT.

       SORT-IP-ZS-EXIT.    EXIT.

       SORT-ZONE-SHIFT-OUT SECTION 11.
           MOVE 0              TO ACT-KEY.
           OPEN OUTPUT         OUT-FILE.
           PERFORM SORT-ZS-LOOP THRU SORT-ZSRL-EXIT.
           CLOSE               OUT-FILE.
           GO TO SORT-ZS-EXIT.

       SORT-ZS-LOOP.
           RETURN SORT-FILE AT END
               MOVE ACT-KEY    TO MAX-KEY
               GO TO SORT-ZSRL-EXIT.
           ADD 1               TO ACT-KEY.
           MOVE SORT-REC       TO OUT-REC.
           WRITE OUT-REC       INVALID KEY
               DISPLAY "WRITE OUT-FILE ERR"
               GO TO SORT-ZSRL-EXIT.
           GO TO SORT-ZS-LOOP.

       SORT-ZSRL-EXIT.         EXIT.

       SORT-ZS-EXIT.           EXIT.

