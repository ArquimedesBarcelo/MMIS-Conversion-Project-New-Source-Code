       IDENTIFICATION DIVISION.
       PROGRAM-ID. TPRTSNGL.
       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.
       SOURCE-COMPUTER.   AS400.
       OBJECT-COMPUTER.   AS400.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       COPY CATREAD  OF COPYLIB.
       01  DBPARAMETERS.       COPY DBPARMS OF COPYLIB.
       01  ERROR-SWITCH               PIC S9(4) COMP-4.
       01  PASSWORD-INFORMATION.
           05  NAME-OF-PROGRAM     PIC X(08) VALUE "TPRTSNGL".
           05  PROGRAM-TYPE        PIC X(02) VALUE "RE".
           05  PROGRAM-RELEASE     PIC X(12) VALUE " E0100010001".
           05  PROGRAM-DESCRIPTION.
               10  PROG-DESC-A     PIC X(60) VALUE
                   "SINGLE WORKSHEET PRINT PROGRAM EXECUTIVE "         .
               10  PROG-DESC-B     PIC X(60) VALUE SPACES.
               10  PROG-FUNCTION   PIC X(60) VALUE SPACES.
           05  PASSWORD-FLAG       PIC X.
       COPY SCREENIO OF COPYLIB.
       01  WO-PLANNED-DATA.    COPY DWOPLAN OF COPYLIB.
       PROCEDURE DIVISION.
       START-PGM.
           PERFORM 1-HSK.
           PERFORM 6-MAIN.
       2-EOJ.
           GOBACK.
       1-HSK.
           CALL "TPWORD" USING PASSWORD-INFORMATION.
           IF PASSWORD-FLAG = "N" GO TO 2-EOJ.
           MOVE SPACES TO SCREEN-PARMS.
           MOVE "ZPLANNER" TO SCREEN-FILE.
           MOVE "Y" TO SCREEN-SW.
           MOVE ALL B"0" TO SCREEN-INDICATORS.
       6-MAIN.
            MOVE SPACES TO WO-PLANNED-DATA CATREAD-PARMS.
            CALL "TPRINTWS" USING DBPARAMETERS
                                  WO-PLANNED-DATA
                                  ERROR-SWITCH
                                  SCREEN-PARMS
                                  CATREAD-PARMS.
