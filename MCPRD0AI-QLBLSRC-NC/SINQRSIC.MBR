000400 AUTHOR.        JEFF BUNGO.
000500 DATE-WRITTEN.  JUNE 10, 1994.
000600 DATE-COMPILED.
000700*REMARKS.       SUBROUTINE SHOWS RECEIVING SLIP CORRECTION DATA.
000800*************************************************************
000900*************************************************************
001000*                      S I N Q R S I C                      *
001100*                                                           *
001200*    THIS SUBROUTINE SHOWS ALL ITEM CORRECTION INFO FOR     *
001300*    ON A RECEIVING SLIP.  CORRECTIONS MAY BE BROWSED       *
001400*    FORWARD AND BACKWARD.                                  *
003500*************************************************************
003600*    CALLING PROGRAMS:                                      *
003700*       1.  SRSINQS  -  MAIN SUBROUTINE FOR RS INQUIRY      *
003900*************************************************************
      *C 06/07/96  JEFF BUNGO
      *C   EXPAND DATE FIELDS FOR YEAR 2000 COMPLIANCE.
      *C   RECOMPILE TO PICK UP NEW FILE FORMATS.
      *C---------------------------------------------------------------
DCR01 *C MAR 10, 2005  D.RAUCH       DCR01    REQUEST# 2005-78515
DCR01 *C    DISPLAY FILE PROCESSING CHANGED FROM USING ZCSISINQ
DCR01 *C    NEW DISPLAY FILE ZSINQRSIC CREATED - FORMATS COPIED
DCR01 *C    FROM ZCSISINQ.
DCR01 *****************************************************************

004100 ENVIRONMENT DIVISION.
004200 CONFIGURATION SECTION.
004300 SOURCE-COMPUTER.    HP-3000.
004400 OBJECT-COMPUTER.    HP-3000.
       SPECIAL-NAMES.  I-O-FEEDBACK IS I-O-FEEDBACK-AREA.
004500 INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT DISPLAY-FILE
                  ASSIGN TO WORKSTATION-ZSINQRSIC-SI
                  ORGANIZATION IS TRANSACTION
                  ACCESS IS DYNAMIC
                  RELATIVE KEY IS RELATIVE-RECNO
                  FILE STATUS IS DISPLAY-STATUS
                  CONTROL-AREA IS WS-CONTROL.
             SELECT MPORCV
               ASSIGN TO DATABASE-MCFLCS0101
               ORGANIZATION IS INDEXED
                  ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
               FILE STATUS IS FILE-STATUS.
             SELECT DRCVITEM
               ASSIGN TO DATABASE-MCFLCS1201
               ORGANIZATION IS INDEXED
                  ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY WITH DUPLICATES
               FILE STATUS IS FILE-STATUS.
             SELECT DRCVCORR
               ASSIGN TO DATABASE-MCFLCS5401
               ORGANIZATION IS INDEXED
                  ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY WITH DUPLICATES
               FILE STATUS IS FILE-STATUS.
             SELECT DRCVITEM-ST
               ASSIGN TO DATABASE-MCFLST0601
               ORGANIZATION IS INDEXED
                  ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY WITH DUPLICATES
               FILE STATUS IS FILE-STATUS.
             SELECT DRCVCORR-ST
               ASSIGN TO DATABASE-MCFLST5401
               ORGANIZATION IS INDEXED
                  ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY WITH DUPLICATES
               FILE STATUS IS FILE-STATUS.
004600 DATA DIVISION.
004700 FILE SECTION.
       FD  DISPLAY-FILE
           LABEL RECORDS ARE OMITTED.
       01  DISPLAY-REC          PIC X(2000).

       FD  MPORCV
           LABEL RECORDS ARE STANDARD.
       01  MPORCV-REC.
           COPY DDS-MCRPCS0100  OF MCFLCS0101.

       FD  DRCVITEM
           LABEL RECORDS ARE STANDARD.
       01  DRCVITEM-REC.
           COPY DDS-MCRPCS1200  OF MCFLCS1201.

       FD  DRCVCORR
           LABEL RECORDS ARE STANDARD.
       01  DRCVCORR-REC.
           COPY DDS-MCRPCS5400  OF MCFLCS5401.

       FD  DRCVITEM-ST
           LABEL RECORDS ARE STANDARD.
       01  DRCVITEM-ST-REC.
           COPY DDS-MCRPST0600  OF MCFLST0601.
       FD  DRCVCORR-ST
           LABEL RECORDS ARE STANDARD.
       01  DRCVCORR-ST-REC.
           COPY DDS-MCRPST5400  OF MCFLST5401.
004800*************************************************************
