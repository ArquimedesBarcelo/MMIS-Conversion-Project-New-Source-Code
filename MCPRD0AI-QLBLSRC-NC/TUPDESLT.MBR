       IDENTIFICATION DIVISION.
       PROGRAM-ID.        TUPDESLT.
       AUTHOR.            CA YODER.
       DATE-WRITTEN.      AUGUST 1995.
       DATE-COMPILED.
      *INSTALLATION.      THE GOODYEAR TIRE & RUBBER COMPANY.
      *REMARKS.
      *
      ******************************************************************
      *D   S U P D E S L T  --  UPDATE ESTIMATED LEAD TIME IN MSTORERM *
      *D     THIS PROGRAM IS CALLED FROM BSHIPTOP.  IT READS THROUGH   *
      *D     THE RECORDS IN MSTORERM AND UPDATES THE ESTIMATED LEAD    *
      *D     TIME FIELD (SHIP TIME) WITH THE VALUE IN MPLTINFO.  USES  *
      *D     FILE SHIPTMFL (SHIP TIME FILE) TO PRINT THE REPORT OF ALL *
      *D     THE CODES THAT WERE CHANGED.                              *
      ******************************************************************
      *                                                                *
      *  C H A N G E S :                                               *
      *                                                                *
      *C   06/19/1996   CA YODER                                       *
      *C   RE-COMPILED TO PICK UP CENTURY DATABASE CHANGES.            *
      *C                                                               *
      *                                                                *
      ******************************************************************

       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.
       SOURCE-COMPUTER.     IBM-AS400.
       OBJECT-COMPUTER.     IBM-AS400.

       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT MSTORERM-IO
               ASSIGN        TO DATABASE-MCFLCS0201
               ORGANIZATION  IS INDEXED
               ACCESS MODE   IS DYNAMIC
               RECORD KEY    IS EXTERNALLY-DESCRIBED-KEY
               FILE STATUS   IS FILE-STATUS.

           SELECT MPLTINFO-IO
               ASSIGN        TO DATABASE-MCFLCS0501
               ORGANIZATION  IS INDEXED
               ACCESS MODE   IS DYNAMIC
               RECORD KEY    IS EXTERNALLY-DESCRIBED-KEY
               FILE STATUS   IS FILE-STATUS.

           SELECT REPORT-FILE
               ASSIGN TO DISK-SHIPTMFL.

       DATA DIVISION.
       FILE SECTION.
       FD  MSTORERM-IO
           LABEL RECORDS ARE STANDARD.
       01  MSTORERM-REC-IO.
           COPY DDS-MCRPCS0200  OF MCFLCS0201.

       FD  MPLTINFO-IO
           LABEL RECORDS ARE STANDARD.
       01  MPLTINFO-REC-IO.
           COPY DDS-MCRPCS0500  OF MCFLCS0501.

       FD  REPORT-FILE
           DATA RECORD IS REPORT-FILE-REC
           RECORD CONTAINS 133 CHARACTERS
           LABEL RECORDS ARE OMITTED.
       01  REPORT-FILE-REC.
           05  RPT-CTL          PIC X.
           05  RPT-LINE         PIC X(132).

       WORKING-STORAGE SECTION.

      *----------------------------------------------------------------*
      *             D A T A B A S E   B U F F E R S                    *
      *----------------------------------------------------------------*

       COPY MPLT0      IN COPYLIB.

       COPY MPLTPOPT   IN COPYLIB.

       COPY MSTORERM   IN COPYLIB.

      *----------------------------------------------------------------*
      *                    H O L D   A R E A S                         *
      *----------------------------------------------------------------*

       01  SHIP-DAYS                     PIC 9(4).
       01  PAGE-NUM                      PIC 9(3) VALUE 0.
       01  NUM-LINES                     PIC 9(2) VALUE 0.

       01  FILE-STATUS.
           05  FILE-STATUS-1             PIC X    VALUE "0".
           05  FILE-STATUS-2             PIC X    VALUE "0".

       01  MSTORERM-EOF-SW               PIC X    VALUE "N".

       01  CODE-ARG                      PIC X(8).

       01  ACCUMULATOR-FIELDS.
           05  ACCUM-CODES               PIC S9(6)  VALUE 0.

       01  CURRENT-DATE                    VALUE SPACES.
           05  CUR-YY             PIC X(2).
           05  CUR-MM             PIC X(2).
           05  CUR-DD             PIC X(2).

       01  CURRENT-TIME                    VALUE SPACES.
           05  CUR-HR             PIC X(2).
           05  CUR-MIN            PIC X(2).
           05  CUR-SEC            PIC X(2).

       01  HOLD-DAYS-TABLE.
           05  HOLD-DATA    OCCURS 3 TIMES.
               10  HOLD-CODE      PIC X(7).
               10  HOLD-DAYS      PIC 9(4).

       01  SUB                    PIC 9    VALUE 0.

      *----------------------------------------------------------------*
      *               R E P O R T   L I N E S                          *
      *----------------------------------------------------------------*

       01  HEADING-1.
           05  FILLER             PIC X(5)  VALUE SPACES.
           05  H1-MM              PIC X(2).
           05  FILLER             PIC X     VALUE "/".
           05  H1-DD              PIC X(2).
           05  FILLER             PIC X     VALUE "/".
           05  H1-YY              PIC X(2).
           05  FILLER             PIC X(37) VALUE SPACES.
           05  FILLER             PIC X(32) VALUE
                                   "CORPORATE STORES DATABASE UPDATE".
           05  FILLER             PIC X(37) VALUE SPACES.
           05  FILLER             PIC X(8)  VALUE "TUPDESLT".
           05  FILLER             PIC X(5)  VALUE SPACES.

       01  HEADING-2.
           05  FILLER             PIC X(5)  VALUE SPACES.
           05  H2-HR              PIC X(2).
           05  FILLER             PIC X     VALUE ":".
           05  H2-MIN             PIC X(2).
           05  FILLER             PIC X     VALUE ":".
           05  H2-SEC             PIC X(2).
           05  FILLER             PIC X(41) VALUE SPACES.
           05  FILLER             PIC X(22) VALUE
                                   "SHIP TIME CHANGED TO: ".
           05  H2-SHIP-DAYS       PIC Z9.
           05  FILLER             PIC X(41) VALUE SPACES.
           05  FILLER             PIC X(5)  VALUE "PAGE ".
           05  H2-PAGE-NUM        PIC ZZ9.
           05  FILLER             PIC X(5)  VALUE SPACES.

       01  HEADING-3.
           05  FILLER             PIC X(21) VALUE SPACES.
           05  FILLER             PIC X(23) VALUE
                                   "CORPORATE     PREVIOUS ".
           05  FILLER             PIC X(10) VALUE SPACES.
           05  FILLER             PIC X(23) VALUE
                                   "CORPORATE     PREVIOUS ".
           05  FILLER             PIC X(10) VALUE SPACES.
           05  FILLER             PIC X(23) VALUE
                                   "CORPORATE     PREVIOUS ".
           05  FILLER             PIC X(22) VALUE SPACES.

       01  HEADING-4.
           05  FILLER             PIC X(21) VALUE SPACES.
           05  FILLER             PIC X(23) VALUE
                                   "CODE          SHIP TIME".
           05  FILLER             PIC X(10) VALUE SPACES.
           05  FILLER             PIC X(23) VALUE
                                   "CODE          SHIP TIME".
           05  FILLER             PIC X(10) VALUE SPACES.
           05  FILLER             PIC X(23) VALUE
                                   "CODE          SHIP TIME".
           05  FILLER             PIC X(22) VALUE SPACES.

       01  HEADING-5.
           05  FILLER             PIC X(21) VALUE SPACES.
           05  FILLER             PIC X(23) VALUE
                                   "---------     ---------".
           05  FILLER             PIC X(10) VALUE SPACES.
           05  FILLER             PIC X(23) VALUE
                                   "---------     ---------".
           05  FILLER             PIC X(10) VALUE SPACES.
           05  FILLER             PIC X(23) VALUE
                                   "---------     ---------".
           05  FILLER             PIC X(22) VALUE SPACES.

       01  DETAIL-LINE.
           05  FILLER             PIC X(21) VALUE SPACES.
           05  DET-CODE-TABLE.
               10  DET-CODE-DATA  OCCURS 3 TIMES.
                   15  DET-CODE   PIC X(7).
                   15  FILLER     PIC X(9).
                   15  DET-DAYS   PIC ZZZ9.
                   15  FILLER     PIC X(13).
           05  FILLER             PIC X(12) VALUE SPACES.

       01  TOTAL-LINE.
           05  FILLER             PIC X(15) VALUE SPACES.
           05  FILLER             PIC X(25) VALUE
                                   "NUMBER OF CODES CHANGED: ".
           05  TOT-CODES          PIC ZZZ,ZZ9.
           05  FILLER             PIC X(85) VALUE SPACES.

      *----------------------------------------------------------------*
      *               U T I L I T Y   A R E A                          *
      *----------------------------------------------------------------*

       COPY TBLOWUP    IN COPYLIB.

       COPY VCOMAREA   IN COPYLIB.

       COPY DATAB      IN COPYLIB.

      *----- IF CHANGE-TYPE EQUALS:
      *-----    N  -->  ONLY NEW CODES (SHIP TIME = 0) WILL BE CHANGED.
      *-----    A  -->  ALL CODES WILL BE UPDATED.
       01  DATA-LINE.
           05  CHANGE-TYPE            PIC X.
               88  NEW-CODES-ONLY            VALUE "N".
               88  ALL-CODES                 VALUE "A".
           05  CHANGE-DAYS            PIC 9(2).

      *--------- P R O C E D U R E   D I V I S I O N ------------------*

       PROCEDURE DIVISION.

       0-BEGIN.
           PERFORM 1-HSK.
           PERFORM 6-MAIN UNTIL MSTORERM-EOF-SW = "Y".
      *------- WRITE LAST LINE OF REPORT.
           PERFORM 61-WRITE-REPORT-LINE.
           PERFORM 8-PRINT-TOTAL.
           PERFORM 2-EOJ.
           GOBACK.

       1-HSK.
           OPEN I-O    MSTORERM-IO
                       MPLTINFO-IO
                EXTEND REPORT-FILE.

           ACCEPT DATA-LINE.

           MOVE "POPT"   TO PLTINFOKEY OF MPLTINFO-REC-IO.
           PERFORM 9999-READ-MPLTINFO-IO.

      *------ IF JOB HAS ALREADY BEEN RUN AND ALL CODES ARE BEING
      *------ MODIFIED, BLOW UP.  OTHERWISE, IF NEW CODES ONLY ARE
      *------ BEING MODIFIED, RUN ANYWAYS.
      *--------- A CHANGE WAS MADE TO THE WAY THIS JOB IS RUN;
      *--------- BUPDESLT WAS DELETED AND REPLACED BY THE JOB
      *--------- BSHIPTOP.  THAT'S WHY THE NAMES ARE DIFFERENT HERE.
           IF MPLTINFO-BUPDESLT-SW = "Y" AND ALL-CODES
               MOVE  "BSHIPTOP HAS ALREADY BEEN RUN--CANNOT RUN AGAIN"
                                            TO BU-DISPLAY-MSG
               PERFORM 9999-BLOWUP.

           MOVE CHANGE-DAYS                 TO SHIP-DAYS
                                               H2-SHIP-DAYS.

           ACCEPT CURRENT-DATE FROM DATE.
           ACCEPT CURRENT-TIME FROM TIME.
           MOVE CUR-YY       TO  H1-YY.
           MOVE CUR-MM       TO  H1-MM.
           MOVE CUR-DD       TO  H1-DD.
           MOVE CUR-HR       TO  H2-HR.
           MOVE CUR-MIN      TO  H2-MIN.
           MOVE CUR-SEC      TO  H2-SEC.
           MOVE SPACES       TO  REPORT-FILE-REC.
           MOVE "*"          TO  RPT-CTL.
           MOVE CURRENT-DATE TO  RPT-LINE.
           WRITE REPORT-FILE-REC.

           PERFORM 8-PRINT-HEADINGS.

           PERFORM 9999-READ-FIRST-MSTORERM.

           INITIALIZE HOLD-DAYS-TABLE.

       2-EOJ.
           IF ALL-CODES
               PERFORM 9999-REWRITE-MPLTINFO.
           CLOSE       MSTORERM-IO
                       MPLTINFO-IO
                       REPORT-FILE.

       6-MAIN.
           IF (ALL-CODES OR (NEW-CODES-ONLY AND STR-EST-LT = 0))
                        AND  CORP-CODE NOT = "NON-STR"
               PERFORM 60-CHANGE-MSTORERM
           ELSE
               PERFORM 9999-READ-NEXT-MSTORERM.

       6-MAIN-X.
           EXIT.

       60-CHANGE-MSTORERM.
           ADD 1                    TO  SUB.
           MOVE CORP-CODE           TO  HOLD-CODE (SUB).
           MOVE STR-EST-LT          TO  HOLD-DAYS (SUB).
           MOVE SHIP-DAYS           TO  STR-EST-LT.
           PERFORM 9999-REWRITE-MSTORERM.
           IF SUB = 3
               PERFORM 61-WRITE-REPORT-LINE
               INITIALIZE HOLD-DAYS-TABLE
               MOVE 0               TO  SUB.
           PERFORM 9999-READ-NEXT-MSTORERM.

       61-WRITE-REPORT-LINE.
           PERFORM VARYING SUB FROM 1 BY 1 UNTIL SUB = 4 OR
                                     HOLD-CODE (SUB) = SPACES
               MOVE HOLD-CODE (SUB)    TO  DET-CODE (SUB)
               MOVE HOLD-DAYS (SUB)    TO  DET-DAYS (SUB)
           END-PERFORM.
           MOVE "1"              TO  RPT-CTL.
           MOVE DETAIL-LINE      TO  RPT-LINE.
           WRITE REPORT-FILE-REC.
           ADD 1                 TO  NUM-LINES.
           MOVE SPACES           TO  DETAIL-LINE.
           IF NUM-LINES > 55
               PERFORM 8-PRINT-HEADINGS.

       8-PRINT-HEADINGS.
           ADD 1                 TO  PAGE-NUM.
           MOVE PAGE-NUM         TO  H2-PAGE-NUM.
           MOVE "0"              TO  RPT-CTL.
           MOVE HEADING-1        TO  RPT-LINE.
           WRITE REPORT-FILE-REC.
           MOVE "1"              TO  RPT-CTL.
           MOVE HEADING-2        TO  RPT-LINE.
           WRITE REPORT-FILE-REC.
           MOVE "2"              TO  RPT-CTL.
           MOVE HEADING-3        TO  RPT-LINE.
           WRITE REPORT-FILE-REC.
           MOVE "1"              TO  RPT-CTL.
           MOVE HEADING-4        TO  RPT-LINE.
           WRITE REPORT-FILE-REC.
           MOVE "1"              TO  RPT-CTL.
           MOVE HEADING-5        TO  RPT-LINE.
           WRITE REPORT-FILE-REC.
           MOVE 5                TO  NUM-LINES.

       8-PRINT-TOTAL.
           MOVE "2"                  TO  RPT-CTL.
           MOVE ACCUM-CODES          TO  TOT-CODES.
           MOVE TOTAL-LINE           TO  RPT-LINE.
           WRITE REPORT-FILE-REC.

       9999-READ-MPLTINFO-IO.
           READ MPLTINFO-IO INTO BUF-MPLTINFO
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE "READ MPLTINFO * 9999-RMI" TO BU-DISPLAY-MSG
               PERFORM 9999-BLOWUP.

       9999-READ-FIRST-MSTORERM.
           READ MSTORERM-IO FIRST INTO BUF-MSTORERM
               AT END MOVE "Y" TO MSTORERM-EOF-SW.
           IF FILE-STATUS NOT = "00"
               MOVE "READ FIRST MSTORERM * 9999-RFM" TO BU-DISPLAY-MSG
               PERFORM 9999-BLOWUP.

       9999-READ-NEXT-MSTORERM.
           READ MSTORERM-IO NEXT INTO BUF-MSTORERM
               AT END MOVE "Y" TO MSTORERM-EOF-SW.

       9999-REWRITE-MSTORERM.
           REWRITE MSTORERM-REC-IO FROM BUF-MSTORERM
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE "REWRITE MSTORERM * 9999-RM" TO BU-DISPLAY-MSG
               PERFORM 9999-BLOWUP.
           ADD 1                  TO  ACCUM-CODES.

       9999-REWRITE-MPLTINFO.
           MOVE "POPT"   TO PLTINFOKEY OF MPLTINFO-REC-IO.
           PERFORM 9999-READ-MPLTINFO-IO.
           MOVE "Y"                     TO  MPLTINFO-BUPDESLT-SW.
           REWRITE MPLTINFO-REC-IO FROM BUF-MPLTINFO
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE "REWRITE MPLTINFO * 9999-RM"
                                       TO  BU-DISPLAY-MSG
               MOVE MPLTINFO-KEY       TO  BU-DISPLAY-FLD (1)
               PERFORM 9999-BLOWUP.

       9999-BLOWUP.
           MOVE "TUPDESLT"        TO  BU-PGM-NAME.
           MOVE CODE-ARG          TO  BU-DISPLAY-FLD (1).
           CALL "TBLOWUP"  USING  BASE, BU-PGM-NAME, STATUS-AREA,
                                  VIEW-COMAREA, FILE-STATUS,
                                  BU-DISPLAY-MSG, BU-DISPLAY-FLDS.

