000200 IDENTIFICATION DIVISION.
000300 PROGRAM-ID. TCKDREQQ.
000400*REMARKS.    THIS PROGRAM CHECKS THE DREQQUE DATASET AND
      *D           DETERMINES IF THERE ARE REQUISITONS THAT ARE
      *D           SITTING IN SOMEONE'S QUEUE THAT HAVE NOT
      *D           MOVED IN THE LAST TWO DAYS
      *C
      *C  09/11/96  JEFF BUNGO
      *C    EXPAND DATE FIELDS FOR YEAR 2000 COMPLIANCE.
      *C    INCLUDE CENTURY IN QUEUED DATE AND 48 HOUR CHECK DATE.
      *C
000500 ENVIRONMENT DIVISION.
000600 CONFIGURATION SECTION.
000700 SOURCE-COMPUTER. AS400.
000800 OBJECT-COMPUTER. AS400.
       COPY SPECIALN OF COPYLIB.
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT DREQQUE
               ASSIGN TO DATABASE-MCFLCS4401
               ORGANIZATION IS INDEXED
                 ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                 WITH DUPLICATES
               FILE STATUS IS FILE-STATUS.
           SELECT MREQ
               ASSIGN TO DATABASE-MCFLCS2001
               ORGANIZATION IS INDEXED
                 ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
               FILE STATUS IS FILE-STATUS.
           SELECT ONLINE-PRT ASSIGN TO PRINTER-MCPRT.
           SELECT PERSONNEL-FILE
               ASSIGN TO DATABASE-MCFLMM0301
               ORGANIZATION IS INDEXED
               ACCESS IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
               FILE STATUS IS FILE-STATUS.
000900 DATA DIVISION.
       FILE SECTION.
       FD  DREQQUE
           LABEL RECORDS ARE STANDARD.
       01  DREQQUE-REC.
           COPY DDS-MCRPCS4400 OF MCFLCS4401.
       FD  MREQ
           LABEL RECORDS ARE STANDARD.
       01  MREQ-REC.
           COPY DDS-MCRPCS2000 OF MCFLCS2001.
       FD  ONLINE-PRT
           LABEL RECORDS ARE OMITTED
           RECORD CONTAINS 132 CHARACTERS
           DATA RECORD IS PRINT-RCD.
       01  PRINT-RCD.
           05  PRINT-LINE           PIC X(132).
       FD  PERSONNEL-FILE
           LABEL RECORDS ARE STANDARD
           DATA RECORD IS PFREC.
       01  PFREC.
           COPY DDS-ALL-FORMATS OF MCFLMM0301.
001000 WORKING-STORAGE SECTION.
       77  FST-SW                   PIC 9.
       77  LINE-CTR                 PIC 99.
001300 01  BLOWUP-BASE              PIC X(16).
       01  BUF-DREQQUE-SAVE         PIC X(154).
       01  CDATE.
           05 YY                    PIC 99.
           05 MM                    PIC 99.
           05 DD                    PIC 99.
       COPY DATAB    IN COPYLIB.
       01  DDATE.
           05 DMM                   PIC 99.
           05 FILLER                PIC X      VALUE "/".
           05 DDD                   PIC 99.
           05 FILLER                PIC X      VALUE "/".
           05 DYY                   PIC 99.
001700 COPY DREQQUE  IN COPYLIB.
       01  DETAIL-LINE.
           05  FILLER               PIC X(12) VALUE SPACES.
           05  D-REQ                PIC X(12) VALUE SPACES.
           05  FILLER               PIC XX    VALUE SPACES.
           05  D-LEVEL              PIC XX    VALUE SPACES.
           05  FILLER               PIC XX    VALUE SPACES.
           05  D-APPRVR             PIC X(16) VALUE SPACES.
           05  FILLER               PIC X(6)  VALUE SPACES.
           05  D-QUEDTE             PIC X(8)  VALUE SPACES.
           05  FILLER               PIC X(4)  VALUE SPACES.
           05  D-VAR.
               10  D-VAR-PAR1       PIC X     VALUE SPACE.
               10  D-VAR-STAT       PIC X(10) VALUE SPACES.
               10  D-VAR-PAR2       PIC X     VALUE SPACE.
           05  FILLER               PIC X(4)  VALUE SPACES.
002300 01  ERROR-BUFFER.
002400     05  ERR-MSG1.
002500         10  ERR-LIT1         PIC X(11) VALUE SPACES.
002600         10  ERR-REQ          PIC X(12) VALUE SPACES.
002700         10  ERR-LIT2         PIC X(45) VALUE SPACES.
002800     05  ERR-DELAY            PIC X(8)  VALUE SPACES.
       01  FILE-STATUS              PIC XX.
      *---PARMS FOR JULGREG DATE ROUTINE
       01  GREGDATE.
           05  GREGDATE-CC          PIC 99.
           05  GREGDATE-YMD.
               10  GREGDATE-YY      PIC 99.
               10  GREGDATE-MM      PIC 99.
               10  GREGDATE-DD      PIC 99.
       01  JULDATE.
           05  JULYEAR              PIC 9(4).
           05  JULDAY               PIC 9(3).
       01  DAYDIGIT                 PIC X.
       01  LEAPYEAR                 PIC X.
       01  HEADER-0.
           05  FILLER               PIC X(10) VALUE SPACES.
           05  FILLER               PIC X(27)
               VALUE "REQUISITIONS THAT HAVE NOT ".
           05  FILLER               PIC X(25)
               VALUE "MOVED IN TWO OR MORE DAYS".
           05  FILLER               PIC X(10) VALUE SPACES.
           05  H0-DATE              PIC X(8)  VALUE SPACES.
       01  HEADER-1.
           05  FILLER               PIC X(12) VALUE SPACES.
           05  FILLER               PIC X(12)
               VALUE "REQUISITION ".
           05  FILLER               PIC XX    VALUE SPACES.
           05  FILLER               PIC XX    VALUE "LV".
           05  FILLER               PIC XX    VALUE SPACES.
           05  FILLER               PIC X(19)
               VALUE "WAITING AT APPROVER".
           05  FILLER               PIC XXX   VALUE SPACES.
           05  FILLER               PIC X(8)  VALUE "QUE DATE".
           05  FILLER               PIC X(20) VALUE SPACES.
       01  HEADER-U.
           05  FILLER               PIC X(80) VALUE ALL "-".
       01  JDATE.
           05 JYY                   PIC 99.
           05 JDDD                  PIC 999.
       COPY IOFEEDBACK IN COPYLIB.
003800 COPY LANGSUB    IN COPYLIB.
004400 COPY MREQ IN COPYLIB.
       COPY OVRPFDATA IN COPYLIB.
       01  REQ-ARG                  PIC X(12).
       01  PERSONNEL-DATA.          COPY MPERSONL IN COPYLIB.
004900 COPY TBLOWUP    IN COPYLIB.
       COPY TDATECHK   IN COPYLIB.
       COPY VCOMLINK   IN COPYLIB.
       01  48HR-CHECK-CN.
           05  CC-48HR              PIC 99.
           05  48HR-CHECK.
               10  YY-48HR.
                   15  YY-48HR-9        PIC 99.
               10  MM-48HR.
                   15  MM-48HR-9        PIC 99.
               10  DD-48HR.
                   15  DD-48HR-9        PIC 99.
005200 PROCEDURE DIVISION.
005300 START-PGM.
005400     PERFORM 1-HSK.
005500     PERFORM 6-MAIN THRU 6-MAIN-X.
005600 2-EOJ.
           CLOSE DREQQUE.
           CLOSE MREQ.
           CLOSE PERSONNEL-FILE.
           CLOSE ONLINE-PRT.
006000     GOBACK.
023200 2-BLOWUP.
023300     MOVE "TCKDREQQ" TO BU-PGM-NAME.
023400     CALL "TBLOWUP" USING BLOWUP-BASE BU-PGM-NAME STATUS-AREA
023500                      VIEW-COMAREA DUMMY-KSAM-STAT
023600                      BU-DISPLAY-MSG BU-DISPLAY-FLDS.
006100 1-HSK.
           OPEN INPUT  DREQQUE.
           OPEN INPUT  MREQ.
           OPEN INPUT  PERSONNEL-FILE.
           MOVE "MCPRT"        TO OVRPRTF-FILE.
           PERFORM 996-OVERRIDE-PRINT-FILE.
           OPEN OUTPUT ONLINE-PRT.
           ACCEPT CDATE        FROM DATE.
           MOVE MM             TO DMM.
           MOVE DD             TO DDD.
           MOVE YY             TO DYY.
           MOVE DDATE          TO H0-DATE.

           MOVE CDATE          TO GREGDATE-YMD.
           IF GREGDATE-YY > 70
              MOVE 19 TO GREGDATE-CC
           ELSE
              MOVE 20 TO GREGDATE-CC.
           MOVE SPACES TO JULDATE.
           CALL "JULGREG" USING GREGDATE JULDATE DAYDIGIT LEAPYEAR.
           IF JULDAY < 3
               MOVE 365 TO JULDAY
               SUBTRACT 1 FROM JULYEAR
           ELSE
               SUBTRACT 2 FROM JULDAY.
           MOVE SPACES TO GREGDATE.
           CALL "JULGREG" USING GREGDATE JULDATE DAYDIGIT LEAPYEAR.
           IF LEAPYEAR = "Y" AND JULDAY = 365
               ADD 1 TO JULDAY
               MOVE SPACES TO GREGDATE
               CALL "JULGREG" USING GREGDATE JULDATE DAYDIGIT LEAPYEAR.

           MOVE GREGDATE TO 48HR-CHECK-CN.
           MOVE 59 TO LINE-CTR.
       6-MAIN.
           MOVE 0 TO COND-WORD.
           READ MREQ NEXT INTO BUF-MREQ
               AT END    MOVE 11 TO COND-WORD.
           IF FILE-STATUS NOT = "00" MOVE 11 TO COND-WORD.
           IF COND-WORD = 11 GO TO 6-MAIN-X.
           IF REQ-STATUS = "SS"
               IF REQ-APPROVALS-LEFT = "  "
                   GO TO 6-MAIN
               ELSE
               IF REQ-APPROVALS-LEFT-9 > 0
                   MOVE MREQ-NUMBER TO REQ-ARG
                   PERFORM 60-CHECK-DREQQUE THRU 60-CD-X
                   GO TO 6-MAIN
               ELSE
               GO TO 6-MAIN.
           IF REQ-RELEASE-STAT = "XX" OR "X " GO TO 6-MAIN.
           IF REQ-APPROVALS-LEFT = "  " GO TO 6-MAIN.
           IF REQ-APPROVALS-LEFT-9 = 0 GO TO 6-MAIN.
           MOVE MREQ-NUMBER TO REQ-ARG.
           PERFORM 60-CHECK-DREQQUE THRU 60-CD-X.
           GO TO 6-MAIN.

014100 6-MAIN-X.    EXIT.

       60-CHECK-DREQQUE.
           MOVE 0 TO FST-SW.
           MOVE 0 TO COND-WORD.
           MOVE SPACES  TO DREQQUE-REC.
           MOVE REQ-ARG TO REQNO OF DREQQUE-REC.
           START DREQQUE KEY > EXTERNALLY-DESCRIBED-KEY
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF FILE-STATUS NOT = "00" MOVE 17 TO COND-WORD.
           IF COND-WORD = 17 GO TO 60-CD-X.
       60-CD-LOOP.
           READ DREQQUE NEXT INTO BUF-DREQQUE
               AT END    MOVE 15 TO COND-WORD.
           IF FILE-STATUS NOT = "00" MOVE 15 TO COND-WORD.
           IF DRQQ-REQ-NUMBER NOT = REQ-ARG MOVE 15 TO COND-WORD.
032300     IF COND-WORD NOT = 0
032400         IF COND-WORD = 15
032500             GO TO 60-CD-X
032600         ELSE
032700         MOVE "READ DREQQUE *TCKDREQQ*" TO BU-DISPLAY-MSG
032800         GO TO 2-BLOWUP.
      *    IF DRQQ-EQ-ST = "X " GO TO 60-CD-LOOP.
           IF DRQQ-APPROVE-DATE = "      "
               IF DRQQ-QUEUED-DATE > "      "
                   IF DRQQ-QUEUED-DATE-CN < 48HR-CHECK-CN
                       MOVE DRQQ-REQ-NUMBER  TO D-REQ
                       MOVE DRQQ-LEVEL-NUM   TO D-LEVEL
                       MOVE DRQQ-QUEUED-DATE TO D-QUEDTE
                       PERFORM 600-GET-CC-NAME
                       PERFORM 601-CHECK-RETURN-STATUS
                       ADD 1 TO LINE-CTR
                       IF LINE-CTR > 59
                           PERFORM 69-WRITE-HEADERS
                           WRITE PRINT-RCD FROM DETAIL-LINE
                               AFTER ADVANCING 1 LINES
                           GO TO 60-CD-X
                       ELSE
                       WRITE PRINT-RCD FROM DETAIL-LINE
                           AFTER ADVANCING 1 LINES
                       GO TO 60-CD-X
                   ELSE
                   GO TO 60-CD-X
               ELSE
               IF DRQQ-QUEUED-DATE = "      "
                    IF FST-SW = 0
                        MOVE 1            TO FST-SW
                        MOVE BUF-DREQQUE  TO BUF-DREQQUE-SAVE
                    ELSE
                    MOVE 0                TO FST-SW
                    MOVE BUF-DREQQUE-SAVE TO BUF-DREQQUE
                    MOVE DRQQ-REQ-NUMBER  TO D-REQ
                    MOVE DRQQ-LEVEL-NUM   TO D-LEVEL
                    MOVE DRQQ-QUEUED-DATE TO D-QUEDTE
                    PERFORM 600-GET-CC-NAME
                    PERFORM 601-CHECK-RETURN-STATUS
                    ADD 1                 TO LINE-CTR
                    IF LINE-CTR > 59
                        PERFORM 69-WRITE-HEADERS
                        WRITE PRINT-RCD FROM DETAIL-LINE
                            AFTER ADVANCING 1 LINES
                        GO TO 60-CD-X
                    ELSE
                    WRITE PRINT-RCD FROM DETAIL-LINE
                        AFTER ADVANCING 1 LINES
                    GO TO 60-CD-X.
            GO TO 60-CD-LOOP.
       60-CD-X.    EXIT.

       600-GET-CC-NAME.
           MOVE 0                         TO COND-WORD.
           MOVE DRQQ-EMPL-QUEUED          TO PERCCNUM OF PFREC.
           READ PERSONNEL-FILE INTO PERSONNEL-DATA
               INVALID KEY    MOVE 15 TO COND-WORD.
           IF FILE-STATUS NOT = "00" MOVE 15 TO COND-WORD.
           MOVE PER-EMP-NAME              TO D-APPRVR.

       601-CHECK-RETURN-STATUS.
           MOVE SPACES                    TO D-VAR.
           IF REQ-HOLD-STATUS > SPACES
               MOVE "("                   TO D-VAR-PAR1
               MOVE REQ-HOLD-STATUS       TO D-VAR-STAT
               MOVE ")"                   TO D-VAR-PAR2.

       69-WRITE-HEADERS.
           MOVE 0                         TO LINE-CTR.
           WRITE PRINT-RCD FROM HEADER-0 AFTER ADVANCING NEW-PAGE.
           WRITE PRINT-RCD FROM HEADER-1 AFTER ADVANCING 2 LINES.
           WRITE PRINT-RCD FROM HEADER-U AFTER ADVANCING 1 LINES.
           MOVE 4                         TO LINE-CTR.

       COPY OVRPFCALL IN COPYLIB.
