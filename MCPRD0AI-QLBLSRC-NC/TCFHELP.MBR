       IDENTIFICATION DIVISION.
       PROGRAM-ID.             TCFHELP.
       AUTHOR.                 W. ROXBURY.
       INSTALLATION.           GOODYEAR TIRE & RUBBER CO.
      *REMARKS.   *** HELP FUNCTION DISPLAY PROGRAM
       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.
       SOURCE-COMPUTER.        IBM-AS400.
       OBJECT-COMPUTER.        IBM-AS400.

       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT DISPLAY-FILE
                  ASSIGN       TO WORKSTATION-ZCFTHELP-SI
                  ORGANIZATION IS TRANSACTION
                  ACCESS MODE  IS SEQUENTIAL
                  FILE STATUS  IS SCREEN-STATUS
                               MAJOR-MINOR
                  CONTROL-AREA IS SCREEN-CONTROL.

       DATA DIVISION.
       FILE SECTION.
       FD  DISPLAY-FILE
           LABEL RECORDS       ARE OMITTED.
       01  DISPLAY-REC         PIC X(2000).

       WORKING-STORAGE SECTION.
       77  FORM-SW             PIC S9(4) VALUE 1.
       77  MENU-SW             PIC S9(4) VALUE 3.

       01  PASSWORD-INFORMATION.
           05  NAME-OF-PROGRAM     PIC X(08) VALUE "TCFHELP ".
           05  PROGRAM-TYPE        PIC X(02) VALUE "IN".
           05  PROGRAM-RELEASE     PIC X(12) VALUE " E0100010001".
           05  PROGRAM-DESCRIPTION.
               10  PROG-DESC-A     PIC X(60) VALUE
         "HELP FUNCTIONS DISPLAY PROGRAM FOR THE CRAFTSMAN's EXECUTIVE".
               10  PROG-DESC-B     PIC X(60) VALUE
         "FUNCTIONS.                                                  ".
               10  PROG-FUNCTION   PIC X(60) VALUE
         "    &dJ DO NOT APPLY PASSWORD &d@                         ".
           05  PASSWORD-FLAG   PIC X.

           COPY SCREENIO       IN COPYLIB.

       LINKAGE SECTION.
       01  HELP-SW             PIC S9(4).

       PROCEDURE DIVISION      USING HELP-SW.
       BEGIN.
           OPEN I-O            DISPLAY-FILE.
           IF HELP-SW = 0      MOVE  1 TO FORM-SW.
           IF HELP-SW = 30     MOVE  6 TO FORM-SW.
           IF HELP-SW = 40     MOVE  7 TO FORM-SW.
           IF HELP-SW = 50     MOVE  8 TO FORM-SW.

       SETUP.
           PERFORM GET-FORM.

       SHOWFORM.
           MOVE "00"           TO SCREEN-STATUS.
           MOVE SPACES         TO DISPLAY-REC.

           WRITE DISPLAY-REC   FORMAT IS SCREEN-NAME
                               INDIC ARE SCREEN-INDICATORS.
           IF SCREEN-STATUS NOT = "00"
               DISPLAY "SCREEN WRITE ERROR.  SCREEN-STATUS IS "
                               SCREEN-STATUS
               GO TO END-OF-JOB.

           READ  DISPLAY-FILE  FORMAT IS SCREEN-NAME
                               INDIC ARE SCREEN-INDICATORS
           IF SCREEN-STATUS NOT = "00"
               DISPLAY "SCREEN READ ERROR.  SCREEN-STATUS IS "
                               SCREEN-STATUS
               GO TO END-OF-JOB.

           MOVE ALL B"0"       TO SCREEN-INDICATORS.

           IF KEY-HIT = 3
               GO TO END-OF-JOB.

       READKEYS-MASTER.
           IF FORM-SW = 3
               GO TO READKEYS-B.

           IF FORM-SW = 9
               GO TO READKEYS-C.

       READKEYS-A.
           IF KEY-HIT = 0 OR 2
               ADD 1           TO FORM-SW
               GO TO SETUP.

           IF KEY-HIT = 8
               SUBTRACT 1      FROM FORM-SW
               GO TO SETUP.

           IF KEY-HIT = 5
               IF MENU-SW = 3
                   MOVE 3      TO FORM-SW
                   GO TO SETUP
               ELSE
                   MOVE 9      TO FORM-SW
                   GO TO SETUP.

           GO TO SHOWFORM.

       READKEYS-B.
           IF KEY-HIT = 0 OR 1
               MOVE 4          TO FORM-SW.

           IF KEY-HIT = 2
               MOVE 5          TO FORM-SW.

           IF KEY-HIT = 8
               MOVE 6          TO FORM-SW.

           IF KEY-HIT = 4
               MOVE 7          TO FORM-SW.

           IF KEY-HIT = 5
               MOVE 8          TO FORM-SW.

           IF KEY-HIT = 6
               MOVE 9          TO FORM-SW.

           IF KEY-HIT = 7
               MOVE 10         TO FORM-SW.

           GO TO SETUP.

       READKEYS-C.
           IF KEY-HIT = 0 OR 1
               MOVE 11         TO FORM-SW.

           IF KEY-HIT = 2
               MOVE 12         TO FORM-SW.

           IF KEY-HIT = 8
               MOVE 13         TO FORM-SW.

           IF KEY-HIT = 4
               MOVE 14         TO FORM-SW.

           IF KEY-HIT = 5
               MOVE 15         TO FORM-SW.

           IF KEY-HIT = 6
               MOVE 16         TO FORM-SW.

           GO TO SETUP.


       GET-FORM.
           IF FORM-SW = 0      MOVE 16       TO FORM-SW.
           IF FORM-SW = 17     MOVE  1       TO FORM-SW.
           IF FORM-SW = 1      MOVE "HELP01" TO SCREEN-NAME.
           IF FORM-SW = 2      MOVE "HELP02" TO SCREEN-NAME.
           IF FORM-SW = 3
               MOVE "HELP00"   TO SCREEN-NAME
               MOVE 3          TO MENU-SW.
           IF FORM-SW = 4      MOVE "HELP10" TO SCREEN-NAME.
           IF FORM-SW = 5      MOVE "HELP20" TO SCREEN-NAME.
           IF FORM-SW = 6      MOVE "HELP30" TO SCREEN-NAME.
           IF FORM-SW = 7      MOVE "HELP40" TO SCREEN-NAME.
           IF FORM-SW = 8      MOVE "HELP50" TO SCREEN-NAME.
           IF FORM-SW = 9
               MOVE "HELP60"   TO SCREEN-NAME
               MOVE 9          TO MENU-SW.
           IF FORM-SW = 10     MOVE "HELP70" TO SCREEN-NAME.
           IF FORM-SW = 11     MOVE "HELP61" TO SCREEN-NAME.
           IF FORM-SW = 12     MOVE "HELP62" TO SCREEN-NAME.
           IF FORM-SW = 13     MOVE "HELP63" TO SCREEN-NAME.
           IF FORM-SW = 14     MOVE "HELP64" TO SCREEN-NAME.
           IF FORM-SW = 15     MOVE "HELP65" TO SCREEN-NAME.
           IF FORM-SW = 16     MOVE "HELP66" TO SCREEN-NAME.

       END-OF-JOB.
           CLOSE               DISPLAY-FILE.
           GOBACK.

