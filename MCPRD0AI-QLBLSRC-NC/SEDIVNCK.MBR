000200 IDENTIFICATION DIVISION.
000300 PROGRAM-ID.     SEDIVNCK.
000400 DATE-WRITTEN.   APR 17, 1991.
000500 INSTALLATION.   THE GOODYEAR TIRE AND RUBBER COMPANY - AKRON.
000600*REMARKS.
000700**************************************************************
000800*                                                            *
000900*    SEDIVNCK            EDI VENDOR CHECK SUBPROGRAM         *
001000*                                                            *
001100*     THIS PROGRAM CHECKS TO SEE IF A VENDOR IS              *
001200*     AN EDI VENDOR GIVEN EITHER A PURCHASE ORDER            *
001300*     OR VENDOR CODE.                                        *
001400*                                                            *
001500**************************************************************
      *C 06/10/96   JEFF BUNGO
      *C   EXPAND DATE FIELDS FOR YEAR 2000 COMPLIANCE.
      *C   RECOMPILE TO PICK UP NEW FILE FORMATS.
001500**************************************************************
001600
001700 ENVIRONMENT DIVISION.
001800 CONFIGURATION SECTION.
001900 SOURCE-COMPUTER.  IBM-AS400.
002000 OBJECT-COMPUTER.  IBM-AS400.
002100 INPUT-OUTPUT SECTION.
002200 FILE-CONTROL.
           SELECT DPORECD-PO-I
               ASSIGN TO DATABASE-MCFLCS0901
               ORGANIZATION IS INDEXED
                 ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                 WITH DUPLICATES
               FILE STATUS IS FILE-STATUS.

           SELECT DVENDOR-VN-I
               ASSIGN TO DATABASE-MCFLCS0701
               ORGANIZATION IS INDEXED
                 ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                 WITH DUPLICATES
               FILE STATUS IS FILE-STATUS.

002500 DATA DIVISION.
002600 FILE SECTION.
       FD  DPORECD-PO-I
           LABEL RECORDS ARE STANDARD.
       01  DPORECD-PO-REC-I.
           COPY DDS-MCRPCS0900 OF MCFLCS0901.
       FD  DVENDOR-VN-I
           LABEL RECORDS ARE STANDARD.
       01  DVENDOR-VN-REC-I.
           COPY DDS-MCRPCS0700 OF MCFLCS0701.
002900 WORKING-STORAGE SECTION.
003000 77  HANDLE-BLOWUP-FLAG           PIC X      VALUE "Y".
003100*************************************************************
003200*************************************************************
003300**                                                         **
003400**              D A T A    B A S E    A R E A              **
003500**                                                         **
003600*************************************************************
003700*************************************************************
003800
003900 01  DSET-NAMES.
004000     05  DSET-NAME                PIC X(16)  VALUE SPACES.
004100     05  DSET-DVENDOR             PIC X(16)  VALUE "DVENDOR;".
004200     05  DSET-DPORECD             PIC X(16)  VALUE "DPORECD;".
004300
004400 01  ARG-VALUES.
004500     05  PO-ARG                   PIC X(14)  VALUE SPACES.
004600     05  VEN-ARG                  PIC X(10)  VALUE SPACES.
004700
004800 01  SEARCH-ITEMS.
004900     05  ALL-ITEMS                PIC X(2)  VALUE "@;".
005000     05  PO-SEARCH                PIC X(14) VALUE "PO-RCV-NO;".
005100     05  VEN-SEARCH               PIC X(10) VALUE "VEN-CODE;".
005200
005300 01  DB-LOG-VALUES.
005400     05  DB-LOG-TEXT              PIC X(8)  VALUE "SEDIVNCK".
005500     05  DB-LOG-TEXT-LEN          PIC S9(4) COMP  VALUE -8.
005600
005700 COPY DBMODES    IN COPYLIB.
005800
005900 COPY DBSTAT     IN COPYLIB.
006000
006100 COPY DPORECD    IN COPYLIB.
006200
006300 COPY DVENDOR    IN COPYLIB.
006400
006500 COPY FILESTAT   IN COPYLIB.
006600
006700 COPY TBLOWUP    IN COPYLIB.
006800
006900 COPY VCOMAREA   IN COPYLIB.
007000*************************************************************
007100*************************************************************
007200**                                                         **
007300**               LINKAGE   SECTION                         **
007400**                                                         **
007500*************************************************************
007600*************************************************************
007700
007800 LINKAGE SECTION.
007900
008000 01  BASE                          PIC X(10).
       COPY SEDIVNCK IN COPYLIB.
008400
008500*************************************************************
008600**#########################################################**
008700*************************************************************
008800**                                                         **
008900**          P R O C E D U R E    D I V I S I O N           **
009000**                                                         **
009100*************************************************************
009200**#########################################################**
009300*************************************************************
009400
009500 PROCEDURE DIVISION USING BASE
                                SEDIVNCK-PARMS.
009800
009900 0-BEGIN-HERE.
010000     PERFORM 1-HSK.
010100     PERFORM 6-MAIN THRU 6-MAIN-X.
010200     GOBACK.
010300
010400 1-HSK.
           OPEN INPUT DPORECD-PO-I.
           OPEN INPUT DVENDOR-VN-I.
010700
010800*********************************************************
010900*  PARAGRAPH : 2100-BLOWUP                              *
011000*  PURPOSE   : TO LOG ERROR MESSAGE AND ABORT PROGRAM   *
011100*********************************************************
011200 2100-BLOWUP.
011300     MOVE "SEDIVNCK" TO BU-PGM-NAME.
011400     MOVE BASE       TO BU-DISPLAY-FLD (1).
011500     CALL "TBLOWUP" USING BASE, BU-PGM-NAME, STATUS-AREA,
011600                       VIEW-COMAREA, FILE-STATUS, BU-DISPLAY-MSG,
011700                       BU-DISPLAY-FLDS.
011800
011900**************************************************
012000*                                                *
012100*                  6 - M A I N                   *
012200*                                                *
012300**************************************************
012400 6-MAIN.
012500     MOVE "N" TO SEDIVNCK-EDI-IND SEDIVNCK-INVLESS-IND.
012600     IF SEDIVNCK-VEN-CODE = "          "
012700         IF SEDIVNCK-PO-NUMBER = "              "
012800             GO TO 6-MAIN-X
012900         ELSE
013000         MOVE SEDIVNCK-PO-NUMBER TO PO-ARG
013100         PERFORM 9999-CHAINHD-DPORECD-PO-I
013200         IF NO-ENTRY
013300             GO TO 6-MAIN-X
013400         ELSE
013500         PERFORM 9999-GETNEXT-DPORECD-PO-I
013600         IF END-OF-CHAIN
013700             GO TO 6-MAIN-X
013800         ELSE
013900         MOVE PO-VEN-CODE TO VEN-ARG SEDIVNCK-VEN-CODE
014000     ELSE
014100     MOVE SEDIVNCK-VEN-CODE TO VEN-ARG.
014200     PERFORM 60-CHECK-DVENDOR THRU 60-CD-X.
014300
014400 6-MAIN-X.    EXIT.
014500
014600 60-CHECK-DVENDOR.
014700     PERFORM 9999-CHAINHD-DVENDOR-VN-I.
014800     IF NO-ENTRY GO TO 60-CD-X.
014900 60-CD-CONT.
015000     PERFORM 9999-GETNEXT-DVENDOR-VN-I.
015100     IF END-OF-CHAIN GO TO 60-CD-X.
015200     IF VEN-ITM-NO = "10"
               MOVE VEN-INVLESS-IND TO SEDIVNCK-INVLESS-IND
               GO TO 60-CD-CONT
           ELSE
           IF VEN-ITM-NO = "14"
               IF VEN-TRADING-ID = SPACES
                   NEXT SENTENCE
               ELSE
015600         MOVE "Y" TO SEDIVNCK-EDI-IND
           ELSE
           GO TO 60-CD-CONT.
015700 60-CD-X.    EXIT.
015800
       9999-CHAINHD-DVENDOR-VN-I.
           MOVE 0 TO COND-WORD.
           MOVE VEN-ARG TO VENCDE OF DVENDOR-VN-REC-I.
           START DVENDOR-VN-I KEY = VENCDE OF DVENDOR-VN-REC-I
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF (FILE-STATUS NOT = "00") AND (FILE-STATUS-1 NOT = "2")
               MOVE 99 TO COND-WORD
               IF HANDLE-BLOWUP-FLAG = "Y"
                   MOVE "CHAINHD ERR 9999-CHAINHD-DVENDOR-VN-I"
                       TO BU-MSG-AREA
                   PERFORM 2100-BLOWUP.

       9999-GETNEXT-DVENDOR-VN-I.
           MOVE 0 TO COND-WORD.
           READ DVENDOR-VN-I NEXT INTO BUF-DVENDOR
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   MOVE 15 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD
                   IF HANDLE-BLOWUP-FLAG = "Y"
                       MOVE "GETNEXT ERR 9999-GETNEXT-DVENDOR-VN-I"
                           TO BU-MSG-AREA
                       PERFORM 2100-BLOWUP
                   END-IF
           ELSE
           IF VENCDE OF DVENDOR-VN-REC-I NOT = VEN-ARG
               MOVE 15 TO COND-WORD.

       9999-CHAINHD-DPORECD-PO-I.
           MOVE 0 TO COND-WORD.
           MOVE PO-ARG TO PORCVNO OF DPORECD-PO-REC-I.
           START DPORECD-PO-I KEY = PORCVNO OF DPORECD-PO-REC-I
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF (FILE-STATUS NOT = "00") AND (FILE-STATUS-1 NOT = "2")
               MOVE 99 TO COND-WORD
               IF HANDLE-BLOWUP-FLAG = "Y"
                   MOVE "CHAINHD ERR 9999-CHAINHD-DPORECD-PO-I"
                       TO BU-MSG-AREA
                   PERFORM 2100-BLOWUP.

       9999-GETNEXT-DPORECD-PO-I.
           MOVE 0 TO COND-WORD.
           READ DPORECD-PO-I NEXT INTO BUF-DPORECD
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   MOVE 15 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD
                   IF HANDLE-BLOWUP-FLAG = "Y"
                       MOVE "GETNEXT ERR 9999-GETNEXT-DPORECD-PO-I"
                           TO BU-MSG-AREA
                       PERFORM 2100-BLOWUP
                   END-IF
           ELSE
           IF PORCVNO OF DPORECD-PO-REC-I NOT = PO-ARG
               MOVE 15 TO COND-WORD.

