           05  READ-CMD-LINE                    PIC X(79).
           05  READ-ERR-LINE                    PIC X(79).
036400 01  RETURN-CODE.
036500     05  RET-CODE                         PIC X.
036600     05  FILLER                           PIC X.
       01  SCREEN-BUFFER.
036300     05  SCREEN-FILLER                    PIC X(10).
           05  SCREEN-CMD-LINE                  PIC X(79).
           05  SCREEN-ERR-LINE                  PIC X(79).
036700 01  SCREEN-PRINT-PARMS.
036800     05  PRINTCNTL                PIC S9(4) VALUE ZERO  COMP-4.
036900     05  PAGECNTL                 PIC S9(4) VALUE 49    COMP-4.
037000     05  SPOOLFIL-OPEN-SW         PIC X   VALUE "N".
037100 COPY DBSTAT  IN COPYLIB.
037200 COPY TBLOWUP IN COPYLIB.
037300 01  TMP-WORKAREA.
037400     05  CRAFT-DESIRED                    PIC XX.
037500     05  TMP-CONV-AREA.
037600         10  UNITS-POSITION               PIC 999.
037700         10  TENTHS-POSITION              PIC 9.
037800     05  DECIMAL-NUM REDEFINES TMP-CONV-AREA  PIC 999V9.
037900     05  TMP-L-C-FIELD1                   PIC 9999999.
038000 01  TMP-TIME-AREA.
038100     05  TTA-HRS                          PIC XX.
038200     05  TTA-MIN                          PIC XX.
038300     05  FILLER                           PIC XX.
       01  TRUE-VAL                             PIC 1 VALUE B"1".
038400 01  WO-LABOR-DATA.    COPY DWOLABOR OF COPYLIB.
038500 01  WO-PARTS-DATA.    COPY DWOPARTS OF COPYLIB.
       COPY WSCONTROL IN COPYLIB.
038600 LINKAGE SECTION.
039300 01  DBPARAMETERS.     COPY DBPARMS OF COPYLIB.
039500 01  WO-BASIC-DATA.    COPY DWOBASIC OF COPYLIB.
       COPY VCOMLINK  IN COPYLIB.
039700 PROCEDURE DIVISION USING DBPARAMETERS WO-BASIC-DATA
                            VIEW-COMAREA.
039900 BEGIN.
040000     PERFORM 1-HSK.
040100     PERFORM 6-MAIN UNTIL RETURN-SW = "2".
040200 2-EOJ.
           CLOSE DISPLAY-FILE.
040300     CLOSE LBRFILE MATFILE WO-LAST-NUM-USED.
041400     GOBACK.
041600****************************************************************
041700*    HOUSEKEEPING                                              *
041800****************************************************************
041900 1-HSK.
042200     CALL "TPWORD" USING PASSWORD-INFORMATION.
042600     IF PASSWORD-FLAG = "N"
042700       MOVE "  PWORD" TO BLOWUP-BASE
042800       MOVE "FAILED PASSWORD CHECK - TDISPBAS"
042900           TO BU-DISPLAY-MSG
043000       PERFORM 998-BLOWUP.
           MOVE "0" TO RETURN-SW.
           OPEN I-O    DISPLAY-FILE.
           OPEN I-O    LBRFILE.
           OPEN I-O    MATFILE.
           OPEN INPUT WO-LABOR-FILE.
           OPEN INPUT WO-LAST-NUM-USED.
           OPEN INPUT WO-PARTS-FILE.
043300     MOVE DATE-FLAG    TO  DATE-CODE.
043400     MOVE 1 TO ARG-NO.
           MOVE 0 TO COND-WORD.
043500     READ WO-LAST-NUM-USED INTO LAST-WO-BUFF
               INVALID KEY    MOVE 17 TO COND-WORD.
044800 6-MAIN.
044900     PERFORM 63-READ-DB-AND-SAVE-DATA.
045000     MOVE "0" TO RETURN-SW.
045100     PERFORM 65-DISPLAY-CONTROL
045200         UNTIL RETURN-SW = "1" OR "2".
045300*****************************************************************
045400*    READ DATA BASE-MMISA AND SAVE DATA                               *
045500*****************************************************************
045600 63-READ-DB-AND-SAVE-DATA.
046100     MOVE ZERO TO LBR-REC-CNT.
046400     MOVE +0001 TO WO-BASIC-REC-CNT.
      *
      *    CLEAR LABOR WORK AREAS AND RETRIEVE WO-LABOR DATA
      *
066500     MOVE SPACES TO LA-CRAFT-REQ-WA.
           MOVE ZEROES TO LA-CRAFT-CNT LA-MEN-EST-WA LA-MEN-ACT-WA
               LA-HRS-EST-WA LA-HRS-ACT-WA LA-TOTAL-COST-WA
               LA-TOT-CRF-CST-WA LA-SUM-CRF-CST-WA.
           IF WO-BASIC-REC-CNT NOT = 0
             PERFORM 6330-SET-LA-CRAFT-REQ.
066600     MOVE "0" TO RET-CODE.
           MOVE 0 TO ACT-KEYL-WA.
           MOVE 0 TO COND-WORD.
           MOVE WO-NUM TO WONUM-MM OF WOLABF.
           START WO-LABOR-FILE KEY IS > EXTERNALLY-DESCRIBED-KEY
               INVALID KEY MOVE 17 TO COND-WORD.
           IF WLF-STATUS NOT = "00"
             MOVE 17 TO COND-WORD.
           IF COND-WORD = 0
066800       PERFORM 633-READ-AND-SAVE-1-LBR-REC
066900           UNTIL RET-CODE = "1".
067000*
067100*    CLEAR MATERIALS WORK AREAS AND GET WO-PARTS DATA
067200*
069000     MOVE ZERO TO MA-MATRL-REC-CNT.
069100     MOVE 0    TO ACT-KEYM-WA.
           MOVE ZEROES TO MA-TOT-EST-COST MA-TOT-ACT-COST.
069200     MOVE "0" TO RET-CODE.
           MOVE SPACES TO MATREC.
           MOVE 0 TO COND-WORD.
           MOVE WO-NUM TO WONUM-MM OF WOPARF.
           START WO-PARTS-FILE KEY IS > EXTERNALLY-DESCRIBED-KEY
               INVALID KEY MOVE 17 TO COND-WORD.
           IF WPF-STATUS NOT = "00"
             MOVE 17 TO COND-WORD.
           IF COND-WORD = 0
069300       PERFORM 634-READ-AND-SAVE-1-MAT-REC
069400           UNTIL RET-CODE = "1".
073600 633-READ-AND-SAVE-1-LBR-REC.
           MOVE 0 TO COND-WORD.
           READ WO-LABOR-FILE PRIOR INTO WO-LABOR-DATA
               AT END MOVE 14 TO COND-WORD.
           IF LBR-WO-NUM NOT = WO-NUM
             MOVE 14 TO COND-WORD.
076000     IF COND-WORD = 14
076100       MOVE "1" TO RET-CODE
           ELSE
073900       IF COND-WORD = 0
074000         ADD +0001 TO LBR-REC-CNT
               MOVE LBR-CRAFT TO CRAFT-DESIRED
               PERFORM 63300-DET-CRAFT-SUBSCRIPT
               ADD 1 TO LA-MEN-ACT (CRFT-SUBSC)
074100         MOVE LBR-HRS1-99 TO UNITS-POSITION
074200         MOVE LBR-HRS2-9 TO TENTHS-POSITION
               ADD DECIMAL-NUM TO LA-HRS-ACT (CRFT-SUBSC)
074300         DIVIDE LBR-CST-CENTS-9 BY 100
074400             GIVING TMP-LBR-CST
074500         ADD LBR-CST-DOLLR-9 TO TMP-LBR-CST
074600         ADD TMP-LBR-CST TO LA-TOTAL-COST-WA
074700         ADD TMP-LBR-CST TO LA-TOT-CRF-CST (CRFT-SUBSC)
074900         ADD 1 TO ACT-KEYL-WA
               MOVE ACT-KEYL-WA TO ACT-KEYL
               MOVE WO-LABOR-DATA TO LBRREC-REC
075000         WRITE LBRREC     INVALID KEY
075100             MOVE 27031 TO CATREAD-MSG-NUMBER
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE TRUE-VAL TO INDS (99).
070700 6330-SET-LA-CRAFT-REQ.
070800     MOVE ZERO TO LA-CRAFT-CNT.
070900     IF CRAFTS-REQD-1 NOT = "  "
             MOVE CRAFTS-REQD-1 TO CRAFT-DESIRED
             PERFORM 63300-DET-CRAFT-SUBSCRIPT.
           IF CRAFTS-REQD-2 NOT = "  "
             MOVE CRAFTS-REQD-2 TO CRAFT-DESIRED
             PERFORM 63300-DET-CRAFT-SUBSCRIPT.
           IF CRAFTS-REQD-3 NOT = "  "
             MOVE CRAFTS-REQD-3 TO CRAFT-DESIRED
             PERFORM 63300-DET-CRAFT-SUBSCRIPT.
071000 63300-DET-CRAFT-SUBSCRIPT.
071100     IF LA-CRAFT-CNT = ZERO
071200       MOVE +0001 TO CRFT-SUBSC
071300       MOVE +0001 TO LA-CRAFT-CNT
071400       MOVE CRAFT-DESIRED TO LA-CRAFT-REQ (CRFT-SUBSC)
071800     ELSE
071900       MOVE ZERO TO CRFT-SUBSC
072000       PERFORM 633100-LOOP-TABLE
072100           VARYING LOOP-CNT FROM 1 BY 1
072200           UNTIL LOOP-CNT IS GREATER THAN LA-CRAFT-CNT.
072300     IF CRFT-SUBSC = ZERO
072400       ADD +0001 TO LA-CRAFT-CNT
072500       MOVE LA-CRAFT-CNT TO CRFT-SUBSC
072600       MOVE CRAFT-DESIRED TO LA-CRAFT-REQ (CRFT-SUBSC).
073000 633100-LOOP-TABLE.
073100     IF LA-CRAFT-REQ (LOOP-CNT) = CRAFT-DESIRED
073200       MOVE LOOP-CNT TO CRFT-SUBSC.
077300 634-READ-AND-SAVE-1-MAT-REC.
           MOVE 0 TO COND-WORD.
           READ WO-PARTS-FILE PRIOR INTO WO-PARTS-DATA
               AT END MOVE 14 TO COND-WORD.
           IF PRT-WO-NU NOT = WO-NUM
             MOVE 14 TO COND-WORD.
084400     IF COND-WORD = 14
084500       MOVE "1" TO RET-CODE
           ELSE
077600       IF COND-WORD = 0
077700         MOVE SPACES TO MATREC-DB-REC
077800         PERFORM 6341-RAS1MR THRU 6341-RAS1MR-EXIT
               ADD 1 TO MA-MATRL-REC-CNT
               COMPUTE MA-TOT-EST-COST = MA-TOT-EST-COST +
                   MAT-EST-COST-DOLLR + MAT-EST-COST-CENTS / 100
               COMPUTE MA-TOT-ACT-COST = MA-TOT-ACT-COST +
                   MAT-ACT-COST-DOLLR + MAT-ACT-COST-CENTS / 100
               ADD 1 TO ACT-KEYM-WA
               MOVE ACT-KEYM-WA TO ACT-KEYM
               MOVE MATREC TO MATREC-REC
               WRITE MATF    INVALID KEY
084200             MOVE 45039 TO CATREAD-MSG-NUMBER
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE TRUE-VAL TO INDS (99).
085700 6341-RAS1MR.
085800     MOVE WO-PARTS-DATA TO MATREC-DB-REC.
           IF MAT-EST-COST = SPACES
             MOVE ZEROES TO M-EST-COST.
           IF MAT-ACT-COST = SPACES
             MOVE ZEROES TO M-ACT-COST.
085900     IF MAT-REQ-NO = SPACES OR "CANCEL" GO TO 6341-RAS1MR-EXIT.
086000     MOVE SPACES TO CMR-DATA CMR-DESC CMR-REMARKS
086100         CMR-RETURNED-DATA CMR-MISC-PARMS BU-DISPLAY-MSG.
086200     MOVE "IN" TO CMR-CALL-MODE.
086300     MOVE MAT-REQ-NO TO CMR-REQ-NUMBER.
086400     MOVE MAT-WO-NU TO CMR-WO-NUMBER.
086600     CALL "CMANINQ" USING PASSED-BASE
086700                          CMR-CALL-MODE
086800                          CMR-DATA
086900                          CMR-DESC
087000                          CMR-REMARKS
087100                          CMR-RETURNED-DATA
087200                          CMR-MISC-PARMS
087300                          LANGUAGE-PARMS
087400                          ESC-NAME
087500                          STATUS-AREA
087600                          BU-DISPLAY-MSG.
           IF CMR-RETURN-STATUS = "OK"
               NEXT SENTENCE
           ELSE
           MOVE 0                     TO  MATREC-REQ-QTY-9
                                          MATREC-PUR-QTY-9
                                          MATREC-RCV-QTY-9
                                          MATREC-INV-QTY-9
                                          MATREC-REQ-UP
                                          MATREC-PO-UP
                                          MATREC-INV-UP
           GO TO 6341-RAS1MR-EXIT.
           MOVE CMR-CORP-CODE         TO  MAT-NUM-7.
           MOVE CMR-UM                TO  MAT-UNIT-MEAS.
           MOVE CMR-REQ-ORIG          TO  MAT-ORIGINATOR.
           MOVE CMR-QTY               TO  MATREC-REQ-QTY-9.
           MOVE CMR-EST-UNIT-PRICE    TO  MATREC-REQ-UP.
           MOVE CMR-SUB               TO  MAT-SUB.
           MOVE CMR-SUGGESTED-VENDOR  TO  MAT-SUGG-VENDOR.
           MOVE CMR-WO-ITEM-NUMBER    TO  MAT-ITEM-NO.
           MOVE CMR-ADDTL-INFO        TO  MAT-ADDL-INFO.
      *************************************************************
      *    THE FOLLOWING CHECK FOR MAT-DELETE-FLAG WAS ADDED      *
      *    ON 1-13-88 TO MAKE THE USER AWARE OF AN ITEM THAT      *
      *    HAD BEEN DELETED AFTER THE W/O HAD BEEN APPROVED       *
      *    BUT NEEDED TO BE RETAINED FOR ESTIMATE ACCURACY        *
      *************************************************************
           IF MAT-DELETE-FLAG = "D"
               MOVE SPACES TO MAT-DESC MAT-DESC-2 MAT-DESC-3
                   MAT-DESC-4 MAT-DESC-5
               MOVE MAT-REMARKS-2 TO MAT-DESC
               MOVE SPACES TO MAT-REMARKS MAT-REMARKS-2
           ELSE
           MOVE CMR-DESC-LINE (1)      TO  MAT-DESC
           MOVE CMR-DESC-LINE (2)      TO  MAT-DESC-2
           MOVE CMR-DESC-LINE (3)      TO  MAT-DESC-3
           MOVE CMR-DESC-LINE (4)      TO  MAT-DESC-4
           MOVE CMR-DESC-LINE (5)      TO  MAT-DESC-5
           MOVE CMR-REMARK-1           TO  MAT-REMARKS
           MOVE CMR-REMARK-2           TO  MAT-REMARKS-2.
           MOVE CMR-PO-NO-AND-REL      TO  MAT-PO-NO.
           IF PRT-EST-QTY = "        "
               MOVE ZEROES             TO  MAT-EST-QTY-9
           ELSE
           MOVE PRT-EST-QTY-9          TO  MAT-EST-QTY-9.
           MOVE CMR-PO-QTY-DLVR        TO  MATREC-RCV-QTY.
           MOVE SPACES                 TO  MAT-PAD2.
           MOVE CMR-QTY                TO  MAT-ACT-QTY-9.
           MOVE CMR-PO-QTY-ORD         TO  MATREC-PUR-QTY.
           MOVE CMR-PO-UNIT-PRICE      TO  MATREC-PO-UP.
           MOVE CMR-PO-QTY-PAID        TO  MATREC-INV-QTY.
           MOVE CMR-INV-UNIT-PRICE     TO  MATREC-INV-UP.
           IF MATREC-INV-QTY-9 > MATREC-REQ-QTY-9
               MOVE MATREC-REQ-QTY-9 TO MATREC-INV-QTY-9.
           IF MATREC-PUR-QTY-9 > MATREC-REQ-QTY-9
               MOVE MATREC-REQ-QTY-9 TO MATREC-PUR-QTY-9.
           IF MATREC-RCV-QTY-9 > MATREC-REQ-QTY-9
               MOVE MATREC-REQ-QTY-9 TO MATREC-RCV-QTY-9.
           IF MATREC-INV-QTY-9 > 0
               IF MATREC-INV-UP > 0
                   MULTIPLY MATREC-INV-QTY-9 BY MATREC-INV-UP
                       GIVING M-ACT-COST
                   GO TO 6341-RAS1MR-CONT
               ELSE
               NEXT SENTENCE
           ELSE
           IF MATREC-INV-QTY-9 = 0
               IF MATREC-INV-UP > 0
                   MOVE MATREC-INV-UP  TO M-ACT-COST
                   GO TO 6341-RAS1MR-CONT.
           IF MATREC-PUR-QTY-9 > 0
               IF MATREC-PO-UP > 0
                   MULTIPLY MATREC-PUR-QTY-9 BY MATREC-PO-UP
                       GIVING M-ACT-COST.
       6341-RAS1MR-CONT.
093200     IF PLANT-IDENT NOT = "126 "
093300       MOVE CMR-STAGING-AREA   TO  MAT-STAGE.

093400 6341-RAS1MR-EXIT.
           EXIT.

068800*****************************************************************
068900*    LOGIC CONTROL OF DISPLAY                                   *
069000*****************************************************************
105500 65-DISPLAY-CONTROL.
105600     MOVE "0" TO RET-CODE.
105700     MOVE 0 TO ACT-KEYL-WA ACT-KEYM-WA.
105800     IF VIEW-LASTKEY = 0
             MOVE "FDISPME2" TO VIEW-CFNAME
             MOVE 66045 TO CATREAD-MSG-NUMBER
             PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
             MOVE ERROR-BUFFER TO SCREEN-CMD-LINE
             MOVE SCREEN-BUFFER TO DSPLY-REC
             PERFORM 99-SCREEN-WRITE
             PERFORM 98-SCREEN-READ
106000     ELSE
106100       IF VIEW-LASTKEY = 1
               MOVE SPACES TO LABOR-LINES
               CLOSE LBRFILE
               OPEN I-O LBRFILE
               MOVE SPACES TO MATL-LINES
               CLOSE MATFILE
               OPEN I-O MATFILE
106200         MOVE "2" TO RETURN-SW
106300       ELSE
106400         IF VIEW-LASTKEY = 2
                 MOVE SPACES TO LABOR-LINES
                 CLOSE LBRFILE
                 OPEN I-O LBRFILE
                 MOVE SPACES TO MATL-LINES
                 CLOSE MATFILE
                 OPEN I-O MATFILE
106500           MOVE "2" TO RETURN-SW
106600         ELSE
106700           IF VIEW-LASTKEY = 4
106800             PERFORM 651-WRITE-WO-BASIC
106900           ELSE
107000             IF VIEW-LASTKEY = 5
107100               IF MA-MATRL-REC-CNT > 10
107200                 PERFORM 652-PREREAD-CMATLS-ORDERED
107200                     THRU 652-PCO-EXIT
                       MOVE 0 TO ACT-KEYM-WA
107300                 PERFORM 652-WRITE-WO-MATERIALS-USED
107400               ELSE
107500                 PERFORM 652-WRITE-WO-MATERIALS-USED
107600             ELSE
107700               IF VIEW-LASTKEY = 6
107800                 IF MA-MATRL-REC-CNT > 10
107900                   PERFORM 653-PREREAD-UMATLS-ORDERED
107900                       THRU 653-PUO-EXIT
                         MOVE 0 TO ACT-KEYM-WA
108000                   PERFORM 653-WRITE-WO-MATERIALS-ORDERED
108100                 ELSE
108200                   PERFORM 653-WRITE-WO-MATERIALS-ORDERED
108300               ELSE
108400                 IF VIEW-LASTKEY = 7
108500                   PERFORM 654-WRITE-WO-LABOR-USED
108600                 ELSE
109000                   IF VIEW-LASTKEY = 3
109100                     MOVE "2" TO RETURN-SW
                         ELSE
                           MOVE 35126 TO CATREAD-MSG-NUMBER
                           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                           MOVE TRUE-VAL TO INDS (99)
                           MOVE 0 TO VIEW-LASTKEY.
075400*****************************************************************
075500*    DISPLAY BASIC WORK ORDER                                   *
075600*****************************************************************
075700 651-WRITE-WO-BASIC.
077800     PERFORM 6511-MOVE-WO-BASIC-TO-BUF2.
078000     MOVE "0" TO RETURN-SW-2.
078100     PERFORM 6513-GET-NEXT-INST
078200         UNTIL RETURN-SW-2 = "1".
079600 6511-MOVE-WO-BASIC-TO-BUF2.
079700     MOVE SPACES TO BUFFER MSG-AREA.
079800     MOVE WO-NUM               TO WO-NUM-BUF2 WONUM-MSG.
079900     MOVE WO-STATUS            TO WO-STATUS-BUF2.
080000     MOVE WO-STRT-STATUS       TO WO-CURR-STAT-BUF2.
080100     MOVE 4                    TO DATE-MODE.
080200     MOVE DATE-RECD            TO DATE-VALIDATE-IN.
080300     CALL "TDATECHK" USING DATE-CHECK-AREA.
080400     MOVE DATE-OUT             TO DATE-RECD-BUF2.
080500     MOVE TIME-RECD            TO TIME-RECD-BUF2.
080600     MOVE APPROVAL-CODE        TO APPROVAL-CODE-BUF2.
080700     MOVE REQUESTER-B          TO REQUESTER-BUF2.
080800     MOVE EQUIP-NUM            TO EQUIP-NUM-BUF2.
080900     MOVE EQUIP-NAME           TO EQUIP-NAME-BUF2.
081000     MOVE TYPE-NUM             TO TYPE-NUM-BUF2.
081100     MOVE DEPT                 TO DEPT-BUF2.
081200     MOVE ZONE                 TO ZONE-BUF2.
081300     MOVE LOCATION             TO LOCATION-BUF2.
081400     MOVE PRIORITY             TO PRIORITY-BUF2.
081500     MOVE EQUIP-DOWN           TO EQUIP-DOWN-BUF2.
081600     MOVE CRAFTS-REQD-1        TO CRAFTS-REQT-1-BUF2.
081700     MOVE CRAFTS-REQD-2        TO CRAFTS-REQT-2-BUF2.
081800     MOVE CRAFTS-REQD-3        TO CRAFTS-REQT-3-BUF2.
081900     MOVE EXP-CLASS            TO EXP-CLASS-BUF2.
082000     MOVE DESCRIPTION-1        TO DESCRIPTION-1-BUF2.
082100     MOVE DESCRIPTION-2-1      TO DESCRIPTION-2-BUF2.
082200     MOVE DESCRIPTION-2-2      TO DESCRIPTION-3-BUF2.
082300     MOVE CRAFTSMEN-1          TO CRAFTSMEN-1-BUF2.
082400     MOVE CRAFTSMEN-2          TO CRAFTSMEN-2-BUF2.
082500     MOVE CRAFTSMEN-3          TO CRAFTSMEN-3-BUF2.
082600     IF DATE-STRT = "      "
082700       MOVE DATE-STRT        TO DATE-STRT-BUF2
082800     ELSE
082900       MOVE 4                    TO DATE-MODE
083000       MOVE DATE-STRT            TO DATE-VALIDATE-IN
083100       CALL "TDATECHK" USING DATE-CHECK-AREA
083200       MOVE DATE-OUT             TO DATE-STRT-BUF2.
083300     MOVE TIME-STRT            TO TIME-STRT-BUF2.
083400     MOVE FAIL-CODE-REASON     TO FAIL-CODE-REASON-BUF2.
083500     MOVE FAIL-CODE-SUBSYS     TO FAIL-CODE-SUBSYS-BUF2.
083600     IF DATE-COMP = "      "
083700       MOVE DATE-COMP        TO DATE-COMP-BUF2
083800     ELSE
083900       MOVE 4                    TO DATE-MODE
084000       MOVE DATE-COMP            TO DATE-VALIDATE-IN
084100       CALL "TDATECHK" USING DATE-CHECK-AREA
084200       MOVE DATE-OUT             TO DATE-COMP-BUF2.
084300     MOVE TIME-COMP            TO TIME-COMP-BUF2.
084400     MOVE 42017 TO CATREAD-MSG-NUMBER.
084600     PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
084700     MOVE ERROR-BUFFER TO MESSAGE-BUF2.
           MOVE "FDISPBAS" TO VIEW-CFNAME.
           MOVE 49060 TO CATREAD-MSG-NUMBER.
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
           MOVE ERROR-BUFFER TO BUFFER-CMD-LINE.
           MOVE SPACES TO ERROR-BUFFER.
           MOVE BUFFER TO DSPLY-REC.
           PERFORM 99-SCREEN-WRITE.
           PERFORM 98-SCREEN-READ.
           MOVE DSPLY-REC TO BUFFER.
085900 6513-GET-NEXT-INST.
087200     IF VIEW-LASTKEY = 3
087300       MOVE 0 TO VIEW-LASTKEY
087400       MOVE "1" TO RETURN-SW-2
           ELSE
087600       IF VIEW-LASTKEY = 4
087700         CALL "TDISPMES" USING DBPARAMETERS
088000                               MSG-AREA
               MOVE MSG-BUFFER TO BUFFER-CMD-LINE
               MOVE BUFFER TO DSPLY-REC
               MOVE TRUE-VAL TO INDS (98)
               PERFORM 99-SCREEN-WRITE
               PERFORM 98A-SCREEN-READ
               CALL "CLPAUSE2"
089500         MOVE 42017 TO CATREAD-MSG-NUMBER
089700         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE ERROR-BUFFER TO MESSAGE-BUF2
               MOVE 49060 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE ERROR-BUFFER TO BUFFER-CMD-LINE
               MOVE BUFFER TO DSPLY-REC
               PERFORM 99-SCREEN-WRITE
               PERFORM 98-SCREEN-READ
090200         GO TO 6513-GET-NEXT-INST
             ELSE
092400         MOVE "1" TO RETURN-SW-2.
092500*****************************************************************
092600*    DISPLAY MATERIALS USED ON WORK ORDER                       *
092700*****************************************************************
134400 652-PREREAD-CMATLS-ORDERED.
134500     MOVE "FDISPITM" TO VIEW-CFNAME.
           MOVE SPACES TO READ-BUFFER.
           MOVE READ-BUFFER TO DSPLY-REC.
           PERFORM 99-SCREEN-WRITE.
           PERFORM 98-SCREEN-READ.
           MOVE DSPLY-REC TO READ-BUFFER.
135200 652-PCO-READ.
135700     IF READ-BUFFER = SPACES
135700       GO TO 652-PCO-EXIT.
135800     MOVE 0 TO ACT-KEYM-WA.
135900 652-PCO-LOOP.
136000     ADD 1 TO ACT-KEYM-WA.
136100     IF ACT-KEYM-WA > MA-MATRL-REC-CNT
13620        IF READ-ITEM NOT = SPACES
136400         MOVE 35110 TO CATREAD-MSG-NUMBER
136600         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE TRUE-VAL TO INDS (98)
               MOVE ERROR-BUFFER TO READ-CMD-LINE
               MOVE READ-BUFFER TO DSPLY-REC
               PERFORM 99-SCREEN-WRITE
               PERFORM 98A-SCREEN-READ
               CALL "CLPAUSE2"
               CALL "CLPAUSE2"
               GO TO 65-DISPLAY-CONTROL
137200       ELSE
137300         IF READ-REQNO NOT = SPACES
137500           MOVE 44119 TO CATREAD-MSG-NUMBER
137700           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                 MOVE TRUE-VAL TO INDS (98)
                 MOVE ERROR-BUFFER TO READ-CMD-LINE
                 MOVE READ-BUFFER TO DSPLY-REC
                 PERFORM 99-SCREEN-WRITE
      **************************
                 PERFORM 98A-SCREEN-READ
                 CALL "CLPAUSE2"
                 CALL "CLPAUSE2"
                 GO TO 65-DISPLAY-CONTROL
138300         ELSE
138400           GO TO 652-PCO-EXIT.
138500     PERFORM 6521000-READ-MATFILE.
