033100             MOVE   8 TO LANG-MSGNUM
033200             PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
033300             MOVE MESSAGE-BUFFER TO VIEW-TYPE
               END-IF
               END-IF
               END-IF
               END-IF
               END-IF
           END-IF.
033400
033500 110-GET-FORM.
033600     MOVE FRTDATA TO  VIEW-NFNAME.
035400*************************************************************
035500*         DISPLAY SCREEN AND TEST FOR FUNCTION KEY ENTERED  *
035600*          FUNCTION KEYS:                                   *
035700*            F1 = RECIEVER INQUIRY                          *
035800*            F2 = NEXT FREIGHT                              *
035900*            F3 = PREVIOUS FREIGHT                          *
036000*            F5 = PRINT SCREEN                              *
036100*            F7 = RETURN TO MAIN SCREEN                     *
036200*            F8 = END PROGRAM                               *
036300*            'ENTER' KEY DEFAULTS TO F2                     *
036400*            F4 AND F6 ARE INVALID                          *
036500*************************************************************
036600 120-SHOW-FORM.
           IF PASS-HISTORY-FLAG NOT = "Y"
               MOVE LIVE-LIT TO VIEW-HISTORY-LIVE
           ELSE
               MOVE HISTORY-LIT TO VIEW-HISTORY-LIVE
           END-IF.
           MOVE SCREEN-BUFFER-INQFRT TO SCREEN-BUFFER.
           MOVE SCREEN-BUFFER TO DISPLAY-REC.
           WRITE DISPLAY-REC FORMAT IS VIEW-NFNAME
              INDIC ARE SRF-INDICATORS.
           MOVE ALL B"0" TO SRF-INDICATORS.

           READ  DISPLAY-FILE FORMAT IS VIEW-NFNAME
               INDIC ARE SRF-INDICATORS.
           ACCEPT IOFEEDBACK FROM I-O-FEEDBACK-AREA.
           MOVE ALL B"0" TO SRF-INDICATORS.
           MOVE DISPLAY-REC TO SCREEN-BUFFER-INQFRT.

      *------ A BAD STATUS MAY MEAN USER TURNED OFF TERMINAL.
      *------ IF SO, SIMULATE THE F3 KEY TO EXIT PROGRAM.
           IF DISPLAY-STATUS NOT = "00"
               MOVE 3 TO VIEW-LASTKEY
           ELSE
               MOVE FUNCTION-NUM TO VIEW-LASTKEY.
038700
038800*----------  F2 = NEXT RECEIVER   &(ENTER KEY DEFAULTS HERE)
038900     IF VIEW-LASTKEY = 2 OR 0
039000        IF FRT-RS = PASS-LAST-RECEIVER OR PASS-INQUIRY = "T"
039100           MOVE  14 TO LANG-SETNUM
039200           MOVE 102 TO LANG-MSGNUM
039300           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
039400           PERFORM 940-VSETERROR THRU 949-EXIT
039500           GO TO 120-SHOW-FORM
039600        ELSE
039700           ADD 1 TO FRT-RS-9
039800           GO TO 100-FIND-MPORCV.
039900
040000*----------  F8 = PREVIOUS RECEIVER
040100     IF VIEW-LASTKEY = 8
040200        IF FRT-RS = "001" OR PASS-INQUIRY = "T"
040300           MOVE  14 TO LANG-SETNUM
040400           MOVE 103 TO LANG-MSGNUM
040500           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
040600           PERFORM 940-VSETERROR THRU 949-EXIT
040700           GO TO 120-SHOW-FORM
040800        ELSE
040900           SUBTRACT 1 FROM FRT-RS-9
041000           GO TO 100-FIND-MPORCV.
041500
041100*----------  F1 = RECEIVER ITEM INQUIRY
041600     IF VIEW-LASTKEY = 1
              MOVE VIEW-LASTKEY TO PASS-SAVE-LASTKEY
              IF FRT-RS-9 NOT = PASS-NO-LEFT-OFF-AT
                  MOVE 1 TO PASS-ITEM
              END-IF
              MOVE FRT-RS-9 TO PASS-NO-LEFT-OFF-AT
              GO TO 199-EXIT.

041600     IF VIEW-LASTKEY = 5
              MOVE 4 TO PASS-SAVE-LASTKEY
              IF FRT-RS-9 NOT = PASS-NO-LEFT-OFF-AT
                  MOVE 1 TO PASS-ITEM
              END-IF
              MOVE FRT-RS-9 TO PASS-NO-LEFT-OFF-AT
              GO TO 199-EXIT.

042700     IF VIEW-LASTKEY EQUAL  7  OR  3
042800         MOVE VIEW-LASTKEY TO PASS-SAVE-LASTKEY
042900         GO TO  199-EXIT.
043000
043100     IF VIEW-LASTKEY EQUAL 4 OR 6
043200         MOVE   9 TO LANG-SETNUM
043300         MOVE  10 TO LANG-MSGNUM
043400         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
043500         PERFORM 940-VSETERROR THRU 949-EXIT
043600         GO TO 120-SHOW-FORM.
043700 199-EXIT.
           IF PASS-HISTORY-FLAG = "Y"
               CLOSE DPOFREIGHT, DPORECD, MPORCV, DISPLAY-FILE
           ELSE
               CLOSE DPOFREIGHT-ST DPORECD-ST DISPLAY-FILE
           END-IF.
043800     GOBACK.
043801 800-RETRIEVE-MULTI.
           MOVE 0 TO COND-WORD.
           MOVE RFR-ARG TO PORCVNO OF MPORCV-REC.
           READ MPORCV INTO BUF-MPORCV
               INVALID KEY MOVE 17 TO COND-WORD.
           IF FILE-STATUS-1 = "2"
               MOVE 17 TO COND-WORD
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD.
043812     IF COND-WORD = 17
043813*-----  DISPLAY "NO MORE RECEIVERS"...WILL ONLY HAPPEN FROM
043814*       PO REFERBACKS SINCE WE DON'T KNOW ITS LAST RECEIVER
043815           MOVE  14 TO LANG-SETNUM
043816           MOVE 102 TO LANG-MSGNUM
043817           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
043818           PERFORM 940-VSETERROR THRU 949-EXIT
043819           GO TO 809-EXIT.
043820     IF COND-WORD NOT = 0
043821        MOVE "DBGET MPORCV AT 800 SINQFRT" TO BU-DISPLAY-MSG
043822        PERFORM 990-BLOWUP THRU 999-EXIT.
043823
           MOVE 0 TO COND-WORD.
           MOVE RFR-ARG TO PORCVNO OF DPOFREIGHT-REC.
           START DPOFREIGHT KEY = PORCVNO OF DPOFREIGHT-REC
               INVALID KEY MOVE 17 TO COND-WORD.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
                   MOVE 17 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.
026000     IF COND-WORD NOT = 0
043813*-----  DISPLAY "NO MORE RECEIVERS"...WILL ONLY HAPPEN FROM
043814*       PO REFERBACKS SINCE WE DON'T KNOW ITS LAST RECEIVER
043815           MOVE  14 TO LANG-SETNUM
043816           MOVE 102 TO LANG-MSGNUM
043817           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
043818           PERFORM 940-VSETERROR THRU 949-EXIT
043819           GO TO 809-EXIT.
           MOVE 0 TO COND-WORD.
           READ DPOFREIGHT NEXT INTO BUF-DPOFREIGHT
               AT END MOVE 15 TO COND-WORD.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   MOVE 15 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.
           IF PORCVNO  OF DPOFREIGHT-REC NOT = RFR-ARG
               MOVE 15 TO COND-WORD.
043832     IF COND-WORD NOT = 0
043833         IF COND-WORD = 15
043834             MOVE  14 TO LANG-SETNUM
043835             MOVE  75 TO LANG-MSGNUM
043836             PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
043837             PERFORM 940-VSETERROR THRU 949-EXIT
043838             GO TO  110-GET-FORM
043839         ELSE
043840             MOVE "SINQFRT - FRT GET DB INFO" TO BU-DISPLAY-MSG
043841             PERFORM 990-BLOWUP THRU 999-EXIT.
      *---------CHECK FOR REFERBACK TO A REFERBACK
               IF FRT-REFER-RS NOT = SPACES
027700             MOVE FRT-REFER-PO   TO RFR-PO
027800             MOVE FRT-REFER-RLSE TO RFR-RLSE
027900             MOVE FRT-REFER-RS   TO RFR-RS
                   MOVE "P"            TO RFR-PO-PREFIX
                   GO TO 800-RETRIEVE-MULTI.
043842 809-EXIT.  EXIT.

       810-RETRIEVE-MULTI.
           MOVE 0 TO COND-WORD.
           MOVE RFR-ARG-2-14 TO PORCVNO OF DPOFREIGHT-ST-REC.
           START DPOFREIGHT-ST KEY = PORCVNO OF DPOFREIGHT-ST-REC
               INVALID KEY MOVE 17 TO COND-WORD.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
                   MOVE 17 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.
           IF COND-WORD NOT = 0
      *-----  DISPLAY "NO MORE RECEIVERS"...WILL ONLY HAPPEN FROM
      *       PO REFERBACKS SINCE WE DON'T KNOW ITS LAST RECEIVER
                 MOVE  14 TO LANG-SETNUM
                 MOVE 102 TO LANG-MSGNUM
                 PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                 PERFORM 940-VSETERROR THRU 949-EXIT
                 GO TO 809-EXIT.
           MOVE 0 TO COND-WORD.
           READ DPOFREIGHT-ST NEXT INTO BUF-DPOFREIGHT-H
               AT END MOVE 15 TO COND-WORD.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   MOVE 15 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.
           IF PORCVNO  OF DPOFREIGHT-ST-REC NOT = RFR-ARG-2-14
               MOVE 15 TO COND-WORD.
043832     IF COND-WORD NOT = 0
043833         IF COND-WORD = 15
043834             MOVE  14 TO LANG-SETNUM
043835             MOVE  75 TO LANG-MSGNUM
043836             PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
043837             PERFORM 940-VSETERROR THRU 949-EXIT
043838             GO TO  110-GET-FORM
043839         ELSE
043840             MOVE "SINQFRT - FRT HIST GET DB" TO BU-DISPLAY-MSG
043841             PERFORM 990-BLOWUP THRU 999-EXIT.
      *---------CHECK FOR REFERBACK TO A REFERBACK
               IF FRTH-REFER-RS NOT = SPACES
027700             MOVE FRTH-REFER-PO   TO RFR-PO
027800             MOVE FRTH-REFER-RLSE TO RFR-RLSE
027900             MOVE FRTH-REFER-RS   TO RFR-RS
                   GO TO 800-RETRIEVE-MULTI.
043842 819-EXIT.  EXIT.
044900******************************************************************
045000*   DISPLAY ERROR MESSAGE FOR SPECIFIC FIELD ON SCREEN           *
045100******************************************************************
045200 940-VSETERROR.
           MOVE B"1" TO IND (FIELD-NUMBER)  IND (99).
           MOVE MESSAGE-BUFFER TO DE-MESSAGE-LINE1.
048600 949-EXIT.  EXIT.
050700
046700************************************************************
046800*                    B L O W U P                           *
046900*     CHECK FOR IMAGE, VIEW, OR SPOOL ERROR.  CLOSE        *
047000*     FILES, GET OUT OF BLOCK MODE, AND DISPLAY            *
047100*     APPROPRIATE ERROR MESSAGE ON SCREEN.                 *
047200*                                                          *
047300*     ALSO APPENDS THE ERROR MESSAGE TO A FILE CALLED      *
047400*     BLOWUP.PUB.  TO READ THIS FILE, RUN "XBLPRT.OBJECT". *
047500*                                                          *
047600*         |||  PROGRAM IS ABORTED IN TBLOWUP  |||          *
047700************************************************************
047800 990-BLOWUP.
           MOVE "SINQFRT" TO BU-PGM-NAME.
047900     MOVE VIEW-NFNAME TO BU-DISPLAY-FLD (1).
048000     MOVE PASS-PO TO BU-DISPLAY-FLD (2).
048100     MOVE FRT-ARG TO BU-DISPLAY-FLD (3).
           IF PASS-HISTORY-FLAG = "Y"
               MOVE "HISTORY" TO BU-DISPLAY-FLD (4).
048200     CALL "TBLOWUP" USING BASE, BU-PGM-NAME, STATUS-AREA,
048300           VIEW-COMAREA, DUMMY-KSAM-STAT, BU-DISPLAY-MSG,
048400           BU-DISPLAY-FLDS.
048500 999-EXIT.  EXIT.
050800 999-CATREAD.
           IF CATREAD-MSG-NUMBER = ZEROS
               MOVE LANG-SETNUM TO CATREAD-MSG-SET
               MOVE LANG-MSGNUM TO CATREAD-MSG-NUM.
           CALL "CCATREAD" USING CATREAD-PARMS.
           MOVE CATREAD-MSG-TEXT TO MESSAGE-BUFFER.
052400 999-CATREAD-EXIT.
052500     EXIT.
