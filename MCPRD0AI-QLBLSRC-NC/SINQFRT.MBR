020000*************************************************************
020100*                  PROCEDURE DIVISION                       *
020200*       FIND DPORECD TO GET ZBILL NUMBER AND FIND           *
020300*       DPOFREIGHT FOR ALL THE OTHER DATA.  BROWSE          *
020400*       TO NEXT OR PREVIOUS RECEIVER.                       *
020500*************************************************************
020600*************************************************************
020700 PROCEDURE DIVISION USING  BASE,
020800                           VIEW-COMAREA,
020900                           SUBROUTINE-PARMS,
021000                           LANGUAGE-PARMS.
021100
021200 00-INQFRT SECTION 04.
021300 00-MAIN.
           IF PASS-HISTORY-FLAG NOT = "Y"
               OPEN INPUT DPOFREIGHT, DPORECD, MPORCV
           ELSE
               OPEN INPUT DPOFREIGHT-ST  DPORECD-ST
           END-IF.
           OPEN I-O DISPLAY-FILE.
021400     MOVE PASS-PO    TO FRT-ARG, WS-RECEIVER.
021500
022100     MOVE PASS-NO-LEFT-OFF-AT TO FRT-RS-9.
022200
022300     MOVE "000"      TO WS-RS.
           IF PASS-HISTORY-FLAG NOT = "Y"
022400         MOVE WS-RECEIVER TO PO-ARG
           ELSE
               MOVE WS-RECEIVER-2-14 TO PO-ARG
           END-IF.
022500
022600*----------  FIND DPORECD FOR ZBILL NUMBER
           MOVE 0 TO COND-WORD.
           IF PASS-HISTORY-FLAG NOT = "Y"
               MOVE PO-ARG TO PORCVNO  OF DPORECD-REC
               START DPORECD KEY = PORCVNO OF DPORECD-REC
                  INVALID KEY MOVE 17 TO COND-WORD
               END-START
           ELSE
               MOVE PO-ARG TO PORCVNO OF DPORECD-ST-REC
               START DPORECD-ST KEY = PORCVNO OF DPORECD-ST-REC
                  INVALID KEY MOVE 17 TO COND-WORD
               END-START
           END-IF.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
                   MOVE 17 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.
022900     IF COND-WORD NOT = 0
              IF PASS-HISTORY-FLAG NOT = "Y"
023000         MOVE "START DPORECD AT 00 IN SINQFRT" TO BU-DISPLAY-MSG
              ELSE
023000         MOVE "START DPORECD-ST,00 IN SINQFRT" TO BU-DISPLAY-MSG
              END-IF
023100        PERFORM 990-BLOWUP THRU 999-EXIT.
023200
           MOVE 0 TO COND-WORD.
           IF PASS-HISTORY-FLAG NOT = "Y"
               READ DPORECD NEXT INTO BUF-DPORECD
                   AT END MOVE 15 TO COND-WORD
               END-READ
           ELSE
               READ DPORECD-ST NEXT INTO BUF-DPORECD-H
                   AT END MOVE 15 TO COND-WORD
               END-READ
           END-IF.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   MOVE 15 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.
           IF PASS-HISTORY-FLAG NOT = "Y"
               IF PORCVNO OF DPORECD-REC NOT = PO-ARG
                   MOVE 15 TO COND-WORD
               END-IF
           ELSE
               IF PORCVNO OF DPORECD-ST-REC NOT = PO-ARG
                   MOVE 15 TO COND-WORD
               END-IF
           END-IF.
023500     IF COND-WORD NOT = 0
              IF PASS-HISTORY-FLAG NOT = "Y"
023600         MOVE "READ DPORECD AT 00 IN SINQFRT" TO BU-DISPLAY-MSG
              ELSE
023600         MOVE "READ DPORECD-ST, 00 IN SINQFRT" TO BU-DISPLAY-MSG
              END-IF
023700        PERFORM 990-BLOWUP THRU 999-EXIT.
023800*************************************************************
023900*    GET MPORCV FOR SEQUENCE NUMBER AND DPOFREIGHT FOR      *
024000*    THE REST OF FREIGHT INFORMATION.                       *
024100*************************************************************
024200 100-FIND-MPORCV.
           IF PASS-HISTORY-FLAG = "Y"
               GO TO 105-FIND-DPOFREIGHT
           END-IF.
           MOVE 0 TO COND-WORD.
           MOVE FRT-ARG TO PORCVNO OF MPORCV-REC.
           READ MPORCV INTO BUF-MPORCV
               INVALID KEY MOVE 17 TO COND-WORD.
           IF FILE-STATUS-1 = "2"
               MOVE 17 TO COND-WORD
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD.
024500     IF COND-WORD = 17
024600*-----  DISPLAY "NO MORE RECEIVERS"...WILL ONLY HAPPEN FROM
024700*       PO REFERBACKS SINCE WE DON'T KNOW ITS LAST RECEIVER
024800           MOVE  14 TO LANG-SETNUM
024900           MOVE 102 TO LANG-MSGNUM
025000           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
025100           PERFORM 940-VSETERROR THRU 949-EXIT
025200           GO TO 120-SHOW-FORM.
025300     IF COND-WORD NOT = 0
025400        MOVE "DBGET MPORCV AT 100 SINQFRT" TO BU-DISPLAY-MSG
025500        PERFORM 990-BLOWUP THRU 999-EXIT.
025600
025700 105-FIND-DPOFREIGHT.
028200     MOVE SPACES             TO SCREEN-BUFFER-INQFRT.
           MOVE SPACES TO SAVE-PACK-SLIP.
           MOVE 0 TO COND-WORD.
           IF PASS-HISTORY-FLAG NOT = "Y"
               MOVE FRT-ARG TO PORCVNO OF DPOFREIGHT-REC
               START DPOFREIGHT KEY = PORCVNO OF DPOFREIGHT-REC
                   INVALID KEY MOVE 17 TO COND-WORD
               END-START
           ELSE
               MOVE FRT-ARG-2-14 TO PORCVNO OF DPOFREIGHT-ST-REC
               START DPOFREIGHT-ST KEY = PORCVNO OF DPOFREIGHT-ST-REC
                   INVALID KEY MOVE 17 TO COND-WORD
               END-START
           END-IF.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
                   MOVE 17 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.
026000     IF COND-WORD NOT = 0
024600*-----  DISPLAY "NO MORE RECEIVERS"...WILL ONLY HAPPEN FROM
024700*       PO REFERBACKS SINCE WE DON'T KNOW ITS LAST RECEIVER
024800           MOVE  14 TO LANG-SETNUM
024900           MOVE 102 TO LANG-MSGNUM
025000           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
025100           PERFORM 940-VSETERROR THRU 949-EXIT
025200           GO TO 120-SHOW-FORM.
           MOVE 0 TO COND-WORD.
           IF PASS-HISTORY-FLAG NOT = "Y"
               READ DPOFREIGHT NEXT INTO BUF-DPOFREIGHT
                   AT END MOVE 15 TO COND-WORD
               END-READ
           ELSE
               READ DPOFREIGHT-ST NEXT INTO BUF-DPOFREIGHT-H
                   AT END MOVE 15 TO COND-WORD
               END-READ
           END-IF.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   MOVE 15 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.
           IF PASS-HISTORY-FLAG NOT = "Y"
               IF PORCVNO  OF DPOFREIGHT-REC NOT = FRT-ARG
                   MOVE 15 TO COND-WORD
               END-IF
           ELSE
               IF PORCVNO  OF DPOFREIGHT-ST-REC NOT = FRT-ARG-2-14
                   MOVE 15 TO COND-WORD
               END-IF
           END-IF.
026500     IF COND-WORD NOT = 0
026600         IF COND-WORD = 15
026700             MOVE  14 TO LANG-SETNUM
026800             MOVE  75 TO LANG-MSGNUM
026900             PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
027000             PERFORM 940-VSETERROR THRU 949-EXIT
027100             GO TO  110-GET-FORM
027200         ELSE
                 IF PASS-HISTORY-FLAG NOT = "Y"
027300             MOVE "SINQFRT - FRT GET DB INFO" TO BU-DISPLAY-MSG
                 ELSE
027300             MOVE "SINQFRT FRT-ST GET DB INFO" TO BU-DISPLAY-MSG
                 END-IF
027400           PERFORM 990-BLOWUP THRU 999-EXIT.
027500
           IF PASS-HISTORY-FLAG NOT = "Y"
027600       IF FRT-REFER-RS NOT = SPACES
027700         MOVE FRT-REFER-PO   TO RFR-PO
027800         MOVE FRT-REFER-RLSE TO RFR-RLSE
027900         MOVE FRT-REFER-RS   TO RFR-RS
               MOVE "P"            TO RFR-PO-PREFIX
               IF PO-INVOICELESS-IND = "X"
                   MOVE FRT-PACK-SLIP TO SAVE-PACK-SLIP
               END-IF
027910         MOVE 0 TO LANG-MSGNUM
028000         PERFORM 800-RETRIEVE-MULTI THRU 809-EXIT
028010         IF LANG-MSGNUM = 75
028020            GO TO 110-GET-FORM
028030         ELSE
028040            IF LANG-MSGNUM = 102
028050               GO TO 120-SHOW-FORM
                  END-IF
               END-IF
               MOVE REFER-LIT TO VIEW-REFER-LIT
               MOVE FRT-PO-NUM TO VIEW-REFER-PO
               MOVE FRT-PO-RLSE TO VIEW-REFER-RLSE
               MOVE FRT-PO-RS TO VIEW-REFER-RS
               MOVE FRT-ARG TO FRT-PO-RCV-NO
             END-IF

             IF PO-INVOICELESS-IND = "X" AND
               SAVE-PACK-SLIP NOT = SPACES
               MOVE SAVE-PACK-SLIP TO FRT-PACK-SLIP
             END-IF
           ELSE
027600       IF FRTH-REFER-RS NOT = SPACES
027700         MOVE FRTH-REFER-PO   TO RFR-PO
027800         MOVE FRTH-REFER-RLSE TO RFR-RLSE
027900         MOVE FRTH-REFER-RS   TO RFR-RS
               IF POH-INVOICELESS-INDIC = "X"
                   MOVE FRTH-PACK-SLIP TO SAVE-PACK-SLIP
               END-IF
027910         MOVE 0 TO LANG-MSGNUM
028000         PERFORM 810-RETRIEVE-MULTI THRU 819-EXIT
028010         IF LANG-MSGNUM = 75
028020            GO TO 110-GET-FORM
028030         ELSE
028040            IF LANG-MSGNUM = 102
028050               GO TO 120-SHOW-FORM
                  END-IF
               END-IF
               MOVE REFER-LIT TO VIEW-REFER-LIT
               MOVE FRTH-PO-NUM TO VIEW-REFER-PO
               MOVE FRTH-PO-RLSE TO VIEW-REFER-RLSE
               MOVE FRTH-PO-RS TO VIEW-REFER-RS
               MOVE FRT-ARG-2-14 TO FRTH-PO-RCV-NO
             END-IF

             IF POH-INVOICELESS-INDIC = "X" AND
               SAVE-PACK-SLIP NOT = SPACES
               MOVE SAVE-PACK-SLIP TO FRTH-PACK-SLIP
             END-IF
           END-IF.
028100
028300     MOVE PASS-LAST-RECEIVER TO VIEW-LAST-RCVR.
           IF PASS-HISTORY-FLAG NOT = "Y"
028400         MOVE FRT-PO-NUM         TO VIEW-PO
028500         MOVE FRT-PO-RLSE        TO VIEW-RLSE
028600         MOVE FRT-PO-RS          TO VIEW-RS
028700         MOVE FRT-CARRIER        TO VIEW-CARRIER
028800         MOVE FRT-BILL-NO        TO VIEW-FRT-BILL
028900         MOVE 4                  TO DATE-MODE
029000         MOVE FRT-BILL-DATE      TO DATE-VALIDATE-IN
029100         CALL "TDATECHK" USING DATE-CHECK-AREA
029200         MOVE DATE-SLASH-OUT     TO VIEW-DATE
029300         MOVE FRT-CHARGES-9      TO VIEW-CHARGES
029400         MOVE FRT-PACK-SLIP      TO VIEW-PACK-SLIP
029500         MOVE FRT-CARRIER-WT     TO VIEW-CARR-WT
029600         MOVE FRT-OUR-WT         TO VIEW-OUR-WT
029700         MOVE FRT-SPLC           TO VIEW-ORIGIN
029800         MOVE FRT-EMPL           TO VIEW-EMPL
029900         MOVE FRT-LOT            TO VIEW-LOT
030000         MOVE FRT-RAIL-CAR       TO VIEW-CAR-NO
030100         MOVE FRT-SEALS          TO VIEW-SEALS
030200         MOVE FRT-OSD            TO VIEW-OSD
030300         MOVE M-PO-RCV-SEQ       TO VIEW-SEQUENCE
030400         MOVE PASS-PLT-NUMBER    TO PLT-WS
030500         IF PLT-1 = "11"
030600             MOVE FRT-ZBILL       TO VIEW-ZBILL
               END-IF
030700
030800         IF FRT-TYPE = "C"
030900             MOVE   3 TO LANG-SETNUM
031000             MOVE 155 TO LANG-MSGNUM
031100             PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
031200             MOVE MESSAGE-BUFFER TO VIEW-TYPE
031300         ELSE
031400         IF FRT-TYPE = "G"
031500             MOVE "GOODYEAR" TO VIEW-TYPE
031600         ELSE
031700         IF FRT-TYPE = "P"
031800             MOVE  16 TO LANG-SETNUM
031900             MOVE  97 TO LANG-MSGNUM
032000             PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
032100             MOVE MESSAGE-BUFFER TO VIEW-TYPE
032200         ELSE
032300         IF FRT-TYPE = "U"
032400             MOVE  21 TO LANG-SETNUM
032500             MOVE  14 TO LANG-MSGNUM
032600             PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
032700             MOVE MESSAGE-BUFFER TO VIEW-TYPE
032800         ELSE
032900         IF FRT-TYPE = "D"
033000             MOVE  12 TO LANG-SETNUM
033100             MOVE   8 TO LANG-MSGNUM
033200             PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
033300             MOVE MESSAGE-BUFFER TO VIEW-TYPE
               END-IF
               END-IF
               END-IF
               END-IF
               END-IF
           ELSE
028400         MOVE FRTH-PO-NUM        TO VIEW-PO
028500         MOVE FRTH-PO-RLSE       TO VIEW-RLSE
028600         MOVE FRTH-PO-RS         TO VIEW-RS
028700         MOVE FRTH-CARRIER       TO VIEW-CARRIER
028800         MOVE FRTH-BILL-NO       TO VIEW-FRT-BILL
028900         MOVE 4                  TO DATE-MODE
      *---------YEAR 2000 COMPLIANCE
      *---------BEFORE TDATECHK CALL, SUBTRACT 19M/20M FROM BINARY DATE
               IF FRTH-BILL-DATE = 0
                   MOVE SPACES             TO VIEW-DATE
               ELSE
                   MOVE FRTH-BILL-DATE     TO TEMP-DATE
                   IF TEMP-YEAR > 70
                       COMPUTE DISPLAY-DATE = FRTH-BILL-DATE - 19000000
                   ELSE
                       COMPUTE DISPLAY-DATE = FRTH-BILL-DATE - 20000000
                   END-IF
                   MOVE DISPLAY-DATE       TO DATE-VALIDATE-IN
      *------------ FORMAT DATE FOR DISPLAY
029100             CALL "TDATECHK" USING DATE-CHECK-AREA
029200             MOVE DATE-SLASH-OUT     TO VIEW-DATE
               END-IF
029300         MOVE FRTH-CHARGES       TO VIEW-CHARGES
029400         MOVE FRTH-PACK-SLIP     TO VIEW-PACK-SLIP
029500         MOVE FRTH-CARRIER-WT    TO VIEW-CARR-WT
029600         MOVE FRTH-OUR-WT        TO VIEW-OUR-WT
029700         MOVE FRTH-SPLC          TO VIEW-ORIGIN
029800         MOVE FRTH-EMPL          TO VIEW-EMPL
029900         MOVE FRTH-LOT           TO VIEW-LOT
030000         MOVE FRTH-RAIL-CAR      TO VIEW-CAR-NO
030100         MOVE FRTH-SEALS         TO VIEW-SEALS
030200         MOVE FRTH-OSD           TO VIEW-OSD
               MOVE FRTH-OSD-CLAIM     TO VIEW-OSD-CLAIM
      *----------JSB 04/03/97 SHOW SEQUENCE NUMBER INSTEAD OF SPACES
               MOVE FRTH-RCVR-SEQ-NO   TO VIEW-SEQUENCE
030400         MOVE PASS-PLT-NUMBER    TO PLT-WS
030500         IF PLT-1 = "11"
030600             MOVE SPACES         TO VIEW-ZBILL
               END-IF
030700
030800         IF FRTH-TYPE = "C"
030900             MOVE   3 TO LANG-SETNUM
031000             MOVE 155 TO LANG-MSGNUM
031100             PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
031200             MOVE MESSAGE-BUFFER TO VIEW-TYPE
031300         ELSE
031400         IF FRTH-TYPE = "G"
031500             MOVE "GOODYEAR" TO VIEW-TYPE
031600         ELSE
031700         IF FRTH-TYPE = "P"
031800             MOVE  16 TO LANG-SETNUM
031900             MOVE  97 TO LANG-MSGNUM
032000             PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
032100             MOVE MESSAGE-BUFFER TO VIEW-TYPE
032200         ELSE
032300         IF FRTH-TYPE = "U"
032400             MOVE  21 TO LANG-SETNUM
032500             MOVE  14 TO LANG-MSGNUM
032600             PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
032700             MOVE MESSAGE-BUFFER TO VIEW-TYPE
032800         ELSE
032900         IF FRTH-TYPE = "D"
