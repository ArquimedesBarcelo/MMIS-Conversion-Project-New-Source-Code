000200 IDENTIFICATION DIVISION.
000300 PROGRAM-ID.    TPOPRTBT.
000500 AUTHOR.        KURT-MOVSESIAN.
000800
000900**************************************************************
001000*                                                            *
001100*D  T P O P R T B T  MAIN PROGRAM TO REPRINT POs IN A BATCH  *
001200*D                   MODE.  THIS PROGRAM IS CALLED IN A JOB  *
001300*D                   STREAM KICKED OFF BY THE ONLINE PO      *
001400*D                   REPRINT PROGRAM FOR ORDERS THAT TAKE    *
001500*D                   TO LONG TO PRINT ONLINE SUCH AS         *
001600*D                   REQUIREMENT ORDERS                      *
001700*                                                            *
001800*   SUBROUTINES CALLED:                                      *
001900*                           1) TPOPRNT.SOURCE                *
002000*                                                            *
002100**************************************************************
005100
005200
005300 ENVIRONMENT DIVISION.
005400 CONFIGURATION SECTION.
005500 SOURCE-COMPUTER.  HP-3000.
005600 OBJECT-COMPUTER.  HP-3000.
005700
005800
005900 DATA DIVISION.
006000 FILE SECTION.
006100
006200 WORKING-STORAGE SECTION.
006300
006400**************************************************************
006500**
006600**        DATABASE I/O WORK AREA
006700**
006800**************************************************************
007000
007100 COPY DATAB IN COPYLIB.
008200
008300 01  PO-PRINT-PARMS.
008400     05  PO-NUMBER.
008500         10  FILLER            PIC X.
008600         10  PETTY-PO-CHECK    PIC X.
008700         10  FILLER            PIC X(12).
008800     05  PO-REPRINT            PIC X.
008900     05  PO-PRINT-TYPE         PIC X.
009000     05  PO-MODIFIED-ORDER     PIC X.
009100     05  PO-CANCELLED-ORDER    PIC X.
009200     05  PO-PRINT-NUM          PIC  9(2)  COMP-4.
009300     05  PO-ITEMS.
009400         10  PO-ITMS OCCURS 15 TIMES.
009500             15  PO-ITEM           PIC X(4).
009700
010700
011300 COPY ESCNAM2 IN COPYLIB.

       COPY LANGUAGE IN COPYLIB.

       LINKAGE SECTION.

       01  PARM1.
002300     05  STRM-ROUTE-DATA.                                         STRMJOB
002400         10  STRM-RT-NAME          PIC X(15).                     STRMJOB
002500         10  STRM-RT-DEPT          PIC X(4).                      STRMJOB
002600         10  STRM-RT-LP            PIC 9(3).                      STRMJOB
002700         10  STRM-RT-USER          PIC X(8).                      STRMJOB
002800         10  STRM-RT-ACCOUNT       PIC X(8).                      STRMJOB
002900         10  STRM-RT-GROUP         PIC X(8).                      STRMJOB
003000         10  STRM-RT-TERM          PIC X(4).                      STRMJOB
003100         10  STRM-RT-PAPER-FLAG    PIC X(1).                      STRMJOB
003200         10  STRM-RT-PRTRPT-FLAG   PIC X(1).                      STRMJOB
003300         10  STRM-RT-NO-OF-COPIES  PIC 9(2).                      STRMJOB
003400         10  FILLER                PIC X(26).                     STRMJOB
       01  PARM2.
009800     05  PO-PRINT-OPTIONS.
009900         10  ACCP-PO-NUM          PIC X(14).
010000         10  ACCP-PO-REPRINT      PIC X.
010100         10  ACCP-PO-TYPE         PIC X.
010200         10  ACCP-MOD-ORDER       PIC X.
010300         10  ACCP-CANC-ORDER      PIC X.
010400         10  ACCP-PO-PRINT-NUM    PIC 9(2) COMP-4.
      *    THE FOLLOWING BYTE OF INFORMATION PASSED FROM
      *    TSTRMJOB TO ALLOW THE USER TO SELECT THE OPTION
      *    TO PRINT A P.O. WITH NO ESCAPE SEQUENCES APPLIED
      *    WAS REMOVED WHEN DANVILLE FOUND THAT ALL OF THEIR
      *    BATCH PRINTS WERE NOT PRINTING THE ITEMS. THE
      *    TPOPRNT PROGRAM WAS THROWN OFF ONE BYTE IN TRYING
      *    TO DETERMINE THE ITEMS THAT IT WAS GOING TO PRINT
      *    AND ACTUALLY PRINTED NO ITEMS AT ALL......JEC.
      *        10  ACCP-NO-ESCAPE-PRINT PIC X.
010500         10  ACCP-PO-ITEMS        PIC X(60).
      *------------ PUT NO ESCAPE SEQUENCE SWITCH BACK IN, THIS
      *------------ TIME, AFTER THE ITEMS FIELD.
               10  ACCP-NO-ESCAPE-PRINT PIC X.
           05  FILLER               PIC X(140).

011700
011800 PROCEDURE DIVISION USING PARM1,
                                PARM2.

012000 PROC-DIV SECTION 01.
012100
012200 BEGIN-HERE.
012300     PERFORM 1-HSK THRU 1-H-X.
012400
012500     PERFORM 6-MAIN THRU 6-M-X.
012600
012900     GOBACK.
013000
013100 1-HSK.
013300     CALL "TESCSEQ"  USING ESC-NAME.
015900
016000 1-H-X.
016100     EXIT.
016200
017300
018700
018800 6-MAIN.
019100     DISPLAY PO-PRINT-OPTIONS.
019200
019300     MOVE ACCP-PO-ITEMS            TO  PO-ITEMS.
019400     MOVE ACCP-PO-NUM              TO  PO-NUMBER.
019500     MOVE ACCP-PO-REPRINT          TO  PO-REPRINT.
019600     MOVE ACCP-PO-TYPE             TO  PO-PRINT-TYPE.
019700     MOVE ACCP-MOD-ORDER           TO  PO-MODIFIED-ORDER.
019800     MOVE ACCP-CANC-ORDER          TO  PO-CANCELLED-ORDER.
019900     MOVE ACCP-PO-PRINT-NUM        TO  PO-PRINT-NUM.
020100
           IF ACCP-NO-ESCAPE-PRINT = "X"
               CALL "TPOPRNT2" USING BASE,
                                PO-PRINT-PARMS,
                                ESC-NAME,
                                LANGUAGE-PARMS
           ELSE
020200         CALL "TPOPRNT" USING BASE,
020300                          PO-PRINT-PARMS,
020400                          ESC-NAME,
020500                          LANGUAGE-PARMS.
020600 6-M-X.
020700     EXIT.
