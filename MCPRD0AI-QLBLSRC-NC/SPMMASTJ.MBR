       IDENTIFICATION DIVISION.
       PROGRAM-ID.             SPMMASTJ.
       AUTHOR.                 W. ROXBURY.
      *REMARKS.                PM MASTER JOBPLAN EDITOR.
       INSTALLATION.           GOODYEAR TIRE & RUBBER CO.
      *C************************************************************************
      *C***  CRAFT REQUIRED CHECK REMOVED PER                                ***
      *C***  NAPANEE/DANVILLE REQUEST OUT OF THE PM SEMINAR IN NAPANEE IN    ***
      *C***  OCT. 1992                     WDR  OCT. 19, 1992                ***
      *C************************************************************************
      *C***  ADDED CARRY-THROUGH FOR PERSONNEL INFORMATION FOR TPERPASS      ***
      *C***  ADDITION OF MAIL FUNCTION NOW ALLOWS THIS                       ***
      *C***                                WDR  DEC. 15, 1993                ***
      *C************************************************************************
      *C***  EXPAND DATE FIELDS FOR YEAR 2000 COMPLIANCE.                    ***
      *C***  INCLUDE CENTURY ON JOBPLAN KEY DATE STAMP.                      ***
      *C***                                JEFF BUNGO  OCT. 14, 1996         ***
      *C************************************************************************
      *C
      *C   03/11/1998   CA YODER   REQ #97-1125
      *C     CHANGED PASSWORD FROM 6 TO 8 FOR CALL TO "TPERPASS."
      *C
       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.
       SOURCE-COMPUTER.        HP-3000.
       OBJECT-COMPUTER.        HP-3000.

       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT DISPLAY-FILE
                  ASSIGN       TO WORKSTATION-ZPMMAINT-SI
                  ORGANIZATION IS TRANSACTION
                  ACCESS MODE  IS DYNAMIC
                  RELATIVE KEY IS RECNO
                  FILE STATUS  IS SCREEN-STATUS
                               MAJOR-MINOR
                  CONTROL-AREA IS SCREEN-CONTROL.

           SELECT MSTORERM
                  ASSIGN       TO DATABASE-MCFLCS0201
                  ORGANIZATION IS INDEXED
                  ACCESS MODE  IS DYNAMIC
                  RECORD KEY   IS EXTERNALLY-DESCRIBED-KEY
                  FILE STATUS  IS FILE-STAT.

           SELECT PM-JOBPLAN
                  ASSIGN       TO DATABASE-MCFLMM4101
                  ORGANIZATION IS INDEXED
                  ACCESS MODE  IS DYNAMIC
                  RECORD KEY   IS EXTERNALLY-DESCRIBED-KEY
                               WITH DUPLICATES
                  FILE STATUS  IS FILE-STAT.

           SELECT PM-JOBPLAN-TASK
                  ASSIGN       TO DATABASE-MCFLMM4102
                  ORGANIZATION IS INDEXED
                  ACCESS MODE  IS DYNAMIC
                  RECORD KEY   IS EXTERNALLY-DESCRIBED-KEY
                               WITH DUPLICATES
                  FILE STATUS  IS FILE-STAT.

           SELECT PM-JOBPLAN-TASK-I
                  ASSIGN       TO DATABASE-MCFLMM4102
                  ORGANIZATION IS INDEXED
                  ACCESS MODE  IS DYNAMIC
                  RECORD KEY   IS EXTERNALLY-DESCRIBED-KEY
                               WITH DUPLICATES
                  FILE STATUS  IS FILE-STAT.

           SELECT PM-JOBPLAN-KEYS
                  ASSIGN       TO DATABASE-MCFLMM4002
                  ORGANIZATION IS INDEXED
                  ACCESS MODE  IS DYNAMIC
                  RECORD KEY   IS EXTERNALLY-DESCRIBED-KEY
                               WITH DUPLICATES
                  FILE STATUS  IS FILE-STAT.

           SELECT PM-JOBPLAN-KEYS-I
                  ASSIGN       TO DATABASE-MCFLMM4002
                  ORGANIZATION IS INDEXED
                  ACCESS MODE  IS DYNAMIC
                  RECORD KEY   IS EXTERNALLY-DESCRIBED-KEY
                               WITH DUPLICATES
                  FILE STATUS  IS FILE-STAT.

           SELECT PM-JOBP-KEYS-TASK
                  ASSIGN       TO DATABASE-MCFLMM4003
                  ORGANIZATION IS INDEXED
                  ACCESS MODE  IS DYNAMIC
                  RECORD KEY   IS EXTERNALLY-DESCRIBED-KEY
                  FILE STATUS  IS FILE-STAT.

           SELECT PM-JOBP-KEYS-TASK-I
                  ASSIGN       TO DATABASE-MCFLMM4003
                  ORGANIZATION IS INDEXED
                  ACCESS MODE  IS DYNAMIC
                  RECORD KEY   IS EXTERNALLY-DESCRIBED-KEY
                               WITH DUPLICATES
                  FILE STATUS  IS FILE-STAT.

           SELECT WO-CRAFTS-REQD
                  ASSIGN       TO DATABASE-MCFLMM0601
                  ORGANIZATION IS INDEXED
                  ACCESS MODE  IS DYNAMIC
                  RECORD KEY   IS EXTERNALLY-DESCRIBED-KEY
                  FILE STATUS  IS FILE-STAT.

       DATA DIVISION.
       FILE SECTION.
       FD  DISPLAY-FILE
           LABEL RECORDS       ARE OMITTED.
       01  DISPLAY-REC         PIC X(2000).

       FD  MSTORERM
           LABEL RECORDS       ARE STANDARD.
       01  MSTORERM-REC.
           COPY DDS-ALL-FORMATS OF MCFLCS0201.

       FD  PM-JOBPLAN
           LABEL RECORDS       ARE STANDARD.
       01  PM-JOBPLAN-REC.
           COPY DDS-ALL-FORMATS OF MCFLMM4101.

       FD  PM-JOBPLAN-TASK
           LABEL RECORDS       ARE STANDARD.
       01  PM-JOBPLAN-TASK-REC.
           COPY DDS-ALL-FORMATS OF MCFLMM4102.

       FD  PM-JOBPLAN-TASK-I
           LABEL RECORDS       ARE STANDARD.
       01  PM-JOBPLAN-TASK-I-REC.
           COPY DDS-ALL-FORMATS OF MCFLMM4102.

       FD  PM-JOBPLAN-KEYS
           LABEL RECORDS       ARE STANDARD.
       01  PM-JOBP-KEYS-REC.
           COPY DDS-ALL-FORMATS OF MCFLMM4002.

       FD  PM-JOBPLAN-KEYS-I
           LABEL RECORDS       ARE STANDARD.
       01  PM-JOBP-KEYS-I-REC.
           COPY DDS-ALL-FORMATS OF MCFLMM4002.

       FD  PM-JOBP-KEYS-TASK
           LABEL RECORDS       ARE STANDARD.
       01  PM-JOBP-KEYS-TASK-REC.
           COPY DDS-ALL-FORMATS OF MCFLMM4003.

       FD  PM-JOBP-KEYS-TASK-I
           LABEL RECORDS       ARE STANDARD.
       01  PM-JOBP-KEYS-TASK-I-REC.
           COPY DDS-ALL-FORMATS OF MCFLMM4003.

       FD  WO-CRAFTS-REQD
           LABEL RECORDS       ARE STANDARD.
       01  WO-CRAFTS-REQD-REC.
           COPY DDS-ALL-FORMATS OF MCFLMM0601.

