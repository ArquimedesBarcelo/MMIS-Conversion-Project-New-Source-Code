       LINKAGE SECTION.
       01  PLANT-CODE          PIC X(03).

       01  WO-PERS-DATA.       COPY MPERSONL IN COPYLIB.

       01  DBPARAMETERS.       COPY DBPARMS  IN COPYLIB.

           COPY VCOMLINK       IN COPYLIB.

           COPY LANGSUB        IN COPYLIB.

       PROCEDURE DIVISION      USING PLANT-CODE
                               WO-PERS-DATA
                               DBPARAMETERS
                               VIEW-COMAREA
                               LANGUAGE-PARMS.
       BEGIN SECTION 01.
       BEGN.
           MOVE SPACES         TO CNUM-BUFFER PWORD-BUFFER
                                  SEQUENCING-SCREEN JPNAMEHOLD.
           CALL "TPWORD"       USING PASSWORD-INFORMATION.
           IF PASSWORD-FLAG = "N"
               GO TO END-OF-JOB-GOBACK.

           MOVE PER-CC-NUM     TO CNUM-BUF.
           MOVE PER-EMP-NAME   TO CNAM-BUF.
           MOVE PER-PWORD      TO PWORD-BUFFER.
           IF PERPASS-SW NOT = "ON"
               MOVE "ON"       TO PERPASS-SW
               CALL "TPERPASS" USING CNUM-BUF
                               CNAM-BUF
                               PWORD-BUFFER
                               PWORD-SWITCH
               IF PWORD-SWITCH = "N"
                   MOVE "  "   TO PERPASS-SW
                   GO TO END-OF-JOB-GOBACK.

           OPEN I-O            DISPLAY-FILE
                               PM-JOBPLAN
                               PM-JOBPLAN-KEYS
                               PM-JOBPLAN-TASK
                               PM-JOBP-KEYS-TASK.

           OPEN INPUT          MSTORERM
                               PM-JOBPLAN-KEYS-I
                               PM-JOBPLAN-TASK-I
                               PM-JOBP-KEYS-TASK-I
                               WO-CRAFTS-REQD.

       MAIN.
           PERFORM SET-VALUES.
           MOVE "VJOBPLAN_MENU" TO SCREEN-NAME.
           MOVE SPACES         TO JP-TASK-KEY.
           MOVE SPACES         TO ENTRY-SCREEN.
           MOVE CNUM-BUF       TO EDITOR-CC.
           MOVE CNAM-BUF       TO EDITOR-NAME.
           MOVE JPNAMEHOLD     TO JP-KEY-BUF.

       SHOWFORM-MAIN.
           MOVE 1              TO FIELD-NUMBER.
           MOVE ENTRY-SCREEN   TO DISPLAY-REC.
           PERFORM SHOWFORM    THRU SHOWFORM-EXIT.
           MOVE DISPLAY-REC    TO ENTRY-SCREEN.

           IF KEY-HIT = 3 OR 8
               GO TO END-OF-JOB.

           IF KEY-HIT = 7
               MOVE 31         TO HELP-SW
               CALL "SPMHELPM" USING HELP-SW
               MOVE MESSAGE-BUFFER TO ERRMSG-ENTRY
               GO TO SHOWFORM-MAIN.

           IF JP-KEY-BUF = SPACES
               GO TO SHOWFORM-MAIN.

           IF JP-KEY-BUF NOT = JPNAMEHOLD
               MOVE SPACES     TO SEQ-INCREMENT
               MOVE JP-KEY-BUF TO JPNAMEHOLD.

           MOVE JP-KEY-BUF     TO JP-KEY-D1
                                  JP-KEY-D2
                                  JP-KEY-D4
                                  JP-KEY-D5
                                  JP-KEY-D6.

           IF KEY-HIT = 4 OR 5 OR 6
               MOVE SPACES     TO JP-SEQ-BUF.

           MOVE JP-SEQ-BUF     TO ADJ-4.
           PERFORM ADJUST-4.
           MOVE ADJ-4          TO JP-SEQ-BUF.

           IF JP-SEQ-BUF NOT NUMERIC
               MOVE SPACES     TO JP-SEQ-BUF.

           IF JP-SEQ-BUF = "0000"
               MOVE SPACES     TO JP-SEQ-BUF.

           IF KEY-HIT = 0
               GO TO SHOWFORM-MAIN.

       READ-KEY-RECORD.
           PERFORM GET-KEY-RECORD THRU GKR-EXIT.
           IF FILE-STAT = "10" OR "14" OR "46"
               IF KEY-HIT = 1
                   PERFORM WRITE-KEY-RECORD THRU WKR-EXIT
                   IF KEY-HIT = 3 OR 8
                       GO TO SHOWFORM-MAIN
                   ELSE
                       IF FILE-STAT NOT = "00"
                           MOVE MESSAGE-BUFFER TO ERRMSG-ENTRY
                           MOVE 1  TO FIELD-NUMBER
                           PERFORM SET-ERROR
                           GO TO SHOWFORM-MAIN
                       ELSE
                           MOVE 1      TO KEY-SW
                           GO TO ADD-MODE
               ELSE
      *M********************************************************************
      *M    MESSAGE 036/008:
      *M JOBPLAN DOES NOT EXIST
      *M********************************************************************
               MOVE  36        TO LANG-SETNUM
               MOVE   8        TO LANG-MSGNUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE CATREAD-MSG-TEXT TO ERRMSG-ENTRY
               MOVE 1          TO FIELD-NUMBER
               PERFORM SET-ERROR
               GO TO SHOWFORM-MAIN
           ELSE
           IF FILE-STAT NOT = "00"
               MOVE MESSAGE-BUFFER TO ERRMSG-SCREEN
               MOVE 1          TO FIELD-NUMBER
               PERFORM SET-ERROR
               GO TO SHOWFORM-MAIN.

           IF RECORD-KEY NOT = "KEYREC"
      *M********************************************************************
      *M    MESSAGE 036/008:
      *M JOBPLAN DOES NOT EXIST
      *M********************************************************************
               MOVE  36        TO LANG-SETNUM
               MOVE   8        TO LANG-MSGNUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE CATREAD-MSG-TEXT TO ERRMSG-ENTRY
               MOVE 1          TO FIELD-NUMBER
               PERFORM SET-ERROR
               GO TO SHOWFORM-MAIN.

           MOVE PMJPK-ORIGINATOR TO OWNR.

           IF PROCESS-FLAG NOT = "  "
               MOVE JP-KEY-BUF TO RENUM-JP-BUF
               MOVE 9999       TO RENUM-START-BUF
                                  RENUM-INCR-BUF
               MOVE SPACES     TO RENUM-EDITOR
               CALL "SPMRENUM" USING DBPARAMETERS
                               RETURN-MSG
                               VIEW-COMAREA
                               LANGUAGE-PARMS
                               RENUM-JP-BUF
                               RENUM-START-BUF
                               RENUM-INCR-BUF
                               RENUM-EDITOR
               IF RETURN-BYTE NOT = "0"
      *M********************************************************************
      *M    MESSAGE 036/014:
      *M JOBPLAN IS CORRUPTED - A PRIOR RENUMBERING SEQUENCE HAS FAILED
      *M********************************************************************
                   MOVE  36    TO LANG-SETNUM
                   MOVE  14    TO LANG-MSGNUM
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE CATREAD-MSG-TEXT TO ERRMSG-ENTRY
                   MOVE 1      TO FIELD-NUMBER
                   PERFORM SET-ERROR
                   GO TO SHOWFORM-MAIN
               ELSE
                   GO TO READ-KEY-RECORD.

           IF KEY-HIT = 1      MOVE 2 TO KEY-HIT.

       PARSE-KEY-HIT.
           IF KEY-HIT = 2 AND JP-MC-SEL NOT = SPACE
               MOVE JP-KEY-BUF TO JPNAMEKEY
               CALL "SPMCHGLVL" USING JPNAMEKEY
               MOVE SPACE      TO JP-MC-SEL
               GO TO SHOWFORM-MAIN
           ELSE
           IF KEY-HIT = 4
               GO TO COPY-FUNCTION
           ELSE
           IF KEY-HIT = 5
               GO TO RENUMBER-FUNCTION
           ELSE
           IF KEY-HIT = 6
               GO TO DELETE-FUNCTION.

           IF JP-SEQ-BUF = "0000"
               MOVE SPACES     TO JP-SEQ-BUF.

           IF JP-SEQ-BUF = "    "
               IF SEQ-INCREMENT = "    "
                   MOVE SCREEN-NAME TO SAVEFORM
                   MOVE KEY-HIT TO KEY-SAVE
                   PERFORM SEQUENCING-FUNCTION THRU SF-EXIT
                   MOVE SAVEFORM   TO SCREEN-NAME
                   MOVE KEY-SAVE TO KEY-HIT.

           IF JP-SEQ-BUF = "    "
               IF KEY-HIT = 1
                   MOVE SEQ-INCREMENT TO JP-SEQ-BUF
                   GO TO ADD-MODE
               ELSE
                   PERFORM GET-LAST-TASK THRU GLT-EXIT
                   IF FILE-STAT = "10" OR "14" OR "46"
                       MOVE SEQ-INCREMENT TO JP-SEQ-BUF
                       GO TO ADD-MODE
                   ELSE
                   IF FILE-STAT NOT = "00"
                       MOVE MESSAGE-BUFFER TO ERRMSG-ENTRY
                       MOVE 1  TO FIELD-NUMBER
                       PERFORM SET-ERROR
                       GO TO SHOWFORM-MAIN
                   ELSE
                       MOVE PMJPK-TASK-NUM TO TASK-SAVE
                       ADD SEQ-INC    TO TASK-SAVE-9
                       MOVE TASK-SAVE TO JP-SEQ-BUF
                       GO TO ADD-MODE.

           MOVE JP-KEY-BUF     TO JPKEY-NAME.
           MOVE JP-SEQ-BUF     TO JPKEY-TASK.
           PERFORM CHECK-FOR-TASK THRU CFT-EXIT.
           IF FILE-STAT = "10" OR "14" OR "46" OR "23"
               GO TO ADD-MODE
           ELSE
           IF FILE-STAT NOT = "00"
               MOVE "VJOBPLAN-MENU" TO SCREEN-NAME
               MOVE MESSAGE-BUFFER TO ERRMSG-ENTRY
               MOVE 1          TO FIELD-NUMBER
               PERFORM SET-ERROR
               GO TO SHOWFORM-MAIN.

           MOVE "  "           TO RETURN-COD
           PERFORM READ-LOOP   THRU READ-EXIT
           IF RETURN-COD NOT = "  "
               MOVE "VJOBPLAN_MENU" TO SCREEN-NAME
               MOVE 1          TO FIELD-NUMBER
               PERFORM SET-ERROR
               GO TO SHOWFORM-MAIN.

           GO TO DISPLAY-MODE.

       ADD-MODE.
           IF SEQ-INCREMENT = "    "
               PERFORM SEQUENCING-FUNCTION THRU SF-EXIT.

           IF JP-SEQ-BUF = "    "
               MOVE SEQ-INCREMENT TO JP-SEQ-BUF.

           MOVE "VJOBPLAN_BAN" TO SCREEN-NAME.
           MOVE 0              TO SUB.
           MOVE JP-KEY-BUF     TO JP-KEY-DISP.
           MOVE JP-SEQ-BUF     TO JP-SEQ-DISP.
           MOVE OWNR           TO OWNER-BUF.
           MOVE CNUM-BUF       TO EDITOR-BUF.

       SHOWFORM-ADD.
           MOVE 4              TO FIELD-NUMBER.
           MOVE SCREEN-DATA    TO DISPLAY-REC.
           PERFORM SHOWFORM    THRU SHOWFORM-EXIT.
           MOVE DISPLAY-REC    TO SCREEN-DATA.
           MOVE 0              TO ERROR-SW.
           MOVE 1              TO SAVE-SW.

           IF KEY-HIT = 8
               IF NO-DATA
                   PERFORM CHECK-FOR-DATA THRU CFD-EXIT
                   IF NO-DATA  GO TO MAIN.

           IF KEY-HIT = 8
               MOVE "AD"       TO RETURN-SCREEN
               GO TO SAVE-DATA.

           IF KEY-HIT = 6
               GO TO OPTIONS-MENU.

           IF KEY-HIT = 7
               MOVE  321       TO HELP-SW
               CALL "SPMHELPM" USING HELP-SW
               MOVE MESSAGE-BUFFER TO ERRMSG-SCREEN
               GO TO SHOWFORM-ADD.

           IF KEY-HIT = 0 OR 2 OR 3 OR 4
               NEXT SENTENCE
           ELSE
               GO TO SHOWFORM-ADD.

           IF KEY-HIT = 3
               PERFORM CHECK-FOR-DATA THRU CFD-EXIT
               IF NO-DATA
                   MOVE JP-KEY-SEQ TO DEL-KEY-SEQ
                   PERFORM GET-PREV-TASK THRU GPT-EXIT
                   IF DEL-KEY-SEQ NOT = JP-KEY-SEQ
                       PERFORM DELETE-BLANK-TASK THRU DBT-EXIT
                   END-IF
                   MOVE 2      TO KEY-HIT
                   PERFORM SET-VALUES
                   GO TO PARSE-KEY-HIT.

           IF JP-LEVEL-BUF = SPACES
      *M********************************************************************
      *M    MESSAGE 038/013:
      *M LEVEL NUMBER IS REQUIRED
      *M********************************************************************
               MOVE  38        TO LANG-SETNUM
               MOVE  13        TO LANG-MSGNUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE CATREAD-MSG-TEXT TO ERRMSG-SCREEN
               MOVE 4          TO FIELD-NUMBER ERROR-SW
               PERFORM SET-ERROR
               GO TO SHOWFORM-ADD.

           MOVE JP-LEVEL-BUF   TO ADJ-2.
           PERFORM ADJUST-2.
           MOVE ADJ-2          TO JP-LEVEL-BUF.

           IF JP-LEVEL-BUF NOT NUMERIC
      *M********************************************************************
      *M    MESSAGE 038/014:
      *M LEVEL NUMBER MUST BE NUMERIC
      *M********************************************************************
               MOVE  38        TO LANG-SETNUM
               MOVE  14        TO LANG-MSGNUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE CATREAD-MSG-TEXT TO ERRMSG-SCREEN
               MOVE 4          TO FIELD-NUMBER ERROR-SW
               PERFORM SET-ERROR
               GO TO SHOWFORM-ADD.

           MOVE JP-EXFLAG-BUF  TO ADJ-2.
           PERFORM ADJUST-2.
           MOVE ADJ-2          TO JP-EXFLAG-BUF.
           IF JP-EXFLAG-BUF = "00"
               MOVE "99"       TO JP-EXFLAG-BUF.

           IF JP-EXFLAG-BUF NOT NUMERIC
      *M********************************************************************
      *M    MESSAGE 031/063:
      *M EXCEPTION FLAG MUST BE NUMERIC
      *M********************************************************************
               MOVE  31        TO LANG-SETNUM
               MOVE  63        TO LANG-MSGNUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE CATREAD-MSG-TEXT TO ERRMSG-SCREEN
               MOVE 5          TO FIELD-NUMBER ERROR-SW
               PERFORM SET-ERROR
               GO TO SHOWFORM-ADD.

           MOVE SUBSYS-BUF     TO ADJ-4.
           PERFORM ADJUST-4.
           MOVE ADJ-4          TO SUBSYS-BUF.

           IF SUBSYS-BUF NOT NUMERIC
      *M********************************************************************
      *M    MESSAGE 045/044:
      *M SUBSYSTEM MUST BE 4 DIGITS NUMERIC
      *M********************************************************************
               MOVE  45        TO LANG-SETNUM
               MOVE  44        TO LANG-MSGNUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE CATREAD-MSG-TEXT TO ERRMSG-SCREEN
               MOVE 6          TO FIELD-NUMBER ERROR-SW
               PERFORM SET-ERROR
               GO TO SHOWFORM-ADD.

           IF SUBSYS-BUF = "0000" MOVE "    " TO SUBSYS-BUF.

      *C************************************************************************
      *C***  CRAFT REQUIRED CHECK REMOVED PER                                ***
      *C***  NAPANEE/DANVILLE REQUEST OUT OF THE PM SEMINAR IN NAPANEE IN    ***
      *C***  OCT. 1992                     WDR  OCT. 19, 1992                ***
      *C************************************************************************
      *    IF CRAFT-BUF = SPACES
      *M********************************************************************
      *M    MESSAGE 041/006:
      *M ONE CRAFT ENTRY IS REQUIRED
      *M********************************************************************
      *        MOVE  41        TO LANG-SETNUM
      *        MOVE   6        TO LANG-MSGNUM
      *        PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
      *        MOVE CATREAD-MSG-TEXT TO ERRMSG-SCREEN
      *        MOVE 7          TO FIELD-NUMBER ERROR-SW
      *        PERFORM SET-ERROR
      *        GO TO SHOWFORM-ADD.

           IF CRAFT-1-BUF = SPACES
               MOVE CRAFT-2-BUF TO CRAFT-1-BUF
               MOVE CRAFT-3-BUF TO CRAFT-2-BUF
               MOVE SPACES      TO CRAFT-3-BUF.

           IF CRAFT-1-BUF = SPACES
               MOVE CRAFT-2-BUF TO CRAFT-1-BUF
               MOVE CRAFT-3-BUF TO CRAFT-2-BUF
               MOVE SPACES      TO CRAFT-3-BUF.

           IF CRAFT-2-BUF = SPACES
               MOVE CRAFT-3-BUF TO CRAFT-2-BUF
               MOVE SPACES      TO CRAFT-3-BUF.

           IF CRAFT-1-BUF = SPACES
               NEXT SENTENCE
           ELSE
           MOVE CRAFT-1-BUF    TO CRAFTREQD OF WO-CRAFTS-REQD
           START WO-CRAFTS-REQD KEY = CRAFTREQD OF WO-CRAFTS-REQD
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT
           END-START
           IF FILE-STAT NOT = "00"
      *M********************************************************************
      *M    MESSAGE 035/037:
      *M INVALID CRAFT
      *M********************************************************************
               MOVE  35        TO LANG-SETNUM
               MOVE  37        TO LANG-MSGNUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE CATREAD-MSG-TEXT TO ERRMSG-SCREEN
               MOVE 7          TO FIELD-NUMBER ERROR-SW
               PERFORM SET-ERROR
               GO TO SHOWFORM-ADD.

           IF CRAFT-2-BUF = SPACES
               NEXT SENTENCE
           ELSE
           MOVE CRAFT-2-BUF    TO CRAFTREQD OF WO-CRAFTS-REQD
           START WO-CRAFTS-REQD KEY = CRAFTREQD OF WO-CRAFTS-REQD
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT
           END-START
           IF FILE-STAT NOT = "00"
      *M********************************************************************
      *M    MESSAGE 035/037:
      *M INVALID CRAFT
      *M********************************************************************
               MOVE  35        TO LANG-SETNUM
               MOVE  37        TO LANG-MSGNUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE CATREAD-MSG-TEXT TO ERRMSG-SCREEN
               MOVE 88         TO FIELD-NUMBER ERROR-SW
               PERFORM SET-ERROR
               GO TO SHOWFORM-ADD.

           IF CRAFT-3-BUF = SPACES
               NEXT SENTENCE
           ELSE
           MOVE CRAFT-3-BUF    TO CRAFTREQD OF WO-CRAFTS-REQD
           START WO-CRAFTS-REQD KEY = CRAFTREQD OF WO-CRAFTS-REQD
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT
           END-START
           IF FILE-STAT NOT = "00"
      *M********************************************************************
      *M    MESSAGE 035/037:
      *M INVALID CRAFT
      *M********************************************************************
               MOVE  35        TO LANG-SETNUM
               MOVE  37        TO LANG-MSGNUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE CATREAD-MSG-TEXT TO ERRMSG-SCREEN
               MOVE 89         TO FIELD-NUMBER ERROR-SW
               PERFORM SET-ERROR
               GO TO SHOWFORM-ADD.

           IF CRAFT-1-BUF = CRAFT-2-BUF
               MOVE CRAFT-3-BUF TO CRAFT-2-BUF
               MOVE SPACES      TO CRAFT-3-BUF.

           IF CRAFT-1-BUF = CRAFT-2-BUF
               MOVE CRAFT-3-BUF TO CRAFT-2-BUF
               MOVE SPACES      TO CRAFT-3-BUF.

           IF CRAFT-2-BUF = CRAFT-3-BUF
               MOVE SPACES     TO CRAFT-3-BUF.

           MOVE MEN-BUF        TO ADJ-2.
           PERFORM ADJUST-2.
           MOVE ADJ-2          TO MEN-BUF.

           IF MEN-BUF NOT NUMERIC
      *M********************************************************************
      *M    MESSAGE 032/017:
      *M FIELD MUST BE SPACES OR NUMERIC
      *M********************************************************************
               MOVE  32        TO LANG-SETNUM
               MOVE  17        TO LANG-MSGNUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE CATREAD-MSG-TEXT TO ERRMSG-SCREEN
               MOVE 8          TO FIELD-NUMBER ERROR-SW
               PERFORM SET-ERROR
               GO TO SHOWFORM-ADD.

           IF MEN-BUF = "00"
               MOVE "  "       TO MEN-BUF.

           MOVE EHRS           TO ADJ-3.
           PERFORM ADJUST-3.
           MOVE ADJ-3          TO EHRS.

           IF EHRS NOT NUMERIC
      *M********************************************************************
      *M    MESSAGE 032/017:
      *M FIELD MUST BE SPACES OR NUMERIC
      *M********************************************************************
               MOVE  32        TO LANG-SETNUM
               MOVE  17        TO LANG-MSGNUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE CATREAD-MSG-TEXT TO ERRMSG-SCREEN
               MOVE 9          TO FIELD-NUMBER ERROR-SW
               PERFORM SET-ERROR
               GO TO SHOWFORM-ADD.

           IF EHRS-DEC NOT NUMERIC
               MOVE 0          TO EHRS-DEC.

           MOVE DTHRS          TO ADJ-3.
           PERFORM ADJUST-3.
           MOVE ADJ-3          TO DTHRS.

           IF DTHRS NOT NUMERIC
      *M********************************************************************
      *M    MESSAGE 032/017:
      *M FIELD MUST BE SPACES OR NUMERIC
      *M********************************************************************
               MOVE  32        TO LANG-SETNUM
               MOVE  17        TO LANG-MSGNUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE CATREAD-MSG-TEXT TO ERRMSG-SCREEN
               MOVE 11         TO FIELD-NUMBER ERROR-SW
               PERFORM SET-ERROR
               GO TO SHOWFORM-ADD.

           IF DTHRS-D NOT NUMERIC
               MOVE 0          TO DTHRS-D.

           IF KEY-HIT = 3
               PERFORM READ-SCREEN
               PERFORM WRITE-LOOP THRU WRITE-EXIT
               PERFORM CHECK-FOR-DATA THRU CFD-EXIT
               MOVE JP-KEY-SEQ TO DEL-KEY-SEQ
               PERFORM GET-PREV-TASK THRU GPT-EXIT
               IF NO-DATA
                   IF DEL-KEY-SEQ NOT = JP-KEY-SEQ
                       PERFORM DELETE-BLANK-TASK THRU DBT-EXIT
                   END-IF
               END-IF
               MOVE 2          TO KEY-HIT
               PERFORM SET-VALUES
               GO TO PARSE-KEY-HIT.

           IF KEY-HIT = 4
               PERFORM READ-SCREEN
               PERFORM WRITE-LOOP THRU WRITE-EXIT
               PERFORM CHECK-FOR-DATA THRU CFD-EXIT
               MOVE JP-KEY-SEQ TO DEL-KEY-SEQ
               PERFORM GET-NEXT-TASK THRU GNT-EXIT
               IF NO-DATA
                   PERFORM DELETE-BLANK-TASK THRU DBT-EXIT
               END-IF
               MOVE 2          TO KEY-HIT
               PERFORM SET-VALUES
               GO TO PARSE-KEY-HIT.

       DISPLAY-MODE.
           MOVE "VJOBPLAN_TEXT" TO SCREEN-NAME.
           PERFORM CLEAR-EDIT.
           PERFORM LOAD-SCREEN.
           MOVE OWNR           TO OWNER-BUF.
           MOVE CNUM-BUF       TO EDITOR-BUF.

       SHOWFORM-DISP.
           MOVE 15             TO FIELD-NUMBER.
           MOVE SCREEN-DATA    TO DISPLAY-REC.
           PERFORM SHOWFORM    THRU SHOWFORM-EXIT.
           MOVE DISPLAY-REC    TO SCREEN-DATA.
           MOVE 1              TO SAVE-SW.

           IF KEY-HIT = 8
               PERFORM READ-SCREEN
               PERFORM LOAD-SCREEN
               PERFORM CHECK-FOR-DATA THRU CFD-EXIT
               IF NO-DATA
                   GO TO MAIN
               ELSE
               MOVE "DS"       TO RETURN-SCREEN
               GO TO SAVE-DATA.

           IF KEY-HIT = 1
               PERFORM READ-SCREEN
               PERFORM CLEAR-EDIT
               PERFORM LOAD-SCREEN
               GO TO ADD-MODE.

           IF KEY-HIT = 2
               PERFORM READ-SCREEN
               PERFORM LOAD-SCREEN
               GO TO EDIT-MODE.

           IF KEY-HIT = 3
               PERFORM READ-SCREEN
               PERFORM WRITE-LOOP THRU WRITE-EXIT
               PERFORM CHECK-FOR-DATA THRU CFD-EXIT
               MOVE JP-KEY-SEQ TO DEL-KEY-SEQ
               PERFORM GET-PREV-TASK THRU GPT-EXIT
               IF NO-DATA
                   IF DEL-KEY-SEQ NOT = JP-KEY-SEQ
                       PERFORM DELETE-BLANK-TASK THRU DBT-EXIT
                   END-IF
               END-IF
               MOVE 2          TO KEY-HIT
               PERFORM SET-VALUES
               GO TO PARSE-KEY-HIT.

           IF KEY-HIT = 4
               PERFORM READ-SCREEN
               PERFORM WRITE-LOOP THRU WRITE-EXIT
               PERFORM CHECK-FOR-DATA THRU CFD-EXIT
               MOVE JP-KEY-SEQ TO DEL-KEY-SEQ
               PERFORM GET-NEXT-TASK THRU GNT-EXIT
               IF NO-DATA
                   PERFORM DELETE-BLANK-TASK THRU DBT-EXIT
               END-IF
               MOVE 2          TO KEY-HIT
               PERFORM SET-VALUES
               GO TO PARSE-KEY-HIT.

           IF KEY-HIT = 5
               PERFORM READ-SCREEN
               PERFORM RESET-BACK
               PERFORM LOAD-NEXT-SCREEN
               GO TO SHOWFORM-DISP.

           IF KEY-HIT = 6
               PERFORM READ-SCREEN
               PERFORM LOAD-NEXT-SCREEN
               GO TO SHOWFORM-DISP.

           IF KEY-HIT = 7
               MOVE 322        TO HELP-SW
               CALL "SPMHELPM" USING HELP-SW
               MOVE MESSAGE-BUFFER TO ERRMSG-SCREEN
               GO TO SHOWFORM-DISP.

           PERFORM READ-SCREEN.
           PERFORM LOAD-SCREEN.
           GO TO SHOWFORM-DISP.

       EDIT-MODE.
      ****************************************************************
      ***  VALID EDIT CODES:                                       ***
      ***      CODE    DESC.                                       ***
      ***       A      START LINE AFTER THIS                       ***
      ***       B      END LINE BEFORE THIS                        ***
      ***       C      COPY THIS LINE TO 'A' OR 'B' LINE           ***
      ***       CC     START OR END COPY BLOCK (2 OR MORE LINES)   ***
      ***       D      DELETE THIS LINE                            ***
      ***       DD     DELETE THESE AND ALL LINES BETWEEN THESE    ***
      ***       M      MOVE THIS LINE TO 'A' OR 'B' LINE           ***
      ***       MM     START OR END MOVE BLOCK (2 OR MORE LINES)   ***
      ***       Ix     OPEN EMPTY LINES FOR INSERTION OF NEW DATA  ***
      ***              WHERE "x" IS BLANK (FOR 1) OR 1 2 3 ... 9.  ***
      ***       II     OPEN FROM THIS LINE TO END OF SCREEN FOR    ***
      ***                INSERTION OF NEW DATA                     ***
      ***       AP     ASSOCIATE A CSIS PART NUMBER TO A TEXT LINE ***
      ***       CP     CHANGE A CSIS PART NUMBER ASSOCIATION       ***
      ***       DP     DELETE A CSIS PART NUMBER ASSOCIATION       ***
      ****************************************************************
           MOVE "VJOBPLAN_CODE" TO SCREEN-NAME.

       SHOWFORM-EDIT.
           MOVE 13             TO FIELD-NUMBER.
           MOVE SCREEN-DATA    TO DISPLAY-REC.
           PERFORM SHOWFORM    THRU SHOWFORM-EXIT.
           MOVE DISPLAY-REC    TO SCREEN-DATA.
           MOVE 1              TO SAVE-SW.

           IF KEY-HIT = 8
               PERFORM READ-SCREEN
               PERFORM LOAD-SCREEN
               PERFORM CHECK-FOR-DATA THRU CFD-EXIT
               IF NO-DATA
                   GO TO MAIN
               ELSE
               MOVE "ED"       TO RETURN-SCREEN
               GO TO SAVE-DATA.

           IF KEY-HIT = 1
               PERFORM READ-SCREEN
               PERFORM CLEAR-EDIT
               PERFORM LOAD-SCREEN
               GO TO ADD-MODE.

           IF KEY-HIT = 2
               PERFORM READ-SCREEN
               PERFORM EDIT-READ THRU ER-EXIT
               PERFORM LOAD-SCREEN
               GO TO DISPLAY-MODE.

           IF KEY-HIT = 3
               PERFORM READ-SCREEN
               PERFORM WRITE-LOOP THRU WRITE-EXIT
               PERFORM CHECK-FOR-DATA THRU CFD-EXIT
               MOVE JP-KEY-SEQ TO DEL-KEY-SEQ
               PERFORM GET-PREV-TASK THRU GPT-EXIT
               IF NO-DATA
                   IF DEL-KEY-SEQ NOT = JP-KEY-SEQ
                       PERFORM DELETE-BLANK-TASK THRU DBT-EXIT
                   END-IF
               END-IF
               MOVE 2          TO KEY-HIT
               PERFORM SET-VALUES
               GO TO PARSE-KEY-HIT.

           IF KEY-HIT = 4
               PERFORM READ-SCREEN
               PERFORM WRITE-LOOP THRU WRITE-EXIT
               PERFORM CHECK-FOR-DATA THRU CFD-EXIT
               MOVE JP-KEY-SEQ TO DEL-KEY-SEQ
               PERFORM GET-NEXT-TASK THRU GNT-EXIT
               IF NO-DATA
                   PERFORM DELETE-BLANK-TASK THRU DBT-EXIT
               END-IF
               MOVE 2          TO KEY-HIT
               PERFORM SET-VALUES
               GO TO PARSE-KEY-HIT.

           IF KEY-HIT = 5
               PERFORM READ-SCREEN
               PERFORM EDIT-READ THRU ER-EXIT
               PERFORM RESET-BACK
               PERFORM LOAD-NEXT-SCREEN
               GO TO SHOWFORM-EDIT.

           IF KEY-HIT = 6
               PERFORM READ-SCREEN
               PERFORM EDIT-READ THRU ER-EXIT
               PERFORM LOAD-NEXT-SCREEN
               GO TO SHOWFORM-EDIT.

           IF KEY-HIT = 7
               MOVE 323        TO HELP-SW
               CALL "SPMHELPM" USING HELP-SW
               MOVE MESSAGE-BUFFER TO ERRMSG-SCREEN
               GO TO SHOWFORM-EDIT.

           PERFORM READ-SCREEN.
           PERFORM EDIT-READ   THRU ER-EXIT.
           PERFORM LOAD-SCREEN.
           GO TO SHOWFORM-EDIT.

       EDIT-READ.
           IF AFTER-LINE > 0
               PERFORM CHECK-AFTER THRU CA-EXIT.

           IF INSERT-FLAG = "I " OR "I1"
               PERFORM INSERT-ONE
               MOVE 1          TO EDIT-SW
               MOVE "  "       TO INSERT-FLAG
               MOVE 0          TO INSERT-LINE INSERT-SUBS
           ELSE
           IF INSERT-FLAG = "I2" OR "I3" OR "I4" OR "I5" OR
                            "I6" OR "I7" OR "I8" OR "I9"
               PERFORM INSERT-X
               MOVE 1          TO EDIT-SW
               MOVE "  "       TO INSERT-FLAG
               MOVE 0          TO INSERT-LINE INSERT-SUBS
           ELSE
           IF INSERT-FLAG = "II"
               PERFORM INSERT-TO-END
               MOVE 1          TO EDIT-SW
               MOVE "  "       TO INSERT-FLAG
               MOVE 0          TO INSERT-LINE INSERT-SUBS.

           IF EDIT-FLAG-1 = "C " AND AFTER-LINE NOT = 0
               PERFORM COPY-BLOCK
               MOVE 1          TO EDIT-SW
               MOVE "  "       TO EDIT-FLAG-1
               MOVE 0          TO EDIT-LINE-1 AFTER-LINE.

           IF EDIT-FLAG = "CCCC" AND AFTER-LINE NOT = 0
               PERFORM COPY-BLOCK
               MOVE 1          TO EDIT-SW
               MOVE "    "     TO EDIT-FLAG
               MOVE 0          TO EDIT-LINE-1 EDIT-LINE-2
                                  AFTER-LINE.

           IF EDIT-FLAG-1 = "M " AND AFTER-LINE NOT = 0
               PERFORM MOVE-BLOCK-UP THRU MB-EXIT
               MOVE 1          TO EDIT-SW
               MOVE "  "       TO EDIT-FLAG-1
               MOVE 0          TO EDIT-LINE-1 AFTER-LINE.

           IF EDIT-FLAG = "MMMM" AND AFTER-LINE NOT = 0
               PERFORM MOVE-BLOCK-UP THRU MB-EXIT
               MOVE 1          TO EDIT-SW
               MOVE "    "     TO EDIT-FLAG
               MOVE 0          TO EDIT-LINE-1 EDIT-LINE-2
                                  AFTER-LINE.

           IF EDIT-FLAG-1 = "D "
               PERFORM DELETE-ONE
               MOVE 1          TO EDIT-SW
               MOVE "  "       TO EDIT-FLAG-1
               MOVE 0          TO EDIT-LINE-1.

           IF EDIT-FLAG = "DDDD"
               PERFORM DELETE-BLOCK
               MOVE 1          TO EDIT-SW
               MOVE "    "     TO EDIT-FLAG
               MOVE 0          TO EDIT-LINE-1 EDIT-LINE-2.

           IF EDIT-SW = 1
               MOVE 0          TO EDIT-SW
               PERFORM CLEAR-EDIT.

       ER-EXIT.                EXIT.

       INSERT-ONE.
           MOVE JOBPLAN-LINE   TO JOBPLAN-HOLD.
           MOVE SPACES         TO JOBPLAN-LINE.
           MOVE 0              TO SUB1 SUB2 LC.
           MOVE INSERT-LINE    TO EDIT-LIMIT.
           PERFORM MOVE-OVER   UNTIL SUB1 = EDIT-LIMIT.
           PERFORM INSERT-LINES.
           PERFORM MOVE-OVER   UNTIL SUB2 > 159.

       INSERT-X.
           MOVE JOBPLAN-LINE   TO JOBPLAN-HOLD.
           MOVE SPACES         TO JOBPLAN-LINE.
           MOVE 0              TO SUB1 SUB2 LC.
           MOVE INSERT-LINE    TO EDIT-LIMIT.
           PERFORM MOVE-OVER   UNTIL SUB1 = EDIT-LIMIT.
           PERFORM INSERT-LINES IF-2-9 TIMES.
           PERFORM MOVE-OVER   UNTIL SUB2 > 159.

       INSERT-TO-END.
           MOVE JOBPLAN-LINE   TO JOBPLAN-HOLD.
           MOVE SPACES         TO JOBPLAN-LINE.
           MOVE 0              TO SUB1 SUB2 LC.
           MOVE INSERT-LINE    TO EDIT-LIMIT.
           PERFORM MOVE-OVER   UNTIL SUB1 = EDIT-LIMIT.
           COMPUTE LC = 17 - LC.
           PERFORM INSERT-LINES LC TIMES.
           PERFORM MOVE-OVER   UNTIL SUB2 > 159.

       INSERT-LINES.
           ADD 1               TO SUB2.
           MOVE SPACES         TO JP-LINE(SUB2).

       COPY-BLOCK.
           MOVE JOBPLAN-LINE   TO JOBPLAN-HOLD.
           MOVE SPACES         TO JOBPLAN-LINE.
           MOVE 0              TO SUB1 SUB2 LC.
           IF AFTER-LINE = 999 MOVE 0 TO AFTER-LINE.
           MOVE AFTER-LINE     TO EDIT-LIMIT.
           PERFORM MOVE-OVER   UNTIL SUB1 = EDIT-LIMIT.
           MOVE EDIT-LINE-1    TO SUB1.
           SUBTRACT 1          FROM SUB1.
           MOVE EDIT-LINE-2    TO EDIT-LIMIT.
           PERFORM MOVE-OVER   UNTIL SUB1 = EDIT-LIMIT.
           MOVE AFTER-LINE     TO SUB1.
           PERFORM MOVE-OVER   UNTIL SUB2 > 159.

       MOVE-BLOCK-UP.
           IF AFTER-LINE = 999 MOVE 0 TO AFTER-LINE.
           IF AFTER-LINE > EDIT-LINE-1
               PERFORM MOVE-BLOCK-DOWN
               GO TO MB-EXIT.

           MOVE JOBPLAN-LINE   TO JOBPLAN-HOLD.
           MOVE SPACES         TO JOBPLAN-LINE.
           MOVE 0              TO SUB1 SUB2 LC.
           MOVE AFTER-LINE     TO EDIT-LIMIT.
           PERFORM MOVE-OVER   UNTIL SUB1 = EDIT-LIMIT.
           MOVE EDIT-LINE-1    TO SUB1.
           SUBTRACT 1          FROM SUB1.
           MOVE EDIT-LINE-2    TO EDIT-LIMIT.
           PERFORM MOVE-OVER   UNTIL SUB1 = EDIT-LIMIT.
           MOVE AFTER-LINE     TO SUB1.
           MOVE EDIT-LINE-1    TO EDIT-LIMIT.
           PERFORM MOVE-OVER   UNTIL SUB1 = EDIT-LIMIT.
           SUBTRACT 1          FROM SUB2.
           MOVE EDIT-LINE-2    TO SUB1.
           PERFORM MOVE-OVER   UNTIL SUB2 > 159.

       MB-EXIT.                EXIT.

       MOVE-BLOCK-DOWN.
           MOVE JOBPLAN-LINE   TO JOBPLAN-HOLD.
           MOVE SPACES         TO JOBPLAN-LINE.
           MOVE 0              TO SUB1 SUB2 LC.
           MOVE EDIT-LINE-1    TO EDIT-LIMIT.
           PERFORM MOVE-OVER   UNTIL SUB1 = EDIT-LIMIT.
           SUBTRACT 1          FROM SUB2.
           MOVE EDIT-LINE-2    TO SUB1.
           MOVE AFTER-LINE     TO EDIT-LIMIT.
           PERFORM MOVE-OVER   UNTIL SUB1 = EDIT-LIMIT.
           MOVE EDIT-LINE-1    TO SUB1.
           SUBTRACT 1          FROM SUB1.
           MOVE EDIT-LINE-2    TO EDIT-LIMIT.
           PERFORM MOVE-OVER   UNTIL SUB1 = EDIT-LIMIT.
           MOVE AFTER-LINE     TO SUB1.
           PERFORM MOVE-OVER   UNTIL SUB2 > 159.

       DELETE-ONE.
           MOVE JOBPLAN-LINE   TO JOBPLAN-HOLD.
           MOVE SPACES         TO JOBPLAN-LINE.
           MOVE 0              TO SUB1 SUB2 LC.
           MOVE EDIT-LINE-1    TO EDIT-LIMIT.
           PERFORM MOVE-OVER   UNTIL SUB1 = EDIT-LIMIT.
           SUBTRACT 1          FROM SUB2.
           PERFORM MOVE-OVER   UNTIL SUB1 > 159.
           MOVE SPACES         TO JP-LINE(160).

       DELETE-BLOCK.
           MOVE JOBPLAN-LINE   TO JOBPLAN-HOLD.
           MOVE SPACES         TO JOBPLAN-LINE.
           MOVE 0              TO SUB1 SUB2 LC.
           SUBTRACT 1          FROM EDIT-LINE-1 EDIT-LINE-2.
           MOVE EDIT-LINE-1    TO EDIT-LIMIT.
           PERFORM MOVE-OVER   UNTIL SUB1 = EDIT-LIMIT.
           PERFORM INCREASE-SUB1 UNTIL SUB1 > EDIT-LINE-2.
           PERFORM MOVE-OVER   UNTIL SUB1 > 159.

       MOVE-OVER.
           ADD 1               TO SUB1 SUB2 LC.
           IF LC = 18          MOVE 1 TO LC.
           MOVE JP-HOLD(SUB1)  TO JP-LINE(SUB2).
           MOVE SUB2           TO JOBP-LINE(SUB2).
           IF SUB2 > 159       MOVE SUB1 TO EDIT-LIMIT.

       INCREASE-SUB1.
           ADD 1               TO SUB1.

       CLEAR-EDIT.
           MOVE SPACES         TO EDIT-FLAG INSERT-FLAG.
           MOVE 0              TO SUB1 EDIT-LINE-1 EDIT-LINE-2 SUBC
                                  INSERT-LINE INSERT-SUBS AFTER-LINE.
           PERFORM CLEAR-EDIT-FIELDS 160 TIMES.
           MOVE 0              TO SUB1.
           PERFORM CLEAR-EDIT-SCREEN  17 TIMES.

       CLEAR-EDIT-FIELDS.
           ADD 1               TO SUB1.
           MOVE SPACES         TO EDIT-CODE(SUB1).

       CLEAR-EDIT-SCREEN.
           ADD 1               TO SUB1.
           MOVE SPACES         TO EDIT-FLD(SUB1).

       ADJUST-2.
           PERFORM ELIMINATE1  UNTIL F2 NOT = SPACE.
           IF F1 = SPACE MOVE "0" TO F1.

       ADJUST-3.
           PERFORM ELIMINATE2  UNTIL F5 NOT = SPACE.
           IF F3 = SPACE MOVE "0" TO F3.
           IF F4 = SPACE MOVE "0" TO F4.

       ADJUST-4.
           PERFORM ELIMINATE3  UNTIL F9 NOT = SPACE.
           IF F6 = SPACE MOVE "0" TO F6.
           IF F7 = SPACE MOVE "0" TO F7.
           IF F8 = SPACE MOVE "0" TO F8.

       ELIMINATE1.
           MOVE F1             TO F2.
           MOVE "0"            TO F1.

       ELIMINATE2.
           MOVE F4             TO F5.
           MOVE F3             TO F4.
           MOVE "0"            TO F3.

       ELIMINATE3.
           MOVE F8             TO F9.
           MOVE F7             TO F8.
           MOVE F6             TO F7.
           MOVE "0"            TO F6.

       RESET-BACK.
           MOVE DISP-S         TO DISP-E.
           SUBTRACT 16         FROM DISP-E.
           IF DISP-E < 17
               MOVE 1          TO DISP-E.

       READ-SCREEN.
           MOVE DISP-S         TO SUB.
           MOVE 1              TO SUBS.
           PERFORM RELOAD-LOOP 17 TIMES.

       RELOAD-LOOP.
           MOVE SUB            TO JOBP-LINE(SUB).
           IF EDIT-FLD(SUBS) NOT = "  "
               PERFORM EDIT-FUNCTION THRU EF-EXIT.
           MOVE PART-BUF(SUBS) TO PART-DISP.
           MOVE PRTNO          TO JOBP-PRT(SUB).
           MOVE PQ9            TO JOBP-PQTY(SUB).
           MOVE TEXT-FLD(SUBS) TO JOBP-PTXT(SUB).
           MOVE PTUM-FLD(SUBS) TO JOBP-PTUM(SUB).
           IF TEXT-BUF(SUBS) = SPACES
               IF JOBP-PRT(SUB) NOT = SPACES
                   MOVE ">"    TO TBUF2(SUBS).
           MOVE TEXT-BUF(SUBS) TO JOBP-DESC(SUB).
           MOVE EDIT-FLD(SUBS) TO EDIT-CODE(SUB).
           ADD 1               TO SUB SUBS.

       EDIT-FUNCTION.
           IF EDIT-FLD(SUBS) = "AP" OR "CP"
               MOVE SCREEN-NAME TO SAVEFORM
               PERFORM ADD-PART-FUNCTION THRU APF-EXIT
               MOVE "  "       TO EDIT-FLD(SUBS)
               IF VALIDITY = 1
                   MOVE SPACES TO PART-DISP
                   MOVE PS-PRT-NUM TO PRTNO
                   MOVE PS-PRT-QTY TO PQ9
                   MOVE PART-DISP  TO PART-BUF(SUBS)
                   PERFORM MARK-PART-LINE
                   MOVE SAVEFORM   TO SCREEN-NAME
                   GO TO EF-EXIT
               ELSE
                   MOVE SAVEFORM TO SCREEN-NAME
                   GO TO EF-EXIT.

           IF EDIT-FLD(SUBS) = "DP"
               MOVE SPACES     TO PART-BUF(SUBS)
               MOVE "  "       TO EDIT-FLD(SUBS)
               IF TBUF2(SUBS) = ">"
                   MOVE SPACE  TO TBUF2(SUBS)
                   GO TO EF-EXIT
               ELSE
                   GO TO EF-EXIT.

           IF EDIT-FLD(SUBS) = "A " OR " A" OR "AA"
               IF AFTER-LINE NOT = 0
                   IF SUB = AFTER-LINE
                       GO TO EF-EXIT
                   ELSE
                       MOVE "  " TO EDIT-FLD(SUBS)
                       GO TO EF-EXIT
               ELSE
                   MOVE SUB    TO AFTER-LINE
                   GO TO EF-EXIT.

           IF EDIT-FLD(SUBS) = "B " OR " B" OR "BB"
               IF AFTER-LINE NOT = 0
                   IF SUB = AFTER-LINE + 1
                       GO TO EF-EXIT
                   ELSE
                       MOVE "  " TO EDIT-FLD(SUBS)
                       GO TO EF-EXIT
               ELSE
                   MOVE SUB    TO AFTER-LINE
                   COMPUTE AFTER-LINE = AFTER-LINE - 1
                   IF AFTER-LINE = 0
                       MOVE 999 TO AFTER-LINE
                       GO TO EF-EXIT
                   ELSE
                       GO TO EF-EXIT.

           IF INSERT-FLAG = "  "
               IF EDIT-FLD(SUBS) = "I " OR " I" OR "I1" OR "I2" OR
                                   "I3" OR "I4" OR "I5" OR "I6" OR
                                   "I7" OR "I8" OR "I9"
                   MOVE EDIT-FLD(SUBS) TO INSERT-FLAG
                   PERFORM CHECK-I-NUM
                   MOVE SUB    TO INSERT-LINE
                   MOVE SUBS   TO INSERT-SUBS
                   MOVE "  "   TO EDIT-FLD(SUBS)
                   GO TO EF-EXIT
               ELSE
               IF EDIT-FLD(SUBS) = "II"
                   MOVE "II"   TO INSERT-FLAG
                   MOVE SUB    TO INSERT-LINE
                   MOVE SUBS   TO INSERT-SUBS
                   MOVE "  "   TO EDIT-FLD(SUBS)
                   GO TO EF-EXIT
               ELSE
                   NEXT SENTENCE
           ELSE
               GO TO EF-EXIT.

           IF EDIT-FLAG-1 = "C "
               MOVE "  "       TO EDIT-FLD(SUBS)
               GO TO EF-EXIT
           ELSE
           IF EDIT-FLD(SUBS) = "C " OR " C"
               MOVE "C "       TO EDIT-FLAG-1
               MOVE SUB        TO EDIT-LINE-1 EDIT-LINE-2
           ELSE
           IF EDIT-FLAG-1 = "CC"
               IF EDIT-FLD(SUBS) = "CC"
                   IF EDIT-LINE-1 = SUB
                       GO TO EF-EXIT
                   ELSE
                       MOVE "CC" TO EDIT-FLAG-2
                       MOVE SUB  TO EDIT-LINE-2
                       PERFORM CHECK-EDIT-LINE
                       GO TO EF-EXIT
               ELSE
                   MOVE "  "   TO EDIT-FLD(SUBS)
                   GO TO EF-EXIT
           ELSE
           IF EDIT-FLD(SUBS) = "CC"
               MOVE "CC"       TO EDIT-FLAG-1
               MOVE SUB        TO EDIT-LINE-1
               GO TO EF-EXIT
           ELSE
           IF EDIT-FLAG-1 = "M "
               MOVE "  "       TO EDIT-FLD(SUBS)
               GO TO EF-EXIT
           ELSE
           IF EDIT-FLD(SUBS) = "M " OR " M"
               MOVE "M "       TO EDIT-FLAG-1
               MOVE SUB        TO EDIT-LINE-1 EDIT-LINE-2
           ELSE
           IF EDIT-FLAG-1 = "MM"
               IF EDIT-FLD(SUBS) = "MM"
                   IF EDIT-LINE-1 = SUB
                       GO TO EF-EXIT
                   ELSE
                       MOVE "MM" TO EDIT-FLAG-2
                       MOVE SUB  TO EDIT-LINE-2
                       PERFORM CHECK-EDIT-LINE
                       GO TO EF-EXIT
               ELSE
                   MOVE "  "   TO EDIT-FLD(SUBS)
                   GO TO EF-EXIT
           ELSE
           IF EDIT-FLD(SUBS) = "MM"
               MOVE "MM"       TO EDIT-FLAG-1
               MOVE SUB        TO EDIT-LINE-1
               GO TO EF-EXIT
           ELSE
           IF EDIT-FLAG-1 = "D " OR " D"
               MOVE "  "       TO EDIT-FLD(SUBS)
               GO TO EF-EXIT
           ELSE
           IF EDIT-FLD(SUBS) = "D " OR " D"
               MOVE "D "       TO EDIT-FLAG-1
               MOVE SUB        TO EDIT-LINE-1
               MOVE "  "       TO EDIT-FLD(SUBS)
           ELSE
           IF EDIT-FLAG-1 = "DD"
               IF EDIT-FLD(SUBS) = "DD"
                   IF EDIT-LINE-1 = SUB
                       GO TO EF-EXIT
                   ELSE
                       MOVE "DD" TO EDIT-FLAG-2
                       MOVE SUB  TO EDIT-LINE-2
                       PERFORM CHECK-EDIT-LINE
                       GO TO EF-EXIT
               ELSE
                   MOVE "  "   TO EDIT-FLD(SUBS)
                   GO TO EF-EXIT
           ELSE
           IF EDIT-FLD(SUBS) = "DD"
               MOVE "DD"       TO EDIT-FLAG-1
               MOVE SUB        TO EDIT-LINE-1
               GO TO EF-EXIT
           ELSE
               MOVE "  "       TO EDIT-FLD(SUBS).

       EF-EXIT.                EXIT.

       CHECK-I-NUM.
           IF INSERT-FLAG = "I " OR " I"
               MOVE "I1"       TO INSERT-FLAG.
           MOVE SUBS           TO CHK-I-VAL.
           ADD IF-2-9          TO CHK-I-VAL.
           IF CHK-I-VAL > 16   MOVE "II" TO INSERT-FLAG.

       CHECK-EDIT-LINE.
           IF EDIT-LINE-1 > EDIT-LINE-2
               MOVE EDIT-LINE-2 TO EDIT-SAVE
               MOVE EDIT-LINE-1 TO EDIT-LINE-2
               MOVE EDIT-SAVE   TO EDIT-LINE-1.

       CHECK-AFTER.
           IF EDIT-FLAG = "CCCC" OR "MMMM"
               IF AFTER-LINE IS GREATER OR EQUAL TO EDIT-LINE-1 AND
                  AFTER-LINE IS LESS    OR EQUAL TO EDIT-LINE-2
                  PERFORM CLEAR-EDIT
                  GO TO CA-EXIT.

           PERFORM VARYING SUBC FROM 160 BY -1
               UNTIL JOBP-DESC(SUBC) NOT = SPACES
               CONTINUE
           END-PERFORM.
           COMPUTE SUBC = 160 - SUBC.

           IF SUBC = 0
              IF INSERT-FLAG = "I " OR " I" OR "I1"
                   PERFORM CHECK-SCREEN THRU CS-EXIT
                   IF KEY-HIT = 1
                       GO TO CA-EXIT
                   ELSE
                       MOVE "  " TO INSERT-FLAG EDIT-CODE(SUBS)
                       MOVE 0    TO INSERT-LINE INSERT-SUBS
                       GO TO CA-EXIT.

           IF INSERT-FLAG = "II" OR "I2" OR "I3" OR "I4" OR
                            "I5" OR "I6" OR "I7" OR "I8" OR "I9"
               COMPUTE CHECK-VALUE = 17 - INSERT-SUBS
               IF CHECK-VALUE > SUBC
                   PERFORM CHECK-SCREEN THRU CS-EXIT
                   IF KEY-HIT = 1
                       GO TO CA-EXIT
                   ELSE
                       MOVE "  "   TO INSERT-FLAG EDIT-CODE(SUBS)
                       MOVE 0      TO INSERT-LINE INSERT-SUBS
                       GO TO CA-EXIT.

           IF EDIT-FLAG-1 = "C " AND SUBC = 0
               PERFORM CHECK-SCREEN THRU CS-EXIT
               IF KEY-HIT = 1
                   GO TO CA-EXIT
               ELSE
                   MOVE "  "   TO EDIT-CODE(EDIT-LINE-1)
                                  EDIT-CODE(AFTER-LINE)
                                  EDIT-CODE(AFTER-LINE + 1)
                   IF EDIT-LINE-1 < 18
                       MOVE "  "   TO EDIT-FLD (EDIT-LINE-1)
                   END-IF
                   IF AFTER-LINE < 17
                       MOVE "  "   TO EDIT-FLD (AFTER-LINE)
                                      EDIT-FLD (AFTER-LINE + 1)
                   END-IF
                   MOVE "    " TO EDIT-FLAG
                   MOVE 0      TO EDIT-LINE-1 EDIT-LINE-2
                                  AFTER-LINE
                   GO TO CA-EXIT.

           IF EDIT-FLAG = "CCCC"
               COMPUTE CHECK-VALUE = EDIT-LINE-2 - EDIT-LINE-1
               IF CHECK-VALUE > SUBC
                   PERFORM CHECK-SCREEN THRU CS-EXIT
                   IF KEY-HIT = 1
                       GO TO CA-EXIT
                   ELSE
                       MOVE "  "   TO EDIT-CODE(EDIT-LINE-1)
                                      EDIT-CODE(EDIT-LINE-2)
                                      EDIT-CODE(AFTER-LINE)
                                      EDIT-CODE(AFTER-LINE + 1)
                       IF EDIT-LINE-1 < 18
                           MOVE "  "   TO EDIT-FLD (EDIT-LINE-1)
                       END-IF
                       IF EDIT-LINE-2 < 18
                           MOVE "  "   TO EDIT-FLD (EDIT-LINE-2)
                       END-IF
                       IF AFTER-LINE < 17
                           MOVE "  "   TO EDIT-FLD (AFTER-LINE)
                                          EDIT-FLD (AFTER-LINE + 1)
                       END-IF
                       MOVE "    " TO EDIT-FLAG
                       MOVE 0      TO EDIT-LINE-1 EDIT-LINE-2
                                      AFTER-LINE
                       GO TO CA-EXIT.

       CA-EXIT.                EXIT.

       CHECK-SCREEN.
           MOVE SCREEN-NAME    TO SAVEFORM.
           MOVE "VCHKSCREEN"   TO SCREEN-NAME.
           MOVE 999            TO HELP-SW.

       SHOWFORM-CHECK-SCREEN.
           MOVE 9              TO ERROR-SW.
           MOVE SPACES         TO DISPLAY-REC.
           PERFORM SHOWFORM    THRU SHOWFORM-EXIT.
           MOVE 0              TO ERROR-SW.

           IF KEY-HIT = 3 OR 8
               GO TO CS-CONTINUE.

           IF KEY-HIT = 0 OR 2 OR 4 OR 5 OR 6 OR 7
               GO TO SHOWFORM-CHECK-SCREEN.

       CS-CONTINUE.
           MOVE SAVEFORM       TO SCREEN-NAME.

       CS-EXIT.                EXIT.

       MARK-PART-LINE.
           IF TEXT-BUF(SUBS) = SPACES
               MOVE ">"        TO TBUF2(SUBS).

       LOAD-SCREEN.
           PERFORM CHECK-GO-TO-LINE.
           IF DISP-S > 144
               MOVE 144        TO DISP-S.
           MOVE DISP-S         TO SUB.
           MOVE 1              TO SUBS.
           MOVE SPACES         TO INPUT-TABLE PARTS-TABLE.
           PERFORM LOAD-LOOP   17 TIMES.
           SUBTRACT 1          FROM SUB.
           MOVE SUB            TO DISP-E.

       LOAD-NEXT-SCREEN.
           PERFORM CHECK-GO-TO-LINE.
           MOVE DISP-E         TO SUB DISP-S.
           IF DISP-S > 144
               MOVE 144        TO SUB DISP-S.
           MOVE 1              TO SUBS.
           MOVE SPACES         TO INPUT-TABLE PARTS-TABLE.
           PERFORM LOAD-LOOP   17 TIMES.
           SUBTRACT 1          FROM SUB.
           MOVE SUB            TO DISP-E.

       LOAD-LOOP.
           MOVE SUB            TO LINE-NUM(SUBS).
           MOVE EDIT-CODE(SUB) TO EDIT-FLD(SUBS).
           MOVE JOBP-DESC(SUB) TO TEXT-BUF(SUBS).
           MOVE SPACES         TO PART-DISP.
           MOVE JOBP-PRT(SUB)  TO PRTNO.
           MOVE JOBP-PQTY(SUB) TO PQZ.
           MOVE PART-DISP      TO PART-BUF(SUBS).
           MOVE JOBP-PTXT(SUB) TO TEXT-FLD(SUBS).
           MOVE JOBP-PTUM(SUB) TO PTUM-FLD(SUBS).
           ADD 1               TO SUB SUBS.

       CHECK-GO-TO-LINE.
           IF GO-TO-LINE = SPACES
               NEXT SENTENCE
           ELSE
           IF GO-TO-LINE = "000"
               MOVE SPACES     TO GO-TO-LINE
           ELSE
           IF GO-TO-LINE = "T  " OR " T " OR "  T" OR "TOP" OR
                           "F  " OR " F " OR "  F" OR "FIR"
               MOVE SPACES     TO GO-TO-LINE
               MOVE 1          TO DISP-S DISP-E
           ELSE
           IF GO-TO-LINE = "B  " OR " B " OR "  B" OR "BOT" OR
                           "L  " OR " L " OR "  L" OR "LAS"
               MOVE SPACES     TO GO-TO-LINE
               MOVE 144        TO DISP-S DISP-E
           ELSE
           MOVE GO-TO-LINE     TO ADJ-3
           PERFORM ADJUST-3
           MOVE ADJ-3          TO GO-TO-LINE
           IF GO-TO-LINE NOT NUMERIC
               MOVE SPACES     TO GO-TO-LINE
           ELSE
           IF GO-TO-LIN9 = 0
               MOVE SPACES     TO GO-TO-LINE
           ELSE
               MOVE GO-TO-LIN9 TO DISP-S DISP-E
               MOVE SPACES     TO GO-TO-LINE.

       READ-LOOP.
           MOVE SPACES         TO RETURN-COD.
           MOVE LOW-VALUES     TO PM-JOBPLAN-DATA.
           MOVE JP-TASK-KEY    TO JOBPWOSEQ OF PM-JOBPLAN-TASK-I.
           START PM-JOBPLAN-TASK-I KEY = JOBPWOSEQ OF PM-JOBPLAN-TASK-I
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
               GO TO READ-EXIT.

           READ PM-JOBPLAN-TASK-I NEXT INTO PM-JOBPLAN-DATA
               AT END          MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT = "10" OR "14" OR "46"
               GO TO READ-EXIT
           ELSE
           IF FILE-STAT NOT = "00"
               MOVE FILE-STAT  TO CON-WORD
               MOVE "READ NXT" TO DB-TYPE
               MOVE "READ-LOOP" TO DB-PARA
               MOVE DB-ERROR   TO ERRMSG-ENTRY
               MOVE "XX"       TO RETURN-COD
               GO TO READ-EXIT.

           IF PMJP-KEY-SEQ NOT = JP-TASK-KEY
               MOVE "10"       TO FILE-STAT
               GO TO READ-EXIT.

           MOVE JOBPLAN-KEY    TO JP-KEY-DISP JP-KEY-OS JP-KEY-DL
                                  JP-KEY-DEL.
           MOVE PMJP-SEQ       TO JP-SEQ-DISP JP-SEQ-OS JP-SEQ-DL
                                  JP-SEQ-DEL JP-SEQ-BUF.
           MOVE PMJP-LEVEL     TO JP-LEVEL-BUF.
           MOVE PMJP-FLAG      TO JP-EXFLAG-BUF.
           MOVE PMJP-SS        TO SUBSYS-BUF.
           MOVE PMJP-CRAFT     TO CRAFT-BUF.
           MOVE PMJP-MNX       TO MEN-BUF.
           MOVE PMJP-EST       TO EST-HRS-BUF.
           MOVE PMJP-DT        TO DT-HRS-BUF.
           MOVE PMJP-LINE      TO JOBP-LINE(1).
           MOVE PMJP-DESC      TO JOBP-DESC(1).
           MOVE PMJP-CORP-CODE TO JOBP-PRT(1).
           IF PMJP-EST-QTY IS NUMERIC
              MOVE PMJP-EST-QTY-9 TO JOBP-QTY-9(1)
           ELSE
              MOVE SPACES      TO JOBP-PQTY(1).
           MOVE PMJP-TEXT      TO JOBP-PTXT(1).
           MOVE PMJP-UNIT-MEAS TO JOBP-PTUM(1).
           MOVE 1              TO SUB DATA-SW.

       DBGET-READ-LOOP.
           READ PM-JOBPLAN-TASK-I NEXT INTO PM-JOBPLAN-DATA
               AT END          MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT = "10" OR "14" OR "46"
               GO TO READ-EXIT
           ELSE
           IF FILE-STAT NOT = "00"
               MOVE FILE-STAT  TO CON-WORD
               MOVE "READ NXT" TO DB-TYPE
               MOVE "DBGET-READ-LOOP" TO DB-PARA
               MOVE DB-ERROR   TO ERRMSG-ENTRY
               MOVE "XX"       TO RETURN-COD
               GO TO READ-EXIT.

           IF PMJP-KEY-SEQ NOT = JP-TASK-KEY
               MOVE "10"       TO FILE-STAT
               GO TO READ-EXIT.

           IF PMJP-SEQ NOT = JP-SEQ-BUF
               GO TO READ-EXIT.

           ADD 1               TO SUB.
           MOVE PMJP-LINE      TO JOBP-LINE(SUB).
           MOVE PMJP-DESC      TO JOBP-DESC(SUB).
           MOVE PMJP-PRT-NUM   TO JOBP-PRT(SUB).
           IF PMJP-EST-QTY IS NUMERIC
               MOVE PMJP-EST-QTY-9 TO JOBP-QTY-9(SUB)
           ELSE
               MOVE SPACES     TO JOBP-PQTY(SUB).
           MOVE PMJP-TEXT      TO JOBP-PTXT(SUB).
           MOVE PMJP-UNIT-MEAS TO JOBP-PTUM(SUB).
           GO TO DBGET-READ-LOOP.

       READ-EXIT.              EXIT.

       ADD-PART-FUNCTION.
           MOVE 0              TO VALIDITY.
           MOVE "VJOBPLAN_PART" TO SCREEN-NAME.

           MOVE SPACES         TO PARTS-SCREEN PRT-COMP.
           MOVE BANNER-DATA    TO BANNER-DISP.
           MOVE SUB            TO PS-LINE.
           MOVE TEXT-BUF(SUBS) TO PS-TEXT.
           IF EDIT-FLD(SUBS) = "CP"
               MOVE JOBP-PRT(SUB)  TO PS-PRT-NUM
               IF JOBP-PQTY(SUB) NUMERIC
                 MOVE JOBP-QTY-9(SUB) TO PS-PRT-QTY
               ELSE
                 MOVE JOBP-PQTY(SUB) TO PS-PRT-QTYX
               END-IF
               MOVE JOBP-PTXT(SUB) TO PS-PRT-TEXT
               MOVE JOBP-PTUM(SUB) TO PS-PRT-UM.

       SHOWFORM-PARTS.
           MOVE 9              TO ERROR-SW.
           MOVE 0              TO SAVE-SW.
           MOVE PARTS-SCREEN   TO DISPLAY-REC.
           PERFORM SHOWFORM    THRU SHOWFORM-EXIT.
           MOVE DISPLAY-REC    TO PARTS-SCREEN.
           MOVE 0              TO ERROR-SW.
           MOVE 1              TO SAVE-SW.

           IF KEY-HIT = 2 OR 4 OR 5 OR 6
               GO TO SHOWFORM-PARTS.

           IF KEY-HIT = 1
               PERFORM PARTS-INQUIRY THRU PARTS-INQUIRY-EXIT
               MOVE "VJOBPLAN_PARTS" TO SCREEN-NAME
               GO TO SHOWFORM-PARTS.

           IF KEY-HIT = 7
               MOVE 324        TO HELP-SW
               CALL "SPMHELPM" USING HELP-SW
               MOVE MESSAGE-BUFFER TO ERRMSG-PARTS
               GO TO SHOWFORM-PARTS.

           IF PS-NUM-QTY NOT = PRT-COMP
               MOVE 0          TO VALIDITY.

           IF PS-PRT-NUM = SPACES
               IF KEY-HIT = 3 OR 8
                   MOVE 0      TO VALIDITY
                   GO TO APF-EXIT
               ELSE
                   GO TO SHOWFORM-PARTS.

           MOVE 0              TO REJECT-SW.
           MOVE PS-PRT-NUM     TO RET-CC.
           MOVE RET-CC         TO CORPCDE OF MSTORERM.
           READ MSTORERM       INTO BUF-MSTORERM
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
      *M********************************************************************
      *M    MESSAGE 035/021:
      *M INVALID CORPORATE CODE
      *M********************************************************************
               MOVE  35        TO LANG-SETNUM
               MOVE  21        TO LANG-MSGNUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE CATREAD-MSG-TEXT TO ERRMSG-PARTS
               MOVE 90         TO FIELD-NUMBER ERROR-SW
               MOVE 1          TO REJECT-SW
               PERFORM SET-ERROR
               GO TO SHOWFORM-PARTS.

           IF PS-PRT-QTY = SPACES
      *M********************************************************************
      *M    MESSAGE 017/019:
      *M Q19: QUANTITY IS A REQUIRED FIELD
      *M********************************************************************
               MOVE 17         TO LANG-SETNUM
               MOVE 19         TO LANG-MSGNUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE CATREAD-MSG-TEXT TO ERRMSG-PARTS
               MOVE 94         TO FIELD-NUMBER ERROR-SW
               PERFORM SET-ERROR
               GO TO SHOWFORM-PARTS.

           MOVE PS-PRT-QTY     TO ADJ-3.
           PERFORM ADJUST-3.
           MOVE ADJ-3          TO PS-PRT-QTY.

           IF PS-PRT-QTY NOT NUMERIC
      *M********************************************************************
      *M    MESSAGE 043/002:
      *M QUANTITY FIELD MUST BE NUMERIC
      *M********************************************************************
               MOVE 43         TO LANG-SETNUM
               MOVE  2         TO LANG-MSGNUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE CATREAD-MSG-TEXT TO ERRMSG-PARTS
               MOVE 94         TO FIELD-NUMBER ERROR-SW
               PERFORM SET-ERROR
               GO TO SHOWFORM-PARTS.

           IF PS-PRT-QTY = "000"
      *M********************************************************************
      *M    MESSAGE 017/019:
      *M Q19: QUANTITY IS A REQUIRED FIELD
      *M********************************************************************
               MOVE 17         TO LANG-SETNUM
               MOVE 19         TO LANG-MSGNUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE CATREAD-MSG-TEXT TO ERRMSG-PARTS
               MOVE 94         TO FIELD-NUMBER ERROR-SW
               PERFORM SET-ERROR
               GO TO SHOWFORM-PARTS.

           MOVE 1              TO VALIDITY.
           MOVE PS-NUM-QTY     TO PRT-COMP.
           MOVE STR-UM         TO PS-PRT-UM PTUM-FLD(SUBS).
           MOVE PS-PRT-TEXT    TO TEXT-FLD(SUBS).

           IF KEY-HIT = 3 OR 8
               IF REJECT-SW = 1
                   MOVE 0      TO VALIDITY
                   GO TO APF-EXIT.

           IF KEY-HIT = 0
               GO TO SHOWFORM-PARTS.

       APF-EXIT.               EXIT.

       SEQUENCING-FUNCTION.
           MOVE "VNEXTTASK"    TO SCREEN-NAME.
           MOVE 999            TO HELP-SW.
           MOVE SPACES         TO SEQUENCING-SCREEN.
           MOVE JP-SEQ-BUF     TO CURR-TASK.

       SHOWFORM-SEQUENCING.
           MOVE FIELD-NUMBER   TO FIELD-SAVE.
           MOVE 1              TO FIELD-NUMBER.
           MOVE SEQUENCING-SCREEN TO DISPLAY-REC.
           PERFORM SHOWFORM    THRU SHOWFORM-EXIT.
           MOVE DISPLAY-REC    TO SEQUENCING-SCREEN.
           MOVE 0              TO ERROR-SW.
           MOVE FIELD-SAVE     TO FIELD-NUMBER.

           IF KEY-HIT = 1
               MOVE "0001"     TO SEQ-INCREMENT
               GO TO SF-EXIT
           ELSE
           IF KEY-HIT = 2
               MOVE "0002"     TO SEQ-INCREMENT
               GO TO SF-EXIT
           ELSE
           IF KEY-HIT = 3
               MOVE "0003"     TO SEQ-INCREMENT
               GO TO SF-EXIT
           ELSE
           IF KEY-HIT = 4
               MOVE "0004"     TO SEQ-INCREMENT
               GO TO SF-EXIT
           ELSE
           IF KEY-HIT = 5
               MOVE "0005"     TO SEQ-INCREMENT
               GO TO SF-EXIT
           ELSE
           IF KEY-HIT = 6
               MOVE "0010"     TO SEQ-INCREMENT
               GO TO SF-EXIT
           ELSE
           IF KEY-HIT = 7
               MOVE "0050"     TO SEQ-INCREMENT
               GO TO SF-EXIT
           ELSE
           IF KEY-HIT = 8
               MOVE "0100"     TO SEQ-INCREMENT
               GO TO SF-EXIT
           ELSE

           MOVE SEQ-INCREMENT  TO ADJ-4.
           PERFORM ADJUST-4.
           MOVE ADJ-4          TO SEQ-INCREMENT.

           IF SEQ-INCREMENT = "0000"
      *M********************************************************************
      *M    MESSAGE 031/064:
      *M ENTER TASK SEQUENCING INCREMENT AND PRESS 'ENTER', OR PRESS 'f' KEY
      *M********************************************************************
               MOVE 31         TO LANG-SETNUM
               MOVE 64         TO LANG-MSGNUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE CATREAD-MSG-TEXT TO ERRMSG-SEQ
               MOVE  1         TO FIELD-NUMBER ERROR-SW
               PERFORM SET-ERROR
               GO TO SHOWFORM-SEQUENCING.

           IF SEQ-INCREMENT NOT NUMERIC
      *M********************************************************************
      *M    MESSAGE 035/105:
      *M INVALID ENTRY
      *M********************************************************************
               MOVE  35        TO LANG-SETNUM
               MOVE 105        TO LANG-MSGNUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE CATREAD-MSG-TEXT TO ERRMSG-SEQ
               MOVE  1         TO FIELD-NUMBER ERROR-SW
               PERFORM SET-ERROR
               GO TO SHOWFORM-SEQUENCING.

           IF SEQ-INC > 1000
      *M********************************************************************
      *M    MESSAGE 035/105:
      *M INVALID ENTRY
      *M********************************************************************
               MOVE  35        TO LANG-SETNUM
               MOVE 105        TO LANG-MSGNUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE CATREAD-MSG-TEXT TO ERRMSG-SEQ
               MOVE  1         TO FIELD-NUMBER ERROR-SW
               PERFORM SET-ERROR
               GO TO SHOWFORM-SEQUENCING.

       SF-EXIT.                EXIT.

       PARTS-INQUIRY.
           MOVE "  STORES;"    TO BASE-ST10.
           MOVE PLANT-CODE     TO PLANT-ID.
           MOVE SPACES         TO DESC-LANG DES2-LANG.
           CALL "SDSCINQ"      USING BASE-ST10
                               VIEW-COMAREA
                               LANGUAGE-PARMS
                               MPLT-CODES.

       PARTS-INQUIRY-EXIT.     EXIT.

       COPY-FUNCTION SECTION 02.
       COPY-FUNCT.
           MOVE "VPMJPCPY_ALL" TO SCREEN-NAME.
           MOVE SPACES         TO COPYING-SCREEN.
           MOVE JP-KEY-BUF     TO COPY-FROM-JP-BUF.
           MOVE 6              TO FIELD-NUMBER.

       SHOWFORM-COPYING.
           MOVE COPYING-SCREEN TO DISPLAY-REC.
           PERFORM SHOWFORM    THRU SHOWFORM-EXIT.
           MOVE DISPLAY-REC    TO COPYING-SCREEN.
           MOVE 0              TO ERROR-SW.

           IF KEY-HIT = 3 OR 8
               GO TO COPYING-FUNCTION-EXIT.

           IF KEY-HIT = 7
               MOVE  314       TO HELP-SW
               CALL "SPMHELPM" USING HELP-SW
               MOVE MESSAGE-BUFFER TO ERRMSG-COPYING
               GO TO SHOWFORM-COPYING.

           IF KEY-HIT NOT = 0
               GO TO SHOWFORM-COPYING.

       CHECK-COPYING.
           IF COPY-TO-JP-BUF = SPACES
                GO TO SHOWFORM-COPYING.

           MOVE SPACES         TO RETURN-COD.
           MOVE LOW-VALUES     TO PM-JOBPLAN-DATA.
           MOVE COPY-TO-JP-BUF TO PMJOBPKEY OF PM-JOBPLAN.
           START PM-JOBPLAN    KEY = PMJOBPKEY OF PM-JOBPLAN
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT = "00"
               READ PM-JOBPLAN NEXT INTO PM-JOBPLAN-DATA
                   AT END      MOVE FILE-STAT TO FILE-STAT.
               IF FILE-STAT = "00" AND JOBPLAN-KEY = COPY-TO-JP-BUF
      *M*******************************************************************
      *M    MESSAGE 036/016
      *M  JOBPLAN ALREADY EXISTS
      *M*******************************************************************
                   MOVE 36     TO LANG-SETNUM
                   MOVE 16     TO LANG-MSGNUM
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE CATREAD-MSG-TEXT TO ERRMSG-COPYING
                   MOVE 6      TO FIELD-NUMBER
                   PERFORM SET-ERROR
                   GO TO SHOWFORM-COPYING.

           MOVE SCREEN-NAME    TO SAVEFORM.
           MOVE COPY-TO-JP-BUF TO JP-KEY-BUF.
           PERFORM GET-KEY-TITLE THRU GKT-EXIT.
           MOVE COPY-FROM-JP-BUF TO JP-KEY-BUF.
           MOVE SAVEFORM       TO SCREEN-NAME.

           MOVE SPACES TO E1.
           MOVE ZEROS TO E5.
           CALL "SPMJPCPY"     USING DBPARAMETERS
                               RETURN-MSG
                               VIEW-COMAREA
                               LANGUAGE-PARMS
                               COPY-FROM-JP-BUF
                               COPY-TO-JP-BUF
                               CNUM-BUF
                               JP-TITLE-BUF.

           MOVE E1             TO ERRMSG-COPYING.
           MOVE E5             TO FIELD-NUMBER.
           PERFORM SET-ERROR.
           MOVE SPACES         TO E1 COPY-TO-JP-BUF.
           MOVE ZEROS          TO E5.
           GO TO SHOWFORM-COPYING.

       COPYING-FUNCTION-EXIT.
           MOVE "VJOBPLAN_MENU" TO SCREEN-NAME.
           MOVE SPACES         TO JP-SEQ-BUF.
           GO TO SHOWFORM-MAIN.

       RENUMBER-FUNCTION.
           MOVE "VPMJP_RENUM"  TO SCREEN-NAME.

           MOVE SPACES         TO RENUMBER-SCREEN.
           MOVE JP-KEY-BUF     TO RENUM-JP-BUF.
           MOVE 8              TO FIELD-NUMBER.

       SHOWFORM-RENUMBER.
           MOVE RENUMBER-SCREEN TO DISPLAY-REC.
           PERFORM SHOWFORM    THRU SHOWFORM-EXIT.
           MOVE DISPLAY-REC    TO RENUMBER-SCREEN.
           MOVE 0              TO ERROR-SW.

           IF KEY-HIT = 3 OR 8
      *M********************************************************************
      *M    MESSAGE 036/020:
      *M JOBPLAN TASKS HAVE NOT BEEN RENUMBERED
      *M********************************************************************
               MOVE 36         TO LANG-SETNUM
               MOVE 20         TO LANG-MSGNUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE CATREAD-MSG-TEXT TO ERRMSG-ENTRY
               GO TO RENUMBER-FUNCTION-EXIT.

           IF KEY-HIT = 7
               MOVE  315       TO HELP-SW
               CALL "SPMHELPM" USING HELP-SW
               MOVE MESSAGE-BUFFER TO ERRMSG-RENUMBER
               GO TO SHOWFORM-RENUMBER.

           IF KEY-HIT NOT = 0
               GO TO SHOWFORM-RENUMBER.

           MOVE RENUM-START-BUF TO ADJ-4.
           PERFORM ADJUST-4.
           MOVE ADJ-4          TO RENUM-START-BUF.

           IF RENUM-START-BUF NOT NUMERIC
      *M********************************************************************
      *M    MESSAGE 046/042:
      *M  TASK NUMBER MUST BE NUMERIC
      *M********************************************************************
               MOVE 46         TO LANG-SETNUM
               MOVE 42         TO LANG-MSGNUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE CATREAD-MSG-TEXT TO ERRMSG-RENUMBER
               MOVE 8          TO FIELD-NUMBER
               PERFORM SET-ERROR
               GO TO SHOWFORM-RENUMBER.

           IF RENUM-START-BUF = ZEROS
      *M********************************************************************
      *M    MESSAGE 046/047:
      *M TASK NUMBER MAY NOT BE ZERO
      *M********************************************************************
               MOVE 46         TO LANG-SETNUM
               MOVE 47         TO LANG-MSGNUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE CATREAD-MSG-TEXT TO ERRMSG-RENUMBER
               MOVE 8          TO FIELD-NUMBER
               PERFORM SET-ERROR
               GO TO SHOWFORM-RENUMBER.

           MOVE RENUM-INCR-BUF TO ADJ-4.
           PERFORM ADJUST-4.
           MOVE ADJ-4          TO RENUM-INCR-BUF.

           IF RENUM-INCR-BUF NOT NUMERIC
      *M********************************************************************
      *M    MESSAGE 035/142:
      *M INCREMENT MUST BE NUMERIC
      *M********************************************************************
               MOVE 35         TO LANG-SETNUM
               MOVE 142        TO LANG-MSGNUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE CATREAD-MSG-TEXT TO ERRMSG-RENUMBER
               MOVE 9          TO FIELD-NUMBER
               PERFORM SET-ERROR
               GO TO SHOWFORM-RENUMBER.

           IF RENUM-INCR-BUF = ZEROS
      *M********************************************************************
      *M    MESSAGE 046/048:
      *M TASK INCREMENT MAY NOT BE ZERO
      *M********************************************************************
               MOVE 46         TO LANG-SETNUM
               MOVE 48         TO LANG-MSGNUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE CATREAD-MSG-TEXT TO ERRMSG-RENUMBER
               MOVE 9          TO FIELD-NUMBER
               PERFORM SET-ERROR
               GO TO SHOWFORM-RENUMBER.

           CALL "SPMRENUM"     USING DBPARAMETERS
                               RETURN-MSG
                               VIEW-COMAREA
                               LANGUAGE-PARMS
                               RENUM-JP-BUF
                               RENUM-START-BUF
                               RENUM-INCR-BUF
                               CNUM-BUF.

           IF RETURN-BYTE NOT = "0"
               MOVE SPACES     TO E1  RETURN-BYTE
      *M********************************************************************
      *M    MESSAGE 036/014:
      *M JOBPLAN IS CORRUPTED - A PRIOR RENUMBERING SEQUENCE HAS FAILED
      *M********************************************************************
               MOVE  36        TO LANG-SETNUM
               MOVE  14        TO LANG-MSGNUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE CATREAD-MSG-TEXT TO ERRMSG-RENUMBER
               MOVE 8          TO FIELD-NUMBER
               PERFORM SET-ERROR
               GO TO SHOWFORM-RENUMBER
           ELSE
               MOVE E1         TO ERRMSG-ENTRY
               MOVE SPACES     TO E1  RETURN-BYTE.

       RENUMBER-FUNCTION-EXIT.
           MOVE "VJOBPLAN_MENU" TO SCREEN-NAME.
           MOVE 1              TO FIELD-NUMBER.
           PERFORM SET-ERROR.
           MOVE SPACES         TO JP-SEQ-BUF.
           GO TO SHOWFORM-MAIN.

       DELETE-FUNCTION.
           MOVE "VPMJPDEL_ALL" TO SCREEN-NAME.

           MOVE SPACES         TO DELETING-SCREEN.
           MOVE JP-KEY-BUF     TO DELETE-NAME-BUF.
           MOVE "N"            TO DELETE-CONFIRM-BUF.
           MOVE 8              TO FIELD-NUMBER.

       SHOWFORM-DELETE.
           MOVE DELETING-SCREEN TO DISPLAY-REC.
           PERFORM SHOWFORM    THRU SHOWFORM-EXIT.
           MOVE DISPLAY-REC    TO DELETING-SCREEN.
           MOVE 0              TO ERROR-SW.

           IF KEY-HIT = 3 OR 8
      *M*******************************************************************
      *M    MESSAGE 036/019
      *M  JOBPLAN HAS NOT BEEN DELETED
      *M*******************************************************************
               MOVE 36         TO LANG-SETNUM
               MOVE 19         TO LANG-MSGNUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE CATREAD-MSG-TEXT TO ERRMSG-ENTRY
               GO TO DELETE-FUNCTION-EXIT.

           IF KEY-HIT = 7
               MOVE  316       TO HELP-SW
               CALL "SPMHELPM" USING HELP-SW
               MOVE MESSAGE-BUFFER TO ERRMSG-DELETING
               GO TO SHOWFORM-DELETE.

           IF KEY-HIT NOT = 0
               GO TO SHOWFORM-DELETE.

       CHECK-DELETE-CONFIRMATION.
           IF DELETE-CONFIRM-BUF NOT = "Y"
      *M*******************************************************************
      *M    MESSAGE 036/019
      *M  JOBPLAN HAS NOT BEEN DELETED
      *M*******************************************************************
               MOVE 36         TO LANG-SETNUM
               MOVE 19         TO LANG-MSGNUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE CATREAD-MSG-TEXT TO ERRMSG-ENTRY
               GO TO DELETE-FUNCTION-EXIT.

           CALL "SPMJPDEL"     USING DBPARAMETERS
                               RETURN-MSG
                               VIEW-COMAREA
                               LANGUAGE-PARMS
                               DELETE-NAME-BUF.

           MOVE E1             TO ERRMSG-ENTRY.
           PERFORM SET-ERROR
           MOVE SPACES         TO E1.
           MOVE SPACES         TO RETURN-BYTE.

       DELETE-FUNCTION-EXIT.
           MOVE "VJOBPLAN_MENU" TO SCREEN-NAME.
           MOVE 1              TO FIELD-NUMBER
           PERFORM SET-ERROR.
           MOVE SPACES         TO JP-SEQ-BUF.
           GO TO SHOWFORM-MAIN.

       GET-KEY-RECORD.
           MOVE JP-KEY-BUF     TO PMJOBPKEY OF PM-JOBPLAN-KEYS-I.
           START PM-JOBPLAN-KEYS-I KEY = PMJOBPKEY OF PM-JOBPLAN-KEYS-I
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
               MOVE "10"       TO FILE-STAT
               GO TO GKR-EXIT.

           READ PM-JOBPLAN-KEYS-I NEXT INTO PM-JP-KEY-DATA
               AT END          MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT = "10" OR "14" OR "46"
               GO TO GKR-EXIT
           ELSE
           IF FILE-STAT NOT = "00"
               MOVE FILE-STAT  TO CON-WORD
               MOVE "READ NXT" TO DB-TYPE
               MOVE "GET-KEY-RECORD" TO DB-PARA
               MOVE DB-ERROR   TO MESSAGE-BUFFER.

           IF PMJPK-JOBP-KEY NOT = JP-KEY-BUF
               MOVE "10"       TO FILE-STAT.

       GKR-EXIT.               EXIT.

       GET-NEXT-KEY.
           READ PM-JOBPLAN-KEYS-I NEXT INTO PM-JP-KEY-DATA
               AT END          MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT = "10" OR "14" OR "46"
               GO TO GNK-EXIT
           ELSE
           IF FILE-STAT NOT = "00"
               MOVE FILE-STAT  TO CON-WORD
               MOVE "READ NXT" TO DB-TYPE
               MOVE "GET-NEXT-KEY" TO DB-PARA
               MOVE DB-ERROR   TO MESSAGE-BUFFER
               MOVE "XX"       TO RETURN-COD
               GO TO GNK-EXIT.

           IF PMJPK-JOBP-KEY NOT = JP-KEY-BUF
               MOVE "10"       TO FILE-STAT
               GO TO GNK-EXIT.

           IF RECORD-KEY NOT = "TASKHD"
               GO TO GET-NEXT-KEY.

       GNK-EXIT.               EXIT.

       WRITE-KEY-RECORD.
           MOVE SCREEN-NAME    TO SAVEFORM.
           PERFORM GET-KEY-TITLE THRU GKT-EXIT.
           MOVE SAVEFORM       TO SCREEN-NAME.
           IF KEY-HIT = 3 OR 8
               GO TO WKR-EXIT.
           MOVE SPACES         TO PM-JP-KEY-DATA.
           MOVE "KEYREC"       TO RECORD-KEY.
           MOVE JP-KEY-BUF     TO PMJPK-JOBP-KEY PMJPK-JOBP-NAME.
           MOVE "0000"         TO PMJPK-TASK-NUM PMJPK-JOBP-TASK.
           MOVE CNUM-BUF       TO PMJPK-ORIGINATOR.

           ACCEPT PMJPK-DATE-STAMP FROM DATE.
           IF PMJPK-DATE-STAMP-YY > "70"
               MOVE "19" TO PMJPK-DATE-STAMP-CC
           ELSE
               MOVE "20" TO PMJPK-DATE-STAMP-CC.

           ACCEPT PMJPK-TIME-STAMP FROM TIME.
           MOVE JP-TITLE-BUF   TO PMJPK-KEY-TITLE.

           WRITE PM-JOBP-KEYS-REC FROM PM-JP-KEY-DATA
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
               MOVE FILE-STAT  TO CON-WORD
               MOVE "WRITE   " TO DB-TYPE
               MOVE "WRITE-KEY-RECORD" TO DB-PARA
               MOVE DB-ERROR   TO MESSAGE-BUFFER
               MOVE PMJPK-JOBP-KEY TO BU-DISPLAY-FLD (2)
               MOVE "WRITE ERR, WRITE-KEY-RECORD" TO BU-MSG-AREA
               PERFORM 999-BLOWUP.

       WKR-EXIT.               EXIT.

       GET-NEXT-TASK.
           MOVE SPACES         TO MESSAGE-BUFFER.
           PERFORM READ-KEY-CHAIN THRU RKC-EXIT.
           IF FILE-STAT = "10" OR "14" OR "46"
               READ PM-JOBPLAN-KEYS-I PRIOR INTO PM-JP-KEY-DATA
                   AT END      MOVE FILE-STAT TO FILE-STAT
               END-READ
               IF SEQ-INCREMENT = "    "
                   MOVE PMJPK-TASK-NUM TO TASK-SAVE
                   MOVE KEY-HIT TO KEY-SAVE
                   PERFORM SEQUENCING-FUNCTION THRU SF-EXIT
                   MOVE KEY-SAVE   TO KEY-HIT
                   ADD SEQ-INC     TO TASK-SAVE-9
                   MOVE TASK-SAVE  TO JP-SEQ-BUF
                   GO TO GNT-EXIT
               ELSE
                   MOVE PMJPK-TASK-NUM TO TASK-SAVE
                   ADD SEQ-INC     TO TASK-SAVE-9
                   MOVE TASK-SAVE  TO JP-SEQ-BUF
                   GO TO GNT-EXIT
           ELSE
           IF FILE-STAT NOT = "00"
               MOVE FILE-STAT  TO CON-WORD
               MOVE DB-ERROR   TO MESSAGE-BUFFER
               GO TO GNT-EXIT.

           MOVE PMJPK-TASK-NUM TO JP-SEQ-BUF.

       GNT-EXIT.               EXIT.

       READ-KEY-CHAIN.
           MOVE JP-KEY-BUF     TO PMJOBPKEY OF PM-JOBPLAN-KEYS-I.
           START PM-JOBPLAN-KEYS-I KEY = PMJOBPKEY OF PM-JOBPLAN-KEYS-I
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
               MOVE "START   " TO DB-TYPE
               MOVE "READ-KEY-CHAIN" TO DB-PARA
               GO TO RKC-EXIT.

           PERFORM LOOP-KEY-CHAIN THRU LKC-EXIT.
           IF FILE-STAT = "10" OR "14" OR "46"
               GO TO RKC-EXIT
           ELSE
           IF FILE-STAT NOT = "00"
               GO TO RKC-EXIT.
           IF PMJPK-JOBP-KEY NOT = JP-KEY-BUF
               MOVE "10"       TO FILE-STAT
               GO TO RKC-EXIT.

           READ PM-JOBPLAN-KEYS-I NEXT INTO PM-JP-KEY-DATA
               AT END          MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT = "10" OR "14" OR "46"
               GO TO RKC-EXIT
           ELSE
           IF FILE-STAT NOT = "00"
               MOVE "READ NXT" TO DB-TYPE
               MOVE "READ-KEY-CHAIN" TO DB-PARA
               GO TO RKC-EXIT.

           IF PMJPK-JOBP-KEY NOT = JP-KEY-BUF
               MOVE "10" TO FILE-STAT
               GO TO RKC-EXIT.

           MOVE PMJPK-TASK-NUM TO JP-SEQ-BUF.

       RKC-EXIT.               EXIT.

       GET-PREV-TASK.
           MOVE SPACES         TO MESSAGE-BUFFER.
           PERFORM BACKWARD-CHAIN THRU BC-EXIT.
           IF FILE-STAT = "10" OR "14" OR "46"
               MOVE JPKEY-TASK TO JP-SEQ-BUF
               GO TO GPT-EXIT
           ELSE
           IF FILE-STAT NOT = "00"
               MOVE JPKEY-TASK TO JP-SEQ-BUF
               MOVE FILE-STAT  TO CON-WORD
               MOVE DB-ERROR   TO MESSAGE-BUFFER
               GO TO GPT-EXIT.

           IF RECORD-KEY = "KEYREC"
               MOVE JPKEY-TASK TO JP-SEQ-BUF
               GO TO GPT-EXIT.

           MOVE PMJPK-TASK-NUM TO JP-SEQ-BUF.

       GPT-EXIT.               EXIT.

       BACKWARD-CHAIN.
           MOVE JP-KEY-BUF     TO PMJOBPKEY OF PM-JOBPLAN-KEYS-I.
           START PM-JOBPLAN-KEYS-I KEY = PMJOBPKEY OF PM-JOBPLAN-KEYS-I
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
               GO TO BC-EXIT.

           PERFORM LOOP-KEY-CHAIN THRU LKC-EXIT.
           IF FILE-STAT = "10" OR "14" OR "46"
               MOVE "00"       TO FILE-STAT
               GO TO BC-EXIT.
           IF FILE-STAT NOT = "00"
               GO TO BC-EXIT.

           IF PMJPK-JOBP-KEY NOT = JP-KEY-BUF  OR
              JP-TASK-KEY = PMJPK-JOBP-SEQ-KEY
               READ PM-JOBPLAN-KEYS-I PRIOR INTO PM-JP-KEY-DATA
                   AT END      MOVE FILE-STAT TO FILE-STAT
               END-READ
               IF FILE-STAT NOT = "00"
                   GO TO BC-EXIT
               ELSE
               IF PMJPK-JOBP-KEY NOT = JP-KEY-BUF
                   MOVE JPKEY-TASK TO PMJPK-TASK-NUM
                   GO TO BC-EXIT.

       BC-EXIT.                EXIT.

       LOOP-KEY-CHAIN.
           READ PM-JOBPLAN-KEYS-I NEXT INTO PM-JP-KEY-DATA
              AT END           MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT = "10" OR "14" OR "46"
               GO TO LKC-EXIT
           ELSE
           IF FILE-STAT NOT = "00"
               MOVE "READ NXT" TO DB-TYPE
               MOVE "LOOP-KEY-CHAIN" TO DB-PARA
               GO TO LKC-EXIT.

           IF PMJPK-JOBP-KEY NOT = JP-KEY-BUF
               GO TO LKC-EXIT.

           IF JP-TASK-KEY = PMJPK-JOBP-SEQ-KEY
               GO TO LKC-EXIT.

           GO TO LOOP-KEY-CHAIN.

       LKC-EXIT.               EXIT.

       GET-LAST-TASK.
           MOVE JP-KEY-BUF     TO PMJOBPKEY OF PM-JOBPLAN-KEYS-I.
           START PM-JOBPLAN-KEYS-I KEY > PMJOBPKEY OF PM-JOBPLAN-KEYS-I
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
               READ PM-JOBPLAN-KEYS-I LAST INTO PM-JP-KEY-DATA
                   AT END      MOVE FILE-STAT TO FILE-STAT
               END-READ
               IF FILE-STAT NOT = "00"
                   MOVE FILE-STAT   TO CON-WORD
                   MOVE "READ LST"  TO DB-TYPE
                   MOVE "GET-LAST-TASK" TO DB-PARA
                   MOVE DB-ERROR    TO MESSAGE-BUFFER
                   GO TO GLT-EXIT
               ELSE
                   IF PMJPK-JOBP-KEY NOT = JP-KEY-BUF
                       MOVE FILE-STAT   TO CON-WORD
                       MOVE "10" TO FILE-STAT
                       MOVE "READ LST" TO DB-TYPE
                       MOVE "GET-LAST-TASK" TO DB-PARA
                       MOVE DB-ERROR TO MESSAGE-BUFFER
                       GO TO GLT-EXIT
                   ELSE
                       GO TO GLT-EXIT.

           READ PM-JOBPLAN-KEYS-I PRIOR INTO PM-JP-KEY-DATA
               AT END          MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
               GO TO GLT-EXIT
           ELSE
               IF PMJPK-JOBP-KEY NOT = JP-KEY-BUF
                   MOVE FILE-STAT   TO CON-WORD
                   MOVE "10"   TO FILE-STAT
                   MOVE "READ PRI" TO DB-TYPE
                   MOVE "GET-LAST-TASK" TO DB-PARA
                   MOVE DB-ERROR TO MESSAGE-BUFFER.

       GLT-EXIT.               EXIT.

       CHECK-FOR-TASK.
           MOVE JP-TASK-KEY    TO JOBPWOSEQ OF PM-JOBP-KEYS-TASK-I.
           START PM-JOBP-KEYS-TASK-I KEY = JOBPWOSEQ
                               OF PM-JOBP-KEYS-TASK-I
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT = "23"
               GO TO CFT-EXIT
           ELSE
           IF FILE-STAT NOT = "00"
               MOVE FILE-STAT  TO CON-WORD
               MOVE "START   " TO DB-TYPE
               MOVE "CHECK-FOR-TASK" TO DB-PARA
               MOVE DB-ERROR   TO MESSAGE-BUFFER
               MOVE "XX"       TO RETURN-COD
               GO TO CFT-EXIT.

           READ PM-JOBP-KEYS-TASK-I NEXT INTO PM-JP-KEY-DATA
               AT END          MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT = "10" OR "14" OR "46"
               GO TO CFT-EXIT
           ELSE
           IF FILE-STAT NOT = "00"
               MOVE FILE-STAT  TO CON-WORD
               MOVE "READ KEY" TO DB-TYPE
               MOVE "CHECK-FOR-TASK" TO DB-PARA
               MOVE DB-ERROR   TO MESSAGE-BUFFER
               MOVE "XX"       TO RETURN-COD.

       CFT-EXIT.               EXIT.

       DELETE-KEY-RECORD.
           MOVE JP-KEY-BUF     TO PMJOBPKEY OF PM-JOBPLAN-KEYS.
           START PM-JOBPLAN-KEYS KEY = PMJOBPKEY OF PM-JOBPLAN-KEYS
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
               GO TO DKR-EXIT.

           READ PM-JOBPLAN-KEYS NEXT INTO PM-JP-KEY-DATA
               AT END          MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT = "10" OR "14" OR "46"
               GO TO DKR-EXIT
           ELSE
           IF FILE-STAT NOT = "00"
               MOVE FILE-STAT  TO CON-WORD
               MOVE "READ NXT" TO DB-TYPE
               MOVE "DELETE-KEY-RECORD" TO DB-PARA
               MOVE DB-ERROR   TO MESSAGE-BUFFER
               GO TO DKR-EXIT.

           IF PMJPK-JOBP-KEY NOT = JP-KEY-BUF
               MOVE HIGH-VALUES TO PMJOBPKEY OF PM-JOBPLAN-KEYS
               START PM-JOBPLAN-KEYS KEY = PMJOBPKEY OF PM-JOBPLAN-KEYS
                   INVALID KEY MOVE FILE-STAT TO FILE-STAT
               END-START
               MOVE "10"       TO FILE-STAT
               GO TO DKR-EXIT.

           IF RECORD-KEY NOT = "KEYREC"
               GO TO DKR-EXIT.

           DELETE PM-JOBPLAN-KEYS
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
               MOVE FILE-STAT  TO CON-WORD
               MOVE "DELETE  " TO DB-TYPE
               MOVE "DELETE-KEY-RECORD" TO DB-PARA
               MOVE DB-ERROR   TO MESSAGE-BUFFER
               MOVE PMJPK-JOBP-KEY TO BU-DISPLAY-FLD (2)
               MOVE RECORD-KEY TO BU-DISPLAY-FLD (3)
               MOVE "DEL ERR, DELETE-KEY-RECORD" TO BU-MSG-AREA
               PERFORM 999-BLOWUP.

       DKR-EXIT.               EXIT.

       GET-KEY-TITLE.
           MOVE "VJPCREATE"    TO SCREEN-NAME.
           MOVE 999            TO HELP-SW.
           MOVE SPACES         TO TITLE-SCREEN.
           MOVE BANNER-DATA    TO BANNER-DISP.
           MOVE JP-KEY-BUF     TO JPKEY-TITLE.

       SHOWFORM-TITLE.
           MOVE 9              TO ERROR-SW.
           MOVE TITLE-SCREEN   TO DISPLAY-REC.
           PERFORM SHOWFORM    THRU SHOWFORM-EXIT.
           MOVE DISPLAY-REC    TO TITLE-SCREEN.
           MOVE 0              TO ERROR-SW.

           IF KEY-HIT = 3 OR 8
               GO TO GKT-EXIT.

           IF KEY-HIT NOT = 0
               GO TO SHOWFORM-TITLE.

           IF JP-TITLE-BUF = SPACES
      *M********************************************************************
      *M    MESSAGE 030/042:
      *M DESCRIPTION REQUIRED
      *M********************************************************************
               MOVE  30        TO LANG-SETNUM
               MOVE  42        TO LANG-MSGNUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE CATREAD-MSG-TEXT TO ERRMSG-TITLE
               MOVE  2         TO FIELD-NUMBER ERROR-SW
               PERFORM SET-ERROR
               GO TO SHOWFORM-TITLE.

       GKT-EXIT.               EXIT.

       SAVE-DATA.
           IF SAVE-SW = 0
               GO TO MAIN.

           MOVE 0              TO SAVE-SW.
           MOVE "VJOBPLAN_SAVE" TO SCREEN-NAME.

           MOVE SPACES         TO SAVE-SCREEN.
           MOVE JP-KEY-DISP    TO S-KEY.
           MOVE JP-SEQ-DISP    TO S-SEQ.
           MOVE JP-LEVEL-BUF   TO S-LEVEL.
           MOVE JP-EXFLAG-BUF  TO S-FLAG.
           MOVE SUBSYS-BUF     TO S-SS.
           MOVE CRAFT-BUF      TO S-CRAFT.
           MOVE MEN-BUF        TO S-MEN.
           MOVE EST-HRS-BUF    TO S-EST.
           MOVE DT-HRS-BUF     TO S-DT.
           MOVE OWNR           TO S-OWNER.
           MOVE CNUM-BUF       TO S-EDITOR.

       SHOWFORM-SAVE.
           MOVE 9              TO ERROR-SW.
           MOVE SAVE-SCREEN    TO DISPLAY-REC.
           PERFORM SHOWFORM    THRU SHOWFORM-EXIT.
           MOVE DISPLAY-REC    TO SAVE-SCREEN.
           MOVE 0              TO ERROR-SW.

           IF KEY-HIT = 7
               MOVE  34        TO HELP-SW
               CALL "SPMHELPM" USING HELP-SW
               MOVE MESSAGE-BUFFER TO ERRMSG-SAVE
               GO TO SHOWFORM-SAVE.

           IF KEY-HIT = 5
               PERFORM CHECK-FOR-DATA THRU CFD-EXIT
               IF NO-DATA
                   MOVE JP-KEY-SEQ TO DEL-KEY-SEQ
                   PERFORM DELETE-BLANK-TASK THRU DBT-EXIT
                   MOVE 0      TO KEY-SW
               END-IF
               IF KEY-SW = 1
                   PERFORM DELETE-KEY-RECORD THRU DKR-EXIT
                   MOVE 0      TO KEY-SW
                   GO TO MAIN
               ELSE
                   GO TO MAIN.

           IF KEY-HIT = 6
               PERFORM WRITE-LOOP THRU WRITE-EXIT
               IF RETURN-COD NOT = "  "
                   MOVE MESSAGE-BUFFER TO ERRMSG-SAVE
                   PERFORM SET-ERROR
                   GO TO SHOWFORM-SAVE
               ELSE
                   PERFORM CHECK-FOR-DATA THRU CFD-EXIT
                   IF NO-DATA
                       MOVE JP-KEY-SEQ TO DEL-KEY-SEQ
                       PERFORM DELETE-BLANK-TASK THRU DBT-EXIT
                   END-IF
                   GO TO MAIN.

           IF KEY-HIT = 1
               PERFORM CHECK-FOR-DATA THRU CFD-EXIT
               MOVE JP-KEY-SEQ TO DEL-KEY-SEQ
               PERFORM GET-PREV-TASK THRU GPT-EXIT
               IF NO-DATA
                   PERFORM DELETE-BLANK-TASK THRU DBT-EXIT
               END-IF
               MOVE 2          TO KEY-HIT
               PERFORM SET-VALUES
               GO TO PARSE-KEY-HIT.

           IF KEY-HIT = 2
               PERFORM CHECK-FOR-DATA THRU CFD-EXIT
               MOVE JP-KEY-SEQ TO DEL-KEY-SEQ
               PERFORM GET-NEXT-TASK THRU GNT-EXIT
               IF NO-DATA
                   PERFORM DELETE-BLANK-TASK THRU DBT-EXIT
               END-IF
               MOVE 2          TO KEY-HIT
               PERFORM SET-VALUES
               GO TO PARSE-KEY-HIT.

           IF KEY-HIT = 8
               GO TO SHOWFORM-SAVE.

           IF KEY-HIT = 0
               GO TO SAVE-CONTINUE.

           IF GO-TO-TASK = SPACES
               GO TO SHOWFORM-SAVE.

           MOVE GO-TO-TASK     TO ADJ-4.
           PERFORM ADJUST-4.
           MOVE ADJ-4          TO GO-TO-TASK.

           IF GO-TO-TASK NOT NUMERIC
      *M********************************************************************
      *M    MESSAGE 046/042:
      *M  TASK NUMBER MUST BE NUMERIC
      *M********************************************************************
               MOVE 46         TO LANG-SETNUM
               MOVE 42         TO LANG-MSGNUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE CATREAD-MSG-TEXT TO ERRMSG-SAVE
               MOVE 96         TO FIELD-NUMBER
               PERFORM SET-ERROR
               GO TO SHOWFORM-SAVE.

           IF GO-TO-TASK = ZEROS
      *M********************************************************************
      *M    MESSAGE 046/047:
      *M TASK NUMBER MAY NOT BE ZERO
      *M********************************************************************
               MOVE 46         TO LANG-SETNUM
               MOVE 47         TO LANG-MSGNUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE CATREAD-MSG-TEXT TO ERRMSG-SAVE
               MOVE 96         TO FIELD-NUMBER
               PERFORM SET-ERROR
               GO TO SHOWFORM-SAVE.

           IF KEY-HIT = 3
               PERFORM CHECK-FOR-DATA THRU CFD-EXIT
               IF NO-DATA
                   MOVE JP-KEY-SEQ TO DEL-KEY-SEQ
                   PERFORM DELETE-BLANK-TASK THRU DBT-EXIT
                   MOVE 0      TO KEY-SW
               END-IF
               IF KEY-SW = 1
                   PERFORM DELETE-KEY-RECORD THRU DKR-EXIT
                   MOVE 0      TO KEY-SW
                   MOVE GO-TO-TASK TO JP-SEQ-BUF
                   MOVE 2      TO KEY-HIT
                   PERFORM SET-VALUES
                   GO TO PARSE-KEY-HIT
               ELSE
                   MOVE GO-TO-TASK TO JP-SEQ-BUF
                   MOVE 2      TO KEY-HIT
                   PERFORM SET-VALUES
                   GO TO PARSE-KEY-HIT.

           IF KEY-HIT = 4
               PERFORM WRITE-LOOP THRU WRITE-EXIT
               IF RETURN-COD NOT = "  "
                   MOVE MESSAGE-BUFFER TO ERRMSG-SAVE
                   PERFORM SET-ERROR
                   GO TO SHOWFORM-SAVE
               ELSE
               PERFORM CHECK-FOR-DATA THRU CFD-EXIT
               IF NO-DATA
                   MOVE JP-KEY-SEQ TO DEL-KEY-SEQ
                   PERFORM DELETE-BLANK-TASK THRU DBT-EXIT
                   MOVE 0 TO KEY-SW
               END-IF
               IF KEY-SW = 1
                   PERFORM DELETE-KEY-RECORD THRU DKR-EXIT
                   MOVE 0      TO KEY-SW
                   MOVE GO-TO-TASK TO JP-SEQ-BUF
                   MOVE 2      TO KEY-HIT
                   PERFORM SET-VALUES
                   GO TO PARSE-KEY-HIT
               ELSE
                   MOVE GO-TO-TASK TO JP-SEQ-BUF
                   MOVE 2      TO KEY-HIT
                   PERFORM SET-VALUES
                   GO TO PARSE-KEY-HIT.

       SAVE-CONTINUE.
           PERFORM WRITE-LOOP  THRU WRITE-EXIT.

           IF RETURN-COD NOT = "  "
               MOVE MESSAGE-BUFFER TO ERRMSG-SAVE
               PERFORM SET-ERROR
               GO TO SHOWFORM-SAVE.

           IF RETURN-SCREEN = "AD"
               GO TO ADD-MODE
           ELSE
           IF RETURN-SCREEN = "DS"
               GO TO DISPLAY-MODE
           ELSE
           IF RETURN-SCREEN = "ED"
               GO TO EDIT-MODE.

       END-OF-JOB.
           CLOSE               DISPLAY-FILE
                               PM-JOBPLAN
                               PM-JOBPLAN-KEYS
                               PM-JOBPLAN-KEYS-I
                               PM-JOBPLAN-TASK
                               PM-JOBPLAN-TASK-I
                               PM-JOBP-KEYS-TASK
                               PM-JOBP-KEYS-TASK-I
                               MSTORERM
                               WO-CRAFTS-REQD.

       END-OF-JOB-GOBACK.
           GOBACK.

       WRITE-LOOP.
           IF NO-DATA  PERFORM CHECK-FOR-DATA THRU CFD-EXIT.
           IF NO-DATA          GO TO WRITE-EXIT.
           MOVE 0              TO KEY-SW.
           MOVE "  "           TO RETURN-COD.
           MOVE JP-KEY-BUF     TO JPKEY-NAME.
           MOVE JP-SEQ-BUF     TO JPKEY-TASK.
           PERFORM CHECK-FOR-TASK THRU CFT-EXIT.
           IF RETURN-COD NOT = "  "
               GO TO WRITE-EXIT.

           IF FILE-STAT = "10" OR "14" OR "46" OR "23"
               MOVE SPACES     TO PM-JP-KEY-DATA
               PERFORM WRITE-TASK-RECORD THRU WTR-EXIT
           ELSE
               PERFORM UPDATE-TASK-RECORD THRU UTR-EXIT.

           IF RETURN-COD NOT = "  "
               GO TO WRITE-EXIT.

           MOVE LOW-VALUES     TO PM-JOBPLAN-DATA.
           MOVE 0              TO SUB1.
           MOVE 160            TO SUB2.

           PERFORM VARYING SUB2 FROM 160 BY -1
               UNTIL JOBP-DESC(SUB2) NOT = SPACES OR SUB2 = 1
               CONTINUE
           END-PERFORM.

           MOVE JP-KEY-SEQ     TO JOBPWOSEQ OF PM-JOBPLAN-TASK.
           START PM-JOBPLAN-TASK KEY = JOBPWOSEQ OF PM-JOBPLAN-TASK
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
               GO TO DBGET-WRITE-LOOP.

           PERFORM DELETE-RECORDS
                               UNTIL FILE-STAT NOT = "00".

           IF RETURN-COD NOT = "  "
               GO TO WRITE-EXIT.

       DBGET-WRITE-LOOP.
           MOVE JP-KEY-DISP    TO JOBPLAN-KEY PMJP-KEY.
           MOVE JP-SEQ-DISP    TO PMJP-SEQN   PMJP-SEQ.
           MOVE JP-LEVEL-BUF   TO PMJP-LEVEL.
           MOVE JP-EXFLAG-BUF  TO PMJP-FLAG.
           MOVE SUBSYS-BUF     TO PMJP-SS.
           MOVE CRAFT-BUF      TO PMJP-CRAFT.
           MOVE MEN-BUF        TO PMJP-MNX.
           MOVE EST-HRS-BUF    TO PMJP-EST.
           MOVE DT-HRS-BUF     TO PMJP-DT.

           PERFORM WRITE-RECORDS THRU WR-EXIT
               UNTIL SUB1 = SUB2.

       WRITE-EXIT.             EXIT.

       WRITE-RECORDS.
           ADD 1                TO SUB1.
           MOVE SUB1            TO PMJP-LINE.
           MOVE JOBP-DESC(SUB1) TO PMJP-DESC.
           MOVE JOBP-PRT(SUB1)  TO PMJP-CORP-CODE.
           IF JOBP-PQTY(SUB1) IS NUMERIC
               MOVE JOBP-QTY-9(SUB1) TO PMJP-EST-QTY-9
           ELSE
               MOVE SPACES      TO PMJP-EST-QTY.
           MOVE JOBP-PTXT(SUB1) TO PMJP-TEXT.
           MOVE JOBP-PTUM(SUB1) TO PMJP-UNIT-MEAS.

           WRITE PM-JOBPLAN-REC FROM PM-JOBPLAN-DATA
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
               MOVE "WRITE   " TO DB-TYPE
               MOVE "WRITE-RECORDS" TO DB-PARA
               MOVE FILE-STAT  TO CON-WORD
               MOVE DB-ERROR   TO MESSAGE-BUFFER
               MOVE "XX"       TO RETURN-COD
               MOVE SUB2       TO SUB1.

       WR-EXIT.                EXIT.

       CHECK-FOR-DATA.
           MOVE 0              TO SUB1 DATA-SW.
           PERFORM CHECK-LOOP  THRU CL-EXIT.

       CFD-EXIT.               EXIT.

       CHECK-LOOP.
           ADD 1               TO SUB1.
           IF SUB1 > 160
               GO TO CL-EXIT.

           IF JOBP-DESC(SUB1) NOT = SPACES
               MOVE 1          TO DATA-SW
               GO TO CL-EXIT.

           GO TO CHECK-LOOP.

       CL-EXIT.                EXIT.

       WRITE-TASK-RECORD.
           MOVE "TASKHD"       TO RECORD-KEY.
           MOVE JP-KEY-BUF     TO PMJPK-JOBP-KEY PMJPK-JOBP-NAME.
           MOVE JP-SEQ-BUF     TO PMJPK-TASK-NUM PMJPK-JOBP-TASK.
           MOVE CNUM-BUF       TO PMJPK-ORIGINATOR.

           ACCEPT PMJPK-DATE-STAMP FROM DATE.
           IF PMJPK-DATE-STAMP-YY > "70"
               MOVE "19" TO PMJPK-DATE-STAMP-CC
           ELSE
               MOVE "20" TO PMJPK-DATE-STAMP-CC.
           ACCEPT PMJPK-TIME-STAMP FROM TIME.

           WRITE PM-JOBP-KEYS-TASK-REC FROM PM-JP-KEY-DATA
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
               MOVE FILE-STAT  TO CON-WORD
               MOVE "WRITE   " TO DB-TYPE
               MOVE "WRITE-TASK-RECORD" TO DB-PARA
               MOVE DB-ERROR   TO MESSAGE-BUFFER
               MOVE "XX"       TO RETURN-COD
               GO TO WTR-EXIT.

       WTR-EXIT.               EXIT.

       UPDATE-TASK-RECORD.
           MOVE JP-TASK-KEY    TO JOBPWOSEQ OF PM-JOBP-KEYS-TASK.
           READ PM-JOBP-KEYS-TASK INTO PM-JP-KEY-DATA
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           MOVE CNUM-BUF       TO PMJPK-ORIGINATOR.
           ACCEPT PMJPK-DATE-STAMP FROM DATE.

           IF PMJPK-DATE-STAMP-YY > "70"
               MOVE "19" TO PMJPK-DATE-STAMP-CC
           ELSE
               MOVE "20" TO PMJPK-DATE-STAMP-CC.
           ACCEPT PMJPK-TIME-STAMP FROM TIME.

           REWRITE PM-JOBP-KEYS-TASK-REC FROM PM-JP-KEY-DATA
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
               MOVE FILE-STAT  TO CON-WORD
               MOVE "REWRITE " TO DB-TYPE
               MOVE "UPDATE-TASK-RECORD" TO DB-PARA
               MOVE DB-ERROR   TO MESSAGE-BUFFER
               MOVE "XX"       TO RETURN-COD
               GO TO UTR-EXIT.

       UTR-EXIT.               EXIT.

       SET-ERROR.
           MOVE B"1"           TO IND (FIELD-NUMBER)  IND (99).

       999-CATREAD.
           MOVE SPACES         TO CATREAD-MSG-TEXT.
           MOVE LANG-SETNUM    TO CATREAD-MSG-SET.
           MOVE LANG-MSGNUM    TO CATREAD-MSG-NUM.
           CALL "CCATREAD"     USING CATREAD-PARMS.
           IF CATREAD-MSG-NOT-FOUND
                MOVE "**ERROR ON THIS FIELD**" TO CATREAD-MSG-TEXT.

       999-CATREAD-EXIT.       EXIT.

       SET-VALUES.
           MOVE 0              TO SUB SUB1 SUB2 SUBS SAVE-SW DATA-SW
                                  LC EDIT-SW ERROR-SW KEY-SW.
           MOVE 1              TO DISP-S DISP-E.
           MOVE LOW-VALUES     TO PM-JOBPLAN-DATA
           MOVE SPACES         TO RETURN-COD DELETE-SCREEN
                                  JOBPLAN-LINE INPUT-TABLE
                                  RETURN-SCREEN OPTIONS-SCREEN
                                  PARTS-SCREEN PART-DISP
                                  PARTS-TABLE SCREEN-DATA.

       SHOWFORM.
           MOVE "00"           TO SCREEN-STATUS.
           WRITE DISPLAY-REC   FORMAT IS SCREEN-NAME
               INDIC ARE SCREEN-INDICATORS.
           IF SCREEN-STATUS NOT = "00"
               DISPLAY "SCREEN WRITE ERROR.  SCREEN-STATUS IS "
                        SCREEN-STATUS
               GO TO END-OF-JOB.

           READ  DISPLAY-FILE  FORMAT IS SCREEN-NAME
               INDIC ARE SCREEN-INDICATORS.
           IF SCREEN-STATUS NOT = "00"
               DISPLAY "SCREEN READ ERROR.  SCREEN-STATUS IS "
                        SCREEN-STATUS
               GO TO END-OF-JOB.

           MOVE ALL B"0"       TO SCREEN-INDICATORS.

       SHOWFORM-EXIT.          EXIT.

       OPTIONS-MENU SECTION 03.
       OPTS-MENU.
           MOVE "VJOBPLAN_OPTS" TO SCREEN-NAME.
           MOVE JP-KEY-BUF     TO JP-KEY-OS JP-KEY-DL JP-KEY-CO
                                  JP-KEY-MO JP-KEY-DEL.
           MOVE JP-SEQ-BUF     TO JP-SEQ-OS JP-SEQ-DL
                                  JP-SEQ-DEL.
      *    MOVE SPACES         TO JP-KEY-SEQ-CO JP-KEY-SEQ-MO.
           MOVE SEQ-INCREMENT  TO CUR-INCREMENT.

       SHOWFORM-OPTS.
           MOVE 9              TO ERROR-SW.
           MOVE OPTIONS-SCREEN TO DISPLAY-REC.
           PERFORM SHOWFORM    THRU SHOWFORM-EXIT.
           MOVE DISPLAY-REC    TO OPTIONS-SCREEN.
           MOVE 0              TO ERROR-SW.

           IF KEY-HIT = 3 OR 8
               GO TO ADD-MODE.

           IF KEY-HIT = 1
               IF NO-DATA
      *M********************************************************************
      *M    MESSAGE 046/046:
      *M THERE IS NO DATA IN THIS TASK TO XXXX
      *M********************************************************************
                   MOVE  46    TO LANG-SETNUM
                   MOVE  46    TO LANG-MSGNUM
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE CATREAD-MSG-TEXT TO NO-DATA-MSG
      *M********************************************************************
      *M    MESSAGE 029/127:
      *M COPY                << MAXIMUM 4 CHARACTERS >>                 C127
      *M********************************************************************
                   MOVE  29    TO LANG-SETNUM
                   MOVE 127    TO LANG-MSGNUM
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE CATREAD-MSG-TEXT TO MOVE-COPY
                   MOVE NO-DATA-MSG TO ERRMSG-OPTIONS
                   GO TO SHOWFORM-OPTS
               ELSE
                   MOVE "COPY" TO COPY-MOVE-SW
                   PERFORM COPY-TASK-FUNCTION THRU CTF-EXIT
                   GO TO OPTIONS-MENU.

           IF KEY-HIT = 2
               IF NO-DATA
      *M********************************************************************
      *M    MESSAGE 046/046:
      *M THERE IS NO DATA IN THIS TASK TO XXXX
      *M********************************************************************
                   MOVE  46    TO LANG-SETNUM
                   MOVE  46    TO LANG-MSGNUM
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE CATREAD-MSG-TEXT TO NO-DATA-MSG
      *M********************************************************************
      *M    MESSAGE 039/051:
      *M MOVE              << MAXIMUM 4 CHARACTERS >>
      *M********************************************************************
                   MOVE  39    TO LANG-SETNUM
                   MOVE  51    TO LANG-MSGNUM
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE CATREAD-MSG-TEXT TO MOVE-COPY
                   MOVE NO-DATA-MSG TO ERRMSG-OPTIONS
                   GO TO SHOWFORM-OPTS
               ELSE
                   MOVE "MOVE" TO COPY-MOVE-SW
                   PERFORM MOVE-TASK-FUNCTION THRU MTF-EXIT
                   IF DEL-CONF NOT = "Y"
                       GO TO OPTIONS-MENU
                   ELSE
                       GO TO MAIN.

           IF KEY-HIT = 4
               PERFORM SEQUENCING-FUNCTION THRU SF-EXIT
               GO TO OPTIONS-MENU.

           IF KEY-HIT = 6
               PERFORM DELETE-TASK-FUNCTION THRU DTF-EXIT
               IF DEL-CONF NOT = "Y"
                   GO TO OPTIONS-MENU
               ELSE
                   GO TO MAIN.

           IF KEY-HIT = 7
               MOVE 33         TO HELP-SW
               CALL "SPMHELPM" USING HELP-SW
               MOVE MESSAGE-BUFFER TO ERRMSG-OPTIONS.

           GO TO SHOWFORM-OPTS.

       COPY-TASK-FUNCTION.
           MOVE "VJOBPLAN23"   TO SCREEN-NAME.
      *M********************************************************************
      *M    MESSAGE 031/019:
      *M ENTER DATA AND PRESS 'ENTER' KEY
      *M********************************************************************
           MOVE  31            TO LANG-SETNUM
           MOVE  19            TO LANG-MSGNUM
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
           MOVE CATREAD-MSG-TEXT TO ERRMSG-OPTIONS.

       SHOWFORM-OPTS-C.
           MOVE SPACES         TO TASK-TABLES.
           MOVE 9              TO ERROR-SW.
           MOVE OPTIONS-SCREEN TO DISPLAY-REC.
           PERFORM SHOWFORM    THRU SHOWFORM-EXIT.
           MOVE DISPLAY-REC    TO OPTIONS-SCREEN.
           MOVE 0              TO ERROR-SW.

           IF KEY-HIT = 3 OR 8
               GO TO CTF-EXIT.

           IF KEY-HIT = 7
               MOVE 331        TO HELP-SW
               CALL "SPMHELPM" USING HELP-SW
               MOVE MESSAGE-BUFFER TO ERRMSG-OPTIONS
               GO TO SHOWFORM-OPTS-C.

           IF KEY-HIT NOT = 0
               GO TO SHOWFORM-OPTS-C.

           IF JP-SEQ-CO = "MULT"
               PERFORM MULTI-COPY-LOOP THRU MULTI-COPY-EXIT
           ELSE
               PERFORM COPY-FUNCTION-LOOP THRU COPY-FUNC-EXIT.

       CTF-EXIT.               EXIT.

       MULTI-COPY-LOOP.
           MOVE "  "           TO RETURN-COD.
           PERFORM FILL-TASK-TABLE THRU FTT-EXIT.
           IF RETURN-COD NOT = "  "
               MOVE "VJOBPLAN23"   TO SCREEN-NAME
               MOVE MESSAGE-BUFFER TO ERRMSG-OPTIONS
               MOVE  3         TO FIELD-NUMBER
               MOVE TRUE-VAL   TO IND(FIELD-NUMBER) IND(99)
               GO TO SHOWFORM-OPTS-C.

           IF KEY-HIT = 3 OR 8
               MOVE SPACES     TO JP-SEQ-CO
               GO TO OPTS-MENU.

           PERFORM COPY-TASK-LOOP THRU CTL-EXIT.
           MOVE SPACES         TO JP-KEY-SEQ-CO.

       MULTI-COPY-EXIT.        EXIT.

       COPY-FUNCTION-LOOP.
           MOVE JP-SEQ-CO      TO ADJ-4.
           PERFORM ADJUST-4.
           MOVE ADJ-4          TO JP-SEQ-CO.

           IF JP-SEQ-CO NOT NUMERIC
               MOVE SPACES     TO JP-SEQ-CO.

           IF JP-SEQ-CO = "0000"
               MOVE SPACES     TO JP-SEQ-CO.

           IF SPACES = JP-KEY-CO OR JP-SEQ-CO
               GO TO SHOWFORM-OPTS-C.

           IF JP-KEY-CO = JP-KEY-OS
               MOVE JP-KEY-CO  TO JPKEY-NAME
               MOVE JP-SEQ-CO  TO JPKEY-TASK
               PERFORM CHECK-FOR-TASK THRU CFT-EXIT
               IF FILE-STAT = "10" OR "14" OR "46" OR "23"
                   PERFORM READ-SCREEN
                   PERFORM COPY-SINGLE-TASK THRU CST-EXIT
                   GO TO COPY-FUNC-EXIT
               ELSE
               IF FILE-STAT NOT = "00"
                   MOVE MESSAGE-BUFFER TO ERRMSG-OPTIONS
                   MOVE 3      TO FIELD-NUMBER
                   PERFORM SET-ERROR
                   GO TO SHOWFORM-OPTS-C
               ELSE
      *M********************************************************************
      *M    MESSAGE 046/045:
      *M TASK XXXX OF JOBPLAN XXXXXXXXXX ALREADY EXISTS - CANNOT XXXX THIS TA
      *M********************************************************************
                   MOVE  46    TO LANG-SETNUM
                   MOVE  45    TO LANG-MSGNUM
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE CATREAD-MSG-TEXT TO COPY-MOVE-MSG
                   MOVE JP-SEQ-CO TO MSG-TASK
                   MOVE JP-KEY-CO TO MSG-NAME
      *M********************************************************************
      *M    MESSAGE 029/127:
      *M COPY                << MAXIMUM 4 CHARACTERS >>                 C127
      *M********************************************************************
                   MOVE  29    TO LANG-SETNUM
                   MOVE 127    TO LANG-MSGNUM
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE CATREAD-MSG-TEXT TO COPY-MOVE
                   MOVE COPY-MOVE-MSG TO ERRMSG-OPTIONS
                   MOVE 3      TO FIELD-NUMBER
                   PERFORM SET-ERROR
                   GO TO SHOWFORM-OPTS-C.

           MOVE JP-KEY-SEQ-OS  TO COMO-SAVE.
           MOVE JP-KEY-CO      TO JP-KEY-BUF JP-KEY-DISP.
           PERFORM GET-KEY-RECORD THRU GKR-EXIT.
           IF FILE-STAT = "10" OR "14" OR "46"
               PERFORM WRITE-KEY-RECORD THRU WKR-EXIT
               IF FILE-STAT NOT = "00"
                   MOVE COMO-SAVE TO JP-KEY-SEQ
                                     JP-KEY-SEQ-DISP
                   MOVE MESSAGE-BUFFER TO ERRMSG-OPTIONS
                   MOVE 3      TO FIELD-NUMBER
                   PERFORM SET-ERROR
                   GO TO SHOWFORM-OPTS-C
               ELSE
                   PERFORM READ-SCREEN
                   PERFORM COPY-SINGLE-TASK THRU CST-EXIT
                   GO TO COPY-FUNC-EXIT
           ELSE
           IF FILE-STAT NOT = "00"
               MOVE COMO-SAVE  TO JP-KEY-SEQ
                                  JP-KEY-SEQ-DISP
               MOVE MESSAGE-BUFFER TO ERRMSG-OPTIONS
               MOVE 3          TO FIELD-NUMBER
               PERFORM SET-ERROR
               GO TO SHOWFORM-OPTS-C.

           IF RECORD-KEY NOT = "KEYREC"
      *M********************************************************************
      *M    MESSAGE 036/008:
      *M JOBPLAN DOES NOT EXIST
      *M********************************************************************
               MOVE  36        TO LANG-SETNUM
               MOVE   8        TO LANG-MSGNUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE CATREAD-MSG-TEXT TO ERRMSG-OPTIONS
               MOVE 4          TO FIELD-NUMBER
               PERFORM SET-ERROR
               GO TO SHOWFORM-OPTS-C.

           PERFORM READ-SCREEN.
           PERFORM COPY-SINGLE-TASK THRU CST-EXIT.

       COPY-FUNC-EXIT.         EXIT.

       COPY-SINGLE-TASK.
           MOVE JP-KEY-SEQ-OS  TO COMO-SAVE.
           MOVE JP-KEY-CO      TO JP-KEY-BUF JP-KEY-DISP.
           MOVE JP-SEQ-CO      TO JP-SEQ-BUF JP-SEQ-DISP.
           PERFORM WRITE-LOOP  THRU WRITE-EXIT.
           MOVE COMO-SAVE      TO JP-KEY-SEQ JP-KEY-SEQ-DISP.

       CST-EXIT.               EXIT.

       COPY-TASK-LOOP.
           PERFORM VARYING SUBT FROM 1 BY 1 UNTIL SUBT > 30
               IF TO-TASK(SUBT) NOT = SPACES
                   MOVE SPACES TO MESSAGE-BUFFER
                   PERFORM COPY-TASK-SUBLOOP THRU CTS-EXIT
                   IF MESSAGE-BUFFER NOT = SPACES
                       DISPLAY MESSAGE-BUFFER
                   END-IF
               END-IF
           END-PERFORM.

           MOVE JP-KEY-SEQ-OS  TO JP-KEY-SEQ JP-KEY-SEQ-DISP.

       CTL-EXIT.               EXIT.

       COPY-TASK-SUBLOOP.
           MOVE JP-KEY-OS       TO JPKEY-NAME.
           MOVE FROM-TASK(SUBT) TO JPKEY-TASK
                                   TASKNUMBER OF PM-JOBP-KEYS-TASK-I.
           MOVE JP-TASK-KEY     TO JOBPWOSEQ  OF PM-JOBP-KEYS-TASK-I.
           READ PM-JOBP-KEYS-TASK-I INTO PM-JP-KEY-DATA
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT = "23"
               GO TO CTS-EXIT
           ELSE
           IF FILE-STAT NOT = "00"
               MOVE FILE-STAT  TO CON-WORD
               MOVE "READ KEY" TO DB-TYPE
               MOVE "COPY-TASK-SUBLOOP" TO DB-PARA
               MOVE DB-ERROR   TO MESSAGE-BUFFER
               GO TO CTS-EXIT.

           MOVE JP-KEY-CO      TO PMJPK-JOBP-KEY PMJPK-JOBP-NAME.
           MOVE TO-TASK(SUBT)  TO PMJPK-TASK-NUM PMJPK-JOBP-TASK.

           ACCEPT PMJPK-DATE-STAMP FROM DATE.
           IF PMJPK-DATE-STAMP-YY > "70"
               MOVE "19" TO PMJPK-DATE-STAMP-CC
           ELSE
               MOVE "20" TO PMJPK-DATE-STAMP-CC.
           ACCEPT PMJPK-TIME-STAMP FROM TIME.

           WRITE PM-JOBP-KEYS-TASK-REC FROM PM-JP-KEY-DATA
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
               MOVE FILE-STAT  TO CON-WORD
               MOVE "WRITE   " TO DB-TYPE
               MOVE "COPY-TASK-SUBLOOP" TO DB-PARA
               MOVE DB-ERROR   TO MESSAGE-BUFFER
               GO TO CTS-EXIT.

           MOVE JP-TASK-KEY    TO JOBPWOSEQ OF PM-JOBPLAN-TASK-I.
           START PM-JOBPLAN-TASK-I KEY = JOBPWOSEQ OF PM-JOBPLAN-TASK-I
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
               GO TO CTS-EXIT
           ELSE
           IF FILE-STAT NOT = "00"
               MOVE FILE-STAT  TO CON-WORD
               MOVE "START   " TO DB-TYPE
               MOVE "COPY-TASK-SUBLOOP" TO DB-PARA
               MOVE DB-ERROR   TO MESSAGE-BUFFER
               GO TO CTS-EXIT.

       COPY-TASK-READ-LOOP.
           READ PM-JOBPLAN-TASK-I NEXT INTO PM-JOBPLAN-DATA
               AT END          MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT = "10" OR "14" OR "46"
               GO TO CTS-EXIT
           ELSE
           IF FILE-STAT NOT = "00"
               MOVE FILE-STAT  TO CON-WORD
               MOVE "READ NXT" TO DB-TYPE
               MOVE "COPY-TASK-SUBLOOP" TO DB-PARA
               MOVE DB-ERROR   TO MESSAGE-BUFFER
               GO TO CTS-EXIT.

           IF PMJP-KEY-SEQ NOT = JP-TASK-KEY
               GO TO CTS-EXIT.

           MOVE JP-KEY-CO      TO JOBPLAN-KEY PMJP-KEY.
           MOVE TO-TASK(SUBT)  TO PMJP-SEQ PMJP-SEQN.

           WRITE PM-JOBPLAN-REC FROM PM-JOBPLAN-DATA
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
               MOVE "WRITE   " TO DB-TYPE
               MOVE "COPY-TASK-SUBLOOP" TO DB-PARA
               MOVE FILE-STAT  TO CON-WORD
               MOVE DB-ERROR   TO MESSAGE-BUFFER
               GO TO CTS-EXIT.

           GO TO COPY-TASK-READ-LOOP.

       CTS-EXIT.               EXIT.

       MOVE-TASK-FUNCTION.
           MOVE "VJOBPLAN24"   TO SCREEN-NAME.
      *M********************************************************************
      *M    MESSAGE 031/019:
      *M ENTER DATA AND PRESS 'ENTER' KEY
      *M********************************************************************
           MOVE  31            TO LANG-SETNUM
           MOVE  19            TO LANG-MSGNUM
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
           MOVE CATREAD-MSG-TEXT TO ERRMSG-OPTIONS.

       SHOWFORM-OPTS-M.
           MOVE 9              TO ERROR-SW.
           MOVE OPTIONS-SCREEN TO DISPLAY-REC.
           PERFORM SHOWFORM THRU SHOWFORM-EXIT.
           MOVE DISPLAY-REC TO OPTIONS-SCREEN.
           MOVE 0              TO ERROR-SW.

           IF KEY-HIT = 3 OR 8
               GO TO MTF-EXIT.

           IF KEY-HIT = 7
               MOVE 332        TO HELP-SW
               CALL "SPMHELPM" USING HELP-SW
               MOVE MESSAGE-BUFFER TO ERRMSG-OPTIONS
               GO TO SHOWFORM-OPTS-M.

           IF KEY-HIT NOT = 0
               GO TO SHOWFORM-OPTS-M.

           IF JP-SEQ-MO = "MULT"
               PERFORM MULTI-MOVE-LOOP THRU MULTI-MOVE-EXIT
           ELSE
               PERFORM MOVE-FUNCTION-LOOP THRU MOVE-FUNC-EXIT.

       MTF-EXIT.               EXIT.

       MULTI-MOVE-LOOP.
           MOVE "  "           TO RETURN-COD.
           PERFORM FILL-TASK-TABLE THRU FTT-EXIT.
           IF RETURN-COD NOT = "  "
               MOVE "VJOBPLAN24"   TO SCREEN-NAME
               MOVE MESSAGE-BUFFER TO ERRMSG-OPTIONS
               MOVE  4         TO FIELD-NUMBER
               MOVE TRUE-VAL   TO IND(FIELD-NUMBER) IND(99)
               GO TO SHOWFORM-OPTS-M.

           IF KEY-HIT = 3 OR 8
               MOVE SPACES     TO JP-SEQ-MO
               GO TO OPTS-MENU.

           PERFORM MOVE-TASK-LOOP THRU MTL-EXIT.
           MOVE SPACES         TO JP-KEY-SEQ-MO.

       MULTI-MOVE-EXIT.        EXIT.

       MOVE-FUNCTION-LOOP.
           MOVE JP-SEQ-MO      TO ADJ-4.
           PERFORM ADJUST-4.
           MOVE ADJ-4          TO JP-SEQ-MO.

           IF JP-SEQ-MO NOT NUMERIC
               MOVE SPACES     TO JP-SEQ-MO.

           IF JP-SEQ-MO = "0000"
               MOVE SPACES     TO JP-SEQ-MO.

           IF SPACES = JP-KEY-MO OR JP-SEQ-MO
               GO TO SHOWFORM-OPTS-M.

           IF JP-KEY-MO = JP-KEY-OS
               MOVE JP-KEY-MO  TO JPKEY-NAME
               MOVE JP-SEQ-MO  TO JPKEY-TASK
               PERFORM CHECK-FOR-TASK THRU CFT-EXIT
               IF FILE-STAT = "10" OR "14" OR "46" OR "23"
                   PERFORM READ-SCREEN
                   PERFORM MOVE-SINGLE-TASK THRU MST-EXIT
                   PERFORM DELETE-TASK-SEQUENCE THRU DTS-EXIT
                   MOVE "Y"    TO DEL-CONF
                   GO TO MOVE-FUNC-EXIT
               ELSE
               IF FILE-STAT NOT = "00"
                   MOVE MESSAGE-BUFFER TO ERRMSG-OPTIONS
                   MOVE 5      TO FIELD-NUMBER
                   PERFORM SET-ERROR
                   GO TO SHOWFORM-OPTS-M
               ELSE
      *M********************************************************************
      *M    MESSAGE 046/045:
      *M TASK XXXX OF JOBPLAN XXXXXXXXXX ALREADY EXISTS - CANNOT XXXX THIS TA
      *M********************************************************************
                   MOVE  46    TO LANG-SETNUM
                   MOVE  45    TO LANG-MSGNUM
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE CATREAD-MSG-TEXT TO COPY-MOVE-MSG
                   MOVE JP-SEQ-MO TO MSG-TASK
                   MOVE JP-KEY-MO TO MSG-NAME
      *M********************************************************************
      *M    MESSAGE 039/051:
      *M MOVE              << MAXIMUM 4 CHARACTERS >>
      *M********************************************************************
                   MOVE  39    TO LANG-SETNUM
                   MOVE  51    TO LANG-MSGNUM
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE CATREAD-MSG-TEXT TO COPY-MOVE
                   MOVE COPY-MOVE-MSG TO ERRMSG-OPTIONS
                   MOVE 5      TO FIELD-NUMBER
                   PERFORM SET-ERROR
                   GO TO SHOWFORM-OPTS-M.

           MOVE JP-KEY-SEQ-OS  TO COMO-SAVE.
           MOVE JP-KEY-MO      TO JP-KEY-BUF JP-KEY-DISP.
           PERFORM GET-KEY-RECORD THRU GKR-EXIT.
           IF FILE-STAT = "10" OR "14" OR "46"
               PERFORM WRITE-KEY-RECORD THRU WKR-EXIT
               IF FILE-STAT NOT = "00"
                   MOVE COMO-SAVE TO JP-KEY-SEQ
                                     JP-KEY-SEQ-DISP
                   MOVE MESSAGE-BUFFER TO ERRMSG-OPTIONS
                   MOVE 5      TO FIELD-NUMBER
                   PERFORM SET-ERROR
                   GO TO SHOWFORM-OPTS-M
               ELSE
                   PERFORM READ-SCREEN
                   PERFORM MOVE-SINGLE-TASK THRU MST-EXIT
                   PERFORM DELETE-TASK-SEQUENCE THRU DTS-EXIT
                   MOVE "Y"    TO DEL-CONF
                   GO TO MOVE-FUNC-EXIT
           ELSE
           IF FILE-STAT NOT = "00"
               MOVE COMO-SAVE TO JP-KEY-SEQ
                                 JP-KEY-SEQ-DISP
               MOVE MESSAGE-BUFFER TO ERRMSG-OPTIONS
               MOVE 5          TO FIELD-NUMBER
               PERFORM SET-ERROR
               GO TO SHOWFORM-OPTS-M.

           IF RECORD-KEY NOT = "KEYREC"
      *M********************************************************************
      *M    MESSAGE 036/008:
      *M JOBPLAN DOES NOT EXIST
      *M********************************************************************
               MOVE  36        TO LANG-SETNUM
               MOVE   8        TO LANG-MSGNUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE CATREAD-MSG-TEXT TO ERRMSG-OPTIONS
               MOVE 6          TO FIELD-NUMBER
               PERFORM SET-ERROR
               GO TO SHOWFORM-OPTS-M.

           PERFORM READ-SCREEN.
           PERFORM MOVE-SINGLE-TASK THRU MST-EXIT.
           PERFORM DELETE-TASK-SEQUENCE THRU DTS-EXIT.
           MOVE "Y"            TO DEL-CONF.

       MOVE-FUNC-EXIT.         EXIT.

       MOVE-SINGLE-TASK.
           MOVE JP-KEY-SEQ-OS  TO COMO-SAVE.
           MOVE JP-KEY-MO      TO JP-KEY-BUF JP-KEY-DISP.
           MOVE JP-SEQ-MO      TO JP-SEQ-BUF JP-SEQ-DISP.
           PERFORM WRITE-LOOP  THRU WRITE-EXIT.
           MOVE COMO-SAVE      TO JP-KEY-SEQ JP-KEY-SEQ-DISP.

       MST-EXIT.               EXIT.

       MOVE-TASK-LOOP.
           PERFORM VARYING SUBT FROM 1 BY 1 UNTIL SUBT > 30
               IF TO-TASK(SUBT) NOT = SPACES
                   MOVE SPACES TO MESSAGE-BUFFER
                   PERFORM MOVE-TASK-SUBLOOP THRU MTS-EXIT
                   IF MESSAGE-BUFFER NOT = SPACES
                       DISPLAY MESSAGE-BUFFER
                   END-IF
               END-IF
           END-PERFORM.

           MOVE JP-KEY-SEQ-OS  TO JP-KEY-SEQ JP-KEY-SEQ-DISP.
           MOVE "Y"            TO DEL-CONF.

       MTL-EXIT.               EXIT.

       MOVE-TASK-SUBLOOP.
           MOVE JP-KEY-OS       TO JPKEY-NAME.
           MOVE FROM-TASK(SUBT) TO JPKEY-TASK
                                   TASKNUMBER OF PM-JOBP-KEYS-TASK.
           MOVE JP-TASK-KEY     TO JOBPWOSEQ  OF PM-JOBP-KEYS-TASK.
           READ PM-JOBP-KEYS-TASK INTO PM-JP-KEY-DATA
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT = "23"
               GO TO MTS-EXIT
           ELSE
           IF FILE-STAT NOT = "00"
               MOVE FILE-STAT  TO CON-WORD
               MOVE "READ KEY" TO DB-TYPE
               MOVE "MOVE-TASK-SUBLOOP" TO DB-PARA
               MOVE DB-ERROR   TO MESSAGE-BUFFER
               GO TO MTS-EXIT.

           MOVE JP-KEY-MO      TO PMJPK-JOBP-KEY PMJPK-JOBP-NAME.
           MOVE TO-TASK(SUBT)  TO PMJPK-TASK-NUM PMJPK-JOBP-TASK.

           ACCEPT PMJPK-DATE-STAMP FROM DATE.
           IF PMJPK-DATE-STAMP-YY > "70"
               MOVE "19" TO PMJPK-DATE-STAMP-CC
           ELSE
               MOVE "20" TO PMJPK-DATE-STAMP-CC.
           ACCEPT PMJPK-TIME-STAMP FROM TIME.

           DELETE PM-JOBP-KEYS-TASK
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
               MOVE FILE-STAT  TO CON-WORD
               MOVE "DELETE  " TO DB-TYPE
               MOVE "MOVE-TASK-SUBLOOP" TO DB-PARA
               MOVE DB-ERROR   TO MESSAGE-BUFFER
               GO TO MTS-EXIT.

           WRITE PM-JOBP-KEYS-TASK-REC FROM PM-JP-KEY-DATA
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
               MOVE FILE-STAT  TO CON-WORD
               MOVE "WRITE   " TO DB-TYPE
               MOVE "MOVE-TASK-SUBLOOP" TO DB-PARA
               MOVE DB-ERROR   TO MESSAGE-BUFFER
               GO TO MTS-EXIT.

           MOVE JP-TASK-KEY    TO JOBPWOSEQ OF PM-JOBPLAN-TASK.
           START PM-JOBPLAN-TASK KEY = JOBPWOSEQ OF PM-JOBPLAN-TASK
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
               GO TO MTS-EXIT
           ELSE
           IF FILE-STAT NOT = "00"
               MOVE FILE-STAT  TO CON-WORD
               MOVE "START   " TO DB-TYPE
               MOVE "MOVE-TASK-SUBLOOP" TO DB-PARA
               MOVE DB-ERROR   TO MESSAGE-BUFFER
               GO TO MTS-EXIT.

       MOVE-TASK-READ-LOOP.
           READ PM-JOBPLAN-TASK NEXT INTO PM-JOBPLAN-DATA
               AT END          MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT = "10" OR "14" OR "46"
               GO TO MTS-EXIT
           ELSE
           IF FILE-STAT NOT = "00"
               MOVE FILE-STAT  TO CON-WORD
               MOVE "READ NXT" TO DB-TYPE
               MOVE "MOVE-TASK-SUBLOOP" TO DB-PARA
               MOVE DB-ERROR   TO MESSAGE-BUFFER
               GO TO MTS-EXIT.

           IF PMJP-KEY-SEQ NOT = JP-TASK-KEY
               GO TO MTS-EXIT.

           MOVE JP-KEY-MO      TO JOBPLAN-KEY PMJP-KEY.
           MOVE TO-TASK(SUBT)  TO PMJP-SEQ PMJP-SEQN.

           DELETE PM-JOBPLAN-TASK
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
               MOVE FILE-STAT  TO CON-WORD
               MOVE "DELETE  " TO DB-TYPE
               MOVE "DELETE-RECORDS" TO DB-PARA
               MOVE DB-ERROR   TO MESSAGE-BUFFER
               GO TO MTS-EXIT.

           WRITE PM-JOBPLAN-TASK-REC FROM PM-JOBPLAN-DATA
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
               MOVE "WRITE   " TO DB-TYPE
               MOVE "MOVE-TASK-SUBLOOP" TO DB-PARA
               MOVE FILE-STAT  TO CON-WORD
               MOVE DB-ERROR   TO MESSAGE-BUFFER
               GO TO MTS-EXIT.

           GO TO MOVE-TASK-READ-LOOP.

       MTS-EXIT.               EXIT.

       FILL-TASK-TABLE.
           MOVE JP-KEY-OS      TO PMJOBPKEY OF PM-JOBPLAN-KEYS-I
                                  PMJPT-JPN.
           MOVE "0000"         TO TASKNUMBER OF PM-JOBPLAN-KEYS-I
           START PM-JOBPLAN-KEYS-I
               KEY NOT LESS THAN PMJOBPKEY OF PM-JOBPLAN-KEYS-I
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
               MOVE SPACES     TO MESSAGE-BUFFER
               MOVE "START ERROR, PM-JOBPLAN-KEYS-I        FILE-STAT ="
                               TO MSG-TEXT
               MOVE FILE-STAT  TO MSG-FLD
               MOVE "XX"       TO RETURN-COD
               GO TO FTT-EXIT.

           MOVE 0              TO RECNO.
           MOVE NEG-VAL        TO IND(75).
           MOVE TRUE-VAL       TO IND(77) IND(76).
           MOVE SPACES         TO PMJPT-BUFF-SUB
                                  DISPLAY-REC.
           WRITE DISPLAY-REC   FORMAT "COPM"
                               INDIC ARE SCREEN-INDICATORS.
           IF SCREEN-STATUS NOT = "00"
               DISPLAY
               "SUBFILE CLEAR WRITE ERROR.  SCREEN-STATUS IS "
                               SCREEN-STATUS.
           MOVE NEG-VAL        TO IND(77).

       DBGET-TASK.
           READ PM-JOBPLAN-KEYS-I
               NEXT            INTO PM-JP-KEY-DATA
               AT END          MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT = "10" OR "14" OR "46"
               GO TO SUBF-CONT
           ELSE
           IF FILE-STAT NOT = "00"
               MOVE SPACES     TO MESSAGE-BUFFER
               MOVE "READ ERROR, PM-JOBPLAN-KEYS-I          FILE-STAT ="
                               TO MSG-TEXT
               MOVE FILE-STAT  TO MSG-FLD
               MOVE "XX"       TO RETURN-COD
               GO TO FTT-EXIT.

           IF PMJPK-JOBP-KEY NOT = JP-KEY-OS
               GO TO SUBF-CONT.

           IF PMJPK-TASK-NUM = "0000"
               GO TO DBGET-TASK.

           MOVE SPACES         TO PMJPT-BUFF-SUB.
           MOVE PMJPK-TASK-NUM TO PMJPT-TASK.

           ADD 1               TO RECNO.
           MOVE PMJPT-BUFF-SUB TO DISPLAY-REC.
           MOVE "00" TO SCREEN-STATUS.
           WRITE SUBFILE       DISPLAY-REC FORMAT "COPMDISP"
                               INDIC ARE SCREEN-INDICATORS
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF SCREEN-STATUS NOT = "00"
               DISPLAY   "SUBFILE 1 WRITE ERROR.  SCREEN STATUS IS "
                               SCREEN-STATUS
               GO TO END-OF-JOB.

           GO TO DBGET-TASK.

       SUBF-CONT.
           IF RECNO EQUAL 0
               GO TO FTT-EXIT.

           WRITE DISPLAY-REC   FORMAT "COPMSEL"
                               INDIC ARE SCREEN-INDICATORS.
           MOVE TRUE-VAL       TO IND(76).
           IF RECNO GREATER THAN 0
               MOVE TRUE-VAL   TO IND(75)
           ELSE
               MOVE NEG-VAL    TO IND(75).
           MOVE PMJPT-BUFF     TO DISPLAY-REC.
           WRITE DISPLAY-REC   FORMAT "COPM"
                               INDIC ARE SCREEN-INDICATORS.
           READ DISPLAY-FILE   FORMAT "COPM"
                               INDIC ARE SCREEN-INDICATORS.

           IF KEY-HIT = 3 OR 8
               GO TO FTT-EXIT.

           MOVE 0              TO SUBT.
           PERFORM UNTIL PMJPT-BUFF-SUB = SPACES
               MOVE SPACES     TO PMJPT-BUFF-SUB
               READ SUBFILE    DISPLAY-FILE
                               NEXT MODIFIED INTO PMJPT-BUFF-SUB
                               FORMAT "COPMDISP"
                               INDIC ARE SCREEN-INDICATORS
               END-READ
               ADD  1          TO SUBT
               IF SUBT > 30
                   GO TO FTT-EXIT
               END-IF
               MOVE PMJPT-TASK TO FROM-TASK(SUBT)
           END-PERFORM.

           IF TASK-TABLES = SPACES
               GO TO FTT-EXIT
           ELSE
           IF COPY-MOVE-SW = "COPY"
               MOVE SPACES     TO CM-SCREEN-DATA
               MOVE JP-KEY-OS  TO FJOBP
               MOVE JP-KEY-CO  TO TJOBP
               MOVE "Copy"     TO CM1
               MOVE "COPY"     TO CM2
               PERFORM CM-TASKS THRU CM-TASKS-EXIT
           ELSE
               MOVE SPACES     TO CM-SCREEN-DATA
               MOVE JP-KEY-OS  TO FJOBP
               MOVE JP-KEY-CO  TO TJOBP
               MOVE "Move"     TO CM1
               MOVE "MOVE"     TO CM2
               PERFORM CM-TASKS THRU CM-TASKS-EXIT.

           MOVE "  "           TO RETURN-COD.

       FTT-EXIT.               EXIT.

       CM-TASKS.
           MOVE "VCMTASKS"     TO SCREEN-NAME.
           MOVE ALL B"0"       TO SCREEN-INDICATORS.
           MOVE FROM-TASK(01)  TO FCM-TASK(01).
           MOVE FROM-TASK(02)  TO FCM-TASK(04).
           IF FROM-TASK(02) NOT = SPACES       MOVE TRUE-VAL TO IND(32).
           MOVE FROM-TASK(03)  TO FCM-TASK(07).
           IF FROM-TASK(03) NOT = SPACES       MOVE TRUE-VAL TO IND(33).
           MOVE FROM-TASK(04)  TO FCM-TASK(10).
           IF FROM-TASK(04) NOT = SPACES       MOVE TRUE-VAL TO IND(34).
           MOVE FROM-TASK(05)  TO FCM-TASK(13).
           IF FROM-TASK(05) NOT = SPACES       MOVE TRUE-VAL TO IND(35).
           MOVE FROM-TASK(06)  TO FCM-TASK(16).
           IF FROM-TASK(06) NOT = SPACES       MOVE TRUE-VAL TO IND(36).
           MOVE FROM-TASK(07)  TO FCM-TASK(19).
           IF FROM-TASK(07) NOT = SPACES       MOVE TRUE-VAL TO IND(37).
           MOVE FROM-TASK(08)  TO FCM-TASK(22).
           IF FROM-TASK(08) NOT = SPACES       MOVE TRUE-VAL TO IND(38).
           MOVE FROM-TASK(09)  TO FCM-TASK(25).
           IF FROM-TASK(09) NOT = SPACES       MOVE TRUE-VAL TO IND(39).
           MOVE FROM-TASK(10)  TO FCM-TASK(28).
           IF FROM-TASK(10) NOT = SPACES       MOVE TRUE-VAL TO IND(40).
           MOVE FROM-TASK(11)  TO FCM-TASK(02).
           IF FROM-TASK(11) NOT = SPACES       MOVE TRUE-VAL TO IND(41).
           MOVE FROM-TASK(12)  TO FCM-TASK(05).
           IF FROM-TASK(12) NOT = SPACES       MOVE TRUE-VAL TO IND(42).
           MOVE FROM-TASK(13)  TO FCM-TASK(08).
           IF FROM-TASK(13) NOT = SPACES       MOVE TRUE-VAL TO IND(43).
           MOVE FROM-TASK(14)  TO FCM-TASK(11).
           IF FROM-TASK(14) NOT = SPACES       MOVE TRUE-VAL TO IND(44).
           MOVE FROM-TASK(15)  TO FCM-TASK(14).
           IF FROM-TASK(15) NOT = SPACES       MOVE TRUE-VAL TO IND(45).
           MOVE FROM-TASK(16)  TO FCM-TASK(17).
           IF FROM-TASK(16) NOT = SPACES       MOVE TRUE-VAL TO IND(46).
           MOVE FROM-TASK(17)  TO FCM-TASK(20).
           IF FROM-TASK(17) NOT = SPACES       MOVE TRUE-VAL TO IND(47).
           MOVE FROM-TASK(18)  TO FCM-TASK(23).
           IF FROM-TASK(18) NOT = SPACES       MOVE TRUE-VAL TO IND(48).
           MOVE FROM-TASK(19)  TO FCM-TASK(26).
           IF FROM-TASK(19) NOT = SPACES       MOVE TRUE-VAL TO IND(49).
           MOVE FROM-TASK(20)  TO FCM-TASK(29).
           IF FROM-TASK(20) NOT = SPACES       MOVE TRUE-VAL TO IND(50).
           MOVE FROM-TASK(21)  TO FCM-TASK(03).
           IF FROM-TASK(21) NOT = SPACES       MOVE TRUE-VAL TO IND(51).
           MOVE FROM-TASK(22)  TO FCM-TASK(06).
           IF FROM-TASK(22) NOT = SPACES       MOVE TRUE-VAL TO IND(52).
           MOVE FROM-TASK(23)  TO FCM-TASK(09).
           IF FROM-TASK(23) NOT = SPACES       MOVE TRUE-VAL TO IND(53).
           MOVE FROM-TASK(24)  TO FCM-TASK(12).
           IF FROM-TASK(24) NOT = SPACES       MOVE TRUE-VAL TO IND(54).
           MOVE FROM-TASK(25)  TO FCM-TASK(15).
           IF FROM-TASK(25) NOT = SPACES       MOVE TRUE-VAL TO IND(55).
           MOVE FROM-TASK(26)  TO FCM-TASK(18).
           IF FROM-TASK(26) NOT = SPACES       MOVE TRUE-VAL TO IND(56).
           MOVE FROM-TASK(27)  TO FCM-TASK(21).
           IF FROM-TASK(27) NOT = SPACES       MOVE TRUE-VAL TO IND(57).
           MOVE FROM-TASK(28)  TO FCM-TASK(24).
           IF FROM-TASK(28) NOT = SPACES       MOVE TRUE-VAL TO IND(58).
           MOVE FROM-TASK(29)  TO FCM-TASK(27).
           IF FROM-TASK(29) NOT = SPACES       MOVE TRUE-VAL TO IND(59).
           MOVE FROM-TASK(30)  TO FCM-TASK(30).
           IF FROM-TASK(30) NOT = SPACES       MOVE TRUE-VAL TO IND(60).

           PERFORM VARYING SUBT FROM 1 BY 1 UNTIL SUBT > 30
               IF FCM-TASK(SUBT) NOT = SPACES
                   MOVE "to" TO TO-FLD(SUBT)
               END-IF
           END-PERFORM.

       CM-SHOWFORM.
           MOVE "00"           TO SCREEN-STATUS.
           MOVE CM-SCREEN-DATA TO DISPLAY-REC.

           WRITE DISPLAY-REC   FORMAT IS SCREEN-NAME
                               INDIC ARE SCREEN-INDICATORS.
           IF SCREEN-STATUS NOT = "00"
               DISPLAY "SCREEN WRITE ERROR.  SCREEN-STATUS IS "
                               SCREEN-STATUS
               GO TO END-OF-JOB.

           READ  DISPLAY-FILE  FORMAT IS SCREEN-NAME
                               INDIC ARE SCREEN-INDICATORS.
           IF SCREEN-STATUS NOT = "00"
               DISPLAY "SCREEN READ ERROR.  SCREEN-STATUS IS "
                               SCREEN-STATUS
               GO TO END-OF-JOB.

           MOVE DISPLAY-REC    TO CM-SCREEN-DATA.
           MOVE NEG-VAL        TO IND(01) IND(11) IND(21)
                                  IND(02) IND(12) IND(22)
                                  IND(03) IND(13) IND(23)
                                  IND(04) IND(14) IND(24)
                                  IND(05) IND(15) IND(25)
                                  IND(06) IND(16) IND(26)
                                  IND(07) IND(17) IND(27)
                                  IND(08) IND(18) IND(28)
                                  IND(09) IND(19) IND(29)
                                  IND(10) IND(20) IND(30) IND(99).

           IF KEY-HIT = 3 OR 8
               GO TO CM-TASKS-EXIT.

           MOVE TCM-TASK(01)   TO TO-TASK(01).
           MOVE TCM-TASK(04)   TO TO-TASK(02).
           MOVE TCM-TASK(07)   TO TO-TASK(03).
           MOVE TCM-TASK(10)   TO TO-TASK(04).
           MOVE TCM-TASK(13)   TO TO-TASK(05).
           MOVE TCM-TASK(16)   TO TO-TASK(06).
           MOVE TCM-TASK(19)   TO TO-TASK(07).
           MOVE TCM-TASK(22)   TO TO-TASK(08).
           MOVE TCM-TASK(25)   TO TO-TASK(09).
           MOVE TCM-TASK(28)   TO TO-TASK(10).
           MOVE TCM-TASK(02)   TO TO-TASK(11).
           MOVE TCM-TASK(05)   TO TO-TASK(12).
           MOVE TCM-TASK(08)   TO TO-TASK(13).
           MOVE TCM-TASK(11)   TO TO-TASK(14).
           MOVE TCM-TASK(14)   TO TO-TASK(15).
           MOVE TCM-TASK(17)   TO TO-TASK(16).
           MOVE TCM-TASK(20)   TO TO-TASK(17).
           MOVE TCM-TASK(23)   TO TO-TASK(18).
           MOVE TCM-TASK(26)   TO TO-TASK(19).
           MOVE TCM-TASK(29)   TO TO-TASK(20).
           MOVE TCM-TASK(03)   TO TO-TASK(21).
           MOVE TCM-TASK(06)   TO TO-TASK(22).
           MOVE TCM-TASK(09)   TO TO-TASK(23).
           MOVE TCM-TASK(12)   TO TO-TASK(24).
           MOVE TCM-TASK(15)   TO TO-TASK(25).
           MOVE TCM-TASK(18)   TO TO-TASK(26).
           MOVE TCM-TASK(21)   TO TO-TASK(27).
           MOVE TCM-TASK(24)   TO TO-TASK(28).
           MOVE TCM-TASK(27)   TO TO-TASK(29).
           MOVE TCM-TASK(30)   TO TO-TASK(30).

           IF TO-TASK-TABLE = SPACES
               GO TO CM-SHOWFORM.

           IF TO-TASK(1) = SPACES
      *M********************************************************************
      *M TASK NUMBER IS REQUIRED
      *M********************************************************************
               MOVE "TASK NUMBER IS REQUIRED"
                               TO ERRMSG-CM
               MOVE TRUE-VAL   TO IND(1) IND(99)
               GO TO CM-SHOWFORM.

           MOVE TO-TASK(1)     TO ADJ-4.
           PERFORM ADJUST-4.
           MOVE ADJ-4          TO TO-TASK(1) TCM-TASK(1).

           IF TO-TASK(1) NOT NUMERIC
      *M********************************************************************
      *M    MESSAGE 046/042:
      *M  TASK NUMBER MUST BE NUMERIC
      *M********************************************************************
               MOVE 46         TO LANG-SETNUM
               MOVE 42         TO LANG-MSGNUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE CATREAD-MSG-TEXT
                               TO ERRMSG-CM
               MOVE TRUE-VAL   TO IND(1) IND(99)
               GO TO CM-SHOWFORM.

           IF TO-TASK(1) = "0000"
      *M********************************************************************
      *M    MESSAGE 046/047:
      *M TASK NUMBER MAY NOT BE ZERO
      *M********************************************************************
               MOVE 46         TO LANG-SETNUM
               MOVE 47         TO LANG-MSGNUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE CATREAD-MSG-TEXT
                               TO ERRMSG-CM
               MOVE TRUE-VAL   TO IND(1) IND(99)
               GO TO CM-SHOWFORM.

           IF KEY-HIT = 6
               MOVE TO-TASK(01) TO TASK-INC
               PERFORM VARYING SUBT FROM 2 BY 1 UNTIL SUBT > 30
                   IF TASK-INC-9 + SEQ-INC > 9999
                       MOVE 31 TO SUBT
                   ELSE
                       ADD SEQ-INC TO TASK-INC-9
                   END-IF
                   IF FROM-TASK(SUBT) NOT = SPACES AND
                      SUBT < 31
                       MOVE TASK-INC TO TO-TASK(SUBT)
                   END-IF
               END-PERFORM
               MOVE TO-TASK(01)  TO TCM-TASK(01)
               MOVE TO-TASK(02)  TO TCM-TASK(04)
               MOVE TO-TASK(03)  TO TCM-TASK(07)
               MOVE TO-TASK(04)  TO TCM-TASK(10)
               MOVE TO-TASK(05)  TO TCM-TASK(13)
               MOVE TO-TASK(06)  TO TCM-TASK(16)
               MOVE TO-TASK(07)  TO TCM-TASK(19)
               MOVE TO-TASK(08)  TO TCM-TASK(22)
               MOVE TO-TASK(09)  TO TCM-TASK(25)
               MOVE TO-TASK(10)  TO TCM-TASK(28)
               MOVE TO-TASK(11)  TO TCM-TASK(02)
               MOVE TO-TASK(12)  TO TCM-TASK(05)
               MOVE TO-TASK(13)  TO TCM-TASK(08)
               MOVE TO-TASK(14)  TO TCM-TASK(11)
               MOVE TO-TASK(15)  TO TCM-TASK(14)
               MOVE TO-TASK(16)  TO TCM-TASK(17)
               MOVE TO-TASK(17)  TO TCM-TASK(20)
               MOVE TO-TASK(18)  TO TCM-TASK(23)
               MOVE TO-TASK(19)  TO TCM-TASK(26)
               MOVE TO-TASK(20)  TO TCM-TASK(29)
               MOVE TO-TASK(21)  TO TCM-TASK(03)
               MOVE TO-TASK(22)  TO TCM-TASK(06)
               MOVE TO-TASK(23)  TO TCM-TASK(09)
               MOVE TO-TASK(24)  TO TCM-TASK(12)
               MOVE TO-TASK(25)  TO TCM-TASK(15)
               MOVE TO-TASK(26)  TO TCM-TASK(18)
               MOVE TO-TASK(27)  TO TCM-TASK(21)
               MOVE TO-TASK(28)  TO TCM-TASK(24)
               MOVE TO-TASK(29)  TO TCM-TASK(27)
               MOVE TO-TASK(30)  TO TCM-TASK(30)
               GO TO CM-SHOWFORM.

           MOVE JP-KEY-OS      TO FROM-KEY.
           IF COPY-MOVE-SW = "COPY"
               MOVE JP-KEY-CO  TO TO-KEY
           ELSE
               MOVE JP-KEY-MO  TO TO-KEY.

           PERFORM VARYING SUBT FROM 1 BY 1 UNTIL SUBT > 30
               IF FROM-TASK(SUBT) NOT = SPACES
                   MOVE "  "   TO RETURN-COD
                   PERFORM COPY-EDIT-LOOP THRU COPY-EDIT-EXIT
                   IF RETURN-COD NOT = SPACES
                       MOVE MESSAGE-BUFFER TO ERRMSG-CM
                       MOVE TRUE-VAL     TO IND(SUBT) IND(99)
                       MOVE TO-TASK(01)  TO TCM-TASK(01)
                       MOVE TO-TASK(02)  TO TCM-TASK(04)
                       MOVE TO-TASK(03)  TO TCM-TASK(07)
                       MOVE TO-TASK(04)  TO TCM-TASK(10)
                       MOVE TO-TASK(05)  TO TCM-TASK(13)
                       MOVE TO-TASK(06)  TO TCM-TASK(16)
                       MOVE TO-TASK(07)  TO TCM-TASK(19)
                       MOVE TO-TASK(08)  TO TCM-TASK(22)
                       MOVE TO-TASK(09)  TO TCM-TASK(25)
                       MOVE TO-TASK(10)  TO TCM-TASK(28)
                       MOVE TO-TASK(11)  TO TCM-TASK(02)
                       MOVE TO-TASK(12)  TO TCM-TASK(05)
                       MOVE TO-TASK(13)  TO TCM-TASK(08)
                       MOVE TO-TASK(14)  TO TCM-TASK(11)
                       MOVE TO-TASK(15)  TO TCM-TASK(14)
                       MOVE TO-TASK(16)  TO TCM-TASK(17)
                       MOVE TO-TASK(17)  TO TCM-TASK(20)
                       MOVE TO-TASK(18)  TO TCM-TASK(23)
                       MOVE TO-TASK(19)  TO TCM-TASK(26)
                       MOVE TO-TASK(20)  TO TCM-TASK(29)
                       MOVE TO-TASK(21)  TO TCM-TASK(03)
                       MOVE TO-TASK(22)  TO TCM-TASK(06)
                       MOVE TO-TASK(23)  TO TCM-TASK(09)
                       MOVE TO-TASK(24)  TO TCM-TASK(12)
                       MOVE TO-TASK(25)  TO TCM-TASK(15)
                       MOVE TO-TASK(26)  TO TCM-TASK(18)
                       MOVE TO-TASK(27)  TO TCM-TASK(21)
                       MOVE TO-TASK(28)  TO TCM-TASK(24)
                       MOVE TO-TASK(29)  TO TCM-TASK(27)
                       MOVE TO-TASK(30)  TO TCM-TASK(30)
                       GO TO CM-SHOWFORM
                   END-IF
               END-IF
           END-PERFORM.

       CM-TASKS-EXIT.          EXIT.

       COPY-EDIT-LOOP.
           MOVE FROM-TASK(SUBT) TO FROM-SEQ.
           MOVE TO-TASK(SUBT)  TO TO-SEQ.
           MOVE TO-KEY         TO JP-KEY-BUF JPKEY-NAME.
           MOVE TO-SEQ         TO JPKEY-TASK.

           IF TO-SEQ = SPACES
      *M********************************************************************
      *M TASK NUMBER IS REQUIRED
      *M********************************************************************
               MOVE "TASK NUMBER IS REQUIRED"
                               TO MESSAGE-BUFFER
               MOVE  "XX"      TO RETURN-COD
               GO TO COPY-EDIT-EXIT.

           MOVE TO-SEQ         TO ADJ-4.
           PERFORM ADJUST-4.
           MOVE ADJ-4          TO TO-SEQ TO-TASK(SUBT).

           IF TO-SEQ NOT NUMERIC
      *M********************************************************************
      *M    MESSAGE 046/042:
      *M  TASK NUMBER MUST BE NUMERIC
      *M********************************************************************
               MOVE 46         TO LANG-SETNUM
               MOVE 42         TO LANG-MSGNUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE CATREAD-MSG-TEXT TO MESSAGE-BUFFER
               MOVE  "XX"      TO RETURN-COD
               GO TO COPY-EDIT-EXIT.

           IF TO-SEQ = "0000"
      *M********************************************************************
      *M    MESSAGE 046/047:
      *M TASK NUMBER MAY NOT BE ZERO
      *M********************************************************************
               MOVE 46         TO LANG-SETNUM
               MOVE 47         TO LANG-MSGNUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE CATREAD-MSG-TEXT TO MESSAGE-BUFFER
               MOVE  "XX"      TO RETURN-COD
               GO TO COPY-EDIT-EXIT.

           MOVE TO-SEQ         TO TO-TASK(SUBT).

           IF TO-KEY = FROM-KEY
               MOVE TO-KEY     TO JPKEY-NAME
               MOVE TO-SEQ     TO JPKEY-TASK
               PERFORM CHECK-FOR-TASK THRU CFT-EXIT
               IF FILE-STAT = "10" OR "14" OR "46" OR "23"
                   GO TO COPY-EDIT-EXIT
               ELSE
               IF FILE-STAT NOT = "00"
                   MOVE SPACES     TO MESSAGE-BUFFER
                   MOVE "READ ERROR, PM-JOBPLAN-KEYS-I      FILE-STAT ="
                               TO MSG-TEXT
                   MOVE FILE-STAT  TO MSG-FLD
                   MOVE "XX"       TO RETURN-COD
                   GO TO COPY-EDIT-EXIT
               ELSE
      *M********************************************************************
      *M    MESSAGE 046/045:
      *M TASK XXXX OF JOBPLAN XXXXXXXXXX ALREADY EXISTS - CANNOT XXXX THIS TA
      *M********************************************************************
                   MOVE  46    TO LANG-SETNUM
                   MOVE  45    TO LANG-MSGNUM
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE CATREAD-MSG-TEXT TO COPY-MOVE-MSG
                   MOVE TO-SEQ TO MSG-TASK
                   MOVE TO-KEY TO MSG-NAME
                   IF COPY-MOVE-SW = "COPY"
      *M********************************************************************
      *M    MESSAGE 029/127:
      *M COPY                << MAXIMUM 4 CHARACTERS >>                 C127
      *M********************************************************************
                       MOVE  29 TO LANG-SETNUM
                       MOVE 127 TO LANG-MSGNUM
                   ELSE
      *M********************************************************************
      *M    MESSAGE 039/051:
      *M MOVE              << MAXIMUM 4 CHARACTERS >>
      *M********************************************************************
                       MOVE 39 TO LANG-SETNUM
                       MOVE 51 TO LANG-MSGNUM
                   END-IF
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE CATREAD-MSG-TEXT TO COPY-MOVE
                   MOVE COPY-MOVE-MSG TO MESSAGE-BUFFER
                   MOVE  "XX"      TO RETURN-COD
                   GO TO COPY-EDIT-EXIT
           ELSE
               MOVE TO-KEY     TO JPKEY-NAME
               MOVE "0000"     TO JPKEY-TASK
               PERFORM CHECK-FOR-TASK THRU CFT-EXIT
               IF FILE-STAT = "10" OR "14" OR "46" OR "23"
      *M********************************************************************
      *M    MESSAGE 036/008:
      *M JOBPLAN DOES NOT EXIST
      *M********************************************************************
                   MOVE  36    TO LANG-SETNUM
                   MOVE   8    TO LANG-MSGNUM
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE CATREAD-MSG-TEXT TO MESSAGE-BUFFER
                   MOVE  "XX"      TO RETURN-COD
                   GO TO COPY-EDIT-EXIT
               ELSE
               IF FILE-STAT NOT = "00"
                   MOVE SPACES     TO MESSAGE-BUFFER
                   MOVE "READ ERROR, PM-JOBPLAN-KEYS-I      FILE-STAT ="
                               TO MSG-TEXT
                   MOVE FILE-STAT  TO MSG-FLD
                   MOVE  "XX"      TO RETURN-COD
                   GO TO COPY-EDIT-EXIT
               ELSE
               IF RECORD-KEY NOT = "KEYREC"
      *M********************************************************************
      *M    MESSAGE 036/008:
      *M JOBPLAN DOES NOT EXIST
      *M********************************************************************
                   MOVE  36    TO LANG-SETNUM
                   MOVE   8    TO LANG-MSGNUM
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE CATREAD-MSG-TEXT TO MESSAGE-BUFFER
                   MOVE  "XX"      TO RETURN-COD
                   GO TO COPY-EDIT-EXIT
               ELSE
               MOVE TO-KEY     TO JPKEY-NAME
               MOVE TO-SEQ     TO JPKEY-TASK
               PERFORM CHECK-FOR-TASK THRU CFT-EXIT
               IF FILE-STAT = "10" OR "14" OR "46" OR "23"
                   GO TO COPY-EDIT-EXIT
               ELSE
               IF FILE-STAT NOT = "00"
                   MOVE SPACES     TO MESSAGE-BUFFER
                   MOVE "READ ERROR, PM-JOBPLAN-KEYS-I      FILE-STAT ="
                               TO MSG-TEXT
                   MOVE FILE-STAT  TO MSG-FLD
                   MOVE "XX"       TO RETURN-COD
                   GO TO COPY-EDIT-EXIT
               ELSE
      *M********************************************************************
      *M    MESSAGE 046/045:
      *M TASK XXXX OF JOBPLAN XXXXXXXXXX ALREADY EXISTS - CANNOT XXXX THIS TA
      *M********************************************************************
                   MOVE  46    TO LANG-SETNUM
                   MOVE  45    TO LANG-MSGNUM
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE CATREAD-MSG-TEXT TO COPY-MOVE-MSG
                   MOVE TO-SEQ TO MSG-TASK
                   MOVE TO-KEY TO MSG-NAME
                   IF COPY-MOVE-SW = "COPY"
      *M********************************************************************
      *M    MESSAGE 029/127:
      *M COPY                << MAXIMUM 4 CHARACTERS >>                 C127
      *M********************************************************************
                       MOVE  29 TO LANG-SETNUM
                       MOVE 127 TO LANG-MSGNUM
                   ELSE
      *M********************************************************************
      *M    MESSAGE 039/051:
      *M MOVE              << MAXIMUM 4 CHARACTERS >>
      *M********************************************************************
                       MOVE 39 TO LANG-SETNUM
                       MOVE 51 TO LANG-MSGNUM
                   END-IF
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE CATREAD-MSG-TEXT TO COPY-MOVE
                   MOVE COPY-MOVE-MSG TO MESSAGE-BUFFER
                   MOVE  "XX"      TO RETURN-COD
                   GO TO COPY-EDIT-EXIT.

       COPY-EDIT-EXIT.         EXIT.

       DELETE-TASK-FUNCTION.
           MOVE "VPMJPDEL_TASK" TO SCREEN-NAME.
           MOVE JP-KEY-BUF     TO JP-KEY-DEL.
           MOVE JP-SEQ-BUF     TO JP-SEQ-DEL.
           MOVE "N"            TO DEL-CONF.

       SHOWFORM-DELTASK.
           MOVE 9              TO ERROR-SW.
           MOVE DELETE-SCREEN  TO DISPLAY-REC.
           PERFORM SHOWFORM    THRU SHOWFORM-EXIT.
           MOVE DISPLAY-REC    TO DELETE-SCREEN.
           MOVE 0              TO ERROR-SW.

           IF KEY-HIT = 3 OR 8
               MOVE "N"        TO DEL-CONF
               GO TO DTF-EXIT.

           IF KEY-HIT = 7
               MOVE 336        TO HELP-SW
               CALL "SPMHELPM" USING HELP-SW
               MOVE MESSAGE-BUFFER TO ERRMSG-DELETE
               GO TO SHOWFORM-DELTASK.

           IF KEY-HIT NOT = 0
               GO TO SHOWFORM-DELTASK.

           IF DEL-CONF NOT = "Y"
               GO TO DTF-EXIT.

           PERFORM DELETE-TASK-SEQUENCE THRU DTS-EXIT.

       DTF-EXIT.               EXIT.

       DELETE-BLANK-TASK.
           MOVE JP-KEY-SEQ     TO SAVE-KEY-SEQ.
           MOVE DEL-KEY-SEQ    TO JP-KEY-SEQ.
           PERFORM DELETE-TASK-SEQUENCE THRU DTS-EXIT.
           MOVE SAVE-KEY-SEQ   TO JP-KEY-SEQ.

       DBT-EXIT.               EXIT.

       DELETE-TASK-SEQUENCE.
           MOVE JP-KEY-SEQ     TO JOBPWOSEQ OF PM-JOBPLAN-TASK.
           START PM-JOBPLAN-TASK KEY = JOBPWOSEQ OF PM-JOBPLAN-TASK
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
               GO TO DELETE-TASK-HEADER.

           PERFORM DELETE-RECORDS
                               UNTIL FILE-STAT NOT = "00".

       DELETE-TASK-HEADER.
           MOVE JP-KEY-SEQ     TO JOBPWOSEQ  OF PM-JOBP-KEYS-TASK.
           MOVE JP-SEQ-BUF     TO TASKNUMBER OF PM-JOBP-KEYS-TASK.
           READ PM-JOBP-KEYS-TASK INTO PM-JP-KEY-DATA
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT = "23"
               GO TO DTS-EXIT
           ELSE
           IF FILE-STAT NOT = "00"
               MOVE FILE-STAT  TO CON-WORD
               MOVE "READ KEY" TO DB-TYPE
               MOVE "DELETE-TASK-HEADER" TO DB-PARA
               MOVE DB-ERROR   TO MESSAGE-BUFFER
               GO TO DTS-EXIT.

           IF PMJPK-JOBP-SEQ-KEY NOT = JP-KEY-SEQ
               MOVE "10"       TO FILE-STAT
               GO TO DTS-EXIT.

           IF RECORD-KEY NOT = "TASKHD"
               GO TO DTS-EXIT.

           DELETE PM-JOBP-KEYS-TASK
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
               MOVE FILE-STAT  TO CON-WORD
               MOVE "DELETE  " TO DB-TYPE
               MOVE "DELETE-TASK-HEADER" TO DB-PARA
               MOVE DB-ERROR   TO MESSAGE-BUFFER
               MOVE PMJPK-JOBP-KEY TO BU-DISPLAY-FLD (2)
               MOVE RECORD-KEY TO BU-DISPLAY-FLD (3)
               MOVE "DEL ERR, DELETE-TASK-HEADER" TO BU-MSG-AREA
               PERFORM 999-BLOWUP.

       DTS-EXIT.               EXIT.

       DELETE-RECORDS.
           READ PM-JOBPLAN-TASK NEXT INTO PM-JOBPLAN-DATA
               AT END          MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT = "10" OR "14" OR "46"
               NEXT SENTENCE
           ELSE
           IF FILE-STAT NOT = "00"
               MOVE FILE-STAT  TO CON-WORD
               MOVE "READ NXT" TO DB-TYPE
               MOVE "DELETE-RECORDS" TO DB-PARA
               MOVE DB-ERROR   TO MESSAGE-BUFFER
               MOVE 15         TO COND-WORD
               MOVE "XX"       TO RETURN-COD
           ELSE
           IF PMJP-KEY-SEQ NOT = JP-KEY-SEQ
               MOVE HIGH-VALUES TO JOBPWOSEQ OF PM-JOBPLAN-TASK
               START PM-JOBPLAN-TASK KEY > JOBPWOSEQ OF PM-JOBPLAN-TASK
                   INVALID KEY MOVE FILE-STAT TO FILE-STAT
               END-START
               MOVE "10"       TO FILE-STAT
           ELSE
           DELETE PM-JOBPLAN-TASK
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT
           END-DELETE
           IF FILE-STAT NOT = "00"
               MOVE "DELETE  " TO DB-TYPE
               MOVE "DELETE-RECORDS" TO DB-PARA
               MOVE COND-WORD  TO CON-WORD
               MOVE DB-ERROR   TO MESSAGE-BUFFER
               MOVE 15         TO COND-WORD
               MOVE "XX"       TO RETURN-COD.

       999-BLOWUP.
           MOVE "SPMMASTJ"     TO BU-PGM-NAME.
           MOVE SCREEN-NAME    TO BU-DISPLAY-FLD (1).
           CALL "TBLOWUP"      USING BASE-ST
                               BU-PGM-NAME
                               STATUS-AREA
                               VIEW-COMAREA
                               FILE-STAT
                               BU-DISPLAY-MSG
                               BU-DISPLAY-FLDS.

      ******************  END OF FILE SPMMASTJ  ************************
