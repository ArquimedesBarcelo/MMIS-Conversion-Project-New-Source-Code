       62-DAPP-CONT.
           MOVE DATE-WA-CN         TO  PODTE OF DPORECD-REC-O.
           START DPORECD-O KEY = PODTE OF DPORECD-REC-O
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
                   IF DE-DATE-SEL = "999999"
                       PERFORM 620-BUMP-UNTIL-CURRENT
                       IF CURRENT-SW = 1
      *M                   "NO RECORDS FOR DATE SELECTED"
                           MOVE "FPOPRSEL" TO  VIEW-NFNAME
                           MOVE  14 TO LANG-SETNUM
                           MOVE 127 TO LANG-MSGNUM
                           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
053600*******              MOVE B"1"       TO  IND (99)
                           MOVE 1          TO  FIELD-NUMBER
                           PERFORM 4-PGM-ERROR  THRU  4-PGM-ERROR-X
053700*******              MOVE MESSAGE-BUFFER  TO  DE-MESSAGE-LINE
053800                     GO TO 62-DAPP-X
                       ELSE
                       MOVE SPACES TO PODTE OF DPORECD-REC-O
                       START DPORECD-O KEY >= PODTE OF DPORECD-REC-O
                       GO TO 62-DAPP-CONT
                   ELSE
      *M       "NO RECORDS FOR DATE SELECTED"
                   MOVE "FPOPRSEL" TO  VIEW-NFNAME
                   MOVE  14 TO LANG-SETNUM
                   MOVE 127 TO LANG-MSGNUM
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
053600*******      MOVE B"1"       TO  IND (99)
                   MOVE 1          TO  FIELD-NUMBER
                   PERFORM 4-PGM-ERROR  THRU  4-PGM-ERROR-X
053700*******      MOVE MESSAGE-BUFFER  TO  DE-MESSAGE-LINE
053800             GO TO 62-DAPP-X
               ELSE
               MOVE "START ERROR ON DPORECD * 62-DAPP"
                   TO BU-DISPLAY-MSG
               GO TO 2-BLOWUP.

       62-READ-DPORECD.
           READ DPORECD-O NEXT INTO BUF-DPORECD
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00" GO TO 62-DAPP-X.
           IF PO-DATE-CN NOT = DATE-WA-CN
               IF DE-DATE-SEL = "999999"
                   PERFORM 620-BUMP-UNTIL-CURRENT
                   IF CURRENT-SW = 1
                       GO TO 62-DAPP-X
                   ELSE
                   MOVE SPACES TO PODTE OF DPORECD-REC-O
                   START DPORECD-O KEY >= PODTE OF DPORECD-REC-O
                   GO TO 62-DAPP-CONT
               ELSE
               GO TO 62-DAPP-X.
           IF PO-PRFAX-DATE NOT = "      " GO TO 62-READ-DPORECD.
           IF DE-BUYER-CODE = "****"
               NEXT SENTENCE
           ELSE
           IF PO-BUYER-CODE = DE-BUYER-CODE
               NEXT SENTENCE
           ELSE
           GO TO 62-READ-DPORECD.

      *--------- CHECK VENDOR CODE.
           IF DE-VENDOR-CODE1-7 = SPACES
               NEXT SENTENCE
           ELSE
           IF PO-VEN-CODE = DE-VENDOR-CODE
               NEXT SENTENCE
           ELSE
           GO TO 62-READ-DPORECD.

           IF BUYER-DOLLAR-LIM = "        "
               NEXT SENTENCE
           ELSE
           IF DE-BUYER-CODE = "****"
               NEXT SENTENCE
           ELSE
           IF PO-BUDGET-AMT > BUYER-DOLLAR-LIM-9
               GO TO 62-READ-DPORECD.

           MOVE PO-RCV-NO          TO  PO-ARG.

           MOVE PO-ARG TO PORCVNO OF DPOITEM-REC-I.
           START DPOITEM-I KEY = PORCVNO OF DPOITEM-REC-I
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
081600             GO TO 62-READ-DPORECD
               ELSE
081100         MOVE "FIND DPOITEM * 62-GPI" TO BU-DISPLAY-MSG
081200         GO TO 2-BLOWUP.

