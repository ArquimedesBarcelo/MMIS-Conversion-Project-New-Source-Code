021700 PROCEDURE DIVISION.
022100 BEGIN-HERE.
           OPEN INPUT DPOITEM-I, DVENDOR-I,
               MBUYER-I, MPLTINFO-I.
           OPEN I-O DISPLAY-FILE.
           OPEN I-O DPORECD-O.
034700
034600     CALL "TESCSEQ" USING ESC-NAME.

026900**************************************************
027000*                                                *
027100*   GET CO. AND PRIME FROM MPLTINFO              *
027200*   USING 'P 01' AS THE ARGUMENT                 *
027300*                                                *
027400**************************************************
027500
027600     MOVE "P 01"  TO  PLT-ARG.
           MOVE PLT-ARG TO PLTINFOKEY OF MPLTINFO-REC-I.
           READ MPLTINFO-I INTO BUF-MPLTINFO
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
028000         MOVE "DBGET MPLTINFO 1-HSK P 01"  TO  BU-DISPLAY-MSG
028100         MOVE PLT-ARG                 TO  BU-DISPLAY-FLD (1)
028200         GO TO 2-BLOWUP.
028300     MOVE MPLTINFO-COMPANY            TO  COMPANY-SAVE.
028400
094800     MOVE 9                           TO  SAVE-SPOOL-PNUM.
094900     MOVE "POPT"                      TO  PLT-ARG.
           MOVE 0 TO COND-WORD.
           MOVE PLT-ARG TO PLTINFOKEY OF MPLTINFO-REC-I.
           READ MPLTINFO-I INTO BUF-MPLTINFO INVALID KEY
                MOVE 17 TO COND-WORD.
           IF FILE-STATUS-1 = "2"
               MOVE 17                      TO  COND-WORD
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE 99                      TO  COND-WORD.
095200     IF COND-WORD NOT = ZERO
095300         MOVE "GET MPLTINFO 'POPT' "  TO  BU-DISPLAY-MSG
095400         MOVE PLT-ARG                 TO  BU-DISPLAY-FLD (1)
095500         GO TO 2-BLOWUP
095600     ELSE
095700     MOVE MPLTINFO-PO-PRT-NO          TO  SAVE-SPOOL-PNUM
           MOVE MPLTINFO-NOASCII-REPORTS    TO  SAVE-NOASCII-REPORTS.

           MOVE 61                          TO  LINE-CTR.
           MOVE "MCPRT"                     TO  OVRPRTF-FILE.
           MOVE SAVE-SPOOL-PNUM             TO  OVRPRTF-TOFILE-NUM.
           PERFORM 996-OVERRIDE-PRINT-FILE.
           OPEN OUTPUT PRINT-FILE.
           MOVE 1                           TO  DATE-MODE.
           CALL "TDATECHK" USING DATE-CHECK-AREA.
           MOVE DATE-SLASH-OUT              TO  H0-DATE.

022400     PERFORM 6-MAIN THRU 6-M-X.

       2-EOJ.
           CLOSE DPORECD-O, DPOITEM-I, DVENDOR-I,
               MBUYER-I, MPLTINFO-I.
           CLOSE DISPLAY-FILE.
022800     GOBACK.
022900
031200******************************************************
031300**                                                  **
031400**   BLOWUP ROUTINE                                 **
031500**                                                  **
031600******************************************************
031700
031800 2-BLOWUP.
031900     MOVE "TPOPRSEL"              TO  BU-PGM-NAME.
032000     CALL "TBLOWUP" USING BASE, BU-PGM-NAME, STATUS-AREA,
032100         VIEW-COMAREA, FILE-STATUS, BU-DISPLAY-MSG,
032200                 BU-DISPLAY-FLDS.
032300
032400 2-BLOWUP-X.
032500     EXIT.
035300
035400 4-PGM-ERROR.
           MOVE B"1" TO IND (FIELD-NUMBER), IND (99).
           MOVE MESSAGE-BUFFER TO DE-MESSAGE-LINE.
036200
036300 4-PGM-ERROR-X.
036400     EXIT.
036500
038600**************************************************
038700*                                                *
038800*     6 - M A I N                                *
038900*                                                *
039000**************************************************
039100
039200 6-MAIN.
039300     MOVE "FPOPRSEL"         TO  VIEW-NFNAME.
040800     MOVE SPACES             TO  SCREEN-1.
           MOVE ZEROS              TO  DE-VENDOR-CODE8-10.
040900     MOVE COMPANY-SAVE       TO  DE-DISP-COMPANY-1.
           IF SAVE-NOASCII-REPORTS = "Y"
               MOVE "N"            TO  DE-SPEC-CHAR
           ELSE
               MOVE "Y"            TO  DE-SPEC-CHAR.
041600
041700 6-SHOWFORM-SCREEN-1.
           MOVE SCREEN-1           TO  DISPLAY-REC.
           PERFORM 998-WRITE-SCREEN THRU 998-READ-SCREEN.
           MOVE DISPLAY-REC        TO  SCREEN-1.
042500
042600     IF VIEW-LASTKEY = 3
042700         GO TO 6-M-X
042800     ELSE
044200     IF VIEW-LASTKEY = 1 OR
044300        VIEW-LASTKEY = 2 OR
044400        VIEW-LASTKEY = 4 OR
044500        VIEW-LASTKEY = 5 OR
044600        VIEW-LASTKEY = 6 OR
044700        VIEW-LASTKEY = 7 OR
              VIEW-LASTKEY = 8
044900*        "* INVALID FUNCTION KEY ENTERED *"
045000         MOVE   9            TO  LANG-SETNUM
045100         MOVE  10            TO  LANG-MSGNUM
045200         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
045300         MOVE 1              TO  FIELD-NUMBER
045400         PERFORM 4-PGM-ERROR  THRU  4-PGM-ERROR-X
045500         GO TO 6-SHOWFORM-SCREEN-1.
045600
      *------ FIELD EDITS
           IF DE-BUYER-CODE = "    "
      *         YOU MUST ENTER A BUYER CODE
               MOVE 44036          TO  CATREAD-MSG-NUMBER
069800         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
069900         MOVE 1              TO  FIELD-NUMBER
070000         PERFORM 4-PGM-ERROR  THRU  4-PGM-ERROR-X
070100         GO TO 6-SHOWFORM-SCREEN-1.
075900
047600*****************************************************
047700*                                                   *
047800*    EDIT BUYER CODE                                *
047900*                                                   *
048000*****************************************************
048100
048200 6-EDIT-BUYER-CODE.
048300     IF DE-BUYER-CODE = "****" GO TO 6-EDIT-DATE.
           MOVE DE-BUYER-CODE TO BUYERCDE OF MBUYER-REC-I.
           START MBUYER-I KEY = BUYERCDE OF MBUYER-REC-I
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
049000*            "BUYER CODE DOES NOT EXIST"
049100             MOVE   2 TO LANG-SETNUM
049200             MOVE   4 TO LANG-MSGNUM
049300             PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
049400             MOVE MESSAGE-BUFFER TO MSG-TEXT
049500             MOVE DE-BUYER-CODE  TO  MSG-FLD
049600             MOVE 1          TO  FIELD-NUMBER
049700             PERFORM 4-PGM-ERROR  THRU  4-PGM-ERROR-X
049800             GO TO 6-SHOWFORM-SCREEN-1
049900         ELSE
050000         MOVE "START MBUYER * 6-EBC"  TO  BU-DISPLAY-MSG
050100         MOVE DE-BUYER-CODE  TO  BU-DISPLAY-FLD (2)
050200         GO TO 2-BLOWUP.
           READ MBUYER-I NEXT INTO BUF-MBUYER
               AT END    MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE "READ FAILURE ON BUYER CODE"
                   TO BU-DISPLAY-MSG
               MOVE FILE-STATUS TO BU-DISPLAY-FLD9 (1)
               GO TO 2-BLOWUP.
050300
050400     PERFORM 61-LEFT-SHIFT-BUYER-CODE  THRU  61-LSBC-X.
050500
       6-EDIT-DATE.
           MOVE SPACES TO PODTE OF DPORECD-REC-O.
           START DPORECD-O KEY >= PODTE OF DPORECD-REC-O
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.

           IF DE-DATE-SEL = "999999"
               MOVE 1              TO DATE-MODE
               CALL "TDATECHK" USING DATE-CHECK-AREA
               MOVE DATE-YMD-OUT   TO DATE-WA
                                      CUR-DATE-WA
               IF DATE-WA-YY > 70
                   MOVE 19 TO DATE-WA-CC
                              CUR-DATE-CC
               ELSE
                   MOVE 20 TO DATE-WA-CC
                              CUR-DATE-CC
               END-IF
               MOVE 1              TO DATE-WA-MM-9
                                      DATE-WA-DD-9
               MOVE 0              TO CURRENT-SW
           ELSE
           IF DE-DATE-SEL = "      "
               MOVE 1              TO DATE-MODE
               CALL "TDATECHK" USING DATE-CHECK-AREA
               MOVE DATE-YMD-OUT   TO DATE-WA
               IF DATE-WA-YY > 70
                   MOVE 19 TO DATE-WA-CC
               ELSE
                   MOVE 20 TO DATE-WA-CC
               END-IF
           ELSE
           MOVE 3                  TO DATE-MODE
           MOVE DE-DATE-SEL        TO DATE-VALIDATE-IN
           CALL "TDATECHK" USING DATE-CHECK-AREA
           MOVE DATE-YMD-OUT       TO DATE-WA
           IF DATE-WA-YY > 70
               MOVE 19 TO DATE-WA-CC
           ELSE
               MOVE 20 TO DATE-WA-CC
           END-IF.

