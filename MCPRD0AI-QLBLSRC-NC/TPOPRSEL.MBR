000200 IDENTIFICATION DIVISION.
000300 PROGRAM-ID. TPOPRSEL.
000600
000700**************************************************************
000800*                                                            *
000900*   T P O P R S E L   PURCHASE ORDER PRINTS SELECTION        *
001000*    SCREEN. THIS PROGRAM WILL GENERATE A FILE WITH THE      *
001100*    PURCHASE ORDERS THAT MEET THE CRITERIA REQUESTED        *
001200*    BY THE USER.                                            *
001800*                                                            *
      *C   01/11/96  JE COFFMAN                                    *
      *C     ADDED THE ABILITY TO ALLOW THE BUYER TO RETRIEVE ALL  *
      *C     OF THEIR NON-PRINTED/FAXED WORK ORDERS FOR A CURRENT  *
      *C     YEAR. IF THE DATE IS ENTERED AS '999999', THE LOGIC   *
      *C     SETS THE DATE TO THE FIRST DAY OF THE CURRENT YEAR    *
      *C     AND INCREMENTS THROUGH UNTIL THE DATE BEING SEARCHED  *
      *C     FOR EXCEEDS THE CURRENT DATE.
      *C
      *C   06/13/96  JEFF BUNGO
      *C     EXPAND DATE FIELDS FOR YEAR 2000 COMPLIANCE.
      *C     INCLUDE CENTURY FOR THE PO DATE AND ITS COMPARISONS.
      *C
      *C   03/13/97  CA YODER
      *C     ADDED OPTION TO PRINT PO WITHOUT USING SPECIAL PRINT
      *C     CHARACTERS (TPOPRNT2).  ALSO FIXED SEVERAL PROBLEMS.
      *C     1.  ERROR MESSAGE IF NO PO'S EXIST FOR THE DATE WAS
      *C         NOT DISPLAYING.  CORRECTED PROBLEM BY MOVING
      *C         ERROR MESSAGE TO CORRECT SCREEN.
      *C     2.  WHEN DPORECD LF WAS PREVIOUSLY CHANGED TO MCFL0904
      *C         (BY DATE), NO CONSIDERATION WAS MADE FOR THE SEARCH
      *C         BY VENDOR CODE.  THEREFORE, THIS WAS NOT WORKING
      *C         PROPERLY.  DEFINED ANOTHER LF TO USE MCFL0902
      *C         WHEN SEARCHING BY VENDOR CODE.
      *C     3.  WHEN THE END OF THE LIST OF PO'S FOR THE DAY IS
      *C         REACHED (USING F7 TO SCROLL THROUGH LIST), IT WAS
      *C         NOT GOING BACK TO THE FIRST SCREEN.  MOVED THE
      *C         PROPER SCREEN NAME TO VIEW-NFNAME WHEN RETURNING
      *C         FROM SECOND SCREEN.
      *C
001900**************************************************************
002900
003000 ENVIRONMENT DIVISION.
003100 CONFIGURATION SECTION.
003200 SOURCE-COMPUTER.  IBM-AS400.
003300 OBJECT-COMPUTER.  IBM-AS400.
       COPY SPECIALN OF COPYLIB.
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT DISPLAY-FILE
                  ASSIGN TO WORKSTATION-ZPOPRSEL-SI
                  ORGANIZATION IS TRANSACTION
                  ACCESS IS SEQUENTIAL
                  FILE STATUS IS DISPLAY-STATUS
                  CONTROL-AREA IS WS-CONTROL.

           SELECT DPOITEM-I
                  ASSIGN TO DATABASE-MCFLCS1002
                  ORGANIZATION IS INDEXED
                  ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                      WITH DUPLICATES
                  FILE STATUS IS FILE-STATUS.

           SELECT DPORECD-O
                  ASSIGN TO DATABASE-MCFLCS0904
                  ORGANIZATION IS INDEXED
                  ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                      WITH DUPLICATES
                  FILE STATUS IS FILE-STATUS.

           SELECT DVENDOR-I
                  ASSIGN TO DATABASE-MCFLCS0701
                  ORGANIZATION IS INDEXED
                  ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                      WITH DUPLICATES
                  FILE STATUS IS FILE-STATUS.

           SELECT MBUYER-I
                  ASSIGN TO DATABASE-MCFLCS0601
                  ORGANIZATION IS INDEXED
                  ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                  FILE STATUS IS FILE-STATUS.

           SELECT MPLTINFO-I
                  ASSIGN TO DATABASE-MCFLCS0501
                  ORGANIZATION IS INDEXED
                    ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                  FILE STATUS IS FILE-STATUS.

           SELECT PRINT-FILE ASSIGN TO PRINTER-MCPRT.

