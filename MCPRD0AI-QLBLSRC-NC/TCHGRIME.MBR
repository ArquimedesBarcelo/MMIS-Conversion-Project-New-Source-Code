       IDENTIFICATION DIVISION.
       PROGRAM-ID.    TCHGRIME.
       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.
       SOURCE-COMPUTER. IBM-AS400.
       OBJECT-COMPUTER. IBM-AS400.
       SPECIAL-NAMES. I-O-FEEDBACK IS I-O-FEEDBACK-AREA
                      LOCAL-DATA IS LOCAL-DATA-AREA.
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT DISPLAY-FILE
               ASSIGN TO WORKSTATION-ZOFFLINE-SI
               ORGANIZATION IS TRANSACTION
               ACCESS IS SEQUENTIAL
               FILE STATUS IS DSPLY-STATUS
               CONTROL-AREA IS WS-CONTROL.
           SELECT EQPNUM-FILE
                  ASSIGN TO DATABASE-MCFLMM0201
                  ORGANIZATION IS INDEXED
                  ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                  FILE STATUS IS EF-STATUS.
       DATA DIVISION.
       FILE SECTION.
       FD  DISPLAY-FILE
           LABEL RECORDS ARE OMITTED.
       01  DSPLY-REC                   PIC X(2000).
       FD  EQPNUM-FILE
           LABEL RECORDS ARE STANDARD.
       01  EFREC.
           COPY DDS-ALL-FORMATS OF MCFLMM0201.
       WORKING-STORAGE SECTION.
       COPY CATREAD OF COPYLIB.
       COPY CPYIND  OF COPYLIB.
       01  EQPNUM-DATA.                      COPY MEQPFILE OF COPYLIB.
       01  ERROR-BUFFER                       PIC X(80).
       01  FILE-STATUSES.
           05  DSPLY-STATUS                   PIC XX.
           05  EF-STATUS                      PIC XX.
       01  INPUT-AREA.
           05  INPUT-TYPE                     PIC X(8).
           05  INPUT-RIME                     PIC XX.
           05  INPUT-CMD-LINE                 PIC X(79).
           05  INPUT-ERR-LINE                 PIC X(79).
       COPY IOFEEDBACK OF COPYLIB.
       COPY DBSTAT     OF COPYLIB.
       01  TRUE-VAL                           PIC 1 VALUE B"1".
       COPY VCOMLINK   OF COPYLIB.
       COPY WSCONTROL  OF COPYLIB.
       PROCEDURE DIVISION.
       OPEN-PAR.
           PERFORM 1-HSK.
           PERFORM 6-MAIN THRU 6-MAIN-EXIT UNTIL VIEW-LASTKEY = 3.
       1-HSK.
           OPEN I-O   DISPLAY-FILE.
           OPEN I-O   EQPNUM-FILE.
           MOVE 0 TO VIEW-LASTKEY.
           MOVE SPACES TO INPUT-AREA.
           MOVE "FCHGRIME" TO VIEW-CFNAME.

       2-EOJ.
           CLOSE DISPLAY-FILE.
           CLOSE EQPNUM-FILE.
           GOBACK.

       6-MAIN.
           PERFORM 99-SCREEN-WRITE.
           PERFORM 98-SCREEN-READ.
           MOVE DSPLY-REC TO INPUT-AREA.
           IF VIEW-LASTKEY = 3 GO TO 6-MAIN-EXIT.
           PERFORM 60-READ-SEQ-AND-UPDATE THRU 60-RSAU-EXIT
               UNTIL COND-WORD = 15.
           MOVE SPACES TO INPUT-AREA DSPLY-REC.
       6-MAIN-EXIT.    EXIT.

       60-READ-SEQ-AND-UPDATE.
           MOVE 0 TO COND-WORD.
           READ EQPNUM-FILE NEXT INTO EQPNUM-DATA
               AT END    MOVE 15 TO COND-WORD.
           IF EF-STATUS NOT = "00" MOVE 15 TO COND-WORD.
           IF COND-WORD = 15 GO TO 60-RSAU-EXIT.
           IF INPUT-TYPE = EQP-TYPE
               NEXT SENTENCE
           ELSE
           GO TO 60-READ-SEQ-AND-UPDATE.
           MOVE INPUT-RIME TO EQP-RIME.
           REWRITE EFREC FROM EQPNUM-DATA
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF EF-STATUS NOT = "00" MOVE 17 TO COND-WORD.
       60-RSAU-EXIT.    EXIT.

       98-SCREEN-READ.
           READ DISPLAY-FILE FORMAT IS VIEW-CFNAME
               INDIC IS INDICS.
           ACCEPT IOFEEDBACK FROM I-O-FEEDBACK-AREA.
           MOVE ALL B"0" TO INDICS.
           IF DSPLY-STATUS NOT = "00"
               MOVE 3 TO VIEW-LASTKEY
           ELSE
           MOVE FUNCTION-NUM TO VIEW-LASTKEY.

       98A-SCREEN-READ.
           READ DISPLAY-FILE TERMINAL IS TERMINAL-ID
               INDIC IS INDICS
                  NO DATA MOVE DSPLY-STATUS TO DSPLY-STATUS.
           MOVE ALL B"0" TO INDICS.

       99-SCREEN-WRITE.
           WRITE DSPLY-REC FORMAT IS VIEW-CFNAME
               INDIC IS INDICS.
           MOVE ALL B"0" TO INDICS.

178200 999-CATREAD.
178300     MOVE SPACES TO ERROR-BUFFER.
           CALL "CCATREAD" USING CATREAD-PARMS.
           MOVE CATREAD-MSG-TEXT TO ERROR-BUFFER.
179800 999-CATREAD-EXIT.    EXIT.
