047600
      *------ CALL CCRTFILE TO CREATE A TEMPORARY FILE 'XXXXXXXX'
           MOVE "QTEMP"       TO CCRTFILE-LIBRARY.
           MOVE "COMBCODE"    TO CCRTFILE-FILE.
           MOVE "0084"        TO CCRTFILE-RECORD-LENGTH.
           MOVE "01000"       TO CCRTFILE-NO-RECORDS.
           MOVE "01000"       TO CCRTFILE-INCREMENT-AMT.
           MOVE "99"          TO CCRTFILE-NO-INCREMENTS.
           CALL "CCRTFILE" USING CCRTFILE-LIBRARY,
                                 CCRTFILE-FILE,
                                 CCRTFILE-RECORD-LENGTH,
                                 CCRTFILE-NO-RECORDS,
                                 CCRTFILE-INCREMENT-AMT,
                                 CCRTFILE-NO-INCREMENTS,
                                 CCRTFILE-STATUS.
           IF CCRTFILE-STATUS NOT = "00"
               MOVE "CCRTFILE CREATE OF 'COMBCODE' FAILED"
                  TO BU-DISPLAY-MSG
               PERFORM 2-BLOWUP.

047700     SORT SORT-FILE
047800         ON ASCENDING KEY SORT-CODE
047900         INPUT PROCEDURE IS 7-READ-ADJ
048000         OUTPUT PROCEDURE IS 7-COMBINE-CODES.
048100
048200     IF R17-SORT-OPTION = "1"
048300         SORT SORT-FILE
048400             ON DESCENDING KEY SORT-PERCT-ADJ
048500             USING COMBINED-CODE-FILE
048600             OUTPUT PROCEDURE IS 9-PRINT-REPORT
048700     ELSE
048800     IF R17-SORT-OPTION = "2"
048900         SORT SORT-FILE
049000             ON ASCENDING KEY SORT-CODE
049100             USING COMBINED-CODE-FILE
049200             OUTPUT PROCEDURE IS 9-PRINT-REPORT
049300     ELSE
049400     IF R17-SORT-OPTION = "3"
049500         SORT SORT-FILE
049600             ON ASCENDING KEY SORT-DATE SORT-TIME
049700             USING COMBINED-CODE-FILE
049800             OUTPUT PROCEDURE IS 9-PRINT-REPORT
049900     ELSE
050000     IF R17-SORT-OPTION = "4"
050100         SORT SORT-FILE
050200             ON DESCENDING KEY SORT-ADJ-QTY-UNSIGNED
050300             USING COMBINED-CODE-FILE
050400             OUTPUT PROCEDURE IS 9-PRINT-REPORT
050500     ELSE
050600*********MOVE "INVALID SORT OPTION 1-BH" TO BU-DISPLAY-MSG
050700*********MOVE R17-SORT-OPTION            TO BU-DISPLAY-FLD (5)
050800*********GO TO 2-BLOWUP.
               DISPLAY "R17-SORT-OPTION = ", R17-SORT-OPTION
               DISPLAY "*** DEFAULTING TO SORT OPTION 1 ***"
               MOVE "1" TO R17-SORT-OPTION
               SORT SORT-FILE
                   ON DESCENDING KEY SORT-PERCT-ADJ
                   USING COMBINED-CODE-FILE
                   OUTPUT PROCEDURE IS 9-PRINT-REPORT.

051000     IF BU-DISPLAY-MSG = SPACES
051100         GO TO 2-EOJ.
051200
051300 2-BLOWUP.
           MOVE ST-CODE-ARG TO BU-DISPLAY-FLD (1).
           MOVE "TRPTADJ" TO BU-PGM-NAME.
           CALL "TBLOWUP" USING BASE, BU-PGM-NAME, STATUS-AREA,
             DUMMY-VIEW-AREA, FILE-STATUS, BU-DISPLAY-MSG,
             BU-DISPLAY-AREA.
053600
053700 2-EOJ.
           CLOSE MSTORERM-I, DDAILYTC-I.
054000     GOBACK.
054100
054200 7-READ-ADJ SECTION.
       7-READ-ADJ-PARA.
054300     IF DDAILY-OR-FILE = "F"
054400         OPEN INPUT ADJ-FILE.
054500
           MOVE SPACES TO DLYTCDTE OF DDAILYTC-REC-I.
           START DDAILYTC-I KEY >= DLYTCDTE OF DDAILYTC-REC-I
               INVALID KEY MOVE 17 TO COND-WORD.
      *****IF FILE-STATUS NOT = "00"   *REPLACED 08OCT1997*
           IF (FILE-STATUS NOT = "00") AND (FILE-STATUS-1 NOT = "2")
               MOVE "START ERR DDAILYTC 7-RAP" TO BU-DISPLAY-MSG
               PERFORM 2-BLOWUP.

           MOVE ZERO TO TOTAL-CODES-INVENTORIED.

054600 7-READ-ADJ-FILE.
054700
           IF DDAILY-OR-FILE = "F"
               READ ADJ-FILE INTO ADJ-RCD AT END
                   CLOSE ADJ-FILE
                   GO TO 7-RA-X.

056400     IF DDAILY-OR-FILE = "D"
056500*        CALL "DBGET" USING BASE DSET-DDAILYTC MODE2 STATUS-AREA
056600*          ALL-ITEM-LIST BUF-DDAILYTC ST-CODE-ARG
               READ DDAILYTC-I NEXT INTO BUF-DDAILYTC
                   AT END MOVE FILE-STATUS TO FILE-STATUS
               END-READ
056700*********IF FILE-STATUS-1 = "1"    *REPLACED 08OCT1997*
               IF FILE-STATUS = "10" OR "14" OR "46"
056800             GO TO 7-RA-X
056900         ELSE
057000         IF FILE-STATUS = "00"
057100             MOVE DAILY-TC TO ADJ-RCD
057200         ELSE
057300             MOVE "DBGET ERR DDAILYTC" TO BU-DISPLAY-MSG
057500             GO TO 2-BLOWUP.
057600
057700     IF ADJ-TC NOT = "332"
057800         GO TO 7-READ-ADJ-FILE.
057900
058000     IF R17-MATERIAL-OPTION = "2"
058100         IF ADJ-CODE-1-2 = R17-MG-1 OR R17-MG-2 OR
058200                               R17-MG-3 OR R17-MG-4 OR
058300                               R17-MG-5
058400             NEXT SENTENCE
058500         ELSE
058600             GO TO 7-READ-ADJ-FILE
058700     ELSE
058800     IF R17-MATERIAL-OPTION = "3"
058900         MOVE ADJ-CODE TO ST-CODE-ARG
