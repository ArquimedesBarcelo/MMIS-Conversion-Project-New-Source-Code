062200     RETURN SORT-FILE AT END
062300         CLOSE COMBINED-CODE-FILE
062400         GO TO 7-CC-X.
062500     MOVE SORT-REC TO SAVE-REC.
           ADD 1 TO TOTAL-CODES-ADJUSTED.
062600
062700 71-COMBINE-LOOP.
062800     RETURN SORT-FILE AT END
062900         PERFORM 73-WRITE-TO-FILE THRU 73-WTF-X
063000         CLOSE COMBINED-CODE-FILE
063100         GO TO 7-CC-X.
063200
      *-----9/12/97 JSB, REMOVE COMBINATION OF CODES
      *----- BUT KEEP TRACK OF NUMBER OF UNIQUE CODES
063300     IF SORT-CODE = SAVE-CODE
063400*        PERFORM 72-COMBINE-A-CODE THRU 72-CAC-X
               PERFORM 73-WRITE-TO-FILE THRU 73-WTF-X
063500     ELSE
               ADD 1 TO TOTAL-CODES-ADJUSTED
063600         PERFORM 73-WRITE-TO-FILE THRU 73-WTF-X.
063700
063800     GO TO 71-COMBINE-LOOP.
063900
      *-----9/12/97 JSB, REMOVE COMBINATION OF CODES
064000*72-COMBINE-A-CODE.
064100*    ADD SAVE-ADJ-QTY   TO SORT-ADJ-QTY.
064200*    ADD SAVE-ADJ-QTY-UNSIGNED TO SORT-ADJ-QTY-UNSIGNED.
064300*    MOVE SAVE-PREV-QTY TO SORT-PREV-QTY.
064400*    MOVE SORT-REC      TO SAVE-REC.
064500*72-CAC-X.
064600*    EXIT.
064700
064800 73-WRITE-TO-FILE.
064900     IF SAVE-ADJ-QTY-UNSIGNED < 1
065000          MULTIPLY -1 BY SAVE-ADJ-QTY-UNSIGNED.
065100     IF SAVE-PREV-QTY < 1
065200         MOVE 99999999.9 TO SAVE-PERCT-ADJ
065300         GO TO 73-CONT.
065400
065500     IF SAVE-ADJ-QTY < 0
065600         MULTIPLY SAVE-ADJ-QTY BY -1 GIVING HOLD-ADJ-QTY
065700     ELSE
065800         MOVE SAVE-ADJ-QTY TO HOLD-ADJ-QTY.
065900     DIVIDE HOLD-ADJ-QTY BY SAVE-PREV-QTY
066000         GIVING HOLD-PERCT-ADJ ROUNDED.
066100     MULTIPLY HOLD-PERCT-ADJ BY 100 GIVING HOLD-PERCT-ADJ.
066200     MOVE HOLD-PERCT-ADJ TO SAVE-PERCT-ADJ.
066300
066400 73-CONT.
066500     MOVE SAVE-REC TO COMBINED-CODE-REC.
066600     WRITE COMBINED-CODE-REC.
066700     MOVE SORT-REC TO SAVE-REC.
066800
066900 73-WTF-X.
067000     EXIT.
067100
067200 7-CC-X.
067300     EXIT.
067400 9-PRINT-REPORT SECTION.
       9-PRINT-REPORT-PARA.
           MOVE SPACES TO CORPCDE OF MSTORERM-REC-I.
           START MSTORERM-I KEY >= CORPCDE OF MSTORERM-REC-I
               INVALID KEY MOVE 17 TO COND-WORD.
           IF FILE-STATUS NOT = "00"
               MOVE "START ERR MSTORERM 9-PRP" TO BU-DISPLAY-MSG
               PERFORM 2-BLOWUP.

067500 91-COUNT-CODES.
067600*    CALL "DBGET" USING BASE DSET-MSTORERM MODE2 STATUS-AREA
067700*       ALL-ITEM-LIST BUF-MSTORERM NO-ARG.
           READ MSTORERM-I NEXT INTO BUF-MSTORERM
               AT END MOVE FILE-STATUS TO FILE-STATUS.
067800     IF FILE-STATUS-1 = "1"
067900         GO TO 92-WRITE-DETAIL-LINES
068000     ELSE
068100     IF FILE-STATUS NOT = "00"
068200         MOVE "DBGET ERR MSTORE 91-CC" TO BU-DISPLAY-MSG
068400         GO TO 9-WR-X.
068500
068600     IF R17-MATERIAL-OPTION = "2"
068700         IF CORP-CODE-1-2 = R17-MG-1 OR R17-MG-2 OR
068800                                R17-MG-3 OR R17-MG-4 OR
068900                                R17-MG-5
069000             ADD 1 TO TOTAL-CODES
                   COMPUTE TOTAL-STRM-VALUE ROUNDED =
                           TOTAL-STRM-VALUE +
                                        (STR-ONHAND * STR-AVG-COST)
069100         ELSE
069200             NEXT SENTENCE
069300     ELSE
069400     IF R17-MATERIAL-OPTION = "3"
069500         IF STR-CLASS = R17-CLASS-1 OR R17-CLASS-2 OR R17-CLASS-3
069600                                    OR R17-CLASS-4 OR R17-CLASS-5
069700             ADD 1 TO TOTAL-CODES
                   COMPUTE TOTAL-STRM-VALUE ROUNDED =
                           TOTAL-STRM-VALUE +
                                        (STR-ONHAND * STR-AVG-COST)
069800          ELSE
069900             NEXT SENTENCE
070000     ELSE
070100         ADD 1 TO TOTAL-CODES
               COMPUTE TOTAL-STRM-VALUE ROUNDED =
                       TOTAL-STRM-VALUE + (STR-ONHAND * STR-AVG-COST).
070200
070300     GO TO 91-COUNT-CODES.
070400
070700 92-WRITE-DETAIL-LINES.
070800     RETURN SORT-FILE
070900         AT END GO TO 93-WRITE-TOTALS.
071000
071100     IF SORT-ADJ-QTY = 0
071200         GO TO 92-WRITE-DETAIL-LINES.
071300
071400     ADD 1                TO TOTAL-ADJUSTMENTS.
071500     ADD SORT-PREV-QTY    TO TOTAL-PREV-UNITS.
071600     ADD SORT-ONHAND      TO TOTAL-NEW-UNITS.
071700     IF SORT-ADJ-QTY < 0
071800         MULTIPLY SORT-ADJ-QTY BY -1 GIVING HOLD-ADJ-QTY
071900         ADD HOLD-ADJ-QTY TO TOTAL-ADJUSTMENT-UNITS
072000     ELSE
072100         ADD SORT-ADJ-QTY TO TOTAL-ADJUSTMENT-UNITS.
           COMPUTE TOTAL-PREV-VALUE ROUNDED = TOTAL-PREV-VALUE
                                    + (SORT-AVG-COST * SORT-PREV-QTY).
072200
072300     IF HD-SPOOLER-NUMBER NOT = SPACES
072400         PERFORM 921-MOVE-CP-FIELDS
072500         WRITE ONLINE-PRT-REC FROM CP-DETAIL-1
072600             AFTER ADVANCING 1.
072700     ADD 1 TO LINE-K.
072800     IF LINE-K > 55
072900          IF HD-SPOOLER-NUMBER NOT = SPACES
073000              PERFORM 922-WRITE-CP-HEADERS.
073100
073200
073300     GO TO 92-WRITE-DETAIL-LINES.
073400
073500 921-MOVE-CP-FIELDS.
073600     MOVE SORT-CODE          TO CP-PRT-CODE.
073700     MOVE SORT-TIME-HH       TO CP-T-HH.
073800     MOVE SORT-TIME-MM       TO CP-T-MM.
073900     MOVE SORT-TIME-SS       TO CP-T-SS.
074000     MOVE SORT-PREV-QTY      TO CP-PRT-PREV-QTY.
074100     MOVE SORT-ADJ-QTY       TO CP-PRT-ADJ.
074200     MOVE SORT-ONHAND        TO CP-PRT-NEW-QTY.
074300     IF SORT-PERCT-ADJ = 99999999.9
074400         MOVE "       ***"   TO CP-PRT-PERCT-ADJ-X
074500         MOVE " "            TO CP-PRT-PERCT
074600     ELSE
074700         ADD SORT-PERCT-ADJ  TO TOTAL-PERCT-ADJ
074800         MOVE "%"            TO CP-PRT-PERCT
074900         MOVE SORT-PERCT-ADJ TO CP-PRT-PERCT-ADJ.
           MULTIPLY SORT-ADJ-QTY BY SORT-AVG-COST
               GIVING HOLD-CP-TRAN-VALUE ROUNDED.
           MOVE HOLD-CP-TRAN-VALUE TO CP-TRAN-VALUE.
           ADD HOLD-CP-TRAN-VALUE  TO TOTAL-VALUE.
075000
075100 922-WRITE-CP-HEADERS.
075200     ADD 1 TO PAGE-K.
075300     MOVE PAGE-K TO CP-PRT-PAGE.
075400     WRITE ONLINE-PRT-REC FROM CP-HDR-1 AFTER ADVANCING NEW-PAGE.
075500     WRITE ONLINE-PRT-REC FROM CP-HDR-2 AFTER ADVANCING 2.
075600     WRITE ONLINE-PRT-REC FROM CP-HDR-3 AFTER ADVANCING 1.
075700     MOVE 2 TO LINE-K.
075800
075900 93-WRITE-TOTALS.
076000     ADD 1 TO LINE-K.
076100
076200     MOVE TOTAL-CODES           TO CP-TOT-CODES.
           COMPUTE TOTAL-STRM-VALUE-RND ROUNDED = TOTAL-STRM-VALUE.
           MOVE TOTAL-STRM-VALUE-RND  TO CP-TOT-STRM-VALUE.
076300     MOVE TOTAL-CODES-ADJUSTED  TO CP-TOT-CODES-ADJ.
           MOVE TOTAL-CODES-INVENTORIED TO CP-TOT-CODES-INV.
076400
076500     DIVIDE TOTAL-CODES-ADJUSTED BY TOTAL-CODES
076600         GIVING HOLD-CODES-ADJ-PERCT ROUNDED.
076700     MULTIPLY 100 BY HOLD-CODES-ADJ-PERCT.
076800     MOVE HOLD-CODES-ADJ-PERCT  TO CP-CODES-ADJ-PERCT.
076900
           DIVIDE TOTAL-CODES-ADJUSTED BY TOTAL-CODES-INVENTORIED
               GIVING HOLD-CODES-ADJ-PERCT ROUNDED.
           MULTIPLY 100 BY HOLD-CODES-ADJ-PERCT.
           MOVE HOLD-CODES-ADJ-PERCT  TO CP-CODES-INV-PERCT.

           DIVIDE TOTAL-CODES-INVENTORIED BY TOTAL-CODES
               GIVING HOLD-CODES-ADJ-PERCT ROUNDED.
           MULTIPLY 100 BY HOLD-CODES-ADJ-PERCT.
           MOVE HOLD-CODES-ADJ-PERCT  TO CP-CODES-IVA-PERCT.

077000     DIVIDE TOTAL-PERCT-ADJ BY TOTAL-ADJUSTMENTS
077100         GIVING HOLD-AVG-PERCT-OF-ADJ ROUNDED.
077200     MOVE HOLD-AVG-PERCT-OF-ADJ TO CP-AVG-PERCT-OF-ADJ.

           DIVIDE TOTAL-VALUE BY TOTAL-PREV-VALUE
               GIVING HOLD-CODES-ADJ-PERCT ROUNDED.
           MULTIPLY 100 BY HOLD-CODES-ADJ-PERCT.
           MOVE HOLD-CODES-ADJ-PERCT  TO CP-DOLLR-INV-ADJ.

           DIVIDE TOTAL-VALUE BY TOTAL-STRM-VALUE
               GIVING HOLD-CODES-ADJ-PERCT ROUNDED.
           MULTIPLY 100 BY HOLD-CODES-ADJ-PERCT.
           MOVE HOLD-CODES-ADJ-PERCT  TO CP-DOLLR-ALL-ADJ.
077300
077400     MOVE TOTAL-ADJUSTMENT-UNITS TO CP-ADJ-UNITS.
077500     MOVE TOTAL-ADJ-COST         TO CP-ADJ-COST
077600
077700     MOVE TOTAL-PREV-UNITS       TO CP-PRT-TOT-PREV-QTY.
077800     MOVE TOTAL-ADJUSTMENT-UNITS TO CP-PRT-TOT-ADJ-1.
077900     MOVE TOTAL-NEW-UNITS        TO CP-PRT-TOT-NEW-QTY.
           MOVE TOTAL-VALUE            TO CP-PRT-TOT-VALUE.
078000
078100     WRITE ONLINE-PRT-REC FROM CP-TOTAL-LINE-0
078200         AFTER ADVANCING 2.
078300     IF LINE-K < 51
078400         WRITE ONLINE-PRT-REC FROM CP-TOTAL-LINE-1
078500            AFTER ADVANCING 4
078600     ELSE
078700         PERFORM 922-WRITE-CP-HEADERS
078800         WRITE ONLINE-PRT-REC FROM CP-TOTAL-LINE-1
078900            AFTER ADVANCING NEW-PAGE.
           WRITE ONLINE-PRT-REC FROM CP-TOTAL-LINE-1B
               AFTER ADVANCING 2.
079000     WRITE ONLINE-PRT-REC FROM CP-TOTAL-LINE-2A
079100         AFTER ADVANCING 2.
079000     WRITE ONLINE-PRT-REC FROM CP-TOTAL-LINE-2
079100         AFTER ADVANCING 2.
           WRITE ONLINE-PRT-REC FROM CP-TOTAL-LINE-3A
               AFTER ADVANCING 2.
079200     WRITE ONLINE-PRT-REC FROM CP-TOTAL-LINE-3
079300         AFTER ADVANCING 2.
           WRITE ONLINE-PRT-REC FROM CP-TOTAL-LINE-3B
               AFTER ADVANCING 2.
           WRITE ONLINE-PRT-REC FROM CP-TOTAL-LINE-3C
               AFTER ADVANCING 2.
           WRITE ONLINE-PRT-REC FROM CP-TOTAL-LINE-3D
               AFTER ADVANCING 2.
079400     WRITE ONLINE-PRT-REC FROM CP-TOTAL-LINE-4
079500         AFTER ADVANCING 2.
079600
           IF NOT PAPER-IS-132-COLS
080400         MOVE STAND-ESC-SEQ TO ONLINE-PRT-REC.
080500     WRITE ONLINE-PRT-REC BEFORE ADVANCING 0 LINES.
080600
080700     CLOSE ONLINE-PRT.
080800
080900 9-WR-X.
081000     EXIT.
       COPY OVRPFCALL IN COPYLIB.
