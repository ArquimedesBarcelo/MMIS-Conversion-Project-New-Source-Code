000200 IDENTIFICATION DIVISION.
000300 PROGRAM-ID.    TINVHOLD.
000400 AUTHOR.        KURT MOVSESIAN.
000600 INSTALLATION.  GOODYEAR TIRE AND RUBBER CO.
000500 DATE-WRITTEN.  JUNE 24, 1985.
000700
000800*REMARKS.        INVOICE PROCESSING.
001000**************************************************************
001100*                                                            *
001200*   T I N V H O L D                                          *
001300*                                                            *
001400*   THIS SUB PROGRAM PLACES AN INVOICE ON HOLD BY CALLING    *
001500*   'TINVBACK'.                                              *
001600*                                                            *
001700**************************************************************
001800*   N O T E    T H I S   S U B R O U T I N E   I S           *
001900*         C A L L E D    B Y :                               *
002000*      1. TINVMOD.SOURCE - INVOICE MODIFICATION              *
002100**************************************************************
002200*   N O T E    T H I S   S U B R O U T I N E                 *
002300*         C A L L S :                                        *
002400*      1. TINVBACK.SOURCE - BACKS OUT AN INVOICE             *
002500**************************************************************
      *                                                            *
      *C*  07/12/1996    CA YODER                                  *
      *C*    RE-COMPILED TO PICK UP CENTURY DATABASE CHANGES.      *
      *                                                            *
      **************************************************************
004000 ENVIRONMENT DIVISION.
004100 CONFIGURATION SECTION.
004200 SOURCE-COMPUTER.    HP-3000.
004300 OBJECT-COMPUTER.    HP-3000.
       SPECIAL-NAMES.  I-O-FEEDBACK IS I-O-FEEDBACK-AREA.
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT DISPLAY-FILE
                  ASSIGN TO WORKSTATION-ZINVOICE-SI
                  ORGANIZATION IS TRANSACTION
                  ACCESS IS SEQUENTIAL
                  FILE STATUS IS DISPLAY-STATUS
                  CONTROL-AREA IS WS-CONTROL.
           SELECT MPLTINFO-I
                  ASSIGN TO DATABASE-MCFLCS0501
                  ORGANIZATION IS INDEXED
                    ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                  FILE STATUS IS FILE-STATUS.
           SELECT DPORECD-I
                  ASSIGN TO DATABASE-MCFLCS0901
                  ORGANIZATION IS INDEXED
                    ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                    WITH DUPLICATES
                  FILE STATUS IS FILE-STATUS.
           SELECT MVALIDUM-I
                 ASSIGN TO DATABASE-MCFLCS0401
                 ORGANIZATION IS INDEXED
                   ACCESS MODE IS DYNAMIC
                 RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                 FILE STATUS IS FILE-STATUS.
004400
004500 DATA DIVISION.
       FILE SECTION.
       FD  DISPLAY-FILE
           LABEL RECORDS ARE OMITTED.
       01  DISPLAY-REC.
           COPY DD-INVMOD3-O OF ZINVOICE.
       FD  MPLTINFO-I
           LABEL RECORDS ARE STANDARD.
       01  MPLTINFO-I-REC.
           COPY DDS-ALL-FORMATS OF MCFLCS0501.
       FD  DPORECD-I
           LABEL RECORDS ARE STANDARD.
       01  DPORECD-I-REC.
           COPY DDS-ALL-FORMATS OF MCFLCS0901.
       FD  MVALIDUM-I
           LABEL RECORDS ARE STANDARD.
       01  MVALIDUM-I-REC.
           COPY DDS-ALL-FORMATS OF MCFLCS0401.
             05  MCFLCS0401-RECORD PIC X(18).

004600
004700 WORKING-STORAGE SECTION.
       01  FILE-STATUS.
           05  FILE-STATUS-1         PIC X VALUE "0".
           05  FILE-STATUS-2         PIC X VALUE "0".
004800 77  BLOWUP-SW                 PIC X        VALUE SPACE.
005000
005100 01  BUILD-TM-DISCOUNT-KEY.
005200     05  FILLER                PIC X(3)  VALUE "TMP".
005300     05  BUILD-TM-DISCOUNT-VALUE  PIC X  VALUE SPACES.
005400
005500 01  BUILD-TM-DUE-DATE-KEY.
005600     05  FILLER                PIC X(3)  VALUE "TMD".
005700     05  BUILD-TM-DATE-VALUE   PIC X     VALUE SPACES.
005800
       01  BUILD-CC-KEY.
           05  BUILD-CC-VALUE        PIC X(2)  VALUE SPACES.
005900
006000*************************************************************
006100**                                                         **
006200**      V I E W   C O M M U N I C A T I O N   A R E A      **
006300**                                                         **
006400*************************************************************
006500
006600 01  FORM-NAMES.
006700     05  HEADER                PIC X(7)     VALUE "INVMOD3".
006800
006900 01  SAVE-VIEW-STATUS          PIC S9(4)    VALUE ZERO  COMP.
007000 01  SAVE-COND-WORD            PIC S9(4)    VALUE ZERO  COMP.
007100
007200 01  MESSAGE-BUFFER.
007300     05  MSG-TEXT              PIC X(68)    VALUE SPACE.
007400     05  MSG-FLD               PIC X(8)     VALUE SPACE.
007500     05  MSG-FLD-9  REDEFINES  MSG-FLD      PIC ZZZZZZZ9.
007600
007700 01  MESSAGE-BUFLEN            PIC S9(4)    VALUE 76    COMP.
007800
007900 01  MESSAGE-ACTLEN            PIC S9(4)    VALUE ZERO  COMP.
008000
008100 01  FIELD-NUMBER              PIC S9(4)    VALUE 1     COMP.
008200
008300*************************************************************
008400**                                                         **
008500**           D A T A   E N T R Y   B U F F E R S           **
008600**                                                         **
008700*************************************************************
008800
008900 01  DE-BUFFER1.
009000     05  DE1-REG-NUM           PIC ZZZZ9.
009100     05  DE1-PO-RLSE.
009200         10  DE1-PO            PIC X(7).
009300         10  DE1-RLSE          PIC X(3).
009400     05  DE1-INV-NUM           PIC X(14).
009500     05  DE1-STATUS            PIC X.
009600     05  DE1-MFEST-NO          PIC X(8).
009700     05  DE1-INV-DATE          PIC X(8).
009800     05  DE1-DUE-DATE          PIC X(8).
009900     05  DE1-INV-TERMS.
010000         10  DE1-TERMS-DUE-PCT  PIC X.
010100         10  DE1-TERMS-DUE-DATE PIC X.
010200     05  DE1-ENTRY-DATE        PIC X(8).
010300     05  DE1-MOD-DATE          PIC X(8).
010400     05  DE1-ADD-CLERK         PIC X(4).
010500     05  DE1-MOD-CLERK         PIC X(4).
010600     05  DE1-PO-TERMS-PERCENT  PIC X(5).
010700     05  DE1-PO-TERMS-DUE      PIC X(18).
010800     05  DE1-INV-CE            PIC X.
010900     05  DE1-CE-AMT            PIC -(11)9.99.
011000     05  DE1-CE-ACCTG          PIC X(9).
011100     05  DE1-I-MATL-EXT        PIC -(11)9.99.
011200     05  DE1-P-MATL-EXT        PIC -(11)9.99.
011300     05  DE1-PAYMENT-IND       PIC X.
011400     05  DE1-VEN-CODE.
011500         10  DE1-VEN7          PIC X(7).
011600         10  DE1-VEN3          PIC X(3).
011700     05  DE1-NET-DUE-VENDOR    PIC -(11)9.99.
011800     05  DE1-DIST-COST         PIC -(11)9.99.
011900     05  DE1-NO-CHECK-INDIC    PIC X.
           05  DE1-CUR-CODE          PIC X(2).
           05  DE1-CUR-DESC          PIC X(12).
           05  DE1-COMMAND-LINE      PIC X(79).
           05  DE1-MSG-LINE          PIC X(79).
012000
012100*************************************************************
012200**                                                         **
012300**  D A T A B A S E   C O M M U N I C A T I O N   A R E A  **
012400**                                                         **
012500*************************************************************
012600
012700 COPY MPLTINFO IN COPYLIB.
012900
013000 COPY DBMODES  IN COPYLIB.
013100
       COPY DPORECD  IN COPYLIB.

       COPY MVALIDUM IN COPYLIB.

013200 COPY DBSTAT   IN COPYLIB.
015300 COPY TDATECHK IN COPYLIB.
       COPY DISPDATA IN COPYLIB.
       COPY IOFEEDBACK IN COPYLIB.
015700 COPY TBLOWUP  IN COPYLIB.
015900 COPY CATREAD  IN COPYLIB.
016000*************************************************************
016100**                                                         **
016200**                L I N K A G E   A R E A                  **
016300**                                                         **
016400*************************************************************
016500
016600 LINKAGE SECTION.
016700
016800 01  BASE                      PIC X(10).
016900
017000 COPY VCOMLINK IN COPYLIB.
017100
017200*01  SCREEN-PRINT-PARMS.
017300*    05  PRINT-CTL             PIC S9(4)    COMP.
017400*    05  PAGE-CTL              PIC S9(4)    COMP.
017500*    05  SPOOLFIL-OPEN-SW      PIC X.
017600*
017700*01  PASS-SPOOL-PRT-NO         PIC S9(2)    COMP.
017800
017900 01  ARGUMENT-VALUES.
018000     05  PLT-ARG               PIC X(4).
018100     05  PO-ARG                PIC X(14).
018200     05  VEN-ARG.
018300         10  VEN-ARG1-7        PIC X(7).
018400         10  VEN-ARG8-10       PIC X(3).
018500     05  CORPCODE-ARG          PIC X(8).
018600     05  REGISTER-ARG          PIC X(6).
018700
018800 COPY DINVRCD IN COPYLIB.
018900
019000 COPY LANGSUB IN COPYLIB.
019100
019200
019300 PROCEDURE DIVISION USING  BASE,
019400                           VIEW-COMAREA,
019500*                          SCREEN-PRINT-PARMS,
019600*                          PASS-SPOOL-PRT-NO,
019700                           ARGUMENT-VALUES,
019800                           BUF-DINVRCD,
019900                 LANGUAGE-PARMS.
020000
020100
020200 HOLD-INVOICE SECTION 05.
020300     OPEN INPUT MPLTINFO-I, DPORECD-I, MVALIDUM-I.
           OPEN I-O DISPLAY-FILE.
020400     PERFORM  6-HOLD-INVOICE  THRU  6-HOLD-INVOICE-X.
           CLOSE MPLTINFO-I, DISPLAY-FILE, DPORECD-I, MVALIDUM-I.
020500     GOBACK.
020600
020700 2-BLOWUP.
020800     MOVE REGISTER-ARG        TO  BU-DISPLAY-FLD (1).
020900     MOVE "TINVHOLD"          TO  BU-PGM-NAME.
021000     CALL "TBLOWUP" USING BASE, BU-PGM-NAME, STATUS-AREA,
021100         VIEW-COMAREA, FILE-STATUS, BU-DISPLAY-MSG,
021200                 BU-DISPLAY-FLDS.
021300
021400 2-BLOWUP-X.
021500     EXIT.
021600
021700
021800 6-HOLD-INVOICE.
021900     MOVE SPACE               TO  DE-BUFFER1.
022000     MOVE INV-REG-NO-9        TO  DE1-REG-NUM.
022100     MOVE INV-PO-NO           TO  DE1-PO.
022200     MOVE INV-RLSE            TO  DE1-RLSE.
022300     MOVE INV-NO              TO  DE1-INV-NUM.
022400     MOVE INV-STATUS          TO  DE1-STATUS.
022500     MOVE INV-MFEST-NO        TO  DE1-MFEST-NO.
022600     MOVE 4                   TO  DATE-MODE.
022700     MOVE INV-DATE            TO  DATE-VALIDATE-IN.
022800     CALL "TDATECK2" USING DATE-CHECK-AREA, LANGUAGE-PARMS.
022900     MOVE DATE-SLASH-OUT      TO  DE1-INV-DATE.
023000     IF INV-DUE-DATE NOT = SPACE
023100         MOVE INV-DUE-DATE    TO  DATE-VALIDATE-IN
023200         CALL "TDATECK2" USING DATE-CHECK-AREA, LANGUAGE-PARMS
023300         MOVE DATE-SLASH-OUT  TO  DE1-DUE-DATE.
023400     MOVE INV-TERMS           TO  DE1-INV-TERMS.
023500     PERFORM 61-GET-TERMS-DESC  THRU 61-GTD-X.
023600     MOVE INV-ENTRY-DATE      TO  DATE-VALIDATE-IN.
023700     CALL "TDATECK2" USING DATE-CHECK-AREA, LANGUAGE-PARMS.
023800     MOVE DATE-SLASH-OUT      TO  DE1-ENTRY-DATE.
023900     IF INV-MOD-DATE NOT = SPACE
024000         MOVE INV-MOD-DATE    TO  DATE-VALIDATE-IN
024100         CALL "TDATECK2" USING DATE-CHECK-AREA, LANGUAGE-PARMS
024200         MOVE DATE-SLASH-OUT  TO  DE1-MOD-DATE.
024300     MOVE INV-ADD-CLERK       TO  DE1-ADD-CLERK.
024400     MOVE INV-MOD-CLERK       TO  DE1-MOD-CLERK.
024500     MOVE CE1-CODE            TO  DE1-INV-CE.
024600     MOVE CE1-TOTAL           TO  DE1-CE-AMT.
024700     MOVE CE1-ACCTG-DATA      TO  DE1-CE-ACCTG.
024800     MOVE INV-I-MATL-EXT      TO  DE1-I-MATL-EXT.
024900     MOVE INV-P-MATL-EXT      TO  DE1-P-MATL-EXT.
025000     MOVE INV-PAYMENT-IND     TO  DE1-PAYMENT-IND.
025100     MOVE INV-NET-DUE-VENDOR  TO  DE1-NET-DUE-VENDOR.
025200     MOVE INV-DIST-COST       TO  DE1-DIST-COST.
025300     MOVE INV-VEN-CODE        TO  DE1-VEN-CODE.
025400     MOVE INV-NO-CHECK-INDIC  TO  DE1-NO-CHECK-INDIC.

           INITIALIZE BUF-DPORECD.
           MOVE INV-PO-RCV-NO TO PORCVNO OF DPORECD-I-REC.
           READ DPORECD-I INTO BUF-DPORECD
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           MOVE HIGH-VALUES TO PORCVNO OF DPORECD-I-REC.
           START DPORECD-I KEY > PORCVNO OF DPORECD-I-REC
              INVALID KEY MOVE "00" TO FILE-STATUS.

           IF INV-CURR-CODE NOT = SPACES
               MOVE INV-CURR-CODE             TO  BUILD-CC-VALUE
                                                  DE1-CUR-CODE
           ELSE
               MOVE PO-CURRENCY-CODE          TO  BUILD-CC-VALUE
                                                  DE1-CUR-CODE.

           MOVE BUILD-CC-KEY TO VALIDUM OF MVALIDUM-I-REC.
           IF BUILD-CC-VALUE NOT = SPACES
               READ MVALIDUM-I INTO BUF-MVALIDUM
                   INVALID KEY MOVE FILE-STATUS TO FILE-STATUS
               END-READ
               IF FILE-STATUS NOT = "00"
                   MOVE "** ERROR **"         TO  DE1-CUR-DESC
               END-IF
               MOVE  VALID-CURRENCY-DESC      TO  DE1-CUR-DESC.

025500
025600 6-FILLBUFF1-CONT.
025700     MOVE HEADER  TO  VIEW-NFNAME.
027900 6-SHOWFORM1.
      *    MOVE 3           TO  SRF-MODE.
           MOVE DE-BUFFER1  TO  DISPLAY-REC.
           PERFORM 998-WRITE-SCREEN THRU 998-READ-SCREEN.
           MOVE DISPLAY-REC TO  DE-BUFFER1.
030600     IF VIEW-LASTKEY = 3
030700         GO TO  6-HOLD-INVOICE-X
030800     ELSE
030900     IF VIEW-LASTKEY = 1  OR
031000        VIEW-LASTKEY = 2  OR
031100        VIEW-LASTKEY = 4  OR
031200        VIEW-LASTKEY = 5  OR
031300        VIEW-LASTKEY = 6  OR
031400        VIEW-LASTKEY = 7  OR
              VIEW-LASTKEY = 8
031500*        ***  INVALID FUNCTION KEY ENTERED  ***
031600         MOVE   9 TO LANG-SETNUM
031700         MOVE  10 TO LANG-MSGNUM
031800         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER TO DE1-MSG-LINE
               MOVE B"1" TO IND(99)
032000         GO TO  6-SHOWFORM1.
032100
032200 6-PROCESS-INVOICE.
032300     CALL "TINVBACK" USING BASE,
032400                           ARGUMENT-VALUES,
032500                           BUF-DINVRCD.
032600
032700
032800 6-HOLD-INVOICE-X.
032900     EXIT.
033000
033100
033200 61-GET-TERMS-DESC.
033300     MOVE INV-DUE-PCT           TO  BUILD-TM-DISCOUNT-VALUE.
033400     MOVE BUILD-TM-DISCOUNT-KEY TO  PLT-ARG.
           MOVE 0 TO COND-WORD.
           MOVE PLT-ARG TO PLTINFOKEY OF MPLTINFO-I-REC.
           READ MPLTINFO-I INTO BUF-MPLTINFO
               INVALID KEY MOVE 17 TO COND-WORD.
           IF FILE-STATUS-1 = "2"
               MOVE 17 TO COND-WORD
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD.
033500*    CALL "DBGET" USING BASE, DSET-MPLTINFO, MODE7,
033600*        STATUS-AREA, ALL-ITEMS, BUF-MPLTINFO, PLT-ARG.
033700     IF COND-WORD NOT = 0
033800         IF COND-WORD = 17
033900             NEXT SENTENCE
034000         ELSE
034100             MOVE "GET MPLTINFO1 * 61-GTD" TO BU-DISPLAY-MSG
034200             MOVE PLT-ARG  TO  BU-DISPLAY-FLD (4)
034300             GO TO 2-BLOWUP
034400     ELSE
034500         MOVE MPLTINFO-DISC-AMNT-DESC TO DE1-PO-TERMS-PERCENT.
034600
034700     MOVE INV-DUE-CODE          TO  BUILD-TM-DATE-VALUE.
034800     MOVE BUILD-TM-DUE-DATE-KEY TO  PLT-ARG.
           MOVE PLT-ARG TO PLTINFOKEY OF MPLTINFO-I-REC.
           READ MPLTINFO-I INTO BUF-MPLTINFO
               INVALID KEY MOVE 17 TO COND-WORD.
           IF FILE-STATUS-1 = "2"
               MOVE 17 TO COND-WORD
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD.
034900*    CALL "DBGET" USING BASE, DSET-MPLTINFO, MODE7,
035000*        STATUS-AREA, ALL-ITEMS, BUF-MPLTINFO, PLT-ARG.
035100     IF COND-WORD NOT = 0
035200         IF COND-WORD = 17
035300             NEXT SENTENCE
035400         ELSE
035500             MOVE "GET MPLTINFO2 * 61-GPT" TO BU-DISPLAY-MSG
035600             MOVE PLT-ARG  TO  BU-DISPLAY-FLD (4)
035700             GO TO 2-BLOWUP
035800     ELSE
035900         MOVE MPLTINFO-TMD-DESC       TO DE1-PO-TERMS-DUE.
036000
036100 61-GTD-X.
036200     EXIT.
036300
036400 COPY DISPCALL IN COPYLIB.
043100 999-CATREAD.
           IF CATREAD-MSG-NUMBER = ZEROS
               MOVE LANG-SETNUM TO CATREAD-MSG-SET
               MOVE LANG-MSGNUM TO CATREAD-MSG-NUM.
           CALL "CCATREAD" USING CATREAD-PARMS.
           MOVE CATREAD-MSG-TEXT TO MESSAGE-BUFFER.
044700 999-CATREAD-EXIT.
044800     EXIT.
