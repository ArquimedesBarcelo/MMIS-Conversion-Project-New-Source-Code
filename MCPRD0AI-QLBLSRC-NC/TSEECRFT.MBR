000200 IDENTIFICATION DIVISION.
000300 PROGRAM-ID.         TSEECRFT.
000400 INSTALLATION.  GOODYEAR TIRE & RUBBER CO.
000500*REMARKS.   THIS PROGRAM DISPLAYS THE CURRENT OR
000600*       LAST WORK ORDER THAT A CRAFTSMAN CALLED IN ON.
      *C
      *C  09/12/1996        CA YODER
      *C    RE-COMPILED PROGRAM TO PICK UP CENTURY DATABASE CHANGES.
      *C
      *C    ALSO, ERROR MESSAGES WERE NOT BEING DISPLAYED ON SCREEN
      *C    BECAUSE THE MESSAGE WAS EITHER OVERWRITEN WITH SPACES
      *C    OR NEVER MOVED TO THE OUTPUT LINE.  ADDITIONALLY, IF
      *C    A CC# DIDN'T HAVE A "LAST WO WORKED", A WO # WAS BEING
      *C    MOVED IN THE FIELD ANYWAYS (BECAUSE OF "READ PRIOR").
      *C    BOTH OF THESE PROBLEMS WERE CORRECTED.
      *C
000700 ENVIRONMENT DIVISION.
000800 CONFIGURATION SECTION.
000900 SOURCE-COMPUTER.    AS400.
001000 OBJECT-COMPUTER.    AS400.
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT DISPLAY-FILE
               ASSIGN TO WORKSTATION-ZOFFLINE-SI
               ORGANIZATION IS TRANSACTION
               FILE STATUS IS DSPLY-STATUS
               CONTROL-AREA IS WS-CONTROL.
           SELECT LABOR-CURR-STAT-FILE
               ASSIGN TO DATABASE-MCFLMM1602
               ORGANIZATION IS INDEXED
               ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
               FILE STATUS IS LCSF-STATUS.
           SELECT PERSONNEL-FILE
               ASSIGN TO DATABASE-MCFLMM0301
               ORGANIZATION IS INDEXED
               ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
               FILE STATUS IS PF-STATUS.
           SELECT WO-LABOR-FILE
               ASSIGN TO DATABASE-MCFLMM1302
               ORGANIZATION IS INDEXED
               ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY WITH DUPLICATES
               FILE STATUS IS WLF-STATUS.
           SELECT WO-LAST-NUM-USED
               ASSIGN TO DATABASE-MCFPMM0800
               ORGANIZATION IS RELATIVE
               ACCESS MODE IS RANDOM
               RELATIVE KEY IS ARG-NO
               FILE STATUS IS WLNU-STATUS.
001100 DATA DIVISION.
       FILE SECTION.
       FD  DISPLAY-FILE
           LABEL RECORDS ARE OMITTED.
       01  DSPLY-REC                   PIC X(2000).
       FD  LABOR-CURR-STAT-FILE
           LABEL RECORDS ARE STANDARD
           DATA RECORD IS LCSFREC.
       01  LCSFREC.
           COPY DDS-ALL-FORMATS OF MCFLMM1602.
       FD  PERSONNEL-FILE
           LABEL RECORDS ARE STANDARD
           DATA RECORD IS PFREC.
       01  PFREC.
           COPY DDS-ALL-FORMATS OF MCFLMM0301.
       FD  WO-LABOR-FILE
           LABEL RECORDS ARE STANDARD
           DATA RECORD IS WLFREC.
       01  WLFREC.
           COPY DDS-ALL-FORMATS OF MCFLMM1302.
       FD  WO-LAST-NUM-USED
           LABEL RECORDS ARE STANDARD
           DATA RECORD IS WLNUREC.
       01  WLNUREC.
           COPY DDS-ALL-FORMATS OF MCFPMM0800.
001200 WORKING-STORAGE SECTION.
       77  CURRENT-SW               PIC 9.
001500 01  ARG-NO                   PIC 9(9).
001600 01  BUFFER-DEFINITION.
001800     05  PER-CC-NUM-B         PIC X(6).
001900     05  BD-CMD-LINE          PIC X(79).
           05  BD-MSG-LINE          PIC X(79).
       COPY CATREAD IN COPYLIB.
       COPY CPYIND  IN COPYLIB.
       COPY TDATESUB OF COPYLIB.
002100 01  DBPARAMETERS.           COPY DBPARMS OF COPYLIB.
002300 01  ERROR-BUFFER             PIC X(80).
002400 01  ERROR-LITERAL.
002500     05  FILLER               PIC X(34)
002600       VALUE "UNABLE TO FIND CRAFTSMAN'S NUMBER ".
002700     05  WO-1-10              PIC X(10) VALUE SPACES.
002800     05  FILLER               PIC X(36) VALUE SPACES.
       01  FILE-STATUSES.
           05  DSPLY-STATUS         PIC XX.
           05  LCSF-STATUS          PIC XX.
           05  PF-STATUS            PIC XX.
           05  WLF-STATUS           PIC XX.
           05  WLNU-STATUS          PIC XX.
003600 01  LABOR-CURR-STAT-BUFF.   COPY DCURRLBR OF COPYLIB.
003700 01  LABOR-CURR-STAT-TEST-AREA.
003800     05  START-TIME.
003900         10  START-YR         PIC XX.
004000         10  START-MON        PIC XX.
004100         10  START-DAY        PIC XX.
004200         10  START-HR         PIC XX.
004300         10  START-MIN        PIC XX.
004400     05  END-TIME.
004500         10  END-YR           PIC XX.
004600         10  END-MON          PIC XX.
004700         10  END-DAY          PIC XX.
004800         10  END-HR           PIC XX.
004900         10  END-MIN          PIC XX.
005100 01  LAST-WO-BUFF.           COPY MLASTWO OF COPYLIB.
005200 01  OUTPUT-BUFF.
005300     05  OUTPUT-MD            PIC XX.
005400     05  OUTPUT-DM            PIC XX.
005500     05  OUTPUT-YY            PIC XX.
005600     05  OUTPUT-HR            PIC XX.
005700     05  OUTPUT-MI            PIC XX.
005800     05  OUTPUT-CC            PIC X(4).
005900     05  OUTPUT-NAME          PIC X(16).
006000     05  OUTPUT-CRAFT         PIC XX.
006100     05  OUTPUT-ZONE          PIC X(4).
006200     05  OUTPUT-DEPT          PIC X(4).
006300     05  OUTPUT-START-WO      PIC X(10).
006400     05  OUTPUT-START-MD      PIC XX.
006500     05  OUTPUT-START-DM      PIC XX.
006600     05  OUTPUT-START-YY      PIC XX.
006700     05  OUTPUT-START-HR      PIC XX.
006800     05  OUTPUT-START-MI      PIC XX.
006900     05  OUTPUT-COMP-WO       PIC X(10).
           05  OUTPUT-CMD-LINE      PIC X(79).
           05  OUTPUT-ERR-LINE      PIC X(79).
007000 01  PASSWORD-INFORMATION.
007100     05  NAME-OF-PROGRAM     PIC X(08) VALUE "TSEECRFT".
007200     05  PROGRAM-TYPE        PIC X(02) VALUE "IN".
007300     05  PROGRAM-RELEASE     PIC X(12) VALUE " E0100010001".
007400     05  PROGRAM-DESCRIPTION.
007500         10  PROG-DESC-A.
                   15  FILLER      PIC X(17) VALUE "VIEWS CURRENT W/O".
                   15  FILLER      PIC X(17) VALUE " THAT A CRAFTSMAN".
                   15  FILLER      PIC X(15) VALUE " IS WORKING ON ".
                   15  FILLER      PIC X(11) VALUE SPACES.
007700         10  PROG-DESC-B     PIC X(60) VALUE SPACES.
007900         10  PROG-FUNCTION   PIC X(60) VALUE SPACES.
008100     05  PASSWORD-FLAG       PIC X.
008200 01  PERSONNEL-DATA.         COPY MPERSONL OF COPYLIB.
       COPY DBSTAT OF COPYLIB.
009100 01  TMP-DATE-AREA.
009200     05  TMP-DATE-MD          PIC XX.
009300     05  FILLER               PIC X.
009400     05  TMP-DATE-DM          PIC XX.
009500     05  FILLER               PIC X.
009600     05  TMP-DATE-YY          PIC XX.
009700 01  TMP-TIME-AREA.
009800     05  TTA-HRS              PIC XX.
009900     05  TTA-MIN              PIC XX.
010000     05  TTA-SEC              PIC XX.
       01  TRUE-VAL                 PIC 1 VALUE B"1".
       COPY VCOMAREA OF COPYLIB.
010200 01  WO-LABOR-DATA.          COPY DWOLABOR OF COPYLIB.
       COPY WSCONTROL IN COPYLIB.
010300 PROCEDURE DIVISION.
010400 START-PGM.
010500     PERFORM 1-HSK.
010600     PERFORM 6-MAIN THRU 6-MAIN-EXIT UNTIL VIEW-LASTKEY = 3.
010700 2-EOJ.
           CLOSE DISPLAY-FILE.
           CLOSE LABOR-CURR-STAT-FILE.
           CLOSE PERSONNEL-FILE.
           CLOSE WO-LABOR-FILE.
           CLOSE WO-LAST-NUM-USED.
011200     GOBACK.
011300****************************************************************
011400*    HOUSEKEEPING                                              *
011500****************************************************************
011700 1-HSK.
           OPEN I-O   DISPLAY-FILE.
           OPEN INPUT LABOR-CURR-STAT-FILE.
           OPEN INPUT PERSONNEL-FILE.
           OPEN INPUT WO-LABOR-FILE.
           OPEN INPUT WO-LAST-NUM-USED.
           MOVE 0 TO COND-WORD.
016400     MOVE 1 TO ARG-NO.
           READ WO-LAST-NUM-USED INTO LAST-WO-BUFF
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF WLNU-STATUS NOT = "00" MOVE 17 TO COND-WORD.
           IF COND-WORD = 17 MOVE 1 TO DATE-FLAG-SW.
016700     MOVE DATE-FLAG-SW TO DATE-FLAG.
016800     MOVE 1 TO DATE-MODE.
016900     MOVE DATE-FLAG TO DATE-CODE.
017000     CALL "TDATECHK" USING DATE-CHECK-AREA.
017100     MOVE DATE-SLASH-OUT TO TMP-DATE-AREA.
017200     ACCEPT TMP-TIME-AREA FROM TIME.
017600     CALL "TPWORD" USING PASSWORD-INFORMATION.
018000     IF PASSWORD-FLAG = "N" GO TO 2-EOJ.
021500     MOVE SPACES TO WO-LABOR-DATA LABOR-CURR-STAT-BUFF.
           MOVE SPACES TO ERROR-BUFFER.
           MOVE SPACES TO BUFFER-DEFINITION DSPLY-REC.
018200****************************************************************
018300*    MAIN LOGIC                                                *
018400****************************************************************
018500 6-MAIN.
           MOVE 0 TO CURRENT-SW.
018600     MOVE "FOFFCRFT" TO VIEW-CFNAME.
           MOVE BUFFER-DEFINITION TO DSPLY-REC.
           PERFORM 99-SCREEN-WRITE.
           PERFORM 98-SCREEN-READ.
           MOVE DSPLY-REC TO BUFFER-DEFINITION.
           MOVE SPACES TO ERROR-BUFFER.
           IF VIEW-LASTKEY = 3 GO TO 2-EOJ.
030400     MOVE SPACES TO OUTPUT-BUFF.
           MOVE 0 TO COND-WORD.
024100     MOVE PER-CC-NUM-B TO PERCCNUM OF PERSONNEL-FILE.
           START PERSONNEL-FILE KEY IS = EXTERNALLY-DESCRIBED-KEY
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF PF-STATUS NOT = "00" MOVE 17 TO COND-WORD.
024500     IF COND-WORD = 17
024600         MOVE PER-CC-NUM-B TO WO-1-10
               MOVE ERROR-LITERAL TO ERROR-BUFFER
               MOVE ERROR-BUFFER TO BD-MSG-LINE
               MOVE TRUE-VAL TO INDS (1) INDS (99)
025100         GO TO 6-MAIN.
           READ PERSONNEL-FILE NEXT INTO PERSONNEL-DATA
               AT END    MOVE 15 TO COND-WORD.
           IF PF-STATUS NOT = "00" GO TO 2-EOJ.
           MOVE 0 TO COND-WORD.
           MOVE PER-CC-NUM-B TO PERCCNUM OF LCSFREC.
           START LABOR-CURR-STAT-FILE KEY IS = EXTERNALLY-DESCRIBED-KEY
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF LCSF-STATUS NOT = "00" MOVE 17 TO COND-WORD.
025600     IF COND-WORD = 0
               NEXT SENTENCE
           ELSE
025700     PERFORM 6221-GET-LAST-LABOR-ENTRY THRU 6221-GLLE-EXIT
025800     GO TO 6-MAIN-DISPLAY.
025900     READ LABOR-CURR-STAT-FILE NEXT INTO LABOR-CURR-STAT-BUFF
026000         AT END    MOVE 15 TO COND-WORD.
           IF LCSF-STATUS NOT = "00" MOVE 15 TO COND-WORD.
026100     IF COND-WORD = 15
026200         PERFORM 6221-GET-LAST-LABOR-ENTRY THRU 6221-GLLE-EXIT
026300     ELSE
026400     MOVE 1 TO CURRENT-SW
026500     PERFORM 6221-GET-LAST-LABOR-ENTRY THRU 6221-GLLE-EXIT.
       6-MAIN-DISPLAY.
029900     MOVE "FOFFCRF2" TO VIEW-CFNAME.
031600     IF DATE-FLAG = 3
031700         MOVE TMP-DATE-MD TO OUTPUT-DM
031800         MOVE TMP-DATE-DM TO OUTPUT-MD
031900         MOVE TMP-DATE-YY TO OUTPUT-YY
032000     ELSE
032100     MOVE TMP-DATE-MD TO OUTPUT-MD
032200     MOVE TMP-DATE-DM TO OUTPUT-DM
032300     MOVE TMP-DATE-YY TO OUTPUT-YY.
032400     MOVE TTA-HRS TO OUTPUT-HR.
032500     MOVE TTA-MIN TO OUTPUT-MI.
032600     MOVE PER-CC-NUM TO OUTPUT-CC.
032700     MOVE PER-EMP-NAME TO OUTPUT-NAME.
032800     MOVE PER-CRAFT TO OUTPUT-CRAFT.
032900     MOVE PER-MAINT-ZONE TO OUTPUT-ZONE.
033000     MOVE PER-DEPT TO OUTPUT-DEPT.
033100     MOVE LCS-WO-NUM TO OUTPUT-START-WO.
033200     IF DATE-FLAG = 3
033300         MOVE C-START-YY TO OUTPUT-START-YY
033400         MOVE C-START-MM TO OUTPUT-START-DM
033500         MOVE C-START-DD TO OUTPUT-START-MD
033600     ELSE
033700     MOVE C-START-YY TO OUTPUT-START-YY
033800     MOVE C-START-MM TO OUTPUT-START-MD
033900     MOVE C-START-DD TO OUTPUT-START-DM.
034000     MOVE C-START-HH TO OUTPUT-START-HR.
034100     MOVE C-START-MM TO OUTPUT-START-MI.
034200     MOVE LBR-WO-NUM TO OUTPUT-COMP-WO.
           MOVE OUTPUT-BUFF TO DSPLY-REC.
035400     PERFORM 99-SCREEN-WRITE.
           PERFORM 98-SCREEN-READ.
           IF VIEW-LASTKEY = 3 GO TO 2-EOJ.
           MOVE SPACES TO BUFFER-DEFINITION DSPLY-REC.
           GO TO 6-MAIN.
026600 6-MAIN-EXIT.    EXIT.

026800 6221-GET-LAST-LABOR-ENTRY.
           MOVE 0 TO COND-WORD.
           MOVE PER-CC-NUM-B TO LBRCCNUM OF WLFREC.
           START WO-LABOR-FILE KEY IS > EXTERNALLY-DESCRIBED-KEY
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF WLF-STATUS NOT = "00" MOVE 17 TO COND-WORD.
027100     IF COND-WORD = 17
027200         IF CURRENT-SW = 0
027300             MOVE "THERE ARE NO ENTRIES IN DATABASE FOR CC#"
027400                 TO ERROR-BUFFER
                   MOVE ERROR-BUFFER TO OUTPUT-ERR-LINE
                   MOVE TRUE-VAL TO INDS (1) INDS (99)
027900             GO TO 6221-GLLE-EXIT.
028200     READ WO-LABOR-FILE PRIOR INTO WO-LABOR-DATA
028300         AT END    MOVE 15 TO COND-WORD.
           IF PER-CC-NUM-B NOT = LBRCCNUM OF WLFREC
               MOVE 15 TO COND-WORD.
           IF WLF-STATUS NOT = "00" MOVE 15 TO COND-WORD.
028400     IF COND-WORD = 15
028500         IF CURRENT-SW = 0
028600             MOVE "THERE ARE NO ENTRIES IN DATABASE FOR CC#"
028700                 TO ERROR-BUFFER
                   MOVE ERROR-BUFFER TO OUTPUT-ERR-LINE
                   MOVE TRUE-VAL TO INDS (1) INDS (99)
                   MOVE SPACES TO WO-LABOR-DATA
                   GO TO 6221-GLLE-EXIT.
       6221-GLLE-EXIT.    EXIT.

       98-SCREEN-READ.
           READ DISPLAY-FILE INDIC IS INDICS
               MOVE FUNCTION-NUM TO VIEW-LASTKEY
               MOVE ALL B"0" TO INDICS.
       99-SCREEN-WRITE.
           WRITE DSPLY-REC FORMAT IS VIEW-CFNAME
               INDIC IS INDICS.

       999-CATREAD.
           MOVE SPACES TO ERROR-BUFFER.
           CALL "CCATREAD" USING CATREAD-PARMS.
           MOVE CATREAD-MSG-TEXT TO ERROR-BUFFER.
       999-CATREAD-EXIT.    EXIT.
