052000        MOVE "ZCSISINQ"              TO VIEW-CFNAME
052500        CALL "SVENINQS" USING BASE,
052600                              PASS-SPOOL,
052610                              FORMFILE
052700                              VIEW-COMAREA,
052800                              LANGUAGE-PARMS
053000        MOVE "ZUDCQUOT"              TO VIEW-CFNAME
053100        GO TO 200-QUOT-MENU-SCREEN.
053200
053300     IF SCREEN-KEY = "Q8  "
              MOVE SPACES         TO INQ-CC-INPUT
              MOVE "Y"            TO INQ-INQ-FLAG
              MOVE USERNAME TO USERID OF MEMPL-REC
              READ MEMPL INTO BUF-MEMPL
                  INVALID KEY     MOVE MEMPL-STATUS TO MEMPL-STATUS
              END-READ
              IF MEMPL-STATUS = "00"
                  IF MEMPL-INQUIRE-CAP = "Y"
                      NEXT SENTENCE
                  ELSE
                  MOVE MEMPL-EMPL TO INQ-CC-INPUT
                  MOVE "N"        TO INQ-INQ-FLAG
              END-IF
053500        MOVE "ZCSISINQ"     TO VIEW-CFNAME
