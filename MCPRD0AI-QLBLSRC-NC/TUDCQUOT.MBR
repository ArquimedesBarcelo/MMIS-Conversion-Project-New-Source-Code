001100 IDENTIFICATION DIVISION.
001200 PROGRAM-ID.    TUDCQUOT.
001300 AUTHOR.        BARBARA WINTER.
001400*INSTALLATION.  GOODYEAR.
001500 DATE-WRITTEN.  JANUARY 1986.
001600 DATE-COMPILED.
001700*REMARKS.
001900*D   MENU PROGRAM FOR QUOTE SCREEN
002000*************************************************************
002100*************************************************************
002200***                     T U D C Q U O T                   ***
002300***                                                       ***
002400***       THIS PROGRAM DISPLAYS THE MENU FOR QUOTE USERS  ***
002500***      AT SIGN ON TIME.  ANY PROGRAM THE USER CAN       ***
002600***      EXECUTE IS CALLED FROM THIS PROGRAM.  ALL OTHER  ***
002700***      PROGRAMS HAVE BEEN CONVERTED INTO SUBROUTINES    ***
002800***      SO THAT THIS PROGRAM CAN CALL ALL OF THEM        ***
002900***      WITHOUT HAVING THE USER GET OUT OF THIS PROGRAM. ***
004600*************************************************************
004700*************************************************************
      *C     5/31/94  MARVIN MITCHELL REQUEST #94-017
      *C     ADDED TWO MORE PRINTER OPTIONS FOR PRINTING QUOTES.
      *C     ADDED LOGIC TO SEND THE PRINTER DEFINITIONS TO
      *C     THE CREATE, REPRINT AND SYS GEN PROGRAMS.
      *C
      *C     8/08/94  MARVIN MITCHELL
      *C     CHANGED ALL REFERENCES OF COPMMIS AND COPYCSIS TO COPYLIB.
      *C
      *C     5/23/01  JE COFFMAN
      *C     ADDED LOGIC TO PREVENT USERS FROM SEEING SENSITIVE
      *C     REQ DATA AT NAPANEE'S REQUEST.
      *C

004800
004900 ENVIRONMENT DIVISION.
005000 CONFIGURATION SECTION.
005100 SOURCE-COMPUTER.    HP-3000.
005200 OBJECT-COMPUTER.    HP-3000.
005500
       SPECIAL-NAMES.  I-O-FEEDBACK IS I-O-FEEDBACK-AREA.
002600 INPUT-OUTPUT SECTION.
       FILE-CONTROL.

           SELECT DISPLAY-FILE
                  ASSIGN TO WORKSTATION-ZUDCQUOT-SI
                  ORGANIZATION IS TRANSACTION
                  ACCESS IS DYNAMIC
                  RELATIVE KEY IS RELATIVE-RECNO
                  FILE STATUS IS DISPLAY-STATUS
                  CONTROL-AREA IS WS-CONTROL.

           SELECT MEMPL
                  ASSIGN TO DATABASE-MCFLCS4202
                  ORGANIZATION IS INDEXED
                    ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                    WITH DUPLICATES
                  FILE STATUS IS MEMPL-STATUS.

            SELECT MPLTINFO
              ASSIGN TO DATABASE-MCFLCS0501
              ORGANIZATION IS INDEXED
                 ACCESS MODE IS DYNAMIC
              RECORD KEY IS EXTERNALLY-DESCRIBED-KEY WITH DUPLICATES
              FILE STATUS IS FILE-STATUS.
005700 DATA DIVISION.
005800 FILE SECTION.
005900
       FD  DISPLAY-FILE
           LABEL RECORDS ARE OMITTED.
       01  DISPLAY-REC          PIC X(2000).
003700
       FD  MEMPL
           LABEL RECORDS ARE STANDARD.
       01  MEMPL-REC.
           COPY DDS-MCRPCS4200  OF MCFLCS4202.

       FD  MPLTINFO
           LABEL RECORDS ARE STANDARD.
       01  MPLTINFO-REC.
           COPY DDS-MCRPCS0500  OF MCFLCS0501.
003700
006000 WORKING-STORAGE SECTION.
006100************************************************************
006200*            W O R K I N G   S T O R A G E                 *
006300************************************************************
       01  FILE-STATUS.
           05  FILE-STATUS-1      PIC X.
           05  FILE-STATUS-2      PIC X.
       01  MEMPL-STATUS.
           05  MEMPL-STATUS-1     PIC X.
           05  FILLER             PIC X.
       01  RELATIVE-RECNO         PIC 9(9).

      *------ WS CONTROL AREA
       01  MAJOR-MINOR                 PIC XXXX.
       01  WS-CONTROL.
           02  FUNCTION-NUM            PIC XX.
                   88  EXIT-KEY-F8-USED                     VALUE "08". LVW000LS
                   88  REFRESH-KEY-F4-USED                  VALUE "04". LVW000LS
                   88  ENTER-KEY-USED                       VALUE "00". LVW000LS
                   88  F1-KEY-USED                          VALUE "01". LVW000LS
                   88  F2-KEY-USED                          VALUE "02". LVW000LS
                   88  F3-KEY-USED                          VALUE "03". LVW000LS
                   88  F4-KEY-USED                          VALUE "04". LVW000LS
                   88  F5-KEY-USED                          VALUE "05". LVW000LS
                   88  F6-KEY-USED                          VALUE "06". LVW000LS
                   88  F7-KEY-USED                          VALUE "07". LVW000LS
                   88  F8-KEY-USED                          VALUE "08". LVW000LS
           02 FUN-KEY REDEFINES FUNCTION-NUM PIC XX.
           02 TERMINAL-ID PIC X(10).
           02 FORMAT-NAME PIC X(10).

       01  DISPLAY-STATUS              PIC X(2).

       01  SRF-INDICATORS.
           05  IND OCCURS 99 TIMES   PIC 1 INDICATOR 01.

       COPY IOFEEDBACK OF COPYLIB.
006400 01  PASS-SPOOL                PIC S9(2)  VALUE ZERO COMP-4.
MM525E 01  PASS-QUOTE-PRT.
MM525E     05  PASS-QUOTE-PRT-01     PIC  9(2)  VALUE ZERO COMP-4.
MM525E     05  PASS-QUOTE-PRT-02     PIC  9(2)  VALUE ZERO COMP-4.
MM525E     05  PASS-QUOTE-PRT-LP     PIC  9(2)  VALUE ZERO COMP-4.
006600 01  PASS-RPT-NUMBER           PIC S9(4)  VALUE ZERO COMP-4.
006700 01  REQ-PLANT.
006800     05  REQ-PLANT-CODE       PIC X(3)    VALUE SPACES.
006900     05  FILLER               PIC X       VALUE SPACES.
