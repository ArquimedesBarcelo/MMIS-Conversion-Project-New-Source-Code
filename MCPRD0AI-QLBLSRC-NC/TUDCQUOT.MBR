           05  CURRLIB                             PIC X(10).
           05  JOBLIBX                             PIC X.

020500**************************************************************
020600*                                                            *
020700*        P R O C E D U R E        D I V I S I O N            *
020800*                                                            *
020900**************************************************************
021000 PROCEDURE DIVISION.
021100 00-CONTROL SECTION 00.
021200 00-RCVEXEC-MAIN.
021300     PERFORM 100-OPEN-ALL THRU 109-EXIT.
021400
021500     PERFORM 130-INITIALIZATION THRU 139-EXIT.
021600
021700     PERFORM 200-QUOT-MENU-SCREEN THRU 299-EXIT.
021800
021900     PERFORM 110-CLOSE-ALL THRU 119-EXIT.
022000
022100     GOBACK.
022200*************************************************************
022300*              O P E N   A L L   F I L E S                  *
022400*************************************************************
022500 100-OPEN-ALL.
026500     CALL "TSPLPRT" USING SP-RET-CODE, SP-AREA.
026600     IF SP-RET-CODE = "NF"
026700         MOVE "SPOOL KEY NOT FOUND * RCVEXEC" TO BU-DISPLAY-MSG
026800         PERFORM 990-BLOWUP THRU 999-EXIT
026900     ELSE
027000     IF SP-RET-CODE NOT = "00"
027100         MOVE "TSPLPRT ERROR * RCVEXEC" TO BU-DISPLAY-MSG
027200         PERFORM 990-BLOWUP THRU 999-EXIT.
027300
027400     MOVE SP-SPOOL-NO (1)          TO  PASS-SPOOL.
027500
           OPEN I-O DISPLAY-FILE.
           OPEN INPUT MEMPL.
           OPEN INPUT MPLTINFO.
           CALL "CLWHO" USING USERNAME TERMNUM CURRLIB JOBLIBX.
           MOVE 0 TO COND-WORD.
           MOVE "RQGB" TO PLTINFOKEY OF MPLTINFO-REC.
           READ MPLTINFO INTO BUF-MPLTINFO
               INVALID KEY MOVE 17 TO COND-WORD.
           IF MEMPL-STATUS-1 = "2"
               MOVE 17 TO COND-WORD
           ELSE
           IF MEMPL-STATUS NOT = "00"
               MOVE 99 TO COND-WORD.
020100     IF COND-WORD NOT = 0
020200         MOVE "DBGET ERR MPLTINFO" TO BU-DISPLAY-MSG
020300         PERFORM 990-BLOWUP THRU 999-EXIT.
           MOVE MPLTINFO-RQGB TO REQ-GLOBALS.
027600*----------  FIND QUOTE PRINTER
027700     MOVE "POPT"                          TO MPLTINFO-ARG.
           MOVE 0 TO COND-WORD.
           MOVE MPLTINFO-ARG TO PLTINFOKEY OF MPLTINFO-REC.
           READ MPLTINFO   INTO BUF-MPLTINFO INVALID KEY
                MOVE 17 TO COND-WORD.
034160     IF COND-WORD NOT = 0
034170           MOVE "DBGET MPLTINFO2 - TUDCQUOT " TO BU-DISPLAY-MSG
034180           PERFORM 990-BLOWUP THRU 999-EXIT.
028000     MOVE MPLTINFO-01-QUOTE-PRT-NO           TO PASS-QUOTE-PRT-01.
028000     MOVE MPLTINFO-02-QUOTE-PRT-NO           TO PASS-QUOTE-PRT-02.
028000     MOVE MPLTINFO-LP-QUOTE-PRT-NO           TO PASS-QUOTE-PRT-LP.
028100 109-EXIT.  EXIT.
028200***********************************************************
028300*         CLOSE ALL FILES AND INITIALIZE USER KEYS        *
028400***********************************************************
028500 110-CLOSE-ALL.
028600     CLOSE DISPLAY-FILE, MPLTINFO, MEMPL.
029000 119-EXIT.  EXIT.
029100
029600 130-INITIALIZATION.
029700*----------  FIND THE PROPER ESCAPE SEQUENCES
029800     CALL "TESCSEQ" USING ESC-NAME.
030000
030100*----------  FIND THE PLANT NUMBER AND PASS IT TO SUBROUTINES
030200     MOVE "P 01" TO MPLTINFO-ARG.
           MOVE 0 TO COND-WORD.
           MOVE MPLTINFO-ARG TO PLTINFOKEY  OF MPLTINFO-REC.
           READ MPLTINFO INTO BUF-MPLTINFO INVALID KEY
                MOVE 17 TO COND-WORD.
033300     IF COND-WORD NOT = 0
033400           MOVE "DBGET MPLTINFO - TUDCQUOT " TO BU-DISPLAY-MSG
033500           PERFORM 990-BLOWUP THRU 999-EXIT.
030800     MOVE MPLTINFO-COMPANY TO PLT-NUMBER-PASS,
030900                              REQ-PLANT-CODE,
031000                              MPLTINFO-PLANT-CODE.
031100     MOVE "PLAN" TO PLT-ARG.
           MOVE 0 TO COND-WORD.
           MOVE MPLTINFO-ARG TO PLTINFOKEY  OF MPLTINFO-REC.
           READ MPLTINFO INTO BUF-MPLTINFO INVALID KEY
                MOVE 17 TO COND-WORD.
033300     IF COND-WORD NOT = 0
031600         MOVE "GET MPLTINFO LANGUAGES ERROR IN 1-HSK"
031700             TO BU-DISPLAY-MSG
031800         MOVE "MPLTINFO-KEY= "     TO BU-DISPLAY-FLD (1)
031900         MOVE "PLAN"               TO BU-DISPLAY-FLD (2)
03350          PERFORM 990-BLOWUP THRU 999-EXIT.
032200     MOVE PRIMARY-LANGUAGE   TO MPLTINFO-DDESC-LANG.
032300     MOVE SECONDARY-LANGUAGE TO MPLTINFO-DDESC2-LANG.
032400
032500
032600 139-EXIT.  EXIT.
032700**********************************************************
032800**********************************************************
032900*             QUOTE MENU EXECUTIVE PROGRAM               *
033000*     OPEN DATABASE, TERMINAL, FILES, ETC.  DISPLAY      *
033100*     THE QUOTE MENU AND ALLOW USER TO ENTER PROGRAM     *
033200*     SELECTION.   CALL EACH SUBROUTINE THAT IS          *
033300*     REQUESTED AND RETURN CONTROL BACK TO THIS MENU.    *
033400**********************************************************
033500**********************************************************
033600  200-QUOT-MENU-SCREEN.
033700     MOVE "QUOTE_MENU" TO VIEW-NFNAME.
           MOVE SPACES TO SCREEN-BUFFER.
034000 250-SHOW-FORM.
           MOVE SCREEN-BUFFER TO DISPLAY-REC.
           WRITE DISPLAY-REC FORMAT IS VIEW-NFNAME
              INDIC ARE SRF-INDICATORS.
           MOVE ALL B"0" TO SRF-INDICATORS.

           READ  DISPLAY-FILE FORMAT IS VIEW-NFNAME
               INDIC ARE SRF-INDICATORS.
           ACCEPT IOFEEDBACK FROM I-O-FEEDBACK-AREA.
           MOVE ALL B"0" TO SRF-INDICATORS.
           MOVE DISPLAY-REC TO SCREEN-BUFFER.

      *------ A BAD STATUS MAY MEAN USER TURNED OFF TERMINAL.
      *------ IF SO, SIMULATE THE F3 KEY TO EXIT PROGRAM.
           IF DISPLAY-STATUS NOT = "00"
               MOVE 3 TO VIEW-LASTKEY
           ELSE
               MOVE FUNCTION-NUM TO VIEW-LASTKEY.
035800
035900     IF VIEW-LASTKEY EQUAL 3
036000        GO TO 299-EXIT.
036100
036200     IF VIEW-LASTKEY EQUAL 1 OR
036300        VIEW-LASTKEY EQUAL 2 OR
036400        VIEW-LASTKEY EQUAL 8 OR
036500        VIEW-LASTKEY EQUAL 4 OR
036600        VIEW-LASTKEY EQUAL 7 OR
036700        VIEW-LASTKEY EQUAL 6
036800        PERFORM 940-VSETERROR THRU 949-EXIT
036900        GO TO 250-SHOW-FORM.
037100*************************************************************
037200*      POSSIBLE SELECTIONS FROM MENU:                       *
037300*               VQ1-CREATE NEW QUOTE                        *
037400*               VQ2-CREATE SYSTEM-GENERATED QUOTE           *
037500*               VQ3-MODIFY/DELETE QUOTE ITEMS               *
037600*               VQ4-DELETE QUOTE                            *
037700*               VQ5-QUOTE REPRINT                           *
037800*               VQ6-MASTER VENDOR MENU                      *
037900*               VQ7-QUOTE SHEET DATA                        *
038000*               QR -QUOTE REPORT MENU                       *
038100*               Q1 -MATERIAL STATUS INQUIRY
038200*               Q2 -PO INQUIRY
038300*               Q4 -PO-RCV INQUIRY BY CODE
038400*               Q5 -PO INQUIRY BY VENDOR
038500*               Q6 -VENDOR INQUIRY
038600*               Q8 -REQUISITION INQUIRY
038700*               Q9 -CODE INQUIRY
038800*               Q10-QUOTE INQUIRY
038810*               Q12-RELEASE INQUIRY
038900*************************************************************
039000     IF SCREEN-KEY = "VQ1 "
039100        CALL "SQTCREAT" USING BASE,
039200                              VIEW-COMAREA,
039300                              FORMFILE
039400                              LANGUAGE-PARMS,
039500                              PASS-SPOOL,
039600                              PASS-QUOTE-PRT
