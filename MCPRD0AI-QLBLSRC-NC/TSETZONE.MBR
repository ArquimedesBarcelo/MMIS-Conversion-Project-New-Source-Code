       IDENTIFICATION DIVISION.
       PROGRAM-ID.             TSETZONE.
       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.
       SOURCE-COMPUTER.        IBM-AS400.
       OBJECT-COMPUTER.        IBM-AS400.

       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT ZONE-FILE
                  ASSIGN       TO DATABASE-MCFPMMZONF
                  ORGANIZATION IS RELATIVE
                  ACCESS MODE  IS RANDOM
                  RELATIVE KEY IS ARG-NO
                  FILE STATUS  IS FILE-STAT.

           SELECT WO-LAST-NUM-USED
                  ASSIGN       TO DATABASE-MCFPMM0800
                  ORGANIZATION IS RELATIVE
                  ACCESS MODE  IS RANDOM
                  RELATIVE KEY IS ARG-NO
                  FILE STATUS  IS FILE-STAT.

           SELECT WO-ZONE-PRTY
                  ASSIGN       TO DATABASE-MCFLMM0501
                  ORGANIZATION IS INDEXED
                  ACCESS MODE  IS DYNAMIC
                  RECORD KEY   IS EXTERNALLY-DESCRIBED-KEY
                  FILE STATUS  IS FILE-STAT.

           SELECT DISPLAY-FILE
                  ASSIGN       TO WORKSTATION-ZOFFLINE-SI
                  ORGANIZATION IS TRANSACTION
                  ACCESS MODE  IS SEQUENTIAL
                  FILE STATUS  IS SCREEN-STATUS
                               MAJOR-MINOR
                  CONTROL-AREA IS SCREEN-CONTROL.

       DATA DIVISION.
       FILE SECTION.
       FD  ZONE-FILE
           RECORD CONTAINS     34 CHARACTERS
           LABEL RECORDS       ARE OMITTED
           DATA RECORD         IS ZONF-REC.
       01  ZONF-REC.
           COPY DDS-ALL-FORMATS OF MCFPMMZONF.

       FD  WO-LAST-NUM-USED
           LABEL RECORDS       ARE STANDARD.
       01  WO-LAST-NUM-USED-REC.
           COPY DDS-ALL-FORMATS OF MCFPMM0800.

       FD  WO-ZONE-PRTY
           LABEL RECORDS       ARE STANDARD.
       01  CR-REC.
           COPY DDS-ALL-FORMATS OF MCFLMM0501.

       FD  DISPLAY-FILE
           LABEL RECORDS       ARE OMITTED.
       01  DISPLAY-REC         PIC X(2000).

       WORKING-STORAGE SECTION.
       77  ARG-NO              PIC 9(9).
       77  BLOWUP-BASE         PIC X(16).
       77  TRUE-VAL            PIC 1 VALUE B"1".

       01  FILE-STAT.
           05  FILE-STAT-1     PIC X VALUE "0".
           05  FILE-STAT-2     PIC X VALUE "0".

       01  ZONF-DATA.
           05  ZONEIN          PIC X(04).
           05  STARTIN.
               10  SIN.
                   15  SINCC   PIC X(02).
                   15  SINYY   PIC X(02).
                   15  SINMM   PIC X(02).
                   15  SINDD   PIC X(02).
               10  SINTIME     PIC X(04).
           05  ENDIN.
              10  EIN.
                  15  EINCC    PIC X(02).
                  15  EINYY    PIC X(02).
                  15  EINMM    PIC X(02).
                  15  EINDD    PIC X(02).
              10  EINTIME      PIC X(04).
           05  CRAFTSIN        PIC X(06).

       01  SCREEN-DATA.
           05  ZONFI           PIC X(04).
           05  START-DATE-TIME.
               10  S-DATE.
                   15  SD-MM   PIC X(02).
                   15  SD-DD   PIC X(02).
                   15  SD-YY   PIC X(02).
               10  S-TIME.
                   15  SD-HH   PIC X(02).
                   15  SD-MN   PIC X(02).
           05  S-MSG           PIC X(16).
           05  END-DATE-TIME.
               10  E-DATE.
                   15  ED-MM   PIC X(02).
                   15  ED-DD   PIC X(02).
                   15  ED-YY   PIC X(02).
               10  E-TIME.
                   15  ED-HH   PIC X(02).
                   15  ED-MN   PIC X(02).
           05  E-MSG           PIC X(16).
           05  CRAFTS.
               10  CFT1        PIC XX.
               10  CFT2        PIC XX.
               10  CFT3        PIC XX.
           05  CMDMSG          PIC X(79).
           05  ERRMSG          PIC X(79).

       01  COMP-DATES.
           05  CS-DATE.
               10  CSCC        PIC XX.
               10  CSYY        PIC XX.
               10  CSMM        PIC XX.
               10  CSDD        PIC XX.
           05  CE-DATE.
               10  CECC        PIC XX.
               10  CEYY        PIC XX.
               10  CEMM        PIC XX.
               10  CEDD        PIC XX.

       01  TODAYS-DATE.
           05  DH-CC           PIC 99.
           05  DATE-HOLD.
               10  DH-YY       PIC 99.
               10  DH-MM       PIC 99.
               10  DH-DD       PIC 99.

       01  TIME-BUFF.
           05  TIME-HM.
               10  TIME-HRS    PIC 99 VALUE ZEROS.
               10  TIME-MINS   PIC 99 VALUE ZEROS.
           05  TIME-SECS.
               10  NUM1        PIC 9 VALUE ZEROS.
               10  NUM2        PIC 9 VALUE ZEROS.
           05  FILLER          PIC 99.

       01  ZONE-ARGUMENT.
           05  Z-ARG           PIC X(4).
           05  FILLER          PIC XX   VALUE "1 ".

       01  DB-ERROR.
           05  DB-FUNC         PIC X(10) VALUE SPACES.
           05  DB-FILE         PIC X(18) VALUE SPACES.
           05  FILLER          PIC X(20) VALUE "ERROR - FILE-STAT = ".
           05  CON-WORD        PIC XX.

       01  LAST-WO-USED-DATA.
           COPY MLASTWO        IN COPYLIB.

           COPY ERRORLIN       IN COPYLIB.

           COPY CATREAD        IN COPYLIB.

           COPY SCREENIO       IN COPYLIB.

           COPY JCWAREA        IN COPYLIB.

           COPY DBSTAT         IN COPYLIB.

           COPY TBLOWUP        IN COPYLIB.

           COPY VCOMAREA       IN COPYLIB.

       PROCEDURE DIVISION.
       START-PGM.
           OPEN I-O            DISPLAY-FILE.
           OPEN I-O            ZONE-FILE.
           OPEN INPUT          WO-ZONE-PRTY.

           OPEN INPUT          WO-LAST-NUM-USED.
           MOVE SPACES         TO LAST-WO-USED-DATA.
           MOVE 1              TO DATE-FLAG-SW ARG-NO.
           READ WO-LAST-NUM-USED INTO LAST-WO-USED-DATA
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT
               MOVE 1          TO DATE-FLAG-SW.
           CLOSE               WO-LAST-NUM-USED.

           READ ZONE-FILE      INTO ZONF-DATA
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
               GO TO END-OF-JOB.

           MOVE "FSETZONE"     TO SCREEN-NAME.
           MOVE SPACES         TO SCREEN-DATA.

           ACCEPT DATE-HOLD    FROM DATE.
           MOVE 20             TO DH-CC.
           IF DH-YY > 70
               MOVE 19         TO DH-CC.
           ACCEPT TIME-BUFF    FROM TIME.

           MOVE "(MM/DD/YY HR:MN)" TO S-MSG E-MSG.
           IF DATE-FLAG-SW = 3
               MOVE "(DD/MM/YY HR:MN)" TO S-MSG E-MSG.

       MAIN.
           IF START-DATE-TIME = SPACES
               MOVE "XXXXXXXXXX" TO START-DATE-TIME.

           IF END-DATE-TIME = SPACES
               MOVE "XXXXXXXXXX" TO END-DATE-TIME.

           MOVE "00"           TO SCREEN-STATUS.
           MOVE SCREEN-DATA    TO DISPLAY-REC.

           WRITE DISPLAY-REC   FORMAT IS SCREEN-NAME
                               INDIC ARE SCREEN-INDICATORS.
           IF SCREEN-STATUS NOT = "00"
               DISPLAY "SCREEN WRITE ERROR.  SCREEN-STATUS IS "
                               SCREEN-STATUS
               GO TO END-OF-JOB.

           READ  DISPLAY-FILE  FORMAT IS SCREEN-NAME
                               INDIC ARE SCREEN-INDICATORS
           IF SCREEN-STATUS NOT = "00"
               DISPLAY "SCREEN READ ERROR.  SCREEN-STATUS IS "
                               SCREEN-STATUS
               GO TO END-OF-JOB.

           MOVE ALL B"0"       TO SCREEN-INDICATORS.
           MOVE DISPLAY-REC    TO SCREEN-DATA.

           IF KEY-HIT = 3      GO TO END-OF-JOB.

           IF START-DATE-TIME = "XXXXXXXXXX"
               MOVE SPACES     TO START-DATE-TIME.

           IF END-DATE-TIME = "XXXXXXXXXX"
               MOVE SPACES     TO END-DATE-TIME.

       EDIT-ZONE-FIELD.
           IF ZONFI = SPACES
      ******************************************************************
      **    MESSAGE 052/001:
      **  ZONE IS REQUIRED
      ******************************************************************
               MOVE  52        TO CATREAD-MSG-SET
               MOVE   1        TO CATREAD-MSG-NUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER TO ERRMSG
               MOVE 1          TO FIELD-NUMBER
               MOVE TRUE-VAL   TO IND(FIELD-NUMBER) IND(99)
               GO TO MAIN.

           IF ZONFI = "AL  " OR " AL " OR "  AL" OR " ALL"
               MOVE "ALL " TO ZONFI.

           IF ZONFI = "ALL "
               GO TO EDIT-START-DATE.

           MOVE ZONFI          TO Z-ARG.
           MOVE ZONE-ARGUMENT  TO ZONEPRTY OF WO-ZONE-PRTY.
           START WO-ZONE-PRTY  KEY = EXTERNALLY-DESCRIBED-KEY
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
      **********************************************************************
      **    MESSAGE 035/044:
      ** INVALID ZONE
      **********************************************************************
               MOVE  35        TO CATREAD-MSG-SET
               MOVE  44        TO CATREAD-MSG-NUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER TO ERRMSG
               MOVE 1          TO FIELD-NUMBER
               MOVE TRUE-VAL   TO IND(FIELD-NUMBER) IND(99)
               GO TO MAIN.

       EDIT-START-DATE.
           IF START-DATE-TIME = SPACES
               GO TO EDIT-END-DATE.

           IF START-DATE-TIME NOT NUMERIC
      ******************************************************************
      **    MESSAGE 035/013:
      **  INVALID START DATE OR TIME
      ******************************************************************
               MOVE  35        TO CATREAD-MSG-SET
               MOVE  13        TO CATREAD-MSG-NUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER TO ERRMSG
               MOVE 2          TO FIELD-NUMBER
               MOVE TRUE-VAL   TO IND(FIELD-NUMBER) IND(99)
               GO TO MAIN.

           IF DATE-FLAG-SW = 1
               IF SD-MM > "00" AND < "13"
                   IF SD-DD > "00" AND < "32"
                       IF SD-YY IS NUMERIC
                           IF S-TIME > "    " AND < "2400"
                               NEXT SENTENCE
                           ELSE
      ******************************************************************
      **    MESSAGE 035/015:
      **  INVALID START TIME
      ******************************************************************
                               MOVE 35015      TO CATREAD-MSG-NUMBER
                               CALL "CCATREAD" USING CATREAD-PARMS
                               MOVE CATREAD-MSG-TEXT TO ERRMSG
                               MOVE 5          TO FIELD-NUMBER
                               MOVE TRUE-VAL   TO IND(FIELD-NUMBER)
                                                  IND(99)
                               GO TO MAIN
                       ELSE
      ******************************************************************
      **    MESSAGE 035/032:
      **  INVALID YEAR
      ******************************************************************
                           MOVE 35032      TO CATREAD-MSG-NUMBER
                           CALL "CCATREAD" USING CATREAD-PARMS
                           MOVE CATREAD-MSG-TEXT TO ERRMSG
                           MOVE 4          TO FIELD-NUMBER
                           MOVE TRUE-VAL   TO IND(FIELD-NUMBER)
                                              IND(99)
                           GO TO MAIN
                   ELSE
      ******************************************************************
      **    MESSAGE 035/030:
      **  INVALID DAY
      ******************************************************************
                       MOVE 35030      TO CATREAD-MSG-NUMBER
                       CALL "CCATREAD" USING CATREAD-PARMS
                       MOVE CATREAD-MSG-TEXT TO ERRMSG
                       MOVE 3          TO FIELD-NUMBER
                       MOVE TRUE-VAL   TO IND(FIELD-NUMBER)
                                          IND(99)
                       GO TO MAIN
               ELSE
                   MOVE 35031      TO CATREAD-MSG-NUMBER
      ******************************************************************
      **    MESSAGE 035/031:
      **  INVALID MONTH
      ******************************************************************
                   CALL "CCATREAD" USING CATREAD-PARMS
                   MOVE CATREAD-MSG-TEXT TO ERRMSG
                   MOVE 2          TO FIELD-NUMBER
                   MOVE TRUE-VAL   TO IND(FIELD-NUMBER)
                                      IND(99)
                   GO TO MAIN
           ELSE
               IF SD-MM > "00" AND < "32"
                   IF SD-DD > "00" AND < "13"
                       IF SD-YY IS NUMERIC
                           IF S-TIME > "    " AND < "2400"
                               NEXT SENTENCE
                           ELSE
      ******************************************************************
      **    MESSAGE 035/015:
      **  INVALID START TIME
      ******************************************************************
                               MOVE 35015      TO CATREAD-MSG-NUMBER
                               CALL "CCATREAD" USING CATREAD-PARMS
                               MOVE CATREAD-MSG-TEXT TO ERRMSG
                               MOVE 5          TO FIELD-NUMBER
                               MOVE TRUE-VAL   TO IND(FIELD-NUMBER)
                                                  IND(99)
                               GO TO MAIN
                       ELSE
      ******************************************************************
      **    MESSAGE 035/032:
      **  INVALID YEAR
      ******************************************************************
                           MOVE 35032      TO CATREAD-MSG-NUMBER
                           CALL "CCATREAD" USING CATREAD-PARMS
                           MOVE CATREAD-MSG-TEXT TO ERRMSG
                           MOVE 4          TO FIELD-NUMBER
                           MOVE TRUE-VAL   TO IND(FIELD-NUMBER)
                                              IND(99)
                           GO TO MAIN
                   ELSE
      ******************************************************************
      **    MESSAGE 035/031:
      **  INVALID MONTH
      ******************************************************************
                       MOVE 35031      TO CATREAD-MSG-NUMBER
                       CALL "CCATREAD" USING CATREAD-PARMS
                       MOVE CATREAD-MSG-TEXT TO ERRMSG
                       MOVE 3          TO FIELD-NUMBER
                       MOVE TRUE-VAL   TO IND(FIELD-NUMBER)
                                          IND(99)
                       GO TO MAIN
               ELSE
      ******************************************************************
      **    MESSAGE 035/030:
      **  INVALID DAY
      ******************************************************************
                   MOVE 35030      TO CATREAD-MSG-NUMBER
                   CALL "CCATREAD" USING CATREAD-PARMS
                   MOVE CATREAD-MSG-TEXT TO ERRMSG
                   MOVE 2          TO FIELD-NUMBER
                   MOVE TRUE-VAL   TO IND(FIELD-NUMBER)
                                      IND(99)
                   GO TO MAIN.

           IF SD-MN > "59"
      ******************************************************************
      **    MESSAGE 035/054:
      **  INVALID MINUTE(S)
      ******************************************************************
               MOVE  35        TO CATREAD-MSG-SET
               MOVE  54        TO CATREAD-MSG-NUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER TO ERRMSG
               MOVE 6          TO FIELD-NUMBER
               MOVE TRUE-VAL   TO IND(FIELD-NUMBER) IND(99)
               GO TO MAIN.

           MOVE SD-YY          TO CSYY.
           MOVE SD-MM          TO CSMM.
           MOVE SD-DD          TO CSDD.
           MOVE 20             TO CSCC.
           IF CSYY > 70
               MOVE 19         TO CSCC.
           IF DATE-FLAG-SW = 3
               MOVE SD-DD      TO CSMM
               MOVE SD-MM      TO CSDD.

           IF CS-DATE > TODAYS-DATE
      ******************************************************************
      **    MESSAGE 030/023:
      **  DATE IS GREATER THAN CURRENT DATE
      ******************************************************************
               MOVE  30        TO CATREAD-MSG-SET
               MOVE  23        TO CATREAD-MSG-NUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER TO ERRMSG
               MOVE 2          TO FIELD-NUMBER
               MOVE TRUE-VAL   TO IND(FIELD-NUMBER) IND(99)
               GO TO MAIN.

           IF CS-DATE = TODAYS-DATE AND
               S-TIME > TIME-HM
      ******************************************************************
      **    MESSAGE 046/015:
      **  DATE IS GREATER THAN CURRENT DATE
      ******************************************************************
               MOVE  46        TO CATREAD-MSG-SET
               MOVE  15        TO CATREAD-MSG-NUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER TO ERRMSG
               MOVE 5          TO FIELD-NUMBER
               MOVE TRUE-VAL   TO IND(FIELD-NUMBER) IND(99)
               GO TO MAIN.

       EDIT-END-DATE.
           IF END-DATE-TIME = SPACES
               GO TO WRITE-RECORD.

           IF END-DATE-TIME NOT NUMERIC
      ******************************************************************
      **    MESSAGE 035/013:
      **  INVALID START DATE OR TIME
      ******************************************************************
               MOVE  35        TO CATREAD-MSG-SET
               MOVE  13        TO CATREAD-MSG-NUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER TO ERRMSG
               MOVE 8          TO FIELD-NUMBER
               MOVE TRUE-VAL   TO IND(FIELD-NUMBER) IND(99)
               GO TO MAIN.

           IF DATE-FLAG-SW = 1
               IF ED-MM > "00" AND < "13"
                   IF ED-DD > "00" AND < "32"
                       IF ED-YY IS NUMERIC
                           IF E-TIME > "    " AND < "2400"
                               NEXT SENTENCE
                           ELSE
      ******************************************************************
      **    MESSAGE 035/015:
      **  INVALID START TIME
      ******************************************************************
                               MOVE 35015      TO CATREAD-MSG-NUMBER
                               CALL "CCATREAD" USING CATREAD-PARMS
                               MOVE CATREAD-MSG-TEXT TO ERRMSG
                               MOVE 11         TO FIELD-NUMBER
                               MOVE TRUE-VAL   TO IND(FIELD-NUMBER)
                                                  IND(99)
                               GO TO MAIN
                       ELSE
      ******************************************************************
      **    MESSAGE 035/032:
      **  INVALID YEAR
      ******************************************************************
                           MOVE 35032      TO CATREAD-MSG-NUMBER
                           CALL "CCATREAD" USING CATREAD-PARMS
                           MOVE CATREAD-MSG-TEXT TO ERRMSG
                           MOVE 10         TO FIELD-NUMBER
                           MOVE TRUE-VAL   TO IND(FIELD-NUMBER)
                                              IND(99)
                           GO TO MAIN
                   ELSE
      ******************************************************************
      **    MESSAGE 035/030:
      **  INVALID DAY
      ******************************************************************
                       MOVE 35030      TO CATREAD-MSG-NUMBER
                       CALL "CCATREAD" USING CATREAD-PARMS
                       MOVE CATREAD-MSG-TEXT TO ERRMSG
                       MOVE 9          TO FIELD-NUMBER
                       MOVE TRUE-VAL   TO IND(FIELD-NUMBER)
                                          IND(99)
                       GO TO MAIN
               ELSE
      ******************************************************************
      **    MESSAGE 035/031:
      **  INVALID MONTH
      ******************************************************************
                   MOVE 35031      TO CATREAD-MSG-NUMBER
                   CALL "CCATREAD" USING CATREAD-PARMS
                   MOVE CATREAD-MSG-TEXT TO ERRMSG
                   MOVE 8          TO FIELD-NUMBER
                   MOVE TRUE-VAL   TO IND(FIELD-NUMBER)
                                      IND(99)
                   GO TO MAIN
           ELSE
               IF ED-MM > "00" AND < "32"
                   IF ED-DD > "00" AND < "13"
                       IF ED-YY IS NUMERIC
                           IF E-TIME > "    " AND < "2400"
                               NEXT SENTENCE
                           ELSE
      ******************************************************************
      **    MESSAGE 035/015:
      **  INVALID START TIME
      ******************************************************************
                               MOVE 35015      TO CATREAD-MSG-NUMBER
                               CALL "CCATREAD" USING CATREAD-PARMS
                               MOVE CATREAD-MSG-TEXT TO ERRMSG
                               MOVE 11         TO FIELD-NUMBER
                               MOVE TRUE-VAL   TO IND(FIELD-NUMBER)
                                                  IND(99)
                               GO TO MAIN
                       ELSE
      ******************************************************************
      **    MESSAGE 035/032:
      **  INVALID YEAR
      ******************************************************************
                           MOVE 35032      TO CATREAD-MSG-NUMBER
                           CALL "CCATREAD" USING CATREAD-PARMS
                           MOVE CATREAD-MSG-TEXT TO ERRMSG
                           MOVE 10         TO FIELD-NUMBER
                           MOVE TRUE-VAL   TO IND(FIELD-NUMBER)
                                              IND(99)
                           GO TO MAIN
                   ELSE
      ******************************************************************
      **    MESSAGE 035/031:
      **  INVALID MONTH
      ******************************************************************
                       MOVE 35031      TO CATREAD-MSG-NUMBER
                       CALL "CCATREAD" USING CATREAD-PARMS
                       MOVE CATREAD-MSG-TEXT TO ERRMSG
                       MOVE 9          TO FIELD-NUMBER
                       MOVE TRUE-VAL   TO IND(FIELD-NUMBER)
                                          IND(99)
                       GO TO MAIN
               ELSE
      ******************************************************************
      **    MESSAGE 035/030:
      **  INVALID DAY
      ******************************************************************
                   MOVE 35030      TO CATREAD-MSG-NUMBER
                   CALL "CCATREAD" USING CATREAD-PARMS
                   MOVE CATREAD-MSG-TEXT TO ERRMSG
                   MOVE 8          TO FIELD-NUMBER
                   MOVE TRUE-VAL   TO IND(FIELD-NUMBER)
                                      IND(99)
                   GO TO MAIN.

           IF ED-MN > "59"
      ******************************************************************
      **    MESSAGE 035/054:
      **  INVALID MINUTE(S)
      ******************************************************************
               MOVE  35        TO CATREAD-MSG-SET
               MOVE  54        TO CATREAD-MSG-NUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER TO ERRMSG
               MOVE 12         TO FIELD-NUMBER
               MOVE TRUE-VAL   TO IND(FIELD-NUMBER) IND(99)
               GO TO MAIN.

           MOVE ED-YY          TO CEYY.
           MOVE ED-MM          TO CEMM.
           MOVE ED-DD          TO CEDD.
           MOVE 20             TO CECC.
           IF CEYY > 70
               MOVE 19         TO CECC.
           IF DATE-FLAG-SW = 3
               MOVE ED-DD      TO CEMM
               MOVE ED-MM      TO CEDD.

           IF CE-DATE > TODAYS-DATE
      ******************************************************************
      **    MESSAGE 030/023:
      **  DATE IS GREATER THAN CURRENT DATE
      ******************************************************************
               MOVE  30        TO CATREAD-MSG-SET
               MOVE  23        TO CATREAD-MSG-NUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER TO ERRMSG
               MOVE 8          TO FIELD-NUMBER
               MOVE TRUE-VAL   TO IND(FIELD-NUMBER) IND(99)
               GO TO MAIN.

           IF CE-DATE = TODAYS-DATE AND
               E-TIME > TIME-HM
      ******************************************************************
      **    MESSAGE 046/015:
      **  DATE IS GREATER THAN CURRENT DATE
      ******************************************************************
               MOVE  46        TO CATREAD-MSG-SET
               MOVE  15        TO CATREAD-MSG-NUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER TO ERRMSG
               MOVE 11         TO FIELD-NUMBER
               MOVE TRUE-VAL   TO IND(FIELD-NUMBER) IND(99)
               GO TO MAIN.

       WRITE-RECORD.
           MOVE ZONFI          TO ZONEIN.
           MOVE SD-YY          TO SINYY.
           IF SINYY > "70"
               MOVE "19"       TO SINCC
           ELSE
           MOVE "20"           TO SINCC.
           MOVE SD-MM          TO SINMM.
           MOVE SD-DD          TO SINDD.
           IF DATE-FLAG-SW = 3
               MOVE SD-DD      TO SINMM
               MOVE SD-MM      TO SINDD.
           MOVE S-TIME         TO SINTIME.
           MOVE ED-YY          TO EINYY.
           IF EINYY > "70"
               MOVE "19"       TO EINCC
           ELSE
           MOVE "20"           TO EINCC.
           MOVE ED-MM          TO EINMM.
           MOVE ED-DD          TO EINDD.
           IF DATE-FLAG-SW = 3
               MOVE ED-DD      TO EINMM
               MOVE ED-MM      TO EINDD.
           MOVE E-TIME         TO EINTIME.
           MOVE CRAFTS         TO CRAFTSIN.

           REWRITE ZONF-REC    FROM ZONF-DATA
               INVALID KEY
               MOVE "REWRITE"  TO DB-FUNC
               MOVE "ZONF-REC" TO DB-FILE
               MOVE FILE-STAT  TO CON-WORD
               MOVE DB-ERROR   TO BU-DISPLAY-MSG
               PERFORM 998-BLOWUP.

       END-OF-JOB.
           CLOSE               DISPLAY-FILE.
           CLOSE               ZONE-FILE.
           CLOSE               WO-ZONE-PRTY.

           MOVE "062"          TO SETJCW-VALUE.
           MOVE 278            TO SETJCW-STARTING-POS.
           MOVE 3              TO SETJCW-LENGTH.
           CALL "SETJCW" USING SETJCW-VALUE,
                               SETJCW-STARTING-POS,
                               SETJCW-LENGTH,
                               SETJCW-STATUS.
           IF SETJCW-STATUS NOT = "00"
               MOVE "SETJCW ERROR" TO BU-DISPLAY-MSG
               PERFORM 998-BLOWUP.

           CALL "TRSCREN2".
           GOBACK.

       998-BLOWUP.
           MOVE "TSETZONE"     TO BU-PGM-NAME.
           CALL "TBLOWUP"      USING BLOWUP-BASE
                               BU-PGM-NAME
                               STATUS-AREA
                               VIEW-COMAREA
                               FILE-STAT
                               BU-DISPLAY-MSG
                               BU-DISPLAY-AREA.

       999-CATREAD.
           MOVE SPACES         TO MESSAGE-BUFFER.
           CALL "CCATREAD"     USING CATREAD-PARMS.
           MOVE CATREAD-MSG-TEXT TO MESSAGE-BUFFER.

       999-CATREAD-EXIT.       EXIT.

