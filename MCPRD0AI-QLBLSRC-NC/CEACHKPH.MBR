000200 IDENTIFICATION DIVISION.
000300 PROGRAM-ID.          CEACHKPH.
000400 AUTHOR.              C HILLES/JIM COFFMAN (MAINTAINER).
000500 DATE-WRITTEN.        11/1/88.
000600 DATE-COMPILED.
000700*INSTALLATION.        GOODYEAR TIRE AND RUBBER - AKRON.
000800*SECURITY.
000900*REMARKS.
001000*D   THIS SUBPROGRAM RETURNS A TABLE OF ALL DREQQUE ENTRIES FOR A
001100*D   REQ, AND CHECKS TO SEE IF THE APPROVAL PATH IS CORRECT, AND
001200*D   THAT THE NUMBER OF APPROVALS LEFT IS CORRECT.
      *C
      *C   05/05/94  JE COFFMAN  WRITTEN REQUEST 94-001/SLS REQ 6487
      *C     ADDED THE ABILITY TO ALLOW 'SS' STATUS REQUISITIONS
      *C     THAT HAVE THE AUTHORIZATION FLAG SET VIA MP1 TO BE
      *C     CHECKED.
      *C
      *C   08/14/96  JEFF BUNGO
      *C     EXPAND DATE FIELDS FOR YEAR 2000 COMPLIANCE.
      *C     INCLUDE CENTURY ON APPROVE DATE AND QUEUED DATE
      *C     ON THE BUFFER FOR DREQQUEUE AS WELL AS THE PARMS
      *C     PASSED INTO THIS PROGRAM.
      *C
      *C   08JUN2001  DAVE PLUM
      *C     EXPANDED SAVE-DREQQUE-TABLE FROM 12 ENTRIES TO 20 ENTRIES.
      *C     THE ACTUAL TABLE IS DEFINED IN COPYLIB MEMBER CEACHKPH.
      *C     HAD TO REVISED THE TABLE INTIALIZATION LOGIC AND "IF"
      *C     STATEMENTS USING THE VARIABLE "I".
      *C
      *C   08JUN2001  DAVE PLUM
      *C     REVERTED BACK TO THE LIMIT OF 12 TABLE ENTRIES.
      *C
001400
001500 ENVIRONMENT DIVISION.
001600 CONFIGURATION SECTION.
001700 SOURCE-COMPUTER.  HP-3000.
001800 OBJECT-COMPUTER.  HP-3000.
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT DREQQUE-RQ-I
               ASSIGN TO DATABASE-MCFLCS4401
               ORGANIZATION IS INDEXED
                 ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                 WITH DUPLICATES
               FILE STATUS IS FILE-STATUS.

           SELECT MPATH-PN-I
               ASSIGN TO DATABASE-MCFLCS3901
               ORGANIZATION IS INDEXED
                 ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
               FILE STATUS IS FILE-STATUS.

           SELECT PRINT-FILE ASSIGN TO PRINTER-MCPRT.
001900
002000 DATA DIVISION.
       FILE SECTION.
      *------ FD STATEMENT AREA FOR IBM ONLY ------*
       FD  DREQQUE-RQ-I
           LABEL RECORDS ARE STANDARD.
       01  DREQQUE-RQ-REC-I.
           COPY DDS-MCRPCS4400  OF MCFLCS4401.

       FD  MPATH-PN-I
           LABEL RECORDS ARE STANDARD.
       01  MPATH-PN-REC-I.
           COPY DDS-MCRPCS3900  OF MCFLCS3901.

       FD  PRINT-FILE
           LABEL RECORDS ARE OMITTED
           RECORD CONTAINS 132 CHARACTERS
           DATA RECORD IS PRINT-REC.
       01  PRINT-REC.
           05  PRINT-LINE                PIC X(132).

      *------ FD STATEMENT AREA FOR IBM ONLY ------*
002100 WORKING-STORAGE SECTION.
002200
       77  QUE-COUNT                     PIC 9(2)  VALUE 0.
       77  SUB                           PIC 9(4)  VALUE 0.
       77  I                             PIC 9(4)  VALUE 0.
       77  J                             PIC 9(4)  VALUE 0.
       77  APPROVALS-LEFT-COUNT          PIC 9(4)  VALUE 0.
       77  HANDLE-BLOWUP-FLAG            PIC X(1)  VALUE "N".
002800
       01  WORK-LINE                     PIC X(132) VALUE SPACES.

002900**************************************************************
003000**                                                          **
003100**            D A T A B A S E   W O R K                     **
003200**                                                          **
003300**************************************************************
       01  FILE-STATUS.
           05  FILE-STATUS-1             PIC X  VALUE "0".
           05  FILE-STATUS-2             PIC X  VALUE "0".
003400
003500 01  DSET-NAMES.
           05  DSET-NAME                 PIC X(16) VALUE SPACES.
           05  DSET-MPATH                PIC X(16) VALUE "MPATH;".
           05  DSET-DREQQUE              PIC X(16) VALUE "DREQQUE;".
           05  DSET-MREQ                 PIC X(16) VALUE "MREQ;".
           05  DSET-MLEVEL               PIC X(16) VALUE "MLEVEL;".
           05  DSET-DPATHDEF             PIC X(16) VALUE "DPATHDEF;".
004200
004300 01  MODE-AREA.
004400     05  DB-MODE                   PIC S9(4)   COMP       VALUE 0.
004500     05  MODE1                     PIC S9(4)   COMP       VALUE 1.
004600     05  MODE2                     PIC S9(4)   COMP       VALUE 2.
004700     05  MODE3                     PIC S9(4)   COMP       VALUE 3.
004800     05  MODE5                     PIC S9(4)   COMP       VALUE 5.
004900     05  MODE7                     PIC S9(4)   COMP       VALUE 7.
005000
       01  ALL-ITEMS                     PIC X(2)  VALUE "@;".
       01  LEVEL-SEARCH                  PIC X(10) VALUE "LEVEL-NUM;".
       01  LEVEL-ARG                     PIC X(2).
       01  PATH-SEARCH                   PIC X(16) VALUE "PATH-NUM;".
       01  EMPLOYEE-ARG                  PIC X(4).
005600 01  PATH-ARG.
           05  PATH-ARG-PREFIX           PIC X(1)  VALUE SPACES.
           05  PATH-ARG-NUMBER           PIC 9(3)  VALUE 0.
       01  REQ-ARG                       PIC X(12).
       01  REQ-SEARCH                    PIC X(16) VALUE "REQ-NUMBER;".
006100
006200******************************************************************
006300**                                                              **
006400**          S U B P R O G R A M   A R E A S                     **
006500**                                                              **
006600******************************************************************
       COPY CEARQPH  IN COPYLIB.
006700
006800**************************************************************
006900**                                                          **
007000**           D A T A B A S E   B U F F E R S                **
007100**                                                          **
007200**************************************************************
007300
007400 COPY MPATH      IN COPYLIB.
007500 COPY DREQQUE    IN COPYLIB.
007600
007700**************************************************************
007800**                                                          **
007900**            L I N K A G E   S E C T I O N                 **
008000**                                                          **
008100**************************************************************
008200
008300 LINKAGE SECTION.
       01  BASE                          PIC X(10).
008500 COPY DBSTAT     IN COPYLIB.
008600 COPY CEACHKPH   IN COPYLIB.
008700 COPY MREQ       IN COPYLIB.
       COPY BUMSG      IN COPYLIB.
009100
009200 PROCEDURE DIVISION USING          BASE
009300                                   STATUS-AREA,
009400                                   CHKPH-RET-CODE,
009500                                   SAVE-DREQQUE-TABLE,
009600                                   BUF-MREQ,
009700                                   BU-DISPLAY-MSG.
009800
009900 6000-MAIN.
           MOVE ZERO                     TO  CHKPH-SUB.
           MOVE SPACES                   TO  CHKPH-DISP-LINES.
           PERFORM 9999-OPENS.
010000
           MOVE "R"                      TO  RQPH-PATH-TYPE.
           MOVE REQ-SUB                  TO  RQPH-CLASS.
           MOVE REQ-SUBD                 TO  RQPH-DEPARTMENT.
           MOVE REQ-REQ-DEPT             TO  RQPH-REQ-DEPT.
           MOVE REQ-ADDTL-DATA           TO  RQPH-EXPENSE-CLASS.
           MOVE REQ-BUDGET-AMT           TO  RQPH-VALUE.
           MOVE SPACES                   TO  RQPH-WO-APPROVED.
           MOVE REQ-BUDGET-NO            TO  RQPH-BUDGET-NUMBER.
           CALL "CEARQPH" USING BASE, STATUS-AREA, RQPH-AREA,
             BU-DISPLAY-MSG.
           IF BU-DISPLAY-MSG-1 NOT = SPACES
               GO TO 6990-MAIN-X.

           MOVE ZERO TO QUE-COUNT, SUB, I, J, APPROVALS-LEFT-COUNT.
           MOVE "OK"                     TO  CHKPH-RET-CODE.
010200     IF REQ-STATUS = "SS"
               IF REQ-AUTH-CODE-FLAG = "X"
                   NEXT SENTENCE
               ELSE
010300         GO TO 6990-MAIN-X.
010400
           MOVE 0                        TO  SUB.
010600     PERFORM 7000-INIT-SRQ-TABLE 12 TIMES.
010700
           MOVE MREQ-NUMBER              TO  REQ-ARG.
           PERFORM 9999-CHAINHD-DREQQUE-RQ-I.
011400
           MOVE 0                        TO  SUB,
011600                                        APPROVALS-LEFT-COUNT.
011700
011800 6110-DREQQUE-LOOP.
           PERFORM 9999-GETNEXT-DREQQUE-RQ-I.
012100     IF END-OF-CHAIN
012200         GO TO 6200-CHECK-APPROVALS.
012700
           ADD 1                         TO  SUB.
           MOVE BUF-DREQQUE              TO  SAVE-DREQQUE-LINE (SUB).
013000
013100     IF DRQQ-APPROVE-DATE-CN = SPACES
               ADD 1                     TO  APPROVALS-LEFT-COUNT.
013300
013400     GO TO 6110-DREQQUE-LOOP.
013500
013600 6200-CHECK-APPROVALS.
           IF REQ-APPROVALS-LEFT = "  "
               MOVE ZEROES TO REQ-APPROVALS-LEFT-9
               MOVE "001"  TO REQ-PATH
           ELSE
           IF REQ-PATH = "   "
               MOVE "001"  TO REQ-PATH.
013700     IF APPROVALS-LEFT-COUNT NOT = REQ-APPROVALS-LEFT-9
               MOVE SPACES               TO  WORK-LINE
013800         STRING  MREQ-NUMBER, " DATE ", REQ-DATE, " STAT ",
013900           REQ-STATUS, " RSTAT ", REQ-RELEASE-STAT,
014000           " OLD CNT = ", REQ-APPROVALS-LEFT,
014100           " ACT CNT = ", APPROVALS-LEFT-COUNT
                 DELIMITED BY SIZE INTO WORK-LINE
               ADD 1                     TO  CHKPH-SUB
               MOVE WORK-LINE            TO  CHKPH-LINE (CHKPH-SUB)
               MOVE "BC"                 TO  CHKPH-RET-CODE
014300     ELSE
014400     IF REQ-APPROVALS-LEFT-9 = 0 AND REQ-RELEASE-STAT = "  "
               MOVE SPACES               TO  WORK-LINE
014500         STRING  "REQ ", MREQ-NUMBER, " DATE ", REQ-DATE,
014600           " STAT ", REQ-STATUS, " RSTAT ", REQ-RELEASE-STAT
014700           " SHOULD BE RELEASED" DELIMITED BY SIZE
               INTO WORK-LINE
               ADD 1                     TO  CHKPH-SUB
               MOVE WORK-LINE            TO  CHKPH-LINE (CHKPH-SUB)
               MOVE "BC"                 TO  CHKPH-RET-CODE.
014900
           MOVE "R"                      TO  PATH-ARG-PREFIX.
           MOVE REQ-PATH                 TO  PATH-ARG-NUMBER.
           PERFORM 9999-GETKEY-MPATH-PN-I.
015400     IF NO-ENTRY
               MOVE SPACES               TO  WORK-LINE
015500         STRING  "*** ERROR: FOR REQ ", MREQ-NUMBER, " PATH ",
015600           REQ-PATH, " PATH DOES NOT EXIST ***"
                 DELIMITED BY SIZE INTO WORK-LINE
               ADD 1                     TO  CHKPH-SUB
               MOVE WORK-LINE            TO  CHKPH-LINE (CHKPH-SUB)
               MOVE "BP"                 TO  CHKPH-RET-CODE
015800         GO TO 6990-MAIN-X.
016300
           MOVE 0                        TO  I.
           MOVE 1                        TO  J.
016600 6210-CHECK-LEVELS-LOOP.
           ADD 1                         TO  I.
016800     IF I > 12
016900         GO TO 6220-DISPLAY-BAD-PATH.
           ADD 1                         TO  J.
017100
017200*    IF MPATH-LEVEL (I) NUMERIC
017300*        NEXT SENTENCE
017400*    ELSE
017500*        GO TO 6210-CHECK-LEVELS-LOOP.
017600
           IF MPATH-LEVEL (I) = SPACES
               GO TO 6210-CHECK-LEVELS-LOOP.

017700*----- NOTE: SINCE THE MPATH LEVELS DO NOT INCLUDE THE 00 OR
017800*----- 98 (WO APPROVAL) LEVELS, WE HAVE TO SKIP THAT ON
017900*----- THE COMPARE.
018000     IF SRQ-EMPL-QUEUED (J) = "WOAP"
               ADD 1                     TO  J.
018200
018300     IF MPATH-LEVEL (I) = SRQ-LEVEL-NUM (J)
018400         GO TO 6210-CHECK-LEVELS-LOOP.
018500
           MOVE "BP"                     TO  CHKPH-RET-CODE.
018700
018800     GO TO 6210-CHECK-LEVELS-LOOP.
018900
019000 6220-DISPLAY-BAD-PATH.
           IF RQPH-RET-PATH-NUM NOT = REQ-PATH
               MOVE "IP"                 TO  CHKPH-RET-CODE.

019100     IF CHKPH-RET-CODE = "OK"
019200         GO TO 6990-MAIN-X.
019300
019400     IF CHKPH-RET-CODE = "BP"
               MOVE SPACES               TO  WORK-LINE
019500         STRING  "REQ ", MREQ-NUMBER, " DATE ", REQ-DATE,
019600           " STAT ", REQ-STATUS, " RSTAT ", REQ-RELEASE-STAT
019700           " HAD PATH PROBLEM" DELIMITED BY SIZE
               INTO WORK-LINE
               ADD 1                     TO  CHKPH-SUB
               MOVE WORK-LINE            TO  CHKPH-LINE (CHKPH-SUB).
019800
           MOVE SPACES                   TO  WORK-LINE.
           STRING  "ACTUAL PATH ", RQPH-RET-PATH-NUM,
            "   REQ'S PATH  ", REQ-PATH,
020000      "  APP LEFT ", REQ-APPROVALS-LEFT-9 DELIMITED BY SIZE
            INTO WORK-LINE
           ADD 1                         TO  CHKPH-SUB.
           MOVE WORK-LINE                TO  CHKPH-LINE (CHKPH-SUB).
           MOVE 0                        TO  I.
020200 6230-DISPLAY-BAD-PATH-LOOP.
           ADD 1                         TO  I.
020400     IF I > 12
               MOVE SPACES               TO  PRINT-REC
               ADD 1                     TO  CHKPH-SUB
               MOVE WORK-LINE            TO  CHKPH-LINE (CHKPH-SUB)
020600         GO TO 6990-MAIN-X.
020700
020800*    IF (MPATH-LEVEL (I) NOT NUMERIC) AND
020900*      (SRQ-LEVEL-NUM (I) NOT NUMERIC)
021000*        GO TO 6230-DISPLAY-BAD-PATH-LOOP.
021100
           MOVE SPACES                   TO  WORK-LINE
021200     STRING  MPATH-LEVEL (I), "  ", MPATH-EMPL (I),
021300       "             ", SRQ-LEVEL-NUM (I), "  ",
021400       SRQ-EMPL-QUEUED (I), "  ", SRQ-QUEUED-DATE (I),
 21500       "  ", SRQ-APPROVE-DATE (I) DELIMITED BY SIZE
             INTO WORK-LINE.
           ADD 1                         TO  CHKPH-SUB.
           MOVE WORK-LINE                TO  CHKPH-LINE (CHKPH-SUB).
021600
021700      GO TO 6230-DISPLAY-BAD-PATH-LOOP.
021800
021900
022000 6990-MAIN-X.
           IF BU-DISPLAY-MSG-1 > SPACES
               MOVE BU-DISPLAY-MSG       TO  BU-SUBPROG-MSG-AREA
               MOVE "CEACHKPH "          TO  BU-SUBPROG-NAME.
           PERFORM 9999-CLOSES.
022100     GOBACK.
022200
       2100-BLOWUP.
022300 7000-INIT-SRQ-TABLE.
           ADD 1                         TO  SUB.
           MOVE SPACES                   TO  SAVE-DREQQUE-LINE (SUB).

       9999-OPENS.
           OPEN INPUT MPATH-PN-I            DREQQUE-RQ-I.
           OPEN OUTPUT PRINT-FILE.

       9999-CLOSES.
           CLOSE      MPATH-PN-I            DREQQUE-RQ-I.
           CLOSE PRINT-FILE.

       9999-CHAINHD-DREQQUE-RQ-I.
           MOVE 0 TO COND-WORD.
           MOVE REQ-ARG TO REQNO OF DREQQUE-RQ-REC-I.
           START DREQQUE-RQ-I KEY = REQNO OF DREQQUE-RQ-REC-I
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF (FILE-STATUS NOT = "00") AND (FILE-STATUS-1 NOT = "2")
               MOVE 99 TO COND-WORD
               IF HANDLE-BLOWUP-FLAG = "Y"
                   MOVE "CHAINHD ERR 9999-CHAINHD-DREQQUE-RQ-I"
                       TO BU-MSG-AREA
                   PERFORM 2100-BLOWUP.

       9999-GETNEXT-DREQQUE-RQ-I.
           MOVE 0 TO COND-WORD.
           READ DREQQUE-RQ-I NEXT INTO BUF-DREQQUE
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   MOVE 15 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD
                   IF HANDLE-BLOWUP-FLAG = "Y"
                       MOVE "GETNEXT ERR 9999-GETNEXT-DREQQUE-RQ-I"
                           TO BU-MSG-AREA
                       PERFORM 2100-BLOWUP
                   END-IF
           ELSE
           IF REQNO OF DREQQUE-RQ-REC-I NOT = REQ-ARG
               MOVE 15 TO COND-WORD.

       9999-GETKEY-MPATH-PN-I.
           MOVE 0 TO COND-WORD.
           MOVE PATH-ARG TO PATHNUM OF MPATH-PN-REC-I.
           READ MPATH-PN-I INTO BUF-MPATH
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS = "23"
               MOVE 17 TO COND-WORD
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD
               IF HANDLE-BLOWUP-FLAG = "Y"
                   MOVE "GETKEY ERR 9999-GETKEY-MPATH-PN-I"
                       TO BU-MSG-AREA
                   PERFORM 2100-BLOWUP.

