       IDENTIFICATION DIVISION.
       PROGRAM-ID.             TRCVTRKI.
       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.
       SOURCE-COMPUTER.        IBM-AS400.
       OBJECT-COMPUTER.        IBM-AS400.

       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT RCVTRK-FILE
                  ASSIGN       TO DATABASE-MCFPCSRCVT
                  ORGANIZATION IS RELATIVE
                  ACCESS MODE  IS RANDOM
                  RELATIVE KEY IS ARG-NO
                  FILE STATUS  IS FILE-STAT.

           SELECT WO-LAST-NUM-USED
                  ASSIGN       TO DATABASE-MCFPMM0800
                  ORGANIZATION IS RELATIVE
                  ACCESS MODE  IS RANDOM
                  RELATIVE KEY IS ARG-NO
                  FILE STATUS  IS FILE-STAT.

           SELECT DISPLAY-FILE
                  ASSIGN       TO WORKSTATION-ZRCVTRKI-SI
                  ORGANIZATION IS TRANSACTION
                  ACCESS MODE  IS SEQUENTIAL
                  FILE STATUS  IS SCREEN-STATUS
                               MAJOR-MINOR
                  CONTROL-AREA IS SCREEN-CONTROL.

       DATA DIVISION.
       FILE SECTION.
       FD  RCVTRK-FILE
           RECORD CONTAINS     152 CHARACTERS
           LABEL RECORDS       ARE OMITTED
           DATA RECORD         IS RCVTRK-REC.
       01  RCVTRK-REC.
           COPY DDS-ALL-FORMATS OF MCFPCSRCVT.

       FD  WO-LAST-NUM-USED
           LABEL RECORDS       ARE STANDARD.
       01  WO-LAST-NUM-USED-REC.
           COPY DDS-ALL-FORMATS OF MCFPMM0800.

       FD  DISPLAY-FILE
           LABEL RECORDS       ARE OMITTED.
       01  DISPLAY-REC         PIC X(2000).

       WORKING-STORAGE SECTION.
       77  ARG-NO              PIC 9(9).
       77  BLOWUP-BASE         PIC X(16).
       77  TRUE-VAL            PIC 1 VALUE B"1".

       01  FILE-STAT.
           05  FILE-STAT-1     PIC X VALUE "0".
           05  FILE-STAT-2     PIC X VALUE "0".

       01  SCREEN-DATA.
           05  SCREEN-INPUT.
               10  VEND-CODE-RANGE.
                   15  VC-STR      PIC X(10).
                   15  VC-END      PIC X(10).
               10  VEND-NAME-RANGE.
                   15  VN-STR      PIC X(44).
                   15  VN-END      PIC X(44).
               10  DATE-RANGE.
                   15  START-DATE.
                       20  SD-MM   PIC X(02).
                       20  SD-DD   PIC X(02).
                       20  SD-YY   PIC X(02).
                   15  END-DATE.
                       20  ED-MM   PIC X(02).
                       20  ED-DD   PIC X(02).
                       20  ED-YY   PIC X(02).
               10  DATE-FORMAT     PIC X(10).
               10  PO-NUM-RANGE.
                   15  PO-STR      PIC X(13).
                   15  PO-END      PIC X(13).
               10  HIST-SW         PIC X(01).
           05  CMDMSG              PIC X(79).
           05  ERRMSG              PIC X(79).

       01  COMP-DATES.
           05  CS-DATE.
               10  CSCC        PIC XX.
               10  CSYY        PIC XX.
               10  CSMM        PIC XX.
               10  CSDD        PIC XX.
           05  CE-DATE.
               10  CECC        PIC XX.
               10  CEYY        PIC XX.
               10  CEMM        PIC XX.
               10  CEDD        PIC XX.

       01  TODAYS-DATE.
           05  DH-CC           PIC 99.
           05  DATE-HOLD.
               10  DH-YY       PIC 99.
               10  DH-MM       PIC 99.
               10  DH-DD       PIC 99.

       01  PASSED-SELECTION-DATA.
           05  VEND-CODES.
               10  VC-FRST     PIC X(10).
               10  VC-LAST     PIC X(10).
           05  VEND-NAMES.
               10  VN-FRST     PIC X(44).
               10  VN-LAST     PIC X(44).
           05  DATES.
               10  S-DATE.
                   15  S-CC    PIC X(02).
                   15  S-YY    PIC X(02).
                   15  S-MM    PIC X(02).
                   15  S-DD    PIC X(02).
               10  E-DATE.
                   15  E-CC    PIC X(02).
                   15  E-YY    PIC X(02).
                   15  E-MM    PIC X(02).
                   15  E-DD    PIC X(02).
           05  PO-NUMS.
               10  PO-FRST     PIC X(13).
               10  PO-LAST     PIC X(13).
           05  HISTORY-SW      PIC X(01).
           05  AUTO-MANUAL     PIC X(01).

       01  DB-ERROR.
           05  DB-FUNC         PIC X(10) VALUE SPACES.
           05  DB-FILE         PIC X(18) VALUE SPACES.
           05  FILLER          PIC X(20) VALUE "ERROR - FILE-STAT = ".
           05  CON-WORD        PIC XX.

       01  LAST-WO-USED-DATA.
           COPY MLASTWO        IN COPYLIB.

           COPY ERRORLIN       IN COPYLIB.

           COPY CATREAD        IN COPYLIB.

           COPY SCREENIO       IN COPYLIB.

           COPY JCWAREA        IN COPYLIB.

           COPY DBSTAT         IN COPYLIB.

           COPY TBLOWUP        IN COPYLIB.

           COPY VCOMAREA       IN COPYLIB.

       PROCEDURE DIVISION.
       START-PGM.
           OPEN I-O            DISPLAY-FILE.
           OPEN I-O            RCVTRK-FILE.

           OPEN INPUT          WO-LAST-NUM-USED.
           MOVE SPACES         TO LAST-WO-USED-DATA.
           MOVE 1              TO DATE-FLAG-SW ARG-NO.
           READ WO-LAST-NUM-USED INTO LAST-WO-USED-DATA
               INVALID KEY     MOVE 1 TO DATE-FLAG-SW.
           CLOSE               WO-LAST-NUM-USED.

           READ RCVTRK-FILE    INTO PASSED-SELECTION-DATA
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
               GO TO END-OF-JOB.

       MAIN.
           MOVE "VRCVTRKI"     TO SCREEN-NAME.
           MOVE SPACES         TO SCREEN-DATA.

           ACCEPT DATE-HOLD    FROM DATE.
           MOVE 20             TO DH-CC.
           IF DH-YY > 70
               MOVE 19         TO DH-CC.

       SHOWFORM.
           MOVE "(MM/DD/YY)"   TO DATE-FORMAT.
           IF DATE-FLAG-SW = 3
               MOVE "(DD/MM/YY)" TO DATE-FORMAT.

           MOVE "00"           TO SCREEN-STATUS.
           MOVE SCREEN-DATA    TO DISPLAY-REC.

           WRITE DISPLAY-REC   FORMAT IS SCREEN-NAME
                               INDIC ARE SCREEN-INDICATORS.
           IF SCREEN-STATUS NOT = "00"
               DISPLAY "SCREEN WRITE ERROR.  SCREEN-STATUS IS "
                               SCREEN-STATUS
               GO TO END-OF-JOB.

           READ  DISPLAY-FILE  FORMAT IS SCREEN-NAME
                               INDIC ARE SCREEN-INDICATORS
           IF SCREEN-STATUS NOT = "00"
               DISPLAY "SCREEN READ ERROR.  SCREEN-STATUS IS "
                               SCREEN-STATUS
               GO TO END-OF-JOB.

           MOVE ALL B"0"       TO SCREEN-INDICATORS.
           MOVE DISPLAY-REC    TO SCREEN-DATA.

           IF KEY-HIT = 3
               GO TO END-OF-JOB.

           IF KEY-HIT = 1
               MOVE SPACES     TO SCREEN-INPUT
               GO TO SHOWFORM.

           IF VC-STR = SPACES
               MOVE VC-END     TO VC-STR
               MOVE SPACES     TO VC-END.

           IF VN-STR = SPACES
               MOVE VN-END     TO VN-STR
               MOVE SPACES     TO VN-END.

           IF START-DATE = SPACES
               MOVE END-DATE   TO START-DATE
               MOVE SPACES     TO END-DATE.

           IF PO-STR = SPACES
               MOVE PO-END     TO PO-STR
               MOVE SPACES     TO PO-END.

           IF SPACES =  VEND-CODE-RANGE AND
                        VEND-NAME-RANGE AND
                        DATE-RANGE      AND
                        PO-NUM-RANGE    AND
                        HIST-SW
               GO TO SHOWFORM.

           IF VC-STR = "*ALL      "
               MOVE SPACES     TO VC-END.

           IF VEND-CODES NOT = SPACES
               MOVE SPACES     TO VEND-NAMES.

       EDIT-START-DATE.
           MOVE SPACES         TO COMP-DATES.
           IF START-DATE = SPACES
               GO TO EDIT-END-DATE.

           IF START-DATE NOT NUMERIC
      ******************************************************************
      **    MESSAGE 035/014:
      **  INVALID START DATE
      ******************************************************************
               MOVE  35        TO CATREAD-MSG-SET
               MOVE  14        TO CATREAD-MSG-NUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER TO ERRMSG
               MOVE 7          TO FIELD-NUMBER
               MOVE TRUE-VAL   TO IND(FIELD-NUMBER) IND(99)
               GO TO SHOWFORM.

           IF DATE-FLAG-SW = 1
               IF SD-MM > "00" AND < "13"
                   IF SD-DD > "00" AND < "32"
                       IF SD-YY IS NUMERIC
                           NEXT SENTENCE
                       ELSE
      ******************************************************************
      **    MESSAGE 035/032:
      **  INVALID YEAR
      ******************************************************************
                           MOVE 35032      TO CATREAD-MSG-NUMBER
                           CALL "CCATREAD" USING CATREAD-PARMS
                           MOVE CATREAD-MSG-TEXT TO ERRMSG
                           MOVE 9          TO FIELD-NUMBER
                           MOVE TRUE-VAL   TO IND(FIELD-NUMBER)
                                              IND(99)
                           GO TO SHOWFORM
                   ELSE
      ******************************************************************
      **    MESSAGE 035/030:
      **  INVALID DAY
      ******************************************************************
                       MOVE 35030      TO CATREAD-MSG-NUMBER
                       CALL "CCATREAD" USING CATREAD-PARMS
                       MOVE CATREAD-MSG-TEXT TO ERRMSG
                       MOVE 8          TO FIELD-NUMBER
                       MOVE TRUE-VAL   TO IND(FIELD-NUMBER)
                                          IND(99)
                       GO TO SHOWFORM
               ELSE
      ******************************************************************
      **    MESSAGE 035/031:
      **  INVALID MONTH
      ******************************************************************
                   MOVE 35031      TO CATREAD-MSG-NUMBER
                   CALL "CCATREAD" USING CATREAD-PARMS
                   MOVE CATREAD-MSG-TEXT TO ERRMSG
                   MOVE 7          TO FIELD-NUMBER
                   MOVE TRUE-VAL   TO IND(FIELD-NUMBER)
                                      IND(99)
                   GO TO SHOWFORM
           ELSE
               IF SD-MM > "00" AND < "32"
                   IF SD-DD > "00" AND < "13"
                       IF SD-YY IS NUMERIC
                           NEXT SENTENCE
                       ELSE
      ******************************************************************
      **    MESSAGE 035/032:
      **  INVALID YEAR
      ******************************************************************
                           MOVE 35032      TO CATREAD-MSG-NUMBER
                           CALL "CCATREAD" USING CATREAD-PARMS
                           MOVE CATREAD-MSG-TEXT TO ERRMSG
                           MOVE 9          TO FIELD-NUMBER
                           MOVE TRUE-VAL   TO IND(FIELD-NUMBER)
                                              IND(99)
                           GO TO SHOWFORM
                   ELSE
      ******************************************************************
      **    MESSAGE 035/031:
      **  INVALID MONTH
      ******************************************************************
                       MOVE 35031      TO CATREAD-MSG-NUMBER
                       CALL "CCATREAD" USING CATREAD-PARMS
                       MOVE CATREAD-MSG-TEXT TO ERRMSG
                       MOVE 8          TO FIELD-NUMBER
                       MOVE TRUE-VAL   TO IND(FIELD-NUMBER)
                                          IND(99)
                       GO TO SHOWFORM
               ELSE
      ******************************************************************
      **    MESSAGE 035/030:
      **  INVALID DAY
      ******************************************************************
                   MOVE 35030      TO CATREAD-MSG-NUMBER
                   CALL "CCATREAD" USING CATREAD-PARMS
                   MOVE CATREAD-MSG-TEXT TO ERRMSG
                   MOVE 7          TO FIELD-NUMBER
                   MOVE TRUE-VAL   TO IND(FIELD-NUMBER)
                                      IND(99)
                   GO TO SHOWFORM.

           MOVE SD-YY          TO CSYY.
           MOVE SD-MM          TO CSMM.
           MOVE SD-DD          TO CSDD.

           IF DATE-FLAG-SW = 3
               MOVE SD-DD      TO CSMM
               MOVE SD-MM      TO CSDD.

           MOVE 20             TO CSCC.
           IF CSYY > 70
               MOVE 19         TO CSCC.

       EDIT-END-DATE.
           IF END-DATE = SPACES
               GO TO COMPARE-DATES.

           IF END-DATE NOT NUMERIC
      ******************************************************************
      **    MESSAGE 035/112:
      **  INVALID END DATE
      ******************************************************************
               MOVE  35        TO CATREAD-MSG-SET
               MOVE 112        TO CATREAD-MSG-NUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER TO ERRMSG
               MOVE 10         TO FIELD-NUMBER
               MOVE TRUE-VAL   TO IND(FIELD-NUMBER) IND(99)
               GO TO SHOWFORM.

           IF DATE-FLAG-SW = 1
               IF ED-MM > "00" AND < "13"
                   IF ED-DD > "00" AND < "32"
                       IF ED-YY IS NUMERIC
                           NEXT SENTENCE
                       ELSE
      ******************************************************************
      **    MESSAGE 035/032:
      **  INVALID YEAR
      ******************************************************************
                           MOVE 35032      TO CATREAD-MSG-NUMBER
                           CALL "CCATREAD" USING CATREAD-PARMS
                           MOVE CATREAD-MSG-TEXT TO ERRMSG
                           MOVE 12         TO FIELD-NUMBER
                           MOVE TRUE-VAL   TO IND(FIELD-NUMBER)
                                              IND(99)
                           GO TO SHOWFORM
                   ELSE
      ******************************************************************
      **    MESSAGE 035/030:
      **  INVALID DAY
      ******************************************************************
                       MOVE 35030      TO CATREAD-MSG-NUMBER
                       CALL "CCATREAD" USING CATREAD-PARMS
                       MOVE CATREAD-MSG-TEXT TO ERRMSG
                       MOVE 11         TO FIELD-NUMBER
                       MOVE TRUE-VAL   TO IND(FIELD-NUMBER)
                                          IND(99)
                       GO TO SHOWFORM
               ELSE
      ******************************************************************
      **    MESSAGE 035/031:
      **  INVALID MONTH
      ******************************************************************
                   MOVE 35031      TO CATREAD-MSG-NUMBER
                   CALL "CCATREAD" USING CATREAD-PARMS
                   MOVE CATREAD-MSG-TEXT TO ERRMSG
                   MOVE 10         TO FIELD-NUMBER
                   MOVE TRUE-VAL   TO IND(FIELD-NUMBER)
                                      IND(99)
                   GO TO SHOWFORM
           ELSE
               IF ED-MM > "00" AND < "32"
                   IF ED-DD > "00" AND < "13"
                       IF ED-YY IS NUMERIC
                           NEXT SENTENCE
                       ELSE
      ******************************************************************
      **    MESSAGE 035/032:
      **  INVALID YEAR
      ******************************************************************
                           MOVE 35032      TO CATREAD-MSG-NUMBER
                           CALL "CCATREAD" USING CATREAD-PARMS
                           MOVE CATREAD-MSG-TEXT TO ERRMSG
                           MOVE 12         TO FIELD-NUMBER
                           MOVE TRUE-VAL   TO IND(FIELD-NUMBER)
                                              IND(99)
                           GO TO SHOWFORM
                   ELSE
      ******************************************************************
      **    MESSAGE 035/031:
      **  INVALID MONTH
      ******************************************************************
                       MOVE 35031      TO CATREAD-MSG-NUMBER
                       CALL "CCATREAD" USING CATREAD-PARMS
                       MOVE CATREAD-MSG-TEXT TO ERRMSG
                       MOVE 11         TO FIELD-NUMBER
                       MOVE TRUE-VAL   TO IND(FIELD-NUMBER)
                                          IND(99)
                       GO TO SHOWFORM
               ELSE
      ******************************************************************
      **    MESSAGE 035/030:
      **  INVALID DAY
      ******************************************************************
                   MOVE 35030      TO CATREAD-MSG-NUMBER
                   CALL "CCATREAD" USING CATREAD-PARMS
                   MOVE CATREAD-MSG-TEXT TO ERRMSG
                   MOVE 10         TO FIELD-NUMBER
                   MOVE TRUE-VAL   TO IND(FIELD-NUMBER)
                                      IND(99)
                   GO TO SHOWFORM.

           MOVE ED-YY          TO CEYY.
           MOVE ED-MM          TO CEMM.
           MOVE ED-DD          TO CEDD.

           IF DATE-FLAG-SW = 3
               MOVE ED-DD      TO CEMM
               MOVE ED-MM      TO CEDD.

           MOVE 20             TO CECC.
           IF CEYY > 70
               MOVE 19         TO CECC.

       COMPARE-DATES.
           IF CS-DATE > CE-DATE
      ******************************************************************
      **    MESSAGE 045/062:
      **  START DATE IS GREATER THAN END DATE
      ******************************************************************
               MOVE  45        TO CATREAD-MSG-SET
               MOVE  62        TO CATREAD-MSG-NUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER TO ERRMSG
               MOVE 7          TO FIELD-NUMBER
               MOVE TRUE-VAL   TO IND(FIELD-NUMBER) IND(99)
               GO TO SHOWFORM.

           IF CS-DATE = CE-DATE
               MOVE SPACES     TO E-DATE.

           MOVE SPACES         TO PASSED-SELECTION-DATA.
           MOVE VC-STR         TO VC-FRST.
           MOVE VC-END         TO VC-LAST.
           MOVE VN-STR         TO VN-FRST.
           MOVE VN-END         TO VN-LAST.
           MOVE PO-STR         TO PO-FRST.
           MOVE PO-END         TO PO-LAST.
           MOVE CSCC           TO S-CC.
           MOVE CSCC           TO S-CC.
           MOVE CSYY           TO S-YY.
           MOVE CSMM           TO S-MM.
           MOVE CSDD           TO S-DD.
           MOVE CECC           TO E-CC.
           MOVE CEYY           TO E-YY.
           MOVE CEMM           TO E-MM.
           MOVE CEDD           TO E-DD.

           MOVE "M"            TO AUTO-MANUAL.
           IF HIST-SW NOT = SPACE
               MOVE "H"        TO HISTORY-SW.

           REWRITE RCVTRK-REC  FROM PASSED-SELECTION-DATA
               INVALID KEY     STRING
                   "REWRITE FAILED ON RCVTRK-FILE  FILE-STAT = "
                    FILE-STAT  DELIMITED BY SPACES
                               INTO BU-DISPLAY-MSG
               PERFORM 998-BLOWUP.

       END-OF-JOB.
           CLOSE               DISPLAY-FILE.
           CLOSE               RCVTRK-FILE.

           MOVE "101"          TO SETJCW-VALUE.
           MOVE 278            TO SETJCW-STARTING-POS.
           MOVE 3              TO SETJCW-LENGTH.
           CALL "SETJCW" USING SETJCW-VALUE,
                               SETJCW-STARTING-POS,
                               SETJCW-LENGTH,
                               SETJCW-STATUS.
           IF SETJCW-STATUS NOT = "00"
               MOVE "SETJCW ERROR" TO BU-DISPLAY-MSG
               PERFORM 998-BLOWUP.

           CALL "TRSCREN2".
           GOBACK.

       998-BLOWUP.
           MOVE "TRCVTRKI"     TO BU-PGM-NAME.
           CALL "TBLOWUP"      USING BLOWUP-BASE
                               BU-PGM-NAME
                               STATUS-AREA
                               VIEW-COMAREA
                               FILE-STAT
                               BU-DISPLAY-MSG
                               BU-DISPLAY-AREA.

       999-CATREAD.
           MOVE SPACES         TO MESSAGE-BUFFER.
           CALL "CCATREAD"     USING CATREAD-PARMS.
           MOVE CATREAD-MSG-TEXT TO MESSAGE-BUFFER.

       999-CATREAD-EXIT.       EXIT.

