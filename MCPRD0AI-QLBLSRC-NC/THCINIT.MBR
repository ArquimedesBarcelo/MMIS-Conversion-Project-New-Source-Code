       IDENTIFICATION DIVISION.
       PROGRAM-ID.             THCINIT.
       AUTHOR.                 W. ROXBURY.
       INSTALLATION.           GOODYEAR TIRE & RUBBER CO.
       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.
       SOURCE-COMPUTER.        IBM-AS400.
       OBJECT-COMPUTER.        IBM-AS400.
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT EQP-HOT-CODE
                  ASSIGN       TO DATABASE-MCFLMM2002
                  ORGANIZATION IS INDEXED
                  ACCESS MODE  IS DYNAMIC
                  RECORD KEY   IS EXTERNALLY-DESCRIBED-KEY
                               WITH DUPLICATES
                  FILE STATUS  IS FILE-STAT.

           SELECT EQP-EQUIPMENT
                  ASSIGN       TO DATABASE-MCFLMM0201
                  ORGANIZATION IS INDEXED
                  ACCESS MODE  IS DYNAMIC
                  RECORD KEY   IS EXTERNALLY-DESCRIBED-KEY
                  FILE STATUS  IS FILE-STAT.

           SELECT DISPLAY-FILE
                  ASSIGN       TO WORKSTATION-ZHOTCODE-SI
                  ORGANIZATION IS TRANSACTION
                  ACCESS MODE  IS SEQUENTIAL
                  FILE STATUS  IS SCREEN-STATUS
                               MAJOR-MINOR
                  CONTROL-AREA IS SCREEN-CONTROL.

       DATA DIVISION.
       FILE SECTION.
       FD  EQP-HOT-CODE
           LABEL RECORDS       ARE STANDARD.
       01  HC-REC.
           COPY DDS-ALL-FORMATS OF MCFLMM2002.

       FD  EQP-EQUIPMENT
           LABEL RECORDS       ARE STANDARD.
       01  EQP-REC.
           COPY DDS-ALL-FORMATS OF MCFLMM0201.

       FD  DISPLAY-FILE
           LABEL RECORDS       ARE OMITTED.
       01  DISPLAY-REC         PIC X(2000).

       WORKING-STORAGE SECTION.
       77  FIELD-NUMBER        PIC 9999   COMP-4.
       77  TRUE-VAL            PIC 1      VALUE B"1".

       01  PASSWORD-INFORMATION.
           05  NAME-OF-PROGRAM     PIC X(08) VALUE "THCINIT ".
           05  PROGRAM-TYPE        PIC X(02) VALUE "UP".
           05  PROGRAM-RELEASE     PIC X(12) VALUE " E0100010001".
           05  PROGRAM-DESCRIPTION.
               10  PROG-DESC-A     PIC X(30) VALUE
               "INITIATES HOT CODE MACHINES IN".
               10  PROG-DESC-A     PIC X(30) VALUE
               "TO THE MMIS WORKORDER QUEUE   ".
               10  PROG-DESC-B     PIC X(60) VALUE
               "FACTOR CALCULATIONS SYSTEM.   ".
               10  PROG-FUNCTION   PIC X(30) VALUE
               "RUNS FROM THE f1 KEY OF THE HO".
               10  PROG-FUNCTION   PIC X(30) VALUE
               "T CODE MAINTENANCE MENU.      ".
           05  PASSWORD-FLAG       PIC X.

       01  FILE-STAT.
           05 FILE-STAT-1      PIC X   VALUE "0".
           05 FILE-STAT-2      PIC X   VALUE "0".

       01  CURR-DATE-99-CCYY.
           05  CURR-CT-99      PIC 99.
           05  CURR-DATE-99.
               10  CURR-YR-99  PIC 99.
               10  CURR-MO-99  PIC 99.
               10  CURR-DY-99  PIC 99.

       01  TIME-OF-DAY.
           05  HOURS           PIC XX.
           05  FILLER          PIC X.
           05  MINUTES         PIC XX.
           05  FILLER          PIC XXX.

       01  CUR-TIME.
           05  CURR-TIME.
               10  CURR-HR     PIC XX.
               10  CURR-MN     PIC XX.
           05  FILLER          PIC XX.

       01  SCREEN-DATA.
           05  LINE-1.
               10  EQP-NUM-1   PIC X(06).
               10  S-DATE-1.
                   15  S-MM-1  PIC XX.
                   15  S-DD-1  PIC XX.
                   15  S-YY-1  PIC XX.
               10  S-TIME-1.
                   15  S-HH-1  PIC XX.
                   15  S-MN-1  PIC XX.
               10  E-DATE-1.
                   15  E-MM-1  PIC XX.
                   15  E-DD-1  PIC XX.
                   15  E-YY-1  PIC XX.
               10  E-TIME-1.
                   15  E-HH-1  PIC XX.
                   15  E-MN-1  PIC XX.
               10  REM-1       PIC X(30).
           05  LINE-2.
               10  EQP-NUM-2   PIC X(06).
               10  S-DATE-2.
                   15  S-MM-2  PIC XX.
                   15  S-DD-2  PIC XX.
                   15  S-YY-2  PIC XX.
               10  S-TIME-2.
                   15  S-HH-2  PIC XX.
                   15  S-MN-2  PIC XX.
               10  E-DATE-2.
                   15  E-MM-2  PIC XX.
                   15  E-DD-2  PIC XX.
                   15  E-YY-2  PIC XX.
               10  E-TIME-2.
                   15  E-HH-2  PIC XX.
                   15  E-MN-2  PIC XX.
               10  REM-2       PIC X(30).
           05  LINE-3.
               10  EQP-NUM-3   PIC X(06).
               10  S-DATE-3.
                   15  S-MM-3  PIC XX.
                   15  S-DD-3  PIC XX.
                   15  S-YY-3  PIC XX.
               10  S-TIME-3.
                   15  S-HH-3  PIC XX.
                   15  S-MN-3  PIC XX.
               10  E-DATE-3.
                   15  E-MM-3  PIC XX.
                   15  E-DD-3  PIC XX.
                   15  E-YY-3  PIC XX.
               10  E-TIME-3.
                   15  E-HH-3  PIC XX.
                   15  E-MN-3  PIC XX.
               10  REM-3       PIC X(30).
           05  LINE-4.
               10  EQP-NUM-4   PIC X(06).
               10  S-DATE-4.
                   15  S-MM-4  PIC XX.
                   15  S-DD-4  PIC XX.
                   15  S-YY-4  PIC XX.
               10  S-TIME-4.
                   15  S-HH-4  PIC XX.
                   15  S-MN-4  PIC XX.
               10  E-DATE-4.
                   15  E-MM-4  PIC XX.
                   15  E-DD-4  PIC XX.
                   15  E-YY-4  PIC XX.
               10  E-TIME-4.
                   15  E-HH-4  PIC XX.
                   15  E-MN-4  PIC XX.
               10  REM-4       PIC X(30).
           05  LINE-5.
               10  EQP-NUM-5   PIC X(06).
               10  S-DATE-5.
                   15  S-MM-5  PIC XX.
                   15  S-DD-5  PIC XX.
                   15  S-YY-5  PIC XX.
               10  S-TIME-5.
                   15  S-HH-5  PIC XX.
                   15  S-MN-5  PIC XX.
               10  E-DATE-5.
                   15  E-MM-5  PIC XX.
                   15  E-DD-5  PIC XX.
                   15  E-YY-5  PIC XX.
               10  E-TIME-5.
                   15  E-HH-5  PIC XX.
                   15  E-MN-5  PIC XX.
               10  REM-5       PIC X(30).
           05  LINE-6.
               10  EQP-NUM-6   PIC X(06).
               10  S-DATE-6.
                   15  S-MM-6  PIC XX.
                   15  S-DD-6  PIC XX.
                   15  S-YY-6  PIC XX.
               10  S-TIME-6.
                   15  S-HH-6  PIC XX.
                   15  S-MN-6  PIC XX.
               10  E-DATE-6.
                   15  E-MM-6  PIC XX.
                   15  E-DD-6  PIC XX.
                   15  E-YY-6  PIC XX.
               10  E-TIME-6.
                   15  E-HH-6  PIC XX.
                   15  E-MN-6  PIC XX.
               10  REM-6       PIC X(30).
           05  LINE-7.
               10  EQP-NUM-7   PIC X(06).
               10  S-DATE-7.
                   15  S-MM-7  PIC XX.
                   15  S-DD-7  PIC XX.
                   15  S-YY-7  PIC XX.
               10  S-TIME-7.
                   15  S-HH-7  PIC XX.
                   15  S-MN-7  PIC XX.
               10  E-DATE-7.
                   15  E-MM-7  PIC XX.
                   15  E-DD-7  PIC XX.
                   15  E-YY-7  PIC XX.
               10  E-TIME-7.
                   15  E-HH-7  PIC XX.
                   15  E-MN-7  PIC XX.
               10  REM-7       PIC X(30).
           05  CMDMSG          PIC X(79).
           05  ERRMSG          PIC X(79).

       01  LINE-HOLD.
           05  EQP-NUM-H       PIC X(06).
           05  S-DATE-H.
               10  S-MM-H      PIC XX.
               10  S-DD-H      PIC XX.
               10  S-YY-H      PIC XX.
           05  S-TIME-H.
               10  S-HH-H      PIC XX.
               10  S-MN-H      PIC XX.
           05  E-DATE-H.
               10  E-MM-H      PIC XX.
               10  E-DD-H      PIC XX.
               10  E-YY-H      PIC XX.
           05  E-TIME-H.
               10  E-HH-H      PIC XX.
               10  E-MN-H      PIC XX.
           05  REM-H           PIC X(30).

       01  ZONE-SAVE-AREA.
           05  ZONE-1          PIC XXXX.
           05  ZONE-2          PIC XXXX.
           05  ZONE-3          PIC XXXX.
           05  ZONE-4          PIC XXXX.
           05  ZONE-5          PIC XXXX.
           05  ZONE-6          PIC XXXX.
           05  ZONE-7          PIC XXXX.
           05  ZONE-H          PIC XXXX.

       01  DATE-HOLD-CCYY.
           05  DH-CC           PIC 99.
           05  DATE-HOLD.
               10  DH-MM       PIC 99.
               10  DH-DD       PIC 99.
               10  DH-YY       PIC 99.

       01  DATE-HOLD-99-CCYY.
           05  DH-CC-99        PIC 99.
           05  DATE-HOLD-99.
               10  DH-YY-99    PIC 99.
               10  DH-MM-99    PIC 99.
               10  DH-DD-99    PIC 99.

       01  TIME-HOLD.
           05  TH-HH           PIC 99.
           05  TH-MM           PIC 99.

       01  DATE-NUM-1.
           05  DN-1-CC         PIC 99.
           05  DN-1-YY         PIC 99.
           05  DN-1-MM         PIC 99.
           05  DN-1-DD         PIC 99.

       01  DATE-NUM-2.
           05  DN-2-CC         PIC 99.
           05  DN-2-YY         PIC 99.
           05  DN-2-MM         PIC 99.
           05  DN-2-DD         PIC 99.

       01  TIME-NUM-1          PIC 9999.
       01  TIME-NUM-2          PIC 9999.

       01  EXISTING-NUM-MSG.
           05  EN-MSG          PIC X(06) VALUE SPACES.
           05  EN-MSG-2        PIC X(66).

           COPY SCREENIO       IN COPYLIB.

           COPY CATREAD        IN COPYLIB.

       01  EQP-EQUIP-DATA.
           COPY MEQPFILE       IN COPYLIB.

       01  HOT-CODE-DATA.
           COPY DHOTCODE       IN COPYLIB.

       LINKAGE SECTION.
       01  DBPARAMETERS.
           COPY DBPARMS        IN COPYLIB.

       PROCEDURE DIVISION      USING DBPARAMETERS.

       CHECK-PASSWORD.
           CALL "TPWORD"       USING PASSWORD-INFORMATION.
           IF PASSWORD-FLAG = "Y"
               GO TO BEGIN-PROC.
           GOBACK.

       BEGIN-PROC.
           OPEN I-O            DISPLAY-FILE.
           OPEN I-O            EQP-HOT-CODE.
           OPEN INPUT          EQP-EQUIPMENT.

       6-MAIN.
           ACCEPT CURR-DATE-99 FROM DATE.
           MOVE 20             TO CURR-CT-99.
           IF CURR-YR-99 > 70
               MOVE 19         TO CURR-CT-99.
           ACCEPT TIME-OF-DAY  FROM TIME.
           MOVE HOURS          TO CURR-HR.
           MOVE MINUTES        TO CURR-MN.
           MOVE SPACES         TO SCREEN-DATA.
           MOVE "VINITHC"      TO SCREEN-NAME.

       61-SHOWFORM.
           MOVE "00"           TO SCREEN-STATUS.
           MOVE SCREEN-DATA    TO DISPLAY-REC.
           WRITE DISPLAY-REC   FORMAT IS SCREEN-NAME
                               INDIC ARE SCREEN-INDICATORS.
           IF SCREEN-STATUS NOT = "00"
               DISPLAY "SCREEN WRITE ERROR.  SCREEN-STATUS IS "
                               SCREEN-STATUS
               GO TO END-OF-JOB.

           READ  DISPLAY-FILE  FORMAT IS SCREEN-NAME
                               INDIC ARE SCREEN-INDICATORS.
           IF SCREEN-STATUS NOT = "00"
               DISPLAY "SCREEN READ ERROR.  SCREEN-STATUS IS "
                               SCREEN-STATUS
               GO TO END-OF-JOB.

           MOVE ALL B"0"       TO SCREEN-INDICATORS.
           MOVE DISPLAY-REC    TO SCREEN-DATA.

           IF KEY-HIT = 1 OR 3
               GO TO END-OF-JOB.

           IF KEY-HIT = 0
               NEXT SENTENCE
           ELSE
               GO TO 61-SHOWFORM.

           IF SCREEN-DATA = SPACES
               GO TO 61-SHOWFORM.

           IF EQP-NUM-7 = EQP-NUM-6 OR EQP-NUM-5 OR EQP-NUM-4
                       OR EQP-NUM-3 OR EQP-NUM-2 OR EQP-NUM-1
               MOVE SPACES     TO LINE-7.

           IF EQP-NUM-6 = EQP-NUM-5 OR EQP-NUM-4 OR EQP-NUM-3
                       OR EQP-NUM-2 OR EQP-NUM-1
               MOVE SPACES     TO LINE-6.

           IF EQP-NUM-5 = EQP-NUM-4 OR EQP-NUM-3 OR EQP-NUM-2
                       OR EQP-NUM-1
               MOVE SPACES     TO LINE-5.

           IF EQP-NUM-4 = EQP-NUM-3 OR EQP-NUM-2 OR EQP-NUM-1
               MOVE SPACES     TO LINE-4.

           IF EQP-NUM-3 = EQP-NUM-2 OR EQP-NUM-1
               MOVE SPACES     TO LINE-3.

           IF EQP-NUM-2 =  EQP-NUM-1
               MOVE SPACES     TO LINE-2.

           IF EQP-NUM-1 = SPACES
               MOVE SPACES     TO LINE-1.

           IF EQP-NUM-2 = SPACES
               MOVE SPACES     TO LINE-2.

           IF EQP-NUM-3 = SPACES
               MOVE SPACES     TO LINE-3.

           IF EQP-NUM-4 = SPACES
               MOVE SPACES     TO LINE-4.

           IF EQP-NUM-5 = SPACES
               MOVE SPACES     TO LINE-5.

           IF EQP-NUM-6 = SPACES
               MOVE SPACES     TO LINE-6.

           IF EQP-NUM-7 = SPACES
               MOVE SPACES     TO LINE-7.

           IF LINE-1 NOT = SPACES
               MOVE LINE-1     TO LINE-HOLD
               MOVE 0          TO FIELD-NUMBER
               PERFORM 61-EDIT-DATA THRU 61-ED-EXIT
               MOVE ZONE-H     TO ZONE-1
               MOVE LINE-HOLD  TO LINE-1
               IF FIELD-NUMBER > 0
                   MOVE TRUE-VAL TO IND (99) IND (FIELD-NUMBER)
                   GO TO 61-SHOWFORM.

           IF LINE-2 NOT = SPACES
               MOVE LINE-2     TO LINE-HOLD
               MOVE 0          TO FIELD-NUMBER
               PERFORM 61-EDIT-DATA THRU 61-ED-EXIT
               MOVE ZONE-H     TO ZONE-2
               MOVE LINE-HOLD  TO LINE-2
               IF FIELD-NUMBER > 0
                   ADD 12      TO FIELD-NUMBER
                   MOVE TRUE-VAL   TO IND (99) IND (FIELD-NUMBER)
                   GO TO 61-SHOWFORM.

           IF LINE-3 NOT = SPACES
               MOVE LINE-3     TO LINE-HOLD
               MOVE 0          TO FIELD-NUMBER
               PERFORM 61-EDIT-DATA THRU 61-ED-EXIT
               MOVE ZONE-H     TO ZONE-3
               MOVE LINE-HOLD  TO LINE-3
               IF FIELD-NUMBER > 0
                   ADD 24      TO FIELD-NUMBER
                   MOVE TRUE-VAL   TO IND (99) IND (FIELD-NUMBER)
                   GO TO 61-SHOWFORM.

           IF LINE-4 NOT = SPACES
               MOVE LINE-4     TO LINE-HOLD
               MOVE 0          TO FIELD-NUMBER
               PERFORM 61-EDIT-DATA THRU 61-ED-EXIT
               MOVE ZONE-H     TO ZONE-4
               MOVE LINE-HOLD  TO LINE-4
               IF FIELD-NUMBER > 0
                   ADD 36      TO FIELD-NUMBER
                   MOVE TRUE-VAL   TO IND (99) IND (FIELD-NUMBER)
                   GO TO 61-SHOWFORM.

           IF LINE-5 NOT = SPACES
               MOVE LINE-5     TO LINE-HOLD
               MOVE 0          TO FIELD-NUMBER
               PERFORM 61-EDIT-DATA THRU 61-ED-EXIT
               MOVE ZONE-H     TO ZONE-5
               MOVE LINE-HOLD  TO LINE-5
               IF FIELD-NUMBER > 0
                   ADD 48      TO FIELD-NUMBER
                   MOVE TRUE-VAL   TO IND (99) IND (FIELD-NUMBER)
                   GO TO 61-SHOWFORM.

           IF LINE-6 NOT = SPACES
               MOVE LINE-6     TO LINE-HOLD
               MOVE 0          TO FIELD-NUMBER
               PERFORM 61-EDIT-DATA THRU 61-ED-EXIT
               MOVE ZONE-H     TO ZONE-6
               MOVE LINE-HOLD  TO LINE-6
               IF FIELD-NUMBER > 0
                   ADD 60      TO FIELD-NUMBER
                   MOVE TRUE-VAL   TO IND (99) IND (FIELD-NUMBER)
                   GO TO 61-SHOWFORM.

           IF LINE-7 NOT = SPACES
               MOVE LINE-7     TO LINE-HOLD
               MOVE 0          TO FIELD-NUMBER
               PERFORM 61-EDIT-DATA THRU 61-ED-EXIT
               MOVE ZONE-H     TO ZONE-7
               MOVE LINE-HOLD  TO LINE-7
               IF FIELD-NUMBER > 0
                   ADD 72      TO FIELD-NUMBER
                   MOVE TRUE-VAL   TO IND (99) IND (FIELD-NUMBER)
                   GO TO 61-SHOWFORM.

           GO TO 63-UPDATE.

       61-EDIT-DATA.
           MOVE EQP-NUM-H      TO EQPNUM OF EQP-EQUIPMENT.
           READ EQP-EQUIPMENT  INTO EQP-EQUIP-DATA.
           IF FILE-STAT NOT = "00"
               MOVE 35004      TO CATREAD-MSG-NUMBER
               CALL "CCATREAD" USING CATREAD-PARMS
               MOVE CATREAD-MSG-TEXT TO ERRMSG
               MOVE 1          TO FIELD-NUMBER
               GO TO 61-ED-EXIT.

           MOVE EQP-MAINT-ZONE TO ZONE-H.
           MOVE EQP-NUM-H      TO EQPNUM OF EQP-HOT-CODE.
           READ EQP-HOT-CODE   INTO HOT-CODE-DATA.
           IF FILE-STAT = "00"
               MOVE 27058      TO CATREAD-MSG-NUMBER
               CALL "CCATREAD" USING CATREAD-PARMS
               MOVE CATREAD-MSG-TEXT TO EN-MSG-2
               MOVE EXISTING-NUM-MSG TO ERRMSG
               MOVE 1          TO FIELD-NUMBER
               GO TO 61-ED-EXIT.

           MOVE S-DATE-H       TO DATE-HOLD.
           PERFORM 62-TEST-VALID-DATE THRU 62-TVD-EXIT.
           IF FIELD-NUMBER > 0
               GO TO 61-ED-EXIT.

           MOVE S-TIME-H       TO TIME-HOLD.
           PERFORM 62-TEST-VALID-TIME THRU 62-TVT-EXIT.
           IF FIELD-NUMBER > 0
               GO TO 61-ED-EXIT.

           MOVE E-DATE-H       TO DATE-HOLD.
           PERFORM 62-TEST-VALID-DATE THRU 62-TVD-EXIT.
           IF FIELD-NUMBER > 0
               ADD 5           TO FIELD-NUMBER
               GO TO 61-ED-EXIT.

           MOVE E-TIME-H       TO TIME-HOLD.
           PERFORM 62-TEST-VALID-TIME THRU 62-TVT-EXIT.
           IF FIELD-NUMBER > 0
               ADD 5           TO FIELD-NUMBER
               GO TO 61-ED-EXIT.

           MOVE S-YY-H         TO DN-1-YY.
           MOVE S-MM-H         TO DN-1-MM.
           MOVE S-DD-H         TO DN-1-DD.
           IF DATE-FLAG = 3
               MOVE S-MM-H     TO DN-1-DD
               MOVE S-DD-H     TO DN-1-MM.
           MOVE 20             TO DN-1-CC.
           IF DN-1-YY > 70
               MOVE 19         TO DN-1-CC.

           MOVE E-YY-H         TO DN-2-YY.
           MOVE E-MM-H         TO DN-2-MM.
           MOVE E-DD-H         TO DN-2-DD.
           IF DATE-FLAG = 3
               MOVE E-MM-H     TO DN-2-DD
               MOVE E-DD-H     TO DN-2-MM.
           MOVE 20             TO DN-2-CC.
           IF DN-2-YY > 70
               MOVE 19         TO DN-2-CC.

           MOVE S-TIME-H       TO TIME-NUM-1.
           MOVE E-TIME-H       TO TIME-NUM-2.

           IF DATE-NUM-1 > DATE-NUM-2
               MOVE 30033      TO CATREAD-MSG-NUMBER
               CALL "CCATREAD" USING CATREAD-PARMS
               MOVE CATREAD-MSG-TEXT TO ERRMSG
               MOVE 2          TO FIELD-NUMBER
               GO TO 61-ED-EXIT.

           IF DATE-NUM-1 = DATE-NUM-2
               IF TIME-NUM-1 > TIME-NUM-2
                   MOVE 46019      TO CATREAD-MSG-NUMBER
                   CALL "CCATREAD" USING CATREAD-PARMS
                   MOVE CATREAD-MSG-TEXT TO ERRMSG
                   MOVE 5          TO FIELD-NUMBER
                   GO TO 61-ED-EXIT.

       61-ED-EXIT.             EXIT.

       62-TEST-VALID-DATE.
           IF DATE-HOLD = "C     " OR " C    " OR "CC    "
               MOVE CURR-YR-99 TO S-YY-H
               MOVE CURR-MO-99 TO S-MM-H
               MOVE CURR-DY-99 TO S-DD-H
               IF DATE-FLAG = 3
                   MOVE CURR-MO-99 TO S-DD-H
                   MOVE CURR-DY-99 TO S-MM-H
               END-IF
               MOVE S-DATE-H   TO DATE-HOLD
               MOVE CURR-TIME  TO S-TIME-H
               GO TO 62-TVD-EXIT.

           IF DATE-HOLD NOT NUMERIC
               MOVE 35028      TO CATREAD-MSG-NUMBER
               CALL "CCATREAD" USING CATREAD-PARMS
               MOVE CATREAD-MSG-TEXT TO ERRMSG
               MOVE 2          TO FIELD-NUMBER
               GO TO 62-TVD-EXIT.

           IF DH-YY IS NUMERIC
               IF DATE-FLAG = 1
                   IF DH-MM > 0 AND DH-MM < 13
                       IF DH-DD > 0 AND DH-DD < 32
                           NEXT SENTENCE
                       ELSE
                           MOVE 35030      TO CATREAD-MSG-NUMBER
                           CALL "CCATREAD" USING CATREAD-PARMS
                           MOVE CATREAD-MSG-TEXT TO ERRMSG
                           MOVE 3          TO FIELD-NUMBER
                           GO TO 62-TVD-EXIT
                   ELSE
                       MOVE 35031      TO CATREAD-MSG-NUMBER
                       CALL "CCATREAD" USING CATREAD-PARMS
                       MOVE CATREAD-MSG-TEXT TO ERRMSG
                       MOVE 2          TO FIELD-NUMBER
                       GO TO 62-TVD-EXIT
               ELSE
                   IF DH-MM > 0 AND DH-MM < 32
                       IF DH-DD > 0 AND DH-DD < 13
                           NEXT SENTENCE
                       ELSE
                           MOVE 35031      TO CATREAD-MSG-NUMBER
                           CALL "CCATREAD" USING CATREAD-PARMS
                           MOVE CATREAD-MSG-TEXT TO ERRMSG
                           MOVE 2          TO FIELD-NUMBER
                           MOVE TRUE-VAL   TO IND (99)
                           GO TO 62-TVD-EXIT
                   ELSE
                       MOVE 35030      TO CATREAD-MSG-NUMBER
                       CALL "CCATREAD" USING CATREAD-PARMS
                       MOVE CATREAD-MSG-TEXT TO ERRMSG
                       MOVE 3          TO FIELD-NUMBER
                       MOVE TRUE-VAL   TO IND (99)
                       GO TO 62-TVD-EXIT
           ELSE
               MOVE 35032      TO CATREAD-MSG-NUMBER
               CALL "CCATREAD" USING CATREAD-PARMS
               MOVE CATREAD-MSG-TEXT TO ERRMSG
               MOVE 4          TO FIELD-NUMBER
               GO TO 62-TVD-EXIT.

           MOVE DH-YY          TO DH-YY-99.
           IF DH-YY-99 > 70
               MOVE 19         TO DH-CC-99
           ELSE
           MOVE 20             TO DH-CC-99.
           MOVE DH-MM          TO DH-MM-99.
           MOVE DH-DD          TO DH-DD-99.
           IF DATE-FLAG = 3
               MOVE DH-MM      TO DH-DD-99
               MOVE DH-DD      TO DH-MM-99.

           IF DATE-HOLD-99-CCYY < CURR-DATE-99-CCYY
               MOVE 30022      TO CATREAD-MSG-NUMBER
               CALL "CCATREAD" USING CATREAD-PARMS
               MOVE CATREAD-MSG-TEXT TO ERRMSG
               MOVE 2          TO FIELD-NUMBER
               GO TO 62-TVD-EXIT.

       62-TVD-EXIT.            EXIT.

       62-TEST-VALID-TIME.
           IF TIME-HOLD NOT NUMERIC
               MOVE 35029      TO CATREAD-MSG-NUMBER
               CALL "CCATREAD" USING CATREAD-PARMS
               MOVE CATREAD-MSG-TEXT TO ERRMSG
               MOVE 5          TO FIELD-NUMBER
               GO TO 62-TVT-EXIT.

           IF TH-HH < 24
               IF TH-MM < 60
                   NEXT SENTENCE
               ELSE
                   MOVE 35054  TO CATREAD-MSG-NUMBER
                   CALL "CCATREAD" USING CATREAD-PARMS
                   MOVE CATREAD-MSG-TEXT TO ERRMSG
                   MOVE 6      TO FIELD-NUMBER
                   GO TO 62-TVT-EXIT
           ELSE
               MOVE 35055      TO CATREAD-MSG-NUMBER
               CALL "CCATREAD" USING CATREAD-PARMS
               MOVE CATREAD-MSG-TEXT TO ERRMSG
               MOVE 5          TO FIELD-NUMBER
               GO TO 62-TVT-EXIT.

           IF DATE-HOLD-99-CCYY = CURR-DATE-99-CCYY
               IF TIME-HOLD < CURR-TIME
                   MOVE 46014  TO CATREAD-MSG-NUMBER
                   CALL "CCATREAD" USING CATREAD-PARMS
                   MOVE CATREAD-MSG-TEXT TO ERRMSG
                   MOVE 5      TO FIELD-NUMBER
                   GO TO 62-TVT-EXIT.

       62-TVT-EXIT.            EXIT.

       63-UPDATE.
           IF LINE-1 NOT = SPACES
               MOVE LINE-1     TO LINE-HOLD
               PERFORM 63-WRITE-FILE THRU 63-WF-EXIT.

           IF LINE-2 NOT = SPACES
               MOVE LINE-2     TO LINE-HOLD
               PERFORM 63-WRITE-FILE THRU 63-WF-EXIT.

           IF LINE-3 NOT = SPACES
               MOVE LINE-3     TO LINE-HOLD
               PERFORM 63-WRITE-FILE THRU 63-WF-EXIT.

           IF LINE-4 NOT = SPACES
               MOVE LINE-4     TO LINE-HOLD
               PERFORM 63-WRITE-FILE THRU 63-WF-EXIT.

           IF LINE-5 NOT = SPACES
               MOVE LINE-5     TO LINE-HOLD
               PERFORM 63-WRITE-FILE THRU 63-WF-EXIT.

           IF LINE-6 NOT = SPACES
               MOVE LINE-6     TO LINE-HOLD
               PERFORM 63-WRITE-FILE THRU 63-WF-EXIT.

           IF LINE-7 NOT = SPACES
               MOVE LINE-7     TO LINE-HOLD
               PERFORM 63-WRITE-FILE THRU 63-WF-EXIT.
           GO TO 6-MAIN.

       63-WRITE-FILE.
           MOVE SPACES         TO HOT-CODE-DATA.
           MOVE ZONE-H         TO HC-ZONE.
           MOVE "1 "           TO HC-PRTY.
           MOVE EQP-NUM-H      TO HC-EQUIP-NUM.
           MOVE S-YY-H         TO HC-STRT-DATE-YY.
           MOVE S-MM-H         TO HC-STRT-DATE-MM.
           MOVE S-DD-H         TO HC-STRT-DATE-DD.
           IF DATE-FLAG = 3
               MOVE S-MM-H     TO HC-STRT-DATE-DD
               MOVE S-DD-H     TO HC-STRT-DATE-MM.
           MOVE 20             TO HC-STRT-DATE-CC.
           IF HC-STRT-DATE-YY > "70"
               MOVE 19         TO HC-STRT-DATE-CC.

           MOVE E-YY-H         TO HC-END-DATE-YY.
           MOVE E-MM-H         TO HC-END-DATE-MM.
           MOVE E-DD-H         TO HC-END-DATE-DD.
           IF DATE-FLAG = 3
               MOVE E-MM-H     TO HC-END-DATE-DD
               MOVE E-DD-H     TO HC-END-DATE-MM.
           MOVE 20             TO HC-END-DATE-CC.
           IF HC-END-DATE-YY > "70"
               MOVE 19         TO HC-END-DATE-CC.

           MOVE S-TIME-H       TO HC-STRT-TIME.
           MOVE E-TIME-H       TO HC-END-TIME.
           MOVE REM-H          TO HC-REMARKS.

           MOVE HOT-CODE-DATA  TO HC-REC.
           WRITE HC-REC.
           IF FILE-STAT NOT = "00"
               DISPLAY "  WRITE TO HOT-CODE-FILE ERROR:  " FILE-STAT
                       "  RECORD NOT ADDED.".

       63-WF-EXIT.             EXIT.

       END-OF-JOB.
           CLOSE               EQP-EQUIPMENT.
           CLOSE               EQP-HOT-CODE.
           CLOSE               DISPLAY-FILE.
           GOBACK.

