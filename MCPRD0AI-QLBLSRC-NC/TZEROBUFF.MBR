004500 COPY DVENDITM IN COPYLIB.
       COPY DPOITEM  IN COPYLIB.
       COPY DFREIGHT IN COPYLIB.
       COPY DPORECD  IN COPYLIB.
       COPY DINVACCT IN COPYLIB.
       COPY DINVITM  IN COPYLIB.
       COPY DINVRCD  IN COPYLIB.
       COPY DLEVEL   IN COPYLIB.
       COPY DPODATA  IN COPYLIB.
       COPY DQUOTEXT IN COPYLIB.
       COPY DRCVITEM IN COPYLIB.
       COPY DREQITM  IN COPYLIB.
       COPY DRESERVE IN COPYLIB.
       COPY DSHIPREL IN COPYLIB.
       COPY DVENDOR  IN COPYLIB.
       COPY MEMPL    IN COPYLIB.
       COPY MSTORERM IN COPYLIB.
007100
       COPY DBSTAT IN COPYLIB.

       01  BASE   PIC X(10) VALUE SPACES.
007400
007500 COPY TBLOWUP IN COPYLIB.
007600
007700 COPY VIEWDUM IN COPYLIB.
007800
       LINKAGE SECTION.
       01  UPDATE-SWITCH PIC X(1).
008400
008500 PROCEDURE DIVISION USING UPDATE-SWITCH.
       BEGIN-HERE.
           OPEN OUTPUT PRINT-FILE.
           STRING "UPDATE SWITCH IS ", UPDATE-SWITCH,
             DELIMITED BY SIZE INTO PRINT-REC.
           PERFORM 8000-WRITE-PRINT-REC.
           OPEN I-O DFREIGHT-O

           STRING "BEGINNING DFREIGHT  0 OF 14 DATASETS"
             DELIMITED BY SIZE INTO PRINT-REC.
           PERFORM 8000-WRITE-PRINT-REC.
008900     PERFORM 06-MAIN  THRU  06-M-X.

009000     CLOSE DFREIGHT-O.
           OPEN I-O DVENDITM-O

           STRING "BEGINNING DVENDITM  1 OF 14 DATASETS"
             DELIMITED BY SIZE INTO PRINT-REC.
           PERFORM 8000-WRITE-PRINT-REC.
008900     PERFORM 6-MAIN  THRU  6-M-X.

009000     CLOSE DVENDITM-O.
           STRING "BEGINNING DPOITEM   2 OF 14 DATASETS"
             DELIMITED BY SIZE INTO PRINT-REC.
           PERFORM 8000-WRITE-PRINT-REC.
           OPEN I-O DPOITEM-O.
           PERFORM 62-MAIN THRU 62-M-X.
           CLOSE DPOITEM-O.

           STRING "BEGINNING DINVACCT  3 OF 14 DATASETS"
             DELIMITED BY SIZE INTO PRINT-REC.
           PERFORM 8000-WRITE-PRINT-REC.
           OPEN I-O DINVACCT-O.
           PERFORM 63-MAIN THRU 63-M-X.
           CLOSE DINVACCT-O.

           STRING "BEGINNING DINVITM  4 OF 14 DATASETS"
             DELIMITED BY SIZE INTO PRINT-REC.
           PERFORM 8000-WRITE-PRINT-REC.
           OPEN I-O DINVITM-O.
           PERFORM 64-MAIN THRU 64-M-X.
           CLOSE DINVITM-O.

           STRING "BEGINNING DINVRCD   5 OF 14 DATASETS"
             DELIMITED BY SIZE INTO PRINT-REC.
           PERFORM 8000-WRITE-PRINT-REC.
           OPEN I-O DINVRCD-O.
           PERFORM 65-MAIN THRU 65-M-X.
           CLOSE DINVRCD-O.

           STRING "BEGINNING DLEVEL   6 OF 14 DATASETS"
             DELIMITED BY SIZE INTO PRINT-REC.
           PERFORM 8000-WRITE-PRINT-REC.
           OPEN I-O DLEVEL-O.
           PERFORM 66-MAIN THRU 66-M-X.
           CLOSE DLEVEL-O.

           STRING "BEGINNING DPODTAITM 7 OF 14 DATASETS"
             DELIMITED BY SIZE INTO PRINT-REC.
           PERFORM 8000-WRITE-PRINT-REC.
           OPEN I-O DPODTAITM-O.
           PERFORM 67-MAIN THRU 67-M-X.
           CLOSE DPODTAITM-O.

           STRING "BEGINNING DQUOTEXT 8 OF 14 DATASETS"
             DELIMITED BY SIZE INTO PRINT-REC.
           PERFORM 8000-WRITE-PRINT-REC.
           OPEN I-O DQUOTEXT-O.
           PERFORM 68-MAIN THRU 68-M-X.
           CLOSE DQUOTEXT-O.

           STRING "BEGINNING DRCVITEM  9 OF 14 DATASETS"
             DELIMITED BY SIZE INTO PRINT-REC.
           PERFORM 8000-WRITE-PRINT-REC.
           OPEN I-O DRCVITEM-O.
           PERFORM 69-MAIN THRU 69-M-X.
           CLOSE DRCVITEM-O.

           STRING "BEGINNING DREQITM 10 OF 14 DATASETS"
             DELIMITED BY SIZE INTO PRINT-REC.
           PERFORM 8000-WRITE-PRINT-REC.
           OPEN I-O DREQITM-O.
           PERFORM 70-MAIN THRU 70-M-X.
           CLOSE DREQITM-O.

           STRING "BEGINNING DRESERVE 11 OF 14 DATASETS"
             DELIMITED BY SIZE INTO PRINT-REC.
           PERFORM 8000-WRITE-PRINT-REC.
           OPEN I-O DRESERVE-O.
           PERFORM 71-MAIN THRU 71-M-X.
           CLOSE DRESERVE-O.

           STRING "BEGINNING DSHIPREL 12 OF 14 DATASETS"
             DELIMITED BY SIZE INTO PRINT-REC.
           PERFORM 8000-WRITE-PRINT-REC.
           OPEN I-O DSHIPREL-O.
           PERFORM 72-MAIN THRU 72-M-X.
           CLOSE DSHIPREL-O.

           STRING "BEGINNING DVENDOR  13 OF 14 DATASETS"
             DELIMITED BY SIZE INTO PRINT-REC.
           PERFORM 8000-WRITE-PRINT-REC.
           OPEN I-O DVENDOR-O.
           PERFORM 73-MAIN THRU 73-M-X.
           CLOSE DVENDOR-O.

           STRING "BEGINNING MEMPL   14 OF 14 DATASETS"
             DELIMITED BY SIZE INTO PRINT-REC.
           PERFORM 8000-WRITE-PRINT-REC.
           OPEN I-O MEMPL-O.
           PERFORM 74-MAIN THRU 74-M-X.
           CLOSE MEMPL-O.


           STRING "BEGINNING DPORECD 15 OF 14 DATASETS"
             DELIMITED BY SIZE INTO PRINT-REC.
           PERFORM 8000-WRITE-PRINT-REC.
           OPEN I-O DPORECD-O.
           PERFORM 75-MAIN THRU 75-M-X.
           CLOSE DPORECD-O.


           STRING "BEGINNING MSTORERM 16 OF 14 DATASETS"
             DELIMITED BY SIZE INTO PRINT-REC.
           PERFORM 8000-WRITE-PRINT-REC.
           OPEN I-O MSTORERM-O.
           PERFORM 76-MAIN THRU 76-M-X.
           CLOSE MSTORERM-O.

           CLOSE PRINT-FILE.
009100     GOBACK.
009200
009300
009400*******************************************************
009500**                                                   **
009600**   BLOWUP  ROUTINE                                 **
009700**                                                   **
009800*******************************************************
009900
010000 2-BLOWUP.
010100     MOVE "TZEROBUFF"      TO  BU-PGM-NAME.
010400     CALL "TBLOWUP" USING BASE, BU-PGM-NAME, STATUS-AREA,
010500         VIEW-COMAREA, FILE-STATUS, BU-DISPLAY-MSG,
010600             BU-DISPLAY-FLDS.
010700
010800 06-MAIN.
010900     READ DFREIGHT-O FIRST RECORD INTO BUF-DPOFREIGHT
               AT END GO TO 06-M-X.
           IF FILE-STATUS NOT = "00"
               MOVE "READ FIRST DFREIHGT *6-MAIN" TO BU-DISPLAY-MSG
               GO TO 2-BLOWUP.

           MOVE ZERO TO ERROR-RECORD-CTR.
011000     PERFORM 061-READ-FILE THRU 061-RF-X.

           STRING "TOTAL NO. OF RCDS WITH NON-NUMERIC DATA = ",
           ERROR-RECORD-CTR DELIMITED BY SIZE INTO PRINT-REC.
           PERFORM 8000-WRITE-PRINT-REC.

011100
       06-M-X.
011300     EXIT.
011400
011500 061-READ-FILE.
           MOVE SPACES TO ERR-SW.
           IF FRT-CHARGES-9   NOT NUMERIC
               MOVE "Y" TO ERR-SW
               MOVE ZEROS TO FRT-CHARGES-9.
           IF ERR-SW = "Y"
               ADD 1 TO ERROR-RECORD-CTR
               IF UPDATE-SWITCH = "U"
               REWRITE DFREIGHT-REC-O FROM BUF-DPOFREIGHT
                 INVALID KEY MOVE FILE-STATUS TO FILE-STATUS
               END-REWRITE
               IF FILE-STATUS NOT = "00"
                   MOVE "REWRITE DFREIGHT 61-RF" TO BU-DISPLAY-MSG
                   GO TO 2-BLOWUP.

           READ DFREIGHT-O NEXT RECORD INTO BUF-DPOFREIGHT
               AT END GO TO 061-RF-X.
           IF FILE-STATUS = "9D"
               GO TO 061-READ-FILE
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE "READ NEXT DFREIGHT *61-RF" TO BU-DISPLAY-MSG
               GO TO 2-BLOWUP.

           GO TO 061-READ-FILE.

       061-RF-X.
           EXIT.
010800 6-MAIN.
010900     READ DVENDITM-O FIRST RECORD INTO BUF-DVENDITM
               AT END GO TO 6-M-X.
           IF FILE-STATUS NOT = "00"
               MOVE "READ FIRST DVENDITM *6-MAIN" TO BU-DISPLAY-MSG
               GO TO 2-BLOWUP.

           MOVE ZERO TO ERROR-RECORD-CTR.
011000     PERFORM 61-READ-FILE THRU 61-RF-X.

           STRING "TOTAL NO. OF RCDS WITH NON-NUMERIC DATA = ",
           ERROR-RECORD-CTR DELIMITED BY SIZE INTO PRINT-REC.
           PERFORM 8000-WRITE-PRINT-REC.

011100
011200 6-M-X.
011300     EXIT.
011400
011500 61-READ-FILE.
           MOVE SPACES TO ERR-SW.
           IF VEN-ITM-YTD-BUS NOT NUMERIC
               MOVE "Y" TO ERR-SW
               MOVE ZEROS TO VEN-ITM-YTD-BUS.
           IF VEN-NONCODED-ITEM NOT NUMERIC
               MOVE "Y" TO ERR-SW
               MOVE ZEROS TO VEN-NONCODED-ITEM.
           IF VEN-DISCOUNT-PERCENT NOT NUMERIC
               MOVE "Y" TO ERR-SW
               MOVE ZEROS TO VEN-DISCOUNT-PERCENT.
           IF VEN-ITM-PRICE   NOT NUMERIC
               MOVE "Y" TO ERR-SW
               MOVE ZEROS TO VEN-ITM-PRICE.
           IF VEN-LOW-QTY (1)   NOT NUMERIC
               MOVE "Y" TO ERR-SW
               MOVE ZEROS TO VEN-LOW-QTY (1).
           IF VEN-HIGH-QTY (1)     NOT NUMERIC
               MOVE "Y" TO ERR-SW
               MOVE ZEROS TO VEN-HIGH-QTY (1).

           IF VEN-LOW-QTY (2)   NOT NUMERIC
               MOVE "Y" TO ERR-SW
               MOVE ZEROS TO VEN-LOW-QTY (2).
           IF VEN-HIGH-QTY (2)     NOT NUMERIC
               MOVE "Y" TO ERR-SW
               MOVE ZEROS TO VEN-HIGH-QTY (2).
           IF VEN-LOW-QTY (3)   NOT NUMERIC
               MOVE "Y" TO ERR-SW
               MOVE ZEROS TO VEN-LOW-QTY (3)
           IF VEN-HIGH-QTY (3)     NOT NUMERIC
               MOVE "Y" TO ERR-SW
               MOVE ZEROS TO VEN-HIGH-QTY (3).
           IF VEN-WORK-PRICE (1)   NOT NUMERIC
               MOVE "Y" TO ERR-SW
               MOVE ZEROS TO VEN-WORK-PRICE (1).
           IF VEN-WORK-PRICE (2)   NOT NUMERIC
               MOVE "Y" TO ERR-SW
               MOVE ZEROS TO VEN-WORK-PRICE (2).

           IF VEN-WORK-PRICE (3)   NOT NUMERIC
               MOVE "Y" TO ERR-SW
               MOVE ZEROS TO VEN-WORK-PRICE (3).
           IF VEN-BID-QTY          NOT NUMERIC
               MOVE "Y" TO ERR-SW
               MOVE ZEROS TO VEN-BID-QTY.

           IF VEN-SURCHARGE        NOT NUMERIC
               MOVE "Y" TO ERR-SW
               MOVE ZEROS TO VEN-SURCHARGE.

           IF ERR-SW = "Y"
               ADD 1 TO ERROR-RECORD-CTR
               IF UPDATE-SWITCH = "U"
               REWRITE DVENDITM-REC-O FROM BUF-DVENDITM
                  INVALID KEY MOVE FILE-STATUS TO FILE-STATUS
               END-REWRITE
               IF FILE-STATUS NOT = "00"
                   MOVE "REWRITE DVENDITM 61-RF" TO BU-DISPLAY-MSG
                   GO TO 2-BLOWUP.

           READ DVENDITM-O NEXT RECORD INTO BUF-DVENDITM
               AT END GO TO 61-RF-X.
           IF FILE-STATUS = "9D"
               GO TO 61-READ-FILE
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE "READ NEXT DVENDITM *61-RF" TO BU-DISPLAY-MSG
               GO TO 2-BLOWUP.

           GO TO 61-READ-FILE.

       61-RF-X.
           EXIT.
010800 62-MAIN.
010900     READ DPOITEM-O FIRST RECORD INTO BUF-DPOITEM
               AT END GO TO 62-M-X.
           IF FILE-STATUS NOT = "00"
               MOVE "READ FIRST DPOITEM *6-MAIN" TO BU-DISPLAY-MSG
               GO TO 2-BLOWUP.

           MOVE ZERO TO ERROR-RECORD-CTR.
011000     PERFORM 62-READ-FILE THRU 62-RF-X.

           STRING "TOTAL NO. OF RCDS WITH NON-NUMERIC DATA = ",
           ERROR-RECORD-CTR DELIMITED BY SIZE INTO PRINT-REC.
           PERFORM 8000-WRITE-PRINT-REC.

011100
011200 62-M-X.
011300     EXIT.
011400
011500 62-READ-FILE.
           MOVE SPACES TO ERR-SW.
           IF ITM-QTY-ORD NOT NUMERIC
               MOVE "Y" TO ERR-SW
               MOVE ZEROS TO ITM-QTY-ORD.
           IF ITM-QTY-DLVR NOT NUMERIC
               MOVE "Y" TO ERR-SW
               MOVE ZEROS TO ITM-QTY-DLVR.
           IF ITM-QTY-STORED NOT NUMERIC
               MOVE "Y" TO ERR-SW
               MOVE ZEROS TO ITM-QTY-STORED.
           IF ITM-QTY-PAID NOT NUMERIC
               MOVE "Y" TO ERR-SW
               MOVE ZEROS TO ITM-QTY-PAID.
           IF ITM-KELLY-PO-QTY NOT NUMERIC
               MOVE "Y" TO ERR-SW
               MOVE ZEROS TO ITM-KELLY-PO-QTY.
           IF ITM-UNIT-PRICE   NOT NUMERIC
               MOVE "Y" TO ERR-SW
               MOVE ZEROS TO ITM-UNIT-PRICE.
           IF ITM-ZBILL-VALUE  NOT NUMERIC
               MOVE "Y" TO ERR-SW
               MOVE ZEROS TO ITM-ZBILL-VALUE.
           IF ERR-SW = "Y"
               ADD 1 TO ERROR-RECORD-CTR
               IF UPDATE-SWITCH = "U"
               REWRITE DPOITEM-REC-O FROM BUF-DPOITEM
                  INVALID KEY MOVE FILE-STATUS TO FILE-STATUS
               END-REWRITE
               IF FILE-STATUS NOT = "00"
                   MOVE "REWRITE DPOITEM  61-RF" TO BU-DISPLAY-MSG
                   GO TO 2-BLOWUP.

           READ DPOITEM-O NEXT RECORD INTO BUF-DPOITEM
               AT END GO TO 62-RF-X.
           IF FILE-STATUS = "9D"
               GO TO 62-READ-FILE
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE "READ NEXT DPOITEM  *61-RF" TO BU-DISPLAY-MSG
               GO TO 2-BLOWUP.

           GO TO 62-READ-FILE.

       62-RF-X.
           EXIT.
010800 63-MAIN.
010900     READ DINVACCT-O FIRST RECORD INTO BUF-DINVACCT
               AT END GO TO 63-M-X.
           IF FILE-STATUS NOT = "00"
               MOVE "READ FIRST DINVACCT*6-MAIN" TO BU-DISPLAY-MSG
               GO TO 2-BLOWUP.

           MOVE ZERO TO ERROR-RECORD-CTR.
011000     PERFORM 63-READ-FILE THRU 63-RF-X.

           STRING "TOTAL DINVACCT RCDS WITH NON-NUMERIC DATA = ",
           ERROR-RECORD-CTR DELIMITED BY SIZE INTO PRINT-REC.
           PERFORM 8000-WRITE-PRINT-REC.

011100
011200 63-M-X.
011300     EXIT.
011400
011500 63-READ-FILE.
           MOVE SPACES TO ERR-SW.
           IF INVACCT-PCT NOT NUMERIC
               MOVE "Y" TO ERR-SW
               MOVE ZEROS TO INVACCT-PCT.
           IF INVACCT-ITEM NOT NUMERIC
               MOVE "Y" TO ERR-SW
               MOVE ZEROS TO INVACCT-ITEM.
           IF INVACCT-LINE NOT NUMERIC
               MOVE "Y" TO ERR-SW
               MOVE ZEROS TO INVACCT-LINE.
           IF ERR-SW = "Y"
