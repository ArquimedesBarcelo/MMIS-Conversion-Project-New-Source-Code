               MOVE "Y" TO ERR-SW
               MOVE ZEROS TO PO-BUDGET-AMT.
           IF ERR-SW = "Y"
               ADD 1 TO ERROR-RECORD-CTR
               IF UPDATE-SWITCH = "U"
               REWRITE DPORECD-REC-O FROM BUF-DPORECD
                  INVALID KEY MOVE FILE-STATUS TO FILE-STATUS
               END-REWRITE
               IF FILE-STATUS NOT = "00"
                   MOVE "REWRITE DPORECD 61-RF" TO BU-DISPLAY-MSG
                   GO TO 2-BLOWUP.

           READ DPORECD-O NEXT RECORD INTO BUF-DPORECD
               AT END GO TO 75-RF-X.
           IF FILE-STATUS = "9D"
               GO TO 75-READ-FILE
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE "READ NEXT DPORECD  *61-RF" TO BU-DISPLAY-MSG
               GO TO 2-BLOWUP.

           GO TO 75-READ-FILE.

       75-RF-X.
           EXIT.
010800 76-MAIN.
010900     READ MSTORERM-O  FIRST RECORD INTO BUF-MSTORERM
               AT END GO TO 76-M-X.
           IF FILE-STATUS NOT = "00"
               MOVE "READ FIRST MSTORERM  *76-MAIN" TO BU-DISPLAY-MSG
               GO TO 2-BLOWUP.

           MOVE ZERO TO ERROR-RECORD-CTR.
011000     PERFORM 76-READ-FILE THRU 76-RF-X.

           STRING "TOTAL MSTORERM  RCDS WITH NON-NUMERIC DATA = ",
           ERROR-RECORD-CTR DELIMITED BY SIZE INTO PRINT-REC.
           PERFORM 8000-WRITE-PRINT-REC.

011200 76-M-X.
           EXIT.

       76-READ-FILE.
           MOVE SPACES TO ERR-SW.
      *    IF STR-EOQ           NOT NUMERIC
      *        MOVE "Y" TO ERR-SW
      *        MOVE ZEROS TO STR-EOQ.
      *    IF STR-REORDER       NOT NUMERIC
      *        MOVE "Y" TO ERR-SW
      *        MOVE ZEROS TO STR-REORDER.
      *    IF STR-MAX           NOT NUMERIC
      *        MOVE "Y" TO ERR-SW
      *        MOVE ZEROS TO STR-MAX.
      *    IF STR-EXPEDITE      NOT NUMERIC
      *        MOVE "Y" TO ERR-SW
      *        MOVE ZEROS TO STR-EXPEDITE.
           IF STR-STD-COST      NOT NUMERIC
               MOVE "Y" TO ERR-SW
               MOVE ZEROS TO STR-STD-COST.
           IF STR-AVG-COST      NOT NUMERIC
               MOVE "Y" TO ERR-SW
               MOVE ZEROS TO STR-AVG-COST.
           IF STR-PREV-AVG      NOT NUMERIC
               MOVE "Y" TO ERR-SW
               MOVE ZEROS TO STR-PREV-AVG.
           IF STR-UM1-CF        NOT NUMERIC
               MOVE "Y" TO ERR-SW
               MOVE ZEROS TO STR-UM1-CF.
           IF STR-UM2-CF        NOT NUMERIC
               MOVE "Y" TO ERR-SW
               MOVE ZEROS TO STR-UM2-CF.
      *    IF STR-EST-LT        NOT NUMERIC
      *        MOVE "Y" TO ERR-SW
      *        MOVE ZEROS TO STR-EST-LT.
      *    IF STR-LAST-DLVTIMES(1) NOT NUMERIC
      *        MOVE "Y" TO ERR-SW
      *        MOVE ZEROS TO STR-LAST-DLVTIMES(1).
      *    IF STR-LAST-DLVTIMES(2) NOT NUMERIC
      *        MOVE "Y" TO ERR-SW
      *        MOVE ZEROS TO STR-LAST-DLVTIMES(2).
      *    IF STR-LAST-DLVTIMES(3) NOT NUMERIC
      *        MOVE "Y" TO ERR-SW
      *        MOVE ZEROS TO STR-LAST-DLVTIMES(3).
           IF STR-PHY-INV-CYL-9 NOT NUMERIC
               MOVE "Y" TO ERR-SW
               MOVE ZEROS TO STR-PHY-INV-CYL-9.
           IF STR-MKT-COST      NOT NUMERIC
               MOVE "Y" TO ERR-SW
               MOVE ZEROS TO STR-MKT-COST.
           IF STR-OUT-REPAIR-COST NOT NUMERIC
               MOVE "Y" TO ERR-SW
               MOVE ZEROS TO STR-OUT-REPAIR-COST.
           IF STR-MAINT-REPAIR-COST NOT NUMERIC
               MOVE "Y" TO ERR-SW
               MOVE ZEROS TO STR-MAINT-REPAIR-COST.
      *    IF STR-MTH-FCST          NOT NUMERIC
      *        MOVE "Y" TO ERR-SW
      *        MOVE ZEROS TO STR-MTH-FCST.
      *    IF STR-ONHAND            NOT NUMERIC
      *        MOVE "Y" TO ERR-SW
      *        MOVE ZEROS TO STR-ONHAND.
      *    IF STR-ONORDER           NOT NUMERIC
      *        MOVE "Y" TO ERR-SW
      *        MOVE ZEROS TO STR-ONORDER.
      *    IF STR-RESERVED          NOT NUMERIC
      *        MOVE "Y" TO ERR-SW
      *        MOVE ZEROS TO STR-RESERVED.
      *    IF STR-RSRV-ONORD        NOT NUMERIC
      *        MOVE "Y" TO ERR-SW
      *        MOVE ZEROS TO STR-RSRV-ONORD.
      *    IF STR-LOC-ONHAND(1)     NOT NUMERIC
      *        MOVE "Y" TO ERR-SW
      *        MOVE ZEROS TO STR-LOC-ONHAND(1).
      *    IF STR-LOC-ONHAND(2)     NOT NUMERIC
      *        MOVE "Y" TO ERR-SW
      *        MOVE ZEROS TO STR-LOC-ONHAND(2).
      *    IF STR-LOC-ONHAND(3)     NOT NUMERIC
      *        MOVE "Y" TO ERR-SW
      *        MOVE ZEROS TO STR-LOC-ONHAND(3).
      *    IF STR-LOC-ONHAND(4)     NOT NUMERIC
      *        MOVE "Y" TO ERR-SW
      *        MOVE ZEROS TO STR-LOC-ONHAND(4).
      *    IF STR-LOC-ONHAND(5)     NOT NUMERIC
      *        MOVE "Y" TO ERR-SW
      *        MOVE ZEROS TO STR-LOC-ONHAND(5).
      *    IF STR-LOC-ONHAND(6)     NOT NUMERIC
      *        MOVE "Y" TO ERR-SW
      *        MOVE ZEROS TO STR-LOC-ONHAND(6).
      *    IF STR-TAX-PERCENT       NOT NUMERIC
      *        MOVE "Y" TO ERR-SW
      *        MOVE ZEROS TO STR-TAX-PERCENT.
      *    IF STR-SOQ               NOT NUMERIC
      *        MOVE "Y" TO ERR-SW
      *        MOVE ZEROS TO STR-SOQ.
           IF STR-RAW-LOT           NOT NUMERIC
               MOVE "Y" TO ERR-SW
               MOVE ZEROS TO STR-RAW-LOT.
           IF ERR-SW = "Y"
               ADD 1 TO ERROR-RECORD-CTR
               IF UPDATE-SWITCH = "U"
               REWRITE MSTORERM-REC-O FROM BUF-MSTORERM
                  INVALID KEY MOVE FILE-STATUS TO FILE-STATUS
               END-REWRITE
               IF FILE-STATUS NOT = "00"
                   MOVE "REWRITE MSTORERM   76-RF" TO BU-DISPLAY-MSG
                   GO TO 2-BLOWUP.


           READ MSTORERM-O NEXT RECORD INTO BUF-MSTORERM
               AT END GO TO 76-RF-X.
           IF FILE-STATUS = "9D"
               GO TO 76-READ-FILE
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE "READ NEXT MSTORERM *76-RF" TO BU-DISPLAY-MSG
               GO TO 2-BLOWUP.

           GO TO 76-READ-FILE.

       76-RF-X.
           EXIT.

       8000-WRITE-PRINT-REC.
           WRITE PRINT-REC AFTER ADVANCING 1.
           MOVE SPACES TO PRINT-REC.

