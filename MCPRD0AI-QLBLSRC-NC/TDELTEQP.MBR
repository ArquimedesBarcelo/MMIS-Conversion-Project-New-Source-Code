       IDENTIFICATION DIVISION.
       PROGRAM-ID.    TDELTEQP.
      *C
      *C 09/05/96  JEFF BUNGO
      *C    EXPAND DATE FIELDS FOR YEAR 2000 COMPLIANCE.
      *C    RECOMPILE TO PICK UP DATABASE CHANGES.
      *C
       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.
       SOURCE-COMPUTER.   AS400.
       OBJECT-COMPUTER.   AS400.
       SPECIAL-NAMES. I-O-FEEDBACK IS I-O-FEEDBACK-AREA
                      LOCAL-DATA IS LOCAL-DATA-AREA.
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT BASIC-FILE
                  ASSIGN TO DATABASE-MCFLMM1003
                  ORGANIZATION IS INDEXED
                  ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                      WITH DUPLICATES
                  FILE STATUS IS BF-STATUS.
           SELECT DISPLAY-FILE
                  ASSIGN TO WORKSTATION-ZDELTEQP-SI
                  ORGANIZATION IS TRANSACTION
                  ACCESS IS SEQUENTIAL
                  FILE STATUS IS DSPLY-STATUS
                  CONTROL-AREA IS WS-CONTROL.
           SELECT DRAWING-FILE
                  ASSIGN TO DATABASE-MCFLDF0103
                  ORGANIZATION IS INDEXED
                  ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                      WITH DUPLICATES
                  FILE STATUS IS DRAW-STATUS.
           SELECT EQUIPMENT-FILE
                  ASSIGN TO DATABASE-MCFLMM0201
                  ORGANIZATION IS INDEXED
                  ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                  FILE STATUS IS EF-STATUS.
           SELECT EQP-OPERATIONS-FILE
                  ASSIGN TO DATABASE-MCFLER0501
                  ORGANIZATION IS INDEXED
                  ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                      WITH DUPLICATES
                  FILE STATUS IS EOP-STATUS.
           SELECT EQP-REFERENCE-FILE
                  ASSIGN TO DATABASE-MCFLER0101
                  ORGANIZATION IS INDEXED
                  ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                      WITH DUPLICATES
                  FILE STATUS IS ERF-STATUS.
           SELECT EQP-REMARKS-FILE
                  ASSIGN TO DATABASE-MCFLER0301
                  ORGANIZATION IS INDEXED
                  ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                      WITH DUPLICATES
                  FILE STATUS IS ERM-STATUS.
           SELECT HOT-CODE-FILE
                  ASSIGN TO DATABASE-MCFLMM2002
                  ORGANIZATION IS INDEXED
                  ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                      WITH DUPLICATES
                  FILE STATUS IS HCF-STATUS.
           SELECT PLANNED-FILE
                  ASSIGN TO DATABASE-MCFLMM1103
                  ORGANIZATION IS INDEXED
                  ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                      WITH DUPLICATES
                  FILE STATUS IS PF-STATUS.
           SELECT PM-OPENQ-FILE
                  ASSIGN TO DATABASE-MCFLMM3902
                  ORGANIZATION IS INDEXED
                  ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                      WITH DUPLICATES
                  FILE STATUS IS POF-STATUS.
           SELECT PM-SCHEDULE
                  ASSIGN TO DATABASE-MCFLMM4403
                  ORGANIZATION IS INDEXED
                  ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                      WITH DUPLICATES
                  FILE STATUS IS PMF-STATUS.
           SELECT SCHEDULE-FILE
                  ASSIGN TO DATABASE-MCFLMM2303
                  ORGANIZATION IS INDEXED
                  ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                      WITH DUPLICATES
                  FILE STATUS IS SF-STATUS.
           SELECT WO-OPENQ-FILE
                  ASSIGN TO DATABASE-MCFLMM1904
                  ORGANIZATION IS INDEXED
                  ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                      WITH DUPLICATES
                  FILE STATUS IS WOF-STATUS.
       DATA DIVISION.
       FILE SECTION.
       FD  BASIC-FILE
           LABEL RECORDS ARE STANDARD
           DATA RECORD IS BFREC.
       01  BFREC.
           COPY DDS-ALL-FORMATS OF MCFLMM1003.
       FD  DISPLAY-FILE
           LABEL RECORDS ARE OMITTED.
       01  DSPLY-REC               PIC X(2000).
       FD  DRAWING-FILE
           LABEL RECORDS ARE STANDARD
           DATA RECORD IS DRAW-RCD.
       01  DRAW-RCD.
           COPY DDS-ALL-FORMATS OF MCFLDF0103.
       FD  EQUIPMENT-FILE
           LABEL RECORDS ARE STANDARD.
       01  EFREC.
           COPY DDS-ALL-FORMATS OF MCFLMM0201.
       FD  EQP-OPERATIONS-FILE
           LABEL RECORDS ARE STANDARD
           DATA RECORD IS EQP-OPS-RCD.
       01  EQP-OPS-RCD.
           COPY DDS-ALL-FORMATS OF MCFLER0501.
       FD  EQP-REFERENCE-FILE
           LABEL RECORDS ARE STANDARD
           DATA RECORD IS EQP-REF-RCD.
       01  EQP-REF-RCD.
           COPY DDS-ALL-FORMATS OF MCFLER0101.
       FD  EQP-REMARKS-FILE
           LABEL RECORDS ARE STANDARD
           DATA RECORD IS EQP-RMK-RCD.
       01  EQP-RMK-RCD.
           COPY DDS-ALL-FORMATS OF MCFLER0301.
       FD  HOT-CODE-FILE
           LABEL RECORDS ARE STANDARD
           DATA RECORD IS HCFREC.
       01  HCFREC.
           COPY DDS-ALL-FORMATS OF MCFLMM2002.
       FD  PLANNED-FILE
           LABEL RECORDS ARE STANDARD
           DATA RECORD IS PFREC.
       01  PFREC.
           COPY DDS-ALL-FORMATS OF MCFLMM1103.
       FD  PM-OPENQ-FILE
           LABEL RECORDS ARE STANDARD
           DATA RECORD IS POFREC.
       01  POFREC.
           COPY DDS-ALL-FORMATS OF MCFLMM3902.
       FD  PM-SCHEDULE
           LABEL RECORDS ARE STANDARD
           DATA RECORD IS PMFREC.
       01  PMFREC.
           COPY DDS-ALL-FORMATS OF MCFLMM4403.
       FD  SCHEDULE-FILE
           LABEL RECORDS ARE STANDARD
           DATA RECORD IS SFREC.
       01  SFREC.
           COPY DDS-ALL-FORMATS OF MCFLMM2303.
       FD  WO-OPENQ-FILE
           LABEL RECORDS ARE STANDARD
           DATA RECORD IS WOFREC.
       01  WOFREC.
           COPY DDS-ALL-FORMATS OF MCFLMM1904.
       WORKING-STORAGE SECTION.
       COPY CATREAD OF COPYLIB.
       COPY CPYIND  OF COPYLIB.
       01  DBPARAMETERS.           COPY DBPARMS OF COPYLIB.
       01  EQPNUMBUFFER1.
           COPY MEQPFILE OF COPYLIB.
       01  EQUIPMENT-KEY.
           05  EQUIPMENT-NUM                  PIC X(6).
           05  EQUIPMENT-SUB                  PIC X(4).
       01  ERROR-BUFFER.
           05  FILLER                         PIC X(31).
           05  ERR-FILE                       PIC X(12).
           05  FILLER                         PIC X(37).
       01  FILE-STATUSES.
           05  BF-STATUS                      PIC XX.
           05  DRAW-STATUS                     PIC XX.
           05  DSPLY-STATUS                   PIC XX.
           05  EF-STATUS                      PIC XX.
           05  EOP-STATUS                     PIC XX.
           05  ERF-STATUS                     PIC XX.
           05  ERM-STATUS                     PIC XX.
           05  HCF-STATUS                     PIC XX.
           05  PF-STATUS                      PIC XX.
           05  PMF-STATUS                     PIC XX.
           05  POF-STATUS                     PIC XX.
           05  PTF-STATUS                     PIC XX.
           05  SF-STATUS                      PIC XX.
           05  WOF-STATUS                     PIC XX.
       01  HOT-CODE-DATA.                    COPY DHOTCODE OF COPYLIB.
       COPY IOFEEDBACK OF COPYLIB.
       01  PFKEY                              PIC 9(9).
       01  PM-OPENQ-DATA.                    COPY DPMOPENQ OF COPYLIB.
       01  PM-TRANS-DATA.                    COPY TRANSFIL OF COPYLIB.
       01  PM-SCHED-DATA.                    COPY DPMSCHED OF COPYLIB.
       01  SCHEDULE-DATA.                    COPY DWOSCHED OF COPYLIB.
       01  SCREEN-BUFFER1.
           05  S-EQUIP-START.
               10  S-EQUIP-S-1     PIC X.
               10  S-EQUIP-S-2     PIC X.
               10  S-EQUIP-S-3     PIC X.
               10  S-EQUIP-S-4     PIC X.
               10  S-EQUIP-S-5     PIC X.
               10  S-EQUIP-S-6     PIC X.
           05  S-EQUIP-END.
               10  S-EQUIP-E-1     PIC X.
               10  S-EQUIP-E-2     PIC X.
               10  S-EQUIP-E-3     PIC X.
               10  S-EQUIP-E-4     PIC X.
               10  S-EQUIP-E-5     PIC X.
               10  S-EQUIP-E-6     PIC X.
           05  SCREEN-CMD-LINE1.
               10  SCREEN-CMD-LIT1 PIC X(73).
               10  SCREEN-CMD-VAR1 PIC X(6).
           05  SCREEN-ERR-LINE1    PIC X(79).
       COPY DBSTAT      OF COPYLIB.
       01  TRUE-VAL                PIC 1 VALUE B"1".
       01  WO-BASIC-DATA.                    COPY DWOBASIC OF COPYLIB.
       01  WO-OPENQ-DATA.                    COPY DWOOPENQ OF COPYLIB.
       01  WO-PLANNED-DATA.                  COPY DWOPLAN  OF COPYLIB.
           COPY MEQPREF OF COPYLIB.
           COPY DEQPREM OF COPYLIB.
           COPY DEQPOPS OF COPYLIB.
       01  WO-DRAWING-DATA.                  COPY DDRAWFIL OF COPYLIB.
       COPY VCOMLINK    OF COPYLIB.
       COPY WSCONTROL   OF COPYLIB.
       PROCEDURE DIVISION.
       START-PROGRAM.
           OPEN I-O   BASIC-FILE.
           OPEN I-O   DISPLAY-FILE.
           OPEN I-O   DRAWING-FILE.
           OPEN I-O   EQUIPMENT-FILE.
           OPEN I-O   EQP-OPERATIONS-FILE.
           OPEN I-O   EQP-REFERENCE-FILE.
           OPEN I-O   EQP-REMARKS-FILE.
           OPEN I-O   HOT-CODE-FILE.
           OPEN I-O   PLANNED-FILE.
           OPEN I-O   PM-OPENQ-FILE.
           OPEN I-O   PM-SCHEDULE.
           OPEN I-O   SCHEDULE-FILE.
           OPEN I-O   WO-OPENQ-FILE.
           MOVE 0 TO VIEW-LASTKEY.
           PERFORM 6-MAIN UNTIL VIEW-LASTKEY = 3.

       2-EOJ.
           CLOSE BASIC-FILE.
           CLOSE DISPLAY-FILE.
           CLOSE DRAWING-FILE.
           CLOSE EQP-OPERATIONS-FILE.
           CLOSE EQP-REFERENCE-FILE.
           CLOSE EQP-REMARKS-FILE.
           CLOSE EQUIPMENT-FILE.
           CLOSE HOT-CODE-FILE.
           CLOSE PLANNED-FILE.
           CLOSE PM-OPENQ-FILE.
           CLOSE PM-SCHEDULE.
           CLOSE SCHEDULE-FILE.
           CLOSE WO-OPENQ-FILE.
           GOBACK.

       5-START-EQUIPMENT-FILE.
           MOVE 0 TO COND-WORD.
           MOVE S-EQUIP-START TO EQPNUM OF EFREC.
           START EQUIPMENT-FILE KEY > EXTERNALLY-DESCRIBED-KEY
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF EF-STATUS NOT = "00" MOVE 17 TO COND-WORD.

       5-READ-EQUIPMENT-FILE.
           MOVE 0 TO COND-WORD.
           READ EQUIPMENT-FILE NEXT INTO EQPNUMBUFFER1
               AT END    MOVE 15 TO COND-WORD.
           IF EF-STATUS NOT = "00" MOVE 15 TO COND-WORD.
           IF EQP-EQUIP-NUM NOT < S-EQUIP-START AND
               EQP-EQUIP-NUM NOT > S-EQUIP-END
               NEXT SENTENCE
           ELSE
           MOVE 15 TO COND-WORD.

       6-MAIN.
           PERFORM 60-SHOW-SCREEN.
           PERFORM 61-READ-SCREEN THRU 61-RSE-EXIT.

       60-SHOW-SCREEN.
           MOVE "FDELTEQP" TO VIEW-CFNAME.
           MOVE SPACES TO SCREEN-BUFFER1.
           MOVE SCREEN-BUFFER1 TO DSPLY-REC.
           PERFORM 99-SCREEN-WRITE.

       61-READ-SCREEN.
           PERFORM 98-SCREEN-READ.
           IF VIEW-LASTKEY = 3 GO TO 61-RSE-EXIT.
           IF VIEW-LASTKEY = 0
               NEXT SENTENCE
           ELSE
           MOVE 35126 TO CATREAD-MSG-NUMBER
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
           MOVE TRUE-VAL TO INDS (1) INDS (99)
           MOVE ERROR-BUFFER TO SCREEN-ERR-LINE1
           MOVE SCREEN-BUFFER1 TO DSPLY-REC
           PERFORM 99-SCREEN-WRITE
           GO TO 61-READ-SCREEN.
           MOVE DSPLY-REC TO SCREEN-BUFFER1.
           IF S-EQUIP-START = "      "
                MOVE 14069 TO CATREAD-MSG-NUMBER
                PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                MOVE TRUE-VAL TO INDS (1) INDS (99)
                MOVE ERROR-BUFFER TO SCREEN-ERR-LINE1
                PERFORM 99-SCREEN-WRITE
                GO TO 61-READ-SCREEN.
           PERFORM 5-START-EQUIPMENT-FILE.
           IF COND-WORD = 17
                MOVE 40022 TO CATREAD-MSG-NUMBER
                PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                MOVE TRUE-VAL TO INDS (1) INDS (99)
                MOVE ERROR-BUFFER TO SCREEN-ERR-LINE1
                PERFORM 99-SCREEN-WRITE
                GO TO 61-READ-SCREEN.
           PERFORM 610-MOD-EQPNUM-SETS THRU 610-MES-EXIT
               UNTIL (COND-WORD = 15) OR (VIEW-LASTKEY = 3).
           MOVE 0 TO COND-WORD VIEW-LASTKEY.
       61-RSE-EXIT.    EXIT.

       610-MOD-EQPNUM-SETS.
           PERFORM 5-READ-EQUIPMENT-FILE.
           IF COND-WORD = 15
               CLOSE EQUIPMENT-FILE
               OPEN I-O EQUIPMENT-FILE
               GO TO 610-MES-EXIT.

           MOVE TRUE-VAL           TO INDS (98).
           MOVE "CHECKING OTHER FILES             FOR EQUIPMENT NUMBER "
               TO SCREEN-CMD-LIT1.
           MOVE EQP-EQUIP-NUM      TO SCREEN-CMD-VAR1.
           MOVE SCREEN-BUFFER1     TO DSPLY-REC.
           PERFORM 99-SCREEN-WRITE.
           PERFORM 98A-SCREEN-READ.
           CALL "CLPAUSE2".
           MOVE 0                  TO COND-WORD.
           MOVE EQP-EQUIP-NUM      TO EQPNUM OF BFREC.
           START BASIC-FILE KEY = EXTERNALLY-DESCRIBED-KEY
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF BF-STATUS NOT = "00" MOVE 17 TO COND-WORD.
           IF COND-WORD = 0
               MOVE "VERBAL WO'S            EXIST FOR EQUIPMENT NUMBER "
                   TO SCREEN-CMD-LIT1
               MOVE EQP-EQUIP-NUM  TO SCREEN-CMD-VAR1
               MOVE SCREEN-BUFFER1 TO DSPLY-REC
               PERFORM 99-SCREEN-WRITE
               CALL "CLPAUSE2"
               PERFORM 98A-SCREEN-READ
               GO TO 610-MOD-EQPNUM-SETS.

      *    MOVE TRUE-VAL           TO INDS (98).
      *    MOVE "CHECKING PLANNED FILE            FOR EQUIPMENT NUMBER "
      *        TO SCREEN-CMD-LIT1.
      *    MOVE EQP-EQUIP-NUM      TO SCREEN-CMD-VAR1.
      *    MOVE SCREEN-BUFFER1     TO DSPLY-REC.
      *    PERFORM 99-SCREEN-WRITE.
      *    PERFORM 98A-SCREEN-READ.
           MOVE 0                  TO COND-WORD.
           MOVE EQP-EQUIP-NUM      TO EQPNUM OF PFREC.
           START PLANNED-FILE KEY = EXTERNALLY-DESCRIBED-KEY
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF PF-STATUS NOT = "00" MOVE 17 TO COND-WORD.
           IF COND-WORD = 0
               MOVE "PLANNED W/O    ENTRIES EXIST FOR EQUIPMENT NUMBER "
                   TO SCREEN-CMD-LIT1
               MOVE EQP-EQUIP-NUM  TO SCREEN-CMD-VAR1
               MOVE SCREEN-BUFFER1 TO DSPLY-REC
               PERFORM 99-SCREEN-WRITE
               CALL "CLPAUSE2"
               PERFORM 98A-SCREEN-READ
               GO TO 610-MOD-EQPNUM-SETS.

           MOVE TRUE-VAL           TO INDS (98).
      *    MOVE "CHECKING DRAWING FILE            FOR EQUIPMENT NUMBER "
      *        TO SCREEN-CMD-LIT1.
      *    MOVE EQP-EQUIP-NUM      TO SCREEN-CMD-VAR1.
      *    MOVE SCREEN-BUFFER1     TO DSPLY-REC.
      *    PERFORM 99-SCREEN-WRITE.
      *    PERFORM 98A-SCREEN-READ.
           MOVE 0                  TO COND-WORD.
           MOVE EQP-EQUIP-NUM      TO DRWEQPNUM OF DRAW-RCD.
           START DRAWING-FILE KEY = EXTERNALLY-DESCRIBED-KEY
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF DRAW-STATUS NOT = "00" MOVE 17 TO COND-WORD.
           IF COND-WORD = 0
               MOVE "DRAWING        ENTRIES EXIST FOR EQUIPMENT NUMBER "
                   TO SCREEN-CMD-LIT1
               MOVE EQP-EQUIP-NUM  TO SCREEN-CMD-VAR1
               MOVE SCREEN-BUFFER1 TO DSPLY-REC
               PERFORM 99-SCREEN-WRITE
               CALL "CLPAUSE2"
               PERFORM 98A-SCREEN-READ
               GO TO 610-MOD-EQPNUM-SETS.

      *    MOVE TRUE-VAL           TO INDS (98).
      *    MOVE "CHECKING EQP-OPERATIONS FILE     FOR EQUIPMENT NUMBER "
      *        TO SCREEN-CMD-LIT1.
      *    MOVE EQP-EQUIP-NUM      TO SCREEN-CMD-VAR1.
      *    MOVE SCREEN-BUFFER1     TO DSPLY-REC.
      *    PERFORM 99-SCREEN-WRITE.
      *    PERFORM 98A-SCREEN-READ.
           MOVE 0                  TO COND-WORD.
           MOVE SPACES             TO EQUIPMENT-KEY.
           MOVE EQP-EQUIP-NUM      TO EQUIPMENT-NUM.
           MOVE EQUIPMENT-KEY      TO EQRSUBKEY OF EQP-OPS-RCD.
           START EQP-OPERATIONS-FILE KEY > EXTERNALLY-DESCRIBED-KEY
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF EOP-STATUS NOT = "00" MOVE 17 TO COND-WORD.
           IF COND-WORD = 17 GO TO 610-MES-EXIT.
           PERFORM MOD-EQP-OPERATIONS-EQPNUMS  THRU MEOPE-EXIT.
           IF COND-WORD = 15
               MOVE "EQP OPERATIONS ENTRIES EXIST FOR EQUIPMENT NUMBER "
                   TO SCREEN-CMD-LIT1
               MOVE EQP-EQUIP-NUM  TO SCREEN-CMD-VAR1
               MOVE SCREEN-BUFFER1 TO DSPLY-REC
               PERFORM 99-SCREEN-WRITE
               CALL "CLPAUSE2"
               PERFORM 98A-SCREEN-READ
               GO TO 610-MOD-EQPNUM-SETS.

      *    MOVE TRUE-VAL           TO INDS (98).
      *    MOVE "CHECKING EQP-REFERENCE FILE      FOR EQUIPMENT NUMBER "
      *        TO SCREEN-CMD-LIT1.
      *    MOVE EQP-EQUIP-NUM      TO SCREEN-CMD-VAR1.
      *    MOVE SCREEN-BUFFER1     TO DSPLY-REC.
      *    PERFORM 99-SCREEN-WRITE.
      *    PERFORM 98A-SCREEN-READ.
           MOVE 0                  TO COND-WORD.
           MOVE SPACES             TO EQUIPMENT-KEY.
           MOVE EQP-EQUIP-NUM      TO EQUIPMENT-NUM.
           MOVE EQUIPMENT-KEY      TO EQRSUBKEY OF EQP-REF-RCD.
           START EQP-REFERENCE-FILE KEY > EXTERNALLY-DESCRIBED-KEY
               INVALID KEY   MOVE 17 TO COND-WORD.
           IF ERF-STATUS NOT = "00" MOVE 17 TO COND-WORD.
           IF COND-WORD = 17 GO TO 610-MES-EXIT.
           PERFORM MOD-EQP-REFERENCE-EQPNUMS  THRU MERFE-EXIT.
           IF COND-WORD = 15
               MOVE "EQP REFERENCE  ENTRIES EXIST FOR EQUIPMENT NUMBER "
                   TO SCREEN-CMD-LIT1
               MOVE EQP-EQUIP-NUM  TO SCREEN-CMD-VAR1
               MOVE SCREEN-BUFFER1 TO DSPLY-REC
               PERFORM 99-SCREEN-WRITE
               CALL "CLPAUSE2"
               PERFORM 98A-SCREEN-READ
               GO TO 610-MOD-EQPNUM-SETS.

      *    MOVE TRUE-VAL           TO INDS (98).
      *    MOVE "CHECKING EQP-REMARKS-FILE        FOR EQUIPMENT NUMBER "
      *        TO SCREEN-CMD-LIT1.
      *    MOVE EQP-EQUIP-NUM      TO SCREEN-CMD-VAR1.
      *    MOVE SCREEN-BUFFER1     TO DSPLY-REC.
      *    PERFORM 99-SCREEN-WRITE.
      *    PERFORM 98A-SCREEN-READ.
           MOVE 0                  TO COND-WORD.
           MOVE SPACES             TO EQUIPMENT-KEY.
           MOVE EQP-EQUIP-NUM      TO EQUIPMENT-NUM.
           MOVE EQUIPMENT-KEY      TO EQRSUBKEY OF EQP-RMK-RCD.
           START EQP-REMARKS-FILE KEY > EXTERNALLY-DESCRIBED-KEY
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF ERM-STATUS NOT = "00" MOVE 17 TO COND-WORD.
           IF COND-WORD = 17 GO TO 610-MES-EXIT.
           PERFORM MOD-EQP-REMARKS-EQPNUMS  THRU MERME-EXIT.
           IF COND-WORD = 15
               MOVE "EQP REMARKS    ENTRIES EXIST FOR EQUIPMENT NUMBER "
                   TO SCREEN-CMD-LIT1
               MOVE EQP-EQUIP-NUM  TO SCREEN-CMD-VAR1
               MOVE SCREEN-BUFFER1 TO DSPLY-REC
               PERFORM 99-SCREEN-WRITE
               CALL "CLPAUSE2"
               PERFORM 98A-SCREEN-READ
               GO TO 610-MOD-EQPNUM-SETS.

      *    MOVE TRUE-VAL           TO INDS (98).
      *    MOVE "CHECKING HOT-CODE FILE           FOR EQUIPMENT NUMBER "
      *        TO SCREEN-CMD-LIT1.
      *    MOVE EQP-EQUIP-NUM      TO SCREEN-CMD-VAR1.
      *    MOVE SCREEN-BUFFER1     TO DSPLY-REC.
      *    PERFORM 99-SCREEN-WRITE.
      *    PERFORM 98A-SCREEN-READ.
           MOVE 0                  TO COND-WORD.
           MOVE EQP-EQUIP-NUM      TO EQPNUM OF HCFREC.
           START HOT-CODE-FILE KEY = EXTERNALLY-DESCRIBED-KEY
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF HCF-STATUS NOT = "00" MOVE 17 TO COND-WORD.
           IF COND-WORD = 0
               MOVE "HOT CODE       ENTRIES EXIST FOR EQUIPMENT NUMBER "
                   TO SCREEN-CMD-LIT1
               MOVE EQP-EQUIP-NUM  TO SCREEN-CMD-VAR1
               MOVE SCREEN-BUFFER1 TO DSPLY-REC
               PERFORM 99-SCREEN-WRITE
               CALL "CLPAUSE2"
               PERFORM 98A-SCREEN-READ
               GO TO 610-MOD-EQPNUM-SETS.

      *    MOVE TRUE-VAL           TO INDS (98).
      *    MOVE "CHECKING PM OPEN QUEUE FILE      FOR EQUIPMENT NUMBER "
      *        TO SCREEN-CMD-LIT1.
      *    MOVE EQP-EQUIP-NUM      TO SCREEN-CMD-VAR1.
      *    MOVE SCREEN-BUFFER1     TO DSPLY-REC.
      *    PERFORM 99-SCREEN-WRITE.
      *    PERFORM 98A-SCREEN-READ.
           MOVE 0                  TO COND-WORD.
           MOVE EQP-EQUIP-NUM      TO EQPNUM OF POFREC.
           START PM-OPENQ-FILE KEY = EXTERNALLY-DESCRIBED-KEY
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF POF-STATUS NOT = "00" MOVE 17 TO COND-WORD.
           IF COND-WORD = 0
               MOVE "PM OPENQ       ENTRIES EXIST FOR EQUIPMENT NUMBER "
                   TO SCREEN-CMD-LIT1
               MOVE EQP-EQUIP-NUM  TO SCREEN-CMD-VAR1
               MOVE SCREEN-BUFFER1 TO DSPLY-REC
               PERFORM 99-SCREEN-WRITE
               CALL "CLPAUSE2"
               PERFORM 98A-SCREEN-READ
               GO TO 610-MOD-EQPNUM-SETS.

      *    MOVE TRUE-VAL           TO INDS (98).
      *    MOVE "CHECKING PM-SCHEDULE FILE        FOR EQUIPMENT NUMBER "
      *        TO SCREEN-CMD-LIT1.
      *    MOVE EQP-EQUIP-NUM      TO SCREEN-CMD-VAR1.
      *    MOVE SCREEN-BUFFER1     TO DSPLY-REC.
      *    PERFORM 99-SCREEN-WRITE.
      *    PERFORM 98A-SCREEN-READ.
           MOVE 0                  TO COND-WORD.
           MOVE EQP-EQUIP-NUM      TO PMEQPNUM OF PMFREC.
           START PM-SCHEDULE KEY > EXTERNALLY-DESCRIBED-KEY
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF PMF-STATUS NOT = "00" MOVE 17 TO COND-WORD.
           IF COND-WORD = 17 GO TO 610-MES-EXIT.
           PERFORM MOD-SCHEDULE-EQPNUMS THRU MPME-EXIT.
           IF COND-WORD = 15
               MOVE "PM-SCHEDULE    ENTRIES EXIST FOR EQUIPMENT NUMBER "
                   TO SCREEN-CMD-LIT1
               MOVE EQP-EQUIP-NUM  TO SCREEN-CMD-VAR1
               MOVE SCREEN-BUFFER1 TO DSPLY-REC
               PERFORM 99-SCREEN-WRITE
               CALL "CLPAUSE2"
               PERFORM 98A-SCREEN-READ
               GO TO 610-MOD-EQPNUM-SETS.

      *    MOVE TRUE-VAL           TO INDS (98).
      *    MOVE "CHECKING SCHEDULE FILE           FOR EQUIPMENT NUMBER "
      *        TO SCREEN-CMD-LIT1.
      *    MOVE EQP-EQUIP-NUM      TO SCREEN-CMD-VAR1.
      *    MOVE SCREEN-BUFFER1     TO DSPLY-REC.
      *    PERFORM 99-SCREEN-WRITE.
      *    PERFORM 98A-SCREEN-READ.
           MOVE 0                  TO COND-WORD.
           MOVE EQP-EQUIP-NUM      TO EQPNUM OF SFREC.
           START SCHEDULE-FILE KEY = EXTERNALLY-DESCRIBED-KEY
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF SF-STATUS NOT = "00" MOVE 17 TO COND-WORD.
           IF COND-WORD = 0
               MOVE "WO SCHEDULE    ENTRIES EXIST FOR EQUIPMENT NUMBER "
                   TO SCREEN-CMD-LIT1
               MOVE EQP-EQUIP-NUM  TO SCREEN-CMD-VAR1
               MOVE SCREEN-BUFFER1 TO DSPLY-REC
               PERFORM 99-SCREEN-WRITE
               CALL "CLPAUSE2"
               PERFORM 98A-SCREEN-READ
               GO TO 610-MOD-EQPNUM-SETS.

      *    MOVE TRUE-VAL           TO INDS (98).
      *    MOVE "CHECKING WO OPENQ FILE           FOR EQUIPMENT NUMBER "
      *        TO SCREEN-CMD-LIT1.
      *    MOVE EQP-EQUIP-NUM      TO SCREEN-CMD-VAR1.
      *    MOVE SCREEN-BUFFER1     TO DSPLY-REC.
      *    PERFORM 99-SCREEN-WRITE.
      *    PERFORM 98A-SCREEN-READ.
           MOVE 0                  TO COND-WORD.
           MOVE EQP-EQUIP-NUM      TO EQPNUM OF WOFREC.
           START WO-OPENQ-FILE KEY = EXTERNALLY-DESCRIBED-KEY
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF WOF-STATUS NOT = "00" MOVE 17 TO COND-WORD.
           IF COND-WORD = 0
               MOVE "WO OPENQ       ENTRIES EXIST FOR EQUIPMENT NUMBER "
                   TO SCREEN-CMD-LIT1
               MOVE EQP-EQUIP-NUM  TO SCREEN-CMD-VAR1
               MOVE SCREEN-BUFFER1 TO DSPLY-REC
               PERFORM 99-SCREEN-WRITE
               CALL "CLPAUSE2"
               PERFORM 98A-SCREEN-READ
               GO TO 610-MOD-EQPNUM-SETS.

           MOVE 0                  TO COND-WORD.
           DELETE EQUIPMENT-FILE RECORD
               INVALID KEY MOVE 17 TO COND-WORD.
           IF EF-STATUS NOT = "00" MOVE 17 TO COND-WORD.
           IF COND-WORD = 17
               MOVE "ERROR ENCOUNTERED DELETING EQUIPMENT NUMBER"
                   TO SCREEN-CMD-LIT1
               MOVE EQP-EQUIP-NUM TO SCREEN-CMD-VAR1
               MOVE SCREEN-BUFFER1 TO DSPLY-REC
               PERFORM 99-SCREEN-WRITE
               CALL "CLPAUSE2"
               PERFORM 98A-SCREEN-READ
               GO TO 610-MOD-EQPNUM-SETS.
           MOVE "SUCCESSFUL DELETION OF EQUIPMENT NUMBER "
               TO SCREEN-CMD-LIT1.
           MOVE EQP-EQUIP-NUM       TO SCREEN-CMD-VAR1.
           MOVE TRUE-VAL            TO INDS (98).
           MOVE SCREEN-BUFFER1      TO DSPLY-REC.
           PERFORM 99-SCREEN-WRITE.
           PERFORM 98A-SCREEN-READ.
           CALL "CLPAUSE2".
           MOVE SPACES               TO ERROR-BUFFER.
       610-MES-EXIT.    EXIT.

       MOD-EQP-OPERATIONS-EQPNUMS.
           READ EQP-OPERATIONS-FILE NEXT INTO BUF-EQP-OPS
               AT END    GO TO MEOPE-EXIT.
           IF EOP-STATUS NOT = "00" GO TO MEOPE-EXIT.
           IF ESK-EQUIP OF BUF-EQP-OPS = S-EQUIP-START
               MOVE 15 TO COND-WORD.
       MEOPE-EXIT.    EXIT.

       MOD-EQP-REFERENCE-EQPNUMS.
           READ EQP-REFERENCE-FILE NEXT INTO BUF-EQP-REF
               AT END    GO TO MERFE-EXIT.
           IF ERF-STATUS NOT = "00" GO TO MERFE-EXIT.
           IF ESK-EQUIP OF BUF-EQP-REF = S-EQUIP-START
               MOVE 15 TO COND-WORD.
       MERFE-EXIT.    EXIT.

       MOD-EQP-REMARKS-EQPNUMS.
           READ EQP-REMARKS-FILE NEXT INTO BUF-EQP-REM
               AT END    GO TO MERME-EXIT.
           IF ERM-STATUS NOT = "00" GO TO MERME-EXIT.
           IF ESK-EQUIP OF BUF-EQP-REM = S-EQUIP-START
               MOVE 15 TO COND-WORD.
       MERME-EXIT.    EXIT.

       MOD-SCHEDULE-EQPNUMS.
           READ PM-SCHEDULE NEXT INTO PM-SCHED-DATA
               AT END    GO TO MPME-EXIT.
           IF PMF-STATUS NOT = "00" GO TO MPME-EXIT.
           IF SCH-EQUIP-NUM OF PM-SCHED-DATA = S-EQUIP-START
               MOVE 15 TO COND-WORD.
       MPME-EXIT.    EXIT.

       98-SCREEN-READ.
           READ DISPLAY-FILE FORMAT IS VIEW-CFNAME
               INDIC IS INDICS.
           ACCEPT IOFEEDBACK FROM I-O-FEEDBACK-AREA.
           MOVE ALL B"0" TO INDICS.
           IF DSPLY-STATUS NOT = "00"
               MOVE 3 TO VIEW-LASTKEY
           ELSE
           MOVE FUNCTION-NUM TO VIEW-LASTKEY.

       98A-SCREEN-READ.
           READ DISPLAY-FILE TERMINAL IS TERMINAL-ID
               INDIC IS INDICS
                  NO DATA MOVE DSPLY-STATUS TO DSPLY-STATUS.
           MOVE ALL B"0" TO INDICS.

       99-SCREEN-WRITE.
           WRITE DSPLY-REC FORMAT IS VIEW-CFNAME
               INDIC IS INDICS.
           MOVE ALL B"0" TO INDICS.

       999-CATREAD.
           MOVE SPACES TO ERROR-BUFFER.
           CALL "CCATREAD" USING CATREAD-PARMS.
           MOVE CATREAD-MSG-TEXT TO ERROR-BUFFER.
       999-CATREAD-EXIT.    EXIT.
