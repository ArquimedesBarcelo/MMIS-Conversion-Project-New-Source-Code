126600 839-EXIT.  EXIT.
       840-GET-MSTORERM.
           MOVE 0 TO COND-WORD.
           MOVE CODE-ARG TO CORPCDE OF MSTORERM-REC.
           READ MSTORERM   INTO BUF-MSTORERM
               INVALID KEY MOVE 17 TO COND-WORD.
           IF FILE-STATUS-1 = "2"
               MOVE 17 TO COND-WORD
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD.
           IF NOT GOOD-CALL
              MOVE SPACES TO STR-UM.
       849-EXIT.  EXIT.
       850-BACK-QUOTE.
           MOVE 0 TO COND-WORD, NO-NEXT.
           READ DVENDITM3 PRIOR RECORD INTO BUF-DVENDITM
               AT END MOVE 14 TO COND-WORD.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "1"
                   MOVE 14 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.
           IF QUOTENUM OF DVENDITM-REC3 NOT = QUOTE-ARG
               MOVE 14 TO COND-WORD.

      *-----  IF READ TOOK POINTER BEYOND BEGINNING OF FILE
      *-----  DO READ FIRST TO BRING POINTER BACK.

           IF FILE-STATUS-1 = "1"
              READ DVENDITM3 FIRST RECORD INTO BUF-DVENDITM
                AT END MOVE FILE-STATUS TO FILE-STATUS
              END-READ
              IF FILE-STATUS NOT = "00" AND "10"
                 MOVE 99 TO COND-WORD
              END-IF
           ELSE

      *-----  IF POINTER IS TOO FAR, BRING IT BACK

              IF COND-WORD = 14
                 READ DVENDITM3 NEXT RECORD INTO BUF-DVENDITM
                   AT END MOVE FILE-STATUS TO FILE-STATUS.

       851-BACK-VENDOR.
           MOVE 0 TO COND-WORD, NO-NEXT.
           READ DVENDITM PRIOR RECORD INTO BUF-DVENDITM
               AT END MOVE 14 TO COND-WORD.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "1"
                   MOVE 14 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.
           IF VENCDE OF DVENDITM-REC NOT = VENDOR-ARG
               MOVE 14 TO COND-WORD.

      *-----  IF READ TOOK POINTER BEYOND BEGINNING OF FILE
      *-----  DO READ FIRST TO BRING POINTER BACK.

           IF FILE-STATUS-1 = "1"
              READ DVENDITM FIRST RECORD INTO BUF-DVENDITM
                AT END MOVE FILE-STATUS TO FILE-STATUS
              END-READ
              IF FILE-STATUS NOT = "00" AND "10"
                 MOVE 99 TO COND-WORD
              END-IF
           ELSE

      *-----  POINTER IS TOO FAR, BRING IT BACK

              IF COND-WORD = 14
                 READ DVENDITM NEXT RECORD INTO BUF-DVENDITM
                   AT END MOVE FILE-STATUS TO FILE-STATUS.

       852-BACK-CORPCODE.
           MOVE 0 TO COND-WORD, NO-NEXT.
           READ DVENDITM2 PRIOR RECORD INTO BUF-DVENDITM
               AT END MOVE 14 TO COND-WORD.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "1"
                   MOVE 14 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.
           IF CORPCDE OF DVENDITM-REC2 NOT = CODE-ARG
               MOVE 14 TO COND-WORD.

      *-----  IF READ TOOK POINTER BEYOND BEGINNING OF FILE
      *-----  DO READ FIRST TO BRING POINTER BACK.

           IF FILE-STATUS-1 = "1"
              READ DVENDITM2 FIRST RECORD INTO BUF-DVENDITM
                AT END MOVE FILE-STATUS TO FILE-STATUS
              END-READ
              IF FILE-STATUS NOT = "00" AND "10"
                 MOVE 99 TO COND-WORD
              END-IF
           ELSE

      *-----  POINTER IS TOO FAR, BRING IT BACK

           IF COND-WORD = 14
              READ DVENDITM2 NEXT RECORD INTO BUF-DVENDITM
                   AT END MOVE FILE-STATUS TO FILE-STATUS.

       853-BACK-REQ.
           MOVE 0 TO COND-WORD, NO-NEXT.
           READ DVENDITM4 PRIOR RECORD INTO BUF-DVENDITM
               AT END MOVE 14 TO COND-WORD.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "1"
                   MOVE 14 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.
           IF REQNO OF DVENDITM-REC4 NOT = REQ-ARG
               MOVE 14 TO COND-WORD.

      *-----  IF READ TOOK POINTER BEYOND BEGINNING OF FILE
      *-----  DO READ FIRST TO BRING POINTER BACK.

           IF FILE-STATUS-1 = "1"
              READ DVENDITM4 FIRST RECORD INTO BUF-DVENDITM
                AT END MOVE FILE-STATUS TO FILE-STATUS
              END-READ
              IF FILE-STATUS NOT = "00" AND "10"
                 MOVE 99 TO COND-WORD
              END-IF
           ELSE

      *-----  POINTER IS TOO FAR, BRING IT BACK

              IF COND-WORD = 14
                 READ DVENDITM4 NEXT RECORD INTO BUF-DVENDITM
                   AT END MOVE FILE-STATUS TO FILE-STATUS.


       854-FORWARD-QUOTE.
           MOVE 0 TO COND-WORD, NO-PREV.
           READ DVENDITM3 NEXT INTO BUF-DVENDITM
               AT END MOVE 15 TO COND-WORD.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   MOVE 15 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.
           IF QUOTENUM OF DVENDITM-REC3  NOT = QUOTE-ARG
               MOVE 15 TO COND-WORD.

      *-----  IF READ TOOK POINTER BEYOND END OF FILE
      *-----  DO READ LAST TO BRING POINTER BACK.

           IF FILE-STATUS = "10" OR "14" OR "46"
              READ DVENDITM3 LAST RECORD INTO BUF-DVENDITM
                AT END MOVE FILE-STATUS TO FILE-STATUS
              END-READ
              IF FILE-STATUS NOT = "00" AND "10"
                 MOVE 99 TO COND-WORD
              END-IF
           ELSE

      *-----  POINTER IS TOO FAR, BRING IT BACK

              IF COND-WORD = 15
                 READ DVENDITM3 PRIOR RECORD INTO BUF-DVENDITM
                   AT END MOVE FILE-STATUS TO FILE-STATUS.


       855-FORWARD-VENDOR.
           MOVE 0 TO COND-WORD, NO-PREV.
           READ DVENDITM NEXT INTO BUF-DVENDITM
               AT END MOVE 15 TO COND-WORD.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   MOVE 15 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.
           IF VENCDE OF DVENDITM-REC  NOT = VENDOR-ARG
               MOVE 15 TO COND-WORD.

      *-----  IF READ TOOK POINTER BEYOND END OF FILE
      *-----  DO READ LAST TO BRING POINTER BACK.

           IF FILE-STATUS = "10" OR "14" OR "46"
              READ DVENDITM LAST RECORD INTO BUF-DVENDITM
                AT END MOVE FILE-STATUS TO FILE-STATUS
              END-READ
              IF FILE-STATUS NOT = "00" AND "10"
                 MOVE 99 TO COND-WORD
              END-IF
           ELSE

      *-----  POINTER IS TOO FAR, BRING IT BACK
              IF COND-WORD = 15
                 READ DVENDITM  PRIOR RECORD INTO BUF-DVENDITM
                   AT END MOVE FILE-STATUS TO FILE-STATUS.

       856-FORWARD-CORPCODE.
           MOVE 0 TO COND-WORD, NO-PREV.
           READ DVENDITM2 NEXT INTO BUF-DVENDITM
               AT END MOVE 15 TO COND-WORD.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   MOVE 15 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.
           IF CORPCDE OF DVENDITM-REC2  NOT = CODE-ARG
               MOVE 15 TO COND-WORD.

      *-----  IF READ TOOK POINTER BEYOND END OF FILE
      *-----  DO READ LAST TO BRING POINTER BACK.

           IF FILE-STATUS = "10" OR "14" OR "46"
              READ DVENDITM2 LAST RECORD INTO BUF-DVENDITM
                AT END MOVE FILE-STATUS TO FILE-STATUS
              END-READ
              IF FILE-STATUS NOT = "00" AND "10"
                 MOVE 99 TO COND-WORD
              END-IF
           ELSE

      *-----  POINTER IS TOO FAR, BRING IT BACK
              IF COND-WORD = 15
                 READ DVENDITM2 PRIOR RECORD INTO BUF-DVENDITM
                   AT END MOVE FILE-STATUS TO FILE-STATUS.


       857-FORWARD-REQ.
           MOVE 0 TO COND-WORD, NO-PREV.
           READ DVENDITM4 NEXT INTO BUF-DVENDITM
               AT END MOVE 15 TO COND-WORD.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   MOVE 15 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.
           IF REQNO OF DVENDITM-REC4  NOT = REQ-ARG
               MOVE 15 TO COND-WORD.

      *-----  IF READ TOOK POINTER BEYOND END OF FILE
      *-----  DO READ LAST TO BRING POINTER BACK.

           IF FILE-STATUS = "10" OR "14" OR "46"
              READ DVENDITM4 LAST RECORD INTO BUF-DVENDITM
                AT END MOVE FILE-STATUS TO FILE-STATUS
              END-READ
              IF FILE-STATUS NOT = "00" AND "10"
                 MOVE 99 TO COND-WORD
              END-IF
           ELSE

      *-----  POINTER IS TOO FAR, BRING IT BACK
              IF COND-WORD = 15
                 READ DVENDITM4 PRIOR RECORD INTO BUF-DVENDITM
                   AT END MOVE FILE-STATUS TO FILE-STATUS.


