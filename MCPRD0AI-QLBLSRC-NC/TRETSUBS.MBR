000200 IDENTIFICATION DIVISION.
000300 PROGRAM-ID.  TRETSUBS.
000500 ENVIRONMENT DIVISION.
000600 CONFIGURATION SECTION.
000700 SOURCE-COMPUTER.     AS400.
000800 OBJECT-COMPUTER.     AS400.
       COPY SPECIALN OF COPYLIB.
001100 INPUT-OUTPUT SECTION.
001200 FILE-CONTROL.
           SELECT CC-LINK-FILE
               ASSIGN TO DATABASE-MCFLMM2101
               ORGANIZATION IS INDEXED
               ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                   WITH DUPLICATES
               FILE STATUS IS FILE-STATUS.
           SELECT DISPLAY-FILE
               ASSIGN TO WORKSTATION-ZOFFLINE-SI
               ORGANIZATION IS TRANSACTION
               FILE STATUS IS DSPLY-STATUS
               CONTROL-AREA IS WS-CONTROL.
           SELECT DRAWING-FILE
               ASSIGN TO DATABASE-MCFLDF0104
               ORGANIZATION IS INDEXED
               ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                   WITH DUPLICATES
               FILE STATUS IS FILE-STATUS.
           SELECT DRWFIL
               ASSIGN TO DATABASE-MCFPDRWFIL
               ORGANIZATION IS SEQUENTIAL
               ACCESS MODE IS SEQUENTIAL
               FILE STATUS IS FILE-STATUS.
           SELECT EQPOPS
               ASSIGN TO DATABASE-MCFPEQPOPS
               ORGANIZATION IS SEQUENTIAL
               ACCESS MODE IS SEQUENTIAL
               FILE STATUS IS FILE-STATUS.
           SELECT EQPREF
               ASSIGN TO DATABASE-MCFPEQPREF
               ORGANIZATION IS SEQUENTIAL
               ACCESS MODE IS SEQUENTIAL
               FILE STATUS IS FILE-STATUS.
           SELECT EQPREM
               ASSIGN TO DATABASE-MCFPEQPREM
               ORGANIZATION IS SEQUENTIAL
               ACCESS IS SEQUENTIAL
               FILE STATUS IS FILE-STATUS.
           SELECT EQUIP-OPERATIONS
               ASSIGN TO DATABASE-MCFLER0501
               ORGANIZATION IS INDEXED
               ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                   WITH DUPLICATES
               FILE STATUS IS FILE-STATUS.
           SELECT EQUIP-REF
               ASSIGN TO DATABASE-MCFLER0101
               ORGANIZATION IS INDEXED
               ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
               FILE STATUS IS FILE-STATUS.
           SELECT EQUIP-REMARKS
               ASSIGN TO DATABASE-MCFLER0301
               ORGANIZATION IS INDEXED
               ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                   WITH DUPLICATES
               FILE STATUS IS FILE-STATUS.
001200     SELECT OUT-FILE
               ASSIGN TO DATABASE-MCFPOUTF
               ORGANIZATION IS SEQUENTIAL
               ACCESS MODE IS SEQUENTIAL
               FILE STATUS IS FILE-STATUS.
001600     SELECT RET-FILE
               ASSIGN TO DATABASE-MCFPRETF
001700         ORGANIZATION IS SEQUENTIAL
               ACCESS MODE IS SEQUENTIAL
001800         FILE STATUS IS FILE-STATUS.
001900     SELECT SORT-FILE
               ASSIGN TO DISK-SORTFILE.
           SELECT SPAREP
               ASSIGN TO DATABASE-MCFPSPAREP
               ORGANIZATION IS SEQUENTIAL
               ACCESS MODE IS SEQUENTIAL
               FILE STATUS IS FILE-STATUS.
           SELECT TYPOPS
               ASSIGN TO DATABASE-MCFPTYPOPS
               ORGANIZATION IS SEQUENTIAL
               ACCESS MODE IS SEQUENTIAL
               FILE STATUS IS FILE-STATUS.
           SELECT TYPE-OPERATIONS
               ASSIGN TO DATABASE-MCFLER0601
               ORGANIZATION IS INDEXED
               ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                   WITH DUPLICATES
               FILE STATUS IS FILE-STATUS.
           SELECT TYPREF
               ASSIGN TO DATABASE-MCFPTYPREF
               ORGANIZATION IS SEQUENTIAL
               ACCESS MODE IS SEQUENTIAL
               FILE STATUS IS FILE-STATUS.
           SELECT TYPE-REF
               ASSIGN TO DATABASE-MCFLER0201
               ORGANIZATION IS INDEXED
               ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
               FILE STATUS IS FILE-STATUS.
           SELECT TYPREM
               ASSIGN TO DATABASE-MCFPTYPREM
               ORGANIZATION IS SEQUENTIAL
               ACCESS MODE IS SEQUENTIAL
               FILE STATUS IS FILE-STATUS.
           SELECT TYPE-REMARKS
               ASSIGN TO DATABASE-MCFLER0401
               ORGANIZATION IS INDEXED
               ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                   WITH DUPLICATES
               FILE STATUS IS FILE-STATUS.
           SELECT WO-EQUIP-HIER
               ASSIGN TO DATABASE-MCFLMM1701
               ORGANIZATION IS INDEXED
               ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                   WITH DUPLICATES
               FILE STATUS IS FILE-STATUS.
002000 DATA DIVISION.
002100 FILE SECTION.
       FD  CC-LINK-FILE
           LABEL RECORDS ARE STANDARD
           DATA RECORD IS CC-LINK-REC.
       01  CC-LINK-REC.
           COPY DDS-ALL-FORMATS OF MCFLMM2101.
       FD  DISPLAY-FILE
           LABEL RECORDS ARE OMITTED.
       01  DSPLY-REC                PIC X(2000).
       FD  DRAWING-FILE
           LABEL RECORDS ARE STANDARD
           DATA RECORD IS DRAWING-FILE-REC.
       01  DRAWING-FILE-REC.
           COPY DDS-ALL-FORMATS OF MCFLDF0104.
       FD  DRWFIL
           LABEL RECORDS ARE STANDARD
           DATA RECORD IS DRWFIL-REC.
       01  DRWFIL-REC               PIC X(196).
       FD  EQPOPS
           LABEL RECORDS ARE STANDARD
           DATA RECORD IS EQPOPS-REC.
       01  EQPOPS-REC               PIC X(802).
       FD  EQPREF
           LABEL RECORDS ARE STANDARD
           DATA RECORD IS EQPREF-REC.
       01  EQPREF-REC               PIC X(330).
       FD  EQPREM
           LABEL RECORDS ARE STANDARD
           DATA RECORD IS EQPREM-REC.
       01  EQPREM-REC               PIC X(804).
       FD  EQUIP-OPERATIONS
           LABEL RECORDS ARE STANDARD
           DATA RECORD IS EQUIP-OPERATIONS-REC.
       01  EQUIP-OPERATIONS-REC.
           COPY DDS-ALL-FORMATS OF MCFLER0501.
       FD  EQUIP-REF
           LABEL RECORDS ARE STANDARD
           DATA RECORD IS EQUIP-REF-REC.
       01  EQUIP-REF-REC.
           COPY DDS-ALL-FORMATS OF MCFLER0101.
       FD  EQUIP-REMARKS
           LABEL RECORDS ARE STANDARD
           DATA RECORD IS EQUIP-REMARKS-REC.
       01  EQUIP-REMARKS-REC.
           COPY DDS-ALL-FORMATS OF MCFLER0301.
001800 FD  OUT-FILE
001900     RECORD CONTAINS 12 CHARACTERS
002000     DATA RECORD IS OUTF.
002100 01  OUTF.
           05  OUTF-TYPE            PIC X(8).
           05  OUTF-SUBSYS          PIC X(4).
002600 FD  RET-FILE
002700     RECORD CONTAINS 80 CHARACTERS
002800     DATA RECORD IS RETF.
002900 01  RETF                     PIC X(80).
003000 SD  SORT-FILE RECORD CONTAINS 62 CHARACTERS
003100     DATA RECORD IS SORT-REC.
003200 01  SORT-REC.
003300     05  SORT-KEY.
003400         10  SUBTYP-SORT      PIC X(8).
003500         10  SUBNUM-SORT.
003600             15  SUBNUM-1-S   PIC X.
003700             15  SUBNUM-2-S   PIC X.
003800             15  SUBNUM-3-S   PIC X.
003900             15  SUBNUM-4-S   PIC X.
004000     05  SUBNAME-SORT         PIC X(50).
       FD  SPAREP
           RECORD CONTAINS 22 CHARACTERS
           DATA RECORD IS SPAREP-REC.
       01  SPAREP-REC          PIC X(22).
       FD  TYPOPS
           LABEL RECORDS ARE STANDARD
           DATA RECORD IS TYPOPS-REC.
       01  TYPOPS-REC          PIC X(804).
       FD  TYPE-OPERATIONS
           LABEL RECORDS ARE STANDARD
           DATA RECORD IS TYPE-OPERATIONS-REC.
       01  TYPE-OPERATIONS-REC.
           COPY DDS-ALL-FORMATS OF MCFLER0601.
       FD  TYPREF
           LABEL RECORDS ARE STANDARD
           DATA RECORD IS TYPREF-REC.
       01  TYPREF-REC          PIC X(324).
       FD  TYPE-REF
           LABEL RECORDS ARE STANDARD
           DATA RECORD IS TYPE-REF-REC.
       01  TYPE-REF-REC.
           COPY DDS-ALL-FORMATS OF MCFLER0201.
       FD  TYPREM
           LABEL RECORDS ARE STANDARD
           DATA RECORD IS TYPREM-REC.
       01  TYPREM-REC          PIC X(804).
       FD  TYPE-REMARKS
           LABEL RECORDS ARE STANDARD
           DATA RECORD IS TYPE-REMARKS-REC.
       01  TYPE-REMARKS-REC.
           COPY DDS-ALL-FORMATS OF MCFLER0401.
       FD  WO-EQUIP-HIER
           LABEL RECORDS ARE STANDARD
           DATA RECORD IS WEHREC.
       01  WEHREC.
           COPY DDS-ALL-FORMATS OF MCFLMM1701.
004100 WORKING-STORAGE SECTION.
004300 77  ALL-RECORDS-WRITTEN-SW   PIC X.
004400 77  ALL-MSTRS-FOUND-SW       PIC X.
       77  ANSWER-SW-D              PIC X.
       77  ANSWER-SW-E              PIC X.
       77  ANSWER-SW-P              PIC X.
004700 77  SCREEN1-READ-SW          PIC X.
004800 77  SUB1                     PIC 9(4) VALUE 0.
005400 01  ARG-DEFN.
005500     05  HIER-TYPE-DEFN       PIC X(8).
005600     05  KEY-DEFN.
005700         10  KEY4-DEFN        PIC X(4).
005800         10  FILLER           PIC XX VALUE SPACES.
       COPY CATREAD   OF COPYLIB.
       COPY CPYIND    OF COPYLIB.
       COPY CCRTFILE  OF COPYLIB.
005900 01  DBPARAMETERS.           COPY DBPARMS  OF COPYLIB.
       01  CC-LINK-BUF.            COPY DCCLINK  OF COPYLIB.
       01  DELETE-FILE              PIC X(10) VALUE "MCFPOUTF".
       COPY DEQPOPS   OF COPYLIB.
       COPY DEQPREM   OF COPYLIB.
       01  DRAWFILE-DATA.          COPY DDRAWFIL OF COPYLIB.
       01  DSPLY-STATUS             PIC XX.
       COPY DTYPEOPS  OF COPYLIB.
       COPY DTYPEREM  OF COPYLIB.
006000 01  EQUIP-HIER-BUFFER.
006100     05  HIER-KEY-BUF.
006200         10  EQP-TYPE-BUF     PIC X(8).
006300         10  FATHER-SUB-BUF.
006400             15  FATH-4-BUF   PIC X(4).
006500             15  FILLER       PIC XX.
006600     05  HIER-DISP-CODE.
006700         10  SON-4-BUF.
006800             15  SUB1-BUF     PIC X.
006900             15  SUB2-BUF     PIC X.
007000             15  SUB3-BUF     PIC X.
007100             15  SUB4-BUF     PIC X.
007200         10  FILLER           PIC XX.
007300     05  SUB-ASSY-NAME.
007400         10  SUB-NAME30       PIC X(30).
007500         10  FILLER           PIC X(20).
007600 01  ERROR-BUFFER.
007700     05  ERROR-74.
007800         10  ERROR-50         PIC X(50).
007900         10  FILLER           PIC XX.
008000         10  ERROR-LITC       PIC X(7).
008100         10  ERROR-COND       PIC 9(4).
008200         10  FILLER           PIC XXX.
008300         10  ERROR-CODE       PIC X(8).
008400     05  ERROR-DELAY          PIC X(6).
       01  FILE-STATUS.
           05  FILE-STATUS-1        PIC X.
           05  FILE-STATUS-2        PIC X.
       COPY IOFEEDBACK OF COPYLIB.
008800 01  LAST-WO-BUFF.           COPY MLASTWO OF COPYLIB.
       COPY MEQPREF   OF COPYLIB.
       COPY MTYPEREF  OF COPYLIB.
009400 01  READ-ETYPES.
009500     05  READ-ETYP OCCURS 5 TIMES.
009600         10  READ-ETYPE       PIC X(8).
           05  READ-CMD-LINE        PIC X(79).
           05  READ-ERR-LINE        PIC X(79).
       COPY DBSTAT OF COPYLIB.
       01  TRUE-VAL                 PIC 1 VALUE B"1".
       COPY VCOMAREA  OF COPYLIB.
       COPY WSCONTROL OF COPYLIB.
010800 PROCEDURE DIVISION.
011000 BEGIN-PROC.
           MOVE "*CURLIB   "  TO CCRTFILE-LIBRARY.
           MOVE "MCFPOUTF  "  TO CCRTFILE-FILE.
           MOVE "0012"        TO CCRTFILE-RECORD-LENGTH.
           MOVE "00100"       TO CCRTFILE-NO-RECORDS.
           MOVE "00100"       TO CCRTFILE-INCREMENT-AMT.
           MOVE "01"          TO CCRTFILE-NO-INCREMENTS.
           CALL "CCRTFILE" USING CCRTFILE-LIBRARY
                                 CCRTFILE-FILE
                                 CCRTFILE-RECORD-LENGTH
                                 CCRTFILE-NO-RECORDS
                                 CCRTFILE-INCREMENT-AMT
                                 CCRTFILE-NO-INCREMENTS
                                 CCRTFILE-STATUS.
           MOVE "*CURLIB   "  TO CCRTFILE-LIBRARY.
           MOVE "MCFPRETF  "  TO CCRTFILE-FILE.
           MOVE "0080"        TO CCRTFILE-RECORD-LENGTH.
           MOVE "05000"       TO CCRTFILE-NO-RECORDS.
           MOVE "01000"       TO CCRTFILE-INCREMENT-AMT.
           MOVE "03"          TO CCRTFILE-NO-INCREMENTS.
           CALL "CCRTFILE" USING CCRTFILE-LIBRARY
                                 CCRTFILE-FILE
                                 CCRTFILE-RECORD-LENGTH
                                 CCRTFILE-NO-RECORDS
                                 CCRTFILE-INCREMENT-AMT
                                 CCRTFILE-NO-INCREMENTS
                                 CCRTFILE-STATUS.
011400     OPEN I-O    DISPLAY-FILE.
012700     OPEN OUTPUT OUT-FILE.
           OPEN OUTPUT RET-FILE.
           OPEN INPUT  WO-EQUIP-HIER.
013000     MOVE "N" TO ALL-RECORDS-WRITTEN-SW SCREEN1-READ-SW
               ANSWER-SW-D ANSWER-SW-E ANSWER-SW-P.
013600     MOVE "FRETSUBS" TO VIEW-CFNAME.
015000     SORT SORT-FILE ASCENDING KEY SORT-KEY
015100         INPUT PROCEDURE 8-INPUT-RECORDS
015200         OUTPUT PROCEDURE 9-WRITE-RECORDS.
015300 2-EOJ.
015500     CLOSE DISPLAY-FILE.
015600     CLOSE OUT-FILE.
           CALL "MCDLT" USING DELETE-FILE.
015400     CLOSE RET-FILE.
015700     CLOSE WO-EQUIP-HIER.
015800     GOBACK.
076100
       98-SCREEN-READ.
           READ DISPLAY-FILE FORMAT IS VIEW-CFNAME
               INDIC IS INDICS.
           ACCEPT IOFEEDBACK FROM I-O-FEEDBACK-AREA.
           MOVE ALL B"0" TO INDICS.
           IF DSPLY-STATUS NOT = "00"
               MOVE 3 TO VIEW-LASTKEY
           ELSE
           MOVE FUNCTION-NUM TO VIEW-LASTKEY.

       99-SCREEN-WRITE.
           WRITE DSPLY-REC FORMAT IS VIEW-CFNAME
               INDIC IS INDICS.
           MOVE ALL B"0" TO INDICS.


015900 8-INPUT-RECORDS.
016000     PERFORM 82-GET-ENTRIES THRU 82-WOL-EXIT
016100               UNTIL VIEW-LASTKEY = 3.
016200     PERFORM 83-READ-OUTF THRU 83-RO-EXIT UNTIL
016300               SCREEN1-READ-SW = "Y".
016500
016600 82-GET-ENTRIES.
           MOVE SPACES TO READ-ETYPES DSPLY-REC.
           PERFORM 99-SCREEN-WRITE.
           PERFORM 98-SCREEN-READ.
017100     IF VIEW-LASTKEY = 3
017200         MOVE "99999999" TO OUTF
017300         WRITE OUTF
               CLOSE OUT-FILE
               OPEN INPUT OUT-FILE
017500         GO TO 82-WOL-EXIT.
           MOVE DSPLY-REC TO READ-ETYPES.
018100     MOVE 0 TO SUB1.
018200 821-WRITE-OUTF-LOOP.
018300     ADD 1 TO SUB1.
018400     IF SUB1 > 5 GO TO 82-GET-ENTRIES.
019700     IF READ-ETYPE (SUB1) = "        " GO TO 821-WRITE-OUTF-LOOP.
020300     MOVE READ-ETYPE (SUB1) TO OUTF.
020400     WRITE OUTF.
020800     GO TO 821-WRITE-OUTF-LOOP.
       82-WOL-EXIT.    EXIT.
021500
021600 83-READ-OUTF.
021700     MOVE "N" TO ALL-MSTRS-FOUND-SW.
021800     READ OUT-FILE.
022100     IF OUTF = "99999999"
022300         MOVE "Y" TO SCREEN1-READ-SW
022400         GO TO 83-RO-EXIT.
022600     MOVE OUTF TO HIER-TYPE-DEFN.
022700     MOVE "    " TO KEY4-DEFN.
023000     PERFORM 831-FIND-MSTR THRU 831-FM-EXIT
023100         UNTIL ALL-MSTRS-FOUND-SW = "Y".
           IF ANSWER-SW-P = "Y"
               NEXT SENTENCE
           ELSE
           MOVE "N" TO ANSWER-SW-P
           DISPLAY "DO YOU WANT TO RETRIEVE SPARE PARTS INFO (Y/N)?"
           ACCEPT ANSWER-SW-P
           IF ANSWER-SW-P = "Y"
               OPEN INPUT  CC-LINK-FILE
               MOVE "*CURLIB   "  TO CCRTFILE-LIBRARY
               MOVE "MCFPSPAREP"  TO CCRTFILE-FILE
               MOVE "0022"        TO CCRTFILE-RECORD-LENGTH
               MOVE "05000"       TO CCRTFILE-NO-RECORDS
               MOVE "01000"       TO CCRTFILE-INCREMENT-AMT
               MOVE "03"          TO CCRTFILE-NO-INCREMENTS
               CALL "CCRTFILE" USING CCRTFILE-LIBRARY
                                     CCRTFILE-FILE
                                     CCRTFILE-RECORD-LENGTH
                                     CCRTFILE-NO-RECORDS
                                     CCRTFILE-INCREMENT-AMT
                                     CCRTFILE-NO-INCREMENTS
                                     CCRTFILE-STATUS
               OPEN OUTPUT SPAREP
               PERFORM 832-RETRIEVE-CC-LINK THRU 832-RSP-X
               MOVE "N" TO ANSWER-SW-P.
           IF ANSWER-SW-E = "Y"
               NEXT SENTENCE
           ELSE
           DISPLAY "DO YOU WANT EQUIPMENT REFERENCE INFO (Y/N)?"
           ACCEPT ANSWER-SW-E
           IF ANSWER-SW-E = "Y"
               OPEN INPUT EQUIP-REF
               MOVE "*CURLIB   "  TO CCRTFILE-LIBRARY
               MOVE "MCFPEQPREF"  TO CCRTFILE-FILE
               MOVE "0330"        TO CCRTFILE-RECORD-LENGTH
               MOVE "05000"       TO CCRTFILE-NO-RECORDS
               MOVE "01000"       TO CCRTFILE-INCREMENT-AMT
               MOVE "03"          TO CCRTFILE-NO-INCREMENTS
               CALL "CCRTFILE" USING CCRTFILE-LIBRARY
                                     CCRTFILE-FILE
                                     CCRTFILE-RECORD-LENGTH
                                     CCRTFILE-NO-RECORDS
                                     CCRTFILE-INCREMENT-AMT
                                     CCRTFILE-NO-INCREMENTS
                                     CCRTFILE-STATUS
               OPEN OUTPUT EQPREF
               OPEN INPUT EQUIP-REMARKS
               MOVE "*CURLIB   "  TO CCRTFILE-LIBRARY
               MOVE "MCFPEQPREM"  TO CCRTFILE-FILE
               MOVE "0802"        TO CCRTFILE-RECORD-LENGTH
               MOVE "05000"       TO CCRTFILE-NO-RECORDS
               MOVE "01000"       TO CCRTFILE-INCREMENT-AMT
               MOVE "03"          TO CCRTFILE-NO-INCREMENTS
               CALL "CCRTFILE" USING CCRTFILE-LIBRARY
                                     CCRTFILE-FILE
                                     CCRTFILE-RECORD-LENGTH
                                     CCRTFILE-NO-RECORDS
                                     CCRTFILE-INCREMENT-AMT
                                     CCRTFILE-NO-INCREMENTS
                                     CCRTFILE-STATUS
               OPEN OUTPUT EQPREM
               OPEN INPUT EQUIP-OPERATIONS
               MOVE "*CURLIB   "  TO CCRTFILE-LIBRARY
               MOVE "MCFPEQPOPS"  TO CCRTFILE-FILE
               MOVE "0802"        TO CCRTFILE-RECORD-LENGTH
               MOVE "05000"       TO CCRTFILE-NO-RECORDS
               MOVE "01000"       TO CCRTFILE-INCREMENT-AMT
               MOVE "03"          TO CCRTFILE-NO-INCREMENTS
               CALL "CCRTFILE" USING CCRTFILE-LIBRARY
                                     CCRTFILE-FILE
                                     CCRTFILE-RECORD-LENGTH
                                     CCRTFILE-NO-RECORDS
                                     CCRTFILE-INCREMENT-AMT
                                     CCRTFILE-NO-INCREMENTS
                                     CCRTFILE-STATUS
               OPEN OUTPUT EQPOPS
               OPEN INPUT TYPE-REF
               MOVE "*CURLIB   "  TO CCRTFILE-LIBRARY
               MOVE "MCFPTYPREF"  TO CCRTFILE-FILE
               MOVE "0324"        TO CCRTFILE-RECORD-LENGTH
               MOVE "05000"       TO CCRTFILE-NO-RECORDS
               MOVE "01000"       TO CCRTFILE-INCREMENT-AMT
               MOVE "03"          TO CCRTFILE-NO-INCREMENTS
               CALL "CCRTFILE" USING CCRTFILE-LIBRARY
                                     CCRTFILE-FILE
                                     CCRTFILE-RECORD-LENGTH
                                     CCRTFILE-NO-RECORDS
                                     CCRTFILE-INCREMENT-AMT
                                     CCRTFILE-NO-INCREMENTS
                                     CCRTFILE-STATUS
               OPEN OUTPUT TYPREF
               OPEN INPUT TYPE-REMARKS
               MOVE "*CURLIB   "  TO CCRTFILE-LIBRARY
               MOVE "MCFPTYPREM"  TO CCRTFILE-FILE
               MOVE "0804"        TO CCRTFILE-RECORD-LENGTH
               MOVE "05000"       TO CCRTFILE-NO-RECORDS
               MOVE "01000"       TO CCRTFILE-INCREMENT-AMT
               MOVE "03"          TO CCRTFILE-NO-INCREMENTS
               CALL "CCRTFILE" USING CCRTFILE-LIBRARY
                                     CCRTFILE-FILE
                                     CCRTFILE-RECORD-LENGTH
                                     CCRTFILE-NO-RECORDS
                                     CCRTFILE-INCREMENT-AMT
                                     CCRTFILE-NO-INCREMENTS
                                     CCRTFILE-STATUS
               OPEN OUTPUT TYPREM
               OPEN INPUT TYPE-OPERATIONS
               MOVE "*CURLIB   "  TO CCRTFILE-LIBRARY
               MOVE "MCFPTYPOPS"  TO CCRTFILE-FILE
               MOVE "0804"        TO CCRTFILE-RECORD-LENGTH
               MOVE "05000"       TO CCRTFILE-NO-RECORDS
               MOVE "01000"       TO CCRTFILE-INCREMENT-AMT
               MOVE "03"          TO CCRTFILE-NO-INCREMENTS
               CALL "CCRTFILE" USING CCRTFILE-LIBRARY
                                     CCRTFILE-FILE
                                     CCRTFILE-RECORD-LENGTH
                                     CCRTFILE-NO-RECORDS
                                     CCRTFILE-INCREMENT-AMT
                                     CCRTFILE-NO-INCREMENTS
                                     CCRTFILE-STATUS
               OPEN OUTPUT TYPOPS
               PERFORM 833-RETRIEVE-EQUIPREF THRU 833-RE-X
               MOVE "N" TO ANSWER-SW-E.
           IF ANSWER-SW-D = "Y"
               NEXT SENTENCE
           ELSE
           MOVE "N" TO ANSWER-SW-D
           DISPLAY "DO YOU WANT TO RETRIEVE DRAWING FILE INFO (Y/N)?"
           ACCEPT ANSWER-SW-D
           IF ANSWER-SW-D = "Y"
               OPEN INPUT DRAWING-FILE
               MOVE "*CURLIB   "  TO CCRTFILE-LIBRARY
               MOVE "MCFPDRWFIL"  TO CCRTFILE-FILE
               MOVE "0196"        TO CCRTFILE-RECORD-LENGTH
               MOVE "05000"       TO CCRTFILE-NO-RECORDS
               MOVE "01000"       TO CCRTFILE-INCREMENT-AMT
               MOVE "03"          TO CCRTFILE-NO-INCREMENTS
               CALL "CCRTFILE" USING CCRTFILE-LIBRARY
                                     CCRTFILE-FILE
                                     CCRTFILE-RECORD-LENGTH
                                     CCRTFILE-NO-RECORDS
                                     CCRTFILE-INCREMENT-AMT
                                     CCRTFILE-NO-INCREMENTS
                                     CCRTFILE-STATUS
               OPEN OUTPUT DRWFIL
               PERFORM 834-RETRIEVE-DRAW-DATA THRU 834-RDD-X
               MOVE "N" TO ANSWER-SW-D.
023200 83-RO-EXIT.    EXIT.
023300
023400 831-FIND-MSTR.
023500     MOVE 0 TO COND-WORD.
023600     MOVE ARG-DEFN TO HIERKEY OF WEHREC.
           START WO-EQUIP-HIER KEY > EXTERNALLY-DESCRIBED-KEY
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF FILE-STATUS NOT = "00" MOVE 17 TO COND-WORD.
024000     IF COND-WORD = 17
024100         MOVE SPACES TO ERROR-BUFFER
024200         MOVE "START ERROR ON WO-EQUIP-HIER " TO ERROR-BUFFER
024300         MOVE TRUE-VAL TO INDS (99)
               MOVE ERROR-BUFFER TO READ-ERR-LINE
029000         MOVE READ-ETYPES TO DSPLY-REC
024600         PERFORM 99-SCREEN-WRITE
025100         GO TO 2-EOJ
025200     ELSE
025300     PERFORM 85-GET-ENTRIES THRU 85-GE-EXIT UNTIL
025400             COND-WORD = 15.
           MOVE "Y" TO ALL-MSTRS-FOUND-SW.
026000 831-FM-EXIT.    EXIT.
026200
       832-RETRIEVE-CC-LINK.
           MOVE OUTF TO HIERKEY OF CC-LINK-REC.
           START CC-LINK-FILE KEY > HIERKEY OF CC-LINK-REC
               INVALID KEY    MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
                   GO TO 832-RSP-X.
       832-RSP-LOOP.
           READ CC-LINK-FILE NEXT INTO CC-LINK-BUF
               AT END    MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00" GO TO 832-RSP-X.
           IF HKEY-TYPE NOT = OUTF-TYPE GO TO 832-RSP-X.
           MOVE CC-LINK-BUF TO SPAREP-REC.
           WRITE SPAREP-REC.
           GO TO 832-RSP-LOOP.
       832-RSP-X.    EXIT.

       833-RETRIEVE-EQUIPREF.
           MOVE OUTF TO EQRTYSUBK OF TYPE-REF-REC.
           START TYPE-REF KEY > EQRTYSUBK OF TYPE-REF-REC
               INVALID KEY     MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00" GO TO 833-RETRIEVE-EQPREF.
       833-RT-LOOP.
           READ TYPE-REF NEXT INTO BUF-TYPE-REF
               AT END    MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00" GO TO 833-RETRIEVE-EQPREF.
           IF TSK-EQUIP OF BUF-TYPE-REF NOT = OUTF-TYPE
               NEXT SENTENCE
           ELSE
           MOVE BUF-TYPE-REF TO TYPREF-REC
           WRITE TYPREF-REC
           GO TO 833-RT-LOOP.

           MOVE OUTF TO EQRTYSUBK OF TYPE-REMARKS-REC.
           START TYPE-REMARKS KEY > EQRTYSUBK OF TYPE-REMARKS-REC
               INVALID KEY     MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00" GO TO 833-RETRIEVE-TYPE-OPS.
       833-RTR-LOOP.
           READ TYPE-REMARKS NEXT INTO BUF-TYPE-REM
               AT END    MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00" GO TO 833-RETRIEVE-TYPE-OPS.
           IF TSK-EQUIP OF BUF-TYPE-REM NOT = OUTF-TYPE
               GO TO 833-RETRIEVE-TYPE-OPS.
           MOVE BUF-TYPE-REM TO TYPREM-REC.
           WRITE TYPREM-REC.
           GO TO 833-RTR-LOOP.

       833-RETRIEVE-TYPE-OPS.
           MOVE OUTF TO EQRTYSUBK OF TYPE-OPERATIONS-REC.
           START TYPE-OPERATIONS KEY > EQRTYSUBK OF TYPE-OPERATIONS-REC
               INVALID KEY     MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00" GO TO 833-RETRIEVE-EQPREF.
       833-RTO-LOOP.
           READ TYPE-OPERATIONS NEXT INTO BUF-TYPE-OPS
               AT END    MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00" GO TO 833-RETRIEVE-EQPREF.
           IF TSK-EQUIP OF BUF-TYPE-OPS NOT = OUTF-TYPE
               GO TO 833-RETRIEVE-EQPREF.
           MOVE BUF-TYPE-OPS TO TYPOPS-REC.
           WRITE TYPOPS-REC.
           GO TO 833-RTO-LOOP.

       833-RETRIEVE-EQPREF.
           READ EQUIP-REF NEXT INTO BUF-EQP-REF
               AT END    MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "46"
                   CLOSE EQUIP-REF
                   OPEN INPUT EQUIP-REF
                   GO TO 833-RE-X
               ELSE
               GO TO 833-RE-X.
           IF EQP-CORP-TYPE = OUTF-TYPE
               PERFORM 8330-RETRIEVE-REMARKS THRU 8330-RR-X
               PERFORM 8331-RETRIEVE-OPERATIONS THRU 8331-RO-X
               MOVE BUF-EQP-REF TO EQPREF-REC
               WRITE EQPREF-REC
               GO TO 833-RETRIEVE-EQPREF
           ELSE
           GO TO 833-RETRIEVE-EQPREF.

       8330-RETRIEVE-REMARKS.
           MOVE EQP-SUB-KEY OF BUF-EQP-REF
                            TO EQRSUBKEY OF EQUIP-REMARKS-REC.
           START EQUIP-REMARKS KEY = EQRSUBKEY OF EQUIP-REMARKS-REC
               INVALID KEY    MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00" GO TO 8330-RR-X.
       8330-RR-LOOP.
           READ EQUIP-REMARKS NEXT INTO BUF-EQP-REM
               AT END    MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00" GO TO 8330-RR-X.
           IF EQP-SUB-KEY OF BUF-EQP-REF NOT =
               EQP-SUB-KEY OF BUF-EQP-REM GO TO 8330-RR-X.
           MOVE BUF-EQP-REM TO EQPREM-REC.
           WRITE EQPREM-REC.
           GO TO 8330-RR-LOOP.
       8330-RR-X.    EXIT.

       8331-RETRIEVE-OPERATIONS.
           MOVE EQP-SUB-KEY OF BUF-EQP-REF
                            TO EQRSUBKEY OF EQUIP-OPERATIONS-REC.
           START EQUIP-OPERATIONS KEY =
                               EQRSUBKEY OF EQUIP-OPERATIONS-REC
               INVALID KEY    MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00" GO TO 8331-RO-X.
       8331-RO-LOOP.
           READ EQUIP-OPERATIONS NEXT INTO BUF-EQP-OPS
               AT END    MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00" GO TO 8331-RO-X.
           IF EQP-SUB-KEY OF BUF-EQP-OPS NOT =
               EQP-SUB-KEY OF BUF-EQP-REF GO TO 8331-RO-X.
           MOVE BUF-EQP-OPS TO EQPOPS-REC.
           WRITE EQPOPS-REC.
           GO TO 8331-RO-LOOP.
       8331-RO-X.    EXIT.

       833-RE-X.    EXIT.

       834-RETRIEVE-DRAW-DATA.
           MOVE OUTF-TYPE TO DRWTYPNUM OF DRAWING-FILE-REC.
           START DRAWING-FILE KEY = DRWTYPNUM OF DRAWING-FILE-REC
               INVALID KEY    MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00" GO TO 834-RDD-X.
       834-RDD-LOOP.
           READ DRAWING-FILE NEXT INTO DRAWFILE-DATA
               AT END    MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00" GO TO 834-RDD-X.
           IF DRAW-TNUM NOT = OUTF-TYPE GO TO 834-RDD-X.
           MOVE DRAWFILE-DATA TO DRWFIL-REC.
           WRITE DRWFIL-REC.
           GO TO 834-RDD-LOOP.
       834-RDD-X.    EXIT.

026300 85-GET-ENTRIES.
           MOVE 0 TO COND-WORD.
           READ WO-EQUIP-HIER NEXT INTO EQUIP-HIER-BUFFER
               AT END    MOVE 15 TO COND-WORD.
           IF HIER-TYPE-DEFN NOT = EQP-TYPE-BUF MOVE 15 TO COND-WORD.
           IF FILE-STATUS NOT = "00" MOVE 15 TO COND-WORD.
026600     IF COND-WORD = 15 GO TO 85-GE-EXIT.
031300     MOVE HIER-KEY-BUF  TO SUBTYP-SORT.
031400     MOVE SON-4-BUF     TO SUBNUM-SORT.
031500     MOVE SUB-ASSY-NAME TO SUBNAME-SORT.
031600     RELEASE SORT-REC.
031700 85-GE-EXIT.    EXIT.
032100
032200 9-WRITE-RECORDS.
032400     PERFORM 9-WR-LOOP THRU 9-WR-EXIT.
032500 9-WR-LOOP.
032600     RETURN SORT-FILE AT END GO TO 9-WR-EXIT.
032700     MOVE SORT-REC TO RETF.
032800     WRITE RETF.
033100     GO TO 9-WR-LOOP.
033200 9-WR-EXIT.    EXIT.
