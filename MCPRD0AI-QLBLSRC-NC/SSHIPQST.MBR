       IDENTIFICATION DIVISION.
       PROGRAM-ID.     SSHIPQST.
       AUTHOR.         CA YODER.
       INSTALLATION.   THE GOODYEAR TIRE AND RUBBER COMPANY - AKRON.
       DATE-WRITTEN.   08/03/1995.
       DATE-COMPILED.
      *REMARKS.
      *D* * * * * * * * * * * * * * * * * * * * * * * * * * * * * *
      *D*                                                         *
      *D*  SSHIPQST    PURCHASING SHIP DATE QUESTIONS SUBPROGRAM  *
      *D*                                                         *
      *D* * * * * * * * * * * * * * * * * * * * * * * * * * * * * *
      *

       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.
       SOURCE-COMPUTER.  IBM-AS400.
       OBJECT-COMPUTER.  IBM-AS400.
       SPECIAL-NAMES. I-O-FEEDBACK IS I-O-FEEDBACK-AREA.
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
            SELECT DISPLAY-FILE
                   ASSIGN TO WORKSTATION-ZPLTSTUP-SI
                   ORGANIZATION IS TRANSACTION
                   ACCESS IS SEQUENTIAL
                   FILE STATUS IS DISPLAY-STATUS
                   CONTROL-AREA IS WS-CONTROL.
            SELECT MPLTINFO-O
                   ASSIGN TO DATABASE-MCFLCS0501
                   ORGANIZATION IS INDEXED
                   ACCESS IS DYNAMIC
                   RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                   FILE STATUS IS FILE-STATUS.
       DATA DIVISION.
       FILE SECTION.
       FD  DISPLAY-FILE
           LABEL RECORDS ARE OMITTED.
       01  DISPLAY-REC                   PIC X(2000).
       FD  MPLTINFO-O
           LABEL RECORDS ARE STANDARD.
       01  MPLTINFO-O-REC.
           COPY DDS-MCRPCS0500 OF MCFLCS0501.

       WORKING-STORAGE SECTION.
       01  FILE-STATUS.
           05  FILE-STATUS-1             PIC X VALUE SPACE.
           05  FILE-STATUS-2             PIC X VALUE SPACE.

      *************************************************************
      **                                                         **
      **           P R O G R A M   V A R I A B L E S             **
      **                                                         **
      *************************************************************
       77  LINE-NO                       PIC 9(2)  VALUE 1.

       01  REPLACE-SW                    PIC X(1).
           88  REPLACE-SW-ON          VALUE "Y".

       01  BUPDESLT-SW                   PIC X.

       01  SKIP-TO-BUPDESLT-SW           PIC X  VALUE "N".

       01  CHANGE-TYPE                   PIC X.

      *************************************************************
      **                                                         **
      **              D A T A    B A S E    A R E A              **
      **                                                         **
      *************************************************************
       COPY MPLTINFO IN COPYLIB.
       COPY MPLTST   IN COPYLIB.
       01  MPLTINFO-ARG                  PIC X(4).
       COPY DBSTAT IN COPYLIB.

      *************************************************************
      **                                                         **
      **              V I E W   W O R K   A R E A                **
      **                                                         **
      *************************************************************
       01  MESSAGE-BUFFER.
           05  MSG-TEXT                  PIC X(64)  VALUE SPACES.
           05  MSG-FLD                   PIC X(12)  VALUE SPACES.
           05  MSG-FLD-9 REDEFINES MSG-FLD
                                         PIC Z(11)9.

      *************************************************************
      **                                                         **
      **                 TERMINAL I/O DATA AREA                  **
      **                                                         **
      *************************************************************
       01  SHIP-DAYS-SCREEN.
           05  SHIP-DAYS-SW              PIC X(1).
           05  SHIP-DAYS                 PIC 9(2).
           05  NEW-CODES                 PIC X(1).
           05  ALL-CODES                 PIC X(1).
           05  CHG-DAYS                  PIC 9(2).
           05  CHANGE-MESSAGE            PIC X(50).
           05  CONTINUE-DB-SW            PIC X(1).
           05  S1-MSGLINE1               PIC X(79).
           05  S1-CMDLINE                PIC X(79).
           05  S1-MSGLINE                PIC X(79).

      *************************************************************
      **                                                         **
      **         S U B P R O G R A M   A R E A S                 **
      **                                                         **
      *************************************************************
       COPY TBLOWUP  IN COPYLIB.
       COPY CATREAD  IN COPYLIB.
       COPY DISPDATA IN COPYLIB.
       COPY IOFEEDBACK IN COPYLIB.

       COPY CSTRMJB2 IN COPYLIB.

       01  CONTROL-FIELDS.
           05  CF-CHANGE-OPT             PIC X.
           05  CF-DAYS                   PIC X(2).

      *************************************************************
      **                                                         **
      **               LINKAGE   SECTION                         **
      **                                                         **
      *************************************************************
       LINKAGE SECTION.

       01  BASE                          PIC X(10).
       COPY VCOMLINK IN COPYLIB.
       COPY LANGSUB IN COPYLIB.

      *************************************************************
      **#########################################################**
      *************************************************************
      **                                                         **
      **          P R O C E D U R E    D I V I S I O N           **
      **                                                         **
      *************************************************************
      **#########################################################**
      *************************************************************

       PROCEDURE DIVISION USING BASE,
                                VIEW-COMAREA,
                                LANGUAGE-PARMS.


       1-START.
           OPEN I-O DISPLAY-FILE, MPLTINFO-O.
           PERFORM 60-SCREEN   THRU 60-SCREEN-X.
           CLOSE DISPLAY-FILE, MPLTINFO-O.
           GOBACK.

      ******************************************************
      **                 BLOWUP ROUTINE                   **
      ******************************************************
       2-BLOWUP.
           CALL "TBLOWUP" USING BASE, BU-PGM-NAME, STATUS-AREA,
               VIEW-COMAREA, FILE-STATUS, BU-DISPLAY-MSG,
               BU-DISPLAY-AREA.

      **************************************************
      *                                                *
      *         M A I N    P R O C E S S I N G         *
      *                                                *
      **************************************************

       60-SCREEN.
           MOVE "SSHIPQST"             TO  BU-PGM-NAME.
           MOVE "SHIPQUES"             TO  VIEW-NFNAME.

       60-PUT-BUFFER.
           INITIALIZE SHIP-DAYS-SCREEN.
           MOVE ALL "*"                TO CHANGE-MESSAGE.
           PERFORM 601-READ-MPLTINFO.

       60-SHOW-FORM.
           MOVE SHIP-DAYS-SCREEN       TO  DISPLAY-REC.
           PERFORM 998-WRITE-SCREEN THRU 998-READ-SCREEN.
           MOVE DISPLAY-REC            TO  SHIP-DAYS-SCREEN.
           IF VIEW-LASTKEY = 3
               GO TO 60-SCREEN-X.
           IF VIEW-LASTKEY = 1 OR
              VIEW-LASTKEY = 2 OR
              VIEW-LASTKEY = 4 OR
              VIEW-LASTKEY = 5 OR
              VIEW-LASTKEY = 6 OR
              VIEW-LASTKEY = 7 OR
              VIEW-LASTKEY = 8
      *****    INVALID FUNCTION KEY    *****
               MOVE   9                TO  LANG-SETNUM
               MOVE  10                TO  LANG-MSGNUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER     TO  S1-MSGLINE
               MOVE B"1"               TO  IND(99)
               GO TO 60-SHOW-FORM.

           INITIALIZE SRF-INDICATORS.

           IF SKIP-TO-BUPDESLT-SW = "Y"
               GO TO 61-UPDATE-MSTORERM.

           IF SHIP-DAYS-SW = "Y"
               IF SHIP-DAYS > 0
                   NEXT SENTENCE
               ELSE
      *----------- NO DAYS ENTERED WHEN SHIP DATE SWITCH SET TO "Y".
                   MOVE "ENTER NUMBER OF DAYS" TO S1-MSGLINE
                   MOVE B"1"               TO  IND(99)
                                               IND(20)
                   GO TO 60-SHOW-FORM
               END-IF
           END-IF.

       60-REPLACE-MPLTINFO.
      *--- FIELD FOR DEFAULT VALUE TO USE TO OBTAIN EXPECT DATE FOR
      *--- SHIPPING RELEASES.
           MOVE "POPT"                 TO  MPLTINFO-ARG.
           PERFORM 9-READ-MPLTINFO.
           IF SHIP-DAYS-SW = "Y"
               NEXT SENTENCE
           ELSE
               MOVE ZEROS              TO  SHIP-DAYS
               MOVE "N"                TO  SHIP-DAYS-SW.
           MOVE SHIP-DAYS-SW           TO  MPLTINFO-SHIP-DAYS-SW.
           MOVE SHIP-DAYS              TO  MPLTINFO-SHIP-DAYS-9.
           PERFORM 9-REWRITE-MPLTINFO.

       61-UPDATE-MSTORERM.
           IF NEW-CODES NOT = "X" AND ALL-CODES NOT = "X"
               GO TO 60-SCREEN-X.
           IF NEW-CODES = "X" AND ALL-CODES = "X"
               MOVE "CHOOSE ONLY ONE OPTION NOT BOTH" TO S1-MSGLINE
               MOVE B"1"        TO  IND(99)
                                    IND(23)
                                    IND(30)
               MOVE "Y"         TO  SKIP-TO-BUPDESLT-SW
               GO TO 60-SHOW-FORM.
           IF (NEW-CODES = "X" OR ALL-CODES = "X") AND CHG-DAYS NOT > 0
               MOVE "NUMBER OF DAYS MUST BE ENTERED" TO S1-MSGLINE
               MOVE B"1"        TO  IND(99)
                                    IND(21)
                                    IND(30)
               MOVE "Y"         TO  SKIP-TO-BUPDESLT-SW
               GO TO 60-SHOW-FORM.
           IF NEW-CODES = "X"
               PERFORM 610-PROCESS-NEW
           ELSE
               PERFORM 611-PROCESS-ALL.


       60-SCREEN-X.
           EXIT.

       601-READ-MPLTINFO.
      *--- READ FOR DEFAULT NUMBER OF DAYS TO BE USED IN CALCULATING
      *--- EXPECT DAYS FOR SHIPPING RELEASES.
           MOVE "POPT"                 TO  MPLTINFO-ARG.
           PERFORM 9-READ-MPLTINFO.
           IF FILE-STATUS = "2"
               MOVE SPACES             TO  BUF-MPLTINFO
               MOVE "POPT"             TO  MPLTINFO-KEY
               MOVE "N"                TO  MPLTINFO-SHIP-DAYS-SW
               MOVE ZEROS              TO  MPLTINFO-SHIP-DAYS-9
               PERFORM 9-WRITE-MPLTINFO.
           IF    MPLTINFO-SHIP-DAYS-SW = SPACES OR
                 MPLTINFO-SHIP-DAYS    NOT NUMERIC
               IF MPLTINFO-SHIP-DAYS-SW = SPACES
                   MOVE "N"            TO  MPLTINFO-SHIP-DAYS-SW
               END-IF
               IF MPLTINFO-SHIP-DAYS NOT NUMERIC
                   MOVE ZEROS          TO  MPLTINFO-SHIP-DAYS-9
               END-IF
               PERFORM 9-REWRITE-MPLTINFO
           END-IF.
           MOVE MPLTINFO-SHIP-DAYS-SW  TO SHIP-DAYS-SW.
           MOVE MPLTINFO-SHIP-DAYS-9   TO SHIP-DAYS.
           MOVE MPLTINFO-BUPDESLT-SW   TO BUPDESLT-SW.

       610-PROCESS-NEW.
           IF CONTINUE-DB-SW = "Y"
               MOVE "N"                    TO CHANGE-TYPE
               PERFORM 612-CALL-CSTRMJB2
           ELSE
               IF CONTINUE-DB-SW = "N"
                   NEXT SENTENCE
           ELSE
               MOVE "*** CODES WITH ZERO SHIP TIME WILL BE CHANGED  ***"
                                           TO CHANGE-MESSAGE
               MOVE B"1"                   TO IND(22)
                                              IND(30)
               GO TO 60-SHOW-FORM
           END-IF.

       611-PROCESS-ALL.
      *------ ASK IF THE USER WANTS TO UPDATE THE DATABASE RECORDS.
           IF CONTINUE-DB-SW = "Y"
               IF BUPDESLT-SW = "Y"
      *-------------- IF JOB HAS ALREADY BEEN RUN, DON'T RUN IT.
                   MOVE "DATABASE HAS ALREADY BEEN UPDATED--CANNOT UPDAT
      -                     "E AGAIN.  PRESS F3 TO EXIT."
                                              TO  S1-MSGLINE
                   MOVE B"1"                  TO  IND(99)
                                                  IND(22)
                                                  IND(30)
                   GO TO 60-SHOW-FORM
               ELSE
                   MOVE "A"                   TO  CHANGE-TYPE
                   PERFORM 612-CALL-CSTRMJB2
                   GO TO 60-SCREEN-X
               END-IF
           ELSE
               IF CONTINUE-DB-SW = "N"
                   GO TO 60-SCREEN-X
           ELSE
               MOVE "*** THE SHIP TIME OF ALL CODES WILL BE CHANGED ***"
                                           TO CHANGE-MESSAGE
               MOVE B"1"                      TO  IND(22)
                                                  IND(30)
           END-IF.
           GO TO 60-SHOW-FORM.

       612-CALL-CSTRMJB2.
           INITIALIZE CSTRMJB2-PARMS.
           MOVE "BSHIPTOP"             TO CSTRM-TOP-FILE.
           MOVE "BSHIPBOT"             TO CSTRM-BOTTOM-FILE.
           MOVE CHANGE-TYPE            TO CF-CHANGE-OPT.
           MOVE CHG-DAYS               TO CF-DAYS.
           MOVE CONTROL-FIELDS         TO CSTRM-RUN-CARD (1).
           CALL "CSTRMJB2"  USING CSTRMJB2-PARMS, VIEW-COMAREA.

      ***************************************************************
      **                                                           **
      **          P E R F O R M E D    R O U T I N E S             **
      **                                                           **
      ***************************************************************

       9-READ-MPLTINFO.
           MOVE 0                      TO  COND-WORD.
           MOVE MPLTINFO-ARG TO PLTINFOKEY OF MPLTINFO-O-REC.
           READ MPLTINFO-O INTO BUF-MPLTINFO
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS-1 = "2"
               NEXT SENTENCE
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE "READ MPLTINFO ERROR IN 9-READ-MPLTINFO"
                                       TO  BU-DISPLAY-MSG
               MOVE MPLTINFO-ARG       TO  BU-DISPLAY-FLD (1)
               PERFORM 2-BLOWUP.

       9-WRITE-MPLTINFO.
           WRITE MPLTINFO-O-REC FROM BUF-MPLTINFO
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE "WRT MPLTINFO ERROR IN 9-WRITE-MPLTINFO"
                                       TO  BU-DISPLAY-MSG
               MOVE MPLTINFO-KEY       TO  BU-DISPLAY-FLD (1)
               PERFORM 2-BLOWUP.

       9-REWRITE-MPLTINFO.
           REWRITE MPLTINFO-O-REC FROM BUF-MPLTINFO
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE "REWRITE  ERROR IN 9-REWRITE-MPLTINFO"
                                       TO  BU-DISPLAY-MSG
               MOVE MPLTINFO-KEY       TO  BU-DISPLAY-FLD (1)
               PERFORM 2-BLOWUP.

       COPY DISPCALL IN COPYLIB.

       999-CATREAD.
           IF CATREAD-MSG-NUMBER = ZEROS
               MOVE LANG-SETNUM        TO  CATREAD-MSG-SET
               MOVE LANG-MSGNUM        TO  CATREAD-MSG-NUM.
           CALL "CCATREAD" USING CATREAD-PARMS.
           MOVE CATREAD-MSG-TEXT       TO  MESSAGE-BUFFER.
       999-CATREAD-EXIT.
           EXIT.
