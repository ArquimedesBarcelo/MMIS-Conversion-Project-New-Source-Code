126700             GO TO 2-BLOWUP.
           IF CORPCDE OF DREQITM-REC-O NOT = CODE-ARG
               GO TO 63-UNLOCK-REQ-SETS.
126800
126900     MOVE REQITM-REQ-NUMBER  TO  REQ-ARG.
           MOVE REQ-ARG TO REQNO OF MREQ-REC-O.
           READ MREQ-O INTO BUF-MREQ
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
127300         MOVE "GET MREQ * 63-GD"  TO  BU-DISPLAY-MSG
127400         MOVE REQ-ARG      TO BU-DISPLAY-FLD (3)
127500         GO TO 2-BLOWUP.
127600
127700     IF REQ-RELEASE-STAT = "XX"
127800         IF REQ-HOLD-STATUS NOT = "BATCHFILE"
127900             GO TO 63-GET-DREQITM.
128000     IF REQ-RELEASE-STAT = "XX"
128100*        "PENDING RELEASE"
128200         MOVE  16                 TO  LANG-SETNUM
128300         MOVE 124                 TO  LANG-MSGNUM
128400     ELSE
128500     IF REQ-MATCONT-RELEASE = "X"
128600*        "PURCHASING"
128700         MOVE  16                 TO  LANG-SETNUM
128800         MOVE   1                 TO  LANG-MSGNUM
128900     ELSE
           IF REQ-APPROVALS-LEFT = "  " OR "00"
129000*M       "MATERIALS CONTROL"
129100         MOVE  13                 TO  LANG-SETNUM
129200         MOVE  17                 TO  LANG-MSGNUM
           ELSE
      *M       "AWAITING APPROVALS"
               MOVE   1                 TO  LANG-SETNUM
               MOVE  30                 TO  LANG-MSGNUM.
129300     PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
129400     MOVE MESSAGE-BUFFER          TO  AREA-OUT.
129500     MOVE MREQ-NUMBER             TO  OPEN-REQ-OUT.
129600     IF REQ-MATCONT-RELEASE = "X"
129700         IF REQ-HOLD-STATUS = SPACES
129800*            "PURCHASING"
129900              MOVE  16            TO  LANG-SETNUM
130000              MOVE   1            TO  LANG-MSGNUM
130100              PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
130200              MOVE MESSAGE-BUFFER TO  STATUS-OUT
130300         ELSE
130400         IF REQ-HOLD-STATUS = "BATCHFILE"
130500*            "BATCHFILE"
130600              MOVE   2            TO  LANG-SETNUM
130700              MOVE   7            TO  LANG-MSGNUM
130800              PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
130900              MOVE MESSAGE-BUFFER TO STATUS-OUT
131000         ELSE
131100             MOVE REQ-HOLD-STATUS  TO  STATUS-OUT
131200     ELSE
131300         IF REQ-HOLD-STATUS = SPACES
131400*            "MTL. CTL."
131500             MOVE  13             TO  LANG-SETNUM
131600             MOVE   8             TO  LANG-MSGNUM
131700             PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
131800             MOVE MESSAGE-BUFFER  TO  STATUS-OUT
131900         ELSE
132000             MOVE REQ-HOLD-STATUS TO  STATUS-OUT.
132100     MOVE "Y"                     TO  OPEN-REQ-SW,
132200                                      OPEN-REQ-MSG-SW.
132300     MOVE OPEN-REQ-MSG1           TO  MSG-LINE-1.
132400     MOVE  16                     TO  LANG-SETNUM.
132500     MOVE   8                     TO  LANG-MSGNUM.
132600     PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
132700     MOVE MESSAGE-BUFFER          TO  MSG-LINE-2.

       63-UNLOCK-REQ-SETS.
      *------- DO A START > HIGH-VALUES TO UNLOCK
           MOVE HIGH-VALUES TO CORPCDE OF DREQITM-REC-O.
           START DREQITM-O KEY > CORPCDE OF DREQITM-REC-O
               INVALID KEY MOVE "00" TO FILE-STATUS.
133400
      *------- DO A START > HIGH-VALUES TO UNLOCK
           MOVE HIGH-VALUES TO REQNO OF MREQ-REC-O.
           START MREQ-O KEY > REQNO OF MREQ-REC-O
               INVALID KEY MOVE "00" TO FILE-STATUS.

133500 63-CFOR-X.
133600     EXIT.
133700
       COPY DISPCALL IN COPYLIB.
       998-AUTO-READ-SCREEN.
           READ  DISPLAY-FILE TERMINAL IS TERMINAL-ID
               INDIC ARE SRF-INDICATORS
                   NO DATA MOVE DISPLAY-STATUS TO DISPLAY-STATUS.
           MOVE ALL B"0" TO SRF-INDICATORS.

133800 999-CATREAD.
           IF CATREAD-MSG-NUMBER = ZEROS
               MOVE LANG-SETNUM TO CATREAD-MSG-SET
               MOVE LANG-MSGNUM TO CATREAD-MSG-NUM.
           CALL "CCATREAD" USING CATREAD-PARMS.
           MOVE CATREAD-MSG-TEXT TO MESSAGE-BUFFER.
135400 999-CATREAD-EXIT.
135500     EXIT.
