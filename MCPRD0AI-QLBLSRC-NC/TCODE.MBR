000300 IDENTIFICATION DIVISION.
000400 PROGRAM-ID. TCODE.
000800*REMARKS.
000900*         #######################################################
001000*         # Main program for personnel absence code maintenance #
001100*         #######################################################.
001500 ENVIRONMENT DIVISION.
001600 CONFIGURATION SECTION.
001700 SOURCE-COMPUTER. AS400.
001800 OBJECT-COMPUTER. AS400.
       SPECIAL-NAMES.      I-O-FEEDBACK IS I-O-FEEDBACK-AREA
                           LOCAL-DATA IS LOCAL-DATA-AREA.
001000 INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT DISPLAY-FILE
               ASSIGN TO WORKSTATION-ZPERSON-SI
               ORGANIZATION IS TRANSACTION
               ACCESS IS SEQUENTIAL
               FILE STATUS IS DSPLY-STATUS
               CONTROL-AREA IS WS-CONTROL.
002200 DATA DIVISION.
       FILE SECTION.
       FD  DISPLAY-FILE
           LABEL RECORDS ARE OMITTED.
       01  DSPLY-REC                     PIC X(2000).
002300 WORKING-STORAGE SECTION.
       COPY CPYIND  OF COPYLIB.
       01  DSPLY-STATUS                  PIC XX.
       COPY IOFEEDBACK OF COPYLIB.
002400 01  PASSWORD-INFORMATION.
002500     05  NAME-OF-PROGRAM     PIC X(08) VALUE "TCODE   ".
002600     05  PROGRAM-TYPE        PIC X(02) VALUE "MA".
002700     05  PROGRAM-RELEASE     PIC X(12) VALUE " E0100010001".
002800     05  PROGRAM-DESCRIPTION.
002900         10  PROG-DESC-A.
                   15  FILLER      PIC X(17) VALUE "PERSONNEL SYSTEM ".
                   15  FILLER      PIC X(13) VALUE "ABSENCE CODE ".
                   15  FILLER      PIC X(12) VALUE "MAINTENANCE ".
                   15  FILLER      PIC X(18) VALUE "PROGRAM".
003100         10  PROG-DESC-B     PIC X(60) VALUE SPACES.
003300         10  PROG-FUNCTION   PIC X(60) VALUE SPACES.
003500     05  PASSWORD-FLAG       PIC X.
004300 COPY DBSTAT    OF COPYLIB.
       COPY WSCONTROL OF COPYLIB.
004800 LINKAGE SECTION.
004900 01  DBPARAMETERS.                 COPY DBPARMS  OF COPYLIB.
005000 COPY VCOMLINK  OF COPYLIB.
005100 01  PLT-IDT                       PIC X(4).
005400 PROCEDURE DIVISION USING DBPARAMETERS
005500                          VIEW-COMAREA
005600                          PLT-IDT.
       START-PGM.
           PERFORM 1-HSK.
006800     PERFORM 6-MAIN THRU 6-MAIN-EXIT UNTIL VIEW-LASTKEY = 3.
       2-EOJ.
           CLOSE DISPLAY-FILE.
           GOBACK.
005800 1-HSK.
           OPEN I-O   DISPLAY-FILE.
005900     CALL "TPWORD" USING PASSWORD-INFORMATION.
006300     IF PASSWORD-FLAG = "N" GO TO 2-EOJ.
007500 6-MAIN.
008400     MOVE "FCODE" TO VIEW-CFNAME.
           PERFORM 99-SCREEN-WRITE.
           PERFORM 98-SCREEN-READ.
014500     IF VIEW-LASTKEY = 3
014700         GO TO 2-EOJ
014800     ELSE
010300     IF VIEW-LASTKEY = 1
011900         CALL "TLSTCODE" USING DBPARAMETERS
012000                               VIEW-COMAREA
012100                               PLT-IDT
               MOVE 0 TO VIEW-LASTKEY
012300     ELSE
012400     IF VIEW-LASTKEY = 2
012600         CALL "TADDCODE" USING DBPARAMETERS
012700                               VIEW-COMAREA
012800                               PLT-IDT
               MOVE 0 TO VIEW-LASTKEY
013000     ELSE
013100     IF VIEW-LASTKEY = 4
013300         CALL "TDELPCOD" USING DBPARAMETERS
013400                               VIEW-COMAREA
013500                               PLT-IDT
               MOVE 0 TO VIEW-LASTKEY
013700     ELSE
013800     IF VIEW-LASTKEY = 5
014000         CALL "TMODCODE" USING DBPARAMETERS
014100                               VIEW-COMAREA
014200                               PLT-IDT
               MOVE 0 TO VIEW-LASTKEY.
       6-MAIN-EXIT.    EXIT.

       98-SCREEN-READ.
           READ DISPLAY-FILE FORMAT IS VIEW-CFNAME
               INDIC IS INDICS.
           ACCEPT IOFEEDBACK FROM I-O-FEEDBACK-AREA.
           MOVE ALL B"0" TO INDICS.
           IF DSPLY-STATUS NOT = "00"
               MOVE 3 TO VIEW-LASTKEY
           ELSE
           MOVE FUNCTION-NUM TO VIEW-LASTKEY.

       99-SCREEN-WRITE.
           WRITE DSPLY-REC FORMAT IS VIEW-CFNAME
               INDIC IS INDICS.
           MOVE ALL B"0" TO INDICS.

