029500
029600
029700 PROCEDURE DIVISION.
029800
029900 001-BEGIN SECTION.
030000
030100 010-MAINLINE.
           MOVE "C" TO MCXCBLERR-SCOPE.
           CALL "MCXCBLERR" USING MCXCBLERR-SCOPE.

030200*******************************************************
030300**   CALL 'CBLOWSRT' FIRST BEFORE GOING INTO THE
030400**   SORT VERB.  THE FIRST CALL TO 'CBLOWSRT' OPENS
030500**   UP A NEW TEMPORARY FILE 'BLUPDATA' THAT IS USED
030600**   TO WRITE THE BLOWUP INFORMATION IF A BLOWUP
030700**   OCCURS
030800*******************************************************
030900
031000     CALL "CBLOWSRT" USING CBLOWSRT-PARMS,
031100                           ACCTG-BASE,
031200                           BU-PGM-NAME,
031300                           STATUS-AREA,
031400                           DUMMY-VIEW-AREA,
031500                           FILE-STATUS,
031600                           BU-DISPLAY-MSG,
031700                           BU-DISPLAY-FLDS.
031800
031900     DISPLAY "IS THIS THE FINAL RUN - Y/N?".
032000     ACCEPT FINAL-OR-NOT.
           DISPLAY "FINAL RUN (Y OR N) = ", FINAL-OR-NOT.
032100     SORT SORT-FILE ON ASCENDING KEY SORT-CLASS
032200                                     SORT-MATL-CODE
032300         INPUT PROCEDURE IS 050-PROCESS-TRANS
032400         OUTPUT PROCEDURE IS 700-CREATE-REPORT.
032500     PERFORM 1000-CLOSE-FILES.
032600     GOBACK.
032700
032900 050-PROCESS-TRANS SECTION.
       050-PROCESS-TRANS-PARA.
033000     PERFORM 100-BEGIN.
033100     PERFORM 200-PROCESS-MASTER
033200         UNTIL END-OF-FILE.
033300
033400**********************************************************
033500*  TRANSFER CONTROL TO LAST STATEMENT IN INPUT PROCEDURE *
033600*  FOR SORTING OF RECORDS.                               *
033700**********************************************************
033800
033900     GO TO 699-PROCESS-EXIT.
034000
034100 100-BEGIN.
           PERFORM 9999-OPEN-STUFF.
      *----- TRY TO OBTAIN THE PROPER WRITEDOWN ACCOUNT VALUE FROM
      *----- THE MACCOUNT-INFO DATASET (KEY=WDNA)
           MOVE "WDNA" TO MACCT-KEY.
           PERFORM 9999-DBGET7-MACCOUNT-INFO-IK-I.
           IF GOOD-CALL
               MOVE MACCT-WDN-ACCT TO SAVE-WDN-ACCT
           ELSE
               IF NO-ENTRY
                   MOVE "000250"   TO SAVE-WDN-ACCT
               ELSE
                   MOVE "GET MACCOUNT-INFO 'WDNA'*100"
                                   TO BU-DISPLAY-MSG
                   MOVE MACCT-KEY  TO BU-DISPLAY-FLD (1)
                   PERFORM 990-BLOWUP.

036100     MOVE "WDWN" TO MACCT-KEY.
           PERFORM 9999-DBGET7-MACCOUNT-INFO-IK-I.
036900     IF GOOD-CALL
037000         NEXT SENTENCE
037100     ELSE
037200         MOVE "GET MACCOUNT-INFO 'WDWN'*100" TO BU-DISPLAY-MSG
037300         PERFORM 990-BLOWUP.
037400
037500     MOVE SPACES TO SORT-REC.
037600     MOVE 0 TO SORT-CUR-ACT-COST
037700               SORT-CUR-VALUE
037800               SORT-85-ACT-COST
037900               SORT-85-VALUE
038000               SORT-15-WDOWN.
           PERFORM 9999-INIT-MMATL-ACCUM-MC-I.
038100     PERFORM 400-GET-MMATL-ACCUM.
038200
038400 200-PROCESS-MASTER.
038500     IF MATL-CLASS = MACCT-WDWN-CLASS (1) OR
038600                     MACCT-WDWN-CLASS (2) OR
038700                     MACCT-WDWN-CLASS (3) OR
038800                     MACCT-WDWN-CLASS (4) OR
038900                     MACCT-WDWN-CLASS (5) OR
039000                     MACCT-WDWN-CLASS (6) OR
039100                     MACCT-WDWN-CLASS (7) OR
039200                     MACCT-WDWN-CLASS (8) OR
039300                     MACCT-WDWN-CLASS (9) OR
039400                     MACCT-WDWN-CLASS (10)
039500         IF MATL-WDOWN-FLAG = 1
039600             PERFORM 600-BUILD-SORT-REC
039700         ELSE
039800             NEXT SENTENCE
039900     ELSE
040000         NEXT SENTENCE.
040100     PERFORM 400-GET-MMATL-ACCUM.
040200
040400 400-GET-MMATL-ACCUM.
           PERFORM 9999-DBGET2-MMATL-ACCUM-MC-I.
041200     IF GOOD-CALL
041300         NEXT SENTENCE
041400     ELSE
041500         IF END-OF-FILE
041600             NEXT SENTENCE
041700         ELSE
041800             MOVE "GET MMATL-ACCUM * 400-GMA" TO BU-DISPLAY-MSG
041900             PERFORM 990-BLOWUP.
042000
042100 600-BUILD-SORT-REC.
042200     MOVE MATL-STORES-CODE        TO SORT-MATL-CODE,
042300                                     CODE-ARG,
042400                                     BU-DISPLAY-FLD (1).
042500     PERFORM 650-GET-MSTORERM.
042600     IF NO-ENTRY
042700         NEXT SENTENCE
042800     ELSE
042900     IF STR-AVG-COST > 50
043000         MOVE MATL-CLASS          TO SORT-CLASS
043100         MOVE 1                   TO CDESC-LINES-TO-GET
043200         MOVE "N"                 TO CDESC-LOCAL-DESC-OPTION
043300         CALL "CDESC"  USING RET-CODE, STORES-BASE, STATUS-AREA,
043400             BU-DISPLAY-MSG, MATL-STORES-CODE, CDESC-DATA
043500         MOVE CDESC (1)           TO SORT-DESCR
043600         MOVE STR-AVG-COST        TO SORT-CUR-ACT-COST
043700         COMPUTE SORT-CUR-VALUE ROUNDED = STR-AVG-COST *
043800                                          STR-ONHAND
043900         COMPUTE SORT-85-ACT-COST ROUNDED = STR-AVG-COST * .9875
044000         COMPUTE SORT-85-VALUE ROUNDED = STR-ONHAND *
044100                                         SORT-85-ACT-COST
044200         COMPUTE SORT-15-WDOWN ROUNDED = SORT-CUR-VALUE -
044300                                        SORT-85-VALUE
044400         MOVE MATL-DEPT           TO SORT-DEPT
044500         RELEASE SORT-REC.
044600     MOVE SPACES                  TO SORT-REC.
044700     MOVE 0                       TO SORT-CUR-ACT-COST
044800                                     SORT-CUR-VALUE
044900                                     SORT-85-ACT-COST
045000                                     SORT-85-VALUE
045100                                     SORT-15-WDOWN.
045200
045300 650-GET-MSTORERM.
           PERFORM 9999-DBGET7-MSTORERM-CD-I.
046100     IF GOOD-CALL
046200         NEXT SENTENCE
046300     ELSE
046400         IF NO-ENTRY
046500             DISPLAY "NO ENTRY IN CSIS FOR CODE " CODE-ARG
046600         ELSE
046700             MOVE "DBGET MSTORERM * 650-GM" TO BU-DISPLAY-MSG
046800             PERFORM 990-BLOWUP.
046900
047100 699-PROCESS-EXIT.
047200     EXIT.
047300
047400 700-CREATE-REPORT SECTION.
       700-CREATE-REPORT-PARA.
047500     DISPLAY "BEGIN REPORT".
047600     PERFORM 710-BEGIN-REPORT.
047700     PERFORM 720-PROCESS-CLASS
047800        UNTIL NO-MORE-SORT = "YES".
047900     PERFORM 725-END-REPORT.
048000
048100**************************************************
048200**  BRANCH TO LAST STATEMENT OF OUTPUT SECTION  **
048300**  TO COMPLETE PROCESSING OF REPORT            **
048400**************************************************
048500
048600     GO TO 799-CREATE-EXIT.
048700
048800 710-BEGIN-REPORT.
048900     OPEN OUTPUT ONLINE-PRT.
049000     RETURN SORT-FILE
049100        AT END
049200            MOVE "YES" TO NO-MORE-SORT.
049300
049400 720-PROCESS-CLASS.
049500     PERFORM 721-BEGIN-CLASS.
049600     PERFORM 722-PROCESS-TRANS
049700         UNTIL SORT-CLASS NOT = PREV-CLASS
049800              OR NO-MORE-SORT = "YES".
049900     PERFORM 723-END-CLASS.
050000
050100 721-BEGIN-CLASS.
050200     MOVE SORT-CLASS              TO PREV-CLASS.
050300     MOVE 0                       TO CLASS-CUR-VALUE
050400                                     CLASS-85-VALUE
050500                                     CLASS-15-WRITEDOWN.
050600
050700     PERFORM 730-INIT-DEPT-TABLE
050800        VARYING I FROM 1 BY 1
050900          UNTIL I > 100.
051000     MOVE 0                       TO HOLD-I.
051100
051200     PERFORM 750-PRINT-HEADINGS.
051300
051500 722-PROCESS-TRANS.
051600     MOVE SORT-CLASS              TO PRT-CLASS.
051700     MOVE SORT-MATL-CODE          TO PRT-MATL-CODE.
051800     MOVE SORT-DESCR              TO PRT-DESCR.
051900     MOVE SORT-CUR-ACT-COST       TO PRT-CUR-ACT-COST.
052000     MOVE SORT-CUR-VALUE          TO PRT-CUR-VALUE.
052100     MOVE SORT-85-ACT-COST        TO PRT-85-ACT-COST.
052200     MOVE SORT-85-VALUE           TO PRT-85-VALUE.
052300     MOVE SORT-15-WDOWN           TO PRT-WRITEDOWN-15.
052400     MOVE SORT-DEPT               TO PRT-DEPT,
052500                                     DEPT-ARG.
052600     PERFORM 748-CHECK-WRITEDOWN-DEPT.
052700     WRITE PRT-REC FROM DETAIL-LINE AFTER ADVANCING 1.
052800     ADD 1                        TO LINE-CNT.
052900     IF INVALID-DEPT-SW = "Y"
053000         WRITE PRT-REC FROM INVALID-DEPT-MSG AFTER ADVANCING 1
053100         ADD 1                    TO LINE-CNT.
053200
053300     IF LINE-CNT > 55
053400         PERFORM 750-PRINT-HEADINGS.
053500     IF FINAL-OR-NOT = "Y"
053600         MOVE SPACES              TO BUF-DTRANS
053700         MOVE SORT-MATL-CODE      TO TRANS-STORES-CODE
053800                                     MMATL-CODE-ARG
053900         PERFORM 747-GET-MMATL-ACCUM
054000         MOVE SORT-CLASS          TO TRANS-CLASS
054100         PERFORM 748-MOVE-DEPT
054200*********MOVE "000250"            TO TRANS-ACCT *REPLACED 12FEB97*
               MOVE SAVE-WDN-ACCT       TO TRANS-ACCT
054300         MOVE "EA"                TO TRANS-UNIT-MEASURE
054400         MOVE "ISS"               TO TRANS-CODE
054500         MOVE 1                   TO DATE-MODE
054600         CALL "TDATECHK" USING DATE-CHECK-AREA
054700         MOVE DATE-YMD-OUT        TO TRANS-DATE
      *------------ ACCOUNT FOR CENTURY.
      *********IF TRANS-DATE-CC > "70"   *REPLACED 30JAN1997*
               IF TRANS-YY > "70"
                   MOVE "19"            TO TRANS-DATE-CC
               ELSE
                   MOVE "20"            TO TRANS-DATE-CC
               END-IF
054800         MOVE DATE-UNFORMATTED-TIME-OUT TO TRANS-TIME
054900         MOVE 0 TO TRANS-QTY
055000                   TRANS-BALANCE-QTY
055100         COMPUTE TRANS-VALUE = SORT-15-WDOWN * 1
DP9802*------------ 27FEB1998 ONLY WRITE A RECORD TO DTRANS IF
DP9802*------------  THE TRANSACTION VALUE IS GREATER THAN ZERO.
DP9802         IF TRANS-VALUE > 0
055200             ADD TRANS-VALUE          TO MATL-TOT-ISS-DOLLARS
055300             PERFORM 746-PUT-WDOWN-TRANS
055400             PERFORM 747-UPDATE-MMATL-ACCUM.

055500     ADD SORT-CUR-VALUE           TO CLASS-CUR-VALUE.
055600     ADD SORT-85-VALUE            TO CLASS-85-VALUE.
055700     ADD SORT-15-WDOWN            TO CLASS-15-WRITEDOWN.
055800
055900     PERFORM 731-BUILD-DEPT-TABLE
056000         VARYING I FROM 1 BY 1
056100             UNTIL FOUND-FLAG = 1 OR I > 100.
056200     MOVE 0                       TO FOUND-FLAG.
056300
056400     RETURN SORT-FILE
056500        AT END
056600             MOVE "YES" TO NO-MORE-SORT.
056700
056800 723-END-CLASS.
056900     MOVE PREV-CLASS              TO PRT-TOT-CLASS
057000                                     CLASS-ARG.
           PERFORM 9999-DBGET7-MCLASS-CL-I.
057800     IF GOOD-CALL
057900         MOVE MCLASS-CLASS-DESCR  TO PRT-CLASS-DESCR
058000     ELSE
058100         IF NO-ENTRY
058200             MOVE SPACES          TO PRT-CLASS-DESCR
058300         ELSE
058400             MOVE "DBGET MCLASS * 723-EC" TO BU-DISPLAY-MSG
058500             MOVE CLASS-ARG       TO BU-DISPLAY-FLD (1)
058600             PERFORM 990-BLOWUP.
058700
058800******************************************************
058900**   PRINT TOTAL FOR THE CLASS
059000******************************************************
059100     MOVE CLASS-CUR-VALUE         TO PRT-CLASS-CUR-VAL.
059200     MOVE CLASS-85-VALUE          TO PRT-CLASS-85-VAL.
059300     MOVE CLASS-15-WRITEDOWN      TO PRT-CLASS-15-WDWN.
059400     MOVE "TOTAL CLASS"           TO PRT-LITERAL.
059500     WRITE PRT-REC FROM PRT-CLASS-LINE AFTER ADVANCING 2.
059600     MOVE SPACES                  TO PRT-CLASS-LINE.
059700     ADD CLASS-CUR-VALUE          TO TOT-CUR-VALUE.
059800     ADD CLASS-85-VALUE           TO TOT-85-VALUE.
059900     ADD CLASS-15-WRITEDOWN       TO TOT-15-WRITEDOWN.
060000
060100     MOVE PREV-CLASS              TO CLASS-H3.
060200     PERFORM 755-PRINT-HEADINGS.
060300     PERFORM 732-SORT-DEPT
060400         VARYING I FROM 1 BY 1
060500            UNTIL I > HOLD-I.
060600
060800 725-END-REPORT.
060900     PERFORM 750-PRINT-HEADINGS.
061000     MOVE TOT-CUR-VALUE           TO PRT-CLASS-CUR-VAL.
061100     MOVE TOT-85-VALUE            TO PRT-CLASS-85-VAL.
061200     MOVE TOT-15-WRITEDOWN        TO PRT-CLASS-15-WDWN.
061300     MOVE "TOTAL WRITEDOWN VALUE" TO PRT-TOT-DESCR.
061400     WRITE PRT-REC FROM PRT-CLASS-LINE AFTER ADVANCING 2.
061500     MOVE SPACES                  TO PRT-CLASS-LINE.
061600
061700 730-INIT-DEPT-TABLE.
061800     MOVE SPACES                  TO DEPT-NO (I).
061900     MOVE 0                       TO DEPT-WRITEDOWN (I).
062000
062200 731-BUILD-DEPT-TABLE.
062300     IF SORT-15-WDOWN = 0
062400         NEXT SENTENCE
062500     ELSE
062600         IF DEPT-WRITEDOWN (I) = ZERO
062700             MOVE SORT-DEPT       TO DEPT-NO (I)
062800             ADD SORT-15-WDOWN    TO DEPT-WRITEDOWN (I)
062900             MOVE 1               TO FOUND-FLAG
063000             ADD 1                TO HOLD-I
063100         ELSE
063200             IF DEPT-NO (I) = SORT-DEPT
063300                 ADD SORT-15-WDOWN TO DEPT-WRITEDOWN (I)
063400                 MOVE 1            TO FOUND-FLAG.
063500
063700 732-SORT-DEPT.
063800     MOVE I                       TO MIN.
063900     COMPUTE J = I + 1
064000     PERFORM 733-CHECK
064100        VARYING K FROM J BY 1
064200            UNTIL K > HOLD-I.
064300     IF MIN = I
064400         NEXT SENTENCE
064500     ELSE
064600         MOVE DEPT-NO (I)          TO B-DEPT
064700         MOVE DEPT-WRITEDOWN (I)   TO B-VALUE
064800         MOVE DEPT-NO (MIN)        TO DEPT-NO (I)
064900         MOVE DEPT-WRITEDOWN (MIN) TO DEPT-WRITEDOWN (I)
065000         MOVE B-DEPT               TO DEPT-NO (MIN)
065100         MOVE B-VALUE              TO DEPT-WRITEDOWN (MIN).
065200     PERFORM 740-PRINT-DEPT-TABLE.
065300
065400 733-CHECK.
065500     IF DEPT-NO (K) < DEPT-NO (MIN)
065600         MOVE K                    TO MIN.
065700
065800 740-PRINT-DEPT-TABLE.
065900     MOVE DEPT-NO (I)              TO DEPT-PRT,
066000                                      DEPT-ARG.
066100     PERFORM 748-CHECK-WRITEDOWN-DEPT.
066200     MOVE DEPT-WRITEDOWN (I)       TO DEPT-WRITEDOWN-PRT.
066300
066400     WRITE PRT-REC FROM DEPT-LINE AFTER ADVANCING 1.
066500     ADD 1                         TO LINE-CNT.
066600     IF INVALID-DEPT-SW = "Y"
066700         MOVE "0000"               TO DEPT-NO (I)
066800         WRITE PRT-REC FROM INVALID-DEPT-MSG AFTER ADVANCING 1
066900         ADD 1                     TO LINE-CNT.
067000     IF LINE-CNT > 55
067100         PERFORM 755-PRINT-HEADINGS.
067200
067300 746-PUT-WDOWN-TRANS.
067400     MOVE 1                         TO NUMBER-OF-DSETS-LOCKED.
067500     MOVE "MATL-CODE;"              TO ITEM-LIST-1.
067600     MOVE MMATL-CODE-ARG            TO LOCK-VALUE-1.
067700     MOVE "DTRANS;"                 TO DSET-NAME-1.
           PERFORM 9930-LOCK.
           PERFORM 9999-DBPUT-DTRANS-MC-O.
069400     IF GOOD-CALL
069500         NEXT SENTENCE
069600     ELSE
069700         MOVE "DBPUT DTRANS * 746-PWT" TO BU-DISPLAY-MSG
069800         PERFORM 990-BLOWUP.
           PERFORM 9940-UNLOCK.
070800
070900 747-GET-MMATL-ACCUM.
           PERFORM 9999-DBGET7-MMATL-ACCUM-MC-I.
071700     IF GOOD-CALL
071800         NEXT SENTENCE
071900     ELSE
072000         MOVE "DBGET MMATL-ACCUM * 747-GMA" TO BU-DISPLAY-MSG
072100         MOVE MMATL-CODE-ARG      TO BU-DISPLAY-FLD (1)
072200         PERFORM 990-BLOWUP.
072300
072400 747-UPDATE-MMATL-ACCUM.
072500     CALL "SUPDMATL" USING ACCTG-BASE,
072600                           BUF-MATLACUM,
072700                           STATUS-AREA,
072800                           BU-DISPLAY-AREA,
072900                           BU-DISPLAY-FLDS.
073000     IF BU-DISPLAY-MSG NOT = SPACES
073100         PERFORM 990-BLOWUP.
073200
073300 748-CHECK-WRITEDOWN-DEPT.
073400     MOVE SPACES                  TO INVALID-DEPT-LIT,
073500                                     PRT-INVALID-DEPT-INDIC,
073600                                     INVALID-DEPT-SW.
           PERFORM 9999-DBGET7-MCHT-ACCTS-DP-I.
074400     IF GOOD-CALL
074500         NEXT SENTENCE
074600     ELSE
074700         IF NO-ENTRY
074800             MOVE "Y"             TO INVALID-DEPT-SW
074900             MOVE "INVALID DEPT --->" TO INVALID-DEPT-LIT
075000             MOVE "***"           TO PRT-INVALID-DEPT-INDIC
075100         ELSE
075200             MOVE "DBGET MCHT-ACCTS * 748-CWD" TO BU-DISPLAY-MSG
075300             MOVE DEPT-ARG TO BU-DISPLAY-FLD (1)
075400             PERFORM 990-BLOWUP.
075500
075600 748-MOVE-DEPT.
075700     IF INVALID-DEPT-SW = "Y"
075800         MOVE "0000"              TO TRANS-DEPT
075900     ELSE
076000         MOVE SORT-DEPT           TO TRANS-DEPT.
076100
076200 750-PRINT-HEADINGS.
076300     MOVE 1                       TO DATE-MODE.
076400     CALL "TDATECHK" USING DATE-CHECK-AREA.
076500     MOVE DATE-SLASH-OUT          TO DATE-H1.
076600     MOVE DATE-FORMATTED-TIME-OUT TO TIME-H2.
076700     ADD 1                        TO PAGE-CNT.
076800     MOVE PAGE-CNT                TO PAGE-H2.
076900     WRITE PRT-REC FROM HEADER1 AFTER ADVANCING NEW-PAGE.
077000     WRITE PRT-REC FROM HEADER2 AFTER ADVANCING 1.
077100     WRITE PRT-REC FROM HEADER4 AFTER ADVANCING 2.
077200     WRITE PRT-REC FROM HEADER5 AFTER ADVANCING 1 LINES.
077300     WRITE PRT-REC FROM BLANK-LINE AFTER ADVANCING 1 LINES.
077400     MOVE 6                       TO LINE-CNT.
077500
077600 755-PRINT-HEADINGS.
077700     MOVE 1                       TO DATE-MODE.
077800     CALL "TDATECHK" USING DATE-CHECK-AREA.
077900     MOVE DATE-SLASH-OUT          TO DATE-H1.
078000     MOVE DATE-FORMATTED-TIME-OUT TO TIME-H2.
078100     ADD 1                        TO PAGE-CNT.
078200     MOVE PAGE-CNT                TO PAGE-H2.
078300     WRITE PRT-REC FROM HEADER1 AFTER ADVANCING NEW-PAGE.
078400     WRITE PRT-REC FROM HEADER2 AFTER ADVANCING 1.
078500     WRITE PRT-REC FROM HEADER3 AFTER ADVANCING 2.
078600     WRITE PRT-REC FROM HEADER6 AFTER ADVANCING 2 LINES.
078700     WRITE PRT-REC FROM BLANK-LINE AFTER ADVANCING 1 LINES.
078800     MOVE 7                       TO LINE-CNT.
078900
079000 799-CREATE-EXIT.
079100     EXIT.
079200
079300 900-ERROR SECTION.
079400
079500 990-BLOWUP.
079600
079700***************************************************************
079800**   CALL 'CBLOWSRT' INSTEAD OF 'TBLOWUP' WHEN A BLOWUP      **
079900**   SITUATION OCCURS SINCE THIS PROGRAM USES THE 'SORT'     **
080000**   VERB.  'CBLOWSRT' WRITES ALL THE BLOWUP INFORMATION     **
080100**   TO A TEMPORARY FILE 'BLUPDATA' (WHICH WAS OPENED AT     **
080200**   THE BEGINNING OF THE PROGRAM) THE CLOSES IT. THEN IT    **
080300**   CREATESA A SON PROCESS 'XBLOWSRT' THAT READS THE        **
080400**   BLOWUP INFORMATION OUT OF 'BLUPDATA' AND CALLS          **
080500**   'TBLOWUP' USING THIS INFO.  SINCE THE NEW PROCESS       **
080600**   'XBLOWSRT' HAS ITS OWN STACK THE STACK OVERFLOW         **
080700**   PROBLEM IS AVOIDED.                                     **
080800***************************************************************
080900
081000     MOVE "TMNTHWDN"              TO  BU-PGM-NAME.
081100     CALL "CBLOWSRT" USING CBLOWSRT-PARMS,
081200                           ACCTG-BASE,
081300                           BU-PGM-NAME,
081400                           STATUS-AREA,
081500                           DUMMY-VIEW-AREA,
081600                           FILE-STATUS,
081700                           BU-DISPLAY-MSG,
081800                           BU-DISPLAY-FLDS.
081900
082100 1000-CLOSE-FILES.
082200     CLOSE ONLINE-PRT.
           PERFORM 9999-CLOSE-STUFF.

       9999-ROUTINES SECTION.

       9930-LOCK.

       9940-UNLOCK.

       9999-DBGET7-MACCOUNT-INFO-IK-I.
           MOVE 0 TO COND-WORD.
           MOVE MACCT-KEY TO INFOKEY OF MACCOUNT-INFO-IK-REC-I.
           READ MACCOUNT-INFO-IK-I INTO BUF-MACCT-INFO
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS = "23"
               MOVE 17 TO COND-WORD
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD.

       9999-DBGET2-MMATL-ACCUM-MC-I.
           MOVE 0 TO COND-WORD.
           READ MMATL-ACCUM-MC-I NEXT INTO BUF-MATLACUM
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS-1 = "1" OR FILE-STATUS = "46"
               MOVE 11 TO COND-WORD
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD.

       9999-INIT-MMATL-ACCUM-MC-I.
           MOVE SPACES TO MATLCODE OF MMATL-ACCUM-MC-REC-I.
           START MMATL-ACCUM-MC-I KEY >= MATLCODE OF
             MMATL-ACCUM-MC-REC-I
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.

       9999-DBGET7-MSTORERM-CD-I.
           MOVE 0 TO COND-WORD.
           MOVE CODE-ARG TO CORPCDE OF MSTORERM-CD-REC-I.
           READ MSTORERM-CD-I INTO BUF-MSTORERM
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS = "23"
               MOVE 17 TO COND-WORD
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD.

       9999-DBGET7-MCLASS-CL-I.
           MOVE 0 TO COND-WORD.
           MOVE CLASS-ARG TO ACTGCLASS OF MCLASS-CL-REC-I.
           READ MCLASS-CL-I INTO BUF-MCLASS
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS = "23"
               MOVE 17 TO COND-WORD
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD.

       9999-DBPUT-DTRANS-MC-O.
           MOVE 0 TO COND-WORD.
           WRITE DTRANS-MC-REC-O FROM BUF-DTRANS
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD.

       9999-DBGET7-MMATL-ACCUM-MC-I.
           MOVE 0 TO COND-WORD.
           MOVE MMATL-CODE-ARG TO MATLCODE OF MMATL-ACCUM-MC-REC-I.
           READ MMATL-ACCUM-MC-I INTO BUF-MATLACUM
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS = "23"
               MOVE 17 TO COND-WORD
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD.

       9999-DBGET7-MCHT-ACCTS-DP-I.
           MOVE 0 TO COND-WORD.
           MOVE DEPT-ARG TO DEPT OF MCHT-ACCTS-DP-REC-I.
           READ MCHT-ACCTS-DP-I INTO BUF-MCHTACCTS
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS = "23"
               MOVE 17 TO COND-WORD
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD.

       9999-OPEN-STUFF.
           OPEN INPUT MACCOUNT-INFO-IK-I   .
           OPEN INPUT MMATL-ACCUM-MC-I     .
           OPEN INPUT MSTORERM-CD-I        .
           OPEN INPUT MCLASS-CL-I          .
           OPEN I-O   DTRANS-MC-O          .
           OPEN INPUT MCHT-ACCTS-DP-I      .

       9999-CLOSE-STUFF.
           CLOSE      MACCOUNT-INFO-IK-I   .
           CLOSE      MMATL-ACCUM-MC-I     .
           CLOSE      MSTORERM-CD-I        .
           CLOSE      MCLASS-CL-I          .
           CLOSE      DTRANS-MC-O          .
           CLOSE      MCHT-ACCTS-DP-I      .
