                                         PIC X(16).
           05  FILLER                    PIC X     VALUE SPACES.
           05  D1-TOTAL-COST             PIC ZZZZZZZZZZZ9.9999-.
           05  FILLER                    PIC X(2)  VALUE SPACES.
           05  D1-EXP-CAT                PIC X(1).
           05  FILLER                    PIC X     VALUE SPACES.
           05  D1-WO                     PIC X(10).
           05  FILLER                    PIC X(1)  VALUE SPACES.
           05  D1-BUDGET-NO              PIC X(12).
           05  D1-BUDGET-NO-9 REDEFINES D1-BUDGET-NO PIC ZZZZZZZZZZZ9.
           05  FILLER                    PIC X(2)  VALUE SPACES.
           05  D1-ORIG                   PIC X(4).
           05  FILLER                    PIC X(1)  VALUE SPACES.
           05  D1-REL-DATE               PIC X(8).

       01  DESC-LINE.
           05  FILLER                    PIC X(11) VALUE SPACES.
           05  PRT-DESC                  PIC X(80).

       01  BREAK-TOTAL.
           05  FILLER                    PIC X(5)  VALUE SPACES.
           05  T1-ITEM                   PIC X(14).
           05  T1-ITEM-9 REDEFINES T1-ITEM  PIC ZZZZZZZZZZZZZ9.
           05  FILLER                    PIC X(5)  VALUE " HAD ".
           05  T1-REQ-COUNT              PIC ZZZZZZZ9.
           05  FILLER        PIC X(13) VALUE " REQUISITIONS".
           05  FILLER                    PIC X(12) VALUE SPACES.
           05  FILLER        PIC X(12) VALUE "TOTAL COST: ".
           05  T1-TOTAL-COST             PIC Z(13)9.9(4).

       01  RPT-TOTAL.
           05  FILLER                    PIC X(20) VALUE SPACES.
           05  FILLER                    PIC X(11) VALUE "TOTAL REQS ".
           05  FILLER        PIC X(15) VALUE "FOR REPORT IS: ".
           05  T2-REQ-COUNT              PIC ZZZZZZZ9.
           05  FILLER                    PIC X(14) VALUE SPACES.
           05  FILLER        PIC X(12) VALUE "TOTAL COST: ".
           05  T2-TOTAL-COST             PIC Z(13)9.9(4).

       01  PRT-AVERAGE-LINE.
           05  FILLER                    PIC X(20) VALUE SPACES.
           05  FILLER        PIC X(17) VALUE "AVERAGE APPROVAL ".
           05  FILLER                    PIC X(9)  VALUE "TIME FOR ".
           05  PRT-MAN-ON                PIC X(15).
           05  FILLER                    PIC X(9)  VALUE " REQS IS ".
           05  PRT-AVERAGE               PIC ZZZ9.9.
           05  FILLER                    PIC X(5)  VALUE " DAYS".

       COPY THDPRTB IN COPYLIB.
       01  OPTION-REC-1.
           05  OPT-SORT                  PIC X(2).
           05  OPT-SELECT                PIC X(2).
           05  OPT-SEL-LOW               PIC X(14).
           05  OPT-SEL-HIGH              PIC X(14).
           05  OPT-STORE                 PIC X(1).
           05  OPT-CODED-NONSTORE        PIC X(1).
           05  OPT-NON-STORE             PIC X(1).
           05  OPT-UNAPPROVED            PIC X(1).
           05  OPT-IN-PURCH              PIC X(1).
           05  OPT-ON-PO                 PIC X(1).
           05  OPT-LOW-DATE              PIC X(8).
           05  OPT-HIGH-DATE             PIC X(8).
           05  OPT-DATE-TYPE             PIC X(1).
           05  OPT-COST                  PIC X(1).
           05  OPT-DESC                  PIC X(1).
           05  OPT-EXCLUDE-ON-HOLD       PIC X(1).
           05  OPT-EXCLUDE-0-APPROVAL    PIC X(1).
           05  OPT-INCLUDE-1ST-APPROVAL  PIC X(1).
           05  OPT-ORIGINATORS           PIC X(20).
       01  OPTION-REC-2.
           05  OPT-DEPTS-LINE-1          PIC X(40).
           05  OPT-DEPTS-LINE-2          PIC X(40).

       PROCEDURE DIVISION.
       START-UP SECTION.
       HOUSEKEEPING.
9406CK     MOVE "C" TO SCOPE.
9406CK     CALL "MCXCBLERR" USING SCOPE.

           MOVE "N"                      TO  EOF-SW.
           MOVE ZERO TO PAGE-COUNT, LINE-COUNT, SAVE-TOTAL-COST.
           PERFORM 9999-OPEN-STUFF.
           CALL "TESCSEQ" USING ESC-NAME.
           MOVE CHAR-1636PI              TO  COMP-ESC-SEQ.
           MOVE CHAR-10PI                TO  STAND-ESC-SEQ.

           ACCEPT HD-ROUTE-DATA.
           ACCEPT OPTION-REC-1.
           ACCEPT OPTION-REC-2.

           MOVE OPT-SORT                 TO  RS-SHIFT-FLD.
           CALL "TRSHIFT" USING RS-RET-CODE, RS-SHIFT-FLD.
           MOVE RS-SHIFT-FLD-7-8         TO  OPT-SORT.
           MOVE OPT-SELECT               TO  RS-SHIFT-FLD.
           CALL "TRSHIFT" USING RS-RET-CODE, RS-SHIFT-FLD.
           MOVE RS-SHIFT-FLD-7-8         TO  OPT-SELECT.

           IF OPT-SELECT = "10" AND OPT-SEL-LOW NOT = "ALL"
               MOVE OPT-SEL-LOW          TO  RS-SHIFT-FLD
               CALL "TRSHIFT" USING RS-RET-CODE, RS-SHIFT-FLD
               MOVE RS-SHIFT-FLD-3-8     TO  OPT-SEL-LOW
               MOVE OPT-SEL-HIGH         TO  RS-SHIFT-FLD
               CALL "TRSHIFT" USING RS-RET-CODE, RS-SHIFT-FLD
               MOVE RS-SHIFT-FLD-3-8     TO  OPT-SEL-HIGH.

      *    IF OPT-SELECT = "06"
      *        MOVE OPT-SEL-LOW          TO  BUDNUM-IN
      *        CALL "CBUDNUM" USING BUDNUM-IN, BUDNUM-NODASH-NOREV,
      *          BUDNUM-NODASH-REV, BUDNUM-DASH-NOREV, BUDNUM-DASH-REV
      *        MOVE BUDNUM-NODASH-NOREV  TO  OPT-SEL-LOW
      *        MOVE OPT-SEL-HIGH         TO  BUDNUM-IN
      *        CALL "CBUDNUM" USING BUDNUM-IN, BUDNUM-NODASH-NOREV,
      *          BUDNUM-NODASH-REV, BUDNUM-DASH-NOREV, BUDNUM-DASH-REV
      *        MOVE BUDNUM-NODASH-NOREV  TO  OPT-SEL-HIGH.

           IF OPT-SELECT = "05"
               MOVE OPT-SEL-LOW          TO  ALIGN-WO
               CALL "TALWONO" USING ALIGN-WO, RET-CODE
               MOVE ALIGN-WO             TO  OPT-SEL-LOW
               MOVE OPT-SEL-HIGH         TO  ALIGN-WO
               CALL "TALWONO" USING ALIGN-WO, RET-CODE
               MOVE ALIGN-WO             TO  OPT-SEL-HIGH.

      *------ SETUP FOR  CALLS TO CDESC AND TNRQDESC
           MOVE 1                        TO  CDESC-LINES-TO-GET,
                                              RQD-NUM-LINES.
           MOVE "K"                      TO  CDESC-DESC-OPTION.
           MOVE "N"                      TO  CDESC-LOCAL-DESC-OPTION.

      *-------- ACCEPT ROUTING INFO FROM THE JOB, CREATED BY
      *-------- THE OPTION PROGRAM.
           DISPLAY "ROUTING INFORMATION ENTERED WAS:".
           DISPLAY HD-ROUTE-DATA.

      *------ ACCEPT JOB CARD CREATED BY THE OPTION PROGRAM,
      *------ WHICH CONTAINS THE USER OPTIONS SELECTED.
           DISPLAY "OPTION REC 1 ENTERED IS:".
           DISPLAY OPTION-REC-1.

           DISPLAY "OPTION REC 2 ENTERED IS:".
           DISPLAY OPTION-REC-2.

      *------ MOVE THE 20 DEPARTMENTS TO A TABLE
           MOVE OPT-DEPTS-LINE-1         TO  OPT-DEPT-AREA-L1.
           MOVE OPT-DEPTS-LINE-2         TO  OPT-DEPT-AREA-L2.

      *------ MOVE THE 5 ORIGINATORS TO A TABLE
           MOVE OPT-ORIGINATORS          TO  OPT-ORIG-AREA.

           IF (OPT-LOW-DATE NOT = "ALL")
           AND (OPT-LOW-DATE NOT = SPACES)
               MOVE 3                    TO  DATE-MODE
               MOVE OPT-LOW-DATE         TO  DATE-VALIDATE-IN
               CALL "TDATECHK" USING DATE-CHECK-AREA
               MOVE DATE-YMD-OUT         TO  SAVE-LOW-DATE
               IF SAVE-LOW-DATE-YY > "70"
                   MOVE "19"             TO  SAVE-LOW-DATE-CC
               ELSE
                   MOVE "20"             TO  SAVE-LOW-DATE-CC
               END-IF
               MOVE OPT-HIGH-DATE        TO  DATE-VALIDATE-IN
               CALL "TDATECHK" USING DATE-CHECK-AREA
               MOVE DATE-YMD-OUT         TO  SAVE-HIGH-DATE
               IF SAVE-HIGH-DATE-YY > "70"
                   MOVE "19"             TO  SAVE-HIGH-DATE-CC
               ELSE
                   MOVE "20"             TO  SAVE-HIGH-DATE-CC
               END-IF.

            MOVE 0                       TO  SUB.
            PERFORM 3000-DISPLAY-DEPARTMENTS 20 TIMES.

      *------ MOVE SELECTED OPTIONS TO A HEADER PRINT LINE SO USER CAN
      *------ SEE WHAT HE SELECTED.
           MOVE OPT-SORT                 TO  PRT-OPT-SORT.
           MOVE OPT-STORE                TO  PRT-OPT-STORE.
           MOVE OPT-CODED-NONSTORE       TO  PRT-OPT-CODED-NONSTORE.
           MOVE OPT-NON-STORE            TO  PRT-OPT-NON-STORE.
           MOVE OPT-UNAPPROVED           TO  PRT-OPT-UNAPPROVED.
           MOVE OPT-IN-PURCH             TO  PRT-OPT-IN-PURCH.
           MOVE OPT-ON-PO                TO  PRT-OPT-ON-PO.
           MOVE OPT-LOW-DATE             TO  PRT-OPT-LOW-DATE.
           MOVE OPT-HIGH-DATE            TO  PRT-OPT-HIGH-DATE.
           MOVE OPT-DATE-TYPE            TO  PRT-OPT-DATE-TYPE.
           MOVE OPT-EXCLUDE-ON-HOLD      TO  PRT-OPT-EXCLUDE-ON-HOLD.
           MOVE OPT-EXCLUDE-0-APPROVAL   TO
                                         PRT-OPT-EXCLUDE-0-APPROVAL.
           MOVE OPT-INCLUDE-1ST-APPROVAL TO
                                         PRT-OPT-INCLUDE-1ST-APPROVAL.
           MOVE 0                        TO  SUB.
           MOVE SPACES                   TO  PRT-DEPTS-AREA.
           PERFORM 3010-MOVE-PRT-DEPTS 20 TIMES.

           MOVE 0                        TO  SUB.
           MOVE SPACES                   TO  PRT-ORIG-AREA.
           PERFORM 3040-MOVE-PRT-ORIG   5 TIMES.

      *------ IF A SELECTED DEPT IS SPACES, DONT MATCH UP WITH A REQ
      *------ THAT HAD NO DEPT FILLED IN.
           MOVE 0                        TO  SUB.
           PERFORM 3020-FIX-SPACE-DEPT 20 TIMES.

      *------ IF A SELECTED ORIG IS SPACES, DONT MATCH UP WITH A REQ
      *------ THAT HAD NO ORIG FILLED IN.
           MOVE 0                        TO  SUB.
           PERFORM 3030-FIX-SPACE-ORIG 5 TIMES.

           IF HD-SPOOLER-NUMBER NOT NUMERIC
               MOVE "000"                TO  HD-SPOOLER-NUMBER.
           IF HD-NO-OF-COPIES NOT NUMERIC
               MOVE 1                    TO  HD-NO-OF-COPIES.
           MOVE HD-SPOOLER-NUMBER        TO  OVRPRTF-TOFILE-NUM.
           MOVE "*YES"                   TO  OVRPRTF-SHARED.
           MOVE HD-NO-OF-COPIES          TO  OVRPRTF-COPIES.
           MOVE "MCPRT"                  TO  OVRPRTF-FILE.
           PERFORM 996-OVERRIDE-PRINT-FILE.
           OPEN OUTPUT ONLINE-PRT.

           CALL "THDPRT2" USING HD-RET-CODE, HD-FILE-NAME, FNUM
             HD-ROUTE-DATA, ESC-NAME.
           IF HD-RET-CODE NOT = 0
               MOVE "THDPRT2 ERROR IN HSK" TO BU-DISPLAY-MSG
               MOVE "HD-RET-CODE = "     TO  BU-DISPLAY-FLD (1)
               MOVE HD-RET-CODE          TO  BU-DISPLAY-FLD9 (1)
               GO TO 2100-BLOWUP.

           DISPLAY "HD-PAPER-FLAG = " HD-PAPER-FLAG.
           IF NOT PAPER-IS-132-COLS
              MOVE COMP-ESC-SEQ          TO  PRINT-RCD
              WRITE PRINT-RCD BEFORE ADVANCING 0 LINES.

           MOVE 1                        TO  DATE-MODE.
           CALL "TDATECHK" USING DATE-CHECK-AREA.
           MOVE DATE-SLASH-OUT           TO  PRT-DAT.

           IF OPT-SORT = "09"
               MOVE " APP DAYS"          TO  PRT-HDB
           ELSE
           IF OPT-SORT = "11"
               MOVE "EQUIP-NUM"          TO  PRT-HDB
           ELSE
               MOVE "BUDGET-NO"          TO  PRT-HDB.

       1100-CONTROL.

           IF OPT-SORT = "01"
               SORT SORT-FILE ON ASCENDING KEY     SORT-DEPT,
                                                   SORT-EXP-CLASS,
                                                   SORT-REQ-NUMBER
                  INPUT  PROCEDURE IS  6000-INPUT-STUFF
                  OUTPUT PROCEDURE IS  7000-OUTPUT-STUFF
           ELSE
           IF OPT-SORT = "02"
               SORT SORT-FILE ON ASCENDING KEY     SORT-REQ-NUMBER
                   INPUT  PROCEDURE IS  6000-INPUT-STUFF
                   OUTPUT PROCEDURE IS  7000-OUTPUT-STUFF
           ELSE
           IF OPT-SORT = "03"
               SORT SORT-FILE ON ASCENDING KEY     SORT-DEPT,
                                                   SORT-EXP-CAT
                   INPUT  PROCEDURE IS  6000-INPUT-STUFF
                   OUTPUT PROCEDURE IS  7000-OUTPUT-STUFF
           ELSE
           IF OPT-SORT = "04"
               SORT SORT-FILE ON ASCENDING KEY     SORT-EXP-CAT,
                                                   SORT-REQ-NUMBER
                   INPUT  PROCEDURE IS  6000-INPUT-STUFF
                   OUTPUT PROCEDURE IS  7000-OUTPUT-STUFF
           ELSE
           IF OPT-SORT = "05"
               SORT SORT-FILE ON ASCENDING KEY     SORT-WO,
                                                   SORT-REQ-NUMBER
                   INPUT  PROCEDURE IS  6000-INPUT-STUFF
                   OUTPUT PROCEDURE IS  7000-OUTPUT-STUFF
           ELSE
           IF OPT-SORT = "06"
               SORT SORT-FILE ON ASCENDING KEY     SORT-BUDGET-NO,
                                                   SORT-REQ-NUMBER
                   INPUT  PROCEDURE IS  6000-INPUT-STUFF
                   OUTPUT PROCEDURE IS  7000-OUTPUT-STUFF
           ELSE
           IF OPT-SORT = "07"
               SORT SORT-FILE ON ASCENDING KEY     SORT-ORIG,
                                                   SORT-REQ-NUMBER
                   INPUT  PROCEDURE IS  6000-INPUT-STUFF
                   OUTPUT PROCEDURE IS  7000-OUTPUT-STUFF
           ELSE
           IF OPT-SORT = "08"
               SORT SORT-FILE ON ASCENDING KEY     SORT-DEPT,
                                                   SORT-ORIG,
                                                   SORT-REQ-NUMBER
                   INPUT  PROCEDURE IS  6000-INPUT-STUFF
                   OUTPUT PROCEDURE IS  7000-OUTPUT-STUFF
           ELSE
           IF OPT-SORT = "09"
               SORT SORT-FILE ON ASCENDING KEY     SORT-EXP-CAT,
                                                   SORT-BUDGET-NO
                                                   SORT-REQ-NUMBER
                   INPUT PROCEDURE IS 6000-INPUT-STUFF
                   OUTPUT PROCEDURE IS 7000-OUTPUT-STUFF
           ELSE
           IF OPT-SORT = "10"
               SORT SORT-FILE ON ASCENDING KEY     SORT-EXP-CLASS,
                                                   SORT-REQ-NUMBER
                   INPUT PROCEDURE IS 6000-INPUT-STUFF
                   OUTPUT PROCEDURE IS 7000-OUTPUT-STUFF
           ELSE
           IF OPT-SORT = "11"
               SORT SORT-FILE ON ASCENDING KEY     SORT-EQUIP-NUM,
                                                   SORT-REQ-NUMBER
                   INPUT PROCEDURE IS 6000-INPUT-STUFF
                   OUTPUT PROCEDURE IS 7000-OUTPUT-STUFF.

       2000-SHUTDOWN-DB.
           CLOSE ONLINE-PRT.
           PERFORM 9999-CLOSE-STUFF.
           GOBACK.

       2100-BLOWUP.
           MOVE "TRPTREQ2"               TO  BU-PGM-NAME.
           CALL "TBLOWUP" USING BASE, BU-PGM-NAME, STATUS-AREA,
               DUMMY-VIEW-AREA, FILE-STATUS, BU-DISPLAY-MSG,
               BU-DISPLAY-AREA.

       3000-DISPLAY-DEPARTMENTS.
           ADD 1                         TO  SUB.
           IF OPT-DEPT (SUB) > SPACES
               DISPLAY OPT-DEPT (SUB).

       3010-MOVE-PRT-DEPTS.
           ADD 1                         TO  SUB.
           MOVE OPT-DEPT (SUB)           TO  PRT-OPT-DEPT (SUB).

       3020-FIX-SPACE-DEPT.
           ADD 1                         TO  SUB.
           IF OPT-DEPT (SUB) = SPACES
               MOVE "////"               TO  OPT-DEPT (SUB).

       3030-FIX-SPACE-ORIG.
           ADD 1                         TO  SUB.
           IF OPT-ORIG (SUB) = SPACES
               MOVE "////"               TO  OPT-ORIG (SUB).

       3040-MOVE-PRT-ORIG.
           ADD 1                         TO  SUB.
           MOVE OPT-ORIG (SUB)           TO  PRT-OPT-ORIG (SUB).

      *******************************************
      *                                         *
      *    I N P U T    P R O C E D U R E       *
      *                                         *
      *******************************************

       6000-INPUT-STUFF SECTION.
       6005-START-INPUTTING-STUFF.

           PERFORM 9999-BEGFIL-MREQ-RQ-I.

       6010-SERIAL-LOOP.
           PERFORM 9999-GETSER-MREQ-RQ-I.
           IF NOT GOOD-CALL
               GO TO 6990-IS-X.

           MOVE MREQ-NUMBER              TO  REQ-ARG.

      *------ MAKE SURE THE REQ RELEASE DATE IS UPDATED CORRECTLY.
           IF REQ-RELEASE-STAT = "X " OR "XX"
               IF REQ-REL-MC-DATE-CN < "0"
                 IF MREQ-NUMBER-1 NOT = "N"
                   PERFORM 6850-UPDATE-REL-DATE THRU 6870-URD-X.

           PERFORM 9999-CHAINHD-DREQITM-RQ-I.
           PERFORM 9999-GETNEXT-DREQITM-RQ-I.
      *------ 23APR1997 ADDED "MOVE +0 TO ..." LOGIC TO THE FOLLOWING
      *------  IF STMT.   ---DAVE PLUM
           IF COND-WORD = 15
               MOVE SPACES TO BUF-DREQITM
               MOVE +0     TO REQITM-QTY-TO-ORD
                              REQITM-UNIT-PRICE
                              REQITM-BUDGET-AMT
                              REQITM-UNIT-PRICE-CURR.

           PERFORM 9999-CHAINHD-DREQD-RQ-I.
           PERFORM 9999-GETNEXT-DREQD-RQ-I.
           IF COND-WORD = 15 MOVE SPACES TO BUF-DREQD.

           MOVE SPACES                   TO  SORT-EQUIP-NUM.
           IF DREQD-WO-NUMBER > SPACES
               MOVE DREQD-WO-NUMBER      TO  WO-NUM-ARG
               PERFORM 9999-CHAINHD-WO-BASIC-WO-I
               PERFORM 9999-GETNEXT-WO-BASIC-WO-I
               IF GOOD-CALL
                   MOVE EQUIP-NUM        TO  SORT-EQUIP-NUM
               ELSE
                   PERFORM 9999-CHAINHD-WO-PLANNED-WO-I
                   PERFORM 9999-GETNEXT-WO-PLANNED-WO-I
                   IF GOOD-CALL
                       MOVE EQUIP-NUM-P  TO  SORT-EQUIP-NUM.

       6020-SELECTIONS.
           IF REQ-STATUS = "SS" OR "S"
               IF OPT-STORE NOT = "X"
                   GO TO 6010-SERIAL-LOOP.
           IF REQ-STATUS = "SN"
               IF OPT-CODED-NONSTORE NOT = "X"
                   GO TO 6010-SERIAL-LOOP.
           IF REQ-STATUS = "NM" OR "NI"
               IF OPT-NON-STORE NOT = "X"
                   GO TO 6010-SERIAL-LOOP.
           IF REQ-RELEASE-STAT = "  " OR "U"
               IF OPT-UNAPPROVED NOT = "X"
                   GO TO 6010-SERIAL-LOOP.
           IF REQ-RELEASE-STAT = "X "
               IF OPT-IN-PURCH NOT = "X"
                   GO TO 6010-SERIAL-LOOP.
           IF REQ-RELEASE-STAT = "XX"
               IF OPT-ON-PO NOT = "X"
                   GO TO 6010-SERIAL-LOOP.

      *------ FOR SORT OPTION 9 (APPROVAL SPEED), ONLY ALLOW REQS THAT
      *------ HAVE BEEN APPROVED.
           IF OPT-SORT = "09"
               IF REQ-RELEASE-STAT = "  "
                   GO TO 6010-SERIAL-LOOP
               ELSE
               IF REQ-REL-MC-DATE-CN NOT NUMERIC
                   GO TO 6010-SERIAL-LOOP.

           IF OPT-DATE-TYPE = "R"
               MOVE REQ-REL-MC-DATE-CN   TO  TEST-DATE-CN
           ELSE
               MOVE REQ-DATE-CN          TO  TEST-DATE-CN.

           IF OPT-INCLUDE-1ST-APPROVAL = "Y"
               NEXT SENTENCE
           ELSE
           IF OPT-LOW-DATE = "ALL" OR SPACES
               NEXT SENTENCE
           ELSE
           IF TEST-DATE-CN < SAVE-LOW-DATE-CN
               GO TO 6010-SERIAL-LOOP
           ELSE
           IF TEST-DATE-CN > SAVE-HIGH-DATE-CN
               GO TO 6010-SERIAL-LOOP.

           IF OPT-SELECT = "00"
               NEXT SENTENCE
           ELSE
           IF OPT-SEL-LOW = "ALL" OR SPACES
               NEXT SENTENCE
           ELSE
           IF OPT-SELECT = "01" OR "03" OR "08"
               IF REQ-SUBD < OPT-SEL-LOW
                   GO TO 6010-SERIAL-LOOP
               ELSE
               IF REQ-SUBD > OPT-SEL-HIGH
                   GO TO 6010-SERIAL-LOOP
               ELSE
                   NEXT SENTENCE
           ELSE
           IF OPT-SELECT = "02"
               IF MREQ-NUMBER < OPT-SEL-LOW
                   GO TO 6010-SERIAL-LOOP
               ELSE
               IF MREQ-NUMBER > OPT-SEL-HIGH
                   GO TO 6010-SERIAL-LOOP
               ELSE
                   NEXT SENTENCE
           ELSE
           IF OPT-SELECT = "05"
               IF DREQD-WO-NUMBER < OPT-SEL-LOW
                   GO TO 6010-SERIAL-LOOP
               ELSE
               IF DREQD-WO-NUMBER > OPT-SEL-HIGH
                   GO TO 6010-SERIAL-LOOP
               ELSE
                   NEXT SENTENCE
           ELSE
           IF OPT-SELECT = "06"
               IF REQ-BUDGET-NO < OPT-SEL-LOW
                   GO TO 6010-SERIAL-LOOP
               ELSE
               IF REQ-BUDGET-NO > OPT-SEL-HIGH
                   GO TO 6010-SERIAL-LOOP
               ELSE
                   NEXT SENTENCE
           ELSE
           IF OPT-SELECT = "07"
               IF REQ-ORIGINATOR < OPT-SEL-LOW
                   GO TO 6010-SERIAL-LOOP
               ELSE
               IF REQ-ORIGINATOR > OPT-SEL-HIGH
                   GO TO 6010-SERIAL-LOOP
               ELSE
                   NEXT SENTENCE
           ELSE
           IF OPT-SELECT = "10"
               IF REQ-ADDTL-DATA < OPT-SEL-LOW
                   GO TO 6010-SERIAL-LOOP
               ELSE
               IF REQ-ADDTL-DATA > OPT-SEL-HIGH
                   GO TO 6010-SERIAL-LOOP
               ELSE
                   NEXT SENTENCE
           ELSE
           IF OPT-SELECT = "11"
               IF SORT-EQUIP-NUM < OPT-SEL-LOW
                   GO TO 6010-SERIAL-LOOP
               ELSE
               IF SORT-EQUIP-NUM > OPT-SEL-HIGH
                   GO TO 6010-SERIAL-LOOP.

      *-------- IF SELECTING ONLY ARIBA BUYER REQS, CHECK STATUS.
           IF OPT-EXCLUDE-ON-HOLD = "A"
               IF REQ-HOLD-STATUS-CODE NOT = "AR"
                   GO TO 6010-SERIAL-LOOP.

           IF OPT-EXCLUDE-ON-HOLD = "Y"
               IF REQ-HOLD-STATUS-CODE > SPACES
                   GO TO 6010-SERIAL-LOOP.

           IF OPT-EXCLUDE-ON-HOLD = "R"
               IF REQ-HOLD-STATUS-CODE > SPACES
                   NEXT SENTENCE
               ELSE
                   GO TO 6010-SERIAL-LOOP.

           IF OPT-EXCLUDE-0-APPROVAL = "Y"
               PERFORM 6820-CHECK-1-APP THRU 6840-C1A-X
               IF AT-LEAST-1-APP = "N"
                   GO TO 6010-SERIAL-LOOP.

           IF OPT-INCLUDE-1ST-APPROVAL = "Y"
               IF REQ-STATUS = "SS"
                   IF REQ-APPROVALS-LEFT = "  "
                       GO TO 6010-SERIAL-LOOP
                   ELSE
                   PERFORM 6880-CHECK-4-1ST-APPROVAL THRU
                       6880-C41A-X
                   IF FIRST-APPROVER = "N"
                       GO TO 6010-SERIAL-LOOP
                   ELSE
                   NEXT SENTENCE
               ELSE
               PERFORM 6880-CHECK-4-1ST-APPROVAL THRU 6880-C41A-X
               IF FIRST-APPROVER = "N"
                   GO TO 6010-SERIAL-LOOP.

           IF OPT-DEPT (1) = "ALL" OR OPT-DEPTS-LINE-1 = SPACES
               NEXT SENTENCE
           ELSE
               PERFORM 6800-FIND-DEPT THRU 6810-FD-X
               IF FOUND-DEPT-FLAG = "N"
                   GO TO 6010-SERIAL-LOOP.

           IF OPT-ORIG (1) = "ALL" OR OPT-ORIGINATORS = SPACES
               NEXT SENTENCE
           ELSE
               PERFORM 6815-FIND-ORIG THRU 6815-FO-X
               IF FOUND-ORIG-FLAG = "N"
                   GO TO 6010-SERIAL-LOOP.

           MOVE REQ-DATE-CN              TO  SORT-DATE-CN.
           MOVE MREQ-NUMBER              TO  SORT-REQ-NUMBER.
           MOVE REQ-STATUS               TO  SORT-REQ-STATUS.
           MOVE REQ-SUBD                 TO  SORT-DEPT.
           MOVE REQ-ADDTL-DATA           TO  SORT-EXP-CLASS.
           MOVE REQITM-CORP-CODE         TO  SORT-CORP-CODE.
           MOVE REQITM-QTY-TO-ORD        TO  SORT-QUANTITY.
           MOVE REQITM-UM                TO  SORT-UM.
           MOVE REQITM-UNIT-PRICE        TO  SORT-UNIT-COST.

           IF DREQD-PO-RCV-NO > SPACES AND
           (OPT-COST = "P" OR "I")
               MOVE DREQD-PO-RCV-NO      TO  PO-ARG
               PERFORM 9999-CHAINHD-DPOITEM-PO-I
               PERFORM 9999-GETNEXT-DPOITEM-PO-I
               PERFORM UNTIL (NOT GOOD-CALL)
               OR DREQD-PO-ITM-NO = ITM-NUMBER
                   PERFORM 9999-GETNEXT-DPOITEM-PO-I
               END-PERFORM
               IF GOOD-CALL
                   IF (ITM-UM NOT = ITM-PRICE-UM)
                   AND (ITM-CORP-CODE = "NON-STR")
                       MOVE ITM-CORP-CODE TO CODE-ARG
                       PERFORM 9999-GETKEY-MSTORERM-CD-I
                       MOVE ITM-QTY-ORD  TO  UMCF-SOURCE-QTY
                       MOVE ITM-UM       TO  UMCF-SOURCE-UM
                       CALL "TUMCF" USING UMCF-RET-CODE, STR-UM-AREA,
                         UMCF-QUANTITY-AREA
                       MOVE UMCF-QTY-STR-UM   TO  SORT-QUANTITY
                       MOVE ITM-UNIT-PRICE TO UMCF-SOURCE-QTY
                       MOVE ITM-PRICE-UM TO  UMCF-SOURCE-UM
                       MOVE "PR"         TO  UMCF-RET-CODE
                       CALL "TUMCF" USING UMCF-RET-CODE, STR-UM-AREA,
                         UMCF-QUANTITY-AREA
                       MOVE UMCF-QTY-STR-UM   TO  SORT-UNIT-COST
                       MOVE STR-UM       TO  SORT-UM
                   ELSE
                       MOVE ITM-QTY-ORD  TO  SORT-QUANTITY
                       MOVE ITM-UNIT-PRICE TO SORT-UNIT-COST
                       MOVE ITM-UM       TO  SORT-UM.

           IF DREQD-PO-RCV-NO > SPACES AND OPT-COST = "I"
               MOVE ZERO TO TOT-INV-QTY, TOT-INV-COST
               PERFORM 9999-CHAINHD-DINVRCD-PO-I
               PERFORM 9999-GETNEXT-DINVRCD-PO-I
               PERFORM UNTIL NOT GOOD-CALL
                  MOVE INV-REG-NO       TO  REGISTER-ARG
                  PERFORM 9999-CHAINHD-DINVITM-RG-I
                  PERFORM 9999-GETNEXT-DINVITM-RG-I
                  PERFORM UNTIL (NOT GOOD-CALL)
      *-------------------- THIS CONDITION WAS BACKWARDS.
      ****        OR DREQD-PO-ITM-NO >= INVITM-ITEM-NO
                  OR INVITM-ITEM-NO >= DREQD-PO-ITM-NO
                      PERFORM 9999-GETNEXT-DINVITM-RG-I
                  END-PERFORM
                  IF GOOD-CALL AND DREQD-PO-ITM-NO = INVITM-ITEM-NO
                       ADD  INVITM-INV-QTY-PD TO TOT-INV-QTY
      *-------------------- DON'T ADD UNIT COSTS TO OBTAIN UNIT COST
      *-------------------- FIELD.  INSTEAD, AVERAGE THE UNIT COST.
      ****             ADD  INVITM-INV-UPRICE TO TOT-INV-COST
                       MOVE 0                 TO HOLD-INV-COST
                       COMPUTE HOLD-INV-COST = INVITM-INV-QTY-PD
                                             * INVITM-INV-UPRICE
                       ADD HOLD-INV-COST      TO TOT-INV-COST
                       MOVE INVITM-PO-UM      TO SORT-UM
                  END-IF
                  PERFORM 9999-GETNEXT-DINVRCD-PO-I
               END-PERFORM
               IF TOT-INV-COST > ZERO
                   MOVE TOT-INV-QTY       TO SORT-QUANTITY
                   IF TOT-INV-QTY > 0
                       COMPUTE SORT-UNIT-COST = TOT-INV-COST
                                              / TOT-INV-QTY
                   ELSE
                       MOVE TOT-INV-COST  TO SORT-UNIT-COST.

      *------ DETERMINE EXPENSE TYPE OF THIS REQ.
           MOVE "E"                      TO  RQPH-PATH-TYPE.
           MOVE REQ-SUB                  TO  RQPH-CLASS.
           MOVE REQ-SUBD                 TO  RQPH-REQ-DEPT.
           MOVE REQ-SUBD                 TO  RQPH-DEPARTMENT.
           MOVE REQ-ADDTL-DATA           TO  RQPH-EXPENSE-CLASS.
           MOVE REQ-BUDGET-NO            TO  RQPH-BUDGET-NUMBER.
           MOVE REQ-BUDGET-AMT           TO  RQPH-VALUE.
           MOVE SPACES                   TO  RQPH-RET-CATEGORY.
           MOVE SPACES                   TO  RQPH-WO-APPROVED.
           CALL "CEARQPH2" USING BASE, STATUS-AREA, RQPH-AREA,
             RQPH-SAVE-TABLE, BU-DISPLAY-MSG.
           IF BU-DISPLAY-MSG-1 NOT = SPACES
               PERFORM 2100-BLOWUP.

      *------ FOR SORTING BY APPROVAL SPEED, WE USE EXP CATEGORY
      *------ TO DISTINGUISH MANUAL APPROVAL (PATH 1) FROM ON-LINE
      *------ APPROVAL (ANY OTHER PATH).
           IF OPT-SORT = "09"
               IF REQ-PATH NOT NUMERIC
                   MOVE "A"              TO  SORT-EXP-CAT
               ELSE
               IF REQ-PATH = "001"
                   MOVE "A"              TO  SORT-EXP-CAT
               ELSE
                   MOVE "B"              TO  SORT-EXP-CAT
           ELSE
               MOVE RQPH-RET-CATEGORY    TO  SORT-EXP-CAT.
           IF SORT-EXP-CAT < " "
               MOVE SPACES               TO  SORT-EXP-CAT.

           MOVE DREQD-WO-NUMBER          TO  SORT-WO.
           MOVE REQ-BUDGET-NO            TO  SORT-BUDGET-NO.
           MOVE REQ-ORIGINATOR           TO  SORT-ORIG.
           MOVE REQ-REL-MC-DATE-CN       TO  SORT-REL-DATE-CN.

      *------ IF SORTING BY APPROVAL SPEED, FIGURE OUT THAT SPEED:
      *------ REQ RELEASE DATE - REQ CREATE DATE.
           IF OPT-SORT = "09"
               PERFORM 6920-FIGURE-DAYS
               MOVE APPROVAL-DAYS        TO  SORT-BUDGET-NO
           ELSE
               MOVE REQ-BUDGET-NO        TO  SORT-BUDGET-NO.

           IF REQ-HOLD-STATUS-CODE = "RT"
               PERFORM 6880-CHECK-4-1ST-APPROVAL THRU 6880-C41A-X
               IF FIRST-APPROVER = "N"
                   MULTIPLY -1 BY SORT-UNIT-COST.

           RELEASE SORT-RCD.

           GO TO 6010-SERIAL-LOOP.

      ******************************************************************
      ** INPUT SECTION PERFORMED ROUTINES                             **
      ******************************************************************
       6800-FIND-DEPT.
           MOVE 0                        TO  SUB.
           MOVE "N"                      TO  FOUND-DEPT-FLAG.
       6805-FIND-DEPT-LOOP.
           ADD 1                         TO  SUB.
           IF SUB > 20
               GO TO 6810-FD-X.

           IF REQ-SUBD = OPT-DEPT (SUB)
               MOVE "Y"                  TO  FOUND-DEPT-FLAG
               GO TO 6810-FD-X.

           GO TO 6805-FIND-DEPT-LOOP.

       6810-FD-X.
           EXIT.

      *---------- FIND ORIGINATOR.
       6815-FIND-ORIG.
           MOVE 0                        TO  SUB.
           MOVE "N"                      TO  FOUND-ORIG-FLAG.
       6815-FIND-ORIG-LOOP.
           ADD 1                         TO  SUB.
           IF SUB > 5
               GO TO 6815-FO-X.

           IF REQ-ORIGINATOR = OPT-ORIG (SUB)
               MOVE "Y"                  TO  FOUND-ORIG-FLAG
               GO TO 6815-FO-X.

           GO TO 6815-FIND-ORIG-LOOP.

       6815-FO-X.
           EXIT.

       6820-CHECK-1-APP.
           MOVE "Y"                      TO  AT-LEAST-1-APP.
           IF REQ-APPROVALS-LEFT = "00" OR "  "
               GO TO 6840-C1A-X.
           IF REQ-RELEASE-STAT = "X " OR "XX"
               GO TO 6840-C1A-X.

           PERFORM 9999-CHAINHD-DREQQUE-RQ-I.

       6830-CHECK-1-APP-LOOP.
           PERFORM 9999-GETNEXT-DREQQUE-RQ-I.
           IF END-OF-CHAIN
               MOVE "N"                  TO  AT-LEAST-1-APP
               GO TO 6840-C1A-X.

           IF DRQQ-LEVEL-NUM = "00"
               GO TO 6830-CHECK-1-APP-LOOP.
           IF DRQQ-APPROVE-DATE-CN > SPACES
               GO TO 6840-C1A-X.

           GO TO 6830-CHECK-1-APP-LOOP.

       6840-C1A-X.
           EXIT.

       6850-UPDATE-REL-DATE.
           PERFORM 9999-CHAINHD-DREQQUE-RQ-I.

       6860-UPDATE-REL-LOOP.
           PERFORM 9999-GETNEXT-DREQQUE-RQ-I.
           IF END-OF-CHAIN
               GO TO 6865-UPDATE-MREQ.

           IF DRQQ-APPROVE-DATE-CN = SPACES
               GO TO 6870-URD-X
           ELSE
           IF DRQQ-APPROVE-DATE-CN > SAVE-HIGHEST-DATE-CN
               MOVE DRQQ-APPROVE-DATE-CN    TO  SAVE-HIGHEST-DATE-CN.

           GO TO 6860-UPDATE-REL-LOOP.

       6865-UPDATE-MREQ.
           MOVE SAVE-HIGHEST-DATE-CN     TO  REQ-REL-MC-DATE-CN.
           PERFORM 9999-GETKEY-MREQ-RQ-O.
           PERFORM 9999-UPDATE-MREQ-RQ-O.

       6870-URD-X.
           EXIT.

       6880-CHECK-4-1ST-APPROVAL.
           MOVE "N" TO FIRST-APPROVER.
           PERFORM 9999-CHAINHD-DREQQUE-RQ-I.
       6880-CHECK-4-1-LOOP.
           PERFORM 9999-GETNEXT-DREQQUE-RQ-I.
           IF END-OF-CHAIN
               MOVE "N" TO  FIRST-APPROVER
               GO TO 6880-C41A-X.
           IF DRQQ-LEVEL-NUM = "00" GO TO 6880-CHECK-4-1-LOOP.
           IF DRQQ-EMPL-QUEUED = "WOAP" GO TO 6880-CHECK-4-1-LOOP.
           IF DRQQ-APPROVE-DATE-CN = "        "
               GO TO 6880-CHECK-4-1-LOOP.
           IF DRQQ-APPROVE-DATE-CN NOT LESS THAN SAVE-LOW-DATE-CN
             IF DRQQ-APPROVE-DATE-CN NOT GREATER THAN SAVE-HIGH-DATE-CN
                 MOVE "Y" TO FIRST-APPROVER.
       6880-C41A-X.
           EXIT.

       6920-FIGURE-DAYS.
           MOVE REQ-REL-MC-DATE          TO  REQ-REL-WORK.
           CALL "CDATCALC" USING REQ-DATE, REQ-REL-MC-DATE,
               APPROVAL-DAYS.

       6990-IS-X.
           EXIT.


      *******************************************
      *                                         *
      *    O U T P U T   P R O C E D U R E      *
      *                                         *
      *******************************************

       7000-OUTPUT-STUFF SECTION.
       7010-START-OUTPUT.
           PERFORM 7800-HEADERS.
           MOVE "Y"                      TO  FIRST-TIME-FLAG.

       7020-READ-LOOP.
           PERFORM 7810-RETURN-REC.
           IF END-OF-FILE-FLAG = "Y"
               GO TO 7500-REPORT-TOTALS.

           MOVE "N"                      TO  BREAK-FLAG-L1.
           MOVE "N"                      TO  BREAK-FLAG-L2.
           IF FIRST-TIME-FLAG = "Y"
               MOVE "N"                  TO  FIRST-TIME-FLAG
               PERFORM 7820-MOVE-BREAK-FLD
           ELSE
               PERFORM 7830-CHECK-BREAK-L1
               PERFORM 7840-CHECK-BREAK-L2.

           IF BREAK-FLAG-L1 = "Y"
               PERFORM 7850-CONTROL-BREAK-L1
           ELSE
           IF BREAK-FLAG-L2 = "Y"
               PERFORM 7860-CONTROL-BREAK-L2
               PERFORM 7820-MOVE-BREAK-FLD.

           MOVE 4                        TO  DATE-MODE.
           MOVE SORT-DATE                TO  DATE-VALIDATE-IN.
           CALL "TDATECHK" USING DATE-CHECK-AREA.
           MOVE DATE-SLASH-OUT           TO  D1-DATE.
           MOVE SORT-REQ-NUMBER          TO  D1-REQ-NUMBER.
           MOVE SORT-DEPT                TO  D1-DEPT.
           IF SORT-EXP-CLASS NUMERIC
               MOVE SORT-EXP-CLASS       TO  D1-EXP-CLASS
           ELSE
               MOVE SORT-EXP-CLASS       TO  D1-EXP-CLASS-X.
           MOVE SORT-CORP-CODE           TO  D1-CORP-CODE.
           MOVE SORT-QUANTITY            TO  D1-QUANTITY.
           MOVE SORT-UM                  TO  D1-UM.
           MOVE SORT-UNIT-COST           TO  D1-UNIT-COST.
           MULTIPLY SORT-UNIT-COST BY SORT-QUANTITY
               GIVING SAVE-TOTAL-COST.
           MOVE SAVE-TOTAL-COST          TO  D1-TOTAL-COST.

           MOVE SORT-EXP-CAT             TO  D1-EXP-CAT.
           IF OPT-SORT = "09"
               MOVE SORT-BUDGET-NO       TO  D1-BUDGET-NO-9
           ELSE
           IF OPT-SORT = "11"
               MOVE SORT-EQUIP-NUM       TO  D1-BUDGET-NO
           ELSE
               MOVE SORT-BUDGET-NO       TO  D1-BUDGET-NO.
           MOVE SORT-WO                  TO  D1-WO.
           MOVE SORT-ORIG                TO  D1-ORIG.

           MOVE SORT-REL-DATE            TO  DATE-VALIDATE-IN.
           CALL "TDATECHK" USING DATE-CHECK-AREA.
           MOVE DATE-SLASH-OUT           TO  D1-REL-DATE.

           ADD 1                         TO  L1-REQ-COUNT.
           ADD 1                         TO  L2-REQ-COUNT.
           ADD 1                         TO  RPT-REQ-COUNT.
           ADD SAVE-TOTAL-COST           TO  L1-TOTAL-COST.
           ADD SAVE-TOTAL-COST           TO  L2-TOTAL-COST.
           ADD SAVE-TOTAL-COST           TO  RPT-TOTAL-COST.
           IF OPT-SORT = "09"
               MOVE SORT-BUDGET-NO       TO  APPROVAL-DAYS
               ADD APPROVAL-DAYS         TO  L1-APPROVAL-DAYS
               ADD APPROVAL-DAYS         TO  RPT-APPROVAL-DAYS.

           WRITE PRINT-RCD FROM DETAIL-LINE AFTER ADVANCING 1.
           ADD 1                         TO  LINE-COUNT.

           IF OPT-DESC = "Y"
               ADD 1                     TO  LINE-COUNT
               IF SORT-REQ-STATUS-1 = "S"
                   CALL "CDESC" USING CDESC-RET-CODE, BASE, STATUS-AREA,
                     BU-DISPLAY-MSG, SORT-CORP-CODE, CDESC-DATA
                   IF BU-DISPLAY-MSG-1 NOT = SPACES
                       PERFORM 2100-BLOWUP
                   ELSE
                       MOVE CDESC (1)    TO  PRT-DESC
                       WRITE PRINT-RCD FROM DESC-LINE AFTER ADVANCING 1
               ELSE
                   MOVE 1                TO  RQD-NUM-LINES
                   CALL "TNRQDESC" USING RQD-RET-CODE, BASE,
                     STATUS-AREA, SORT-REQ-NUMBER, REQ-DESC-AREA,
                     BU-DISPLAY-MSG
                   IF BU-DISPLAY-MSG-1 NOT = SPACES
                       PERFORM 2100-BLOWUP
                   ELSE
                       MOVE RQD-DESC (1) TO  PRT-DESC
                       WRITE PRINT-RCD FROM DESC-LINE AFTER ADVANCING 1.

           IF LINE-COUNT > 55
               PERFORM 7800-HEADERS.

           GO TO 7020-READ-LOOP.


       7500-REPORT-TOTALS.
           PERFORM 7850-CONTROL-BREAK-L1.

           MOVE RPT-REQ-COUNT            TO  T2-REQ-COUNT.
           MOVE RPT-TOTAL-COST           TO  T2-TOTAL-COST.
           WRITE PRINT-RCD FROM RPT-TOTAL AFTER ADVANCING 2.

           IF OPT-SORT = "09"
               MOVE "Y"                  TO  RPT-TOTAL-FLAG
               PERFORM 7870-APPROVAL-DAYS.

           GO TO 7990-OS-X.


      ******************************************************************
      ** OUTPUT SECTION PERFORMED ROUTINES                            **
      ******************************************************************
       7800-HEADERS.
           ADD 1                         TO  PAGE-COUNT.
           MOVE PAGE-COUNT               TO  PRT-PAG.
           WRITE PRINT-RCD FROM HDR-1 AFTER ADVANCING NEW-PAGE.
           WRITE PRINT-RCD FROM HDR-OPTIONS-1 AFTER ADVANCING 2.
           WRITE PRINT-RCD FROM HDR-OPTIONS-2 AFTER ADVANCING 1.

           WRITE PRINT-RCD FROM HDR-2 AFTER ADVANCING 2.
           MOVE 6                        TO  LINE-COUNT.


       7810-RETURN-REC.
           RETURN SORT-FILE AT END
               MOVE "Y"                  TO  END-OF-FILE-FLAG.

       7820-MOVE-BREAK-FLD.
           IF OPT-SORT = "01"
               MOVE SORT-DEPT            TO  BREAK-FLD-L1
               MOVE SPACES               TO  BREAK-FLD-L2
           ELSE
           IF OPT-SORT = "02"
               MOVE SPACES               TO  BREAK-FLD-L1
               MOVE SPACES               TO  BREAK-FLD-L2
           ELSE
           IF OPT-SORT = "03"
               MOVE SORT-DEPT            TO  BREAK-FLD-L1
               MOVE SORT-EXP-CAT         TO  BREAK-FLD-L2
           ELSE
           IF OPT-SORT = "04"
               MOVE SORT-EXP-CAT         TO  BREAK-FLD-L1
               MOVE SPACES               TO  BREAK-FLD-L2
           ELSE
           IF OPT-SORT = "05"
               MOVE SORT-WO              TO  BREAK-FLD-L1
               MOVE SPACES               TO  BREAK-FLD-L2
           ELSE
           IF OPT-SORT = "06"
               MOVE SORT-BUDGET-NO       TO  BREAK-FLD-L1
               MOVE SPACES               TO  BREAK-FLD-L2
           ELSE
           IF OPT-SORT = "07"
               MOVE SORT-ORIG            TO  BREAK-FLD-L1
               MOVE SPACES               TO  BREAK-FLD-L2
           ELSE
           IF OPT-SORT = "08"
               MOVE SORT-DEPT            TO  BREAK-FLD-L1
               MOVE SORT-ORIG            TO  BREAK-FLD-L2
           ELSE
           IF OPT-SORT = "09"
               MOVE SORT-EXP-CAT         TO  BREAK-FLD-L1
               MOVE SORT-BUDGET-NO       TO  BREAK-FLD-L2
           ELSE
           IF OPT-SORT = "10"
               MOVE SORT-EXP-CLASS       TO  BREAK-FLD-L1
               MOVE SPACES               TO  BREAK-FLD-L2
           ELSE
           IF OPT-SORT = "11"
               MOVE SORT-EQUIP-NUM       TO  BREAK-FLD-L1
               MOVE SPACES               TO  BREAK-FLD-L2
           ELSE
               MOVE SPACES               TO  BREAK-FLD-L1
               MOVE SPACES               TO  BREAK-FLD-L2.

       7830-CHECK-BREAK-L1.
           IF OPT-SORT = "01"
               IF SORT-DEPT NOT = BREAK-FLD-L1
                   MOVE "Y"              TO  BREAK-FLAG-L1
               END-IF
           ELSE
           IF OPT-SORT = "03"
               IF SORT-DEPT NOT = BREAK-FLD-L1
                   MOVE "Y"              TO  BREAK-FLAG-L1
               END-IF
           ELSE
           IF OPT-SORT = "04"
               IF SORT-EXP-CAT NOT = BREAK-FLD-L1
                   MOVE "Y"              TO  BREAK-FLAG-L1
               END-IF
           ELSE
           IF OPT-SORT = "05"
               IF SORT-WO NOT = BREAK-FLD-L1
                   MOVE "Y"              TO  BREAK-FLAG-L1
               END-IF
           ELSE
           IF OPT-SORT = "06"
               IF SORT-BUDGET-NO NOT = BREAK-FLD-L1
                   MOVE "Y"              TO  BREAK-FLAG-L1
               END-IF
           ELSE
           IF OPT-SORT = "07"
               IF SORT-ORIG NOT = BREAK-FLD-L1
                   MOVE "Y"              TO  BREAK-FLAG-L1
               END-IF
           ELSE
           IF OPT-SORT = "08"
               IF SORT-DEPT NOT = BREAK-FLD-L1
                   MOVE "Y"              TO  BREAK-FLAG-L1
               END-IF
           ELSE
           IF OPT-SORT = "09"
               IF SORT-EXP-CAT NOT = BREAK-FLD-L1
                   MOVE "Y"              TO  BREAK-FLAG-L1
               END-IF
           ELSE
           IF OPT-SORT = "10"
               IF SORT-EXP-CLASS NOT = BREAK-FLD-L1
                   MOVE "Y"              TO  BREAK-FLAG-L1
               END-IF
           ELSE
           IF OPT-SORT = "11"
               IF SORT-EQUIP-NUM NOT = BREAK-FLD-L1
                   MOVE "Y"              TO  BREAK-FLAG-L1
               END-IF
           ELSE
               MOVE "N"                  TO  BREAK-FLAG-L1.

       7840-CHECK-BREAK-L2.
           IF OPT-SORT = "03"
               IF SORT-EXP-CAT NOT = BREAK-FLD-L2
                   MOVE "Y"              TO  BREAK-FLAG-L2
               ELSE
                   NEXT SENTENCE
           ELSE
           IF OPT-SORT = "08"
               IF SORT-ORIG NOT = BREAK-FLD-L2
                   MOVE "Y"              TO  BREAK-FLAG-L2
               ELSE
                   NEXT SENTENCE
           ELSE
           IF OPT-SORT = "09"
               IF SORT-BUDGET-NO NOT = BREAK-FLD-L2
                   MOVE "Y"              TO  BREAK-FLAG-L2
               ELSE
                   NEXT SENTENCE
           ELSE
               MOVE "N"                  TO  BREAK-FLAG-L2.

       7850-CONTROL-BREAK-L1.
           IF OPT-SORT = "03" OR "08" OR "09"
               PERFORM 7860-CONTROL-BREAK-L2.
           MOVE BREAK-FLD-L1             TO  T1-ITEM.
           MOVE L1-REQ-COUNT             TO  T1-REQ-COUNT.
           MOVE L1-TOTAL-COST            TO  T1-TOTAL-COST.
           WRITE PRINT-RCD FROM BREAK-TOTAL AFTER ADVANCING 2.
      *------ WHEN SORTING BY DAYS APPROVED, GIVE AVERAGE LINE FOR
      *------ MANUAL APPROVAL REQS AND ONLINE APPROVAL REQS
           IF OPT-SORT = "09"
               PERFORM 7870-APPROVAL-DAYS.
           MOVE 0                        TO  L1-REQ-COUNT.
           MOVE 0                        TO  L1-TOTAL-COST.

           PERFORM 7820-MOVE-BREAK-FLD.
           PERFORM 7800-HEADERS.

       7860-CONTROL-BREAK-L2.
           IF OPT-SORT = "09"
               MOVE SPACES               TO  T1-ITEM
               IF BF-L2-1-12 NUMERIC
                   MOVE BF-L2-1-12-9     TO  T1-ITEM-9
               ELSE
                   MOVE ZERO             TO  T1-ITEM-9
           ELSE
               MOVE BREAK-FLD-L2         TO  T1-ITEM.
           MOVE L2-REQ-COUNT             TO  T1-REQ-COUNT.
           MOVE L2-TOTAL-COST            TO  T1-TOTAL-COST.
           WRITE PRINT-RCD FROM BREAK-TOTAL AFTER ADVANCING 2.
           MOVE 0                        TO  L2-REQ-COUNT.
           MOVE 0                        TO  L2-TOTAL-COST.
      *------ WE DONT MOVE BREAK FLD HERE IN CASE THIS IS PERFORMED
      *------ FROM 7850-BREAK-L1.  IF PERFORMED ALONE, THE PERFORMER
      *------ ALSO PERFORMS 7820-MOVE.
           MOVE SPACES                   TO  PRINT-RCD.
           WRITE PRINT-RCD AFTER ADVANCING 1.
           ADD 4                         TO  LINE-COUNT.

       7870-APPROVAL-DAYS.
           IF RPT-TOTAL-FLAG = "Y"
               DIVIDE RPT-APPROVAL-DAYS BY RPT-REQ-COUNT
                   GIVING AVERAGE-APPROVAL-DAYS ROUNDED
           ELSE
               DIVIDE L1-APPROVAL-DAYS BY L1-REQ-COUNT
                   GIVING AVERAGE-APPROVAL-DAYS ROUNDED.
           MOVE 0                        TO  L1-APPROVAL-DAYS.

           MOVE AVERAGE-APPROVAL-DAYS    TO  PRT-AVERAGE.
           IF RPT-TOTAL-FLAG = "Y"
               MOVE "ALL"                TO  PRT-MAN-ON
           ELSE
           IF BREAK-FLD-L1 = "A"
               MOVE "MANUAL APPROVAL"    TO  PRT-MAN-ON
           ELSE
               MOVE "ONLINE APPROVAL"    TO  PRT-MAN-ON.

           WRITE PRINT-RCD FROM PRT-AVERAGE-LINE AFTER ADVANCING 2.


       7990-OS-X.
           EXIT.

      *
      * NEEDED SO SORT DOESN'T FALL THROUGH
      *  -- ADDED BY FRED HAYNES 2/7/91
      *
       COPYLIB-MEMBERS SECTION.
       COPY OVRPFCALL IN COPYLIB.

       9999-CHAINHD-DINVRCD-PO-I.
           MOVE 0 TO COND-WORD.
           MOVE PO-ARG TO PORCVNO OF DINVRCD-PO-REC-I.
           START DINVRCD-PO-I KEY = PORCVNO OF DINVRCD-PO-REC-I
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF (FILE-STATUS NOT = "00") AND (FILE-STATUS-1 NOT = "2")
               MOVE 99 TO COND-WORD
               IF HANDLE-BLOWUP-FLAG = "Y"
                   MOVE "CHAINHD ERR 9999-CHAINHD-DINVRCD-PO-I"
                       TO BU-MSG-AREA
                   PERFORM 2100-BLOWUP.

       9999-CHAINHD-DINVITM-RG-I.
           MOVE 0 TO COND-WORD.
           MOVE REGISTER-ARG TO REGISTERNO OF DINVITM-RG-REC-I.
           START DINVITM-RG-I KEY = REGISTERNO OF DINVITM-RG-REC-I
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF (FILE-STATUS NOT = "00") AND (FILE-STATUS-1 NOT = "2")
               MOVE 99 TO COND-WORD
               IF HANDLE-BLOWUP-FLAG = "Y"
                   MOVE "CHAINHD ERR 9999-CHAINHD-DINVITM-RG-I"
                       TO BU-MSG-AREA
                   PERFORM 2100-BLOWUP.

       9999-CHAINHD-DPOITEM-PO-I.
           MOVE 0 TO COND-WORD.
           MOVE PO-ARG TO PORCVNO OF DPOITEM-PO-REC-I.
           START DPOITEM-PO-I KEY = PORCVNO OF DPOITEM-PO-REC-I
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF (FILE-STATUS NOT = "00") AND (FILE-STATUS-1 NOT = "2")
               MOVE 99 TO COND-WORD
               IF HANDLE-BLOWUP-FLAG = "Y"
                   MOVE "CHAINHD ERR 9999-CHAINHD-DPOITEM-PO-I"
                       TO BU-MSG-AREA
                   PERFORM 2100-BLOWUP.

       9999-CHAINHD-DREQQUE-RQ-I.
           MOVE 0 TO COND-WORD.
           MOVE REQ-ARG TO REQNO OF DREQQUE-RQ-REC-I.
           START DREQQUE-RQ-I KEY = REQNO OF DREQQUE-RQ-REC-I
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF (FILE-STATUS NOT = "00") AND (FILE-STATUS-1 NOT = "2")
               MOVE 99 TO COND-WORD
               IF HANDLE-BLOWUP-FLAG = "Y"
                   MOVE "CHAINHD ERR 9999-CHAINHD-DREQQUE-RQ-I"
                       TO BU-MSG-AREA
                   PERFORM 2100-BLOWUP.

       9999-CHAINHD-DREQITM-RQ-I.
           MOVE 0 TO COND-WORD.
           MOVE REQ-ARG TO REQNO OF DREQITM-RQ-REC-I.
           START DREQITM-RQ-I KEY = REQNO OF DREQITM-RQ-REC-I
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF (FILE-STATUS NOT = "00") AND (FILE-STATUS-1 NOT = "2")
               MOVE 99 TO COND-WORD
               IF HANDLE-BLOWUP-FLAG = "Y"
                   MOVE "CHAINHD ERR 9999-CHAINHD-DREQITM-RQ-I"
                       TO BU-MSG-AREA
                   PERFORM 2100-BLOWUP.

       9999-CHAINHD-DREQD-RQ-I.
           MOVE 0 TO COND-WORD.
           MOVE REQ-ARG TO REQNO OF DREQD-RQ-REC-I.
           START DREQD-RQ-I KEY = REQNO OF DREQD-RQ-REC-I
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF (FILE-STATUS NOT = "00") AND (FILE-STATUS-1 NOT = "2")
               MOVE 99 TO COND-WORD
               IF HANDLE-BLOWUP-FLAG = "Y"
                   MOVE "CHAINHD ERR 9999-CHAINHD-DREQD-RQ-I"
                       TO BU-MSG-AREA
                   PERFORM 2100-BLOWUP.

       9999-CHAINHD-WO-BASIC-WO-I.
           MOVE 0 TO COND-WORD.
           MOVE WO-NUM-ARG TO WONUM OF WO-BASIC-WO-REC-I.
           START WO-BASIC-WO-I KEY = WONUM OF WO-BASIC-WO-REC-I
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF (FILE-STATUS NOT = "00") AND (FILE-STATUS-1 NOT = "2")
               MOVE 99 TO COND-WORD
               IF HANDLE-BLOWUP-FLAG = "Y"
                   MOVE "CHAINHD ERR 9999-CHAINHD-WO-BASIC-WO-I"
                       TO BU-MSG-AREA
                   PERFORM 2100-BLOWUP.

       9999-CHAINHD-WO-PLANNED-WO-I.
           MOVE 0 TO COND-WORD.
           MOVE WO-NUM-ARG TO WONUM OF WO-PLANNED-WO-REC-I.
           START WO-PLANNED-WO-I KEY = WONUM OF WO-PLANNED-WO-REC-I
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF (FILE-STATUS NOT = "00") AND (FILE-STATUS-1 NOT = "2")
               MOVE 99 TO COND-WORD
               IF HANDLE-BLOWUP-FLAG = "Y"
                   MOVE "CHAINHD ERR 9999-CHAINHD-WO-PLANNED-WO-I"
                       TO BU-MSG-AREA
                   PERFORM 2100-BLOWUP.

       9999-CLOSE-STUFF.
           CLOSE DINVRCD-PO-I.
           CLOSE DINVITM-RG-I.
           CLOSE DPOITEM-PO-I.
           CLOSE DREQQUE-RQ-I.
           CLOSE DREQITM-RQ-I.
           CLOSE DREQD-RQ-I.
           CLOSE MREQ-RQ-O.
           CLOSE MREQ-RQ-I.
           CLOSE MSTORERM-CD-I.
           CLOSE WO-BASIC-WO-I.
           CLOSE WO-PLANNED-WO-I.

       9999-GETKEY-MREQ-RQ-O.
           MOVE 0 TO COND-WORD.
           MOVE REQ-ARG TO REQNO OF MREQ-RQ-REC-O.
           READ MREQ-RQ-O INTO BUF-MREQ
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS = "23"
               MOVE 17 TO COND-WORD
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD
               IF HANDLE-BLOWUP-FLAG = "Y"
                   MOVE "GETKEY ERR 9999-GETKEY-MREQ-RQ-O"
                       TO BU-MSG-AREA
                   PERFORM 2100-BLOWUP.

       9999-RESET-MREQ-RQ-O.
           MOVE HIGH-VALUES TO REQNO OF MREQ-RQ-REC-O.
           START MREQ-RQ-O KEY > REQNO OF MREQ-RQ-REC-O
               INVALID KEY MOVE "00" TO FILE-STATUS.

       9999-GETKEY-MSTORERM-CD-I.
           MOVE 0 TO COND-WORD.
           MOVE CODE-ARG TO CORPCDE OF MSTORERM-CD-REC-I.
           READ MSTORERM-CD-I INTO BUF-MSTORERM
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS = "23"
               MOVE 17 TO COND-WORD
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD
               IF HANDLE-BLOWUP-FLAG = "Y"
                   MOVE "GETKEY ERR 9999-GETKEY-MSTORERM-CD-I"
                       TO BU-MSG-AREA
                   PERFORM 2100-BLOWUP.

       9999-GETNEXT-DINVRCD-PO-I.
           MOVE 0 TO COND-WORD.
           READ DINVRCD-PO-I NEXT INTO BUF-DINVRCD
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   MOVE 15 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD
                   IF HANDLE-BLOWUP-FLAG = "Y"
                       MOVE "GETNEXT ERR 9999-GETNEXT-DINVRCD-PO-I"
                           TO BU-MSG-AREA
                       PERFORM 2100-BLOWUP
                   END-IF
           ELSE
           IF PORCVNO OF DINVRCD-PO-REC-I NOT = PO-ARG
               MOVE 15 TO COND-WORD.

       9999-GETNEXT-DINVITM-RG-I.
           MOVE 0 TO COND-WORD.
           READ DINVITM-RG-I NEXT INTO BUF-DINVITM
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   MOVE 15 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD
                   IF HANDLE-BLOWUP-FLAG = "Y"
                       MOVE "GETNEXT ERR 9999-GETNEXT-DINVITM-RG-I"
                           TO BU-MSG-AREA
                       PERFORM 2100-BLOWUP
                   END-IF
           ELSE
           IF REGISTERNO OF DINVITM-RG-REC-I NOT = REGISTER-ARG
               MOVE 15 TO COND-WORD.

       9999-GETNEXT-DPOITEM-PO-I.
           MOVE 0 TO COND-WORD.
           READ DPOITEM-PO-I NEXT INTO BUF-DPOITEM
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   MOVE 15 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD
                   IF HANDLE-BLOWUP-FLAG = "Y"
                       MOVE "GETNEXT ERR 9999-GETNEXT-DPOITEM-PO-I"
                           TO BU-MSG-AREA
                       PERFORM 2100-BLOWUP
                   END-IF
           ELSE
           IF PORCVNO OF DPOITEM-PO-REC-I NOT = PO-ARG
               MOVE 15 TO COND-WORD.

       9999-GETNEXT-DREQQUE-RQ-I.
           MOVE 0 TO COND-WORD.
           READ DREQQUE-RQ-I NEXT INTO BUF-DREQQUE
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   MOVE 15 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD
                   IF HANDLE-BLOWUP-FLAG = "Y"
                       MOVE "GETNEXT ERR 9999-GETNEXT-DREQQUE-RQ-I"
                           TO BU-MSG-AREA
                       PERFORM 2100-BLOWUP
                   END-IF
           ELSE
           IF REQNO OF DREQQUE-RQ-REC-I NOT = REQ-ARG
               MOVE 15 TO COND-WORD.

       9999-GETNEXT-DREQITM-RQ-I.
           MOVE 0 TO COND-WORD.
           READ DREQITM-RQ-I NEXT INTO BUF-DREQITM
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   MOVE 15 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD
                   IF HANDLE-BLOWUP-FLAG = "Y"
                       MOVE "GETNEXT ERR 9999-GETNEXT-DREQITM-RQ-I"
                           TO BU-MSG-AREA
                       PERFORM 2100-BLOWUP
                   END-IF
           ELSE
           IF REQNO OF DREQITM-RQ-REC-I NOT = REQ-ARG
               MOVE 15 TO COND-WORD.

       9999-GETNEXT-DREQD-RQ-I.
           MOVE 0 TO COND-WORD.
           READ DREQD-RQ-I NEXT INTO BUF-DREQD
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   MOVE 15 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD
                   IF HANDLE-BLOWUP-FLAG = "Y"
                       MOVE "GETNEXT ERR 9999-GETNEXT-DREQD-RQ-I"
                           TO BU-MSG-AREA
                       PERFORM 2100-BLOWUP
                   END-IF
           ELSE
           IF REQNO OF DREQD-RQ-REC-I NOT = REQ-ARG
               MOVE 15 TO COND-WORD.

       9999-GETNEXT-WO-BASIC-WO-I.
           MOVE 0 TO COND-WORD.
           READ WO-BASIC-WO-I NEXT INTO BUF-WO-BASIC
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   MOVE 15 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD
                   IF HANDLE-BLOWUP-FLAG = "Y"
                       MOVE "GETNEXT ERR 9999-GETNEXT-WO-BASIC-WO-I"
                           TO BU-MSG-AREA
                       PERFORM 2100-BLOWUP
                   END-IF
           ELSE
           IF WONUM OF WO-BASIC-WO-REC-I NOT = WO-NUM-ARG
               MOVE 15 TO COND-WORD.

       9999-GETNEXT-WO-PLANNED-WO-I.
           MOVE 0 TO COND-WORD.
           READ WO-PLANNED-WO-I NEXT INTO BUF-WO-PLANNED
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   MOVE 15 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD
                   IF HANDLE-BLOWUP-FLAG = "Y"
                       MOVE "GETNEXT ERR 9999-GETNEXT-WO-PLANNED-WO-I"
                           TO BU-MSG-AREA
                       PERFORM 2100-BLOWUP
                   END-IF
           ELSE
           IF WONUM OF WO-PLANNED-WO-REC-I NOT = WO-NUM-ARG
               MOVE 15 TO COND-WORD.

       9999-GETSER-MREQ-RQ-I.
           MOVE 0 TO COND-WORD.
           READ MREQ-RQ-I NEXT INTO BUF-MREQ
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS-1 = "1"
               MOVE 11 TO COND-WORD
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD
               IF HANDLE-BLOWUP-FLAG = "Y"
                   MOVE "GETSER ERR 9999-GETSER-MREQ-RQ-I"
                       TO BU-MSG-AREA
                   PERFORM 2100-BLOWUP.

       9999-BEGFIL-MREQ-RQ-I.
           MOVE SPACES TO REQNO OF MREQ-RQ-REC-I.
           START MREQ-RQ-I KEY >= REQNO OF MREQ-RQ-REC-I
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.

       9999-OPEN-STUFF.
           OPEN INPUT DINVRCD-PO-I.
           OPEN INPUT DINVITM-RG-I.
           OPEN INPUT DPOITEM-PO-I.
           OPEN INPUT DREQQUE-RQ-I.
           OPEN INPUT DREQITM-RQ-I.
           OPEN INPUT DREQD-RQ-I.
           OPEN INPUT MREQ-RQ-I.
           OPEN I-O MREQ-RQ-O.
           OPEN INPUT MSTORERM-CD-I.
           OPEN INPUT WO-BASIC-WO-I.
           OPEN INPUT WO-PLANNED-WO-I.

       9999-UPDATE-MREQ-RQ-O.
           MOVE 0 TO COND-WORD.
           REWRITE MREQ-RQ-REC-O FROM BUF-MREQ
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD
               IF HANDLE-BLOWUP-FLAG = "Y"
                   MOVE "UPDATE ERR 9999-UPDATE-MREQ-RQ-O"
                       TO BU-MSG-AREA
                   PERFORM 2100-BLOWUP.

