000200 IDENTIFICATION DIVISION.
000300 PROGRAM-ID.        TLODSUBS.
000600 ENVIRONMENT DIVISION.
000700 CONFIGURATION SECTION.
000800 SOURCE-COMPUTER.   AS400.
000900 OBJECT-COMPUTER.   AS400.
001000 INPUT-OUTPUT SECTION.
001100 FILE-CONTROL.
           SELECT CC-LINK-FILE
               ASSIGN TO DATABASE-MCFLMM2101
               ORGANIZATION IS INDEXED
               ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                   WITH DUPLICATES
               FILE STATUS IS FILE-STATUS.
           SELECT DRAWING-FILE
               ASSIGN TO DATABASE-MCFLDF0104
               ORGANIZATION IS INDEXED
               ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                   WITH DUPLICATES
               FILE STATUS IS FILE-STATUS.
           SELECT DRWFIL
               ASSIGN TO DATABASE-MCFPDRWFIL
               ORGANIZATION IS SEQUENTIAL
               ACCESS MODE IS SEQUENTIAL
               FILE STATUS IS FILE-STATUS.
           SELECT EQPOPS
               ASSIGN TO DATABASE-MCFPEQPOPS
               ORGANIZATION IS SEQUENTIAL
               ACCESS MODE IS SEQUENTIAL
               FILE STATUS IS FILE-STATUS.
           SELECT EQPREF
               ASSIGN TO DATABASE-MCFPEQPREF
               ORGANIZATION IS SEQUENTIAL
               ACCESS MODE IS SEQUENTIAL
               FILE STATUS IS FILE-STATUS.
           SELECT EQPREM
               ASSIGN TO DATABASE-MCFPEQPREM
               ORGANIZATION IS SEQUENTIAL
               ACCESS IS SEQUENTIAL
               FILE STATUS IS FILE-STATUS.
           SELECT EQUIP-OPERATIONS
               ASSIGN TO DATABASE-MCFLER0501
               ORGANIZATION IS INDEXED
               ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                   WITH DUPLICATES
               FILE STATUS IS FILE-STATUS.
           SELECT EQUIP-REF
               ASSIGN TO DATABASE-MCFLER0101
               ORGANIZATION IS INDEXED
               ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
               FILE STATUS IS FILE-STATUS.
           SELECT EQUIP-REMARKS
               ASSIGN TO DATABASE-MCFLER0301
               ORGANIZATION IS INDEXED
               ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                   WITH DUPLICATES
               FILE STATUS IS FILE-STATUS.
001300     SELECT PRINT-FILE ASSIGN TO PRINTER-MCPRT.
001600     SELECT RET-FILE
               ASSIGN TO DATABASE-MCFPRETF
001700         ORGANIZATION IS SEQUENTIAL
               ACCESS MODE IS SEQUENTIAL
001800         FILE STATUS IS FILE-STATUS.
           SELECT SPAREP
               ASSIGN TO DATABASE-MCFPSPAREP
               ORGANIZATION IS SEQUENTIAL
               ACCESS MODE IS SEQUENTIAL
               FILE STATUS IS FILE-STATUS.
           SELECT TYPOPS
               ASSIGN TO DATABASE-MCFPTYPOPS
               ORGANIZATION IS SEQUENTIAL
               ACCESS MODE IS SEQUENTIAL
               FILE STATUS IS FILE-STATUS.
           SELECT TYPE-OPERATIONS
               ASSIGN TO DATABASE-MCFLER0601
               ORGANIZATION IS INDEXED
               ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                   WITH DUPLICATES
               FILE STATUS IS FILE-STATUS.
           SELECT TYPREF
               ASSIGN TO DATABASE-MCFPTYPREF
               ORGANIZATION IS SEQUENTIAL
               ACCESS MODE IS SEQUENTIAL
               FILE STATUS IS FILE-STATUS.
           SELECT TYPE-REF
               ASSIGN TO DATABASE-MCFLER0201
               ORGANIZATION IS INDEXED
               ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
               FILE STATUS IS FILE-STATUS.
           SELECT TYPREM
               ASSIGN TO DATABASE-MCFPTYPREM
               ORGANIZATION IS SEQUENTIAL
               ACCESS MODE IS SEQUENTIAL
               FILE STATUS IS FILE-STATUS.
           SELECT TYPE-REMARKS
               ASSIGN TO DATABASE-MCFLER0401
               ORGANIZATION IS INDEXED
               ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                   WITH DUPLICATES
               FILE STATUS IS FILE-STATUS.
           SELECT WO-EQUIP-HIER
               ASSIGN TO DATABASE-MCFLMM1701
               ORGANIZATION IS INDEXED
               ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                   WITH DUPLICATES
               FILE STATUS IS FILE-STATUS.
001700 DATA DIVISION.
001800 FILE SECTION.
       FD  CC-LINK-FILE
           LABEL RECORDS ARE STANDARD
           DATA RECORD IS CC-LINK-REC.
       01  CC-LINK-REC.
           COPY DDS-ALL-FORMATS OF MCFLMM2101.
       FD  DRAWING-FILE
           LABEL RECORDS ARE STANDARD
           DATA RECORD IS DRAWING-FILE-REC.
       01  DRAWING-FILE-REC.
           COPY DDS-ALL-FORMATS OF MCFLDF0104.
       FD  DRWFIL
           LABEL RECORDS ARE STANDARD
           DATA RECORD IS DRWFIL-REC.
       01  DRWFIL-REC               PIC X(196).
       FD  EQPOPS
           LABEL RECORDS ARE STANDARD
           DATA RECORD IS EQPOPS-REC.
       01  EQPOPS-REC               PIC X(802).
       FD  EQPREF
           LABEL RECORDS ARE STANDARD
           DATA RECORD IS EQPREF-REC.
       01  EQPREF-REC               PIC X(330).
       FD  EQPREM
           LABEL RECORDS ARE STANDARD
           DATA RECORD IS EQPREM-REC.
       01  EQPREM-REC               PIC X(804).
       FD  EQUIP-OPERATIONS
           LABEL RECORDS ARE STANDARD
           DATA RECORD IS EQUIP-OPERATIONS-REC.
       01  EQUIP-OPERATIONS-REC.
           COPY DDS-ALL-FORMATS OF MCFLER0501.
       FD  EQUIP-REF
           LABEL RECORDS ARE STANDARD
           DATA RECORD IS EQUIP-REF-REC.
       01  EQUIP-REF-REC.
           COPY DDS-ALL-FORMATS OF MCFLER0101.
       FD  EQUIP-REMARKS
           LABEL RECORDS ARE STANDARD
           DATA RECORD IS EQUIP-REMARKS-REC.
       01  EQUIP-REMARKS-REC.
           COPY DDS-ALL-FORMATS OF MCFLER0301.
002300 FD  PRINT-FILE RECORD CONTAINS 132 CHARACTERS
002400     LABEL RECORD IS OMITTED
002500     DATA RECORD IS PRT-REC.
002600 01  PRT-REC                   PIC X(132).
002700 FD  RET-FILE
002800     RECORD CONTAINS 62 CHARACTERS
002900     DATA RECORD IS RETF.
003000 01  RETF.
003100     05  SUBTYP-SORT           PIC X(8).
003200     05  SUBNUM-SORT.
003300         10  SUBNUM-1-S        PIC X.
003400         10  SUBNUM-2-S        PIC X.
003500         10  SUBNUM-3-S        PIC X.
003600         10  SUBNUM-4-S        PIC X.
003700     05  SUBNUM-SORT-9 REDEFINES SUBNUM-SORT.
003800         10  SUBNUM-1-S-9      PIC 9.
003900         10  SUBNUM-2-S-9      PIC 9.
004000         10  SUBNUM-3-S-9      PIC 9.
004100         10  SUBNUM-4-S-9      PIC 9.
004200     05  SUBNAME-SORT          PIC X(50).
       FD  SPAREP
           RECORD CONTAINS 22 CHARACTERS
           DATA RECORD IS SPAREP-REC.
       01  SPAREP-REC          PIC X(22).
       FD  TYPOPS
           LABEL RECORDS ARE STANDARD
           DATA RECORD IS TYPOPS-REC.
       01  TYPOPS-REC          PIC X(804).
       FD  TYPE-OPERATIONS
           LABEL RECORDS ARE STANDARD
           DATA RECORD IS TYPE-OPERATIONS-REC.
       01  TYPE-OPERATIONS-REC.
           COPY DDS-ALL-FORMATS OF MCFLER0601.
       FD  TYPREF
           LABEL RECORDS ARE STANDARD
           DATA RECORD IS TYPREF-REC.
       01  TYPREF-REC          PIC X(324).
       FD  TYPE-REF
           LABEL RECORDS ARE STANDARD
           DATA RECORD IS TYPE-REF-REC.
       01  TYPE-REF-REC.
           COPY DDS-ALL-FORMATS OF MCFLER0201.
       FD  TYPREM
           LABEL RECORDS ARE STANDARD
           DATA RECORD IS TYPREM-REC.
       01  TYPREM-REC          PIC X(804).
       FD  TYPE-REMARKS
           LABEL RECORDS ARE STANDARD
           DATA RECORD IS TYPE-REMARKS-REC.
       01  TYPE-REMARKS-REC.
           COPY DDS-ALL-FORMATS OF MCFLER0401.
       FD  WO-EQUIP-HIER
           LABEL RECORDS ARE STANDARD
           DATA RECORD IS WEHREC.
       01  WEHREC.
           COPY DDS-ALL-FORMATS OF MCFLMM1701.
004400 WORKING-STORAGE SECTION.
004600 77  ALL-ENTRIES-READ-SW       PIC X VALUE "N".
004700 77  ALL-ERRORS-WRITTEN-SW     PIC X VALUE "N".
004800 77  ALL-RECORDS-WRITTEN-SW    PIC X VALUE "N".
       77  DRWFIL-READ               PIC 9(4) VALUE 0.
       77  DRWFIL-WRITTEN            PIC 9(4) VALUE 0.
       77  EQPOPS-READ               PIC 9(4) VALUE 0.
       77  EQPOPS-WRITTEN            PIC 9(4) VALUE 0.
       77  EQPREF-READ               PIC 9(4) VALUE 0.
       77  EQPREF-WRITTEN            PIC 9(4) VALUE 0.
       77  EQPREM-READ               PIC 9(4) VALUE 0.
       77  EQPREM-WRITTEN            PIC 9(4) VALUE 0.
       77  SPAREP-READ               PIC 9(4) VALUE 0.
       77  SPAREP-WRITTEN            PIC 9(4) VALUE 0.
004900 77  SUBSYS-READ               PIC 9(4) VALUE 0.
005000 77  SUBSYS-WRITTEN            PIC 9(4) VALUE 0.
       77  TYPOPS-READ               PIC 9(4) VALUE 0.
       77  TYPOPS-WRITTEN            PIC 9(4) VALUE 0.
       77  TYPREF-READ               PIC 9(4) VALUE 0.
       77  TYPREF-WRITTEN            PIC 9(4) VALUE 0.
       77  TYPREM-READ               PIC 9(4) VALUE 0.
       77  TYPREM-WRITTEN            PIC 9(4) VALUE 0.
005100 77  ERROR-SUB                 PIC 99 VALUE 0.
005200 77  ERROR-SW                  PIC X VALUE "N".
005300 77  LINE-K                    PIC 99 VALUE 0.
005400 77  LEVEL-1-K                 PIC 9(4) VALUE 0.
005500 77  LEVEL-2-K                 PIC 9(4) VALUE 0.
005600 77  LEVEL-3-K                 PIC 9(4) VALUE 0.
005700 77  SCREEN1-READ-SW           PIC X VALUE "N".
005900 01  DBPARAMETERS.            COPY DBPARMS OF COPYLIB.
006900 01  EQUIP-HIER-BUFFER.
007000     05  HIER-KEY.
007100         10  EQP-TYPE-BUF      PIC X(8).
007200         10  FATHER-SUB-BUF.
007300             15  FATH-4-BUF    PIC X(4).
007400             15  FILLER        PIC XX VALUE SPACES.
007500     05  HIER-DISP-CODE.
007600         10  SON-SUB-BUF.
007700             15  SON-4-BUF     PIC X(4).
007800             15  FILLER        PIC XX VALUE SPACES.
007900     05  SUB-ASSY-NAME         PIC X(50).
008000 01  ERROR-TABLE.
008100     05  ERR-TAB OCCURS 5000 TIMES           PIC X(4).
008200 01  ERR-BUFF-97.
008300     05  FILLER    PIC X(20) VALUE "SUBASSEMBLY NUMBER  ".
008400     05  SUBNUM-97 PIC X(4).
008500     05  FILLER    PIC X(12) VALUE "  IS INVALID".
008600     05  FILLER    PIC X(44) VALUE SPACES.
       01  FILE-STATUS.
           05  FILE-STATUS-1         PIC X.
           05  FILE-STATUS-2         PIC X.
008800 01  HIER-TEST-LIST.
008900     05  FILLER    PIC X(9)  VALUE "HIER-KEY,".
009000     05  FILLER    PIC X(15) VALUE "HIER-DISP-CODE,".
009100     05  FILLER    PIC X(15) VALUE "HIER-SUBS-NAME;".
009200 01  LEVEL1-FATHER             PIC X(4) VALUE SPACES.
009300 01  LEVEL2-FATHER             PIC X(4) VALUE SPACES.
009400 01  LEVEL3-FATHER             PIC X(4) VALUE SPACES.
       COPY OVRPFDATA IN COPYLIB.
009500 01  SUBNUM-COMPARE            PIC X(4).
009600 01  SUB-SAVE.
009700     05  SUB1-SAVE             PIC X.
009800     05  SUB2-SAVE             PIC X.
009900     05  SUB3-SAVE             PIC X.
010000     05  SUB4-SAVE             PIC X.
010700 COPY DBSTAT   OF COPYLIB.
010800 PROCEDURE DIVISION.
010900 BEGIN-PGM.
           OPEN I-O    CC-LINK-FILE.
           OPEN I-O    DRAWING-FILE.
           OPEN INPUT  DRWFIL.
           OPEN INPUT  EQPOPS.
           OPEN INPUT  EQPREF.
           OPEN INPUT  EQPREM.
           OPEN I-O    EQUIP-OPERATIONS.
           OPEN I-O    EQUIP-REF.
           OPEN I-O    EQUIP-REMARKS.
           OPEN INPUT  RET-FILE.
           OPEN INPUT  SPAREP,
           OPEN INPUT  TYPOPS.
           OPEN INPUT  TYPREF.
           OPEN INPUT  TYPREM.
           OPEN I-O    TYPE-OPERATIONS.
           OPEN I-O    TYPE-REF.
           OPEN I-O    TYPE-REMARKS.
           OPEN I-O    WO-EQUIP-HIER.
011000     PERFORM 9-WRITE-RECORDS.
011100     IF ERROR-SW = "Y"
011200         MOVE 1 TO ERROR-SUB
               PERFORM 996-OVERRIDE-PRINT-FILE
012700         OPEN OUTPUT PRINT-FILE
011400         PERFORM 101-WRITE-ERRORS THRU 101-WE-EXIT
011500                UNTIL ALL-ERRORS-WRITTEN-SW = "Y"
014400         CLOSE PRINT-FILE.
011700 2-EOJ.
           CLOSE CC-LINK-FILE.
           CLOSE DRAWING-FILE.
           CLOSE DRWFIL.
           CLOSE EQPOPS.
           CLOSE EQPREF.
           CLOSE EQPREM.
           CLOSE EQUIP-OPERATIONS.
           CLOSE EQUIP-REF.
           CLOSE EQUIP-REMARKS.
           CLOSE RET-FILE.
           CLOSE SPAREP.
           CLOSE TYPOPS.
           CLOSE TYPREF.
           CLOSE TYPREM.
           CLOSE TYPE-OPERATIONS.
           CLOSE TYPE-REF.
           CLOSE TYPE-REMARKS.
           CLOSE WO-EQUIP-HIER.
011900     DISPLAY "HIERARCHY ENTRIES READ    = " SUBSYS-READ.
012000     DISPLAY "HIERARCHY ENTRIES WRITTEN = " SUBSYS-WRITTEN.
           IF EQPREF-READ > 0  OR TYPREF-READ > 0
               DISPLAY "EQPREF    ENTRIES READ    = " EQPREF-READ
               DISPLAY "EQPREF    ENTRIES WRITTEN = " EQPREF-WRITTEN
               DISPLAY "EQPREM    ENTRIES READ    = " EQPREM-READ
               DISPLAY "EQPREM    ENTRIES WRITTEN = " EQPREM-WRITTEN
               DISPLAY "EQPOPS    ENTRIES READ    = " EQPOPS-READ
               DISPLAY "EQPOPS    ENTRIES WRITTEN = " EQPOPS-WRITTEN
               DISPLAY "TYPREF    ENTRIES READ    = " TYPREF-READ
               DISPLAY "TYPREF    ENTRIES WRITTEN = " TYPREF-WRITTEN
               DISPLAY "TYPREM    ENTRIES READ    = " TYPREM-READ
               DISPLAY "TYPREM    ENTRIES WRITTEN = " TYPREM-WRITTEN
               DISPLAY "TYPOPS    ENTRIES READ    = " TYPOPS-READ
               DISPLAY "TYPOPS    ENTRIES WRITTEN = " TYPOPS-WRITTEN.
           IF SPAREP-READ > 0
               DISPLAY "SPAREP    ENTRIES READ    = " SPAREP-READ
               DISPLAY "SPAREP    ENTRIES WRITTEN = " SPAREP-WRITTEN.
           IF DRWFIL-READ > 0
               DISPLAY "DRWFIL    ENTRIES READ    = " DRWFIL-READ
               DISPLAY "DRWFIL    ENTRIES WRITTEN = " DRWFIL-WRITTEN.
012100     GOBACK.

013100 101-WRITE-ERRORS.
013200     MOVE ERR-TAB (ERROR-SUB) TO SUBNUM-97.
013300     WRITE PRT-REC FROM ERR-BUFF-97 AFTER ADVANCING 1 LINES.
013400     ADD 1 TO ERROR-SUB.
013500     IF ERR-TAB (ERROR-SUB) = SPACES
013600         MOVE "Y" TO ALL-ERRORS-WRITTEN-SW.
013700 101-WE-EXIT.    EXIT.
014700
       COPY OVRPFCALL IN COPYLIB.

014800 9-WRITE-RECORDS.
014900     PERFORM 91-HOUSEKEEPING THRU 91-H-EXIT.
015000     PERFORM 92-WRITE-RECORDS THRU 92-WR-EXIT UNTIL
015100         ALL-RECORDS-WRITTEN-SW = "Y".
           PERFORM 93-PROCESS-SPARE-PARTS THRU 93-PSP-X.
           PERFORM 94-PROCESS-EQPREF-DATA THRU 94-PED-X.
           PERFORM 95-PROCESS-DRWFIL-DATA THRU 95-PDD-X.

015300 91-HOUSEKEEPING.
015400     MOVE SPACES TO SUBNUM-COMPARE ERROR-TABLE.
015500     MOVE LOW-VALUES TO STATUS-AREA.
017000     PERFORM 920-READ-FILE THRU 920-RF-EXIT.
017100 91-H-EXIT.    EXIT.
017300
019600 92-WRITE-RECORDS.
019700     IF SUBNUM-SORT NOT NUMERIC
019800         PERFORM 922-WRITE-ERROR THRU 922-WE-EXIT
019900         PERFORM 920-READ-FILE THRU 920-RF-EXIT
020000         GO TO 92-WR-EXIT.
020100     IF SUBNUM-SORT-9 < 1000
020200         PERFORM 922-WRITE-ERROR THRU 922-WE-EXIT
020300         PERFORM 920-READ-FILE THRU 920-RF-EXIT
020400         GO TO 92-WR-EXIT.
020500     MOVE SUBNUM-SORT TO SUB-SAVE.
020600     IF SUBNUM-4-S-9 > 0
020700         IF SUBNUM-3-S-9 = 0
020800             PERFORM 922-WRITE-ERROR THRU 922-WE-EXIT
020900             PERFORM 920-READ-FILE THRU 920-RF-EXIT
021000             GO TO 92-WR-EXIT
021100         ELSE
021200         MOVE "0" TO SUB4-SAVE
021300         IF SUB-SAVE = LEVEL3-FATHER
021400             NEXT SENTENCE
021500         ELSE
021600         PERFORM 922-WRITE-ERROR THRU 922-WE-EXIT
021700         PERFORM 920-READ-FILE THRU 920-RF-EXIT
021800         GO TO 92-WR-EXIT
021900     ELSE
022000     IF SUBNUM-3-S-9 > 0
022100         IF SUBNUM-2-S-9 = 0
022200             PERFORM 922-WRITE-ERROR THRU 922-WE-EXIT
022300             PERFORM 920-READ-FILE THRU 920-RF-EXIT
022400             GO TO 92-WR-EXIT
022500         ELSE
022600         MOVE "0" TO SUB3-SAVE
022700         IF SUB-SAVE = LEVEL2-FATHER
022800             MOVE SUBNUM-SORT TO LEVEL3-FATHER
022900         ELSE
023000         PERFORM 922-WRITE-ERROR THRU 922-WE-EXIT
023100         PERFORM 920-READ-FILE THRU 920-RF-EXIT
023200         GO TO 92-WR-EXIT
023300     ELSE
023400     IF SUBNUM-2-S-9 > 0
023500         MOVE "0" TO SUB2-SAVE
023600         IF SUB-SAVE = LEVEL1-FATHER
023700             MOVE SUBNUM-SORT TO LEVEL2-FATHER
023800         ELSE
023900         PERFORM 922-WRITE-ERROR THRU 922-WE-EXIT
024000         PERFORM 920-READ-FILE THRU 920-RF-EXIT
024100         GO TO 92-WR-EXIT
024200     ELSE
024300     MOVE "0" TO SUB1-SAVE
024400     MOVE SUBNUM-SORT TO LEVEL1-FATHER.
024500     MOVE SUB-SAVE TO FATH-4-BUF.
024600     MOVE SUBNUM-SORT TO SON-4-BUF.
024700     MOVE SUBNAME-SORT TO SUB-ASSY-NAME.
024900     PERFORM 921-PUT-ENTRIES THRU 921-PE-EXIT.
025000     PERFORM 920-READ-FILE THRU 920-RF-EXIT.
025100 92-WR-EXIT.    EXIT.
025200
017400 920-READ-FILE.
017600     READ RET-FILE AT END
017700         MOVE "Y" TO ALL-RECORDS-WRITTEN-SW
017900         GO TO 920-RF-EXIT.
018000     ADD 1 TO SUBSYS-READ.
018100     MOVE SUBTYP-SORT TO EQP-TYPE-BUF.
018200     IF SUBNUM-4-S = SPACE
018300         MOVE "0" TO SUBNUM-4-S.
018400     IF SUBNUM-3-S = SPACE
018500         MOVE "0" TO SUBNUM-3-S.
018600     IF SUBNUM-2-S = SPACE
018700         MOVE "0" TO SUBNUM-2-S.
018800     IF SUBNUM-SORT = SUBNUM-COMPARE
018900         PERFORM 922-WRITE-ERROR THRU 922-WE-EXIT
019000         GO TO 920-READ-FILE
019100     ELSE
019200     MOVE SUBNUM-SORT TO SUBNUM-COMPARE.
019300 920-RF-EXIT.    EXIT.

026200 921-PUT-ENTRIES.
           WRITE WEHREC FROM EQUIP-HIER-BUFFER
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF FILE-STATUS NOT = "00" MOVE 17 TO COND-WORD.
026600     IF COND-WORD NOT = 0
026700        MOVE SPACES TO PRT-REC
026800        MOVE "ERROR IN DBPUT PARA 97 PGM TLODSUBS" TO PRT-REC
026900        WRITE PRT-REC AFTER ADVANCING 1 LINES
027200        GO TO 2-EOJ.
027300     ADD 1 TO SUBSYS-WRITTEN.
027600 921-PE-EXIT.    EXIT.

025300 922-WRITE-ERROR.
025400     ADD 1 TO ERROR-SUB.
025500     MOVE SUBNUM-SORT TO ERR-TAB (ERROR-SUB).
025600     MOVE "Y" TO ERROR-SW.
025700 922-WE-EXIT.    EXIT.

       93-PROCESS-SPARE-PARTS.
           READ SPAREP AT END GO TO 93-PSP-X.
           ADD 1 TO SPAREP-READ.
           MOVE SPAREP-REC TO CC-LINK-REC.
           WRITE CC-LINK-REC.
           ADD 1 TO SPAREP-WRITTEN.
           GO TO 93-PROCESS-SPARE-PARTS.
       93-PSP-X.    EXIT.

       94-PROCESS-EQPREF-DATA.
           PERFORM 941-PROCESS-EQPREF-FILE THRU 941-PEF-X.
           PERFORM 942-PROCESS-EQPREM-FILE THRU 942-PEF-X.
           PERFORM 943-PROCESS-EQPOPS-FILE THRU 943-PEF-X.
           PERFORM 944-PROCESS-TYPREF-FILE THRU 944-PTF-X.
           PERFORM 945-PROCESS-TYPREM-FILE THRU 945-PTF-X.
           PERFORM 946-PROCESS-TYPOPS-FILE THRU 946-PTF-X.
       94-PED-X.    EXIT.

       941-PROCESS-EQPREF-FILE.
           READ EQPREF AT END GO TO 941-PEF-X.
           ADD 1 TO EQPREF-READ.
           MOVE EQPREF-REC TO EQUIP-REF-REC.
           WRITE EQUIP-REF-REC.
           ADD 1 TO EQPREF-WRITTEN.
           GO TO 941-PROCESS-EQPREF-FILE.
       941-PEF-X.    EXIT.

       942-PROCESS-EQPREM-FILE.
           READ EQPREM AT END GO TO 942-PEF-X.
           ADD 1 TO EQPREM-READ.
           MOVE EQPREM-REC TO EQUIP-REMARKS-REC.
           WRITE EQUIP-REMARKS-REC.
           ADD 1 TO EQPREM-WRITTEN.
           GO TO 942-PROCESS-EQPREM-FILE.
       942-PEF-X.    EXIT.

       943-PROCESS-EQPOPS-FILE.
           READ EQPOPS AT END GO TO 943-PEF-X.
           ADD 1 TO EQPOPS-READ.
           MOVE EQPOPS-REC TO EQUIP-OPERATIONS-REC.
           WRITE EQUIP-OPERATIONS-REC.
           ADD 1 TO EQPOPS-WRITTEN.
           GO TO 943-PROCESS-EQPOPS-FILE.
       943-PEF-X.    EXIT.

       944-PROCESS-TYPREF-FILE.
           READ TYPREF AT END GO TO 944-PTF-X.
           ADD 1 TO TYPREF-READ.
           MOVE TYPREF-REC TO TYPE-REF-REC.
           WRITE TYPE-REF-REC.
           ADD 1 TO TYPREF-WRITTEN.
           GO TO 944-PROCESS-TYPREF-FILE.
       944-PTF-X.    EXIT.

       945-PROCESS-TYPREM-FILE.
           READ TYPREM AT END GO TO 945-PTF-X.
           ADD 1 TO TYPREM-READ.
           MOVE TYPREM-REC TO TYPE-REMARKS-REC.
           WRITE TYPE-REMARKS-REC.
           ADD 1 TO TYPREM-WRITTEN.
           GO TO 945-PROCESS-TYPREM-FILE.
       945-PTF-X.    EXIT.

       946-PROCESS-TYPOPS-FILE.
           READ TYPOPS AT END GO TO 946-PTF-X.
           ADD 1 TO TYPOPS-READ.
           MOVE TYPOPS-REC TO TYPE-OPERATIONS-REC.
           WRITE TYPE-OPERATIONS-REC.
           ADD 1 TO TYPOPS-WRITTEN.
           GO TO 946-PROCESS-TYPOPS-FILE.
       946-PTF-X.    EXIT.

       95-PROCESS-DRWFIL-DATA.
           READ DRWFIL AT END GO TO 95-PDD-X.
           ADD 1 TO DRWFIL-READ.
           MOVE DRWFIL-REC TO DRAWING-FILE-REC.
           WRITE DRAWING-FILE-REC.
           ADD 1 TO DRWFIL-WRITTEN.
           GO TO 95-PROCESS-DRWFIL-DATA.
       95-PDD-X.    EXIT.
