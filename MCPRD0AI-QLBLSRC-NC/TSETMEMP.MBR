000200 IDENTIFICATION DIVISION.
000300 PROGRAM-ID.          TSETMEMP.
000400 AUTHOR.              JIM COFFMAN.
000500 DATE-WRITTEN.        05/21/94.
000600 DATE-COMPILED.
000700*INSTALLATION.        GOODYEAR TIRE AND RUBBER - AKRON.
000800*SECURITY.
000900*REMARKS.
001000*D   THIS PROGRAM WILL TAKE THE OLD 2 BUCKET FORMAT (TODAY + TOTAL)
001100*D   AND CONVERT IT TO THE NEW 3 BUCKET FORMAT (TODAY + WEEKLY
001200*D   + TOTAL) FOR DATASET MEMPL.
001700 ENVIRONMENT DIVISION.
001800 CONFIGURATION SECTION.
001900 SOURCE-COMPUTER.  AS400.
002000 OBJECT-COMPUTER.  AS400.
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT MEMPL
                  ASSIGN TO DATABASE-MCFPCS4200
                  ORGANIZATION IS SEQUENTIAL
                  ACCESS MODE IS SEQUENTIAL
                  FILE STATUS IS FILE-STATUS.
002200 DATA DIVISION.
       FILE SECTION.
       FD  MEMPL
           LABEL RECORDS ARE STANDARD.
       01  MEMPL-REC.
           COPY DDS-MCRPCS4200  OF MCFPCS4200.
002300 WORKING-STORAGE SECTION.
       01  BLOWUP-BASE                   PIC X(16).

       01  BUF-MEMPL-NEW.
           05  MEMPL-NEW-EMP-THRU-FLAGS  PIC X(22).
           05  MEMPL-NEW-TODAY           PIC 9(8).
           05  MEMPL-NEW-WEEKS           PIC 9(8).
           05  MEMPL-NEW-TOTAL           PIC 9(8).

       01  BUF-MEMPL-OLD.
           05  MEMPL-OLD-EMP-THRU-FLAGS  PIC X(22).
           05  MEMPL-OLD-TODAY           PIC 9(10).
           05  MEMPL-OLD-TODAY-X REDEFINES MEMPL-OLD-TODAY
                                         PIC X(10).
           05  MEMPL-OLD-TOTAL           PIC 9(10).
           05  MEMPL-OLD-TOTAL-X REDEFINES MEMPL-OLD-TOTAL
                                         PIC X(10).
           05  FILLER                    PIC X(4).

       COPY DBSTAT     IN COPYLIB.

       01  FILE-STATUS.
           05  FILE-STATUS-1             PIC X  VALUE "0".
           05  FILE-STATUS-2             PIC X  VALUE "0".

       COPY TBLOWUP    IN COPYLIB.

       COPY VCOMLINK   IN COPYLIB.

009400 PROCEDURE DIVISION.
       START-PGM.
           PERFORM 1-HSK.
           PERFORM 6-MAIN THRU 6-MAIN-X.

       2-EOJ.
           CLOSE MEMPL.
018900     GOBACK.
019000
076200 2-BLOWUP.
076300     MOVE "TSETMEMP" TO BU-PGM-NAME.
076400     CALL "TBLOWUP" USING BLOWUP-BASE BU-PGM-NAME STATUS-AREA
076500                      VIEW-COMAREA DUMMY-KSAM-STAT
076600                      BU-DISPLAY-MSG BU-DISPLAY-FLDS.

       1-HSK.
           OPEN I-O MEMPL.

       6-MAIN.
           MOVE 0 TO COND-WORD.
           READ MEMPL NEXT INTO BUF-MEMPL-OLD
               AT END    MOVE 11 TO COND-WORD.
           IF FILE-STATUS NOT = "00" MOVE 11 TO COND-WORD.
           IF COND-WORD = 11 GO TO 6-MAIN-X.
           IF MEMPL-OLD-TODAY-X = SPACES
               MOVE ZEROES TO MEMPL-OLD-TODAY.
           IF MEMPL-OLD-TOTAL-X = SPACES
               MOVE ZEROES TO MEMPL-OLD-TOTAL.
           MOVE MEMPL-OLD-EMP-THRU-FLAGS TO
                                   MEMPL-NEW-EMP-THRU-FLAGS.
           MOVE MEMPL-OLD-TODAY TO MEMPL-NEW-TODAY.
           MOVE ZEROES          TO MEMPL-NEW-WEEKS.
           MOVE MEMPL-OLD-TOTAL TO MEMPL-NEW-TOTAL.
           REWRITE MEMPL-REC FROM BUF-MEMPL-NEW.
           IF FILE-STATUS NOT = "00" MOVE 17 TO COND-WORD.
           IF COND-WORD NOT = 0
               MOVE "MEMPL REWRITE ERROR *TCLRMEMP*"
                   TO BU-DISPLAY-MSG
               PERFORM 2-BLOWUP.
           GO TO 6-MAIN.
       6-MAIN-X.    EXIT.
