283500*************************************************
283600**
283700**  THIS ROUTINE IS FOR BACKING OUT A PO IF THE
283800**  USER DECIDES AT THE ITEM SCREEN TO NOT ENTER
283900**  THE PO. THEY MUST DECIDE TO DO THIS BEFORE
284000**  ENTERING ANY ITEMS
284100**  THE BACKOUT ROUTINE INVOLVES THE FOLLOWING:
284200**   1) DELETE DPORECD AND MPORCV
284300**   2) BACK OUT LAST RELEASE IF THIS WAS A
284400**      NON-CODED RELEASE (SUBTRACT 1 FROM LAST RLSE
284500**      IN THE '999' ENTRY OF MPORCV)
284600**   3) IF THERE WAS A TEMPORARY VENDOR USED
284700**      DELETE IT
284800**
284900*************************************************
285000
285100
285200 66-BACKOUT-PO.
           MOVE 0 TO COND-WORD.
           MOVE PO-ARG TO PORCVNO OF DPORECD-REC-O.
           START DPORECD-O KEY = PORCVNO OF DPORECD-REC-O
               INVALID KEY MOVE 17 TO COND-WORD.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
                   MOVE 17 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.
287100*    CALL "DBFIND" USING BASE, DSET-DPORECD, MODE1,
287200*        STATUS-AREA, PO-SEARCH, PO-ARG.
287300     IF COND-WORD NOT = 0
287400         MOVE "FIND DPORECD *66-BD"  TO  BU-DISPLAY-MSG
287500         GO TO 2-BLOWUP.
287600
           MOVE 0 TO COND-WORD.
           READ DPORECD-O NEXT INTO BUF-DPORECD AT END
               MOVE 15 TO COND-WORD.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14"
                   MOVE 15 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.
           IF PORCVNO OF DPORECD-REC-O NOT = PO-ARG
               MOVE 15 TO COND-WORD.
287700*    CALL "DBGET" USING BASE, DSET-DPORECD, MODE5,
287800*        STATUS-AREA, ALL-ITEMS, BUF-DPORECD, PO-ARG.
287900     IF COND-WORD NOT = 0
288000         MOVE "GET DPORECD *63-BD"  TO  BU-DISPLAY-MSG
288100         GO TO 2-BLOWUP.
288200
           MOVE 0 TO COND-WORD.
           DELETE DPORECD-O INVALID KEY MOVE 99 TO COND-WORD.
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD.
288300*    CALL "DBDELETE" USING BASE, DSET-DPORECD, MODE1,
288400*        STATUS-AREA.
288500     IF COND-WORD NOT = 0
288600         MOVE "DELETE DPORECD *63-BD"  TO  BU-DISPLAY-MSG
288700         GO TO 2-BLOWUP.
288800
           MOVE 0 TO COND-WORD.
           MOVE PO-ARG TO PORCVNO OF MPORCV-REC-O.
           READ MPORCV-O INTO BUF-MPORCV
               INVALID KEY MOVE 17 TO COND-WORD.
           IF FILE-STATUS-1 = "2"
               MOVE 17 TO COND-WORD
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD.
288900*    CALL "DBGET" USING BASE, DSET-MPORCV, MODE7,
289000*        STATUS-AREA, ALL-ITEMS, BUF-MPORCV, PO-ARG.
289100     IF COND-WORD NOT = 0
289200         MOVE "GET MPORCV *63-BD"  TO  BU-DISPLAY-MSG
289300         GO TO 2-BLOWUP.
289400
           MOVE 0 TO COND-WORD.
           DELETE MPORCV-O INVALID KEY MOVE 99 TO COND-WORD.
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD.
289500*    CALL "DBDELETE" USING BASE, DSET-MPORCV, MODE1,
289600*        STATUS-AREA.
289700     IF COND-WORD NOT = 0
289800         MOVE "DELETE MPORCV *63-BD"  TO  BU-DISPLAY-MSG
289900         GO TO 2-BLOWUP.
