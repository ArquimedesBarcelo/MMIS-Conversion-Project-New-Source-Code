       63-EDIT-INVOICELESS.

           IF DE3-INVOICELESS-IND = " " OR "X"
               NEXT SENTENCE
           ELSE
      *M   "ONLY 'X' AND ' ' ARE VALID INPUTS"
           MOVE  41 TO LANG-SETNUM
           MOVE  29 TO LANG-MSGNUM
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
           MOVE MESSAGE-BUFFER TO DE3-MESSAGE-LINE
                                  DE3-MESSAGE-LINE-E
           MOVE  59 TO FIELD-NUMBER
           PERFORM 4-PGM-ERROR THRU 4-PGM-ERROR-X
           GO TO 63-SHOWFORM-SCREEN-3.

           IF DE3-INVOICELESS-IND = "X"
               IF SEDIVNCK-INVLESS-IND = "Y"
                   NEXT SENTENCE
               ELSE
      *M       "P.O. CANNOT BE INVOICELESS/VENDOR NOT"
               MOVE  16 TO LANG-SETNUM
               MOVE 153 TO LANG-MSGNUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER TO DE3-MESSAGE-LINE
                                      DE3-MESSAGE-LINE-E
               MOVE  59 TO FIELD-NUMBER
               PERFORM 4-PGM-ERROR THRU 4-PGM-ERROR-X
               GO TO 63-SHOWFORM-SCREEN-3.

           IF DE3-INVOICELESS-IND = "X"
               IF COMPANY-SAVE = "129"
                   IF NON-RECV-SW = "Y"
      *            "NON-RECEIVABLE PO CANNOT BE INVOICELESS"
                       MOVE  14 TO LANG-SETNUM
                       MOVE 128 TO LANG-MSGNUM
                       PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                       MOVE MESSAGE-BUFFER TO DE3-MESSAGE-LINE
                                              DE3-MESSAGE-LINE-E
                       MOVE  59 TO FIELD-NUMBER
                       PERFORM 4-PGM-ERROR THRU 4-PGM-ERROR-X
                       GO TO 63-SHOWFORM-SCREEN-3.

           IF DE3-INVOICELESS-IND = "X"
               IF ZBILL-PO
                   IF COMPANY-SAVE = "129"
      *            "MEMO Z-BILL PO CANNOT BE INVOICELESS"
                       MOVE  13 TO LANG-SETNUM
                       MOVE 066 TO LANG-MSGNUM
                       PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                       MOVE MESSAGE-BUFFER TO DE3-MESSAGE-LINE
                                              DE3-MESSAGE-LINE-E
                       MOVE  59 TO FIELD-NUMBER
                       PERFORM 4-PGM-ERROR THRU 4-PGM-ERROR-X
                       GO TO 63-SHOWFORM-SCREEN-3.

           IF DE3-INVOICELESS-IND = "X"
               IF NONPAY-PO-SW = "Y"
      *        "NON-PAYABLE PO CANNOT BE INVOICELESS"
                   MOVE  14 TO LANG-SETNUM
                   MOVE 136 TO LANG-MSGNUM
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE MESSAGE-BUFFER TO DE3-MESSAGE-LINE
                                          DE3-MESSAGE-LINE-E
                   MOVE  59 TO FIELD-NUMBER
                   PERFORM 4-PGM-ERROR THRU 4-PGM-ERROR-X
                   GO TO 63-SHOWFORM-SCREEN-3.
