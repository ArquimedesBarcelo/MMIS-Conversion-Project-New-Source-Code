190600 611-GET-DVENDOR.
           MOVE 0 TO COND-WORD.
           IF FILE-STATUS = "23"
               READ DVENDOR-O LAST RECORD INTO BUF-DVENDOR
                   AT END MOVE 14 TO COND-WORD
           ELSE
               READ DVENDOR-O PRIOR RECORD INTO BUF-DVENDOR
                   AT END MOVE 14 TO COND-WORD.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "1"
                   MOVE 14 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.
           IF VENCDE OF DVENDOR-REC-O NOT = VEN-ARG
               MOVE 14 TO COND-WORD.
