DCR02 *---------------------------------------------------------
DCR02      IF  Z000-POLG-ACTIVE-YES
DCR02          PERFORM Z001-SETUP-PO-LOGGING     THRU Z001-EXIT
DCR02          PERFORM Z120-RMV-ALL-USER-TRIGGER THRU Z120-EXIT
DCR02      END-IF.
DCR02 *---------------------------------------------------------
DCR02
083200     PERFORM 6-MAIN THRU 6-M-X.
083300
083400     PERFORM 2-EOJ  THRU 2-EOJ-X.
083500
083600     GOBACK.
083700
083800 1-HSK.

           CALL "TESCSEQ" USING ESC-NAME.
           MOVE "ZPURORD"  TO  VIEW-CFNAME.
           OPEN INPUT MPORCV-I, DPORECD-I, MPLTINFO-I,
                      DVENDOR-I, MVALIDUM-I, MBUYER-I, DPORECDV-I.
           OPEN I-O   MPORCV-O, DPORECD-O, DVENDOR-O, DISPLAY-FILE.

           MOVE "N"          TO WS-EDI-INSTAL.
020300     MOVE "EDI "       TO PLT-ARG.
           MOVE 0            TO COND-WORD.
           READ MPLTINFO-I INTO BUF-MPLTINFO INVALID KEY
                MOVE 17 TO COND-WORD.
           IF FILE-STATUS-1 = "2"
               MOVE 17 TO COND-WORD.
           IF COND-WORD = 0
               IF EDI-INSTAL = "Y"
                   MOVE "Y"  TO WS-EDI-INSTAL.
           MOVE "N" TO SEDIVNCK-EDI-IND.


DCR02 *================================================================
DCR02 *  SEE IF PO LOGGING IS TURNED ON FOR THIS PLANT
DCR02 *================================================================
DCR02
DCR02      SET  Z000-POLG-ACTIVE-NO TO TRUE.
DCR02
DCR02      MOVE WS-Z000-POLG-KEY    TO WS-ZMPLT-KEY.
DCR02      PERFORM ZMPLT-GET-MPLTINFO      THRU ZMPLT-EXIT.
DCR02      IF  WS-ZMPLT-PLTINFODTA(1:1) = "Y"
DCR02          SET  Z000-POLG-ACTIVE-YES TO TRUE
DCR02      END-IF.
DCR02 **------------------------------------------------------------


DCR02 *================================================================
DCR02 ** DETERMINE IF FOB CODES VALIDATE AGAINST FILE MCFPPOFOB
DCR02 *================================================================
DCR02
DCR02      SET  ZFOB-USE-DBFILE-NO TO TRUE.
DCR02
DCR02      MOVE WS-ZFOB-KEY         TO WS-ZMPLT-KEY.
DCR02      PERFORM ZMPLT-GET-MPLTINFO      THRU ZMPLT-EXIT.
DCR02      IF  WS-ZMPLT-PLTINFODTA(1:1) = "Y"
DCR02          SET  ZFOB-USE-DBFILE-YES  TO TRUE
DCR02      END-IF.
DCR02 **------------------------------------------------------------

088200*****************************************************
088400*   GET COMPANY CODE
088600*****************************************************
088700
088800     MOVE "P 01"         TO  PLT-ARG.
           MOVE 0 TO COND-WORD.
           MOVE PLT-ARG TO PLTINFOKEY OF MPLTINFO-REC-I.
           READ MPLTINFO-I INTO BUF-MPLTINFO INVALID KEY
                MOVE 17 TO COND-WORD.
           IF FILE-STATUS-1 = "2"
               MOVE 17 TO COND-WORD
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD.
088900*    CALL "DBGET" USING BASE, DSET-MPLTINFO, MODE7,
089000*        STATUS-AREA, ALL-ITEMS, BUF-MPLTINFO, PLT-ARG.
089100     IF COND-WORD NOT = ZERO
089200         MOVE "GET MPLTINFO 1-HSK"   TO  BU-DISPLAY-MSG
089300         MOVE PLT-ARG   TO  BU-DISPLAY-FLD (1)
089400         GO TO 2-BLOWUP.
089500     MOVE MPLTINFO-COMPANY  TO  COMPANY-SAVE,
089600                                SUB-COMPANY-SAVE,
089700                                ADD-ITEM-COMPANY-SAVE.
089800     MOVE MPLTINFO-PRIME    TO  SAVE-PRIME.
089900
090000     IF MPLTINFO-COMP-1-2 = "11"
090100         MOVE "1"                 TO  WHICH-PLANT.
090200
      *****************************************************
      *
      *   GET FRANCHISE INFORMATION
      *
      *****************************************************

           MOVE "FRAN"                   TO  PLT-ARG.
           MOVE 0 TO COND-WORD.
           MOVE PLT-ARG TO PLTINFOKEY OF MPLTINFO-REC-I.
           READ MPLTINFO-I INTO BUF-MPLTINFO INVALID KEY
                MOVE 17 TO COND-WORD.
           IF FILE-STATUS NOT = "00"
               MOVE SPACES               TO  FRAN-TABLE
           ELSE
               MOVE MPLTINFO-FRANCHISES  TO  FRAN-TABLE.

090300********************************************
090400*
090500*   GET RECEIVING DEPARTMENT
090600*
090700********************************************
090800
090900     MOVE "P 03"         TO  PLT-ARG.
           MOVE 0 TO COND-WORD.
           MOVE PLT-ARG TO PLTINFOKEY OF MPLTINFO-REC-I.
           READ MPLTINFO-I INTO BUF-MPLTINFO INVALID KEY
                MOVE 17 TO COND-WORD.
           IF FILE-STATUS-1 = "2"
               MOVE 17 TO COND-WORD
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD.
091000*    CALL "DBGET" USING BASE, DSET-MPLTINFO, MODE7,
091100*        STATUS-AREA, ALL-ITEMS, BUF-MPLTINFO, PLT-ARG.
091200     IF COND-WORD NOT = ZERO
091300         IF COND-WORD = 17
091400             MOVE SPACES  TO  SAVE-RCV-DEPT
091500         ELSE
091600             MOVE "GET MPLTINFO 'P 03'*1HSK" TO BU-DISPLAY-MSG
091700             MOVE PLT-ARG  TO  BU-DISPLAY-FLD (1)
091800             GO TO 2-BLOWUP
091900     ELSE
092000         MOVE MPLTINFO-RECV-DEPT   TO  SAVE-RCV-DEPT.
092100
092200**********************************************
092300*  GET THE INDICATOR THAT DENOTES IF THE PLANT
092400*  IS USING CSIS INVOICE PROCESSING SOFTWARE
092500**********************************************
092600
092700     MOVE "PODL"       TO PLT-ARG.
           MOVE 0 TO COND-WORD.
           MOVE PLT-ARG TO PLTINFOKEY OF MPLTINFO-REC-I.
           READ MPLTINFO-I INTO BUF-MPLTINFO INVALID KEY
                MOVE 17 TO COND-WORD.
           IF FILE-STATUS-1 = "2"
               MOVE 17 TO COND-WORD
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD.
092800*    CALL "DBGET" USING BASE, DSET-MPLTINFO, MODE7,
092900*        STATUS-AREA, ALL-ITEMS, BUF-MPLTINFO, PLT-ARG.
093000     IF COND-WORD NOT = 0
093100         IF COND-WORD = 17
093200             MOVE SPACES TO ADD-INVOICE-INDIC-SW
093300         ELSE
093400             MOVE "GET MPLTINFO 'PODL' *1-HSK" TO BU-DISPLAY-MSG
093500             MOVE PLT-ARG             TO BU-DISPLAY-FLD (1)
093600             GO TO 2-BLOWUP
093700     ELSE
093800         MOVE MPLTINFO-INVOICE-IND  TO  ADD-INVOICE-INDIC-SW.

092200**********************************************
092300*  FIND OUT IF THE USER IS USING ISO 9000
092400*  REVIEW OF PURCHASE ORDER PRIOR TO THEIR
      *  BEING PRINTED/FAXED
092500**********************************************
092600
092700     MOVE "ISO "       TO PLT-ARG.
           MOVE 0 TO COND-WORD.
           MOVE PLT-ARG TO PLTINFOKEY OF MPLTINFO-REC-I.
           READ MPLTINFO-I INTO BUF-MPLTINFO INVALID KEY
                MOVE 17 TO COND-WORD.
           IF FILE-STATUS-1 = "2"
               MOVE 17 TO COND-WORD
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD.
093000     IF COND-WORD NOT = 0
093100         IF COND-WORD = 17
093200             MOVE SPACES TO ISO-9000-PRINT-SW
093300         ELSE
093400         MOVE "GET MPLTINFO 'IS0 ' *1-HSK" TO BU-DISPLAY-MSG
093500         MOVE PLT-ARG             TO BU-DISPLAY-FLD (1)
093600         GO TO 2-BLOWUP
093700     ELSE
093800     MOVE ISO-9000-ON-OFF       TO  ISO-9000-PRINT-SW.
093900
093900
094000********************************************
094100*
094200*   GET PO PRINTER NUMBER
094300*
094400********************************************
094500
094600     MOVE SPACES                  TO  PO-PRINT-PARMS,
094700                                      INTERNAL-ORDER-PARMS.
094800     MOVE 9                       TO  PASSED-PO-PRINT-NUM.
094900     MOVE "POPT"         TO  PLT-ARG.
           MOVE 0 TO COND-WORD.
           MOVE PLT-ARG TO PLTINFOKEY OF MPLTINFO-REC-I.
           READ MPLTINFO-I INTO BUF-MPLTINFO INVALID KEY
                MOVE 17 TO COND-WORD.
           IF FILE-STATUS-1 = "2"
               MOVE 17 TO COND-WORD
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD.
095000*    CALL "DBGET" USING BASE, DSET-MPLTINFO, MODE7,
095100*        STATUS-AREA, ALL-ITEMS, BUF-MPLTINFO, PLT-ARG.
095200     IF COND-WORD NOT = ZERO
095300         MOVE "GET MPLTINFO 'POPT'*1HSK" TO BU-DISPLAY-MSG
095400         MOVE PLT-ARG  TO  BU-DISPLAY-FLD (1)
095500         GO TO 2-BLOWUP
095600     ELSE
095700         MOVE MPLTINFO-PO-PRT-NO     TO  PASSED-PO-PRINT-NUM
095800         MOVE MPLTINFO-INTERN-PRT-1  TO  INTERNAL-ORDER-PRT-NO-1
095900         MOVE MPLTINFO-INTERN-PRT-2  TO  INTERNAL-ORDER-PRT-NO-2
096000         MOVE MPLTINFO-BUYER-REDISPLAY-SW
096100                                     TO  BUYER-INFO-REDISPLAY-SW
096200         MOVE MPLTINFO-CUR-CODE-REQUIRED-SW
096300                                     TO  CUR-CODE-REQUIRED-SW
096400         MOVE MPLTINFO-MATCONT-COMP-PO-SW
096500                                     TO  MATCONT-PO-COMPLETE-SW
096600         MOVE MPLTINFO-PO-COMPARE-PRICE-SW
096700                                     TO  ADD-PO-COMPARE-PERCENT-SW
096800         MOVE MPLTINFO-PO-COMPARE-PERCENT
096900                                     TO  ADD-PO-COMPARE-PERCENT
               MOVE MPLTINFO-ADDTL-DATA-EDIT-SW
097000                                     TO  ADD-EDIT-ADDTL-DATA-SW
               MOVE MPLTINFO-NOASCII-REPORTS
                                           TO  SAVE-NOASCII-REPORTS.
097100
097200********************************************
097300*
097400*  GET LOCAL PRINTER NUMBER FOR SCREEN
097500*  PRINTS AND LOCAL PO PRINTOUTS.
097600*
097700********************************************
097800
           MOVE ZEROS  TO SP-SPOOL-NO (1).
097900     CALL "TSPLPRT" USING SP-RET-CODE, SP-AREA.
098000     IF SP-RET-CODE NOT = "00"
098100         IF SP-RET-CODE = "23"
098200             MOVE "NO SPOOLER # * 1-HSK"  TO BU-DISPLAY-MSG
098300             MOVE SP-RET-CODE             TO BU-DISPLAY-FLD9 (1)
098400             GO TO 2-BLOWUP
098500         ELSE
098600             MOVE "READBYKEY SPOOLF * PS SUB" TO BU-DISPLAY-MSG
098700             MOVE SP-RET-CODE             TO BU-DISPLAY-FLD9 (1)
098800             GO TO 2-BLOWUP
098900     ELSE
099000         MOVE "Y"              TO  SPOOLFIL-OPEN-SW
099100         MOVE SP-SPOOL-NO (1)  TO  PASSED-SPOOL-PRT.
099200
099300     CALL "WHO" USING MOD CAP LATTR
099400           USERNAME GRPNAME ACCTNAME HOMEGRP TNUM.
099500
099600     IF HOMEGRP = "DBT" OR
099700         AKRON-PLANTS
099800         MOVE PASSED-SPOOL-PRT  TO  PASSED-PO-PRINT-NUM.

100000*******************************************************
100100**   SET PRICE JCW TO 1 SO PRICE PRINTS ON PO REPRINTS
100200**   THE PRICE JCW IS LOCATED IN POSITION 258
100600*******************************************************
100700
100800     MOVE "1"      TO SETJCW-VALUE.
           MOVE 258      TO SETJCW-STARTING-POS.
           MOVE 1        TO SETJCW-LENGTH.
           CALL "SETJCW" USING SETJCW-VALUE,
                               SETJCW-STARTING-POS,
                               SETJCW-LENGTH,
                               SETJCW-STATUS.
           IF SETJCW-STATUS NOT = "00"
               MOVE "SETJCW ERROR" TO BU-DISPLAY-MSG
               MOVE SETJCW-STATUS TO BU-DISPLAY-FLD (1)
               GO TO 2-BLOWUP.

      *******************************************
      **  ACCEPT LOCAL DATA AREA FOR JCW-ITONLY
      *******************************************

           ACCEPT MC-LOCAL-DATA-AREA FROM LOCAL-DATA-AREA.
           IF JCW-ITONLY-257 = SPACES
               MOVE SPACES TO INTERNAL-ORDER-SW
           ELSE
               MOVE "Y"    TO INTERNAL-ORDER-SW.
102000
102100*******************************************************
102200**   IF THE INTERNAL ORDER PRINTER NO. FROM 'POPT' IN
102300**   MPLTINFO IS SPACES THEN USE THE SCREEN PRINT
102400**   PRINTER WHEN PRINTING INTERNAL ORDERS
102500*******************************************************
102600
102700     IF INTERNAL-ORDER-PRT-NO-1 = "00" OR "  "
102800         MOVE PASSED-SPOOL-PRT    TO  INTERNAL-ORDER-PRT-NO-1.
102900
103000 1-H-X.
103100     EXIT.
103200
103300 2-EOJ.
           CLOSE MPORCV-I, DPORECD-I, MPLTINFO-I, DPORECDV-I,
                 DVENDOR-I, MVALIDUM-I, MBUYER-I, DPORECDH-I.
           CLOSE MPORCV-O, DPORECD-O, DVENDOR-O, DISPLAY-FILE.
107100
107200 2-EOJ-X.
107300      EXIT.
107400
