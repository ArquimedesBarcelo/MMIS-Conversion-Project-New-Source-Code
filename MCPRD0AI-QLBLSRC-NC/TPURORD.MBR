           IF DE1-CURRENCY-CODE NOT NUMERIC
      *------ CURRENCY CODE MUST BE NUMERIC
               MOVE 44043 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER TO DE1-MESSAGE-LINE
               MOVE B"1" TO IND(51) IND(99)
               GO TO 61-SHOWFORM-SCREEN-1.

           IF DE1-RELEASE-INDIC = "X"
               IF DE1-BLANKET = "X"
      *-------- YOU CANNOT CHOOSE BOTH RELEASE AND REQUIREMENT INDIC
                   MOVE 44044 TO CATREAD-MSG-NUMBER
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE MESSAGE-BUFFER TO DE1-MESSAGE-LINE
                   MOVE B"1" TO IND(45) IND(99)
                   GO TO 61-SHOWFORM-SCREEN-1.

           IF DE1-NON-RECV-INDIC = "X"
               IF DE1-EXPIRATION-DATE = SPACES
      *-------- YOU MUST ENTER AN EXPIRATION DATE FOR A NON-RECV PO
                   MOVE 44080 TO CATREAD-MSG-NUMBER
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE MESSAGE-BUFFER TO DE1-MESSAGE-LINE
                   MOVE B"1" TO IND(46) IND(99)
                   GO TO 61-SHOWFORM-SCREEN-1.

           IF DE1-BLANKET = "X"
               IF DE1-EXPIRATION-DATE = SPACES
      *-------- YOU MUST ENTER AN EXPIRATION DATE FOR A REQUIREMENT
                   MOVE 44112 TO CATREAD-MSG-NUMBER
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE MESSAGE-BUFFER TO DE1-MESSAGE-LINE
                   MOVE B"1" TO IND(46) IND(99)
                   GO TO 61-SHOWFORM-SCREEN-1.

           IF DE1-EXPIRATION-DATE NOT = SPACES
               IF DE1-RELEASE-INDIC = "X" OR
                  DE1-INTERNAL-ORDER-INDIC = "X"
      *-------- EXPIRATION DATE ONLY VALID FOR NON-RECV OR REQUIREMENTS
                   MOVE 44113 TO CATREAD-MSG-NUMBER
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE MESSAGE-BUFFER TO DE1-MESSAGE-LINE
                   MOVE B"1" TO IND(46) IND(99)
                   GO TO 61-SHOWFORM-SCREEN-1.

           IF DE1-PROVINCE = SPACES
               NEXT SENTENCE
           ELSE
