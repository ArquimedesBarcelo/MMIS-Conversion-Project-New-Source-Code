276400 663-CHECK-FOR-PREFERRED-VENDOR.
           MOVE CODE-ARG TO CORPCDE OF DVENDITM-REC-I.
           START DVENDITM-I KEY = CORPCDE OF DVENDITM-REC-I
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
                   NEXT SENTENCE
               ELSE
276800             MOVE "DBFIND DVENDITM* 663-CPV"
276900                 TO BU-DISPLAY-MSG
277000             GO TO 2-BLOWUP.
277100
277200 663-GET-DVENDITM-PREFERRED.
           READ DVENDITM-I NEXT INTO BUF-DVENDITM
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   GO TO 663-CFPV-X
               ELSE
277900             MOVE "GET DVENDITM * 663-GDP" TO BU-DISPLAY-MSG
278000             GO TO 2-BLOWUP.
           IF CORPCDE OF DVENDITM-REC-I NOT = CODE-ARG
               GO TO 663-CFPV-X.

278100     IF VEN-TEMP-PREFIX  =  "T"
278200         GO TO 663-GET-DVENDITM-PREFERRED.
278300     IF VEN-OF-RCD  =  "S"
278400         MOVE "Y"  TO  VENDOR-SW
278500         MOVE VEN-ITM-VENCODE  TO  SAVE-PREFERRED-VENDOR
278600         MOVE "X"              TO  PRT-VEN-RCD
278700     ELSE
278800         GO TO 663-GET-DVENDITM-PREFERRED.
