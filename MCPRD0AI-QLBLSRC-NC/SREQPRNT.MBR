245800**************************************************
245900*                                                *
246000*   GET A VENDOR THAT SUPPLIES CODE FROM         *
246100*   DVENDITM. IF THE VENDOR CODE IS EQUAL TO     *
246200*   THE PREFERRED VENDOR THEN GET ANOTHER VENDOR *
246300*   SINCE THAT VENDOR WAS ALREAY WRITTEN ON THE  *
246400*   REQ FIRST                                    *
246500*                                                *
246600**************************************************
246700
246800 662-GET-DVENDITM.
246900     MOVE SPACES                  TO PRT-VEN-RCD.
247000     MOVE SPACES                  TO VENDOR-SW.
           IF READ-LAST-RCD-SW = "Y"
               READ DVENDITM-I LAST RECORD INTO BUF-DVENDITM
                   AT END MOVE FILE-STATUS TO FILE-STATUS
           ELSE
               READ DVENDITM-I PRIOR RECORD INTO BUF-DVENDITM
                   AT END MOVE FILE-STATUS TO FILE-STATUS.
           MOVE "N" TO READ-LAST-RCD-SW.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   MOVE SPACES        TO VENDOR-SW
                   GO 662-GD-X
               ELSE
247800             MOVE "GET DVENDITM *662-GD"  TO BU-DISPLAY-MSG
247900             GO TO 2-BLOWUP.
           IF CORPCDE OF DVENDITM-REC-I NOT = CODE-ARG
               MOVE SPACES            TO VENDOR-SW
               GO TO 662-GD-X.

248100     IF VEN-ITM-VENCODE  =  SAVE-PREFERRED-VENDOR  OR
248200        VEN-TEMP-PREFIX  =  "T"
248300         GO TO 662-GET-DVENDITM
248400     ELSE
248500         IF VEN-QUOTE-FLAG = "Q"
