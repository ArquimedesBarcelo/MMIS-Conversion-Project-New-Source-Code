233300*                                                *
233400**************************************************
233500
233600 661-WRITE-VENDOR-PRINT-LINE.
233700*    IF VENDOR-SW = "Y"
233800*        IF VEND-LINE-CTR > 50
233900*            MOVE SPACES          TO PO-VENDOR-SW
234000*            IF SAVE-PREFERRED-VENDOR = STR-LAST-VENDOR  OR
234100*               STR-LAST-VENDOR = SPACES
234200*                PERFORM 667-PRINT-VENDOR-LINES THRU
234300*                        667-PVL-X
234400*                PERFORM 662-GET-DVENDITM THRU 662-GD-X
234500*                IF VENDOR-SW = "Y"
234600*                    MOVE "Y" TO MORE-VEND-ON-FILE-SW
234700*                    MOVE SPACES  TO VENDOR-SW
234800*                    GO TO 661-WRITE-VENDOR-PRINT-LINE
234900*                ELSE
235000*                    NEXT SENTENCE
235100*            ELSE
235200*                MOVE SPACES      TO VENDOR-SW
235300*                PERFORM 666-CHECK-LAST-VENDOR  THRU 666-CLV-X
235400*                IF VENDOR-SW = "Y"
235500*                    PERFORM 666-FIND-LAST-PO-VEND
235600*                        THRU  666-GLPV-X
235700*                    MOVE LAST-PO-LIT TO PRT-LAST-PO-LIT
235800*                    MOVE 1 TO LINE-ADV
235900*                    PERFORM 65-PRINT-LINE
236000*                    PERFORM 667-PRINT-VENDOR-LINES  THRU
236100*                            667-PVL-X
236200*                    MOVE "Y"  TO MORE-VEND-ON-FILE-SW
236300*                    MOVE SPACES  TO VENDOR-SW
236400*                    GO TO 661-WRITE-VENDOR-PRINT-LINE
236500*                ELSE
236600*                    PERFORM 667-PRINT-VENDOR-LINES THRU
236700*                            667-PVL-X
236800*                    PERFORM 662-GET-DVENDITM THRU 662-GD-X
236900*                    IF VENDOR-SW = "Y"
237000*                        MOVE "Y" TO MORE-VEND-ON-FILE-SW
237100*                        MOVE SPACES  TO VENDOR-SW
237200*                        GO TO 661-WRITE-VENDOR-PRINT-LINE
237300*                    ELSE
237400*                        NEXT SENTENCE
237500*        ELSE
237600*            NEXT SENTENCE
237700*    ELSE
237800*        IF VEND-LINE-CTR = 0
237900*            IF MORE-VEND-ON-FILE-SW = "Y"
238000*                ADD 1            TO VEND-LINE-CTR
238100*                GO TO 661-WRITE-VENDOR-PRINT-LINE
238200*            ELSE
238300*            IF STR-LAST-VENDOR = SPACES
238400*                MOVE SPACES      TO PO-VENDOR-SW
238500*                MOVE NO-VENDOR-MSG          TO PRINT-LINE
238600*                WRITE PRINT-RCD BEFORE ADVANCING 2 LINES
238700*                ADD 2            TO VEND-LINE-CTR
238800*            ELSE
238900*                PERFORM 666-CHECK-LAST-VENDOR THRU 666-CLV-X
239000*                IF VENDOR-SW = "Y"
239100*                    PERFORM 666-FIND-LAST-PO-VEND  THRU
239200*                            666-GLPV-X
239300*                    MOVE LAST-PO-LIT TO PRT-LAST-PO-LIT
239400*                    MOVE 1 TO LINE-ADV
239500*                    PERFORM 65-PRINT-LINE
239600*                    PERFORM 667-PRINT-VENDOR-LINES  THRU
239700*                            667-PVL-X
239800*                    MOVE SPACES  TO VENDOR-SW
239900*                                    PO-VENDOR-SW
240000*                ELSE
240100*                    MOVE NO-VENDOR-MSG  TO  PRINT-LINE
240200*                    WRITE PRINT-RCD BEFORE ADVANCING 2 LINES
240300*                    ADD 2        TO VEND-LINE-CTR
240400*                    MOVE SPACES  TO PO-VENDOR-SW
240500*                                    VENDOR-SW
240600*        ELSE
240700*        IF PO-VENDOR-SW = "Y"
240800*            MOVE SPACES          TO PO-VENDOR-SW
240900*            IF STR-LAST-VENDOR = SPACES
241000*                GO TO 661-WRITE-VENDOR-PRINT-LINE
241100*            ELSE
241200*                PERFORM 666-CHECK-LAST-VENDOR THRU 666-CLV-X
241300*                IF VENDOR-SW = "Y"
241400*                    PERFORM 666-FIND-LAST-PO-VEND  THRU
241500*                            666-GLPV-X
241600*                    MOVE LAST-PO-LIT TO PRT-LAST-PO-LIT
241700*                    MOVE 1 TO LINE-ADV
241800*                    PERFORM 65-PRINT-LINE
241900*                    PERFORM 667-PRINT-VENDOR-LINES  THRU
242000*                            667-PVL-X
242100*                    MOVE SPACES  TO VENDOR-SW
242200*                    GO TO 661-WRITE-VENDOR-PRINT-LINE
242300*                ELSE
242400*                    GO TO 661-WRITE-VENDOR-PRINT-LINE
242500*        ELSE
242600*        IF MORE-VEND-ON-FILE-SW = "Y"
242700*            MOVE SPACES          TO MORE-VEND-ON-FILE-SW
242800*            MOVE MORE-THAN-3-VENDOR-MSG  TO PRINT-LINE1
      *            MOVE 2 TO LINE-ADV
      *            PERFORM 65-PRINT-LINE.
243000*
      *--------- SHOW ONLY 3 QUOTES PER REQ.
           IF VENDOR-SW = "Y"
               IF NUM-QUOTES-PRINTED < 3
243200             PERFORM 700-PRINT-QUOTE-LINES
243300             PERFORM 662-GET-DVENDITM  THRU  662-GD-X
243400             GO TO 661-WRITE-VENDOR-PRINT-LINE
               ELSE
                   MOVE "X"         TO  VENDOR-SW.

      *--------- SHOW "NO VENDOR" MESSAGE.
           IF NUM-QUOTES-PRINTED = 0
               MOVE NO-VENDOR-MSG   TO  PRINT-LINE
               WRITE PRINT-RCD BEFORE ADVANCING 1 LINE.

           MOVE ALL "-"             TO  DASH-LINE.
           WRITE PRINT-RCD FROM DASH-LINE BEFORE ADVANCING 1 LINE.

           IF VENDOR-SW = "X"
               MOVE MORE-THAN-3-VENDOR-MSG  TO PRINT-LINE1
               MOVE 2 TO LINE-ADV
               PERFORM 65-PRINT-LINE.

