311500*    WRITE PRINT-RCD FROM PRINT-VEN-LINE2 BEFORE
311600*        ADVANCING 1 LINES.
311700*    WRITE PRINT-RCD FROM PRINT-VEN-LINE3 BEFORE
311800*        ADVANCING 1 LINES.
311900*    ADD 3                        TO VEND-LINE-CTR,
312000*                                    LINE-CTR.
312100*    IF PRICE-BREAKS-SW = "Y"
312200*        WRITE PRINT-RCD FROM PRINT-VEN-LINE4 BEFORE
312300*            ADVANCING 1 LINES
312400*        WRITE PRINT-RCD FROM PRINT-VEN-LINE5 BEFORE
312500*            ADVANCING 1 LINES
312600*        WRITE PRINT-RCD FROM PRINT-VEN-LINE6 BEFORE
312700*            ADVANCING 1 LINES
312800*        ADD 3                    TO VEND-LINE-CTR,
312900*                                    LINE-CTR.
313000*    WRITE PRINT-RCD FROM PRINT-VEN-LINE7 BEFORE
313100*        ADVANCING 1 LINES.
      *--- IF THE REQUISITION IS FOR A CODED ITEM, WE NEED TO
      *--- RETRIEVE THE VENDOR RECORD TO MAKE SURE THAT IF FOB
      *--- AND DELIVERY TERMS ARE PRESENT, THEY ARE PRINTED
      *--- INSTEAD OF THE LAST P.O.'S TERMS FOR THAT VENDOR
      *    IF REQ-MAT-TYPE = "S"
      *        PERFORM 6670-CHECK-DVENDOR THRU 6670-CD-X.
313200*    WRITE PRINT-RCD FROM PRINT-VEN-LINE8 BEFORE
313300*        ADVANCING 1 LINES.
313400*    WRITE PRINT-RCD FROM PRINT-VEN-LINE9 BEFORE
313500*        ADVANCING 1 LINES.
313600*    ADD 3                        TO VEND-LINE-CTR,
313700*                                    LINE-CTR.
313800*    IF PRT-NOTE1 = SPACES
313900*        NEXT SENTENCE
314000*    ELSE
314100*        WRITE PRINT-RCD FROM PRINT-VEN-LINE10 BEFORE
314200*            ADVANCING 1 LINES
314300*        ADD 1                    TO VEND-LINE-CTR,
314400*                                    LINE-CTR.
314500*    IF PRT-NOTE2 = SPACES
314600*        NEXT SENTENCE
314700*    ELSE
314800*        WRITE PRINT-RCD FROM PRINT-VEN-LINE11 BEFORE
314900*            ADVANCING 1 LINES
315000*        ADD 1                    TO VEND-LINE-CTR,
315100*                                    LINE-CTR.
315200*    MOVE ALL "-"                 TO DASH-LINE.
315300*    WRITE PRINT-RCD FROM DASH-LINE BEFORE
315400*        ADVANCING 1 LINES.
315500*    MOVE SPACES                  TO PRINT-LINE1.
315600*    ADD 1                        TO VEND-LINE-CTR,
315700*                                    LINE-CTR.
315800*667-PVL-X.
315900*    EXIT.
316000*
      *6670-CHECK-DVENDOR.
      *    MOVE PRT-VENDOR TO VENCDE OF DVENDOR-REC-I.
      *    START DVENDOR-I KEY = VENCDE OF DVENDOR-REC-I
      *        INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
      *    IF FILE-STATUS NOT = "00"
      *        IF FILE-STATUS-1 = "2"
      *            NEXT SENTENCE
      *        ELSE
259800*        MOVE "DBFIND DVENDOR* 6670-LDI"  TO  BU-DISPLAY-MSG
259900*        MOVE VEN-ARG                  TO BU-DISPLAY-FLD (3)
260000*        GO TO 2-BLOWUP.
260300*6670-GET-DVENDOR.
      *    READ DVENDOR-I NEXT INTO BUF-DVENDOR
      *        AT END MOVE FILE-STATUS TO FILE-STATUS.
      *    IF FILE-STATUS NOT = "00"
      *        IF FILE-STATUS = "10" OR "14" OR "46"
      *            GO TO 6670-CD-X
      *        ELSE
261000*        MOVE "DBGET DVENDOR * 6670-GD"
261100*            TO BU-DISPLAY-MSG
261200*        MOVE VEN-ARG  TO  BU-DISPLAY-FLD (3)
261300*        GO TO 2-BLOWUP.
      *    IF VENCDE OF DVENDOR-REC-I NOT = VEN-ARG
      *        GO TO 6670-CD-X.
      *
      *    IF VEN-ITM-NO  = 16
      *        MOVE VEN-PO-FOB          TO  PRT-FOB
      *        MOVE VEN-PO-TERMS        TO  PRT-VEN-TERMS
      *        MOVE VEN-PO-TERMS-PCT    TO  BUILD-TM-DISCOUNT-VALUE
      *        MOVE VEN-PO-TERMS-DUE-DATE
      *                                 TO  BUILD-TM-DATE-VALUE
      *        PERFORM 663-GET-TERMS-DESC THRU 663-GTD-X.
264600*    GO TO 6670-GET-DVENDOR.
      *6670-CD-X.    EXIT.

       668A-FIND-VENDOR-ADDR.
           MOVE DREQD-VEN-CODE TO VENCDE OF DVENDOR-REC-I.
           START DVENDOR-I KEY = VENCDE OF DVENDOR-REC-I
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS = "00"
               PERFORM 668-GET-DVENDOR.
           IF FILE-STATUS = "00"
               IF VEN-ITM-NO = "00"
                   MOVE VEN-NAME        TO HOLD-VENDOR-OUT
                   PERFORM 668-GET-DVENDOR.
           IF FILE-STATUS = "00"
               MOVE VEN-ADDRESS         TO HOLD-VENDOR-ADDR1
               PERFORM 668-GET-DVENDOR.
           IF FILE-STATUS = "00"
               MOVE VEN-ADDRESS         TO HOLD-VENDOR-ADDR2.
               PERFORM 668-GET-DVENDOR
                   UNTIL VEN-ITM-NO >= "07" OR FILE-STATUS NOT = "00"
                         OR VEN-VEN-CODE NOT = DREQD-VEN-CODE.
           IF FILE-STATUS = "00" AND VEN-ITM-NO = "07"
                                 AND VEN-VEN-CODE = DREQD-VEN-CODE
               MOVE VEN-CITY            TO HOLD-ADDR3A
               MOVE VEN-ZIP             TO HOLD-ADDR3C
               IF VEN-STATE-CODE NOT = SPACES
                   MOVE VEN-STATE-CODE  TO HOLD-ADDR3B
               ELSE
                   MOVE VEN-PROV-CODE   TO HOLD-ADDR3B.

       668-GET-DVENDOR.
           READ DVENDOR-I NEXT INTO BUF-DVENDOR
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE SPACES       TO BUF-DVENDOR.

       668-GET-MBUYER.
           READ MBUYER-I INTO BUF-MBUYER
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE SPACES       TO BUF-MBUYER.

      *------- GET THE INFORMATION FOR "LAST VENDOR" QUOTE NUMBER AND
      *------- EXPIRATION DATE, AND LAST PO UNIT PRICE.
       700-FIND-LAST-QUOTE.
           MOVE CODE-ARG TO CORPCDE OF DVENDITM-REC-I.
           START DVENDITM-I KEY > CORPCDE OF DVENDITM-REC-I
      **** START DVENDITM-I KEY = CORPCDE OF DVENDITM-REC-I
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
                   NEXT SENTENCE
               ELSE
298900             MOVE "FIND LAST QUOTE * 700-FLQ"  TO  BU-DISPLAY-MSG
299000             GO TO 700-FLQ-X.
299100
299200 700-GET-LAST-PO-VEND.
           MOVE 0 TO COND-WORD.
      **** READ DVENDITM-I NEXT INTO BUF-DVENDITM
           READ DVENDITM-I PRIOR INTO BUF-DVENDITM
               AT END MOVE FILE-STATUS TO FILE-STATUS.
      **** IF FILE-STATUS NOT = "00"
      ****     IF FILE-STATUS = "10" OR "14" OR "46"
      ****         MOVE 15 TO COND-WORD
      ****     ELSE
      ****         MOVE 99 TO COND-WORD.
           IF CORPCDE OF DVENDITM-REC-I NOT = CODE-ARG
               MOVE 15 TO COND-WORD.
299500**** IF COND-WORD  NOT = 0
299500     IF FILE-STATUS NOT = "00"
300100         NEXT SENTENCE
300500     ELSE
300600         IF VEN-ITM-VENCODE  =  STR-LAST-VENDOR
300700             IF VEN-QUOTE-FLAG = "Q"
                       MOVE VEN-QUOTE-NUM    TO  LAST-QUOTE
                       IF VEN-ITM-PRICE-DATE NOT = SPACES
253700                     MOVE VEN-ITM-PRICE-DATE
                                             TO  DATE-VALIDATE-IN
253800                     CALL "TDATECHK" USING DATE-CHECK-AREA
253900                     MOVE DATE-SLASH-OUT
                                             TO  LAST-QUOTE-EXP-DATE
                       END-IF
                   ELSE
                       NEXT SENTENCE
302900     ELSE
303000         GO TO 700-GET-LAST-PO-VEND.
303100
303200 700-GET-DPORECD.
303300     MOVE STR-LAST-PO-RLSE             TO  PO-NUMBER.
303400     MOVE BUILD-PO-NUM                 TO  PO-ARG.
           MOVE PO-ARG TO PORCVNO OF DPORECD-REC-I.
           START DPORECD-I KEY = PORCVNO OF DPORECD-REC-I
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
303900             GO TO 700-FLQ-X
304000         ELSE
304100             MOVE "FIND DPORECD * 700-GD" TO BU-DISPLAY-MSG
304200             MOVE PO-ARG  TO  BU-DISPLAY-FLD (3)
304300             GO TO 2-BLOWUP.
           READ DPORECD-I NEXT INTO BUF-DPORECD
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14"
304800             GO TO 700-FLQ-X
               ELSE
305000             MOVE "GET DPORECD * 700-GD" TO BU-DISPLAY-MSG
305100             MOVE PO-ARG              TO BU-DISPLAY-FLD (3)
305200             GO TO 2-BLOWUP.
           IF PORCVNO OF DPORECD-REC-I NOT = PO-ARG
304800         GO TO 700-FLQ-X.
306200
           MOVE PO-ARG TO PORCVNO OF DPOITEMP-REC-I.
           START DPOITEMP-I KEY = PORCVNO OF DPOITEMP-REC-I
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
307500             GO TO 700-FLQ-X
               ELSE
306600             MOVE "FIND DPOITEM * 700-GD" TO BU-DISPLAY-MSG
306700             MOVE PO-ARG  TO  BU-DISPLAY-FLD (3)
306800             GO TO 2-BLOWUP.
306900
307000 700-GET-DPOITEM.
           READ DPOITEMP-I NEXT INTO BUF-DPOITEM
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14"
307500             GO TO 700-FLQ-X
               ELSE
307700             MOVE "GET DPOITEM * 700-GD" TO BU-DISPLAY-MSG
307800             MOVE PO-ARG  TO  BU-DISPLAY-FLD (3)
307900             GO TO 2-BLOWUP.
           IF PORCVNO OF DPOITEMP-REC-I NOT = PO-ARG
307500         GO TO 700-FLQ-X.
308000     IF ITM-CORP-CODE  =  CORP-CODE
308100         NEXT SENTENCE
308200     ELSE
308300         GO TO 700-GET-DPOITEM.
308400     MOVE ITM-UNIT-PRICE    TO  LAST-PO-PRICE.
308600
308700 700-FLQ-X.
308800     EXIT.

      *------- GET LAST VENDOR'S NAME & PHONE.
       700-FIND-LAST-VEND.
           MOVE SPACES                  TO  PRT-VEND-NAME-LAST
                                            PHONE-LIT-LAST
                                            PRT-PHONE-LAST
                                            PRINT-FAX-LINE.

       700-GET-DVENDOR.
           READ DVENDOR-I NEXT INTO BUF-DVENDOR
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46" OR "23"
                   GO TO 700-FLV-X
               ELSE
                   MOVE "DBGET DVENDOR * 700-GD"
                       TO BU-DISPLAY-MSG
                   MOVE VEN-ARG  TO  BU-DISPLAY-FLD (3)
                   GO TO 2-BLOWUP.
           IF VENCDE OF DVENDOR-REC-I NOT = VEN-ARG
               GO TO 700-FLV-X.

           IF VEN-ITM-NO  =  00
               MOVE VEN-NAME  TO  PRT-VEND-NAME-LAST
           ELSE
           IF VEN-ITM-NO  =  09
               MOVE VEN-CONTACT         TO  PRT-CONTACT
               IF VEN-CONTACT-PHONE  =  SPACES
                   NEXT SENTENCE
               ELSE
               MOVE PHONE-LIT           TO  PHONE-LIT-LAST
               IF VEN-PH2-TEST  =  SPACES
                   MOVE VEN-PH2-FIRST3  TO  PRT-PHONE-FIRST3-LAST
                   MOVE VEN-PH2-LAST4   TO  PRT-PHONE-LAST4-LAST
                   MOVE "-"             TO  PRT-PHONE-DASH2-LAST
               ELSE
               IF VEN-PH3-TEST  =  SPACES
                   MOVE VEN-PH3-FIRST3  TO  PRT-PHONE-FIRST3-LAST
                   MOVE VEN-PH3-LAST4   TO  PRT-PHONE-LAST4-LAST
                   MOVE "-"             TO  PRT-PHONE-DASH2-LAST
               ELSE
                   MOVE VEN-PH-AREA     TO  PRT-CONTACT-AREA-CODE-LAST
                   MOVE VEN-PH-FIRST3   TO  PRT-PHONE-FIRST3-LAST
                   MOVE VEN-PH-LAST4    TO  PRT-PHONE-LAST4-LAST
                   MOVE "-"             TO  PRT-PHONE-DASH1-LAST,
                                            PRT-PHONE-DASH2-LAST
           ELSE
           IF VEN-ITM-NO  =  10
               IF VEN-FAX > SPACES
                   MOVE VEN-FAX         TO  PRT-FAX-OUT-2.

           GO TO 700-GET-DVENDOR.

       700-FLV-X.
           EXIT.

       700-PRINT-QUOTE-LINES.
           WRITE PRINT-RCD FROM QUOTE-LINE-1 BEFORE
               ADVANCING 1 LINES.
           WRITE PRINT-RCD FROM QUOTE-LINE-2 BEFORE
               ADVANCING 1 LINES.
           WRITE PRINT-RCD FROM QUOTE-LINE-3 BEFORE
               ADVANCING 1 LINES.
           WRITE PRINT-RCD FROM QUOTE-LINE-4 BEFORE
               ADVANCING 1 LINES.
           ADD 1   TO  NUM-QUOTES-PRINTED.

       COPY OVRPFCALL IN COPYLIB.
316100
316200 999-CATREAD.
           IF CATREAD-MSG-NUMBER = ZEROS
               MOVE LANG-SETNUM TO CATREAD-MSG-SET
               MOVE LANG-MSGNUM TO CATREAD-MSG-NUM.
           CALL "CCATREAD" USING CATREAD-PARMS.
           MOVE CATREAD-MSG-TEXT TO MESSAGE-BUFFER.
317800 999-CATREAD-EXIT.
317900     EXIT.

