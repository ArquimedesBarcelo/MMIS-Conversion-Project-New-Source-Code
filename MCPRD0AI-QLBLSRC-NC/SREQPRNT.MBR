252100*                     PRT-NOTE1, PRT-NOTE2, PRT-CURRENCY-DESC,
      *                     PRT-FAX-LIT, FAX-OUT.
           MOVE SPACES  TO  PRT-QUOTE-NO, PRT-VENDOR, PRT-PRICE-UM,
                            EXP-DATE, EFF-DATE, PRT-VEN-TERMS,
                            PRT-FOB, PRT-PHONE, PHONE-LIT-2.
252200*    MOVE ZEROS  TO  PRT-EST-DLV-TIME, PRT-MIN-ORD.
           MOVE ZEROS  TO  PRT-QUOTE-PRICE, PRT-LT1, PRT-LT2, PRT-LT3.
252300     MOVE SPACES                  TO  PRICE-BREAKS-SW.
252400     MOVE VEN-ITM-VENCODE         TO  PRT-VENDOR, VEN-ARG.

      ********** 17JUL1997 REPLACED THE FOLLOWING 2 IF STATEMENTS
      *****IF VEN-DSCT = SPACES MOVE ZEROS TO VEN-DISCOUNT-PERCENT.
      *****IF VEN-DSCT = ZEROS  MOVE ZEROS TO VEN-DISCOUNT-PERCENT.
           IF VEN-DSCT IS NOT NUMERIC
               MOVE ZEROES TO VEN-DISCOUNT-PERCENT.

252500     IF VEN-DISCOUNT-PERCENT = ZEROS
252600         MOVE VEN-ITM-PRICE          TO PRT-QUOTE-PRICE
252700     ELSE
252800         COMPUTE DISCOUNT-PERCENT ROUNDED =
252900             VEN-DISCOUNT-PERCENT / 100
253000         COMPUTE DISCOUNT-PRICE ROUNDED = VEN-ITM-PRICE -
253100             (VEN-ITM-PRICE * DISCOUNT-PERCENT)
253200         MOVE DISCOUNT-PRICE          TO PRT-QUOTE-PRICE.
253300     MOVE VEN-ITM-PRICE-UM  TO  PRT-PRICE-UM.
253400     IF VEN-ITM-PRICE-DATE  =  SPACES
253500         MOVE SPACES  TO  EXP-DATE
253600     ELSE
               MOVE 4                   TO  DATE-MODE
253700         MOVE VEN-ITM-PRICE-DATE  TO  DATE-VALIDATE-IN
253800         CALL "TDATECHK" USING DATE-CHECK-AREA
253900         MOVE DATE-SLASH-OUT      TO  EXP-DATE.
254000     IF VEN-CREATE-DATE   =  SPACES
254100         MOVE SPACES  TO  EFF-DATE
254200     ELSE
               MOVE 4                   TO  DATE-MODE
254300         MOVE VEN-CREATE-DATE     TO  DATE-VALIDATE-IN
254400         CALL "TDATECHK" USING DATE-CHECK-AREA
254500         MOVE DATE-SLASH-OUT      TO  EFF-DATE.
254600     MOVE VEN-ITM-LT1             TO  PRT-LT1.
254700     MOVE VEN-ITM-LT2             TO  PRT-LT2.
254800     MOVE VEN-ITM-LT3             TO  PRT-LT3.
254900     MOVE VEN-REAL-QUOTE          TO  PRT-QUOTE-NO.
255000*    IF VEN-DISCOUNT-PERCENT = ZEROS
255100*        MOVE SPACES              TO  PRICE-DISC-LIT-OUT
255200*                                     PRICE-DISC-PERCENT-LIT
255300*        MOVE ZEROS               TO  PRT-PRICE-DISC
255400*    ELSE
255500*        MOVE PRICE-DISC-LIT      TO  PRICE-DISC-LIT-OUT
255600*        MOVE "%"                 TO  PRICE-DISC-PERCENT-LIT
255700*        MOVE VEN-DISCOUNT-PERCENT  TO PRT-PRICE-DISC.
      *    IF VEN-SURCHARGE-X = SPACES MOVE ZEROS TO VEN-SURCHARGE.
      *    IF VEN-SURCHARGE-X NOT NUMERIC
      *        MOVE ZEROS TO VEN-SURCHARGE.
255800*    IF VEN-SURCHARGE = ZEROS
255900*        MOVE SPACES              TO  SURCHARGE-LIT-OUT
256000*        MOVE ZEROS               TO  PRT-SURCHARGE
256100*    ELSE
256200*        MOVE SURCHARGE-LIT       TO  SURCHARGE-LIT-OUT
256300*        MOVE VEN-SURCHARGE       TO  PRT-SURCHARGE.
256400*    PERFORM 663-ZERO-OUT-QTY
256500*        VARYING DISC-SUB  FROM 1 BY 1 UNTIL DISC-SUB > 3.
256600*    PERFORM 663-LOAD-QTY-DISCOUNTS
256700*        VARYING DISC-SUB  FROM 1 BY 1 UNTIL DISC-SUB > 3.
256800     MOVE VEN-FOB             TO  PRT-FOB.
256900     IF VEN-TERMS  =  SPACES
257000         NEXT SENTENCE
257100     ELSE
257200         MOVE VEN-TERMS  TO  PRT-VEN-TERMS.
257300*        MOVE VEN-TERMS-PC  TO  BUILD-TM-DISCOUNT-VALUE.
257400*        MOVE VEN-TERMS-DTE TO  BUILD-TM-DATE-VALUE
257500*        PERFORM 663-GET-TERMS-DESC THRU 663-GTD-X.
257600*    IF VEN-EST-LT  =  ZEROS
257700*        NEXT SENTENCE
257800*    ELSE
257900*        MOVE DLV-TIME-LIT    TO  DLV-TIME-LIT-OUT
258000*        MOVE VEN-EST-LT      TO  PRT-EST-DLV-TIME.
258100
258200     PERFORM 662-LOAD-DVENDOR-INFO THRU 662-LDI-X.
258300
258400 662-GD-X.
258500     EXIT.
