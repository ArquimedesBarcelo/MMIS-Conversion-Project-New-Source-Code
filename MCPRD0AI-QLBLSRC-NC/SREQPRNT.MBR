258700**************************************************
258800*                                                *
258900*  THIS ROUTINE FIND VARIOUS VENDOR INFO FOUND   *
259000*  IN DVENDOR AND LOADS IT TO VENDOR PRINT RCDS  *
259100*                                                *
259200**************************************************
259300
259400 662-LOAD-DVENDOR-INFO.
           MOVE VEN-ARG TO VENCDE OF DVENDOR-REC-I.
           START DVENDOR-I KEY = VENCDE OF DVENDOR-REC-I
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
                   NEXT SENTENCE
               ELSE
259800             MOVE "DBFIND DVENDOR* 662-LDI"  TO  BU-DISPLAY-MSG
259900             MOVE VEN-ARG                  TO BU-DISPLAY-FLD (3)
260000             GO TO 2-BLOWUP.
260100     MOVE SPACES                  TO  PRT-VEND-NAME
                                            PRT-FAX-LIT
                                            FAX-OUT.
260200
260300 662-GET-DVENDOR.
           READ DVENDOR-I NEXT INTO BUF-DVENDOR
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   GO TO 662-LDI-X
               ELSE
261000             MOVE "DBGET DVENDOR * 662-GD"
261100                 TO BU-DISPLAY-MSG
261200             MOVE VEN-ARG  TO  BU-DISPLAY-FLD (3)
261300             GO TO 2-BLOWUP.
           IF VENCDE OF DVENDOR-REC-I NOT = VEN-ARG
               GO TO 662-LDI-X.

261400     IF VEN-ITM-NO  =  00
261500         MOVE VEN-NAME  TO  PRT-VEND-NAME
261600     ELSE
261700     IF VEN-ITM-NO  =  09
261800*        MOVE VEN-CONTACT  TO  PRT-CONTACT
261900         IF VEN-CONTACT-PHONE  =  SPACES
262000             NEXT SENTENCE
262100         ELSE
               MOVE PHONE-LIT           TO  PHONE-LIT-2
262200         IF VEN-PH2-TEST  =  SPACES
262300             MOVE VEN-PH2-FIRST3  TO  PRT-PHONE-FIRST3
262400             MOVE VEN-PH2-LAST4   TO  PRT-PHONE-LAST4
262500             MOVE "-"             TO  PRT-PHONE-DASH2
262600         ELSE
262700         IF VEN-PH3-TEST  =  SPACES
262800             MOVE VEN-PH3-FIRST3  TO  PRT-PHONE-FIRST3
262900             MOVE VEN-PH3-LAST4   TO  PRT-PHONE-LAST4
263000             MOVE "-"             TO  PRT-PHONE-DASH2
263100         ELSE
