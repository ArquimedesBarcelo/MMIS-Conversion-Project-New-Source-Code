109300 1-BEGIN.
           OPEN INPUT MPLTINFO-I, MREQ-I, DREQD-I, DREQITM-I,
                      MSTORERM-I, DREQDESC-I, PERSONNEL-I, DVENDITM-I,
                      DVENDOR-I, MVALIDUM-I, DPOITEM-I, DPORECD-I,
                      DCOMMENT-I, DPOITEMP-I, MBUYER-I.

109500     PERFORM 1-HSK  THRU  1-HSK-X.
109600
109700     PERFORM 6-WRITE-REQ  THRU  6-WR-X.
109800
           CLOSE      MPLTINFO-I, MREQ-I, DREQD-I, DREQITM-I,
                      MSTORERM-I, DREQDESC-I, PERSONNEL-I, DVENDITM-I,
                      DVENDOR-I, MVALIDUM-I, DPOITEM-I, DPORECD-I,
                      DCOMMENT-I, DPOITEMP-I, MBUYER-I.
109900     GOBACK.
110200
110300 1-HSK.
110400     IF REQ-SREQPRNT-CALLED = "Y"
110500         GO TO 1-HSK-X
110600     ELSE
110700         MOVE "Y"                 TO  REQ-SREQPRNT-CALLED.
111100
111200*****************************************
111300**  GET RECEIVING DEPT FROM MPLTINFO
111400**  KEY = 'P 03'
111500*****************************************
111600
111700     MOVE "P 03"                  TO  PLT-ARG.
           MOVE PLT-ARG TO PLTINFOKEY OF MPLTINFO-REC-I.
           READ MPLTINFO-I INTO BUF-MPLTINFO
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
112200             MOVE SPACES          TO  RCV-DEPT-SAVE
112300         ELSE
112400             MOVE "GET MPLTINFO P 03* 1-BEGIN" TO BU-DISPLAY-MSG
112500             MOVE PLT-ARG  TO  BU-DISPLAY-FLD (3)
112600             GO TO 2-BLOWUP
112700     ELSE
112800         MOVE MPLTINFO-RECV-DEPT  TO  RCV-DEPT-SAVE.
112900
113000*****************************************
113100**  GET COMPANY NAME FROM MPLTINFO
113200**  KEY = 'P 01' FOR PRINT PURPOSES
113300*****************************************
113400
113500     MOVE "P 01"                  TO PLT-ARG.
           MOVE PLT-ARG TO PLTINFOKEY OF MPLTINFO-REC-I.
           READ MPLTINFO-I INTO BUF-MPLTINFO
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
114000             MOVE SPACES          TO SAVE-PLT-NAME
114100         ELSE
114200             MOVE "GET MPLTINFO P 01* 1-BEGIN" TO BU-DISPLAY-MSG
114300             MOVE PLT-ARG  TO  BU-DISPLAY-FLD (3)
114400             GO TO 2-BLOWUP
114500     ELSE
114600         MOVE MPLTINFO-PLT-NAME   TO SAVE-PLT-NAME.
114700
      **************************************************
      **  SEE IF PLANT WANTS THE CURRENCY CODE DISPLAYED
      **************************************************

           MOVE "PREQ"                    TO PLT-ARG.
           MOVE PLT-ARG TO PLTINFOKEY OF MPLTINFO-REC-I.
           READ MPLTINFO-I INTO BUF-MPLTINFO
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE "N"                   TO SAVE-REQ-CURR-SW
           ELSE
               MOVE MPLTINFO-REQ-CURR-SW  TO SAVE-REQ-CURR-SW.

113000*****************************************
113100**  RETRIEVE PACD-SW FROM MPLTINFO
113300*****************************************
113400
           MOVE "Y"                     TO SAVE-PACD-SW.
113500     MOVE "PACD"                  TO PLT-ARG.
           MOVE PLT-ARG TO PLTINFOKEY OF MPLTINFO-REC-I.
           READ MPLTINFO-I INTO BUF-MPLTINFO
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
114000         MOVE "Y"                 TO SAVE-PACD-SW
114500     ELSE
114600     MOVE MPLTINFO-PACD-SW        TO SAVE-PACD-SW.
114700
114800************************************************
114900**   GET INDICATOR THAT DENOTES WHETHER OR
115000**   NOT THE USER WANTS ALL MANUFACTURERS
115100**   TO PRINT WHEN PRINT CODED DESC. OR
115200**   JUST SELECTED MANUNFACTURERS (DEFAULT).
115300**   THIS INDICATOR IS IN MPLTINFO UNDER
115400**   THE KEY 'POPT'.
115500************************************************
115600
           MOVE ZEROES                  TO  SAVE-REQ-PRT-NO-2.
115700     MOVE "POPT"                  TO  PLT-ARG.
           MOVE PLT-ARG TO PLTINFOKEY OF MPLTINFO-REC-I.
           READ MPLTINFO-I INTO BUF-MPLTINFO
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
116200             MOVE "N"             TO  PRINT-ALL-MANUF-SW
116300         ELSE
116400             MOVE "GET MPLTINFO POPT* 1-HSK" TO BU-DISPLAY-MSG
116500             MOVE PLT-ARG  TO  BU-DISPLAY-FLD (3)
116600             GO TO 2-BLOWUP
116700     ELSE
116800     MOVE MPLTINFO-REQ-PRINT-MANUF-SW  TO  PRINT-ALL-MANUF-SW    .
           IF MPLTINFO-REQ-PRT-NO-2X = "  "
               MOVE MPLTINFO-REQ-PRT-NO      TO  MPLTINFO-REQ-PRT-NO-2
                                                 SAVE-REQ-PRT-NO-2
           ELSE
           MOVE MPLTINFO-REQ-PRT-NO          TO  SAVE-REQ-PRT-NO
116900     MOVE MPLTINFO-REQ-PRT-NO-2        TO  SAVE-REQ-PRT-NO-2.
