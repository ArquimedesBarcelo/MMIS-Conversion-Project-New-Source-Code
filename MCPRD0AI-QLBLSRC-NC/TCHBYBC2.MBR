055000 010-MAINLINE.
           MOVE "C" TO MCXCBLERR-SCOPE.
           CALL "MCXCBLERR" USING MCXCBLERR-SCOPE.

      ****** INITIALIZE THE VARIOUS DATABASE BUFFER AREAS IN
      ****** WORKING STORAGE.  ---01NOV91 D A PLUM
           MOVE SPACES TO BUF-MATLACUM.
           MOVE 0      TO MATL-BEG-BAL-DOLLARS
                          MATL-BEG-BAL-UNITS
                          MATL-INV-DOLLARS
                          MATL-RCPT-UNITS
                          MATL-ISSUE-UNITS
                          MATL-RTN-UNITS
                          MATL-ADJ-UNITS
                          MATL-RTN-DOLLARS
                          MATL-RCPT-DOLLARS
                          MATL-UNITS-RCVD-NOT-INV
                          MATL-INV-DOL-NOT-RCVD
                          MATL-UNITS-INV-NOT-RCVD
                          MATL-INTRANSIT-DOLLARS
                          MATL-ACCTG-UNIT-CORR
                          MATL-ACCTG-DOLLAR-CORR
                          MATL-INTRANSIT-UNITS
                          MATL-WDOWN-PERC
                          MATL-TOT-ISS-DOLLARS
                          MATL-TOT-ADJ-DOLLARS
                          MATL-RTNVAL-UNITS
                          MATL-RTNVAL-DOLLARS.
           MOVE SPACES TO BUF-DTRANS.
           MOVE 0      TO TRANS-QTY
                          TRANS-VALUE
                          TRANS-BALANCE-QTY.
           MOVE SPACES TO BUF-MCHTACCTS.
           MOVE SPACES TO BUF-MCLASS.
           MOVE SPACES TO BUF-MREPORT.
           MOVE SPACES TO BUF-MLEDGER.
           MOVE SPACES TO BUF-DPODATAITM.
           MOVE SPACES TO BUF-MSTORERM.
           MOVE 0      TO STR-EOQ
                          STR-REORDER
                          STR-MAX
                          STR-EXPEDITE
                          STR-STD-COST
                          STR-AVG-COST
                          STR-PREV-AVG
                          STR-UM1-CF
                          STR-UM2-CF
                          STR-EST-LT
                          STR-LAST-DLVTIMES (1)
                          STR-LAST-DLVTIMES (2)
                          STR-LAST-DLVTIMES (3)
                          STR-MKT-COST
                          STR-OUT-REPAIR-COST
                          STR-MAINT-REPAIR-COST
                          STR-MTH-FCST
                          STR-ONHAND
                          STR-ONORDER
                          STR-RESERVED
                          STR-RSRV-ONORD
                          STR-LOC-ONHAND (1)
                          STR-LOC-ONHAND (2)
                          STR-LOC-ONHAND (3)
                          STR-LOC-ONHAND (4)
                          STR-LOC-ONHAND (5)
                          STR-LOC-ONHAND (6)
                          STR-TAX-PERCENT
                          STR-SOQ
                          STR-RAW-LOT.
           MOVE SPACES TO BUF-MACCT-INFO.

055400     ACCEPT HD-ROUTE-DATA.
           DISPLAY HD-ROUTE-DATA.
055500
           MOVE HD-SPOOLER-NUMBER TO OVRPRTF-TOFILE-NUM.
           MOVE "*YES"            TO OVRPRTF-SHARED.
           MOVE HD-NO-OF-COPIES   TO OVRPRTF-COPIES.
           MOVE "MCPRT"           TO OVRPRTF-FILE.
           PERFORM 996-OVERRIDE-PRINT-FILE.

           OPEN OUTPUT ONLINE-PRT.

           PERFORM 9999-GETFNUM.
056100     MOVE "DHDRPT86.PUB" TO HD-FILE-NAME.
056200     CALL "THDPRT2" USING HD-RET-CODE, HD-FILE-NAME, FNUM,
056300         HD-ROUTE-DATA, ESC-NAME.
056400     IF HD-RET-CODE NOT = 0
056500         MOVE "THDPRT2 ERROR * CHGBYBC" TO BU-DISPLAY-MSG
056600         MOVE "HD-RET-CODE = "     TO BU-DISPLAY-FLD (1)
056700         MOVE HD-RET-CODE          TO BU-DISPLAY-FLD9 (1)
056800         PERFORM 990-BLOWUP.
056900
055600     CALL "TESCSEQ" USING ESC-NAME.
055700     MOVE CHAR-1636PI              TO COMPRESS-PRINT.
055800     MOVE CHAR-10PI                TO NORMAL-PRINT.
055900
057000     IF PAPER-IS-132-COLS
057100       NEXT SENTENCE
057200     ELSE
057300       WRITE PRT-REC FROM COMPRESS-PRINT AFTER ADVANCING 0.
