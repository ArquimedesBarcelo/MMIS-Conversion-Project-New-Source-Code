058500                           BU-PGM-NAME,
058600                           STATUS-AREA,
058700                           DUMMY-VIEW-AREA,
058800                           FILE-STATUS,
058900                           BU-DISPLAY-MSG,
059000                           BU-DISPLAY-FLDS.
059100
059200     SORT SORT-FILE ON ASCENDING KEY SORT-BC
059300                                     SORT-REPORT-CODE
059400*                                    SORT-LEDG-CODE
059500                                     SORT-CLASS
059600                                     SORT-ACCT-CHGD
059700                                     SORT-DEPT-CHGD
059800                                     SORT-CODE-OR-PO
059900         INPUT PROCEDURE IS 050-PROCESS-TRANS
060000         OUTPUT PROCEDURE IS 700-CREATE-REPORT.
060100     PERFORM 1000-CLOSE-FILES.
060200     GOBACK.
060300
060400
060500 050-PROCESS-TRANS SECTION.
       050-PROCESS-TRANS-PARA.
060600     PERFORM 100-BEGIN.
060700     PERFORM 200-PROCESS-DETAIL
060800         UNTIL END-OF-FILE.
060900
