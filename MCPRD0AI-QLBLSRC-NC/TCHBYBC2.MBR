065300             PERFORM 510-GET-LEDGER
065400             PERFORM 520-GET-DESCR
065500             PERFORM 550-GET-MSTORERM
065600             PERFORM 600-BUILD-SORT-REC
065700         ELSE
065800             IF TRANS-CODE = "INV" OR "FRT"
065900                 IF TRANS-STORES-CODE = "NON-STR"
066000                     PERFORM 500-GET-MMATL-ACCUM
066100                     PERFORM 510-GET-LEDGER
066200                     PERFORM 520-GET-DESCR
066300                     PERFORM 550-GET-MSTORERM
066400                     PERFORM 600-BUILD-SORT-REC
066500                 ELSE
066600                 IF TRANS-DEPT NOT = MACCT-STR-DEPT
066700                     PERFORM 500-GET-MMATL-ACCUM
066800                     PERFORM 510-GET-LEDGER
066900                     PERFORM 520-GET-DESCR
067000                     PERFORM 550-GET-MSTORERM
067100                     PERFORM 600-BUILD-SORT-REC
067200                 ELSE
067300                     NEXT SENTENCE
067400             ELSE
067500                 NEXT SENTENCE.
