072600**********************************************************
072700**  THIS SECTION SETS THE REPORT CODE FOR DIRECT        **
072800**  DELIVERIES THAT ARE NOT CODED.  ALL CODED ITEMS     **
072900**  HAVE A REPORT CODE ATTACHED.                        **
073000**********************************************************
073100
073200 505-SET-REPORT-CODE.
073300*    IF TRANS-CLASS < 200
073400*        MOVE 02 TO SORT-REPORT-CODE
073500*    ELSE
073600*        IF TRANS-CLASS < 344
073700*            MOVE 05 TO SORT-REPORT-CODE
073800*        ELSE
073900*            IF TRANS-CLASS < 400
074000*                MOVE 01 TO SORT-REPORT-CODE
074100*            ELSE
074200*                IF TRANS-CLASS < 500
074300*                    MOVE 02 TO SORT-REPORT-CODE
074400*                ELSE
074500*                    MOVE 01 TO SORT-REPORT-CODE.
      ******************************************************
      *    THE ABOVE LOGIC WAS CHANGED 7/30/97 DUE TO      *
      *    VALLEYFIELD USING CLASS 080 FOR MAJOR SPARE     *
      *    PARTS.....JIM C.                                *
      ******************************************************
068100     IF (TRANS-CLASS > 099 AND TRANS-CLASS < 200) OR
068200        (TRANS-CLASS > 399 AND TRANS-CLASS < 500)
068300         MOVE "02"                TO SORT-REPORT-CODE
068400     ELSE
068500     IF (TRANS-CLASS > 199 AND TRANS-CLASS < 344)
068600         MOVE "05"                TO SORT-REPORT-CODE
068700     ELSE
068800     IF (TRANS-CLASS > 343 AND TRANS-CLASS < 400)  OR
068900        (TRANS-CLASS > 499) OR (TRANS-CLASS < 100)
069000         MOVE "01"                TO SORT-REPORT-CODE.
074600     IF TRANS-ACCT = "000000" OR TRANS-ACCT = SPACES
074700         NEXT SENTENCE
074800     ELSE
074900*        IF TRANS-CLASS < 200 OR TRANS-CLASS > 399
               IF (TRANS-CLASS > 099 AND TRANS-CLASS < 200)
                   OR (TRANS-CLASS > 399)
075000             NEXT SENTENCE
075100         ELSE
075200             IF TRANS-ACCT > "009999"
075300                 MOVE 06 TO SORT-REPORT-CODE
075400             ELSE
075500                 IF TRANS-ACCT = "000951"
075600                     MOVE 02 TO SORT-REPORT-CODE
075700                 ELSE
075800                     IF TRANS-ACCT < "000100"
075900                         OR TRANS-ACCT = "000251" OR
076000                            "000252" OR "000253" OR "000250"
                                  OR TRANS-ACCT = "000254"
076100                               OR "000891" OR "000892"
076200                             MOVE 05 TO SORT-REPORT-CODE
076300                     ELSE
076400                         MOVE 01 TO SORT-REPORT-CODE.
076500
076600
