       IDENTIFICATION DIVISION.
       PROGRAM-ID.             TERINDEX.
       AUTHOR.                 W. ROXBURY.
       INSTALLATION.           GOODYEAR TIRE & RUBBER COMPANY.
       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.
       SOURCE-COMPUTER.        IBM-AS400.
       OBJECT-COMPUTER.        IBM-AS400.
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT DISPLAY-FILE
                  ASSIGN TO WORKSTATION-ZEQPREFI-SI
                  ORGANIZATION IS TRANSACTION
                  ACCESS IS SEQUENTIAL
                  FILE STATUS IS SCREEN-STATUS
                  MAJOR-MINOR
                  CONTROL-AREA IS SCREEN-CONTROL.

       DATA DIVISION.
       FILE SECTION.
       FD  DISPLAY-FILE
           LABEL RECORDS ARE OMITTED.
       01  DISPLAY-REC         PIC X(2000).

       WORKING-STORAGE SECTION.
       77  TRUE-VAL            PIC 1 VALUE B"1".
       77  FALS-VAL            PIC 1 VALUE B"0".

       01  SCREEN-DATA.
           05  EQPNUM          PIC X(06).
           05  TYPNUM          PIC X(08).
           05  SCREEN-MSGS.
               10  CMDMSG      PIC X(79).
               10  ERRMSG      PIC X(79).

           COPY SCREENIO       IN COPYLIB.

           COPY CATREAD        IN COPYLIB.

       LINKAGE SECTION.
       01  DBPARAMETERS.       COPY DBPARMS IN COPYLIB.

       PROCEDURE DIVISION USING DBPARAMETERS.
       OPEN-PAR.
           OPEN I-O            DISPLAY-FILE.
           MOVE SPACES         TO SCREEN-DATA RETURN-BYTE.

       SHOW-SCREEN.
           MOVE "VCATALOG"     TO SCREEN-NAME.
           MOVE "00"           TO SCREEN-STATUS.
           MOVE SCREEN-DATA    TO DISPLAY-REC.

           WRITE DISPLAY-REC  FORMAT IS SCREEN-NAME
               INDIC ARE SCREEN-INDICATORS.
           IF SCREEN-STATUS NOT = "00"
               DISPLAY "SCREEN WRITE ERROR.  SCREEN-STATUS IS "
                        SCREEN-STATUS
               GO TO END-OF-JOB.

           READ  DISPLAY-FILE FORMAT IS SCREEN-NAME
               INDIC ARE SCREEN-INDICATORS
           IF SCREEN-STATUS NOT = "00"
               DISPLAY "SCREEN READ ERROR.  SCREEN-STATUS IS "
                        SCREEN-STATUS
               GO TO END-OF-JOB.

           MOVE DISPLAY-REC    TO SCREEN-DATA.
           MOVE ALL B"0"       TO SCREEN-INDICATORS.

           IF KEY-HIT = 3
               GO TO END-OF-JOB.

           IF KEY-HIT = 1
               IF EQPNUM NOT = SPACES
                   CALL "TERINDEX1" USING DBPARAMETERS
                                          EQPNUM
                   IF RETURN-BYTE = "A"
                       MOVE SPACE  TO RETURN-BYTE
                       MOVE SPACES TO EQPNUM
                       MOVE 40015  TO CATREAD-MSG-NUMBER
                       CALL "CCATREAD" USING CATREAD-PARMS
                       MOVE CATREAD-MSG-TEXT TO ERRMSG
                       MOVE TRUE-VAL   TO IND (99)
                   ELSE
                       NEXT SENTENCE
               ELSE
                   NEXT SENTENCE
           ELSE
           IF KEY-HIT = 2
               IF TYPNUM NOT = SPACES
                   CALL "TERINDEX2" USING DBPARAMETERS
                                          TYPNUM
                   IF RETURN-BYTE = "A"
                       MOVE SPACE  TO RETURN-BYTE
                       MOVE SPACES TO TYPNUM
                       MOVE 40015  TO CATREAD-MSG-NUMBER
                       CALL "CCATREAD" USING CATREAD-PARMS
                       MOVE CATREAD-MSG-TEXT TO ERRMSG
                       MOVE TRUE-VAL   TO IND (99)
                   ELSE
                       NEXT SENTENCE
               ELSE
                   NEXT SENTENCE
           ELSE
           IF KEY-HIT = 4
               CALL "TERINDEX3" USING DBPARAMETERS
               IF RETURN-BYTE = "A"
                   MOVE SPACE  TO RETURN-BYTE
                   MOVE 40015  TO CATREAD-MSG-NUMBER
                   CALL "CCATREAD" USING CATREAD-PARMS
                   MOVE CATREAD-MSG-TEXT TO ERRMSG
                   MOVE TRUE-VAL   TO IND (99).

           GO TO SHOW-SCREEN.

       END-OF-JOB.
           CLOSE               DISPLAY-FILE.
           GOBACK.

