           MOVE "25-"          TO NUM-25.
           MOVE OUT-DCODE      TO CODE-25.

           ADD 1               TO ACT-KEY.
           READ OUT-FILE INVALID KEY
               MOVE 1          TO EOF-SW
               GO TO FS-EXIT.
           IF ACT-KEY > MAX-KEY
               MOVE 1          TO EOF-SW
               GO TO FS-EXIT.
           MOVE "26-"          TO NUM-26.
           MOVE OUT-DCODE      TO CODE-26.

           ADD 1               TO ACT-KEY.
           READ OUT-FILE INVALID KEY
               MOVE 1          TO EOF-SW
               GO TO FS-EXIT.
           IF ACT-KEY > MAX-KEY
               MOVE 1          TO EOF-SW
               GO TO FS-EXIT.
           MOVE "27-"          TO NUM-27.
           MOVE OUT-DCODE      TO CODE-27.

           ADD 1               TO ACT-KEY.
           READ OUT-FILE INVALID KEY
               MOVE 1          TO EOF-SW
               GO TO FS-EXIT.
           IF ACT-KEY > MAX-KEY
               MOVE 1          TO EOF-SW
               GO TO FS-EXIT.
           MOVE "28-"          TO NUM-28.
           MOVE OUT-DCODE      TO CODE-28.

           ADD 1               TO ACT-KEY.
           READ OUT-FILE INVALID KEY
               MOVE 1          TO EOF-SW
               GO TO FS-EXIT.
           IF ACT-KEY > MAX-KEY
               MOVE 1          TO EOF-SW
               GO TO FS-EXIT.
           MOVE "29-"          TO NUM-29.
           MOVE OUT-DCODE      TO CODE-29.

           ADD 1               TO ACT-KEY.
           READ OUT-FILE INVALID KEY
               MOVE 1          TO EOF-SW
               GO TO FS-EXIT.
           IF ACT-KEY > MAX-KEY
