           05  CODE-NUMBER.
               10  CNUM-1                      PIC X.
               10  CNUM-2                      PIC X.
           05  CNUM-99 REDEFINES CODE-NUMBER   PIC 99.
           05  HELP-LINE                       PIC X(70).
           05  SCREEN-MSGS.
               10  CMDMSG                      PIC X(79).
               10  ERRMSG                      PIC X(79).

       01  DLIST-LINE.
           05  DIST-CC      PIC X(04).
           05  DIST-ZN      PIC X(04).
           05  DIST-CR      PIC X(02).

       01  DB-ERROR.
           05  DB-FUNC   PIC X(10) VALUE SPACES.
           05  DB-FILE   PIC X(18) VALUE SPACES.
           05  FILLER    PIC X(20) VALUE "ERROR - FILE-STAT = ".
           05  CON-WORD  PIC XX.

           COPY SCREENIO       IN COPYLIB.

           COPY CATREAD        IN COPYLIB.

       01  DISTRIBUTION-TABLE.
           COPY DNEWSTBL       IN COPYLIB.

       01  MESSAGE-BUFFER-DATA.
           COPY ERRORLIN       IN COPYLIB.

       LINKAGE SECTION.
       01  DBPARAMETERS.
           COPY DBPARMS        IN COPYLIB.

       01  DLIST-DATA.
           05  DIST-CODE           PIC X(06).
           05  DIST-LOCA           PIC X(40).
           05  DIST-HELP           PIC X(70).

       PROCEDURE DIVISION USING DBPARAMETERS
                                DLIST-DATA.
       BEGIN-SORT SECTION 01.
           CALL "TPWORD" USING PASSWORD-INFORMATION.
           IF PASSWORD-FLAG NOT = "N"
               GO TO START-PROCESSING.
           GOBACK.

       START-PROCESSING.
           OPEN INPUT          NEWS-TABLE.
           OPEN I-O            DISPLAY-FILE.
           MOVE ALL B"0"       TO SCREEN-INDICATORS.
           MOVE "VDLLIST"      TO SCREEN-NAME.
           MOVE SPACES         TO SCREEN-DATA.
           MOVE DIST-LOCA      TO LOCA-ID HELP-LOCA.
           MOVE DIST-HELP      TO HELP-LINE HELP-MSGLINE.
           MOVE SPACES         TO MESSAGE-BUFFER CODE-HOLD.
           MOVE 0              TO ACT-KEY MAX-KEY RECNO EOF-SW.

           SORT SORT-FILE ASCENDING KEY SORT-DCODE
               INPUT PROCEDURE SORT-INFILE
               OUTPUT PROCEDURE SORT-OUTFILE.

           IF ACT-KEY = 0
      **********************************************************************
      **    MESSAGE 040/015:
      **  NO RECORDS FOUND
      **********************************************************************
               MOVE  40        TO CATREAD-MSG-SET
               MOVE  15        TO CATREAD-MSG-NUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER TO ERRMSG
               MOVE 1          TO EOF-SW
               MOVE TRUE-VAL   TO IND(99).

           MOVE 0              TO ACT-KEY.

       MAIN.
           OPEN INPUT          OUT-FILE.
           MOVE SPACES         TO CODE-NUMBER.
           IF EOF-SW = 1 AND MAX-KEY < 49
               GO TO SHOWFORM.

           IF EOF-SW = 1
               MOVE 0          TO ACT-KEY.

           MOVE 0              TO EOF-SW.
           MOVE SPACES         TO DISTRIBUTION-CODES.
           IF MSG-TEXT = SPACES PERFORM FILL-SCREEN THRU FS-EXIT
                               UNTIL EOF-SW > 0.

       SHOWFORM.
           MOVE "00"           TO SCREEN-STATUS.
           MOVE SCREEN-DATA    TO DISPLAY-REC.

           WRITE DISPLAY-REC  FORMAT IS SCREEN-NAME
               INDIC ARE SCREEN-INDICATORS.
           IF SCREEN-STATUS NOT = "00"
               DISPLAY "SCREEN WRITE ERROR.  SCREEN-STATUS IS "
                        SCREEN-STATUS
               GO TO END-OF-JOB.

           READ  DISPLAY-FILE FORMAT IS SCREEN-NAME
               INDIC ARE SCREEN-INDICATORS
           IF SCREEN-STATUS NOT = "00"
               DISPLAY "SCREEN READ ERROR.  SCREEN-STATUS IS "
                        SCREEN-STATUS
               GO TO END-OF-JOB.

           MOVE DISPLAY-REC    TO SCREEN-DATA.
           MOVE ALL B"0"       TO SCREEN-INDICATORS.

           IF KEY-HIT = 1 OR 3
               GO TO END-OF-JOB.

           IF KEY-HIT = 5
               IF CODE-NUMBER = SPACES
                   GO TO SHOWFORM
               ELSE
                   PERFORM SUBF-CLEAR
                   PERFORM SETUP-GET-DLIST THRU SETUP-GDL-EXIT
                   MOVE SPACES TO MESSAGE-BUFFER
                   GO TO SHOWFORM.

           IF KEY-HIT = 7
               MOVE 60         TO HELP-SW
               CALL "TBBHELP" USING HELP-DATA
               MOVE "VDLLIST"  TO SCREEN-NAME
               GO TO SHOWFORM.

           IF KEY-HIT NOT = 0
               GO TO SHOWFORM.

           MOVE SPACES         TO MESSAGE-BUFFER.
           GO TO MAIN.

       FILL-SCREEN.
           ADD 1               TO ACT-KEY.
           READ OUT-FILE INVALID KEY
               MOVE 1          TO EOF-SW
               GO TO FS-EXIT.
           IF ACT-KEY > MAX-KEY
               MOVE 1          TO EOF-SW
               GO TO FS-EXIT.
           MOVE " 1-"          TO NUM-1.
           MOVE OUT-DCODE      TO CODE-1.

           ADD 1               TO ACT-KEY.
           READ OUT-FILE INVALID KEY
               MOVE 1          TO EOF-SW
               GO TO FS-EXIT.
           IF ACT-KEY > MAX-KEY
               MOVE 1          TO EOF-SW
               GO TO FS-EXIT.
           MOVE " 2-"          TO NUM-2.
           MOVE OUT-DCODE      TO CODE-2.

           ADD 1               TO ACT-KEY.
           READ OUT-FILE INVALID KEY
               MOVE 1          TO EOF-SW
               GO TO FS-EXIT.
           IF ACT-KEY > MAX-KEY
               MOVE 1          TO EOF-SW
               GO TO FS-EXIT.
           MOVE " 3-"          TO NUM-3.
           MOVE OUT-DCODE      TO CODE-3.

           ADD 1               TO ACT-KEY.
           READ OUT-FILE INVALID KEY
               MOVE 1          TO EOF-SW
               GO TO FS-EXIT.
           IF ACT-KEY > MAX-KEY
               MOVE 1          TO EOF-SW
               GO TO FS-EXIT.
           MOVE " 4-"          TO NUM-4.
           MOVE OUT-DCODE      TO CODE-4.

           ADD 1               TO ACT-KEY.
           READ OUT-FILE INVALID KEY
               MOVE 1          TO EOF-SW
               GO TO FS-EXIT.
           IF ACT-KEY > MAX-KEY
               MOVE 1          TO EOF-SW
               GO TO FS-EXIT.
           MOVE " 5-"          TO NUM-5.
           MOVE OUT-DCODE      TO CODE-5.

           ADD 1               TO ACT-KEY.
           READ OUT-FILE INVALID KEY
               MOVE 1          TO EOF-SW
               GO TO FS-EXIT.
           IF ACT-KEY > MAX-KEY
               MOVE 1          TO EOF-SW
               GO TO FS-EXIT.
           MOVE " 6-"          TO NUM-6.
           MOVE OUT-DCODE      TO CODE-6.

           ADD 1               TO ACT-KEY.
           READ OUT-FILE INVALID KEY
               MOVE 1          TO EOF-SW
               GO TO FS-EXIT.
           IF ACT-KEY > MAX-KEY
               MOVE 1          TO EOF-SW
               GO TO FS-EXIT.
           MOVE " 7-"          TO NUM-7.
           MOVE OUT-DCODE      TO CODE-7.

           ADD 1               TO ACT-KEY.
           READ OUT-FILE INVALID KEY
               MOVE 1          TO EOF-SW
               GO TO FS-EXIT.
           IF ACT-KEY > MAX-KEY
               MOVE 1          TO EOF-SW
               GO TO FS-EXIT.
           MOVE " 8-"          TO NUM-8.
           MOVE OUT-DCODE      TO CODE-8.

           ADD 1               TO ACT-KEY.
           READ OUT-FILE INVALID KEY
               MOVE 1          TO EOF-SW
               GO TO FS-EXIT.
           IF ACT-KEY > MAX-KEY
               MOVE 1          TO EOF-SW
               GO TO FS-EXIT.
