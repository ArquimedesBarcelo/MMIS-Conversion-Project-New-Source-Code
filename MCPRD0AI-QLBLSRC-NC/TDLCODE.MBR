       IDENTIFICATION DIVISION.
       PROGRAM-ID.             TDLCODE.
       AUTHOR.                 W. ROXBURY.
       INSTALLATION.           GOODYEAR TIRE & RUBBER CO.
       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.
       SOURCE-COMPUTER.        IBM-AS400.
       OBJECT-COMPUTER.        IBM-AS400.
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT NEWS-TABLE
                  ASSIGN TO DATABASE-MCFLMM2801
                  ORGANIZATION IS INDEXED
                  ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                  WITH DUPLICATES
                  FILE STATUS IS FILE-STAT.

           SELECT DISPLAY-FILE
                  ASSIGN TO WORKSTATION-ZBBNEW-SI
                  ORGANIZATION IS TRANSACTION
                  ACCESS IS DYNAMIC
                  RELATIVE KEY IS RECNO
                  FILE STATUS IS SCREEN-STATUS
                  MAJOR-MINOR
                  CONTROL-AREA IS SCREEN-CONTROL.

           SELECT OUT-FILE
                  ASSIGN TO DISK-DISTLIST
                  ORGANIZATION IS RELATIVE
                  ACCESS MODE IS DYNAMIC
                  RELATIVE KEY IS ACT-KEY
                  FILE STATUS IS FILE-STAT.

           SELECT SORT-FILE ASSIGN TO DISK-SORT.

       DATA DIVISION.
       FILE SECTION.
       FD  NEWS-TABLE
           LABEL RECORDS ARE STANDARD.
       01  DL-REC.
           COPY DDS-ALL-FORMATS OF MCFLMM2801.

       FD  DISPLAY-FILE
           LABEL RECORDS ARE OMITTED.
       01  DISPLAY-REC         PIC X(2000).

       FD  OUT-FILE RECORD CONTAINS 6 CHARACTERS
           LABEL RECORDS ARE OMITTED
           DATA RECORD IS OUT-REC.
       01  OUT-REC.
           05  OUT-DCODE               PIC X(06).

       SD  SORT-FILE RECORD CONTAINS 6 CHARACTERS
           DATA RECORD IS SORT-REC.
       01  SORT-REC.
           05  SORT-DCODE              PIC X(06).

       WORKING-STORAGE SECTION.
       77  ACT-KEY                 PIC 9999   VALUE 0.
       77  MAX-KEY                 PIC 9999   VALUE 0.
       77  RECNO                   PIC 9999   VALUE 0.
       77  ARG-KEY                 PIC X(06).
       77  CODE-HOLD               PIC X(06)  VALUE SPACES.
       77  EOF-SW                  PIC 9      VALUE 0.
       77  TRUE-VAL                PIC 1      VALUE B"1".
       77  NEG-VAL                 PIC 1      VALUE B"0".

       01  PASSWORD-INFORMATION.
           05  NAME-OF-PROGRAM     PIC X(08) VALUE "TDLCODE ".
           05  PROGRAM-TYPE        PIC X(02) VALUE "UP".
           05  PROGRAM-RELEASE     PIC X(12) VALUE " E0100010001".
           05  PROGRAM-DESCRIPTION.
               10  PROG-DESC-A     PIC X(60) VALUE
         "LISTS DISTRIBUTION CODES FOR THE MMIS NEWS BULLETIN BOARD   ".
               10  PROG-DESC-B     PIC X(60) VALUE
         "PROGRAM.  RUNS FROM THE f2 KEY OF THE DISTRIBUTION LIST     ".
               10  PROG-FUNCTION   PIC X(60) VALUE
         "MAINTENANCE MENU.                                           ".
           05  PASSWORD-FLAG       PIC X.

       01  FILE-STAT.
           05 FILE-STAT-1      PIC X   VALUE "0".
           05 FILE-STAT-2      PIC X   VALUE "0".

       01  HELP-DATA.
           05  HELP-SW             PIC 9(04) BINARY VALUE ZEROS.
           05  HELP-LOCA           PIC X(40).
           05  HELP-MSGLINE        PIC X(70).

       01  SCREEN-DATA.
