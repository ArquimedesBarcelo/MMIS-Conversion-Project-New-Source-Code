               GO TO FS-EXIT.
           IF ACT-KEY > MAX-KEY
               MOVE 1          TO EOF-SW
               GO TO FS-EXIT.
           MOVE "16-"          TO NUM-16.
           MOVE OUT-DCODE      TO CODE-16.

           ADD 1               TO ACT-KEY.
           READ OUT-FILE INVALID KEY
               MOVE 1          TO EOF-SW
               GO TO FS-EXIT.
           IF ACT-KEY > MAX-KEY
               MOVE 1          TO EOF-SW
               GO TO FS-EXIT.
           MOVE "17-"          TO NUM-17.
           MOVE OUT-DCODE      TO CODE-17.

           ADD 1               TO ACT-KEY.
           READ OUT-FILE INVALID KEY
               MOVE 1          TO EOF-SW
               GO TO FS-EXIT.
           IF ACT-KEY > MAX-KEY
               MOVE 1          TO EOF-SW
               GO TO FS-EXIT.
           MOVE "18-"          TO NUM-18.
           MOVE OUT-DCODE      TO CODE-18.

           ADD 1               TO ACT-KEY.
           READ OUT-FILE INVALID KEY
               MOVE 1          TO EOF-SW
               GO TO FS-EXIT.
           IF ACT-KEY > MAX-KEY
               MOVE 1          TO EOF-SW
               GO TO FS-EXIT.
           MOVE "19-"          TO NUM-19.
           MOVE OUT-DCODE      TO CODE-19.

           ADD 1               TO ACT-KEY.
           READ OUT-FILE INVALID KEY
               MOVE 1          TO EOF-SW
               GO TO FS-EXIT.
           IF ACT-KEY > MAX-KEY
               MOVE 1          TO EOF-SW
               GO TO FS-EXIT.
           MOVE "20-"          TO NUM-20.
           MOVE OUT-DCODE      TO CODE-20.

           ADD 1               TO ACT-KEY.
           READ OUT-FILE INVALID KEY
               MOVE 1          TO EOF-SW
               GO TO FS-EXIT.
           IF ACT-KEY > MAX-KEY
               MOVE 1          TO EOF-SW
               GO TO FS-EXIT.
           MOVE "21-"          TO NUM-21.
           MOVE OUT-DCODE      TO CODE-21.

           ADD 1               TO ACT-KEY.
           READ OUT-FILE INVALID KEY
               MOVE 1          TO EOF-SW
               GO TO FS-EXIT.
           IF ACT-KEY > MAX-KEY
               MOVE 1          TO EOF-SW
               GO TO FS-EXIT.
           MOVE "22-"          TO NUM-22.
           MOVE OUT-DCODE      TO CODE-22.

           ADD 1               TO ACT-KEY.
           READ OUT-FILE INVALID KEY
               MOVE 1          TO EOF-SW
               GO TO FS-EXIT.
           IF ACT-KEY > MAX-KEY
               MOVE 1          TO EOF-SW
               GO TO FS-EXIT.
           MOVE "23-"          TO NUM-23.
           MOVE OUT-DCODE      TO CODE-23.

           ADD 1               TO ACT-KEY.
           READ OUT-FILE INVALID KEY
               MOVE 1          TO EOF-SW
               GO TO FS-EXIT.
           IF ACT-KEY > MAX-KEY
