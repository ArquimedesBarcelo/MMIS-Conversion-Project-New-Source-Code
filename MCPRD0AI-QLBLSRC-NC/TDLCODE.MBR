       SETUP-GDL-EXIT.    EXIT.

       GET-DLIST.
           MOVE SPACES         TO MESSAGE-BUFFER.
           MOVE ARG-KEY        TO NEWSKEY OF NEWS-TABLE.
           START NEWS-TABLE    KEY = NEWSKEY OF NEWS-TABLE.
           IF FILE-STAT NOT = "00"
      **********************************************************************
      **    MESSAGE 040/015:
      **  NO RECORDS FOUND
      **********************************************************************
               MOVE  40        TO CATREAD-MSG-SET
               MOVE  15        TO CATREAD-MSG-NUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER TO ERRMSG
               MOVE TRUE-VAL   TO IND(99)
               GO TO GDL-EXIT.

       DBGET-DLIST.
           READ NEWS-TABLE NEXT INTO DISTRIBUTION-TABLE.
           IF FILE-STAT NOT = "00"
               IF FILE-STAT = "10" OR "14" OR "46"
                   GO TO GDL-CONT
               ELSE
                   MOVE "READ    " TO DB-FUNC
                   MOVE "NEWS-TABLE" TO DB-FILE
                   MOVE FILE-STAT  TO CON-WORD
                   MOVE DB-ERROR   TO ERRMSG
                   MOVE TRUE-VAL   TO IND(99)
                   GO TO GDL-EXIT.

           IF DIST-KEY NOT = ARG-KEY
               GO TO GDL-CONT.

           IF DIST-CC-NUM = "9999"
               MOVE SPACES     TO DIST-CC
           ELSE
              MOVE DIST-CC-NUM TO DIST-CC.

           MOVE DIST-ZONE      TO DIST-ZN.
           MOVE DIST-CRFT      TO DIST-CR.
           MOVE DLIST-LINE     TO DISPLAY-REC.
           ADD  1              TO RECNO.
           WRITE SUBFILE DISPLAY-REC FORMAT "RDSF"
               INDIC ARE SCREEN-INDICATORS.
           GO TO DBGET-DLIST.

       GDL-CONT.
           MOVE SPACES         TO CODE-NUMBER.
           WRITE DISPLAY-REC FORMAT "RDSB"
               INDIC ARE SCREEN-INDICATORS.
           MOVE B"1"           TO IND(76).
           IF RECNO > 0
               MOVE TRUE-VAL   TO IND(75)
           ELSE
               MOVE NEG-VAL    TO IND(75).
           MOVE ARG-KEY        TO DISPLAY-REC.
           WRITE DISPLAY-REC FORMAT "RDSC"
               INDIC ARE SCREEN-INDICATORS.
           READ DISPLAY-FILE FORMAT "RDSC"
               INDIC ARE SCREEN-INDICATORS.

       GDL-EXIT.    EXIT.

       END-OF-JOB.
           CLOSE               NEWS-TABLE.
           CLOSE               DISPLAY-FILE.
           CLOSE               OUT-FILE.
           GOBACK.

       999-CATREAD.
           MOVE SPACES         TO MESSAGE-BUFFER.
           CALL "CCATREAD" USING CATREAD-PARMS.
           MOVE CATREAD-MSG-TEXT TO MESSAGE-BUFFER.

       999-CATREAD-EXIT.    EXIT.

       SUBF-CLEAR.
           MOVE 0              TO RECNO.
           MOVE NEG-VAL        TO IND(75) IND(76).
           MOVE TRUE-VAL       TO IND(77).
           MOVE SPACES         TO DISPLAY-REC.
           WRITE DISPLAY-REC FORMAT "RDSC"
               INDIC ARE SCREEN-INDICATORS.
           MOVE NEG-VAL        TO IND(77).

       SORT-INFILE SECTION 02.
           MOVE LOW-VALUES     TO NEWSKEY OF NEWS-TABLE.
           START NEWS-TABLE    KEY > NEWSKEY OF NEWS-TABLE.
           PERFORM SORT-MAIN THRU SORT-M-EXIT.
           GO TO SORT-IP-EXIT.

       SORT-MAIN.
           MOVE SPACES         TO SORT-REC.
           READ NEWS-TABLE NEXT INTO DISTRIBUTION-TABLE
               AT END GO TO SORT-M-EXIT.
           IF FILE-STAT NOT = "00"
             IF FILE-STAT-1 = "2"
               GO TO SORT-M-EXIT
             ELSE
               MOVE "READ    " TO DB-FUNC
               MOVE "NEWS-TABLE" TO DB-FILE
               MOVE FILE-STAT  TO CON-WORD
               DISPLAY DB-ERROR
               GO TO SORT-M-EXIT.

           MOVE DIST-KEY       TO SORT-DCODE.
           RELEASE SORT-REC.
           GO TO SORT-MAIN.

       SORT-M-EXIT.    EXIT.

       SORT-IP-EXIT.    EXIT.

       SORT-OUTFILE SECTION 03.
           OPEN OUTPUT         OUT-FILE.
           PERFORM SORT-READ-LOOP THRU SRL-EXIT.
           CLOSE               OUT-FILE.
           GO TO SORT-OF-EXIT.

       SORT-READ-LOOP.
           RETURN SORT-FILE AT END
               MOVE ACT-KEY    TO MAX-KEY
               GO TO SRL-EXIT.
           IF SORT-REC = CODE-HOLD
               GO TO SORT-READ-LOOP.
           ADD 1               TO ACT-KEY.
           MOVE SORT-REC       TO OUT-REC CODE-HOLD.
           WRITE OUT-REC INVALID KEY
               DISPLAY "WRITE OUT-FILE ERR"
               GO TO SRL-EXIT.
           GO TO SORT-READ-LOOP.

       SRL-EXIT.    EXIT.

       SORT-OF-EXIT.    EXIT.
