028300 PROCEDURE DIVISION USING DBPARAMETERS VIEW-COMAREA
028400                      CATREAD-PARMS.
028700 BEGIN-PGM.
           PERFORM 1-HSK.
           PERFORM 6-MAIN THRU 6-MAIN-LOOP UNTIL VIEW-LASTKEY = 3.
029800 2-EOJ.
           CLOSE DISPLAY-FILE.
           CLOSE WO-CRAFTS-MSTR-FILE.
           CLOSE WO-LAST-NUM-USED.
           CLOSE WO-PLANNED-FILE.
           CLOSE WO-SCHEDULE-FILE.
030300     GOBACK.
030400
030500 1-HSK.
           MOVE 0 TO DATE-MODE.
           OPEN I-O   DISPLAY-FILE.
           OPEN INPUT WO-CRAFTS-MSTR-FILE.
           OPEN INPUT WO-LAST-NUM-USED.
           OPEN INPUT WO-PLANNED-FILE.
           OPEN INPUT WO-SCHEDULE-FILE.
030600     CALL "TPWORD" USING PASSWORD-INFORMATION.
031000     IF PASSWORD-FLAG = "N" GO TO 2-EOJ.
031100     ACCEPT CURR-DATE FROM DATE.
           MOVE 0 TO COND-WORD.
           MOVE 1 TO ACT-KEY.
           READ WO-LAST-NUM-USED INTO LAST-WO-BUFF
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF WLNU-STATUS NOT = "00" MOVE 17 TO COND-WORD.
           IF COND-WORD = 17 MOVE 1 TO DATE-FLAG-SW.
           MOVE DATE-FLAG-SW TO DATE-FLAG.
031200     MOVE DATE-FLAG TO DATE-CODE.
031300     MOVE CURR-DATE-MM TO DATE-IN-MD.
031400     MOVE CURR-DATE-DD TO DATE-IN-DM.
031500     MOVE CURR-DATE-YY TO DATE-IN-YY.
031600     CALL "TDATECHK" USING DATE-CHECK-AREA.
031700     MOVE DATE-OUT-MD TO D-MM.
031800     MOVE DATE-OUT-DM TO D-DD.
031900     MOVE DATE-OUT-YY TO D-YY.
           MOVE SPACES TO ERROR-BUFFER SELECT-BUFFER.
       6-MAIN.
032000     MOVE "FQ7DINQ" TO VIEW-CFNAME.
           MOVE ERROR-BUFFER TO SELECT-MSG-LINE.
           MOVE SELECT-BUFFER TO DSPLY-REC.
           PERFORM 99-SCREEN-WRITE.
           PERFORM 98-SCREEN-READ.
           MOVE SPACES TO ERROR-BUFFER.
           MOVE DSPLY-REC TO SELECT-BUFFER.
033900     IF VIEW-LASTKEY = 1 OR 3 GO TO 2-EOJ.
034100     IF VIEW-LASTKEY NOT = 0 GO TO 6-MAIN.
034600     IF CRAFT-BUF = SPACES
034700         MOVE 29032 TO CATREAD-MSG-NUMBER
034900         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
035000         MOVE TRUE-VAL TO INDS (1) INDS (99)
035200         GO TO 6-MAIN.
           MOVE 0 TO COND-WORD.
           MOVE CRAFT-BUF TO CRAFTREQD OF WCMFREC.
           START WO-CRAFTS-MSTR-FILE KEY IS = EXTERNALLY-DESCRIBED-KEY
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF WCMF-STATUS NOT = "00" MOVE 17 TO COND-WORD.
035700     IF COND-WORD = 17
035800         MOVE 35037 TO CATREAD-MSG-NUMBER
036000         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
036100         MOVE TRUE-VAL TO INDS (1) INDS (99)
036300         GO TO 6-MAIN.
036400
036500     IF DAT1-BUF NOT = SPACES
036600         IF DAT1-BUF NOT NUMERIC
036700             MOVE 35014 TO CATREAD-MSG-NUMBER
036900             PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
037000             MOVE TRUE-VAL TO INDS (2) INDS (99)
037200             GO TO 6-MAIN
037300         ELSE
037400         NEXT SENTENCE
037500     ELSE
037600     MOVE 30028 TO CATREAD-MSG-NUMBER
037800     PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
037900     MOVE TRUE-VAL TO INDS (2) INDS (99)
038100     GO TO 6-MAIN.
038200
038300     IF DAT1-YY-9 IS NUMERIC
038400         IF DATE-FLAG = 1
038500             IF DAT1-MM-9 > 0 AND DAT1-MM-9 < 13
038600                 IF DAT1-DD-9 > 0 AND DAT1-DD-9 < 32
038700                     NEXT SENTENCE
038800                 ELSE
038900                 MOVE 35030 TO CATREAD-MSG-NUMBER
039100                 PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
039200                 MOVE TRUE-VAL TO INDS (2) INDS (99)
039400                 GO TO 6-MAIN
039500             ELSE
039600             MOVE 35031 TO CATREAD-MSG-NUMBER
039800             PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
039900             MOVE TRUE-VAL TO INDS (2) INDS (99)
040100             GO TO 6-MAIN
040200         ELSE
040300         IF DAT1-MM-9 > 0 AND DAT1-MM-9 < 32
040400             IF DAT1-DD-9 > 0 AND DAT1-DD-9 < 13
040500                 NEXT SENTENCE
040600             ELSE
040700             MOVE 35031 TO CATREAD-MSG-NUMBER
040900             PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
041000             MOVE TRUE-VAL TO INDS (2) INDS (99)
041200             GO TO 6-MAIN
041300         ELSE
041400         MOVE 35030 TO CATREAD-MSG-NUMBER
041600         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
041700         MOVE TRUE-VAL TO INDS (2) INDS (99)
041900         GO TO 6-MAIN
042000     ELSE
042100     MOVE 35032 TO CATREAD-MSG-NUMBER
042300     PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
042400     MOVE TRUE-VAL TO INDS (2) INDS (99)
042600     GO TO 6-MAIN.
042700
042800     IF DAT2-BUF = SPACES
042900         NEXT SENTENCE
043000     ELSE
043100     IF DAT2-BUF NOT NUMERIC
043200         MOVE 35012 TO CATREAD-MSG-NUMBER
043400         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
043500         MOVE TRUE-VAL TO INDS (3) INDS (99)
043700         GO TO 6-MAIN
043800     ELSE
043900     IF DAT2-YY-9 IS NUMERIC
044000         IF DATE-FLAG = 1
044100             IF DAT2-MM-9 > 0 AND DAT2-MM-9 < 13
044200                 IF DAT2-DD-9 > 0 AND DAT2-DD-9 < 32
044300                     NEXT SENTENCE
044400                 ELSE
044500                 MOVE 35030 TO CATREAD-MSG-NUMBER
044700                 PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
044800                 MOVE TRUE-VAL TO INDS (3) INDS (99)
045000                 GO TO 6-MAIN
045100             ELSE
045200             MOVE 35031 TO CATREAD-MSG-NUMBER
045400             PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
045500             MOVE TRUE-VAL TO INDS (3) INDS (99)
045700             GO TO 6-MAIN
045800         ELSE
045900         IF DAT2-MM-9 > 0 AND DAT2-MM-9 < 32
046000             IF DAT2-DD-9 > 0 AND DAT2-DD-9 < 13
046100                 NEXT SENTENCE
046200             ELSE
046300             MOVE 35031 TO CATREAD-MSG-NUMBER
046500             PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
046600             MOVE TRUE-VAL TO INDS (3) INDS (99)
046800             GO TO 6-MAIN
046900         ELSE
047000         MOVE 35030 TO CATREAD-MSG-NUMBER
047200         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
047300         MOVE TRUE-VAL TO INDS (3) INDS (99)
047500         GO TO 6-MAIN
047600     ELSE
047700     MOVE 35032 TO CATREAD-MSG-NUMBER
047900     PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
048000     MOVE TRUE-VAL TO INDS (3) INDS (99)
048200     GO TO 6-MAIN.
048300
048400     MOVE DAT1-MM TO DATE-IN-MD.
048500     MOVE DAT1-DD TO DATE-IN-DM.
048600     MOVE DAT1-YY TO DATE-IN-YY.
048700     CALL "TDATECHK" USING DATE-CHECK-AREA.
048800     MOVE DATE-OUT-MD TO S-DATE-MM.
048900     MOVE DATE-OUT-DM TO S-DATE-DD.
049000     MOVE DATE-OUT-YY TO S-DATE-YY.
