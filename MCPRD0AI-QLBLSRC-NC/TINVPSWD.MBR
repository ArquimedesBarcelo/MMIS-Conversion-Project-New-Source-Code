029000 PROCEDURE DIVISION.
029100 0-BEGIN.
029200     PERFORM  1-HSK  THRU  1-HSK-X.
029300     PERFORM  6-MAIN THRU  6-MAIN-X.
030400     PERFORM  2-CLOSE-FILES  THRU  2-CLOSE-FILES-X.
030800     GOBACK.
031000
031100 1-HSK.
9406CK     MOVE "C" TO SCOPE.
9406CK     CALL "MCXCBLERR" USING SCOPE.

           OPEN INPUT  INVPWFIL-I.
           OPEN I-O    INVPWFIL-O.
           MOVE "ZINVPSWD" TO VIEW-CFNAME.
           ACCEPT YMD-DATE FROM DATE.
034200
034300 1-HSK-X.
034400     EXIT.
034500
034600
034700 2-CLOSE-FILES.
034710     CLOSE INVPWFIL-I, INVPWFIL-O.
037600 2-CLOSE-FILES-X.
037700     EXIT.
037800
037900
038000 2-BLOWUP.
           MOVE VIEW-NFNAME    TO  BU-DISPLAY-FLD (1).
           IF FILE-STATUS NUMERIC
               MOVE FILE-STATUS TO COND-WORD.
            CALL "TBLOWUP" USING BASE, BU-PGM-NAME, STATUS-AREA,
                  VIEW-COMAREA, FILE-STATUS, BU-DISPLAY-MSG,
                  BU-DISPLAY-FLDS.
042000 2-BLOWUP-X.
042100     EXIT.
042200
042300
042400 6-MAIN.
042500     MOVE ZERO         TO  PSWD-SUB,
042600                           TABLE-SUB.
042700     MOVE SPACE        TO  DE-BUFFER1.
           MOVE F-SELECT     TO  VIEW-NFNAME.

042800 6-SHOWFORM1.
           MOVE 3            TO  SRF-MODE.
           MOVE DE-BUFFER1   TO  SCREEN-BUFFER.
           CALL "TSHWRDFM" USING SRF-COMAREA, BU-DISPLAY-MSG,
                 VIEW-COMAREA, BASE, STATUS-AREA, SRF-SPOOLER-REC,
                 LANGUAGE-PARMS, SCREEN-BUFFER.
           IF BU-DISPLAY-MSG NOT = SPACES
               GO TO 2-BLOWUP.
           MOVE SCREEN-BUFFER TO DE-BUFFER1.
047000
047100     IF VIEW-LASTKEY = 1
047200         PERFORM  61-ADD  THRU  61-ADD-X
047700     ELSE
047800     IF VIEW-LASTKEY = 2
047900         PERFORM  62-CHANGE  THRU  62-CHANGE-X
048400     ELSE
048500     IF VIEW-LASTKEY = 5
048600         PERFORM  63-DELETE  THRU  63-DELETE-X
049100     ELSE
049200     IF VIEW-LASTKEY = 4
049300         PERFORM  64-INQUIRE  THRU  64-INQUIRE-X
049800     ELSE
049900     IF VIEW-LASTKEY = 6  OR
050000        VIEW-LASTKEY = 7  OR
050100        VIEW-LASTKEY = 8
050300         MOVE   9 TO LANG-SETNUM
050310         MOVE  10 TO LANG-MSGNUM
050320         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER TO DE1-MSG-LINE
               MOVE B"1"           TO IND(99)
               GO TO 6-SHOWFORM1
051000     ELSE
051100     IF VIEW-LASTKEY = 3
051200         GO TO  6-MAIN-X
051300     ELSE
      *SELECT THE APPROPRIATE FUNCTION KEY
051500         MOVE  19 TO LANG-SETNUM
051510         MOVE  13 TO LANG-MSGNUM
051520         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
051700         MOVE MESSAGE-BUFFER TO   DE1-MSG-LINE
               MOVE B"1" TO IND(99)
               GO TO 6-SHOWFORM1.
052000
052100     GO TO  6-MAIN.
052200
052300
052400 6-MAIN-X.
052500     EXIT.
052600
052700
052800 61-ADD.
052900     MOVE SPACE  TO  DE-BUFFER3.
053000     MOVE "30"   TO  DE3-LENGTH-VALID.
053200     MOVE F-ADD  TO  VIEW-NFNAME.
053300
       61-SHOWFORM3.
           MOVE 3            TO  SRF-MODE.
           MOVE DE-BUFFER3   TO  SCREEN-BUFFER.
           CALL "TSHWRDFM" USING SRF-COMAREA, BU-DISPLAY-MSG,
                 VIEW-COMAREA, BASE, STATUS-AREA, SRF-SPOOLER-REC,
                 LANGUAGE-PARMS, SCREEN-BUFFER.
           IF BU-DISPLAY-MSG NOT = SPACES
               GO TO 2-BLOWUP.
           MOVE SCREEN-BUFFER TO DE-BUFFER3.
057200     IF VIEW-LASTKEY = 3
057300         GO TO  61-ADD-X.
057400
057500     IF VIEW-LASTKEY = 1  OR
057600        VIEW-LASTKEY = 2  OR
057700        VIEW-LASTKEY = 4  OR
057800        VIEW-LASTKEY = 5  OR
057900        VIEW-LASTKEY = 6  OR
058000        VIEW-LASTKEY = 7  OR
058100        VIEW-LASTKEY = 8
058300         MOVE   9 TO LANG-SETNUM
058310         MOVE  10 TO LANG-MSGNUM
058320         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER TO DE3-MSG-LINE
               MOVE B"1"           TO IND(99)
058900         GO TO  61-SHOWFORM3.
059000
           IF DE3-EMPLOYEE-ID = SPACES
      *EMPLOYEE ID IS REQUIRED
               MOVE  66 TO LANG-SETNUM
               MOVE  58 TO LANG-MSGNUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER TO DE3-MSG-LINE
               MOVE B"1"           TO IND(1), IND(99)
               GO TO 61-SHOWFORM3.
      **   MOVE DE3-EMPLOYEE-ID TO EMPID-EDIT.
      **   IF ( EMPID-BYTE (1) = SPACES OR EMPID-BYTE (1) NUMERIC ) OR
      **      ( EMPID-BYTE (2) = SPACES OR EMPID-BYTE (2) NUMERIC ) OR
      *       ( EMPID-BYTE (3) = SPACES OR EMPID-BYTE (3) NUMERIC ) OR
      *       ( EMPID-BYTE (4) = SPACES OR EMPID-BYTE (4) NUMERIC )
      *EMPLOYEE ID MUST BE ALPHABETIC WITH NO EMPEDDED BLANKS
      *        MOVE  66 TO LANG-SETNUM
      *        MOVE  59 TO LANG-MSGNUM
      *        PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
      *        MOVE MESSAGE-BUFFER TO DE3-MSG-LINE
      *        MOVE B"1"           TO IND(1), IND(99)
      *        GO TO 61-SHOWFORM3.
           IF DE3-NEW-PSWD = SPACES
      *EMPLOYEE PASSWORD IS REQUIRED
               MOVE  66 TO LANG-SETNUM
               MOVE  60 TO LANG-MSGNUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER TO DE3-MSG-LINE
               MOVE B"1"           TO IND(2), IND(99)
               GO TO 61-SHOWFORM3.
           IF DE3-LENGTH-VALID = SPACES
      *TIME LENGTH OF PASSWORD VALIDITY IS REQUIRED
               MOVE  66 TO LANG-SETNUM
               MOVE  61 TO LANG-MSGNUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER TO DE3-MSG-LINE
               MOVE B"1"           TO IND(5), IND(99)
               GO TO 61-SHOWFORM3.
           IF DE3-LENGTH-VALID NOT NUMERIC
      *TIME LENGTH OF VALIDITY MUST BE NUMERIC
               MOVE  66 TO LANG-SETNUM
               MOVE  62 TO LANG-MSGNUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER TO DE3-MSG-LINE
               MOVE B"1"           TO IND(5), IND(99)
               GO TO 61-SHOWFORM3.
           IF DE3-AUTH-ID = SPACES
      *AUTHORIZATION ID IS REQUIRED
               MOVE  66 TO LANG-SETNUM
               MOVE  63 TO LANG-MSGNUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER TO DE3-MSG-LINE
               MOVE B"1"           TO IND(4), IND(99)
               GO TO 61-SHOWFORM3.
           MOVE DE3-AUTH-ID TO AUTHID-EDIT.
           IF ( AUTHID-BYTE (1) = SPACES OR AUTHID-BYTE (1) NUMERIC )
           OR ( AUTHID-BYTE (2) = SPACES OR AUTHID-BYTE (2) NUMERIC )
           OR ( AUTHID-BYTE (3) = SPACES OR AUTHID-BYTE (3) NUMERIC )
           OR ( AUTHID-BYTE (4) = SPACES OR AUTHID-BYTE (4) NUMERIC )
      *AUTHORIZATION ID MUST BE ALPHABETIC WITH NO EMBEDDED BLANKS
               MOVE  66 TO LANG-SETNUM
               MOVE  64 TO LANG-MSGNUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER TO DE3-MSG-LINE
               MOVE B"1"           TO IND(4), IND(99)
               GO TO 61-SHOWFORM3.
061200     MOVE SPACE             TO  PASSWORD-RCD.
061300     MOVE DE3-EMPLOYEE-ID   TO  PW-EMPLOYEE-ID.
061400     MOVE DE3-NEW-PSWD      TO  PW-CURRENT-PSWD.
061900     MOVE YMD-DATE          TO  PW-DATE-ADDED.
062000     MOVE DE3-LENGTH-VALID  TO  PW-LENGTH-VALID.
062100     MOVE DE3-AUTH-ID       TO  PW-AUTHORIZATION-ID.
062200
062300     WRITE INVPWFIL-REC-O FROM  PASSWORD-RCD.
062400     IF FILE-STATUS-1 = "2"
063000         MOVE   5 TO LANG-SETNUM
063010         MOVE  18 TO LANG-MSGNUM
063020         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER TO DE3-MSG-LINE
               MOVE B"1" TO IND(99), IND(1)
058900         GO TO  61-SHOWFORM3
           ELSE
           IF FILE-STATUS NOT = "00"
063900         MOVE "WRITE ERROR*61-ADD"  TO  BU-DISPLAY-MSG
064100         MOVE PW-EMPLOYEE-ID  TO  BU-DISPLAY-FLD (1)
               GO TO 2-BLOWUP.

           GO TO 61-ADD.
       61-ADD-X.
           EXIT.

       62-CHANGE.
           MOVE SPACE TO DE-BUFFER2.
           MOVE F-KEY TO VIEW-NFNAME.

       62-SHOWFORM2.
           MOVE 3            TO  SRF-MODE.
           MOVE DE-BUFFER2   TO  SCREEN-BUFFER.
           CALL "TSHWRDFM" USING SRF-COMAREA, BU-DISPLAY-MSG,
                 VIEW-COMAREA, BASE, STATUS-AREA, SRF-SPOOLER-REC,
                 LANGUAGE-PARMS, SCREEN-BUFFER.
           IF BU-DISPLAY-MSG NOT = SPACES
               GO TO 2-BLOWUP.
           MOVE SCREEN-BUFFER TO DE-BUFFER2.
057200     IF VIEW-LASTKEY = 3
057300         GO TO  62-CHANGE-X.

069600     IF VIEW-LASTKEY = 1  OR
069700        VIEW-LASTKEY = 2  OR
069800        VIEW-LASTKEY = 4  OR
069900        VIEW-LASTKEY = 5  OR
070000        VIEW-LASTKEY = 6  OR
070100        VIEW-LASTKEY = 7  OR
070200        VIEW-LASTKEY = 8
070400         MOVE   9 TO LANG-SETNUM
070410         MOVE  10 TO LANG-MSGNUM
058320         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER TO DE2-MSG-LINE
               MOVE B"1" TO IND(99)
058900         GO TO  62-SHOWFORM2.
           IF DE2-EMPLOYEE-ID = SPACES
      *EMPLOYEE ID IS REQUIRED
               MOVE  66 TO LANG-SETNUM
               MOVE  58 TO LANG-MSGNUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER TO DE2-MSG-LINE
               MOVE B"1"           TO IND(1), IND(99)
               GO TO 62-SHOWFORM2.
073300     MOVE DE2-EMPLOYEE-ID  TO  INVEMPID OF INVPWFIL-REC-O.
073400     READ INVPWFIL-O INTO PASSWORD-RCD
                INVALID KEY
074400             MOVE   5 TO LANG-SETNUM
074410             MOVE  17 TO LANG-MSGNUM
074420             PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE MESSAGE-BUFFER TO DE2-MSG-LINE
074600             MOVE B"1" TO IND(99), IND(1)
075000             GO TO  62-SHOWFORM2.
075800
075900 62-FILLBUFF4.
076000     MOVE SPACE            TO  DE-BUFFER4.
076100     MOVE PW-EMPLOYEE-ID   TO  DE4-EMPLOYEE-ID.
076200     MOVE PW-CURRENT-PSWD  TO  DE4-CURRENT-PSWD.
076300     MOVE PW-LENGTH-VALID  TO  DE4-LENGTH-VALID.
076400
076500     MOVE F-CHANGE         TO  VIEW-NFNAME.
076600
       62-SHOWFORM4.
           MOVE 3            TO  SRF-MODE.
           MOVE DE-BUFFER4   TO  SCREEN-BUFFER.
           CALL "TSHWRDFM" USING SRF-COMAREA, BU-DISPLAY-MSG,
                 VIEW-COMAREA, BASE, STATUS-AREA, SRF-SPOOLER-REC,
                 LANGUAGE-PARMS, SCREEN-BUFFER.
           IF BU-DISPLAY-MSG NOT = SPACES
               GO TO 2-BLOWUP.
           MOVE SCREEN-BUFFER TO DE-BUFFER4.
057200     IF VIEW-LASTKEY = 3
057300         GO TO  62-CHANGE-X.

069600     IF VIEW-LASTKEY = 1  OR
069700        VIEW-LASTKEY = 2  OR
069800        VIEW-LASTKEY = 4  OR
069900        VIEW-LASTKEY = 5  OR
070000        VIEW-LASTKEY = 6  OR
070100        VIEW-LASTKEY = 7  OR
070200        VIEW-LASTKEY = 8
070400         MOVE   9 TO LANG-SETNUM
070410         MOVE  10 TO LANG-MSGNUM
058320         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER TO DE4-MSG-LINE
               MOVE B"1" TO IND(99)
058900         GO TO  62-SHOWFORM4.
           MOVE B"0" TO SRF-INDICATORS.
           IF DE4-NEW-PSWD = SPACES
      *EMPLOYEE PASSWORD IS REQUIRED
               MOVE  66 TO LANG-SETNUM
               MOVE  60 TO LANG-MSGNUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER TO DE4-MSG-LINE
               MOVE B"1"           TO IND(3), IND(99)
               GO TO 62-SHOWFORM4.
           IF DE4-LENGTH-VALID = SPACES
      *TIME LENGTH OF PASSWORD VALIDITY IS REQUIRED
               MOVE  66 TO LANG-SETNUM
               MOVE  61 TO LANG-MSGNUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER TO DE4-MSG-LINE
               MOVE B"1"           TO IND(6), IND(99)
               GO TO 62-SHOWFORM4.
           IF DE4-LENGTH-VALID NOT NUMERIC
      *TIME LENGTH OF VALIDITY MUST BE NUMERIC
               MOVE  66 TO LANG-SETNUM
               MOVE  62 TO LANG-MSGNUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER TO DE4-MSG-LINE
               MOVE B"1"           TO IND(6), IND(99)
               GO TO 62-SHOWFORM4.
           IF DE4-AUTH-ID = SPACES
      *AUTHORIZATION ID IS REQUIRED
               MOVE  66 TO LANG-SETNUM
               MOVE  63 TO LANG-MSGNUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER TO DE4-MSG-LINE
               MOVE B"1"           TO IND(5), IND(99)
               GO TO 62-SHOWFORM4.
           MOVE DE4-AUTH-ID TO AUTHID-EDIT.
           IF ( AUTHID-BYTE (1) = SPACES OR AUTHID-BYTE (1) NUMERIC )
           OR ( AUTHID-BYTE (2) = SPACES OR AUTHID-BYTE (2) NUMERIC )
           OR ( AUTHID-BYTE (3) = SPACES OR AUTHID-BYTE (3) NUMERIC )
           OR ( AUTHID-BYTE (4) = SPACES OR AUTHID-BYTE (4) NUMERIC )
      *AUTHORIZATION ID MUST BE ALPABETIC WITH NO EMBEDDED BLANKS
               MOVE  66 TO LANG-SETNUM
               MOVE  64 TO LANG-MSGNUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER TO DE4-MSG-LINE
               MOVE B"1"           TO IND(5), IND(99)
               GO TO 62-SHOWFORM4.
084500 62-VALIDATE-PSWD.
084600     IF DE4-NEW-PSWD = PW-CURRENT-PSWD
      *THE NEW PASSWORD MUST BE DIFFERENT FROM THE CURRENT PASSWORD
084800         MOVE  20 TO LANG-SETNUM
084810         MOVE  16 TO LANG-MSGNUM
084820         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER TO DE4-MSG-LINE
               MOVE B"1" TO  IND(99), IND(3)
               GO TO 62-SHOWFORM4.
085500
085600 62-VALIDATE-LOOP.
085700     ADD +1  TO  PSWD-SUB.
085800
085900     IF PSWD-SUB > 12
086000         MOVE +12  TO  PSWD-SUB
086100         MOVE +13  TO  TABLE-SUB
086200         GO TO  62-UPDT-OPW-TABLE.
086300
086400     IF PW-OLD-PSWD (PSWD-SUB) = SPACE
086500         MOVE +12  TO  PSWD-SUB
086600         MOVE +13  TO  TABLE-SUB
086700         GO TO  62-UPDT-OPW-TABLE.
086800
086900     IF DE4-NEW-PSWD = PW-OLD-PSWD (PSWD-SUB)
087100         MOVE  20 TO LANG-SETNUM
087110         MOVE  17 TO LANG-MSGNUM
087120         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER TO DE4-MSG-LINE
               MOVE B"1" TO IND(99), IND(3)
087700         GO TO  62-SHOWFORM4
087800     ELSE
087900         GO TO  62-VALIDATE-LOOP.
088000
088100 62-UPDT-OPW-TABLE.
088200     SUBTRACT +1  FROM  PSWD-SUB.
088300     SUBTRACT +1  FROM  TABLE-SUB.
088400
088500     IF TABLE-SUB = 1
088600         GO TO  62-REWRITE.
088700
           MOVE PW-OLD-PSWD (PSWD-SUB)  TO  PW-OLD-PSWD (TABLE-SUB).
088900     GO TO  62-UPDT-OPW-TABLE.
089000
089100 62-REWRITE.
089200     MOVE PW-CURRENT-PSWD   TO  PW-OLD-PSWD (TABLE-SUB).
089300     MOVE DE4-NEW-PSWD      TO  PW-CURRENT-PSWD.
089800     MOVE YMD-DATE          TO  PW-DATE-CHANGED.
089900     MOVE DE4-LENGTH-VALID  TO  PW-LENGTH-VALID.
