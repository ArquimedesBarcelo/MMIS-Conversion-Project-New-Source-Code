031800
031900 PROCEDURE DIVISION USING HD-ROUTE-DATA, OPTION-AREA.
032000 0-BEGIN SECTION 01.
       BEGIN-HERE.
032100     PERFORM  1-HSK  THRU  1-HSK-X.
032200     PERFORM  6-MAIN  THRU  6-MAIN-X.
032300     PERFORM  2-CLOSE-FILES  THRU  2-CLOSE-FILES-X.
032400
032500     GOBACK.
032600
032700
032800 1-HSK.
9406CK     MOVE "C" TO SCOPE.
9406CK     CALL "MCXCBLERR" USING SCOPE.

032900     CALL "TESCSEQ" USING ESC-NAME.
033000     MOVE CHAR-1636PI TO COMPRESS-PRINT.
033100     MOVE CHAR-10PI   TO NORMAL-PRINT.
033200
           OPEN INPUT MPLTINFO-I, MSTORERM-I, MREQFILE-I, DREQITM-I,
                      MREQ-I, DPOITEM-I, DSHIPREL-I.

034100     MOVE "P 01"  TO  PLT-ARG.
           MOVE PLT-ARG TO PLTINFOKEY OF MPLTINFO-REC-I.
           READ MPLTINFO-I INTO BUF-MPLTINFO
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS  = "00"
035000         MOVE MPLTINFO-COMPANY  TO  COMPANY-SAVE
035100     ELSE
035200         MOVE "DBGET MPLTINFO*1-HSK"  TO  BU-DISPLAY-MSG
035300         GO TO  2-BLOWUP.
035400
035500****************************************************
035600**   GET VALID STOREROOM DEPTS AND LOAD INTO
035700**   A TABLE FOR CHECKING REQUISITION AND SHIPPING
035800**   RELEASE ENTRIES
035900****************************************************
036000
036100     MOVE "DSTR"                  TO  PLT-ARG.
           MOVE PLT-ARG TO PLTINFOKEY OF MPLTINFO-REC-I.
           READ MPLTINFO-I INTO BUF-MPLTINFO
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
036600             MOVE SPACES          TO  STOREROOM-DEPT-TABLE
036700         ELSE
036800             MOVE "GET MPLTINFO PSTR * 1-HSK" TO BU-DISPLAY-MSG
036900             GO TO 2-BLOWUP
037000     ELSE
037100         PERFORM 11-LOAD-STR-DEPTS  THRU  11-LSD-X
037200             VARYING SUB FROM 1 BY 1
037300                 UNTIL SUB > 6.
037400
037500     MOVE 1  TO  DATE-MODE.
037600     CALL "TDATECHK" USING DATE-CHECK-AREA.
037700     MOVE DATE-SLASH-OUT  TO  PRT-DATE.
037800     MOVE DATE-FORMATTED-TIME-OUT  TO  PRT-TIME.

      *----- CALL CCRTFILE TO CREATE A TEMPORARY FILE 'CODEFILE'
      *----- LIBRARY 'QTEMP' IS USED FOR TEMPORARY FILES
           MOVE SPACES        TO CCRTFILE-PARMS.
           MOVE "QTEMP"       TO CCRTFILE-LIBRARY.
           MOVE "CODEFILE"    TO CCRTFILE-FILE.
           MOVE "0087"        TO CCRTFILE-RECORD-LENGTH.
           MOVE "01000"       TO CCRTFILE-NO-RECORDS.
           MOVE "00500"       TO CCRTFILE-INCREMENT-AMT.
           MOVE "30"          TO CCRTFILE-NO-INCREMENTS.
           CALL "CCRTFILE" USING CCRTFILE-LIBRARY,
                                 CCRTFILE-FILE,
                                 CCRTFILE-RECORD-LENGTH,
                                 CCRTFILE-NO-RECORDS,
                                 CCRTFILE-INCREMENT-AMT,
                                 CCRTFILE-NO-INCREMENTS,
                                 CCRTFILE-STATUS.
           IF CCRTFILE-STATUS NOT = "00"
               MOVE "CCRTFILE CREATE OF 'CODEFILE' FAILED"
                  TO BU-DISPLAY-MSG
               GO TO 2-BLOWUP.
037900
038000 1-HSK-X.
038100     EXIT.
038200
038300
038400 11-LOAD-STR-DEPTS.
038500     MOVE MPLTINFO-DEPT-STR (SUB) TO  STORE-DEPT (SUB).
038600
038700 11-LSD-X.
038800     EXIT.
038900
039000
039100 2-CLOSE-FILES.
           CLOSE MPLTINFO-I, MSTORERM-I, MREQFILE-I, DREQITM-I,
                 MREQ-I, DPOITEM-I, DSHIPREL-I.
039900
040000 2-CLOSE-FILES-X.
040100     EXIT.
040200
040300
040400******************************************************
040500**                                                  **
040600**   BLOWUP ROUTINE                                 **
040700**                                                  **
040800******************************************************
040900
041000 2-BLOWUP.
041100     MOVE "TREQCHKT"              TO  BU-PGM-NAME.
041200     MOVE CODE-ARG                TO  BU-DISPLAY-FLD (1).
041300     CALL "TBLOWUP" USING BASE, BU-PGM-NAME, STATUS-AREA,
041400         DUMMY-VIEW-AREA, FILE-STATUS, BU-DISPLAY-MSG,
041500             BU-DISPLAY-FLDS.
041600
041700
041800
041900 6-MAIN.
042000     PERFORM 60-ACCEPT-OPTIONS  THRU  60-ACCEPT-OPTIONS-X.
042100
           MOVE SPACES TO CORPCDE OF MSTORERM-REC-I.
           START MSTORERM-I KEY > CORPCDE OF MSTORERM-REC-I
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
                   NEXT SENTENCE
               ELSE
                   MOVE "START MSTORERM * 6-M" TO BU-DISPLAY-MSG
                   GO TO 2-BLOWUP.

042200     OPEN OUTPUT CODE-FILE.
042300     PERFORM 61-GET-CODES  THRU  61-GC-X.
042400     CLOSE CODE-FILE.
042500
042600     SORT SORT-FILE ON ASCENDING KEY SORT-CODE
042700         USING CODE-FILE
042800         GIVING CODE-FILE.
042900
043000     OPEN INPUT CODE-FILE.
043100     PERFORM 62-PRINT-REPORT   THRU  62-PR-X.
043200     CLOSE CODE-FILE.
043300
043400 6-MAIN-X.
043500     EXIT.
043600
043700
043800
043900 60-ACCEPT-OPTIONS.
044100     DISPLAY "HD ROUTE DATA = ", HD-ROUTE-DATA.
044200
044300****************************************************
044400**   PRESENTLY THERE ARE NO OPTIONS FOR THIS REPORT
044500****************************************************
044600**
044700**   DISPLAY OPTION-AREA.
044800
044900 60-ACCEPT-OPTIONS-X.
045000     EXIT.
045100
045200
045300
045400***********************************************************
045500**                                                       **
045600**    READ MSTORERM CHECKING FOR CODES WITH AVAILABLE    **
045700**    LESS THAN REORDER POINT.                           **
045800**                                                       **
045900***********************************************************
046000
046100 61-GET-CODES.
           READ MSTORERM-I NEXT INTO BUF-MSTORERM
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
046600             GO TO 61-GC-X
046700         ELSE
046800             MOVE "GET MSTORERM *61-GC" TO BU-DISPLAY-MSG
046900             GO TO 2-BLOWUP.
047000
047100*****************************************
047200*                                       *
047300*   CALCULATE AVAILABLE                 *
047400*                                       *
047500*****************************************
047600
047700     SUBTRACT STR-RESERVED  FROM  STR-ONHAND
047800         GIVING AVAILABLE-ONHAND.
047900
048000     IF AVAILABLE-ONHAND < STR-REORDER
048100         NEXT SENTENCE
048200     ELSE
048300         GO TO 61-GET-CODES.
048400
048500***************************************************
048600**   CHECK IN THE 'MREQFILE' TO SEE IF THE CODE
048700**   IS IN THIS FILE. IF THE REQ-STATUS FLAG IS
048800**   EITHER SPACES OR 'M' THEN A REQUISITION WILL
048900**   BE CREATED FOR THIS CODE THE NEXT TIME
049000**   THE REQUISITION CREATE PROGRAM IS RAN 'MA1'.
049100**   THEREFORE THERE IS NO NEED TO CHECK THIS
049200**   CODE ANY FURTHER.
049300***************************************************
049400
049500     MOVE CORP-CODE               TO  CODE-ARG.
           MOVE CODE-ARG TO CORPCDE OF MREQFILE-REC-I.
           READ MREQFILE-I INTO BUF-MREQFILE
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
050000             NEXT SENTENCE
050100         ELSE
050200             MOVE "GET MREQFILE * 61-GC" TO BU-DISPLAY-MSG
050300             GO TO 2-BLOWUP
050400     ELSE
050500         IF MREQFILE-REQ-STATUS = "  " OR "M "
050600             GO TO 61-GET-CODES.
050700
050800************************************************
050900**   GET TOTAL STOREROOM ONORDER
051000**   BY CALLING 'SONORDER'
051100************************************************
051200     MOVE "Y"                     TO  SONORDER-CALC-DIR-ORD-SW.
051300     CALL "SONORDER" USING BASE,
051400                           CODE-ARG,
051500                           SONORDER-PARMS,
051600                           COMPANY-SAVE,
051700                           STATUS-AREA,
051800                           BU-DISPLAY-MSG,
051900                           BU-DISPLAY-FLDS.
052000     IF BU-DISPLAY-MSG NOT = SPACES
052100         GO TO 2-BLOWUP.
052200     IF AKRON-PLANT
052300         MOVE SONORDER-TOTAL-ONORDER TO SAVE-TOTAL-STR-ONORDER
052400     ELSE
052500         MOVE SONORDER-STR-ONORDER   TO SAVE-TOTAL-STR-ONORDER.
052600
052700*************************************************
052800**   ADD STOREROOM ONORDER AND AVAILABLE        *
052900**   AND COMPARE TO REORDER                     *
053000*************************************************
053100
053200     ADD SAVE-TOTAL-STR-ONORDER, AVAILABLE-ONHAND  GIVING
053300         TOTAL-ONORDER-ONHAND.
053400     IF TOTAL-ONORDER-ONHAND  <  STR-REORDER
053500         NEXT SENTENCE
053600     ELSE
053700         GO TO 61-GET-CODES.
053800
053900*******************************************************
054000**   GET ALL OPEN REQUISITIONS INCLUDING THOSE IN
054100**   THE BATCH SHIPPING RELEASE FILE AN DETERMINE
054200**   IF THIS IS A STOREROOM REQUISITION. IF SO ADD TO
054300**   TOTAL STOREROOM REQUISITION QUANTITY
054400*******************************************************
054500
054600 61-CHECK-FOR-OPEN-REQS.
054700     MOVE ZEROS                   TO  SAVE-ON-REQ-STR,
054800                                      SAVE-ON-REQ-DIR.
           MOVE CODE-ARG TO CORPCDE OF DREQITM-REC-I.
           START DREQITM-I KEY = CORPCDE OF DREQITM-REC-I
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
                   NEXT SENTENCE
               ELSE
055200             MOVE "FIND DREQITM * 61-CFOR"  TO  BU-DISPLAY-MSG
055300             GO TO 2-BLOWUP.
055400
055500 61-GET-DREQITM.
           READ DREQITM-I NEXT INTO BUF-DREQITM
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
056000             GO TO 61-CHECK-TOTAL-REQ-QTY
               ELSE
056200             MOVE "GET DREQITM * 61-GD"  TO  BU-DISPLAY-MSG
056300             GO TO 2-BLOWUP.
           IF CORPCDE OF DREQITM-REC-I NOT = CODE-ARG
056000         GO TO 61-CHECK-TOTAL-REQ-QTY.
056400
056500 61-GET-MREQ.
056600     MOVE REQITM-REQ-NUMBER    TO  REQ-ARG.
           MOVE REQ-ARG TO REQNO OF MREQ-REC-I.
           READ MREQ-I INTO BUF-MREQ
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
057000         MOVE "GET MREQ * 61-GM"  TO  BU-DISPLAY-MSG
057100         MOVE REQ-ARG             TO  BU-DISPLAY-FLD (2)
057200         GO TO 2-BLOWUP.
057300
057400*************************************************
057500*                                               *
057600*   CHECK FOR OPEN REQS. IF AN OPEN REQ IS      *
057700*   FOUND THEN CHECK DEPT. ON REQ TO SEE IF     *
057800*   THIS REQ. IS A STOREROOM REQ. IF IT IS      *
057900*   THEN ADD REQ. QUANTITY TO STOREROOM QTY.    *
058000*   ON REQ. ONCE ALL THE OPEN REQS. HAVE BEEN   *
058100*   FOUND THEN ADD TOTAL STR. REQ QUANTITY TO   *
058200*   TOTAL-ONORDER-ONHAND AND CHECK IF IT IS     *
058300*   GREATER THAN REORDER.                       *
058400*                                               *
058500*************************************************
058600
058700     IF REQ-RELEASE-STAT  =  "XX"
058800         IF REQ-HOLD-STATUS  =  "BATCHFILE"
058900             NEXT SENTENCE
059000         ELSE
059100             GO TO 61-GET-DREQITM.
059200
059300     MOVE REQ-SUBD                TO  DEPARTMENT.
059400     PERFORM 611-CHECK-FOR-STR-DEPT  THRU  611-CFSD-X.
059500     IF STR-DEPT
059600         ADD REQITM-QTY-TO-ORD    TO  SAVE-ON-REQ-STR
059700     ELSE
059800         ADD REQITM-QTY-TO-ORD    TO  SAVE-ON-REQ-DIR.
059900     GO TO 61-GET-DREQITM.
060000
060100 61-CHECK-TOTAL-REQ-QTY.
060200     ADD SAVE-ON-REQ-STR          TO  TOTAL-ONORDER-ONHAND.
060300     IF TOTAL-ONORDER-ONHAND  <  STR-REORDER
060400         NEXT SENTENCE
060500     ELSE
060600         GO TO 61-GET-CODES.
060700
060800*************************************************
060900*                                               *
061000*   CHECK TO SEE IF THERE IS ANY QUANTITY ON    *
061100*   THE DOCK BUT NOT YET STORED AND ADD THIS    *
061200*   QUANTITY TO ONORDER AND CHECK TO SEE        *
061300*   IF THIS TOTAL IS EQUAL OR GREATER TO        *
061400*   REORDER                                     *
061500*                                               *
061600*************************************************
061700
061800 61-CHECK-ITEM-ON-DOCK.
           MOVE CODE-ARG TO CORPCDE OF DPOITEM-REC-I.
           START DPOITEM-I KEY = CORPCDE OF DPOITEM-REC-I
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
                   NEXT SENTENCE
               ELSE
062200             MOVE "FIND DREQITM * 61-CIOD"  TO  BU-DISPLAY-MSG
062300             GO TO 2-BLOWUP.
062400
062500     MOVE ZEROS  TO  TOTAL-ON-DOCK, QTY-ON-DOCK.
062600
062700 61-GET-DPOITEM.
           READ DPOITEM-I NEXT INTO BUF-DPOITEM
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
063200             GO TO 61-CHECK-ON-DOCK
               ELSE
063400             MOVE "GET DREQITM * 61-GD"  TO  BU-DISPLAY-MSG
063500             GO TO 2-BLOWUP.
           IF CORPCDE OF DPOITEM-REC-I NOT = CODE-ARG
063200         GO TO 61-CHECK-ON-DOCK.
063600
063700**********************************************************
063800**   CONVERT ON DOCK QUANTITY INTO STOREROOM ON DOCK
063900**   QUANTITY BEFORE ADDING TO TOTAL-ONORDER-ONHAND
064000**********************************************************
064100     IF ITM-QTY-DLVR > ITM-QTY-STORED
064200         SUBTRACT ITM-QTY-STORED FROM ITM-QTY-DLVR GIVING
064300             QTY-ON-DOCK
064400         IF ITM-UM = STR-UM
064500             MULTIPLY QTY-ON-DOCK  BY 1 GIVING
064600                 STR-QTY-ON-DOCK ROUNDED
064700             ADD STR-QTY-ON-DOCK TO TOTAL-ON-DOCK
064800         ELSE
064900         IF ITM-UM = STR-UM1
065000             MULTIPLY QTY-ON-DOCK  BY  STR-UM1-CF GIVING
065100                 STR-QTY-ON-DOCK ROUNDED
065200             ADD STR-QTY-ON-DOCK  TO  TOTAL-ON-DOCK
065300         ELSE
065400         IF ITM-UM = STR-UM2
065500             MULTIPLY QTY-ON-DOCK  BY  STR-UM2-CF GIVING
065600                 STR-QTY-ON-DOCK ROUNDED
065700             ADD STR-QTY-ON-DOCK  TO  TOTAL-ON-DOCK.
065800     GO TO 61-GET-DPOITEM.
065900
066000 61-CHECK-ON-DOCK.
066100     ADD  TOTAL-ON-DOCK           TO  TOTAL-ONORDER-ONHAND.
066200     IF TOTAL-ONORDER-ONHAND < STR-REORDER
066300         NEXT SENTENCE
066400     ELSE
066500         GO TO 61-GET-CODES.
066600
066700*************************************************
066800**   DO A START ON 'DSHIPREL' GREATER THAN SPACES
066900**   SO YOU START SEQ. READ AT BEGINNING OF FILE
067000*************************************************
067100 61-CHECK-RELEASE-FILE.
      *------ KEY = DATECYMD INSTEAD OF DLYTCDTE SINCE DATABASE CHANGES.
      *    MOVE SPACES TO DLYTCDTE OF DSHIPREL-REC-I.
           MOVE SPACES TO DATECYMD OF DSHIPREL-REC-I.
      *    START DSHIPREL-I KEY > DLYTCDTE OF DSHIPREL-REC-I
           START DSHIPREL-I KEY > DATECYMD OF DSHIPREL-REC-I
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
                   NEXT SENTENCE
               ELSE
067500             MOVE "CLOSE DSHIPREL * 61-CRF"  TO  BU-DISPLAY-MSG
067600             GO TO 2-BLOWUP.
067700
067800     MOVE ZEROS  TO  REL-QTY-STR,  REL-QTY-DIR.
067900
068000******************************************************
068100**   READ SHIPPING RELEASE BATCH FILE 'DSHIPREL'
068200**   CHECKING FOR ORDER QUANTITY FOR THE CODE THAT
068300**   WILL BE PLACED ON THE NEXT SHIPPING RELEASE.
068400**   THIS QUANTITY IS ONLY COUNTED IF THE CODE WAS
068500**   PLACED IN THE RELEASE FILE WITHOUT A REQUISITION
068600**   SINCE THE REQUISITION QUANTITY WAS ALREADY COUNTED
068700**   ONCE.  THE TOTAL STOREROOM RELEASE QUANTITY IS
068800**   ADDED TO TOTAL-ONORDER-ONHAND AND COMPARED TO
068900**   THE REORDER POINT.
069000******************************************************
069100
069200 61-GET-DSHIPREL.
           READ DSHIPREL-I NEXT INTO BUF-DSHIPREL
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
069700             GO TO 61-CHECK-RELEASE-QTY
069800         ELSE
069900             MOVE "GET DSHIPREL * 61-GD"  TO  BU-DISPLAY-MSG
070000             GO TO 2-BLOWUP.
070100
070200     IF DREL-DSHIPREL-CODE = CODE-ARG
070300         NEXT SENTENCE
070400     ELSE
070500         GO TO 61-GET-DSHIPREL.
070600     IF DREL-REQ-NO = SPACES
070700         NEXT SENTENCE
070800     ELSE
070900         GO TO 61-GET-DSHIPREL.
      *****IF DREL-SEQ-NO = "99"
           IF DREL-SEQ-NO NOT = "00"
               GO TO 61-GET-DSHIPREL.
071000     MOVE DREL-NUMBER             TO  PO-NUM.
           MOVE CODE-ARG TO CORPCDE OF DPOITEM-REC-I.
           START DPOITEM-I KEY = CORPCDE OF DPOITEM-REC-I
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
                   NEXT SENTENCE
               ELSE
071400             MOVE "FIND DREQITM * 61-GD"  TO  BU-DISPLAY-MSG
071500             GO TO 2-BLOWUP.
071600
071700     MOVE ZEROS                   TO  STR-QTY-IN-REL.
071800
071900 61-GET-DPOITEM-REQ.
           READ DPOITEM-I NEXT INTO BUF-DPOITEM
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
072400             GO TO 61-GET-DSHIPREL
               ELSE
072600             MOVE "GET DPOITEM * 61-GD"  TO  BU-DISPLAY-MSG
072700             GO TO 2-BLOWUP.
           IF CORPCDE OF DPOITEM-REC-I NOT = CODE-ARG
072400         GO TO 61-GET-DSHIPREL.
072800
072900     IF BUILD-PO-NUM  =  ITM-PO-RCV-NO
073000         NEXT SENTENCE
073100     ELSE
073200         GO TO 61-GET-DPOITEM-REQ.
073300
073400********************************************************
073500**   CONVERT PENDING RELEASE QUANTITY INTO STOREROOM
073600**   RELEASE QUANTITY
073700********************************************************
073800     IF ITM-UM = STR-UM
073900         MULTIPLY DREL-QUANTITY  BY 1 GIVING
074000             STR-QTY-IN-REL ROUNDED
074100     ELSE
074200     IF ITM-UM = STR-UM1
074300         MULTIPLY DREL-QUANTITY  BY  STR-UM1-CF GIVING
074400             STR-QTY-IN-REL ROUNDED
074500     ELSE
074600     IF ITM-UM = STR-UM2
074700         MULTIPLY DREL-QUANTITY  BY  STR-UM2-CF GIVING
074800             STR-QTY-IN-REL ROUNDED.
074900     MOVE DREL-SUBD               TO  DEPARTMENT.
075000     PERFORM 611-CHECK-FOR-STR-DEPT  THRU  611-CFSD-X.
075100     IF STR-DEPT
075200         ADD STR-QTY-IN-REL       TO  REL-QTY-STR
075300     ELSE
075400         ADD STR-QTY-IN-REL       TO  REL-QTY-DIR.
075500     GO TO 61-GET-DSHIPREL.
075600
075700*********************************************************
075800**   IF TOTAL-ONORDER-ONHAND IS LESS THAN REORDER THEN
075900**   THE CODE HAS PASSED ALL TESTS AND WILL BE WRITTEN
076000**   TO A TEMPORARY FILE WHICH WILL BE USED TO PRODUCE
076100**   THE REPORT.
076200*********************************************************
076300
076400 61-CHECK-RELEASE-QTY.
076500     ADD REL-QTY-STR              TO  TOTAL-ONORDER-ONHAND.
076600     IF TOTAL-ONORDER-ONHAND  <  STR-REORDER
076700         NEXT SENTENCE
076800     ELSE
076900         GO TO 61-GET-CODES.
077000
077100 61-WRITE-TO-CODE-FILE.
077200     MOVE CORP-CODE               TO  C-CODE.
077300     MOVE STR-REORDER             TO  C-REORDER.
077400     MOVE AVAILABLE-ONHAND        TO  C-AVAILABLE.
077500     MOVE STR-RESERVED            TO  C-RESERVED.
077600     MOVE SAVE-TOTAL-STR-ONORDER  TO  C-STR-ONORDER.
077700     MOVE SONORDER-DIR-ONORDER    TO  C-DIR-ONORDER.
077800     MOVE TOTAL-ON-DOCK           TO  C-QTY-ON-DOCK.
077900     MOVE SAVE-ON-REQ-STR         TO  C-REQ-QTY-STR.
078000     MOVE SAVE-ON-REQ-DIR         TO  C-REQ-QTY-DIR.
078100     MOVE REL-QTY-STR             TO  C-REL-QTY-STR.
078200     MOVE REL-QTY-DIR             TO  C-REL-QTY-DIR.
078300     WRITE CODE-RECORD.
078400     GO TO 61-GET-CODES.
078500
078600 61-GC-X.
078700     EXIT.
078800
078900****************************************************
079000**   THIS ROUTINE CHECK A DEPARTMENT TO DETERMINE
079100**   IF IT IS A STOREROOM DEPT OR A DIRECT CHARGE
079200**   DEPARTMENT.
079300****************************************************
079400
079500 611-CHECK-FOR-STR-DEPT.
079600     IF AKRON-PLANT
079700         MOVE "Y"                 TO  STR-DEPT-SW
079800         GO TO 611-CFSD-X.
079900
080000     SET DEPT-SUB  TO  1.
080100     SEARCH STORE-DEPT
080200          AT END
080300             MOVE "N"             TO  STR-DEPT-SW
080400          WHEN STORE-DEPT (DEPT-SUB) = DEPARTMENT
080500             MOVE "Y"             TO  STR-DEPT-SW.
080600
080700 611-CFSD-X.
080800     EXIT.
080900
081000
081100
081200**********************************************************
081300**                                                      **
081400**    PRINT REPORT                                      **
081500**                                                      **
081600**********************************************************
081700
081800
081900 62-PRINT-REPORT.
082000     MOVE HD-SPOOLER-NUMBER       TO  OVRPRTF-TOFILE-NUM.
           MOVE "*YES"                  TO  OVRPRTF-SHARED.
082100     MOVE HD-NO-OF-COPIES         TO  OVRPRTF-COPIES.
           PERFORM 996-OVERRIDE-PRINT-FILE.

082800*********************************************************
082900**  AFTER OPENING THE PRINT FILE, GET ITS FILE NUMBER, **
083000**  AND PRINT THE HEADER PAGE.                         **
083100*********************************************************
083200
083300     OPEN OUTPUT PRINT-FILE.
083400
083700     MOVE "DHDR45.PUB"       TO  HD-FILE-NAME.
083800     CALL "THDPRT2" USING HD-RET-CODE, HD-FILE-NAME, FNUM
083900          HD-ROUTE-DATA, ESC-NAME.
084000     IF HD-RET-CODE NOT = 0
084100         MOVE "THDPRT2 ERR 62-PSR" TO BU-DISPLAY-MSG
084200         MOVE HD-RET-CODE       TO BU-DISPLAY-FLD (1)
084300         GO TO 2-BLOWUP.
084400
084500***********************************************************
084600**   IF PRINTING ON A CHARACTER PRINTER (HD-PAPER-FLAG   **
084700**   NOT = "X"), WE USE COMPRESSED PRINT TO FIT 132      **
084800**   CHARACTERS ON 8.5 IN WIDE PAPER.  ALSO, IF CP, WE   **
084900**   CHANGE THE TEXT LENGTH TO 61 LINES.                 **
085000***********************************************************
085100
085200     IF PAPER-IS-132-COLS
085300         NEXT SENTENCE
085400     ELSE
085500         WRITE PRINT-RCD FROM COMPRESS-PRINT AFTER ADVANCING 0.
085600
085700     PERFORM 621-PRINT-HEADER  THRU  621-PH-X.
085800     MOVE SPACES                  TO  AT-LEAST-ONE-ENTRY.
085900
086000*************************************************
086100**   READ TEMPORARY FILE 'CODEFILE' WHICH IS IN
086200**   SORTED ORDER AND PRODUCE THE REPORT
086300*************************************************
086400 62-READ-CODE-FILE.
086500     READ CODE-FILE
086600         AT END
086700             GO TO 62-CLOSE-FILES.
086800
086900     MOVE "Y"                     TO  AT-LEAST-ONE-ENTRY.
087000     MOVE C-CODE                  TO  CODE-OUT.
087100     MOVE C-REORDER               TO  REORDER-OUT.
087200     MOVE C-AVAILABLE             TO  AVAIL-OUT.
087300     MOVE C-RESERVED              TO  RESERVED-OUT.
087400     MOVE C-STR-ONORDER           TO  STR-ONORDER-OUT.
087500     MOVE C-DIR-ONORDER           TO  DIR-ONORDER-OUT.
087600     MOVE C-QTY-ON-DOCK           TO  QTY-DOCK-OUT.
087700     MOVE C-REQ-QTY-STR           TO  STR-REQ-QTY-OUT.
087800     MOVE C-REQ-QTY-DIR           TO  DIR-REQ-QTY-OUT.
087900     MOVE C-REL-QTY-STR           TO  STR-REL-QTY-OUT.
088000     MOVE C-REL-QTY-DIR           TO  DIR-REL-QTY-OUT.
088100     PERFORM 621-PRINT-DETAIL-LINE  THRU  621-PDL-X.
088200     GO TO 62-READ-CODE-FILE.
088300
088400 62-CLOSE-FILES.
088500     IF AT-LEAST-ONE-ENTRY = "Y"
088600         NEXT SENTENCE
088700     ELSE
088800         MOVE "    **** NO CODES QUALIFIED FOR REPORT ****"
088900             TO  PRINT-RCD
089000         WRITE PRINT-RCD AFTER ADVANCING 2 LINES
088800         MOVE "    **** NO CODES QUALIFIED FOR REPORT ****"
088900             TO  PRINT-RCD
089100         WRITE PRINT-RCD AFTER ADVANCING 2 LINES.
089200
089300     IF PAPER-IS-132-COLS
089400         NEXT SENTENCE
089500     ELSE
089600         WRITE PRINT-RCD FROM NORMAL-PRINT AFTER ADVANCING 0.
089700
090700     CLOSE PRINT-FILE.
090800
090900 62-PR-X.
091000     EXIT.
091100
091200**************************************************
091300**   PRINT HEADER LINES
091400**************************************************
091500 621-PRINT-HEADER.
091600     ADD 1                        TO  PAGE-CTR.
091700     MOVE PAGE-CTR                TO  PAGE-OUT.
091800     MOVE ZEROS                   TO  LINE-CTR.
091900     MOVE HEADER1                 TO  PRINT-LINE.
092000     WRITE PRINT-RCD AFTER ADVANCING NEW-PAGE.
092100     MOVE HEADER2                 TO  PRINT-LINE.
092200     WRITE PRINT-RCD AFTER ADVANCING 2 LINES.
092300     MOVE HEADER3                 TO  PRINT-LINE.
092400     WRITE PRINT-RCD AFTER ADVANCING 1 LINES.
092500     MOVE HEADER4                 TO  PRINT-LINE.
092600     WRITE PRINT-RCD AFTER ADVANCING 1 LINES.
092700     MOVE HEADER5                 TO  PRINT-LINE.
092800     WRITE PRINT-RCD AFTER ADVANCING 1 LINES.
092900     MOVE DASH-LINE               TO  PRINT-LINE.
093000     WRITE PRINT-RCD AFTER ADVANCING 1 LINES.
093100
093200 621-PH-X.
093300     EXIT.
093400
093500**************************************************
093600**   PRINT DETAIL LINE
093700**************************************************
093800 621-PRINT-DETAIL-LINE.
093900     ADD 2                        TO  LINE-CTR.
094000     IF LINE-CTR > 52
094100         PERFORM 621-PRINT-HEADER  THRU  621-PH-X.
094200     MOVE DETAIL-LINE-1           TO  PRINT-LINE.
094300     WRITE PRINT-RCD AFTER ADVANCING 2 LINES.
094400
094500 621-PDL-X.
094600     EXIT.

       COPY OVRPFCALL IN COPYLIB.
