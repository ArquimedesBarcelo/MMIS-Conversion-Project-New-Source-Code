       6540-PRINT-ONE-LINE.
228800     MOVE SPACES                     TO  PRINT-LINE.
228900     MOVE 1                          TO  LINE-ADV.
229000     PERFORM 651-PRINTALINE.

230400*******************************************************
230500*  FORMAT PRICE FIELD FOR FOREIGN DECIMAL FORMAT
230600*  AND $ SIGN WITH REGARD TO THE PLANT AND CURRENCY
230700*  CODE USED
230800*******************************************************
230900
231000 66-FORMAT-PRICE.
231100***************************************************
231200*  SURPRESS 3RD & 4TH ZERO TO THE RIGHT OF
231300*  OF THE DECIMAL
231400*  OF UNIT PRICE.
231500***************************************************
231600
231700     IF FOURTH-DEC-PRICE-POS = "0"
231800         MOVE " " TO FOURTH-DEC-PRICE-POS
231900         IF THIRD-DEC-PRICE-POS = "0"
232000             MOVE " " TO THIRD-DEC-PRICE-POS.
232100     IF FOREIGN-DECIMAL-SW = "Y"
232200         INSPECT PRTWK-PRICE-SPACE
232300             REPLACING ALL "$" BY " ", "." BY ",".
232400
232500     IF COMPANY-SAVE-1-DIGIT = "6"
232600         IF COMPANY-SAVE = "629" OR "630"
232700             IF PO-CURRENCY-CODE = "  " OR "01" OR "08"
232800                 NEXT SENTENCE
232900             ELSE
233000                 INSPECT PRTWK-PRICE-SPACE
233100                     REPLACING ALL "$" BY " "
233200         ELSE
233300             IF PO-CURRENCY-CODE = "01" OR "08"
233400                 NEXT SENTENCE
233500             ELSE
233600                 INSPECT PRTWK-PRICE-SPACE
233700                     REPLACING ALL "$" BY " "
233800     ELSE
      *********************************************************
      *    ADDED THE FOLLOWING LOGIC FOR THE PHILIPPINES
      *    12-18-96 AS THEY DID NOT WANT THE $ TO APPEAR
      *    FOR PRICES WHERE NO CURRENCY CODE WAS ASSIGNED
      *    BY THE BUYER OR PURCHASING CLERK.
      *********************************************************
           IF COMPANY-SAVE = "363" OR "364"
               IF PO-CURRENCY-CODE = "01" OR "08"
                   NEXT SENTENCE
               ELSE
               INSPECT PRTWK-PRICE-SPACE
                   REPLACING ALL "$" BY " "
           ELSE
233900         IF PO-CURRENCY-CODE = "  " OR "01" OR "08"
234000             NEXT SENTENCE
234100         ELSE
234200             INSPECT PRTWK-PRICE-SPACE
234300                 REPLACING ALL "$" BY " ".
234400
234500     IF PRICE-ALLOWED
234600         NEXT SENTENCE
234700     ELSE
234800         MOVE SPACES            TO  PRTWK-PRICE-SPACE.
234900
235000 66-FP-X.
235100     EXIT.
235200
235300
235400*******************************************************
