               IF COMPANY-SAVE = "173" OR "174" OR "129"
163600             MOVE "R"      TO  P-REPRINT-FLAGA
               ELSE
               MOVE "R"          TO  P-REPRINT-FLAG.
163700     MOVE 1 TO CTL.
163800     MOVE PRTWK-AREA       TO  PRNT-WORK-LINE.
163900     PERFORM 61-WRITE-PRNT-WORK-RCD.
           MOVE SPACES           TO  PRNT-WORK-LINE,
                                     PRTWK-AREA.

      *---------- IF MODIFIED OR CANCELLED ORDER, WRITE LITERAL.
           IF PO-MODIFIED-ORDER = "X" OR PO-CANCELLED-ORDER = "X"
               IF PO-MODIFIED-ORDER = "X"
                   MOVE MODIFIED-HEADING   TO  MOD-CANC-LITERAL
               ELSE
                   MOVE CANCELLED-HEADING  TO  MOD-CANC-LITERAL
               END-IF
               MOVE 1                      TO  CTL
               MOVE MOD-CANC-LINE          TO  PRNT-WORK-LINE
               PERFORM 61-WRITE-PRNT-WORK-RCD
               MOVE SPACES                 TO  PRNT-WORK-LINE.

