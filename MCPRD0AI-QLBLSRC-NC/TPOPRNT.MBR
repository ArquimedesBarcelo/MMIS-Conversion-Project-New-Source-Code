156200         IF COND-WORD = 17
156300             MOVE 7                  TO  LANG-MSGNUM
156400             PERFORM 999-CATREAD  THRU  999-CATREAD-EXIT
156500             MOVE MESSAGE-BUFFER     TO  PAYTO-VEN-INFO (1)
156600             GO TO 61-PRINT-VEN-INFO
156700         ELSE
156800             MOVE "FIND DVENDOR *61-GP" TO  BU-DISPLAY-MSG
156900             MOVE VEN-ARG               TO  BU-DISPLAY-FLD (2)
157000             GO TO 2-BLOWUP.
157100     MOVE 1 TO VEN-SUB.
157200
157300 61-GET-PAYTO-LOOP.
157400     ADD 1 TO VEN-SUB.
           MOVE 0 TO COND-WORD.
           READ DVENDOR-I NEXT INTO BUF-DVENDOR
               AT END MOVE 15 TO COND-WORD.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   MOVE 15 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.
           IF VENCDE OF DVENDOR-REC-I NOT = VEN-ARG
               MOVE 15 TO COND-WORD.
157500*    CALL "DBGET" USING BASE, DSET-DVENDOR, MODE5, STATUS-AREA,
157600*        ALL-ITEMS, BUF-DVENDOR, VEN-ARG.
157700     IF COND-WORD NOT = 0
157800         IF COND-WORD = 15
157900             GO TO 61-PRINT-VEN-INFO
158000         ELSE
158100             MOVE "GET DVENDOR * 61-GPL" TO  BU-DISPLAY-MSG
158200             MOVE VEN-ARG                TO  BU-DISPLAY-FLD (2)
158300             GO TO 2-BLOWUP.
158400     IF VEN-ITM-NO < 7
158500          MOVE VEN-ITM-DATA TO PAYTO-VEN-INFO (VEN-SUB)
158600          GO TO 61-GET-PAYTO-LOOP
158700     ELSE
158800     IF VEN-ITM-NO = 7
      *
      * 920-FIND-POSITION RETURNS THE POSITION TO PRINT THE NEXT ITEM
      * IN PRINT-POSITION
      *
                   IF ZIP-BEFORE-CITY

      *
      * ZIP CITY
      *
                     SET SAVE-ZIP-BEFORE-CITY TO TRUE
                     MOVE VEN-ZIP TO FIND-POSITION
                     PERFORM 920-FIND-POSITION
                     STRING VEN-CITY
                       DELIMITED BY SIZE INTO FIND-POSITION
                       WITH POINTER PRINT-POSITION
                     MOVE VEN-STATE-CODE TO SAVE-STATE-CODE
                     MOVE VEN-PROV-CODE TO SAVE-PROV-CODE

                   ELSE

      *
      * CITY STATE PROVINCE
      *
                     SET SAVE-ZIP-AFTER-COUNTRY TO TRUE
                     MOVE VEN-CITY TO FIND-POSITION
                     PERFORM 920-FIND-POSITION
                     STRING VEN-STATE-CODE
                       DELIMITED BY SIZE INTO FIND-POSITION
                       WITH POINTER PRINT-POSITION
                     PERFORM 920-FIND-POSITION
                     STRING VEN-PROV-CODE
                       DELIMITED BY SIZE INTO FIND-POSITION
                       WITH POINTER PRINT-POSITION
                     MOVE VEN-ZIP TO SAVE-ZIP

                   END-IF
                   MOVE FIND-POSITION TO PAYTO-VEN-INFO(VEN-SUB)
                   GO TO 61-GET-PAYTO-LOOP

154500     ELSE
154600     IF VEN-ITM-NO = 8
             IF SAVE-ZIP-BEFORE-CITY

      *
      * STATE PROV COUNTRY
      *
               MOVE SAVE-STATE-CODE TO FIND-POSITION
               PERFORM 920-FIND-POSITION
               STRING SAVE-PROV-CODE
                 DELIMITED BY SIZE INTO FIND-POSITION
                 WITH POINTER PRINT-POSITION
               PERFORM 920-FIND-POSITION
               STRING VEN-COUNTRY
                 DELIMITED BY SIZE INTO FIND-POSITION
                 WITH POINTER PRINT-POSITION

             ELSE

      *
      * COUNTRY ZIP
      *
               MOVE VEN-COUNTRY TO FIND-POSITION
               PERFORM 920-FIND-POSITION
               STRING SAVE-ZIP DELIMITED BY SIZE
                 INTO FIND-POSITION WITH POINTER PRINT-POSITION

             END-IF
             MOVE FIND-POSITION TO PAYTO-VEN-INFO(VEN-SUB)

           END-IF.
160700
160800 61-PRINT-VEN-INFO.
160900     MOVE 0 TO VEN-SUB.
161000
161100 61-PRINT-VEN-LOOP.
