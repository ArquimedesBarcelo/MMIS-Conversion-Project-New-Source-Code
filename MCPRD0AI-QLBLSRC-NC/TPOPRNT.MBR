235600*  PLANT AND CURRENCY CODE USED
235700*******************************************************
235800
235900 66-FORMAT-UNIT-VALUE.
236000     IF COMPANY-SAVE-1-DIGIT = "6"
236100         IF COMPANY-SAVE = "629" OR "630"
236200             IF PO-CURRENCY-CODE = "  " OR "01" OR "08"
236300                 NEXT SENTENCE
236400             ELSE
236500                 INSPECT PRTWK-ITEM-VALUE-SPACE
236600                     REPLACING ALL "$" BY " "
236700         ELSE
236800             IF PO-CURRENCY-CODE = "01" OR "08"
236900                 NEXT SENTENCE
237000             ELSE
237100                 INSPECT PRTWK-ITEM-VALUE-SPACE
237200                     REPLACING ALL "$" BY " "
237300     ELSE
237400         IF PO-CURRENCY-CODE = "  " OR "01" OR "08"
237500             NEXT SENTENCE
237600         ELSE
237700             INSPECT PRTWK-ITEM-VALUE-SPACE
237800                 REPLACING ALL "$" BY " ".
237900
238000 66-FUV-X.
238100     EXIT.
238200
238300
238400 66-CHECK-ITEM-TAX-CODES.
238500     MOVE SPACES                TO  SAVE-ITEM-TAX-CODE,
238600                                    PRINT-TAX-CODES-ITEM-SW.
238700     MOVE 1                     TO  SUB1.
238800     PERFORM 661-CHECK-TAX-ITEMS  THRU  661-CTI-X.
238900
239000 66-CITC-X.
239100     EXIT.
239200
239300 661-CHECK-TAX-ITEMS.
           MOVE 0 TO COND-WORD.
           MOVE PO-ARG TO PORCVNO OF DPOITEM-REC-I.
           START DPOITEM-I KEY = PORCVNO OF DPOITEM-REC-I
               INVALID KEY MOVE 0 TO COND-WORD.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
                   MOVE 0 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.
239400*A   CALL "DBFIND" USING BASE, DSET-DPOITEM, MODE1, STATUS-AREA,
239500*A       PO-SEARCH, PO-ARG.
239600     IF COND-WORD NOT = ZERO
239700         MOVE "FIND DPOITEM * 661-CTI"  TO  BU-DISPLAY-MSG
239800         GO TO 2-BLOWUP.
239900
240000 661-GET-DPOITEM.
           MOVE 0 TO COND-WORD.
           READ DPOITEM-I NEXT INTO BUF-DPOITEM
               AT END MOVE 15 TO COND-WORD.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   MOVE 15 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.
           IF PORCVNO OF DPOITEM-REC-I NOT = PO-ARG
               MOVE 15 TO COND-WORD.
240100*A   CALL "DBGET" USING BASE, DSET-DPOITEM, MODE5, STATUS-AREA,
240200*A       ALL-ITEMS, BUF-DPOITEM, PO-ARG.
240300     IF COND-WORD NOT = ZERO
240400         IF COND-WORD = 15
240500             GO TO 661-CTI-X
240600         ELSE
240700             MOVE "GET DPOITEM * 661-GD" TO BU-DISPLAY-MSG
240800             GO TO 2-BLOWUP.
240900
241000 661-CHECK-FOR-ITEMS.
241100     IF PRINT-SPECIFIC-ITEMS-SW = "Y"
             IF  SUB1 > 15
               GO TO 661-CTI-X
             ELSE
241200         IF PO-ITEM (SUB1) = ITM-NUMBER
241300             ADD 1                TO  SUB1
241400         ELSE
241500         IF PO-ITEM (SUB1) > ITM-NUMBER
241600             GO TO 661-GET-DPOITEM
241700         ELSE
241800             ADD 1                TO  SUB1
241900             IF SUB1 > 15
242000                 GO TO 661-CTI-X
242100             ELSE
242200                 GO TO 661-CHECK-FOR-ITEMS.
242300
242400     IF SAVE-ITEM-TAX-CODE = SPACES
242500         MOVE ITM-TAX-CODE      TO  SAVE-ITEM-TAX-CODE
242600         GO TO 661-GET-DPOITEM.
242700     IF SAVE-ITEM-TAX-CODE = ITM-TAX-CODE
242800         GO TO 661-GET-DPOITEM
242900     ELSE
243000         MOVE "Y"               TO  PRINT-TAX-CODES-ITEM-SW.
243100
243200 661-CTI-X.
243300     EXIT.
243400
      *
      * PARAGRAPH TO FIND THE POSITION TO PRINT THE NEXT ITEM IN
      *
       920-FIND-POSITION.
           MOVE TOTAL-LENGTH TO PRINT-POSITION.
           PERFORM UNTIL PRINT-POSITION < 1 OR
                         CHAR-POS(PRINT-POSITION) NOT EQUAL SPACE
             SUBTRACT 1 FROM PRINT-POSITION
           END-PERFORM.
           IF PRINT-POSITION < 1
             MOVE 1 TO PRINT-POSITION
           ELSE
             ADD 2 TO PRINT-POSITION
           END-IF.

       COPY OVRPFCALL IN COPYLIB.
243500
243600 999-CATREAD.
           IF CATREAD-MSG-NUMBER = ZEROS
               MOVE LANG-SETNUM TO CATREAD-MSG-SET
               MOVE LANG-MSGNUM TO CATREAD-MSG-NUM.
           CALL "CCATREAD" USING CATREAD-PARMS.
           MOVE CATREAD-MSG-TEXT TO MESSAGE-BUFFER.

245200 999-CATREAD-EXIT.
245300     EXIT.
