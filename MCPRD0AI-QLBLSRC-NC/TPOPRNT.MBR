           IF SAVE-FAX-FIRST-CHAR = "+"
               IF COMPANY-SAVE = "153"
                   MOVE 1            TO  CTL
               ELSE
                   MOVE ZERO         TO  CTL
               END-IF
               MOVE SAVE-FAX-NO      TO  PRNT-WORK-LINE
               PERFORM 61-WRITE-PRNT-WORK-RCD.

           MOVE PO-BUYER-CODE        TO  BUYERCDE OF MBUYER-REC-I.
           READ MBUYER-I INTO BUF-MBUYER
               INVALID KEY    MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               NEXT SENTENCE
           ELSE
           MOVE PO-BUYER         TO  P-BUYER
           MOVE PO-TYPIST        TO  P-TYPIST
           IF COMPANY-SAVE = "173" OR "174" OR "129"
               MOVE COMP-PRT-SEQ TO  P-COMPRESS-10A
               MOVE PO-BUYER     TO  P-BUYERA
               MOVE "("          TO  P-PAREN1A
               MOVE BPN-18       TO  P-BUYER-PHNUMA
               MOVE ")"          TO  P-PAREN2A
               MOVE REG-PRT-SEQ  TO  P-NORMAL-10A
               MOVE PO-TYPIST    TO  P-TYPISTA.
