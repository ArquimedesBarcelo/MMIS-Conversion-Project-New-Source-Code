150300
150400     MOVE BUILD-ADDL-INFO-LINE  TO  PAYTO-VEN-INFO (1).
150500
150600 61-GET-ORDFRM.
150700     MOVE PO-VEN-CODE  TO  VEN-ARG,
150800                           SAVE-VENDOR-CODE.
           MOVE 0 TO COND-WORD.
           MOVE VEN-ARG TO VENCDE OF DVENDOR-REC-I.
           START DVENDOR-I KEY = VENCDE OF DVENDOR-REC-I
               INVALID KEY MOVE 17 TO COND-WORD.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
                   MOVE 17 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.
150900*    CALL "DBFIND" USING BASE, DSET-DVENDOR, MODE1, STATUS-AREA,
151000*           VEN-SEARCH, VEN-ARG.
151100     IF COND-WORD NOT = 0
151200         MOVE "FIND DVENDOR * 61-GO"  TO  BU-DISPLAY-MSG
151300         MOVE VEN-ARG                 TO  BU-DISPLAY-FLD (2)
151400         GO TO 2-BLOWUP.
151500     MOVE 0 TO VEN-SUB.
151600
151700 61-GET-ORDFRM-LOOP.
151800     ADD 1 TO VEN-SUB.
           MOVE 0 TO COND-WORD.
           READ DVENDOR-I NEXT INTO BUF-DVENDOR
               AT END MOVE 15 TO COND-WORD.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   MOVE 15 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.
           IF VENCDE OF DVENDOR-REC-I NOT = VEN-ARG
               MOVE 15 TO COND-WORD.
151900*    CALL "DBGET" USING BASE, DSET-DVENDOR, MODE5, STATUS-AREA,
152000*        ALL-ITEMS, BUF-DVENDOR, VEN-ARG.
152100     IF COND-WORD NOT = 0
152200       IF COND-WORD = 15
152300         GO TO 61-GET-PAYTO
152400       ELSE
152500         MOVE "GET DVENDOR * 61-GOL"  TO  BU-DISPLAY-MSG
152600         MOVE VEN-ARG                 TO  BU-DISPLAY-FLD (2)
152700         GO TO 2-BLOWUP.
152800     IF VEN-ITM-NO < 7
152900         MOVE VEN-ITM-DATA TO ORDFRM-VEN-INFO (VEN-SUB)
153000         GO TO 61-GET-ORDFRM-LOOP
153100     ELSE
153200     IF VEN-ITM-NO = 7
      *
      * 920-FIND-POSITION RETURNS THE POSITION TO PRINT THE NEXT ITEM
      * IN PRINT-POSITION
      *
                   IF ZIP-BEFORE-CITY

      *
      * ZIP CITY
      *
                     SET SAVE-ZIP-BEFORE-CITY TO TRUE
                     MOVE VEN-ZIP TO FIND-POSITION
                     PERFORM 920-FIND-POSITION
                     STRING VEN-CITY
                       DELIMITED BY SIZE INTO FIND-POSITION
                       WITH POINTER PRINT-POSITION
                     MOVE VEN-STATE-CODE TO SAVE-STATE-CODE
                     MOVE VEN-PROV-CODE TO SAVE-PROV-CODE

                   ELSE

      *
      * CITY STATE PROVINCE
      *
                     SET SAVE-ZIP-AFTER-COUNTRY TO TRUE
                     MOVE VEN-CITY TO FIND-POSITION
                     PERFORM 920-FIND-POSITION
                     STRING VEN-STATE-CODE
                       DELIMITED BY SIZE INTO FIND-POSITION
                       WITH POINTER PRINT-POSITION
                     PERFORM 920-FIND-POSITION
                     STRING VEN-PROV-CODE
                       DELIMITED BY SIZE INTO FIND-POSITION
                       WITH POINTER PRINT-POSITION
                     MOVE VEN-ZIP TO SAVE-ZIP

                   END-IF
                   MOVE FIND-POSITION TO ORDFRM-VEN-INFO(VEN-SUB)
                   GO TO 61-GET-ORDFRM-LOOP

154500     ELSE
154600     IF VEN-ITM-NO = 8
             IF SAVE-ZIP-BEFORE-CITY

      *
      * STATE PROV COUNTRY
      *
               MOVE SAVE-STATE-CODE TO FIND-POSITION
               PERFORM 920-FIND-POSITION
               STRING SAVE-PROV-CODE
                 DELIMITED BY SIZE INTO FIND-POSITION
                 WITH POINTER PRINT-POSITION
               PERFORM 920-FIND-POSITION
               STRING VEN-COUNTRY
                 DELIMITED BY SIZE INTO FIND-POSITION
                 WITH POINTER PRINT-POSITION

             ELSE

      *
      * COUNTRY ZIP
      *
               MOVE VEN-COUNTRY TO FIND-POSITION
               PERFORM 920-FIND-POSITION
               STRING SAVE-ZIP DELIMITED BY SIZE
                 INTO FIND-POSITION WITH POINTER PRINT-POSITION

             END-IF
             MOVE FIND-POSITION TO ORDFRM-VEN-INFO(VEN-SUB)
             GO TO 61-GET-ORDFRM-LOOP
           ELSE
           IF VEN-ITM-NO = 9
             GO TO 61-GET-ORDFRM-LOOP
           ELSE
           IF VEN-ITM-NO = 10
      *
      * GET FAX NO FOR ELECTRONIC FAXING OF PO
      *
             MOVE VEN-FAX TO SAVE-FAX

           END-IF.
