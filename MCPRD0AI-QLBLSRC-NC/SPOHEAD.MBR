184600
184700 612-GET-DVENDOR.
           MOVE 0 TO COND-WORD.
           READ DVENDOR-O NEXT INTO BUF-DVENDOR
               AT END MOVE 15 TO COND-WORD.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   MOVE 15 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.
           IF VENCDE OF DVENDOR-REC-O NOT = VEN-ARG
               MOVE 15 TO COND-WORD.
184800*A   CALL "DBGET" USING BASE, DSET-DVENDOR, MODE5,
184900*A       STATUS-AREA, ALL-ITEMS, BUF-DVENDOR, VEN-ARG.
185000     IF COND-WORD NOT = 0
185100         IF COND-WORD = 15
185200             GO TO 612-FIND-DVENDITM
185300         ELSE
185400             MOVE "GET 612-GET-DVENDOR" TO BU-DISPLAY-MSG
185500             MOVE VEN-ARG           TO BU-DISPLAY-FLD (2)
185600             GO TO 2-BLOWUP.
           MOVE 0 TO COND-WORD.
           DELETE DVENDOR-O INVALID KEY MOVE "2" TO FILE-STATUS-1.
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD.
185700*A   CALL "DBDELETE" USING BASE, DSET-DVENDOR, MODE1,
185800*A       STATUS-AREA.
185900     IF COND-WORD NOT  =  0
186000         MOVE "DELETE 612-GET-DVENDOR" TO BU-DISPLAY-MSG
186100         MOVE VEN-ARG              TO BU-DISPLAY-FLD (2)
186200         GO TO 2-BLOWUP.
186300
186400     GO TO 612-GET-DVENDOR.
186500
186600 612-FIND-DVENDITM.
           MOVE 0 TO COND-WORD.
           MOVE VEN-ARG TO VENCDE OF DVENDITM2-REC-O.
           START DVENDITM2-O KEY = VENCDE OF DVENDITM2-REC-O
               INVALID KEY MOVE 0 TO COND-WORD.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
                   MOVE 0 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.
186700*A   CALL "DBFIND" USING BASE, DSET-DVENDITM, MODE1,
186800*A       STATUS-AREA, VEN-SEARCH, VEN-ARG.
186900     IF COND-WORD NOT = 0
187000         MOVE "FIND 612-FIND-DVENDITM" TO BU-DISPLAY-MSG
187100         MOVE VEN-ARG               TO BU-DISPLAY-FLD (2)
187200         GO TO 2-BLOWUP.
187300
187400 612-GET-DVENDITM.
           MOVE 0 TO COND-WORD.
           READ DVENDITM2-O NEXT INTO BUF-DVENDITM
               AT END MOVE 15 TO COND-WORD.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   MOVE 15 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.
           IF VENCDE OF DVENDITM2-REC-O NOT = VEN-ARG
               MOVE 15 TO COND-WORD.
187500*A   CALL "DBGET" USING BASE, DSET-DVENDITM, MODE5,
187600*A       STATUS-AREA, ALL-ITEMS, BUF-DVENDITM, VEN-ARG.
187700     IF COND-WORD NOT = 0
187800         IF COND-WORD = 15
187900             GO TO 612-DD-X
188000         ELSE
188100             MOVE "GET 612-GET-DVENDITM" TO BU-DISPLAY-MSG
188200             MOVE VEN-ARG           TO BU-DISPLAY-FLD (2)
188300             GO TO 2-BLOWUP.
           MOVE 0 TO COND-WORD.
           DELETE DVENDITM2-O INVALID KEY MOVE "2" TO FILE-STATUS-1.
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD.
188400*A   CALL "DBDELETE" USING BASE, DSET-DVENDITM, MODE1,
188500*A       STATUS-AREA.
188600     IF COND-WORD NOT  =  0
188700         MOVE "DELETE 612-GET-DVENDITM" TO BU-DISPLAY-MSG
188800         MOVE VEN-ARG              TO BU-DISPLAY-FLD (2)
188900         GO TO 2-BLOWUP.
189000
189100     GO TO 612-GET-DVENDITM.
190000
190100 612-DD-X.
190200     EXIT.
190300
190400 613-GET-DINVRCD.
           MOVE 0 TO COND-WORD.
           READ DINVRCD-I NEXT INTO BUF-DINVRCD
               AT END MOVE 15 TO COND-WORD.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   MOVE 15 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.
           IF PORCVNO OF DINVRCD-REC-I NOT = PO-ARG
               MOVE 15 TO COND-WORD.
190500*A   CALL "DBGET" USING BASE, DSET-DINVRCD, MODE5,
190600*A       STATUS-AREA, ALL-ITEMS, BUF-DINVRCD, PO-ARG.
190700     IF COND-WORD NOT = 0
190800         IF COND-WORD = 15
190900             NEXT SENTENCE
191000         ELSE
191100             MOVE "GET DINVRCD * 613-GD" TO BU-DISPLAY-MSG
191200             GO TO 2-BLOWUP
191300     ELSE
191400         IF INV-STATUS = "H" OR "I"
191500             NEXT SENTENCE
191600         ELSE
191700             MOVE "Y"             TO INVOICE-SW.
191800
191900********************************************************
192000**   THIS ROUTINE UPDATES LAST MARKET COST FOR ALL
192100**   CODED ITEMS IF THE CURRENCY CODE IS CHANGED
192200**   'SPOMSTRM' IS CALLED TO UPDATE MARKET COST.
192300********************************************************
192400
192500 614-UPDATE-MKT-COST.
           MOVE 0 TO COND-WORD.
           MOVE PO-ARG TO PORCVNO OF DPOITEM-REC-I.
           START DPOITEM-I KEY = PORCVNO OF DPOITEM-REC-I
               INVALID KEY MOVE 17 TO COND-WORD.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
                   MOVE 17 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.
192600*A   CALL "DBFIND" USING BASE, DSET-DPOITEM, MODE1,
192700*A       STATUS-AREA, PO-SEARCH, PO-ARG.
192800     IF COND-WORD NOT = 0
192900         MOVE "FIND DPOITEM * 614-UMC" TO BU-DISPLAY-MSG
193000         GO TO 2-BLOWUP.
193100
193200 614-GET-DPOITEM-LOOP.
           MOVE 0 TO COND-WORD.
           READ DPOITEM-I NEXT INTO BUF-DPOITEM
               AT END MOVE 15 TO COND-WORD.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   MOVE 15 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.
           IF PORCVNO OF DPOITEM-REC-I NOT = PO-ARG
               MOVE 15 TO COND-WORD.
193300*A   CALL "DBGET" USING BASE, DSET-DPOITEM, MODE5,
193400*A       STATUS-AREA, ALL-ITEMS, BUF-DPOITEM, PO-ARG.
193500     IF COND-WORD NOT = 0
193600         IF COND-WORD = 15
193700             GO TO 614-UMC-X
193800         ELSE
193900             MOVE "GET DPOITEM * 614-GDL" TO BU-DISPLAY-MSG
194000             GO TO 2-BLOWUP.
194100     IF ITM-CORP-CODE = "NON-STR"
194200         GO TO 614-GET-DPOITEM-LOOP.
194300
194400***********************************************
194500**   CALL 'SPOMSTRM' TO UPDATE MARKET COST
194600***********************************************
194700     MOVE COMPANY-SAVE            TO  SPOMSTRM-COMPANY-SAVE.
194800     MOVE ITM-QTY-ORD             TO  SPOMSTRM-QTY.
194900     MOVE ITM-UM                  TO  SPOMSTRM-QTY-UM.
195000     MOVE ITM-UNIT-PRICE          TO  SPOMSTRM-PRICE.
195100     MOVE ITM-PRICE-UM            TO  SPOMSTRM-PRICE-UM.
195200     MOVE ITM-CORP-CODE           TO  CODE-ARG.
      *---------- DO NOT UPDATE MARKET COST.
      *****IF ZBILL-PO
      *****    MOVE ITM-ZBILL-VALUE     TO  SPOMSTRM-UNIT-VALUE.
195300     MOVE SPACES                  TO  SPOMSTRM-PO-NUM,
195400                                      SPOMSTRM-PO-RLSE,
195500                                      SPOMSTRM-VEN-CODE.
195600     MOVE PO-CURRENCY-CODE        TO  SPOMSTRM-CUR-CODE.
195700     CALL "SPOMSTRM" USING BASE,
195800                           CODE-ARG,
195900                           SPOMSTRM-PARMS,
196000                           ZBILL-PO-SW,
196100                           STATUS-AREA,
196200                           BU-DISPLAY-MSG,
196300                           BU-DISPLAY-FLDS.
196400     IF BU-DISPLAY-MSG NOT = SPACES
196500         GO TO 2-BLOWUP.
196600
196700     GO TO 614-GET-DPOITEM-LOOP.
196800
196900 614-UMC-X.
197000     EXIT.
197100
080100 62-CHECK-FOR-RCVR-QTY.
           MOVE SPACES TO RCVR-SW.
           MOVE PO-ARG TO PORCVNO OF DPOITEM-REC-I.
           START DPOITEM-I KEY = PORCVNO OF DPOITEM-REC-I
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
                   GO TO 62-CFRQ-X
               ELSE
080500             MOVE "FIND DPOITEM * 62-CFRQ" TO BU-DISPLAY-MSG
080600             GO TO 2-BLOWUP.
080700
080800 62-GET-DPOITEM-LOOP.
           READ DPOITEM-I NEXT INTO BUF-DPOITEM
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14"
                   GO TO 62-CFRQ-X
               ELSE
081500             MOVE "GET DPOITEM * 62-CFRQ" TO BU-DISPLAY-MSG
081600             GO TO 2-BLOWUP.
           IF PORCVNO OF DPOITEM-REC-I NOT = PO-ARG
               GO TO 62-CFRQ-X
081700     ELSE
081800     IF ITM-QTY-DLVR = .0000
081900         GO TO 62-GET-DPOITEM-LOOP
082000     ELSE
082100     MOVE "Y" TO RCVR-SW.
084600
084700 62-CFRQ-X.
084800     EXIT.

DCR02 *****************************************************************
DCR02 *** F4 FIELD PROMPT ROUTINE
DCR02 *****************************************************************
DCR02  998-F4-PROMPT-RTN.

DCR02      IF  DE2-PROMPT-FLD-NAME(1:3) = "FOB"
DCR02          IF  ZFOB-USE-DBFILE-YES
DCR02              PERFORM  ZFOB-F4-PROMPT-RTN  THRU ZFOB-F4-EXIT
DCR02              IF  WS-ZFOB-FOB-DESC NOT = SPACE
DCR02                  MOVE WS-ZFOB-FOB-DESC  TO DE2-FOB
DCR02              END-IF
DCR02              GO TO 998-F4-EXIT
DCR02          END-IF
DCR02      END-IF.

DCR02      IF  DE2-PROMPT-FLD-NAME(1:3) = "VIA"
DCR02          IF  ZVIA-USE-DBFILE-YES
DCR02              PERFORM  ZVIA-PROMPT-RTN  THRU ZVIA-PROMPT-EXIT
DCR02              IF  WS-ZVIA-VIA-DESC NOT = SPACE
DCR02                  MOVE WS-ZVIA-VIA-DESC  TO DE2-VIA
DCR02              END-IF
DCR02              GO TO 998-F4-EXIT
DCR02          END-IF
DCR02      END-IF.

DCR02  998-F4-PROMPT-ERR.

DCR02      MOVE  44     TO LANG-SETNUM.
DCR02      MOVE  123    TO LANG-MSGNUM.
DCR02      PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
DCR02      MOVE MESSAGE-BUFFER TO DE2-MESSAGE-LINE
DCR02                             DE2-MESSAGE-LINE-E.
DCR02      PERFORM 4-PGM-ERROR  THRU  4-PGM-ERROR-X.

DCR02  998-F4-EXIT.
DCR02       EXIT.

DCR02 *****************************************************************
DCR02 *** F4 FIELD PROMPT ROUTINE  FOR "E" FORMAT
DCR02 *****************************************************************
DCR02  998E-F4-PROMPT-RTN.
DCR02
DCR02      IF  DE2-PROMPT-FLD-NAME-E(1:6) = "EDIFOB"
DCR01          IF  ZFOB-USE-DBFILE-YES
DCR01              PERFORM  ZFOB-F4-PROMPT-RTN  THRU ZFOB-F4-EXIT
DCR02              IF  WS-ZFOB-FOB-DESC NOT = SPACE
DCR02                  MOVE WS-ZFOB-FOB-DESC  TO DE2-FOB-E
DCR02              END-IF
DCR02              GO TO 998E-F4-EXIT
DCR02          END-IF
DCR02      END-IF.

DCR02      IF  DE2-PROMPT-FLD-NAME-E(1:6) = "EDIVIA"
DCR02          IF  ZVIA-USE-DBFILE-YES
DCR02              PERFORM  ZVIA-PROMPT-RTN  THRU ZVIA-PROMPT-EXIT
DCR02              IF  WS-ZVIA-VIA-DESC NOT = SPACE
DCR02                  MOVE WS-ZVIA-VIA-DESC  TO DE2-VIA-E
DCR02              END-IF
DCR02              GO TO 998E-F4-EXIT
DCR02          END-IF
DCR02      END-IF.

DCR02  998E-F4-PROMPT-ERR.

DCR02      MOVE  44     TO LANG-SETNUM.
DCR02      MOVE  123    TO LANG-MSGNUM.
DCR02      PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
DCR02      MOVE MESSAGE-BUFFER TO DE2-MESSAGE-LINE
DCR02                             DE2-MESSAGE-LINE-E.
DCR02      PERFORM 4-PGM-ERROR  THRU  4-PGM-ERROR-X.

DCR02  998E-F4-EXIT.
DCR02       EXIT.

       999-CATREAD.

           IF CATREAD-MSG-NUMBER = ZEROS
               MOVE LANG-SETNUM TO CATREAD-MSG-SET
               MOVE LANG-MSGNUM TO CATREAD-MSG-NUM
           END-IF.

           CALL "CCATREAD" USING CATREAD-PARMS.
           MOVE CATREAD-MSG-TEXT TO MESSAGE-BUFFER.

       999-CATREAD-EXIT.
           EXIT.

DCR01  COPY  ZFOBCDM1   IN COPYLIB.
DCR01  COPY  ZFOBCDM2   IN COPYLIB.
DCR02  COPY  ZVIACDM1   IN COPYLIB.
DCR02  COPY  ZVIACDM2   IN COPYLIB.
DCR01  COPY  ZMPLTSUBR  IN COPYLIB.
