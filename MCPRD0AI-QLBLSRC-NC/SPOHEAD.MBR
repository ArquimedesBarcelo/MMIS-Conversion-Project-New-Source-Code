111000
111100 61-UPDATE-DPORECD.
           MOVE PO-ARG TO PORCVNO OF DPORECD-REC-O.
           START DPORECD-O KEY = PORCVNO OF DPORECD-REC-O
               INVALID KEY MOVE "2" TO FILE-STATUS-1.
           IF FILE-STATUS NOT = "00"
               MOVE "START DPORECD *61-UD" TO BU-DISPLAY-MSG
               GO TO 2-BLOWUP.
           READ DPORECD-O NEXT INTO BUF-DPORECD
               AT END MOVE "1" TO FILE-STATUS-1.
           IF FILE-STATUS NOT = "00"
               MOVE "READ DPORECD * 61-UD" TO BU-DISPLAY-MSG
               GO TO 2-BLOWUP.
           IF PORCVNO OF DPORECD-REC-O NOT = PO-ARG
               MOVE "DPORECD PO DOESNT MATCH" TO BU-DISPLAY-MSG
               GO TO 2-BLOWUP.
111200     MOVE SAVE-SHIP-DATE-YMD      TO  PO-SHIP-DATE.
      *--------- ACCOUNT FOR CENTURY.
           IF PO-SHIP-YY = "  " OR PO-SHIP-YY NOT NUMERIC
               MOVE "  "                TO  PO-SHIP-DATE-CC
           ELSE
           IF PO-SHIP-YY > "70"
               MOVE "19"                TO  PO-SHIP-DATE-CC
           ELSE
               MOVE "20"                TO  PO-SHIP-DATE-CC.
           IF PO-DATE-YY = "  "
               MOVE "  "                TO  PO-DATE-CC
           ELSE
           IF PO-DATE-YY > "70"
               MOVE "19"                TO  PO-DATE-CC
           ELSE
               MOVE "20"                TO  PO-DATE-CC.
