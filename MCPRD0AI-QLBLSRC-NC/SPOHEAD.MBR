041000 MODIFY-HEADING SECTION 05.
       BEGIN-HERE.
           OPEN INPUT DPOITEM-I, MVALIDUM-I, MCOMMENT-I, MBUYER-I,
                      MPORCV-I, MPLTINFO-I, DINVRCD-I.
           OPEN I-O DPORECD-O, MSTORERM-O, DREQD-O, DVENDOR-O,
                    DVENDITM-O, DPODATAITM-O, DVENDITM2-O.

041100     PERFORM 61-MODIFY-HEADING  THRU  61-MH-X.

           CLOSE DPOITEM-I, MVALIDUM-I, MCOMMENT-I, MBUYER-I, MPORCV-I,
                 MPLTINFO-I, DINVRCD-I, DPORECD-O, MSTORERM-O, DREQD-O,
                 DVENDOR-O, DVENDITM-O, DPODATAITM-O, DVENDITM2-O.
041200     GOBACK.
041300
041400 2-BLOWUP.
041500     MOVE "SPOHEAD"        TO  BU-PGM-NAME.
           IF FILE-STATUS NUMERIC
               MOVE FILE-STATUS TO COND-WORD.
041600     CALL "TBLOWUP" USING BASE, BU-PGM-NAME, STATUS-AREA,
041700         VIEW-COMAREA, FILE-STATUS, BU-DISPLAY-MSG,
041800             BU-DISPLAY-FLDS.
041900
042000 2-BLOWUP-X.
042100     EXIT.
042200
045100
045200 4-PGM-ERROR.
           MOVE B"1" TO IND(FIELD-NUMBER), IND(99).
046000
046100 4-PGM-ERROR-X.
046200     EXIT.
048200
048300 61-MODIFY-HEADING.

           MOVE SPACES  TO SWITCH-AREA, RCVR-SW, INVOICE-SW,
                           STD-INST-SAVED SEDIVNCK-PARMS
                           RCV-INST-SAVED.


DCR01 **=============================================================
DCR01 ** USE ZFOB KEY TO DETERMINE IF TMS FOB PROCESS IS ACTIVE
DCR01 ** THIS WILL FORCE FOB DESC'S TO COME FROM FILE MCFPPOFOB
DCR01 **=============================================================
DCR01      SET  ZFOB-USE-DBFILE-NO TO TRUE.
DCR01      MOVE WS-ZFOB-KEY        TO  WS-ZMPLT-KEY.
DCR01      PERFORM ZMPLT-GET-MPLTINFO   THRU ZMPLT-EXIT.
DCR01      IF  WS-ZMPLT-PLTINFODTA(1:1) = "Y"
DCR01          SET  ZFOB-USE-DBFILE-YES TO TRUE
DCR01      END-IF.
DCR01 **=============================================================


DCR02 **=============================================================
DCR02 ** USE ZVIA KEY TO DETERMINE IF TMS VIA PROCESS IS ACTIVE
DCR02 ** THIS WILL FORCE VIA DESC'S TO COME FROM FILE MCFPPOVIA
DCR02 **=============================================================
DCR02      SET  ZVIA-USE-DBFILE-NO TO TRUE.
DCR02      MOVE WS-ZVIA-KEY        TO  WS-ZMPLT-KEY.
DCR02      PERFORM ZMPLT-GET-MPLTINFO   THRU ZMPLT-EXIT.
DCR02      IF  WS-ZMPLT-PLTINFODTA(1:1) = "Y"
DCR02          SET  ZVIA-USE-DBFILE-YES TO TRUE
DCR02      END-IF.
DCR02 **=============================================================

048400***********************************************************
048500**   CHECK TO SEE IF THE PLANT HAS CHOOSEN TO HAVE THEIR
048600**   PRICE INFO. CONVERTED TO LOCAL CURRENCY IF A FOREIGN
048700**   CURRENCY CODE IS ENTERED.  THE SWITCH WILL BE SET
048800**   TO 'Y' AND THE KEY IS 'CCHM' IN THE MPLTINFO DATA SET
048900***********************************************************
049000     MOVE "CCHM"                  TO  PLT-ARG.
           MOVE 0 TO COND-WORD.
           MOVE PLT-ARG TO PLTINFOKEY OF MPLTINFO-REC-I.
           READ MPLTINFO-I INTO BUF-MPLTINFO
               INVALID KEY MOVE 17 TO COND-WORD.
           IF FILE-STATUS-1 = "2"
               MOVE 17 TO COND-WORD
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD.
049100*A   CALL "DBGET" USING BASE, DSET-MPLTINFO, MODE7,
049200*A       STATUS-AREA, ALL-ITEMS, BUF-MPLTINFO, PLT-ARG.
049300     IF COND-WORD NOT = 0
049400         IF COND-WORD = 17
049500             MOVE SPACES          TO  CUR-CONV-SW
049600         ELSE
049700             MOVE "GET MPLTINFO *61-MH" TO BU-DISPLAY-MSG
049800             MOVE PLT-ARG         TO  BU-DISPLAY-FLD (3)
049900             GO TO 2-BLOWUP
050000     ELSE
050100         MOVE MPLTINFO-CUR-CONV-SW  TO  CUR-CONV-SW.
050200
050300     MOVE BUILD-PO-SEARCH         TO  PO-ARG,
                                            SEDIVNCK-PO-NUMBER,
050400                                      BU-DISPLAY-FLD (1).
           CALL "SEDIVNCK" USING BASE,
                                 SEDIVNCK-PARMS.

DCR02      SET E-SCREEN-NO       TO  TRUE.
           IF SEDIVNCK-EDI-IND = "Y"
               IF SEDIVNCK-INVLESS-IND = "Y"
                   MOVE "EPOMOD2I"       TO  VIEW-NFNAME
DCR02              SET E-SCREEN-YES      TO  TRUE
               ELSE
               IF PO-INVOICELESS-IND = "X"
                   MOVE "EPOMOD2I"       TO  VIEW-NFNAME
DCR02              SET E-SCREEN-YES      TO  TRUE
               ELSE
               IF PO-RLS-NO = "999"
                   MOVE "EPOMOD2I"       TO VIEW-NFNAME
DCR02              SET E-SCREEN-YES      TO  TRUE
               ELSE
               MOVE "EPOMOD2"            TO  VIEW-NFNAME
DCR02          SET E-SCREEN-YES      TO  TRUE
           ELSE
           IF SEDIVNCK-INVLESS-IND = "Y"
               MOVE "POMOD2I"            TO  VIEW-NFNAME
           ELSE
           IF PO-INVOICELESS-IND = "X"
               MOVE "POMOD2I"            TO  VIEW-NFNAME
           ELSE
           IF PO-RLS-NO = "999"
               MOVE "POMOD2I"            TO  VIEW-NFNAME
           ELSE
           MOVE "POMOD2"                 TO  VIEW-NFNAME.

051200 61-MOVE-HDG-DATA-TO-BUFF.
           MOVE SPACES                    TO  SCREEN-2 SCREEN-2E.
052200     MOVE COMPANY-SAVE              TO  DE2-COMPANY-CODE
                                              DE2-COMPANY-CODE-E.
           IF SEDIVNCK-EDI-IND = "Y"
               MOVE "EDI PO"              TO  DE2-EDILIT-E.
052300     MOVE PO-NO                     TO  DE2-PO-NO
                                              DE2-PO-NO-E.
052400     MOVE PO-REL                    TO  DE2-PO-REL
                                              DE2-PO-REL-E.
052500     MOVE 4                         TO  DATE-MODE.
052600     MOVE PO-DATE                   TO  DATE-VALIDATE-IN.
052700     CALL "TDATECK2" USING DATE-CHECK-AREA, LANGUAGE-PARMS.
052800     MOVE DATE-SLASH-OUT            TO  DE2-PO-DATE
                                              DE2-PO-DATE-E.
052900     IF PO-SHIP-DATE NUMERIC
053000         MOVE PO-SHIP-DATE          TO  DATE-VALIDATE-IN
053100         CALL "TDATECK2" USING DATE-CHECK-AREA LANGUAGE-PARMS
053200         MOVE DATE-OUT              TO  DE2-SHIP-DATE
                                              DE2-SHIP-DATE-E
053300     ELSE
053400         MOVE PO-SHIP-DATE          TO  DE2-SHIP-DATE
                                              DE2-SHIP-DATE-E.
053500     MOVE PO-EXPECT-DATE            TO  DATE-VALIDATE-IN.
053600     CALL "TDATECK2" USING DATE-CHECK-AREA, LANGUAGE-PARMS.
053700     MOVE DATE-OUT                  TO  DE2-EXP-DATE
                                              DE2-EXP-DATE-E.
053800     MOVE PO-VEN-CODE               TO  DE2-VEN-CODE
                                              DE2-VEN-CODE-E.
           IF VIEW-NFNAME = "POMOD2" OR "EPOMOD2"
               MOVE "          "          TO  DE2-INVOICELESS-LIT
                                              DE2-INVOICELESS-LIT-E
                                              DE2-NO-CHECK-LIT
                                              DE2-NO-CHECK-LIT-E
               MOVE " "                   TO  DE2-INVOICELESS-IND
                                              DE2-INVOICELESS-IND-E
                                              DE2-NO-CHECK
                                              DE2-NO-CHECK-E
           ELSE
           MOVE "INVLESS PO"              TO  DE2-INVOICELESS-LIT
                                              DE2-INVOICELESS-LIT-E
           MOVE PO-INVOICELESS-IND        TO  DE2-INVOICELESS-IND
                                              DE2-INVOICELESS-IND-E
           MOVE "NO CHECK  "              TO  DE2-NO-CHECK-LIT
                                              DE2-NO-CHECK-LIT-E
           MOVE PO-NO-CHECK-INDIC         TO  DE2-NO-CHECK
                                              DE2-NO-CHECK-E.
053900     MOVE PO-BUYER-CODE             TO  DE2-BUYER-CODE
                                              DE2-BUYER-CODE-E.
054000     MOVE PO-BUYER                  TO  DE2-BUYER-NAME
                                              DE2-BUYER-NAME-E.
054100     MOVE PO-TYPIST                 TO  DE2-TYPIST
                                              DE2-TYPIST-E.
054200     MOVE PO-RCV-DEPT               TO  DE2-REC-DEPT
                                              DE2-REC-DEPT-E.
054300     MOVE PO-FOR-DEPT               TO  DE2-FOR-DEPT
                                              DE2-FOR-DEPT-E.
054400     MOVE PO-ADDL-INFO              TO  DE2-ADDL-DATA
                                              DE2-ADDL-DATA-E.
054500     MOVE PO-VIA                    TO  DE2-VIA
                                              DE2-VIA-E.
054600     MOVE PO-FOLLOWUP-DATE          TO  DATE-VALIDATE-IN.
054700     CALL "TDATECK2" USING DATE-CHECK-AREA, LANGUAGE-PARMS.
054800     MOVE DATE-OUT                  TO  DE2-FOLLOWUP-DATE
                                              DE2-FOLLOWUP-DATE-E.
           MOVE PO-TRANSPORT-MODE         TO  DE2-TRANS-MODE-E.
           MOVE PO-TRANSPORT-CHGPAY       TO  DE2-TRANS-CHGPAY-E.
           MOVE PO-TRANSPORT-TERMS-OF-DEL TO  DE2-TERMS-DELIVERY-E.
054900     MOVE PO-BUDGET-NUMBER          TO  DE2-BUDGET-NO
                                              DE2-BUDGET-NO-E.
055000     MOVE PO-BUDGET-AMT             TO  DE2-BUDGET-AMT
                                              DE2-BUDGET-AMT-E.
055100     MOVE PO-REQ-NUMBER             TO  DE2-REQ-NUMBER
                                              DE2-REQ-NUMBER-E.
055200     MOVE PO-FOB                    TO  DE2-FOB
                                              DE2-FOB-E.
055300     MOVE PO-FREIGHT-TERMS          TO  DE2-FREIGHT-TERMS
                                              DE2-FREIGHT-TERMS-E.
055400     MOVE PO-INTERNAL-ORDER-INDIC   TO  DE2-IT-ORDER-INDIC
                                              DE2-IT-ORDER-INDIC-E.
055500     MOVE PO-TERMS                  TO  DE2-TERMS
                                              DE2-TERMS-E.
055600     MOVE PO-CURRENCY-CODE          TO  DE2-CURRENCY-CODE
                                              DE2-CURRENCY-CODE-E.
055700     MOVE PO-ALT-REMIT-INDIC        TO  DE2-ALT-REMIT
                                              DE2-ALT-REMIT-E.
055800     MOVE PO-NON-RCV-INDIC          TO  DE2-NON-RCV
                                              DE2-NON-RCV-E.
055900     PERFORM 611-LOAD-TERM-CUR-DESC  THRU  611-LTCD-X.
056000     PERFORM 611-GET-STD-INST  THRU  611-GSI-X.
056100     IF STD-INST-ENTRY-EXISTS = "Y"
056200         MOVE DATAITM-INFO        TO  STD-INST-SAVED
056300         MOVE SAVE-STD-INST-LIST  TO  DE2-STD-INST-LIST
                                            DE2-STD-INST-LIST-E
056400         MOVE SAVE-CONFIRMING-FLAG
056500                                  TO  DE2-CONFIRM-ORDER-INDIC
                                            DE2-CONFIRM-ORDER-INDIC-E
056600         MOVE SAVE-CONFIRM-VERBAGE
056700                                  TO  DE2-CONFIRM-FREE-VERB
                                            DE2-CONFIRM-FREE-VERB-E.
           PERFORM 611-GET-RCV-INST   THRU 611-GRI-X.
           IF RCV-INST-ENTRY-EXISTS = "Y"
               MOVE DATAITM-INFO        TO RCV-INST-SAVED
               MOVE SAVE-RCV-INST-LIST  TO DE2-RCV-INST-LIST
                                           DE2-RCV-INST-LIST-E.

057500 61-SHOWFORM-SCREEN-2.

DCR01      MOVE B"0"               TO IND(77).
DCR01      IF  ZFOB-USE-DBFILE-YES
DCR01          MOVE B"1"           TO IND(77)
DCR01      END-IF.

DCR02      MOVE B"0"               TO IND(78).
DCR02      IF  ZVIA-USE-DBFILE-YES
DCR02          MOVE B"1"           TO IND(78)
DCR02      END-IF.

           IF SEDIVNCK-EDI-IND = "Y"
               MOVE SCREEN-2E  TO SCREEN-BUFFER
           ELSE
           MOVE SCREEN-2       TO SCREEN-BUFFER.

           MOVE 3              TO SRF-MODE.
           CALL "TSHWRDFM" USING SRF-COMAREA, BU-DISPLAY-MSG,
               VIEW-COMAREA, BASE, STATUS-AREA, SRF-SPOOLER-REC,
               LANGUAGE-PARMS, SCREEN-BUFFER.


           IF BU-DISPLAY-MSG NOT = SPACES
               GO TO 2-BLOWUP.

           IF SEDIVNCK-EDI-IND = "Y"
               MOVE SCREEN-BUFFER          TO  SCREEN-2E
               MOVE DE2-COMPANY-CODE-E     TO  DE2-COMPANY-CODE
               MOVE DE2-PO-NO-E            TO  DE2-PO-NO
               MOVE DE2-PO-REL-E           TO  DE2-PO-REL
               MOVE DE2-PO-DATE-E          TO  DE2-PO-DATE
               MOVE DE2-SHIP-DATE-E        TO  DE2-SHIP-DATE
               MOVE DE2-EXP-DATE-E         TO  DE2-EXP-DATE
               MOVE DE2-VEN-CODE-E         TO  DE2-VEN-CODE
               MOVE DE2-INVOICELESS-LIT-E  TO  DE2-INVOICELESS-LIT
               MOVE DE2-INVOICELESS-IND-E  TO  DE2-INVOICELESS-IND
               MOVE DE2-NO-CHECK-LIT-E     TO  DE2-NO-CHECK-LIT
               MOVE DE2-NO-CHECK-E         TO  DE2-NO-CHECK
               MOVE DE2-BUYER-CODE-E       TO  DE2-BUYER-CODE
               MOVE DE2-BUYER-NAME-E       TO  DE2-BUYER-NAME
               MOVE DE2-TYPIST-E           TO  DE2-TYPIST
               MOVE DE2-FOR-DEPT-E         TO  DE2-FOR-DEPT
               MOVE DE2-REC-DEPT-E         TO  DE2-REC-DEPT
               MOVE DE2-ADDL-DATA-E        TO  DE2-ADDL-DATA
               MOVE DE2-VIA-E              TO  DE2-VIA
               MOVE DE2-FOLLOWUP-DATE-E    TO  DE2-FOLLOWUP-DATE
               MOVE DE2-BUDGET-NO-E        TO  DE2-BUDGET-NO
               MOVE DE2-BUDGET-AMT-E       TO  DE2-BUDGET-AMT
               MOVE DE2-REQ-NUMBER-E       TO  DE2-REQ-NUMBER
               MOVE DE2-FOB-E              TO  DE2-FOB
               MOVE DE2-FREIGHT-TERMS-E    TO  DE2-FREIGHT-TERMS
               MOVE DE2-TERMS-E            TO  DE2-TERMS
               MOVE DE2-PCT-DESC-E         TO  DE2-PCT-DESC
               MOVE DE2-DUE-DATE-DESC-E    TO  DE2-DUE-DATE-DESC
               MOVE DE2-CURRENCY-CODE-E    TO  DE2-CURRENCY-CODE
               MOVE DE2-CURRENCY-DESC-E    TO  DE2-CURRENCY-DESC
               MOVE DE2-IT-ORDER-INDIC-E   TO  DE2-IT-ORDER-INDIC
               MOVE DE2-ALT-REMIT-E        TO  DE2-ALT-REMIT
               MOVE DE2-NON-RCV-E          TO  DE2-NON-RCV
               MOVE DE2-CONFIRM-ORDER-INDIC-E
                                           TO  DE2-CONFIRM-ORDER-INDIC
               MOVE DE2-CONFIRM-FREE-VERB-E
                                           TO  DE2-CONFIRM-FREE-VERB
               MOVE DE2-STD-INST-LIST-E    TO  DE2-STD-INST-LIST
               MOVE DE2-RCV-INST-LIST-E    TO  DE2-RCV-INST-LIST
           ELSE
           MOVE SCREEN-BUFFER     TO SCREEN-2.

DCR01 **** ENTER KEY
DCR02      IF VIEW-LASTKEY = ZERO
DCR02          GO TO 61-FIELD-EDITS
DCR02      END-IF.

DCR02      IF VIEW-LASTKEY = 3
DCR02          GO TO 61-MH-X
DCR02      END-IF.

DCR02      IF  VIEW-LASTKEY = 4
DCR02          IF  E-SCREEN-NO
DCR02              PERFORM  998-F4-PROMPT-RTN   THRU 998-F4-EXIT
DCR02          ELSE
DCR02              PERFORM  998E-F4-PROMPT-RTN  THRU 998E-F4-EXIT
DCR02          END-IF
DCR02          GO TO 61-SHOWFORM-SCREEN-2
DCR02      END-IF.

DCR02      IF VIEW-LASTKEY = 7
DCR02          GO TO 61-MOVE-HDG-DATA-TO-BUFF
DCR02      END-IF.


062200*    *** INVALID FUNCTION KEY ***
062300     MOVE   9 TO LANG-SETNUM.
062400     MOVE  10 TO LANG-MSGNUM.
062500     PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
           MOVE MESSAGE-BUFFER TO DE2-MESSAGE-LINE
                                  DE2-MESSAGE-LINE-E.
062600     MOVE 11 TO  FIELD-NUMBER.
062700     PERFORM 4-PGM-ERROR  THRU  4-PGM-ERROR-X.
062800     GO TO 61-SHOWFORM-SCREEN-2.
062900
063000 61-FIELD-EDITS.
           IF DE2-PO-REL = "999"
               IF DE2-EXP-DATE = SPACES
      *-------- YOU MUST ENTER AN EXPIRATION DATE FOR A REQUIREMENT
                   MOVE 44112 TO CATREAD-MSG-NUMBER
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE MESSAGE-BUFFER TO DE2-MESSAGE-LINE
                                          DE2-MESSAGE-LINE-E
                   MOVE B"1" TO IND(12) IND(99)
                   GO TO 61-SHOWFORM-SCREEN-2.

           IF DE2-VEN-CODE = SPACES
      *------ YOU MUST ENTER A VENDOR CODE
               MOVE 66107 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER TO DE2-MESSAGE-LINE
                                      DE2-MESSAGE-LINE-E
               MOVE B"1" TO IND(22) IND(99)
               GO TO 61-SHOWFORM-SCREEN-2.

           IF DE2-BUYER-CODE = SPACES
      *------ YOU MUST ENTER A BUYER CODE
               MOVE 44036 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER TO DE2-MESSAGE-LINE
                                      DE2-MESSAGE-LINE-E
               MOVE B"1" TO IND(46) IND(99)
               GO TO 61-SHOWFORM-SCREEN-2.
065300
           IF DE2-TYPIST = SPACES
      *------ YOU MUST ENTER A TYPIST
               MOVE 44115 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER TO DE2-MESSAGE-LINE
                                      DE2-MESSAGE-LINE-E
               MOVE B"1" TO IND(5) IND(99)
               GO TO 61-SHOWFORM-SCREEN-2.

DCR02      IF  ZVIA-USE-DBFILE-YES
DCR02          IF DE2-VIA = SPACES
DCR02 ***    "YOU MUST ENTER VIA"
DCR02             MOVE  44 TO LANG-SETNUM
DCR02             MOVE 121 TO LANG-MSGNUM
DCR02             PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
DCR02             MOVE MESSAGE-BUFFER TO DE2-MESSAGE-LINE
DCR02                                    DE2-MESSAGE-LINE-E
DCR02             MOVE B"1" TO IND(19) IND(99)
DCR02             PERFORM 4-PGM-ERROR  THRU  4-PGM-ERROR-X
DCR02             GO TO 61-SHOWFORM-SCREEN-2
DCR02          END-IF
DCR02      END-IF.

           IF DE2-BUDGET-NO = SPACES
      *------ YOU MUST ENTER A BUDGET NUMBER
