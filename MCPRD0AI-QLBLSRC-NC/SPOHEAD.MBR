DCR02 **** IF SEDIVNCK-EDI-IND = "N" GO TO 61-GET-FOB-DESC.
DCR02      IF SEDIVNCK-EDI-IND = "N" GO TO 61-GET-VIA-DESC.
           MOVE DE2-TRANS-MODE-E TO BUILD-TM-VALUE.
           MOVE BUILD-TM-KEY     TO PLT-ARG.
           MOVE PLT-ARG TO PLTINFOKEY OF MPLTINFO-REC-I.
           READ MPLTINFO-I INTO BUF-MPLTINFO INVALID KEY
                MOVE 17 TO COND-WORD.
           IF COND-WORD NOT = 0
               IF COND-WORD = 17
                   MOVE   9 TO LANG-SETNUM
                   MOVE  67 TO LANG-MSGNUM
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE MESSAGE-BUFFER TO DE2-MESSAGE-LINE-E
                   MOVE 55 TO FIELD-NUMBER
                   PERFORM 4-PGM-ERROR THRU 4-PGM-ERROR-X
                   GO TO 61-SHOWFORM-SCREEN-2
               ELSE
               MOVE "GET MPLTINFO *63-VTM" TO BU-DISPLAY-MSG
               MOVE PLT-ARG TO BU-DISPLAY-FLD (2)
               GO TO 2-BLOWUP.

           IF DE2-TRANS-CHGPAY-E = "CC" OR "PP"
               NEXT SENTENCE
           ELSE
           MOVE   9 TO LANG-SETNUM
           MOVE  68 TO LANG-MSGNUM
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
           MOVE MESSAGE-BUFFER TO DE2-MESSAGE-LINE-E
           MOVE  56 TO FIELD-NUMBER
           PERFORM 4-PGM-ERROR THRU 4-PGM-ERROR-X
           GO TO 61-SHOWFORM-SCREEN-2.

           MOVE DE2-TERMS-DELIVERY-E TO BUILD-TOD-VALUE.
           MOVE BUILD-D-KEY          TO PLT-ARG.
           MOVE PLT-ARG TO PLTINFOKEY OF MPLTINFO-REC-I.
           READ MPLTINFO-I INTO BUF-MPLTINFO INVALID KEY
                MOVE 17 TO COND-WORD.
           IF COND-WORD NOT = 0
               IF COND-WORD = 17
                   MOVE   9 TO LANG-SETNUM
                   MOVE  69 TO LANG-MSGNUM
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE MESSAGE-BUFFER TO DE2-MESSAGE-LINE-E
                   MOVE  57 TO FIELD-NUMBER
                   PERFORM 4-PGM-ERROR THRU 4-PGM-ERROR-X
                   GO TO 61-SHOWFORM-SCREEN-2
               ELSE
               MOVE "GET MPLTINFO *63-TOD" TO BU-DISPLAY-MSG
               MOVE PLT-ARG                TO BU-DISPLAY-FLD (2)
               GO TO 2-BLOWUP.

