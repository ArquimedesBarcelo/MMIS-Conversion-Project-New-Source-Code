      *****************************************************
      **  THIS ROUTINE CHECKS ALL THE PO ITEMS LOOKING
      **  FOR ANY CONTAINING THE 'LT' UNIT OF MEASURE.
      **  DUE TO PROBLEMS ENCOUNTERD IN UNION CITY, IT
      **  WAS DECIDED THAT IF THE ITEM HAD AN 'LT' UNIT
      **  OF MEASURE, THE PURCHASE ORDER SHOULD NOT BE
      **  ALLOWED TO BE CHANGED FROM INVOICED TO
      **  INVOICELESS......JEC
      *****************************************************

136900 611-CHECK-4-UM-LT.
           MOVE 0 TO COND-WORD.
           MOVE PO-ARG TO PORCVNO OF DPOITEM-REC-I.
           START DPOITEM-I KEY = PORCVNO OF DPOITEM-REC-I
               INVALID KEY MOVE 0 TO COND-WORD.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
                   MOVE 0 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.
137200     IF COND-WORD NOT = 0
137300         MOVE "FIND DPOITEM * 611-C4UL" TO BU-DISPLAY-MSG
137400         GO TO 2-BLOWUP.
137500
