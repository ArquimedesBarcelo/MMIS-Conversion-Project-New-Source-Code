147700*A       STATUS-AREA, CODE-SEARCH, CODE-ARG.
147800     IF COND-WORD NOT = 0
147900         MOVE "FIND 611-FIND-DVENDITM"  TO  BU-DISPLAY-MSG
148000         MOVE CODE-ARG                  TO  BU-DISPLAY-FLD (2)
148100         GO TO 2-BLOWUP.
148200
148300 611-GET-DVENDITM.
           MOVE 0 TO COND-WORD.
           READ DVENDITM-O NEXT INTO BUF-DVENDITM
               AT END MOVE 15 TO COND-WORD.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   MOVE 15 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.
           IF CORPCDE OF DVENDITM-REC-O NOT = CODE-ARG
               MOVE 15 TO COND-WORD.
148400*A   CALL "DBGET" USING BASE, DSET-DVENDITM, MODE5,
148500*A       STATUS-AREA, ALL-ITEMS, BUF-DVENDITM, CODE-ARG.
148600     IF COND-WORD NOT = 0
148700         IF COND-WORD = 15
148800             GO TO 611-DVENDITM-CHECK
148900         ELSE
149000             MOVE "GET 611-GET-DVENDITM"  TO  BU-DISPLAY-MSG
149100             MOVE CODE-ARG                TO  BU-DISPLAY-FLD (2)
149200             GO TO 2-BLOWUP.
149300     IF DE2-VEN-CODE  =  VEN-ITM-VENCODE
149400         MOVE "Y"  TO  VENDITM-EXISTS-FLAG
149500         PERFORM 612-UPDATE-DVENDITM THRU 612-UD-X
149600         GO TO 611-GET-DVENDITM.
149700
149800     IF PO-VEN-CODE  =  VEN-ITM-VENCODE
149900         NEXT SENTENCE
150000     ELSE
150100         GO TO 611-GET-DVENDITM.
150200     IF (VEN-ITM-LT1 = 0) AND (VEN-ITM-LT2 = 0) AND
150300         (VEN-ITM-LT3 = 0) AND (VEN-QUOTE-FLAG NOT = "Q")
150400          NEXT SENTENCE
150500     ELSE
150600         GO TO 611-DVENDITM-CHECK.
150700
           MOVE 0 TO COND-WORD.
           DELETE DVENDITM-O INVALID KEY MOVE "2" TO FILE-STATUS-1.
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD.
