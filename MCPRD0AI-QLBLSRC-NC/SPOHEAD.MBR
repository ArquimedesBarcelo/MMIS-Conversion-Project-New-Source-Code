           IF DE2-FREIGHT-TERMS = "G" OR "P" OR "C" OR "U" OR
                                  "D" OR " "
               IF DE2-INVOICELESS-IND = "X"
                   IF DE2-FREIGHT-TERMS = " "
                       MOVE 06025 TO CATREAD-MSG-NUMBER
                       PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                       MOVE MESSAGE-BUFFER TO DE2-MESSAGE-LINE
                                              DE2-MESSAGE-LINE-E
