               MOVE 99 TO COND-WORD.
145500*A   CALL "DBGET" USING BASE, DSET-MSTORERM, MODE7,
145600*A       STATUS-AREA, ALL-ITEMS, BUF-MSTORERM, CODE-ARG.
145700     IF COND-WORD NOT  =  0
145800         MOVE "UPDATE 611-UPDATE-MSTORERM" TO BU-DISPLAY-MSG
145900         MOVE CODE-ARG                 TO BU-DISPLAY-FLD (2)
146000         GO TO 2-BLOWUP.
146100     IF PO-NO  =  STR-LAST-PO
146200         IF PO-REL  =  STR-LAST-RLSE
146300             MOVE DE2-VEN-CODE  TO  STR-LAST-VENDOR
146400         ELSE
146500             GO TO 611-FIND-DVENDITM
146600     ELSE
146700         GO TO 611-FIND-DVENDITM.
           MOVE 0 TO COND-WORD.
           REWRITE MSTORERM-REC-O FROM BUF-MSTORERM
               INVALID KEY MOVE 99 TO COND-WORD.
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD.
146800*A   CALL "DBUPDATE" USING BASE, DSET-MSTORERM, MODE1,
146900*A       STATUS-AREA, ALL-ITEMS, BUF-MSTORERM.
147000     IF COND-WORD NOT = 0
