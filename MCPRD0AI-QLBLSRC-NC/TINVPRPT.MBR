       COPY DATAB IN COPYLIB.

       01  DATASET-NAMES.
           05  DSET-NAME             PIC X(16)    VALUE SPACE.
           05  DSET-MPLTINFO         PIC X(16)    VALUE "MPLTINFO;".
           05  DSET-MPORCV           PIC X(16)    VALUE "MPORCV;".
           05  DSET-DPORECD          PIC X(16)    VALUE "DPORECD;".
           05  DSET-DPOITEM          PIC X(16)    VALUE "DPOITEM;".
           05  DSET-DRCVITEM         PIC X(16)    VALUE "DRCVITEM;".
           05  DSET-DPODATAITM       PIC X(16)    VALUE "DPODATAITM;".
           05  DVENDOR               PIC X(16)    VALUE "DVENDOR;".
           05  DSET-MSTORERM         PIC X(16)    VALUE "MSTORERM;".
           05  DSET-DDESC            PIC X(16)    VALUE "DDESC;".
           05  DPOFREIGHT            PIC X(16)    VALUE "DPOFREIGHT;".
           05  DINVRCD               PIC X(16)    VALUE "DINVRCD;".
           05  DINVACCT              PIC X(16)    VALUE "DINVACCT;".
           05  DINVITM               PIC X(16)    VALUE "DINVITM;".

       01  ITEMS-LISTING.
           05  ALL-ITEMS             PIC X(2)     VALUE "@;".
           05  PO-KEY-NAME           PIC X(10)    VALUE "PO-RCV-NO;".
           05  VEN-KEY-NAME          PIC X(10)    VALUE "VEN-CODE;".
           05  CODE-KEY-NAME         PIC X(10)    VALUE "CORP-CODE;".
           05  RS-KEY-NAME           PIC X(10)    VALUE "PO-RCV-NO;".
           05  REG-SEARCH            PIC X(16)
                                         VALUE "REGISTER-NUMBER;".
           05  VENDOR-SEARCH           PIC X(10)  VALUE "VEN-CODE;".

       01  ARGUMENT-VALUES.
           05  PLT-ARG               PIC X(4)     VALUE SPACE.
           05  REG-ARG               PIC X(6)     VALUE SPACES.
           05  PO-ARG.
               10  PO-NO-RLSE.
                   15  PO-PREFIX     PIC X        VALUE SPACE.
                   15  PO-NO         PIC X(7)     VALUE SPACE.
                   15  PO-RLSE       PIC X(3)     VALUE SPACE.
               10  PO-RS             PIC X(3)     VALUE SPACE.
           05  VEN-ARG.
               10  VEN-ARG1-7        PIC X(7)     VALUE SPACE.
               10  VEN-ARG8-10       PIC X(3)     VALUE SPACE.
           05  CORPCODE-ARG          PIC X(8)     VALUE SPACE.
           05  RS-ARG                PIC X(14)    VALUE SPACE.

