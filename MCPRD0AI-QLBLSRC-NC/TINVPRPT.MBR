      **      MPLTINFO      **
      ************************

       COPY MPLTINFO IN COPYLIB.
       COPY MPORCV   IN COPYLIB.
       COPY DPORECD  OF COPYLIB.
       COPY DPOITEM  OF COPYLIB.
       COPY DRCVITEM OF COPYLIB.
       COPY DPODATA  OF COPYLIB.
       COPY DVENDOR  OF COPYLIB.
       COPY DDESC    OF COPYLIB.
       COPY MSTORERM OF COPYLIB.
      ************************
      **     DPOFREIGHT     **
      ************************
       COPY DFREIGHT IN COPYLIB.

       COPY DINVRCD  IN COPYLIB.
       COPY DINVACCT IN COPYLIB.
       COPY DINVITM  IN COPYLIB.
