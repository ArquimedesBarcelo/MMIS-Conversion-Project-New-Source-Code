      **                                                         **
      **                    W O R K   A R E A                    **
      **                                                         **
      *************************************************************

       01  WORK-VENDOR.
           05  WORK-VEN              PIC X(7).
           05  FILLER                PIC X(3).

       01  PO-ENTRY.
           05  FILLER                PIC X       VALUE "P".
           05  PO-NUM                PIC X(10)   VALUE SPACES.
           05  PO-NUM-R REDEFINES PO-NUM.
               10  FILLER            PIC X(7).
               10  PO-NUM-RLSE       PIC X(3).
           05  FILLER                PIC X(3)    VALUE "000".

       01  X                         PIC 9 VALUE ZEROES.

       01  ORDER-VEN-TABLE.
           05  O-VEN-ADDR  OCCURS  3  TIMES
                                     PIC X(44).
       01  REMIT-VEN-TABLE.
           05  R-VEN-ADDR  OCCURS  3  TIMES
                                     PIC X(44).


       01  SAVE-COMPANY              PIC X(4)     VALUE SPACE.
       01  LINE-CTR                  PIC S9(4)    VALUE ZERO.
       01  PAGE-CTR                  PIC S9(4)    VALUE ZERO.
       01  CODED-ITEM-CTR            PIC S9(4)    VALUE ZERO.
       01  RCV-SLIP-CTR              PIC S9(4)    VALUE ZERO.
       01  RS-CALL-CTR               PIC S9(4)    VALUE ZERO.
       01  RS-PRT-CTR                PIC S9(4)    VALUE ZERO.
       01  NEW-RS-NO-SW              PIC X        VALUE SPACE.
       01  SAVE-NS-ITEM-NO           PIC 9(4)     VALUE ZERO.
       01  NEED-DESC-SW              PIC X        VALUE SPACE.
       01  GOOD-ITEM-SW              PIC X        VALUE SPACE.
       01  MORE-NS-ITEMS-SW          PIC X        VALUE SPACE.

       01  ALTER-PO-ARG.
           05  FILLER                PIC X(11)    VALUE SPACE.
           05  A-RS                  PIC 9(3)     VALUE ZERO.

       01  RCV-SLIP-TABLE.
           05  RCV-SLIP-NO  OCCURS  7  TIMES.
               10  RS-PREFIX         PIC X.
               10  RS-PO-NO          PIC X(7).
               10  RS-PO-RLSE        PIC X(3).
               10  RS-PO-RS          PIC X(3).

       COPY CDESC  IN COPYLIB.
       COPY CNDESC IN COPYLIB.
       COPY TDATECHK IN COPYLIB.
       COPY TBLOWUP  IN COPYLIB.
       01  VIEW-COMAREA.
           05  FILLER                  PIC X(118)  VALUE ALL "0".
           05  FILLER                  PIC S9(4)   COMP VALUE 9999.
       01  KSAM-STATUS                 PIC X(2)    VALUE SPACES.

      *---------- PARMS FOR CALL TO "THDPRT2" - HEADER PAGE SUBPROG.
       01  HD-RET-CODE                 PIC S9(4) COMP VALUE 0.
       01  HD-FILE-NAME                PIC X(17) VALUE "DHDR20.PUB".
       01  FNUM                        PIC S9(4) COMP VALUE 0.

       COPY ESCNAM2 IN COPYLIB.

       COPY CCHKOBJ   IN COPYLIB.
       COPY CCRTFILE  IN COPYLIB.
       COPY OVRPFDATA IN COPYLIB.

       LINKAGE SECTION.

       COPY THDPRTB IN COPYLIB.

       01  DATA-LINE                 PIC X(112).
       01  DATA-ENTRIES REDEFINES DATA-LINE.
           05  PO-ENTRY-WS OCCURS 8 TIMES  PIC X(10).
           05  FILLER                PIC X(32).

       PROCEDURE DIVISION USING HD-ROUTE-DATA, DATA-LINE.
       0-BEGIN SECTION 01.
           PERFORM  1-HSK  THRU  1-HSK-X.
           PERFORM  6-MAIN  THRU  6-MAIN-X.
           PERFORM  2-CLOSE-FILES  THRU  2-CLOSE-FILES-X.

           GOBACK.


       1-HSK.
9406CK     MOVE "C" TO SCOPE.
9406CK     CALL "MCXCBLERR" USING SCOPE.

           OPEN INPUT MPLTINFO-I, MPORCV-I, MSTORERM-I,
                      DPORECD-I, DPOITEM-I, DRCVITEM-I-PO,
                      DRCVITEM-I-CDE, DVENDOR-I, DPOFREIGHT-I-PO,
                      DPOFREIGHT-I-REG, DINVRCD-I, DINVACCT-I,
                      DINVITM-I, DPODATAITM-I.

           MOVE "P 01"  TO  PLT-ARG.
           MOVE PLT-ARG TO  PLTINFOKEY OF MPLTINFO-REC-I.
           READ MPLTINFO-I INTO BUF-MPLTINFO
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS = "00"
               MOVE MPLTINFO-COMPANY  TO  SAVE-COMPANY
           ELSE
               MOVE "DBGET MPLTINFO*1-HSK"  TO  BU-DISPLAY-MSG
               PERFORM 990-BLOWUP THRU 999-EXIT.

           MOVE 1                       TO  DATE-MODE.
           CALL "TDATECHK" USING DATE-CHECK-AREA.
           MOVE DATE-SLASH-OUT          TO  MH1-DATE.
           MOVE DATE-FORMATTED-TIME-OUT TO  MH1-TIME.

           MOVE "TINVPRPT"              TO  BU-PGM-NAME.

       1-HSK-X.
           EXIT.

       2-CLOSE-FILES.
           CLOSE  PRINT-FILE.

           CLOSE MPLTINFO-I, MPORCV-I, MSTORERM-I,
                 DPORECD-I, DPOITEM-I, DRCVITEM-I-PO,
                 DRCVITEM-I-CDE, DVENDOR-I, DPOFREIGHT-I-PO,
                 DPOFREIGHT-I-REG, DINVRCD-I, DINVACCT-I,
                 DINVITM-I, DPODATAITM-I.

       2-CLOSE-FILES-X.
           EXIT.


       6-MAIN.
           SORT SORT-FILE
               ASCENDING KEY  SD-PO-RLSE
               INPUT PROCEDURE IS  60-ACCEPT-PO-REQUESTS
               OUTPUT PROCEDURE IS  61-BUILD-REPORT.

       6-MAIN-X.
           EXIT.


       60-ACCEPT-PO-REQUESTS SECTION 02.

       60-ACCEPT-ENTRIES.
           MOVE 1 TO X.
           PERFORM 60-MOVE-ENTRIES 8 TIMES.
           GO TO 60-ACCEPT-ENTRIES-X.

       60-MOVE-ENTRIES.
           IF PO-ENTRY-WS (X) NOT = SPACES
              MOVE PO-ENTRY-WS (X) TO PO-NUM
              IF PO-NUM-RLSE = SPACES
                  MOVE ZEROS       TO PO-NUM-RLSE
              END-IF
              MOVE PO-ENTRY        TO SORT-RCD
              RELEASE SORT-RCD.
           ADD 1 TO X.

       60-ACCEPT-ENTRIES-X.
           EXIT.



       61-BUILD-REPORT SECTION 03.
       61-HEADER.
           IF HD-ROUTE-DATA = SPACES
              GO TO 61-REPORT.

      *---------- OPEN THE PRINT FILE, GET THE FILE NUMBER OF THE PRINT
      *---------- FILE, AND PRINT THE HEADER PAGE.

           MOVE HD-SPOOLER-NUMBER TO OVRPRTF-TOFILE-NUM.
           MOVE "*YES"            TO OVRPRTF-SHARED.
           MOVE HD-NO-OF-COPIES   TO OVRPRTF-COPIES.
           MOVE "MCPRT"           TO OVRPRTF-FILE.
           PERFORM 996-OVERRIDE-PRINT-FILE.
           OPEN OUTPUT PRINT-FILE.

           CALL "THDPRT2" USING HD-RET-CODE, HD-FILE-NAME, FNUM
             HD-ROUTE-DATA, ESC-NAME.
           IF HD-RET-CODE NOT = 0
               PERFORM 990-BLOWUP THRU 999-EXIT.

       61-REPORT.
           RETURN  SORT-FILE
               AT END  GO TO 61-REPORT-X.

           MOVE ZERO  TO  LINE-CTR.
           ADD +1     TO  PAGE-CTR.
           MOVE PAGE-CTR  TO  MH1-PAGE.
           WRITE  PRINT-RCD  FROM  MAJOR-HEAD1
                AFTER ADVANCING NEWPAGE.
           WRITE  PRINT-RCD  FROM  MAJOR-HEAD2
                AFTER ADVANCING 1 LINES.
           WRITE  PRINT-RCD  FROM  MAJOR-HEAD3
                AFTER ADVANCING 2 LINES.
           WRITE  PRINT-RCD  FROM  MAJOR-HEAD4
                AFTER ADVANCING 1 LINES.
           WRITE  PRINT-RCD  FROM  SUB-HEAD1
                AFTER ADVANCING 2 LINES.
           ADD +7  TO  LINE-CTR.

           MOVE SD-PO-RLSE  TO  PO-ARG.
           MOVE PO-ARG      TO  PORCVNO OF MPORCV-REC-I.
           READ MPORCV-I INTO BUF-MPORCV
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS-1 = "2"
               MOVE SPACE    TO  PRINT-RCD-WS
               MOVE PO-NO    TO  EPRT-PO
               MOVE "-"      TO  EPRT-H
               MOVE PO-RLSE  TO  EPRT-RLSE
               MOVE "***  PO DOES NOT EXIST  ***"  TO  EPRT-MESSAGE
               WRITE  PRINT-RCD  FROM  PRINT-RCD-WS
                   AFTER ADVANCING 1 LINES
               ADD +1  TO  LINE-CTR
               GO TO  61-REPORT
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE "READ MPORCV*61-REPORT"  TO  BU-DISPLAY-MSG
               MOVE PO-ARG  TO  BU-DISPLAY-FLD (1)
               PERFORM 990-BLOWUP THRU 999-EXIT.

           IF M-PO-BLK-INDIC = "B" OR " "
              MOVE ZEROES TO RCV-SLIP-CTR
           ELSE
              MOVE M-PO-LAST-RCVR  TO  RCV-SLIP-CTR.

       611-FIND-DPORECD.
           MOVE PO-ARG TO PORCVNO OF DPORECD-REC-I.
           READ DPORECD-I INTO BUF-DPORECD
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE "READ DPORECD*611-FD"  TO  BU-DISPLAY-MSG
               MOVE PO-ARG  TO  BU-DISPLAY-FLD (1)
               PERFORM 990-BLOWUP THRU 999-EXIT.

           MOVE SPACE              TO  PRINT-RCD-WS.
           MOVE PO-NO              TO  PPRT-PO.
           MOVE "-"                TO  PPRT-H.
           MOVE PO-RLSE            TO  PPRT-RLSE.
           IF PO-DATE NOT = SPACE
               MOVE 4              TO  DATE-MODE
               MOVE PO-DATE        TO  DATE-VALIDATE-IN
               CALL "TDATECHK" USING DATE-CHECK-AREA
               MOVE DATE-SLASH-OUT TO  PPRT-PO-DATE.
           MOVE PO-BUDGET-NUMBER   TO  PPRT-BUDGET-NO.
           MOVE PO-BUDGET-AMT      TO  PPRT-BUDGET-AMT.
           MOVE PO-TERMS           TO  PPRT-PO-TERMS.
           MOVE PO-SUB             TO  PPRT-SUB.
           MOVE PO-SUB-DET         TO  PPRT-SUBD.
           MOVE PO-ADDL-DATA       TO  PPRT-ADDL-DATA.
           MOVE PO-FOB             TO  PPRT-FOB.
           MOVE PO-BUYER           TO  PPRT-BUYER.
           WRITE  PRINT-RCD  FROM  PRINT-RCD-WS
               AFTER ADVANCING 1 LINES.
           ADD +1  TO  LINE-CTR.

           PERFORM  6111-TOP-CHECK  THRU  6111-TOP-CHECK-X.
           WRITE  PRINT-RCD  FROM  SUB-HEAD2
              AFTER ADVANCING 2 LINES.
           ADD +2  TO  LINE-CTR.

           MOVE SPACE        TO  PRINT-RCD-WS,
                                 ORDER-VEN-TABLE,
                                 REMIT-VEN-TABLE.
           MOVE PO-VEN-CODE  TO  VEN-ARG.
           MOVE VEN-ARG1-7   TO  VPRT-RVC7,
                                 VPRT-OVC7.
           MOVE "-"          TO  VPRT-RH,
                                 VPRT-OH.
           MOVE "000"        TO  VPRT-RVC3.
           MOVE VEN-ARG8-10  TO  VPRT-OVC3.
           IF VEN-ARG8-10 = "000"
               MOVE "***  SAME AS REMIT VENDOR INFORMATION  ***"
                             TO  O-VEN-ADDR (1)
               GO TO  612-FIND-PAYVEN.


       612-FIND-ORDVEN.
           MOVE VEN-ARG TO VENCDE OF DVENDOR-REC-I.
           START DVENDOR-I KEY = VENCDE OF DVENDOR-REC-I
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
                   GO TO 612-FIND-PAYVEN
               ELSE
               MOVE "DBFIND DVENDOR*612-FO"  TO  BU-DISPLAY-MSG
               MOVE VEN-ARG  TO  BU-DISPLAY-FLD (1)
               PERFORM 990-BLOWUP THRU 999-EXIT.

           MOVE ZERO  TO  VEN-SUB.

       612-LOAD-ORDVEN-TBL.
           READ DVENDOR-I NEXT INTO BUF-DVENDOR
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   GO TO 612-FIND-PAYVEN
               ELSE
                   MOVE "DBGET5 DVENDOR*612-LOT"  TO  BU-DISPLAY-MSG
                   MOVE VEN-ARG  TO  BU-DISPLAY-MSG
                   PERFORM 990-BLOWUP THRU 999-EXIT.
           IF VENCDE OF DVENDOR-REC-I NOT = VEN-ARG
               GO TO 612-FIND-PAYVEN.

           IF VEN-ITM-NO = 00
               ADD +1  TO  VEN-SUB
               MOVE VEN-NAME  TO  O-VEN-ADDR (VEN-SUB)
           ELSE
           IF VEN-ITM-NO = 01
               ADD +1  TO  VEN-SUB
               MOVE VEN-ADDRESS  TO  O-VEN-ADDR (VEN-SUB)
           ELSE
           IF VEN-ITM-NO = 07
               ADD +1  TO  VEN-SUB
               MOVE VEN-07-RCD  TO  O-VEN-ADDR (VEN-SUB).

           IF VEN-SUB > +2
               GO TO  612-FIND-PAYVEN
           ELSE
               GO TO  612-LOAD-ORDVEN-TBL.

       612-FIND-PAYVEN.
           MOVE "000"  TO  VEN-ARG8-10.

           MOVE VEN-ARG TO VENCDE OF DVENDOR-REC-I.
           START DVENDOR-I KEY = VENCDE OF DVENDOR-REC-I
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
                   GO TO 612-WRITE-VENDOR-LINES
               ELSE
               MOVE "DBFIND DVENDOR*612-FP"  TO  BU-DISPLAY-MSG
               MOVE VEN-ARG  TO  BU-DISPLAY-FLD (1)
               PERFORM 990-BLOWUP THRU 999-EXIT.

           MOVE ZERO  TO  VEN-SUB.

       612-LOAD-PAYVEN-TBL.
           READ DVENDOR-I NEXT INTO BUF-DVENDOR
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   GO TO 612-WRITE-VENDOR-LINES
               ELSE
                   MOVE "DBGET5 DVENDOR*612-LPT"  TO  BU-DISPLAY-MSG
                   MOVE VEN-ARG  TO  BU-DISPLAY-FLD (1)
                   PERFORM 990-BLOWUP THRU 999-EXIT.
           IF VENCDE OF DVENDOR-REC-I NOT = VEN-ARG
               GO TO 612-WRITE-VENDOR-LINES.

           IF VEN-ITM-NO = 00
               ADD +1  TO  VEN-SUB
               MOVE VEN-NAME  TO  R-VEN-ADDR (VEN-SUB)
           ELSE
           IF VEN-ITM-NO = 01
               ADD +1  TO  VEN-SUB
               MOVE VEN-ADDRESS  TO  R-VEN-ADDR (VEN-SUB)
           ELSE
           IF VEN-ITM-NO = 07
               ADD +1  TO  VEN-SUB
               MOVE VEN-07-RCD  TO  R-VEN-ADDR (VEN-SUB).

           IF VEN-SUB > +2
               GO TO  612-WRITE-VENDOR-LINES
           ELSE
               GO TO  612-LOAD-PAYVEN-TBL.

       612-WRITE-VENDOR-LINES.
           MOVE R-VEN-ADDR (1)  TO  VPRT-REMIT-INFO.
           MOVE O-VEN-ADDR (1)  TO  VPRT-ORDER-INFO.
           WRITE  PRINT-RCD  FROM  PRINT-RCD-WS
               AFTER ADVANCING 1 LINES.

           MOVE SPACE           TO  PRINT-RCD-WS.
           MOVE R-VEN-ADDR (2)  TO  VPRT-REMIT-INFO.
           MOVE O-VEN-ADDR (2)  TO  VPRT-ORDER-INFO.
           WRITE  PRINT-RCD  FROM  PRINT-RCD-WS
               AFTER ADVANCING 1 LINES.

           MOVE SPACE           TO  PRINT-RCD-WS.
           MOVE R-VEN-ADDR (3)  TO  VPRT-REMIT-INFO.
           MOVE O-VEN-ADDR (3)  TO  VPRT-ORDER-INFO.
           WRITE  PRINT-RCD  FROM  PRINT-RCD-WS
               AFTER ADVANCING 1 LINES.
           ADD +3  TO  LINE-CTR.

       613-INVOICE-COMMENTS.
           PERFORM  6131-FIND-DPODATAITM  THRU
                                          6131-FIND-DPODATAITM-X.

       615-CODED-ITEMS.
           MOVE PO-ARG TO PORCVNO OF DPOITEM-REC-I.
           START DPOITEM-I KEY = PORCVNO OF DPOITEM-REC-I
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE "START DPOITEM*615-CI"  TO  BU-DISPLAY-MSG
               MOVE PO-ARG  TO  BU-DISPLAY-FLD (1)
               PERFORM 990-BLOWUP THRU 999-EXIT.

       615-CODED-ITEM-LOOP.
           READ DPOITEM-I NEXT INTO BUF-DPOITEM
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   MOVE PO-ARG  TO  ALTER-PO-ARG
                   MOVE ZERO    TO  RS-CALL-CTR
                   MOVE ZERO    TO  RS-PRT-CTR
                   GO TO  615-RS-INFO-NEXT
               ELSE
                   MOVE "DBGET5 DPOITEM*615-CIL"  TO  BU-DISPLAY-MSG
                   MOVE PO-ARG  TO  BU-DISPLAY-FLD (1)
                   PERFORM 990-BLOWUP THRU 999-EXIT.
           IF PORCVNO OF DPOITEM-REC-I NOT = PO-ARG
                   MOVE PO-ARG  TO  ALTER-PO-ARG
                   MOVE ZERO    TO  RS-CALL-CTR
                   MOVE ZERO    TO  RS-PRT-CTR
                   GO TO  615-RS-INFO-NEXT.

           PERFORM  6111-TOP-CHECK  THRU  6111-TOP-CHECK-X.
           WRITE  PRINT-RCD  FROM  SUB-HEAD4
              AFTER ADVANCING 2 LINES.
           ADD +2  TO  LINE-CTR.
           MOVE SPACE             TO  PRINT-RCD-WS.
           MOVE ITM-NUMBER        TO  IPRT-ITEM-NO.
           MOVE ITM-CORP-CODE     TO  IPRT-CORPCODE,
                                      CORPCODE-ARG.
           MOVE ITM-UM            TO  IPRT-QTY-UM.
           MOVE ITM-QTY-ORD     TO  IPRT-QTY-ORD.
           MOVE ITM-QTY-DLVR    TO  IPRT-QTY-DEL.
           MOVE ITM-QTY-STORED  TO  IPRT-QTY-STR.
           MOVE ITM-PRICE-UM      TO  IPRT-PRC-UM.
           MOVE ITM-UNIT-PRICE  TO  IPRT-UNIT-PRC.
           MOVE ITM-QTY-PAID      TO  IPRT-PREV-QTY-PD.

           IF ITM-CORP-CODE NOT = "NON-STR"
             MOVE CORPCODE-ARG TO CORPCDE OF MSTORERM-REC-I
             READ MSTORERM-I INTO BUF-MSTORERM
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS
             END-READ
             IF FILE-STATUS NOT = "00"
               MOVE "DBGET7 MSTORERM*615-CIL"  TO  BU-DISPLAY-MSG
               MOVE CORPCODE-ARG  TO  BU-DISPLAY-FLD (1)
               PERFORM 990-BLOWUP THRU 999-EXIT
             ELSE
               MOVE STR-CLASS      TO  IPRT-SUB.
           MOVE ITM-SUB-DETL       TO  IPRT-SUBD.
           MOVE ITM-ADDL-DATA      TO  IPRT-ADATA.
           IF ITM-DATE-RCVD NOT = SPACE
               MOVE 4              TO  DATE-MODE
               MOVE ITM-DATE-RCVD  TO  DATE-VALIDATE-IN
               CALL "TDATECHK" USING DATE-CHECK-AREA
               MOVE DATE-SLASH-OUT TO  IPRT-DATE-RCVD.
           WRITE  PRINT-RCD  FROM  PRINT-RCD-WS
               AFTER ADVANCING 1 LINES.
           ADD +1  TO  LINE-CTR.

       615-CODED-DESC.
           IF ITM-CORP-CODE = "NON-STR"
              MOVE 1 TO CNDESC-LINES-TO-GET
              MOVE SPACES TO CNDESC-LINE
              CALL "CNDESC" USING BASE, PO-ARG, ITM-NUMBER,
                                  CNDESC-DATA
              MOVE CNDESC (1)            TO HOLD-DESC
           ELSE
              MOVE 1                  TO CDESC-LINES-TO-GET
              MOVE SPACES             TO CDESC-DATA
              CALL "CDESC" USING CDESC-RET-CODE, BASE, STATUS-AREA,
                   BU-DISPLAY-MSG, ITM-CORP-CODE, CDESC-DATA
              MOVE CDESC (1)          TO HOLD-DESC.
           PERFORM  6111-TOP-CHECK  THRU  6111-TOP-CHECK-X.
           WRITE  PRINT-RCD  FROM  SUB-HEAD5C
               AFTER ADVANCING 2 LINES.
           ADD +2  TO  LINE-CTR.
           MOVE SPACE  TO  PRINT-RCD-WS.
           MOVE HOLD-DESC  TO  DPRT-DESC.

       615-UNITS-OF-MEASURE.
           IF ITM-CORP-CODE NOT = "NON-STR"
           MOVE STR-UM      TO  DPRT-STR-UM
           MOVE STR-UM1     TO  DPRT-ALT-UM1
           MOVE STR-UM1-CF  TO  DPRT-CONV1
           MOVE STR-UM2     TO  DPRT-ALT-UM2
           MOVE STR-UM2-CF  TO  DPRT-CONV2.
           WRITE  PRINT-RCD  FROM  PRINT-RCD-WS
               AFTER ADVANCING 1 LINES.
           ADD +1  TO  LINE-CTR.

      *---------  LIST RECEIVING SLIP NUMBERS IF CODED ITEM
           IF ITM-CORP-CODE = "NON-STR"
              GO TO 615-CODED-ITEM-LOOP.

       615-LIST-RCV-SLIPS.
           MOVE CORPCODE-ARG TO CORPCDE OF DRCVITEM-REC-I-CDE.
           START DRCVITEM-I-CDE KEY = CORPCDE OF DRCVITEM-REC-I-CDE
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
                   MOVE ZERO   TO  RS-SUB
                   MOVE SPACE  TO  PRINT-RCD-WS
                   GO TO  615-WRITE-RS-LIST
               ELSE
               MOVE "DBFIND DRCVITEM*615-LRS"  TO  BU-DISPLAY-MSG
               MOVE CORPCODE-ARG  TO  BU-DISPLAY-FLD (1)
               PERFORM 990-BLOWUP THRU 999-EXIT.

           MOVE ZERO   TO  RS-SUB.
           MOVE SPACE  TO  RCV-SLIP-TABLE.

       615-LIST-RS-LOOP.
           READ DRCVITEM-I-CDE NEXT INTO BUF-DRCVITEM
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   MOVE ZERO   TO  RS-SUB
                   MOVE SPACE  TO  PRINT-RCD-WS
                   GO TO  615-WRITE-RS-LIST
               ELSE
                   MOVE "DBGET5 DRCVITM*615-LRSL"  TO  BU-DISPLAY-MSG
                   MOVE CORPCODE-ARG  TO  BU-DISPLAY-FLD (1)
                   PERFORM 990-BLOWUP THRU 999-EXIT.
           IF CORPCDE OF DRCVITEM-REC-I-CDE NOT = CORPCODE-ARG
               MOVE ZERO       TO  RS-SUB
               MOVE SPACE      TO  PRINT-RCD-WS
               GO TO  615-WRITE-RS-LIST.

           IF RCV-PO-RCV-NO = PO-ARG
               GO TO  615-LIST-RS-LOOP
           ELSE
               IF RCV-PO-REL = PO-NO-RLSE
                   ADD +1  TO  RS-SUB
                   IF RS-SUB > +7
                       MOVE ZERO   TO  RS-SUB
                       MOVE SPACE  TO  PRINT-RCD-WS
                       GO TO  615-WRITE-RS-LIST
                   ELSE
                       MOVE RCV-PO-RCV-NO  TO  RCV-SLIP-NO (RS-SUB)
                       GO TO  615-LIST-RS-LOOP
               ELSE
                   GO TO  615-LIST-RS-LOOP.

       615-WRITE-RS-LIST.
           ADD +1  TO  RS-SUB.

           IF RS-SUB > +7
               PERFORM  6111-TOP-CHECK  THRU  6111-TOP-CHECK-X
               WRITE  PRINT-RCD  FROM  SUB-HEAD6
                   AFTER ADVANCING 2 LINES
               ADD +2  TO  LINE-CTR
               WRITE  PRINT-RCD  FROM  PRINT-RCD-WS
                   AFTER ADVANCING 1 LINES
               ADD +1  TO  LINE-CTR
               GO TO  615-CODED-ITEM-LOOP.

           IF RCV-SLIP-NO (RS-SUB) = SPACE
               IF RS-SUB > +1
                   PERFORM  6111-TOP-CHECK  THRU  6111-TOP-CHECK-X
                   WRITE  PRINT-RCD  FROM  SUB-HEAD6
                       AFTER ADVANCING 2 LINES
                   ADD +2  TO  LINE-CTR
                   WRITE  PRINT-RCD  FROM  PRINT-RCD-WS
                       AFTER ADVANCING 1 LINES
                   ADD +1  TO  LINE-CTR
                   GO TO  615-CODED-ITEM-LOOP
               ELSE
                   GO TO  615-CODED-ITEM-LOOP
           ELSE
               MOVE RS-PO-NO (RS-SUB)    TO  LPRT-PO (RS-SUB)
               MOVE "-"                  TO  LPRT-H1 (RS-SUB)
               MOVE RS-PO-RLSE (RS-SUB)  TO  LPRT-RLSE (RS-SUB)
               MOVE "-"                  TO  LPRT-H2 (RS-SUB)
               MOVE RS-PO-RS (RS-SUB)    TO  LPRT-RS (RS-SUB)
               GO TO  615-WRITE-RS-LIST.

       615-RS-INFO-NEXT.
           ADD +1  TO  A-RS.
           ADD +1  TO  RS-CALL-CTR.

           IF RS-CALL-CTR > RCV-SLIP-CTR
               PERFORM 700-INVOICING-INFO THRU 799-EXIT
               GO TO  61-REPORT.

           MOVE "Y"  TO  NEW-RS-NO-SW.

           MOVE ALTER-PO-ARG TO PORCVNO OF DRCVITEM-REC-I-PO.
           START DRCVITEM-I-PO KEY = PORCVNO OF DRCVITEM-REC-I-PO
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
                   GO TO 615-FRT-INFO-LOOP
               ELSE
               MOVE "DBFIND DRCVITEM*615-RIN"  TO  BU-DISPLAY-MSG
               MOVE ALTER-PO-ARG  TO  BU-DISPLAY-FLD (1)
               PERFORM 990-BLOWUP THRU 999-EXIT.

       615-RS-INFO-LOOP.
           READ DRCVITEM-I-PO NEXT INTO BUF-DRCVITEM
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   GO TO 615-FRT-INFO-LOOP
               ELSE
                   MOVE "DBGET DRCVITEM*615-RIL"  TO  BU-DISPLAY-MSG
                   MOVE ALTER-PO-ARG  TO  BU-DISPLAY-FLD (1)
                   PERFORM 990-BLOWUP THRU 999-EXIT.
           IF PORCVNO OF DRCVITEM-REC-I-PO NOT = ALTER-PO-ARG
               GO TO 615-FRT-INFO-LOOP.

           ADD +1  TO  RS-PRT-CTR.

           IF RS-PRT-CTR = +1
               PERFORM  6111-TOP-CHECK  THRU  6111-TOP-CHECK-X
               WRITE  PRINT-RCD  FROM  MAJOR-HEAD5
                    AFTER ADVANCING 2 LINES
               WRITE  PRINT-RCD  FROM  MAJOR-HEAD6
                    AFTER ADVANCING 1 LINES
               ADD +3  TO  LINE-CTR.

           IF NEW-RS-NO-SW = "Y"
               MOVE "N"  TO  NEW-RS-NO-SW
               PERFORM  6111-TOP-CHECK  THRU  6111-TOP-CHECK-X
               WRITE  PRINT-RCD  FROM  SUB-HEAD7
                   AFTER ADVANCING 2 LINES
               ADD +2                  TO  LINE-CTR
               MOVE SPACE              TO  PRINT-RCD-WS
               MOVE RCV-PO-NO          TO  RSPRT-PO
               MOVE "-"                TO  RSPRT-H1
               MOVE RCV-PO-REL         TO  RSPRT-RLSE
               MOVE "-"                TO  RSPRT-H2
               MOVE RCV-PO-RCVR        TO  RSPRT-RS
           ELSE
               MOVE SPACE              TO  PRINT-RCD-WS.

           MOVE RCV-ITEM-NUMBER        TO  RSPRT-ITEM-NO.
           MOVE RCV-CORP-CODE          TO  RSPRT-CORPCODE.
           MOVE RCV-ITEM-UM            TO  RSPRT-RCVD-UM.
           MOVE RCV-QTY-DLVR           TO  RSPRT-QTY-DLVR.
           MOVE RCV-QTY-STORED         TO  RSPRT-QTY-STOR.
           IF RCV-DATE-RCVD NOT = SPACE
               MOVE 4                  TO  DATE-MODE
               MOVE RCV-DATE-RCVD      TO  DATE-VALIDATE-IN
               CALL "TDATECHK" USING DATE-CHECK-AREA
               MOVE DATE-SLASH-OUT     TO  RSPRT-DATE-RCVD.
           IF RCV-DATE-STORED NOT = SPACE
               IF RCV-MM-STORED = "DD"
                   MOVE "*DIRECT*"     TO  RSPRT-DATE-STRD
               ELSE
                   MOVE 4              TO  DATE-MODE
                   MOVE RCV-DATE-STORED TO  DATE-VALIDATE-IN
                   CALL "TDATECHK" USING DATE-CHECK-AREA
                   MOVE DATE-SLASH-OUT  TO  RSPRT-DATE-STRD.
           WRITE  PRINT-RCD  FROM  PRINT-RCD-WS
               AFTER ADVANCING 1 LINES.
           ADD +1  TO  LINE-CTR.
           GO TO  615-RS-INFO-LOOP.

       615-FRT-INFO-LOOP.
           MOVE ALTER-PO-ARG TO PORCVNO OF DPOFREIGHT-REC-I-PO.
           READ DPOFREIGHT-I-PO INTO BUF-DPOFREIGHT
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE "READ DPOFREIGHT*615-FIL"  TO  BU-DISPLAY-MSG
               MOVE ALTER-PO-ARG  TO  BU-DISPLAY-FLD (1)
               PERFORM 990-BLOWUP THRU 999-EXIT.

9405CK*    IF FRT-TYPE = "P"
9405CK*        GO TO  615-RS-INFO-NEXT.

           PERFORM  6111-TOP-CHECK  THRU  6111-TOP-CHECK-X.
           WRITE  PRINT-RCD  FROM  SUB-HEAD8
               AFTER ADVANCING 2 LINES.
           ADD +2  TO  LINE-CTR.
           MOVE SPACE              TO  PRINT-RCD-WS.
           MOVE FRT-CARRIER        TO  FPRT-CARRIER.
           MOVE FRT-PACK-SLIP      TO  FPRT-PACK-SLIP.
           MOVE FRT-BILL-NO        TO  FPRT-PRO-NUMBER.
           IF FRT-BILL-DATE NOT = SPACE
               MOVE 4              TO  DATE-MODE
               MOVE FRT-BILL-DATE  TO  DATE-VALIDATE-IN
               CALL "TDATECHK" USING DATE-CHECK-AREA
               MOVE DATE-SLASH-OUT TO  FPRT-PRO-DATE.
           MOVE FRT-CHARGES-9      TO  FPRT-CHARGES.
           MOVE FRT-SPLC           TO  FPRT-SPLC.
           MOVE FRT-RAIL-CAR       TO  FPRT-RAILCAR.
           MOVE FRT-CARRIER-WT     TO  FPRT-CARRIER-WT.
           MOVE FRT-OUR-WT         TO  FPRT-OUR-WT.
           WRITE  PRINT-RCD  FROM  PRINT-RCD-WS
               AFTER ADVANCING 1 LINES.
           ADD +1  TO  LINE-CTR.
           GO TO  615-RS-INFO-NEXT.



      *************************************************************
      *            CREATE INVOICING INFORMATION SECTION           *
      *************************************************************
       700-INVOICING-INFO.
      *----------  READ EACH INVOICE RECORD
           MOVE PO-ARG TO PORCVNO OF DINVRCD-REC-I.
           START DINVRCD-I KEY = PORCVNO OF DINVRCD-REC-I
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
                   GO TO 799-EXIT
               ELSE
                   MOVE "DBFIND DINVRCD * 700"
                        TO BU-DISPLAY-MSG
                   MOVE PO-ARG TO BU-DISPLAY-FLD (1)
                   PERFORM 990-BLOWUP THRU 999-EXIT.

           IF LINE-CTR > 58
              PERFORM 6111-TOP-CHECK THRU 6111-TOP-CHECK-X.
           WRITE PRINT-RCD FROM MAJOR-HEAD7 AFTER ADVANCING 2 LINES.
           WRITE PRINT-RCD FROM MAJOR-HEAD8 AFTER ADVANCING 1 LINES.
           ADD +3 TO LINE-CTR.

       705-GET-DINVRCD.
           READ DINVRCD-I NEXT INTO BUF-DINVRCD
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   GO TO 799-EXIT
               ELSE
                   MOVE "DBGET DINVRCD AT 705 IN TINVPRT"
                       TO BU-DISPLAY-MSG
                   MOVE PO-ARG TO BU-DISPLAY-FLD (1)
                   PERFORM 990-BLOWUP THRU 999-EXIT.
           IF PORCVNO OF DINVRCD-REC-I NOT = PO-ARG
               GO TO 799-EXIT.

           MOVE INV-REG-NO TO REG-ARG.
      *----------  WRITE FIRST 14 LINES OF DINVRCD DATA
           IF LINE-CTR > 38
              PERFORM 6111-TOP-CHECK2 THRU 6111-TOP-CHECK-X2.

           MOVE SPACES                TO PRINT-RCD-WS.
           MOVE "REGISTER"            TO HEAD2-REGISTER.
           MOVE "INVOICE NUMBER"      TO HEAD2-INVOICE.
           MOVE "STATUS"              TO HEAD2-STATUS.
           MOVE "INVOICE DATE"        TO HEAD2-INV-DATE.
           MOVE "ENTRY DATE"          TO HEAD2-ENTRY-DATE.
           MOVE "DUE-DATE"            TO HEAD2-DUE-DATE.
           MOVE "TERMS"               TO HEAD2-TERMS.
           MOVE "PO NUMBER"           TO HEAD2-PO.
           MOVE "EMPLOYEE ID "        TO HEAD2-ID.
           MOVE "ADD/CHANGE"          TO HEAD2-ADD.
           WRITE PRINT-RCD FROM PRINT-RCD-WS
               AFTER ADVANCING 3 LINES.
           MOVE SPACES                TO PRINT-RCD-WS.
           MOVE INV-REG-NO-9          TO LINE1-REG.
           MOVE INV-NO                TO LINE1-INV-NO.
           MOVE INV-STATUS            TO LINE1-STATUS.
           MOVE INV-DATE              TO DATE-VALIDATE-IN.
           MOVE 4                     TO DATE-MODE.
           CALL "TDATECHK" USING DATE-CHECK-AREA.
           MOVE DATE-SLASH-OUT        TO LINE1-INV-DATE.
           MOVE INV-ENTRY-DATE        TO DATE-VALIDATE-IN.
           MOVE 4                     TO DATE-MODE.
           CALL "TDATECHK" USING DATE-CHECK-AREA.
           MOVE DATE-SLASH-OUT        TO LINE1-ENTRY-DATE.
           MOVE INV-DUE-DATE          TO DATE-VALIDATE-IN.
           MOVE 4                     TO DATE-MODE.
           CALL "TDATECHK" USING DATE-CHECK-AREA.
           MOVE DATE-SLASH-OUT        TO LINE1-DUE-DATE.
           MOVE INV-TERMS             TO LINE1-TERMS.
           MOVE INV-PO-RLSE           TO LINE1-PO.
           MOVE INV-ADD-CLERK         TO LINE1-ID.
           MOVE "/"                   TO LINE1-SLASH.
           MOVE INV-MOD-CLERK         TO LINE1-ADD.
           WRITE PRINT-RCD FROM PRINT-RCD-WS
               AFTER ADVANCING 1 LINES.
           MOVE SPACES                TO PRINT-RCD-WS.
           MOVE "VENDOR  "            TO LINE2-VENDOR.
           MOVE "NAME  "              TO LINE2-NAME.
           MOVE "NO CHECK INDIC (IT)" TO LINE2-CHECK.

           WRITE PRINT-RCD FROM PRINT-RCD-WS
               AFTER ADVANCING 2 LINES.
           MOVE SPACES                TO PRINT-RCD-WS.

      *----------  FILL IN VENDOR NAME
           MOVE INV-VEN-CODE          TO VEN-ARG.
           MOVE VEN-ARG               TO VENCDE OF DVENDOR-REC-I.
           MOVE "00"                  TO VENITMNO OF DVENDOR-REC-I.
           READ DVENDOR-I INTO BUF-DVENDOR
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS-1 = "2"
              MOVE "***   VENDOR NAME NOT ON FILE   ***"
                  TO LINE2A-NAME-OUT
           ELSE
           IF FILE-STATUS NOT = "00"
             MOVE "DBFIND DVENDOR * 705" TO BU-DISPLAY-MSG
             MOVE VEN-ARG TO BU-DISPLAY-FLD (1)
             PERFORM 990-BLOWUP THRU 999-EXIT.
           MOVE VEN-ITM-DATA          TO LINE2A-NAME-OUT.

           MOVE INV-VEN-CODE          TO WORK-VENDOR.
           MOVE WORK-VEN              TO LINE2A-VENDOR-CODE.
           MOVE INV-NO-CHECK-INDIC    TO LINE2A-CHECK-IND.
           MOVE INV-FREE-VERB         TO LINE2A-VERBAGE.
           WRITE PRINT-RCD FROM PRINT-RCD-WS
               AFTER ADVANCING 1 LINES.

           MOVE SPACES                TO PRINT-RCD-WS.
           MOVE "MANIFEST "           TO LINE2B-MAN.
           MOVE INV-MFEST-NO          TO LINE2B-MAN-NO.
           MOVE INV-MFEST-YY          TO LINE2B-MAN-YY.
           MOVE "CHECK #"             TO LINE2B-CHECK.
           MOVE INV-CHECK-NO          TO LINE2B-CHECK-NO.
           MOVE INV-CHECK-DATE        TO DATE-VALIDATE-IN.
           MOVE 4                     TO DATE-MODE.
           CALL "TDATECHK" USING DATE-CHECK-AREA.
           MOVE DATE-SLASH-OUT        TO LINE2B-CHECK-DATE.
           WRITE PRINT-RCD FROM PRINT-RCD-WS
               AFTER ADVANCING 2 LINES.

           MOVE SPACES                TO PRINT-RCD-WS.
           MOVE "PO MATERIAL EXT  "   TO LINE3-PO.
           MOVE INV-P-MATL-EXT        TO LINE3-PO-EXT.
           MOVE " INV FREIGHT    "    TO LINE3-INV-FRT.
           MOVE INV-ADD-VFRT          TO LINE3-FRT-AMT.
           MOVE "  CE "               TO LINE3-CE.
           MOVE CE1-CODE              TO LINE3-CE-CODE.
           MOVE CE1-ACCTG-DATA        TO LINE3-CE-AMOUNT.
           MOVE CE1-TOTAL             TO LINE3-CE-AMT.
           MOVE " NET DUE VENDOR  "   TO LINE3-NET.
           MOVE INV-NET-DUE-VENDOR    TO LINE3-NET-AMT.
           WRITE PRINT-RCD FROM PRINT-RCD-WS
               AFTER ADVANCING 1 LINES.

           MOVE SPACES                TO PRINT-RCD-WS.
           MOVE "INV MATERIAL EXT "   TO LINE4-INV.
           MOVE INV-I-MATL-EXT        TO LINE4-INV-EXT.
           MOVE " INV TAX        "    TO LINE4-INV-TAX.
           MOVE INV-ADD-TAX           TO LINE4-TAX-AMT.
           MOVE "  CE 3 (FREIGHT)"    TO LINE4-CE3.
           MOVE CE3-FRT               TO LINE4-AMT.
           MOVE " COLLECT FRT"        TO LINE4-FRT.
           MOVE INV-TOTAL-CFRT        TO LINE4-FRT-AMT.
           WRITE PRINT-RCD FROM PRINT-RCD-WS
               AFTER ADVANCING 1 LINES.

           MOVE SPACES                TO PRINT-RCD-WS.
           MOVE  "INV-CONTAINERS"     TO LINE5-INV-CON.
           MOVE INV-ADD-CTNRS         TO LINE5-CON-AMT.
           MOVE "  CE 4 (INSURANCE)"  TO LINE5-CE4.
           MOVE CE4-INS               TO LINE5-AMT.
           MOVE " ACCRUED TAX   "     TO LINE5-TAX.
           COMPUTE LINE5-TAX-AMT ROUNDED =
             INV-ATAX-AMT (1) + INV-ATAX-AMT (2) + INV-ATAX-AMT (3)
                + INV-ATAX-AMT (4).
           WRITE PRINT-RCD FROM PRINT-RCD-WS
               AFTER ADVANCING 1 LINES.

           MOVE SPACES                TO PRINT-RCD-WS.
           MOVE "PAYMENT INDICATOR "  TO LINE6-PAY-IND.
           MOVE INV-PAYMENT-IND       TO LINE6-IND.
           MOVE "INV OTHER     "      TO LINE6-OTH.
           MOVE INV-ADD-OTHER         TO LINE6-OTH-AMT.
           MOVE "  CE 5 (TAX)       " TO LINE6-CE5.
           MOVE CE5-TAX               TO LINE6-AMT.
           MOVE " OTHER ADJUST    "   TO LINE6-OTHER.
           MOVE INV-ADJ-OTHER         TO LINE6-OTHER-AMT.
           WRITE PRINT-RCD FROM PRINT-RCD-WS
               AFTER ADVANCING 1 LINES.

           MOVE SPACES                TO PRINT-RCD-WS.
           MOVE "INV INSURANCE "      TO LINE7-INS.
           MOVE INV-ADD-INS           TO LINE7-INS-AMT.
           MOVE "  CE 6 (EXTND ERR)"    TO LINE7-CE6.
           MOVE CE6-EXT-ERR           TO LINE7-AMT.
           WRITE PRINT-RCD FROM PRINT-RCD-WS
               AFTER ADVANCING 1 LINES.

           MOVE SPACES                TO PRINT-RCD-WS.
           MOVE "Z-BILL NUMBER  "     TO LINE8-ZBILL-NO.
           MOVE "CALC. INV AMT "      TO LINE8-CALC-AMT.
           IF INV-PAYMENT-IND = SPACES
              MOVE ZEROES TO LINE8-CALC-AMOUNT
           ELSE
              IF INV-PAYMENT-IND = "P"
                 COMPUTE LINE8-CALC-AMOUNT = INV-P-MATL-EXT +
                         INV-ADD-VFRT + INV-ADD-TAX + INV-ADD-CTNRS
                         + INV-ADD-INS + INV-ADD-OTHER
           ELSE
              IF INV-PAYMENT-IND = "I"
                 COMPUTE LINE8-CALC-AMOUNT = INV-I-MATL-EXT +
                         INV-ADD-VFRT + INV-ADD-TAX + INV-ADD-CTNRS
                         + INV-ADD-INS + INV-ADD-OTHER.
           MOVE "  CE 7 (PRICE ERR)"   TO LINE8-CE7.
           MOVE CE7-UPRC-ERR          TO LINE8-AMT.
           MOVE " COST DISTRIB"       TO LINE8-COST.
           MOVE INV-DIST-COST         TO LINE8-COST-AMT.
           WRITE PRINT-RCD FROM PRINT-RCD-WS
               AFTER ADVANCING 1 LINES.

           MOVE SPACES                TO PRINT-RCD-WS.
           MOVE "CE 8 (OTHER)      "  TO LINE9-CE8.
           MOVE CE8-OTHER             TO LINE9-AMT.
           WRITE PRINT-RCD FROM PRINT-RCD-WS
               AFTER ADVANCING 1 LINES.

           MOVE SPACES                TO PRINT-RCD-WS.
           MOVE "CE 9 (CASH DSCNT)"    TO LINE10-CE9.
           MOVE CE9-CASH-DSCNT        TO LINE10-AMT.
           WRITE PRINT-RCD FROM PRINT-RCD-WS
               AFTER ADVANCING 1 LINES.

           MOVE SPACES                TO PRINT-RCD-WS.
           MOVE "TAX CODE"            TO LINE10-TAX.
           MOVE INV-TAX-CODE          TO LINE10-TAX-CODE.

           IF CE-EXT-VALUE-1 NOT = ZEROES
              MOVE "CE " TO LINE10A-CE
              MOVE CE-EXT-CODE-1 TO LINE10A-CODE
              MOVE CE-EXT-ACCTG-DATA-1 TO LINE10A-ACCTG
              MOVE CE-EXT-VALUE-1 TO LINE10A-VALUE.
           WRITE PRINT-RCD FROM PRINT-RCD-WS
               AFTER ADVANCING 1 LINES.
           MOVE SPACES                TO PRINT-RCD-WS.
           ADD 19                     TO LINE-CTR.
      *************************************************************
      *************************************************************
      **       USE REGISTER NUMBER AND RETRIEVE FREIGHT DATA     **
      *************************************************************
      *************************************************************
           MOVE REG-ARG TO REGISTERNO OF DPOFREIGHT-REC-I-REG.
           START DPOFREIGHT-I-REG
                     KEY = REGISTERNO OF DPOFREIGHT-REC-I-REG
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
                   GO TO 730-FIND-DINVITM
               ELSE
                   MOVE "FIND DPOFREIGHT AT 705 IN INVPRPT"
                       TO BU-DISPLAY-MSG
                   MOVE REG-ARG      TO  BU-DISPLAY-FLD (1)
                   PERFORM 990-BLOWUP THRU 999-EXIT.

           IF LINE-CTR > 58
              PERFORM 6111-TOP-CHECK THRU 6111-TOP-CHECK-X.

           MOVE "COLLECT FREIGHT"     TO HEAD3-COLLECT.
           MOVE "PRO-NUMBER"          TO HEAD3-PRO.
           MOVE "CARRIER"             TO HEAD3-CARRIER.
           MOVE "FREIGHT CHARGE"      TO HEAD3-FREIGHT.
           WRITE PRINT-RCD FROM PRINT-RCD-WS
                AFTER ADVANCING 1 LINES.
           MOVE SPACES                TO PRINT-RCD-WS.
           ADD 1                      TO LINE-CTR.


       710-GET-DPOFREIGHT-LOOP.
           READ DPOFREIGHT-I-REG NEXT INTO BUF-DPOFREIGHT
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   GO TO 730-FIND-DINVITM
               ELSE
               MOVE "GET DPOFREIGHT AT 710 IN INVITM" TO BU-DISPLAY-MSG
               MOVE REG-ARG  TO  BU-DISPLAY-FLD (1)
               PERFORM 990-BLOWUP THRU 999-EXIT.
           IF REGISTERNO OF DPOFREIGHT-REC-I-REG NOT = REG-ARG
               GO TO 730-FIND-DINVITM.

           MOVE FRT-BILL-NO           TO LINE11-PRO.
           MOVE FRT-CARRIER           TO LINE11-CARRIER.
           MOVE FRT-CHARGES-9         TO LINE11-CHARGE.
           WRITE PRINT-RCD FROM PRINT-RCD-WS
               AFTER ADVANCING 1 LINES.
           MOVE SPACES                TO PRINT-RCD-WS.
           ADD 1 TO LINE-CTR.
           GO TO 710-GET-DPOFREIGHT-LOOP.
      *************************************************************
      *************************************************************
      **     GET ITEM INFO FROM DINVITM AND DINVACCT.            **
      *************************************************************
      *************************************************************
       730-FIND-DINVITM.
           MOVE REG-ARG TO REGISTERNO OF DINVITM-REC-I.
           START DINVITM-I KEY = REGISTERNO OF DINVITM-REC-I
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
                   GO TO 705-GET-DINVRCD
               ELSE
               MOVE "FIND DINVITM AT 730 IN INVITM"  TO  BU-DISPLAY-MSG
               MOVE REG-ARG            TO  BU-DISPLAY-FLD (1)
               PERFORM 990-BLOWUP THRU 999-EXIT.

           IF LINE-CTR > 58
              PERFORM 6111-TOP-CHECK THRU 6111-TOP-CHECK-X.

           MOVE "ITEM  CORP CODE"     TO HEAD4-ITEM.
           MOVE "QUANTITY PAID"       TO HEAD4-QTY.
           MOVE "PRICE    UM"         TO HEAD4-PRICE-UM.
           MOVE "ITEM EXTENSION"      TO HEAD4-ITEM-EXT.
           MOVE "ACCOUNTING DATA"     TO HEAD4-DATA.
           WRITE PRINT-RCD FROM PRINT-RCD-WS
               AFTER ADVANCING 2 LINES.
           MOVE SPACES                TO PRINT-RCD-WS.
           ADD 2 TO LINE-CTR.

           MOVE REG-ARG TO REGISTERNO OF DINVACCT-REC-I.
           START DINVACCT-I KEY = REGISTERNO OF DINVACCT-REC-I
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
                   MOVE "9999" TO INVACCT-ITEM
               ELSE
               MOVE "FIND DINVACCT-66-PII"  TO  BU-DISPLAY-MSG
               MOVE REG-ARG             TO  BU-DISPLAY-FLD (1)
               PERFORM 990-BLOWUP THRU 999-EXIT.

           PERFORM 760-GET-DINVACCT  THRU  769-EXIT.
       740-GET-DINVITM-LOOP.
           READ DINVITM-I NEXT INTO BUF-DINVITM
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   GO TO 705-GET-DINVRCD
               ELSE
                MOVE "GET DINVRCD AT 740 IN INVPRPT" TO BU-DISPLAY-MSG
                MOVE REG-ARG  TO  BU-DISPLAY-FLD (1)
                PERFORM 990-BLOWUP THRU 999-EXIT.
           IF REGISTERNO OF DINVITM-REC-I NOT = REG-ARG
                GO TO 705-GET-DINVRCD.

           IF LINE-CTR > 58
              PERFORM 6111-TOP-CHECK THRU 6111-TOP-CHECK-X.

           MOVE INVITM-ITEM-NO        TO  LINE12-ITEM.
           MOVE INVITM-CORPCODE       TO  LINE12-CORP.
           MOVE "   PO"               TO  LINE12-PO.
           MOVE INVITM-PO-QTY-PD      TO  LINE12-QTY.
           MOVE INVITM-PO-UPRICE      TO  LINE12-PRICE.
           MOVE INVITM-PO-UM          TO  LINE12-UM.
           IF INVITM-PO-QTY-PD = ZEROES
              MOVE INVITM-PO-UPRICE TO LINE12-EXT
           ELSE
              MULTIPLY INVITM-PO-UPRICE BY INVITM-PO-QTY-PD
                  GIVING LINE12-EXT ROUNDED.
           MOVE INVITM-TAX-CODE       TO  LINE12-TAX.

           IF INVACCT-ITEM = INVITM-ITEM-NO
               MOVE INVACCT-PRIME     TO  LINE12-PRIME
               MOVE INVACCT-SUB       TO  LINE12-SUB
               MOVE INVACCT-SUBD      TO  LINE12-SUBD
               MOVE INVACCT-ADDL-DATA TO  LINE12-DATA
               PERFORM 760-GET-DINVACCT  THRU  769-EXIT.

           ADD 1 TO LINE-CTR.
           WRITE PRINT-RCD FROM PRINT-RCD-WS
               AFTER ADVANCING 1 LINES.

           MOVE SPACES                TO PRINT-RCD-WS.
           MOVE INVITM-INV-QTY-PD     TO  LINE13-QTY.
           MOVE INVITM-INV-UPRICE     TO  LINE13-PRICE.
           MOVE INVITM-PO-UM          TO  LINE13-UM.
           IF INVITM-INV-QTY-PD = ZEROES
              MOVE INVITM-INV-UPRICE TO LINE13-EXT
           ELSE
              MULTIPLY INVITM-INV-UPRICE BY INVITM-INV-QTY-PD
                  GIVING LINE13-EXT ROUNDED.
           IF INVITM-MEMO-INDIC = "X"
               MOVE "MEMO QTY."       TO  LINE13-MEMO.
           MOVE "INV  "               TO LINE13-INV.
           IF INVACCT-ITEM = INVITM-ITEM-NO
               MOVE INVACCT-PRIME     TO  LINE13-PRIME
               MOVE INVACCT-SUB       TO  LINE13-SUB
               MOVE INVACCT-SUBD      TO  LINE13-SUBD
               MOVE INVACCT-ADDL-DATA TO  LINE13-DATA.
           WRITE PRINT-RCD FROM PRINT-RCD-WS
               AFTER ADVANCING 1 LINES.
           ADD 1                      TO  LINE-CTR.
           MOVE SPACES                TO  PRINT-LINE.

       750-CHECK-FOR-MORE-ACCTG.
           IF LINE-CTR > 58
              PERFORM 6111-TOP-CHECK THRU 6111-TOP-CHECK-X.

           IF INVACCT-ITEM = INVITM-ITEM-NO
               PERFORM 760-GET-DINVACCT  THRU  769-EXIT
               IF INVACCT-ITEM  =  INVITM-ITEM-NO
                   MOVE INVACCT-PRIME     TO  LINE14-PRIME
                   MOVE INVACCT-SUB       TO  LINE14-SUB
                   MOVE INVACCT-SUBD      TO  LINE14-SUBD
                   MOVE INVACCT-ADDL-DATA TO  LINE14-DATA
                   WRITE PRINT-RCD FROM PRINT-RCD-WS
                       AFTER ADVANCING 1 LINES
                   MOVE SPACES            TO  PRINT-LINE
                   ADD 1                  TO LINE-CTR
                   GO TO 750-CHECK-FOR-MORE-ACCTG.
           GO TO 740-GET-DINVITM-LOOP.

       760-GET-DINVACCT.
           READ DINVACCT-I NEXT INTO BUF-DINVACCT
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   MOVE "9999" TO INVACCT-ITEM
               ELSE
                MOVE "GET DINVACCT AT 760 IN INVPRPT" TO BU-DISPLAY-MSG
                MOVE REG-ARG  TO  BU-DISPLAY-FLD (1)
                PERFORM 990-BLOWUP THRU 999-EXIT.
           IF REGISTERNO OF DINVACCT-REC-I NOT = REG-ARG
               MOVE "9999"  TO  INVACCT-ITEM.

       769-EXIT.  EXIT.
       799-EXIT.  EXIT.
       61-REPORT-X.
           EXIT.


       61-PERFORMED-LOGIC SECTION 03.
       6111-TOP-CHECK.
           IF LINE-CTR > 58
               MOVE ZERO  TO  LINE-CTR
               MOVE PAGE-CTR  TO  MH1C-PAGE
               WRITE  PRINT-RCD  FROM  MAJOR-HEAD1C
                   AFTER ADVANCING NEWPAGE
               WRITE  PRINT-RCD  FROM  MAJOR-HEAD2
                   AFTER ADVANCING 1 LINES
               ADD +2  TO  LINE-CTR.

       6111-TOP-CHECK-X.
           EXIT.
       6111-TOP-CHECK2.
           MOVE ZERO  TO  LINE-CTR.
           MOVE PAGE-CTR  TO  MH1C-PAGE.
           WRITE  PRINT-RCD  FROM  MAJOR-HEAD1C
                   AFTER ADVANCING NEWPAGE.
           WRITE  PRINT-RCD  FROM  MAJOR-HEAD2
                   AFTER ADVANCING 1 LINES.
           ADD +2  TO  LINE-CTR.

       6111-TOP-CHECK-X2.
           EXIT.


       6131-FIND-DPODATAITM.
           MOVE PO-ARG TO PORCVNO OF DPODATAITM-REC-I.
           START DPODATAITM-I KEY = PORCVNO OF DPODATAITM-REC-I
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
                   GO TO 6131-FIND-DPODATAITM-X
               ELSE
               MOVE "DBFIND DPODATAITM*6131-FD"  TO  BU-DISPLAY-MSG
               MOVE PO-ARG  TO  BU-DISPLAY-FLD (1)
               PERFORM 990-BLOWUP THRU 999-EXIT.

           MOVE ZERO  TO  COM-SUB.

       6131-GET-DPODATAITM-LOOP.
           READ DPODATAITM-I NEXT INTO BUF-DPODATAITM
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   GO TO 6131-FIND-DPODATAITM-X
               ELSE
                   MOVE 99 TO COND-WORD.
           IF PORCVNO OF DPODATAITM-REC-I NOT = PO-ARG
               GO TO 6131-FIND-DPODATAITM-X.

           IF DATAITM-ITEM-NO = ZERO
               IF DATAITM-LINE-NO > "48" AND DATAITM-LINE-NO < "99"
                   IF COM-SUB = ZERO
                       PERFORM  6111-TOP-CHECK  THRU  6111-TOP-CHECK-X
                       WRITE  PRINT-RCD  FROM  SUB-HEAD3
                           AFTER ADVANCING 2 LINES
                       ADD +2  TO  LINE-CTR
                       ADD +1  TO  COM-SUB
                       MOVE SPACE  TO  PRINT-RCD-WS
                       MOVE DATAITM-INFO  TO  CPRT-COMMENT
                       WRITE  PRINT-RCD  FROM  PRINT-RCD-WS
                           AFTER ADVANCING 1 LINES
                       ADD +1  TO  LINE-CTR
                       GO TO  6131-GET-DPODATAITM-LOOP
                   ELSE
                       IF COM-SUB = +1
                           ADD +1  TO  COM-SUB
                           MOVE SPACE  TO  PRINT-RCD-WS
                           MOVE DATAITM-INFO  TO  CPRT-COMMENT
                           WRITE  PRINT-RCD  FROM  PRINT-RCD-WS
                               AFTER ADVANCING 1 LINES
                           ADD +1  TO  LINE-CTR
                           GO TO  6131-FIND-DPODATAITM-X.

       6131-FIND-DPODATAITM-X.
           EXIT.

       COPY OVRPFCALL IN COPYLIB.

001000************************************************************      XBLOWUP
002000************************************************************      XBLOWUP
003000*                    B L O W U P                           *      XBLOWUP
004000*     CHECK FOR IMAGE, VIEW, OR SPOOL ERROR.  CLOSE        *      XBLOWUP
005000*     FILES, GET OUT OF BLOCK MODE, AND DISPLAY            *      XBLOWUP
006000*     APPROPRIATE ERROR MESSAGE ON SCREEN.                 *      XBLOWUP
007000*                                                          *      XBLOWUP
008000*     ALSO APPENDS THE ERROR MESSAGE TO A FILE CALLED      *      XBLOWUP
009000*     BLOWUP.PUB.  TO READ THIS FILE, RUN "XBLPRT.OBJECT". *      XBLOWUP
010000*                                                          *      XBLOWUP
011000*         |||  PROGRAM IS ABORTED IN TBLOWUP  |||          *      XBLOWUP
012000************************************************************      XBLOWUP
013000************************************************************      XBLOWUP
014000 990-BLOWUP.                                                      XBLOWUP
015000     CALL "TBLOWUP" USING BASE, BU-PGM-NAME, STATUS-AREA,         XBLOWUP
016000           VIEW-COMAREA, FILE-STATUS, BU-DISPLAY-MSG,             XBLOWUP
017000           BU-DISPLAY-FLDS.                                       XBLOWUP
018000 999-EXIT.  EXIT.                                                 XBLOWUP
