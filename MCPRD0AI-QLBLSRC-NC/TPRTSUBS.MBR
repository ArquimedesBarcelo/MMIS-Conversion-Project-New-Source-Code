000200 IDENTIFICATION DIVISION.
000300 PROGRAM-ID.    TPRTSUBS.
000400 ENVIRONMENT DIVISION.
000500 CONFIGURATION SECTION.
000600 SOURCE-COMPUTER.     AS400.
000700 OBJECT-COMPUTER.     AS400.
       COPY SPECIALN IN COPYLIB.
001000 INPUT-OUTPUT SECTION.
001100 FILE-CONTROL.
           SELECT EQUIPMENT-FILE
               ASSIGN TO DATABASE-MCFPMM0200
               ORGANIZATION IS SEQUENTIAL
               ACCESS MODE IS SEQUENTIAL
               FILE STATUS IS EF-STATUS.
           SELECT OUT-FILE
               ASSIGN TO DATABASE-MCFPOUTF
               ORGANIZATION IS SEQUENTIAL
               ACCESS MODE IS SEQUENTIAL
               FILE STATUS IS OF-STATUS.
001200     SELECT PRINT-FILE ASSIGN TO PRINTER-MCPRT.
           SELECT SORT-FILE ASSIGN TO DISK-SORT.
           SELECT WO-EQUIP-HIER
               ASSIGN TO DATABASE-MCFLMM1701
               ORGANIZATION IS INDEXED
               ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                   WITH DUPLICATES
               FILE STATUS IS WEH-STATUS.
001500 DATA DIVISION.
001600 FILE SECTION.
       FD  EQUIPMENT-FILE
           LABEL RECORDS ARE STANDARD
           DATA RECORD IS EFREC.
       01  EFREC.
           COPY DDS-ALL-FORMATS OF MCFPMM0200.
       FD  OUT-FILE
           LABEL RECORDS ARE STANDARD
           DATA RECORD IS OUTF.
       01  OUTF                       PIC X(12).
001700 FD  PRINT-FILE RECORD CONTAINS 132 CHARACTERS
001800     LABEL RECORD IS OMITTED
001900     DATA RECORD IS PRINTF.
002000 01  PRINTF.
           05  PRINT-CTL              PIC X(8).
           05  PRINT-LINE             PIC X(124).
       SD  SORT-FILE
           RECORD CONTAINS 34 CHARACTERS
           DATA RECORD IS SORT-REC.
       01  SORT-REC.
           05  SUBNUM-SORT.
               10  SUBNUM-1-S         PIC X.
               10  SUBNUM-2-S         PIC X.
               10  SUBNUM-3-S         PIC X.
               10  SUBNUM-4-S         PIC X.
           05  SUBNAME-SORT           PIC X(30).
       FD  WO-EQUIP-HIER
           LABEL RECORDS ARE STANDARD
           DATA RECORD IS WEHREC.
       01  WEHREC.
           COPY DDS-ALL-FORMATS OF MCFLMM1701.
003300 WORKING-STORAGE SECTION.
       77  SORT-RECS-READ             PIC 9(5).
       77  SORT-RECS-REL              PIC 9(5).
       77  SUB1                       PIC 9(4).
       77  SUB2                       PIC 9(4).
       77  TAB1-SAVE                  PIC X(34).
