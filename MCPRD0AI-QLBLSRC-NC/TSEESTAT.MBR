035300 PROCEDURE DIVISION.
035500 BEGIN-PGM.
           CALL "CLLBRFIL".
035600     PERFORM 1-HSK.
035700     PERFORM 6-MAIN THRU 6-MAIN-EXIT UNTIL RETURN-SW = "2".
035800 2-EOJ.
           CLOSE DISPLAY-FILE.
           CLOSE WO-BASIC-FILE.
036000     CLOSE LBRFILE.
           CLOSE WO-LABOR-FILE.
           CLOSE WO-LAST-NUM-USED.
           CLOSE WO-NUMBER-FILE.
036400     GOBACK.
036600****************************************************************
036700*    HOUSEKEEPING                                              *
036800****************************************************************
036900 1-HSK.
           OPEN I-O    DISPLAY-FILE.
045600     OPEN I-O    LBRFILE.
           OPEN INPUT  WO-BASIC-FILE.
           OPEN INPUT  WO-LABOR-FILE.
           OPEN INPUT  WO-LAST-NUM-USED.
           OPEN INPUT  WO-NUMBER-FILE.
037000     MOVE "0" TO RETURN-SW.
           MOVE 0 TO COND-WORD.
039100     MOVE 1 TO ARG-NO.
           READ WO-LAST-NUM-USED INTO LAST-WO-BUFF
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF WLNU-STATUS NOT = "00" MOVE 17 TO COND-WORD.
           IF COND-WORD = 17 MOVE 1 TO DATE-FLAG-SW.
039400     MOVE DATE-FLAG-SW TO DATE-FLAG.
039500     MOVE 1 TO DATE-MODE.
039600     MOVE DATE-FLAG TO DATE-CODE.
039700     CALL "TDATECHK" USING DATE-CHECK-AREA.
039800     MOVE DATE-SLASH-OUT TO TMP-DATE-AREA.
040200     CALL "TPWORD" USING PASSWORD-INFORMATION.
040600     IF PASSWORD-FLAG = "N" GO TO 2-EOJ.
043500     IF YEAR-30-Y = "0" MOVE "A" TO YEAR-DISP
043600     ELSE
043700     IF YEAR-30-Y = "1" MOVE "B" TO YEAR-DISP
043800     ELSE
043900     IF YEAR-30-Y = "2" MOVE "C" TO YEAR-DISP
044000     ELSE
044100     IF YEAR-30-Y = "3" MOVE "D" TO YEAR-DISP
044200     ELSE
044300     IF YEAR-30-Y = "4" MOVE "E" TO YEAR-DISP
044400     ELSE
044500     IF YEAR-30-Y = "5" MOVE "F" TO YEAR-DISP
044600     ELSE
044700     IF YEAR-30-Y = "6" MOVE "G" TO YEAR-DISP
044800     ELSE
044900     IF YEAR-30-Y = "7" MOVE "H" TO YEAR-DISP
045000     ELSE
045100     IF YEAR-30-Y = "8" MOVE "J" TO YEAR-DISP
045200     ELSE
045300     IF YEAR-30-Y = "9" MOVE "K" TO YEAR-DISP
045400     ELSE
045500     MOVE " " TO YEAR-DISP.
           MOVE SPACES TO ERROR-BUFFER BUFFER WO-NUM-BUF.
046300     MOVE ZERO TO ACT-KEY.
045800****************************************************************
045900*    MAIN LOGIC                                                *
046000****************************************************************
046100 6-MAIN.
049000     MOVE "FOFFSTWO" TO VIEW-CFNAME.
           MOVE SPACES TO DSPLY-REC.
           MOVE ERROR-BUFFER TO WNB-ERR-LINE.
           MOVE YEAR-DISP TO WO-NUMBER7.
           MOVE 66149 TO CATREAD-MSG-NUMBER.
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
           MOVE ERROR-BUFFER TO WNB-CMD-LINE.
           MOVE WO-NUM-BUF TO DSPLY-REC.
           PERFORM 99-SCREEN-WRITE.
           PERFORM 98-SCREEN-READ.
           MOVE DSPLY-REC TO WO-NUM-BUF.
           IF VIEW-LASTKEY = 0
               MOVE 35134 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE TRUE-VAL TO INDS (99)
               GO TO 6-MAIN.
052700     IF VIEW-LASTKEY = 3 GO TO 2-EOJ.
053400*
053500*    ALIGN WORK ORDER NUMBER
053600*
053700     CALL "TALWONO" USING WO-NUMBER RETURN-CODE.
053800     IF RETURN-CODE = "1"
053900         MOVE "0" TO RETURN-CODE
054100         MOVE WO-NUMBER TO WO-1-10
               MOVE ERROR-LITERAL TO ERROR-BUFFER
054200         MOVE TRUE-VAL TO INDS (1) INDS (99)
054500         GO TO 6-MAIN.
054600*
054700*    DETERMINE IF WORK ORDER IS IN DATABASE
054800*
           MOVE 0 TO COND-WORD.
           MOVE WO-NUMBER TO WONUM OF WNFREC.
           START WO-NUMBER-FILE KEY IS = EXTERNALLY-DESCRIBED-KEY
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF WNF-STATUS NOT = "00" MOVE 17 TO COND-WORD.
055400     IF COND-WORD NOT = 0
055600         MOVE WO-NUMBER TO WO-1-10
055700         MOVE ERROR-LITERAL TO ERROR-BUFFER
055800         MOVE TRUE-VAL TO INDS (1) INDS (99)
055900         GO TO 6-MAIN.
           MOVE 0 TO COND-WORD.
           MOVE WO-NUMBER TO WONUM OF WBFREC.
057400     START WO-BASIC-FILE KEY IS = EXTERNALLY-DESCRIBED-KEY
057500         INVALID KEY    MOVE 17 TO COND-WORD.
           IF WBF-STATUS NOT = "00" MOVE 17 TO COND-WORD.
057600     IF COND-WORD = 17
057700         MOVE 49032 TO CATREAD-MSG-NUMBER
057800         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE WO-NUMBER TO ERR-WO3
               MOVE TRUE-VAL TO INDS (1) INDS (99)
               GO TO 6-MAIN.
           PERFORM 63-READ-DB-AND-SAVE-DATA THRU 63-RDASD-EXIT.
056400 6-MAIN-EXIT.    EXIT.
056500*****************************************************************
056600*    READ DATA BASE AND SAVE DATA                               *
056700*****************************************************************
056800 63-READ-DB-AND-SAVE-DATA.
056900     MOVE ZERO TO LBR-REC-CNT.
057000     MOVE ZERO TO STATUS-REC-CNT.
057900     READ WO-BASIC-FILE NEXT INTO WO-BASIC-DATA
058000         AT END    MOVE 15 TO COND-WORD.
           IF WBF-STATUS NOT = "00" MOVE 15 TO COND-WORD.
058500     IF COND-WORD = 15
058600         MOVE ZERO TO WO-BASIC-REC-CNT
               GO TO 63-RDASD-EXIT.
058200     MOVE +0001 TO WO-BASIC-REC-CNT.
058300     MOVE 1 TO STATUS-REC-CNT.
059100*
059200*    GET LABOR DATA
059300*
           MOVE 0 TO COND-WORD.
           MOVE WO-NUMBER TO WONUM OF WLFREC.
           START WO-LABOR-FILE KEY IS = EXTERNALLY-DESCRIBED-KEY
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF WLF-STATUS NOT = "00" MOVE 17 TO COND-WORD.
059900     IF COND-WORD = 17
060000         MOVE 49032 TO CATREAD-MSG-NUMBER
060100         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE TRUE-VAL TO INDS (1) INDS (99)
               MOVE WO-NUMBER TO ERR-WO3
060600         GO TO 63-RDASD-EXIT.
061000*
061100*    CLEAR LABOR WORK AREA
061200*
061300     MOVE ZEROES TO LABOR-WORK-AREA.
           MOVE SPACES TO LCR-I.
061400     MOVE ZERO TO LA-CRAFT-CNT.
061500     IF WO-BASIC-REC-CNT NOT = 0
061600         PERFORM 632-SET-LA-CRAFT-REQ.
061700     MOVE "0" TO RET-CODE.
061800     PERFORM 633-READ-AND-SAVE-1-LBR-REC
061900         UNTIL COND-WORD = 15.
           MOVE "0" TO RETURN-SW.
           PERFORM 65-DISPLAY-CONTROL UNTIL RETURN-SW = "1" OR "2".
       63-RDASD-EXIT.    EXIT.
062000 632-SET-LA-CRAFT-REQ.
062100     MOVE ZERO TO LA-CRAFT-CNT.
062200     IF CRAFTS-REQD-1 NOT = "  "
062300         MOVE CRAFTS-REQD-1 TO CRAFT-DESIRED
062400         PERFORM 6320-DET-CRAFT-SUBSCRIPT.
062500     IF CRAFTS-REQD-2 NOT = "  "
062600         MOVE CRAFTS-REQD-2 TO CRAFT-DESIRED
062700         PERFORM 6320-DET-CRAFT-SUBSCRIPT.
062800     IF CRAFTS-REQD-3 NOT = "  "
062900         MOVE CRAFTS-REQD-3 TO CRAFT-DESIRED
063000         PERFORM 6320-DET-CRAFT-SUBSCRIPT.
063100 6320-DET-CRAFT-SUBSCRIPT.
063200     IF LA-CRAFT-CNT = ZERO
063300         MOVE +0001 TO CRFT-SUBSC
063400         MOVE +0001 TO LA-CRAFT-CNT
063500         MOVE CRAFT-DESIRED TO LA-CRAFT-REQ (CRFT-SUBSC)
063600     ELSE
063700     MOVE ZERO TO CRFT-SUBSC
063800     PERFORM 63200-LOOP-TABLE
063900         VARYING LOOP-CNT FROM 1 BY 1
064000         UNTIL LOOP-CNT IS GREATER THAN LA-CRAFT-CNT.
064100     IF CRFT-SUBSC = ZERO
064200         ADD +0001 TO LA-CRAFT-CNT
064300         MOVE LA-CRAFT-CNT TO CRFT-SUBSC
064400         MOVE CRAFT-DESIRED TO LA-CRAFT-REQ (CRFT-SUBSC).
064500 63200-LOOP-TABLE.
064600     IF LA-CRAFT-REQ (LOOP-CNT) = CRAFT-DESIRED
064700         MOVE LOOP-CNT TO CRFT-SUBSC.
064800 633-READ-AND-SAVE-1-LBR-REC.
064900     READ WO-LABOR-FILE NEXT INTO WO-LABOR-DATA
065000         AT END    MOVE 15 TO COND-WORD.
           IF WO-NUMBER NOT =  WONUM OF WLFREC MOVE 15 TO COND-WORD.
           IF WLF-STATUS NOT = "00" MOVE 15 TO COND-WORD.
065100     IF COND-WORD = 0
065200         ADD +0001 TO LBR-REC-CNT
065300         MOVE LBR-CRAFT TO CRAFT-DESIRED
065400         PERFORM 6320-DET-CRAFT-SUBSCRIPT
065500         ADD +01 TO LA-MEN-ACT (CRFT-SUBSC)
065600         MOVE LBR-HRS1-99 TO UNITS-POSITION
065700         MOVE LBR-HRS2-9 TO TENTHS-POSITION
065800         ADD DECIMAL-NUM TO LA-HRS-ACT (CRFT-SUBSC)
065900         DIVIDE LBR-CST-CENTS-9 BY 100
066000             GIVING TMP-LBR-CST
066100         ADD LBR-CST-DOLLR-9 TO TMP-LBR-CST
066200         ADD TMP-LBR-CST TO LA-TOTAL-COST
066300         ADD TMP-LBR-CST TO LA-TOT-CRF-CST (CRFT-SUBSC)
066400         ADD 1 TO ACT-KEY
               MOVE ACT-KEY TO LBR-KEY
               MOVE WO-LABOR-DATA TO LBRREC-DATA
066500         WRITE LBRREC     INVALID KEY GO TO 2-EOJ.
067600*****************************************************************
067700*    LOGIC CONTROL OF DISPLAY                                   *
067800*****************************************************************
067900 65-DISPLAY-CONTROL.
068300     IF VIEW-LASTKEY = 2
               MOVE SPACES TO BUFFER WO-NUM-BUF
068400         MOVE "1" TO RETURN-SW
068500     ELSE
068600     IF VIEW-LASTKEY = 4
068700         PERFORM 651-WRITE-WO-BASIC
068800     ELSE
      *-------- TOOK OUT LOGIC TO DISPLAY HISTORY.
068900*    IF VIEW-LASTKEY = 5
069000*        PERFORM 652-DISPLAY-STATUS-CODES
069400*    ELSE
069500     IF VIEW-LASTKEY = 6
               MOVE 0 TO LBR-KEY
069600         PERFORM 654-WRITE-WO-LABOR-USED
069700     ELSE
070100     IF VIEW-LASTKEY = 3
070200         MOVE "2" TO RETURN-SW.
073200*****************************************************************
073300*    DISPLAY BASIC WORK ORDER                                   *
073400*****************************************************************
073500 651-WRITE-WO-BASIC.
073600     IF WO-BASIC-REC-CNT = 0
073700         MOVE "FNOBASIC" TO VIEW-CFNAME
           ELSE
075100     MOVE "FOFFBASC" TO VIEW-CFNAME.
074500     PERFORM 6511-MOVE-WO-BASIC-TO-BUF2.
           MOVE 66150 TO CATREAD-MSG-NUMBER.
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
           MOVE ERROR-BUFFER TO BUFFER-CMD-LINE.
           MOVE BUFFER TO DSPLY-REC.
           PERFORM 99-SCREEN-WRITE.
           PERFORM 98-SCREEN-READ.
077000 6511-MOVE-WO-BASIC-TO-BUF2.
077100     MOVE SPACES TO BUFFER.
077200     MOVE WO-NUMBER            TO WO-NUM-BUFF.
077300     MOVE WO-STATUS            TO WO-STATUS-BUF2.
077400     MOVE DATE-RECD            TO T-D-DEF1-1.
077500     MOVE T-D-DEF1-YY          TO T-D-DEF2-YY.
077600     IF DATE-FLAG = 3
077700         MOVE T-D-DEF2-MD      TO DATE-RECD-DM-BUF2
077800         MOVE T-D-DEF2-DM      TO DATE-RECD-MD-BUF2
077900         MOVE T-D-DEF2-YY      TO DATE-RECD-YY-BUF2
078000     ELSE
078100     MOVE T-D-DEF2-2           TO DATE-RECD-BUF2.
078200     MOVE TIME-RECD            TO TIME-RECD-BUF2.
078300     MOVE APPROVAL-CODE        TO APPROVAL-CODE-BUF2.
078400     MOVE REQUESTER            TO REQUESTER-BUF2.
078500     MOVE EQUIP-NUM            TO EQUIP-NUM-BUF2.
078600     MOVE EQUIP-NAME           TO EQUIP-NAME-BUF2.
078700     MOVE TYPE-NUM             TO TYPE-NUM-BUF2.
078800     MOVE DEPT                 TO DEPT-BUF2.
078900     MOVE ZONE                 TO ZONE-BUF2.
079000     MOVE LOCATION             TO LOCATION-BUF2.
079100     MOVE PRIORITY             TO PRIORITY-BUF2.
079200     MOVE EQUIP-DOWN           TO EQUIP-DOWN-BUF2.
079300     MOVE CRAFTS-REQD-1        TO CRAFTS-REQT-1-BUF2.
079400     MOVE CRAFTS-REQD-2        TO CRAFTS-REQT-2-BUF2.
079500     MOVE CRAFTS-REQD-3        TO CRAFTS-REQT-3-BUF2.
079600     MOVE EXP-CLASS            TO EXP-CLASS-BUF2.
079700     MOVE DESCRIPTION-1        TO DESCRIPTION-1-BUF2.
079800     MOVE CRAFTSMEN-1          TO CRAFTSMEN-1-BUF2.
079900     MOVE CRAFTSMEN-2          TO CRAFTSMEN-2-BUF2.
080000     MOVE CRAFTSMEN-3          TO CRAFTSMEN-3-BUF2.
080100     MOVE DATE-STRT            TO T-D-DEF1-1.
080200     MOVE T-D-DEF1-YY          TO T-D-DEF2-YY.
080300     MOVE T-D-DEF2-2           TO DATE-STRT-BUF2.
080400     IF DATE-FLAG = 3
080500         MOVE T-D-DEF2-MD      TO DATE-STRT-DM-BUF2
080600         MOVE T-D-DEF2-DM      TO DATE-STRT-MD-BUF2
080700         MOVE T-D-DEF2-YY      TO DATE-STRT-YY-BUF2
080800     ELSE
080900     MOVE TIME-STRT            TO TIME-STRT-BUF2.
081000     MOVE FAIL-CODE-REASON     TO FAIL-CODE-REASON-BUF2.
081100     MOVE FAIL-CODE-SUBSYS     TO FAIL-CODE-SUBSYS-BUF2.
081200     MOVE DATE-COMP            TO T-D-DEF1-1.
081300     MOVE T-D-DEF1-YY          TO T-D-DEF2-YY.
081400     IF DATE-FLAG = 3
081500         MOVE T-D-DEF2-MD      TO DATE-COMP-DM-BUF2
081600         MOVE T-D-DEF2-DM      TO DATE-COMP-MD-BUF2
081700         MOVE T-D-DEF2-YY      TO DATE-COMP-YY-BUF2
081800     ELSE
081900     MOVE T-D-DEF2-2           TO DATE-COMP-BUF2.
082000     MOVE TIME-COMP            TO TIME-COMP-BUF2.
082500     ACCEPT TMP-TIME-AREA FROM TIME.
082600     MOVE DATE-SLASH-OUT TO TMP-DATE-AREA.
097500 654-WRITE-WO-LABOR-USED.
102100     MOVE "FDISPLAB" TO VIEW-CFNAME.
102600     MOVE SPACES TO LABOR-LINES.
097600     IF LBR-REC-CNT = 0
098000         MOVE 1 TO DATE-MODE
098100         MOVE DATE-FLAG TO DATE-CODE
098200         CALL "TDATECHK" USING DATE-CHECK-AREA
098300         MOVE DATE-SLASH-OUT TO LL-DATE
098400         ACCEPT TMP-TIME-AREA FROM TIME
098500         MOVE TTA-HRS TO LL-TIME-HH
098600         MOVE ":" TO LL-SEMICOLON
098700         MOVE TTA-MIN TO LL-TIME-MM
098800         MOVE WO-NUM TO LL-WO
098900         PERFORM 65400-MOVE-CRAFT-REQD-DATA
099000             VARYING LOOP-CNT FROM 1 BY 1
099100             UNTIL LOOP-CNT GREATER THAN LA-CRAFT-CNT
099200         PERFORM 65401-MOVE-MEN-REQD-DATA
099300             VARYING LOOP-CNT FROM 1 BY 1
099400             UNTIL LOOP-CNT IS GREATER THAN LA-CRAFT-CNT
099500         PERFORM 65404-MOVE-MEN-ACT-DATA
099600             VARYING LOOP-CNT FROM 1 BY 1
099700             UNTIL LOOP-CNT IS GREATER THAN LA-CRAFT-CNT
099800         PERFORM 65402-MOVE-HRS-EST-DATA
099900             VARYING LOOP-CNT FROM 1 BY 1
100000             UNTIL LOOP-CNT IS GREATER THAN LA-CRAFT-CNT
100100         PERFORM 65403-MOVE-HRS-ACT-DATA
100200             VARYING LOOP-CNT FROM 1 BY 1
100300             UNTIL LOOP-CNT IS GREATER THAN LA-CRAFT-CNT
100400         MOVE LA-TOTAL-COST TO LL-TOT-COST
100500         MOVE "    NO LABOR HAS BEEN RECORDED AGAINST THIS WORK OR
100600-             "DER" TO LL-DATA (3)
               MOVE 30077 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE ERROR-BUFFER TO LL-DEPRESS-LINE
               MOVE LABOR-LINES TO DSPLY-REC
               PERFORM 99-SCREEN-WRITE
               PERFORM 98-SCREEN-READ
101800     ELSE
101900     PERFORM 6540-WRITE-LABOR.
102000 6540-WRITE-LABOR.
102700     MOVE 1 TO DATE-MODE.
102800     MOVE DATE-FLAG TO DATE-CODE.
102900     CALL "TDATECHK" USING DATE-CHECK-AREA.
103000     MOVE DATE-SLASH-OUT TO LL-DATE.
103100     ACCEPT TMP-TIME-AREA FROM TIME.
103200     MOVE TTA-HRS TO LL-TIME-HH.
103300     MOVE ":" TO LL-SEMICOLON.
103400     MOVE TTA-MIN TO LL-TIME-MM.
103500     MOVE WO-NUMBER TO LL-WO.
103600     PERFORM 65400-MOVE-CRAFT-REQD-DATA
103700         VARYING LOOP-CNT FROM 1 BY 1
103800         UNTIL LOOP-CNT GREATER THAN LA-CRAFT-CNT.
103900     PERFORM 65401-MOVE-MEN-REQD-DATA
104000         VARYING LOOP-CNT FROM 1 BY 1
104100         UNTIL LOOP-CNT IS GREATER THAN LA-CRAFT-CNT.
104200     PERFORM 65404-MOVE-MEN-ACT-DATA
104300         VARYING LOOP-CNT FROM 1 BY 1
104400         UNTIL LOOP-CNT IS GREATER THAN LA-CRAFT-CNT.
104500     PERFORM 65402-MOVE-HRS-EST-DATA
104600         VARYING LOOP-CNT FROM 1 BY 1
104700         UNTIL LOOP-CNT IS GREATER THAN LA-CRAFT-CNT.
104800     PERFORM 65403-MOVE-HRS-ACT-DATA
104900         VARYING LOOP-CNT FROM 1 BY 1
105000         UNTIL LOOP-CNT IS GREATER THAN LA-CRAFT-CNT.
105100     MOVE LA-TOTAL-COST TO LL-TOT-COST.
105200     MOVE "0" TO RET-CODE.
105300     MOVE LBR-REC-CNT TO LBR-REC-CHECK.
105400     PERFORM 65411-ZERO-LA-SUM-CRF-CST
105500         VARYING LINE-CNT FROM 1 BY 1
105600         UNTIL LINE-CNT IS GREATER THAN 10.
105700     MOVE +0001 TO LINE-CNT.
105800     MOVE +0010 TO CNT-LIMIT.
105900     MOVE ZERO TO LBR-KEY.
106000     PERFORM 65410-LOOP-SCREENS
106100         UNTIL RET-CODE = "1".
106200 65400-MOVE-CRAFT-REQD-DATA.
106300     MOVE LA-CRAFT-REQ (LOOP-CNT) TO
106400         LL-CRF-MEN (LOOP-CNT).
106500 65401-MOVE-MEN-REQD-DATA.
106600     IF LA-MEN-EST-I (LOOP-CNT) NOT = SPACES
106700         MOVE LA-MEN-EST (LOOP-CNT) TO
106800             LL-EST-MEN (LOOP-CNT).
106900 65402-MOVE-HRS-EST-DATA.
107000     IF LA-HRS-EST-I (LOOP-CNT) NOT = SPACES
107100         MOVE LA-HRS-EST (LOOP-CNT) TO
107200             LL-HRSE (LOOP-CNT).
107300 65403-MOVE-HRS-ACT-DATA.
107400     IF LA-HRS-ACT-I (LOOP-CNT) NOT = SPACES
107500         MOVE LA-HRS-ACT (LOOP-CNT) TO
107600             LL-HRSA (LOOP-CNT).
107700 65404-MOVE-MEN-ACT-DATA.
107800     IF LA-MEN-ACT-I (LOOP-CNT) NOT = SPACES
107900         MOVE LA-MEN-ACT (LOOP-CNT) TO
108000             LL-ACT-MEN (LOOP-CNT).
108100 65410-LOOP-SCREENS.
108200     IF CNT-LIMIT IS GREATER THAN LBR-REC-CHECK
108300         MOVE LBR-REC-CHECK TO CNT-LIMIT
108400         MOVE "1" TO RET-CODE.
108500     PERFORM 654100-WRITE-ONE-LINE CNT-LIMIT TIMES.
           MOVE 66152 TO CATREAD-MSG-NUMBER.
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
           MOVE ERROR-BUFFER TO LL-CMD-LINE.
           MOVE 30077 TO CATREAD-MSG-NUMBER.
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
           MOVE ERROR-BUFFER TO LL-DEPRESS-LINE.
           MOVE LABOR-LINES TO DSPLY-REC.
           PERFORM 99-SCREEN-WRITE.
           PERFORM 98-SCREEN-READ.
109600     MOVE "0" TO RETURN-SW-2.
109800     MOVE 1 TO LINE-CNT.
109900     IF LBR-REC-CHECK > 10
110000         SUBTRACT 10 FROM LBR-REC-CHECK.
110100 654100-WRITE-ONE-LINE.
110200     ADD 1 TO LBR-KEY.
           IF LBR-KEY = 1
               READ LBRFILE FIRST AT END    GO TO 2-EOJ
           ELSE
110300     READ LBRFILE NEXT AT END    GO TO 2-EOJ.
           MOVE LBRREC-DATA TO WO-LABOR-DATA.
110700     IF LBR-KEY = LBR-REC-CNT
110800         MOVE "1" TO RET-CODE.
110900     MOVE SPACES TO LRA-LINE.
111000     MOVE LINE-CNT TO TMP-L-C-FIELD1.
111100     MOVE LBR-EMPL-NUM TO LL-CRAFTSMAN (LINE-CNT).
111200     MOVE LBR-EMPL-NAME TO LL-CRAFTSMAN-NAME (LINE-CNT).
111300     MOVE LBR-CRAFT TO LL-CRAFT (LINE-CNT).
           IF LBR-HRS = SPACES
               MOVE ZEROES TO LBR-HRS1-99 LBR-HRS2-9.
111400     MOVE LBR-HRS1-99 TO LL-HRS1-99 (LINE-CNT).
111500     MOVE "." TO LL-HRS-DEC (LINE-CNT).
111600     MOVE LBR-HRS2-9 TO LL-HRS2-9 (LINE-CNT).
111700     MOVE LBR-SHIFT-1 TO LL-SHIFT (LINE-CNT).
111800     MOVE LBR-CST-DOLLR-9 TO LL-CST-DOLLR-9 (LINE-CNT).
111900     MOVE "." TO LL-CST-DEC (LINE-CNT).
112000     MOVE LBR-CST-CENTS-9 TO LL-CST-CENTS-9 (LINE-CNT).
112100     MOVE LBR-CRAFT TO CRAFT-DESIRED.
112200     PERFORM 6320-DET-CRAFT-SUBSCRIPT.
112300     COMPUTE LA-SUM-CRF-CST (CRFT-SUBSC) =
112400         LA-SUM-CRF-CST (CRFT-SUBSC) +
112500         LBR-CST-DOLLR-9 + LBR-CST-CENTS-9 / 100.
225800     MOVE 4 TO DATE-MODE.
225900     MOVE LBR-START-DATE TO DATE-VALIDATE-IN.
226000     CALL "TDATECHK" USING DATE-CHECK-AREA.
226100     MOVE DATE-OUT TO LL-DATE-ST (LINE-CNT).
226200     MOVE LBR-START-TIME-HH TO LL-TIME-ST-HH (LINE-CNT).
226300     MOVE LBR-START-TIME-MM TO LL-TIME-ST-MM (LINE-CNT).
226400     MOVE 4 TO DATE-MODE.
226500     MOVE LBR-COMPL-DATE TO DATE-VALIDATE-IN.
226600     CALL "TDATECHK" USING DATE-CHECK-AREA.
226700     MOVE DATE-OUT TO LL-DATE-CO (LINE-CNT).
226800     MOVE LBR-COMPL-TIME-HH TO LL-TIME-CO-HH (LINE-CNT).
226900     MOVE LBR-COMPL-TIME-MM TO LL-TIME-CO-MM (LINE-CNT).
114600     ADD 1 TO LINE-CNT.
118700 65411-ZERO-LA-SUM-CRF-CST.
118800     MOVE ZERO TO LA-SUM-CRF-CST (LINE-CNT).

       98-SCREEN-READ.
           READ DISPLAY-FILE INDIC IS INDICS
               MOVE FUNCTION-NUM TO VIEW-LASTKEY
               MOVE ALL B"0" TO INDICS.
       99-SCREEN-WRITE.
           WRITE DSPLY-REC FORMAT IS VIEW-CFNAME
               INDIC IS INDICS.

       999-CATREAD.
           MOVE SPACES TO ERROR-BUFFER.
           CALL "CCATREAD" USING CATREAD-PARMS.
           MOVE CATREAD-MSG-TEXT TO ERROR-BUFFER.
       999-CATREAD-EXIT.    EXIT.
