006300     SELECT RELEASE-CREATE-END-FILE ASSIGN TO DISK-MCXRLBOT.
006400     SELECT RELEASE-CREATE-JOB-FILE ASSIGN TO DISK-MCXRELCRTE.

           SELECT DISPLAY-FILE
                  ASSIGN TO WORKSTATION-ZRLBTSEL-SI
                  ORGANIZATION IS TRANSACTION
      ****        ACCESS IS SEQUENTIAL
                  ACCESS IS DYNAMIC
                  RELATIVE KEY IS RELATIVE-RECNO
                  FILE STATUS IS DISPLAY-STATUS
                  CONTROL-AREA IS WS-CONTROL.

           SELECT MPLTINFO-I
                  ASSIGN TO DATABASE-MCFLCS0501
                  ORGANIZATION IS INDEXED
                    ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                  FILE STATUS IS FILE-STATUS.

           SELECT DPORECD-I
                  ASSIGN TO DATABASE-MCFLCS0901
                  ORGANIZATION IS INDEXED
                    ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                    WITH DUPLICATES
                  FILE STATUS IS FILE-STATUS.

           SELECT DSHIPREL-I
                  ASSIGN TO DATABASE-MCFLCS2901
                  ORGANIZATION IS INDEXED
                    ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                    WITH DUPLICATES
                  FILE STATUS IS FILE-STATUS.

