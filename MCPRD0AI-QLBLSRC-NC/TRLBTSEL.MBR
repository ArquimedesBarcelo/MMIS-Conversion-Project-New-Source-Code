053200     MOVE "RLBTSEL1"         TO  VIEW-NFNAME.
054700     MOVE SPACES             TO  SCREEN-1.
054800     MOVE COMP-SCREEN-INDIC  TO  DISP-COMPANY-1.
055500
055600 6-SHOWFORM-SCREEN-1.
           MOVE SCREEN-1           TO DISPLAY-REC.
           PERFORM 998-WRITE-SCREEN THRU 998-READ-SCREEN.
           MOVE DISPLAY-REC        TO SCREEN-1.
056300
056400     IF VIEW-LASTKEY = 3
056500         GO TO 6-M-X
056600     ELSE
058000     IF VIEW-LASTKEY = 1 OR
058100        VIEW-LASTKEY = 2 OR
058200        VIEW-LASTKEY = 4 OR
058300        VIEW-LASTKEY = 5 OR
058400        VIEW-LASTKEY = 6 OR
058500        VIEW-LASTKEY = 7 OR
              VIEW-LASTKEY = 8
058700*        "* INVALID FUNCTION KEY ENTERED *"
058800         MOVE   9 TO LANG-SETNUM
058900         MOVE  10 TO LANG-MSGNUM
059000         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
059100         MOVE 3  TO  FIELD-NUMBER
059200         PERFORM 4-PGM-ERROR  THRU  4-PGM-ERROR-X
059300         GO TO 6-SHOWFORM-SCREEN-1.
059400
      *------ FIELD EDITS
           IF DE-PROCESS-ALL-1 = SPACES AND
              DE-BLKT-NUM = SPACES
      *    YOU MUST CHOOSE AN OPTION
               MOVE 25030 TO CATREAD-MSG-NUMBER
069800         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
069900         MOVE 3  TO FIELD-NUMBER
070000         PERFORM 4-PGM-ERROR  THRU  4-PGM-ERROR-X
070100         GO TO 6-SHOWFORM-SCREEN-1.
061300
           IF DE-PROCESS-ALL-1 NOT = SPACES AND
              DE-BLKT-NUM NOT = SPACES
      *    SELECT ONLY ONE OPTION
               MOVE 66140 TO CATREAD-MSG-NUMBER
069800         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
069900         MOVE 1  TO FIELD-NUMBER
070000         PERFORM 4-PGM-ERROR  THRU  4-PGM-ERROR-X
070100         GO TO 6-SHOWFORM-SCREEN-1.

061400****************************************************
061500*                                                  *
061600*   CHECK FOR A PROCESS THE ENTIRE FILE OPTION     *
061700*   SELECTION. IF THIS WAS CHOSEN THEN BYPASS      *
061800*   THE REVIEW SCREEN AND STREAM THE RELEASE       *
061900*   CREATE JOB STREAM. ONCE THIS IS DONE END THE   *
062000*   PROGRAM                                        *
062100*                                                  *
062200****************************************************
062300
062400 6-CHECK-FOR-PROCESS-ALL.
062500     IF DE-PROCESS-ALL-1 = "X"
062600         PERFORM 64-BUILD-RLACTIVE  THRU  64-BUILD-RLACTIVE-X
062700         IF ERR-SW = "Y"
062800             MOVE 3  TO  FIELD-NUMBER
062900             PERFORM 4-PGM-ERROR  THRU  4-PGM-ERROR-X
063000             GO TO 6-SHOWFORM-SCREEN-1
063100         ELSE
063200             MOVE "X"  TO  DE-PROCESS-ALL
063300             PERFORM 62-CREATE-LAUNCH-JOB-STREAM  THRU  62-CLJS-X
063400             GO TO 6-M-X.
063500
063600*****************************************************
063700*                                                   *
063800*    EDIT REQUIREMENT ORDER NUMBER                  *
063900*                                                   *
064000*****************************************************
064100
064200 6-EDIT-REQUIRE-ORDER.
064300     IF DE-BLKT-NUM = "ALL"
064400         GO TO 6-REVIEW-BATCH-FILE.
064500     MOVE DE-BLKT-NUM             TO  PO-NUM.
064600     MOVE BUILD-PO-NUM            TO  PO-ARG.
           MOVE PO-ARG TO PORCVNO OF DPORECD-REC-I.
           START DPORECD-I KEY = PORCVNO OF DPORECD-REC-I
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
065100*            "* REQUIREMENT ORDER DOES NOT EXIST *"
065200             MOVE  18 TO LANG-SETNUM
065300             MOVE  20 TO LANG-MSGNUM
065400             PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
065500             MOVE MESSAGE-BUFFER TO MSG-TEXT
065600             MOVE DE-BLKT-NUM  TO  MSG-FLD
065700             MOVE 1            TO  FIELD-NUMBER
065800             PERFORM 4-PGM-ERROR  THRU  4-PGM-ERROR-X
065900             GO TO 6-SHOWFORM-SCREEN-1
066000         ELSE
066100             MOVE "FIND DPORECD 6-ERO" TO BU-DISPLAY-MSG
066200             MOVE PO-ARG               TO BU-DISPLAY-FLD (1)
066300             GO TO 2-BLOWUP.
066400
066500 6-REVIEW-BATCH-FILE.
066600     PERFORM 61-PROCESS-BATCH-FILE  THRU  61-PBF-X.
066700     IF VIEW-LASTKEY = 3
066800         GO TO 6-MAIN.
066900
067000     PERFORM 62-CREATE-LAUNCH-JOB-STREAM  THRU  62-CLJS-X.
067100
067200     GO TO 6-MAIN.
067300
067400 6-M-X.
067500     EXIT.
067600
067700
067800 61-PROCESS-BATCH-FILE.
      *----- CALL CCRTFILE TO CREATE A TEMPORARY FILE 'BATCFILE'
      *----- LIBRARY 'QTEMP' IS USED FOR TEMPORARY FILES
           MOVE SPACES        TO CCRTFILE-PARMS.
           MOVE "QTEMP"       TO CCRTFILE-LIBRARY.
           MOVE "BATCFILE"    TO CCRTFILE-FILE.
           MOVE "0106"        TO CCRTFILE-RECORD-LENGTH.
           MOVE "01000"       TO CCRTFILE-NO-RECORDS.
           MOVE "01000"       TO CCRTFILE-INCREMENT-AMT.
           MOVE "20"          TO CCRTFILE-NO-INCREMENTS.
           CALL "CCRTFILE" USING CCRTFILE-LIBRARY,
                                 CCRTFILE-FILE,
                                 CCRTFILE-RECORD-LENGTH,
                                 CCRTFILE-NO-RECORDS,
                                 CCRTFILE-INCREMENT-AMT,
                                 CCRTFILE-NO-INCREMENTS,
                                 CCRTFILE-STATUS.
           IF CCRTFILE-STATUS NOT = "00"
               MOVE "CCRTFILE CREATE OF 'PRNTWORK' FAILED"
                  TO BU-DISPLAY-MSG
               GO TO 2-BLOWUP.
      *******************************************************
      **   DO A CLEAR PHYSICAL FILE MEMBER ON BATCFILE
      **   IN CASE THIS ROUTINE WAS ALREADY EXECUTED AT LEAST
      **   ONCE BECAUSE FOR SOME REASON IF NO ENTRIES QUALIFY
      **   DURING THE INPUT PROCEDURE THEN THE FILE BATCFILE
      **   HAS THE OLD ENTRIES FROM THE PREVIOUS EXECUTION.
      *******************************************************

           MOVE "CLRPFM FILE(QTEMP/BATCFILE)" TO OVRDBF-PARM1.
           CALL "QCMDEXC" USING OVRDBF-PARM1, OVRDBF-PARM2.

067900     SORT SORT-FILE ON ASCENDING KEY SORT-REQ-ORDER
068000                                     SORT-ITEM
068100                                     SORT-ITEM-SEQ-NO
068200         INPUT PROCEDURE IS READ-BATCH-FILE
068300         GIVING BATCH-FILE-SORTED.
068400
068500     OPEN INPUT BATCH-FILE-SORTED.
068600
           IF SAVE-PCPO-SW = "Y"
               MOVE "RLSFLCNTL2" TO SFL-CNTL-NAME
           ELSE
               MOVE "RLSFLCNTL"  TO SFL-CNTL-NAME.
069200
069300     MOVE SPACES  TO  SCREEN-2
                            SCREEN-2B.
069400     MOVE COMP-SCREEN-INDIC  TO  DISP-COMPANY-2.
069500     MOVE 1                  TO  ACT-KEY.
069600
069700 61-PUT-BUFFER-2.
           MOVE ALL B"0" TO SRF-INDICATORS.

           PERFORM 612-CLEAR-SUBFILE.

069800     PERFORM 611-FILL-BATCH-INQ-SCREEN THRU 611-FBIS-X.
071300
071400 61-SHOWFORM-SCREEN-2.
           WRITE DISPLAY-REC FROM SCREEN-2B
               FORMAT "RLSFLB"
               INDICATORS SRF-INDICATORS.

           MOVE B"1"     TO IND(70) IND(71) IND(73).

      **** IF RELATIVE-RECNO > ZERO
      ****     MOVE B"1" TO IND(75)
      **** ELSE
      ****     MOVE B"0" TO IND(75).

           WRITE SUBFILE DISPLAY-REC FROM SCREEN-2
               FORMAT SFL-CNTL-NAME
               INDICATORS SRF-INDICATORS.
           MOVE ALL B"0" TO SRF-INDICATORS.
           READ DISPLAY-FILE
               FORMAT SFL-CNTL-NAME
               INDICATORS SRF-INDICATORS.

      *    PERFORM 998-WRITE-SCREEN THRU 998-READ-SCREEN.
           MOVE DISPLAY-REC    TO SCREEN-2.
072100
072200     IF F3-KEY-USED
               MOVE ALL B"0" TO SRF-INDICATORS
               MOVE FUNCTION-NUM TO VIEW-LASTKEY
072300         GO TO 61-CLOSE-BATCH-FILE.

           IF F4-KEY-USED
               CALL "SPOINQ" USING BASE,
                                   BASE-STHIST,
                                   VIEW-COMAREA,
                                   COMP-SCREEN-INDIC,
                                   LANGUAGE-PARMS
               MOVE ALL B"0" TO SRF-INDICATORS
               GO TO 61-SHOWFORM-SCREEN-2.

076700     IF F1-KEY-USED
076800         PERFORM 63-DISPLAY-INSTRUCTION-SCREEN THRU 63-DIS-X
076900         GO TO 61-SHOWFORM-SCREEN-2.
080100
080200 61-EDIT-SELECTION.

           MOVE "N"  TO  REL-CHOSEN-SW.
           MOVE 1    TO  RELATIVE-RECNO.
           INITIALIZE    DE-SUBFILE
                         DE-SUBFILE-L.
           IF SAVE-PCPO-SW = "Y"
               PERFORM UNTIL DE-SELECT-L = "X" OR
                             RELATIVE-RECNO > MAX-RECS
                   READ SUBFILE DISPLAY-FILE
                        INTO DE-SUBFILE-L
                        FORMAT IS "RLSFL2"
                   END-READ
                   ADD 1  TO RELATIVE-RECNO
               END-PERFORM
               IF DE-SELECT-L = "X"
                   MOVE "Y"  TO  REL-CHOSEN-SW
               END-IF
           ELSE
               PERFORM UNTIL DE-SELECT = "X" OR
                             RELATIVE-RECNO > MAX-RECS
                   READ SUBFILE DISPLAY-FILE
                        INTO DE-SUBFILE
                        FORMAT IS "RLSFL"
                   END-READ
                   ADD 1  TO RELATIVE-RECNO
               END-PERFORM
               IF DE-SELECT = "X"
                   MOVE "Y"  TO  REL-CHOSEN-SW.

           IF DE-PROCESS-ALL = SPACES
             IF REL-CHOSEN-SW = "N"
                 IF DE-PROCESS-ONLY-TABLE = SPACES AND
                    DE-PROCESS-EXCEPT-TABLE = SPACES
      *        "YOU MUST SELECT AN OPTION BY WHICH TO PROCESS THE BATCH FILE"
                   MOVE  25 TO LANG-SETNUM
                   MOVE  16 TO LANG-MSGNUM
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE 2  TO  FIELD-NUMBER
                   PERFORM 4-PGM-ERROR  THRU  4-PGM-ERROR-X
                   GO TO 61-SHOWFORM-SCREEN-2.

           IF DE-PROCESS-ALL > SPACES
               IF DE-PROCESS-ONLY-TABLE > SPACES OR
                  DE-PROCESS-EXCEPT-TABLE > SPACES
      *            "* SELECT ONLY ONE OPTION *"
                   MOVE  19 TO LANG-SETNUM
                   MOVE  27 TO LANG-MSGNUM
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE  2  TO  FIELD-NUMBER
                   PERFORM 4-PGM-ERROR  THRU  4-PGM-ERROR-X
                   GO TO 61-SHOWFORM-SCREEN-2.

           IF DE-PROCESS-ALL NOT = SPACES
               IF REL-CHOSEN-SW = "Y"
      *            "* SELECT ONLY ONE OPTION *"
                   MOVE  19 TO LANG-SETNUM
                   MOVE  27 TO LANG-MSGNUM
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE  2  TO  FIELD-NUMBER
                   PERFORM 4-PGM-ERROR  THRU  4-PGM-ERROR-X
                   GO TO 61-SHOWFORM-SCREEN-2.

           IF DE-PROCESS-ONLY-TABLE > SPACES
               IF REL-CHOSEN-SW = "Y"
      *            "* SELECT ONLY ONE OPTION *"
                   MOVE  19 TO LANG-SETNUM
                   MOVE  27 TO LANG-MSGNUM
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE  3  TO  FIELD-NUMBER
                   PERFORM 4-PGM-ERROR  THRU  4-PGM-ERROR-X
                   GO TO 61-SHOWFORM-SCREEN-2.
084400
           IF DE-PROCESS-EXCEPT-TABLE > SPACES
               IF REL-CHOSEN-SW = "Y"
      *            "* SELECT ONLY ONE OPTION *"
                   MOVE  19 TO LANG-SETNUM
                   MOVE  27 TO LANG-MSGNUM
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE 15  TO  FIELD-NUMBER
                   PERFORM 4-PGM-ERROR  THRU  4-PGM-ERROR-X
                   GO TO 61-SHOWFORM-SCREEN-2.

           IF DE-PROCESS-ONLY-TABLE > SPACES
               IF DE-PROCESS-EXCEPT-TABLE > SPACES
      *            "* SELECT ONLY ONE OPTION *"
                   MOVE  19 TO LANG-SETNUM
                   MOVE  27 TO LANG-MSGNUM
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE  3  TO  FIELD-NUMBER
                   PERFORM 4-PGM-ERROR  THRU  4-PGM-ERROR-X
                   GO TO 61-SHOWFORM-SCREEN-2.

084500     PERFORM 64-BUILD-RLACTIVE  THRU  64-BUILD-RLACTIVE-X.
084600     IF ERR-SW = "Y"
084700         MOVE 2  TO  FIELD-NUMBER
084800         PERFORM 4-PGM-ERROR  THRU  4-PGM-ERROR-X
084900         GO TO 61-SHOWFORM-SCREEN-2.
085000
085100 61-CLOSE-BATCH-FILE.
085200     CLOSE BATCH-FILE-SORTED.
085300
085400 61-PBF-X.
085500     EXIT.
085600
085700 611-FILL-BATCH-INQ-SCREEN.
085800     MOVE SPACES         TO  REL-BATCH-TABLE
                                   REL-BATCH-TABLE-L.
085900     MOVE ZEROS          TO  SUB
                                   RELATIVE-RECNO.
086000     MOVE "N"            TO  EOF-SW,
086100                             F6-VALID-SW,
086200                             F7-VALID-SW.
           MOVE SPACES         TO  SAVE-ORDER-OUT.

086400 611-READ-BATCH-FILE-LOOP.
086500     READ BATCH-FILE-SORTED
086600          AT END
086700              MOVE "Y"  TO  EOF-SW.
086800
           IF EOF-SW = "Y" AND RELATIVE-RECNO = 0
               IF DE-BLKT-NUM = "ALL"
      *            "SHIPPING RELEASE BATCH FILE IS EMPTY"
                   MOVE  19 TO LANG-SETNUM
                   MOVE   6 TO LANG-MSGNUM
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE MESSAGE-BUFFER TO DE1-MESSAGE-LINE
                                          DE2-MESSAGE-LINE
               ELSE
                   MOVE DE-BLKT-NUM   TO  NO-ENTRIES-REQ-NUM
                   MOVE NO-ENTRIES-QUALIFIED-MSG
                                      TO  DE1-MESSAGE-LINE
                                          DE2-MESSAGE-LINE
               END-IF
               MOVE B"1"              TO  IND(99)
               GO TO 611-FBIS-X.

           IF EOF-SW = "Y" AND RELATIVE-RECNO > 0
               MOVE RELATIVE-RECNO TO MAX-RECS
               GO TO 611-FBIS-X.

           IF EOF-SW = "N"
               IF ITEM-SEQ-NO-SORTED = "99"
                   GO TO 611-CONT
               ELSE
               IF ITEM-SEQ-NO-SORTED = "00"
                   PERFORM 6111-LOAD-ITEM-DETAIL
               ELSE
                   MOVE B"1"           TO IND(20)
                   MOVE SPACES         TO ORDER-OUT
                                          ORDER-OUT-L
                   MOVE ITEM-DESC-SORT TO COMMENT-LINE-OUT
                                          COMMENT-LINE-OUT-L.

           ADD 1 TO RELATIVE-RECNO.
           IF SAVE-PCPO-SW = "Y"
               MOVE DE-SUBFILE-L TO DISPLAY-REC
               WRITE SUBFILE DISPLAY-REC FORMAT "RLSFL2"
                 INDICATORS SRF-INDICATORS
               END-WRITE
           ELSE
               MOVE DE-SUBFILE TO DISPLAY-REC
               WRITE SUBFILE DISPLAY-REC FORMAT "RLSFL"
                 INDICATORS SRF-INDICATORS.

           MOVE SPACES TO DE-SUBFILE
                          DE-SUBFILE-L.

       611-CONT.

           GO TO 611-READ-BATCH-FILE-LOOP.

093500 611-FBIS-X.
093600     EXIT.
093700
093800 6111-LOAD-ITEM-DETAIL.
           MOVE SPACE             TO  SEDIVNCK-PARMS.
093900     MOVE REQ-ORDER-SORTED  TO  ORDER-OUT
                                      ORDER-OUT-L
064500                                PO-NUM.
           IF REQ-ORDER-SORTED = SAVE-ORDER-OUT
               MOVE B"1"              TO  IND(20)
               MOVE SPACES            TO  ORDER-OUT
                                          ORDER-OUT-L
           ELSE
               MOVE REQ-ORDER-SORTED  TO  SAVE-ORDER-OUT
               MOVE B"0"              TO  IND(20).

           MOVE BUILD-PO-NUM      TO  SEDIVNCK-PO-NUMBER.
           CALL "SEDIVNCK" USING BASE,
                                 SEDIVNCK-PARMS.
           IF SEDIVNCK-EDI-IND = "Y"
                MOVE "*"          TO  ORDER-OUT-FL
                                      ORDER-OUT-FL-L
           ELSE
           MOVE " "               TO  ORDER-OUT-FL
                                      ORDER-OUT-FL-L.
094000     MOVE ITEM-SORTED       TO  ITEM-OUT
                                      ITEM-OUT-L.
094100     MOVE CODE-SORTED       TO  CODE-OUT
                                      CODE-OUT-L.
094200     MOVE QTY-SORTED        TO  QTY-OUT
                                      QTY-OUT-L.
094300     IF SHIP-DATE-SORTED = SPACES
094400         MOVE SPACES            TO  SHIP-DTE-OUT
                                          SHIP-DTE-OUT-L
094500     ELSE
           IF SAVE-PCPO-SW = "Y"
               MOVE SHIP-DATE-SORTED  TO  SHIP-DTE-OUT-L
           ELSE
094600         MOVE 4                 TO  DATE-MODE
094700         MOVE SHIP-DATE-SORTED  TO  DATE-VALIDATE-IN
094800         CALL "TDATECK2" USING DATE-CHECK-AREA, LANGUAGE-PARMS
094900         MOVE DATE-SLASH-OUT    TO  SHIP-DTE-OUT.
095000     IF EXPECT-DATE-SORTED = SPACES
095100         MOVE SPACES            TO  EXPECT-DTE-OUT
                                          EXPECT-DTE-OUT-L
095200     ELSE
           IF SAVE-PCPO-SW = "Y"
               MOVE EXPECT-DATE-SORTED TO EXPECT-DTE-OUT-L
           ELSE
095300         MOVE 4                 TO  DATE-MODE
095400         MOVE EXPECT-DATE-SORTED  TO  DATE-VALIDATE-IN
095500         CALL "TDATECK2" USING DATE-CHECK-AREA, LANGUAGE-PARMS
095600         MOVE DATE-SLASH-OUT    TO  EXPECT-DTE-OUT.
           IF SAVE-PCPO-SW = "Y"
               MOVE COMPANY-SORTED TO CO-OUT-L
               MOVE PRIME-SORTED   TO PRI-OUT-L.
095700     MOVE SUB-SORTED        TO  SUB-OUT
                                      SUB-OUT-L.
095800     MOVE SUBD-SORTED       TO  SUBD-OUT
                                      SUBD-OUT-L.
095900     MOVE ADDTL-DATA-SORTED TO  ADDTL-DATA-OUT
                                      ADDTL-DATA-OUT-L.
096000     MOVE TAX-MSG-SORTED    TO  TAX-OUT
                                      TAX-OUT-L.
096100     MOVE REQ-NO-SORTED     TO  REQ-OUT
                                      REQ-OUT-L.
096200
       612-CLEAR-SUBFILE.
           MOVE B"1" TO IND (71), IND (72).
           MOVE B"0" TO IND (70).
           WRITE SUBFILE DISPLAY-REC FROM SCREEN-2
               FORMAT SFL-CNTL-NAME
               INDICATORS SRF-INDICATORS.
           MOVE B"0" TO IND (72).
           MOVE ZERO TO RELATIVE-RECNO.

096300
096400 62-CREATE-LAUNCH-JOB-STREAM.
      **************************************************
      **   OVERRIDE FILE 'MCXRLTOP' TO QJOBSRC/MCXRLTOP
      **************************************************
           STRING "OVRDBF FILE(MCXRLTOP) TOFILE(QJOBSRC) ",
             "MBR(MCXRLTOP)" DELIMITED BY SIZE INTO OVRDBF-PARM1.
           CALL "QCMDEXC" USING OVRDBF-PARM1, OVRDBF-PARM2.
      **************************************************
      **   OVERRIDE FILE 'MCXRLBOT' TO QJOBSRC/MCXRLBOT
      **************************************************
           STRING "OVRDBF FILE(MCXRLBOT) TOFILE(QJOBSRC) ",
             "MBR(MCXRLBOT)" DELIMITED BY SIZE INTO OVRDBF-PARM1.
           CALL "QCMDEXC" USING OVRDBF-PARM1, OVRDBF-PARM2.
      ****************************************************
      **   CALL 'CCHKOBJM' TO SEE IF THE FILE
      **   'QTEMP/QJOBSRC' EXISTS IF IT DOESNT CREATE
      **   IT VIA 'CRTSRCPF'.
      ****************************************************
           MOVE "QJOBSRC" TO CHKOBJM-FILE-NAME.
           CALL "CCHKOBJM" USING CHKOBJM-LIB,
                                CHKOBJM-FILE-NAME,
                                CHKOBJM-FILE-MBR,
                                CHKOBJM-OBJ-TYPE,
                                CHKOBJM-RETURN-STATUS.
           IF CHKOBJM-EXISTS
               NEXT SENTENCE
           ELSE
               MOVE "CRTSRCPF FILE(QJOBSRC)" TO OVRDBF-PARM1
               CALL "QCMDEXC" USING OVRDBF-PARM1, OVRDBF-PARM2.
      ****************************************************
      **   CALL 'CCHKOBJM' TO SEE IF THE FILE MEMBER
      **   'MCXRELCRTE' IN 'QTEMP/QJOBSRC' EXISTS
      **   IF IT  DOESNT CREATE IT VIA 'ADDPFM'
      ****************************************************
           MOVE "QJOBSRC" TO CHKOBJM-FILE-NAME.
           MOVE "MCXRELCRTE" TO CHKOBJM-FILE-MBR.
           CALL "CCHKOBJM" USING CHKOBJM-LIB,
                                CHKOBJM-FILE-NAME,
                                CHKOBJM-FILE-MBR,
                                CHKOBJM-OBJ-TYPE,
                                CHKOBJM-RETURN-STATUS.
           IF CHKOBJM-EXISTS
               NEXT SENTENCE
           ELSE
               MOVE "ADDPFM FILE(QJOBSRC) MBR(MCXRELCRTE) " TO
                   OVRDBF-PARM1
               CALL "QCMDEXC" USING OVRDBF-PARM1, OVRDBF-PARM2.
      **************************************************
      **   OVERRIDE FILE 'MCXRELCRTE' TO QJOBSRC/MCXRELCRTE
      **************************************************
           STRING "OVRDBF FILE(MCXRELCRTE) TOFILE(QJOBSRC) ",
           "MBR(MCXRELCRTE)" DELIMITED BY SIZE INTO OVRDBF-PARM1.
           CALL "QCMDEXC" USING OVRDBF-PARM1, OVRDBF-PARM2.

096500     OPEN INPUT RELEASE-CREATE-BEGIN-FILE,
096600                RELEASE-CREATE-END-FILE
096700          OUTPUT RELEASE-CREATE-JOB-FILE.
096800
096900 62-READ-RELEASE-BEGIN-FILE.
097000     READ RELEASE-CREATE-BEGIN-FILE
097100         AT END  GO TO 62-WRITE-SELECTION.
097200     MOVE RELEASE-CREATE-BEGIN-RCD
097300         TO  RELEASE-CREATE-JOB-RCD.
097400     WRITE RELEASE-CREATE-JOB-RCD.
097500     GO TO 62-READ-RELEASE-BEGIN-FILE.
097600
097700 62-WRITE-SELECTION.
097800     MOVE SPACES  TO  RELEASE-CREATE-JOB-RCD.
097900     IF DE-PROCESS-ALL = "X"
098000         MOVE "ALL"  TO  RELEASE-NUM-ENTRY
               MOVE JCW-PS2-310-311 TO RELEASE-PROC-OPT
098100         WRITE RELEASE-CREATE-JOB-RCD
098200     ELSE
098300         PERFORM 621-WRITE-SELECTED-ENTRIES THRU 621-WSE-X.
098400
098500 62-READ-RELEASE-END-FILE.
098600     READ RELEASE-CREATE-END-FILE
098700         AT END  GO TO 62-STREAM-JOB.
098800     MOVE RELEASE-CREATE-END-RCD
098900         TO  RELEASE-CREATE-JOB-RCD.
099000     WRITE RELEASE-CREATE-JOB-RCD.
099100     GO TO 62-READ-RELEASE-END-FILE.
099200
099300 62-STREAM-JOB.
099400     CLOSE RELEASE-CREATE-BEGIN-FILE,
099500           RELEASE-CREATE-END-FILE,
099600           RELEASE-CREATE-JOB-FILE.
      ***********************************************************
      **   STRDBRDR TO LAUNCH JOB STREAM 'MCXRELCRTE' IN QJOBSRC
      ***********************************************************
           MOVE "STRDBRDR FILE(*LIBL/QJOBSRC) MBR(MCXRELCRTE)"
               TO OVRDBF-PARM1.
           CALL "QCMDEXC" USING OVRDBF-PARM1, OVRDBF-PARM2.
100400
100500 62-CLJS-X.
100600     EXIT.
100700
100800 621-WRITE-SELECTED-ENTRIES.

           IF DE-PROCESS-EXCEPT-TABLE NOT = SPACES
               MOVE "EXCLUDE"            TO  RELEASE-NUM-ENTRY
               MOVE JCW-PS2-310-311      TO  RELEASE-PROC-OPT
               WRITE RELEASE-CREATE-JOB-RCD
               MOVE 0  TO  SUB
               GO TO 621-PROCESS-TABLE.

           MOVE "INCLUDE"                TO  RELEASE-NUM-ENTRY.
           MOVE JCW-PS2-310-311          TO  RELEASE-PROC-OPT.
           WRITE RELEASE-CREATE-JOB-RCD.
           IF DE-PROCESS-ONLY-TABLE NOT = SPACES
               MOVE 0  TO  SUB
               GO TO 621-PROCESS-TABLE.

101000*    MOVE "INCLUDE"            TO  RELEASE-NUM-ENTRY.
101100*    ELSE
101200*        MOVE "EXCLUDE"            TO  RELEASE-NUM-ENTRY.
101300*    WRITE RELEASE-CREATE-JOB-RCD.
101400*    MOVE 0  TO  SUB.
101500*
           MOVE 1 TO RELATIVE-RECNO.
101600 621-PROCESS-SELECTION-LOOP.
           PERFORM UNTIL RELATIVE-RECNO > MAX-RECS
             IF SAVE-PCPO-SW = "Y"
                 READ SUBFILE DISPLAY-FILE
                      INTO DE-SUBFILE-L
                      FORMAT IS "RLSFL2"
                 END-READ
                 IF DE-SELECT-L = "X"
                     MOVE SPACES TO RELEASE-CREATE-JOB-RCD
                     MOVE ORDER-OUT-L TO RELEASE-NUM-ENTRY
                     MOVE JCW-PS2-310-311 TO RELEASE-PROC-OPT
                     WRITE RELEASE-CREATE-JOB-RCD
                 END-IF
             ELSE
                 READ SUBFILE DISPLAY-FILE
                      INTO DE-SUBFILE
                      FORMAT IS "RLSFL"
                 END-READ
                 IF DE-SELECT = "X"
                     MOVE SPACES TO RELEASE-CREATE-JOB-RCD
                     MOVE ORDER-OUT TO RELEASE-NUM-ENTRY
                     MOVE JCW-PS2-310-311 TO RELEASE-PROC-OPT
                     WRITE RELEASE-CREATE-JOB-RCD
                 END-IF
             END-IF
             ADD 1 TO RELATIVE-RECNO
           END-PERFORM.
           GO TO 621-WRITE-END-SEL-CARD.

       621-PROCESS-TABLE.
101700     ADD 1  TO  SUB.
101800     IF SUB > 12
101900         GO TO 621-WRITE-END-SEL-CARD.
102000     IF DE-PROCESS-ONLY-TABLE  NOT = SPACES
102100         IF DE-INCLUDE-ORDER (SUB)  NOT = SPACES
102200             MOVE DE-INCLUDE-ORDER (SUB) TO RELEASE-NUM-ENTRY
                   MOVE JCW-PS2-310-311        TO RELEASE-PROC-OPT
102300         ELSE
102400             GO TO 621-PROCESS-TABLE
102500     ELSE
102600         IF DE-EXCLUDE-ORDER (SUB)  NOT = SPACES
102700             MOVE DE-EXCLUDE-ORDER (SUB) TO RELEASE-NUM-ENTRY
                   MOVE JCW-PS2-310-311        TO RELEASE-PROC-OPT
102800         ELSE
102900             GO TO 621-PROCESS-SELECTION-LOOP.
103000
103100     WRITE RELEASE-CREATE-JOB-RCD.
103200     GO TO 621-PROCESS-TABLE.
103300
103400 621-WRITE-END-SEL-CARD.
           MOVE SPACES TO RELEASE-CREATE-JOB-RCD.
103500     MOVE "*******"                TO  RELEASE-NUM-ENTRY.
           MOVE JCW-PS2-310-311          TO  RELEASE-PROC-OPT.
103600     WRITE RELEASE-CREATE-JOB-RCD.
