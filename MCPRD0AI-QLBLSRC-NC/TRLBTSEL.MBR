115100 READ-BATCH-FILE SECTION.
115200
       70-START-DRELFILE.
      *------- DO A START GREATER THAN SPACES TO POSITION TO BEGINNING
      *------- OF THE FILE
      *----------- CHANGE KEY TO DATECYMD INSTEAD OF DLYTCDTE SINCE
      *----------- CENTURY DATABASE CHANGES.
           MOVE SPACES TO DATECYMD OF DSHIPREL-REC-I.
           START DSHIPREL-I KEY > DATECYMD OF DSHIPREL-REC-I
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
                   NEXT SENTENCE
               ELSE
                   MOVE "START DSHIPREL * 70-SD" TO BU-DISPLAY-MSG
                   GO TO 2-BLOWUP.

115300 70-READ-DRELFILE.
           READ DSHIPREL-I NEXT INTO BUF-DSHIPREL
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
115800             GO TO 70-RD-X
115900         ELSE
116000             MOVE "GET DSHIPREL 70-RD" TO BU-DISPLAY-MSG
116100             GO TO 2-BLOWUP.
116200
116300     IF DE-BLKT-NUM = "ALL"
116400         NEXT SENTENCE
116500     ELSE
116600     IF DE-BLKT-NUM = DREL-NUMBER
116700         NEXT SENTENCE
116800     ELSE
116900         GO TO 70-READ-DRELFILE.
117000
           IF JCW-PS2-310-311 = "2 "
               IF DREL-HOLD = " "
                   NEXT SENTENCE
               ELSE
               GO TO 70-READ-DRELFILE
           ELSE
           IF JCW-PS2-310-311 = "2X"
               IF DREL-HOLD = "H"
                   NEXT SENTENCE
               ELSE
               GO TO 70-READ-DRELFILE.

117100     MOVE DREL-NUMBER             TO  SORT-REQ-ORDER.
