020000 61-UPDATE-QTY-PAID.
           MOVE 0 TO COND-WORD.
           MOVE REGISTER-ARG TO REGISTERNO OF DINVITM-O-REC.
           START DINVITM-O KEY = REGISTERNO OF DINVITM-O-REC
               INVALID KEY MOVE 17 TO COND-WORD.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
                   MOVE 17 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.
020100*    CALL "DBFIND" USING  BASE,
020200*                         DSET-DINVITM,
020300*                         MODE1,
020400*                         STATUS-AREA,
020500*                         REG-KEY-NAME,
020600*                         REGISTER-ARG.
020700     IF COND-WORD NOT = ZERO
020800         MOVE "DBFIND DINVITM*61-UQP"  TO  BU-DISPLAY-MSG
020900         GO TO  2-BLOWUP.
021000
           MOVE 0 TO COND-WORD.
           MOVE PO-ARG TO PORCVNO OF DPOITEM-O-REC.
           START DPOITEM-O KEY = PORCVNO OF DPOITEM-O-REC
               INVALID KEY MOVE 17 TO COND-WORD.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
                   MOVE 17 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.
021100*    CALL "DBFIND" USING  BASE,
021200*                         DSET-DPOITEM,
021300*                         MODE1,
021400*                         STATUS-AREA,
021500*                         PO-KEY-NAME,
021600*                         PO-ARG.
021700     IF COND-WORD NOT = ZERO
021800         MOVE "DBFIND DPOITEM*61-UQP"  TO  BU-DISPLAY-MSG
021900         MOVE PO-ARG  TO  BU-DISPLAY-FLD (2)
022000         GO TO  2-BLOWUP.
022100
022200 61-DINVITM-LOOP.
           MOVE 0 TO COND-WORD.
           READ DINVITM-O NEXT INTO BUF-DINVITM
               AT END MOVE 15 TO COND-WORD.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   MOVE 15 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.
           IF REGISTERNO OF DINVITM-O-REC NOT = REGISTER-ARG
               MOVE 15 TO COND-WORD.
022300*    CALL "DBGET" USING  BASE,
022400*                        DSET-DINVITM,
022500*                        MODE5,
022600*                        STATUS-AREA,
022700*                        ALL-ITEMS,
022800*                        BUF-DINVITM,
022900*                        REGISTER-ARG.
023000     IF COND-WORD NOT = ZERO
023100         IF COND-WORD = 15
023200             GO TO  61-UPDATE-QTY-PAID-X
023300         ELSE
023400             MOVE "DBGET5 DINVITM*61-DL"  TO  BU-DISPLAY-MSG
023500             GO TO  2-BLOWUP.
023600
023700     IF INVITM-HOLD-INDIC = "X" OR
023800        INVITM-MEMO-INDIC = "X"
023900         GO TO 61-DINVITM-LOOP.
024000
024100     IF INVITM-PO-UPRICE < ZEROS
024200         MULTIPLY -1 BY INVITM-PO-QTY-PD.
024300     IF INVITM-INV-UPRICE < ZEROS
024400         MULTIPLY -1 BY INVITM-INV-QTY-PD.
024500
024600     IF INVITM-CORPCODE = "NON-STR"
024700         GO TO  61-DPOITEM-LOOP.
024800
024900     MOVE INVITM-CORPCODE  TO  CODE-ARG.
           MOVE 0 TO COND-WORD.
           MOVE CODE-ARG TO CORPCDE OF MSTORERM-I-REC.
           READ MSTORERM-I INTO BUF-MSTORERM
               INVALID KEY MOVE 17 TO COND-WORD.
           IF FILE-STATUS-1 = "2"
               MOVE 17 TO COND-WORD
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD.
025000*    CALL "DBGET" USING  BASE,
025100*                        DSET-MSTORERM,
025200*                        MODE7,
025300*                        STATUS-AREA,
025400*                        ALL-ITEMS,
025500*                        BUF-MSTORERM,
025600*                        CODE-ARG.
025700     IF COND-WORD NOT = ZERO
025800         MOVE "DBGET7 MSTORERM*61-DL"  TO  BU-DISPLAY-MSG
025900         MOVE CODE-ARG  TO  BU-DISPLAY-FLD (2)
026000         GO TO  2-BLOWUP.
026100
026200 61-DPOITEM-LOOP.
           MOVE 0 TO COND-WORD.
           READ DPOITEM-O NEXT INTO BUF-DPOITEM
               AT END MOVE 15 TO COND-WORD.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   MOVE 15 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.
           IF PORCVNO OF DPOITEM-O-REC NOT = PO-ARG
               MOVE 15 TO COND-WORD.
026300*    CALL "DBGET" USING  BASE,
026400*                        DSET-DPOITEM,
026500*                        MODE5,
026600*                        STATUS-AREA,
026700*                        ALL-ITEMS,
026800*                        BUF-DPOITEM,
026900*                        PO-ARG.
027000     IF COND-WORD NOT = ZERO
027100         MOVE "DBGET5 DPOITEM*61-UD"  TO  BU-DISPLAY-MSG
027200         MOVE PO-ARG  TO  BU-DISPLAY-FLD (2)
027300         GO TO  2-BLOWUP.
027400
027500     IF INVITM-ITEM-NO = ITM-NUMBER
027600         NEXT SENTENCE
027700     ELSE
027800     IF INVITM-ITEM-NO < ITM-NUMBER
027900         MOVE "ITEM LOGIC FAILED *61-DPOITEM-LOOP"
028000             TO BU-DISPLAY-MSG
028100         MOVE PO-ARG  TO  BU-DISPLAY-FLD (2)
028200         GO TO 2-BLOWUP
028300     ELSE
028400         GO TO  61-DPOITEM-LOOP.
028500
029900     MOVE ITM-PRICE-UM      TO  V-OLD-UM.
030000     MOVE ITM-UM            TO  V-NEW-UM.
030100
030200     IF INV-PAYMENT-IND = "P"
030300         MOVE INVITM-PO-QTY-PD   TO  V-OLD-QTY
030400     ELSE
030500     IF INV-PAYMENT-IND = "I"
030600         MOVE INVITM-INV-QTY-PD  TO  V-OLD-QTY
030700     ELSE
030800         MOVE "NO PAYMENT-IND * 61-DL" TO BU-DISPLAY-MSG
030900         MOVE PO-ARG                   TO BU-DISPLAY-FLD (2)
031000         GO TO 2-BLOWUP.
031100     PERFORM 611-CALC-NEW-QTY  THRU  611-CALC-NEW-QTY-X.
031200     SUBTRACT C-NEW-QTY        FROM  ITM-QTY-PAID.
031300
           MOVE 0 TO COND-WORD.
           REWRITE DPOITEM-O-REC FROM BUF-DPOITEM
               INVALID KEY MOVE 99 TO COND-WORD.
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD.
031400*    CALL "DBUPDATE" USING  BASE,
031500*                           DSET-DPOITEM,
031600*                           MODE1,
031700*                           STATUS-AREA,
031800*                           ALL-ITEMS,
031900
032000     IF COND-WORD NOT = ZERO
032100         MOVE "DBUPDATE DPOITEM*61-UD"  TO  BU-DISPLAY-MSG
032200         MOVE PO-ARG  TO  BU-DISPLAY-FLD (2)
032300         GO TO  2-BLOWUP.
032400
033400     GO TO  61-DINVITM-LOOP.
033500
033600 61-UPDATE-QTY-PAID-X.
033700     EXIT.
033800
033900
034000 611-CALC-NEW-QTY.
034100     IF INVITM-CORPCODE = "NON-STR"
034200         MOVE V-OLD-QTY           TO  C-NEW-QTY
034300         GO TO 611-CALC-NEW-QTY-X.
034400
034500     IF V-NEW-UM = V-OLD-UM
034600         MOVE V-OLD-QTY  TO  C-NEW-QTY
034700     ELSE
034800     IF V-OLD-UM = STR-UM
034900         IF V-NEW-UM = STR-UM1
035000             DIVIDE V-OLD-QTY BY STR-UM1-CF
035100                               GIVING  C-NEW-QTY ROUNDED
035200         ELSE
035300             DIVIDE V-OLD-QTY BY STR-UM2-CF
035400                                GIVING  C-NEW-QTY ROUNDED
035500     ELSE
035600     IF V-NEW-UM = STR-UM
035700         IF V-OLD-UM = STR-UM1
035800             MULTIPLY V-OLD-QTY BY STR-UM1-CF
035900                                 GIVING  C-NEW-QTY ROUNDED
036000         ELSE
036100             MULTIPLY V-OLD-QTY BY STR-UM2-CF
036200                                 GIVING  C-NEW-QTY ROUNDED
036300     ELSE
036400     IF V-NEW-UM = STR-UM1
036500         DIVIDE STR-UM2-CF BY STR-UM1-CF
036600                           GIVING  C-ALT-CF ROUNDED
036700         MULTIPLY V-OLD-QTY BY C-ALT-CF
036800                             GIVING  C-NEW-QTY ROUNDED
036900     ELSE
037000         DIVIDE STR-UM1-CF BY STR-UM2-CF
037100                           GIVING  C-ALT-CF ROUNDED
037200         MULTIPLY V-OLD-QTY BY C-ALT-CF
037300                             GIVING  C-NEW-QTY ROUNDED.
037400
037500 611-CALC-NEW-QTY-X.
037600     EXIT.
037700
037800
037900 62-BACKOUT-FREIGHT.
           MOVE 0 TO COND-WORD.
           MOVE REGISTER-ARG TO REGISTERNO OF DPOFREIGHT-O-REC.
           START DPOFREIGHT-O KEY = REGISTERNO OF DPOFREIGHT-O-REC
               INVALID KEY MOVE 17 TO COND-WORD.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
                   MOVE 17 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.
039000     IF COND-WORD NOT = ZERO
039100         IF COND-WORD = 17
039200             GO TO  62-BACKOUT-FREIGHT-X
039300         ELSE
039400             MOVE "DBFIND DPOFREIGHT*62-FD"  TO  BU-DISPLAY-MSG
039500             GO TO  2-BLOWUP.
039600
