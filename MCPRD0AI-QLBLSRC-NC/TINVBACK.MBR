           MOVE 0 TO COND-WORD.
           READ DPOFREIGHT-O NEXT INTO BUF-DPOFREIGHT
               AT END MOVE 15 TO COND-WORD.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   MOVE 15 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.
           IF REGISTERNO OF DPOFREIGHT-O-REC NOT = REGISTER-ARG
               MOVE 15 TO COND-WORD.
040500     IF COND-WORD NOT = ZERO
040600         IF COND-WORD = 15
040700             GO TO  62-BACKOUT-FREIGHT-X
               ELSE
                   MOVE "DBGET5 DPOFREIGHT*62-DL" TO BU-DISPLAY-MSG
                   GO TO 2-BLOWUP.
041100
           MOVE 0 TO COND-WORD
046400     IF FRT-PO-RCV-NO = PO-ARG
               DELETE DPOFREIGHT-O INVALID KEY
                   MOVE "2" TO FILE-STATUS-1
           ELSE
               MOVE SPACES TO FRT-REG-NO, FRT-PAID-FLAG
               REWRITE DPOFREIGHT-O-REC FROM BUF-DPOFREIGHT
                   INVALID KEY MOVE 99 TO COND-WORD.
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD.
047400     IF COND-WORD NOT = ZERO
047500         MOVE "DEL/UP DPOFREIGHT*62-BF"  TO  BU-DISPLAY-MSG
047600         GO TO  2-BLOWUP.
047700
047800     GO TO 62-DPOFREIGHT-LOOP.
