111900     PERFORM 611-RETRIEVE-NEXT-ITEM THRU 611-RNI-EXIT.
           IF ERR-SW = 1
               PERFORM 617-REQI-3-ERROR
               MOVE SPACES TO P-ITEM-INPUT P-REQ-INPUT
115900         MOVE 6 TO VIEW-LASTKEY
116000         MOVE ITM-CTR TO ITEM-RESET
116100         MOVE 0 TO CHAIN-CTR
           ELSE
112000     IF PRT-STATUS-1 NOT = "M"
112100         PERFORM 614-REQNO-ERROR
               MOVE SPACES TO P-ITEM-INPUT P-REQ-INPUT
115900         MOVE 6 TO VIEW-LASTKEY
116000         MOVE ITM-CTR TO ITEM-RESET
116100         MOVE 0 TO CHAIN-CTR
112300     ELSE
112400     IF PRT-REQ-NO = "      "
112500         PERFORM 614-REQNO-ERROR
               MOVE SPACES TO P-ITEM-INPUT P-REQ-INPUT
115900         MOVE 6 TO VIEW-LASTKEY
116000         MOVE ITM-CTR TO ITEM-RESET
116100         MOVE 0 TO CHAIN-CTR
112700     ELSE
112800     MOVE SPACES TO REQI-DATA
112900     DIVIDE CHAIN-CTR BY 3 GIVING ITM-CTR
113000     MULTIPLY 3 BY ITM-CTR
113100     PERFORM 612-SELECT-REQ-SEARCH-ITEM
113200     MOVE ZEROES TO REQI-RET-CODE
113300     MOVE 0 TO PASS-SPOOL-PRT-NO
113400     MOVE PLANT-IDENT TO MPLTINFO-COMP
           PERFORM 61-CALL-SMREQINQ
           MOVE SPACES TO P-ITEM-INPUT P-REQ-INPUT
115900     MOVE 6 TO VIEW-LASTKEY
116000     MOVE ITM-CTR TO ITEM-RESET
116100     MOVE 0 TO CHAIN-CTR
116200     IF REQI-RET-CODE = 1
116300         PERFORM 615-REQI-1-ERROR
116400         GO TO 61-LIST-ITEMS
116500     ELSE
116600     IF REQI-RET-CODE = 2
116700         PERFORM 616-REQI-2-ERROR
116800         GO TO 61-LIST-ITEMS
116900     ELSE
117000     IF REQI-RET-CODE = 3
