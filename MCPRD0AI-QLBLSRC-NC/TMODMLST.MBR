           PERFORM 98-SCREEN-READ.
           MOVE SPACES TO ERROR-BUFFER EDIT-ERROR
           MOVE DSPLY-REC TO PRT-LINE-DATA.
       61-PS-EXIT.    EXIT.

119700 611-RETRIEVE-NEXT-ITEM.
           MOVE 0 TO ERR-SW.
119800     MOVE 0 TO COND-WORD.
119900     MOVE WORK-ORDER-NO TO WONUM OF WPFDREC.
           START WO-PARTS-FILE KEY IS > EXTERNALLY-DESCRIBED-KEY
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF WPFD-STATUS NOT = "00"
               IF WPFD-STATUS = "23"
                   NEXT SENTENCE
               ELSE
               MOVE 17 TO COND-WORD.
120000     IF COND-WORD = 17
120200         MOVE 47004 TO CATREAD-MSG-NUMBER
120400         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE ERROR-BUFFER TO EDIT-ERROR
               MOVE TRUE-VAL TO INDS (99)
120800         MOVE 1 TO ERR-SW
120900         GO TO 611-RNI-EXIT.
121000 611-RNI-LOOP.
           MOVE 0 TO COND-WORD.
121100     READ WO-PARTS-FILE PRIOR INTO WO-PARTS-DATA
121200         AT END    MOVE 14 TO COND-WORD.
           IF WPFD-STATUS NOT = "00" MOVE 14 TO COND-WORD.
           IF WORK-ORDER-NO NOT = WONUM OF WPFDREC
               MOVE 14 TO COND-WORD.
121300     IF COND-WORD = 14
121400         MOVE 1 TO ERR-SW
121500         GO TO 611-RNI-EXIT.
           IF ITEM-BUFF-9 > 0
               IF PRT-DELETE-FLAG = "D"
                   GO TO 611-RNI-LOOP.
122300     ADD 1 TO CHAIN-CTR.
122400     IF CHAIN-CTR = ITEM-BUFF-9 GO TO 611-RNI-EXIT.
122500     IF ITEM-BUFF-9 = 9999
122600         IF PRT-REQ-NO = REQ-BUFF
122700             MOVE CHAIN-CTR TO ITEM-BUFF-9
122800             GO TO 611-RNI-EXIT.
122900     GO TO 611-RNI-LOOP.
123000 611-RNI-EXIT.    EXIT.
