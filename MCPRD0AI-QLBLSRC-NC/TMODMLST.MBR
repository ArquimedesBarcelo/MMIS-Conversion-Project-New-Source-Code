020400 01  REQI-RET-CODE                     PIC S9(4) COMP-4.
       01  SAVE-VIEW-COMAREA                PIC X(120).
020900 COPY DBSTAT  IN COPYLIB.
021300 COPY TBLOWUP IN COPYLIB.
       01  TRUE-VAL                          PIC 1 VALUE B"1".
021400 01  WO-BASIC-DATA.      COPY DWOBASIC OF COPYLIB.
021500 01  WO-PLANNED-DATA.    COPY DWOPLAN OF COPYLIB.
021600 01  WO-PARTS-DATA.      COPY DWOPARTS OF COPYLIB.
       COPY WSCONTROL IN COPYLIB.
021700 LINKAGE SECTION.
022400 01  DBPARAMETERS.       COPY DBPARMS OF COPYLIB.
022700 01  WORK-ORDER-NO                     PIC X(10).
022500 COPY VCOMLINK OF COPYLIB.
023500 PROCEDURE DIVISION USING DBPARAMETERS WORK-ORDER-NO
023600                      VIEW-COMAREA.
023800 START-EXECUTING.
023900     PERFORM 1-HSK.
024000     PERFORM 6-MAIN THRU 6-MAIN-EXIT.
024100 2-EOJ.
           CLOSE DISPLAY-FILE.
           CLOSE WO-BASIC-FILE.
           CLOSE WO-LAST-NUM-USED.
           CLOSE WO-PARTS-FILE.
           CLOSE WO-PLANNED-FILE.
024200     GOBACK.
024300 1-HSK.
           OPEN I-O   DISPLAY-FILE.
           OPEN INPUT WO-BASIC-FILE.
           OPEN INPUT WO-LAST-NUM-USED.
           OPEN INPUT WO-PARTS-FILE.
           OPEN INPUT WO-PLANNED-FILE.
024400     CALL "TPWORD" USING PASSWORD-INFORMATION.
024800     IF PASSWORD-FLAG = "N"
024900         MOVE "  PWORD" TO BLOWUP-BASE
025000         MOVE "FAILED PASSWORD CHECK - TMODMLST"
025100             TO BU-DISPLAY-MSG
025200         PERFORM 998-BLOWUP.
025300     MOVE SPACES TO WO-BASIC-DATA.
025400     MOVE SPACES TO WO-PLANNED-DATA.
025500     MOVE SPACES TO WO-PARTS-DATA.
           MOVE SPACES TO BASE-BG BASE-MMISA BASE-STORES.
025700     MOVE 1 TO ARG-NO
           READ WO-LAST-NUM-USED INTO LAST-WO-BUFF
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF WLNU-STATUS NOT = "00" MOVE 17 TO COND-WORD.
           IF COND-WORD = 17 MOVE 1 TO DATE-FLAG-SW.
           MOVE DATE-FLAG-SW TO DATE-FLAG.
026000     MOVE 1 TO DATE-MODE.
026100     MOVE DATE-FLAG TO DATE-CODE.
026200     CALL "TDATECHK" USING DATE-CHECK-AREA.
026300     MOVE DATE-SLASH-OUT TO CUR-DATE-WA.
026400     IF DATE-FLAG = 3
026500         MOVE CUR-DATE-MD TO CUR-DATE-CHECK-DM
026600         MOVE CUR-DATE-DM TO CUR-DATE-CHECK-MD
026700     ELSE
026800     MOVE CUR-DATE-MD TO CUR-DATE-CHECK-MD
026900     MOVE CUR-DATE-DM TO CUR-DATE-CHECK-DM.
027000     MOVE CUR-DATE-YY TO CUR-DATE-CHECK-YY.
           IF CUR-DATE-CHECK-YY > "70"
               MOVE "19" TO CUR-DATE-CHECK-CC
           ELSE
           MOVE "20" TO CUR-DATE-CHECK-CC.
027100     CALL "TESCSEQ" USING ESC-NAME.
027200 6-MAIN.
027300     PERFORM 60-GET-WO-DATA THRU 60-GWD-EXIT.
027400     MOVE SPACES TO MATL-WORKAREA.
027500     IF WO-NUM = SPACES
027600         MOVE WO-NUM-PLANNED TO WO-NUM-WA
027700         MOVE DESCRIPTION-1-P TO DESCRIPTION-WA
027800         MOVE APPROVAL-CODE-P TO A-C-WA
027900         MOVE WO-STATUS-P TO WO-STATUS-WA
028000         MOVE EQUIP-NUM-P TO EQPNUM-WA
028100         MOVE ZONE-P TO ZONE-WA
028200         MOVE DEPT-P TO SAVE-DEPT
028300         MOVE EXP-CLASS-P TO ADDL-DATA-WA SAVE-EXPCLASS
028400         MOVE ENG-PL-SCHD-ID TO ORIG-WA
028500         IF DATE-SCHD = "      "
028600             NEXT SENTENCE
028700         ELSE
028800         MOVE 4 TO DATE-MODE
028900         MOVE DATE-SCHD TO DATE-VALIDATE-IN
029000         CALL "TDATECHK" USING DATE-CHECK-AREA
029100         MOVE DATE-SLASH-OUT TO DATE-SCHD-WA
029200         MOVE TIME-SCHD-P-HH TO TIME-SCHD-HH-WA
029300         MOVE ":" TO TIME-COLON-WA
029400         MOVE TIME-SCHD-P-MM TO TIME-SCHD-MM-WA
029500     ELSE
029600     MOVE WO-NUM TO WO-NUM-WA
029700     MOVE APPROVAL-CODE TO A-C-WA
029800     MOVE DESCRIPTION-1 TO DESCRIPTION-WA
029900     MOVE WO-STATUS TO WO-STATUS-WA
030000     MOVE EQUIP-NUM TO EQPNUM-WA
030100     MOVE DEPT TO SAVE-DEPT
030200     MOVE EXP-CLASS TO ADDL-DATA-WA SAVE-EXPCLASS
030300     MOVE ENG-PL-SCHD-ID TO ORIG-WA
030400     MOVE ZONE OF WO-BASIC-DATA TO ZONE-WA.
030500     MOVE 0 TO SUB ITM-CTR ITEM-RESET.
030600     PERFORM 61-LIST-ITEMS THRU 61-LI-EXIT.
030700 6-MAIN-EXIT.    EXIT.
030800
030900 60-GET-WO-DATA.
031000     MOVE 0 TO COND-WORD.
031100     MOVE WORK-ORDER-NO TO WONUM OF WBFREC.
031200     START WO-BASIC-FILE KEY IS = EXTERNALLY-DESCRIBED-KEY
031300         INVALID KEY    MOVE 17 TO COND-WORD.
031400     IF WBF-STATUS NOT = "00" MOVE 17 TO COND-WORD.
           IF COND-WORD = 17 GO TO 60-CHECK-WO-PLANNED.
031500     READ WO-BASIC-FILE NEXT INTO WO-BASIC-DATA
031600         AT END     MOVE 15 TO COND-WORD.
           IF WBF-STATUS NOT = "00" MOVE 15 TO COND-WORD.
031700     IF COND-WORD = 15 GO TO 60-CHECK-WO-PLANNED.
031800     GO TO 60-GWD-EXIT.
031900 60-CHECK-WO-PLANNED.
032100     MOVE 0 TO COND-WORD.
           MOVE WORK-ORDER-NO TO WONUM OF WPFREC.
032200     START WO-PLANNED-FILE KEY IS = EXTERNALLY-DESCRIBED-KEY
032300         INVALID KEY    MOVE 17 TO COND-WORD.
           IF WPF-STATUS NOT = "00" MOVE 17 TO COND-WORD.
032400     IF COND-WORD = 17 GO TO 60-GWD-EXIT.
032500     READ WO-PLANNED-FILE NEXT INTO WO-PLANNED-DATA
032600         AT END    MOVE 15 TO COND-WORD.
           IF WPF-STATUS NOT = "00" MOVE 15 TO COND-WORD.
032700 60-GWD-EXIT.    EXIT.
032800
032900 61-LIST-ITEMS.
033000     MOVE 0 TO SUB ITM-CTR.
033100     MOVE SPACES TO PRT-LINE-DATA.
033200     MOVE 0 TO COND-WORD.
033300     MOVE WORK-ORDER-NO TO WONUM OF WPFDREC.
033500     START WO-PARTS-FILE KEY IS > EXTERNALLY-DESCRIBED-KEY
033600         INVALID KEY    MOVE 17 TO COND-WORD.
           IF WPFD-STATUS NOT = "00"
               IF WPFD-STATUS = "23"
                   NEXT SENTENCE
               ELSE
               MOVE 17 TO COND-WORD.
033700     IF COND-WORD = 17
               MOVE 66080 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
033900         MOVE WORK-ORDER-NO TO NO-PARTS-WO
               MOVE 0 TO VIEW-LASTKEY
               MOVE ERROR-BUFFER TO DBPARM-PAD
034400         GO TO 61-LI-EXIT.
034500 61-LI-LOOP.
           MOVE 0 TO COND-WORD.
034600     READ WO-PARTS-FILE PRIOR INTO WO-PARTS-DATA
034700         AT END    MOVE 14 TO COND-WORD.
           IF WPFD-STATUS NOT = "00" MOVE 14 TO COND-WORD.
           IF WORK-ORDER-NO NOT = WONUM OF WPFDREC
               MOVE 14 TO COND-WORD.
033700     IF COND-WORD = 14
               IF ITM-CTR = 0
                   IF SUB = 0
                       MOVE 66080 TO CATREAD-MSG-NUMBER
                       PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
033900                 MOVE WORK-ORDER-NO TO NO-PARTS-WO
                       MOVE 0 TO VIEW-LASTKEY
                       MOVE ERROR-BUFFER TO DBPARM-PAD
034400                 GO TO 61-LI-EXIT.
034800     IF COND-WORD = 0 GO TO 61-LI-LOOP-PRT.
034900     IF ITM-CTR > 0 GO TO 61-LI-LOOP-CONT.
035000     IF SUB = 0
               IF VIEW-LASTKEY = 6 OR 7
                   GO TO 61-LI-EXIT
               ELSE
               MOVE 66080 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE WORK-ORDER-NO TO NO-PARTS-WO
               MOVE ERROR-BUFFER TO PLD-2 (2)
               MOVE 66085 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE ERROR-BUFFER TO P-CMD-LINE
               PERFORM 61-PROCESS-SCREEN THRU 61-PS-EXIT
               IF VIEW-LASTKEY = 1 OR 3
                   GO TO 2-EOJ
               ELSE
035900         GO TO 61-LI-EXIT.
036600     MOVE 31062 TO CATREAD-MSG-NUMBER.
036800     PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
           MOVE ERROR-BUFFER TO PLD-2 (3).
           MOVE 66094 TO CATREAD-MSG-NUMBER.
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
           MOVE ERROR-BUFFER TO P-CMD-LINE.
           PERFORM 61-PROCESS-SCREEN THRU 61-PS-EXIT.
042600     IF VIEW-LASTKEY = 1 OR 3
043400         GO TO 2-EOJ.
           IF VIEW-LASTKEY = 6
               MOVE 35126 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE ERROR-BUFFER TO EDIT-ERROR
               MOVE TRUE-VAL TO INDS (99)
               PERFORM 61-PROCESS-SCREEN THRU 61-PS-EXIT
               GO TO 61-LI-LOOP.
043900     IF P-ITEM-INPUT = SPACES
044000         IF P-REQ-INPUT = SPACES
044500             MOVE 0 TO ITEM-RESET
044700             GO TO 61-LI-EXIT
044800         ELSE
044900         MOVE 0 TO ITM-CTR CHAIN-CTR
045000         MOVE 9999 TO ITEM-BUFF-9
