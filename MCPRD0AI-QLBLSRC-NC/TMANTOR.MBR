       IDENTIFICATION DIVISION.
       PROGRAM-ID.     TMANTOR.
       AUTHOR.         ANNETTE TREUDLER/FRED HAYNES.
      *D* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *
      *D*                                                           *
      *D* T M A N T O R                                             *
      *D*   FILE DEFINITIONS (INPUTS/OUTPUTS)                       *
      *D*      1) MANWKFL1 - FILE THAT CONTAINS A LIST OF ALL       *
      *D*                   REGISTER NUMBERS CONTAINED IN THE       *
      *D*                   MOST RECENT MANIFEST FILE RUN           *
      *D*      2) MANAKFL1 - THE AKRON MANIFEST FILE. THIS FILE     *
      *D*                   MUST BE SENT TO AKRON ACCOUNTS PAYABLE  *
      *D*                   ON THE IBM BEFORE ANOTHER MANIFEST      *
      *D*                   FILE CAN BE CREATED                     *
      *D*      3) MANRPTFL - REPORT FILE WHICH CONTAINS A ONE PAGE  *
      *D*                    SUMMARY OF WHICH OPTION WAS CHOSEN     *
      *D*                    TO CREATE THE AKRON MANIFEST FILE      *
      *D*                                                           *
      *D* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *
      *C* CHANGES
      *C*
      *C* AUG 25, 1992  CR KALMAN   REQUEST:6234
      *C* ADDED CHANGE FOR VALLEYFIELD (629) ONLY. THEY NEEDED TO
      *C* KEEP TRACK OF DOLLARS PAID FOR A NEW TAX (QST/TVQ) BY
      *C* INVOICE. PREVIOUSLY THEY HAD ONLY GST. SINCE TOTAL TAX
      *C* PAID IS STORED (INV-ADD-TAX) AND GST PAID IS STORED
      *C* (INV-ADD-GST) SUBTRACTION WOULD GIVE THE TOTAL QST/TVQ
      *C* PAID. WILL NOW SEND QST/TVQ IN A SEPARATE RECORD USING
      *C* THE SAME FORMAT AS THE GST RECORD.
      *C*
      *C* CR KALMAN        4/26/94            REQUEST 6490
      *C* REMOVED PORTABLILITY COPYLIBS.
      *C*
      *C* CR KALMAN        6/3/94             REQUEST 6511
      *C* REPLACED OPENING, WRITING, CLOSING AND DELETING OF A FILE
      *C* FOR EACH REGISTER IN THE MANIFEST WITH A TABLE TO DO
      *C* THE PROCESSING.
      *C*
      *C  JUNE 23, 1994   CR KALMAN
      *C   ADDED CALL TO COBOL ERROR HANDLER -MCXCBLERR.
      *C*
      *C* CA YODER         7/15/96
      *C*  RE-COMPILED TO PICK UP CENTURY DATABASE CHANGES.
      *C*
      *C* CA YODER        10/17/97
      *C*  INCREASED SIZE OF DIST-TABLE AFTER NAPANEE HAD > 100
      *C*  ITEMS ON AN INVOICE.  INCREASED IT FROM 100 TO 150.
      *C*
      *C* 03FEB1998   CA YODER
      *C* INCREASED SIZE OF DIST-TABLE TO 1000 SINCE RECEIVING NOW
      *C* HANDLES UP TO 999 ITEMS PER RECEIVING SLIP.
      *C*
      *C* 06/02/99   CA YODER   (DECATUR REQUEST)
      *C*   EXPANDED TAX RATE PERCENTAGE FROM 2 DECIMAL
      *C*   PLACES TO 4.

       DATE-WRITTEN.   DECEMBER 1988.
       DATE-COMPILED.
       ENVIRONMENT DIVISION.
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT MANIFEST-REPORT    ASSIGN TO DATABASE-MANRPTFL.
           SELECT SORT-ITEMS         ASSIGN TO DISK-SORT.
           SELECT REG-FILE           ASSIGN TO DATABASE-MANWKFL1.
           SELECT MAN-AKRON-FILE     ASSIGN TO DATABASE-MANAKFL1.
           SELECT TAXGST-FILE        ASSIGN TO DISK-TAXGST
                                     FILE STATUS IS FILE-STATUS.
           SELECT MPLTINFO-PK-O
               ASSIGN TO DATABASE-MCFLCS0501
               ORGANIZATION IS INDEXED
                 ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
               FILE STATUS IS FILE-STATUS.
           SELECT MVALIDUM-UM-I
               ASSIGN TO DATABASE-MCFLCS0401
               ORGANIZATION IS INDEXED
                 ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
               FILE STATUS IS FILE-STATUS.
           SELECT DINVITM-RG-I
               ASSIGN TO DATABASE-MCFLCS2601
               ORGANIZATION IS INDEXED
                 ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                 WITH DUPLICATES
               FILE STATUS IS FILE-STATUS.
           SELECT MSTORERM-CD-I
               ASSIGN TO DATABASE-MCFLCS0201
               ORGANIZATION IS INDEXED
                 ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
               FILE STATUS IS FILE-STATUS.
           SELECT MTAX-TX-I
               ASSIGN TO DATABASE-MCFLCS3701
               ORGANIZATION IS INDEXED
                 ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
               FILE STATUS IS FILE-STATUS.
           SELECT DINVACCT-RG-I
               ASSIGN TO DATABASE-MCFLCS2701
               ORGANIZATION IS INDEXED
                 ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                 WITH DUPLICATES
               FILE STATUS IS FILE-STATUS.
           SELECT DINVRCD-IV-I
               ASSIGN TO DATABASE-MCFLCS2504
               ORGANIZATION IS INDEXED
                 ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                 WITH DUPLICATES
               FILE STATUS IS FILE-STATUS.
           SELECT DINVRCD-RG-I
               ASSIGN TO DATABASE-MCFLCS2501
               ORGANIZATION IS INDEXED
                 ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                 WITH DUPLICATES
               FILE STATUS IS FILE-STATUS.
           SELECT DPORECD-PO-I
               ASSIGN TO DATABASE-MCFLCS0901
               ORGANIZATION IS INDEXED
                 ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                 WITH DUPLICATES
               FILE STATUS IS FILE-STATUS.
           SELECT DVENDOR-VN-I
               ASSIGN TO DATABASE-MCFLCS0701
               ORGANIZATION IS INDEXED
                 ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                 WITH DUPLICATES
               FILE STATUS IS FILE-STATUS.


