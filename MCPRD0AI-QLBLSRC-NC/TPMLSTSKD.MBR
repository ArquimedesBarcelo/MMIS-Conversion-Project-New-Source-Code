       IDENTIFICATION DIVISION.
       PROGRAM-ID.             TPMLSTSKD.
       AUTHOR.                 W. ROXBURY.
       INSTALLATION.           GOODYEAR TIRE & RUBBER CO.
      *REMARKS.                PREVENTIVE MAINTENANCE SCHEDULER
      *                        FILE LIST PROGRAM
       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.
       SOURCE-COMPUTER.        IBM-AS400.
       OBJECT-COMPUTER.        IBM-AS400.
       SPECIAL-NAMES.          C01 IS NEW-PAGE
                               I-O-FEEDBACK IS I-O-FEEDBACK-AREA.
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT PM-SCHEDULE
                  ASSIGN       TO DATABASE-MCFLMM4402
                  ORGANIZATION IS INDEXED
                  ACCESS MODE  IS DYNAMIC
                  RECORD KEY   IS EXTERNALLY-DESCRIBED-KEY
                               WITH DUPLICATES
                  FILE STATUS  IS FILE-STAT.

           SELECT PRINT-FILE
                  ASSIGN       TO PRINTER-MCPRT.

       DATA DIVISION.
       FILE SECTION.
       FD  PM-SCHEDULE
           LABEL RECORDS       ARE STANDARD.
       01  PM-SCHED-REC.
           COPY DDS-ALL-FORMATS OF MCFLMM4402.

       FD  PRINT-FILE RECORD   CONTAINS 80 CHARACTERS
           LABEL RECORD        IS OMITTED
           DATA RECORD         IS PRINT-REC.
       01  PRINT-REC           PIC X(80).

       WORKING-STORAGE SECTION.
       77  MCXCBLERR-SCOPE     PIC X       VALUE "C".
       77  D-PARM              PIC X.
       77  L-PARM              PIC X.

       01  FILE-STAT.
           05 FILE-STAT-1      PIC X   VALUE "0".
           05 FILE-STAT-2      PIC X   VALUE "0".

       01  GREG-DATE.
           05  G-YEAR          PIC XXXX.
           05  G-MONTH         PIC XX.
           05  G-DAY           PIC XX.

       01  JUL-SIGN            PIC S9(06).
       01  JUL-DATE            PIC  X(07).
       01  JULIAN-DATE         REDEFINES JUL-DATE
                               PIC  9(07).
       01  FILLER              REDEFINES JUL-DATE.
           05  J-YEAR          PIC 9999.
           05  J-DAY           PIC 999.

       01  CURR-DATE.
           05  CD-MM           PIC 99 VALUE ZEROS.
           05  SL1             PIC X.
           05  CD-DD           PIC 99 VALUE ZEROS.
           05  SL2             PIC X.
           05  CD-CT           PIC 99 VALUE ZEROS.
           05  CD-YY           PIC 99 VALUE ZEROS.

       01  TODAYS-DATE.
           05  TD-YEARMO.
               10  TD-YR.
                   15  TD-CT   PIC 99.
                   15  TD-YY   PIC 99.
               10  TD-MM       PIC 99.
           05  TD-DD           PIC 99.

       01  TOMORROWS-DATE.
           05  TM-YEARMO.
               10  TM-YR.
                   15  TM-CT   PIC 99.
                   15  TM-YY   PIC 99.
               10  TM-MM       PIC 99.
           05  TM-DD           PIC 99.

       01  COMPARE-DATE.
           05  CM-YEARMO.
               10  CM-YEAR     PIC 9999.
               10  CM-YR       REDEFINES CM-YEAR.
                   15  CM-CT   PIC 99.
                   15  CM-YY   PIC 99.
               10  CM-MM       PIC 99.
           05  CM-DD           PIC 99.

       01  DATE-HOLD.
           05  DH-YY           PIC 99 VALUE ZEROS.
           05  DH-MM           PIC 99 VALUE ZEROS.
           05  DH-DD           PIC 99 VALUE ZEROS.

       01  PRINT-DATE.
           05  P1              PIC X(26)
                               VALUE "    **       AS OF DATE:  ".
           05  P2              PIC X(10).
           05  P3              PIC X(08)
                               VALUE "      **".

       01  PRINT-TOM.
           05  PT1             PIC X(26)
                               VALUE "    **   TOMORROW:        ".
           05  PT2             PIC X(10).
           05  PT3             PIC X(08)
                               VALUE "      **".

       01  DB-ERROR.
           05  DB-FUNC         PIC X(10) VALUE SPACES.
           05  DB-FILE         PIC X(18) VALUE SPACES.
           05  FILLER          PIC X(20) VALUE "ERROR - FILE-STAT = ".
           05  CON-WORD        PIC XX.

           COPY OVRPFDATA      IN COPYLIB.

           COPY CCHKOBJ        IN COPYLIB.

       01  PM-SCHED-DATA.
           COPY DPMSCHED       IN COPYLIB.

       PROCEDURE DIVISION.
       BEGIN.
           MOVE "C"            TO MCXCBLERR-SCOPE.
           CALL "MCXCBLERR"    USING MCXCBLERR-SCOPE.
           OPEN INPUT          PM-SCHEDULE.

      *    MOVE 0              TO OVRPRTF-TOFILE-NUM.
           MOVE "P "           TO OVRPRTF-TOFILE-NUM-X.
           COPY OVRPFCALL      IN COPYLIB.
           OPEN OUTPUT         PRINT-FILE.

       SELECT-FUNCTION.
           ACCEPT DATE-HOLD    FROM DATE.
           MOVE DH-YY          TO CD-YY TD-YY CM-YY.
           MOVE DH-MM          TO CD-MM TD-MM CM-MM.
           MOVE DH-DD          TO CD-DD TD-DD CM-DD.
           MOVE "/"            TO SL1 SL2.
           IF TD-YY > 90
               MOVE 19         TO TD-CT CD-CT CM-CT
           ELSE
               MOVE 20         TO TD-CT CD-CT CM-CT.

           MOVE TODAYS-DATE    TO GREG-DATE.
           MOVE SPACES         TO JUL-DATE D-PARM L-PARM.
           CALL "JULGREG"      USING
                               GREG-DATE
                               JUL-DATE
                               D-PARM
                               L-PARM.

           MOVE J-DAY          TO JUL-SIGN.
           ADD 1               TO JUL-SIGN.
           PERFORM UNTIL       JUL-SIGN < 366
               SUBTRACT 365    FROM JUL-SIGN
               ADD 1           TO   J-YEAR
           END-PERFORM.

           MOVE JUL-SIGN       TO J-DAY.
           MOVE SPACES         TO GREG-DATE.
           CALL "JULGREG"      USING
                               GREG-DATE
                               JUL-DATE
                               D-PARM
                               L-PARM.

           MOVE GREG-DATE      TO TOMORROWS-DATE.

           MOVE " ************************************************"
                               TO PRINT-REC.
           WRITE PRINT-REC     AFTER ADVANCING 2.
           MOVE "    M M I S   PREVENTIVE MAINTENANCE SCHEDULER"
                               TO PRINT-REC.
           WRITE               PRINT-REC.
           MOVE " ************************************************"
                               TO PRINT-REC.
           WRITE               PRINT-REC.

           MOVE "    ****************************************"
                               TO PRINT-REC.
           WRITE PRINT-REC     AFTER ADVANCING 2.
           MOVE "    **                                    **"
                               TO PRINT-REC.
           WRITE               PRINT-REC.
           MOVE "    **    AUTOMATIC PM SCHEDULER MODULE   **"
                               TO PRINT-REC.
           WRITE               PRINT-REC.
           MOVE "    **       PM-SCHEDULE RECORD LIST      **"
                               TO PRINT-REC.
           WRITE               PRINT-REC.
           MOVE "    **                                    **"
                               TO PRINT-REC.
           WRITE               PRINT-REC.
           MOVE CURR-DATE      TO P2.
           MOVE PRINT-DATE     TO PRINT-REC.
           WRITE               PRINT-REC.
           MOVE "    **                                    **"
                               TO PRINT-REC.
           WRITE               PRINT-REC.
           MOVE "    ****************************************"
                               TO PRINT-REC.
           WRITE               PRINT-REC.

           PERFORM CURR-MON-LOOP THRU CML-EXIT.

           MOVE SPACES         TO PRINT-REC.
           WRITE PRINT-REC     AFTER ADVANCING NEW-PAGE.
           MOVE " ************************************************"
                               TO PRINT-REC.
           WRITE PRINT-REC     AFTER ADVANCING 2.
           MOVE "    M M I S   PREVENTIVE MAINTENANCE SCHEDULER"
                               TO PRINT-REC.
           WRITE               PRINT-REC.
           MOVE " ************************************************"
                               TO PRINT-REC.
           WRITE               PRINT-REC.

           MOVE "    ****************************************"
                               TO PRINT-REC.
           WRITE PRINT-REC     AFTER ADVANCING 2.
           MOVE "    **                                    **"
                               TO PRINT-REC.
           WRITE               PRINT-REC.
           MOVE "    **    AUTOMATIC PM SCHEDULER MODULE   **"
                               TO PRINT-REC.
           WRITE               PRINT-REC.
           MOVE "    **       PM-SCHEDULE RECORD LIST      **"
                               TO PRINT-REC.
           WRITE               PRINT-REC.
           MOVE "    **                                    **"
                               TO PRINT-REC.
           WRITE               PRINT-REC.
           MOVE "    **   RECORDS WHICH WILL BE EXECUTED   **"
                               TO PRINT-REC.
           WRITE               PRINT-REC.
           MOVE TM-YY          TO CD-YY.
           MOVE TM-MM          TO CD-MM.
           MOVE TM-DD          TO CD-DD.
           MOVE TM-CT          TO CD-CT.
           MOVE "/"            TO SL1 SL2.
           MOVE CURR-DATE      TO PT2.
           MOVE PRINT-TOM      TO PRINT-REC.
           WRITE               PRINT-REC.
           MOVE "    **                                    **"
                               TO PRINT-REC.
           WRITE               PRINT-REC.
           MOVE "    ****************************************"
                               TO PRINT-REC.
           WRITE               PRINT-REC.

           PERFORM TOMORROW-LOOP THRU TOM-EXIT.

           MOVE ALL "- "       TO PRINT-REC.
           WRITE               PRINT-REC.
           MOVE " ************************************************"
                               TO PRINT-REC.
           WRITE PRINT-REC     AFTER ADVANCING 2.
           MOVE "    M M I S   PREVENTIVE MAINTENANCE SCHEDULER"
                               TO PRINT-REC.
           WRITE               PRINT-REC.
           MOVE "             PM-SCHEDULE RECORD LIST"
                               TO PRINT-REC.
           WRITE               PRINT-REC.
           MOVE "            JOB COMPLETED SUCCESSFULLY"
                               TO PRINT-REC.
           WRITE               PRINT-REC.
           MOVE " ************************************************"
                               TO PRINT-REC.
           WRITE               PRINT-REC.

       END-OF-JOB.
           CLOSE               PM-SCHEDULE.
           CLOSE               PRINT-FILE.
           GOBACK.

       CURR-MON-LOOP.
           MOVE TODAYS-DATE    TO COMPARE-DATE.
           MOVE CM-YEARMO      TO PMRLSEYRMO OF PM-SCHEDULE.
           START PM-SCHEDULE   KEY = PMRLSEYRMO OF PM-SCHEDULE
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
               GO TO CML-EXIT.

       CM-DBGET-LOOP.
           READ PM-SCHEDULE    NEXT INTO PM-SCHED-DATA
              AT END           MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT = "10" OR "14" OR "46"
               GO CML-EXIT
           ELSE
           IF FILE-STAT NOT = "00"
               MOVE "READ NEXT "  TO DB-FUNC
               MOVE "PM-SCHEDULE" TO DB-FILE
               MOVE FILE-STAT     TO CON-WORD
               GO TO END-OF-JOB.

           IF SCH-REC-TYP = "DM"
               GO TO CM-DBGET-LOOP.

           IF SCH-RELEASE-YRMO NOT = CM-YEARMO
               GO TO CML-EXIT.

           IF SCH-RELEASE-DATE = TODAYS-DATE OR
              SCH-RELEASE-DATE < TODAYS-DATE
               MOVE ALL "- "   TO PRINT-REC
               WRITE           PRINT-REC
               MOVE SPACES     TO PRINT-REC
               STRING          SCH-RELEASE-DATE    "  "
                               SCH-WO-NUM      "  "
                               SCH-EQUIP-NUM   "  "
                               SCH-REC-TYPE    "  "
                               SCH-LEVEL       "  "
                               SCH-ZONE        "  "
                               SCH-RESTRICT    "  "
                               SCH-PREREL-DATE "  "
                               DELIMITED BY SIZE
                               INTO PRINT-REC
               WRITE           PRINT-REC.

           GO TO CM-DBGET-LOOP.

       CML-EXIT.               EXIT.

       TOMORROW-LOOP.
           MOVE TOMORROWS-DATE TO COMPARE-DATE.
           MOVE CM-YEARMO      TO PMRLSEYRMO OF PM-SCHEDULE.
           START PM-SCHEDULE   KEY = PMRLSEYRMO OF PM-SCHEDULE
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
               GO TO TOM-EXIT.

       TOM-DBGET-LOOP.
           READ PM-SCHEDULE    NEXT INTO PM-SCHED-DATA
              AT END           MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT = "10" OR "14" OR "46"
               GO TOM-EXIT
           ELSE
           IF FILE-STAT NOT = "00"
               MOVE "READ NEXT "  TO DB-FUNC
               MOVE "PM-SCHEDULE" TO DB-FILE
               MOVE FILE-STAT     TO CON-WORD
               GO TO END-OF-JOB.

           IF SCH-REC-TYP = "DM"
               GO TO TOM-DBGET-LOOP.

           IF SCH-RELEASE-YRMO NOT = CM-YEARMO
               GO TO TOM-EXIT.

           IF SCH-RELEASE-DATE = TOMORROWS-DATE
               MOVE ALL "- "   TO PRINT-REC
               WRITE           PRINT-REC
               MOVE SPACES     TO PRINT-REC
               STRING          SCH-RELEASE-DATE    "  "
                               SCH-WO-NUM      "  "
                               SCH-EQUIP-NUM   "  "
                               SCH-REC-TYPE    "  "
                               SCH-LEVEL       "  "
                               SCH-ZONE        "  "
                               SCH-RESTRICT    "  "
                               SCH-PREREL-DATE "  "
                               DELIMITED BY SIZE
                               INTO PRINT-REC
               WRITE           PRINT-REC.

           GO TO TOM-DBGET-LOOP.

       TOM-EXIT.               EXIT.

