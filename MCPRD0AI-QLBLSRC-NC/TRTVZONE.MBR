       IDENTIFICATION DIVISION.
       PROGRAM-ID.             TRTVZONE.
       AUTHOR.                 W. ROXBURY.
       INSTALLATION.           GOODYEAR TIRE AND RUBBER COMPANY.
       DATE-WRITTEN.           SEPTEMBER  1985.
       DATE-COMPILED.
       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.
       SOURCE-COMPUTER.        IBM-AS400.
       OBJECT-COMPUTER.        IBM-AS400.
       SPECIAL-NAMES.          I-O-FEEDBACK     IS I-O-FEEDBACK-AREA
                               REQUESTOR        IS WORK-STATION
                               SYSTEM-CONSOLE   IS CONSOLE
                               LOCAL-DATA       IS LOCAL-DATA-AREA.

      *C****************************************************************
      *C  02/06/97  WDR
      *C    ADDED SUBFILE SELECTION OF ZONE FROM VALID ZONE LIST.
      *C****************************************************************

       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT WO-ZONE-PRTY
                  ASSIGN       TO DATABASE-MCFLMM0501
                  ORGANIZATION IS INDEXED
                  ACCESS MODE  IS DYNAMIC
                  RECORD KEY   IS EXTERNALLY-DESCRIBED-KEY
                  FILE STATUS  IS FILE-STAT.

           SELECT DISPLAY-FILE
                  ASSIGN       TO WORKSTATION-ZRTVZONE-SI
                  ORGANIZATION IS TRANSACTION
                  ACCESS MODE  IS DYNAMIC
                  RELATIVE KEY IS RECNO
                  FILE STATUS  IS SCREEN-STATUS
                               MAJOR-MINOR
                  CONTROL-AREA IS SCREEN-CONTROL.

       DATA DIVISION.
       FILE SECTION.
       FD  WO-ZONE-PRTY
           LABEL RECORDS       ARE STANDARD.
       01  CR-REC.
           COPY DDS-ALL-FORMATS OF MCFLMM0501.

       FD  DISPLAY-FILE
           LABEL RECORDS       ARE OMITTED.
       01  DISPLAY-REC         PIC X(2000).

       WORKING-STORAGE SECTION.
       77  RECNO               PIC 9999  VALUE 0.
       77  ZONE-HOLD           PIC XXXX.
       77  TRUE-VAL            PIC 1   VALUE B"1".
       77  NEG-VAL             PIC 1   VALUE B"0".

       01  FILE-STAT.
           05 FILE-STAT-1      PIC X   VALUE "0".
           05 FILE-STAT-2      PIC X   VALUE "0".

       01  SCREEN-DATA.
           05  ZONE-BUF        PIC XXXX.
           05  SCRN-MSGS.
               10  CMDMSG      PIC X(79).
               10  ERRMSG      PIC X(79).

       01  ZONE-LIST-DATA.
           05  SEL-BUF         PIC X.
           05  LZONE           PIC XXXX.

       01  ZONE-ARGUMENT.
           05  Z-ARG           PIC X(4).
           05  FILLER          PIC XX   VALUE "1 ".

       01  DB-ERROR.
           05  DB-FUNC   PIC X(10) VALUE SPACES.
           05  DB-FILE   PIC X(18) VALUE SPACES.
           05  FILLER    PIC X(20) VALUE "ERROR - FILE-STAT = ".
           05  CON-WORD  PIC XX.

           COPY SCREENIO       IN COPYLIB.

           COPY CATREAD        IN COPYLIB.

           COPY JCWAREA        IN COPYLIB.

       01  DBPARAMETERS.
           COPY DBPARMS        IN COPYLIB.

       01  ZONE-DATA.
           COPY MZONPRTY       IN COPYLIB.

       01  MESSAGE-BUFFER-DATA.
           COPY ERRORLIN       IN COPYLIB.

       LINKAGE SECTION.
       01  ZONE-KEY            PIC XXXX.

       PROCEDURE DIVISION      USING ZONE-KEY.
       BEGIN-PROC.
           OPEN INPUT          WO-ZONE-PRTY.
           OPEN I-O            DISPLAY-FILE.

       6-MAIN.
           IF ZONE-KEY = "?   " OR "??  " OR "??? " OR "????" OR
                         " ?  " OR "  ? " OR "   ?" OR "??  " OR
                         " ?? " OR "  ??" OR "??? " OR "??? "
               MOVE SPACES     TO ZONE-KEY
               PERFORM DISPLAY-ZONES THRU DZ-EXIT
               IF ZONE-KEY = SPACES
                   GO TO 6-MAIN
               ELSE
                   MOVE ZONE-KEY TO ZONE-BUF
                   GO TO UPDATE-JCW.

           MOVE SPACES         TO SCREEN-DATA
                                  ZONE-KEY.
           MOVE "VRTVZONE"     TO SCREEN-NAME.

       61-SHOWFORM.
           MOVE "00"           TO SCREEN-STATUS.
           MOVE SCREEN-DATA    TO DISPLAY-REC.

           WRITE DISPLAY-REC  FORMAT IS SCREEN-NAME
               INDIC ARE SCREEN-INDICATORS.
           IF SCREEN-STATUS NOT = "00"
               DISPLAY "SCREEN WRITE ERROR.  SCREEN-STATUS IS "
                        SCREEN-STATUS
               GO TO END-OF-JOB.

           READ  DISPLAY-FILE FORMAT IS SCREEN-NAME
               INDIC ARE SCREEN-INDICATORS
           IF SCREEN-STATUS NOT = "00"
               DISPLAY "SCREEN READ ERROR.  SCREEN-STATUS IS "
                        SCREEN-STATUS
               GO TO END-OF-JOB.

           MOVE DISPLAY-REC    TO SCREEN-DATA.
           MOVE ALL B"0"       TO SCREEN-INDICATORS.

           IF KEY-HIT = 3 OR 8
               MOVE SPACES     TO ZONE-KEY
               GO TO END-OF-JOB.

           IF KEY-HIT = 4
               PERFORM DISPLAY-ZONES THRU DZ-EXIT
               IF ZONE-KEY = SPACES
                   GO TO 6-MAIN
               ELSE
                   MOVE ZONE-KEY TO ZONE-BUF
                   GO TO UPDATE-JCW.

           IF ZONE-BUF = SPACES
      **********************************************************************
      **    MESSAGE 035/044:
      ** INVALID ZONE
      **********************************************************************
               MOVE  35        TO CATREAD-MSG-SET
               MOVE  44        TO CATREAD-MSG-NUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER TO ERRMSG
               MOVE TRUE-VAL   TO IND(1) IND(99)
               GO TO 61-SHOWFORM.

           MOVE ZONE-BUF       TO Z-ARG.
           MOVE ZONE-ARGUMENT  TO ZONEPRTY OF WO-ZONE-PRTY.
           START WO-ZONE-PRTY  KEY = EXTERNALLY-DESCRIBED-KEY
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
      **********************************************************************
      **    MESSAGE 035/044:
      ** INVALID ZONE
      **********************************************************************
               MOVE  35        TO CATREAD-MSG-SET
               MOVE  44        TO CATREAD-MSG-NUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER TO ERRMSG
               MOVE TRUE-VAL   TO IND(1) IND(99)
               GO TO 61-SHOWFORM.

       UPDATE-JCW.
           MOVE ZONE-BUF       TO JCW-ZJCW-269 SETJCW-VALUE
                                  ZONE-KEY.
           MOVE 269            TO SETJCW-STARTING-POS.
           MOVE 4              TO SETJCW-LENGTH.

           CALL "SETJCW" USING SETJCW-VALUE,
                               SETJCW-STARTING-POS,
                               SETJCW-LENGTH,
                               SETJCW-STATUS.

           IF SETJCW-STATUS NOT = "00"
               MOVE "    "     TO JCW-ZJCW-269.

       END-OF-JOB.
           CLOSE               DISPLAY-FILE.
           CLOSE               WO-ZONE-PRTY.
           GOBACK.

       DISPLAY-ZONES.
           MOVE SPACES         TO ZONE-KEY.
           MOVE 0              TO RECNO.
           MOVE NEG-VAL        TO IND(75).
           MOVE TRUE-VAL       TO IND(77) IND(76).
           MOVE SPACES         TO DISPLAY-REC
                                  ZONE-LIST-DATA
                                  ZONE-HOLD.
           WRITE DISPLAY-REC   FORMAT "ZONELIST"
                               INDIC ARE SCREEN-INDICATORS.
           IF SCREEN-STATUS NOT = "00"
               DISPLAY
               "SUBFILE CLEAR WRITE ERROR.  SCREEN-STATUS IS "
                               SCREEN-STATUS.
           MOVE NEG-VAL        TO IND(77).

           MOVE LOW-VALUES     TO ZONEPRTY OF WO-ZONE-PRTY.
           START WO-ZONE-PRTY  KEY >= ZONEPRTY OF WO-ZONE-PRTY
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT = "23"
               GO TO DBGET-LOOP
           ELSE
           IF FILE-STAT NOT = "00"
               MOVE "START    "    TO DB-FUNC
               MOVE "WO-ZONE-PRTY" TO DB-FILE
               MOVE FILE-STAT      TO CON-WORD
               DISPLAY             DB-ERROR
               GO TO DZ-EXIT.

       DBGET-LOOP.
           READ WO-ZONE-PRTY   NEXT INTO ZONE-DATA
               AT END          MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT = "10" OR "14" OR "46"
               GO TO SUBF-CONT
           ELSE
           IF FILE-STAT NOT = "00"
               MOVE "READ     "    TO DB-FUNC
               MOVE "WO-ZONE-PRTY" TO DB-FILE
               MOVE FILE-STAT      TO CON-WORD
               DISPLAY             DB-ERROR
               GO TO DZ-EXIT.

           IF ZONE-FIELD = SPACES
               GO TO DBGET-LOOP.

           IF ZONE-FIELD = ZONE-HOLD
               GO TO DBGET-LOOP.

           MOVE SPACES         TO ZONE-LIST-DATA.
           MOVE ZONE-FIELD     TO ZONE-HOLD
                                  LZONE.
           ADD 1               TO RECNO.
           MOVE ZONE-LIST-DATA TO DISPLAY-REC.
           MOVE "00"           TO SCREEN-STATUS.
           WRITE SUBFILE       DISPLAY-REC FORMAT "ZONES"
                               INDIC ARE SCREEN-INDICATORS
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF SCREEN-STATUS NOT = "00"
               DISPLAY   "SUBFILE 1 WRITE ERROR.  SCREEN STATUS IS "
                   SCREEN-STATUS
               GO TO END-OF-JOB.

           GO TO DBGET-LOOP.

       SUBF-CONT.
           IF RECNO EQUAL 0
               GO TO DZ-EXIT.

           WRITE DISPLAY-REC   FORMAT "ZONECMD"
                               INDIC ARE SCREEN-INDICATORS.
           MOVE TRUE-VAL       TO IND(76).
           IF RECNO GREATER THAN 0
               MOVE TRUE-VAL   TO IND(75)
           ELSE
               MOVE NEG-VAL    TO IND(75).

           WRITE DISPLAY-REC   FORMAT "ZONELIST"
                               INDIC ARE SCREEN-INDICATORS.
           READ DISPLAY-FILE   FORMAT "ZONELIST"
                               INDIC ARE SCREEN-INDICATORS.

           MOVE SPACES         TO ZONE-LIST-DATA.
           READ SUBFILE        DISPLAY-FILE
                               NEXT MODIFIED INTO ZONE-LIST-DATA
                               FORMAT "ZONES"
                               INDIC ARE SCREEN-INDICATORS.

           IF SEL-BUF NOT = SPACE
               MOVE LZONE      TO ZONE-KEY.

       DZ-EXIT.                EXIT.

       999-CATREAD.
           MOVE SPACES         TO MESSAGE-BUFFER.
           CALL "CCATREAD" USING CATREAD-PARMS.
           MOVE CATREAD-MSG-TEXT TO MESSAGE-BUFFER.

       999-CATREAD-EXIT.    EXIT.

