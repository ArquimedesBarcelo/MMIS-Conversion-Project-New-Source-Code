       69-START-EQUIP-NUM-FILE.
           MOVE 0 TO COND-WORD.
077600     MOVE EQUIP-NUM-BUF2 TO EQPNUM OF ENFREC.
           START EQUIP-NUM-FILE KEY IS = EXTERNALLY-DESCRIBED-KEY
               INVALID KEY MOVE 17 TO COND-WORD.
           IF ENF-STATUS NOT = "00" MOVE 17 TO COND-WORD.

       69-READ-EQUIP-NUM-FILE.
           MOVE 0 TO COND-WORD.
           READ EQUIP-NUM-FILE NEXT INTO EQUIP-DATA
               AT END    MOVE 17 TO COND-WORD.
           IF ENF-STATUS NOT = "00" MOVE 17 TO COND-WORD.

       69-READ-MVALIDPLTDATA-FILE.
           MOVE 0 TO COND-WORD.
           MOVE ARG-KEY-2 TO VALDTAKEY OF MVFREC.
           START MVALIDPLTDATA-FILE KEY IS = EXTERNALLY-DESCRIBED-KEY
               INVALID KEY MOVE 17 TO COND-WORD.
           IF MVF-STATUS NOT = "00" MOVE 17 TO COND-WORD.

       69-READ-WO-PLANNED-FILE.
           MOVE 0 TO COND-WORD.
           READ WO-PLANNED-FILE NEXT INTO WO-PLANNED-DATA
               AT END    MOVE 15 TO COND-WORD.
           IF WPF-STATUS NOT = "00" MOVE 15 TO COND-WORD.

       69-START-WO-PLANNED-FILE.
           MOVE 0 TO COND-WORD.
           MOVE WORK-ORDER-NUMBER TO WONUM OF WPFREC.
           START WO-PLANNED-FILE KEY IS = EXTERNALLY-DESCRIBED-KEY
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF WPF-STATUS NOT = "00" MOVE 17 TO COND-WORD.

       69-START-WO-STATUS-MSTR-FILE.
           MOVE 0 TO COND-WORD.
060900     MOVE WO-STATUS-BUF2 TO WOSTATUS OF WSMFREC.
           START WO-STATUS-MSTR-FILE KEY IS = EXTERNALLY-DESCRIBED-KEY
               INVALID KEY MOVE 17 TO COND-WORD.
           IF WSMF-STATUS NOT = "00" MOVE 17 TO COND-WORD.

       69-START-WO-ZONE-PRTY-FILE.
           MOVE 0 TO COND-WORD.
083400     MOVE ZONE-BUF2 TO ARG-1-3.
083500     MOVE PRIORITY-BUF2 TO ARG-2-3.
083600     MOVE SPACE TO ARG-3-3.
           MOVE ARG-KEY-1 TO ZONEPRTY OF WZPFREC.
           START WO-ZONE-PRTY-FILE KEY IS = EXTERNALLY-DESCRIBED-KEY
               INVALID KEY MOVE 17 TO COND-WORD.
           IF WZPF-STATUS NOT = "00" MOVE 17 TO COND-WORD.

       98-SCREEN-READ.
           READ DISPLAY-FILE FORMAT IS VIEW-CFNAME
               INDIC IS INDICS.
           ACCEPT IOFEEDBACK FROM I-O-FEEDBACK-AREA.
           MOVE ALL B"0" TO INDICS.
           IF DSPLY-STATUS NOT = "00"
               MOVE 3 TO VIEW-LASTKEY
           ELSE
           MOVE FUNCTION-NUM TO VIEW-LASTKEY.

       98A-SCREEN-READ.
           READ DISPLAY-FILE TERMINAL IS TERMINAL-ID
               INDIC IS INDICS
                  NO DATA MOVE DSPLY-STATUS TO DSPLY-STATUS.
           MOVE ALL B"0" TO INDICS.

       99-SCREEN-WRITE.
           WRITE DSPLY-REC FORMAT IS VIEW-CFNAME
               INDIC IS INDICS.
           MOVE ALL B"0" TO INDICS.


