       01  LAST-WO-BUFF.                     COPY MLASTWO OF COPYLIB.
024300 01  ERROR-SWITCH.
024400     05  ERR-SW                   PIC S9(4) COMP SYNC.
       COPY VCOMLINK OF COPYLIB.
024500 PROCEDURE DIVISION USING DBPARAMETERS LAST-WO-BUFF
024700                     ERROR-SWITCH VIEW-COMAREA.
024800 BEGIN.
024900     PERFORM 1-HSK.
025000     PERFORM 6-MAIN THRU 6-MAIN-X UNTIL RETURN-SW = "END".
025100 2-EOJ.
           CLOSE DISPLAY-FILE
                 EQUIP-NUM-FILE
                 MVALIDPLTDATA-FILE
                 WO-PLANNED-FILE
                 WO-STATUS-MSTR-FILE
                 WO-ZONE-PRTY-FILE.
025200     GOBACK.
025300****************************************************************
025400*    HOUSEKEEPING                                              *
025500****************************************************************
025600 1-HSK.
           OPEN I-O   DISPLAY-FILE.
           OPEN INPUT EQUIP-NUM-FILE.
           OPEN INPUT MVALIDPLTDATA-FILE.
           OPEN INPUT WO-PLANNED-FILE.
           OPEN INPUT WO-STATUS-MSTR-FILE.
           OPEN INPUT WO-ZONE-PRTY-FILE.
025700     CALL "TPWORD" USING PASSWORD-INFORMATION.
026100     IF PASSWORD-FLAG = "N"
026200         MOVE "  PWORD" TO BLOWUP-BASE
026300         MOVE "FAILED PASSWORD CHECK - TINITWO2"
026400             TO BU-DISPLAY-MSG
026500         PERFORM 998-BLOWUP.
           CALL "CLWHO" USING USERNAME TERMNUM CURRLIB JOBLIBX.
026600     MOVE SPACES TO RETURN-SW.
026700     MOVE SPACES TO BUFFER SCREEN-ERROR.
026800     MOVE 0 TO ERR-SW.
           MOVE 0 TO FIRST-READ-SW.
           MOVE 27015 TO CATREAD-MSG-NUMBER.
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
           MOVE ERROR-BUFFER TO CHANGE-DATA-MSG.
           ACCEPT MC-LOCAL-DATA-AREA FROM LOCAL-DATA-AREA.
030400*****************************************************************
030500*    MAIN LOGIC                                                 *
030600*****************************************************************
030700 6-MAIN.
030800     PERFORM 61-ENTER-DATA.
034700*
034800*    STANDARD INPUTS TO BUF2.
034900*
035000     MOVE "OO" TO WO-STATUS-BUF2.
035100     MOVE 1 TO DATE-MODE.
035200     MOVE DATE-FLAG TO DATE-CODE.
035300     CALL "TDATECK2" USING DATE-CHECK-AREA.
035400     MOVE DATE-SLASH-OUT TO TMP-DATE-AREA.
035600     MOVE MONTH-30-W TO DATE-RECD-MD-BUF2.
035700     MOVE DAY-30-W TO DATE-RECD-DM-BUF2.
035800     MOVE YEAR-30-W TO DATE-RECD-YY-BUF2.
035500     ACCEPT TMP-TIME-AREA FROM TIME.
035900     MOVE HRS-MIN-30-W TO TIME-RECD-BUF2.
036000     MOVE "U" TO APPROVAL-CODE-BUF2.
           MOVE "N" TO DATA-ENTERED-OK-SW.
031400     PERFORM 62-CHECK-INPUTS-AND-CORRECT
               UNTIL DATA-ENTERED-OK-SW = "Y".
031600 6-MAIN-X.
031700     EXIT.
031800****************************************************************
031900*    CLEAR FORM, FORM BUFFER, AND WO-PLANNED BUFFER              *
032000****************************************************************
032100 61-ENTER-DATA.
           IF PLANT-IDENT = "285"
               IF ZONE-BUF2 = "Z6MM"
                   MOVE SPACES TO WO-PLANNED-DATA
                                  EQUIP-DATA-BUF2
               ELSE
               MOVE SPACES TO WO-PLANNED-DATA BUFFER
           ELSE
033300     MOVE SPACES TO WO-PLANNED-DATA BUFFER.
032500     MOVE "FINITPLN" TO VIEW-CFNAME.
           MOVE 31042 TO CATREAD-MSG-NUMBER.
033700     PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
033800     MOVE ERROR-BUFFER TO MESSAGE-BUF2.
           IF WO-ENT = SPACES
034500         MOVE SPACES TO MSGTWO-BUF2
           ELSE
           MOVE WO-ENTERED-MSG TO MSGTWO-BUF2
           MOVE SPACES TO WO-ENTERED-MSG.
DCR01 **** MOVE 52011 TO CATREAD-MSG-NUMBER.
DCR01      MOVE 52013 TO CATREAD-MSG-NUMBER.
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
           MOVE ERROR-BUFFER TO BUFFER-CMD-LINE.
           MOVE SCREEN-ERROR TO BUFFER-ERR-LINE.
           MOVE BUFFER TO DSPLY-REC.
           PERFORM 629-CALL-TSCREEN.
           MOVE DSPLY-REC TO BUFFER.
           IF VIEW-LASTKEY = 1
               GO TO 2-EOJ
           END-IF.

           IF VIEW-LASTKEY = 3
               MOVE "END" TO RETURN-SW
               GO TO 6-MAIN-X
           END-IF.

DCR01      IF VIEW-LASTKEY = 5
DCR01         PERFORM 800-CALL-EQUIP-SELECTION THRU 800-EQP-EXIT
DCR01      END-IF.


036400 62-CHECK-INPUTS-AND-CORRECT.
036500     PERFORM 620-CHECK-INPUTS THRU 620-CHECK-INPUTS-X.
           IF ERROR-SW = 1
               IF VIEW-CFNAME = "FINITPLN"
                   MOVE ERROR-BUFFER TO SCREEN-ERROR
                   MOVE CHANGE-DATA-MSG TO MESSAGE-BUF2
                   MOVE SPACES TO MSGTWO-BUF2
DCR01 *********    MOVE 52011 TO CATREAD-MSG-NUMBER
DCR01              MOVE 52013 TO CATREAD-MSG-NUMBER
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE ERROR-BUFFER TO BUFFER-CMD-LINE
                   MOVE SCREEN-ERROR TO BUFFER-ERR-LINE
                   MOVE BUFFER TO DSPLY-REC
                   PERFORM 629-CALL-TSCREEN
                   MOVE DSPLY-REC TO BUFFER
                   MOVE SPACES TO SCREEN-ERROR
                   MOVE 0 TO ERROR-SW
                   IF VIEW-LASTKEY = 1
                       GO TO 2-EOJ
                   ELSE
                   IF VIEW-LASTKEY = 3
                       MOVE "END" TO RETURN-SW
                       GO TO 6-MAIN-X
                   ELSE
                   GO TO 62-CHECK-INPUTS-AND-CORRECT
               ELSE
               MOVE ERROR-BUFFER TO SCREEN-ERROR
               MOVE CHANGE-DATA-MSG TO MESSAGE-BUF2
               MOVE SPACES TO MSGTWO-BUF2 BUFFER-CMD-LINE
               MOVE SCREEN-ERROR TO BUFFER-ERR-LINE
               MOVE BUFFER TO DSPLY-REC
               PERFORM 629-CALL-TSCREEN
               MOVE DSPLY-REC TO BUFFER
               MOVE SPACES TO SCREEN-ERROR
               MOVE 0 TO ERROR-SW
               IF VIEW-LASTKEY = 1
                   GO TO 2-EOJ
               ELSE
               IF VIEW-LASTKEY = 3
                   MOVE "END" TO RETURN-SW
                   GO TO 6-MAIN-X
               ELSE
               GO TO 62-CHECK-INPUTS-AND-CORRECT.
037500     PERFORM 623-MOVE-BUF2-TO-WO-PLANNED.
           MOVE 42065 TO CATREAD-MSG-NUMBER.
038000     PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
038100     MOVE ERROR-BUFFER TO MESSAGE-BUF2.
           MOVE SPACES TO MSGTWO-BUF2.
           MOVE SPACES TO BUFFER-CMD-LINE.
           MOVE BUFFER TO DSPLY-REC.
037700     PERFORM 629-CALL-TSCREEN.
           MOVE DSPLY-REC TO BUFFER.
038200     MOVE WO-STATUS-BUF2 TO WO-STATUS-BUF2-SAVE.
039800     IF VIEW-LASTKEY = 3 GO TO 2-EOJ.
040100     IF VIEW-LASTKEY = 2
040200         MOVE "FINITPL2" TO VIEW-CFNAME
               MOVE 29041 TO CATREAD-MSG-NUMBER
040600         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
040700         MOVE ERROR-BUFFER TO MESSAGE-BUF2
               MOVE SPACES TO BUFFER-CMD-LINE
               MOVE BUFFER TO DSPLY-REC
040300         PERFORM 629-CALL-TSCREEN
               MOVE DSPLY-REC TO BUFFER
               GO TO 62-CHECK-INPUTS-AND-CORRECT.
           MOVE "Y" TO DATA-ENTERED-OK-SW.
042000     CALL "TNEWWONU" USING DBPARAMETERS STATUS-AREA
042100                       WORK-ORDER-NUMBER ERROR-SWITCH.
042500     IF ERR-SW = 99 GO TO 2-EOJ.
043700     IF VIEW-CFNAME = "FINITPL2"
043800         MOVE WORK-ORDER-NUMBER TO WO-NUM-PLANNED
043900         MOVE "0" TO COND-CODE
               MOVE 0 TO ERROR-SW
044800         CALL "TADDWOII" USING DBPARAMETERS STATUS-AREA
044900                           WO-PLANNED-DATA COND-CODE ERROR-SW
               IF ERROR-SW NOT = 0
                   MOVE 29051 TO CATREAD-MSG-NUMBER
047100             PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
047200             MOVE ERROR-BUFFER TO ADD-ERROR-MSG
047300             MOVE COND-WORD TO A-CW
                   MOVE ADD-ERROR-MSG TO BUFFER-ERR-LINE
                   MOVE BUFFER TO DSPLY-REC
                   PERFORM 629-CALL-TSCREEN
                   MOVE DSPLY-REC TO BUFFER
                   MOVE "  MMISA" TO BLOWUP-BASE
                   MOVE ADD-ERROR-MSG TO BU-DISPLAY-MSG
                   PERFORM 998-BLOWUP
047900         ELSE
               MOVE WORK-ORDER-NUMBER TO WO-NUM-PLANNED
               MOVE 49015 TO CATREAD-MSG-NUMBER
048200         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
048300         MOVE ERROR-BUFFER TO WO-ENTERED-MSG
048400         MOVE WO-NUM-PLANNED TO WO-ENT
               MOVE WO-ENTERED-MSG TO MSGTWO-BUF2
               MOVE BUFFER TO DSPLY-REC
               MOVE TRUE-VAL TO INDS (98)
               PERFORM 99-SCREEN-WRITE
               PERFORM 98A-SCREEN-READ
               CALL "CLPAUSE2"
045200         MOVE SPACES TO WO-TRACK-DATA
045300         MOVE USERNAME TO USER-NAME
045400         MOVE TERMNUM TO USER-TERM
045600         MOVE WO-NUM-PLANNED TO WO-NUM-TRACK
045700         MOVE YEAR-30-W  TO DATE-STAMP-YY
               PERFORM 620-SET-CENTURY
045800         MOVE MONTH-30-W TO DATE-STAMP-MM
045900         MOVE DAY-30-W   TO DATE-STAMP-DD
               IF DATE-FLAG = 3
                   MOVE MONTH-30-W TO DATE-STAMP-DD
                   MOVE DAY-30-W   TO DATE-STAMP-MM
               END-IF
046000         MOVE TMP-TIME-AREA TO TIME-STAMP
046100         MOVE WO-START-STATUS TO WO-TYPE-STATUS
046200         MOVE USERNAME TO USER-ID
046300         MOVE "    " TO CLOCK-CARD
046400         MOVE WO-STATUS-P TO WO-STATUS-TRACK
046500         MOVE "TINITWO2" TO PROGRAM-NAME
046600         CALL "TWOTRACK" USING WO-TRACK-DATA
               MOVE "0" TO COND-CODE
               CALL "TJOBPLAN" USING DBPARAMETERS
                                     WORK-ORDER-NUMBER
                                     VIEW-COMAREA
               MOVE 0 TO VIEW-LASTKEY
               CALL "TMODMATL" USING DBPARAMETERS
                                     WORK-ORDER-NUMBER
                                     VIEW-COMAREA
               MOVE "88" TO ERROR-SWITCH
               PERFORM 69-START-WO-PLANNED-FILE
               PERFORM 69-READ-WO-PLANNED-FILE
               IF COND-WORD = 0
                   CALL "TPRINTWS" USING DBPARAMETERS
                                         WO-PLANNED-DATA
                                         ERROR-SWITCH
                                         VIEW-COMAREA
                   MOVE 0 TO ERR-SW
               ELSE
               MOVE 0 TO ERR-SW
           ELSE
           MOVE WORK-ORDER-NUMBER TO WO-NUM-PLANNED
050700     MOVE "0" TO COND-CODE
051600     CALL "TADDWOII" USING DBPARAMETERS STATUS-AREA
051700                       WO-PLANNED-DATA COND-CODE ERROR-SW
052000     IF ERROR-SW NOT = 0
               MOVE 29051 TO CATREAD-MSG-NUMBER
052300         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
052400         MOVE ERROR-BUFFER TO ADD-ERROR-MSG
052500         MOVE COND-WORD TO A-CW
               MOVE BUFFER TO DSPLY-REC
               PERFORM 629-CALL-TSCREEN
               MOVE DSPLY-REC TO BUFFER
               MOVE "  MMISA" TO BLOWUP-BASE
               MOVE ADD-ERROR-MSG TO BU-DISPLAY-MSG
               PERFORM 998-BLOWUP
053100     ELSE
           MOVE WORK-ORDER-NUMBER TO WO-NUM-PLANNED
           MOVE 49015 TO CATREAD-MSG-NUMBER
053400     PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
053500     MOVE ERROR-BUFFER TO WO-ENTERED-MSG
053600     MOVE WO-NUM-PLANNED TO WO-ENT
           MOVE WO-ENTERED-MSG TO MSGTWO-BUF2
           MOVE BUFFER TO DSPLY-REC
           MOVE TRUE-VAL TO INDS (98)
           PERFORM 99-SCREEN-WRITE
           PERFORM 98A-SCREEN-READ
           CALL "CLPAUSE2"
054300     MOVE SPACES TO WO-TRACK-DATA
054400     MOVE USERNAME TO USER-NAME
054500     MOVE TERMNUM TO USER-TERM
054700     MOVE WO-NUM-PLANNED TO WO-NUM-TRACK
054800     MOVE YEAR-30-W   TO DATE-STAMP-YY
           PERFORM 620-SET-CENTURY
054900     MOVE MONTH-30-W  TO DATE-STAMP-MM
055000     MOVE DAY-30-W    TO DATE-STAMP-DD
           IF DATE-FLAG = 3
               MOVE MONTH-30-W TO DATE-STAMP-DD
               MOVE DAY-30-W   TO DATE-STAMP-MM
           END-IF
055100     MOVE TMP-TIME-AREA TO TIME-STAMP
055200     MOVE WO-START-STATUS TO WO-TYPE-STATUS
055300     MOVE USERNAME TO USER-ID
055400     MOVE "    " TO CLOCK-CARD
055500     MOVE WO-STATUS-P TO WO-STATUS-TRACK
055600     MOVE "TINITWO2" TO PROGRAM-NAME
055700     CALL "TWOTRACK" USING WO-TRACK-DATA
055900     MOVE "0" TO COND-CODE
           CALL "TJOBPLAN" USING DBPARAMETERS
                                 WORK-ORDER-NUMBER
                                 VIEW-COMAREA
           MOVE 0 TO VIEW-LASTKEY
           CALL "TMODMATL" USING DBPARAMETERS
                                 WORK-ORDER-NUMBER
                                 VIEW-COMAREA
           MOVE "88" TO ERROR-SWITCH
           PERFORM 69-START-WO-PLANNED-FILE
           PERFORM 69-READ-WO-PLANNED-FILE
           IF COND-WORD = 0
               CALL "TPRINTWS" USING DBPARAMETERS
                                     WO-PLANNED-DATA
                                     ERROR-SWITCH
                                     VIEW-COMAREA
               MOVE 0 TO ERR-SW
           ELSE
           MOVE 0 TO ERR-SW.
059000
       620-SET-CENTURY.
           IF DATE-STAMP-YY > 70
               MOVE 19 TO DATE-STAMP-CC
           ELSE
           MOVE 20 TO DATE-STAMP-CC.

059100****************************************************************
