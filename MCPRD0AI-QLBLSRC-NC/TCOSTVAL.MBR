000200 IDENTIFICATION DIVISION.
000300 PROGRAM-ID.           TCOSTVAL.
000400 AUTHOR.               MK MADDEN.
000500 DATE-WRITTEN.         DEC 2, 1985.
000600*INSTALLATION.         GOODYEAR TIRE AND RUBBER CO.
000700
000800*REMARKS.              THIS PROGRAM WILL READ THROUGH THE
000900*                      MATERIAL ACCUM DATA SET AND PRINT
001000*                      A REPORT SHOWING THE STATUS OF EACH
001100*                      MATERIAL CODE INCLUDING THE UNITS ON HAND
001200*                      THAT HAVE BEEN INVOICED AND THE UNITS THAT
001300*                      HAVE BEEN RECEIVED AND NOT INVOICED.
001400*                      A TOTAL WILL BE CALCULATED FOR EACH CLASS
001500*                      THAT WILL BE USED TO BALANCE AGAINST THE
001600*                      STOREROOM MOVEMENT REPORT.
      *C
      *C   07FEB1994    DAVE PLUM
      *C     ADDED CALL TO THE COBOL ERROR HANDLER - MCXCBLERR.
      *C
      *C   09/04/1996   CA YODER
      *C     RE-COMPILED TO PICK UP CENTURY DATABASE CHANGES.
      *C
001800 ENVIRONMENT DIVISION.
001900 CONFIGURATION SECTION.
002000 SOURCE-COMPUTER.      HP-3000.
002100 OBJECT-COMPUTER.      HP-3000.
       COPY SPECIALN IN COPYLIB.
002300
002400 INPUT-OUTPUT SECTION.
002500 FILE-CONTROL.
           SELECT MMATL-ACCUM-MC-I
               ASSIGN TO DATABASE-MCFLCA0601
               ORGANIZATION IS INDEXED
                 ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
               FILE STATUS IS FILE-STATUS.

           SELECT MSTORERM-CD-I
               ASSIGN TO DATABASE-MCFLCS0201
               ORGANIZATION IS INDEXED
                 ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
               FILE STATUS IS FILE-STATUS.

           SELECT MCLASS-CL-I
               ASSIGN TO DATABASE-MCFLCS4901
               ORGANIZATION IS INDEXED
                 ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
               FILE STATUS IS FILE-STATUS.

           SELECT ONLINE-PRT ASSIGN TO PRINTER-MCPRT.

           SELECT SORT-FILE ASSIGN TO DISK-SORT.

002900
003000 DATA DIVISION.
003200 FILE SECTION.
003300
      *------ FD STATEMENT AREA FOR IBM ONLY ------*
       FD  MMATL-ACCUM-MC-I
           LABEL RECORDS ARE STANDARD.
       01  MMATL-ACCUM-MC-REC-I.
           COPY DDS-MCRPCA0600  OF MCFLCA0601.

       FD  MSTORERM-CD-I
           LABEL RECORDS ARE STANDARD.
       01  MSTORERM-CD-REC-I.
           COPY DDS-MCRPCS0200  OF MCFLCS0201.

       FD  MCLASS-CL-I
           LABEL RECORDS ARE STANDARD.
       01  MCLASS-CL-REC-I.
           COPY DDS-MCRPCS4900  OF MCFLCS4901.

      *------ FD STATEMENT AREA FOR IBM ONLY ------*

003400 FD  ONLINE-PRT
003500     DATA RECORD IS PRT-REC
003600     RECORD CONTAINS 133 CHARACTERS
003700     LABEL RECORDS ARE OMITTED.
003800
003900 01  PRT-REC                      PIC X(133).
004000
004100 SD  SORT-FILE
004200     DATA RECORD IS SORT-REC
004300     RECORD CONTAINS 108 CHARACTERS.
004400
004500 01  SORT-REC.
004600     05  SORT-CLASS               PIC X(4).
004700     05  SORT-MATL-CODE           PIC X(8).
004800     05  SORT-DESCR               PIC X(30).
004900     05  SORT-UNIT-MEAS           PIC XX.
005000     05  SORT-RPT-CODE            PIC XX.
005100     05  SORT-ACCOUNT             PIC X(6).
005200     05  SORT-CUR-ACT-COST        PIC S9(6)V9(4).
005300     05  SORT-CUR-ON-HAND-PD      PIC S9(10).
005400     05  SORT-ON-HAND-VALUE       PIC S9(12)V99.
005500     05  SORT-STD-COST            PIC S9(6)V9(4).
005600     05  SORT-UNITS-RCVD-NOT-INV  PIC S9(10).
005700     05  SORT-WD-FLAG             PIC XX.
005800
006000 WORKING-STORAGE SECTION.
006100
006200 77  NO-MORE-SORT                  PIC XXX     VALUE SPACES.
006300 77  LINE-CNT                      PIC 99     VALUE 0.
006400 77  PAGE-CNT                      PIC 9(4)    VALUE 0.
006500 77  PREV-CLASS                    PIC X(4)       VALUE SPACES.
       77  MCXCBLERR-SCOPE               PIC X(1)  VALUE "C".
006600
006700 COPY SOPNRAV IN COPYLIB.
006800
006900 01  CLASS-TOTALS.
007000     05  CLASS-ONHAND-PD           PIC S9(10)  VALUE 0.
007100     05  CLASS-ONHAND-VALUE        PIC S9(12)V99  VALUE 0.
007200     05  CLASS-RCVD-NOT-PAID       PIC S9(10)  VALUE 0.
007300
007400 01  FINAL-TOTALS.
