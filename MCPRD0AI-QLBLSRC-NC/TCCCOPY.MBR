       IDENTIFICATION DIVISION.
       PROGRAM-ID.             TCCCOPY.
      *REMARKS.            *** MACHINE CATALOG FILE DUPLICATE PROGRAM
       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.
       SOURCE-COMPUTER.        IBM-AS400.
       OBJECT-COMPUTER.        IBM-AS400.
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT CORP-CODE-LINK
                  ASSIGN       TO DATABASE-MCFLMM2101
                  ORGANIZATION IS INDEXED
                  ACCESS MODE  IS DYNAMIC
                  RECORD KEY   IS EXTERNALLY-DESCRIBED-KEY
                               WITH DUPLICATES
                  FILE STATUS  IS FILE-STAT.

           SELECT CORP-CODE-LINK-2
                  ASSIGN       TO DATABASE-MCFLMM2101
                  ORGANIZATION IS INDEXED
                  ACCESS MODE  IS DYNAMIC
                  RECORD KEY   IS EXTERNALLY-DESCRIBED-KEY
                               WITH DUPLICATES
                  FILE STATUS  IS FILE-STAT.

           SELECT DISPLAY-FILE
                  ASSIGN       TO WORKSTATION-ZCCLINK-SI
                  ORGANIZATION IS TRANSACTION
                  ACCESS MODE  IS SEQUENTIAL
                  FILE STATUS  IS SCREEN-STATUS
                               MAJOR-MINOR
                  CONTROL-AREA IS SCREEN-CONTROL.

       DATA DIVISION.
       FILE SECTION.
       FD  CORP-CODE-LINK
           LABEL RECORDS ARE STANDARD
           DATA RECORD IS CCLFREC.
       01  CCLFREC.
           COPY DDS-ALL-FORMATS OF MCFLMM2101.

       FD  CORP-CODE-LINK-2
           LABEL RECORDS ARE STANDARD
           DATA RECORD IS CCLF2REC.
       01  CCLF2REC.
           COPY DDS-ALL-FORMATS OF MCFLMM2101.

       FD  DISPLAY-FILE
           LABEL RECORDS ARE OMITTED.
       01  DISPLAY-REC         PIC X(2000).

       WORKING-STORAGE SECTION.
       77  ERROR-BUFFER        PIC X(80).
       77  KEY-HOLD            PIC X(08).
       77  TRUE-VAL            PIC 1 VALUE B"1".

       01  PASSWORD-INFORMATION.
           05  NAME-OF-PROGRAM     PIC X(08) VALUE "TCCCOPY ".
           05  PROGRAM-TYPE        PIC X(02) VALUE "MA".
           05  PROGRAM-RELEASE     PIC X(12) VALUE " E0100010001".
           05  PROGRAM-DESCRIPTION.
               10  PROG-DESC-A.
                   15  FILLER      PIC X(15) VALUE "COPY MODULE OF ".
                   15  FILLER      PIC X(17) VALUE "MMIS SPARE PARTS ".
                   15  FILLER      PIC X(12) VALUE "MAINTENANCE ".
                   15  FILLER      PIC X(16) VALUE "PROGRAM ".
               10  PROG-DESC-B.
                   15  FILLER      PIC X(16) VALUE "CAN COPY LINKED ".
                   15  FILLER      PIC X(17) VALUE "SPARE PARTS INTO ".
                   15  FILLER      PIC X(17) VALUE "ANOTHER SUBSYSTEM".
                   15  FILLER      PIC X(10) VALUE SPACES.
               10  PROG-FUNCTION.
                   15  FILLER      PIC X(17) VALUE "EXECUTES FROM THE".
                   15  FILLER      PIC X(15) VALUE " F6 KEY OF THE ".
                   15  FILLER      PIC X(28) VALUE "SPARE PARTS MENU".
           05  PASSWORD-FLAG       PIC X.

       01  FILE-STAT.
           05 FILE-STAT-1      PIC X   VALUE "0".
           05 FILE-STAT-2      PIC X   VALUE "0".

       01  SCREEN-DATA.
           05  EQUIP-DATA.
               10  E-NUM       PIC X(06).
               10  T-NUM       PIC X(08).
               10  SS-NUM      PIC X(04).
           05  COPY-BUF.
               10  SS-BUF      PIC X(04).
               10  KEY-BUF     PIC X(08).
           05  CMDMSG          PIC X(79).
           05  ERRMSG          PIC X(79).

       01  CORP-CODE-DATA.
           05  HIER-KEY.
               10  HKEY-TYPE   PIC X(08).
               10  HKEY-SS     PIC X(04).
               10  FILLER      PIC X(02).
           05  CC-LINK         PIC X(08).
           05  CC-CMD-LINE     PIC X(79).
           05  CC-ERR-LINE     PIC X(79).

       01  HIER-KEY-KEY.
           05  HIER-KEY-TYPE   PIC X(08).
           05  HIER-KEY-SS     PIC X(04).
           05  FILLER          PIC X(02).

       COPY SCREENIO           IN COPYLIB.

       COPY CATREAD            IN COPYLIB.

       LINKAGE SECTION.
       01  DBPARAMETERS.       COPY DBPARMS OF COPYLIB.
       01  LINK-DATA.
           05  EQP-SUB-LINK.
               10  EQP-NUM-LINK  PIC X(06).
               10  FILLER        PIC X(02).
               10  ESUBSYS-LINK  PIC X(04).
           05  TYPE-SUB-LINK.
               10  TYPE-NUM-LINK PIC X(08).
               10  TSUBSYS-LINK  PIC X(04).

       PROCEDURE DIVISION      USING DBPARAMETERS
                               LINK-DATA.
       CHECK-PASSWORD.
           CALL "TPWORD"       USING DBPARAMETERS.
           IF PASSWORD-FLAG NOT = "N"
               GO TO BEGIN-PROC.
           GOBACK.

       BEGIN-PROC.
           PERFORM 1-HSK.
           PERFORM 6-MAIN THRU 6-WRITE-LOOP UNTIL KEY-HIT = 3.

       END-OF-JOB.
           CLOSE               CORP-CODE-LINK.
           CLOSE               CORP-CODE-LINK-2.
           CLOSE               DISPLAY-FILE.
           GOBACK.

       1-HSK.
           OPEN INPUT          CORP-CODE-LINK.
           OPEN I-O            CORP-CODE-LINK-2.
           OPEN I-O            DISPLAY-FILE.
           MOVE SPACES         TO SCREEN-DATA ERROR-BUFFER.
           MOVE 0              TO KEY-HIT.

       6-MAIN.
           IF IND(99) = TRUE-VAL
               MOVE ERROR-BUFFER TO ERRMSG.
      *M**************************************************************
      *M  MESSAGE:  066/227
      *M  F1-EQP NO.  F2-EQP TYPE  F3-EXIT  F4-SUBSYS  F5-MACH. NOTES
      *M  F6-ADD  F8-DELETE
      *M**************************************************************
           MOVE 66227          TO CATREAD-MSG-NUMBER.
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
           MOVE ERROR-BUFFER   TO CMDMSG.
           MOVE "FCCCOPY"      TO SCREEN-NAME.
           MOVE EQP-NUM-LINK   TO E-NUM.
           MOVE TYPE-NUM-LINK  TO T-NUM.
           MOVE ESUBSYS-LINK   TO SS-NUM.
           IF EQP-NUM-LINK NOT = SPACES
               MOVE EQP-SUB-LINK TO KEY-HOLD
           ELSE
               MOVE TYPE-SUB-LINK TO KEY-HOLD.
           MOVE "00"           TO SCREEN-STATUS.
           MOVE SCREEN-DATA    TO DISPLAY-REC.

           WRITE DISPLAY-REC   FORMAT IS SCREEN-NAME
               INDIC ARE SCREEN-INDICATORS.
           IF SCREEN-STATUS NOT = "00"
               DISPLAY "SCREEN WRITE ERROR.  SCREEN-STATUS IS "
                               SCREEN-STATUS
               GO TO END-OF-JOB.

           READ  DISPLAY-FILE  FORMAT IS SCREEN-NAME
               INDIC ARE SCREEN-INDICATORS
           IF SCREEN-STATUS NOT = "00"
               DISPLAY "SCREEN READ ERROR.  SCREEN-STATUS IS "
                               SCREEN-STATUS
               GO TO END-OF-JOB.

           MOVE ALL B"0"       TO SCREEN-INDICATORS.
           MOVE KEY-HIT        TO FUNC-KEY-NUM.
           MOVE DISPLAY-REC    TO SCREEN-DATA.

           IF KEY-HIT NOT = 0
               GO TO END-OF-JOB.

           MOVE SPACES         TO CMDMSG ERRMSG.
           IF COPY-BUF = SPACES GO TO 6-MAIN.
           IF KEY-BUF = SPACES  MOVE KEY-HOLD TO KEY-BUF.

           IF SS-BUF = SS-NUM AND KEY-BUF = KEY-HOLD
      *M**************************************************************
      *M  MESSAGE:  029/017
      *M  CANNOT COPY SAME TYPE/SUBSYSTEM NUMBER
      *M**************************************************************
               MOVE 29017      TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE TRUE-VAL   TO IND(4) IND(99)
               GO TO 6-MAIN.

           IF SS-BUF NOT NUMERIC
      *M**************************************************************
      *M  MESSAGE:  035/022
      *M  INVALID SUBSYSTEM NUMBER
      *M**************************************************************
               MOVE 35022      TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE TRUE-VAL   TO IND(4) IND(99)
               GO TO 6-MAIN.

           MOVE SPACES         TO CORP-CODE-DATA HIER-KEY-KEY.
           MOVE KEY-BUF        TO HIER-KEY-TYPE.
           MOVE SS-BUF         TO HIER-KEY-SS.
           MOVE HIER-KEY-KEY   TO HIERKEY OF CORP-CODE-LINK.
           START CORP-CODE-LINK KEY = HIERKEY OF CORP-CODE-LINK
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
      *M**************************************************************
      *M  MESSAGE:  040/008
      *M  NO ENTRIES FOR THIS TYPE/SUBSYSTEM
      *M**************************************************************
               MOVE 40008      TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE TRUE-VAL   TO IND(4) IND(99)
               GO TO 6-MAIN.

       6-WRITE-LOOP.
           READ CORP-CODE-LINK NEXT INTO CORP-CODE-DATA
               AT END          MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
               GO TO END-OF-JOB.
           IF HIER-KEY-KEY NOT = HIERKEY OF CORP-CODE-LINK
               GO TO END-OF-JOB.

           MOVE KEY-HOLD       TO HKEY-TYPE.
           MOVE SS-NUM         TO HKEY-SS.

           WRITE CCLF2REC      FROM CORP-CODE-DATA
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
               DISPLAY "ERROR WRITING TO CORP CODE LINK FILE".

           GO TO 6-WRITE-LOOP.

       999-CATREAD.
           MOVE SPACES         TO ERROR-BUFFER.
           CALL "CCATREAD"     USING CATREAD-PARMS.
           MOVE CATREAD-MSG-TEXT TO ERROR-BUFFER.

       999-CATREAD-EXIT.       EXIT.

