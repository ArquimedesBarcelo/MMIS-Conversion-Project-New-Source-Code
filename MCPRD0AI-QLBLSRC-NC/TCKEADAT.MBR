000200 IDENTIFICATION DIVISION.
000300 PROGRAM-ID. TCKEADAT.
000400*REMARKS.    THIS PROGRAM CHECKS THE DREQQUE DATASET AND
      *D           DETERMINES IF THERE ARE REQUISITONS THAT HAVE
      *D           BEEN APPROVED BY ONE USER BUT THE APPROVAL DATE
      *D           IS NOT LOADED INTO THE QUEUED DATE OF THE NEXT
      *D           APPROVER.
      *C
      *C  09/11/96  JEFF BUNGO
      *C    EXPAND DATE FIELDS FOR YEAR 2000 COMPLIANCE.
      *C    INCLUDE CENTURY ON APPROVED DATE.
      *C
000500 ENVIRONMENT DIVISION.
000600 CONFIGURATION SECTION.
000700 SOURCE-COMPUTER. AS400.
000800 OBJECT-COMPUTER. AS400.
       COPY SPECIALN OF COPYLIB.
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT DREQQUE
               ASSIGN TO DATABASE-MCFLCS4401
               ORGANIZATION IS INDEXED
                 ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                 WITH DUPLICATES
               FILE STATUS IS FILE-STATUS.
           SELECT MREQ
               ASSIGN TO DATABASE-MCFLCS2001
               ORGANIZATION IS INDEXED
                 ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
               FILE STATUS IS FILE-STATUS.
           SELECT ONLINE-PRT ASSIGN TO PRINTER-MCPRT.
           SELECT PERSONNEL-FILE
               ASSIGN TO DATABASE-MCFLMM0301
               ORGANIZATION IS INDEXED
               ACCESS IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
               FILE STATUS IS FILE-STATUS.
000900 DATA DIVISION.
       FILE SECTION.
       FD  DREQQUE
           LABEL RECORDS ARE STANDARD.
       01  DREQQUE-REC.
           COPY DDS-MCRPCS4400 OF MCFLCS4401.
       FD  MREQ
           LABEL RECORDS ARE STANDARD.
       01  MREQ-REC.
           COPY DDS-MCRPCS2000 OF MCFLCS2001.
       FD  ONLINE-PRT
           LABEL RECORDS ARE OMITTED
           RECORD CONTAINS 132 CHARACTERS
           DATA RECORD IS PRINT-RCD.
       01  PRINT-RCD.
           05  PRINT-LINE           PIC X(132).
       FD  PERSONNEL-FILE
           LABEL RECORDS ARE STANDARD
           DATA RECORD IS PFREC.
       01  PFREC.
           COPY DDS-ALL-FORMATS OF MCFLMM0301.
001000 WORKING-STORAGE SECTION.
       77  LINE-CTR                 PIC 99.
001300 01  BLOWUP-BASE              PIC X(16).
       01  CDATE.
           05 YY                    PIC 99.
           05 MM                    PIC 99.
           05 DD                    PIC 99.
       COPY DATAB    IN COPYLIB.
       01  DDATE.
           05 DMM                   PIC 99.
           05 FILLER                PIC X      VALUE "/".
           05 DDD                   PIC 99.
           05 FILLER                PIC X      VALUE "/".
           05 DYY                   PIC 99.
001700 COPY DREQQUE  IN COPYLIB.
       01  DETAIL-LINE.
           05  FILLER               PIC X(12) VALUE SPACES.
           05  D-REQ                PIC X(12) VALUE SPACES.
           05  FILLER               PIC XX    VALUE SPACES.
           05  D-LEVEL              PIC XX    VALUE SPACES.
           05  FILLER               PIC XX    VALUE SPACES.
           05  D-APPRVR             PIC X(16) VALUE SPACES.
           05  FILLER               PIC X(34) VALUE SPACES.
       01  FILE-STATUS              PIC XX.
       01  GDATE.
           05 GYY                   PIC 99.
           05 GMM                   PIC 99.
           05 GDD                   PIC 99.
       01  HEADER-0.
           05  FILLER               PIC X(10) VALUE SPACES.
           05  FILLER               PIC X(33)
               VALUE "REQUISITIONS THAT ARE DEADLOCKED ".
           05  FILLER               PIC X(23)
               VALUE "AT A CERTAIN INDIVIDUAL".
           05  FILLER               PIC X(6)  VALUE SPACES.
           05  H0-DATE              PIC X(8)  VALUE SPACES.
       01  HEADER-1.
           05  FILLER               PIC X(12) VALUE SPACES.
           05  FILLER               PIC X(12)
               VALUE "REQUISITION ".
           05  FILLER               PIC XX    VALUE SPACES.
           05  FILLER               PIC XX    VALUE "LV".
           05  FILLER               PIC XX    VALUE SPACES.
           05  FILLER               PIC X(19)
               VALUE "HUNG UP AT APPROVER".
           05  FILLER               PIC X(31) VALUE SPACES.
       01  HEADER-U.
           05  FILLER               PIC X(80) VALUE ALL "-".
       01  JDATE.
           05 JYY                   PIC 99.
           05 JDDD                  PIC 999.
       COPY IOFEEDBACK IN COPYLIB.
003800 COPY LANGSUB    IN COPYLIB.
004400 COPY MREQ IN COPYLIB.
       COPY OVRPFDATA IN COPYLIB.
       01  REQ-ARG                  PIC X(12).
       01  PERSONNEL-DATA.          COPY MPERSONL IN COPYLIB.
       01  SAVE-BUF-DREQQUE.
           05  SAVE-DRQQ-REQ-NUMBER   PIC X(12).
           05  SAVE-DRQQ-EMPL-QUEUED  PIC X(4).
           05  FILLER                 PIC XX.
           05  SAVE-DRQQ-QUEUED-DATE-CN.
               10  SAVE-DRQQ-Q-DATE-CC PIC X(2).
               10  SAVE-DRQQ-QUEUED-DATE  PIC X(6).
           05  SAVE-DRQQ-APPROVE-DATE-CN.
               10  SAVE-DRQQ-A-DATE-CC PIC X(2).
           05  SAVE-DRQQ-APPROVE-DATE PIC X(6).
           05  FILLER                 PIC X(82).
           05  SAVE-DRQQ-LEVEL-NUM    PIC XX.
           05  FILLER                 PIC X(36).
004900 COPY TBLOWUP    IN COPYLIB.
       COPY TDATECHK   IN COPYLIB.
       COPY VCOMLINK   IN COPYLIB.
005200 PROCEDURE DIVISION.
005300 START-PGM.
005400     PERFORM 1-HSK.
005500     PERFORM 6-MAIN THRU 6-MAIN-X.
005600 2-EOJ.
           CLOSE DREQQUE.
           CLOSE MREQ.
           CLOSE PERSONNEL-FILE.
           CLOSE ONLINE-PRT.
006000     GOBACK.
023200 2-BLOWUP.
023300     MOVE "TCKEADAT" TO BU-PGM-NAME.
023400     CALL "TBLOWUP" USING BLOWUP-BASE BU-PGM-NAME STATUS-AREA
023500                      VIEW-COMAREA DUMMY-KSAM-STAT
023600                      BU-DISPLAY-MSG BU-DISPLAY-FLDS.
006100 1-HSK.
           OPEN INPUT  DREQQUE.
           OPEN INPUT  MREQ.
           OPEN INPUT  PERSONNEL-FILE.
           MOVE "MCPRT"        TO OVRPRTF-FILE.
           PERFORM 996-OVERRIDE-PRINT-FILE.
           OPEN OUTPUT ONLINE-PRT.
           ACCEPT CDATE        FROM DATE.
           MOVE MM             TO DMM.
           MOVE DD             TO DDD.
           MOVE YY             TO DYY.
           MOVE DDATE          TO H0-DATE.
           MOVE 59 TO LINE-CTR.
       6-MAIN.
           MOVE 0 TO COND-WORD.
           READ MREQ NEXT INTO BUF-MREQ
               AT END    MOVE 11 TO COND-WORD.
           IF FILE-STATUS NOT = "00" MOVE 11 TO COND-WORD.
           IF COND-WORD = 11 GO TO 6-MAIN-X.
           IF REQ-RELEASE-STAT = "XX" OR "X " GO TO 6-MAIN.
           IF REQ-STATUS = "SS" GO TO 6-MAIN.
           IF REQ-APPROVALS-LEFT = "  " GO TO 6-MAIN.
           IF REQ-APPROVALS-LEFT-9 = 0 GO TO 6-MAIN.
           MOVE MREQ-NUMBER TO REQ-ARG.
           MOVE SPACES TO SAVE-BUF-DREQQUE.
           PERFORM 60-CHECK-DREQQUE THRU 60-CD-X.
           GO TO 6-MAIN.
014100 6-MAIN-X.    EXIT.

       60-CHECK-DREQQUE.
           MOVE 0 TO COND-WORD.
           MOVE REQ-ARG TO REQNO OF DREQQUE-REC.
           START DREQQUE KEY > EXTERNALLY-DESCRIBED-KEY
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF FILE-STATUS NOT = "00" MOVE 17 TO COND-WORD.
           IF COND-WORD = 17 GO TO 60-CD-X.
       60-CD-LOOP.
           READ DREQQUE NEXT INTO BUF-DREQQUE
               AT END    MOVE 15 TO COND-WORD.
           IF FILE-STATUS NOT = "00" MOVE 15 TO COND-WORD.
           IF DRQQ-REQ-NUMBER NOT = REQ-ARG MOVE 15 TO COND-WORD.
032300     IF COND-WORD NOT = 0
032400         IF COND-WORD = 15
                   MOVE SPACES TO SAVE-BUF-DREQQUE, D-REQ,
                       D-LEVEL, D-APPRVR
032500             GO TO 60-CD-X
032600         ELSE
032700         MOVE "READ DREQQUE *TCKEADAT*" TO BU-DISPLAY-MSG
032800         GO TO 2-BLOWUP.
           IF DRQQ-EMPL-QUEUED = "WOAP" GO TO 60-CD-LOOP.
           IF DRQQ-LEVEL-NUM = "00" GO TO 60-CD-LOOP.
           IF DRQQ-EQ-ST = "X "
               MOVE BUF-DREQQUE TO SAVE-BUF-DREQQUE
               GO TO 60-CD-LOOP.
           IF SAVE-BUF-DREQQUE = SPACES GO TO 60-CD-LOOP.
           IF DRQQ-QUEUED-DATE-CN >= SAVE-DRQQ-APPROVE-DATE-CN
               GO TO 60-CD-X.
           MOVE SAVE-DRQQ-REQ-NUMBER TO D-REQ.
           MOVE SAVE-DRQQ-LEVEL-NUM  TO D-LEVEL.
           PERFORM 600-GET-CC-NAME.
           ADD 1 TO LINE-CTR.
           IF LINE-CTR > 59
               PERFORM 69-WRITE-HEADERS.
           WRITE PRINT-RCD FROM DETAIL-LINE AFTER ADVANCING 1.
           MOVE SPACES TO SAVE-BUF-DREQQUE, D-REQ, D-LEVEL,
               D-APPRVR.
       60-CD-X.    EXIT.

       600-GET-CC-NAME.
           MOVE 0 TO COND-WORD.
           MOVE SAVE-DRQQ-EMPL-QUEUED TO PERCCNUM OF PFREC.
           READ PERSONNEL-FILE INTO PERSONNEL-DATA
               AT END    MOVE 15 TO COND-WORD.
           IF FILE-STATUS NOT = "00" MOVE 15 TO COND-WORD.
           MOVE PER-EMP-NAME TO D-APPRVR.

       69-WRITE-HEADERS.
           MOVE 0 TO LINE-CTR.
           WRITE PRINT-RCD FROM HEADER-0 AFTER ADVANCING NEW-PAGE.
           WRITE PRINT-RCD FROM HEADER-1 AFTER ADVANCING 2 LINES.
           WRITE PRINT-RCD FROM HEADER-U AFTER ADVANCING 1 LINES.
           MOVE 4 TO LINE-CTR.

       COPY OVRPFCALL IN COPYLIB.
