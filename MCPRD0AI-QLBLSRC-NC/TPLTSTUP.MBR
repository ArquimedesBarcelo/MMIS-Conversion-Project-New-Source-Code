       IDENTIFICATION DIVISION.
       PROGRAM-ID.     TPLTSTUP.
       AUTHOR.         ANNETTE M. KRAUSS.
       INSTALLATION.   THE GOODYEAR TIRE AND RUBBER COMPANY - AKRON.
       DATE-WRITTEN.   FEBRUARY 1986.
      *REMARKS.
      **************************************************************
      *                                                            *
      *D   TPLTSTUP                PLANT SETUP MAIN PROGRAM        *
      *                                                            *
      *D    THIS PROGRAM IS USED TO INITIALLY LOAD THE             *
      *D    STORES DATA BASE FOR STARTUP ON CSIS. THE FIELDS       *
      *D    LOADED ARE NECESSARY FOR MANY OF THE CSIS              *
      *D    PROGRAMS TO RUN.  THE FOLLOWING DATA IS LOADED.        *
      *D                                                           *
      *D      1. PLANT ADDRESS (PRINTS ON ALL POs)                 *
      *D      2. VARIOUS ENTRIES IN THE DATA SET MPLTINFO          *
      *D         THAT ARE NEEDED FOR MANY OF THE CSIS              *
      *D         PROGRAMS TO WORK.                                 *
      *D      3. VALID UNIT OF MEASURES (PUT IN MVALIDUM)          *
      *D      4. VALID CURRENCY CODES   (PUT IN MVALIDUM)          *
      *D      5. REQUISITION HOLD CODES (PUT IN MVALIDPLTDATA)     *
      *D      6. ENTRIES NEEDED IN 'MWRKLIST', 'MPORCV',           *
      *D                           'MBUYER', 'MSTORERM'            *
      *D                                                           *
      *D    SUBPROGRAMS CALLED :                                   *
      *D                                                           *
      *D           1.  SBUYCODE  ---  BUYER CODE SUBPROGRAM        *
      *D           2.  SFOBCODE  ---  FOB   CODE SUBPROGRAM        *
      *D           3.  SCURCODE  ---  CURRENCY CODE SUBPROGRAM     *
      *D           4.  SPAYTERM  ---  PAYMENT  TERM SUBPROGRAM     *
      *D           5.  SUNMEAS   ---  UNIT OF MEASURES SUBPROGRAM  *
      *D           6.  SCURHELP  ---  CURRENCY CODE HELP SCREEN    *
      *D           7.  SPOMENU   ---  PURCHASING MENU              *
      *D           8.  SFLLOWUP  ---  PURCHASING STND FOLLOWUPS    *
      *D           9.  SDCKINFO  ---  DOCK INFORMATION             *
      *D          10.  SMSCINFO  ---  MISC. INFORMATION            *
      *D          11.  SPRTINFO  ---  GENERAL PRINTER INFORMATION  *
      *D          12.  SQTEINFO  ---  QUOTE INFORMATION            *
      *D          13.  SREQHOLD  ---  REQ. HOLD STATUSES           *
      *D          14.  SSTDINST  ---  STND INSTRUCTIONS            *
      *D          15.  SUSEROPT  ---  USER OPTIONS                 *
      *D          16.  SPLTMULS  ---  MULTIPLE STOREROOM OPTIONS   *
      *D          17.  SPLTSYSO  ---  SYSTEM OPTIONS: AKRON UPDATE *
      *D                                                           *
      **************************************************************
      *C  06/06/96    JEFF BUNGO
      *C     EXPANDED DATE FIELDS FOR YEAR 2000 COMPLIANCE.
      *C     RECOMPILE TO PICK UP NEW FILE FORMATS AS WELL AS
      *C     WELL AS MOVE ADDITIONAL ZEROS FOR THE IV0000 KEY
      *C     OF MWRKLIST.

       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.
       SOURCE-COMPUTER.  IBM-AS400.
       OBJECT-COMPUTER.  IBM-AS400.
       SPECIAL-NAMES. I-O-FEEDBACK IS I-O-FEEDBACK-AREA.

       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT DISPLAY-FILE
                  ASSIGN TO WORKSTATION-ZPLTSTUP-SI
                  ORGANIZATION IS TRANSACTION
                  ACCESS IS SEQUENTIAL
                  FILE STATUS IS DISPLAY-STATUS
                  CONTROL-AREA IS WS-CONTROL.
           SELECT MPLTINFO-O
                  ASSIGN TO DATABASE-MCFLCS0501
                  ORGANIZATION IS INDEXED
                    ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                  FILE STATUS IS FILE-STATUS.
           SELECT MVALIDUM-O
                  ASSIGN TO DATABASE-MCFLCS0401
                  ORGANIZATION IS INDEXED
                    ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                    WITH DUPLICATES
                  FILE STATUS IS FILE-STATUS.
           SELECT MWRKLIST-O
                  ASSIGN TO DATABASE-MCFLCS0301
                  ORGANIZATION IS INDEXED
                    ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                  FILE STATUS IS FILE-STATUS.
           SELECT MPORCV-O
                  ASSIGN TO DATABASE-MCFLCS0101
                  ORGANIZATION IS INDEXED
                    ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                  FILE STATUS IS FILE-STATUS.
           SELECT MBUYER-O
                  ASSIGN TO DATABASE-MCFLCS0601
                  ORGANIZATION IS INDEXED
                    ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                  FILE STATUS IS FILE-STATUS.
           SELECT MSTORERM-O
                  ASSIGN TO DATABASE-MCFLCS0201
                  ORGANIZATION IS INDEXED
                    ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                  FILE STATUS IS FILE-STATUS.
           SELECT MVALDPLT-O
                  ASSIGN TO DATABASE-MCFLCS1701
                  ORGANIZATION IS INDEXED
                    ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                  FILE STATUS IS FILE-STATUS.
           SELECT USAGEFILE
                  ASSIGN TO DATABASE-MCFLCSUSAG
                  ORGANIZATION IS INDEXED
                    ACCESS MODE IS DYNAMIC
                  RECORD KEY IS K-CORP-CODE
                  FILE STATUS IS FILE-STATUS.
           SELECT DCURCODE-FILE
                  ASSIGN TO DATABASE-MCFPCSCUCD
                    ACCESS MODE IS SEQUENTIAL
                  FILE STATUS IS FILE-STATUS.
       DATA DIVISION.
       FILE SECTION.
       FD  DISPLAY-FILE
           LABEL RECORDS ARE OMITTED.
       01  DISPLAY-REC         PIC X(2000).
       FD  MPLTINFO-O
           LABEL RECORDS ARE STANDARD.
       01  MPLTINFO-O-REC.
           COPY DDS-MCRPCS0500  OF MCFLCS0501.
       FD  MVALIDUM-O
           LABEL RECORDS ARE STANDARD.
       01  MVALIDUM-O-REC.
           COPY DDS-MCRPCS0400  OF MCFLCS0401.
       FD  MWRKLIST-O
           LABEL RECORDS ARE STANDARD.
       01  MWRKLIST-O-REC.
           COPY DDS-MCRPCS0300  OF MCFLCS0301.
       FD  MPORCV-O
           LABEL RECORDS ARE STANDARD.
       01  MPORCV-O-REC.
           COPY DDS-MCRPCS0100  OF MCFLCS0101.
       FD  MBUYER-O
           LABEL RECORDS ARE STANDARD.
       01  MBUYERT-O-REC.
           COPY DDS-MCRPCS0600  OF MCFLCS0601.
       FD  MSTORERM-O
           LABEL RECORDS ARE STANDARD.
       01  MSTORERM-O-REC.
           COPY DDS-MCRPCS0200  OF MCFLCS0201.
       FD  MVALDPLT-O
           LABEL RECORDS ARE STANDARD.
       01  MVALDPLT-O-REC.
           COPY DDS-MCRPCS1700  OF MCFLCS1701.
       FD  DCURCODE-FILE
           LABEL RECORDS ARE STANDARD.
       01  DCURCODE-REC.
           05  DCURCODE-KEY             PIC XX.
           05  DCURCODE-DESCRIPTION     PIC X(12).
       FD  USAGEFILE
           LABEL RECORDS ARE STANDARD.
       01  USAGE-REC.
           05  FILLER                   PIC XX.
           05  K-CORP-CODE              PIC X(8).
           05  K-BUCKETS                OCCURS 14 TIMES.
               10  K-BUCKET             PIC S9(9) COMP-4.
           05  K-BUCKETS-DD             OCCURS 14 TIMES.
               10  K-BUCKET-DD          PIC S9(9) COMP-4.


       WORKING-STORAGE SECTION.
       77  EOF-SW                     PIC X(1)   VALUE "N".
       01  SAVE-VERSION               PIC X(6)   VALUE SPACES.
       01  BASE                       PIC X(10)  VALUE "  STORES;".
       01  FILE-STATUS.
           05  FILE-STATUS-1          PIC X(1)   VALUE SPACES.
           05  FILE-STATUS-2          PIC X(1)   VALUE SPACES.
       01  COMMAND-AREA.
           05  OVERRIDE-ZPLTSTUP     PIC X(34)    VALUE
               "OVRDSPF FILE(ZPLTSTUP) SHARE(*YES)".
           05  OVERRIDE-PARM2        PIC S9(10)V9(5) COMP-3 VALUE 34.
      ********************************************
      *                                          *
      *  DATE/TIME AREAS                         *
      *                                          *
      ********************************************

       01  TODAY-DATE.
           05  YY                     PIC XX.
           05  MM                     PIC XX.
           05  DD                     PIC XX.
      ********************************************
      *                                          *
      *  DATABASE BUFFER AREAS                   *
      *                                          *
      ********************************************

       COPY MPLTINFO IN COPYLIB.

       COPY MPLTTAPE IN COPYLIB.

       COPY MPLTRQRL IN COPYLIB.

       COPY MVALIDUM IN COPYLIB.

       COPY MBUYER IN COPYLIB.

       COPY MWRKLIST IN COPYLIB.

       COPY MPORCV IN COPYLIB.

       COPY MVALDPLT IN COPYLIB.

       COPY MSTORERM IN COPYLIB.

       01  ARG-VALUES.
           05  MPLTINFO-ARG           PIC X(4).
           05  MBUYER-ARG             PIC X(4).
           05  MVALIDUM-ARG           PIC X(2).
           05  MVALDPLT-ARG           PIC X(10).


       01  MESSAGE-BUFLEN             PIC S9(4)  COMP-4 VALUE 76.
       01  MESSAGE-ACTLEN             PIC S9(4)  COMP-4 VALUE 76.
       01  FIELD-NUMBER               PIC S9(4)  COMP-4 VALUE 1.

       01  TABLE-ARGUMENTS.
           05  PLT-SUB                PIC 9(4)   VALUE 0 COMP-4.
           05  UM-SUB                 PIC 9(4)   VALUE 0 COMP-4.
           05  PLTDATA-SUB            PIC 9(4)   VALUE 0 COMP-4.

       01  MESSAGE-BUFFER.
           05  MSG-TEXT               PIC X(64)  VALUE SPACES.
           05  MSG-FLD                PIC X(12)  VALUE SPACES.
           05  MSG-FLD-9 REDEFINES MSG-FLD
                                      PIC Z(11)9.
       01  MPLTINFO-TABLE.
           05  FILLER  PIC X(4)  VALUE "P 02".
           05  FILLER  PIC X(30) VALUE "00000                         ".
           05  FILLER  PIC X(30) VALUE "                              ".
           05  FILLER  PIC X(4)  VALUE "PREQ".
           05  FILLER  PIC X(30) VALUE "000100                        ".
           05  FILLER  PIC X(30) VALUE "                              ".
           05  FILLER  PIC X(4)  VALUE "NREQ".
           05  FILLER  PIC X(30) VALUE "000100                        ".
           05  FILLER  PIC X(30) VALUE "                              ".
           05  FILLER  PIC X(4)  VALUE "PQNO".
           05  FILLER  PIC X(30) VALUE "8405010000                    ".
           05  FILLER  PIC X(30) VALUE "                              ".
           05  FILLER  PIC X(4)  VALUE "PSTR".
           05  FILLER  PIC X(30) VALUE "0000                          ".
           05  FILLER  PIC X(30) VALUE "                              ".
           05  FILLER  PIC X(4)  VALUE "PREG".
           05  FILLER  PIC X(30) VALUE "00000                         ".
           05  FILLER  PIC X(30) VALUE "                              ".
           05  FILLER  PIC X(4)  VALUE "PSQR".
           05  FILLER  PIC X(30) VALUE "00000                         ".
           05  FILLER  PIC X(30) VALUE "                              ".
           05  FILLER  PIC X(4)  VALUE "*006".
           05  FILLER  PIC X(30) VALUE "9900                          ".
           05  FILLER  PIC X(30) VALUE "                              ".
           05  FILLER  PIC X(4)  VALUE "PMAN".
           05  FILLER  PIC X(30) VALUE "101850101RLSE00000000000000000".
           05  FILLER  PIC X(30) VALUE "000TEST3 101                  ".
           05  FILLER  PIC X(4)  VALUE "PCE1".
           05  FILLER  PIC X(30) VALUE "120   000120   000116051000120".
           05  FILLER  PIC X(30) VALUE "   000217212150               ".
           05  FILLER  PIC X(4)  VALUE "PCE2".
           05  FILLER  PIC X(30) VALUE "120   000120   000120   000641".
           05  FILLER  PIC X(30) VALUE "000000120206000               ".

       01  MPLTINFO-ENTRIES    REDEFINES   MPLTINFO-TABLE.
           05  MPLTINFO-ENTRY  OCCURS  11  TIMES.
               10  MPLT-KEY            PIC X(4).
               10  MPLT-DATA           PIC X(60).

       01  MVALIDPLTDATA-TABLE.
           05  FILLER  PIC X(20) VALUE "SMC       MTL. CTL. ".
           05  FILLER  PIC X(20) VALUE "SQU       QUOTE     ".
           05  FILLER  PIC X(20) VALUE "SBD       PURCHASING".
           05  FILLER  PIC X(20) VALUE "SEA       ENG. APPR.".
           05  FILLER  PIC X(20) VALUE "SRQ       MIN. REQ. ".
           05  FILLER  PIC X(20) VALUE "SMR       MAINT. REP".
           05  FILLER  PIC X(20) VALUE "SDR       DRAWING   ".

       01  MVALIDPLTDATA-ENTRIES REDEFINES MVALIDPLTDATA-TABLE.
           05  MVALIDPLTDAT-ENTRY OCCURS 7 TIMES.
               10  MVPLTDATA-KEY       PIC X(10).
               10  MVPLTDATA-DESC      PIC X(10).

      *************************************************************
      *************************************************************
      **                                                         **
      **                 TERMINAL I/O DATA AREA                  **
      **                                                         **
      *************************************************************
      *************************************************************

       01  MAIN-MENU-SCREEN.
           05  RELEASE-VERSION           PIC X(6).
           05  PLANT-INFORMATION         PIC X(1).
           05  QUOTE-INFORMATION         PIC X(1).
           05  PURCHASING-MENU           PIC X(1).
           05  STANDARD-INSTRUCTIONS     PIC X(1).
           05  DOCK-INFORMATION          PIC X(1).
           05  STOREROOM-DEPTS           PIC X(1).
           05  REQ-HOLD-STATUSES         PIC X(1).
           05  USER-OPTIONS              PIC X(1).
           05  PRINTER-OPTIONS           PIC X(1).
           05  MULTIPLE-STOREROOM        PIC X(1).
           05  MISCELLANEOUS             PIC X(1).
           05  SYSTEM-OPTIONS            PIC X(1).
           05  CMD-LINE                  PIC X(79).
           05  MSG-LINE                  PIC X(79).

       COPY TBLOWUP    IN COPYLIB.
       COPY LANGUAGE   IN COPYLIB.
       COPY CATREAD    IN COPYLIB.
       COPY DISPDATA   IN COPYLIB.
       COPY IOFEEDBACK IN COPYLIB.
       COPY VCOMAREA   IN COPYLIB.
       COPY DBSTAT     IN COPYLIB.

      *************************************************************
      **#########################################################**
      *************************************************************
      **                                                         **
      **          P R O C E D U R E    D I V I S I O N           **
      **                                                         **
      *************************************************************
      **#########################################################**
      *************************************************************

       PROCEDURE DIVISION.

       MAIN-PGM SECTION 01.

       BEGIN-HERE.
           PERFORM 1-HSK  THRU 1-HSK-X.
           PERFORM 6-MAIN THRU 6-MAIN-X.
           PERFORM 2-EOJ  THRU 2-EOJ-X.
           GOBACK.

       1-HSK.
           MOVE "TPLTSTUP" TO BU-PGM-NAME.

           CALL "QCMDEXC" USING OVERRIDE-ZPLTSTUP, OVERRIDE-PARM2.
           OPEN I-O DISPLAY-FILE, MPLTINFO-O, MVALIDUM-O, MWRKLIST-O,
                    MPORCV-O, MBUYER-O, MVALDPLT-O, MSTORERM-O,
                    USAGEFILE.
           OPEN INPUT DCURCODE-FILE.
           ACCEPT TODAY-DATE FROM DATE.
           PERFORM 3-INITIAL-LOADS THRU 3-INITIAL-LOADS-X.
           PERFORM 3-KSAM          THRU 3-KSAM-X.

       1-HSK-X.
           EXIT.

       3-KSAM.
           MOVE "00000000" TO K-CORP-CODE.
           READ USAGEFILE.
           IF FILE-STATUS-1 = "2"
      **************************************************************
      **   WRITE THE "00000000" KEY RECORD IN THE KSAM FILE.      **
      **************************************************************
               MOVE MM            TO  K-BUCKET (1)
               MOVE 0  TO K-BUCKET (2) K-BUCKET (3) K-BUCKET (4)
                          K-BUCKET (5) K-BUCKET (6) K-BUCKET (7)
                          K-BUCKET (8) K-BUCKET (9) K-BUCKET (10)
                          K-BUCKET (11) K-BUCKET (12)
                          K-BUCKET (13) K-BUCKET (14)
                WRITE USAGE-REC
                IF FILE-STATUS NOT = "00"
                    MOVE "WRITE USAGE 00000000 RECORD"
                        TO BU-DISPLAY-MSG
                    GO TO 2-BLOWUP
                ELSE
                    NEXT SENTENCE
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE "READ USAGE 0000000 RECORD"
                   TO BU-DISPLAY-MSG
               GO TO 2-BLOWUP
           ELSE
      *------- DO A START > HIGH-VALUES TO UNLOCK
               MOVE HIGH-VALUES TO K-CORP-CODE
               START USAGEFILE  KEY > K-CORP-CODE
                   INVALID KEY MOVE "00" TO FILE-STATUS.

       3-KSAM-X.
           EXIT.


       2-EOJ.
           CLOSE    DISPLAY-FILE, MPLTINFO-O, MVALIDUM-O, MWRKLIST-O,
                    MPORCV-O, MBUYER-O, MVALDPLT-O, MSTORERM-O,
                    USAGEFILE, DCURCODE-FILE.

       2-EOJ-X.
            EXIT.

      ******************************************************
      **                 BLOWUP ROUTINE                   **
      ******************************************************

       2-BLOWUP.
           CALL "TBLOWUP" USING BASE, BU-PGM-NAME, STATUS-AREA,
                 VIEW-COMAREA, FILE-STATUS, BU-DISPLAY-MSG,
                 BU-DISPLAY-AREA.

      ******************************************************
      **              INITIAL DATABASE LOADS              **
      ******************************************************

       3-INITIAL-LOADS.
           PERFORM 31-LOAD-PLANT-INFO-SEG     THRU 31-LPIS-EXIT.
           PERFORM 321-READ-DCURCODE-FILE THRU 321-RDF-EXIT.
           PERFORM 32-LOAD-CURRENCY-SEG       THRU 32-LCS-EXIT.
           PERFORM 33-LOAD-MWRKLIST-SEG       THRU 33-LWLS-EXIT.
           PERFORM 34-LOAD-MPORCV-MBUYER-SEG  THRU 34-LMMS-EXIT.
           PERFORM 35-LOAD-MVALIDPLTDATA-SEG  THRU 35-LMPS-EXIT.
           PERFORM 36-LOAD-MSTORERM-SEG       THRU 36-LMSS-EXIT.
       3-INITIAL-LOADS-X.
           EXIT.

       31-LOAD-PLANT-INFO-SEG.
           ADD          1           TO PLT-SUB.
           MOVE SPACES              TO BUF-MPLTINFO.
           MOVE MPLT-KEY  (PLT-SUB) TO MPLTINFO-KEY.
           MOVE MPLT-DATA (PLT-SUB) TO MPLTINFO-DATA.
           WRITE MPLTINFO-O-REC FROM BUF-MPLTINFO.
           IF FILE-STATUS NOT = "00" AND FILE-STATUS-1 NOT = "2"
               MOVE "WRT MPLTINFO ERROR IN 31-LOAD-PLANT-INFO-SEG"
                   TO BU-DISPLAY-MSG
               MOVE MPLT-KEY (PLT-SUB) TO BU-DISPLAY-FLD (1)
               GO TO 2-BLOWUP.
           IF PLT-SUB > 10
               GO TO 31-LPIS-EXIT
           ELSE
               GO TO 31-LOAD-PLANT-INFO-SEG.

       31-LPIS-EXIT.
           EXIT.

       32-LOAD-CURRENCY-SEG.
           MOVE DCURCODE-KEY TO MVALIDUM-ARG.
           MOVE MVALIDUM-ARG TO VALIDUM OF MVALIDUM-O-REC.
           READ MVALIDUM-O INTO BUF-MVALIDUM.
           IF FILE-STATUS-1 = "2"
               MOVE SPACES               TO BUF-MVALIDUM
               MOVE DCURCODE-KEY         TO VALID-UM
               MOVE DCURCODE-DESCRIPTION TO VALID-CURRENCY-DESC
               WRITE MVALIDUM-O-REC FROM BUF-MVALIDUM
           ELSE
           IF FILE-STATUS = "00"
               IF DCURCODE-DESCRIPTION = VALID-CURRENCY-DESC
                   NEXT SENTENCE
               ELSE
                   MOVE DCURCODE-DESCRIPTION TO VALID-CURRENCY-DESC
                   REWRITE MVALIDUM-O-REC FROM BUF-MVALIDUM
           ELSE
               MOVE "READ MVALIDUM ERR 32-LOAD-CURRENCY-SEG"
                   TO BU-DISPLAY-MSG
               MOVE DCURCODE-KEY TO BU-DISPLAY-FLD (1)
               GO TO 2-BLOWUP.

           IF FILE-STATUS NOT = "00"
               MOVE "W/RW MVALIDUM ERR 32-LOAD-CURRENCY-SEG"
                   TO BU-DISPLAY-MSG
               MOVE DCURCODE-KEY TO BU-DISPLAY-FLD (1)
               GO TO 2-BLOWUP.
           PERFORM 321-READ-DCURCODE-FILE THRU 321-RDF-EXIT.
           IF EOF-SW = "N"
               GO TO 32-LOAD-CURRENCY-SEG.
      *------- DO A START > HIGH-VALUES TO UNLOCK
           MOVE HIGH-VALUES TO VALIDUM OF MVALIDUM-O-REC.
           START MVALIDUM-O KEY > VALIDUM OF MVALIDUM-O-REC
               INVALID KEY MOVE "00" TO FILE-STATUS.

       32-LCS-EXIT.
           EXIT.

       321-READ-DCURCODE-FILE.
           READ DCURCODE-FILE AT END
              MOVE "Y" TO EOF-SW.

           IF DCURCODE-KEY = "**"
               GO TO 321-READ-DCURCODE-FILE.

       321-RDF-EXIT.
           EXIT.


       33-LOAD-MWRKLIST-SEG.
           MOVE SPACES              TO BUF-MWRKLIST.
           MOVE "ST0000"            TO WRKLIST-KEY
                                       WRKLIST-DATE.
           WRITE MWRKLIST-O-REC FROM BUF-MWRKLIST.
           IF FILE-STATUS NOT = "00" AND FILE-STATUS-1 NOT = "2"
               MOVE "WRT MWRKLIST ERR IN 33-LOAD-MWRKLIST-SEG"
                   TO BU-DISPLAY-MSG
               MOVE "ST0000" TO BU-DISPLAY-FLD (1)
               PERFORM 2-BLOWUP.


           MOVE SPACES              TO BUF-MWRKLIST.
           MOVE "SW0000"            TO WRKLIST-KEY
                                       WRKLIST-DATE.
           WRITE MWRKLIST-O-REC FROM BUF-MWRKLIST.
           IF FILE-STATUS NOT = "00" AND FILE-STATUS-1 NOT = "2"
               MOVE "WRT MWRKLIST ERR IN 33-LOAD-MWRKLIST-SEG"
                   TO BU-DISPLAY-MSG
               MOVE "ST0000" TO BU-DISPLAY-FLD (1)
               PERFORM 2-BLOWUP.

           MOVE SPACES              TO BUF-MWRKLIST.
           MOVE "IV0000"            TO WRKLIST-KEY.
      *C CHANGED FOR INCREASE IN FIELD, MOVE ADDITIONAL ZEROS
           MOVE "000000"            TO WRKLIST-DATE-CN.
           WRITE MWRKLIST-O-REC FROM BUF-MWRKLIST.
           IF FILE-STATUS NOT = "00" AND FILE-STATUS-1 NOT = "2"
               MOVE "WRT MWRKLIST ERR IN 33-LOAD-MWRKLIST-SEG"
                   TO BU-DISPLAY-MSG
               MOVE "ST0000" TO BU-DISPLAY-FLD (1)
               PERFORM 2-BLOWUP.

       33-LWLS-EXIT.
           EXIT.

       34-LOAD-MPORCV-MBUYER-SEG.
           MOVE SPACES     TO  BUF-MPORCV.
           WRITE MPORCV-O-REC FROM BUF-MPORCV.
           IF FILE-STATUS NOT = "00" AND FILE-STATUS-1 NOT = "2"
               MOVE "WRT MPORCV ERROR IN 34-LOAD-MPORCV-MBUYER-SEG"
                   TO BU-DISPLAY-MSG
               MOVE "SPACES" TO BU-DISPLAY-FLD (1)
               PERFORM 2-BLOWUP.

           MOVE SPACES     TO  BUF-MBUYER.
           WRITE MPORCV-O-REC FROM BUF-MPORCV.
           IF FILE-STATUS NOT = "00" AND FILE-STATUS-1 NOT = "2"
               MOVE "WRT MPORCV ERROR IN 34-LOAD-MPORCV-MBUYER-SEG"
                   TO BU-DISPLAY-MSG
               MOVE "SPACES" TO BU-DISPLAY-FLD (1)
               PERFORM 2-BLOWUP.

       34-LMMS-EXIT.
           EXIT.

       35-LOAD-MVALIDPLTDATA-SEG.
           ADD 1                 TO PLTDATA-SUB.
           MOVE SPACES           TO BUF-MVALIDPLTDATA.
           MOVE MVPLTDATA-KEY (PLTDATA-SUB)  TO VALID-DATA-KEY.
           MOVE MVPLTDATA-DESC (PLTDATA-SUB) TO VALID-DATA-DESC.
           WRITE MVALDPLT-O-REC FROM BUF-MVALIDPLTDATA.
           IF FILE-STATUS NOT = "00" AND FILE-STATUS-1 NOT = "2"
               MOVE "WRT MVALDPLT ERR IN 35-LOAD-MVALIDPLTDATA-SEG     "
                   TO BU-DISPLAY-MSG
               MOVE MVPLTDATA-KEY (PLTDATA-SUB) TO BU-DISPLAY-FLD (1)
               PERFORM 2-BLOWUP.
           IF PLTDATA-SUB > 6
               GO TO 35-LMPS-EXIT
           ELSE
               GO TO 35-LOAD-MVALIDPLTDATA-SEG.

       35-LMPS-EXIT.
           EXIT.

       36-LOAD-MSTORERM-SEG.
           MOVE SPACES           TO BUF-MSTORERM.
           MOVE "NON-STR" TO CORP-CODE.
           MOVE ZEROS TO STR-EOQ,
                         STR-REORDER,
                         STR-MAX,
                         STR-EXPEDITE,
                         STR-STD-COST,
                         STR-AVG-COST,
                         STR-PREV-AVG,
                         STR-UM1-CF,
                         STR-UM2-CF,
                         STR-EST-LT,
                         STR-LAST-DLVTIMES (1),
                         STR-LAST-DLVTIMES (2),
                         STR-LAST-DLVTIMES (3),
                         STR-MKT-COST,
                         STR-OUT-REPAIR-COST,
                         STR-MAINT-REPAIR-COST,
                         STR-MTH-FCST,
                         STR-ONHAND,
                         STR-ONORDER,
                         STR-RESERVED,
                         STR-RSRV-ONORD,
                         STR-LOC-ONHAND (1),
                         STR-LOC-ONHAND (2),
                         STR-LOC-ONHAND (3),
                         STR-LOC-ONHAND (4),
                         STR-LOC-ONHAND (5),
                         STR-LOC-ONHAND (6),
                         STR-TAX-PERCENT,
                         STR-SOQ.
           WRITE MSTORERM-O-REC FROM BUF-MSTORERM.
           IF FILE-STATUS NOT = "00" AND FILE-STATUS-1 NOT = "2"
               MOVE "WRT MSTORERM ERROR IN 36-LOAD-MSTORERM-SEG"
                   TO BU-DISPLAY-MSG
               MOVE "NON-STR" TO BU-DISPLAY-FLD (1)
               PERFORM 2-BLOWUP.

       36-LMSS-EXIT.
           EXIT.

      **************************************************
      *                                                *
      *                  6 - M A I N                   *
      *                                                *
      **************************************************

       6-MAIN.
           MOVE "TAPE" TO MPLTINFO-ARG.
           MOVE MPLTINFO-ARG TO PLTINFOKEY OF MPLTINFO-O-REC.
           READ MPLTINFO-O INTO BUF-MPLTINFO.
           IF FILE-STATUS-1 = "2"
               MOVE SPACES TO SAVE-VERSION
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE "DBGET ERROR 6-MAIN"
                                     TO BU-DISPLAY-MSG
               MOVE "TAPE"           TO BU-DISPLAY-FLD (1)
               PERFORM 2-BLOWUP.
           MOVE MPLTINFO-TAPE-RLSE TO SAVE-VERSION.
      *------- DO A START > HIGH-VALUES TO UNLOCK
           MOVE HIGH-VALUES TO PLTINFOKEY OF MPLTINFO-O-REC.
           START MPLTINFO-O KEY > PLTINFOKEY OF MPLTINFO-O-REC
               INVALID KEY MOVE "00" TO FILE-STATUS.

       6-INIT-FORM.
           MOVE SPACES TO MAIN-MENU-SCREEN.
           MOVE SAVE-VERSION TO RELEASE-VERSION.
           MOVE "MAINMENU"   TO VIEW-NFNAME.

       6-MAIN-SHOW-FORM.
           MOVE MAIN-MENU-SCREEN TO DISPLAY-REC.
           PERFORM 998-WRITE-SCREEN THRU 998-READ-SCREEN.
           MOVE DISPLAY-REC      TO MAIN-MENU-SCREEN.

       6-MAIN-READ-FIELDS.
           IF VIEW-LASTKEY = 3
               GO TO 6-MAIN-X.

           IF VIEW-LASTKEY = 1 OR
              VIEW-LASTKEY = 2 OR
              VIEW-LASTKEY = 4 OR
              VIEW-LASTKEY = 5 OR
              VIEW-LASTKEY = 6 OR
              VIEW-LASTKEY = 7 OR
              VIEW-LASTKEY = 8
      *****    INVALID FUNCTION KEY    *****
               MOVE   9 TO LANG-SETNUM
               MOVE  10 TO LANG-MSGNUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER TO MSG-LINE
               MOVE B"1" TO IND(99)
               GO TO 6-MAIN-SHOW-FORM.

       6-GET-BUFFER.
           IF PLANT-INFORMATION = "X"
               CALL "SPLTINFO" USING BASE, VIEW-COMAREA, LANGUAGE-PARMS
           ELSE
           IF QUOTE-INFORMATION = "X"
               CALL "SQTEINFO" USING BASE, VIEW-COMAREA, LANGUAGE-PARMS
           ELSE
           IF USER-OPTIONS = "X"
               CALL "SUSEROPT" USING BASE, VIEW-COMAREA, LANGUAGE-PARMS
           ELSE
           IF DOCK-INFORMATION = "X"
               CALL "SDCKINFO" USING BASE, VIEW-COMAREA, LANGUAGE-PARMS
           ELSE
           IF MISCELLANEOUS = "X"
               CALL "SMSCINFO" USING BASE, VIEW-COMAREA, LANGUAGE-PARMS
           ELSE
           IF STANDARD-INSTRUCTIONS = "X"
               CALL "SSTDINST" USING BASE, VIEW-COMAREA, LANGUAGE-PARMS
           ELSE
           IF PRINTER-OPTIONS = "X"
               CALL "SPRTINFO" USING BASE, VIEW-COMAREA, LANGUAGE-PARMS
           ELSE
           IF PURCHASING-MENU = "X"
               CALL "SPOMENU" USING BASE, VIEW-COMAREA, LANGUAGE-PARMS
           ELSE
           IF REQ-HOLD-STATUSES = "X"
               CALL "SREQHOLD" USING BASE, VIEW-COMAREA, LANGUAGE-PARMS
           ELSE
           IF STOREROOM-DEPTS = "X"
               CALL "SSTRMDPT" USING BASE, VIEW-COMAREA, LANGUAGE-PARMS,
                                     TODAY-DATE
           ELSE
           IF MULTIPLE-STOREROOM = "X"
               CALL "SPLTMULS" USING BASE, VIEW-COMAREA, LANGUAGE-PARMS
           ELSE
           IF SYSTEM-OPTIONS = "X"
               CALL "SPLTSYSO" USING BASE, VIEW-COMAREA, LANGUAGE-PARMS.

           GO TO 6-INIT-FORM.

       6-MAIN-X.
           EXIT.
       COPY DISPCALL IN COPYLIB.

       999-CATREAD.
           IF CATREAD-MSG-NUMBER = ZEROS
               MOVE LANG-SETNUM TO CATREAD-MSG-SET
               MOVE LANG-MSGNUM TO CATREAD-MSG-NUM.
           CALL "CCATREAD" USING CATREAD-PARMS.
           MOVE CATREAD-MSG-TEXT TO MESSAGE-BUFFER.
       999-CATREAD-EXIT.
           EXIT.
