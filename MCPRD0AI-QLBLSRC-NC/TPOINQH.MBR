               ELSE
053500             MOVE "FIND DVENDOR*6-SHC" TO BU-DISPLAY-MSG
053600             GO TO 2-BLOWUP.
053800
           MOVE "Y"                 TO  VEN-FOUND-SW.
           MOVE 0                   TO  VEN-SUB.
           MOVE SPACES              TO  DE-VENDOR-BUFFER.
           MOVE "N"                 TO  VDE-EDI-VENDOR.
           MOVE VEN-ARG             TO  VDE-VENDOR.

053900 6-LOAD-PO-VENDOR.
054000
054100*******************************************
054200**  GET DVENDOR FOR VENDOR NAME AND      **
054300**  CITY, STATE, AND ZIP CODE.           **
054400*******************************************
054500
           READ DVENDOR-I NEXT INTO BUF-DVENDOR
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14"
                   GO TO 6-CHECK-FOR-TRAILERS
               ELSE
056000             MOVE "GET DVENDOR * 6-LPV" TO BU-DISPLAY-MSG
056100             GO TO 2-BLOWUP.
           IF VENCDE OF DVENDOR-REC-I NOT = VEN-ARG
               GO TO 6-CHECK-FOR-TRAILERS.
056200
      *---------- ADDED LOGIC TO FILL IN VENDOR INFO SCREEN WHILE
      *---------- READING THROUGH VENDOR FILE.
056300     IF VEN-ITM-NO EQUAL 00
056400         MOVE VEN-NAME        TO  DE1-VENDOR-NAME
                                        DE1-VENDOR-NAME-E
                                        DE1-VENDOR-NAME-L
                                        DE1-VENDOR-NAME-E-L
                                        VDE-NAME.

            IF VEN-ITM-NO > 00 AND VEN-ITM-NO < 07
                ADD 1               TO  VEN-SUB
                MOVE VEN-ADDRESS    TO  VDE-ADDRESS(VEN-SUB).
056500
056600     IF VEN-ITM-NO EQUAL 07
056700         MOVE VEN-07-RCD      TO  DE1-VENDOR-CSZ
                                        DE1-VENDOR-CSZ-E
                                        DE1-VENDOR-CSZ-L
                                        DE1-VENDOR-CSZ-E-L
               MOVE VEN-CITY        TO  VDE-CITY
               MOVE VEN-STATE-CODE  TO  VDE-STATE
               MOVE VEN-PROV-CODE   TO  VDE-PROVINCE
               MOVE VEN-ZIP         TO  VDE-POSTAL-CODE
               MOVE VEN-ZIP-BEFORE-CITY TO  VDE-ZIP-PLACEMENT.

           IF VEN-ITM-NO EQUAL 08
               MOVE VEN-COUNTRY     TO  VDE-COUNTRY.

           IF VEN-ITM-NO EQUAL 09
               MOVE VEN-CONTACT         TO  VDE-CONTACT
               MOVE VEN-CONTACT-PHONE   TO  VDE-PHONE.

           IF VEN-ITM-NO EQUAL 10
               MOVE VEN-FAX             TO  VDE-FAX
               MOVE VEN-MIN-ORDER       TO  VDE-MIN-ORDER
               MOVE VEN-INVLESS-IND     TO  VDE-INVLESS-IND
               MOVE VEN-TELEX           TO  VDE-TELEX
               MOVE VEN-CC              TO  VDE-CC, UM-ARG
               MOVE UM-ARG TO VALIDUM OF MVALIDUM-REC-I
               READ MVALIDUM-I INTO BUF-MVALIDUM
                   INVALID KEY MOVE "2" TO FILE-STATUS-2
               END-READ
               IF FILE-STATUS NOT = "00"
                 MOVE "????????????"    TO  VDE-CC-DESC
               ELSE
                 MOVE VALID-CURRENCY-DESC TO  VDE-CC-DESC.

           IF VEN-ITM-NO EQUAL 12
               MOVE VEN-12-RCD          TO  VDE-NOTE1.

           IF VEN-ITM-NO EQUAL 13
               MOVE VEN-13-RCD          TO  VDE-NOTE2.

           IF VEN-ITM-NO EQUAL 14
               MOVE "Y"                 TO  VDE-EDI-VENDOR
               MOVE VEN-DOLLAR-MAX      TO  VDE-DOLLAR-MAX
               MOVE VEN-EDIFACT-ID      TO  VDE-EDIFACT-ID
               MOVE VEN-GOODYEAR-CODE   TO  VDE-GOODYEAR-CODE
               MOVE VEN-TRADING-ID      TO  VDE-TRADING-ID
               MOVE VEN-STATUS-IND      TO  VDE-STATUS-IND
               MOVE VEN-EXCODE-IND      TO  VDE-EXCODE-IND.

           IF VEN-ITM-NO EQUAL 16
               MOVE VEN-PO-FOB          TO  VDE-FOB
               MOVE VEN-PO-TERMS        TO  VDE-TERMS.

           IF VEN-ITM-NO EQUAL 17
               MOVE VEN-17-RCD          TO  VDE-INSTRUCTIONS.

056800
056900     GO TO  6-LOAD-PO-VENDOR.
057000
       6-CHECK-FOR-TRAILERS.
           MOVE 0       TO  TRAILERS-IND.
           MOVE PO-ARG  TO  PORCVNO OF DTRAILER-REC-I.
           START DTRAILER-I KEY = EXTERNALLY-DESCRIBED-KEY
               INVALID KEY    MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00" MOVE 1 TO TRAILERS-IND.
068000
057100 6-SHOW-SCREENS.
           IF SEDIVNCK-EDI-IND = "Y"
               IF SAVE-PCPO-SW = "Y"
                   MOVE PO-HEADER1-E-L  TO  VIEW-NFNAME
               ELSE
               MOVE PO-HEADER1-E        TO  VIEW-NFNAME
           ELSE
           IF SAVE-PCPO-SW = "Y"
               MOVE PO-HEADER1-L        TO  VIEW-NFNAME
           ELSE
057200     MOVE PO-HEADER1              TO  VIEW-NFNAME.
057300     PERFORM 61-SHOW-SCREEN-1  THRU  61-SS1-X.
057400     IF VIEW-LASTKEY = 1
               PERFORM 63-SELECT-HEADER2-SCREEN THRU 63-SHS-EXIT
057500         MOVE PO-HEADER2          TO  VIEW-NFNAME
057600         PERFORM 61-SHOW-SCREEN-1  THRU  61-SS1-X
057700         IF VIEW-LASTKEY = 1
057800             GO TO 6-SHOW-SCREENS.
057900
           IF VIEW-LASTKEY = 4
               MOVE VIEW-NFNAME         TO  SAVE-VIEW-NFNAME
               MOVE PO-TRAILER          TO  VIEW-NFNAME
               MOVE 0                   TO  SUB
               MOVE SPACES              TO  DE-TRAILER-BUFFER
               PERFORM 64-DISPLAY-TRAILERS THRU 64-DT-X
               MOVE SAVE-VIEW-NFNAME    TO  VIEW-NFNAME
               MOVE PO-ARG              TO  PORCVNO OF DTRAILER-REC-I
               START DTRAILER-I KEY = EXTERNALLY-DESCRIBED-KEY
               GO TO 6-SHOW-SCREENS.

           IF VIEW-LASTKEY = 5
               MOVE VIEW-NFNAME         TO  SAVE-VIEW-NFNAME
               MOVE VEN-INQ             TO  VIEW-NFNAME
               MOVE SPACES              TO  DISPLAY-REC
               PERFORM 65-DISPLAY-VENDOR THRU 65-DV-X
               MOVE SAVE-VIEW-NFNAME    TO  VIEW-NFNAME
               GO TO 6-SHOW-SCREENS.

058000 6-SHOW-PO-HEADER-X.
058100     EXIT.
058200
058300
058400 61-SHOW-SCREEN-1.
           MOVE  6                  TO LANG-SETNUM.
           MOVE 49                  TO LANG-MSGNUM.
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
           MOVE MESSAGE-BUFFER  TO DE1-COMMAND-LINE-2
                                   DE1-COMMAND-LINE-2-E
                                   DE1-COMMAND-LINE-2-L
                                   DE1-COMMAND-LINE-2-E-L
                                   DE2-COMMAND-LINE-2.
           IF VIEW-NFNAME = PO-HEADER2
               IF TRAILERS-IND = 1
                   MOVE  6          TO LANG-SETNUM
                   MOVE 40          TO LANG-MSGNUM
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE MESSAGE-BUFFER  TO DE2-COMMAND-LINE
               ELSE
               MOVE  6              TO LANG-SETNUM
               MOVE 41              TO LANG-MSGNUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER  TO DE2-COMMAND-LINE
           ELSE
           IF TRAILERS-IND = 1
               MOVE  6              TO LANG-SETNUM
               MOVE 38              TO LANG-MSGNUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER  TO DE1-COMMAND-LINE
                                       DE1-COMMAND-LINE-E
                                       DE1-COMMAND-LINE-L
                                       DE1-COMMAND-LINE-E-L
           ELSE
           MOVE  6                  TO LANG-SETNUM
           MOVE 39                  TO LANG-MSGNUM
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
           MOVE MESSAGE-BUFFER      TO DE1-COMMAND-LINE
                                       DE1-COMMAND-LINE-E
                                       DE1-COMMAND-LINE-L
                                       DE1-COMMAND-LINE-E-L.
060000     IF VIEW-NFNAME  =  PO-HEADER1
               MOVE DE-BUFFER1      TO DISPLAY-REC
060400     ELSE
           IF VIEW-NFNAME  =  PO-HEADER1-E
               MOVE DE-BUFFER1E     TO DISPLAY-REC
           ELSE
           IF VIEW-NFNAME  =  PO-HEADER1-L
               MOVE DE-BUFFER1-L    TO DISPLAY-REC
           ELSE
           IF VIEW-NFNAME  =  PO-HEADER1-E-L
               MOVE DE-BUFFER1E-L   TO DISPLAY-REC
           ELSE
           MOVE DE-BUFFER2          TO DISPLAY-REC.
           PERFORM 998-WRITE-SCREEN THRU 998-READ-SCREEN.
060000     IF VIEW-NFNAME  =  PO-HEADER1
               MOVE DISPLAY-REC TO DE-BUFFER1
060400     ELSE
           IF VIEW-NFNAME = PO-HEADER1-E
               MOVE DISPLAY-REC TO DE-BUFFER1E
           ELSE
           IF VIEW-NFNAME = PO-HEADER1-L
               MOVE DISPLAY-REC TO DE-BUFFER1-L
           ELSE
           IF VIEW-NFNAME = PO-HEADER1-E-L
               MOVE DISPLAY-REC TO DE-BUFFER1E-L
           ELSE
           MOVE DISPLAY-REC     TO DE-BUFFER2.
062900
063000     IF VIEW-LASTKEY EQUAL  1 OR 2 OR 3
063100         GO TO  61-SS1-X
           ELSE
           IF VIEW-LASTKEY = 4
               IF TRAILERS-IND = 0
                   GO TO 61-SS1-X
               ELSE
066100*        ***  INVALID FUNCTION KEY ENTERED  ***
066200         MOVE   9 TO LANG-SETNUM
066300         MOVE  10 TO LANG-MSGNUM
066400         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
066500         MOVE 99  TO  FIELD-NUMBER
066600         PERFORM  73-PGM-ERROR  THRU 73-PGM-ERROR-X
066700         GO TO  61-SHOW-SCREEN-1
           ELSE
           IF VIEW-LASTKEY EQUAL 5
               IF VEN-FOUND-SW = "Y"
                   GO TO  61-SS1-X
               ELSE
      *        ***  VENDOR NOT ON FILE ***
                   MOVE  22 TO LANG-SETNUM
                   MOVE  14 TO LANG-MSGNUM
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE 99  TO  FIELD-NUMBER
                   PERFORM  73-PGM-ERROR  THRU 73-PGM-ERROR-X
                   GO TO  61-SHOW-SCREEN-1
               END-IF
           ELSE
065800     IF VIEW-LASTKEY EQUAL 6  OR
065900        VIEW-LASTKEY EQUAL 7  OR
066000        VIEW-LASTKEY EQUAL 8
066100*        ***  INVALID FUNCTION KEY ENTERED  ***
066200         MOVE   9 TO LANG-SETNUM
066300         MOVE  10 TO LANG-MSGNUM
066400         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
066500         MOVE 99  TO  FIELD-NUMBER
066600         PERFORM  73-PGM-ERROR  THRU 73-PGM-ERROR-X
066700         GO TO  61-SHOW-SCREEN-1.
066800
066900*    ***  PRESS THE DESIRED FUNCTION KEY - NOT 'ENTER'  ***
067000     MOVE  16 TO LANG-SETNUM.
067100     MOVE  30 TO LANG-MSGNUM.
067200     PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
06650      MOVE 99  TO  FIELD-NUMBER.
06660      PERFORM  73-PGM-ERROR  THRU 73-PGM-ERROR-X.
06670      GO TO  61-SHOW-SCREEN-1.
067600
067700 61-SS1-X.
067800     EXIT.
067900
068100 62-GET-STD-INST.
068200     MOVE SPACES  TO  STD-INST-SAVED.
           MOVE PO-ARG  TO PORCVNO OF DPODATAITM-REC-I.
           MOVE "000001" TO ITEMSEQNO OF DPODATAITM-REC-I.
           READ DPODATAITM-I INTO BUF-DPODATAITM
               INVALID KEY MOVE "2" TO FILE-STATUS-1.
           IF FILE-STATUS-1 = "2"
               GO TO 62-GSI-X
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE "READ DPODATAITM 62-GSI" TO BU-DISPLAY-MSG
               GO TO 2-BLOWUP
           ELSE
               MOVE DATAITM-INFO  TO STD-INST-SAVED.

071200     IF SAVE-CONFIRMING-FLAG = "X"
071300         MOVE CONFIRMING-LIT           TO  DE2-CONFIRMLIT
071400     ELSE
071500         MOVE NON-CONFIRMING-LIT       TO  DE2-CONFIRMLIT.
071600     MOVE SAVE-CONFIRM-VERBAGE         TO  DE2-CONFIRM-VERB.
071700     MOVE SAVE-STD-INST-LIST           TO  DE2-STD-INST-LIST.
071800
071900 62-GSI-X.
072000     EXIT.
072100
072200 62-CALCULATE-INVOICE-PAYMENTS.
072300     IF PAYMENTS-CALCULATED
072400         GO TO 62-CIP-X
072500     ELSE
072600         MOVE "Y"  TO  PAYMENTS-CALCULATED-SW.
           MOVE 0 TO COND-WORD.
           MOVE PO-ARG TO PORCVNO OF DINVRCD-REC-I.
           START DINVRCD-I KEY = PORCVNO OF DINVRCD-REC-I
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
                   GO TO 62-CIP-X
               ELSE
073400             MOVE "DBFIND DINVRCD*62-CIP"  TO  BU-DISPLAY-MSG
073500             GO TO 2-BLOWUP.
073600
074000 62-GET-DINVRCD.
           MOVE 0 TO COND-WORD.
           READ DINVRCD-I NEXT INTO BUF-DINVRCD
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14"
                   MOVE 15 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.
           IF PORCVNO OF DINVRCD-REC-I NOT = PO-ARG
               MOVE 15 TO COND-WORD.

074800     IF COND-WORD NOT = ZERO
074900         IF COND-WORD = 15
075000             ADD S-INVOICE-PAYMENTS-AMT  TO
075100                 S-INVOICE-PAYMENTS-ROUND  ROUNDED
075200             MOVE S-INVOICE-PAYMENTS-ROUND  TO
075300                  DE2-INV-PAYMENTS
075400             SUBTRACT S-INVOICE-PAYMENTS-ROUND  FROM
075500                 PO-BUDGET-AMT  GIVING  DE2-OPEN-BUDGET-AMT
075600             MULTIPLY S-CPW-DEDUCTS  BY  -1 GIVING S-CPW-DEDUCTS
075700             MOVE S-CPW-DEDUCTS  TO  DE2-CPW-DEDUCTS
075800             MOVE S-CPW-PAYMENTS  TO  DE2-CPW-PAYMENTS
075900             SUBTRACT S-CPW-PAYMENTS  FROM  S-CPW-DEDUCTS
076000                 GIVING DE2-CPW-BALANCE
076100             GO TO 62-CIP-X
076200         ELSE
076300             MOVE "DBGET DINVRCD*62-GD"  TO  BU-DISPLAY-MSG
076400             GO TO 2-BLOWUP.
076500
076600     IF INV-STATUS = "I" OR "H"
076700         NEXT SENTENCE
076800     ELSE
076900         ADD INV-NET-DUE-VENDOR  TO
077000             S-INVOICE-PAYMENTS-AMT
077100         IF CE-EXT-ACCTG-DATA-1 = "113930000"
077200             IF CE-EXT-VALUE-1 < ZEROS
077300                 ADD CE-EXT-VALUE-1 TO S-CPW-DEDUCTS
077400             ELSE
077500                 ADD CE-EXT-VALUE-1 TO S-CPW-PAYMENTS.
077600
077700     GO TO 62-GET-DINVRCD.
077800
077900 62-CIP-X.
078000     EXIT.

       63-SELECT-HEADER2-SCREEN.
      *M
      *M ------- THIS IS A CASE TO SELECT THE SCREEN FOR HEADER2
      *M
           IF PO-INVOICELESS-IND    = "X" AND
              PO-NO-CHECK-INDIC     = "X"
                MOVE "NO CHECK/INVOICELESS"   TO DE2-INDIC-MSG
           ELSE
           IF PO-INVOICELESS-IND    = "X" AND
              PO-NO-CHECK-INDIC NOT = "X"
                MOVE "    INVOICELESS     "   TO DE2-INDIC-MSG
           ELSE
           IF PO-INVOICELESS-IND   NOT = "X" AND
              PO-NO-CHECK-INDIC        = "X"
                MOVE "    NO  CHECK       "   TO DE2-INDIC-MSG
           ELSE
                MOVE SPACES                   TO DE2-INDIC-MSG.

       63-SHS-EXIT.
           EXIT.
082400
       64-DISPLAY-TRAILERS.
           READ DTRAILER-I NEXT INTO BUF-DTRAILER
               AT END    MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00" GO TO 64-DT-CONT.
           IF DTRAILER-PO-NUM NOT = PO-ARG GO TO 64-DT-CONT.
           ADD 1                       TO SUB.
           IF SUB = 1
               MOVE DTRAILER-PO-NUM    TO DE-TRAILER-PO.
           MOVE SPACE                  TO DE-TRAILER-PREFIX.
           MOVE DTRAILER-COMMENT-NO    TO DE-T-SEQ (SUB).
           MOVE DTRAILER-COMMENT       TO DE-T-COM (SUB).
           IF SUB = 14
               MOVE  6                 TO LANG-SETNUM
               MOVE 42                 TO LANG-MSGNUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER     TO DE-TRAILER-CMD-LINE
               MOVE DE-TRAILER-BUFFER  TO DISPLAY-REC
               PERFORM 998-WRITE-SCREEN THRU 998-READ-SCREEN
               IF VIEW-LASTKEY = 1
                   MOVE 0              TO SUB
                   MOVE SPACES         TO DE-TRAILER-BUFFER
                   MOVE PO-ARG         TO PORCVNO OF DTRAILER-REC-I
      *            CLOSE DTRAILER-I
      *            OPEN INPUT DTRAILER-I
                   START DTRAILER-I KEY = EXTERNALLY-DESCRIBED-KEY
               ELSE
               IF VIEW-LASTKEY = 3
                   GO TO 64-DT-X
               ELSE
               MOVE 0                  TO SUB
               MOVE SPACES             TO DE-TRAILER-BUFFER.

           GO TO 64-DISPLAY-TRAILERS.
       64-DT-CONT.
           MOVE  6                     TO LANG-SETNUM.
           MOVE 43                     TO LANG-MSGNUM.
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
           MOVE MESSAGE-BUFFER         TO DE-TRAILER-CMD-LINE.
           MOVE DE-TRAILER-BUFFER TO DISPLAY-REC.
           PERFORM 998-WRITE-SCREEN THRU 998-READ-SCREEN.
           IF VIEW-LASTKEY = 1
               MOVE 0                  TO SUB
               MOVE SPACES             TO DE-TRAILER-BUFFER
               MOVE PO-ARG             TO PORCVNO OF DTRAILER-REC-I
      *        CLOSE DTRAILER-I
      *        OPEN INPUT DTRAILER-I
               START DTRAILER-I KEY = EXTERNALLY-DESCRIBED-KEY
               GO TO 64-DISPLAY-TRAILERS.

       64-DT-X.    EXIT.

      *------- DISPLAY VENDOR INFORMATION.
       65-DISPLAY-VENDOR.
           MOVE 22                     TO  LANG-SETNUM.
           MOVE 18                     TO  LANG-MSGNUM.
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
           MOVE MESSAGE-BUFFER         TO  VDE-TITLE.
           MOVE DE-VENDOR-BUFFER       TO  DISPLAY-REC.
           PERFORM 998-WRITE-SCREEN THRU 998-READ-SCREEN.

       65-DV-X.    EXIT.

082500 73-PGM-ERROR.
           MOVE B"1" TO IND (FIELD-NUMBER), IND (99).
           MOVE MESSAGE-BUFFER  TO DE1-MESSAGE-LINE
                                   DE2-MESSAGE-LINE
                                   DE1-MESSAGE-LINE-E
                                   DE1-MESSAGE-LINE-L
                                   DE1-MESSAGE-LINE-E-L.
083800 73-PGM-ERROR-X.
083900     EXIT.
084000
       COPY DISPCALL IN COPYLIB.
086600
086700 999-CATREAD.
           IF CATREAD-MSG-NUMBER = ZEROS
               MOVE LANG-SETNUM TO CATREAD-MSG-SET
               MOVE LANG-MSGNUM TO CATREAD-MSG-NUM.
           CALL "CCATREAD" USING CATREAD-PARMS.
           MOVE CATREAD-MSG-TEXT TO MESSAGE-BUFFER.
088300 999-CATREAD-EXIT.
088400     EXIT.
