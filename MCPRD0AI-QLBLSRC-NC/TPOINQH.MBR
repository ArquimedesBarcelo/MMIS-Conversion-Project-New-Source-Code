                                         DE1-BUDGET-NUMBER-L
                                         DE1-BUDGET-NUMBER-E-L.

043000     IF PRICE-ALLOWED
043100         MOVE PO-BUDGET-AMT    TO  DE1-BUDGET-AMOUNT
                                         DE1-BUDGET-AMOUNT-E
                                         DE1-BUDGET-AMOUNT-L
                                         DE1-BUDGET-AMOUNT-E-L.
043200     MOVE PO-ADDL-INFO         TO  DE1-ADDL-INFO
                                         DE1-ADDL-INFO-E
                                         DE1-ADDL-INFO-L
                                         DE1-ADDL-INFO-E-L.
043300     MOVE PO-FOB               TO  DE1-FOB
                                         DE1-FOB-E
                                         DE1-FOB-L
                                         DE1-FOB-E-L.
