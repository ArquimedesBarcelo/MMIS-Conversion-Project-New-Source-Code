000200 IDENTIFICATION DIVISION.
000300 PROGRAM-ID.    TPOINQH.
000400 AUTHOR.        LS BAKER/MOVSESIAN/JIM COFFMAN (MAINTAINER).
000500 DATE-WRITTEN.  MAY 19, 1983.

      *****************************************************************
      * SUBROUTINE THAT SHOWS PURCHASE ORDER HEADING INFO
      *****************************************************************


      *****************************************************************
      **          M O D I F I C A T I O N    H I S T O R Y
      *****************************************************************
      *C 06/12/92  BK DISMUKES  REQUEST 6220
      *C     1. ADDED LOGIC IN 6-SHOW-SCREENS TO SELECT WHICH
      *C        HEADER2 SCREEN TO USE.
      *C     2. ADDED FIELD TO BUFFER FOR INDICICATOR FIELD.
      *C
      *C 09/16/92  JE COFFMAN   REQUEST 6253
      *C     1. ADDED LOGIC PER LUX REQUEST TO REMOVE ACCOUNTING
      *C        DATA FROM THE HEADER (AND ADD TO THE ITEM SCREENS
      *C        INSTEAD).
      *C
      *C AUGUST 1995 JE COFFMAN REQUEST 95-030/SLS #6579
      *C     1. ADDED THE ABILITY FOR THE USER TO VIEW THE TRAILER
      *C        COMMENTS FOR A PURCHASE ORDER DOWNLOADED FROM
      *C        CORPORATE.
      *C JUNE 10, 1996  JEFF BUNGO
      *C     EXPAND DATE FIELDS FOR YEAR 2000 COMPLIANCE.
      *C     RECOMPILE TO PICK UP NEW FILE FORMATS.
      *C
      *C JANUARY 27, 1997    CA YODER    97-002
      *C     ADDED LOGIC FROM "TINQVEND" TO SHOW VENDOR INQUIRY
      *C     SCREEN WHEN F5 IS PRESSED.
      *C     ** NOTE:  IF SOMETHING IS CHANGED IN THIS PORTION OF
      *C        LOGIC, THE SAME CHANGE MAY NEED TO BE MADE IN
      *C        "TINQVEND" AND "SPOINQHH".
      *C
      *C MARCH 24, 1997      CA YODER
      *C     REMOVED THE PREFIX "P" FROM THE PO NUMBER ON THE TRAILER
      *C     COMMENTS SCREEN.  THIS PREFIX IS USUALLY NOT DISPLAYED.
      *C
      *C  02/03/98     CA YODER    REQ #97-018
      *C     ADDED LOGIC TO DISPLAY STANDARD INSTRUCTIONS WITH A
      *C     VENDOR CODE.
      *C
      *C  10/21/2003   CA YODER    TMS REQUEST
      *C     ADDED FREIGHT TERMS TO PAGE 2 OF THE HEADER INQUIRY
      *C     SCREEN.
      *C---------------------------------------------------------------
      *C MAR 10, 2005  D.RAUCH       DCR01    REQUEST# 2005-78515
      *C    DISPLAY FILE PROCESSING CHANGED FROM USING ZCSISINQ
      *C    NEW DISPLAY FILE ZTPOINQH  CREATED - FORMATS COPIED
      *C    FROM ZCSISINQ.
      *C---------------------------------------------------------------
      *C MMM DD, CCYY  XXXNAMEXXX    XXX01    REQUEST# 2005-XXXXX
      *C    XXXXXXXXXXXXXXXXXX DESC XXXXXXXXXXXXXXXXXXXXXXXXXXXXX
      *****************************************************************

004900 ENVIRONMENT DIVISION.
005000 CONFIGURATION SECTION.
005100 SOURCE-COMPUTER.    IBM-AS400.
005200 OBJECT-COMPUTER.    IBM-AS400.
       SPECIAL-NAMES.  I-O-FEEDBACK IS I-O-FEEDBACK-AREA
                       LOCAL-DATA IS LOCAL-DATA-AREA.
012800
012900 INPUT-OUTPUT SECTION.
       FILE-CONTROL.

           SELECT DISPLAY-FILE
                  ASSIGN TO WORKSTATION-ZTPOINQH-SI
                  ORGANIZATION IS TRANSACTION
                  ACCESS IS SEQUENTIAL
                  FILE STATUS IS DISPLAY-STATUS
                  CONTROL-AREA IS WS-CONTROL.

           SELECT MVALIDUM-I
                  ASSIGN TO DATABASE-MCFLCS0401
                  ORGANIZATION IS INDEXED
                    ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                  FILE STATUS IS FILE-STATUS.

           SELECT MPLTINFO-I
                  ASSIGN TO DATABASE-MCFLCS0501
                  ORGANIZATION IS INDEXED
                    ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                  FILE STATUS IS FILE-STATUS.

           SELECT DPORECD-I
                  ASSIGN TO DATABASE-MCFLCS0901
                  ORGANIZATION IS INDEXED
                    ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                    WITH DUPLICATES
                  FILE STATUS IS FILE-STATUS.

           SELECT DVENDOR-I
                  ASSIGN TO DATABASE-MCFLCS0701
                  ORGANIZATION IS INDEXED
                    ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                    WITH DUPLICATES
                  FILE STATUS IS FILE-STATUS.

           SELECT DPODATAITM-I
                  ASSIGN TO DATABASE-MCFLCS1101
                  ORGANIZATION IS INDEXED
                    ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                    WITH DUPLICATES
                  FILE STATUS IS FILE-STATUS.

           SELECT DINVRCD-I
                  ASSIGN TO DATABASE-MCFLCS2502
                  ORGANIZATION IS INDEXED
                    ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                    WITH DUPLICATES
                  FILE STATUS IS FILE-STATUS.

           SELECT DTRAILER-I
                 ASSIGN TO DATABASE-MCFLCS6001
                 ORGANIZATION IS INDEXED
                   ACCESS MODE IS DYNAMIC
                 RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                   WITH DUPLICATES
                 FILE STATUS IS FILE-STATUS.

       DATA DIVISION.
       FILE SECTION.
       FD  DISPLAY-FILE
           LABEL RECORDS ARE OMITTED.
       01  DISPLAY-REC                  PIC X(2000).

       FD  MVALIDUM-I
           LABEL RECORDS ARE STANDARD.
       01  MVALIDUM-REC-I.
           COPY DDS-ALL-FORMATS  OF MCFLCS0401.

       FD  MPLTINFO-I
           LABEL RECORDS ARE STANDARD.
       01  MPLTINFO-REC-I.
           COPY DDS-ALL-FORMATS  OF MCFLCS0501.

       FD  DPORECD-I
           LABEL RECORDS ARE STANDARD.
       01  DPORECD-REC-I.
           COPY DDS-ALL-FORMATS  OF MCFLCS0901.

       FD  DVENDOR-I
           LABEL RECORDS ARE STANDARD.
       01  DVENDOR-REC-I.
           COPY DDS-ALL-FORMATS  OF MCFLCS0701.

       FD  DPODATAITM-I
           LABEL RECORDS ARE STANDARD.
       01  DPODATAITM-REC-I.
           COPY DDS-ALL-FORMATS  OF MCFLCS1101.

       FD  DINVRCD-I
           LABEL RECORDS ARE STANDARD.
       01  DINVRCD-REC-I.
           COPY DDS-ALL-FORMATS  OF MCFLCS2502.

       FD  DTRAILER-I
           LABEL RECORDS ARE STANDARD.
       01  DTRAILER-REC-I.
           COPY DDS-ALL-FORMATS  OF MCFLCS6001.

