       60-CALL-TPPRNT.
           IF AKEY = 0
103000         MOVE 40011        TO CATREAD-MSG-NUMBER
103200         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE ERROR-BUFFER TO TERM-CMD-LINE
               MOVE TRUE-VAL     TO INDS (98)
               MOVE TERM-BUFFER  TO DSPLY-REC
               PERFORM 99-SCREEN-WRITE
               PERFORM 98A-SCREEN-READ
               MOVE SPACES       TO TERM-BUF
               CALL "CLPAUSE2"
           ELSE
           CLOSE DISK-TEMP
           CALL "TPPRNT" USING DBPARAMETERS VIEW-COMAREA
                           PLT-IDT PV SAVE-INDEX.

       PRE-MESSAGE-DISPLAY.
           MOVE 35095 TO CATREAD-MSG-NUMBER.
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
           GO TO 6-MAIN.

       98-SCREEN-READ.
           READ DISPLAY-FILE FORMAT IS VIEW-CFNAME
               INDIC IS INDICS.
           ACCEPT IOFEEDBACK FROM I-O-FEEDBACK-AREA.
           MOVE ALL B"0" TO INDICS.
           IF DSPLY-STATUS NOT = "00"
               MOVE 3 TO VIEW-LASTKEY
           ELSE
           MOVE FUNCTION-NUM TO VIEW-LASTKEY.

       98A-SCREEN-READ.
           READ DISPLAY-FILE TERMINAL IS TERMINAL-ID
               INDIC IS INDICS
                  NO DATA MOVE DSPLY-STATUS TO DSPLY-STATUS.
           MOVE ALL B"0" TO INDICS.

       99-SCREEN-WRITE.
           WRITE DSPLY-REC FORMAT IS VIEW-CFNAME
               INDIC IS INDICS.
           MOVE ALL B"0" TO INDICS.

087200 999-CATREAD.
087300     MOVE SPACES TO ERROR-BUFFER.
087400     CALL "CCATREAD" USING CATREAD-PARMS.
087500     MOVE CATREAD-MSG-TEXT TO ERROR-BUFFER.
088200 999-CATREAD-EXIT.    EXIT.

088400 8-INPUT-RECORDS.
088600     PERFORM 81-PROCESS-INPUT-RECORDS THRU 81-PIR-EXIT.
089000
089100 81-PROCESS-INPUT-RECORDS.
089200     MOVE 0 TO COND-WORD.
089300     READ PERSONNEL-FILE INTO PER-PERSONNEL
089400         AT END    MOVE 11 TO COND-WORD.
089500     IF COND-WORD = 11
089700         GO TO 81-PIR-EXIT.
090100     IF SPACES = COMP-DATE1-CN AND COMP-DATE2-CN
090200         NEXT SENTENCE
090300     ELSE
090400     IF (COMP-DATE1-CN < PER-CSD-CN OF PER-PERSONNEL OR
090500        COMP-DATE1-CN = PER-CSD-CN OF PER-PERSONNEL)  AND
090600        (PER-CSD-CN OF PER-PERSONNEL < COMP-DATE2-CN OR
090700        PER-CSD-CN OF PER-PERSONNEL = COMP-DATE2-CN)
090800       NEXT SENTENCE
090900     ELSE
091000     GO TO 81-PROCESS-INPUT-RECORDS.
091100     IF TERM-C1 = SPACES MOVE "**" TO TERM-C1.
091200     IF TERM-C2 = SPACES MOVE "**" TO TERM-C2.
091300     IF TERM-C3 = SPACES MOVE "**" TO TERM-C3.
091400     IF TERM-C4 = SPACES MOVE "**" TO TERM-C4.
091500     IF TERM-C5 = SPACES MOVE "**" TO TERM-C5.
091600     IF "**" = TERM-C1 AND TERM-C2 AND TERM-C3
091700                       AND TERM-C4 AND TERM-C5
091800*        IF PER-CRAFT OF PER-PERSONNEL = "SS"
091900*            GO TO 81-PROCESS-INPUT-RECORDS
092000*        ELSE
092100         NEXT SENTENCE
092200     ELSE
092300     IF PER-CRAFT OF PER-PERSONNEL = TERM-C1 OR TERM-C2 OR
092400                                     TERM-C3 OR TERM-C4 OR
092500                                     TERM-C5
092600         NEXT SENTENCE
092700     ELSE
092800     GO TO 81-PROCESS-INPUT-RECORDS.
092900     IF TERM-Z1 = SPACES MOVE "****" TO TERM-Z1.
093000     IF TERM-Z2 = SPACES MOVE "****" TO TERM-Z2.
093100     IF TERM-Z3 = SPACES MOVE "****" TO TERM-Z3.
093200     IF TERM-Z4 = SPACES MOVE "****" TO TERM-Z4.
093300     IF TERM-Z5 = SPACES MOVE "****" TO TERM-Z5.
093400     IF "****" = TERM-Z1 AND TERM-Z2 AND TERM-Z3
093500                         AND TERM-Z4 AND TERM-Z5
093600         NEXT SENTENCE
093700     ELSE
093800     IF PER-MAINT-ZONE OF PER-PERSONNEL = TERM-Z1 OR TERM-Z2 OR
093900                                          TERM-Z3 OR TERM-Z4 OR
094000                                          TERM-Z5
094100         NEXT SENTENCE
094200     ELSE
094300     GO TO 81-PROCESS-INPUT-RECORDS.
094400     IF TERM-S1 = SPACES MOVE "**" TO TERM-S1.
094500     IF TERM-S2 = SPACES MOVE "**" TO TERM-S2.
094600     IF TERM-S3 = SPACES MOVE "**" TO TERM-S3.
094700     IF TERM-S4 = SPACES MOVE "**" TO TERM-S4.
094800     IF "**" = TERM-S1 AND TERM-S2 AND TERM-S3 AND TERM-S4
094900         NEXT SENTENCE
095000     ELSE
095100     IF PER-SHIFT-CREW OF PER-PERSONNEL = TERM-S1 OR TERM-S2 OR
095200                                          TERM-S3 OR TERM-S4
095300         NEXT SENTENCE
095400     ELSE
095500     GO TO 81-PROCESS-INPUT-RECORDS.
095600     MOVE CORR PER-PERSONNEL TO SORT-REC.
095700     RELEASE SORT-REC.
           GO TO 81-PROCESS-INPUT-RECORDS.
095900
096000 81-PIR-EXIT.    EXIT.
096100
096800 9-WRITE-RECORDS.
           MOVE 0 TO AKEY.
           PERFORM 9-WR THRU 9-WR-EXIT.
       9-WR.
096900     RETURN SORT-FILE AT END GO TO 9-WR-EXIT.
097800     ADD 1 TO AKEY.
097900     WRITE DISK-REC FROM SORT-REC INVALID KEY
098100         MOVE 44017 TO CATREAD-MSG-NUMBER
098300         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE TRUE-VAL TO INDS (99)
               GO TO 2-EOJ.
097000     GO TO 9-WR.
100000 9-WR-EXIT.    EXIT.
