019900 PROCEDURE DIVISION USING DBPARAMETERS VIEW-COMAREA
020000                      PLT-IDT.
020100 BEGIN-PROG.
           PERFORM 1-HSK.
           PERFORM 6-MAIN THRU 6-MAIN-CONT.
       2-EOJ.
           CLOSE DISPLAY-FILE.
           CLOSE PERSONNEL-FILE.
086800     CLOSE DISK-TEMP.
           GOBACK.
020200 1-HSK.
           OPEN I-O    DISPLAY-FILE.
           OPEN I-O    PERSONNEL-FILE.
           MOVE SPACES TO PERCCNUM OF PFREC.
           START PERSONNEL-FILE KEY >= PERCCNUM OF PFREC
               INVALID KEY MOVE PF-STATUS TO PF-STATUS.
           IF PF-STATUS NOT = "00" GO TO 2-EOJ.
021600     OPEN OUTPUT DISK-TEMP.
020300     CALL "TPWORD" USING PASSWORD-INFORMATION.
020700     IF PASSWORD-FLAG = "N" GO TO 2-EOJ.
021500     IF VIEW-LASTKEY = 3 GO TO 2-EOJ.
           MOVE 0 TO AKEY.
           MOVE SPACES TO TERM-BUFFER.
       6-MAIN.
021900     MOVE "FPLIST" TO VIEW-CFNAME.
023300     MOVE TERM-BUFFER TO DSPLY-REC.
           PERFORM 99-SCREEN-WRITE.
           PERFORM 98-SCREEN-READ.
           MOVE DSPLY-REC TO TERM-BUFFER.
           MOVE SPACES    TO TERM-ERR-LINE.
024300     IF VIEW-LASTKEY = 3 PERFORM 2-EOJ.
025900     MOVE TERM-CC-NUM TO C-CC-NUM.
026000     MOVE TERM-NAME TO C-NAME.
026100     MOVE TERM-CSD TO C-CSD.
026200     MOVE TERM-CRAFT TO C-CRAFT.
026300     MOVE TERM-ZONE TO C-ZONE.
026700     SET SORT-INDEX TO 1.
026800     SEARCH SORT-ORDER
026900           AT END
027000             PERFORM PRE-MESSAGE-DISPLAY
027100           WHEN COMPARE-SORT = SORT-ORDER (SORT-INDEX)
027200             SET SAVE-INDEX TO SORT-INDEX.
027600     IF TERM-PV = SPACE
027700       MOVE "V" TO PV
027800     ELSE
027900     MOVE "P" TO PV.
028300     IF TERM-DATE1 NOT = SPACES
028400         IF TERM-DATE2   = SPACES
028500             MOVE 30020 TO CATREAD-MSG-NUMBER
028700             PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
028800             MOVE TRUE-VAL TO INDS (7) INDS (99)
029500             GO TO 6-MAIN
029600         ELSE
029700         NEXT SENTENCE
029800     ELSE
029900     IF TERM-DATE2 = SPACES
030000         MOVE SPACES TO COMP-DATE1-CN COMP-DATE2-CN
030100         GO TO 6-MAIN-CONT
030200     ELSE
030300     MOVE 30020 TO CATREAD-MSG-NUMBER
030500     PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
030600     MOVE TRUE-VAL TO INDS (6) INDS (99)
031300     GO TO 6-MAIN.
031500     MOVE DATE-FLAG TO DATE-CODE.
031600     MOVE 3 TO DATE-MODE.
031700     MOVE TERM-DATE1 TO DATE-VALIDATE-IN.
031800     CALL "TDATECHK" USING DATE-CHECK-AREA.
031900     IF DATE-RET-CODE = 1
032000         MOVE DATE-MSG TO ERROR-BUFFER
032100         MOVE TRUE-VAL TO INDS (6) INDS (99)
032500         GO TO 6-MAIN.
032600     MOVE DATE-DB TO COMP-DATE1.
      *------USE A COMPARE YEAR OF LESS THAN 70
      *------SINCE WE ARE DEALING WITH CSD DATES
           IF YY-COMP1 > "40"
               MOVE "19" TO CC-COMP1
           ELSE
               MOVE "20" TO CC-COMP1.
032800     MOVE DATE-FLAG TO DATE-CODE.
032900     MOVE 3 TO DATE-MODE.
033000     MOVE TERM-DATE2 TO DATE-VALIDATE-IN.
033100     CALL "TDATECHK" USING DATE-CHECK-AREA.
033200     IF DATE-RET-CODE = 1
033300         MOVE DATE-MSG TO ERROR-BUFFER
033400         MOVE TRUE-VAL TO INDS (7) INDS (99)
033800         GO TO 6-MAIN.
033900     MOVE DATE-DB TO COMP-DATE2.
      *------USE A COMPARE YEAR OF LESS THAN 70
      *------SINCE WE ARE DEALING WITH CSD DATES
           IF YY-COMP2 > "40"
               MOVE "19" TO CC-COMP2
           ELSE
               MOVE "20" TO CC-COMP2.
034200 6-MAIN-CONT.
034900     GO TO SORT01 SORT02 SORT03 SORT04 SORT05 SORT06 SORT07
