       01  MPORCV-REC-I.
           COPY DDS-MCRPCS0100  OF MCFLCS0101.
       FD  MPLTINFO-O
           LABEL RECORDS ARE STANDARD.
       01  MPLTINFO-REC-O.
           COPY DDS-MCRPCS0500  OF MCFLCS0501.
       FD  DMANPART-I.
       01  DMANPART-REC-I.
           COPY DDS-MCRPCS3600  OF MCFLCS3601.
       FD  DCODE-I.
       01  DCODE-REC-I.
           COPY DDS-MCRPCS3400  OF MCFLCS3401.
       FD  MMANUFACT-I
           LABEL RECORDS ARE STANDARD.
       01  MMANUFACT-REC-I.
           COPY DDS-MCRPCS3500  OF MCFLCS3501.
       WORKING-STORAGE SECTION.
