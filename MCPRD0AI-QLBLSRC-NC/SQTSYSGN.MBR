           COPY DDS-MCRPCS0700  OF MCFLCS0701.
       FD  DVENDITM3-I
           LABEL RECORDS ARE STANDARD.
       01  DVENDITM3-REC-I.
           COPY DDS-MCRPCS0800  OF MCFLCS0803.
       FD  DVENDITM5-I
           LABEL RECORDS ARE STANDARD.
       01  DVENDITM5-REC-I.
           COPY DDS-MCRPCS0800  OF MCFLCS0805.
       FD  MSTORERM-I
           LABEL RECORDS ARE STANDARD.
       01  MSTORERM-REC-I.
           COPY DDS-MCRPCS0200  OF MCFLCS0201.
       FD  DQUOTEXT-I
           LABEL RECORDS ARE STANDARD.
       01  DQUOTEXT-REC-I.
           COPY DDS-MCRPCS3800  OF MCFLCS3801.
       FD  DQUOTEXT-O
           LABEL RECORDS ARE STANDARD.
       01  DQUOTEXT-REC-O.
           COPY DDS-MCRPCS3800  OF MCFLCS3801.
       FD  MBUYER-I
