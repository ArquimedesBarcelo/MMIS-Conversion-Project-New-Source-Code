           05  FILE-STATUS-2             PIC X.
       01  MULTIPLE-VENDORS              PIC X     VALUE "N".
       01  X                             PIC 9(2)  VALUE ZEROES.
       01  N                             PIC 9(2)  VALUE ZEROES.
       01  HELP-FORMNAME                 PIC X(6)  VALUE SPACES.

       01  ACCEPT-DATA1.
           05  ACCEPT-BUYER              PIC X(4).
           05  ACCEPT-RETURN-DATE        PIC X(8)  VALUE SPACES.
           05  ACCEPT-PRINTER            PIC 9(2).
      *--  "S"=STANDARD PARAGRAPH, " "=UNIQUE PARAGRAPH
           05  PARAGRAPH-TYPE            PIC X     VALUE SPACES.
      *--  PO NUMBER, QUOTE NUMBER, OR REQUISITION NUMBER
           05  ACCEPT-DOCUMENT           PIC X(12) VALUE SPACES.
      *--  "P"=PO, "Q"=QUOTE, "R"=REQUISITION
      *--  "K"=KEYWORD, "S"=KEYWORD ONLY, "M"=MANUFACTURER,
      *--  "X"=CROSS-REFERENCE (KEYWORD(MODIFIER) AND MANUFACTURER)
           05  ACCEPT-DOC-TYPE           PIC X     VALUE SPACE.
           05  ACCEPT-SORT               PIC X     VALUE SPACE.
           05  ACCEPT-QUOTE-REF          PIC 9(4)  VALUE ZEROES.
           05  FILLER                    PIC X(47) VALUE SPACES.
       01  ACCEPT-DATA2.
           05  INFO-LINE-ACCEPT OCCURS 5 TIMES.
               10  VENDOR                PIC X(10).
               10  ACCEPT-QUOTE          PIC X(6).
       01  ACCEPT-DATA3.
           05  ACCEPT-KEYWORD            PIC X(50).
           05  FILLER                    PIC X(30).
       01  ACCEPT-DATA4.
           05  ACCEPT-MANUFACTURER       PIC X(26).
           05  FILLER                    PIC X(54).

       01  CY-TODAY-DATE.
           05  TODAY-CENT                PIC X(2)  VALUE SPACES.
           05  TODAY-DATE.
               10  TODAY-YEAR            PIC X(2)  VALUE SPACES.
               10  FILLER                PIC X(4)  VALUE SPACES.

       01  CY-RETURN-DATE.
           05  RETURN-CENT               PIC X(2)  VALUE SPACES.
           05  RETURN-DATE.
               10  RETURN-YEAR           PIC X(2)  VALUE SPACES.
