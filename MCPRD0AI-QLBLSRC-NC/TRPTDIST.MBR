       IDENTIFICATION DIVISION.
       PROGRAM-ID.         TRPTDIST.
       AUTHOR.             CA YODER.
       DATE-WRITTEN.       NOVEMBER 1997.
       DATE-COMPILED.
      *INSTALLATION.       GOODYEAR TIRE & RUBBER CO.

      *D* REMARKS.
      *D*
      *D*   THIS PROGRAM IS THE MAIN SCREEN FOR THE REPORT
      *D*   DISTRIBUTION FEATURE.
      *D*
      *D*   PROGRAMS CALLED:     SRPTSEL
      *
      *C* CHANGES
      *C*

       ENVIRONMENT DIVISION.

       CONFIGURATION SECTION.

       SOURCE-COMPUTER.          IBM-AS400.
       OBJECT-COMPUTER.          IBM-AS400.

       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT DISPLAY-FILE
               ASSIGN         TO WORKSTATION-ZRPTDIST-SI
               ORGANIZATION   IS TRANSACTION
               ACCESS         IS DYNAMIC
               RELATIVE KEY   IS REC-COUNT
               FILE STATUS    IS DISPLAY-STATUS
               CONTROL-AREA   IS WS-CONTROL.

           SELECT DRPTMAST-IO
               ASSIGN         TO DATABASE-MCFLCS6701
               ORGANIZATION   IS INDEXED
               ACCESS MODE    IS DYNAMIC
               RECORD KEY     IS EXTERNALLY-DESCRIBED-KEY
                                 WITH DUPLICATES
               FILE STATUS    IS FILE-STATUS.

           SELECT DRPTDIST-IO
               ASSIGN         TO DATABASE-MCFLCS6801
               ORGANIZATION   IS INDEXED
               ACCESS MODE    IS DYNAMIC
               RECORD KEY     IS EXTERNALLY-DESCRIBED-KEY
                                 WITH DUPLICATES
               FILE STATUS    IS FILE-STATUS.

           SELECT DRPTDIST-I
               ASSIGN         TO DATABASE-MCFLCS6801
               ORGANIZATION   IS INDEXED
               ACCESS MODE    IS DYNAMIC
               RECORD KEY     IS EXTERNALLY-DESCRIBED-KEY
                                 WITH DUPLICATES
               FILE STATUS    IS FILE-STATUS.

       DATA DIVISION.

       FILE SECTION.

       FD  DISPLAY-FILE
           LABEL RECORDS ARE OMITTED.
       01  DISPLAY-REC        PIC X(2000).

       FD  DRPTMAST-IO
           LABEL RECORDS ARE STANDARD.
       01  DRPTMAST-IO-REC.
           COPY DDS-ALL-FORMATS OF MCFLCS6701.

       FD  DRPTDIST-IO
           LABEL RECORDS ARE STANDARD.
       01  DRPTDIST-IO-REC.
           COPY DDS-ALL-FORMATS OF MCFLCS6801.

       FD  DRPTDIST-I
           LABEL RECORDS ARE STANDARD.
       01  DRPTDIST-I-REC.
           COPY DDS-ALL-FORMATS OF MCFLCS6801.

       WORKING-STORAGE SECTION.

       77  SUB                      PIC 9(5).
       77  SUB2                     PIC 9(5).
       77  MORE-RECORDS             PIC X     VALUE "Y".
       77  DEFAULT-EXISTS-SW        PIC X     VALUE "N".
       77  DEPT-EXISTS-SW           PIC X     VALUE "N".
       77  DRPTMAST-EOF-SW          PIC X     VALUE "N".
       77  DRPTDIST-EOF-SW          PIC X     VALUE "N".
       77  DEFAULT-KEY              PIC X(7)  VALUE "DEFAULT".

      *-----------------------------------------------------------------
      *                   B U F F E R S
      *-----------------------------------------------------------------

      *------- BUFFER FOR FIRST DISPLAY SCREEN.
       01  DE-SCREEN1-BUF.
           10  DE-SC1-MSGLINE       PIC X(78).

       01  DE-RPT-BUF.
           10  DE-RPT-SELECT      PIC X.
           10  DE-RPT-DESC        PIC X(40).
           10  DE-RPT-PROG        PIC X(8).

       01  DE-RPT-MSG             PIC X(78).

       01  DE-COPY-BUF.
           10  DE-COPY-SELECT       PIC X.
           10  DE-COPY-DESC         PIC X(40).
           10  DE-COPY-PROG         PIC X(8).
           10  DE-COPY-KEY-DESC     PIC X(10).
           10  DE-COPY-ID           PIC X(4).

       01  DE-COPY2-BUF.
           10  DE-COPY2-SELECT      PIC X.
           10  DE-COPY2-DESC        PIC X(40).
           10  DE-COPY2-PROG        PIC X(8).
           10  DE-COPY2-ID          PIC X(4).

       01  DE-HDR-BUF.
           10  DE-HDR-KEY           PIC X(10).
           10  DE-HDR-DESC          PIC X(40).

       COPY DRPTDIST      OF COPYLIB.

       COPY DRPTMAST      OF COPYLIB.

      *-----------------------------------------------------------------
      *         S W I T C H E S / C O U N T E R S
      *-----------------------------------------------------------------

       01  REC-COUNT               PIC 9(5) VALUE 0.

      *-----------------------------------------------------------------
      *          D A T A B A S E   S T A T U S   A R E A
      *-----------------------------------------------------------------

       01  FILE-STATUS.
           05  FILE-STATUS-1        PIC X.
           05  FILE-STATUS-2        PIC X.

       COPY DATAB    OF COPYLIB.

      *-----------------------------------------------------------------
      *               U T I L I T Y   A R E A
      *-----------------------------------------------------------------

       COPY CATREAD OF COPYLIB.

       COPY TBLOWUP OF COPYLIB.

       COPY VCOMAREA OF COPYLIB.

       COPY TLSHIFT    IN COPYLIB.

       COPY TRSHIFT    IN COPYLIB.

       01  WS-CONTROL.
           05  FUNCTION-KEY         PIC X(2).
               88  ENTER-KEY-USED            VALUE "00".
               88  F1-KEY-USED               VALUE "01".
               88  F2-KEY-USED               VALUE "02".
               88  F3-KEY-USED               VALUE "03".
               88  F4-KEY-USED               VALUE "04".
               88  F5-KEY-USED               VALUE "05".
               88  F6-KEY-USED               VALUE "06".
               88  F7-KEY-USED               VALUE "07".
               88  F8-KEY-USED               VALUE "08".
               88  F9-KEY-USED               VALUE "09".
               88  F10-KEY-USED              VALUE "10".
               88  F11-KEY-USED              VALUE "11".
               88  F12-KEY-USED              VALUE "12".
               88  ROLLUP-KEY-USED           VALUE "RU".
           05  TERMINAL-ID          PIC X(10).
           05  FORMAT-NAME          PIC X(10).

       01  DISPLAY-STATUS           PIC X(2).

       01  SRF-INDICATORS.
           05  IND                  PIC 1
                                    OCCURS 99 TIMES
                                    INDICATOR 1.
               88  IND-OFF          VALUE B"0".
               88  IND-ON           VALUE B"1".

       01  OFF-SWITCH               PIC 1  VALUE B"0".
       01  ON-SWITCH                PIC 1  VALUE B"1".

      *--------- THESE ARE THE PROGRAMS DEFINED TO THE REPORT
      *--------- DISTRIBUTION SYSTEM.  IF THEY DON'T EXIST IN
      *--------- DRPTMAST, THE PROGRAM WILL ADD THEM.
       01  DEFINED-REPORTS-DATA.
           05  TDLYCHGS-RPT.
               10  FILLER   PIC X(8)  VALUE "TDLYCHGS".
               10  FILLER   PIC X(40)
                   VALUE "DAILY STOREROOM CHARGES BY DEPARTMENT   ".
               10  FILLER   PIC X(4)  VALUE "CHGS".
               10  FILLER   PIC X(10) VALUE "DEPARTMENT".
               10  FILLER   PIC X(9)  VALUE SPACES.

           05  TDTLCHGS-RPT.
               10  FILLER       PIC X(8)  VALUE "TDTLCHGS".
               10  FILLER       PIC X(40)
                   VALUE "SR6 STORES DETAIL OF CHARGES            ".
               10  FILLER       PIC X(4)  VALUE "SR6 ".
               10  FILLER       PIC X(10) VALUE "DEPARTMENT".
               10  FILLER       PIC X(9)  VALUE SPACES.

       01  DEFINED-REPORTS-TABLE  REDEFINES  DEFINED-REPORTS-DATA.
           05  REPORT-NUM                 OCCURS 2 TIMES.
               10  REPORT-NAME  PIC X(8).
               10  FILLER       PIC X(63).

       01  MAX-REPORTS          PIC 9(2)  VALUE 2.

      *-----------------------------------------------------------------
      *          P R O C E D U R E   D I V I S I O N
      *-----------------------------------------------------------------

       PROCEDURE DIVISION.

       BEGIN SECTION.

       0-BEGIN.
           PERFORM 1-HSK.
           PERFORM 6-MAIN THRU 6-MAIN-X.
           PERFORM 2-EOJ.
           GOBACK.

       1-HSK.
           OPEN I-O       DRPTDIST-IO
                          DRPTDIST-I
                          DRPTMAST-IO
                          DISPLAY-FILE.

           PERFORM 10-CHECK-DRPTMAST VARYING SUB FROM 1 BY 1
               UNTIL SUB > MAX-REPORTS.
           MOVE HIGH-VALUES TO RPTPROG OF DRPTMAST-IO-REC.
           START DRPTMAST-IO KEY > EXTERNALLY-DESCRIBED-KEY
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.

       10-CHECK-DRPTMAST.
           MOVE REPORT-NAME (SUB)  TO RPTPROG OF DRPTMAST-IO-REC.
           START DRPTMAST-IO KEY = EXTERNALLY-DESCRIBED-KEY
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS-1 = "2"
               WRITE DRPTMAST-IO-REC FROM REPORT-NUM (SUB)
                   INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.

       2-EOJ.
           CLOSE          DRPTDIST-IO
                          DRPTDIST-I
                          DRPTMAST-IO
                          DISPLAY-FILE.

       6-MAIN SECTION.

       6-BEGIN.
           INITIALIZE DISPLAY-REC.

       6-DISPLAY-SCREEN.

      *------ SHOW FIRST SCREEN TO SELECT FUNCTION.
           WRITE DISPLAY-REC FROM DE-SCREEN1-BUF
               FORMAT IS "MAIN"
               INDICATORS ARE SRF-INDICATORS.
           IF DISPLAY-STATUS NOT = "00"
               MOVE "PROBLEM ON INIT SCREEN WRITE" TO BU-DISPLAY-MSG
               GO TO 9999-BLOWUP.
           READ DISPLAY-FILE INTO DE-SCREEN1-BUF
               FORMAT IS "MAIN"
               INDICATORS ARE SRF-INDICATORS.
           MOVE ALL B"0" TO SRF-INDICATORS.
           IF DISPLAY-STATUS NOT = "00"
               MOVE "PROBLEM ON READ SCREEN" TO BU-DISPLAY-MSG
               GO TO 9999-BLOWUP.

           IF F3-KEY-USED
               GO TO 6-MAIN-X.

           IF F2-KEY-USED
               CALL "SRPTSEL"
               GO TO 6-BEGIN.

           IF F4-KEY-USED
               PERFORM 63-COPY-PROCEDURE  THRU  63-CP-X.

           IF F5-KEY-USED
               PERFORM 64-REPORTS-PROCEDURE  THRU  64-RP-X.

           GO TO 6-BEGIN.

       6-MAIN-X.
           EXIT.

      ******************************************************************
      **                  C O P Y   P R O C E D U R E                 **
      ******************************************************************

       63-COPY-PROCEDURE.
           INITIALIZE DISPLAY-REC.
           MOVE "00"  TO  FILE-STATUS.

       63-LOAD-SCREEN.

           INITIALIZE REC-COUNT.

      *---- SHOW SFLCTL (71) AND CLEAR SFL (72), BUT DON'T SHOW IT (70).

           MOVE ON-SWITCH    TO IND (71)  IND (72).
           MOVE OFF-SWITCH   TO IND (70).

           WRITE SUBFILE DISPLAY-REC
               FORMAT IS "COPYSFLC"
               INDICATORS ARE SRF-INDICATORS.
           IF DISPLAY-STATUS NOT = "00"
               MOVE "PROBLEM ON INIT SFL WRITE*COPY" TO BU-DISPLAY-MSG
               GO TO 9999-BLOWUP.

      *-------- TURN CLEAR SFL OFF.

           MOVE OFF-SWITCH TO IND (72).

       63-GET-LIST.

           INITIALIZE DE-COPY-BUF.
           MOVE "N"                TO  DRPTMAST-EOF-SW.
           MOVE SPACES TO RPTPROG OF DRPTMAST-IO-REC.
           START DRPTMAST-IO KEY >= EXTERNALLY-DESCRIBED-KEY
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS = "00"
               READ DRPTMAST-IO NEXT INTO BUF-DRPTMAST
                   AT END MOVE "Y" TO DRPTMAST-EOF-SW.
           IF FILE-STATUS = "00"
               PERFORM UNTIL DRPTMAST-EOF-SW = "Y"
                   MOVE MST-RPT-DESC   TO DE-COPY-DESC
                   MOVE MST-RPT-PROG   TO DE-COPY-PROG
                   MOVE MST-KEY-DESC   TO DE-COPY-KEY-DESC
                   MOVE MST-RPT-ID     TO DE-COPY-ID
                   ADD 1               TO REC-COUNT
                   WRITE SUBFILE DISPLAY-REC FROM DE-COPY-BUF
                       FORMAT IS "COPYSFL"
                       INDICATORS ARE SRF-INDICATORS
                       INVALID KEY MOVE FILE-STATUS TO FILE-STATUS
                   END-WRITE
                   IF DISPLAY-STATUS NOT = "00"
                       MOVE "SFL WRITE ERROR*COPY" TO BU-DISPLAY-MSG
                       MOVE REC-COUNT        TO BU-DISPLAY-FLD (1)
                       MOVE DISPLAY-STATUS   TO BU-DISPLAY-FLD (2)
                       PERFORM 9999-BLOWUP
                   END-IF
                   READ DRPTMAST-IO NEXT INTO BUF-DRPTMAST
                       AT END MOVE "Y" TO DRPTMAST-EOF-SW
                   END-READ
               END-PERFORM.

       63-SHOW-SCREEN.

      *--- SHOW FUNCTION KEYS.
           WRITE DISPLAY-REC FROM DE-COPY-BUF
               FORMAT IS "COPYSFLREC"
               INDICATORS ARE SRF-INDICATORS.
           MOVE ALL B"0" TO SRF-INDICATORS.

           MOVE ON-SWITCH TO IND (70)  IND (71)  IND (73).

      *--- WRITE THE SUBFILE TO SCREEN.
           WRITE SUBFILE DISPLAY-REC
               FORMAT IS "COPYSFLC"
               INDICATORS ARE SRF-INDICATORS.
           MOVE ALL B"0" TO SRF-INDICATORS.
           IF DISPLAY-STATUS NOT = "00"
               MOVE "PROBLEM ON SHOW SFL WRITE*COPY" TO BU-DISPLAY-MSG
               MOVE REC-COUNT TO BU-DISPLAY-FLD (1)
               MOVE DISPLAY-STATUS TO BU-DISPLAY-FLD (2)
               GO TO 9999-BLOWUP.

      *--- WAIT FOR USER TO PRESS A KEY.
           READ DISPLAY-FILE INTO DE-COPY-BUF
               FORMAT IS "COPYSFLC"
               INDICATORS ARE SRF-INDICATORS.
           MOVE ALL B"0" TO SRF-INDICATORS.
           IF DISPLAY-STATUS NOT = "00"
               MOVE "PROBLEM ON READ SFL*COPY" TO BU-DISPLAY-MSG
               GO TO 9999-BLOWUP.

       63-ACTION.

           IF F3-KEY-USED
               GO TO 63-CP-X.

           MOVE "Y" TO MORE-RECORDS.
           PERFORM UNTIL DE-COPY-SELECT = "X" OR MORE-RECORDS = "N"
               READ SUBFILE DISPLAY-FILE NEXT MODIFIED RECORD
                   INTO DE-COPY-BUF
                   FORMAT IS "COPYSFL"
                   AT END MOVE "N" TO MORE-RECORDS
               END-READ
           END-PERFORM.

           IF MORE-RECORDS = "N"
               GO TO 63-SHOW-SCREEN.


       630-SELECT-COPY-TO.
           INITIALIZE DISPLAY-REC.
           MOVE "00"  TO  FILE-STATUS.
           MOVE DE-COPY-DESC     TO  DE-HDR-DESC.
           MOVE DE-COPY-KEY-DESC TO  DE-HDR-KEY.

       630-LOAD-SCREEN.

           INITIALIZE REC-COUNT.

      *---- SHOW SFLCTL (71) AND CLEAR SFL (72), BUT DON'T SHOW IT (70).

           MOVE ON-SWITCH    TO IND (71)  IND (72).
           MOVE OFF-SWITCH   TO IND (70).

           WRITE SUBFILE DISPLAY-REC
               FORMAT IS "COPY2SFLC"
               INDICATORS ARE SRF-INDICATORS.
           IF DISPLAY-STATUS NOT = "00"
               MOVE "PROBLEM ON INIT SFL WRITE*COPY2" TO BU-DISPLAY-MSG
               GO TO 9999-BLOWUP.

      *-------- TURN CLEAR SFL OFF.

           MOVE OFF-SWITCH TO IND (72).

       630-GET-LIST.

           INITIALIZE DE-COPY2-BUF.
           MOVE "N"                TO  DRPTMAST-EOF-SW.
           MOVE SPACES TO RPTPROG OF DRPTMAST-IO-REC.
           START DRPTMAST-IO KEY >= EXTERNALLY-DESCRIBED-KEY
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS = "00"
               READ DRPTMAST-IO NEXT INTO BUF-DRPTMAST
                   AT END MOVE "Y" TO DRPTMAST-EOF-SW.
           IF FILE-STATUS = "00"
               PERFORM UNTIL DRPTMAST-EOF-SW = "Y"
                 IF DE-COPY-PROG NOT = MST-RPT-PROG
                   MOVE MST-RPT-DESC   TO DE-COPY2-DESC
                   MOVE MST-RPT-PROG   TO DE-COPY2-PROG
                   MOVE MST-RPT-ID     TO DE-COPY2-ID
                   ADD 1               TO REC-COUNT
                   WRITE SUBFILE DISPLAY-REC FROM DE-COPY2-BUF
                       FORMAT IS "COPY2SFL"
                       INDICATORS ARE SRF-INDICATORS
                       INVALID KEY MOVE FILE-STATUS TO FILE-STATUS
                   END-WRITE
                   IF DISPLAY-STATUS NOT = "00"
                       MOVE "SFL WRITE ERROR*COPY2" TO BU-DISPLAY-MSG
                       MOVE REC-COUNT        TO BU-DISPLAY-FLD (1)
                       MOVE DISPLAY-STATUS   TO BU-DISPLAY-FLD (2)
                       PERFORM 9999-BLOWUP
                   END-IF
                 END-IF
                 READ DRPTMAST-IO NEXT INTO BUF-DRPTMAST
                     AT END MOVE "Y" TO DRPTMAST-EOF-SW
                 END-READ
               END-PERFORM.

       630-SHOW-SCREEN.

      *--- SHOW FUNCTION KEYS.
           WRITE DISPLAY-REC FROM DE-HDR-BUF
               FORMAT IS "COPY2SFLRC"
               INDICATORS ARE SRF-INDICATORS.
           MOVE ALL B"0" TO SRF-INDICATORS.

           MOVE ON-SWITCH TO IND (70)  IND (71)  IND (73).

      *--- WRITE THE SUBFILE TO SCREEN.
           WRITE SUBFILE DISPLAY-REC
               FORMAT IS "COPY2SFLC"
               INDICATORS ARE SRF-INDICATORS.
           MOVE ALL B"0" TO SRF-INDICATORS.
           IF DISPLAY-STATUS NOT = "00"
               MOVE "PROBLEM ON SHOW SFL WRITE*COPY2" TO BU-DISPLAY-MSG
               MOVE REC-COUNT TO BU-DISPLAY-FLD (1)
               MOVE DISPLAY-STATUS TO BU-DISPLAY-FLD (2)
               GO TO 9999-BLOWUP.

      *--- WAIT FOR USER TO PRESS A KEY.
           READ DISPLAY-FILE INTO DE-COPY2-BUF
               FORMAT IS "COPY2SFLC"
               INDICATORS ARE SRF-INDICATORS.
           MOVE ALL B"0" TO SRF-INDICATORS.
           IF DISPLAY-STATUS NOT = "00"
               MOVE "PROBLEM ON READ SFL*COPY2" TO BU-DISPLAY-MSG
               GO TO 9999-BLOWUP.

       630-ACTION.

           IF F3-KEY-USED
               GO TO 63-CP-X.

           MOVE "Y" TO MORE-RECORDS.
           MOVE "N" TO DRPTDIST-EOF-SW.
           PERFORM UNTIL DE-COPY2-SELECT = "X" OR MORE-RECORDS = "N"
               READ SUBFILE DISPLAY-FILE NEXT MODIFIED RECORD
                   INTO DE-COPY2-BUF
                   FORMAT IS "COPY2SFL"
                   AT END MOVE "N" TO MORE-RECORDS
               END-READ
               PERFORM 632-COPY-RECORDS
           END-PERFORM.

       63-CP-X.
           EXIT.

       632-COPY-RECORDS.
           MOVE DE-COPY-ID         TO RPTIDENT OF DRPTDIST-IO-REC.
           MOVE SPACES             TO RPTKEY OF DRPTDIST-IO-REC.
           START DRPTDIST-IO KEY >= EXTERNALLY-DESCRIBED-KEY
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           READ DRPTDIST-IO NEXT INTO BUF-DRPTDIST
               AT END MOVE "Y" TO DRPTDIST-EOF-SW.
           PERFORM UNTIL DRPTDIST-EOF-SW = "Y"
               MOVE DE-COPY2-ID    TO DST-REPORT-ID
                                      RPTIDENT OF DRPTDIST-I-REC
               MOVE DST-REPORT-KEY TO RPTKEY OF DRPTDIST-I-REC
               READ DRPTDIST-I
                   INVALID KEY MOVE FILE-STATUS TO FILE-STATUS
               END-READ
      *-------------- IF THE RPT ID/KEY ALREADY EXISTS, DON'T OVERWRITE.
               IF FILE-STATUS-1 = "2"
                   WRITE DRPTDIST-IO-REC FROM BUF-DRPTDIST
                       INVALID KEY MOVE FILE-STATUS TO FILE-STATUS
                   END-WRITE
               END-IF
               READ DRPTDIST-IO NEXT INTO BUF-DRPTDIST
                   AT END MOVE "Y" TO DRPTDIST-EOF-SW
               END-READ
               IF DST-REPORT-ID NOT = DE-COPY-ID
                   MOVE "Y"        TO DRPTDIST-EOF-SW
               END-IF
           END-PERFORM.

      ******************************************************************
      **              R E P O R T S   P R O C E D U R E               **
      ******************************************************************

       64-REPORTS-PROCEDURE.
           INITIALIZE DISPLAY-REC.

       64-LOAD-SCREEN.

           INITIALIZE REC-COUNT.

      *---- SHOW SFLCTL (71) AND CLEAR SFL (72), BUT DON'T SHOW IT (70).

           MOVE ON-SWITCH    TO IND (71)  IND (72).
           MOVE OFF-SWITCH   TO IND (70).

           WRITE SUBFILE DISPLAY-REC FROM DE-RPT-MSG
               FORMAT IS "RPTSFLC"
               INDICATORS ARE SRF-INDICATORS.
           IF DISPLAY-STATUS NOT = "00"
               MOVE "PROBLEM ON INIT SFL WRITE" TO BU-DISPLAY-MSG
               GO TO 9999-BLOWUP.

      *-------- TURN CLEAR SFL OFF.

           MOVE OFF-SWITCH TO IND (72).

       64-GET-LIST.

           INITIALIZE DE-RPT-BUF.
           MOVE "N"                TO  DRPTMAST-EOF-SW.
           MOVE SPACES TO RPTPROG OF DRPTMAST-IO-REC.
           START DRPTMAST-IO KEY >= EXTERNALLY-DESCRIBED-KEY
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS = "00"
               READ DRPTMAST-IO NEXT INTO BUF-DRPTMAST
                   AT END MOVE "Y" TO DRPTMAST-EOF-SW.
           IF FILE-STATUS = "00"
               PERFORM UNTIL DRPTMAST-EOF-SW = "Y"
                   MOVE MST-RPT-SWITCH TO DE-RPT-SELECT
                   MOVE MST-RPT-DESC   TO DE-RPT-DESC
                   MOVE MST-RPT-PROG   TO DE-RPT-PROG
                   ADD 1               TO REC-COUNT
                   WRITE SUBFILE DISPLAY-REC FROM DE-RPT-BUF
                       FORMAT IS "RPTSFL"
                       INDICATORS ARE SRF-INDICATORS
                   END-WRITE
                   IF DISPLAY-STATUS NOT = "00"
                       MOVE "SUBFILE WRITE ERROR*RPT" TO BU-DISPLAY-MSG
                       MOVE REC-COUNT        TO BU-DISPLAY-FLD (1)
                       MOVE DISPLAY-STATUS   TO BU-DISPLAY-FLD (2)
                   END-IF
                   READ DRPTMAST-IO NEXT INTO BUF-DRPTMAST
                       AT END MOVE "Y" TO DRPTMAST-EOF-SW
                   END-READ
               END-PERFORM.

       64-SHOW-SCREEN.

      *--- SHOW FUNCTION KEYS.
           WRITE DISPLAY-REC FROM DE-RPT-BUF
               FORMAT IS "RPTSFLREC"
               INDICATORS ARE SRF-INDICATORS.
           MOVE ALL B"0" TO SRF-INDICATORS.

           MOVE ON-SWITCH TO IND (70)  IND (71)  IND (73).

      *--- WRITE THE SUBFILE TO SCREEN.
           WRITE SUBFILE DISPLAY-REC FROM DE-RPT-MSG
               FORMAT IS "RPTSFLC"
               INDICATORS ARE SRF-INDICATORS.
           MOVE ALL B"0" TO SRF-INDICATORS.
           IF DISPLAY-STATUS NOT = "00"
               MOVE "PROBLEM ON SHOW SFL WRITE*RPT" TO BU-DISPLAY-MSG
               MOVE REC-COUNT TO BU-DISPLAY-FLD (1)
               MOVE DISPLAY-STATUS TO BU-DISPLAY-FLD (2)
               GO TO 9999-BLOWUP.

      *--- WAIT FOR USER TO PRESS A KEY.
           READ DISPLAY-FILE INTO DE-RPT-MSG
               FORMAT IS "RPTSFLC"
               INDICATORS ARE SRF-INDICATORS.
           MOVE ALL B"0" TO SRF-INDICATORS.
           IF DISPLAY-STATUS NOT = "00"
               MOVE "PROBLEM ON READ SFL*RPT" TO BU-DISPLAY-MSG
               GO TO 9999-BLOWUP.

       64-ACTION.
           IF F3-KEY-USED
               GO TO 64-RP-X.

           MOVE "Y" TO MORE-RECORDS.
           PERFORM UNTIL DE-RPT-SELECT = "X" OR MORE-RECORDS = "N"
               READ SUBFILE DISPLAY-FILE NEXT MODIFIED RECORD
                   INTO DE-RPT-BUF
                   FORMAT IS "RPTSFL"
                   AT END MOVE "N" TO MORE-RECORDS
               END-READ
               IF MORE-RECORDS = "Y"
                   PERFORM 640-WRITE-DRPTMAST
               END-IF
           END-PERFORM.

       64-RP-X.
           EXIT.

       640-WRITE-DRPTMAST.
           MOVE DE-RPT-PROG TO RPTPROG OF DRPTMAST-IO-REC.
           READ DRPTMAST-IO INTO BUF-DRPTMAST
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS = "00"
               MOVE DE-RPT-SELECT  TO  MST-RPT-SWITCH
               REWRITE DRPTMAST-IO-REC FROM BUF-DRPTMAST
                   INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.

      ******************************************************************
      **             U T I L I T Y   S E C T I O N                    **
      ******************************************************************

       9999-UTILITY SECTION.

       9999-CATREAD.
           CALL "CCATREAD" USING CATREAD-PARMS.

       9999-GET-DEFAULT.
           MOVE MST-RPT-ID           TO  RPTIDENT OF DRPTDIST-IO-REC.
           MOVE DEFAULT-KEY          TO  RPTKEY OF DRPTDIST-IO-REC.
           START DRPTDIST-IO KEY = EXTERNALLY-DESCRIBED-KEY
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           READ DRPTDIST-IO INTO BUF-DRPTDIST
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.

       9999-BLOWUP.
           MOVE "TRPTDIST" TO BU-PGM-NAME.
           CALL "TBLOWUP" USING BASE, BU-PGM-NAME, STATUS-AREA,
               VIEW-COMAREA, FILE-STATUS, BU-DISPLAY-MSG,
               BU-DISPLAY-FLDS.
