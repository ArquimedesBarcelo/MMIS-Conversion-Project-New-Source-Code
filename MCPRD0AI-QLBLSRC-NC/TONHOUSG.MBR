           05  FILLER    PIC X(17)  VALUE "FOR MANUFACTURER ".
           05  MANFACT-OUT               PIC X(26).
           05  FILLER                    PIC X      VALUE SPACES.
           05  TOT-OVER-MANFACT-OUT      PIC -(14)9.9(4) VALUE ZEROES.

       01  USAGE-HDR-8.
           05  FILLER    PIC X(13) VALUE "MANUFACTURER ".
           05  PRT-CURRENT-MANFACT       PIC X(26) VALUE SPACES.

       01  USAGE-HDR-10.
           05  FILLER              VALUE SPACE  PIC X(04).
           05  FILLER                    PIC X(39)
               VALUE "VENDORS ON FILE FOR THIS CORPORATE CODE".
           05  FILLER              VALUE SPACE  PIC X(27).
           05  FILLER     VALUE "VENDOR PRICE"  PIC X(12).
           05  FILLER              VALUE SPACE  PIC X(01).
           05  FILLER               VALUE "UM"  PIC X(02).

       01  USAGE-HDR-11.
           05  FILLER              VALUE SPACE  PIC X(21).
           05  FILLER          VALUE "REORDER"  PIC X(07).
           05  FILLER              VALUE SPACE  PIC X(06).
           05  FILLER              VALUE "MAX"  PIC X(03).
           05  FILLER              VALUE SPACE  PIC X(01).
           05  FILLER         VALUE "EXPEDITE"  PIC X(08).
           05  FILLER              VALUE SPACE  PIC X(06).
           05  FILLER              VALUE "SOQ"  PIC X(03).
           05  FILLER              VALUE SPACE  PIC X(01).
           05  FILLER      VALUE "AVG MTH USG"  PIC X(11).
           05  FILLER              VALUE SPACE  PIC X(01).
           05  FILLER          VALUE "LAST PO"  PIC X(07).
           05  FILLER              VALUE SPACE  PIC X(08).
           05  PRT-COST-LIT                     PIC X(08).
           05  FILLER              VALUE SPACE  PIC X(07).
           05  FILLER       VALUE "TOTAL COST"  PIC X(10).

       01  USAGE-HDR-12.
           05  FILLER              VALUE SPACES PIC X(70).
           05  FILLER      VALUE "BIN LOCATION" PIC X(12).
           05  FILLER              VALUE SPACES PIC X(04).
           05  FILLER            VALUE "ONHAND" PIC X(06).

       01  USAGE-HDR-14.
           05  FILLER                    PIC X(68)  VALUE SPACES.
           05  FILLER    PIC X(14)  VALUE "TOTAL OVERAGE ".
           05  FILLER    PIC X(17)  VALUE "FOR BIN LOCATION ".
           05  BINLOC-OUT                PIC X(12).
           05  FILLER                    PIC X      VALUE SPACES.
           05  TOT-OVER-BINLOC-OUT       PIC -(14)9.9(4) VALUE ZEROES.

       01  USAGE-DETAIL-1.
           05  FILLER              VALUE SPACE  PIC X(70).
           05  PRT-BIN-LOC-DESC-1  VALUE SPACE  PIC X(12).
           05  FILLER              VALUE SPACE  PIC X.
           05  PRT-BIN-ONHAND-1    VALUE ZERO   PIC -(8)9.

       01  USAGE-DETAIL-2.
           05  FILLER              VALUE SPACE  PIC X(20).
           05  REORDER-2                 PIC Z(7)9.
           05  FILLER              VALUE SPACE  PIC X.
           05  MAX-2                     PIC Z(7)9.
           05  FILLER              VALUE SPACE  PIC X.
           05  EXPEDITE-2                PIC Z(7)9.
           05  FILLER              VALUE SPACE  PIC X.
           05  SOQ-2                     PIC Z(7)9.
           05  FILLER              VALUE SPACE  PIC X(04).
           05  MTH-FCST-2                PIC Z(7)9.
           05  FILLER              VALUE SPACE  PIC X.
           05  LAST-PO-2                 PIC X(7).
           05  FILLER              VALUE SPACE  PIC X(02).
           05  AVG-COST-2                PIC Z(10)9.99.
           05  FILLER              VALUE SPACE  PIC X.
           05  TOTAL-COST-2              PIC Z(12)9.99.

       01  USAGE-DETAIL-3.
           05  FILLER              VALUE SPACE  PIC X(06).
           05  PRT-LAST-VENDOR-FLAG VALUE SPACE PIC X(01).
           05  FILLER              VALUE SPACE  PIC X(01).
           05  PRT-VEND-NO         VALUE SPACE  PIC X(10).
           05  PRT-VEN-OF-RCD      VALUE SPACE  PIC X(01).
           05  PRT-VEN-QUOTE-FLAG  VALUE SPACE  PIC X(01).
           05  FILLER              VALUE SPACE  PIC X(03).
           05  PRT-VEND-NAME       VALUE SPACE  PIC X(44).
           05  FILLER              VALUE SPACE  PIC X(01).
           05  PRT-VEN-ITM-PRICE   VALUE ZERO   PIC Z(10)9.99.
           05  FILLER              VALUE SPACE  PIC X(01).
           05  PRT-VEN-ITM-UM      VALUE SPACE  PIC X(02).

       01  CONT-MSG-LINE.
           05  CONT-MSG-CORP-CODE        PIC X(07).
           05  FILLER                    PIC X(44)
               VALUE " **** CODE CONTINUED FROM LAST PAGE ****".

       PROCEDURE DIVISION.
       START-UP SECTION.
       HOUSEKEEPING.
9406CK     MOVE "C" TO SCOPE.
9406CK     CALL "MCXCBLERR" USING SCOPE.

           MOVE "N" TO EOF-SW.
           MOVE ZERO TO WS-TOTAL-COST, WS-OVER-GRAND-TOT,
                        WS-OVER-BREAK-TOT, PROJECTED-USAGE,
                        LINE-ADV, LINE-CTR,
                        PG-CTR, ITEM-CTR.
      *-------- ACCEPT ROUTING INFO FROM THE JOB, AGAIN CREATED BY
      *-------- THE OPTION PROGRAM.
           DISPLAY "ENTER ROUTING INFORMATION CARD".
           ACCEPT HD-ROUTE-DATA.
           DISPLAY "ROUTING INFORMATION ENTERED WAS:".
           DISPLAY HD-ROUTE-DATA.

           ACCEPT MTLS-DATA-LINE-1.
           ACCEPT MTLS-DATA-LINE-1B.
           ACCEPT MTLS-DATA-LINE-2.
           ACCEPT MTLS-DATA-LINE-3.

      *------ ACCEPT JOB CARD CREATED BY THE OPTION PROGRAM,
      *------ WHICH CONTAINS THE NUMBER OF MONTHS FOR THE PROJECTION
      *    DISPLAY
      *    "ENTER REPORT OPTION RECORD".
      *    ACCEPT R33-REC.
      *
      * MOVE ZEROES TO NUMERIC DATA ITEMS CONTAINING NON-NUMERIC DATA
      * SCREENS ON AS/400 PERFORM NO EDITING
      *
      *    IF R33-MIN-OVR-USE-COST-X NOT NUMERIC
      *      MOVE ZERO TO R33-MIN-OVR-USE-COST.
      *    IF R33-MONTHS-X NOT NUMERIC
      *      MOVE ZERO TO R33-MONTHS.
      *    IF R33-MIN-OV-MTHS-X NOT NUMERIC
      *      MOVE ZERO TO R33-MIN-OV-MTHS.
      *    IF R33-MIN-OV-X NOT NUMERIC
      *      MOVE ZERO TO R33-MIN-OV.
      *    IF R33-MIN-OBS-X NOT NUMERIC
      *      MOVE ZERO TO R33-MIN-OBS.
      *    IF R33-MIN-SL NOT NUMERIC
      *      MOVE ZERO TO R33-MIN-SL.
      *    IF R33-SELECT-HIGH-VALUE EQUAL SPACES
      *     MOVE R33-SELECT-LOW-VALUE TO R33-SELECT-HIGH-VALUE.
      *
      *
      * DISPLAY EDITED RECORD
      *
      *    DISPLAY "OPTION RECORD ENTERED WAS: ", R33-REC.
      *
      *------ SET UP SPECIAL HEADING AREA WHICH INDICATES WHICH
      *------ SPECIAL OPTIONS WERE CHOSEN.
      *
      *    IF R33-MIN-OV-OPT = "X"
      *      MOVE "Y" TO OPTION-HDR-FLAG
      *      MOVE R33-MIN-OV-MTHS TO PRT-OV-MTHS
      *      MOVE R33-MIN-OV TO PRT-MIN-OV
      *    ELSE
      *      MOVE SPACES TO OVERAGE-AREA.
      *
      *    IF R33-MIN-OBS-OPT = "X"
      *        MOVE "Y"                 TO  OPTION-HDR-FLAG
      *        MOVE R33-MIN-OBS         TO  PRT-MIN-OBS
      *    ELSE
      *        MOVE SPACES TO OBSOLETE-AREA.
      *
      *    IF R33-MIN-SL-OPT = "X"
      *        MOVE "Y"                 TO  OPTION-HDR-FLAG
      *        MOVE R33-MIN-SL          TO  PRT-MIN-SL
      *        MOVE R33-MIN-SL-DATE     TO  MDY-DATE
      *        MOVE MDY-MM              TO  MM, SL-MV-MM
      *        MOVE MDY-DD              TO  DD, SL-MV-DD
      *        MOVE MDY-YY              TO  YY, SL-MV-YY
      *        MOVE UNEDITED-DATE       TO  SLOW-MOVE-DATE
      *---------GET CENTURY FOR SLOW MOVEMENT DATE
      *        IF YY > "70"
      *            MOVE "19" TO SLOW-MOVE-DATE-CC
      *        ELSE
      *            MOVE "20" TO SLOW-MOVE-DATE-CC
      *        END-IF
      *    ELSE
      *        MOVE SPACES              TO  SLOW-MOVER-AREA.
      *
      *
      * BUILD THE PROJECTED USAGE CALCULATION HEADER
      * BASED ON PROJECTION OPTION.
      *
           MOVE SPACES TO PRT-SORT-CALC.
           MOVE MTLS-OVR-USE-COST TO EDIT-FLD-1.
           MOVE 1 TO POS.
           EVALUATE MTLS-ONH-PRJ-OPT
             WHEN "1"
               MOVE MTLS-ONH-MNTH TO EDIT-FLD-2
               STRING "AVG MTH USG * " EDIT-FLD-2
                      " MTHS; MIN = " EDIT-FLD-1
                 DELIMITED BY SIZE INTO PRT-SORT-CALC WITH POINTER POS
             WHEN "2"
               MOVE "N" TO MONTH-PRINTED-FLAG
               PERFORM VARYING SUB FROM 1 BY 1
                       UNTIL SUB GREATER THAN 12
                 IF MTLS-MTH-FLAG(SUB) EQUAL "X"
                   IF MONTH-PRINTED-FLAG EQUAL "Y"
                     STRING "+" MTH-LABEL(SUB) DELIMITED BY SIZE
                       INTO PRT-SORT-CALC WITH POINTER POS
                   ELSE
                     MOVE "Y" TO MONTH-PRINTED-FLAG
                     STRING MTH-LABEL(SUB) DELIMITED BY SIZE
                      INTO PRT-SORT-CALC WITH POINTER POS
                   END-IF
                 END-IF
               END-PERFORM
               STRING "; MIN= " EDIT-FLD-1
                DELIMITED BY SIZE
                INTO PRT-SORT-CALC WITH POINTER POS
           END-EVALUATE.

      *
      * IF INIT DATE SPECIFIED ADD TO HEADER
      *
      *    IF R33-EXCLUDE-NEW EQUAL "X"
      *      MOVE R33-EXCLUDE-NEW-DATE TO  MDY-DATE
      *      MOVE MDY-MM               TO  MM
      *      MOVE MDY-DD               TO  DD
      *      MOVE MDY-YY               TO  YY
      *      MOVE UNEDITED-DATE        TO  R33-EXCLUDE-NEW-DATE
      *                                    EXCLUDE-NEW-DATE
      *-------GET DATE WITH CENTURY FOR R33 EXCLUDE NEW DATE
      *      IF EXCLUDE-NEW-DATE-YY > "70"
      *          MOVE "19" TO EXCLUDE-NEW-DATE-CC
      *      ELSE
      *          MOVE "20" TO EXCLUDE-NEW-DATE-CC
      *      END-IF
      *      STRING "; < " MM "/" DD "/" YY DELIMITED BY SIZE
      *        INTO PRT-SORT-CALC WITH POINTER POS
      *    END-IF.
      *
      *
      * HANDLE SELECTION OPTION
      *
      *    EVALUATE R33-SELECT-OPTION
      *      WHEN "1"
      *        MOVE "CLASS" TO PR-SELECT-OPTION
      *      WHEN "2"
      *        MOVE "KEYWORD/MODIFIER" TO PR-SELECT-OPTION
      *      WHEN "3"
      *        MOVE "MANUFACTURER" TO PR-SELECT-OPTION
      *      WHEN "4"
      *        MOVE "BIN LOCATION" TO PR-SELECT-OPTION
      *    END-EVALUATE.
      *    MOVE R33-SELECT-LOW-VALUE TO PR-LOW-VALUE.
      *    MOVE R33-SELECT-HIGH-VALUE TO PR-HIGH-VALUE.

           OPEN OUTPUT ONLINE-PRT.

      *------ THE CALL TO "GETFNUM" GETS THE FILE NUMBER OF
      *------ THE PRINT FILE WHICH WE JUST OPENED.  THIS IS
      *------ THEN PASSED TO "THDPRT2", WHICH PRINTS THE HEADER
      *------ PAGE AN ROUTING INFORMATION FOR THIS REPORT.

           PERFORM 9999-GETFNUM.

           MOVE "DHDR66.PUB" TO HD-FILE-NAME.
           CALL "THDPRT2" USING HD-RET-CODE, HD-FILE-NAME, FNUM
             HD-ROUTE-DATA, ESC-NAME.
           IF HD-RET-CODE NOT = 0
               MOVE "THDPRT2 ERROR IN HSK" TO BU-DISPLAY-MSG
               MOVE "HD-RET-CODE = " TO BU-DISPLAY-FLD (1)
               MOVE HD-RET-CODE      TO BU-DISPLAY-FLD9 (1)
               PERFORM 2-BLOWUP.

           CALL "TESCSEQ" USING ESC-NAME.
           MOVE CHAR-1636PI TO COMP-ESC-SEQ.
           MOVE CHAR-10PI TO STAND-ESC-SEQ.

           IF NOT PAPER-IS-132-COLS
              MOVE COMP-ESC-SEQ TO PRINT-RCD
              WRITE PRINT-RCD AFTER ADVANCING 0 LINES.

           PERFORM 9999-OPEN-STUFF.

           MOVE MTLS-RPT-TITLE     TO PRT-RPT-TITLE.
           MOVE "TONHOUSG"         TO PRT-PGM-NAME.
           IF MTLS-FROM-RANGE > SPACES OR MTLS-TO-RANGE > SPACES
               PERFORM 9-MOVE-HEADING-DESC.
           IF MTLS-COST-OPT = "M"
               MOVE "MKT COST"     TO PRT-COST-LIT
           ELSE
           IF MTLS-COST-OPT = "A"
               MOVE "AVG COST"     TO PRT-COST-LIT
           ELSE
           IF MTLS-COST-OPT = "R"
               MOVE "REP COST"     TO PRT-COST-LIT.

           MOVE 1 TO DATE-MODE.
           CALL "TDATECHK" USING DATE-CHECK-AREA.
           MOVE DATE-SLASH-OUT TO PRT-DATE.
           MOVE DATE-FORMATTED-TIME-OUT TO PRT-TIME.

           PERFORM 9-MOVE-OPTION-LINES.
           WRITE PRINT-RCD FROM OPTION-LINE-1  AFTER ADVANCING 3 LINES.
           WRITE PRINT-RCD FROM OPTION-LINE-2  AFTER ADVANCING 1 LINE.
           WRITE PRINT-RCD FROM OPTION-LINE-2B AFTER ADVANCING 1 LINE.
           WRITE PRINT-RCD FROM OPTION-LINE-2C AFTER ADVANCING 1 LINE.
           WRITE PRINT-RCD FROM OPTION-LINE-3  AFTER ADVANCING 1 LINE.
           WRITE PRINT-RCD FROM OPTION-LINE-4  AFTER ADVANCING 1 LINE.
           WRITE PRINT-RCD FROM OPTION-LINE-5  AFTER ADVANCING 1 LINE.
           WRITE PRINT-RCD FROM OPTION-LINE-6  AFTER ADVANCING 1 LINE.
           WRITE PRINT-RCD FROM OPTION-LINE-7  AFTER ADVANCING 1 LINE.
           WRITE PRINT-RCD FROM OPTION-LINE-8  AFTER ADVANCING 1 LINE.
           WRITE PRINT-RCD FROM OPTION-LINE-OH AFTER ADVANCING 1 LINE.

       TBL-IS-STACKED.

       COPY MTLSPROC IN COPYLIB.

      *    IF R33-SORT-OPTION EQUAL "1"
      *
      *      SORT SORT-FILE
      *        ON ASCENDING KEY      SORT-CLASS
      *                              SORT-CODE
      *           INPUT  PROCEDURE IS  ABSTRACT-CODES
      *           OUTPUT PROCEDURE IS  WRITE-REPORT
      *
      *    ELSE IF R33-SORT-OPTION EQUAL "2"
      *
      *      SORT SORT-FILE
      *        ON ASCENDING KEY      SORT-MANFACT
      *                              SORT-CODE
      *           INPUT  PROCEDURE IS  ABSTRACT-CODES
      *           OUTPUT PROCEDURE IS  WRITE-REPORT
      *
      *    ELSE IF R33-SORT-OPTION EQUAL "3"
      *
      *      SORT SORT-FILE
      *        ON ASCENDING KEY      SORT-BINLOC
      *                              SORT-CODE
      *           INPUT  PROCEDURE IS  ABSTRACT-CODES
      *           OUTPUT PROCEDURE IS  WRITE-REPORT
      *
      *    END-IF.

       2-SHUTDOWN-DB.
           PERFORM 9999-CLOSE-STUFF.
           IF NOT PAPER-IS-132-COLS
             WRITE PRINT-RCD FROM STAND-ESC-SEQ AFTER ADVANCING 0.
           CLOSE ONLINE-PRT.
           GOBACK.

       2-BLOWUP.
           MOVE "TONHOUSG" TO BU-PGM-NAME.
           CALL "TBLOWUP" USING BASE, BU-PGM-NAME, STATUS-AREA,
               VIEW-COMAREA, DUMMY-KSAM-STAT, BU-DISPLAY-MSG,
               BU-DISPLAY-AREA.

       5-PRINT.
           ADD 1 TO LINE-CTR.
           IF LINE-CTR > 60
             PERFORM 632-PRT-USAGE-TOP
             IF PRINT-CONT-MSG-SW EQUAL "Y"
               MOVE SRT-CORP-CODE TO CONT-MSG-CORP-CODE
               MOVE CONT-MSG-LINE TO PRINT-RCD
               WRITE PRINT-RCD AFTER ADVANCING 1 LINE
               ADD 1 TO LINE-CTR.
           WRITE PRINT-RCD FROM PRINT-LINE AFTER ADVANCING 1 LINE.

       632-PRT-USAGE-TOP.
           MOVE 7 TO LINE-CTR.
           ADD 1 TO PG-CTR.
           MOVE PG-CTR           TO  PRT-PAGE.
      *    MOVE USAGE-HDR-1      TO  PRINT-RCD.
      *    WRITE PRINT-RCD AFTER ADVANCING NEW-PAGE.
           WRITE PRINT-RCD FROM HEADING-1 AFTER ADVANCING NEW-PAGE.
           WRITE PRINT-RCD FROM HEADING-2 AFTER ADVANCING 1 LINE.
           IF MTLS-SORT-OPT > SPACES AND MTLS-SORT-OPT NOT = "01"
             MOVE CNTL-BREAK-HOLD-FIELD TO PRT-H2B-VALUE
             WRITE PRINT-RCD FROM HEADING-2B AFTER ADVANCING 1 LINE
             ADD   1      TO LINE-CTR.

      *    EVALUATE R33-SORT-OPTION
      *      WHEN "1"
      *        MOVE SAVE-STR-CLASS TO PRT-SORT-KEY-OUT
      *      WHEN "2"
      *        MOVE SAVE-MANFACT TO PRT-SORT-KEY-OUT
      *      WHEN "3"
      *        MOVE SAVE-BINLOC TO PRT-SORT-KEY-OUT
      *    END-EVALUATE.
           MOVE USAGE-HDR-2      TO  PRINT-RCD.
           WRITE PRINT-RCD AFTER ADVANCING 1 LINE.

      *    IF R33-SELECT-OPTION EQUAL "1" OR "2" OR "3" OR "4"
      *      ADD 1 TO LINE-CTR
      *      WRITE PRINT-RCD FROM USAGE-HDR-SELECT-OPTION
      *        AFTER ADVANCING 1 LINE
      *    END-IF.
      *
      *    IF OPTION-HDR-FLAG = "Y"
      *        ADD 1 TO LINE-CTR
      *        WRITE PRINT-RCD FROM USAGE-HDR-OPTIONS
      *          AFTER ADVANCING 1 LINE.

      *    IF R33-INS-ONLY EQUAL "X"
      *      MOVE "INSURANCE ITEMS ONLY" TO PRINT-RCD
      *      WRITE PRINT-RCD AFTER ADVANCING 1 LINE
      *      ADD 1 TO LINE-CTR
      *    ELSE IF R33-EXCLUDE-INS EQUAL "X"
      *      MOVE "INSURANCE ITEMS EXCLUDED" TO PRINT-RCD
      *      WRITE PRINT-RCD AFTER ADVANCING 1 LINE
      *      ADD 1 TO LINE-CTR
      *    END-IF.

           MOVE USAGE-HDR-3B1 TO PRINT-RCD.
           WRITE PRINT-RCD AFTER ADVANCING 1 LINE.
           MOVE USAGE-HDR-3B2 TO PRINT-RCD.
           WRITE PRINT-RCD AFTER ADVANCING 1 LINE.
           MOVE USAGE-HDR-3B3 TO PRINT-RCD.
           WRITE PRINT-RCD AFTER ADVANCING 1 LINE.
           MOVE DASH-LINE     TO PRINT-RCD.
           WRITE PRINT-RCD AFTER ADVANCING 1 LINE.

      *632-PRT-CLASS-TOTAL.
      *    MOVE EQUAL-LINE       TO PRINT-LINE.
      *    PERFORM 5-PRINT.
      *    MOVE SPACES TO PRINT-LINE.
      *    PERFORM 5-PRINT.
      *    MOVE SAVE-STR-CLASS  TO CLASS-OUT.
      *    MOVE WS-OVER-BREAK-TOT  TO  TOT-OVER-CLASS-OUT.
      *    MOVE USAGE-HDR-6   TO PRINT-LINE.
      *    PERFORM 5-PRINT.
      *    ADD WS-OVER-BREAK-TOT   TO  WS-OVER-GRAND-TOT.
      *    MOVE ZEROS           TO WS-OVER-BREAK-TOT.
      *    MOVE SORT-CLASS      TO SAVE-STR-CLASS.
      *    PERFORM 632-PRT-USAGE-TOP.
      *
      *632-PRT-MANFACT-TOTAL.
      *    MOVE EQUAL-LINE       TO PRINT-LINE.
      *    PERFORM 5-PRINT.
      *    MOVE SPACES TO PRINT-LINE.
      *    PERFORM 5-PRINT.
      *    MOVE SAVE-MANFACT TO MANFACT-OUT.
      *    MOVE WS-OVER-BREAK-TOT  TO  TOT-OVER-MANFACT-OUT.
      *    MOVE USAGE-HDR-7   TO PRINT-LINE.
      *    PERFORM 5-PRINT.
      *    MOVE ZEROS           TO WS-OVER-BREAK-TOT.
      *    MOVE SORT-MANFACT      TO SAVE-MANFACT.
      *    PERFORM 632-PRT-USAGE-TOP.
      *
      *632-PRT-BINLOC-TOTAL.
      *    MOVE EQUAL-LINE       TO PRINT-LINE.
      *    PERFORM 5-PRINT.
      *    MOVE SPACES TO PRINT-LINE.
      *    PERFORM 5-PRINT.
      *    MOVE SAVE-BINLOC TO BINLOC-OUT.
      *    MOVE WS-OVER-BREAK-TOT  TO  TOT-OVER-BINLOC-OUT.
      *    MOVE USAGE-HDR-14  TO PRINT-LINE.
      *    PERFORM 5-PRINT.
      *    MOVE ZEROS           TO WS-OVER-BREAK-TOT.
      *    MOVE SORT-BINLOC     TO SAVE-BINLOC.
      *    PERFORM 632-PRT-USAGE-TOP.

       RETURN-RCD.
           RETURN SORT-FILE
               AT END
      *          MOVE SPACES TO SORT-RCD
                 MOVE "Y" TO EOF-SW
               NOT AT END
                 ADD 1  TO  ITEM-CTR.

      *--------- PRINT CONTROL BREAKS.
           IF MTLS-SORT-OPT NOT = "01" AND MTLS-SORT-OPT NOT = "  "
               IF EOF-SW NOT = "Y"
                   PERFORM 9-CHECK-CONTROL-BREAK
               END-IF
               IF EOF-SW = "Y" OR CNTL-BREAK-SW = "Y"
                   MOVE SPACES TO PRINT-RCD
                   WRITE PRINT-RCD            AFTER ADVANCING 1 LINE
                   PERFORM 9-PRINT-CONTROL-BREAK
                   MOVE WS-OVER-BREAK-TOT TO PRT-CB-AMOUNT
                   WRITE PRINT-RCD FROM CONTROL-BREAK-LINE
                                              AFTER ADVANCING 1 LINE
                   ADD WS-OVER-BREAK-TOT TO WS-OVER-GRAND-TOT
                   PERFORM 9-MOVE-CONTROL-BREAK
                   MOVE ZEROS TO WS-OVER-BREAK-TOT
                   IF EOF-SW = "N"
                       PERFORM 632-PRT-USAGE-TOP.

      *******************************************
      *                                         *
      *    I N P U T    P R O C E D U R E       *
      *                                         *
      *******************************************

       7-INPUT-RECORDS SECTION.

       COPY MTLSINPT IN COPYLIB.

      *ABSTRACT-CODES SECTION.
      *ACS.
      *
      *    PERFORM 9999-BEGFIL-MSTORERM-I.
      *
      *ABSTRACT-LOOP.
      *
      *** SERIAL GET THRU MSTORERM FOR CODES
      *
      *    PERFORM 9999-GETSER-MSTORERM-I.
      *
      *** END OF SEGMENT (MODE2) GIVES A COND-CODE OF "11"
      *
      *    IF END-OF-FILE
      *      GO TO AC-X.
      *
      *    IF CORP-CODE = "NON-STR "
      *        GO TO ABSTRACT-LOOP.
      *
      *
      * IF WANTED TO EXCLUDE NEW ITEMS THEN DO SO
      *
      *    IF R33-EXCLUDE-NEW = "X"
      *       IF STR-INIT-DATE-CN >= EXCLUDE-NEW-DATE-CN
      *         GO TO ABSTRACT-LOOP.
      *
      *
      * HANDLE SELECTION OPTION
      *
      *    MOVE "N" TO QUALIFY-FLAG.
      *    EVALUATE R33-SELECT-OPTION
      *      WHEN "1"
      *
      *
      * SELECT RANGE OF CLASSES
      *
      *        IF STR-CLASS >= R33-SELECT-LOW-VALUE AND
      *           STR-CLASS <= R33-SELECT-HIGH-VALUE
      *          MOVE "Y" TO QUALIFY-FLAG
      *        END-IF
      *      WHEN "2"
      *
      *
      * SELECT RANGE OF KEYWORD/MODIFIERS
      *
      *        MOVE CORP-CODE TO CODE-ARG
      *        MOVE SPACES TO DESC-ID-NUM
      *        MOVE "N" TO HANDLE-BLOWUP-FLAG
      *        PERFORM 9999-CHAINHD-DDESC-I
      *        PERFORM 9999-GETNEXT-DDESC-I
      *        PERFORM UNTIL NOT GOOD-CALL OR
      *                      DESC-ID-NUM EQUAL "00"
      *            PERFORM 9999-GETNEXT-DDESC-I
      *        END-PERFORM
      *        MOVE "Y" TO HANDLE-BLOWUP-FLAG
      *        IF DESC-ID-NUM EQUAL "00"
      *          IF DESC-KWM >= R33-SELECT-LOW-VALUE AND
      *             DESC-KWM <= R33-SELECT-HIGH-VALUE
      *            MOVE "Y" TO QUALIFY-FLAG
      *          END-IF
      *        END-IF
      *      WHEN "3"
      *
      *
      * SELECT RANGE OF MANUFACTURES
      *
      *
      * ONLY PERFORM CHECK IF NOT SORT BY MANUFACTURER -- IF SORT
      * BY MANFACTURER THEN WILL BE GOING THROUGH LIST OF MANUFACTURES
      * WHEN RELEASING TO SORT FILE SO DON'T BOTHER CHECKING TWICE
      *
      *        IF R33-SORT-OPTION NOT EQUAL "2"
      *
      *          MOVE CORP-CODE TO CODE-ARG
      *          MOVE "N" TO HANDLE-BLOWUP-FLAG
      *          PERFORM 9999-CHAINHD-DMANPART-I
      *          PERFORM 9999-GETNEXT-DMANPART-I
      *          PERFORM UNTIL NOT GOOD-CALL OR
      *                        QUALIFY-FLAG EQUAL "Y"
      *
      *             IF MAN-NAME >= R33-SELECT-LOW-VALUE AND
      *                MAN-NAME <= R33-SELECT-HIGH-VALUE
      *               MOVE "Y" TO QUALIFY-FLAG
      *             ELSE
      *               PERFORM 9999-GETNEXT-DDESC-I
      *             END-IF
      *
      *          END-PERFORM
      *          MOVE "Y" TO HANDLE-BLOWUP-FLAG
      *        ELSE
      *          MOVE "Y" TO QUALIFY-FLAG
      *        END-IF
      *      WHEN "4"
      *
      *
      * SELECT RANGE OF BIN LOCATIONS
      *
      *
      * ONLY BOTHER CHECKING BIN LOCATION IF SORT BY BIN LOCATION NOT
      * SELECTED -- IF SORT BY BIN LOCATION SELECTED THEN CODE WILL BE
      * CHECKED FOR BIN LOCATIONS IN RANGE SPECIFIED WHEN RELEASING
      * TO SORT FILE.
      *
      *        IF R33-SORT-OPTION NOT EQUAL "3"
      *          PERFORM VARYING SUB FROM 1 BY 1
      *                  UNTIL QUALIFY-FLAG EQUAL "Y" OR
      *                        SUB GREATER THAN 6
      *
      *            IF STR-LOC(SUB) NOT EQUAL SPACES AND
      *               STR-LOC(SUB) >= R33-SELECT-LOW-VALUE AND
      *               STR-LOC(SUB) <= R33-SELECT-HIGH-VALUE
      *              MOVE "Y" TO QUALIFY-FLAG
      *            END-IF
      *
      *          END-PERFORM
      *        ELSE
      *          MOVE "Y" TO QUALIFY-FLAG
      *        END-IF
      *      WHEN OTHER
      *        MOVE "Y" TO QUALIFY-FLAG
      *    END-EVALUATE.
      *
      *
      * IF DIDN'T QUALIFY FOR SELECTION SPECIFIED THEN GO BACK
      * TO THE TOP OF THE LOOP
      *
      *    IF QUALIFY-FLAG EQUAL "N"
      *      GO TO ABSTRACT-LOOP.
      *
      *------ IF USER ASKED TO EXCLUDE INSURANCE ITEMS, DO SO
      *    IF R33-EXCLUDE-INS = "X"
      *        IF STR-INS-ITM = "X" OR "B"
      *            GO TO ABSTRACT-LOOP.
      *
      *------  IF THE USER WANTED ONLY INSURANCE ITEMS, EXCLUDE
      *------  ALL OTHERS.
      *    IF R33-INS-ONLY = "X"
      *        IF STR-INS-ITM = "X" OR = "B"
      *            NEXT SENTENCE
      *        ELSE
      *            GO TO ABSTRACT-LOOP.
      *
      *    MOVE SPACES TO  SORT-RCD.
      *    IF STR-MTH-FCST < ZERO
      *        MOVE ZERO TO STR-MTH-FCST.
      *
      *    COMPUTE WS-TOTAL-COST = STR-ONHAND * STR-AVG-COST.
      *
      *------ IF USER ASKED FOR OBSOLETE ITEMS TO BE EXCLUDED FROM
      *------ THE REPORT, EXCLUDE THESE ITEMS (TAKING INTO ACCOUNT
      *------ MINIMUM VALUE OF OBSOLETE ITEMS TO EXCLUDE).
      *
      *    IF R33-MIN-OBS-OPT = "X"
      *         IF STR-STOCK-OT = "X"
      *              IF WS-TOTAL-COST < R33-MIN-OBS
      *                  NEXT SENTENCE
      *              ELSE
      *                 GO TO ABSTRACT-LOOP.
      *
      *------ IF THE USER WANTED TO EXCLUDE SLOW MOVERS FROM
      *------ THE REPORT, EXCLUDE THESE ITEMS, TAKING INTO ACCOUNT
      *------ THE SLOW MOVER DATE TO EXCLUDE AND THE MINIMUM VALUE.
      *
      *    IF R33-MIN-SL-OPT = "X"
      *        IF STR-INS-ITM = "X" OR "B" OR "1"
      *            NEXT SENTENCE
      *        ELSE
      *        IF STR-REORDER = 0 AND STR-EXPEDITE = 0
      *          AND STR-ONHAND = 0
      *             NEXT SENTENCE
      *        ELSE
      *        IF STR-LAST-IDATE = SPACES
      *            IF STR-INIT-DATE-CN < SLOW-MOVE-DATE-CN
      *                IF WS-TOTAL-COST < R33-MIN-SL
      *                    NEXT SENTENCE
      *                ELSE
      *                    GO TO ABSTRACT-LOOP
      *            ELSE
      *                NEXT SENTENCE
      *        ELSE
      *        IF STR-LAST-IDATE-CN < SLOW-MOVE-DATE-CN
      *            IF WS-TOTAL-COST < R33-MIN-SL
      *                NEXT SENTENCE
      *            ELSE
      *                GO TO ABSTRACT-LOOP.
      *
      *---------- IF THE USER WANTED TO EXCLUDE ITEMS THAT APPEARED
      *---------- ON AN EARLIER OVERAGE REPORT, EXCLUDE THESE ITEMS.
      *---------- ALSO TAKE INTO ACCOUNT PROJECTED OVERAGE IF ENTERED
      *
      *    IF R33-MIN-OV-OPT = "X"
      *      COMPUTE PROJECTED-ONHAND =
      *        STR-ONHAND - (STR-MTH-FCST * R33-MIN-OV-MTHS)
      *      COMPUTE OVERAGE = (PROJECTED-ONHAND - STR-MAX)
      *      IF OVERAGE > 0
      *        COMPUTE OVERAGE-COST =
      *          OVERAGE * STR-AVG-COST
      *        IF OVERAGE-COST < R33-MIN-OV
      *            NEXT SENTENCE
      *        ELSE
      *            GO TO ABSTRACT-LOOP.
      *
      *
      * CALCULATE PROJECTED USAGE BASED ON PROJECTION OPTION
      *
      *    IF R33-PROJ-OPTION EQUAL "1"
      *      COMPUTE SORT-PROJ-USAGE = STR-MTH-FCST * R33-MONTHS
      *    ELSE IF R33-PROJ-OPTION EQUAL "2"
      *      MOVE CORP-CODE TO CODE-ARG
      *      PERFORM 9999-GETKEY-USAGEFIL-CD-I
      *      IF NO-ENTRY
      *        MOVE CODE-ARG TO BU-DISPLAY-FLD(1)
      *        MOVE "CODE NOT FOUND IN USAGE FILE" TO
      *          BU-DISPLAY-MSG
      *        PERFORM 2-BLOWUP
      *      END-IF
      *      MOVE 0 TO SORT-PROJ-USAGE
      *      PERFORM VARYING SUB FROM 1 BY 1
      *              UNTIL SUB GREATER THAN 12
      *        IF R33-MTH-FLAG(SUB) EQUAL "X"
      *          ADD K-MTH-USAGE(SUB) TO SORT-PROJ-USAGE
      *        END-IF
      *      END-PERFORM
      *    END-IF.
      *
      *    IF SORT-PROJ-USAGE < 0
      *      MOVE 0 TO SORT-PROJ-USAGE.
      *
      *    IF STR-ONHAND <= SORT-PROJ-USAGE
      *      GO TO ABSTRACT-LOOP
      *    ELSE
      *      COMPUTE
      *        SORT-OVR-USE-COST = (STR-ONHAND - SORT-PROJ-USAGE)
      *                            * STR-AVG-COST
      *      IF SORT-OVR-USE-COST LESS THAN R33-MIN-OVR-USE-COST
      *        GO TO ABSTRACT-LOOP.
      *
      *    MOVE CORP-CODE  TO  SORT-CODE.
      *    MOVE STR-CLASS  TO  SORT-CLASS.
      *    MOVE STR-ONHAND TO  SORT-ONHAND.
      *    IF R33-PRINT-BINLOCS EQUAL "X"
      *
      *      PERFORM VARYING SUB FROM 1 BY 1
      *              UNTIL SUB GREATER THAN 6
      *
      *        MOVE STR-LOC(SUB) TO SORT-LOC(SUB)
      *        MOVE STR-LOC-ONHAND(SUB) TO SORT-LOC-ONHAND(SUB)
      *
      *      END-PERFORM
      *
      *    END-IF.
      *    MOVE STR-LAST-IDATE  TO SORT-LAST-IDATE.
      *    MOVE STR-ACT-DATE    TO SORT-LAST-ADATE.
      *    MOVE STR-INIT-DATE   TO SORT-LAST-SDATE.
      *    MOVE STR-UM          TO SORT-UM.
      *    MOVE STR-MAX         TO SORT-MAX.
      *    MOVE STR-REORDER     TO SORT-REORDER.
      *    MOVE STR-EXPEDITE    TO SORT-EXPEDITE.
      *    MOVE STR-SOQ         TO SORT-SOQ.
      *    MOVE STR-MTH-FCST    TO SORT-MTH-FCST.
      *    MOVE STR-AVG-COST    TO SORT-AVG-COST.
      *    MOVE STR-LAST-VENDOR TO SORT-LAST-VENDOR.
      *    MOVE STR-LAST-PO     TO SORT-LAST-PO.
      *
      *    IF R33-SORT-OPTION EQUAL "1"
      *
      *      RELEASE SORT-RCD
      *
      *    ELSE IF R33-SORT-OPTION EQUAL "2"
      *
      *
      * PRODUCE AN ENTRY FOR EACH MANUFACTURER FOUND IF SORT-OPTION
      * 2 HAS BEEN SELECTED
      *
      *
      * ONLY RELEASE IF MANUFACTURER IS IN RANGE IF OPTION SELECTED
      * AND IF SELECT BY MANUFACTURER HAS BEEN SPECIFIED
      *
      *      MOVE CORP-CODE TO CODE-ARG
      *      PERFORM 9999-CHAINHD-DMANPART-I
      *      PERFORM 9999-GETNEXT-DMANPART-I
      *      IF END-OF-CHAIN
      *        MOVE SPACES TO MAN-NAME
      *        IF R33-SELECT-OPTION EQUAL "3"
      *          IF MAN-NAME >= R33-SELECT-LOW-VALUE AND
      *             MAN-NAME <= R33-SELECT-HIGH-VALUE
      *
      *            MOVE MAN-NAME TO SORT-MANFACT
      *            RELEASE SORT-RCD
      *
      *          END-IF
      *        ELSE
      *
      *          MOVE MAN-NAME TO SORT-MANFACT
      *          RELEASE SORT-RCD
      *
      *        END-IF
      *      ELSE
      *        PERFORM UNTIL END-OF-CHAIN
      *
      *          IF R33-SELECT-OPTION EQUAL "3"
      *            IF MAN-NAME >= R33-SELECT-LOW-VALUE AND
      *               MAN-NAME <= R33-SELECT-HIGH-VALUE
      *
      *              MOVE MAN-NAME TO SORT-MANFACT
      *              RELEASE SORT-RCD
      *
      *            END-IF
      *          ELSE
      *
      *            MOVE MAN-NAME TO SORT-MANFACT
      *            RELEASE SORT-RCD
      *
      *          END-IF
      *          PERFORM 9999-GETNEXT-DMANPART-I
      *
      *        END-PERFORM
      *
      *      END-IF
      *
      *    ELSE IF R33-SORT-OPTION EQUAL "3"
      *
      * PRODUCE AN ENTRY FOR EACH BIN LOCATION - ONLY SPACE IF NONE CONFIGED
      *
      *
      * ONLY IF IN SELECT RANGE IF BIN LOCATION SELECT SPECIFIED
      *
      *      PERFORM VARYING SUB FROM 1 BY 1
      *              UNTIL SUB GREATER THAN 6
      *
      *        IF STR-LOC(SUB) NOT EQUAL SPACES
      *
      *          IF R33-SELECT-OPTION EQUAL "4"
      *
      *
      * RELEASE THIS RECORD IF ITS IN THE SELECTED RANGE
      *
      *            IF STR-LOC(SUB) >= R33-SELECT-LOW-VALUE AND
      *               STR-LOC(SUB) <= R33-SELECT-HIGH-VALUE
      *
      *              MOVE STR-LOC(SUB) TO SORT-BINLOC
      *              RELEASE SORT-RCD
      *
      *            END-IF
      *          ELSE
      *
      *            MOVE STR-LOC(SUB) TO SORT-BINLOC
      *            RELEASE SORT-RCD
      *
      *          END-IF
      *
      *        END-IF
      *
      *      END-PERFORM
      *
      *    END-IF.
      *
      *    GO TO ABSTRACT-LOOP.
      *AC-X.
      *    EXIT.
      *
       7-IR-EXIT.
           EXIT.

      *******************************************
      *                                         *
      *    O U T P U T   P R O C E D U R E      *
      *                                         *
      *******************************************

       8-WRITE-RECORDS SECTION.

      *WRITE-REPORT SECTION.
       WRITE-RPT.
           MOVE SPACES TO PRINT-RCD.
           RETURN SORT-FILE
               AT END
                 MOVE "Y" TO EOF-SW
               NOT AT END
                 ADD 1 TO ITEM-CTR.
           IF EOF-SW = "Y"
              PERFORM 632-PRT-USAGE-TOP
              GO TO WR-X.
      *    PERFORM RETURN-RCD.
           MOVE 0 TO PG-CTR.
      *    MOVE PRT-TIME TO PRT-OV-HDR-TIME.
      *    MOVE PRT-DATE TO PRT-OV-HDR-DATE.
      *    EVALUATE R33-SORT-OPTION
      *      WHEN "1"
      *        MOVE "CLASS" TO PRT-SORT-OPTION
      *        MOVE SORT-CLASS  TO  SAVE-STR-CLASS
      *      WHEN "2"
      *        MOVE "MANUFACTURER" TO PRT-SORT-OPTION
      *        MOVE SORT-MANFACT TO SAVE-MANFACT
      *      WHEN "3"
      *        MOVE "BIN LOCATION" TO PRT-SORT-OPTION
      *        MOVE SORT-BINLOC TO SAVE-BINLOC
      *    END-EVALUATE.

           PERFORM 9-MOVE-CONTROL-BREAK.

           PERFORM 632-PRT-USAGE-TOP.

           MOVE 4 TO DATE-MODE.
      *
      * DISABLE CONTINUE MESSAGE
      *
           MOVE "N" TO PRINT-CONT-MSG-SW.

      *******************************************
      *                                         *
      *    O V E R A G E    R E P O R T         *
      *                                         *
      *******************************************

      **
      ** LOOP BEGIN
      **
           PERFORM UNTIL EOF-SW EQUAL "Y"
      *
      * CHECK FOR BREAK
      *
      *      EVALUATE R33-SORT-OPTION
      *        WHEN "1"
      *          IF SORT-CLASS NOT EQUAL SAVE-STR-CLASS
      *            PERFORM 632-PRT-CLASS-TOTAL
      *          END-IF
      *        WHEN "2"
      *          IF SORT-MANFACT NOT EQUAL SAVE-MANFACT
      *            PERFORM 632-PRT-MANFACT-TOTAL
      *          END-IF
      *        WHEN "3"
      *          IF SORT-BINLOC NOT EQUAL SAVE-BINLOC
      *            PERFORM 632-PRT-BINLOC-TOTAL
      *          END-IF
      *      END-EVALUATE

             MOVE SRT-CORP-CODE TO CORPCDE OF MSTORERM-REC-I
             READ MSTORERM-I INTO BUF-MSTORERM
                 INVALID KEY MOVE FILE-STATUS TO FILE-STATUS
             END-READ
             IF FILE-STATUS NOT = 00
                 INITIALIZE BUF-MSTORERM
             END-IF

             MOVE SRT-CORP-CODE      TO  PRT-CODE
             MOVE SRT-UM             TO  PRT-UM
             MOVE SRT-ONHAND         TO  PRT-ONHAND
             MOVE SRT-PROJ-USAGE     TO  PRT-PROJ-USAGE
      *
      * FORMAT LAST ISSUE, LAST ACTIVITY AND ADD TO STOCK DATES
      *
             MOVE SRT-LAST-IDATE TO DATE-VALIDATE-IN
             CALL "TDATECHK" USING DATE-CHECK-AREA
             MOVE DATE-SLASH-OUT TO PRT-LAST-IDATE
             MOVE STR-ACT-DATE TO DATE-VALIDATE-IN
             CALL "TDATECHK" USING DATE-CHECK-AREA
             MOVE DATE-SLASH-OUT TO PRT-LAST-ADATE
             MOVE STR-INIT-DATE TO DATE-VALIDATE-IN
             CALL "TDATECHK" USING DATE-CHECK-AREA
             MOVE DATE-SLASH-OUT TO PRT-LAST-SDATE
      *
      * IF NO LAST ISSUE DATE AVAILABLE MOVE THE ADD TO STOCK DATE IN
      *
             IF SRT-LAST-IDATE EQUAL SPACES
               MOVE DATE-SLASH-OUT TO PRT-LAST-IDATE
               MOVE "*" TO PRT-ASTERICK
             ELSE
               MOVE SPACE TO PRT-ASTERICK
             END-IF

             COMPUTE
               WS-OVR-USE-COST = (STR-ONHAND - SRT-PROJ-USAGE)
                               * STR-AVG-COST
             ADD WS-OVR-USE-COST   TO  WS-OVER-BREAK-TOT
             IF MTLS-SORT-OPT = "01" OR MTLS-SORT-OPT = "  "
                 ADD WS-OVR-USE-COST TO WS-OVER-GRAND-TOT
             END-IF
             MOVE WS-OVR-USE-COST  TO  PRT-OVER-COST
      *
      * PRINT THE DESCRITION
      *
             MOVE SRT-CORP-CODE    TO  CODE-ARG
             CALL "CDESC"   USING RET-CODE,
                                  BASE,
                                  STATUS-AREA,
                                  BU-DISPLAY-MSG,
                                  CODE-ARG,
                                  CDESC-DATA
             IF BU-DISPLAY-MSG-1 NOT = SPACES
                  MOVE CODE-ARG TO BU-DISPLAY-FLD (2)
                  PERFORM 2-BLOWUP
             END-IF
      *      MOVE CDESC(1) TO PRT-OVER-DESC
             MOVE SRT-KEYWD-MOD TO PRT-OVER-DESC
             MOVE USAGE-HDR-4 TO PRINT-LINE
             PERFORM 5-PRINT
      *
      * ENABLE CONTINUE MESSAGE
      *
             MOVE "Y" TO PRINT-CONT-MSG-SW

             IF MTLS-DESC-OPT = "X"
               PERFORM VARYING SUB FROM 2 BY 1
                     UNTIL SUB GREATER THAN CDESC-LINES-GOT

                 MOVE CDESC (SUB) TO PRT-FULL-DESC
                 MOVE PRT-FULL-DESCRIPTION TO PRINT-LINE
                 PERFORM 5-PRINT

               END-PERFORM
             END-IF
      *
      * PRINT THE VENDORS FOR THIS CODE
      *
             MOVE SRT-CORP-CODE TO CODE-ARG
             PERFORM 9999-CHAINHD-DVENDITM-CD-I
             PERFORM 9999-GETNEXT-DVENDITM-CD-I
      *
      * INITIAL RECORD - NO VENDORS FOUND
      *
             IF END-OF-CHAIN
               MOVE "    **NO VENDORS ON FILE**" TO PRINT-LINE
               PERFORM 5-PRINT
             ELSE
      *
      * GET ALL VENDORS
      *
               MOVE USAGE-HDR-10 TO PRINT-LINE
               PERFORM 5-PRINT
               PERFORM UNTIL END-OF-CHAIN

      *
      * PRINT THE VENDOR NAME
      *
                 IF STR-LAST-VENDOR EQUAL VEN-ITM-VENCODE
                   MOVE "*" TO PRT-LAST-VENDOR-FLAG
                 ELSE
                   MOVE SPACE TO PRT-LAST-VENDOR-FLAG
                 END-IF
                 MOVE VEN-OF-RCD TO PRT-VEN-OF-RCD
                 MOVE VEN-QUOTE-FLAG TO PRT-VEN-QUOTE-FLAG
                 MOVE VEN-ITM-PRICE  TO PRT-VEN-ITM-PRICE
                 MOVE VEN-ITM-PRICE-UM TO PRT-VEN-ITM-UM
                 MOVE VEN-ITM-VENCODE TO VEN-ARG, PRT-VEND-NO
                 PERFORM 9999-CHAINHD-DVENDOR-VN-I
                 PERFORM 9999-GETNEXT-DVENDOR-VN-I
                 IF ( END-OF-CHAIN              ) OR
                    ( VEN-ITM-NO NOT EQUAL ZERO )
                   MOVE "**NO VENDOR NAME ON FILE**" TO PRT-VEND-NAME
                   MOVE USAGE-DETAIL-3 TO PRINT-LINE
                   PERFORM 5-PRINT
                 ELSE
                   MOVE VEN-NAME TO PRT-VEND-NAME
                   MOVE USAGE-DETAIL-3 TO PRINT-LINE
                   PERFORM 5-PRINT
                 END-IF
      *
      * GET NEXT VENDOR
      *
                 PERFORM 9999-GETNEXT-DVENDITM-CD-I

               END-PERFORM

             END-IF
      *
      * PRINT REDORDER, MAX, EXPEDITE, SOQ, LAST PO, AVG COST & TOTAL COST
      *
             MOVE SPACES TO PRINT-LINE
             PERFORM 5-PRINT
             MOVE USAGE-HDR-11 TO PRINT-LINE
             PERFORM 5-PRINT
             MOVE SRT-REORDER TO REORDER-2
             MOVE SRT-MAX TO MAX-2
             MOVE SRT-EXPEDITE TO EXPEDITE-2
             MOVE STR-SOQ TO SOQ-2
             MOVE STR-MTH-FCST TO MTH-FCST-2
             MOVE STR-LAST-PO TO LAST-PO-2
             MOVE SRT-COST TO AVG-COST-2
             COMPUTE TOTAL-COST = SRT-COST * SRT-ONHAND
             MOVE TOTAL-COST TO TOTAL-COST-2
             MOVE USAGE-DETAIL-2 TO PRINT-LINE
             PERFORM 5-PRINT
      *
      * PRINT ONHAND BY BIN LOCATION IF SPECIFIED
      *
             IF MTLS-ONH-BIN EQUAL "X"

      *
      * PRINT BLANK LINE AND HEADER
      *
               MOVE SPACES TO PRINT-LINE
               PERFORM 5-PRINT
               MOVE USAGE-HDR-12 TO PRINT-LINE
               PERFORM 5-PRINT
      *
      * PRINT BIN LOCATIONS ONHAND QUANTITIES
      *
               PERFORM VARYING SUB FROM 1 BY 1
                       UNTIL SUB GREATER THAN 6

                 IF STR-LOC(SUB) NOT EQUAL SPACE

                   MOVE STR-LOC(SUB) TO PRT-BIN-LOC-DESC-1
                   MOVE STR-LOC-ONHAND(SUB) TO PRT-BIN-ONHAND-1
                   MOVE USAGE-DETAIL-1 TO PRINT-LINE
                   PERFORM 5-PRINT

                 END-IF

               END-PERFORM

             END-IF
      *
      * PRINT A DASH LINE
      *
             MOVE DASH-LINE TO PRINT-LINE
             MOVE "N" TO PRINT-CONT-MSG-SW
             PERFORM 5-PRINT
      *
      * GET NEXT RECORD
      *
             PERFORM RETURN-RCD

           END-PERFORM.
      **
      ** END OF LOOP
      **

           IF ITEM-CTR GREATER THAN ZERO
               MOVE SPACES  TO  CNTL-BREAK-HOLD-FIELD
                                HEADING-2B
               PERFORM 632-PRT-USAGE-TOP
      *
      * PRINT LAST BREAK AND
      * PRINT TOTAL LINE, ONLY IF NOT SORT BY MANUFACTURER BECAUSE OF
      * DUPLICATES
      *
      *      EVALUATE R33-SORT-OPTION
      *        WHEN "1"
             IF MTLS-SORT-OPT NOT = "06" AND
                MTLS-SORT-OPT NOT = "08"
      *          PERFORM 632-PRT-CLASS-TOTAL
                 MOVE SPACES TO PRINT-LINE
                 PERFORM 5-PRINT
                 MOVE ITEM-CTR           TO  PRT-ITEMS
                 MOVE WS-OVER-GRAND-TOT  TO  PRT-OVER-GRAND-TOT
                 MOVE USAGE-HDR-5      TO  PRINT-LINE
                 PERFORM 5-PRINT
             ELSE IF MTLS-SORT-OPT = "06"
      *        WHEN "2"
      *          PERFORM 632-PRT-MANFACT-TOTAL
                 MOVE
                  "GRAND TOTALS NOT PRINTED FOR SORT BY MANUFACTURER"
                 TO PRINT-LINE
                 PERFORM 5-PRINT
                 MOVE "BECAUSE THEY WOULD BE INACURATE" TO PRINT-LINE
                 PERFORM 5-PRINT
                 MOVE
                  "DUE TO MULTIPLE OCCURANCES OF EACH CORPORATE CODE"
                 TO PRINT-LINE
                 PERFORM 5-PRINT
               ELSE IF MTLS-SORT-OPT = "08"
      *        WHEN "3"
      *          PERFORM 632-PRT-BINLOC-TOTAL
                 MOVE
                  "GRAND TOTALS NOT PRINTED FOR SORT BY BIN LOCATION"
                 TO PRINT-LINE
                 PERFORM 5-PRINT
                 MOVE "BECAUSE THEY WOULD BE INACURATE" TO PRINT-LINE
                 PERFORM 5-PRINT
                 MOVE
                  "DUE TO MULTIPLE OCCURANCES OF EACH CORPORATE CODE"
                 TO PRINT-LINE
                 PERFORM 5-PRINT
      *      END-EVALUATE
             END-IF

           ELSE

             MOVE "NO ITEMS QUALIFIED FOR REPORT" TO PRINT-RCD
             WRITE PRINT-RCD AFTER ADVANCING 2 LINES

           END-IF.

       WR-X.
           EXIT.

       COPYLIB-MEMBERS SECTION.
       9999-GETFNUM.
      * DUMMY COPYLIB MEMBER ON AS/400

       9999-OPEN-STUFF.
           OPEN INPUT DDESC-I              .
           OPEN INPUT MSTORERM-I           .
           OPEN INPUT DMANPART-I           .
           OPEN INPUT DVENDITM-CD-I        .
           OPEN INPUT DVENDOR-VN-I         .
           OPEN INPUT USAGEFIL-CD-I        .

       9999-CLOSE-STUFF.
           CLOSE      DDESC-I              .
           CLOSE      MSTORERM-I           .
           CLOSE      DMANPART-I           .
           CLOSE      DVENDITM-CD-I        .
           CLOSE      DVENDOR-VN-I         .
           CLOSE      USAGEFIL-CD-I        .

       9999-CHAINHD-DDESC-I.
           MOVE 0 TO COND-WORD.
           MOVE CODE-ARG TO CORPCDE OF DDESC-REC-I.
           START DDESC-I KEY = CORPCDE OF DDESC-REC-I
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF (FILE-STATUS NOT = "00") AND (FILE-STATUS-1 NOT = "2")
               MOVE 99 TO COND-WORD
               IF HANDLE-BLOWUP-FLAG = "Y"
                   MOVE "CHAINHD ERR 9999-CHAINHD-DDESC-I"
                       TO BU-MSG-AREA
                   PERFORM 2-BLOWUP.

       9999-GETNEXT-DDESC-I.
           MOVE 0 TO COND-WORD.
           READ DDESC-I NEXT INTO BUF-DDESC
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   MOVE 15 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD
                   IF HANDLE-BLOWUP-FLAG = "Y"
                       MOVE "GETNEXT ERR 9999-GETNEXT-DDESC-I"
                           TO BU-MSG-AREA
                       PERFORM 2-BLOWUP
                   END-IF
           ELSE
           IF CORPCDE OF DDESC-REC-I NOT = CODE-ARG
               MOVE 15 TO COND-WORD.

       9999-CHAINHD-DMANPART-I.
           MOVE 0 TO COND-WORD.
           MOVE CODE-ARG TO CORPCDE OF DMANPART-REC-I.
           START DMANPART-I KEY = CORPCDE OF DMANPART-REC-I
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF (FILE-STATUS NOT = "00") AND (FILE-STATUS-1 NOT = "2")
               MOVE 99 TO COND-WORD
               IF HANDLE-BLOWUP-FLAG = "Y"
                   MOVE "CHAINHD ERR 9999-CHAINHD-DMANPART-I"
                       TO BU-MSG-AREA
                   PERFORM 2-BLOWUP.

       9999-GETNEXT-DMANPART-I.
           MOVE 0 TO COND-WORD.
           READ DMANPART-I NEXT INTO BUF-DMANPART
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   MOVE 15 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD
                   IF HANDLE-BLOWUP-FLAG = "Y"
                       MOVE "GETNEXT ERR 9999-GETNEXT-DMANPART-I"
                           TO BU-MSG-AREA
                       PERFORM 2-BLOWUP
                   END-IF
           ELSE
           IF CORPCDE OF DMANPART-REC-I NOT = CODE-ARG
               MOVE 15 TO COND-WORD.

       9999-CHAINHD-DVENDITM-CD-I.
           MOVE 0 TO COND-WORD.
           MOVE CODE-ARG TO CORPCDE OF DVENDITM-CD-REC-I.
           START DVENDITM-CD-I KEY = CORPCDE OF DVENDITM-CD-REC-I
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF (FILE-STATUS NOT = "00") AND (FILE-STATUS-1 NOT = "2")
               MOVE 99 TO COND-WORD
               IF HANDLE-BLOWUP-FLAG = "Y"
                   MOVE "CHAINHD ERR 9999-CHAINHD-DVENDITM-CD-I"
                       TO BU-MSG-AREA
                   PERFORM 2-BLOWUP.

       9999-GETNEXT-DVENDITM-CD-I.
           MOVE 0 TO COND-WORD.
           READ DVENDITM-CD-I NEXT INTO BUF-DVENDITM
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   MOVE 15 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD
                   IF HANDLE-BLOWUP-FLAG = "Y"
                       MOVE "GETNEXT ERR 9999-GETNEXT-DVENDITM-CD-I"
                           TO BU-MSG-AREA
                       PERFORM 2-BLOWUP
                   END-IF
           ELSE
           IF CORPCDE OF DVENDITM-CD-REC-I NOT = CODE-ARG
               MOVE 15 TO COND-WORD.

       9999-CHAINHD-DVENDOR-VN-I.
           MOVE 0 TO COND-WORD.
           MOVE VEN-ARG TO VENCDE OF DVENDOR-VN-REC-I.
           START DVENDOR-VN-I KEY = VENCDE OF DVENDOR-VN-REC-I
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF (FILE-STATUS NOT = "00") AND (FILE-STATUS-1 NOT = "2")
               MOVE 99 TO COND-WORD
               IF HANDLE-BLOWUP-FLAG = "Y"
                   MOVE "CHAINHD ERR 9999-CHAINHD-DVENDOR-VN-I"
                       TO BU-MSG-AREA
                   PERFORM 2-BLOWUP.

       9999-GETNEXT-DVENDOR-VN-I.
           MOVE 0 TO COND-WORD.
           READ DVENDOR-VN-I NEXT INTO BUF-DVENDOR
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   MOVE 15 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD
                   IF HANDLE-BLOWUP-FLAG = "Y"
                       MOVE "GETNEXT ERR 9999-GETNEXT-DVENDOR-VN-I"
                           TO BU-MSG-AREA
                       PERFORM 2-BLOWUP
                   END-IF
           ELSE
           IF VENCDE OF DVENDOR-VN-REC-I NOT = VEN-ARG
               MOVE 15 TO COND-WORD.

       9999-GETSER-MSTORERM-I.
           MOVE 0 TO COND-WORD.
           READ MSTORERM-I NEXT INTO BUF-MSTORERM
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS-1 = "1"
               MOVE 11 TO COND-WORD
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD
               IF HANDLE-BLOWUP-FLAG = "Y"
                   MOVE "GETSER ERR 9999-GETSER-MSTORERM-I"
                       TO BU-MSG-AREA
                   PERFORM 2-BLOWUP.

       9999-BEGFIL-MSTORERM-I.
           MOVE SPACES TO CORPCDE OF MSTORERM-REC-I.
           START MSTORERM-I KEY >= CORPCDE OF MSTORERM-REC-I
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.

       9999-GETKEY-USAGEFIL-CD-I.
           MOVE 0 TO COND-WORD.
           MOVE CODE-ARG TO CORPCDE OF USAGEFIL-CD-REC-I.
           READ USAGEFIL-CD-I INTO BUF-USAGEFIL
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS = "23"
               MOVE 17 TO COND-WORD
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD.

       COPY MTLSUTIL IN COPYLIB.

       9-COMPUTE-USAGE.
           MOVE CORP-CODE TO CODE-ARG.
           PERFORM 9999-GETKEY-USAGEFIL-CD-I.
           IF NO-ENTRY
               MOVE CODE-ARG TO BU-DISPLAY-FLD(1)
               MOVE "CODE NOT FOUND IN USAGE FILE" TO
                 BU-DISPLAY-MSG
               PERFORM 2-BLOWUP.
           MOVE 0 TO SRT-PROJ-USAGE.
           PERFORM VARYING SUB FROM 1 BY 1
                   UNTIL SUB GREATER THAN 12
               IF MTLS-MTH-FLAG(SUB) EQUAL "X"
                 ADD K-MTH-USAGE(SUB) TO SRT-PROJ-USAGE
               END-IF
           END-PERFORM.
