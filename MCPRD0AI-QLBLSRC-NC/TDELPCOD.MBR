       IDENTIFICATION DIVISION.
       PROGRAM-ID.   TDELPCOD.
      *REMARKS.
      *        ********************************************************
      *        * Deletes personnel absence codes from the master file *
      *        ********************************************************
       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.
       SOURCE-COMPUTER.    AS400.
       OBJECT-COMPUTER.    AS400.
       SPECIAL-NAMES.      I-O-FEEDBACK IS I-O-FEEDBACK-AREA
                           LOCAL-DATA IS LOCAL-DATA-AREA.
001000 INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT DISPLAY-FILE
               ASSIGN TO WORKSTATION-ZPERSON-SI
               ORGANIZATION IS TRANSACTION
               ACCESS IS SEQUENTIAL
               FILE STATUS IS DSPLY-STATUS
               CONTROL-AREA IS WS-CONTROL.
           SELECT PER-ABSENCE-MSTR
               ASSIGN TO DATABASE-MCFLMM2901
               ORGANIZATION IS INDEXED
               ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
               FILE STATUS IS PAM-STATUS.
002200 DATA DIVISION.
       FILE SECTION.
       FD  DISPLAY-FILE
           LABEL RECORDS ARE OMITTED.
       01  DSPLY-REC                   PIC X(2000).
       FD  PER-ABSENCE-MSTR
           LABEL RECORDS ARE STANDARD
           DATA RECORD IS PAMREC.
       01  PAMREC.
           COPY DDS-ALL-FORMATS OF MCFLMM2901.
       WORKING-STORAGE SECTION.
       COPY CATREAD OF COPYLIB.
       COPY CPYIND  OF COPYLIB.
       01  CODE-BUFFER.
           05  CODE-B                  PIC XX.
           05  DESC-B                  PIC X(30).
           05  CODE-CMD-LINE           PIC X(79).
           05  CODE-ERR-LINE           PIC X(79).
       01  DSPLY-STATUS                PIC XX.
       01  ERROR-BUFFER.
           05  FILLER                  PIC X(14).
           05  ERR-CODE                PIC XX.
           05  FILLER                  PIC X(64).
       COPY IOFEEDBACK OF COPYLIB.
       01  PAM-STATUS                  PIC XX.
       01  PASSWORD-INFORMATION.
           05  NAME-OF-PROGRAM         PIC X(08) VALUE "TDELPCOD".
           05  PROGRAM-TYPE            PIC X(02) VALUE "MA".
           05  PROGRAM-RELEASE         PIC X(12) VALUE " E0100010001".
           05  PROGRAM-DESCRIPTION.
               10  PROG-DESC-A         PIC X(60) VALUE
                 "PERSONNEL SYSTEM ABSENCE CODE DELETE PROGRAM".
               10  PROG-DESC-B         PIC X(60) VALUE SPACES.
               10  PROG-FUNCTION       PIC X(60) VALUE SPACES.
           05  PASSWORD-FLAG           PIC X.
       01  SCREEN-BUFF                 PIC XX.
       COPY DBSTAT    OF COPYLIB.
       01  TRUE-VAL                    PIC 1 VALUE B"1".
       COPY WSCONTROL OF COPYLIB.
       LINKAGE SECTION.
       01  DBPARAMETERS.               COPY DBPARMS  OF COPYLIB.
       COPY VCOMLINK  OF COPYLIB.
       01  PLT-IDT                     PIC X(4).
       PROCEDURE DIVISION USING DBPARAMETERS
                                VIEW-COMAREA
                                PLT-IDT.
       START-PGM.
           PERFORM 1-HSK.
           PERFORM 6-MAIN UNTIL VIEW-LASTKEY = 3.
       2-EOJ.
           CLOSE DISPLAY-FILE.
           CLOSE PER-ABSENCE-MSTR.
           GOBACK.
       1-HSK.
           OPEN I-O   DISPLAY-FILE.
           OPEN I-O   PER-ABSENCE-MSTR.
           CALL "TPWORD" USING PASSWORD-INFORMATION.
           IF PASSWORD-FLAG = "N" GO TO 2-EOJ.
           MOVE SPACES TO CODE-BUFFER.
       6-MAIN.
           MOVE "FDELPCOD" TO VIEW-CFNAME.
           MOVE CODE-BUFFER TO DSPLY-REC.
           PERFORM 99-SCREEN-WRITE.
           PERFORM 98-SCREEN-READ.
           MOVE DSPLY-REC TO CODE-BUFFER.
           IF VIEW-LASTKEY = 3 GO TO 2-EOJ.
           PERFORM 69-START-PER-ABSENCE-MSTR.
           IF COND-WORD = 17
               MOVE 27009 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE ERROR-BUFFER TO CODE-ERR-LINE
               MOVE TRUE-VAL TO INDS (1) INDS (99)
               GO TO 6-MAIN.
           PERFORM 69-READ-PER-ABSENCE-MSTR.
           IF COND-WORD = 11 GO TO 2-EOJ.
           PERFORM 69-DELETE-PER-ABSENCE-MSTR.
           IF COND-WORD = 17 GO TO 2-EOJ.
           MOVE 66197 TO CATREAD-MSG-NUMBER.
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
           MOVE CODE-B TO ERR-CODE.
           MOVE ERROR-BUFFER TO CODE-CMD-LINE.
           MOVE CODE-BUFFER TO DSPLY-REC.
           MOVE TRUE-VAL TO INDS (98).
           PERFORM 99-SCREEN-WRITE.
           PERFORM 98A-SCREEN-READ.
           CALL "CLPAUSE2".
           MOVE SPACES TO ERROR-BUFFER CODE-BUFFER.

       69-DELETE-PER-ABSENCE-MSTR.
           MOVE 0 TO COND-WORD.
           DELETE PER-ABSENCE-MSTR
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF PAM-STATUS NOT = "00" MOVE 17 TO COND-WORD.

       69-READ-PER-ABSENCE-MSTR.
           MOVE 0 TO COND-WORD.
           READ PER-ABSENCE-MSTR NEXT INTO CODE-BUFFER
               AT END    MOVE 11 TO COND-WORD.
           IF PAM-STATUS NOT = "00" MOVE 11 TO COND-WORD.

       69-START-PER-ABSENCE-MSTR.
           MOVE 0 TO COND-WORD.
           MOVE CODE-B TO PERABSCODE OF PAMREC.
           START PER-ABSENCE-MSTR KEY IS = EXTERNALLY-DESCRIBED-KEY
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF PAM-STATUS NOT = "00" MOVE 17 TO COND-WORD.

       98-SCREEN-READ.
           READ DISPLAY-FILE FORMAT IS VIEW-CFNAME
               INDIC IS INDICS.
           ACCEPT IOFEEDBACK FROM I-O-FEEDBACK-AREA.
           MOVE ALL B"0" TO INDICS.
           IF DSPLY-STATUS NOT = "00"
               MOVE 3 TO VIEW-LASTKEY
           ELSE
           MOVE FUNCTION-NUM TO VIEW-LASTKEY.

       98A-SCREEN-READ.
           READ DISPLAY-FILE TERMINAL IS TERMINAL-ID
               INDIC IS INDICS
                  NO DATA MOVE DSPLY-STATUS TO DSPLY-STATUS.
           MOVE ALL B"0" TO INDICS.

       99-SCREEN-WRITE.
           WRITE DSPLY-REC FORMAT IS VIEW-CFNAME
               INDIC IS INDICS.
           MOVE ALL B"0" TO INDICS.

025900 999-CATREAD.
026000     MOVE SPACES TO ERROR-BUFFER.
026100     CALL "CCATREAD" USING CATREAD-PARMS.
026200     MOVE CATREAD-MSG-TEXT TO ERROR-BUFFER.
027000 999-CATREAD-EXIT.
027100     EXIT.
