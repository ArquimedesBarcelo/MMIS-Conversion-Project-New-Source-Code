           05  CON-WORD  PIC XX.

           COPY SCREENIO       IN COPYLIB.

           COPY CATREAD        IN COPYLIB.

           COPY JCWAREA        IN COPYLIB.

           COPY OVRPFDATA      IN COPYLIB.

           COPY ERRORLIN       IN COPYLIB.

       01  WO-BASIC-DATA.
           COPY DWOBASIC       IN COPYLIB.

       01  WO-PLANNED-DATA.
           COPY DWOPLAN        IN COPYLIB.

       01  ZONE-DATA.
           COPY MZONPRTY       IN COPYLIB.

       01  LABOR-CURR-DATA.
           COPY DCURRLBR       IN COPYLIB.

       01  WO-PERS-DATA.
           COPY MPERSONL       IN COPYLIB.

       LINKAGE SECTION.
       01  DBPARAMETERS.
           COPY DBPARMS        IN COPYLIB.

       PROCEDURE DIVISION      USING DBPARAMETERS.
       BEGIN-PROC              SECTION 01.
       OPEN-FILES.
           MOVE 1              TO SORT-SW.
           MOVE 0              TO PRINT-SW.
           CALL               "CLWOIPINQ".
           OPEN INPUT          LABOR-CURRENT-STAT.
           OPEN INPUT          WO-BASIC.
           OPEN INPUT          WO-PLANNED.
           OPEN INPUT          WO-ZONE-PRTY.
           OPEN INPUT          PER-PERSONNEL.
           OPEN I-O            DISPLAY-FILE.
           OPEN I-O            DISPLAY-FILE-2.
           ACCEPT              MC-LOCAL-DATA-AREA
               FROM            LOCAL-DATA-AREA.

      *    MOVE 0              TO OVRPRTF-TOFILE-NUM.
           MOVE "P "           TO OVRPRTF-TOFILE-NUM-X.
           MOVE "MCPRT"        TO OVRPRTF-FILE.
           PERFORM 996-OVERRIDE-PRINT-FILE.

       BEGIN.
           MOVE SPACES         TO SCREEN-DATA MESSAGE-BUFFER
                                  LINE-DATA.

           IF JCW-ZJCW-269 = "    "
               CALL "TRTVZONE" USING ZONE-BUF
               IF ZONE-BUF = SPACES
                   GO TO END-OF-JOB
               ELSE
                   MOVE ZONE-BUF TO ZONE-FIELD
           ELSE
               MOVE JCW-ZJCW-269 TO ZONE-BUF ZONE-FIELD.

           MOVE ZONE-FIELD     TO ZONE-DISP P-ZONE.
           MOVE "VWOIPINQ"     TO SCREEN-NAME.
           GO TO 6-MAIN.

       6-MAIN.
           MOVE 0              TO ACT-KEY PAGE-CTR.
           MOVE 60             TO LINE-CTR.
           IF SORT-SW = 1
               SORT SORT-FILE      ASCENDING KEY SORT-CC-NAME
                 INPUT  PROCEDURE  SORT-IN-PROC
                 OUTPUT PROCEDURE  SORT-OUT-PROC
           ELSE
           IF SORT-SW = 2
               SORT SORT-FILE      ASCENDING KEY SORT-CC-NUM
                 INPUT  PROCEDURE  SORT-IN-PROC
                 OUTPUT PROCEDURE  SORT-OUT-PROC
           ELSE
           IF SORT-SW = 3
               SORT SORT-FILE      ASCENDING KEY SORT-WO-NUM
                 INPUT  PROCEDURE  SORT-IN-PROC
                 OUTPUT PROCEDURE  SORT-OUT-PROC
           ELSE
           IF SORT-SW = 4
               SORT SORT-FILE      ASCENDING KEY SORT-EQUIP
                 INPUT  PROCEDURE  SORT-IN-PROC
                 OUTPUT PROCEDURE  SORT-OUT-PROC.

           IF ACT-KEY = 0
               MOVE SPACES     TO SCREEN-DATA
               MOVE ZONE-FIELD TO ZONE-DISP P-ZONE
               MOVE SCREEN-DATA TO DISPLAY-REC
      ************************************************************
      ****  MESSAGE:  NO RECORDS FOUND WHICH MATCH YOUR SELECTION
      ************************************************************
               MOVE  40        TO CATREAD-MSG-SET
               MOVE  11        TO CATREAD-MSG-NUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER TO ERRMSG
               MOVE TRUE-VAL   TO IND(99)
               OPEN INPUT      OUT-FILE
               GO TO 61-SHOWFORM.

           MOVE 0              TO ACT-KEY.
           OPEN INPUT          OUT-FILE.

       61-RESET-SCREEN.
           MOVE SPACES         TO SCREEN-DATA.
           MOVE ZONE-FIELD     TO ZONE-DISP P-ZONE.
           PERFORM 62-FILL-SCREEN THRU 62-FS-EXIT.
      ************************************************************
      ****  MESSAGE:  PRESS `ENTER' TO CONTINUE OR
      ****                        PRESS APPROPRIATE FUNCTION KEY
      ************************************************************
           MOVE  42            TO CATREAD-MSG-SET.
           MOVE  69            TO CATREAD-MSG-NUM.
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
           MOVE MESSAGE-BUFFER TO CMDMSG.

       61-SHOWFORM.
           MOVE "00"           TO SCREEN-STATUS.
           MOVE SCREEN-DATA    TO DISPLAY-REC.

           WRITE DISPLAY-REC   FORMAT IS SCREEN-NAME
                               INDIC ARE SCREEN-INDICATORS.
           IF SCREEN-STATUS NOT = "00"
               DISPLAY "SCREEN WRITE ERROR.  SCREEN-STATUS IS "
                               SCREEN-STATUS
               GO TO END-OF-JOB.

           READ  DISPLAY-FILE  FORMAT IS SCREEN-NAME
                               INDIC ARE SCREEN-INDICATORS
           IF SCREEN-STATUS NOT = "00"
               DISPLAY "SCREEN READ ERROR.  SCREEN-STATUS IS "
                               SCREEN-STATUS
               GO TO END-OF-JOB.

           MOVE DISPLAY-REC    TO SCREEN-DATA.
           MOVE ALL B"0"       TO SCREEN-INDICATORS.

           IF KEY-HIT = 3 OR 8
               GO TO END-OF-JOB.

           IF KEY-HIT = 1
               MOVE "    "     TO JCW-ZJCW-269
               CLOSE           OUT-FILE
               GO TO BEGIN.

           IF KEY-HIT = 2
               MOVE 1          TO PRINT-SW
               CLOSE           OUT-FILE
               ACCEPT CUR-DATE FROM DATE
               MOVE CUR-YY     TO P-DATE-YY
               MOVE CUR-MM     TO P-DATE-MM
               MOVE CUR-DD     TO P-DATE-DD
               ACCEPT TIME-BUF FROM TIME
               MOVE HRS        TO TIME-H
               MOVE MIN        TO TIME-M
               MOVE SEC        TO TIME-S
               MOVE TIME-EXP   TO P-TIME
               GO TO 6-MAIN.

           IF KEY-HIT = 4
               MOVE 1          TO SORT-SW
               CLOSE           OUT-FILE
               GO TO 6-MAIN.

           IF KEY-HIT = 5
               MOVE 2          TO SORT-SW
               CLOSE           OUT-FILE
               GO TO 6-MAIN.

           IF KEY-HIT = 6
               MOVE 3          TO SORT-SW
               CLOSE           OUT-FILE
               GO TO 6-MAIN.

           IF KEY-HIT = 7
               MOVE 4          TO SORT-SW
               CLOSE           OUT-FILE
               GO TO 6-MAIN.

           IF KEY-HIT NOT = 0
               GO TO 61-SHOWFORM.

           IF EOF-SW = 1
               MOVE 0          TO EOF-SW
               MOVE 0          TO ACT-KEY.

           GO TO 61-RESET-SCREEN.

       62-FILL-SCREEN.
           ADD 1               TO ACT-KEY.
           MOVE SPACES         TO OUT-REC.
           READ OUT-FILE       INVALID KEY
               MOVE 1          TO EOF-SW
               GO TO 62-FS-EXIT.
           IF ACT-KEY > MAX-KEY
               MOVE 1          TO EOF-SW
               GO TO 62-FS-EXIT.
           PERFORM 62-MOVE-DATA.
           MOVE LINE-DATA      TO LINE-1.

           ADD 1               TO ACT-KEY.
           MOVE SPACES         TO OUT-REC.
           READ OUT-FILE       INVALID KEY
               MOVE 1          TO EOF-SW
               GO TO 62-FS-EXIT.
           IF ACT-KEY > MAX-KEY
               MOVE 1          TO EOF-SW
               GO TO 62-FS-EXIT.
           PERFORM 62-MOVE-DATA.
           MOVE LINE-DATA      TO LINE-2.

           ADD 1               TO ACT-KEY.
           MOVE SPACES         TO OUT-REC.
           READ OUT-FILE       INVALID KEY
               MOVE 1          TO EOF-SW
               GO TO 62-FS-EXIT.
           IF ACT-KEY > MAX-KEY
               MOVE 1          TO EOF-SW
               GO TO 62-FS-EXIT.
           PERFORM 62-MOVE-DATA.
           MOVE LINE-DATA      TO LINE-3.

           ADD 1               TO ACT-KEY.
           MOVE SPACES         TO OUT-REC.
           READ OUT-FILE       INVALID KEY
               MOVE 1          TO EOF-SW
               GO TO 62-FS-EXIT.
           IF ACT-KEY > MAX-KEY
               MOVE 1          TO EOF-SW
               GO TO 62-FS-EXIT.
           PERFORM 62-MOVE-DATA.
           MOVE LINE-DATA      TO LINE-4.

           ADD 1               TO ACT-KEY.
           MOVE SPACES         TO OUT-REC.
           READ OUT-FILE       INVALID KEY
               MOVE 1          TO EOF-SW
               GO TO 62-FS-EXIT.
           IF ACT-KEY > MAX-KEY
               MOVE 1          TO EOF-SW
               GO TO 62-FS-EXIT.
           PERFORM 62-MOVE-DATA.
           MOVE LINE-DATA      TO LINE-5.

           ADD 1               TO ACT-KEY.
           MOVE SPACES         TO OUT-REC.
           READ OUT-FILE       INVALID KEY
               MOVE 1          TO EOF-SW
               GO TO 62-FS-EXIT.
           IF ACT-KEY > MAX-KEY
               MOVE 1          TO EOF-SW
               GO TO 62-FS-EXIT.
           PERFORM 62-MOVE-DATA.
           MOVE LINE-DATA      TO LINE-6.

           ADD 1               TO ACT-KEY.
           MOVE SPACES         TO OUT-REC.
           READ OUT-FILE       INVALID KEY
               MOVE 1          TO EOF-SW
               GO TO 62-FS-EXIT.
           IF ACT-KEY > MAX-KEY
               MOVE 1          TO EOF-SW
               GO TO 62-FS-EXIT.
           PERFORM 62-MOVE-DATA.
           MOVE LINE-DATA      TO LINE-7.

           ADD 1               TO ACT-KEY.
           MOVE SPACES         TO OUT-REC.
           READ OUT-FILE       INVALID KEY
               MOVE 1          TO EOF-SW
               GO TO 62-FS-EXIT.
           IF ACT-KEY > MAX-KEY
               MOVE 1          TO EOF-SW
               GO TO 62-FS-EXIT.
           PERFORM 62-MOVE-DATA.
           MOVE LINE-DATA      TO LINE-8.

           ADD 1               TO ACT-KEY.
           MOVE SPACES         TO OUT-REC.
           READ OUT-FILE       INVALID KEY
               MOVE 1          TO EOF-SW
               GO TO 62-FS-EXIT.
           IF ACT-KEY > MAX-KEY
               MOVE 1          TO EOF-SW
               GO TO 62-FS-EXIT.
           PERFORM 62-MOVE-DATA.
           MOVE LINE-DATA      TO LINE-9.

           ADD 1               TO ACT-KEY.
           MOVE SPACES         TO OUT-REC.
           READ OUT-FILE       INVALID KEY
               MOVE 1          TO EOF-SW
               GO TO 62-FS-EXIT.
           IF ACT-KEY > MAX-KEY
               MOVE 1          TO EOF-SW
               GO TO 62-FS-EXIT.
           PERFORM 62-MOVE-DATA.
           MOVE LINE-DATA      TO LINE-10.

           ADD 1               TO ACT-KEY.
           MOVE SPACES         TO OUT-REC.
           READ OUT-FILE       INVALID KEY
               MOVE 1          TO EOF-SW
               GO TO 62-FS-EXIT.
           IF ACT-KEY > MAX-KEY
               MOVE 1          TO EOF-SW
               GO TO 62-FS-EXIT.
           PERFORM 62-MOVE-DATA.
           MOVE LINE-DATA      TO LINE-11.

           ADD 1               TO ACT-KEY.
           MOVE SPACES         TO OUT-REC.
           READ OUT-FILE       INVALID KEY
               MOVE 1          TO EOF-SW
               GO TO 62-FS-EXIT.
           IF ACT-KEY > MAX-KEY
               MOVE 1          TO EOF-SW
               GO TO 62-FS-EXIT.
           PERFORM 62-MOVE-DATA.
           MOVE LINE-DATA      TO LINE-12.

           ADD 1               TO ACT-KEY.
           MOVE SPACES         TO OUT-REC.
           READ OUT-FILE       INVALID KEY
               MOVE 1          TO EOF-SW
               GO TO 62-FS-EXIT.
           IF ACT-KEY > MAX-KEY
               MOVE 1          TO EOF-SW
               GO TO 62-FS-EXIT.
           PERFORM 62-MOVE-DATA.
           MOVE LINE-DATA      TO LINE-13.

           ADD 1               TO ACT-KEY.
           MOVE SPACES         TO OUT-REC.
           READ OUT-FILE       INVALID KEY
               MOVE 1          TO EOF-SW
               GO TO 62-FS-EXIT.
           IF ACT-KEY > MAX-KEY
               MOVE 1          TO EOF-SW
               GO TO 62-FS-EXIT.
           PERFORM 62-MOVE-DATA.
           MOVE LINE-DATA      TO LINE-14.

           ADD 1               TO ACT-KEY.
           MOVE SPACES         TO OUT-REC.
           READ OUT-FILE       INVALID KEY
               MOVE 1          TO EOF-SW
               GO TO 62-FS-EXIT.
           IF ACT-KEY > MAX-KEY
               MOVE 1          TO EOF-SW
               GO TO 62-FS-EXIT.
           PERFORM 62-MOVE-DATA.
           MOVE LINE-DATA      TO LINE-15.

           ADD 1               TO ACT-KEY.
           MOVE SPACES         TO OUT-REC.
           READ OUT-FILE       INVALID KEY
               MOVE 1          TO EOF-SW
               GO TO 62-FS-EXIT.
           IF ACT-KEY > MAX-KEY
               MOVE 1          TO EOF-SW
               GO TO 62-FS-EXIT.
           PERFORM 62-MOVE-DATA.
           MOVE LINE-DATA      TO LINE-16.

       62-FS-EXIT.             EXIT.

       62-MOVE-DATA.
           MOVE SPACES         TO  LINE-DATA.
           MOVE OUT-CC-NUM     TO  CC-BUF.
           MOVE OUT-CC-NAME    TO  NAME-BUF.
           MOVE OUT-WO-NUM     TO  WO-BUF.
           MOVE OUT-EQUIP      TO  EQUIP-BUF.
           MOVE OUT-DESCRIPT   TO  DESC-BUF.

       END-OF-JOB.
           CLOSE               LABOR-CURRENT-STAT.
           CLOSE               WO-BASIC.
           CLOSE               WO-PLANNED.
           CLOSE               WO-ZONE-PRTY.
           CLOSE               PER-PERSONNEL.
           CLOSE               DISPLAY-FILE.
           CLOSE               DISPLAY-FILE-2.
           CLOSE               OUT-FILE.
           GOBACK.

       999-CATREAD.
           MOVE SPACES         TO MESSAGE-BUFFER.
           CALL "CCATREAD"     USING CATREAD-PARMS.
           MOVE CATREAD-MSG-TEXT TO MESSAGE-BUFFER.

       999-CATREAD-EXIT.       EXIT.

       SORT-IN-PROC            SECTION 02.
       SORT-IN-PROC-MAIN.
           PERFORM SORT-MAIN   THRU SORT-M-EXIT.
           GO TO SORT-IP-EXIT.

       SORT-MAIN.
           MOVE SPACES         TO SORT-REC.
           READ LABOR-CURRENT-STAT FIRST INTO LABOR-CURR-STAT
               AT END          MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
               IF FILE-STAT = "10" OR "14" OR "46"
                   GO TO SORT-M-EXIT
               ELSE
                   MOVE FILE-STAT  TO CON-WORD
                   MOVE "READ FST" TO DB-FUNC
                   MOVE "LABOR-CURRENT-STAT" TO DB-FILE
                   MOVE DB-ERROR   TO MESSAGE-BUFFER
                   GO TO 61-SHOWFORM.

           GO TO SORT-CONT.

       SORT-LOOP.
           MOVE SPACES         TO SORT-REC.
           READ LABOR-CURRENT-STAT NEXT INTO LABOR-CURR-STAT
               AT END          MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
               IF FILE-STAT = "10" OR "14" OR "46"
                   GO TO SORT-M-EXIT
               ELSE
                   MOVE FILE-STAT  TO CON-WORD
                   MOVE "READ NXT" TO DB-FUNC
                   MOVE "LABOR-CURRENT-STAT" TO DB-FILE
                   MOVE DB-ERROR   TO MESSAGE-BUFFER
                   GO TO 61-SHOWFORM.

       SORT-CONT.
           MOVE EMP-NO         TO PERCCNUM OF PER-PERSONNEL.
           READ PER-PERSONNEL  INTO WO-PERS-DATA
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
               DISPLAY "CRAFTSMAN " EMP-NO
                             " NOT FOUND IN PERSONNEL FILE."
               GO TO SORT-LOOP.

           MOVE EMP-NO         TO SORT-CC-NUM.
           MOVE PER-EMP-NAME   TO SORT-CC-NAME.
           MOVE LCS-WO-NUM     TO WONUM OF WO-BASIC
                                  WONUM OF WO-PLANNED.
           READ WO-BASIC       INTO WO-BASIC-DATA
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
               IF FILE-STAT-1 = "2"
                   GO TO READ-PLANNED
               ELSE
                   MOVE FILE-STAT  TO CON-WORD
                   MOVE "READ    " TO DB-FUNC
                   MOVE "WO-BASIC" TO DB-FILE
                   MOVE DB-ERROR   TO MESSAGE-BUFFER
                   MOVE MESSAGE-BUFFER TO ERRMSG
                   MOVE TRUE-VAL   TO IND(99)
                   GO TO SORT-M-EXIT.

           IF ZONE-BUF = "ALL "
               NEXT SENTENCE
           ELSE
               IF ZONE NOT = ZONE-BUF
                   GO TO SORT-LOOP.

           MOVE WO-NUM         TO SORT-WO-NUM.
           MOVE EQUIP-NUM      TO SORT-EQUIP.
           MOVE DESCRIPTION-1  TO SORT-DESCRIPT.
           GO TO CONT-PROC.

       READ-PLANNED.
           READ WO-PLANNED     INTO WO-PLANNED-DATA
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
               IF FILE-STAT-1 = "2"
                   GO TO SORT-LOOP
               ELSE
                   MOVE FILE-STAT  TO CON-WORD
                   MOVE "READ    " TO DB-FUNC
                   MOVE "WO-PLANNED" TO DB-FILE
                   MOVE DB-ERROR   TO MESSAGE-BUFFER
                   MOVE MESSAGE-BUFFER TO ERRMSG
                   MOVE TRUE-VAL   TO IND(99)
                   GO TO SORT-M-EXIT.

           IF ZONE-BUF = "ALL "
               NEXT SENTENCE
           ELSE
               IF ZONE-P NOT = ZONE-BUF
                   GO TO SORT-LOOP.

           MOVE WO-NUM-PLANNED  TO SORT-WO-NUM.
           MOVE EQUIP-NUM-P     TO SORT-EQUIP.
           MOVE DESCRIPTION-1-P TO SORT-DESCRIPT.
           IF SPECL-INSTR-2 NOT = SPACES
               MOVE SPECL-INSTR-2
                                TO SORT-DESCRIPT.

       CONT-PROC.
           RELEASE             SORT-REC.
           GO TO SORT-LOOP.

       SORT-M-EXIT.            EXIT.

       SORT-IP-EXIT.           EXIT.

       SORT-OUT-PROC           SECTION 03.
       SORT-OUT-PROC-MAIN.
           OPEN OUTPUT         OUT-FILE.
           PERFORM SORT-READ-LOOP THRU SRL-EXIT.
           CLOSE               OUT-FILE.
           PERFORM SORT-PRINT-LOOP THRU SPL-EXIT.
           GO TO SORT-OP-EXIT.

       SORT-READ-LOOP.
           RETURN SORT-FILE    AT END
               MOVE ACT-KEY    TO MAX-KEY
               GO TO SRL-EXIT.
           ADD 1               TO ACT-KEY.
           MOVE SORT-REC       TO OUT-REC.
           WRITE OUT-REC       INVALID KEY
               DISPLAY "WRITE OUT-FILE ERR"
               GO TO SRL-EXIT.
           GO TO SORT-READ-LOOP.

       SRL-EXIT.               EXIT.

       SORT-PRINT-LOOP.
           IF PRINT-SWITCH-IS-OFF
               GO TO SPL-EXIT.

           MOVE 0              TO OVRPRTF-TOFILE-NUM.
           MOVE "MCPRT"        TO OVRPRTF-FILE.
           PERFORM 996-OVERRIDE-PRINT-FILE.
           MOVE 0              TO ACT-KEY.
           OPEN INPUT          OUT-FILE.
           OPEN OUTPUT         PRINT-FILE.

       PRINT-LOOP.
           IF LINE-CTR > 59
               PERFORM PRINT-HEADINGS.

           ADD 1               TO ACT-KEY.
           MOVE SPACES         TO OUT-REC.
           READ OUT-FILE       INVALID KEY
               GO TO PL-EXIT.
           IF ACT-KEY > MAX-KEY
               GO TO PL-EXIT.

           MOVE OUT-CC-NUM     TO P-CC.
           MOVE OUT-CC-NAME    TO P-NA.
           MOVE OUT-WO-NUM     TO P-WO.
           MOVE OUT-EQUIP      TO P-EQP.
           MOVE OUT-DESCRIPT   TO P-DESC.
           MOVE PRINT-LINE     TO PRINT-REC.
           WRITE PRINT-REC     AFTER ADVANCING 1 LINES.
           ADD  1              TO LINE-CTR.
           GO TO PRINT-LOOP.

       PL-EXIT.
           CLOSE               OUT-FILE.
           CLOSE               PRINT-FILE.
           MOVE 0              TO PRINT-SW.
           GO TO SPL-EXIT.

       PRINT-HEADINGS.
           ADD  1              TO PAGE-CTR.
           MOVE PAGE-CTR       TO ZPAGE.
           MOVE DATE-HEADER    TO PRINT-REC.
           WRITE PRINT-REC     AFTER ADVANCING NEW-PAGE.
           MOVE DASH-LINE      TO PRINT-REC.
           WRITE PRINT-REC     AFTER ADVANCING 1 LINES.
           MOVE TITLE-HEADER   TO PRINT-REC.
           WRITE PRINT-REC     AFTER ADVANCING 1 LINES.
           MOVE DASH-LINE      TO PRINT-REC.
           WRITE PRINT-REC     AFTER ADVANCING 1 LINES.
           MOVE TEXT-HEADER    TO PRINT-REC
           WRITE PRINT-REC     AFTER ADVANCING 1 LINES.
           MOVE DASH-LINE      TO PRINT-REC.
           WRITE PRINT-REC     AFTER ADVANCING 1 LINES.
           MOVE 6              TO LINE-CTR.

       COPY OVRPFCALL IN COPYLIB.

       SPL-EXIT.               EXIT.

       SORT-OP-EXIT.           EXIT.

