       01  LINE-DATA.
           10  FILLER              PIC XX.
           10  CC-BUF              PIC X(04).
           10  FILLER              PIC XX.
           10  NAME-BUF            PIC X(16).
           10  FILLER              PIC XX.
           10  WO-BUF              PIC X(10).
           10  FILLER              PIC XX.
           10  EQUIP-BUF           PIC X(06).
           10  FILLER              PIC XX.
           10  DESC-BUF            PIC X(30).
           10  FILLER              PIC XXX.


       01  ZONE-SCREEN-DATA.
           05  ZONE-BUF        PIC XXXX.
           05  CMDMSGZ         PIC X(79).
           05  ERRMSGZ         PIC X(79).

       01  ZONE-ARGUMENT.
           05  Z-ARG           PIC X(4).
           05  FILLER          PIC XX   VALUE "1 ".

       01  DATE-HEADER.
           05  FILLER          PIC X(10) VALUE SPACES.
           05  FILLER          PIC X(07) VALUE "DATE:  ".
           05  P-DATE.
               10  P-DATE-MM   PIC X(02)  VALUE SPACES.
               10  FILLER      PIC X(01)  VALUE "/".
               10  P-DATE-DD   PIC X(02)  VALUE SPACES.
               10  FILLER      PIC X(01)  VALUE "/".
               10  P-DATE-YY   PIC X(02)  VALUE SPACES.
           05  FILLER          PIC X(10) VALUE SPACES.
           05  FILLER          PIC X(07) VALUE "TIME:  ".
           05  P-TIME          PIC X(08) VALUE SPACES.
           05  FILLER          PIC X(12) VALUE SPACES.
           05  FILLER          PIC X(05) VALUE "PAGE:".
           05  ZPAGE           PIC ZZZ   VALUE SPACES.
           05  FILLER          PIC X(10) VALUE SPACES.

       01  TITLE-HEADER.
           05  FILLER          PIC X(20) VALUE "                 WOR".
           05  FILLER          PIC X(20) VALUE "KORDERS IN-PROGRESS ".
           05  FILLER          PIC X(03) VALUE "BY ".
           05  P-ZONE          PIC X(04) VALUE SPACES.
           05  FILLER          PIC X(15) VALUE " ZONE CRAFTSMEN".
           05  FILLER          PIC X(17) VALUE SPACES.

       01  TEXT-HEADER.
           05  FILLER          PIC X(20) VALUE "  CC #  NAME        ".
           05  FILLER          PIC X(20) VALUE "      WO NUM      EQ".
           05  FILLER          PIC X(20) VALUE "UIP   DESCRIPTION   ".
           05  FILLER          PIC X(19) VALUE "                   ".

       01  PRINT-LINE.
           05  FILLER          PIC X(02) VALUE SPACES.
           05  P-CC            PIC X(04).
           05  FILLER          PIC X(02) VALUE SPACES.
           05  P-NA            PIC X(16).
           05  FILLER          PIC X(02) VALUE SPACES.
           05  P-WO            PIC X(10).
           05  FILLER          PIC X(02) VALUE SPACES.
           05  P-EQP           PIC X(06).
           05  FILLER          PIC X(02) VALUE SPACES.
           05  P-DESC          PIC X(30).
           05  FILLER          PIC X(03) VALUE SPACES.

       01  CUR-DATE.
           05  CUR-YY          PIC X(02).
           05  CUR-MM          PIC X(02).
           05  CUR-DD          PIC X(02).

       01  TIME-BUFFER.
           05  TIME-BUF.
               10  HRS         PIC XX.
               10  MIN         PIC XX.
               10  SEC         PIC XX.
           05  TIME-EXP.
               10  TIME-H      PIC XX.
               10  FILLER      PIC X  VALUE ":".
               10  TIME-M      PIC XX.
               10  FILLER      PIC X  VALUE ":".
               10  TIME-S      PIC XX.

       01  DB-ERROR.
           05  DB-FUNC   PIC X(10) VALUE SPACES.
