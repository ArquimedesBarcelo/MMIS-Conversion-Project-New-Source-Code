       IDENTIFICATION DIVISION.
       PROGRAM-ID.             SWOIPINQ.
       AUTHOR.                 W. ROXBURY.
       INSTALLATION.           GOODYEAR TIRE & RUBBER CO.
      *REMARKS.                INQUIRY FOR IP WORKORDERS.
       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.
       SOURCE-COMPUTER.        IBM-AS400.
       OBJECT-COMPUTER.        IBM-AS400.
       SPECIAL-NAMES.          REQUESTOR       IS WORK-STATION
                               SYSTEM-CONSOLE  IS CONSOLE
                               LOCAL-DATA      IS LOCAL-DATA-AREA
                               C01             IS NEW-PAGE.

       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT LABOR-CURRENT-STAT
                  ASSIGN       TO DATABASE-MCFLMM1601
                  ORGANIZATION IS INDEXED
                  ACCESS MODE  IS DYNAMIC
                  RECORD KEY   IS EXTERNALLY-DESCRIBED-KEY
                               WITH DUPLICATES
                  FILE STATUS  IS FILE-STAT.

           SELECT WO-BASIC
                  ASSIGN       TO DATABASE-MCFLMM1001
                  ORGANIZATION IS INDEXED
                  ACCESS MODE  IS DYNAMIC
                  RECORD KEY   IS EXTERNALLY-DESCRIBED-KEY
                               WITH DUPLICATES
                  FILE STATUS  IS FILE-STAT.

           SELECT WO-PLANNED
                  ASSIGN       TO DATABASE-MCFLMM1101
                  ORGANIZATION IS INDEXED
                  ACCESS MODE  IS DYNAMIC
                  RECORD KEY   IS EXTERNALLY-DESCRIBED-KEY
                               WITH DUPLICATES
                  FILE STATUS  IS FILE-STAT.

           SELECT WO-ZONE-PRTY
                  ASSIGN       TO DATABASE-MCFLMM0501
                  ORGANIZATION IS INDEXED
                  ACCESS MODE  IS DYNAMIC
                  RECORD KEY   IS EXTERNALLY-DESCRIBED-KEY
                  FILE STATUS  IS FILE-STAT.

           SELECT PER-PERSONNEL
                  ASSIGN       TO DATABASE-MCFLMM0301
                  ORGANIZATION IS INDEXED
                  ACCESS MODE  IS DYNAMIC
                  RECORD KEY   IS EXTERNALLY-DESCRIBED-KEY
                  FILE STATUS  IS FILE-STAT.

           SELECT PRINT-FILE
                  ASSIGN       TO PRINTER-MCPRT
                  FILE STATUS  IS FILE-STAT.

           SELECT DISPLAY-FILE
                  ASSIGN       TO WORKSTATION-ZWOIPINQ-SI
                  ORGANIZATION IS TRANSACTION
                  ACCESS MODE  IS SEQUENTIAL
                  FILE STATUS  IS SCREEN-STATUS
                               MAJOR-MINOR
                  CONTROL-AREA IS SCREEN-CONTROL.

           SELECT DISPLAY-FILE-2
                  ASSIGN       TO WORKSTATION-ZGETSCRNS-SI
                  ORGANIZATION IS TRANSACTION
                  ACCESS MODE  IS SEQUENTIAL
                  FILE STATUS  IS SCREEN-STATUS
                               MAJOR-MINOR
                  CONTROL-AREA IS SCREEN-CONTROL.

           SELECT OUT-FILE
                  ASSIGN       TO DISK-WOIPFILE
                  ORGANIZATION IS RELATIVE
                  ACCESS MODE  IS DYNAMIC
                  RELATIVE KEY IS ACT-KEY
                  FILE STATUS  IS FILE-STAT.

           SELECT SORT-FILE
                  ASSIGN       TO DISK-SORTFILE.

       DATA DIVISION.
       FILE SECTION.
       FD  LABOR-CURRENT-STAT
           LABEL RECORDS       ARE STANDARD.
       01  LS-REC.
           COPY DDS-ALL-FORMATS OF MCFLMM1601.

       FD  WO-BASIC
           LABEL RECORDS       ARE STANDARD.
       01  VWO-REC.
           COPY DDS-ALL-FORMATS OF MCFLMM1001.

       FD  WO-PLANNED
           LABEL RECORDS       ARE STANDARD.
       01  PWO-REC.
           COPY DDS-ALL-FORMATS OF MCFLMM1101.

       FD  WO-ZONE-PRTY
           LABEL RECORDS       ARE STANDARD.
       01  ZP-REC.
           COPY DDS-ALL-FORMATS OF MCFLMM0501.

       FD  PER-PERSONNEL
           LABEL RECORDS       ARE STANDARD.
       01  PP-REC.
           COPY DDS-ALL-FORMATS OF MCFLMM0301.

       FD  PRINT-FILE
           LABEL RECORD        IS OMITTED
           RECORD CONTAINS     79 CHARACTERS.
       01  PRINT-REC           PIC X(79).

       FD  DISPLAY-FILE
           LABEL RECORDS       ARE OMITTED.
       01  DISPLAY-REC         PIC X(2000).

       FD  DISPLAY-FILE-2
           LABEL RECORDS       ARE OMITTED.
       01  DISPLAY-REC-2       PIC X(2000).

       FD  OUT-FILE RECORD     CONTAINS 70 CHARACTERS
           LABEL RECORDS       ARE OMITTED
           DATA RECORD         IS OUT-REC.
       01  OUT-REC.
           05  OUT-ZONE        PIC XXXX.
           05  OUT-CC-NUM      PIC XXXX.
           05  OUT-CC-NAME     PIC X(16).
           05  OUT-WO-NUM      PIC X(10).
           05  OUT-EQUIP       PIC X(06).
           05  OUT-DESCRIPT    PIC X(30).

       SD  SORT-FILE RECORD    CONTAINS 70 CHARACTERS
           DATA RECORD         IS SORT-REC.
       01  SORT-REC.
           05  SORT-ZONE       PIC XXXX.
           05  SORT-CC-NUM     PIC XXXX.
           05  SORT-CC-NAME    PIC X(16).
           05  SORT-WO-NUM     PIC X(10).
           05  SORT-EQUIP      PIC X(06).
           05  SORT-DESCRIPT   PIC X(30).

       WORKING-STORAGE SECTION.
       77  ACT-KEY             PIC 9999         VALUE 0.
       77  MAX-KEY             PIC 9999         VALUE 0.
       77  SAVE-KEY            PIC 9999         VALUE 0.
       77  JCW-ZONE            PIC XXXX         VALUE SPACES.
       77  PRINT-SW            PIC 9            VALUE 0.
           88  PRINT-SWITCH-IS-OFF              VALUE 0.
       77  DASH-LINE           PIC X(79)        VALUE ALL "=".
       77  LINE-CTR            PIC 99           VALUE 60.
       77  PAGE-CTR            PIC 99           VALUE 0.
       77  EOF-SW              PIC 9            VALUE 0.
       77  SORT-SW             PIC 9            VALUE 1.
       77  TRUE-VAL            PIC 1            VALUE B"1".

       01  FILE-STAT.
           05 FILE-STAT-1      PIC X            VALUE "0".
           05 FILE-STAT-2      PIC X            VALUE "0".

