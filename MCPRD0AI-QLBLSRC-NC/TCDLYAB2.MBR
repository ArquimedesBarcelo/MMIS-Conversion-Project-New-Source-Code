               MOVE TC330-CORPCODE       TO   T333-CORPCODE
               MOVE TC330-DEPARTMENT     TO   T333-DEPARTMENT
               MOVE TC330-EMP            TO   T333-EMP
               MULTIPLY TC330-QTY BY -1 GIVING
                                              T333-QTY
               MOVE TC330-AVG-COST       TO   T333-AVG-COST
               MOVE TC330-UM             TO   T333-UM
               MOVE TC330-WORK-ORDER     TO   T333-WORK-ORDER
               MOVE TC330-EXP-CLASS      TO   T333-EXP-CLASS
               MOVE TC330-REQ-DEPT       TO   T333-REQ-DEPT
               MOVE TC330-CLASS          TO   T333-CLASS
           ELSE
           IF SRT-ACTUAL-TC = "430"
               MOVE TC430-CORPCODE       TO   T333-CORPCODE
               MOVE TC430-DEPARTMENT     TO   T333-DEPARTMENT
               MOVE TC430-EMP            TO   T333-EMP
               MULTIPLY TC430-QTY BY -1 GIVING
                                              T333-QTY
               MOVE TC430-AVG-COST       TO   T333-AVG-COST
               MOVE TC430-UM             TO   T333-UM
               MOVE TC430-WORK-ORDER     TO   T333-WORK-ORDER
               MOVE TC430-EXP-CLASS      TO   T333-EXP-CLASS
               MOVE TC430-REQ-DEPT       TO   T333-REQ-DEPT
               MOVE TC430-CLASS          TO   T333-CLASS
           ELSE
           IF SRT-ACTUAL-TC = "331"
      *        ** RETURN WITH VALUE REFORMATTED TO AN ISSUE
               MOVE TC331-CORPCODE       TO   T333-CORPCODE
               MOVE TC331-DEPT           TO   T333-DEPARTMENT
               MOVE TC331-DOCUMENT       TO   T333-WORK-ORDER
               MOVE SPACES               TO   T333-EMP
               MULTIPLY TC331-QTY BY -1 GIVING
                                              T333-QTY
               DIVIDE TC331-TOT-COST BY T333-QTY GIVING
                                              T333-AVG-COST
               MOVE TC331-UM             TO   T333-UM
               MOVE SPACES               TO   TC333-EXP-CLASS
               MOVE SPACES               TO   TC333-REQ-DEPT
               MOVE TC331-CLASS          TO   TC333-CLASS
               IF T333-AVG-COST < 0
                   MULTIPLY T333-AVG-COST BY -1 GIVING T333-AVG-COST
               ELSE
                   NEXT SENTENCE
           ELSE
           IF SRT-ACTUAL-TC = "431"
      *        ** RETURN WITH VALUE REFORMATTED TO AN ISSUE
               MOVE TC431-CORPCODE       TO   T333-CORPCODE
               MOVE TC431-DEPT           TO   T333-DEPARTMENT
               MOVE TC431-DOCUMENT       TO   T333-WORK-ORDER
               MOVE SPACES               TO   T333-EMP
               MULTIPLY TC431-QTY BY -1 GIVING
                                              T333-QTY
               MOVE TC431-UM             TO   T333-UM
               DIVIDE TC431-TOT-COST BY T333-QTY GIVING
                                              T333-AVG-COST
