           IF SRT-ACTUAL-TC = "420" OR "421"
               MOVE TC420-CORP-CODE      TO   T320-CORP-CODE
               MOVE "P"                  TO   T320-PO-RLS-FIRST
               MOVE TC420-PO-RLS         TO   T320-PO-RLS-LAST
               MOVE TC420-ITEM-NO        TO   T320-ITEM-NO
               MOVE TC420-QTY            TO   T320-QTY
               MOVE TC420-QTY-UM         TO   T320-QTY-UM
               MOVE TC420-PRICE          TO   T320-PRICE
               MOVE TC420-PRICE-UM       TO   T320-PRICE-UM
               MOVE TC420-REQ-NO         TO   T320-REQ-NO
               MOVE TC420-TAX-CODE       TO   T320-TAX-CODE
