               MOVE TC323-CORPCODE       TO   T323-CORPCODE
               MOVE TC323-RS             TO   T323-RS
               MOVE TC323-ITEM           TO   T323-ITEM
               MOVE TC323-CODED-RCV-QTY  TO   T323-CODED-RCV-QTY
               MOVE TC323-NONCODED-RCV-QTY TO T323-NONCODED-RCV-QTY
               MOVE TC323-UM             TO   T323-UM
               MOVE TC323-CURRENCY-CODE  TO   T323-CURRENCY-CODE
               IF MPLTINFO-COMPANY = "211" OR "281" OR "284" OR "285"
                   MOVE TC323-KELLY-PRICE TO  T323-KELLY-PRICE
                   MOVE TC323-KELLY-PO-UM TO  T323-KELLY-PO-UM
                   MOVE TC323-KELLY-CLASS TO  T323-KELLY-CLASS
                   MOVE TC323-KELLY-SUBD  TO  T323-KELLY-SUBD
      *----- AVOIDS NUMERIC PROBS, SINCE KELLY-SEQ NOT USED IN RPT
                   MOVE ZERO              TO  T323-KELLY-SEQ
               ELSE
                   MOVE TC323-UNIT-PRICE TO   T323-UNIT-PRICE
                   MOVE TC323-PRIME      TO   T323-PRIME
                   MOVE TC323-SUB        TO   T323-SUB
                   MOVE TC323-SUB-DETAIL TO   T323-SUB-DETAIL
                   MOVE TC323-ADDL-DATA  TO   T323-ADDL-DATA
           ELSE
           IF SRT-ACTUAL-TC = "423" OR "424" OR "623" OR "624"
               MOVE TC423-CORPCODE       TO   T323-CORPCODE
