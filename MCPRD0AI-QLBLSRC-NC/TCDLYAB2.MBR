           05  FILLER                  PIC X(81).

      **************************************************************
      *                                                            *
      *        P R O C E D U R E          D I V I S I O N          *
      *                                                            *
      **************************************************************

       PROCEDURE DIVISION USING RET-CODE, BASE, STATUS-AREA,
           HD-ROUTE-DATA, R9-RECORD.
       BEGIN-SORT SECTION 01.
       1000-BEGIN-SORT-PARA.
           IF R9-DEPT-AREA = SPACES
               MOVE "ALL" TO R9-DEPT (1).
           OPEN INPUT MPLTINFO-I, MSTORERM-I, DDESC-I, PERS-I.
           MOVE ZERO TO ABST-CNTR, SORT-CNTR, LINE-CTR, PG-CTR,
             SUB1, LINE-ADV, TC-333-CTR, TC-330-CTR, TC-323-CTR,
             TRANS-VALUE, DEPT-TOT, DEPT-TOT-6, EMP-TOT, GRAND-TOTALS,
9407CK       TOTAL-CODED-RECEIPTS, TOTAL-NONCODED-RECEIPTS,
             EXP-CLASS-TOT.
           MOVE "N" TO ANY-NOT-NUMERIC-FLAG.

      *----------  THE FIRST RECORD IN THE JOB STREAM KEYS THIS
      *            PROGRAM AS TO WHAT TYPE OF REPORT IS TO BE PRINTED.
      *            IF THE FIRST BYTE IS "A", THIS MEANS PRINT THE ENTIRE
      *            DAILY ACTIVITY REPORT.  IF "C", PRINT ISSUES AND
      *            RETURNS BY CHARGED DEPT, AND IF "R" PRINT ISSUES
      *            AND RETURNS BY REQUESTING DEPT.

           MOVE HD-SPOOLER-NUMBER TO OVRPRTF-TOFILE-NUM.
           MOVE "*YES"            TO OVRPRTF-SHARED.
           MOVE HD-NO-OF-COPIES   TO OVRPRTF-COPIES.
           MOVE "MCPRT"           TO OVRPRTF-FILE.
           PERFORM 996-OVERRIDE-PRINT-FILE.
           OPEN OUTPUT PRINT-FILE.
           IF REPORT-IS-A
               MOVE "DHDR88.PUB" TO HD-FILE-NAME
           ELSE
           IF REPORT-IS-C
               MOVE "DHDR89.PUB" TO HD-FILE-NAME
           ELSE
           IF REPORT-IS-R
               MOVE "DHDR90.PUB" TO HD-FILE-NAME
           ELSE
               MOVE "DHDR91.PUB" TO HD-FILE-NAME.
           DISPLAY "ROUTE DLY RPT TO: ", HD-ROUTE-DATA.
           DISPLAY "ENTER REPORT TYPE, FILE KEY, AND DEPARTEMENTS".
           DISPLAY "OPTION RECORD ENTERED IS:".
           DISPLAY R9-RECORD.

           CALL "TESCSEQ" USING ESC-NAME.
           MOVE CHAR-1636PI TO COMPRESS-PRINT.
           MOVE CHAR-10PI TO NORMAL-PRINT.

           CALL "THDPRT2" USING HD-RET-CODE, HD-FILE-NAME,
              FNUM, HD-ROUTE-DATA, ESC-NAME.
           DISPLAY "PRINTING HEADER PAGE".
           DISPLAY "FILE DHDFILE=", HD-FILE-NAME.
           IF HD-RET-CODE NOT = 0
               DISPLAY "THDPRT2 ERROR".
           IF PAPER-IS-132-COLS
               NEXT SENTENCE
           ELSE
               WRITE PRT-REC FROM COMPRESS-PRINT AFTER ADVANCING 0.

           MOVE +51 TO PRINT-LINE-CTR.

      *---------- SET UP DIFFERENT LINES FOR THE HEADER PAGE OF THE
      *           REPORT, DEPENDING ON WHAT OPTIONS WERE SELECTED.


      *     IF REPORT-IS-C OR REPORT-IS-R
      *         MOVE 0     TO  SUB1.
      *         MOVE SPACES  TO  DEPT-AREA
      *         PERFORM 4000-MOVE-DEPTS 10 TIMES.

      *---------- ANY OF THE FILES "ABSTFILE" THRU "ABSTFIL5" COULD
      *           BE OPENED DEPENDING ON PARAMETERS PASSED TO THIS
      *           PROGRAM IN THE JOB STREAM BY THE MODE PROGRAM OR
      *           THE CUTTOFF (OR JUST PLACED IN THE JOB STREAM THRU
      *           EDITOR).  "ABSTIFILE" IS THE MOST RECENT FILE OF
      *           TRANSACTION DATA FROM THE CUTOFF, AND IS NORMALLY
      *           USED FOR THE CUTOFF PRINTOUT.  "ABSTIFIL2" IS THE
      *           SECOND GENERATION, AND IS USED FOR THE "REPRINT OF
      *           DAILY ACTIVITIES" REPORT.

           DISPLAY "*** ABSTFILE TO PRINT IS ", R9-FILE-KEY, " ***".
           MOVE SPACES TO COMMAND-WORK-1.
           IF R9-FILE-KEY = "1"
                MOVE "OVRDBF FILE(ABSTFIL2) TOFILE(ABSTFILE)"
                  TO COMMAND-WORK
           ELSE
           IF R9-FILE-KEY = "3"
                MOVE "OVRDBF FILE(ABSTFIL2) TOFILE(ABSTFIL3)"
                  TO COMMAND-WORK
           ELSE
           IF R9-FILE-KEY = "4"
                MOVE "OVRDBF FILE(ABSTFIL2) TOFILE(ABSTFIL4)"
                  TO COMMAND-WORK
           ELSE
           IF R9-FILE-KEY = "5"
                MOVE "OVRDBF FILE(ABSTFIL2) TOFILE(ABSTFIL5)"
                  TO COMMAND-WORK.

           IF COMMAND-WORK-1 > SPACES
               DISPLAY COMMAND-WORK
               CALL "QCMDEXC" USING COMMAND-WORK, COMMAND-LEN.

      *------ CALL CCRTFILE TO CREATE A FILE 'FRTINFIL'
      *------ NOTE: FOR SOME REASON THE NEXT OVERRIDE OF MCFPFRTOUT
      *------ DELETED THIS OVERRIDE TO QTEMP, SO CHANGED IT TO *LIBL
           MOVE "*LIBL"       TO CCRTFILE-LIBRARY.
           MOVE "FRTINFIL"   TO CCRTFILE-FILE.
           MOVE "0072"        TO CCRTFILE-RECORD-LENGTH.
           MOVE "01000"       TO CCRTFILE-NO-RECORDS.
           MOVE "01000"       TO CCRTFILE-INCREMENT-AMT.
           MOVE  99           TO CCRTFILE-NO-INCREMENTS.
           CALL "CCRTFILE" USING CCRTFILE-LIBRARY,
                                 CCRTFILE-FILE,
                                 CCRTFILE-RECORD-LENGTH,
                                 CCRTFILE-NO-RECORDS,
                                 CCRTFILE-INCREMENT-AMT,
                                 CCRTFILE-NO-INCREMENTS,
                                 CCRTFILE-STATUS.
           IF CCRTFILE-STATUS NOT = "00"
               MOVE "CCRTFILE CREATE OF 'FRTINFIL' FAILED"
                  TO BU-DISPLAY-MSG
               PERFORM 2100-BLOWUP.

      *------ CALL CCRTFILE TO CREATE A TEMPORARY FILE 'FRTOUTFL'
           MOVE "QTEMP"       TO CCRTFILE-LIBRARY.
           MOVE "FRTOUTFL"  TO CCRTFILE-FILE.
           MOVE "0072"        TO CCRTFILE-RECORD-LENGTH.
           MOVE "01000"       TO CCRTFILE-NO-RECORDS.
           MOVE "01000"       TO CCRTFILE-INCREMENT-AMT.
           MOVE  99           TO CCRTFILE-NO-INCREMENTS.
           CALL "CCRTFILE" USING CCRTFILE-LIBRARY,
                                 CCRTFILE-FILE,
                                 CCRTFILE-RECORD-LENGTH,
                                 CCRTFILE-NO-RECORDS,
                                 CCRTFILE-INCREMENT-AMT,
                                 CCRTFILE-NO-INCREMENTS,
                                 CCRTFILE-STATUS.
           IF CCRTFILE-STATUS NOT = "00"
               MOVE "CCRTFILE CREATE OF 'FRTOUTFL' FAILED"
                  TO BU-DISPLAY-MSG
               PERFORM 2100-BLOWUP.

           OPEN INPUT  ABST-FILE
      *         OUTPUT WORK-360-FILE
                OUTPUT FRT-FILE-IN.
           MOVE 1 TO DATE-MODE.
           CALL "TDATECHK" USING DATE-CHECK-AREA.
           MOVE DATE-SLASH-OUT TO HDR-DATE.
           MOVE DATE-UNFORMATTED-TIME-OUT TO TIME-SAVE.
           MOVE HRS-SAVE      TO  HDR-HH.
           MOVE MIN-SAVE      TO  HDR-MM.
           MOVE SEC-SAVE      TO  HDR-SS.
      ******* ADDED THE FOLLOWING STMT TO CORRECT A PROBLEM WITH
      ******* THE PRINTING OF TRANSACTION DATES - 13SEP1995
           MOVE 4 TO DATE-MODE.
           IF REPORT-IS-A OR REPORT-IS-C
               SORT SORT-FILE ASCENDING KEY SRT-TC
                                            SRT-ISS-FIELD-ONLY
                                            SRT-ISS-EXP-CLASS
                                            SRT-CODE
                                            SRT-DATE
                                            SRT-TIME
                                            SRT-ID
                    INPUT  PROCEDURE  8000-INPUT-RTN
                    OUTPUT PROCEDURE  9000-OUTPUT-RTN
           ELSE
               SORT SORT-FILE ASCENDING KEY SRT-TC
                                            SRT-ISS-REQ-DEPT
                                            SRT-ISS-EMP
                                            SRT-CODE
                                            SRT-DATE
                                            SRT-TIME
                                            SRT-ID
                    INPUT  PROCEDURE  8000-INPUT-RTN
                    OUTPUT PROCEDURE  9000-OUTPUT-RTN.

      *    CLOSE WORK-360-FILE.
      *    IF REPORT-IS-A
      *        SORT SORT-360-FILE ON ASCENDING KEY S-BUDGET-NO
      *             USING WORK-360-FILE
      *             OUTPUT PROCEDURE IS 9500-TOTAL-360.

           CLOSE FRT-FILE-IN.
           IF REPORT-IS-A OR REPORT-IS-F
               OPEN OUTPUT FRT-FILE-OUT
               SORT SORT-FRT-FILE ON ASCENDING S-F-PO
                     USING FRT-FILE-IN
                     OUTPUT PROCEDURE IS 9600-PRE-FREIGHT

               CLOSE FRT-FILE-OUT
               SORT SORT-FRT-FILE ON ASCENDING S-F-CARRIER  S-F-PRO-NO
                     USING FRT-FILE-OUT
                     OUTPUT PROCEDURE IS 9650-FREIGHT-BILL.

      *------ IF ANY TRANSACTION DURING THE CUTOFF PROCESSING WAS
      *------ FOUND TO BE BAD, ALERT THE APPROPRIATE PERSON
           IF ANY-NOT-NUMERIC-FLAG = "Y"
               CALL "TBADTRAN".

           IF BU-DISPLAY-MSG = SPACES
               GO TO 2200-STOP-RUN.

       2100-BLOWUP.
           MOVE "TCDLYAB2"               TO   BU-PGM-NAME.
           MOVE CODE-ARG                 TO   BU-DISPLAY-FLD (1).
           CALL "TBLOWUP" USING BASE BU-PGM-NAME STATUS-AREA
             DUMMY-VIEW-AREA, FILE-STATUS BU-DISPLAY-MSG
             BU-DISPLAY-FLDS.

       2200-STOP-RUN.
           IF PAPER-IS-132-COLS
               NEXT SENTENCE
           ELSE
               WRITE PRT-REC FROM NORMAL-PRINT AFTER ADVANCING 0.
           CLOSE ABST-FILE PRINT-FILE.
           CLOSE MPLTINFO-I, MSTORERM-I, DDESC-I, PERS-I.
           GOBACK.

       4000-MOVE-DEPTS.
           ADD 1 TO SUB1.
      *     MOVE R9-DEPT (SUB1)    TO  PRT-DEPT (SUB1).

       4010-SELECT-DEPTS.
           MOVE "N"   TO  DEPT-FLAG.
           MOVE 0     TO  SUB1.
       4020-SELECT-DEPT-LOOP.
           ADD 1 TO SUB1.
           IF SUB1 > 10
               GO TO 4030-SD-X.
           IF SUB1 = 1
               IF R9-DEPT (SUB1) = "ALL"
                    MOVE "Y"    TO  DEPT-FLAG
                    GO TO 4030-SD-X.

           IF REPORT-IS-C
               IF DDAILYTC-TC = "333"
                   MOVE TC333-DEPARTMENT TO   TEST-DEPT
               ELSE
               IF DDAILYTC-TC = "433"
                   MOVE TC433-DEPARTMENT TO   TEST-DEPT
               ELSE
               IF DDAILYTC-TC = "330"
                   MOVE TC330-DEPARTMENT TO   TEST-DEPT
               ELSE
                   MOVE TC430-DEPARTMENT TO   TEST-DEPT
           ELSE
           IF REPORT-IS-R
               IF DDAILYTC-TC = "333"
                  MOVE TC333-REQ-DEPT    TO   TEST-DEPT
               ELSE
               IF DDAILYTC-TC = "433"
                   MOVE TC433-REQ-DEPT   TO   TEST-DEPT

               ELSE
               IF DDAILYTC-TC = "330"
                  MOVE TC330-REQ-DEPT    TO   TEST-DEPT
               ELSE
                   MOVE TC430-REQ-DEPT   TO   TEST-DEPT.

           IF TEST-DEPT = R9-DEPT (SUB1)
               MOVE "Y"                  TO   DEPT-FLAG
               GO TO 4030-SD-X
           ELSE
               GO TO 4020-SELECT-DEPT-LOOP.


       4030-SD-X.
           EXIT.

       4100-MOVE-HIGH-USAGE.
           MOVE TC311-HIGH-USAGE TO WS-HIGH-USAGE.
           MOVE WS-HU-1 TO PRT-HIGH-USAGE-LOC (1).
           MOVE WS-HU-2 TO PRT-HIGH-USAGE-LOC (2).
           MOVE WS-HU-3 TO PRT-HIGH-USAGE-LOC (3).
           MOVE WS-HU-4 TO PRT-HIGH-USAGE-LOC (4).
           MOVE WS-HU-5 TO PRT-HIGH-USAGE-LOC (5).
           MOVE WS-HU-6 TO PRT-HIGH-USAGE-LOC (6).

      **************************************************************
      *    INPUT SECTION.                                          *
      **************************************************************

       8000-INPUT-RTN SECTION 02.
      **************************************************************
      *    GET INFORMATION FOR THE REPORT MASTER HEADERS           *
      **************************************************************
       8010-INPUT-MAIN.
      *    CALL "DBGET" USING BASE, DSET-MPLTINFO, MODE7,
      *        STATUS-AREA, ALL-ITEM-LIST, BUF-MPLTINFO,
      *            SEARCH-PLT-KEY.

9407CK     MOVE "CCHM" TO PLTINFOKEY OF MPLTINFO-REC-I.
  .        READ MPLTINFO-I INTO BUF-MPLTINFO
  .            INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
  .        IF FILE-STATUS NOT = "00"
  .           MOVE "N" TO SAVE-CUR-CONV-SW
  .        ELSE
9407CK        MOVE MPLTINFO-CUR-CONV-SW TO SAVE-CUR-CONV-SW.

9407CK*----SEARCH-PLT-KEY = "P 01" IN WORKING-STORAGE.
           MOVE SEARCH-PLT-KEY TO PLTINFOKEY OF MPLTINFO-REC-I.
           READ MPLTINFO-I INTO BUF-MPLTINFO
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE "DBGET ERR MPLTINF 8-IM" TO BU-DISPLAY-MSG
               PERFORM 2100-BLOWUP.

           MOVE MPLTINFO-COMPANY  TO  HDR1COM, SAVE-PLT-CODE.
      *****MOVE MPLTINFO-PLT-NAME  TO  HDR1PLT.  *REMOVED 14SEP1995*

      *------- FIND OUT IF PLANT VALIDATES CLOCK CARD NUMBER.
           MOVE "STST" TO PLTINFOKEY OF MPLTINFO-REC-I.
           READ MPLTINFO-I INTO BUF-MPLTINFO
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
              MOVE "N"      TO CC-VALIDATE-SW
           ELSE
              IF MPLT-VALID-EMPL-STORES = "Y"
                 MOVE "Y"   TO CC-VALIDATE-SW
              ELSE
                 MOVE "N"   TO CC-VALIDATE-SW.

      **************************************************************
      *    THE FOLLOWING IS A LOOP, WHICH READS THE SEQUENTIAL     *
      *    FILE ABSTFIL2 AND RELEASES IT'S RECORDS TO THE SORT.    *
      **************************************************************
       8020-GET-TC-RCD.
           READ ABST-FILE INTO BUF-DDAILYTC
               AT END
                   GO TO 8990-IR-X.
           IF FILE-STATUS NOT = "00"
               MOVE "READ ABST-FILE ERROR 8020-GTR" TO BU-DISPLAY-MSG
               PERFORM 2100-BLOWUP.

      **************************************************************
      *    "001" OR "900" = ERRONEOUS TRANSACTIONS. WHEN CUTOFF IS *
      *    INITIATED THOSE "001" & "900" ARE SENT TO AKRON. THIS   *
      *    PROGRAM IS LOCAL ONLY THEREFORE THERE IS NO NEED TO     *
      *    REPORT ON "001" AND "900" TRANSACTIONS.                 *
      **************************************************************
           IF  DDAILYTC-TC = "900" OR "001"
               GO TO 8020-GET-TC-RCD.

      *------ THIS NUMERIC CHECK FINDS BAD DATA IN ANY NUMERIC
      *------ FIELD.
           PERFORM 9995-NUMERIC-CHECK.

      *---------- COUNT THE ISSUE, RETURN, AND DOCK RECEIPT TRANSACTIONS
      *           FOR PRINTING AT END OF REPORT
           IF DDAILYTC-TC = "323" OR "423" OR "523" OR "623"
               ADD 1         TO  TC-323-CTR.
           IF DDAILYTC-TC = "330" OR "430"
               ADD 1         TO  TC-330-CTR.
           IF DDAILYTC-TC = "333" OR "433"
               ADD 1         TO  TC-333-CTR.

      *------THIS REMOVES ZERO STOREROOM ADJUSTMENTS FROM THE REPORT
           IF DDAILYTC-TC = "332" OR "432"
               IF TC332-ADJ-QTY = 0
                   GO TO  8020-GET-TC-RCD
               END-IF
           END-IF.

      *---------- THIS PROGRAM PRINTS DIFFERENT SUBSETS OF DATA,
      *           DEPENDING ON WHAT PARAMETERS WERE PASSED BY EITHER
      *           THE MODE PROGRAM OR THE CUTOFF.  IF "C" OR "R"
      *           WAS PASSED, ONLY ISSUES AND RETURNS ARE PRINTED.

           IF REPORT-IS-C OR REPORT-IS-R
      *----------- ADDED 430 & 433 TRANSACTIONS TO THE REPORT.
      *******  IF DDAILYTC-TC = "333" OR "330"
               IF DDAILYTC-TC = "333" OR "330" OR "430" OR "433"
                   PERFORM 4010-SELECT-DEPTS THRU 4030-SD-X
                   IF GOOD-DEPT
                       NEXT SENTENCE
                   ELSE
                       GO TO 8020-GET-TC-RCD
                ELSE
                   GO TO 8020-GET-TC-RCD.

           IF REPORT-IS-A OR REPORT-IS-F
               IF DDAILYTC-TC = "350"
                   MOVE SPACE            TO   FRT-REC-IN
                   MOVE DDAILYTC-TC      TO   F-I-TC
                   MOVE SPACES           TO   WS-FREIGHT-PO
                   MOVE TC350-RS         TO   WS-FREIGHT-PO
                   MOVE WS-FRT-PO        TO   F-I-PO
                   MOVE TC350-PRO-NUMBER TO   F-I-PRO-NO
                   MOVE TC350-PRO-DATE   TO   F-I-PRO-DATE
                   MOVE TC350-CARRIER    TO   F-I-CARRIER
      *            *** IF MULTI, THE CHARGES IS REDEFINED NON-NUMERIC
                   IF TC350-MULTI-IDENTIFY = "MULTI"
                       MOVE ZERO         TO   F-I-CHARGES
                       MOVE TC350-MULTI-ORIG-RS TO F-I-MULTI-ORIG-RS
                       WRITE FRT-REC-IN
                   ELSE
                       MOVE TC350-CHARGES TO  F-I-CHARGES
                       MOVE SPACES        TO  F-I-MULTI-ORIG-RS
                       WRITE FRT-REC-IN
               ELSE
               IF DDAILYTC-TC = "352"
                   MOVE SPACE            TO   FRT-REC-IN
                   MOVE DDAILYTC-TC      TO   F-I-TC
                   MOVE TC352-RS         TO   WS-FREIGHT-PO-2
                   MOVE WS-FRT-PO-2      TO   F-I-PO
                   MOVE TC352-TYPE       TO   F-I-TYPE
                   WRITE FRT-REC-IN.

           IF REPORT-IS-F
               GO TO 8020-GET-TC-RCD.

      *------ ISSUES/RETURNS AND TRANSFER-OUT/TRANSFER-IN ARE COMBINED
      *------ INTO 1 SECTION OF RPT. ALSO 400 & 300 SERIES ARE COMBINED
           MOVE DDAILYTC-TC              TO   SAVE-TC.
           IF DDAILYTC-TC-1 = "4"
               MOVE "3"                  TO   DDAILYTC-TC-1.

           IF DDAILYTC-TC = "330"
               MOVE "333"                TO   DDAILYTC-TC
           ELSE
           IF DDAILYTC-TC = "331"
               MOVE "333"                TO   DDAILYTC-TC
           ELSE
           IF DDAILYTC-TC = "336"
               MOVE "335"                TO   DDAILYTC-TC
           ELSE
           IF DDAILYTC-TC = "523"
               MOVE "323"                TO   DDAILYTC-TC
           ELSE
           IF DDAILYTC-TC = "524"
               MOVE "324"                TO   DDAILYTC-TC
           ELSE
           IF DDAILYTC-TC = "550"
               MOVE "350"                TO   DDAILYTC-TC
           ELSE
           IF DDAILYTC-TC = "551"
               MOVE "351"                TO   DDAILYTC-TC
           ELSE
           IF DDAILYTC-TC = "553"
               MOVE "353"                TO   DDAILYTC-TC
           ELSE
           IF DDAILYTC-TC = "623"
               MOVE "323"                TO   DDAILYTC-TC
           ELSE
           IF DDAILYTC-TC = "624"
               MOVE "324"                TO   DDAILYTC-TC
           ELSE
           IF DDAILYTC-TC = "650"
               MOVE "350"                TO   DDAILYTC-TC
           ELSE
           IF DDAILYTC-TC = "651"
               MOVE "351"                TO   DDAILYTC-TC.

           MOVE BUF-DDAILYTC             TO   SRT-REC.
           MOVE SAVE-TC                  TO   SRT-ACTUAL-TC.

      **************************************************************
      *    ALL WITHDRAWALS COME OUT BY DEPARTMENT. THIS SHEET IS   *
      *    HANDED TO EACH DEPARTMENT SUPERVISOR FOR VERIFICATION   *
      *    OF ALL WITHDRAWALS FROM HIS DEPARTMENT BY HIS PEOPLE.   *
      **************************************************************
           IF SRT-TC = "333"
               MOVE TC333-DEPARTMENT     TO   SRT-ISS-FIELD-ONLY
               MOVE TC333-EXP-CLASS      TO   SRT-ISS-EXP-CLASS
           ELSE
           IF SRT-TC = "360"
               MOVE HIGH-VALUES          TO   SRT-ISS-FIELD-ONLY
               MOVE HIGH-VALUES          TO   SRT-ISS-EXP-CLASS
           ELSE
               MOVE SPACES               TO   SRT-ISS-FIELD-ONLY
                                              SRT-ISS-EXP-CLASS.

           IF SRT-TC = "333" AND REPORT-IS-R
               MOVE TC333-EMP            TO   SRT-ISS-EMP.

      ******************************************************
      **   FILE IS SORTED BY CORP CODE WITHIN TC CODE.  WE **
      **   NEED NON STOREROOM CODES TO BE LAST.  SINCE WE  **
      **   NOW HAVE PARTIAL ALPHA CORP CODES, WE NEED TO   **
      **   REPLACE "NON-STR" WITH "ZZZZZZZ".               **
      *******************************************************

           IF SRT-CODE = "NON-STR"
               MOVE "ZZZZZZZ" TO SRT-CODE.

           RELEASE SRT-REC.
           ADD +1  TO  ABST-CNTR.
           GO TO 8020-GET-TC-RCD.

       8990-IR-X.
           EXIT.

      **************************************************************
      *    OUTPUT SECTION.                                         *
      **************************************************************


       9000-OUTPUT-RTN SECTION 04.
       9010-OUTPUT-MAIN.
           PERFORM 9200-RETURN-RCD.
      **********************************************************
      * T/C - TRANSACTIONS                                     *
      * ---   --------------------------------------           *
      * 300 - COMPARE RECORD #1 (OF 2)                         *
      * 301 - COMPARE RECORD #2 (OF 2)                         *
      * 305 - INITIALIZATION OF A CODE                         *
      * 311 - PLANTMASTER DATA                                 *
      * 32D - P.O. ITEM DELETION                               *
      * 320 - P.O. ITEM ADDITION                               *
      * 321 - P.O. ITEM MODIFICATION                           *
      * 322 - P.O. ITEM ACCOUNTING DATA                        *
      * 323 - P.O. RECEIVING DOCK RECEIPT                      *
      * 324 - P.O. RECEIVING DOCK RECEIPT CORRECTION           *
      * 325 - P.O. RECEIVER STOREROOM RECEIPT                  *
      * 327 - P.O RECEIVER OF A C-ORDER WHOSE UM'S ARE NOT =   *
      * 328 - P.O RECEIVER OF A C-ORDER CORRECTION             *
      * 330 - RETURN                                           *
      * 331 - RETURN WITH VALUE                                *
      * 332 - ADJUSTMENT                                       *
      * 333 - ISSUE                                            *
      * 334 - CODE TRANSFER                                    *
      * 330 - RETURN                                           *
      * 350 - P.O. RECEIVING DOCK FREIGHT INFORMATION #1       *
      * 351 - P.O. RECEIVING DOCK FREIGHT CORRECTION FOR #1    *
      * 352 - P.O. RECEIVING DOCK FREIGHT INFORMATION #2       *
      * 353 - P.O. RECEIVING DOCK FREIGHT CORRECTION FOR #2    *
      * 354 - FREIGHT CORRECTION FOR CARRIER AND PRO NUMBER    *
      * 360 - P.O. HEADER ADDITION                             *
      * 361 - P.O. HEADER MODIFICATION                         *
      * 370 - P.O. NON-STR ITEM DESCRIPTION ADDITION           *
      * 371 - P.O. NON-STR ITEM DESCRIPTION MODIFICATION       *
      * 399 - HIGH USAGE WITHDRAWAL                            *
      * 490 - INVOICE ITEMS (GENERATED FROM MANIFEST RLSE STEP *
      * 492 - INVOICE ITEMS (GENERATED FROM MANIFEST RLSE STEP *
      **********************************************************

       9100-TRANSACTIONS.
           IF BUF-DDAILYTC = HIGH-VALUES
               GO TO 9105-TOTALS
           ELSE
           IF DDAILYTC-TC = "305"
               MOVE +7  TO  SUB1
               MOVE "STOREROOM INITIALIZATION"   TO  HDR2-TITLE
               PERFORM 9320-HDR-325-334
               PERFORM 9330-PRT-305 UNTIL
                   DDAILYTC-TC NOT = "305"
           ELSE
           IF DDAILYTC-TC = "311"
               MOVE "PLANT DATA UPDATES" TO HDR2-TITLE
               PERFORM 9300-HDR-311
               PERFORM 9310-PRT-311  UNTIL
                   DDAILYTC-TC NOT = "311"
           ELSE
           IF DDAILYTC-TC = "320" AND (T320-CORP-CODE NOT = "NON-STR")
               MOVE +1 TO SUB1
               MOVE "CODED PURCHASE ORDER ITEMS    "
                 TO HDR2-TITLE
               PERFORM 9320-HDR-325-334
               PERFORM 9350-PRT-320 UNTIL
                   T320-CORP-CODE = "NON-STR" OR DDAILYTC-TC > "320"
           ELSE
           IF DDAILYTC-TC = "320" AND T320-CORP-CODE = "NON-STR"
               MOVE +1 TO SUB1
               MOVE "NON-CODED PURCHASE ORDER ITEMS    "
                 TO HDR2-TITLE
               PERFORM 9320-HDR-325-334
               PERFORM 9350-PRT-320 UNTIL
                   DDAILYTC-TC > "320" OR T320-CORP-CODE > "NON-STR"
           ELSE
           IF DDAILYTC-TC = "321" AND (DDAILYTC-CODE NOT = "NON-STR")
               MOVE +1 TO SUB1
               MOVE "CODED PURCHASE ORDER ITEM MODIFICATIONS    "
                 TO HDR2-TITLE
               PERFORM 9320-HDR-325-334
               PERFORM 9350-PRT-320 UNTIL
                 DDAILYTC-CODE = "NON-STR" OR DDAILYTC-TC > "321"
           ELSE
           IF DDAILYTC-TC = "321" AND DDAILYTC-CODE = "NON-STR"
               MOVE +1 TO SUB1
               MOVE "NON-CODED PURCHASE ORDER ITEM MODIFICATIONS    "
                 TO HDR2-TITLE
               PERFORM 9320-HDR-325-334
               PERFORM 9350-PRT-320 UNTIL
                   DDAILYTC-TC > "321" OR DDAILYTC-CODE > "NON-STR"
           ELSE
           IF DDAILYTC-TC = "323" AND (T323-CORPCODE NOT = "NON-STR")
               MOVE +2 TO SUB1
               MOVE "CODED RECEIPTS AT DOCK    " TO HDR2-TITLE
               PERFORM 9320-HDR-325-334
               PERFORM 9360-PRT-323 UNTIL
                   T323-CORPCODE = "NON-STR" OR DDAILYTC-TC > "323"

9407CK*--------PRINT NEW TOTAL LINE.
  .   *--------IF THE PLANT'S CURRENCY CONVERSION SWITCH IS SET TO "N",
  .   *--------THE POSSIBILITY EXISTS THAT MORE THAN ONE CURRENCY WAS
  .   *--------USED IN THE REPORT.  THEREFORE A TOTAL FROM DIFFERENT
  .   *--------CURRENCIES IS MEANINGLESS BUT WE STILL PRINT IT.
  .
  .            IF LINE-CTR > +55
  .                PERFORM 9320-HDR-325-334
  .            END-IF
  .            MOVE SPACES TO PRT-LINE
  .            IF SAVE-CUR-CONV-SW = "Y"
  .               MOVE "TOTAL CODED RECEIPTS"      TO PRT-RECEIPTS-DESC
  .               MOVE  TOTAL-CODED-RECEIPTS       TO PRT-RECEIPTS
  .            ELSE
  .               MOVE "MULTIPLE CURRENCIES POSSIBLE"
  .                                                TO PRT-RECEIPTS-DESC
  .   ****        MOVE "**********.***"            TO PRT-RECEIPTS-ALPHA
  .               MOVE  TOTAL-CODED-RECEIPTS       TO PRT-RECEIPTS
  .            END-IF
  .            MOVE RECEIPT-TOT-HDR TO PRT-LINE
9407CK         PERFORM 9490-PRT-LINE
           ELSE
           IF DDAILYTC-TC = "323" AND T323-CORPCODE = "NON-STR"
               MOVE +2 TO SUB1
               MOVE "NON-CODED RECEIPTS AT DOCK    " TO HDR2-TITLE
               PERFORM 9320-HDR-325-334
               PERFORM 9360-PRT-323 UNTIL
                   DDAILYTC-TC > "323" OR T323-CORPCODE > "NON-STR"

9407CK*--------PRINT NEW TOTAL LINE.
  .   *--------SEE ABOVE EXPLANATION CONCERNING THE CONVERSION SWITCH.
  .
  .            IF LINE-CTR > +55
  .                PERFORM 9320-HDR-325-334
  .            END-IF
  .            MOVE SPACES TO PRT-LINE
  .            IF SAVE-CUR-CONV-SW = "Y"
  .               MOVE "TOTAL NON-CODED RECEIPTS"  TO PRT-RECEIPTS-DESC
  .               MOVE  TOTAL-NONCODED-RECEIPTS    TO PRT-RECEIPTS
  .            ELSE
  .               MOVE "MULTIPLE CURRENCIES POSSIBLE"
  .                    TO PRT-RECEIPTS-DESC
  .   ****        MOVE "**********.***"            TO PRT-RECEIPTS-ALPHA
  .               MOVE  TOTAL-NONCODED-RECEIPTS    TO PRT-RECEIPTS
  .            END-IF
  .            MOVE RECEIPT-TOT-HDR TO PRT-LINE
9407CK         PERFORM 9490-PRT-LINE
           ELSE
           IF DDAILYTC-TC = "324" AND (DDAILYTC-CODE NOT = "NON-STR")
               MOVE +2 TO SUB1
              MOVE "CODED RECEIPT AT DOCK CORRECTIONS    " TO HDR2-TITLE
               PERFORM 9320-HDR-325-334
               PERFORM 9360-PRT-323 UNTIL
                   DDAILYTC-CODE = "NON-STR" OR DDAILYTC-TC > "324"
           ELSE
           IF DDAILYTC-TC = "324" AND DDAILYTC-CODE = "NON-STR"
               MOVE +2 TO SUB1
               MOVE "NON-CODED RECEIPT AT DOCK CORRECTIONS    "
                 TO HDR2-TITLE
               PERFORM 9320-HDR-325-334
               PERFORM 9360-PRT-323 UNTIL
                   DDAILYTC-TC > "324" OR DDAILYTC-CODE > "NON-STR"
           ELSE
           IF DDAILYTC-TC = "325"
               MOVE +3  TO  SUB1
               MOVE "RECEIPTS INTO STORES" TO HDR2-TITLE
               PERFORM 9320-HDR-325-334
               PERFORM 9370-PRT-325 UNTIL
                   DDAILYTC-TC NOT = "325"
           ELSE
           IF DDAILYTC-TC = "32D"
               MOVE +8  TO  SUB1
               MOVE "PURCHASE ORDER DELETES" TO HDR2-TITLE
               PERFORM 9320-HDR-325-334
               PERFORM 9340-PRT-32D UNTIL
                   DDAILYTC-TC NOT = "32D"
           ELSE
           IF DDAILYTC-TC = "332"
               MOVE +4  TO  SUB1
               MOVE "STOREROOM ADJUSTMENTS"      TO  HDR2-TITLE
               PERFORM 9320-HDR-325-334
               PERFORM 9380-PRT-332 UNTIL
                   DDAILYTC-TC NOT = "332"
               MOVE SPACES             TO  PRT-LINE
               MOVE 2                  TO  LINE-ADV
               PERFORM 9490-PRT-LINE
               MOVE GRAND-TOTALS       TO  PRT-GRAND-TOTALS
               MOVE GRAND-TOT-HDR      TO  PRT-LINE
               PERFORM 9490-PRT-LINE
           ELSE
           IF DDAILYTC-TC = "333"
               MOVE T333-DEPARTMENT    TO   ISS-CHRG-SAVE-6
               MOVE T333-EXP-CLASS     TO   EXP-CLASS-SAVE
               PERFORM 9220-MOVE-ISS-CTL
               MOVE +5  TO  SUB1
               MOVE "STOREROOM WITHDRAWALS AND RETURNS"
                 TO HDR2-TITLE
               MOVE ZEROS              TO  GRAND-TOTALS
               PERFORM 9320-HDR-325-334
               PERFORM 9390-PRT-333 UNTIL
                   DDAILYTC-TC NOT = "333"
               IF NOT REPORT-IS-R
                   PERFORM 9430-CTLBRK-333
               END-IF
               PERFORM 94-3331-CNTL-BREAK
               MOVE SPACES       TO  PRT-LINE
               MOVE 3            TO  LINE-ADV
               PERFORM 9490-PRT-LINE
               PERFORM 9410-SUBBREAK-333 THRU 9420-S3-X
               MOVE ISS-CHRG-SAVE        TO   PRT-DEPARTMENT
               MOVE DEPT-TOT     TO  PRT-DEPT-TOT
               MOVE DEPT-TOT-HDR TO  PRT-LINE
               PERFORM 9490-PRT-LINE
               ADD DEPT-TOT      TO  GRAND-TOTALS
               MOVE ZEROS        TO  DEPT-TOT
               MOVE SPACES       TO  PRT-LINE
               PERFORM 9480-PRT-TOP
               MOVE GRAND-TOTALS  TO PRT-GRAND-TOTALS
               MOVE GRAND-TOT-HDR TO  PRT-LINE
               PERFORM 9490-PRT-LINE
           ELSE
           IF DDAILYTC-TC = "334"
               MOVE +6  TO  SUB1
               MOVE "CODE TRANSFERS"  TO  HDR2-TITLE
               PERFORM 9320-HDR-325-334
               PERFORM 9410-PRT-334  UNTIL
                   DDAILYTC-TC  NOT = "334"
           ELSE
           IF DDAILYTC-TC = "335"
               MOVE 13 TO SUB1
               MOVE "RECEIPTS FROM / DISPERSALS TO OUTSIDE OF PLANT"
                 TO HDR2-TITLE
               PERFORM 9320-HDR-325-334
               PERFORM 9420-PRT-335 UNTIL
                   DDAILYTC-TC NOT = "335"
           ELSE
           IF DDAILYTC-TC = "360"
               MOVE +9 TO  SUB1
               MOVE "PURCHASE ORDER HEADERS" TO HDR2-TITLE
               PERFORM 9320-HDR-325-334
               PERFORM 9430-PRT-360 UNTIL
                   DDAILYTC-TC NOT = "360"
           ELSE
           IF DDAILYTC-TC = "399"
               MOVE +5  TO  SUB1
               MOVE "HIGH USAGE WITHDRAWALS" TO HDR2-TITLE
               PERFORM 9320-HDR-325-334
               PERFORM 9440-PRT-399 UNTIL
                   DDAILYTC-TC NOT = "399"
           ELSE
      *------ NOW SKIP ANY TRANSACTIONS THAT WE DON'T PRINT
           IF DDAILYTC-TC = "322" OR "422" OR "327" OR "328" OR "350"
                         OR "351" OR "352" OR "353" OR "361" OR "370"
                         OR "371" OR "999" OR "100" OR "110" OR "390"
                         OR "392" OR "500" OR "105" OR "326" OR "341"
                         OR "342" OR "923" OR "924" OR "937"
                         OR "300" OR "301" OR "354"
               MOVE DDAILYTC-TC          TO   SAVE-TC
               PERFORM 9200-RETURN-RCD UNTIL DDAILYTC-TC NOT = SAVE-TC
           ELSE
               MOVE +12  TO  SUB1
               MOVE "STOREROOM INVALID TRANSACTIONS" TO HDR2-TITLE
               PERFORM 9320-HDR-325-334
               MOVE DDAILYTC-TC TO SAVE-TC
               PERFORM 9460-PRT-BAD  UNTIL
                   DDAILYTC-TC NOT = SAVE-TC.

           IF BUF-DDAILYTC < HIGH-VALUES
               GO TO 9100-TRANSACTIONS.

      **************************************************************
      *    CHECK TO SEE AMOUNT OF RECORDS RELEASED TO THE SORT     *
      *    VERSUS THE AMOUNT OF RECORDS RETURNED FROM THE SORT.    *
      **************************************************************

       9105-TOTALS.
           IF ABST-CNTR NOT = SORT-CNTR
               DISPLAY "*REPORT FROM TCDLYAB2*"
               DISPLAY "*TC-ABSTRACT RECORD COUNT OUT OF BALANCE*"
               DISPLAY "-ABSTRACT COUNT = " ABST-CNTR
               DISPLAY "-SRT-REC  COUNT = " SORT-CNTR.

      *******************************************
      **   PRINT TRANSACTION COUNTS.           **
      *******************************************

           IF REPORT-IS-F
               GO TO 9495-OR-X.
           MOVE "TRANSACTION COUNTS" TO HDR2-TITLE.
           ADD 1             TO  PG-CTR.
           MOVE PG-CTR TO PG-NO.
           WRITE PRT-REC FROM MAST-HDR1 AFTER ADVANCING NEW-PAGE.
           WRITE PRT-REC FROM MAST-HDR2 AFTER ADVANCING 1.
           MOVE TC-333-CTR   TO  PRT-333-CTR.
           MOVE TC-330-CTR   TO  PRT-330-CTR.
           MOVE TC-323-CTR   TO  PRT-323-CTR.
           MOVE TOTAL-NONCODED-RECEIPTS TO PRT-323-NONCODED-AMT
           MOVE TOTAL-CODED-RECEIPTS    TO PRT-323-CODED-AMT

9509DP******* IF ALL TRANSACTIONS ARE NOT CONVERTED TO THE HOME CURRENCY
9509DP******* PRINT WARNING MESSAGE BUT STILL SHOW TOTALS RECEIPTS.
9509DP     IF SAVE-CUR-CONV-SW = "Y"
9509DP         MOVE "MULTIPLE CURRENCIES ARE POSSIBLE"
9509DP                                      TO PRT-323-NONCODED-MSG,
9509DP                                         PRT-323-CODED-MSG.

9407CK     MOVE GRAND-TOTALS            TO PRT-TTL-WITH-AMT.
           WRITE PRT-REC FROM TC-333-CNT-DETAIL
             AFTER ADVANCING 3.
           WRITE PRT-REC FROM TC-330-CNT-DETAIL
             AFTER ADVANCING 2.
           WRITE PRT-REC FROM TC-323-CNT-DETAIL
             AFTER ADVANCING 2.
9407CK     WRITE PRT-REC FROM AMT-323-NONCODED-DETAIL
  .          AFTER ADVANCING 2.
  .        WRITE PRT-REC FROM AMT-323-CODED-DETAIL
  .          AFTER ADVANCING 2.
  .        WRITE PRT-REC FROM AMT-TTL-WITH-DETAIL
9407CK       AFTER ADVANCING 2.

           GO TO 9495-OR-X.

      **************************************************************
      *    RETURN FROM SORT.                                       *
      **************************************************************

       9200-RETURN-RCD.
           RETURN SORT-FILE INTO BUF-DDAILYTC AT END
               MOVE HIGH-VALUES          TO   BUF-DDAILYTC.
           IF BUF-DDAILYTC < HIGH-VALUES
               ADD +1  TO  SORT-CNTR.

      *******************************************************
      **   IN THE INPUT SECTION, ALL TC-CODES WITH THE     **
      **   VALUE "NON-STR" WERE REPLACED WITH "ZZZZZZZ" FOR**
      **   THE SORT.  NOW CHANGE BACK TO "NON-STR".        **
      *******************************************************

           IF DDAILYTC-CODE = "ZZZZZZZ"
               MOVE "NON-STR" TO DDAILYTC-CODE.

           IF BUF-DDAILYTC < HIGH-VALUES
               PERFORM 9990-REFORMAT.

       9210-BLD-DATE-TIME.
           MOVE DDAILYTC-DATE TO  DATE-VALIDATE-IN.
           CALL "TDATECHK"  USING DATE-CHECK-AREA.
           MOVE DDAILYTC-TIME TO  TIME-SAVE.
           MOVE HRS-SAVE      TO  BLD-HH.
           MOVE MIN-SAVE      TO  BLD-MM.
           MOVE SEC-SAVE      TO  BLD-SS.

       9220-MOVE-ISS-CTL.
      *---------- ON 333 TRANSACTIONS WE ARE CONTROL BREAKING ON
      *           REQUESTING DEPT IF REQUEST DEPT REPORT IS DONE,
      *           OTHERWISE WE BREAK ON CHARGE DEPT  MOVE THE FIRST
      *           DEPT TO THE CONTROL BREAK KEY (SO WE DONT BREAK AND
      *           PRINT TOTALS ON THE FIRST TRANSACTION)
           IF DDAILYTC-TC = "333"
               IF REPORT-IS-R
                   MOVE T333-REQ-DEPT    TO  ISS-CHRG-SAVE
                   MOVE T333-EMP       TO  SAVE-EMP
               ELSE
                   MOVE T333-DEPT TO  ISS-CHRG-SAVE
                   MOVE T333-EXP-CLASS   TO  EXP-CLASS-SAVE.

       9300-HDR-311.
           MOVE ZERO  TO  LINE-CTR.
           ADD +1  TO  PG-CTR.
           MOVE PG-CTR  TO  PG-NO.
           MOVE SPACES  TO  PRT-LINE.
           PERFORM 9480-PRT-TOP.
           MOVE SPACES  TO  PRT-LINE.
           MOVE +1  TO  LINE-ADV.
           MOVE MAST-HDR1  TO  PRT-LINE.
           PERFORM 9490-PRT-LINE.
           ADD LINE-ADV  TO  LINE-CTR.
           MOVE MAST-HDR2 TO  PRT-LINE.
           PERFORM 9490-PRT-LINE.
           MOVE PLT-HDR1  TO  PRT-LINE.
           PERFORM 9490-PRT-LINE.
           MOVE PLT-HDR2  TO  PRT-LINE.
           PERFORM 9490-PRT-LINE.
           MOVE PLT-HDR3  TO  PRT-LINE.
           PERFORM 9490-PRT-LINE.
           MOVE PLT-HDR4  TO  PRT-LINE.
           PERFORM 9490-PRT-LINE.
           MOVE PLT-HDR5  TO  PRT-LINE.
           PERFORM 9490-PRT-LINE.
           MOVE PLT-HDR6  TO  PRT-LINE.
           PERFORM 9490-PRT-LINE.
           MOVE PLT-HDR7  TO  PRT-LINE.
           MOVE +2  TO  LINE-ADV.
           PERFORM 9490-PRT-LINE.
           ADD +8  TO  LINE-CTR.
           MOVE +1  TO  LINE-ADV.

      **************************************************************
      *    TC 311.                                                 *
      **************************************************************

       9310-PRT-311 .
           IF LINE-CTR > +55
               PERFORM 9300-HDR-311.
           MOVE SPACES                 TO  PRT-LINE.
           MOVE TC311-CORP-CODE        TO  PRT-PLT-CODE.
           IF TC311-ID-1 = "1"
               MOVE "1"                TO  PRT-PLT-ID
               MOVE TC311-PREV-CODE    TO  PRT-PLT-PREV-CD
               MOVE TC311-AUTHOR       TO  PRT-PLT-AUTHOR
               MOVE TC311-CLASS        TO  PRT-PLT-CLASS
               MOVE TC311-DIR-CHRG     TO  PRT-PLT-TERR
               MOVE TC311-WR-DOWN      TO  PRT-PLT-WD
               MOVE TC311-INS-ITM      TO  PRT-PLT-INS
               MOVE TC311-ORD-ENG      TO  PRT-PLT-OE
               MOVE TC311-OUT-REP      TO  PRT-PLT-OR
               MOVE TC311-MAINT        TO  PRT-PLT-MR
               MOVE TC311-IMPORT       TO  PRT-PLT-RLS
               MOVE TC311-STOCK-OT     TO  PRT-PLT-SO
           ELSE
             IF TC311-ID-2 = "2"
               MOVE "2"                TO  PRT-PLT-ID
               MOVE TC311-LOC-DESC     TO  PRT-PLT-DESC
           ELSE
             IF TC311-ID-3 = "3"
               MOVE "3"                TO  PRT-PLT-ID
               MOVE TC311-DISB-INSTR   TO  PRT-PLT-DISP
               MOVE TC311-UM1          TO  PRT-PLT-UM1
               MOVE TC311-UM1-CF       TO  PRT-PLT-UM1-CF
               MOVE TC311-UM2          TO  PRT-PLT-UM2
               MOVE TC311-UM2-CF       TO  PRT-PLT-UM2-CF
           ELSE
             IF TC311-ID-4 = "4"
               MOVE "4"                TO  PRT-PLT-ID
               MOVE TC311-PHYS-INV-CYL TO  PRT-PLT-INVCYL
               MOVE TC311-EST-LT       TO  PRT-PLT-E-LT
               MOVE TC311-MTH-FCST     TO  PRT-PLT-FRCST
               MOVE TC311-REORDER      TO  PRT-PLT-REORD
               MOVE TC311-MAX          TO  PRT-PLT-MAX
               MOVE TC311-SOQ          TO  PRT-PLT-EOQ
               MOVE TC311-EXPEDITE     TO  PRT-PLT-EXPD
           ELSE
             IF T311-ID-5  = "5"
               MOVE "5"                TO  PRT-PLT-ID
               MOVE T311-AVG-COST     TO  PRT-PLT-AVGCST
               MOVE T311-STD-COST     TO  PRT-PLT-STDCST
               MOVE T311-MKT-COST     TO  PRT-PLT-MKTCST
           ELSE
             IF TC311-ID-6 = "6"
               MOVE "6"                TO  PRT-PLT-ID
               MOVE 0                  TO  SUB1
               PERFORM 4100-MOVE-HIGH-USAGE
           ELSE
               MOVE BUF-DDAILYTC       TO  PRT-REC.
           PERFORM 9210-BLD-DATE-TIME.
      *****MOVE 1 TO DATE-MODE.   *REPLACED 13SEP1995*
           MOVE 4 TO DATE-MODE.
           MOVE DATE-SLASH-OUT         TO  PRT-PLT-DATE.
           MOVE BLD-TIME               TO  PRT-PLT-TIME.
           PERFORM 9490-PRT-LINE.
           ADD LINE-ADV  TO  LINE-CTR.
           PERFORM 9200-RETURN-RCD.

       9320-HDR-325-334.
           MOVE SPACES  TO  PRT-LINE.
           MOVE ZERO  TO  LINE-CTR.
           ADD +1 TO  PG-CTR.
           MOVE PG-CTR  TO  PG-NO.
           PERFORM 9480-PRT-TOP.
           MOVE +1 TO  LINE-ADV.
           MOVE MAST-HDR1  TO  PRT-LINE.
           PERFORM 9490-PRT-LINE.
           ADD LINE-ADV  TO  LINE-CTR.
           MOVE MAST-HDR2  TO  PRT-LINE.
           PERFORM 9490-PRT-LINE.
           ADD LINE-ADV  TO  LINE-CTR.
           MOVE +2  TO  LINE-ADV.
           MOVE HDR3-RCD (SUB1)  TO  PRT-LINE.
           PERFORM 9490-PRT-LINE.
           ADD LINE-ADV  TO  LINE-CTR.
           MOVE +1  TO  LINE-ADV.
           MOVE SPACES  TO  PRT-LINE.
           PERFORM 9490-PRT-LINE.
           ADD LINE-ADV  TO  LINE-CTR.

      **************************************************************
      *    TC 305.                                                 *
      **************************************************************

       9330-PRT-305.
           IF LINE-CTR > +55
               PERFORM 9320-HDR-325-334.
           MOVE SPACES                TO  PRT-LINE.
           PERFORM 9210-BLD-DATE-TIME.
           MOVE 4 TO DATE-MODE.
           MOVE DATE-SLASH-OUT        TO  PRT-305-DATE.
           MOVE BLD-TIME              TO  PRT-305-TIME.
           MOVE DDAILYTC-CODE         TO  PRT-305-CODE.
           MOVE DLY-INIT-UM           TO  PRT-305-UM.
           IF DLY-INIT-ONHND = "********"
               MOVE DLY-INIT-ONHND    TO  PRT-305-ONHND
           ELSE
               MOVE DLY-INIT-ONHND-R  TO  PRT-305-ONHND-R.
           IF DLY-INIT-AVGCST = "*********"
               MOVE DLY-INIT-AVGCST   TO  PRT-305-AVGCST
           ELSE
               MOVE DLY-INIT-AVGCST-R TO  PRT-305-AVGCST-R.
           IF DLY-INIT-REORD = "********"
               MOVE DLY-INIT-REORD    TO  PRT-305-REORD
           ELSE
               MOVE DLY-INIT-REORD-R  TO  PRT-305-REORD-R.
           IF DLY-INIT-MAX = "********"
               MOVE DLY-INIT-MAX      TO  PRT-305-MAX
           ELSE
               MOVE DLY-INIT-MAX-R    TO  PRT-305-MAX-R.
           IF DLY-INIT-EXPD = "********"
               MOVE DLY-INIT-EXPD     TO  PRT-305-EXPD
           ELSE
               MOVE DLY-INIT-EXPD-R   TO  PRT-305-EXPD-R.
           MOVE DLY-INIT-CLASS        TO  PRT-305-CLASS.
           MOVE DLY-INIT-DEFAULT      TO  PRT-305-DEFAULT.
           IF DLY-INIT-INVCYL = "****"
               MOVE DLY-INIT-INVCYL   TO  PRT-305-INVCYL
           ELSE
               MOVE DLY-INIT-INVCYL-R  TO  PRT-305-INVCYL-R.
           PERFORM 9490-PRT-LINE.
           ADD LINE-ADV               TO  LINE-CTR.
           PERFORM 9200-RETURN-RCD.

      **************************************************************
      *    TC 32D.                                                 *
      **************************************************************

       9340-PRT-32D.
           IF LINE-CTR > +55
               PERFORM 9320-HDR-325-334.
           MOVE SPACES                TO  PRT-LINE.
           PERFORM 9210-BLD-DATE-TIME.
           MOVE 4 TO DATE-MODE.
           MOVE DATE-SLASH-OUT        TO  PRT-PLT-DATE.
           MOVE BLD-TIME              TO  PRT-PLT-TIME.
           MOVE DDAILYTC-CODE         TO  PRT-DLET-PO-CODE.
           MOVE TC32D-PO-RLS          TO  WS-DLET-PO-RLS.
           MOVE WS-DLET-PO-NO         TO  PRT-DLET-PO-NO.
           IF WS-DLET-PO-RLSE = ZERO
               NEXT SENTENCE
           ELSE
               MOVE WS-DLET-PO-RLSE   TO  PRT-DLET-PO-RLSE
               MOVE "-"               TO  PRT-DLET-PO-DASH.
           MOVE TC32D-ITEM-NO         TO  PRT-DLET-PO-ITEM.
           PERFORM 9490-PRT-LINE.
           ADD LINE-ADV               TO  LINE-CTR.
           PERFORM 9200-RETURN-RCD.

      **************************************************************
      *    TC 320, 321.                                            *
      **************************************************************

       9350-PRT-320.
           IF LINE-CTR > +55
               PERFORM 9320-HDR-325-334.
           MOVE SPACES                TO  PRT-LINE.
           PERFORM 9210-BLD-DATE-TIME.
           MOVE 4 TO DATE-MODE.
           MOVE DATE-SLASH-OUT        TO  PRT-PLT-DATE.
           MOVE BLD-TIME              TO  PRT-PLT-TIME.
           MOVE T320-CORP-CODE       TO  PRT-PO-CODE.
           MOVE T320-PO-RLS          TO  WS-PO-RLS.
           MOVE WS-PO-NO              TO  PRT-PO-NO.
           IF WS-PO-RLSE = ZERO
               NEXT SENTENCE
           ELSE
               MOVE WS-PO-RLSE        TO  PRT-PO-RLSE
               MOVE "-"               TO  PRT-PO-DASH.
           MOVE T320-ITEM-NO         TO  PRT-PO-ITEM.
           MOVE T320-QTY             TO  WS-PO-QUANTITY.
           IF WS-PO-QTY-DEC = ZERO
               MOVE T320-QTY         TO  PRT-PO-QTY
           ELSE
               MOVE T320-QTY         TO  PRT-PO-QTY-R.
           MOVE T320-QTY-UM          TO  PRT-PO-QTY-UM.
           MOVE T320-PRICE           TO  PRT-PO-PRICE.
           MOVE T320-PRICE-UM        TO  PRT-PO-PRC-UM.
           MOVE T320-REQ-NO          TO  PRT-PO-REQ-NUM.
           MOVE T320-TAX-CODE        TO  PRT-PO-TAX.
           PERFORM 9490-PRT-LINE.
           ADD LINE-ADV               TO  LINE-CTR.
           PERFORM 9200-RETURN-RCD.

      **************************************************************
      *    TC 323, 324.                                            *
      **************************************************************

       9360-PRT-323.
           MOVE SPACES                TO  PRT-LINE.
           IF LINE-CTR > +55
               PERFORM 9320-HDR-325-334.
           MOVE SPACES                TO  PRT-LINE.
           PERFORM 9210-BLD-DATE-TIME.
           MOVE 4 TO DATE-MODE.
           MOVE DATE-SLASH-OUT             TO  PRT-PLT-DATE.
           MOVE BLD-TIME                   TO  PRT-PLT-TIME.
           MOVE T323-CORPCODE             TO  PRT-DOCK-CODE.
           IF DDAILYTC-CODE = "NON-STR"
               MOVE T323-NONCODED-RCV-QTY TO  PRT-DOC-QTY-NSTR
           ELSE
               MOVE T323-CODED-RCV-QTY   TO   PRT-DOCK-QTY.
           MOVE T323-UM                  TO   PRT-DOCK-QTY-UM.
           MOVE T323-RS                  TO   WS-DOCK-RLS.
           MOVE WS-DOCK-PO-NO            TO   PRT-DOCK-PO.
           MOVE WS-DOCK-PO-RLSE          TO   PRT-DOCK-RLSE.
           MOVE WS-DOCK-PO-RCVR          TO   PRT-DOCK-RCVR.
           MOVE "-"                      TO   PRT-DOCK-DASH1,
                                              PRT-DOCK-DASH2.
           MOVE T323-ITEM                TO   PRT-DOCK-ITEM.
9407CK     IF MPLTINFO-COMPANY = "211" OR "281" OR "284" OR "285"
  .           MOVE T323-KELLY-PRICE TO PRT-DOCK-UPR
  .           IF DDAILYTC-CODE = "NON-STR"
  .              MULTIPLY T323-KELLY-PRICE BY T323-NONCODED-RCV-QTY
  .                 GIVING PRT-DOCK-EXT
  .              IF DDAILYTC-TC = "323"
  .                 COMPUTE TOTAL-NONCODED-RECEIPTS =
  .                    TOTAL-NONCODED-RECEIPTS +
  .                    (T323-KELLY-PRICE * T323-NONCODED-RCV-QTY)
  .              END-IF
  .           ELSE
  .              MULTIPLY T323-KELLY-PRICE BY T323-CODED-RCV-QTY
  .                 GIVING PRT-DOCK-EXT
  .              IF DDAILYTC-TC = "323"
  .                 COMPUTE TOTAL-CODED-RECEIPTS =
  .                    TOTAL-CODED-RECEIPTS +
  .                    (T323-KELLY-PRICE * T323-CODED-RCV-QTY)
  .              END-IF
  .        ELSE
  .           MOVE T323-UNIT-PRICE TO PRT-DOCK-UPR
  .           IF DDAILYTC-CODE = "NON-STR"
  .              MULTIPLY T323-UNIT-PRICE BY T323-NONCODED-RCV-QTY
  .                 GIVING PRT-DOCK-EXT
  .              IF DDAILYTC-TC = "323"
  .                 COMPUTE TOTAL-NONCODED-RECEIPTS =
  .                    TOTAL-NONCODED-RECEIPTS +
  .                    (T323-UNIT-PRICE * T323-NONCODED-RCV-QTY)
  .              END-IF
  .           ELSE
  .              MULTIPLY T323-UNIT-PRICE BY T323-CODED-RCV-QTY
  .                 GIVING PRT-DOCK-EXT
  .              IF DDAILYTC-TC = "323"
  .                 COMPUTE TOTAL-CODED-RECEIPTS =
  .                    TOTAL-CODED-RECEIPTS +
9407CK                 (T323-UNIT-PRICE * T323-CODED-RCV-QTY).
           PERFORM 9490-PRT-LINE.
           ADD LINE-ADV                  TO   LINE-CTR.
           PERFORM 9200-RETURN-RCD.

      **************************************************************
      *    TC 325.                                                 *
      **************************************************************

       9370-PRT-325.
           IF LINE-CTR > +55
               PERFORM 9320-HDR-325-334.
           MOVE SPACES                TO  PRT-LINE.
           PERFORM 9210-BLD-DATE-TIME.
           MOVE T325-CORPCODE        TO  PRT-325-CODE.
           MOVE T325-STORED-QTY      TO  PRT-325-QTY.
           MOVE T325-UM              TO  PRT-325-UM.
           MOVE T325-RS              TO  WS-SRCPT-RLS.
           MOVE WS-SRCPT-PO-NO        TO  PRT-325-PO.
           MOVE WS-SRCPT-PO-RLSE      TO  PRT-325-RLSE.
           MOVE WS-SRCPT-PO-RCVR      TO  PRT-325-RCVR.
           MOVE "-"                   TO  PRT-325-DASH1,
                                          PRT-325-DASH2.
           MOVE T325-ITEM            TO  PRT-325-ITM.
           MOVE 4 TO DATE-MODE.
           MOVE DATE-SLASH-OUT        TO  PRT-325-DATE.
           MOVE BLD-TIME              TO  PRT-325-TIME.
           PERFORM 9490-PRT-LINE.
           ADD +1  TO  LINE-CTR.
           PERFORM 9200-RETURN-RCD.
       9370-PRT-325-E.
           EXIT.

      **************************************************************
      *    TC 332.                                                 *
      **************************************************************

       9380-PRT-332.
           IF LINE-CTR > +55
               PERFORM 9320-HDR-325-334.
           MOVE SPACES               TO  PRT-LINE.
           PERFORM 9210-BLD-DATE-TIME.
           MOVE TC332-CORP-CODE      TO  PRT-332-CODE
                                         CODE-ARG.
           MOVE TC332-ADJ-QTY        TO  PRT-332-QTY.
           MOVE TC332-UM             TO  PRT-332-UM.
           MOVE TC332-AVG-COST-BIG   TO  PRT-332-AVGCST.
           MOVE TC332-DEPT-CHG       TO  PRT-332-CHRG.
           MOVE TC332-DFLT-EXP-CLASS TO  PRT-332-EXP-CLS.
           MOVE 4 TO DATE-MODE.
           MOVE DATE-SLASH-OUT       TO  PRT-332-DATE.
           MOVE BLD-TIME             TO  PRT-332-TIME.

           MULTIPLY TC332-ADJ-QTY    BY  TC332-AVG-COST-BIG
               GIVING  TRANS-VALUE   ROUNDED.
           MOVE TRANS-VALUE          TO  PRT-332-VALUE.
           ADD  TRANS-VALUE          TO  GRAND-TOTALS.

           PERFORM 9490-PRT-LINE.
           ADD LINE-ADV              TO  LINE-CTR.
           PERFORM 9470-PRT-DESC THRU 9475-PD-X.
           PERFORM 9200-RETURN-RCD.

      **************************************************************
      *    TC 333.                                                 *
      **************************************************************

        9390-PRT-333.
           MOVE SPACES               TO  PRT-LINE.

      *---------- IF THE ISSUES AND RETURNS BY REQUESTING DEPT REPORT
      *           IS DONE, WE CONTROL BREAK ON REQUESTION DEPT.  FOR THE
      *           OTHER TYPES OF REPORTS, WE CONTROL BREAK ON CHARGE DEPT

           IF REPORT-IS-R
               IF T333-REQ-DEPT NOT = ISS-CHRG-SAVE
                   PERFORM 94-3331-CNTL-BREAK
                   PERFORM 9400-CTLBRK-333
               ELSE
                  IF T333-EMP NOT = SAVE-EMP
                  PERFORM 94-3331-CNTL-BREAK.
           IF NOT REPORT-IS-R
               IF T333-EXP-CLASS NOT = EXP-CLASS-SAVE OR
                  T333-DEPT NOT = ISS-CHRG-SAVE
                   PERFORM 9430-CTLBRK-333
               END-IF
               IF T333-DEPT NOT = ISS-CHRG-SAVE
                   PERFORM 9400-CTLBRK-333
               ELSE
               IF T333-DEPARTMENT NOT = ISS-CHRG-SAVE-6
                   MOVE "Y" TO HAD-SUBBREAK-FLAG
                   PERFORM 9410-SUBBREAK-333 THRU 9420-S3-X.

           IF LINE-CTR > +55
               PERFORM 9320-HDR-325-334.
           MOVE SPACES               TO  PRT-LINE.
           PERFORM 9210-BLD-DATE-TIME.
           MOVE T333-CORPCODE       TO  PRT-333-CODE
                                         CODE-ARG.
      *****IF T333-QTY > 999999
           IF T333-QTY > 99999
               MOVE "*OVER*"        TO  PRT-333-QTY-R
           ELSE
               MOVE T333-QTY        TO  PRT-333-QTY.
           MOVE T333-UM             TO  PRT-333-UM.
           IF T333-AVG-COST > 99999999.9999
               MOVE "       *OVER*" TO  PRT-333-AVG-R
           ELSE
               MOVE T333-AVG-COST   TO  PRT-333-AVGCST.
           MOVE T333-DEPARTMENT     TO  PRT-333-CHRG.
           MOVE T333-EXP-CLASS      TO  PRT-333-EXP-CLS.

      *-------- FIND EMPLOYEE NAME.
           MOVE T333-EMP            TO  PRT-333-EMP.
      *-------- 09APR97 COMMENTED OUT THE FOLLOWING "IF CC-VALIDATE-SW"
      *-------- LOGIC.  WE WILL NOW ALWAYS TRY TO FIND THE CC NAME.
      *****IF CC-VALIDATE-SW = "Y"

           MOVE T333-EMP            TO  PERCCNUM  OF PERS-I.
           PERFORM 997-FIND-CLOCK-CARD.
           IF PER-EMP-NAME NOT = SPACES
               MOVE PER-EMP-NAME    TO  PRT-333-EMP-NAME.

           MOVE T333-WORK-ORDER     TO  PRT-333-WO.
           MOVE T333-REQ-DEPT       TO  PRT-333-REQ-DPT.
           MOVE 4 TO DATE-MODE.
           MOVE DATE-SLASH-OUT           TO   PRT-333-DATE.
           MOVE BLD-TIME                 TO   PRT-333-TIME.

           MULTIPLY T333-QTY            BY   T333-AVG-COST
               GIVING  TRANS-VALUE   ROUNDED.
           ADD TRANS-VALUE               TO   DEPT-TOT, EMP-TOT,
                                              DEPT-TOT-6,
                                              EXP-CLASS-TOT.
           IF TRANS-VALUE > 9999999999.9999
               MOVE "         *OVER*"    TO   PRT-333-VAL-R
           ELSE
               MOVE TRANS-VALUE          TO   PRT-333-VALUE.

      *---------- THE REPORT WILL FLAG WHETHER THIS ITEM IS REPAIRABLE.
           MOVE T333-CORPCODE           TO   CODE-ARG.
      *    CALL "DBGET" USING BASE, DSET-MSTORERM, MODE7,
      *      STATUS-AREA, ALL-ITEM-LIST, BUF-MSTORERM,
      *      CODE-ARG.
           MOVE CODE-ARG TO CORPCDE OF MSTORERM-REC-I.
           READ MSTORERM-I INTO BUF-MSTORERM
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS = "23"
               MOVE SPACES               TO   PRT-333-REP-IND
           ELSE
           IF FILE-STATUS = "00"
               IF STR-OUT-REP = "X" OR STR-MAINT = "X"
                   MOVE "*REP*"          TO   PRT-333-REP-IND
               ELSE
                   MOVE SPACES           TO   PRT-333-REP-IND
           ELSE
               MOVE "DBGET ERR MSTORE 93-333-PR" TO BU-DISPLAY-MSG
               PERFORM 2100-BLOWUP.

           IF STR-ONHAND = ZEROS
               MOVE "*ZERO*"    TO  PRT-333-ZOH
           ELSE
             IF STR-ONHAND < STR-EXPEDITE
               MOVE "-EXPD-"    TO  PRT-333-ZOH
           ELSE
             IF STR-ONHAND < STR-REORDER
               MOVE "<REOR>"    TO  PRT-333-ZOH
           ELSE
               MOVE SPACES      TO  PRT-333-ZOH
           END-IF
           END-IF
           END-IF.

           PERFORM 9490-PRT-LINE.
           ADD LINE-ADV              TO  LINE-CTR.
           PERFORM 9470-PRT-DESC THRU 9475-PD-X.
           PERFORM 9200-RETURN-RCD.

       93-333-P-R-E.
           EXIT.

       9400-CTLBRK-333.
           PERFORM 9410-SUBBREAK-333 THRU 9420-S3-X.

           MOVE SPACES               TO  PRT-LINE.
           MOVE 3                    TO  LINE-ADV.
           PERFORM 9490-PRT-LINE.

           MOVE ISS-CHRG-SAVE        TO  PRT-DEPARTMENT.
           MOVE DEPT-TOT             TO  PRT-DEPT-TOT
           MOVE DEPT-TOT-HDR         TO  PRT-LINE.
           PERFORM 9490-PRT-LINE.

           ADD DEPT-TOT              TO  GRAND-TOTALS.
           MOVE ZERO                 TO  DEPT-TOT.
           MOVE ZERO                 TO  DEPT-TOT-6.

           IF REPORT-IS-R
               MOVE T333-REQ-DEPT   TO  ISS-CHRG-SAVE
           ELSE
               MOVE T333-DEPT       TO  ISS-CHRG-SAVE
               MOVE T333-DEPARTMENT TO  ISS-CHRG-SAVE-6.

           ADD LINE-ADV TO LINE-CTR.
           PERFORM 9320-HDR-325-334.
           MOVE "N"                      TO   HAD-SUBBREAK-FLAG.

       9410-SUBBREAK-333.
           IF HAD-SUBBREAK-FLAG NOT = "Y"
               GO TO 9420-S3-X.
           MOVE 2                        TO   LINE-ADV.
           MOVE ISS-CHRG-SAVE-6          TO   PRT-DEPARTMENT.
           MOVE DEPT-TOT-6               TO   PRT-DEPT-TOT.
           MOVE DEPT-TOT-HDR             TO   PRT-LINE.
           PERFORM 9490-PRT-LINE.
           ADD LINE-ADV                  TO   LINE-CTR.
           MOVE 1                        TO   LINE-ADV.
           MOVE 0                        TO   DEPT-TOT-6.
           MOVE T333-DEPARTMENT          TO   ISS-CHRG-SAVE-6.
       9420-S3-X.
           EXIT.

       9430-CTLBRK-333.
           IF LINE-CTR > +55
               PERFORM 9320-HDR-325-334.
           MOVE SPACES               TO  PRT-LINE.
           MOVE 1                    TO  LINE-ADV.
           ADD LINE-ADV              TO  LINE-CTR.
           PERFORM 9490-PRT-LINE.
           MOVE EXP-CLASS-SAVE       TO  PRT-EXP-CLASS.
           MOVE EXP-CLASS-TOT        TO  PRT-EXP-CLASS-TOT.
           MOVE EXP-CLASS-TOT-HDR    TO  PRT-LINE.
           MOVE 2                    TO  LINE-ADV.
           PERFORM 9490-PRT-LINE.
           ADD LINE-ADV TO LINE-CTR.
           MOVE 1                    TO  LINE-ADV.

           MOVE ZERO                 TO  EXP-CLASS-TOT.
           MOVE T333-EXP-CLASS       TO  EXP-CLASS-SAVE.

       94-3331-CNTL-BREAK.
           IF REPORT-IS-R THEN
               MOVE SPACES TO PRT-LINE
               MOVE 1 TO LINE-ADV
               PERFORM 9490-PRT-LINE
               MOVE EMP-TOT TO PRT-EMP-TOT
               MOVE EMP-TOT-HDR TO PRT-LINE
               MOVE 2 TO LINE-ADV
               PERFORM 9490-PRT-LINE
               MOVE ZERO TO EMP-TOT
               MOVE T333-EMP TO SAVE-EMP
               ADD 3 TO LINE-CTR.


      **************************
      *                        *
      *     TC   334           *
      *                        *
      **************************

       9410-PRT-334.
           IF LINE-CTR  >  55
               PERFORM 9320-HDR-325-334.
           MOVE SPACES  TO  PRT-LINE.
           PERFORM 9210-BLD-DATE-TIME.
            MOVE 4 TO DATE-MODE.
           MOVE DATE-SLASH-OUT     TO  PRT-334-DATE.
           MOVE BLD-TIME           TO  PRT-334-TIME.
           MOVE TC334-TRAN-QTY     TO  PRT-334-QTY-TRAN.
           MOVE TC334-STR-UM       TO  PRT-334-QTY-UM.
           MOVE TC334-CORP-CODE    TO  PRT-334-FROM-CODE.
           MOVE TC334-NEW-CODE     TO  PRT-334-TO-CODE.
           MOVE TC334-OLD-CLASS    TO  PRT-334-FROM-CLASS.
           MOVE TC334-NEW-CLASS    TO  PRT-334-TO-CLASS.
           PERFORM 9490-PRT-LINE.
           ADD LINE-ADV                 TO  LINE-CTR.
           PERFORM 9200-RETURN-RCD.

      *****************
      *               *
      *    TC  335    *
      *               *
      *****************

       9420-PRT-335.
           IF LINE-CTR > +55
               PERFORM 9320-HDR-325-334.
           MOVE SPACES               TO  PRT-LINE.
           PERFORM 9210-BLD-DATE-TIME.
           MOVE T335-CORP-CODE      TO  PRT-335-CODE.
           MOVE T335-DOCUMENT       TO  PRT-335-DOCUMENT.
           MOVE T335-LOCATION       TO  PRT-335-DESTORIG.
           MOVE T335-EMPL           TO  PRT-335-EMPL.
           MOVE T335-QTY            TO  PRT-335-QTY.
           MOVE T335-AVG-COST       TO  PRT-335-AVGCST.
           MOVE T335-UM             TO  PRT-335-UM.
           MULTIPLY T335-QTY BY T335-AVG-COST
               GIVING TRANS-VALUE ROUNDED.
           MOVE TRANS-VALUE          TO  PRT-335-VALUE.

           PERFORM 9490-PRT-LINE.
           ADD LINE-ADV              TO  LINE-CTR.
           PERFORM 9200-RETURN-RCD.


      **************************************************************
      *    TC 360.                                                 *
      **************************************************************

       9430-PRT-360.
           IF LINE-CTR > +55
               PERFORM 9320-HDR-325-334.
           MOVE SPACES                TO  PRT-LINE.
           PERFORM 9210-BLD-DATE-TIME.
           MOVE TC360-PO-RLS          TO  WS-PO-TH-RLS.
           MOVE WS-PO-TH-NO           TO  PRT-PO-TH-PO.
           MOVE "-"                   TO  PRT-PO-TH-DASH.
           MOVE WS-PO-TH-RLSE         TO  PRT-PO-TH-RLS.
           MOVE TC360-PO-FOB          TO  PRT-PO-TH-FOB.
           MOVE TC360-VENDOR-CODE     TO  PRT-PO-TH-VENDOR.
           MOVE TC360-PO-TERMS        TO  PRT-PO-TH-TERMS.
           MOVE TC360-CURRENCY-CODE   TO  PRT-PO-TH-CURR.
           MOVE TC360-VENDOR-NAME     TO  PRT-PO-TH-VEN-NM.
           MOVE 4 TO DATE-MODE.
           MOVE DATE-SLASH-OUT        TO  PRT-360-DATE.
           MOVE BLD-TIME              TO  PRT-360-TIME.

           PERFORM 9490-PRT-LINE.
           ADD LINE-ADV             TO  LINE-CTR.
           PERFORM 9200-RETURN-RCD.


      **************************************************************
      *    TC 399.                                                 *
      **************************************************************

        9440-PRT-399.

           IF LINE-CTR > +55
               PERFORM 9320-HDR-325-334.
           MOVE SPACES               TO  PRT-LINE.
           PERFORM 9210-BLD-DATE-TIME.
           MOVE DLY-HI-USE-CORP-CODE    TO  PRT-399-CODE.
      **** IF DLY-HI-USE-QTY > 999999
           IF DLY-HI-USE-QTY > 99999
               MOVE "*OVER*"            TO  PRT-399-QTY-R
           ELSE
               MOVE DLY-HI-USE-QTY      TO  PRT-399-QTY.
           MOVE DLY-HI-USE-UM           TO  PRT-399-UM.
           IF DLY-HI-USE-AVG-CST > 99999999.9999
               MOVE "       *OVER*"     TO  PRT-399-AVG-R
           ELSE
               MOVE DLY-HI-USE-AVG-CST  TO  PRT-399-AVGCST.
           MOVE DLY-HI-USE-CHRG         TO  PRT-399-CHRG.
           MOVE DLY-HI-USE-EXP-CLS      TO  PRT-399-EXP-CLS.
           MOVE DLY-HI-USE-EMP          TO  PRT-399-EMP.

      *-------- FIND EMPLOYEE NAME.
      *-------- 09APR97 COMMENTED OUT THE FOLLOWING "IF CC-VALIDATE-SW"
      *-------- LOGIC.  WE WILL NOW ALWAYS TRY TO FIND THE CC NAME.
      *****IF CC-VALIDATE-SW = "Y"

           MOVE PRT-399-EMP             TO  PERCCNUM  OF PERS-I.
           PERFORM 997-FIND-CLOCK-CARD.
           IF PER-EMP-NAME NOT = SPACES
               MOVE PER-EMP-NAME    TO  PRT-399-EMP-NAME.

           MOVE DLY-HI-USE-WO           TO  PRT-399-WO.
           MOVE DLY-HI-USE-REQ-DPT      TO  PRT-399-REQ-DPT.
           MOVE 4 TO DATE-MODE.
           MOVE DATE-SLASH-OUT          TO  PRT-399-DATE.
           MOVE BLD-TIME                TO  PRT-399-TIME.

           MULTIPLY DLY-HI-USE-QTY      BY  DLY-HI-USE-AVG-CST
               GIVING  TRANS-VALUE   ROUNDED.
           IF TRANS-VALUE > 9999999999.99
               MOVE "       *OVER*"     TO  PRT-399-VAL-R
           ELSE
               MOVE TRANS-VALUE         TO  PRT-399-VALUE.

           PERFORM 9490-PRT-LINE.
           ADD LINE-ADV              TO  LINE-CTR.
           PERFORM 9200-RETURN-RCD.

       9445-PRT-399-X.
           EXIT.

       9450-PRT-999.
           IF LINE-CTR > 55
               PERFORM 9320-HDR-325-334.
           MOVE SPACES                   TO  PRT-LINE.
           PERFORM 9210-BLD-DATE-TIME.
           MOVE TC999-CORP-CODE          TO  PRT-999-CODE.
           MOVE TC999-ONHAND             TO  PRT-999-ONHAND.
           MOVE TC999-UM                 TO  PRT-999-ONHAND.
           PERFORM 9490-PRT-LINE.
           ADD LINE-ADV                  TO  LINE-CTR.
           PERFORM 9200-RETURN-RCD.
       9455-PRT-999-X.
           EXIT.

      **************************************************************
      *    BAD TC'S.                                               *
      **************************************************************

       9460-PRT-BAD .
           IF LINE-CTR > +55
               PERFORM 9320-HDR-325-334.
           MOVE BUF-DDAILYTC         TO  PRT-LINE.
           PERFORM 9490-PRT-LINE.
           ADD LINE-ADV              TO  LINE-CTR.
           PERFORM 9200-RETURN-RCD.

       9465-PRT-BAD-X.
           EXIT.

      **************************************************************
      *    ONLY THE FIRST LINE OF DESCRIPTION OF A CORPORATE CODE  *
      *    IS PRINTED ON THE REPORT.                               *
      **************************************************************
       9470-PRT-DESC.
           MOVE SPACES               TO  PRT-LINE.
      *    CALL "DBFIND" USING BASE DSET-DESC MODE1 STATUS-AREA
      *                        CODE-SEARCH CODE-ARG.

           MOVE CODE-ARG TO CORPCDE OF DDESC-REC-I.
           START DDESC-I KEY = CORPCDE OF DDESC-REC-I
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF (FILE-STATUS NOT = "00") AND (FILE-STATUS-1 NOT = "2")
               MOVE "DBFIND ERR 9470-PD" TO BU-DISPLAY-MSG
               PERFORM 2100-BLOWUP.

      *    CALL "DBGET" USING BASE DSET-DESC MODE5 STATUS-AREA
      *                       ALL-ITEM-LIST BUF-DDESC CODE-ARG.
           MOVE 0 TO COND-WORD.
           READ DDESC-I NEXT INTO BUF-DDESC
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   MOVE 15 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.
           IF CORPCDE OF DDESC-REC-I NOT = CODE-ARG
               MOVE 15 TO COND-WORD.
           IF  COND-WORD = 15
               MOVE "NO DESCRIPTION ON FILE" TO PRT-DESC
               GO TO 9472-PRT-LINE
           ELSE
           IF  COND-WORD NOT = ZERO
               MOVE "DBGET ERR DDESC 98-PD" TO BU-DISPLAY-MSG
               PERFORM 2100-BLOWUP
           ELSE
               MOVE DESC-DATA TO PRT-DESC.
       9472-PRT-LINE.
           PERFORM 9490-PRT-LINE.
           ADD LINE-ADV              TO  LINE-CTR.
       9475-PD-X.
           EXIT.

       9480-PRT-TOP.
           WRITE PRT-REC   AFTER  ADVANCING NEW-PAGE.
       9490-PRT-LINE.
           WRITE PRT-REC   BEFORE ADVANCING LINE-ADV LINES.

       9495-OR-X.
           EXIT.

      *9500-TOTAL-360 SECTION.
      *9510-START-360.
      *    MOVE SPACES TO END-OF-FILE-FLAG.
      *    MOVE 99 TO LINE-CTR.
      *    PERFORM 9520-RETURN-360.
      *    MOVE SPACES TO TEMP-BUDGET-NO.
      *    IF NOT IT-IS-END-OF-FILE
      *        MOVE S-BUDGET-NO TO TEMP-BUDGET-NO
      *        MOVE ZERO TO TEMP-BUDGET-AMT, TOT-BUDGET-AMT
      *        PERFORM 9530-MAIN-360 UNTIL IT-IS-END-OF-FILE
      *        PERFORM 9540-PRINT-TOTAL-360
      *        MOVE SPACES TO PRT-LINE
      *        MOVE "------------" TO PRT-PO-TH-BDGT-NO
      *        WRITE PRT-REC AFTER ADVANCING 1
      *        ADD 1 TO LINE-CTR
      *        MOVE "GRAND TOTAL " TO TEMP-BUDGET-NO
      *        MOVE TOT-BUDGET-AMT TO TEMP-BUDGET-AMT
      *        PERFORM 9540-PRINT-TOTAL-360.
      *    GO TO 9560-360-X.
      *
      *9520-RETURN-360.
      *    RETURN SORT-360-FILE
      *        AT END MOVE "Y" TO END-OF-FILE-FLAG.
      *
      *9530-MAIN-360.
      *    IF S-BUDGET-NO = SPACES
      *          PERFORM 9520-RETURN-360
      *          MOVE S-BUDGET-NO TO TEMP-BUDGET-NO
      *    ELSE
      *    IF S-BUDGET-NO = TEMP-BUDGET-NO
      *        ADD S-BUDGET-AMT TO TEMP-BUDGET-AMT, TOT-BUDGET-AMT
      *        PERFORM 9520-RETURN-360
      *    ELSE
      *        PERFORM 9540-PRINT-TOTAL-360
      *        MOVE S-BUDGET-NO TO TEMP-BUDGET-NO
      *        MOVE ZERO TO TEMP-BUDGET-AMT.

      *9540-PRINT-TOTAL-360.
      *    PERFORM 9550-CHECK-TOF.
      *    MOVE SPACES TO PRT-LINE.
      *    MOVE TEMP-BUDGET-NO TO PRT-PO-TH-BDGT-NO.
      *    MOVE TEMP-BUDGET-AMT TO PRT-PO-TH-BDGT-AMT.
      *    WRITE PRT-REC AFTER ADVANCING 1.
      *    ADD 1 TO LINE-CTR.
      *
      *9550-CHECK-TOF.
      *    IF LINE-CTR > 55
      *        MOVE 5 TO LINE-CTR
      *        ADD 1 TO PG-CTR
      *        MOVE PG-CTR TO PG-NO
      *        MOVE SPACES TO PRT-LINE
      *        WRITE PRT-REC AFTER ADVANCING NEW-PAGE.
      *        MOVE MAST-HDR1 TO PRT-LINE
      *        WRITE PRT-REC AFTER ADVANCING 1
      *        MOVE "TOTAL BUDGET AMOUNTS" TO HDR2-TITLE
      *        MOVE MAST-HDR2 TO PRT-LINE
      *        WRITE PRT-REC AFTER ADVANCING 1
      *        MOVE 360-TOT-HDR-2 TO PRT-LINE
      *        WRITE PRT-REC AFTER ADVANCING 1
      *        MOVE SPACES TO PRT-LINE
      *        WRITE PRT-REC AFTER ADVANCING 1.
      *
      *9560-360-X.
      *    EXIT.
      *
       9600-PRE-FREIGHT SECTION 05.

       9610-PREFRT-START.
           MOVE SPACES TO END-OF-FILE-FLAG.
           PERFORM 9620-PREFRT-RETURN.
           PERFORM 9630-PREFRT-MAIN UNTIL IT-IS-END-OF-FILE.
           GO TO 9640-PREFRT-X.

       9620-PREFRT-RETURN.
           RETURN SORT-FRT-FILE INTO FRT-INFO
              AT END MOVE "Y" TO END-OF-FILE-FLAG.

      *****PERFORM 9990-REFORMAT.   *MOVED INTO NEXT PARA - 07JAN94*

       9630-PREFRT-MAIN.
           PERFORM 9990-REFORMAT.

           IF F-TC = "350"
               MOVE F-PO TO SAVE-PO
               MOVE FRT-INFO TO FRT-REC-OUT
           ELSE
               IF F-TC = "352"
                   IF F-PO = SAVE-PO AND F-TYPE = "C" OR "G"
                       WRITE FRT-REC-OUT.

           PERFORM 9620-PREFRT-RETURN.

       9640-PREFRT-X.
           EXIT.

       9650-FREIGHT-BILL SECTION.

       9660-FBILL-START.
           MOVE SPACES TO END-OF-FILE-FLAG.
           MOVE 99 TO LINE-CTR.
           PERFORM 9670-FBILL-RETURN.
           PERFORM 9680-FBILL-MAIN UNTIL IT-IS-END-OF-FILE.
           GO TO 9695-FBILL-X.

       9670-FBILL-RETURN.
           RETURN SORT-FRT-FILE INTO FRT-INFO
                AT END MOVE "Y" TO END-OF-FILE-FLAG.

      *****PERFORM 9990-REFORMAT.  *MOVED INTO NEXT PARA - 07JAN94*

       9680-FBILL-MAIN.
           PERFORM 9990-REFORMAT.
           MOVE SPACE TO PRT-LINE.
           MOVE F-PO TO SAVE-PO.
           MOVE F-CARRIER TO P350-CARRIER.
           MOVE F-PRO-NO TO P350-PRO-NO.
           MOVE SPACE TO DATE-CHECK-AREA.
           MOVE 4 TO DATE-MODE.
           MOVE F-PRO-DATE TO DATE-VALIDATE-IN.
           CALL "TDATECHK" USING DATE-CHECK-AREA.
           MOVE DATE-SLASH-OUT TO P350-PRO-DATE.
           MOVE F-CHARGES TO P350-CHARGES.
           MOVE F-PO      TO P350-PO.
           IF F-MULTI-ORIG-RS > SPACES
               MOVE F-MULTI-ORIG-RS  TO P350-MULTI-ORIG-RS
               MOVE "MULTI-"         TO P350-MULTI-LIT
           ELSE
               MOVE SPACES           TO P350-MULTI-ORIG-RS,
                                        P350-MULTI-LIT.
           PERFORM 9685-FBILL-PRINT.
           PERFORM 9670-FBILL-RETURN.

       9685-FBILL-PRINT.
           PERFORM 9690-FBILL-CHECK-TOF.
           WRITE PRT-REC AFTER ADVANCING 1.
           ADD 1 TO LINE-CTR.

       9690-FBILL-CHECK-TOF.
           IF LINE-CTR > 55
               MOVE PRT-REC TO SAVE-REC
               MOVE 5 TO LINE-CTR
               ADD 1 TO PG-CTR
               MOVE PG-CTR TO PG-NO
               MOVE SPACES TO PRT-LINE
               WRITE PRT-REC AFTER ADVANCING NEW-PAGE
               MOVE MAST-HDR1 TO PRT-LINE
               WRITE PRT-REC AFTER ADVANCING 1
               MOVE "FREIGHT BILL INFORMATION" TO HDR2-TITLE
               MOVE MAST-HDR2 TO PRT-LINE
               WRITE PRT-REC AFTER ADVANCING 1
               MOVE 350-HDR TO PRT-LINE
               WRITE PRT-REC AFTER ADVANCING 1
               MOVE SPACES TO PRT-LINE
               WRITE PRT-REC AFTER ADVANCING 1
               MOVE SAVE-REC TO PRT-REC.

       9695-FBILL-X.
           EXIT.

       9990-MISC SECTION.
       9990-REFORMAT.
           MOVE SPACES                   TO   BUF-NEW-TRANSACTIONS.

           IF SRT-ACTUAL-TC = "311" AND TC311-ID-5 = "5"
               MOVE TC311-CORP-CODE      TO   T311-CORP-CODE
               MOVE TC311-ID-5           TO   T311-ID-5
               MOVE TC311-AVG-COST       TO   T311-AVG-COST
               MOVE TC311-STD-COST       TO   T311-STD-COST
               MOVE TC311-MKT-COST       TO   T311-MKT-COST
               MOVE TC311-UM             TO   T311-UM
               MOVE TC311-ONHAND         TO   T311-ONHAND
               MOVE TC311-CLASS-ID5      TO   T311-CLASS-ID5
               MOVE TC311-OLD-UM         TO   T311-OLD-UM
               MOVE TC311-OLD-ONHAND     TO   T311-OLD-ONHAND
           ELSE
           IF SRT-ACTUAL-TC = "411"
               MOVE TC411-CORP-CODE      TO   T311-CORP-CODE
               MOVE "5"                  TO   T311-ID-5
               MOVE TC411-AVG-COST       TO   T311-AVG-COST
               MOVE TC411-STD-COST       TO   T311-STD-COST
               MOVE TC411-MKT-COST       TO   T311-MKT-COST
               MOVE TC411-UM             TO   T311-UM
               MOVE TC411-ONHAND         TO   T311-ONHAND
               MOVE TC411-CLASS          TO   T311-CLASS-ID5
               MOVE TC411-OLD-UM         TO   T311-OLD-UM
               MOVE TC411-OLD-ONHAND     TO   T311-OLD-ONHAND
           ELSE
           IF SRT-ACTUAL-TC = "320" OR "321"
               MOVE TC320-CORP-CODE      TO   T320-CORP-CODE
               MOVE TC320-PO-RLS         TO   T320-PO-RLS
               MOVE TC320-ITEM-NO        TO   T320-ITEM-NO
               MOVE TC320-QTY            TO   T320-QTY
               MOVE TC320-QTY-UM         TO   T320-QTY-UM
               MOVE TC320-PRICE          TO   T320-PRICE
               MOVE TC320-PRICE-UM       TO   T320-PRICE-UM
               MOVE TC320-REQ-NO         TO   T320-REQ-NO
               MOVE TC320-TAX-CODE       TO   T320-TAX-CODE
