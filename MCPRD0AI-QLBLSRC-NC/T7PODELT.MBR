016300
016400 PROCEDURE DIVISION.
016500 BEGIN SECTION.
       BEGIN-HERE.
016600
016700     PERFORM 1-HSK  THRU  1-HSK-X.
016800     PERFORM 6-MAIN  THRU  6-MAIN-X.
016900     PERFORM 2-CLOSE-FILES  THRU  2-CLOSE-FILES-X.
017000     GOBACK.
017100
017200
017300 1-HSK.
017400*************************************************************
017500*    ACCEPT DELETION DATE AND COMPANY CODE
017600*************************************************************
017700
017800     DISPLAY "** THIS PROGRAM WILL DELETE ALL POs OLDER THAN A".
017900     DISPLAY "** CERTAIN DATE.  PLEASE BE CAREFUL WITH ENTERING".
018000     DISPLAY "** THE DATE!!!!!".
018100     DISPLAY "  ".
018200     DISPLAY "ENTER THE DELETION DATE (MMDDYY)".
018300     ACCEPT DELETE-DATE.
018400     MOVE DELETE-DATE             TO DATE-VALIDATE-IN.
018500     MOVE 3                       TO DATE-MODE.
018600     CALL "TDATECHK" USING DATE-CHECK-AREA.
018700     IF DATE-RET-CODE NOT = 0
018800         DISPLAY "INVALID DATE; LETS START OVER"
018900         GO TO 1-HSK
019000     ELSE
019100         MOVE DATE-YMD-OUT        TO DELETE-DATE.

      *----FIGURE OUT CENTURY OF DELETION DATE.
           IF DELETE-DATE-YY > 70
               MOVE 19 TO DELETE-DATE-CC
           ELSE
               MOVE 20 TO DELETE-DATE-CC.
019200
019300     DISPLAY "DELETION DATE = ", DELETE-DATE-CN.
019400     DISPLAY "  ".
019500     DISPLAY "ENTER COMPANY CODE (nnn)".
019600     ACCEPT ACCEPT-CO-CODE.
019700     DISPLAY "COMPANY CODE = ", ACCEPT-CO-CODE.
019800     DISPLAY " ".
019900     DISPLAY "OK TO CONTINUE?".
020000     ACCEPT CONT-SW.
020100     IF CONT-SW = "Y" OR "N"
020200         NEXT SENTENCE
020300     ELSE
020400         DISPLAY "INVALID RESPONSE; LETS START OVER"
020500         GO TO 1-HSK.
020600     IF CONT-SW = "N"
020700         GO TO 1-HSK.
020800
020900*************************************************************
021000*     OPEN STORES DATA BASE 'STORES'
021100*************************************************************
021200
           OPEN INPUT MPLTINFO-I, DPORECD-I.
           OPEN I-O MPORCV-O.
022700
022800**********************************************
022900*  GET NO. OF MONTHS PO SHOULD STAY AFTER
023000*  DELETION REQUIREMENTS MEET AND THE INDICATOR
023100*  THAT DENOTES IF PLANT HAS INVOICE SOFTWARE
023200**********************************************
023300
023400     MOVE "PODL"       TO PLT-ARG.
           MOVE PLT-ARG TO PLTINFOKEY OF MPLTINFO-REC-I.
           READ MPLTINFO-I INTO BUF-MPLTINFO
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
023800         MOVE "GET MPLTINFO 'PODL' *1-HSK" TO BU-DISPLAY-MSG
023900         GO TO 2-BLOWUP
024000     ELSE
024100         MOVE MPLTINFO-PO-DEL-MTH   TO  PO-DELETE-MONTHS
024200         MOVE MPLTINFO-INVOICE-IND  TO  INVOICE-INDIC-SW.
024300
024400     DISPLAY "DELETE DATE ", DELETE-DATE-CN.
024600
024700******************************************
024800*   GET CO. CODE FROM MPLTINFO
024900******************************************
025000
025100     MOVE "P 01"       TO PLT-ARG.
           MOVE PLT-ARG TO PLTINFOKEY OF MPLTINFO-REC-I.
           READ MPLTINFO-I INTO BUF-MPLTINFO
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
025500         MOVE "GET MPLTINFO 'P 01' *1-HSK" TO BU-DISPLAY-MSG
025600         GO TO 2-BLOWUP
025700     ELSE
025800         MOVE MPLTINFO-COMPANY  TO  COMPANY-SAVE.
DCR01      MOVE MPLTINFO-COMPANY  TO  WS-Z000-PLANT-CODE.
025900
026000     IF COMPANY-SAVE = ACCEPT-CO-CODE
026100         NEXT SENTENCE
026200     ELSE
026300         MOVE "CO CODE ENTERED DOES NOT MATCH DATA BASE"
026400             TO BU-DISPLAY-MSG
026500         GO TO 2-BLOWUP.
026600
DCR01 *---------------------------------------------------------
DCR01      PERFORM Z000-PGM-SETUP         THRU Z000-PS-EXIT.
DCR01 *---------------------------------------------------------
026700 1-HSK-X.
026800     EXIT.
026900
DCR01 *---------------------------------------------------------
DCR01  Z000-PGM-SETUP.
DCR01 *****************************************************
DCR01 *   MAKE SURE PO LOGGING IS ACTIVE FOR THIS PLANT
DCR01 *****************************************************
DCR01      SET  Z000-POLG-ACTIVE-NO TO TRUE.
DCR01
DCR01      MOVE WS-Z000-POLG-KEY         TO  PLT-ARG.
           MOVE PLT-ARG TO PLTINFOKEY OF MPLTINFO-REC-I.
           READ MPLTINFO-I INTO BUF-MPLTINFO.
DCR01      IF FILE-STATUS = "00"
DCR01         IF  PLTINFODTA OF MPLTINFO-REC-I(1:1) = "Y"
DCR01             SET  Z000-POLG-ACTIVE-YES TO TRUE
DCR01         END-IF
DCR01      END-IF.
DCR01
DCR01      IF   Z000-POLG-ACTIVE-NO
DCR01           GO TO Z000-PS-EXIT
DCR01      END-IF.
DCR01
DCR01      PERFORM Z001-SETUP-PO-LOGGING  THRU Z001-EXIT.
DCR01      PERFORM Z110-RMV-USER-TRIGGER  THRU Z110-EXIT.
DCR01
DCR01  Z000-PS-EXIT.
DCR01       EXIT.
DCR01 *---------------------------------------------------------
027000
027100 2-CLOSE-FILES.
           CLOSE MPLTINFO-I, DPORECD-I, MPORCV-O.
028200
028300 2-CLOSE-FILES-X.
028400     EXIT.
028500
028600
028700
028800******************************************************
028900**                                                  **
029000**   BLOWUP ROUTINE                                 **
029100**                                                  **
029200******************************************************
029300
029400 2-BLOWUP.
029500     MOVE "T7PODELT" TO BU-PGM-NAME.
029600     CALL "TBLOWUP" USING BASE, BU-PGM-NAME, STATUS-AREA,
029700         DUMMY-VIEW-AREA, DUMMY-KSAM-STAT, BU-DISPLAY-MSG,
029800             BU-DISPLAY-FLDS.
030100
030200 6-MAIN.
      *----- CALL CCRTFILE TO CREATE A FILE 'PODELT'
      *----- LIBRARY '*LIBL' IS USED.
           MOVE SPACES        TO CCRTFILE-PARMS.
           MOVE "PODELT"      TO CCRTFILE-FILE.
           MOVE "0014"        TO CCRTFILE-RECORD-LENGTH.
           MOVE "01000"       TO CCRTFILE-NO-RECORDS.
           MOVE "01000"       TO CCRTFILE-INCREMENT-AMT.
           MOVE "30"          TO CCRTFILE-NO-INCREMENTS.
           CALL "CCRTFILE" USING CCRTFILE-LIBRARY,
                                 CCRTFILE-FILE,
                                 CCRTFILE-RECORD-LENGTH,
                                 CCRTFILE-NO-RECORDS,
                                 CCRTFILE-INCREMENT-AMT,
                                 CCRTFILE-NO-INCREMENTS,
                                 CCRTFILE-STATUS.
           IF CCRTFILE-STATUS NOT = "00"
               MOVE "CCRTFILE CREATE OF 'PODELT' FAILED"
                   TO BU-DISPLAY-MSG
               GO TO 2-BLOWUP.

030300     OPEN OUTPUT PO-DELETE-FILE.
030400     PERFORM 61-READ-PO-HEADER-DSET  THRU 61-RPHD-X.
030500     CLOSE PO-DELETE-FILE.
030600
030700     OPEN INPUT PO-DELETE-FILE.
030800     PERFORM 62-DELETE-PO  THRU  62-DP-X.
030900     CLOSE PO-DELETE-FILE.
031000
031100 6-MAIN-X.
031200     EXIT.
031300
031400
031500 61-READ-PO-HEADER-DSET.
031600**************************************
031700*                                    *
031800*  SERIAL READ ON DPORECD TO FIND    *
031900*  HEADER DATA                       *
032000*                                    *
032100**************************************
032200
           READ DPORECD-I NEXT INTO BUF-DPORECD
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
032700             GO TO 61-RPHD-X
032800         ELSE
032900             MOVE "GET DPORECD *61-RPHD" TO BU-DISPLAY-MSG
033000             GO TO 2-BLOWUP.
033100     MOVE PO-RCV-NO  TO  PO-ARG,
033200                         BU-DISPLAY-FLD (1).
033300
033400********** CHECK RELEASE FIELD FOR '999' WHICH MEANS THIS
033500********** THIS IS A REQUIREMENT ORDER AND THEY ARE NOT
033600********** DELETED AUTOMATICALLY
033700
033800     IF PO-RLS-NO = "999"
033900         GO TO 61-READ-PO-HEADER-DSET.
034000
034100******* CHECK PO DATE TO SEE IF IT IS OLDER THAN DELETE
034200******* DATE. IF IT ISNT THEN THE PO COULD'NT POSSIBLY MEET
034300******* THE DELETE REQUIREMENTS.
034400
034500     IF PO-DATE-CN < DELETE-DATE-CN
034600         NEXT SENTENCE
034700     ELSE
034800         GO TO 61-READ-PO-HEADER-DSET.
034900
035000*----- THE FOLLOWING LOGIG WHEN NOT COMMENTED OUT WILL DELETE
035100*----- INTERNAL ORDERS ONLY.  CHECKS FOR A PO NUMBER STARTING WITH
035200*----- 'IT'.
035300
035400**   MOVE PO-RCV-NO               TO BUILD-PO-NUM.
035500**   IF PO-NUM1-2 = "IT"
035600**       NEXT SENTENCE
035700**   ELSE
035800**       GO TO 61-READ-PO-HEADER-DSET.
035900
036000 61-CALL-SPOHIST.
036100     PERFORM 613-UPDATE-STORES-HISTORY  THRU  613-USH-X.
036200
036300 61-WRITE-PO-DELETE-FILE.
036400     MOVE PO-RCV-NO       TO PO-DEL-NUM.
036500     WRITE PO-DEL-RCD.
036600     GO TO 61-READ-PO-HEADER-DSET.
036700
036800 61-RPHD-X.
036900     EXIT.
037000
037100
037200*********************************************
037300*                                           *
037400*   THE NEXT PROCEDURE CALLS 'SPOHIST'      *
037500*   WHICH IS THE SUBROUTINE WHICH ABSTRACTS *
037600*   ALL THE PO HISTORY FOR A GIVEN PO AND   *
037700*   PLACES THIS INFO. IN THE HISTORY DB     *
037800*   'STHIST'                                *
037900*                                           *
038000*********************************************
038100
038200
038300 613-UPDATE-STORES-HISTORY.
           MOVE PO-ARG TO PORCVNO OF MPORCV-REC-O.
           READ MPORCV-O INTO BUF-MPORCV
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
059400         MOVE "GET MPORCV*613-USH" TO BU-DISPLAY-MSG
059500         GO TO 2-BLOWUP.
039900
040000********* IF 'PO-RCV-SEQ' IS = 'HISTOK' ON THE PO MASTER
040100********* 'MPORCV' THEN THIS MEANS THE PO HAS ALREADY BEEN
040200********* MOVED TO THE HISTORY DATA BASE AND THEREFORE IS
040300********* NOT COPIED OVER AGAIN.  OTHERWISE MARK 'PO-RCV-SEQ'
040400********* WITH 'HISTSP' AND CALL 'SPOHIST'.  IF 'SPOHIST'
040500********* SUCCESSFULLY COPYS THE PO OVER INTO THE HISTORY DB
040600********* THEN IT WILL MARK 'PO-RCV-SEQ' WITH A 'HISTOK'
040700********* INDICATOR
040800
040900     IF M-PO-RCV-SEQ = "HISTOK"
041100         GO TO 613-USH-X.
041200
041300     MOVE "HISTSP" TO  M-PO-RCV-SEQ.
           REWRITE MPORCV-REC-O FROM BUF-MPORCV
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
061400         MOVE "UPDATE MPORCV*613-USH" TO BU-DISPLAY-MSG
061500         GO TO 2-BLOWUP.
042100
042200     CALL "SPOHIST" USING BASE,
042300                          BASE-STHIST,
042400                          BUF-DPORECD,
042500                          PO-ARG.
042600
042700 613-USH-X.
042800     EXIT.
042900
043900*******************************************
044000*                                         *
044100*  THIS PROCEDURE CALLS 'SDELTPO' WHICH   *
044200*  DOES THE ACTUAL DELETION OF A PO FROM  *
044300*  THE STORES DATA BASE.  BY THE TIME     *
044400*  THIS SUBROUTINE IS CALLED THE PO HAS   *
044500*  ALREADY BEEN COPIED OVER TO THE        *
044600*  HISTORY DATA BASE 'STHIST'             *
044700*                                         *
044800*******************************************
044900
045000
045100 62-DELETE-PO.
045200     READ PO-DELETE-FILE
045300         AT END  GO TO 62-DP-X.
045400
045500     MOVE PO-DEL-NUM            TO  PO-ARG.
      *-------- SET SWITCH TO INDICATE ITEM GOING TO HISTORY.  SWITCH
      *-------- IS RESET IN SDELTPO.
           MOVE "H"                   TO  BASE (1:1).
045600     CALL "SDELTPO" USING BASE,
045700                          PO-ARG,
045800                          COMPANY-SAVE.
DCR01 *---------------------------------------------------------
DCR01 *****PERFORM Z100-PROCESS-PO-LOGGING  THRU Z100-EXIT.
DCR01      PERFORM Z110-RMV-USER-TRIGGER    THRU Z110-EXIT.
DCR01 *---------------------------------------------------------
046000     GO TO 62-DELETE-PO.
046100
046200 62-DP-X.
046300     EXIT.
DCR01
DCR01  COPY POLOGSUBR   IN COPYLIB.
