012600
012700 01  DSET-NAMES.
012800     05  DSET-NAME              PIC X(16)  VALUE SPACES.
012900     05  DSET-MPORCV            PIC X(16)  VALUE "MPORCV;".
013000     05  DSET-DPORECD           PIC X(16)  VALUE "DPORECD;".
013100     05  DSET-MPLTINFO          PIC X(16)  VALUE "MPLTINFO;".
013200
013300 COPY DATAB IN COPYLIB.
013400
013500 COPY DBSTHIST IN COPYLIB.
013600
013700 01 ITEMS-LISTING.
013800     05  ALL-ITEMS              PIC XX    VALUE "@;".
013900     05  PO-SEARCH              PIC X(10) VALUE "PO-RCV-NO;".
014000
014100 01 ARG-VALUES.
014200     05  PO-ARG                 PIC X(14) VALUE SPACES.
014300     05  PLT-ARG                PIC X(4)  VALUE SPACES.
014400
014800 01  DATES-AND-TIMES.
014900     05  TODAYS-DATE.
015000         10  YY               PIC 99.
015100         10  MM               PIC 99.
015200         10  DD               PIC 99.
015300
           05  DELETE-DATE-CN.
               10  DELETE-DATE-CC   PIC 99.
015400         10  DELETE-DATE.
015500             15  DELETE-DATE-YY   PIC 99.
015600             15  DELETE-DATE-MM   PIC 99.
015700             15  DELETE-DATE-DD   PIC 99.
015800
015900 COPY TDATECHK IN COPYLIB.
016000
       COPY CCRTFILE IN COPYLIB.

016100 COPY TBLOWUP IN COPYLIB.
