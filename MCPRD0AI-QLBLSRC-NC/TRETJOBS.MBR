000200 IDENTIFICATION DIVISION.
000300 PROGRAM-ID.  TRETSUBS.
001000******************************************************
001100*C  THIS PROGRAM ALLOWS THE USER TO RETRIEVE GENERIC *
001200*C  JOBPLAN INFORMATION FROM THE FILE MCFPMM3500 AND *
001300*C  MCFPMM3600 AND STORES IT IN A HOLDING AREA       *
001400*C  (JOB-FILE) FOR TRANSFER TO ANOTHER DATABASE ON   *
001500*C  THE SAME SYSTEM OR TO ANOTHER PLANT.             *
001600******************************************************
035700
000500 ENVIRONMENT DIVISION.
000600 CONFIGURATION SECTION.
000700 SOURCE-COMPUTER.     AS400.
000800 OBJECT-COMPUTER.     AS400.
       COPY SPECIALN OF COPYLIB.
001100 INPUT-OUTPUT SECTION.
001200 FILE-CONTROL.
           SELECT DISPLAY-FILE
               ASSIGN TO WORKSTATION-ZOFFLINE-SI
               ORGANIZATION IS TRANSACTION
               FILE STATUS IS DSPLY-STATUS
               CONTROL-AREA IS WS-CONTROL.
           SELECT JOBPLAN-BANK-FILE
               ASSIGN TO DATABASE-MCFLMM3601
               ORGANIZATION IS INDEXED
               ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                   WITH DUPLICATES
               FILE STATUS IS JB-STATUS.
001600     SELECT JOB-FILE
               ASSIGN TO DATABASE-MCFPJOBF
001700         ORGANIZATION IS SEQUENTIAL
               ACCESS MODE IS SEQUENTIAL
001800         FILE STATUS IS JF-STATUS.
           SELECT MASTER-JOBPLAN
               ASSIGN TO DATABASE-MCFLMM3501
               ORGANIZATION IS INDEXED
               ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
               FILE STATUS IS MJ-STATUS.
001200     SELECT OUT-FILE
               ASSIGN TO DATABASE-MCFPOUTF
               ORGANIZATION IS SEQUENTIAL
               ACCESS MODE IS SEQUENTIAL
               FILE STATUS IS OF-STATUS.
002000 DATA DIVISION.
002100 FILE SECTION.
       FD  DISPLAY-FILE
           LABEL RECORDS ARE OMITTED.
       01  DSPLY-REC                PIC X(2000).
       FD  JOBPLAN-BANK-FILE
           LABEL RECORDS ARE STANDARD
           DATA RECORD JBREC.
       01  JBREC.
           COPY DDS-ALL-FORMATS OF MCFLMM3601.
002600 FD  JOB-FILE
002700     RECORD CONTAINS 80 CHARACTERS
002800     DATA RECORD IS JOBF.
002900 01  JOBF                     PIC X(80).
       FD  MASTER-JOBPLAN
           LABEL RECORDS ARE STANDARD
           DATA RECORD IS MJREC.
       01  MJREC.
           COPY DDS-ALL-FORMATS OF MCFLMM3501.
001800 FD  OUT-FILE
001900     RECORD CONTAINS 10 CHARACTERS
002000     DATA RECORD IS OUTF.
002100 01  OUTF                     PIC X(10).
004100 WORKING-STORAGE SECTION.
       77  SUB1                     PIC 9.
       77  ENTRIES-WRITTEN          PIC 9(5).
       COPY CATREAD OF COPYLIB.
       COPY CPYIND  OF COPYLIB.
       COPY CCRTFILE OF COPYLIB.
005900 01  DBPARAMETERS.           COPY DBPARMS OF COPYLIB.
       01  DELETE-FILE              PIC X(10) VALUE "MCFPOUTF".
       01  ERROR-BUFFER             PIC X(80).
       01  FILE-STATUSES.
           05  DSPLY-STATUS         PIC XX.
           05  JB-STATUS            PIC XX.
           05  JF-STATUS            PIC XX.
           05  MJ-STATUS            PIC XX.
           05  OF-STATUS            PIC XX.
       COPY IOFEEDBACK OF COPYLIB.
       01  JOBPLAN-BANK-BUFFER.    COPY DJOBPLAN OF COPYLIB.
       01  JOBPLAN-BANK-KEY.
           05  JOBPLAN-BANK-NAME    PIC X(10).
           05  JOBPLAN-BANK-SEQ     PIC 9(4).
008800 01  LAST-WO-BUFF.           COPY MLASTWO  OF COPYLIB.
       01  MASTER-JOBPLAN-BUFFER.  COPY MMASTJOB OF COPYLIB.
009400 01  READ-JNAMES.
009500     05  READ-JNAM OCCURS 5 TIMES.
009600         10  READ-JNAME       PIC X(10).
           05  READ-CMD-LINE        PIC X(79).
           05  READ-ERR-LINE        PIC X(79).
009700 COPY DBSTAT    OF COPYLIB.
       01  TRUE-VAL                 PIC 1 VALUE B"1".
010700 COPY VCOMLINK  OF COPYLIB.
       COPY WSCONTROL OF COPYLIB.
010800 PROCEDURE DIVISION.
011000 BEGIN-PROC.
           PERFORM 1-HSK.
           PERFORM 6-MAIN THRU 6-MAIN-X
               UNTIL VIEW-LASTKEY = 3.
015300 2-EOJ.
015500     CLOSE DISPLAY-FILE.
015600     CLOSE OUT-FILE.
           CALL "MCDLT" USING DELETE-FILE.
015400     CLOSE JOB-FILE.
           CLOSE JOBPLAN-BANK-FILE.
           CLOSE MASTER-JOBPLAN.
           IF ENTRIES-WRITTEN > 0
               DISPLAY "ENTRIES WRITTEN TO JOBF = " ENTRIES-WRITTEN.
015800     GOBACK.
       1-HSK.
           MOVE "*CURLIB   "  TO CCRTFILE-LIBRARY.
           MOVE "MCFPOUTF  "  TO CCRTFILE-FILE.
           MOVE "0010"        TO CCRTFILE-RECORD-LENGTH.
           MOVE "00100"       TO CCRTFILE-NO-RECORDS.
           MOVE "00100"       TO CCRTFILE-INCREMENT-AMT.
           MOVE "01"          TO CCRTFILE-NO-INCREMENTS.
           CALL "CCRTFILE" USING CCRTFILE-LIBRARY
                                 CCRTFILE-FILE
                                 CCRTFILE-RECORD-LENGTH
                                 CCRTFILE-NO-RECORDS
                                 CCRTFILE-INCREMENT-AMT
                                 CCRTFILE-NO-INCREMENTS
                                 CCRTFILE-STATUS.
           MOVE "*CURLIB   "  TO CCRTFILE-LIBRARY.
           MOVE "MCFPJOBF"    TO CCRTFILE-FILE.
           MOVE "0080"        TO CCRTFILE-RECORD-LENGTH.
           MOVE "05000"       TO CCRTFILE-NO-RECORDS.
           MOVE "01000"       TO CCRTFILE-INCREMENT-AMT.
           MOVE "03"          TO CCRTFILE-NO-INCREMENTS.
           CALL "CCRTFILE" USING CCRTFILE-LIBRARY
                                 CCRTFILE-FILE
                                 CCRTFILE-RECORD-LENGTH
                                 CCRTFILE-NO-RECORDS
                                 CCRTFILE-INCREMENT-AMT
                                 CCRTFILE-NO-INCREMENTS
                                 CCRTFILE-STATUS.
011400     OPEN I-O    DISPLAY-FILE.
012700     OPEN OUTPUT OUT-FILE.
           OPEN INPUT  JOBPLAN-BANK-FILE.
           OPEN OUTPUT JOB-FILE.
           OPEN INPUT  MASTER-JOBPLAN.
           MOVE 0             TO ENTRIES-WRITTEN.
015900 6-MAIN.
013600     MOVE "FJBRETV1" TO VIEW-CFNAME.
           MOVE SPACES TO READ-JNAMES DSPLY-REC.
           PERFORM 99-SCREEN-WRITE.
           PERFORM 98-SCREEN-READ.
017100     IF VIEW-LASTKEY = 3
017200         MOVE "9999999999" TO OUTF
017300         WRITE OUTF
               CLOSE OUT-FILE
               OPEN INPUT OUT-FILE
017500         GO TO 6-READ-OUTF.
           MOVE DSPLY-REC TO READ-JNAMES.
018100     MOVE 0 TO SUB1.
018200 6-WRITE-OUTF-LOOP.
018300     ADD 1 TO SUB1.
018400     IF SUB1 > 5 GO TO 6-MAIN.
019700     IF READ-JNAME (SUB1) = "        " GO TO 6-WRITE-OUTF-LOOP.
020300     MOVE READ-JNAME (SUB1) TO OUTF.
020400     WRITE OUTF.
020800     GO TO 6-WRITE-OUTF-LOOP.

       6-READ-OUTF.
           READ OUT-FILE AT END GO TO 6-MAIN-X.
           IF OUTF = "9999999999" GO TO 6-MAIN-X.
           PERFORM 6-GET-MJOBPLAN-DATA THRU 6-GMD-X.
023500     MOVE 0 TO COND-WORD.
023600     MOVE OUTF TO JOBPLAN-BANK-NAME.
           MOVE 0 TO JOBPLAN-BANK-SEQ.
           MOVE JOBPLAN-BANK-KEY TO GJOBPSEQ OF JBREC.
           START JOBPLAN-BANK-FILE KEY > EXTERNALLY-DESCRIBED-KEY
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF JB-STATUS NOT = "00" MOVE 17 TO COND-WORD.
024000     IF COND-WORD = 17
024100         MOVE SPACES TO ERROR-BUFFER
024200         MOVE "START ERROR ON JOBPLAN-BANK " TO ERROR-BUFFER
024300         MOVE TRUE-VAL TO INDS (99)
               MOVE ERROR-BUFFER TO READ-ERR-LINE
029000         MOVE READ-JNAMES TO DSPLY-REC
024600         PERFORM 99-SCREEN-WRITE
025100         GO TO 2-EOJ
025200     ELSE
025300     PERFORM 6-GET-JOBPLAN-BANK-DATA THRU 6-GJBD-X
025400             UNTIL COND-WORD = 15.
           CLOSE JOBPLAN-BANK-FILE.
           OPEN INPUT JOBPLAN-BANK-FILE.
           GO TO 6-READ-OUTF.
031700 6-MAIN-X.    EXIT.
026200
       6-GET-MJOBPLAN-DATA.
           MOVE 0 TO COND-WORD.
           MOVE OUTF TO GJOBPNAME OF MJREC.
           READ MASTER-JOBPLAN INTO MASTER-JOBPLAN-BUFFER
               AT END GO TO 6-GMD-X.
           IF MJ-STATUS NOT = "00" GO TO 6-GMD-X.
           MOVE MASTER-JOBPLAN-BUFFER TO JOBF.
           WRITE JOBF.
           ADD 1 TO ENTRIES-WRITTEN.
       6-GMD-X.    EXIT.

026300 6-GET-JOBPLAN-BANK-DATA.
           MOVE 0 TO COND-WORD.
           READ JOBPLAN-BANK-FILE NEXT INTO JOBPLAN-BANK-BUFFER
               AT END    MOVE 15 TO COND-WORD.
           IF JOBPLAN-BANK-NAME NOT = JOBPLAN-WO-NO MOVE 15 TO COND-WORD.
           IF JB-STATUS NOT = "00" MOVE 15 TO COND-WORD.
026600     IF COND-WORD = 15 GO TO 6-GJBD-X.
031300     MOVE JOBPLAN-BANK-BUFFER TO JOBF.
031400     WRITE JOBF.
           ADD 1 TO ENTRIES-WRITTEN.
       6-GJBD-X.    EXIT.

       98-SCREEN-READ.
           READ DISPLAY-FILE FORMAT IS VIEW-CFNAME
               INDIC IS INDICS.
           ACCEPT IOFEEDBACK FROM I-O-FEEDBACK-AREA.
           MOVE ALL B"0" TO INDICS.
           IF DSPLY-STATUS NOT = "00"
               MOVE 3 TO VIEW-LASTKEY
           ELSE
           MOVE FUNCTION-NUM TO VIEW-LASTKEY.

       99-SCREEN-WRITE.
           WRITE DSPLY-REC FORMAT IS VIEW-CFNAME
               INDIC IS INDICS.
           MOVE ALL B"0" TO INDICS.

