       IDENTIFICATION DIVISION.
       PROGRAM-ID.     TQTGEN.
      *AUTHOR.         BARBARA WINTER.
      *INSTALLATION.   GOODYEAR TIRE & RUBBER COMPANY.
       DATE-WRITTEN.   SEPTEMBER 1987.
       DATE-COMPILED.
      *SECURITY.
      *REMARKS.
      ************************************************************
      *                 T Q T G E N                              *
      *       PRODUCES SYSTEM-GENERATED QUOTE FROM A DOCUMENT    *
      *                                                          *
      *  PRODUCES A QUOTE FROM AN OLD QUOTE, PO, OR REQUISITION  *
      *  NUMBER.  UP TO 5 VENDORS MAY BE SPECIFIED AND A QUOTE   *
      *  WILL BE CREATED FOR EACH VENDOR FROM THE OLD DOCUMENT.  *
      ************************************************************
      *C
      *C   MAR 20, 1995   WL MCINTYRE    REQ: 95-001
      *C   ADDED CODE TO OMIT ANY ITEMS WITH A STATUS OF "STOCK-OUT"
      *C   FROM APPEARING ON SYSTEM-GENERATED QUOTES.
      *C
      *C   AUG 29, 1995   WL MCINTYRE
      *C   ADDED A TABLE FOR COPRCODES AND CODED LOGIC TO PREVENT
      *C   DUPLICATE CORPORATE CODES FROM APPEARING ON SYS-GEN
      *C   QUOTES, CAUSED BY FILE-STRUCTURE OR DOCUMENT ENTRY.
      *C
      *C   AUG 13, 1996   WL MCINTYRE   REQUEST #96-009
      *C   ADDED LOGIC TO ALLOW USER TO REQUEST A SYSTEM-GENERATED
      *C   QUOTE BY COMBINATION OF MANUFACTURER AND KEYWORD MODIFIER.
      *C
      *C   AUG 16, 1996   WL MCINTYRE
      *C   MADE REVISIONS FOR END OF CENTURY COMPATABILITY.
      *C
      *C   SEP 19, 1996   WL MCINTYRE
      *C   ADD CODE TO MOVE BUYER CODE PASSED TO PROGRAM TO QUOTE
      *C   WHEN CREATING NEW QUOTE FROM EXISITING QUOTE.
      *C
      *C   30JUL1997  DAVE PLUM
      *C   ATTEMPTED TO IMPROVE THE BLOWUP INFORMATION THAT IS
      *C   PASSED TO TBLOWUP.
      *C
      *C  11/25/97    JEFF BUNGO   REQ #97-017
      *C     ADD USAGE FIELDS FOR DIRECT DELIVERY.  DD USAGE
      *C     TO BE STORED IN ADDITIONAL FIELD AND TOTAL USAGE.
      *C     STORE ISSUE USAGE CALCULATED BY TOTAL USAGE - DD USAGE.
      *C
      *C  04/22/03    CA YODER     UNC PROBLEM
      *C     INCREASED DUPLICATE CODE TABLE SIZE FROM 600 TO
      *C     1000 AFTER QUOTE IN UNION CITY CONTAINED > 900 ITEMS,
      *C     CAUSING A BLOWUP.
      *C
      *C  05/14/03    CA YODER     UNC PROBLEM
      *C     INCREASED DUPLICATE CODE TABLE SIZE FROM 1000 TO
      *C     3000 AFTER QUOTE IN UNION CITY CONTAINED > 2500 ITEMS,
      *C     CAUSING A BLOWUP.
      *C
       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.
       SOURCE-COMPUTER.    HP-3000.
       OBJECT-COMPUTER.    HP-3000.
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
            SELECT CODES-FILE      ASSIGN TO DISK-CODES.
            SELECT SORT-CODES-FILE ASSIGN TO DISK-SORTFILE.
            SELECT DVENDITM-O
              ASSIGN TO DATABASE-MCFLCS0803
              ORGANIZATION IS INDEXED
                 ACCESS MODE IS DYNAMIC
              RECORD KEY IS EXTERNALLY-DESCRIBED-KEY WITH DUPLICATES
              FILE STATUS IS FILE-STATUS.
            SELECT DVENDITM-I
              ASSIGN TO DATABASE-MCFLCS0803
              ORGANIZATION IS INDEXED
                 ACCESS MODE IS DYNAMIC
              RECORD KEY IS EXTERNALLY-DESCRIBED-KEY WITH DUPLICATES
              FILE STATUS IS FILE-STATUS.
            SELECT DQUOTEXT-O
              ASSIGN TO DATABASE-MCFLCS3801
              ORGANIZATION IS INDEXED
                 ACCESS MODE IS DYNAMIC
              RECORD KEY IS EXTERNALLY-DESCRIBED-KEY WITH DUPLICATES
              FILE STATUS IS FILE-STATUS.

            SELECT DQUOTEXT-I
              ASSIGN TO DATABASE-MCFLCS3801
              ORGANIZATION IS INDEXED
                 ACCESS MODE IS DYNAMIC
              RECORD KEY IS EXTERNALLY-DESCRIBED-KEY WITH DUPLICATES
              FILE STATUS IS FILE-STATUS.
            SELECT DPOITEM-I
              ASSIGN TO DATABASE-MCFLCS1002
              ORGANIZATION IS INDEXED
                 ACCESS MODE IS DYNAMIC
              RECORD KEY IS EXTERNALLY-DESCRIBED-KEY WITH DUPLICATES
              FILE STATUS IS FILE-STATUS.
            SELECT DREQITM-I
              ASSIGN TO DATABASE-MCFLCS2201
              ORGANIZATION IS INDEXED
                 ACCESS MODE IS DYNAMIC
              RECORD KEY IS EXTERNALLY-DESCRIBED-KEY WITH DUPLICATES
              FILE STATUS IS FILE-STATUS.
            SELECT DPODATAITM-I
              ASSIGN TO DATABASE-MCFLCS1101
              ORGANIZATION IS INDEXED
                 ACCESS MODE IS DYNAMIC
              RECORD KEY IS EXTERNALLY-DESCRIBED-KEY WITH DUPLICATES
              FILE STATUS IS FILE-STATUS.
            SELECT MREQ-O
              ASSIGN TO DATABASE-MCFLCS2001
              ORGANIZATION IS INDEXED
                 ACCESS MODE IS DYNAMIC
              RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
              FILE STATUS IS FILE-STATUS.
            SELECT MPLTINFO-I
              ASSIGN TO DATABASE-MCFLCS0501
              ORGANIZATION IS INDEXED
                 ACCESS MODE IS DYNAMIC
              RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
              FILE STATUS IS FILE-STATUS.
            SELECT USAGEFIL-I
              ASSIGN TO DATABASE-MCFLCSUSAG
              ORGANIZATION IS INDEXED
                 ACCESS MODE IS DYNAMIC
              RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
              FILE STATUS IS FILE-STATUS.
            SELECT DMANPART-I
              ASSIGN TO DATABASE-MCFLCS3601
              ORGANIZATION IS INDEXED
                 ACCESS MODE IS DYNAMIC
              RECORD KEY IS EXTERNALLY-DESCRIBED-KEY WITH DUPLICATES
              FILE STATUS IS FILE-STATUS.
            SELECT DCODE-I
              ASSIGN TO DATABASE-MCFLCS3401
              ORGANIZATION IS INDEXED
                 ACCESS MODE IS DYNAMIC
              RECORD KEY IS EXTERNALLY-DESCRIBED-KEY WITH DUPLICATES
              FILE STATUS IS FILE-STATUS.
            SELECT DCODE2-I
              ASSIGN TO DATABASE-MCFLCS3402
              ORGANIZATION IS INDEXED
                 ACCESS MODE IS DYNAMIC
              RECORD KEY IS EXTERNALLY-DESCRIBED-KEY WITH DUPLICATES
              FILE STATUS IS FILE-STATUS.

            SELECT MSTORERM-I
              ASSIGN TO DATABASE-MCFLCS0201
              ORGANIZATION IS INDEXED
                 ACCESS MODE IS DYNAMIC
              RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
              FILE STATUS IS FILE-STATUS.

       DATA DIVISION.
       FILE SECTION.
       FD  CODES-FILE
           RECORD CONTAINS 14 CHARACTERS.
       01  CODES-RECORD.
            05  CODE-NUMBER              PIC X(8).
            05  CODE-ITM                 PIC X(4).
            05  CODE-UM                  PIC X(2).

       SD  SORT-CODES-FILE
           RECORD CONTAINS 14 CHARACTERS.
       01  SORT-RECORD.
           05  SORT-NUMBER               PIC X(8).
           05  SORT-ITM                  PIC X(4).
           05  SORT-UM                   PIC X(2).

       FD  DVENDITM-O
           LABEL RECORDS ARE STANDARD.
       01  DVENDITM-REC-O.
           COPY DDS-MCRPCS0800  OF MCFLCS0803.
       FD  DVENDITM-I
           LABEL RECORDS ARE STANDARD.
       01  DVENDITM-REC-I.
           COPY DDS-MCRPCS0800  OF MCFLCS0803.
       FD  DQUOTEXT-O
           LABEL RECORDS ARE STANDARD.
       01  DQUOTEXT-REC-O.
           COPY DDS-MCRPCS3800  OF MCFLCS3801.

       FD  DQUOTEXT-I
           LABEL RECORDS ARE STANDARD.
       01  DQUOTEXT-REC-I.
           COPY DDS-MCRPCS3800  OF MCFLCS3801.
       FD  DPOITEM-I
           LABEL RECORDS ARE STANDARD.
       01  DPOITEM-REC-I.
           COPY DDS-MCRPCS1000  OF MCFLCS1002.
       FD  DREQITM-I
           LABEL RECORDS ARE STANDARD.
       01  DREQITM-REC-I.
           COPY DDS-MCRPCS2200  OF MCFLCS2201.

       FD  DPODATAITM-I
           LABEL RECORDS ARE STANDARD.
       01  DPODATAITM-REC-I.
           COPY DDS-MCRPCS1100  OF MCFLCS1101.
       FD  MREQ-O
           LABEL RECORDS ARE STANDARD.
       01  MREQ-REC-O.
           COPY DDS-MCRPCS2000  OF MCFLCS2001.
       FD  MPLTINFO-I
           LABEL RECORDS ARE STANDARD.
       01  MPLTINFO-REC-I.
           COPY DDS-MCRPCS0500  OF MCFLCS0501.
       FD  USAGEFIL-I
           LABEL RECORDS ARE STANDARD.
       01  USAGEFIL-REC-I.
           COPY DDS-MCRPCSUSAG  OF MCFLCSUSAG.
       FD  DMANPART-I.
       01  DMANPART-REC-I.
           COPY DDS-MCRPCS3600  OF MCFLCS3601.
       FD  DCODE-I.
       01  DCODE-REC-I.
           COPY DDS-MCRPCS3400  OF MCFLCS3401.
       FD  DCODE2-I.
       01  DCODE2-REC-I.
           COPY DDS-MCRPCS3400  OF MCFLCS3402.
       FD  MSTORERM-I
           LABEL RECORDS ARE STANDARD.
       01  MSTORERM-REC-I.
           COPY DDS-MCRPCS0200  OF MCFLCS0201.
       WORKING-STORAGE SECTION.
       01  FILE-STATUS.
           05  FILE-STATUS-1             PIC X.
           05  FILE-STATUS-2             PIC X.
       01  ERROR-CODE                    PIC -9999.
       01  PASS-SPOOL                    PIC S9(2) VALUE ZEROES COMP-4.
       01  SAVE-NONCODED-UM              PIC X(2)  VALUE SPACES.
       01  SAVE-NONCODED-ITM             PIC 9(4)  VALUE ZEROES.
       01  SAVE-PO-ITEM                  PIC 9(4)  VALUE ZEROES.
       01  LINE-WS                       PIC 9(4)  VALUE ZEROES.
       01  X                            PIC S9(2)  VALUE ZEROES COMP-4.
       01  SAVE-DVENDITM                 PIC X(254) VALUE SPACES.
       01  PASS-QUOTE-PRINTER            PIC S9(2) BINARY.
       01  HOLD-KEYWORD                  PIC X(20) VALUE SPACES.
       01  QUOTE-CREATED                 PIC X(01) VALUE " ".
       01  WS-RETURN-DATE.
           05  RETURN-CENT               PIC X(02) VALUE SPACES.
           05  RETURN-DATE               PIC X(06) VALUE SPACES.
       COPY PLANTS IN COPYLIB.
       COPY CCRTFILE IN COPYLIB.
      *----------  SUBSCRIPT INTO MONTHLY USAGE TOTALS IN KSAM RECORD
       01  SUB                           PIC 99      VALUE ZEROES.

      *----------  12 MONTH TOTAL USAGE AMOUNT
       01  YTD-TOTAL                     PIC S9(9)   VALUE ZEROES.
       COPY TSPLPRT IN COPYLIB.
      *------ TBLOWUP (PRINTS ERRORS TO AN ERROR FILE "BLOWUP.PUB" AND)
      *------ (ABORTS PROGRAM.  RUN XBLPRT.OBJECT TO READ ERRORS.)
       01  BU-DISPLAY-MSG                PIC X(60) VALUE SPACES.
       01  BU-PGM-NAME                   PIC X(8)  VALUE "TQTGEN".
       01  BU-DISPLAY-AREA               PIC X(110) VALUE ALL "0".
       01  BU-DISPLAY-FLDS REDEFINES BU-DISPLAY-AREA.
           05  BU-DISPLAY-LINE OCCURS 5 TIMES.
               10  BU-DISPLAY-FLD        PIC X(14).
               10  BU-DISPLAY-FLD9       PIC S9(8).

      *-----  TABLE TO STORE CORPCODES FOR SYSTEM-GENERATED QUOTES
       01  DUPLICATE-TABLE.
           05  DUPLICATE-ENTRY           OCCURS 3000 TIMES.
               10  DE-CORPCDE            PIC X(08)  VALUE SPACES.

       01  DUPCODE                       PIC X(08)  VALUE SPACES.
       01  DUPFOUND                      PIC X(01)  VALUE "N".
       01  TBL-OVRFLW                    PIC X(01)  VALUE "N".
       01  MAXTBLSIZE                    PIC 9999   VALUE 3000.
       01  TBLSIZE                       PIC 9999   VALUE 0.

      *-----  SUBSCRIPT FOR CORPCODE TABLE.
       01  DUPSUB                        PIC 9999   VALUE 0.

      **************************************************************
      **                   K S A M   W O R K                      **
      **************************************************************
       01  USAGE-REC.
           05  FILLER                    PIC XX.
           05  K-CORP-CODE               PIC X(8).
           05  K-MONTHS                 OCCURS 14 TIMES.
               10  K-MTH-USAGE           PIC S9(9) COMP-4.
           05  K-MONTHS-DD              OCCURS 14 TIMES.
               10  K-MTH-USAGE-DD        PIC S9(9) COMP-4.

      *************************************************************
      *                D A T A B A S E   V A R I A B L E S        *
      *************************************************************
       COPY DATAB IN COPYLIB.
       01  VENDOR-ARG                    PIC X(10)  VALUE SPACES.
       01  MPLTINFO-ARG                  PIC X(4)   VALUE SPACES.
       01  CODE-ARG                      PIC X(8)   VALUE SPACES.
       01  CODE-ARG2                     PIC X(8)   VALUE SPACES.
       01  REQ-ARG                       PIC X(12)  VALUE SPACES.
       01  QT-STD-ARG                    PIC X(10)  VALUE "STAND     ".
       01  KEYWORD-ARG.
           05  KA-KEYWORD                PIC X(20).
           05  KA-MODIFIER               PIC X(30).
       01  MANUFACT-ARG                  PIC X(26)  VALUE SPACES.
       01  PO-ARG.
           05  FILLER                    PIC X      VALUE "P".
           05  PO-ARG-NUM                PIC X(10)  VALUE SPACES.
           05  FILLER                    PIC X(3)   VALUE "000".
       01  QUOTE-ARG.
           05  QUOTE-ARG-NUM             PIC X(6)   VALUE SPACES.
           05  FILLER                    PIC X(4)   VALUE SPACES.
       01  PASS-QUOTE-PRT                PIC 9(2)  COMP-4.

       COPY MPLTINFO IN COPYLIB.
       COPY DPOITEM  IN COPYLIB.
       COPY DVENDITM IN COPYLIB.
       COPY DREQITM  IN COPYLIB.
       COPY DQUOTEXT IN COPYLIB.
       COPY DPODATA  IN COPYLIB.
       COPY MREQ     IN COPYLIB.
       COPY DMANPART IN COPYLIB.
       COPY DCODE    IN COPYLIB.
       COPY MSTORERM IN COPYLIB.
       COPY VCOMAREA IN COPYLIB.
      *----------  NATIVE LANGUAGE SUPPORT AREA
       COPY LANGUAGE IN COPYLIB.
       01  ACCEPT-DATA1.
           05  ACCEPT-BUYER              PIC X(4).
           05  ACCEPT-RETURN-DATE        PIC X(8)  VALUE SPACES.
           05  ACCEPT-PRINTER            PIC 9(2).
      *-----  "S"=STANDARD PARAGRAPH, " "=UNIQUE PARAGRAPH
           05  PARAGRAPH-TYPE            PIC X.
      *-----  PO NUMBER, QUOTE NUMBER, OR REQUISITION NUMBER
           05  ACCEPT-DOCUMENT           PIC X(12).
      *-----  "P"=PO, "Q"=QUOTE, "R"=REQUISITION, "S"=KEYWORD ONLY,
      *-----  "K"=KEYWORD, "M"=MANUFACTURER
      *-----  "X"=CROSS-REFERENCE (KEYWORD(MODIFIER) AND MANUFACTURER)
           05  ACCEPT-DOC-TYPE           PIC X.
               88  PO-DOCUMENT                VALUE "P".
               88  QUOTE-DOCUMENT             VALUE "Q".
               88  REQ-DOCUMENT               VALUE "R".
               88  KEYWORD-DOCUMENT           VALUE "K".
               88  KEYWORD-ONLY-DOCUMENT      VALUE "S".
               88  MANUF-DOCUMENT             VALUE "M".
               88  XREF-DOCUMENT              VALUE "X".
      *-----  "O" = OLD ORDER; "C" = SORT IN CODE ORDER
      *       NONCODED ITEMS ARE CHANGED TO "ZZZZZZZZ" TO
      *       PRINT AFTER CODED ITEMS
           05  ACCEPT-SORT               PIC X.
           05  ACCEPT-QUOTE-REF          PIC 9(4).
           05  FILLER                    PIC X(47).

       01  ACCEPT-DATA2.
           05  INFO-LINE-ACCEPT OCCURS 5 TIMES.
               07  VENDOR                PIC X(10).
               07  ACCEPT-QUOTE          PIC X(6).

       01  ACCEPT-DATA3.
           05  ACCEPT-KEYWORD.
               10  ACCEPT-KEYWORD-ONLY   PIC X(20).
               10  FILLER                PIC X(30).
           05  FILLER                    PIC X(30).

       01  ACCEPT-DATA4.
           05  ACCEPT-MANUFACTURER       PIC X(26).
           05  FILLER                    PIC X(54).

      **************************************************************
      *        P R O C E D U R E        D I V I S I O N            *
      **************************************************************
       PROCEDURE DIVISION.
       00-MAIN.
           PERFORM 010-OPEN-ALL THRU 019-EXIT.

           DISPLAY "ENTER DATA LINE 1, BUYER, RTRN DT, PARA TYPE, ETC".
           DISPLAY "BBBBDDDDDDDDPPTDDDDDDDDDDDDTSRRRR"
           ACCEPT ACCEPT-DATA1.
           DISPLAY ACCEPT-DATA1.
           DISPLAY "ENTER DATA LINE 2, VENDORS AND QUOTE NUMBERS".
           DISPLAY "VVVVVVVVVVQQQQQQVVVVVVVVVVQQQQQQVVVVVVVVVVQQQQQQ".
           ACCEPT ACCEPT-DATA2.
           DISPLAY ACCEPT-DATA2.
           DISPLAY "ENTER DATA LINE 3, KEYWORD".
           DISPLAY "KKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKK".
           ACCEPT ACCEPT-DATA3.
           DISPLAY ACCEPT-DATA3.
           DISPLAY "ENTER DATA LINE 4, MANUFACTURER".
           DISPLAY "MMMMMMMMMMMMMMMMMMMMMMMMMM".
           ACCEPT ACCEPT-DATA4.
           DISPLAY ACCEPT-DATA4.

      *----- INITIALIZE FLAG THAT WILL INDICATE IF QUOTE THAT HAS A
      *----- NUMBER ALLOCATED WAS NOT CREATED
           MOVE " " TO QUOTE-CREATED.

      *----- INITIALIZE DUPLICATE CORPCODE TABLE AND RELATED DATA ITEMS
           MOVE SPACES TO DUPLICATE-TABLE.
           MOVE SPACES TO DUPCODE.
           MOVE "N"    TO TBL-OVRFLW.
           MOVE "N"    TO DUPFOUND.
           MOVE 0      TO DUPSUB.
           MOVE 0      TO TBLSIZE.

           IF PO-DOCUMENT
              MOVE ACCEPT-DOCUMENT       TO  PO-ARG-NUM
              PERFORM 100-CREATE-QUOTE-FROM-PO THRU 199-EXIT
           ELSE
           IF QUOTE-DOCUMENT
              MOVE ACCEPT-DOCUMENT    TO  QUOTE-ARG
              PERFORM 200-CREATE-QUOTE-FROM-QT THRU 299-EXIT
           ELSE
           IF REQ-DOCUMENT
              MOVE ACCEPT-DOCUMENT TO  REQ-ARG
              PERFORM 300-CREATE-QUOTE-FROM-REQ THRU 399-EXIT
           ELSE
           IF KEYWORD-DOCUMENT
              MOVE ACCEPT-KEYWORD  TO  KEYWORD-ARG
              PERFORM 400-CRT-QUOTE-FROM-KWRD-MANF THRU 499-EXIT
           ELSE
           IF KEYWORD-ONLY-DOCUMENT
              MOVE ACCEPT-KEYWORD  TO  KEYWORD-ARG
              PERFORM 500-CRT-QT-FROM-KEYWORD-ONLY THRU 599-EXIT
           ELSE
           IF MANUF-DOCUMENT
              MOVE ACCEPT-MANUFACTURER TO  MANUFACT-ARG
              PERFORM 400-CRT-QUOTE-FROM-KWRD-MANF THRU 499-EXIT
           ELSE
              MOVE ACCEPT-KEYWORD      TO  KEYWORD-ARG
              MOVE ACCEPT-MANUFACTURER TO  MANUFACT-ARG
              PERFORM 700-CRT-QT-FROM-XREF THRU 700-EXIT.

      *---------  PRINT ALL NEW QUOTES
           MOVE 1                        TO  X.
        05-PRINT-QUOTES.
           MOVE ACCEPT-QUOTE (X)         TO  QUOTE-ARG-NUM.
           MOVE ACCEPT-PRINTER           TO  PASS-QUOTE-PRINTER.
           CALL "CQTPRT" USING QUOTE-ARG, PASS-QUOTE-PRINTER
                         LANGUAGE-PARMS, BASE, WHICH-PLANT.
           ADD 1                         TO  X.
           IF X > 5 OR ACCEPT-QUOTE (X) = SPACES
              NEXT SENTENCE
           ELSE
              GO TO 05-PRINT-QUOTES.

           PERFORM 020-CLOSE-ALL THRU 029-EXIT.

      *-----  CHECK FOR OVERFLOW OF DUPLICATE CORPCODE TABLE.  IF
      *-----  OVERFLOW, THEN BLOWUP PROGRAM TO SEND MSG TO AKRON TO
      *-----  NOTIFY CSIS/MMIS PROGRAMMING STAFF OF SITUATION.
           IF TBL-OVRFLW = "Y"
              MOVE "QUOTE CREATED, BUT DUP CORPCDE TBL OVERFLOW"
                TO BU-DISPLAY-MSG
              MOVE "MAX TABLE SIZE" TO BU-DISPLAY-FLD  (01)
              MOVE MAXTBLSIZE       TO BU-DISPLAY-FLD9 (01)
              PERFORM 990-BLOWUP THRU 999-EXIT
           END-IF.

           GOBACK.
      ****************************************************************
      *           OPEN ALL FILES AND PREPARE FOR PROCESSING          *
      ****************************************************************
       010-OPEN-ALL.

           OPEN I-O DVENDITM-O
                    MREQ-O DQUOTEXT-O.
           OPEN INPUT USAGEFIL-I MPLTINFO-I DREQITM-I DVENDITM-I
                      DPOITEM-I DPODATAITM-I DMANPART-I
                      DCODE-I DCODE2-I DQUOTEXT-I MSTORERM-I.

      *----------  CREATE TEMPORARY FILE FOR DESCRIPTION
           MOVE SPACES                   TO  CCRTFILE-PARMS.
           MOVE "QTEMP"                  TO  CCRTFILE-LIBRARY.
           MOVE "CODES"                  TO  CCRTFILE-FILE.
           MOVE 14                       TO  CCRTFILE-RECORD-LENGTH.
           MOVE 10000                    TO  CCRTFILE-NO-RECORDS.
           MOVE 1000                     TO  CCRTFILE-INCREMENT-AMT.
           MOVE 3                        TO  CCRTFILE-NO-INCREMENTS.
           CALL "CCRTFILE" USING CCRTFILE-LIBRARY,
                                 CCRTFILE-FILE
                                 CCRTFILE-RECORD-LENGTH
                                 CCRTFILE-NO-RECORDS
                                 CCRTFILE-INCREMENT-AMT
                                 CCRTFILE-NO-INCREMENTS
                                 CCRTFILE-STATUS.
           IF CCRTFILE-STATUS NOT = "00"
              MOVE "CCRTFILE CREATE OF CODES/TQTGEN FAILED"
                                         TO  BU-DISPLAY-MSG
                   PERFORM 990-BLOWUP THRU 999-EXIT.
      *----------  FIND THE PLANT NUMBER AND PASS IT TO SUBROUTINES
           MOVE "P 01"                   TO  MPLTINFO-ARG.
           MOVE 0                        TO  COND-WORD.
           MOVE MPLTINFO-ARG TO PLTINFOKEY OF MPLTINFO-REC-I.
           READ MPLTINFO-I INTO BUF-MPLTINFO
               INVALID KEY MOVE 17       TO  COND-WORD.
           IF FILE-STATUS-1 = "2"
               MOVE 17                   TO  COND-WORD
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE 99                   TO  COND-WORD.
           IF COND-WORD NOT = 0
                 MOVE "DBGET MPLTINFO - TQTGEN   " TO BU-DISPLAY-MSG
                 PERFORM 990-BLOWUP THRU 999-EXIT.
           MOVE MPLTINFO-COMPANY         TO  WHICH-PLANT.
       019-EXIT.  EXIT.

      ****************************************************************
      *                    CLOSE ALL FILES                           *
      ****************************************************************
       020-CLOSE-ALL.
           CLOSE    MPLTINFO-I DPOITEM-I DVENDITM-O DREQITM-I
                    DVENDITM-I DMANPART-I DCODE-I DQUOTEXT-I
                    MREQ-O DQUOTEXT-O DPODATAITM-I USAGEFIL-I
                    MSTORERM-I DCODE2-I.
       029-EXIT.  EXIT.
      *************************************************************
      *     GET EACH ITEM ASSOCIATED WITH THE PO NUMBER AND SORT  *
      *     IN CORPORATE CODE ORDER OR LEAVE IN OLD ORDER.        *
      *************************************************************
       100-CREATE-QUOTE-FROM-PO.
           OPEN OUTPUT CODES-FILE.
           MOVE 0                        TO  COND-WORD.
           MOVE PO-ARG                   TO  PORCVNO OF DPOITEM-REC-I.
           START DPOITEM-I KEY = PORCVNO OF DPOITEM-REC-I
               INVALID KEY MOVE 17       TO  COND-WORD.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
                   MOVE 17               TO  COND-WORD
               ELSE
                   MOVE 99               TO  COND-WORD.
           IF NOT GOOD-CALL
              MOVE "DBGET DPOITEM FAILED AT 220 IN TBKQUOTE" TO
                           BU-DISPLAY-MSG
              MOVE PO-ARG                TO  BU-DISPLAY-FLD (1)
              PERFORM 990-BLOWUP THRU 999-EXIT.

       105-ITEM-LOOP.
           MOVE 0                        TO  COND-WORD.
           READ DPOITEM-I NEXT INTO BUF-DPOITEM
               AT END MOVE 15            TO  COND-WORD.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   MOVE 15               TO  COND-WORD
               ELSE
                   MOVE 99               TO  COND-WORD.
           IF PORCVNO OF DPOITEM-REC-I NOT = PO-ARG
               MOVE 15                   TO  COND-WORD.
           IF NOT GOOD-CALL
              IF END-OF-CHAIN
                 IF ACCEPT-SORT = "O"
                    GO TO 199-EXIT
                 ELSE
                    GO TO 120-SORT-CODES
              ELSE
                 MOVE "DBGET FAILED FOR DPOITEM AT 220 IN TBKQUOTE"
                                         TO  BU-DISPLAY-MSG
                 MOVE PO-ARG             TO  BU-DISPLAY-FLD (1)
                 PERFORM 990-BLOWUP THRU 999-EXIT.

      *-----  CHECK CODE TO SEE IF NON-CODED ITEM.  IF SO THEN SKIP
      *-----  REMAINDER OF CORPCODE CHECKS
           IF ITM-CORP-CODE = "NON-STR"
              GO TO 105-CONT-ITEM-LOOP.
      *----- CHECK TO SEE IF ITEM IS CORPORATE CODED AND IF SO, THEN
      *----- CHECK FOR 'STOCK-OUT' STATUS
           MOVE ITM-CORP-CODE            TO  CODE-ARG2.
           MOVE 0                        TO  COND-WORD.
           MOVE CODE-ARG2                TO  CORPCDE OF MSTORERM-REC-I.
           READ  MSTORERM-I INTO BUF-MSTORERM
             INVALID KEY
                  MOVE FILE-STATUS       TO  FILE-STATUS.
           IF FILE-STATUS NOT = "00"
              MOVE 99                    TO  COND-WORD.
      *-----  CHECK RESULT OF READ.  IF COULD NOT GET THE CORPCODE
      *-----  RECORD, DISPLAY MESSAGE AND END PROGRAM
           IF NOT GOOD-CALL
              MOVE "DBGET MSTORERM FAILED AT 105 IN TQTGEN"
                TO BU-DISPLAY-MSG
              MOVE CODE-ARG2 TO BU-DISPLAY-FLD (1)
              PERFORM 990-BLOWUP THRU 999-EXIT.
      *-----  CHECK CODE TO SEE IF ITEM IS IN "STOCK-OUT" STATUS
      *-----  IF SO, THEN DISPLAY MESSAGE, SKIP THIS ITEM AND
      *-----  READ FOR NEXT ITEM
           IF STR-STOCK-OT = "X"
              DISPLAY "***********************************************"
              DISPLAY "**  PURCHASE ORDER ITEM IN STOCK-OUT STATUS"
              DISPLAY "**  CORPCODE  : " CODE-ARG2
              DISPLAY "**  PO #      : " PO-ARG
              DISPLAY "***********************************************"
              GO TO 105-ITEM-LOOP.

      *-----  LOGIC TO CHECK FOR DUPLICATE CORPCODES ON NEW QUOTE
           MOVE ITM-CORP-CODE            TO  DUPCODE.
           PERFORM 600-DUP-CORPCODE-LOGIC THRU 600-EXIT.
           IF DUPFOUND = "Y"
              GO TO 105-ITEM-LOOP.

       105-CONT-ITEM-LOOP.
           MOVE SPACES                   TO  CODES-RECORD.
           MOVE ITM-CORP-CODE            TO  CODE-ARG.
           IF ACCEPT-SORT = "O"
              MOVE ITM-NUMBER            TO  SAVE-PO-ITEM
              IF KELLY-PLANT
                 MOVE ITM-KELLY-PO-UM    TO  SAVE-NONCODED-UM
                 GO TO 130-COMPUTE-USAGE
              ELSE
                 MOVE ITM-UM             TO  SAVE-NONCODED-UM
                 GO TO 130-COMPUTE-USAGE.
           MOVE  ITM-CORP-CODE           TO  CODE-NUMBER.
           IF ITM-CORP-CODE = "NON-STR"
              MOVE "ZZZZZZZZ"            TO  CODE-NUMBER
              MOVE ITM-NUMBER            TO  CODE-ITM
              IF KELLY-PLANT
                 MOVE ITM-KELLY-PO-UM    TO  CODE-UM
              ELSE
                 MOVE ITM-UM             TO  CODE-UM.

           WRITE CODES-RECORD.
           GO TO 105-ITEM-LOOP.

       120-SORT-CODES.
           CLOSE   CODES-FILE.
           SORT    SORT-CODES-FILE       ASCENDING KEY SORT-NUMBER
                   USING CODES-FILE
                   GIVING CODES-FILE.
           OPEN    INPUT CODES-FILE.

       125-READ-CODES-LOOP.
           READ CODES-FILE
                AT END  CLOSE CODES-FILE
                        GO TO 199-EXIT.
           IF CODE-NUMBER = "ZZZZZZZZ"
              MOVE "NON-STR "            TO  CODE-NUMBER
              MOVE CODE-UM               TO  SAVE-NONCODED-UM
              MOVE CODE-ITM              TO  SAVE-NONCODED-ITM,
                                 SAVE-PO-ITEM.

           MOVE CODE-NUMBER              TO  CODE-ARG.

      *************************************************************
      *         READ THE USAGE FILE AND ADD UP THE LAST 12        *
      *         MONTHS OF USAGE TO GET AN ANNUAL FIGURE.          *
      *************************************************************
       130-COMPUTE-USAGE.
           MOVE 0                        TO  COND-WORD.
           MOVE CODE-ARG                 TO  CORPCDE OF USAGEFIL-REC-I.
           READ USAGEFIL-I INTO USAGE-REC
               INVALID KEY MOVE 17       TO  COND-WORD.
           IF FILE-STATUS-1 = "2"
               MOVE 17                   TO  COND-WORD
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE 99                   TO  COND-WORD.
           IF COND-WORD NOT =  0
              MOVE "USAGEFILE ERR 130 TQTGEN  " TO BU-DISPLAY-MSG
              MOVE CODE-ARG              TO  BU-DISPLAY-FLD (5)
              PERFORM 990-BLOWUP THRU 999-EXIT.

           MOVE 0                        TO  YTD-TOTAL.
           MOVE 0                        TO  SUB.

       135-CALCULATE-YTD-USAGE.
           ADD 1                         TO  SUB.
           IF SUB NOT > 12
              ADD K-MTH-USAGE (SUB)      TO  YTD-TOTAL
              GO TO 135-CALCULATE-YTD-USAGE.
           MOVE 1                        TO  X.

       150-FILL-IN-QUOTE-DATA.
           MOVE SPACES                   TO  BUF-DVENDITM.
           PERFORM 180-CLEAR-DVENDITM.
           PERFORM 185-CLEAR-LEAD-TIMES.
           MOVE CODE-ARG                 TO  VEN-ITM-CORPCODE.
           MOVE VENDOR (X)               TO  VEN-ITM-VENCODE.
           MOVE YTD-TOTAL                TO  VEN-BID-QTY.
           MOVE PARAGRAPH-TYPE           TO  VEN-TEXT-FLAG.
           MOVE ACCEPT-QUOTE (X)         TO  VEN-REAL-QUOTE.
           MOVE SPACES                   TO  VEN-CREATE-DATE-CN.
           MOVE "Q"                      TO  VEN-QUOTE-FLAG.
           MOVE ACCEPT-BUYER             TO  VEN-BUYER-CODE.
           IF ACCEPT-QUOTE-REF NOT = "0000"
              MOVE ACCEPT-QUOTE-REF      TO  VEN-REF.

           MOVE ACCEPT-RETURN-DATE       TO  VEN-RETURN-DATE-CN.
           IF CODE-ARG = "NON-STR"
              MOVE SAVE-NONCODED-UM      TO  VEN-NONCODED-UM
              IF ACCEPT-SORT = "O"
                 ADD 1                   TO  SAVE-NONCODED-ITM
                 MOVE SAVE-NONCODED-ITM  TO  VEN-NONCODED-ITEM
              ELSE
                 MOVE SAVE-NONCODED-ITM  TO  VEN-NONCODED-ITEM
           ELSE
              MOVE ZEROES                TO  VEN-NONCODED-ITEM.

           MOVE 0                        TO  COND-WORD.
           WRITE DVENDITM-REC-O FROM BUF-DVENDITM
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE 99                   TO  COND-WORD.
           IF NOT GOOD-CALL
              MOVE "DBPUT FAILED AT 150 IN TQTGEN" TO BU-DISPLAY-MSG
              PERFORM 990-BLOWUP THRU 999-EXIT.

      *----------  ADD NONCODED DESCRIPTION
           IF CODE-ARG NOT = "NON-STR"
              GO TO 170-CHECK-MORE-VENDORS.

           MOVE 1                        TO  LINE-WS.
           MOVE 0                        TO  COND-WORD.
           MOVE PO-ARG TO PORCVNO OF DPODATAITM-REC-I.
           START DPODATAITM-I KEY = PORCVNO OF DPODATAITM-REC-I
               INVALID KEY MOVE 17       TO  COND-WORD.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
                   MOVE 17               TO  COND-WORD
               ELSE
                   MOVE 99               TO  COND-WORD.
           IF NOT GOOD-CALL
              MOVE "DBFIND DPODATAITM 150 TQTGEN" TO BU-DISPLAY-MSG
              MOVE PO-ARG                TO  BU-DISPLAY-FLD (1)
              PERFORM 990-BLOWUP THRU 999-EXIT.
           IF NO-ENTRY
              GO TO 170-CHECK-MORE-VENDORS.

       155-GET-NONCODED-DESC.
           MOVE 0                        TO  COND-WORD.
           READ DPODATAITM-I NEXT INTO BUF-DPODATAITM
               AT END MOVE 15            TO  COND-WORD.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   MOVE 15               TO  COND-WORD
               ELSE
                   MOVE 99               TO  COND-WORD.
           IF PORCVNO OF DPODATAITM-REC-I NOT = PO-ARG
               MOVE 15                   TO  COND-WORD.
           IF END-OF-CHAIN
              GO TO 170-CHECK-MORE-VENDORS.
           IF NOT GOOD-CALL
              MOVE "DBGET DPODATAITM 155 TQTGEN" TO BU-DISPLAY-MSG
              MOVE PO-ARG                        TO BU-DISPLAY-FLD (1)
              PERFORM 990-BLOWUP THRU 999-EXIT.

           IF DATAITM-ITEM-NO NOT = SAVE-PO-ITEM
              GO TO 155-GET-NONCODED-DESC.

           MOVE SPACES                   TO  BUF-DQUOTEXT.
           MOVE DATAITM-INFO             TO  DQUOTEXT-DATA.
           MOVE ACCEPT-QUOTE (X)         TO  DQUOTEXT-QUOTE-NO.
           MOVE LINE-WS                  TO  DQUOTEXT-LINE-NO.
           MOVE SAVE-NONCODED-ITM        TO  DQUOTEXT-ITM-NO.

           MOVE 0                        TO  COND-WORD.
           WRITE DQUOTEXT-REC-O FROM BUF-DQUOTEXT
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE 99                   TO  COND-WORD.
           IF NOT GOOD-CALL
              MOVE "DBPUT DQUOTEXT 155 TQTGEN" TO BU-DISPLAY-MSG
              PERFORM 990-BLOWUP THRU 999-EXIT.

           ADD 1                         TO  LINE-WS.
           GO TO 155-GET-NONCODED-DESC.

       170-CHECK-MORE-VENDORS.
      *----------  PUT DVENDITM ENTRY FOR EACH QUOTE THAT WAS PASSED
           ADD 1                         TO  X.
           IF X > 5 OR ACCEPT-QUOTE (X) = SPACES
              NEXT SENTENCE
           ELSE
              GO TO 150-FILL-IN-QUOTE-DATA.
       179-EXIT.  EXIT.

       180-CONTINUE.
           IF ACCEPT-SORT = "O"
              GO TO 105-ITEM-LOOP
           ELSE
              GO TO 125-READ-CODES-LOOP.

       180-CLEAR-DVENDITM.
              MOVE SPACES                TO  VEN-REQ VEN-SPLC
                              VEN-ACTUAL-DATE-RETURNED-CN
                              VEN-CREATE-DATE-CN VEN-TEMP-QUOTE
                              VEN-QTY-UM (1) VEN-QTY-UM (2)
                              VEN-QTY-UM (3) VEN-FOB VEN-TERMS
                              VEN-DISCOUNT VEN-ITM-PRICE-UM
                              VEN-REF
              MOVE ZEROES TO  VEN-ITM-PRICE VEN-LOW-QTY (1)
                              VEN-LOW-QTY (2) VEN-LOW-QTY (3)
                              VEN-HIGH-QTY (1) VEN-HIGH-QTY (2)
                              VEN-HIGH-QTY (3) VEN-WORK-PRICE (1)
                              VEN-WORK-PRICE (2) VEN-WORK-PRICE (3),
                              VEN-ITM-YTD-BUS
                              VEN-SURCHARGE, VEN-DISCOUNT-PERCENT.
       185-CLEAR-LEAD-TIMES.
           MOVE ZEROES     TO VEN-ITM-LT1, VEN-ITM-LT2, VEN-ITM-LT3,
                              VEN-EST-LT.

       199-EXIT.  EXIT.
       200-CREATE-QUOTE-FROM-QT.
           MOVE ACCEPT-DOCUMENT          TO  QUOTE-ARG.
           MOVE 0                        TO  COND-WORD.
           MOVE QUOTE-ARG TO QUOTENUM OF DVENDITM-REC-I.
           START DVENDITM-I KEY = QUOTENUM OF DVENDITM-REC-I
               INVALID KEY MOVE 17       TO  COND-WORD.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
                   MOVE 17               TO  COND-WORD
               ELSE
                   MOVE 99               TO  COND-WORD.
           IF NO-ENTRY
                GO TO 299-EXIT.
           IF NOT GOOD-CALL
              MOVE "DBFIND DVENDITM 200 TQTGEN" TO BU-DISPLAY-MSG
              PERFORM 990-BLOWUP THRU 999-EXIT.

       210-READ-ALL-ITEMS.
           MOVE 0                        TO  COND-WORD.
           READ DVENDITM-I NEXT INTO BUF-DVENDITM
               AT END MOVE 15            TO  COND-WORD.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   MOVE 15               TO  COND-WORD
               ELSE
                   MOVE 99               TO  COND-WORD.
           IF QUOTENUM OF DVENDITM-REC-I NOT = QUOTE-ARG
               MOVE 15                   TO  COND-WORD.
           IF END-OF-CHAIN
      *-----  ONLY WANT TO UPDATE NONCODED-DESC IF AT LEAST ONE ITEM
      *-----  WAS WRITTEN TO NEW QUOTE NUMBER
              IF QUOTE-CREATED = "Y"
                 PERFORM 800-GET-NONCODED-DESC THRU 809-EXIT
                 GO TO 299-EXIT
              ELSE
                 GO TO 299-EXIT.
           IF NOT GOOD-CALL
              MOVE "DBGET DVENDITM 210 TQTGEN" TO BU-DISPLAY-MSG
              PERFORM 990-BLOWUP THRU 999-EXIT.

      *-----  CHECK CODE TO SEE IF NON-CODED ITEM.  IF SO THEN SKIP
      *-----  REMAINDER OF CORPCODE CHECKS
           IF VEN-ITM-CORPCODE = "NON-STR"
              GO TO 210-CONT-READ-ALL-ITEM.
      *----- CHECK TO SEE IF ITEM IS CORPORATE CODED AND IF SO, THEN
      *----- CHECK FOR 'STOCK-OUT' STATUS
           MOVE VEN-ITM-CORPCODE         TO  CODE-ARG2.
           MOVE 0                        TO  COND-WORD.
           MOVE CODE-ARG2                TO  CORPCDE OF MSTORERM-REC-I.
           READ MSTORERM-I INTO BUF-MSTORERM
             INVALID KEY
                    MOVE FILE-STATUS     TO  FILE-STATUS.
           IF FILE-STATUS NOT = "00"
              MOVE 99                 TO  COND-WORD.
      *-----  CHECK RESULT OF READ.  IF COULD NOT GET THE CORPCODE
      *-----  RECORD, DISPLAY MESSAGE AND END PROGRAM
           IF NOT GOOD-CALL
              MOVE "DBGET MSTORERM FAILED AT 210 IN TQTGEN"
                TO BU-DISPLAY-MSG
              MOVE CODE-ARG2 TO BU-DISPLAY-FLD (1)
              PERFORM 990-BLOWUP THRU 999-EXIT.
      *-----  CHECK CODE TO SEE IF ITEM IS IN "STOCK-OUT" STATUS
      *-----  IF SO, THEN DISPLAY MESSAGE, SKIP THIS ITEM AND
      *-----  READ FOR NEXT ITEM
           IF STR-STOCK-OT = "X"
              DISPLAY "***********************************************"
              DISPLAY "**  QUOTE ITEM IS IN STOCK-OUT STATUS"
              DISPLAY "**  CORPCODE  : " CODE-ARG2
              DISPLAY "**  QUOTE #   : " QUOTE-ARG
              DISPLAY "***********************************************"
              GO TO 210-READ-ALL-ITEMS.

      *-----  LOGIC TO CHECK FOR DUPLICATE CORPCODES ON NEW QUOTE
           MOVE VEN-ITM-CORPCODE         TO  DUPCODE.
           PERFORM 600-DUP-CORPCODE-LOGIC THRU 600-EXIT.
           IF DUPFOUND = "Y"
              GO TO 210-READ-ALL-ITEMS.

       210-CONT-READ-ALL-ITEM.
           MOVE 1                        TO  X.

       215-LOOP-FOR-VENDORS.
           MOVE ACCEPT-QUOTE (X)         TO  VEN-REAL-QUOTE.
           MOVE VENDOR (X)               TO  VEN-ITM-VENCODE.
           MOVE ACCEPT-BUYER             TO  VEN-BUYER-CODE.
           MOVE PARAGRAPH-TYPE           TO  VEN-TEXT-FLAG.
           IF ACCEPT-QUOTE-REF NOT = "0000"
              MOVE ACCEPT-QUOTE-REF      TO  VEN-REF.
           MOVE ACCEPT-RETURN-DATE       TO  VEN-RETURN-DATE-CN.

           MOVE 0                        TO  COND-WORD.
           WRITE DVENDITM-REC-O FROM BUF-DVENDITM
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE 99                   TO  COND-WORD.
           IF NOT GOOD-CALL
              MOVE "DBPUT 215 DVENDITM TQTGEN" TO BU-DISPLAY-MSG
              PERFORM 990-BLOWUP THRU 999-EXIT.
           MOVE "Y" TO QUOTE-CREATED.

           ADD 1                         TO  X.
           IF X > 5 OR ACCEPT-QUOTE (X) = SPACES
              NEXT SENTENCE
           ELSE
              GO TO 215-LOOP-FOR-VENDORS.

           GO TO 210-READ-ALL-ITEMS.
       299-EXIT.  EXIT.
       300-CREATE-QUOTE-FROM-REQ.
           MOVE ACCEPT-DOCUMENT          TO  REQ-ARG.
           MOVE 0                        TO  COND-WORD.
           MOVE REQ-ARG                  TO  REQNO OF DREQITM-REC-I.
           START DREQITM-I KEY = REQNO OF DREQITM-REC-I
               INVALID KEY MOVE 17       TO  COND-WORD.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
                   MOVE 17               TO  COND-WORD
               ELSE
                   MOVE 99               TO  COND-WORD.
           IF NO-ENTRY
              MOVE "REQ NOT FOUND IN DREQITM" TO BU-DISPLAY-MSG
              MOVE REQ-ARG                    TO BU-DISPLAY-FLD (1)
              PERFORM 990-BLOWUP THRU 999-EXIT
           ELSE
              IF NOT GOOD-CALL
                 MOVE "DBFIND DREQITM 300 TQTGEN" TO BU-DISPLAY-MSG
                 MOVE REQ-ARG                     TO BU-DISPLAY-FLD (1)
                 PERFORM 990-BLOWUP THRU 999-EXIT.

           MOVE 0                        TO  COND-WORD.
           READ DREQITM-I NEXT INTO BUF-DREQITM
               AT END MOVE 15            TO  COND-WORD.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   MOVE 15               TO  COND-WORD
               ELSE
                   MOVE 99               TO  COND-WORD.
           IF REQNO OF DREQITM-REC-I NOT = REQ-ARG
               MOVE 15                   TO  COND-WORD.
           IF NOT GOOD-CALL
              MOVE "DBGET DREQITM 300 TQTGEN" TO BU-DISPLAY-MSG
              MOVE REQ-ARG                     TO BU-DISPLAY-FLD (1)
              PERFORM 990-BLOWUP THRU 999-EXIT.

      *-----  CHECK CODE TO SEE IF NON-CODED ITEM.  IF SO THEN SKIP
      *-----  REMAINDER OF CORPCODE CHECKS
           IF REQITM-CORP-CODE = "NON-STR"
              GO TO 300-CONT-CREATE-QUOTE.
      *----- CHECK TO SEE IF ITEM IS CORPORATE CODED AND IF SO, THEN
      *----- CHECK FOR 'STOCK-OUT' STATUS
           MOVE REQITM-CORP-CODE         TO  CODE-ARG2.
           MOVE 0                        TO  COND-WORD.
           MOVE CODE-ARG2                TO  CORPCDE OF MSTORERM-REC-I.
           READ  MSTORERM-I INTO BUF-MSTORERM
             INVALID KEY
                    MOVE FILE-STATUS     TO  FILE-STATUS.
           IF FILE-STATUS NOT = "00"
              MOVE 99                    TO  COND-WORD.
      *-----  CHECK RESULT OF READ.  IF COULD NOT GET THE CORPCODE
      *-----  RECORD, DISPLAY MESSAGE AND END PROGRAM
           IF NOT GOOD-CALL
              MOVE "DBGET MSTORERM FAILED AT 300 IN TQTGEN"
                TO BU-DISPLAY-MSG
              MOVE CODE-ARG2 TO BU-DISPLAY-FLD (1)
              PERFORM 990-BLOWUP THRU 999-EXIT.
      *-----  CHECK CODE TO SEE IF ITEM IS IN "STOCK-OUT" STATUS
      *-----  IF SO, THEN DISPLAY MESSAGE STATING ITEM IN "STOCK-OUT"
      *-----  STATUS AND LEAVE SECTION FOR REQS
           IF STR-STOCK-OT = "X"
              DISPLAY "***********************************************"
              DISPLAY "**  REQUISITION ITEM IS IN STOCK-OUT STATUS"
              DISPLAY "**  CORPCODE  : " CODE-ARG2
              DISPLAY "**  REQ #     : " REQ-ARG
              DISPLAY "***********************************************"
              GO TO 399-EXIT.

       300-CONT-CREATE-QUOTE.
      *---------  UPDATE MREQ WITH THE QUOTE NUMBER AND STATUS
           MOVE 0                        TO  COND-WORD.
           MOVE REQ-ARG                  TO  REQNO OF MREQ-REC-O.
           READ MREQ-O INTO BUF-MREQ
               INVALID KEY MOVE 17       TO  COND-WORD.
           IF FILE-STATUS-1 = "2"
               MOVE 17                   TO  COND-WORD
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE 99                   TO  COND-WORD.
           IF NO-ENTRY
              GO TO 399-EXIT.
           IF NOT GOOD-CALL
              MOVE "DBGET MREQ AT 300 TQTGEN" TO BU-DISPLAY-MSG
              MOVE REQ-ARG                    TO BU-DISPLAY-FLD (1)
              PERFORM 990-BLOWUP THRU 999-EXIT.

           MOVE "QU"                     TO  REQ-HOLD-STATUS-CODE.
           MOVE ACCEPT-QUOTE (1)         TO  REQ-HOLD-STATUS.
           MOVE 0                        TO  COND-WORD.
           REWRITE MREQ-REC-O FROM BUF-MREQ
               INVALID KEY MOVE 99       TO  COND-WORD.
           IF FILE-STATUS NOT = "00"
               MOVE 99                   TO  COND-WORD.
           IF NOT GOOD-CALL
              MOVE "DBUPDATE MREQ 300 TQTGEN" TO BU-DISPLAY-MSG
              MOVE REQ-ARG                    TO BU-DISPLAY-FLD (1)
              PERFORM 990-BLOWUP THRU 999-EXIT.

           MOVE 1                        TO  X.

       305-LOOP-FOR-VENDORS.
      *----------  CREATE DVENDITM

           MOVE SPACES                   TO  BUF-DVENDITM.
           MOVE VENDOR (X)               TO  VEN-ITM-VENCODE.
           MOVE PARAGRAPH-TYPE           TO  VEN-TEXT-FLAG.
           MOVE REQITM-CORP-CODE         TO  VEN-ITM-CORPCODE.
           MOVE ACCEPT-DOCUMENT          TO  VEN-REQ.
           MOVE "Q"                      TO  VEN-QUOTE-FLAG.
           MOVE ACCEPT-RETURN-DATE       TO  VEN-RETURN-DATE-CN.
           MOVE ACCEPT-BUYER             TO  VEN-BUYER-CODE.
           IF ACCEPT-QUOTE-REF NOT = "0000"
              MOVE ACCEPT-QUOTE-REF      TO  VEN-REF.
           MOVE ZEROES                   TO  VEN-ITM-PRICE,
                                                   VEN-EST-LT
                                                   VEN-ITM-LT1
                                                   VEN-ITM-LT2
                                                   VEN-ITM-LT3
                                                   VEN-LOW-QTY (1)
                                                   VEN-LOW-QTY (2)
                                                   VEN-LOW-QTY (3)
                                                   VEN-HIGH-QTY (1)
                                                   VEN-HIGH-QTY (2)
                                                   VEN-HIGH-QTY (3)
                                                   VEN-WORK-PRICE (1)
                                                   VEN-WORK-PRICE (2)
                                                   VEN-WORK-PRICE (3)
                                                   VEN-SURCHARGE
                                                   VEN-DISCOUNT-PERCENT
                                                   VEN-BID-QTY.
           IF REQITM-CORP-CODE = "NON-STR"
              MOVE 1                     TO  VEN-NONCODED-ITEM
              MOVE REQITM-UM             TO  VEN-NONCODED-UM
           ELSE
              MOVE 0                     TO  VEN-NONCODED-ITEM.
           MOVE ACCEPT-QUOTE (X)         TO  VEN-QUOTE-NUM.
           MOVE REQITM-QTY-TO-ORD        TO  VEN-BID-QTY.
           MOVE REQITM-CORP-CODE         TO  VEN-ITM-CORPCODE.
           MOVE 0                        TO  COND-WORD.
           WRITE DVENDITM-REC-O FROM BUF-DVENDITM
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE 99                   TO  COND-WORD.
           IF NOT GOOD-CALL
              MOVE "DBPUT DVENDITM 510 TQTGEN" TO BU-DISPLAY-MSG
              PERFORM 990-BLOWUP THRU 999-EXIT.

           ADD 1                         TO  X.
           IF X > 5 OR ACCEPT-QUOTE (X) = SPACES
              NEXT SENTENCE
           ELSE
              GO TO 305-LOOP-FOR-VENDORS.

       399-EXIT.  EXIT.
       400-CRT-QUOTE-FROM-KWRD-MANF.
           OPEN OUTPUT CODES-FILE.
           IF MANUF-DOCUMENT
              PERFORM 480-FIND-MANUF
           ELSE
              PERFORM 485-FIND-DCODE.

           IF NO-ENTRY
              GO TO 499-EXIT.
           IF NOT GOOD-CALL
              MOVE "DBFIND DCODE/MANUF 400 TQTGEN" TO BU-DISPLAY-MSG
              MOVE ACCEPT-DOC-TYPE       TO  BU-DISPLAY-FLD (1)
              MOVE MANUFACT-ARG          TO  BU-DISPLAY-FLD (2)
              PERFORM 990-BLOWUP THRU 999-EXIT.

       405-CODE-LOOP.
           IF MANUF-DOCUMENT
              PERFORM 490-READ-MANUF
           ELSE
              PERFORM 495-READ-DCODE.
           IF END-OF-CHAIN
              IF ACCEPT-SORT = "O"
                 GO TO 499-EXIT
              ELSE
                 GO TO 420-SORT-CODES.
           IF NOT GOOD-CALL
              MOVE "DBGET DSETNAME 405 TQTGEN" TO BU-DISPLAY-MSG
              MOVE ACCEPT-DOC-TYPE       TO  BU-DISPLAY-FLD (1)
              MOVE MANUFACT-ARG          TO  BU-DISPLAY-FLD (2)
              PERFORM 990-BLOWUP THRU 999-EXIT.

      *-----  SKIP THE SECOND LANGUAGE CODE
           IF KEYWORD-DOCUMENT
              IF CODE-LANGUAGE-IND = 2
                 GO TO 405-CODE-LOOP.

      *----- CHECK TO SEE IF ITEM IS CORPORATE CODED AND IF SO, THEN
      *----- CHECK FOR 'STOCK-OUT' STATUS
           IF MANUF-DOCUMENT
              MOVE MAN-CORPCODE          TO  CODE-ARG2
           ELSE
              MOVE CODE-KEY-CODE         TO  CODE-ARG2.
           MOVE 0                        TO  COND-WORD.
           MOVE CODE-ARG2                TO  CORPCDE OF MSTORERM-REC-I.
           READ  MSTORERM-I INTO BUF-MSTORERM
             INVALID KEY
                    MOVE FILE-STATUS     TO  FILE-STATUS.
           IF FILE-STATUS NOT = "00"
              MOVE 99                 TO  COND-WORD.
      *-----  CHECK RESULT OF READ.  IF COULD NOT GET THE CORPCODE
      *-----  RECORD, DISPLAY MESSAGE AND END PROGRAM
           IF NOT GOOD-CALL
              MOVE "DBGET MSTORERM FAILED AT 405 IN TQTGEN"
                TO BU-DISPLAY-MSG
              MOVE CODE-ARG2 TO BU-DISPLAY-FLD (1)
              PERFORM 990-BLOWUP THRU 999-EXIT.
      *-----  CHECK CODE TO SEE IF ITEM IS IN "STOCK-OUT" STATUS
      *-----  IF SO, DISPLAY MESSAGE, SKIP ITEM AND READ NEXT ITEM
           IF STR-STOCK-OT = "X"
              DISPLAY "***********************************************"
              DISPLAY "**  KEYWORD/MANF ITEM IS IN STOCK-OUT STATUS"
              DISPLAY "**  CORPCODE  : " CODE-ARG2
              DISPLAY "**  KWRD/MOD  : " KEYWORD-ARG
              DISPLAY "**  MANUFACT  : " MANUFACT-ARG
              DISPLAY "***********************************************"
              GO TO 405-CODE-LOOP.

      *-----  LOGIC TO CHECK FOR DUPLICATE CORPCODES ON NEW QUOTE
           IF MANUF-DOCUMENT
              MOVE MAN-CORPCODE          TO  DUPCODE
           ELSE
              MOVE CODE-KEY-CODE         TO  DUPCODE
           END-IF.
           PERFORM 600-DUP-CORPCODE-LOGIC THRU 600-EXIT.
           IF DUPFOUND = "Y"
              GO TO 405-CODE-LOOP.

           MOVE SPACES                   TO  CODES-RECORD.
           IF MANUF-DOCUMENT
              MOVE MAN-CORPCODE          TO  CODE-ARG
           ELSE
              MOVE CODE-KEY-CODE         TO  CODE-ARG.

           IF ACCEPT-SORT = "O"
              GO TO 430-FIND-UM.

           MOVE CODE-ARG                 TO  CODE-NUMBER.
           WRITE CODES-RECORD.
           GO TO 405-CODE-LOOP.

       420-SORT-CODES.
           CLOSE   CODES-FILE.
           SORT    SORT-CODES-FILE       ASCENDING KEY SORT-NUMBER
                   USING CODES-FILE
                   GIVING CODES-FILE.
           OPEN    INPUT CODES-FILE.

       425-READ-CODES-LOOP.
           READ CODES-FILE
                AT END  CLOSE CODES-FILE
                        GO TO 499-EXIT.

           MOVE CODE-NUMBER              TO  CODE-ARG.

       430-FIND-UM.

      *----------  CREATE QUOTE SEGMENT IN DVENDITM
           PERFORM 130-COMPUTE-USAGE THRU 179-EXIT.

           IF ACCEPT-SORT = "O"
              GO TO 405-CODE-LOOP
           ELSE
              GO TO 425-READ-CODES-LOOP.
       480-FIND-MANUF.
           MOVE 0                        TO  COND-WORD.
           MOVE MANUFACT-ARG TO MANUFACT OF DMANPART-REC-I.
           START DMANPART-I KEY = MANUFACT OF DMANPART-REC-I
               INVALID KEY MOVE 17       TO  COND-WORD.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
                   MOVE 17               TO  COND-WORD
               ELSE
                   MOVE 99               TO  COND-WORD.
       485-FIND-DCODE.
           MOVE 0                        TO  COND-WORD.
           MOVE KEYWORD-ARG              TO  KEYWORDADJ OF DCODE-REC-I.
           START DCODE-I KEY = KEYWORDADJ OF DCODE-REC-I
               INVALID KEY MOVE 17       TO  COND-WORD.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
                   MOVE 17               TO  COND-WORD
               ELSE
                   MOVE 99               TO  COND-WORD.
       490-READ-MANUF.
           MOVE 0                        TO  COND-WORD.
           READ DMANPART-I NEXT INTO BUF-DMANPART
               AT END MOVE 15            TO  COND-WORD.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   MOVE 15               TO  COND-WORD
               ELSE
                   MOVE 99               TO  COND-WORD.
           IF MANUFACT OF DMANPART-REC-I NOT = MANUFACT-ARG
               MOVE 15                   TO  COND-WORD.
        495-READ-DCODE.
           MOVE 0                        TO  COND-WORD.
           READ DCODE-I NEXT INTO BUF-DCODE
               AT END MOVE 15            TO  COND-WORD.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   MOVE 15               TO  COND-WORD
               ELSE
                   MOVE 99               TO  COND-WORD.
           IF KEYWORDADJ OF DCODE-REC-I NOT = KEYWORD-ARG
               MOVE 15                   TO  COND-WORD.
       499-EXIT.  EXIT.

       500-CRT-QT-FROM-KEYWORD-ONLY.
           OPEN OUTPUT CODES-FILE.
           PERFORM 585-FIND-DCODE.

           IF NO-ENTRY
              GO TO 599-EXIT.
           IF NOT GOOD-CALL
              MOVE "DBFIND DCODE 500 TQTGEN" TO BU-DISPLAY-MSG
              MOVE ACCEPT-DOC-TYPE       TO  BU-DISPLAY-FLD (1)
              PERFORM 990-BLOWUP THRU 999-EXIT.

       505-CODE-LOOP.
           PERFORM 595-READ-DCODE.
           IF END-OF-CHAIN
              IF ACCEPT-SORT = "O"
                 GO TO 599-EXIT
              ELSE
                 GO TO 520-SORT-CODES.
           IF NOT GOOD-CALL
              MOVE "DBGET DCODE 505 TQTGEN" TO BU-DISPLAY-MSG
              MOVE ACCEPT-DOC-TYPE       TO  BU-DISPLAY-FLD (1)
              PERFORM 990-BLOWUP THRU 999-EXIT.

      *-----  SKIP THE SECOND LANGUAGE CODE
           IF CODE-LANGUAGE-IND = 2
              GO TO 505-CODE-LOOP.

      *----- CHECK TO SEE IF ITEM IS CORPORATE CODED AND IF SO, THEN
      *----- CHECK FOR 'STOCK-OUT' STATUS
           MOVE CODE-KEY-CODE            TO  CODE-ARG2.
           MOVE 0                        TO  COND-WORD.
           MOVE CODE-ARG2                TO  CORPCDE OF MSTORERM-REC-I.
           READ  MSTORERM-I INTO BUF-MSTORERM
             INVALID KEY
                    MOVE FILE-STATUS     TO  FILE-STATUS.
           IF FILE-STATUS NOT = "00"
              MOVE 99                 TO  COND-WORD.
      *-----  CHECK RESULT OF READ.  IF COULD NOT GET THE CORPCODE
      *-----  RECORD, DISPLAY MESSAGE AND END PROGRAM
           IF NOT GOOD-CALL
              MOVE "DBGET MSTORERM FAILED AT 505 IN TQTGEN"
                TO BU-DISPLAY-MSG
              MOVE CODE-ARG2 TO BU-DISPLAY-FLD (1)
              PERFORM 990-BLOWUP THRU 999-EXIT.
      *-----  CHECK CODE TO SEE IF ITEM IS IN "STOCK-OUT" STATUS
      *-----  IF SO, DISPLAY MESSAGE, SKIP ITEM AND READ NEXT ITEM
           IF STR-STOCK-OT = "X"
              DISPLAY "***********************************************"
              DISPLAY "**  KEYWORD ITEM IS IN STOCK-OUT STATUS"
              DISPLAY "**  CORPCODE  : " CODE-ARG2
              DISPLAY "**  KEYWORD   : " KEYWORD-ARG
              DISPLAY "***********************************************"
              GO TO 505-CODE-LOOP.

      *-----  LOGIC TO CHECK FOR DUPLICATE CORPCODES ON NEW QUOTE
           MOVE CODE-KEY-CODE            TO  DUPCODE.
           PERFORM 600-DUP-CORPCODE-LOGIC THRU 600-EXIT.
           IF DUPFOUND = "Y"
              GO TO 505-CODE-LOOP.

           MOVE SPACES                   TO  CODES-RECORD.
           MOVE CODE-KEY-CODE         TO  CODE-ARG.

           IF ACCEPT-SORT = "O"
              GO TO 530-FIND-UM.

           MOVE CODE-ARG                 TO  CODE-NUMBER.
           WRITE CODES-RECORD.
           GO TO 505-CODE-LOOP.

       520-SORT-CODES.
           CLOSE   CODES-FILE.
           SORT    SORT-CODES-FILE       ASCENDING KEY SORT-NUMBER
                   USING CODES-FILE
                   GIVING CODES-FILE.
           OPEN    INPUT CODES-FILE.

       525-READ-CODES-LOOP.
           READ CODES-FILE
                AT END  CLOSE CODES-FILE
                        GO TO 599-EXIT.

           MOVE CODE-NUMBER              TO  CODE-ARG.

       530-FIND-UM.

      *----------  CREATE QUOTE SEGMENT IN DVENDITM
           PERFORM 130-COMPUTE-USAGE THRU 179-EXIT.

           IF ACCEPT-SORT = "O"
              GO TO 505-CODE-LOOP
           ELSE
              GO TO 525-READ-CODES-LOOP.
       585-FIND-DCODE.
           MOVE 0                        TO  COND-WORD.
           MOVE KEYWORD-ARG              TO  KEYWORDADJ OF DCODE-REC-I.
           START DCODE-I KEY NOT LESS THAN  KEYWORDADJ OF DCODE-REC-I
               INVALID KEY MOVE 17       TO  COND-WORD.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
                   MOVE 17               TO  COND-WORD
               ELSE
                   MOVE 99               TO  COND-WORD.
        595-READ-DCODE.
           MOVE 0                        TO  COND-WORD.
           READ DCODE-I NEXT INTO BUF-DCODE
               AT END MOVE 15            TO  COND-WORD.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   MOVE 15               TO  COND-WORD
               ELSE
                   MOVE 99               TO  COND-WORD.
           MOVE KEYWORDADJ OF DCODE-REC-I TO HOLD-KEYWORD.
           IF HOLD-KEYWORD NOT = ACCEPT-KEYWORD-ONLY
               MOVE 15                   TO  COND-WORD.
       599-EXIT.  EXIT.

       600-DUP-CORPCODE-LOGIC.
           MOVE "N" TO DUPFOUND.
      *----- IF OVERFLOW, BYPASS DUPLICATE CHECK LOGIC
           IF TBL-OVRFLW = "Y"
              GO TO 600-EXIT
           END-IF.
           MOVE 0 TO DUPSUB.
           PERFORM 6000-SEARCH-TABLE THRU 6000-EXIT
             UNTIL DUPFOUND = "Y"
             OR    DUPSUB   = TBLSIZE.
           IF DUPFOUND = "Y"
              GO TO 600-EXIT
           ELSE
              IF TBLSIZE = MAXTBLSIZE
                 MOVE "Y" TO TBL-OVRFLW
              ELSE
                 ADD 1 TO TBLSIZE
                 MOVE DUPCODE TO DE-CORPCDE (TBLSIZE)
              END-IF
           END-IF.

       600-EXIT.
           EXIT.

       6000-SEARCH-TABLE.
           ADD 1 TO DUPSUB.
           IF DUPCODE = DE-CORPCDE (DUPSUB)
              MOVE "Y" TO DUPFOUND
              GO TO 6000-EXIT
           END-IF.

       6000-EXIT.
           EXIT.

       700-CRT-QT-FROM-XREF.
           PERFORM 7000-INIT-READ-MANF THRU 7000-EXIT.
           IF NO-ENTRY
              GO TO 700-EXIT.
           PERFORM 7001-GET-XREF-CODES THRU 7001-EXIT.
           CLOSE   CODES-FILE.
           SORT    SORT-CODES-FILE   ASCENDING KEY SORT-NUMBER
                   USING  CODES-FILE
                   GIVING CODES-FILE.
           OPEN    INPUT CODES-FILE.
           PERFORM 7002-READ-XREF-CODES THRU 7002-EXIT.

       700-EXIT.
           EXIT.

       7000-INIT-READ-MANF.
           OPEN OUTPUT CODES-FILE.
           PERFORM 480-FIND-MANUF.
           IF NO-ENTRY
              GO TO 7000-EXIT.
           IF NOT GOOD-CALL
              MOVE "START DMANPART 7000 TQTGEN" TO BU-DISPLAY-MSG
              MOVE ACCEPT-MANUFACTURER TO BU-DISPLAY-FLD (1)
              PERFORM 990-BLOWUP THRU 999-EXIT.

       7000-EXIT.
           EXIT.

       7001-GET-XREF-CODES.
           PERFORM 490-READ-MANUF.
           IF END-OF-CHAIN
              GO TO 7001-EXIT.
           IF NOT GOOD-CALL
              MOVE "READ NEXT DMANPART 7001 TQTGEN"
                TO BU-DISPLAY-MSG
              MOVE MANUFACT-ARG TO BU-DISPLAY-FLD (1)
              PERFORM 990-BLOWUP THRU 999-EXIT.

      *-----  CHECK FOR 'STOCK-OUT' STATUS

           MOVE MAN-CORPCODE TO CODE-ARG2.
           MOVE 0            TO COND-WORD.
           MOVE CODE-ARG2    TO CORPCDE OF MSTORERM-REC-I.
           READ MSTORERM-I INTO BUF-MSTORERM
             INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
              MOVE 99        TO COND-WORD.

           IF NOT GOOD-CALL
              MOVE "READ MSTORERM 7001 TQTGEN" TO BU-DISPLAY-MSG
              MOVE CODE-ARG2 TO BU-DISPLAY-FLD (1)
              PERFORM 990-BLOWUP THRU 999-EXIT.

      *-----  CHECK CODE TO SEE IF ITEM IS IN "STOCK-OUT" STATUS
      *-----  IF SO, DISPLAY MESSAGE, SKIP ITEM AND READ NEXT ITEM

           IF STR-STOCK-OT = "X"
              DISPLAY "**********************************************"
              DISPLAY "**  MANUFACTURER ITEM IS IN STOCK-OUT STATUS  "
              DISPLAY "**  CORPCODE  : " CODE-ARG2
              DISPLAY "**  MANUFACT  : " MANUFACT-ARG
              DISPLAY "**********************************************"
              GO TO 7001-GET-XREF-CODES.

      *-----  NOW CHECK DCODE FILE TO SEE IF KEYWORD MODIFIER FOR CODE
      *-----  EQUALS KEYWORD PASSED TO PROGRAM

           MOVE CODE-ARG2 TO CORPCDE OF DCODE2-REC-I.
           MOVE 0         TO COND-WORD.
           START DCODE2-I KEY = CORPCDE OF DCODE2-REC-I
               INVALID KEY MOVE 17 TO COND-WORD.
           IF FILE-STATUS NOT = "00"
              IF FILE-STATUS-1 = "2"
                 MOVE 17 TO COND-WORD
              ELSE
                 MOVE 99 TO COND-WORD.
           IF NO-ENTRY
              GO TO 7001-GET-XREF-CODES.
           IF NOT GOOD-CALL
              MOVE "START DCODE2 7001 TQTGEN" TO BU-DISPLAY-MSG
              MOVE CODE-ARG2 TO BU-DISPLAY-FLD (1)
              PERFORM 990-BLOWUP THRU 999-EXIT.

      *-----  READ THROUGH DCODE FILE FOR KEYWORD MODIFIER MATCH
      *-----  AND WRITE CODE TO CODE FILE IF GOOD MATCH

           PERFORM 70010-GET-DCODE THRU 70010-EXIT.
           GO TO 7001-GET-XREF-CODES.

        7001-EXIT.
           EXIT.

        70010-GET-DCODE.
           MOVE 0 TO COND-WORD.
           READ DCODE2-I NEXT INTO BUF-DCODE
              AT END MOVE 15 TO COND-WORD.
           IF FILE-STATUS NOT = "00"
              IF FILE-STATUS = "10" OR "14" OR "46"
                 MOVE 15     TO COND-WORD
              ELSE
                 MOVE 99     TO COND-WORD.

           IF END-OF-CHAIN
              GO TO 70010-EXIT.
           IF NOT GOOD-CALL
              MOVE "READ NEXT DCODE 70010 TQTGEN" TO BU-DISPLAY-MSG
              MOVE CODE-ARG2 TO BU-DISPLAY-FLD (1)
              PERFORM 990-BLOWUP THRU 999-EXIT.

      *-----  CHECK KEYWORD AND/OR MODIFIER FOR MATCH WITH THE
      *-----  KEYWORD AND/OR MODIFIER PASSED TO PROGRAM

           IF KA-MODIFIER EQUAL SPACES
              MOVE CODE-KEYWORD-MOD TO HOLD-KEYWORD
              IF ACCEPT-KEYWORD-ONLY NOT = HOLD-KEYWORD
                 MOVE 15     TO COND-WORD
              END-IF
           ELSE
              IF ACCEPT-KEYWORD NOT = CODE-KEYWORD-MOD
                 MOVE 15     TO COND-WORD
              END-IF
           END-IF.

           IF END-OF-CHAIN
              GO TO 70010-EXIT.

      *-----  KEYWORD MUST BE IN PRIMARY LANGUAGE

           IF CODE-LANGUAGE-IND NOT = "1"
              GO TO 70010-GET-DCODE.

      *-----  LOGIC TO CHECK FOR DUPLICATE CORPCODES ON NEW QUOTE
           MOVE CODE-KEY-CODE            TO  DUPCODE.
           PERFORM 600-DUP-CORPCODE-LOGIC THRU 600-EXIT.
           IF DUPFOUND = "Y"
              GO TO 70010-EXIT.

           MOVE SPACES                   TO  CODES-RECORD.
           MOVE CODE-ARG2                TO  CODE-NUMBER.
           WRITE CODES-RECORD.

       70010-EXIT.
           EXIT.

       7002-READ-XREF-CODES.
           READ CODES-FILE
             AT END  CLOSE CODES-FILE
                     GO TO 7002-EXIT.

           MOVE CODE-NUMBER TO CODE-ARG.

      *-----  CREATE QUOTE SEGMENT IN DVENDITM

           PERFORM 130-COMPUTE-USAGE THRU 179-EXIT.
           GO TO 7002-READ-XREF-CODES.

       7002-EXIT.
           EXIT.

       800-GET-NONCODED-DESC.
           MOVE 0                        TO  COND-WORD.
           MOVE QUOTE-ARG TO QUOTENUM OF DQUOTEXT-REC-I.
           START DQUOTEXT-I KEY = QUOTENUM OF DQUOTEXT-REC-I
               INVALID KEY MOVE 17       TO  COND-WORD.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
                   MOVE 17               TO  COND-WORD
               ELSE
                   MOVE 99               TO  COND-WORD.
           IF NO-ENTRY
              GO TO 809-EXIT.
           IF NOT GOOD-CALL
              MOVE "DBFIND 800 DQUOTEXT TQTGEN" TO BU-DISPLAY-MSG
              PERFORM 990-BLOWUP THRU 999-EXIT.


       805-GET-NC-DESC.
           MOVE 0                        TO  COND-WORD.
           READ DQUOTEXT-I NEXT INTO BUF-DQUOTEXT
               AT END MOVE 15            TO  COND-WORD.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   MOVE 15               TO  COND-WORD
               ELSE
                   MOVE 99               TO  COND-WORD.
           IF QUOTENUM OF DQUOTEXT-REC-I NOT = QUOTE-ARG
               MOVE 15                   TO  COND-WORD.
           IF END-OF-CHAIN
              GO TO 809-EXIT
           ELSE
              IF NOT GOOD-CALL
                 MOVE "DBGET DQUOTEXT 805 TQTGEN" TO BU-DISPLAY-MSG
                 PERFORM 990-BLOWUP THRU 999-EXIT.

           IF DQUOTEXT-ITM-NO = 0
              GO TO 805-GET-NC-DESC.

           MOVE 1                        TO  X.
       807-LOOP-FOR-VENDORS.
           MOVE ACCEPT-QUOTE (X)         TO  DQUOTEXT-QUOTE-NO.
           MOVE 0                        TO  COND-WORD.
           WRITE DQUOTEXT-REC-O FROM BUF-DQUOTEXT
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE 99                   TO  COND-WORD.
           IF NOT GOOD-CALL
              MOVE "DBPUT DQUOTEXT 805 TQTGEN" TO BU-DISPLAY-MSG
              PERFORM 990-BLOWUP THRU 999-EXIT.

           ADD 1                         TO  X.
           IF X > 5 OR ACCEPT-QUOTE (X) = SPACES
              NEXT SENTENCE
           ELSE
              GO TO 807-LOOP-FOR-VENDORS.
           GO TO 805-GET-NC-DESC.
       809-EXIT.  EXIT.
       990-BLOWUP.
      *----------  PURGE THE FILE
           MOVE ACCEPT-DOCUMENT          TO  BU-DISPLAY-FLD (5).
           MOVE ACCEPT-DOC-TYPE          TO  BU-DISPLAY-FLD (4).
      *****MOVE ACCEPT-KEYWORD           TO  BU-DISPLAY-FLD (3).  *OLD*
           MOVE QUOTE-ARG-NUM            TO  BU-DISPLAY-FLD (3).
           CALL "TBLOWUP" USING BASE, BU-PGM-NAME, STATUS-AREA,
                 VIEW-COMAREA, FILE-STATUS, BU-DISPLAY-MSG,
                 BU-DISPLAY-FLDS.
       999-EXIT.  EXIT.
