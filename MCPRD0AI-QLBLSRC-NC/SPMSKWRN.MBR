       IDENTIFICATION DIVISION.
       PROGRAM-ID.             SPMSKWRN.
       AUTHOR.                 J.S. BUNGO.
       INSTALLATION.  GOODYEAR TIRE & RUBBER CO.
       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.
       SOURCE-COMPUTER.        IBM-AS400.
       OBJECT-COMPUTER.        IBM-AS400.
       SPECIAL-NAMES.          I-O-FEEDBACK IS I-O-FEEDBACK-AREA.

       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT WO-PLANNED
                  ASSIGN TO DATABASE-MCFLMM1107
                  ORGANIZATION IS INDEXED
                  ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                  FILE STATUS IS FILE-STAT.
           SELECT PM-SCHEDULE
                  ASSIGN TO DATABASE-MCFLMM4404
                  ORGANIZATION IS INDEXED
                  ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                  FILE STATUS IS FILE-STAT.
           SELECT DISPLAY-FILE
                  ASSIGN TO WORKSTATION-ZPMMAINT-SI
                  ORGANIZATION IS TRANSACTION
                  ACCESS IS SEQUENTIAL
                  FILE STATUS IS DISPLAY-STATUS
                  CONTROL-AREA IS WS-CONTROL.
           SELECT OUT-FILE
                  ASSIGN TO DISK-PMSKWRN
                  ORGANIZATION IS RELATIVE
                  ACCESS MODE IS DYNAMIC
                  RELATIVE KEY IS ACT-KEY
                  FILE STATUS IS FILE-STAT.
           SELECT SORT-FILE
                  ASSIGN TO DISK-SORTFILE.

       DATA DIVISION.
       FILE SECTION.
       FD  DISPLAY-FILE
           LABEL RECORDS ARE OMITTED.
       01  DISPLAY-REC         PIC X(2000).
       FD  WO-PLANNED
           LABEL RECORDS ARE STANDARD.
       01  WO-REC.
           COPY DDS-ALL-FORMATS OF MCFLMM1107.
       FD  PM-SCHEDULE
           LABEL RECORDS ARE STANDARD.
       01  PM-SCHED-REC.
           COPY DDS-ALL-FORMATS OF MCFLMM4404.
       FD  OUT-FILE RECORD CONTAINS 46 CHARACTERS
           LABEL RECORDS ARE OMITTED
           DATA RECORD IS OUT-REC.
       01  OUT-REC.
           05  OUT-EQUIP       PIC X(6).
           05  OUT-WO-NUM.
               10  OUT-WO      PIC X(7).
               10  OUT-WO-SUF  PIC X(3).
           05  OUT-DESCRIPT    PIC X(30).

       SD  SORT-FILE RECORD CONTAINS 46 CHARACTERS
           DATA RECORD IS SORT-REC.
       01  SORT-REC.
           05  SORT-EQUIP      PIC X(6).
           05  SORT-WO         PIC X(10).
           05  SORT-DESCRIPT   PIC X(30).

       WORKING-STORAGE SECTION.
       77  SUB                       PIC 9(04) VALUE 0.
       77  HELP-SW                   PIC 9(04) VALUE 0.
       77  EOF-SW                    PIC 9(4)  VALUE 0.
       77  ACT-KEY                   PIC 9(4).
       77  MAX-KEY                   PIC 9(4).
       77  SAVE-KEY                  PIC 9(4).
       77  PAGE-KEY                  PIC 9(4).
       77  FILE-STAT                 PIC X(02).

       01  DISPLAY-STATUS            PIC X(02).
       01  SRF-INDICATORS.
           05  IND OCCURS 99 TIMES   PIC 1 INDICATOR 01.
       01  WS-CONTROL.
           05  FUNCTION-NUM          PIC X(02).
           05  TERMINAL-ID           PIC X(10).
           05  FORMAT-NAME           PIC X(10).

       01  PASSWORD-INFORMATION.
           05  NAME-OF-PROGRAM     PIC X(08) VALUE "SPMSKWRN".
           05  PROGRAM-TYPE        PIC X(02) VALUE "IN".
           05  PROGRAM-RELEASE     PIC X(12) VALUE " J0100010001".
           05  PROGRAM-DESCRIPTION.
               10  PROG-DESCA1 PIC X(30) VALUE
                   "DISPLAYS A LIST OF WORKORDERS ".
               10  PROG-DESCA2 PIC X(30) VALUE
                   "FOR A SCHEDULE WARNING THAT   ".
               10  PROG-DESCB1 PIC X(30) VALUE
                   "THE SCHEDULES FOR THE WORKORDE".
               10  PROG-DESCB2 PIC X(30) VALUE
                   "RS WILL BE STOPPED FOR A      ".
               10  PROG-FUNCA  PIC X(30) VALUE
                   "SCHEDULE CHANGE.  ALLOWS THE U".
               10  PROG-FUNCB  PIC X(30) VALUE
                   "SER TO BACK OUT OF THE CHANGE.".
           05  PASSWORD-FLAG       PIC X.

       01  SCREEN-BUFFER.
           05  MASTER-COUNT-BUF PIC Z(4)9.
           05  SK-NAME-BUF      PIC X(10).
           05  SCREEN-LINE OCCURS 14 TIMES.
               10  EQUIP-BUF    PIC X(06).
               10  WO-BUF       PIC X(10).
               10  DESCRIPT-BUF PIC X(30).
           05  CONTINUE-BUF     PIC X(08).
           05  CMDMSG           PIC X(79).
           05  ERRMSG           PIC X(79).

       01  DB-ERROR.
           05  DB-TYPE   PIC X(08) VALUE SPACES.
           05  FILLER    PIC X(21) VALUE " ERROR - COND-WORD = ".
           05  CON-WORD  PIC -9999.

       01  SCREEN-PRINT-PARMS.
           05  PRINTCNTL              PIC S9(4)  VALUE ZERO  COMP.
           05  PAGECNTL               PIC S9(4)  VALUE 49    COMP.
           05  SPOOLFIL-OPEN-SW       PIC X      VALUE "N".
       01  PASSED-SPOOL-PRT           PIC S9(2)              COMP.
       01  FATAL-ERR-SW               PIC X.
       01  BU-DISPLAY-AREA.
           05  FILLER                 PIC XX.
           05  BU-DISPLAY-MSG         PIC X(27).
           05  FILLER                 PIC XX.
           05  BU-DISPLAY-STAT        PIC S9(4).
           05  FILLER                 PIC XX.
           05  BU-DISPLAY-FLD         PIC X(14).
           05  FILLER                 PIC XX.

           COPY DBSTAT         IN COPYLIB.

           COPY CATREAD        IN COPYLIB.

           COPY IOFEEDBACK     IN COPYLIB.

       01  WO-PLANNED-DATA.    COPY DWOPLAN   IN COPYLIB.

       01  MESSAGE-FILE-DATA.  COPY ERRORLIN  IN COPYLIB.

       01  PM-SCHED-DATA.      COPY DPMSCHED  IN COPYLIB.

       LINKAGE SECTION.
           COPY VCOMLINK       IN COPYLIB.

       01  DBPARAMETERS.       COPY DBPARMS   IN COPYLIB.

       01  SK-NAME-KEY         PIC X(10).
       01  CONTINUE-CHANGE     PIC 9(4).

       PROCEDURE DIVISION USING DBPARAMETERS
                                VIEW-COMAREA
                                SK-NAME-KEY
                                CONTINUE-CHANGE.
       BEGIN-SORT SECTION 01.

       BEGIN-PROC.
           CALL "CLPMSKWRN".
           PERFORM HSK THRU HSK-EXIT.
           GO TO MAIN.

       HSK.
           OPEN I-O            DISPLAY-FILE.
           OPEN INPUT          WO-PLANNED
                               PM-SCHEDULE.
           MOVE SPACES         TO SCREEN-BUFFER.
       HSK-EXIT.
           EXIT.

       END-OF-JOB.
           CLOSE               DISPLAY-FILE
                               WO-PLANNED
                               PM-SCHEDULE.
           GOBACK.

       MAIN.
           OPEN OUTPUT         OUT-FILE.
           MOVE 0              TO ACT-KEY.
           SORT SORT-FILE ASCENDING KEY SORT-EQUIP
               INPUT  PROCEDURE SORTIN-INQUIRY
               OUTPUT PROCEDURE SORTOUT-INQUIRY
           CLOSE               OUT-FILE.

           IF ACT-KEY = 0
               MOVE 1 TO CONTINUE-CHANGE
               GO TO END-OF-JOB.

           OPEN I-O            OUT-FILE.
           MOVE 0              TO ACT-KEY.
           MOVE "VSKWRN"       TO VIEW-NFNAME.
           MOVE 25             TO HELP-SW.

       RESET-SCREEN.
           MOVE SPACES         TO SCREEN-BUFFER MESSAGE-BUFFER.
           PERFORM FILL-SCREEN THRU FS-EXIT.
           MOVE ALL B"0" TO SRF-INDICATORS.

       SHOWFORM.
           MOVE SCREEN-BUFFER TO DISPLAY-REC.
           WRITE DISPLAY-REC FORMAT IS VIEW-NFNAME
               INDIC ARE SRF-INDICATORS.
           IF DISPLAY-STATUS NOT = "00"
               CLOSE OUT-FILE
               GO TO END-OF-JOB.
           MOVE ALL B"0" TO SRF-INDICATORS.

           READ DISPLAY-FILE FORMAT IS VIEW-NFNAME
               INDIC ARE SRF-INDICATORS.
           ACCEPT IOFEEDBACK FROM I-O-FEEDBACK-AREA.
           IF DISPLAY-STATUS NOT = "00"
               MOVE 3 TO VIEW-LASTKEY
           ELSE
               MOVE FUNCTION-NUM TO VIEW-LASTKEY.

           IF VIEW-LASTKEY = 3 OR 8
               MOVE 0 TO CONTINUE-CHANGE
               CLOSE OUT-FILE
               GO TO END-OF-JOB.

           IF VIEW-LASTKEY = 2
               IF ACT-KEY NOT > 14
                   GO TO SHOWFORM
               ELSE
                   COMPUTE ACT-KEY = ACT-KEY - PAGE-KEY - 14
                   MOVE 0 TO EOF-SW
                   GO TO RESET-SCREEN.

           IF VIEW-LASTKEY = 4
               IF EOF-SW = 1
                   GO TO SHOWFORM
               ELSE
                   GO TO RESET-SCREEN.

           IF VIEW-LASTKEY = 7
               CALL "SPMHELPM" USING HELP-SW
               GO TO SHOWFORM.

           IF VIEW-LASTKEY NOT = 0
               GO TO SHOWFORM.

           MOVE DISPLAY-REC TO SCREEN-BUFFER.

           IF CONTINUE-BUF = "CONTINUE"
               MOVE 1 TO CONTINUE-CHANGE
               CLOSE OUT-FILE
               GO TO END-OF-JOB.

           GO TO SHOWFORM.


       FILL-SCREEN.
           MOVE MAX-KEY        TO MASTER-COUNT-BUF.
           MOVE SK-NAME-KEY    TO SK-NAME-BUF.
           MOVE 0              TO SUB  PAGE-KEY.
           PERFORM FILL-LINE THRU FL-EXIT UNTIL SUB = 14.
           MOVE ACT-KEY        TO SAVE-KEY.

       FS-EXIT.    EXIT.

       FILL-LINE.
           ADD 1               TO ACT-KEY SUB PAGE-KEY.

           MOVE SPACES         TO OUT-REC.
           READ OUT-FILE INVALID KEY
               MOVE 1          TO EOF-SW
               MOVE 14         TO SUB
               GO TO FL-EXIT.

           IF ACT-KEY > MAX-KEY
               MOVE 1          TO EOF-SW
               MOVE 14         TO SUB
               SUBTRACT 1 FROM ACT-KEY PAGE-KEY
               GO TO FL-EXIT.

           MOVE OUT-EQUIP      TO EQUIP-BUF (SUB).
           MOVE OUT-WO-NUM     TO WO-BUF (SUB).
           MOVE OUT-DESCRIPT   TO DESCRIPT-BUF (SUB).

       FL-EXIT.    EXIT.

       SET-ERROR.
           MOVE B"1" TO IND (FIELD-NUMBER)   IND (99).

       SORTIN-INQUIRY SECTION.
           PERFORM SORT-MAIN THRU SORT-M-EXIT
           GO TO SORT-IP-EXIT.

       SORT-MAIN.
           MOVE SK-NAME-KEY TO PMSCHEDKEY OF WO-PLANNED.
           START WO-PLANNED KEY = PMSCHEDKEY OF WO-PLANNED
               INVALID KEY MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
               GO TO SORT-M-EXIT.

       SORT-DBGET.
           MOVE SPACES         TO SORT-REC.
           READ WO-PLANNED NEXT INTO WO-PLANNED-DATA
               AT END MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
               GO TO SORT-M-EXIT.
           IF PM-SCHEDULE-KEY NOT = SK-NAME-KEY
               GO TO SORT-M-EXIT.

           IF WO-NUM-SUFF-P = "000"
               PERFORM CHECK-INITIATION THRU CHECK-INITIATION-EXIT
               IF FILE-STAT = "00"
                   MOVE EQUIP-NUM-P      TO SORT-EQUIP
                   MOVE WO-NUM-PLANNED   TO SORT-WO
                   MOVE DESCRIPTION-1-P  TO SORT-DESCRIPT
                   RELEASE SORT-REC.

           GO TO SORT-DBGET.

       SORT-M-EXIT.    EXIT.

       CHECK-INITIATION.
           MOVE WO-NUM-PLANNED TO WONUM OF PM-SCHEDULE.
           READ PM-SCHEDULE
               INVALID KEY MOVE FILE-STAT TO FILE-STAT.
       CHECK-INITIATION-EXIT.
           EXIT.

       SORT-IP-EXIT.    EXIT.

       SORTOUT-INQUIRY SECTION.
           RETURN SORT-FILE AT END
               MOVE ACT-KEY    TO MAX-KEY
               GO TO SORT-WF-EXIT.
           ADD 1               TO ACT-KEY.
           MOVE SORT-REC       TO OUT-REC.
           WRITE OUT-REC INVALID KEY
               DISPLAY "WRITE OUT-FILE ERR"
               GO TO SORT-WF-EXIT.
           GO TO SORTOUT-INQUIRY.

       SORT-WF-EXIT.
           EXIT.
