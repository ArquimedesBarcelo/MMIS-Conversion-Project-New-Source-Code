           GO TO MOD-WO-OPENQ-NEXT.

       MWOE-EXIT.              EXIT.

       MOD-EQP-REFERENCE-EQPNUMS.
           IF EQP-EQUIP-NUM OF EQUIPMENT-DATA =
              EQP-EQUIP-NUM OF EQUIPMENT-DATA2
               IF EQP-TYPE  OF EQUIPMENT-DATA =
                  EQP-TYPE  OF EQUIPMENT-DATA2
                   GO TO MERFE-EXIT.

           READ EQP-REFERENCE-FILE FIRST INTO BUF-EQP-REF
               AT END          GO TO MERFE-EXIT.
           IF FILE-STAT = "10" OR "14" OR "46"
               GO TO MERFE-EXIT.
           IF FILE-STAT NOT = "00"
               MOVE "EQP-REFERENCE-FILE R" TO ERR-NAME
               MOVE FILE-STAT              TO ERR-NUM
               MOVE MOD-FILE-ERRS          TO ERRMSGMC
               PERFORM DISPLAY-ERRORS
               GO TO MERFE-EXIT.

           GO TO MOD-EQP-REFERENCE-CONT.

       MOD-EQP-REFERENCE-NEXT.
           READ EQP-REFERENCE-FILE NEXT INTO BUF-EQP-REF
               AT END          GO TO MERFE-EXIT.
           IF FILE-STAT = "10" OR "14" OR "46"
               GO TO MERFE-EXIT.
           IF FILE-STAT NOT = "00"
               MOVE "EQP-REFERENCE-FILE R" TO ERR-NAME
               MOVE FILE-STAT              TO ERR-NUM
               MOVE MOD-FILE-ERRS          TO ERRMSGMC
               PERFORM DISPLAY-ERRORS
               GO TO MERFE-EXIT.

       MOD-EQP-REFERENCE-CONT.
           IF ESK-EQUIP OF BUF-EQP-REF = EQP-EQUIP-NUM OF EQUIPMENT-DATA
               MOVE EQP-EQUIP-NUM OF EQUIPMENT-DATA2
                               TO ESK-EQUIP OF BUF-EQP-REF
               MOVE EQP-TYPE   OF EQUIPMENT-DATA2
                               TO EQP-CORP-TYPE OF BUF-EQP-REF
               IF EQP-EQUIP-NUM OF EQUIPMENT-DATA =
                  EQP-EQUIP-NUM OF EQUIPMENT-DATA2
                   REWRITE EQP-REF-RCD FROM BUF-EQP-REF
                       INVALID KEY MOVE FILE-STAT TO FILE-STAT
                       END-REWRITE
               ELSE
                   DELETE EQP-REFERENCE-FILE
                       INVALID KEY MOVE FILE-STAT TO FILE-STAT
                       END-DELETE
                   IF FILE-STAT = "00"
                   WRITE EQP-REF-RCD FROM BUF-EQP-REF
                       INVALID KEY MOVE FILE-STAT TO FILE-STAT
                       END-WRITE
                   END-IF
               END-IF
               IF FILE-STAT NOT = "00"
                   MOVE "EQP-REFERENCE-FILE D" TO ERR-NAME
                   MOVE FILE-STAT              TO ERR-NUM
                   MOVE MOD-FILE-ERRS          TO ERRMSGMC
                   PERFORM DISPLAY-ERRORS
                   GO TO MERFE-EXIT
               END-IF
               GO TO MOD-EQP-REFERENCE-EQPNUMS
           ELSE
           GO TO MOD-EQP-REFERENCE-NEXT.

       MERFE-EXIT.             EXIT.

       MOD-EQP-REMARKS-EQPNUMS.
           IF EQP-EQUIP-NUM OF EQUIPMENT-DATA =
              EQP-EQUIP-NUM OF EQUIPMENT-DATA2
               GO TO MERME-EXIT.

           READ EQP-REMARKS-FILE FIRST INTO BUF-EQP-REM
               AT END          GO TO MERME-EXIT.
           IF FILE-STAT = "10" OR "14" OR "46"
               GO TO MERME-EXIT.
           IF FILE-STAT NOT = "00"
               MOVE "EQP-REMARKS-FILE  RF" TO ERR-NAME
               MOVE FILE-STAT              TO ERR-NUM
               MOVE MOD-FILE-ERRS          TO ERRMSGMC
               PERFORM DISPLAY-ERRORS
               GO TO MERME-EXIT.

           GO TO MOD-EQP-REMARKS-CONT.

       MOD-EQP-REMARKS-NEXT.
           READ EQP-REMARKS-FILE NEXT INTO BUF-EQP-REM
               AT END          GO TO MERME-EXIT.
           IF FILE-STAT = "10" OR "14" OR "46"
               GO TO MERME-EXIT.
           IF FILE-STAT NOT = "00"
               MOVE "EQP-REMARKS-FILE  RN" TO ERR-NAME
               MOVE FILE-STAT              TO ERR-NUM
               MOVE MOD-FILE-ERRS          TO ERRMSGMC
               PERFORM DISPLAY-ERRORS
               GO TO MERME-EXIT.

       MOD-EQP-REMARKS-CONT.
           IF ESK-EQUIP OF BUF-EQP-REM = EQP-EQUIP-NUM OF EQUIPMENT-DATA
               MOVE EQP-EQUIP-NUM OF EQUIPMENT-DATA2
                               TO ESK-EQUIP OF BUF-EQP-REM
               DELETE EQP-REMARKS-FILE
                   INVALID KEY MOVE FILE-STAT TO FILE-STAT
                   END-DELETE
               IF FILE-STAT = "00"
               WRITE EQP-RMK-RCD FROM BUF-EQP-REM
                   INVALID KEY MOVE FILE-STAT TO FILE-STAT
                   END-WRITE
               END-IF
               IF FILE-STAT NOT = "00"
                   MOVE "EQP-REMARKS-FILE DEL" TO ERR-NAME
                   MOVE FILE-STAT              TO ERR-NUM
                   MOVE MOD-FILE-ERRS          TO ERRMSGMC
                   PERFORM DISPLAY-ERRORS
                   GO TO MERME-EXIT
               END-IF
               GO TO MOD-EQP-REMARKS-EQPNUMS
           ELSE
           GO TO MOD-EQP-REMARKS-NEXT.

       MERME-EXIT.             EXIT.

       MOD-EQP-OPERATIONS-EQPNUMS.
           IF EQP-EQUIP-NUM OF EQUIPMENT-DATA =
              EQP-EQUIP-NUM OF EQUIPMENT-DATA2
               GO TO MEOPE-EXIT.

           READ EQP-OPERATIONS-FILE FIRST INTO BUF-EQP-OPS
               AT END          GO TO MEOPE-EXIT.
           IF FILE-STAT = "10" OR "14" OR "46"
               GO TO MEOPE-EXIT.
           IF FILE-STAT NOT = "00"
               MOVE "EQP-OPERATIONS-FILE " TO ERR-NAME
               MOVE FILE-STAT              TO ERR-NUM
               MOVE MOD-FILE-ERRS          TO ERRMSGMC
               PERFORM DISPLAY-ERRORS
               GO TO MEOPE-EXIT.

           GO TO MOD-EQP-OPERATIONS-CONT.

       MOD-EQP-OPERATIONS-NEXT.
           READ EQP-OPERATIONS-FILE NEXT INTO BUF-EQP-OPS
               AT END          GO TO MEOPE-EXIT.
           IF FILE-STAT = "10" OR "14" OR "46"
               GO TO MEOPE-EXIT.
           IF FILE-STAT NOT = "00"
               MOVE "EQP-OPERATIONS-FILE " TO ERR-NAME
               MOVE FILE-STAT              TO ERR-NUM
               MOVE MOD-FILE-ERRS          TO ERRMSGMC
               PERFORM DISPLAY-ERRORS
               GO TO MEOPE-EXIT.

       MOD-EQP-OPERATIONS-CONT.
           IF ESK-EQUIP OF BUF-EQP-OPS = EQP-EQUIP-NUM OF EQUIPMENT-DATA
               MOVE EQP-EQUIP-NUM OF EQUIPMENT-DATA2
                               TO ESK-EQUIP OF BUF-EQP-OPS
               DELETE EQP-OPERATIONS-FILE
                   INVALID KEY MOVE FILE-STAT TO FILE-STAT
                   END-DELETE
               IF FILE-STAT = "00"
               WRITE EQP-OPS-RCD FROM BUF-EQP-OPS
                   INVALID KEY MOVE FILE-STAT TO FILE-STAT
                   END-WRITE
               END-IF
               IF FILE-STAT NOT = "00"
                   MOVE "EQP-OPERATIONS-FILE " TO ERR-NAME
                   MOVE FILE-STAT              TO ERR-NUM
                   MOVE MOD-FILE-ERRS          TO ERRMSGMC
                   PERFORM DISPLAY-ERRORS
                   GO TO MEOPE-EXIT
               END-IF
               GO TO MOD-EQP-OPERATIONS-EQPNUMS
           ELSE
           GO TO MOD-EQP-OPERATIONS-NEXT.

       MEOPE-EXIT.             EXIT.

       MOD-DRAWING-EQPNUMS.
           IF EQP-EQUIP-NUM OF EQUIPMENT-DATA =
              EQP-EQUIP-NUM OF EQUIPMENT-DATA2
               GO TO MDE-EXIT.

           READ DRAWING-FILE   FIRST INTO WO-DRAWING-DATA
               AT END          GO TO MDE-EXIT.
           IF FILE-STAT = "10" OR "14" OR "46"
               GO TO MDE-EXIT.
           IF FILE-STAT NOT = "00"
               MOVE "DRAWING-FILE  READ F" TO ERR-NAME
               MOVE FILE-STAT              TO ERR-NUM
               MOVE MOD-FILE-ERRS          TO ERRMSGMC
               PERFORM DISPLAY-ERRORS
               GO TO MDE-EXIT.

           GO TO MOD-DRAWING-CONT.

       MOD-DRAWING-NEXT.
           READ DRAWING-FILE   NEXT INTO WO-DRAWING-DATA
               AT END          GO TO MDE-EXIT.
           IF FILE-STAT = "10" OR "14" OR "46"
               GO TO MDE-EXIT.
           IF FILE-STAT NOT = "00"
               MOVE "DRAWING-FILE  READ N" TO ERR-NAME
               MOVE FILE-STAT              TO ERR-NUM
               MOVE MOD-FILE-ERRS          TO ERRMSGMC
               PERFORM DISPLAY-ERRORS
               GO TO MDE-EXIT.

       MOD-DRAWING-CONT.
           IF DRAW-ENUM OF WO-DRAWING-DATA = EQP-EQUIP-NUM
                               OF EQUIPMENT-DATA
               MOVE EQP-EQUIP-NUM OF EQUIPMENT-DATA2
                               TO DRAW-ENUM OF WO-DRAWING-DATA
               REWRITE DRAW-RCD FROM WO-DRAWING-DATA
                   INVALID KEY MOVE FILE-STAT TO FILE-STAT
               END-REWRITE
               IF FILE-STAT NOT = "00"
                   MOVE "DRAWING-FILE REWRITE" TO ERR-NAME
                   MOVE FILE-STAT              TO ERR-NUM
                   MOVE MOD-FILE-ERRS          TO ERRMSGMC
                   PERFORM DISPLAY-ERRORS
                   GO TO MDE-EXIT
               END-IF.

           GO TO MOD-DRAWING-NEXT.

       MDE-EXIT.               EXIT.

       CHECK-EQPNUM.
           IF EQP-KEY = "SAFE01" OR "SAFE02" OR "SAFE03" OR "SAFE04" OR
                        "SAFE05" OR "SAFE06" OR "SAFE07" OR "SAFE08" OR
                        "SAFE09" OR "SAFE10" OR "SAFE11" OR "SAFE12" OR
                        "SAFE13" OR "SAFE14" OR "SAFE15" OR "SAFE16" OR
                        "SAFE07" OR "SAFE18"
               MOVE
           "SAFETY CONTACT RECORDS CANNOT BE ADDED, CHANGED OR DELETED."
                               TO MESSAGE-BUFFER
               MOVE "XX"       TO FILE-STAT
               GO TO CHECK-EQPNUM-EXIT.

           MOVE EQP-KEY        TO EQPNUM OF EQP-REC1.
           READ EQP-EQUIPMENT1 INTO EQUIPMENT-DATA
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT = "00" OR "23"
               GO TO CHECK-EQPNUM-EXIT
           ELSE
               STRING
               "READ ERROR IN EQP-EQUIPMENT1        FILE STATUS = "
                               FILE-STAT
                               DELIMITED BY SIZE
                               INTO MESSAGE-BUFFER.

       CHECK-EQPNUM-EXIT.      EXIT.

       END-OF-JOB.
           CLOSE               DISPLAY-FILE.
           CLOSE               EQP-EQUIPMENT2.
           CLOSE               EQP-EQUIPMENT1.
           CLOSE               WO-ZONE-PRTY.
           CLOSE               MASBMSG-LF.
           GOBACK.

       DISPLAY-ERRORS.
           MOVE "00"           TO SCREEN-STATUS.
           MOVE SCREEN-OLDNEW  TO DISPLAY-REC.
           MOVE TRUE-VAL       TO IND(99).
           WRITE DISPLAY-REC   FORMAT IS SCREEN-NAME
                               INDIC ARE SCREEN-INDICATORS.
           IF SCREEN-STATUS NOT = "00"
               DISPLAY "SCREEN WRITE ERROR.  SCREEN-STATUS IS "
                               SCREEN-STATUS
               GO TO END-OF-JOB.

           READ  DISPLAY-FILE  FORMAT IS SCREEN-NAME
                               INDIC ARE SCREEN-INDICATORS
           IF SCREEN-STATUS NOT = "00"
               DISPLAY "SCREEN READ ERROR.  SCREEN-STATUS IS "
                               SCREEN-STATUS
               GO TO END-OF-JOB.

           MOVE ALL B"0"       TO SCREEN-INDICATORS.

       ADJUST-SIX.
           MOVE A7             TO A8.
           MOVE A6             TO A7.
           MOVE A5             TO A6.
           MOVE A4             TO A5.
           MOVE A3             TO A4.
           MOVE "0"            TO A3.

       ADJUST-EIGHT.
           MOVE A7             TO A8.
           MOVE A6             TO A7.
           MOVE A5             TO A6.
           MOVE A4             TO A5.
           MOVE A3             TO A4.
           MOVE A2             TO A3.
           MOVE A1             TO A2.
           MOVE "0"            TO A1.

      *************  END OF FILE  ************************************
