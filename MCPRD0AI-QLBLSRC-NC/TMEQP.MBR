       IDENTIFICATION DIVISION.
       PROGRAM-ID.             TMEQP.
       AUTHOR.                 W. ROXBURY.
       INSTALLATION.           GOODYEAR TIRE & RUBBER CO.
       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.
       SOURCE-COMPUTER.        IBM-AS400.
       OBJECT-COMPUTER.        IBM-AS400.

      *C****************************************************************
      *C*  02/28/94  WDR
      *C*  RE-WROTE PROGRAM TO CORRECT LOGIC ERROR INCURRED WHEN
      *C*  CHANGING EQUIPMENT NUMBERS.  A LOGICAL KEY CHANGE WILL
      *C*  MOVE THE DATASET POINTER WHEN A RECORD IS RE-WRITTEN AND
      *C*  MAY DESTROY THE SEQUENTIAL READ SEQUENCE
      *C****************************************************************
      *C*  09/13/94  WLM
      *C*  REVISED PROGRAM TO ALLOW FOR MAINTENANCE OF A FLAG IN THE
      *C*  EQUIPMENT DATABASE TO DETERMINE WHETHER THE EQUIPMENT
      *C*  WILL HAVE A WARNING MESSAGE FOR ASBESTOS CONTENT.
      *C****************************************************************

      *C****************************************************************
      *C*  01/22/97  WDR
      *C*  RE-WROTE ENTIRE PROGRAM TO MAKE MORE USER-FRIENDLY.
      *C****************************************************************

      *C****************************************************************
      *C*  08/06/98  JIM COFFMAN
      *C*  ADDED LOGIC TO THE CHANGE EQUIPMENT NUMBER LOGIC TO ALLOW
      *C*  THE USER TO REQUEST A MODIFY SCREEN (I.E. CALL UP AN
      *C*  EXISTING PIECE OF EQUIPMENT) AND CHANGE ANY AND ALL FIELDS
      *C*  INCLUDING THE EQUIPMENT NUMBER AND ADD THE NEW EQUIPMENT
      *C*  NUMBER.
      *C****************************************************************

       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT EQP-EQUIPMENT1
                  ASSIGN       TO DATABASE-MCFLMM0201
                  ORGANIZATION IS INDEXED
                  ACCESS MODE  IS DYNAMIC
                  RECORD KEY   IS EXTERNALLY-DESCRIBED-KEY
                  FILE STATUS  IS FILE-STAT.

           SELECT EQP-EQUIPMENT2
                  ASSIGN       TO DATABASE-MCFLMM0201
                  ORGANIZATION IS INDEXED
                  ACCESS MODE  IS DYNAMIC
                  RECORD KEY   IS EXTERNALLY-DESCRIBED-KEY
                  FILE STATUS  IS FILE-STAT.

           SELECT BASIC-FILE
                  ASSIGN       TO DATABASE-MCFLMM1001
                  ORGANIZATION IS INDEXED
                  ACCESS MODE  IS DYNAMIC
                  RECORD KEY   IS EXTERNALLY-DESCRIBED-KEY
                               WITH DUPLICATES
                  FILE STATUS  IS FILE-STAT.

           SELECT HOT-CODE-FILE
                  ASSIGN       TO DATABASE-MCFLMM2001
                  ORGANIZATION IS INDEXED
                  ACCESS MODE  IS DYNAMIC
                  RECORD KEY   IS EXTERNALLY-DESCRIBED-KEY
                               WITH DUPLICATES
                  FILE STATUS  IS FILE-STAT.

           SELECT CORP-CODE-LINK
                  ASSIGN       TO DATABASE-MCFLMM2101
                  ORGANIZATION IS INDEXED
                  ACCESS MODE  IS DYNAMIC
                  RECORD KEY   IS EXTERNALLY-DESCRIBED-KEY
                               WITH DUPLICATES
                  FILE STATUS  IS FILE-STAT.

           SELECT CC-NOTE-MSTR
                  ASSIGN       TO DATABASE-MCFLMM2201
                  ORGANIZATION IS INDEXED
                  ACCESS MODE  IS DYNAMIC
                  RECORD KEY   IS EXTERNALLY-DESCRIBED-KEY
                  FILE STATUS  IS FILE-STAT.

           SELECT PLANNED-FILE
                  ASSIGN       TO DATABASE-MCFLMM1101
                  ORGANIZATION IS INDEXED
                  ACCESS MODE  IS DYNAMIC
                  RECORD KEY   IS EXTERNALLY-DESCRIBED-KEY
                               WITH DUPLICATES
                  FILE STATUS  IS FILE-STAT.

           SELECT PM-OPENQ-FILE
                  ASSIGN       TO DATABASE-MCFLMM3901
                  ORGANIZATION IS INDEXED
                  ACCESS MODE  IS DYNAMIC
                  RECORD KEY   IS EXTERNALLY-DESCRIBED-KEY
                               WITH DUPLICATES
                  FILE STATUS  IS FILE-STAT.

           SELECT PM-SCHEDULE
                  ASSIGN       TO DATABASE-MCFLMM4401
                  ORGANIZATION IS INDEXED
                  ACCESS MODE  IS DYNAMIC
                  RECORD KEY   IS EXTERNALLY-DESCRIBED-KEY
                               WITH DUPLICATES
                  FILE STATUS  IS FILE-STAT.

           SELECT PM-SIMULATOR
                  ASSIGN       TO DATABASE-MCFLMM4501
                  ORGANIZATION IS INDEXED
                  ACCESS MODE  IS DYNAMIC
                  RECORD KEY   IS EXTERNALLY-DESCRIBED-KEY
                               WITH DUPLICATES
                  FILE STATUS  IS FILE-STAT.

           SELECT PM-AUDIT
                  ASSIGN       TO DATABASE-MCFLMM4601
                  ORGANIZATION IS INDEXED
                  ACCESS MODE  IS DYNAMIC
                  RECORD KEY   IS EXTERNALLY-DESCRIBED-KEY
                               WITH DUPLICATES
                  FILE STATUS  IS FILE-STAT.

           SELECT SCHEDULE-FILE
                  ASSIGN       TO DATABASE-MCFLMM2302
                  ORGANIZATION IS INDEXED
                  ACCESS MODE  IS DYNAMIC
                  RECORD KEY   IS EXTERNALLY-DESCRIBED-KEY
                               WITH DUPLICATES
                  FILE STATUS  IS FILE-STAT.

           SELECT WO-OPENQ-FILE
                  ASSIGN       TO DATABASE-MCFLMM1902
                  ORGANIZATION IS INDEXED
                  ACCESS MODE  IS DYNAMIC
                  RECORD KEY   IS EXTERNALLY-DESCRIBED-KEY
                               WITH DUPLICATES
                  FILE STATUS  IS FILE-STAT.

           SELECT EQP-REFERENCE-FILE
                  ASSIGN       TO DATABASE-MCFLER0101
                  ORGANIZATION IS INDEXED
                  ACCESS MODE  IS DYNAMIC
                  RECORD KEY   IS EXTERNALLY-DESCRIBED-KEY
                  FILE STATUS  IS FILE-STAT.

           SELECT EQP-REMARKS-FILE
                  ASSIGN       TO DATABASE-MCFLER0301
                  ORGANIZATION IS INDEXED
                  ACCESS MODE  IS DYNAMIC
                  RECORD KEY   IS EXTERNALLY-DESCRIBED-KEY
                               WITH DUPLICATES
                  FILE STATUS  IS FILE-STAT.

           SELECT EQP-OPERATIONS-FILE
                  ASSIGN       TO DATABASE-MCFLER0501
                  ORGANIZATION IS INDEXED
                  ACCESS MODE  IS DYNAMIC
                  RECORD KEY   IS EXTERNALLY-DESCRIBED-KEY
                               WITH DUPLICATES
                  FILE STATUS  IS FILE-STAT.

           SELECT DRAWING-FILE
                  ASSIGN       TO DATABASE-MCFLDF0101
                  ORGANIZATION IS INDEXED
                  ACCESS MODE  IS DYNAMIC
                  RECORD KEY   IS EXTERNALLY-DESCRIBED-KEY
                               WITH DUPLICATES
                  FILE STATUS  IS FILE-STAT.

           SELECT WO-ZONE-PRTY
                  ASSIGN       TO DATABASE-MCFLMM0501
                  ORGANIZATION IS INDEXED
                  ACCESS MODE  IS DYNAMIC
                  RECORD KEY   IS EXTERNALLY-DESCRIBED-KEY
                  FILE STATUS  IS FILE-STAT.

           SELECT MASBMSG-LF
                  ASSIGN       TO DATABASE-MCFLMM4801
                  ORGANIZATION IS INDEXED
                  ACCESS MODE  IS DYNAMIC
                  RECORD KEY   IS EXTERNALLY-DESCRIBED-KEY
                  FILE STATUS  IS FILE-STAT.

           SELECT DISPLAY-FILE
                  ASSIGN       TO WORKSTATION-ZMASTER-SI
                  ORGANIZATION IS TRANSACTION
                  ACCESS MODE  IS DYNAMIC
                  RELATIVE KEY IS RECNO
                  FILE STATUS  IS SCREEN-STATUS
                               MAJOR-MINOR
                  CONTROL-AREA IS SCREEN-CONTROL.

       DATA DIVISION.
       FILE SECTION.
       FD  EQP-EQUIPMENT1
           LABEL RECORDS ARE STANDARD.
       01  EQP-REC1.
           COPY DDS-ALL-FORMATS OF MCFLMM0201.

       FD  EQP-EQUIPMENT2
           LABEL RECORDS ARE STANDARD.
       01  EQP-REC2.
           COPY DDS-ALL-FORMATS OF MCFLMM0201.

       FD  BASIC-FILE
           LABEL RECORDS ARE STANDARD
           DATA RECORD IS BFREC.
       01  BFREC.
           COPY DDS-ALL-FORMATS OF MCFLMM1001.

       FD  HOT-CODE-FILE
           LABEL RECORDS ARE STANDARD
           DATA RECORD IS HCFREC.
       01  HCFREC.
           COPY DDS-ALL-FORMATS OF MCFLMM2001.

       FD  CORP-CODE-LINK
           LABEL RECORDS ARE STANDARD
           DATA RECORD IS CCLREC.
       01  CCLREC.
           COPY DDS-ALL-FORMATS OF MCFLMM2101.

       FD  CC-NOTE-MSTR
           LABEL RECORDS ARE STANDARD
           DATA RECORD IS CMNREC.
       01  CMNREC.
           COPY DDS-ALL-FORMATS OF MCFLMM2201.

       FD  PLANNED-FILE
           LABEL RECORDS ARE STANDARD
           DATA RECORD IS PFREC.
       01  PFREC.
           COPY DDS-ALL-FORMATS OF MCFLMM1101.

       FD  PM-OPENQ-FILE
           LABEL RECORDS ARE STANDARD
           DATA RECORD IS POFREC.
       01  POFREC.
           COPY DDS-ALL-FORMATS OF MCFLMM3901.

       FD  PM-SCHEDULE
           LABEL RECORDS ARE STANDARD
           DATA RECORD IS PMSREC.
       01  PMSREC.
           COPY DDS-ALL-FORMATS OF MCFLMM4401.

       FD  PM-SIMULATOR
           LABEL RECORDS ARE STANDARD
           DATA RECORD IS PMSIMREC.
       01  PMSIMREC.
           COPY DDS-ALL-FORMATS OF MCFLMM4501.

       FD  PM-AUDIT
           LABEL RECORDS ARE STANDARD
           DATA RECORD IS PMAREC.
       01  PMAREC.
           COPY DDS-ALL-FORMATS OF MCFLMM4601.

       FD  SCHEDULE-FILE
           LABEL RECORDS ARE STANDARD
           DATA RECORD IS SFREC.
       01  SFREC.
           COPY DDS-ALL-FORMATS OF MCFLMM2302.

       FD  WO-OPENQ-FILE
           LABEL RECORDS ARE STANDARD
           DATA RECORD IS WOFREC.
       01  WOFREC.
           COPY DDS-ALL-FORMATS OF MCFLMM1902.

       FD  EQP-REFERENCE-FILE
           LABEL RECORDS ARE STANDARD
           DATA RECORD IS EQP-REF-RCD.
       01  EQP-REF-RCD.
           COPY DDS-ALL-FORMATS OF MCFLER0101.

       FD  EQP-REMARKS-FILE
           LABEL RECORDS ARE STANDARD
           DATA RECORD IS EQP-RMK-RCD.
       01  EQP-RMK-RCD.
           COPY DDS-ALL-FORMATS OF MCFLER0301.

       FD  EQP-OPERATIONS-FILE
           LABEL RECORDS ARE STANDARD
           DATA RECORD IS EQP-OPS-RCD.
       01  EQP-OPS-RCD.
           COPY DDS-ALL-FORMATS OF MCFLER0501.

       FD  DRAWING-FILE
           LABEL RECORDS ARE STANDARD
           DATA RECORD IS DRAW-RCD.
       01  DRAW-RCD.
           COPY DDS-ALL-FORMATS OF MCFLDF0101.

       FD  WO-ZONE-PRTY
           LABEL RECORDS ARE STANDARD.
       01  ZP-REC.
           COPY DDS-ALL-FORMATS OF MCFLMM0501.

       FD  MASBMSG-LF
           LABEL RECORDS ARE STANDARD.
       01  MASBMSGRCD-LF.
           COPY DDS-ALL-FORMATS OF MCFLMM4801.

       FD  DISPLAY-FILE
           LABEL RECORDS ARE OMITTED.
       01  DISPLAY-REC         PIC X(2000).

       WORKING-STORAGE SECTION.
       77  CHGTOADD-SW         PIC  X(01).
       77  MSG-SW              PIC  X(01).
       77  MSG-BUFFER          PIC  X(78).
       77  MESSAGE-BUFFER      PIC  X(76).
       77  EQP-KEY             PIC  X(06).
       77  FIRST-TIME-SW       PIC  9(04)  VALUE 1.
       77  REPEAT-SW           PIC  9(04)  VALUE 0.
           88  REPEAT-ON                   VALUE 1.
           88  REPEAT-OFF                  VALUE 0.
       77  RECNO               PIC  9999   VALUE 0.
       77  DISP-CNTR           PIC  99     VALUE 0.
       77  MOD-FLAG            PIC  9      VALUE 0.
       77  TRUE-VAL            PIC  1      VALUE B"1".
       77  NEG-VAL             PIC  1      VALUE B"0".

       01  PASSWORD-INFORMATION.
           05  NAME-OF-PROGRAM PIC  X(08) VALUE "TMEQP   ".
           05  PROGRAM-TYPE    PIC  X(02) VALUE "MA".
           05  PROGRAM-RELEASE PIC  X(12) VALUE " K0100010001".
           05  PROGRAM-DESCRIPTION.
               10  PROG-DESC-A PIC  X(60) VALUE
           "MAINTENANCE OF THE EQUIPMENT FILE IN THE MMIS DATABASE. ".
               10  PROG-DESC-B PIC  X(60) VALUE SPACES.
               10  PROG-FUNC   PIC  X(60) VALUE SPACES.
           05  PASSWORD-FLAG   PIC  X.

       01  FILE-STAT.
           05  FILE-STAT-1     PIC  X     VALUE "0".
           05  FILE-STAT-2     PIC  X     VALUE "0".

       01  SCREEN-MENU.
           05  ENUM-ADD        PIC  X(06).
           05  ENUM-CHG        PIC  X(06).
           05  ENUM-DEL        PIC  X(06).
           05  ENUM-DISP       PIC  X(06).
           05  MSGFLDM         PIC  X(78).
           05  CMDMSGM         PIC  X(79).
           05  ERRMSGM         PIC  X(79).

       01  SCREEN-ADD.
           05  ADD-SCREEN.
               10  ANUM        PIC  X(06).
               10  ATYPE       PIC  X(08).
               10  ADEPT       PIC  X(04).
               10  AZONE       PIC  X(04).
               10  ALOCATION   PIC  X(08).
               10  ARIME       PIC  X(01).
               10  AEXPCLASS   PIC  X(08).
               10  ADOWNCOST   PIC  X(06).
               10  ASAFETYFLG  PIC  X.
               10  AASBESTOSWRN PIC XX.
               10  ALOCALNAME  PIC  X(50).
               10  ACORPNAME   PIC  X(49).
           05  MSGFLDA         PIC  X(76).
           05  CMDMSGA         PIC  X(79).
           05  ERRMSGA         PIC  X(79).

       01  SCREEN-CHANGE.
           05  CHG-SCREEN.
               10  CNUM        PIC  X(06).
               10  CTYPE       PIC  X(08).
               10  CDEPT       PIC  X(04).
               10  CZONE       PIC  X(04).
               10  CLOCATION   PIC  X(08).
               10  CRIME       PIC  X(01).
               10  CEXPCLASS   PIC  X(08).
               10  CDOWNCOST   PIC  X(06).
               10  CSAFETYFLG  PIC  X.
               10  CASBESTOSWRN PIC XX.
               10  CLOCALNAME  PIC  X(50).
               10  CCORPNAME   PIC  X(49).
           05  MSGFLDC         PIC  X(76).
           05  CMDMSGC         PIC  X(79).
           05  ERRMSGC         PIC  X(79).

       01  SCREEN-DELETE.
           05  DEL-SCREEN.
               10  DNUM        PIC  X(06).
               10  DTYPE       PIC  X(08).
               10  DDEPT       PIC  X(04).
               10  DZONE       PIC  X(04).
               10  DLOCATION   PIC  X(08).
               10  DRIME       PIC  X(01).
               10  DEXPCLASS   PIC  X(08).
               10  DDOWNCOST   PIC  X(06).
               10  DSAFETYFLG  PIC  X.
               10  DASBESTOSWRN PIC XX.
               10  DLOCALNAME  PIC  X(50).
               10  DCORPNAME   PIC  X(49).
           05  CMDMSGD         PIC  X(79).
           05  ERRMSGD         PIC  X(79).

       01  SCREEN-OLDNEW.
           05  OLDNEW-SCREEN.
               10  ONUM        PIC  X(06).
               10  OTYPE       PIC  X(08).
               10  ODEPT       PIC  X(04).
               10  OZONE       PIC  X(04).
               10  OLOCATION   PIC  X(08).
               10  ORIME       PIC  X(01).
               10  OEXPCLASS   PIC  X(08).
               10  ODOWNCOST   PIC  X(06).
               10  OSAFETYFLG  PIC  X.
               10  OASBESTOSWRN PIC XX.
               10  OLOCALNAME  PIC  X(50).
               10  OCORPNAME   PIC  X(49).
               10  NNUM        PIC  X(06).
           05  MCHGMSG         PIC  X(76).
           05  CMDMSGMC        PIC  X(79).
           05  ERRMSGMC        PIC  X(79).

       01  SCREEN-TYPRIM.
           05  TYPRIM-SCREEN.
               10  TYPENU      PIC  X(08).
               10  RIMENU      PIC  X(01).
           05  CMDMSGMCR       PIC  X(79).
           05  ERRMSGMCR       PIC  X(79).

       01  SCREEN-DISPLAY.
           05  SNUM            PIC  X(06).
           05  STYPE           PIC  X(08).
           05  SDEPT           PIC  X(04).
           05  SZONE           PIC  X(04).
           05  SLOCATION       PIC  X(08).
           05  SRIME           PIC  X(01).
           05  SEXPCLASS       PIC  X(08).
           05  SDOWNCOST       PIC  X(06).
           05  SLOCALNAME      PIC  X(24).

       01  SCREEN-MSG.
           05  MSG1            PIC X(28)
                               VALUE "THE LOCAL EQUIPMENT NUMBER '".
           05  MSG2            PIC X(11) VALUE "' HAS BEEN ".
           05  MSG3            PIC X(20) VALUE "YOUR EQUIPMENT FILE.".
           05  MSGA            PIC X(09) VALUE "ADDED TO ".
           05  MSGC            PIC X(12) VALUE "MODIFIED IN ".
           05  MSGD            PIC X(13) VALUE "DELETED FROM ".

       01  ADJUST.
           05 ADJUST-8.
               10 A1           PIC  X.
               10 A2           PIC  X.
               10 ADJUST-6.
                   15 A3       PIC  X.
                   15 A4       PIC  X.
                   15 A5       PIC  X.
                   15 A6       PIC  X.
                   15 A7       PIC  X.
                   15 A8       PIC  X.

       01  RIME-FILL.
           05  RFFILL          PIC  X.
           05  RFRIME          PIC  X.

       01  ZONE-ARGUMENT.
           05  Z-ARG           PIC  X(04).
           05  FILLER          PIC  XX   VALUE "1 ".

       01  CORP-CODE-DATA.
           05  CC-EQP          PIC  X(06).
           05  FILLER          PIC  X(16).

       01  CORP-NOTE-DATA.
           05  CN-EQP          PIC  X(06).
           05  FILLER          PIC  X(112).

       01  MOD-FILE-MSGS.
           05  FILLER          PIC  X(31).
           05  MOD-FILE        PIC  X(12).
           05  FILLER          PIC  X(33).

       01  MOD-FILE-ERRS.
           10  FILLER          PIC  X(15).
           10  ERR-NAME        PIC  X(20).
           10  FILLER          PIC  X(35).
           10  ERR-NUM         PIC  X(09).

           COPY SCREENIO       IN COPYLIB.

           COPY MEQPREF        IN COPYLIB.

           COPY DEQPREM        IN COPYLIB.

           COPY DEQPOPS        IN COPYLIB.

           COPY MASBMSG        IN COPYLIB.

       01  EQUIPMENT-DATA.
           COPY MEQPFILE       IN COPYLIB.

       01  EQUIPMENT-DATA2.
           COPY MEQPFILE       IN COPYLIB.

       01  WO-BASIC-DATA.
           COPY DWOBASIC       IN COPYLIB.

       01  WO-PLANNED-DATA.
           COPY DWOPLAN        IN COPYLIB.

       01  WO-OPENQ-DATA.
           COPY DWOOPENQ       IN COPYLIB.

       01  HOT-CODE-DATA.
           COPY DHOTCODE       IN COPYLIB.

       01  WO-DRAWING-DATA.
           COPY DDRAWFIL       IN COPYLIB.

       01  SCHEDULE-DATA.
           COPY DWOSCHED       IN COPYLIB.

       01  PM-SCHED-DATA.
           COPY DPMSCHED       IN COPYLIB.

       01  PM-AUDIT-DATA.
           COPY DPMAUDIT       IN COPYLIB.

       01  PM-OPENQ-DATA.
           COPY DPMOPENQ       IN COPYLIB.

       01  ZONE-DATA.
           COPY MZONPRTY       IN COPYLIB.

       PROCEDURE DIVISION.
       OPEN-PARAGRAPH.
           MOVE SPACE          TO MSG-SW.
           OPEN I-O            DISPLAY-FILE.
           OPEN INPUT          EQP-EQUIPMENT1.
           OPEN I-O            EQP-EQUIPMENT2.
           OPEN INPUT          WO-ZONE-PRTY.
           OPEN INPUT          MASBMSG-LF.

           CALL "TPWORD"       USING PASSWORD-INFORMATION.
           IF PASSWORD-FLAG = "N"
               GO TO END-OF-JOB.

      *C****************************************************************
      *-- DISPLAY MAIN MENU/INPUT SCREEN (OR HELP/INPUT SCREEN)
      *C****************************************************************

       SETUP-MENU-SCREEN.
           MOVE "0"            TO RFFILL.
           MOVE SPACES         TO SCREEN-MENU
                                  SCREEN-ADD
                                  SCREEN-CHANGE
                                  SCREEN-DELETE
                                  SCREEN-OLDNEW
                                  SCREEN-TYPRIM.

           MOVE "EQPMENU"      TO SCREEN-NAME.

       SHOW-MENU-SCREEN.
           IF MSG-SW NOT = SPACE
               MOVE SPACE      TO MSG-SW
               MOVE MSG-BUFFER TO MSGFLDM
           ELSE
               MOVE SPACES     TO MSGFLDM.

           MOVE "00"           TO SCREEN-STATUS.
           MOVE  SCREEN-MENU   TO DISPLAY-REC.

           WRITE DISPLAY-REC   FORMAT IS SCREEN-NAME
                               INDIC ARE SCREEN-INDICATORS.
           IF SCREEN-STATUS NOT = "00"
               DISPLAY "SCREEN WRITE ERROR.  SCREEN-STATUS IS "
                               SCREEN-STATUS
               GO TO END-OF-JOB.

           READ  DISPLAY-FILE  FORMAT IS SCREEN-NAME
                               INDIC ARE SCREEN-INDICATORS
           IF SCREEN-STATUS NOT = "00"
               DISPLAY "SCREEN READ ERROR.  SCREEN-STATUS IS "
                               SCREEN-STATUS
               GO TO END-OF-JOB.

           MOVE ALL B"0"       TO SCREEN-INDICATORS.
           MOVE DISPLAY-REC    TO SCREEN-MENU.

           IF KEY-HIT = 3 OR 8
               GO TO END-OF-JOB.

           IF KEY-HIT = 9
               GO TO SETUP-MENU-SCREEN.

           IF KEY-HIT = 1 OR 2 OR 4 OR 5 OR 6 OR 7
               GO TO READ-SCREEN-CONT.

      *C****************************************************************
      *-- DETERMINE IF ONLY ONE FIELD IS FILLED AND SET FUNCTION KEY
      *-- SO 'ENTER' KEY WILL FUNCTION FOR THAT FIELD ONLY.
      *C****************************************************************

           MOVE  0             TO DISP-CNTR.
           IF ENUM-ADD NOT = SPACES
               ADD 1           TO DISP-CNTR.

           IF ENUM-CHG NOT = SPACES
               ADD 3           TO DISP-CNTR.

           IF ENUM-DEL NOT = SPACES
               ADD 5           TO DISP-CNTR.

           IF ENUM-DISP NOT = SPACES
               ADD 7           TO DISP-CNTR.

      *C****************************************************************
      *-- IF MORE THAN ONE FIELD IS FILLED, DISPLAY ERROR DESIGNATING
      *-- THAT USER PRESS THE DESIRED FUNCTION KEY.
      *C****************************************************************

           IF DISP-CNTR = 1 OR 3 OR 5 OR 7
               NEXT SENTENCE
           ELSE
      *M****************************************************************
      *M  PRESS APPROPRIATE FUNCTION KEY TO CONTINUE
      *M****************************************************************
               MOVE "PRESS APPROPRIATE FUNCTION KEY TO CONTINUE"
                               TO ERRMSGM
               MOVE TRUE-VAL   TO IND(99)
               GO TO SHOW-MENU-SCREEN.

           IF DISP-CNTR = 1
               MOVE 1          TO KEY-HIT
           ELSE
           IF DISP-CNTR = 3
               MOVE 2          TO KEY-HIT
           ELSE
           IF DISP-CNTR = 5
               MOVE 4          TO KEY-HIT
           ELSE
           IF DISP-CNTR = 7
               MOVE 5          TO KEY-HIT.

      *C****************************************************************
      *-- EDIT FIELDS FILLED AND DETERMINE VALID INPUT FOR FUNCTION
      *-- REQUESTED.  IF VALID, PERFORM FUNCTION.
      *C****************************************************************

       READ-SCREEN-CONT.
           IF KEY-HIT = 1
               IF ENUM-ADD = SPACES
      *M********************************************************************
      *M EQUIPMENT NUMBER IS REQUIRED
      *M********************************************************************
                   MOVE "EQUIPMENT NUMBER IS REQUIRED"
                                 TO ERRMSGM
                   MOVE TRUE-VAL TO IND(1) IND(99)
                   GO TO SHOW-MENU-SCREEN
               ELSE
                   MOVE ENUM-ADD TO EQP-KEY
                   PERFORM CHECK-EQPNUM THRU CHECK-EQPNUM-EXIT
                   IF FILE-STAT = "23"
                       PERFORM ADD-EQPNUM THRU ADD-EQPNUM-EXIT
                       GO TO SETUP-MENU-SCREEN
                   ELSE
                   IF FILE-STAT = "00"
      *M********************************************************************
      *M EQUIPMENT NUMBER ALREADY EXISTS
      *M********************************************************************
                       MOVE "EQUIPMENT NUMBER ALREADY EXISTS"
                                       TO ERRMSGM
                       MOVE TRUE-VAL   TO IND(1) IND(99)
                       GO TO SHOW-MENU-SCREEN
                   ELSE
                       MOVE MESSAGE-BUFFER TO ERRMSGM
                       MOVE TRUE-VAL   TO IND(1) IND(99)
                       GO TO SHOW-MENU-SCREEN.

           IF KEY-HIT = 2
               MOVE 0            TO CHGTOADD-SW
               IF ENUM-CHG = SPACES
      *M********************************************************************
      *M EQUIPMENT NUMBER IS REQUIRED
      *M********************************************************************
                   MOVE "EQUIPMENT NUMBER IS REQUIRED"
                                 TO ERRMSGM
                   MOVE TRUE-VAL TO IND(2) IND(99)
                   GO TO SHOW-MENU-SCREEN
               ELSE
                   MOVE ENUM-CHG TO EQP-KEY
                   PERFORM CHECK-EQPNUM THRU CHECK-EQPNUM-EXIT
                   IF FILE-STAT = "00"
                       PERFORM CHG-EQPNUM THRU CHG-EQPNUM-EXIT
                       GO TO SETUP-MENU-SCREEN
                   ELSE
                   IF FILE-STAT = "23"
      *M********************************************************************
      *M INVALID EQUIPMENT NUMBER
      *M********************************************************************
                       MOVE "INVALID EQUIPMENT NUMBER"
                                       TO ERRMSGM
                       MOVE TRUE-VAL   TO IND(2) IND(99)
                       GO TO SHOW-MENU-SCREEN
                   ELSE
                       MOVE MESSAGE-BUFFER TO ERRMSGM
                       MOVE TRUE-VAL   TO IND(2) IND(99)
                       GO TO SHOW-MENU-SCREEN.

           IF KEY-HIT = 4
               IF ENUM-DEL = SPACES
      *M********************************************************************
      *M EQUIPMENT NUMBER IS REQUIRED
      *M********************************************************************
                   MOVE "EQUIPMENT NUMBER IS REQUIRED"
                                 TO ERRMSGM
                   MOVE TRUE-VAL TO IND(3) IND(99)
                   GO TO SHOW-MENU-SCREEN
               ELSE
                   MOVE ENUM-DEL TO EQP-KEY
                   PERFORM CHECK-EQPNUM THRU CHECK-EQPNUM-EXIT
                   IF FILE-STAT = "00"
                       PERFORM DEL-EQPNUM THRU DEL-EQPNUM-EXIT
                       GO TO SETUP-MENU-SCREEN
                   ELSE
                   IF FILE-STAT = "23"
      *M********************************************************************
      *M INVALID EQUIPMENT NUMBER
      *M********************************************************************
                       MOVE "INVALID EQUIPMENT NUMBER"
                                     TO ERRMSGM
                       MOVE TRUE-VAL TO IND(3) IND(99)
                       GO TO SHOW-MENU-SCREEN
                   ELSE
                       MOVE MESSAGE-BUFFER TO ERRMSGM
                       MOVE TRUE-VAL   TO IND(3) IND(99)
                       GO TO SHOW-MENU-SCREEN.

           IF KEY-HIT = 5
               PERFORM DISP-EQPNUM THRU DISP-EQPNUM-EXIT
               GO TO SETUP-MENU-SCREEN.

           IF KEY-HIT = 6
               PERFORM MCHG-OPTIONS THRU MCHG-OPTIONS-X
               GO TO SETUP-MENU-SCREEN.

           IF KEY-HIT = 7
               MOVE "EQPHELP"  TO SCREEN-NAME
               GO TO SHOW-MENU-SCREEN.

           GO TO SETUP-MENU-SCREEN.

       ADD-EQPNUM.
      *C****************************************************************
      *--    >>  ADD EQUIPMENT RECORD TO FILE  <<
      *--  ADD-EQPNUM EDITS FOR VALID INPUT AND WRITES AN EQUIPMENT
      *--  RECORD TO THE EQP-EQUIPMENT FILE (MCFPMM0200) ONLY.
      *C****************************************************************

           MOVE "EQPADD"       TO SCREEN-NAME.
           MOVE 0              TO REPEAT-SW.
           MOVE 1              TO FIRST-TIME-SW.
           MOVE ENUM-ADD       TO ANUM.
           MOVE "6"            TO ARIME.

       SHOW-ADD-SCREEN.
           MOVE "00"           TO SCREEN-STATUS.
           IF REPEAT-ON
               MOVE "EQPREPT"  TO SCREEN-NAME
               MOVE TRUE-VAL   TO IND(40).

           IF REPEAT-ON AND IND(99) = NEG-VAL
               MOVE SPACES     TO ANUM.

           IF REPEAT-ON AND FIRST-TIME-SW = 1
      *        MOVE TRUE-VAL   TO IND(2)
               MOVE ENUM-ADD   TO ANUM.

           MOVE  SCREEN-ADD    TO DISPLAY-REC.
           WRITE DISPLAY-REC   FORMAT IS SCREEN-NAME
                               INDIC ARE SCREEN-INDICATORS.
           IF SCREEN-STATUS NOT = "00"
               DISPLAY "SCREEN WRITE ERROR.  SCREEN-STATUS IS "
                               SCREEN-STATUS
               GO TO END-OF-JOB.

           READ  DISPLAY-FILE  FORMAT IS SCREEN-NAME
                               INDIC ARE SCREEN-INDICATORS
           IF SCREEN-STATUS NOT = "00"
               DISPLAY "SCREEN READ ERROR.  SCREEN-STATUS IS "
                               SCREEN-STATUS
               GO TO END-OF-JOB.

           MOVE ALL B"0"       TO SCREEN-INDICATORS.
           MOVE DISPLAY-REC    TO SCREEN-ADD.
           IF CHGTOADD-SW = 1
               MOVE ANUM       TO ENUM-ADD.

           IF KEY-HIT = 3 OR 8
               GO TO END-OF-JOB.

           IF KEY-HIT = 1
               GO TO ADD-EQPNUM-EXIT.

           IF KEY-HIT = 4
               MOVE 1          TO REPEAT-SW
               GO TO SHOW-ADD-SCREEN.

           IF KEY-HIT = 7
               PERFORM HELP-SCREENS THRU HELP-SCREENS-EXIT
               MOVE "EQPADD"       TO SCREEN-NAME
               GO TO SHOW-ADD-SCREEN.

           IF CHGTOADD-SW = 1
               NEXT SENTENCE
           ELSE
           IF REPEAT-OFF
               GO TO EDIT-DATA.

           IF ANUM = SPACES
      *M********************************************************************
      *M EQUIPMENT NUMBER IS REQUIRED
      *M********************************************************************
               MOVE "EQUIPMENT NUMBER IS REQUIRED"
                             TO ERRMSGA
               MOVE TRUE-VAL TO IND(1) IND(99)
               GO TO SHOW-ADD-SCREEN.

           MOVE ANUM           TO EQP-KEY.
           PERFORM CHECK-EQPNUM THRU CHECK-EQPNUM-EXIT.
           IF FILE-STAT = "23"
               NEXT SENTENCE
           ELSE
           IF FILE-STAT = "00"
      *M********************************************************************
      *M EQUIPMENT NUMBER ALREADY EXISTS
      *M********************************************************************
               MOVE "EQUIPMENT NUMBER ALREADY EXISTS"
                               TO ERRMSGA
               MOVE TRUE-VAL   TO IND(1) IND(99)
               GO TO SHOW-ADD-SCREEN.

       EDIT-DATA.
           IF AZONE = SPACES
      **********************************************************************
      ** ZONE IS REQUIRED
      **********************************************************************
               MOVE "ZONE IS REQUIRED"
                               TO ERRMSGA
               MOVE TRUE-VAL   TO IND(14) IND(99)
               GO TO SHOW-ADD-SCREEN.

           MOVE AZONE          TO Z-ARG.
           MOVE ZONE-ARGUMENT  TO ZONEPRTY OF WO-ZONE-PRTY.
           READ WO-ZONE-PRTY   INTO ZONE-DATA
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
      **********************************************************************
      ** INVALID ZONE
      **********************************************************************
               MOVE "INVALID ZONE"
                               TO ERRMSGA
               MOVE TRUE-VAL   TO IND(14) IND(99)
               GO TO SHOW-ADD-SCREEN.

           IF ARIME = "1" OR "2" OR "3" OR
                      "4" OR "5" OR "6" OR
                      "7" OR "8" OR "9"
               NEXT SENTENCE
           ELSE
      *M****************************************************************
      *M  RIME MUST BE A VALUE FROM 1 TO 9
      *M****************************************************************
               MOVE "RIME MUST BE A VALUE FROM 1 TO 9"
                               TO ERRMSGA
               MOVE TRUE-VAL   TO IND(16) IND(99)
               GO TO SHOW-ADD-SCREEN.

           MOVE AEXPCLASS      TO ADJUST-8.
           PERFORM ADJUST-EIGHT UNTIL A8 NOT = SPACE.
           MOVE ADJUST-8       TO AEXPCLASS.

           IF AEXPCLASS NOT NUMERIC
      *M****************************************************************
      *M  INVALID EXPENSE CLASS
      *M****************************************************************
               MOVE "INVALID EXPENSE CLASS"
                               TO ERRMSGA
               MOVE TRUE-VAL   TO IND(17) IND(99)
               GO TO SHOW-ADD-SCREEN.

           IF AEXPCLASS = ZEROS
      *M****************************************************************
      *M  INVALID EXPENSE CLASS
      *M****************************************************************
               MOVE "INVALID EXPENSE CLASS"
                               TO ERRMSGA
               MOVE TRUE-VAL   TO IND(17) IND(99)
               GO TO SHOW-ADD-SCREEN.

           IF ADOWNCOST NOT = SPACES
               MOVE ADOWNCOST  TO ADJUST-6
               PERFORM ADJUST-SIX UNTIL A8 NOT = SPACE
               MOVE ADJUST-6   TO ADOWNCOST.

           IF ADOWNCOST = SPACES OR ADOWNCOST NUMERIC
               NEXT SENTENCE
           ELSE
      *M****************************************************************
      *M  INVALID DOWN COST
      *M****************************************************************
               MOVE "INVALID DOWN COST"
                               TO ERRMSGA
               MOVE TRUE-VAL   TO IND(18) IND(99)
               GO TO SHOW-ADD-SCREEN.

           IF ASAFETYFLG = "X" OR SPACES
               NEXT SENTENCE
           ELSE
               MOVE SPACES     TO ASAFETYFLG.

           IF AASBESTOSWRN NOT = SPACES
              READ MASBMSG-LF  FIRST INTO BUF-MASBMSG
                  AT END       MOVE FILE-STAT TO FILE-STAT
              END-READ
              IF FILE-STAT = "00"
                  MOVE SPACES  TO MASBMSGRCD-LF
                  MOVE AASBESTOSWRN TO MSGCODE OF MASBMSGRCD-LF
                  READ MASBMSG-LF INTO BUF-MASBMSG
                      INVALID KEY MOVE FILE-STAT TO FILE-STAT
                  END-READ
                  IF FILE-STAT NOT = "00"
      *M****************************************************************
      *M  NO RECORDS FOUND WHICH MATCH YOUR SELECTION
      *M****************************************************************
                       MOVE
                       "NO RECORDS FOUND WHICH MATCH YOUR SELECTION"
                                     TO ERRMSGA
                       MOVE TRUE-VAL TO IND(23) IND(99)
                       GO TO SHOW-ADD-SCREEN.

           MOVE SPACES         TO EQUIPMENT-DATA.
           MOVE ANUM           TO EQP-EQUIP-NUM    OF EQUIPMENT-DATA.
           MOVE ATYPE          TO EQP-TYPE         OF EQUIPMENT-DATA.
           MOVE ADEPT          TO EQP-DEPT         OF EQUIPMENT-DATA.
           MOVE AZONE          TO EQP-MAINT-ZONE   OF EQUIPMENT-DATA.
           MOVE ALOCATION      TO EQP-LOCATION     OF EQUIPMENT-DATA.
           MOVE ARIME          TO RFRIME.
           MOVE RIME-FILL      TO EQP-RIME         OF EQUIPMENT-DATA.
           MOVE AEXPCLASS      TO EQP-EXP-CLASS    OF EQUIPMENT-DATA.
           MOVE ADOWNCOST      TO EQP-DOWN-COST    OF EQUIPMENT-DATA.
           MOVE ASAFETYFLG     TO EQP-SAFETY-FLG   OF EQUIPMENT-DATA.
           MOVE AASBESTOSWRN   TO EQP-ASBESTOS-FLG OF EQUIPMENT-DATA.
           MOVE ALOCALNAME     TO EQP-EQUIP-NAME   OF EQUIPMENT-DATA.
           MOVE ACORPNAME      TO EQP-CORP-DESC    OF EQUIPMENT-DATA.

           WRITE EQP-REC2      FROM EQUIPMENT-DATA
               INVALID KEY
      *M****************************************************************
      *M  ADD FAILED
      *M****************************************************************
                   MOVE "ADD FAILED"
                                 TO ERRMSGA
                   MOVE TRUE-VAL TO IND(99)
                   GO TO SHOW-ADD-SCREEN.

           MOVE 0              TO FIRST-TIME-SW.
           IF REPEAT-ON
               GO TO SHOW-ADD-SCREEN.

           MOVE "X"            TO MSG-SW.
           MOVE SPACES         TO MSG-BUFFER.
           STRING MSG1 ENUM-ADD MSG2 MSGA MSG3
                               DELIMITED BY SIZE
                               INTO MSG-BUFFER.

           IF CHGTOADD-SW = 1
               MOVE 0          TO CHGTOADD-SW
               GO TO CHG-EQPNUM-EXIT.

       ADD-EQPNUM-EXIT.        EXIT.

       CHG-EQPNUM.
      *C****************************************************************
      *--    >>  CHANGE EQUIPMENT RECORD IN FILE  <<
      *--  CHG-EQPNUM EDITS FOR VALID INPUT AND MODIFIES THE EQUIPMENT
      *--  RECORD IN THE EQP-EQUIPMENT FILE (MCFPMM0200) AND ALSO
      *--  MODIFIES ALL ASSOCIATED FILES WHICH INCLUDE THE DATA CHANGED.
      *C****************************************************************

           MOVE "EQPCHANGE"    TO SCREEN-NAME.

           MOVE EQP-EQUIP-NUM    OF EQUIPMENT-DATA  TO  CNUM.
           MOVE EQP-TYPE         OF EQUIPMENT-DATA  TO  CTYPE.
           MOVE EQP-DEPT         OF EQUIPMENT-DATA  TO  CDEPT.
           MOVE EQP-MAINT-ZONE   OF EQUIPMENT-DATA  TO  CZONE.
           MOVE EQP-LOCATION     OF EQUIPMENT-DATA  TO  CLOCATION.
           MOVE EQP-RIME         OF EQUIPMENT-DATA  TO  RIME-FILL.
           MOVE RFRIME                              TO  CRIME.
           MOVE EQP-EXP-CLASS    OF EQUIPMENT-DATA  TO  CEXPCLASS.
           MOVE EQP-DOWN-COST    OF EQUIPMENT-DATA  TO  CDOWNCOST.
           MOVE EQP-SAFETY-FLG   OF EQUIPMENT-DATA  TO  CSAFETYFLG.
           MOVE EQP-ASBESTOS-FLG OF EQUIPMENT-DATA  TO  CASBESTOSWRN.
           MOVE EQP-EQUIP-NAME   OF EQUIPMENT-DATA  TO  CLOCALNAME.
           MOVE EQP-CORP-DESC    OF EQUIPMENT-DATA  TO  CCORPNAME.

       SHOW-CHANGE-SCREEN.
           MOVE "00"           TO SCREEN-STATUS.
           MOVE  SCREEN-CHANGE TO DISPLAY-REC.

           WRITE DISPLAY-REC   FORMAT IS SCREEN-NAME
                               INDIC ARE SCREEN-INDICATORS.
           IF SCREEN-STATUS NOT = "00"
               DISPLAY "SCREEN WRITE ERROR.  SCREEN-STATUS IS "
                               SCREEN-STATUS
               GO TO END-OF-JOB.

           READ  DISPLAY-FILE  FORMAT IS SCREEN-NAME
                               INDIC ARE SCREEN-INDICATORS
           IF SCREEN-STATUS NOT = "00"
               DISPLAY "SCREEN READ ERROR.  SCREEN-STATUS IS "
                               SCREEN-STATUS
               GO TO END-OF-JOB.

           MOVE ALL B"0"       TO SCREEN-INDICATORS.
           MOVE DISPLAY-REC    TO SCREEN-CHANGE.

           IF KEY-HIT = 3 OR 8
             GO TO END-OF-JOB.

           IF KEY-HIT = 1
               GO TO CHG-EQPNUM-EXIT.

           IF KEY-HIT = 6
               MOVE "EQPADD1"      TO SCREEN-NAME
               MOVE 0              TO REPEAT-SW
               MOVE 1              TO FIRST-TIME-SW
               MOVE 1              TO CHGTOADD-SW
               MOVE SCREEN-CHANGE  TO SCREEN-ADD
               MOVE "      "       TO ANUM
               GO TO SHOW-ADD-SCREEN.

           IF KEY-HIT = 7
               MOVE "EQPHMNU"      TO SCREEN-NAME
               WRITE DISPLAY-REC   FORMAT IS SCREEN-NAME
                                   INDIC ARE SCREEN-INDICATORS
               END-WRITE
               IF SCREEN-STATUS NOT = "00"
                   DISPLAY "SCREEN WRITE ERROR.  SCREEN-STATUS IS "
                                   SCREEN-STATUS
                   GO TO END-OF-JOB
               END-IF
               READ  DISPLAY-FILE  FORMAT IS SCREEN-NAME
                                   INDIC ARE SCREEN-INDICATORS
               IF SCREEN-STATUS NOT = "00"
                   DISPLAY "SCREEN READ ERROR.  SCREEN-STATUS IS "
                                   SCREEN-STATUS
                   GO TO END-OF-JOB
               END-IF
               MOVE ALL B"0"       TO SCREEN-INDICATORS
               MOVE "EQPCHANGE"    TO SCREEN-NAME
               GO TO SHOW-CHANGE-SCREEN.

           IF CZONE = SPACES
      **********************************************************************
      ** ZONE IS REQUIRED
      **********************************************************************
               MOVE "ZONE IS REQUIRED"
                               TO ERRMSGC
               MOVE TRUE-VAL   TO IND(14) IND(99)
               GO TO SHOW-CHANGE-SCREEN.

           MOVE CZONE          TO Z-ARG.
           MOVE ZONE-ARGUMENT  TO ZONEPRTY OF WO-ZONE-PRTY.
           READ WO-ZONE-PRTY   INTO ZONE-DATA
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
      **********************************************************************
      ** INVALID ZONE
      **********************************************************************
               MOVE "INVALID ZONE"
                               TO ERRMSGC
               MOVE TRUE-VAL   TO IND(14) IND(99)
               GO TO SHOW-CHANGE-SCREEN.

           IF CRIME = "1" OR "2" OR "3" OR
                      "4" OR "5" OR "6" OR
                      "7" OR "8" OR "9"
               NEXT SENTENCE
           ELSE
      *M****************************************************************
      *M  RIME MUST BE A VALUE FROM 1 TO 9
      *M****************************************************************
               MOVE "RIME MUST BE A VALUE FROM 1 TO 9"
                               TO ERRMSGC
               MOVE TRUE-VAL   TO IND(16) IND(99)
               GO TO SHOW-CHANGE-SCREEN.

           MOVE CEXPCLASS      TO ADJUST-8.
           PERFORM ADJUST-EIGHT UNTIL A8 NOT = SPACE.
           MOVE ADJUST-8       TO CEXPCLASS.

           IF CEXPCLASS NOT NUMERIC
      *M****************************************************************
      *M  INVALID EXPENSE CLASS
      *M****************************************************************
               MOVE "INVALID EXPENSE CLASS"
                               TO ERRMSGC
               MOVE TRUE-VAL   TO IND(17) IND(99)
               GO TO SHOW-CHANGE-SCREEN.

           IF CEXPCLASS = ZEROS
      *M****************************************************************
      *M  INVALID EXPENSE CLASS
      *M****************************************************************
               MOVE "INVALID EXPENSE CLASS"
                               TO ERRMSGC
               MOVE TRUE-VAL   TO IND(17) IND(99)
               GO TO SHOW-CHANGE-SCREEN.

           IF CDOWNCOST NOT = SPACES
               MOVE CDOWNCOST  TO ADJUST-6
               PERFORM ADJUST-SIX UNTIL A8 NOT = SPACE
               MOVE ADJUST-6   TO CDOWNCOST.

           IF CDOWNCOST = SPACES OR CDOWNCOST NUMERIC
               NEXT SENTENCE
           ELSE
      *M****************************************************************
      *M  INVALID DOWN COST
      *M****************************************************************
               MOVE "INVALID DOWN COST"
                               TO ERRMSGC
               MOVE TRUE-VAL   TO IND(18) IND(99)
               GO TO SHOW-CHANGE-SCREEN.

           IF CSAFETYFLG = "X" OR SPACES
               NEXT SENTENCE
           ELSE
               MOVE SPACES     TO CSAFETYFLG.

           IF CASBESTOSWRN NOT = SPACES
              READ MASBMSG-LF  FIRST INTO BUF-MASBMSG
                  AT END       MOVE FILE-STAT TO FILE-STAT
              END-READ
              IF FILE-STAT = "00"
                  MOVE SPACES  TO MASBMSGRCD-LF
                  MOVE CASBESTOSWRN TO MSGCODE OF MASBMSGRCD-LF
                  READ MASBMSG-LF INTO BUF-MASBMSG
                      INVALID KEY MOVE FILE-STAT TO FILE-STAT
                  END-READ
                  IF FILE-STAT NOT = "00"
      *M****************************************************************
      *M  NO RECORDS FOUND WHICH MATCH YOUR SELECTION
      *M****************************************************************
                       MOVE
                       "NO RECORDS FOUND WHICH MATCH YOUR SELECTION"
                                     TO ERRMSGC
                       MOVE TRUE-VAL TO IND(23) IND(99)
                       GO TO SHOW-CHANGE-SCREEN.

           MOVE CNUM           TO EQPNUM OF EQP-REC2.
           READ EQP-EQUIPMENT2 INTO EQUIPMENT-DATA
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
               MOVE "CHANGE FAILED"
                               TO ERRMSGC
               MOVE TRUE-VAL   TO IND(99)
               GO TO SHOW-CHANGE-SCREEN.

      *C****************************************************************
      *--  CHECK TO SEE IF FIELDS WHICH EXIST IN OTHER ASSOCIATED FILES
      *--  HAVE BEEN CHANGED ON THE EQUIPMENT RECORD.  IF SO, SET A FLAG
      *--  TO INITIATE CHANGES TO THOSE FILES ALSO.
      *C****************************************************************

           MOVE 0              TO MOD-FLAG.
           IF CTYPE      NOT = EQP-TYPE       OF EQUIPMENT-DATA
               MOVE 1          TO MOD-FLAG.
           IF CDEPT      NOT = EQP-DEPT       OF EQUIPMENT-DATA
               MOVE 1          TO MOD-FLAG.
           IF CZONE      NOT = EQP-MAINT-ZONE OF EQUIPMENT-DATA
               MOVE 1          TO MOD-FLAG.
           IF CLOCATION  NOT = EQP-LOCATION   OF EQUIPMENT-DATA
               MOVE 1          TO MOD-FLAG.
           MOVE CRIME          TO RFRIME.
           IF RIME-FILL  NOT = EQP-RIME       OF EQUIPMENT-DATA
               MOVE 1          TO MOD-FLAG.
           IF CEXPCLASS  NOT = EQP-EXP-CLASS  OF EQUIPMENT-DATA
               MOVE 1          TO MOD-FLAG.
           IF CLOCALNAME NOT = EQP-EQUIP-NAME OF EQUIPMENT-DATA
               MOVE 1          TO MOD-FLAG.

           MOVE EQUIPMENT-DATA TO EQUIPMENT-DATA2.
           MOVE CTYPE          TO EQP-TYPE         OF EQUIPMENT-DATA2.
           MOVE CDEPT          TO EQP-DEPT         OF EQUIPMENT-DATA2.
           MOVE CZONE          TO EQP-MAINT-ZONE   OF EQUIPMENT-DATA2.
           MOVE CLOCATION      TO EQP-LOCATION     OF EQUIPMENT-DATA2.
           MOVE CRIME          TO RFRIME.
           MOVE RIME-FILL      TO EQP-RIME         OF EQUIPMENT-DATA2.
           MOVE CEXPCLASS      TO EQP-EXP-CLASS    OF EQUIPMENT-DATA2.
           MOVE CDOWNCOST      TO EQP-DOWN-COST    OF EQUIPMENT-DATA2.
           MOVE CSAFETYFLG     TO EQP-SAFETY-FLG   OF EQUIPMENT-DATA2.
           MOVE CASBESTOSWRN   TO EQP-ASBESTOS-FLG OF EQUIPMENT-DATA2.
           MOVE CLOCALNAME     TO EQP-EQUIP-NAME   OF EQUIPMENT-DATA2.
           MOVE CCORPNAME      TO EQP-CORP-DESC    OF EQUIPMENT-DATA2.

           REWRITE EQP-REC2    FROM EQUIPMENT-DATA2
               INVALID KEY
                   MOVE "CHANGE FAILED"
                                   TO ERRMSGC
                   MOVE TRUE-VAL   TO IND(99)
                   GO TO SHOW-CHANGE-SCREEN.

      *C****************************************************************
      *--  IF FIELDS WHICH EXIST IN OTHER ASSOCIATED FILES HAVE BEEN
      *--  CHANGED ON THE EQUIPMENT RECORD, A FLAG WILL INITIATE CHANGES
      *--  TO THOSE FILES ALSO.
      *C****************************************************************

           IF MOD-FLAG NOT = 0
               MOVE "EQPMASSCHG"    TO SCREEN-NAME
               MOVE SPACES          TO SCREEN-OLDNEW
                                       CMDMSGC ERRMSGC
               MOVE SCREEN-CHANGE   TO SCREEN-OLDNEW
               MOVE ONUM            TO NNUM
               PERFORM MOD-FUNCTION THRU MOD-FUNCTION-EXIT.

           MOVE "X"            TO MSG-SW.
           MOVE SPACES         TO MSG-BUFFER.
           STRING MSG1 ENUM-CHG MSG2 MSGC MSG3
                               DELIMITED BY SIZE
                               INTO MSG-BUFFER.

       CHG-EQPNUM-EXIT.        EXIT.

       HELP-SCREENS.
           MOVE "EQPHMNU"      TO SCREEN-NAME.

       HELP-SHOWFORM.
           MOVE ALL B"0"       TO SCREEN-INDICATORS.
           WRITE DISPLAY-REC   FORMAT IS SCREEN-NAME
                               INDIC ARE SCREEN-INDICATORS.
           IF SCREEN-STATUS NOT = "00"
               DISPLAY "SCREEN WRITE ERROR.  SCREEN-STATUS IS "
                               SCREEN-STATUS
               GO TO END-OF-JOB.
           READ  DISPLAY-FILE  FORMAT IS SCREEN-NAME
                               INDIC ARE SCREEN-INDICATORS.
           IF SCREEN-STATUS NOT = "00"
               DISPLAY "SCREEN READ ERROR.  SCREEN-STATUS IS "
                               SCREEN-STATUS
               GO TO END-OF-JOB.

           IF KEY-HIT = 1
               IF SCREEN-NAME = "EQPHMNU"
                   MOVE "EQPHTYP" TO SCREEN-NAME
                   GO TO HELP-SHOWFORM
               ELSE
                   GO TO HELP-SCREENS.

           IF KEY-HIT = 2
               IF SCREEN-NAME = "EQPHMNU"
                   MOVE "EQPHZON" TO SCREEN-NAME
                   GO TO HELP-SHOWFORM
               ELSE
                   GO TO HELP-SCREENS.

           IF KEY-HIT = 3
               IF SCREEN-NAME = "EQPHMNU"
                   MOVE "EQPHRIM" TO SCREEN-NAME
                   GO TO HELP-SHOWFORM
               ELSE
                   GO TO HELP-SCREENS.

           IF KEY-HIT = 4
               IF SCREEN-NAME = "EQPHMNU"
                   MOVE "EQPHEXP" TO SCREEN-NAME
                   GO TO HELP-SHOWFORM
               ELSE
                   GO TO HELP-SCREENS.

           IF KEY-HIT = 5
               IF SCREEN-NAME = "EQPHMNU"
                   MOVE "EQPHCST" TO SCREEN-NAME
                   GO TO HELP-SHOWFORM
               ELSE
                   GO TO HELP-SCREENS.

           IF KEY-HIT = 6
               IF SCREEN-NAME = "EQPHMNU"
                   MOVE "EQPHSAF" TO SCREEN-NAME
                   GO TO HELP-SHOWFORM
               ELSE
                   GO TO HELP-SCREENS.

           IF KEY-HIT = 7
               IF SCREEN-NAME = "EQPHMNU"
                   MOVE "EQPHASB" TO SCREEN-NAME
                   GO TO HELP-SHOWFORM
               ELSE
                   GO TO HELP-SCREENS.

           IF KEY-HIT = 8
               IF SCREEN-NAME = "EQPHMNU"
                   MOVE "EQPHDES" TO SCREEN-NAME
                   GO TO HELP-SHOWFORM
               ELSE
                   GO TO HELP-SCREENS.

           IF KEY-HIT = 0
               IF SCREEN-NAME NOT = "EQPHMNU"
                   GO TO HELP-SCREENS.

       HELP-SCREENS-EXIT.      EXIT.

       DEL-EQPNUM.
      *C****************************************************************
      *--    >>  DELETE EQUIPMENT RECORD IN FILE  <<
      *--  DEL-EQPNUM DELETES THE EQUIPMENT RECORD FROM THE EQP-EQUIPMENT
      *--  FILE (MCFPMM0200) BUT DOES NOT DELETE ASSOCIATED RECORDS IN
      *--  OTHER FILES.  NO NEW ASSOCIATED RECORDS MAY BE CREATED LINKED
      *--  TO THE OLD (DELETED) EQUIPMENT RECORD.
      *C****************************************************************

           MOVE "EQPDELETE"        TO SCREEN-NAME.
           MOVE EQP-EQUIP-NUM      OF EQUIPMENT-DATA  TO  DNUM.
           MOVE EQP-TYPE           OF EQUIPMENT-DATA  TO  DTYPE.
           MOVE EQP-DEPT           OF EQUIPMENT-DATA  TO  DDEPT.
           MOVE EQP-MAINT-ZONE     OF EQUIPMENT-DATA  TO  DZONE.
           MOVE EQP-LOCATION       OF EQUIPMENT-DATA  TO  DLOCATION.
           MOVE EQP-RIME           OF EQUIPMENT-DATA  TO  RIME-FILL.
           MOVE RFRIME                                TO  DRIME.
           MOVE EQP-EXP-CLASS      OF EQUIPMENT-DATA  TO  DEXPCLASS.
           MOVE EQP-DOWN-COST      OF EQUIPMENT-DATA  TO  DDOWNCOST.
           MOVE EQP-SAFETY-FLG     OF EQUIPMENT-DATA  TO  DSAFETYFLG.
           MOVE EQP-ASBESTOS-FLG   OF EQUIPMENT-DATA  TO  DASBESTOSWRN.
           MOVE EQP-EQUIP-NAME     OF EQUIPMENT-DATA  TO  DLOCALNAME.
           MOVE EQP-CORP-DESC      OF EQUIPMENT-DATA  TO  DCORPNAME.

       SHOW-DELETE-SCREEN.
           MOVE "00"           TO SCREEN-STATUS.
           MOVE  SCREEN-DELETE TO DISPLAY-REC.

           WRITE DISPLAY-REC   FORMAT IS SCREEN-NAME
                               INDIC ARE SCREEN-INDICATORS.
           IF SCREEN-STATUS NOT = "00"
               DISPLAY "SCREEN WRITE ERROR.  SCREEN-STATUS IS "
                               SCREEN-STATUS
               GO TO END-OF-JOB.

           READ  DISPLAY-FILE  FORMAT IS SCREEN-NAME
                               INDIC ARE SCREEN-INDICATORS
           IF SCREEN-STATUS NOT = "00"
               DISPLAY "SCREEN READ ERROR.  SCREEN-STATUS IS "
                               SCREEN-STATUS
               GO TO END-OF-JOB.

           MOVE ALL B"0"       TO SCREEN-INDICATORS.
           MOVE DISPLAY-REC    TO SCREEN-DELETE.

           IF KEY-HIT = 3 OR 8
             GO TO END-OF-JOB.

           IF KEY-HIT NOT = 4
               GO TO DEL-EQPNUM-EXIT.

           MOVE DNUM           TO EQPNUM OF EQP-REC2.
           READ EQP-EQUIPMENT2 INTO EQUIPMENT-DATA
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
               MOVE "DELETE FAILED"
                               TO ERRMSGD
               MOVE TRUE-VAL   TO IND(99)
               GO TO SHOW-DELETE-SCREEN.

           DELETE EQP-EQUIPMENT2
               INVALID KEY
                   MOVE "DELETE FAILED"
                                   TO ERRMSGD
                   MOVE TRUE-VAL   TO IND(99)
                   GO TO SHOW-DELETE-SCREEN.

           MOVE "X"            TO MSG-SW.
           MOVE SPACES         TO MSG-BUFFER.
           STRING MSG1 ENUM-DEL MSG2 MSGD MSG3
                               DELIMITED BY SIZE
                               INTO MSG-BUFFER.

       DEL-EQPNUM-EXIT.        EXIT.

       DISP-EQPNUM.
      *C****************************************************************
      *--    >>  DISPLAY A LIST OF EQUIPMENT RECORDS IN FILE  <<
      *--  DISP-EQPNUM LISTS THE EQUIPMENT RECORDS FROM THE EQP-EQUIPMENT
      *--  FILE (MCFPMM0200) TO THE SCREEN.  IF THE INPUT FIELD IS LEFT
      *--  BLANK, THE ENTIRE LIST WILL DISPLAY (USING SUB-FILES); IF AN
      *--  EQUIPMENT NUMBER (OR PARTIAL NUMBER) IS ENTERED, THE LIST WILL
      *--  START AT THAT POINT.
      *C****************************************************************

           MOVE 0              TO RECNO.
           MOVE NEG-VAL        TO IND(75).
           MOVE TRUE-VAL       TO IND(77) IND(76).
           MOVE SPACES         TO DISPLAY-REC
                                  SCREEN-DISPLAY.
           WRITE DISPLAY-REC   FORMAT "EQP"
                               INDIC ARE SCREEN-INDICATORS.
           IF SCREEN-STATUS NOT = "00"
               DISPLAY
               "SUBFILE CLEAR WRITE ERROR.  SCREEN-STATUS IS "
                               SCREEN-STATUS.
           MOVE NEG-VAL        TO IND(77).

           MOVE ENUM-DISP      TO EQPNUM OF EQP-EQUIPMENT1.
           START EQP-EQUIPMENT1 KEY >= EQPNUM OF EQP-EQUIPMENT1
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT = "23"
               GO TO DBGET-LOOP
           ELSE
           IF FILE-STAT NOT = "00"
               DISPLAY
               "START EQP-EQUIPMENT ERROR.  FILE-STATUS IS "
                               FILE-STAT
               GO TO DISP-EQPNUM-EXIT.

       DBGET-LOOP.
           READ EQP-EQUIPMENT1 NEXT INTO EQUIPMENT-DATA
               AT END          MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT = "10" OR "14" OR "46"
               GO TO SUBF-CONT
           ELSE
           IF FILE-STAT NOT = "00"
               DISPLAY
               "READ EQP-EQUIPMENT ERROR.  FILE-STATUS IS "
                               FILE-STAT
               GO TO DISP-EQPNUM-EXIT.

           IF EQP-EQUIP-NUM OF EQUIPMENT-DATA = SPACES
               GO TO DBGET-LOOP.

           MOVE EQP-EQUIP-NUM  OF EQUIPMENT-DATA  TO  SNUM.
           MOVE EQP-TYPE       OF EQUIPMENT-DATA  TO  STYPE.
           MOVE EQP-DEPT       OF EQUIPMENT-DATA  TO  SDEPT.
           MOVE EQP-MAINT-ZONE OF EQUIPMENT-DATA  TO  SZONE.
           MOVE EQP-LOCATION   OF EQUIPMENT-DATA  TO  SLOCATION.
           MOVE EQP-RIME       OF EQUIPMENT-DATA  TO  RIME-FILL.
           MOVE RFRIME                            TO  SRIME.
           MOVE EQP-EXP-CLASS  OF EQUIPMENT-DATA  TO  SEXPCLASS.
           MOVE EQP-DOWN-COST  OF EQUIPMENT-DATA  TO  SDOWNCOST.
           MOVE EQP-EQUIP-NAME OF EQUIPMENT-DATA  TO  SLOCALNAME.

           ADD 1               TO RECNO.
           MOVE SCREEN-DISPLAY TO DISPLAY-REC.
           MOVE "00"           TO SCREEN-STATUS.
           WRITE SUBFILE       DISPLAY-REC FORMAT "EQPDISP"
                               INDIC ARE SCREEN-INDICATORS
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF SCREEN-STATUS NOT = "00"
               DISPLAY   "SUBFILE 1 WRITE ERROR.  SCREEN STATUS IS "
                               SCREEN-STATUS
               GO TO END-OF-JOB.

           GO TO DBGET-LOOP.

       SUBF-CONT.
           IF RECNO EQUAL 0
               GO TO DISP-EQPNUM-EXIT.

           WRITE DISPLAY-REC   FORMAT "ENDSUBF"
                               INDIC ARE SCREEN-INDICATORS.
           MOVE TRUE-VAL       TO IND(76).

           IF RECNO GREATER THAN 0
               MOVE TRUE-VAL   TO IND(75)
           ELSE
               MOVE NEG-VAL    TO IND(75).

           WRITE DISPLAY-REC   FORMAT "EQP"
                               INDIC ARE SCREEN-INDICATORS.
           READ DISPLAY-FILE   FORMAT "EQP"
                               INDIC ARE SCREEN-INDICATORS.

           READ SUBFILE        DISPLAY-FILE NEXT MODIFIED
                               INTO SCREEN-DISPLAY
                               FORMAT "EQPDISP"
                               INDIC ARE SCREEN-INDICATORS.

       DISP-EQPNUM-EXIT.       EXIT.

       MCHG-OPTIONS.
           MOVE "MASS_MENU"    TO SCREEN-NAME.
           MOVE "00"           TO SCREEN-STATUS.
           WRITE DISPLAY-REC   FORMAT IS SCREEN-NAME
                               INDIC ARE SCREEN-INDICATORS.
           IF SCREEN-STATUS NOT = "00"
               DISPLAY "SCREEN WRITE ERROR. SCREEN STATUS = "
                 SCREEN-STATUS
               GO TO END-OF-JOB.

           READ DISPLAY-FILE   FORMAT IS SCREEN-NAME
                               INDIC ARE SCREEN-INDICATORS.
           IF SCREEN-STATUS NOT = "00"
               DISPLAY "SCREEN WRITE ERROR. SCREEN STATUS = "
                 SCREEN-STATUS
               GO TO END-OF-JOB.

           MOVE ALL B"0"       TO SCREEN-INDICATORS.

           IF KEY-HIT = 3 OR 8 GO TO MCHG-OPTIONS-X.

           IF KEY-HIT = 1
               PERFORM MCHG-EQPNUM THRU MCHG-EQPNUM-EXIT
               GO TO MCHG-OPTIONS
           ELSE
           IF KEY-HIT = 2
               PERFORM MCHG-RIMENUM THRU MCHG-RIMENUM-EXIT
               GO TO MCHG-OPTIONS
           ELSE
           GO TO MCHG-OPTIONS.
       MCHG-OPTIONS-X.    EXIT.

       MCHG-EQPNUM.
      *C****************************************************************
      *--    >>  MASS CHANGE ALL ASSOCIATED FILES FROM ONE EQUIPMENT
      *--        NUMBER TO A DIFFERENT EQUIPMENT NUMBER  <<
      *--  NOTE:  OLD NUMBER MUST EXIST; NEW NUMBER MUST NOT EXIST.
      *C****************************************************************

           MOVE "EQPMASSCHG"   TO SCREEN-NAME.

       SHOW-MCHG-SCREEN.
           MOVE "00"           TO SCREEN-STATUS.
           MOVE  SCREEN-OLDNEW TO DISPLAY-REC.

           WRITE DISPLAY-REC   FORMAT IS SCREEN-NAME
                               INDIC ARE SCREEN-INDICATORS.
           IF SCREEN-STATUS NOT = "00"
               DISPLAY "SCREEN WRITE ERROR.  SCREEN-STATUS IS "
                               SCREEN-STATUS
               GO TO END-OF-JOB.

           READ  DISPLAY-FILE  FORMAT IS SCREEN-NAME
                               INDIC ARE SCREEN-INDICATORS
           IF SCREEN-STATUS NOT = "00"
               DISPLAY "SCREEN READ ERROR.  SCREEN-STATUS IS "
                               SCREEN-STATUS
               GO TO END-OF-JOB.

           MOVE ALL B"0"       TO SCREEN-INDICATORS.
           MOVE DISPLAY-REC    TO SCREEN-OLDNEW.

           IF KEY-HIT = 3 OR 8
               GO TO MCHG-EQPNUM-EXIT.

           IF KEY-HIT = 1
               GO TO MCHG-EQPNUM-EXIT.

           IF ONUM = SPACES
      *M********************************************************************
      *M EQUIPMENT NUMBER IS REQUIRED
      *M********************************************************************
               MOVE "EQUIPMENT NUMBER IS REQUIRED"
                               TO ERRMSGMC
               MOVE TRUE-VAL   TO IND(1) IND(99)
               GO TO SHOW-MCHG-SCREEN
           ELSE
               MOVE ONUM       TO EQP-KEY
               PERFORM CHECK-EQPNUM THRU CHECK-EQPNUM-EXIT
               IF FILE-STAT = "00"
                   NEXT SENTENCE
               ELSE
               IF FILE-STAT = "23"
      *M********************************************************************
      *M INVALID EQUIPMENT NUMBER
      *M********************************************************************
                   MOVE "INVALID EQUIPMENT NUMBER"
                                 TO ERRMSGMC
                   MOVE TRUE-VAL TO IND(1) IND(99)
                   GO TO SHOW-MCHG-SCREEN
               ELSE
                   MOVE MESSAGE-BUFFER TO ERRMSGMC
                   MOVE TRUE-VAL   TO IND(1) IND(99)
                   GO TO SHOW-MCHG-SCREEN.

           IF NNUM = SPACES
      *M********************************************************************
      *M EQUIPMENT NUMBER IS REQUIRED
      *M********************************************************************
               MOVE "EQUIPMENT NUMBER IS REQUIRED"
                               TO ERRMSGMC
               MOVE TRUE-VAL   TO IND(2) IND(99)
               GO TO SHOW-MCHG-SCREEN
           ELSE
               MOVE NNUM TO EQP-KEY
               PERFORM CHECK-EQPNUM THRU CHECK-EQPNUM-EXIT
               IF FILE-STAT = "23"
                   NEXT SENTENCE
               ELSE
               IF FILE-STAT = "00"
      *M********************************************************************
      *M EQUIPMENT NUMBER ALREADY EXISTS
      *M********************************************************************
                   MOVE "EQUIPMENT NUMBER ALREADY EXISTS"
                                 TO ERRMSGMC
                   MOVE TRUE-VAL TO IND(2) IND(99)
                   GO TO SHOW-MCHG-SCREEN
               ELSE
                   MOVE MESSAGE-BUFFER TO ERRMSGMC
                   MOVE TRUE-VAL   TO IND(2) IND(99)
                   GO TO SHOW-MCHG-SCREEN.

           MOVE ONUM           TO EQPNUM OF EQP-REC1.
           READ EQP-EQUIPMENT1 INTO EQUIPMENT-DATA
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
               MOVE "MASS CHANGE FAILED - READ EQUIPMENT FILE 1"
                               TO ERRMSGMC
               MOVE TRUE-VAL   TO IND(1) IND(99)
               GO TO SHOW-MCHG-SCREEN.

           MOVE EQP-TYPE           OF EQUIPMENT-DATA  TO  OTYPE.
           MOVE EQP-DEPT           OF EQUIPMENT-DATA  TO  ODEPT.
           MOVE EQP-MAINT-ZONE     OF EQUIPMENT-DATA  TO  OZONE.
           MOVE EQP-LOCATION       OF EQUIPMENT-DATA  TO  OLOCATION.
           MOVE EQP-RIME           OF EQUIPMENT-DATA  TO  RIME-FILL.
           MOVE RFRIME                                TO  ORIME.
           MOVE EQP-EXP-CLASS      OF EQUIPMENT-DATA  TO  OEXPCLASS.
           MOVE EQP-DOWN-COST      OF EQUIPMENT-DATA  TO  ODOWNCOST.
           MOVE EQP-SAFETY-FLG     OF EQUIPMENT-DATA  TO  OSAFETYFLG.
           MOVE EQP-ASBESTOS-FLG   OF EQUIPMENT-DATA  TO  OASBESTOSWRN.
           MOVE EQP-EQUIP-NAME     OF EQUIPMENT-DATA  TO  OLOCALNAME.
           MOVE EQP-CORP-DESC      OF EQUIPMENT-DATA  TO  OCORPNAME.

      *M********************************************************************
      *M  IF EQUIPMENT IS CORRECT, PRESS 'F4' KEY TO CHANGE RECORDS, 'F1'
      *M  TO CANCEL
      *M********************************************************************
           STRING
          "IF EQUIPMENT IS CORRECT, PRESS 'F4' KEY TO CHANGE RECORDS, "
                               "F1  TO CANCEL"
                               DELIMITED BY SIZE
                               INTO MCHGMSG.

           MOVE "00"           TO SCREEN-STATUS.
           MOVE  SCREEN-OLDNEW TO DISPLAY-REC.
           WRITE DISPLAY-REC   FORMAT IS SCREEN-NAME
                               INDIC ARE SCREEN-INDICATORS.
           IF SCREEN-STATUS NOT = "00"
               DISPLAY "SCREEN WRITE ERROR.  SCREEN-STATUS IS "
                               SCREEN-STATUS
               GO TO END-OF-JOB.

           READ  DISPLAY-FILE  FORMAT IS SCREEN-NAME
                               INDIC ARE SCREEN-INDICATORS
           IF SCREEN-STATUS NOT = "00"
               DISPLAY "SCREEN READ ERROR.  SCREEN-STATUS IS "
                               SCREEN-STATUS
               GO TO END-OF-JOB.

           MOVE ALL B"0"       TO SCREEN-INDICATORS.

           IF KEY-HIT = 3 OR 8
             GO TO END-OF-JOB.

           IF KEY-HIT NOT = 4
               GO TO MCHG-EQPNUM-EXIT.

           MOVE EQUIPMENT-DATA TO EQUIPMENT-DATA2.
           MOVE NNUM           TO EQP-EQUIP-NUM OF EQUIPMENT-DATA2.
           WRITE EQP-REC2      FROM EQUIPMENT-DATA2
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
               MOVE "MASS CHANGE FAILED - WRITE EQUIPMENT FILE 2"
                               TO ERRMSGMC
               MOVE TRUE-VAL   TO IND(2) IND(99)
               GO TO SHOW-MCHG-SCREEN.

           PERFORM MOD-FUNCTION THRU MOD-FUNCTION-EXIT.

       MCHG-EQPNUM-EXIT.       EXIT.

       MCHG-RIMENUM.
           MOVE "FMCHGRIMS"    TO SCREEN-NAME.
           MOVE "00"           TO SCREEN-STATUS.
           MOVE SCREEN-TYPRIM  TO DISPLAY-REC.
           WRITE DISPLAY-REC   FORMAT IS SCREEN-NAME
                               INDIC ARE SCREEN-INDICATORS.
           IF SCREEN-STATUS NOT = "00"
               DISPLAY "SCREEN WRITE ERROR. SCREEN STATUS = "
                 SCREEN-STATUS
               GO TO END-OF-JOB.

           READ DISPLAY-FILE   FORMAT IS SCREEN-NAME
                               INDIC ARE SCREEN-INDICATORS.
           IF SCREEN-STATUS NOT = "00"
               DISPLAY "SCREEN WRITE ERROR. SCREEN STATUS = "
                 SCREEN-STATUS
               GO TO END-OF-JOB.

           MOVE ALL B"0"       TO SCREEN-INDICATORS.
           MOVE DISPLAY-REC    TO SCREEN-TYPRIM.
           MOVE SPACES         TO ERRMSGMCR.

           IF KEY-HIT = 3 OR 8 GO TO MCHG-RIMENUM-EXIT.

           IF RIMENU = " "
               MOVE "RIME NUMBER MUST BE BETWEEN 1 AND 9"
                   TO ERRMSGMCR
               MOVE B"1" TO IND (2) IND (99)
               GO TO MCHG-RIMENUM.

       MCHG-RIMENUM-LOOP.
           READ EQP-EQUIPMENT2 NEXT INTO EQUIPMENT-DATA
               AT END
               MOVE "RIME NUMBERS HAVE BEEN UPDATED"
                   TO CMDMSGMCR
               MOVE B"1" TO IND (98)
               MOVE SCREEN-TYPRIM  TO DISPLAY-REC
               WRITE DISPLAY-REC   FORMAT IS SCREEN-NAME
                                   INDIC ARE SCREEN-INDICATORS
               CALL "CLPAUSE2"
               CLOSE EQP-EQUIPMENT2
               OPEN I-O EQP-EQUIPMENT2
               GO TO MCHG-RIMENUM-EXIT.
           IF EQP-TYPE OF EQUIPMENT-DATA = TYPENU
               MOVE RIMENU TO RIME-NO OF EQUIPMENT-DATA
               REWRITE EQP-REC2 FROM EQUIPMENT-DATA.
           GO TO MCHG-RIMENUM-LOOP.

       MCHG-RIMENUM-EXIT.    EXIT.

       MOD-FUNCTION.
      *C****************************************************************
      *--    >>  MODIFY ROUTINE TO CARRY CHANGES IN THE EQUIPMENT RECORD
      *--        TO ALL THE ASSOCIATED FILES  <<
      *-- IS CALLED FROM BOTH CHG-EQPNUM AND MCHG-EQPNUM.
      *C****************************************************************

           OPEN I-O            EQP-REFERENCE-FILE.
           OPEN I-O            EQP-REMARKS-FILE.
           OPEN I-O            EQP-OPERATIONS-FILE.
           OPEN I-O            DRAWING-FILE.
           OPEN I-O            BASIC-FILE.
           OPEN I-O            HOT-CODE-FILE.
           OPEN I-O            CORP-CODE-LINK.
           OPEN I-O            CC-NOTE-MSTR.
           OPEN I-O            PLANNED-FILE.
           OPEN I-O            PM-OPENQ-FILE.
           OPEN I-O            PM-SCHEDULE.
           OPEN I-O            PM-SIMULATOR.
           OPEN I-O            PM-AUDIT.
           OPEN I-O            SCHEDULE-FILE.
           OPEN I-O            WO-OPENQ-FILE.

      *M****************************************************************
      *M  CHANGING EQUIPMENT NUMBERS IN {            } FILE
      *M****************************************************************
           MOVE "CHANGING EQUIPMENT NUMBERS IN {            } FILE"
                               TO MOD-FILE-MSGS.

      *M****************************************************************
      *M  ERROR UPDATING XXXXXXXXXXXXXXXXXXXX - PRESS ENTER TO CONTINUE
      *M****************************************************************
           STRING              "ERROR UPDATING XXXXXXXXXXXXXXXXXXXX "
                               "- PRESS ENTER TO CONTINUE"
                               DELIMITED BY SIZE
                               INTO MOD-FILE-ERRS.

           MOVE "VERBAL W/O  " TO MOD-FILE.
           MOVE MOD-FILE-MSGS  TO MCHGMSG.
           MOVE "00"           TO SCREEN-STATUS.
           MOVE ALL B"0"       TO SCREEN-INDICATORS.
           MOVE  SCREEN-OLDNEW TO DISPLAY-REC.
           WRITE DISPLAY-REC   FORMAT IS SCREEN-NAME
                               INDIC ARE SCREEN-INDICATORS.
           IF SCREEN-STATUS NOT = "00"
               DISPLAY "SCREEN WRITE ERROR.  SCREEN-STATUS IS "
                               SCREEN-STATUS
               GO TO END-OF-JOB.
           PERFORM MOD-BASIC-EQPNUMS      THRU MBE-EXIT.

           MOVE "HOT CODE    " TO MOD-FILE.
           MOVE MOD-FILE-MSGS  TO MCHGMSG.
           MOVE "00"           TO SCREEN-STATUS.
           MOVE ALL B"0"       TO SCREEN-INDICATORS.
           MOVE  SCREEN-OLDNEW TO DISPLAY-REC.
           WRITE DISPLAY-REC   FORMAT IS SCREEN-NAME
                               INDIC ARE SCREEN-INDICATORS.
           IF SCREEN-STATUS NOT = "00"
               DISPLAY "SCREEN WRITE ERROR.  SCREEN-STATUS IS "
                               SCREEN-STATUS
               GO TO END-OF-JOB.
           PERFORM MOD-HOT-CODE-EQPNUMS   THRU MHCE-EXIT.

           MOVE "SPARE PARTS " TO MOD-FILE.
           MOVE MOD-FILE-MSGS  TO MCHGMSG.
           MOVE "00"           TO SCREEN-STATUS.
           MOVE ALL B"0"       TO SCREEN-INDICATORS.
           MOVE  SCREEN-OLDNEW TO DISPLAY-REC.
           WRITE DISPLAY-REC   FORMAT IS SCREEN-NAME
                               INDIC ARE SCREEN-INDICATORS.
           IF SCREEN-STATUS NOT = "00"
               DISPLAY "SCREEN WRITE ERROR.  SCREEN-STATUS IS "
                               SCREEN-STATUS
               GO TO END-OF-JOB.
           PERFORM MOD-CORP-CODE-EQPNUMS   THRU MCCE-EXIT.

           MOVE "MACHINE NOTE" TO MOD-FILE.
           MOVE MOD-FILE-MSGS  TO MCHGMSG.
           MOVE "00"           TO SCREEN-STATUS.
           MOVE ALL B"0"       TO SCREEN-INDICATORS.
           MOVE  SCREEN-OLDNEW TO DISPLAY-REC.
           WRITE DISPLAY-REC   FORMAT IS SCREEN-NAME
                               INDIC ARE SCREEN-INDICATORS.
           IF SCREEN-STATUS NOT = "00"
               DISPLAY "SCREEN WRITE ERROR.  SCREEN-STATUS IS "
                               SCREEN-STATUS
               GO TO END-OF-JOB.
           PERFORM MOD-MACH-NOTE-EQPNUMS   THRU MMNE-EXIT.

           MOVE "PLANNED W/O  " TO MOD-FILE.
           MOVE MOD-FILE-MSGS  TO MCHGMSG.
           MOVE "00"           TO SCREEN-STATUS.
           MOVE ALL B"0"       TO SCREEN-INDICATORS.
           MOVE  SCREEN-OLDNEW TO DISPLAY-REC.
           WRITE DISPLAY-REC   FORMAT IS SCREEN-NAME
                               INDIC ARE SCREEN-INDICATORS.
           IF SCREEN-STATUS NOT = "00"
               DISPLAY "SCREEN WRITE ERROR.  SCREEN-STATUS IS "
                               SCREEN-STATUS
               GO TO END-OF-JOB.
           PERFORM MOD-PLANNED-EQPNUMS    THRU MPE-EXIT.

           MOVE "PM OPENQ    " TO MOD-FILE.
           MOVE MOD-FILE-MSGS  TO MCHGMSG.
           MOVE "00"           TO SCREEN-STATUS.
           MOVE ALL B"0"       TO SCREEN-INDICATORS.
           MOVE  SCREEN-OLDNEW TO DISPLAY-REC.
           WRITE DISPLAY-REC   FORMAT IS SCREEN-NAME
                               INDIC ARE SCREEN-INDICATORS.
           IF SCREEN-STATUS NOT = "00"
               DISPLAY "SCREEN WRITE ERROR.  SCREEN-STATUS IS "
                               SCREEN-STATUS
               GO TO END-OF-JOB.
           PERFORM MOD-PM-OPENQ-EQPNUMS   THRU MPOE-EXIT.

           MOVE "PM SCHEDULE " TO MOD-FILE.
           MOVE MOD-FILE-MSGS  TO MCHGMSG.
           MOVE "00"           TO SCREEN-STATUS.
           MOVE ALL B"0"       TO SCREEN-INDICATORS.
           MOVE  SCREEN-OLDNEW TO DISPLAY-REC.
           WRITE DISPLAY-REC   FORMAT IS SCREEN-NAME
                               INDIC ARE SCREEN-INDICATORS.
           IF SCREEN-STATUS NOT = "00"
               DISPLAY "SCREEN WRITE ERROR.  SCREEN-STATUS IS "
                               SCREEN-STATUS
               GO TO END-OF-JOB.
           PERFORM MOD-PMSCHEDULE-EQPNUMS THRU MPME-EXIT.

           MOVE "PM SIMULATOR" TO MOD-FILE.
           MOVE MOD-FILE-MSGS  TO MCHGMSG.
           MOVE "00"           TO SCREEN-STATUS.
           MOVE ALL B"0"       TO SCREEN-INDICATORS.
           MOVE  SCREEN-OLDNEW TO DISPLAY-REC.
           WRITE DISPLAY-REC   FORMAT IS SCREEN-NAME
                               INDIC ARE SCREEN-INDICATORS.
           IF SCREEN-STATUS NOT = "00"
               DISPLAY "SCREEN WRITE ERROR.  SCREEN-STATUS IS "
                               SCREEN-STATUS
               GO TO END-OF-JOB.
           PERFORM MOD-PMSIMULATOR-EQPNUMS THRU MPMS-EXIT.

           MOVE "PM AUDIT    " TO MOD-FILE.
           MOVE MOD-FILE-MSGS  TO MCHGMSG.
           MOVE "00"           TO SCREEN-STATUS.
           MOVE ALL B"0"       TO SCREEN-INDICATORS.
           MOVE  SCREEN-OLDNEW TO DISPLAY-REC.
           WRITE DISPLAY-REC   FORMAT IS SCREEN-NAME
                               INDIC ARE SCREEN-INDICATORS.
           IF SCREEN-STATUS NOT = "00"
               DISPLAY "SCREEN WRITE ERROR.  SCREEN-STATUS IS "
                               SCREEN-STATUS
               GO TO END-OF-JOB.
           PERFORM MOD-PMAUDIT-EQPNUMS THRU MPMA-EXIT.

           MOVE "SCHEDULE    " TO MOD-FILE.
           MOVE MOD-FILE-MSGS  TO MCHGMSG.
           MOVE "00"           TO SCREEN-STATUS.
           MOVE ALL B"0"       TO SCREEN-INDICATORS.
           MOVE  SCREEN-OLDNEW TO DISPLAY-REC.
           WRITE DISPLAY-REC   FORMAT IS SCREEN-NAME
                               INDIC ARE SCREEN-INDICATORS.
           IF SCREEN-STATUS NOT = "00"
               DISPLAY "SCREEN WRITE ERROR.  SCREEN-STATUS IS "
                               SCREEN-STATUS
               GO TO END-OF-JOB.
           PERFORM MOD-SCHEDULE-EQPNUMS   THRU MSE-EXIT.

           MOVE "WO OPENQ    " TO MOD-FILE.
           MOVE MOD-FILE-MSGS  TO MCHGMSG.
           MOVE "00"           TO SCREEN-STATUS.
           MOVE ALL B"0"       TO SCREEN-INDICATORS.
           MOVE  SCREEN-OLDNEW TO DISPLAY-REC.
           WRITE DISPLAY-REC   FORMAT IS SCREEN-NAME
                               INDIC ARE SCREEN-INDICATORS.
           IF SCREEN-STATUS NOT = "00"
               DISPLAY "SCREEN WRITE ERROR.  SCREEN-STATUS IS "
                               SCREEN-STATUS
               GO TO END-OF-JOB.
           PERFORM MOD-WO-OPENQ-EQPNUMS   THRU MWOE-EXIT.

           MOVE "EQP REFER   " TO MOD-FILE.
           MOVE MOD-FILE-MSGS  TO MCHGMSG.
           MOVE "00"           TO SCREEN-STATUS.
           MOVE ALL B"0"       TO SCREEN-INDICATORS.
           MOVE  SCREEN-OLDNEW TO DISPLAY-REC.
           WRITE DISPLAY-REC   FORMAT IS SCREEN-NAME
                               INDIC ARE SCREEN-INDICATORS.
           IF SCREEN-STATUS NOT = "00"
               DISPLAY "SCREEN WRITE ERROR.  SCREEN-STATUS IS "
                               SCREEN-STATUS
               GO TO END-OF-JOB.
           PERFORM MOD-EQP-REFERENCE-EQPNUMS  THRU MERFE-EXIT.

           MOVE "EQP REMARKS " TO MOD-FILE.
           MOVE MOD-FILE-MSGS  TO MCHGMSG.
           MOVE "00"           TO SCREEN-STATUS.
           MOVE ALL B"0"       TO SCREEN-INDICATORS.
           MOVE  SCREEN-OLDNEW TO DISPLAY-REC.
           WRITE DISPLAY-REC   FORMAT IS SCREEN-NAME
                               INDIC ARE SCREEN-INDICATORS.
           IF SCREEN-STATUS NOT = "00"
               DISPLAY "SCREEN WRITE ERROR.  SCREEN-STATUS IS "
                               SCREEN-STATUS
               GO TO END-OF-JOB.
           PERFORM MOD-EQP-REMARKS-EQPNUMS  THRU MERME-EXIT.

           MOVE "EQP OPERA   " TO MOD-FILE.
           MOVE MOD-FILE-MSGS  TO MCHGMSG.
           MOVE "00"           TO SCREEN-STATUS.
           MOVE ALL B"0"       TO SCREEN-INDICATORS.
           MOVE  SCREEN-OLDNEW TO DISPLAY-REC.
           WRITE DISPLAY-REC   FORMAT IS SCREEN-NAME
                               INDIC ARE SCREEN-INDICATORS.
           IF SCREEN-STATUS NOT = "00"
               DISPLAY "SCREEN WRITE ERROR.  SCREEN-STATUS IS "
                               SCREEN-STATUS
               GO TO END-OF-JOB.
           PERFORM MOD-EQP-OPERATIONS-EQPNUMS  THRU MEOPE-EXIT.

           MOVE "DRAWING     " TO MOD-FILE.
           MOVE MOD-FILE-MSGS  TO MCHGMSG.
           MOVE "00"           TO SCREEN-STATUS.
           MOVE ALL B"0"       TO SCREEN-INDICATORS.
           MOVE  SCREEN-OLDNEW TO DISPLAY-REC.
           WRITE DISPLAY-REC   FORMAT IS SCREEN-NAME
                               INDIC ARE SCREEN-INDICATORS.
           IF SCREEN-STATUS NOT = "00"
               DISPLAY "SCREEN WRITE ERROR.  SCREEN-STATUS IS "
                               SCREEN-STATUS
               GO TO END-OF-JOB.
           PERFORM MOD-DRAWING-EQPNUMS  THRU MDE-EXIT.

           CLOSE               BASIC-FILE.
           CLOSE               HOT-CODE-FILE.
           CLOSE               CORP-CODE-LINK.
           CLOSE               CC-NOTE-MSTR.
           CLOSE               PLANNED-FILE.
           CLOSE               PM-OPENQ-FILE.
           CLOSE               PM-SCHEDULE.
           CLOSE               PM-SIMULATOR.
           CLOSE               PM-AUDIT.
           CLOSE               SCHEDULE-FILE.
           CLOSE               WO-OPENQ-FILE.
           CLOSE               EQP-REFERENCE-FILE.
           CLOSE               EQP-REMARKS-FILE.
           CLOSE               EQP-OPERATIONS-FILE.
           CLOSE               DRAWING-FILE.

       MOD-FUNCTION-EXIT.      EXIT.

       MOD-BASIC-EQPNUMS.
           READ BASIC-FILE     FIRST INTO WO-BASIC-DATA
               AT END          GO TO MBE-EXIT.
           IF FILE-STAT = "10" OR "14" OR "46"
               GO TO MBE-EXIT.
           IF FILE-STAT NOT = "00"
               MOVE "BASIC-FILE    READ F" TO ERR-NAME
               MOVE FILE-STAT              TO ERR-NUM
               MOVE MOD-FILE-ERRS          TO ERRMSGMC
               PERFORM DISPLAY-ERRORS
               GO TO MBE-EXIT.

           GO TO MOD-BASIC-CONT.

       MOD-BASIC-NEXT.
           READ BASIC-FILE     NEXT INTO WO-BASIC-DATA
               AT END          GO TO MBE-EXIT.
           IF FILE-STAT = "10" OR "14" OR "46"
               GO TO MBE-EXIT.
           IF FILE-STAT NOT = "00"
               MOVE "BASIC-FILE    READ N" TO ERR-NAME
               MOVE FILE-STAT              TO ERR-NUM
               MOVE MOD-FILE-ERRS          TO ERRMSGMC
               PERFORM DISPLAY-ERRORS
               GO TO MBE-EXIT.

       MOD-BASIC-CONT.
           IF EQUIP-NUM OF WO-BASIC-DATA =
              EQP-EQUIP-NUM OF EQUIPMENT-DATA
               MOVE EQP-EQUIP-NUM OF EQUIPMENT-DATA2
                               TO EQUIP-NUM OF WO-BASIC-DATA
               MOVE EQP-TYPE   OF EQUIPMENT-DATA2
                               TO TYPE-NUM OF WO-BASIC-DATA
               MOVE EQP-DEPT   OF EQUIPMENT-DATA2
                               TO DEPT OF WO-BASIC-DATA
               MOVE EQP-MAINT-ZONE OF EQUIPMENT-DATA2
                               TO ZONE OF WO-BASIC-DATA
               MOVE EQP-LOCATION OF EQUIPMENT-DATA2
                               TO LOCATION OF WO-BASIC-DATA
               MOVE EQP-EXP-CLASS OF EQUIPMENT-DATA2 TO EXP-CLASS
               MOVE EQP-EQUIP-NAME OF EQUIPMENT-DATA2 TO EQUIP-NAME
               REWRITE BFREC   FROM WO-BASIC-DATA
                   INVALID KEY MOVE FILE-STAT TO FILE-STAT
               END-REWRITE
               IF FILE-STAT NOT = "00"
                   MOVE "BASIC-FILE   REWRITE" TO ERR-NAME
                   MOVE FILE-STAT              TO ERR-NUM
                   MOVE MOD-FILE-ERRS          TO ERRMSGMC
                   PERFORM DISPLAY-ERRORS
                   GO TO MBE-EXIT
               END-IF.

           GO TO MOD-BASIC-NEXT.

       MBE-EXIT.               EXIT.

