049000 PROCEDURE DIVISION.
049200 BEGIN-PROC.
           CALL "CLCWINQ".
049300     PERFORM 1-HSK.
049400     PERFORM 6-MAIN THRU 6-LOOP-WRITE-SCREEN
               UNTIL VIEW-LASTKEY = 3.
       2-EOJ.
           CLOSE DISPLAY-FILE.
           IF PRINT-BUF = "P" CLOSE PRINT-FILE.
           CLOSE WO-BASIC-FILE.
           CLOSE WO-LABOR-FILE.
           CLOSE WO-LAST-NUM-USED.
           CLOSE WO-PLANNED-FILE.
           CLOSE WO-ZONE-PRTY-MSTR-FILE.
104600     GOBACK.
049600
049700 1-HSK.
           OPEN I-O    DISPLAY-FILE.
           OPEN INPUT  WO-BASIC-FILE.
           OPEN INPUT  WO-LABOR-FILE.
           OPEN INPUT  WO-LAST-NUM-USED.
           OPEN INPUT  WO-PLANNED-FILE.
           OPEN INPUT  WO-ZONE-PRTY-MSTR-FILE.
049800     ACCEPT CURDATE-BUFFER FROM DATE.
           MOVE YY-BUFFER TO P-Y.
           MOVE MM-BUFFER TO P-M.
           MOVE DD-BUFFER TO P-D.
           ACCEPT TIME-BUFFER FROM TIME.
           MOVE CUR-TIME  TO P-TIME.
049900     MOVE LOW-VALUES TO STATUS-AREA.
