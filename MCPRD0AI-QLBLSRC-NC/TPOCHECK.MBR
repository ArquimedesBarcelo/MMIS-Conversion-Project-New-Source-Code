000200 IDENTIFICATION DIVISION.
000300 PROGRAM-ID. TPOCHECK.
000400*REMARKS.    THIS PROGRAM CHECKS THE DPORECD DATASET AND
      *D           DETERMINES IF THERE ARE ENGINEERING ITEMS ON
      *D           BUDGETS > 5000 OR A USER-SPECIFIED AMOUNT.
      *C
      *C  SEPT 06, 1996   CA YODER
      *C    MODIFIED PROGRAM FOR CENTURY DATABASE CHANGES.  ALSO
      *C    CORRECTED A PROBLEM WITH THE TO AND FROM DATES FOR THE
      *C    REPORT.  IF DATES WERE ENTERED TO LIMIT THE SEARCH, THE
      *C    "TO" DATE WAS INCORRECTLY MOVED INTO THE "FROM" FIELDS,
      *C    LEAVING THE "TO" FIELD AS SPACES.  THEREFORE, THE
      *C    COMPARE NEVER WORKED RIGHT.
      *C
000500 ENVIRONMENT DIVISION.
000600 CONFIGURATION SECTION.
000700 SOURCE-COMPUTER. AS400.
000800 OBJECT-COMPUTER. AS400.
       COPY SPECIALN OF COPYLIB.
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT DPORECD-FILE
               ASSIGN TO DATABASE-MCFLCS0901
               ORGANIZATION IS INDEXED
                 ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
               FILE STATUS IS FILE-STATUS.

           SELECT ONLINE-PRT ASSIGN TO PRINTER-MCPRT.

           SELECT WO-LAST-NUM-USED
               ASSIGN TO DATABASE-MCFPMM0800
               ORGANIZATION IS RELATIVE
               ACCESS MODE IS RANDOM
               RELATIVE KEY IS ARG-NO
               FILE STATUS IS FILE-STATUS.
000900 DATA DIVISION.
       FILE SECTION.
       FD  DPORECD-FILE
           LABEL RECORDS ARE STANDARD.
       01  DF-REC.
           COPY DDS-ALL-FORMATS OF MCFLCS0901.

       FD  ONLINE-PRT
           LABEL RECORDS ARE OMITTED
           RECORD CONTAINS 132 CHARACTERS
           DATA RECORD IS PRINT-RCD.
       01  PRINT-RCD.
           05  PRINT-LINE           PIC X(132).

       FD  WO-LAST-NUM-USED
           LABEL RECORDS ARE STANDARD
           DATA RECORD IS WLNUREC.
       01  WLNUREC.
           COPY DDS-ALL-FORMATS OF MCFPMM0800.
001000 WORKING-STORAGE SECTION.
       77  COMPRESS-PRINT           PIC X(8)  VALUE SPACES.
       77  LINE-CTR                 PIC 99.
       77  NORMAL-PRINT             PIC X(8)  VALUE SPACES.
       77  RECDS-CTR                PIC 9(5).
       01  ARG-NO                   PIC 9(9).
001300 01  BLOWUP-BASE              PIC X(16).
       01  CDATE.
           05 YY                    PIC 99.
           05 MM                    PIC 99.
           05 DD                    PIC 99.
       COPY DATAB    IN COPYLIB.
       01  DATE-FROM-CN.
           05  DATE-FROM-CC         PIC XX.
           05  DATE-FROM.
               10  DATE-FROM-YY     PIC XX.
               10  DATE-FROM-MM     PIC XX.
               10  DATE-FROM-DD     PIC XX.
       01  DATE-TO-CN.
           05  DATE-TO-CC           PIC XX.
           05  DATE-TO.
               10  DATE-TO-YY       PIC XX.
               10  DATE-TO-MM       PIC XX.
               10  DATE-TO-DD       PIC XX.
       01  DDATE.
           05 DMM                   PIC 99.
           05 FILLER                PIC X      VALUE "/".
           05 DDD                   PIC 99.
           05 FILLER                PIC X      VALUE "/".
           05 DYY                   PIC 99.
       01  DETAIL-1.
           05  FILLER               PIC X(17)  VALUE SPACES.
           05  D-PO-NO              PIC X(7)   VALUE SPACES.
           05  D-PO-DASH            PIC X      VALUE SPACE.
           05  D-PO-REL             PIC X(3)   VALUE SPACES.
           05  FILLER               PIC XX     VALUE SPACES.
           05  D-PODOLS             PIC $$$,$$$,$$$,$$$,$$9.
           05  FILLER               PIC X(35)  VALUE SPACES.
       01  DETAIL-2.
           05  FILLER               PIC X(10)  VALUE SPACES.
           05  FILLER               PIC X(29)
               VALUE "RECORDS READ IN DPORECD FILE ".
           05  D-CTR                PIC Z(5).
           05  FILLER               PIC X(36)  VALUE SPACES.
       COPY DPORECD  IN COPYLIB.
       COPY ESCMAIN  IN COPYLIB.
       01  FILE-STATUS.
           05  FILE-STATUS-1        PIC X  VALUE "0".
           05  FILE-STATUS-2        PIC X  VALUE "0".
       01  HEADER-0.
           05  FILLER               PIC X(17) VALUE SPACES.
           05  FILLER               PIC X(33)
               VALUE "ENGINEERING P.O'S WITH BUDGETS > ".
           05  H-PODOLS             PIC $$$,$$9.
           05  FILLER               PIC X(16) VALUE SPACES.
           05  H0-DATE              PIC X(8)  VALUE SPACES.
       01  HEADER-U.
           05  FILLER               PIC X(80) VALUE ALL "-".
       COPY IOFEEDBACK IN COPYLIB.
003800 COPY LANGSUB    IN COPYLIB.
       COPY OVRPFDATA  IN COPYLIB.
004900 COPY TBLOWUP    IN COPYLIB.
       COPY TDATECHK   IN COPYLIB.
       COPY VCOMLINK   IN COPYLIB.
       01  LAST-WO-BUFF.             COPY MLASTWO IN COPYLIB.
       COPY WSCONTROL  IN COPYLIB.
       LINKAGE SECTION.
       COPY THDPRTB    IN COPYLIB.
       01  DATA-LINE.
           05  SCREEN-FROM-DATE.
               10  S-F-D-MD         PIC 99.
               10  S-F-D-DM         PIC 99.
               10  S-F-D-YY         PIC 99.
           05  SCREEN-TO-DATE.
               10  S-T-D-MD         PIC 99.
               10  S-T-D-DM         PIC 99.
               10  S-T-D-YY         PIC 99.
           05  SCREEN-PO-LIMIT      PIC 9(6).
           05  FILLER               PIC X(62).

039400 PROCEDURE DIVISION USING HD-ROUTE-DATA, DATA-LINE.
005300 START-PGM SECTION.
       BEGIN-PGM.
005400     PERFORM 1-HSK.
005500     PERFORM 6-MAIN THRU 6-MAIN-X.
005600 2-EOJ.
062900     IF PAPER-IS-132-COLS
063000         NEXT SENTENCE
063100     ELSE
065700     WRITE PRINT-RCD FROM NORMAL-PRINT AFTER ADVANCING 0 LINES.
           CLOSE DPORECD-FILE.
           CLOSE ONLINE-PRT.
           CLOSE WO-LAST-NUM-USED.
006000     GOBACK.
023200 2-BLOWUP.
023300     MOVE "TPOCHECK" TO BU-PGM-NAME.
023400     CALL "TBLOWUP" USING BLOWUP-BASE BU-PGM-NAME STATUS-AREA
023500                      VIEW-COMAREA DUMMY-KSAM-STAT
023600                      BU-DISPLAY-MSG BU-DISPLAY-FLDS.
006100 1-HSK.
           OPEN INPUT  DPORECD-FILE.
           OPEN INPUT  WO-LAST-NUM-USED.
           MOVE HD-SPOOLER-NUMBER TO OVRPRTF-TOFILE-NUM.
           MOVE "*YES"            TO OVRPRTF-SHARED.
           MOVE HD-NO-OF-COPIES   TO OVRPRTF-COPIES.
           MOVE "MCPRT"           TO OVRPRTF-FILE.
           PERFORM 996-OVERRIDE-PRINT-FILE.
           OPEN OUTPUT ONLINE-PRT.
           CALL "TESCSEQ" USING ESC-NAME.
           MOVE CHAR-1636PI       TO  COMPRESS-PRINT.
           MOVE CHAR-10PI         TO  NORMAL-PRINT.
062900     IF PAPER-IS-132-COLS
063000         NEXT SENTENCE
063100     ELSE
063200     WRITE PRINT-RCD FROM COMPRESS-PRINT AFTER ADVANCING 0 LINES.
           ACCEPT CDATE           FROM DATE.
           MOVE CDATE             TO H0-DATE.
           MOVE MM                TO DMM.
           MOVE DD                TO DDD.
           MOVE YY                TO DYY.
           MOVE 59                TO LINE-CTR.
           MOVE 0                 TO RECDS-CTR.
034400     MOVE 1                 TO ARG-NO.
           READ WO-LAST-NUM-USED INTO LAST-WO-BUFF
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF FILE-STATUS NOT = "00" MOVE 17 TO COND-WORD.
           IF COND-WORD = 17 MOVE 1 TO DATE-FLAG-SW.
       6-MAIN.
           MOVE SCREEN-PO-LIMIT TO H-PODOLS.
           IF SCREEN-FROM-DATE = "      "
               MOVE SPACES    TO DATE-FROM-CN
           ELSE
           IF DATE-FLAG-SW = 3
               MOVE S-F-D-MD  TO DATE-FROM-DD
               MOVE S-F-D-DM  TO DATE-FROM-MM
               MOVE S-F-D-YY  TO DATE-FROM-YY
           ELSE
           MOVE S-F-D-MD      TO DATE-FROM-MM
           MOVE S-F-D-DM      TO DATE-FROM-DD
           MOVE S-F-D-YY      TO DATE-FROM-YY.
           IF DATE-FROM-YY NOT = SPACES
               IF DATE-FROM-YY > "70"
                   MOVE "19"  TO DATE-FROM-CC
               ELSE
                   MOVE "20"  TO DATE-FROM-CC.
           IF SCREEN-TO-DATE = "      "
               MOVE SPACES    TO DATE-TO-CN
           ELSE
      *---------- ALL OF THESE MOVE STATMENTS WERE MOVING THE S-T-D
      *---------- FIELDS INTO DATE-FROM FIELDS INSTEAD OF DATE-TO
      *---------- FIELDS, SO THIS REPORT WANSN'T RUNNING CORRECTLY
      *---------- BEFORE.  CHANGED TO CORRECT MOVE FIELDS.
           IF DATE-FLAG-SW = 3
               MOVE S-T-D-MD  TO DATE-TO-DD
               MOVE S-T-D-DM  TO DATE-TO-MM
               MOVE S-T-D-YY  TO DATE-TO-YY
           ELSE
           MOVE S-T-D-MD      TO DATE-TO-MM
           MOVE S-T-D-DM      TO DATE-TO-DD
           MOVE S-T-D-YY      TO DATE-TO-YY.
           IF DATE-TO-YY NOT = SPACES
               IF DATE-TO-YY > "70"
                   MOVE "19"  TO DATE-TO-CC
               ELSE
                   MOVE "20"  TO DATE-TO-CC.
           IF DATE-FROM-CN = "        "
               IF DATE-TO-CN = "        "
                   NEXT SENTENCE
               ELSE
               MOVE "00"      TO DATE-FROM-YY,
                                 DATE-FROM-MM,
                                 DATE-FROM-DD,
                                 DATE-FROM-CC.
           PERFORM 61-FIND-RECORDS THRU 61-FR-X.
       6-MAIN-X.    EXIT.

       61-FIND-RECORDS.
           READ DPORECD-FILE NEXT INTO BUF-DPORECD
               AT END    MOVE 11 TO COND-WORD.
           IF FILE-STATUS NOT = "00" MOVE 11 TO COND-WORD.
           IF COND-WORD = 11
      *        MOVE RECDS-CTR TO D-CTR
      *        ADD 1 TO LINE-CTR
      *        IF LINE-CTR > 59
      *            WRITE PRINT-RCD FROM HEADER-0 AFTER
      *                ADVANCING NEW-PAGE
      *            WRITE PRINT-RCD FROM HEADER-U AFTER ADVANCING 1
      *            WRITE PRINT-RCD FROM DETAIL-2 AFTER ADVANCING 1
      *            GO TO 61-FR-X
      *        ELSE
      *        WRITE PRINT-RCD FROM DETAIL-2 AFTER ADVANCING 1
               GO TO 61-FR-X.
           ADD 1 TO RECDS-CTR.
           IF PO-BUDGET-AMT < SCREEN-PO-LIMIT GO TO 61-FIND-RECORDS.
           IF PO-ADDL-DATA = "000001" OR "000020" OR "000031" OR
               "000035" OR "000036" OR "000037" OR "000039" OR
               "000051" OR "000053" OR "000054" OR "000055" OR
               "000056" OR "000057" OR "000250" OR "000253"
                   NEXT SENTENCE
           ELSE
           GO TO 61-FIND-RECORDS.
           IF DATE-FROM-CN = "        "
               NEXT SENTENCE
           ELSE
           IF PO-DATE-CN IS GREATER THAN OR EQUAL TO DATE-FROM-CN
               IF PO-DATE-CN IS LESS THAN OR EQUAL TO DATE-TO-CN
                   NEXT SENTENCE
               ELSE
               GO TO 61-FIND-RECORDS
           ELSE
           GO TO 61-FIND-RECORDS.
           MOVE PO-PO-NO       TO D-PO-NO
           MOVE "-"            TO D-PO-DASH.
           MOVE PO-RLS-NO      TO D-PO-REL.
           MOVE PO-BUDGET-AMT  TO D-PODOLS.
           ADD 1               TO LINE-CTR.
           IF LINE-CTR > 59
               WRITE PRINT-RCD FROM HEADER-0 AFTER
                   ADVANCING NEW-PAGE
               WRITE PRINT-RCD FROM HEADER-U AFTER ADVANCING 1
               WRITE PRINT-RCD FROM DETAIL-1 AFTER ADVANCING 1
               MOVE 3          TO LINE-CTR
           ELSE
           WRITE PRINT-RCD FROM DETAIL-1 AFTER ADVANCING 1.
           GO TO 61-FIND-RECORDS.
       61-FR-X.    EXIT.

       COPY OVRPFCALL IN COPYLIB.
