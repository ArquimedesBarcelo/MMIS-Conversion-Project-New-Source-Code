000200 IDENTIFICATION DIVISION.
000300 PROGRAM-ID.    TPDEL1.
000400 INSTALLATION.  GOODYEAR.
000500*REMARKS.
000600*        ########################################################
000700*        #  This is the personnel delete program  that  changes #
000800*        #  or deletes records in detail data sets that are not #
000900*        #  strictly 'Personnel' information. It deletes the re #
001000*        #  cord or changes the CC in preparation for the master#
001100*        #  CC delete in the data set 'Per-Personnel'...........#
001200*        ########################################################.
      *C
      *C   07/12/94  JE COFFMAN
      *C     Added a check of DREQQUE to determine if the clock card
      *C     that is trying to be deleted is linked to any CSIS
      *C     requisitions. If so, prohibit the delete. If not, delete
      *C     the MEMPL record for the clock card if one exists.
      *C
      *C   09/09/96  JEFF BUNGO
      *C     EXPAND DATE FIELDS FOR YEAR 2000 COMPLIANCE.
      *C     RECOMPILE TO PICK UP COPYLIB CHANGES.
      *C
001400 ENVIRONMENT DIVISION.
001500 CONFIGURATION SECTION.
001600 SOURCE-COMPUTER.      AS400.
001700 OBJECT-COMPUTER.      AS400.
       SPECIAL-NAMES.      I-O-FEEDBACK IS I-O-FEEDBACK-AREA
                           LOCAL-DATA IS LOCAL-DATA-AREA.
001000 INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT DISPLAY-FILE
               ASSIGN TO WORKSTATION-ZPERSON-SI
               ORGANIZATION IS TRANSACTION
               ACCESS IS SEQUENTIAL
               FILE STATUS IS DSPLY-STATUS
               CONTROL-AREA IS WS-CONTROL.
           SELECT DREQQUE
               ASSIGN TO DATABASE-MCFLCS4402
               ORGANIZATION IS INDEXED
                 ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                   WITH DUPLICATES
               FILE STATUS IS D-STATUS.
           SELECT LABOR-CURR-STAT-FILE
               ASSIGN TO DATABASE-MCFLMM1602
               ORGANIZATION IS INDEXED
               ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                   WITH DUPLICATES
               FILE STATUS IS LCS-STATUS.
           SELECT MEMPL
               ASSIGN TO DATABASE-MCFLCS4201
               ORGANIZATION IS INDEXED
                 ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
               FILE STATUS IS M-STATUS.
           SELECT NEWS-TABLE
               ASSIGN TO DATABASE-MCFLMM2803
               ORGANIZATION IS INDEXED
               ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                   WITH DUPLICATES
               FILE STATUS IS NT-STATUS.
           SELECT WO-LABOR
               ASSIGN TO DATABASE-MCFLMM1302
               ORGANIZATION IS INDEXED
               ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                   WITH DUPLICATES
               FILE STATUS IS WL-STATUS.
           SELECT WO-MESSAGE
               ASSIGN TO DATABASE-MCFLMM2401
               ORGANIZATION IS INDEXED
               ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                   WITH DUPLICATES
               FILE STATUS IS WM-STATUS.
           SELECT WO-OPEN-QUEUE
               ASSIGN TO DATABASE-MCFLMM1903
               ORGANIZATION IS INDEXED
               ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
               FILE STATUS IS WOQ-STATUS.
           SELECT WO-PARTS
               ASSIGN TO DATABASE-MCFLMM1203
               ORGANIZATION IS INDEXED
               ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                   WITH DUPLICATES
               FILE STATUS IS WP-STATUS.
001800 DATA DIVISION.
       FILE SECTION.
       FD  DISPLAY-FILE
           LABEL RECORDS ARE OMITTED.
       01  DSPLY-REC                   PIC X(2000).
       FD  DREQQUE
           LABEL RECORDS ARE STANDARD.
       01  DREQQUE-REC.
           COPY DDS-MCRPCS4400 OF MCFLCS4402.
       FD  LABOR-CURR-STAT-FILE
           LABEL RECORDS ARE STANDARD
           DATA RECORD IS LCSREC.
       01  LCSREC.
           COPY DDS-ALL-FORMATS OF MCFLMM1602.
       FD  MEMPL
           LABEL RECORDS ARE STANDARD.
       01  MEMPL-REC.
           COPY DDS-MCRPCS4200 OF MCFLCS4201.
       FD  NEWS-TABLE
           LABEL RECORDS ARE STANDARD
           DATA RECORD IS NTREC.
       01  NTREC.
           COPY DDS-ALL-FORMATS OF MCFLMM2803.
       FD  WO-LABOR
           LABEL RECORDS ARE STANDARD
           DATA RECORD IS WLREC.
       01  WLREC.
           COPY DDS-ALL-FORMATS OF MCFLMM1302.
       FD  WO-MESSAGE
           LABEL RECORDS ARE STANDARD
           DATA RECORD IS WMREC.
       01  WMREC.
           COPY DDS-ALL-FORMATS OF MCFLMM2401.
       FD  WO-OPEN-QUEUE
           LABEL RECORDS ARE STANDARD
           DATA RECORD IS WOQREC.
       01  WOQREC.
           COPY DDS-ALL-FORMATS OF MCFLMM1903.
       FD  WO-PARTS
           LABEL RECORDS ARE STANDARD
           DATA RECORD IS WPREC.
       01  WPREC.
           COPY DDS-ALL-FORMATS OF MCFLMM1203.
001900 WORKING-STORAGE SECTION.
       01  BLOWUP-BASE                  PIC X(16).
       COPY CATREAD OF COPYLIB.
       COPY CPYIND  OF COPYLIB.
003800 01  CURR-STAT-DATA.              COPY DCURRLBR OF COPYLIB.
       COPY DREQQUE IN COPYLIB.
003400 01  ERROR-BUFFER                 PIC X(80).
       01  FILE-STATUSES.
           05  D-STATUS                 PIC XX.
           05  DSPLY-STATUS             PIC XX.
           05  LCS-STATUS               PIC XX.
           05  M-STATUS                 PIC XX.
           05  NT-STATUS                PIC XX.
           05  WL-STATUS                PIC XX.
           05  WM-STATUS                PIC XX.
           05  WOQ-STATUS               PIC XX.
           05  WP-STATUS                PIC XX.
       COPY IOFEEDBACK OF COPYLIB.
003900 01  LABOR-DATA.                  COPY DWOLABOR OF COPYLIB.
004400 01  LABOR-SW                     PIC X.
       COPY MEMPL      IN COPYLIB.
004100 01  MESSAGE-DATA.                COPY DWOMSG   OF COPYLIB.
003500 01  MSG1                         PIC X(40).
003600 01  MSG2                         PIC X(15).
004200 01  NEWS-DATA.                   COPY DNEWSTBL OF COPYLIB.
003700 01  OPEN-QUEUE-DATA.             COPY DWOOPENQ OF COPYLIB.
004000 01  PARTS-DATA.                  COPY DWOPARTS OF COPYLIB.
004500 01  PARTS-SW                     PIC X.
002000 01  PASSWORD-INFORMATION.
002100     05  NAME-OF-PROGRAM     PIC X(08) VALUE "TPDEL1  ".
002200     05  PROGRAM-TYPE        PIC X(02) VALUE "MA".
002300     05  PROGRAM-RELEASE     PIC X(12) VALUE " E0100010001".
002400     05  PROGRAM-DESCRIPTION.
002500         10  PROG-DESC-A.
                   15  FILLER      PIC X(10) VALUE "SECONDARY ".
                   15  FILLER      PIC X(17) VALUE "PERSONNEL DELETE ".
                   15  FILLER      PIC X(13) VALUE "PROGRAM USED ".
                   15  FILLER      PIC X(15) VALUE "WHEN ALL CLOCK ".
                   15  FILLER      PIC X(05) VALUE "CARD ".
002700         10  PROG-DESC-B.
                   15  FILLER      PIC X(14) VALUE "DATA IS TO BE ".
                   15  FILLER      PIC X(46) VALUE "DELETED ".
002900         10  PROG-FUNCTION   PIC X(60) VALUE SPACES.
003100     05  PASSWORD-FLAG       PIC X.
004300 COPY DBSTAT    OF COPYLIB.
       COPY TBLOWUP   OF COPYLIB.
       01  TRUE-VAL                     PIC 1 VALUE B"1".
004600 COPY WSCONTROL OF COPYLIB.
004700 LINKAGE SECTION.
004800 01  DBPARAMETERS.                COPY DBPARMS OF COPYLIB.
004900 COPY VCOMLINK  OF COPYLIB.
005000 01  PLT-IDT                      PIC X(4).
005200 01  PER-PERSONNEL.               COPY MPERSONL OF COPYLIB.
005300 01  DD-SW                        PIC X.
005400 01  DATA-SW                      PIC X.
003400 01  SCREEN-D.
003500     05  YR-FIELD                 PIC XX.
003600     05  PG-FIELD                 PIC XX.
003700     05  CC-FIELD                 PIC X(4).
           05  SCREEN-CMD-LINE          PIC X(79).
           05  SCREEN-ERR-LINE          PIC X(79).
005600 PROCEDURE DIVISION USING DBPARAMETERS
005700                          VIEW-COMAREA
005800                          PLT-IDT
006000                          PER-PERSONNEL
006100                          DD-SW
006200                          DATA-SW
                                SCREEN-D.
007000 BEGIN-PGM.
           PERFORM 1-HSK.
           PERFORM 6-MAIN.
       2-EOJ.
           CLOSE DISPLAY-FILE.
           CLOSE DREQQUE.
           CLOSE LABOR-CURR-STAT-FILE.
           CLOSE MEMPL.
           CLOSE NEWS-TABLE.
           CLOSE WO-LABOR.
           CLOSE WO-MESSAGE.
           CLOSE WO-OPEN-QUEUE.
           CLOSE WO-PARTS.
           GOBACK.

177600 2-BLOWUP.
177700     MOVE "TPDEL1" TO BU-PGM-NAME.
177800     CALL "TBLOWUP" USING BLOWUP-BASE BU-PGM-NAME STATUS-AREA
177900                      VIEW-COMAREA DUMMY-KSAM-STAT
178000                      BU-DISPLAY-MSG BU-DISPLAY-FLDS.
178100
       1-HSK.
           OPEN I-O   DISPLAY-FILE.
           OPEN I-O   DREQQUE.
           OPEN I-O   LABOR-CURR-STAT-FILE.
           OPEN I-O   MEMPL.
           OPEN I-O   NEWS-TABLE.
           OPEN I-O   WO-LABOR.
           OPEN I-O   WO-MESSAGE.
           OPEN I-O   WO-OPEN-QUEUE.
           OPEN I-O   WO-PARTS.
006400     CALL "TPWORD" USING PASSWORD-INFORMATION.
006800     IF PASSWORD-FLAG = "N" GO TO 2-EOJ.
           MOVE SPACES TO BLOWUP-BASE.
      *M   "PLEASE WAIT WHILE I CHECK CERTAIN KEY DATA SETS"
007200     MOVE 42039 TO CATREAD-MSG-NUMBER.
007400     PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
           MOVE ERROR-BUFFER TO SCREEN-CMD-LINE.
           MOVE SCREEN-D TO DSPLY-REC.
           MOVE TRUE-VAL TO INDS (98).
           PERFORM 99-SCREEN-WRITE.
           PERFORM 98A-SCREEN-READ.
           CALL "CLPAUSE2".
008000     MOVE SPACES TO ERROR-BUFFER.
       6-MAIN.
008300     PERFORM 60-CHECK-WO-OPEN-QUEUE THRU 60-CWOQ-EXIT.
008400     PERFORM 61-CHECK-LABOR-CURR-STAT THRU 61-CLCS-EXIT.
008500     PERFORM 62-CHECK-WO-LABOR THRU 62-CWL-EXIT.
           PERFORM 67-CHECK-DREQQUE THRU 67-CD-EXIT.
           IF ERROR-BUFFER = SPACES
      *M       "PRESS 'F5' TO DELETE"
008600          MOVE 42040 TO CATREAD-MSG-NUMBER
008800          PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                MOVE ERROR-BUFFER TO SCREEN-CMD-LINE
           ELSE
           MOVE ERROR-BUFFER TO SCREEN-ERR-LINE
           MOVE B"1" TO INDS (99)
      *M   "F3 - END PROGRAM"
           MOVE 06027 TO CATREAD-MSG-NUMBER
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
           MOVE ERROR-BUFFER TO SCREEN-CMD-LINE.
           MOVE SCREEN-D TO DSPLY-REC.
           PERFORM 99-SCREEN-WRITE.
009400     PERFORM 98-SCREEN-READ.
014000     IF VIEW-LASTKEY = 5
014100       NEXT SENTENCE
014200     ELSE
014300     GO TO 2-EOJ.
010500     MOVE "N" TO LABOR-SW.
010800     PERFORM 63-CHANGE-WO-LABOR THRU 63-CWL-EXIT
010900         UNTIL LABOR-SW = "Y".
011100     MOVE "N" TO PARTS-SW.
011400     PERFORM 64-CHANGE-WO-PARTS THRU 64-CWP-EXIT
011500         UNTIL PARTS-SW = "Y".
012000     PERFORM 65-DELETE-WO-MESSAGE THRU 65-DWM-EXIT.
012600     PERFORM 66-DELETE-NEWS-TABLE THRU 66-DNT-EXIT.
           PERFORM 68-DELETE-MEMPL THRU 68-DM-EXIT.
012700     MOVE "Y" TO DD-SW.
014700 60-CHECK-WO-OPEN-QUEUE.
015100     PERFORM 69-START-WO-OPEN-QUEUE.
015400     IF COND-WORD = 17 GO TO 60-CWOQ-EXIT.
015600     PERFORM 69-READ-WO-OPEN-QUEUE.
015900     IF COND-WORD = 15 GO TO 60-CWOQ-EXIT.
      *M   "CLOCK CARD IS ASSIGNED TO OPEN WORK ORDER"
016100     MOVE 29089 TO CATREAD-MSG-NUMBER.
016300     PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
016400     MOVE ERROR-BUFFER TO MSG1.
016500     MOVE SPACES TO ERROR-BUFFER.
      *M   "CANNOT DELETE"
016600     MOVE 29090 TO CATREAD-MSG-NUMBER.
016800     PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
016900     MOVE ERROR-BUFFER TO MSG2.
017000     MOVE SPACES TO ERROR-BUFFER.
017100     STRING MSG1 Q-WO-NUM " " MSG2 DELIMITED BY SIZE
017200         INTO ERROR-BUFFER.
018200 60-CWOQ-EXIT.    EXIT.
018300
018400 61-CHECK-LABOR-CURR-STAT.
018800     PERFORM 69-START-LABOR-CURR-STAT.
019100     IF COND-WORD = 17 GO TO 61-CLCS-EXIT.
019300     PERFORM 69-READ-LABOR-CURR-STAT.
019600     IF COND-WORD = 15 GO TO 61-CLCS-EXIT.
      *M   "CC IS WORKING ON ORDER"
019800     MOVE 29091 TO CATREAD-MSG-NUMBER.
020000     PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
020100     MOVE ERROR-BUFFER TO MSG1.
020200     MOVE SPACES TO ERROR-BUFFER.
      *M   "CANNOT DELETE"
020300     MOVE 29090 TO CATREAD-MSG-NUMBER.
020500     PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
020600     MOVE ERROR-BUFFER TO MSG2.
020700     MOVE SPACES TO ERROR-BUFFER.
020800     STRING MSG1 LCS-WO-NUM " " MSG2 DELIMITED BY SIZE
020900         INTO ERROR-BUFFER.
021900 61-CLCS-EXIT.    EXIT.
022000
022100 62-CHECK-WO-LABOR.
022500     PERFORM 69-START-WO-LABOR.
022800     IF COND-WORD = 17 GO TO 62-CWL-EXIT.
023000     PERFORM 69-READ-WO-LABOR.
023300     IF COND-WORD = 15 GO TO 62-CWL-EXIT.
      *M   "CC HAS LABOR RECS THAT MUST BE CHANGED IN ORDER TO DELETE"
023500     MOVE 29093 TO CATREAD-MSG-NUMBER.
023700     PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
024400     PERFORM 62-CHECK-LABOR-CONT UNTIL COND-WORD = 15.
024500 62-CWL-EXIT.    EXIT.
024600
024700 62-CHECK-LABOR-CONT.
024800     IF LBR-COMPL-DATE = SPACES
      *M     "CC HAS NO COMPLETION DATE ON WORK ORDER"
024900       MOVE 29092 TO CATREAD-MSG-NUMBER
025100       PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
025200       MOVE ERROR-BUFFER TO MSG1
025300       MOVE SPACES TO ERROR-BUFFER
      *M     "CANNOT DELETE"
025400       MOVE 29090 TO CATREAD-MSG-NUMBER
025600       PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
025700       MOVE ERROR-BUFFER TO MSG2
025800       MOVE SPACES TO ERROR-BUFFER
025900       STRING MSG1 LBR-WO-NUM " " MSG2 DELIMITED BY SIZE
026000           INTO ERROR-BUFFER
             GO TO 2-EOJ.
027000     PERFORM 69-READ-WO-LABOR.
027700
027800 63-CHANGE-WO-LABOR.
028100     PERFORM 69-START-WO-LABOR.
028400     IF COND-WORD = 17
028500         MOVE "Y" TO LABOR-SW
028600         GO TO 63-CWL-EXIT.
028800     PERFORM 69-READ-WO-LABOR.
029100     IF COND-WORD = 15
029200         MOVE "Y" TO LABOR-SW
029300         GO TO 63-CWL-EXIT.
029400     PERFORM 69-DELETE-WO-LABOR.
           IF COND-WORD = 17
               MOVE "WO-LABOR DELETION ERROR * TPDEL1 *"
                   TO BU-DISPLAY-MSG
               PERFORM 2-BLOWUP.
029700     MOVE "9999" TO LBR-EMPL-NUM.
029800     PERFORM 69-WRITE-WO-LABOR.
           IF COND-WORD = 17
               MOVE "WO-LABOR WRITE ERROR * TPDEL1 *"
                   TO BU-DISPLAY-MSG
               PERFORM 2-BLOWUP.
030200     MOVE "Y" TO DATA-SW.
030300 63-CWL-EXIT.    EXIT.
030500
030600 64-CHANGE-WO-PARTS.
030900     PERFORM 69-START-WO-PARTS.
031200     IF COND-WORD = 17
031300         MOVE "Y" TO PARTS-SW
031400         GO TO 64-CWP-EXIT.
031600     PERFORM 69-READ-WO-PARTS.
031900     IF COND-WORD = 15
032000         MOVE "Y" TO PARTS-SW
032100         GO TO 64-CWP-EXIT.
032200     PERFORM 69-DELETE-WO-PARTS.
032400     IF COND-WORD = 17
               MOVE "WO-PARTS DELETION ERROR * TPDEL1 *"
                   TO BU-DISPLAY-MSG
               PERFORM 2-BLOWUP.
032500     MOVE "9999" TO PRT-ORIGINATOR.
032600     PERFORM 69-WRITE-WO-PARTS.
032900     IF COND-WORD = 17
               MOVE "WO-PARTS WRITE ERROR * TPDEL1 *"
                   TO BU-DISPLAY-MSG
               PERFORM 2-BLOWUP.
033000     MOVE "Y" TO DATA-SW.
033100 64-CWP-EXIT.    EXIT.
033300
033400 65-DELETE-WO-MESSAGE.
033600     PERFORM 69-START-WO-MESSAGE.
033900     IF COND-WORD = 17 GO TO 65-DWM-EXIT.
034100     PERFORM 69-READ-WO-MESSAGE.
034600     PERFORM 65-DELETE-MESSAGE-CONT UNTIL COND-WORD = 15.
034700 65-DWM-EXIT.    EXIT.

034900 65-DELETE-MESSAGE-CONT.
035000     PERFORM 69-DELETE-WO-MESSAGE.
035200     IF COND-WORD = 17
               MOVE "WO-MESSAGE DELETION ERROR * TPDEL1 *"
                   TO BU-DISPLAY-MSG
               PERFORM 2-BLOWUP.
035300     MOVE "Y" TO DATA-SW.
035400     PERFORM 69-READ-WO-MESSAGE.
035900
036000 66-DELETE-NEWS-TABLE.
036300     PERFORM 69-START-NEWS-TABLE.
036600     IF COND-WORD = 17 GO TO 66-DNT-EXIT.
036800     PERFORM 69-READ-NEWS-TABLE.
037300     PERFORM 66-DELETE-NEWS-CONT UNTIL COND-WORD = 15.
037400 66-DNT-EXIT.    EXIT.

037600 66-DELETE-NEWS-CONT.
037700     PERFORM 69-DELETE-NEWS-TABLE.
037900     IF COND-WORD = 17
               MOVE "NEWS-TABLE DELETION ERROR * TPDEL1 *"
                   TO BU-DISPLAY-MSG
               PERFORM 2-BLOWUP.
038000     MOVE "Y" TO DATA-SW.
038100     PERFORM 69-READ-NEWS-TABLE.
038600
       67-CHECK-DREQQUE.
           PERFORM 69-START-DREQQUE.
           IF COND-WORD = 17 GO TO 67-CD-EXIT.
       67-READ-DREQQUE.
019300     PERFORM 69-READ-DREQQUE.
019600     IF COND-WORD = 15 GO TO 67-CD-EXIT.
           IF DRQQ-APPROVE-DATE = SPACES
      *M   "CC IS LINKED TO CSIS REQUISITIONS "
019800         MOVE 03618 TO CATREAD-MSG-NUMBER
020000         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
020100         MOVE ERROR-BUFFER TO MSG1
020200         MOVE SPACES TO ERROR-BUFFER
      *M   "CANNOT DELETE"
020300         MOVE 29090 TO CATREAD-MSG-NUMBER
020500         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
020600         MOVE ERROR-BUFFER TO MSG2
020700         MOVE SPACES TO ERROR-BUFFER
020800         STRING MSG1 " " MSG2 DELIMITED BY SIZE
020900             INTO ERROR-BUFFER
           ELSE
           MOVE PER-EMP-NAME TO DRQQ-PAD
           REWRITE DREQQUE-REC FROM BUF-DREQQUE
           GO TO 67-READ-DREQQUE.
       67-CD-EXIT.    EXIT.

       68-DELETE-MEMPL.
           PERFORM 69-READ-MEMPL.
           IF COND-WORD = 17 GO TO 68-DM-EXIT.
           PERFORM 69-DELETE-MEMPL.
           IF COND-WORD NOT = 0
               MOVE "ERROR DELETING MEMPL RECORD *TPDEL1*"
                   TO BU-DISPLAY-MSG
               MOVE "CC = "        TO BU-DISPLAY-FLD (1)
               MOVE PER-CC-NUM     TO BU-DISPLAY-FLD9 (1)
               PERFORM 2-BLOWUP.
       68-DM-EXIT.    EXIT.

       69-START-DREQQUE.
           MOVE 0 TO COND-WORD.
           MOVE PER-CC-NUM TO EMPLOYID OF DREQQUE-REC.
           START DREQQUE KEY IS = EXTERNALLY-DESCRIBED-KEY
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF D-STATUS NOT = "00" MOVE 17 TO COND-WORD.

       69-READ-DREQQUE.
           MOVE 0 TO COND-WORD.
           READ DREQQUE NEXT INTO BUF-DREQQUE
               AT END    MOVE 15 TO COND-WORD.
           IF D-STATUS NOT = "00" MOVE 15 TO COND-WORD.
           IF PER-CC-NUM NOT = DRQQ-EMPL-QUEUED MOVE 15 TO COND-WORD.

       69-DELETE-LABOR-CURR-STAT.
           MOVE 0 TO COND-WORD.
           DELETE LABOR-CURR-STAT-FILE RECORD
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF LCS-STATUS NOT = "00" MOVE 17 TO COND-WORD.

       69-READ-LABOR-CURR-STAT.
           MOVE 0 TO COND-WORD.
           READ LABOR-CURR-STAT-FILE NEXT INTO CURR-STAT-DATA
               AT END    MOVE 15 TO COND-WORD.
           IF LCS-STATUS NOT = "00" MOVE 15 TO COND-WORD.

       69-START-LABOR-CURR-STAT.
           MOVE 0 TO COND-WORD.
           MOVE PER-CC-NUM TO PERCCNUM OF LCSREC.
           START LABOR-CURR-STAT-FILE KEY IS = EXTERNALLY-DESCRIBED-KEY
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF LCS-STATUS NOT = "00" MOVE 17 TO COND-WORD.

       69-DELETE-MEMPL.
           MOVE 0 TO COND-WORD.
           DELETE MEMPL RECORD
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF M-STATUS NOT = "00" MOVE 17 TO COND-WORD.

       69-READ-MEMPL.
           MOVE 0 TO COND-WORD.
           MOVE PER-CC-NUM TO EMPLOYID OF MEMPL-REC.
           READ MEMPL INTO BUF-MEMPL
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF M-STATUS NOT = "00" MOVE 17 TO COND-WORD.

       69-DELETE-NEWS-TABLE.
           MOVE 0 TO COND-WORD.
           DELETE NEWS-TABLE RECORD
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF NT-STATUS NOT = "00" MOVE 17 TO COND-WORD.

       69-READ-NEWS-TABLE.
           MOVE 0 TO COND-WORD.
           READ NEWS-TABLE NEXT INTO NEWS-DATA
               AT END    MOVE 15 TO COND-WORD.
           IF NT-STATUS NOT = "00" MOVE 15 TO COND-WORD.

       69-START-NEWS-TABLE.
           MOVE 0 TO COND-WORD.
           MOVE PER-CC-NUM TO PERCCNUM OF NTREC.
           START NEWS-TABLE KEY IS = EXTERNALLY-DESCRIBED-KEY
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF NT-STATUS NOT = "00" MOVE 17 TO COND-WORD.

       69-DELETE-WO-LABOR.
           MOVE 0 TO COND-WORD.
           DELETE WO-LABOR RECORD
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF WL-STATUS NOT = "00" MOVE 17 TO COND-WORD.

       69-READ-WO-LABOR.
           MOVE 0 TO COND-WORD.
           READ WO-LABOR NEXT INTO LABOR-DATA
               AT END    MOVE 15 TO COND-WORD.
           IF LBR-EMPL-NUM NOT = PER-CC-NUM MOVE 15 TO COND-WORD.
           IF WL-STATUS NOT = "00" MOVE 15 TO COND-WORD.

       69-START-WO-LABOR.
           MOVE 0 TO COND-WORD.
           MOVE PER-CC-NUM TO LBRCCNUM OF WLREC.
           START WO-LABOR KEY IS = EXTERNALLY-DESCRIBED-KEY
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF WL-STATUS NOT = "00" MOVE 17 TO COND-WORD.

        69-WRITE-WO-LABOR.
            MOVE 0 TO COND-WORD.
            WRITE WLREC FROM LABOR-DATA
                INVALID KEY    MOVE 17 TO COND-WORD.
            IF WL-STATUS NOT = "00" MOVE 17 TO COND-WORD.

        69-DELETE-WO-MESSAGE.
            MOVE 0 TO COND-WORD.
            DELETE WO-MESSAGE RECORD
                INVALID KEY    MOVE 17 TO COND-WORD.
            IF WM-STATUS NOT = "00" MOVE 17 TO COND-WORD.

        69-READ-WO-MESSAGE.
            MOVE 0 TO COND-WORD.
            READ WO-MESSAGE NEXT INTO MESSAGE-DATA
                AT END    MOVE 15 TO COND-WORD.
            IF FROM-CC NOT = PER-CC-NUM MOVE 15 TO COND-WORD.
            IF WM-STATUS NOT = "00" MOVE 15 TO COND-WORD.

       69-START-WO-MESSAGE.
           MOVE 0 TO COND-WORD.
           MOVE PER-CC-NUM TO FROMCC OF WMREC.
           START WO-MESSAGE KEY IS = EXTERNALLY-DESCRIBED-KEY
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF WM-STATUS NOT = "00" MOVE 17 TO COND-WORD.

       69-DELETE-WO-OPEN-QUEUE.
           MOVE 0 TO COND-WORD.
           DELETE WO-OPEN-QUEUE RECORD
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF WOQ-STATUS NOT = "00" MOVE 17 TO COND-WORD.

       69-READ-WO-OPEN-QUEUE.
           MOVE 0 TO COND-WORD.
           READ WO-OPEN-QUEUE NEXT INTO OPEN-QUEUE-DATA
               AT END    MOVE 15 TO COND-WORD.
           IF PER-CC-NUM NOT = PERCCNUM OF WOQREC MOVE 15 TO COND-WORD.
           IF WOQ-STATUS NOT = "00" MOVE 15 TO COND-WORD.

       69-START-WO-OPEN-QUEUE.
           MOVE 0 TO COND-WORD.
           MOVE PER-CC-NUM TO PERCCNUM OF WOQREC.
           START WO-OPEN-QUEUE KEY IS = EXTERNALLY-DESCRIBED-KEY
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF WOQ-STATUS NOT = "00" MOVE 17 TO COND-WORD.

       69-DELETE-WO-PARTS.
           MOVE 0 TO COND-WORD.
           DELETE WO-PARTS RECORD
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF WP-STATUS NOT = "00" MOVE 17 TO COND-WORD.

       69-READ-WO-PARTS.
           MOVE 0 TO COND-WORD.
           READ WO-PARTS NEXT INTO PARTS-DATA
               AT END    MOVE 15 TO COND-WORD.
           IF WP-STATUS NOT = "00" MOVE 15 TO COND-WORD.

       69-START-WO-PARTS.
           MOVE 0 TO COND-WORD.
           MOVE PER-CC-NUM TO PRTCCNUM OF WPREC.
           START WO-PARTS KEY IS = EXTERNALLY-DESCRIBED-KEY
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF WP-STATUS NOT = "00" MOVE 17 TO COND-WORD.

       69-WRITE-WO-PARTS.
           MOVE 0 TO COND-WORD.
           WRITE WPREC FROM PARTS-DATA
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF WP-STATUS NOT = "00" MOVE 17 TO COND-WORD.

       98-SCREEN-READ.
           READ DISPLAY-FILE FORMAT IS VIEW-CFNAME
               INDIC IS INDICS.
           ACCEPT IOFEEDBACK FROM I-O-FEEDBACK-AREA.
           MOVE ALL B"0" TO INDICS.
           IF DSPLY-STATUS NOT = "00"
               MOVE 3 TO VIEW-LASTKEY
           ELSE
           MOVE FUNCTION-NUM TO VIEW-LASTKEY.

       98A-SCREEN-READ.
           READ DISPLAY-FILE TERMINAL IS TERMINAL-ID
               INDIC IS INDICS
                  NO DATA MOVE DSPLY-STATUS TO DSPLY-STATUS.
           MOVE ALL B"0" TO INDICS.

       99-SCREEN-WRITE.
           WRITE DSPLY-REC FORMAT IS VIEW-CFNAME
               INDIC IS INDICS.
           MOVE ALL B"0" TO INDICS.

038700 999-CATREAD.
           MOVE SPACES TO ERROR-BUFFER.
           CALL "CCATREAD" USING CATREAD-PARMS.
           MOVE CATREAD-MSG-TEXT TO ERROR-BUFFER.
039700 999-CATREAD-EXIT.
039800     EXIT.
