001100 IDENTIFICATION DIVISION.
001200 PROGRAM-ID.          TBLPRT.
001300 AUTHOR.              C HILLES.
001400 DATE-WRITTEN.        7/1/83.
001500 DATE-COMPILED.
001600*INSTALLATION.        GOODYEAR TIRE AND RUBBER - AKRON.
001700*SECURITY.
001800*REMARKS.
001900*
002000*    THIS PROGRAM PRINTS THE DATA IN THE FILE "DBLOWUP.PUB".
002100*    THE FILE "DBLOWUP.PUB" . THE FILE "DBLOWUP.PUB" IS
002200*    WRITTEN TO BY THE SUBPROGRAM "TBLOWUP".  ANY PROGRAM
002300*    THAT CALLS "TBLOWUP" TO HANDLE FATAL ERROR SITUATION
002400*    WILL UPDATE THE FILE IF A FATAL ERROR IS
002500*    ENCOUNTERED.  THIS PROGRAM SIMPLY DISPLAYS A FORMATTED
002600*    OUTPUT OF THE FILE.
002700*
002800*    12/30/85.
002900*        CHANGED THIS PROGRAM TO GO TO "DBLOWUP.PUB"
003000*         OR "DBLOWUPV.PUB", DEPENDING ON WHETHER THE USER
003100*         WANTS TO SEE THE DB ERRORS OR THE VIEW ERRORS.
003200*           CIH.
003300 ENVIRONMENT DIVISION.
003400 CONFIGURATION SECTION.
003500 SOURCE-COMPUTER.  HP-3000.
003600 OBJECT-COMPUTER.  HP-3000.
       COPY SPECIALN IN COPYLIB.
003900 INPUT-OUTPUT SECTION.
004000 FILE-CONTROL.
           SELECT DISPLAY-FILE
               ASSIGN TO WORKSTATION-ZRSCREEN-SI
               ORGANIZATION IS TRANSACTION
               ACCESS IS SEQUENTIAL
               FILE STATUS IS DISPLAY-STATUS
               CONTROL-AREA IS WS-CONTROL.

           SELECT PRINT-FILE ASSIGN TO PRINTER-MCPRT.
           SELECT BLOWUP-FILE ASSIGN TO DATABASE-MCFPBLOWUP
                  ORGANIZATION IS SEQUENTIAL
                  FILE STATUS IS FILE-STATUS.
004300
004400 DATA DIVISION.
004500 FILE SECTION.
      *------ FD STATEMENT AREA FOR IBM ONLY ------*
       FD  DISPLAY-FILE
           LABEL RECORDS ARE OMITTED.
       01  DISPLAY-REC                   PIC X(1500).

010500 FD  PRINT-FILE
010600     LABEL RECORDS ARE OMITTED
010700     RECORD CONTAINS 132 CHARACTERS
010800     DATA RECORD IS PRINT-REC.
       01  PRINT-REC                     PIC X(132).
011100
004700 FD  BLOWUP-FILE
004800     LABEL RECORDS ARE STANDARD
004900     RECORD CONTAINS 374 CHARACTERS
005000     DATA RECORD IS BLOWUP-RCD.
005100 01  BLOWUP-RCD.
           05  BF-PLT-CODE               PIC X(4).
005300     05  BF-BASE.
               10  FILLER                PIC X(2).
               10  BF-BASE-NAME          PIC X(6).
               10  FILLER                PIC X(8).
           05  BF-PGM-NAME               PIC X(8).
           05  BF-STATUS-AREA            PIC X(20).
           05  BF-VIEW-COMAREA           PIC X(120).
006000     05  BF-KSAM-STATUS.
               10  K-STAT-1              PIC X(1).
               10  FILLER                PIC X(1).
           05  BF-MESSAGE                PIC X(60).
           05  BF-FLDS                   PIC X(110).
006500     05  BF-DATE.
               10  BF-DATE-MM            PIC X(2).
               10  FILLER                PIC X(1).
               10  BF-DATE-DD            PIC X(2).
               10  FILLER                PIC X(1).
               10  BF-DATE-YY            PIC X(2).
           05  BF-TIME                   PIC X(6).
           05  BF-USER                   PIC X(8).
           05  BF-ACCOUNT                PIC X(8).
           05  BF-TERM                   PIC 9(4).
007500
010400
      *------ FD STATEMENT AREA FOR IBM ONLY ------*
004600
007600 WORKING-STORAGE SECTION.
007700
       77  DBEXPLAIN-FLAG                PIC X(1)  VALUE "N".
       77  DATE-FLAG                     PIC X(1)  VALUE "N".
       77  PROGRAM-FLAG                  PIC X(1)  VALUE "N".
       77  PROGRAM-NAME-TEST             PIC X(8)  VALUE SPACES.
       77  STARTING-DATE                 PIC X(6)  VALUE SPACES.
       77  PASSWORD                      PIC X(5)  VALUE "JADE;".
       77  BASE                          PIC X(9)  VALUE "  STORES;".
       77  MODE1                         PIC S9(4) BINARY VALUE 1.
       77  VIEW-ERROR-BUF                PIC X(75) VALUE SPACES.
       77  VIEW-ERROR-BUFFLEN            PIC S9(4) BINARY VALUE 75.
       77  VIEW-ERROR-ACTUALEN           PIC S9(4) BINARY VALUE 0.
       77  RESULT                        PIC 9(4) VALUE 0.
       77  SUB                           PIC 9(2)  VALUE 0.
       77  FORMAT-WORD                   PIC ---------9.
       77  BLOWUP-FILE-SWITCH            PIC X(1).
009300
       01  WORK-LINE                     PIC X(132) VALUE SPACES.

       01  FILE-STATUS.
           05  FILE-STATUS-1             PIC X  VALUE "0".
           05  FILE-STATUS-2             PIC X  VALUE "0".

       01  ERROR-BUF                     PIC X(72) VALUE SPACES.
       01  ERROR-LEN                     PIC S9(4) BINARY VALUE 0.
009600
009700 01  TEST-DATE.
           05  TEST-DATE-YY              PIC X(2).
           05  TEST-DATE-MM              PIC X(2).
           05  TEST-DATE-DD              PIC X(2).
010100
       01  ASTERICK-LINE                 PIC X(79) VALUE ALL "*".
       COPY COMMAND  IN COPYLIB.
       COPY FUNCTDEF IN COPYLIB.
010910 01  COMMAND-LINE-WORK.
           05  FILLER                    PIC X(16) VALUE
010930         "FILE DBLOWUP.DB=".
           05  COMMAND-FILE2             PIC X(65) VALUE SPACES.
       COPY DBSTAT IN COPYLIB.
011800 01  STATUS-AREA2.
           05  COND-WORD2                PIC S9(4)   BINARY.
           05  DATA-LENG2                PIC S9(4)   BINARY.
           05  RCD-NO2                   PIC S9(9)   BINARY.
           05  CHAIN-LENG2               PIC S9(9)   BINARY.
           05  BKWD-ADDR2                PIC S9(9)   BINARY.
           05  FWRD-ADDR2                PIC S9(9)   BINARY.
012500
012600 COPY TSHWRDFM   OF COPYLIB.
       COPY DISPDAT2   IN COPYLIB.
       COPY IOFEEDBACK IN COPYLIB.
       COPY CATREAD    IN COPYLIB.
012700 COPY CSWITCHF   OF COPYLIB.
012800 COPY TBLOWUP    OF COPYLIB.
012900 COPY LANGUAGE   OF COPYLIB.
       01  MESSAGE-BUFFER                PIC X(76)    VALUE SPACES.
013100 01  MESSAGE-BUFFER-RD REDEFINES MESSAGE-BUFFER.
013200     05  MSG-BUFFER.
               10  MESSAGE-BUFFER-1      PIC X(1).
               10  FILLER                PIC X(67).
           05  MSG-VALUE                 PIC X(8).
013400 01  MESSAGE-BUFLEN            PIC S9(4)    VALUE 76    BINARY.
013500 01  MESSAGE-ACTLEN            PIC S9(4)    VALUE 0     BINARY.
013600 01  FIELD-NUMBER              PIC S9(4)    VALUE 1     BINARY.
013700
013800 01  FORMFILE.
           05  FORM-FNAME                PIC X(8)  VALUE "FRSCREEN".
           05  FILLER                    PIC X     VALUE ".".
014100     05  FORM-GNAME.
               10  FORM-GNAME1           PIC X(5)  VALUE "FLANG".
               10  FORM-GNAME2           PIC X(3)  VALUE SPACES.
           05  FILLER                    PIC X(19) VALUE SPACES.
014500
015300
015400 01  DE-FIELDS.
           05  SB-VIEW-OR-OTHERS         PIC X(26).
           05  SB-PLANT                  PIC X(4).
           05  SB-DB                     PIC X(14).
           05  SB-APPL                   PIC X(4).
           05  SB-DATE                   PIC X(6).
           05  SB-PROGRAM                PIC X(8).
           05  SB-SORT                   PIC X.
           05  DE-COMMAND-LINE           PIC X(79).
           05  DE-MESSAGE-LINE           PIC X(79).
016300
016400 COPY VCOMAREA OF COPYLIB.
016500
016600 01  DISPLAY-FLDS.
016700     05  BU-DISPLAY-LINE OCCURS 5  TIMES.
               10  DISPLAY-FLD           PIC X(14).
               10  DISPLAY-FLD9          PIC S9(8).
017000
       LINKAGE SECTION.
       01  START-DATE                    PIC X(6).

017100 PROCEDURE DIVISION USING START-DATE.
017200 1000-HOUSEKEEP.
           OPEN OUTPUT PRINT-FILE.
017300
017400 6000-MAIN.
021100
           MOVE "FBLPRT"                 TO  VIEW-NFNAME.
           PERFORM 9951-GETNEXTFORM.
           MOVE "DOESNT MATTER"          TO  SB-VIEW-OR-OTHERS.
           MOVE "ALL"                    TO  SB-PLANT.
           MOVE "ALL"                    TO  SB-DB.
           MOVE "ALL"                    TO  SB-APPL.
           MOVE START-DATE               TO  SB-DATE.
           MOVE "ALL"                    TO  SB-PROGRAM.
           MOVE "6"                      TO  SB-SORT.
           GO TO 6020-SKIP-TERM.

021200 6010-SHOWFORM.
           MOVE 7                        TO  SRF-KEYSET.
           PERFORM 9953-PUTBUFFER.
           PERFORM 998-WRITE-SCREEN THRU 9989-WS-X.
           IF MESSAGE-BUFFER-1 NOT = SPACES
               PERFORM 9954-SETERROR
               GO TO 6010-SHOWFORM.
022000
022100     IF VIEW-LASTKEY EQUAL 8
022200        GO TO 6990-MAIN-X.
022300
022400*---------- READ DATA BUFFER
           PERFORM 9952-GETBUFFER.
023600
       6020-SKIP-TERM.
           MOVE SB-VIEW-OR-OTHERS        TO  COMMAND-FILE2.
           PERFORM 9999-OVERRIDE-BLOWUP.
024710
           PERFORM 9972-CLOSE-FORM-TERM.
024740
024800     OPEN INPUT BLOWUP-FILE.
024900
025000
025100 6100-READ-LOOP.
025200     READ BLOWUP-FILE
025300         AT END GO TO 6990-MAIN-X.
025400
           MOVE BF-DATE-YY               TO  TEST-DATE-YY
           MOVE BF-DATE-MM               TO  TEST-DATE-MM
           MOVE BF-DATE-DD               TO  TEST-DATE-DD
025800     IF TEST-DATE < SB-DATE
025900             GO TO 6100-READ-LOOP.
026000
026100     IF SB-PROGRAM NOT = "ALL"
026200         IF BF-PGM-NAME = SB-PROGRAM
026300             NEXT SENTENCE
026400         ELSE
026500             GO TO 6100-READ-LOOP.
026600
026700     IF SB-PLANT NOT = "ALL"
026800        IF BF-PLT-CODE = SB-PLANT
026900           NEXT SENTENCE
027000        ELSE
027100           GO TO 6100-READ-LOOP.
027200
027300     IF SB-DB NOT = "ALL"
027400        IF BF-BASE-NAME = SB-DB
027500           NEXT SENTENCE
027600        ELSE
027700           GO TO 6100-READ-LOOP.
027800
027900     IF SB-APPL = "ALL"
028000        NEXT SENTENCE
028100     ELSE
028200        IF SB-APPL = "CSIS"
028300           IF BF-BASE-NAME = "STORES" OR "STHIST" OR "CSACCT" OR
028400             "              "
028500              NEXT SENTENCE
028600           ELSE
028700              GO TO 6100-READ-LOOP
028800        ELSE
028900           IF BF-BASE-NAME = "STORES" OR "STHIST" OR "CSACCT"
029000              GO TO 6100-READ-LOOP.
029100
029200
029300
           MOVE BF-STATUS-AREA           TO  STATUS-AREA.
           MOVE BF-VIEW-COMAREA          TO  VIEW-COMAREA.
           MOVE BF-FLDS                  TO  DISPLAY-FLDS.
029700
029800     WRITE PRINT-REC FROM ASTERICK-LINE AFTER ADVANCING 1.
           MOVE SPACES                   TO  WORK-LINE.
029900     STRING  "****   BLOWUP OF ", BF-PGM-NAME, " ** ",
030000     BF-DATE, " ** ", BF-TIME, " ** ", BF-USER, ".",
030100     BF-ACCOUNT, " ", BF-TERM, "  ****" DELIMITED BY SIZE
             INTO WORK-LINE.
           WRITE PRINT-REC FROM WORK-LINE AFTER ADVANCING 1.
029800     WRITE PRINT-REC FROM ASTERICK-LINE AFTER ADVANCING 1.
030300
           MOVE SPACES                   TO  ERROR-BUF.
           PERFORM 9999-DBERROR.
           WRITE PRINT-REC FROM ERROR-BUF AFTER ADVANCING 1.
030700
           MOVE SPACES                   TO  WORK-LINE.
030800     STRING  "MESSAGE= ", BF-MESSAGE,
030900             "PLANT=", BF-PLT-CODE DELIMITED BY SIZE
             INTO WORK-LINE.
           WRITE PRINT-REC FROM WORK-LINE AFTER ADVANCING 1.
           MOVE COND-WORD                TO  FORMAT-WORD.
           MOVE SPACES                   TO  WORK-LINE.
031100     STRING  "COND-WORD =   ", FORMAT-WORD DELIMITED BY SIZE
             INTO WORK-LINE.
           WRITE PRINT-REC FROM WORK-LINE AFTER ADVANCING 1.
031200
           MOVE VIEW-STATUS              TO  FORMAT-WORD.
           MOVE SPACES                   TO  WORK-LINE.
031400     STRING  "VIEW-STATUS = ", FORMAT-WORD DELIMITED BY SIZE
             INTO WORK-LINE.
           WRITE PRINT-REC FROM WORK-LINE AFTER ADVANCING 1.
031500     IF VIEW-STATUS NOT = 0
031600          PERFORM 9973-CALL-VERRMSG
                WRITE PRINT-REC FROM VIEW-ERROR-BUF AFTER ADVANCING 1.
031900
           MOVE SPACES                   TO  WORK-LINE.
032000     STRING  "FILE-STATUS = ", BF-KSAM-STATUS DELIMITED BY SIZE
             INTO WORK-LINE.
           WRITE PRINT-REC FROM WORK-LINE AFTER ADVANCING 1.
032100     IF K-STAT-1 = "9"
               PERFORM 9999-CKERROR
               MOVE RESULT               TO  FORMAT-WORD
               MOVE SPACES               TO  WORK-LINE
032400         STRING  "KSAM FILE ERROR, RESULT = ", RESULT
                 DELIMITED BY SIZE INTO WORK-LINE
               WRITE PRINT-REC FROM WORK-LINE AFTER ADVANCING 1.
032500
           MOVE 0                        TO  SUB.
032700 6200-DISPLAY-FLD-LOOP.
           ADD 1                         TO  SUB.
032900     IF SUB > 5
               MOVE SPACES               TO  PRINT-REC
               WRITE PRINT-REC AFTER ADVANCING 1
033100         GO TO 6100-READ-LOOP.
033200
033300     IF DISPLAY-FLD (SUB) = SPACES OR "00000000000000"
033400         NEXT SENTENCE
033500     ELSE
               MOVE SPACES               TO  WORK-LINE
033600         STRING  "FIELD ", SUB, " = ", DISPLAY-FLD (SUB)
                 DELIMITED BY SIZE INTO WORK-LINE
               WRITE PRINT-REC FROM WORK-LINE AFTER ADVANCING 1.
033700
033800     IF DISPLAY-FLD9 (SUB) NOT = 0
               MOVE SPACES               TO  WORK-LINE
033900         STRING  "NUMERIC FIELD ", SUB, " = ",
034000           DISPLAY-FLD9 (SUB) DELIMITED BY SIZE
                 INTO WORK-LINE
               WRITE PRINT-REC FROM WORK-LINE AFTER ADVANCING 1.
034200
034300     GO TO 6200-DISPLAY-FLD-LOOP.
053500
053600 6990-MAIN-X.
           CLOSE PRINT-FILE.
           GOBACK.

054000*********************************************************************
054100*   CSWITCH SWITCHES BETWEEN TWO FORMS AND HANDLES VIEW AND DL SIZE *
054200*   ERRORS BY LOOPING 5 TIMES AND THEN PASSING AN ERROR MESSAGE.    *
054300*********************************************************************
054400 800-CALL-CSWITCHF.
           MOVE SPACES                   TO  BU-DISPLAY-MSG.
054600     CALL "CSWITCHF" USING VIEW-COMAREA, LANGUAGE-PARMS,
054700                     FORMFILE, CSF-PARMS, BU-DISPLAY-MSG.
054800     IF BU-DISPLAY-MSG-1 NOT = SPACES
               MOVE FORM-GNAME           TO  BU-DISPLAY-FLD(2)
055000        PERFORM 990-BLOWUP THRU 999-EXIT.
055100
055900 990-BLOWUP.
           MOVE "TBLPRT"                 TO  BU-PGM-NAME.
           MOVE VIEW-NFNAME              TO  BU-DISPLAY-FLD (1).
056200     CALL "TBLOWUP" USING BASE, BU-PGM-NAME, STATUS-AREA,
056300           VIEW-COMAREA, FILE-STATUS, BU-DISPLAY-MSG,
056400           BU-DISPLAY-FLDS.
056500 999-EXIT.  EXIT.
       COPY HCATREAD IN COPYLIB.
       COPY DISPCALL IN COPYLIB.
       COPY DISPCAL2 IN COPYLIB.

       9951-GETNEXTFORM.
       9952-GETBUFFER.
           MOVE DISPLAY-REC TO DE-FIELDS.

       9953-PUTBUFFER.
           MOVE DE-FIELDS TO DISPLAY-REC.

       9954-SETERROR.
           MOVE B"1" TO IND (99).
           MOVE B"1" TO IND (FIELD-NUMBER).
           MOVE MESSAGE-BUFFER TO DE-MESSAGE-LINE.

       9955-CLEAR-FORM.
           MOVE SPACES TO DE-FIELDS, MESSAGE-BUFFER.

       9956-PUTWINDOW.
       9957-FIELDEDITS.
       9958-INITFORM.
       9959-SHOWFORM.
       9960-SETKEYLABEL.
       9961-AUTOREAD.
       9962-OPENFORM.
       9963-CLOSEFORM.
       9964-FINISHFORM.
       9972-CLOSE-FORM-TERM.
      *------ FOR IBM WE GO TO PRINT FILE INSTEAD OF DISPLAYING,
      *------ SO WE DON'T CLOSE FORMFILE/TERM FILE

       9973-CALL-VERRMSG.
      *------ IBM HAS NO SUCH THING
           MOVE SPACES TO VIEW-ERROR-BUF.

       9999-DBERROR.
      *------ NOTE: IBM HAS NO COMPARIBLE SUBPROGRAM

       9999-OVERRIDE-BLOWUP.
      *------ NOTE: IBM HAS NO VIEW BLOWUP FILE, SO WE DO NOTHING HERE

       9999-CKERROR.
      *------ FOR IBM, NO FILE SYSTEM ERRORS IN THE FILE STATUS
           MOVE ZERO TO RESULT.

       9999-OPEN-STUFF.
           OPEN I-O DISPLAY-FILE.
           OPEN OUTPUT PRINT-FILE.

       9999-CLOSE-STUFF.
           CLOSE DISPLAY-FILE.
           CLOSE PRINT-FILE.
