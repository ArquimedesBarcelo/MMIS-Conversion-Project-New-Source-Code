021000     05  DSET-DVENDOR          PIC X(16)    VALUE "DVENDOR;".
021100     05  DSET-DPODATAITM       PIC X(16)    VALUE "DPODATAITM;".
021200     05  DSET-DINVRCD          PIC X(16)    VALUE "DINVRCD;".
