      *****************************************************************
      *         SUB-ROUTINE THAT SHOWS PURCHASE
      *            ORDER HEADING INFORMATION.
      *****************************************************************

      *****************************************************************
      **          M O D I F I C A T I O N    H I S T O R Y
      *****************************************************************
      *C 06/12/92  BK DISMUKES  REQUEST 6220
      *C     1. ADDED LOGIC IN 6-SHOW-SCREENS TO SELECT WHICH
      *C        HEADER2 SCREEN TO USE.
      *C     2. ADDED FIELD TO BUFFER FOR INDICICATOR FIELD.
      *C
      *C 09/16/92  JE COFFMAN   REQUEST 6253
      *C     1. ADDED LOGIC PER LUX REQUEST TO REMOVE ACCOUNTING
      *C        DATA FROM THE HEADER (AND ADD TO THE ITEM SCREENS
      *C        INSTEAD).
      *C
      *C 02/18/94  JS BUNGO     REQUEST 6449
      *C     ADDED FIELDS TO HISTORY DATABASES TO MATCH LIVE
      *C     DATABASES.  CHANGED CODE TO DISPLAY THESE FIELDS
      *C     ON AN INQUIRY.
      *C
      *C  06/10/96   JEFF BUNGO
      *C     EXPAND DATE FIELDS FOR YEAR 2000 COMPLIANCE.
      *C     FOR ANY BINARY DATE, SUBTRACT 19M OR 20M BEFORE CALL
      *C     TO TDATECK2 WHEN FORMATING DISPLAY DATE.
      *C
      *C  01/27/97   CA YODER    97-002
      *C     ADDED LOGIC FROM "TINQVEND" TO SHOW VENDOR INQUIRY
      *C     SCREEN WHEN F5 IS PRESSED.
      *C     ** NOTE:  IF SOMETHING IS CHANGED IN THIS PORTION OF
      *C        LOGIC, THE SAME CHANGE MAY NEED TO BE MADE IN
      *C        "TINQVEND" AND "TPOINQH".
      *C
      *C  02/02/98     CA YODER    REQ #97-018
      *C     ADDED LOGIC TO DISPLAY STANDARD INSTRUCTIONS WITH A
      *C     VENDOR CODE.
      *C
      *C  10/21/2003   CA YODER    TMS REQUEST
      *C     ADDED FREIGHT TERMS TO PAGE 2 OF THE HEADER INQUIRY
      *C     SCREEN.
      *C---------------------------------------------------------------
      *C MAR 10, 2005  D.RAUCH       DCR01    REQUEST# 2005-78515
      *C    DISPLAY FILE PROCESSING CHANGED FROM USING ZCSISINQ
      *C    NEW DISPLAY FILE ZSPOINQHH CREATED - FORMATS COPIED
      *C    FROM ZCSISINQ.
      *C---------------------------------------------------------------
      *C MMM DD, CCYY  XXXNAMEXXX    XXX01    REQUEST# 2005-XXXXX
      *C    XXXXXXXXXXXXXXXXXX DESC XXXXXXXXXXXXXXXXXXXXXXXXXXXXX
      *****************************************************************

004900 ENVIRONMENT DIVISION.
005000 CONFIGURATION SECTION.
005100 SOURCE-COMPUTER.    IBM-AS400.
005200 OBJECT-COMPUTER.    IBM-AS400.
       SPECIAL-NAMES.  I-O-FEEDBACK IS I-O-FEEDBACK-AREA
                       LOCAL-DATA IS LOCAL-DATA-AREA.
012800
012900 INPUT-OUTPUT SECTION.
       FILE-CONTROL.

           SELECT DISPLAY-FILE
                  ASSIGN TO WORKSTATION-ZSPOINQHH-SI
                  ORGANIZATION IS TRANSACTION
                  ACCESS IS SEQUENTIAL
                  FILE STATUS IS DISPLAY-STATUS
                  CONTROL-AREA IS WS-CONTROL.

           SELECT MVALIDUM-I
                  ASSIGN TO DATABASE-MCFLCS0401
                  ORGANIZATION IS INDEXED
                    ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                  FILE STATUS IS FILE-STATUS.

           SELECT MPLTINFO-I
                  ASSIGN TO DATABASE-MCFLCS0501
                  ORGANIZATION IS INDEXED
                    ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                  FILE STATUS IS FILE-STATUS.

           SELECT DPORECDH-I
                  ASSIGN TO DATABASE-MCFLST0301
                  ORGANIZATION IS INDEXED
                    ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                    WITH DUPLICATES
                  FILE STATUS IS FILE-STATUS.

           SELECT DVENDORH-I
                  ASSIGN TO DATABASE-MCFLST0201
                  ORGANIZATION IS INDEXED
                    ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                    WITH DUPLICATES
                  FILE STATUS IS FILE-STATUS.

           SELECT DPODESCH-I
                  ASSIGN TO DATABASE-MCFLST0501
                  ORGANIZATION IS INDEXED
                    ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                    WITH DUPLICATES
                  FILE STATUS IS FILE-STATUS.

           SELECT DINVRCDH-I
                  ASSIGN TO DATABASE-MCFLST0802
                  ORGANIZATION IS INDEXED
                    ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                    WITH DUPLICATES
                  FILE STATUS IS FILE-STATUS.

       DATA DIVISION.
       FILE SECTION.
       FD  DISPLAY-FILE
           LABEL RECORDS ARE OMITTED.
       01  DISPLAY-REC                  PIC X(2000).

       FD  MVALIDUM-I
           LABEL RECORDS ARE STANDARD.
       01  MVALIDUM-REC-I.
           COPY DDS-ALL-FORMATS  OF MCFLCS0401.

       FD  MPLTINFO-I
           LABEL RECORDS ARE STANDARD.
       01  MPLTINFO-REC-I.
           COPY DDS-ALL-FORMATS  OF MCFLCS0501.

       FD  DPORECDH-I
           LABEL RECORDS ARE STANDARD.
       01  DPORECDH-REC-I.
           COPY DDS-ALL-FORMATS  OF MCFLST0301.

       FD  DVENDORH-I
           LABEL RECORDS ARE STANDARD.
       01  DVENDORH-REC-I.
           COPY DDS-ALL-FORMATS  OF MCFLST0201.

       FD  DPODESCH-I
           LABEL RECORDS ARE STANDARD.
       01  DPODESCH-REC-I.
           COPY DDS-ALL-FORMATS  OF MCFLST0501.

       FD  DINVRCDH-I
           LABEL RECORDS ARE STANDARD.
       01  DINVRCDH-REC-I.
           COPY DDS-ALL-FORMATS  OF MCFLST0802.

