021400     05  DSET-MVALIDUM         PIC X(16)    VALUE "MVALIDUM;".
021500
021600 01  ITEMS-LISTING.
021700     05  ALL-ITEMS             PIC X(2)     VALUE "@;".
021800     05  PO-SEARCH             PIC X(10)    VALUE "PO-RCV-NO;".
021900     05  VEN-KEY-NAME          PIC X(10)    VALUE "VEN-CODE;".
022000
022100 01  UM-ARG                    PIC X(2)     VALUE SPACES.
022200
022300 01  BUILD-TM-DISCOUNT-KEY.
022400     05  FILLER                PIC X(3)  VALUE "TMP".
022500     05  BUILD-TM-DISCOUNT-VALUE  PIC X  VALUE SPACES.
022600
022700 01  BUILD-TM-DUE-DATE-KEY.
022800     05  FILLER                PIC X(3)  VALUE "TMD".
022900     05  BUILD-TM-DATE-VALUE   PIC X     VALUE SPACES.
023000
       01  BUILD-TM-KEY.
           05  FILLER                PIC X(2)  VALUE "MT".
           05  BUILD-TM-VALUE        PIC X(2)  VALUE SPACES.

       01  BUILD-TP-KEY.
           05  FILLER                PIC X(2)  VALUE "TP".
           05  BUILD-TP-VALUE        PIC X(2)  VALUE SPACES.

       01  BUILD-D-KEY.
           05  FILLER                PIC X     VALUE "D".
           05  BUILD-TOD-VALUE       PIC X(3)  VALUE SPACES.

023100 01  STD-INST-SAVED.
023200     05  SAVE-STD-INST-LIST.
023300         10  STD-INST-NO  OCCURS 12 TIMES  PIC X(3).
023400     05  SAVE-CONFIRMING-FLAG    PIC X.
023500     05  SAVE-CONFIRM-VERBAGE    PIC X(34).
023800
023900*************************************************************
024000**                                                         **
024100**             D A T A B A S E   B U F F E R S             **
024200**                                                         **
024300*************************************************************
024400 COPY DPORECDH   IN COPYLIB.
024500
024600 COPY DVENDORH   IN COPYLIB.
024700
024800 COPY DPODESCH   IN COPYLIB.
024900
025000 COPY DINVRCDH   IN COPYLIB.
025100
