025500
      *****************************************
      *   PARAMETERS FOR CALLING 'SEDIVNCH'
      *   WHICH IS THE ROUTINE TO DETERMINE
      *   IF VENDOR IS EDI OR NOT
      *****************************************

       COPY SEDIVNCK IN COPYLIB.

025600 LINKAGE SECTION.
025700
025800 01  BASE                      PIC X(10).
025800 01  BASE-STHIST               PIC X(10).
025900*************************************************************
026000**                                                         **
026100**      S C R E E N   P R I N T   P A R A M E T E R S      **
026200**                                                         **
026300*************************************************************
026400
026500 01  SCREEN-PRINT-PARMS.
026600     05  PRINT-CTL             PIC S9(4)    COMP-4.
026700     05  PAGE-CTL              PIC S9(4)    COMP-4.
026800     05  SPOOLFIL-OPEN-SW      PIC X.
026900
027000 01  PASS-SPOOL-PRT-NO         PIC S9(2)    COMP-4.
027100
027200 COPY VCOMLINK   IN COPYLIB.
027300
027400 01  MAIN-ARGUMENT-VALUES.
027500     05  PLT-ARG               PIC X(4).
027600     05  PO-ARG                PIC X(14).
027700     05  VEN-ARG.
027800         10  VEN-ARG1-7        PIC X(7).
027900         10  VEN-ARG8-10       PIC X(3).
028000     05  REQ-ARG               PIC X(12).
028100
028200 01  SAVE-POINQ-AREA.
028300     05  SAVE-COMPANY          PIC X(3).
028400     05  SAVE-ITEM-NUMBER      PIC X(4).
028500     05  SAVE-CORPCODE         PIC X(7).
028600     05  SAVE-PO-COUNT         PIC 9(2).
028700
028800 COPY LANGSUB    IN COPYLIB.
028900
029000
029100 PROCEDURE DIVISION USING  BASE,
                                 BASE-STHIST
029200                           SCREEN-PRINT-PARMS,
029300                           PASS-SPOOL-PRT-NO,
029400                           VIEW-COMAREA,
029500                           MAIN-ARGUMENT-VALUES,
029600                           SAVE-POINQ-AREA,
029700                           LANGUAGE-PARMS.
029800
029900 PO-INQUIRY SECTION 01.
       BEGIN-HERE.
           OPEN INPUT DPORECDH-I, MPLTINFO-I, MVALIDUM-I, DVENDORH-I,
                      DPODESCH-I, DINVRCDH-I.
           OPEN I-O DISPLAY-FILE.
           MOVE SPACES TO SEDIVNCK-PARMS.
           MOVE PO-ARG TO SEDIVNCK-PO-NUMBER.
           CALL "SEDIVNCH" USING BASE,
                                 SEDIVNCK-PARMS.
      ***********************************************************
      *    READ OF PCPO RECORD IN MPLTINFO IS DONE SO THAT      *
      *    PROGRAM CAN DECIDE WHETHER ACCOUNTING DATA IS TO     *
      *    APPEAR ON THE HEADER SCREEN OR ON THE ITEM SCREEN    *
      ***********************************************************
028100     MOVE "PCPO"                   TO   PLT-ARG.
           MOVE 0 TO COND-WORD.
           MOVE PLT-ARG TO PLTINFOKEY OF MPLTINFO-REC-I.
           READ MPLTINFO-I INTO BUF-MPLTINFO
               INVALID KEY MOVE 17 TO COND-WORD.
           IF FILE-STATUS NOT = "00" MOVE 17 TO COND-WORD.
           IF COND-WORD = 17
               MOVE "N"                  TO   SAVE-PCPO-SW
           ELSE
           MOVE MPLTINFO-PCPO-SW         TO   SAVE-PCPO-SW.
030000
030100     PERFORM  6-SHOW-PO-HEADER  THRU  6-SHOW-PO-HEADER-X.
030200
           CLOSE DPORECDH-I, MPLTINFO-I, MVALIDUM-I, DVENDORH-I,
                 DPODESCH-I, DINVRCDH-I, DISPLAY-FILE.
030300     GOBACK.
030400
030500
030600************************************************************
030700************************************************************
030800*                    B L O W U P                           *
030900*     CHECK FOR IMAGE, VIEW, OR SPOOL ERROR.  CLOSE        *
031000*     FILES, GET OUT OF BLOCK MODE, AND DISPLAY            *
031100*     APPROPRIATE ERROR MESSAGE ON SCREEN.                 *
031200*                                                          *
031300*     ALSO APPENDS THE ERROR MESSAGE TO A FILE CALLED      *
031400*     BLOWUP.PUB.  TO READ THIS FILE, RUN "XBLPRT.OBJECT". *
031500*                                                          *
031600*         |||  PROGRAM IS ABORTED IN TBLOWUP  |||          *
031700************************************************************
031800************************************************************
031900 2-BLOWUP.
032000     MOVE "SPOINQHH"    TO  BU-PGM-NAME.
032100     MOVE VEN-ARG      TO BU-DISPLAY-FLD (1).
032200     MOVE PO-ARG       TO BU-DISPLAY-FLD (2).
032300     MOVE REQ-ARG      TO BU-DISPLAY-FLD (3).
           IF FILE-STATUS NUMERIC
               MOVE FILE-STATUS TO COND-WORD.
032400     CALL "TBLOWUP" USING BASE, BU-PGM-NAME, STATUS-AREA,
032500           VIEW-COMAREA, FILE-STATUS,  BU-DISPLAY-MSG,
032600           BU-DISPLAY-FLDS.
032700
032800 2-BLOWUP-X.
032900     EXIT.
033000
033100 6-SHOW-PO-HEADER.
033200     MOVE 18                      TO  LANG-SETNUM.
033300     MOVE 6                       TO  LANG-MSGNUM.
033400     PERFORM 999-CATREAD  THRU  999-CATREAD-EXIT.
033500     MOVE MESSAGE-BUFFER          TO  RECEIVABLE-LIT.
033600     MOVE 14                      TO  LANG-SETNUM.
033700     MOVE 18                      TO  LANG-MSGNUM.
033800     PERFORM 999-CATREAD  THRU  999-CATREAD-EXIT.
033900     MOVE MESSAGE-BUFFER          TO  NON-RECEIVABLE-LIT.
034000     MOVE 55                      TO  LANG-SETNUM.
034100     MOVE 16                      TO  LANG-MSGNUM.
034200     PERFORM 999-CATREAD  THRU  999-CATREAD-EXIT.
034300     MOVE MESSAGE-BUFFER          TO  CONFIRMING-LIT.
034400     MOVE 14                      TO  LANG-SETNUM.
034500     MOVE 52                      TO  LANG-MSGNUM.
034600     PERFORM 999-CATREAD  THRU  999-CATREAD-EXIT.
034700     MOVE MESSAGE-BUFFER          TO  NON-CONFIRMING-LIT.
034800
           MOVE SPACES  TO PAYMENTS-CALCULATED-SW.
           MOVE ZEROS TO S-INVOICE-PAYMENTS-AMT,
                         S-INVOICE-PAYMENTS-ROUND,
                         S-CPW-DEDUCTS,
                         S-CPW-PAYMENTS.
034900
035000*****************************************************
035100*                                                   *
035200*    GET THE JCW  'PRICE'.                          *
035300*    IF THE 'PRICE' JCW IS FOUND AND IS SET TO '1'  *
035400*    THEN THE USER CAN SEE PRICING INFO.            *
035500*                                                   *
035600*****************************************************
035700
      *******************************************
      **  ACCEPT LOCAL DATA AREA FOR JCW-ITONLY
      *******************************************

           ACCEPT MC-LOCAL-DATA-AREA FROM LOCAL-DATA-AREA.

9301CK*----CHANGED TO MAKE SHOWING THE PRICE THE DEFAULT.
  .   *    IF JCW-PRICE-258 = "1"
  .   *        MOVE "Y"  TO PRICE-CAPABILITY-SW
  .   *    ELSE
9301CK*        MOVE "N"    TO PRICE-CAPABILITY-SW.
           IF JCW-PRICE-258 = "0"
               MOVE "N"  TO PRICE-CAPABILITY-SW
           ELSE
               MOVE "Y"    TO PRICE-CAPABILITY-SW.

037200*******************************************
037300**  GET DPORECD FOR HEADER INFORMATION.  **
037400*******************************************
037500
           MOVE PO-ARG TO PORCVNO OF DPORECDH-REC-I.
           START DPORECDH-I KEY = PORCVNO OF DPORECDH-REC-I
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
038300         MOVE "FIND DPORECD*6-SPH"  TO  BU-DISPLAY-MSG
038400         GO TO 2-BLOWUP.
038600
           READ DPORECDH-I NEXT INTO BUF-DPORECD-H
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00" OR
              PORCVNO OF DPORECDH-REC-I NOT = PO-ARG
039600         MOVE "GET DPORECD*6-SPH"  TO  BU-DISPLAY-MSG
039700         GO TO 2-BLOWUP.
039800
039900     MOVE SPACES               TO  DE-BUFFER1, DE-BUFFER2
040000                                   DE-BUFFER1E, DE-BUFFER1-L,
                                         DE-BUFFER1E-L.
           IF SEDIVNCK-EDI-IND = "Y"
                MOVE "HISTORY EDI PO" TO  DE1-HISTORY-LIT
                                         DE2-HISTORY-LIT
                                         DE1-HISTORY-LIT-E
                                         DE1-HISTORY-LIT-L
                                         DE1-HISTORY-LIT-E-L
           ELSE
038300         MOVE 3                TO  LANG-MSGNUM
038400         MOVE 8                TO  LANG-SETNUM
038500         PERFORM 999-CATREAD  THRU  999-CATREAD-EXIT
038600         MOVE MESSAGE-BUFFER   TO  DE1-HISTORY-LIT
038700                                   DE2-HISTORY-LIT
                                         DE1-HISTORY-LIT-E
                                         DE1-HISTORY-LIT-L
                                         DE1-HISTORY-LIT-E-L
           END-IF.
040100     MOVE SAVE-COMPANY         TO  DE1-CCD DE2-CCD DE1-CCD-E
                                         DE1-CCD-L DE1-CCD-E-L.
040200     MOVE POH-RCV-NO            TO  PO-WORK-AREA.
040300     MOVE POH-POH-NO            TO  DE1-PO DE2-PO DE1-PO-E
                                         DE1-PO-L DE1-PO-E-L.
040400     MOVE POH-RLS-NO            TO  DE1-RLSE DE2-RLSE DE1-RLSE-E
                                         DE1-RLSE-L DE1-RLSE-E-L.
040500
      *------SUBTRACT 19M OR 20M BEFORE DATE REFORMAT
040600     MOVE 4 TO DATE-MODE.
           MOVE POH-DATE TO TEMP-DATE-9.
           IF TEMP-YEAR > 70
               COMPUTE DISPLAY-DATE = POH-DATE - 19000000
           ELSE
               COMPUTE DISPLAY-DATE = POH-DATE - 20000000.
040700     MOVE DISPLAY-DATE TO DATE-VALIDATE-IN.
040800     CALL "TDATECK2" USING DATE-CHECK-AREA, LANGUAGE-PARMS.
040900     MOVE DATE-SLASH-OUT       TO  DE1-PO-DATE DE1-PO-DATE-E
                                         DE1-PO-DATE-L DE1-PO-DATE-E-L.
041000
041100     MOVE POH-REQ-NUMBER        TO  DE1-REQ-NUMBER
                                         DE1-REQ-NUMBER-E
                                         DE1-REQ-NUMBER-L
                                         DE1-REQ-NUMBER-E-L.
041200     MOVE POH-RCV-DEPT          TO  DE1-REC-DEPT
                                         DE1-REC-DEPT-E
                                         DE1-REC-DEPT-L
                                         DE1-REC-DEPT-E-L.
041300     MOVE POH-FOR-DEPT          TO  DE1-FOR-DEPT
                                         DE1-FOR-DEPT-E
                                         DE1-FOR-DEPT-L
                                         DE1-FOR-DEPT-E-L.
041400
041500     IF POH-SHIP-DATE = ZERO
041600         MOVE POH-SHIP-DATE     TO  DE1-SHIP-DATE
                                         DE1-SHIP-DATE-E
                                         DE1-SHIP-DATE-L
                                         DE1-SHIP-DATE-E-L
041700     ELSE
      *---------SUBTRACT 19M OR 20 BEFORE REFORMATING DATE
               MOVE POH-SHIP-DATE TO TEMP-DATE-9
               IF TEMP-YEAR > 70
                   COMPUTE DISPLAY-DATE = POH-SHIP-DATE - 19000000
               ELSE
                   COMPUTE DISPLAY-DATE = POH-SHIP-DATE - 20000000
               END-IF
               MOVE DISPLAY-DATE TO DATE-VALIDATE-IN
041900         CALL "TDATECK2" USING DATE-CHECK-AREA, LANGUAGE-PARMS
042000         MOVE DATE-SLASH-OUT   TO  DE1-SHIP-DATE
                                         DE1-SHIP-DATE-E
                                         DE1-SHIP-DATE-L
                                         DE1-SHIP-DATE-E-L.
042100
042200     IF POH-EXPECT-DATE = ZERO
042300         MOVE SPACE            TO  DE1-EXPECT-DATE
                                         DE1-EXPECT-DATE-E
                                         DE1-EXPECT-DATE-L
                                         DE1-EXPECT-DATE-E-L
042400     ELSE
      *---------SUBTRACT 19M OR 20M BEFORE REFORMATING DATE
               MOVE POH-EXPECT-DATE TO TEMP-DATE-9
               IF TEMP-YEAR > 70
                   COMPUTE DISPLAY-DATE = POH-EXPECT-DATE - 19000000
               ELSE
                   COMPUTE DISPLAY-DATE = POH-EXPECT-DATE - 20000000
               END-IF
               MOVE DISPLAY-DATE TO DATE-VALIDATE-IN
042600         CALL "TDATECK2" USING DATE-CHECK-AREA, LANGUAGE-PARMS
042700         MOVE DATE-SLASH-OUT   TO  DE1-EXPECT-DATE
                                         DE1-EXPECT-DATE-E
                                         DE1-EXPECT-DATE-L
                                         DE1-EXPECT-DATE-E-L.
042800
042900     MOVE POH-BUDGET-NUMBER     TO  DE1-BUDGET-NUMBER
                                         DE1-BUDGET-NUMBER-E
                                         DE1-BUDGET-NUMBER-L
                                         DE1-BUDGET-NUMBER-E-L.

043000     IF PRICE-ALLOWED
043100         MOVE POH-BUDGET-AMT    TO  DE1-BUDGET-AMOUNT
                                         DE1-BUDGET-AMOUNT-E
                                         DE1-BUDGET-AMOUNT-L
                                         DE1-BUDGET-AMOUNT-E-L.
043200     MOVE POH-ADDL-INFO         TO  DE1-ADDL-INFO
                                         DE1-ADDL-INFO-E
                                         DE1-ADDL-INFO-L
                                         DE1-ADDL-INFO-E-L.
043300     MOVE POH-FOB               TO  DE1-FOB
                                         DE1-FOB-E
                                         DE1-FOB-L
                                         DE1-FOB-E-L.
043400     MOVE POH-VIA               TO  DE1-VIA
                                         DE1-VIA-E
                                         DE1-VIA-L
                                         DE1-VIA-E-L.
043500
043600*******************************************
043700*
043800*   GET PAYMENT TERMS DESC. FOR PRINT
043900*   FROM MPLTINFO USING THE KEYS 'TMPn' AND
044000*   'TMDn' FOR DISCOUNT AMOUNT AND DUE DATE
044100*
044200*******************************************
044300
044400     MOVE POH-TERMS              TO  DE1-TERMS-CODE
                                          DE1-TERMS-CODE-E
                                          DE1-TERMS-CODE-L
                                          DE1-TERMS-CODE-E-L.
044500     MOVE POH-TERMS-PCT          TO  BUILD-TM-DISCOUNT-VALUE.
044600     MOVE BUILD-TM-DISCOUNT-KEY TO  PLT-ARG.
           MOVE PLT-ARG TO PLTINFOKEY OF MPLTINFO-REC-I.
           READ MPLTINFO-I INTO BUF-MPLTINFO
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS-1 = "2"
               NEXT SENTENCE
           ELSE
           IF FILE-STATUS NOT = "00"
045300         MOVE "GET MPLTINFO1 * 6-SPH" TO BU-DISPLAY-MSG
045400         MOVE PLT-ARG  TO  BU-DISPLAY-FLD (4)
045500         GO TO 2-BLOWUP
045600     ELSE
045700         MOVE MPLTINFO-DISC-AMNT-DESC TO DE1-TERMS-PCT
                                               DE1-TERMS-PCT-E
                                               DE1-TERMS-PCT-L
                                               DE1-TERMS-PCT-E-L.
045800
045900     MOVE POH-TERMS-DUE-DATE     TO  BUILD-TM-DATE-VALUE.
046000     MOVE BUILD-TM-DUE-DATE-KEY TO  PLT-ARG.
           MOVE PLT-ARG TO PLTINFOKEY OF MPLTINFO-REC-I.
           READ MPLTINFO-I INTO BUF-MPLTINFO
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS-1 = "2"
               NEXT SENTENCE
           ELSE
           IF FILE-STATUS NOT = "00"
046700         MOVE "GET MPLTINFO2 * 6-SPH" TO BU-DISPLAY-MSG
046800         MOVE PLT-ARG  TO  BU-DISPLAY-FLD (4)
046900         GO TO 2-BLOWUP
047000     ELSE
047100     MOVE MPLTINFO-TMD-DESC    TO  DE1-TERMS-DUE-DTE
                                         DE1-TERMS-DUE-DTE-E
                                         DE1-TERMS-DUE-DTE-L
                                         DE1-TERMS-DUE-DTE-E-L.
047200
047300 6-SHOW-HEADER-CONT.
047400     MOVE POH-CO                TO  DE1-COMPANY
                                         DE1-COMPANY-E.
047500     MOVE POH-PRIME             TO  DE1-PRIME
                                         DE1-PRIME-E.
047600     MOVE POH-SUB               TO  DE1-SUB
                                         DE1-SUB-E.
047700     MOVE POH-SUB-DET           TO  DE1-SUB-DETL
                                         DE1-SUB-DETL-E.
047800     MOVE POH-ADDL-DATA         TO  DE1-ADDL-DATA
                                         DE1-ADDL-DATA-E.
047900     MOVE POH-VEN-CODE          TO  VEN-ARG.
048000     MOVE POH-VEN-CODE1-7       TO  DE1-VEN-CODE1-7
                                         DE1-VEN-CODE1-7-E
                                         DE1-VEN-CODE1-7-L
                                         DE1-VEN-CODE1-7-E-L.
048100     MOVE "-"                  TO  DE1-VEN-HYPHEN
                                         DE1-VEN-HYPHEN-E
                                         DE1-VEN-HYPHEN-L
                                         DE1-VEN-HYPHEN-E-L.
048200     MOVE POH-VEN-CODE8-10      TO  DE1-VEN-CODE8-10
                                         DE1-VEN-CODE8-10-E
                                         DE1-VEN-CODE8-10-L
                                         DE1-VEN-CODE8-10-E-L.
048300     MOVE POH-BUYER-TYP         TO  DE1-BUYER
                                         DE1-BUYER-E
                                         DE1-BUYER-L
                                         DE1-BUYER-E-L.
           MOVE POH-TRANSPORT-MODE    TO  DE1-TRANS-MODE-E
                                         DE1-TRANS-MODE-E-L.
044500     MOVE POH-TRANSPORT-MODE    TO  BUILD-TM-VALUE.
044600     MOVE BUILD-TM-KEY         TO  PLT-ARG.
           MOVE PLT-ARG TO PLTINFOKEY OF MPLTINFO-REC-I.
           READ MPLTINFO-I INTO BUF-MPLTINFO
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS-1 = "2"
               NEXT SENTENCE
           ELSE
           IF FILE-STATUS NOT = "00"
045300         MOVE "GET MPLTINFO1 * 6-TMO" TO BU-DISPLAY-MSG
045400         MOVE PLT-ARG  TO  BU-DISPLAY-FLD (4)
045500         GO TO 2-BLOWUP
045600     ELSE
045700     MOVE MPLTINFO-MT-DESC     TO  DE1-TM-DESC-E
                                         DE1-TM-DESC-E-L.
           MOVE POH-TRANSPORT-CHGPAY  TO  DE1-TRANS-CHGPAY-E
                                         DE1-TRANS-CHGPAY-E-L
                                         BUILD-TP-VALUE.
044600     MOVE BUILD-TP-KEY         TO  PLT-ARG.
           MOVE PLT-ARG TO PLTINFOKEY OF MPLTINFO-REC-I.
           READ MPLTINFO-I INTO BUF-MPLTINFO
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS-1 = "2"
               NEXT SENTENCE
           ELSE
           IF FILE-STATUS NOT = "00"
045300         MOVE "GET MPLTINFO1 * 6-TMO" TO BU-DISPLAY-MSG
045400         MOVE PLT-ARG  TO  BU-DISPLAY-FLD (4)
045500         GO TO 2-BLOWUP
045600     ELSE
045700     MOVE MPLTINFO-DATA        TO  DE1-TC-DESC-E
                                         DE1-TC-DESC-E-L.
           MOVE POH-TRANSPORT-TERMS-OF-DEL
                                     TO  DE1-TRANS-DELTERM-E
                                         DE1-TRANS-DELTERM-E-L
                                         BUILD-TOD-VALUE.
044600     MOVE BUILD-D-KEY          TO  PLT-ARG.
           MOVE PLT-ARG TO PLTINFOKEY OF MPLTINFO-REC-I.
           READ MPLTINFO-I INTO BUF-MPLTINFO
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS-1 = "2"
               NEXT SENTENCE
           ELSE
           IF FILE-STATUS NOT = "00"
045300         MOVE "GET MPLTINFO1 * 6-TMO" TO BU-DISPLAY-MSG
045400         MOVE PLT-ARG  TO  BU-DISPLAY-FLD (4)
045500         GO TO 2-BLOWUP
045600     ELSE
045700     MOVE MPLTINFO-DATA        TO  DE1-TD-DESC-E
                                         DE1-TD-DESC-E-L.
048400     IF POH-NON-RCV-INDIC = "X"
048500         MOVE NON-RECEIVABLE-LIT  TO  DE2-PO-TYPE
048600     ELSE
048700     MOVE RECEIVABLE-LIT       TO  DE2-PO-TYPE.
      *------SUBTRACT 19M OR 20M BEFORE REFORMATING DATE
046700     MOVE 4  TO  DATE-MODE.
           MOVE POH-DELETION-DATE TO TEMP-DATE-9.
           IF TEMP-YEAR > 70
               COMPUTE DISPLAY-DATE = POH-DELETION-DATE - 19000000
           ELSE
               COMPUTE DISPLAY-DATE = POH-DELETION-DATE - 20000000
           END-IF
046800     MOVE DISPLAY-DATE          TO  DATE-VALIDATE-IN.
046900     CALL "TDATECK2" USING DATE-CHECK-AREA, LANGUAGE-PARMS.
047000     MOVE DATE-SLASH-OUT        TO  DE2-PO-DEL-DATE.
048800     MOVE POH-LAST-PAYMENT      TO  DE2-PO-LAST-PAY-DATE.
           MOVE POH-FREIGHT-TERMS     TO  DE2-FREIGHT-TERMS.
048900     MOVE POH-CURRENCY-CODE     TO  DE2-CURRENCY-CODE.
049000     IF POH-CURRENCY-CODE = SPACES
049100         NEXT SENTENCE
049200     ELSE
049300         MOVE POH-CURRENCY-CODE  TO  UM-ARG
               MOVE UM-ARG TO VALIDUM OF MVALIDUM-REC-I
               READ MVALIDUM-I INTO BUF-MVALIDUM
                   INVALID KEY MOVE "2" TO FILE-STATUS-2 END-READ
               IF FILE-STATUS-1 = "2"
                   NEXT SENTENCE
               ELSE
               IF FILE-STATUS NOT = "00"
050000             MOVE "GET MVALIDUM * 6-SHC" TO  BU-DISPLAY-MSG
050100             MOVE UM-ARG             TO  BU-DISPLAY-FLD (4)
050200             GO TO 2-BLOWUP
050300         ELSE
050400             MOVE VALID-CURRENCY-DESC TO DE2-CURRENCY-CODE-DESC.
050500
050600*****************************************
050700**  MOVE FOLLOWUP DATE AND NO. OF FOLLOWUPS
050800*****************************************
050900
051000     IF POH-FOLLOWUP-DATE  NUMERIC
      *----------FOLLOWUP NOT BINARY, SO NO SUBTRACTION NECESSARY
051100         MOVE POH-FOLLOWUP-DATE    TO  DATE-VALIDATE-IN
051200         CALL "TDATECK2" USING DATE-CHECK-AREA LANGUAGE-PARMS
051300         MOVE DATE-SLASH-OUT      TO  DE2-FOLLOWUP-DATE
051400     ELSE
051500         MOVE SPACES              TO  DE2-FOLLOWUP-DATE.
051600     IF POH-FOLLOWUP-COUNT = SPACES
051700         MOVE ZEROS               TO  DE2-NO-OF-FOLLOWUPS
051800     ELSE
051900         MOVE POH-FOLLOWUP-COUNT   TO  DE2-NO-OF-FOLLOWUPS.
052000
052100     MOVE POH-ALT-REMIT-INDIC      TO  DE2-ALT-REMIT-INDIC.
052200     PERFORM 62-GET-STD-INST  THRU  62-GSI-X.
052300     IF PRICE-ALLOWED
052400         MOVE POH-BUDGET-AMT       TO  DE2-BUDGET-AMOUNT
052500         PERFORM 62-CALCULATE-INVOICE-PAYMENTS  THRU  62-CIP-X.
052600
           MOVE VEN-ARG TO VENCDE OF DVENDORH-REC-I.
           START DVENDORH-I KEY = VENCDE OF DVENDORH-REC-I
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
                   MOVE "N"         TO  VEN-FOUND-SW
                   GO TO 6-SHOW-SCREENS
               ELSE
053500             MOVE "FIND DVENDOR*6-SHC" TO BU-DISPLAY-MSG
053600             GO TO 2-BLOWUP.

           MOVE "Y"                 TO  VEN-FOUND-SW.
           MOVE 0                   TO  VEN-SUB.
           MOVE SPACES              TO  DE-VENDOR-BUFFER.
           MOVE "N"                 TO  VDE-EDI-VENDOR.
           MOVE VEN-ARG             TO  VDE-VENDOR.
053800
053900 6-LOAD-PO-VENDOR.
054000
054100*******************************************
054200**  GET DVENDOR FOR VENDOR NAME AND      **
054300**  CITY, STATE, AND ZIP CODE.           **
054400*******************************************
054500
           READ DVENDORH-I NEXT INTO BUF-DVENDOR-H
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14"
                   GO TO 6-SHOW-SCREENS
               ELSE
056000             MOVE "GET DVENDOR * 6-LPV" TO BU-DISPLAY-MSG
056100             GO TO 2-BLOWUP.
           IF VENCDE OF DVENDORH-REC-I NOT = VEN-ARG
               GO TO 6-SHOW-SCREENS.
056200
      *---------- ADDED LOGIC TO FILL IN VENDOR INFO SCREEN WHILE
      *---------- READING THROUGH VENDOR FILE.
056300     IF VENH-ITM-NO EQUAL 00
056400         MOVE VENH-NAME        TO  DE1-VENDOR-NAME
                                        DE1-VENDOR-NAME-E
                                        DE1-VENDOR-NAME-L
                                        DE1-VENDOR-NAME-E-L
                                        VDE-NAME.

           IF VENH-ITM-NO > 00 AND VENH-ITM-NO < 07
               ADD 1               TO  VEN-SUB
               MOVE VENH-ADDRESS   TO  VDE-ADDRESS(VEN-SUB).
056500
056600     IF VENH-ITM-NO EQUAL 07
056700         MOVE VENH-07-RCD      TO  DE1-VENDOR-CSZ
                                         DE1-VENDOR-CSZ-E
                                         DE1-VENDOR-CSZ-L
                                         DE1-VENDOR-CSZ-E-L
               MOVE VENH-CITY        TO  VDE-CITY
               MOVE VENH-STATE-CODE  TO  VDE-STATE
               MOVE VENH-PROV-CODE   TO  VDE-PROVINCE
               MOVE VENH-ZIP         TO  VDE-POSTAL-CODE
               MOVE VENH-ZIP-BEFORE-CITY TO  VDE-ZIP-PLACEMENT.

           IF VENH-ITM-NO EQUAL 08
               MOVE VENH-COUNTRY     TO  VDE-COUNTRY.

           IF VENH-ITM-NO EQUAL 09
               MOVE VENH-CONTACT         TO  VDE-CONTACT
               MOVE VENH-CONTACT-PHONE   TO  VDE-PHONE.

           IF VENH-ITM-NO EQUAL 10
               MOVE VENH-FAX             TO  VDE-FAX
               MOVE VENH-MIN-ORDER       TO  VDE-MIN-ORDER
               MOVE VENH-INVLESS-IND     TO  VDE-INVLESS-IND
               MOVE VENH-TELEX           TO  VDE-TELEX
               MOVE VENH-CC              TO  VDE-CC, UM-ARG
               MOVE UM-ARG TO VALIDUM OF MVALIDUM-REC-I
               READ MVALIDUM-I INTO BUF-MVALIDUM
                   INVALID KEY MOVE "2"  TO FILE-STATUS-2
               END-READ
               IF FILE-STATUS NOT = "00"
                 MOVE "????????????"     TO  VDE-CC-DESC
               ELSE
                 MOVE VALID-CURRENCY-DESC TO  VDE-CC-DESC.

           IF VENH-ITM-NO EQUAL 12
               MOVE VENH-12-RCD          TO  VDE-NOTE1.

           IF VENH-ITM-NO EQUAL 13
               MOVE VENH-13-RCD          TO  VDE-NOTE2.

           IF VENH-ITM-NO EQUAL 14
               MOVE "Y"                  TO  VDE-EDI-VENDOR
               MOVE VENH-DOLLAR-MAX      TO  VDE-DOLLAR-MAX
               MOVE VENH-EDIFACT-ID      TO  VDE-EDIFACT-ID
               MOVE VENH-GOODYEAR-CODE   TO  VDE-GOODYEAR-CODE
               MOVE VENH-TRADING-ID      TO  VDE-TRADING-ID
               MOVE VENH-STATUS-IND      TO  VDE-STATUS-IND
               MOVE VENH-EXCODE-IND      TO  VDE-EXCODE-IND.

           IF VENH-ITM-NO EQUAL 16
               MOVE VENH-PO-FOB          TO  VDE-FOB
               MOVE VENH-PO-TERMS        TO  VDE-TERMS.

           IF VENH-ITM-NO EQUAL 17
               MOVE VENH-17-RCD          TO VDE-INSTRUCTIONS.
056800
056900     GO TO  6-LOAD-PO-VENDOR.
057000
057100 6-SHOW-SCREENS.
           IF SEDIVNCK-EDI-IND = "Y"
               IF SAVE-PCPO-SW = "Y"
                   MOVE PO-HEADER1-E-L  TO  VIEW-NFNAME
               ELSE
               MOVE PO-HEADER1-E        TO  VIEW-NFNAME
           ELSE
           IF SAVE-PCPO-SW = "Y"
               MOVE PO-HEADER1-L        TO  VIEW-NFNAME
           ELSE
057200     MOVE PO-HEADER1              TO  VIEW-NFNAME.
057300     PERFORM 61-SHOW-SCREEN-1  THRU  61-SS1-X.
057400     IF VIEW-LASTKEY = 1
               PERFORM 63-SELECT-HEADER2-SCREEN THRU 63-SHS-EXIT
057500         MOVE PO-HEADER2          TO  VIEW-NFNAME
057600         PERFORM 61-SHOW-SCREEN-1  THRU  61-SS1-X
057700         IF VIEW-LASTKEY = 1
057800             GO TO 6-SHOW-SCREENS.

           IF VIEW-LASTKEY = 5
               MOVE VIEW-NFNAME         TO  SAVE-VIEW-NFNAME
               MOVE VEN-INQ             TO  VIEW-NFNAME
               MOVE SPACES              TO  DISPLAY-REC
               PERFORM 65-DISPLAY-VENDOR THRU 65-DV-X
               MOVE SAVE-VIEW-NFNAME    TO  VIEW-NFNAME
               GO TO 6-SHOW-SCREENS.

058000 6-SHOW-PO-HEADER-X.
058100     EXIT.
058200
058300
058400 61-SHOW-SCREEN-1.
059800     MOVE  6                  TO LANG-SETNUM.
           MOVE 49                  TO LANG-MSGNUM.
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
           MOVE MESSAGE-BUFFER  TO DE1-COMMAND-LINE-2
                                   DE1-COMMAND-LINE-2-E
                                   DE1-COMMAND-LINE-2-L
                                   DE1-COMMAND-LINE-2-E-L
                                   DE2-COMMAND-LINE-2.
           IF VIEW-NFNAME = PO-HEADER2
               MOVE  6              TO LANG-SETNUM
               MOVE 41              TO LANG-MSGNUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER  TO DE2-COMMAND-LINE
           ELSE
           MOVE  6                  TO LANG-SETNUM
           MOVE 38                  TO LANG-MSGNUM
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
           MOVE MESSAGE-BUFFER      TO DE1-COMMAND-LINE
                                       DE1-COMMAND-LINE-E
                                       DE1-COMMAND-LINE-L
                                       DE1-COMMAND-LINE-E-L.
060000     IF VIEW-NFNAME  =  PO-HEADER1
               MOVE DE-BUFFER1      TO DISPLAY-REC
060400     ELSE
           IF VIEW-NFNAME  =  PO-HEADER1-E
               MOVE DE-BUFFER1E     TO DISPLAY-REC
           ELSE
           IF VIEW-NFNAME  =  PO-HEADER1-L
               MOVE DE-BUFFER1-L    TO DISPLAY-REC
           ELSE
           IF VIEW-NFNAME  =  PO-HEADER1-E-L
               MOVE DE-BUFFER1E-L   TO DISPLAY-REC
           ELSE
           MOVE DE-BUFFER2          TO DISPLAY-REC.
           PERFORM 998-WRITE-SCREEN THRU 998-READ-SCREEN.
060000     IF VIEW-NFNAME  =  PO-HEADER1
               MOVE DISPLAY-REC TO DE-BUFFER1
060400     ELSE
           IF VIEW-NFNAME = PO-HEADER1-E
               MOVE DISPLAY-REC TO DE-BUFFER1E
           ELSE
           IF VIEW-NFNAME = PO-HEADER1-L
               MOVE DISPLAY-REC TO DE-BUFFER1-L
           ELSE
           IF VIEW-NFNAME = PO-HEADER1-E-L
               MOVE DISPLAY-REC TO DE-BUFFER1E-L
           ELSE
           MOVE DISPLAY-REC     TO DE-BUFFER2.
062900
063000     IF VIEW-LASTKEY EQUAL  1 OR 2 OR 3
063100         GO TO  61-SS1-X.
063200
           IF VIEW-LASTKEY EQUAL 5
               IF VEN-FOUND-SW = "Y"
                   GO TO  61-SS1-X
               ELSE
      *        ***  VENDOR NOT ON FILE ***
                   MOVE  22 TO LANG-SETNUM
                   MOVE  14 TO LANG-MSGNUM
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE 99  TO  FIELD-NUMBER
                   PERFORM  73-PGM-ERROR  THRU 73-PGM-ERROR-X
                   GO TO  61-SHOW-SCREEN-1
               END-IF
           ELSE
065900     IF VIEW-LASTKEY EQUAL 4  OR
065900        VIEW-LASTKEY EQUAL 6  OR
066000        VIEW-LASTKEY EQUAL 7  OR
066000        VIEW-LASTKEY EQUAL 8
066100*        ***  INVALID FUNCTION KEY ENTERED  ***
066200         MOVE   9 TO LANG-SETNUM
066300         MOVE  10 TO LANG-MSGNUM
066400         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
066500         MOVE 99  TO  FIELD-NUMBER
066600         PERFORM  73-PGM-ERROR  THRU 73-PGM-ERROR-X
066700         GO TO  61-SHOW-SCREEN-1.
066800
066900*    ***  PRESS THE DESIRED FUNCTION KEY - NOT 'ENTER'  ***
067000     MOVE  16 TO LANG-SETNUM.
067100     MOVE  30 TO LANG-MSGNUM.
067200     PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
06650      MOVE 99  TO  FIELD-NUMBER.
06660      PERFORM  73-PGM-ERROR  THRU 73-PGM-ERROR-X.
06670      GO TO  61-SHOW-SCREEN-1.
067600
067700 61-SS1-X.
067800     EXIT.
067900
068000
068100 62-GET-STD-INST.
068200     MOVE SPACES  TO  STD-INST-SAVED.
           MOVE PO-ARG  TO PORCVNO OF DPODESCH-REC-I.
           MOVE "000001" TO POITEMSEQ OF DPODESCH-REC-I.
           READ DPODESCH-I INTO BUF-DPODESC-H
               INVALID KEY MOVE "2" TO FILE-STATUS-1.
           IF FILE-STATUS-1 = "2"
               GO TO 62-GSI-X
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE "READ DPODESCH 62-GSI" TO BU-DISPLAY-MSG
               GO TO 2-BLOWUP
           ELSE
               MOVE PODESCH-DESC  TO STD-INST-SAVED.

071200     IF SAVE-CONFIRMING-FLAG = "X"
071300         MOVE CONFIRMING-LIT           TO  DE2-CONFIRMLIT
071400     ELSE
071500         MOVE NON-CONFIRMING-LIT       TO  DE2-CONFIRMLIT.
071600     MOVE SAVE-CONFIRM-VERBAGE         TO  DE2-CONFIRM-VERB.
071700     MOVE SAVE-STD-INST-LIST           TO  DE2-STD-INST-LIST.
071800
071900 62-GSI-X.
072000     EXIT.
072100
072200 62-CALCULATE-INVOICE-PAYMENTS.
072300     IF PAYMENTS-CALCULATED
072400         GO TO 62-CIP-X
072500     ELSE
072600         MOVE "Y"  TO  PAYMENTS-CALCULATED-SW.
           MOVE 0 TO COND-WORD.
           MOVE PO-ARG TO PORCVNO OF DINVRCDH-REC-I.
           START DINVRCDH-I KEY = PORCVNO OF DINVRCDH-REC-I
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
                   GO TO 62-CIP-X
               ELSE
073400             MOVE "DBFIND DINVRCD*62-CIP"  TO  BU-DISPLAY-MSG
073500             GO TO 2-BLOWUP.
073600
074000 62-GET-DINVRCD.
           MOVE 0 TO COND-WORD.
           READ DINVRCDH-I NEXT INTO BUF-DINVRCD-H
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14"
                   MOVE 15 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.
           IF PORCVNO OF DINVRCDH-REC-I NOT = PO-ARG
               MOVE 15 TO COND-WORD.

074800     IF COND-WORD NOT = ZERO
074900         IF COND-WORD = 15
075000             ADD S-INVOICE-PAYMENTS-AMT  TO
075100                 S-INVOICE-PAYMENTS-ROUND  ROUNDED
075200             MOVE S-INVOICE-PAYMENTS-ROUND  TO
075300                  DE2-INV-PAYMENTS
075400             SUBTRACT S-INVOICE-PAYMENTS-ROUND  FROM
075500                 POH-BUDGET-AMT  GIVING  DE2-OPEN-BUDGET-AMT
075600             MULTIPLY S-CPW-DEDUCTS  BY  -1 GIVING S-CPW-DEDUCTS
075700             MOVE S-CPW-DEDUCTS  TO  DE2-CPW-DEDUCTS
075800             MOVE S-CPW-PAYMENTS  TO  DE2-CPW-PAYMENTS
075900             SUBTRACT S-CPW-PAYMENTS  FROM  S-CPW-DEDUCTS
076000                 GIVING DE2-CPW-BALANCE
076100             GO TO 62-CIP-X
076200         ELSE
076300             MOVE "DBGET DINVRCD*62-GD"  TO  BU-DISPLAY-MSG
076400             GO TO 2-BLOWUP.
076500
076600     IF INVH-STATUS = "I" OR "H"
076700         NEXT SENTENCE
076800     ELSE
076900         ADD INVH-NET-DUE-VENDOR  TO
077000             S-INVOICE-PAYMENTS-AMT
077100         IF CEH-EXT-ACCTG-DATA-1 = "113930000"
077200             IF CEH-EXT-VALUE-1 < ZEROS
077300                 ADD CEH-EXT-VALUE-1 TO S-CPW-DEDUCTS
077400             ELSE
077500                 ADD CEH-EXT-VALUE-1 TO S-CPW-PAYMENTS.
077600
077700     GO TO 62-GET-DINVRCD.
077800
077900 62-CIP-X.
078000     EXIT.

       63-SELECT-HEADER2-SCREEN.
      *M
      *M ------- THIS IS A CASE TO SELECT THE SCREEN FOR HEARER2
      *M
           IF POH-INVOICELESS-INDIC    = "X" AND
              POH-NO-CHECK-INDIC     = "X"
                MOVE "NO CHECK/INVOICELESS"   TO DE2-INDIC-MSG
           ELSE
           IF POH-INVOICELESS-INDIC    = "X" AND
              POH-NO-CHECK-INDIC NOT = "X"
                MOVE "    INVOICELESS     "   TO DE2-INDIC-MSG
           ELSE
           IF POH-INVOICELESS-INDIC   NOT = "X" AND
              POH-NO-CHECK-INDIC        = "X"
                MOVE "    NO  CHECK       "   TO DE2-INDIC-MSG
           ELSE
                MOVE SPACES                   TO DE2-INDIC-MSG.

       63-SHS-EXIT.
           EXIT.

      *------- DISPLAY VENDOR INFORMATION.
       65-DISPLAY-VENDOR.
           MOVE 22                     TO  LANG-SETNUM.
           MOVE 18                     TO  LANG-MSGNUM.
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
           MOVE MESSAGE-BUFFER         TO  VDE-TITLE.
           MOVE DE-VENDOR-BUFFER       TO  DISPLAY-REC.
           PERFORM 998-WRITE-SCREEN THRU 998-READ-SCREEN.

       65-DV-X.    EXIT.

082400
082500 73-PGM-ERROR.
           MOVE B"1" TO IND (FIELD-NUMBER), IND (99).
           MOVE MESSAGE-BUFFER  TO DE1-MESSAGE-LINE
                                   DE2-MESSAGE-LINE
                                   DE1-MESSAGE-LINE-E
                                   DE1-MESSAGE-LINE-L
                                   DE1-MESSAGE-LINE-E-L.
083800 73-PGM-ERROR-X.
083900     EXIT.
084000
       COPY DISPCALL IN COPYLIB.
086600
086700 999-CATREAD.
           IF CATREAD-MSG-NUMBER = ZEROS
               MOVE LANG-SETNUM TO CATREAD-MSG-SET
               MOVE LANG-MSGNUM TO CATREAD-MSG-NUM.
           CALL "CCATREAD" USING CATREAD-PARMS.
           MOVE CATREAD-MSG-TEXT TO MESSAGE-BUFFER.
088300 999-CATREAD-EXIT.
088400     EXIT.
