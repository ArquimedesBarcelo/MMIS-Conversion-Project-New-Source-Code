024100**********************************************************
024200
       01  FILE-STATUS.
           05  FILE-STATUS-1    PIC X(1)    VALUE "0".
           05  FILE-STATUS-2    PIC X(1)    VALUE "0".

024300 01  ACCTG-BASE           PIC X(10)   VALUE "  CSACCT;".
024400 01  ACCTG-PASSWORD       PIC X(8)    VALUE "ACTION; ".

       COPY DATAB IN COPYLIB.

028400 01  DATASET-NAMES.
028500     05  DSET-DTRANS      PIC X(16)  VALUE "DTRANS;".
028600     05  DSET-DPODATA     PIC X(16)  VALUE "DPODATAITM;".
028700
