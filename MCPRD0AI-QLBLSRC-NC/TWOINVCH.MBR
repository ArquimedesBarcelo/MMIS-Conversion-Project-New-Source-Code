      * 06SEP1996 REVISED PROGRAM TO CALL TBLOWUP FOR FATAL ERRORS.
       COPY TBLOWUP IN COPYLIB.

032100********************************************************
032200**      C D E S C   P A R A M E T E R S               **
032300********************************************************
032400
032500 COPY CDESC IN COPYLIB.
032600
032700 01  CDE-CODE                         PIC X(8).
032800
032900 01  C-BASE                            PIC X(10).
033000
       COPY TDATECHK IN COPYLIB.
033100
033200
033300 PROCEDURE DIVISION.
033400
033500 001-BEGIN SECTION.
033600
033700 010-MAINLINE.
           MOVE "C" TO MCXCBLERR-SCOPE.
           CALL "MCXCBLERR" USING MCXCBLERR-SCOPE.

033800     SORT SORT-FILE ON ASCENDING KEY SORT-TRANS-DATE
033900                                     SORT-ACCOUNT
034000     INPUT PROCEDURE IS 050-PROCESS-TRANS
034100     OUTPUT PROCEDURE IS 700-CREATE-REPORT.
034200     PERFORM 1000-CLOSE-FILES.
034300     GOBACK.
034400
034600 050-PROCESS-TRANS SECTION.
       050-PROCESS-TRANS-PARA.
034700     PERFORM 100-BEGIN.
034800     PERFORM 200-PROCESS-DETAIL
034900         UNTIL END-OF-FILE.
035000
035100**********************************************************
035200*  TRANSFER CONTROL TO LAST STATEMENT IN INPUT PROCEDURE *
035300*  FOR SORTING OF RECORDS.                               *
035400**********************************************************
035500
035600     GO TO 699-PROCESS-EXIT.
035700
035800 100-BEGIN.
035900     MOVE SPACES TO BU-DISPLAY-AREA.
           PERFORM 9999-OPEN-STUFF.
038100     MOVE SPACES TO SORT-REC.
038200     MOVE 0 TO SORT-VALUE
038300               SORT-QUANTITY.
           PERFORM 9999-INIT-DTRANS-MC-I.
038400     PERFORM 400-GET-DTRANS.
038500
038700 200-PROCESS-DETAIL.
038800     IF TRANS-DOCUMENT-NUM = "PROC"
038900         NEXT SENTENCE
039000     ELSE
039100     IF TRANS-CODE = "INV" OR "FRT"
039200         IF TRANS-ACCT > "009999"
039300             PERFORM 520-GET-DESCR
039400             PERFORM 600-BUILD-SORT-REC
039500         ELSE
039600             NEXT SENTENCE
039700     ELSE
039800         NEXT SENTENCE.
039900     PERFORM 400-GET-DTRANS.
040000
040200 400-GET-DTRANS.
           PERFORM 9999-DBGET2-DTRANS-MC-I.
041000     IF GOOD-CALL
041100         NEXT SENTENCE
041200     ELSE
041300         IF END-OF-FILE
041400             NEXT SENTENCE
041500         ELSE
041600             MOVE "DBGET DTRANS * 400-GET" TO
041700                  BU-DISPLAY-MSG
041800             MOVE COND-WORD TO BU-DISPLAY-FLD9 (1)
041900             PERFORM 990-BLOWUP.
042000
042200 520-GET-DESCR.
042300     IF TRANS-STORES-CODE = "NON-STR"
042400         PERFORM 530-GET-PO-DESCR
042500     ELSE
042600         MOVE "01" TO CDESC-RET-CODE
042700         MOVE TRANS-STORES-CODE TO CDE-CODE
042800         MOVE BASE TO C-BASE
042900         CALL "CDESC"  USING CDESC-RET-CODE
043000                             C-BASE
043100                             STATUS-AREA
043200                             BU-DISPLAY-MSG
043300                             CDE-CODE
043400                             CDESC-DATA
043500         MOVE CDESC (1) TO SORT-DESCR.
043600
043700 530-GET-PO-DESCR.
043800     MOVE "P" TO KEY-REC-ID.
043900     MOVE TRANS-ORDER-NUM TO KEY-PO-NO.
044000     MOVE TRANS-RELEASE TO KEY-PO-REL.
044100     MOVE "000" TO KEY-PO-REC.
           PERFORM 9999-DBFIND-DPODATAITM-PO-I.
044800     IF GOOD-CALL
044900         PERFORM 540-CONT-DESCR UNTIL ITEM-FOUND = 1
045000                    OR END-OF-CHAIN
045100         MOVE 0 TO ITEM-FOUND
045200     ELSE
045300         IF NO-ENTRY
      *             *NO-ENTRY (COND-WORD 17) CANNOT OCCUR ON AS/400
      *             *WITH THE LOGIC THAT IS BEING USED.  THE FIRST
      *             *DBGET5 WILL RESULT IN END-OF-CHAIN (COND-WORD 15)
045400              DISPLAY "NO FIND FOR PO NUM " PO-KEY-ARG
045500         ELSE
045600              MOVE "DBFIND PODATAITM * 530-GET"
045700                   TO BU-DISPLAY-MSG
045800              MOVE COND-WORD TO BU-DISPLAY-FLD9 (1)
045900              PERFORM 990-BLOWUP.
046000
046100 540-CONT-DESCR.
           PERFORM 9999-DBGET5-DPODATAITM-PO-I.
046900     IF GOOD-CALL
047000         IF TRANS-ITEM-NUM = DATAITM-ITEM-NO
047100             IF DATAITM-LINE-NO = "01"
047200                 MOVE DATAITM-INFO TO SORT-DESCR
047300                 MOVE 1 TO ITEM-FOUND
047400             ELSE
047500                 NEXT SENTENCE
047600         ELSE
047700             NEXT SENTENCE
047800     ELSE
047900         IF END-OF-CHAIN
048000             MOVE SPACES TO SORT-DESCR
048100         ELSE
048200             MOVE "DBGET PODATAITM * 540-CONT"
048300                    TO BU-DISPLAY-MSG
048400             MOVE COND-WORD TO BU-DISPLAY-FLD9 (1)
048500             PERFORM 990-BLOWUP.
048600
048800 600-BUILD-SORT-REC.
048900     MOVE TRANS-DATE-CN TO SORT-TRANS-DATE.
049000     MOVE TRANS-ACCT TO SORT-ACCOUNT.
049100     MOVE TRANS-DOCUMENT-NUM TO SORT-DOCUMENT-NO.
049200     MOVE TRANS-DEPT TO SORT-DEPT.
049300     MOVE TRANS-PO-NUM TO SORT-PO-NUMBER.
049400     MOVE TRANS-ITEM-NUM TO SORT-ITEM.
049500     MOVE TRANS-CLASS TO SORT-CLASS.
049600     MOVE TRANS-STORES-CODE TO SORT-MATL-CODE.
049700     MOVE TRANS-UNIT-MEASURE TO SORT-UM.
049800     MOVE TRANS-QTY TO SORT-QUANTITY.
049900     MOVE TRANS-VALUE TO SORT-VALUE.
050000
050100     RELEASE SORT-REC.
050200     MOVE SPACES TO SORT-REC.
050300     MOVE 0 TO SORT-QUANTITY
050400               SORT-VALUE.
050500
050800 699-PROCESS-EXIT.
050900     EXIT.
051000
051100 700-CREATE-REPORT SECTION.
       700-CREATE-REPORT-PARA.
051200     DISPLAY "BEGIN REPORT".
051300     PERFORM 710-BEGIN-REPORT.
051400     PERFORM 720-PROCESS-TRANS
051500        UNTIL NO-MORE-SORT = "YES".
051600
051700**************************************************
051800**  BRANCH TO LAST STATEMENT OF OUTPUT SECTION  **
051900**  TO COMPLETE PROCESSING OF REPORT            **
052000**************************************************
052100
052200     GO TO 799-CREATE-EXIT.
052300
052400 710-BEGIN-REPORT.
052500     OPEN OUTPUT ONLINE-PRT.
052600     MOVE "NO" TO NO-MORE-SORT.
052700     RETURN SORT-FILE
052800        AT END
052900            MOVE "YES" TO NO-MORE-SORT.
053000     MOVE 0 TO DATE-TOTAL.
053100     MOVE 0 TO ACCOUNT-TOTAL.
053200     MOVE SORT-TRANS-DATE TO SAVE-DATE.
053300     MOVE SORT-MM TO HDR4-MM.
053400     MOVE SORT-DD TO HDR4-DD.
053500     MOVE SORT-YY TO HDR4-YY.
053600     PERFORM 750-PRINT-HEADINGS.
053700
053900 720-PROCESS-TRANS.
054000     PERFORM 721-PROCESS-ACCOUNT
054100         UNTIL SORT-TRANS-DATE NOT = SAVE-DATE
054200            OR NO-MORE-SORT = "YES".
054300     PERFORM 740-END-DATE.
054400
054600 721-PROCESS-ACCOUNT.
054700     PERFORM 722-BEGIN-ACCOUNT.
054800     PERFORM 723-PROCESS-ACCOUNT
054900         UNTIL SORT-ACCOUNT NOT = SAVE-ACCOUNT
055000            OR SORT-TRANS-DATE NOT = SAVE-DATE
055100            OR NO-MORE-SORT = "YES".
055200     PERFORM 730-END-ACCOUNT.
055300
055500 722-BEGIN-ACCOUNT.
055600     MOVE SORT-ACCOUNT TO SAVE-ACCOUNT.
055700     MOVE SORT-ACCOUNT TO PRT-HEADER-ACCT-NO.
055800     MOVE SORT-ACCOUNT TO PRT-TOTAL-ACCT-NO.
055900     MOVE 0 TO ACCOUNT-TOTAL.
056000
056200 723-PROCESS-ACCOUNT.
056300     MOVE SORT-MANIFEST-NO TO PRT-MANIFEST-NO.
056400     MOVE SORT-REGISTER-NO TO PRT-REGISTER-NO.
056500     MOVE SORT-DEPT TO PRT-DEPT.
056600     MOVE SORT-ORDER-NUM TO PRT-PO-NUM.
056700     MOVE SORT-PO-REL TO PRT-PO-REL.
056800     MOVE SORT-ITEM TO PRT-ITEM.
056900     MOVE SORT-CLASS TO PRT-CLASS.
057000     MOVE SORT-MATL-CODE TO PRT-MATL-CODE.
057100     MOVE SORT-UM TO PRT-UM.
057200     MOVE SORT-QUANTITY TO PRT-QUANTITY.
057300     MOVE SORT-VALUE TO PRT-VALUE.
057400     MOVE SORT-DESCR TO WS-PO-DESCR.
057500     MOVE DESCR1 TO PRT-DESCR1.
057600     ADD SORT-VALUE TO ACCOUNT-TOTAL.
057700     WRITE PRT-REC FROM DETAIL-LINE1 AFTER 2.
057800     MOVE SPACES TO PRT-REC
057900                    DETAIL-LINE1.
058000     MOVE DESCR2 TO PRT-DESCR2.
058100     WRITE PRT-REC FROM DETAIL-LINE2 AFTER 1.
058200     MOVE SPACES TO PRT-REC
058300     ADD 3 TO LINE-CNT.
058400     IF LINE-CNT > 54
058500         PERFORM 750-PRINT-HEADINGS.
058600
058700     RETURN SORT-FILE
058800         AT END
058900             MOVE "YES"  TO NO-MORE-SORT.
059000
059200 730-END-ACCOUNT.
059300     ADD ACCOUNT-TOTAL TO DATE-TOTAL.
059400     MOVE ACCOUNT-TOTAL TO PRT-ACCOUNT-TOTAL.
059500     WRITE PRT-REC FROM TOTAL-ACCOUNT-LINE AFTER 1.
059600     WRITE PRT-REC FROM BLANK-LINE AFTER 2.
059700     ADD 3 TO LINE-CNT.
059800     IF LINE-CNT > 54
059900         PERFORM 750-PRINT-HEADINGS.
060000     MOVE SPACES TO PRT-REC.
060100     MOVE 0 TO ACCOUNT-TOTAL.
060200     MOVE SORT-ACCOUNT TO SAVE-ACCOUNT.
060300
060500 740-END-DATE.
060600     MOVE DATE-TOTAL TO PRT-DATE-TOTAL.
060700     MOVE SAVE-DATE TO HOLD-DATE.
060800     MOVE HOLD-DATE-MM TO PRT-TOTAL-MM.
060900     MOVE HOLD-DATE-DD TO PRT-TOTAL-DD.
061000     MOVE HOLD-DATE-YY TO PRT-TOTAL-YY.
061100     WRITE PRT-REC FROM TOTAL-DATE-LINE AFTER 2.
061200     MOVE SPACES TO PRT-REC.
061300     MOVE 0 TO DATE-TOTAL.
061400     MOVE SORT-TRANS-DATE TO SAVE-DATE.
061500     IF NO-MORE-SORT = "NO"
061600         MOVE SORT-MM TO HDR4-MM
061700         MOVE SORT-DD TO HDR4-DD
061800         MOVE SORT-YY TO HDR4-YY
061900         PERFORM 750-PRINT-HEADINGS.
062100
062200 750-PRINT-HEADINGS.
           CALL "TDATECHK" USING DATE-CHECK-AREA.
062300*****MOVE CURRENT-DATE TO DATE-H1.
           MOVE DATE-SLASH-OUT TO DATE-H1.
062400*****MOVE TIME-OF-DAY TO TIME-DIV.
           MOVE DATE-UNFORMATTED-TIME-OUT TO TIME-DIV.
062500     MOVE HH-DIV TO HH-H2.
062600     MOVE MM-DIV TO MM-H2.
062700     MOVE SS-DIV TO SS-H2.
062800     ADD 1 TO PAGE-CNT.
062900     MOVE PAGE-CNT TO PAGE-H2.
063000     WRITE PRT-REC FROM HEADER1 AFTER ADVANCING NEW-PAGE.
063100     WRITE PRT-REC FROM HEADER2 AFTER ADVANCING 1.
063200     WRITE PRT-REC FROM HEADER3 AFTER ADVANCING 2.
063300     WRITE PRT-REC FROM HEADER4 AFTER ADVANCING 3.
063400     MOVE 5 TO LINE-CNT.
063500
063700 799-CREATE-EXIT.
063800     EXIT.
063900
064000 900-ERROR SECTION.
064100
064200 990-BLOWUP.
           MOVE "TWOINVCH" TO BU-PGM-NAME.
           CALL "TBLOWUP" USING ACCTG-BASE, BU-PGM-NAME, STATUS-AREA,
               DUMMY-VIEW-AREA, FILE-STATUS, BU-DISPLAY-MSG,
                       BU-DISPLAY-FLDS.

067100 1000-CLOSE-FILES.
067200     CLOSE ONLINE-PRT.
           PERFORM 9999-CLOSE-STUFF.

       9999-ROUTINES SECTION.
       9999-DBGET2-DTRANS-MC-I.
           MOVE 0 TO COND-WORD.
           READ DTRANS-MC-I NEXT INTO BUF-DTRANS
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS-1 = "1" OR FILE-STATUS = "46"
               MOVE 11 TO COND-WORD
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD.

       9999-INIT-DTRANS-MC-I.
           MOVE SPACES TO MATLCODE OF DTRANS-MC-REC-I.
           START DTRANS-MC-I KEY >= MATLCODE OF DTRANS-MC-REC-I
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.

       9999-DBFIND-DPODATAITM-PO-I.
           MOVE 0 TO COND-WORD.
           MOVE PO-KEY-ARG TO PORCVNO OF DPODATAITM-PO-REC-I.
           START DPODATAITM-PO-I KEY = PORCVNO OF DPODATAITM-PO-REC-I
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF (FILE-STATUS NOT = "00") AND (FILE-STATUS-1 NOT = "2")
               MOVE 99 TO COND-WORD.

       9999-DBGET5-DPODATAITM-PO-I.
           MOVE 0 TO COND-WORD.
           READ DPODATAITM-PO-I NEXT INTO BUF-DPODATAITM
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   MOVE 15 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD
           ELSE
           IF PORCVNO OF DPODATAITM-PO-REC-I NOT = PO-KEY-ARG
               MOVE 15 TO COND-WORD.

       9999-OPEN-STUFF.
           OPEN INPUT DTRANS-MC-I          .
           OPEN INPUT DPODATAITM-PO-I      .

       9999-CLOSE-STUFF.
           CLOSE      DTRANS-MC-I          .
           CLOSE      DPODATAITM-PO-I      .
