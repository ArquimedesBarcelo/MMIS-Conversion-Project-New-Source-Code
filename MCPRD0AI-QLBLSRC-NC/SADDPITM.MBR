       01  DSET-NAMES.
           05  DSET-NAME              PIC X(16)  VALUE SPACES.
           05  DSET-MSTORERM          PIC X(16)  VALUE "MSTORERM;".
           05  DSET-MREQ              PIC X(16)  VALUE "MREQ;".
           05  DSET-DREQD             PIC X(16)  VALUE "DREQD;".
           05  DSET-DREQITM           PIC X(16)  VALUE "DREQITM;".
           05  DSET-DREQDESC          PIC X(16)  VALUE "DREQDESC;".
           05  DSET-DVENDITM          PIC X(16)  VALUE "DVENDITM;".
           05  DSET-DPOITEM           PIC X(16)  VALUE "DPOITEM;".
           05  DSET-DVENDOR           PIC X(16)  VALUE "DVENDOR;".
           05  DSET-MCOMMENT          PIC X(16)  VALUE "MCOMMENT;".
           05  DSET-DDAILYTC          PIC X(16)  VALUE "DDAILYTC;".
           05  DSET-MVALIDUM          PIC X(16)  VALUE "MVALIDUM;".
           05  DSET-DPODATAITM        PIC X(16)  VALUE "DPODATAITM;".
           05  DSET-MTAX              PIC X(16)  VALUE "MTAX;".
           05  DSET-MVALIDPLTDATA  PIC X(16) VALUE "MVALIDPLTDATA;".
           05  DSET-MPLTINFO          PIC X(16)  VALUE "MPLTINFO;".
           05  DSET-MCLASS            PIC X(16)  VALUE "MCLASS;".

       01 ITEMS-LISTING.
           05  ALL-ITEMS              PIC XX    VALUE "@;".
           05  CODE-SEARCH            PIC X(10) VALUE "CORP-CODE;".
           05  REQ-SEARCH             PIC X(12) VALUE "REQ-NUMBER;".
           05  PO-SEARCH              PIC X(10) VALUE "PO-RCV-NO;".
           05  VEN-SEARCH             PIC X(10) VALUE "VEN-CODE;".

       01 ARG-VALUES.
           05  CODE-ARG               PIC X(8)  VALUE SPACES.
           05  REQ-ARG                PIC X(12) VALUE SPACES.
           05  MVALIDPLT-ARG.
               10  MVALIDPLT-ARG-1-2  PIC X(2)  VALUE SPACES.
               10  MVALIDPLT-ARG-3-10.
                   15  MVALIDPLT-ARG-3-8  PIC X(6) VALUE SPACES.
                   15  FILLER             PIC XX   VALUE SPACES.
           05  PO-ARG                 PIC X(14) VALUE SPACES.
           05  COMMENT-ARG            PIC X(4)  VALUE SPACES.
           05  UM-ARG                 PIC X(2)  VALUE SPACES.
           05  TAX-ARG                PIC X(2)  VALUE SPACES.
           05  PLT-ARG                PIC X(4)  VALUE SPACES.

      *****************************************
      *   PARAMETERS FOR CALLING SEDIPOLG
      *****************************************

       01  SEDIPOLG-PARMS.
           05  PO-NUMBER-EDI      PIC X(14) VALUE SPACES.
           05  VENDOR-CODE-EDI    PIC X(10) VALUE SPACES.
           05  FLAGS-EDI.
               10  FLAG-EDI-A     PIC X     VALUE SPACE.
               10  FLAG-EDI-M     PIC X     VALUE SPACE.
               10  FLAG-EDI-D     PIC X     VALUE SPACE.
               10  FLAG-EDI-SEND  PIC X     VALUE SPACE.
               10  FILLER         PIC XX    VALUE SPACES.
           05  PO-ITEM-NO-EDI     PIC X(4)  VALUE SPACES.
           05  CALLING-PGM-EDI    PIC X(8)  VALUE SPACES.

      *****************************************
      *   PARAMETERS FOR CALLING 'SEDIVNCK'
      *   WHICH IS THE ROUTINE TO DETERMINE
      *   IF VENDOR IS EDI OR NOT
      *****************************************

       COPY SEDIVNCK IN COPYLIB.

