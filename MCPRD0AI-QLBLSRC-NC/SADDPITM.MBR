       COPY SCALCBGT IN COPYLIB.

       01  RET-CODE                     PIC X(2)   VALUE SPACES.

      *************************************************************
      **                                                         **
      **          E R R O R   M E S S A G E   A R E A S          **
      **                                                         **
      *************************************************************

       COPY TBLOWUP IN COPYLIB.



       LINKAGE SECTION.

       01  BASE             PIC X(10).

       01  BASE-MMISA       PIC X(24).

       01  BUILD-PO-SEARCH.
           05  PO-PREFIX           PIC X.
           05  PO-NO-REL.
               10  PO-NO           PIC X(7).
               10  PO-REL          PIC X(3).
           05  PO-RCV              PIC X(3).

       01  VEN-ARG          PIC X(10).

       COPY VCOMLINK IN COPYLIB.

      ***********************************
      **  PARAMETERS FOR 'SADDPITM'
      ***********************************

       COPY SADDPITM IN COPYLIB.

      **************************************
      *                                    *
      *  PRINTCNTL IS SET TO 1 THIS CAUSES *
      *  THE FIELD ON A SCREEN PRINTOUT    *
      *  TO BE UNDERLINED                  *
      *                                    *
      *  PAGECNTL IS SET TO 49 (OCTAL 61)  *
      *  THIS CAUSE THE LP TO EJECT AFTER  *
      *  THE SCREEN IS PRINTED             *
      *                                    *
      **************************************

       01  SCREEN-PRINT-PARMS.
           05  PRINTCNTL             PIC S9(4)    COMP-4.
           05  PAGECNTL              PIC S9(4)    COMP-4.
           05  SPOOLFIL-OPEN-SW      PIC X.

       01  PASSED-SPOOL-PRT          PIC S9(2)    COMP-4.

       COPY LANGSUB IN COPYLIB.

       PROCEDURE DIVISION USING  BASE,
                                 BASE-MMISA,
                                 BUILD-PO-SEARCH,
                                 VEN-ARG,
                                 VIEW-COMAREA,
                                 ADD-ITEM-PARMS,
                                 SCREEN-PRINT-PARMS,
                                 PASSED-SPOOL-PRT,
                                 LANGUAGE-PARMS.


       ADD-ITEM SECTION 02.

       BEGIN-HERE.
           OPEN INPUT DPOITEM-I, MVALIDUM-I, MVALIDPLTDATA-I,
                      MCOMMENT-I, MSTORERM-I, MTAX-I, MREQ-I,
                      DREQD-I, DREQDESC-I, DREQITM-I, DVENDITM-I,
                      DVENDOR-I, MPLTINFO-PK-I, MCLASS-I DPOITEM-L1.
           OPEN I-O DISPLAY-FILE, DPOITEM-O, DPODATAITM-O, DDAILYTC-O.

           PERFORM 1-INIT.
           PERFORM 6-MAIN THRU 6-M-X.

           CLOSE DPOITEM-I, MVALIDUM-I, MVALIDPLTDATA-I, MCOMMENT-I,
                 MSTORERM-I, MTAX-I, MREQ-I, DREQD-I, DREQDESC-I,
                 DREQITM-I, DVENDITM-I, DVENDOR-I, DPOITEM-O,
                 DPODATAITM-O, DDAILYTC-O, DISPLAY-FILE, MPLTINFO-PK-I,
                 MCLASS-I, DPOITEM-L1.

           GOBACK.

       1-INIT.

      *
      * FIND THE ENTRY THAT CONTAINS THE GST INFORMATION
      *
           MOVE "Y" TO HANDLE-BLOWUP-FLAG.
           MOVE 0 TO GST-ENTRY.
           MOVE "PTX1" TO PLT-ARG.
           PERFORM 9999-GETKEY-MPLTINFO-PK-I.
           IF NOT GOOD-CALL
             MOVE "GETKEY MPLTINFO 1-INIT" TO BU-DISPLAY-MSG
             MOVE PLT-ARG TO BU-DISPLAY-FLD(1)
             PERFORM 2100-BLOWUP
           END-IF.
           PERFORM VARYING SUB FROM 1 BY 1
                   UNTIL GST-ENTRY > 0 OR
                         SUB > 2

             IF MPLTINFO-TAX-DISTRICT(SUB) = "GST"
               MOVE SUB TO GST-ENTRY
             END-IF

           END-PERFORM.

           IF GST-ENTRY EQUAL ZERO

             MOVE "PTX2" TO PLT-ARG
             PERFORM 9999-GETKEY-MPLTINFO-PK-I
             IF NOT GOOD-CALL
               MOVE "GETKEY MPLTINFO 1-INIT" TO BU-DISPLAY-MSG
               MOVE PLT-ARG TO BU-DISPLAY-FLD(1)
               PERFORM 2100-BLOWUP
             END-IF
             PERFORM VARYING SUB FROM 1 BY 1
                     UNTIL GST-ENTRY > 0 OR
                           SUB > 2

               IF MPLTINFO-TAX-DISTRICT(SUB) = "GST"
                 COMPUTE GST-ENTRY = SUB + 2
               END-IF

             END-PERFORM

           END-IF.

      *
      * CHECK FOR EXISTENCE OF TAXGST FILE
      *  IF IT EXISTS THIS MEANS TO APPLY TAXES OTHER THAN GST
      *  ON BASE + GST ( DOUBLE TAXATION )
      *
           OPEN INPUT TAXGST-FILE.
           IF FILE-STATUS NOT EQUAL ZERO
             SET DONT-TAX-ON-GST TO TRUE
           ELSE
             SET TAX-ON-GST TO TRUE
           END-IF.
           CLOSE TAXGST-FILE.

           MOVE "PACD" TO PLT-ARG.
           PERFORM 9999-GETKEY-MPLTINFO-PK-I.
           IF NOT GOOD-CALL
               MOVE "N"                TO  SAVE-PACD-SW
           ELSE
           MOVE MPLTINFO-PACD-SW       TO  SAVE-PACD-SW.

           MOVE "PREQ" TO PLT-ARG.
           PERFORM 9999-GETKEY-MPLTINFO-PK-I.
           IF NOT GOOD-CALL
               MOVE "N"                TO  REQ-COMPARE-PERCENT-SW
               MOVE 0                  TO  REQ-COMPARE-PERCENT
           ELSE
           IF MPLTINFO-RQ-COMPARE-PRICE-SW = "Y"
               MOVE MPLTINFO-RQ-COMPARE-PRICE-SW
                                       TO  REQ-COMPARE-PERCENT-SW
               MOVE MPLTINFO-RQ-COMPARE-PERCENT
                                       TO  REQ-COMPARE-PERCENT.

           MOVE "PCPO" TO PLT-ARG.
           PERFORM 9999-GETKEY-MPLTINFO-PK-I.
           IF NOT GOOD-CALL
               MOVE "N"                TO  SAVE-PCPO-SW
           ELSE
           MOVE MPLTINFO-PCPO-SW       TO  SAVE-PCPO-SW.

           MOVE "CHAT" TO PLT-ARG.
           PERFORM 9999-GETKEY-MPLTINFO-PK-I.
           IF NOT GOOD-CALL
               MOVE "N"                TO  SAVE-CHAT-SW
           ELSE
           MOVE MPLTINFO-CHAT-PURCH-REQUIRED TO  SAVE-CHAT-SW.

      ********************************************************
      *    RETRIEVE DSTR KEY TO DETERMINE THE STOREROOM      *
      *    DEPARTMENT.                                       *
      ********************************************************
           MOVE "DSTR" TO PLT-ARG.
           PERFORM 9999-GETKEY-MPLTINFO-PK-I.
           IF NOT GOOD-CALL
               MOVE "GETKEY MPLTINFO ERR" TO BU-DISPLAY-MSG
               MOVE PLT-ARG               TO BU-DISPLAY-FLD (1)
               GO TO 2100-BLOWUP
           ELSE
               MOVE MPLTINFO-DEPT-STR (1) TO SAVE-STOREROOM-DEPT.

           MOVE SPACE                  TO  SAVE-CONSIGN-PO-TYPE.

      *-------- IF SPOMOD CALLED THIS PROGRAM, NONPAY-PO-SW WILL
      *-------- CONTAIN A VALUE SO THAT THIS PROGRAM CAN DETERMINE
      *-------- IF THIS IS A CONSIGNED OR NON-CONSIGNED PO.
           IF FRANCHISE-VEND-SW = "Y"
               IF NONPAY-PO-SW = "Y"
                   MOVE "C"            TO  SAVE-CONSIGN-PO-TYPE
               ELSE
                   MOVE "N"            TO  SAVE-CONSIGN-PO-TYPE.

      ******************************************************
      **                                                  **
      **   BLOWUP ROUTINE                                 **
      **                                                  **
      ******************************************************

       2100-BLOWUP.
           IF FILE-STATUS NUMERIC
               MOVE FILE-STATUS TO COND-WORD.
           MOVE "SADDPITM"  TO  BU-PGM-NAME.
           CALL "TBLOWUP" USING BASE, BU-PGM-NAME, STATUS-AREA,
               VIEW-COMAREA, FILE-STATUS, BU-DISPLAY-MSG,
                   BU-DISPLAY-FLDS.




       4-PGM-ERROR.
           MOVE B"1" TO IND(FIELD-NUMBER), IND(99).

       4-PGM-ERROR-X.
           EXIT.


       6-MAIN.
           MOVE BUILD-PO-SEARCH       TO  PO-ARG,
                                          BU-DISPLAY-FLD (1).
           PERFORM 61-FIND-LAST-ITEM  THRU  61-FLI-X.

           PERFORM 62-PROCESS-ITEM-DATA  THRU  62-PID-X.

       6-M-X.
           EXIT.


      ********************************************
      *
      *   FIND THE LAST ITEM ON THE PO IF THIS
      *   IS A NEW PO THEN THE PO-TYPE WILL BE
      *   SPACES
      *
      ********************************************

       61-FIND-LAST-ITEM.
           MOVE ZEROS                 TO  ITEM-NO-SAVE.
           MOVE SPACES                TO  SUB-SAVE,
                                          SUBD-SAVE,
                                          ADDTL-DATA-SAVE,
                                          SAVE-TAX-CODE
                                          REQ-SUBD-SAVE.

           MOVE 0 TO COND-WORD.
           MOVE PO-ARG TO PORCVNO OF DPOITEM-REC-I.
           START DPOITEM-I KEY = PORCVNO OF DPOITEM-REC-I
               INVALID KEY GO TO 61-FLI-X.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
                   GO TO 61-FLI-X
               ELSE
                   MOVE 99 TO COND-WORD.
      *    CALL "DBFIND" USING BASE, DSET-DPOITEM, MODE1,
      *           STATUS-AREA, PO-SEARCH, PO-ARG.
           IF COND-WORD NOT = 0
               MOVE "FIND DPOITEM * 61-FLI" TO BU-DISPLAY-MSG
               GO TO 2100-BLOWUP.

       61-GET-DPOITEM.
           MOVE 0 TO COND-WORD.
           READ DPOITEM-I NEXT INTO BUF-DPOITEM
               AT END MOVE 15 TO COND-WORD.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14"
                   MOVE 15 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.
           IF PORCVNO OF DPOITEM-REC-I NOT = PO-ARG
               MOVE 15 TO COND-WORD.
      *    CALL "DBGET" USING BASE, DSET-DPOITEM, MODE5,
      *        STATUS-AREA, ALL-ITEMS, BUF-DPOITEM, PO-ARG.
           IF COND-WORD NOT = 0
               IF COND-WORD = 15
                   GO TO 61-FLI-X
               ELSE
                   MOVE "GET DPOITEM * 61-GD" TO BU-DISPLAY-MSG
                   GO TO 2100-BLOWUP
           ELSE
               MOVE ITM-NUMBER        TO  ITEM-NO-SAVE
               MOVE ITM-CLASS         TO  SUB-SAVE
               MOVE ITM-SUB-DETL      TO  SUBD-SAVE
               MOVE ITM-ADDL-DATA     TO  ADDTL-DATA-SAVE
               MOVE ITM-TAX-CODE      TO  SAVE-TAX-CODE
               GO TO 61-GET-DPOITEM.

       61-FLI-X.
           EXIT.


      *****************************************************
      *                                                   *
      *   PROCESS PO ITEM INFORMATION SECTION             *
      *                                                   *
      *****************************************************


       62-PROCESS-ITEM-DATA.
      *    MOVE CURRENT-DATE       TO  HP-CUR-DATE.
      *    MOVE CORR HP-CUR-DATE   TO  CUR-DATE.
           ACCEPT CUR-DATE FROM DATE.
      *-------- ACCOUNT FOR CENTURY.
           IF YY OF CUR-DATE > "70"
               MOVE "19"           TO  CUR-DATE-CC
           ELSE
               MOVE "20"           TO  CUR-DATE-CC.
           MOVE ZERO               TO  TOTAL-PO-BUDGET.
           MOVE ZBILL-INDICATOR    TO  ZBILL-PO-SW.
      **  MANUFACTURER SELECTION
           MOVE  13                TO  LANG-SETNUM.
           MOVE  36                TO  LANG-MSGNUM.
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
           MOVE MESSAGE-BUFFER     TO  SAVE-MANUFACT-LIT.
      **  DESCRIPTION/COMMENTS
           MOVE  4                 TO  LANG-SETNUM.
           MOVE  16                TO  LANG-MSGNUM.
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
           MOVE MESSAGE-BUFFER     TO  DESC-COMMENT-LIT.
      **  UNIT VALUE
           MOVE  21                TO  LANG-SETNUM.
           MOVE  6                 TO  LANG-MSGNUM.
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
           MOVE MESSAGE-BUFFER     TO  SAVE-ITEM-VALUE-LIT.
      **  'F1'-PREVIOUS SCREEN 'F3'-END ITEMS
           MOVE  16                TO  LANG-SETNUM.
           MOVE  114               TO  LANG-MSGNUM.
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
           MOVE MESSAGE-BUFFER     TO  PREV-KEY-LABEL.
      **  'F3'-END ITEMS
           MOVE  66                TO  LANG-SETNUM.
           MOVE  050               TO  LANG-MSGNUM.
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
           MOVE MESSAGE-BUFFER     TO  END-ITEMS-KEY-LABEL.
      **  IF ADDITIONAL DESCRIPTION LINES ARE NEEDED ENTER AN 'X' HERE
           MOVE  9                 TO  LANG-SETNUM.
           MOVE  38                TO  LANG-MSGNUM.
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
           MOVE MESSAGE-BUFFER     TO  ADDL-DESC-MSG-LIT.
      **  CURRENCY
           MOVE  3                 TO  LANG-SETNUM.
           MOVE  140               TO  LANG-MSGNUM.
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
           MOVE SPACES             TO  BUILD-CC-LIT.
           MOVE MESSAGE-BUFFER     TO  CURRENCY-LIT.
           IF ADD-ITEM-CUR-CODE = SPACES
               NEXT SENTENCE
           ELSE
               MOVE ADD-ITEM-CUR-CODE   TO  UM-ARG
               MOVE UM-ARG TO VALIDUM OF MVALIDUM-REC-I
               READ MVALIDUM-I INTO BUF-MVALIDUM
               IF FILE-STATUS-1 = "2"
                   NEXT SENTENCE
               ELSE
               IF FILE-STATUS NOT = "00"
                   MOVE "GET MVALIDUM *62-PID" TO BU-DISPLAY-MSG
                   MOVE UM-ARG TO BU-DISPLAY-FLD (1)
                   GO TO 2100-BLOWUP
               ELSE
                   MOVE VALID-CURRENCY-DESC  TO  CUR-CODE-DESC
                   MOVE ADD-ITEM-CUR-CODE    TO  CUR-CODE.

       62-READ-PO-ITEMS.
           MOVE "PURORD2"  TO  VIEW-NFNAME.

      ********************************************************
      **   IF THIS IS THE FIRST ITEM OF AN ORDER
      **   (ITEM-NO=0) THEN GO AND GET THE VENDOR ADDRESS
      **   AND DISPLAY IN DESCRIPTION BLOCK FOR VERIFICATION
      **   PURPOSES FOR THE USER
      ********************************************************

           MOVE SPACES                  TO  SCREEN-2
                                            SCREEN-2L.
           IF ITEM-NO-SAVE = ZERO
               PERFORM 67-GET-VENDOR-ADDRESS  THRU  67-GVA-X.

           MOVE ADD-ITEM-COMPANY-SAVE   TO  DE2-COMPANY-CODE
                                            DE2-COMPANY-CODE-L.
           IF ADD-EDI-PO = "Y"
               MOVE "EDI PO"            TO  DE2-EDIPOLIT
                                            DE2-EDIPOLIT-L.
           MOVE PO-NO                   TO  DE2-PO
                                            DE2-PO-L.
           MOVE PO-REL                  TO  DE2-PO-REL
                                            DE2-PO-REL-L.
           ADD 1                        TO  ITEM-NO-SAVE.
           MOVE ITEM-NO-SAVE            TO  DE2-ITEM-NO,
                                            DE2-ITEM-NO-L,
                                            SEQ-ITEM-NO-SAVE.
           MOVE ZEROS                   TO  SAVE-ITEM-PRICE.
           MOVE ZEROS                   TO  DE2-PRICE, DE2-PRICE-L,
                                            DE2-QTY, DE2-QTY-L,
                                            DE2-ITEM-VALUE,
                                            DE2-ITEM-VALUE-L.
      *    "ENTER REQUISITION NUMBER OR CORP-CODE AND PRESS 'ENTER'"
           MOVE   5 TO LANG-SETNUM.
           MOVE  19 TO LANG-MSGNUM.
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
           MOVE MESSAGE-BUFFER          TO DE2-INSTRUCTIONLINE
                                           DE2-INSTRUCTIONLINE-L.

           IF CUR-CODE-DESC = SPACES
               NEXT SENTENCE
           ELSE
               MOVE BUILD-CC-LIT        TO  DE2-CURRENCY-LIT
                                            DE2-CURRENCY-LIT-L.

           MOVE ADD-INVOICELESS-IND     TO  DE2-INVOICELESS-IND
                                            DE2-INVOICELESS-IND-L.
           IF DE2-INVOICELESS-IND = "X"
               MOVE "INVOICELESS PO"    TO  DE2-INVOICELESS-LIT
                                            DE2-INVOICELESS-LIT-L
           ELSE
           MOVE "              "        TO  DE2-INVOICELESS-LIT
                                            DE2-INVOICELESS-LIT-L.

           IF ITEM-NO-SAVE = 1
               MOVE PREV-KEY-LABEL      TO DE2-COMMAND-LINE
                                           DE2-COMMAND-LINE-L
           ELSE
               MOVE END-ITEMS-KEY-LABEL TO DE2-COMMAND-LINE
                                           DE2-COMMAND-LINE-L.

           MOVE SPACES  TO  CONT-SW,
                            END-OF-REQ-DESC-SW.
           MOVE ZEROS   TO  SUB.

           MOVE "N"     TO  EXP-ERR-SW.

       62-READ-SCREEN-2.
           MOVE SCREEN-2 TO DISPLAY-REC.
           PERFORM 998-WRITE-SCREEN THRU 998-READ-SCREEN.
           MOVE DISPLAY-REC TO SCREEN-2.

           IF SAVE-PCPO-SW = "Y"
               MOVE DE2-REQ-NO    TO DE2-REQ-NO-L
               MOVE DE2-CODE      TO DE2-CODE-L.

           IF VIEW-LASTKEY = 3
               IF ITEM-NO-SAVE = 1
      **        YOU MUST ENTER AT LEAST ONE ITEM FOR THIS ORDER
                   MOVE 25    TO  LANG-SETNUM
                   MOVE 22    TO  LANG-MSGNUM
                   PERFORM 999-CATREAD  THRU  999-CATREAD-EXIT
               ELSE
                   GO TO 62-PID-X
           ELSE
           IF VIEW-LASTKEY = 1
               IF ITEM-NO-SAVE = 1
                   GO TO 62-PID-X
               ELSE
      *            "INVALID FUNCTION KEY ENTERED"
                   MOVE   9 TO LANG-SETNUM
                   MOVE  10 TO LANG-MSGNUM
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE MESSAGE-BUFFER TO DE2-MESSAGE-LINE
                                          DE2-MESSAGE-LINE-L
                   MOVE 12 TO  FIELD-NUMBER
                   PERFORM 4-PGM-ERROR  THRU  4-PGM-ERROR-X
                   GO TO 62-READ-SCREEN-2
           ELSE
           IF VIEW-LASTKEY = 2 OR
              VIEW-LASTKEY = 4 OR
              VIEW-LASTKEY = 5 OR
              VIEW-LASTKEY = 6 OR
              VIEW-LASTKEY = 7 OR
              VIEW-LASTKEY = 8
      *        "INVALID FUNCTION KEY ENTERED"
               MOVE   9 TO LANG-SETNUM
               MOVE  10 TO LANG-MSGNUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER TO DE2-MESSAGE-LINE
                                      DE2-MESSAGE-LINE-L
               MOVE 12 TO  FIELD-NUMBER
               PERFORM 4-PGM-ERROR  THRU  4-PGM-ERROR-X
               GO TO 62-READ-SCREEN-2.

      **********************************************************
      *    THERE ARE 999 ITEMS ON THE P.O. AND BY LETTER FROM  *
      *    DICK CRITCHFIELD DATED  6/4/93 THIS IS THE MAX      *
      **********************************************************
           IF ITEM-NO-SAVE = 1000
               MOVE 20070 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER  TO DE2-MESSAGE-LINE
                                       DE2-MESSAGE-LINE-L
               MOVE 12    TO  FIELD-NUMBER
               PERFORM 4-PGM-ERROR  THRU  4-PGM-ERROR-X
               GO TO 62-READ-SCREEN-2.

       62-FIELD-EDITS.
           IF DE2-REQ-NO = SPACES AND
              DE2-CODE = SPACES
      *        ENTER EITHER A REQUISITION OR CORP-CODE
               MOVE  45041 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER TO DE2-MESSAGE-LINE
                                      DE2-MESSAGE-LINE-L
               MOVE 12 TO  FIELD-NUMBER
               PERFORM 4-PGM-ERROR  THRU  4-PGM-ERROR-X
               GO TO 62-READ-SCREEN-2.

           IF DE2-REQ-NO NOT = SPACES AND
              DE2-CODE NOT = SPACES
      *        ENTER ONLY ONE VALUE - REQUISITION OR CORP-CODE
               MOVE  45045 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER TO DE2-MESSAGE-LINE
                                      DE2-MESSAGE-LINE-L
               MOVE 12 TO  FIELD-NUMBER
               PERFORM 4-PGM-ERROR  THRU  4-PGM-ERROR-X
               GO TO 62-READ-SCREEN-2.

           IF DE2-CODE = "NON-STR"
      *        INVALID CODE, ENTER VALID OR CODE OR 'NC' FOR NON-CODED
               MOVE  45053 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER TO DE2-MESSAGE-LINE
                                      DE2-MESSAGE-LINE-L
               MOVE 31 TO  FIELD-NUMBER
               PERFORM 4-PGM-ERROR  THRU  4-PGM-ERROR-X
               GO TO 62-READ-SCREEN-2.

           IF DE2-REQ-NO NOT = SPACES
               PERFORM 66-PROCESS-REQ-NO  THRU  66-PRN-X
               IF CODE-DUP-SW = "Y"
      *M       "CODE ON REQUISITION ALREADY EXISTS ON REQMT. ORDER"
                   MOVE   3 TO LANG-SETNUM
                   MOVE 623 TO LANG-MSGNUM
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE MESSAGE-BUFFER TO DE2-MESSAGE-LINE
                                          DE2-MESSAGE-LINE-L
                   MOVE 12 TO FIELD-NUMBER
                   PERFORM 4-PGM-ERROR THRU 4-PGM-ERROR-X
                   GO TO 62-READ-SCREEN-2
               ELSE
               IF ERR-SW = "Y"
                   GO TO 62-READ-SCREEN-2
               ELSE
                   NEXT SENTENCE
           ELSE
               PERFORM 66-PROCESS-CODE-NO  THRU  66-PCN-X
               IF CODE-DUP-SW = "Y"
      *    "CODE ALREADY EXISTS ON THIS REQMT. ORDER - TRY AGAIN"
                   MOVE   3 TO LANG-SETNUM
                   MOVE 622 TO LANG-MSGNUM
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE MESSAGE-BUFFER TO DE2-MESSAGE-LINE
                                          DE2-MESSAGE-LINE-L
                   MOVE 31 TO FIELD-NUMBER
                   PERFORM 4-PGM-ERROR THRU 4-PGM-ERROR-X
                   GO TO 62-READ-SCREEN-2
               ELSE
               IF ERR-SW = "Y"
                   GO TO 62-READ-SCREEN-2.

      ***********************************************************
      **   IF THE PLANT IS NOT USING INVOICE PROCESSING AND NO
      **   TAX CODE HAS BEEN LOADED FOR THE SCREEN THEN USE
      **   'NO' AS THE DEFAULT.  THIS IS BASICALLY FOR THE
      **   INTERNATIONAL PLANTS
      ***********************************************************

           IF DE2-TAX-CODE = SPACES
               IF ADD-INVOICING
                   NEXT SENTENCE
               ELSE
                   MOVE "NO"            TO DE2-TAX-CODE
                                           DE2-TAX-CODE-L.

           MOVE SPACES TO RETURN-CHAT-NO.
           IF SAVE-CHAT-SW = "Y"
               IF DS2-CODE = "NC"
                   NEXT SENTENCE
               ELSE
               MOVE DS2-CODE       TO  PASS-CORP-CODE
               CALL "SCHATREF" USING PASS-CORP-CODE,
                                     RETURN-CHAT-NO,
                                     VIEW-COMAREA
               IF RETURN-CHAT-NO = "NOTFND"
                   MOVE SPACES     TO  DS2-CHAT-NO
               ELSE
               MOVE RETURN-CHAT-NO TO  DS2-CHAT-NO.

           IF SAVE-PCPO-SW = "Y"
               IF DE2-REQ-NO-L = SPACES
                   IF SAVE-PACD-SW = "N"
                       MOVE SPACES TO DE2-COMPANY-L, DE2-PRIME-L,
                                      DE2-SUB, DE2-SUB-L,
                                      DE2-SUB-DETL, DE2-SUB-DETL-L,
                                      DE2-ADDTDATA, DE2-ADDTDATA-L.

       62-GETNEXTFORM-2A.
           IF ZBILL-PO
               IF SAVE-PCPO-SW = "Y"
                   IF ADD-INVOICELESS-IND = "X"
                       MOVE "PURORD2CLI" TO  VIEW-NFNAME
                       MOVE SAVE-ITEM-VALUE-LIT TO DE2-ITEM-VALUE-LIT
                                                   DE2-ITEM-VALUE-LIT-L
                   ELSE
                   MOVE "PURORD2CL"      TO  VIEW-NFNAME
                   MOVE SAVE-ITEM-VALUE-LIT TO DE2-ITEM-VALUE-LIT
                                               DE2-ITEM-VALUE-LIT-L
               ELSE
               IF ADD-INVOICELESS-IND = "X"
                   MOVE "PURORD2CI"      TO  VIEW-NFNAME
                   MOVE SAVE-ITEM-VALUE-LIT TO DE2-ITEM-VALUE-LIT
                                               DE2-ITEM-VALUE-LIT-L
               ELSE
      *        IF SAVE-CHAT-SW = "Y"
      *            MOVE "PURORD2CC"      TO  VIEW-NFNAME
      *            MOVE SAVE-ITEM-VALUE-LIT TO DE2-ITEM-VALUE-LIT
      *                                        DE2-ITEM-VALUE-LIT-L
      *        ELSE
               MOVE "PURORD2C"           TO  VIEW-NFNAME
               MOVE SAVE-ITEM-VALUE-LIT  TO  DE2-ITEM-VALUE-LIT
                                             DE2-ITEM-VALUE-LIT-L
           ELSE
           IF SAVE-PCPO-SW = "Y"
               IF ADD-INVOICELESS-IND = "X"
                   MOVE "PURORD2ALI"    TO  VIEW-NFNAME
               ELSE
               MOVE "PURORD2AL"         TO  VIEW-NFNAME
           ELSE
           IF ADD-INVOICELESS-IND = "X"
               MOVE "PURORD2AI"         TO  VIEW-NFNAME
           ELSE
      *    IF SAVE-CHAT-SW = "Y"
      *        MOVE "PURORD2AC"         TO  VIEW-NFNAME
      *    ELSE
           MOVE "PURORD2A"              TO  VIEW-NFNAME.

      *    "ENTER ITEM INFORMATION AND PRESS 'ENTER'"
           MOVE   5 TO LANG-SETNUM.
           MOVE  24 TO LANG-MSGNUM.
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
           MOVE MESSAGE-BUFFER TO DE2-INSTRUCTIONLINE
                                  DE2-INSTRUCTIONLINE-L.
           MOVE DESC-COMMENT-LIT        TO  DE2-DESC-LIT
                                            DE2-DESC-LIT-L.
           MOVE ADDL-DESC-MSG-LIT       TO  DE2-ADDL-DESC-MSG
                                            DE2-ADDL-DESC-MSG-L.

       62-READ-SCREEN-2A.
           PERFORM 620-PUT-BUFFER.
           PERFORM 998-WRITE-SCREEN THRU 998-READ-SCREEN.
           PERFORM 620-GET-BUFFER.

           IF CONT-SW = "Y"
               MOVE 13             TO  FIELD-NUMBER
           ELSE
               MOVE 39             TO  FIELD-NUMBER.

           IF CONT-SW = "Y"
               IF VIEW-LASTKEY = 1 OR 2 OR 3
                   MOVE 5  TO  VIEW-LASTKEY.
           IF VIEW-LASTKEY = 1
               SUBTRACT 1  FROM  ITEM-NO-SAVE
               GO TO 62-READ-PO-ITEMS
           ELSE
           IF VIEW-LASTKEY = 2
               IF DS2-CODE = "NC"
                   MOVE 5     TO  VIEW-LASTKEY
               ELSE
                   PERFORM 621-CALL-CODE-DESC  THRU  621-CCD-X
                   GO TO 62-GETNEXTFORM-2A
           ELSE
           IF VIEW-LASTKEY = 8
               IF DS2-CODE = "NC"
                   MOVE 5  TO  VIEW-LASTKEY
               ELSE
                   MOVE "X"               TO  DE2-SECOND-LANG-INDIC
                                              DE2-SECOND-LANG-INDIC-L
                   GO TO 62-READ-SCREEN-2A
           ELSE
           IF VIEW-LASTKEY = 4
               MOVE 13                  TO  FIELD-NUMBER
               PERFORM 4-PGM-ERROR  THRU  4-PGM-ERROR-X
               MOVE B"0" TO IND(99)
               GO TO 62-READ-SCREEN-2A.

           IF VIEW-LASTKEY = 5 OR 6 OR 7 OR 3
      *        "INVALID FUNCTION KEY ENTERED"
               MOVE   9 TO LANG-SETNUM
               MOVE  10 TO LANG-MSGNUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER TO DE2-MESSAGE-LINE
                                      DE2-MESSAGE-LINE-L
               MOVE 39 TO FIELD-NUMBER
               PERFORM 4-PGM-ERROR  THRU  4-PGM-ERROR-X
               GO TO 62-READ-SCREEN-2A.


           IF CONT-SW = "Y"
               GO TO 62-UPDATE-ITEM-SEGMENTS.

        62-FIELD-EDITS-2A.
           IF DE2-PRICE-UM = SPACES
      *        YOU MUST ENTER A PRICE UM
               MOVE  45054 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER TO DE2-MESSAGE-LINE
                                      DE2-MESSAGE-LINE-L
               MOVE 9 TO  FIELD-NUMBER
               PERFORM 4-PGM-ERROR  THRU  4-PGM-ERROR-X
               GO TO 62-READ-SCREEN-2A.

           IF DE2-QTY-UM = SPACES
      *        YOU MUST ENTER A QUANTITY UM
               MOVE  45055 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER TO DE2-MESSAGE-LINE
                                      DE2-MESSAGE-LINE-L
               MOVE 6 TO  FIELD-NUMBER
               PERFORM 4-PGM-ERROR  THRU  4-PGM-ERROR-X
               GO TO 62-READ-SCREEN-2A.

           IF DE2-SUB-DETL = SPACES
      *        DEPARTMENT IS REQUIRED
               MOVE  45056 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER TO DE2-MESSAGE-LINE
                                      DE2-MESSAGE-LINE-L
               MOVE 10 TO  FIELD-NUMBER
               PERFORM 4-PGM-ERROR  THRU  4-PGM-ERROR-X
               GO TO 62-READ-SCREEN-2A.

           IF DE2-SUB = SPACES
      *        CLASS IS REQUIRED
               MOVE  45057 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER TO DE2-MESSAGE-LINE
                                      DE2-MESSAGE-LINE-L
               MOVE 27 TO  FIELD-NUMBER
               PERFORM 4-PGM-ERROR  THRU  4-PGM-ERROR-X
               GO TO 62-READ-SCREEN-2A.

           IF DE2-TAX-CODE = SPACES
      *        YOU MUST ENTER A VALID TAX CODE
               MOVE  45058 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER TO DE2-MESSAGE-LINE
                                      DE2-MESSAGE-LINE-L
               MOVE 23 TO  FIELD-NUMBER
               PERFORM 4-PGM-ERROR  THRU  4-PGM-ERROR-X
               GO TO 62-READ-SCREEN-2A.

           IF DS2-CODE = "NC"
               IF DE2-SECOND-LANG-INDIC NOT = SPACES
      *           SEC. LANG. OPTION ONLY AVAILABLE FOR CODE POS
                   MOVE  45059 TO CATREAD-MSG-NUMBER
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE MESSAGE-BUFFER TO DE2-MESSAGE-LINE
                                          DE2-MESSAGE-LINE-L
                   MOVE 28 TO  FIELD-NUMBER
                   PERFORM 4-PGM-ERROR  THRU  4-PGM-ERROR-X
                   GO TO 62-READ-SCREEN-2A.

           IF ZBILL-PO
               IF DE2-ITEM-VALUE = ZEROS
      *           THIS IS A MEMO ZBILL! YOU MUST ENTER A ITEM VALUE
                   MOVE  45061 TO CATREAD-MSG-NUMBER
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE MESSAGE-BUFFER TO DE2-MESSAGE-LINE
                                          DE2-MESSAGE-LINE-L
                   MOVE 24 TO  FIELD-NUMBER
                   PERFORM 4-PGM-ERROR  THRU  4-PGM-ERROR-X
                   GO TO 62-READ-SCREEN-2A.

           IF DS2-CODE = "NC"
             IF DE2-DESC (1) = SPACES
      *        YOU MUST ENTER AT LEAST ONE LINE OF DESCRIPTION
               MOVE  45060 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER TO DE2-MESSAGE-LINE
                                      DE2-MESSAGE-LINE-L
               MOVE 13 TO  FIELD-NUMBER
               PERFORM 4-PGM-ERROR  THRU  4-PGM-ERROR-X
               GO TO 62-READ-SCREEN-2A.

           MOVE ZERO     TO  LINE-NO-SAVE.

       62-CHECK-PO-QTY.
           IF BLANKET-SW = "Y"
               IF DE2-QTY NOT = ZERO
      *            "QTY. MUST BE ZERO FOR A REQUIREMENT ORDER"
                   MOVE  17 TO LANG-SETNUM
                   MOVE   3 TO LANG-MSGNUM
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE MESSAGE-BUFFER TO DE2-MESSAGE-LINE
                                          DE2-MESSAGE-LINE-L
                   MOVE 4  TO  FIELD-NUMBER
                   PERFORM 4-PGM-ERROR  THRU  4-PGM-ERROR-X
                   GO TO 62-READ-SCREEN-2A.

           MOVE 0 TO FIELD-NUMBER.
           PERFORM 620-PCPO-EDITS THRU 620-PE-X.
           IF FIELD-NUMBER NOT = 0
               MOVE MESSAGE-BUFFER TO DE2-MESSAGE-LINE
                                      DE2-MESSAGE-LINE-L
               PERFORM 4-PGM-ERROR  THRU  4-PGM-ERROR-X
               GO TO 62-READ-SCREEN-2A.

       62-EDIT-DEPT.
           MOVE DE2-SUB-DETL          TO  DEPT-NUM.
           MOVE BUILD-VALID-DEPT-KEY  TO MVALIDPLT-ARG.
           MOVE 0 TO COND-WORD.
           MOVE MVALIDPLT-ARG TO VALDTAKEY OF MVALIDPLTDATA-REC-I.
           START MVALIDPLTDATA-I KEY = VALDTAKEY OF MVALIDPLTDATA-REC-I
               INVALID KEY MOVE 17 TO COND-WORD.
           IF FILE-STATUS-1 = "2"
               MOVE 17 TO COND-WORD
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD.
      *    CALL "DBGET" USING BASE, DSET-MVALIDPLTDATA, MODE7,
      *        STATUS-AREA, ALL-ITEMS, BUF-MVALIDPLTDATA,
      *            MVALIDPLT-ARG.
           IF COND-WORD NOT = 0
               IF COND-WORD = 17
      *            "DEPARTMENT CODE DOES NOT EXIST"
                   MOVE   4 TO LANG-SETNUM
                   MOVE  12 TO LANG-MSGNUM
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE MESSAGE-BUFFER TO DE2-MESSAGE-LINE
                                          DE2-MESSAGE-LINE-L
                   MOVE 10          TO FIELD-NUMBER
                   PERFORM 4-PGM-ERROR  THRU  4-PGM-ERROR-X
                   GO TO 62-READ-SCREEN-2A
               ELSE
                   MOVE "GET MVALID * 62-GB2"  TO  BU-DISPLAY-MSG
                   MOVE MVALIDPLT-ARG           TO  BU-DISPLAY-FLD (2)
                   GO TO 2100-BLOWUP.

           IF DE2-COMPANY-CODE = "631"
               IF DE2-CODE = "NC"
                   IF DE2-SUB-DETL = "1210"
      *M       "DEPARTMENT ENTERED IS INVALID CHARGE DEPARTMENT"
                       MOVE  4             TO LANG-SETNUM
                       MOVE 54             TO LANG-MSGNUM
                       PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                       MOVE MESSAGE-BUFFER TO DE2-MESSAGE-LINE
                                              DE2-MESSAGE-LINE-L
                       MOVE 10             TO FIELD-NUMBER
                       PERFORM 4-PGM-ERROR  THRU  4-PGM-ERROR-X
                       GO TO 62-READ-SCREEN-2A.

      *------- ON CONSIGNED & FRANCHISED PO, CANNOT MIX BOTH STOREROOM
      *------- AND DIRECT DELIVERY ITEMS.  MUST BE STOREROOM.
      *-------
      *------- IF IT'S A "000" PO, A CONSIGNED ITEM IS ALLOWED TO
      *------- HAVE A NON-STOREROOM DEPARTMENT.
      *-------
      *------- IF IT'S A Z-BILL PO, A CONSIGNED ITEM CAN BE FOR
      *------- THE STOREROOM DEPARTMENT.
      *-------
      *------- IF IT'S A "000" PO, A CONSIGNED ITEM CAN BE FOR
      *------- THE STOREROOM DEPARTMENT.

           IF PO-REL > "000"
             IF FRANCHISE-VEND-SW = "Y" AND ITEM-NO-SAVE = 1
               IF STR-CODE-OWNER > " "
                   MOVE "C"                TO SAVE-CONSIGN-PO-TYPE
                   MOVE "Y"                TO NONPAY-PO-SW
               ELSE
                   MOVE "N"                TO SAVE-CONSIGN-PO-TYPE
                   MOVE "N"                TO NONPAY-PO-SW
               END-IF.

           IF PO-REL > "000" AND CONSIGNED-PO
               IF (DE2-SUB-DETL NOT = SAVE-STOREROOM-DEPT)
      *M    "CODE IS CONSIGNED - DEPT MUST BE STOREROOM DEPT"
                   MOVE   3            TO LANG-SETNUM
                   MOVE 638            TO LANG-MSGNUM
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE MESSAGE-BUFFER TO DE2-MESSAGE-LINE
                                          DE2-MESSAGE-LINE-L
                   MOVE 10             TO FIELD-NUMBER
                   PERFORM 4-PGM-ERROR  THRU  4-PGM-ERROR-X
                   GO TO 62-READ-SCREEN-2A.

           IF ZBILL-PO AND DE2-CODE NOT = "NC"
             IF STR-CODE-OWNER > " "
               IF (DE2-SUB-DETL NOT = SAVE-STOREROOM-DEPT)
      *M    "CODE IS CONSIGNED - DEPT MUST BE STOREROOM DEPT"
                   MOVE   3            TO LANG-SETNUM
                   MOVE 638            TO LANG-MSGNUM
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE MESSAGE-BUFFER TO DE2-MESSAGE-LINE
                                          DE2-MESSAGE-LINE-L
                   MOVE 10             TO FIELD-NUMBER
                   PERFORM 4-PGM-ERROR  THRU  4-PGM-ERROR-X
                   GO TO 62-READ-SCREEN-2A.

      *---------- COMMENTED OUT SO THAT CONSIGNED ITEMS CAN BE
      *---------- FOR THE STOREROOM DEPARTMENT ON A "000" PO.
      **** IF PO-REL = "000" AND NOT ZBILL-PO
      ****   IF STR-CODE-OWNER > " "
      ****     IF (DE2-SUB-DETL = SAVE-STOREROOM-DEPT)
      *M    "CONSIGNED STOREROOM ITEM MUST BE ON A REQUIREMENT ORDER"
      ****         MOVE   3            TO LANG-SETNUM
      ****         MOVE 639            TO LANG-MSGNUM
      ****         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
      ****         MOVE MESSAGE-BUFFER TO DE2-MESSAGE-LINE
      ****                                DE2-MESSAGE-LINE-L
      ****         MOVE 10             TO FIELD-NUMBER
      ****         PERFORM 4-PGM-ERROR  THRU  4-PGM-ERROR-X
      ****         GO TO 62-READ-SCREEN-2A.

      ***********************************
      *
      *  EDIT ADDITIONAL DATA FOR
      *  EITHER A VALID EXPENSE CLASS OR
      *  NEW WORK NUMBER
      *
      ***********************************

       62-EDIT-ADDTL-DATA.
           IF DE2-COMPANY-CODE = "631" AND DE2-REQ-NO > SPACES
               IF REQ-ADDTL-DATA NOT = DE2-ADDTDATA AND
                      EXP-ERR-SW     = "N"
      * E109: EXPENSE CLASS DIFFERS FROM REQUISITION EXPENSE CLASS {XXXXXX}
                   MOVE  05 TO LANG-SETNUM
                   MOVE 109 TO LANG-MSGNUM
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE MESSAGE-BUFFER TO DE2-MESSAGE-LINE
                                          DE2-MESSAGE-LINE-L
                   MOVE REQ-ADDTL-DATA TO DE2-MESSAGE-LINE (61:6)
                                          DE2-MESSAGE-LINE-L (61:6)
                   MOVE 11 TO  FIELD-NUMBER
                   PERFORM 4-PGM-ERROR  THRU  4-PGM-ERROR-X
                   MOVE "Y"  TO  EXP-ERR-SW
                   GO TO 62-READ-SCREEN-2A.

           IF DE2-ADDTDATA = SPACES  OR
              ADD-EDIT-ADDTL-DATA-SW = "N"
               GO TO 62-EDIT-UMS.
           MOVE DE2-ADDTDATA          TO  EXPENSE-CLASS.
           IF SAVE-PCPO-SW = "Y"
      *----IF EXP CLASS NOT 000-099 THEN SKIP VALIDATION OF ADDTDATA
               IF DE2-SUB < "000" OR DE2-SUB > "099"
                   GO TO 62-EDIT-UMS.
           MOVE BUILD-EXPENSE-CLASS   TO  MVALIDPLT-ARG.
           MOVE 0 TO COND-WORD.
           MOVE MVALIDPLT-ARG TO VALDTAKEY OF MVALIDPLTDATA-REC-I.
           START MVALIDPLTDATA-I KEY = VALDTAKEY OF MVALIDPLTDATA-REC-I
               INVALID KEY MOVE 17 TO COND-WORD.
           IF FILE-STATUS-1 = "2"
               MOVE 17 TO COND-WORD
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD.
      *    CALL "DBGET" USING BASE, DSET-MVALIDPLTDATA, MODE7,
      *        STATUS-AREA, ALL-ITEMS, BUF-MVALIDPLTDATA,
      *            MVALIDPLT-ARG.
           IF COND-WORD NOT = 0
               IF COND-WORD = 17
                   NEXT SENTENCE
               ELSE
                   MOVE "GET1 MVALID * 62-EAD"  TO  BU-DISPLAY-MSG
                   MOVE MVALIDPLT-ARG           TO  BU-DISPLAY-FLD (2)
                   GO TO 2100-BLOWUP
           ELSE
               GO TO 62-EDIT-UMS.

           MOVE DE2-ADDTDATA          TO  NEW-WORK.
           MOVE BUILD-NEW-WORK        TO  MVALIDPLT-ARG.
           MOVE 0 TO COND-WORD.
           MOVE MVALIDPLT-ARG TO VALDTAKEY OF MVALIDPLTDATA-REC-I.
           START MVALIDPLTDATA-I KEY = VALDTAKEY OF MVALIDPLTDATA-REC-I
               INVALID KEY MOVE 17 TO COND-WORD.
           IF FILE-STATUS-1 = "2"
               MOVE 17 TO COND-WORD
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD.
      *    CALL "DBGET" USING BASE, DSET-MVALIDPLTDATA, MODE7,
      *        STATUS-AREA, ALL-ITEMS, BUF-MVALIDPLTDATA,
      *            MVALIDPLT-ARG.
           IF COND-WORD NOT = 0
               IF COND-WORD = 17
      *            "INVALID EXPENSE CLASS OR NEW WORK NUMBER"
                   MOVE   9 TO LANG-SETNUM
                   MOVE  62 TO LANG-MSGNUM
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE MESSAGE-BUFFER TO DE2-MESSAGE-LINE
                                          DE2-MESSAGE-LINE-L
                   MOVE 11          TO FIELD-NUMBER
                   PERFORM 4-PGM-ERROR  THRU  4-PGM-ERROR-X
                   GO TO 62-READ-SCREEN-2A
               ELSE
                   MOVE "GET2 MVALID * 62-EAD"  TO  BU-DISPLAY-MSG
                   MOVE MVALIDPLT-ARG           TO  BU-DISPLAY-FLD (2)
                   GO TO 2100-BLOWUP.

       62-EDIT-UMS.
      *-------- EDIT INVOICELESS FIRST.
           IF DE2-INVOICELESS-IND = "X"
               IF ZBILL-PO
                   IF ADD-ITEM-COMPANY-SAVE = "129"
      *        "MEMO Z-BILL PO CANNOT BE INVOICELESS"
                       MOVE  13 TO LANG-SETNUM
                       MOVE 066 TO LANG-MSGNUM
                       PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                       MOVE MESSAGE-BUFFER TO DE2-MESSAGE-LINE
                                              DE2-MESSAGE-LINE-L
                       MOVE 45 TO  FIELD-NUMBER
                       PERFORM 4-PGM-ERROR  THRU  4-PGM-ERROR-X
                       GO TO 62-READ-SCREEN-2A.

           IF DE2-INVOICELESS-IND = "X"
               IF NON-RECV-SW = "Y"
      *        "NON-RECEIVABLE PO CANNOT BE INVOICELESS"
                   MOVE  14 TO LANG-SETNUM
                   MOVE 128 TO LANG-MSGNUM
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE MESSAGE-BUFFER TO DE2-MESSAGE-LINE
                                          DE2-MESSAGE-LINE-L
                   MOVE 45 TO  FIELD-NUMBER
                   PERFORM 4-PGM-ERROR  THRU  4-PGM-ERROR-X
                   GO TO 62-READ-SCREEN-2A.

           MOVE DE2-QTY-UM   TO  UM-ARG.
           MOVE 0 TO COND-WORD.
           MOVE UM-ARG TO VALIDUM OF MVALIDUM-REC-I.
           START MVALIDUM-I KEY = VALIDUM OF MVALIDUM-REC-I
               INVALID KEY MOVE 17 TO COND-WORD.
           IF FILE-STATUS-1 = "2"
               MOVE 17 TO COND-WORD
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD.
      *    CALL "DBGET" USING BASE, DSET-MVALIDUM, MODE7,
      *        STATUS-AREA, ALL-ITEMS, BUF-MVALIDUM, UM-ARG.
           IF COND-WORD NOT = ZERO
      *        "QUANTITY UNIT OF MEASURE IS INVALID"
               MOVE  17 TO LANG-SETNUM
               MOVE  13 TO LANG-MSGNUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER TO DE2-MESSAGE-LINE
                                      DE2-MESSAGE-LINE-L
               MOVE 6  TO  FIELD-NUMBER
               PERFORM 4-PGM-ERROR  THRU  4-PGM-ERROR-X
               GO TO 62-READ-SCREEN-2A.
           IF DE2-INVOICELESS-IND = "X"
               IF DE2-QTY-UM = "AS" OR "LT"
      *M       "UNIT OF MEASURE INVALID FOR INVOICELESS PO"
                   MOVE 21 TO LANG-SETNUM
                   MOVE 25 TO LANG-MSGNUM
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE MESSAGE-BUFFER TO DE2-MESSAGE-LINE
                                          DE2-MESSAGE-LINE-L
                   MOVE 6 TO FIELD-NUMBER
                   PERFORM 4-PGM-ERROR THRU 4-PGM-ERROR-X
                   GO TO 62-READ-SCREEN-2A
               ELSE
               IF DE2-QTY = ZEROES
                   IF BLANKET-SW = "Y"
                       NEXT SENTENCE
                   ELSE
      *M       "QUANTITY MUST BE > 0 FOR INVOICELESS PO"
                   MOVE 17 TO LANG-SETNUM
                   MOVE 18 TO LANG-MSGNUM
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE MESSAGE-BUFFER TO DE2-MESSAGE-LINE
                                          DE2-MESSAGE-LINE-L
                   MOVE 4 TO FIELD-NUMBER
                   PERFORM 4-PGM-ERROR THRU 4-PGM-ERROR-X
                   GO TO 62-READ-SCREEN-2A.

      **************************************************
      ** THE PRICE UM IS CHECKED AGAINST THE DATABASE **
      **************************************************


           MOVE DE2-PRICE-UM  TO  UM-ARG.
           MOVE 0 TO COND-WORD.
           MOVE UM-ARG TO VALIDUM OF MVALIDUM-REC-I.
           START MVALIDUM-I KEY = VALIDUM OF MVALIDUM-REC-I
               INVALID KEY MOVE 17 TO COND-WORD.
           IF FILE-STATUS-1 = "2"
               MOVE 17 TO COND-WORD
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD.
      *    CALL "DBGET" USING BASE, DSET-MVALIDUM, MODE7,
      *        STATUS-AREA, ALL-ITEMS, BUF-MVALIDUM, UM-ARG.
           IF COND-WORD NOT = ZERO
      *        "UNIT PRICE UM IS INVALID"
               MOVE  21 TO LANG-SETNUM
               MOVE   8 TO LANG-MSGNUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER TO DE2-MESSAGE-LINE
                                      DE2-MESSAGE-LINE-L
               MOVE 9  TO  FIELD-NUMBER
               PERFORM 4-PGM-ERROR  THRU  4-PGM-ERROR-X
               GO TO 62-READ-SCREEN-2A.
           IF DE2-INVOICELESS-IND = "X"
               IF DE2-PRICE-UM = "AS" OR "LT"
      *M       "UNIT OF MEASURE INVALID FOR INVOICELESS PO"
                   MOVE 21 TO LANG-SETNUM
                   MOVE 25 TO LANG-MSGNUM
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE MESSAGE-BUFFER TO DE2-MESSAGE-LINE
                                          DE2-MESSAGE-LINE-L
                   MOVE 9 TO FIELD-NUMBER
                   PERFORM 4-PGM-ERROR THRU 4-PGM-ERROR-X
                   GO TO 62-READ-SCREEN-2A
               ELSE
               IF DE2-PRICE = ZEROES
      *M   "PRICE MUST BE GREATER THAN 0 FOR INVOICELESS PO
                   MOVE  16 TO LANG-SETNUM
                   MOVE 144 TO LANG-MSGNUM
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE MESSAGE-BUFFER TO DE2-MESSAGE-LINE
                                          DE2-MESSAGE-LINE-L
                   MOVE 39 TO FIELD-NUMBER
                   PERFORM 4-PGM-ERROR THRU 4-PGM-ERROR-X
                   GO TO 62-READ-SCREEN-2A.

           MOVE DE2-INVOICELESS-IND TO ADD-INVOICELESS-IND.

       62-EDIT-TAX-CODE.
           MOVE DE2-TAX-CODE   TO  TAX-ARG.
           MOVE 23             TO  FIELD-NUMBER.
           MOVE 0 TO COND-WORD.
           MOVE TAX-ARG TO TAXCDE OF MTAX-REC-I.
           READ MTAX-I INTO BUF-MTAX
               INVALID KEY MOVE 17 TO COND-WORD.
           IF FILE-STATUS-1 = "2"
               MOVE 17 TO COND-WORD
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD.
           IF COND-WORD NOT = 0
               IF COND-WORD = 17
      *            "TAX CODE DOES NOT EXIST"
                   MOVE  20 TO LANG-SETNUM
                   MOVE   7 TO LANG-MSGNUM
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE MESSAGE-BUFFER TO MSG-TEXT
                   MOVE TAX-ARG  TO  MSG-FLD
                   MOVE MESSAGE-BUFFER TO DE2-MESSAGE-LINE
                                          DE2-MESSAGE-LINE-L
                   PERFORM 4-PGM-ERROR  THRU  4-PGM-ERROR-X
                   GO TO 62-READ-SCREEN-2A
               ELSE
                   MOVE "GET MTAX * 66-ETC" TO BU-DISPLAY-MSG
                   MOVE TAX-ARG TO  BU-DISPLAY-FLD (2)
                   GO TO 2100-BLOWUP.

       62-EDIT-COMMENT-NO.
           MOVE "N"      TO  ERR-SW.
           PERFORM 621-EDIT-COMMENTS  THRU  621-EC-X
               VARYING SUB  FROM 1 BY 1
                   UNTIL SUB > 4  OR  ERR-SW = "Y".
           IF ERR-SW = "Y"
               GO TO 62-READ-SCREEN-2A.

       62-EDIT-RCV-COMMENT-NO.
           MOVE "N"      TO  ERR-SW.
           PERFORM 621-EDIT-RCV-COMMENTS  THRU  621-ERC-X
               VARYING SUB  FROM 1 BY 1
                   UNTIL SUB > 4  OR  ERR-SW = "Y".
           IF ERR-SW = "Y"
               GO TO 62-READ-SCREEN-2A.

      ************************************************************
      **   EDIT MASTER STOCK CODE.  IF THE ITEM IS NON-CODED
      **   YOU CANNOT ENTER A MASTER STOCK CODE.  IF THE ITEM
      **   IS CODED EDIT MASTER STOCK TO MAKE SURE IT EXISTS AND
      **   THERE ARE VALID UNIT OF MEASURES.
      ************************************************************

           IF DS2-CODE = "NC"
               IF DE2-MASTER-STOCK = SPACES
                   NEXT SENTENCE
               ELSE
      *            "CANNOT ENTER A MASTER STOCK CODE FOR A NON-CODED ITEM"
                   MOVE  3   TO LANG-SETNUM
                   MOVE  186 TO LANG-MSGNUM
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE MESSAGE-BUFFER TO DE2-MESSAGE-LINE
                                          DE2-MESSAGE-LINE-L
                   MOVE 44 TO  FIELD-NUMBER
                   PERFORM 4-PGM-ERROR  THRU  4-PGM-ERROR-X
                   GO TO 62-READ-SCREEN-2A
           ELSE
               IF DE2-MASTER-STOCK = SPACES
                   NEXT SENTENCE
               ELSE
                   MOVE DE2-MASTER-STOCK  TO  CODE-ARG
                   MOVE "Y"             TO MASTER-STOCK-EDIT-SW
                   MOVE "N"             TO ERR-SW
                   PERFORM 621-EDIT-CODED-ITEM  THRU  621-ECI-X
                   IF ERR-SW = "Y"
                       GO TO 62-READ-SCREEN-2A.

           MOVE SPACES                  TO MASTER-STOCK-EDIT-SW.
           MOVE DS2-CODE                TO CODE-ARG.
           MOVE "N"                     TO ERR-SW.
           IF DS2-CODE = "NC"
               PERFORM 621-EDIT-NONCODED-ITEM  THRU  621-ENI-X
           ELSE
               PERFORM 621-EDIT-CODED-ITEM  THRU  621-ECI-X.
           IF ERR-SW = "Y"
               GO TO 62-READ-SCREEN-2A.

       62-UPDATE-ITEM-SEGMENTS.
           MOVE DE2-SUB               TO  SUB-SAVE.
           MOVE DE2-SUB-DETL          TO  SUBD-SAVE.
           MOVE DE2-ADDTDATA          TO  ADDTL-DATA-SAVE.
           MOVE DE2-TAX-CODE          TO  SAVE-TAX-CODE.

           PERFORM 621-UPDATE-ITEM-DATA  THRU  621-UID-X.

      *-----QS9000 TRACKING
           IF DE2-QS9000-TRACKING = "X"
               MOVE "A" TO TRAK-FUNCTION
               CALL "SRCVTRAK" USING ITM-PO-RCV-NO
                                     ITM-NUMBER
                                     VEN-ARG
                                     ITM-CORP-CODE
                                     TRAK-FUNCTION
                                     ITM-QTY-ORD.

           IF CONT-SW = "Y"
               GO TO 62-READ-SCREEN-2A
           ELSE
               GO TO 62-READ-PO-ITEMS.

       62-PID-X.
           EXIT.

       620-GET-BUFFER.
           IF VIEW-NFNAME = "PURORD2AL" OR "PURORD2CL"
