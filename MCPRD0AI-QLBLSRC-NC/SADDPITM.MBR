           05  DE2-MASTER-STOCK-L          PIC X(7).
           05  DE2-QS9000-TRACKING-L       PIC X(1).
           05  DE2-MANUFACTUR-LIT-L        PIC X(26).
           05  DE2-STD-INST-TABLE-L.
               10  DE2-STD-INST-L  OCCURS 4 TIMES  PIC X(3).
           05  DE2-RCV-INST-TABLE-L.
               10  DE2-RCV-INST-L  OCCURS 4 TIMES  PIC X(3).
           05  DE2-MANUFACTUR-SELECT-L     PIC X(26).
           05  DE2-DESC-LIT-L              PIC X(22).
           05  DE2-MORE-DESC-MSG-L         PIC X(55).
           05  DE2-DESC-AREA-L.
               10  DE2-DESC-L OCCURS 7 TIMES.
                   15  DE2-DESC-FIRST-45-L PIC X(45).
                   15  DE2-DESC-LAST-L     PIC X(34).
               10  DE2-ADDL-DESC-MSG-L     PIC X(60).
               10  DE2-CONT-SW-L           PIC X.
           05  DE2-INSTRUCTIONLINE-L       PIC X(60).
           05  DE2-COMMAND-LINE-L          PIC X(79).
           05  DE2-MESSAGE-LINE-L          PIC X(79).

       01  BUILD-CC-LIT.
           05  CURRENCY-LIT             PIC X(10).
           05  FILLER                   PIC X.
           05  CUR-CODE                 PIC X(2).
           05  FILLER                   PIC X.
           05  CUR-CODE-DESC            PIC X(12).

       01  DISCOUNT-PRICE-DIS-LIT.
           05  DIS-PRICE-LIT            PIC X(18) VALUE SPACES.
           05  FILLER                   PIC X(3)  VALUE " ->".
           05  DIS-PRE-PRICE            PIC Z(10)9.9(4) VALUE ZEROS.
           05  FILLER                   PIC X(3)  VALUE " @ ".
           05  DIS-DISCOUNT-PERCENT     PIC Z9.9(2) VALUE ZEROS.
           05  FILLER                   PIC X(1)  VALUE "%".

       01  DESC-COMMENT-LIT             PIC X(22).

       01  ADDL-DESC-MSG-LIT            PIC X(60).

      **************************************************************
