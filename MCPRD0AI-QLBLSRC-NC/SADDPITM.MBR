      *********************************
      *
      *   EDIT STD. INSTRUCTIONS
      *
      *********************************

       621-EDIT-COMMENTS.
           IF DE2-STD-INST (SUB) = SPACES
               GO TO 621-EC-X.
           MOVE DE2-STD-INST (SUB)  TO  BUILD-COM-NO.
           MOVE "C"                 TO  BUILD-COM-PREFIX.
           MOVE BUILD-COMMENT-NO    TO  COMMENT-ARG.
           MOVE 0 TO COND-WORD.
           MOVE COMMENT-ARG TO MCOMCOMMNT OF MCOMMENT-REC-I.
           START MCOMMENT-I KEY = MCOMCOMMNT OF MCOMMENT-REC-I
               INVALID KEY MOVE 17 TO COND-WORD.
           IF FILE-STATUS-1 = "2"
               MOVE 17 TO COND-WORD
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD.
      *    CALL "DBGET" USING BASE, DSET-MCOMMENT, MODE7,
      *        STATUS-AREA, ALL-ITEMS, BUF-MCOMMENT, COMMENT-ARG.
           IF COND-WORD NOT = 0
               IF COND-WORD = 17
      *            "INSTRUCTION NUMBER DOES NOT EXIST"
                   MOVE   9 TO LANG-SETNUM
                   MOVE  60 TO LANG-MSGNUM
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE MESSAGE-BUFFER TO DE2-MESSAGE-LINE
                                          DE2-MESSAGE-LINE-L
                   ADD 31, SUB  GIVING FIELD-NUMBER
                   PERFORM 4-PGM-ERROR  THRU  4-PGM-ERROR-X
                   MOVE "Y"  TO  ERR-SW
               ELSE
                   MOVE "GET MCOMMENT * 621-EC" TO BU-DISPLAY-MSG
                   MOVE COMMENT-ARG             TO BU-DISPLAY-FLD (2)
                   GO TO 2100-BLOWUP.

       621-EC-X.
           EXIT.

      *********************************
      *
      *   EDIT RCV. INSTRUCTIONS
      *
      *********************************

       621-EDIT-RCV-COMMENTS.
           IF DE2-RCV-INST (SUB) = SPACES
               GO TO 621-ERC-X.
           MOVE DE2-RCV-INST (SUB)  TO  BUILD-COM-NO.
           MOVE "R"                 TO BUILD-COM-PREFIX.
           MOVE BUILD-COMMENT-NO    TO  COMMENT-ARG.
           MOVE 0 TO COND-WORD.
           MOVE COMMENT-ARG TO MCOMCOMMNT OF MCOMMENT-REC-I.
           START MCOMMENT-I KEY = MCOMCOMMNT OF MCOMMENT-REC-I
               INVALID KEY MOVE 17 TO COND-WORD.
           IF FILE-STATUS-1 = "2"
               MOVE 17 TO COND-WORD
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD.
           IF COND-WORD NOT = 0
               IF COND-WORD = 17
      *            "INSTRUCTION NUMBER DOES NOT EXIST"
                   MOVE   9 TO LANG-SETNUM
                   MOVE  60 TO LANG-MSGNUM
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE MESSAGE-BUFFER TO DE2-MESSAGE-LINE
                                          DE2-MESSAGE-LINE-L
                   ADD 59, SUB  GIVING FIELD-NUMBER
                   PERFORM 4-PGM-ERROR  THRU  4-PGM-ERROR-X
                   MOVE "Y"  TO  ERR-SW
               ELSE
                   MOVE "GET MCOMMENT * 621-ERC" TO BU-DISPLAY-MSG
                   MOVE COMMENT-ARG             TO BU-DISPLAY-FLD (2)
                   GO TO 2100-BLOWUP.

       621-ERC-X.
           EXIT.
      *********************************
      *
      *   CODED PO EDITS PROCEDURE
      *
      *********************************

       621-EDIT-CODED-ITEM.
           MOVE 0 TO COND-WORD.
           MOVE CODE-ARG TO CORPCDE OF MSTORERM-REC-I.
           READ MSTORERM-I INTO BUF-MSTORERM
               INVALID KEY MOVE 17 TO COND-WORD.
           IF FILE-STATUS-1 = "2"
               MOVE 17 TO COND-WORD
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD.
      *    CALL "DBGET" USING BASE, DSET-MSTORERM, MODE7,
      *        STATUS-AREA, ALL-ITEMS, BUF-MSTORERM, CODE-ARG.
           IF COND-WORD NOT = ZERO
               IF COND-WORD = 17
                   IF MASTER-STOCK-EDIT-SW = "Y"
      *                "STORES CODE DOES NOT EXIST"
                       MOVE  19 TO LANG-SETNUM
                       MOVE   9 TO LANG-MSGNUM
                       PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                       MOVE MESSAGE-BUFFER TO DE2-MESSAGE-LINE
                                              DE2-MESSAGE-LINE-L
                       MOVE 44  TO FIELD-NUMBER
                       PERFORM 4-PGM-ERROR  THRU  4-PGM-ERROR-X
                       MOVE "Y"  TO  ERR-SW
                       GO TO 621-ECI-X
                   ELSE
                       MOVE "GET MSTORERM COND=17 *621-ECI"
                           TO BU-DISPLAY-MSG
                       MOVE CODE-ARG    TO BU-DISPLAY-FLD (2)
                       GO TO 2100-BLOWUP
               ELSE
                   MOVE "GET MSTORERM * 621-ECI" TO BU-DISPLAY-MSG
                   MOVE CODE-ARG        TO BU-DISPLAY-FLD (2)
                   GO TO 2100-BLOWUP.

           IF DE2-QTY-UM = STR-UM OR STR-UM1 OR STR-UM2
               NEXT SENTENCE
           ELSE
      *        "QUANTITY UM IS NOT A STOREROOM UM"
               MOVE  17 TO LANG-SETNUM
               MOVE   4 TO LANG-MSGNUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER TO DE2-MESSAGE-LINE
                                      DE2-MESSAGE-LINE-L
               MOVE 6  TO  FIELD-NUMBER
               PERFORM 4-PGM-ERROR  THRU  4-PGM-ERROR-X
               MOVE "Y"  TO  ERR-SW
               GO TO 621-ECI-X.

           IF DE2-PRICE-UM = STR-UM OR STR-UM1 OR STR-UM2
               NEXT SENTENCE
           ELSE
      *        "PRICE UM IS NOT A STOREROOM UM"
               MOVE  16 TO LANG-SETNUM
               MOVE  14 TO LANG-MSGNUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER TO DE2-MESSAGE-LINE
                                      DE2-MESSAGE-LINE-L
               MOVE 9  TO  FIELD-NUMBER
               PERFORM 4-PGM-ERROR  THRU  4-PGM-ERROR-X
               MOVE "Y"  TO  ERR-SW
               GO TO 621-ECI-X.

           IF MASTER-STOCK-EDIT-SW = "Y"
               NEXT SENTENCE
           ELSE
               IF DE2-PRICE = ZEROS OR
                  STR-MKT-COST = ZEROS
                   NEXT SENTENCE
               ELSE
               IF DE2-PRICE = SAVE-ITEM-PRICE
                   NEXT SENTENCE
               ELSE
                   IF ADD-PO-COMPARE-PERCENT-SW = "Y"
                       PERFORM 6211-EDIT-PRICE-CHANGE  THRU 6211-EPC-X.

       621-ECI-X.
           EXIT.


      *********************************
      *
      *  NON-CODED PO EDITS PROCEDURE
      *
      *********************************

       621-EDIT-NONCODED-ITEM.
           IF DE2-QTY-UM = DE2-PRICE-UM
               NEXT SENTENCE
           ELSE
      *        "QUANTITY AND PRICE UM MUST EQUAL FOR A NON-CODED PO
               MOVE  17 TO LANG-SETNUM
               MOVE  14 TO LANG-MSGNUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER TO DE2-MESSAGE-LINE
                                      DE2-MESSAGE-LINE-L
               MOVE 6  TO  FIELD-NUMBER
               PERFORM 4-PGM-ERROR  THRU  4-PGM-ERROR-X
               MOVE "Y"  TO  ERR-SW
               GO TO 621-ENI-X.

           IF DE2-PRICE = SAVE-ITEM-PRICE AND
              DE2-QTY   = SAVE-QTY
               NEXT SENTENCE
           ELSE
           IF REQ-COMPARE-PERCENT-SW = "Y"
               IF DE2-REQ-NO (1:1) = "M"
                   IF REQITM-BUDGET-AMT NUMERIC
                       IF REQITM-BUDGET-AMT > 0
                         PERFORM 6211-EDIT-PRICE-CHANGE-REQ
                                                   THRU 6211-EPCR-X.
       621-ENI-X.
           EXIT.

      ********************************************
      *
      *  UPDATE PROCEDURE FOR ITEMS
      *
      ********************************************

       621-UPDATE-ITEM-DATA.
           IF CONT-SW = "Y"
               GO TO 621-ADD-DPODATAITM-BEGIN.

           IF DS2-CODE = "NC"
               GO TO 621-ADD-DPOITEM.

       621-UPDATE-MSTORERM.
           MOVE ADD-ITEM-COMPANY-SAVE   TO  SPOMSTRM-COMPANY-SAVE.
           MOVE DE2-QTY                 TO  SPOMSTRM-QTY.
           MOVE DE2-QTY-UM              TO  SPOMSTRM-QTY-UM.
           MOVE DE2-PRICE               TO  SPOMSTRM-PRICE.
           MOVE DE2-PRICE-UM            TO  SPOMSTRM-PRICE-UM.
      *---------- DO NOT UPDATE MARKET COST.
      *****IF ZBILL-PO
      *****    MOVE DE2-ITEM-VALUE      TO  SPOMSTRM-UNIT-VALUE.
           MOVE PO-NO                   TO  SPOMSTRM-PO-NUM.
           MOVE PO-REL                  TO  SPOMSTRM-PO-RLSE.
           MOVE VEN-ARG                 TO  SPOMSTRM-VEN-CODE.
           MOVE ADD-ITEM-CUR-CODE       TO  SPOMSTRM-CUR-CODE.
           CALL "SPOMSTRM" USING BASE,
                                 CODE-ARG,
                                 SPOMSTRM-PARMS,
                                 ZBILL-PO-SW,
                                 STATUS-AREA,
                                 BU-DISPLAY-MSG,
                                 BU-DISPLAY-FLDS.
           IF BU-DISPLAY-MSG NOT = SPACES
               GO TO 2100-BLOWUP.

       621-ADD-DPOITEM.
           MOVE SPACES               TO  BUF-DPOITEM.
           IF DS2-CODE = "NC"
               MOVE "NON-STR"        TO  ITM-CORP-CODE
           ELSE
               MOVE DS2-CODE         TO  ITM-CORP-CODE.
           MOVE RETURN-CHAT-NO       TO  ITM-CHAT-NO.
           MOVE ZERO                 TO  ITM-QTY-DLVR,
                                         ITM-QTY-STORED,
                                         ITM-QTY-PAID,
                                         ITM-WT,
                                         ITM-KELLY-PO-QTY
                                         ITM-ASN-QTY.
           MOVE SEQ-ITEM-NO-SAVE     TO  ITM-NUMBER.
           MOVE DE2-QTY-UM           TO  ITM-UM.
           MOVE DE2-QTY              TO  ITM-QTY-ORD.
           MOVE DE2-PRICE-UM         TO  ITM-PRICE-UM.
           MOVE DE2-PRICE            TO  ITM-UNIT-PRICE.
           MOVE DE2-SUB              TO  ITM-CLASS.
           MOVE DE2-SUB-DETL         TO  ITM-SUB-DETL.
           MOVE DE2-ADDTDATA         TO  ITM-ADDL-DATA.
           MOVE DE2-TAX-CODE         TO  ITM-TAX-CODE.
           MOVE DE2-STD-INST-TABLE   TO  ITM-STD-INST.
           MOVE DE2-RCV-INST-TABLE   TO  ITM-RCV-STD-INST.
           MOVE DE2-SECOND-LANG-INDIC  TO  ITM-SECOND-DESC-INDIC.
           IF ZBILL-PO
               MOVE DE2-ITEM-VALUE   TO  ITM-ZBILL-VALUE
           ELSE
               MOVE ZEROS            TO  ITM-ZBILL-VALUE.
           MOVE BUILD-PO-SEARCH      TO  ITM-PO-RCV-NO.
           MOVE DE2-MASTER-STOCK     TO  ITM-MASTER-STOCK.
           MOVE DE2-QS9000-TRACKING  TO  ITM-QS9000-TRACK.
           IF SAVE-PCPO-SW = "Y"
               MOVE DE2-COMPANY-L    TO  ITM-COMPANY
               MOVE DE2-PRIME-L      TO  ITM-PRIME.

           MOVE 0 TO COND-WORD.
           WRITE DPOITEM-REC-O FROM BUF-DPOITEM
               INVALID KEY MOVE 99 TO COND-WORD.
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD.
      *    CALL "DBPUT" USING BASE, DSET-DPOITEM, MODE1,
      *        STATUS-AREA, ALL-ITEMS, BUF-DPOITEM.
           IF COND-WORD NOT = ZERO
               MOVE "PUT DPOITEM * 621-ASD"  TO  BU-DISPLAY-MSG
               GO TO 2100-BLOWUP.

      **********************
      *                    *
      *  CUT ITEM TC "320" *
      *                    *
      **********************

       621-CALL-STC320.
           MOVE SPACES                  TO  STC320-PARMS.
           MOVE ADD-ITEM-COMPANY-SAVE   TO  STC320-COMPANY-SAVE.
           MOVE "20"                    TO  STC320-ITEM-TC-ID.
           IF DS2-CODE = "NC"
               MOVE DE2-QTY             TO  STC320-QTY
               MOVE DE2-PRICE           TO  STC320-PRICE
           ELSE
               MOVE SPOMSTRM-STR-QTY    TO  STC320-QTY
               MOVE SPOMSTRM-STR-PRICE  TO  STC320-PRICE.
           IF DS2-CODE = "NC"
               MOVE DE2-QTY-UM          TO  STC320-QTY-UM
               MOVE DE2-PRICE-UM        TO  STC320-PRICE-UM
           ELSE
               MOVE SPOMSTRM-STR-UM     TO  STC320-QTY-UM,
                                            STC320-PRICE-UM.
           MOVE SEQ-ITEM-NO-SAVE        TO  STC320-ITEM.
           MOVE BUILD-PO-SEARCH         TO  STC320-PO-NUM.
           MOVE DS2-CODE                TO  STC320-CODE.
           MOVE BUDGET-NO-SAVED         TO  STC320-BUDGET-NO.
           MOVE DE2-REQ-NO              TO  STC320-REQ-NO.
           MOVE ITM-CLASS               TO  STC320-SUB.
           MOVE ITM-SUB-DETL            TO  STC320-SUBD.
           MOVE ITM-ADDL-DATA           TO  STC320-ADDTL-DATA.
           MOVE DE2-TAX-CODE            TO  STC320-TAX-CODE.
           MOVE ZEROS                   TO  STC320-OLD-BUDGET-AMT.
           MOVE ADD-ITEM-CUR-CODE       TO  STC320-CUR-CODE.
           IF SAVE-PCPO-SW = "Y"
               MOVE ITM-COMPANY         TO  STC320-COMPANY
               MOVE ITM-PRIME           TO  STC320-PRIME.
           CALL "STC320" USING BASE,
                               STC320-PARMS,
                               STATUS-AREA,
                               BU-DISPLAY-MSG,
                               BU-DISPLAY-FLDS.
           IF BU-DISPLAY-MSG-1  NOT = SPACES
               GO TO 2100-BLOWUP.

           IF ADD-PGM-ID = "2"
               MOVE SPACES                  TO  SEDIVNCK-PARMS
               MOVE BUILD-PO-SEARCH         TO  SEDIVNCK-PO-NUMBER
               CALL "SEDIVNCK" USING BASE,
                                     SEDIVNCK-PARMS
               IF SEDIVNCK-EDI-IND = "Y"
                   MOVE SPACES              TO  SEDIPOLG-PARMS
                   MOVE BUILD-PO-SEARCH     TO  PO-NUMBER-EDI
                   MOVE VEN-ARG             TO  VENDOR-CODE-EDI
                   MOVE "X"                 TO  FLAG-EDI-A
                   MOVE SEQ-ITEM-NO-SAVE    TO  PO-ITEM-NO-EDI
                   MOVE "SADDPITM"          TO  CALLING-PGM-EDI
                   MOVE "X"             TO  FLAG-EDI-M
                   CALL "SEDIPOLG" USING BASE,
                                         SEDIPOLG-PARMS,
                                         LANGUAGE-PARMS.

      *************************************************************
      **
      **   CALCULATE BUDGET AMOUNT FOR THE ITEM AND ALSO
      **   INCLUDE TAX (BASED ON TAX PERCENT ASSOC. WITH TAX CODE)
      **
      *************************************************************

      **** MULTIPLY STC320-PRICE  BY  STC320-QTY   GIVING
      ****   BUDGET-AMT-SAVED ROUNDED, ITEM-EXTENSION-SAVED ROUNDED.

           MOVE STC320-QTY       TO  SCALCBGT-QTY.
           MOVE STC320-PRICE     TO  SCALCBGT-PRICE.
           MOVE STC320-TAX-CODE  TO  SCALCBGT-TAX-CODE.
           MOVE 0                TO  SCALCBGT-BUDGET.
           CALL "SCALCBGT"  USING  SCALCBGT-PARMS.
           ADD SCALCBGT-BUDGET   TO  TOTAL-PO-BUDGET.

      **** ADD BUDGET-AMT-SAVED, ITEM-TAX TO TOTAL-PO-BUDGET.

      ***************************************************
      **
      **  LINK THE REQ TO THE PURCHASE ORDER
      **
      ***************************************************

           IF DE2-REQ-NO  =  SPACES
               NEXT SENTENCE
           ELSE
               PERFORM 66-UPDATE-REQ  THRU  66-UR-X.

           MOVE "N"                     TO  TC370-CUT-SW.
           IF DS2-CODE = "NC"
               GO TO 621-ADD-DPODATAITM-BEGIN.

      **********************************************************
      **  CALL 'SVENPRC' TO UPDATE LAST PO PRICE FOR THAT
      **  VENDOR IN DVENDITM.
      **********************************************************

       621-UPDATE-VENDOR-PRICE.
           MOVE SPACES                  TO  SVENPRC-PARMS.
           MOVE "U"                     TO  SVENPRC-FLAG.
           MOVE CODE-ARG                TO  SVENPRC-CODE.
           MOVE VEN-ARG                 TO  SVENPRC-VEN-CODE.
           MOVE ITM-UNIT-PRICE          TO  SVENPRC-PRICE.
           MOVE ITM-PRICE-UM            TO  SVENPRC-PRICE-UM.
           MOVE CUR-DATE                TO  SVENPRC-PO-DATE.
           CALL "SVENPRC" USING BASE,
                                SVENPRC-PARMS,
                                STATUS-AREA,
                                BU-DISPLAY-MSG,
                                BU-DISPLAY-FLDS.
           IF BU-DISPLAY-MSG-1  NOT = SPACES
               GO TO 2100-BLOWUP.

      **********************
      *                    *
      *   BUILD DPODATAITM *
      *                    *
      **********************

       621-ADD-DPODATAITM-BEGIN.
           IF DS2-CODE = "NC"  AND
              TC370-NOT-CUT
               PERFORM 6211-CUT-TC370  THRU  6211-CT370-X.

           MOVE ZERO                 TO SUB.

       621-ADD-DPODATAITM.
           ADD 1 TO SUB.
           IF SUB > 7
               GO TO 621-ADD-DPODATAITM-2.
           IF DE2-DESC(SUB) = SPACES
               GO TO 621-ADD-DPODATAITM.
           ADD 1                     TO LINE-NO-SAVE.
           IF LINE-NO-SAVE = 99
                GO TO 621-UID-X.
           MOVE SPACES               TO  BUF-DPODATAITM.
           MOVE BUILD-PO-SEARCH      TO  DATAITM-PO-RCV-NO.
           MOVE SEQ-NO-SAVE          TO  DATAITM-LINE.
           MOVE DE2-DESC(SUB)        TO  DATAITM-INFO.
           MOVE 0 TO COND-WORD.
           WRITE DPODATAITM-REC-O FROM BUF-DPODATAITM
               INVALID KEY MOVE 99 TO COND-WORD.
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD.
      *    CALL "DBPUT" USING BASE, DSET-DPODATAITM, MODE1,
      *        STATUS-AREA, ALL-ITEMS, BUF-DPODATAITM.
           IF COND-WORD = ZERO
               NEXT SENTENCE
           ELSE
               MOVE "PUT DPODATAITM2* 621-AD" TO BU-DISPLAY-MSG
               GO TO 2100-BLOWUP.

           GO TO 621-ADD-DPODATAITM.

       621-ADD-DPODATAITM-2.
           MOVE SPACES                  TO  CONT-SW.
           MOVE ZEROS                   TO  SUB.
           IF DE2-CONT-SW = SPACE
               IF DE2-REQ-NO = SPACES
                   GO TO 621-UID-X
               ELSE
                   IF END-OF-REQ-DESC-SW = "Y"
                       GO TO 621-UID-X
                   ELSE
                       PERFORM 661-LOAD-DESC  THRU  661-LRD-X
                       MOVE "Y"         TO  CONT-SW
                       GO TO 621-ADD-DPODATAITM.
           MOVE "Y"                     TO  CONT-SW.
           MOVE SPACES                  TO  DE2-DESC-AREA
                                            DE2-DESC-AREA-L.
      *    "QTY AND PRICE INFO. PROCESSED, CONTINUE ENTERING COMMENTS"
           MOVE  17                     TO  LANG-SETNUM.
           MOVE  10                     TO  LANG-MSGNUM.
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
           MOVE MESSAGE-BUFFER          TO  DE2-INSTRUCTIONLINE
                                            DE2-INSTRUCTIONLINE-L.
           MOVE ADDL-DESC-MSG-LIT       TO  DE2-ADDL-DESC-MSG
                                            DE2-ADDL-DESC-MSG-L.

           IF DE2-REQ-NO = SPACES
               NEXT SENTENCE
           ELSE
               IF END-OF-REQ-DESC-SW = "Y"
                   NEXT SENTENCE
               ELSE
                   PERFORM 661-LOAD-DESC  THRU  661-LRD-X.

      *    IF SAVE-CHAT-SW = "Y"
      *        MOVE "PURORD2BC"       TO  VIEW-NFNAME
      *    ELSE
           MOVE "PURORD2B"            TO  VIEW-NFNAME.

       621-UID-X.
           EXIT.


       621-CALL-CODE-DESC.
           MOVE ADD-ITEM-COMPANY-SAVE   TO  PODESC-COMPANY-SAVE.
           CALL "SPOCDESC" USING BASE,
                                 CODE-ARG,
                                 VIEW-COMAREA,
                                 PO-DESC-PARMS,
                                 SCREEN-PRINT-PARMS,
                                 PASSED-SPOOL-PRT,
                                 LANGUAGE-PARMS.


       621-CCD-X.
           EXIT.


       6211-CUT-TC370.
           MOVE ZERO                    TO  SUB.

       6211-CHECK-FOR-DESC.
           ADD 1                        TO  SUB.
           IF SUB > 7
               GO TO 6211-CT370-X
           ELSE
               IF DE2-DESC (SUB) = SPACES
                   GO TO 6211-CHECK-FOR-DESC.

           MOVE "Y"                     TO  TC370-CUT-SW.
           MOVE SPACES                  TO  BUF-DDAILYTC.
           MOVE CUR-DATE                TO  DDAILYTC-DATE.
           ACCEPT DDAILYTC-TIME FROM TIME.
      *    MOVE TIME-OF-DAY             TO  DDAILYTC-TIME.
           MOVE ADD-ITEM-COMPANY-SAVE   TO  DDAILYTC-PLT.
           MOVE "370"                   TO  DDAILYTC-TC.
           MOVE BUILD-PO-SEARCH         TO  TC370-PO-RLS.
           MOVE SEQ-ITEM-NO-SAVE        TO  TC370-ITEM-NO.
           MOVE "01"                    TO  TC370-LINE-NO.
           MOVE DE2-DESC-FIRST-45 (SUB) TO  TC370-NONCODED-DESC.
           MOVE 0 TO COND-WORD.
           WRITE DDAILYTC-REC-O FROM BUF-DDAILYTC
               INVALID KEY MOVE 99 TO COND-WORD.
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD.
      *    CALL "DBPUT" USING BASE, DSET-DDAILYTC, MODE1,
      *        STATUS-AREA, ALL-ITEMS, BUF-DDAILYTC.
           IF COND-WORD NOT = ZERO
               MOVE "PUT DDAILYTC * 6211-CFD" TO BU-DISPLAY-MSG
               GO TO 2100-BLOWUP.

       6211-CT370-X.
           EXIT.

      *************************************************************
      **   THE FOLLOWING ROUTINE COMPARES THE UNIT PRICE
      **   ENTERED WITH THE LAST MARKET COST AND IF THE
      **   PERCENTAGE PRICE CHANGE IS GREATER THEN THE USER
      **   SELECTED PERCENTAGE THEN A WARNING MESSAGE IS DISPLAYED
      **   TO THE SCREEN.  THE USER CAN THEN CORRECT THE PRICE
      **   OR PRESS ENTER AGAIN IF THE PRICE IS CORRECT.
      *************************************************************

       6211-EDIT-PRICE-CHANGE.
           MOVE DE2-PRICE               TO SAVE-ITEM-PRICE.

      ****************************************************
      **   CONVERT TO STOREROOM UNIT OF MEASURE
      ****************************************************
           IF DE2-PRICE-UM = STR-UM
               MOVE DE2-PRICE           TO SAVE-PRICE-COMPARE
           ELSE
           IF DE2-PRICE-UM = STR-UM1
               DIVIDE DE2-PRICE BY STR-UM1-CF
                   GIVING SAVE-PRICE-COMPARE ROUNDED
           ELSE
           IF DE2-PRICE-UM = STR-UM2
               DIVIDE DE2-PRICE BY STR-UM2-CF
                   GIVING SAVE-PRICE-COMPARE ROUNDED
           ELSE
               MOVE "PRICE CONV FACTOR PROBLEM*6211-EPC"
                   TO BU-DISPLAY-MSG
               MOVE DE2-PRICE-UM        TO BU-DISPLAY-FLD (2)
               GO TO 2100-BLOWUP.

      *********************************************************
      **   CONVERT TO LOCAL CURRENCY IF A CURRENCY CODE WAS
      **   ENTERED FOR THE PO.  CALL 'SCURCONV' TO CONVERT.
      *********************************************************
           IF ADD-ITEM-CUR-CODE = SPACES
               NEXT SENTENCE
           ELSE
               MOVE SAVE-PRICE-COMPARE  TO SCURCONV-PRICE-DEC
               MOVE ZEROS               TO SCURCONV-PRICE-WHL
               MOVE ADD-ITEM-CUR-CODE   TO SCURCONV-CUR-CODE
               MOVE "Y"                 TO SCURCONV-OVERRIDE-CONV-SW
               CALL "SCURCONV" USING BASE,
                                     SCURCONV-PARMS,
                                     STATUS-AREA,
                                     BU-DISPLAY-MSG,
                                     BU-DISPLAY-FLDS
               IF BU-DISPLAY-MSG-1 NOT = SPACES
                   MOVE "SCURCONV-6211" TO BU-DISPLAY-FLD (3)
                   GO TO 2100-BLOWUP
               ELSE
                   MOVE SCURCONV-PRICE-DEC TO SAVE-PRICE-COMPARE.

           IF SAVE-PRICE-COMPARE = ZEROS
               GO TO 6211-EPC-X.

      ************************************************************
      **   FORMULA FOR PRICE COMPARISON WITH LAST MARKET COST
      **   IS:
      **        1) LAST MARKET COST - PO PRICE = PRICE DIFFERENCE
      **        2) IF PRICE DIFFERENCE < 0
      **               MULTPLY PRICE DIFFENCE BY -1 TO GET ABSOLUTE
      **               VALUE
      **        3) PRICE DIFFERENCE
      **           ----------------  = PERCENTAGE CHANGE
      **           LAST MARKET COST
      **        4) IF PERCENTAGE CHANGE > USER SELECTED PERCENTAGE THEN
      **           DISPLAY A WARNING MESSAGE ON SCREEN
      ******************************************************************

           SUBTRACT SAVE-PRICE-COMPARE  FROM STR-MKT-COST
               GIVING SAVE-PRICE-CHG  ROUNDED.

           IF SAVE-PRICE-CHG = ZEROS
               GO TO 6211-EPC-X
           ELSE
           IF SAVE-PRICE-CHG < 0
               MULTIPLY SAVE-PRICE-CHG BY -1 GIVING SAVE-PRICE-CHG.

           DIVIDE SAVE-PRICE-CHG BY STR-MKT-COST
               GIVING SAVE-PERCENT-CHG ROUNDED.

           IF SAVE-PERCENT-CHG > ADD-PO-COMPARE-PERCENT
      *       "PRICE DIFF. GREATER THAN PERCENTAGE CHOOSEN;PRESS ENTER
               MOVE  16 TO LANG-SETNUM
               MOVE  136 TO LANG-MSGNUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER TO DE2-MESSAGE-LINE
                                      DE2-MESSAGE-LINE-L
               MOVE 39 TO  FIELD-NUMBER
               PERFORM 4-PGM-ERROR  THRU  4-PGM-ERROR-X
               MOVE "Y"  TO  ERR-SW.

       6211-EPC-X.
           EXIT.

      *---------- CHECK BUDGET AMOUNT ON NON-CODED REQ.
       6211-EDIT-PRICE-CHANGE-REQ.
           MOVE DE2-PRICE          TO  SAVE-ITEM-PRICE.
           MOVE DE2-QTY            TO  SAVE-QTY.
           MULTIPLY  DE2-QTY       BY  DE2-PRICE
                               GIVING  K-PO-ITEM-EXT ROUNDED.

           MOVE REQITM-BUDGET-AMT  TO  SAVE-PRICE-COMPARE.

      *********************************************************
      **   CONVERT TO LOCAL CURRENCY IF A CURRENCY CODE WAS
      **   ENTERED FOR THE PO.  CALL 'SCURCONV' TO CONVERT.
      *********************************************************
           IF ADD-ITEM-CUR-CODE = SPACES
               NEXT SENTENCE
           ELSE
               MOVE K-PO-ITEM-EXT       TO SCURCONV-PRICE-DEC
               MOVE ZEROS               TO SCURCONV-PRICE-WHL
               MOVE ADD-ITEM-CUR-CODE   TO SCURCONV-CUR-CODE
               MOVE "Y"                 TO SCURCONV-OVERRIDE-CONV-SW
               CALL "SCURCONV" USING BASE,
                                     SCURCONV-PARMS,
                                     STATUS-AREA,
                                     BU-DISPLAY-MSG,
                                     BU-DISPLAY-FLDS
               IF BU-DISPLAY-MSG-1 NOT = SPACES
                   MOVE "SCURCONV-6211R" TO BU-DISPLAY-FLD (3)
                   GO TO 2100-BLOWUP
               ELSE
                   MOVE SCURCONV-PRICE-DEC TO K-PO-ITEM-EXT.

           IF K-PO-ITEM-EXT = ZEROS
               GO TO 6211-EPCR-X.

      ************************************************************
      **   FORMULA FOR PRICE COMPARISON WITH REQ BUDGET AMOUNT
      **   IS:
      **        1) REQ BUDGET AMT - PO PRICE = PRICE DIFFERENCE
      **        2) IF PRICE DIFFERENCE < 0
      **               MULTPLY PRICE DIFFENCE BY -1 TO GET ABSOLUTE
      **               VALUE
      **        3) PRICE DIFFERENCE
      **           ----------------- = PERCENTAGE CHANGE
      **           REQ BUDGET AMOUNT
      **        4) IF PERCENTAGE CHANGE > USER SELECTED PERCENTAGE THEN
      **           DISPLAY A WARNING MESSAGE ON SCREEN
      ******************************************************************

           SUBTRACT K-PO-ITEM-EXT  FROM  SAVE-PRICE-COMPARE
               GIVING SAVE-PRICE-CHG  ROUNDED.

           IF SAVE-PRICE-CHG = ZEROS
               GO TO 6211-EPCR-X
           ELSE
      *-------------- SKIP BUDGET CHECK IF PO ITEM < REQ BUDGET AMT.
           IF SAVE-PRICE-CHG > ZEROS
               GO TO 6211-EPCR-X
           ELSE
           IF SAVE-PRICE-CHG < 0
               MULTIPLY SAVE-PRICE-CHG BY -1 GIVING SAVE-PRICE-CHG.

           DIVIDE SAVE-PRICE-CHG BY REQITM-BUDGET-AMT
               GIVING SAVE-PERCENT-CHG ROUNDED.

           IF SAVE-PERCENT-CHG > REQ-COMPARE-PERCENT
      *       "PRICE DIFF. GREATER THAN PERCENTAGE CHOSEN;PRESS ENTER
               MOVE  16 TO LANG-SETNUM
               MOVE  138 TO LANG-MSGNUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER TO DE2-MESSAGE-LINE
                                      DE2-MESSAGE-LINE-L
               MOVE 39 TO  FIELD-NUMBER
               PERFORM 4-PGM-ERROR  THRU  4-PGM-ERROR-X
               MOVE "Y"  TO  ERR-SW.

       6211-EPCR-X.
           EXIT.

       66-UPDATE-REQ.
           MOVE BUILD-PO-SEARCH       TO  REQLINK-PO-NUM.
           MOVE VEN-ARG               TO  REQLINK-VEN-CODE.
           MOVE REQ-ARG               TO  REQLINK-REQ-NO.
           MOVE SEQ-ITEM-NO-SAVE      TO  REQLINK-PO-ITEM-NO.
           CALL "SREQLINK" USING BASE,
                                 REQLINK-PARMS.

       66-UR-X.
           EXIT.

       66-PROCESS-REQ-NO.
           MOVE 12          TO  FIELD-NUMBER.
           MOVE DE2-REQ-NO  TO  REQ-ARG.
           MOVE SPACES      TO  ERR-SW.
           MOVE 0 TO COND-WORD.
           MOVE REQ-ARG TO REQNO OF MREQ-REC-I.
           READ MREQ-I INTO BUF-MREQ
               INVALID KEY MOVE 17 TO COND-WORD.
           IF FILE-STATUS-1 = "2"
               MOVE 17 TO COND-WORD
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD.
      *    CALL "DBGET" USING BASE, DSET-MREQ, MODE7, STATUS-AREA,
      *        ALL-ITEMS, BUF-MREQ, REQ-ARG.
           IF COND-WORD NOT =  0
               IF COND-WORD = 17
                   MOVE "Y"  TO  ERR-SW
      *            "REQUISITION NUMBER DOES NOT EXIST"
                   MOVE  18 TO LANG-SETNUM
                   MOVE   5 TO LANG-MSGNUM
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE MESSAGE-BUFFER TO MSG-TEXT
                   MOVE DE2-REQ-NO  TO  MSG-FLD
                   MOVE MESSAGE-BUFFER TO DE2-MESSAGE-LINE
                                          DE2-MESSAGE-LINE-L
                   PERFORM 4-PGM-ERROR  THRU  4-PGM-ERROR-X
                   GO TO 66-PRN-X
               ELSE
                   MOVE "GET MREQ*66-PRN"  TO  BU-DISPLAY-MSG
                   MOVE REQ-ARG         TO  BU-DISPLAY-FLD (2)
                   GO TO 2100-BLOWUP.

           IF NON-CODED-RELEASE-SW = "Y"
             IF REQ-MAT-TYPE NOT = "N"
      **          "RELEASE MUST BE NON-CODED, ENTER 'NON-CODED' REQ
                 MOVE "Y"  TO  ERR-SW
                 MOVE  18 TO LANG-SETNUM
                 MOVE  24 TO LANG-MSGNUM
                 PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                 MOVE MESSAGE-BUFFER TO DE2-MESSAGE-LINE
                                        DE2-MESSAGE-LINE-L
                 PERFORM 4-PGM-ERROR  THRU  4-PGM-ERROR-X
                 GO TO 66-PRN-X
             ELSE
                 NEXT SENTENCE
           ELSE
           IF NON-RECV-SW = "Y"
             IF REQ-MAT-TYPE NOT = "N"
      **      "NON-RECEIVABLE PO MUST BE NON-CODED, ENTER NON-CODED REQ
                 MOVE "Y"  TO  ERR-SW
                 MOVE  14 TO LANG-SETNUM
                 MOVE  45 TO LANG-MSGNUM
                 PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                 MOVE MESSAGE-BUFFER TO DE2-MESSAGE-LINE
                                        DE2-MESSAGE-LINE-L
                 PERFORM 4-PGM-ERROR  THRU  4-PGM-ERROR-X
                 GO TO 66-PRN-X.

           IF REQ-MATCONT-RELEASE  NOT = "X"
               IF REQ-TYPE = "S"
      *            "REQUISITION NOT RELEASED - CONTACT MATERIALS CONTROL"
                   MOVE  18 TO LANG-SETNUM
                   MOVE  12 TO LANG-MSGNUM
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE MESSAGE-BUFFER TO DE2-MESSAGE-LINE
                                          DE2-MESSAGE-LINE-L
                   MOVE "Y"  TO  ERR-SW
                   PERFORM 4-PGM-ERROR  THRU  4-PGM-ERROR-X
                   GO TO 66-PRN-X
               ELSE
      *            "REQUISITION NOT RELEASED - CONTACT ORIGINATOR"
                   MOVE  18 TO LANG-SETNUM
                   MOVE  13 TO LANG-MSGNUM
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE MESSAGE-BUFFER TO DE2-MESSAGE-LINE
                                          DE2-MESSAGE-LINE-L
                   MOVE "Y"  TO  ERR-SW
                   PERFORM 4-PGM-ERROR  THRU 4-PGM-ERROR-X
                   GO TO 66-PRN-X.

           IF REQ-STATUS = "SS"
               IF REQ-APPROVALS-LEFT = "  "
                   NEXT SENTENCE
               ELSE
               IF REQ-APPROVALS-LEFT-9 > 0
                   MOVE 19 TO LANG-SETNUM
                   MOVE 47 TO LANG-MSGNUM
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE MESSAGE-BUFFER TO DE2-MESSAGE-LINE
                                          DE2-MESSAGE-LINE-L
                   MOVE "Y" TO ERR-SW
                   PERFORM 4-PGM-ERROR THRU 4-PGM-ERROR-X
                   GO TO 66-PRN-X.

           MOVE 0 TO COND-WORD.
           MOVE REQ-ARG TO REQNO OF DREQD-REC-I.
           START DREQD-I KEY = REQNO OF DREQD-REC-I
               INVALID KEY MOVE 17 TO COND-WORD.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
                   MOVE 17 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.
      *    CALL "DBFIND" USING BASE, DSET-DREQD, MODE1,
      *        STATUS-AREA, REQ-SEARCH, REQ-ARG.
           IF COND-WORD NOT = 0
               MOVE "FIND DREQD * 66-GD" TO BU-DISPLAY-MSG
               MOVE REQ-ARG               TO BU-DISPLAY-FLD (2)
               GO TO 2100-BLOWUP.
           MOVE 0 TO COND-WORD.
           READ DREQD-I NEXT INTO BUF-DREQD
               AT END MOVE 15 TO COND-WORD.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14"
                   MOVE 15 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.
           IF REQNO OF DREQD-REC-I NOT = REQ-ARG
               MOVE 15 TO COND-WORD.
      *    CALL "DBGET" USING BASE, DSET-DREQD, MODE5,
      *        STATUS-AREA, ALL-ITEMS, BUF-DREQD, REQ-ARG.
           IF COND-WORD NOT =  0
               MOVE "GET DREQD * 66-GD"  TO  BU-DISPLAY-MSG
               MOVE REQ-ARG           TO  BU-DISPLAY-FLD (2)
               GO TO 2100-BLOWUP.

           IF DREQD-PO-RCV-NO NOT = SPACES
      *        "REQUISITON HAS ALREADY BEEN ASSIGNED A P.O."
               MOVE  18 TO LANG-SETNUM
               MOVE  14 TO LANG-MSGNUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER TO MSG-TEXT
               MOVE "Y"  TO  ERR-SW
               IF DREQD-PO-RLSE  =  "000"
                   MOVE DREQD-PO-NUM       TO  MSG-FLD
                   MOVE MESSAGE-BUFFER     TO  DE2-MESSAGE-LINE
                                               DE2-MESSAGE-LINE-L
                   PERFORM 4-PGM-ERROR  THRU  4-PGM-ERROR-X
                   GO TO 66-PRN-X
               ELSE
                   MOVE DREQD-PO-NUM-RLSE  TO  MSG-FLD
                   MOVE MESSAGE-BUFFER     TO  DE2-MESSAGE-LINE
                                               DE2-MESSAGE-LINE-L
                   PERFORM 4-PGM-ERROR  THRU  4-PGM-ERROR-X
                   GO TO 66-PRN-X.

           PERFORM 661-LOAD-REQ-ITEM  THRU  661-LRI-X.

           IF CODE-DUP-SW = "Y" GO TO 66-PRN-X.

           PERFORM 661-LOAD-REQ-DESC  THRU  661-LRD-X.

       66-PRN-X.
           EXIT.

      ********************************************
      *
      *  THIS PROCEDURE LOADS THE POSSIBLE ITEM
      *  FIELDS WITH ANY INFO. THAT CAN BE TAKEN
      *  USING THE CORP-CODE.  THIS INCLUDES
      *  TAX CODE, PRICE, PRICE-UM
      *
      ********************************************

       66-PROCESS-CODE-NO.
           MOVE 31         TO  FIELD-NUMBER.
           MOVE SPACES     TO  ERR-SW.


      ********************************************
      *
      *  IF THIS ORDER IS A RELEASE MAKE SURE THE
      *  ITEMS ARE NON-CODED.  THEY CANNOT CREATE
      *  CODED SHIPPING RELEASES USING THIS
      *  PROGRAM
      *
      ********************************************

           IF NON-CODED-RELEASE-SW = "Y"
               IF DE2-CODE = "NC"
                   NEXT SENTENCE
               ELSE
      **        "RELEASE MUST BE NON-CODED ENTER 'NC' IN CODE"
                   MOVE "Y"  TO  ERR-SW
                   MOVE 18  TO  LANG-SETNUM
                   MOVE 30  TO  LANG-MSGNUM
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE MESSAGE-BUFFER TO DE2-MESSAGE-LINE
                                          DE2-MESSAGE-LINE-L
                   PERFORM 4-PGM-ERROR  THRU  4-PGM-ERROR-X
                   GO TO 66-PCN-X.

      ********************************************
      *
      *  IF THIS ORDER IS A NON-RECEIVABLE MAKE SURE THE
      *  ITEMS ARE NON-CODED.  THEY CANNOT CREATE
      *  CODED NON-RECEIVABLE POs USING THIS
      *  PROGRAM
      *
      ********************************************

           IF NON-RECV-SW = "Y"
               IF DE2-CODE = "NC"
                   NEXT SENTENCE
               ELSE
      **        "NON-RECEIVABLE MUST BE NON-CODED ENTER 'NC' IN CODE"
                   MOVE "Y"  TO  ERR-SW
                   MOVE 14  TO  LANG-SETNUM
                   MOVE 46  TO  LANG-MSGNUM
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE MESSAGE-BUFFER TO DE2-MESSAGE-LINE
                                          DE2-MESSAGE-LINE-L
                   PERFORM 4-PGM-ERROR  THRU  4-PGM-ERROR-X
                   GO TO 66-PCN-X.

           IF DE2-CODE = "NC"
               GO TO 66-LOAD-CODE-INFO.

           MOVE DE2-CODE              TO  CODE-ARG.
      *    PREVENT SAME CODE FROM BEING ADDED TO A REQUIREMENT ORDER
           IF PO-REL = "999"
               PERFORM 669-CHECK-DUPLICATES THRU 669-CD-X.
           IF CODE-DUP-SW = "Y" GO TO 66-PCN-X.
           MOVE 0 TO COND-WORD.
           MOVE CODE-ARG TO CORPCDE OF MSTORERM-REC-I.
           READ MSTORERM-I INTO BUF-MSTORERM
               INVALID KEY MOVE 17 TO COND-WORD.
           IF FILE-STATUS-1 = "2"
               MOVE 17 TO COND-WORD
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD.
      *    CALL "DBGET" USING BASE, DSET-MSTORERM, MODE7,
      *        STATUS-AREA, ALL-ITEMS, BUF-MSTORERM, CODE-ARG.
           IF COND-WORD NOT = ZERO
               IF COND-WORD = 17
      *             "STORES CODE DOES NOT EXIST"
                   MOVE  19 TO LANG-SETNUM
                   MOVE   9 TO LANG-MSGNUM
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE MESSAGE-BUFFER TO DE2-MESSAGE-LINE
                                          DE2-MESSAGE-LINE-L
                   PERFORM 4-PGM-ERROR  THRU  4-PGM-ERROR-X
                   MOVE "Y"  TO  ERR-SW
                   GO TO 66-PCN-X
               ELSE
                   MOVE "GET MSTORERM * 66-VC" TO BU-DISPLAY-MSG
                   MOVE CODE-ARG                TO BU-DISPLAY-FLD (2)
                   GO TO 2100-BLOWUP.

           IF CONSIGNED-PO AND STR-CODE-OWNER = " "
                           AND ITEM-NO-SAVE > 1
      *        "CANNOT ADD NON-CONSIGNED ITEM TO CONSIGNED PO"
               MOVE  03 TO LANG-SETNUM
               MOVE 636 TO LANG-MSGNUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER TO DE2-MESSAGE-LINE
                                      DE2-MESSAGE-LINE-L
               PERFORM 4-PGM-ERROR  THRU  4-PGM-ERROR-X
               MOVE "Y"  TO  ERR-SW
               GO TO 66-PCN-X.

           IF NON-CONSIGNED-PO AND STR-CODE-OWNER > " "
                               AND ITEM-NO-SAVE > 1
                               AND NOT ZBILL-PO
      *        "CANNOT ADD CONSIGNED ITEM TO NON-CONSIGNED PO"
               MOVE  03 TO LANG-SETNUM
               MOVE 637 TO LANG-MSGNUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER TO DE2-MESSAGE-LINE
                                      DE2-MESSAGE-LINE-L
               PERFORM 4-PGM-ERROR  THRU  4-PGM-ERROR-X
               MOVE "Y"  TO  ERR-SW
               GO TO 66-PCN-X.

           MOVE STR-TAX-CODE            TO  DE2-TAX-CODE
                                            DE2-TAX-CODE-L.
           MOVE STR-STD-INST            TO  DE2-STD-INST-TABLE
                                            DE2-STD-INST-TABLE-L.
           MOVE STR-RCV-STD-INST        TO  DE2-RCV-INST-TABLE
                                            DE2-RCV-INST-TABLE-L.
           MOVE STR-CLASS               TO  SUB-SAVE.
           MOVE STR-UM                  TO  DE2-QTY-UM,
                                            DE2-QTY-UM-L,
                                            DE2-PRICE-UM
                                            DE2-PRICE-UM-L.
           MOVE STR-QS9000-TRACK        TO  DE2-QS9000-TRACKING
                                            DE2-QS9000-TRACKING-L.

      *-------- MOVE MARKET COST TO UNIT VALUE FOR REPAIR ORDER.
      *****IF ZBILL-PO
      *****    ADD 0 STR-MKT-COST   GIVING  DE2-ITEM-VALUE   ROUNDED
      *****                                 DE2-ITEM-VALUE-L ROUNDED.

           PERFORM 67-GET-LAST-PRICE  THRU  67-GLP-X.
           PERFORM 67-GET-ONE-MANUFACTURER  THRU  67-GOM-X.

       66-LOAD-CODE-INFO.
           IF DE2-TAX-CODE  =  SPACES
               MOVE SAVE-TAX-CODE       TO  DE2-TAX-CODE
                                            DE2-TAX-CODE-L.
           MOVE SUB-SAVE                TO  DE2-SUB
                                            DE2-SUB-L.
           IF ADD-ITEM-COMPANY-SAVE = "126"
               MOVE STR-DIR-CHRG-DEPT   TO  SUBD-SAVE.

      *--------- CHECK MSTORERM FIELDS FOR VALLEYFIELD.
           IF ADD-ITEM-COMPANY-SAVE = "629"
             IF DE2-CODE NOT = "NC"
               MOVE STR-EXPENSE-CLASS      TO  ADDTL-DATA-SAVE
               MOVE STR-DIR-CHRG-DEPT      TO  SUBD-SAVE
               IF SUBD-SAVE = SPACES OR SUBD-SAVE = "0000"
                   MOVE "6325"             TO  SUBD-SAVE
                   MOVE SPACES             TO  ADDTL-DATA-SAVE.

           MOVE SUBD-SAVE               TO  DE2-SUB-DETL
                                            DE2-SUB-DETL-L.
           MOVE ADDTL-DATA-SAVE         TO  DE2-ADDTDATA
                                            DE2-ADDTDATA-L.
           MOVE DE2-CODE                TO  DS2-CODE
                                            DS2-CODE-L.

           MOVE SPACES                  TO  DE2-DESC-AREA,
                                            DE2-DESC-AREA-L,
                                            DE2-MORE-DESC-MSG
                                            DE2-MORE-DESC-MSG-L.

       66-PCN-X.
           EXIT.

       661-LOAD-REQ-DESC.
           MOVE 0 TO COND-WORD.
           MOVE REQ-ARG TO REQNO OF DREQDESC-REC-I.
           START DREQDESC-I KEY = REQNO OF DREQDESC-REC-I
               INVALID KEY MOVE 0 TO COND-WORD.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "23"
                   MOVE 0 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.
      *    CALL "DBFIND" USING BASE, DSET-DREQDESC, MODE1,
      *        STATUS-AREA, REQ-SEARCH, REQ-ARG.
           IF COND-WORD NOT =  0
               MOVE "FIND DREQDESC *661-LRD"  TO  BU-DISPLAY-MSG
               MOVE REQ-ARG              TO  BU-DISPLAY-FLD (2)
               GO TO 2100-BLOWUP.

       661-LOAD-DESC.
           MOVE SPACES                    TO  DE2-DESC-AREA,
                                              DE2-DESC-AREA-L,
                                              DE2-MORE-DESC-MSG
                                              DE2-MORE-DESC-MSG-L.
           MOVE ZERO                      TO  DESC-SUB.

       661-LOAD-DESC-LOOP.
           MOVE 0 TO COND-WORD.
           READ DREQDESC-I NEXT INTO BUF-DREQDESC
               AT END MOVE 15 TO COND-WORD.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   MOVE 15 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.
           IF REQNO OF DREQDESC-REC-I NOT = REQ-ARG
               MOVE 15 TO COND-WORD.
      *    CALL "DBGET" USING BASE, DSET-DREQDESC, MODE5,
      *        STATUS-AREA, ALL-ITEMS, BUF-DREQDESC, REQ-ARG.
           IF COND-WORD NOT = 0
               IF COND-WORD = 15
                   MOVE "Y"  TO  END-OF-REQ-DESC-SW
                   GO TO 661-LRD-X
               ELSE
                   MOVE "GET DREQDESC * 661-LDL" TO BU-DISPLAY-MSG
                   MOVE REQ-ARG                TO BU-DISPLAY-FLD (2)
                   GO TO 2100-BLOWUP.
           ADD 1  TO  DESC-SUB.
           IF DESC-SUB > 7
               READ DREQDESC-I PRIOR INTO BUF-DREQDESC
               IF FILE-STATUS NOT = "00"
                   MOVE "READ PRIOR DREQDESC * 661-LDL"
                       TO BU-DISPLAY-MSG
                   MOVE REQ-ARG TO BU-DISPLAY-FLD (2)
                   GO TO 2100-BLOWUP
               ELSE
      *             "MORE DESCRIPTION PRESS 'f2' TO VIEW"
                   MOVE  13 TO LANG-SETNUM
                   MOVE  33 TO LANG-MSGNUM
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE MESSAGE-BUFFER TO DE2-MORE-DESC-MSG
                                          DE2-MORE-DESC-MSG-L
                   GO TO 661-LRD-X.

      *********************************************************
      **   REQ. REMARKS ARE LINE NOS '95' AND '96' IF THEY
      **   ARE FOUND DONT PRINT THEM IN THE DESCRIPTION SCREEN
      **   BLOCK INSTEAD EXIT ROUTINE SINCE REMARKS ARE LAST
      **   THERES NO MORE DESC. AFTER REMARK LINES IN 'DREQDESC'
      *********************************************************

           IF REQDESC-LINE-NO = "95" OR "96"
               MOVE "Y"                 TO  END-OF-REQ-DESC-SW
               GO TO 661-LRD-X
           ELSE
               MOVE REQDESC-DATA        TO  DE2-DESC (DESC-SUB)
                                            DE2-DESC-L (DESC-SUB)
               GO TO 661-LOAD-DESC-LOOP.

       661-LRD-X.
           EXIT.

       661-LOAD-REQ-ITEM.
           MOVE 0 TO COND-WORD.
           MOVE REQ-ARG TO REQNO OF DREQITM-REC-I.
           START DREQITM-I KEY = REQNO OF DREQITM-REC-I
               INVALID KEY MOVE 0 TO COND-WORD.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS  = "23"
                   MOVE 0 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.
      *    CALL "DBFIND" USING BASE, DSET-DREQITM, MODE1,
      *        STATUS-AREA, REQ-SEARCH, REQ-ARG.
           IF COND-WORD NOT =  0
               MOVE "FIND DREQITM * 661-LRI"  TO  BU-DISPLAY-MSG
               MOVE REQ-ARG               TO  BU-DISPLAY-FLD (2)
               GO TO 2100-BLOWUP.

           MOVE 0 TO COND-WORD.
           READ DREQITM-I NEXT INTO BUF-DREQITM
               AT END MOVE 15 TO COND-WORD.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   MOVE 15 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.
           IF REQNO OF DREQITM-REC-I NOT = REQ-ARG
               MOVE 15 TO COND-WORD.
      *    CALL "DBGET" USING BASE, DSET-DREQITM, MODE5,
      *        STATUS-AREA, ALL-ITEMS, BUF-DREQITM, REQ-ARG.
           IF COND-WORD NOT = 0
               IF COND-WORD = 15
      *            "NO ITEM ON REQ- ERROR CONTACT AKRON"
                   MOVE  14 TO LANG-SETNUM
                   MOVE   9 TO LANG-MSGNUM
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE MESSAGE-BUFFER TO MSG-TEXT
                   MOVE DE2-REQ-NO  TO  MSG-FLD
                   MOVE MESSAGE-BUFFER TO DE2-MESSAGE-LINE
                                          DE2-MESSAGE-LINE-L
                   MOVE "Y"         TO  ERR-SW
                   MOVE 12          TO  FIELD-NUMBER
                   PERFORM 4-PGM-ERROR  THRU  4-PGM-ERROR-X
                   GO TO 661-LRI-X
               ELSE
                   MOVE "GET DREQITM * 661-LRI" TO BU-DISPLAY-MSG
                   MOVE REQ-ARG                 TO BU-DISPLAY-FLD (2)
                   GO TO 2100-BLOWUP.

           IF REQITM-CORP-CODE = "NON-STR"
               MOVE "NC"                TO  DS2-CODE
                                            DS2-CODE-L
           ELSE
               MOVE REQITM-CORP-CODE    TO  DS2-CODE,
                                            DS2-CODE-L,
                                            CODE-ARG
               IF PO-REL = "999"
                   PERFORM 669-CHECK-DUPLICATES THRU 669-CD-X
                   IF CODE-DUP-SW = "Y"
                       MOVE SPACES      TO  DS2-CODE
                                            DS2-CODE-L
                       GO TO 661-LRI-X.
           MOVE REQITM-QTY-TO-ORD       TO  DE2-QTY
                                            DE2-QTY-L.
           MOVE REQITM-UM               TO  DE2-QTY-UM
                                            DE2-QTY-UM-L,
                                            DE2-PRICE-UM,
                                            DE2-PRICE-UM-L.
           MOVE REQ-CO                  TO  DE2-COMPANY-L.
           MOVE REQ-PRIME               TO  DE2-PRIME-L.
           MOVE REQ-SUB                 TO  DE2-SUB,
                                            DE2-SUB-L.
           MOVE REQ-SUBD                TO  DE2-SUB-DETL,
                                            DE2-SUB-DETL-L
                                            REQ-SUBD-SAVE.
           MOVE REQ-ADDTL-DATA          TO  DE2-ADDTDATA,
                                            DE2-ADDTDATA-L.
           IF REQITM-CORP-CODE = "NON-STR"
      *-----  DEFAULT TAX-CODE FROM DREQITM IF ENTERED

               IF REQITM-TAX-CODE NOT = SPACES
                  MOVE REQITM-TAX-CODE  TO  DE2-TAX-CODE
                                            DE2-TAX-CODE-L
               ELSE
                  MOVE SAVE-TAX-CODE    TO  DE2-TAX-CODE
                                            DE2-TAX-CODE-L
           ELSE
               PERFORM 67-GET-TAX-CODE  THRU  67-GTC-X
               PERFORM 67-GET-LAST-PRICE  THRU  67-GLP-X
               PERFORM 67-GET-ONE-MANUFACTURER  THRU  67-GOM-X.

      ***********************************************************
      *    ADDED A SPECIAL CHECK FOR NAPANEE 12/04/95 DUE TO
      *    A PROBLEM THEY UNCOVERED WHEREBY SOME OF THEIR
      *    STOREROOM CODES WERE GETTING INPUT ON REQUISITIONS
      *    PROCESSED FROM WORK ORDERS BUT DID NOT CONTAIN AN
      *    EXPENSE CLASS AND WERE BEING TREATED AS STOREROOM
      *    ITEMS INSTEAD OF DIRECT DELIVERIES.....J.E. COFFMAN
      ***********************************************************
           IF REQITM-CORP-CODE = "NON-STR"
               NEXT SENTENCE
           ELSE
           IF REQ-CO = "631"
               IF REQ-SUBD = "1210"
                   MOVE "000000"        TO  DE2-ADDTDATA,
                                            DE2-ADDTDATA-L
               ELSE
               IF REQ-SUBD = "0000"
                   NEXT SENTENCE
               ELSE
               MOVE STR-EXPENSE-CLASS   TO  DE2-ADDTDATA,
                                            DE2-ADDTDATA-L.
       661-LRI-X.
           EXIT.

       669-CHECK-DUPLICATES.
           MOVE "N" TO CODE-DUP-SW.
           MOVE CODE-ARG TO CORPCDE OF DPOITEM-REC-L1.
           START DPOITEM-L1 KEY = EXTERNALLY-DESCRIBED-KEY
               INVALID KEY    MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00" GO TO 669-CD-X.
       669-CD-LOOP.
           READ DPOITEM-L1 NEXT INTO BUF-DPOITEM
               AT END    MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00" GO TO 669-CD-X.
           IF CODE-ARG NOT = ITM-CORP-CODE GO TO 669-CD-X.
           IF ITM-PO-RCV-NO = PO-ARG
               MOVE "Y" TO CODE-DUP-SW
           ELSE
           GO TO 669-CD-LOOP.
       669-CD-X.    EXIT.

       67-GET-TAX-CODE.
           MOVE 0 TO COND-WORD.
           MOVE CODE-ARG TO CORPCDE OF MSTORERM-REC-I.
           READ MSTORERM-I INTO BUF-MSTORERM
               INVALID KEY MOVE 17 TO COND-WORD.
           IF FILE-STATUS-1 = "2"
               MOVE 17 TO COND-WORD
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD.
      *    CALL "DBGET" USING BASE, DSET-MSTORERM, MODE7,
      *        STATUS-AREA, ALL-ITEMS, BUF-MSTORERM, CODE-ARG.
           IF COND-WORD NOT = ZERO
               MOVE "GET MSTORERM * 67-GTC" TO BU-DISPLAY-MSG
               MOVE CODE-ARG                TO BU-DISPLAY-FLD (2)
               GO TO 2100-BLOWUP.

           MOVE STR-STD-INST          TO  DE2-STD-INST-TABLE
                                          DE2-STD-INST-TABLE-L.
           MOVE STR-RCV-STD-INST      TO  DE2-RCV-INST-TABLE
                                          DE2-RCV-INST-TABLE-L.

      *-----  DEFAULT TAX-CODE FROM DREQITM IF ENTERED

           IF REQITM-TAX-CODE NOT = SPACES
              MOVE REQITM-TAX-CODE    TO DE2-TAX-CODE
                                         DE2-TAX-CODE-L
              GO TO 67-GTC-X.

           MOVE STR-TAX-CODE          TO  TAX-ARG.
           MOVE 0 TO COND-WORD.
           MOVE TAX-ARG               TO TAXCDE OF MTAX-REC-I.
           READ MTAX-I INTO BUF-MTAX
               INVALID KEY MOVE 17 TO COND-WORD.
           IF FILE-STATUS-1 = "2"
               MOVE 17 TO COND-WORD
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD.
      *    CALL "DBGET" USING BASE, DSET-MTAX, MODE7,
      *        STATUS-AREA, ALL-ITEMS, BUF-MTAX, TAX-ARG.
           IF COND-WORD NOT = 0
               IF COND-WORD = 17
                   MOVE SAVE-TAX-CODE  TO  DE2-TAX-CODE
                                           DE2-TAX-CODE-L
               ELSE
                   MOVE "GET MTAX * 66-GTC" TO BU-DISPLAY-MSG
                   MOVE TAX-ARG TO  BU-DISPLAY-FLD (2)
                   GO TO 2100-BLOWUP
           ELSE
               MOVE STR-TAX-CODE      TO  DE2-TAX-CODE
                                          DE2-TAX-CODE-L.

       67-GTC-X.
           EXIT.

       67-GET-LAST-PRICE.
           MOVE 0 TO COND-WORD.
           MOVE CODE-ARG TO CORPCDE OF DVENDITM-REC-I.
           START DVENDITM-I KEY = CORPCDE OF DVENDITM-REC-I
               INVALID KEY MOVE 0 TO COND-WORD.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "23"
                   MOVE 0 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.
      *    CALL "DBFIND" USING BASE, DSET-DVENDITM, MODE1,
      *        STATUS-AREA, CODE-SEARCH, CODE-ARG.
           IF COND-WORD NOT = ZERO
               MOVE "FIND DVENDITM * 67-GLP"  TO  BU-DISPLAY-MSG
               MOVE CODE-ARG                  TO  BU-DISPLAY-FLD (2)
               GO TO 2100-BLOWUP.

           MOVE ZEROS                   TO DE2-PRICE
                                           DE2-PRICE-L.

      *********************************************************
      **   RULES FOR GETTING A LAST PO PRICE                 **
      **    - USE THE LAST ACTIVE QUOTE PRICE (AN ACTIVE     **
      **       QUOTE IS A QUOTE THAT HAS REACHED ITS         **
      **       EFFECTIVE DATE (VEN-CREATE-DATE) AND HAS NOT  **
      **       EXPIRED YET (VEN-ITM-PRICE-DATE)              **
      **    - IF NOT ACTIVE QUOTE EXIST THEN USE FIRST       **
      **      PO PRICE OR NON-ACTIVE QUOTE FOUND THAT HAS    **
      **      A PRICE                                        **
      *********************************************************

       67-GET-DVENDITM.
           MOVE 0 TO COND-WORD.
           READ DVENDITM-I NEXT INTO BUF-DVENDITM
               AT END MOVE 15 TO COND-WORD.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   MOVE 15 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.
           IF CORPCDE OF DVENDITM-REC-I NOT = CODE-ARG
               MOVE 15 TO COND-WORD.
      *    CALL "DBGET" USING BASE, DSET-DVENDITM, MODE5,
      *        STATUS-AREA, ALL-ITEMS, BUF-DVENDITM, CODE-ARG.
           IF COND-WORD = ZERO
               IF VEN-ITM-VENCODE = VEN-ARG
                   IF VEN-QUOTE-FLAG = "Q"
      *--------------------- ACCOUNT FOR CENTURY.
                       IF VEN-CREATE-DATE-CN = SPACES  OR
                          VEN-ITM-PRICE = ZEROS
                           NEXT SENTENCE
                       ELSE
                       IF VEN-CREATE-DATE-CN > CUR-DATE-CN  OR
                          VEN-ITM-PRICE-DATE-CN < CUR-DATE-CN
                          IF DE2-PRICE = ZEROS
                              PERFORM 671-LOAD-QUOTE-PRICE
                          ELSE
                              NEXT SENTENCE
                       ELSE
                           PERFORM 671-LOAD-QUOTE-PRICE
                   ELSE
                       IF DE2-PRICE = ZEROS
                           PERFORM 671-LOAD-QUOTE-PRICE
                       ELSE
                           NEXT SENTENCE
               ELSE
                   NEXT SENTENCE
           ELSE
               IF COND-WORD = 15
                   GO TO 67-GLP-X
               ELSE
                   MOVE "GET DVENDITM * 671-GD" TO BU-DISPLAY-MSG
                   MOVE CODE-ARG                TO BU-DISPLAY-FLD (2)
                   GO TO 2100-BLOWUP.

           GO TO 67-GET-DVENDITM.

       67-GLP-X.
           EXIT.

       67-GET-ONE-MANUFACTURER.
           MOVE SAVE-MANUFACT-LIT       TO  DE2-MANUFACTUR-LIT
                                            DE2-MANUFACTUR-LIT-L.
           MOVE "M"                     TO  CDESC-DESC-OPTION.
           MOVE "S"                     TO  CDESC-MANUFACT-OPTION.
           CALL "CDESC" USING RET-CODE,
                              BASE,
                              STATUS-AREA,
                              BU-DISPLAY-MSG,
                              CODE-ARG,
                              CDESC-DATA.
           IF BU-DISPLAY-MSG-1  NOT = SPACES
               MOVE CODE-ARG            TO  BU-DISPLAY-FLD (2)
               GO TO 2100-BLOWUP.

           IF CDESC-LINES-GOT > 0
               MOVE CDESC (1)           TO  DE2-MANUFACTUR-SELECT
                                            DE2-MANUFACTUR-SELECT-L.

       67-GOM-X.
           EXIT.

       67-GET-VENDOR-ADDRESS.
           MOVE 0 TO COND-WORD.
           MOVE VEN-ARG TO VENCDE OF DVENDOR-REC-I.
           START DVENDOR-I KEY = VENCDE OF DVENDOR-REC-I
               INVALID KEY MOVE 17 TO COND-WORD.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
                   MOVE 17 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.
      *    CALL "DBFIND" USING BASE, DSET-DVENDOR, MODE1,
      *        STATUS-AREA, VEN-SEARCH, VEN-ARG.
           IF COND-WORD NOT = 0
               IF COND-WORD = 17
                   GO TO 67-GVA-X
               ELSE
                   MOVE "FIND DVENDOR * 67-GVA" TO BU-DISPLAY-MSG
                   MOVE VEN-ARG             TO BU-DISPLAY-FLD (2)
                   GO TO 2100-BLOWUP.

      *    IF CHAIN-LENG = ZEROS
      *        GO TO 67-GVA-X.

           MOVE VEN-ARG                 TO  DE2-MORE-DESC-MSG
                                            DE2-MORE-DESC-MSG-L.
      **  VENDOR VERIFICATION
           MOVE  22                     TO  LANG-SETNUM.
           MOVE  19                     TO  LANG-MSGNUM.
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
           MOVE MESSAGE-BUFFER          TO  DE2-DESC-LIT
                                            DE2-DESC-LIT-L.
      **  VERIFY VENDOR IS CORRECT; PRESS 'f1' IF VENDOR IS INCORRECT
           MOVE  22                     TO  LANG-SETNUM.
           MOVE  20                     TO  LANG-MSGNUM.
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
           MOVE MESSAGE-BUFFER          TO  DE2-DESC (7)
                                            DE2-DESC-L (7).

           MOVE ZERO                    TO  SUB.

       67-GET-DVENDOR.
           MOVE 0 TO COND-WORD.
           READ DVENDOR-I NEXT INTO BUF-DVENDOR
               AT END MOVE 15 TO COND-WORD.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14"
                   MOVE 15 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.
           IF VENCDE OF DVENDOR-REC-I NOT = VEN-ARG
               MOVE 15 TO COND-WORD.
      *    CALL "DBGET" USING BASE, DSET-DVENDOR, MODE5,
      *        STATUS-AREA, ALL-ITEMS, BUF-DVENDOR, VEN-ARG.
           IF COND-WORD NOT = 0
               IF COND-WORD = 15
                   GO TO 67-GVA-X
               ELSE
                   MOVE "GET DVENDOR *67-GD" TO BU-DISPLAY-MSG
                   MOVE VEN-ARG         TO  BU-DISPLAY-FLD (2)
                   GO TO 2100-BLOWUP.

           ADD 1   TO  SUB.
           IF SUB > 5
               GO TO 67-GVA-X.
           IF VEN-ITM-NO > 07
               GO TO 67-GVA-X
           ELSE
           IF VEN-ITM-NO = 07
               MOVE SPACES              TO  VEN-ZIP-BEFORE-CITY
               MOVE VEN-ITM-DATA        TO  DE2-DESC (SUB)
                                            DE2-DESC-L (SUB)
           ELSE
               MOVE VEN-ITM-DATA        TO  DE2-DESC (SUB)
                                            DE2-DESC-L (SUB).

           GO TO 67-GET-DVENDOR.

       67-GVA-X.
           EXIT.

       671-LOAD-QUOTE-PRICE.
           MOVE VEN-ITM-PRICE-UM        TO DE2-PRICE-UM
                                           DE2-PRICE-UM-L.

      *---------- CHECK FOR NON-NUMERIC DATA.
           IF VEN-DSCT IS NOT NUMERIC
               MOVE ZEROS TO VEN-DISCOUNT-PERCENT.

           IF VEN-DISCOUNT-PERCENT = ZEROS
               MOVE VEN-ITM-PRICE       TO DE2-PRICE
                                           DE2-PRICE-L
               MOVE SPACES              TO DE2-DISCOUNT-AREA
                                           DE2-DISCOUNT-AREA-L
           ELSE
               COMPUTE DISCOUNT-PERCENT ROUNDED =
                   VEN-DISCOUNT-PERCENT / 100
               COMPUTE DISCOUNT-PRICE ROUNDED = VEN-ITM-PRICE -
                   (VEN-ITM-PRICE * DISCOUNT-PERCENT)
               MOVE DISCOUNT-PRICE      TO DE2-PRICE
                                           DE2-PRICE-L
               MOVE VEN-ITM-PRICE       TO DIS-PRE-PRICE
               MOVE VEN-DISCOUNT-PERCENT TO DIS-DISCOUNT-PERCENT
               IF DIS-PRICE-LIT = SPACES
      **          PRE-DISCOUNT PRICE
                   MOVE  16             TO  LANG-SETNUM
                   MOVE  133            TO  LANG-MSGNUM
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE MESSAGE-BUFFER  TO  DIS-PRICE-LIT
                   MOVE DISCOUNT-PRICE-DIS-LIT TO  DE2-DISCOUNT-AREA
                                                   DE2-DISCOUNT-AREA-L
               ELSE
                   MOVE DISCOUNT-PRICE-DIS-LIT TO  DE2-DISCOUNT-AREA
                                                   DE2-DISCOUNT-AREA-L.


       COPY DISPCALL IN COPYLIB.

       999-CATREAD.
           IF CATREAD-MSG-NUMBER = ZEROS
               MOVE LANG-SETNUM TO CATREAD-MSG-SET
               MOVE LANG-MSGNUM TO CATREAD-MSG-NUM.
           CALL "CCATREAD" USING CATREAD-PARMS.
           MOVE CATREAD-MSG-TEXT TO MESSAGE-BUFFER.
       999-CATREAD-EXIT.
           EXIT.

       9000-START-MVALIDPLTDATA-I.
           MOVE 0 TO COND-WORD.
           MOVE MVALIDPLT-ARG TO VALDTAKEY OF MVALIDPLTDATA-REC-I.
           START MVALIDPLTDATA-I KEY = VALDTAKEY OF MVALIDPLTDATA-REC-I
               INVALID KEY MOVE 17 TO COND-WORD.
           IF FILE-STATUS-1 = "2"
               MOVE 17 TO COND-WORD
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD.

       9000-START-MCLASS-I.
           MOVE 0 TO COND-WORD.
           MOVE PLT-ARG TO ACTGCLASS OF MCLASS-REC-I.
           START MCLASS-I KEY = ACTGCLASS OF MCLASS-REC-I
               INVALID KEY MOVE 17 TO COND-WORD.
           IF FILE-STATUS-1 = "2"
               MOVE 17 TO COND-WORD
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD.

       9999-GETKEY-MPLTINFO-PK-I.
           MOVE 0 TO COND-WORD.
           MOVE PLT-ARG TO PLTINFOKEY OF MPLTINFO-PK-REC-I.
           READ MPLTINFO-PK-I INTO BUF-MPLTINFO
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS = "23"
               MOVE 17 TO COND-WORD
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD
               IF HANDLE-BLOWUP-FLAG = "Y"
                   MOVE "GETKEY ERR 9999-GETKEY-MPLTINFO-PK-I"
                       TO BU-MSG-AREA
                   PERFORM 2100-BLOWUP.

