           05  HANDLE-BLOWUP-FLAG      PIC X       VALUE "Y".

       01  GST-TAX-SW                  PIC X(1).
           88  DONT-TAX-ON-GST                       VALUE "1".
           88  TAX-ON-GST                            VALUE "2".

       01  ZBILL-PO-SW                 PIC X         VALUE SPACE.
           88  ZBILL-PO                              VALUE "1".

       01  SAVE-MANUFACT-LIT     PIC X(26)           VALUE SPACES.
       01  SAVE-ITEM-VALUE-LIT   PIC X(11)           VALUE SPACES.
       01  COUNTERS BINARY.
           05  BUDGET-AMT-SAVED      PIC S9(11)      VALUE ZERO.
           05  READ-CTR              PIC S9(4)       VALUE ZERO.
           05  TOTAL-MTAX-PERCENT    PIC S9(4)V9(5)  VALUE ZERO.
           05  ITEM-EXTENSION-SAVED  PIC S9(11)V9(4) VALUE ZERO.
           05  ITEM-TAX              PIC S9(11)      VALUE ZERO.
           05  GST-TAX               PIC S9(11)V9(4) VALUE ZERO.
           05  GST-ENTRY             PIC S9          VALUE ZERO.
           05  DISCOUNT-PERCENT      PIC 9V9(6)      VALUE ZERO.
           05  DISCOUNT-PRICE        PIC S9(11)V9(4) VALUE ZERO.
           05  SAVE-PRICE-COMPARE    PIC S9(11)V9(4) VALUE ZERO.
           05  SAVE-PRICE-CHG        PIC S9(11)V9(4) VALUE ZERO.
           05  SAVE-PERCENT-CHG      PIC S9(2)V9(2)  VALUE ZERO.
           05  SAVE-ITEM-PRICE       PIC S9(11)V9(4) VALUE ZERO.
           05  SAVE-QTY              PIC 9(8)V9(4)   VALUE ZERO.

       01  SUB-AREA  COMP-4.
           05  SUB                   PIC S99         VALUE ZEROS.
           05  DESC-SUB              PIC S9(4) COMP-4 VALUE ZEROS.

       01  WORK-AREA.
           05  SEQ-NO-SAVE.
               10  SEQ-ITEM-NO-SAVE        PIC 9(4)  VALUE ZEROS.
               10  LINE-NO-SAVE            PIC 99    VALUE ZEROS.

       COPY TDATECHK IN COPYLIB.

       01  DATES-AND-TIMES.
           05  HP-CUR-DATE.
               10  MM               PIC XX.
               10  FILLER           PIC X.
               10  DD               PIC XX.
               10  FILLER           PIC X.
               10  YY               PIC XX.
           05  CUR-DATE-CN.
               10  CUR-DATE-CC      PIC XX.
               10  CUR-DATE.
                   15  YY.
                       20  FILLER   PIC X.
                       20  YR-YR    PIC X.
                   15  MM           PIC XX.
                   15  DD           PIC XX.


       01  WORK-AREA-KEYS.
           05  BUILD-VALID-DEPT-KEY.
               10  DEPT-PREFIX            PIC XX   VALUE "DP".
               10  DEPT-NUM               PIC X(8) VALUE SPACES.

           05  BUILD-EXPENSE-CLASS.
               10  FILLER                 PIC X(2) VALUE "EC".
               10  EXPENSE-CLASS          PIC X(6) VALUE SPACES.

           05  BUILD-NEW-WORK.
               10  FILLER                 PIC X(2) VALUE "NW".
               10  NEW-WORK               PIC X(6) VALUE SPACES.

           05  BUILD-COMMENT-NO.
               10  BUILD-COM-PREFIX       PIC X     VALUE "C".
               10  BUILD-COM-NO           PIC X(3)  VALUE SPACES.


       01  MESSAGE-BUFFER.
           05  MSG-TEXT              PIC X(66)    VALUE SPACE.
           05  MSG-FLD               PIC X(10)    VALUE SPACE.
           05  MSG-FLD-9  REDEFINES  MSG-FLD      PIC Z(9)9.

       01  FIELD-NUMBER              PIC S9(4)    VALUE 1  COMP-4.

       01  WHICH-LABELS              PIC S9(4)    VALUE 1  COMP-4.

       01  LABEL-NUMBER              PIC S9(4)    VALUE 1  COMP-4.

       01  PASS-CORP-CODE            PIC X(7)     VALUE SPACES.

       01  PREV-KEY-LABEL            PIC X(79)    VALUE SPACES.

       01  RETURN-CHAT-NO            PIC X(6)     VALUE SPACES.

       01  END-ITEMS-KEY-LABEL       PIC X(79)    VALUE SPACES.

       COPY CATREAD IN COPYLIB.

       COPY DISPDATA IN COPYLIB.

       COPY IOFEEDBACK IN COPYLIB.

