       IDENTIFICATION DIVISION.
       PROGRAM-ID.     TTAXFILE.
       AUTHOR.         CA YODER.
       DATE-WRITTEN.   JANUARY 2001.
      *REMARKS.
      *
      **************************************************************
      *                                                            *
      *   TTAXFILE   THIS PROGRAM CREATES A FILE CONTAINING        *
      *   --------   INVOICE INFORMATION FOR PURCHASE ORDERS IN    *
      *              A SPECIFIED DATE RANGE.                       *
      *                                                            *
      **************************************************************
      *C
      *C   07/24/2001   CA YODER    UNC REQUEST
      *C     ADDED MANIFEST NUMBER, MANIFEST YEAR, PO NUM, AND
      *C     CHECK DATE TO TAXFILE.
      *C

       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.
       SOURCE-COMPUTER.  IBM-AS400.
       OBJECT-COMPUTER.  IBM-AS400.

       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT INV-PAY-REPORT    ASSIGN TO  DISK-TAXRPT.
           SELECT TAXFILE-FILE      ASSIGN TO DISK-TAXFILE.
           SELECT MPLTINFO-I
                  ASSIGN TO DATABASE-MCFLCS0501
                  ORGANIZATION IS INDEXED
                    ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                  FILE STATUS IS FILE-STATUS.
           SELECT DINVRCD-I
                  ASSIGN TO DATABASE-MCFLCS2501
                  ORGANIZATION IS INDEXED
                    ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                    WITH DUPLICATES
                  FILE STATUS IS FILE-STATUS.
           SELECT DPOFREIGHT-I
                  ASSIGN TO DATABASE-MCFLCS2404
                  ORGANIZATION IS INDEXED
                    ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                    WITH DUPLICATES
                  FILE STATUS IS FILE-STATUS.
           SELECT DINVITM-I
                  ASSIGN TO DATABASE-MCFLCS2601
                  ORGANIZATION IS INDEXED
                    ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                    WITH DUPLICATES
                  FILE STATUS IS FILE-STATUS.
           SELECT DINVACCT-I
                  ASSIGN TO DATABASE-MCFLCS2701
                  ORGANIZATION IS INDEXED
                    ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                    WITH DUPLICATES
                  FILE STATUS IS FILE-STATUS.
           SELECT DVENDOR-I
                  ASSIGN TO DATABASE-MCFLCS0701
                  ORGANIZATION IS INDEXED
                    ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                    WITH DUPLICATES
                  FILE STATUS IS FILE-STATUS.

           SELECT DINVRCDH-I
                  ASSIGN TO DATABASE-MCFLST0805
                  ORGANIZATION IS INDEXED
                    ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                    WITH DUPLICATES
                  FILE STATUS IS FILE-STATUS.

           SELECT DINVITMH-I
                  ASSIGN TO DATABASE-MCFLST0901
                  ORGANIZATION IS INDEXED
                    ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                    WITH DUPLICATES
                  FILE STATUS IS FILE-STATUS.

           SELECT DINVACCTH-I
                  ASSIGN TO DATABASE-MCFLST1001
                  ORGANIZATION IS INDEXED
                    ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                    WITH DUPLICATES
                  FILE STATUS IS FILE-STATUS.

       DATA DIVISION.
       FILE SECTION.

       FD  INV-PAY-REPORT
           LABEL RECORDS ARE OMITTED
           RECORD CONTAINS 133 CHARACTERS
           DATA RECORD IS INV-PAY-REPORT-RCD.
       01  INV-PAY-REPORT-RCD.
           05  INV-PAY-CTL           PIC 9.
           05  INV-PAY-REPORT-LINE   PIC X(132).

       FD  TAXFILE-FILE
           LABEL RECORDS ARE OMITTED
           RECORD CONTAINS 342 CHARACTERS.
       01  TAXFILE-RCD               PIC X(342).

       FD  MPLTINFO-I
           LABEL RECORDS ARE STANDARD.
       01  MPLTINFO-REC-I.
           COPY DDS-MCRPCS0500   OF MCFLCS0501.

       FD  DINVRCD-I
           LABEL RECORDS ARE STANDARD.
       01  DINVRCD-REC-I.
           COPY DDS-MCRPCS2500   OF MCFLCS2501.

       FD  DPOFREIGHT-I
           LABEL RECORDS ARE STANDARD.
       01  DPOFREIGHT-REC-I.
           COPY DDS-MCRPCS2400   OF MCFLCS2404.

       FD  DINVITM-I
           LABEL RECORDS ARE STANDARD.
       01  DINVITM-REC-I.
           COPY DDS-MCRPCS2600   OF MCFLCS2601.

       FD  DINVACCT-I
           LABEL RECORDS ARE STANDARD.
       01  DINVACCT-REC-I.
           COPY DDS-MCRPCS2700   OF MCFLCS2701.

       FD  DVENDOR-I
           LABEL RECORDS ARE STANDARD.
       01  DVENDOR-REC-I.
           COPY DDS-MCRPCS0700   OF MCFLCS0701.

       FD  DINVRCDH-I
           LABEL RECORDS ARE STANDARD.
       01  DINVRCDH-REC-I.
           COPY DDS-MCRPST0800   OF MCFLST0805.

       FD  DINVITMH-I
           LABEL RECORDS ARE STANDARD.
       01  DINVITMH-I-REC.
           COPY DDS-ALL-FORMATS OF MCFLST0901.

       FD  DINVACCTH-I
           LABEL RECORDS ARE STANDARD.
       01  DINVACCTH-I-REC.
           COPY DDS-ALL-FORMATS OF MCFLST1001.

       WORKING-STORAGE SECTION.
       77  PAGE-CTR                 PIC S9(4) COMP-4 VALUE ZEROS.
       77  LINE-CTR                 PIC S9(4) COMP-4 VALUE ZEROS.
       77  FRT-CTR                  PIC S9(4) COMP-4 VALUE ZEROS.
       77  SUB                      PIC 99  COMP-4 VALUE ZEROS.
       77  CALC-INV-AMT             PIC S9(11)V99 COMP-4 VALUE ZEROS.
       77  CALC-PO-EXT              PIC S9(11)V99 COMP-4 VALUE ZEROS.
       77  CALC-INV-EXT             PIC S9(11)V99 COMP-4 VALUE ZEROS.
       77  TOTAL-ACCRUED-TAX        PIC S9(11)V99 COMP-4 VALUE ZEROS.
       77  INV-ENTRY-CTR            PIC S9(4)  COMP-4 VALUE ZEROS.
       77  SKIP-INVOICE-SW          PIC X(1)   VALUE "N".
       77  HOLD-PLT                 PIC X(3).
9406CK 01  SCOPE   PIC X.

       01  TOTAL-ACCUMULATORS.
           05  TOT-INV-TAX-I        PIC S9(10)V99.
           05  TOT-ACCRUED-TAX-I    PIC S9(10)V99.
           05  TOT-INV-FRT-I        PIC S9(10)V99.
           05  TOT-INV-CONT-I       PIC S9(10)V99.
           05  TOT-INV-INS-I        PIC S9(10)V99.
           05  TOT-COL-FRT-I        PIC S9(10)V99.

       01  FORMAT-DATE.
           05  FORMAT-CC            PIC 9(2).
           05  FORMAT-YY            PIC 9(2).
           05  FILLER               PIC 9(4).
       01  FORMAT-DATE-9    REDEFINES   FORMAT-DATE
                                    PIC 9(8).
       01  DISPLAY-DATE             PIC 9(6).

      **************************************
      *   SWITCHES                         *
      **************************************

       01  FILE-STATUS.
           05  FILE-STATUS-1           PIC X        VALUE SPACES.
           05  FILE-STATUS-2           PIC X        VALUE SPACES.

       01  SWITCH-AREA.
           05  EOF-SW                  PIC X        VALUE SPACES.
           05  EOF-DINVRCD             PIC X        VALUE "N".
           05  EOF-DINVRCDH            PIC X        VALUE "N".

       01  REPORT-TYPE                      PIC X   VALUE SPACES.
           88  INV-PAY-REPORT-TYPE                  VALUE "1".


      **************************************************************
      *   DATABASE I/O BUFFER AREA                                 *
      **************************************************************

       COPY DFREIGHT   IN COPYLIB.

       COPY DINVRCD    IN COPYLIB.

       COPY MPLT0      IN COPYLIB.
       COPY MPLTP01    IN COPYLIB.

       COPY DINVITM    IN COPYLIB.

       COPY DINVACCT   IN COPYLIB.

       COPY DINVRCDH   IN COPYLIB.

       COPY DINVITMH   IN COPYLIB.

       COPY DINVACTH   IN COPYLIB.

       COPY DVENDOR    IN COPYLIB.

       COPY DATAB      IN COPYLIB.

       COPY TAXFILE    IN COPYLIB.

       01  ARG-VALUES.
           05  PLT-ARG                PIC X(4)  VALUE SPACES.
           05  REGISTER-ARG           PIC X(6)  VALUE SPACES.
           05  VEN-ARG                PIC X(10) VALUE SPACES.


      *****************************************************
      *   R E P O R T    H E A D E R S  &  D E T A I L S  *
      *****************************************************


       01  PAGE-HDR-1.
           05  FILLER            PIC X(6)  VALUE " PAGE ".
           05  PAGE-NO-OUT       PIC ZZZ9  VALUE ZEROS.
           05  FILLER            PIC X(15) VALUE SPACES.
           05  RPT-HEADER        PIC X(44) VALUE SPACES.
           05  FILLER            PIC X     VALUE SPACES.
           05  PRT-CO            PIC X(3)  VALUE SPACES.
           05  FILLER            PIC X(10) VALUE SPACES.
           05  PRT-DATE          PIC X(8)  VALUE SPACES.
           05  FILLER            PIC X(5)  VALUE SPACES.
           05  PRT-TIME          PIC X(8)  VALUE SPACES.
           05  FILLER            PIC X(15) VALUE SPACES.
           05  FILLER            PIC X(8)  VALUE "TTAXFILE".
           05  FILLER            PIC X(2)  VALUE SPACES.


       01  PAGE-HDR-2.
