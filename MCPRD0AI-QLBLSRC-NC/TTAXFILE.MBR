      *67-PCF-X.
      *    EXIT.

       67-PRINT-ITEM-INFO.
      **** IF INV-PAY-REPORT-TYPE
               MOVE 2                 TO  INV-PAY-CTL.
               MOVE INV-DETAIL-12     TO  INV-PAY-REPORT-LINE.
               PERFORM 5-WRITE-INVPAY-REPORT-LINE.

           MOVE REGISTER-ARG TO REGISTERNO OF DINVITMH-I-REC.
           START DINVITMH-I KEY = REGISTERNO OF DINVITMH-I-REC
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
                   NEXT SENTENCE
               ELSE
               MOVE "FIND DINVITM-67-PII"  TO  BU-DISPLAY-MSG
               GO TO 2-BLOWUP.

           IF FILE-STATUS-1 = "2"
      *******  IF INV-PAY-REPORT-TYPE
                   MOVE 2            TO  INV-PAY-CTL
                   MOVE NO-ITEMS-MSG TO  INV-PAY-REPORT-LINE
                   PERFORM 5-WRITE-INVPAY-REPORT-LINE
                   GO TO 67-PII-X.

           MOVE REGISTER-ARG TO REGISTERNO OF DINVACCTH-I-REC.
           START DINVACCTH-I KEY = REGISTERNO OF DINVACCTH-I-REC
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
                   MOVE "9999" TO INVACCTH-ITEM
               ELSE
               MOVE "FIND DINVACCT-67-PII"  TO  BU-DISPLAY-MSG
               GO TO 2-BLOWUP.

           PERFORM 671-GET-DINVACCTH THRU  671-GD-X.

       67-GET-DINVITMH-LOOP.
           READ DINVITMH-I NEXT INTO BUF-DINVITM-H
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   GO TO 67-PII-X
               ELSE
                   MOVE "GET DINVRCD 67-GDL" TO BU-DISPLAY-MSG
                   GO TO 2-BLOWUP.
           IF REGISTERNO OF DINVITMH-I-REC NOT = REGISTER-ARG
                    OR FILE-STATUS = "23"
               GO TO 67-PII-X.

           IF INVITMH-PO-NUM = INVH-PO-RLSE
               NEXT SENTENCE
           ELSE
               GO TO 67-GET-DINVITMH-LOOP.

           MOVE INVITMH-ITEM-NO        TO  ITEM-OUT.
           MOVE INVITMH-CORPCODE       TO  CORP-CODE-OUT.
           MOVE INVITMH-PO-QTY-PD      TO  PO-QTY-PAID-OUT.
           MOVE INVITMH-PO-UPRICE      TO  PO-PRICE-OUT.
           MOVE INVITMH-PO-UM          TO  PO-UM-OUT,
                                          INV-UM-OUT.
           IF INVITMH-PO-QTY-PD = ZEROS
               MOVE INVITMH-PO-UPRICE  TO  PO-ITEM-EXT-OUT
           ELSE
               MULTIPLY INVITMH-PO-QTY-PD  BY  INVITMH-PO-UPRICE
                   GIVING CALC-PO-EXT  ROUNDED
               MOVE CALC-PO-EXT        TO  PO-ITEM-EXT-OUT.
           MOVE INVITMH-INV-QTY-PD     TO  INV-QTY-PAID-OUT
                                           TAX-QTY-PD.
           MOVE INVITMH-INV-UPRICE     TO  INV-PRICE-OUT.
           IF INVITMH-INV-QTY-PD = ZEROS
               MOVE INVITMH-INV-UPRICE TO  INV-ITEM-EXT-OUT
                                           TAX-ITEM-AMT
           ELSE
               MULTIPLY INVITMH-INV-QTY-PD  BY  INVITMH-INV-UPRICE
                   GIVING CALC-INV-EXT  ROUNDED
               MOVE CALC-INV-EXT       TO  INV-ITEM-EXT-OUT
                                           TAX-ITEM-AMT.
           MOVE INVITMH-TAX-CODE       TO  ITM-TAX-CODE-OUT.
           IF INVITMH-MEMO-INDIC = "X"
               MOVE "MEMO QTY."        TO  MEMO-IND-OUT
           ELSE
               MOVE SPACES             TO  MEMO-IND-OUT.
           MOVE SPACES                 TO  ACCT-DATA1-OUT,
                                           ACCT-DATA2-OUT.
           IF INVACCTH-ITEM = INVITMH-ITEM-NO
               MOVE INVACCTH-PRIME     TO  PRIME1-OUT
                                           TAX-PRIME
               MOVE INVACCTH-SUB       TO  SUB1-OUT
                                           TAX-SUB
               MOVE INVACCTH-SUBD      TO  SUBD1-OUT
                                           TAX-SUBD
               MOVE INVACCTH-ADDL-DATA TO  ADDL1-OUT
                                           TAX-ADDL-DATA
               PERFORM 671-GET-DINVACCTH THRU  671-GD-X
               IF INVACCTH-ITEM = INVITMH-ITEM-NO
                   MOVE INVACCTH-PRIME     TO  PRIME2-OUT
                   MOVE INVACCTH-SUB       TO  SUB2-OUT
                   MOVE INVACCTH-SUBD      TO  SUBD2-OUT
                   MOVE INVACCTH-ADDL-DATA TO  ADDL2-OUT.

      **** IF INV-PAY-REPORT-TYPE
               MOVE 1                 TO  INV-PAY-CTL.
               MOVE INV-DETAIL-13     TO  INV-PAY-REPORT-LINE.
               PERFORM 5-WRITE-INVPAY-REPORT-LINE.
               MOVE 1                 TO  INV-PAY-CTL.
               MOVE INV-DETAIL-14     TO  INV-PAY-REPORT-LINE.
               PERFORM 5-WRITE-INVPAY-REPORT-LINE.

       67-CHECK-FOR-MORE-ACCTG.
           IF INVACCTH-ITEM = INVITMH-ITEM-NO
               PERFORM 671-GET-DINVACCTH THRU  671-GD-X
               IF INVACCTH-ITEM  =  INVITMH-ITEM-NO
                   MOVE INVACCTH-PRIME     TO  PRIME3-OUT
                   MOVE INVACCTH-SUB       TO  SUB3-OUT
                   MOVE INVACCTH-SUBD      TO  SUBD3-OUT
                   MOVE INVACCTH-ADDL-DATA TO  ADDL3-OUT
      ************ IF INV-PAY-REPORT-TYPE
                       MOVE 1             TO  INV-PAY-CTL
                       MOVE INV-DETAIL-15 TO  INV-PAY-REPORT-LINE
                       PERFORM 5-WRITE-INVPAY-REPORT-LINE
                       GO TO 67-CHECK-FOR-MORE-ACCTG.

      **** IF INV-PAY-REPORT-TYPE
               MOVE 1                 TO  INV-PAY-CTL.
               MOVE SPACES            TO  INV-PAY-REPORT-LINE.
               PERFORM 5-WRITE-INVPAY-REPORT-LINE.
               PERFORM 671-GET-KWM.
               PERFORM 5-WRITE-TAXFILE-RCD.

           GO TO 67-GET-DINVITMH-LOOP.

       67-PII-X.
           EXIT.

       671-GET-DINVACCTH.
           READ DINVACCTH-I NEXT INTO BUF-DINVACCT-H
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
      *********IF FILE-STATUS = "10" OR "14" OR "46"
                   MOVE "9999" TO INVACCTH-ITEM
                   GO TO 671-GD-X.
      *********ELSE
      *********    MOVE "GET DINVACCTH 671-GD" TO BU-DISPLAY-MSG
      *********    GO TO 2-BLOWUP.
           IF REGISTERNO OF DINVACCTH-I-REC NOT = REGISTER-ARG
               MOVE "9999" TO INVACCTH-ITEM.

           IF REGISTERNO OF DINVACCTH-I-REC = REGISTER-ARG
               IF INVACCTH-PO-NUM NOT = INVH-PO-RLSE
                   GO TO 671-GET-DINVACCTH.

       671-GD-X.
           EXIT.

       671-GET-KWM.
           MOVE 2                     TO  CDESC-LINES-TO-GET.
           MOVE "D"                   TO  CDESC-DESC-OPTION.
           MOVE "N"                   TO  CDESC-LOCAL-DESC-OPTION.
           CALL "CDESC" USING CDESC-RET-CODE, BASE, STATUS-AREA,
             BU-DISPLAY-MSG, INVITMH-CORPCODE, CDESC-DATA.
           IF BU-DISPLAY-MSG-1 NOT = SPACES
               MOVE "*NOT ON FILE*"   TO  TAX-DESC
           ELSE
               MOVE CDESC (1)         TO  TAX-DESC.
           MOVE INVITMH-CORPCODE      TO  TAX-CORP-CODE.

       671-ADD-ACCRUED-TAX.
           ADD INVH-ATAX-AMT (SUB)  TO  TOTAL-ACCRUED-TAX.

       9999-START-DINVRCD-I.
           MOVE LOW-VALUES TO REGISTERNO OF DINVRCD-REC-I.
           START DINVRCD-I KEY > REGISTERNO OF DINVRCD-REC-I
              INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.

       9999-READ-NEXT-DINVRCD-I.
           READ DINVRCD-I NEXT INTO BUF-DINVRCD
              AT END MOVE "Y" TO EOF-DINVRCD.

       9999-START-DINVRCDH-I.
           MOVE FROM-DATE-9 TO INVDTE OF DINVRCDH-REC-I.
           START DINVRCDH-I KEY >= INVDTE OF DINVRCDH-REC-I
              INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.

       9999-READ-NEXT-DINVRCDH-I.
           READ DINVRCDH-I NEXT INTO BUF-DINVRCD-H
              AT END MOVE "Y" TO EOF-DINVRCDH.

