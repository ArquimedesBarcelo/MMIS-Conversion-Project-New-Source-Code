       IDENTIFICATION DIVISION.
       PROGRAM-ID.  TBLKRESQ.
       DATE-COMPILED.
      ************************************************************
      ** THIS PROGRAM ALLOWS ANY USER REQUESTED BLANKET         **
      ** ORDER TO BE RE-SEQUENCED (I.E. THE DPOITEM SEGMENTS    **
      ** ARE RENUMBERED SEQUENTIALLY WITH NO BREAKS). IN        **
      ** ADDITION, THE USER HAS THE OPTIN OF WHETHER THEY WOULD **
      ** LIKE THE ITEMS ON THE REQUIREMENT ORDER TO BE SORTED   **
      ** BY CORP CODE OR NOT.                                   **
      ************************************************************
      *   04/07/99     CA YODER
      *      ADDED MORE INFORMATION TO THE BLOWUP MESSAGE.
      *      PREVIOUSLY, IT DID NOT CONTAIN THE PROGRAM NAME
      *      OR THE PURCHASE ORDER NUMBER.

       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.
       COPY SPECIALN OF COPYLIB.
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT DISPLAY-FILE
               ASSIGN TO WORKSTATION-ZBLKRESQ-SI
               ORGANIZATION IS TRANSACTION
               ACCESS IS SEQUENTIAL
               FILE STATUS IS DSPLY-STATUS
               CONTROL-AREA IS WS-CONTROL.

           SELECT DPOITEM-PO-O
               ASSIGN TO DATABASE-MCFLCS1002
               ORGANIZATION IS INDEXED
                 ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                 WITH DUPLICATES
               FILE STATUS IS FILE-STATUS.

      *    SELECT PRINT-FILE ASSIGN TO PRINTER-MCPRT.

           SELECT SORT-FILE
               ASSIGN TO DISK-SORTFILE.

       DATA DIVISION.
       FILE SECTION.
       FD  DISPLAY-FILE
           LABEL RECORDS ARE OMITTED.
       01  DSPLY-REC                     PIC X(2000).

       FD  DPOITEM-PO-O
           LABEL RECORDS ARE STANDARD.
       01  DPOITEM-PO-REC-O.
           COPY DDS-MCRPCS1000  OF MCFLCS1002.

      *FD  PRINT-FILE
      *    LABEL RECORDS ARE OMITTED
      *    RECORD CONTAINS 132 CHARACTERS
      *    DATA RECORD IS PRINT-REC.
      *01  PRINT-REC                     PIC X(132).

       SD  SORT-FILE
           RECORD CONTAINS 262 CHARACTERS
           DATA RECORD IS SORT-REC.
       01  SORT-REC.
           05  SORT-CODE                 PIC X(8).
           05  FILLER                    PIC X(254).

       WORKING-STORAGE SECTION.
       77  ITM-CTR                       PIC 9(4).
       77  LINE-CTR                      PIC 99.
       77  RET-RECS-CTR                  PIC 9(5).
       77  TOT-RECS-CTR                  PIC 9(5).

       01  COMP-LIT.
           05  FILLER                    PIC X(14)
               VALUE "BLANKET ORDER ".
           05  COMP-PO                   PIC X(7)  VALUE SPACES.
           05  FILLER                    PIC X(58)
               VALUE " HAS BEEN RE-SEQUENCED".

       01  DSPLY-STATUS                  PIC XX.

       01  PO-NUMBER.
           05  PO-NUMBER-LIT             PIC X     VALUE "P".
           05  PO-NUMBER-IN              PIC X(7).
           05  PO-BLANKET                PIC XXX   VALUE "999".
           05  PO-RCVR-LIT               PIC XXX   VALUE "000".

       01  SCREEN-INPUT.
           05  SCREEN-PO                 PIC X(7).
           05  SCREEN-SORT-IND           PIC X.
           05  SCREEN-CMD-LINE           PIC X(79).
           05  SCREEN-ERR-LINE           PIC X(79).

       01  TRUE-VAL                      PIC 1 VALUE B"1".

      *****************************************************************
      **                                                             **
      **  S U B P R O G R A M   A R E A                              **
      **                                                             **
      *****************************************************************
       COPY CPYIND     IN COPYLIB.
       COPY IOFEEDBACK IN COPYLIB.
       COPY TBLOWUP    IN COPYLIB.
       COPY TDATECHK   IN COPYLIB.
       COPY VCOMLINK   IN COPYLIB.
       COPY WSCONTROL  IN COPYLIB.

      *****************************************************************
      **                                                             **
      **  D A T A B A S E   W O R K                                  **
      **                                                             **
      *****************************************************************
       01  BASE                          PIC X(10)  VALUE "  STORES;".
       COPY FILESTAT IN COPYLIB.
       COPY DBSTAT   IN COPYLIB.
       COPY OVRPFDATA  IN COPYLIB.
       01  PO-ARG                        PIC X(14).
       COPY DBPOARG1 IN COPYLIB.

      *****************************************************************
      **                                                             **
      **  D A T A B A S E   B U F F E R S                            **
      **                                                             **
      *****************************************************************
       COPY DPOITEM  IN COPYLIB.

       PROCEDURE DIVISION.
       START-PGM SECTION.
       START-IT.
           OPEN I-O    DISPLAY-FILE.
           OPEN I-O    DPOITEM-PO-O.
      *    MOVE "MCPRT" TO OVRPRTF-FILE.
      *    PERFORM 996-OVERRIDE-PRINT-FILE.
      *    OPEN OUTPUT PRINT-FILE.
      *    MOVE 61 TO LINE-CTR.
           MOVE 0 TO RET-RECS-CTR, TOT-RECS-CTR.
           MOVE 0 TO ITM-CTR.
           MOVE "FBLKRESQ" TO VIEW-CFNAME.
           MOVE SPACES TO SCREEN-INPUT.
           MOVE SCREEN-INPUT TO DSPLY-REC.
           PERFORM 99-SCREEN-WRITE.
           PERFORM 98-SCREEN-READ.
           IF VIEW-LASTKEY = 3
               NEXT SENTENCE
           ELSE
           MOVE DSPLY-REC TO SCREEN-INPUT
           IF SCREEN-PO = "       "
               NEXT SENTENCE
           ELSE
           MOVE SCREEN-PO TO PO-NUMBER-IN
           IF SCREEN-SORT-IND = "X"
               SORT SORT-FILE ON ASCENDING KEY SORT-CODE
                   INPUT  PROCEDURE 7-SORT-RECORDS
                   OUTPUT PROCEDURE 8-WRITE-ITEMS
               IF ITM-CTR = 0
                   NEXT SENTENCE
               ELSE
               MOVE SCREEN-PO TO COMP-PO
               MOVE TRUE-VAL  TO INDS (98)
               MOVE COMP-LIT  TO SCREEN-CMD-LINE
               MOVE SCREEN-INPUT TO DSPLY-REC
               PERFORM 99-SCREEN-WRITE
               PERFORM 98A-SCREEN-READ
               CALL "CLPAUSE2"
           ELSE
           PERFORM 6000-MAIN THRU 6990-MAIN-X
           MOVE SCREEN-PO TO COMP-PO
           MOVE TRUE-VAL  TO INDS (98)
           MOVE COMP-LIT  TO SCREEN-CMD-LINE
           MOVE SCREEN-INPUT TO DSPLY-REC
           PERFORM 99-SCREEN-WRITE
           PERFORM 98A-SCREEN-READ
           CALL "CLPAUSE2".
       2-EOJ.
           CLOSE DISPLAY-FILE.
           CLOSE DPOITEM-PO-O.
      *    CLOSE PRINT-FILE.
           GOBACK.

       2100-BLOWUP.
           MOVE "TBLKRESQ"  TO  BU-PGM-NAME.
           MOVE PO-NUMBER   TO  BU-DISPLAY-FLD (2).
           CALL "TBLOWUP" USING BASE, BU-PGM-NAME, STATUS-AREA,
             VIEW-COMAREA, FILE-STATUS, BU-DISPLAY-MSG,
             BU-DISPLAY-FLDS.

       98-SCREEN-READ.
           READ DISPLAY-FILE FORMAT IS VIEW-CFNAME
               INDIC IS INDICS.
           ACCEPT IOFEEDBACK FROM I-O-FEEDBACK-AREA.
           MOVE ALL B"0" TO INDICS.
           IF DSPLY-STATUS NOT = "00"
               MOVE 3 TO VIEW-LASTKEY
           ELSE
           MOVE FUNCTION-NUM TO VIEW-LASTKEY.

       98A-SCREEN-READ.
           READ DISPLAY-FILE TERMINAL IS TERMINAL-ID
               INDIC IS INDICS
                  NO DATA MOVE DSPLY-STATUS TO DSPLY-STATUS.
           MOVE ALL B"0" TO INDICS.

       99-SCREEN-WRITE.
           WRITE DSPLY-REC FORMAT IS VIEW-CFNAME
               INDIC IS INDICS.
           MOVE ALL B"0" TO INDICS.

       COPY OVRPFCALL IN COPYLIB.

       6000-MAIN SECTION.
       6000-M.
           MOVE PO-NUMBER TO PORCVNO OF DPOITEM-PO-REC-O.
           START DPOITEM-PO-O KEY = PORCVNO OF DPOITEM-PO-REC-O
               INVALID KEY    MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "23"
                   GO TO 2-EOJ
               ELSE
               MOVE "START ERROR IN DPOITEM" TO BU-DISPLAY-MSG
               MOVE FILE-STATUS              TO BU-DISPLAY-FLD9 (1)
               GO TO 2100-BLOWUP.
       6000-READ-LOOP.
           READ DPOITEM-PO-O NEXT INTO BUF-DPOITEM
               AT END    MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE "READ ERROR IN DPOITEM" TO BU-DISPLAY-MSG
               MOVE FILE-STATUS             TO BU-DISPLAY-FLD9 (1)
               GO TO 2100-BLOWUP.
           ADD 1 TO TOT-RECS-CTR.
           IF ITM-PO-RCV-NO = PO-NUMBER
               NEXT SENTENCE
           ELSE
      *    MOVE SPACES TO PRINT-REC
      *    STRING "CHANGED RECORDS        = ", RET-RECS-CTR
      *        DELIMITED BY SIZE INTO PRINT-REC
      *    WRITE PRINT-REC AFTER ADVANCING 1
           SUBTRACT 1 FROM TOT-RECS-CTR
      *    STRING "TOTAL RECORDS READ     = ", TOT-RECS-CTR
      *        DELIMITED BY SIZE INTO PRINT-REC
      *    WRITE PRINT-REC AFTER ADVANCING 1
           GO TO 6990-MAIN-X.
           ADD 1 TO ITM-CTR.
           MOVE ITM-CTR TO ITM-NUMBER.
           ADD 1 TO RET-RECS-CTR.
           REWRITE DPOITEM-PO-REC-O FROM BUF-DPOITEM
               INVALID KEY    MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE "UPDATE ERROR IN DPOITEM" TO BU-DISPLAY-MSG
               MOVE FILE-STATUS               TO BU-DISPLAY-FLD9 (1)
               GO TO 2100-BLOWUP.
      *    ADD 1 TO LINE-CTR.
      *    IF LINE-CTR > 60
      *        PERFORM 6999-HEADER.
      *    MOVE SPACES TO PRINT-REC.
      *    STRING "ITEM NUMBER ", ITM-NUMBER, " FOR P.O. ",
      *        ITM-PO-NO-AND-REL, " HAS BEEN UPDATED "
      *        DELIMITED BY SIZE INTO PRINT-REC.
      *    WRITE PRINT-REC AFTER ADVANCING 1.
           GO TO 6000-READ-LOOP.

       6990-MAIN-X.
           EXIT.

      *6999-HEADER.
      *    MOVE SPACES TO  PRINT-REC.
      *    WRITE PRINT-REC AFTER ADVANCING NEW-PAGE.
      *    STRING "BLANKET PO ITEMS RE-SEQUENCED "
      *      DELIMITED BY SIZE INTO PRINT-REC.
      *    WRITE PRINT-REC AFTER ADVANCING 1.
      *    MOVE ALL "-" TO PRINT-REC.
      *    WRITE PRINT-REC AFTER ADVANCING 1 LINES.
      *    MOVE 4 TO LINE-CTR.

       7-SORT-RECORDS SECTION.
       7-SORT-RECS.
           MOVE PO-NUMBER TO PORCVNO OF DPOITEM-PO-REC-O.
           START DPOITEM-PO-O KEY = PORCVNO OF DPOITEM-PO-REC-O
               INVALID KEY    MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "23"
                   GO TO 7-SR-X
               ELSE
               MOVE "START ERROR IN DPOITEM" TO BU-DISPLAY-MSG
               MOVE FILE-STATUS              TO BU-DISPLAY-FLD9 (1)
               GO TO 2100-BLOWUP.
       7-SR-LOOP.
           READ DPOITEM-PO-O NEXT INTO BUF-DPOITEM
               AT END    MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE "READ ERROR IN DPOITEM" TO BU-DISPLAY-MSG
               MOVE FILE-STATUS             TO BU-DISPLAY-FLD9 (1)
               GO TO 2100-BLOWUP.
           IF ITM-PO-RCV-NO = PO-NUMBER
               NEXT SENTENCE
           ELSE
      *    MOVE SPACES TO PRINT-REC
      *    STRING "RECORDS TO REWRITE     = ", RET-RECS-CTR
      *        DELIMITED BY SIZE INTO PRINT-REC
      *    WRITE PRINT-REC AFTER ADVANCING 1
           GO TO 7-SR-X.
           ADD 1 TO RET-RECS-CTR.
           DELETE DPOITEM-PO-O
               INVALID KEY    MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE "DELETE ERROR IN DPOITEM" TO BU-DISPLAY-MSG
               MOVE FILE-STATUS               TO BU-DISPLAY-FLD9 (1)
               GO TO 2100-BLOWUP.
           MOVE BUF-DPOITEM TO SORT-REC.
           RELEASE SORT-REC.
           GO TO 7-SR-LOOP.
       7-SR-X.    EXIT.

       8-WRITE-ITEMS SECTION.
       8-WR-ITEMS.
           MOVE 0 TO ITM-CTR.
       8-WR-LOOP.
           RETURN SORT-FILE INTO BUF-DPOITEM
               AT END
      *        MOVE SPACES TO PRINT-REC
      *        STRING "TOTAL DPOITEMS WRITTEN = " ITM-CTR
      *            DELIMITED BY SIZE INTO PRINT-REC
      *        WRITE PRINT-REC AFTER ADVANCING 2
               GO TO 8-WR-X.
           ADD 1 TO ITM-CTR.
           MOVE ITM-CTR TO ITM-NUMBER.
           WRITE DPOITEM-PO-REC-O FROM BUF-DPOITEM
               INVALID KEY    MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               DISPLAY "ERROR WRITING DPOITEM SEGS "
               GO TO 2100-BLOWUP.
      *    ADD 1 TO LINE-CTR.
      *    IF LINE-CTR > 60
      *        PERFORM 89-HEADER.
      *    MOVE SPACES TO PRINT-REC.
      *    STRING "PO ", ITM-PO-NO-AND-REL, " CORP CODE "
      *        ITM-CORP-CODE, " HAS BEEN WRITTEN AS ITEM NO "
      *        ITM-NUMBER DELIMITED BY SIZE INTO PRINT-REC.
      *    WRITE PRINT-REC AFTER ADVANCING 1.
           GO TO 8-WR-LOOP.

      *89-HEADER.
      *    MOVE SPACES TO  PRINT-REC.
      *    WRITE PRINT-REC AFTER ADVANCING NEW-PAGE.
      *    STRING "BLANKET PO ITEMS RE-SEQUENCED "
      *      DELIMITED BY SIZE INTO PRINT-REC.
      *    WRITE PRINT-REC AFTER ADVANCING 1.
      *    MOVE ALL "-" TO PRINT-REC.
      *    WRITE PRINT-REC AFTER ADVANCING 1 LINES.
      *    MOVE 4 TO LINE-CTR.

       8-WR-X.    EXIT.
