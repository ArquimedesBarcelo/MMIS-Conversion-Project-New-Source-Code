086200         MOVE SPACES              TO SORT-PO-RLS
086300                                     SORT-PO-ITEM.
086400     MOVE TRANS-UNIT-MEASURE      TO SORT-UNIT-MEAS.
086500     IF TRANS-STORES-CODE = "2641544" AND
086600          TRANS-ACCT = "000042"
086700             MOVE 05              TO SORT-REPORT-CODE.
086800     MOVE MCHT-DEPT-TYPE          TO SORT-DEPT-TYPE.
086900     IF MCHT-DEPT-TYPE = "MS" OR "MU" OR "MW"
087000*        IF TRANS-CLASS > 199 AND TRANS-CLASS < 400
               IF (TRANS-CLASS > 199 AND TRANS-CLASS < 400)
087100             MOVE 01              TO SORT-REPORT-CODE
087200         ELSE
087300             NEXT SENTENCE
087400     ELSE
087500         NEXT SENTENCE.
087600     IF TRANS-CODE = "INV"
087700         MOVE "DCHG"              TO SORT-TRANS-TYPE
087800     ELSE
087900         MOVE TRANS-CODE          TO SORT-TRANS-TYPE.
088000     IF TRANS-CODE = "RET" OR "RETV" OR "SADJ" OR "AADJ"
088100         COMPUTE SORT-QTY-CHGD = TRANS-QTY * -1
088200         COMPUTE SORT-VALUE = TRANS-VALUE * -1
088300     ELSE
088400         MOVE TRANS-QTY           TO SORT-QTY-CHGD
088500         MOVE TRANS-VALUE         TO SORT-VALUE.
088600     IF MCHT-DEPT-TYPE = "PR"
088700*        IF (TRANS-CLASS < 200) OR (TRANS-CLASS > 399
088800*          AND TRANS-CLASS < 500)
               IF (TRANS-CLASS > 099 AND TRANS-CLASS < 200) OR
                  (TRANS-CLASS > 399 AND TRANS-CLASS < 500)
088900               IF TRANS-STORES-CODE = "NON-STR"
089000                   MOVE SORT-VALUE TO SORT-STD-VALUE
089100               ELSE
089200                   IF STR-STD-COST = 0
089300                       MOVE 0      TO SORT-STD-VALUE
089400                   ELSE
089500                       MOVE SORT-VALUE TO SORT-STD-VALUE
089600                       COMPUTE SORT-VALUE =
089700                           SORT-QTY-CHGD * STR-AVG-COST
089800         ELSE
089900             MOVE 0                TO SORT-STD-VALUE
090000     ELSE
090100         MOVE 0                    TO SORT-STD-VALUE.
090200     IF TRANS-VALUE = 0
090300         MOVE 0                    TO SORT-STD-VALUE.
090400     IF SORT-REPORT-CODE = 02
090500         IF STR-STD-COST = 0
090600             IF SORT-LEDG < 07
090700                 MOVE 0            TO SORT-STD-VALUE
090800             ELSE
090900                 MOVE SORT-VALUE   TO SORT-STD-VALUE.
091000
091100     RELEASE SORT-REC.
091200     MOVE SPACES                   TO SORT-REC.
091300     MOVE 0                        TO SORT-QTY-CHGD
091400                                      SORT-VALUE
091500                                      SORT-STD-VALUE.
