068400     IF MMATL-CODE-ARG = "NON-STR"
068500         PERFORM 505-SET-REPORT-CODE
068600     ELSE
               PERFORM 9999-DBGET7-MMATL-ACCUM-MC-I
069400         IF GOOD-CALL
069500             IF TRANS-ACCT > "009999"
069600                 IF TRANS-CODE = "INV"
