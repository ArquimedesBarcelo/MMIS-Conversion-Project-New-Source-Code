           PERFORM 9999-DBGET5-DPODATAITM-PO-I.
081500     IF GOOD-CALL
081600         IF TRANS-ITEM-NUM = DATAITM-ITEM-NO
081700             IF DATAITM-LINE-NO = "01"
081800                 MOVE DATAITM-INFO TO SORT-DESCR
081900                 MOVE 1 TO ITEM-FOUND
082000             ELSE
082100                 NEXT SENTENCE
082200         ELSE
082300             NEXT SENTENCE
082400     ELSE
082500         IF END-OF-CHAIN
082600             MOVE SPACES TO SORT-DESCR
082700         ELSE
082800             MOVE "DBGET PODATAITM * 540-CD" TO BU-DISPLAY-MSG
082900             PERFORM 990-BLOWUP.
083000
083100 550-GET-MSTORERM.
083200     IF MMATL-CODE-ARG = "NON-STR" OR MMATL-FST4 = "ACCR"
083300*********NEXT SENTENCE  *REPLACED 11SEP1995
               MOVE +0 TO STR-STD-COST
083400     ELSE
               PERFORM 9999-DBGET7-MSTORERM-CD-I
084200         IF GOOD-CALL
084300             NEXT SENTENCE
084400         ELSE
084500             IF NO-ENTRY
084600                  MOVE 0 TO STR-STD-COST
084700             ELSE
