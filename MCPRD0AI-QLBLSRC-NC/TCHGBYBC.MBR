070700**********************************************************
070800**  THIS SECTION SETS THE REPORT CODE FOR DIRECT        **
070900**  DELIVERIES THAT ARE NOT CODED.  ALL CODED ITEMS     **
071000**  HAVE A REPORT CODE ATTACHED.                        **
071100**********************************************************
071200
071300 505-SET-REPORT-CODE.
071400*    IF TRANS-CLASS < 200
071500*        MOVE 02 TO SORT-REPORT-CODE
071600*    ELSE
071700*        IF TRANS-CLASS < 344
071800*            MOVE 05 TO SORT-REPORT-CODE
071900*        ELSE
072000*            IF TRANS-CLASS < 400
072100*                MOVE 01 TO SORT-REPORT-CODE
072200*            ELSE
072300*                IF TRANS-CLASS < 500
072400*                    MOVE 02 TO SORT-REPORT-CODE
072500*                ELSE
072600*                    MOVE 01 TO SORT-REPORT-CODE.
      ******************************************************
      *    THE ABOVE LOGIC WAS CHANGED 7/30/97 DUE TO      *
      *    VALLEYFIELD USING CLASS 080 FOR MAJOR SPARE     *
      *    PARTS.....JIM C.                                *
      ******************************************************
068100     IF (TRANS-CLASS > 099 AND TRANS-CLASS < 200) OR
068200        (TRANS-CLASS > 399 AND TRANS-CLASS < 500)
068300         MOVE "02"                TO SORT-REPORT-CODE
068400     ELSE
068500     IF (TRANS-CLASS > 199 AND TRANS-CLASS < 344)
068600         MOVE "05"                TO SORT-REPORT-CODE
068700     ELSE
068800     IF (TRANS-CLASS > 343 AND TRANS-CLASS < 400)  OR
068900        (TRANS-CLASS > 499) OR (TRANS-CLASS < 100)
069000         MOVE "01"                TO SORT-REPORT-CODE.
072700     IF TRANS-ACCT = "000000" OR TRANS-ACCT = SPACES
072800         NEXT SENTENCE
072900     ELSE
073000*        IF TRANS-CLASS < 200 OR TRANS-CLASS > 399
               IF (TRANS-CLASS > 099 AND TRANS-CLASS < 200) OR
                  (TRANS-CLASS > 399)
073100             NEXT SENTENCE
073200         ELSE
073300             IF TRANS-ACCT > "009999"
073400                 MOVE 06 TO SORT-REPORT-CODE
073500             ELSE
073600                 IF TRANS-ACCT = "000951"
073700                     MOVE 02 TO SORT-REPORT-CODE
073800                 ELSE
073900                     IF TRANS-ACCT < "000100"
074000                         OR TRANS-ACCT = "000251" OR
074100                            "000252" OR "000253" OR "000250"
                                  OR "000254"
074200                               OR "000891" OR "000892"
074300                             MOVE 05 TO SORT-REPORT-CODE
074400                     ELSE
074500                         MOVE 01 TO SORT-REPORT-CODE.
074600
074700
074800 510-GET-LEDGER.
074900     MOVE TRANS-DEPT TO DEPT-KEY.
           PERFORM 9999-DBGET7-MCHT-ACCTS-DP-I.
075700     IF GOOD-CALL
075800         NEXT SENTENCE
075900     ELSE
