000300 IDENTIFICATION DIVISION.
000400 PROGRAM-ID. TMODCODE.
000800*REMARKS.
000900*        ######################################
001000*        # Modifies absence code descriptions #
001100*        ######################################.
001500 ENVIRONMENT DIVISION.
001600 CONFIGURATION SECTION.
001700 SOURCE-COMPUTER. AS400.
001800 OBJECT-COMPUTER. AS400.
       SPECIAL-NAMES.      I-O-FEEDBACK IS I-O-FEEDBACK-AREA
                           LOCAL-DATA IS LOCAL-DATA-AREA.
001000 INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT DISPLAY-FILE
               ASSIGN TO WORKSTATION-ZPERSON-SI
               ORGANIZATION IS TRANSACTION
               ACCESS IS SEQUENTIAL
               FILE STATUS IS DSPLY-STATUS
               CONTROL-AREA IS WS-CONTROL.
           SELECT PER-ABSENCE-MSTR
               ASSIGN TO DATABASE-MCFLMM2901
               ORGANIZATION IS INDEXED
               ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
               FILE STATUS IS PAM-STATUS.
002200 DATA DIVISION.
       FILE SECTION.
       FD  DISPLAY-FILE
           LABEL RECORDS ARE OMITTED.
       01  DSPLY-REC                   PIC X(2000).
       FD  PER-ABSENCE-MSTR
           LABEL RECORDS ARE STANDARD
           DATA RECORD IS PAMREC.
       01  PAMREC.
           COPY DDS-ALL-FORMATS OF MCFLMM2901.
002300 WORKING-STORAGE SECTION.
       COPY CATREAD OF COPYLIB.
002500 01  CODE-BUFFER.
002600     05  CODE-B                    PIC XX.
002700     05  DESC-B                    PIC X(30).
           05  CODE-CMD-LINE             PIC X(79).
           05  CODE-ERR-LINE             PIC X(79).
       COPY CPYIND  OF COPYLIB.
       01  DSPLY-STATUS                  PIC XX.
002900 01  GO-BACK                       PIC X VALUE "N".
003000     88 TIME-TO-GO-BACK                  VALUE "Y".
004100 01  ERROR-BUFFER.
           05  FILLER                    PIC X(14).
           05  ERR-CODE                  PIC XX.
           05  FILLER                    PIC X(64).
       COPY IOFEEDBACK OF COPYLIB.
       01  PAM-STATUS                    PIC XX.
004200 01  PASSWORD-INFORMATION.
004300     05  NAME-OF-PROGRAM     PIC X(08) VALUE "TMODCODE".
004400     05  PROGRAM-TYPE        PIC X(02) VALUE "MA".
004500     05  PROGRAM-RELEASE     PIC X(12) VALUE " E0100010001".
004600     05  PROGRAM-DESCRIPTION.
004700         10  PROG-DESC-A     PIC X(60) VALUE
004800            "MODIFIES PERSONNEL ABSENCE CODE DESCRIPTIONS "      .
004900         10  PROG-DESC-B     PIC X(60) VALUE SPACES.
005100         10  PROG-FUNCTION   PIC X(60) VALUE SPACES.
005300     05  PASSWORD-FLAG       PIC X.
005400 COPY DBSTAT    OF COPYLIB.
       01  TRUE-VAL                      PIC 1 VALUE B"1".
       COPY WSCONTROL OF COPYLIB.
005700 LINKAGE SECTION.
005800 01  DBPARAMETERS.                 COPY DBPARMS  OF COPYLIB.
005900 COPY VCOMLINK  OF COPYLIB.
006000 01  PLT-IDT                       PIC X(4).
006500 PROCEDURE DIVISION USING DBPARAMETERS
006600                          VIEW-COMAREA
006700                          PLT-IDT.
007100 START-PGM.
           PERFORM 1-HSK.
008000     PERFORM 6-MAIN THRU 6-MAIN-EXIT UNTIL VIEW-LASTKEY = 3.
       2-EOJ.
           CLOSE DISPLAY-FILE.
           CLOSE PER-ABSENCE-MSTR.
           GOBACK.
       1-HSK.
           OPEN I-O   DISPLAY-FILE.
           OPEN I-O   PER-ABSENCE-MSTR.
007200     CALL "TPWORD" USING PASSWORD-INFORMATION.
007600     IF PASSWORD-FLAG = "N" GO TO 2-EOJ.
014700     MOVE SPACES TO CODE-BUFFER ERROR-BUFFER.
010300 6-MAIN.
011300     MOVE "FMODCODE" TO VIEW-CFNAME.
           MOVE CODE-BUFFER TO DSPLY-REC.
           PERFORM 99-SCREEN-WRITE.
012700     PERFORM 98-SCREEN-READ.
014200     IF VIEW-LASTKEY = 3 GO TO 2-EOJ.
013700     IF VIEW-LASTKEY = 0
013800         NEXT SENTENCE
013900     ELSE
014100     GO TO 6-MAIN.
           MOVE DSPLY-REC TO CODE-BUFFER.
015300     IF CODE-B = SPACES GO TO 6-MAIN-EXIT.
           PERFORM 69-START-PER-ABSENCE-MSTR.
           IF COND-WORD = 17
017100         MOVE 27009 TO CATREAD-MSG-NUMBER
017300         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE TRUE-VAL TO INDS (1) INDS (99)
018000         GO TO 6-MAIN.
015900     PERFORM 69-READ-PER-ABSENCE-MSTR.
016600     IF COND-WORD = 15
017100         MOVE 27009 TO CATREAD-MSG-NUMBER
017300         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE TRUE-VAL TO INDS (1) INDS (99)
018000         GO TO 6-MAIN.
018300     MOVE "FMODCODA" TO VIEW-CFNAME.
           MOVE CODE-BUFFER TO DSPLY-REC.
           PERFORM 99-SCREEN-WRITE.
010700     PERFORM 64-MOD  THRU 64-MOD-EXIT.
010800 6-MAIN-EXIT.    EXIT.
010900
019700 64-MOD.
019800     PERFORM 98-SCREEN-READ.
021300     IF VIEW-LASTKEY = 3 GO TO 2-EOJ.
020800     IF VIEW-LASTKEY = 0
020900         NEXT SENTENCE
021000     ELSE
021200     GO TO 64-MOD.
021400     MOVE DSPLY-REC TO CODE-BUFFER.
022000     PERFORM 69-REWRITE-PER-ABSENCE-MSTR.
022300     IF COND-WORD NOT = 0 GO TO 2-EOJ.
           MOVE 66195 TO CATREAD-MSG-NUMBER.
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
           MOVE CODE-B TO ERR-CODE.
           MOVE ERROR-BUFFER TO CODE-CMD-LINE.
           MOVE CODE-BUFFER TO DSPLY-REC.
           MOVE TRUE-VAL TO INDS (98).
           PERFORM 99-SCREEN-WRITE.
           PERFORM 98A-SCREEN-READ.
           CALL "CLPAUSE2".
           MOVE SPACES TO ERROR-BUFFER CODE-BUFFER.
022700 64-MOD-EXIT.    EXIT.

       69-READ-PER-ABSENCE-MSTR.
           MOVE 0 TO COND-WORD.
           READ PER-ABSENCE-MSTR NEXT INTO CODE-BUFFER
               AT END    MOVE 15 TO COND-WORD.
           IF PAM-STATUS NOT = "00" MOVE 15 TO COND-WORD.

       69-REWRITE-PER-ABSENCE-MSTR.
           MOVE 0 TO COND-WORD.
           REWRITE PAMREC FROM CODE-BUFFER
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF PAM-STATUS NOT = "00" MOVE 17 TO COND-WORD.

       69-START-PER-ABSENCE-MSTR.
           MOVE 0 TO COND-WORD.
           MOVE CODE-B TO PERABSCODE OF PAMREC.
           START PER-ABSENCE-MSTR KEY IS = EXTERNALLY-DESCRIBED-KEY
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF PAM-STATUS NOT = "00" MOVE 17 TO COND-WORD.

       98-SCREEN-READ.
           READ DISPLAY-FILE FORMAT IS VIEW-CFNAME
               INDIC IS INDICS.
           ACCEPT IOFEEDBACK FROM I-O-FEEDBACK-AREA.
           MOVE ALL B"0" TO INDICS.
           IF DSPLY-STATUS NOT = "00"
               MOVE 3 TO VIEW-LASTKEY
           ELSE
           MOVE FUNCTION-NUM TO VIEW-LASTKEY.

       98A-SCREEN-READ.
           READ DISPLAY-FILE TERMINAL IS TERMINAL-ID
               INDIC IS INDICS
                  NO DATA MOVE DSPLY-STATUS TO DSPLY-STATUS.
           MOVE ALL B"0" TO INDICS.

       99-SCREEN-WRITE.
           WRITE DSPLY-REC FORMAT IS VIEW-CFNAME
               INDIC IS INDICS.
           MOVE ALL B"0" TO INDICS.

051100 999-CATREAD.
024000     MOVE SPACES TO ERROR-BUFFER.
024100     CALL "CCATREAD" USING CATREAD-PARMS.
024200     MOVE CATREAD-MSG-TEXT TO ERROR-BUFFER.
052100 999-CATREAD-EXIT.
052200     EXIT.
