000200 IDENTIFICATION DIVISION.
000300 PROGRAM-ID.    CEARQPH2.
000400 AUTHOR.        C HILLES/JIM COFFMAN (MAINTAINER).
000500 DATE-WRITTEN.  8/21/87.
000600 DATE-COMPILED.
000700*INSTALLATION.  GOODYEAR TIRE AND RUBBER - AKRON.
000800*SECURITY.
000900*REMARKS.
001000*D   ELECTRONIC REQUISITION APPROVALS - PATH DETERMINATION SUB-
001100*D   PROGRAM.  THIS SUBPROGRAM WILL RETURN THE PATH NUMBER THAT
001200*D   A SPECIFIC ITEM MATCHES, BASED ON THE CLASS, DEPARTEMENT,
001300*D   EXPENSE CLASS, AND BUDGET NUMBER OF THE ITEM.
001400*D   SPECIAL VERSION WHICH LOADS AND SAVES A TABLE.  THIS TABLE
001500*D   HANDLES A MAX OF 30 DEFINITIONS.
001600
001700 ENVIRONMENT DIVISION.
001800 CONFIGURATION SECTION.
001900 SOURCE-COMPUTER.  HP-3000.
002000 OBJECT-COMPUTER.  HP-3000.
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT MVALIDPLTDATA-I
                  ASSIGN TO DATABASE-MCFLCS1701
                  ORGANIZATION IS INDEXED
                    ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                  FILE STATUS IS FILE-STATUS.

           SELECT DPATHDEF-I
                  ASSIGN TO DATABASE-MCFLCS4001
                  ORGANIZATION IS INDEXED
                    ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                    WITH DUPLICATES
                  FILE STATUS IS FILE-STATUS.

           SELECT MPATH-I
                  ASSIGN TO DATABASE-MCFLCS3901
                  ORGANIZATION IS INDEXED
                    ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                  FILE STATUS IS FILE-STATUS.

002100
002200 DATA DIVISION.
       FILE SECTION.
       FD  MVALIDPLTDATA-I
           LABEL RECORDS ARE STANDARD.
       01  MVALIDPLTDATA-REC-I.
           COPY DDS-MCRPCS1700  OF MCFLCS1701.

       FD  DPATHDEF-I
           LABEL RECORDS ARE STANDARD.
       01  DPATHDEF-REC-I.
           COPY DDS-MCRPCS4000  OF MCFLCS4001.

       FD  MPATH-I
           LABEL RECORDS ARE STANDARD.
       01  MPATH-REC-I.
           COPY DDS-MCRPCS3900  OF MCFLCS3901.

002300 WORKING-STORAGE SECTION.
002400
002500 77  SUB                           PIC S9(4) COMP-4 VALUE 0.
002600 77  MATCHED-DPATHD                PIC X(1)  VALUE "N".
002700 77  SAVE-PATH1-PRINT-OPT          PIC X(1).
002800 77  SAVE-PATH1-CATEGORY               PIC X(1).
002900 77  SAVE-DEPT                     PIC X(6).
003000 77  CHECK-LOW-VALUE               PIC 9(14).
003100 77  CHECK-HIGH-VALUE              PIC 9(14).
003200 77  SAVE-PATH                     PIC X(4).
003300 77  EXP-TEST                      PIC 9(6).
003400 77  EXP-TEST-DEC                  PIC 9(6)V9(4).
003500 77  EXP-TEST-INT                  PIC 9(6).
003600
003700**************************************************************
003800**                                                          **
003900**            D A T A B A S E   W O R K                     **
004000**                                                          **
004100**************************************************************
       01  FILE-STATUS.
           05  FILE-STATUS-1            PIC X  VALUE "0".
           05  FILE-STATUS-2            PIC X  VALUE "0".
004200
004300 01  DSET-NAMES.
004400     05  DSET-MPATH                PIC X(16) VALUE "MPATH;".
004500     05  DSET-DPATHDEF             PIC X(16) VALUE "DPATHDEF;".
004600     05  DSET-MVALIDPLTDATA  PIC X(16) VALUE "MVALIDPLTDATA;".
004700
004800 01  MODE-AREA.
004900     05  MODE1                     PIC S9(4)   COMP       VALUE 1.
005000     05  MODE5                     PIC S9(4)   COMP       VALUE 5.
005100     05  MODE7                     PIC S9(4)   COMP       VALUE 7.
005200
005300 01  ALL-ITEMS                     PIC X(2)  VALUE "@;".
005400 01  PATH-SEARCH                   PIC X(16) VALUE "PATH-NUM;".
005500 01  PATH-ARG.
005600     05  PATH-ARG-PREFIX           PIC X(1).
005700     05  PATH-ARG-NUMBER           PIC 9(3).
005800 01  PD-KEY-SEARCH                 PIC X(7)  VALUE "PD-KEY;".
005900 01  PD-KEY-ARG.
006000     05  PD-KEY-ARG-PATH-TYPE      PIC X(1).
006100     05  PD-KEY-ARG-INC-EX         PIC X(1).
006200     05  PD-KEY-ARG-TYPE           PIC X(2).
006300     05  PD-KEY-ARG-LOW-VALUE      PIC X(14).
006400
006500 01  REQ-CHRG-ARG.
006600     05  FILLER                    PIC X(2)  VALUE "RC".
006700     05  RC-REQ-DEPT               PIC X(4).
006800     05  RC-CHRG-DEPT              PIC X(4).
006900
007000**************************************************************
007100**                                                          **
007200**           D A T A B A S E   B U F F E R S                **
007300**                                                          **
007400**************************************************************
007500
007600 COPY MPATH      IN COPYLIB.
007700 COPY DPATHDEF   IN COPYLIB.
007800 COPY MVALDPLT   IN COPYLIB.
007900
008000**************************************************************
008100**                                                          **
008200**            L I N K A G E   S E C T I O N                 **
008300**                                                          **
008400**************************************************************
008500
008600 LINKAGE SECTION.
008700 01  BASE                          PIC X(10).
008800 COPY DBSTAT     IN COPYLIB.
008900 COPY CEARQPH    IN COPYLIB.
009000 COPY CEARQPH2   IN COPYLIB.
009100 01  BU-DISPLAY-MSG.
009200     05  BU-DISPLAY-MSG-1          PIC X(1).
009300     05  FILLER                    PIC X(57).
009400
009500 PROCEDURE DIVISION USING          BASE
009600                                   STATUS-AREA,
009700                                   RQPH-AREA,
009800                                   RQPH-SAVE-TABLE,
009900                                   BU-DISPLAY-MSG.
010000
010100 1000-CONTROL.
           MOVE 0 TO SUB.
           MOVE "N" TO MATCHED-DPATHD.
           OPEN INPUT MVALIDPLTDATA-I, DPATHDEF-I, MPATH-I.
010200*------ THE MAIN KEY INTO THE PATHS IS DEPARTMENT.  IF REQUESTING
010300*------ AND CHARGE DEPT MATCH, NO PROBLEM, WE JUST SEARCH BY THAT
010400*------ DEPT.  IF REQ AND CHARGE DEPT DONT MATCH, WE CHECK FOR
010500*------ THE COMBINED KEY IN MVALIDPLTDATA (REQ + CHARGE DEPT).
010600*------ IF IT DOESNT EXIST, AGAIN WE GO BY CHARGE DEPT.  IF IT
010700*------ DOES EXIST, THERE ARE 3 OPTIONS:
010800*------   1.  GO BY CHARGE DEPT
010900*------   2.  GO BY REQUESTING DEPT
011000*------   3.  COMBINED PATH OF CHARGE DEPT AND REQ DEPT
011100*------ IN THE CASE OF COMBINED PATH, WE RETURN 2 PATH NUMBERS.
011200*------ THEN, 'CEAQUE' GETS BOTH AND ELIMINATES DUPLICATES.
011300
011400     MOVE SPACES                   TO   RQPH-RET-PATH-PREFIX2.
011500     MOVE ZERO                     TO   RQPH-RET-PATH-NUM2.
011600
011700*------ THIS VERSION OF PATH DETERMINATION PROGRAM LOADS UP ALL
011800*------ DPATHDEF ENTRIES INTO A TABLE AND WORKS FROM THAT.  THIS
011900*------ ONLY HANDLES PATH TYPES THAT WILL HAVE LESS THAN 30
012000*------ PATH DEFINITIONS (NORMALLY 'R' FOR REQ APPROVAL WILL HAVE
012100*------ MORE THAN 30, TYPE 'E' FOR EXPENSE TYPE WILL HAVE LESS
012200*------ THAN 30).
012300     IF RQPH-TABLE-LOADED-FLAG = "Y"
012400         NEXT SENTENCE
012500     ELSE
012600         PERFORM 7400-LOAD-TABLE THRU 7490-LT-X.
012700
012800     IF RQPH-REQ-DEPT = RQPH-DEPARTMENT
012900         PERFORM 6000-MAIN THRU 6990-MAIN-X
013000     ELSE
013100         MOVE RQPH-REQ-DEPT        TO   RC-REQ-DEPT
013200         MOVE RQPH-DEPARTMENT      TO   RC-CHRG-DEPT
013300*        CALL "DBGET" USING BASE, DSET-MVALIDPLTDATA, MODE7,
013400*          STATUS-AREA, ALL-ITEMS, BUF-MVALIDPLTDATA,
013500*          REQ-CHRG-ARG
               MOVE REQ-CHRG-ARG TO VALDTAKEY OF MVALIDPLTDATA-REC-I
               READ MVALIDPLTDATA-I INTO BUF-MVALIDPLTDATA
                   INVALID KEY MOVE 17 TO COND-WORD
               END-READ
012500         IF FILE-STATUS = "00"
013700*            ** CHARGE DEPT PATH
013800             IF VALID-DATA-DESC-1 = "1"
013900                 PERFORM 6000-MAIN THRU 6990-MAIN-X
014000             ELSE
014100*            ** REQ DEPT PATH
014200             IF VALID-DATA-DESC-1 = "2"
014300                 MOVE RQPH-DEPARTMENT   TO   SAVE-DEPT
014400                 MOVE RQPH-REQ-DEPT     TO   RQPH-DEPARTMENT
014500                 PERFORM 6000-MAIN THRU 6990-MAIN-X
014600                 MOVE SAVE-DEPT         TO   RQPH-DEPARTMENT
014700             ELSE
014800*            ** COMBINED PATH
014900                 PERFORM 6000-MAIN THRU 6990-MAIN-X
015000                 MOVE RQPH-RET-PATH     TO   RQPH-RET-PATH2
015100                 MOVE RQPH-DEPARTMENT   TO   SAVE-DEPT
015200                 MOVE RQPH-REQ-DEPT     TO   RQPH-DEPARTMENT
015300                 PERFORM 6000-MAIN THRU 6990-MAIN-X
015400                 MOVE SAVE-DEPT         TO   RQPH-DEPARTMENT
015500         ELSE
015600         IF NO-ENTRY
015700             PERFORM 6000-MAIN THRU 6990-MAIN-X
015800     ELSE
015900         MOVE "CEARQPH2 DBGET ERR MVALD 1000-C" TO BU-DISPLAY-MSG
016000         GO TO 2000-END.
016100
016200 2000-END.
           CLOSE MVALIDPLTDATA-I, DPATHDEF-I, MPATH-I.
016300     GOBACK.
016400
016500
016600 6000-MAIN.
016700     MOVE 0                        TO   PATH-ARG-NUMBER.
016800     MOVE RQPH-PATH-TYPE           TO   PATH-ARG-PREFIX.
016900
017000 6200-CHECK-PATHS.
017100     MOVE 0                        TO   SUB.
017200
017300 6210-CHECK-PATH-LOOP.
017400     ADD 1                         TO   SUB.
017500     IF SUB > RQPH-TABLE-LIMIT
017600         PERFORM 7500-SET-DEFAULT-PATH
017700         GO TO 6990-MAIN-X.
017800
017900     IF RQT-PATH-NUMBER-9 (SUB) = 1
018000         MOVE RQT-PRINT-OPTION (SUB) TO SAVE-PATH1-PRINT-OPT
018100         MOVE RQT-CATEGORY (SUB)     TO SAVE-PATH1-CATEGORY.
018200
018300*------ IF WE COME TO END OF CHAIN WITHOUT HITTING AN 'INCLUDE',
018400*------ THE ITEM DIDN'T MATCH THIS PATH.  THE FIRST 'EXCLUDE'
018500*------ WE HIT DISQUALIFIES THE ITEM.  THE CHAIN IS SORTED BY
018600*------ INCLUDE/EXCLUDE FLAG, SO ANY EXCLUDE WILL COME UP FIRST.
018700*------ THEREFORE ON THE FIRST INCLUDE WE HIT WE EXIT WITH A
018800*------ MATCH
018900     PERFORM 7100-CHECK-DPATHDEF.
019000     IF RQT-INCL-EXCL-FLAG (SUB) = "E"
019100         IF MATCHED-DPATHD = "N"
019200             GO TO 6210-CHECK-PATH-LOOP
019300         ELSE
019400             PERFORM 7600-FIND-NEXT-PATH THRU 7630-FNP-X
019500             IF SUB > RQPH-TABLE-LIMIT
019600                 PERFORM 7500-SET-DEFAULT-PATH
019700                 GO TO 6990-MAIN-X
019800             ELSE
019900                 SUBTRACT 1 FROM SUB
020000                 GO TO 6210-CHECK-PATH-LOOP
020100     ELSE
020200         IF MATCHED-DPATHD = "N"
020300             GO TO 6210-CHECK-PATH-LOOP
020400         ELSE
020500             MOVE RQT-PRINT-OPTION (SUB) TO RQPH-PRINT-OPTION
020600             MOVE RQT-PATH-NUMBER (SUB)  TO RQPH-RET-PATH
020700             MOVE RQT-CATEGORY (SUB)     TO RQPH-RET-CATEGORY
020800             GO TO 6990-MAIN-X.
020900
021000 6990-MAIN-X.
021100     EXIT.
021200
021300
021400******************************************************************
021500**                                                              **
021600**      P E R F O R M E D   R O U T I N E S                     **
021700**                                                              **
021800******************************************************************
021900 7100-CHECK-DPATHDEF.
022000     MOVE "N"                      TO   MATCHED-DPATHD.
022100     IF RQT-TYPE (SUB) = "C"
022200         IF RQPH-CLASS < RQT-LOW-VALUE (SUB)
022300             NEXT SENTENCE
022400         ELSE
022500         IF RQPH-CLASS > RQT-HIGH-VALUE (SUB)
022600             NEXT SENTENCE
022700         ELSE
022800             MOVE "Y"              TO   MATCHED-DPATHD
022900      ELSE
023000      IF RQT-TYPE (SUB) = "D"
023100          IF RQPH-DEPARTMENT < RQT-LOW-VALUE (SUB)
023200             NEXT SENTENCE
023300         ELSE
023400         IF RQPH-DEPARTMENT > RQT-HIGH-VALUE (SUB)
023500             NEXT SENTENCE
023600         ELSE
023700             MOVE "Y"              TO   MATCHED-DPATHD
023800     ELSE
023900     IF RQT-TYPE (SUB) = "E"
024000         IF RQPH-EXPENSE-CLASS < RQT-LOW-VALUE (SUB)
024100             NEXT SENTENCE
024200         ELSE
024300         IF RQPH-EXPENSE-CLASS > RQT-HIGH-VALUE (SUB)
024400             NEXT SENTENCE
024500         ELSE
024600             MOVE "Y"              TO   MATCHED-DPATHD
024700     ELSE
024800     IF RQT-TYPE (SUB) = "B"
024900         IF RQPH-BUDGET-NUMBER < RQT-LOW-VALUE (SUB)
025000             NEXT SENTENCE
025100         ELSE
025200         IF RQPH-BUDGET-NUMBER > RQT-HIGH-VALUE (SUB)
025300             NEXT SENTENCE
025400         ELSE
025500             MOVE "Y"              TO   MATCHED-DPATHD
025600     ELSE
025700     IF RQT-TYPE (SUB) = "V"
025800         MOVE RQT-LOW-VALUE (SUB)     TO   CHECK-LOW-VALUE
025900         MOVE RQT-HIGH-VALUE (SUB)   TO   CHECK-HIGH-VALUE
026000         IF RQPH-VALUE < CHECK-LOW-VALUE
026100             NEXT SENTENCE
026200         ELSE
026300         IF RQPH-VALUE > CHECK-HIGH-VALUE
026400             NEXT SENTENCE
026500         ELSE
026600             MOVE "Y"              TO   MATCHED-DPATHD.
026700
026800*------ AN ODD-EVEN FLAG CAN BE SET FOR EXPENSE CLASSES.
026900*------ IE, IF FLAG = "E" THEN ONLY EVEN EXPENSE CLASSES
027000*------ WILL MATCH THAT DEFINITION.
027100     IF RQT-ODD-EVEN-FLAG (SUB) = "O" OR "E"
027200         IF MATCHED-DPATHD = "Y" AND RQT-TYPE (SUB) = "E"
027300             IF RQPH-EXP-CLS-1-6 NUMERIC
027400                 MOVE RQPH-EXP-CLS-1-6 TO EXP-TEST
027500                 DIVIDE EXP-TEST BY 2 GIVING EXP-TEST-DEC
027600                 DIVIDE EXP-TEST BY 2 GIVING EXP-TEST-INT
027700                 IF RQT-ODD-EVEN-FLAG (SUB) = "O"
027800                     IF EXP-TEST-INT = EXP-TEST-DEC
027900                        MOVE "N"   TO   MATCHED-DPATHD
028000                     ELSE
028100                        NEXT SENTENCE
028200                 ELSE
028300                     IF EXP-TEST-INT = EXP-TEST-DEC
028400                        NEXT SENTENCE
028500                     ELSE
028600                        MOVE "N"   TO   MATCHED-DPATHD
028700             ELSE
028800                 MOVE "N"          TO   MATCHED-DPATHD.
028900
029000
029100 7400-LOAD-TABLE.
029200     MOVE 0                        TO   SUB.
029300     MOVE "Y"                      TO   RQPH-TABLE-LOADED-FLAG.
029400     MOVE RQPH-PATH-TYPE           TO   PATH-ARG-PREFIX.
029500     MOVE 0                        TO   PATH-ARG-NUMBER.
029600
029700 7410-GET-PATH-LOOP.
029800     ADD 1                         TO   PATH-ARG-NUMBER.
029900*    CALL "DBGET" USING BASE, DSET-MPATH, MODE7,
030000*      STATUS-AREA, ALL-ITEMS, BUF-MPATH, PATH-ARG.
           MOVE PATH-ARG TO PATHNUM OF MPATH-REC-I.
           READ MPATH-I INTO BUF-MPATH
               INVALID KEY MOVE 17 TO COND-WORD.
030100     IF FILE-STATUS-1 = "2"
030200         MOVE SUB                  TO   RQPH-TABLE-LIMIT
030300         GO TO 7490-LT-X
030400     ELSE
030500     IF FILE-STATUS NOT = "00"
030600         MOVE "CEARQPH2 DBGET ERR MODE7 7410-PL" TO BU-DISPLAY-MSG
030700         GO TO 6990-MAIN-X.
030800
030900*    CALL "DBFIND" USING BASE, DSET-DPATHDEF, MODE1,
031000*      STATUS-AREA, PATH-SEARCH, PATH-ARG.
           MOVE PATH-ARG TO PATHNUM OF DPATHDEF-REC-I.
           START DPATHDEF-I KEY = PATHNUM OF DPATHDEF-REC-I
               INVALID KEY MOVE 17 TO COND-WORD.
           IF (FILE-STATUS NOT = "00") AND (FILE-STATUS-1 NOT = "2")
031200         MOVE "CEARQPH2 DBFIND 7410" TO BU-DISPLAY-MSG
031300         GO TO 6990-MAIN-X.
031400
031500 7420-GET-DPATHDEF-LOOP.
031600*    CALL "DBGET" USING BASE, DSET-DPATHDEF, MODE5,
031700*      STATUS-AREA, ALL-ITEMS, BUF-DPATHDEF, PATH-ARG.
           MOVE 0 TO COND-WORD.
           READ DPATHDEF-I NEXT INTO BUF-DPATHDEF
               AT END MOVE 15 TO COND-WORD.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   MOVE 15 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.
           IF PATHNUM OF DPATHDEF-REC-I NOT = PATH-ARG
               MOVE 15 TO COND-WORD.
031800     IF END-OF-CHAIN
031900         GO TO 7410-GET-PATH-LOOP
032000     ELSE
032100     IF NOT GOOD-CALL
032200         MOVE "CEARQPH2 DBGET ERR 7420-GDL" TO BU-DISPLAY-MSG
032300         GO TO 6990-MAIN-X.
032400
032500     ADD 1                         TO   SUB.
032600     IF SUB > 30
032700         SUBTRACT 1 FROM SUB GIVING RQPH-TABLE-LIMIT
032800         GO TO 7490-LT-X.
032900
033000     MOVE DPATHD-PATH-NUMBER       TO   RQT-PATH-NUMBER (SUB).
033100     MOVE DPATHD-INCL-EXCL-FLAG    TO   RQT-INCL-EXCL-FLAG (SUB).
033200     MOVE DPATHD-TYPE              TO   RQT-TYPE (SUB).
033300     MOVE DPATHD-LOW-VALUE         TO   RQT-LOW-VALUE (SUB).
033400     MOVE DPATHD-HIGH-VALUE        TO   RQT-HIGH-VALUE (SUB).
033500     MOVE DPATHD-LEVEL             TO   RQT-LEVEL (SUB).
033600     MOVE DPATHD-INORD-SIMEL       TO   RQT-INORD-SIMEL (SUB).
033700     MOVE DPATHD-ODD-EVEN-FLAG     TO   RQT-ODD-EVEN-FLAG (SUB).
033800     MOVE MPATH-PRINT-OPTION       TO   RQT-PRINT-OPTION (SUB).
033900     MOVE MPATH-WO-APPROVE         TO   RQT-WO-APPROVE (SUB).
034000     MOVE MPATH-CATEGORY           TO   RQT-CATEGORY (SUB).
034100
034200     GO TO 7420-GET-DPATHDEF-LOOP.
034300
034400 7490-LT-X.
034500     EXIT.
034600
034700 7500-SET-DEFAULT-PATH.
034800*    ** DIDN'T FIND THE PATH, SO DEFAULT TO PATH 1
034900     MOVE "Y"                      TO   RQPH-RET-DEFAULT-FLAG.
035000     MOVE 1                        TO   PATH-ARG-NUMBER.
035100     MOVE PATH-ARG                 TO   RQPH-RET-PATH.
035200     MOVE SAVE-PATH1-PRINT-OPT     TO   RQPH-PRINT-OPTION.
035300     MOVE SAVE-PATH1-CATEGORY          TO   RQPH-RET-CATEGORY.
035400
035500 7600-FIND-NEXT-PATH.
035600     MOVE RQT-PATH-NUMBER (SUB)    TO   SAVE-PATH.
035700 7610-FIND-NEXT-PATH-LOOP.
035800     ADD 1                         TO   SUB.
035900     IF SUB > RQPH-TABLE-LIMIT
036000         GO TO 7630-FNP-X.
036100
036200     IF RQT-PATH-NUMBER (SUB) = SAVE-PATH
036300         GO TO 7610-FIND-NEXT-PATH-LOOP.
036400
036500 7630-FNP-X.
036600     EXIT.
036700
036800
036900
