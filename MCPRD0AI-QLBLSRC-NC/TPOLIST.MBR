001100 IDENTIFICATION DIVISION.
001200 PROGRAM-ID.     TPOLIST.
001300 AUTHOR.         BARBARA WINTER.
001400 DATE-WRITTEN.   MAY 20,1981.
001500*REMARKS.        THIS PROGRAM PRODUCES TWO OPTIONS. THE FIRST
001600*                OPTION GIVES A REPORT OF ALL PURCHASE ORDERS
001700*                FOR THE INPUT DEPARTMENT WITHIN A DATE RANGE.
001800*                THE SECOND OPTION WILL REPRINT THOSE PURCHASE
001900*                ORDERS.
      *C
      *C  09/11/96  JEFF BUNGO
      *C      EXPAND DATE FIELDS FOR YEAR 2000 COMPLIANCE.
      *C      INCLUDE CENTURY ON PO DATE OF THE SORT AND
      *C      ON THE COMPARE OF BEGIN AND END DATES.
      *C
      *C  10MAR1997  DAVE PLUM
      *C      REVISED TO UTILIZE THE NEW TPOPRNT2 PO PRINT
      *C      SUBROUTINE WHEN THE PLANT DOES NOT USE ASCII
      *C      PRINTERS.  THE MPLTINFO-NOASCII-REPORTS WILL
      *C      TELL US WHICH PO PRINT SUBROUTINE TO USE:
      *C         IF MPLTINFO-NOASCII-REPORTS = "Y"  (DO NOT USE ASCII)
      *C              CALL TPOPRNT2 USING ...
      *C         IF MPLTINFO-NOASCII-REPORTS = "N"  (ASCII IS OKAY)
      *C              CALL TPOPRNT USING ...
      *C
DP9803*C  02MAR1998   DAVE PLUM
DP9803*C     ADDED CALL TO MCXCBLERR, AND ADDED CHECK FOR NON-NUMERIC
DP9803*C     DATA BEING PASSED IN VARIABLE D-SPOOLER.
DP9803*C
002100 ENVIRONMENT DIVISION.
002200 CONFIGURATION SECTION.
002300 SOURCE-COMPUTER.
002400 OBJECT-COMPUTER.
002500 SPECIAL-NAMES.  C01 IS NEW-PAGE.
002700 INPUT-OUTPUT SECTION.
002800 FILE-CONTROL.
002900     SELECT PRINT-FILE  ASSIGN TO PRINTER-MCPRT.
002910     SELECT SORTED-FILE ASSIGN TO DISK-SORTED.
003000     SELECT SORT-FILE   ASSIGN TO DISK-SORT.
             SELECT DPORECD-I
               ASSIGN TO DATABASE-MCFLCS0901
               ORGANIZATION IS INDEXED
                  ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY WITH DUPLICATES
               FILE STATUS IS FILE-STATUS.
             SELECT DVENDOR-I
               ASSIGN TO DATABASE-MCFLCS0701
               ORGANIZATION IS INDEXED
                  ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY WITH DUPLICATES
               FILE STATUS IS FILE-STATUS.
           SELECT MPLTINFO
                  ASSIGN TO DATABASE-MCFLCS0501
                  ORGANIZATION IS INDEXED
                    ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                  FILE STATUS IS FILE-STATUS.
003100
003200 DATA DIVISION.
003300 FILE SECTION.
003400 FD  PRINT-FILE
003500     LABEL RECORDS ARE OMITTED
003600     RECORD CONTAINS 132 CHARACTERS
003700     DATA RECORD IS PRT-REC.
003800 01  PRT-REC              PIC X(132).
003900
003910 FD  SORTED-FILE
003911     RECORD CONTAINS 77 CHARACTERS
003912     DATA RECORD IS SORTED-REC.
003913 01  SORTED-REC.
003914     05  BUYER-SRTD               PIC X(4).
003915     05  PO-NUMBER-SRTD.
003916         10  PONUM-SRTD           PIC X(7).
003917         10  BLANKET-SRTD         PIC X(3).
003918         10  RECEIVER-SRTD        PIC X(3).
           05  PO-DATE-SRTD-CN.
               10  PO-DATE-SRTED-CC     PIC X(2).
003919         10  PO-DATE-SRTD         PIC X(6).
003920     05  EXPECT-DATE-SRTD         PIC X(6).
003921     05  POSHIP-DATE-SRTD         PIC X(6).
003922     05  VIA-SRTD                 PIC X(15).
003923     05  FOB-SRTD                 PIC X(15).
003924     05  VENCODE-SRTD             PIC X(10).
004000 SD  SORT-FILE
004100     RECORD CONTAINS 77 CHARACTERS
004200     DATA RECORD IS SORT-REC.
004300 01  SORT-REC.
004400     05  BUYER-SORT               PIC X(4).
004600     05  PO-NUMBER-SORT.
004700         10  PONUM-SORT           PIC X(7).
004800         10  BLANKET-SORT         PIC X(3).
004900         10  RECEIVER-SORT        PIC X(3).
           05  PO-DATE-SORT-CN.
               10  PO-DATE-SORT-CC      PIC X(2).
005000         10  PO-DATE-SORT.
                   15  PO-DATE-SORT-YY  PIC X(2).
                   15  FILLER           PIC X(4).
005100     05  EXPECT-DATE-SORT         PIC X(6).
005200     05  POSHIP-DATE-SORT         PIC X(6).
005300     05  VIA-SORT                 PIC X(15).
005400     05  FOB-SORT                 PIC X(15).
005800     05  VENCODE-SORT             PIC X(10).
005900
       FD  DPORECD-I
           LABEL RECORDS ARE STANDARD.
       01  DPORECD-REC-I.
           COPY DDS-MCRPCS0900  OF MCFLCS0901.

       FD  DVENDOR-I
           LABEL RECORDS ARE STANDARD.
       01  DVENDOR-REC-I.
           COPY DDS-MCRPCS0700  OF MCFLCS0701.

       FD  MPLTINFO
           LABEL RECORDS ARE STANDARD.
       01  MPLTINFO-REC.
           COPY DDS-MCRPCS0500  OF MCFLCS0501.

006000 WORKING-STORAGE SECTION.
006100
       01  FILE-STATUS.
           05  FILE-STATUS-1            PIC X  VALUE "0".
           05  FILE-STATUS-2            PIC X  VALUE "0".
006200 77  ALL-RECORDS-RETRIEVED-SW           PIC X VALUE "N".
006300 77  ALL-RECORDS-WRITTEN-SW             PIC X VALUE "N".
006400 01  LINE-K                             PIC 9(4) VALUE 60.
006500 77  RET-CODE                           PIC X(2).
DP9803 77  MCXCBLERR-SCOPE                    PIC X(1)  VALUE "C".

