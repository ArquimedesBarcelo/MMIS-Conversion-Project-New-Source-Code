024100***************************************************************
024200 COPY TBLOWUP    IN COPYLIB.
024400 COPY TDATECHK   IN COPYLIB.
024800 COPY LANGUAGE   IN COPYLIB.
       LINKAGE SECTION.
       COPY THDPRTB OF COPYLIB.
006900 01  DATA-LINE                  PIC X(161).
007000 01  DATA-LINE-X REDEFINES DATA-LINE.
007100     05  D-REPORT               PIC X.
007200     05  D-RCV-DEPT             PIC X(6).
007300     05  D-BEG-DATE             PIC X(6).
007400     05  D-END-DATE             PIC X(6).
007500     05  D-SPOOLER              PIC S9(2).
007600     05  FILLER                 PIC X(140).
008000
025400 PROCEDURE DIVISION USING HD-ROUTE-DATA, DATA-LINE.
025500 0-BEGIN-SORT SECTION.
025600
025700 10-OPEN-FILES.
DP9803     MOVE "TPOLIST" TO BU-PGM-NAME.
DP9803     MOVE "C"                      TO  MCXCBLERR-SCOPE.
DP9803     CALL "MCXCBLERR" USING MCXCBLERR-SCOPE.
           OPEN INPUT MPLTINFO.
           MOVE "POPT" TO PLTINFOKEY OF MPLTINFO-REC.
           READ MPLTINFO INTO BUF-MPLTINFO
              INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE "N" TO MPLTINFO-NOASCII-REPORTS.

      *----- CALL CCRTFILE TO CREATE A TEMPORARY FILE FOR SORTING
      *----- LIBRARY 'QTEMP' IS USED FOR TEMPORARY FILES
           MOVE SPACES        TO CCRTFILE-PARMS.
           MOVE "QTEMP"       TO CCRTFILE-LIBRARY.
           MOVE "SORTED"      TO CCRTFILE-FILE.
           MOVE "0077"        TO CCRTFILE-RECORD-LENGTH.
           MOVE "90000"       TO CCRTFILE-NO-RECORDS.
           MOVE "02000"       TO CCRTFILE-INCREMENT-AMT.
           MOVE "10"          TO CCRTFILE-NO-INCREMENTS.
           CALL "CCRTFILE" USING CCRTFILE-LIBRARY,
                                 CCRTFILE-FILE,
                                 CCRTFILE-RECORD-LENGTH,
                                 CCRTFILE-NO-RECORDS,
                                 CCRTFILE-INCREMENT-AMT,
                                 CCRTFILE-NO-INCREMENTS,
                                 CCRTFILE-STATUS.
           IF CCRTFILE-STATUS NOT = "00"
               MOVE "CCRTFILE CREATE OF 'SORTED' FAILED"
                  TO BU-DISPLAY-MSG
               PERFORM 2-BLOWUP.

027010     IF D-REPORT = "A"
078400*----------  OPEN OUTPUT FILE
              MOVE HD-SPOOLER-NUMBER TO OVRPRTF-TOFILE-NUM
              MOVE "*YES"       TO OVRPRTF-SHARED
028100        MOVE HD-NO-OF-COPIES TO OVRPRTF-COPIES
              MOVE "MCPRT"      TO OVRPRTF-FILE
              PERFORM 996-OVERRIDE-PRINT-FILE
027100       OPEN OUTPUT PRINT-FILE
027500       MOVE "DHDR99.PUB"   TO HD-FILE-NAME
027600       CALL "THDPRT2" USING HD-RET-CODE, HD-FILE-NAME, FNUM,
027700           HD-ROUTE-DATA, ESC-NAME
027800       IF HD-RET-CODE NOT = 0
027900         MOVE "THDPRT2 ERROR * POLIST" TO BU-DISPLAY-MSG
028000         MOVE "HD-RET-CODE = "        TO BU-DISPLAY-FLD (1)
028100         MOVE HD-RET-CODE             TO BU-DISPLAY-FLD9 (1)
028200         GO TO 2-BLOWUP.
028300
DP9803*-------- VERIFY THAT THE SPOOLER NUMBER PASSED IS NUMERIC.
DP9803     IF D-REPORT = "B"
DP9803         IF D-SPOOLER IS NUMERIC
DP9803              NEXT SENTENCE
DP9803         ELSE
DP9803              MOVE ZEROES TO D-SPOOLER
DP9803         END-IF
DP9803     END-IF.

028500     OPEN INPUT DVENDOR-I DPORECD-I.
029128
029700*----------  FIND THE PROPER ESCAPE SEQUENCES
029800     CALL "TESCSEQ" USING ESC-NAME.
029200     MOVE CHAR-1636PI     TO COMPRESS-PRINT.
029300     MOVE CHAR-10PI       TO NORMAL-PRINT.
029400     MOVE TEXT-LENGTH-61  TO ESC-TEXT-61.
029500     MOVE TEXT-LENGTH-60  TO ESC-TEXT-60.

029600 6O-MAIN.
029610     PERFORM 8-INPUT-RECORDS THRU 8-IR-EXIT.
029620     CLOSE SORTED-FILE.
029700         SORT SORT-FILE ASCENDING KEY PO-DATE-SORT-CN
030100             USING SORTED-FILE
030200             GIVING SORTED-FILE.
030210
030220     PERFORM 9-OUTPUT-RECORDS THRU 9-OR-EXIT.
030300
030400 2-EOJ.
030410     IF D-REPORT = "A"
030500        WRITE PRT-REC FROM ESC-TEXT-60  AFTER ADVANCING 0
030600        WRITE PRT-REC FROM NORMAL-PRINT AFTER ADVANCING 0
030700        CLOSE PRINT-FILE.
              CLOSE DPORECD-I DVENDOR-I MPLTINFO.
031200
031300     GOBACK.
031400
031600******************************************************
031800**   BLOWUP ROUTINE                                 **
032000******************************************************
032100
032200 2-BLOWUP.
032210     IF D-REPORT = "A"
032300       WRITE PRT-REC FROM ESC-TEXT-60  AFTER ADVANCING 0
032400       WRITE PRT-REC FROM NORMAL-PRINT AFTER ADVANCING 0.
032500
032600     CALL "TBLOWUP" USING BASE, BU-PGM-NAME, STATUS-AREA,
032700         DUMMY-VIEW-AREA, FILE-STATUS, BU-DISPLAY-MSG,
032800             BU-DISPLAY-FLDS.
032900
033000
033100 8-INPUT-RECORDS.
033200     PERFORM 81-HOUSEKEEPING THRU 81-H-EXIT.

           MOVE 0 TO COND-WORD.
           MOVE SPACES TO PORCVNO OF DPORECD-REC-I.
           START DPORECD-I KEY IS GREATER OR EQUAL
                  PORCVNO OF DPORECD-REC-I
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
                   MOVE 17 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.
033300     PERFORM 86-MAIN THRU 86-M-EXIT UNTIL
033400             ALL-RECORDS-RETRIEVED-SW = "Y".
033500     GO TO 8-IR-EXIT.
033600
033700 81-HOUSEKEEPING.
033800
033900     OPEN OUTPUT SORTED-FILE.
034500     MOVE 1        TO  DATE-MODE.
034600     CALL "TDATECHK" USING DATE-CHECK-AREA.
034700     MOVE DATE-SLASH-OUT     TO DATE-2-H.
034800     MOVE DATE-FORMATTED-TIME-OUT TO TIME-2-H.
034900
034910*----------  CHANGE INPUT DATES FROM MDY TO YMD
034920     MOVE 3 TO DATE-MODE.
034930     MOVE D-BEG-DATE TO DATE-VALIDATE-IN.
034940     CALL "TDATECHK" USING DATE-CHECK-AREA.
034950     MOVE DATE-YMD-OUT TO D-BEG-DATE-X.
      *-----GET CENTURY FOR BEGINNING DATE
           IF D-BEG-DATE-X-YY > "70"
               MOVE "19" TO D-BEG-DATE-X-CC
           ELSE
               MOVE "20" TO D-BEG-DATE-X-CC.
034960
034970     MOVE D-END-DATE TO DATE-VALIDATE-IN.
034980     CALL "TDATECHK" USING DATE-CHECK-AREA.
034990     MOVE DATE-YMD-OUT TO D-END-DATE-X.
      *-----GET CENTURY FOR ENDING DATE
           IF D-END-DATE-X-YY > "70"
               MOVE "19" TO D-END-DATE-X-CC
           ELSE
               MOVE "20" TO D-END-DATE-X-CC.
034991 81-H-EXIT.  EXIT.
035000 86-MAIN.
035100
035200**************************************************************
035300*       DO A SERIAL READ (MODE2) ON THE DPORECD DATASET      *
035400**************************************************************
035500
035600*    CALL "DBGET" USING BASE DSET-DPORECD MODE2 STATUS-AREA
035700*                 ALL-ITEMS BUF-DPORECD PO-ARG.
           MOVE "00" TO FILE-STATUS.
           READ DPORECD-I NEXT INTO BUF-DPORECD
                 AT END MOVE FILE-STATUS TO FILE-STATUS.
035800     IF FILE-STATUS NOT = "00"
036000             MOVE "Y" TO ALL-RECORDS-RETRIEVED-SW
036100             GO TO 86-M-EXIT.
036500
036600     IF D-RCV-DEPT = PO-RCV-DEPT
036700        NEXT SENTENCE
036800     ELSE
036900        GO TO 86-MAIN.
037000
037010     IF PO-DATE-CN < D-BEG-DATE-X-CN
037020        GO TO 86-MAIN.
037030     IF PO-DATE-CN > D-END-DATE-X-CN
037040        GO TO 86-MAIN.
037050
037100     MOVE PO-PO-NO       TO PONUM-SRTD.
037200     MOVE PO-RLS-NO      TO BLANKET-SRTD.
037300     MOVE PO-RCVR        TO RECEIVER-SRTD.
037400     MOVE PO-DATE-CN     TO PO-DATE-SRTD-CN.
037500     MOVE PO-EXPECT-DATE TO EXPECT-DATE-SRTD.
037600     MOVE PO-BUYER-CODE  TO BUYER-SRTD.
037700     MOVE PO-SHIP-DATE TO POSHIP-DATE-SRTD.
037800     MOVE PO-VIA       TO VIA-SRTD.
037900     MOVE PO-FOB       TO FOB-SRTD.
038000      MOVE PO-VEN-CODE  TO VENCODE-SRTD.
038100
038200     WRITE SORTED-REC.
038300
038400 864-CI-X.
038500     EXIT.
038600 86-M-EXIT.  EXIT.
038700
038800
038900 8-IR-EXIT.
039000     EXIT.
039100
039200 9-OUTPUT-RECORDS.
039201     OPEN INPUT SORTED-FILE.
039210     IF D-REPORT = "A"
039300     IF PAPER-IS-132-COLS
039400         NEXT SENTENCE
039500     ELSE
039600        WRITE PRT-REC FROM COMPRESS-PRINT AFTER ADVANCING 0
039700        WRITE PRT-REC FROM ESC-TEXT-61    AFTER ADVANCING 0.
039800
039900
040000     PERFORM 96-MAIN THRU 96-M-EXIT UNTIL
040100             ALL-RECORDS-WRITTEN-SW = "Y".
040300     GO TO 9-OR-EXIT.
040400
040500 96-MAIN.
040600     READ SORTED-FILE AT END
040700         MOVE "Y" TO ALL-RECORDS-WRITTEN-SW
040800         GO TO 96-M-EXIT.
040810     IF D-REPORT = "B"
040820        PERFORM 9800-REPRINT-PO THRU 9819-EXIT
040830        GO TO 96-MAIN.
040900     IF LINE-K > 59
041000         PERFORM 97-HEADINGS THRU 97-H-EXIT.
041100
041200     MOVE SPACES                   TO DETAIL-LINE1.
041600     MOVE PO-NUMBER-SRTD       TO PO-NUM.
041800     MOVE  4  TO DATE-MODE.
041900     MOVE PO-DATE-SRTD      TO DATE-VALIDATE-IN.
042000     CALL "TDATECHK" USING DATE-CHECK-AREA.
042100     MOVE DATE-SLASH-OUT   TO PO-DATE-L1.
042200     IF EXPECT-DATE-SRTD  NOT = SPACES
042210       IF EXPECT-DATE-SRTD IS NUMERIC
042300         MOVE EXPECT-DATE-SRTD TO DATE-VALIDATE-IN
042400         CALL "TDATECHK" USING DATE-CHECK-AREA
042500         MOVE DATE-SLASH-OUT   TO EXPECT-DATE-L1
042510       ELSE
042520          MOVE EXPECT-DATE-SRTD TO EXPECT-DATE-L1.
042600     IF POSHIP-DATE-SRTD  NOT = SPACES
042601       IF POSHIP-DATE-SRTD IS NUMERIC
042610         MOVE POSHIP-DATE-SRTD TO DATE-VALIDATE-IN
042620         CALL "TDATECHK" USING DATE-CHECK-AREA
042630         MOVE DATE-SLASH-OUT   TO SHIP-DATE-L1
042632       ELSE
042633          MOVE POSHIP-DATE-SRTD TO SHIP-DATE-L1.
042640     MOVE VIA-SRTD TO VIA-L1.
042650     MOVE FOB-SRTD TO FOB-L1.
042660     MOVE BUYER-SRTD TO BUYER-L1.
042800      PERFORM 961-FIND-VENDOR-NAME THRU 961-FVN-EXIT.
042900      WRITE PRT-REC FROM DETAIL-LINE1 AFTER
043000             ADVANCING 1 LINES.
043100      ADD 1             TO LINE-K.
043800
043900 96-M-EXIT.
044000     EXIT.
044100
044200 961-FIND-VENDOR-NAME.
044300     MOVE VENCODE-SRTD       TO VEN-ARG,
044400                                BU-DISPLAY-FLD (1).
044500*    CALL "DBFIND" USING BASE DSET-DVENDOR MODE1 STATUS-AREA
044600*                  VEN-SEARCH VEN-ARG.
           MOVE 0 TO COND-WORD.
           MOVE VEN-ARG TO VENCDE OF DVENDOR-REC-I.
           START DVENDOR-I KEY = VENCDE OF DVENDOR-REC-I
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
                   MOVE 17 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.
044700     IF COND-WORD NOT = 0
044800         MOVE "FIND DVENDOR *961-FVN" TO BU-DISPLAY-MSG
044900         GO TO 2-BLOWUP.
045000
045100
045200 9611-GET-VENDOR-NAME.
045300*    CALL "DBGET" USING BASE DSET-DVENDOR MODE5 STATUS-AREA
045400*                 ALL-ITEMS BUF-DVENDOR VEN-ARG.
           MOVE 0 TO COND-WORD.
           READ DVENDOR-I NEXT INTO BUF-DVENDOR
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   MOVE 15 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.
           IF VENCDE OF DVENDOR-REC-I NOT = VEN-ARG
               MOVE 15 TO COND-WORD.
045500     IF COND-WORD NOT = 0
045600         IF COND-WORD = 15
045700             MOVE "NO VENDOR NAME LISTED" TO VEN-NAME-L1
045800             GO TO 961-FVN-EXIT
045900         ELSE
046000             MOVE "GET DVENDOR*9611-GVN" TO BU-DISPLAY-MSG
046100             GO TO 2-BLOWUP.
046200     IF VEN-ITM-NO = "00"
046300         MOVE VEN-NAME     TO VEN-NAME-L1.
046400
046500
046510 961-FVN-EXIT.  EXIT.
046600 97-HEADINGS.
046700     MOVE 0             TO LINE-K.
046800     MOVE D-RCV-DEPT TO DEPARTMENT-OUT.
046900     MOVE SPACES TO PRT-REC.
047000     WRITE PRT-REC FROM HEADING-1   AFTER ADVANCING NEW-PAGE.
047010     MOVE SPACES TO PRT-REC.
047100     WRITE PRT-REC FROM HEADING-2   AFTER ADVANCING 2 LINES.
047200     MOVE SPACES TO PRT-REC.
047300     WRITE PRT-REC AFTER ADVANCING 2 LINES.
047400     ADD 3 TO LINE-K.
048600 97-H-EXIT.  EXIT.

048700 9800-REPRINT-PO.
048710     MOVE SPACES TO PO-PRINT-PARMS.
048720     MOVE PO-NUMBER-SRTD TO BUILD-PO-NUM-PART.
048730     MOVE BUILD-PO TO PO-NUMBER.
048740     MOVE "Y" TO PO-REPRINT.
048750     MOVE D-SPOOLER TO SPOOL-PRINT-NUM.

           IF MPLTINFO-NOASCII-REPORTS = "Y"
               CALL "TPOPRNT2" USING BASE, PO-PRINT-PARMS,
                          ESC-NAME, LANGUAGE-PARMS
           ELSE
               CALL "TPOPRNT" USING BASE, PO-PRINT-PARMS,
                          ESC-NAME, LANGUAGE-PARMS.

048780 9819-EXIT.  EXIT.
       COPY OVRPFCALL OF COPYLIB.

048800 99-FAI-X.
048900     EXIT.
049000
