000200 IDENTIFICATION DIVISION.
000300 PROGRAM-ID. SRQPUPDC.
000400 AUTHOR. KURT MOVSESIAN/JIM COFFMAN (MAINTAINER).
000500*REMARKS.
000600*
000700******************************************************
000800*                                                    *
000900*   S R Q P U P D C                                  *
001000*                                                    *
001100*D  THIS SUB PROGRAM PLACES CODED REQUISITIONS ON    *
001200*D  HOLD OR RETURNS THEM TO THE ORIGINATOR AND IS    *
001300*D  USED BY PURCHASING.                              *
001400*D  NOTE THE REQUISITION MUST BE RELEASED TO         *
001500*D  PURCHASING BEFORE PURCHASING CAN UPDATE IT.      *
001600*                                                    *
001700******************************************************
001800*   N O T E    T H I S   S U B R O U T I N E   I S   *
001900*         C A L L E D    B Y :                       *
002000*      1. TRQPUPDT                                   *
002100******************************************************
002200*   N O T E    T H I S   S U B R O U T I N E         *
002300*         C A L L S :                                *
002400*      1. TCHKBLKT                                   *
002500*      2. TBLKTINQ                                   *
002600*      3. SPOINQ                                     *
002700******************************************************
002800**************************************************************
002900*   PROGRAM CHANGES:                                         *
003000*   10/21/85  ADDED CALLS TO FINDJCW, NLAPPEND, CATOPEN, AND *
003100*             CATCLOSE IN ORDER TO ACCOMODATE THE NATIVE     *
003200*             LANGUAGE SUPPORT FACILITY.  ADDED LINKAGES AND *
003300*             ALSO MADE THE CHANGE TO THE FORMFILE NAMES.    *
003400*   10/21/85  CHANGED ALL REFERENCES OF TSCRPRNT TO TSCRPRT2,*
003500*             TDATECHK TO TDATECK2.                          *
003600*             THIS WAS TO INCORPORATE THE NATIVE LANGUAGE    *
003700*             SUPPORT VERSIONS OF THESE SUBROUTINES.         *
003800*                               -TW COTTON                   *
003900**************************************************************
004000*
004100*
004200*    02/10/86.
004300*      CHANGED PROGRAM NAME TO "SRQPUPDC" FROM "TRQPUPDC" TO
004400*      CONFORM WITH OUR NEW NAMING CONVENTIONS FOR SUBPROGRAMS.
004500*      CIH.
004600*
004700*     08/25/87.
004800*       CHANGED PROGRAM TO PUT THE ACTUAL PO NUMBER ON THE SCREEN
004900*       WHEN A PO IS CUT FOR A REQ.  ALSO ADDED PO INQUIRY AS A
005000*       FUNCTION KEY.
005100*       AMK.
005200*
      *C    05/02/96     CA YODER    REQ #95-041
      *C      ADDED THE CURRENT DATE TO THE DATE RETURNED FIELD ON THE
      *C      REQ TO SHOW WHEN IT WAS RETURNED BY PURCHASING TO
      *C      MATERIALS CONTROL.
      *C
      *C    SEPTEMBER 1996  JE COFFMAN  REQ#6619
      *C      EXPAND DATE FIELDS FOR YEAR 2000 COMPLIANCE.
      *C
      *C    19MAY1997       WL MCINTYRE
      *C      COMMENT OUT OLD HP-3000 COMPATABILITY CODE TO LOCK FILES.
      *C
      *C  11/25/97    JEFF BUNGO   REQ #97-017
      *C     ADD USAGE FIELDS FOR DIRECT DELIVERY.  DD USAGE
      *C     TO BE STORED IN ADDITIONAL FIELD AND TOTAL USAGE.
      *C     STORE ISSUE USAGE CALCULATED BY TOTAL USAGE - DD USAGE.
      *C
005300 ENVIRONMENT DIVISION.
005400 CONFIGURATION SECTION.
005500 SOURCE-COMPUTER.  HP-3000.
005600 OBJECT-COMPUTER.  HP-3000.
       COPY SPECIALN IN COPYLIB.
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT MREQ-RQ-O
               ASSIGN TO DATABASE-MCFLCS2001
               ORGANIZATION IS INDEXED
                 ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
               FILE STATUS IS FILE-STATUS.

           SELECT USAGEFIL-CD-I
               ASSIGN TO DATABASE-MCFLCSUSAG
               ORGANIZATION IS INDEXED
                 ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
               FILE STATUS IS FILE-STATUS.

           SELECT DREQITM-RQ-I
               ASSIGN TO DATABASE-MCFLCS2201
               ORGANIZATION IS INDEXED
                 ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                 WITH DUPLICATES
               FILE STATUS IS FILE-STATUS.

           SELECT MSTORERM-CD-I
               ASSIGN TO DATABASE-MCFLCS0201
               ORGANIZATION IS INDEXED
                 ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
               FILE STATUS IS FILE-STATUS.

           SELECT DREQD-RQ-I
               ASSIGN TO DATABASE-MCFLCS2101
               ORGANIZATION IS INDEXED
                 ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                 WITH DUPLICATES
               FILE STATUS IS FILE-STATUS.

           SELECT MBUYER-BY-I
               ASSIGN TO DATABASE-MCFLCS0601
               ORGANIZATION IS INDEXED
                 ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
               FILE STATUS IS FILE-STATUS.

           SELECT MVALIDPLTDATA-VD-I
               ASSIGN TO DATABASE-MCFLCS1701
               ORGANIZATION IS INDEXED
                 ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
               FILE STATUS IS FILE-STATUS.

           SELECT DDAILYTC-DL-O
               ASSIGN TO DATABASE-MCFLCS1601
               ORGANIZATION IS INDEXED
                 ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                 WITH DUPLICATES
               FILE STATUS IS FILE-STATUS.

           SELECT DISPLAY-FILE
               ASSIGN TO WORKSTATION-ZRQPUPDT-SI
               ORGANIZATION IS TRANSACTION
               ACCESS IS SEQUENTIAL
               FILE STATUS IS DISPLAY-STATUS
               CONTROL-AREA IS WS-CONTROL.

