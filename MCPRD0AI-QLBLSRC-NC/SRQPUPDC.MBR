036300 PROCEDURE DIVISION USING  BASE,
036400                           USAGE-FILENUMBER,
036500                           COMPANY-SAVE,
036600                           REQ-ARG,
036700                           VIEW-COMAREA,
036800                           SCREEN-PRINT-PARMS,
036900                           PASSED-SPOOL-PRT,
037000                           LANGUAGE-PARMS,
037100                           FORMFILE,
037200                           FORMFILE-FCSISINQ.
037300
037400
037500 1-BEGIN.
           MOVE "N" TO FATAL-ERR-SW, EOJ-SW, F1-VALID-SW, F3-VALID-SW.
           MOVE ZERO TO VIEW-STATUS.
           MOVE SPACES TO DE-RETURN-OPTION, DE-HOLD-OPTION.
037600     MOVE "SRQPUPDC"  TO  BU-PGM-NAME.
           PERFORM 9999-OPEN-STUFF.
           ACCEPT CUR-DATE FROM DATE.
037700     PERFORM 64-PROCESS-REQUISITION  THRU  64-PR-X.
037800     IF FATAL-ERR-SW = "Y"
037900         GO TO 2-BLOWUP.
038000
           PERFORM 9999-CLOSE-STUFF.
038100     GOBACK.
038200
038300
038400 2-BLOWUP.
038500     CALL "TBLOWUP" USING BASE, BU-PGM-NAME, STATUS-AREA,
038600         VIEW-COMAREA, FILE-STATUS, BU-DISPLAY-MSG,
038700                 BU-DISPLAY-FLDS.
038800
038900 2-BLOWUP-X.
039000     EXIT.
039100
039200
047400 64-PROCESS-REQUISITION.
           PERFORM 9999-DBGET7-MREQ-RQ-O.
047700     IF COND-WORD  NOT = 0
047800         MOVE "DBGET 64-GET-MREQ"  TO  BU-DISPLAY-MSG
047900         MOVE REQ-ARG    TO BU-DISPLAY-FLD (1)
048000         MOVE "Y" TO FATAL-ERR-SW
048100         GO TO 64-PR-X.
           PERFORM 9999-RESET-MREQ-RQ-O.
048200
048300 64-FIND-DREQITM.
           PERFORM 9999-DBFIND-DREQITM-RQ-I.
048600     IF COND-WORD NOT = 0
048700         MOVE "Y" TO FATAL-ERR-SW
048800         MOVE "DBFIND 64-FIND-DREQITM" TO BU-DISPLAY-MSG
048900         MOVE REQ-ARG  TO  BU-DISPLAY-FLD (1)
049000         GO TO 64-PR-X.
049100
049200 64-GET-DREQITM.
           PERFORM 9999-DBGET5-DREQITM-RQ-I.
049500     IF COND-WORD NOT = 0
