080000     IF SONORDER-TOTAL-ONORDER = ZEROS
080100         MOVE "FRQPUPDT2"   TO  VIEW-NFNAME
080200     ELSE
080300         MOVE "FRQPUPDT2B"  TO  VIEW-NFNAME.
           PERFORM 9951-GETNEXTFORM.
080900
           PERFORM 9953-PUTBUFFER.
082600
      *------ F2 AND F8 VALID, F1 AND F3 MAYBE, F4, F5, F6, F7 INVALID
           MOVE 0 TO SRF-KEYSET.
           MOVE "I" TO SRF-FKEY (1), SRF-FKEY (6)
                       SRF-FKEY (5), SRF-FKEY (7).
082700     IF F1-VALID
082800         MOVE 1                     TO  LABEL-NUMBER
082900         MOVE F1-LABEL              TO  LABEL-VALUE
               MOVE SPACES                TO  SRF-FKEY (1)
083000         PERFORM 9960-SETKEYLABEL.
083100
083200     IF F3-VALID
083300         MOVE 3                     TO  LABEL-NUMBER
083400         MOVE F3-LABEL              TO  LABEL-VALUE
               MOVE SPACES                TO  SRF-FKEY (3)
083500         PERFORM 9960-SETKEYLABEL.
083600
083700 64-SHOWFORM-DE-FIELDS.
083800     IF FATAL-ERR-SW  =  "Y"
083900         GO TO 64-PR-X.
       6410-SHOWFORM.
           MOVE DE-FIELDS TO DISPLAY-REC.
           PERFORM 998-WRITE-SCREEN THRU 9989-WS-X.
           MOVE DISPLAY-REC TO DE-FIELDS.
           IF MESSAGE-BUFFER-1 NOT = SPACES
               PERFORM 9954-SETERROR
               GO TO 6410-SHOWFORM.

           IF VIEW-LASTKEY = 3
               GO TO 64-PR-X.

092900 64-GET-BUFFER-2.
           PERFORM 9952-GETBUFFER.
093300     IF VIEW-STATUS  NOT = 0
093400         MOVE "GETBUFFER 64-GB2"  TO  BU-DISPLAY-MSG
093500         MOVE "Y"                 TO  FATAL-ERR-SW
093600         GO TO 64-PR-X.
093700
093800     IF VIEW-LASTKEY = 1
               MOVE "N" TO CSF-MODE
094800         MOVE "FCSISINQ" TO CSF-NEW-FORMFILE-NAME
094900         PERFORM 7150-CALL-CSWITCHF
093900         CALL "TBLKINQ2" USING BASE,
094000                               CODE-ARG,
094100                               COMPANY-SAVE,
094200                               VIEW-COMAREA,
094300                               SCREEN-PRINT-PARMS,
094400                               PASSED-SPOOL-PRT,
094500                               LANGUAGE-PARMS
               MOVE "O" TO CSF-MODE
095600         PERFORM 7150-CALL-CSWITCHF
094600         GO TO 64-WRITE-DE-FIELDS.
           IF VIEW-LASTKEY = 2
               PERFORM 65-WRITE-REQ-INSTRUCT THRU 65-WRI-X
               GO TO 64-WRITE-DE-FIELDS.
           IF VIEW-LASTKEY = 4
               IF STR-USE
                   PERFORM 642-LOAD-TOT-USE THRU 642-LOAD-TOT-USE-X
               ELSE
                   PERFORM 641-LOAD-STR-USE THRU 641-LOAD-STR-USE-X
               END-IF
               GO TO 64-WRITE-DE-FIELDS.
094700     IF VIEW-LASTKEY = 8
               MOVE "N" TO CSF-MODE
094800         MOVE "FCSISINQ" TO CSF-NEW-FORMFILE-NAME
094900         PERFORM 7150-CALL-CSWITCHF
095000         CALL "SPOINQ" USING BASE,
095100                             BASE-STHIST,
095200                             VIEW-COMAREA,
095300                             COMPANY-SAVE,
095400                             LANGUAGE-PARMS
               MOVE "O" TO CSF-MODE
095600         PERFORM 7150-CALL-CSWITCHF
095700         GO TO 64-WRITE-DE-FIELDS.
095800
095900 64-EDIT-SCREEN2.
096000     IF DE-HOLD-OPTION = SPACES
096100         NEXT SENTENCE
096200     ELSE
096300         IF REQ-MATCONT-RELEASE = "X"
096400             IF REQ-PURCH-RELEASE = SPACES
096500                 NEXT SENTENCE
096600             ELSE
096700*                "CANNOT PUT ON HOLD REQUISITION ON P.O.#"
096800                 MOVE   3 TO LANG-SETNUM
096900                 MOVE 129 TO LANG-MSGNUM
097000                 PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
097100                 MOVE MESSAGE-BUFFER TO MSG-TEXT
097200                 MOVE DREQD-PO-NUM-RLSE TO MSG-FLD
097300                 MOVE 8  TO  FIELD-NUMBER
097400                 PERFORM 9954-SETERROR
097500                 GO TO 64-SHOWFORM-DE-FIELDS
097600         ELSE
097700*            "CANNOT PUT ON HOLD REQUISITION NOT RELEASED BY ORIGINATOR"
097800             MOVE   3 TO LANG-SETNUM
097900             MOVE 130 TO LANG-MSGNUM
098000             PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
098100             MOVE 8  TO  FIELD-NUMBER
098200             PERFORM 9954-SETERROR
098300             GO TO 64-SHOWFORM-DE-FIELDS.
098400
098500     IF DE-RETURN-OPTION = SPACES
098600         NEXT SENTENCE
098700     ELSE
098800         IF REQ-MATCONT-RELEASE = "X"
098900             IF REQ-PURCH-RELEASE = SPACES
099000                 NEXT SENTENCE
099100             ELSE
099200*                "CANNOT RETURN; REQUISITION ON P.O.#"
099300                 MOVE   3 TO LANG-SETNUM
099400                 MOVE 131 TO LANG-MSGNUM
099500                 PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
099600                 MOVE MESSAGE-BUFFER TO MSG-TEXT
099700                 MOVE DREQD-PO-NUM-RLSE TO MSG-FLD
099800                 MOVE 9  TO  FIELD-NUMBER
099900                 PERFORM 9954-SETERROR
100000                 GO TO 64-SHOWFORM-DE-FIELDS
100100         ELSE
100200*            "CANNOT RETURN; REQUISITION NOT RELEASED BY ORIGINATOR"
100300             MOVE   3 TO LANG-SETNUM
100400             MOVE 132 TO LANG-MSGNUM
100500             PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
100600             MOVE 9  TO  FIELD-NUMBER
100700             PERFORM 9954-SETERROR
100800             GO TO 64-SHOWFORM-DE-FIELDS.
100900
101000 64-EDIT-HOLD-OPTION.
101100     IF DE-HOLD-OPTION  =  SPACES
101200         GO TO 64-PROCESS-OPTION.
101300     MOVE DE-HOLD-OPTION  TO  STATUS-CODE.
           PERFORM 9999-DBGET7-MVALIDPLTDATA-VD-I.
101800     IF NOT GOOD-CALL
101900         IF NO-ENTRY
102000*            "* INVALID HOLD OPTION CHOOSEN *"
102100             MOVE   9 TO LANG-SETNUM
102200             MOVE  80 TO LANG-MSGNUM
102300             PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
102400             MOVE MESSAGE-BUFFER TO MSG-TEXT
102500             MOVE DE-HOLD-OPTION  TO  MSG-FLD
102600             MOVE 8     TO  FIELD-NUMBER
102700             PERFORM 9954-SETERROR
102800             GO TO 64-SHOWFORM-DE-FIELDS
102900         ELSE
103000             MOVE "DBGET 64-EDIT-SCREEN2" TO  BU-DISPLAY-MSG
103100             MOVE MVALIDPLT-ARG      TO BU-DISPLAY-FLD (1)
103200             MOVE "Y" TO FATAL-ERR-SW
103300             GO TO 64-PR-X.
103400
103500 64-PROCESS-OPTION.
103600
103700**************************************************
103800*                                                *
103900*   IF HOLD OPTION IS CHOOSEN PERFORM HOLD PROC. *
104000*                                                *
104100**************************************************
104200
104300     IF DE-HOLD-OPTION  =  SPACES
104400         NEXT SENTENCE
104500     ELSE
104600         PERFORM 642-HOLD-REQ  THRU  642-HR-X
104700         GO TO 64-PR-X.
104800
104900**************************************************
105000*                                                *
105100*   IF RETURN OPTION IS CHOOSEN PERFORM RETURN   *
105200*   PROCEDURE                                    *
105300*                                                *
105400**************************************************
105500
105600     IF DE-RETURN-OPTION  =  "X"
105700         PERFORM 641-RETURN-REQ  THRU  641-RR-X.
105800
105900
106000 64-PR-X.
106100     EXIT.
106200
       641-LOAD-STR-USE.
           MOVE "S" TO USAGE-SW.
           MOVE
             "USAGE FOR ISSUES ONLY, F4 FOR ISSUES AND DIRECT DELIVERY."
             TO DISP-USAGE-LIT.
           COMPUTE STR-USAGE = K-MTH-USAGE(1) - K-MTH-USAGE-DD(1).
           MOVE STR-USAGE        TO DISP-JAN-USAGE.
           COMPUTE STR-USAGE = K-MTH-USAGE(2) - K-MTH-USAGE-DD(2).
           MOVE STR-USAGE        TO DISP-FEB-USAGE.
           COMPUTE STR-USAGE = K-MTH-USAGE(3) - K-MTH-USAGE-DD(3).
           MOVE STR-USAGE        TO DISP-MAR-USAGE.
           COMPUTE STR-USAGE = K-MTH-USAGE(4) - K-MTH-USAGE-DD(4).
           MOVE STR-USAGE        TO DISP-APR-USAGE.
           COMPUTE STR-USAGE = K-MTH-USAGE(5) - K-MTH-USAGE-DD(5).
           MOVE STR-USAGE        TO DISP-MAY-USAGE.
           COMPUTE STR-USAGE = K-MTH-USAGE(6) - K-MTH-USAGE-DD(6).
           MOVE STR-USAGE        TO DISP-JUN-USAGE.
           COMPUTE STR-USAGE = K-MTH-USAGE(7) - K-MTH-USAGE-DD(7).
           MOVE STR-USAGE        TO DISP-JUL-USAGE.
           COMPUTE STR-USAGE = K-MTH-USAGE(8) - K-MTH-USAGE-DD(8).
           MOVE STR-USAGE        TO DISP-AUG-USAGE.
           COMPUTE STR-USAGE = K-MTH-USAGE(9) - K-MTH-USAGE-DD(9).
           MOVE STR-USAGE        TO DISP-SEP-USAGE.
           COMPUTE STR-USAGE = K-MTH-USAGE(10) - K-MTH-USAGE-DD(10).
           MOVE STR-USAGE        TO DISP-OCT-USAGE.
           COMPUTE STR-USAGE = K-MTH-USAGE(11) - K-MTH-USAGE-DD(11).
           MOVE STR-USAGE        TO DISP-NOV-USAGE.
           COMPUTE STR-USAGE = K-MTH-USAGE(12) - K-MTH-USAGE-DD(12).
           MOVE STR-USAGE        TO DISP-DEC-USAGE.
           COMPUTE STR-USAGE = K-MTH-USAGE(13) - K-MTH-USAGE-DD(13).
           MOVE STR-USAGE        TO DISP-MTD-USAGE.

           MOVE 0                TO YTD-TOTAL.
           MOVE 0 TO SUB.

       641-CALCULATE-YTD-USAGE.
           ADD 1 TO SUB.
           IF SUB > 12
               GO TO 641-CYU-X.
           COMPUTE YTD-TOTAL = YTD-TOTAL +
                         (K-MTH-USAGE(SUB) - K-MTH-USAGE-DD(SUB)).
           GO TO 641-CALCULATE-YTD-USAGE.
       641-CYU-X.
           MOVE YTD-TOTAL TO DISP-YTD-USAGE.
       641-LOAD-STR-USE-X.
           EXIT.

       642-LOAD-TOT-USE.
           MOVE "T" TO USAGE-SW.
           MOVE
             "USAGE FOR ISSUES AND DIRECT DELIVERY, F4 FOR ISSUES ONLY."
             TO DISP-USAGE-LIT.
           MOVE K-MTH-USAGE (14) TO DISP-YEST-USAGE.
           MOVE K-MTH-USAGE (1)  TO DISP-JAN-USAGE.
           MOVE K-MTH-USAGE (2)  TO DISP-FEB-USAGE.
           MOVE K-MTH-USAGE (3)  TO DISP-MAR-USAGE.
           MOVE K-MTH-USAGE (4)  TO DISP-APR-USAGE.
           MOVE K-MTH-USAGE (5)  TO DISP-MAY-USAGE.
           MOVE K-MTH-USAGE (6)  TO DISP-JUN-USAGE.
           MOVE K-MTH-USAGE (7)  TO DISP-JUL-USAGE.
           MOVE K-MTH-USAGE (8)  TO DISP-AUG-USAGE.
           MOVE K-MTH-USAGE (9)  TO DISP-SEP-USAGE.
           MOVE K-MTH-USAGE (10) TO DISP-OCT-USAGE.
           MOVE K-MTH-USAGE (11) TO DISP-NOV-USAGE.
           MOVE K-MTH-USAGE (12) TO DISP-DEC-USAGE.
           MOVE K-MTH-USAGE (13) TO DISP-MTD-USAGE.

           MOVE 0                TO YTD-TOTAL.
           MOVE 0 TO SUB.

       642-CALCULATE-YTD-USAGE.
           ADD 1 TO SUB.
           IF SUB > 12
               GO TO 642-CYU-X.
           ADD K-MTH-USAGE (SUB) TO YTD-TOTAL.
           GO TO 642-CALCULATE-YTD-USAGE.
       642-CYU-X.
           MOVE YTD-TOTAL TO DISP-YTD-USAGE.
       642-LOAD-TOT-USE-X.
           EXIT.
106300
106400**************************************************
106500*                                                *
106600*   THIS ROUTINE DELETES A REQ WHEN THE RETURN   *
106700*   OPTION IS CHOOSEN                            *
106800*                                                *
106900**************************************************
107000
107100 641-RETURN-REQ.
107200*    MOVE 2                        TO   NUMBER-OF-DSETS-LOCKED.
107300*    MOVE "MREQ;"                  TO   DSET-NAME-1.
107400*    MOVE "REQ-NUMBER;"            TO   ITEM-LIST-1.
107500*    MOVE REQ-ARG                  TO   LOCK-VALUE-1.
107600*    MOVE "DREQQUE;"               TO   DSET-NAME-2.
107700*    MOVE "REQ-NUMBER;"            TO   ITEM-LIST-2.
107800*    MOVE REQ-ARG                  TO   LOCK-VALUE-2.
      *    PERFORM 9930-LOCK.
108100*    IF COND-WORD NOT = 0
108200*        MOVE "LOCK 641-RETURN-REQ" TO BU-DISPLAY-MSG
108300*        MOVE REQ-ARG  TO  BU-DISPLAY-FLD (1)
108400*        MOVE "Y" TO FATAL-ERR-SW
108500*        GO TO 641-RR-X.
108600
108700*------ IF STR, JUST UPDATE THE HOLD STATUS TO 'RETURNED'.  IF
108800*------ NON-STR, SUBROUTINE MUST BE CALLED TO RE-QUEUE THE
108900*------ REQ TO ALL APPROVERS.  NOTE: NON-CODED USES OTHER SUBPROG
109000     IF REQ-STATUS = "SS"
               PERFORM 9999-DBGET7-MREQ-RQ-O
109100         MOVE "RT"                 TO   REQ-HOLD-STATUS-CODE
109200         MOVE "RETURNED"           TO   REQ-HOLD-STATUS
109300         MOVE SPACES               TO   REQ-MATCONT-RELEASE,
109400                                        REQ-REL-MC-DATE-CN
               MOVE CUR-YY               TO   REQ-DATE-RETN-YY
               IF REQ-DATE-RETN-YY > "70"
                   MOVE "19"             TO   REQ-DATE-RETN-CC
               ELSE
               MOVE "20"                 TO   REQ-DATE-RETN-CC
               END-IF
               MOVE CUR-MM               TO   REQ-DATE-RETN-MM
               MOVE CUR-DD               TO   REQ-DATE-RETN-DD
               PERFORM 9999-DBUPDATE-MREQ-RQ-O
109700         IF COND-WORD NOT = 0
109800             MOVE "DBUPDATE 641-RETURN-REQ"  TO  BU-DISPLAY-MSG
109900             MOVE REQ-ARG  TO  BU-DISPLAY-FLD (1)
110000             MOVE "Y" TO FATAL-ERR-SW
110100             GO TO 641-RR-X
110200         ELSE
110300             NEXT SENTENCE
110400     ELSE
110500         MOVE "N"                  TO   CSF-MODE
110600         MOVE "FCSISINQ"           TO   CSF-NEW-FORMFILE-NAME
110700         PERFORM 7150-CALL-CSWITCHF
110800         IF CSF-OPENFORM-ERR-SW = "Y"
110900             MOVE "COULDNT OPEN RETURN FORMFILE"
111000                                   TO   BU-DISPLAY-MSG
111100             PERFORM 2-BLOWUP
111200         ELSE
111300             MOVE "Y"              TO   EARET-LOCK-FLAG
111400             PERFORM 8000-UNLOCK
111500             CALL "SEARETRN" USING BASE, BASE-MMISA, BASE-BUDGET,
111600               STATUS-AREA, BUF-MREQ, BUF-DREQITM, BUF-DREQD,
111700               REQ-GLOBALS, EARET-PARMS, LANGUAGE-PARMS,
111800               VIEW-COMAREA
111900             IF BU-DISPLAY-MSG-1 NOT = SPACES
112000                 MOVE "Y"           TO   FATAL-ERR-SW
112100                 GO TO 641-RR-X
112200             ELSE
112300                 MOVE "O"          TO   CSF-MODE
112400                 PERFORM 7150-CALL-CSWITCHF
112500                 GO TO 6411-SKIP-UNLOCK.
112600
112700 641-MREQ-DREQD.
112800     PERFORM 8000-UNLOCK.
112900
113000 6411-SKIP-UNLOCK.
113100*------ FOR LUX, WHEN A REQ IS RETURNED, A TRANSACTION IS CUT FOR
113200*------ COPICS
113300     IF COMPANY-SAVE = "622" OR "645" OR "648" OR "658"
113400         PERFORM 7170-TC337.
113500
113600 641-RR-X.
113700     EXIT.
113800
113900**************************************************
114000*                                                *
114100*   THIS PROCEDURE PUTS THE REQ ON HOLD IF THE   *
114200*   HOLD OPTION IS CHOOSEN. THE HOLD STATUS      *
114300*   CHOOSEN IS PLACED IN REQ-PAD ALONG WITH THE  *
114400*   STATUS CODE.                                 *
114500*                                                *
114600**************************************************
114700
114800 642-HOLD-REQ.
114900*    MOVE 1  TO  NUMBER-OF-DSETS-LOCKED.
115000*    MOVE "MREQ;"  TO  DSET-NAME-1.
115100*    MOVE "REQ-NUMBER;"  TO  ITEM-LIST-1.
115200*    MOVE REQ-ARG   TO  LOCK-VALUE-1.
      *    PERFORM 9930-LOCK.
115500*    IF COND-WORD NOT = 0
115600*        MOVE "LOCK 642-HOLD-REQ" TO BU-DISPLAY-MSG
115700*        MOVE REQ-ARG  TO  BU-DISPLAY-FLD (1)
115800*        MOVE "Y" TO FATAL-ERR-SW
115900*        GO TO 642-HR-X.
116000
116100 642-GET-MREQ.
           PERFORM 9999-DBGET7-MREQ-RQ-O.
116400     IF COND-WORD NOT = 0
116500         MOVE "DBGET 642-GET-MREQ" TO BU-DISPLAY-MSG
116600         MOVE REQ-ARG                    TO BU-DISPLAY-FLD (1)
116700         MOVE "Y" TO FATAL-ERR-SW
116800         GO TO 642-HR-X.
116900
117000     MOVE DE-HOLD-OPTION   TO  REQ-HOLD-STATUS-CODE.
117100     MOVE VALID-DATA-DESC   TO  REQ-HOLD-STATUS.
117200
           PERFORM 9999-DBUPDATE-MREQ-RQ-O.
117500     IF COND-WORD  NOT = 0
117600         MOVE "UPDATE 642-GET-MREQ"  TO  BU-DISPLAY-MSG
117700         MOVE REQ-ARG  TO  BU-DISPLAY-FLD (1)
117800         MOVE "Y" TO FATAL-ERR-SW
117900         GO TO 642-HR-X.
118000
118100 642-UNLOCK-MREQ.
           PERFORM 9940-UNLOCK.
118900 642-HR-X.
119000     EXIT.
119100
119200
119300 65-WRITE-REQ-INSTRUCT.
119400**************************************************
119500*                                                *
119600*   THIS PROCEDURE WRITES AN INSTRUCTION SCREEN  *
119700*   WHEN AN 'f2' IS PRESSED ON THE REQUSISITION  *
119800*   PROCESSING SCREEN                            *
119900*                                                *
120000**************************************************
120100
120200     MOVE "FRQPUPDT3"  TO  VIEW-NFNAME.
           PERFORM 9951-GETNEXTFORM.
120900
121900 65-READ-INSTRUCT-SCREEN.
122000     IF FATAL-ERR-SW  =  "Y"
122100         GO TO 65-WRI-X.
           MOVE 8 TO SRF-KEYSET.
           MOVE "I" TO SRF-ENTER-FLAG.
       6010-SHOWFORM.
           MOVE DE-FIELDS-2 TO DISPLAY-REC.
           PERFORM 998-WRITE-SCREEN THRU 9989-WS-X.
           MOVE DISPLAY-REC TO DE-FIELDS-2.
           IF MESSAGE-BUFFER-1 NOT = SPACES
               MOVE MESSAGE-BUFFER TO DE-MESSAGE-LINE-2
               PERFORM 9954-SETERROR
               GO TO 6010-SHOWFORM.
128000
128100 65-WRI-X.
128200     EXIT.
128300
130800 7150-CALL-CSWITCHF.
130900     CALL "CSWITCHF" USING VIEW-COMAREA, LANGUAGE-PARMS,
131000       FORMFILE, CSF-PARMS, BU-DISPLAY-MSG.
131100     IF BU-DISPLAY-MSG-1 NOT = SPACES
131200         PERFORM 2-BLOWUP.
131300
131400 7170-TC337.
           MOVE "DDAILYTC" TO DSET-NAME.
           PERFORM 9930-LOCK.
131900
132000     MOVE SPACES                   TO   BUF-DDAILYTC.
132100     MOVE 1                        TO   DATE-MODE.
132200     CALL "TDATECHK" USING DATE-CHECK-AREA.
132300     MOVE DATE-YMD-OUT             TO   DDAILYTC-DATE.
132400     MOVE DATE-UNFORMATTED-TIME-OUT TO  DDAILYTC-TIME.
132500     MOVE "337"                    TO   DDAILYTC-TC.
132600     MOVE COMPANY-SAVE             TO   DDAILYTC-PLT.
132700     MOVE REQITM-CORP-CODE         TO   DDAILYTC-CODE.
132800     MOVE MREQ-NUMBER              TO   TC337-REQ-NUMBER.
132900
           PERFORM 9999-DBPUT-DDAILYTC-DL-O.
134100
134200 8000-UNLOCK.
           PERFORM 9940-UNLOCK.
134800
       COPY HCATREAD IN COPYLIB.
       COPY DISPCALL IN COPYLIB.
       COPY DISPCAL2 IN COPYLIB.
       9930-LOCK.
       9940-UNLOCK.
       9951-GETNEXTFORM.
       9952-GETBUFFER.
       9953-PUTBUFFER.
       9954-SETERROR.
           MOVE B"1" TO IND (99).
           MOVE B"1" TO IND (FIELD-NUMBER).
           MOVE MESSAGE-BUFFER TO DE-MESSAGE-LINE.
       9955-CLEAR-FORM.
       9956-PUTWINDOW.
       9957-FIELDEDITS.
       9958-INITFORM.
       9960-SETKEYLABEL.

       9999-DBGET7-MREQ-RQ-O.
           MOVE 0 TO COND-WORD.
           MOVE REQ-ARG TO REQNO OF MREQ-RQ-REC-O.
           READ MREQ-RQ-O INTO BUF-MREQ
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS = "23"
               MOVE 17 TO COND-WORD
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE "DBGET7 ERR 9999-DBGET7-MREQ-RQ-O"
                   TO BU-MSG-AREA
               MOVE 99 TO COND-WORD.

       9999-RESET-MREQ-RQ-O.
           MOVE HIGH-VALUES TO REQNO OF MREQ-RQ-REC-O.
           START MREQ-RQ-O KEY > REQNO OF MREQ-RQ-REC-O
             INVALID KEY MOVE "00" TO FILE-STATUS.

       9999-DBGET7-USAGEFIL-CD-I.
           MOVE 0 TO COND-WORD.
           MOVE CODE-ARG TO CORPCDE OF USAGEFIL-CD-REC-I.
           READ USAGEFIL-CD-I INTO USAGE-REC
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS = "23"
               MOVE 17 TO COND-WORD
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE "DBGET7 ERR 9999-DBGET7-USAGEFIL-I"
                   TO BU-MSG-AREA
               MOVE 99 TO COND-WORD.

       9999-DBFIND-DREQITM-RQ-I.
           MOVE 0 TO COND-WORD.
           MOVE REQ-ARG TO REQNO OF DREQITM-RQ-REC-I.
           START DREQITM-RQ-I KEY = REQNO OF DREQITM-RQ-REC-I
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF (FILE-STATUS NOT = "00") AND (FILE-STATUS-1 NOT = "2")
               MOVE "DBFIND ERR 9999-DBFIND-DREQITM-RQ-I"
                   TO BU-MSG-AREA
               MOVE 99 TO COND-WORD.

       9999-DBGET5-DREQITM-RQ-I.
           MOVE 0 TO COND-WORD.
           READ DREQITM-RQ-I NEXT INTO BUF-DREQITM
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   MOVE 15 TO COND-WORD
               ELSE
                   MOVE "DBGET5 ERR 9999-DBGET5-DREQITM-RQ-I"
                       TO BU-MSG-AREA
                   MOVE 99 TO COND-WORD
           ELSE
           IF REQNO OF DREQITM-RQ-REC-I NOT = REQ-ARG
               MOVE 15 TO COND-WORD.

       9999-DBGET7-MSTORERM-CD-I.
           MOVE 0 TO COND-WORD.
           MOVE CODE-ARG TO CORPCDE OF MSTORERM-CD-REC-I.
           READ MSTORERM-CD-I INTO BUF-MSTORERM
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS = "23"
               MOVE 17 TO COND-WORD
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE "DBGET7 ERR 9999-DBGET7-MSTORERM-CD-I"
                   TO BU-MSG-AREA
               MOVE 99 TO COND-WORD.

       9999-DBFIND-DREQD-RQ-I.
           MOVE 0 TO COND-WORD.
           MOVE REQ-ARG TO REQNO OF DREQD-RQ-REC-I.
           START DREQD-RQ-I KEY = REQNO OF DREQD-RQ-REC-I
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF (FILE-STATUS NOT = "00") AND (FILE-STATUS-1 NOT = "2")
               MOVE "DBFIND ERR 9999-DBFIND-DREQD-RQ-I"
                   TO BU-MSG-AREA
               MOVE 99 TO COND-WORD.

       9999-DBGET5-DREQD-RQ-I.
           MOVE 0 TO COND-WORD.
           READ DREQD-RQ-I NEXT INTO BUF-DREQD
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   MOVE 15 TO COND-WORD
               ELSE
                   MOVE "DBGET5 ERR 9999-DBGET5-DREQD-RQ-I"
                       TO BU-MSG-AREA
                   MOVE 99 TO COND-WORD
           ELSE
           IF REQNO OF DREQD-RQ-REC-I NOT = REQ-ARG
               MOVE 15 TO COND-WORD.

       9999-DBGET7-MBUYER-BY-I.
           MOVE 0 TO COND-WORD.
           MOVE BUYER-ARG TO BUYERCDE OF MBUYER-BY-REC-I.
           READ MBUYER-BY-I INTO BUF-MBUYER
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS = "23"
               MOVE 17 TO COND-WORD
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE "DBGET7 ERR 9999-DBGET7-MBUYER-BY-I"
                   TO BU-MSG-AREA
               MOVE 99 TO COND-WORD.

       9999-DBGET7-MVALIDPLTDATA-VD-I.
           MOVE 0 TO COND-WORD.
           MOVE VALID-DATA-ARG TO VALDTAKEY OF MVALIDPLTDATA-VD-REC-I.
           READ MVALIDPLTDATA-VD-I INTO BUF-MVALIDPLTDATA
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS = "23"
               MOVE 17 TO COND-WORD
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE "DBGET7 ERR 9999-DBGET7-MVALIDPLTDATA-VD-I"
                   TO BU-MSG-AREA
               MOVE 99 TO COND-WORD.

       9999-DBUPDATE-MREQ-RQ-O.
           MOVE 0 TO COND-WORD.
           REWRITE MREQ-RQ-REC-O FROM BUF-MREQ
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE "DBUPDATE ERR 9999-DBUPDATE-MREQ-RQ-O"
                   TO BU-MSG-AREA
               MOVE 99 TO COND-WORD.

       9999-DBPUT-DDAILYTC-DL-O.
           MOVE 0 TO COND-WORD.
           WRITE DDAILYTC-DL-REC-O FROM BUF-DDAILYTC
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE "DBPUT ERR 9999-DBPUT-DDAILYTC-DL-O"
                   TO BU-MSG-AREA
               MOVE 99 TO COND-WORD.

       9999-OPEN-STUFF.
           OPEN I-O DISPLAY-FILE.
           OPEN INPUT DREQITM-RQ-I          MSTORERM-CD-I
                      USAGEFIL-CD-I         DREQD-RQ-I
                      MBUYER-BY-I           MVALIDPLTDATA-VD-I.
           OPEN I-O   MREQ-RQ-O             DDAILYTC-DL-O.

       9999-CLOSE-STUFF.
           CLOSE DISPLAY-FILE
           CLOSE      MREQ-RQ-O             DREQITM-RQ-I
                      MSTORERM-CD-I         USAGEFIL-CD-I
                      DREQD-RQ-I            MBUYER-BY-I
                      MVALIDPLTDATA-VD-I    DDAILYTC-DL-O.
