056300     ELSE
056400     IF REQ-RELEASE-STAT  =  "X "
056500         IF REQ-HOLD-STATUS  =  SPACES
056600             MOVE "PURCHASING"    TO  DISP-HOLD-STATUS
056700         ELSE
056800             MOVE REQ-HOLD-STATUS TO  DISP-HOLD-STATUS
056900     ELSE
057000         IF REQ-HOLD-STATUS  =  SPACES
