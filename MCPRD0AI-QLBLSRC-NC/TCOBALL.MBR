000200 IDENTIFICATION DIVISION.
000300 PROGRAM-ID.          TCOBALL.
000400 AUTHOR.              C HILLES.
000500 DATE-WRITTEN.        8/30/89.
000600 DATE-COMPILED.
009400 ENVIRONMENT DIVISION.
009500 CONFIGURATION SECTION.
009600 SOURCE-COMPUTER.  HP-3000.
009700 OBJECT-COMPUTER.  HP-3000.
       SPECIAL-NAMES. I-O-FEEDBACK IS I-O-FEEDBACK-AREA.

       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT COPYLIB-FILE
                  ASSIGN TO DISK-HPROGRAM
                  ORGANIZATION IS SEQUENTIAL
                    ACCESS MODE IS SEQUENTIAL
                  FILE STATUS IS FILE-STATUS.

           SELECT DSET-FILE ASSIGN TO DATABASE-DSET.

010200 DATA DIVISION.
010300 FILE SECTION.
010400
       FD  COPYLIB-FILE
           RECORD CONTAINS 92 CHARACTERS
           LABEL RECORDS ARE STANDARD.
       01  COPYLIB-REC.
           05  COPYLIB-SEQ-NUMBER-1             PIC X(4).
           05  COPYLIB-SEQ-NUMBER-2             PIC X(2).
           05  COPYLIB-DATE                     PIC X(6).
           05  FILLER                           PIC X(6).
           05  COPYLIB-COMMENT                  PIC X(1).
           05  COPYLIB-AREA-A.
               10  FILLER                       PIC X(4).
               10  COPYLIB-AREA-B.
                   15  FILLER                   PIC X(4).
                   15  COPYLIB-INDENT-1.
                       20  FILLER               PIC X(2).
                       20  COPYLIB-INDENT-1B.
                           25  FILLER           PIC X(2).
                           25  COPYLIB-INDENT-2.
                               30  FILLER           PIC X(4).
                               30  COPYLIB-INDENT-3.
                                   35 FILLER        PIC X(4).
                                   35 COPYLIB-INDENT-4 PIC X(53).

       FD  DSET-FILE
           RECORD CONTAINS 132 CHARACTERS.
       01  DSET-REC.
           05  DR-DSET-NAME.
               10  DR-DSET-1   PIC X(1).
               10  FILLER      PIC X(14).
           05  DR-DSET-NUM     PIC X(2).
           05  DR-KEY          PIC X(16).
           05  DR-KEY-NUM      PIC X(2).
           05  DR-KEY-ABBREV   PIC X(2).
           05  DR-KEY-IBM-NAME PIC X(10).
           05  DR-ARG-NAME     PIC X(14).
           05  DR-BASE         PIC X(2).
           05  DR-BUFFNAME     PIC X(17).
           05  DR-DSET-ABBR    PIC X(3).
           05  DR-SEARCH       PIC X(15).
           05  FILLER          PIC X(34).

011200 WORKING-STORAGE SECTION.
011300
       01  FIRST-READ-FLAG              PIC X(1).
       01  BLOWUP-FLAG                  PIC X(1)  VALUE "Y".
       01  SAVE-DATE                    PIC X(6).
       01  COPYLIB-CNT                  PIC 9(4)  VALUE ZERO.
       01  SELECT-CNT                   PIC 9(4)  VALUE ZERO.
       01  FD-CNT                       PIC 9(4)  VALUE ZERO.
       01  SUB                          PIC 9(3)  VALUE ZERO.
       01  SUB2                         PIC 9(3)  VALUE ZERO.
       01  CUR-DSET                     PIC 9(3).
       01  OPEN-SUB                     PIC 9(3)  VALUE ZERO.
       01  FCNT                         PIC 9(2)  VALUE ZERO.
       01  NUM-INPUT-FILES              PIC 9(2)  VALUE ZERO.
       01  NUM-OUTPUT-FILES             PIC 9(2)  VALUE ZERO.
       01  NUM-OPEN-LINES               PIC 9(2)  VALUE ZERO.
       01  OPEN-LINE-NUM                PIC 9(2)  VALUE ZERO.
       01  WORK-LINE                    PIC X(80) VALUE SPACES.
       01  HOLD-FILE                    PIC X(21) VALUE SPACES.
       01  HOLD-REC                     PIC X(25) VALUE SPACES.
       01  HOLD-CALL-ABBR               PIC X(2).
       01  HOLD-CALL-TYPE               PIC X(8).
       01  HOLD-ACCESS-MODE             PIC X(1).
       01  QUOTE-CHAR                   PIC X(1) VALUE QUOTES.
       01  FILE-STATUS.
           05  FILE-STATUS-1            PIC X  VALUE "0".
           05  FILE-STATUS-2            PIC X  VALUE "0".
       01  INPUT-OUTPUT-FLAG            PIC X(1).
       01  WORK-STRING                   PIC X(80).
       01  EOF-FLAG                      PIC X(1).

       01  BUILD-COPYLIB-MEMBER-NAME.
           05  BLDCPY-CALL-TYPE          PIC X(2).
           05  BLDCPY-DSET-ABBR          PIC X(3).
           05  BLDCPY-KEY-ABBR           PIC X(2).
           05  BLDCPY-ACCESS-MODE        PIC X(1).
           05  FILLER                    PIC X(2) VALUE SPACES.

      *****************************************************************
      **                                                             **
      **       T A B L E S   A N D   S T U F F                       **
      **                                                             **
      *****************************************************************
       01  CALL-TYPE-AREA.
           05  FILLER          PIC X(8)  VALUE "DBGET2  ".
           05  FILLER          PIC X(1)  VALUE "1".
           05  FILLER          PIC X(8)  VALUE "DBGET7  ".
           05  FILLER          PIC X(1)  VALUE "3".
           05  FILLER          PIC X(8)  VALUE "DBFIND  ".
           05  FILLER          PIC X(1)  VALUE "4".
           05  FILLER          PIC X(8)  VALUE "DBPUT   ".
           05  FILLER          PIC X(1)  VALUE "5".
           05  FILLER          PIC X(8)  VALUE "DBUPDATE".
           05  FILLER          PIC X(1)  VALUE "6".
           05  FILLER          PIC X(8)  VALUE "DBDELETE".
           05  FILLER          PIC X(1)  VALUE "7".
       01  CALL-TYPE-TABLE REDEFINES CALL-TYPE-AREA.
           05  CALL-TYPE-LINE OCCURS 6 TIMES.
               10  CIT-CALL-ABBREV   PIC X(8).
               10  CIT-CALL-NUMBER   PIC X(1).

      *****************************************************************
      **                                                             **
      **         S U B P R O G R A M   A R E A S                     **
      **                                                             **
      *****************************************************************
       COPY COMMAND  IN COPYCSIS.

       LINKAGE SECTION.

       01  LIB-NAME                      PIC X(10).
       01  FILE-NAME                     PIC X(10).

032400 PROCEDURE DIVISION USING LIB-NAME, FILE-NAME.
033000
033100 1000-HOUSEKEEP.

           MOVE ZERO TO OPEN-SUB.
           OPEN INPUT DSET-FILE.
           MOVE "Y" TO FIRST-READ-FLAG.
           PERFORM 6000-MAIN THRU 6990-MAIN-X.

       2000-EOJ.
           CLOSE DSET-FILE.
           GOBACK.

       6000-MAIN.
       6010-READ-LOOP.
           READ DSET-FILE AT END
               GO TO 6990-MAIN-X.

           MOVE "GK"                     TO   HOLD-CALL-ABBR.
           MOVE "I"                      TO   HOLD-ACCESS-MODE.
           PERFORM 7000-DO-CALL THRU 7090-DC-X.
      *------------------------------------------
           MOVE "GK"                     TO   HOLD-CALL-ABBR.
           MOVE "O"                      TO   HOLD-ACCESS-MODE.
           PERFORM 7000-DO-CALL THRU 7090-DC-X.
      *------------------------------------------
           MOVE "GN"                     TO   HOLD-CALL-ABBR.
           MOVE "I"                      TO   HOLD-ACCESS-MODE.
           PERFORM 7000-DO-CALL THRU 7090-DC-X.
      *------------------------------------------
           MOVE "GN"                     TO   HOLD-CALL-ABBR.
           MOVE "O"                      TO   HOLD-ACCESS-MODE.
           PERFORM 7000-DO-CALL THRU 7090-DC-X.
      *------------------------------------------
           MOVE "GS"                     TO   HOLD-CALL-ABBR.
           MOVE "I"                      TO   HOLD-ACCESS-MODE.
           PERFORM 7000-DO-CALL THRU 7090-DC-X.
      *------------------------------------------
           MOVE "GS"                     TO   HOLD-CALL-ABBR.
           MOVE "O"                      TO   HOLD-ACCESS-MODE.
           PERFORM 7000-DO-CALL THRU 7090-DC-X.
      *------------------------------------------
           MOVE "DL"                     TO   HOLD-CALL-ABBR.
           MOVE "O"                      TO   HOLD-ACCESS-MODE.
           PERFORM 7000-DO-CALL THRU 7090-DC-X.
      *------------------------------------------
           MOVE "PT"                     TO   HOLD-CALL-ABBR.
           MOVE "O"                      TO   HOLD-ACCESS-MODE.
           PERFORM 7000-DO-CALL THRU 7090-DC-X.
      *------------------------------------------
           MOVE "UP"                     TO   HOLD-CALL-ABBR.
           MOVE "O"                      TO   HOLD-ACCESS-MODE.
           PERFORM 7000-DO-CALL THRU 7090-DC-X.
      *------------------------------------------
           MOVE "CH"                     TO   HOLD-CALL-ABBR.
           MOVE "I"                      TO   HOLD-ACCESS-MODE.
           PERFORM 7000-DO-CALL THRU 7090-DC-X.
      *------------------------------------------
           MOVE "CH"                     TO   HOLD-CALL-ABBR.
           MOVE "O"                      TO   HOLD-ACCESS-MODE.
           PERFORM 7000-DO-CALL THRU 7090-DC-X.
      *------------------------------------------
           MOVE "FD"                     TO  HOLD-CALL-ABBR.
           MOVE "I"                      TO  HOLD-ACCESS-MODE.
           PERFORM 7000-DO-CALL THRU 7090-DC-X.
      *------------------------------------------
           MOVE "FD"                     TO  HOLD-CALL-ABBR.
           MOVE "O"                      TO  HOLD-ACCESS-MODE.
           PERFORM 7000-DO-CALL THRU 7090-DC-X.
      *------------------------------------------
           MOVE "SL"                     TO  HOLD-CALL-ABBR.
           MOVE "I"                      TO  HOLD-ACCESS-MODE.
           PERFORM 7000-DO-CALL THRU 7090-DC-X.
      *------------------------------------------
           MOVE "SL"                     TO  HOLD-CALL-ABBR.
           MOVE "O"                      TO  HOLD-ACCESS-MODE.
           PERFORM 7000-DO-CALL THRU 7090-DC-X.
      *------------------------------------------
           MOVE "OP"                     TO  HOLD-CALL-ABBR.
           MOVE "I"                      TO  HOLD-ACCESS-MODE.
           PERFORM 7000-DO-CALL THRU 7090-DC-X.
      *------------------------------------------
           MOVE "OP"                     TO  HOLD-CALL-ABBR.
           MOVE "O"                      TO  HOLD-ACCESS-MODE.
           PERFORM 7000-DO-CALL THRU 7090-DC-X.
      *------------------------------------------
           MOVE "CL"                     TO  HOLD-CALL-ABBR.
           MOVE "I"                      TO  HOLD-ACCESS-MODE.
           PERFORM 7000-DO-CALL THRU 7090-DC-X.
      *------------------------------------------
           MOVE "CL"                     TO  HOLD-CALL-ABBR.
           MOVE "O"                      TO  HOLD-ACCESS-MODE.
           PERFORM 7000-DO-CALL THRU 7090-DC-X.
      *------------------------------------------

           GO TO 6010-READ-LOOP.
       6990-MAIN-X.
           EXIT.

       7000-DO-CALL.
           IF HOLD-CALL-ABBR = "GK"
               IF DR-DSET-1 = "D"
                   GO TO 7090-DC-X.
           IF HOLD-CALL-ABBR = "CH" OR "GN"
               IF DR-DSET-1 = "M"
                   GO TO 7090-DC-X.

           IF HOLD-CALL-ABBR = "GK"
               MOVE "GETKEY" TO HOLD-CALL-TYPE
           ELSE
           IF HOLD-CALL-ABBR = "GN"
               MOVE "GETNEXT" TO HOLD-CALL-TYPE
           ELSE
           IF HOLD-CALL-ABBR = "GS"
               MOVE "GETSER" TO HOLD-CALL-TYPE
           ELSE
           IF HOLD-CALL-ABBR = "DL"
               MOVE "DELETE" TO HOLD-CALL-TYPE
           ELSE
           IF HOLD-CALL-ABBR = "PT"
               MOVE "PUT"    TO HOLD-CALL-TYPE
           ELSE
           IF HOLD-CALL-ABBR = "UP"
               MOVE "UPDATE" TO HOLD-CALL-TYPE
           ELSE
           IF HOLD-CALL-ABBR = "CH"
               MOVE "CHAINHD" TO HOLD-CALL-TYPE
           ELSE
           IF HOLD-CALL-ABBR = "BG"
               MOVE "BEGFIL" TO HOLD-CALL-TYPE.

           MOVE DR-DSET-ABBR             TO   BLDCPY-DSET-ABBR.
           MOVE HOLD-CALL-ABBR           TO   BLDCPY-CALL-TYPE.
           MOVE DR-KEY-ABBREV            TO   BLDCPY-KEY-ABBR.
           MOVE HOLD-ACCESS-MODE         TO   BLDCPY-ACCESS-MODE.

           MOVE SPACES                   TO   WORK-STRING.
           CALL "MCXADDPFM" USING LIB-NAME, FILE-NAME,
                                  BUILD-COPYLIB-MEMBER-NAME.
           MOVE SPACES                   TO   WORK-STRING.
           STRING "OVRDBF FILE(HPROGRAM) TOFILE(" DELIMITED BY SIZE,
                   LIB-NAME DELIMITED BY SPACE,
                   "/" DELIMITED BY SIZE,
                   FILE-NAME DELIMITED BY SPACE,
                   ") MBR(" DELIMITED BY SIZE,
                   BUILD-COPYLIB-MEMBER-NAME DELIMITED BY SPACE,
                   ")" DELIMITED BY SIZE
              INTO WORK-STRING.
           MOVE WORK-STRING TO COMMAND-WORK.
           CALL "QCMDEXC" USING COMMAND-WORK, COMMAND-LEN.
           OPEN OUTPUT COPYLIB-FILE.

           MOVE SPACES TO HOLD-FILE, HOLD-REC.
           STRING DR-DSET-NAME DELIMITED BY SPACES,
                  "-" DELIMITED BY SIZE,
                  DR-KEY-ABBREV DELIMITED BY SIZE,
                  "-" DELIMITED BY SIZE,
                  HOLD-ACCESS-MODE DELIMITED BY SIZE
              INTO HOLD-FILE.
           STRING DR-DSET-NAME DELIMITED BY SPACES,
                  "-" DELIMITED BY SIZE,
                  DR-KEY-ABBREV DELIMITED BY SIZE,
                  "-REC-" DELIMITED BY SIZE,
                  HOLD-ACCESS-MODE DELIMITED BY SIZE
              INTO HOLD-REC.

           IF HOLD-CALL-ABBR = "GS"
               PERFORM 8100-DBGET2 THRU 8190-D2-X
           ELSE
           IF HOLD-CALL-ABBR = "GK"
               PERFORM 8300-DBGET7 THRU 8390-D7-X
           ELSE
           IF HOLD-CALL-ABBR = "CH"
               PERFORM 8400-DBFIND THRU 8490-DF-X
           ELSE
           IF HOLD-CALL-ABBR = "GN"
               PERFORM 8200-DBGET5 THRU 8290-D5-X
           ELSE
           IF HOLD-CALL-ABBR = "PT"
               PERFORM 8500-DBPUT THRU 8590-DP-X
           ELSE
           IF HOLD-CALL-ABBR = "UP"
               PERFORM 8600-DBUPDATE THRU 8690-DU-X
           ELSE
           IF HOLD-CALL-ABBR = "DL"
               PERFORM 8700-DBDELETE THRU 8790-DD-X
           ELSE
           IF HOLD-CALL-ABBR = "SL"
               PERFORM 8800-SELECT THRU 8890-S-X
           ELSE
           IF HOLD-CALL-ABBR = "FD"
               PERFORM 8900-FD THRU 8990-F-X
           ELSE
           IF HOLD-CALL-ABBR = "OP"
               PERFORM 8995-OPEN THRU 8998-O-X
           ELSE
           IF HOLD-CALL-ABBR = "CL"
               PERFORM 8999-CLOSE.

           IF HOLD-CALL-ABBR = "OP" OR "SL" OR "FD" OR "CL"
               NEXT SENTENCE
           ELSE
               MOVE SPACES TO COPYLIB-REC
               PERFORM 9200-WRITE-COPYLIB-REC.

           CLOSE COPYLIB-FILE.

       7090-DC-X.
           EXIT.

       8100-DBGET2.
           PERFORM 9060-PARA-NAME.
           PERFORM 9070-ZERO-COND-WORD.
           MOVE SPACES TO COPYLIB-REC, WORK-LINE.
           STRING "READ " DELIMITED BY SIZE,
                  HOLD-FILE DELIMITED BY SPACES,
                  " NEXT INTO " DELIMITED BY SIZE,
                  DR-BUFFNAME DELIMITED BY SPACES,
               INTO WORK-LINE.
           MOVE WORK-LINE TO COPYLIB-AREA-B.
           PERFORM 9200-WRITE-COPYLIB-REC.

           MOVE SPACES TO COPYLIB-REC.
           MOVE "AT END MOVE FILE-STATUS TO FILE-STATUS."
               TO COPYLIB-INDENT-1.
           PERFORM 9200-WRITE-COPYLIB-REC.

           MOVE SPACES TO COPYLIB-REC, WORK-LINE.
           STRING "IF FILE-STATUS-1 = " DELIMITED BY SIZE,
                  QUOTE-CHAR DELIMITED BY SIZE,
                  "1" DELIMITED BY SIZE,
                  QUOTE-CHAR DELIMITED BY SIZE
             INTO WORK-LINE.
           MOVE WORK-LINE TO COPYLIB-AREA-B.
           PERFORM 9200-WRITE-COPYLIB-REC.

           MOVE SPACES TO COPYLIB-REC.
           MOVE "MOVE 11 TO COND-WORD" TO COPYLIB-INDENT-1.
           PERFORM 9200-WRITE-COPYLIB-REC.

           PERFORM 9000-ELSE-B.

           PERFORM 9010-IF-FILE-STATUS-NOT.

           PERFORM 9030-BU-MESSAGE.

      *------ NOW ADD THE 'INIT' CALL SO THE PROGRAM CAN RESET
      *------ THE FILE POINTER TO BEGINNING FOR SERIAL READ
           MOVE SPACES TO COPYLIB-REC.
           PERFORM 9200-WRITE-COPYLIB-REC.
           MOVE "RS" TO HOLD-CALL-ABBR.
           MOVE "BEGFIL" TO HOLD-CALL-TYPE.
           PERFORM 9060-PARA-NAME.
           MOVE SPACES TO WORK-LINE, COPYLIB-REC.
           STRING "MOVE SPACES TO " DELIMITED BY SIZE,
                  DR-KEY-IBM-NAME DELIMITED BY SPACES,
                  " OF " DELIMITED BY SIZE,
                  HOLD-REC DELIMITED BY SPACES,
                  "." DELIMITED BY SIZE
              INTO WORK-LINE.
           MOVE WORK-LINE TO COPYLIB-AREA-B.
           PERFORM 9200-WRITE-COPYLIB-REC.

           MOVE SPACES TO COPYLIB-REC, WORK-LINE.
           STRING "START " DELIMITED BY SIZE,
                  HOLD-FILE DELIMITED BY SPACES,
                  " KEY >= " DELIMITED BY SIZE,
                  DR-KEY-IBM-NAME DELIMITED BY SPACES,
                  " OF " DELIMITED BY SIZE,
                  HOLD-REC DELIMITED BY SPACES
              INTO WORK-LINE.
           MOVE WORK-LINE TO COPYLIB-AREA-B.
           PERFORM 9200-WRITE-COPYLIB-REC.
           MOVE "GS" TO HOLD-CALL-ABBR.

           PERFORM 9050-INVALID-KEY.

       8190-D2-X.
           EXIT.

       8200-DBGET5.
           PERFORM 9060-PARA-NAME.
           PERFORM 9070-ZERO-COND-WORD.

           MOVE SPACES TO COPYLIB-REC, WORK-LINE.
           STRING "READ " DELIMITED BY SIZE,
                  HOLD-FILE DELIMITED BY SPACES
                  " NEXT INTO " DELIMITED BY SIZE,
                  DR-BUFFNAME DELIMITED BY SPACES
               INTO WORK-LINE.
           MOVE WORK-LINE TO COPYLIB-AREA-B.
           PERFORM 9200-WRITE-COPYLIB-REC.

           MOVE SPACES TO COPYLIB-REC.
           MOVE "AT END MOVE FILE-STATUS TO FILE-STATUS."
               TO COPYLIB-INDENT-1.
           PERFORM 9200-WRITE-COPYLIB-REC.

           PERFORM 9010-IF-FILE-STATUS-NOT.

           IF HOLD-ACCESS-MODE = "O"
               MOVE SPACES TO COPYLIB-REC, WORK-LINE
               STRING "IF FILE-STATUS = " DELIMITED BY SIZE,
                      QUOTE-CHAR DELIMITED BY SIZE,
                      "10" DELIMITED BY SIZE,
                      QUOTE-CHAR DELIMITED BY SIZE,
                      " OR " DELIMITED BY SIZE,
                      QUOTE-CHAR DELIMITED BY SIZE,
                      "14" DELIMITED BY SIZE,
                      QUOTE-CHAR DELIMITED BY SIZE,
                  INTO WORK-LINE
               MOVE WORK-LINE TO COPYLIB-INDENT-1
               PERFORM 9200-WRITE-COPYLIB-REC
           ELSE
               MOVE SPACES TO COPYLIB-REC, WORK-LINE
               STRING "IF FILE-STATUS = " DELIMITED BY SIZE,
                      QUOTE-CHAR DELIMITED BY SIZE,
                      "10" DELIMITED BY SIZE,
                      QUOTE-CHAR DELIMITED BY SIZE,
                      " OR " DELIMITED BY SIZE,
                      QUOTE-CHAR DELIMITED BY SIZE,
                      "14" DELIMITED BY SIZE,
                      QUOTE-CHAR DELIMITED BY SIZE,
                      " OR " DELIMITED BY SIZE,
                      QUOTE-CHAR DELIMITED BY SIZE,
                      "46" DELIMITED BY SIZE,
                      QUOTE-CHAR DELIMITED BY SIZE,
                  INTO WORK-LINE
               MOVE WORK-LINE TO COPYLIB-INDENT-1
               PERFORM 9200-WRITE-COPYLIB-REC.

           IF HOLD-ACCESS-MODE = "O"
               MOVE SPACES TO COPYLIB-REC, WORK-LINE
               STRING "PERFORM 9999-RESET-" DELIMITED BY SIZE,
                      HOLD-FILE DELIMITED BY SPACES
                 INTO WORK-LINE
               MOVE WORK-LINE TO COPYLIB-INDENT-2
               PERFORM 9200-WRITE-COPYLIB-REC.

           MOVE SPACES TO COPYLIB-REC.
           MOVE "MOVE 15 TO COND-WORD" TO COPYLIB-INDENT-2.
           PERFORM 9200-WRITE-COPYLIB-REC.

           IF HOLD-ACCESS-MODE = "O"
               MOVE SPACES TO WORK-LINE, COPYLIB-REC
               MOVE "ELSE" TO COPYLIB-INDENT-1
               PERFORM 9200-WRITE-COPYLIB-REC
               MOVE SPACES TO WORK-LINE, COPYLIB-REC
               STRING "IF FILE-STATUS = " DELIMITED BY SIZE,
                      QUOTE-CHAR DELIMITED BY SIZE,
                      "46" DELIMITED BY SIZE,
                      QUOTE-CHAR DELIMITED BY SIZE
                 INTO WORK-LINE
               MOVE WORK-LINE TO COPYLIB-INDENT-1
               PERFORM 9200-WRITE-COPYLIB-REC
               MOVE SPACES TO WORK-LINE, COPYLIB-REC
               MOVE "MOVE 15 TO COND-WORD" TO COPYLIB-INDENT-2
               PERFORM 9200-WRITE-COPYLIB-REC.

           MOVE SPACES TO COPYLIB-REC.
           MOVE "ELSE" TO COPYLIB-INDENT-1.
           PERFORM 9200-WRITE-COPYLIB-REC.

           MOVE SPACES TO COPYLIB-REC, WORK-LINE.
           IF BLOWUP-FLAG = "Y"
               MOVE "MOVE 99 TO COND-WORD" TO COPYLIB-INDENT-2
               PERFORM 9200-WRITE-COPYLIB-REC
               PERFORM 9080-HANDLE-BLOWUP
               MOVE WORK-LINE TO COPYLIB-INDENT-2
               PERFORM 9200-WRITE-COPYLIB-REC
               STRING "MOVE " DELIMITED BY SIZE,
                      QUOTE-CHAR DELIMITED BY SIZE,
                      HOLD-CALL-TYPE DELIMITED BY SPACES,
                      " ERR 9999" DELIMITED BY SIZE,
                      "-" DELIMITED BY SIZE,
                      HOLD-CALL-TYPE DELIMITED BY SPACES,
                      "-" DELIMITED BY SIZE,
                      HOLD-FILE DELIMITED BY SPACES,
                      QUOTE-CHAR DELIMITED BY SIZE
                 INTO WORK-LINE
               MOVE WORK-LINE TO COPYLIB-INDENT-3
               PERFORM 9200-WRITE-COPYLIB-REC
               MOVE SPACES TO COPYLIB-REC
               MOVE "TO BU-MSG-AREA" TO COPYLIB-INDENT-4
               PERFORM 9200-WRITE-COPYLIB-REC
               MOVE SPACES TO COPYLIB-REC
               MOVE "PERFORM 2100-BLOWUP" TO COPYLIB-INDENT-3
               PERFORM 9200-WRITE-COPYLIB-REC
               MOVE SPACES TO COPYLIB-REC
               MOVE "END-IF" TO COPYLIB-INDENT-2
               PERFORM 9200-WRITE-COPYLIB-REC
           ELSE
               MOVE SPACES TO COPYLIB-REC
               MOVE "MOVE 99 TO COND-WORD" TO COPYLIB-INDENT-2
               PERFORM 9200-WRITE-COPYLIB-REC.

           MOVE SPACES TO COPYLIB-REC.
           MOVE "ELSE" TO COPYLIB-AREA-B.
           PERFORM 9200-WRITE-COPYLIB-REC.

           MOVE SPACES TO COPYLIB-REC, WORK-LINE.
           STRING "IF " DELIMITED BY SIZE,
                  DR-KEY-IBM-NAME DELIMITED BY SPACES,
                  " OF " DELIMITED BY SIZE,
                  HOLD-REC DELIMITED BY SPACES,
                  " NOT = " DELIMITED BY SIZE,
                  DR-ARG-NAME DELIMITED BY SPACES
              INTO WORK-LINE.
           MOVE WORK-LINE TO COPYLIB-AREA-B.
           PERFORM 9200-WRITE-COPYLIB-REC.

           IF HOLD-ACCESS-MODE = "O"
               MOVE SPACES TO WORK-LINE, COPYLIB-REC
               STRING "PERFORM 9999-RESET-" DELIMITED BY SIZE,
                      HOLD-FILE DELIMITED BY SPACES,
                  INTO WORK-LINE
               MOVE WORK-LINE TO COPYLIB-INDENT-1
               PERFORM 9200-WRITE-COPYLIB-REC.

           MOVE SPACES TO COPYLIB-REC.
           MOVE "MOVE 15 TO COND-WORD." TO COPYLIB-INDENT-1.
           PERFORM 9200-WRITE-COPYLIB-REC.

           IF HOLD-ACCESS-MODE = "O"
               MOVE SPACES TO COPYLIB-REC
               PERFORM 9200-WRITE-COPYLIB-REC
               MOVE SPACES TO COPYLIB-REC, WORK-LINE
               STRING "9999-RESET-" DELIMITED BY SIZE,
                      HOLD-FILE DELIMITED BY SPACES,
                      "." DELIMITED BY SIZE
                 INTO WORK-LINE
               MOVE WORK-LINE TO COPYLIB-AREA-A
               PERFORM 9200-WRITE-COPYLIB-REC
               MOVE SPACES TO COPYLIB-REC, WORK-LINE
               STRING "MOVE HIGH-VALUES TO " DELIMITED BY SIZE,
                      DR-KEY-IBM-NAME DELIMITED BY SPACES,
                      " OF " DELIMITED BY SIZE,
                      HOLD-REC DELIMITED BY SPACES,
                      "." DELIMITED BY SIZE
               INTO WORK-LINE
               MOVE WORK-LINE TO COPYLIB-AREA-B
               PERFORM 9200-WRITE-COPYLIB-REC
               MOVE SPACES TO COPYLIB-REC, WORK-LINE
               STRING "START " DELIMITED BY SIZE,
                      HOLD-FILE DELIMITED BY SPACES,
                      " KEY > " DELIMITED BY SIZE,
                      DR-KEY-IBM-NAME DELIMITED BY SPACES,
                      " OF " DELIMITED BY SIZE,
                      HOLD-REC DELIMITED BY SPACES
               INTO WORK-LINE
               MOVE WORK-LINE TO COPYLIB-AREA-B
               PERFORM 9200-WRITE-COPYLIB-REC
               MOVE SPACES TO COPYLIB-REC, WORK-LINE
               STRING "INVALID KEY MOVE " DELIMITED BY SIZE,
                      QUOTE-CHAR DELIMITED BY SIZE,
                      "00" DELIMITED BY SIZE,
                      QUOTE-CHAR DELIMITED BY SIZE,
                      " TO FILE-STATUS." DELIMITED BY SIZE
               INTO WORK-LINE
               MOVE WORK-LINE TO COPYLIB-INDENT-1
               PERFORM 9200-WRITE-COPYLIB-REC.

       8290-D5-X.
           EXIT.

       8300-DBGET7.
           PERFORM 9060-PARA-NAME.
           PERFORM 9070-ZERO-COND-WORD.
           PERFORM 9040-MOVE-ARG.

           MOVE SPACES TO COPYLIB-REC, WORK-LINE.
           STRING "READ " DELIMITED BY SIZE,
                  HOLD-FILE DELIMITED BY SPACES,
                  " INTO " DELIMITED BY SIZE,
                  DR-BUFFNAME DELIMITED BY SPACES
              INTO WORK-LINE.
           MOVE WORK-LINE TO COPYLIB-AREA-B.
           PERFORM 9200-WRITE-COPYLIB-REC.

           PERFORM 9050-INVALID-KEY.

           MOVE SPACES TO COPYLIB-REC, WORK-LINE.
           STRING "IF FILE-STATUS = " DELIMITED BY SIZE,
                  QUOTE-CHAR DELIMITED BY SIZE,
                  "23" DELIMITED BY SIZE,
                  QUOTE-CHAR DELIMITED BY SIZE
              INTO WORK-LINE.
           MOVE WORK-LINE TO COPYLIB-AREA-B.
           PERFORM 9200-WRITE-COPYLIB-REC.

           MOVE SPACES TO COPYLIB-REC.
           MOVE "MOVE 17 TO COND-WORD" TO COPYLIB-INDENT-1.
           PERFORM 9200-WRITE-COPYLIB-REC.

           PERFORM 9000-ELSE-B.
           PERFORM 9010-IF-FILE-STATUS-NOT.
           PERFORM 9030-BU-MESSAGE.

           IF HOLD-ACCESS-MODE = "O"
               MOVE SPACES TO COPYLIB-REC
               PERFORM 9200-WRITE-COPYLIB-REC
               MOVE SPACES TO COPYLIB-REC, WORK-LINE
               STRING "9999-RESET-" DELIMITED BY SIZE,
                      HOLD-FILE DELIMITED BY SPACES,
                      "." DELIMITED BY SIZE
                 INTO WORK-LINE
               MOVE WORK-LINE TO COPYLIB-AREA-A
               PERFORM 9200-WRITE-COPYLIB-REC
               MOVE SPACES TO COPYLIB-REC, WORK-LINE
               STRING "MOVE HIGH-VALUES TO " DELIMITED BY SIZE,
                      DR-KEY-IBM-NAME DELIMITED BY SPACES,
                      " OF " DELIMITED BY SIZE,
                      HOLD-REC DELIMITED BY SPACES,
                      "." DELIMITED BY SIZE
               INTO WORK-LINE
               MOVE WORK-LINE TO COPYLIB-AREA-B
               PERFORM 9200-WRITE-COPYLIB-REC
               MOVE SPACES TO COPYLIB-REC, WORK-LINE
               STRING "START " DELIMITED BY SIZE,
                      HOLD-FILE DELIMITED BY SPACES,
                      " KEY > " DELIMITED BY SIZE,
                      DR-KEY-IBM-NAME DELIMITED BY SPACES,
                      " OF " DELIMITED BY SIZE,
                      HOLD-REC DELIMITED BY SPACES
               INTO WORK-LINE
               MOVE WORK-LINE TO COPYLIB-AREA-B
               PERFORM 9200-WRITE-COPYLIB-REC
               MOVE SPACES TO COPYLIB-REC, WORK-LINE
               STRING "INVALID KEY MOVE " DELIMITED BY SIZE,
                      QUOTE-CHAR DELIMITED BY SIZE,
                      "00" DELIMITED BY SIZE,
                      QUOTE-CHAR DELIMITED BY SIZE,
                      " TO FILE-STATUS." DELIMITED BY SIZE
               INTO WORK-LINE
               MOVE WORK-LINE TO COPYLIB-INDENT-1
               PERFORM 9200-WRITE-COPYLIB-REC.

       8390-D7-X.
           EXIT.

       8400-DBFIND.
           PERFORM 9060-PARA-NAME.
           PERFORM 9070-ZERO-COND-WORD.
           PERFORM 9040-MOVE-ARG.

           MOVE SPACES TO COPYLIB-REC, WORK-LINE.
           STRING "START " DELIMITED BY SIZE,
                  HOLD-FILE DELIMITED BY SPACES,
                  " KEY = ", DELIMITED BY SIZE,
                  DR-KEY-IBM-NAME DELIMITED BY SPACES,
                  " OF " DELIMITED BY SIZE,
                  HOLD-REC DELIMITED BY SPACES
              INTO WORK-LINE.
           MOVE WORK-LINE TO COPYLIB-AREA-B.
           PERFORM 9200-WRITE-COPYLIB-REC.

           PERFORM 9050-INVALID-KEY.

           MOVE SPACES TO COPYLIB-REC, WORK-LINE.
           STRING "IF (FILE-STATUS NOT = " DELIMITED BY SIZE,
                  QUOTE-CHAR DELIMITED BY SIZE,
                  "00" DELIMITED BY SIZE,
                  QUOTE-CHAR DELIMITED BY SIZE,
                  ") AND (FILE-STATUS-1 NOT = " DELIMITED BY SIZE,
                  QUOTE-CHAR DELIMITED BY SIZE,
                  "2" DELIMITED BY SIZE,
                  QUOTE-CHAR DELIMITED BY SIZE,
                  ")" DELIMITED BY SIZE
              INTO WORK-LINE.
           MOVE WORK-LINE TO COPYLIB-AREA-B.
           PERFORM 9200-WRITE-COPYLIB-REC.
           PERFORM 9030-BU-MESSAGE.

       8490-DF-X.
           EXIT.

       8500-DBPUT.
           PERFORM 9060-PARA-NAME.
           PERFORM 9070-ZERO-COND-WORD.
           MOVE SPACES TO COPYLIB-REC, WORK-LINE.
           STRING "WRITE " DELIMITED BY SIZE,
                  HOLD-REC DELIMITED BY SPACES,
                  " FROM " DELIMITED BY SIZE,
                  DR-BUFFNAME DELIMITED BY SPACES
              INTO WORK-LINE.
           MOVE WORK-LINE TO COPYLIB-AREA-B.
           PERFORM 9200-WRITE-COPYLIB-REC.
           PERFORM 9050-INVALID-KEY.

           PERFORM 9010-IF-FILE-STATUS-NOT.
           PERFORM 9030-BU-MESSAGE.
       8590-DP-X.
           EXIT.

       8600-DBUPDATE.
           PERFORM 9060-PARA-NAME.
           PERFORM 9070-ZERO-COND-WORD.
           MOVE SPACES TO COPYLIB-REC, WORK-LINE.
           STRING "REWRITE " DELIMITED BY SIZE,
                  HOLD-REC DELIMITED BY SPACES,
                  " FROM " DELIMITED BY SIZE,
                  DR-BUFFNAME DELIMITED BY SPACES
              INTO WORK-LINE.
           MOVE WORK-LINE TO COPYLIB-AREA-B.
           PERFORM 9200-WRITE-COPYLIB-REC.

           PERFORM 9050-INVALID-KEY.
           PERFORM 9010-IF-FILE-STATUS-NOT.
           PERFORM 9030-BU-MESSAGE.
       8690-DU-X.
           EXIT.

       8700-DBDELETE.
           PERFORM 9060-PARA-NAME.
           PERFORM 9070-ZERO-COND-WORD.
           MOVE SPACES TO COPYLIB-REC, WORK-LINE.
           STRING "DELETE " DELIMITED BY SIZE,
                  HOLD-FILE DELIMITED BY SPACES
              INTO WORK-LINE.
           MOVE WORK-LINE TO COPYLIB-AREA-B.
           PERFORM 9200-WRITE-COPYLIB-REC.

           PERFORM 9050-INVALID-KEY.
           PERFORM 9010-IF-FILE-STATUS-NOT.
           PERFORM 9030-BU-MESSAGE.
       8790-DD-X.
           EXIT.

       8800-SELECT.
           MOVE SPACES TO COPYLIB-REC, WORK-LINE.
           STRING "SELECT " DELIMITED BY SIZE,
                  HOLD-FILE DELIMITED BY SPACES
              INTO WORK-LINE.
           MOVE WORK-LINE TO COPYLIB-AREA-B.
           PERFORM 9200-WRITE-COPYLIB-REC.

           MOVE SPACES TO COPYLIB-REC, WORK-LINE.
           STRING "ASSIGN TO DATABASE-MCFL" DELIMITED BY SIZE,
                  DR-BASE DELIMITED BY SIZE,
                  DR-DSET-NUM DELIMITED BY SIZE,
                  DR-KEY-NUM DELIMITED BY SIZE
              INTO WORK-LINE.
           MOVE WORK-LINE TO COPYLIB-INDENT-1.
           PERFORM 9200-WRITE-COPYLIB-REC.

           MOVE SPACES TO COPYLIB-REC.
           MOVE "ORGANIZATION IS INDEXED" TO COPYLIB-INDENT-1.
           PERFORM 9200-WRITE-COPYLIB-REC.

           MOVE SPACES TO COPYLIB-REC.
           MOVE "  ACCESS MODE IS DYNAMIC" TO COPYLIB-INDENT-1.
           PERFORM 9200-WRITE-COPYLIB-REC.

           MOVE SPACES TO COPYLIB-REC.
           MOVE "RECORD KEY IS EXTERNALLY-DESCRIBED-KEY"
             TO COPYLIB-INDENT-1.
           PERFORM 9200-WRITE-COPYLIB-REC.

           IF DR-DSET-1 = "D"
               MOVE SPACES TO COPYLIB-REC
               MOVE "  WITH DUPLICATES" TO COPYLIB-INDENT-1
               PERFORM 9200-WRITE-COPYLIB-REC.

           MOVE SPACES TO COPYLIB-REC.
           MOVE "FILE STATUS IS FILE-STATUS." TO COPYLIB-INDENT-1.
           PERFORM 9200-WRITE-COPYLIB-REC.

           MOVE SPACES TO COPYLIB-REC.
           PERFORM 9200-WRITE-COPYLIB-REC.

       8890-S-X.
           EXIT.

       8900-FD.
           MOVE SPACES TO COPYLIB-REC, WORK-LINE.
           STRING "FD  " DELIMITED BY SIZE,
                  HOLD-FILE DELIMITED BY SPACES
              INTO WORK-LINE.
           MOVE WORK-LINE TO COPYLIB-AREA-A.
           PERFORM 9200-WRITE-COPYLIB-REC.

           MOVE SPACES TO COPYLIB-REC.
           MOVE "LABEL RECORDS ARE STANDARD." TO COPYLIB-AREA-B.
           PERFORM 9200-WRITE-COPYLIB-REC.

           MOVE SPACES TO COPYLIB-REC, WORK-LINE.
           STRING "01  " DELIMITED BY SIZE,
                  HOLD-REC DELIMITED BY SPACES,
                  "." DELIMITED BY SIZE
              INTO WORK-LINE.
           MOVE WORK-LINE TO COPYLIB-AREA-A.
           PERFORM 9200-WRITE-COPYLIB-REC.

           MOVE SPACES TO COPYLIB-REC, WORK-LINE.
           STRING "COPY DDS-MCRP" DELIMITED BY SIZE,
              DR-BASE DELIMITED BY SIZE,
              DR-DSET-NUM DELIMITED BY SIZE,
              "00  OF MCFL" DELIMITED BY SIZE,
              DR-BASE DELIMITED BY SIZE,
              DR-DSET-NUM DELIMITED BY SIZE,
              DR-KEY-NUM DELIMITED BY SIZE,
              "." DELIMITED BY SIZE,
                INTO WORK-LINE.
            MOVE WORK-LINE TO COPYLIB-AREA-B.
            PERFORM 9200-WRITE-COPYLIB-REC.

           MOVE SPACES TO COPYLIB-REC.
           PERFORM 9200-WRITE-COPYLIB-REC.

       8990-F-X.
           EXIT.

       8995-OPEN.
           MOVE SPACES TO COPYLIB-REC, WORK-LINE.
           IF HOLD-ACCESS-MODE = "O"
               STRING "OPEN I-O " DELIMITED BY SIZE,
                      HOLD-FILE DELIMITED BY SPACES,
                      "." DELIMITED BY SIZE
                  INTO WORK-LINE
               MOVE WORK-LINE TO COPYLIB-AREA-B
               PERFORM 9200-WRITE-COPYLIB-REC
           ELSE
               STRING "OPEN INPUT " DELIMITED BY SIZE,
                      HOLD-FILE DELIMITED BY SPACES,
                      "." DELIMITED BY SIZE
                  INTO WORK-LINE
               MOVE WORK-LINE TO COPYLIB-AREA-B
               PERFORM 9200-WRITE-COPYLIB-REC.
       8998-O-X.
           EXIT.

       8999-CLOSE.
           MOVE SPACES TO COPYLIB-REC, WORK-LINE.
           STRING "CLOSE " DELIMITED BY SIZE,
                  HOLD-FILE DELIMITED BY SPACES,
                  "." DELIMITED BY SIZE
              INTO WORK-LINE.
           MOVE WORK-LINE TO COPYLIB-AREA-B.
           PERFORM 9200-WRITE-COPYLIB-REC.

       9000-ELSE-B.
           MOVE SPACES TO COPYLIB-REC.
           MOVE "ELSE" TO COPYLIB-AREA-B.
           PERFORM 9200-WRITE-COPYLIB-REC.

       9010-IF-FILE-STATUS-NOT.
           MOVE SPACES TO COPYLIB-REC, WORK-LINE.
           STRING "IF FILE-STATUS NOT = " DELIMITED BY SIZE,
                  QUOTE-CHAR DELIMITED BY SIZE,
                  "00" DELIMITED BY SIZE,
                  QUOTE-CHAR DELIMITED BY SIZE,
              INTO WORK-LINE.
           MOVE WORK-LINE TO COPYLIB-AREA-B.
           PERFORM 9200-WRITE-COPYLIB-REC.

       9020-MOVE-99.
           IF BLOWUP-FLAG = "Y"
               MOVE SPACES TO COPYLIB-REC
               MOVE "MOVE 99 TO COND-WORD" TO COPYLIB-INDENT-1
               PERFORM 9200-WRITE-COPYLIB-REC
               MOVE SPACES TO COPYLIB-REC
               MOVE "PERFORM 2100-BLOWUP." TO COPYLIB-INDENT-1
               PERFORM 9200-WRITE-COPYLIB-REC
           ELSE
               MOVE SPACES TO COPYLIB-REC
               MOVE "MOVE 99 TO COND-WORD." TO COPYLIB-INDENT-1.

       9030-BU-MESSAGE.
           MOVE SPACES TO COPYLIB-REC, WORK-LINE.
           MOVE "MOVE 99 TO COND-WORD" TO COPYLIB-INDENT-1.
           PERFORM 9200-WRITE-COPYLIB-REC.
           IF BLOWUP-FLAG = "Y"
               PERFORM 9080-HANDLE-BLOWUP
               MOVE WORK-LINE TO COPYLIB-INDENT-1
               PERFORM 9200-WRITE-COPYLIB-REC
               STRING "MOVE " DELIMITED BY SIZE,
                      QUOTE-CHAR DELIMITED BY SIZE,
                      HOLD-CALL-TYPE DELIMITED BY SPACES,
                      " ERR 9999" DELIMITED BY SIZE,
                      "-" DELIMITED BY SIZE,
                      HOLD-CALL-TYPE DELIMITED BY SPACES,
                      "-" DELIMITED BY SIZE,
                      HOLD-FILE DELIMITED BY SPACES,
                      QUOTE-CHAR DELIMITED BY SIZE
                 INTO WORK-LINE
               MOVE WORK-LINE TO COPYLIB-INDENT-2
               PERFORM 9200-WRITE-COPYLIB-REC
               MOVE SPACES TO COPYLIB-REC
               MOVE "TO BU-MSG-AREA" TO COPYLIB-INDENT-3
               PERFORM 9200-WRITE-COPYLIB-REC
               MOVE SPACES TO COPYLIB-REC
               MOVE "PERFORM 2100-BLOWUP." TO COPYLIB-INDENT-2
               PERFORM 9200-WRITE-COPYLIB-REC
           ELSE
               MOVE SPACES TO COPYLIB-REC
               MOVE "MOVE 99 TO COND-WORD." TO COPYLIB-INDENT-1
               PERFORM 9200-WRITE-COPYLIB-REC.

       9040-MOVE-ARG.
           MOVE SPACES TO COPYLIB-REC, WORK-LINE.
           STRING "MOVE " DELIMITED BY SIZE,
                  DR-ARG-NAME DELIMITED BY SPACES,
                  " TO " DELIMITED BY SIZE,
                  DR-KEY-IBM-NAME DELIMITED BY SPACES,
                  " OF " DELIMITED BY SIZE,
                  HOLD-REC DELIMITED BY SPACES,
                  "." DELIMITED BY SIZE
              INTO WORK-LINE.
           MOVE WORK-LINE TO COPYLIB-AREA-B.
           PERFORM 9200-WRITE-COPYLIB-REC.

       9050-INVALID-KEY.
           MOVE SPACES TO COPYLIB-REC.
           MOVE "INVALID KEY MOVE FILE-STATUS TO FILE-STATUS."
             TO COPYLIB-INDENT-1.
           PERFORM 9200-WRITE-COPYLIB-REC.

       9060-PARA-NAME.
           MOVE SPACES TO COPYLIB-REC, WORK-LINE.
           STRING "9999" DELIMITED BY SIZE,
                  "-" DELIMITED BY SIZE,
                  HOLD-CALL-TYPE DELIMITED BY SPACES,
                  "-" DELIMITED BY SIZE,
                  HOLD-FILE DELIMITED BY SPACES
                  "." DELIMITED BY SIZE
              INTO WORK-LINE.
           MOVE WORK-LINE TO COPYLIB-AREA-A.
           PERFORM 9200-WRITE-COPYLIB-REC.

       9070-ZERO-COND-WORD.
           MOVE SPACES TO COPYLIB-REC.
           MOVE "MOVE 0 TO COND-WORD." TO COPYLIB-AREA-B.
           PERFORM 9200-WRITE-COPYLIB-REC.

       9080-HANDLE-BLOWUP.
           MOVE SPACES TO COPYLIB-REC, WORK-LINE.
           STRING "IF HANDLE-BLOWUP-FLAG = " DELIMITED BY SIZE,
                  QUOTE-CHAR DELIMITED BY SIZE,
                  "Y" DELIMITED BY SIZE,
                  QUOTE-CHAR DELIMITED BY SIZE
             INTO WORK-LINE.

       9200-WRITE-COPYLIB-REC.
           ADD 1 TO COPYLIB-CNT.
           MOVE COPYLIB-CNT TO COPYLIB-SEQ-NUMBER-1.
           MOVE "00" TO COPYLIB-SEQ-NUMBER-2.
           MOVE SAVE-DATE TO COPYLIB-DATE.
           WRITE COPYLIB-REC.

