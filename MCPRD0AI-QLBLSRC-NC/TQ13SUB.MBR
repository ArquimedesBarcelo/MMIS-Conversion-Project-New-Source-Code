000200 IDENTIFICATION DIVISION.
000300 PROGRAM-ID. TQ13SUB.
      *C---------------------------------------------------------------
      *C 02/25/93  JSB REQ #6306
      *C      ADDED "PR" AS A NEW WO STATUS FOR PRE-RELEASE.
      *C---------------------------------------------------------------
      *C
      *C 09/13/1996   CA YODER
      *C    RE-COMPILED PROGRAM TO PICK UP CENTURY DATABASE CHANGES.
      *C
000400 ENVIRONMENT DIVISION.
000500 CONFIGURATION SECTION.
000600 SOURCE-COMPUTER.   AS400.
000700 OBJECT-COMPUTER.   AS400.
       SPECIAL-NAMES. I-O-FEEDBACK IS I-O-FEEDBACK-AREA
                      LOCAL-DATA IS LOCAL-DATA-AREA.
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT DISPLAY-FILE
               ASSIGN TO WORKSTATION-ZINQUIRY-SI
               ORGANIZATION IS TRANSACTION
               ACCESS IS SEQUENTIAL
               FILE STATUS IS DSPLY-STATUS
               CONTROL-AREA IS WS-CONTROL.
           SELECT WO-PLANNED-FILE
               ASSIGN TO DATABASE-MCFLMM1102
               ORGANIZATION IS INDEXED
               ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
               FILE STATUS IS WPF-STATUS.
000800 DATA DIVISION.
       FILE SECTION.
       FD  DISPLAY-FILE
           LABEL RECORDS ARE OMITTED.
       01  DSPLY-REC                    PIC X(2000).
       FD  WO-PLANNED-FILE
           LABEL RECORDS ARE STANDARD
           DATA RECORD IS WPFREC.
       01  WPFREC.
           COPY DDS-ALL-FORMATS OF MCFLMM1102.
000900 WORKING-STORAGE SECTION.
001100 77  SUB                             PIC S9(4) COMP.
001200 77  SUB1                            PIC S9(4) COMP.
       COPY CPYIND  IN COPYLIB.
       01  DSPLY-STATUS                    PIC XX.
001300 01  ERROR-BUFFER                    PIC X(80).
001400 01  INPUT-AREA.
001500     05  INPUT-STATUS                PIC XX.
001600     05  INPUT-REQUESTER             PIC X(16).
001700     05  INPUT-EQUIP                 PIC X(6).
001800     05  INPUT-PLNR                  PIC X(4).
001900     05  INPUT-ENGR                  PIC X(4).
002000     05  INPUT-SCHD                  PIC X(4).
           05  INPUT-CMD-LINE              PIC X(79).
           05  INPUT-ERR-LINE              PIC X(79).
       COPY IOFEEDBACK IN COPYLIB.
002100 01  SCREEN-OUTPUT.
002200     05  SCREEN-LINES.
002300         10  SLINE OCCURS 20 TIMES.
                   15  FILLER              PIC X.
                   15  SLINE-WO            PIC X(10).
                   15  FILLER              PIC XX.
                   15  SLINE-DESC          PIC X(30).
                   15  FILLER              PIC X(36).
002400     05  SCREEN-INFOLINE             PIC X(79).
           05  SCREEN-CMD-LINE             PIC X(79).
           05  SCREEN-ERR-LINE             PIC X(79).
       COPY DBSTAT OF COPYLIB.
002600 01  STATUS-TABLE.
002700     05  S-TABLE.
002800         10  FILLER                  PIC XX VALUE "HA".
002900         10  FILLER                  PIC XX VALUE "OO".
003000         10  FILLER                  PIC XX VALUE "IP".
003100         10  FILLER                  PIC XX VALUE "HM".
003200         10  FILLER                  PIC XX VALUE "HS".
003300         10  FILLER                  PIC XX VALUE "SD".
               10  FILLER                  PIC XX VALUE "PR".
003400     05  STATUS-TAB REDEFINES S-TABLE.
003500         10  STAB OCCURS 7 TIMES.
003600             15  STATUS-ENTRY            PIC XX.
003700 01  WO-PLANNED-DATA.       COPY DWOPLAN OF COPYLIB.
003800 01  WO-TABLE.
003900     05  WO-TAB OCCURS 2000  TIMES.
               10  WOTAB                   PIC X(10).
               10  WODESC                  PIC X(30).
       01  WPF-STATUS                      PIC XX.
       COPY WSCONTROL IN COPYLIB.
004000 LINKAGE SECTION.
004700 01  DBPARAMETERS.          COPY DBPARMS OF COPYLIB.
       COPY VCOMLINK OF COPYLIB.
       COPY CATREAD  OF COPYLIB.
005000 PROCEDURE DIVISION USING DBPARAMETERS VIEW-COMAREA
005100                      CATREAD-PARMS.
005200 START-PGM.
005300     PERFORM 1-HSK.
005400     PERFORM 6-MAIN THRU 6-MAIN-EXIT.
005500 2-EOJ.
           CLOSE DISPLAY-FILE.
           CLOSE WO-PLANNED-FILE.
005600     GOBACK.
005700 1-HSK.
           OPEN I-O   DISPLAY-FILE.
           OPEN INPUT WO-PLANNED-FILE.
005800     MOVE SPACES TO WO-TABLE SCREEN-OUTPUT INPUT-AREA.
005900     MOVE 0 TO SUB SUB1.
007300 6-MAIN.
006200     MOVE "FQ13INQ" TO VIEW-CFNAME.
           MOVE INPUT-AREA TO DSPLY-REC.
           PERFORM 99-SCREEN-WRITE.
           PERFORM 98-SCREEN-READ.
           MOVE SPACES TO ERROR-BUFFER.
           MOVE DSPLY-REC TO INPUT-AREA.
007500     IF VIEW-LASTKEY = 3 GO TO 2-EOJ.
007900     IF INPUT-STATUS NOT = "  "
008000         MOVE INPUT-STATUS TO STATUS-ENTRY (7)
008100         MOVE 6 TO SUB.
008400     PERFORM 61-READ-STATUS-CHAINS THRU 61-RSC-EXIT.
008500     MOVE 0 TO SUB SUB1.
008600     PERFORM 62-DISPLAY-OR-PRINT THRU 62-DOP-EXIT.
008700 6-MAIN-EXIT.    EXIT.
008800 61-READ-STATUS-CHAINS.
008900     ADD 1 TO SUB.
009000     IF SUB > 7 GO TO 61-RSC-EXIT.
009100     MOVE 0 TO COND-WORD.
009200     MOVE STATUS-ENTRY (SUB) TO WOSTATUS OF WPFREC.
           START WO-PLANNED-FILE KEY IS = EXTERNALLY-DESCRIBED-KEY
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF WPF-STATUS NOT = "00" MOVE 17 TO COND-WORD.
009300     IF COND-WORD = 17 GO TO 61-READ-STATUS-CHAINS.
009700 61-RSC-LOOP.
009800     READ WO-PLANNED-FILE NEXT INTO WO-PLANNED-DATA
009900         AT END    MOVE 17 TO COND-WORD.
           IF STATUS-ENTRY (SUB) NOT = WO-STATUS-P
               MOVE 17 TO COND-WORD.
           IF WPF-STATUS NOT = "00" MOVE 17 TO COND-WORD.
010000     IF COND-WORD = 17 GO TO 61-READ-STATUS-CHAINS.
010500     IF APPROVAL-CODE-P = "A " GO TO 61-RSC-LOOP.
010600     IF INPUT-REQUESTER = REQUESTER-P OR SPACES
010700         IF INPUT-EQUIP = EQUIP-NUM-P OR SPACES
010800             IF INPUT-PLNR = PLANNER OR SPACES
010900                 IF INPUT-ENGR = ENGINEER OR SPACES
011000                     IF INPUT-SCHD = SCHEDULER OR SPACES
011100                        ADD 1 TO SUB1
                              IF SUB1 > 2000
                                  GO TO 61-RSC-EXIT
                              ELSE
011200                        MOVE WO-NUM-PLANNED  TO WOTAB (SUB1)
                              MOVE DESCRIPTION-1-P TO WODESC (SUB1).
011300     GO TO 61-RSC-LOOP.
011400 61-RSC-EXIT.    EXIT.
011500 62-DISPLAY-OR-PRINT.
011800     ADD 1 TO SUB.
011900     IF SUB > 20
               MOVE "FQ13INQ2" TO VIEW-CFNAME
012000         MOVE 66125 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE ERROR-BUFFER TO SCREEN-INFOLINE
               MOVE SCREEN-OUTPUT TO DSPLY-REC
               PERFORM 99-SCREEN-WRITE
               PERFORM 98-SCREEN-READ
012700         IF VIEW-LASTKEY = 3
012800             GO TO 2-EOJ
012900         ELSE
013000         IF VIEW-LASTKEY = 1
013100             MOVE 1 TO SUB
013200             MOVE SPACES TO SCREEN-OUTPUT.
013400     ADD 1 TO SUB1.
           IF WO-TAB (SUB1) = SPACES
               MOVE "FQ13INQ2" TO VIEW-CFNAME
               MOVE 66122 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE ERROR-BUFFER TO SCREEN-INFOLINE
               MOVE SCREEN-OUTPUT TO DSPLY-REC
               PERFORM 99-SCREEN-WRITE
               PERFORM 98-SCREEN-READ
               GO TO 2-EOJ.
           MOVE SPACES TO SLINE (SUB).
013500     MOVE WOTAB (SUB1)   TO SLINE-WO (SUB).
           MOVE WODESC (SUB1)  TO SLINE-DESC (SUB).
013600     GO TO 62-DISPLAY-OR-PRINT.
013700 62-DOP-EXIT.    EXIT.
013800
       98-SCREEN-READ.
           READ DISPLAY-FILE FORMAT IS VIEW-CFNAME
               INDIC IS INDICS.
           ACCEPT IOFEEDBACK FROM I-O-FEEDBACK-AREA.
           MOVE ALL B"0" TO INDICS.
           IF DSPLY-STATUS NOT = "00"
               MOVE 3 TO VIEW-LASTKEY
           ELSE
           MOVE FUNCTION-NUM TO VIEW-LASTKEY.

       99-SCREEN-WRITE.
           WRITE DSPLY-REC FORMAT IS VIEW-CFNAME
               INDIC IS INDICS.
           MOVE ALL B"0" TO INDICS.

013900 999-CATREAD.
014000     MOVE SPACES TO ERROR-BUFFER.
014100     CALL "CCATREAD" USING CATREAD-PARMS.
           MOVE CATREAD-MSG-TEXT TO ERROR-BUFFER.
014400 999-CATREAD-EXIT.
014500     EXIT.
