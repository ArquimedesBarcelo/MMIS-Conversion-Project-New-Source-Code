       IDENTIFICATION DIVISION.
       PROGRAM-ID.           TUPDACCG.
       AUTHOR.               ANNETTE TREUDLER.
       DATE-WRITTEN.         DEC 1987.
       INSTALLATION.         GOODYEAR TIRE AND RUBBER CO.
      *D* REMARKS.           THIS PROGRAM WILL ADD CLASS CODES TO
      *D*                    MCLASS DATA SET, REPORT CODES TO MREPORT
      *D*                    DATA SET, AND LEDGER CODES TO MLEDGER
      *D*                    DATA SET IN THE CSACCT DATA BASE.
      *C* CHANGES.
      *C* SEPT 8, 1992  CR KALMAN   REQ NUMBER:
      *C* TOOK OUT MAINTENANCE OF CLASS.  CAN NO LONGER ADD/CHANGE
      *C* CLASS THRU THIS PROGRAM. DELETED ALL CODE FROM THIS PROGRAM
      *C* DEALING WITH MCLASS MODIFICATIONS.  ALSO DELETED OR CHANGED
      *C* NECESSARY SCREENS.  CLASS MAINTENANCE WILL BE HANDLED FROM
      *C* MP4 FROM NOW ON.
      *C
      *C   06SEP1996    DAVE PLUM
      *C     RECOMPILED PROGRAM FOR CENTURY DATABASE CHANGES.
      *C     ALSO CORRECTED AN ERROR WITH THE SELECT STATEMENT FOR
      *C     DTRANS.  LOGICAL FILE 0703 WAS NAMED IN THE SELECT
      *C     STATEMENT, WHEN THE DESIRED FILE WAS 0702 (BY DEPT).
      *C     THE FD DID NOT NEED TO BE REVISED.  IT WAS CORRECT.
      *C     AN ADDITIONAL CORRECTION WAS MADE TO THE DELETE MLEDGER
      *C     LOGIC TO PREVENT THE PROGRAM FROM BLOWING UP WHEN
      *C     TRYING TO DELETE A LEDGER CODE.
      *C
       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.
       SOURCE-COMPUTER.      IBM-AS400.
       OBJECT-COMPUTER.      IBM-AS400.
       SPECIAL-NAMES.        I-O-FEEDBACK IS I-O-FEEDBACK-AREA.

       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT DISPLAY-FILE
                  ASSIGN TO WORKSTATION-ZUPDACCG-SI
                  ORGANIZATION IS TRANSACTION
                  ACCESS IS SEQUENTIAL
                  FILE STATUS IS DISPLAY-STATUS
                  CONTROL-AREA IS WS-CONTROL.

           SELECT MREPORT-I
                  ASSIGN TO DATABASE-MCFLCA0401
                  ORGANIZATION IS INDEXED
                    ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                  FILE STATUS IS FILE-STATUS.

           SELECT MCHTACCTS-I
                  ASSIGN TO DATABASE-MCFLCA0301
                  ORGANIZATION IS INDEXED
                    ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                  FILE STATUS IS FILE-STATUS.

           SELECT MLEDGER-I
                  ASSIGN TO DATABASE-MCFLCA0501
                  ORGANIZATION IS INDEXED
                    ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                  FILE STATUS IS FILE-STATUS.

           SELECT DTRANS-I
                  ASSIGN TO DATABASE-MCFLCA0702
                  ORGANIZATION IS INDEXED
                    ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                    WITH DUPLICATES
                  FILE STATUS IS FILE-STATUS.

           SELECT MREPORT-O
                  ASSIGN TO DATABASE-MCFLCA0401
                  ORGANIZATION IS INDEXED
                    ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                  FILE STATUS IS FILE-STATUS.

           SELECT MCHTACCTS-O
                  ASSIGN TO DATABASE-MCFLCA0301
                  ORGANIZATION IS INDEXED
                    ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                  FILE STATUS IS FILE-STATUS.

           SELECT MLEDGER-O
                  ASSIGN TO DATABASE-MCFLCA0501
                  ORGANIZATION IS INDEXED
                    ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                  FILE STATUS IS FILE-STATUS.

       DATA DIVISION.
       FILE SECTION.
       FD  DISPLAY-FILE
           LABEL RECORDS ARE OMITTED.
       01  DISPLAY-REC           PIC X(2000).

       FD  MREPORT-I
           LABEL RECORDS ARE STANDARD.
       01  MREPORT-REC-I.
           COPY DDS-ALL-FORMATS OF MCFLCA0401.

       FD  MCHTACCTS-I
           LABEL RECORDS ARE STANDARD.
       01  MCHTACCTS-REC-I.
           COPY DDS-ALL-FORMATS OF MCFLCA0301.

       FD  MLEDGER-I
           LABEL RECORDS ARE STANDARD.
       01  MLEDGER-REC-I.
           COPY DDS-ALL-FORMATS OF MCFLCA0501.

       FD  DTRANS-I
           LABEL RECORDS ARE STANDARD.
       01  DTRANS-REC-I.
           COPY DDS-ALL-FORMATS OF MCFLCA0702.

       FD  MREPORT-O
           LABEL RECORDS ARE STANDARD.
       01  MREPORT-REC-O.
           COPY DDS-ALL-FORMATS OF MCFLCA0401.

       FD  MCHTACCTS-O
           LABEL RECORDS ARE STANDARD.
       01  MCHTACCTS-REC-O.
           COPY DDS-ALL-FORMATS OF MCFLCA0301.

       FD  MLEDGER-O
           LABEL RECORDS ARE STANDARD.
       01  MLEDGER-REC-O.
           COPY DDS-ALL-FORMATS OF MCFLCA0501.

       WORKING-STORAGE SECTION.
       01  FILE-STATUS.
           05  FILE-STATUS-1   PIC X VALUE SPACES.
           05  FILE-STATUS-2   PIC X VALUE SPACES.
      ***************************************************************
      ***************************************************************
      **                                                           **
      **               D A T A    B A S E   A R E A                **
      **                                                           **
      ***************************************************************
      ***************************************************************

       COPY DBCSACCT   IN COPYLIB.

       COPY DATAB      IN COPYLIB.

       COPY MREPORT    IN COPYLIB.

       COPY MLEDGER    IN COPYLIB.

       COPY MCHTACCT   IN COPYLIB.

       01  DATASET-NAMES.
           05  DSET-MREPORT     PIC X(16)  VALUE "MREPORT;".
           05  DSET-MLEDGER     PIC X(16)  VALUE "MLEDGER;".
           05  DSET-MCHTACCTS  PIC X(16)  VALUE "MCHT-ACCTS;".
           05  DSET-NAME        PIC X(16)  VALUE SPACES.

       01  ITEMS-LISTING.
           05  ALL-ITEMS        PIC X(2)   VALUE "@;".

       01  IMAGE-ARGS.
           05  LEDGER-ARG.
               10  LDG-ARG-IN   PIC X(2)   VALUE SPACES.
               10  FILLER       PIC X(2)   VALUE SPACES.
           05  VOUCHER-ARG      PIC X(2)   VALUE SPACES.
           05  DEPT-ARG         PIC X(6)   VALUE SPACES.

       01  LOCK-DSET                     PIC X(16)  VALUE SPACES.

       COPY VCOMAREA   IN COPYLIB.

      *************************************************************
      **    PARAMETER AREA FOR DISPLAY FILE                      **
      *************************************************************
       COPY DISPDATA   IN COPYLIB.
       01  COMMAND-AREA.
           05  OVERRIDE-ZUPDACCG      PIC X(34) VALUE
               "OVRDSPF FILE(ZUPDACCG) SHARE(*YES)".
           05  OVERRIDE-PARM2         PIC S9(10)V9(5) COMP-3 VALUE 34.
       COPY IOFEEDBACK IN COPYLIB.

       01  FORMFILE.
           05  FORM-FNAME                PIC X(8)  VALUE "FUPDACCG".
           05  FILLER                    PIC X(1)  VALUE ".".
           05  FORM-GNAME.
               10  FORM-GNAME1           PIC X(5)  VALUE "FLANG".
               10  FORM-GNAME2           PIC X(3)  VALUE SPACES.
           05  FILLER                    PIC X(19) VALUE SPACES.

       01  MESSAGE-BUFFER.
           05  MSG-TEXT                  PIC X(64)  VALUE SPACE.
           05  MSG-FLD                   PIC X(12)  VALUE SPACE.
           05  MSG-FLD-9 REDEFINES MSG-FLD   PIC Z(11)9.

       01  MESSAGE-BUFLEN                PIC S9(4)  VALUE 76 COMP-4.
       01  MESSAGE-ACTLEN                PIC S9(4)  VALUE ZERO COMP-4.
       01  FIELD-NUMBER                  PIC S9(4)  VALUE 1  COMP-4.

      ***************************************************************
      ***************************************************************
      **                                                           **
      **               TERMINAL I/O DATA AREA                      **
      **                                                           **
      ***************************************************************
      ***************************************************************

       01  ACCG-HDR-BUFFER.
           05  DEPT-SELECT               PIC X.
           05  LEDGER-SELECT             PIC X.
           05  VOUCHER-SELECT            PIC X.
           05  AH-CMDLINE                PIC X(79).
           05  AH-MSGLINE                PIC X(79).

       01  ADD-DEPT-BUFFER.
           05  ADD-DEPT-CODE             PIC X(6).
           05  ADD-DEPT-LEDGER.
               10  ADD-DEPT-LEDG         PIC XX.
               10  ADD-DEPT-DIV          PIC XX.
           05  ADD-DEPT-DESCR            PIC X(56).
           05  ADD-DEPT-BC               PIC X(4).
           05  ADD-DEPT-TYPE             PIC XX.
           05  ADD-DEPT-MSGLINE          PIC X(79).
           05  AD-CMDLINE                PIC X(79).
           05  AD-MSGLINE                PIC X(79).

       01  ADD-LEDGER-BUFFER.
           05  ADD-LEDGER-CODE           PIC X(2).
           05  ADD-LEDGER-DESCR          PIC X(60).
           05  ADD-LEDGER-MSGLINE        PIC X(79).
           05  AL-CMDLINE                PIC X(79).
           05  AL-MSGLINE                PIC X(79).

       01  ADD-VOUCHER-BUFFER.
           05  ADD-VOUCHER-CODE          PIC X(2).
           05  ADD-VOUCHER-DESCR         PIC X(60).
           05  ADD-VOUCHER-MSGLINE       PIC X(79).
           05  AV-CMDLINE                PIC X(79).
           05  AV-MSGLINE                PIC X(79).

       01  CHG-DEPT-BUFFER.
           05  CHG-DEPT-CODE             PIC X(6).
           05  CHG-DEPT-LEDGER.
               10  CHG-DEPT-LEDG         PIC XX.
               10  CHG-DEPT-DIV          PIC XX.
           05  CHG-DEPT-DESCR            PIC X(56).
           05  CHG-DEPT-BC               PIC X(4).
           05  CHG-DEPT-TYPE             PIC XX.
           05  CHG-DEPT-MSGLINE          PIC X(79).
           05  CD-CMDLINE                PIC X(79).
           05  CD-MSGLINE                PIC X(79).

       01  CHG-LEDGER-BUFFER.
           05  CHG-LEDGER-CODE           PIC X(2).
           05  CHG-LEDGER-DESCR          PIC X(60).
           05  CHG-LEDGER-MSGLINE        PIC X(79).
           05  CL-CMDLINE                PIC X(79).
           05  CL-MSGLINE                PIC X(79).

       01  CHG-VOUCHER-BUFFER.
           05  CHG-VOUCHER-CODE          PIC XX.
           05  CHG-VOUCHER-DESCR         PIC X(60).
           05  CHG-VOUCHER-MSGLINE       PIC X(79).
           05  CV-CMDLINE                PIC X(79).
           05  CV-MSGLINE                PIC X(79).

      ***************************************************************
      ***************************************************************
      **                  COMMUNICATIONS AREAS                     **
      ***************************************************************
      ***************************************************************

       COPY TBLOWUP    IN COPYLIB.

       COPY LANGUAGE   IN COPYLIB.

       COPY CATREAD    IN COPYLIB.
      ***************************************************************
      **###########################################################**
      ***************************************************************
      **                                                           **
      **           P R O C E D U R E    D I V I S I O N            **
      **                                                           **
      ***************************************************************
      **###########################################################**
      ***************************************************************

       PROCEDURE DIVISION.

       001-BEGIN SECTION.

       010-MAINLINE.
           PERFORM 100-HSK              THRU 100-HSK-X.
           PERFORM 600-MAIN             THRU 600-MAIN-X.
           PERFORM 200-EOJ              THRU 200-EOJ-X.
           GOBACK.

       100-HSK.
           MOVE "TUPDACCG"              TO BU-PGM-NAME.
           CALL "QCMDEXC" USING OVERRIDE-ZUPDACCG, OVERRIDE-PARM2.
           OPEN I-O DISPLAY-FILE.
           OPEN INPUT MREPORT-I, MLEDGER-I, MCHTACCTS-I,
                      DTRANS-I.
           OPEN I-O   MREPORT-O, MLEDGER-O, MCHTACCTS-O.

       100-HSK-X.
           EXIT.

       200-EOJ.
           CLOSE DISPLAY-FILE.
           CLOSE MREPORT-I, MLEDGER-I, MCHTACCTS-I,
                 DTRANS-I.
           CLOSE MREPORT-O, MLEDGER-O, MCHTACCTS-O.

       200-EOJ-X.
            EXIT.

      ******************************************************
      **                 BLOWUP ROUTINE                   **
      ******************************************************

       200-BLOWUP.
           CALL "TBLOWUP" USING ACCTG-BASE, BU-PGM-NAME, STATUS-AREA,
                 VIEW-COMAREA, FILE-STATUS, BU-DISPLAY-MSG,
                 BU-DISPLAY-AREA.

      **************************************************
      *                                                *
      *                  6 - M A I N                   *
      *                                                *
      **************************************************

       600-MAIN.
           MOVE "ACCHDR"                TO VIEW-NFNAME.

       600-PUT-BUFFER.
           MOVE SPACES                  TO ACCG-HDR-BUFFER.

       600-SHOW-FORM.
           MOVE ACCG-HDR-BUFFER         TO  DISPLAY-REC.
           PERFORM 998-WRITE-SCREEN THRU 998-READ-SCREEN.
           MOVE DISPLAY-REC             TO  ACCG-HDR-BUFFER.

           IF VIEW-LASTKEY = 3
               GO TO 600-MAIN-X.

           IF VIEW-LASTKEY = 1 OR
              VIEW-LASTKEY = 2 OR
              VIEW-LASTKEY = 4 OR
              VIEW-LASTKEY = 5 OR
              VIEW-LASTKEY = 6 OR
              VIEW-LASTKEY = 7 OR
              VIEW-LASTKEY = 8
      ****     INVALID FUNCTION KEY
               MOVE   9 TO LANG-SETNUM
               MOVE  10 TO LANG-MSGNUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER  TO  AH-MSGLINE
               MOVE B"1"            TO  IND(99)
               GO TO 600-SHOW-FORM.

       600-GET-BUFFER.
           IF DEPT-SELECT    = "A"
               PERFORM 630-ADD-DEPT       THRU 630-ADD-DEPT-X
           ELSE
           IF DEPT-SELECT    = "C"
               PERFORM 640-CHG-DEPT       THRU 640-CHG-DEPT-X
           ELSE
           IF LEDGER-SELECT  = "A"
               PERFORM 650-ADD-LEDGER     THRU 650-ADD-LEDGER-X
           ELSE
           IF LEDGER-SELECT  = "C"
               PERFORM 660-CHG-LEDGER     THRU 660-CHG-LEDGER-X
           ELSE
           IF VOUCHER-SELECT = "A"
               PERFORM 670-ADD-VOUCHER    THRU 670-ADD-VOUCHER-X
           ELSE
           IF VOUCHER-SELECT = "C"
               PERFORM 680-CHG-VOUCHER    THRU 680-CHG-VOUCHER-X.

           GO TO 600-MAIN.

       600-MAIN-X.
           EXIT.

      ***************************************************************
      **                     630-ADD-DEPT                         **
      ***************************************************************

       630-ADD-DEPT.
           MOVE "ADDDEPT"                TO VIEW-NFNAME.

       630-PUT-BUFFER.
           MOVE SPACES                   TO ADD-DEPT-BUFFER.
      ****   INPUT DATA ABOVE AND THEN PRESS 'ENTER'
           MOVE   9                      TO LANG-SETNUM.
           MOVE  20                      TO LANG-MSGNUM.
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
           MOVE MESSAGE-BUFFER           TO ADD-DEPT-MSGLINE.

       630-SHOW-FORM.
           MOVE ADD-DEPT-BUFFER          TO  DISPLAY-REC.
           PERFORM 998-WRITE-SCREEN THRU 998-READ-SCREEN.
           MOVE DISPLAY-REC              TO  ADD-DEPT-BUFFER.

           IF VIEW-LASTKEY = 3
               GO TO 630-ADD-DEPT-X.

           IF VIEW-LASTKEY = 1 OR
              VIEW-LASTKEY = 2 OR
              VIEW-LASTKEY = 4 OR
              VIEW-LASTKEY = 5 OR
              VIEW-LASTKEY = 6 OR
              VIEW-LASTKEY = 7 OR
              VIEW-LASTKEY = 8
      ****     INVALID FUNCTION KEY
               MOVE   9 TO LANG-SETNUM
               MOVE  10 TO LANG-MSGNUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER  TO  AD-MSGLINE
               PERFORM 900-PGM-ERROR THRU 900-PGM-ERROR-X
               GO TO 630-SHOW-FORM.

       630-FIELD-EDITS.
            IF ADD-DEPT-CODE = SPACES
               MOVE  6     TO FIELD-NUMBER
      ****     DEPARTMENT NUMBER IS REQUIRED
               MOVE  66264 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER  TO  AD-MSGLINE
               PERFORM 900-PGM-ERROR THRU 900-PGM-ERROR-X
               GO TO 630-SHOW-FORM.
            IF ADD-DEPT-LEDGER = SPACES
               MOVE  7     TO FIELD-NUMBER
      ****     LEDGER IS REQUIRED
               MOVE  66338 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER  TO  AD-MSGLINE
               PERFORM 900-PGM-ERROR THRU 900-PGM-ERROR-X
               GO TO 630-SHOW-FORM.
            IF ADD-DEPT-DESCR = SPACES
               MOVE  3     TO FIELD-NUMBER
      ****     DESCRIPTION IS REQUIRED
               MOVE  66337 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER  TO  AD-MSGLINE
               PERFORM 900-PGM-ERROR THRU 900-PGM-ERROR-X
               GO TO 630-SHOW-FORM.
            IF ADD-DEPT-TYPE = SPACES
               MOVE  4     TO FIELD-NUMBER
      ****     DEPARTMENT TYPE IS REQUIRED
               MOVE  66339 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER  TO  AD-MSGLINE
               PERFORM 900-PGM-ERROR THRU 900-PGM-ERROR-X
               GO TO 630-SHOW-FORM.

       630-GET-BUFFER.
           MOVE ADD-DEPT-CODE          TO DEPT-ARG.
           PERFORM 900-GET-MCHTACCTS.
           IF NOT NO-ENTRY
      ****   DEPARTMENT ALREADY EXISTS - CANNOT ADD
               MOVE   4 TO LANG-SETNUM
               MOVE  22 TO LANG-MSGNUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER       TO AD-MSGLINE
               MOVE   6                  TO FIELD-NUMBER
               PERFORM 900-PGM-ERROR THRU 900-PGM-ERROR-X
               GO TO 630-SHOW-FORM.

           MOVE ADD-DEPT-LEDG   TO LDG-ARG-IN.
           PERFORM 900-GET-MLEDGER.
           IF NOT GOOD-CALL
      ***  INVALID LEDGER NUMBER
               MOVE   9 TO LANG-SETNUM
               MOVE  39 TO LANG-MSGNUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER       TO AD-MSGLINE
               MOVE   7                  TO FIELD-NUMBER
               PERFORM 900-PGM-ERROR THRU 900-PGM-ERROR-X
               GO TO 630-SHOW-FORM.

           MOVE SPACES                   TO BUF-MCHTACCTS.
           MOVE ADD-DEPT-CODE            TO MCHT-DEPT.
           MOVE ADD-DEPT-LEDGER          TO MCHT-LEDGERT.
           MOVE ADD-DEPT-DESCR           TO MCHT-DESC.
           MOVE ADD-DEPT-TYPE            TO MCHT-DEPT-TYPE.
           MOVE ADD-DEPT-BC              TO MCHT-BC.
           PERFORM 900-PUT-MCHTACCTS.
           PERFORM 900-UNLOCK-MCHTACCTS.
           GO TO 630-ADD-DEPT.

       630-ADD-DEPT-X.
           EXIT.

      ***************************************************************
      **                     640-CHANGE-DEPT                      **
      ***************************************************************

       640-CHG-DEPT.
           MOVE "CHGDEPT"                TO VIEW-NFNAME.

       640-PUT-BUFFER.
           MOVE SPACES                   TO CHG-DEPT-BUFFER.
      ****   INPUT DATA ABOVE AND THEN PRESS 'ENTER'
           MOVE   9                      TO LANG-SETNUM.
           MOVE  20                      TO LANG-MSGNUM.
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
           MOVE MESSAGE-BUFFER           TO CHG-DEPT-MSGLINE.

       640-SHOW-FORM.
           MOVE CHG-DEPT-BUFFER          TO  DISPLAY-REC.
           PERFORM 998-WRITE-SCREEN THRU 998-READ-SCREEN.
           MOVE DISPLAY-REC              TO  CHG-DEPT-BUFFER.

           IF VIEW-LASTKEY = 3
               GO TO 640-CHG-DEPT-X.

           IF VIEW-LASTKEY = 1 OR
              VIEW-LASTKEY = 2 OR
              VIEW-LASTKEY = 4 OR
              VIEW-LASTKEY = 5 OR
              VIEW-LASTKEY = 6 OR
              VIEW-LASTKEY = 7 OR
              VIEW-LASTKEY = 8
      ****     INVALID FUNCTION KEY
               MOVE   9 TO LANG-SETNUM
               MOVE  10 TO LANG-MSGNUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER  TO  CD-MSGLINE
               MOVE B"1"            TO  IND(99)
               GO TO 640-SHOW-FORM.

       640-FIELD-EDITS.
           IF CHG-DEPT-CODE = SPACES
               MOVE  2     TO FIELD-NUMBER
      ****     DEPARTMENT IS REQUIRED
               MOVE  66264 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER  TO  CD-MSGLINE
               PERFORM 900-PGM-ERROR THRU 900-PGM-ERROR-X
               GO TO 640-SHOW-FORM.

       640-GET-BUFFER.
           MOVE CHG-DEPT-CODE            TO DEPT-ARG.
           PERFORM 900-GET-MCHTACCTS.
           IF NOT GOOD-CALL
      ****   DEPARTMENT DOES NOT EXIST - CANNOT MODIFY OR DELETE
               MOVE   4 TO LANG-SETNUM
               MOVE  23 TO LANG-MSGNUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER       TO CD-MSGLINE
               MOVE   2                  TO FIELD-NUMBER
               PERFORM 900-PGM-ERROR THRU 900-PGM-ERROR-X
               GO TO 640-SHOW-FORM.

           MOVE MCHT-LEDGERT             TO CHG-DEPT-LEDGER.
           MOVE MCHT-DESC                TO CHG-DEPT-DESCR.
           MOVE MCHT-DEPT-TYPE           TO CHG-DEPT-TYPE.
           MOVE MCHT-BC                  TO CHG-DEPT-BC.

           MOVE "CHGDEPT2"               TO VIEW-NFNAME.
      ****   PRESS 'ENTER' TO PROCESS OR 'f2' TO DELETE
           MOVE  16                      TO LANG-SETNUM.
           MOVE 126                      TO LANG-MSGNUM.
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
           MOVE MESSAGE-BUFFER           TO CHG-DEPT-MSGLINE.

       641-SHOW-FORM.
           MOVE CHG-DEPT-BUFFER          TO  DISPLAY-REC.
           PERFORM 998-WRITE-SCREEN THRU 998-READ-SCREEN.
           MOVE DISPLAY-REC              TO  CHG-DEPT-BUFFER.

           IF VIEW-LASTKEY = 3
               GO TO 640-CHG-DEPT-X.

           IF VIEW-LASTKEY = 2
               GO TO 642-DELETE-DEPT.

           IF VIEW-LASTKEY = 1 OR
              VIEW-LASTKEY = 4 OR
              VIEW-LASTKEY = 5 OR
              VIEW-LASTKEY = 6 OR
              VIEW-LASTKEY = 7 OR
              VIEW-LASTKEY = 8
      ****     INVALID FUNCTION KEY
               MOVE   9 TO LANG-SETNUM
               MOVE  10 TO LANG-MSGNUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER  TO  CD-MSGLINE
               PERFORM 900-PGM-ERROR THRU 900-PGM-ERROR-X
               GO TO 641-SHOW-FORM.

       641-FIELD-EDITS.
            IF CHG-DEPT-LEDGER = SPACES
               MOVE 11     TO FIELD-NUMBER
      ****     LEDGER IS REQUIRED
               MOVE  66338 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER  TO  CD-MSGLINE
               PERFORM 900-PGM-ERROR THRU 900-PGM-ERROR-X
               GO TO 641-SHOW-FORM.
            IF CHG-DEPT-DESCR = SPACES
               MOVE  3     TO FIELD-NUMBER
      ****     DESCRIPTION IS REQUIRED
               MOVE  66337 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER  TO  CD-MSGLINE
               PERFORM 900-PGM-ERROR THRU 900-PGM-ERROR-X
               GO TO 641-SHOW-FORM.
            IF CHG-DEPT-TYPE = SPACES
               MOVE  6     TO FIELD-NUMBER
      ****     DEPARTMENT TYPE IS REQUIRED
               MOVE  66339 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER  TO  CD-MSGLINE
               PERFORM 900-PGM-ERROR THRU 900-PGM-ERROR-X
               GO TO 641-SHOW-FORM.

       641-GET-BUFFER.
           MOVE CHG-DEPT-LEDG              TO LDG-ARG-IN.
           PERFORM 900-GET-MLEDGER.
           IF NOT GOOD-CALL
      ***  INVALID LEDGER NUMBER
               MOVE   9 TO LANG-SETNUM
               MOVE  39 TO LANG-MSGNUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER       TO CD-MSGLINE
               MOVE  11                  TO FIELD-NUMBER
               PERFORM 900-PGM-ERROR THRU 900-PGM-ERROR-X
               GO TO 641-SHOW-FORM.

           PERFORM 900-LOCK-MCHTACCTS.
           MOVE CHG-DEPT-LEDGER          TO MCHT-LEDGERT.
           MOVE CHG-DEPT-DESCR           TO MCHT-DESC.
           MOVE CHG-DEPT-TYPE            TO MCHT-DEPT-TYPE.
           MOVE CHG-DEPT-BC              TO MCHT-BC.
           PERFORM 900-UPDATE-MCHTACCTS.
           GO TO 640-CHG-DEPT.

       642-DELETE-DEPT.
           MOVE DEPT-ARG TO DEPT OF DTRANS-REC-I.
           START DTRANS-I KEY = DEPT OF DTRANS-REC-I
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS = "00"
      ***  CANNOT DELETE - TRANSACTIONS ARE TIED TO THIS DEPT
               MOVE   3                  TO LANG-SETNUM
               MOVE 169                  TO LANG-MSGNUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER       TO CD-MSGLINE
               MOVE   6                  TO FIELD-NUMBER
               PERFORM 900-PGM-ERROR THRU 900-PGM-ERROR-X
               GO TO 641-SHOW-FORM.

           PERFORM 900-LOCK-MCHTACCTS.
           PERFORM 900-DELETE-MCHTACCTS.

           GO TO 640-CHG-DEPT.

       640-CHG-DEPT-X.
           EXIT.

      ***************************************************************
      **                     650-ADD-LEDGER                         **
      ***************************************************************

       650-ADD-LEDGER.
           MOVE "ADDLEDG"                TO VIEW-NFNAME.

       650-PUT-BUFFER.
           MOVE SPACES                   TO ADD-LEDGER-BUFFER.
      ****   INPUT DATA ABOVE AND THEN PRESS 'ENTER'
           MOVE   9                      TO LANG-SETNUM.
           MOVE  20                      TO LANG-MSGNUM.
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.

       650-SHOW-FORM.
           MOVE ADD-LEDGER-BUFFER        TO  DISPLAY-REC.
           PERFORM 998-WRITE-SCREEN THRU 998-READ-SCREEN.
           MOVE DISPLAY-REC              TO  ADD-LEDGER-BUFFER.

           IF VIEW-LASTKEY = 3
               GO TO 650-ADD-LEDGER-X.

           IF VIEW-LASTKEY = 1 OR
              VIEW-LASTKEY = 2 OR
              VIEW-LASTKEY = 4 OR
              VIEW-LASTKEY = 5 OR
              VIEW-LASTKEY = 6 OR
              VIEW-LASTKEY = 7 OR
              VIEW-LASTKEY = 8
      ****     INVALID FUNCTION KEY
               MOVE   9 TO LANG-SETNUM
               MOVE  10 TO LANG-MSGNUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER  TO  AL-MSGLINE
               MOVE B"1"            TO  IND(99)
               GO TO 650-SHOW-FORM.

       650-FIELD-EDITS.
           IF ADD-LEDGER-CODE = SPACES
               MOVE  4     TO FIELD-NUMBER
      ****     LEDGER IS REQUIRED
               MOVE  66338 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER  TO  AL-MSGLINE
               PERFORM 900-PGM-ERROR THRU 900-PGM-ERROR-X
               GO TO 650-SHOW-FORM.
           IF ADD-LEDGER-DESCR = SPACES
               MOVE  2     TO FIELD-NUMBER
      ****     DESCRIPTION IS REQUIRED
               MOVE  66337 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER  TO  AL-MSGLINE
               PERFORM 900-PGM-ERROR THRU 900-PGM-ERROR-X
               GO TO 650-SHOW-FORM.

       650-GET-BUFFER.
           MOVE SPACES                   TO LEDGER-ARG.
           MOVE ADD-LEDGER-CODE          TO LDG-ARG-IN.
           PERFORM 900-GET-MLEDGER.
           IF NOT NO-ENTRY
      ****   LEDGER ALREADY EXISTS - CANNOT ADD
               MOVE  12 TO LANG-SETNUM
               MOVE   9 TO LANG-MSGNUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER       TO AL-MSGLINE
               MOVE   4                  TO FIELD-NUMBER
               PERFORM 900-PGM-ERROR THRU 900-PGM-ERROR-X
               GO TO 650-SHOW-FORM.

           MOVE SPACES                   TO BUF-MLEDGER.
           MOVE  ADD-LEDGER-CODE         TO MLEDGER-CODE.
           MOVE  ADD-LEDGER-DESCR        TO MLEDGER-DESCR.
           PERFORM 900-PUT-MLEDGER.
           PERFORM 900-UNLOCK-MLEDGER.
           GO TO 650-ADD-LEDGER.

       650-ADD-LEDGER-X.
           EXIT.

      ***************************************************************
      **                     660-CHANGE-LEDGER                      **
      ***************************************************************

       660-CHG-LEDGER.
           MOVE "CHGLEDG"                TO VIEW-NFNAME.

       660-PUT-BUFFER.
           MOVE SPACES                   TO CHG-LEDGER-BUFFER.
      ****   INPUT DATA ABOVE AND THEN PRESS 'ENTER'
           MOVE   9                      TO LANG-SETNUM.
           MOVE  20                      TO LANG-MSGNUM.
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
           MOVE MESSAGE-BUFFER          TO CHG-LEDGER-MSGLINE.

       660-SHOW-FORM.
           MOVE CHG-LEDGER-BUFFER        TO  DISPLAY-REC.
           PERFORM 998-WRITE-SCREEN THRU 998-READ-SCREEN.
           MOVE DISPLAY-REC              TO  CHG-LEDGER-BUFFER.

           IF VIEW-LASTKEY = 3
               GO TO 660-CHG-LEDGER-X.

           IF VIEW-LASTKEY = 1 OR
              VIEW-LASTKEY = 2 OR
              VIEW-LASTKEY = 4 OR
              VIEW-LASTKEY = 5 OR
              VIEW-LASTKEY = 6 OR
              VIEW-LASTKEY = 7 OR
              VIEW-LASTKEY = 8
      ****     INVALID FUNCTION KEY
               MOVE   9 TO LANG-SETNUM
               MOVE  10 TO LANG-MSGNUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER  TO  CL-MSGLINE
               MOVE B"1"            TO  IND(99)
               GO TO 660-SHOW-FORM.

       660-FIELD-EDITS.
           IF CHG-LEDGER-CODE = SPACES
               MOVE  6     TO FIELD-NUMBER
      ****     LEDGER IS REQUIRED
               MOVE  66338 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER  TO  CL-MSGLINE
               PERFORM 900-PGM-ERROR THRU 900-PGM-ERROR-X
               GO TO 660-SHOW-FORM.

       660-GET-BUFFER.
           MOVE SPACES                   TO LEDGER-ARG.
           MOVE CHG-LEDGER-CODE          TO LDG-ARG-IN.
           PERFORM 900-GET-MLEDGER.
           IF NOT GOOD-CALL
      ****   LEDGER DOES NOT EXIST - CANNOT MODIFY OR DELETE
               MOVE  12 TO LANG-SETNUM
               MOVE  10 TO LANG-MSGNUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER       TO CL-MSGLINE
               MOVE   6                  TO FIELD-NUMBER
               PERFORM 900-PGM-ERROR THRU 900-PGM-ERROR-X
               GO TO 660-SHOW-FORM.

           MOVE MLEDGER-DESCR            TO CHG-LEDGER-DESCR.

           MOVE "CHGLEDG2"               TO VIEW-NFNAME.
      ****   PRESS 'ENTER' TO PROCESS OR 'f2' TO DELETE
           MOVE  16                      TO LANG-SETNUM.
           MOVE 126                      TO LANG-MSGNUM.
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
           MOVE MESSAGE-BUFFER           TO CHG-LEDGER-MSGLINE.

       661-SHOW-FORM.
           MOVE CHG-LEDGER-BUFFER        TO  DISPLAY-REC.
           PERFORM 998-WRITE-SCREEN THRU 998-READ-SCREEN.
           MOVE DISPLAY-REC              TO  CHG-LEDGER-BUFFER.

           IF VIEW-LASTKEY = 3
               GO TO 660-CHG-LEDGER-X.

           IF VIEW-LASTKEY = 2
               GO TO 662-DELETE-LEDGER.

           IF VIEW-LASTKEY = 1 OR
              VIEW-LASTKEY = 4 OR
              VIEW-LASTKEY = 5 OR
              VIEW-LASTKEY = 6 OR
              VIEW-LASTKEY = 7 OR
              VIEW-LASTKEY = 8
      ****     INVALID FUNCTION KEY
               MOVE   9 TO LANG-SETNUM
               MOVE  10 TO LANG-MSGNUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER  TO  CL-MSGLINE
               MOVE B"1"            TO  IND(99)
               GO TO 661-SHOW-FORM.

       661-FIELD-EDITS.
           IF CHG-LEDGER-DESCR = SPACES
               MOVE  3     TO FIELD-NUMBER
      ****     DESCRIPTION IS REQUIRED
               MOVE  66337 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER  TO  CL-MSGLINE
               PERFORM 900-PGM-ERROR THRU 900-PGM-ERROR-X
               GO TO 661-SHOW-FORM.

       661-GET-BUFFER.
           PERFORM 900-LOCK-MLEDGER.
           MOVE CHG-LEDGER-DESCR         TO MLEDGER-DESCR.
           PERFORM 900-UPDATE-MLEDGER.
           GO TO 660-CHG-LEDGER.

       662-DELETE-LEDGER.
           MOVE DSET-MLEDGER             TO LOCK-DSET.
           PERFORM 900-LOCK-MLEDGER.
           PERFORM 900-DELETE-MLEDGER.
           GO TO 660-CHG-LEDGER.

       660-CHG-LEDGER-X.
           EXIT.

      ***************************************************************
      **                     670-ADD-VOUCHER                       **
      ***************************************************************

       670-ADD-VOUCHER.
           MOVE "ADDVOUCH"               TO VIEW-NFNAME.

       670-PUT-BUFFER.
           MOVE SPACES                   TO ADD-VOUCHER-BUFFER.
      ****   INPUT DATA ABOVE AND THEN PRESS 'ENTER'
           MOVE   9                      TO LANG-SETNUM.
           MOVE  20                      TO LANG-MSGNUM.
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
           MOVE MESSAGE-BUFFER           TO ADD-VOUCHER-MSGLINE.

       670-SHOW-FORM.
           MOVE ADD-VOUCHER-BUFFER       TO  DISPLAY-REC.
           PERFORM 998-WRITE-SCREEN THRU 998-READ-SCREEN.
           MOVE DISPLAY-REC              TO  ADD-VOUCHER-BUFFER.

           IF VIEW-LASTKEY = 3
               GO TO 670-ADD-VOUCHER-X.

           IF VIEW-LASTKEY = 1 OR
              VIEW-LASTKEY = 2 OR
              VIEW-LASTKEY = 4 OR
              VIEW-LASTKEY = 5 OR
              VIEW-LASTKEY = 6 OR
              VIEW-LASTKEY = 7 OR
              VIEW-LASTKEY = 8
      ****     INVALID FUNCTION KEY
               MOVE   9 TO LANG-SETNUM
               MOVE  10 TO LANG-MSGNUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER  TO  AV-MSGLINE
               MOVE B"1"            TO  IND(99)
               GO TO 670-SHOW-FORM.

       670-FIELD-EDITS.
           IF ADD-VOUCHER-CODE = SPACES
               MOVE  1     TO FIELD-NUMBER
      ****     VOUCHER NUMBER IS REQUIRED
               MOVE  66340 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER  TO  AV-MSGLINE
               PERFORM 900-PGM-ERROR THRU 900-PGM-ERROR-X
               GO TO 670-SHOW-FORM.
           IF ADD-VOUCHER-DESCR = SPACES
               MOVE  2     TO FIELD-NUMBER
      ****     DESCRIPTION IS REQUIRED
               MOVE  66337 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER  TO  AV-MSGLINE
               PERFORM 900-PGM-ERROR THRU 900-PGM-ERROR-X
               GO TO 670-SHOW-FORM.

       670-GET-BUFFER.
           MOVE ADD-VOUCHER-CODE         TO VOUCHER-ARG.
           PERFORM 900-GET-MREPORT.
           IF NOT NO-ENTRY
      ****   VOUCHER ALREADY EXISTS - CANNOT ADD
               MOVE  22 TO LANG-SETNUM
               MOVE  22 TO LANG-MSGNUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER       TO AV-MSGLINE
               MOVE   1                  TO FIELD-NUMBER
               PERFORM 900-PGM-ERROR THRU 900-PGM-ERROR-X
               GO TO 670-SHOW-FORM.

           MOVE SPACES                   TO BUF-MREPORT.
           MOVE ADD-VOUCHER-CODE         TO MREPORT-CODE.
           MOVE ADD-VOUCHER-DESCR        TO MREPORT-DESC.
           PERFORM 900-PUT-MREPORT.
           PERFORM 900-UNLOCK-MREPORT.
           GO TO 670-ADD-VOUCHER.

       670-ADD-VOUCHER-X.
           EXIT.

      ***************************************************************
      **                   680-CHANGE-VOUCHER                      **
      ***************************************************************

       680-CHG-VOUCHER.
           MOVE "CHGVOUCH"               TO VIEW-NFNAME.

       680-PUT-BUFFER.
           MOVE SPACES                   TO CHG-VOUCHER-BUFFER.
      ****   INPUT DATA ABOVE AND THEN PRESS 'ENTER'
           MOVE   9                      TO LANG-SETNUM.
           MOVE  20                      TO LANG-MSGNUM.
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
           MOVE MESSAGE-BUFFER           TO CHG-VOUCHER-MSGLINE.

       680-SHOW-FORM.
           MOVE CHG-VOUCHER-BUFFER       TO  DISPLAY-REC.
           PERFORM 998-WRITE-SCREEN THRU 998-READ-SCREEN.
           MOVE DISPLAY-REC              TO  CHG-VOUCHER-BUFFER.

           IF VIEW-LASTKEY = 3
               GO TO 680-CHG-VOUCHER-X.

           IF VIEW-LASTKEY = 1 OR
              VIEW-LASTKEY = 2 OR
              VIEW-LASTKEY = 4 OR
              VIEW-LASTKEY = 5 OR
              VIEW-LASTKEY = 6 OR
              VIEW-LASTKEY = 7 OR
              VIEW-LASTKEY = 8
      ****     INVALID FUNCTION KEY
               MOVE   9 TO LANG-SETNUM
               MOVE  10 TO LANG-MSGNUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER  TO  CV-MSGLINE
               MOVE B"1"            TO  IND(99)
               GO TO 680-SHOW-FORM.

       680-FIELD-EDITS.
           IF CHG-VOUCHER-CODE = SPACES
               MOVE  1     TO FIELD-NUMBER
      ****     VOUCHER NUMBER IS REQUIRED
               MOVE  66340 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER  TO  CV-MSGLINE
               PERFORM 900-PGM-ERROR THRU 900-PGM-ERROR-X
               GO TO 680-SHOW-FORM.

       680-GET-BUFFER.
           MOVE CHG-VOUCHER-CODE         TO VOUCHER-ARG.
           PERFORM 900-GET-MREPORT.
           IF NOT GOOD-CALL
      ****   VOUCHER DOES NOT EXIST - CANNOT MODIFY OR DELETE
               MOVE  22 TO LANG-SETNUM
               MOVE  23 TO LANG-MSGNUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER       TO CV-MSGLINE
               MOVE   1                  TO FIELD-NUMBER
               PERFORM 900-PGM-ERROR THRU 900-PGM-ERROR-X
               GO TO 680-SHOW-FORM.

           MOVE MREPORT-DESC             TO CHG-VOUCHER-DESCR.

           MOVE "CHGVOUCH2"              TO VIEW-NFNAME.
      ****   PRESS 'ENTER' TO PROCESS OR 'f2' TO DELETE
           MOVE  16                      TO LANG-SETNUM.
           MOVE 126                      TO LANG-MSGNUM.
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
           MOVE MESSAGE-BUFFER           TO CHG-VOUCHER-MSGLINE.

       681-SHOW-FORM.
           MOVE CHG-VOUCHER-BUFFER       TO  DISPLAY-REC.
           PERFORM 998-WRITE-SCREEN THRU 998-READ-SCREEN.
           MOVE DISPLAY-REC              TO  CHG-VOUCHER-BUFFER.

           IF VIEW-LASTKEY = 3
               GO TO 680-CHG-VOUCHER-X.

           IF VIEW-LASTKEY = 2
               GO TO 682-DELETE-VOUCHER.

           IF VIEW-LASTKEY = 1 OR
              VIEW-LASTKEY = 4 OR
              VIEW-LASTKEY = 5 OR
              VIEW-LASTKEY = 6 OR
              VIEW-LASTKEY = 7 OR
              VIEW-LASTKEY = 8
      ****     INVALID FUNCTION KEY
               MOVE   9 TO LANG-SETNUM
               MOVE  10 TO LANG-MSGNUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER  TO  CV-MSGLINE
               MOVE B"1"            TO  IND(99)
               GO TO 681-SHOW-FORM.

       681-FIELD-EDITS.
           IF CHG-VOUCHER-DESCR = SPACES
               MOVE  3     TO FIELD-NUMBER
      ****     DESCRIPTION IS REQUIRED
               MOVE  66337 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER  TO  CV-MSGLINE
               PERFORM 900-PGM-ERROR THRU 900-PGM-ERROR-X
               GO TO 681-SHOW-FORM.

       681-GET-BUFFER.
           PERFORM 900-LOCK-MREPORT.
           MOVE CHG-VOUCHER-DESCR        TO MREPORT-DESC.
           PERFORM 900-UPDATE-MREPORT.
           GO TO 680-CHG-VOUCHER.

       682-DELETE-VOUCHER.
           PERFORM 900-LOCK-MREPORT.
           PERFORM 900-DELETE-MREPORT.
           GO TO 680-CHG-VOUCHER.

       680-CHG-VOUCHER-X.
           EXIT.

      **###########################################################**
      **                                                           **
      **          P E R F O R M E D    R O U T I N E S             **
      **                                                           **
      **###########################################################**

      ***************************************************************
      **               I M A G E    R O U T I N E S                **
      ***************************************************************

      ***
      *** M C H T A C C T S
      ***
       900-GET-MCHTACCTS.
           MOVE 0 TO COND-WORD.
           MOVE DEPT-ARG TO DEPT OF MCHTACCTS-REC-I.
           READ MCHTACCTS-I INTO BUF-MCHTACCTS
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS-1 = "2"
               MOVE 17 TO COND-WORD
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD.

           IF NOT GOOD-CALL
               IF NOT NO-ENTRY
                   MOVE "DBGET MCHTACCTS * 900-GET-MCHTACCTS"
                       TO BU-DISPLAY-MSG
                   MOVE DEPT-ARG TO BU-DISPLAY-FLD (1)
                   GO TO 200-BLOWUP.

       900-LOCK-MCHTACCTS.
           MOVE 0 TO COND-WORD.
           MOVE DEPT-ARG TO DEPT OF MCHTACCTS-REC-O.
           READ MCHTACCTS-O INTO BUF-MCHTACCTS
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD.

           IF NOT GOOD-CALL
               MOVE "DBGET MCHTACCTS * 900-LOCK-MCHTACCTS"
                   TO BU-DISPLAY-MSG
               MOVE DEPT-ARG TO BU-DISPLAY-FLD (1)
               GO TO 200-BLOWUP.

       900-PUT-MCHTACCTS.
           MOVE 0 TO COND-WORD.
           WRITE MCHTACCTS-REC-O FROM BUF-MCHTACCTS
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD.

           IF NOT GOOD-CALL
               MOVE "DBPUT MCHTACCTS * 900-PUT-MCHTACCTS"
                   TO BU-DISPLAY-MSG
               GO TO 200-BLOWUP.

       900-UPDATE-MCHTACCTS.
           MOVE 0 TO COND-WORD.
           REWRITE MCHTACCTS-REC-O FROM BUF-MCHTACCTS
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD.

           IF NOT GOOD-CALL
               MOVE "DBUPDATE MCHTACCTS * 900-UPDATE-MCHTACCTS"
                   TO BU-DISPLAY-MSG
               GO TO 200-BLOWUP.

       900-DELETE-MCHTACCTS.
           MOVE 0 TO COND-WORD.
           DELETE MCHTACCTS-O
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD.

           IF NOT GOOD-CALL
               MOVE "DBDELETE MCHTACCTS * 900-DELETE-MCHTACCTS"
                   TO BU-DISPLAY-MSG
               GO TO 200-BLOWUP.

       900-UNLOCK-MCHTACCTS.
      *------- DO A START > HIGH-VALUES TO UNLOCK
           MOVE HIGH-VALUES TO DEPT OF MCHTACCTS-REC-O.
           START MCHTACCTS-O KEY > DEPT OF MCHTACCTS-REC-O
               INVALID KEY MOVE "00" TO FILE-STATUS.

      ***
      *** M R E P O R T
      ***
       900-GET-MREPORT.
           MOVE 0 TO COND-WORD.
           MOVE VOUCHER-ARG TO RPTCODE OF MREPORT-REC-I.
           READ MREPORT-I INTO BUF-MREPORT
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS-1 = "2"
               MOVE 17 TO COND-WORD
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD.

           IF NOT GOOD-CALL
               IF NOT NO-ENTRY
                   MOVE "DBGET MREPORT * 900-GET-MREPORT"
                       TO BU-DISPLAY-MSG
                   MOVE VOUCHER-ARG TO BU-DISPLAY-FLD (1)
                   GO TO 200-BLOWUP.

       900-LOCK-MREPORT.
           MOVE 0 TO COND-WORD.
           MOVE VOUCHER-ARG TO RPTCODE OF MREPORT-REC-O.
           READ MREPORT-O INTO BUF-MREPORT
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD.

           IF NOT GOOD-CALL
                   MOVE "DBGET MREPORT * 900-LOCK-MREPORT"
                       TO BU-DISPLAY-MSG
                   MOVE VOUCHER-ARG TO BU-DISPLAY-FLD (1)
                   GO TO 200-BLOWUP.
       900-PUT-MREPORT.
           MOVE 0 TO COND-WORD.
           WRITE MREPORT-REC-O FROM BUF-MREPORT
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD.

           IF NOT GOOD-CALL
               MOVE "DBPUT MREPORT * 900-PUT-MREPORT"
                   TO BU-DISPLAY-MSG
               GO TO 200-BLOWUP.

       900-UPDATE-MREPORT.
           MOVE 0 TO COND-WORD.
           REWRITE MREPORT-REC-O FROM BUF-MREPORT
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD.

           IF NOT GOOD-CALL
               MOVE "DBUPDATE MREPORT * 900-UPDATE-MREPORT"
                   TO BU-DISPLAY-MSG
               GO TO 200-BLOWUP.

       900-DELETE-MREPORT.
           MOVE 0 TO COND-WORD.
           DELETE MREPORT-O
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD.

           IF NOT GOOD-CALL
               MOVE "DBDELETE MREPORT * 900-DELETE-MREPORT"
                   TO BU-DISPLAY-MSG
               GO TO 200-BLOWUP.

       900-UNLOCK-MREPORT.
      *------- DO A START > HIGH-VALUES TO UNLOCK
           MOVE HIGH-VALUES TO RPTCODE OF MREPORT-REC-O.
           START MREPORT-O KEY > RPTCODE OF MREPORT-REC-O
               INVALID KEY MOVE "00" TO FILE-STATUS.

      ***
      *** M L E D G E R
      ***
       900-GET-MLEDGER.
           MOVE 0 TO COND-WORD.
           MOVE LEDGER-ARG TO LEDGER OF MLEDGER-REC-I.
           READ MLEDGER-I INTO BUF-MLEDGER
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS-1 = "2"
               MOVE 17 TO COND-WORD
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD.

           IF NOT GOOD-CALL
               IF NOT NO-ENTRY
                   MOVE "DBGET MLEDGER * 900-GET-MLEDGER"
                       TO BU-DISPLAY-MSG
                   MOVE LEDGER-ARG TO BU-DISPLAY-FLD (1)
                   GO TO 200-BLOWUP.

      ***** 06SEP1996 REVISED THE FOLLOWING "LOCK" PARAGRAPH TO USE THE
      *****    FILE THAT IS OPENED I-O, INSTEAD OF THE ONE THAT IS
      *****    ONLY OPENED FOR INPUT.    ---DAVE PLUM
       900-LOCK-MLEDGER.
           MOVE 0 TO COND-WORD.
      *****MOVE LEDGER-ARG TO LEDGER OF MLEDGER-REC-I.
           MOVE LEDGER-ARG TO LEDGER OF MLEDGER-REC-O.
      *****READ MLEDGER-I INTO BUF-MLEDGER
      *****    INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           READ MLEDGER-O INTO BUF-MLEDGER
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS-1 = "2"
               MOVE 17 TO COND-WORD
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD.

           IF NOT GOOD-CALL
               IF NOT NO-ENTRY
                   MOVE "DBGET MLEDGER * 900-GET-MLEDGER"
                       TO BU-DISPLAY-MSG
                   MOVE LEDGER-ARG TO BU-DISPLAY-FLD (1)
                   GO TO 200-BLOWUP.

       900-PUT-MLEDGER.
           MOVE 0 TO COND-WORD.
           WRITE MLEDGER-REC-O FROM BUF-MLEDGER
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD.

           IF NOT GOOD-CALL
               MOVE "DBPUT MLEDGER * 900-PUT-MLEDGER"
                   TO BU-DISPLAY-MSG
               GO TO 200-BLOWUP.

       900-UPDATE-MLEDGER.
           MOVE 0 TO COND-WORD.
           REWRITE MLEDGER-REC-O FROM BUF-MLEDGER
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD.

           IF NOT GOOD-CALL
               MOVE "DBUPDATE MLEDGER * 900-UPDATE-MLEDGER"
                   TO BU-DISPLAY-MSG
               GO TO 200-BLOWUP.

       900-DELETE-MLEDGER.
           MOVE 0 TO COND-WORD.
           DELETE MLEDGER-O
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD.

           IF NOT GOOD-CALL
               MOVE "DBDELETE MLEDGER * 900-DELETE-MLEDGER"
                   TO BU-DISPLAY-MSG
               GO TO 200-BLOWUP.

       900-UNLOCK-MLEDGER.
      *------- DO A START > HIGH-VALUES TO UNLOCK
           MOVE HIGH-VALUES TO LEDGER OF MLEDGER-REC-O.
           START MLEDGER-O KEY > LEDGER OF MLEDGER-REC-O
               INVALID KEY MOVE "00" TO FILE-STATUS.


       COPY DISPCALL IN COPYLIB.
      ***************************************************************
      **               V I E W     R O U T I N E S                 **
      ***************************************************************
       900-PGM-ERROR.
           MOVE B"1" TO IND(99), IND(FIELD-NUMBER).

       900-PGM-ERROR-X.
           EXIT.

      *********************************************************
       999-CATREAD.
           IF CATREAD-MSG-NUMBER = ZEROS
               MOVE LANG-SETNUM TO CATREAD-MSG-SET
               MOVE LANG-MSGNUM TO CATREAD-MSG-NUM.
           CALL "CCATREAD" USING CATREAD-PARMS.
           MOVE CATREAD-MSG-TEXT TO MESSAGE-BUFFER.
       999-CATREAD-EXIT.
           EXIT.
