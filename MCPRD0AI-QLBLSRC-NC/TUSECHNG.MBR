020630*                                    *
020640*     NATIVE LANGUAGE SUPPORT AREA   *
020650*                                    *
020660**************************************
020670
020680 COPY LANGUAGE IN COPYLIB.
020690
020800 PROCEDURE DIVISION.
020900 1-HOUSEKEEP SECTION.
021000 10-BEGIN-HOUSEKEEP.
           MOVE "C" TO MCXCBLERR-SCOPE.
           CALL "MCXCBLERR" USING MCXCBLERR-SCOPE.
021100
021200     MOVE 0  TO  SUB.
021300     PERFORM 4-INIT-FIELDS 14 TIMES.
021400     MOVE SPACES TO DE-FIELDS-1.
021400     MOVE 5      TO SRF-KEYSET.
022600
           OPEN I-O USAGEFIL, DISPLAY-FILE.
025500     PERFORM 6-UPDATE-USAGE-FILE THRU 6-UUF-X.
029600     CLOSE USAGEFIL, DISPLAY-FILE.
025600     IF BU-DISPLAY-MSG = SPACES
025700         GO TO 2-EOJ.
025800
029200 2-BLOWUP.
029300     MOVE "TUSECHNG"               TO   BU-PGM-NAME.
029400     CALL "TBLOWUP" USING BASE, BU-PGM-NAME, STATUS-AREA,
029500       VIEW-COMAREA, FILE-STATUS, BU-DISPLAY-MSG,
029600       BU-DISPLAY-FLDS.
029400
029500 2-EOJ.
029900     STOP RUN.
030000
030100 4-INIT-FIELDS.
030200     ADD 1 TO SUB.
030300     MOVE 0  TO  K-MTH-USAGE (SUB)
                       K-MTH-USAGE-DD (SUB).
030300     MOVE 0  TO  SRF-CURSOR-FLD.
037200     MOVE "UCHANGE"  TO VIEW-NFNAME.
030400
054600 4-SET-ERROR.
           MOVE B"1" TO IND (FIELD-NUMBER), IND (99).
           MOVE MESSAGE-BUFFER TO DE-MESSAGE-LINE.
055400
055500 4-SET-ERROR-X.
055600     EXIT.
032200
032300 4-CLEAR-FORM.
032400     MOVE SPACES TO MESSAGE-BUFFER.
033100     MOVE SPACES TO DE-CODE.
033200     MOVE SPACES  TO  DE-FIELDS-1.
036800
036900 6-UPDATE-USAGE-FILE.
037800 61-SHOWFORM-2.
037900     MOVE  20 TO LANG-SETNUM.
037910     MOVE   8 TO LANG-MSGNUM.
037920     PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
037930     MOVE MESSAGE-BUFFER TO V-INSTR.
           PERFORM 9999-PUTBUFFER-1.
033500     PERFORM 9999-DO-SCREEN-1.
           PERFORM 9999-GETBUFFER-1.
038200
039200     IF VIEW-LASTKEY = 3
039400         GO TO 6-UUF-X
039500     ELSE
050600     IF VIEW-LASTKEY = 2 OR 1
               PERFORM 4-CLEAR-FORM
050900         GO TO 61-SHOWFORM-2.
042900
043000     MOVE DE-CODE  TO  CORPCDE.
           READ USAGEFIL INTO BUF-USAGEFIL
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
043300     IF FILE-STATUS = "23"
043400         MOVE  19 TO LANG-SETNUM
043410         MOVE   9 TO LANG-MSGNUM
043420         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
043500         MOVE DE-CODE                          TO  MSG-FLD
043600         MOVE 1                                TO  FIELD-NUMBER
043700         PERFORM 4-SET-ERROR
043800         GO TO 61-SHOWFORM-2.
043900     IF FILE-STATUS-1 NOT = "0"
044000         MOVE "READ USAGEFIL ERROR - 61-S-2" TO BU-DISPLAY-MSG
248800         MOVE "CORP-CODE ="                 TO BU-DISPLAY-FLD (1)
248800         MOVE  CORPCDE                      TO BU-DISPLAY-FLD (2)
044300         GO TO 6-UUF-X.
044400
044500 62-BUILD-SCREEN.
044600     MOVE 0  TO  SUB.
044700 621-BUILD-SCREEN-LOOP.
044800     ADD 1  TO  SUB.
044900     IF SUB > 14
045000         GO TO 63-PART-2.
045100
045200     IF K-MTH-USAGE (SUB) < 0
045300         MOVE "-"  TO  DE-SIGN (SUB)
045400         MULTIPLY -1 BY K-MTH-USAGE (SUB).
045500
045600     MOVE K-MTH-USAGE (SUB)     TO  FLD-9.
045700     MOVE FLD-9                 TO  SHIFT-FLD.
045800     CALL "TLSHIFT" USING RET-CODE, SHIFT-FLD.
045900       IF SHIFT-FLD = "        "
046000           MOVE "0       "  TO  SHIFT-FLD.
046100     MOVE SHIFT-FLD  TO  DE-USAGE (SUB).
046200
045200     IF K-MTH-USAGE-DD (SUB) < 0
045300         MOVE "-"  TO  DE-SIGN-DD (SUB)
045400         MULTIPLY -1 BY K-MTH-USAGE-DD (SUB).
045500
045600     MOVE K-MTH-USAGE-DD (SUB)     TO  FLD-9.
045700     MOVE FLD-9                 TO  SHIFT-FLD.
045800     CALL "TLSHIFT" USING RET-CODE, SHIFT-FLD.
045900       IF SHIFT-FLD = "        "
046000           MOVE "0       "  TO  SHIFT-FLD.
046100     MOVE SHIFT-FLD  TO  DE-USAGE-DD (SUB).
046200
046300     GO TO 621-BUILD-SCREEN-LOOP.
046400
046500 63-PART-2.
046700     MOVE  20 TO LANG-SETNUM.
046710     MOVE  42 TO LANG-MSGNUM.
046720     PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
046730     MOVE MESSAGE-BUFFER TO V-INSTR.
047300
           MOVE B"1" TO IND (60).
047500     MOVE SPACES  TO  MESSAGE-BUFFER.
047600
047700 631-SHOWFORM-3.
           PERFORM 9999-PUTBUFFER-1.
033500     PERFORM 9999-DO-SCREEN-1.
           PERFORM 9999-GETBUFFER-1.
048700     IF VIEW-LASTKEY = 3
048900         GO TO 6-UUF-X
049000     ELSE
050600     IF VIEW-LASTKEY = 2 OR 1
050700         PERFORM 4-CLEAR-FORM
050900         GO TO 61-SHOWFORM-2.
051700
046600     MOVE SPACES TO DE-CODE.
052900
053000 64-SHIFT.
053100     MOVE 0  TO  SUB.
053200 641-SHIFT-EDIT-LOOP.
053300     ADD 1  TO  SUB.
053400     IF SUB > 14
053500         GO TO 63-REWRITE.
053600
053700     MOVE DE-USAGE (SUB)  TO  SHIFT-FLD.
053800     CALL "TRSHIFT" USING RET-CODE, SHIFT-FLD.
053900
054000     IF SHIFT-FLD NOT NUMERIC
054100         MOVE  17 TO LANG-SETNUM
054110         MOVE   1 TO LANG-MSGNUM
054120         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
054200         MOVE SHIFT-FLD                  TO MSG-FLD
054300         COMPUTE FIELD-NUMBER = (2 * SUB)
054400         PERFORM 4-SET-ERROR
054500         GO TO 631-SHOWFORM-3.
054600
054700     IF DE-SIGN (SUB)  =  "-"  OR " "
054800         NEXT SENTENCE
054900     ELSE
055000         MOVE  13 TO LANG-SETNUM
055010         MOVE  48 TO LANG-MSGNUM
055020         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
055200         COMPUTE FIELD-NUMBER = (2 * SUB) - 1
055300         PERFORM 4-SET-ERROR
055400         GO TO 631-SHOWFORM-3.
055500
055600     MOVE SHIFT-FLD  TO  K-MTH-USAGE (SUB).
055700     IF DE-SIGN (SUB) = "-"
055800         MULTIPLY -1 BY K-MTH-USAGE (SUB).
055900
053700     MOVE DE-USAGE-DD (SUB)  TO  SHIFT-FLD.
053800     CALL "TRSHIFT" USING RET-CODE, SHIFT-FLD.
053900
054000     IF SHIFT-FLD NOT NUMERIC
054100         MOVE  17 TO LANG-SETNUM
054110         MOVE   1 TO LANG-MSGNUM
054120         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
054200         MOVE SHIFT-FLD                  TO MSG-FLD
054300         COMPUTE FIELD-NUMBER = (2 * SUB) + 30
054400         PERFORM 4-SET-ERROR
054500         GO TO 631-SHOWFORM-3.
054600
054700     IF DE-SIGN (SUB)  =  "-"  OR " "
054800         NEXT SENTENCE
054900     ELSE
055000         MOVE  13 TO LANG-SETNUM
055010         MOVE  48 TO LANG-MSGNUM
055020         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
055200         COMPUTE FIELD-NUMBER = (2 * SUB) - 1 + 30
055300         PERFORM 4-SET-ERROR
055400         GO TO 631-SHOWFORM-3.
055500
055600     MOVE SHIFT-FLD  TO  K-MTH-USAGE-DD (SUB).
055700     IF DE-SIGN (SUB) = "-"
055800         MULTIPLY -1 BY K-MTH-USAGE-DD (SUB).
055900
056000     GO TO 641-SHIFT-EDIT-LOOP.
056100*
056200 63-REWRITE.
           REWRITE USAGEFIL-REC FROM BUF-USAGEFIL
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS = "00"
               NEXT SENTENCE
           ELSE
248800         MOVE "REWRITE USAGEFIL ERROR - 63-R"  TO BU-DISPLAY-MSG
248800         MOVE "CORP-CODE ="                 TO BU-DISPLAY-FLD (1)
248800         MOVE K-CORP-CODE                   TO BU-DISPLAY-FLD (2)
248900         GO TO 6-UUF-X.
058200
058300     PERFORM 4-CLEAR-FORM.
058400     GO TO 61-SHOWFORM-2.
058700
058800 6-UUF-X.
058900     EXIT.
059000
059100 COPY HCATREAD  IN COPYLIB.
061000
061000 COPY SCRNCALL  IN COPYLIB.
061000
       9999-GETBUFFER-1.
           MOVE DISPLAY-REC TO DE-FIELDS-1.

       9999-PUTBUFFER-1.
           MOVE DE-FIELDS-1 TO DISPLAY-REC.

       9999-SETERROR-1.
           MOVE B"1"            TO IND (99).
           MOVE B"1"            TO IND (FIELD-NUMBER).
           MOVE MESSAGE-BUFFER  TO DE-MESSAGE-LINE-1.
           MOVE DE-FIELDS-1     TO DISPLAY-REC.

       9999-DO-SCREEN-1.
           PERFORM 998-WRITE-SCREEN THRU 9989-WS-X.

