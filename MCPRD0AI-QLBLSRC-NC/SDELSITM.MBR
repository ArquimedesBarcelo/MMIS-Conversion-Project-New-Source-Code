           START DREQD-I KEY = PORCVNO OF DREQD-REC-I
               INVALID KEY GO TO 661-CFR-X.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
                   GO TO 661-CFR-X
               ELSE
                   MOVE 99 TO COND-WORD.
