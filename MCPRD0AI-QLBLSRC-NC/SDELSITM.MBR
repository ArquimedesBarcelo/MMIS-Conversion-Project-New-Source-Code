033000 DELETE-STORERM-ITEM SECTION 30.
       BEGIN.
           OPEN INPUT DREQD-I, MSTORERM-I, MPLTINFO-I,
                      DINVRCD, DINVITM.
           OPEN I-O DISPLAY-FILE, DPOITEM-O, DPODATAITM-O,
                    DDAILYTC-O, DREQD-O, MREQ-O, DRCVTRAK-O.

           MOVE "Y"              TO  DELETE-LAST-ITEM-SW.
           MOVE "PODL"           TO  PLT-ARG.
           MOVE PLT-ARG TO PLTINFOKEY OF MPLTINFO-REC-I.
           READ MPLTINFO-I INTO BUF-MPLTINFO
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS = "00"
               IF MPLTINFO-LAST-ITEM-SW > SPACE
                   MOVE MPLTINFO-LAST-ITEM-SW TO DELETE-LAST-ITEM-SW.

           MOVE SPACES           TO  SEDIVNCK-PARMS.
033100     MOVE BUILD-PO-SEARCH  TO  PO-ARG,
                                     SEDIVNCK-PO-NUMBER,
033200                               BU-DISPLAY-FLD (1).
           CALL "SEDIVNCK" USING BASE,
                                 SEDIVNCK-PARMS.
033300     PERFORM 66-DELETE-ITEM  THRU  66-DI-X.
033400
           CLOSE DISPLAY-FILE, DPOITEM-O, DPODATAITM-O,
                 DDAILYTC-O, DREQD-O, MREQ-O, DREQD-I, MSTORERM-I
                 DRCVTRAK-O, DINVRCD, DINVITM.
033500     GOBACK.
033600
033700******************************************************
033800**                                                  **
033900**   BLOWUP ROUTINE                                 **
034000**                                                  **
034100******************************************************
034200
034300 2-BLOWUP.
           IF FILE-STATUS NUMERIC
               MOVE FILE-STATUS TO COND-WORD.
034400     MOVE "SDELSITM"  TO  BU-PGM-NAME.
034500     CALL "TBLOWUP" USING BASE, BU-PGM-NAME, STATUS-AREA,
034600         VIEW-COMAREA, FILE-STATUS, BU-DISPLAY-MSG,
034700             BU-DISPLAY-FLDS.
037900
038000 4-PGM-ERROR.
           MOVE B"1" TO IND (FIELD-NUMBER), IND (99).
           MOVE MESSAGE-BUFFER TO DE5-MESSAGE-LINE.
038800
038900 4-PGM-ERROR-X.
039000     EXIT.
039100
041000
041100 66-DELETE-ITEM.
041300     MOVE "POMOD5"  TO  VIEW-NFNAME.
041800
042800     MOVE SPACES           TO  SCREEN-5.
042900     MOVE PO-NO            TO  DE5-PO.
043000     MOVE PO-REL           TO  DE5-REL.
           IF SEDIVNCK-EDI-IND = "Y"
               MOVE "EDI PO"     TO  DE5-EDILIT.
           MOVE ZEROS TO DE5-ITEM, DE5-UNIT-PRICE, DE5-ORD-QTY.
043100*    *** ENTER ITEM# TO DELETE AND PRESS 'ENTER' ***
043200     MOVE   5 TO LANG-SETNUM.
043300     MOVE  12 TO LANG-MSGNUM.
043400     PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
043500     MOVE MESSAGE-BUFFER TO DE5-MSG-TOP.
044200
044300 66-SHOWFORM-SCREEN-5.
           MOVE SCREEN-5       TO DISPLAY-REC.
           PERFORM 998-WRITE-SCREEN THRU 998-READ-SCREEN.
           MOVE DISPLAY-REC    TO SCREEN-5.
045000
045100     IF VIEW-LASTKEY = 3
045200         GO TO 66-DI-X
045300     ELSE
046600     IF VIEW-LASTKEY = 1 OR
046700        VIEW-LASTKEY = 2 OR
046800        VIEW-LASTKEY = 4 OR
046900        VIEW-LASTKEY = 5 OR
047000        VIEW-LASTKEY = 6 OR
047100        VIEW-LASTKEY = 7 OR
              VIEW-LASTKEY = 8
047300*        *** INVALID FUNCTION KEY ***
047400         MOVE   9 TO LANG-SETNUM
047500         MOVE  10 TO LANG-MSGNUM
047600         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
047700         MOVE 3  TO  FIELD-NUMBER
047800         PERFORM 4-PGM-ERROR  THRU  4-PGM-ERROR-X
047900         GO TO 66-SHOWFORM-SCREEN-5.
048000
           IF DE5-ITEM = ZEROS
      *         YOU MUST ENTER AN ITEM NUMBER
               MOVE 66110 TO CATREAD-MSG-NUMBER
069800         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
069900         MOVE 3  TO FIELD-NUMBER
070000         PERFORM 4-PGM-ERROR  THRU  4-PGM-ERROR-X
070100         GO TO 66-SHOWFORM-SCREEN-5.
049800
049900     MOVE BUILD-PO-SEARCH  TO  PO-ARG.
           MOVE PO-ARG           TO  PORCVNO OF DPOITEM-REC-O.
           MOVE DE5-ITEM         TO  ITEMNO OF DPOITEM-REC-O.
           READ DPOITEM-O INTO BUF-DPOITEM
               INVALID KEY MOVE "2" TO FILE-STATUS-1.
           IF FILE-STATUS-1 = "2"
069500*        *** ITEM NUMBER DOES NOT EXIST ON THIS P.O. ***
069600         MOVE   9 TO LANG-SETNUM
069700         MOVE  11 TO LANG-MSGNUM
069800         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
069900         MOVE 3  TO FIELD-NUMBER
070000         PERFORM 4-PGM-ERROR  THRU  4-PGM-ERROR-X
070100         GO TO 66-SHOWFORM-SCREEN-5
070200     ELSE
           IF FILE-STATUS NOT = "00"
070300         MOVE "GET DPOITEM * 66-GL" TO BU-DISPLAY-MSG
070400         GO TO 2-BLOWUP.
067800
      *------ DO A START TO UNLOCK DPOITEM
           MOVE HIGH-VALUES TO PORCVNO OF DPOITEM-REC-O.
           START DPOITEM-O KEY > PORCVNO OF DPOITEM-REC-O
               INVALID KEY MOVE "00" TO FILE-STATUS.
053200
053400     MOVE "POMOD5B"  TO  VIEW-NFNAME.
054000
054200     MOVE ITM-NUMBER          TO  DE5-ITEM.
054300*    *** ENTER ZEROS IN THE PRICE & QTY FIELDS & HIT ENTER ***
054400     MOVE   5 TO LANG-SETNUM.
054500     MOVE  11 TO LANG-MSGNUM.
054600     PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
054700     MOVE MESSAGE-BUFFER      TO DE5-MSG-TOP.
054800     IF ITM-CORP-CODE = "NON-STR"
054900         MOVE "NC"            TO  DE5-CODE
055000     ELSE
055100         MOVE ITM-CORP-CODE   TO  DE5-CODE.
055200     MOVE ITM-QTY-ORD         TO  DE5-ORD-QTY.
055300     MOVE ITM-UM              TO  DE5-ORD-UM.
055400     MOVE ITM-UNIT-PRICE      TO  DE5-UNIT-PRICE.
055500     MOVE ITM-PRICE-UM        TO  DE5-PRICE-UM.
055600     MOVE ITM-CLASS           TO  DE5-SUB
055700     MOVE ITM-SUB-DETL        TO  DE5-SUBDTL.
055800     MOVE ITM-ADDL-DATA       TO  DE5-ADDTL-DATA.
055900     MOVE ITM-TAX-CODE        TO  DE5-TAX-CODE.
056000     MOVE "NONE"              TO  DE5-REQ-NO.
056100     PERFORM 661-CHECK-FOR-REQ  THRU  661-CFR-X.
056200*    *** 'f7' TO REQUEST ANOTHER ITEM ***
056300     MOVE   6 TO LANG-SETNUM.
056400     MOVE   7 TO LANG-MSGNUM.
056500     PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
056600     MOVE MESSAGE-BUFFER TO DE5-MSG-BOTTOM.
056700
      *------ LOAD DESC. UP TO 6 LINES ONLY
056900     MOVE ZEROS                   TO  LINE-SUB.
           MOVE 0 TO COND-WORD.
           MOVE PO-ARG TO PORCVNO OF DPODATAITM-REC-O.
           START DPODATAITM-O KEY = PORCVNO OF DPODATAITM-REC-O
               INVALID KEY MOVE "2" TO FILE-STATUS-1.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
                   GO TO 66-SHOWFORM-SCREEN-5B
               ELSE
                   MOVE 99 TO COND-WORD.
057000*A   CALL "DBFIND" USING BASE, DSET-DPODATAITM, MODE1,
057100*A       STATUS-AREA, PO-SEARCH, PO-ARG.
057200     IF COND-WORD NOT = 0
057300         MOVE "FIND DPODATA * 66-FD" TO BU-DISPLAY-MSG
057400         GO TO 2-BLOWUP.
057700
057800 66-GET-DESC.
           MOVE 0 TO COND-WORD.
           READ DPODATAITM-O NEXT INTO BUF-DPODATAITM
               AT END MOVE 15 TO COND-WORD.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   MOVE 15 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.
           IF PORCVNO OF DPODATAITM-REC-O NOT = PO-ARG
               MOVE 15 TO COND-WORD.
057900*A   CALL "DBGET" USING BASE, DSET-DPODATAITM, MODE5,
058000*A       STATUS-AREA, ALL-ITEMS, BUF-DPODATAITM, PO-ARG.
058100     IF COND-WORD NOT = 0
058200         IF COND-WORD = 15
058300             GO TO 66-START-DPODATAITM
058400         ELSE
058500             MOVE "GET DPODATA * 66-GD" TO BU-DISPLAY-MSG
058600             GO TO 2-BLOWUP.
058700     IF DATAITM-ITEM-NO = DE5-ITEM
058800         ADD 1 TO LINE-SUB
058900         MOVE DATAITM-INFO  TO  DE5-DESC-LINES (LINE-SUB)
059000         IF LINE-SUB > 6
059100             GO TO 66-START-DPODATAITM
059200         ELSE
059300             GO TO 66-GET-DESC
059400     ELSE
059500         IF DATAITM-ITEM-NO < DE5-ITEM
059600             GO TO 66-GET-DESC.
059700
059800 66-START-DPODATAITM.
      *------ DO A START ON DPODATAITM TO FREE UP LOCKS
           MOVE HIGH-VALUES TO PORCVNO OF DPODATAITM-REC-O.
           START DPODATAITM-O KEY > PORCVNO OF DPODATAITM-REC-O
               INVALID KEY MOVE "00" TO FILE-STATUS.
060500
061500 66-SHOWFORM-SCREEN-5B.
           MOVE SCREEN-5       TO DISPLAY-REC.
           PERFORM 998-WRITE-SCREEN THRU 998-READ-SCREEN.
           MOVE DISPLAY-REC    TO SCREEN-5.
062700
062800     IF VIEW-LASTKEY = 3
062900         GO TO 66-DI-X
063000     ELSE
063100     IF VIEW-LASTKEY = 7
063200         GO TO 66-DELETE-ITEM
063300     ELSE
064600     IF VIEW-LASTKEY = 1 OR
064700        VIEW-LASTKEY = 2 OR
064800        VIEW-LASTKEY = 4 OR
064900        VIEW-LASTKEY = 5 OR
065000        VIEW-LASTKEY = 6 OR
              VIEW-LASTKEY = 8
065200*        *** INVALID FUNCTION KEY ***
065300         MOVE   9 TO LANG-SETNUM
065400         MOVE  10 TO LANG-MSGNUM
065500         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
065600         MOVE 9  TO  FIELD-NUMBER
065700         PERFORM 4-PGM-ERROR  THRU  4-PGM-ERROR-X
065800         GO TO 66-SHOWFORM-SCREEN-5B.
067600
           IF DE5-UNIT-PRICE NOT = ZEROS
      *         ITEM PRICE MUST BE ZERO FOR DELETION
               MOVE 66116 TO CATREAD-MSG-NUMBER
069800         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
069900         MOVE 9  TO FIELD-NUMBER
070000         PERFORM 4-PGM-ERROR  THRU  4-PGM-ERROR-X
070100         GO TO 66-SHOWFORM-SCREEN-5B.

           IF DE5-ORD-QTY NOT = ZEROS
      *         ITEM QUANTITY MUST BE ZERO FOR DELETION
               MOVE 66117 TO CATREAD-MSG-NUMBER
069800         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
069900         MOVE 6  TO FIELD-NUMBER
070000         PERFORM 4-PGM-ERROR  THRU  4-PGM-ERROR-X
070100         GO TO 66-SHOWFORM-SCREEN-5B.

      *----- IF SWITCH SET, DO NOT ALLOW DELETE OF LAST ITEM ON PO.
      *----- NEED TO DELETE ENTIRE PO.
           IF DELETE-LAST-ITEM-SW = "N"
               MOVE ITM-PO-RCV-NO TO CNUMITMS-PO-NUMBER
               MOVE 0             TO CNUMITMS-NUM-ITEMS
               CALL "CNUMITMS" USING CNUMITMS-PARMS
               IF CNUMITMS-NUM-ITEMS = 1
      *        *** CANNOT DELETE LAST ITEM ON PO; DELETE ENTIRE PO ***
                   MOVE   3 TO LANG-SETNUM
                   MOVE 642 TO LANG-MSGNUM
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE 9  TO FIELD-NUMBER
                   PERFORM 4-PGM-ERROR  THRU  4-PGM-ERROR-X
                   GO TO 66-SHOWFORM-SCREEN-5B.

      *-------- IF NON-RECEIVABLE PO, CHECK TO SEE IF INVOICES EXIST
      *-------- FOR THE ITEM.
           IF PO-NON-RCV-INDIC > SPACES
               PERFORM 663-CHECK-FOR-INVOICES THRU 663-CFI-X
               IF INVOICE-FOUND-SW = "Y"
      *            *** INVOICE EXISTS FOR THIS ITEM; CANNOT DELETE ***
                   MOVE   9 TO LANG-SETNUM
                   MOVE 117 TO LANG-MSGNUM
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE 9  TO FIELD-NUMBER
                   PERFORM 4-PGM-ERROR  THRU  4-PGM-ERROR-X
                   GO TO 66-SHOWFORM-SCREEN-5B
               END-IF
           ELSE
067700*----- CHECK IF NO DELIVERY; CANT DELETE IN NO DELIVERY
067800     IF ITM-QTY-DLVR = 0
067900         NEXT SENTENCE
068000     ELSE
068100*        *** MAY NOT BE DELETED BECAUSE OF DELIVERY ***
068200         MOVE  13 TO LANG-SETNUM
068300         MOVE  16 TO LANG-MSGNUM
068400         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
068500         MOVE 9  TO FIELD-NUMBER
068600         PERFORM 4-PGM-ERROR  THRU  4-PGM-ERROR-X
068700         GO TO 66-SHOWFORM-SCREEN-5B.
068800
069300 66-PROCESS-DELETE.
070000     IF DE5-CODE = "NC"
070100         GO TO 66-DELETE-DPOITEM.
070200
070300********************************************
070400**   GET MSTORERM BUFFER FOR USE LATER
070500**   WHEN CUTTING ITEM TCs
070600********************************************
070700     MOVE ITM-CORP-CODE       TO  CODE-ARG.
           MOVE 0 TO COND-WORD.
           MOVE CODE-ARG TO CORPCDE OF MSTORERM-REC-I.
           READ MSTORERM-I INTO BUF-MSTORERM
               INVALID KEY MOVE 17 TO COND-WORD.
           IF FILE-STATUS-1 = "2"
               MOVE 17 TO COND-WORD
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD.
070800*A   CALL "DBGET" USING BASE, DSET-MSTORERM, MODE7,
070900*A          STATUS-AREA, ALL-ITEMS, BUF-MSTORERM, CODE-ARG.
071000     IF COND-WORD NOT = 0
071100         MOVE "GET MSTORERM * 66-PD" TO BU-DISPLAY-MSG
071200         GO TO 2-BLOWUP.
071300
071400**********************************************************
071500**  CALL 'SVENPRC' TO DELETE THE VENDOR PRICE SEGMENT
071600**  'DVENDITM' IF THIS ENTRY CONTAINS NO RECEIVING
071700**  HISTORY (ALL 3 LTs = ZEROS)
071800**********************************************************
071900
072000     MOVE SPACES                  TO  SVENPRC-PARMS.
072100     MOVE "D"                     TO  SVENPRC-FLAG.
072200     MOVE CODE-ARG                TO  SVENPRC-CODE.
072300     MOVE PO-VEN-CODE             TO  SVENPRC-VEN-CODE.
072400     MOVE ZEROS                   TO  SVENPRC-PRICE.
072500     CALL "SVENPRC" USING BASE,
072600                          SVENPRC-PARMS,
072700                          STATUS-AREA,
072800                          BU-DISPLAY-MSG,
072900                          BU-DISPLAY-FLDS.
073000     IF BU-DISPLAY-MSG-1  NOT = SPACES
073100         GO TO 2-BLOWUP.
