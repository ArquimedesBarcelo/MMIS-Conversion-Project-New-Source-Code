073300 66-DELETE-DPOITEM.
      *********************************************************
      **   GET THE ITEM FOR UPDATE AFTER SCREEN READ
      *********************************************************
           MOVE PO-ARG           TO  PORCVNO OF DPOITEM-REC-O.
           MOVE DE5-ITEM         TO  ITEMNO OF DPOITEM-REC-O.
           READ DPOITEM-O INTO BUF-DPOITEM
               INVALID KEY MOVE "2" TO FILE-STATUS-1.
           IF FILE-STATUS-1 = "2"
069500*        *** ITEM NO LONGER EXISTS; PLEASE EXIT AND TRY ANOTHER
069600         MOVE  66109 TO CATREAD-MSG-NUMBER
069800         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
069900         MOVE 9  TO FIELD-NUMBER
070000         PERFORM 4-PGM-ERROR  THRU  4-PGM-ERROR-X
070100         GO TO 66-SHOWFORM-SCREEN-5B
070200     ELSE
           IF FILE-STATUS NOT = "00"
070300         MOVE "READ DPOITEM * 62-GL" TO BU-DISPLAY-MSG
070400         GO TO 2-BLOWUP.

           MOVE 0 TO COND-WORD.
           DELETE DPOITEM-O INVALID KEY MOVE "2" TO FILE-STATUS-1.
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD.
074300*A   CALL "DBDELETE" USING BASE, DSET-DPOITEM, MODE1,
074400*A       STATUS-AREA.
074500     IF COND-WORD NOT = 0
074600         MOVE "DELETE DPOITEM * 66-DD" TO BU-DISPLAY-MSG
074700         GO TO 2-BLOWUP.
075300
075400**************************
075500*                        *
075600*  FIND ALL DPODATAITM   *
075700*  RECORDS FOR THE ITEM  *
075800*  AND DELETE THEM       *
075900*                        *
076000**************************
076100
           MOVE 0 TO COND-WORD.
           MOVE PO-ARG TO PORCVNO OF DPODATAITM-REC-O.
           START DPODATAITM-O KEY = PORCVNO OF DPODATAITM-REC-O
               INVALID KEY MOVE "2" TO COND-WORD.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
                   GO TO 66-UNLOCK-DPODATAITM
               ELSE
                   MOVE 99 TO COND-WORD.
076300*A   CALL "DBFIND" USING BASE, DSET-DPODATAITM, MODE1,
076400*A       STATUS-AREA, PO-SEARCH, PO-ARG.
076500     IF COND-WORD NOT = 0
076600         MOVE "FIND DPODATA * 66-FD" TO BU-DISPLAY-MSG
076700         GO TO 2-BLOWUP.
076800
077900 66-GET-DPODATAITM.
           MOVE 0 TO COND-WORD.
           READ DPODATAITM-O NEXT INTO BUF-DPODATAITM
               AT END MOVE 15 TO COND-WORD.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   MOVE 15 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.
           IF PORCVNO OF DPODATAITM-REC-O NOT = PO-ARG
               MOVE 15 TO COND-WORD.
078000*A   CALL "DBGET" USING BASE, DSET-DPODATAITM, MODE5,
078100*A       STATUS-AREA, ALL-ITEMS, BUF-DPODATAITM, PO-ARG.
078200     IF COND-WORD = ZERO
078300         IF DATAITM-ITEM-NO = DE5-ITEM
                   DELETE DPODATAITM-O INVALID KEY
                       MOVE "2" TO FILE-STATUS-1 END-DELETE
                   IF FILE-STATUS NOT = "00"
078700                 MOVE "DELETE DPODATA * 66-GD" TO BU-DISPLAY-MSG
078900                 GO TO 2-BLOWUP
079000             ELSE
079100                 GO TO 66-GET-DPODATAITM
079200         ELSE
079300             IF DATAITM-ITEM-NO < DE5-ITEM
079400                 GO TO 66-GET-DPODATAITM
079500             ELSE
079600                 NEXT SENTENCE
079700     ELSE
079800         IF COND-WORD = 15
079900              NEXT SENTENCE
080000         ELSE
080100            MOVE "GET DPODATA * 66-GD" TO BU-DISPLAY-MSG
080200             GO TO 2-BLOWUP.
080300
080400 66-UNLOCK-DPODATAITM.
      *------ DO A START ON DPODATAITM TO FREE UP LOCKS
           MOVE HIGH-VALUES TO PORCVNO OF DPODATAITM-REC-O.
           START DPODATAITM-O KEY > PORCVNO OF DPODATAITM-REC-O
               INVALID KEY MOVE "00" TO FILE-STATUS.
081100     IF DE5-REQ-NO  =  "NONE  "
081200         NEXT SENTENCE
081300     ELSE
081400         PERFORM 662-MODIFY-REQ THRU 662-MR-X.
081500
081600
081700****************************************************
081800**  CALL "STC320"  TO CUT THE TC 321 AND 322 THEN
081900**  RETURN AND CUT THE 32D TC
082000****************************************************
082100
082200     MOVE SPACES                  TO  STC320-PARMS.
082300     MOVE COMPANY-SAVE            TO  STC320-COMPANY-SAVE.
082400     MOVE "21"                    TO  STC320-ITEM-TC-ID.
082500     MOVE BUILD-PO-SEARCH         TO  STC320-PO-NUM.
082600     MOVE ITM-NUMBER              TO  STC320-ITEM.
082700     MOVE DE5-CODE                TO  STC320-CODE.
082800     IF DE5-CODE = "NC"
082900         MOVE ITM-UM              TO  STC320-QTY-UM,
083000                                      STC320-PRICE-UM
083100     ELSE
083200         MOVE STR-UM              TO  STC320-QTY-UM,
083300                                      STC320-PRICE-UM.
083400     MOVE ZEROS                   TO  STC320-QTY,
083500                                      STC320-PRICE.
083600     IF DE5-REQ-NO  =  "NONE  "
083700         NEXT SENTENCE
083800     ELSE
083900         MOVE DE5-REQ-NO          TO  STC320-REQ-NO.
084000     MOVE ITM-TAX-CODE            TO  STC320-TAX-CODE.
084100
084200     IF DE5-CODE = "NC"
084300         NEXT SENTENCE
084400     ELSE
084500         IF ITM-UM = STR-UM
084600             MOVE ITM-QTY-ORD     TO  ITM-QTY-ORD
084700         ELSE
084800         IF ITM-UM = STR-UM1
084900             MULTIPLY ITM-QTY-ORD BY  STR-UM1-CF
085000                                 GIVING ITM-QTY-ORD ROUNDED
085100         ELSE
085200         IF ITM-UM = STR-UM2
085300             MULTIPLY ITM-QTY-ORD BY  STR-UM2-CF
085400                                 GIVING ITM-QTY-ORD ROUNDED
085500         ELSE
085600             MOVE ZEROS           TO  ITM-QTY-ORD.
085700
085800     IF DE5-CODE  = "NC"
085900         NEXT SENTENCE
086000     ELSE
086100         IF ITM-PRICE-UM = STR-UM
086200             MOVE ITM-UNIT-PRICE  TO  ITM-UNIT-PRICE
086300         ELSE
086400         IF ITM-PRICE-UM = STR-UM1
086500             DIVIDE ITM-UNIT-PRICE  BY  STR-UM1-CF
086600                                     GIVING ITM-UNIT-PRICE ROUNDED
086700         ELSE
086800         IF ITM-PRICE-UM = STR-UM2
086900             DIVIDE ITM-UNIT-PRICE  BY  STR-UM2-CF
087000                                     GIVING ITM-UNIT-PRICE ROUNDED
087100         ELSE
087200             MOVE ZEROS           TO  ITM-UNIT-PRICE.
087300
087400**** MULTIPLY ITM-QTY-ORD  BY  ITM-UNIT-PRICE
087500****                     GIVING BUDGET-AMT-SAVED ROUNDED.

           MOVE ITM-QTY-ORD      TO  SCALCBGT-QTY.
           MOVE ITM-UNIT-PRICE   TO  SCALCBGT-PRICE.
           MOVE ITM-TAX-CODE     TO  SCALCBGT-TAX-CODE.
           MOVE 0                TO  SCALCBGT-BUDGET.
           CALL "SCALCBGT"  USING  SCALCBGT-PARMS.
           MOVE SCALCBGT-BUDGET  TO  BUDGET-AMT-SAVED.

087600     MOVE BUDGET-AMT-SAVED        TO  STC320-OLD-BUDGET-AMT.
087700     MOVE ITM-CLASS               TO  STC320-SUB.
087800     MOVE ITM-SUB-DETL            TO  STC320-SUBD.
087900     MOVE ITM-ADDL-DATA           TO  STC320-ADDTL-DATA.
088000     MOVE PO-BUDGET-NUMBER        TO  STC320-BUDGET-NO.
088100     MOVE PO-CURRENCY-CODE        TO  STC320-CUR-CODE.
088200     CALL "STC320" USING BASE,
088300                         STC320-PARMS,
088400                         STATUS-AREA,
088500                         BU-DISPLAY-MSG,
088600                         BU-DISPLAY-FLDS.
088700     IF BU-DISPLAY-MSG-1  NOT = SPACES
088800         GO TO 2-BLOWUP.
088900
089000**********************************************************
089100**   CUT A '32D' TRANSACTIONS WHICH IS THE ITEM DELETE
089200**   TRANSACTION.
089300**********************************************************
089400
089500     MOVE SPACES                    TO  BUF-DDAILYTC.
           ACCEPT DDAILYTC-DATE FROM DATE.
           ACCEPT DDAILYTC-TIME FROM TIME.
090000     MOVE COMPANY-SAVE              TO  DDAILYTC-PLT.
090100     MOVE "32D"                     TO  DDAILYTC-TC.
090200     MOVE ITM-CORP-CODE             TO  TC32D-CORP-CODE.
090300     MOVE BUILD-PO-SEARCH           TO  TC32D-PO-RLS.
090400     MOVE ITM-NUMBER                TO  TC32D-ITEM-NO.
091000
           MOVE 0 TO COND-WORD.
           WRITE DDAILYTC-REC-O FROM BUF-DDAILYTC
               INVALID KEY MOVE 99 TO COND-WORD.
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD.
091100*A   CALL "DBPUT" USING BASE, DSET-DDAILYTC, MODE1,
091200*A        STATUS-AREA, ALL-ITEMS, BUF-DDAILYTC.
091300     IF COND-WORD NOT = 0
091400         MOVE "PUT DDAILYTC * 66-CT3" TO BU-DISPLAY-MSG
091500         GO TO 2-BLOWUP.
092100
      ***********************************************************
      **   CALL "SEDIPOLG" TO WRITE AN EDILOG RECORD IF THE
      **   ITEM DELETED AFFECTS AN EDI PURCHASE ORDER AGREEMENT
      ***********************************************************
           IF SEDIVNCK-EDI-IND = "Y"
               MOVE SPACES           TO  SEDIPOLG-PARMS
               MOVE BUILD-PO-SEARCH  TO  PO-NUMBER-EDI
               MOVE PO-VEN-CODE      TO  VENDOR-CODE-EDI
               MOVE "X"              TO  FLAG-EDI-D
               MOVE ITM-NUMBER       TO  PO-ITEM-NO-EDI
               MOVE "SDELSITM"       TO  CALLING-PGM-EDI
               CALL "SEDIPOLG" USING BASE,
                                     SEDIPOLG-PARMS,
                                     LANGUAGE-PARMS.

092200***********************************************************
092300**   CALL 'SMODBDGT' TO UPDATE THE TOTAL BUDGET AMOUNT IN
092400**   THE HEADER 'DPORECD' TO REFLECT THE DELETION OF THE
092500**   ITEM.
092600***********************************************************
092700
092800     IF STC320-BUDGET-AMT-NET-CHG = ZEROS
092900         NEXT SENTENCE
093000     ELSE
093100         MOVE BUILD-PO-SEARCH         TO SMODBDGT-PO-NUMBER
093200         MOVE STC320-BUDGET-AMT-NET-CHG
093300                                      TO SMODBDGT-BUDGET-NET-CHG
093400         MOVE "Y"                     TO SMODBDGT-GET-DPORECD-SW
093500         CALL "SMODBDGT" USING BASE,
093600                               SMODBDGT-PARMS,
093700                               BUF-DPORECD,
093800                               STATUS-AREA,
093900                               BU-DISPLAY-MSG,
094000                               BU-DISPLAY-FLDS
094100         IF BU-DISPLAY-MSG-1 NOT = SPACES
094200             GO TO 2-BLOWUP.
094300
094400**********************************************************
094500**   CALL 'SRCVDELT' TO DELETE ANY RECEIVING SLIP ITEMS
094600**   FOR THE PO ITEM THAT WAS DELETED.
094700**********************************************************
094800
094900     MOVE PO-ARG                  TO SRCVDELT-PO-NUMBER.
095000     MOVE ITM-NUMBER              TO SRCVDELT-ITEM-NUMBER.
095100     CALL "SRCVDELT" USING BASE,
095200                           SRCVDELT-PARMS,
095300                           STATUS-AREA,
095400                           BU-DISPLAY-MSG,
095500                           BU-DISPLAY-FLDS.
