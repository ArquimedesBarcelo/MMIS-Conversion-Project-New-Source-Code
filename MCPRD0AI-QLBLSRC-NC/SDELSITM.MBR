103700     IF COND-WORD NOT = 0
103800         MOVE "GET DREQD * 662-MR"  TO  BU-DISPLAY-MSG
103900         GO TO 2-BLOWUP.
104500
104600     MOVE SPACES               TO  DREQD-PO-RCV-NO,
104700                                   DREQD-VEN-CODE,
104800                                   DREQD-PO-ITM-NO.
           REWRITE DREQD-REC-O FROM BUF-DREQD
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE "REWRITE DREQD *662-MR" TO BU-DISPLAY-MSG
               GO TO 2-BLOWUP.
105400
           MOVE 0 TO COND-WORD.
           MOVE REQ-ARG TO REQNO OF MREQ-REC-O.
           READ MREQ-O INTO BUF-MREQ
               INVALID KEY MOVE 17 TO COND-WORD.
           IF FILE-STATUS-1 = "2"
               MOVE 17 TO COND-WORD
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD.
105500*A   CALL "DBGET" USING BASE, DSET-MREQ, MODE7, STATUS-AREA,
105600*A       ALL-ITEMS, BUF-MREQ, REQ-ARG.
105700     IF COND-WORD NOT =  0
105800         MOVE "GET MREQ * 662-GM" TO BU-DISPLAY-MSG
105900         GO TO 2-BLOWUP.
106000     MOVE SPACES   TO  REQ-PURCH-RELEASE.
106100     MOVE "X "     TO  REQ-RELEASE-STAT.
           MOVE 0 TO COND-WORD.
           REWRITE MREQ-REC-O FROM BUF-MREQ
               INVALID KEY MOVE 99 TO COND-WORD.
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD.
106200*A   CALL "DBUPDATE" USING BASE, DSET-MREQ, MODE1,
106300*A       STATUS-AREA, ALL-ITEMS, BUF-MREQ.
106400     IF COND-WORD NOT = 0
106500         MOVE "UPDATE MREQ * 662-GM" TO BU-DISPLAY-MSG
106600         GO TO 2-BLOWUP.
107200
107300 662-MR-X.
107400     EXIT.

       663-CHECK-FOR-INVOICES.
           MOVE "N" TO INVOICE-FOUND-SW.
           MOVE ITM-PO-RCV-NO TO PORCVNO OF DINVRCD-REC.
           START DINVRCD KEY = PORCVNO OF DINVRCD-REC
               INVALID KEY    MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00" GO TO 663-CFI-X.
       663-CFI-LOOP1.
           READ DINVRCD NEXT INTO BUF-DINVRCD
               AT END    MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00" GO TO 663-CFI-X.
           IF INV-PO-RCV-NO NOT = ITM-PO-RCV-NO
               GO TO 663-CFI-X.
           MOVE INV-REG-NO-9 TO REGISTERNO OF DINVITM-REC.
           MOVE ITM-NUMBER   TO ITEMNO OF DINVITM-REC.
           START DINVITM KEY = REGISTERNO OF DINVITM-REC
               INVALID KEY    MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00" GO TO 663-CFI-X.
       663-CFI-LOOP2.
           READ DINVITM NEXT INTO BUF-DINVITM
               AT END    MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00" GO TO 663-CFI-X.
           IF INVITM-REG-NO NOT = INV-REG-NO-9 GO TO 663-CFI-LOOP1.
           IF INVITM-ITEM-NO NOT = ITM-NUMBER GO TO 663-CFI-LOOP2.
           MOVE "Y" TO INVOICE-FOUND-SW.
       663-CFI-X.
           EXIT.

       COPY DISPCALL IN COPYLIB.
107500
107600 999-CATREAD.
           IF CATREAD-MSG-NUMBER = ZEROS
               MOVE LANG-SETNUM TO CATREAD-MSG-SET
               MOVE LANG-MSGNUM TO CATREAD-MSG-NUM.
           CALL "CCATREAD" USING CATREAD-PARMS.
           MOVE CATREAD-MSG-TEXT TO MESSAGE-BUFFER.
109200 999-CATREAD-EXIT.
109300     EXIT.
