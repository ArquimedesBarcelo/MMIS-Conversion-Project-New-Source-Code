           MOVE 0 TO COND-WORD.
           READ DREQD-I NEXT INTO BUF-DREQD
               AT END MOVE 15 TO COND-WORD.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   MOVE 15 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.
           IF PORCVNO OF DREQD-REC-I NOT = PO-ARG
               MOVE 15 TO COND-WORD.
099000*A   CALL "DBGET" USING BASE, DSET-DREQD, MODE5,
099100*A       STATUS-AREA, ALL-ITEMS, BUF-DREQD, PO-ARG.
099200     IF COND-WORD  NOT = 0
099300         IF COND-WORD = 15
099400             GO TO 661-CFR-X
099500         ELSE
099600             MOVE "GET DREQD * 661-GD" TO BU-DISPLAY-MSG
099700             GO TO 2-BLOWUP.
099800
099900     IF DREQD-PO-ITM-NO  =  ITM-NUMBER
100000         MOVE DREQD-REQ-NUMBER  TO  DE5-REQ-NO
100100     ELSE
100200         GO TO 661-GET-DREQD.
100300
100400 661-CFR-X.
100500     EXIT.
