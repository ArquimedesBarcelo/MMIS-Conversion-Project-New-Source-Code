      **************************************************************
      **                                                          **
      **            L I N K A G E   S E C T I O N                 **
      **                                                          **
      **************************************************************

       LINKAGE SECTION.

       01  BASE                          PIC X(10).
       01  MMIS-BASE                     PIC X(13).

       COPY DBSTAT     IN COPYLIB.
       COPY VCOMLINK   IN COPYLIB.
       COPY STCOM      IN COPYLIB.
       COPY TSHWSUB    IN COPYLIB.
       COPY LANGSUB    IN COPYLIB.
       COPY MULTSTR    IN COPYLIB.
       COPY ESCNAME   IN COPYLIB.

       PROCEDURE DIVISION USING BASE MMIS-BASE STATUS-AREA
                                VIEW-COMAREA STORES-COMAREA
                                SRF-COMAREA, SRF-SPOOLER-REC,
                                LANGUAGE-PARMS, MULTIPLE-STR-DATA,
                                ESC-NAME.


       1-HSK.

           MOVE 0 TO SUB, SUB2, SUB3, TABLE-LIMIT.
           MOVE "N" TO CHANGE-FLAG, DUP-FLAG.
           MOVE "N" TO WARNING-FLAG.
           MOVE " " TO WARNING-TYPE.
           MOVE 0   TO WARNING-VALUE.
           PERFORM 9999-OPEN-STUFF.

           MOVE "I"                      TO  SRF-FKEY (6).
           MOVE "Y"                      TO  SRF-MPLTINFO-FLAG,
                                             SRF-SPOOL-FLAG.
           IF SCOM-PGM-KEY = "SW3"
               MOVE "SW" TO WRKL-NO-KEY
           ELSE
               MOVE "ST" TO WRKL-NO-KEY.

      *-----5/7/97 JSB, GET VALID FRANCHISERS
           MOVE "FRAN"                   TO  PLT-ARG.
           MOVE 0 TO COND-WORD.
           MOVE PLT-ARG TO PLTINFOKEY OF MPLTINFO-REC.
           READ MPLTINFO INTO BUF-MPLTINFO
               INVALID KEY MOVE 17 TO COND-WORD.
           IF FILE-STATUS-1 = "2"
               MOVE 17 TO COND-WORD
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD.
           IF COND-WORD NOT = 0
               MOVE SPACES               TO   FRAN-TABLE
           ELSE
           MOVE MPLTINFO-FRANCHISES      TO   FRAN-TABLE.

           GO TO 6-MAIN.

       2100-BLOWUP.
           MOVE DE-WL-NO TO BU-DISPLAY-FLD (1).
           MOVE "TIRWSMOD"               TO   BU-PGM-NAME.
           CALL "TBLOWUP" USING BASE BU-PGM-NAME STATUS-AREA
             VIEW-COMAREA FILE-STATUS BU-DISPLAY-MSG
             BU-DISPLAY-FLDS.

       4-CLEAR-FORM-2.
           MOVE SPACES TO MESSAGE-BUFFER.
           PERFORM 9999-PUTWINDOW.
           MOVE SPACES TO DE-EMPL, DE-WO, DE-REQ-DEPT, DE-CHARGE-DEPT,
                          DE-EXP-CLASS, DE-QTY-X (1), DE-QTY-X (2),
                          DE-QTY-X (3), DE-QTY-X (4), DE-QTY-X (5),
                          DE-QTY-X (6).

           PERFORM 9999-PUTBUFFER-2.

       6-MAIN.
       6-GET-FORM1.
           IF SCOM-PGM-KEY = "SW3"
               IF AKRON-PLANT
                   MOVE "ISWSMOD1_AK"    TO   VIEW-NFNAME
               ELSE
                   MOVE "ISWSMOD1"       TO   VIEW-NFNAME
           ELSE
               IF AKRON-PLANT
                   MOVE "RTWSMOD1_AK"    TO   VIEW-NFNAME
               ELSE
                   MOVE "RTWSMOD1"       TO   VIEW-NFNAME.

           PERFORM 9999-GETNEXTFORM.
           PERFORM 9999-INITFORM.
           MOVE SPACES TO DE-FIELDS-1.

       61-SHOWFORM-1.
      *----- f1, f2 APPLICATIONS, f3 INVALID, f4 REFRESH, f5 PRINT,
      *----- f6 INVALID, f7 CLEAR, f8 EXIT
           MOVE 5                        TO   SRF-KEYSET.
           MOVE SPACES                   TO   DE-DELETE-INDIC.
           MOVE 1 TO SRF-MODE.
       6110-SHOWFORM.
           PERFORM 9999-DO-SCREEN-1.

           IF VIEW-LASTKEY = EXIT-PROGRAM OR F1-KEY OR F2-KEY
               GO TO 6-MAIN-X.

      *------ IF THEY LEAVE CODES BLANK, DEFAULT TO 'ALL'
           IF DE-WS-CODES = SPACES
               MOVE "ALL"                TO   DE-WS-CODE (1).

           MOVE DE-WL-NO TO SHIFT-FLD.
           CALL "TRSHIFT" USING RET-CODE, SHIFT-FLD.
           MOVE SHIFT-FLD-5-8 TO DE-WL-NO.

           MOVE DE-WL-NO TO WRKL-NO-INC.
           MOVE WL-ARG TO LOCK-VALUE, LOCK-VALUE-2.
           PERFORM 9999-MULTI-LOCK.
           PERFORM 9999-GETKEY-MWRKLIST-WK-I.
           IF NO-ENTRY OR DE-WL-NO EQUAL "0000"
               PERFORM 9999-UNLOCK
      *        "W16: WORKSHEET NUMBER DOES NOT EXIST"
               MOVE 23016 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER TO MSG-TEXT
               MOVE WRKL-NO-INC                        TO MSG-FLD-9
               MOVE 1 TO SRF-ERROR-FLD
               GO TO 61-SHOWFORM-1.

           IF DE-DELETE-INDIC = "X"
               CALL "TIRWSDLT" USING WSDLT-RET-CODE, WSDLT-MODE,
                 WL-ARG, BASE, STATUS-AREA, BU-DISPLAY-MSG,
                 WSDLT-AREA
               IF WSDLT-RET-CODE NOT = 0
                   PERFORM 2100-BLOWUP
               ELSE
                   MOVE SPACES TO DE-FIELDS-1
      *
      * E26: WORKSHEET DELETED
      *
                   MOVE 23026 TO CATREAD-MSG-NUMBER
                   PERFORM 999-CATREAD
                   MOVE MESSAGE-BUFFER TO MSG-TEXT
                   MOVE WRKL-NO-INC TO MSG-FLD-9
                   MOVE 1 TO SRF-ERROR-FLD
                   GO TO 61-SHOWFORM-1.

       62-GET-WORKLIST.
           PERFORM 9999-CHAINHD-DWLITEM-WK-O.
           PERFORM 9999-GETNEXT-DWLITEM-WK-O.
           IF NO-ENTRY
               PERFORM 9999-UNLOCK
      *        "W16: WORKSHEET NUMBER DOES NOT EXIST"
               MOVE 23016 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER TO MSG-TEXT
               MOVE WRKL-NO-INC                        TO MSG-FLD-9
               MOVE 1 TO SRF-ERROR-FLD
               GO TO 61-SHOWFORM-1.

           MOVE SPACES TO WORK-LIST-TABLE.
       621-LOAD-TABLE.
           MOVE 0 TO TABLE-LIMIT.
           PERFORM VARYING SUB FROM 1 BY 1
                   UNTIL END-OF-CHAIN

             ADD 1 TO TABLE-LIMIT
             MOVE WL-RCD-DATA  TO  WLT-RCD (SUB)
             PERFORM 9999-GETNEXT-DWLITEM-WK-O

           END-PERFORM.
       63-CHECK-CODES.
           MOVE 0 TO SUB.
       631-CHECK-CODE-LOOP.
           ADD 1 TO SUB.
           IF SUB > 14
               GO TO 64-GETFORM-2.

           IF DE-WS-CODE (1) = "ALL"
               IF WLT-CODE (SUB) > SPACES
                    MOVE "Y"       TO  WLT-MOD-SW (SUB)
                    GO TO 631-CHECK-CODE-LOOP.

           IF DE-WS-CODE (SUB) = SPACES
               GO TO 631-CHECK-CODE-LOOP.
           MOVE ZERO TO SUB2.
       632-CHECK-CODE-LOOP2.
           ADD 1 TO SUB2.
           IF SUB2 > TABLE-LIMIT
               PERFORM 9999-UNLOCK
      *        "C109: CODE IS NOT ON THIS WORKSHEET"
               MOVE 03109 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER TO MSG-TEXT
               MOVE DE-WS-CODE (SUB)                    TO MSG-FLD
               ADD 1, SUB GIVING SRF-ERROR-FLD
               GO TO 61-SHOWFORM-1.

           IF DE-WS-CODE (SUB) = WLT-CODE (SUB2)
               MOVE "Y" TO WLT-MOD-SW (SUB2)
               GO TO 631-CHECK-CODE-LOOP.
           GO TO 632-CHECK-CODE-LOOP2.

       64-GETFORM-2.
      *---------- ISSUE OR RETURN WORKSHEET MODIFY HAVE DIFFERENT FORMS.
      *---------- FOR EACH, THERE IS A SPECIAL FORM FOR AKRON PLANTS.
           IF SCOM-PGM-KEY = "SW3"
               IF AKRON-PLANT
                   MOVE "ISWSMOD2_AK"    TO   VIEW-NFNAME
               ELSE
                   MOVE "ISWSMOD2"       TO   VIEW-NFNAME
           ELSE
               IF AKRON-PLANT
                   MOVE "RTWSMOD2_AK"    TO   VIEW-NFNAME
               ELSE
                   MOVE "RTWSMOD2"       TO   VIEW-NFNAME.

           PERFORM 9999-GETNEXTFORM.

           MOVE 0 TO SUB.
       64-BUILD-SCREEN.
           ADD 1 TO SUB.
           IF SUB > TABLE-LIMIT
               GO TO 66-UPDATE-WORKSHEET.

           IF WLT-MOD-SW (SUB) NOT = "Y"
               GO TO 64-BUILD-SCREEN.

           MOVE WLT-CODE (SUB) TO CODE-ARG.
           PERFORM 9999-GETKEY-MSTORERM-CD-I.

      *-----  INITIALIZE WARNING-FLAG FOR TQTYEDIT FOR RETURN LIMITS
      *-----  DONE HERE SO EACH QTY ON WORKSHEET CHECKED AT LEAST ONCE
           MOVE "N" TO WARNING-FLAG.

           MOVE "N" TO CHANGE-FLAG.
           PERFORM 8-BUILD-SCREEN THRU 89-BS-X.
           PERFORM 9999-RESET-SCREEN.

       65-SHOWFORM-2.
      *----- f1, f2, f3 INVALID, f4 REFRESH, f5 PRINT, f6 INVALID, f7 CL
           MOVE 7                        TO   SRF-KEYSET.
           MOVE 1 TO SRF-MODE.
           IF STR-CODE-OWNER NOT = SPACES
               MOVE B"1" TO IND(95)
           ELSE
               MOVE B"0" TO IND(95).
       6510-SHOWFORM.
           PERFORM 9999-DO-SCREEN-2.

           IF VIEW-LASTKEY = EXIT-PROGRAM
               GO TO 66-UPDATE-WORKSHEET.
           IF VIEW-LASTKEY = F7-KEY
               PERFORM 4-CLEAR-FORM-2
               GO TO 65-SHOWFORM-2.

      *---------- IF THE USER HAS CHANGED THE CORP CODE, MAKE SURE
      *---------- IT DOES NOT DUPLICATE ANOTHER CODE ON THE WORKSHEET.
           IF DE-CODE NOT = WLT-CODE (SUB)
               MOVE "N"                  TO  DUP-FLAG
               MOVE 0                    TO  SUB3
               PERFORM 70-CHECK-DUPLICATES UNTIL SUB3 = TABLE-LIMIT
               IF DUP-FLAG = "Y"
      *            "C108: CANNOT DUPLICATE STORES CODE ON WORKSHEET"
                   MOVE 03108 TO CATREAD-MSG-NUMBER
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE 2                TO  SRF-ERROR-FLD
                   GO TO 65-SHOWFORM-2.

      *---------- IF THE USER HAS CHANGED THE CORPORATE CODE ON THE
      *---------- WORKSHEET ITEM, WE HAVE TO RE-GET THE CODE FOR
      *---------- QUANITY DATA, AS WELL AS TO VERIFY THAT THE NEW CODE
      *---------- ENTERED EXISTS.  ALSO, WE REDISPLAY THE NEW CODES
      *---------- DESCRIPTION, LOCATIONS, ETC (ESP. IN CASE OF LOCATION
      *---------- DOES NOT EXIST ERROR).
           IF DE-CODE NOT = WLT-CODE (SUB)
               MOVE DE-CODE              TO  CODE-ARG
               PERFORM 9999-GETKEY-MSTORERM-CD-I
               IF NO-ENTRY
      *            "S9: STORES CODE DOES NOT EXIST"
                   MOVE 19009 TO CATREAD-MSG-NUMBER
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE 2                     TO SRF-ERROR-FLD
                   GO TO 65-SHOWFORM-2
               ELSE
                   MOVE "Y"              TO   CHANGE-FLAG
      *-----  INITIALIZE WARNING-FLAG FOR TQTYEDIT FOR RETURN LIMITS
      *-----  DONE HERE SO EACH QTY ON NEW CODE CHECKED AT LEAST ONCE
                   MOVE "N" TO WARNING-FLAG
                   MOVE WLT-CODE(SUB) TO OLD-CHANGE-CODE
                   MOVE DE-CODE TO WLT-CODE(SUB)
                   PERFORM 8-BUILD-SCREEN THRU 89-BS-X
      *            "C191: CORPORATE CODE CHANGED: HIT ENTER TO UPDATE"
                   MOVE 03191 TO CATREAD-MSG-NUMBER
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE 2 TO SRF-ERROR-FLD
                   GO TO 65-SHOWFORM-2.

           MOVE SRF-MPLTINFO-COMPANY     TO   EDIT-PLANT-CODE.
           MOVE CORP-CODE                TO   EDIT-CODE.
           MOVE DE-EMPL                  TO   EDIT-EMPL.
           MOVE DE-WO                    TO   EDIT-WO.
           MOVE DE-REQ-DEPT              TO   EDIT-REQ-DEPT.
           MOVE DE-CHARGE-DEPT           TO   EDIT-CHARGE-DEPT.
           MOVE DE-EXP-CLASS             TO   EDIT-EXP-CLASS.
           MOVE STR-RESTRICTED-FLG       TO   EDIT-RESTRICTED-FLG.
           MOVE STR-REQ-CHG-OVERRD       TO  EDIT-REQ-CHG-OVERRD.
           MOVE STR-DIR-CHRG-DEPT        TO  EDIT-DIR-CHRG-DEPT.

           IF SCOM-PGM-KEY = "SW3"
               MOVE "IS" TO RET-CODE
           ELSE
               MOVE "RT" TO RET-CODE.
           CALL "TIREDIT" USING RET-CODE, BASE, MMIS-BASE, PART-WORKAREA,
             STATUS-AREA, EDIT-DATA, MESSAGE-BUFFER, MULTIPLE-STR-DATA,
             STORES-COMAREA, STR-EXPENSE-CLASS, LANGUAGE-PARMS.
           IF RET-CODE = "BU"
               MOVE "TIREDIT ERROR 631-RF" TO BU-DISPLAY-MSG
               PERFORM 2100-BLOWUP.

           MOVE EDIT-EMPL                   TO  DE-EMPL.
           MOVE EDIT-WO                     TO  DE-WO.
           MOVE EDIT-REQ-DEPT               TO  DE-REQ-DEPT.
           MOVE EDIT-CHARGE-DEPT            TO  DE-CHARGE-DEPT.
           MOVE EDIT-EXP-CLASS              TO  DE-EXP-CLASS.

           IF MESSAGE-BUFFER NOT = SPACES
               COMPUTE SRF-ERROR-FLD = EDIT-SUB + 5
               GO TO 65-SHOWFORM-2.

           IF SCOM-PGM-KEY = "SW3"
               MOVE "I2"  TO  RET-CODE
           ELSE
               MOVE "R2"  TO  RET-CODE.

           MOVE 0 TO LANG-SETNUM.
           MOVE SPACES TO MESSAGE-BUFFER-1.
           CALL "TQTYEDIT" USING RET-CODE, BASE, STATUS-AREA,
             CODE-ARG, DE-WO, STR-ONHAND, STR-RESERVED, STR-LOC-AREA,
             DE-BIN-AREA, EDIT-TOTAL-QTY, ISSUED-QTY, RET-SUB,
             MESSAGE-BUFFER, MULTIPLE-STR-DATA,
             LANGUAGE-PARMS, WARNING-FLAG, WARNING-TYPE,
             WARNING-VALUE, STR-AVG-COST, DE-CHARGE-DEPT-1-4,
             DE-EXP-CLASS, DE-EMPL, STR-UM, STR-MAX, STR-REORDER
             STR-CODE-OWNER FRAN-TABLE.
           IF RET-CODE NOT = "00"
               MOVE "TQTYEDIT ERROR" TO BU-DISPLAY-MSG
               PERFORM 2100-BLOWUP.

           IF ( MESSAGE-BUFFER-1 NOT EQUAL SPACE ) AND
              ( MESSAGE-BUFFER-1-3 NOT = "Q19")
             COMPUTE SRF-ERROR-FLD = 2 * RET-SUB + 12
             GO TO 65-SHOWFORM-2.

           MOVE DE-CHARGE-DEPT           TO  WLT-CHARGE-DEPT (SUB).
           MOVE DE-WO                    TO  WLT-WO (SUB).
           MOVE DE-WORK-CENTER           TO  WLT-WORK-CENTER (SUB).
           MOVE DE-EMPL                  TO  WLT-EMPL (SUB).
           PERFORM VARYING SUB5 FROM 1 BY 1
                   UNTIL SUB5 GREATER THAN 6

               MOVE V-LOC (SUB5)         TO  WLT-BIN (SUB, SUB5)
               MOVE DE-QTY (SUB5)    TO  WLT-QTY (SUB, SUB5)
           END-PERFORM.
           MOVE DE-REQ-DEPT              TO  WLT-REQ-DEPT (SUB).
           MOVE DE-EXP-CLASS             TO  WLT-EXP-CLASS (SUB, 6).

      *-------UPDATE CCS DATA IF RESEARCH ONLY
           IF SRF-MPLTINFO-COMPANY = "119"
              PERFORM 90-UPDATE-CCS THRU 90-EXIT.

           GO TO 64-BUILD-SCREEN.
       66-UPDATE-WORKSHEET.
           PERFORM 9999-CHAINHD-DWLITEM-WK-O.
           PERFORM 9999-GETNEXT-DWLITEM-WK-O.
           PERFORM UNTIL END-OF-CHAIN
             PERFORM 9999-DELETE-DWLITEM-WK-O
             PERFORM 9999-GETNEXT-DWLITEM-WK-O
           END-PERFORM.

           MOVE WL-ARG TO WL-KEY.
           PERFORM VARYING SUB FROM 1 BY 1
                   UNTIL SUB GREATER THAN TABLE-LIMIT
             MOVE WLT-RCD(SUB) TO WL-RCD-DATA
             PERFORM 9999-PUT-DWLITEM-WK-O
           END-PERFORM.

           PERFORM 9999-UNLOCK.
       671-CLEAR-FORM.
           GO TO 6-GET-FORM1.

       6-MAIN-X.
           PERFORM 9999-CLOSE-STUFF.
           GOBACK.

      **************************************************************
      **                                                          **
      **     P E R F O R M E D   R O U T I N E S                  **
      **                                                          **
      **************************************************************

       70-CHECK-DUPLICATES.
           ADD 1                         TO  SUB3.
           IF DE-CODE = WLT-CODE (SUB3)
               MOVE "Y"                  TO  DUP-FLAG.

       8-BUILD-SCREEN.
           MOVE STR-DISB-INSTR  TO  V-DISB.
           MOVE 2                        TO   CDESC-LINES-TO-GET.
           MOVE "N"                      TO   CDESC-LOCAL-DESC-OPTION.
           CALL "CDESC" USING CDESC-RET-CODE, BASE, STATUS-AREA,
             BU-DISPLAY-MSG, CODE-ARG, CDESC-DATA.
           IF BU-DISPLAY-MSG-1 NOT = SPACES
               PERFORM 2100-BLOWUP.

           MOVE WRKL-NO-INC              TO   V-WL-NO.
           MOVE CDESC (1)                TO   V-KWD-ADJ.
           MOVE CDESC (2)                TO   V-DESC.
           MOVE STR-UM                   TO   V-UM.
           IF CHANGE-FLAG = "N"
              MOVE WLT-CODE (SUB)        TO   DE-CODE
              MOVE WLT-EMPL (SUB)        TO   DE-EMPL
              MOVE WLT-WO (SUB)          TO   DE-WO
              MOVE WLT-WORK-CENTER (SUB) TO   DE-WORK-CENTER
              MOVE WLT-REQ-DEPT (SUB)    TO   DE-REQ-DEPT
              MOVE WLT-CHARGE-DEPT (SUB) TO   DE-CHARGE-DEPT
              MOVE WLT-EXP-CLASS (SUB, 6) TO  SHIFT-FLD
               CALL "TLSHIFT" USING RET-CODE, SHIFT-FLD
               MOVE SHIFT-FLD            TO   DE-EXP-CLASS.

           MOVE 0 TO SUB2.
       81-BUILD-LOCS.
           ADD 1 TO SUB2.
           IF SUB2 > 6
               GO TO 89-BS-X.
           MOVE STR-LOC (SUB2)           TO   V-LOC (SUB2).
           IF CHANGE-FLAG = "Y"
               MOVE DE-QTY (SUB2)        TO   SHIFT-FLD
           ELSE
               MOVE WLT-QTY (SUB, SUB2)  TO   SHIFT-FLD.
           IF SHIFT-FLD = ZEROS
               CALL "TLSHIFT" USING RET-CODE, SHIFT-FLD.
           MOVE SHIFT-FLD                TO   DE-QTY (SUB2).

           IF V-LOC (SUB2) = SPACES
             MOVE SPACES             TO  DE-LOC-ONHX (SUB2)
           ELSE
             PERFORM 900-GET-FRAN-NAME THRU 900-GET-FRAN-NAME-X
             MOVE STR-LOC-ONHAND (SUB2)
                                      TO  DE-LOC-ONHAND (SUB2).

           GO TO 81-BUILD-LOCS.

       89-BS-X.
           EXIT.

       90-UPDATE-CCS.
           PERFORM 99-CLEAR-SFL THRU 99-EXIT.
           MOVE 0 TO TOTAL-CCS.
           MOVE 0 TO SFL-PTR.
           MOVE SPACES TO CCS-MSG.
           MOVE B"0" TO IND(99).
           CALL "MCXRTVDTAA" USING CCS-DTAARA-NAME CCS-DTAARA.
           IF CHANGE-FLAG = "Y"
             MOVE OLD-CHANGE-CODE TO CCS-CHECK-CODE
             PERFORM 901-CHECK-CCS-MATCH THRU 901-EXIT
             IF CCS-CODE-MATCH
                MOVE OLD-CHANGE-CODE TO REMOVE-CODE
                PERFORM 91-REMOVE-CCS THRU 91-EXIT
             END-IF
             MOVE DE-CODE TO CCS-CHECK-CODE
             PERFORM 901-CHECK-CCS-MATCH THRU 901-EXIT
             IF CCS-CODE-MATCH
                PERFORM 92-SETUP-NEW-CCS THRU 92-EXIT
             END-IF
           ELSE
             PERFORM 93-GET-CURRENT-CCS THRU 93-EXIT
           END-IF.
        90-DISPLAY.
           IF SFL-PTR > 0
               PERFORM 94-DISPLAY-SFL THRU 94-EXIT
               MOVE WLT-CODE(SUB) TO REMOVE-CODE
               PERFORM 91-REMOVE-CCS THRU 91-EXIT
               MOVE "N" TO ENTRY-ERROR
               MOVE SPACES TO CCS-MSG
               MOVE B"0" TO IND(99)
               PERFORM 96-EDIT-SFL THRU 96-EXIT
                  VARYING SFL-PTR FROM 1 BY 1
                    UNTIL SFL-PTR > TOTAL-CCS OR
                          ENTRY-ERROR = "Y"
               IF ENTRY-ERROR = "Y"
                   GO TO 90-DISPLAY
               END-IF
               PERFORM 95-PROCESS-SFL THRU 95-EXIT
                  VARYING SFL-PTR FROM 1 BY 1
                    UNTIL SFL-PTR > TOTAL-CCS.
       90-EXIT.
           EXIT.

       901-CHECK-CCS-MATCH.
           IF CCS-CHECK-CODE-1-4 = "2890"
               MOVE "Y" TO CCS-CODE-MATCH-SW
           ELSE
               SET CCS-IDX TO 1
               SEARCH CCS-CODE-SEARCH
                   AT END
                     MOVE "N" TO CCS-CODE-MATCH-SW
                   WHEN CCS-CODE-ENTRY(CCS-IDX) = CCS-CHECK-CODE
                     MOVE "Y" TO CCS-CODE-MATCH-SW
               END-SEARCH
             END-IF.
       901-EXIT.
           EXIT.

       91-REMOVE-CCS.
           MOVE WL-ARG TO WLKEY OF DCCSDATA-REC.
           MOVE REMOVE-CODE TO CORPCDE OF DCCSDATA-REC.
           START DCCSDATA KEY = EXTERNALLY-DESCRIBED-KEY.
           IF FILE-STATUS NOT = "00"
              GO TO 91-EXIT.
       91-LOOP.
           READ DCCSDATA NEXT INTO BUF-DCCSDATA
              AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS = "10" OR "14" OR "46"
              GO TO 91-EXIT.
           IF FILE-STATUS NOT = "00"
               MOVE "READ DCCSDATA ERROR" TO BU-DISPLAY-MSG
               PERFORM 2100-BLOWUP.
           IF CCS-WS NOT = WL-ARG OR
              CCS-CODE NOT = REMOVE-CODE
               START DCCSDATA KEY > EXTERNALLY-DESCRIBED-KEY
               MOVE "10" TO FILE-STATUS
               GO TO 91-EXIT.
           DELETE DCCSDATA
             INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE "DELETE DCCSDATA ERROR 91" TO BU-DISPLAY-MSG
               PERFORM 2100-BLOWUP.
           GO TO 91-LOOP.
       91-EXIT.
           EXIT.

       92-SETUP-NEW-CCS.
           MOVE WLT-CODE(SUB) TO SFL-CODE.
           MOVE SFL-CODE TO CCS-CHECK-CODE.
           PERFORM 901-CHECK-CCS-MATCH THRU 901-EXIT.
           IF CCS-CODE-MATCH
      *----------WRITE N SFL RECORDS FOR THE CODE, WHERE N = TOTAL QTY
               MOVE SPACES TO SFL-USER
                              SFL-CONTAINER
                              SFL-LOCATION
               ADD 1 TO SFL-PTR
               MOVE B"0" TO IND(81)
               WRITE SUBFILE DISPLAY-REC FROM CCS-SFL
                 FORMAT IS "CCSSFL"
                 INDICATORS ARE SRF-INDICATORS
               END-WRITE
               IF DISPLAY-STATUS NOT = "00"
                 MOVE "PROBLEM ON SFL WRITE 8200" TO BU-DISPLAY-MSG
                 MOVE DISPLAY-STATUS TO FILE-STATUS
                 PERFORM 2100-BLOWUP
               END-IF
               COMPUTE TOTAL-CCS = WLT-QTY(SUB 1) + WLT-QTY(SUB 2) +
                                   WLT-QTY(SUB 3) + WLT-QTY(SUB 4) +
                                   WLT-QTY(SUB 5) + WLT-QTY(SUB 6)
               IF TOTAL-CCS > 1
                 PERFORM VARYING SUB2 FROM 2 BY 1
                  UNTIL SUB2 > TOTAL-CCS
                  ADD 1 TO SFL-PTR
                  MOVE B"1" TO IND(81)
                  WRITE SUBFILE DISPLAY-REC FROM CCS-SFL
                     FORMAT IS "CCSSFL"
                     INDICATORS ARE SRF-INDICATORS
                  END-WRITE
                  IF DISPLAY-STATUS NOT = "00"
                    MOVE "PROBLEM ON SFL WRITE 92" TO BU-DISPLAY-MSG
                    MOVE DISPLAY-STATUS TO FILE-STATUS
                    PERFORM 2100-BLOWUP
                  END-IF
                 END-PERFORM
               END-IF
           END-IF.
       92-EXIT.
           EXIT.

       93-GET-CURRENT-CCS.
           MOVE WL-ARG TO WLKEY OF DCCSDATA-REC.
           MOVE WLT-CODE(SUB) TO CORPCDE OF DCCSDATA-REC.
           START DCCSDATA KEY = EXTERNALLY-DESCRIBED-KEY.
           IF FILE-STATUS NOT = "00"
              PERFORM 92-SETUP-NEW-CCS THRU 92-EXIT
              GO TO 93-EXIT.
           COMPUTE TOTAL-CCS = WLT-QTY(SUB 1) + WLT-QTY(SUB 2) +
                               WLT-QTY(SUB 3) + WLT-QTY(SUB 4) +
                               WLT-QTY(SUB 5) + WLT-QTY(SUB 6).
           MOVE 0 TO COUNT-CCS.
       93-LOOP.
           READ DCCSDATA NEXT INTO BUF-DCCSDATA
              AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS = "10" OR "14" OR "46"
              GO TO 93-FILL.
           IF FILE-STATUS NOT = "00"
               MOVE "93 READ DCCSDATA ERROR" TO BU-DISPLAY-MSG
               PERFORM 2100-BLOWUP.
           IF CCS-WS NOT = WL-ARG OR
              CCS-CODE NOT = WLT-CODE(SUB)
               START DCCSDATA KEY > EXTERNALLY-DESCRIBED-KEY
               MOVE "10" TO FILE-STATUS
               GO TO 93-FILL.
           ADD 1 TO COUNT-CCS.
           IF COUNT-CCS > TOTAL-CCS
               DELETE DCCSDATA
                 INVALID KEY MOVE FILE-STATUS TO FILE-STATUS
               END-DELETE
               IF FILE-STATUS NOT = "00"
                   MOVE "93 DELETE DCCSDATA ERROR" TO BU-DISPLAY-MSG
                   PERFORM 2100-BLOWUP
               END-IF
           ELSE
               MOVE CCS-CODE TO SFL-CODE
               MOVE CCS-USER TO SFL-USER
               MOVE CCS-CONTAINER TO SFL-CONTAINER
               MOVE CCS-LOCATION TO SFL-LOCATION
               ADD 1 TO SFL-PTR
               IF COUNT-CCS > 1
                   MOVE B"1" TO IND(81)
               END-IF
               WRITE SUBFILE DISPLAY-REC FROM CCS-SFL
                   FORMAT IS "CCSSFL"
                   INDICATORS ARE SRF-INDICATORS
               END-WRITE
               IF DISPLAY-STATUS NOT = "00"
                 MOVE "PROBLEM ON SFL WRITE 93" TO BU-DISPLAY-MSG
                 MOVE DISPLAY-STATUS TO FILE-STATUS
                 PERFORM 2100-BLOWUP
               END-IF.
           GO TO 93-LOOP.
       93-FILL.
           IF COUNT-CCS < TOTAL-CCS
              PERFORM VARYING COUNT-CCS FROM COUNT-CCS BY 1
                 UNTIL COUNT-CCS > TOTAL-CCS
                  MOVE WLT-CODE(SUB) TO SFL-CODE
                  MOVE SPACES TO SFL-USER
                                 SFL-CONTAINER
                                 SFL-LOCATION
                  ADD 1 TO SFL-PTR
                  MOVE B"1" TO IND(81)
                  WRITE SUBFILE DISPLAY-REC FROM CCS-SFL
                     FORMAT IS "CCSSFL"
                     INDICATORS ARE SRF-INDICATORS
                  END-WRITE
                  IF DISPLAY-STATUS NOT = "00"
                    MOVE "PROBLEM ON SFL WRITE 93F" TO BU-DISPLAY-MSG
                    MOVE DISPLAY-STATUS TO FILE-STATUS
                    PERFORM 2100-BLOWUP
                  END-IF
              END-PERFORM.
       93-EXIT.
           EXIT.

       94-DISPLAY-SFL.
           WRITE SUBFILE DISPLAY-REC FROM CCS-SCREEN
              FORMAT IS "CCS"
              INDICATORS ARE SRF-INDICATORS.
           MOVE B"1" TO IND(70).
           MOVE B"1" TO IND(71).
           MOVE B"0" TO IND(72).
           MOVE B"1" TO IND(73).
           WRITE SUBFILE DISPLAY-REC FROM CCS-SFL
              FORMAT IS "CCSSFLC"
              INDICATORS ARE SRF-INDICATORS.
           IF DISPLAY-STATUS NOT = "00"
              MOVE "ERROR ON SHOW SFL WRITE 94" TO BU-DISPLAY-MSG
              MOVE DISPLAY-STATUS TO FILE-STATUS
              PERFORM 2100-BLOWUP.
           MOVE B"1" TO IND(70).
           MOVE B"1" TO IND(71).
           MOVE B"0" TO IND(72).
           MOVE B"1" TO IND(73).
           READ DISPLAY-FILE
              FORMAT IS "CCSSFLC"
              INDICATORS ARE SRF-INDICATORS.
           IF DISPLAY-STATUS NOT = "00"
              MOVE "ERROR ON SHOW SFL READ 94" TO BU-DISPLAY-MSG
              MOVE DISPLAY-STATUS TO FILE-STATUS
              PERFORM 2100-BLOWUP.
           IF VIEW-LASTKEY NOT = 0
               GO TO 94-DISPLAY-SFL.
       94-EXIT.
           EXIT.

       95-PROCESS-SFL.
           READ SUBFILE DISPLAY-FILE
              INTO CCS-SFL
              FORMAT IS "CCSSFL"
              INDICATORS ARE SRF-INDICATORS.
           IF DISPLAY-STATUS = "12" OR "23"
               NEXT SENTENCE
           ELSE
               IF DISPLAY-STATUS NOT = "00"
                  MOVE "ERROR ON PROC SFL READ" TO BU-DISPLAY-MSG
                  MOVE DISPLAY-STATUS TO FILE-STATUS
                  PERFORM 2100-BLOWUP
               ELSE
                  MOVE WL-ARG TO CCS-WS
                  MOVE SFL-CODE TO CCS-CODE
                  MOVE SFL-USER TO CCS-USER
                  MOVE SFL-CONTAINER TO CCS-CONTAINER
                  MOVE SFL-LOCATION TO CCS-LOCATION
                  WRITE DCCSDATA-REC FROM BUF-DCCSDATA
                    INVALID KEY MOVE FILE-STATUS TO FILE-STATUS
                  END-WRITE
                  IF FILE-STATUS NOT = "00"
                    MOVE "ERROR ON DCCSDATA WRITE 95" TO BU-DISPLAY-MSG
                    MOVE DISPLAY-STATUS TO FILE-STATUS
                    PERFORM 2100-BLOWUP
                  END-IF.
       95-EXIT.
           EXIT.

       96-EDIT-SFL.
           READ SUBFILE DISPLAY-FILE
              INTO CCS-SFL
              FORMAT IS "CCSSFL"
              INDICATORS ARE SRF-INDICATORS.
           IF DISPLAY-STATUS = "12" OR "23"
               NEXT SENTENCE
           ELSE
               IF DISPLAY-STATUS NOT = "00"
                  MOVE "ERROR ON PROC SFL READ" TO BU-DISPLAY-MSG
                  MOVE DISPLAY-STATUS TO FILE-STATUS
                  PERFORM 2100-BLOWUP
               ELSE
                  IF SFL-USER = SPACES OR
                     SFL-CONTAINER = SPACES OR
                     SFL-BLD = SPACES OR
                     SFL-ROOM = SPACES
               MOVE "USER, CONTAINER, BUILDING, AND ROOM ARE REQUIRED"
                           TO CCS-MSG
                       MOVE B"1" TO IND(99)
                       MOVE "Y" TO ENTRY-ERROR.
       96-EXIT.
           EXIT.

       99-CLEAR-SFL.
           MOVE B"1" TO IND(71).
           MOVE B"1" TO IND(72).
           MOVE B"0" TO IND(73).
           WRITE SUBFILE DISPLAY-REC FROM CCS-SFL
              FORMAT IS "CCSSFLC"
              INDICATORS ARE SRF-INDICATORS.
           IF DISPLAY-STATUS NOT = "00"
              MOVE "PROBLEM ON INIT SFL WRITE 99" TO BU-DISPLAY-MSG
              MOVE DISPLAY-STATUS TO FILE-STATUS
              PERFORM 2100-BLOWUP.
           MOVE B"0" TO IND(72).
       99-EXIT.
           EXIT.

       9999-OPEN-STUFF.
           OPEN INPUT MSTORERM-CD-I.
           OPEN INPUT MWRKLIST-WK-I.
           OPEN I-O DWLITEM-WK-O.
           OPEN I-O DISPLAY-FILE.
           OPEN I-O DCCSDATA.
           OPEN INPUT MPLTINFO.

       9999-CLOSE-STUFF.
           CLOSE MSTORERM-CD-I,
                 MWRKLIST-WK-I,
                 DWLITEM-WK-O,
                 MPLTINFO
                 DCCSDATA
                 DISPLAY-FILE.
       COPY HCATREAD IN COPYLIB.
       COPY SCRNCALL IN COPYLIB.
       COPY SCRNCL1  IN COPYLIB.
       COPY SCRNCL2  IN COPYLIB.
       COPY MLOCKCAL IN COPYLIB.
       COPY DLOCKCAL IN COPYLIB.
       COPY UNLOCK   IN COPYLIB.
       9999-CHAINHD-DWLITEM-WK-O.
           MOVE 0 TO COND-WORD.
           MOVE WL-ARG TO WLKEY OF DWLITEM-WK-REC-O.
           START DWLITEM-WK-O KEY = WLKEY OF DWLITEM-WK-REC-O
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF (FILE-STATUS NOT = "00") AND (FILE-STATUS-1 NOT = "2")
               MOVE 99 TO COND-WORD
               IF HANDLE-BLOWUP-FLAG = "Y"
                   MOVE "CHAINHD ERR 9999-CHAINHD-DWLITEM-WK-O"
                       TO BU-MSG-AREA
                   PERFORM 2100-BLOWUP.

       9999-DELETE-DWLITEM-WK-O.
           MOVE 0 TO COND-WORD.
           DELETE DWLITEM-WK-O
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD
               IF HANDLE-BLOWUP-FLAG = "Y"
                   MOVE "DELETE ERR 9999-DELETE-DWLITEM-WK-O"
                       TO BU-MSG-AREA
                   PERFORM 2100-BLOWUP.

       9999-GETNEXT-DWLITEM-WK-O.
           MOVE 0 TO COND-WORD.
           READ DWLITEM-WK-O NEXT INTO BUF-DWLITEM
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14"
                   PERFORM 9999-RESET-DWLITEM-WK-O
                   MOVE 15 TO COND-WORD
               ELSE
               IF FILE-STATUS = "46"
                   MOVE 15 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD
                   IF HANDLE-BLOWUP-FLAG = "Y"
                       MOVE "GETNEXT ERR 9999-GETNEXT-DWLITEM-WK-O"
                           TO BU-MSG-AREA
                       PERFORM 2100-BLOWUP
                   END-IF
           ELSE
           IF WLKEY OF DWLITEM-WK-REC-O NOT = WL-ARG
               PERFORM 9999-RESET-DWLITEM-WK-O
               MOVE 15 TO COND-WORD.

       9999-RESET-DWLITEM-WK-O.
           MOVE HIGH-VALUES TO WLKEY OF DWLITEM-WK-REC-O.
           START DWLITEM-WK-O KEY > WLKEY OF DWLITEM-WK-REC-O
               INVALID KEY MOVE "00" TO FILE-STATUS.

       9999-PUT-DWLITEM-WK-O.
           MOVE 0 TO COND-WORD.
           WRITE DWLITEM-WK-REC-O FROM BUF-DWLITEM
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD
               IF HANDLE-BLOWUP-FLAG = "Y"
                   MOVE "PUT ERR 9999-PUT-DWLITEM-WK-O"
                       TO BU-MSG-AREA
                   PERFORM 2100-BLOWUP.

       9999-GETKEY-MSTORERM-CD-I.
           MOVE 0 TO COND-WORD.
           MOVE CODE-ARG TO CORPCDE OF MSTORERM-CD-REC-I.
           READ MSTORERM-CD-I INTO BUF-MSTORERM
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS = "23"
               MOVE 17 TO COND-WORD
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD
               IF HANDLE-BLOWUP-FLAG = "Y"
                   MOVE "GETKEY ERR 9999-GETKEY-MSTORERM-CD-I"
                       TO BU-MSG-AREA
                   PERFORM 2100-BLOWUP.

       9999-GETKEY-MWRKLIST-WK-I.
           MOVE 0 TO COND-WORD.
           MOVE WL-ARG TO WLKEY OF MWRKLIST-WK-REC-I.
           READ MWRKLIST-WK-I INTO BUF-MWRKLIST
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS = "23"
               MOVE 17 TO COND-WORD
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD
               IF HANDLE-BLOWUP-FLAG = "Y"
                   MOVE "GETKEY ERR 9999-GETKEY-MWRKLIST-WK-I"
                       TO BU-MSG-AREA
                   PERFORM 2100-BLOWUP.

       900-GET-FRAN-NAME.
           IF FRAN-TABLE = SPACES
               MOVE SPACES TO DE-FRAN(SUB2)
           ELSE
               SET FRAN-IDX TO 1
               SEARCH FRAN-ENTRY
                 AT END  MOVE SPACES TO DE-FRAN (SUB2)
                 WHEN FRAN-ID(FRAN-IDX) = STR-BIN-OWNER (SUB2)
                  MOVE FRAN-NAME(FRAN-IDX) TO DE-FRAN(SUB2)
               END-SEARCH.
       900-GET-FRAN-NAME-X.
           EXIT.

