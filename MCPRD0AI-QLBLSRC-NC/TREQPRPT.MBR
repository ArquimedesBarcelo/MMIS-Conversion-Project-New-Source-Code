       LINKAGE SECTION.

030600 COPY THDPRTB IN COPYLIB.
030700
       01  OPTION-AREA.
           05  OPT-SORT                   PIC X.
           05  OPT-STORE                  PIC X.
           05  OPT-CODED-NONSTORE         PIC X.
           05  OPT-NON-STORE              PIC X.
           05  OPT-BUYER                  PIC X(4).
           05  OPT-LOW-DATE               PIC X(8).
           05  OPT-HIGH-DATE              PIC X(8).
           05  OPT-DATE-TYPE              PIC X.
           05  OPT-EXCLUDE-HOLD           PIC X.
           05  OPT-DEPT1                  PIC X(4).
           05  OPT-DEPT2                  PIC X(4).
           05  OPT-PLANT OCCURS 5 TIMES   PIC X(3).
           05  FILLER                     PIC X(64).
020700
020800 PROCEDURE DIVISION USING HD-ROUTE-DATA, OPTION-AREA.
023900
024200 PROC-DIV SECTION 01.
024300
024400 BEGIN-HERE.
024500     PERFORM 1-HSK THRU 1-H-X.
           PERFORM 6-MAIN.

029900 2-EOJ.
           IF MULTIPLE-DB-PLANT = "N"
               CLOSE MPLTINFO-I MREQ-I DREQITM-I DREQD-I MBUYER-I.
      *    ELSE
      *    PERFORM 2-CLOSE-DBS VARYING DB-SUB FROM 1 BY 1
      *        UNTIL DB-SUB > 9.
030400     GOBACK.
024600
       2-CLOSE-DBS.
           IF BASES (DB-SUB) = SPACES
               NEXT SENTENCE
           ELSE
           MOVE BASES (DB-SUB) TO BASE.

       6-MAIN.
           IF OPT-SORT = "1"
               SORT SORT-FILE ON ASCENDING KEY SORT-MAT-TYPE
                                               SORT-BUYER-CODE
                                               SORT-REQ-NO
                   INPUT  PROCEDURE FIND-OPEN-REQ
                   OUTPUT PROCEDURE WRITE-REPORT
           ELSE
           IF OPT-SORT = "2"
               SORT SORT-FILE ON ASCENDING KEY SORT-MAT-TYPE
                                               SORT-BUYER-CODE
                                               SORT-REQ-DATE-REL-CN
                   INPUT  PROCEDURE FIND-OPEN-REQ
                   OUTPUT PROCEDURE WRITE-REPORT
           ELSE
           IF OPT-SORT = "3"
               SORT SORT-FILE ON ASCENDING KEY SORT-MAT-TYPE
                                               SORT-BUYER-CODE
                                               SORT-CLASS
                   INPUT  PROCEDURE FIND-OPEN-REQ
                   OUTPUT PROCEDURE WRITE-REPORT
           ELSE
           IF OPT-SORT = "4"
               SORT SORT-FILE ON ASCENDING KEY SORT-MAT-TYPE
                                               SORT-BUYER-CODE
                                               SORT-ORIGINATOR
                   INPUT  PROCEDURE FIND-OPEN-REQ
                   OUTPUT PROCEDURE WRITE-REPORT
           ELSE
           IF OPT-SORT = "5"
024700         SORT SORT-FILE ON ASCENDING KEY SORT-MAT-TYPE
024800                                         SORT-BUYER-CODE
                                               SORT-DEPT
                                               SORT-ORIGINATOR
025000             INPUT PROCEDURE IS FIND-OPEN-REQ
025100             OUTPUT PROCEDURE IS WRITE-REPORT
           ELSE
           SORT SORT-FILE ON ASCENDING KEY SORT-BUYER-CODE
                                           SORT-MAT-TYPE
                                           SORT-DEPT
                                           SORT-ORIGINATOR
                    INPUT PROCEDURE IS FIND-OPEN-REQ
                    OUTPUT PROCEDURE IS WRITE-REPORT.

025700 1-HSK.
           MOVE "C" TO MCXCBLERR-SCOPE.
           CALL "MCXCBLERR" USING MCXCBLERR-SCOPE.
027900     MOVE 1                       TO  DATE-MODE.
028000     CALL "TDATECHK" USING DATE-CHECK-AREA.
028100     MOVE DATE-SLASH-OUT          TO  PRT-DATE.
028200     MOVE DATE-FORMATTED-TIME-OUT TO  PRT-TIME.
028300
028400***************************************************
028500**   ACCEPT PRINT ROUTING DATA FOR THDPRT
028600***************************************************
028800     DISPLAY "HD ROUTE DATA = ", HD-ROUTE-DATA.
029200     DISPLAY "OPTION REC 1  = "  OPTION-AREA.

           IF (OPT-LOW-DATE NOT = "ALL")
               AND (OPT-HIGH-DATE NOT = SPACES)
               MOVE 3 TO DATE-MODE
               MOVE OPT-LOW-DATE TO DATE-VALIDATE-IN
               CALL "TDATECHK" USING DATE-CHECK-AREA
               MOVE DATE-YMD-OUT TO SAVE-LOW-DATE
               MOVE OPT-HIGH-DATE TO DATE-VALIDATE-IN
               CALL "TDATECHK" USING DATE-CHECK-AREA
               MOVE DATE-YMD-OUT TO SAVE-HIGH-DATE
      *--------------- ACCOUNT FOR CENTURY.
               IF SAVE-LOW-DATE-YY > "70"
                   MOVE "19"      TO  SAVE-LOW-DATE-CC
               ELSE
                   MOVE "20"      TO  SAVE-LOW-DATE-CC
               END-IF
               IF SAVE-HIGH-DATE-YY > "70"
                   MOVE "19"      TO  SAVE-HIGH-DATE-CC
               ELSE
                   MOVE "20"      TO  SAVE-HIGH-DATE-CC.

           MOVE SPACES TO BASE-AREA.
           MOVE SPACES TO SAVE-CO.
           MOVE 0 TO DB-SUB.
           OPEN INPUT PLANT-FILE.
       1-MULTIDB-READ.
           READ PLANT-FILE AT END
               CLOSE PLANT-FILE
               GO TO 1-CHECK-HOW-MANY.

           ADD 1 TO DB-SUB.
           MOVE PLANT-ID       TO BASE-PLT   (DB-SUB).
           MOVE PLANT-HOMEGRP2 TO BASE-GROUP (DB-SUB).
           MOVE "  STORES."    TO BASE-NAME  (DB-SUB).
           MOVE PLANT-LDESC    TO BASE-PLT-DESC (DB-SUB).
           GO TO 1-MULTIDB-READ.

       1-CHECK-HOW-MANY.
           IF DB-SUB = 0
               NEXT SENTENCE
           ELSE
           IF DB-SUB - 1 NOT = 0
               MOVE "Y" TO MULTIPLE-DB-PLANT.
           IF MULTIPLE-DB-PLANT = "N"
               MOVE SPACES TO OPT-PLANT (1)
                              OPT-PLANT (2)
                              OPT-PLANT (3)
                              OPT-PLANT (4)
                              OPT-PLANT (5).
029500
029600 1-H-X.
029700     EXIT.
030800
030900******************************************************
031000**                                                  **
031100**   BLOWUP ROUTINE                                 **
031200**                                                  **
031300******************************************************
031400
031500 2-BLOWUP.
031600     MOVE "TREQPRPT"              TO  BU-PGM-NAME.
031700     CALL "TBLOWUP" USING BASE, BU-PGM-NAME, STATUS-AREA,
031800         DUMMY-VIEW-AREA, DUMMY-KSAM-STAT, BU-DISPLAY-MSG,
031900             BU-DISPLAY-FLDS.
032200
032300
032400 FIND-OPEN-REQ SECTION.
           MOVE "N" TO ALL-RECORDS-PROCESSED.
           IF OPT-PLANT (1) = SPACES
               OPEN INPUT MPLTINFO-I MREQ-I DREQITM-I DREQD-I MBUYER-I
               PERFORM 60-GET-P01 THRU 60-GET-MREQ-END
               MOVE "Y" TO ALL-RECORDS-PROCESSED
           ELSE
           IF OPT-PLANT (1) = "ALL"
               PERFORM LOOP-THRU-BASES VARYING DB-SUB FROM 1 BY 1
                   UNTIL (DB-SUB > 9) OR (BASE-NAME (DB-SUB) = SPACES)
               MOVE "Y" TO ALL-RECORDS-PROCESSED
           ELSE
           PERFORM SELECT-BASES VARYING PLT-SUB FROM 1 BY 1
               UNTIL (PLT-SUB > 5) OR (OPT-PLANT (PLT-SUB) = SPACES)
           MOVE "Y" TO ALL-RECORDS-PROCESSED.
           IF ALL-RECORDS-PROCESSED = "Y" GO TO 60-G-M-X.

       LOOP-THRU-BASES.
           MOVE BASES (DB-SUB) TO BASE.
           MOVE "ALL" TO PRT-CO.
           PERFORM 60-GET-MREQ THRU 60-GET-MREQ-END.

       SELECT-BASES.
           PERFORM MATCH-PLANT-TO-BASE VARYING DB-SUB FROM 1 BY 1
               UNTIL (DB-SUB > 9) OR (BASE-PLT (DB-SUB) = SPACES).

       MATCH-PLANT-TO-BASE.
           IF OPT-PLANT (PLT-SUB) = BASE-PLT (DB-SUB)
               MOVE BASES (DB-SUB) TO BASE
               MOVE "SEL" TO PRT-CO
               PERFORM 60-GET-MREQ THRU 60-GET-MREQ-END.

       60-GET-P01.
026300******************************************
026400*                                        *
026500*   GET PLANT CODE FROM MPLTINFO USING   *
026600*   P 01 AS KEY TO BE USED ON REPORT HDR *
026700*                                        *
026800******************************************
026900
027000     MOVE "P 01"                  TO  PLT-ARG.
           MOVE PLT-ARG TO PLTINFOKEY OF MPLTINFO-REC-I.
           READ MPLTINFO-I INTO BUF-MPLTINFO
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
027400         MOVE "GET P 01 MPLTINFO *1-HSK"  TO  BU-DISPLAY-MSG
027500         MOVE PLT-ARG             TO  BU-DISPLAY-FLD (4)
027600         GO TO 2-BLOWUP.
027700     MOVE MPLTINFO-COMPANY        TO  PRT-CO.
027800
032500
       60-START-MREQ.
           MOVE SPACES TO REQNO OF MREQ-REC-I.
           START MREQ-I KEY > REQNO OF MREQ-REC-I
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
                   NEXT SENTENCE
               ELSE
                   MOVE "START MREQ * 60-SM" TO BU-DISPLAY-MSG
                   GO TO 2-BLOWUP.
028900
032600*************************************************
032700*                                               *
032800*   SERIAL GET OF MREQ (MODE2)                  *
032900*                                               *
033000*************************************************
033100
033200 60-GET-MREQ.
           READ MREQ-I NEXT INTO BUF-MREQ
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
033700             GO TO 60-GET-MREQ-END
033800         ELSE
033900             MOVE "GET MREQ *60-GM"  TO  BU-DISPLAY-MSG
034000             GO TO 2-BLOWUP.
034100
034200**************************************************
034300*                                                *
034400*   CHECK TO SEE IF REQ. HAS BEEN RELEASED BY    *
034500*   MATCONT IF SO CHECK TO SEE IF REQ. HAS BEEN  *
034600*   PROCESSED (P.O.) BY PURCHASING IF NOT IT     *
034700*   IS RELEASED TO SORT.                         *
034800*                                                *
034900**************************************************
035000
035100     IF REQ-MATCONT-RELEASE  =  "X"
035200         IF REQ-PURCH-RELEASE  =  "X"
035300             GO TO 60-GET-MREQ
035400         ELSE
035500             NEXT SENTENCE
035600     ELSE
035700         GO TO 60-GET-MREQ.
035800
034200**************************************************
034300*                                                *
034400*   CHECK USER OPTIONS TO RESTRICT WHAT GETS     *
034500*   PRINTED ON THE REPORT.                       *
034800*                                                *
034900**************************************************

           IF REQ-STATUS = "SS" OR "S"
               IF OPT-STORE NOT = "X"
                   GO TO 60-GET-MREQ.

           IF REQ-STATUS = "SN"
               IF OPT-CODED-NONSTORE NOT = "X"
                   GO TO 60-GET-MREQ.

           IF REQ-STATUS = "NM" OR "NI"
               IF OPT-NON-STORE NOT = "X"
                   GO TO 60-GET-MREQ.

           IF OPT-DATE-TYPE = "R"
               MOVE REQ-REL-MC-DATE-CN TO TEST-DATE-CN
           ELSE
               MOVE REQ-DATE-CN        TO TEST-DATE-CN.

           IF OPT-LOW-DATE = "ALL" OR SPACES
               NEXT SENTENCE
           ELSE
           IF TEST-DATE-CN < SAVE-LOW-DATE-CN
               GO TO 60-GET-MREQ
           ELSE
           IF TEST-DATE-CN > SAVE-HIGH-DATE-CN
               GO TO 60-GET-MREQ.

           IF OPT-EXCLUDE-HOLD = "Y"
               IF REQ-HOLD-STATUS-CODE > SPACES
                   GO TO 60-GET-MREQ.
           IF OPT-EXCLUDE-HOLD = "R"
               IF REQ-HOLD-STATUS-CODE > SPACES
                   NEXT SENTENCE
               ELSE
               GO TO 60-GET-MREQ.

           IF OPT-DEPT1 = "ALL" OR SPACES
               NEXT SENTENCE
           ELSE
           IF REQ-SUBD < OPT-DEPT1
               GO TO 60-GET-MREQ
           ELSE
           IF REQ-SUBD > OPT-DEPT2
               GO TO 60-GET-MREQ.

           IF OPT-PLANT (1) = "ALL" OR SPACES
               NEXT SENTENCE
           ELSE
           IF REQ-CO = OPT-PLANT (1) OR OPT-PLANT (2)
               OR OPT-PLANT (3) OR OPT-PLANT (4) OR OPT-PLANT (5)
                   NEXT SENTENCE
           ELSE
           GO TO 60-GET-MREQ.

           MOVE SPACES                  TO  SORT-RCD.
035900     MOVE MREQ-NUMBER             TO  SORT-REQ-NO,
036000                                      REQ-ARG,
036100                                      BU-DISPLAY-FLD (1).
036200     MOVE REQ-DATE-CN             TO  SORT-REQ-DATE-CN.
036300     MOVE REQ-REL-MC-DATE-CN      TO  SORT-REQ-DATE-REL-CN.
036400     MOVE REQ-DATE-WANTED-CN      TO  SORT-REQ-DATE-WANT-CN.
036500     MOVE REQ-SUB                 TO  SORT-CLASS.
036600     IF REQ-HOLD-STATUS  =  SPACES
036700         MOVE "PURCHASING"        TO  SORT-HOLD-STATUS
036800     ELSE
036900         MOVE REQ-HOLD-STATUS     TO  SORT-HOLD-STATUS.
           IF SORT-HOLD-STATUS = "RETURNED  "
               IF PRT-CO = "129"
                   GO TO 60-GET-MREQ.

037000     PERFORM 60-GET-BUYER-CODE THRU 60-GBC-X.
           IF OPT-BUYER = SPACES
               NEXT SENTENCE
           ELSE
           IF OPT-BUYER NOT = DREQD-BUYER-CODE
               GO TO 60-GET-MREQ.
037100
037200     IF REQ-MAT-TYPE = "S"
037300         MOVE "S"                 TO  SORT-MAT-TYPE
037400     ELSE
037500         MOVE "N"                 TO  SORT-MAT-TYPE.
           MOVE REQ-ORIGINATOR          TO  SORT-ORIGINATOR.
           MOVE REQ-SUBD                TO  SORT-DEPT.
           MOVE REQ-CO                  TO  SORT-CO.
037600
037700     PERFORM 60-GET-REQ-ITEM  THRU  60-GRI-X.
037800
037900     GO TO 60-GET-MREQ.
038000
038100**************************************************
038200*                                                *
038300*   GET THE ITEM INFO OF THE REQ FROM DREQITM    *
038400*   IF THERE IS NO ITEM ON THE REQ THEN MOVE     *
038500*   'XXXXXXX'  TO CORP CODE SO ON THE REPORT     *
038600*   THIS REQUISITION WILL APPEAR AND CAN BE      *
038700*   TAKEN CARE OF                                *
038800*                                                *
038900**************************************************
039000
039100 60-GET-REQ-ITEM.
039200     MOVE "N"                     TO  AT-LEAST-ONE-ITEM.
           MOVE REQ-ARG TO REQNO OF DREQITM-REC-I.
           START DREQITM-I KEY = REQNO OF DREQITM-REC-I
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
                   NEXT SENTENCE
               ELSE
039600             MOVE "FIND DREQITM *60-GRI" TO BU-DISPLAY-MSG
039700             GO TO 2-BLOWUP.
039800
039900 60-GET-DREQITM.
           READ DREQITM-I NEXT INTO BUF-DREQITM
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
034900             IF AT-LEAST-ONE-ITEM = "N"
040500                 MOVE "XXXXXXX"  TO  SORT-REQ-CODE
                       MOVE SPACES     TO  SORT-QTY-UM
                       MOVE ZEROS      TO  SORT-SOQ
040600             ELSE
040700                 GO TO 60-GRI-X
035700         ELSE
040900             MOVE "GET DREQITM * 60-GD"  TO  BU-DISPLAY-MSG
041000             GO TO 2-BLOWUP
           ELSE
           IF REQNO OF DREQITM-REC-I NOT = REQ-ARG
034900         IF AT-LEAST-ONE-ITEM = "N"
040500             MOVE "XXXXXXX"  TO  SORT-REQ-CODE
                   MOVE SPACES     TO  SORT-QTY-UM
                   MOVE ZEROS      TO  SORT-SOQ
040600         ELSE
040700             GO TO 60-GRI-X
           ELSE
041200         MOVE REQITM-CORP-CODE    TO  SORT-REQ-CODE
041300         MOVE REQITM-QTY-TO-ORD   TO  SORT-SOQ
041400         MOVE REQITM-UM           TO  SORT-QTY-UM.
041500     MOVE "Y"                     TO  AT-LEAST-ONE-ITEM.
041600     RELEASE SORT-RCD.
041700     GO TO 60-GET-DREQITM.
041800
041900 60-GRI-X.
042000     EXIT.
042100
042200
042300 60-GET-BUYER-CODE.
           MOVE REQ-ARG TO REQNO OF DREQD-REC-I.
           START DREQD-I KEY = REQNO OF DREQD-REC-I
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
                   NEXT SENTENCE
               ELSE
042700             MOVE "FIND DREQD *60-GBC" TO BU-DISPLAY-MSG
042800             GO TO 2-BLOWUP.
042900
           READ DREQD-I NEXT INTO BUF-DREQD
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
043400             MOVE SPACES               TO  SORT-BUYER-CODE
043500             GO TO 60-GBC-X
               ELSE
043700             MOVE "GET DREQD *60-GBC"  TO  BU-DISPLAY-MSG
043800             GO TO 2-BLOWUP
           ELSE
               IF REQNO OF DREQD-REC-I NOT = REQ-ARG
043400             MOVE SPACES               TO  SORT-BUYER-CODE
043500             GO TO 60-GBC-X
043900         ELSE
044000             MOVE DREQD-BUYER-CODE    TO  SORT-BUYER-CODE.
044100
044200 60-GBC-X.
044300     EXIT.
044400
       60-GET-MREQ-END.
           IF ALL-RECORDS-PROCESSED = "Y"
               GO TO 60-G-M-X.
       60-G-M-E-X.    EXIT.

044500 60-G-M-X.
044600     EXIT.
044700
044800 WRITE-REPORT SECTION.
044900
045000**************************************************
045100*                                                *
045200*  IF NO RECORDS RETURNED FROM SORT THEN PRINT   *
045300*  MSG THAT ALL REQ. HAVE BEEN PROCESSED         *
045400*                                                *
045500**************************************************
045600
045700 61-WRITE-RPT.
082000     MOVE HD-SPOOLER-NUMBER       TO  OVRPRTF-TOFILE-NUM.
           MOVE "*YES"                  TO  OVRPRTF-SHARED.
082100     MOVE HD-NO-OF-COPIES         TO  OVRPRTF-COPIES.
           PERFORM 996-OVERRIDE-PRINT-FILE.
047000
047100     OPEN OUTPUT PRINT-FILE.
047200
047500     MOVE "DHDR46.PUB"       TO  HD-FILE-NAME.
047600     CALL "THDPRT2" USING HD-RET-CODE, HD-FILE-NAME, FNUM
047700          HD-ROUTE-DATA, ESC-NAME.
047800     IF HD-RET-CODE NOT = 0
047900         MOVE "THDPRT2 ERR 61-WR" TO BU-DISPLAY-MSG
048000         MOVE HD-RET-CODE       TO BU-DISPLAY-FLD (4)
048100         GO TO 2-BLOWUP.
048200
025900     CALL "TESCSEQ" USING ESC-NAME.
026000     MOVE CHAR-1636PI     TO COMPRESS-PRINT.
026100     MOVE CHAR-10PI       TO NORMAL-PRINT.

048300***********************************************************
048400**   IF PRINTING ON A CHARACTER PRINTER (HD-PAPER-FLAG   **
048500**   NOT = "X"), WE USE COMPRESSED PRINT TO FIT 132      **
048600**   CHARACTERS ON 8.5 IN WIDE PAPER.  ALSO, IF CP, WE   **
048700**   CHANGE THE TEXT LENGTH TO 61 LINES.                 **
048800***********************************************************
048900
049000     IF PAPER-IS-132-COLS
049100         NEXT SENTENCE
049200     ELSE
049300         WRITE PRINT-RCD FROM COMPRESS-PRINT AFTER ADVANCING 0.
049400
049500     RETURN SORT-FILE
049600         AT END
049700            MOVE SPACES  TO  PRT-BUYER-CODE,
049800                             PRT-BUYER-NAME
049900            PERFORM 611-PAGE-HDR
050000            MOVE "* ALL REQUISITION HAVE BEEN PROCESSED *"
050100                TO PRINT-LINE
050200            WRITE PRINT-RCD AFTER ADVANCING 2 LINES
050300            GO TO 61-FINISH-REPORT.
050400
           MOVE SORT-CO        TO   SAVE-CO.
050500     PERFORM 611-GET-BUYER-NAME THRU 611-GBN-X.
050600     PERFORM 611-PAGE-HDR.
050700     PERFORM 61-REQ-REPORT THRU 61-REQ-REPORT-X.
050800
050900**************************************************
051000*                                                *
051100*   RETURN EACH REQ FROM SORT AND WRITE ON       *
051200*   REPORT                                       *
051300*                                                *
051400**************************************************
051500
051600 61-LOOP.
051700     RETURN SORT-FILE
051800         AT END  GO TO 61-FINISH-REPORT.
051900*---------- CONTROL BREAK ON CODED/NON-CODED, AND
052000*---------- CONTROL BREAK ON BUYER.
           IF SAVE-CO NOT = SORT-CO
               MOVE SORT-CO              TO  SAVE-CO
      *****    MOVE SORT-MAT-TYPE        TO  SAVE-MAT-TYPE
      *****    MOVE SORT-BUYER-CODE      TO  SAVE-BUYER-CODE
               PERFORM 611-GET-BUYER-NAME THRU 611-GBN-X
               PERFORM 611-PAGE-HDR
           ELSE
052100     IF SAVE-MAT-TYPE NOT = SORT-MAT-TYPE
052200         MOVE SORT-MAT-TYPE        TO  SAVE-MAT-TYPE
052300         MOVE "CODED      "        TO  PRT-STR-HDR
052400         PERFORM 611-GET-BUYER-NAME THRU 611-GBN-X
052500         PERFORM 611-PAGE-HDR
052600     ELSE
052700     IF SAVE-BUYER-CODE  NOT =  SORT-BUYER-CODE
052800         PERFORM 611-GET-BUYER-NAME THRU 611-GBN-X
052900         PERFORM 611-PAGE-HDR.
053000     PERFORM 61-REQ-REPORT  THRU  61-REQ-REPORT-X.
053100     GO TO 61-LOOP.
053200
053300**************************************************
053400*                                                *
053500*  LOAD PRINT FILE AND WRITE REQ ON REPORT       *
053600*                                                *
053700**************************************************
053800
053900 61-REQ-REPORT.
054000     IF LINE-CTR > 50
054100         PERFORM 611-PAGE-HDR.
054200     MOVE SORT-REQ-NO             TO  REQ-NO-OUT.
054300     MOVE 4                       TO  DATE-MODE.
054400     MOVE SORT-REQ-DATE           TO  DATE-VALIDATE-IN.
054500     CALL "TDATECHK" USING DATE-CHECK-AREA.
054600     MOVE DATE-SLASH-OUT          TO  REQ-DATE-OUT.
054700
054800     MOVE SORT-REQ-DATE-WANT      TO  DATE-VALIDATE-IN.
054900     CALL "TDATECHK" USING DATE-CHECK-AREA.
055000     MOVE DATE-SLASH-OUT          TO  REQ-DATE-WANT-OUT.
055100
055200     MOVE SORT-REQ-DATE-REL       TO  DATE-VALIDATE-IN.
055300     CALL "TDATECHK" USING DATE-CHECK-AREA.
055400     MOVE DATE-SLASH-OUT          TO  REQ-DATE-REL-OUT.
055500
055600     MOVE SORT-REQ-CODE           TO  CORP-CODE-OUT.
055700     MOVE SORT-CLASS              TO  CLASS-OUT.
055800     MOVE SORT-SOQ                TO  SOQ-OUT.
055900     MOVE SORT-QTY-UM             TO  STR-UM-OUT.
056000     MOVE SORT-HOLD-STATUS        TO  HOLD-STATUS-OUT.
           MOVE SORT-ORIGINATOR         TO  ORIG-OUT.
           MOVE SORT-CO                 TO  CO-OUT.
056100     MOVE DETAIL-LINE             TO  PRINT-LINE.
056200     WRITE PRINT-RCD AFTER ADVANCING 2 LINES.
056300     ADD 2  TO  LINE-CTR.
056400
056500*---------- USE SUBPROGRAM TO GET NON-STORES REQ DESCRIPTION.
056600*---------- THIS IS DONE FOR NON-STORES REQS ONLY.
056700     IF SORT-MAT-TYPE = "S"
056800         PERFORM 611-GET-CODED-DESC  THRU 611-GCD-X
056900     ELSE
057000         PERFORM 611-GET-NON-CODED-DESC  THRU 611-GNCD-X.
057100
057200 61-REQ-REPORT-X.
057300     EXIT.
057400
057500*********************************
057600*                               *
057700*  GET BUYER NAME               *
057800*                               *
057900*********************************
058000
058100 611-GET-BUYER-NAME.
058200     MOVE SORT-BUYER-CODE         TO  BUYER-ARG,
058300                                      SAVE-BUYER-CODE,
058400                                      PRT-BUYER-CODE.
           MOVE BUYER-ARG TO BUYERCDE OF MBUYER-REC-I.
           READ MBUYER-I INTO BUF-MBUYER
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
058900             MOVE "*NO NAME FOUND*"  TO  PRT-BUYER-NAME
059000         ELSE
059100             MOVE "GET MBUYER *611-GBN" TO BU-DISPLAY-MSG
059200             MOVE BUYER-ARG       TO  BU-DISPLAY-FLD (4)
059300             GO TO 2-BLOWUP
059400     ELSE
059500         MOVE BUYER-NAME  TO  PRT-BUYER-NAME.
059600
059700 611-GBN-X.
059800     EXIT.
059900
060000****************************************************
060100**
060200**   THIS ROUTINE GETS UP TO 2 DESCRIPTION LINES
060300**   FOR A CODED REQUISITION
060400**
060500****************************************************
060600
060700 611-GET-CODED-DESC.
060800     MOVE 2                       TO CDESC-LINES-TO-GET.
060900     MOVE "D"                     TO CDESC-DESC-OPTION.
061000     MOVE "N"                     TO CDESC-LOCAL-DESC-OPTION.
061100     MOVE SORT-REQ-CODE           TO CODE-ARG.
061200     CALL "CDESC" USING CDESC-RET-CODE,
061300                        BASE,
061400                        STATUS-AREA,
061500                        BU-DISPLAY-AREA,
061600                        CODE-ARG,
061700                        CDESC-DATA.
061800     IF BU-DISPLAY-MSG-1 NOT = SPACES
061900         GO TO 611-GCD-X.
062000     MOVE ZEROS                   TO SUB.
062100
062200 611-GET-DDESC-LOOP.
062300     ADD 1                        TO SUB.
062400     IF SUB > 2 OR
062500        SUB > CDESC-LINES-GOT
062600         GO TO 611-GCD-X
062700     ELSE
062800         MOVE CDESC (SUB)         TO PRT-RQD-DESC
062900         WRITE PRINT-RCD FROM DESC-LINE AFTER ADVANCING 1
063000         ADD 1                    TO LINE-CTR
063100         GO TO 611-GET-DDESC-LOOP.
063200
063300 611-GCD-X.
063400     EXIT.
063500
063600****************************************************
063700**
063800**   THIS ROUTINE GETS UP TO 3 DESCRIPTION LINES
063900**   FOR A NON-CODED REQUISITION
064000**
064100****************************************************
064200
064300 611-GET-NON-CODED-DESC.
064400     CALL "TNRQDESC" USING RET-CODE, BASE, STATUS-AREA,
064500       SORT-REQ-NO, REQ-DESC-AREA, BU-DISPLAY-MSG.
064600     IF RET-CODE NOT = 0
064700         PERFORM 2-BLOWUP.
064800
064900     IF RQD-DESC (1) > SPACES
065000         MOVE RQD-DESC (1)        TO  PRT-RQD-DESC
065100         WRITE PRINT-RCD FROM DESC-LINE AFTER ADVANCING 1
065200         ADD 1                    TO  LINE-CTR.
065300     IF RQD-DESC (2) > SPACES
065400         MOVE RQD-DESC (2)        TO  PRT-RQD-DESC
065500         WRITE PRINT-RCD FROM DESC-LINE AFTER ADVANCING 1
065600         ADD 1                    TO  LINE-CTR.
065700     IF RQD-DESC (3) > SPACES
065800         MOVE RQD-DESC (3)        TO  PRT-RQD-DESC
065900         WRITE PRINT-RCD FROM DESC-LINE AFTER ADVANCING 1
066000         ADD 1                    TO  LINE-CTR.
066100
066200 611-GNCD-X.
066300     EXIT.
066400
066500**************************************************
066600*                                                *
066700*  PAGE HDR PROCEDURE                            *
066800*                                                *
066900**************************************************
067000
067100 611-PAGE-HDR.
067200*---------- IF ALL REQS TO BE REPORTED ON ARE CODED,
067300*---------- THIS IF STATEMENT WILL PREVENT THE FIRST REQ
067400*---------- AS SHOWING UP AS "NON-STORERM".
067500     IF SORT-MAT-TYPE = "S"
067600         MOVE "CODED      "       TO  PRT-STR-HDR
067700         MOVE SORT-MAT-TYPE       TO  SAVE-MAT-TYPE.
067800
067900     ADD 1                        TO  PAGE-CTR.
068000     MOVE PAGE-CTR                TO  PAGE-NO-OUT.
068100     MOVE PRINT-HDR1              TO  PRINT-LINE.
068200     WRITE PRINT-RCD  AFTER ADVANCING NEW-PAGE.
068300     MOVE PRINT-HDR2              TO  PRINT-LINE.
068400     WRITE PRINT-RCD  AFTER ADVANCING 2 LINES.
068500     MOVE PRINT-HDR3              TO  PRINT-LINE.
068600     WRITE PRINT-RCD AFTER ADVANCING 2 LINES.
068700     MOVE DOT-LINE                TO  PRINT-LINE.
068800     WRITE PRINT-RCD  AFTER ADVANCING 1 LINES.
068900     MOVE ZEROS                   TO  LINE-CTR.
069200
069300
069400 61-FINISH-REPORT.
069500     IF PAPER-IS-132-COLS
069600         NEXT SENTENCE
069700     ELSE
069800         WRITE PRINT-RCD FROM NORMAL-PRINT AFTER ADVANCING 0.
069900
070000     MOVE SPACES TO PRINT-RCD.
070100     WRITE PRINT-RCD AFTER ADVANCING NEW-PAGE.
070200
071100     CLOSE PRINT-FILE.
071200
071300 61-WR-X.
071400     EXIT.
071500
071600
071700 END-OF-PROGRAM SECTION.
071800
       COPY OVRPFCALL IN COPYLIB.
