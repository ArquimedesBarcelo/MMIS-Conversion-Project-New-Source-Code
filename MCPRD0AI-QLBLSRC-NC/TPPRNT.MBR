332300
332400 DISPLAY-REPORT.
           MOVE 66208 TO CATREAD-MSG-NUMBER.
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
           MOVE MISC-BUFFER TO D-CMD-LINE.
332600     MOVE D-DISK-RECS TO DSPLY-REC.
           PERFORM 99-SCREEN-WRITE.
           PERFORM 98-SCREEN-READ.
334100     IF VIEW-LASTKEY = 2 OR 3 GO TO 2-EOJ.
334200     IF VIEW-LASTKEY = 6
334300       MOVE 1 TO AKEY
334400       PERFORM 6-SET-UP-PRNT.

337100 CDATE.
337200     MOVE 4 TO DATE-MODE.
337300     MOVE SRT-5 OF DISK-REC TO DATE-VALIDATE-IN.
337400     CALL "TDATECHK" USING DATE-CHECK-AREA.
337500     MOVE DATE-OUT TO SRT-5 OF DISK-REC.

       69-READ-DISK-FILE.
332000     READ DISK-FILE INVALID KEY MOVE "Y" TO END-OF-DISK-FILE.
           IF DF-STATUS NOT = "00"
               MOVE "Y" TO END-OF-DISK-FILE.

       98-SCREEN-READ.
           READ DISPLAY-FILE FORMAT IS VIEW-CFNAME
               INDIC IS INDICS.
           ACCEPT IOFEEDBACK FROM I-O-FEEDBACK-AREA.
           MOVE ALL B"0" TO INDICS.
           IF DSPLY-STATUS NOT = "00"
               MOVE 3 TO VIEW-LASTKEY
           ELSE
           MOVE FUNCTION-NUM TO VIEW-LASTKEY.

       99-SCREEN-WRITE.
           WRITE DSPLY-REC FORMAT IS VIEW-CFNAME
               INDIC IS INDICS.
           MOVE ALL B"0" TO INDICS.

       COPY OVRPFCALL IN COPYLIB.

188000 999-CATREAD.
188100     MOVE SPACES TO MISC-BUFFER.
188200     CALL "CCATREAD" USING CATREAD-PARMS.
188300     MOVE CATREAD-MSG-TEXT TO MISC-BUFFER.
189000 999-CATREAD-EXIT.    EXIT.
