008900**************************************************************
009000**                                                          **
009100**                DATABASE I/O BUFFER AREA                  **
009200**                                                          **
009300**************************************************************
009400**************************************************************
009500
009600 COPY DPORECDH IN COPYLIB.
009700
009800 COPY DPOITEMH IN COPYLIB.
009900
010000 COPY DPODESCH IN COPYLIB.
010100
010200 COPY DRCVITMH IN COPYLIB.
010300
010400 COPY DPOFRTH IN COPYLIB.
010500
010600 COPY DINVRCDH IN COPYLIB.
010700
010800 COPY DINVITMH IN COPYLIB.
010900
011000 COPY DINVACTH IN COPYLIB.
011100
011200 COPY DVENDORH IN COPYLIB.
011300
011400 COPY MPLTINFO IN COPYLIB.
011500
011600 COPY DPODELET IN COPYLIB.

       COPY DRCVCORH IN COPYLIB.
011700
011800*********************
011900*                   *
012000*   DATA SET NAMES  *
012100*                   *
012200*********************
012300
012400 01  DSET-NAMES.
012500     05  DSET-NAME              PIC X(16)  VALUE SPACES.
012600     05  DSET-MPLTINFO          PIC X(16)  VALUE "MPLTINFO;".
012700     05  DSET-DPORECD           PIC X(16)  VALUE "DPORECD;".
012800     05  DSET-DPOITEM           PIC X(16)  VALUE "DPOITEM;".
012900     05  DSET-DPODESC           PIC X(16)  VALUE "DPODESC;".
013000     05  DSET-DRCVITEM          PIC X(16)  VALUE "DRCVITEM;".
013100     05  DSET-DPOFREIGHT        PIC X(16)  VALUE "DPOFREIGHT;".
013200     05  DSET-DINVRCD           PIC X(16)  VALUE "DINVRCD;".
013300     05  DSET-DINVITM           PIC X(16)  VALUE "DINVITM;".
013400     05  DSET-DINVACCT          PIC X(16)  VALUE "DINVACCT;".
013500     05  DSET-DVENDOR           PIC X(16)  VALUE "DVENDOR;".
013600     05  DSET-DPODELETE         PIC X(16)  VALUE "DPODELETE;".
           05  DSET-DRCVCORR          PIC X(16)  VALUE "DRCVCORR;".
013700
013800 COPY DATAB IN COPYLIB.
013900
014000 COPY DBSTHIST IN COPYLIB.
014100
014200 01 ITEMS-LISTING.
014300     05  ALL-ITEMS              PIC XX    VALUE "@;".
014400     05  PO-SEARCH              PIC X(10) VALUE "PO-RCV-NO;".
014500     05  VEN-SEARCH             PIC X(10) VALUE "VEN-CODE;".
014600     05  REG-SEARCH             PIC X(16)
014700                                  VALUE "REGISTER-NUMBER;".
014800
014900 01 ARG-VALUES.
015000     05  PO-ARG                 PIC X(14) VALUE SPACES.
015100     05  VEN-ARG                PIC X(10) VALUE SPACES.
015200     05  PLT-ARG                PIC X(4)  VALUE SPACES.
015300     05  REG-ARG                PIC X(6)  VALUE SPACES.
015400     05  RCVR-ARG.
015500         10  RCVR-PO-NUM        PIC X(10) VALUE SPACES.
015600         10  BUILD-RCVR-NO      PIC 9(3)  VALUE ZEROS.
015700         10  FILLER             PIC X(1)  VALUE SPACES.
015800
015900
016000 01  DATES-AND-TIMES.
016100     05  TODAYS-DATE.
016200         10  YY               PIC 99.
016300         10  MM               PIC 99.
016400         10  DD               PIC 99.
016500
           05  DELETE-DATE-CN.
               10  DELETE-DATE-CC   PIC 99.
016600         10  DELETE-DATE.
016700             15  DELETE-DATE-YY   PIC 99.
016800             15  DELETE-DATE-MM   PIC 99.
016900             15  DELETE-DATE-DD   PIC 99.
017000
017100     05  SAVE-PO-DELETE-DATE  PIC 9(8) VALUE ZEROS.
017200
           05  TIME-OF-DAY          PIC X(8) VALUE SPACES.
017300
017400 COPY TDATECHK IN COPYLIB.
017500
017600 COPY TBLOWUP IN COPYLIB.

       LINKAGE SECTION.
       01 NUMBER-POS-TO-DELETE.
008000    05 PO-DELETE-MAX-NO             PIC X(5).
017700
017800
017900 PROCEDURE DIVISION USING NUMBER-POS-TO-DELETE.
018000 BEGIN SECTION.
       BEGIN-HERE.
018100
018200     PERFORM 1-HSK  THRU  1-HSK-X.
018300     PERFORM 6-MAIN  THRU  6-MAIN-X.
018400     PERFORM 2-CLOSE-FILES  THRU  2-CLOSE-FILES-X.
018500     GOBACK.
018600
018700
018800 1-HSK.
           OPEN INPUT DPORECDH-I, DPOITEMH-I, DPODESCH-I, DRCVITEMH-I,
                      DPOFREIGHTH-I, DINVRCDH-I, DINVITMH-I,
                      DINVACCTH-I, DVENDORH-I, MPLTINFO-I,
                      DRCVCORRH-I.
           OPEN I-O DPODELETE-O.

020900******************************************
021000*   GET CO. CODE FROM MPLTINFO
021100******************************************
021200
021300     MOVE "P 01"       TO PLT-ARG.
           MOVE PLT-ARG TO PLTINFOKEY OF MPLTINFO-REC-I.
           READ MPLTINFO-I INTO BUF-MPLTINFO
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
021700         MOVE "GET MPLTINFO 'P 01' *1-HSK" TO BU-DISPLAY-MSG
021800         GO TO 2-BLOWUP
021900     ELSE
022000         MOVE MPLTINFO-COMPANY  TO  COMPANY-SAVE.
022100
022200**********************************************
022300*    GET NO. OF MONTHS PO SHOULD STAY IN THE
022400*    HISTORY DATA BASE BEFORE BEING DELETED
022500**********************************************
022600
022700     MOVE "PODL"       TO PLT-ARG.
           MOVE PLT-ARG TO PLTINFOKEY OF MPLTINFO-REC-I.
           READ MPLTINFO-I INTO BUF-MPLTINFO
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
023100         MOVE "GET MPLTINFO 'PODL' *1-HSK" TO BU-DISPLAY-MSG
023200         GO TO 2-BLOWUP.
023300
023400     IF MPLTINFO-PO-HIST-DEL-MTH  NOT NUMERIC
023500         MOVE "NO. OF MONTHS TO DELETE IS MISSING"
023600             TO BU-DISPLAY-MSG
023700         GO TO 2-BLOWUP
023800     ELSE
023900         MOVE MPLTINFO-PO-HIST-DEL-MTH TO PO-DELETE-MONTHS.
024000
024100***********************************************
024200*  CALL 'TDATECHK' FOR TODAYS DATE
024300***********************************************
024400
024500     MOVE 1               TO  DATE-MODE.
024600     CALL "TDATECHK" USING DATE-CHECK-AREA.
024700     MOVE DATE-YMD-OUT    TO  TODAYS-DATE.
024800     MOVE TODAYS-DATE     TO  DELETE-DATE.
024900     MOVE ZERO            TO  DELETE-DATE-DD.
           IF DELETE-DATE-YY > 70
               MOVE 19 TO DELETE-DATE-CC
           ELSE
               MOVE 20 TO DELETE-DATE-CC.
025000
025100     PERFORM 11-CALC-DELETE-DATE
025200         UNTIL DELETE-DATE-MM > PO-DELETE-MONTHS.
025300
025400     SUBTRACT PO-DELETE-MONTHS  FROM  DELETE-DATE-MM.
025500     DISPLAY "DELETE DATE ", DELETE-DATE-CN.
025600
026200 1-HSK-X.
026300     EXIT.
026400
026500 11-CALC-DELETE-DATE.
      *-----USE CENTURY IN CALCULATION
           IF DELETE-DATE-YY > 0
               SUBTRACT 1                   FROM DELETE-DATE-YY
           ELSE
               SUBTRACT 1 FROM DELETE-DATE-CC
               MOVE 99 TO DELETE-DATE-YY.
026700     ADD 12                       TO DELETE-DATE-MM.
026800
026900 2-CLOSE-FILES.
           CLOSE DPORECDH-I, DPOITEMH-I, DPODESCH-I, DRCVITEMH-I,
                 DPOFREIGHTH-I, DINVRCDH-I, DINVITMH-I,
                 DINVACCTH-I, DVENDORH-I, DPODELETE-O, MPLTINFO-I,
027500           DRCVCORRH-I.
027600 2-CLOSE-FILES-X.
027700     EXIT.
027800
027900
028000
028100******************************************************
028200**                                                  **
028300**   BLOWUP ROUTINE                                 **
028400**                                                  **
028500******************************************************
028600
028700 2-BLOWUP.
028800     MOVE "TPOHDELT"              TO BU-PGM-NAME.
028900     MOVE PO-ARG                  TO BU-DISPLAY-FLD (1).
029000     MOVE RCVR-ARG                TO BU-DISPLAY-FLD (2).
029100     MOVE REG-ARG                 TO BU-DISPLAY-FLD (3).
029200     CALL "TBLOWUP" USING BASE-STHIST, BU-PGM-NAME, STATUS-AREA,
029300         DUMMY-VIEW-AREA, FILE-STATUS, BU-DISPLAY-MSG,
029400             BU-DISPLAY-FLDS.
029500
029600
029700
029800 6-MAIN.
029900     PERFORM 60-ACCEPT-OPTIONS.
030000
           ACCEPT TIME-OF-DAY FROM TIME.
030100     DISPLAY "** BEGINNING SEARCH FOR POs TO DELETE ",
030200         TIME-OF-DAY.
030300
030400     OPEN OUTPUT PO-DELETE-FILE.
           MOVE 0 TO COND-WORD.
030500     PERFORM 61-READ-PO-HEADER-DSET  THRU 61-RPHD-X
030600         UNTIL END-OF-FILE  OR PO-DELETE-CTR > PO-DELETE-NO.
030700     CLOSE PO-DELETE-FILE.
030800
           ACCEPT TIME-OF-DAY FROM TIME.
030900     DISPLAY "** END OF SEARCH FOR POs TO DELETE ", TIME-OF-DAY.
031000     DISPLAY PO-DELETE-CTR, " POs WILL BE DELETED FROM HISTORY".
           ACCEPT TIME-OF-DAY FROM TIME.
031100     DISPLAY "** SORTING PO-DELETE-FILE ", TIME-OF-DAY.
031200
031300     SORT SORT-FILE ON ASCENDING KEY SORT-PO-NUM
031400         USING PO-DELETE-FILE
031500         GIVING PO-DELETE-FILE.
031600
           ACCEPT TIME-OF-DAY FROM TIME.
031700     DISPLAY "** STARTING TO COPY POs TO 'POHIST01' ",
031800         TIME-OF-DAY.
031900
032000     OPEN INPUT PO-DELETE-FILE.
032100     OPEN OUTPUT PO-HISTORY-FILE.
032200     MOVE SPACES                  TO PO-HISTORY-REC.
032300     PERFORM 62-UPDATE-PO-HISTORY THRU  62-UPH-X.
032400     CLOSE PO-DELETE-FILE,
032500           PO-HISTORY-FILE.
032600
           ACCEPT TIME-OF-DAY FROM TIME.
032700     DISPLAY "** COMPLETED COPY OF ALL POs ELIGIBLE DELETION ",
032800         TIME-OF-DAY.
           ACCEPT TIME-OF-DAY FROM TIME.
032900     DISPLAY "** STARTING TO DELETE POs FROM HISTORY DB 'STHIST' ",
033000         TIME-OF-DAY.
033100
033200     OPEN INPUT PO-DELETE-FILE.
033300     PERFORM 63-DELETE-PO  THRU 63-DP-X.
033400     CLOSE PO-DELETE-FILE.
033500
           ACCEPT TIME-OF-DAY FROM TIME.
033600     DISPLAY " ".
033700     DISPLAY "**************************************************".
033800     DISPLAY "** DELETION PROCESS COMPLETED. ", TIME-OF-DAY.
033900     DISPLAY "** BE SURE TO BACKUP UP 'POHIST01' TO TAPE AND ".
034000     DISPLAY "** SAVE THE TAPE(S).  ONCE A SUCCESSFUL BACKUP IS ".
034100     DISPLAY "** COMPLETE YOU MAY PURGE 'POHIST01'.  MAKE SURE".
034200     DISPLAY "** 2 GOOD BACKUPS ARE MADE OF 'POHIST01' BEFORE".
034300     DISPLAY "** PURGING IT FROM THE SYSTEM|".
034400     DISPLAY "**************************************************".
034500
034600 6-MAIN-X.
034700     EXIT.
034800
034900 60-ACCEPT-OPTIONS.
035000*    DISPLAY "ENTER MAXIMUM NO. OF POs TO DELETE 'nnnnn' ".
035100*    ACCEPT PO-DELETE-MAX-NO.
035200     IF PO-DELETE-MAX-NO NUMERIC
035300         DISPLAY "MAX. NO. OF POs TO DELETE= ", PO-DELETE-MAX-NO
035400         MOVE PO-DELETE-MAX-NO    TO PO-DELETE-NO
035500         SUBTRACT 1 FROM PO-DELETE-NO
035600     ELSE
035700         MOVE "NUMBER OF POS TO DELETE VALUE NOT NUMERIC"
                   TO BU-DISPLAY-MSG
               MOVE PO-DELETE-MAX-NO TO BU-DISPLAY-FLD (1)
               GO TO 2-BLOWUP.
035900
036000
036100 61-READ-PO-HEADER-DSET.
036200**************************************
036300*                                    *
036400*  SERIAL READ ON DPORECD TO FIND    *
036500*  HEADER DATA                       *
036600*                                    *
036700**************************************
036800
           READ DPORECDH-I NEXT INTO BUF-DPORECD-H
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   MOVE 11 TO COND-WORD
                   GO TO 61-RPHD-X
037400         ELSE
037500             MOVE "GET DPORECD *61-RPHD" TO BU-DISPLAY-MSG
037600             GO TO 2-BLOWUP.
037700
037800*****************************************************************
037900**   CHECK PO DELETION DATE TO SEE IF IT IS OLDER THAN DELETE
038000**   DATE. IF SO THEN WRITE IT TO THE DELETE FILE FOR
038100**   DELETION.  PO DELETION DATE IS THE DATE THE PO WAS
038200**   DELETED FROM THE LIVE DATA BASE AND PLACED IN HISTORY
038300**   DATA BASE
038400*****************************************************************
038500
038600     MOVE POH-DELETION-DATE    TO SAVE-PO-DELETE-DATE.
038700     IF SAVE-PO-DELETE-DATE < DELETE-DATE-CN
038800         ADD 1                    TO PO-DELETE-CTR
038900         MOVE POH-RCV-NO          TO PO-DEL-NUM
039000         WRITE PO-DEL-RCD.
039200
039300 61-RPHD-X.
039400     EXIT.
039500
039600
039700 62-UPDATE-PO-HISTORY.
039800     READ PO-DELETE-FILE
039900         AT END GO TO 62-UPH-X.
040000
040100     MOVE PO-DEL-NUM              TO  PO-ARG.
           MOVE PO-ARG       TO PORCVNO OF DPORECDH-REC-I.
           START DPORECDH-I KEY = PORCVNO OF DPORECDH-REC-I
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
040600             GO TO 62-UPDATE-PO-HISTORY
040700         ELSE
040800             MOVE "FIND DPORECD *62-UPH" TO BU-DISPLAY-MSG
040900             GO TO 2-BLOWUP.
041000
           READ DPORECDH-I NEXT INTO BUF-DPORECD-H
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
040600             GO TO 62-UPDATE-PO-HISTORY
               ELSE
041400             MOVE "GET DPORECD*62-UPH" TO BU-DISPLAY-MSG
041500             GO TO 2-BLOWUP.
           IF PORCVNO OF DPORECDH-REC-I NOT = PO-ARG
040600         GO TO 62-UPDATE-PO-HISTORY.
041600
041700     MOVE SPACES                  TO BUILD-DPORECD-BUFFER.
