000200 IDENTIFICATION DIVISION.
000300 PROGRAM-ID. TPOHDELT.
000400 AUTHOR.  KURT MOVSESIAN.
000500 DATE-WRITTEN. MAR. 21, 1988.
000700
000800***********************************************************
000900**                                                       **
001000**    T P O H D E L T                                    **
001100**                                                       **
001200*D      THIS PROGRAM IS THE MAIN PROGRAM FOR DELETING    **
001300*D      PURCHASE ORDERS OUT OF THE HISTORY DB 'STHIST'.  **
001400*D      THE POs ELIGIBLE FOR DELETION ARE WRITTEN TO     **
001500*D      AN MPE FILE 'POHIST01' BEFORE THEY ARE DELETED   **
001600*D      BY THE SUBROUTINE 'SPOHTDL'.                     **
001700**                                                       **
001800***********************************************************
      *C  02/21/94  JEFF BUNGO  REQ #6449
      *C      FIELDS WERE ADDED TO THE DPORECD HISTORY FILE TO
      *C      MATCH THE LIVE DATABASE.  THE DPORECD RECORD PRINTED
      *C      TO THE POHIST01 FILE HAD TO BE INCREASED FOR THESE
      *C      ADDITIONAL FIELDS.
      *C
      *C  09/11/96  JEFF BUNGO
      *C      EXPAND DATE FIELDS FOR YEAR 2000 COMPLIANCE.
      *C      INCLUDE CENTURY ON DELETION DATE AND USE ON
      *C      COMPARISON OF PO DELETE DATE.  ALSO INCLUDE
      *C      CENTURY ON DELETION DATE OF DPODELETE RECORD.
      *C
      *C  05/21/98  CA YODER
      *C      INCREASED DPORECD-DATA FIELD LENGTH TO 252.  IT
      *C      DID NOT ACCOUNT FOR THE INCREASE OF THE RECORD
      *C      LENGTH FOR Y2K.
001900
002000
002100
002200 ENVIRONMENT DIVISION.
002300 CONFIGURATION SECTION.
002400 SOURCE-COMPUTER.   HP-3000.
002500 OBJECT-COMPUTER.   HP-3000.
002600 SPECIAL-NAMES.  I-O-FEEDBACK IS I-O-FEEDBACK-AREA.
002800
002900 INPUT-OUTPUT SECTION.
003000 FILE-CONTROL.

003100     SELECT PO-DELETE-FILE ASSIGN TO DISK-PODELTH.
003200     SELECT SORT-FILE ASSIGN TO DISK-SORT.
003300     SELECT PO-HISTORY-FILE ASSIGN TO DISK-POHIST01.

           SELECT DPORECDH-I
                  ASSIGN TO DATABASE-MCFLST0301
                  ORGANIZATION IS INDEXED
                    ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                    WITH DUPLICATES
                  FILE STATUS IS FILE-STATUS.

           SELECT DPODELETE-O
                  ASSIGN TO DATABASE-MCFLST1101
                  ORGANIZATION IS INDEXED
                    ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                    WITH DUPLICATES
                  FILE STATUS IS FILE-STATUS.

           SELECT DPOITEMH-I
                  ASSIGN TO DATABASE-MCFLST0401
                  ORGANIZATION IS INDEXED
                    ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                    WITH DUPLICATES
                  FILE STATUS IS FILE-STATUS.

           SELECT DPODESCH-I
                  ASSIGN TO DATABASE-MCFLST0501
                  ORGANIZATION IS INDEXED
                    ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                    WITH DUPLICATES
