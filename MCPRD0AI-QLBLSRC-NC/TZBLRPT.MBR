           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   MOVE 15 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.
           IF PORCVNO OF DPOITEM-REC NOT = PO-ARG
               MOVE 15 TO COND-WORD.
094700     IF COND-WORD NOT = 0
094800         IF COND-WORD = 15
094900             MOVE "1" TO CHAIN-STATUS
095000         ELSE
095100             MOVE "GET DPOITEM *651-GD" TO BU-DISPLAY-MSG
095200             GO TO 2-BLOWUP
095300     ELSE
095400         IF ITM-QTY-ORD > ITM-QTY-DLVR
095500             IF ITM-COMPLETE-FLAG = SPACES
095600                  PERFORM 6511-PRINT-CODED-ITEM.
095700
095800 6511-PRINT-CODED-ITEM.
095900     IF NOT PRINTED-ITEM
096000**P.O. HAS NOT YET BEEN PRINTED
096100         MOVE SPACE               TO  PRT-LINE
096200         PERFORM 4-PRINT-RECORD
096300         PERFORM 67-PRINT-PRT-LINE-1  THRU  67-PPL1-X
096400         MOVE "1"                 TO  PRINT-STATUS.
096500     MOVE SPACES                  TO  PRT-LINE.
096600     PERFORM 4-PRINT-RECORD.
096700     MOVE ITM-QTY-ORD             TO  P-QTY-ORDERED.
096800     MOVE ITM-QTY-DLVR            TO  P-QTY-DELIVERED.
096900     MOVE ITM-NUMBER              TO  P-ITEM-NO.
097000     MOVE ITM-CORP-CODE           TO  P-CODE.
097100     SUBTRACT ITM-QTY-DLVR FROM ITM-QTY-ORD.
097200     MULTIPLY ITM-QTY-ORD BY ITM-ZBILL-VALUE GIVING
097300           ITEM-TOTAL-VALUE ROUNDED.
097400     MOVE ITM-ZBILL-VALUE         TO  P-ITEM-VALUE.
097500     MOVE ITEM-TOTAL-VALUE        TO  P-ITEM-TOTAL-VALUE.
097600     ADD ITEM-TOTAL-VALUE         TO  REPORT-C-TOTAL-VALUE,
097700                                      PO-TOTAL-VALUE.
097800     PERFORM 4-PRINT-RECORD.
097900     PERFORM 67-GET-ITEM-DESC  THRU  67-GID-X.
098000
098100************************************************************
098200**                                                        **
098300**   REPORT D - SHOWS ALL MEMO Z-BILL POs OLDER THAN      **
098400**              A GIVEN MONTH                             **
098500**                                                        **
098600************************************************************
098700
098800 66-WRITE-REPORT-D.
098900     MOVE SPACE                   TO  PRINT-STATUS.
099000     MOVE SPACE                   TO  PO-TOO-OLD-SW.
099100     MOVE ZERO                    TO  PO-TOTAL-VALUE.
099200     IF W-OLD-AND-OPEN = "1" THEN
099300         MOVE W-PO                TO  PO-NO
099400         MOVE W-RLS-NO            TO  PO-RLSE
099500         MOVE "000"               TO  PO-RS
099600         MOVE "P"                 TO  PO-PREFIX
               MOVE 0 TO COND-WORD
               MOVE PO-ARG TO PORCVNO OF DPOITEM-REC
               START DPOITEM KEY = PORCVNO OF DPOITEM-REC
                  INVALID KEY MOVE FILE-STATUS TO FILE-STATUS
               END-START
099900         IF FILE-STATUS NOT = "00"
                   PERFORM 3-READ
100100             GO TO 66-WRD-X
100200         ELSE
100300             MOVE SPACE           TO  CHAIN-STATUS
100400             PERFORM 651-GET-DPOITEM UNTIL CHAIN-END.
100500
100600     PERFORM 3-READ.
100700     IF PRINTED-ITEM
100800         MOVE SPACES              TO  PRT-LINE
100900         MOVE PO-TOTAL-VALUE      TO  P-TOTAL
101000         MOVE "                       P.O. TOTAL ="
101100                                  TO  P-TOTAL-DESC
101200         PERFORM 4-PRINT-RECORD
101300         MOVE DASHES              TO  PRINT-LINE
101400         WRITE PRINT-RECORD AFTER ADVANCING 2
101500         ADD 2                    TO  LINE-CTR.
101600
101700 66-WRD-X.
101800     EXIT.
101900*********************************************
102000**  THIS ROUTINE PRINTS THE PO NUMBER AND
102100**  VENDOR NAME WHICH IS USED ON ALL REPORT
102200**  TYPES
102300*********************************************
102400
102500 67-PRINT-PRT-LINE-1.
102600     MOVE SPACES                  TO  PRT-LINE.
102700     MOVE W-PO                    TO  P-PO.
102800     MOVE W-RLS-NO                TO  P-RLSE.
102900     MOVE "000"                   TO  P-RS.
103000     MOVE "-"                     TO  P-D.
103100     MOVE W-VENDOR-CODE           TO  VEN-ARG
           MOVE W-YY                    TO  P-YY.
           MOVE W-MM                    TO  P-MM.
           MOVE W-DD                    TO  P-DD.
           MOVE "/"                     TO  P-H1
                                            P-H2.
           MOVE 0 TO COND-WORD.
           MOVE VEN-ARG TO VENCDE OF DVENDOR-REC.
           START DVENDOR KEY = VENCDE OF DVENDOR-REC
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
                   MOVE 17 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.
103400     IF COND-WORD NOT = 0
103500         MOVE "FIND DVENDOR * 631-GVN" TO BU-DISPLAY-MSG
               MOVE VEN-ARG TO BU-DISPLAY-FLD (1)
103600         GO TO 2-BLOWUP.
103700
           MOVE 0 TO COND-WORD.
           READ DVENDOR NEXT INTO BUF-DVENDOR
               AT END MOVE FILE-STATUS TO FILE-STATUS
           END-READ
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   MOVE 15 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.
           IF VENCDE OF DVENDOR-REC NOT = VEN-ARG
               MOVE 15 TO COND-WORD.
104300     IF COND-WORD = 0
104400         IF VEN-ITM-NO = "00"
104500            MOVE VEN-ITM-DATA TO P-VENDOR
               ELSE
103900            MOVE "*** VENDOR NAME NOT ON FILE ***" TO P-VENDOR
104600     ELSE
103900         MOVE "*** VENDOR NAME NOT ON FILE ***" TO P-VENDOR.
104700     PERFORM 4-PRINT-RECORD.
104800
104900 67-PPL1-X.
105000     EXIT.
105100
105200 67-GET-ITEM-DESC.
105300     MOVE SPACES                  TO  PRT-LINE.
105400     IF ITM-CORP-CODE = "NON-STR"
105500         PERFORM 671-GET-NONCODED-DESC  THRU  671-GND-X
105600     ELSE
105700         PERFORM 671-GET-CODED-DESC  THRU  671-GCD-X.
105800
105900 67-GID-X.
106000     EXIT.
106100
106200
106300 671-GET-CODED-DESC.
106400**************************************************
106500**  CALL CDESC FOR DESCRIPTION LINES. (CODED)   **
106600**************************************************
106700     MOVE ITM-CORP-CODE           TO  CODE-ARG.
106800     CALL "CDESC" USING RET-CODE,
106900                        BASE,
107000                        STATUS-AREA,
107100                        BU-DISPLAY-MSG,
107200                        CODE-ARG,
107300                        CDESC-DATA.
107400     IF BU-DISPLAY-MSG-1  NOT = SPACES
107500         MOVE CODE-ARG            TO  BU-DISPLAY-FLD (4)
107600         GO TO 2-BLOWUP.
107700
107800     IF CDESC-LINES-GOT  =  0
107900         MOVE "*** NO DESCRIPTION ON FILE ***" TO P-DESCRIPTION
108000         PERFORM 4-PRINT-RECORD
108100         GO TO  671-GCD-X.
108200
108300     MOVE ZEROS                   TO  DESC-SUB.
108400
108500 671-GET-DESC-LOOP.
108600     ADD 1                        TO  DESC-SUB.
108700     IF DESC-SUB > CDESC-LINES-GOT
108800         GO TO 671-GCD-X.
108900
109000     MOVE CDESC (DESC-SUB)        TO  P-DESCRIPTION.
109100     PERFORM 4-PRINT-RECORD
109200     GO TO  671-GET-DESC-LOOP.
109300
109400 671-GCD-X.
109500     EXIT.
109600
109700 671-GET-NONCODED-DESC.
109800*******************************************************
109900**  CALL CNDESC FOR DESCRIPTION LINES. (NON-CODED)   **
110000*******************************************************
110100     MOVE 25                      TO  CNDESC-LINES-TO-GET.
110200     MOVE 0                       TO  CNDESC-LINES-GOT.
110300     CALL "CNDESC" USING BASE, PO-ARG, ITM-NUMBER,
110400         CNDESC-DATA.
110500
110600     IF CNDESC-LINES-GOT  =  0
110700         MOVE "*** NO DESCRIPTION ON FILE ***" TO P-DESCRIPTION
110800         PERFORM 4-PRINT-RECORD
110900         GO TO  671-GND-X.
111000
111100     MOVE ZEROS                   TO  DESC-SUB.
111200
111300 671-GET-NONCODED-LOOP.
111400     ADD 1                        TO  DESC-SUB.
111500     IF DESC-SUB > CNDESC-LINES-GOT
111600         GO TO 671-GND-X.
111700
111800     MOVE CNDESC (DESC-SUB)       TO  P-DESCRIPTION.
111900     PERFORM 4-PRINT-RECORD.
112000     GO TO  671-GET-NONCODED-LOOP.
112100
112200 671-GND-X.
112300     EXIT.
112400
112500
