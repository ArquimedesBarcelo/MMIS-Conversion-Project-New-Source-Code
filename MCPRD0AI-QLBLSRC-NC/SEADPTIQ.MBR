012900 LINKAGE SECTION.
013000 01  BASE                      PIC X(10).
013100 01  BASE-MMISA                 PIC X(13).
013200
013300 COPY VCOMLINK   IN COPYLIB.
013400 COPY TSHWSUB2   IN COPYLIB.
013500 COPY LANGSUB    IN COPYLIB.
013600
013700 PROCEDURE DIVISION USING BASE
013800                          BASE-MMISA,
013900                          VIEW-COMAREA,
014000                          SRF-COMAREA,
014100                          LANGUAGE-PARMS.
014200
014300 1-HSK.
      *------ CALL CCRTFILE TO CREATE A TEMPORARY FILE 'DEADPTIQ'
           MOVE "QTEMP"       TO CCRTFILE-LIBRARY.
           MOVE "DEADPTIQ"    TO CCRTFILE-FILE.
           MOVE "0040"        TO CCRTFILE-RECORD-LENGTH.
           MOVE "01000"       TO CCRTFILE-NO-RECORDS.
           MOVE "01000"       TO CCRTFILE-INCREMENT-AMT.
           MOVE "99"          TO CCRTFILE-NO-INCREMENTS.
           CALL "CCRTFILE" USING CCRTFILE-LIBRARY,
                                 CCRTFILE-FILE,
                                 CCRTFILE-RECORD-LENGTH,
                                 CCRTFILE-NO-RECORDS,
                                 CCRTFILE-INCREMENT-AMT,
                                 CCRTFILE-NO-INCREMENTS,
                                 CCRTFILE-STATUS.
           IF CCRTFILE-STATUS NOT = "00"
               MOVE "CCRTFILE CREATE OF 'DEADPTIQ' FAILED"
                  TO BU-DISPLAY-MSG
               PERFORM 2100-BLOWUP.

           MOVE ZERO TO SUB, SUB1, SUB2.
           MOVE SPACES TO SWITCH-FLAG, END-OF-DPTS-FLAG.
           OPEN I-O DISPLAY-FILE.
           OPEN INPUT MVALIDPLT-I.
014400     PERFORM 7300-LOAD-FILE THRU 7390-LF-X.
014500     SORT SORT-FILE ON ASCENDING KEY SORT-REQ-DEPT,
014600                                     SORT-CHARGE-DEPT,
014700         USING DPT-FILE
014800         GIVING DPT-FILE.
014900
015000     OPEN INPUT DPT-FILE.
015100     PERFORM 6000-MAIN THRU 6990-MAIN-X.
015200     CLOSE DPT-FILE.
           CLOSE DISPLAY-FILE, MVALIDPLT-I.
015300     GOBACK.
015400
015500 2100-BLOWUP.
015600     MOVE "SEADPTIQ"               TO   BU-PGM-NAME.
015700     CALL "TBLOWUP" USING BASE BU-PGM-NAME STATUS-AREA
015800       VIEW-COMAREA FILE-STATUS BU-DISPLAY-MSG
015900       BU-DISPLAY-FLDS.
016000
017400 4020-CLEAR-FORM.
017500     MOVE SPACES TO MESSAGE-BUFFER.
018700     MOVE SPACES                   TO   DE-FIELDS.
018900
       4030-SETERROR.
           MOVE B"1" TO IND (99).
           MOVE B"1" TO IND (FIELD-NUMBER).
           MOVE MESSAGE-BUFFER TO DE-MESSAGE-LINE.
051300
019000 6000-MAIN.
019100     MOVE "EADEPTIQ"               TO   VIEW-NFNAME.
019300     PERFORM 4020-CLEAR-FORM.
019400
019500     PERFORM 7000-LOAD-SCREEN THRU 7090-LS-X.
019600
019700     IF END-OF-DPTS-FLAG = "Y"
019800         MOVE "I"                  TO   SRF-FKEY (2)
020000     ELSE
               MOVE SPACES               TO   SRF-FKEY (2).
021300
021400     MOVE 2                        TO   SRF-KEYSET.
021500     MOVE "I"                      TO   SRF-FKEY (3),
021600                                        SRF-FKEY (6),
021700                                        SRF-FKEY (7).
021800     MOVE "N"                      TO   SRF-ENTER-FLAG.
       6010-SHOWFORM.
           MOVE DE-FIELDS TO DISPLAY-REC.
           PERFORM 998-WRITE-SCREEN THRU 9989-WS-X.
           MOVE DISPLAY-REC TO DE-FIELDS.
           IF MESSAGE-BUFFER-1 NOT = SPACES
               PERFORM 4030-SETERROR
               GO TO 6010-SHOWFORM.

022500*------- SHOW NEXT SCREEN
022600     IF VIEW-LASTKEY = 2
022700         GO TO 6000-MAIN.
022800
022900     IF VIEW-LASTKEY = 1
023000         PERFORM 7100-RESTART
023100         GO TO 6000-MAIN.
023200
023300 6990-MAIN-X.
023400     EXIT.
023500
023600 7000-LOAD-SCREEN.
023700     MOVE 0                        TO   SUB.
023800 7010-SERIAL-GET-LOOP.
023900     ADD 1                         TO   SUB.
024000     IF SUB > 18
024100         GO TO 7090-LS-X.
024200
024300     READ DPT-FILE AT END
024400         MOVE "Y"                  TO   END-OF-DPTS-FLAG
024500         GO TO 7090-LS-X.
024600
024700     MOVE DP-REQ-DEPT              TO   V-REQ-DEPT (SUB).
024800     MOVE DP-CHARGE-DEPT           TO   V-CHARGE-DEPT (SUB).
024900     MOVE DP-FLAG                  TO   V-FLAG (SUB).
025000
025100     GO TO 7010-SERIAL-GET-LOOP.
025200
025300 7090-LS-X.
025400     EXIT.
025500
025600
025700 7100-RESTART.
025800     MOVE "N"                      TO   END-OF-DPTS-FLAG.
025900     CLOSE DPT-FILE.
026000     OPEN INPUT DPT-FILE.
026100
026200 7300-LOAD-FILE.
026300*------- REWIND THE MASTER DATASET (START FROM BEGINNING)
026400*    CALL "DBCLOSE" USING BASE, DSET-MVALIDPLT, MODE3,
026500*      STATUS-AREA.
           MOVE 0 TO COND-WORD.
           MOVE SPACES TO VALDTAKEY OF MVALIDPLT-REC-I.
           START MVALIDPLT-I KEY > VALDTAKEY OF MVALIDPLT-REC-I
               INVALID KEY MOVE 17 TO COND-WORD.
           IF FILE-STATUS NOT = "00"
               MOVE "START ERROR MVALIDPLTDATA" TO BU-DISPLAY-MSG
               PERFORM 2100-BLOWUP.

027000     OPEN OUTPUT DPT-FILE.
027100
027200 7310-GET-MDPT-LOOP.
027300*    CALL "DBGET" USING BASE, DSET-MVALIDPLT, MODE2, STATUS-AREA,
027400*      ALL-ITEMS, BUF-MVALIDPLTDATA, PLTDATA-ARG.
           MOVE 0 TO COND-WORD.
           READ MVALIDPLT-I NEXT INTO BUF-MVALIDPLTDATA
               AT END MOVE 15 TO COND-WORD.
           IF FILE-STATUS NOT = "00"
027600         GO TO 7380-CLOSE-FILE.
028200
028300     MOVE VALID-DATA-KEY           TO   PLTDATA-ARG.
028400     IF PLTDATA-ARG-1-2 = "RC"
028500         NEXT SENTENCE
028600     ELSE
028700         GO TO 7310-GET-MDPT-LOOP.
028800
028900     MOVE PLTDATA-REQ-DEPT         TO   DP-REQ-DEPT.
029000     MOVE PLTDATA-CHARGE-DEPT      TO   DP-CHARGE-DEPT.
029100     MOVE VALID-DATA-DESC-1        TO   DP-FLAG.
029200
029300     WRITE DPT-REC.
029400
029500     GO TO 7310-GET-MDPT-LOOP.
029600
029700 7380-CLOSE-FILE.
029800     CLOSE DPT-FILE.
029900
030000 7390-LF-X.
030100     EXIT.
030200
       COPY DISPCALL IN COPYLIB.
            IF VIEW-LASTKEY = 3
                MOVE 8 TO VIEW-LASTKEY
            ELSE
            IF VIEW-LASTKEY = 8
                MOVE 3 TO VIEW-LASTKEY.
            IF SRF-KEYSET = 1 OR 3 OR 5 OR 7
                MOVE "I" TO SRF-FKEY (7).
            IF SRF-KEYSET > 0
                MOVE "I" TO SRF-FKEY (5).
            IF SRF-KEYSET = 1 OR 2 OR 5 OR 6 OR 7 OR 8
                MOVE "I" TO SRF-FKEY (4).
            IF SRF-KEYSET = 5 OR 6
                MOVE "I" TO SRF-FKEY (8), SRF-FKEY (6)
            ELSE
            IF SRF-KEYSET = 7 OR 8
                MOVE "I" TO SRF-FKEY (1), SRF-FKEY (2), SRF-FKEY (8).
            MOVE SPACES TO MESSAGE-BUFFER-1.
            IF VIEW-LASTKEY = 0
                IF SRF-ENTER-FLAG = "I"
      *M            "E28: 'ENTER' NOT VALID HERE"
                    MOVE 5 TO LANG-SETNUM
                    MOVE 28 TO LANG-MSGNUM
                    MOVE 1 TO FIELD-NUMBER, SRF-ERROR-FLD
                    PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                ELSE
                NEXT SENTENCE
            ELSE
            IF SRF-FKEY (VIEW-LASTKEY) = "I"
      *M        "I10: INVALID FUNCTION KEY"
                MOVE 9 TO LANG-SETNUM
                MOVE 10 TO LANG-MSGNUM
                MOVE 1 TO FIELD-NUMBER, SRF-ERROR-FLD
                PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
            IF MESSAGE-BUFFER-1 = SPACES
                MOVE SPACES TO SRF-FKEY-AREA, SRF-ENTER-FLAG.
        9989-WS-X.
            EXIT.

030300 999-CATREAD.
           IF CATREAD-MSG-NUMBER = ZEROS
               MOVE LANG-SETNUM TO CATREAD-MSG-SET
               MOVE LANG-MSGNUM TO CATREAD-MSG-NUM.
           CALL "CCATREAD" USING CATREAD-PARMS.
           MOVE CATREAD-MSG-TEXT TO MESSAGE-BUFFER.
031400 999-CATREAD-EXIT.
031500     EXIT.
