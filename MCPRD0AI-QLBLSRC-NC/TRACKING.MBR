       01  OPEN-WO-LABOR.
           05  FILLER     PIC X(30).
           05  NUM-CC     PIC X(04).
           05  FILLER     PIC X(04).
           05  OS-DATE.
               10  OS-MM  PIC XX.
               10  OS-S1  PIC X.
               10  OS-DD  PIC XX.
               10  OS-S2  PIC X.
               10  OS-YY  PIC XX.
           05  FILLER     PIC X.
           05  OS-TIME    PIC XXXX.
           05  FILLER     PIC X(29).

       01  DETAIL-WO-LABOR.
           05  FILLER     PIC XX.
           05  CC-NUM     PIC XXXX.
           05  FILLER     PIC XX.
           05  CC-NAME    PIC X(16).
           05  FILLER     PIC XX.
           05  CC-CRFT    PIC XX.
           05  FILLER     PIC XX.
           05  CC-HRS.
               10  H-2    PIC XX.
               10  H-DOT  PIC X.
               10  H-TEN  PIC X.
           05  FILLER     PIC XX.
           05  CC-COST.
               10  C-DOL  PIC X(10).
               10  C-DOT  PIC X.
               10  C-CNT  PIC XX.
           05  FILLER     PIC XX.
           05  S-DATE.
               10  S-MM   PIC XX.
               10  S-S1   PIC X.
               10  S-DD   PIC XX.
               10  S-S2   PIC X.
               10  S-YY   PIC XX.
           05  FILLER     PIC X.
           05  S-TIME     PIC XXXX.
           05  FILLER     PIC XXX.
           05  C-DATE.
               10  C-MM   PIC XX.
               10  C-S1   PIC X.
               10  C-DD   PIC XX.
               10  C-S2   PIC X.
               10  C-YY   PIC XX.
           05  FILLER     PIC X.
           05  C-TIME     PIC XXXX.
           05  FILLER     PIC XXX.

       01  DETAIL-WO-PARTS.
           05  P-QTY      PIC ZZZZZZZ9.
           05  FILLER     PIC X(04).
           05  P-UM       PIC X(02).
           05  FILLER     PIC X(04).
           05  P-CODE     PIC X(07).
           05  FILLER     PIC X(10).
           05  P-CST.
               10  P-C    PIC ZZZZZZZZZZZZZ9.
               10  P-DOT  PIC X.
               10  P-TEN  PIC XX.
           05  FILLER     PIC X(05).
           05  P-DATE-USED.
               10  P-MM   PIC XX.
               10  P-S1   PIC X.
               10  P-DD   PIC XX.
               10  P-S2   PIC X.
               10  P-YY   PIC XX.
           05  FILLER     PIC X(21).

       01  DETAIL-WO-SCHED.
           05  FILLER     PIC X(06).
           05  SC-DATE.
               10  SC-MM  PIC XX.
               10  SC-S1  PIC X.
               10  SC-DD  PIC XX.
               10  SC-S2  PIC X.
               10  SC-YY  PIC XX.
           05  FILLER     PIC X(04).
           05  SC-SHIFT   PIC X.
           05  FILLER     PIC X(04).
           05  SC-QTY     PIC X(02).
           05  FILLER     PIC X(04).
           05  SC-CRAFT   PIC X(02).
           05  FILLER     PIC X(04).
           05  SC-HOURS.
               10  SC-H   PIC ZZ9.
               10  SC-DOT PIC X.
               10  SC-TEN PIC X.
           05  FILLER     PIC X(04).
           05  SC-REM     PIC X(30).
           05  FILLER     PIC X(06).

       01  DETAIL-WO-TRACK.
           05  DATE-OUT-TRACK.
               10  DATE-O-MM          PIC XX.
               10  DATE-SLASH-1       PIC X.
               10  DATE-O-DD          PIC XX.
               10  DATE-SLASH-2       PIC X.
               10  DATE-O-YY          PIC XX.
           05  FILLER                 PIC XX.
           05  TIME-OUT               PIC XXXX.
           05  FILLER                 PIC XX.
           05  PROGRAM-NAM            PIC X(08).
           05  FILLER                 PIC XXX.
           05  WO-STAT                PIC XX.
           05  FILLER                 PIC X(05).
           05  TRAN-STAT              PIC XX.
           05  FILLER                 PIC XXX.
           05  USER-N                 PIC X(08).
           05  FILLER                 PIC XXX.
           05  USER-T                 PIC ZZZ9.
           05  USERT REDEFINES USER-T PIC XXXX.
           05  FILLER                 PIC X(05).
           05  ID-USER                PIC XXXX.
           05  FILLER                 PIC XXXX.
           05  CLK-CRD                PIC XXXX.
           05  FILLER                 PIC XXX.
           05  TYPE-STAT              PIC XX.
           05  FILLER                 PIC XXXX.

       01  DB-ERROR.
           05  DB-FUNC   PIC X(08) VALUE SPACES.
           05  FILLER    PIC XX    VALUE "  ".
           05  DB-FILE   PIC X(16) VALUE SPACES.
           05  FILLER    PIC X(21) VALUE " ERROR - COND-WORD = ".
           05  CON-WORD  PIC XX.

           COPY SCREENIO       IN COPYLIB.

           COPY CATREAD        IN COPYLIB.

           COPY OVRPFDATA      IN COPYLIB.

           COPY CCHKOBJ        IN COPYLIB.

       01  DBPARAMETERS.
           COPY DBPARMS        IN COPYLIB.

       01  WO-BASIC-DATA.
           COPY DWOBASIC       IN COPYLIB.

       01  WO-PLANNED-DATA.
           COPY DWOPLAN        IN COPYLIB.

       01  WO-PARTS-DATA.
           COPY DWOPARTS       IN COPYLIB.

       01  WO-LABOR-DATA.
           COPY DWOLABOR       IN COPYLIB.

       01  WO-SCHED-DATA.
           COPY DWOSCHED       IN COPYLIB.

       01  WO-MSG-DATA.
           COPY DWOMSG         IN COPYLIB.

           COPY TDATESUB       IN COPYLIB.

       01  LAST-WO-USED-DATA.
           COPY MLASTWO        IN COPYLIB.

       01  CURR-LABOR-DATA.
           COPY DCURRLBR       IN COPYLIB.

       01  WO-TRACK-DATA.
           COPY DWOTRACK       IN COPYLIB.

       01  MESSAGE-BUFFER-DATA.
           COPY ERRORLIN       IN COPYLIB.

       PROCEDURE DIVISION.
       INITIALIZATION SECTION 01.
       CHECK-PASSWORD.
           CALL "TPWORD"       USING PASSWORD-INFORMATION.
           IF PASSWORD-FLAG NOT = "N"
               GO TO INITIALIZE-FUNCTIONS.
           GOBACK.

       INITIALIZE-FUNCTIONS.
           OPEN INPUT          WO-NUMBER.
           OPEN INPUT          WO-BASIC.
           OPEN INPUT          WO-PLANNED.
           OPEN INPUT          WO-LABOR.
           OPEN INPUT          WO-PARTS.
           OPEN INPUT          LAB-CURR-STAT.
           OPEN INPUT          WO-SCHEDULE.
           OPEN INPUT          WO-MESSAGE.
           OPEN INPUT          WO-TRACK-FILE.
           OPEN I-O            DISPLAY-FILE.
           OPEN INPUT          WO-LAST-NUM-USED.

      *------ CALL CCRTFILE TO CREATE A TEMPORARY FILE 'REQTEMP'
           MOVE "QTEMP"       TO CCRTFILE-LIBRARY.
           MOVE "OUTTRACK"    TO CCRTFILE-FILE.
           MOVE "0426"        TO CCRTFILE-RECORD-LENGTH.
           MOVE "01000"       TO CCRTFILE-NO-RECORDS.
           MOVE "01000"       TO CCRTFILE-INCREMENT-AMT.
           MOVE "03"          TO CCRTFILE-NO-INCREMENTS.
           CALL "CCRTFILE" USING CCRTFILE-LIBRARY,
                                 CCRTFILE-FILE,
                                 CCRTFILE-RECORD-LENGTH,
                                 CCRTFILE-NO-RECORDS,
                                 CCRTFILE-INCREMENT-AMT,
                                 CCRTFILE-NO-INCREMENTS,
                                 CCRTFILE-STATUS.
           IF CCRTFILE-STATUS NOT = "00"
               MOVE "CCRTFILE CREATE OF 'OUTTRACK' FAILED"
                  TO BU-DISPLAY-MSG
               GO TO END-OF-JOB.
           MOVE SPACES         TO LAST-WO-USED-DATA HOLD-MSG.
           MOVE 1              TO DATE-FLAG-SW.
           READ  WO-LAST-NUM-USED INTO LAST-WO-USED-DATA
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
               DISPLAY "UNABLE TO GET LAST-WO-USED DATA."
                       "    FILE-STATUS = " FILE-STAT
               CLOSE           WO-LAST-NUM-USED
               GO TO END-OF-JOB.

           MOVE DATE-FLAG-SW   TO DATE-FLAG DATE-CODE.
           CLOSE               WO-LAST-NUM-USED.

           ACCEPT CHECK-YEAR   FROM DATE.
           MOVE 4              TO DATE-MODE.
           MOVE CHECK-YEAR     TO DATE-VALIDATE-IN.
           CALL "TDATECHK"     USING DATE-CHECK-AREA.
           MOVE DATE-SLASH-OUT TO P-DATE.
           ACCEPT TIME-BUFFER  FROM TIME.
           MOVE CUR-HRS        TO P-HRS.
           MOVE CUR-MINS       TO P-MIN.
           MOVE CUR-SECS       TO P-SEC.
           MOVE "TRACKWO"      TO SCREEN-NAME.

      *    MOVE 0              TO OVRPRTF-TOFILE-NUM.
           MOVE "P "           TO OVRPRTF-TOFILE-NUM-X.
      *    MOVE OVRPRTF-TOFILE TO CHKOBJ-FILE-NAME.
      *    CALL "CCHKOBJ"      USING CHKOBJ-FILE-NAME,
      *                        CHKOBJ-RETURN-STATUS.
      *    IF CHKOBJ-RETURN-STATUS NOT = "00"
      *        MOVE "MCPRT"    TO OVRPRTF-TOFILE.

      *    STRING "OVRPRTF FILE(" OVRPRTF-FILE ") TOFILE(*LIBL/"
      *           OVRPRTF-TOFILE ") COPIES(" OVRPRTF-COPIES ")"
      *           " SHARE(" OVRPRTF-SHARED ")"
      *        DELIMITED BY SIZE INTO OVRPRTF-PARM1.
      *    CALL "QCMDEXC"      USING OVRPRTF-PARM1, OVRPRTF-PARM2.
           COPY OVRPFCALL      IN COPYLIB.

       SCREEN-DISPLAY.
           MOVE 0              TO SUB EOF-SW ACT-KEY MAX-KEY.
           MOVE SPACE          TO RETURN-COD.
           MOVE "B"            TO FILE-SW.
           MOVE SPACES         TO SCREEN-DATA MESSAGE-BUFFER.
           MOVE HOLD-MSG       TO COMP-MSG.
           MOVE LYU-X          TO WO-YEAR-BUF.

       ENTER-WO-NUMBER.
           MOVE SCREEN-DATA    TO DISPLAY-REC.
           MOVE "00"           TO SCREEN-STATUS.

           WRITE DISPLAY-REC   FORMAT IS SCREEN-NAME
               INDIC ARE SCREEN-INDICATORS.
           IF SCREEN-STATUS NOT = "00"
               DISPLAY "SCREEN WRITE ERROR.  SCREEN-STATUS IS "
                        SCREEN-STATUS
               GO TO END-OF-JOB.

           READ  DISPLAY-FILE  FORMAT IS SCREEN-NAME
               INDIC ARE SCREEN-INDICATORS
           IF SCREEN-STATUS NOT = "00"
               DISPLAY "SCREEN READ ERROR.  SCREEN-STATUS IS "
                        SCREEN-STATUS
               GO TO END-OF-JOB.

           MOVE DISPLAY-REC    TO SCREEN-DATA.
           MOVE ALL B"0"       TO SCREEN-INDICATORS.

           IF KEY-HIT = 3 OR 8
               GO TO END-OF-JOB.

           IF KEY-HIT NOT = 0
               GO TO ENTER-WO-NUMBER.

           CALL "TALWONO"      USING WO-NUMBER-BUF RETURN-COD.
           IF RETURN-COD = "1"
      **********************************************************************
      **    MESSAGE 035/040:
      **  INVALID WORKORDER NUMBER
      **********************************************************************
               MOVE 35         TO CATREAD-MSG-SET
               MOVE 40         TO CATREAD-MSG-NUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               PERFORM ERROR-ROUTINE
               GO TO ENTER-WO-NUMBER.

           MOVE WO-NUMBER-BUF  TO WONUM OF WO-NUMBER.
           START WO-NUMBER     KEY = WONUM OF WO-NUMBER
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
      **********************************************************************
      **    MESSAGE 035/040:
      **  INVALID WORKORDER NUMBER
      **********************************************************************
               MOVE 35         TO CATREAD-MSG-SET
               MOVE 40         TO CATREAD-MSG-NUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               PERFORM ERROR-ROUTINE
               GO TO ENTER-WO-NUMBER.

           MOVE WO-NUMBER-BUF  TO WONUM OF WO-BASIC
                                  WONUM OF WO-PLANNED.
           START WO-BASIC      KEY = WONUM OF WO-BASIC
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT = "00"
               GO TO READ-BASIC.

           START WO-PLANNED    KEY = WONUM OF WO-PLANNED
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT = "00"
               GO TO READ-PLANNED.

      **********************************************************************
      **    MESSAGE 035/040:
      ** INVALID WORKORDER NUMBER
      **********************************************************************
           MOVE  35            TO CATREAD-MSG-SET.
           MOVE  40            TO CATREAD-MSG-NUM.
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
           PERFORM ERROR-ROUTINE.
           GO TO ENTER-WO-NUMBER.

       READ-BASIC.
           READ WO-BASIC       INTO WO-BASIC-DATA
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
               MOVE FILE-STAT  TO CON-WORD
               MOVE "READ    " TO DB-FUNC
               MOVE "WO-BASIC" TO DB-FILE
               MOVE DB-ERROR   TO MESSAGE-BUFFER
               PERFORM ERROR-ROUTINE
               GO TO ENTER-WO-NUMBER.

           GO TO CONT-PROC.

       READ-PLANNED.
           READ WO-PLANNED     INTO WO-PLANNED-DATA
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
               MOVE FILE-STAT  TO CON-WORD
               MOVE "READ    " TO DB-FUNC
               MOVE "WO-PLANNED" TO DB-FILE
               MOVE DB-ERROR   TO MESSAGE-BUFFER
               PERFORM ERROR-ROUTINE
               GO TO ENTER-WO-NUMBER.

           MOVE "P"            TO FILE-SW
           MOVE SPACES         TO WO-BASIC-DATA
           MOVE WO-NUM-PLANNED TO WO-NUM
           MOVE WO-STATUS-P    TO WO-STATUS
           MOVE WO-START-STATUS TO WO-STRT-STATUS
           MOVE DATE-RECD-P-CN TO DATE-RECD-CN
           MOVE TIME-RECD-P    TO TIME-RECD
           MOVE APPROVAL-CODE-P TO APPROVAL-CODE
           MOVE REQUESTER-P    TO REQUESTER-B
           MOVE EQUIP-NUM-P    TO EQUIP-NUM
           MOVE EQUIP-NAME-P   TO EQUIP-NAME
           MOVE TYPE-NUM-P     TO TYPE-NUM
           MOVE DEPT-P         TO DEPT
           MOVE ZONE-PRIORITY-P TO ZONE-PRIORITY
           MOVE LOCATION-P     TO LOCATION
           MOVE EQUIP-DOWN-P   TO EQUIP-DOWN
           MOVE EXP-CLASS-P    TO EXP-CLASS
           MOVE DATE-STRT-P-CN TO DATE-STRT-CN
           MOVE TIME-STRT-P    TO TIME-STRT
           MOVE DATE-COMP-P-CN TO DATE-COMP-CN
           MOVE TIME-COMP-P    TO TIME-COMP
           MOVE DESCRIPTION-1-P TO DESCRIPTION-1
           MOVE DESCRIPTION-2-1-P TO DESCRIPTION-2-1
           MOVE DESCRIPTION-2-2-P TO DESCRIPTION-2-2
           MOVE FAILURE-CODE-P TO FAILURE-CODE.

       CONT-PROC.
           MOVE WO-NUMBER-BUF  TO WO-NUM-HEAD.
           OPEN OUTPUT         PRINT-FILE.
           PERFORM MAIN-FUNCTIONS THRU MF-EXIT.
           CLOSE               PRINT-FILE.

           MOVE WO-NUMBER-BUF  TO WCOMP.
           MOVE PRINTED        TO HOLD-MSG.
           GO TO SCREEN-DISPLAY.

       MAIN-FUNCTIONS.
      **********************************************************************
      **    MESSAGE 049/040:
      **  WORK ORDER  FOUND
      **********************************************************************
           MOVE 49             TO CATREAD-MSG-SET.
           MOVE 40             TO CATREAD-MSG-NUM.
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
           ADD 1               TO SUB.
           MOVE MESSAGE-BUFFER TO FM(SUB).

           MOVE SCREEN-DATA    TO DISPLAY-REC.
           WRITE DISPLAY-REC   FORMAT IS SCREEN-NAME
               INDIC ARE SCREEN-INDICATORS.
           IF SCREEN-STATUS NOT = "00"
               DISPLAY "SCREEN WRITE ERROR.  SCREEN-STATUS IS "
                               SCREEN-STATUS
               GO TO END-OF-JOB.

           MOVE SPACES         TO PRINT-REC.
           WRITE PRINT-REC.
           MOVE HEADING-DT-TM  TO PRINT-REC.
           WRITE PRINT-REC.
           MOVE HEADING-DOTS   TO PRINT-REC.
           WRITE PRINT-REC     AFTER ADVANCING 2.
           MOVE HEADING-1      TO PRINT-REC.
           WRITE PRINT-REC.
           MOVE HEADING-DOTS   TO PRINT-REC.
           WRITE PRINT-REC.

           MOVE WO-NUM         TO WO-NUMB.
           MOVE WO-STATUS      TO WO-ST.
           MOVE WO-STRT-STATUS TO WO-TY.
           MOVE DATE-RECD      TO DATE-VALIDATE-IN.
           CALL "TDATECHK"     USING DATE-CHECK-AREA.
           MOVE DATE-SLASH-OUT TO RC-DATE.
           MOVE TIME-RECD-HH   TO RC-HH.
           MOVE TIME-RECD-MM   TO RC-MI.
           MOVE APPROVAL-CODE  TO APP-CD.
           MOVE REQUESTER-B    TO WO-REQ.
           MOVE EQUIP-NUM      TO WO-EQP.
           MOVE EQUIP-NAME     TO WO-ENAM.
           MOVE TYPE-NUM       TO TYP-NUM.
           MOVE DEPT           TO WO-DEPT.
           MOVE ZONE           TO WO-ZONE.
           MOVE LOCATION       TO WO-LOC.
           MOVE PRIORITY       TO WO-PRTY.
           MOVE EQUIP-DOWN     TO WO-EDWN.
           MOVE CRAFTS-REQD-1  TO WO-C1.
           MOVE CRAFTS-REQD-2  TO WO-C2.
           MOVE CRAFTS-REQD-3  TO WO-C3.
           MOVE EXP-CLASS      TO WO-EXP.
           MOVE DESCRIPTION-1  TO WO-DES1.
           MOVE DESCRIPTION-2-1 TO WO-DES2.
           MOVE DESCRIPTION-2-2 TO WO-DES3.
           MOVE CRAFTSMEN-1    TO CFT-1.
           MOVE CRAFTSMEN-2    TO CFT-2.
           MOVE CRAFTSMEN-3    TO CFT-3.
           MOVE DATE-STRT      TO DATE-VALIDATE-IN.
           CALL "TDATECHK"     USING DATE-CHECK-AREA.
           MOVE DATE-SLASH-OUT TO TS-DATE.
           MOVE TIME-STRT-HH   TO TS-HH.
           MOVE TIME-STRT-MM   TO TS-MI.
           MOVE FAIL-CODE-REASON TO FAIL-12.
           MOVE FAIL-CODE-SUBSYS TO FAIL-36.
           MOVE DATE-COMP      TO DATE-VALIDATE-IN.
           CALL "TDATECHK"     USING DATE-CHECK-AREA.
           MOVE DATE-SLASH-OUT TO TC-DATE.
           MOVE TIME-COMP-HH   TO TC-HH.
           MOVE TIME-COMP-MM   TO TC-MI.

           IF BASIC-FILE
               MOVE "V E R B A L   W O R K   O R D E R   "
                               TO WO-FILE
           ELSE
               MOVE "P L A N N E D   W O R K   O R D E R "
                               TO WO-FILE.

           MOVE SPACES         TO PRINT-REC.
           WRITE PRINT-REC     AFTER ADVANCING 2.
           MOVE WO-LINE-0      TO PRINT-REC.
           WRITE PRINT-REC.
           MOVE WO-LINE-1      TO PRINT-REC.
           WRITE PRINT-REC     AFTER ADVANCING 2 LINES.
           MOVE WO-LINE-2      TO PRINT-REC.
           WRITE PRINT-REC     AFTER ADVANCING 2 LINES.
           MOVE WO-LINE-3      TO PRINT-REC.
           WRITE PRINT-REC.
           MOVE WO-LINE-4      TO PRINT-REC.
           WRITE PRINT-REC.
           MOVE WO-LINE-5      TO PRINT-REC.
           WRITE PRINT-REC.
           MOVE WO-LINE-6      TO PRINT-REC.
           WRITE PRINT-REC.
           MOVE WO-LINE-7      TO PRINT-REC.
           WRITE PRINT-REC.
           MOVE WO-LINE-8      TO PRINT-REC.
           WRITE PRINT-REC.
           MOVE WO-LINE-9      TO PRINT-REC.
           WRITE PRINT-REC.
           MOVE WO-LINE-10     TO PRINT-REC.
           WRITE PRINT-REC     AFTER ADVANCING 2 LINE.

       WO-OPEN-LABOR.
      **********************************************************************
      **    MESSAGE 045/021:
      **  SEARCHING FOR OPEN LABOR
      **********************************************************************
           MOVE 45             TO CATREAD-MSG-SET.
           MOVE 21             TO CATREAD-MSG-NUM.
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
           ADD 1               TO SUB.
           MOVE MESSAGE-BUFFER TO FM(SUB).

           MOVE SCREEN-DATA    TO DISPLAY-REC.
           WRITE DISPLAY-REC   FORMAT IS SCREEN-NAME
               INDIC ARE SCREEN-INDICATORS.
           IF SCREEN-STATUS NOT = "00"
               DISPLAY "SCREEN WRITE ERROR.  SCREEN-STATUS IS "
                        SCREEN-STATUS
               GO TO END-OF-JOB.

           MOVE HEADING-DOTS   TO PRINT-REC.
           WRITE PRINT-REC     AFTER ADVANCING 2.
           MOVE HEADING-2      TO PRINT-REC.
           WRITE PRINT-REC     AFTER ADVANCING 2.
           MOVE HEADING-3      TO PRINT-REC.
           WRITE PRINT-REC     AFTER ADVANCING 2.

           MOVE WO-NUMBER-BUF  TO WONUM OF LAB-CURR-STAT.
           START LAB-CURR-STAT KEY = WONUM OF LAB-CURR-STAT
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT-1 = "2"
               GO TO WO-LABOR-SEARCH
           ELSE
           IF FILE-STAT NOT = "00"
               MOVE FILE-STAT  TO CON-WORD
               MOVE "START   " TO DB-FUNC
               MOVE "LABOR-CURR-STAT " TO DB-FILE
               MOVE DB-ERROR   TO MESSAGE-BUFFER
               PERFORM ERROR-ROUTINE
               GO TO ENTER-WO-NUMBER.

           PERFORM READ-OPEN-LABOR THRU ROL-EXIT.

       WO-LABOR-SEARCH.
      **********************************************************************
      **    MESSAGE 045/008:
      **  SEARCHING FOR CLOSED LABOR
      **********************************************************************
           MOVE 45             TO CATREAD-MSG-SET.
           MOVE  8             TO CATREAD-MSG-NUM.
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
           ADD 1               TO SUB.
           MOVE MESSAGE-BUFFER TO FM(SUB).

           MOVE SCREEN-DATA    TO DISPLAY-REC.
           WRITE DISPLAY-REC   FORMAT IS SCREEN-NAME
               INDIC ARE SCREEN-INDICATORS.
           IF SCREEN-STATUS NOT = "00"
               DISPLAY "SCREEN WRITE ERROR.  SCREEN-STATUS IS "
                        SCREEN-STATUS
               GO TO END-OF-JOB.

           MOVE 0              TO EOF-SW.
           MOVE HEADING-DOTS   TO PRINT-REC.
           WRITE PRINT-REC     AFTER ADVANCING 2.
           MOVE HEADING-4      TO PRINT-REC.
           WRITE PRINT-REC     AFTER ADVANCING 2.
           MOVE HEADING-5      TO PRINT-REC.
           WRITE PRINT-REC     AFTER ADVANCING 2.
           SORT SORT-FILE      ASCENDING KEY SORT-FIELD
               INPUT PROCEDURE  SORT-WO-LABOR-IN
               OUTPUT PROCEDURE SORT-WO-LABOR-OUT.
           MOVE 0              TO ACT-KEY.

           OPEN INPUT          OUT-FILE.
           PERFORM READ-WO-LABOR THRU RWL-EXIT UNTIL EOF.
           CLOSE               OUT-FILE.

       WO-PARTS-SEARCH.
      **********************************************************************
      **    MESSAGE 045/010:
      **  SEARCHING FOR PARTS USED
      **********************************************************************
           MOVE 45             TO CATREAD-MSG-SET.
           MOVE 10             TO CATREAD-MSG-NUM.
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
           ADD 1               TO SUB.
           MOVE MESSAGE-BUFFER TO FM(SUB).

           MOVE SCREEN-DATA    TO DISPLAY-REC.
           WRITE DISPLAY-REC   FORMAT IS SCREEN-NAME
               INDIC ARE SCREEN-INDICATORS.
           IF SCREEN-STATUS NOT = "00"
               DISPLAY "SCREEN WRITE ERROR.  SCREEN-STATUS IS "
                        SCREEN-STATUS
               GO TO END-OF-JOB.

           MOVE HEADING-DOTS   TO PRINT-REC.
           WRITE PRINT-REC     AFTER ADVANCING 2.
           MOVE HEADING-6      TO PRINT-REC.
           WRITE PRINT-REC     AFTER ADVANCING 2.
           MOVE HEADING-7      TO PRINT-REC.
           WRITE PRINT-REC     AFTER ADVANCING 2.

           MOVE WO-NUMBER-BUF  TO WONUM OF WO-PARTS.
           START WO-PARTS      KEY = WONUM OF WO-PARTS
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT-1 = "2"
               GO TO WO-MESSAGES
           ELSE
           IF FILE-STAT NOT = "00"
               MOVE FILE-STAT  TO CON-WORD
               MOVE "START   " TO DB-FUNC
               MOVE "WO-PARTS" TO DB-FILE
               MOVE DB-ERROR   TO MESSAGE-BUFFER
               PERFORM ERROR-ROUTINE
               GO TO ENTER-WO-NUMBER.

           PERFORM READ-PARTS  THRU RP-EXIT.

       WO-MESSAGES.
      **********************************************************************
      **    MESSAGE 045/011:
      **  SEARCHING FOR WO-MESSAGES
      **********************************************************************
           MOVE 45             TO CATREAD-MSG-SET.
           MOVE 11             TO CATREAD-MSG-NUM.
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
           ADD 1               TO SUB.
           MOVE MESSAGE-BUFFER TO FM(SUB).

           MOVE SCREEN-DATA    TO DISPLAY-REC.
           WRITE DISPLAY-REC   FORMAT IS SCREEN-NAME
               INDIC ARE SCREEN-INDICATORS.
           IF SCREEN-STATUS NOT = "00"
               DISPLAY "SCREEN WRITE ERROR.  SCREEN-STATUS IS "
                        SCREEN-STATUS
               GO TO END-OF-JOB.

           MOVE HEADING-DOTS   TO PRINT-REC.
           WRITE PRINT-REC     AFTER ADVANCING 2.
           MOVE HEADING-8      TO PRINT-REC.
           WRITE PRINT-REC     AFTER ADVANCING 2.

           MOVE WO-NUMBER-BUF  TO TOWO OF WO-MESSAGE.
           START WO-MESSAGE    KEY =  TOWO OF WO-MESSAGE
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT-1 = "2"
               GO TO WO-SCHEDULE-SEARCH
           ELSE
           IF FILE-STAT NOT = "00"
               MOVE FILE-STAT  TO CON-WORD
               MOVE "START   " TO DB-FUNC
               MOVE "WO-MESSAGE" TO DB-FILE
               MOVE DB-ERROR   TO MESSAGE-BUFFER
               PERFORM ERROR-ROUTINE
               GO TO ENTER-WO-NUMBER.

           PERFORM READ-MESSAGES THRU RM-EXIT.

       WO-SCHEDULE-SEARCH.
           IF BASIC-FILE       GO TO WO-TRACKING.
      **********************************************************************
      **    MESSAGE 045/013:
      **  SEARCHING FOR WO-SCHEDULE
      **********************************************************************
           MOVE 45             TO CATREAD-MSG-SET.
           MOVE 13             TO CATREAD-MSG-NUM.
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
           ADD 1               TO SUB.
           MOVE MESSAGE-BUFFER TO FM(SUB).

           MOVE SCREEN-DATA    TO DISPLAY-REC.
           WRITE DISPLAY-REC   FORMAT IS SCREEN-NAME
               INDIC ARE SCREEN-INDICATORS.
           IF SCREEN-STATUS NOT = "00"
               DISPLAY "SCREEN WRITE ERROR.  SCREEN-STATUS IS "
                        SCREEN-STATUS
               GO TO END-OF-JOB.

           MOVE 0              TO EOF-SW.
           MOVE HEADING-DOTS   TO PRINT-REC.
           WRITE PRINT-REC     AFTER ADVANCING 2.
           MOVE HEADING-9      TO PRINT-REC.
           WRITE PRINT-REC     AFTER ADVANCING 2.
           MOVE HEADING-10     TO PRINT-REC.
           WRITE PRINT-REC     AFTER ADVANCING 2.
           SORT SORT-FILE      ASCENDING KEY SORT-FIELD
               INPUT PROCEDURE  SORT-WO-SCHED-IN
               OUTPUT PROCEDURE SORT-WO-SCHED-OUT.
           MOVE 0              TO ACT-KEY.

           OPEN INPUT          OUT-FILE.
           PERFORM READ-WO-SCHED THRU RWS-EXIT UNTIL EOF.
           CLOSE               OUT-FILE.

       WO-TRACKING.
      **********************************************************************
      **    MESSAGE 045/023:
      **  SEARCHING FOR WO-TRACKING
      **********************************************************************
           MOVE 45             TO CATREAD-MSG-SET.
           MOVE 23             TO CATREAD-MSG-NUM.
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
           ADD 1               TO SUB.
           MOVE MESSAGE-BUFFER TO FM(SUB).

           MOVE SCREEN-DATA    TO DISPLAY-REC.
           WRITE DISPLAY-REC   FORMAT IS SCREEN-NAME
               INDIC ARE SCREEN-INDICATORS.
           IF SCREEN-STATUS NOT = "00"
               DISPLAY "SCREEN WRITE ERROR.  SCREEN-STATUS IS "
                        SCREEN-STATUS
               GO TO END-OF-JOB.

           MOVE HEADING-DOTS   TO PRINT-REC.
           WRITE PRINT-REC     AFTER ADVANCING 2.
           MOVE HEADING-11     TO PRINT-REC.
           WRITE PRINT-REC     AFTER ADVANCING 2.
           MOVE HEADING-12     TO PRINT-REC.
           WRITE PRINT-REC     AFTER ADVANCING 2.

           MOVE WO-NUMBER-BUF  TO WONUM OF WO-TRACK-FILE.
           START WO-TRACK-FILE KEY =  WONUM OF WO-TRACK-FILE
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT-1 = "2"
               GO TO MF-EXIT
           ELSE
           IF FILE-STAT NOT = "00"
               MOVE FILE-STAT  TO CON-WORD
               MOVE "START   " TO DB-FUNC
               MOVE "WO-TRACK-FILE" TO DB-FILE
               MOVE DB-ERROR   TO MESSAGE-BUFFER
               PERFORM ERROR-ROUTINE
               GO TO ENTER-WO-NUMBER.

           PERFORM READ-TRACKING THRU RT-EXIT.

       MF-EXIT.                EXIT.

       END-OF-JOB.
           CLOSE               WO-NUMBER.
           CLOSE               WO-BASIC.
           CLOSE               WO-PLANNED.
           CLOSE               WO-LABOR.
           CLOSE               WO-PARTS.
           CLOSE               LAB-CURR-STAT.
           CLOSE               WO-SCHEDULE.
           CLOSE               WO-MESSAGE.
           CLOSE               WO-TRACK-FILE.
           CLOSE               DISPLAY-FILE.
           GOBACK.

       ERROR-ROUTINE.
           MOVE B"1"           TO IND(01) IND(99).
           MOVE MESSAGE-BUFFER TO ERRMSG.

       999-CATREAD.
           MOVE SPACES         TO MESSAGE-BUFFER.
           CALL "CCATREAD"     USING CATREAD-PARMS.
           MOVE CATREAD-MSG-TEXT TO MESSAGE-BUFFER.

       999-CATREAD-EXIT.       EXIT.

       READ-OPEN-LABOR.
           MOVE SPACES         TO OPEN-WO-LABOR.
           READ LAB-CURR-STAT  NEXT INTO CURR-LABOR-DATA
               AT END          MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
               IF FILE-STAT = "10" OR "14" OR "46"
                   GO TO ROL-EXIT
               ELSE
                   MOVE FILE-STAT  TO CON-WORD
                   MOVE "READ    " TO DB-FUNC
                   MOVE "LAB-CURR-STAT" TO DB-FILE
                   MOVE DB-ERROR   TO MESSAGE-BUFFER
                   PERFORM ERROR-ROUTINE
                   GO TO ENTER-WO-NUMBER.

           IF WO-NUMBER-BUF NOT = LCS-WO-NUM
               GO TO ROL-EXIT.

           MOVE LCS-EMPL-NUM   TO NUM-CC.
           MOVE C-START-DATE   TO DATE-VALIDATE-IN.
           CALL "TDATECHK"     USING DATE-CHECK-AREA.
           MOVE DATE-SLASH-OUT TO OS-DATE.
           MOVE C-START-TIME   TO OS-TIME.
           MOVE OPEN-WO-LABOR  TO PRINT-REC.
           WRITE PRINT-REC     AFTER ADVANCING 2.
           GO TO READ-OPEN-LABOR.

       ROL-EXIT.               EXIT.

       READ-WO-LABOR.
           ADD 1               TO ACT-KEY.
           MOVE SPACES         TO OUT-REC DETAIL-WO-LABOR.
           READ OUT-FILE       INVALID KEY
               MOVE 1          TO EOF-SW
               GO TO RWL-EXIT.
           IF ACT-KEY > MAX-KEY
               MOVE 1          TO EOF-SW
               GO TO RWL-EXIT.

           MOVE OUT-4          TO CC-NUM.
           MOVE OUT-28         TO CC-NAME.
           MOVE OUT-2          TO CC-CRFT.
           MOVE OUT-70-2       TO SORT-HRS.
           MOVE SORT-H         TO H-2.
           MOVE SORT-H-T       TO H-TEN.
           MOVE "."            TO H-DOT C-DOT.
           MOVE OUT-8          TO SORT-COST.
           MOVE SORT-CST       TO C-DOL.
           MOVE SORT-CST-T     TO C-CNT.
           MOVE OUT-10         TO SORT-DATE.
           MOVE SORT-DAY       TO DATE-VALIDATE-IN.
           CALL "TDATECHK"     USING DATE-CHECK-AREA.
           MOVE DATE-SLASH-OUT TO S-DATE.
           MOVE SORT-TIME      TO S-TIME.
           MOVE OUT-70-3       TO SORT-DATE.
           MOVE SORT-DAY       TO DATE-VALIDATE-IN.
           CALL "TDATECHK"     USING DATE-CHECK-AREA.
           MOVE DATE-SLASH-OUT TO C-DATE.
           MOVE SORT-TIME      TO C-TIME.
           MOVE DETAIL-WO-LABOR TO PRINT-REC.
           WRITE PRINT-REC     AFTER ADVANCING 2.
           GO TO READ-WO-LABOR.

       RWL-EXIT.               EXIT.

       READ-PARTS.
           MOVE SPACES         TO DETAIL-WO-PARTS.
           READ WO-PARTS       NEXT INTO WO-PARTS-DATA
               AT END          MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
               IF FILE-STAT = "10" OR "14" OR "46"
                   GO TO RP-EXIT
               ELSE
                   MOVE FILE-STAT  TO CON-WORD
                   MOVE "READ    " TO DB-FUNC
                   MOVE "WO-PARTS" TO DB-FILE
                   MOVE DB-ERROR   TO MESSAGE-BUFFER
                   PERFORM ERROR-ROUTINE
                   GO TO ENTER-WO-NUMBER.

           IF WO-NUMBER-BUF NOT = PRT-WO-NU
               GO TO RP-EXIT.

           IF PRT-ACT-QTY = "        "
               MOVE 0          TO P-QTY
           ELSE
           MOVE PRT-ACT-QTY-9  TO P-QTY.
           MOVE PRT-UNIT-MEAS  TO P-UM.
           MOVE PRT-NUM        TO P-CODE.
           MOVE PRT-DATE-USED  TO DATE-VALIDATE-IN.
           CALL "TDATECHK"     USING DATE-CHECK-AREA.
           MOVE DATE-SLASH-OUT TO P-DATE-USED.
           IF PRT-ACT-COST = SPACES
               MOVE ZEROES     TO P-ACT-COST.
           MOVE "."            TO P-DOT.
           MOVE PRT-ACT-COST-DOLLR TO P-C.
           MOVE PRT-ACT-COST-CENTS TO P-TEN.
           IF P-TEN NOT NUMERIC
               MOVE "00"       TO P-TEN.

           MOVE DETAIL-WO-PARTS TO PRINT-REC.
           WRITE PRINT-REC     AFTER ADVANCING 2.
           MOVE PRT-DESC       TO PRINT-REC.
           WRITE PRINT-REC.
           GO TO READ-PARTS.

       RP-EXIT.                EXIT.

       READ-MESSAGES.
           READ WO-MESSAGE     NEXT INTO WO-MSG-DATA
               AT END          MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
               IF FILE-STAT = "10" OR "14" OR "46"
                   GO TO RM-EXIT
               ELSE
                   MOVE FILE-STAT  TO CON-WORD
                   MOVE "READ    " TO DB-FUNC
                   MOVE "WO-MESSAGE" TO DB-FILE
                   MOVE DB-ERROR   TO MESSAGE-BUFFER
                   PERFORM ERROR-ROUTINE
                   GO TO ENTER-WO-NUMBER.

           IF WO-NUMBER-BUF NOT = TO-WO
               GO TO RM-EXIT.

           MOVE DATE-INIT      TO DATE-VALIDATE-IN.
           CALL "TDATECHK"     USING DATE-CHECK-AREA.
           MOVE DATE-SLASH-OUT TO DATE-SIG.
           MOVE FROM-CC        TO C-FROM.
           IF C-FROM = "9999"  MOVE SPACES TO C-FROM.
           MOVE FROM-SIGNON    TO SIGNIT.
           MOVE MESSAGE-SIGNITURE TO PRINT-REC.
           WRITE PRINT-REC     AFTER ADVANCING 2.
           MOVE MESSAGE-1      TO MESSAGE-LINE.
           MOVE MESSAGE-LINE   TO PRINT-REC.
           WRITE PRINT-REC.
           MOVE MESSAGE-2      TO MESSAGE-LINE.
           MOVE MESSAGE-LINE   TO PRINT-REC.
           WRITE PRINT-REC.
           MOVE MESSAGE-3      TO MESSAGE-LINE.
           MOVE MESSAGE-LINE   TO PRINT-REC.
           WRITE PRINT-REC.
           MOVE MESSAGE-4      TO MESSAGE-LINE.
           MOVE MESSAGE-LINE   TO PRINT-REC.
           WRITE PRINT-REC.
           MOVE MESSAGE-5      TO MESSAGE-LINE.
           MOVE MESSAGE-LINE   TO PRINT-REC.
           WRITE PRINT-REC.
           GO TO READ-MESSAGES.

       RM-EXIT.                EXIT.

       READ-WO-SCHED.
           ADD 1               TO ACT-KEY.
           MOVE SPACES         TO OUT-REC DETAIL-WO-SCHED.
           READ OUT-FILE       INVALID KEY
               MOVE 1          TO EOF-SW
               GO TO RWS-EXIT.
           IF ACT-KEY > MAX-KEY
               MOVE 1          TO EOF-SW
               GO TO RWS-EXIT.

           MOVE OUT-FIELD      TO SORT-SCHED.
           MOVE SORT-SC-DATE   TO SORT-DAY.
           MOVE SORT-DAY       TO DATE-VALIDATE-IN.
           CALL "TDATECHK"     USING DATE-CHECK-AREA.
           MOVE DATE-SLASH-OUT TO SC-DATE.
           MOVE SORT-SC-SHIFT  TO SC-SHIFT.
           MOVE SORT-SC-CRAFT  TO SC-CRAFT.
           MOVE OUT-2          TO SC-QTY.
           MOVE OUT-80         TO SC-REM.
           MOVE OUT-4          TO SORT-SC-HRS.
           MOVE SORT-SC-H      TO SC-H.
           MOVE SORT-SC-T      TO SC-TEN.
           MOVE "."            TO SC-DOT.
           MOVE DETAIL-WO-SCHED TO PRINT-REC.
           WRITE PRINT-REC.
           GO TO READ-WO-SCHED.

       RWS-EXIT.               EXIT.

       READ-TRACKING.
           MOVE SPACES         TO DETAIL-WO-TRACK.
           READ WO-TRACK-FILE  NEXT INTO WO-TRACK-DATA
               AT END          MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
               IF FILE-STAT = "10" OR "14" OR "46"
                   GO TO RT-EXIT
               ELSE
                   MOVE FILE-STAT TO CON-WORD
                   MOVE "READ    " TO DB-FUNC
                   MOVE "WO-TRACK-FILE" TO DB-FILE
                   MOVE DB-ERROR   TO MESSAGE-BUFFER
                   PERFORM ERROR-ROUTINE
                   GO TO ENTER-WO-NUMBER.

           IF WO-NUMBER-BUF NOT = WO-NUM-TRACK
               GO TO RT-EXIT.

           MOVE DATE-STAMP     TO DATE-VALIDATE-IN.
           CALL "TDATECHK"     USING DATE-CHECK-AREA.
           MOVE DATE-SLASH-OUT TO DATE-OUT-TRACK.
           MOVE TIME-STAMP     TO TIME-OUT.
           MOVE PROGRAM-NAME   TO PROGRAM-NAM.
           MOVE WO-STATUS-TRACK TO WO-STAT.
           MOVE TRANS-STATUS   TO TRAN-STAT.
           MOVE USER-NAME      TO USER-N.
           MOVE USER-TERM      TO USERT.
           MOVE USER-ID        TO ID-USER.
           MOVE CLOCK-CARD     TO CLK-CRD.
           MOVE WO-TYPE-STATUS TO TYPE-STAT.
           MOVE DETAIL-WO-TRACK TO PRINT-REC.
           WRITE PRINT-REC.
           GO TO READ-TRACKING.

       RT-EXIT.                EXIT.

       SORT-WO-LABOR-IN SECTION 02.
           MOVE 0              TO ACT-KEY.

       SORT-DBFIND-WL.
           MOVE WO-NUMBER-BUF  TO WONUM OF WO-LABOR.
           START WO-LABOR      KEY = WONUM OF WO-LABOR
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT-1 = "2"
               GO TO SORT-IP-WL-EXIT
           ELSE
           IF FILE-STAT NOT = "00"
               MOVE FILE-STAT  TO CON-WORD
               MOVE "START   " TO DB-FUNC
               MOVE "WO-LABOR        " TO DB-FILE
               MOVE DB-ERROR   TO MESSAGE-BUFFER
               PERFORM ERROR-ROUTINE
               GO TO ENTER-WO-NUMBER.

           PERFORM SORT-DBGET-WL THRU SORT-WL-EXIT.
           GO TO SORT-IP-WL-EXIT.

       SORT-DBGET-WL.
           MOVE SPACES         TO SORT-REC.
           READ WO-LABOR       NEXT INTO WO-LABOR-DATA
               AT END          MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
               IF FILE-STAT = "10" OR "14" OR "46"
                   GO TO SORT-WL-EXIT
               ELSE
                   MOVE FILE-STAT  TO CON-WORD
                   MOVE "READ    " TO DB-FUNC
                   MOVE "WO-LABOR" TO DB-FILE
                   MOVE DB-ERROR   TO MESSAGE-BUFFER
                   PERFORM ERROR-ROUTINE
                   GO TO ENTER-WO-NUMBER.

           IF WO-NUMBER-BUF NOT = LBR-WO-NUM
               GO TO SORT-WL-EXIT.

           MOVE LBR-START-DATE TO SORT-DAY.
           MOVE LBR-START-TIME TO SORT-TIME.
           MOVE SORT-DATE      TO SORT-FIELD SORT-10.
           MOVE LBR-CRAFT      TO SORT-2.
           MOVE LBR-EMPL-NUM   TO SORT-4.
           MOVE LBR-EMPL-NAME  TO SORT-28.
           MOVE LBR-CST        TO SORT-8.
           MOVE LBR-HRS        TO SORT-70-2.
           MOVE LBR-COMPL-DATE TO SORT-DAY.
           MOVE LBR-COMPL-TIME TO SORT-TIME.
           MOVE SORT-DATE      TO SORT-70-3.
           RELEASE SORT-REC.
           GO TO SORT-DBGET-WL.

       SORT-WL-EXIT.           EXIT.

       SORT-IP-WL-EXIT.        EXIT.

       SORT-WO-LABOR-OUT SECTION 03.
           OPEN OUTPUT         OUT-FILE.
           IF FILE-STAT NOT = "00"
               DISPLAY "FILE-STAT = " FILE-STAT " ON OPEN"
               GO TO END-OF-JOB.
           PERFORM SORT-LABOR-LOOP   THRU SLL-X.
           CLOSE               OUT-FILE.
           GO TO SORT-WLO-X.

       SORT-LABOR-LOOP.
           RETURN SORT-FILE AT END
               MOVE ACT-KEY    TO MAX-KEY
               GO TO SLL-X.
           ADD 1               TO ACT-KEY.
           MOVE SORT-REC       TO OUT-REC.
           WRITE OUT-REC       INVALID KEY
               DISPLAY "WRITE OUT-FILE ERR"
               GO TO SLL-X.
           GO TO SORT-LABOR-LOOP.

       SLL-X.    EXIT.

       SORT-WLO-X.    EXIT.

       SORT-WO-SCHED-IN SECTION 04.
           MOVE 0              TO ACT-KEY.

       SORT-DBFIND-WS.
           MOVE WO-NUMBER-BUF  TO WONUM OF WO-SCHEDULE.
           START WO-SCHEDULE   KEY = WONUM OF WO-SCHEDULE
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT-1 = "2"
               GO TO SORT-IP-WS-EXIT
           ELSE
           IF FILE-STAT NOT = "00"
               MOVE FILE-STAT  TO CON-WORD
               MOVE "START   " TO DB-FUNC
               MOVE "WO-SCHEDULE" TO DB-FILE
               MOVE DB-ERROR   TO MESSAGE-BUFFER
               PERFORM ERROR-ROUTINE
               GO TO ENTER-WO-NUMBER.

           PERFORM SORT-DBGET-WS THRU SORT-WS-EXIT.
           GO TO SORT-IP-WS-EXIT.

       SORT-DBGET-WS.
           MOVE SPACES         TO SORT-REC.
           READ WO-SCHEDULE NEXT INTO WO-SCHED-DATA
               AT END          MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
               IF FILE-STAT = "10" OR "14" OR "46"
                   GO TO SORT-WS-EXIT
               ELSE
                   MOVE FILE-STAT  TO CON-WORD
                   MOVE "READ    " TO DB-FUNC
                   MOVE "WO-SCHEDULE" TO DB-FILE
                   MOVE DB-ERROR   TO MESSAGE-BUFFER
                   PERFORM ERROR-ROUTINE
                   GO TO ENTER-WO-NUMBER.

           IF WO-NUMBER-BUF NOT = SCHED-WO
               GO TO SORT-WS-EXIT.

           MOVE SCHED-DATE     TO SORT-SC-DATE.
           MOVE SCHED-SHIFT    TO SORT-SC-SHIFT.
           MOVE SCHED-CRAFT    TO SORT-SC-CRAFT.
           MOVE SORT-SCHED     TO SORT-FIELD.
           MOVE SCHED-QTY      TO SORT-2.
           MOVE SCHED-HOURS    TO SORT-4.
           MOVE SCHED-REM      TO SORT-80.
           RELEASE SORT-REC.
           GO TO SORT-DBGET-WS.

       SORT-WS-EXIT.    EXIT.

       SORT-IP-WS-EXIT.    EXIT.

       SORT-WO-SCHED-OUT SECTION 05.
           OPEN OUTPUT         OUT-FILE.
           PERFORM SORT-SCHED-LOOP   THRU SSL-X.
           CLOSE               OUT-FILE.
           GO TO SORT-WO-SCHED-EXIT.

       SORT-SCHED-LOOP.
           RETURN SORT-FILE AT END
               MOVE ACT-KEY    TO MAX-KEY
               GO TO SSL-X.
           ADD 1               TO ACT-KEY.
           MOVE SORT-REC       TO OUT-REC.
           WRITE OUT-REC       INVALID KEY
               DISPLAY "WRITE OUT-FILE ERR"
               GO TO SSL-X.
           GO TO SORT-SCHED-LOOP.

       SSL-X.    EXIT.

       SORT-WO-SCHED-EXIT.    EXIT.

