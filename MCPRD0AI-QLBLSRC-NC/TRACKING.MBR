       IDENTIFICATION DIVISION.
       PROGRAM-ID.             TRACKING.
       AUTHOR.                 W. ROXBURY.
       INSTALLATION.           GOODYEAR TIRE & RUBBER COMPANY.
      *REMARKS.    **** MMIS WORKORDER TRACKING PRINTOUT PROGRAM ****
      *            ROUTES OUTPUT TO LOCALLY ASSIGNED CHARACTER PRINTER.
      *                      ****.
       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.
       SOURCE-COMPUTER.        IBM-AS400.
       OBJECT-COMPUTER.        IBM-AS400.
       SPECIAL-NAMES.          C01 IS NEW-PAGE.

       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT WO-LAST-NUM-USED
                  ASSIGN       TO DATABASE-MCFPMM0800
                  ORGANIZATION IS RELATIVE
                  ACCESS MODE  IS RANDOM
                  RELATIVE KEY IS ARG-NO
                  FILE STATUS  IS FILE-STAT.

           SELECT WO-NUMBER
                  ASSIGN       TO DATABASE-MCFLMM0101
                  ORGANIZATION IS INDEXED
                  ACCESS MODE  IS DYNAMIC
                  RECORD KEY   IS EXTERNALLY-DESCRIBED-KEY
                  FILE STATUS  IS FILE-STAT.

           SELECT WO-BASIC
                  ASSIGN       TO DATABASE-MCFLMM1001
                  ORGANIZATION IS INDEXED
                  ACCESS MODE  IS DYNAMIC
                  RECORD KEY   IS EXTERNALLY-DESCRIBED-KEY
                               WITH DUPLICATES
                  FILE STATUS  IS FILE-STAT.

           SELECT WO-PLANNED
                  ASSIGN       TO DATABASE-MCFLMM1101
                  ORGANIZATION IS INDEXED
                  ACCESS MODE  IS DYNAMIC
                  RECORD KEY   IS EXTERNALLY-DESCRIBED-KEY
                               WITH DUPLICATES
                  FILE STATUS  IS FILE-STAT.

           SELECT WO-LABOR
                  ASSIGN       TO DATABASE-MCFLMM1301
                  ORGANIZATION IS INDEXED
                  ACCESS MODE  IS DYNAMIC
                  RECORD KEY   IS EXTERNALLY-DESCRIBED-KEY
                               WITH DUPLICATES
                  FILE STATUS  IS FILE-STAT.

           SELECT WO-PARTS
                  ASSIGN       TO DATABASE-MCFLMM1201
                  ORGANIZATION IS INDEXED
                  ACCESS MODE  IS DYNAMIC
                  RECORD KEY   IS EXTERNALLY-DESCRIBED-KEY
                               WITH DUPLICATES
                  FILE STATUS  IS FILE-STAT.

           SELECT LAB-CURR-STAT
                  ASSIGN       TO DATABASE-MCFLMM1602
                  ORGANIZATION IS INDEXED
                  ACCESS MODE  IS DYNAMIC
                  RECORD KEY   IS EXTERNALLY-DESCRIBED-KEY
                               WITH DUPLICATES
                  FILE STATUS  IS FILE-STAT.

           SELECT WO-SCHEDULE
                  ASSIGN       TO DATABASE-MCFLMM2302
                  ORGANIZATION IS INDEXED
                  ACCESS MODE  IS DYNAMIC
                  RECORD KEY   IS EXTERNALLY-DESCRIBED-KEY
                               WITH DUPLICATES
                  FILE STATUS  IS FILE-STAT.

           SELECT WO-MESSAGE
                  ASSIGN       TO DATABASE-MCFLMM2403
                  ORGANIZATION IS INDEXED
                  ACCESS MODE  IS DYNAMIC
                  RECORD KEY   IS EXTERNALLY-DESCRIBED-KEY
                               WITH DUPLICATES
                  FILE STATUS  IS FILE-STAT.

           SELECT WO-TRACK-FILE
                  ASSIGN       TO DATABASE-MCFLMM2601
                  ORGANIZATION IS INDEXED
                  ACCESS MODE  IS DYNAMIC
                  RECORD KEY   IS EXTERNALLY-DESCRIBED-KEY
                               WITH DUPLICATES
                  FILE STATUS  IS FILE-STAT.

           SELECT DISPLAY-FILE
                  ASSIGN       TO WORKSTATION-ZTRACKWO-SI
                  ORGANIZATION IS TRANSACTION
                  ACCESS MODE  IS SEQUENTIAL
                  FILE STATUS  IS SCREEN-STATUS
                               MAJOR-MINOR
                  CONTROL-AREA IS SCREEN-CONTROL.

           SELECT PRINT-FILE
               ASSIGN          TO PRINTER-MCPRT.

           SELECT OUT-FILE
                  ASSIGN       TO DISK-OUTTRACK
                  ORGANIZATION IS RELATIVE
                  ACCESS MODE  IS RANDOM
                  RELATIVE KEY IS ACT-KEY
                  FILE STATUS  IS FILE-STAT.

           SELECT SORT-FILE
                  ASSIGN       TO DISK-SORTFILE.

       DATA DIVISION.
       FILE SECTION.
       FD  WO-LAST-NUM-USED
           LABEL RECORDS ARE STANDARD.
       01  WO-REC.
           COPY DDS-ALL-FORMATS OF MCFPMM0800.

       FD  WO-NUMBER
           LABEL RECORDS ARE STANDARD.
       01  WN-REC.
           COPY DDS-ALL-FORMATS OF MCFLMM0101.

       FD  WO-BASIC
           LABEL RECORDS ARE STANDARD.
       01  VWO-REC.
           COPY DDS-ALL-FORMATS OF MCFLMM1001.

       FD  WO-PLANNED
           LABEL RECORDS ARE STANDARD.
       01  PWO-REC.
           COPY DDS-ALL-FORMATS OF MCFLMM1101.

       FD  WO-LABOR
           LABEL RECORDS ARE STANDARD.
       01  LABS-REC.
           COPY DDS-ALL-FORMATS OF MCFLMM1301.

       FD  WO-PARTS
           LABEL RECORDS ARE STANDARD.
       01  WOP-REC.
           COPY DDS-ALL-FORMATS OF MCFLMM1201.

       FD  LAB-CURR-STAT
           LABEL RECORDS ARE STANDARD.
       01  LC-REC.
           COPY DDS-ALL-FORMATS OF MCFLMM1602.

       FD  WO-SCHEDULE
           LABEL RECORDS ARE STANDARD.
       01  WOS-REC.
           COPY DDS-ALL-FORMATS OF MCFLMM2302.

       FD  WO-MESSAGE
           LABEL RECORDS ARE STANDARD.
       01  MWO-REC.
           COPY DDS-ALL-FORMATS OF MCFLMM2403.

       FD  WO-TRACK-FILE
           LABEL RECORDS ARE STANDARD.
       01  WOTRK.
           COPY DDS-MCRPMM2600  OF MCFLMM2601.

       FD  DISPLAY-FILE
           LABEL RECORDS ARE OMITTED.
       01  DISPLAY-REC         PIC X(2000).

       FD  PRINT-FILE
           LABEL RECORD IS OMITTED
           RECORD CONTAINS 80 CHARACTERS
           DATA RECORD IS PRINT-REC.
       01  PRINT-REC           PIC X(80).

       FD  OUT-FILE RECORD     CONTAINS 426 CHARACTERS
           LABEL RECORDS       ARE OMITTED
           DATA RECORD         IS OUT-REC.
       01  OUT-REC.
           05  OUT-FIELD       PIC X(10).
           05  OUT-DISPLAY.
               10  OUT-2       PIC X(02).
               10  OUT-4       PIC X(04).
               10  OUT-8       PIC X(12).
               10  OUT-10      PIC X(10).
               10  OUT-28      PIC X(28).
               10  OUT-80      PIC X(80).
               10  OUT-70-2    PIC X(70).
               10  OUT-70-3    PIC X(70).
               10  OUT-70-4    PIC X(70).
               10  OUT-70-5    PIC X(70).

       SD  SORT-FILE RECORD    CONTAINS 426 CHARACTERS
           DATA RECORD         IS SORT-REC.
       01  SORT-REC.
           05  SORT-FIELD      PIC X(10).
           05  SORT-DISPLAY.
               10  SORT-2      PIC X(02).
               10  SORT-4      PIC X(04).
               10  SORT-8      PIC X(12).
               10  SORT-10     PIC X(10).
               10  SORT-28     PIC X(28).
               10  SORT-80     PIC X(80).
               10  SORT-70-2   PIC X(70).
               10  SORT-70-3   PIC X(70).
               10  SORT-70-4   PIC X(70).
               10  SORT-70-5   PIC X(70).

       WORKING-STORAGE SECTION.
       77  ARG-NO              PIC 9999  VALUE 1.
       77  RETURN-COD          PIC X.
       77  ACT-KEY             PIC 9999  VALUE 0.
       77  MAX-KEY             PIC 9999  VALUE 0.
       77  SUB                 PIC 99    VALUE 0.
       77  EOF-SW              PIC 9     VALUE 0.
           88  EOF                       VALUE 1.
       77  FILE-SW             PIC X     VALUE "B".
           88  BASIC-FILE                VALUE "B".

       COPY CCRTFILE IN COPYLIB.

       01  PASSWORD-INFORMATION.
           05  NAME-OF-PROGRAM     PIC X(08) VALUE "TRACKING".
           05  PROGRAM-TYPE        PIC X(02) VALUE "RE".
           05  PROGRAM-RELEASE     PIC X(12) VALUE " E0100010001".
           05  PROGRAM-DESCRIPTION.
               10  PROG-DESC-A     PIC X(60) VALUE
               "PRINTS OUT TRACKING RECORDS ON A WORK ORDER          ".
               10  PROG-DESC-B     PIC X(60) VALUE
               "                                                     ".
               10  PROG-FUNCTION   PIC X(60) VALUE
               "                                                     ".
           05  PASSWORD-FLAG       PIC X VALUE "Y".

       01  FILE-STAT.
           05 FILE-STAT-1      PIC X   VALUE "0".
           05 FILE-STAT-2      PIC X   VALUE "0".

       01  SORT-DATE.
           05  SORT-DAY.
               10  SORT-YY     PIC XX.
               10  SORT-MM     PIC XX.
               10  SORT-DD     PIC XX.
           05  SORT-TIME       PIC X(4).

       01  SORT-SCHED.
           05  SORT-SC-DATE    PIC X(06).
           05  SORT-SC-SORT    PIC X.
           05  SORT-SC-SHIFT   PIC X.
           05  SORT-SC-CRAFT   PIC XX.

       01  SORT-HRS.
           05  SORT-H          PIC XX.
           05  SORT-H-T        PIC X.

       01  SORT-SC-HRS.
           05  SORT-SC-H       PIC XXX.
           05  SORT-SC-T       PIC X.

       01  SORT-COST.
           05  SORT-CST        PIC X(10).
           05  SORT-CST-T      PIC XX.

       01  DATE-HOLD.
           05  DH-MM           PIC XX.
           05  DH-DD           PIC XX.
           05  DH-YY           PIC XX.

       01  SCREEN-DATA.
           05  WO-NUMBER-BUF.
               10  WO-NUM-BUF  PIC X(06).
               10  WO-YEAR-BUF PIC X.
               10  WO-SUF-BUF  PIC XXX.
           05  FILE-MSGS.
               10  FM          OCCURS 10 TIMES PIC X(30).
           05  COMP-MSG        PIC X(56).
           05  SCREEN-MSGS.
               10  CMDMSG      PIC X(79).
               10  ERRMSG      PIC X(79).

       01  END-MESSAGE.
           05  HOLD-MSG        PIC X(56).
           05  PRINTED.
               10  FILLER      PIC X(33)
                       VALUE "TRACKING PRINTOUT FOR WORK ORDER ".
               10  WCOMP       PIC X(10).
               10  FILLER      PIC X(13) VALUE " IS COMPLETED".

       01  CHECK-YEAR.
           05  FILLER          PIC X.
           05  CHECK-YEAR-NUM  PIC 9.
           05  FILLER          PIC XXXX.

       COPY TBLOWUP  IN COPYLIB.

