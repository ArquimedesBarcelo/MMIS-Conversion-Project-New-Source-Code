       IDENTIFICATION DIVISION.
       PROGRAM-ID.  TSTRVALU.
       DATE-COMPILED.
      ************************************************************
      ** THIS PROGRAM REPORTS ON MSTORERM CORPORATELY CODED     **
      ** ITEMS. THE PROGRAM IS ESPECIALLY FOR DANVILLE.         **
      ************************************************************
       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.
       COPY SPECIALN OF COPYLIB.
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT MSTORERM-I
               ASSIGN TO DATABASE-MCFLCS0201
               ORGANIZATION IS INDEXED
                 ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
               FILE STATUS IS FILE-STATUS.

           SELECT PRINT-FILE ASSIGN TO PRINTER-MCPRT.

           SELECT SORT-FILE ASSIGN TO DISK-SORTFILE.

       DATA DIVISION.
       FILE SECTION.
       FD  MSTORERM-I
           LABEL RECORDS ARE STANDARD.
       01  MSTORERM-REC-I.
           COPY DDS-MCRPCS0200  OF MCFLCS0201.

       FD  PRINT-FILE
           LABEL RECORDS ARE OMITTED
           RECORD CONTAINS 132 CHARACTERS
           DATA RECORD IS PRINT-REC.
       01  PRINT-REC.
           05  FILLER                    PIC X(39).
           05  PRINT-REC-DESC            PIC X(93).

       SD  SORT-FILE RECORD CONTAINS 432 CHARACTERS
           DATA RECORD IS SORT-REC.
       01  SORT-REC.
           05  SORT-CORPCDE              PIC X(8).
           05  SORT-ONHAND               PIC 9(8).
           05  SORT-AVGCOST              PIC S9(11)V9(4).
           05  SORT-DESC-LINE OCCURS 5   PIC X(80).
           05  FILLER                    PIC X.

       WORKING-STORAGE SECTION.
       77  LINE-CTR                      PIC 99.
       77  SAVE-CLASS                    PIC X(3).
       77  SUB                           PIC S9(4) COMP-4.
       77  TOT-RECS-CTR                  PIC 9(5).
       77  TOT-DOLS                      PIC 9(16)V99.
       77  TOT-VALUE                     PIC S9(12)V9(4).
       01  BASE                          PIC X(10).
       01  COMPRESS-PRINT                PIC X(8).
       01  CUR-DATE.
           05  CUR-DATE-YY               PIC 99.
           05  CUR-DATE-MM               PIC 99.
           05  CUR-DATE-DD               PIC 99.
       01  CUR-DATE-WA.
           05  CUR-DATE-CCYY-WA.
               10  CUR-DATE-CC-WA        PIC 99.
               10  CUR-DATE-YY-WA        PIC 99.
           05  CDY-WA REDEFINES CUR-DATE-CCYY-WA
                                         PIC 9(4).
           05  CUR-DATE-MM-WA            PIC 99.
           05  CUR-DATE-DD-WA            PIC 99.

       01  D1.
           05  D1-CC   PIC X(8)  VALUE SPACES.
           05  FILLER  PIC XX    VALUE SPACES.
           05  D1-ONH  PIC Z(7)9.
           05  FILLER  PIC XX    VALUE SPACES.
           05  D1-AVG  PIC Z(10)9.9999.
           05  FILLER  PIC XX    VALUE SPACES.
           05  D1-VAL  PIC Z(10)99.9999.
           05  FILLER  PIC X(25) VALUE SPACES.

       01  D2.
           05  D2-DESC PIC X(80) VALUE SPACES.

       COPY ESCNAM2 IN COPYLIB.

       01  FNUM                          PIC S9(4) COMP-4 VALUE 0.

       01  HANDLE-BLOWUP-FLAG            PIC X(1)  VALUE "Y".

       01  HD-FILE-NAME PIC X(17) VALUE "DHDR107.PUB".
       01  HD-RET-CODE                   PIC S9(4) COMP-4 VALUE 0.

       01  H0.
           05  FILLER  PIC X(4)  VALUE SPACE.
           05  FILLER  PIC X(39)
               VALUE "CORPORATE CODES WITH NO ACTIVITY SINCE ".
           05  H0-DATE PIC X(8)  VALUE SPACES.
           05  FILLER  PIC X(25) VALUE SPACES.
           05  FILLER  PIC X(4)  VALUE "R107".

       01  H1.
           05  FILLER  PIC X(8)  VALUE "CORPCODE".
           05  FILLER  PIC XX    VALUE SPACES.
           05  FILLER  PIC X(8)  VALUE "  ONHAND".
           05  FILLER  PIC XX    VALUE SPACES.
           05  FILLER  PIC X(16) VALUE "    AVERAGE COST".
           05  FILLER  PIC XX    VALUE SPACES.
           05  FILLER  PIC X(17) VALUE " TOTAL ITEM VALUE".
           05  FILLER  PIC X(26) VALUE SPACES.

       01  H2.
           05  FILLER  PIC X(80) VALUE ALL "_".

       01  NORMAL-PRINT                  PIC X(8).

       01  T1.
           05  FILLER  PIC X(24)
               VALUE "TOTAL CODES ON REPORT = ".
           05  T1-RECS PIC Z(18).
           05  FILLER  PIC X(38) VALUE SPACES.

       01  T2.
           05  FILLER  PIC X(24)
               VALUE "TOTAL $ FOR ALL CODES = ".
           05  T2-DOLS PIC $$$,$$$,$$$,$$9.99.
           05  FILLER  PIC X(38) VALUE SPACES.

      *****************************************************************
      **                                                             **
      **  S U B P R O G R A M   A R E A                              **
      **                                                             **
      *****************************************************************
       COPY CDESC    IN COPYLIB.
       COPY TBLOWUP  IN COPYLIB.
       COPY TDATECHK IN COPYLIB.

      *****************************************************************
      **                                                             **
      **  D A T A B A S E   W O R K                                  **
      **                                                             **
      *****************************************************************
       COPY FILESTAT   IN COPYLIB.
       COPY DBSTAT     IN COPYLIB.
       COPY OVRPFDATA  IN COPYLIB.
       01  CODE-ARG                      PIC X(14).

      *****************************************************************
      **                                                             **
      **  D A T A B A S E   B U F F E R S                            **
      **                                                             **
      *****************************************************************
       COPY MSTORERM IN COPYLIB.

       COPY THDPRTB IN COPYLIB.
       01  OPTION-REC-1.
           05  OPT-DEPT-FROM-TO.
               10  OPT-DEPT-FROM         PIC X(4).
               10  OPT-DEPT-TO           PIC X(4).
           05  OPT-CC-FROM-TO.
               10  OPT-CC-FROM           PIC X(8).
               10  OPT-CC-TO             PIC X(8).
           05  FILLER                    PIC X(56).

       PROCEDURE DIVISION.
       START-PGM SECTION.
       START-IT.
           ACCEPT HD-ROUTE-DATA.
           DISPLAY "HD-ROUTE DATE = " HD-ROUTE-DATA.
           ACCEPT OPTION-REC-1.
           DISPLAY "OPTION-REC-1  = " OPTION-REC-1.
           OPEN INPUT  MSTORERM-I.
           CALL "TESCSEQ" USING ESC-NAME.
           MOVE CHAR-1636PI       TO COMPRESS-PRINT.
           MOVE CHAR-10PI         TO NORMAL-PRINT.
           MOVE HD-SPOOLER-NUMBER TO OVRPRTF-TOFILE-NUM.
           MOVE "*YES"            TO OVRPRTF-SHARED.
           MOVE HD-NO-OF-COPIES   TO OVRPRTF-COPIES.
           MOVE "MCPRT" TO OVRPRTF-FILE.
           PERFORM 996-OVERRIDE-PRINT-FILE.
           OPEN OUTPUT PRINT-FILE.
           CALL "THDPRT2" USING HD-RET-CODE, HD-FILE-NAME, FNUM,
               HD-ROUTE-DATA, ESC-NAME.
           IF HD-RET-CODE NOT = 0
               MOVE "THDPRT2 ERROR * TSTRVALU" TO BU-DISPLAY-MSG
               MOVE "HD-RET-CODE = "           TO BU-DISPLAY-FLD (1)
               MOVE HD-RET-CODE                TO BU-DISPLAY-FLD9 (1)
               PERFORM 2100-BLOWUP.
           IF PAPER-IS-132-COLS
               NEXT SENTENCE
           ELSE
           WRITE PRINT-REC FROM COMPRESS-PRINT AFTER ADVANCING 0 LINES.
           MOVE 0 TO TOT-RECS-CTR.
           ACCEPT CUR-DATE FROM DATE.
           MOVE CUR-DATE-MM TO CUR-DATE-MM-WA.
           MOVE CUR-DATE-DD TO CUR-DATE-DD-WA.
           MOVE CUR-DATE-YY TO CUR-DATE-YY-WA.
           IF CUR-DATE-YY-WA > 70
               MOVE 19      TO CUR-DATE-CC-WA
           ELSE
           MOVE 20          TO CUR-DATE-CC-WA.
           SUBTRACT 5 FROM CDY-WA.
           IF OPT-DEPT-FROM = "    "
               IF OPT-DEPT-TO = "    "
                   NEXT SENTENCE
               ELSE
               MOVE OPT-DEPT-TO TO OPT-DEPT-FROM
           ELSE
           IF OPT-DEPT-TO = "    "
               MOVE OPT-DEPT-FROM TO OPT-DEPT-TO.
           IF OPT-CC-FROM = "        "
               IF OPT-CC-TO = "        "
                   NEXT SENTENCE
               ELSE
               MOVE OPT-CC-TO TO OPT-CC-FROM
           ELSE
           IF OPT-CC-TO = "        "
               MOVE OPT-CC-FROM TO OPT-CC-TO.
           SORT SORT-FILE ASCENDING KEY SORT-CORPCDE
               INPUT PROCEDURE  7-SORT-RECORDS
               OUTPUT PROCEDURE 8-WRITE-REPORT.
           CLOSE MSTORERM-I.
           IF PAPER-IS-132-COLS
               NEXT SENTENCE
           ELSE
           MOVE SPACES TO PRINT-REC
           WRITE PRINT-REC FROM NORMAL-PRINT AFTER ADVANCING 0 LINES.
           CLOSE PRINT-FILE.
           GOBACK.

       2100-BLOWUP.
           DISPLAY "FATAL ERROR, FILE-STATUS = ", FILE-STATUS.
           DISPLAY "COND-WORD = ", COND-WORD.
           GOBACK.

       COPY OVRPFCALL IN COPYLIB.

       9999-BEGFIL-MSTORERM-I.
           MOVE SPACES TO CORPCDE OF MSTORERM-REC-I.
           START MSTORERM-I KEY >= CORPCDE OF MSTORERM-REC-I
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.

       9999-GETSER-MSTORERM-I.
           MOVE 0 TO COND-WORD.
           READ MSTORERM-I NEXT INTO BUF-MSTORERM
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS-1 = "1"
               MOVE 11 TO COND-WORD
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD
               IF HANDLE-BLOWUP-FLAG = "Y"
                   MOVE "GETSER ERR 9999-GETSER-MSTORERM-I"
                       TO BU-MSG-AREA
                   PERFORM 2100-BLOWUP.

       7-SORT-RECORDS SECTION.
       7-SORT-IT.
           PERFORM 9999-BEGFIL-MSTORERM-I.
       7-SR-LOOP.
           PERFORM 9999-GETSER-MSTORERM-I.
           IF END-OF-FILE GO TO 7-SR-EXIT.
           IF STR-ACT-DATE-CN = "        "
               MOVE ZEROES TO STR-ACT-DATE-CN.
           IF STR-ACT-DATE-CN < CUR-DATE-WA
               NEXT SENTENCE
           ELSE
           GO TO 7-SR-LOOP.
           IF OPT-DEPT-FROM-TO = "        "
               IF OPT-CC-FROM-TO = "                "
                   NEXT SENTENCE
               ELSE
               IF CORP-CODE NOT LESS THAN OPT-CC-FROM
                   IF CORP-CODE NOT GREATER THAN OPT-CC-TO
                       NEXT SENTENCE
                   ELSE
                   GO TO 7-SR-LOOP
               ELSE
               GO TO 7-SR-LOOP
           ELSE
           IF OPT-CC-FROM-TO = "                "
               IF STR-DFLT-DEPT NOT LESS THAN OPT-DEPT-FROM
                   IF STR-DFLT-DEPT NOT GREATER THAN OPT-DEPT-TO
                       NEXT SENTENCE
                   ELSE
                   GO TO 7-SR-LOOP
               ELSE
               GO TO 7-SR-LOOP
           ELSE
           IF CORP-CODE NOT LESS THAN OPT-CC-FROM
               IF CORP-CODE NOT GREATER THAN OPT-CC-TO
                   IF STR-DFLT-DEPT NOT LESS THAN OPT-DEPT-FROM
                       IF STR-DFLT-DEPT NOT GREATER THAN OPT-DEPT-TO
                           NEXT SENTENCE
                       ELSE
                       GO TO 7-SR-LOOP
                   ELSE
                   GO TO 7-SR-LOOP
               ELSE
               GO TO 7-SR-LOOP
           ELSE
           GO TO 7-SR-LOOP.
           ADD 1 TO TOT-RECS-CTR.
           MOVE CORP-CODE         TO  SORT-CORPCDE,
                                      CODE-ARG.
           MOVE STR-ONHAND        TO  SORT-ONHAND.
           MOVE STR-AVG-COST      TO  SORT-AVGCOST.
           MOVE 5                 TO  CDESC-LINES-TO-GET.
           MOVE "N"               TO  CDESC-LOCAL-DESC-OPTION.
126000     CALL "CDESC" USING CDESC-RET-CODE, BASE, STATUS-AREA,
126100       BU-DISPLAY-MSG, CODE-ARG, CDESC-DATA.
126200     IF BU-DISPLAY-MSG-1 NOT = SPACES
126300         PERFORM 2100-BLOWUP.
126400
           MOVE CDESC (1)         TO  SORT-DESC-LINE (1).
           MOVE CDESC (2)         TO  SORT-DESC-LINE (2).
           MOVE CDESC (3)         TO  SORT-DESC-LINE (3).
           MOVE CDESC (4)         TO  SORT-DESC-LINE (4).
           MOVE CDESC (5)         TO  SORT-DESC-LINE (5).
           RELEASE SORT-REC.
           GO TO 7-SR-LOOP.

       7-SR-EXIT.
           EXIT.

       8-WRITE-REPORT SECTION.
       8-WRITE-IT.
           MOVE 60 TO LINE-CTR.
           MOVE ZEROES TO TOT-DOLS.
       8-WR-LOOP.
           RETURN SORT-FILE AT END
               PERFORM 8-WRITE-TOTALS
               GO TO 8-WR-X.
           ADD 5 TO LINE-CTR.
           IF LINE-CTR > 60
               PERFORM 8-WRITE-HEADERS
           ELSE
           SUBTRACT 5 FROM LINE-CTR.
           MOVE SPACES TO PRINT-REC.
           MULTIPLY SORT-ONHAND BY SORT-AVGCOST
               GIVING TOT-VALUE ROUNDED.
           ADD TOT-VALUE TO TOT-DOLS.
           MOVE SORT-CORPCDE TO D1-CC.
           MOVE SORT-ONHAND  TO D1-ONH.
           MOVE SORT-AVGCOST TO D1-AVG.
           MOVE TOT-VALUE    TO D1-VAL.
           MOVE D1           TO PRINT-REC.
           WRITE PRINT-REC AFTER ADVANCING 1 LINES.
           ADD 1             TO LINE-CTR.
           MOVE SPACES TO PRINT-REC.
           MOVE SORT-DESC-LINE (1) TO D2-DESC.
           MOVE D2 TO PRINT-REC.
           WRITE PRINT-REC AFTER ADVANCING 1 LINES.
           ADD 1             TO LINE-CTR.
           IF SORT-DESC-LINE (2) = SPACES
               MOVE SPACES TO PRINT-REC
               WRITE PRINT-REC AFTER ADVANCING 1 LINES
               ADD 1         TO LINE-CTR
               GO TO 8-WR-LOOP.
           MOVE SPACES TO PRINT-REC.
           MOVE SORT-DESC-LINE (2) TO D2-DESC.
           MOVE D2 TO PRINT-REC.
           WRITE PRINT-REC AFTER ADVANCING 1 LINES.
           ADD 1             TO LINE-CTR.
           IF SORT-DESC-LINE (3) = SPACES
               MOVE SPACES TO PRINT-REC
               WRITE PRINT-REC AFTER ADVANCING 1 LINES
               ADD 1         TO LINE-CTR
               GO TO 8-WR-LOOP.
           MOVE SPACES TO PRINT-REC.
           MOVE SORT-DESC-LINE (3) TO D2-DESC.
           MOVE D2 TO PRINT-REC.
           WRITE PRINT-REC AFTER ADVANCING 1 LINES.
           ADD 1            TO LINE-CTR.
           MOVE SPACES TO PRINT-REC.
           WRITE PRINT-REC AFTER ADVANCING 1 LINES.
           ADD 1            TO LINE-CTR.
           GO TO 8-WR-LOOP.

       8-WRITE-TOTALS.
           ADD 3 TO LINE-CTR.
           IF LINE-CTR > 60
               PERFORM 8-WRITE-HEADERS
           ELSE
           MOVE SPACES TO PRINT-REC
           MOVE TOT-RECS-CTR TO T1-RECS
           MOVE T1 TO PRINT-REC
           WRITE PRINT-REC AFTER ADVANCING 2
           MOVE SPACES TO PRINT-REC
           MOVE TOT-DOLS TO T2-DOLS
           MOVE T2 TO PRINT-REC
           WRITE PRINT-REC AFTER ADVANCING 1.

       8-WRITE-HEADERS.
           MOVE SPACES TO  PRINT-REC.
           WRITE PRINT-REC AFTER ADVANCING NEW-PAGE.
           MOVE CUR-DATE-WA TO H0-DATE.
           MOVE H0 TO PRINT-REC.
           WRITE PRINT-REC AFTER ADVANCING 1.
           MOVE SPACES TO PRINT-REC.
           MOVE H1 TO PRINT-REC.
           WRITE PRINT-REC AFTER ADVANCING 1 LINES.
           MOVE SPACES TO PRINT-REC.
           MOVE H2 TO PRINT-REC.
           WRITE PRINT-REC AFTER ADVANCING 1 LINES.
           MOVE 4 TO LINE-CTR.

       8-WR-X.    EXIT.
