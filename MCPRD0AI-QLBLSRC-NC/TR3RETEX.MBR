       IDENTIFICATION DIVISION.
       PROGRAM-ID.     TR3RETEX.
       INSTALLATION.   THE GOODYEAR TIRE AND RUBBER COMPANY - AKRON.
      *REMARKS.
      *C************************************************************
      *C                                                           *
      *C   TR3RETEX       RETRIEVE/SEND R/3 REQUISITIONS           *
      *C                                                           *
      *C    THIS PROGRAM RETRIEVES REQUISITIONS BY REQUESTED DATE  *
      *C    OR REQUESTED REQUISITION NUMBER AND DUMPS THE REQS     *
      *C    INTO MCORPREQ FOR SUBSEQUENT PROCESSING BY JOB         *
      *C    BR3REQEX.                                              *
      *C                                                           *
      *C************************************************************
      *C
       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.
       SOURCE-COMPUTER.  AS400.
       OBJECT-COMPUTER.  AS400.
       SPECIAL-NAMES. I-O-FEEDBACK IS I-O-FEEDBACK-AREA.
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT DISPLAY-FILE
               ASSIGN TO WORKSTATION-ZR3RETEX-SI
               ORGANIZATION IS TRANSACTION
               ACCESS IS SEQUENTIAL
               FILE STATUS IS DSPLY-STATUS
               CONTROL-AREA IS WS-CONTROL.

           SELECT MCORPREQ
               ASSIGN TO DATABASE-MCFLCS5701
               ORGANIZATION IS INDEXED
               ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                   WITH DUPLICATES
               FILE STATUS IS FILE-STATUS.

           SELECT MREQ-1
               ASSIGN TO DATABASE-MCFLCS2001
               ORGANIZATION IS INDEXED
               ACCESS IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
               FILE STATUS IS FILE-STATUS.

           SELECT MREQ-2
               ASSIGN TO DATABASE-MCFLCS2002
               ORGANIZATION IS INDEXED
               ACCESS IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                   WITH DUPLICATES
               FILE STATUS IS FILE-STATUS.

       DATA DIVISION.
       FILE SECTION.
       FD  DISPLAY-FILE
           LABEL RECORDS ARE OMITTED.
       01  DISPLAY-REC                  PIC X(2000).

       FD  MCORPREQ
           LABEL RECORDS ARE STANDARD
           DATA RECORD IS MCORPREQ-REC.
       01  MCORPREQ-REC.
           COPY DDS-MCRPCS5700  OF MCFLCS5701.

       FD  MREQ-1
           LABEL RECORDS ARE STANDARD
           DATA RECORD IS MREQ-REC-1.
       01  MREQ-REC-1.
           COPY DDS-MCRPCS2000  OF MCFLCS2001.

       FD  MREQ-2
           LABEL RECORDS ARE STANDARD
           DATA RECORD IS MREQ-REC-2.
       01  MREQ-REC-2.
           COPY DDS-MCRPCS2000  OF MCFLCS2002.

       WORKING-STORAGE SECTION.
       77  SAVE-SEQ                     PIC 9(5).

       COPY CPYIND     IN COPYLIB.

       COPY DATAB      IN COPYLIB.

       01  DE-FIELDS-1.
           05  DE-REQ-DATE.
               10  REQ-DATE-CC          PIC XX.
               10  REQ-DATE-YY          PIC XX.
               10  REQ-DATE-MM          PIC XX.
               10  REQ-DATE-DD          PIC XX.
           05  DE-REQ-NUMBER            PIC X(12).
           05  DE-COMMAND-LINE-1        PIC X(79).
           05  DE-ERRLINE-1             PIC X(79).

       01  DSPLY-STATUS                 PIC XX.

       01  FIELD-NUMBER                 PIC S9(4) COMP VALUE 1.

       01  FILE-STATUS.
           05  FILE-STATUS-1            PIC X     VALUE "0".
           05  FILE-STATUS-2            PIC X     VALUE "0".

       01  MESSAGE-BUFLEN               PIC S9(4) COMP VALUE 78.
       01  MSG-ACTUALEN                 PIC S9(4) COMP VALUE 78.

       01  MESSAGE-BUFFER.
           05  MSG-TEXT                 PIC X(66)  VALUE SPACES.
           05  MSG-FLD                  PIC X(12)  VALUE SPACES.

       01  MESSAGE-BUFFER-1.
           05  MSG-TEXT-1               PIC X(66)  VALUE SPACES.
           05  MSG-FLD-1                PIC X(12)  VALUE SPACES.

       01  REQ-ARG                      PIC X(12)  VALUE SPACES.

      *************************************************************
      *************************************************************
      **                                                         **
      **                 DATABASE AREAS                          **
      **                                                         **
      *************************************************************
      *************************************************************

       COPY MCORPREQ IN COPYLIB.

       COPY MREQ     IN COPYLIB.

      *************************************************************
      *************************************************************
      **                                                         **
      **                 COMMUNICATIONS AREAS                    **
      **                                                         **
      *************************************************************
      *************************************************************
       COPY CATREAD    IN COPYLIB.

       COPY IOFEEDBACK IN COPYLIB.

       COPY TBLOWUP    IN COPYLIB.

       COPY WSCONTROL  IN COPYLIB.

       COPY VCOMAREA   IN COPYLIB.

       COPY LANGSUB    IN COPYLIB.

      *************************************************************
      **#########################################################**
      *************************************************************
      **                                                         **
      **          P R O C E D U R E    D I V I S I O N           **
      **                                                         **
      *************************************************************
      **#########################################################**
      *************************************************************

       PROCEDURE DIVISION.
       0-BEGIN-HERE.
           PERFORM 1-HSK.
           PERFORM 6-MAIN THRU 6-MAIN-X.

       2-EOJ.
           CLOSE DISPLAY-FILE.
           CLOSE MCORPREQ.
           CLOSE MREQ-1.
           CLOSE MREQ-2.
           GOBACK.

       1-HSK.
           MOVE "TR3RETEX"              TO BU-PGM-NAME.
           OPEN I-O DISPLAY-FILE.
           OPEN I-O   MCORPREQ.
           OPEN INPUT MREQ-1.
           OPEN INPUT MREQ-2.

      ******************************************************
      **                 BLOWUP ROUTINE                   **
      ******************************************************

       2-BLOWUP.
           CALL "TBLOWUP" USING BASE, BU-PGM-NAME, STATUS-AREA,
                 VIEW-COMAREA, DUMMY-KSAM-STAT, BU-DISPLAY-MSG,
                 BU-DISPLAY-AREA.


      **************************************************
      *                                                *
      *                  6 - M A I N                   *
      *                                                *
      **************************************************
       6-MAIN.
           MOVE "FR3RETEX"                 TO VIEW-CFNAME.
      *** INPUT DATA ABOVE AND THEN PRESS ENTER
           MOVE 9                          TO LANG-SETNUM.
           MOVE 20                         TO LANG-MSGNUM.
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
           MOVE MESSAGE-BUFFER             TO DE-COMMAND-LINE-1.
           MOVE DE-FIELDS-1                TO DISPLAY-REC.
           PERFORM 99-SCREEN-WRITE.
       6-MAIN-LOOP.
           PERFORM 98-SCREEN-READ.
           IF VIEW-LASTKEY = 3 GO TO 2-EOJ.
           MOVE DISPLAY-REC                TO DE-FIELDS-1.
           IF DE-REQ-DATE = SPACES
               IF DE-REQ-NUMBER = SPACES
                   MOVE 19027 TO CATREAD-MSG-NUMBER
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE MESSAGE-BUFFER TO DE-ERRLINE-1
                   MOVE B"1" TO INDS (1) INDS (99)
                   GO TO 6-MAIN-LOOP.
           IF DE-REQ-DATE = SPACES
               MOVE DE-REQ-NUMBER TO REQ-ARG
               PERFORM 60-RETRIEVE-BY-REQ THRU 60-RBR-X
           ELSE
           PERFORM 61-RETRIEVE-BY-DATE THRU 61-RBD-X.
       6-MAIN-X.    EXIT.

       60-RETRIEVE-BY-REQ.
           MOVE DE-REQ-NUMBER TO REQNO OF MREQ-REC-1.
           READ MREQ-1 INTO BUF-MREQ
               INVALID KEY    MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE "REQ REQUESTED DOES NOT EXIST"
                   TO DE-ERRLINE-1
           ELSE
           MOVE SPACES      TO BUF-MCORPREQ
           MOVE MREQ-NUMBER TO MCORPREQ-REQ-NUMBER
           MOVE "R3"        TO MCORPREQ-REQ-STATUS
           WRITE MCORPREQ-REC FROM BUF-MCORPREQ.

       60-RBR-X.    EXIT.

       61-RETRIEVE-BY-DATE.
           MOVE DE-REQ-DATE TO REQDTE OF MREQ-REC-2.
           START MREQ-2 KEY = REQDTE OF MREQ-REC-2
               INVALID KEY    MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE "NO REQS MEET THE DATE ENTERED"
                  TO DE-ERRLINE-1
               GO TO 61-RBD-X.
       61-RBD-LOOP.
           READ MREQ-2 NEXT INTO BUF-MREQ
               AT END    MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00" GO TO 61-RBD-X.
           IF REQ-DATE-CN NOT = DE-REQ-DATE GO TO 61-RBD-X.
           MOVE SPACES      TO BUF-MCORPREQ.
           MOVE MREQ-NUMBER TO MCORPREQ-REQ-NUMBER.
           MOVE "R3"        TO MCORPREQ-REQ-STATUS.
           WRITE MCORPREQ-REC FROM BUF-MCORPREQ.
           GO TO 61-RBD-LOOP.
       61-RBD-X.    EXIT.

       999-CATREAD.
           MOVE SPACES                     TO MESSAGE-BUFFER.
           CALL "CCATREAD" USING CATREAD-PARMS.
           MOVE CATREAD-MSG-TEXT           TO MESSAGE-BUFFER.
       999-CATREAD-EXIT.    EXIT.

       98-SCREEN-READ.
           READ DISPLAY-FILE FORMAT IS VIEW-CFNAME
               INDIC IS INDICS.
           ACCEPT IOFEEDBACK FROM I-O-FEEDBACK-AREA.
           MOVE ALL B"0" TO INDICS.
           IF DSPLY-STATUS NOT = "00"
               MOVE 3 TO VIEW-LASTKEY
           ELSE
           MOVE FUNCTION-NUM TO VIEW-LASTKEY.

       99-SCREEN-WRITE.
           WRITE DISPLAY-REC FORMAT IS VIEW-CFNAME
               INDIC IS INDICS.
           MOVE ALL B"0" TO INDICS.

