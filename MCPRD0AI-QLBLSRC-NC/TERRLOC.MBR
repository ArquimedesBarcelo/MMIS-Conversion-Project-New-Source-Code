       IDENTIFICATION DIVISION.
       PROGRAM-ID.     TERRLOC.
       AUTHOR.         C HILLES.
       INSTALLATION.   GOODYEAR TIRE & RUBBER COMPANY.
       DATE-WRITTEN.   MARCH, 1983.
      *REMARKS.        THIS PROGRAM CHECKS ONHAND WITH LOCATION ONHANDS.
      *C***********************************************************
      *C   05/03/94                                               *
      *C      REMOVED ALL REFERENCES TO PORTABILITY COPYLIB       *
      *C      MEMBERS.                              W.L.M.        *
      *C                                                          *
      *C   09/16/1996   CA YODER                                  *
      *C      RE-COMPILED PROGRAM FOR CENTURY DATABASE CHANGES.   *
      *C                                                          *
      *C***********************************************************

       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.
       SOURCE-COMPUTER.    HP-3000.
       OBJECT-COMPUTER.    HP-3000.
       COPY SPECIALN IN COPYLIB.
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT MSTORERM-CD-O
               ASSIGN TO DATABASE-MCFLCS0201
               ORGANIZATION IS INDEXED
                 ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
               FILE STATUS IS FILE-STATUS.

           SELECT PRINT-FILE ASSIGN TO PRINTER-MCPRT.

       DATA DIVISION.
       FILE SECTION.
       FD  MSTORERM-CD-O
           LABEL RECORDS ARE STANDARD.
       01  MSTORERM-CD-REC-O.
           COPY DDS-MCRPCS0200  OF MCFLCS0201.

       FD  PRINT-FILE
           RECORD CONTAINS 132 CHARACTERS.
       01  PRINT-REC                     PIC X(132).
       WORKING-STORAGE SECTION.
       77  LINE-K                        PIC 99    VALUE 60 COMP.
       77  LOC-TOTAL                     PIC 9(10)  VALUE 0.
       77  BAD-CODE-COUNT                PIC 9(5)  VALUE 0.
       77  BAD-FLAG                      PIC X(1)  VALUE "N".
       77  SUB                           PIC 9(1).
       77  HANDLE-BLOWUP-FLAG            PIC X(1)  VALUE "Y".
       77  DISP-ONHAND                   PIC Z(7)9.

       01  WORK-LINE                     PIC X(132).

       COPY TBLOWUP IN COPYLIB.

      **************************************************************
      **                                                          **
      **            D A T A B A S E   W O R K                     **
      **                                                          **
      **************************************************************
       COPY FILESTAT IN COPYLIB.
       01  BASE                          PIC X(9)  VALUE "  STORES;".
       01  PASSWORD                      PIC X(8)  VALUE "JADE;   ".
       COPY DBSTAT IN COPYLIB.

       01  DB-DATASETS.
           05  DSET-MSTORERM             PIC X(16)  VALUE "MSTORERM;".
           05  DSET-NAME                 PIC X(16).

       01  MODE-AREA.
           05  MODE1                     PIC S9(4) COMP VALUE 1.
           05  MODE2                     PIC S9(4) COMP VALUE 2.
           05  MODE7                     PIC S9(4) COMP VALUE 7.

       01  ITEM-LISTS.
           05  ALL-ITEM-LIST             PIC XX    VALUE "@;".
           05  CODE-SEARCH               PIC X(10) VALUE "CORP-CODE;".

       01  DUMMY-ARG                     PIC X     VALUE SPACES.
       01  PLT-ARG                       PIC X(4)  VALUE "P 01".

      **************************************************************
      **                                                          **
      **           D A T A B A S E   B U F F E R S                **
      **                                                          **
      **************************************************************

       COPY MSTORERM IN COPYLIB.

       LINKAGE SECTION.
       01  UPDATE-FLAG                   PIC X(1).
       PROCEDURE DIVISION USING UPDATE-FLAG.
       BEGIN-SORT SECTION.
       1-HOUSEKEEPING.

           OPEN OUTPUT PRINT-FILE.
           PERFORM 9999-OPEN-STUFF.
           MOVE "MSTORERM;"              TO  DSET-NAME.
           MOVE "CORP CODES WITH BAD BIN QUANTITIES" TO PRINT-REC.
           WRITE PRINT-REC AFTER ADVANCING 1.
           PERFORM 6000-MAIN THRU 6990-MAIN-X.
           MOVE SPACES                   TO  WORK-LINE.
           STRING BAD-CODE-COUNT, " BAD CODES FOUND"
             DELIMITED BY SIZE INTO WORK-LINE.
           WRITE PRINT-REC FROM WORK-LINE AFTER ADVANCING 1.
           CLOSE PRINT-FILE.
           PERFORM 9999-CLOSE-STUFF.
           GOBACK.

       2100-BLOWUP.
           MOVE "TERRLOC"                TO  BU-PGM-NAME.
           MOVE CORP-CODE                TO  BU-DISPLAY-FLD (1).
           CALL "TBLOWUP" USING BASE BU-PGM-NAME STATUS-AREA
             DUMMY-VIEW-AREA FILE-STATUS BU-DISPLAY-MSG
             BU-DISPLAY-FLDS.

       6000-MAIN.
           PERFORM 9999-BEGFIL-MSTORERM-CD-O.
       6-READ-LOOP.
           IF UPDATE-FLAG = "U"
               PERFORM 9999-DSET-LOCK.

           PERFORM 9999-GETSER-MSTORERM-CD-O.
           IF END-OF-FILE
               GO TO 6990-MAIN-X.

           MOVE "N"                      TO  BAD-FLAG.

           MOVE ZERO                     TO  SUB.
           PERFORM 6 TIMES
               ADD 1                     TO  SUB
               IF STR-LOC (SUB) = SPACES AND STR-LOC-ONHAND (SUB) > 0
                   MOVE SPACES           TO  WORK-LINE
                   MOVE STR-LOC-ONHAND (SUB) TO DISP-ONHAND
                   STRING "LOCATION ", SUB, " FOR CODE ",
                   CORP-CODE, " IS SPACES BUT ONHAND IS ",
                   DISP-ONHAND DELIMITED BY SIZE
                     INTO WORK-LINE
                   WRITE PRINT-REC FROM WORK-LINE AFTER ADVANCING 1
                   MOVE "Y"              TO  BAD-FLAG
                   MOVE "XXX"            TO  STR-LOC (SUB)
               END-IF
           END-PERFORM.

           MOVE ZERO                     TO  LOC-TOTAL.
           MOVE ZERO                     TO  SUB.
           PERFORM 6 TIMES
               ADD 1                     TO  SUB
               ADD STR-LOC-ONHAND (SUB)  TO  LOC-TOTAL
           END-PERFORM.

           IF STR-ONHAND NOT = LOC-TOTAL
               MOVE "Y"                  TO  BAD-FLAG.

           IF BAD-FLAG = "N"
               PERFORM 9999-UNLOCK
               GO TO 6-READ-LOOP.

           MOVE SPACES                   TO  WORK-LINE.
           MOVE STR-ONHAND               TO  DISP-ONHAND.
           STRING "CODE ", CORP-CODE, " LOC-ONHAND = ",
             LOC-TOTAL, " STR-ONHAND = ", DISP-ONHAND
               DELIMITED BY SIZE INTO WORK-LINE.
           WRITE PRINT-REC FROM WORK-LINE AFTER ADVANCING 1.
           ADD 1                         TO  BAD-CODE-COUNT.

           IF UPDATE-FLAG = "U"
               NEXT SENTENCE
           ELSE
               GO TO 6-READ-LOOP.

           MOVE LOC-TOTAL                TO  STR-ONHAND.
           PERFORM 9999-UPDATE-MSTORERM-CD-O.

           PERFORM 9999-UNLOCK.

           GO TO 6-READ-LOOP.

       6990-MAIN-X.
           EXIT.

       9999-OPEN-STUFF.
           OPEN I-O   MSTORERM-CD-O.

       9999-CLOSE-STUFF.
           CLOSE      MSTORERM-CD-O.

       COPY DLOCKCAL IN COPYLIB.
       COPY UNLOCK   IN COPYLIB.
       9999-GETSER-MSTORERM-CD-O.
           MOVE 0 TO COND-WORD.
           READ MSTORERM-CD-O NEXT INTO BUF-MSTORERM
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS-1 = "1"
               MOVE 11 TO COND-WORD
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD
               IF HANDLE-BLOWUP-FLAG = "Y"
                   MOVE "GETSER ERR 9999-GETSER-MSTORERM-CD-O"
                       TO BU-MSG-AREA
                   PERFORM 2100-BLOWUP.

       9999-BEGFIL-MSTORERM-CD-O.
           MOVE SPACES TO CORPCDE OF MSTORERM-CD-REC-O.
           START MSTORERM-CD-O KEY >= CORPCDE OF MSTORERM-CD-REC-O
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.

       9999-UPDATE-MSTORERM-CD-O.
           MOVE 0 TO COND-WORD.
           REWRITE MSTORERM-CD-REC-O FROM BUF-MSTORERM
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD
               IF HANDLE-BLOWUP-FLAG = "Y"
                   MOVE "UPDATE ERR 9999-UPDATE-MSTORERM-CD-O"
                       TO BU-MSG-AREA
                   PERFORM 2100-BLOWUP.

