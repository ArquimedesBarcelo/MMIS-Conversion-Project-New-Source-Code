       IDENTIFICATION DIVISION.
       PROGRAM-ID.             TCCURRWO.
       AUTHOR.                 W. ROXBURY.
       INSTALLATION.           GOODYEAR TIRE & RUBBER CO.
      *REMARKS.       ALLOWS CRAFTSMEN TO FIND ANOTHER CRAFTSMAN
      *               WHO IS UNASSIGNED AND AVAILABLE FOR HELP ON
      *               A WORKORDER.
       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.
       SOURCE-COMPUTER.        AS-400.
       OBJECT-COMPUTER.        AS-400.
       SPECIAL-NAMES.          I-O-FEEDBACK     IS I-O-FEEDBACK-AREA
                               REQUESTOR        IS WORK-STATION
                               SYSTEM-CONSOLE   IS CONSOLE
                               LOCAL-DATA       IS LOCAL-DATA-AREA.

       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT LABOR-CURRENT-STAT
                  ASSIGN       TO DATABASE-MCFLMM1601
                  ORGANIZATION IS INDEXED
                  ACCESS MODE  IS DYNAMIC
                  RECORD KEY   IS EXTERNALLY-DESCRIBED-KEY
                               WITH DUPLICATES
                  FILE STATUS  IS FILE-STAT.

           SELECT PER-PERSONNEL
                  ASSIGN       TO DATABASE-MCFLMM0301
                  ORGANIZATION IS INDEXED
                  ACCESS MODE  IS DYNAMIC
                  RECORD KEY   IS EXTERNALLY-DESCRIBED-KEY
                  FILE STATUS  IS FILE-STAT.

           SELECT PER-MASTER
                  ASSIGN       TO DATABASE-MCFPMM0300
                  ORGANIZATION IS SEQUENTIAL
                  ACCESS MODE  IS SEQUENTIAL
                  FILE STATUS  IS FILE-STAT.

           SELECT WO-BASIC
                  ASSIGN       TO DATABASE-MCFLMM1001
                  ORGANIZATION IS INDEXED
                  ACCESS MODE  IS DYNAMIC
                  RECORD KEY   IS EXTERNALLY-DESCRIBED-KEY
                               WITH DUPLICATES
                  FILE STATUS  IS FILE-STAT.

           SELECT WO-PLANNED
                  ASSIGN       TO DATABASE-MCFLMM1101
                  ORGANIZATION IS INDEXED
                  ACCESS MODE  IS DYNAMIC
                  RECORD KEY   IS EXTERNALLY-DESCRIBED-KEY
                               WITH DUPLICATES
                  FILE STATUS  IS FILE-STAT.

           SELECT DISPLAY-FILE
                  ASSIGN       TO WORKSTATION-ZCORLESS-SI
                  ORGANIZATION IS TRANSACTION
                  ACCESS MODE  IS SEQUENTIAL
                  FILE STATUS  IS SCREEN-STATUS
                               MAJOR-MINOR
                  CONTROL-AREA IS SCREEN-CONTROL.

       DATA DIVISION.
       FILE SECTION.
       FD  LABOR-CURRENT-STAT
           LABEL RECORDS ARE STANDARD.
       01  LS-REC.
           COPY DDS-ALL-FORMATS OF MCFLMM1601.

       FD  PER-PERSONNEL
           LABEL RECORDS ARE STANDARD.
       01  PP-REC.
           COPY DDS-ALL-FORMATS OF MCFLMM0301.

       FD  PER-MASTER
           LABEL RECORDS ARE STANDARD.
       01  PM-REC.
           COPY DDS-ALL-FORMATS OF MCFPMM0300.

       FD  WO-BASIC
           LABEL RECORDS ARE STANDARD.
       01  VWO-REC.
           COPY DDS-ALL-FORMATS OF MCFLMM1001.

       FD  WO-PLANNED
           LABEL RECORDS ARE STANDARD.
       01  PWO-REC.
           COPY DDS-ALL-FORMATS OF MCFLMM1101.

       FD  DISPLAY-FILE
           LABEL RECORDS ARE OMITTED.
       01  DISPLAY-REC         PIC X(2000).

       WORKING-STORAGE SECTION.
       77  EOF-SW              PIC 9     VALUE 0.
       77  CC-SW               PIC S9(4) BINARY VALUE 0.
       77  TRUE-VAL            PIC 1     VALUE B"1".

       01  FILE-STAT.
           05 FILE-STAT-1      PIC X     VALUE "0".
           05 FILE-STAT-2      PIC X     VALUE "0".

       01  PASSWORD-INFORMATION.
           05  NAME-OF-PROGRAM PIC X(08) VALUE "TCCURRWO".
           05  PROGRAM-TYPE    PIC X(02) VALUE "IN".
           05  PROGRAM-RELEASE PIC X(12) VALUE " J0100010001".
           05  PROGRAM-DESCRIPTION.
               10  PROG-DESC1  PIC X(30) VALUE
                   "ALLOWS A CRAFTSMAN TO DETERMIN".
               10  PROG-DESC2  PIC X(30) VALUE
                   "E IF ANY OTHER CRAFTSMAN IS   ".
               10  PROG-DESC3  PIC X(30) VALUE
                   "CURRENTLY ASSIGNED TO A JOB OR".
               10  PROG-DESC4  PIC X(30) VALUE
                   " IS FREE FOR HELP ON A JOB.   ".
               10  PROG-FUNC1  PIC X(30) VALUE
                   "RUNS FROM f4 KEY OF THE CRAFTS".
               10  PROG-FUNC2  PIC X(30) VALUE
                   "MAN'S FUNCTIONS SECONDARY MENU".
           05  PASSWORD-FLAG   PIC X.

       01  SCREEN-DATA.
           05  S-CC-BUF              PIC X(04).
           05  S-CC-DISP             PIC X(04).
           05  S-NAME-BUF            PIC X(16).
           05  S-WO-DATA.
               10  S-WO-FILE-SW      PIC X(01).
               10  S-WO-NUM-BUF      PIC X(10).
               10  S-EQUIP-BUF       PIC X(06).
               10  S-LOC-BUF         PIC X(08).
               10  S-DESC-BUF        PIC X(30).
               10  S-DESC-A-BUF      PIC X(66).
               10  S-DESC-B-BUF      PIC X(66).
           05  CMDMSG                PIC X(79).
           05  ERRMSG                PIC X(79).

       01  DB-ERROR.
           05  DB-FUNC   PIC X(10) VALUE SPACES.
           05  DB-FILE   PIC X(18) VALUE SPACES.
           05  FILLER    PIC X(20) VALUE "ERROR - FILE-STAT = ".
           05  CON-WORD  PIC XX.

           COPY SCREENIO       IN COPYLIB.

           COPY CATREAD        IN COPYLIB.

           COPY JCWAREA        IN COPYLIB.

       01  WO-BASIC-DATA.
           COPY DWOBASIC       IN COPYLIB.

       01  WO-PLANNED-DATA.
           COPY DWOPLAN        IN COPYLIB.

       01  WO-PERS-DATA.
           COPY MPERSONL       IN COPYLIB.

       01  LABOR-CURR-DATA.
           COPY DCURRLBR       IN COPYLIB.

       01  MESSAGE-BUFFER-DATA.
           COPY ERRORLIN       IN COPYLIB.

       LINKAGE SECTION.
       01  DBPARAMETERS.
           COPY DBPARMS        IN COPYLIB.

       PROCEDURE DIVISION USING DBPARAMETERS.
       CHECK-PASSWORD SECTION 01.
       CHECK-PASS.
           CALL "TPWORD" USING PASSWORD-INFORMATION.
           IF PASSWORD-FLAG NOT = "N"
               GO TO OPEN-FILES.
           GOBACK.

       OPEN-FILES.
           OPEN INPUT          LABOR-CURRENT-STAT.
           OPEN INPUT          PER-PERSONNEL.
           OPEN INPUT          WO-BASIC.
           OPEN INPUT          WO-PLANNED.
           OPEN I-O            DISPLAY-FILE.
           ACCEPT MC-LOCAL-DATA-AREA FROM LOCAL-DATA-AREA.

       BEGIN.
           GO TO 6-MAIN.

       END-OF-JOB.
           CLOSE               LABOR-CURRENT-STAT.
           CLOSE               PER-PERSONNEL.
           CLOSE               WO-BASIC.
           CLOSE               WO-PLANNED.
           CLOSE               DISPLAY-FILE.
           GOBACK.

       6-MAIN.
           MOVE "VCURRWO"      TO SCREEN-NAME.
           MOVE SPACES         TO SCREEN-DATA MESSAGE-BUFFER.

       63-SHOWFORM.
           MOVE "00"           TO SCREEN-STATUS.
           MOVE SCREEN-DATA    TO DISPLAY-REC.

           WRITE DISPLAY-REC   FORMAT IS SCREEN-NAME
                               INDIC ARE SCREEN-INDICATORS.
           IF SCREEN-STATUS NOT = "00"
               DISPLAY "SCREEN WRITE ERROR.  SCREEN-STATUS IS "
                               SCREEN-STATUS
               GO TO END-OF-JOB.

           READ  DISPLAY-FILE  FORMAT IS SCREEN-NAME
                               INDIC ARE SCREEN-INDICATORS
           IF SCREEN-STATUS NOT = "00"
               DISPLAY "SCREEN READ ERROR.  SCREEN-STATUS IS "
                               SCREEN-STATUS
               GO TO END-OF-JOB.

           MOVE DISPLAY-REC    TO SCREEN-DATA.
           MOVE ALL B"0"       TO SCREEN-INDICATORS.

           IF KEY-HIT = 1 OR 3
               GO TO END-OF-JOB.

           IF CC-SW = 0
               IF KEY-HIT NOT = 0
                   GO TO 63-SHOWFORM
               ELSE
                   NEXT SENTENCE
           ELSE
               IF KEY-HIT NOT = 0
                   GO TO 63-SHOWFORM.

           IF S-CC-BUF = "NEWS" OR "9999"
      ************************************************************
      ****  MESSAGE:  INVALID CRAFTSMAN NUMBER
      ************************************************************
               MOVE  35        TO CATREAD-MSG-SET
               MOVE  49        TO CATREAD-MSG-NUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER TO ERRMSG
               MOVE TRUE-VAL   TO IND(99)
               GO TO 63-SHOWFORM.

           MOVE SPACES         TO S-NAME-BUF.
           MOVE S-CC-BUF       TO PERCCNUM OF PER-PERSONNEL.
           READ PER-PERSONNEL  INTO WO-PERS-DATA
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
             IF FILE-STAT-1 = "2"
      ************************************************************
      ****  MESSAGE:  INVALID CRAFTSMAN NUMBER
      ************************************************************
               MOVE  35        TO CATREAD-MSG-SET
               MOVE  49        TO CATREAD-MSG-NUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER TO ERRMSG
               MOVE TRUE-VAL   TO IND(99)
               GO TO 63-SHOWFORM
             ELSE
               MOVE FILE-STAT  TO CON-WORD
               MOVE "READ    " TO DB-FUNC
               MOVE "PER-PERSONNEL" TO DB-FILE
               MOVE DB-ERROR   TO MESSAGE-BUFFER
               MOVE MESSAGE-BUFFER TO ERRMSG
               MOVE TRUE-VAL   TO IND(99)
               GO TO 63-SHOWFORM.

           MOVE 1              TO CC-SW.
           MOVE S-CC-BUF       TO S-CC-DISP.
           MOVE SPACES         TO S-CC-BUF.
           MOVE PER-EMP-NAME   TO S-NAME-BUF.
           PERFORM 63-GET-S-WO-DATA THRU 63-GWD-EXIT.
           GO TO 63-SHOWFORM.

       63-GET-S-WO-DATA.
           MOVE SPACES         TO S-WO-DATA.
           MOVE S-CC-DISP      TO PERCCNUM OF LABOR-CURRENT-STAT.
           START LABOR-CURRENT-STAT
                               KEY = PERCCNUM OF LABOR-CURRENT-STAT
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
      ************************************************************
      ****  MESSAGE:
      ****  CRAFTSMAN NOT CURRENTLY ASSIGNED TO A WORKORDER
      ************************************************************
               MOVE  29        TO CATREAD-MSG-SET
               MOVE  64        TO CATREAD-MSG-NUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER TO S-DESC-A-BUF
               GO TO 63-GWD-EXIT.

           READ LABOR-CURRENT-STAT NEXT INTO LABOR-CURR-STAT
               AT END          MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
               IF FILE-STAT = "10" OR "14" OR "46"
      ************************************************************
      ****  MESSAGE:
      ****  CRAFTSMAN NOT CURRENTLY ASSIGNED TO A WORKORDER
      ************************************************************
                   MOVE  29        TO CATREAD-MSG-SET
                   MOVE  64        TO CATREAD-MSG-NUM
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE MESSAGE-BUFFER TO S-DESC-A-BUF
                   GO TO 63-GWD-EXIT
               ELSE
                   MOVE FILE-STAT  TO CON-WORD
                   MOVE "READ    " TO DB-FUNC
                   MOVE "LABOR-CURRENT-STAT" TO DB-FILE
                   MOVE DB-ERROR   TO MESSAGE-BUFFER
                   GO TO 63-SHOWFORM.

           IF S-CC-DISP NOT = LCS-EMPL-NUM
      ************************************************************
      ****  MESSAGE:
      ****  CRAFTSMAN NOT CURRENTLY ASSIGNED TO A WORKORDER
      ************************************************************
               MOVE  29        TO CATREAD-MSG-SET
               MOVE  64        TO CATREAD-MSG-NUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER TO S-DESC-A-BUF
               GO TO 63-GWD-EXIT.

           MOVE LCS-WO-NUM     TO WONUM OF WO-BASIC
                                  WONUM OF WO-PLANNED.
           START WO-BASIC   KEY = WONUM OF WO-BASIC
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT = "00"
               IF LCS-WO-NUM = WONUM OF WO-BASIC
                   GO TO READ-BASIC.

           START WO-PLANNED KEY = WONUM OF WO-PLANNED
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT = "00"
               IF LCS-WO-NUM = WONUM OF WO-PLANNED
                   GO TO READ-PLANNED.

      ************************************************************
      ****  MESSAGE:
      ****  CRAFTSMAN NOT CURRENTLY ASSIGNED TO A WORKORDER
      ************************************************************
           MOVE  29            TO CATREAD-MSG-SET.
           MOVE  64            TO CATREAD-MSG-NUM.
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
           MOVE MESSAGE-BUFFER TO S-DESC-A-BUF.
           GO TO 63-GWD-EXIT.

       READ-BASIC.
           READ WO-BASIC       INTO WO-BASIC-DATA
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = ZEROS
               MOVE FILE-STAT  TO CON-WORD
               MOVE "READ    " TO DB-FUNC
               MOVE "WO-BASIC" TO DB-FILE
               MOVE DB-ERROR   TO MESSAGE-BUFFER
               MOVE MESSAGE-BUFFER TO ERRMSG
               MOVE TRUE-VAL   TO IND(99)
               GO TO 63-GWD-EXIT.

           GO TO CONT-PROC.

       READ-PLANNED.
           READ WO-PLANNED     INTO WO-PLANNED-DATA
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = ZEROS
               MOVE FILE-STAT  TO CON-WORD
               MOVE "READ    " TO DB-FUNC
               MOVE "WO-PLANNED" TO DB-FILE
               MOVE DB-ERROR   TO MESSAGE-BUFFER
               MOVE MESSAGE-BUFFER TO ERRMSG
               MOVE TRUE-VAL   TO IND(99)
               GO TO 63-GWD-EXIT.

           MOVE SPACES             TO WO-BASIC-DATA.
           MOVE "*"                TO S-WO-FILE-SW.
           MOVE WO-NUM-PLANNED     TO WO-NUM.
           MOVE EQUIP-NUM-P        TO EQUIP-NUM.
           MOVE LOCATION-P         TO LOCATION.
           MOVE DESCRIPTION-1-P    TO DESCRIPTION-1.
           MOVE DESCRIPTION-2-1-P  TO DESCRIPTION-2-1.
           MOVE DESCRIPTION-2-2-P  TO DESCRIPTION-2-2.

       CONT-PROC.
           MOVE WO-NUM             TO S-WO-NUM-BUF.
           MOVE EQUIP-NUM          TO S-EQUIP-BUF.
           MOVE LOCATION           TO S-LOC-BUF.
           MOVE DESCRIPTION-1      TO S-DESC-BUF.
           MOVE DESCRIPTION-2-1    TO S-DESC-A-BUF.
           MOVE DESCRIPTION-2-2    TO S-DESC-B-BUF.

       63-GWD-EXIT.    EXIT.

       999-CATREAD.
           MOVE SPACES         TO MESSAGE-BUFFER.
           CALL "CCATREAD" USING CATREAD-PARMS.
           MOVE CATREAD-MSG-TEXT TO MESSAGE-BUFFER.

       999-CATREAD-EXIT.    EXIT.

