       IDENTIFICATION DIVISION.
       PROGRAM-ID.      TR3RQUPD.
       AUTHOR.          CA YODER.
       DATE-WRITTEN.    MAY 2002.
      *
      **************************************************************
      *                                                            *
      *  THIS PROGRAM UPDATES THE REQUISITION WITH THE PURCHASE    *
      *  ORDER NUMBER THAT HAS BEEN CREATED IN SAP FROM THE        *
      *  CSIS/MMIS REQ.  THE UPDATES ARE SENT TO MCFPCS7100        *
      *  (DSAPREQ) BY VITRIA.                                      *
      *                                                            *
      **************************************************************
      *  CHANGES:                                                  *
      *C

       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.

           SELECT DPODATAITM-PO-O
               ASSIGN         TO DATABASE-MCFLCS1101
               ORGANIZATION   IS INDEXED
               ACCESS MODE    IS DYNAMIC
               RECORD KEY     IS EXTERNALLY-DESCRIBED-KEY
                 WITH DUPLICATES
               FILE STATUS    IS FILE-STATUS.

           SELECT DPOITEM-PO-O
               ASSIGN         TO DATABASE-MCFLCS1002
               ORGANIZATION   IS INDEXED
               ACCESS MODE    IS DYNAMIC
               RECORD KEY     IS EXTERNALLY-DESCRIBED-KEY
                 WITH DUPLICATES
               FILE STATUS    IS FILE-STATUS.

           SELECT DPORECD-PO-O
               ASSIGN         TO DATABASE-MCFLCS0901
               ORGANIZATION   IS INDEXED
               ACCESS MODE    IS DYNAMIC
               RECORD KEY     IS EXTERNALLY-DESCRIBED-KEY
                 WITH DUPLICATES
               FILE STATUS    IS FILE-STATUS.

           SELECT DVENDOR-VN-O
               ASSIGN         TO DATABASE-MCFLCS0701
               ORGANIZATION   IS INDEXED
               ACCESS MODE    IS DYNAMIC
               RECORD KEY     IS EXTERNALLY-DESCRIBED-KEY
                 WITH DUPLICATES
               FILE STATUS    IS FILE-STATUS.

           SELECT DSAPREQ-IO
               ASSIGN         TO DATABASE-MCFLCS7101
               ORGANIZATION   IS INDEXED
               ACCESS MODE    IS DYNAMIC
               RECORD KEY     IS EXTERNALLY-DESCRIBED-KEY
                 WITH DUPLICATES
               FILE STATUS    IS FILE-STATUS.

           SELECT KVENDOR-VN-O
               ASSIGN         TO DATABASE-MCFLCSVEN2
               ORGANIZATION   IS INDEXED
               ACCESS MODE    IS DYNAMIC
               RECORD KEY     IS EXTERNALLY-DESCRIBED-KEY
                 WITH DUPLICATES
               FILE STATUS    IS FILE-STATUS.

           SELECT MPLTINFO-PK-I
               ASSIGN         TO DATABASE-MCFLCS0501
               ORGANIZATION   IS INDEXED
               ACCESS MODE    IS DYNAMIC
               RECORD KEY     IS EXTERNALLY-DESCRIBED-KEY
               FILE STATUS    IS FILE-STATUS.

           SELECT MPORCV-PO-I
               ASSIGN         TO DATABASE-MCFLCS0101
               ORGANIZATION   IS INDEXED
               ACCESS MODE    IS DYNAMIC
               RECORD KEY     IS EXTERNALLY-DESCRIBED-KEY
               FILE STATUS    IS FILE-STATUS.

           SELECT MPORCV-PO-O
               ASSIGN         TO DATABASE-MCFLCS0101
               ORGANIZATION   IS INDEXED
               ACCESS MODE    IS DYNAMIC
               RECORD KEY     IS EXTERNALLY-DESCRIBED-KEY
               FILE STATUS    IS FILE-STATUS.

           SELECT MREQ-RQ-O
               ASSIGN         TO DATABASE-MCFLCS2001
               ORGANIZATION   IS INDEXED
               ACCESS MODE    IS DYNAMIC
               RECORD KEY     IS EXTERNALLY-DESCRIBED-KEY
               FILE STATUS    IS FILE-STATUS.

           SELECT DREQITM-RQ-O
               ASSIGN         TO DATABASE-MCFLCS2201
               ORGANIZATION   IS INDEXED
               ACCESS MODE    IS DYNAMIC
               RECORD KEY     IS EXTERNALLY-DESCRIBED-KEY
                 WITH DUPLICATES
               FILE STATUS    IS FILE-STATUS.

           SELECT MSTORERM-CD-I
               ASSIGN         TO DATABASE-MCFLCS0201
               ORGANIZATION   IS INDEXED
               ACCESS MODE    IS DYNAMIC
               RECORD KEY     IS EXTERNALLY-DESCRIBED-KEY
               FILE STATUS    IS FILE-STATUS.

           SELECT MVALIDUM-UM-I
               ASSIGN         TO DATABASE-MCFLCS0401
               ORGANIZATION   IS INDEXED
               ACCESS MODE    IS DYNAMIC
               RECORD KEY     IS EXTERNALLY-DESCRIBED-KEY
               FILE STATUS    IS FILE-STATUS.

           SELECT RQ-RPT-FILE
               ASSIGN         TO DISK-R3RQUPDF
               FILE STATUS    IS FILE-STATUS.

       DATA DIVISION.
       FILE SECTION.
       FD  DPODATAITM-PO-O
           LABEL RECORDS ARE STANDARD.
       01  DPODATAITM-PO-REC-O.
           COPY DDS-MCRPCS1100  OF MCFLCS1101.

       FD  DPOITEM-PO-O
           LABEL RECORDS ARE STANDARD.
       01  DPOITEM-PO-REC-O.
           COPY DDS-MCRPCS1000  OF MCFLCS1002.

       FD  DPORECD-PO-O
           LABEL RECORDS ARE STANDARD.
       01  DPORECD-PO-REC-O.
           COPY DDS-MCRPCS0900  OF MCFLCS0901.

       FD  DVENDOR-VN-O
           LABEL RECORDS ARE STANDARD.
       01  DVENDOR-VN-REC-O.
           COPY DDS-MCRPCS0700  OF MCFLCS0701.

       FD  DSAPREQ-IO
           LABEL RECORDS ARE STANDARD.
       01  DSAPREQ-REC-IO.
           COPY DDS-MCRPCS7100  OF MCFLCS7101.

       FD  KVENDOR-VN-O
           LABEL RECORDS ARE STANDARD.
       01  KVENDOR-VN-REC-O.
           COPY DDS-MCRPCSVEND  OF MCFLCSVEN2.

       FD  MPLTINFO-PK-I
           LABEL RECORDS ARE STANDARD.
       01  MPLTINFO-PK-REC-I.
           COPY DDS-MCRPCS0500  OF MCFLCS0501.

       FD  MPORCV-PO-I
           LABEL RECORDS ARE STANDARD.
       01  MPORCV-PO-REC-I.
           COPY DDS-MCRPCS0100  OF MCFLCS0101.

       FD  MPORCV-PO-O
           LABEL RECORDS ARE STANDARD.
       01  MPORCV-PO-REC-O.
           COPY DDS-MCRPCS0100  OF MCFLCS0101.

       FD  MREQ-RQ-O
           LABEL RECORDS ARE STANDARD.
       01  MREQ-RQ-REC-O.
           COPY DDS-MCRPCS2000  OF MCFLCS2001.

       FD  DREQITM-RQ-O
           LABEL RECORDS ARE STANDARD.
       01  DREQITM-RQ-REC-O.
           COPY DDS-MCRPCS2200  OF MCFLCS2201.

       FD  MSTORERM-CD-I
           LABEL RECORDS ARE STANDARD.
       01  MSTORERM-CD-REC-I.
           COPY DDS-MCRPCS0200  OF MCFLCS0201.

       FD  MVALIDUM-UM-I
           LABEL RECORDS ARE STANDARD.
       01  MVALIDUM-UM-REC-I.
           COPY DDS-MCRPCS0400  OF MCFLCS0401.

       FD  RQ-RPT-FILE
           LABEL RECORDS ARE OMITTED
           RECORD CONTAINS 133 CHARACTERS
           DATA RECORD IS RQ-RPT-REC.
       01  RQ-RPT-REC.
           05  CTL                       PIC X(1).
           05  RQ-RPT-LINE               PIC X(132).

       WORKING-STORAGE SECTION.
       77  MCXCBLERR-SCOPE               PIC X(1)  VALUE "C".
       77  SAVE-ITEM-NO                  PIC 9(4)  VALUE 0.
       77  DSAPREQ-EOF-SW                PIC X     VALUE "N".
       77  SAVE-SUB                      PIC X(3).
       77  SAVE-SUBD                     PIC X(4).
       77  SAVE-ADDTL-DATA               PIC X(8).

       01  YMD-DATE.
           05  YMD-YY                    PIC X(2).
           05  YMD-MM                    PIC X(2).
           05  YMD-DD                    PIC X(2).

       01  WORK-AREA-DATA-NAMES.
           05  OLD-ORD-QTY-SAVE          PIC S9(8)  VALUE ZEROS.
           05  ORD-QTY-SAVE              PIC S9(8)  VALUE ZEROS.
           05  SAVE-PO-NUM-REL           PIC X(10)  VALUE SPACES.
           05  SAVE-PO-NUM-REL-2         PIC X(19)  VALUE SPACES.
           05  RECORD-COUNTER            PIC 9(6)   VALUE ZEROS.
           05  SUB                       PIC S9(4)  VALUE ZEROS.

       01  SWITCH-AREA.
           05  BAD-CODE-SW               PIC X(1)  VALUE SPACES.
           05  ERR-SW                    PIC X(1)  VALUE SPACES.

       01  COMPANY-SAVE                  PIC X(3).

       01  CURRENT-DATE-CN.
           05  CUR-DATE-CC               PIC XX.
           05  CUR-DATE.
               10  CUR-DATE-YY           PIC XX.
               10  FILLER                PIC X(4).

      *------------------------------------------------------------*
      *        S U B P R O G R A M   A R E A S                     *
      *------------------------------------------------------------*

       COPY TLSHIFT2   IN COPYLIB.
       COPY TDATECHK   IN COPYLIB.
       COPY SREQLINK   IN COPYLIB.

       01  BUILD-PO-DATE-CN.
           05  BUILD-PO-DATE-CC          PIC X(2).
           05  BUILD-PO-DATE.
               10  BUILD-PO-DATE-YY      PIC X(2).
               10  BUILD-PO-DATE-MM      PIC X(2).
               10  BUILD-PO-DATE-DD      PIC X(2).

       01  WORK-AREA.
           05  BUILD-PO.
             07  PO-RLSE.
               10  PO-PREFIX             PIC X       VALUE "P".
               10  PO-NUM-REL.
                   15  PO-NUM            PIC X(7)    VALUE SPACES.
                   15  PO-REL            PIC X(3)    VALUE SPACES.
             07  PO-RECV                 PIC 9(3)    VALUE ZEROS.

           05  SAVE-EXPECT-DATE-CN.
               10  SAVE-EXPECT-CC        PIC XX   VALUE SPACES.
               10  SAVE-EXPECT-DATE.
                   15  SAVE-EXPECT-YY    PIC XX   VALUE SPACES.
                   15  SAVE-EXPECT-MM    PIC XX   VALUE SPACES.
                   15  SAVE-EXPECT-DD    PIC XX   VALUE SPACES.

       01  HDR-LINE-1.
           05  FILLER                PIC X(4).
           05  RQ-DATE               PIC X(8).
           05  FILLER                PIC X(10).
           05  FILLER                PIC X(31)    VALUE
                    "SAP PO/REQUISITION ERROR REPORT".
           05  FILLER                PIC X(10).
           05  RQ-TIME               PIC X(8).

       01  HDR-LINE-2.
           05  FILLER                PIC X(132)   VALUE ALL "-".

       01  RPT-LINE.
           05  FILLER                PIC X(4).
           05  FILLER                PIC X(5)     VALUE "REQ: ".
           05  RQ-RPT-REQ            PIC X(12).
           05  FILLER                PIC X(5)     VALUE " PO: ".
           05  RQ-RPT-PO             PIC X(10).
           05  FILLER                PIC X(8)     VALUE "   MSG: ".
           05  RQ-RPT-MSG            PIC X(103).

      *------------------------------------------------------------*
      *                 DATABASE I/O BUFFER AREA                   *
      *------------------------------------------------------------*

       COPY MSTORERM   IN COPYLIB.
       COPY MPORCV     IN COPYLIB.
       COPY DPORECD    IN COPYLIB.
       COPY DPOITEM    IN COPYLIB.
       COPY DPODATA    IN COPYLIB.
       COPY DVENDOR    IN COPYLIB.
       COPY KVENDOR    IN COPYLIB.
       COPY MVALIDUM   IN COPYLIB.
       COPY MPLT0      IN COPYLIB.
       COPY MPLTP01    IN COPYLIB.
       COPY MREQ       IN COPYLIB.
       COPY DREQITM    IN COPYLIB.
       COPY DSAPREQ    IN COPYLIB.

       COPY DATAB IN COPYLIB.
       01  FILE-STATUS.
           05  FILE-STATUS-1             PIC X  VALUE "0".
           05  FILE-STATUS-2             PIC X  VALUE "0".

       01 ARG-VALUES.
           05  PO-ARG                    PIC X(14) VALUE SPACES.
           05  VEN-ARG                   PIC X(10) VALUE SPACES.
           05  CODE-ARG                  PIC X(8)  VALUE SPACES.
           05  UM-ARG                    PIC XX    VALUE SPACES.
           05  PLT-ARG                   PIC X(4)  VALUE SPACES.
           05  REQ-ARG                   PIC X(12) VALUE SPACES.
           05  BUYER-ARG                 PIC X(4)  VALUE SPACES.

       01  RECORD-COUNTER-MESSAGE.
           05  FILLER                PIC X(14) VALUE "*TOTAL RECORDS".
           05  FILLER                PIC X(13) VALUE " PROCESSED   ".
           05  FILLER                    PIC X(2)  VALUE SPACES.
           05  TOT-REC-PROCESS           PIC 9(6)  VALUE ZEROS.

       01  BAD-CODE-LINE.
           05  FILLER         PIC X(15) VALUE "CORPORATE CODE ".
           05  BAD-CODE-SAVE             PIC X(7).

       PROCEDURE DIVISION.

      *-----------------------------------------------------------------*
       0-BEGIN.
      *-----------------------------------------------------------------*
           PERFORM 1-HSK.
           PERFORM 6-MAIN UNTIL DSAPREQ-EOF-SW = "Y".
           PERFORM 2-EOJ.
           GOBACK.

      *-----------------------------------------------------------------*
       1-HSK.
      *-----------------------------------------------------------------*
           MOVE "C" TO MCXCBLERR-SCOPE.
           CALL "MCXCBLERR" USING MCXCBLERR-SCOPE.
           ACCEPT CUR-DATE FROM DATE.
           IF CUR-DATE-YY > "70"
               MOVE "19"                 TO  CUR-DATE-CC
           ELSE
               MOVE "20"                 TO  CUR-DATE-CC.

           MOVE ZERO TO OLD-ORD-QTY-SAVE, ORD-QTY-SAVE,
             RECORD-COUNTER, SUB.

           MOVE 1                        TO   DATE-MODE.
           CALL "TDATECHK" USING DATE-CHECK-AREA.
           MOVE DATE-SLASH-OUT           TO   RQ-DATE.
           MOVE DATE-FORMATTED-TIME-OUT  TO   RQ-TIME.

           PERFORM 9999-OPENS.

           STRING "*" CUR-DATE DELIMITED BY SIZE INTO RQ-RPT-REC.
           WRITE RQ-RPT-REC.

           MOVE 1           TO   CTL.
           MOVE HDR-LINE-1  TO   RQ-RPT-LINE.
           WRITE RQ-RPT-REC.
           MOVE 1           TO   CTL.
           MOVE HDR-LINE-2  TO   RQ-RPT-LINE.
           WRITE RQ-RPT-REC.

           MOVE "P 01"         TO  PLT-ARG.
           PERFORM 9999-GETKEY-MPLTINFO-PK-I.
           MOVE MPLTINFO-COMPANY TO COMPANY-SAVE.

           PERFORM 9999-START-DSAPREQ.
           PERFORM 9999-READ-NEXT-DSAPREQ.

      *-----------------------------------------------------------------*
       2-EOJ.
      *-----------------------------------------------------------------*
           PERFORM 9999-CLOSES.

      *-----------------------------------------------------------------*
       6-MAIN.
      *-----------------------------------------------------------------*
           MOVE SAPRQ-REQ-NUM            TO  RQ-RPT-REQ.
           MOVE SAPRQ-PO-NUM             TO  RQ-RPT-PO.
           IF SAPRQ-UPDATE-DATE = SPACES
               MOVE SAPRQ-REQ-NUM TO REQ-ARG
               PERFORM 9999-READ-MREQ
               IF FILE-STATUS NOT = "00"
                   PERFORM 9999-BUILD-MREQ
                   MOVE "REQ CREATED"    TO  RQ-RPT-MSG
                   PERFORM 9999-WRITE-RPT
                   PERFORM 9999-RESET-MREQ-RQ-O
               END-IF
               MOVE REQ-SUB              TO  SAVE-SUB
               MOVE REQ-SUBD             TO  SAVE-SUBD
               MOVE REQ-ADDTL-DATA       TO  SAVE-ADDTL-DATA
               PERFORM 9999-RESET-MREQ-RQ-O
               PERFORM 60-CREATE-PO.
           PERFORM 9999-READ-NEXT-DSAPREQ.

      *-----------------------------------------------------------------*
       60-CREATE-PO.
      *-----------------------------------------------------------------*
           MOVE SAPRQ-PO-NUM      TO  PO-NUM-REL.
           MOVE BUILD-PO          TO  PO-ARG.
           PERFORM 9999-GET-DPORECD.
           IF FILE-STATUS = "00"
               MOVE "PO EXISTS; CANNOT ADD"  TO  RQ-RPT-MSG
               PERFORM 9999-WRITE-RPT
           ELSE
               PERFORM 61-ADD-HEADER.

           IF SAPRQ-ITEM-NO NOT NUMERIC
               MOVE 0001                 TO   SAVE-ITEM-NO
           ELSE
               MOVE SAPRQ-ITEM-NO        TO   SAVE-ITEM-NO.

           MOVE PO-ARG TO PORCVNO OF DPOITEM-PO-REC-O.
           MOVE SAVE-ITEM-NO TO ITEMNO OF DPOITEM-PO-REC-O.
           READ DPOITEM-PO-O INTO BUF-DPOITEM
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               PERFORM 62-ADD-ITEM
           ELSE
               MOVE "PO ITEM EXISTS; CANNOT ADD" TO RQ-RPT-MSG
               PERFORM 9999-WRITE-RPT
               PERFORM 73-PROCESS-REQ-NO
               MOVE CURRENT-DATE-CN       TO   SAPRQ-UPDATE-DATE
               REWRITE DSAPREQ-REC-IO FROM BUF-DSAPREQ
                   INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.

      *-----------------------------------------------------------------*
        61-ADD-HEADER.
      *-----------------------------------------------------------------*
            MOVE SPACES                   TO   BUF-DPORECD.
            MOVE BUILD-PO                 TO   PO-RCV-NO.
            PERFORM 70-EDIT-MOVE-PO-HEADER.
            MOVE SAPRQ-VENDOR-CODE        TO   VEN-ARG.
            PERFORM 71-CHECK-NEW-VENDOR.
            IF FILE-STATUS NOT = "00"
                PERFORM 72-ADD-DVENDOR.

            MOVE SPACES                   TO   PO-BUDGET-NUMBER.
            MOVE SAPRQ-VENDOR-CODE        TO   PO-VEN-CODE.
            MOVE SPACES                   TO   BUF-MPORCV.
            MOVE BUILD-PO                 TO   M-PO-RCV-NO.
            MOVE SPACES                   TO   M-PO-RCV-STAT.
      *------- IF ADDING ON A BAD PO WITH NO HEADER, THE MPORCV WILL
      *------- ALREADY BE THERE.
            MOVE PO-RCV-NO TO PO-ARG.
            PERFORM 9999-GETKEY-MPORCV-PO-I.
            IF NO-ENTRY
                PERFORM 9999-PUT-MPORCV-PO-O
            END-IF.
            PERFORM 9999-PUT-DPORECD-PO-O.

      *----------------------------------------------------------------*
       62-ADD-ITEM.
      *----------------------------------------------------------------*
           MOVE SPACES             TO   BAD-CODE-SW.

           INITIALIZE                   BUF-DPOITEM.

      *------- ON ADD ITEM, IF CORP CODE NOT EXIST, WILL ADD THE
      *------- ITEM AS NON-STOREROOM, AND PUT A COMMENT LINE WITH CODE
           IF SAPRQ-CORP-CODE NOT = "NON-STR"
               MOVE SAPRQ-CORP-CODE         TO  CODE-ARG
               PERFORM 9999-GETKEY-MSTORERM-CD-I
               IF FILE-STATUS NOT = "00"
                   MOVE "Y"                 TO   BAD-CODE-SW
                   MOVE SAPRQ-CORP-CODE     TO   BAD-CODE-SAVE
                   MOVE "NON-STR"           TO   ITM-CORP-CODE
               ELSE
                   MOVE SAPRQ-CORP-CODE     TO   ITM-CORP-CODE.

           MOVE SAVE-ITEM-NO             TO   ITM-NUMBER.

           MOVE ZEROS                    TO   ITM-QTY-DLVR
                                              ITM-QTY-STORED
                                              ITM-QTY-PAID
                                              ITM-WT
                                              ITM-KELLY-PO-QTY
                                              ITM-ZBILL-VALUE
                                              ITM-ASN-QTY.
           MOVE "NO"                     TO   ITM-TAX-CODE.

           IF SAPRQ-QTY-ORD NUMERIC
               MOVE SAPRQ-QTY-ORD        TO   ITM-QTY-ORD.
           MOVE SAPRQ-QTY-UM             TO   ITM-UM.
           IF SAPRQ-PRICE NUMERIC
               MOVE SAPRQ-PRICE          TO   ITM-UNIT-PRICE.
           MOVE SAPRQ-PRICE-UM           TO   ITM-PRICE-UM.

           MOVE BUILD-PO                 TO  ITM-PO-RCV-NO.

           PERFORM 73-PROCESS-REQ-NO.
           MOVE CURRENT-DATE-CN          TO   SAPRQ-UPDATE-DATE.
           REWRITE DSAPREQ-REC-IO FROM BUF-DSAPREQ
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE "PROBLEM WITH DSAPREQ REWRITE"
                                         TO   RQ-RPT-MSG
               PERFORM 9999-WRITE-RPT.

           MOVE SAVE-SUB                 TO   ITM-CLASS.
           MOVE SAVE-SUBD                TO   ITM-SUB-DETL.
           MOVE SAVE-ADDTL-DATA          TO   ITM-ADDL-DATA.

           PERFORM 9999-PUT-DPOITEM-PO-O.

      *------- IF CORPCODE NOT EXIST, ADD A DESC LINE WITH CORP CODE
           IF BAD-CODE-SW = "Y"
               PERFORM 74-ADD-DATAITEM-NOEDIT.

      *----------------------------------------------------------------*
       70-EDIT-MOVE-PO-HEADER.
      *----------------------------------------------------------------*
           MOVE MPLTINFO-COMPANY          TO   PO-PLT
                                               PO-CO.
           MOVE MPLTINFO-PRIME            TO   PO-PRIME.
           MOVE SAPRQ-REQ-NUM             TO   PO-REQ-NUMBER.
           IF SAPRQ-VENDOR-CODE (8:3) = SPACES
               MOVE "000"                 TO   SAPRQ-VENDOR-CODE (8:3).
           IF SAPRQ-VENDOR-NAME = SPACES
               MOVE "*NO NAME ON FILE*"   TO   SAPRQ-VENDOR-NAME.
           IF SAPRQ-PO-DATE > SPACES
               MOVE SAPRQ-PO-DATE         TO   PO-DATE-CN
           ELSE
               STRING "20" DATE-YMD-OUT DELIMITED BY SIZE
                                        INTO   PO-DATE-CN.
           IF SAPRQ-DLV-DATE > SPACES
               MOVE SAPRQ-DLV-DATE        TO   PO-EXPECT-DATE-CN.
           MOVE SAPRQ-BUYER-NAME          TO   PO-BUYER-TYP.
           MOVE "*R3"                     TO   PO-TYPIST.
           MOVE 0                         TO   PO-BUDGET-AMT.

      *------- CHECK CURRENCY CODE
           MOVE SPACES                    TO   PO-CURRENCY-CODE.
           IF SAPRQ-CUR-CODE > SPACES
               MOVE SAPRQ-CUR-CODE        TO   UM-ARG
               PERFORM 9999-GETKEY-MVALIDUM-UM-I
               IF FILE-STATUS NOT = "00"
                   MOVE SPACES            TO  PO-CURRENCY-CODE
               ELSE
                   MOVE SAPRQ-CUR-CODE    TO  PO-CURRENCY-CODE.

      *----------------------------------------------------------------*
       71-CHECK-NEW-VENDOR.
      *----------------------------------------------------------------*
           MOVE SAPRQ-VENDOR-CODE TO VEN-ARG.
           PERFORM 9999-CHAINHD-DVENDOR-VN-O.
           PERFORM 9999-GETNEXT-DVENDOR-VN-O.

      *----------------------------------------------------------------*
       72-ADD-DVENDOR.
      *----------------------------------------------------------------*
           MOVE SPACES               TO  BUF-DVENDOR.
           MOVE SAPRQ-VENDOR-CODE    TO  VEN-VEN-CODE.
           MOVE ZEROS                TO  VEN-ITM-NO.
           MOVE SAPRQ-VENDOR-NAME    TO  VEN-NAME.
           IF SAPRQ-VENDOR-NAME NOT = SPACES
             PERFORM 9999-PUT-DVENDOR-VN-O
             PERFORM 720-PUT-KVENDOR.

      *----------------------------------------------------------------*
       720-PUT-KVENDOR.
      *----------------------------------------------------------------*
           PERFORM 9999-GETKEY-KVENDOR-VN-O.
           IF FILE-STATUS = "00"
             PERFORM 9999-DELETE-KVENDOR-VN-O
           END-IF.
           MOVE VEN-VEN-CODE TO KVENDOR-CODE.
           MOVE VEN-NAME TO KVENDOR-NAME.
           PERFORM 9999-PUT-KVENDOR-VN-O.

      *----------------------------------------------------------------*
       73-PROCESS-REQ-NO.
      *----------------------------------------------------------------*
           MOVE PO-ARG                TO  REQLINK-PO-NUM.
           MOVE SAPRQ-VENDOR-CODE     TO  REQLINK-VEN-CODE.
           MOVE REQ-ARG               TO  REQLINK-REQ-NO.
           MOVE SAVE-ITEM-NO          TO  REQLINK-PO-ITEM-NO.
           CALL "SREQLINK" USING BASE,
                                 REQLINK-PARMS.

      *----------------------------------------------------------------*
       74-ADD-DATAITEM-NOEDIT.
      *----------------------------------------------------------------*
           MOVE PO-ARG                   TO   DATAITM-PO-RCV-NO.
           MOVE SAVE-ITEM-NO             TO   DATAITM-ITEM-NO.
           MOVE "90"                     TO   DATAITM-LINE-NO.
           MOVE BAD-CODE-LINE            TO   DATAITM-INFO.
           PERFORM 9999-PUT-DPODATAITM-PO-O.

      *----------------------------------------------------------------*
       9999-OPENS.
      *----------------------------------------------------------------*
           OPEN I-O    MPORCV-PO-O, DPORECD-PO-O,
                       DPOITEM-PO-O, DPODATAITM-PO-O, MREQ-RQ-O,
                       DVENDOR-VN-O, KVENDOR-VN-O, DREQITM-RQ-O,
                       DSAPREQ-IO.
           OPEN INPUT  MVALIDUM-UM-I, MSTORERM-CD-I,
                       MPORCV-PO-I, MPLTINFO-PK-I.
           OPEN EXTEND RQ-RPT-FILE.

      *----------------------------------------------------------------*
       9999-CLOSES.
      *----------------------------------------------------------------*
           CLOSE       MPORCV-PO-O, DPORECD-PO-O, MREQ-RQ-O,
                       DPOITEM-PO-O, DPODATAITM-PO-O, DREQITM-RQ-O,
                       DVENDOR-VN-O, KVENDOR-VN-O, MVALIDUM-UM-I,
                       MSTORERM-CD-I, MPORCV-PO-I, MPLTINFO-PK-I,
                       DSAPREQ-IO, RQ-RPT-FILE.

      *----------------------------------------------------------------*
       9999-GETKEY-MPLTINFO-PK-I.
      *----------------------------------------------------------------*
           MOVE PLT-ARG TO PLTINFOKEY OF MPLTINFO-PK-REC-I.
           READ MPLTINFO-PK-I INTO BUF-MPLTINFO
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE "GETKEY ERR 9999-GETKEY-MPLTINFO-PK-I"
                   TO RQ-RPT-MSG
               PERFORM 9999-WRITE-RPT.

      *----------------------------------------------------------------*
         9999-READ-MREQ.
      *----------------------------------------------------------------*
           MOVE REQ-ARG TO REQNO OF MREQ-RQ-REC-O.
           READ MREQ-RQ-O INTO BUF-MREQ
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.

      *----------------------------------------------------------------*
         9999-RESET-MREQ-RQ-O.
      *----------------------------------------------------------------*
             MOVE HIGH-VALUES TO REQNO OF MREQ-RQ-REC-O.
             START MREQ-RQ-O KEY > REQNO OF MREQ-RQ-REC-O
                 INVALID KEY MOVE "00" TO FILE-STATUS.

      *----------------------------------------------------------------*
       9999-GETKEY-MPORCV-PO-I.
      *----------------------------------------------------------------*
           MOVE 0 TO COND-WORD.
           MOVE PO-ARG TO PORCVNO OF MPORCV-PO-REC-I.
           READ MPORCV-PO-I INTO BUF-MPORCV
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS = "23"
               MOVE 17 TO COND-WORD
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE "GETKEY ERR 9999-GETKEY-MPORCV-PO-I"
                   TO RQ-RPT-MSG
               PERFORM 9999-WRITE-RPT.

      *----------------------------------------------------------------*
       9999-PUT-MPORCV-PO-O.
      *----------------------------------------------------------------*
           MOVE 0 TO COND-WORD.
           WRITE MPORCV-PO-REC-O FROM BUF-MPORCV
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD
               MOVE "PUT ERR 9999-PUT-MPORCV-PO-O"
                   TO RQ-RPT-MSG
               PERFORM 9999-WRITE-RPT.

      *----------------------------------------------------------------*
        9999-GET-DPORECD.
      *----------------------------------------------------------------*
           MOVE PO-ARG TO PORCVNO OF DPORECD-PO-REC-O.
           START DPORECD-PO-O KEY = PORCVNO OF DPORECD-PO-REC-O
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.

      *----------------------------------------------------------------*
       9999-PUT-DPORECD-PO-O.
      *----------------------------------------------------------------*
           MOVE 0 TO COND-WORD.
           WRITE DPORECD-PO-REC-O FROM BUF-DPORECD
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD
               MOVE "PUT ERR 9999-PUT-DPORECD-PO-O"
                   TO RQ-RPT-MSG
               PERFORM 9999-WRITE-RPT.

      *----------------------------------------------------------------*
       9999-PUT-DPOITEM-PO-O.
      *----------------------------------------------------------------*
           WRITE DPOITEM-PO-REC-O FROM BUF-DPOITEM
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE "PUT ERR 9999-PUT-DPOITEM-PO-O"
                   TO RQ-RPT-MSG
               PERFORM 9999-WRITE-RPT.

      *----------------------------------------------------------------*
       9999-PUT-DPODATAITM-PO-O.
      *----------------------------------------------------------------*
           WRITE DPODATAITM-PO-REC-O FROM BUF-DPODATAITM
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE "PUT ERR 9999-PUT-DPODATAITM-PO-O"
                   TO RQ-RPT-MSG
               PERFORM 9999-WRITE-RPT.

      *----------------------------------------------------------------*
       9999-CHAINHD-DVENDOR-VN-O.
      *----------------------------------------------------------------*
           MOVE VEN-ARG TO VENCDE OF DVENDOR-VN-REC-O.
           START DVENDOR-VN-O KEY = VENCDE OF DVENDOR-VN-REC-O
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.

      *----------------------------------------------------------------*
       9999-GETNEXT-DVENDOR-VN-O.
      *----------------------------------------------------------------*
           MOVE 0 TO COND-WORD.
           READ DVENDOR-VN-O NEXT INTO BUF-DVENDOR
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF VENCDE OF DVENDOR-VN-REC-O NOT = VEN-ARG
               PERFORM 9999-RESET-DVENDOR-VN-O
               MOVE 15 TO FILE-STATUS.

      *----------------------------------------------------------------*
       9999-RESET-DVENDOR-VN-O.
      *----------------------------------------------------------------*
           MOVE HIGH-VALUES TO VENCDE OF DVENDOR-VN-REC-O.
           START DVENDOR-VN-O KEY > VENCDE OF DVENDOR-VN-REC-O
               INVALID KEY MOVE "00" TO FILE-STATUS.

      *----------------------------------------------------------------*
       9999-PUT-DVENDOR-VN-O.
      *----------------------------------------------------------------*
           MOVE 0 TO COND-WORD.
           WRITE DVENDOR-VN-REC-O FROM BUF-DVENDOR
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE "PUT ERR 9999-PUT-DVENDOR-VN-O"
                   TO RQ-RPT-MSG
               PERFORM 9999-WRITE-RPT.

      *----------------------------------------------------------------*
       9999-DELETE-KVENDOR-VN-O.
      *----------------------------------------------------------------*
           DELETE KVENDOR-VN-O
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.

      *----------------------------------------------------------------*
       9999-GETKEY-KVENDOR-VN-O.
      *----------------------------------------------------------------*
           MOVE VEN-ARG TO KVENCDE OF KVENDOR-VN-REC-O.
           READ KVENDOR-VN-O INTO BUF-KVENDOR
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.

      *----------------------------------------------------------------*
       9999-RESET-KVENDOR-VN-O.
      *----------------------------------------------------------------*
           MOVE HIGH-VALUES TO KVENCDE OF KVENDOR-VN-REC-O.
           START KVENDOR-VN-O KEY > KVENCDE OF KVENDOR-VN-REC-O
               INVALID KEY MOVE "00" TO FILE-STATUS.

      *----------------------------------------------------------------*
       9999-PUT-KVENDOR-VN-O.
      *----------------------------------------------------------------*
           WRITE KVENDOR-VN-REC-O FROM BUF-KVENDOR
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE "PUT ERR 9999-PUT-KVENDOR-WK-O"
                   TO RQ-RPT-MSG
               PERFORM 9999-WRITE-RPT.

      *----------------------------------------------------------------*
       9999-GETKEY-MVALIDUM-UM-I.
      *----------------------------------------------------------------*
           MOVE 0 TO COND-WORD.
           MOVE UM-ARG TO VALIDUM OF MVALIDUM-UM-REC-I.
           READ MVALIDUM-UM-I INTO BUF-MVALIDUM
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.

      *----------------------------------------------------------------*
       9999-GETKEY-MSTORERM-CD-I.
      *----------------------------------------------------------------*
           MOVE CODE-ARG TO CORPCDE OF MSTORERM-CD-REC-I.
           READ MSTORERM-CD-I INTO BUF-MSTORERM
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.

      *----------------------------------------------------------------*
       9999-BUILD-MREQ.
      *----------------------------------------------------------------*
           MOVE SPACES                   TO   BUF-MREQ.
           MOVE SAPRQ-REQ-NUM            TO   MREQ-NUMBER.
           MOVE 0                        TO   REQ-BUDGET-AMT.
           MOVE "X "                     TO   REQ-RELEASE-STAT.
           MOVE "NM"                     TO   REQ-STATUS.
           MOVE 1                        TO   DATE-MODE.
           CALL "TDATECHK" USING DATE-CHECK-AREA.
           MOVE DATE-YMD-OUT             TO   REQ-DATE.
           IF REQ-DATE-YY = "  "
               MOVE "  "                 TO   REQ-DATE-CC
           ELSE
               MOVE "20"                 TO   REQ-DATE-CC.
           MOVE SPACES                   TO   REQ-RCV-DEPT
                                              REQ-FOR-DEPT.
           MOVE SAPRQ-DLV-DATE           TO   REQ-SHIP-DATE-CN.
           MOVE MPLTINFO-COMPANY         TO   REQ-CO.
           MOVE MPLTINFO-PRIME           TO   REQ-PRIME.
           MOVE SPACES                   TO   REQ-SUB
                                              REQ-SUBD
                                              REQ-ADDTL-DATA
                                              REQ-BUDGET-NO
                                              REQ-TERMS
                                              REQ-ADDL-INFO
                                              REQ-FOB
                                              REQ-MMIS-INDIC.
      *------- FLAG THIS REQ WAS CREATED BY LOADPO
           MOVE "X"                      TO   REQ-LOADPO-CRTE-FLAG.

           PERFORM 9999-PUT-MREQ-RQ-O.

           IF SAPRQ-QTY-ORD NOT NUMERIC
               MOVE 0                    TO   SAPRQ-QTY-ORD.
           IF SAPRQ-PRICE NOT NUMERIC
               MOVE 0                    TO   SAPRQ-PRICE.
           MOVE SPACES                   TO   BUF-DREQITM.
           MOVE SAPRQ-REQ-NUM            TO   REQITM-REQ-NUMBER.
           MOVE "NON-STR"                TO   REQITM-CORP-CODE.
           MOVE SAPRQ-ITEM-NO            TO   REQITM-NUMBER.
           MOVE SAPRQ-QTY-UM             TO   REQITM-UM.
           MOVE SAPRQ-QTY-ORD            TO   REQITM-QTY-TO-ORD.
           MOVE SAPRQ-PRICE-UM           TO   REQITM-PRICE-UM.
           MOVE SAPRQ-PRICE              TO   REQITM-UNIT-PRICE.
           MULTIPLY SAPRQ-QTY-ORD BY SAPRQ-PRICE GIVING
                                         REQITM-BUDGET-AMT ROUNDED.
           MOVE 0                        TO   REQITM-UNIT-PRICE-CURR.
           PERFORM 9999-PUT-DREQITM-RQ-O.

      *----------------------------------------------------------------*
       9999-PUT-MREQ-RQ-O.
      *----------------------------------------------------------------*
           WRITE MREQ-RQ-REC-O FROM BUF-MREQ
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.

      *----------------------------------------------------------------*
       9999-PUT-DREQITM-RQ-O.
      *----------------------------------------------------------------*
           WRITE DREQITM-RQ-REC-O FROM BUF-DREQITM
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.

      *----------------------------------------------------------------*
       9999-START-DSAPREQ.
      *----------------------------------------------------------------*
           MOVE SPACES TO REQNO OF DSAPREQ-REC-IO.
           START DSAPREQ-IO KEY > REQNO OF DSAPREQ-REC-IO
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.

      *----------------------------------------------------------------*
       9999-READ-NEXT-DSAPREQ.
      *----------------------------------------------------------------*
           READ DSAPREQ-IO NEXT INTO BUF-DSAPREQ
               AT END MOVE "Y" TO DSAPREQ-EOF-SW.

      *----------------------------------------------------------------*
       9999-WRITE-RPT.
      *----------------------------------------------------------------*
           MOVE 1           TO   CTL.
           MOVE RPT-LINE    TO   RQ-RPT-LINE.
           WRITE RQ-RPT-REC.
