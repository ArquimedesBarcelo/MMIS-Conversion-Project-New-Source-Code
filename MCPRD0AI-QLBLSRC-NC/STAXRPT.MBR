       IDENTIFICATION DIVISION.
       PROGRAM-ID.          STAXRPT.
       AUTHOR.              ANNETTE KRAUSS.
       INSTALLATION.        GOODYEAR TIRE AND RUBBER - AKRON.
       DATE-WRITTEN.        JUNE 6, 1986.

      *REMARKS.

      *C  06/02/99   CA YODER   (DECATUR REQUEST)
      *C    EXPANDED TAX RATE PERCENTAGE FROM 2 DECIMAL
      *C    PLACES TO 4.

       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.
       SOURCE-COMPUTER.  IBM-AS400.
       OBJECT-COMPUTER.  IBM-AS400.
       SPECIAL-NAMES.
           C01 IS NEW-PAGE.

       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT PRINT-FILE ASSIGN TO PRINTER-MCPRT.
           SELECT SORT-FILE  ASSIGN TO DISK-SORT.
           SELECT MPLTINFO-I
                  ASSIGN TO DATABASE-MCFLCS0501
                  ORGANIZATION IS INDEXED
                    ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                  FILE STATUS IS FILE-STATUS.
           SELECT MTAX-I
                  ASSIGN TO DATABASE-MCFLCS3701
                  ORGANIZATION IS INDEXED
                    ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                  FILE STATUS IS FILE-STATUS.
           SELECT DCOMMENT-I
                  ASSIGN TO DATABASE-MCFLCS1901
                  ORGANIZATION IS INDEXED
                    ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                    WITH DUPLICATES
                  FILE STATUS IS FILE-STATUS.

       DATA DIVISION.
       FILE SECTION.

       FD  PRINT-FILE
           LABEL RECORDS ARE OMITTED
           RECORD CONTAINS 132 CHARACTERS
           DATA RECORD IS PRINT-REC.
       01  PRINT-REC                  PIC X(132).

       SD  SORT-FILE
           RECORD CONTAINS 30 CHARACTERS.
       01  SORT-RCD.
           05  SORT-TAX-CODE          PIC X(2).
           05  SORT-TAX-LIST.
      ******  10  SORT-TAX-PERCENT OCCURS 4 TIMES
      ******                          PIC S9(2)V9(2).
              10  SORT-TAX-PERCENT OCCURS 4 TIMES
                                      PIC S9(2)V9(4).
           05  SORT-TAX-INDIC-LIST.
              10  SORT-TAX-PAY-INDIC OCCURS 4 TIMES
                                      PIC X.

       FD  MPLTINFO-I
           LABEL RECORDS ARE STANDARD.
       01  MPLTINFO-REC-I.
           COPY DDS-MCRPCS0500   OF MCFLCS0501.

       FD  MTAX-I
           LABEL RECORDS ARE STANDARD.
       01  MTAX-REC-I.
           COPY DDS-MCRPCS3700   OF MCFLCS3701.

       FD  DCOMMENT-I
           LABEL RECORDS ARE STANDARD.
       01  DCOMMENT-REC-I.
           COPY DDS-MCRPCS1900   OF MCFLCS1901.

       WORKING-STORAGE SECTION.
       77  LINE-CTR                   PIC 9(2)   VALUE ZEROS.
       77  PAGE-NUM                   PIC 9(3)   VALUE ZEROS.
       01  END-OF-SORT-FILE           PIC X(1)   VALUE "N".
           88  ALL-SORTED-RECORDS-PROCESSED      VALUE "Y".
       01  END-OF-INPUT-FILE          PIC X(1)   VALUE "N".
           88  ALL-INPUT-RECORDS-PROCESSED       VALUE "Y".
       01  FILE-STATUS.
           05  FILE-STATUS-1          PIC X      VALUE SPACES.
           05  FILE-STATUS-2          PIC X      VALUE SPACES.

      **********************
      *                    *
      * ESCAPE SEQUENCES   *
      *                    *
      **********************
       01  STRIP                  PIC X(5)  JUST RIGHT VALUE SPACES.
       01  EXPAND-PRINT-STRIPED   PIC X(5)  VALUE "*EXP*".
       01  COMPRESS-PRINT-STRIPED PIC X(5)  VALUE "*CMP*".


      *****ARGUMENT VALUES*****
       01  COMMENT-ARG                PIC X(4)   VALUE SPACES.
       01  MPLTINFO-ARG               PIC X(4)   VALUE SPACES.

       01  ITEM-LISTINGS.
           05  ALL-ITEM-LIST          PIC XX     VALUE "@;".
           05  COMMENT-SEARCH    PIC X(16)  VALUE "MCOM-COMMENT-NO;".

       COPY TDATECHK IN COPYLIB.

      *********************
      *                   *
      *   DATA SET NAMES  *
      *                   *
      *********************

       01  DSET-NAMES.
           05  DSET-MTAX              PIC X(16)  VALUE "MTAX;".
           05  DSET-DCOMMENT          PIC X(16)  VALUE "DCOMMENT;".
           05  DSET-MPLTINFO          PIC X(16)  VALUE "MPLTINFO;".
           05  DSET-NAME              PIC X(16)  VALUE SPACES.


       01 SWITCH-AREA.
           05  EXP-PRT-FLAG           PIC X  VALUE SPACES.
           05  COMP-PRT-FLAG          PIC X  VALUE SPACES.
           05  AT-LEAST-ONE-FOUND     PIC X  VALUE "N".

       01  WORK-AREA.
           05  BUILD-COMMENT-NO.
               10  BUILD-COM-PREFIX     PIC X(1)  VALUE "T".
               10  BUILD-FILLER         PIC X(1)  VALUE SPACES.
               10  BUILD-COM-NO         PIC X(2)  VALUE SPACES.


      *--------------------- ESCAPE SEQUENCES

       COPY TBLOWUP IN COPYLIB.
       01  VIEW-COMAREA.
           05  FILLER                  PIC X(118)  VALUE ALL "0".
           05  FILLER                  PIC S9(4)   COMP-4 VALUE 9999.
       01  KSAM-STATUS                 PIC X(2)    VALUE SPACES.


      *--------------------- DATABASE AREA
       COPY DBMODES IN COPYLIB.

       COPY DBSTAT  IN COPYLIB.

      *--------------------- DATABASE BUFFERS
       COPY MTAX    IN COPYLIB.

       COPY MPLTINFO IN COPYLIB.

       COPY DCOMMENT IN COPYLIB.

      *********************************
      *                               *
      *  REPORT  HEADERS              *
      *                               *
      *********************************

       01  PRINT-LINE                 PIC X(132)  VALUE SPACES.

       01  HEAD1 REDEFINES PRINT-LINE.
           05  FILLER                 PIC X(29).
           05  HEAD1-TITLE1           PIC X(39).
           05  HEAD1-TITLE2           PIC X(37).
           05  FILLER                 PIC X(15).
           05  HEAD1-PLANT            PIC X(6).
           05  HEAD1-PLANT-OUT        PIC X(3).
           05  FILLER                 PIC X(3).

       01  HEAD2 REDEFINES PRINT-LINE.
           05  FILLER                 PIC X(1).
           05  HEAD2-DATE             PIC X(8).
           05  FILLER                 PIC X(5).
           05  HEAD2-TIME             PIC X(8).
           05  FILLER                 PIC X(10).
           05  HEAD2-TITLE1           PIC X(30).
           05  HEAD2-TITLE2           PIC X(42).
           05  FILLER                 PIC X(14).
           05  HEAD2-PAGE             PIC X(6).
           05  HEAD2-PAGE-NO          PIC Z,ZZ9.
           05  FILLER                 PIC X(3).

       01  HEAD-3.
           05  FILLER          PIC X(7)   VALUE  SPACES.
           05  FILLER          PIC X(15)  VALUE "TAX CODE".
           05  DISTRICT-1      PIC X(15).
           05  FILLER          PIC X(6)  VALUE  SPACES.
           05  DISTRICT-2      PIC X(15).
           05  FILLER          PIC X(6)  VALUE  SPACES.
           05  DISTRICT-3      PIC X(15).
           05  FILLER          PIC X(6)  VALUE  SPACES.
           05  DISTRICT-4      PIC X(15).
           05  FILLER          PIC X(32)  VALUE  SPACES.

       01  HEAD-4.
           05  FILLER          PIC X(22)  VALUE SPACES.
           05  FILLER          PIC X(21)  VALUE
               "PERCENT  INDIC.".
           05  FILLER          PIC X(21)  VALUE
               "PERCENT  INDIC.".
           05  FILLER          PIC X(21)  VALUE
               "PERCENT  INDIC.".
           05  FILLER          PIC X(21)  VALUE
               "PERCENT  INDIC.".
           05  FILLER          PIC X(22)  VALUE
               "(P=PAYABLE, A=ACCRUED)".

       01  DOT-LINE.
           05  FILLER                 PIC X(132)  VALUE ALL "-".

       01  COMMENT-DETAIL-FIRST-LINE.
           05  FILLER          PIC X(10)   VALUE  SPACES.
           05  TAX-CODE-OUT    PIC X(2).
           05  FILLER          PIC X(10)  VALUE  SPACES.
      **** 05  TAX-PERCENT-1   PIC 99.99.
           05  TAX-PERCENT-1   PIC 99.9999.
           05  FILLER          PIC X(5)   VALUE  SPACES.
           05  TAX-INDIC-1     PIC X.
           05  FILLER          PIC X(08)  VALUE  SPACES.
      **** 05  TAX-PERCENT-2   PIC 99.99.
           05  TAX-PERCENT-2   PIC 99.9999.
           05  FILLER          PIC X(5)   VALUE  SPACES.
           05  TAX-INDIC-2     PIC X.
           05  FILLER          PIC X(08)  VALUE  SPACES.
      **** 05  TAX-PERCENT-3   PIC 99.99.
           05  TAX-PERCENT-3   PIC 99.9999.
           05  FILLER          PIC X(5)   VALUE  SPACES.
           05  TAX-INDIC-3     PIC X.
           05  FILLER          PIC X(08)  VALUE  SPACES.
      **** 05  TAX-PERCENT-4   PIC 99.99.
           05  TAX-PERCENT-4   PIC 99.9999.
           05  FILLER          PIC X(5)   VALUE  SPACES.
           05  TAX-INDIC-4     PIC X.
           05  FILLER          PIC X(10)   VALUE  SPACES.
           05  FILLER          PIC X(12)   VALUE
               "PRINT TYPE: ".
           05  PRINT-TYPE-OUT  PIC X(10).

       01  COMMENT-DETAIL-SEC-LINE.
           05  FILLER  PIC X(16)  VALUE SPACES.
           05  COM-CONTENT-OUT-2  PIC X(72).


       LINKAGE SECTION.
       01  BASE                                  PIC X(10).
       01  PLANT-NUMBER                          PIC X(3).
       01  ESC-INFO.
           05  COMPRESS-PRINT                    PIC X(8).
           05  NORMAL-PRINT                      PIC X(8).
           05  EXPAND-PRINT                      PIC X(8).
       01  HD-PAPER-FLAG                         PIC X(1).
           88  PAPER-IS-132-COL                           VALUE "X".



       PROCEDURE DIVISION USING BASE, PLANT-NUMBER, ESC-INFO,
                                HD-PAPER-FLAG.

       1-HOUSEKEEP SECTION.
           OPEN OUTPUT PRINT-FILE.
           OPEN INPUT MPLTINFO-I, MTAX-I, DCOMMENT-I.

           MOVE "STAXRPT" TO BU-PGM-NAME.

           MOVE "PTX1" TO MPLTINFO-ARG.
           MOVE MPLTINFO-ARG TO PLTINFOKEY OF MPLTINFO-REC-I.
           READ MPLTINFO-I INTO BUF-MPLTINFO
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS = "00"
               MOVE MPLTINFO-TAX-DISTRICT (1) TO DISTRICT-1
               MOVE MPLTINFO-TAX-DISTRICT (2) TO DISTRICT-2
           ELSE
           IF FILE-STATUS-1 = "2"
               MOVE "  DISTRICT 1"            TO DISTRICT-1
               MOVE "  DISTRICT 2"            TO DISTRICT-2
           ELSE
               MOVE "DBGET MPLTINFO ERROR"    TO BU-DISPLAY-MSG
               MOVE "PTX1"                    TO BU-DISPLAY-FLD (1)
               GO TO 82-BLOWUP.

           MOVE "PTX2" TO MPLTINFO-ARG.
           MOVE MPLTINFO-ARG TO PLTINFOKEY OF MPLTINFO-REC-I.
           READ MPLTINFO-I INTO BUF-MPLTINFO
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS = "00"
               MOVE MPLTINFO-TAX-DISTRICT (1) TO DISTRICT-3
               MOVE MPLTINFO-TAX-DISTRICT (2) TO DISTRICT-4
           ELSE
           IF FILE-STATUS-1 = "2"
               MOVE "  DISTRICT 3"            TO DISTRICT-3
               MOVE "  DISTRICT 4"            TO DISTRICT-4
           ELSE
               MOVE "DBGET MPLTINFO ERROR"    TO BU-DISPLAY-MSG
               MOVE "PTX2"                    TO BU-DISPLAY-FLD (1)
               GO TO 82-BLOWUP.

           SORT SORT-FILE
             ON ASCENDING KEY SORT-TAX-CODE
                 INPUT PROCEDURE IS 8-SERIAL-READ-MTAX
                 OUTPUT PROCEDURE IS 9-WRITE-RECORDS.

           WRITE PRINT-REC FROM NORMAL-PRINT AFTER ADVANCING 0.

           CLOSE MPLTINFO-I, MTAX-I, DCOMMENT-I.
           GOBACK.



       8-SERIAL-READ-MTAX SECTION.
           READ MTAX-I FIRST RECORD INTO BUF-MTAX
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               GO TO 89-EXIT.
           PERFORM 81-PROCESS-INPUT-RECORDS THRU 81-PIR-EXIT.
           GO TO 89-EXIT.

       81-PROCESS-INPUT-RECORDS.
           MOVE MTAX-CODE            TO  SORT-TAX-CODE.
           MOVE MTAX-PERCENT (1)     TO  SORT-TAX-PERCENT (1).
           MOVE MTAX-PERCENT (2)     TO  SORT-TAX-PERCENT (2).
           MOVE MTAX-PERCENT (3)     TO  SORT-TAX-PERCENT (3).
           MOVE MTAX-PERCENT (4)     TO  SORT-TAX-PERCENT (4).
           MOVE MTAX-PAY-INDIC (1)   TO  SORT-TAX-PAY-INDIC (1).
           MOVE MTAX-PAY-INDIC (2)   TO  SORT-TAX-PAY-INDIC (2).
           MOVE MTAX-PAY-INDIC (3)   TO  SORT-TAX-PAY-INDIC (3).
           MOVE MTAX-PAY-INDIC (4)   TO  SORT-TAX-PAY-INDIC (4).
           RELEASE SORT-RCD.

           READ MTAX-I NEXT INTO BUF-MTAX
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   GO TO 81-PIR-EXIT
               ELSE
               MOVE "DBGET MTAX ERROR"  TO BU-DISPLAY-MSG
               MOVE COND-WORD               TO BU-DISPLAY-FLD (1)
               PERFORM 82-BLOWUP.

           GO TO 81-PROCESS-INPUT-RECORDS.

       81-PIR-EXIT.
           EXIT.

      *************************************************************
      *                    BLOWUP   ROUTINE                       *
      *************************************************************
       82-BLOWUP.
           WRITE PRINT-REC FROM NORMAL-PRINT AFTER ADVANCING 0.

           CALL "TBLOWUP" USING BASE, BU-PGM-NAME, STATUS-AREA,
                 VIEW-COMAREA, FILE-STATUS, BU-DISPLAY-MSG,
                 BU-DISPLAY-AREA.



       89-EXIT.
           EXIT.


       9-WRITE-RECORDS SECTION.
           IF PAPER-IS-132-COL
               NEXT SENTENCE
           ELSE
               WRITE PRINT-REC FROM COMPRESS-PRINT
                   AFTER ADVANCING 0 LINES.

           PERFORM 94-NEW-PAGE.
           RETURN SORT-FILE
               AT END GO TO 92-REPORT-FINISHED.
           PERFORM 91-PROCESS-SORTED-RECORDS THRU 91-PSR-X
               UNTIL ALL-SORTED-RECORDS-PROCESSED.
           GO TO 99-WRITE-RPT-EXIT.

       91-PROCESS-SORTED-RECORDS.
           PERFORM 92-FIND-DCOMMENT THRU  92-DONE-WRITE-COMMENT.
           RETURN SORT-FILE
               AT END MOVE "Y"   TO END-OF-SORT-FILE.

       91-PSR-X.
           EXIT.

       92-REPORT-FINISHED.
           MOVE "*** NO TAX CODES ****" TO PRINT-LINE.
           WRITE PRINT-REC AFTER ADVANCING 1 LINES.
           GO TO 99-WRITE-RPT-EXIT.

       92-FIND-DCOMMENT.
           MOVE SORT-TAX-CODE  TO  BUILD-COM-NO.
           MOVE BUILD-COMMENT-NO  TO  COMMENT-ARG.
           MOVE COMMENT-ARG TO MCOMCOMMNT OF DCOMMENT-REC-I.
           START DCOMMENT-I KEY = MCOMCOMMNT OF DCOMMENT-REC-I
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
                   MOVE SPACES  TO  EXP-PRT-FLAG, COMP-PRT-FLAG
                   MOVE SPACES TO PRINT-TYPE-OUT
                   PERFORM 92-WRITE-FIRST-DETAIL
                   MOVE "** NO INSTRUCTION ON FILE **"
                       TO COM-CONTENT-OUT-2
                   WRITE PRINT-REC FROM COMMENT-DETAIL-SEC-LINE
                          AFTER ADVANCING 1 LINES
                   ADD 1 TO LINE-CTR
                   GO TO 92-DONE-WRITE-COMMENT
               ELSE
               MOVE "START DCOMMENT ERROR"  TO  BU-DISPLAY-MSG
               MOVE COND-WORD                TO  BU-DISPLAY-FLD (1)
               PERFORM 92-BLOWUP.

       92-FIND-PRT-TYPE.
           MOVE SPACES  TO  EXP-PRT-FLAG, COMP-PRT-FLAG.
           READ DCOMMENT-I NEXT INTO BUF-DCOMMENT
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE "DBGET DCOMMENT 1 ERROR"  TO BU-DISPLAY-MSG
               MOVE COND-WORD                 TO BU-DISPLAY-FLD (1)
               PERFORM 92-BLOWUP.

           IF EXP-PRT-START  =  EXPAND-PRINT-STRIPED
               MOVE "X"  TO  EXP-PRT-FLAG
               MOVE EXP-DATA-COMMENT  TO  COM-CONTENT-OUT-2
               MOVE "EXPANDED"  TO  PRINT-TYPE-OUT
           ELSE
               IF COMP-PRT-START  =  COMPRESS-PRINT-STRIPED
                   MOVE "X"  TO  COMP-PRT-FLAG
                   MOVE COMP-DATA-COMMENT  TO COM-CONTENT-OUT-2
                   MOVE "COMPRESSED"  TO  PRINT-TYPE-OUT
               ELSE
                   MOVE DCOM-DATA-LINE  TO  COM-CONTENT-OUT-2
                   MOVE "REGULAR"  TO  PRINT-TYPE-OUT.

       92-WRITE-FIRST-DETAIL.
           MOVE SORT-TAX-CODE            TO  TAX-CODE-OUT.
           MOVE SORT-TAX-PERCENT (1)     TO  TAX-PERCENT-1.
           MOVE SORT-TAX-PERCENT (2)     TO  TAX-PERCENT-2.
           MOVE SORT-TAX-PERCENT (3)     TO  TAX-PERCENT-3.
           MOVE SORT-TAX-PERCENT (4)     TO  TAX-PERCENT-4.
           MOVE SORT-TAX-PAY-INDIC (1)   TO  TAX-INDIC-1.
           MOVE SORT-TAX-PAY-INDIC (2)   TO  TAX-INDIC-2.
           MOVE SORT-TAX-PAY-INDIC (3)   TO  TAX-INDIC-3.
           MOVE SORT-TAX-PAY-INDIC (4)   TO  TAX-INDIC-4.
           WRITE PRINT-REC FROM COMMENT-DETAIL-FIRST-LINE
                 AFTER ADVANCING 1 LINES.
           ADD  1  TO LINE-CTR.

       92-WRITE-SECOND-DETAIL.
           WRITE PRINT-REC FROM COMMENT-DETAIL-SEC-LINE
                  AFTER ADVANCING 1 LINES.
           ADD  1  TO LINE-CTR.

       92-CONT-GET-DCOMMENT.
           READ DCOMMENT-I NEXT INTO BUF-DCOMMENT
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   GO TO 92-DONE-WRITE-COMMENT
               ELSE
                   MOVE "DBGET DCOMMENT 2 ERROR"  TO BU-DISPLAY-MSG
                   MOVE COND-WORD                 TO BU-DISPLAY-FLD (1)
                   PERFORM 92-BLOWUP.
           IF MCOMCOMMNT OF DCOMMENT-REC-I NOT = COMMENT-ARG
               GO TO 92-DONE-WRITE-COMMENT.

           IF EXP-PRT-FLAG  = "X"
               MOVE EXP-DATA-COMMENT  TO  COM-CONTENT-OUT-2
           ELSE
               IF COMP-PRT-FLAG  =  "X"
                   MOVE COMP-DATA-COMMENT  TO  COM-CONTENT-OUT-2
               ELSE
                   MOVE DCOM-DATA-LINE  TO  COM-CONTENT-OUT-2.

           WRITE PRINT-REC FROM COMMENT-DETAIL-SEC-LINE
                  AFTER ADVANCING 1 LINES.
           ADD  1  TO LINE-CTR.
           GO TO 92-CONT-GET-DCOMMENT.

       92-DONE-WRITE-COMMENT.
           MOVE SPACES  TO  PRINT-LINE.
           WRITE PRINT-REC FROM PRINT-LINE AFTER ADVANCING 3 LINES.
           ADD  3 TO LINE-CTR.
           IF LINE-CTR > 55
               PERFORM 94-NEW-PAGE.


      *************************************************************
      *                    BLOWUP   ROUTINE                       *
      *************************************************************
       92-BLOWUP.
           WRITE PRINT-REC FROM NORMAL-PRINT AFTER ADVANCING 0.

           CALL "TBLOWUP" USING BASE, BU-PGM-NAME, STATUS-AREA,
                 VIEW-COMAREA, FILE-STATUS, BU-DISPLAY-MSG,
                 BU-DISPLAY-AREA.



       94-NEW-PAGE.
           MOVE SPACES                TO PRINT-LINE.
           ADD 1                      TO PAGE-NUM.
           MOVE "G O O D Y E A R   C O R P O R A T E   "
                                      TO HEAD1-TITLE1.
           MOVE " I N F O R M A T I O N   S Y S T E M"
                                      TO HEAD1-TITLE2.
           MOVE "PLANT "              TO HEAD1-PLANT.
           MOVE PLANT-NUMBER          TO HEAD1-PLANT-OUT.
           WRITE PRINT-REC FROM PRINT-LINE AFTER ADVANCING NEW-PAGE.
           MOVE SPACES                TO PRINT-LINE.
           MOVE 1                     TO DATE-MODE.
           CALL "TDATECHK" USING DATE-CHECK-AREA.
           MOVE DATE-FORMATTED-TIME-OUT TO HEAD2-TIME.
           MOVE DATE-SLASH-OUT        TO HEAD2-DATE.
           MOVE "PAGE: "              TO HEAD2-PAGE.
           MOVE PAGE-NUM              TO HEAD2-PAGE-NO.
           MOVE "                   V A L I D  " TO HEAD2-TITLE1.
           MOVE " T A X   C O D E S                       "
                                                 TO HEAD2-TITLE2.
           WRITE PRINT-REC FROM PRINT-LINE AFTER ADVANCING 2 LINES.
           WRITE PRINT-REC FROM DOT-LINE AFTER ADVANCING 1 LINES.
           WRITE PRINT-REC FROM HEAD-3 AFTER ADVANCING 2 LINES.
           WRITE PRINT-REC FROM HEAD-4 AFTER ADVANCING 1 LINES.
           MOVE SPACES                 TO PRINT-LINE.
           WRITE PRINT-REC FROM PRINT-LINE AFTER ADVANCING 1 LINES.
           MOVE  8                     TO LINE-CTR.

       99-WRITE-RPT-EXIT.
           EXIT.

