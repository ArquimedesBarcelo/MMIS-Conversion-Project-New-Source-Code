       IDENTIFICATION DIVISION.
       PROGRAM-ID.     TMANRPT.
       AUTHOR.         ANNETTE M. KRAUSS.
       DATE-WRITTEN.   MAY 13, 1986.
       DATE-COMPILED.
      *REMARKS.
                 REPORT OF VALID MANUFACTURES.

      *************************************************************
      *************************************************************
      *                     TMANRPT                               *
      *                                                           *
      *         THIS PROGRAM WILL PRINT A REPORT OF VALID         *
      *         MANUFACTURES.   THE USER CAN SPECIFY A RANGE      *
      *         OF MANUFACTURES OR ALL OF THE MANUFACTURES.       *
      *                                                           *
      *************************************************************
      *************************************************************
      *C
      *C   10FEB1994    DAVE PLUM
      *C     ADDED CALL TO THE COBOL ERROR HANDLER - MCXCBLERR.
      *C

       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.
       SOURCE-COMPUTER.    IBM-AS400.
       OBJECT-COMPUTER.    IBM-AS400.
       SPECIAL-NAMES.
           C01 IS NEW-PAGE.

       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT PRINT-FILE ASSIGN TO PRINTER-MCPRT.
           SELECT SORT-FILE  ASSIGN TO DISK-SORT.
           SELECT MPLTINFO-I
                  ASSIGN TO DATABASE-MCFLCS0501
                  ORGANIZATION IS INDEXED
                    ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                  FILE STATUS IS FILE-STATUS.

           SELECT MMANUFACT-I
                  ASSIGN TO DATABASE-MCFLCS3501
                  ORGANIZATION IS INDEXED
                    ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                  FILE STATUS IS FILE-STATUS.

       DATA DIVISION.
       FILE SECTION.
       FD  MPLTINFO-I
           LABEL RECORDS ARE STANDARD.
       01  MPLTINFO-I-REC.
           COPY DDS-MCRPCS0500  OF MCFLCS0501.

       FD  MMANUFACT-I
           LABEL RECORDS ARE STANDARD.
       01  MMANUFACT-I-REC.
           COPY DDS-MCRPCS3500  OF MCFLCS3501.

       FD  PRINT-FILE
           RECORD CONTAINS 132 CHARACTERS.
       01  PRINT-REC                              PIC X(132).

       SD  SORT-FILE
           RECORD CONTAINS 26 CHARACTERS.
       01  SORT-RECORD.
           05  SORT-MNF                           PIC X(26).

       WORKING-STORAGE SECTION.
       01  MCXCBLERR-SCOPE            PIC X(1)   VALUE "C".
       01  FILE-STATUS.
           05  FILE-STATUS-1          PIC X      VALUE "0".
           05  FILE-STATUS-2          PIC X      VALUE "0".
       01  PAGE-NUM                   PIC 9(3)   VALUE 0.
       01  LINE-CTR                   PIC 9(3)   VALUE 0.
       01  MESSAGE-AREA.
           05  NO-SORTED-RECORDS      PIC X(132) VALUE
            "    ****   NO RECORDS FOUND IN RANGE SPECIFIED  ****".
       01  END-OF-SORT-FILE           PIC X(1)   VALUE "N".
           88  ALL-SORTED-RECORDS-PROCESSED      VALUE "Y".
       01  END-OF-INPUT-FILE          PIC X(1)   VALUE "N".
           88  ALL-INPUT-RECORDS-PROCESSED       VALUE "Y".
       01  PLANT-NUMBER               PIC X(3)   VALUE SPACES.

       01  RPT-JCW                     PIC X(2)   VALUE SPACES.

       01  ACCEPT-FIELDS.
           05  ACCEPT-ALL-FLAG        PIC X(1)   VALUE SPACE.
               88  ALL-ITEMS                     VALUE "A".


      *-------------- TABLE WORK AREA
       01  TBL-WS.
           05  TBL-MNF   OCCURS 100 TIMES   PIC X(26).

       01  TBL-INDEX                  PIC 9(3).
       01  TBL-HALF                   PIC 9(3).
       01  TBL-INDEX2                 PIC 9(3).

      *-------------- ESCAPE SEQUENCES
       COPY ESCNAM2 IN COPYLIB.

       01  COMPRESS-PRINT             PIC X(8).

       01  NORMAL-PRINT               PIC X(8).

       01  ESC-TEXT-61                PIC X(8).

       COPY TBLOWUP  IN COPYLIB.
       01  VIEW-COMAREA.
           05  FILLER                  PIC X(118)  VALUE ALL "0".
           05  FILLER                  PIC S9(4)   COMP VALUE 9999.
       01  KSAM-STATUS                 PIC X(2)    VALUE SPACES.


      *---------- PARMS FOR CALL TO "THDPRT2" - HEADER PAGE SUBPROG.
       01  HD-RET-CODE                 PIC S9(4) COMP VALUE 0.
       01  HD-FILE-NAME                PIC X(17) VALUE SPACES.
       01  FNUM                        PIC S9(4) COMP VALUE 0.

       COPY TDATECHK IN COPYLIB.

      *------------- PRINT AREAS
       COPY OVRPFDATA IN COPYLIB.

       COPY CCHKOBJ   IN COPYLIB.

       01  PRINT-LINE                 PIC X(132)  VALUE SPACES.

       01  HEAD1 REDEFINES PRINT-LINE.
           05  FILLER                 PIC X(23).
           05  HEAD1-TITLE1           PIC X(38).
           05  HEAD1-TITLE2           PIC X(48).
           05  FILLER                 PIC X(23).

       01  HEAD2 REDEFINES PRINT-LINE.
           05  FILLER                 PIC X(1).
           05  HEAD2-DATE             PIC X(8).
           05  FILLER                 PIC X(5).
           05  HEAD2-TIME             PIC X(8).
           05  FILLER                  PIC X(98).
           05  HEAD2-PAGE              PIC X(5).
           05  HEAD2-PAGE-NO           PIC Z,ZZ9.
           05  FILLER                  PIC X(2).

       01  HEAD3 REDEFINES PRINT-LINE.
           05  FILLER                  PIC X(46).
           05  HEAD3-TITLE             PIC X(33).
           05  HEAD3-PLANT             PIC X(3).
           05  FILLER                  PIC X(50).

       01  RANGE1-TITLE REDEFINES PRINT-LINE.
           05  FILLER                  PIC X(57).
           05  RANGE1                  PIC X(11).
           05  FILLER                  PIC X(64).

       01  RANGE2-TITLE REDEFINES PRINT-LINE.
           05  FILLER                  PIC X(10).
           05  RANGE2-RANGE            PIC X(8).
           05  RANGE2-LOW              PIC X(50).
           05  RANGE2-TO               PIC X(4).
           05  RANGE2-HIGH             PIC X(50).
           05  FILLER                  PIC X(10).

       01  HEAD4 REDEFINES PRINT-LINE.
           05  FILLER                  PIC X(20).
           05  HEAD4-MANUFACTURER      PIC X(26).
           05  FILLER                  PIC X(40).
           05  HEAD4-MANUFACTURER2     PIC X(26).
           05  FILLER                  PIC X(20).

       01  LINE1 REDEFINES PRINT-LINE.
           05  FILLER                  PIC X(20).
           05  LINE1-MANUFACTURER      PIC X(26).
           05  FILLER                  PIC X(40).
           05  LINE1-MANUFACTURER2     PIC X(26).
           05  FILLER                  PIC X(20).
      *------------- DATABASE AREA
       COPY DATAB IN COPYLIB.

       01  DSET-NAME-AREA.
           05  DSET-NAME               PIC X(16)  VALUE SPACES.
           05  DSET-MMANUFAC           PIC X(16)  VALUE "MMANUFACT;".
           05  DSET-MPLTINFO           PIC X(16)  VALUE "MPLTINFO;".

       01  DATABASE-ARGS.
           05  MMANUFAC-ARG            PIC X(26)  VALUE SPACES.
           05  DUMMY-ARG               PIC X(50)  VALUE SPACES.
           05  PLT-ARG                 PIC X(4)   VALUE "P 01".

       01  SEARCH-ITEMS.
           05  ALL-ITEM-LIST           PIC X(2)   VALUE "@;".

      *------------- DATABASE BUFFERS
       COPY MMANUFAC IN COPYLIB.
       COPY MPLTINFO IN COPYLIB.
       LINKAGE SECTION.
       COPY THDPRTB IN COPYLIB.
       01  DATA-LINE.
           05  LOW-RANGE-MNF          PIC X(26).
           05  HIGH-RANGE-MNF         PIC X(26).
           05  RPT-JCW                PIC X(2).
           05  FILLER                 PIC X(58).

      *************************************************************
      *************************************************************
      *           P R O C E D U R E     D I V I S I O N           *
      *************************************************************
      *************************************************************
       PROCEDURE DIVISION USING HD-ROUTE-DATA, DATA-LINE.
       0-BEGIN-SORT SECTION.

       10-OPEN-FILES.
           MOVE "C"        TO MCXCBLERR-SCOPE.
           CALL "MCXCBLERR" USING MCXCBLERR-SCOPE.

           MOVE "TMANRPT"  TO BU-PGM-NAME.
           OPEN INPUT MPLTINFO-I, MMANUFACT-I.

      *************************************************************
      *************************************************************
      *   ACCEPT TWO LINES OF DATA: 1) ALL HEADER INFORMATION -   *
      *     WHO AND WHERE THIS REPORT WILL BE ROUTED TO  2) A     *
      *     RANGE OF MANUFACTURERS OR THE WORD "ALL"              *
      *                                                           *
      *************************************************************
      *************************************************************
       30-GET-PARAMETERS.
           DISPLAY HD-ROUTE-DATA.
           DISPLAY DATA-LINE.
           IF LOW-RANGE-MNF = "ALL"
               MOVE "A" TO ACCEPT-ALL-FLAG.

           MOVE HD-SPOOLER-NUMBER TO OVRPRTF-TOFILE-NUM.
           MOVE "*YES"            TO OVRPRTF-SHARED.
           MOVE HD-NO-OF-COPIES   TO OVRPRTF-COPIES.
           MOVE "MCPRT"           TO OVRPRTF-FILE.
           PERFORM 996-OVERRIDE-PRINT-FILE.
           OPEN OUTPUT PRINT-FILE.

           MOVE "DHDR09.PUB"   TO HD-FILE-NAME.
           CALL "THDPRT2" USING HD-RET-CODE, HD-FILE-NAME, FNUM,
               HD-ROUTE-DATA, ESC-NAME.
           IF HD-RET-CODE NOT = 0
               MOVE "THDPRT2 ERROR * MANRPT" TO BU-DISPLAY-MSG
               MOVE "HD-RET-CODE = "         TO BU-DISPLAY-FLD (1)
               MOVE HD-RET-CODE              TO BU-DISPLAY-FLD9 (1)
               GO TO 2-BLOWUP.

      *------------- GET RECORD FOR PLANT NUMBER
           MOVE PLT-ARG TO PLTINFOKEY OF MPLTINFO-I-REC.
           READ MPLTINFO-I INTO BUF-MPLTINFO
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE "READ MPLTINFO * 30-GP"  TO BU-DISPLAY-MSG
               MOVE "P 01" TO BU-DISPLAY-FLD (1)
               PERFORM 2-BLOWUP.
           MOVE MPLTINFO-COMPANY TO PLANT-NUMBER.

           CALL "TESCSEQ" USING ESC-NAME.
           MOVE CHAR-1636PI     TO COMPRESS-PRINT.
           MOVE CHAR-10PI       TO NORMAL-PRINT.
           MOVE TEXT-LENGTH-61  TO ESC-TEXT-61.

       60-MAIN.
           SORT SORT-FILE
               ON ASCENDING KEY SORT-MNF
               INPUT  PROCEDURE IS 8-INPUT-RECORDS
               OUTPUT PROCEDURE IS 9-WRITE-RECORDS.

           WRITE PRINT-REC FROM ESC-TEXT-61  AFTER ADVANCING 0.
           WRITE PRINT-REC FROM NORMAL-PRINT AFTER ADVANCING 0.
           CLOSE PRINT-FILE.
           CLOSE MPLTINFO-I, MMANUFACT-I.

           GOBACK.

      *************************************************************
      *                    BLOWUP   ROUTINE                       *
      *************************************************************
       2-BLOWUP.
           CALL "TBLOWUP" USING BASE, BU-PGM-NAME, STATUS-AREA,
                 VIEW-COMAREA, FILE-STATUS, BU-DISPLAY-MSG,
                 BU-DISPLAY-AREA.

       8-INPUT-RECORDS SECTION.
           PERFORM 81-PROCESS-INPUT-RECORDS THRU 81-PIR-EXIT
               UNTIL ALL-INPUT-RECORDS-PROCESSED.
           GO TO 89-EXIT.

       81-PROCESS-INPUT-RECORDS.
           READ MMANUFACT-I NEXT INTO BUF-MMANUFACT
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "1"
                   MOVE "Y" TO END-OF-INPUT-FILE
                   GO TO 81-PIR-EXIT
               ELSE
                   MOVE "DBGET MMANUFACT AT 81-P-I-R"
                       TO BU-DISPLAY-MSG
                   PERFORM 2-BLOWUP.

           IF ALL-ITEMS
               GO TO 81-WRITE-MNF.

           IF MANUFACT-MAN-NAME  < LOW-RANGE-MNF
               GO TO 81-PROCESS-INPUT-RECORDS.

           IF MANUFACT-MAN-NAME > HIGH-RANGE-MNF
               GO TO 81-PROCESS-INPUT-RECORDS.

       81-WRITE-MNF.
            MOVE MANUFACT-MAN-NAME TO SORT-MNF.
            RELEASE SORT-RECORD.
            GO TO 81-PROCESS-INPUT-RECORDS.

       81-PIR-EXIT.
           EXIT.


      *************************************************************
      *                    BLOWUP   ROUTINE                       *
      *************************************************************
       82-BLOWUP.
           CALL "TBLOWUP" USING BASE, BU-PGM-NAME, STATUS-AREA,
                 VIEW-COMAREA, FILE-STATUS, BU-DISPLAY-MSG,
                 BU-DISPLAY-AREA.

       89-EXIT.
           EXIT.

       9-WRITE-RECORDS SECTION.
           IF PAPER-IS-132-COLS
               NEXT SENTENCE
           ELSE
              WRITE PRINT-REC FROM COMPRESS-PRINT AFTER ADVANCING 0.
              WRITE PRINT-REC FROM ESC-TEXT-61    AFTER ADVANCING 0.

           PERFORM 94-NEW-PAGE.
           RETURN SORT-FILE AT END
               MOVE "Y"               TO END-OF-SORT-FILE
               MOVE NO-SORTED-RECORDS TO PRINT-REC
               WRITE PRINT-REC AFTER ADVANCING 1 LINES
               GO TO 99-EXIT.
           PERFORM 91-PROCESS-SORTED-RECORDS THRU 91-PSR-EXIT
               UNTIL ALL-SORTED-RECORDS-PROCESSED.
           GO TO 99-EXIT.

       91-PROCESS-SORTED-RECORDS.
           MOVE  1     TO TBL-INDEX.
           MOVE SPACES TO TBL-WS.
           PERFORM 92-FILL-TABLE UNTIL TBL-INDEX > 100  OR
                  ALL-SORTED-RECORDS-PROCESSED.
           IF TBL-INDEX > 50
               DIVIDE TBL-INDEX BY 2 GIVING TBL-HALF
               MOVE  1 TO TBL-INDEX
               COMPUTE TBL-INDEX2 = TBL-HALF + 1
               PERFORM 93-WRITE-TABLE UNTIL TBL-INDEX > TBL-HALF
           ELSE
               MOVE TBL-INDEX TO TBL-INDEX2
               MOVE  1        TO TBL-INDEX
               PERFORM 931-WRITE-TABLE UNTIL TBL-INDEX > TBL-INDEX2.

           IF NOT ALL-SORTED-RECORDS-PROCESSED
               PERFORM 94-NEW-PAGE.


       91-PSR-EXIT.
           EXIT.

       92-FILL-TABLE.
           MOVE SORT-MNF  TO TBL-MNF (TBL-INDEX).
           RETURN SORT-FILE AT END
              MOVE "Y" TO END-OF-SORT-FILE.
           ADD 1 TO TBL-INDEX.

       93-WRITE-TABLE.
           MOVE TBL-MNF (TBL-INDEX)   TO LINE1-MANUFACTURER.
           MOVE TBL-MNF (TBL-INDEX2)  TO LINE1-MANUFACTURER2.
           WRITE PRINT-REC FROM LINE1 AFTER ADVANCING 1 LINES.
           ADD  1 TO TBL-INDEX, TBL-INDEX2.

       931-WRITE-TABLE.
           MOVE TBL-MNF (TBL-INDEX)   TO LINE1-MANUFACTURER.
           MOVE SPACES                TO LINE1-MANUFACTURER2.
           WRITE PRINT-REC FROM LINE1 AFTER ADVANCING 1 LINES.
           ADD  1 TO TBL-INDEX.

       94-NEW-PAGE.
           MOVE SPACES                TO PRINT-LINE.
           ADD 1                      TO PAGE-NUM.
           MOVE "G O O D Y E A R   C O R P O R A T E   "
                                      TO HEAD1-TITLE1.
           MOVE "S T O R E S  I N F O R M A T I O N   S Y S T E M"
                                      TO HEAD1-TITLE2.
           WRITE PRINT-REC FROM PRINT-LINE AFTER ADVANCING NEW-PAGE.
           MOVE SPACES                TO PRINT-LINE.

           MOVE 1                     TO DATE-MODE.
           CALL "TDATECHK" USING DATE-CHECK-AREA.
           MOVE DATE-FORMATTED-TIME-OUT TO HEAD2-TIME.
           MOVE DATE-SLASH-OUT        TO HEAD2-DATE.
           MOVE "PAGE "               TO HEAD2-PAGE.
           MOVE PAGE-NUM              TO HEAD2-PAGE-NO.
           WRITE PRINT-REC FROM PRINT-LINE AFTER ADVANCING 1 LINES.
           MOVE SPACES                TO PRINT-LINE.
           MOVE "VALID MANUFACTURER NAMES - PLANT "
                                      TO HEAD3-TITLE.
           MOVE PLANT-NUMBER          TO HEAD3-PLANT.
           WRITE PRINT-REC FROM PRINT-LINE AFTER ADVANCING 1 LINES.
           MOVE SPACES                 TO PRINT-LINE.
           IF ALL-ITEMS
               MOVE "RANGE:  ALL"      TO RANGE1
           ELSE
               MOVE "RANGE:  "         TO RANGE2-RANGE
               MOVE " TO "             TO RANGE2-TO
               MOVE LOW-RANGE-MNF      TO RANGE2-LOW
               MOVE HIGH-RANGE-MNF     TO RANGE2-HIGH.
           WRITE PRINT-REC FROM PRINT-LINE AFTER ADVANCING 2 LINES.
           MOVE SPACES                 TO PRINT-LINE.
           MOVE "MANUFACTURER"         TO HEAD4-MANUFACTURER,
           MOVE "MANUFACTURER"         TO HEAD4-MANUFACTURER2,
           WRITE PRINT-REC FROM PRINT-LINE AFTER ADVANCING 1 LINES.
           MOVE SPACES                 TO PRINT-LINE.
           WRITE PRINT-REC FROM PRINT-LINE AFTER ADVANCING 2 LINES.

       99-EXIT.
           EXIT.

        COPY OVRPFCALL IN COPYLIB.

