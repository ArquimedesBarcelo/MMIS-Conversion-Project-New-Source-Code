       IDENTIFICATION DIVISION.
       PROGRAM-ID.           TCSOPRCV.
       AUTHOR.               AM TREUDLER.
       INSTALLATION.         GOODYEAR TIRE AND RUBBER CO.
       DATE-WRITTEN.         FEB 1, 1988.
      *REMARKS.
      ***************************************************************
      **                                                           **
      *D          T C S O P R C V                                  **
      **                                                           **
      *D   THIS PROGRAM READS THROUGH THE DETAIL DATASET - DTRANS  **
      *D   AND FINDS ALL OPEN RECEIVERS (DCHG AND REC TRANSACTIONS **
      *D   WHERE BALANCE QUANTITY IS GREATER THANT ZERO).          **
      **                                                           **
      ***************************************************************
      *C
      *C   07FEB1994    DAVE PLUM
      *C     ADDED CALL TO THE COBOL ERROR HANDLER - MCXCBLERR.
      *C
      *C   31MAY1994    DAVE PLUM
      *C     ADDED A MOVE STATEMENT TO CAUSE THE PROGRAM NAME TO BE PASSED
      *C     TO TBLOWUP.
      *C
      *C   28AUG1995    CATHY YODER
      *C     ADDED OPTION TO LIST AND SUBTOTAL BY DEPARTMENT AND ACCOUNT
      *C     ON THE REPORT.  (REQUEST FROM NAPANEE.)  ALSO CHANGED THE
      *C     WAY THE LINES ARE PRINTED ON THE REPORT.  INSTEAD OF USING
      *C     ONE PRINT-LINE AND MANY REDEFINES LINES, WHERE POSSIBLE,
      *C     VALUE STATEMENTS WERE USED INSTEAD OF MANY MOVE STATEMENTS.
      *C     THIS MADE THE PRINTING OF 2 CONSECUTIVE BREAK TOTALS EASIER.
      *C
      *C   04OCT1995    DAVE PLUM
      *C     REVISED THE CALL TO PROGRAM TBLOWUP TO PASS THE FILE-STATUS
      *C     FIELD INSTEAD OF USING THE DUMMY-KSAM-STAT FIELD.
      *C
      *C   11SEP1996    DAVE PLUM
      *C     REVISED FOR CENTURY DATABASE CHANGES.
      *C
       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.
       SOURCE-COMPUTER.      HP-3000.
       OBJECT-COMPUTER.      HP-3000.
       SPECIAL-NAMES.        C01 IS NEW-PAGE.

       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT PRINT-FILE   ASSIGN TO PRINTER-MCPRT.

           SELECT SORT-FILE    ASSIGN TO DISK-SORT.

           SELECT MATLACUM-O
                  ASSIGN TO DATABASE-MCFLCA0601
                  ORGANIZATION IS INDEXED
                    ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                  FILE STATUS IS FILE-STATUS.

           SELECT MATLACUM-I
                  ASSIGN TO DATABASE-MCFLCA0601
                  ORGANIZATION IS INDEXED
                    ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                  FILE STATUS IS FILE-STATUS.

           SELECT MACCTINFO-I
                  ASSIGN TO DATABASE-MCFLCA0101
                  ORGANIZATION IS INDEXED
                    ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                  FILE STATUS IS FILE-STATUS.

           SELECT MCHTACCTS-I
                  ASSIGN TO DATABASE-MCFLCA0301
                  ORGANIZATION IS INDEXED
                    ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                  FILE STATUS IS FILE-STATUS.

           SELECT DTRANS-I
                  ASSIGN TO DATABASE-MCFLCA0701
                  ORGANIZATION IS INDEXED
                    ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                    WITH DUPLICATES
                  FILE STATUS IS FILE-STATUS.

           SELECT MSTORERM-I
                  ASSIGN TO DATABASE-MCFLCS0201
                  ORGANIZATION IS INDEXED
                    ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                  FILE STATUS IS FILE-STATUS.

       DATA DIVISION.
       FILE SECTION.

       FD  PRINT-FILE
           DATA RECORD IS PRT-REC
           RECORD CONTAINS 133 CHARACTERS
           LABEL RECORDS ARE OMITTED.
       01  PRT-REC                       PIC X(133).

       SD  SORT-FILE
           DATA RECORD IS SORT-REC
           RECORD CONTAINS  87 CHARACTERS.
       01  SORT-REC.
           05  SORT-CLASS                PIC X(4).
           05  SORT-DEPT                 PIC X(6).
           05  SORT-ACCT                 PIC X(6).
           05  SORT-PO-NUM               PIC X(10).
           05  SORT-RCVR-NUM             PIC X(4).
           05  SORT-ITEM-NUM             PIC X(4).
           05  SORT-TRAN-CODE            PIC X(4).
           05  SORT-OP-RCV-AMT           PIC S9(12).
           05  SORT-CORP-CODE            PIC X(7).
           05  SORT-QTY                  PIC S9(10).
           05  SORT-UM                   PIC XX.
           05  SORT-BAL-QTY              PIC S9(10).
      *******05  SORT-DATE                 PIC X(6).
           05  SORT-DATE.
               10  SORT-DATE-CC          PIC X(2).
               10  SORT-DATE-YYMMDD      PIC X(6).

       FD  MATLACUM-O
           LABEL RECORDS ARE STANDARD.
       01  MATLACUM-REC-O.
           COPY DDS-ALL-FORMATS OF MCFLCA0601.

       FD  MATLACUM-I
           LABEL RECORDS ARE STANDARD.
       01  MATLACUM-REC-I.
           COPY DDS-ALL-FORMATS OF MCFLCA0601.

       FD  MACCTINFO-I
           LABEL RECORDS ARE STANDARD.
       01  MACCTINFO-REC-I.
           COPY DDS-ALL-FORMATS OF MCFLCA0101.

       FD  MCHTACCTS-I
           LABEL RECORDS ARE STANDARD.
       01  MCHTACCTS-REC-I.
           COPY DDS-ALL-FORMATS OF MCFLCA0301.

       FD  DTRANS-I
           LABEL RECORDS ARE STANDARD.
       01  DTRANS-REC-I.
           COPY DDS-ALL-FORMATS OF MCFLCA0701.

       FD  MSTORERM-I
           LABEL RECORDS ARE STANDARD.
       01  MSTORERM-REC-I.
           COPY DDS-ALL-FORMATS OF MCFLCS0201.

