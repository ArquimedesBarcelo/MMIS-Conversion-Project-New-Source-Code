010600
010700 PROCEDURE DIVISION USING          BASE,
010800                                   VIEW-COMAREA,
010900                                   LANGUAGE-PARMS.
011000
011100 1000-START.
           PERFORM 9999-OPEN-STUFF.
011200     PERFORM 6000-MAIN THRU 6990-MAIN-X.
           PERFORM 9999-CLOSE-STUFF.
011300     GOBACK.
011400
011500 2100-BLOWUP.
011600     MOVE "SPCSMULS"               TO   BU-PGM-NAME.
011700     CALL "TBLOWUP" USING BASE BU-PGM-NAME STATUS-AREA
011800       VIEW-COMAREA FILE-STATUS BU-DISPLAY-MSG
011900       BU-DISPLAY-FLDS.
012000
012100 6000-MAIN.
012200     MOVE "MULTSTR"                TO   VIEW-NFNAME.
           PERFORM 9951-GETNEXTFORM.
012700
012800     MOVE SPACES                   TO   DE-FIELDS.
012900     MOVE "ST"                     TO   MPLTINFO-STR-ARG-STR.
013000     PERFORM 9999-DBGET7-MPLTINFO-PK-O.
013100     IF NO-ENTRY
013200         MOVE "N"                  TO   DE-MULT-STR-PLANT
013300         MOVE SPACES               TO   MPLTINFO-ST
013400         MOVE "STST"               TO   MPLTINFO-KEY
013500         MOVE "00"                 TO   MPLTINFO-STR-PRT
013600         MOVE "N"                  TO   MPLT-ALWAYS-MULT-STR-CODE
013700         MOVE "N"                  TO   MPLT-MULT-STR-FLAG
013800         MOVE "Y"                  TO   MPLT-WO-OVERRD-ENTRY
013900         MOVE "Y"                  TO   MPLT-WO-OVERRD-EXP
014000         MOVE "N"                  TO   MPLT-ENTRY-OVERRD-EXP
014100         PERFORM 9930-LOCK
014200         PERFORM 9999-DBPUT-MPLTINFO-PK-O
014300         PERFORM 9940-UNLOCK
014400     ELSE
014500     IF GOOD-CALL
014600         MOVE MPLT-MULT-STR-FLAG   TO   DE-MULT-STR-PLANT
014700         PERFORM 7010-MOVE-ALWAYS-TO-SCRN.
015000
015600
015700 6100-SHOWFORM-1.
           PERFORM 9953-PUTBUFFER.
015800     MOVE 7                        TO   SRF-KEYSET.
           PERFORM 998-WRITE-SCREEN THRU 9989-WS-X.
           IF MESSAGE-BUFFER-1 NOT = SPACES
               PERFORM 9954-SETERROR
               GO TO 6100-SHOWFORM-1.
016500     IF VIEW-LASTKEY = 8
016600         GO TO 6990-MAIN-X.
016700
           PERFORM 9952-GETBUFFER.
017300
017400     PERFORM 9930-LOCK.
017500     PERFORM 9999-DBGET7-MPLTINFO-PK-O.
      *--------- CORRECTED LOGIC.
      *****IF DE-MULT-STR-PLANT NOT = "Y" OR "N"
           IF DE-MULT-STR-PLANT NOT = "Y" AND
              DE-MULT-STR-PLANT NOT = "N"
               MOVE "N"                  TO   MPLT-MULT-STR-FLAG
           ELSE
017600         MOVE DE-MULT-STR-PLANT    TO   MPLT-MULT-STR-FLAG.
017700     PERFORM 7000-MOVE-ALWAYS-MULT-STR.
017800     PERFORM 9999-DBUPDATE-MPLTINFO-PK-O.
           PERFORM 9940-UNLOCK.
017900
019900
020000 6990-MAIN-X.
020100     EXIT.
020200
020300******************************************************************
020400**                                                              **
020500**       P E R F O R M E D   R O U T I N E S                    **
020600**                                                              **
020700******************************************************************
020800 7000-MOVE-ALWAYS-MULT-STR.
020900*------ THE 'ALWAYS MULTIPLE STOREROOM CODE FLAG' IS PHRASED
021000*------ DIFFERENTLY FOR EASIER UNDERSTANDING BY THE USER.
021100*------ THE FLAG ANSWERS THE QUESTION OF WHETHER A CODE IS ALWAYS
021200*------ CONSIDERED MULTIPLE STOREROOM.  IF 'Y', AND IF NO BIN
021300*------ LOCATIONS HAVE THE PREFIX, (A-, B-, ETC), THEN NO QTY CAN
021400*------ BE WITHDRAWN. BUT IF 'N', THEN IT WILL DEFAULT TO STOREROOM 1.
021500*------ FOR THE USER, THE QUESTION HAS BEEN REVERSED, TO 'IF A CODE
021600*------ HAS NO BIN PREFIXES, IS IT CONSIDERED A SINGLE STOREROOM?'
021700     IF DE-SINGLE-STR-CODE = "Y"
021800         MOVE "N" TO MPLT-ALWAYS-MULT-STR-CODE
021900     ELSE
022000         MOVE "Y" TO   MPLT-ALWAYS-MULT-STR-CODE.
022100
022200 7010-MOVE-ALWAYS-TO-SCRN.
022300     IF MPLT-ALWAYS-MULT-STR-CODE = "Y"
022400         MOVE "N"                  TO   DE-SINGLE-STR-CODE
022500     ELSE
022600         MOVE "Y"                  TO   DE-SINGLE-STR-CODE.
022700
       COPY DISPCALL IN COPYLIB.
      *COPY DISPCAL2 IN COPYLIB. <---- DOES NOT COMPILE WITH COPYLIB
           IF SRF-KEYSET = 1 OR 3 OR 5 OR 7
               MOVE "I" TO SRF-FKEY (7).
           IF SRF-KEYSET > 0
               MOVE "I" TO SRF-FKEY (5).
           IF SRF-KEYSET = 1 OR 2 OR 5 OR 6 OR 7 OR 8
               MOVE "I" TO SRF-FKEY (4).
           IF SRF-KEYSET = 5 OR 6
               MOVE "I" TO SRF-FKEY (8), SRF-FKEY (6)
           ELSE
           IF SRF-KEYSET = 7 OR 8
               MOVE "I" TO SRF-FKEY (1), SRF-FKEY (2), SRF-FKEY (8).
           MOVE SPACES TO MESSAGE-BUFFER-1.
           IF VIEW-LASTKEY = 00
               IF SRF-ENTER-FLAG = "I"
      *            "E28: 'ENTER' NOT VALID HERE"
                   MOVE 5 TO LANG-SETNUM
                   MOVE 28 TO LANG-MSGNUM
                   MOVE 1 TO FIELD-NUMBER, SRF-ERROR-FLD
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               ELSE
                   NEXT SENTENCE
               END-IF
           ELSE
           IF SRF-FKEY (VIEW-LASTKEY) = "I"
      *        "I10: INVALID FUNCTION KEY"
               MOVE 9 TO LANG-SETNUM
               MOVE 10 TO LANG-MSGNUM
               MOVE 1 TO FIELD-NUMBER, SRF-ERROR-FLD
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
           IF MESSAGE-BUFFER-1 = SPACES
               MOVE SPACES TO SRF-FKEY-AREA, SRF-ENTER-FLAG.
       9989-WS-X.
           EXIT.
       COPY HCATREAD IN COPYLIB.

       9930-LOCK.
       9940-UNLOCK.
       9951-GETNEXTFORM.
       9952-GETBUFFER.
           MOVE DISPLAY-REC TO DE-FIELDS.

       9953-PUTBUFFER.
           MOVE DE-FIELDS TO DISPLAY-REC.

       9954-SETERROR.
           MOVE B"1" TO IND (99).
           MOVE B"1" TO IND (FIELD-NUMBER).
           MOVE MESSAGE-BUFFER TO DE-MESSAGE-LINE.

       9955-CLEAR-FORM.
           MOVE SPACES TO DE-FIELDS, MESSAGE-BUFFER.

       9956-PUTWINDOW.
       9957-FIELDEDITS.
       9958-INITFORM.
       9959-SHOWFORM.
       9960-SETKEYLABEL.
       9961-AUTOREAD.
       9962-OPENFORM.
       9963-CLOSEFORM.
       9964-FINISHFORM.

       9999-DBGET2-MPLTINFO-PK-O.
           MOVE 0 TO COND-WORD.
           READ MPLTINFO-PK-O NEXT INTO BUF-MPLTINFO
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS-1 = "1" OR FILE-STATUS = "46"
               MOVE 11 TO COND-WORD
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE "DBGET2 ERR 9999-DBGET2-MPLTINFO-PK-O"
                   TO BU-MSG-AREA
               MOVE 99 TO COND-WORD
               PERFORM 2100-BLOWUP.

       9999-DBPUT-MPLTINFO-PK-O.
           MOVE 0 TO COND-WORD.
           WRITE MPLTINFO-PK-REC-O FROM BUF-MPLTINFO
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS = "22"
               MOVE 43 TO COND-WORD
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE "DBPUT ERR 9999-DBPUT-MPLTINFO-PK-O"
                   TO BU-MSG-AREA
               MOVE 99 TO COND-WORD
               PERFORM 2100-BLOWUP.

       9999-DBGET7-MPLTINFO-PK-O.
           MOVE 0 TO COND-WORD.
           MOVE PLT-ARG TO PLTINFOKEY OF MPLTINFO-PK-REC-O.
           READ MPLTINFO-PK-O INTO BUF-MPLTINFO
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS = "23"
               MOVE 17 TO COND-WORD
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE "DBGET7 ERR 9999-DBGET7-MPLTINFO-PK-O"
                   TO BU-MSG-AREA
               MOVE 99 TO COND-WORD
               PERFORM 2100-BLOWUP.

       9999-RESET-MPLTINFO-PK-O.
           MOVE HIGH-VALUES TO PLTINFOKEY OF MPLTINFO-PK-REC-O.
           START MPLTINFO-PK-O KEY > PLTINFOKEY OF MPLTINFO-PK-REC-O
               INVALID KEY MOVE "00" TO FILE-STATUS.

       9999-DBUPDATE-MPLTINFO-PK-O.
           MOVE 0 TO COND-WORD.
           REWRITE MPLTINFO-PK-REC-O FROM BUF-MPLTINFO
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE "DBUPDATE ERR 9999-DBUPDATE-MPLTINFO-PK-O"
                   TO BU-MSG-AREA
               MOVE 99 TO COND-WORD
               PERFORM 2100-BLOWUP.

       9999-DBDELETE-MPLTINFO-PK-O.
           MOVE 0 TO COND-WORD.
           DELETE MPLTINFO-PK-O
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE "DBDELETE ERR 9999-DBDELETE-MPLTINFO-PK-O"
                   TO BU-MSG-AREA
               MOVE 99 TO COND-WORD
               PERFORM 2100-BLOWUP.

       9999-INIT-MPLTINFO-PK-O.
           MOVE SPACES TO PLTINFOKEY OF MPLTINFO-PK-REC-O.
           START MPLTINFO-PK-O KEY >= PLTINFOKEY OF MPLTINFO-PK-REC-O
               INVALID KEY MOVE "00" TO FILE-STATUS.

       9999-OPEN-STUFF.
           OPEN I-O DISPLAY-FILE.
           OPEN I-O   MPLTINFO-PK-O                              .

       9999-CLOSE-STUFF.
           CLOSE DISPLAY-FILE.
           CLOSE      MPLTINFO-PK-O                              .
