               NEXT SENTENCE
           ELSE
           GO TO FIND-V.
       FV-EXIT.    EXIT.

194800 SPACE-PLD.
194900     MOVE SPACES TO PLD (S1).
195000
195100 SPACE-SELECT.
195200     MOVE SPACE TO P-SELECT (S3).
195300
195500 SHOW-MATL1.
           MOVE SAVE-REC-NO (S3) TO PFKEY.
           PERFORM 69-READ-PRTPLAN-BANK-PF.
195900     IF COND-WORD NOT = 0 PERFORM 998-BLOWUP.
196300
196400     MOVE SPACES              TO  MATL-DATA.
196500     MOVE P-ITEM (S3)         TO  ITEM-NO-WA.
196600     MOVE PRT-STATUS2         TO  PRT-STATUS-WA.
196700     MOVE PRT-EST-QTY-92      TO  PRT-QUANT-WA-9.
196800     MOVE PRT-NUM2            TO  PRT-CODE-WA.
196900     MOVE PRT-UNIT-MEAS2      TO  PRT-UNIT-MEAS-WA.
197000     MOVE P-UNIT-COST2        TO  PRT-UP-WA-9.
197100     MOVE PRT-PRIME-1-32      TO  PRIME-WA.
197200     MOVE PRT-SUB-1-32        TO  SUB-WA.
197300     MOVE PRT-STAGE2          TO  STAGE-WA.
197400     MOVE PRT-ORIGINATOR2     TO  ORIG-WA.
197500     MOVE PRT-ADDL-INFO2      TO  ADDL-INFO-WA.
197600     MOVE PRT-SUGG-VENDOR2    TO  SUGG-VENDOR-WA.
197700     MOVE PRT-DESC2           TO  P-D-WA-80 (1).
197800     MOVE PRT-DESC-22         TO  P-D-WA-80 (2).
197900     MOVE PRT-DESC-32         TO  P-D-WA-80 (3).
198000     MOVE PRT-DESC-42         TO  P-D-WA-80 (4).
198100     MOVE PRT-DESC-52         TO  P-D-WA-80 (5).
198200     MOVE PRT-REMARKS2        TO  REMARKS-1-WA.
198300     MOVE PRT-REMARKS-22      TO  REMARKS-2-WA.
198400
198500     MOVE "FMODMLS2" TO VIEW-CFNAME.
           MOVE MATL-WORKAREA TO DSPLY-REC.
199100     PERFORM 99-SCREEN-WRITE.
199300
199500 READ-MATL1.
199600     PERFORM 98-SCREEN-READ.
201800     IF VIEW-LASTKEY = 3
201900         MOVE 0 TO VIEW-LASTKEY
               PERFORM 69-REWRITE-PRTPLAN-BANK-PF
202000     ELSE
           PERFORM 99-SCREEN-WRITE
202200     GO TO READ-MATL1.
202300
202500 626-SET-UPDATE-ITEM.
202600     IF PRT-STATUS-1 = PRT-STATUS-1-WA
202700         MOVE "Y" TO UPDATE-ITEM
202800     ELSE
202900     MOVE "N" TO UPDATE-ITEM.
203000
203200 627-SAVE-REQUIRED-DATA.
203300     MOVE SPACES TO PRTPLAN-BANK-DATA.
203400     MOVE MPRTPLAN-NAME TO MPRTNAME.
203500     MOVE PRT-STATUS-WA TO PRT-STATUS.
203600     MOVE PRT-QUANT-WA-9 TO PRT-EST-QTY-9.
203700     MOVE PRT-CODE-WA TO PRT-NUM.
203800     MOVE PRT-UNIT-MEAS-WA TO PRT-UNIT-MEAS.
203900     MOVE PRT-UP-WA-9 TO COST-WA.
204000     MOVE COST-DOLS TO PRT-UNIT-COST-DOLLR.
204100     MOVE COST-CENTS TO UC-WA-CENTS-1-2.
204200     MOVE 00 TO UC-WA-CENTS-3-4.
204300     MOVE UC-WA-C-94 TO PRT-UNIT-COST-CENTS.
204400     MULTIPLY PRT-QUANT-WA-9 BY PRT-UP-WA-9 GIVING P-EST-COST.
204500     MOVE PRIME-WA TO PRT-PRIME-1-3.
204600     MOVE SUB-WA TO PRT-SUB-1-3.
204700     MOVE STAGE-WA TO PRT-STAGE.
204800     MOVE ORIG-WA TO PRT-ORIGINATOR.
204900     MOVE ADDL-INFO-WA TO PRT-ADDL-INFO.
205000     MOVE SUGG-VENDOR-WA TO PRT-SUGG-VENDOR.
205100     MOVE P-D-WA-80 (1) TO PRT-DESC.
205200     MOVE P-D-WA-80 (2) TO PRT-DESC-2.
205300     MOVE P-D-WA-80 (3) TO PRT-DESC-3.
205400     MOVE P-D-WA-80 (4) TO PRT-DESC-4.
205500     MOVE P-D-WA-80 (5) TO PRT-DESC-5.
205600     MOVE REMARKS-1-WA TO PRT-REMARKS.
205700     MOVE REMARKS-2-WA TO PRT-REMARKS-2.
205800
206000 628-UPDATE-ITEM.
206200     IF UPDATE-ITEM = "Y"
               PERFORM 69-UPDATE-PRTPLAN-BANK
206600         IF COND-WORD NOT = 0
206800             PERFORM 998-BLOWUP
               ELSE
               NEXT SENTENCE
           ELSE
207500     PERFORM 69-DELETE-PRTPLAN-BANK
           IF COND-WORD NOT = 0
               PERFORM 998-BLOWUP
           ELSE
207700     PERFORM 69-WRITE-PRTPLAN-BANK
207900     IF COND-WORD NOT = 0
208000         PERFORM 998-BLOWUP.

       69-READ-MPRTPLAN-FILE.
           MOVE 0 TO COND-WORD.
           READ MASTER-PRTPLAN NEXT INTO MASTER-PRTPLAN-DATA
               AT END    MOVE 15 TO COND-WORD.
           IF MPRTNAME NOT = MPRTPLAN-NAME MOVE 15 TO COND-WORD.
           IF MP-STATUS NOT = "00" MOVE 15 TO COND-WORD.

       69-START-MPRTPLAN-FILE.
           MOVE 0 TO COND-WORD.
           MOVE MPRTPLAN-NAME TO GPRTPNAME OF MPREC.
           START MASTER-PRTPLAN KEY = EXTERNALLY-DESCRIBED-KEY
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF MP-STATUS NOT = "00" MOVE 17 TO COND-WORD.

       69-READ-MSTORERM.
           MOVE 0 TO COND-WORD.
           READ MSTORERM-FILE NEXT INTO BUF-MSTORERM
               AT END    MOVE 15 TO COND-WORD.
           IF CORPCDE OF MFREC NOT = CORP-CODE MOVE 15 TO COND-WORD.
           IF MF-STATUS NOT = "00" MOVE 15 TO COND-WORD.

       69-START-MSTORERM.
           MOVE 0 TO COND-WORD.
           MOVE PRT-CODE-WA TO CORPCDE OF MFREC.
           START MSTORERM-FILE KEY = EXTERNALLY-DESCRIBED-KEY
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF MF-STATUS NOT = "00" MOVE 17 TO COND-WORD.

       69-START-MVALIDUM.
           MOVE 0 TO COND-WORD.
           MOVE PRT-UNIT-MEAS TO VALIDUM OF MVREC.
           START MVALIDUM-FILE KEY = EXTERNALLY-DESCRIBED-KEY
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF MV-STATUS NOT = "00" MOVE 17 TO COND-WORD.

       69-START-PER-PERSONNEL.
           MOVE 0 TO COND-WORD.
           MOVE ORIG-WA TO PERCCNUM OF PFREC.
           START PERSONNEL-FILE KEY IS = EXTERNALLY-DESCRIBED-KEY
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF PF-STATUS NOT = "00" MOVE 17 TO COND-WORD.

       69-DELETE-PRTPLAN-BANK.
           MOVE 0 TO COND-WORD.
           DELETE PRTPLAN-BANK RECORD
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF PB-STATUS NOT = "00" MOVE 17 TO COND-WORD.

       69-START-PRTPLAN-BANK.
           MOVE 0 TO COND-WORD.
           MOVE MPRTPLAN-NAME TO GPRTPNAME OF PBREC.
           START PRTPLAN-BANK KEY = EXTERNALLY-DESCRIBED-KEY
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF PB-STATUS NOT = "00" MOVE 17 TO COND-WORD.

       69-READ-PRTPLAN-BANK.
           MOVE 0 TO COND-WORD.
           READ PRTPLAN-BANK NEXT INTO PRTPLAN-BANK-DATA
               AT END    MOVE 15 TO COND-WORD.
           ACCEPT IOFEEDBACK FROM I-O-FEEDBACK-AREA.
           IF MPRTNAME NOT = MPRTPLAN-NAME MOVE 15 TO COND-WORD.
           IF PB-STATUS NOT = "00" MOVE 15 TO COND-WORD.

       69-UPDATE-PRTPLAN-BANK.
           MOVE 0 TO COND-WORD.
           REWRITE PBREC FROM PRTPLAN-BANK-DATA
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF PB-STATUS NOT = "00" MOVE 17 TO COND-WORD.

       69-WRITE-PRTPLAN-BANK.
           MOVE 0 TO COND-WORD.
           WRITE PBREC FROM PRTPLAN-BANK-DATA
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF PB-STATUS NOT = "00" MOVE 17 TO COND-WORD.

       69-READ-PRTPLAN-BANK-PF.
           MOVE 0 TO COND-WORD.
           READ PRTPLAN-BANK-PF INTO PRTPLAN-BANK-DATA-2
               INVALID KEY    MOVE 15 TO COND-WORD.
           IF PBPF-STATUS NOT = "00" MOVE 15 TO COND-WORD.

       69-REWRITE-PRTPLAN-BANK-PF.
           MOVE 0 TO COND-WORD.
           REWRITE PBPFREC FROM PRTPLAN-BANK-DATA-2
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF PBPF-STATUS NOT = "00" MOVE 17 TO COND-WORD.

       98-SCREEN-READ.
           READ DISPLAY-FILE FORMAT IS VIEW-CFNAME
               INDIC IS INDICS.
           ACCEPT IOFEEDBACK FROM I-O-FEEDBACK-AREA.
           MOVE ALL B"0" TO INDICS.
           IF DSPLY-STATUS NOT = "00"
               MOVE 3 TO VIEW-LASTKEY
           ELSE
           MOVE FUNCTION-NUM TO VIEW-LASTKEY.


       98A-SCREEN-READ.
           READ DISPLAY-FILE TERMINAL IS TERMINAL-ID
               INDIC IS INDICS
                  NO DATA MOVE DSPLY-STATUS TO DSPLY-STATUS.
           MOVE ALL B"0" TO INDICS.

       99-SCREEN-WRITE.
           WRITE DSPLY-REC FORMAT IS VIEW-CFNAME
               INDIC IS INDICS.
           MOVE ALL B"0" TO INDICS.

076200 998-BLOWUP.
076300     MOVE "TMMODMAT" TO BU-PGM-NAME.
076400     CALL "TBLOWUP" USING BLOWUP-BASE BU-PGM-NAME STATUS-AREA
076500                      VIEW-COMAREA DUMMY-KSAM-STAT
076600                      BU-DISPLAY-MSG BU-DISPLAY-FLDS.

049700 999-CATREAD.
049800     MOVE SPACES TO ERROR-BUFFER.
049900     CALL "CCATREAD" USING CATREAD-PARMS.
           MOVE CATREAD-MSG-TEXT TO ERROR-BUFFER.
050800 999-CATREAD-EXIT.    EXIT.
