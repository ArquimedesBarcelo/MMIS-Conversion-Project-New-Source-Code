030100 PROCEDURE DIVISION USING DBPARAMETERS VIEW-COMAREA
030200                          LANGUAGE-PARMS MASTER-PRTPLAN-DATA.
030400
030500 START-EXECUTING.
030600     PERFORM 1-HSK.
030700     PERFORM 6-MAIN THRU 6-MAIN-EXIT UNTIL VIEW-LASTKEY = 3.
030800
030900 2-EOJ.
           CLOSE DISPLAY-FILE.
           CLOSE MASTER-PRTPLAN.
           CLOSE MSTORERM-FILE.
           CLOSE MVALIDUM-FILE.
           CLOSE PERSONNEL-FILE.
           CLOSE PRTPLAN-BANK.
           CLOSE PRTPLAN-BANK-PF.
031100     GOBACK.
031200
031400 1-HSK.
           OPEN I-O   DISPLAY-FILE.
           OPEN I-O   MASTER-PRTPLAN.
           OPEN INPUT MSTORERM-FILE.
           OPEN INPUT MVALIDUM-FILE.
           OPEN INPUT PERSONNEL-FILE.
           OPEN I-O   PRTPLAN-BANK.
           OPEN I-O   PRTPLAN-BANK-PF.
031500     CALL "TPWORD" USING PASSWORD-INFORMATION.
031900     IF PASSWORD-FLAG = "N" GO TO 2-EOJ.
032100     MOVE SPACES TO PRTPLAN-BANK-DATA MMIS-BASE BASE2.
032600     MOVE 0 TO SAVE-VIEW-LASTKEY1.
032700
032900 6-MAIN.
033000     PERFORM 61-GET-CMATL-SCREEN-UP.
033100     PERFORM 62-GET-AND-PROCESS-FUNCTION.
033300
033400 6-MAIN-EXIT.    EXIT.
033600
033800 61-GET-CMATL-SCREEN-UP.
033900     MOVE "FMODMEST" TO VIEW-CFNAME.
034600     MOVE SPACES TO MATL-WORKAREA PRT-LINE-DATA.
034700     MOVE MASTER-PRTPLAN-DATA TO MATL-WORKAREA P-HEADER-INFO.
034900     MOVE 0 TO CHAIN-CTR SMD-SW.
035000     MOVE MATL-WORKAREA TO DSPLY-REC.
           PERFORM 99-SCREEN-WRITE.
035400
035600 62-GET-AND-PROCESS-FUNCTION.
035700     IF SAVE-VIEW-LASTKEY1 = 0
035800         PERFORM 98-SCREEN-READ
037100     ELSE
037200     MOVE SAVE-VIEW-LASTKEY1 TO VIEW-LASTKEY
037300     MOVE 0 TO SAVE-VIEW-LASTKEY1.
037500     IF VIEW-LASTKEY = 3 GO TO 2-EOJ.
037700     IF VIEW-LASTKEY = 2 OR 4 OR 5 OR 8
037800         NEXT SENTENCE
037900     ELSE
038100     GO TO 62-GET-AND-PROCESS-FUNCTION.
038300     IF VIEW-LASTKEY = 2
038400         MOVE SPACES TO PRTPLAN-BANK-DATA
038700         PERFORM 621-RETRIEVE-NEXT-ITEM
038800         MOVE CHAIN-CTR TO ITEM-NO-WA
038900         PERFORM 622-ADD-ITEMS    THRU 622-AI-EXIT
               MOVE 0 TO CHAIN-CTR
039000     ELSE
039100     IF VIEW-LASTKEY = 8
039200         PERFORM 623-CHANGE-ITEMS THRU 623-CI-EXIT
039300     ELSE
039400     IF VIEW-LASTKEY = 4
039500         PERFORM 624-DELETE-ITEMS THRU 624-DI-EXIT
039600     ELSE
039700     IF VIEW-LASTKEY = 5
039800         PERFORM 625-LIST-ITEMS   THRU 625-LI-EXIT.
039900
040100 621-RETRIEVE-NEXT-ITEM.
           MOVE 0 TO COND-WORD.
           MOVE MPRTPLAN-NAME TO GPRTPNAME OF PBREC.
           START PRTPLAN-BANK KEY IS = EXTERNALLY-DESCRIBED-KEY
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF PB-STATUS NOT = "00" MOVE 17 TO COND-WORD.
040400     IF COND-WORD = 17
040500         MOVE 1 TO CHAIN-CTR
040600     ELSE
040700     PERFORM 621-RNI-LOOP UNTIL COND-WORD = 15.

       621-RNI-LOOP.
           MOVE 0 TO COND-WORD.
           READ PRTPLAN-BANK NEXT INTO PRTPLAN-BANK-DATA
               AT END    MOVE 15 TO COND-WORD.
           IF MPRTNAME NOT = MPRTPLAN-NAME MOVE 15 TO COND-WORD.
           IF PB-STATUS NOT = "00" MOVE 15 TO COND-WORD.
040900     ADD 1 TO CHAIN-CTR.
041300
041400 621-RETRIEVE-ITEM.
           MOVE 0 TO COND-WORD.
           MOVE MPRTPLAN-NAME TO GPRTPNAME OF PBREC.
           START PRTPLAN-BANK KEY IS = EXTERNALLY-DESCRIBED-KEY
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF PB-STATUS NOT = "00" MOVE 17 TO COND-WORD.
041700     IF COND-WORD = 17
041800         NEXT SENTENCE
041900     ELSE
042000     IF COND-WORD = 0
042100         PERFORM 69-READ-PRTPLAN-BANK
042300         IF COND-WORD = 0
042400             ADD 1 TO GET-SW
042500             PERFORM 621-GET-ITEM UNTIL GET-SW = IT-BYTES-9 OR
042600                 READ-SW = "N"
042700         ELSE
042800         IF COND-WORD = 15
042900             NEXT SENTENCE
043000         ELSE
043100         PERFORM 998-BLOWUP
043300     ELSE
043500     PERFORM 998-BLOWUP.
043600
043700 621-GET-ITEM.
043800     PERFORM 69-READ-PRTPLAN-BANK.
044000     IF COND-WORD = 0
044100         ADD 1 TO GET-SW
044200     ELSE
044300     IF COND-WORD = 15
044400         MOVE "N" TO READ-SW.
044800
045000 622-ADD-ITEMS.
045100     MOVE "FMODMADD" TO VIEW-CFNAME.
045800     IF SMD-SW = 1
045900         MOVE 0 TO SMD-SW
046000     ELSE
046100     MOVE SPACES TO MATL-DATA.
046300     MOVE 31019 TO CATREAD-MSG-NUMBER.
046500     PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
046600     MOVE ERROR-BUFFER TO MESSAGE-WA.
           MOVE ZEROES TO PRT-UP-WA.
046700     MOVE MATL-WORKAREA TO DSPLY-REC.
046900     PERFORM 99-SCREEN-WRITE.
047000
047200 622-READ-ADD-SCREEN.
047300     PERFORM 98-SCREEN-READ.
048400     IF VIEW-LASTKEY = 3
               MOVE 0 TO VIEW-LASTKEY
               GO TO 622-AI-EXIT.
048600     IF VIEW-LASTKEY = 4 OR 5 OR 8
048700         MOVE VIEW-LASTKEY TO SAVE-VIEW-LASTKEY1
048800         GO TO 622-AI-EXIT.
049000     IF VIEW-LASTKEY = 0
049100         NEXT SENTENCE
049200     ELSE
049400     GO TO 622-READ-ADD-SCREEN.
           MOVE DSPLY-REC TO MATL-WORKAREA.
050200     IF MATL-DATA = SPACES
050300         MOVE TRUE-VAL TO INDS (38) INDS (99)
050500         MOVE 35097 TO CATREAD-MSG-NUMBER
050700         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
050800         MOVE ERROR-BUFFER TO MATL-ERR-LINE
051000         PERFORM 99-SCREEN-WRITE
051100         GO TO 622-READ-ADD-SCREEN.
051300     IF PRT-STATUS-WA = "  "
051400         MOVE TRUE-VAL TO INDS (38) INDS (99)
051600         MOVE 42020 TO CATREAD-MSG-NUMBER
051800         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
051900         MOVE ERROR-BUFFER TO MATL-ERR-LINE
052000         PERFORM 99-SCREEN-WRITE
052200         GO TO 622-READ-ADD-SCREEN.
052300
052400     IF PRT-STATUS-1-WA = "M" OR "S" OR "X"
052500         NEXT SENTENCE
052600     ELSE
052800     MOVE 35033 TO CATREAD-MSG-NUMBER
053000     PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
053100     MOVE ERROR-BUFFER TO MATL-ERR-LINE
053200     MOVE TRUE-VAL TO INDS (99)
           PERFORM 99-SCREEN-WRITE
