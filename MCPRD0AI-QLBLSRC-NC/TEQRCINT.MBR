       IDENTIFICATION DIVISION.
       PROGRAM-ID.             TEQRCOPY.
       AUTHOR.                 P.D. RAGLOW.
       INSTALLATION.           GOODYEAR TIRE AND RUBBER CO.
       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.
       SOURCE-COMPUTER.        IBM-AS400.
       OBJECT-COMPUTER.        IBM-AS400.
      *C****************************************************************
      *C  WDR  04/25/94
      *C  DELETED ALL REFERENCES TO PORTABILITY MODE COPYLIBS
      *C****************************************************************

       COPY SPECIALN           IN COPYLIB.

       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT DISPLAY-FILE
                  ASSIGN       TO WORKSTATION-ZEQRCOPY-SI
                  ORGANIZATION IS TRANSACTION
                  ACCESS MODE  IS SEQUENTIAL
                  FILE STATUS  IS DISPLAY-STATUS
                  CONTROL-AREA IS WS-CONTROL.

       DATA DIVISION.
       FILE SECTION.
       FD  DISPLAY-FILE
           LABEL RECORDS ARE OMITTED.
       01  DISPLAY-REC        PIC X(1500).

       WORKING-STORAGE SECTION.
       77  HANDLE-BLOWUP-FLAG                PIC X   VALUE "Y".

       COPY FILESTAT           IN COPYLIB.

       COPY CATREAD            IN COPYLIB.

       COPY LANGUAGE           IN COPYLIB.

       COPY TBLOWUP            IN COPYLIB.

      *
      * SCREEN AREA
      *

       01  TERMFILENAME                  PIC X(11) VALUE "TERM;".

       01  FORMFILE.
           05  FORM-FNAME                PIC X(8)  VALUE "FEQRCOPY".
           05  FILLER                    PIC X     VALUE ".".
           05  FORM-GNAME.
               10  FORM-GNAME1           PIC X(5)  VALUE "FLANG".
               10  FORM-GNAME2           PIC X(3)  VALUE SPACES.
           05  FILLER                    PIC X(19) VALUE SPACES.

       01  MMISA                         PIC X(24) VALUE "  MMISA;".
       01  DRWFIL                        PIC X(24) VALUE "  DRWFIL;".
       01  EQPREF                        PIC X(24) VALUE "  EQPREF;".

       01  PASSWORD-MMISA                PIC X(7)  VALUE "DO-ALL;".
       01  PASSWORD-DRWFIL               PIC X(7)  VALUE "DO-ALL;".
       01  PASSWORD-EQPREF               PIC X(7)  VALUE "DO-ALL;".

       01  BASE                          PIC X(10).

       01  MODE1                         PIC S9(4) BINARY  VALUE 1.
       01  DSET-NAME                     PIC X(16) VALUE SPACES.

       01  DE-FIELDS-1  VALUE SPACES.
           05  DE-SCRN-1-OPTION          PIC X.
           05  FILLER                    PIC X.
           05  DE-SCRN-1-PRTF            PIC XX.
           05  DE-COMMAND-LINE-1         PIC X(79).

       COPY CSWITCHF           IN COPYLIB.

       COPY FUNCTDEF           IN COPYLIB.

       COPY IOFEEDBACK         IN COPYLIB.

       COPY TSHWRDFM           IN COPYLIB.

       COPY VCOMAREA           IN COPYLIB.

       COPY DISPDAT2           IN COPYLIB.

       COPY HMSGBUF            IN COPYLIB.

       COPY DBSTAT             IN COPYLIB.

       PROCEDURE DIVISION.
       MAIN-LINE-LOGIC.
           PERFORM 9999-OPEN-STUFF.
           MOVE "N" TO SRF-BASE-FLAG.
           MOVE "N" TO SRF-MPLTINFO-FLAG.
           CALL "SOPENTRM" USING VIEW-COMAREA, BU-DISPLAY-MSG.
           IF BU-DISPLAY-MSG-1 NOT = SPACES
             PERFORM 2100-BLOWUP.

           MOVE "Y"     TO CSF-FIRST-OPENFORMF-FLAG.
           CALL "CSWITCHF" USING VIEW-COMAREA, LANGUAGE-PARMS,
                           FORMFILE, CSF-PARMS, BU-DISPLAY-MSG.
           IF BU-DISPLAY-MSG NOT = SPACES
             PERFORM 2100-BLOWUP.

           MOVE "REQRCPY05"  TO VIEW-NFNAME.
           PERFORM 9999-GETNEXTFORM.
           PERFORM 9999-DO-SCREEN-1.

           PERFORM UNTIL VIEW-LASTKEY EQUAL EXIT-PROGRAM

             EVALUATE DE-SCRN-1-OPTION
               WHEN "1" THRU "2"
                 CALL "SEQTCPY" USING DE-SCRN-1-OPTION
                                      DE-SCRN-1-PRTF
                                      MMISA
                                      EQPREF
                                      DRWFIL
                                      VIEW-COMAREA
                                      LANGUAGE-PARMS
               WHEN "3" THRU "4"
                 CALL "SEQNCPY" USING DE-SCRN-1-OPTION
                                      DE-SCRN-1-PRTF
                                      MMISA
                                      EQPREF
                                      DRWFIL
                                      VIEW-COMAREA
                                      LANGUAGE-PARMS
             END-EVALUATE

             MOVE "REQRCPY05" TO VIEW-NFNAME
             PERFORM 9999-GETNEXTFORM
             PERFORM 9999-DO-SCREEN-1

           END-PERFORM.

       END-PROCESSES.
           PERFORM 9999-CLOSE-STUFF.
           GOBACK.

       2100-BLOWUP.
           MOVE "TEQRCINT"               TO   BU-PGM-NAME.
           CALL "TBLOWUP" USING BASE BU-PGM-NAME STATUS-AREA
             VIEW-COMAREA FILE-STATUS BU-DISPLAY-MSG
             BU-DISPLAY-FLDS.

       9999-OPEN-STUFF.
           OPEN I-O            DISPLAY-FILE.

       9999-CLOSE-STUFF.
           CLOSE               DISPLAY-FILE.

       COPY SCRNCALL           IN COPYLIB.
       COPY SCRNCL1            IN COPYLIB.
       COPY HCATREAD           IN COPYLIB.
