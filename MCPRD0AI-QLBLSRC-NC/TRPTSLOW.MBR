           05  PRT-ASTERICK              PIC X(1)       VALUE SPACES.
           05  PRT-SM-DATE               PIC X(8)       VALUE SPACES.
           05   FILLER                   PIC X(1)       VALUE SPACES.
           05  PRT-ACT-DATE              PIC X(8)       VALUE SPACES.
           05   FILLER                   PIC X(1)       VALUE SPACES.
           05  PRT-INIT-DATE             PIC X(8)       VALUE SPACES.
           05   FILLER                   PIC X(3)       VALUE SPACES.
           05  PRT-STR-CLASS             PIC X(3)       VALUE SPACES.
           05   FILLER                   PIC X(4)       VALUE SPACES.
           05  PRT-LAST-DEPT             PIC X(4)       VALUE SPACES.
           05  PRT-INS                   PIC X(4)       VALUE SPACES.
           05   FILLER                   PIC X(1)       VALUE SPACES.
           05  PRT-DFLT-DEPT             PIC X(6)       VALUE SPACES.
           05  PRT-SM-ONHAND             PIC Z(7)9      VALUE ZERO.
           05   FILLER                   PIC X(1)       VALUE SPACES.
           05  PRT-SM-UM                 PIC X(2)       VALUE SPACES.

       01  SM-DETAIL-1A.
           05  FILLER                    PIC X(8)       VALUE SPACES.
           05  PRT-SM-DESC2              PIC X(80)      VALUE SPACES.
           05  FILLER                    PIC X(44)      VALUE SPACES.

       01  SM-DETAIL-2.
           05   FILLER                   PIC X(6)       VALUE SPACES.
           05  PRT-LAST-VENDOR-FLAG      PIC X(01) VALUE SPACE.
           05   FILLER                   PIC X(01)      VALUE SPACE.
           05  PRT-VEND-NO               PIC X(10)      VALUE SPACES.
           05  PRT-VEN-OF-RCD            PIC X(01)      VALUE SPACES.
           05  PRT-VEN-QUOTE-FLAG        PIC X(01)  VALUE SPACES.
           05   FILLER                   PIC X(3)       VALUE SPACES.
           05  PRT-VEND-NAME             PIC X(44)      VALUE SPACES.
           05   FILLER                   PIC X(1)       VALUE SPACE.
           05  PRT-VEN-ITM-PRICE         PIC Z(10)9.99  VALUE ZERO.
           05   FILLER                   PIC X(1)       VALUE SPACES.
           05  PRT-VEN-ITM-UM            PIC X(02)      VALUE SPACES.

       01  SM-DETAIL-3.
           05   FILLER                   PIC X(102)     VALUE SPACES.
           05  PRT-BIN-LOC-DESC-3        PIC X(12)      VALUE SPACES.
           05   FILLER                   PIC X(2)       VALUE SPACES.
           05  PRT-BIN-ONHAND-3          PIC Z(7)9      VALUE ZERO.

       01  SM-DETAIL-4.
           05  FILLER              VALUE SPACE  PIC X(20).
           05  REORDER-4                 PIC Z(7)9.
           05  FILLER              VALUE SPACE  PIC X.
           05  MAX-4                     PIC Z(7)9.
           05  FILLER              VALUE SPACE  PIC X.
           05  EXPEDITE-4                PIC Z(7)9.
           05  FILLER              VALUE SPACE  PIC X.
           05  SOQ-4                     PIC Z(7)9.
           05  FILLER              VALUE SPACE  PIC X(04).
           05  MTH-FCST-4                PIC Z(7)9.
           05  FILLER              VALUE SPACE  PIC X.
           05  LAST-PO-4                 PIC X(7).
           05  FILLER              VALUE SPACE  PIC X(02).
           05  AVG-COST-4                PIC Z(10)9.99.
           05  FILLER              VALUE SPACE  PIC X.
           05  TOTAL-COST-4              PIC Z(12)9.99.

       01  GRAND-TOTAL-LINE.
           05   FILLER        PIC X(18)      VALUE "TOTAL SLOW MOVING ".
           05   FILLER        PIC X(17)      VALUE "ITEMS REPORTED : ".
           05   PRT-ITM-COUNT            PIC ZZZZ9.
           05   FILLER                   PIC X(8)       VALUE SPACES.
           05   FILLER        PIC X(11)      VALUE "GRAND TOTAL".
           05   FILLER        PIC X(12)      VALUE " OF ALL SLOW".
           05   FILLER        PIC X(10)      VALUE " MOVERS : ".
           05  PRT-GRAND-TOTAL           PIC Z(13)9.9(2) VALUE ZERO.

       01  BRK-LINE.
           05  FILLER                    PIC X(28)
                 VALUE "TOTAL SLOW MOVING ITEMS FOR ".
           05  PRT-BRK-TYPE              PIC X(12).
           05  FILLER                    PIC X(01) VALUE SPACES.
           05  PRT-SUB-DESC              PIC X(50).
           05  FILLER                    PIC X(03) VALUE " : ".
           05  PRT-ITEMS                 PIC ZZZZ9.
           05  FILLER               PIC X(14) VALUE " TOTAL COST : ".
           05  PRT-COST                  PIC Z(13)9.9(2) VALUE ZERO.

       01  DASH-LINE                     PIC X(132) VALUE ALL "-".

       01  CONT-MSG-LINE.
           05  CONT-MSG-CORP-CODE        PIC X(07).
           05   FILLER                   PIC X(40)
                VALUE " **** CODE CONTINUED FROM LAST PAGE ****".

       COPY MTLSLINK IN COPYLIB.

       PROCEDURE DIVISION.
       START-UP SECTION.
       HOUSEKEEPING.
9406CK     MOVE "C" TO SCOPE.
9406CK     CALL "MCXCBLERR" USING SCOPE.


           MOVE ZERO TO PROJECTED-ONHAND, TOTAL-COST, OVERAGE-COST,
                        OVERAGE, GRAND-TOTAL, SUB-TOTAL-COST,
                        SUB-TOTAL-ITEMS, LINE-CTR, PG-CTR,
                        ITEM-COUNT.
      *-------- ACCEPT ROUTING INFO FROM THE JOB, AGAIN CREATED BY
      *-------- THE OPTION PROGRAM.
           DISPLAY "ENTER ROUTING INFORMATION CARD".
           ACCEPT HD-ROUTE-DATA.
           DISPLAY "ROUTING INFORMATION ENTERED WAS:".
           DISPLAY HD-ROUTE-DATA.

      *---------- GET THE OPTION CARD CREATED BY THE OPTION PROGRAM

           DISPLAY "ENTER OPTION INFORMATION".
           ACCEPT MTLS-DATA-LINE-1.
           ACCEPT MTLS-DATA-LINE-1B.
           ACCEPT MTLS-DATA-LINE-2.
           ACCEPT MTLS-DATA-LINE-3.
      *    ACCEPT R29-REC.
      *
      * MOVE ZEROES TO NUMERIC DATA ITEMS CONTAINING NON-NUMERIC DATA
      * SCREENS ON AS/400 DO NO EDITING
      *
      *    IF R29-MIN-SLOW-X NOT NUMERIC
      *      MOVE ZERO TO R29-MIN-SLOW.
      *    IF R29-MIN-OBS-X NOT NUMERIC
      *      MOVE ZERO TO R29-MIN-OBS.
      *    IF R29-MIN-OV-X NOT NUMERIC
      *      MOVE ZERO TO R29-MIN-OV.
      *    IF R29-MIN-OV-MONTHS-X NOT NUMERIC
      *      MOVE ZERO TO R29-MIN-OV-MONTHS.
      *    IF R29-SELECT-HIGH-VALUE EQUAL SPACES
      *      MOVE R29-SELECT-LOW-VALUE TO R29-SELECT-HIGH-VALUE.
      *
      * DISPLAY EDITED RECORD
      *
           DISPLAY "OPTION RECORD ENTERED WAS".
           DISPLAY MTLS-DATA-LINE-1.
           DISPLAY MTLS-DATA-LINE-1B.
           DISPLAY MTLS-DATA-LINE-2.
           DISPLAY MTLS-DATA-LINE-3.

      *    DISPLAY R29-REC.

      *    MOVE R29-DATE          TO  MDY-DATE.
      *    MOVE MDY-MM            TO  MM.
      *    MOVE MDY-DD            TO  DD.
      *    MOVE MDY-YY            TO  YY.
      *    MOVE 4 TO DATE-MODE.
      *    MOVE UNEDITED-DATE     TO DATE-VALIDATE-IN.
      *    CALL "TDATECHK" USING DATE-CHECK-AREA.
      *    MOVE DATE-SLASH-OUT    TO PRT-SLMOVE.
      *    MOVE UNEDITED-DATE     TO  SLOW-MOVE-DATE.
      *    IF YY > "70"
      *        MOVE "19" TO SLOW-MOVE-DATE-CC
      *    ELSE
      *        MOVE "20" TO SLOW-MOVE-DATE-CC.
      *
      *    DISPLAY "SLOW MOVE DATE = " SLOW-MOVE-DATE-CN.

      *---------- OPEN THE PRINT FILE, GET THE FILE NUMBER OF THE PRINT
      *---------- FILE, AND PRINT THE HEADER PAGE.

           OPEN OUTPUT ONLINE-PRT.

           PERFORM 9999-GETFNUM.

           MOVE "DHDR29.PUB" TO HD-FILE-NAME.
           CALL "THDPRT2" USING HD-RET-CODE, HD-FILE-NAME, FNUM
             HD-ROUTE-DATA, ESC-NAME.
           IF HD-RET-CODE NOT = 0
               MOVE "THDPRT2 ERROR IN HSK" TO BU-DISPLAY-MSG
               MOVE "HD-RET-CODE = "       TO BU-DISPLAY-FLD (1)
               MOVE HD-RET-CODE            TO BU-DISPLAY-FLD9 (1)
               GO TO 2-BLOWUP.

           PERFORM 9-MOVE-OPTION-LINES.
           WRITE PRINT-RCD FROM OPTION-LINE-1  AFTER ADVANCING 3 LINES.
           WRITE PRINT-RCD FROM OPTION-LINE-2  AFTER ADVANCING 1 LINE.
           WRITE PRINT-RCD FROM OPTION-LINE-2B AFTER ADVANCING 1 LINE.
           WRITE PRINT-RCD FROM OPTION-LINE-2C AFTER ADVANCING 1 LINE.
           WRITE PRINT-RCD FROM OPTION-LINE-3  AFTER ADVANCING 1 LINE.
           WRITE PRINT-RCD FROM OPTION-LINE-4  AFTER ADVANCING 1 LINE.
           WRITE PRINT-RCD FROM OPTION-LINE-5  AFTER ADVANCING 1 LINE.
           WRITE PRINT-RCD FROM OPTION-LINE-6  AFTER ADVANCING 1 LINE.
           WRITE PRINT-RCD FROM OPTION-LINE-7  AFTER ADVANCING 1 LINE.
           WRITE PRINT-RCD FROM OPTION-LINE-8  AFTER ADVANCING 1 LINE.
           WRITE PRINT-RCD FROM OPTION-LINE-SM AFTER ADVANCING 1 LINE.

           CALL "TESCSEQ" USING ESC-NAME.

           IF NOT PAPER-IS-132-COLS
              WRITE PRINT-RCD FROM CHAR-1636PI AFTER ADVANCING 0 LINES.

           PERFORM 9999-OPEN-STUFF.

           MOVE MTLS-RPT-TITLE     TO PRT-RPT-TITLE.
           MOVE "TRPTSLOW"         TO PRT-PGM-NAME.
           IF MTLS-FROM-RANGE > SPACES OR MTLS-TO-RANGE > SPACES
               PERFORM 9-MOVE-HEADING-DESC.
           IF MTLS-COST-OPT = "M"
               MOVE "MKT COST"     TO PRT-COST-LIT
           ELSE
           IF MTLS-COST-OPT = "A"
               MOVE "AVG COST"     TO PRT-COST-LIT
           ELSE
           IF MTLS-COST-OPT = "R"
               MOVE "REP COST"     TO PRT-COST-LIT.

           MOVE 1 TO DATE-MODE.
           CALL "TDATECHK" USING DATE-CHECK-AREA.
           MOVE DATE-SLASH-OUT TO PRT-DATE.
           MOVE DATE-FORMATTED-TIME-OUT TO PRT-TIME.

           COPY MTLSPROC IN COPYLIB.

      *---------- IF SPECIAL OPTIONS WERE CHOSEN, SET FLAG TO PRINT
      *---------- THE OPTION HEADER.  BLANK OUT ANY OPTIONS NOT CHOSEN.
      *
      *    IF R29-MIN-SLOW > 0
      *        MOVE R29-MIN-SLOW      TO  PRT-MIN-SL
      *        MOVE "Y"               TO  OPTION-HDR-FLAG
      *    ELSE
      *        MOVE SPACES            TO  MIN-VALUE-AREA.
      *
      *    IF R29-MIN-OBS-OPT = "X"
      *        MOVE R29-MIN-OBS       TO  PRT-MIN-OBS
      *        MOVE "Y"               TO  OPTION-HDR-FLAG
      *    ELSE
      *        MOVE SPACES            TO  OBSOLETE-AREA.
      *
      *    IF R29-MIN-OV-OPT = "X"
      *        MOVE R29-MIN-OV        TO  PRT-MIN-OV
      *        MOVE R29-MIN-OV-MONTHS TO  PRT-OV-MTHS
      *        MOVE "Y"               TO  OPTION-HDR-FLAG
      *    ELSE
      *        MOVE SPACES            TO  OVERAGE-AREA.
      *
      *    IF R29-INS-OPT NOT = "X"
      *        MOVE SPACES TO INS-AREA.
      *
      *    IF R29-INS-ONLY = "X"
      *        MOVE "INSURANCE ITEMS ONLY" TO INS-AREA.
      *
      *    EVALUATE R29-SELECT-OPTION
      *      WHEN "2"
      *        MOVE "AUTHOR" TO PR-SELECT-OPTION
      *      WHEN "3"
      *        MOVE "CLASS" TO PR-SELECT-OPTION
      *      WHEN "4"
      *        MOVE "KEYWORD/MODIFIER" TO PR-SELECT-OPTION
      *      WHEN "5"
      *        MOVE "MANUFACTURER" TO PR-SELECT-OPTION
      *      WHEN "6"
      *        MOVE "BIN LOCATION" TO PR-SELECT-OPTION
      *      WHEN "7"
      *        MOVE "DEFAULT DEPT" TO PR-SELECT-OPTION
      *    END-EVALUATE.
      *
      *    MOVE R29-SELECT-LOW-VALUE TO PR-LOW-VALUE.
      *    MOVE R29-SELECT-HIGH-VALUE TO PR-HIGH-VALUE.
      *
      *
      *TBL-IS-STACKED.
      *
      *    EVALUATE R29-SORT-OPTION
      *      WHEN "1"
      *        MOVE SPACES TO PRT-BRK-DESC, PRT-BRK-HEADER
      *        SORT SORT-FILE
      *          ON ASCENDING KEY      SORT-WORK-DATE-CN
      *                                SORT-CODE
      *           INPUT  PROCEDURE IS  ABSTRACT-CODES
      *           OUTPUT PROCEDURE IS  WRITE-REPORT
      *      WHEN "2"
      *        MOVE "AUTHOR" TO PRT-BRK-DESC, PRT-BRK-TYPE
      *        SORT SORT-FILE
      *          ON ASCENDING KEY      SORT-AUTHOR
      *                                SORT-WORK-DATE-CN
      *                                SORT-CODE
      *           INPUT PROCEDURE IS   ABSTRACT-CODES
      *           OUTPUT PROCEDURE IS  WRITE-REPORT
      *      WHEN "3"
      *        MOVE "DFLT DEPT" TO PRT-BRK-DESC, PRT-BRK-TYPE
      *        SORT SORT-FILE
      *          ON ASCENDING KEY      SORT-DFLT-DEPT
      *                                SORT-WORK-DATE-CN
      *                                SORT-CODE
      *            INPUT PROCEDURE IS  ABSTRACT-CODES
      *            OUTPUT PROCEDURE IS WRITE-REPORT
      *      WHEN "4"
      *        MOVE "BIN LOCATION" TO PRT-BRK-DESC, PRT-BRK-TYPE
      *        SORT SORT-FILE
      *          ON ASCENDING KEY      SORT-BINLOC
      *                                SORT-WORK-DATE-CN
      *                                SORT-CODE
      *            INPUT PROCEDURE IS  ABSTRACT-CODES
      *            OUTPUT PROCEDURE IS WRITE-REPORT
      *      WHEN "5"
      *        MOVE "MANUFACTURER" TO PRT-BRK-DESC, PRT-BRK-TYPE
      *        SORT SORT-FILE
      *          ON ASCENDING KEY      SORT-MANFACT
      *                                SORT-WORK-DATE-CN
      *                                SORT-CODE
      *            INPUT PROCEDURE IS  ABSTRACT-CODES
      *            OUTPUT PROCEDURE IS WRITE-REPORT
      *      WHEN "6"
      *        MOVE "KEY/MODIFIER" TO PRT-BRK-DESC, PRT-BRK-TYPE
      *        SORT SORT-FILE
      *          ON ASCENDING KEY      SORT-KEY-MOD
      *                                SORT-WORK-DATE-CN
      *                                SORT-CODE
      *            INPUT PROCEDURE IS  ABSTRACT-CODES
      *            OUTPUT PROCEDURE IS WRITE-REPORT
      *    END-EVALUATE.
      *
      *
      *2-SHUTDOWN-DB.
      *    IF ( ITEM-COUNT      EQUAL ZERO ) AND
      *       ( SUB-TOTAL-ITEMS EQUAL ZERO )
      *        PERFORM 66-PRT-HEADERS
      *        MOVE "NO ITEMS QUALIFIED FOR REPORT" TO PRINT-RCD
      *        WRITE PRINT-RCD AFTER ADVANCING 1 LINE.
           WRITE PRINT-RCD FROM CHAR-10PI AFTER ADVANCING 0 LINES.
           PERFORM 9999-CLOSE-STUFF.
           CLOSE ONLINE-PRT.
           GOBACK.


       2-BLOWUP.
           MOVE "TRPTSLOW" TO BU-PGM-NAME.
           CALL "TBLOWUP" USING BASE, BU-PGM-NAME, STATUS-AREA,
              VIEW-COMAREA, DUMMY-KSAM-STAT, BU-DISPLAY-MSG,
              BU-DISPLAY-AREA.

       5-PRINT.
           ADD 1 TO LINE-CTR.
           IF LINE-CTR > 60
             PERFORM 66-PRT-HEADERS
             IF PRINT-CONT-MSG-SW EQUAL "Y"
               MOVE SRT-CORP-CODE TO CONT-MSG-CORP-CODE
               MOVE CONT-MSG-LINE TO PRINT-RCD
               WRITE PRINT-RCD AFTER ADVANCING 1 LINE
               ADD 1 TO LINE-CTR.
           WRITE PRINT-RCD FROM PRINT-LINE AFTER ADVANCING 1 LINE.

       66-PRT-HEADERS.
           MOVE 7 TO LINE-CTR.
           ADD 1                       TO PG-CTR.
           MOVE PG-CTR                 TO  PRT-PAGE.
           WRITE PRINT-RCD FROM HEADING-1 AFTER ADVANCING NEW-PAGE.
           WRITE PRINT-RCD FROM HEADING-2 AFTER ADVANCING 1 LINE.
           IF MTLS-SORT-OPT > SPACES AND MTLS-SORT-OPT NOT = "01"
             MOVE CNTL-BREAK-HOLD-FIELD TO PRT-H2B-VALUE
             WRITE PRINT-RCD FROM HEADING-2B AFTER ADVANCING 1 LINE
             ADD   1      TO LINE-CTR.
      *    MOVE SM-HDR-1               TO  PRINT-RCD.
      *    WRITE PRINT-RCD AFTER ADVANCING NEW-PAGE.
      *    MOVE SM-HDR-2               TO  PRINT-RCD.
      *    WRITE PRINT-RCD AFTER ADVANCING 2 LINES.
      *    IF R29-SELECT-OPTION NOT EQUAL "1"
      *        ADD 1 TO LINE-CTR
      *        WRITE PRINT-RCD FROM SM-HDR-SELECT-OPTIONS
      *            AFTER ADVANCING 1.
      *    IF OPTION-HDR-FLAG = "Y"
      *        ADD 1 TO LINE-CTR
      *        WRITE PRINT-RCD FROM SM-HDR-OPTIONS AFTER ADVANCING 1.
           MOVE SM-HDR-2A              TO  PRINT-RCD.
           WRITE PRINT-RCD AFTER ADVANCING 1 LINES.
           MOVE SM-HDR-3               TO  PRINT-RCD.
           WRITE PRINT-RCD AFTER ADVANCING 1 LINES.
           MOVE SM-HDR-4               TO  PRINT-RCD.
           WRITE PRINT-RCD AFTER ADVANCING 1 LINES.
           WRITE PRINT-RCD FROM DASH-LINE AFTER ADVANCING 1 LINE.

      *67-PRINT-SUBTOTALS.
      *    MOVE SPACES TO PRINT-LINE.
      *    PERFORM 5-PRINT.
      *    MOVE SAVE-KEY TO PRT-SUB-DESC.
      *    MOVE NEW-KEY TO SAVE-KEY.
      *    IF R29-SORT-OPTION NOT EQUAL "4" AND
      *       R29-SORT-OPTION NOT EQUAL "5"
      *
      *      ADD SUB-TOTAL-ITEMS TO ITEM-COUNT
      *      ADD SUB-TOTAL-COST TO GRAND-TOTAL
      *
      *    END-IF.
      *    MOVE SUB-TOTAL-ITEMS TO PRT-ITEMS.
      *    MOVE SUB-TOTAL-COST TO PRT-COST.
      *    MOVE BRK-LINE TO PRINT-LINE.
      *    PERFORM 5-PRINT.
      *    MOVE 0 TO SUB-TOTAL-ITEMS, SUB-TOTAL-COST.
      *    MOVE NEW-KEY TO PRT-BRK-HEADER.

       RETURN-RCD.
           RETURN SORT-FILE
             AT END
                 MOVE "Y" TO EOF-SW.

      *--------- PRINT CONTROL BREAKS.
           IF MTLS-SORT-OPT NOT = "01" AND MTLS-SORT-OPT NOT = "  "
               IF EOF-SW NOT = "Y"
                   PERFORM 9-CHECK-CONTROL-BREAK
               END-IF
               IF EOF-SW = "Y" OR CNTL-BREAK-SW = "Y"
                   MOVE SPACES TO PRINT-RCD
                   WRITE PRINT-RCD           AFTER ADVANCING 1 LINE
                   ADD 1              TO  LINE-CTR
                   PERFORM 9-PRINT-CONTROL-BREAK
                   WRITE PRINT-RCD FROM CONTROL-BREAK-LINE
                                             AFTER ADVANCING 1 LINE
                   PERFORM 9-MOVE-CONTROL-BREAK
                   IF EOF-SW = "N"
                       PERFORM 66-PRT-HEADERS.


      *******************************************
      *                                         *
      *    I N P U T    P R O C E D U R E       *
      *                                         *
      *******************************************


       7-INPUT-RECORDS SECTION.

       COPY MTLSINPT IN COPYLIB.

      *ABSTRACT-CODES SECTION.
      *ACS.
      *
      *    PERFORM 9999-BEGFIL-MSTORERM-CD-I.
      *
      *ABSTRACT-LOOP.
      *
      *** SERIAL GET THRU MSTORERM FOR CODES
      *
      *    PERFORM 9999-GETSER-MSTORERM-CD-I.
      *
      *    IF END-OF-FILE
      *      GO TO AC-X.
      *
      *    IF CORP-CODE = "NON-STR "
      *      GO TO ABSTRACT-LOOP.
      *
      *DOES-CODE-QUALIFY.
      *
      *****************************************************
      *                                                   *
      *    IF LAST ISSUE DATE IS SPACES                   *
      *      INITIALIZATION DATE IS USED FOR COMPARISON   *
      *    IF LAST ISSUE DATE IS LESS THAN SLMOVE'S DATE  *
      *      THEN CODE IS TO INCLUDED ON SLOW MOVERS.     *
      *                                                   *
      *****************************************************
      *
      *    MOVE "Y" TO QUALIFY-FLAG.
      *    IF STR-LAST-IDATE NOT EQUAL SPACES
      *
      *
      * LAST ISSUE DATE EXISTS USE IT
      *
      *      IF STR-LAST-IDATE-CN >= SLOW-MOVE-DATE-CN
      *        MOVE "N" TO QUALIFY-FLAG
      *      END-IF
      *    ELSE
      *
      *
      * LAST ISSUE DATE DOESN'T EXIST -- USE INITIALIZATION DATE
      *
      *      IF STR-INIT-DATE-CN >= SLOW-MOVE-DATE-CN
      *        MOVE "N" TO QUALIFY-FLAG
      *      END-IF
      *    END-IF.
      *
      *    IF QUALIFY-FLAG = "N"
      *      GO TO ABSTRACT-LOOP.
      *
      *
      *---------- INSURANCE ITEMS ONLY REPORT.
      *
      *    IF R29-INS-ONLY = "X"
      *      IF STR-INS-ITM = "X" OR "B" OR "1"
      *        NEXT SENTENCE
      *      ELSE
      *        GO TO ABSTRACT-LOOP.
      *
      *---------- EXCLUDE INSURANCE ITEMS IF USER REQUESTED IT.
      *
      *    IF R29-INS-OPT = "X"
      *      IF STR-INS-ITM = "X" OR "B" OR "1"
      *        GO TO ABSTRACT-LOOP.
      *
      *****************************************************
      *   IF REORDER IS 0 AND                             *
      *      EXPEDITE IS 0 AND                            *
      *      ONHAND IS 0 THEN IT DOES NOT BELONG ON       *
      *      REPORT.  IT IS A DIRECT CHARGE ITEM.         *
      *****************************************************
      *
      *     IF STR-REORDER = 0
      *        AND  STR-EXPEDITE = 0
      *        AND  STR-ONHAND = 0
      *        GO TO ABSTRACT-LOOP.
      *
      *---------- IF THE MINIMUM VALUE FOR SLOW MOVERS OPTION WAS
      *---------- REQUESTED, CHECK FOR THAT MINIMUM VALUE.
      *
      *    COMPUTE TOTAL-COST = STR-ONHAND * STR-AVG-COST.
      *    IF TOTAL-COST < R29-MIN-SLOW
      *        GO TO ABSTRACT-LOOP.
      *
      *---------- IF THE USER WANTED TO EXCLUDE ITEMS THAT APPEARED
      *---------- ON AN EARLIER OVERAGE REPORT, EXCLUDE THESE ITEMS.
      *---------- ALSO TAKE INTO ACCOUNT PROJECTED OVERAGE IF ENTERED
      *
      *    IF R29-MIN-OV-OPT = "X"
      *      COMPUTE PROJECTED-ONHAND =
      *        STR-ONHAND - (STR-MTH-FCST * R29-MIN-OV-MONTHS)
      *      COMPUTE OVERAGE = (PROJECTED-ONHAND - STR-MAX)
      *      IF OVERAGE > 0
      *        COMPUTE OVERAGE-COST =
      *          OVERAGE * STR-AVG-COST
      *        IF OVERAGE-COST < R29-MIN-OV
      *            NEXT SENTENCE
      *        ELSE
      *            GO TO ABSTRACT-LOOP.
      *
      *---------- IF THE USER WANTED TO EXCLUDE ITEMS THAT APPEARED
      *---------- ON AN EARLIER OBSOLETE REPORT, EXCLUDE THESE ITEMS.
      *
      *    IF R29-MIN-OBS-OPT = "X"
      *      IF STR-STOCK-OT = "X"
      *        IF TOTAL-COST < R29-MIN-OBS
      *             NEXT SENTENCE
      *        ELSE
      *             GO TO ABSTRACT-LOOP.
      *
      *
      * HANDLE SELECT OPTION
      *
      *    MOVE "N" TO QUALIFY-FLAG.
      *    EVALUATE R29-SELECT-OPTION
      *      WHEN "2"
      *
      *
      * RANGE OF AUTHORS
      *
      *        IF STR-AUTHOR >= R29-SELECT-LOW-VALUE AND
      *           STR-AUTHOR <= R29-SELECT-HIGH-VALUE
      *
      *          MOVE "Y" TO QUALIFY-FLAG
      *
      *        END-IF
      *      WHEN "3"
      *
      *
      * RANGE OF ACCT CLASSES
      *
      *        IF STR-CLASS >= R29-SELECT-LOW-VALUE AND
      *           STR-CLASS <= R29-SELECT-HIGH-VALUE
      *
      *
      *          MOVE "Y" TO QUALIFY-FLAG
      *
      *        END-IF
      *      WHEN "4"
      *
      *
      * SELECT RANGE OF KEYWORD/MODIFIERS
      *
      *        PERFORM GET-KEYMOD
      *        IF DESC-KWM >= R29-SELECT-LOW-VALUE AND
      *           DESC-KWM <= R29-SELECT-HIGH-VALUE
      *          MOVE "Y" TO QUALIFY-FLAG
      *        END-IF
      *      WHEN "5"
      *
      *
      * SELECT RANGE OF MANUFACTURES
      *
      *
      * ONLY PERFORM CHECK IF NOT SORT BY MANUFACTURER -- IF SORT
      * BY MANFACTURER THEN WILL BE GOING THROUGH LIST OF MANUFACTURES
      * WHEN RELEASING TO SORT FILE SO DON'T BOTHER CHECKING TWICE
      *
      *        IF R29-SORT-OPTION NOT EQUAL "5"
      *
      *          MOVE CORP-CODE TO CODE-ARG
      *          MOVE "N" TO HANDLE-BLOWUP-FLAG
      *          PERFORM 9999-CHAINHD-DMANPART-CD-I
      *          PERFORM 9999-GETNEXT-DMANPART-CD-I
      *          PERFORM UNTIL NOT GOOD-CALL OR
      *                        QUALIFY-FLAG EQUAL "Y"
      *
      *             IF MAN-NAME >= R29-SELECT-LOW-VALUE AND
      *                MAN-NAME <= R29-SELECT-HIGH-VALUE
      *               MOVE "Y" TO QUALIFY-FLAG
      *             ELSE
      *               PERFORM 9999-GETNEXT-DDESC-CD-I
      *             END-IF
      *
      *          END-PERFORM
      *          MOVE "Y" TO HANDLE-BLOWUP-FLAG
      *        ELSE
      *          MOVE "Y" TO QUALIFY-FLAG
      *        END-IF
      *      WHEN "6"
      *
      *
      * SELECT RANGE OF BIN LOCATIONS
      *
      *
      * ONLY BOTHER CHECKING BIN LOCATION IF SORT BY BIN LOCATION NOT
      * SELECTED -- IF SORT BY BIN LOCATION SELECTED THEN CODE WILL BE
      * CHECKED FOR BIN LOCATIONS IN RANGE SPECIFIED WHEN RELEASING
      * TO SORT FILE.
      *
      *        IF R29-SORT-OPTION NOT EQUAL "4"
      *          PERFORM VARYING SUB FROM 1 BY 1
      *                  UNTIL QUALIFY-FLAG EQUAL "Y" OR
      *                        SUB GREATER THAN 6
      *
      *            IF STR-LOC(SUB) NOT EQUAL SPACES AND
      *               STR-LOC(SUB) >= R29-SELECT-LOW-VALUE AND
      *               STR-LOC(SUB) <= R29-SELECT-HIGH-VALUE
      *              MOVE "Y" TO QUALIFY-FLAG
      *            END-IF
      *
      *          END-PERFORM
      *        ELSE
      *          MOVE "Y" TO QUALIFY-FLAG
      *        END-IF
      *      WHEN "7"
      *
      *
      * SELECT BY DEFAULT DEPARTMENT
      *
      *        IF STR-DFLT-DEPT >= R29-SELECT-LOW-VALUE AND
      *           STR-DFLT-DEPT <= R29-SELECT-HIGH-VALUE
      *
      *          MOVE "Y" TO QUALIFY-FLAG
      *
      *        END-IF
      *      WHEN OTHER
      *        MOVE "Y" TO QUALIFY-FLAG
      *    END-EVALUATE.
      *
      *
      * IF DIDN'T QUALIFY FOR SELECTION SPECIFIED THEN GO BACK
      * TO THE TOP OF THE LOOP
      *
      *    IF QUALIFY-FLAG EQUAL "N"
      *      GO TO ABSTRACT-LOOP.
      *
      *    MOVE SPACES              TO  SORT-RCD.
      *    MOVE STR-LAST-CHARGE     TO  SORT-LAST-DEPT.
      *    IF STR-INS-ITM = "X" OR "B" OR "1"
      *        MOVE "INS"           TO  SORT-INS.
      *
      *    MOVE STR-LAST-IDATE-CN TO SORT-WORK-DATE-CN.
      *    MOVE CORP-CODE TO SORT-CODE.
      *    MOVE STR-ONHAND TO SORT-ONHAND.
      *    IF R29-PRINT-BINLOCS EQUAL "X"
      *
      *      PERFORM VARYING SUB FROM 1 BY 1
      *              UNTIL SUB GREATER THAN 6
      *
      *        MOVE STR-LOC(SUB) TO SORT-LOC(SUB)
      *        MOVE STR-LOC-ONHAND(SUB) TO SORT-LOC-ONHAND(SUB)
      *
      *      END-PERFORM
      *
      *    END-IF.
      *    MOVE STR-UM          TO  SORT-UM.
      *    MOVE STR-MAX         TO  SORT-MAX.
      *    MOVE STR-REORDER     TO  SORT-REORDER.
      *    MOVE STR-EXPEDITE    TO  SORT-EXPEDITE.
      *    MOVE STR-SOQ         TO  SORT-SOQ.
      *    MOVE STR-MTH-FCST    TO  SORT-MTH-FCST.
      *    MOVE STR-AVG-COST    TO  SORT-AVG-COST.
      *    MOVE STR-INIT-DATE   TO  SORT-INIT-DATE.
      *    MOVE STR-ACT-DATE    TO  SORT-ACT-DATE.
      *    MOVE STR-CLASS       TO  SORT-CLASS.
      *    MOVE STR-AUTHOR      TO  SORT-AUTHOR.
      *    MOVE STR-DFLT-DEPT   TO  SORT-DFLT-DEPT.
      *    MOVE STR-LAST-VENDOR TO  SORT-LAST-VENDOR.
      *    MOVE STR-LAST-PO     TO  SORT-LAST-PO.
      *
      *    IF R29-SORT-OPTION EQUAL "1" OR "2" OR "3"
      *
      *      RELEASE SORT-RCD
      *
      *    ELSE IF R29-SORT-OPTION EQUAL "4"
      *
      * PRODUCE AN ENTRY FOR EACH BIN LOCATION - ONLY SPACE IF NONE CONFIGED
      *
      *
      * ONLY IF IN SELECT RANGE IF BIN LOCATION SELECT SPECIFIED
      *
      *      PERFORM VARYING SUB FROM 1 BY 1
      *              UNTIL SUB GREATER THAN 6 OR
      *                    STR-LOC(SUB) EQUAL SPACES
      *
      *        IF STR-LOC(SUB) NOT EQUAL SPACES
      *
      *          IF R29-SELECT-OPTION EQUAL "6"
      *
      *
      * RELEASE THIS RECORD IF ITS IN THE SELECTED RANGE
      *
      *            IF STR-LOC(SUB) >= R29-SELECT-LOW-VALUE AND
      *               STR-LOC(SUB) <= R29-SELECT-HIGH-VALUE
      *
      *              MOVE STR-LOC(SUB) TO SORT-BINLOC
      *              RELEASE SORT-RCD
      *
      *            END-IF
      *          ELSE
      *
      *            MOVE STR-LOC(SUB) TO SORT-BINLOC
      *            RELEASE SORT-RCD
      *
      *          END-IF
      *
      *        END-IF
      *
      *      END-PERFORM
      *    ELSE IF R29-SORT-OPTION EQUAL "5"
      *
      *
      * PRODUCE AN ENTRY FOR EACH MANUFACTURER FOUND IF SORT-OPTION
      * 5 HAS BEEN SELECTED
      *
      *
      * ONLY RELEASE IF MANUFACTURER IS IN RANGE IF OPTION SELECTED
      * AND IF SELECT BY MANUFACTURER HAS BEEN SPECIFIED
      *
      *      MOVE CORP-CODE TO CODE-ARG
      *      PERFORM 9999-CHAINHD-DMANPART-CD-I
      *      PERFORM 9999-GETNEXT-DMANPART-CD-I
      *      IF END-OF-CHAIN
      *        MOVE SPACES TO MAN-NAME
      *        IF R29-SELECT-OPTION EQUAL "5"
      *          IF MAN-NAME >= R29-SELECT-LOW-VALUE AND
      *             MAN-NAME <= R29-SELECT-HIGH-VALUE
      *
      *            MOVE MAN-NAME TO SORT-MANFACT
      *            RELEASE SORT-RCD
      *
      *          END-IF
      *        ELSE
      *
      *          MOVE MAN-NAME TO SORT-MANFACT
      *          RELEASE SORT-RCD
      *
      *        END-IF
      *      ELSE
      *        PERFORM UNTIL END-OF-CHAIN
      *
      *          IF R29-SELECT-OPTION EQUAL "5"
      *            IF MAN-NAME >= R29-SELECT-LOW-VALUE AND
      *               MAN-NAME <= R29-SELECT-HIGH-VALUE
      *
      *              MOVE MAN-NAME TO SORT-MANFACT
      *              RELEASE SORT-RCD
      *
      *            END-IF
      *          ELSE
      *
      *            MOVE MAN-NAME TO SORT-MANFACT
      *            RELEASE SORT-RCD
      *
      *          END-IF
      *          PERFORM 9999-GETNEXT-DMANPART-CD-I
      *
      *        END-PERFORM
      *
      *      END-IF
      *
      *    ELSE
      *
      *
      * KEYWORD MODIFIER SORT
      *
      *      PERFORM GET-KEYMOD
      *      MOVE DESC-KWM TO SORT-KEY-MOD
      *      RELEASE SORT-RCD
      *
      *    END-IF.
      *
      *    GO TO ABSTRACT-LOOP.
      *
      *AC-X.
      *    EXIT.
       7-IR-EXIT.
           EXIT.

      ********************************************************************
      * PARA    : GET-KEYMOD                                             *
      * PURPOSE : TO GET THE KEWORD MODIFIER INFO CURRENT CORPORATE CODE *
      ********************************************************************
       GET-KEYMOD.
           MOVE CORP-CODE TO CODE-ARG.
           MOVE SPACES TO DESC-ID-NUM, DESC-KWM.
           MOVE "N" TO HANDLE-BLOWUP-FLAG.
           PERFORM 9999-CHAINHD-DDESC-I.
           PERFORM 9999-GETNEXT-DDESC-I.
           PERFORM UNTIL NOT GOOD-CALL OR
                         DESC-ID-NUM EQUAL "00"
             PERFORM 9999-GETNEXT-DDESC-I
           END-PERFORM.
           MOVE "Y" TO HANDLE-BLOWUP-FLAG.


      *******************************************
      *                                         *
      *    O U T P U T   P R O C E D U R E      *
      *                                         *
      *******************************************


       8-WRITE-RECORDS SECTION.
      *WRITE-REPORT SECTION.

       WRITE-RPT.
           MOVE SPACES TO PRINT-RCD.
           RETURN SORT-FILE
             AT END
                 MOVE "Y" TO EOF-SW.

      *    PERFORM RETURN-RCD.
      *    MOVE SPACES TO PRT-BRK-HEADER
           IF EOF-SW = "Y"
               IF ( ITEM-COUNT      EQUAL ZERO ) AND
                  ( SUB-TOTAL-ITEMS EQUAL ZERO )
                   ADD 1                       TO PG-CTR
                   MOVE PG-CTR                 TO  PRT-PAGE
                   WRITE PRINT-RCD FROM HEADING-1
                                               AFTER ADVANCING NEW-PAGE
                   WRITE PRINT-RCD FROM HEADING-2 AFTER ADVANCING 1 LINE
                   MOVE "NO ITEMS QUALIFIED FOR REPORT" TO PRINT-RCD
                   WRITE PRINT-RCD AFTER ADVANCING 1 LINE
                   WRITE PRINT-RCD FROM CHAR-10PI AFTER ADVANCING 0 LINES
                   PERFORM 9999-CLOSE-STUFF
                   CLOSE ONLINE-PRT
                   GOBACK.

           PERFORM 9-MOVE-CONTROL-BREAK.

      *        GO TO  WR-X.
      *    EVALUATE R29-SORT-OPTION
      *      WHEN "2"
      *        MOVE SORT-AUTHOR TO SAVE-KEY, PRT-BRK-HEADER
      *      WHEN "3"
      *        MOVE SORT-DFLT-DEPT TO SAVE-KEY, PRT-BRK-HEADER
      *      WHEN "4"
      *        MOVE SORT-BINLOC TO SAVE-KEY, PRT-BRK-HEADER
      *      WHEN "5"
      *        MOVE SORT-MANFACT TO SAVE-KEY, PRT-BRK-HEADER
      *      WHEN "6"
      *        MOVE SORT-KEY-MOD TO SAVE-KEY, PRT-BRK-HEADER
      *    END-EVALUATE.
           MOVE 0 TO PG-CTR.
           PERFORM 66-PRT-HEADERS.
           MOVE 4 TO DATE-MODE.
      *
      * DISABLE CONTINUE MESSAGE
      *
           MOVE "N" TO PRINT-CONT-MSG-SW.

      *******************************************
      *                                         *
      *    S L O W    M O V E R   R E P O R T   *
      *                                         *
      *******************************************

      **
      ** BEGIN LOOP
      **
           PERFORM UNTIL EOF-SW EQUAL "Y"

      *
      * CHECK FOR BREAK
      *
      *      EVALUATE R29-SORT-OPTION
      *        WHEN "2"
      *          IF SORT-AUTHOR NOT EQUAL SAVE-KEY
      *            MOVE SORT-AUTHOR TO NEW-KEY
      *            PERFORM 67-PRINT-SUBTOTALS
      *            PERFORM 66-PRT-HEADERS
      *          END-IF
      *        WHEN "3"
      *          IF SORT-DFLT-DEPT NOT EQUAL SAVE-KEY
      *            MOVE SORT-DFLT-DEPT TO NEW-KEY
      *            PERFORM 67-PRINT-SUBTOTALS
      *            PERFORM 66-PRT-HEADERS
      *          END-IF
      *        WHEN "4"
      *          IF SORT-BINLOC NOT EQUAL SAVE-KEY
      *            MOVE SORT-BINLOC TO NEW-KEY
      *            PERFORM 67-PRINT-SUBTOTALS
      *            PERFORM 66-PRT-HEADERS
      *          END-IF
      *        WHEN "5"
      *          IF SORT-MANFACT NOT EQUAL SAVE-KEY
      *            MOVE SORT-MANFACT TO NEW-KEY
      *            PERFORM 67-PRINT-SUBTOTALS
      *            PERFORM 66-PRT-HEADERS
      *          END-IF
      *        WHEN "6"
      *          IF SORT-KEY-MOD NOT EQUAL SAVE-KEY
      *            MOVE SORT-KEY-MOD TO NEW-KEY
      *            PERFORM 67-PRINT-SUBTOTALS
      *            PERFORM 66-PRT-HEADERS
      *          END-IF
      *      END-EVALUATE

             MOVE SRT-CORP-CODE TO CORPCDE OF MSTORERM-REC-I
             READ MSTORERM-I INTO BUF-MSTORERM
                 INVALID KEY MOVE FILE-STATUS TO FILE-STATUS
             END-READ
             IF FILE-STATUS NOT = 00
                 INITIALIZE BUF-MSTORERM
             END-IF

             COMPUTE TOTAL-COST = SRT-ONHAND * SRT-COST
      *      ADD TOTAL-COST TO SUB-TOTAL-COST
      *      ADD 1 TO SUB-TOTAL-ITEMS
             ADD TOTAL-COST TO GRAND-TOTAL
             ADD 1 TO ITEM-COUNT

             MOVE SRT-CORP-CODE      TO  PRT-SM-CD
             MOVE SRT-ONHAND         TO  PRT-SM-ONHAND
             MOVE SRT-UM             TO  PRT-SM-UM
             MOVE SRT-CLASS          TO  PRT-STR-CLASS
             MOVE SRT-AUTHOR         TO  PRT-AUTHOR
             MOVE SRT-DFLT-DEPT      TO  PRT-DFLT-DEPT
             MOVE STR-LAST-CHARGE    TO  PRT-LAST-DEPT
             IF STR-INS-ITM = "X" OR "B" OR "1"
                 MOVE "INS"           TO  PRT-INS
             END-IF

      *
      * FORMAT LAST ISSUE, LAST ACTIVITY AND ADD TO STOCK DATES
      *
             MOVE STR-LAST-IDATE     TO  DATE-VALIDATE-IN
             CALL "TDATECHK" USING DATE-CHECK-AREA
             MOVE DATE-SLASH-OUT     TO  PRT-SM-DATE
             MOVE STR-ACT-DATE       TO  DATE-VALIDATE-IN
             CALL "TDATECHK" USING DATE-CHECK-AREA
             MOVE DATE-SLASH-OUT     TO  PRT-ACT-DATE
             MOVE STR-INIT-DATE      TO  DATE-VALIDATE-IN
             CALL "TDATECHK" USING DATE-CHECK-AREA
             MOVE DATE-SLASH-OUT     TO  PRT-INIT-DATE
             IF STR-LAST-IDATE = SPACES
      *IF NO LAST ISSUE DATE AVAILABLE MOVE THE INIT DATE TO THE SM DATE
                 MOVE DATE-SLASH-OUT TO PRT-SM-DATE
                 MOVE "*"            TO PRT-ASTERICK
             ELSE
                 MOVE SPACES         TO PRT-ASTERICK
             END-IF
      *
      * GET ITEM DESCRIPTION AND PRINT IT
      *
             MOVE SRT-CORP-CODE             TO   CODE-ARG
             CALL "CDESC" USING CDESC-RET-CODE, BASE, STATUS-AREA,
             BU-DISPLAY-MSG, CODE-ARG, CDESC-DATA
      *      MOVE CDESC(1) TO PRT-SM-DESC
             MOVE SRT-KEYWD-MOD TO PRT-SM-DESC
             MOVE SM-DETAIL-1 TO PRINT-LINE
             MOVE SPACES TO SM-DETAIL-1
             PERFORM 5-PRINT
      *
      * ENABLE CONTINUE MESSAGE
      *
             MOVE "Y" TO PRINT-CONT-MSG-SW
             IF MTLS-DESC-OPT = "X"
               PERFORM VARYING SUB FROM 2 BY 1
                       UNTIL SUB GREATER THAN CDESC-LINES-GOT

                 MOVE CDESC(SUB) TO PRT-SM-DESC2
                 MOVE SM-DETAIL-1A TO PRINT-LINE
                 MOVE SPACES TO SM-DETAIL-1A
                 PERFORM 5-PRINT

               END-PERFORM

             END-IF
      *
      * GET AND PRINT VENDOR LIST
      *

      *-------- IF THE SWITCH TO EXCLUDE VENDOR INFO IS ON, SKIP THIS
      *-------- LOGIC.

      *      IF R29-EXCLUDE-VEND NOT = "X"
             IF MTLS-EXCL-VEND NOT = "X"

                 MOVE SRT-CORP-CODE TO CODE-ARG
                 PERFORM 9999-CHAINHD-DVENDITM-CD-I
                 PERFORM 9999-GETNEXT-DVENDITM-CD-I
      *
      * INITIAL RECORD
      *
                 IF END-OF-CHAIN
                     MOVE "    **NO VENDORS ON FILE**" TO PRINT-LINE
                     PERFORM 5-PRINT
                 ELSE
      *
      * GET ALL VENDORS
      *
                     MOVE SM-HDR-6 TO PRINT-LINE
                     PERFORM 5-PRINT
                     PERFORM UNTIL END-OF-CHAIN

      *
      * PRINT THE VENDOR NAME
      *
                     IF STR-LAST-VENDOR EQUAL VEN-ITM-VENCODE
                       MOVE "*" TO PRT-LAST-VENDOR-FLAG
                     ELSE
                       MOVE SPACE TO PRT-LAST-VENDOR-FLAG
                     END-IF
                     MOVE VEN-OF-RCD TO PRT-VEN-OF-RCD
                     MOVE VEN-QUOTE-FLAG TO PRT-VEN-QUOTE-FLAG
                     MOVE VEN-ITM-PRICE TO PRT-VEN-ITM-PRICE
                     MOVE VEN-ITM-PRICE-UM TO PRT-VEN-ITM-UM
                     MOVE VEN-ITM-VENCODE TO VEN-ARG, PRT-VEND-NO
                     PERFORM 9999-CHAINHD-DVENDOR-VN-I
                     PERFORM 9999-GETNEXT-DVENDOR-VN-I
                     IF ( END-OF-CHAIN              ) OR
                        ( VEN-ITM-NO NOT EQUAL ZERO )
                       MOVE "**NO VENDOR NAME ON FILE**" TO
                                                      PRT-VEND-NAME
                       MOVE SM-DETAIL-2      TO PRINT-LINE
                       PERFORM 5-PRINT
                     ELSE
                       MOVE VEN-NAME TO PRT-VEND-NAME
                       MOVE SM-DETAIL-2      TO PRINT-LINE
                       PERFORM 5-PRINT
                     END-IF
      *
      * GET THE NEXT VENDOR
      *
                     PERFORM 9999-GETNEXT-DVENDITM-CD-I

                   END-PERFORM

                 END-IF

             END-IF
      *
      * PRINT REORDER, MAX, EXPEDITE, SOQ, LAST PO, AVG COST & TOTAL COST
      *
             MOVE SPACES TO PRINT-LINE
             PERFORM 5-PRINT
             MOVE SM-HDR-8 TO PRINT-LINE
             PERFORM 5-PRINT
             MOVE SRT-REORDER TO REORDER-4
             MOVE SRT-MAX TO MAX-4
             MOVE SRT-EXPEDITE TO EXPEDITE-4
             MOVE STR-SOQ TO SOQ-4
             MOVE SRT-MTH-FCST TO MTH-FCST-4
             MOVE STR-LAST-PO TO LAST-PO-4
             MOVE SRT-COST TO AVG-COST-4
             MOVE TOTAL-COST TO TOTAL-COST-4
             MOVE SM-DETAIL-4 TO PRINT-LINE
             PERFORM 5-PRINT
      *
      * PRINT THE ONHAND QUANTITIES BY BIN LOCATION IF SPECIFIED
      *
      *      IF R29-PRINT-BINLOCS EQUAL "X"
             IF MTLS-PRT-BIN EQUAL "X"

               MOVE SPACES TO PRINT-LINE
               PERFORM 5-PRINT
               MOVE SM-HDR-7 TO PRINT-LINE
               PERFORM 5-PRINT
               PERFORM VARYING SUB FROM 1 BY 1
                       UNTIL SUB GREATER THAN 6

                 IF STR-LOC(SUB) NOT EQUAL SPACE

      *            MOVE SORT-LOC(SUB) TO PRT-BIN-LOC-DESC-3
                   MOVE STR-LOC(SUB) TO PRT-BIN-LOC-DESC-3
                   MOVE STR-LOC-ONHAND(SUB) TO PRT-BIN-ONHAND-3
      *            MOVE SORT-LOC-ONHAND(SUB) TO PRT-BIN-ONHAND-3
                   MOVE SM-DETAIL-3 TO PRINT-LINE
                   PERFORM 5-PRINT

                 END-IF

               END-PERFORM

             END-IF
             MOVE DASH-LINE TO PRINT-LINE
      *
      * DISABLE CONTINUE MESSAGE
      *
             MOVE "N" TO PRINT-CONT-MSG-SW
             PERFORM 5-PRINT

             PERFORM RETURN-RCD

           END-PERFORM.
      **
      ** END LOOP
      **

      *
      * PRINT FINAL BREAKS AND TOTAL LINE
      *
      *    IF R29-SORT-OPTION EQUAL "1"
      *
      *      MOVE SPACES TO PRINT-LINE
      *      PERFORM 5-PRINT
      *      MOVE SUB-TOTAL-ITEMS TO PRT-ITM-COUNT
      *      MOVE SUB-TOTAL-COST TO PRT-GRAND-TOTAL
      *      MOVE GRAND-TOTAL-LINE TO PRINT-LINE
      *      PERFORM 5-PRINT

      *    ELSE IF R29-SORT-OPTION EQUAL "2" OR "3" OR "6"
           IF MTLS-SORT-OPT NOT EQUAL "06" AND
              MTLS-SORT-OPT NOT EQUAL "08"

      *      PERFORM 67-PRINT-SUBTOTALS
             MOVE 7 TO LINE-CTR
             ADD 1                       TO PG-CTR
             MOVE PG-CTR                 TO  PRT-PAGE
             WRITE PRINT-RCD FROM HEADING-1 AFTER ADVANCING NEW-PAGE
             WRITE PRINT-RCD FROM HEADING-2 AFTER ADVANCING 1 LINE
             MOVE SPACES TO PRINT-LINE
             PERFORM 5-PRINT
             MOVE ITEM-COUNT  TO  PRT-ITM-COUNT
             MOVE GRAND-TOTAL TO  PRT-GRAND-TOTAL
             MOVE GRAND-TOTAL-LINE TO PRINT-LINE
             PERFORM 5-PRINT

      *    ELSE IF R29-SORT-OPTION EQUAL "4" OR "5"
           ELSE IF MTLS-SORT-OPT EQUAL "06" OR "08"

      *      PERFORM 67-PRINT-SUBTOTALS
      *
      * SET SUB-TOTAL-ITEMS TO 1 TO AVOID "NO ITEMS QUALIFIED..." MSG
      *
             MOVE 1 TO SUB-TOTAL-ITEMS
             MOVE SPACES TO PRINT-LINE
             PERFORM 5-PRINT
             STRING "GRAND TOTALS NOT PRINTED FOR SORT "
               DELIMITED BY SIZE INTO PRINT-LINE
             PERFORM 5-PRINT
             MOVE "BECAUSE THEY WOULD BE INACURATE" TO PRINT-LINE
             PERFORM 5-PRINT
             MOVE "DUE TO MULTIPLE OCCURANCES OF EACH CORPORATE CODE"
              TO PRINT-LINE
             PERFORM 5-PRINT
           END-IF.

       WR-X.
           EXIT.

       COPYLIB-MEMBERS SECTION.

       9999-OPEN-STUFF.
           OPEN INPUT MSTORERM-I           .
           OPEN INPUT DDESC-I              .
           OPEN INPUT DVENDITM-CD-I        .
           OPEN INPUT DVENDOR-VN-I         .
           OPEN INPUT DMANPART-I           .

       9999-CLOSE-STUFF.
           CLOSE      MSTORERM-I           .
           CLOSE      DDESC-I              .
           CLOSE      DVENDITM-CD-I        .
           CLOSE      DVENDOR-VN-I         .
           CLOSE      DMANPART-I           .

       9999-GETFNUM.
      * DUMMY COPYLIB MEMBER ON AS/400

       9999-CHAINHD-DDESC-I.
           MOVE 0 TO COND-WORD.
           MOVE CODE-ARG TO CORPCDE OF DDESC-REC-I.
           START DDESC-I KEY = CORPCDE OF DDESC-REC-I
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF (FILE-STATUS NOT = "00") AND (FILE-STATUS-1 NOT = "2")
               MOVE 99 TO COND-WORD
               IF HANDLE-BLOWUP-FLAG = "Y"
                   MOVE "CHAINHD ERR 9999-CHAINHD-DDESC-I"
                       TO BU-MSG-AREA
                   PERFORM 2-BLOWUP.

       9999-GETNEXT-DDESC-I.
           MOVE 0 TO COND-WORD.
           READ DDESC-I NEXT INTO BUF-DDESC
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   MOVE 15 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD
                   IF HANDLE-BLOWUP-FLAG = "Y"
                       MOVE "GETNEXT ERR 9999-GETNEXT-DDESC-I"
                           TO BU-MSG-AREA
                       PERFORM 2-BLOWUP
                   END-IF
           ELSE
           IF CORPCDE OF DDESC-REC-I NOT = CODE-ARG
               MOVE 15 TO COND-WORD.

       9999-CHAINHD-DMANPART-I.
           MOVE 0 TO COND-WORD.
           MOVE CODE-ARG TO CORPCDE OF DMANPART-REC-I.
           START DMANPART-I KEY = CORPCDE OF DMANPART-REC-I
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF (FILE-STATUS NOT = "00") AND (FILE-STATUS-1 NOT = "2")
               MOVE 99 TO COND-WORD
               IF HANDLE-BLOWUP-FLAG = "Y"
                   MOVE "CHAINHD ERR 9999-CHAINHD-DMANPART-I"
                       TO BU-MSG-AREA
                   PERFORM 2-BLOWUP.

       9999-GETNEXT-DMANPART-I.
           MOVE 0 TO COND-WORD.
           READ DMANPART-I NEXT INTO BUF-DMANPART
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   MOVE 15 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD
                   IF HANDLE-BLOWUP-FLAG = "Y"
                       MOVE "GETNEXT ERR 9999-GETNEXT-DMANPART-I"
                           TO BU-MSG-AREA
                       PERFORM 2-BLOWUP
                   END-IF
           ELSE
           IF CORPCDE OF DMANPART-REC-I NOT = CODE-ARG
               MOVE 15 TO COND-WORD.

       9999-CHAINHD-DVENDITM-CD-I.
           MOVE 0 TO COND-WORD.
           MOVE CODE-ARG TO CORPCDE OF DVENDITM-CD-REC-I.
           START DVENDITM-CD-I KEY = CORPCDE OF DVENDITM-CD-REC-I
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF (FILE-STATUS NOT = "00") AND (FILE-STATUS-1 NOT = "2")
               MOVE 99 TO COND-WORD
               IF HANDLE-BLOWUP-FLAG = "Y"
                   MOVE "CHAINHD ERR 9999-CHAINHD-DVENDITM-CD-I"
                       TO BU-MSG-AREA
                   PERFORM 2-BLOWUP.

       9999-GETNEXT-DVENDITM-CD-I.
           MOVE 0 TO COND-WORD.
           READ DVENDITM-CD-I NEXT INTO BUF-DVENDITM
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   MOVE 15 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD
                   IF HANDLE-BLOWUP-FLAG = "Y"
                       MOVE "GETNEXT ERR 9999-GETNEXT-DVENDITM-CD-I"
                           TO BU-MSG-AREA
                       PERFORM 2-BLOWUP
                   END-IF
           ELSE
           IF CORPCDE OF DVENDITM-CD-REC-I NOT = CODE-ARG
               MOVE 15 TO COND-WORD.

       9999-CHAINHD-DVENDOR-VN-I.
           MOVE 0 TO COND-WORD.
           MOVE VEN-ARG TO VENCDE OF DVENDOR-VN-REC-I.
           START DVENDOR-VN-I KEY = VENCDE OF DVENDOR-VN-REC-I
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF (FILE-STATUS NOT = "00") AND (FILE-STATUS-1 NOT = "2")
               MOVE 99 TO COND-WORD
               IF HANDLE-BLOWUP-FLAG = "Y"
                   MOVE "CHAINHD ERR 9999-CHAINHD-DVENDOR-VN-I"
                       TO BU-MSG-AREA
                   PERFORM 2-BLOWUP.

       9999-GETNEXT-DVENDOR-VN-I.
           MOVE 0 TO COND-WORD.
           READ DVENDOR-VN-I NEXT INTO BUF-DVENDOR
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   MOVE 15 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD
                   IF HANDLE-BLOWUP-FLAG = "Y"
                       MOVE "GETNEXT ERR 9999-GETNEXT-DVENDOR-VN-I"
                           TO BU-MSG-AREA
                       PERFORM 2-BLOWUP
                   END-IF
           ELSE
           IF VENCDE OF DVENDOR-VN-REC-I NOT = VEN-ARG
               MOVE 15 TO COND-WORD.

       9999-GETSER-MSTORERM-I.
           MOVE 0 TO COND-WORD.
           READ MSTORERM-I NEXT INTO BUF-MSTORERM
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS-1 = "1"
               MOVE 11 TO COND-WORD
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD
               IF HANDLE-BLOWUP-FLAG = "Y"
                   MOVE "GETSER ERR 9999-GETSER-MSTORERM-I"
                       TO BU-MSG-AREA
                   PERFORM 2-BLOWUP.

       9999-BEGFIL-MSTORERM-I.
           MOVE SPACES TO CORPCDE OF MSTORERM-REC-I.
           START MSTORERM-I KEY >= CORPCDE OF MSTORERM-REC-I
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.

       COPY MTLSUTIL IN COPYLIB.

      *------- DUMMY PARAGRAPH; NOT USED IN THIS PROGRAM.
       9-COMPUTE-USAGE.
           EXIT.
