000200 IDENTIFICATION DIVISION.
000300 PROGRAM-ID.    TPDISP4.
000400 INSTALLATION.  GOODYEAR.
000500*REMARKS.
000600*       #########################################################
000700*       # This is the personnel confidential identification dis-#
000800*       # play program -----------------------------------------#
000900*       #########################################################.
001100 ENVIRONMENT DIVISION.
001200 CONFIGURATION SECTION.
001300 SOURCE-COMPUTER.      AS400.
001400 OBJECT-COMPUTER.      AS400.
       SPECIAL-NAMES.      I-O-FEEDBACK IS I-O-FEEDBACK-AREA
                           LOCAL-DATA IS LOCAL-DATA-AREA.
001000 INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT DISPLAY-FILE
               ASSIGN TO WORKSTATION-ZPERSON-SI
               ORGANIZATION IS TRANSACTION
               ACCESS IS SEQUENTIAL
               FILE STATUS IS DSPLY-STATUS
               CONTROL-AREA IS WS-CONTROL.
           SELECT PER-CONF-MSTR
               ASSIGN TO DATABASE-MCFLMM3001
               ORGANIZATION IS INDEXED
               ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
               FILE STATUS IS PCM-STATUS.
           SELECT PER-CONFIDENTIAL
               ASSIGN TO DATABASE-MCFLMM3301
               ORGANIZATION IS INDEXED
               ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                   WITH DUPLICATES
               FILE STATUS IS PC-STATUS.
001500 DATA DIVISION.
       FILE SECTION.
       FD  DISPLAY-FILE
           LABEL RECORDS ARE OMITTED.
       01  DSPLY-REC                   PIC X(2000).
       FD  PER-CONF-MSTR
           LABEL RECORDS ARE STANDARD
           DATA RECORD IS PCMREC.
       01  PCMREC.
           COPY DDS-ALL-FORMATS OF MCFLMM3001.
       FD  PER-CONFIDENTIAL
           LABEL RECORDS ARE STANDARD
           DATA RECORD IS PCREC.
       01  PCREC.
           COPY DDS-ALL-FORMATS OF MCFLMM3301.
001600 WORKING-STORAGE SECTION.
006200 01  BYTE-99                      PIC 99.
       COPY CATREAD OF COPYLIB.
       COPY CPYIND  OF COPYLIB.
       COPY DBSTAT  OF COPYLIB.
006000 01  ERROR-BUFFER                 PIC X(80).
005800 01  FORM-SW                      PIC 9.
       01  FILE-STATUSES.
           05  DSPLY-STATUS             PIC XX.
           05  PC-STATUS                PIC XX.
           05  PCM-STATUS               PIC XX.
       COPY IOFEEDBACK OF COPYLIB.
006500 01  ITEM-BUFFER.
006600     05 ITEM-B                    PIC XX.
006700     05 DEFN-B                    PIC X(30).
005700 01  MODIFY-SW                    PIC X.
004600 01  PASSED-SPOOL-PRT             PIC S9(2) COMP-4 VALUE 0.
001800 01  PASSWORD-INFORMATION.
001900     05  NAME-OF-PROGRAM     PIC X(08) VALUE "TPDISP4 ".
002000     05  PROGRAM-TYPE        PIC X(02) VALUE "MA".
002100     05  PROGRAM-RELEASE     PIC X(12) VALUE " E0100010001".
002200     05  PROGRAM-DESCRIPTION.
002300         10  PROG-DESC-A     PIC X(60) VALUE
002400             "PERSONNEL IDENTIFICATION DATA DISPLAY PROGRAM "    .
002500         10  PROG-DESC-B     PIC X(60) VALUE SPACES.
002700         10  PROG-FUNCTION   PIC X(60) VALUE SPACES.
002900     05  PASSWORD-FLAG       PIC X.
003000 01  PASSWORD-INFORMATION1.
003100     05  NAME-OF-PROGRAM     PIC X(08) VALUE "TPMOD4  ".
003200     05  PROGRAM-TYPE        PIC X(02) VALUE "MA".
003300     05  PROGRAM-RELEASE     PIC X(12) VALUE " C0100010001".
003400     05  PROGRAM-DESCRIPTION.
003500         10  PROG-DESC-A     PIC X(60) VALUE
003600             "PERSONNEL IDENTIFICATION DATA MODIFY PROGRAM "     .
003700         10  PROG-DESC-B     PIC X(60) VALUE SPACES.
003900         10  PROG-FUNCTION   PIC X(60) VALUE SPACES.
004100     05  PASSWORD-FLAG       PIC X.
006400 01  PER-IDENTIFICATION.          COPY DPERCONF OF COPYLIB.
004200 01  SCREEN-PRINT-PARMS.
004300     05 PRINTCNTL                 PIC S9(4) COMP VALUE 0.
004400     05 PAGECNTL                  PIC S9(4) COMP VALUE 49.
004500     05 SPOOLFIL-OPEN-SW          PIC X VALUE "N".
006800 01  SCREEN-TABLES.
006900     05 SCREEN-CC                 PIC X(4).
007000     05 SCREEN OCCURS 10 TIMES.
007100         10 SCRN-DEF              PIC X(30).
007200         10 SCRN-VAL              PIC X(20).
           05  SCREEN-CMD-LINE          PIC X(79).
           05  SCREEN-ERR-LINE          PIC X(79).
006100 01  S1                           PIC S9(4) COMP-4.
       01  TRUE-VAL                     PIC 1 VALUE B"1".
007300 COPY WSCONTROL OF COPYLIB.
007400 LINKAGE SECTION.
007500 01  DBPARAMETERS.                COPY DBPARMS  OF COPYLIB.
007600 COPY VCOMLINK OF COPYLIB.
007700 01  PLT-IDT                      PIC X(4).
007900 01  PER-PERSONNEL.               COPY MPERSONL OF COPYLIB.
008000
008100 PROCEDURE DIVISION USING DBPARAMETERS
008200                          VIEW-COMAREA
008300                          PLT-IDT
008500                          PER-PERSONNEL.
008600 START-PGM.
           PERFORM 1-HSK.
           PERFORM 6-MAIN THRU 6-MAIN-EXIT.
       2-EOJ.
           CLOSE DISPLAY-FILE.
           CLOSE PER-CONF-MSTR.
           CLOSE PER-CONFIDENTIAL.
           GOBACK.
       1-HSK.
           OPEN I-O   DISPLAY-FILE.
           OPEN INPUT PER-CONF-MSTR.
           OPEN I-O   PER-CONFIDENTIAL.
008800     CALL "TPWORD" USING PASSWORD-INFORMATION.
009200     IF PASSWORD-FLAG OF PASSWORD-INFORMATION = "N" GO TO 2-EOJ.
011400     MOVE SPACES TO SCREEN-TABLES ERROR-BUFFER.
011500     MOVE PER-CC-NUM TO SCREEN-CC.
           MOVE "N" TO MODIFY-SW.
           MOVE 1 TO FORM-SW.
009500 6-MAIN.
012600     PERFORM 61-READ-CODES THRU 61-EXIT UNTIL COND-WORD = 11.
012700     PERFORM 61-READ-IDENT.
012800     PERFORM 62-DISPLAY-SCREEN.
012900     PERFORM 63-READ-SCREEN THRU 63-READ-EXIT.
013000     IF MODIFY-SW = "Y"
013100         NEXT SENTENCE
013200     ELSE
013300     GO TO 6-MAIN-EXIT.
013400     MOVE 39007 TO CATREAD-MSG-NUMBER.
013600     PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
           MOVE ERROR-BUFFER TO SCREEN-CMD-LINE.
           MOVE SCREEN-TABLES TO DSPLY-REC.
           MOVE TRUE-VAL TO INDS (98).
           PERFORM 99-SCREEN-WRITE.
           PERFORM 98A-SCREEN-READ.
           CALL "CLPAUSE2".
014700     PERFORM 64-DEL.
014800     PERFORM 64-ADD THRU 64-EXIT VARYING S1 FROM 1 BY 1
014900         UNTIL S1 > 10.
           MOVE 66189 TO CATREAD-MSG-NUMBER.
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
           MOVE ERROR-BUFFER TO SCREEN-CMD-LINE.
           MOVE TRUE-VAL TO INDS (98).
           PERFORM 99-SCREEN-WRITE.
           PERFORM 98A-SCREEN-READ.
           CALL "CLPAUSE2".
       6-MAIN-EXIT.    EXIT.

015300 61-READ-CODES.
015400     MOVE 0 TO COND-WORD.
015500     READ PER-CONF-MSTR NEXT INTO ITEM-BUFFER
015600         AT END    MOVE 11 TO COND-WORD.
015700     IF PCM-STATUS NOT = "00" MOVE 11 TO COND-WORD.
016200     IF COND-WORD = 11 GO TO 61-EXIT.
016900     MOVE ITEM-B TO BYTE-99.
017000     MOVE BYTE-99 TO S1.
017100     MOVE DEFN-B TO SCRN-DEF (S1).
017200 61-EXIT.    EXIT.
017300
017400 61-READ-IDENT.
017500     MOVE 0 TO COND-WORD.
017700     MOVE PER-CC-NUM TO PERCCNUM OF PCREC.
017800     START PER-CONFIDENTIAL KEY IS = EXTERNALLY-DESCRIBED-KEY
017900         INVALID KEY    MOVE 17 TO COND-WORD.
018000     IF PC-STATUS NOT = "00" MOVE 17 TO COND-WORD.
018100     IF COND-WORD NOT = 0 GO TO 2-EOJ.
018200     READ PER-CONFIDENTIAL NEXT INTO PER-IDENTIFICATION
018300         AT END    MOVE 15 TO COND-WORD.
           IF PER-CC-NUM NOT = PERCCNUM OF PCREC MOVE 15 TO COND-WORD.
018400     IF PC-STATUS NOT = "00" MOVE 15 TO COND-WORD.
           IF COND-WORD = 15 GO TO 2-EOJ.
018900     PERFORM 61-GET-IDENT THRU 61-GET-EXIT UNTIL COND-WORD = 15.
019000 61-GET-IDENT.
019100     MOVE PER-CONF-ITEM TO BYTE-99.
019200     MOVE BYTE-99 TO S1.
019300     MOVE PER-CONF-DATA TO SCRN-VAL (S1).
019400     MOVE 0 TO COND-WORD.
019500     READ PER-CONFIDENTIAL NEXT INTO PER-IDENTIFICATION
019600         AT END    MOVE 15 TO COND-WORD.
           IF PER-CC-NUM NOT = PERCCNUM OF PCREC
               MOVE 15 TO COND-WORD.
           IF PC-STATUS NOT = "00" MOVE 15 TO COND-WORD.
019700     IF COND-WORD = 0 OR 15
019800       NEXT SENTENCE
019900     ELSE
020000     GO TO 2-EOJ.
020100 61-GET-EXIT.    EXIT.
020200 62-DISPLAY-SCREEN.
020300     MOVE "FPDISP4" TO VIEW-CFNAME.
           MOVE 66182 TO CATREAD-MSG-NUMBER.
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
           MOVE ERROR-BUFFER TO SCREEN-CMD-LINE.
           MOVE SCREEN-TABLES TO DSPLY-REC.
           PERFORM 99-SCREEN-WRITE.
021500 63-READ-SCREEN.
021600     PERFORM 98-SCREEN-READ.
           MOVE DSPLY-REC TO SCREEN-TABLES.
022600     IF VIEW-LASTKEY = 3 GO TO 2-EOJ.
023900     IF VIEW-LASTKEY = 5
024000         IF FORM-SW = 1
024100             CALL "TPWORD" USING PASSWORD-INFORMATION1
024500             IF PASSWORD-FLAG OF PASSWORD-INFORMATION1 = "N"
024600                 GO TO 2-EOJ
024700             ELSE
024800             MOVE 2 TO FORM-SW
024900             MOVE "FPDISP4A" TO VIEW-CFNAME
                   MOVE 66199 TO CATREAD-MSG-NUMBER
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE ERROR-BUFFER TO SCREEN-CMD-LINE
                   MOVE SCREEN-TABLES TO DSPLY-REC
                   PERFORM 99-SCREEN-WRITE
025500             GO TO 63-READ-SCREEN
025600         ELSE
025700         NEXT SENTENCE
025800     ELSE
           MOVE SCREEN-TABLES TO DSPLY-REC
025900     PERFORM 99-SCREEN-WRITE
026000     GO TO 63-READ-SCREEN.
026800     MOVE "Y" TO MODIFY-SW.
026900 63-READ-EXIT.    EXIT.
027000
027100 64-DEL.
027200     MOVE 0 TO COND-WORD.
027300     MOVE PER-CC-NUM TO PERCCNUM OF PCREC.
027400     START PER-CONFIDENTIAL KEY IS = EXTERNALLY-DESCRIBED-KEY
027500         INVALID KEY    MOVE 17 TO COND-WORD.
027600     IF PC-STATUS NOT = "00" MOVE 17 TO COND-WORD.
027700     IF COND-WORD NOT = 0 GO TO 2-EOJ.
027900     READ PER-CONFIDENTIAL NEXT INTO PER-IDENTIFICATION
028000         AT END    MOVE 15 TO COND-WORD.
           IF PER-CC-NUM NOT = PERCCNUM OF PCREC
               MOVE 15 TO COND-WORD.
028100     IF PC-STATUS NOT = "00" MOVE 15 TO COND-WORD.
028200     IF COND-WORD = 0 OR 15
028300       NEXT SENTENCE
028400     ELSE
028500     GO TO 2-EOJ.
028600     PERFORM 64-DEL-CONT UNTIL COND-WORD = 15.
028700 64-DEL-CONT.
028800     MOVE 0 TO COND-WORD.
028900     DELETE PER-CONFIDENTIAL RECORD
029000         INVALID KEY    MOVE 17 TO COND-WORD.
029100     IF PC-STATUS NOT = "00" MOVE 17 TO COND-WORD.
           IF COND-WORD = 17 GO TO 2-EOJ.
           READ PER-CONFIDENTIAL NEXT INTO PER-IDENTIFICATION
029200         AT END    MOVE 15 TO COND-WORD.
           IF PER-CC-NUM NOT = PERCCNUM OF PCREC
               MOVE 15 TO COND-WORD.
029300     IF PC-STATUS NOT = "00" MOVE 15 TO COND-WORD.
029400     IF COND-WORD = 0 OR 15
029500       NEXT SENTENCE
029600     ELSE
029700     GO TO 2-EOJ.
029800 64-ADD.
029900     IF SCRN-VAL (S1) = SPACES GO TO 64-EXIT.
030000     MOVE PER-CC-NUM TO PER-CONF-CC.
030100     MOVE S1 TO BYTE-99.
030200     MOVE BYTE-99 TO PER-CONF-ITEM.
030300     MOVE SCRN-VAL (S1) TO PER-CONF-DATA.
030400     MOVE 0 TO COND-WORD.
030500     WRITE PCREC FROM PER-IDENTIFICATION
030600         INVALID KEY    MOVE 17 TO COND-WORD.
           IF PC-STATUS NOT = "00" MOVE 17 TO COND-WORD.
030700     IF COND-WORD = 0 OR 102
030800       NEXT SENTENCE
030900     ELSE
031000     GO TO 2-EOJ.
031100 64-EXIT.    EXIT.

       98-SCREEN-READ.
           READ DISPLAY-FILE FORMAT IS VIEW-CFNAME
               INDIC IS INDICS.
           ACCEPT IOFEEDBACK FROM I-O-FEEDBACK-AREA.
           MOVE ALL B"0" TO INDICS.
           IF DSPLY-STATUS NOT = "00"
               MOVE 3 TO VIEW-LASTKEY
           ELSE
           MOVE FUNCTION-NUM TO VIEW-LASTKEY.

       98A-SCREEN-READ.
           READ DISPLAY-FILE TERMINAL IS TERMINAL-ID
               INDIC IS INDICS
                  NO DATA MOVE DSPLY-STATUS TO DSPLY-STATUS.
           MOVE ALL B"0" TO INDICS.

       99-SCREEN-WRITE.
           WRITE DSPLY-REC FORMAT IS VIEW-CFNAME
               INDIC IS INDICS.
           MOVE ALL B"0" TO INDICS.

051100 999-CATREAD.
024000     MOVE SPACES TO ERROR-BUFFER.
024100     CALL "CCATREAD" USING CATREAD-PARMS.
024200     MOVE CATREAD-MSG-TEXT TO ERROR-BUFFER.
052100 999-CATREAD-EXIT.
052200     EXIT.
