       IDENTIFICATION DIVISION.
       PROGRAM-ID.             TUSGVLRP.
       AUTHOR.                 ANNETTE TREUDLER.
       INSTALLATION.           GOODYEAR TIRE & RUBBER.
       DATE-WRITTEN.           NOV. 1987.
      *C
      *C 09/12/96  JEFF BUNGO
      *C   EXPAND DATE FIELDS FOR YEAR 2000 COMPLIANCE.
      *C   RECOMPILE TO PICK UP COPYLIB CHANGES.
      *C
      *C 02/26/97  JEFF BUNGO
      *C   CHANGED CLRPFM STATEMENT TO *CURLIB INSTEAD OF MCPRD1.
      *C

       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.
       SOURCE-COMPUTER.        IBM-AS400.
       OBJECT-COMPUTER.        IBM-AS400.
       SPECIAL-NAMES.          C01 IS NEW-PAGE.
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT MPLTINFO
                  ASSIGN TO DATABASE-MCFLCS0501
                  ORGANIZATION IS INDEXED
                  ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                  FILE STATUS IS FILE-STAT.

           SELECT MSTORERM
                  ASSIGN TO DATABASE-MCFLCS0201
                  ORGANIZATION IS INDEXED
                  ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                  FILE STATUS IS FILE-STAT.

           SELECT HUSGFILE
                  ASSIGN TO DISK-MCFPHUSGVL
                  ORGANIZATION IS SEQUENTIAL
                  ACCESS MODE IS SEQUENTIAL
                  FILE STATUS IS FILE-STAT.

           SELECT PRINT-FILE
                  ASSIGN TO PRINTER-MCPRT.

           SELECT SORT-FILE
                  ASSIGN TO DISK-SORTFILE.

       DATA DIVISION.
       FILE SECTION.
       FD  MPLTINFO
           LABEL RECORDS ARE STANDARD.
       01  MPLTINFO-REC.
           COPY DDS-MCRPCS0500  OF MCFLCS0501.

       FD  MSTORERM
           LABEL RECORDS ARE STANDARD.
       01  MSTORERM-REC.
           COPY DDS-MCRPCS0200  OF MCFLCS0201.

       FD  HUSGFILE
           RECORD CONTAINS 18 CHARACTERS
           DATA RECORD IS HUSG-REC.
       01  HUSG-REC.
           05  HUSG-CODE       PIC X(7).
           05  HUSG-QTY        PIC 9(11).

       FD  PRINT-FILE
           DATA RECORD IS PRT-REC
           RECORD CONTAINS 133 CHARACTERS
           LABEL RECORDS ARE OMITTED.
       01  PRT-REC             PIC X(133).

       SD  SORT-FILE
           DATA RECORD IS SORT-REC
           RECORD CONTAINS 18  CHARACTERS.
       01  SORT-REC.
           05  SORT-CODE       PIC X(7).
           05  SORT-QTY        PIC 9(11).

       WORKING-STORAGE SECTION.
       77  LINE-CTR            PIC 99       VALUE 0.
       77  PAGE-CTR            PIC 9(4)     VALUE 0.
       77  SORT-EOF            PIC X(1)     VALUE "N".
           88  NO-MORE-RECORDS              VALUE "Y".
       77  TRANS-SW            PIC X(1)     VALUE "N".
           88  TRANSACTION-COMPLETED        VALUE "Y".
       77  HUSG-EOF            PIC X(1)     VALUE "N".
           88  ALL-RECORDS-READ             VALUE "Y".
       77  NO-RECORDS          PIC X(133)   VALUE
           " NO ITEMS QUALIFIED FOR THE REPORT".
       77  SAVE-CODE           PIC X(7)     VALUE SPACES.
       77  INV-VALUE           PIC 9(15)V99 VALUE ZEROS.
       77  TOTAL-VALUE         PIC 9(16)V99 VALUE ZEROS.
       77  BLANK-LINE          PIC X(133)   VALUE SPACES.
       77  ROUTE-LINE          PIC X(80).
       77  BASE-PARM           PIC X(12)    VALUE SPACES.
       77  COMMAND-WORK        PIC X(70).
       77  COMMAND-LEN         PIC S9(10)V9(5) COMP-3 VALUE 70.


       01  FILE-STAT.
           05 FILE-STAT-1      PIC X   VALUE "0".
           05 FILE-STAT-2      PIC X   VALUE "0".

       01  ARG-VALUES.
           05  MSTORERM-ARG    PIC X(8)     VALUE SPACES.
           05  MPLTINFO-ARG    PIC X(4)     VALUE "P 01".

       01  HEADER-1.
           05  FILLER          PIC X      VALUE SPACES.
           05  FILLER          PIC X(49)
               VALUE "TUSGVLRP".
           05  FILLER          PIC X(69)
               VALUE "  HIGH USAGE INVENTORY VALUES ".
           05  FILLER          PIC X(6)   VALUE "PLANT ".
           05  PLANT-H1        PIC X(3)   VALUE SPACES.
           05  FILLER          PIC X(5)   VALUE SPACES.

       01  HEADER-2.
           05  FILLER          PIC X      VALUE SPACES.
           05  H2-DATE         PIC X(8)   VALUE SPACES.
           05  FILLER          PIC X(5)   VALUE SPACES.
           05  H2-TIME         PIC X(8)   VALUE SPACES.
           05  FILLER          PIC X(95)  VALUE SPACES.
           05  H2-PAGE         PIC X(6)   VALUE "PAGE :".
           05  H2-PAGE-NO      PIC Z,ZZ9  VALUE ZEROS.
           05  FILLER          PIC X(5)   VALUE SPACES.

       01  HEADER-3.
           05  FILLER          PIC X(6)   VALUE SPACES.
           05  FILLER          PIC X(9)   VALUE "CORP CODE".
           05  FILLER          PIC X(4)   VALUE SPACES.
           05  FILLER          PIC X(16)  VALUE
                                          "QUANTITY ON HAND".
           05  FILLER          PIC X(5)   VALUE SPACES.
           05  FILLER          PIC X(3)   VALUE "U/M".
           05  FILLER          PIC X(10)  VALUE SPACES.
           05  FILLER          PIC X(12)  VALUE
               "AVERAGE COST".
           05  FILLER          PIC X(11)  VALUE SPACES.
           05  FILLER          PIC X(15)  VALUE
               "INVENTORY VALUE".
           05  FILLER          PIC X(42)  VALUE SPACES.

       01  DETAIL-LINE.
           05  FILLER          PIC X(7)   VALUE SPACES.
           05  DL1-CODE        PIC X(7).
           05  FILLER          PIC X(7)   VALUE SPACES.
           05  DL1-QTY         PIC ZZ,ZZZ,ZZZ,ZZ9.
           05  FILLER          PIC X(6)   VALUE SPACES.
           05  DL1-UM          PIC X(2).
           05  FILLER          PIC X(3)   VALUE SPACES.
           05  DL1-AVGCOST     PIC ZZ,ZZZ,ZZZ,ZZZ.9(4).
           05  FILLER          PIC X(4)   VALUE SPACES.
           05  DL1-INV-VALUE   PIC ZZZ,ZZZ,ZZZ,ZZZ,ZZZ.9(2).
           05  FILLER          PIC X(2)   VALUE SPACES.
           05  DL1-MESSAGE     PIC X(40).

       01  DETAIL-LINE2.
           05  FILLER          PIC X(93)  VALUE SPACES.
           05  DL2-MESSAGE     PIC X(40).

       01  DETAIL-LINE3.
           05  DL3-CODE        PIC X(7).
           05  FILLER          PIC X(86)  VALUE SPACES.
           05  DL3-MESSAGE     PIC X(40).

       01  TOTAL-LINE.
           05  FILLER          PIC X      VALUE SPACES.
           05  FILLER          PIC X(10)  VALUE ALL "*".
           05  FILLER          PIC X(12)  VALUE "  TOTAL".
           05  TOTAL-VALUE-OUT PIC $$,$$$,$$$,$$$,$$$,$$9.99.
           05  FILLER          PIC X(5)   VALUE SPACES.
           05  FILLER          PIC X(10)  VALUE ALL "*".
           05  FILLER          PIC X(70)  VALUE SPACES.

       01  STR-HIGH-USAGE-OUT.
           05  FILLER          PIC X(20)  VALUE
               "* HIGH USAGE AREAS: ".
           05  SHUO-1          PIC X(2).
           05  FILLER          PIC X(1)   VALUE SPACES.
           05  SHUO-2          PIC X(2).
           05  FILLER          PIC X(1)   VALUE SPACES.
           05  SHUO-3          PIC X(2).
           05  FILLER          PIC X(1)   VALUE SPACES.
           05  SHUO-4          PIC X(2).
           05  FILLER          PIC X(1)   VALUE SPACES.
           05  SHUO-5          PIC X(2).
           05  FILLER          PIC X(1)   VALUE SPACES.
           05  SHUO-6          PIC X(2).
           05  FILLER          PIC X(3)   VALUE SPACES.

       01  ESC-INFO.
           05  COMPRESS-PRINT  PIC X(8).
           05  NORMAL-PRINT    PIC X(8).
           05  EXPAND-PRINT    PIC X(8).

       01  BUF-MPLTINFO.
           05  MPLTINFO-KEY    PIC X(4).
           05  MPLTINFO-DATA   PIC X(60).
           COPY MPLTP01        IN COPYLIB.

           COPY THDPRT         IN COPYLIB.

           COPY VCOMLINK       IN COPYLIB.

           COPY TDATECHK       IN COPYLIB.

           COPY TBLOWUP        IN COPYLIB.

           COPY MSTORERM       IN COPYLIB.

           COPY DATAB          IN COPYLIB.

           COPY ESCNAM2        IN COPYLIB.

       PROCEDURE DIVISION.
       BEGIN-PROCESSING SECTION 01.
       BEGIN-PROC.
           OPEN INPUT          MPLTINFO.
           OPEN INPUT          MSTORERM.
           OPEN OUTPUT         PRINT-FILE.

           ACCEPT              HD-ROUTE-DATA.
           MOVE "DHDUSGVL"     TO HD-FILE-NAME.
           CALL "THDPRT2"      USING HD-RET-CODE
                                     HD-FILE-NAME
                                     FNUM
                                     HD-ROUTE-DATA
                                     ESC-NAME.
           IF HD-RET-CODE NOT = 0
               MOVE "THDPRT2 ERROR * USGVLRP"
                               TO BU-DISPLAY-MSG
               MOVE "HD-RET-CODE = " TO BU-DISPLAY-FLD (1)
               MOVE HD-RET-CODE      TO BU-DISPLAY-FLD9(1)
               PERFORM 990-BLOWUP.

           CALL "TESCSEQ" USING ESC-NAME.
           MOVE CHAR-1636PI    TO COMPRESS-PRINT.
           MOVE CHAR-10PI      TO NORMAL-PRINT.
           MOVE CHAR-5PI       TO EXPAND-PRINT.

           MOVE 1              TO DATE-MODE.
           CALL "TDATECHK" USING DATE-CHECK-AREA.
           MOVE DATE-FORMATTED-TIME-OUT TO H2-TIME.
           MOVE DATE-SLASH-OUT TO H2-DATE.

           MOVE MPLTINFO-ARG   TO PLTINFOKEY OF MPLTINFO.
           READ MPLTINFO       INTO BUF-MPLTINFO
               INVALID KEY MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
               MOVE "DBGET ERROR IN 300-GET-PARMS"
                               TO BU-DISPLAY-MSG
               MOVE "P 01"     TO BU-DISPLAY-FLD (1)
               PERFORM 990-BLOWUP.
           MOVE MPLTINFO-COMPANY TO PLANT-H1.

           SORT SORT-FILE ASCENDING KEY SORT-CODE
                                        SORT-QTY
               INPUT  PROCEDURE  700-PROCESS-CODES
               OUTPUT PROCEDURE  800-WRITE-REPORT.

           WRITE PRT-REC FROM  NORMAL-PRINT AFTER ADVANCING 0 LINES.
           MOVE "Y"            TO TRANS-SW.

       END-OF-JOB.
           CLOSE               HUSGFILE.
           IF TRANSACTION-COMPLETED
               MOVE "CLRPFM FILE(*CURLIB/MCFPHUSGVL) MBR(*FIRST)"
                               TO  COMMAND-WORK
               CALL "QCMDEXC" USING COMMAND-WORK COMMAND-LEN.
           CLOSE               PRINT-FILE.
           CLOSE               MPLTINFO.
           CLOSE               MSTORERM.
           GOBACK.

       990-BLOWUP.
           WRITE PRT-REC FROM NORMAL-PRINT AFTER ADVANCING 0 LINES.
           MOVE "TUSGVLRP"     TO BU-PGM-NAME.
           CALL "TBLOWUP" USING BASE-PARM
                                BU-PGM-NAME
                                STATUS-AREA
                                VIEW-COMAREA
                                FILE-STAT
                                BU-DISPLAY-MSG
                                BU-DISPLAY-AREA.
           GO TO END-OF-JOB.

       700-PROCESS-CODES SECTION 02.
       700-PROCESS-SORT.
           PERFORM 700-PROC-CODES THRU 799-EXIT.
           GO TO 700-PROCESS-SORT-EXIT.

       700-PROC-CODES.
           OPEN INPUT          HUSGFILE.
           READ HUSGFILE       AT END MOVE "YES" TO HUSG-EOF.
           IF ALL-RECORDS-READ GO TO 799-EXIT.
           PERFORM 710-PROCESS-CODES
                               UNTIL ALL-RECORDS-READ.
           GO TO 799-EXIT.

       710-PROCESS-CODES.
           MOVE HUSG-CODE      TO SORT-CODE.
           MOVE HUSG-QTY       TO SORT-QTY.
           RELEASE SORT-REC.
           READ HUSGFILE       AT END MOVE "YES" TO HUSG-EOF.

       799-EXIT.    EXIT.

       700-PROCESS-SORT-EXIT.    EXIT.

       800-WRITE-REPORT SECTION 03.
       800-WRITE-SORT.
           PERFORM 800-WRITE-RPT THRU 899-EXIT.
           GO TO 800-WRITE-SORT-EXIT.

       800-WRITE-RPT.
           RETURN SORT-FILE    AT END
               MOVE "Y"        TO SORT-EOF.
           IF PAPER-IS-132-COLS
               NEXT SENTENCE
           ELSE
               WRITE PRT-REC FROM COMPRESS-PRINT
                   AFTER ADVANCING 0 LINES.

           PERFORM 890-NEW-PAGE.
           IF NO-MORE-RECORDS
               WRITE PRT-REC FROM NO-RECORDS AFTER ADVANCING 2 LINES
               GO TO 899-EXIT.

           PERFORM 810-PROCESS-SORT-FILE THRU 810-EXIT
                               UNTIL NO-MORE-RECORDS.
           PERFORM 820-WRITE-TOTAL.
           GO TO 899-EXIT.

       810-PROCESS-SORT-FILE.
           MOVE SORT-CODE      TO CORPCDE OF MSTORERM.
           READ MSTORERM       INTO BUF-MSTORERM
               INVALID KEY MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT = "23"
               MOVE SORT-CODE  TO DL3-CODE
               MOVE "***  CODE NOT IN MSTORERM  ***"
                               TO DL3-MESSAGE
               WRITE PRT-REC   FROM DETAIL-LINE3
                               AFTER ADVANCING 1 LINES
               ADD  1          TO LINE-CTR
               GO TO 810-CONT
           ELSE
           IF FILE-STAT NOT = "00"
               MOVE "DBGET MSTORERM ERROR * 710-PC"
                               TO BU-DISPLAY-MSG
               MOVE SORT-CODE  TO BU-DISPLAY-FLD (1)
               PERFORM 890-BLOWUP.

           MOVE SORT-CODE      TO DL1-CODE.
           MOVE SORT-QTY       TO DL1-QTY.
           MOVE STR-UM         TO DL1-UM.
           MOVE STR-AVG-COST   TO DL1-AVGCOST.
           MULTIPLY SORT-QTY BY STR-AVG-COST GIVING INV-VALUE ROUNDED.
           ADD  INV-VALUE      TO TOTAL-VALUE.
           MOVE INV-VALUE      TO DL1-INV-VALUE.

           IF SORT-CODE = SAVE-CODE
               MOVE
               "*** DUPLICATE CODE IN FILE ***"
                               TO DL1-MESSAGE
           ELSE
               MOVE SPACES     TO DL1-MESSAGE.

           IF STR-HIGH-USAGE-AREA (1) NOT > SPACES
               IF DL1-MESSAGE = SPACES
                   MOVE
               "*** NOT A HIGH USAGE CODE  ***"
                               TO DL1-MESSAGE
                   WRITE PRT-REC FROM DETAIL-LINE
                       AFTER ADVANCING 1 LINES
               ELSE
                   WRITE PRT-REC FROM DETAIL-LINE
                       AFTER ADVANCING 1 LINES
                   MOVE
               "*** NOT A HIGH USAGE CODE  ***"
                               TO DL2-MESSAGE
                   WRITE PRT-REC FROM DETAIL-LINE2
                       AFTER ADVANCING 1 LINES
                   ADD  1      TO LINE-CTR
           ELSE
               MOVE STR-HIGH-USAGE-AREA (1) TO SHUO-1
               MOVE STR-HIGH-USAGE-AREA (2) TO SHUO-2
               MOVE STR-HIGH-USAGE-AREA (3) TO SHUO-3
               MOVE STR-HIGH-USAGE-AREA (4) TO SHUO-4
               MOVE STR-HIGH-USAGE-AREA (5) TO SHUO-5
               MOVE STR-HIGH-USAGE-AREA (6) TO SHUO-6
               IF DL1-MESSAGE = SPACES
                   MOVE STR-HIGH-USAGE-OUT
                               TO DL1-MESSAGE
                   WRITE PRT-REC FROM DETAIL-LINE
                       AFTER ADVANCING 1 LINES
                   ADD  1      TO LINE-CTR
               ELSE
                   WRITE PRT-REC FROM DETAIL-LINE
                       AFTER ADVANCING 1 LINES
                   MOVE STR-HIGH-USAGE-OUT
                               TO DL2-MESSAGE
                   WRITE PRT-REC FROM DETAIL-LINE2
                       AFTER ADVANCING 1 LINES
                   ADD  2      TO LINE-CTR.

       810-CONT.
           WRITE PRT-REC FROM BLANK-LINE AFTER ADVANCING 1 LINES.
           ADD  1              TO LINE-CTR.

           MOVE SORT-CODE      TO SAVE-CODE.
           RETURN SORT-FILE    AT END
               MOVE "Y"        TO SORT-EOF.

           IF NOT NO-MORE-RECORDS
               IF LINE-CTR > 58
                   PERFORM 890-NEW-PAGE.

       810-EXIT.    EXIT.

       820-WRITE-TOTAL.
           MOVE  TOTAL-VALUE   TO TOTAL-VALUE-OUT.
           WRITE PRT-REC FROM TOTAL-LINE AFTER ADVANCING 3 LINES.

       890-NEW-PAGE.
           WRITE PRT-REC FROM HEADER-1 AFTER ADVANCING NEW-PAGE.
           ADD  1              TO PAGE-CTR.
           MOVE PAGE-CTR       TO H2-PAGE-NO.
           WRITE PRT-REC FROM HEADER-2 AFTER ADVANCING 1 LINES.
           WRITE PRT-REC FROM HEADER-3 AFTER ADVANCING 2 LINES.
           WRITE PRT-REC FROM BLANK-LINE AFTER ADVANCING 1 LINES.
           MOVE 5              TO LINE-CTR.

       899-EXIT.    EXIT.

       890-BLOWUP.
           WRITE PRT-REC FROM NORMAL-PRINT AFTER ADVANCING 0 LINES.
           MOVE "TUSGVLRP"      TO BU-PGM-NAME.
           CALL "TBLOWUP" USING BASE-PARM
                                BU-PGM-NAME
                                STATUS-AREA
                                VIEW-COMAREA
                                FILE-STAT
                                BU-DISPLAY-MSG
                                BU-DISPLAY-AREA.
           CLOSE                HUSGFILE.
           CLOSE                PRINT-FILE.
           CLOSE                MPLTINFO.
           CLOSE                MSTORERM.
           GOBACK.

       800-WRITE-SORT-EXIT.    EXIT.

