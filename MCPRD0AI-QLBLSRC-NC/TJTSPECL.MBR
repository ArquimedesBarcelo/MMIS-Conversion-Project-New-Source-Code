       IDENTIFICATION DIVISION.
       PROGRAM-ID.  TJTSPECL.
       DATE-COMPILED.
      ************************************************************
      ** THIS PROGRAM REPORTS ON MSTORERM ITEMS WITH NO         **
      ** ACTIVITY SINCE 19980101. IT EXCLUDES INSURANCE ITEMS   **
      ** AND PROVIDES THE CURRENT ONHAND AND AVERAGE COST       **
      ** VALUES FLAGGING CODED NON-STORES ITEMS WITH AN '*'     **
      ************************************************************
       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.
       COPY SPECIALN OF COPYLIB.
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT MPLTINFO
               ASSIGN TO DATABASE-MCFLCS0501
               ORGANIZATION IS INDEXED
               ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
               FILE STATUS IS FILE-STATUS.

           SELECT MSTORERM
               ASSIGN TO DATABASE-MCFLCS0201
               ORGANIZATION IS INDEXED
                 ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
               FILE STATUS IS FILE-STATUS.

           SELECT PRINT-FILE ASSIGN TO PRINTER-MCPRT.

           SELECT SORT-FILE ASSIGN TO DISK-SORTFILE.

       DATA DIVISION.
       FILE SECTION.
       FD  MPLTINFO
           LABEL RECORDS ARE STANDARD.
       01  MPLTINFO-REC.
           COPY DDS-MCRPCS0500  OF MCFLCS0501.

       FD  MSTORERM
           LABEL RECORDS ARE STANDARD.
       01  MSTORERM-REC.
           COPY DDS-MCRPCS0200  OF MCFLCS0201.

       FD  PRINT-FILE
           LABEL RECORDS ARE OMITTED
           RECORD CONTAINS 132 CHARACTERS
           DATA RECORD IS PRINT-REC.
       01  PRINT-REC                     PIC X(132).

       SD  SORT-FILE RECORD CONTAINS 128 CHARACTERS
           DATA RECORD IS SORT-REC.
       01  SORT-REC.
           05  SORT-SN                   PIC X.
           05  SORT-CORPCODE             PIC X(8).
           05  SORT-DFLTDEPT             PIC X(4).
           05  SORT-DESC                 PIC X(50).
           05  SORT-UM                   PIC XX.
           05  SORT-ONHAND               PIC S9(8).
           05  SORT-AVG-COST             PIC S9(6)V9(4).
           05  SORT-LASTISS              PIC X(8).
           05  SORT-LASTACT              PIC X(8).
           05  SORT-LASTPO               PIC X(10).
           05  SORT-LASTREQ              PIC X(8).
           05  SORT-REQDATE              PIC X(8).
           05  FILLER                    PIC X(3).

       WORKING-STORAGE SECTION.
       77  DISP-AVG-COST                 PIC Z(10)9.9(4).
       77  DISP-ONHAND                   PIC Z(7)9.
       77  DISP-TOTAL-COST               PIC Z(10)9.99.
       77  GRAND-TOTAL-COST              PIC S9(12)V99.
       77  LINE-CTR                      PIC 99.
       77  SAVE-DFLT-DEPT                PIC X(4).
       77  SAVE-PLANT-NAME               PIC X(15).
       77  SUB                           PIC S9(4) COMP-4.
       77  TOT-CDS-CTR                   PIC 9(5).
       77  TOT-INS-CTR                   PIC 9(5).
       77  TOTAL-COST                    PIC S9(12)V9(4).
       01  HANDLE-BLOWUP-FLAG            PIC X(1)  VALUE "Y".

       01  D1.
           05  D1-SN   PIC X.
           05  FILLER  PIC X.
           05  D1-CC   PIC X(7).
           05  FILLER  PIC X.
           05  D1-DFLD PIC X(4).
           05  FILLER  PIC X.
           05  D1-KM   PIC X(50).
           05  FILLER  PIC X.
           05  D1-UM   PIC XX.
           05  FILLER  PIC X.
           05  D1-ONH  PIC Z(5)9.
           05  FILLER  PIC X.
           05  D1-AVG  PIC Z(5)9.99.
           05  FILLER  PIC X.
           05  D1-LISS PIC X(8).
           05  FILLER  PIC X.
           05  D1-LACT PIC X(8).
           05  FILLER  PIC X.
           05  D1-LPO  PIC X(10).
           05  FILLER  PIC X.
           05  D1-LREQ PIC X(8).
           05  FILLER  PIC X.
           05  D1-RDAT PIC X(8).
           05  FILLER  PIC X(2).

       01  H1.
           05  FILLER  PIC X(02) VALUE SPACES.
           05  FILLER  PIC X(07) VALUE "CORPCDE".
           05  FILLER  PIC X     VALUE SPACE.
           05  FILLER  PIC X(4)  VALUE "DFLT".
           05  FILLER  PIC X     VALUE SPACE.
           05  FILLER  PIC X(50) VALUE "KEYWORD/MODIFIER ".
           05  FILLER  PIC X     VALUE SPACE.
           05  FILLER  PIC X(02) VALUE "UM".
           05  FILLER  PIC X     VALUE SPACE .
           05  FILLER  PIC X(06) VALUE "ONHAND".
           05  FILLER  PIC XX    VALUE SPACE.
           05  FILLER  PIC X(09) VALUE "AVG COST ".
           05  FILLER  PIC X(08) VALUE "LASTISS ".
           05  FILLER  PIC X     VALUE SPACE.
           05  FILLER  PIC X(08) VALUE "LASTACT ".
           05  FILLER  PIC X     VALUE SPACE.
           05  FILLER  PIC X(10) VALUE "LASTPO    ".
           05  FILLER  PIC X     VALUE SPACE.
           05  FILLER  PIC X(08) VALUE "LASTREQ ".
           05  FILLER  PIC X     VALUE SPACE.
           05  FILLER  PIC X(08) VALUE "REQ DATE".
           05  FILLER  PIC X(02) VALUE SPACES.

       01  PLANTS-TABLE.
           05  PLANT-TAB.
               10  FILLER  PIC X(18) VALUE "111AKRON PLANT I  ".
               10  FILLER  PIC X(18) VALUE "112AKRON PLANT II ".
               10  FILLER  PIC X(18) VALUE "113AKRON PLANT III".
               10  FILLER  PIC X(18) VALUE "115AKRON PLANT V  ".
               10  FILLER  PIC X(18) VALUE "118AKRON STOW MOLD".
               10  FILLER  PIC X(18) VALUE "119AKRON RESEARCH ".
               10  FILLER  PIC X(18) VALUE "120SPARTANBURG    ".
               10  FILLER  PIC X(18) VALUE "126DANVILLE       ".
               10  FILLER  PIC X(18) VALUE "129UNION CITY     ".
               10  FILLER  PIC X(18) VALUE "130SOCIAL CIRCLE  ".
               10  FILLER  PIC X(18) VALUE "131GADSDEN        ".
               10  FILLER  PIC X(18) VALUE "133TOPEKA         ".
               10  FILLER  PIC X(18) VALUE "152GREENSBURG     ".
               10  FILLER  PIC X(18) VALUE "153LAWTON         ".
               10  FILLER  PIC X(18) VALUE "155ASHEBORO       ".
               10  FILLER  PIC X(18) VALUE "173CARTERSVILLE   ".
               10  FILLER  PIC X(18) VALUE "174DECATUR        ".
               10  FILLER  PIC X(18) VALUE "178CARTERSVILLE   ".
               10  FILLER  PIC X(18) VALUE "211FAYETTEVILLE   ".
               10  FILLER  PIC X(18) VALUE "281FREEPORT       ".
               10  FILLER  PIC X(18) VALUE "285TYLER          ".
               10  FILLER  PIC X(18) VALUE "629VALLEYFIELD    ".
               10  FILLER  PIC X(18) VALUE "631NAPANEE        ".
           05  P-TAB REDEFINES PLANT-TAB.
               10  P-T OCCURS 23.
                   15  PLANT-NO   PIC X(3).
                   15  PLANT-NAME PIC X(15).

       01  PLT-ARG         PIC X(3).

      *****************************************************************
      **                                                             **
      **  S U B P R O G R A M   A R E A                              **
      **                                                             **
      *****************************************************************
       COPY CDESC    IN COPYLIB.
       COPY TBLOWUP  IN COPYLIB.
       COPY TDATECHK IN COPYLIB.

      *****************************************************************
      **                                                             **
      **  D A T A B A S E   W O R K                                  **
      **                                                             **
      *****************************************************************
       01  BASE                          PIC X(10)  VALUE "  STORES;".
       COPY FILESTAT IN COPYLIB.
       COPY DBSTAT   IN COPYLIB.
       COPY OVRPFDATA  IN COPYLIB.
       01  CODE-ARG                      PIC X(8).

      *****************************************************************
      **                                                             **
      **  D A T A B A S E   B U F F E R S                            **
      **                                                             **
      *****************************************************************
       COPY MPLT0    IN COPYLIB.
       COPY MPLTP01  IN COPYLIB.
       COPY MSTORERM IN COPYLIB.

       PROCEDURE DIVISION.
       START-PGM SECTION.
       START-PROG.
           OPEN INPUT  MPLTINFO.
           MOVE "P 01" TO PLTINFOKEY OF MPLTINFO-REC.
           READ MPLTINFO INTO BUF-MPLTINFO
               INVALID KEY    MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE "AKRON        " TO SAVE-PLANT-NAME
           ELSE
           MOVE MPLTINFO-COMPANY    TO PLT-ARG
           PERFORM 1-FIND-PLANT-NAME VARYING SUB FROM 1 BY 1
               UNTIL SUB > 23.
           OPEN INPUT  MSTORERM.
           MOVE "MCPRT" TO OVRPRTF-FILE.
           MOVE "L "    TO OVRPRTF-TOFILE-NUM-X.
           PERFORM 996-OVERRIDE-PRINT-FILE.
           OPEN OUTPUT PRINT-FILE.
           MOVE 61 TO LINE-CTR.
           MOVE 0  TO TOT-INS-CTR, TOT-CDS-CTR.
           MOVE "    " TO SAVE-DFLT-DEPT.
           SORT SORT-FILE ASCENDING KEY SORT-DFLTDEPT
                                        SORT-CORPCODE
               INPUT PROCEDURE  7-SORT-RECORDS
               OUTPUT PROCEDURE 8-WRITE-REPORT.
           MOVE GRAND-TOTAL-COST TO DISP-TOTAL-COST.
           MOVE SPACES           TO PRINT-REC.
           ADD 5 TO LINE-CTR.
           IF LINE-CTR > 60 PERFORM 8-WRITE-HEADERS.
           MOVE TOT-CDS-CTR      TO DISP-ONHAND.
           STRING "TOTAL CODES   ON REPORT:        ",
               DISP-ONHAND
               DELIMITED BY SIZE INTO PRINT-REC.
           WRITE PRINT-REC AFTER ADVANCING 1 LINES.
           MOVE SPACES           TO PRINT-REC.
           STRING "TOTAL DOLLARS ON REPORT:  ",
               DISP-TOTAL-COST
               DELIMITED BY SIZE INTO PRINT-REC.
           WRITE PRINT-REC AFTER ADVANCING 1 LINES.
           MOVE SPACES           TO PRINT-REC.
           MOVE TOT-INS-CTR      TO DISP-ONHAND.
           STRING "TOTAL INSURANCE ITEMS AT PLANT: ",
               DISP-ONHAND
               DELIMITED BY SIZE INTO PRINT-REC.
           WRITE PRINT-REC AFTER ADVANCING 1 LINES.
           MOVE SPACES TO PRINT-REC.
           STRING "'*' DESIGNATES A CODED NON-STOREROOM ITEM"
               DELIMITED BY SIZE INTO PRINT-REC.
           WRITE PRINT-REC AFTER ADVANCING 2 LINES.
           CLOSE MPLTINFO.
           CLOSE MSTORERM.
           CLOSE PRINT-FILE.
           GOBACK.

       1-FIND-PLANT-NAME.
           IF PLT-ARG = PLANT-NO (SUB)
               MOVE PLANT-NAME (SUB) TO SAVE-PLANT-NAME
               MOVE 23 TO SUB.

       2100-BLOWUP.
           DISPLAY "FATAL ERROR, FILE-STATUS = ", FILE-STATUS.
           DISPLAY "COND-WORD = ", COND-WORD.
           GOBACK.

       COPY OVRPFCALL IN COPYLIB.

       9999-BEGFIL-MSTORERM.
           MOVE SPACES TO CORPCDE OF MSTORERM-REC.
           START MSTORERM KEY >= CORPCDE OF MSTORERM-REC
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.

       9999-GETSER-MSTORERM.
           MOVE 0 TO COND-WORD.
           READ MSTORERM NEXT INTO BUF-MSTORERM
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS-1 = "1"
               MOVE 11 TO COND-WORD
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD
               IF HANDLE-BLOWUP-FLAG = "Y"
                   MOVE "GETSER ERR 9999-GETSER-MSTORERM"
                       TO BU-MSG-AREA
                   PERFORM 2100-BLOWUP.

       7-SORT-RECORDS SECTION.
       7-SORT-RECS.
           PERFORM 9999-BEGFIL-MSTORERM.
       7-SR-LOOP.
           PERFORM 9999-GETSER-MSTORERM.
           IF END-OF-FILE
               GO TO 7-SR-EXIT.
           IF STR-ACT-DATE-CN < "19980101"
               NEXT SENTENCE
           ELSE
           GO TO 7-SR-LOOP.
           IF STR-INS-ITM = " "
               NEXT SENTENCE
           ELSE
           ADD 1 TO TOT-INS-CTR
           GO TO 7-SR-LOOP.
           IF CORP-CODE = "NON-STR" GO TO 7-SR-LOOP.
           IF CORP-CODE-1-2 = "26" OR "27" OR "28" OR "29"
               GO TO 7-SR-LOOP.
           ADD 1                     TO TOT-CDS-CTR.
           MOVE CORP-CODE            TO SORT-CORPCODE.
           MOVE " "                  TO SORT-SN.
           MOVE STR-DFLT-DEPT        TO SORT-DFLTDEPT.
           IF STR-ONHAND = 0
               IF STR-MAX = 0
                   IF STR-REORDER = 0
                       IF STR-EXPEDITE = 0
                           MOVE "*" TO SORT-SN.
           CALL "CDESC" USING CDESC-RET-CODE, BASE, STATUS-AREA,
             BU-DISPLAY-MSG, SORT-CORPCODE, CDESC-DATA.
           IF BU-DISPLAY-MSG-1 NOT = SPACES
               PERFORM 2100-BLOWUP
           ELSE
           MOVE CDESC (1)            TO SORT-DESC.
           MOVE STR-UM               TO SORT-UM.
           MOVE STR-ONHAND           TO SORT-ONHAND.
           MOVE STR-AVG-COST         TO SORT-AVG-COST.
           MOVE STR-LAST-IDATE-CN    TO SORT-LASTISS.
           MOVE STR-ACT-DATE-CN      TO SORT-LASTACT.
           MOVE STR-LAST-PO-RLSE     TO SORT-LASTPO.
           MOVE STR-LAST-REQ-NO      TO SORT-LASTREQ.
           MOVE STR-LAST-REQ-DATE-CN TO SORT-REQDATE.
           RELEASE SORT-REC.
           GO TO 7-SR-LOOP.

       7-SR-EXIT.
           EXIT.

       8-WRITE-REPORT SECTION.
       8-WRITE-RPT.
           MOVE 0 TO LINE-CTR.
           PERFORM 8-WRITE-HEADERS.
       8-WR-LOOP.
           RETURN SORT-FILE AT END
               GO TO 8-WR-X.
           IF SORT-DFLTDEPT NOT = SAVE-DFLT-DEPT
               PERFORM 8-WRITE-HEADERS
               MOVE SORT-DFLTDEPT TO SAVE-DFLT-DEPT
                                     D1-DFLD.
           MOVE SPACES        TO PRINT-REC.
           MOVE SORT-SN       TO D1-SN.
           MOVE SORT-CORPCODE TO D1-CC.
           MOVE SORT-DESC     TO D1-KM.
           MOVE SORT-UM       TO D1-UM.
           MOVE SORT-ONHAND   TO D1-ONH.
           MOVE SORT-AVG-COST TO D1-AVG.
           IF SORT-ONHAND > 0
               MULTIPLY SORT-AVG-COST BY SORT-ONHAND
                   GIVING TOTAL-COST ROUNDED
               ADD TOTAL-COST     TO GRAND-TOTAL-COST ROUNDED.
           MOVE SORT-LASTISS  TO D1-LISS.
           MOVE SORT-LASTACT  TO D1-LACT.
           MOVE SORT-LASTPO   TO D1-LPO.
           MOVE SORT-LASTREQ  TO D1-LREQ.
           MOVE SORT-REQDATE  TO D1-RDAT.
           WRITE PRINT-REC FROM D1 AFTER ADVANCING 1 LINES.
           ADD 1 TO LINE-CTR.
           IF LINE-CTR > 60
               PERFORM 8-WRITE-HEADERS.
           GO TO 8-WR-LOOP.

       8-WRITE-HEADERS.
           MOVE SPACES TO  PRINT-REC.
           WRITE PRINT-REC AFTER ADVANCING NEW-PAGE.
           STRING "                                 "
             "CODES WITH NO ACTIVITY SINCE 19980101 FOR "
                 SAVE-PLANT-NAME
             DELIMITED BY SIZE INTO PRINT-REC.
           WRITE PRINT-REC AFTER ADVANCING 1 LINES.
           MOVE SPACES TO PRINT-REC.
           WRITE PRINT-REC FROM H1 AFTER ADVANCING 1 LINES.
           MOVE ALL "-" TO PRINT-REC.
           WRITE PRINT-REC AFTER ADVANCING 1 LINES.
           MOVE SPACES TO PRINT-REC.
           MOVE 4 TO LINE-CTR.

       8-WR-X.    EXIT.
