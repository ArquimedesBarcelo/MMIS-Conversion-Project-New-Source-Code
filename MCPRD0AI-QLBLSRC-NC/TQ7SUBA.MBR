027900 LINKAGE SECTION.
028600 01  DBPARAMETERS.      COPY DBPARMS OF COPYLIB.
       COPY VCOMLINK OF COPYLIB.
       COPY CATREAD  OF COPYLIB.
029000 PROCEDURE DIVISION USING DBPARAMETERS
029100                          VIEW-COMAREA
029200                          CATREAD-PARMS.
029400 BEGIN-PGM.
           PERFORM 1-HSK THRU 1-HSK-CONT.
           PERFORM 6-MAIN THRU 6-MAIN-LOOP-OUT UNTIL VIEW-LASTKEY = 3.
       2-EOJ.
           CLOSE DISPLAY-FILE.
           CLOSE WO-CRAFTS-MSTR-FILE.
           CLOSE WO-LAST-NUM-USED.
           CLOSE WO-PLANNED-FILE.
           CLOSE WO-SCHEDULE-FILE.
           CLOSE WO-ZONE-PRTY-FILE.
           GOBACK.
       1-HSK.
029600     MOVE 0 TO DATE-MODE.
           OPEN I-O DISPLAY-FILE.
           OPEN INPUT WO-CRAFTS-MSTR-FILE.
           OPEN INPUT WO-LAST-NUM-USED.
           OPEN INPUT WO-PLANNED-FILE.
           OPEN INPUT WO-SCHEDULE-FILE.
           OPEN INPUT WO-ZONE-PRTY-FILE.
031300     CALL "TPWORD" USING PASSWORD-INFORMATION.
031700     IF PASSWORD-FLAG = "N" GO TO 2-EOJ.
           MOVE 0 TO COND-WORD.
           MOVE 1 TO ACT-KEY.
           READ WO-LAST-NUM-USED INTO LAST-WO-BUFF
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF WLNU-STATUS NOT = "00" MOVE 17 TO COND-WORD.
           IF COND-WORD = 17 MOVE 1 TO DATE-FLAG-SW.
           MOVE DATE-FLAG-SW TO DATE-FLAG.
031900     MOVE DATE-FLAG TO DATE-CODE.
       1-HSK-CONT.
031800     ACCEPT CURR-DATE FROM DATE.
032000     MOVE CURR-MM TO DATE-IN-MD.
032100     MOVE CURR-DD TO DATE-IN-DM.
032200     MOVE CURR-YY TO DATE-IN-YY.
032300     CALL "TDATECHK" USING DATE-CHECK-AREA.
032400     MOVE DATE-OUT-MD TO D-MM.
032500     MOVE DATE-OUT-DM TO D-DD.
032600     MOVE DATE-OUT-YY TO D-YY.
           MOVE SPACES TO ERROR-BUFFER.
           MOVE SPACES TO SELECT-BUFFER.
       6-MAIN.
032700     MOVE "FQ7ASELZ" TO VIEW-CFNAME.
           MOVE ERROR-BUFFER TO SELECT-MSG-LINE.
           MOVE SELECT-BUFFER TO DSPLY-REC.
           PERFORM 99-SCREEN-WRITE.
           PERFORM 98-SCREEN-READ.
           MOVE SPACES TO ERROR-BUFFER.
           MOVE DSPLY-REC TO SELECT-BUFFER.
034600     IF VIEW-LASTKEY = 1 OR 3 GO TO 2-EOJ.
034800     IF VIEW-LASTKEY NOT = 0 GO TO 6-MAIN.
035300     IF ZONE-BUF = "    "
035400         MOVE 52001 TO CATREAD-MSG-NUMBER
035600         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
035700         MOVE TRUE-VAL TO INDS (1) INDS (99)
035800         GO TO 6-MAIN.
           MOVE 0 TO COND-WORD.
036200     MOVE ZONE-BUF TO Z-ARG.
           MOVE ZONE-ARGUMENT TO ZONEPRTY OF WZPFREC.
036300     START WO-ZONE-PRTY-FILE KEY IS = EXTERNALLY-DESCRIBED-KEY
036400         INVALID KEY    MOVE 17 TO COND-WORD.
           IF WZPF-STATUS NOT = "00" MOVE 17 TO COND-WORD.
036500     IF COND-WORD = 17
036600         MOVE 35044 TO CATREAD-MSG-NUMBER
036800         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
036900         MOVE TRUE-VAL TO INDS (1) INDS (99)
037100         GO TO 6-MAIN.
037300     IF DAT1-BUF NOT = SPACES
037400         IF DAT1-BUF NOT NUMERIC
037500             MOVE 35014 TO CATREAD-MSG-NUMBER
037700             PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
037800             MOVE TRUE-VAL TO INDS (2) INDS (99)
038000             GO TO 6-MAIN
038100         ELSE
038200         NEXT SENTENCE
038300     ELSE
038400     MOVE 30028 TO CATREAD-MSG-NUMBER
038600     PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
038700     MOVE TRUE-VAL TO INDS (2) INDS (99)
038900     GO TO 6-MAIN.
039000
039100     IF DAT1-YY-9 IS NUMERIC
039200         IF DATE-FLAG = 1
039300             IF DAT1-MM-9 > 0 AND DAT1-MM-9 < 13
039400                 IF DAT1-DD-9 > 0 AND DAT1-DD-9 < 32
039500                     NEXT SENTENCE
039600                 ELSE
039700                 MOVE 35030 TO CATREAD-MSG-NUMBER
039900                 PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
040000                 MOVE TRUE-VAL TO INDS (2) INDS (99)
040200                 GO TO 6-MAIN
040300             ELSE
040400             MOVE 35031 TO CATREAD-MSG-NUMBER
040600             PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
040700             MOVE TRUE-VAL TO INDS (2) INDS (99)
040900             GO TO 6-MAIN
041000         ELSE
041100         IF DAT1-MM-9 > 0 AND DAT1-MM-9 < 32
041200             IF DAT1-DD-9 > 0 AND DAT1-DD-9 < 13
041300                 NEXT SENTENCE
041400             ELSE
041500             MOVE 35031 TO CATREAD-MSG-NUMBER
041700             PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
041800             MOVE TRUE-VAL TO INDS (2) INDS (99)
042000             GO TO 6-MAIN
042100         ELSE
042200         MOVE 35030 TO CATREAD-MSG-NUMBER
042400         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
042500         MOVE TRUE-VAL TO INDS (2) INDS (99)
042700         GO TO 6-MAIN
042800     ELSE
042900     MOVE 35032 TO CATREAD-MSG-NUMBER
043100     PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
043200     MOVE TRUE-VAL TO INDS (2) INDS (99)
043400     GO TO 6-MAIN.
043500
043600     IF DAT2-BUF = SPACES
043700         NEXT SENTENCE
043800     ELSE
043900     IF DAT2-BUF NOT NUMERIC
044000         MOVE 35012 TO CATREAD-MSG-NUMBER
044200         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
044300         MOVE TRUE-VAL TO INDS (3) INDS (99)
044500         GO TO 6-MAIN
044600     ELSE
044700     IF DAT2-YY-9 IS NUMERIC
044800         IF DATE-FLAG = 1
044900             IF DAT2-MM-9 > 0 AND DAT2-MM-9 < 13
045000                 IF DAT2-DD-9 > 0 AND DAT2-DD-9 < 32
045100                     NEXT SENTENCE
045200                 ELSE
045300                 MOVE 35030 TO CATREAD-MSG-NUMBER
045500                 PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
045600                 MOVE TRUE-VAL TO INDS (3) INDS (99)
045800                 GO TO 6-MAIN
045900             ELSE
046000             MOVE 35031 TO CATREAD-MSG-NUMBER
046200             PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
046300             MOVE TRUE-VAL TO INDS (3) INDS (99)
046500             GO TO 6-MAIN
046600         ELSE
046700         IF DAT2-MM-9 > 0 AND DAT2-MM-9 < 32
046800             IF DAT2-DD-9 > 0 AND DAT2-DD-9 < 13
046900                 NEXT SENTENCE
047000             ELSE
047100             MOVE 35031 TO CATREAD-MSG-NUMBER
047300             PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
047400             MOVE TRUE-VAL TO INDS (3) INDS (99)
047600             GO TO 6-MAIN
047700         ELSE
047800         MOVE 35030 TO CATREAD-MSG-NUMBER
048000         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
048100         MOVE TRUE-VAL TO INDS (3) INDS (99)
048300         GO TO 6-MAIN
048400     ELSE
048500     MOVE 35032 TO CATREAD-MSG-NUMBER
048700     PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
048800     MOVE TRUE-VAL TO INDS (3) INDS (99)
049000     GO TO 6-MAIN.
049100
049200     MOVE DAT1-MM TO DATE-IN-MD.
049300     MOVE DAT1-DD TO DATE-IN-DM.
