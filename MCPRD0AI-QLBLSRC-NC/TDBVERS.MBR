       01  DB-ERROR.
           05  DB-BASE   PIC X(10) VALUE SPACES.
           05  DB-FUNC   PIC X(10) VALUE SPACES.
           05  FILLER    PIC X(20) VALUE "ERROR - FILE-STAT = ".
           05  CON-WORD  PIC XX.

           COPY SCREENIO       IN COPYLIB.

       01  DBPARAMETERS.
           COPY DBPARMS        IN COPYLIB.

       01  MMIS-DATA.
           COPY MLASTWO        IN COPYLIB.

       PROCEDURE DIVISION.
       BEGIN.
           MOVE SPACES         TO SCREEN-DATA.
           OPEN I-O            MMIS-MASTER
                               EQPREF-MASTER
                               DRWFIL-MASTER
                               DISPLAY-FILE.

           CALL "TPWORD" USING PASSWORD-INFORMATION.
           IF PASSWORD-FLAG = "N"
               GO TO END-OF-JOB.

       SET-FORM.
           MOVE "VIEWMENU"     TO SCREEN-NAME.
           MOVE SPACES         TO MMIS-DATA EQPREF-DATA DRWFIL-DATA.
           MOVE 0              TO M-SW.
           READ MMIS-MASTER    INTO MMIS-DATA
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT-1 = "2"
               MOVE 1          TO M-SW
           ELSE
           IF FILE-STAT NOT = "00"
               MOVE "MMISA"    TO DB-BASE
               MOVE "READ    " TO DB-FUNC
               MOVE FILE-STAT  TO CON-WORD
               DISPLAY "FAILED TO GET MMISA MASTER RECORD"
               DISPLAY DB-ERROR
               GO TO END-OF-JOB.

           MOVE "."            TO MPER-1 MPER-2 MPER-3.
           MOVE DB-VERSION     TO MMIS-VER.
           MOVE DB-RELEASE     TO MMIS-REL.
           MOVE DB-FIX         TO MMIS-NUM-1.
           MOVE DB-COMPILE     TO MMIS-NUM-2.
           MOVE "/"            TO MFILL1 MFILL2.
           MOVE DB-VERS-YY     TO MMIS-YY.
           MOVE DB-VERS-MM     TO MMIS-MM.
           MOVE DB-VERS-DD     TO MMIS-DD.
           MOVE DB-VERS-HR     TO MMIS-HR.
           MOVE DB-VERS-MN     TO MMIS-MI.
           MOVE "1"            TO DATE-FLAG.
           IF DATE-FLAG-SW = 3
               MOVE "3"        TO DATE-FLAG.

           MOVE 0              TO E-SW.
           READ EQPREF-MASTER  INTO EQPREF-DATA
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT-1 = "2"
               MOVE 1          TO E-SW
           ELSE
           IF FILE-STAT NOT = "00"
               MOVE "EQPREF"   TO DB-BASE
               MOVE "READ    " TO DB-FUNC
               MOVE FILE-STAT  TO CON-WORD
               DISPLAY "FAILED TO GET EQPREF MASTER RECORD"
               DISPLAY DB-ERROR
               GO TO END-OF-JOB.

           MOVE "."            TO EPER-1 EPER-2 EPER-3.
           MOVE EQP-VERS       TO EQRF-VER.
           MOVE EQP-REL        TO EQRF-REL.
           MOVE EQP-FIX        TO EQRF-NUM-1.
           MOVE EQP-COMP       TO EQRF-NUM-2.
           MOVE "/"            TO EFILL1 EFILL2.
           MOVE EQP-YY         TO EQRF-YY.
           MOVE EQP-MM         TO EQRF-MM.
           MOVE EQP-DD         TO EQRF-DD.
           MOVE EQP-HR         TO EQRF-HR.
           MOVE EQP-MN         TO EQRF-MI.

           MOVE 0              TO D-SW.
           READ DRWFIL-MASTER  INTO DRWFIL-DATA
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT-1 = "2"
               MOVE 1          TO D-SW
           ELSE
           IF FILE-STAT NOT = "00"
               MOVE "DRWFIL"   TO DB-BASE
               MOVE "READ    " TO DB-FUNC
               MOVE FILE-STAT  TO CON-WORD
               DISPLAY "FAILED TO GET DRWFIL MASTER RECORD"
               DISPLAY DB-ERROR
               GO TO END-OF-JOB.

           MOVE "."            TO DPER-1 DPER-2 DPER-3.
           MOVE DRW-VERS      TO DRWF-VER.
           MOVE DRW-REL       TO DRWF-REL.
           MOVE DRW-FIX       TO DRWF-NUM-1.
           MOVE DRW-COMP      TO DRWF-NUM-2.
           MOVE "/"            TO DFILL1 DFILL2.
           MOVE DRW-YY        TO DRWF-YY.
           MOVE DRW-MM        TO DRWF-MM.
           MOVE DRW-DD        TO DRWF-DD.
           MOVE DRW-HR        TO DRWF-HR.
           MOVE DRW-MN        TO DRWF-MI.

       MAIN.
           MOVE "00"           TO SCREEN-STATUS.
           MOVE SCREEN-DATA    TO DISPLAY-REC.

           WRITE DISPLAY-REC  FORMAT IS SCREEN-NAME
               INDIC ARE SCREEN-INDICATORS.
           IF SCREEN-STATUS NOT = "00"
               DISPLAY "SCREEN WRITE ERROR.  SCREEN-STATUS IS "
                        SCREEN-STATUS
               GO TO END-OF-JOB.

           READ  DISPLAY-FILE FORMAT IS SCREEN-NAME
               INDIC ARE SCREEN-INDICATORS
           IF SCREEN-STATUS NOT = "00"
               DISPLAY "SCREEN READ ERROR.  SCREEN-STATUS IS "
                        SCREEN-STATUS
               GO TO END-OF-JOB.

           MOVE DISPLAY-REC    TO SCREEN-DATA.
           MOVE ALL B"0"       TO SCREEN-INDICATORS.

           IF KEY-HIT = 3
               GO TO END-OF-JOB
           ELSE
           IF KEY-HIT = 1
               GO TO 6-MAIN
           ELSE
           IF KEY-HIT = 2
               GO TO 7-MAIN
           ELSE
           IF KEY-HIT = 4
               GO TO 8-MAIN
           ELSE
               GO TO MAIN.

       6-MAIN.
           MOVE SPACES         TO MMIS-SCREEN.
           ACCEPT DATE-BUFFER  FROM DATE.
           MOVE "20"           TO CUR-CC.
           IF CUR-YY > "70"
               MOVE "19"       TO CUR-CC.
           MOVE CUR-YY         TO WORK-YY.
           MOVE CUR-MM         TO WORK-MM.
           MOVE CUR-DD         TO WORK-DD.
           IF DATE-FLAG = 3
               MOVE WORK-MM    TO WORK-HR
               MOVE WORK-DD    TO WORK-MM
               MOVE WORK-HR    TO WORK-DD.
           ACCEPT TIME-BUFFER  FROM TIME.
           MOVE CUR-HRS        TO WORK-HR.
           MOVE CUR-MIN        TO WORK-MI.
           MOVE LAST-WO-NO     TO WORK-LAST-WO.
           MOVE LAST-YR-USED   TO WORK-YEAR.
           MOVE PLANT-IDENT    TO WORK-PID.
           MOVE DATE-FLAG-SW   TO WORK-FLAG.
           MOVE "."            TO PER-1 PER-2 PER-3.
           MOVE DB-VERSION     TO VR-VERS MOD-VERS.
           MOVE DB-RELEASE     TO VR-REL MOD-REL.
           MOVE DB-FIX         TO VR-NUM-1 MOD-NUM-1.
           MOVE DB-COMPILE     TO VR-NUM-2 MOD-NUM-2.
           MOVE "/"            TO SLASH1 SLASH2.
           MOVE DB-VERS-YY     TO DBUF-YY.
           MOVE DB-VERS-MM     TO DBUF-MM.
           MOVE DB-VERS-DD     TO DBUF-DD.
           MOVE DB-VERS-HR     TO TBUF-HR.
           MOVE DB-VERS-MN     TO TBUF-MI.
           MOVE "VIEWMMIS"     TO SCREEN-NAME.

       61-SHOWFORM.
           MOVE "00"           TO SCREEN-STATUS.
           MOVE MMIS-SCREEN    TO DISPLAY-REC.

           WRITE DISPLAY-REC  FORMAT IS SCREEN-NAME
               INDIC ARE SCREEN-INDICATORS.
           IF SCREEN-STATUS NOT = "00"
               DISPLAY "SCREEN WRITE ERROR.  SCREEN-STATUS IS "
                        SCREEN-STATUS
               GO TO END-OF-JOB.

           READ  DISPLAY-FILE FORMAT IS SCREEN-NAME
               INDIC ARE SCREEN-INDICATORS
           IF SCREEN-STATUS NOT = "00"
               DISPLAY "SCREEN READ ERROR.  SCREEN-STATUS IS "
                        SCREEN-STATUS
               GO TO END-OF-JOB.

           MOVE DISPLAY-REC    TO MMIS-SCREEN.
           MOVE ALL B"0"       TO SCREEN-INDICATORS.

           IF KEY-HIT = 3
               GO TO END-OF-JOB.

           IF KEY-HIT = 1
               GO TO SET-FORM.

           IF KEY-HIT NOT = 0
               GO TO 61-SHOWFORM.

       61-EDIT-DATA.
           IF MOD-VERS = SPACES MOVE " A" TO MOD-VERS.
           IF MR-2X = SPACE
               MOVE MR-1X      TO MR-2X
               MOVE "0"        TO MR-1X.

           IF MR-2X = SPACE
               MOVE MR-1X      TO MR-2X
               MOVE "0"        TO MR-1X.

           IF MOD-REL NOT NUMERIC
               MOVE "INVALID RELEASE NUMBER - NUMBERS ONLY" TO
                          ERRMSG-M
               MOVE B"1"       TO IND(13) IND(99)
               GO TO 61-SHOWFORM.

           IF MOD-REL = "00" MOVE "01" TO MOD-REL.

           IF MN-1-3X = SPACE
               MOVE MN-1-2X    TO MN-1-3X
               MOVE MN-1-1X    TO MN-1-2X
               MOVE "0"        TO MN-1-1X.

           IF MN-1-3X = SPACE
               MOVE MN-1-2X    TO MN-1-3X
               MOVE MN-1-1X    TO MN-1-2X
               MOVE "0"        TO MN-1-1X.

           IF MN-1-3 = SPACE
               MOVE MN-1-2X    TO MN-1-3X
               MOVE MN-1-1X    TO MN-1-2X
               MOVE "0"        TO MN-1-1X.

           IF MOD-NUM-1 NOT NUMERIC
               MOVE "INVALID FIELD NUMBER - NUMBERS ONLY" TO
                          ERRMSG-M
               MOVE B"1"       TO IND(14) IND(99)
               GO TO 61-SHOWFORM.

           IF MOD-NUM-1 = "000" MOVE "001" TO MOD-NUM-1.

           IF MN-2-3X = SPACE
               MOVE MN-2-2X    TO MN-2-3X
               MOVE MN-2-1X    TO MN-2-2X
               MOVE "0"        TO MN-2-1X.

           IF MN-2-3 = SPACE
               MOVE MN-2-2X    TO MN-2-3X
               MOVE MN-2-1X    TO MN-2-2X
               MOVE "0"        TO MN-2-1X.

           IF MN-2-3 = SPACE
               MOVE MN-2-2X    TO MN-2-3X
               MOVE MN-2-1X    TO MN-2-2X
               MOVE "0"        TO MN-2-1X.

           IF MOD-NUM-2 NOT NUMERIC
               MOVE "INVALID FIELD NUMBER - NUMBERS ONLY" TO
                          ERRMSG-M
               MOVE B"1"       TO IND(15) IND(99)
               GO TO 61-SHOWFORM.

           IF MOD-NUM-2 = "000" MOVE "001" TO MOD-NUM-2.

       61-WRITE-DATA.
           MOVE MOD-VERS       TO DB-VERSION.
           MOVE MOD-REL        TO DB-RELEASE.
           MOVE MOD-NUM-1      TO DB-FIX.
           MOVE MOD-NUM-2      TO DB-COMPILE.
           MOVE DATE-BUFFER-CN TO VERS-INIT-DATE-CN.
           MOVE WORK-HR        TO DB-VERS-HR.
           MOVE WORK-MI        TO DB-VERS-MN.
           IF M-SW = 1
               WRITE WO-REC    FROM MMIS-DATA
                   INVALID KEY MOVE FILE-STAT TO FILE-STAT
               END-WRITE
               IF FILE-STAT NOT = "00"
                   MOVE "MMISA"    TO DB-BASE
                   MOVE "WRITE   " TO DB-FUNC
                   MOVE FILE-STAT  TO CON-WORD
                   DISPLAY "FAILED TO WRITE MMISA MASTER RECORD"
                   DISPLAY DB-ERROR
                   GO TO END-OF-JOB
               ELSE
               NEXT SENTENCE
           ELSE
               REWRITE WO-REC  FROM MMIS-DATA
                   INVALID KEY MOVE FILE-STAT TO FILE-STAT
               END-REWRITE
               IF FILE-STAT NOT = "00"
                   MOVE "MMISA"    TO DB-BASE
                   MOVE "REWRITE " TO DB-FUNC
                   MOVE FILE-STAT  TO CON-WORD
                   DISPLAY "FAILED TO REWRITE MMISA MASTER RECORD"
                   DISPLAY DB-ERROR
                   GO TO END-OF-JOB.

           GO TO 6-MAIN.

       7-MAIN.
           MOVE SPACES         TO EQPREF-SCREEN.
           ACCEPT DATE-BUFFER  FROM DATE.
           MOVE "20"           TO CUR-CC.
           IF CUR-YY > "70"
               MOVE "19"       TO CUR-CC.
           MOVE CUR-YY         TO EWORK-YY.
           MOVE CUR-MM         TO EWORK-MM.
           MOVE CUR-DD         TO EWORK-DD.
           IF DATE-FLAG = 3
               MOVE EWORK-MM   TO EWORK-HR
               MOVE EWORK-DD   TO EWORK-MM
               MOVE EWORK-HR   TO EWORK-DD.
           ACCEPT TIME-BUFFER  FROM TIME.
           MOVE CUR-HRS        TO EWORK-HR.
           MOVE CUR-MIN        TO EWORK-MI.
           MOVE "."            TO EQPER-1 EQPER-2 EQPER-3.
           MOVE EQP-VERS       TO EVR-VERS EMOD-VERS.
           MOVE EQP-REL        TO EVR-REL EMOD-REL.
           MOVE EQP-FIX        TO EVR-NUM-1 EMOD-NUM-1.
           MOVE EQP-COMP       TO EVR-NUM-2 EMOD-NUM-2.
           MOVE "/"            TO ESLASH1 ESLASH2.
           MOVE EQP-YY         TO EDBUF-YY.
           MOVE EQP-MM         TO EDBUF-MM.
           MOVE EQP-DD         TO EDBUF-DD.
           MOVE EQP-HR         TO ETBUF-HR.
           MOVE EQP-MN         TO ETBUF-MI.
           MOVE "VIEWEQRF"     TO SCREEN-NAME.

       71-SHOWFORM.
           MOVE "00"           TO SCREEN-STATUS.
           MOVE EQPREF-SCREEN  TO DISPLAY-REC.

           WRITE DISPLAY-REC  FORMAT IS SCREEN-NAME
               INDIC ARE SCREEN-INDICATORS.
           IF SCREEN-STATUS NOT = "00"
               DISPLAY "SCREEN WRITE ERROR.  SCREEN-STATUS IS "
                        SCREEN-STATUS
               GO TO END-OF-JOB.

           READ  DISPLAY-FILE FORMAT IS SCREEN-NAME
               INDIC ARE SCREEN-INDICATORS
           IF SCREEN-STATUS NOT = "00"
               DISPLAY "SCREEN READ ERROR.  SCREEN-STATUS IS "
                        SCREEN-STATUS
               GO TO END-OF-JOB.

           MOVE DISPLAY-REC    TO EQPREF-SCREEN.
           MOVE ALL B"0"       TO SCREEN-INDICATORS.

           IF KEY-HIT = 3
               GO TO END-OF-JOB.

           IF KEY-HIT = 1
               GO TO SET-FORM.

           IF KEY-HIT NOT = 0
               GO TO 71-SHOWFORM.

       71-EDIT-DATA.
           IF EMOD-VERS = SPACES MOVE " A" TO EMOD-VERS.
           IF EMR-2X = SPACE
               MOVE EMR-1X     TO EMR-2X
               MOVE "0"        TO EMR-1X.

           IF EMR-2X = SPACE
               MOVE EMR-1X     TO EMR-2X
               MOVE "0"        TO EMR-1X.

           IF EMOD-REL NOT NUMERIC
               MOVE "INVALID RELEASE NUMBER - NUMBERS ONLY" TO
                          ERRMSG-E
               MOVE B"1"       TO IND(13) IND(99)
               GO TO 71-SHOWFORM.

           IF EMOD-REL = "00" MOVE "01" TO EMOD-REL.

           IF EMN-1-3X = SPACE
               MOVE EMN-1-2X   TO EMN-1-3X
               MOVE EMN-1-1X   TO EMN-1-2X
               MOVE "0"        TO EMN-1-1X.

           IF EMN-1-3X = SPACE
               MOVE EMN-1-2X   TO EMN-1-3X
               MOVE EMN-1-1X   TO EMN-1-2X
               MOVE "0"        TO EMN-1-1X.

           IF EMN-1-3X = SPACE
               MOVE EMN-1-2X   TO EMN-1-3X
               MOVE EMN-1-1X   TO EMN-1-2X
               MOVE "0"        TO EMN-1-1X.

           IF EMOD-NUM-1 NOT NUMERIC
               MOVE "INVALID FIELD NUMBER - NUMBERS ONLY" TO
                          ERRMSG-E
               MOVE B"1"       TO IND(14) IND(99)
               GO TO 71-SHOWFORM.

           IF EMOD-NUM-1 = "000" MOVE "001" TO EMOD-NUM-1.

           IF EMN-2-3X = SPACE
               MOVE EMN-2-2X   TO EMN-2-3X
               MOVE EMN-2-1X   TO EMN-2-2X
               MOVE "0"        TO EMN-2-1X.

           IF EMN-2-3X = SPACE
               MOVE EMN-2-2X   TO EMN-2-3X
               MOVE EMN-2-1X   TO EMN-2-2X
               MOVE "0"        TO EMN-2-1X.

           IF EMN-2-3X = SPACE
               MOVE EMN-2-2X   TO EMN-2-3X
               MOVE EMN-2-1X   TO EMN-2-2X
               MOVE "0"        TO EMN-2-1X.

           IF EMOD-NUM-2 NOT NUMERIC
               MOVE "INVALID FIELD NUMBER - NUMBERS ONLY" TO
                          ERRMSG-E
               MOVE B"1"       TO IND(15) IND(99)
               GO TO 71-SHOWFORM.

           IF EMOD-NUM-2 = "000" MOVE "001" TO EMOD-NUM-2.

       71-WRITE-DATA.
           MOVE EMOD-VERS      TO EQP-VERS.
           MOVE EMOD-REL       TO EQP-REL.
           MOVE EMOD-NUM-1     TO EQP-FIX.
           MOVE EMOD-NUM-2     TO EQP-COMP.
           MOVE DATE-BUFFER-CN TO EQPREF-DATE.
           MOVE EWORK-HR       TO EQP-HR.
           MOVE EWORK-MI       TO EQP-MN.
           IF E-SW = 1
               WRITE EQP-REC   FROM EQPREF-DATA
                   INVALID KEY MOVE FILE-STAT TO FILE-STAT
               END-WRITE
               IF FILE-STAT NOT = "00"
                   MOVE "EQPREF"   TO DB-BASE
                   MOVE "WRITE   " TO DB-FUNC
                   MOVE FILE-STAT  TO CON-WORD
                   DISPLAY "FAILED TO WRITE EQPREF MASTER RECORD"
                   DISPLAY DB-ERROR
                   GO TO END-OF-JOB
               ELSE
               NEXT SENTENCE
           ELSE
               REWRITE EQP-REC FROM EQPREF-DATA
                   INVALID KEY MOVE FILE-STAT TO FILE-STAT
               END-REWRITE
               IF FILE-STAT NOT = "00"
                   MOVE "EQPREF"   TO DB-BASE
                   MOVE "REWRITE " TO DB-FUNC
                   MOVE FILE-STAT  TO CON-WORD
                   DISPLAY "FAILED TO REWRITE EQPREF MASTER RECORD"
                   DISPLAY DB-ERROR
                   GO TO END-OF-JOB.

           GO TO 7-MAIN.

       8-MAIN.
           MOVE SPACES         TO DRWFIL-SCREEN.
           ACCEPT DATE-BUFFER  FROM DATE.
           MOVE "20"           TO CUR-CC.
           IF CUR-YY > "70"
               MOVE "19"       TO CUR-CC.
           MOVE CUR-YY         TO DWORK-YY.
           MOVE CUR-MM         TO DWORK-MM.
           MOVE CUR-DD         TO DWORK-DD.
           IF DATE-FLAG = 3
               MOVE DWORK-MM   TO DWORK-HR
               MOVE DWORK-DD   TO DWORK-MM
               MOVE DWORK-HR   TO DWORK-DD.
           ACCEPT TIME-BUFFER  FROM TIME.
           MOVE CUR-HRS        TO DWORK-HR.
           MOVE CUR-MIN        TO DWORK-MI.
           MOVE "."            TO DFPER-1 DFPER-2 DFPER-3.
           MOVE DRW-VERS       TO DVR-VERS DMOD-VERS.
           MOVE DRW-REL        TO DVR-REL DMOD-REL.
           MOVE DRW-FIX        TO DVR-NUM-1 DMOD-NUM-1.
           MOVE DRW-COMP       TO DVR-NUM-2 DMOD-NUM-2.
           MOVE "/"            TO DSLASH1 DSLASH2.
           MOVE DRW-YY         TO DDBUF-YY.
           MOVE DRW-MM         TO DDBUF-MM.
           MOVE DRW-DD         TO DDBUF-DD.
           MOVE DRW-HR         TO DTBUF-HR.
           MOVE DRW-MN         TO DTBUF-MI.
           MOVE "VIEWDRWF"     TO SCREEN-NAME.

       81-SHOWFORM.
           MOVE "00"           TO SCREEN-STATUS.
           MOVE DRWFIL-SCREEN  TO DISPLAY-REC.

           WRITE DISPLAY-REC  FORMAT IS SCREEN-NAME
               INDIC ARE SCREEN-INDICATORS.
           IF SCREEN-STATUS NOT = "00"
               DISPLAY "SCREEN WRITE ERROR.  SCREEN-STATUS IS "
                        SCREEN-STATUS
               GO TO END-OF-JOB.

           READ  DISPLAY-FILE FORMAT IS SCREEN-NAME
               INDIC ARE SCREEN-INDICATORS
           IF SCREEN-STATUS NOT = "00"
               DISPLAY "SCREEN READ ERROR.  SCREEN-STATUS IS "
                        SCREEN-STATUS
               GO TO END-OF-JOB.

           MOVE DISPLAY-REC    TO DRWFIL-SCREEN.
           MOVE ALL B"0"       TO SCREEN-INDICATORS.

           IF KEY-HIT = 3
               GO TO END-OF-JOB.

           IF KEY-HIT = 1
               GO TO SET-FORM.

           IF KEY-HIT NOT = 0
               GO TO 81-SHOWFORM.

       81-EDIT-DATA.
           IF DMOD-VERS = SPACES MOVE " A" TO DMOD-VERS.
           IF DMR-2X = SPACE
               MOVE DMR-1X     TO DMR-2X
               MOVE "0"        TO DMR-1X.

           IF DMR-2X = SPACE
               MOVE DMR-1X     TO DMR-2X
               MOVE "0"        TO DMR-1X.

           IF DMOD-REL NOT NUMERIC
               MOVE "INVALID RELEASE NUMBER - NUMBERS ONLY" TO
                          ERRMSG-D
               MOVE B"1"       TO IND(13) IND(99)
               GO TO 81-SHOWFORM.

           IF DMOD-REL = "00" MOVE "01" TO DMOD-REL.

           IF DMN-1-3X = SPACE
               MOVE DMN-1-2X   TO DMN-1-3X
               MOVE DMN-1-1X   TO DMN-1-2X
               MOVE "0"        TO DMN-1-1X.

           IF DMN-1-3X = SPACE
               MOVE DMN-1-2X   TO DMN-1-3X
               MOVE DMN-1-1X   TO DMN-1-2X
               MOVE "0"        TO DMN-1-1X.

           IF DMN-1-3X = SPACE
               MOVE DMN-1-2X   TO DMN-1-3X
               MOVE DMN-1-1X   TO DMN-1-2X
               MOVE "0"        TO DMN-1-1X.

           IF DMOD-NUM-1 NOT NUMERIC
               MOVE "INVALID FIELD NUMBER - NUMBERS ONLY" TO
                          ERRMSG-D
               MOVE B"1"       TO IND(14) IND(99)
               GO TO 81-SHOWFORM.

           IF DMOD-NUM-1 = "000" MOVE "001" TO DMOD-NUM-1.

           IF DMN-2-3X = SPACE
               MOVE DMN-2-2X   TO DMN-2-3X
               MOVE DMN-2-1X   TO DMN-2-2X
               MOVE "0"        TO DMN-2-1X.

           IF DMN-2-3X = SPACE
               MOVE DMN-2-2X   TO DMN-2-3X
               MOVE DMN-2-1X   TO DMN-2-2X
               MOVE "0"        TO DMN-2-1X.

           IF DMN-2-3X = SPACE
               MOVE DMN-2-2X   TO DMN-2-3X
               MOVE DMN-2-1X   TO DMN-2-2X
               MOVE "0"        TO DMN-2-1X.

           IF DMOD-NUM-2 NOT NUMERIC
               MOVE "INVALID FIELD NUMBER - NUMBERS ONLY" TO
                          ERRMSG-D
               MOVE B"1"       TO IND(15) IND(99)
               GO TO 81-SHOWFORM.

           IF DMOD-NUM-2 = "000" MOVE "001" TO DMOD-NUM-2.

       81-WRITE-DATA.
           MOVE DMOD-VERS      TO DRW-VERS.
           MOVE DMOD-REL       TO DRW-REL.
           MOVE DMOD-NUM-1     TO DRW-FIX.
           MOVE DMOD-NUM-2     TO DRW-COMP.
           MOVE DATE-BUFFER-CN TO DRWFIL-DATE.
           MOVE DWORK-HR       TO DRW-HR.
           MOVE DWORK-MI       TO DRW-MN.
           IF D-SW = 1
               WRITE DRW-REC   FROM DRWFIL-DATA
                   INVALID KEY MOVE FILE-STAT TO FILE-STAT
               END-WRITE
               IF FILE-STAT NOT = "00"
                   MOVE "DRWFIL"   TO DB-BASE
                   MOVE "WRITE   " TO DB-FUNC
                   MOVE FILE-STAT  TO CON-WORD
                   DISPLAY "FAILED TO WRITE DRWFIL MASTER RECORD"
                   DISPLAY DB-ERROR
                   GO TO END-OF-JOB
               ELSE
               NEXT SENTENCE
           ELSE
               REWRITE DRW-REC FROM DRWFIL-DATA
                   INVALID KEY MOVE FILE-STAT TO FILE-STAT
               END-REWRITE
               IF FILE-STAT NOT = "00"
                   MOVE "DRWFIL"   TO DB-BASE
                   MOVE "REWRITE " TO DB-FUNC
                   MOVE FILE-STAT  TO CON-WORD
                   DISPLAY "FAILED TO REWRITE DRWFIL MASTER RECORD"
                   DISPLAY DB-ERROR
                   GO TO END-OF-JOB.

           GO TO 8-MAIN.

       END-OF-JOB.
           CLOSE               MMIS-MASTER.
           CLOSE               EQPREF-MASTER.
           CLOSE               DRWFIL-MASTER.
           CLOSE               DISPLAY-FILE.
           GOBACK.

