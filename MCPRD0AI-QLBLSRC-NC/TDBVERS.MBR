       IDENTIFICATION DIVISION.
       PROGRAM-ID.             TDBVERS.
       AUTHOR.                 W. ROXBURY.
       INSTALLATION.           GOODYEAR.
       DATE-WRITTEN.           APRIL  1985.
       DATE-COMPILED.
       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.
       SOURCE-COMPUTER.        IBM-AS400.
       OBJECT-COMPUTER.        IBM-AS400.

       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT MMIS-MASTER
                  ASSIGN       TO DATABASE-MCFPMM0800
                  ORGANIZATION IS RELATIVE
                  ACCESS MODE  IS RANDOM
                  RELATIVE KEY IS FKEY
                  FILE STATUS  IS FILE-STAT.

           SELECT EQPREF-MASTER
                  ASSIGN       TO DATABASE-MCFPER0800
                  ORGANIZATION IS RELATIVE
                  ACCESS MODE  IS RANDOM
                  RELATIVE KEY IS FKEY
                  FILE STATUS  IS FILE-STAT.

           SELECT DRWFIL-MASTER
                  ASSIGN       TO DATABASE-MCFPDF0200
                  ORGANIZATION IS RELATIVE
                  ACCESS MODE  IS RANDOM
                  RELATIVE KEY IS FKEY
                  FILE STATUS  IS FILE-STAT.

           SELECT DISPLAY-FILE
                  ASSIGN       TO WORKSTATION-ZDBVERSN-SI
                  ORGANIZATION IS TRANSACTION
                  ACCESS MODE  IS SEQUENTIAL
                  FILE STATUS  IS SCREEN-STATUS
                               MAJOR-MINOR
                  CONTROL-AREA IS SCREEN-CONTROL.

       DATA DIVISION.
       FILE SECTION.
       FD  MMIS-MASTER
           LABEL RECORDS ARE STANDARD.
       01  WO-REC.
           COPY DDS-ALL-FORMATS OF MCFPMM0800.

       FD  EQPREF-MASTER
           LABEL RECORDS ARE STANDARD.
       01  EQP-REC.
           COPY DDS-ALL-FORMATS OF MCFPER0800.

       FD  DRWFIL-MASTER
           LABEL RECORDS ARE STANDARD.
       01  DRW-REC.
           COPY DDS-ALL-FORMATS OF MCFPDF0200.

       FD  DISPLAY-FILE
           LABEL RECORDS ARE OMITTED.
       01  DISPLAY-REC         PIC X(2000).

       WORKING-STORAGE SECTION.
       77  FKEY                PIC 9(9)      VALUE 1.
       77  M-SW                PIC 9         VALUE 0.
       77  E-SW                PIC 9         VALUE 0.
       77  D-SW                PIC 9         VALUE 0.

       01  PASSWORD-INFORMATION.
           05  NAME-OF-PROGRAM PIC X(08) VALUE "TDBVERS ".
           05  PROGRAM-TYPE    PIC X(02) VALUE "MA".
           05  PROGRAM-RELEASE PIC X(12) VALUE " E0100010001".
           05  PROGRAM-DESCRIPTION.
               10  PROG-DESCA1 PIC X(30) VALUE
                   "WRITES THE DATABASE VERSION-RE".
               10  PROG-DESCA2 PIC X(30) VALUE
                   "LEASE FIELDS INTO THE MASTER  ".
               10  PROG-DESCB1 PIC X(30) VALUE
                   "RECORDS OF THE MMIS SYSTEM DAT".
               10  PROG-DESCB2 PIC X(30) VALUE
                   "ABASES.  MUST BE USED ONLY BY ".
               10  PROG-FUNC1  PIC X(30) VALUE
                   "OR UNDER THE DIRECTION OF THE ".
               10  PROG-FUNC2  PIC X(30) VALUE
                   "AKRON PROGRAMMING STAFF.      ".
           05  PASSWORD-FLAG   PIC X.

       01  FILE-STAT.
           05  FILE-STAT-1     PIC X  VALUE "0".
           05  FILE-STAT-2     PIC X  VALUE "0".

       01  DATE-BUFFER-CN.
           05  CUR-CC          PIC XX.
