               10  FILLER      PIC X.
               10  DWORK-YY    PIC XX.
           05  DWORK-TIME.
               10  DWORK-HR    PIC XX.
               10  DWORK-MI    PIC XX.
           05  DDB-VERSION-REL.
               10  DVR-VERS    PIC XX.
               10  DFPER-1     PIC X.
               10  DVR-REL     PIC XX.
               10  DFPER-2     PIC X.
               10  DVR-NUM-1   PIC XXX.
               10  DFPER-3     PIC X.
               10  DVR-NUM-2   PIC XXX.
           05  DDBUF.
               10  DDBUF-MM    PIC XX.
               10  DSLASH1     PIC X.
               10  DDBUF-DD    PIC XX.
               10  DSLASH2     PIC X.
               10  DDBUF-YY    PIC XX.
           05  DTBUF.
               10  DTBUF-HR    PIC XX.
               10  DTBUF-MI    PIC XX.
           05  DMOD-VERS-REL.
               10  DMOD-VERS   PIC XX.
               10  DMOD-REL    PIC XX.
               10  DMOD-REL9   REDEFINES
                   DMOD-REL.
                   15  DMR-1   PIC 9.
                   15  DMR-1X  REDEFINES
                       DMR-1   PIC X.
                   15  DMR-2   PIC 9.
                   15  DMR-2X  REDEFINES
                       DMR-2   PIC X.
               10  DMOD-NUM-1  PIC XXX.
               10  DMOD-NUM-19 REDEFINES
                   DMOD-NUM-1.
                   15  DMN-1-1 PIC 9.
                   15  DMN-1-1X REDEFINES
                       DMN-1-1 PIC X.
                   15  DMN-1-2 PIC 9.
                   15  DMN-1-2X REDEFINES
                       DMN-1-2 PIC X.
                   15  DMN-1-3 PIC 9.
                   15  DMN-1-3X REDEFINES
                       DMN-1-3 PIC X.
               10  DMOD-NUM-2  PIC XXX.
               10  DMOD-NUM-29 REDEFINES
                   DMOD-NUM-2.
                   15  DMN-2-1 PIC 9.
                   15  DMN-2-1X REDEFINES
                       DMN-2-1 PIC X.
                   15  DMN-2-2 PIC 9.
                   15  DMN-2-2X REDEFINES
                       DMN-2-2 PIC X.
                   15  DMN-2-3 PIC 9.
                   15  DMN-2-3X REDEFINES
                       DMN-2-3 PIC X.
           05  CMDMSG-D        PIC X(79).
