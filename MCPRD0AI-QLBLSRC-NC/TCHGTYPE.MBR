000200 IDENTIFICATION DIVISION.
000300 PROGRAM-ID.     TCHGTYPE.
000700 ENVIRONMENT DIVISION.
000800 CONFIGURATION SECTION.
000900 SOURCE-COMPUTER.     AS400.
001000 OBJECT-COMPUTER.     AS400.
       SPECIAL-NAMES.       I-O-FEEDBACK IS I-O-FEEDBACK-AREA
                            LOCAL-DATA IS LOCAL-DATA-AREA.
001000 INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT DISPLAY-FILE
               ASSIGN TO WORKSTATION-ZOFFLINE-SI
               ORGANIZATION IS TRANSACTION
               ACCESS IS SEQUENTIAL
               FILE STATUS IS DSPLY-STATUS
               CONTROL-AREA IS WS-CONTROL.
           SELECT WO-EQUIP-HIER-FILE
               ASSIGN TO DATABASE-MCFLMM1701
               ORGANIZATION IS INDEXED
               ACCESS IS SEQUENTIAL
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
               FILE STATUS IS WEHF-STATUS.
           SELECT WO-EQUIP-HIER-FILE-P
               ASSIGN TO DATABASE-MCFPMM1700
               ORGANIZATION IS RELATIVE
               ACCESS MODE IS RANDOM
               RELATIVE KEY IS PFKEY
               FILE STATUS IS WEHFP-STATUS.
001100 DATA DIVISION.
       FILE SECTION.
       FD  DISPLAY-FILE
           LABEL RECORDS ARE OMITTED.
       01  DSPLY-REC                         PIC X(2000).
       FD  WO-EQUIP-HIER-FILE
           LABEL RECORDS ARE STANDARD
           DATA RECORD IS WEHFREC.
       01  WEHFREC.
           COPY DDS-ALL-FORMATS OF MCFLMM1701.
       FD  WO-EQUIP-HIER-FILE-P
           LABEL RECORDS ARE STANDARD
           DATA RECORD IS WEHFPREC.
       01  WEHFPREC.
           COPY DDS-ALL-FORMATS OF MCFPMM1700.
001200 WORKING-STORAGE SECTION.
001300 77  ALL-SUBS-FOUND-SW               PIC X VALUE "N".
001500 01  ADDRESS-ARG                     PIC 9(9) VALUE 0.
001600 01  ADDRESS-SUB                     PIC 9(4) VALUE 0.
004300 01  ADDRESS-TABLE.
004400     05  REC-ADD OCCURS 1500 TIMES   PIC 9(9).
       01  DSPLY-STATUS                    PIC XX.
002300 01  EQUIP-HIER-BUFFER.
002400     05  HIER-KEY.
002500         10  EQP-TYPE-BUF            PIC X(8).
002600         10  FATHER-SUB-BUF.
002700             15  FATH-4-BUF          PIC X(4).
002800             15  FILLER              PIC XX VALUE SPACES.
002900     05  HIER-DISP-CODE.
003000         10  SON-SUB-BUF.
003100             15  SON-4-BUF           PIC X(4).
003200             15  FILLER              PIC XX VALUE SPACES.
003300     05  SUB-ASSY-NAME               PIC X(50).
001800 01  FIND-KEY-SUB                    PIC 9(4) VALUE 0.
       COPY IOFEEDBACK OF COPYLIB.
001700 01  KEY-SUB                         PIC 9(4) VALUE 0.
004500 01  KEY-TABLE.
004600     05  KEY-TAB OCCURS 1500 TIMES   PIC X(6).
001400 01  PERFORM-K                       PIC 9(4) VALUE 0.
       01  PFKEY                           PIC 9(9).
004200 COPY DBSTAT OF    COPYLIB.
001900 01  TYPE-SUB-ARG.
002000     05  EQP-TYPE-ARG                PIC X(8) VALUE SPACES.
002100     05  FATH-ARG                    PIC X(4).
002200     05  FILLER                      PIC XX VALUE SPACES.
       01  WEHF-STATUS                     PIC XX.
       01  WEHFP-STATUS                    PIC XX.
       COPY WSCONTROL OF COPYLIB.
004700 LINKAGE SECTION.
004800 01  OLD-EQUIP-TYPE                  PIC X(8).
004900 01  NEW-EQUIP-TYPE                  PIC X(8).
005000 01  ERROR-RET-SW                    PIC X.
005100 01  DBPARAMETERS.     COPY DBPARMS OF COPYLIB.
005200 PROCEDURE DIVISION USING OLD-EQUIP-TYPE NEW-EQUIP-TYPE
005300                          ERROR-RET-SW DBPARAMETERS.
005400 BEGIN-PROC.
           OPEN I-O   DISPLAY-FILE.
           OPEN INPUT WO-EQUIP-HIER-FILE.
           OPEN I-O   WO-EQUIP-HIER-FILE-P.
005500     PERFORM 80-CHECK-FOR-NEW-TYPE.
005600     PERFORM 81-HOUSEKEEPING THRU 81-H-EXIT.
005700     PERFORM 82-FIND-SUBS THRU 82-FS-EXIT UNTIL
005800             ALL-SUBS-FOUND-SW = "Y".
005900     MOVE ADDRESS-SUB TO PERFORM-K.
006000     MOVE 0 TO ADDRESS-SUB.
006100     PERFORM 87-DEL-ADD-SUBS THRU 87-DAS-EXIT PERFORM-K TIMES.
006200 2-EOJ.
           CLOSE DISPLAY-FILE.
           CLOSE WO-EQUIP-HIER-FILE.
           CLOSE WO-EQUIP-HIER-FILE-P.
006300     GOBACK.
006400 80-CHECK-FOR-NEW-TYPE.
006700     MOVE NEW-EQUIP-TYPE TO EQP-TYPE-ARG.
006800     MOVE "0000" TO FATH-ARG.
           MOVE 0 TO COND-WORD.
           MOVE FATH-ARG TO HIERKEY OF WEHFREC.
           START WO-EQUIP-HIER-FILE KEY IS = EXTERNALLY-DESCRIBED-KEY
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF WEHF-STATUS NOT = "00" MOVE 17 TO COND-WORD.
007800     IF COND-WORD = 17
007900         NEXT SENTENCE
008000     ELSE
008100     MOVE "Y" TO ERROR-RET-SW
008200     GO TO 2-EOJ.
008300 81-HOUSEKEEPING.
008400     MOVE SPACES TO KEY-TABLE.
008500     MOVE LOW-VALUES TO STATUS-AREA ADDRESS-TABLE.
008800     MOVE "N" TO ERROR-RET-SW.
008900     MOVE SPACES TO TYPE-SUB-ARG.
009000     MOVE OLD-EQUIP-TYPE TO EQP-TYPE-ARG.
009100     ADD 1 TO KEY-SUB.
009200     MOVE "0000  " TO KEY-TAB (KEY-SUB).
009300 81-H-EXIT.
009400     EXIT.
009500 82-FIND-SUBS.
009600     ADD 1 TO FIND-KEY-SUB.
009700     IF KEY-TAB (FIND-KEY-SUB) = SPACES
009800         MOVE "Y" TO ALL-SUBS-FOUND-SW
009900         GO TO 82-FS-EXIT
010000     ELSE
010100     MOVE KEY-TAB (FIND-KEY-SUB) TO FATH-ARG.
           MOVE 0 TO COND-WORD.
           MOVE FATH-ARG TO HIERKEY OF WEHFREC.
           START WO-EQUIP-HIER-FILE KEY IS = EXTERNALLY-DESCRIBED-KEY
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF WEHF-STATUS NOT = "00" MOVE 17 TO COND-WORD.
010400     IF COND-WORD = 17 GO TO 82-FS-EXIT.
011000     PERFORM 83-GET-SUBS THRU 83-GS-EXIT UNTIL
011100             COND-WORD = 15.
011200 82-FS-EXIT.
011300     EXIT.
011400 83-GET-SUBS.
           MOVE 0 TO COND-WORD.
           READ WO-EQUIP-HIER-FILE NEXT INTO EQUIP-HIER-BUFFER
               AT END    MOVE 15 TO COND-WORD.
           IF WEHF-STATUS NOT = "00" MOVE 15 TO COND-WORD.
011700     IF COND-WORD = 15 GO TO 83-GS-EXIT.
012300     ADD 1 TO ADDRESS-SUB.
           ACCEPT IOFEEDBACK FROM I-O-FEEDBACK-AREA.
           MOVE IO-REL-NO TO REC-ADD (ADDRESS-SUB).
012500     ADD 1 TO KEY-SUB.
012600     MOVE SON-SUB-BUF TO KEY-TAB (KEY-SUB).
012700 83-GS-EXIT.
012800     EXIT.
012900 87-DEL-ADD-SUBS.
013000     ADD 1 TO ADDRESS-SUB.
013100     MOVE REC-ADD (ADDRESS-SUB) TO PFKEY.
           MOVE 0 TO COND-WORD.
           READ WO-EQUIP-HIER-FILE-P INTO EQUIP-HIER-BUFFER
               INVALID KEY    MOVE 15 TO COND-WORD.
           IF WEHFP-STATUS NOT = "00" MOVE 15 TO COND-WORD.
013400     IF COND-WORD = 15 GO TO 87-DAS-EXIT.
           MOVE 0 TO COND-WORD.
           DELETE WO-EQUIP-HIER-FILE-P RECORD
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF WEHFP-STATUS NOT = "00" MOVE 17 TO COND-WORD.
014500     IF COND-WORD = 17 GO TO 2-EOJ.
015200     MOVE NEW-EQUIP-TYPE TO EQP-TYPE-BUF.
           MOVE 0 TO COND-WORD.
           WRITE WEHFPREC FROM EQUIP-HIER-BUFFER
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF WEHFP-STATUS NOT = "00" MOVE 17 TO COND-WORD.
016400     IF COND-WORD NOT = 0 GO TO 2-EOJ.
016700 87-DAS-EXIT.
016800     EXIT.
