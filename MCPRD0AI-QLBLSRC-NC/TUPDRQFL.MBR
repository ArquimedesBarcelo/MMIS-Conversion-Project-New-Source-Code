       IDENTIFICATION DIVISION.
       PROGRAM-ID.         TPOUPDRQ.
       AUTHOR.             CA YODER.
       DATE-WRITTEN.       APRIL 2003.
       DATE-COMPILED.
      *INSTALLATION.       GOODYEAR TIRE & RUBBER CO.

      *D* REMARKS.
      *D*
      *D*   THIS PROGRAM MAINTAINS THE REQ NOTIFY FILE MCFPCSRQNO.
      *D*   WHEN A REQ IS ENTERED INTO THIS FILE, A MESSAGE WILL
      *D*   BE SENT TO THE EXPEDITE USER-ID (W/KEY = "EXPEDITE") IN
      *D*   ADDITION TO THE NOTIFY USER-ID ON THE REQ WHEN THE
      *D*   MATERIAL IS RECEIVED.
      *D*
      *C* CHANGES
      *C*

       ENVIRONMENT DIVISION.

       CONFIGURATION SECTION.

       SOURCE-COMPUTER.          IBM-AS400.
       OBJECT-COMPUTER.          IBM-AS400.

       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT DISPLAY-FILE
               ASSIGN         TO WORKSTATION-ZUPDRQFL-SI
               ORGANIZATION   IS TRANSACTION
               ACCESS         IS DYNAMIC
               RELATIVE KEY   IS REC-COUNT
               FILE STATUS    IS DISPLAY-STATUS
               CONTROL-AREA   IS WS-CONTROL.

           SELECT REQ-FILE-IO
               ASSIGN         TO DATABASE-MCFLCSRQNO
               ORGANIZATION   IS INDEXED
               ACCESS MODE    IS DYNAMIC
               RECORD KEY     IS EXTERNALLY-DESCRIBED-KEY
                 WITH DUPLICATES
               FILE STATUS    IS FILE-STATUS.

           SELECT MREQ-I
               ASSIGN         TO DATABASE-MCFLCS2001
               ORGANIZATION   IS INDEXED
               ACCESS MODE    IS DYNAMIC
               RECORD KEY     IS EXTERNALLY-DESCRIBED-KEY
               FILE STATUS    IS FILE-STATUS.

       DATA DIVISION.

       FILE SECTION.

       FD  DISPLAY-FILE
           LABEL RECORDS ARE OMITTED.
       01  DISPLAY-REC        PIC X(2000).

       FD  REQ-FILE-IO
           LABEL RECORDS ARE STANDARD.
       01  REQ-FILE-REC.
           COPY DDS-ALL-FORMATS OF MCFLCSRQNO.

       FD  MREQ-I
           LABEL RECORDS ARE STANDARD.
       01  MREQ-REC.
           COPY DDS-MCRPCS2000  OF MCFLCS2001.

       WORKING-STORAGE SECTION.

      *-----------------------------------------------------------------
      *                   B U F F E R S
      *-----------------------------------------------------------------

       01  BUF-REQ-FILE.
           05  REQF-REQ-NO          PIC X(12).
           05  REQF-USER-ID         PIC X(10).

       01  BUF-REQ-NO               PIC X(12).

       01  DE-BUF.
           05  DE-ADD-REQ           PIC X(12).
           05  DE-EXPEDITE-USER     PIC X(10).
           05  DE-MSGLN             PIC X(78).

       01  HOLD-USER-ID             PIC X(10)   VALUE SPACES.

       01  VALID-USER               PIC X(1).

      *-----------------------------------------------------------------
      *         S W I T C H E S / C O U N T E R S
      *-----------------------------------------------------------------

       01  REQ-FILE-EOF-SW         PIC X  VALUE "N".

       01  REC-COUNT               PIC 9(5) VALUE 0.

      *-----------------------------------------------------------------
      *          D A T A B A S E   S T A T U S   A R E A
      *-----------------------------------------------------------------

       01  FILE-STATUS.
           05  FILE-STATUS-1        PIC X.
           05  FILE-STATUS-2        PIC X.

       COPY DATAB    OF COPYLIB.

      *-----------------------------------------------------------------
      *               U T I L I T Y   A R E A
      *-----------------------------------------------------------------

       COPY CATREAD OF COPYLIB.

       COPY TBLOWUP OF COPYLIB.

       COPY VCOMAREA OF COPYLIB.

       01  WS-CONTROL.
           05  FUNCTION-KEY         PIC X(2).
               88  ENTER-KEY-USED            VALUE "00".
               88  F1-KEY-USED               VALUE "01".
               88  F2-KEY-USED               VALUE "02".
               88  F3-KEY-USED               VALUE "03".
               88  F4-KEY-USED               VALUE "04".
               88  F5-KEY-USED               VALUE "05".
               88  F6-KEY-USED               VALUE "06".
               88  F7-KEY-USED               VALUE "07".
               88  F8-KEY-USED               VALUE "08".
               88  F9-KEY-USED               VALUE "09".
               88  F10-KEY-USED              VALUE "10".
               88  F11-KEY-USED              VALUE "11".
               88  F12-KEY-USED              VALUE "12".
               88  ROLLUP-KEY-USED           VALUE "RU".
           05  TERMINAL-ID          PIC X(10).
           05  FORMAT-NAME          PIC X(10).

       01  DISPLAY-STATUS           PIC X(2).

       01  SRF-INDICATORS.
           05  IND                  PIC 1
                                    OCCURS 99 TIMES
                                    INDICATOR 1.
               88  IND-OFF          VALUE B"0".
               88  IND-ON           VALUE B"1".

       01  OFF-SWITCH               PIC 1  VALUE B"0".
       01  ON-SWITCH                PIC 1  VALUE B"1".

      *-----------------------------------------------------------------
      *          P R O C E D U R E   D I V I S I O N
      *-----------------------------------------------------------------

       PROCEDURE DIVISION.

       BEGIN SECTION.

       0-BEGIN.
           PERFORM 1-HSK.
           PERFORM 6-MAIN THRU 6-MAIN-X.
           PERFORM 2-EOJ.
           GOBACK.

       1-HSK.
           OPEN I-O       REQ-FILE-IO
                          DISPLAY-FILE
                INPUT     MREQ-I.
           PERFORM 9999-FIND-EXPEDITE.
           IF FILE-STATUS > "00"
               MOVE SPACES        TO HOLD-USER-ID
           ELSE
               MOVE REQF-USER-ID  TO HOLD-USER-ID.

       2-EOJ.
           CLOSE          REQ-FILE-IO
                          DISPLAY-FILE
                          MREQ-I.

       6-MAIN SECTION.

       6-BEGIN.
           INITIALIZE DISPLAY-REC
                      DE-BUF.
           MOVE HOLD-USER-ID      TO DE-EXPEDITE-USER.
           MOVE DE-BUF TO DISPLAY-REC.

       6A-DISPLAY-SCREEN.
           MOVE "N" TO REQ-FILE-EOF-SW.

      *--- SHOW FIRST SCREEN WHERE DATA IS ENTERED.
           WRITE DISPLAY-REC FORMAT IS "REQSCRN"
               INDICATORS ARE SRF-INDICATORS.
           IF DISPLAY-STATUS NOT = "00"
               MOVE "PROBLEM ON INIT SCREEN WRITE" TO BU-DISPLAY-MSG
               GO TO 9999-BLOWUP.
           READ DISPLAY-FILE
               FORMAT IS "REQSCRN"
               INDICATORS ARE SRF-INDICATORS.
           MOVE ALL B"0" TO SRF-INDICATORS.
           IF DISPLAY-STATUS NOT = "00"
               MOVE "PROBLEM ON READ SCREEN" TO BU-DISPLAY-MSG
               GO TO 9999-BLOWUP.
           MOVE DISPLAY-REC    TO DE-BUF.

       6B-CHECK-ERRORS.
           IF F3-KEY-USED
               GO TO 6-MAIN-X
           ELSE
               IF F4-KEY-USED
                   NEXT SENTENCE
           ELSE
               IF F1-KEY-USED
      *------- VALIDATE USER.
                   CALL "MCXCHKUSR" USING DE-EXPEDITE-USER VALID-USER
                   IF VALID-USER = "N"
      *                *** A VALID USERID IS REQUIRED ***
                       MOVE ON-SWITCH TO IND (60)
                                         IND (21)
                       MOVE 22027 TO CATREAD-MSG-NUMBER
                       PERFORM 9999-CATREAD
                       MOVE CATREAD-MSG-TEXT TO DE-MSGLN
                       MOVE DE-BUF TO DISPLAY-REC
                       GO TO 6A-DISPLAY-SCREEN
                   ELSE
                       PERFORM 9999-FIND-EXPEDITE
                       IF FILE-STATUS = "00"
                           MOVE DE-EXPEDITE-USER TO REQF-USER-ID
                           REWRITE REQ-FILE-REC FROM BUF-REQ-FILE
                       ELSE
                           MOVE "EXPEDITE    " TO REQF-REQ-NO
                           MOVE DE-EXPEDITE-USER TO REQF-USER-ID
                           WRITE REQ-FILE-REC FROM BUF-REQ-FILE
                       END-IF
                       MOVE DE-EXPEDITE-USER   TO HOLD-USER-ID
                       MOVE ON-SWITCH TO IND (60)
                                         IND (21)
      *                ***  RECORD CHANGED
                       MOVE 44008 TO CATREAD-MSG-NUMBER
                       PERFORM 9999-CATREAD
                       MOVE CATREAD-MSG-TEXT TO DE-MSGLN
                       MOVE DE-BUF TO DISPLAY-REC
                       GO TO 6A-DISPLAY-SCREEN
                   END-IF
           ELSE
           IF DE-ADD-REQ > SPACES
               MOVE DE-ADD-REQ TO REQNO OF MREQ-REC
               READ MREQ-I
                   INVALID KEY MOVE FILE-STATUS TO FILE-STATUS
               END-READ
               IF FILE-STATUS > "00"
                   MOVE ON-SWITCH TO IND (60)
                                     IND (20)
      *           ***  REQUISITION NUMBER DOES NOT EXIST
                   MOVE 18005 TO CATREAD-MSG-NUMBER
                   PERFORM 9999-CATREAD
                   MOVE CATREAD-MSG-TEXT TO DE-MSGLN
                   MOVE DE-BUF TO DISPLAY-REC
                   GO TO 6A-DISPLAY-SCREEN
               END-IF
               MOVE DE-ADD-REQ TO REQNO OF REQ-FILE-IO
               READ REQ-FILE-IO INTO BUF-REQ-NO
                   INVALID KEY MOVE FILE-STATUS TO FILE-STATUS
               END-READ
               IF FILE-STATUS > "00"
                   MOVE DE-ADD-REQ TO REQ-FILE-REC
                   WRITE REQ-FILE-REC
               END-IF
               MOVE ON-SWITCH TO IND (60)
                                 IND (20)
      *       ***  REQUISITION ADDED
               MOVE 18017 TO CATREAD-MSG-NUMBER
               PERFORM 9999-CATREAD
               MOVE CATREAD-MSG-TEXT TO DE-MSGLN
               MOVE DE-BUF TO DISPLAY-REC
               GO TO 6A-DISPLAY-SCREEN
           ELSE
      *------- CAN'T JUST PRESS ENTER ON THE SCREEN; MUST ENTER DATA.
               MOVE ON-SWITCH     TO IND (60)
      *   ***  PRESS FUNCTION KEY ***
               MOVE 16043 TO CATREAD-MSG-NUMBER
               PERFORM 9999-CATREAD
               MOVE CATREAD-MSG-TEXT TO DE-MSGLN
               MOVE DE-BUF        TO DISPLAY-REC
               GO TO 6A-DISPLAY-SCREEN.

       60-LOAD-SCREEN.

           INITIALIZE REC-COUNT.

      *--- SHOW SFLCTL (71) AND CLEAR SFL (72), BUT DON'T SHOW IT (70).

           MOVE ON-SWITCH    TO IND (71)  IND (72).
           MOVE OFF-SWITCH   TO IND (70).

           WRITE SUBFILE DISPLAY-REC FROM BUF-REQ-NO
               FORMAT IS "REQSFLC"
               INDICATORS ARE SRF-INDICATORS.
           IF DISPLAY-STATUS NOT = "00"
               MOVE "PROBLEM ON INIT SFL WRITE" TO BU-DISPLAY-MSG
               GO TO 9999-BLOWUP.

      *--- TURN CLEAR SFL OFF.

           MOVE OFF-SWITCH TO IND (72).

       61-GET-LIST.

           INITIALIZE BUF-REQ-NO.
           PERFORM 64-LIST-RECORDS.

       62-SHOW-SCREEN.

      *--- SHOW FUNCTION KEYS.
           WRITE DISPLAY-REC
               FORMAT IS "REQREC"
               INDICATORS ARE SRF-INDICATORS.
           MOVE ALL B"0" TO SRF-INDICATORS.

           MOVE ON-SWITCH TO IND (70)  IND (71)  IND (73).

      *--- WRITE THE SUBFILE TO SCREEN.
           WRITE SUBFILE DISPLAY-REC
               FORMAT IS "REQSFLC"
               INDICATORS ARE SRF-INDICATORS.
           MOVE ALL B"0" TO SRF-INDICATORS.
           IF DISPLAY-STATUS NOT = "00"
               MOVE "PROBLEM ON SHOW SFL WRITE" TO BU-DISPLAY-MSG
               MOVE REC-COUNT TO BU-DISPLAY-FLD (1)
               MOVE DISPLAY-STATUS TO BU-DISPLAY-FLD (2)
               GO TO 9999-BLOWUP.

      *--- WAIT FOR USER TO PRESS A KEY.
           READ DISPLAY-FILE
               FORMAT IS "REQSFLC"
               INDICATORS ARE SRF-INDICATORS.
           MOVE ALL B"0" TO SRF-INDICATORS.
           IF DISPLAY-STATUS NOT = "00"
               MOVE "PROBLEM ON READ SFL" TO BU-DISPLAY-MSG
               GO TO 9999-BLOWUP.


       63-ACTION.

      *--- THE ENTER KEY IS TREATED THE SAME AS PRESSING THE F3 KEY.
           IF F3-KEY-USED OR ENTER-KEY-USED
               MOVE "N" TO REQ-FILE-EOF-SW
               GO TO 6-BEGIN.

       64-LIST-RECORDS.

           MOVE SPACES TO REQNO OF REQ-FILE-REC.
           START REQ-FILE-IO KEY >= REQNO OF REQ-FILE-REC
               INVALID KEY MOVE "Y" TO REQ-FILE-EOF-SW.
           IF REQ-FILE-EOF-SW = "N"
               READ REQ-FILE-IO NEXT INTO BUF-REQ-FILE
                   AT END MOVE "Y" TO REQ-FILE-EOF-SW.

           IF REQ-FILE-EOF-SW = "Y"
               INITIALIZE DE-BUF
      *   ***  NO DATA TO DISPLAY ***
               MOVE 14134 TO CATREAD-MSG-NUMBER
               PERFORM 9999-CATREAD
               MOVE CATREAD-MSG-TEXT TO DE-MSGLN
               MOVE ON-SWITCH             TO IND (60)
               MOVE DE-BUF                TO DISPLAY-REC
               GO TO 6A-DISPLAY-SCREEN.

           PERFORM UNTIL REQ-FILE-EOF-SW = "Y"
               IF REQF-REQ-NO = "EXPEDITE    "
                   MOVE SPACES            TO REQF-REQ-NO
               END-IF
               MOVE REQF-REQ-NO           TO BUF-REQ-NO

      *------- MOVE THE SCREEN BUFFER AND WRITE OUT.
               MOVE BUF-REQ-NO            TO DISPLAY-REC
               ADD 1                      TO REC-COUNT
               IF REC-COUNT = 9999
      *--- IF SUBFILE IS FILLED UP, PRINT MESSAGE TO LIMIT BY PO OR DATE
                   MOVE ON-SWITCH TO IND (60)
                                     IND (20)  IND (21)
      *       ***  TOO MANY RECORDS TO DISPLAY ***
                   MOVE 20074 TO CATREAD-MSG-NUMBER
                   PERFORM 9999-CATREAD
                   MOVE CATREAD-MSG-TEXT TO DE-MSGLN
                   MOVE DE-BUF TO DISPLAY-REC
                   GO TO 6A-DISPLAY-SCREEN
               END-IF
               WRITE SUBFILE DISPLAY-REC
                   FORMAT IS "REQSFL"
                   INDICATORS ARE SRF-INDICATORS
               END-WRITE
               IF DISPLAY-STATUS NOT = "00"
                   MOVE "SUBFILE WRITE ERROR" TO BU-DISPLAY-MSG
                   MOVE REC-COUNT        TO BU-DISPLAY-FLD (1)
                   MOVE DISPLAY-STATUS   TO BU-DISPLAY-FLD (2)
                   GO TO 9999-BLOWUP
               END-IF

      *------- GET THE NEXT RECORD.
               READ REQ-FILE-IO NEXT INTO BUF-REQ-FILE
                   AT END MOVE "Y" TO REQ-FILE-EOF-SW
               END-READ
               INITIALIZE BUF-REQ-NO
           END-PERFORM.

       6-MAIN-X.
           EXIT.

       9999-FIND-EXPEDITE.
           MOVE "EXPEDITE    " TO REQNO OF REQ-FILE-REC.
           READ REQ-FILE-IO INTO BUF-REQ-FILE
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.

       9999-CATREAD.
           CALL "CCATREAD" USING CATREAD-PARMS.

       9999-BLOWUP.
           MOVE "TUPDRQFL" TO BU-PGM-NAME.
           CALL "TBLOWUP" USING BASE, BU-PGM-NAME, STATUS-AREA,
               VIEW-COMAREA, FILE-STATUS, BU-DISPLAY-MSG,
               BU-DISPLAY-FLDS.
