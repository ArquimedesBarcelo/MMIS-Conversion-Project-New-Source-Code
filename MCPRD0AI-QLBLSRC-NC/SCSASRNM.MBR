003000**************************************************************
003100**                                                          **
003200**                     DATA BASE WORK                       **
003300**                                                          **
003400**************************************************************
003500**************************************************************
003600
003700 01  DSET-NAMES.
003800     05  DSET-NAME             PIC X(16)  VALUE SPACES.
003900     05  DSET-MATLACUM         PIC X(16)  VALUE "MMATL-ACCUM;".
004000     05  DSET-DTRANS           PIC X(16)  VALUE "DTRANS;".
004200
004300 COPY DBMODES    IN COPYLIB.
004600
004700 01 SEARCH-ITEMS.
004800     05  ALL-ITEMS                 PIC X(2)  VALUE "@;".
004900     05  CODE-SEARCH               PIC X(16) VALUE "MATL-CODE;".
005000
005100 01 ARG-VALUES.
005200     05  CODE-ARG                  PIC X(8)  VALUE SPACES.
005400**************************************************************
005500**************************************************************
005600**                                                          **
005700**                     DATA BASE BUFFERS                    **
005800**************************************************************
005900**************************************************************
       01  FILE-STATUS.
           05  FILE-STATUS-1             PIC X    VALUE SPACES.
           05  FILE-STATUS-2             PIC X    VALUE SPACES.
006000
006100 COPY MATLACUM   IN COPYLIB.

DP1248 COPY MATLACUM2  IN COPYLIB.

DP1248*01  BUF-MATLACUM2.
DP1248*    05  MATL-STORES-CODE2         PIC X(8).
006400*****05  FILLER                    PIC X(450).  *REPLACED*
DP1248*    05  FILLER                    PIC X(282).
006500
       01  FILLER                        PIC X(50).

006600 COPY DTRANS     IN COPYLIB.

       01  BUF-DTRANS2.
           05  TRANS-STORES-CODE2        PIC X(8).
     ******05  FILLER                    PIC X(102).  *REPLACED*
           05  FILLER                    PIC X(104).

       01  FILLER                        PIC X(50).

006700 COPY DAPPLFRT   IN COPYLIB.
006800 COPY MULTLOCK   IN COPYLIB.

006900*************************************************************
007000*************************************************************
007100**                                                         **
007200**                  LINKAGE SECTION                        **
007300**                                                         **
007400*************************************************************
007500*************************************************************
007600 LINKAGE SECTION.
007700 01  ACCTG-BASE                    PIC X(10).
007800 01  TC105-RECORD.
007900     05  TC105-DATE                PIC X(6).
008000     05  TC105-TIME                PIC X(6).
008100     05  TC105-TC                  PIC X(3).
008200     05  TC105-PLT                 PIC X(3).
008300     05  TC105-OLD-CODE            PIC X(7).
008400     05  TC105-NEW-CODE            PIC X(7).
008500     05  FILLER                    PIC X(48).
008600 01  RET-CODE                      PIC X(1).
008700 COPY DBSTAT     IN COPYLIB.
008800 01  BU-DISPLAY-MSG.
008900     05  BU-DISPLAY-MSG-1          PIC X(1).
009000     05  FILLER                    PIC X(59).
009100 01  BU-DISPLAY-FLDS.
009200     05  BU-DISPLAY-LINE OCCURS 5 TIMES.
009300         10  BU-DISPLAY-FLD        PIC X(14).
009400         10  BU-DISPLAY-FLD9       PIC S9(8).
009500
009600*************************************************************
009700**#########################################################**
009800*************************************************************
009900**                                                         **
010000**           P R O C E D U R E   D I V I S I O N           **
010100**                                                         **
010200*************************************************************
010300**#########################################################**
010400*************************************************************
010500
010600 PROCEDURE DIVISION USING ACCTG-BASE, TC105-RECORD, RET-CODE,
010700                 STATUS-AREA, BU-DISPLAY-MSG, BU-DISPLAY-FLDS.
010800
010900 SCSASRNM SECTION 06.
011000 6-MAIN.
           MOVE "0"                      TO RET-CODE.
011100     MOVE SPACES                   TO BU-DISPLAY-MSG.
013300
           OPEN I-O MATLACUM-O, DTRANS-O.

013400     MOVE TC105-OLD-CODE           TO  CODE-ARG,
013500                                       BU-DISPLAY-FLD (1).
013600
           MOVE CODE-ARG TO MATLCODE OF MATLACUM-REC-O.
           READ MATLACUM-O INTO BUF-MATLACUM
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS-1 = "2"
014800         MOVE "1"          TO  RET-CODE
               GO TO 6-MAIN-EXIT
           ELSE
           IF FILE-STATUS NOT = "00"
015100         MOVE "DBGET MMATLACCUM * 6-MAIN - SCSASRNM"
015200                               TO  BU-DISPLAY-MSG
               MOVE FILE-STATUS TO BU-DISPLAY-FLD (2)
015300         GO TO 2-BLOWUP.
015400
015500
015600***** IF THE NEW-CODE IS 'NEW'
015700*****        ADD NEW-CODE USING THE BUFFER FROM THE OLD-CODE
015800***** ELSE
015900*****        REPLACE NEW-CODE USING THE BUFFER FROM THE OLD-CODE
016000
016100     MOVE TC105-NEW-CODE           TO  CODE-ARG,
016200                                       BU-DISPLAY-FLD (1).
           MOVE CODE-ARG TO MATLCODE OF MATLACUM-REC-O.
           READ MATLACUM-O INTO BUF-MATLACUM2
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.

016500     IF FILE-STATUS NOT = "00"
016600         IF FILE-STATUS-1 = "2"
016700             MOVE TC105-NEW-CODE   TO  MATL-STORES-CODE
                   MOVE 0 TO COND-WORD
                   WRITE MATLACUM-REC-O FROM BUF-MATLACUM
                     INVALID KEY MOVE FILE-STATUS TO FILE-STATUS
                   END-WRITE
                   IF FILE-STATUS NOT = "00"
017100                 MOVE "DBPUT MMATLACCUM * 6-MAIN - SCSASRNM"
017200                                   TO  BU-DISPLAY-MSG
                       MOVE FILE-STATUS TO BU-DISPLAY-FLD (2)
017300                 GO TO  2-BLOWUP
017400             ELSE
017500                 NEXT SENTENCE
017600         ELSE
017700             MOVE "2DBGET MMATLACCUM * 6-MAIN - SCSASRNM"
017800                                   TO  BU-DISPLAY-MSG
                   MOVE FILE-STATUS TO BU-DISPLAY-FLD (2)
017900             GO TO 2-BLOWUP
018000     ELSE
DP1248         PERFORM 60-COMBINE-OLD-AND-NEW
DP1248*********MOVE BUF-MATLACUM         TO BUF-MATLACUM2
DP1248*********MOVE TC105-NEW-CODE       TO MATL-STORES-CODE2
               REWRITE MATLACUM-REC-O FROM BUF-MATLACUM2
                 INVALID KEY MOVE FILE-STATUS TO FILE-STATUS
               END-REWRITE
               IF FILE-STATUS NOT = "00"
018600             MOVE "DBUPDATE MMATLACCUM * 6-MAIN - SCSASRNM"
018700                                   TO  BU-DISPLAY-MSG
                   MOVE FILE-STATUS TO BU-DISPLAY-FLD (2)
018800             GO TO 2-BLOWUP.
018900
      *------ 20AUG1993 HAD TO REPLACE THE FOLLOWING BLOCK OF LOGIC
019000****** FIND ALL DTRANS ENTRIES CONTAINING THE OLD CODE
019100*    MOVE TC105-OLD-CODE           TO  CODE-ARG,
019200*                                      BU-DISPLAY-FLD (1).
      *    MOVE 0 TO COND-WORD.
      *    MOVE CODE-ARG TO MATLCODE OF DTRANS-REC-O.
      *    START DTRANS-O KEY = MATLCODE OF DTRANS-REC-O
      *        INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
      *    IF FILE-STATUS NOT = "00"
      *        IF FILE-STATUS-1 = "2"
      *            NEXT SENTENCE
      *        ELSE
019900*            MOVE "DBFIND DTRANS * 6-MAIN - SCSASRNM"
020000*                                  TO  BU-DISPLAY-MSG
      *            MOVE FILE-STATUS TO BU-DISPLAY-FLD (2)
020100*            GO TO 2-BLOWUP
020200*    ELSE
020400*        PERFORM 61-GET-PUT-DEL-DTRANS THRU 61-EXIT
020500*        IF BU-DISPLAY-MSG NOT = SPACES
020600*            GO TO 2-BLOWUP.
020700
      *------ FIND AND CHANGE ANY EXISTING DTRANS RECORDS FOR THIS CODE
           PERFORM 61-GET-PUT-DEL-DTRANS THRU 61-EXIT.
           IF BU-DISPLAY-MSG NOT = SPACES
               GO TO 2-BLOWUP.

022600***** DELETE THE MMATLACCUM ENTRY FOR THE OLD-CODE
022700     MOVE TC105-OLD-CODE           TO  CODE-ARG,
022800                                       BU-DISPLAY-FLD (1).
           MOVE CODE-ARG TO MATLCODE OF MATLACUM-REC-O.
           READ MATLACUM-O INTO BUF-MATLACUM
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
023200         MOVE "3DBGET MMATLACCUM * 6-MAIN - SCSASRNM"
023300                                   TO  BU-DISPLAY-MSG
               MOVE FILE-STATUS TO BU-DISPLAY-FLD (2)
023400         GO TO 2-BLOWUP.
023500
           DELETE MATLACUM-O
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
023900         MOVE "DBDELETE MMATLACCUM * 6-MAIN - SCSASRNM"
024000                                   TO  BU-DISPLAY-MSG
               MOVE FILE-STATUS TO BU-DISPLAY-FLD (2)
024100         GO TO 2-BLOWUP.
024900
025000 6-MAIN-EXIT.
           CLOSE MATLACUM-O, DTRANS-O.
025200     GOBACK.
025300
025400
DP1248 60-COMBINE-OLD-AND-NEW.
DP1248     MOVE TC105-NEW-CODE          TO MATL-STORES-CODE2.
DP1248     MOVE MATL-CLASS              TO MATL-CLASS2.
DP1248
DP1248     IF     MATL-BEG-BAL-DOLLARS        NUMERIC
DP1248         IF MATL-BEG-BAL-DOLLARS2       NUMERIC
DP1248             COMPUTE MATL-BEG-BAL-DOLLARS2         =
DP1248                     MATL-BEG-BAL-DOLLARS
DP1248                   + MATL-BEG-BAL-DOLLARS2
DP1248         ELSE
DP1248             MOVE MATL-BEG-BAL-DOLLARS
DP1248               TO MATL-BEG-BAL-DOLLARS2
DP1248     ELSE
DP1248         IF MATL-BEG-BAL-DOLLARS2       NUMERIC
DP1248             NEXT SENTENCE
DP1248         ELSE
DP1248             MOVE +0 TO MATL-BEG-BAL-DOLLARS2.
DP1248
DP1248     IF     MATL-BEG-BAL-UNITS          NUMERIC
DP1248         IF MATL-BEG-BAL-UNITS2         NUMERIC
DP1248             COMPUTE MATL-BEG-BAL-UNITS2           =
DP1248                     MATL-BEG-BAL-UNITS
DP1248                   + MATL-BEG-BAL-UNITS2
DP1248         ELSE
DP1248             MOVE MATL-BEG-BAL-UNITS
DP1248               TO MATL-BEG-BAL-UNITS2
DP1248     ELSE
