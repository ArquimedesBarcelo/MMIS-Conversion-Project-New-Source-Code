       IDENTIFICATION DIVISION.
       PROGRAM-ID.    TCONVEQP.
       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.
       SOURCE-COMPUTER.   AS400.
       OBJECT-COMPUTER.   AS400.
       SPECIAL-NAMES. I-O-FEEDBACK IS I-O-FEEDBACK-AREA
                      LOCAL-DATA IS LOCAL-DATA-AREA.
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT BASIC-FILE
                  ASSIGN TO DATABASE-MCFLMM1003
                  ORGANIZATION IS INDEXED
                  ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                      WITH DUPLICATES
                  FILE STATUS IS BF-STATUS.
           SELECT DISPLAY-FILE
                  ASSIGN TO WORKSTATION-ZCONVEQP-SI
                  ORGANIZATION IS TRANSACTION
                  ACCESS IS SEQUENTIAL
                  FILE STATUS IS DSPLY-STATUS
                  CONTROL-AREA IS WS-CONTROL.
           SELECT DRAWING-FILE
                  ASSIGN TO DATABASE-MCFLDF0103
                  ORGANIZATION IS INDEXED
                  ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                      WITH DUPLICATES
                  FILE STATUS IS DRAW-STATUS.
           SELECT EQUIPMENT-FILE
                  ASSIGN TO DATABASE-MCFPMM0200
                  ORGANIZATION IS SEQUENTIAL
                  ACCESS MODE IS SEQUENTIAL
                  FILE STATUS IS EF-STATUS.
           SELECT EQP-OPERATIONS-FILE
                  ASSIGN TO DATABASE-MCFLER0501
                  ORGANIZATION IS INDEXED
                  ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                      WITH DUPLICATES
                  FILE STATUS IS EOP-STATUS.
           SELECT EQP-REFERENCE-FILE
                  ASSIGN TO DATABASE-MCFLER0101
                  ORGANIZATION IS INDEXED
                  ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                      WITH DUPLICATES
                  FILE STATUS IS ERF-STATUS.
           SELECT EQP-REMARKS-FILE
                  ASSIGN TO DATABASE-MCFLER0301
                  ORGANIZATION IS INDEXED
                  ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                      WITH DUPLICATES
                  FILE STATUS IS ERM-STATUS.
           SELECT HOT-CODE-FILE
                  ASSIGN TO DATABASE-MCFLMM2002
                  ORGANIZATION IS INDEXED
                  ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                      WITH DUPLICATES
                  FILE STATUS IS HCF-STATUS.
           SELECT PLANNED-FILE
                  ASSIGN TO DATABASE-MCFLMM1103
                  ORGANIZATION IS INDEXED
                  ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                      WITH DUPLICATES
                  FILE STATUS IS PF-STATUS.
           SELECT PM-OPENQ-FILE
                  ASSIGN TO DATABASE-MCFLMM3902
                  ORGANIZATION IS INDEXED
                  ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                      WITH DUPLICATES
                  FILE STATUS IS POF-STATUS.
           SELECT PM-SCHEDULE
                  ASSIGN TO DATABASE-MCFLMM4403
                  ORGANIZATION IS INDEXED
                  ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                      WITH DUPLICATES
                  FILE STATUS IS PTF-STATUS.
           SELECT SCHEDULE-FILE
                  ASSIGN TO DATABASE-MCFLMM2303
                  ORGANIZATION IS INDEXED
                  ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                      WITH DUPLICATES
                  FILE STATUS IS SF-STATUS.
           SELECT WO-OPENQ-FILE
                  ASSIGN TO DATABASE-MCFLMM1904
                  ORGANIZATION IS INDEXED
                  ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                      WITH DUPLICATES
                  FILE STATUS IS WOF-STATUS.
       DATA DIVISION.
       FILE SECTION.
       FD  BASIC-FILE
           LABEL RECORDS ARE STANDARD
           DATA RECORD IS BFREC.
       01  BFREC.
           COPY DDS-ALL-FORMATS OF MCFLMM1003.
       FD  DISPLAY-FILE
           LABEL RECORDS ARE OMITTED.
       01  DSPLY-REC               PIC X(2000).
       FD  DRAWING-FILE
           LABEL RECORDS ARE STANDARD
           DATA RECORD IS DRAW-RCD.
       01  DRAW-RCD.
           COPY DDS-ALL-FORMATS OF MCFLDF0103.
       FD  EQUIPMENT-FILE
           LABEL RECORDS ARE STANDARD.
       01  EFREC.
           COPY DDS-ALL-FORMATS OF MCFPMM0200.
       FD  EQP-OPERATIONS-FILE
           LABEL RECORDS ARE STANDARD
           DATA RECORD IS EQP-OPS-RCD.
       01  EQP-OPS-RCD.
           COPY DDS-ALL-FORMATS OF MCFLER0501.
       FD  EQP-REFERENCE-FILE
           LABEL RECORDS ARE STANDARD
           DATA RECORD IS EQP-REF-RCD.
       01  EQP-REF-RCD.
           COPY DDS-ALL-FORMATS OF MCFLER0101.
       FD  EQP-REMARKS-FILE
           LABEL RECORDS ARE STANDARD
           DATA RECORD IS EQP-RMK-RCD.
       01  EQP-RMK-RCD.
           COPY DDS-ALL-FORMATS OF MCFLER0301.
       FD  HOT-CODE-FILE
           LABEL RECORDS ARE STANDARD
           DATA RECORD IS HCFREC.
       01  HCFREC.
           COPY DDS-ALL-FORMATS OF MCFLMM2002.
       FD  PLANNED-FILE
           LABEL RECORDS ARE STANDARD
           DATA RECORD IS PFREC.
       01  PFREC.
           COPY DDS-ALL-FORMATS OF MCFLMM1103.
       FD  PM-OPENQ-FILE
           LABEL RECORDS ARE STANDARD
           DATA RECORD IS POFREC.
       01  POFREC.
           COPY DDS-ALL-FORMATS OF MCFLMM3902.
       FD  PM-SCHEDULE
           LABEL RECORDS ARE STANDARD
           DATA RECORD IS PTFREC.
       01  PTFREC.
           COPY DDS-ALL-FORMATS OF MCFLMM4403.
       FD  SCHEDULE-FILE
           LABEL RECORDS ARE STANDARD
           DATA RECORD IS SFREC.
       01  SFREC.
           COPY DDS-ALL-FORMATS OF MCFLMM2303.
       FD  WO-OPENQ-FILE
           LABEL RECORDS ARE STANDARD
           DATA RECORD IS WOFREC.
       01  WOFREC.
           COPY DDS-ALL-FORMATS OF MCFLMM1904.
       WORKING-STORAGE SECTION.
       COPY CATREAD OF COPYLIB.
       COPY CPYIND  OF COPYLIB.
       01  DBPARAMETERS.           COPY DBPARMS OF COPYLIB.
       01  EQPNUMBUFFER1.
           COPY MEQPFILE OF COPYLIB.
       01  EQUIPMENT-KEY.
           05  EQUIPMENT-NUM                  PIC X(6).
           05  EQUIPMENT-SUB                  PIC X(4).
       01  ERROR-BUFFER.
           05  FILLER                         PIC X(31).
           05  ERR-FILE                       PIC X(12).
           05  FILLER                         PIC X(37).
       01  FILE-STATUSES.
           05  BF-STATUS                      PIC XX.
           05  DRAW-STATUS                     PIC XX.
           05  DSPLY-STATUS                   PIC XX.
           05  EF-STATUS                      PIC XX.
           05  EOP-STATUS                     PIC XX.
           05  ERF-STATUS                     PIC XX.
           05  ERM-STATUS                     PIC XX.
           05  HCF-STATUS                     PIC XX.
           05  PF-STATUS                      PIC XX.
           05  PMF-STATUS                     PIC XX.
           05  POF-STATUS                     PIC XX.
           05  PTF-STATUS                     PIC XX.
           05  SF-STATUS                      PIC XX.
           05  WOF-STATUS                     PIC XX.
       01  HOT-CODE-DATA.                    COPY DHOTCODE OF COPYLIB.
       COPY IOFEEDBACK OF COPYLIB.
       01  PFKEY                              PIC 9(9).
       01  PM-OPENQ-DATA.                    COPY DPMOPENQ OF COPYLIB.
       01  PM-SCHED-DATA.                    COPY DPMSCHED OF COPYLIB.
       01  SAVE-EQP-EQUIP-NUM      PIC X(6).
       01  SCHEDULE-DATA.                    COPY DWOSCHED OF COPYLIB.
       01  SCREEN-BUFFER1.
           05  S-DEPT-IN           PIC X(4).
           05  S-ZONE-IN           PIC X(4).
           05  S-TYPE-IN           PIC X(8).
           05  SCREEN-CMD-LINE1    PIC X(79).
           05  SCREEN-ERR-LINE1    PIC X(79).
       01  SCREEN-BUFFER2.
           05  SCREEN-DATA.
               10 S-EQPNUM         PIC X(6).
               10 S-ENAME          PIC X(50).
               10 S-TYPE           PIC X(8).
               10 S-DEPT           PIC X(4).
               10 S-ZONE           PIC X(4).
               10 S-LOC            PIC X(8).
               10 S-RIME           PIC XX.
               10 S-EXPCLASS       PIC X(8).
               10 S-CORPDESC       PIC X(50).
               10 S-DOWNCOST       PIC X(6).
               10 S-SFTYFLAG       PIC X.
           05  SCREEN-CMD-LINE2    PIC X(79).
           05  SCREEN-ERR-LINE2    PIC X(79).
       COPY DBSTAT      OF COPYLIB.
       01  TRUE-VAL                PIC 1 VALUE B"1".
       01  WO-BASIC-DATA.                    COPY DWOBASIC OF COPYLIB.
       01  WO-OPENQ-DATA.                    COPY DWOOPENQ OF COPYLIB.
           COPY MEQPREF OF COPYLIB.
           COPY DEQPREM OF COPYLIB.
           COPY DEQPOPS OF COPYLIB.
       01  WO-DRAWING-DATA.                  COPY DDRAWFIL OF COPYLIB.
       01  WO-PLANNED-DATA.                  COPY DWOPLAN  OF COPYLIB.
       COPY VCOMLINK    OF COPYLIB.
       COPY WSCONTROL   OF COPYLIB.
       PROCEDURE DIVISION.
       START-PROGRAM.
           OPEN I-O   BASIC-FILE.
           OPEN I-O   DISPLAY-FILE.
           OPEN I-O   DRAWING-FILE.
           OPEN I-O   EQUIPMENT-FILE.
           OPEN I-O   EQP-OPERATIONS-FILE.
           OPEN I-O   EQP-REFERENCE-FILE.
           OPEN I-O   EQP-REMARKS-FILE.
           OPEN I-O   HOT-CODE-FILE.
           OPEN I-O   PLANNED-FILE.
           OPEN I-O   PM-OPENQ-FILE.
           OPEN I-O   PM-SCHEDULE.
           OPEN I-O   SCHEDULE-FILE.
           OPEN I-O   WO-OPENQ-FILE.
           MOVE 0 TO VIEW-LASTKEY.
           PERFORM 6-MAIN UNTIL VIEW-LASTKEY = 3.

       2-EOJ.
           CLOSE BASIC-FILE.
           CLOSE DISPLAY-FILE.
           CLOSE DRAWING-FILE.
           CLOSE EQP-OPERATIONS-FILE.
           CLOSE EQP-REFERENCE-FILE.
           CLOSE EQP-REMARKS-FILE.
           CLOSE EQUIPMENT-FILE.
           CLOSE HOT-CODE-FILE.
           CLOSE PLANNED-FILE.
           CLOSE PM-OPENQ-FILE.
           CLOSE PM-SCHEDULE.
           CLOSE SCHEDULE-FILE.
           CLOSE WO-OPENQ-FILE.
           GOBACK.

       5-READ-EQUIPMENT-FILE.
           READ EQUIPMENT-FILE NEXT INTO EQPNUMBUFFER1
               AT END    MOVE 11 TO COND-WORD.
           IF COND-WORD = 11
               NEXT SENTENCE
           ELSE
           IF S-DEPT-IN = "    "
               IF S-ZONE-IN = "    "
                   IF S-TYPE-IN = "        "
                       NEXT SENTENCE
                   ELSE
                   IF S-TYPE-IN NOT = EQP-TYPE OF EQPNUMBUFFER1
                       GO TO 5-READ-EQUIPMENT-FILE
                   ELSE
                   NEXT SENTENCE
               ELSE
               IF S-ZONE-IN NOT = EQP-MAINT-ZONE OF EQPNUMBUFFER1
                   GO TO 5-READ-EQUIPMENT-FILE
               ELSE
               NEXT SENTENCE
           ELSE
           IF S-DEPT-IN NOT = EQP-DEPT OF EQPNUMBUFFER1
               GO TO 5-READ-EQUIPMENT-FILE.
           IF EF-STATUS NOT = "00" MOVE 11 TO COND-WORD.

       6-MAIN.
           PERFORM 60-SHOW-SCREEN.
           PERFORM 61-READ-SCREEN THRU 61-RSE-EXIT.

       60-SHOW-SCREEN.
           MOVE "FMASSEQP" TO VIEW-CFNAME.
           MOVE SPACES TO SCREEN-BUFFER1.
           MOVE SCREEN-BUFFER1 TO DSPLY-REC.
           PERFORM 99-SCREEN-WRITE.

       61-READ-SCREEN.
           PERFORM 98-SCREEN-READ.
           IF VIEW-LASTKEY = 3 GO TO 61-RSE-EXIT.
           IF VIEW-LASTKEY = 0
               NEXT SENTENCE
           ELSE
           MOVE 35126 TO CATREAD-MSG-NUMBER
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
           MOVE TRUE-VAL TO INDS (1) INDS (99)
           MOVE ERROR-BUFFER TO SCREEN-ERR-LINE1
           MOVE SCREEN-BUFFER1 TO DSPLY-REC
           PERFORM 99-SCREEN-WRITE
           GO TO 61-READ-SCREEN.
           MOVE DSPLY-REC TO SCREEN-BUFFER1.
           PERFORM 610-MOD-EQPNUM-SETS THRU 610-MES-EXIT
               UNTIL (COND-WORD = 11) OR (VIEW-LASTKEY = 3).
           MOVE 0 TO COND-WORD VIEW-LASTKEY.
       61-RSE-EXIT.    EXIT.

       610-MOD-EQPNUM-SETS.
           PERFORM 5-READ-EQUIPMENT-FILE.
           IF COND-WORD = 11
               CLOSE EQUIPMENT-FILE
               OPEN I-O EQUIPMENT-FILE
               GO TO 610-MES-EXIT.
           MOVE "FMASSEQP2"        TO VIEW-CFNAME.
           MOVE SPACES             TO SCREEN-BUFFER2.
           MOVE EQP-EQUIP-NUM      TO S-EQPNUM SAVE-EQP-EQUIP-NUM.
           MOVE EQP-EQUIP-NAME     TO S-ENAME.
           MOVE EQP-TYPE           TO S-TYPE.
           MOVE EQP-DEPT           TO S-DEPT.
           MOVE EQP-MAINT-ZONE     TO S-ZONE.
           MOVE EQP-LOCATION       TO S-LOC.
           MOVE EQP-RIME           TO S-RIME.
           MOVE EQP-EXP-CLASS      TO S-EXPCLASS.
           MOVE EQP-CORP-DESC      TO S-CORPDESC.
           MOVE EQP-DOWN-COST      TO S-DOWNCOST.
           MOVE EQP-SAFETY-FLG     TO S-SFTYFLAG.
           MOVE 13059              TO CATREAD-MSG-NUMBER.
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
           MOVE ERROR-BUFFER       TO SCREEN-CMD-LINE2.
           MOVE SCREEN-BUFFER2     TO DSPLY-REC.
           PERFORM 99-SCREEN-WRITE.
           PERFORM 98-SCREEN-READ.
           IF VIEW-LASTKEY = 1 GO TO 610-MOD-EQPNUM-SETS.
           IF VIEW-LASTKEY = 3 GO TO 610-MES-EXIT.
           MOVE DSPLY-REC          TO SCREEN-BUFFER2.
           MOVE S-EQPNUM           TO EQP-EQUIP-NUM OF EQPNUMBUFFER1.
           MOVE S-ENAME            TO EQP-EQUIP-NAME OF EQPNUMBUFFER1.
           MOVE S-TYPE             TO EQP-TYPE OF EQPNUMBUFFER1.
           MOVE S-DEPT             TO EQP-DEPT OF EQPNUMBUFFER1.
           MOVE S-ZONE             TO EQP-MAINT-ZONE OF EQPNUMBUFFER1.
           MOVE S-LOC              TO EQP-LOCATION OF EQPNUMBUFFER1.
           MOVE S-RIME             TO EQP-RIME OF EQPNUMBUFFER1.
           MOVE S-EXPCLASS         TO EQP-EXP-CLASS OF EQPNUMBUFFER1.
           MOVE S-CORPDESC         TO EQP-CORP-DESC OF EQPNUMBUFFER1.
           MOVE S-DOWNCOST         TO EQP-DOWN-COST OF EQPNUMBUFFER1.
           MOVE S-SFTYFLAG         TO EQP-SAFETY-FLG OF EQPNUMBUFFER1.
           MOVE SAVE-EQP-EQUIP-NUM TO EQPNUM OF BFREC.
           START BASIC-FILE KEY = EXTERNALLY-DESCRIBED-KEY.
           MOVE TRUE-VAL           TO INDS (98).
           MOVE 66378              TO CATREAD-MSG-NUMBER.
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
           MOVE "CHANGES STARTED" TO SCREEN-CMD-LINE2.
      *    MOVE "VERBAL W/O  "     TO ERR-FILE.
      *    MOVE ERROR-BUFFER       TO SCREEN-CMD-LINE2.
      *    MOVE SCREEN-BUFFER2     TO DSPLY-REC.
           PERFORM 99-SCREEN-WRITE.
      *    CALL "CLPAUSE2".
           PERFORM 98A-SCREEN-READ.
           PERFORM MOD-BASIC-EQPNUMS      THRU MBE-EXIT.

           MOVE SAVE-EQP-EQUIP-NUM TO DRWEQPNUM OF DRAW-RCD.
           START DRAWING-FILE KEY = EXTERNALLY-DESCRIBED-KEY.
      *    MOVE TRUE-VAL           TO INDS (98).
      *    MOVE "DRAWING     "     TO ERR-FILE.
      *    MOVE ERROR-BUFFER       TO SCREEN-CMD-LINE2.
      *    MOVE SCREEN-BUFFER2     TO DSPLY-REC.
      *    PERFORM 99-SCREEN-WRITE.
      *    CALL "CLPAUSE2".
      *    PERFORM 98A-SCREEN-READ.
           PERFORM MOD-DRAWING-EQPNUMS  THRU MDE-EXIT.

           MOVE SPACES             TO EQUIPMENT-KEY.
           MOVE SAVE-EQP-EQUIP-NUM TO EQUIPMENT-NUM.
           MOVE EQUIPMENT-KEY      TO EQRSUBKEY OF EQP-OPS-RCD.
           START EQP-OPERATIONS-FILE KEY > EXTERNALLY-DESCRIBED-KEY.
      *    MOVE TRUE-VAL           TO INDS (98).
      *    MOVE "EQP OPERATIO"     TO ERR-FILE.
      *    MOVE ERROR-BUFFER       TO SCREEN-CMD-LINE2.
      *    MOVE SCREEN-BUFFER2     TO DSPLY-REC.
      *    PERFORM 99-SCREEN-WRITE.
      *    CALL "CLPAUSE2".
      *    PERFORM 98A-SCREEN-READ.
           PERFORM MOD-EQP-OPERATIONS-EQPNUMS  THRU MEOPE-EXIT.

           MOVE SPACES             TO EQUIPMENT-KEY.
           MOVE SAVE-EQP-EQUIP-NUM TO EQUIPMENT-NUM.
           MOVE EQUIPMENT-KEY      TO EQRSUBKEY OF EQP-REF-RCD.
           START EQP-REFERENCE-FILE KEY > EXTERNALLY-DESCRIBED-KEY.
      *    MOVE TRUE-VAL           TO INDS (98).
      *    MOVE "EQP REFERENC"     TO ERR-FILE.
      *    MOVE ERROR-BUFFER       TO SCREEN-CMD-LINE2.
      *    MOVE SCREEN-BUFFER2     TO DSPLY-REC.
      *    PERFORM 99-SCREEN-WRITE.
      *    CALL "CLPAUSE2".
      *    PERFORM 98A-SCREEN-READ.
           PERFORM MOD-EQP-REFERENCE-EQPNUMS  THRU MERFE-EXIT.

           MOVE SPACES             TO EQUIPMENT-KEY.
           MOVE SAVE-EQP-EQUIP-NUM TO EQUIPMENT-NUM.
           MOVE EQUIPMENT-KEY      TO EQRSUBKEY OF EQP-RMK-RCD.
           START EQP-REMARKS-FILE KEY > EXTERNALLY-DESCRIBED-KEY.
      *    MOVE TRUE-VAL           TO INDS (98).
      *    MOVE "EQP REMARKS "     TO ERR-FILE.
      *    MOVE ERROR-BUFFER       TO SCREEN-CMD-LINE2.
      *    MOVE SCREEN-BUFFER2     TO DSPLY-REC.
      *    PERFORM 99-SCREEN-WRITE.
      *    CALL "CLPAUSE2".
      *    PERFORM 98A-SCREEN-READ.
           PERFORM MOD-EQP-REMARKS-EQPNUMS  THRU MERME-EXIT.

           MOVE SAVE-EQP-EQUIP-NUM TO EQPNUM OF HCFREC.
           START HOT-CODE-FILE KEY = EXTERNALLY-DESCRIBED-KEY.
      *    MOVE TRUE-VAL           TO INDS (98).
      *    MOVE "HOT CODE    "     TO ERR-FILE.
      *    MOVE ERROR-BUFFER       TO SCREEN-CMD-LINE2.
      *    MOVE SCREEN-BUFFER2     TO DSPLY-REC.
      *    PERFORM 99-SCREEN-WRITE.
      *    CALL "CLPAUSE2".
      *    PERFORM 98A-SCREEN-READ.
           PERFORM MOD-HOT-CODE-EQPNUMS   THRU MHCE-EXIT.

           MOVE SAVE-EQP-EQUIP-NUM TO EQPNUM OF PFREC.
           START PLANNED-FILE KEY = EXTERNALLY-DESCRIBED-KEY.
      *    MOVE TRUE-VAL           TO INDS (98).
      *    MOVE "PLANNED W/O  "    TO ERR-FILE.
      *    MOVE ERROR-BUFFER       TO SCREEN-CMD-LINE2.
      *    MOVE SCREEN-BUFFER2     TO DSPLY-REC.
      *    PERFORM 99-SCREEN-WRITE.
      *    CALL "CLPAUSE2".
      *    PERFORM 98A-SCREEN-READ.
           PERFORM MOD-PLANNED-EQPNUMS    THRU MPE-EXIT.

           MOVE SAVE-EQP-EQUIP-NUM TO EQPNUM OF POFREC.
           START PM-OPENQ-FILE KEY = EXTERNALLY-DESCRIBED-KEY.
      *    MOVE TRUE-VAL           TO INDS (98).
      *    MOVE "PM OPENQ    "     TO ERR-FILE.
      *    MOVE ERROR-BUFFER       TO SCREEN-CMD-LINE2.
      *    MOVE SCREEN-BUFFER2     TO DSPLY-REC.
      *    PERFORM 99-SCREEN-WRITE.
      *    CALL "CLPAUSE2".
      *    PERFORM 98A-SCREEN-READ.
           PERFORM MOD-PM-OPENQ-EQPNUMS   THRU MPOE-EXIT.

           MOVE SAVE-EQP-EQUIP-NUM TO PMEQPNUM OF PTFREC.
           START PM-SCHEDULE KEY = EXTERNALLY-DESCRIBED-KEY.
      *    MOVE TRUE-VAL           TO INDS (98).
      *    MOVE "PM TRANS    "     TO ERR-FILE.
      *    MOVE ERROR-BUFFER       TO SCREEN-CMD-LINE2.
      *    MOVE SCREEN-BUFFER2     TO DSPLY-REC.
      *    PERFORM 99-SCREEN-WRITE.
      *    CALL "CLPAUSE2".
      *    PERFORM 98A-SCREEN-READ.
           PERFORM MOD-PM-SCHED-EQPNUMS   THRU MPTE-EXIT.

           MOVE SAVE-EQP-EQUIP-NUM TO EQPNUM OF SFREC.
           START SCHEDULE-FILE KEY = EXTERNALLY-DESCRIBED-KEY.
      *    MOVE TRUE-VAL           TO INDS (98).
      *    MOVE "SCHEDULE    "     TO ERR-FILE.
      *    MOVE ERROR-BUFFER       TO SCREEN-CMD-LINE2.
      *    MOVE SCREEN-BUFFER2     TO DSPLY-REC.
      *    PERFORM 99-SCREEN-WRITE.
      *    CALL "CLPAUSE2".
      *    PERFORM 98A-SCREEN-READ.
           PERFORM MOD-SCHEDULE-EQPNUMS   THRU MSE-EXIT.

           MOVE SAVE-EQP-EQUIP-NUM TO EQPNUM OF WOFREC.
           START WO-OPENQ-FILE KEY = EXTERNALLY-DESCRIBED-KEY.
      *    MOVE TRUE-VAL           TO INDS (98).
      *    MOVE "WO OPENQ    "     TO ERR-FILE.
      *    MOVE ERROR-BUFFER       TO SCREEN-CMD-LINE2.
      *    MOVE SCREEN-BUFFER2     TO DSPLY-REC.
      *    PERFORM 99-SCREEN-WRITE.
      *    CALL "CLPAUSE2".
      *    PERFORM 98A-SCREEN-READ.
           PERFORM MOD-WO-OPENQ-EQPNUMS   THRU MWOE-EXIT.

           REWRITE EFREC FROM EQPNUMBUFFER1.
      *    MOVE 39                 TO CATREAD-MSG-NUMBER.
      *    PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
      *    MOVE ERROR-BUFFER        TO SCREEN-CMD-LINE2.
           MOVE "CHANGES COMPLETED " TO SCREEN-CMD-LINE2.
           MOVE TRUE-VAL            TO INDS (98).
           MOVE SCREEN-BUFFER2      TO DSPLY-REC.
           PERFORM 99-SCREEN-WRITE.
           PERFORM 98A-SCREEN-READ.
           CALL "CLPAUSE2".
           MOVE SPACES               TO ERROR-BUFFER.
       610-MES-EXIT.    EXIT.

       MOD-BASIC-EQPNUMS.
           READ BASIC-FILE NEXT INTO WO-BASIC-DATA
               AT END    GO TO MBE-EXIT.
           IF BF-STATUS NOT = "00" GO TO MBE-EXIT.
           IF EQUIP-NUM > SAVE-EQP-EQUIP-NUM
               GO TO MBE-EXIT
           ELSE
           IF EQUIP-NUM = SAVE-EQP-EQUIP-NUM
               MOVE EQP-EQUIP-NUM   TO EQUIP-NUM OF WO-BASIC-DATA
               MOVE EQP-EQUIP-NAME  TO EQUIP-NAME OF WO-BASIC-DATA
               MOVE EQP-TYPE        TO TYPE-NUM OF WO-BASIC-DATA
               MOVE EQP-DEPT        TO DEPT OF WO-BASIC-DATA
               MOVE EQP-MAINT-ZONE  TO ZONE OF WO-BASIC-DATA
               MOVE EQP-LOCATION    TO LOCATION OF WO-BASIC-DATA
      *        MOVE EQP-EXP-CLASS   TO EXP-CLASS OF WO-BASIC-DATA
               REWRITE BFREC FROM WO-BASIC-DATA
               GO TO MOD-BASIC-EQPNUMS
           ELSE
           GO TO MOD-BASIC-EQPNUMS.
       MBE-EXIT.    EXIT.

       MOD-DRAWING-EQPNUMS.
           READ DRAWING-FILE NEXT INTO WO-DRAWING-DATA
               AT END    GO TO MDE-EXIT.
           IF DRAW-STATUS NOT = "00" GO TO MDE-EXIT.
           IF DRAW-ENUM OF WO-DRAWING-DATA > SAVE-EQP-EQUIP-NUM
               GO TO MDE-EXIT
           ELSE
           IF DRAW-ENUM OF WO-DRAWING-DATA = SAVE-EQP-EQUIP-NUM
               MOVE EQP-EQUIP-NUM OF EQPNUMBUFFER1 TO DRAW-ENUM
                                                   OF WO-DRAWING-DATA
               MOVE EQP-TYPE OF EQPNUMBUFFER1 TO DRAW-TNUM
                                              OF WO-DRAWING-DATA
               MOVE EQP-MAINT-ZONE OF EQPNUMBUFFER1 TO DRAW-ZONE
                                                    OF WO-DRAWING-DATA
               MOVE EQP-DEPT OF EQPNUMBUFFER1 TO DRAW-DEPT
                                              OF WO-DRAWING-DATA
               REWRITE DRAW-RCD FROM WO-DRAWING-DATA
               GO TO MOD-DRAWING-EQPNUMS
           ELSE
           GO TO MOD-DRAWING-EQPNUMS.
       MDE-EXIT.    EXIT.

       MOD-EQP-OPERATIONS-EQPNUMS.
           READ EQP-OPERATIONS-FILE NEXT INTO BUF-EQP-OPS
               AT END    GO TO MEOPE-EXIT.
           IF EOP-STATUS NOT = "00" GO TO MEOPE-EXIT.
           IF ESK-EQUIP OF BUF-EQP-OPS > SAVE-EQP-EQUIP-NUM
               GO TO MEOPE-EXIT
           ELSE
           IF ESK-EQUIP OF BUF-EQP-OPS = SAVE-EQP-EQUIP-NUM
               MOVE EQP-EQUIP-NUM OF EQPNUMBUFFER1 TO ESK-EQUIP
                                                      OF BUF-EQP-OPS
               REWRITE EQP-OPS-RCD FROM BUF-EQP-OPS
               GO TO MOD-EQP-OPERATIONS-EQPNUMS
           ELSE
           GO TO MOD-EQP-OPERATIONS-EQPNUMS.
       MEOPE-EXIT.    EXIT.

       MOD-EQP-REFERENCE-EQPNUMS.
           READ EQP-REFERENCE-FILE NEXT INTO BUF-EQP-REF
               AT END    GO TO MERFE-EXIT.
           IF ERF-STATUS NOT = "00" GO TO MERFE-EXIT.
           IF ESK-EQUIP OF BUF-EQP-REF > SAVE-EQP-EQUIP-NUM
             GO TO MERFE-EXIT
           ELSE
           IF ESK-EQUIP OF BUF-EQP-REF = SAVE-EQP-EQUIP-NUM
               MOVE EQP-EQUIP-NUM OF EQPNUMBUFFER1 TO ESK-EQUIP
                                                       OF BUF-EQP-REF
               MOVE EQP-TYPE OF EQPNUMBUFFER1 TO EQP-CORP-TYPE
                                                       OF BUF-EQP-REF
               REWRITE EQP-REF-RCD FROM BUF-EQP-REF
               GO TO MOD-EQP-REFERENCE-EQPNUMS
           ELSE
           GO TO MOD-EQP-REFERENCE-EQPNUMS.
       MERFE-EXIT.    EXIT.

       MOD-EQP-REMARKS-EQPNUMS.
           READ EQP-REMARKS-FILE NEXT INTO BUF-EQP-REM
               AT END    GO TO MERME-EXIT.
           IF ERM-STATUS NOT = "00" GO TO MERME-EXIT.
           IF ESK-EQUIP OF BUF-EQP-REM > SAVE-EQP-EQUIP-NUM
               GO TO MERME-EXIT
           ELSE
           IF ESK-EQUIP OF BUF-EQP-REM = SAVE-EQP-EQUIP-NUM
               MOVE EQP-EQUIP-NUM OF EQPNUMBUFFER1 TO ESK-EQUIP
                                                      OF BUF-EQP-REM
               REWRITE EQP-RMK-RCD FROM BUF-EQP-REM
               GO TO MOD-EQP-REMARKS-EQPNUMS
           ELSE
           GO TO MOD-EQP-REMARKS-EQPNUMS.
       MERME-EXIT.    EXIT.

       MOD-HOT-CODE-EQPNUMS.
           READ HOT-CODE-FILE NEXT INTO HOT-CODE-DATA
               AT END    GO TO MHCE-EXIT.
           IF HCF-STATUS NOT = "00" GO TO MHCE-EXIT.
           IF HC-EQUIP-NUM > SAVE-EQP-EQUIP-NUM
               GO TO MHCE-EXIT
           ELSE
           IF HC-EQUIP-NUM = SAVE-EQP-EQUIP-NUM
               MOVE EQP-EQUIP-NUM OF EQPNUMBUFFER1 TO HC-EQUIP-NUM
               MOVE EQP-MAINT-ZONE OF EQPNUMBUFFER1 TO HC-ZONE
               REWRITE HCFREC FROM HOT-CODE-DATA
               GO TO MOD-HOT-CODE-EQPNUMS
           ELSE
           GO TO MOD-HOT-CODE-EQPNUMS.
       MHCE-EXIT.    EXIT.

       MOD-PLANNED-EQPNUMS.
           READ PLANNED-FILE NEXT INTO WO-PLANNED-DATA
               AT END    GO TO MPE-EXIT.
           IF PF-STATUS NOT = "00" GO TO MPE-EXIT.
           IF EQUIP-NUM-P > SAVE-EQP-EQUIP-NUM
               GO TO MPE-EXIT
           ELSE
           IF EQUIP-NUM-P = SAVE-EQP-EQUIP-NUM
               MOVE EQP-EQUIP-NUM  OF EQPNUMBUFFER1 TO EQUIP-NUM-P
               MOVE EQP-EQUIP-NAME OF EQPNUMBUFFER1 TO EQUIP-NAME-P
               MOVE EQP-TYPE       OF EQPNUMBUFFER1 TO TYPE-NUM-P
               MOVE EQP-DEPT       OF EQPNUMBUFFER1 TO DEPT-P
               MOVE EQP-MAINT-ZONE OF EQPNUMBUFFER1 TO ZONE-P
               MOVE EQP-LOCATION   OF EQPNUMBUFFER1 TO LOCATION-P
      *        MOVE EQP-EXP-CLASS  OF EQPNUMBUFFER1 TO EXP-CLASS-P
               REWRITE PFREC FROM WO-PLANNED-DATA
               GO TO MOD-PLANNED-EQPNUMS
           ELSE
           GO TO MOD-PLANNED-EQPNUMS.
       MPE-EXIT.    EXIT.

       MOD-PM-OPENQ-EQPNUMS.
           READ PM-OPENQ-FILE NEXT INTO PM-OPENQ-DATA
               AT END    GO TO MPOE-EXIT.
           IF POF-STATUS NOT = "00" GO TO MPOE-EXIT.
           IF PMQ-EQUIP-NUM > SAVE-EQP-EQUIP-NUM
               GO TO MPOE-EXIT
           ELSE
           IF PMQ-EQUIP-NUM = SAVE-EQP-EQUIP-NUM
               MOVE EQP-EQUIP-NUM OF EQPNUMBUFFER1 TO PMQ-EQUIP-NUM
               MOVE EQP-MAINT-ZONE OF EQPNUMBUFFER1 TO PMQ-ZONE
               REWRITE POFREC FROM PM-OPENQ-DATA
               GO TO MOD-PM-OPENQ-EQPNUMS
           ELSE
           GO TO MOD-PM-OPENQ-EQPNUMS.
       MPOE-EXIT.    EXIT.

       MOD-PM-SCHED-EQPNUMS.
           READ PM-SCHEDULE NEXT INTO PM-SCHED-DATA
               AT END    GO TO MPTE-EXIT.
           IF PTF-STATUS NOT = "00" GO TO MPTE-EXIT.
           IF SCH-EQUIP-NUM > SAVE-EQP-EQUIP-NUM
               GO TO MPTE-EXIT
           ELSE
           IF SCH-EQUIP-NUM = SAVE-EQP-EQUIP-NUM
               MOVE EQP-EQUIP-NUM OF EQPNUMBUFFER1 TO SCH-EQUIP-NUM
               REWRITE PTFREC FROM PM-SCHED-DATA
               GO TO MOD-PM-SCHED-EQPNUMS
           ELSE
           GO TO MOD-PM-SCHED-EQPNUMS.
       MPTE-EXIT.    EXIT.

       MOD-SCHEDULE-EQPNUMS.
           READ SCHEDULE-FILE NEXT INTO SCHEDULE-DATA
               AT END    GO TO MSE-EXIT.
           IF SF-STATUS NOT = "00" GO TO MSE-EXIT.
           IF SCHED-EQ-NUM > SAVE-EQP-EQUIP-NUM
               GO TO MSE-EXIT
           ELSE
           IF SCHED-EQ-NUM = SAVE-EQP-EQUIP-NUM
               MOVE EQP-EQUIP-NUM OF EQPNUMBUFFER1 TO SCHED-EQ-NUM
               MOVE EQP-MAINT-ZONE OF EQPNUMBUFFER1 TO SCHED-Z
               REWRITE SFREC FROM SCHEDULE-DATA
               GO TO MOD-SCHEDULE-EQPNUMS
           ELSE
           GO TO MOD-SCHEDULE-EQPNUMS.
       MSE-EXIT.    EXIT.

       MOD-WO-OPENQ-EQPNUMS.
           READ WO-OPENQ-FILE NEXT INTO WO-OPENQ-DATA
               AT END    GO TO MWOE-EXIT.
           IF WOF-STATUS NOT = "00" GO TO MWOE-EXIT.
           IF Q-EQUIP-NUM > SAVE-EQP-EQUIP-NUM
               GO TO MWOE-EXIT
           ELSE
           IF Q-EQUIP-NUM = SAVE-EQP-EQUIP-NUM
               MOVE EQP-EQUIP-NUM OF EQPNUMBUFFER1 TO Q-EQUIP-NUM
               MOVE EQP-MAINT-ZONE OF EQPNUMBUFFER1 TO Q-ZONE
               REWRITE WOFREC FROM WO-OPENQ-DATA
               GO TO MOD-WO-OPENQ-EQPNUMS
           ELSE
           GO TO MOD-WO-OPENQ-EQPNUMS.
       MWOE-EXIT.    EXIT.

       98-SCREEN-READ.
           READ DISPLAY-FILE FORMAT IS VIEW-CFNAME
               INDIC IS INDICS.
           ACCEPT IOFEEDBACK FROM I-O-FEEDBACK-AREA.
           MOVE ALL B"0" TO INDICS.
           IF DSPLY-STATUS NOT = "00"
               MOVE 3 TO VIEW-LASTKEY
           ELSE
           MOVE FUNCTION-NUM TO VIEW-LASTKEY.

       98A-SCREEN-READ.
           READ DISPLAY-FILE TERMINAL IS TERMINAL-ID
               INDIC IS INDICS
                  NO DATA MOVE DSPLY-STATUS TO DSPLY-STATUS.
           MOVE ALL B"0" TO INDICS.

       99-SCREEN-WRITE.
           WRITE DSPLY-REC FORMAT IS VIEW-CFNAME
               INDIC IS INDICS.
           MOVE ALL B"0" TO INDICS.

       999-CATREAD.
           MOVE SPACES TO ERROR-BUFFER.
           CALL "CCATREAD" USING CATREAD-PARMS.
           MOVE CATREAD-MSG-TEXT TO ERROR-BUFFER.
       999-CATREAD-EXIT.    EXIT.
