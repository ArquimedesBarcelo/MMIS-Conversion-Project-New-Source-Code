004500     05  IN-BUYER-CODE             PIC X(4).
004600     05  FILLER                    PIC X(3).
004700
004800 01  PO-VENDOR-BUFFER.
004900     05  IN-VENDOR-CODE.
005000         10  IN-VENDOR-CODE1-7     PIC X(7).
005100         10  IN-VENDOR-CODE8-10    PIC X(3).
005200     05  IN-VENDOR-NAME            PIC X(44).
005300     05  IN-PO-BUDGET-NUMBER       PIC X(12).
005400     05  IN-PO-BUDGET-AMT-9        PIC S9(8).
005500     05  IN-PO-BUDGET-AMT-X REDEFINES IN-PO-BUDGET-AMT-9
005600                                   PIC X(8).
005700     05  IN-PO-SHIP-DATE.
005800         10 IN-PO-SHIP-MM          PIC XX.
005900         10 IN-PO-SHIP-DD          PIC XX.
006000         10 IN-PO-SHIP-YY          PIC XX.
006100     05  IN-EXP-DATE.
006200         10  IN-EXP-DATE-MM        PIC XX.
006300         10  IN-EXP-DATE-DD        PIC XX.
006400         10  IN-EXP-DATE-YY        PIC XX.
006500     05  IN-CURRENCY-CODE          PIC X(2).
006600     05  IN-LAST-RELEASE           PIC 9(3).
006700     05  IN-LAST-RELEASE-X  REDEFINES  IN-LAST-RELEASE
006800                                   PIC X(3).
           05  IN-LAST-CHANGE-NOTICE     PIC X(3).
           05  IN-INVOICELESS-IND        PIC X(1).
006900     05  FILLER                    PIC X(25).
007000
007100 01  STR-ITEM-BUFFER.
007200     05  IN-CORP-CODE              PIC X(8).
007300     05  IN-ITM-NUM                PIC X(4).
007400     05  IN-ITM-NUM-9 REDEFINES IN-ITM-NUM
007500                                   PIC 9(4).
007600     05  IN-ITM-QTY-ORD-9          PIC S9(8)V9(4).
007700     05  IN-ITM-QTY-ORD-X REDEFINES IN-ITM-QTY-ORD-9
007800                                   PIC X(12).
007900     05  IN-ITM-QTY-UM             PIC XX.
008000     05  IN-ITM-PRICE-UM           PIC X(2).
008100     05  IN-ITM-UNIT-PRICE-9  PIC S9(8)V9(4).
008200     05  IN-ITM-UNIT-PRICE-X REDEFINES IN-ITM-UNIT-PRICE-9
008300                                   PIC X(12).
008400     05  IN-ITM-SUB-DETAIL         PIC X(4).
008500     05  IN-ITM-ADDL-DATA          PIC X(6).
008600     05  IN-ITM-REQ-NO             PIC X(10).
008700     05  IN-ITM-CONTAINER-INDIC    PIC X.
008800     05  FILLER                    PIC X(59).
008900
009000 01  NS-ITEM-BUFFER.
009100     05  IN-NSTR-ITM-NUM           PIC X(4).
009200     05  IN-NSTR-QTY-UM            PIC X(2).
009300     05  IN-NSTR-QTY-ORD-9 PIC S9(8)V9(4).
009400     05  IN-NSTR-QTY-ORD-X REDEFINES IN-NSTR-QTY-ORD-9
009500                                   PIC X(12).
009600     05  IN-NSTR-PRICE-UM          PIC X(2).
009700     05  IN-NSTR-UNIT-PRICE-9  PIC S9(8)V9(4).
009800     05  IN-NSTR-UNIT-PRICE-X REDEFINES IN-NSTR-UNIT-PRICE-9
009900                                   PIC X(12).
010000     05  IN-NSTR-ITM-SUB           PIC X(3).
010100     05  IN-NSTR-SUB-DETL          PIC X(4).
010200     05  IN-NSTR-ADDL-DATA         PIC X(8).
010300     05  IN-NSTR-CORP-CODE         PIC X(8).
010400     05  IN-NSTR-REQ-NO            PIC X(10).
010500     05  IN-NSTR-CONTAINER-INDIC   PIC X.
010600     05  FILLER                    PIC X(54).
010700
010800 01  DATA-ITEM-BUFFER.
010900     05  IN-DATA-ITM-NUMBER        PIC X(4).
011000     05  IN-DATA-ITM-NUMBER-9 REDEFINES IN-DATA-ITM-NUMBER
011100                                   PIC 9(4).
011200     05  IN-DATA-LINE-NUMBER       PIC X(2).
011300     05  IN-DATA-LINE-NUMBER-9 REDEFINES IN-DATA-LINE-NUMBER
011400                                   PIC 9(2).
011500     05  IN-ABSTFILE-DESC.
011600         07  IN-PO-DATA-LINE           PIC X(62).
011700         07  IN-DATA-CONTAINER-INDIC   PIC X.
011800         07  IN-PROD-KEY               PIC X(20).
011900     05  IN-QUOTE-PO-DESC REDEFINES IN-ABSTFILE-DESC.
012000         07  IN-NC-ITEM-DESC       PIC X(80).
012100         07  FILLER                PIC X(3).
012200     05  FILLER                    PIC X(31).

      *******************************************************************
      **      K E L L Y   R E C O R D   L A Y O U T S                  **
      *******************************************************************
       01  K-STR-ITEM-BUFFER.
           05  KELLY-CORP-CODE           PIC X(7).
           05  K-ITM-NUM                 PIC X(4).
           05  K-ITM-QTY-ORD             PIC X(12).
           05  K-ITM-QTY-ORD-9 REDEFINES K-ITM-QTY-ORD
                                         PIC S9(8)V9(4).
           05  K-ITM-QTY-UM              PIC XX.
           05  K-ITM-PRICE-UM            PIC X(2).
           05  K-ITM-UNIT-PRICE          PIC X(12).
           05  K-ITM-UNIT-PRICE-9 REDEFINES K-ITM-UNIT-PRICE
                                         PIC S9(8)V9(4).
           05  K-ITM-SUB-DETAIL          PIC X(3).
           05  K-ITM-REQ-NO              PIC X(10).
           05  K-STORES-QTY              PIC S9(8).
           05  K-STORES-UM               PIC X(2).
           05  FILLER                    PIC X(58).
      **************************************************************
      **************************************************************
      **                                                          **
      **                DATABASE I/O BUFFER AREA                  **
      **                                                          **
      **************************************************************
      **************************************************************

       COPY MSTORERM   IN COPYLIB.
       COPY MPLT0      IN COPYLIB.
       COPY MPLTP01   IN COPYLIB.
       01  BUF-USAGEFIL.
           05  FILLER                    PIC XX.
           05  K-CORP-CODE.
               10  K-CORP-CODE-1-2       PIC X(2).
               10  FILLER                PIC X(6).
           05  K-MONTHS                 OCCURS 14 TIMES.
               10  K-MTH-USAGE           PIC S9(9) COMP-4.
           05  K-MONTHS-DD              OCCURS 14 TIMES.
               10  K-MTH-USAGE-DD        PIC S9(9) COMP-4.

       01  DSET-NAMES.
           05  DSET-NAME                 PIC X(16)  VALUE SPACES.
           05  DSET-MSTORERM             PIC X(16)  VALUE "MSTORERM;".
           05  DSET-MPLTINFO             PIC X(16)  VALUE "MPLTINFO;".

       COPY DATAB IN COPYLIB.
       01  FILE-STATUS.
           05  FILE-STATUS-1             PIC X  VALUE "0".
           05  FILE-STATUS-2             PIC X  VALUE "0".

       01 ITEMS-LISTING.
           05  ALL-ITEMS                 PIC XX    VALUE "@;".
           05  CODE-SEARCH               PIC X(10) VALUE "CORP-CODE;".

       01 ARG-VALUES.
           05  CODE-ARG                  PIC X(8)  VALUE SPACES.
           05  PLT-ARG                   PIC X(4)  VALUE SPACES.
           05  REQ-ARG                   PIC X(12) VALUE SPACES.
           05  BUYER-ARG                 PIC X(4)  VALUE SPACES.

       PROCEDURE DIVISION.

       1000-HKEEP SECTION 01.
       1000-HOUSEKEEPING.
           ACCEPT HOLD-DATE FROM DATE.
           MOVE "Y"                      TO  HANDLE-BLOWUP-FLAG.
           PERFORM 9999-OPENS.
           OPEN INPUT INPUT-PO-FILE.

           MOVE "P 01"                   TO  PLT-ARG.
           PERFORM 9999-GETKEY-MPLTINFO-PK-I.

           MOVE MPLTINFO-COMPANY         TO  COMPANY-SAVE.

           PERFORM 6000-MAIN THRU 6990-MAIN-X.

       2000-EOJ.
           CLOSE INPUT-PO-FILE.
           PERFORM 9999-CLOSES.
           GOBACK.

       2100-BLOWUP.
           MOVE "TPOADDCD"               TO  BU-PGM-NAME.
           CALL "TBLOWUP" USING BASE, BU-PGM-NAME, STATUS-AREA,
             DUMMY-VIEW-AREA, FILE-STATUS, BU-DISPLAY-MSG,
             BU-DISPLAY-FLDS.

       6000-MAIN.
       6010-READ-RECORD.
           READ INPUT-PO-FILE AT END
               GO TO 6990-MAIN-X.

      *****************************************************************
      **                                                             **
      **           C O N T R O L   S E C T I O N                     **
      **                                                             **
      *****************************************************************
       6030-CHECK-TRANS.
           IF PO-TRANS = "3"
               PERFORM 7010-MOVE-PO-ITEM-RECORD
               PERFORM 7000-ADD-CORP-CODE THRU 7090-ACC-X
           ELSE
               GO TO 6010-READ-RECORD.

           GO TO 6010-READ-RECORD.
       6990-MAIN-X.
           EXIT.

       7000-ADD-CORP-CODE.
           MOVE SPACES                   TO  BUF-MSTORERM.
           MOVE "MSTORERM;"              TO  DSET-NAME.
           PERFORM 9999-DSET-LOCK.
           MOVE IN-CORP-CODE             TO  CODE-ARG.
           PERFORM 9999-GETKEY-MSTORERM-CD-O.
           IF GOOD-CALL
               DISPLAY "CODE ", CODE-ARG, " ALREADY EXISTS"
               PERFORM 7100-MOVE-STUFF
               PERFORM 9999-UPDATE-MSTORERM-CD-O
               PERFORM 9999-GETKEY-USAGEFIL-CD-O
               IF NOT GOOD-CALL
                   PERFORM 7200-MOVE-USAGE
                   PERFORM 9999-PUT-USAGEFIL-CD-O
               END-IF
           ELSE
               PERFORM 7100-MOVE-STUFF
               DISPLAY "ADDING CODE ", CODE-ARG
               PERFORM 9999-PUT-MSTORERM-CD-O
               PERFORM 7200-MOVE-USAGE
               PERFORM 9999-PUT-USAGEFIL-CD-O.

           PERFORM 9999-UNLOCK.

       7090-ACC-X.
           EXIT.

       7100-MOVE-STUFF.
           MOVE IN-CORP-CODE             TO  CORP-CODE.
           MOVE IN-ITM-QTY-UM            TO  STR-UM.
           IF IN-ITM-PRICE-UM NOT = IN-ITM-QTY-UM
                MOVE IN-ITM-PRICE-UM     TO  STR-UM1
                MOVE 2                   TO  STR-UM1-CF
           ELSE
                MOVE ZERO                TO  STR-UM1-CF.
           MOVE ZERO                     TO  STR-UM2-CF.
           MOVE IN-ITM-UNIT-PRICE-9      TO  STR-MKT-COST.
           ADD 1                         TO  STR-MKT-COST.
           MOVE "111"                    TO  STR-CLASS.
           MOVE "1111"                   TO  STR-DIR-CHRG-DEPT.
           MOVE HOLD-DATE TO STR-INIT-DATE, STR-ACT-DATE.
           IF HOLD-YY > "70"
              MOVE "19" TO STR-INIT-DATE-CC
                           STR-ACT-DATE-CC
           ELSE
              MOVE "20" TO STR-INIT-DATE-CC
                           STR-ACT-DATE-CC.
           MOVE "AUTOLOADPO"             TO  STR-AUTHOR.
           MOVE 10                       TO  STR-EOQ.
           MOVE 20                       TO  STR-MAX.
           MOVE 10                       TO  STR-REORDER.
           MOVE 5                        TO  STR-EXPEDITE.
           MOVE IN-ITM-UNIT-PRICE-9      TO  STR-STD-COST.
           MOVE IN-ITM-UNIT-PRICE-9      TO  STR-AVG-COST.
           MOVE IN-ITM-UNIT-PRICE-9      TO  STR-PREV-AVG.
           MOVE 1                        TO  STR-EST-LT.
           MOVE 100                      TO  STR-PHY-INV-CYL-9.
           MOVE ZERO                     TO  STR-LAST-DLVTIMES (1).
           MOVE ZERO                     TO  STR-LAST-DLVTIMES (2).
           MOVE ZERO                     TO  STR-LAST-DLVTIMES (3).
           MOVE IN-ITM-UNIT-PRICE-9      TO  STR-OUT-REPAIR-COST.
           MOVE 100                      TO  STR-MAINT-REPAIR-COST.
           MOVE 20                       TO  STR-MTH-FCST.
           MOVE 60                       TO  STR-ONHAND.
           MOVE ZERO                     TO  STR-ONORDER.
           MOVE ZERO                     TO  STR-RESERVED.
           MOVE ZERO                     TO  STR-RSRV-ONORD.
           MOVE "LOC1"                   TO  STR-LOC (1).
           MOVE "LOC2"                   TO  STR-LOC (2).
           MOVE 40                       TO  STR-LOC-ONHAND (1).
           MOVE 20                       TO  STR-LOC-ONHAND (2).
           MOVE ZERO                     TO  STR-LOC-ONHAND (3).
           MOVE ZERO                     TO  STR-LOC-ONHAND (4).
           MOVE ZERO                     TO  STR-LOC-ONHAND (5).
           MOVE ZERO                     TO  STR-LOC-ONHAND (6).
           MOVE 1                        TO  STR-TAX-PERCENT.
           MOVE STR-EOQ                  TO  STR-SOQ.

       7200-MOVE-USAGE.
           MOVE CODE-ARG                 TO  K-CORP-CODE.
           PERFORM VARYING SUB FROM 1 BY 1 UNTIL SUB > 14
               MOVE ZERO                 TO  K-MTH-USAGE (SUB)
                                             K-MTH-USAGE-DD(SUB)
           END-PERFORM.

      *****************************************************************
      **         M O V E   D A T A                                   **
      *****************************************************************
       7010-MOVE-PO-ITEM-RECORD.
           IF KELLY-PLANT
               MOVE PO-REC               TO  K-STR-ITEM-BUFFER
               MOVE KELLY-CORP-CODE      TO  IN-CORP-CODE
               MOVE K-ITM-NUM            TO  IN-ITM-NUM
      *------- MOVE THE QTYS IN STR UM FOR KELLY, BUT PRICES
      *------- STAY IN ORDERED UM
               MOVE K-STORES-QTY         TO  FORMAT-QTY
               MOVE FORMAT-QTY           TO  IN-ITM-QTY-ORD-9
               MOVE K-STORES-UM          TO  IN-ITM-QTY-UM
               MOVE K-ITM-PRICE-UM       TO  IN-ITM-PRICE-UM
               MOVE K-ITM-UNIT-PRICE     TO  IN-ITM-UNIT-PRICE-X
               MOVE K-ITM-SUB-DETAIL     TO  IN-ITM-SUB-DETAIL
               MOVE SPACES               TO  IN-ITM-ADDL-DATA
               MOVE SPACES               TO  IN-ITM-CONTAINER-INDIC
           ELSE
               MOVE PO-REC               TO  STR-ITEM-BUFFER.

       9999-OPENS.
           OPEN INPUT MPLTINFO-PK-I.
           OPEN I-O USAGEFIL-CD-O.
           OPEN I-O MSTORERM-CD-O.

       9999-CLOSES.
           CLOSE MPLTINFO-PK-I, MSTORERM-CD-O, USAGEFIL-CD-O.

       COPY DLOCKCAL IN COPYLIB.
       COPY UNLOCK   IN COPYLIB.

       9999-GETKEY-MPLTINFO-PK-I.
           MOVE 0 TO COND-WORD.
           MOVE PLT-ARG TO PLTINFOKEY OF MPLTINFO-PK-REC-I.
           READ MPLTINFO-PK-I INTO BUF-MPLTINFO
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS = "23"
               MOVE 17 TO COND-WORD
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD
               IF HANDLE-BLOWUP-FLAG = "Y"
                   MOVE "GETKEY ERR 9999-GETKEY-MPLTINFO-PK-I"
                       TO BU-MSG-AREA
                   PERFORM 2100-BLOWUP.

       9999-GETKEY-MSTORERM-CD-O.
           MOVE 0 TO COND-WORD.
           MOVE CODE-ARG TO CORPCDE OF MSTORERM-CD-REC-O.
           READ MSTORERM-CD-O INTO BUF-MSTORERM
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS = "23"
               MOVE 17 TO COND-WORD
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD
               IF HANDLE-BLOWUP-FLAG = "Y"
                   MOVE "GETKEY ERR 9999-GETKEY-MSTORERM-CD-O"
                       TO BU-MSG-AREA
                   PERFORM 2100-BLOWUP.

       9999-RESET-MSTORERM-CD-O.
           MOVE HIGH-VALUES TO CORPCDE OF MSTORERM-CD-REC-O.
           START MSTORERM-CD-O KEY > CORPCDE OF MSTORERM-CD-REC-O
               INVALID KEY MOVE "00" TO FILE-STATUS.

       9999-PUT-MSTORERM-CD-O.
           MOVE 0 TO COND-WORD.
           WRITE MSTORERM-CD-REC-O FROM BUF-MSTORERM
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD
               IF HANDLE-BLOWUP-FLAG = "Y"
                   MOVE "PUT ERR 9999-PUT-MSTORERM-CD-O"
                       TO BU-MSG-AREA
                   PERFORM 2100-BLOWUP.

       9999-UPDATE-MSTORERM-CD-O.
           MOVE 0 TO COND-WORD.
           REWRITE MSTORERM-CD-REC-O FROM BUF-MSTORERM
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD
               IF HANDLE-BLOWUP-FLAG = "Y"
                   MOVE "UPDATE ERR 9999-UPDATE-MSTORERM-CD-O"
                       TO BU-MSG-AREA
                   PERFORM 2100-BLOWUP.

       9999-PUT-USAGEFIL-CD-O.
           MOVE 0 TO COND-WORD.
           WRITE USAGEFIL-CD-REC-O FROM BUF-USAGEFIL
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD
               IF HANDLE-BLOWUP-FLAG = "Y"
                   MOVE "PUT ERR 9999-PUT-USAGEFIL-CD-O"
                       TO BU-MSG-AREA
                   PERFORM 2100-BLOWUP.

       9999-GETKEY-USAGEFIL-CD-O.
           MOVE 0 TO COND-WORD.
           MOVE CODE-ARG TO CORPCDE OF USAGEFIL-CD-REC-O.
           READ USAGEFIL-CD-O INTO BUF-USAGEFIL
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS = "23"
               MOVE 17 TO COND-WORD
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD.

