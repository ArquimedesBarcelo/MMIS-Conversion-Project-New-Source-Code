       IDENTIFICATION DIVISION.
       PROGRAM-ID.    TPOADDCD.
       AUTHOR.        C.I.HILLES/JIM COFFMAN (MAINTAINER).
       DATE-COMPILED.
      ***------------------------------------------------------------***
      ***  >>>>>>>>>>  P O R T A B L E    P R O G R A M  <<<<<<<<<<  ***
      ***------------------------------------------------------------***
      *C
      *C 09/11/96  JEFF BUNGO
      *C  EXPAND DATE FIELDS FOR YEAR 2000 COMPLIANCE.
      *C  INCLUDE CENTURY ON INIT AND ACT DATE OF MSTORERM.
      *C
      *C  11/25/97    JEFF BUNGO   REQ #97-017
      *C     ADD USAGE FIELDS FOR DIRECT DELIVERY.  DD USAGE
      *C     TO BE STORED IN ADDITIONAL FIELD AND TOTAL USAGE.
      *C     STORE ISSUE USAGE CALCULATED BY TOTAL USAGE - DD USAGE.
      *C
       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.
       COPY SPECIALN IN COPYLIB.
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT INPUT-PO-FILE
               ASSIGN TO DISK-AKPOFILE.

           SELECT MPLTINFO-PK-I
               ASSIGN TO DATABASE-MCFLCS0501
               ORGANIZATION IS INDEXED
                 ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
               FILE STATUS IS FILE-STATUS.

           SELECT MSTORERM-CD-O
               ASSIGN TO DATABASE-MCFLCS0201
               ORGANIZATION IS INDEXED
                 ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
               FILE STATUS IS FILE-STATUS.

           SELECT USAGEFIL-CD-O
               ASSIGN TO DATABASE-MCFLCSUSAG
               ORGANIZATION IS INDEXED
                 ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
               FILE STATUS IS FILE-STATUS.
       DATA DIVISION.
       FILE SECTION.

      *------ FD STATEMENT AREA FOR IBM ONLY ------*
       FD  MSTORERM-CD-O
           LABEL RECORDS ARE STANDARD.
       01  MSTORERM-CD-REC-O.
           COPY DDS-MCRPCS0200  OF MCFLCS0201.

       FD  USAGEFIL-CD-O
           LABEL RECORDS ARE STANDARD.
       01  USAGEFIL-CD-REC-O.
           COPY DDS-MCRPCSUSAG  OF MCFLCSUSAG.

       FD  MPLTINFO-PK-I
           LABEL RECORDS ARE STANDARD.
       01  MPLTINFO-PK-REC-I.
           COPY DDS-MCRPCS0500  OF MCFLCS0501.
      *------ FD STATEMENT AREA FOR IBM ONLY ------*

001000*****************************************************
001100*  INPUT FILE FOR TLOADPO.SOURCE (ABSTFILE LAYOUT)  *
001110* PO-REC IS MOVED TO ANOTHER AREA BASED ON PO-TRANS *
001120* IF PO-DEL-FLAG = 'D' AND                          *
001130*    PO-TRANS=1  -  DELETE PO HEADER                *
001140*    PO-TRANS=3  -  DELETE CODED ITEM               *
001150*    PO-TRANS=4  -  DELETE NONCODED ITEM            *
001160*    PO-TRANS=5  -  DELETE DESCRIPTION              *
001170*                                                   *
001180* IF PO-DEL-FLANG = ' ' AND                         *
001190*    PO-TRANS=1  -  ADD PO HEADER                   *
001191*    PO-TRANS=2  -  ADD VENDOR RECORD               *
001192*    PO-TRANS=3  -  ADD CODED ITEM                  *
001193*    PO-TRANS=4  -  ADD NONCODED ITEM               *
001194*    PO-TRANS=5  -  ADD DESCRIPTION                 *
001195*    PO-TRANS=6,7,8 ARE IGNORED                     *
001196*    ALL OTHERS ARE INVALID                         *
001200*****************************************************
001300 FD  INPUT-PO-FILE
001400     LABEL RECORDS ARE OMITTED
001500     RECORD CONTAINS 133 CHARACTERS
001600     DATA RECORD IS INPUT-PO-REC.
001700 01  INPUT-PO-REC.
001800     05  FILLER                         PIC X.
001900     05  PO-TRANS                       PIC X.
002000     05  PO-DEL-FLAG                    PIC X.
002100     05  PO-INPUT-NUM.
002200         10  PO-NUM-1-7                 PIC X(7).
002300         10  PO-RLSE-8-10               PIC X(3).
002400     05  PO-REC                         PIC X(120).

       WORKING-STORAGE SECTION.
       COPY TBLOWUP IN COPYLIB.
       01  SUB                           PIC S9(4) BINARY.
       01  FORMAT-QTY                    PIC S9(8)V9(4).
       01  COMPANY-SAVE                  PIC X(3).
       01  CO-SAVE-2 REDEFINES COMPANY-SAVE.
           05  COMPANY-SAVE-1            PIC X(1).
               88  KELLY-PLANT                     VALUE "2".
           05  FILLER                    PIC X(2).
       01  CO-SAVE-3 REDEFINES COMPANY-SAVE.
           05  COMPANY-SAVE-1-2          PIC X(2).
               88  AKRON-PLANT                     VALUE "11".
           05  FILLER                    PIC X(1).

       01  HANDLE-BLOWUP-FLAG            PIC X(1)  VALUE "Y".
       01  HOLD-DATE.
           05  HOLD-YY                   PIC X(2).
           05  FILLER                    PIC X(4).

001000*****************************************************************
001100**                                                             **
001200**     I N P U T   R E C O R D   F I L E   -   T L O A D P O   **
001300**                                                             **
001400*****************************************************************
