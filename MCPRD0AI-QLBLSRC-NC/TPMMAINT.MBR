       IDENTIFICATION DIVISION.
       PROGRAM-ID.             TPMMAINT.
       AUTHOR.                 W. ROXBURY.
       INSTALLATION.           GOODYEAR TIRE & RUBBER CO.
      *REMARKS.                THIS IS THE MAIN MENU FOR THE
      *                        PREVENTIVE MAINTENANCE SYSTEM
      *                        ****.
       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.
       SOURCE-COMPUTER.        IBM-AS400.
       OBJECT-COMPUTER.        IBM-AS400.

       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT WO-MESSAGE-CC
                  ASSIGN       TO DATABASE-MCFLMM2402
                  ORGANIZATION IS INDEXED
                  ACCESS MODE  IS DYNAMIC
                  RECORD KEY   IS EXTERNALLY-DESCRIBED-KEY
                               WITH DUPLICATES
                  FILE STATUS  IS FILE-STAT.

           SELECT WO-LAST-NUM-USED
                  ASSIGN       TO DATABASE-MCFPMM0800
                  ORGANIZATION IS RELATIVE
                  ACCESS MODE  IS RANDOM
                  RELATIVE KEY IS ARG-NO
                  FILE STATUS  IS FILE-STAT.

           SELECT PER-PERSONNEL
                  ASSIGN       TO DATABASE-MCFLMM0301
                  ORGANIZATION IS INDEXED
                  ACCESS MODE  IS DYNAMIC
                  RECORD KEY   IS EXTERNALLY-DESCRIBED-KEY
                  FILE STATUS  IS FILE-STAT.

           SELECT DISPLAY-FILE
                  ASSIGN       TO WORKSTATION-ZPMMAINT-SI
                  ORGANIZATION IS TRANSACTION
                  ACCESS MODE  IS SEQUENTIAL
                  FILE STATUS  IS SCREEN-STATUS
                               MAJOR-MINOR
                  CONTROL-AREA IS SCREEN-CONTROL.

       DATA DIVISION.
       FILE SECTION.
       FD  WO-MESSAGE-CC
           LABEL RECORDS ARE STANDARD.
       01  MCC-REC.
           COPY DDS-ALL-FORMATS OF MCFLMM2402.

       FD  WO-LAST-NUM-USED
           LABEL RECORDS       ARE STANDARD.
       01  WO-LAST-NUM-USED-REC.
           COPY DDS-ALL-FORMATS OF MCFPMM0800.

       FD  PER-PERSONNEL
           LABEL RECORDS       ARE STANDARD.
       01  PERS-REC.
           COPY DDS-ALL-FORMATS OF MCFLMM0301.

       FD  DISPLAY-FILE
           LABEL RECORDS       ARE OMITTED.
       01  DISPLAY-REC         PIC X(2000).

       WORKING-STORAGE SECTION.
       77  ARG-NO              PIC 9(9).
       77  HELP-SW             PIC 9(04)  VALUE 1.
       77  PLANT-CODE          PIC X(03).
       77  ERROR-BUFFER        PIC X(76).
       77  TRUE-VAL            PIC 1      VALUE B"1".

       01  PASSWORD-INFORMATION.
           05  NAME-OF-PROGRAM PIC X(08) VALUE "TPMMAINT".
           05  PROGRAM-TYPE    PIC X(02) VALUE "MA".
           05  PROGRAM-RELEASE PIC X(12) VALUE " J0100010001".
           05  PROGRAM-DESCRIPTION.
               10  PROG-DESC1  PIC X(30) VALUE
                   "MASTER PROGRAM FOR THE PREVENT".
               10  PROG-DESC2  PIC X(30) VALUE
                   "IVE MAINTENANCE SYSTEM.       ".
               10  PROG-DESC3  PIC X(30) VALUE
                   "                              ".
               10  PROG-DESC4  PIC X(30) VALUE
                   "                              ".
               10  PROG-FUNC1  PIC X(30) VALUE
                   "                              ".
               10  PROG-FUNC2  PIC X(30) VALUE
                   "                              ".
           05  PASSWORD-FLAG   PIC X.

       01  FILE-STAT.
           05  FILE-STAT-1     PIC X  VALUE "0".
           05  FILE-STAT-2     PIC X  VALUE "0".

       01  SCREEN-DATA.
           05  CC-MAIL         PIC X(04).
           05  SCRN-MSG.
               10  MSG-ONE     PIC X(17).
               10  MSG-TWO     PIC X(17).
           05  CC-USER         PIC X(16).
           05  CMDMSG          PIC X(79).
           05  ERRMSG          PIC X(79).

       01  SAVE-DATA.
           05  CC-SAVE         PIC X(04).
           05  MSG-SAVE.
               10  MSGSONE     PIC X(17).
               10  MSGSTWO     PIC X(17).

       01  ERROR-SWITCH.
           05  ERR-SW          PIC S9(4) COMP-4.

       01  CNUM-BUFFER.
           05  CNUM-BUF        PIC X(04).
           05  CNAM-BUF        PIC X(16).

       01  MSG-AREA.
           05  CNUM-MSG        PIC X(04).
           05  WONUM-MSG       PIC X(10).
           05  MESSAGE-BUF     PIC X(76).

       01  PERS-DATA.
           05  PER-CC          PIC XXXX.
           05  PER-ZONE        PIC XXXX.
           05  PER-SKILL       PIC XX.

       01  DB-ERROR.
           05  DB-TYPE         PIC X(08) VALUE SPACES.
           05  FILLER          PIC X(21) VALUE " ERROR - FILE-STAT = ".
           05  CON-WORD        PIC -9999.

       01  INIT-SIM-FLAG       PIC X(01).
           88  INITIATOR       VALUE "I".
           88  SIMULATOR       VALUE "S".

           COPY CATREAD        IN COPYLIB.

           COPY SCREENIO       IN COPYLIB.

           COPY VCOMAREA       IN COPYLIB.

           COPY LANGSUB        IN COPYLIB.

       01  DBPARAMETERS.
           COPY DBPARMS        IN COPYLIB.

           COPY ERRORLIN       IN COPYLIB.

       01  WO-PLANNED-DATA.
           COPY DWOPLAN        IN COPYLIB.

       01  WO-PERS-DATA.
           COPY MPERSONL       IN COPYLIB.

       01  LAST-WO-USED-DATA.
           COPY MLASTWO        IN COPYLIB.

       01  MESSAGE-DATA-BUFF.
           COPY DWOMSG         IN COPYLIB.

       PROCEDURE DIVISION.
       BEGIN.
           PERFORM 1-HSK       THRU HSK-EXIT.
           GO TO 6-MAIN.

       2-EOJ.
           CLOSE               DISPLAY-FILE
                               WO-MESSAGE-CC
                               PER-PERSONNEL.
           GOBACK.

       1-HSK.
           MOVE SPACES         TO DBPARAMETERS SCREEN-DATA.
           OPEN I-O            DISPLAY-FILE.
           OPEN INPUT          WO-MESSAGE-CC
                               PER-PERSONNEL
                               WO-LAST-NUM-USED.

           MOVE SPACES         TO LAST-WO-USED-DATA.
           MOVE 1              TO DATE-FLAG-SW ARG-NO.
           READ WO-LAST-NUM-USED INTO LAST-WO-USED-DATA
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           MOVE PLANT-IDENT    TO PLANT-CODE.
           MOVE DATE-FLAG-SW   TO DATE-FLAG.
           CLOSE               WO-LAST-NUM-USED.

       HSK-SHOWFORM.
           MOVE "MENU_EXEC1"   TO SCREEN-NAME.
           MOVE "00"           TO SCREEN-STATUS.
           MOVE SCREEN-DATA    TO DISPLAY-REC.

           WRITE DISPLAY-REC   FORMAT IS SCREEN-NAME
                               INDIC ARE SCREEN-INDICATORS.
           IF SCREEN-STATUS NOT = "00"
               DISPLAY "SCREEN WRITE ERROR.  SCREEN-STATUS IS "
                               SCREEN-STATUS
               GO TO 2-EOJ.

           READ  DISPLAY-FILE  FORMAT IS SCREEN-NAME
                               INDIC ARE SCREEN-INDICATORS.
           IF SCREEN-STATUS NOT = "00"
               DISPLAY "SCREEN READ ERROR.  SCREEN-STATUS IS "
                               SCREEN-STATUS
               GO TO 2-EOJ.

           MOVE DISPLAY-REC    TO SCREEN-DATA.
           MOVE ALL B"0"       TO SCREEN-INDICATORS.

           IF KEY-HIT = 3 OR 8
               GO TO 2-EOJ.

           IF CC-MAIL = "NEWS"
               CALL "TBBNEWS"  USING  DBPARAMETERS
                               PERS-DATA
               MOVE PER-CC     TO CC-MAIL
               GO TO HSK-CONTINUE.

           IF CC-MAIL = "    "
      **********************************************************************
      **    MESSAGE 035/047:
      ** INVALID CLOCK CARD NUMBER
      **********************************************************************
               MOVE  35        TO CATREAD-MSG-SET
               MOVE  47        TO CATREAD-MSG-NUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               PERFORM 999-ERROR
               GO TO HSK-SHOWFORM.

           IF CC-MAIL = "9999"
      **********************************************************************
      **    MESSAGE 035/047:
      ** INVALID CLOCK CARD NUMBER
      **********************************************************************
               MOVE  35        TO CATREAD-MSG-SET
               MOVE  47        TO CATREAD-MSG-NUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               PERFORM 999-ERROR
               GO TO HSK-SHOWFORM.

       HSK-CONTINUE.
           MOVE CC-MAIL        TO PERCCNUM OF PER-PERSONNEL.
           READ PER-PERSONNEL  INTO WO-PERS-DATA
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
      **********************************************************************
      **    MESSAGE 035/047:
      ** INVALID CLOCK CARD NUMBER
      **********************************************************************
               MOVE  35        TO CATREAD-MSG-SET
               MOVE  47        TO CATREAD-MSG-NUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               PERFORM 999-ERROR
               GO TO HSK-SHOWFORM.

           MOVE CC-MAIL        TO CC-SAVE.
           MOVE PER-EMP-NAME   TO CC-USER.

       HSK-EXIT.               EXIT.

       6-MAIN.
           MOVE "MENU_EXEC2"   TO SCREEN-NAME.
           MOVE 5              TO HELP-SW.
           PERFORM CHECK-FOR-MAIL THRU CFM-EXIT.
           MOVE "00"           TO SCREEN-STATUS.
           MOVE SCREEN-DATA    TO DISPLAY-REC.

           WRITE DISPLAY-REC   FORMAT IS SCREEN-NAME
                               INDIC ARE SCREEN-INDICATORS.
           IF SCREEN-STATUS NOT = "00"
               DISPLAY "SCREEN WRITE ERROR.  SCREEN-STATUS IS "
                               SCREEN-STATUS
               GO TO 2-EOJ.

           READ  DISPLAY-FILE  FORMAT IS SCREEN-NAME
                               INDIC ARE SCREEN-INDICATORS.
           IF SCREEN-STATUS NOT = "00"
               DISPLAY "SCREEN READ ERROR.  SCREEN-STATUS IS "
                               SCREEN-STATUS
               GO TO 2-EOJ.

           MOVE DISPLAY-REC    TO SCREEN-DATA.
           MOVE ALL B"0"       TO SCREEN-INDICATORS.

           IF KEY-HIT = 3 OR 8
               GO TO 2-EOJ.

      ****************************************************************
           IF KEY-HIT = 1
               GO TO 7-MAIN
           ELSE
      ****************************************************************
           IF KEY-HIT = 2
               CALL "SPMLEVEL" USING DBPARAMETERS
                               WO-PERS-DATA
               GO TO 6-MAIN
           ELSE
      ****************************************************************
           IF KEY-HIT = 4
               MOVE "I"        TO INIT-SIM-FLAG
               CALL "SPMSINIT" USING DBPARAMETERS
                               VIEW-COMAREA
                               LANGUAGE-PARMS
                               INIT-SIM-FLAG
               GO TO 6-MAIN
           ELSE
      ****************************************************************
           IF KEY-HIT = 5
               CALL "SPMSMREL" USING DBPARAMETERS
                               VIEW-COMAREA
                               LANGUAGE-PARMS
               GO TO 6-MAIN
           ELSE
      ****************************************************************
           IF KEY-HIT = 6
               GO TO 8-MAIN
           ELSE
      ****************************************************************
           IF KEY-HIT = 7
               CALL "SPMHELPM" USING HELP-SW
               GO TO 6-MAIN.

           MOVE CC-SAVE        TO CNUM-BUF.
           MOVE PER-EMP-NAME   TO CNAM-BUF CC-USER.
           CALL "TDISPMES"     USING DBPARAMETERS
                               MSG-AREA.
           GO TO 6-MAIN.

       7-MAIN.
           MOVE "MENU_MSTR"    TO SCREEN-NAME.
           MOVE 7              TO HELP-SW.
           PERFORM CHECK-FOR-MAIL THRU CFM-EXIT.

       7-SHOWFORM.
           MOVE "00"           TO SCREEN-STATUS.
           MOVE SCREEN-DATA    TO DISPLAY-REC.

           WRITE DISPLAY-REC   FORMAT IS SCREEN-NAME
                               INDIC ARE SCREEN-INDICATORS.
           IF SCREEN-STATUS NOT = "00"
               DISPLAY "SCREEN WRITE ERROR.  SCREEN-STATUS IS "
                               SCREEN-STATUS
               GO TO 2-EOJ.

           READ  DISPLAY-FILE  FORMAT IS SCREEN-NAME
                               INDIC ARE SCREEN-INDICATORS.
           IF SCREEN-STATUS NOT = "00"
               DISPLAY "SCREEN READ ERROR.  SCREEN-STATUS IS "
                               SCREEN-STATUS
               GO TO 2-EOJ.

           MOVE DISPLAY-REC    TO SCREEN-DATA.
           MOVE ALL B"0"       TO SCREEN-INDICATORS.

           IF KEY-HIT = 3 OR 8
               GO TO 6-MAIN.

      ****************************************************************
           IF KEY-HIT = 1
               CALL "SPMMASTJ" USING PLANT-CODE
                               WO-PERS-DATA
                               DBPARAMETERS
                               VIEW-COMAREA
                               LANGUAGE-PARMS
               GO TO 7-MAIN
           ELSE
      ****************************************************************
           IF KEY-HIT = 2
               CALL "SPMWOGEN" USING DBPARAMETERS
                               VIEW-COMAREA
                               LANGUAGE-PARMS
               GO TO 7-MAIN
           ELSE
      ****************************************************************
           IF KEY-HIT = 4
               CALL "SPMWOMOD" USING DBPARAMETERS
                               VIEW-COMAREA
                               LANGUAGE-PARMS
               GO TO 7-MAIN
           ELSE
      ****************************************************************
           IF KEY-HIT = 5
               CALL "TDISPEXS" USING DBPARAMETERS
                               LAST-WO-USED-DATA
                               ERROR-SWITCH
                               VIEW-COMAREA
               GO TO 7-MAIN
           ELSE
      ****************************************************************
           IF KEY-HIT = 6
               CALL "SPMWOINQ" USING DBPARAMETERS
               GO TO 7-MAIN
           ELSE
      ****************************************************************
           IF KEY-HIT = 7
               CALL "SPMHELPM" USING HELP-SW
               GO TO 7-MAIN.

           MOVE CC-SAVE        TO CNUM-BUF.
           MOVE PER-EMP-NAME   TO CNAM-BUF CC-USER.
           CALL "TDISPMES"     USING DBPARAMETERS
                               MSG-AREA.
           GO TO 7-MAIN.

       8-MAIN.
           MOVE "MENU_REP1"    TO SCREEN-NAME.
           MOVE 6              TO HELP-SW.
           PERFORM CHECK-FOR-MAIL THRU CFM-EXIT.

       8-SHOWFORM.
           MOVE "00"           TO SCREEN-STATUS.
           MOVE SCREEN-DATA    TO DISPLAY-REC.

           WRITE DISPLAY-REC   FORMAT IS SCREEN-NAME
                               INDIC ARE SCREEN-INDICATORS.
           IF SCREEN-STATUS NOT = "00"
               DISPLAY "SCREEN WRITE ERROR.  SCREEN-STATUS IS "
                               SCREEN-STATUS
               GO TO 2-EOJ.

           READ  DISPLAY-FILE  FORMAT IS SCREEN-NAME
                               INDIC ARE SCREEN-INDICATORS.
           IF SCREEN-STATUS NOT = "00"
               DISPLAY "SCREEN READ ERROR.  SCREEN-STATUS IS "
                               SCREEN-STATUS
               GO TO 2-EOJ.

           MOVE DISPLAY-REC    TO SCREEN-DATA.
           MOVE ALL B"0"       TO SCREEN-INDICATORS.

           IF KEY-HIT = 3 OR 8
               GO TO 6-MAIN.

      ****************************************************************
           IF KEY-HIT = 1
               CALL "SPMLISTQ" USING DBPARAMETERS
               GO TO 8-MAIN
           ELSE
      ****************************************************************
           IF KEY-HIT = 2
               CALL "SPMPRINT" USING DBPARAMETERS
                               VIEW-COMAREA
                               LANGUAGE-PARMS
               GO TO 8-MAIN
           ELSE
      ****************************************************************
           IF KEY-HIT = 4
               GO TO 81-MAIN
           ELSE
      ****************************************************************
           IF KEY-HIT = 5
               CALL "TMULTPRT" USING DBPARAMETERS
                               VIEW-COMAREA
                   GO TO 8-MAIN
           ELSE
      ****************************************************************
           IF KEY-HIT = 6
               GO TO 82-MAIN
           ELSE
      ****************************************************************
           IF KEY-HIT = 7
               CALL "SPMHELPM" USING HELP-SW
               GO TO 8-MAIN.

      ****************************************************************
           MOVE CC-SAVE        TO CNUM-BUF.
           MOVE PER-EMP-NAME   TO CNAM-BUF CC-USER.
           CALL "TDISPMES"     USING DBPARAMETERS
                               MSG-AREA.
           GO TO 8-MAIN.

       81-MAIN.
           MOVE "MENU_SIM"     TO SCREEN-NAME.
           MOVE 4              TO HELP-SW.
           PERFORM CHECK-FOR-MAIL THRU CFM-EXIT.

       81-SHOWFORM.
           MOVE "00"           TO SCREEN-STATUS.
           MOVE SCREEN-DATA    TO DISPLAY-REC.

           WRITE DISPLAY-REC   FORMAT IS SCREEN-NAME
                               INDIC ARE SCREEN-INDICATORS.
           IF SCREEN-STATUS NOT = "00"
               DISPLAY "SCREEN WRITE ERROR.  SCREEN-STATUS IS "
                               SCREEN-STATUS
               GO TO 2-EOJ.

           READ  DISPLAY-FILE  FORMAT IS SCREEN-NAME
                               INDIC ARE SCREEN-INDICATORS.
           IF SCREEN-STATUS NOT = "00"
               DISPLAY "SCREEN READ ERROR.  SCREEN-STATUS IS "
                               SCREEN-STATUS
               GO TO 2-EOJ.

           MOVE DISPLAY-REC    TO SCREEN-DATA.
           MOVE ALL B"0"       TO SCREEN-INDICATORS.

           IF KEY-HIT = 3 OR 8
               GO TO 8-MAIN.

      ****************************************************************
           IF KEY-HIT = 1
               MOVE "I"        TO INIT-SIM-FLAG
               CALL "SPMFRCST" USING DBPARAMETERS
                               VIEW-COMAREA
                               LANGUAGE-PARMS
                               INIT-SIM-FLAG
               GO TO 81-MAIN
           ELSE
      ****************************************************************
           IF KEY-HIT = 2
               CALL "SPMTRACK" USING DBPARAMETERS
               GO TO 81-MAIN
           ELSE
      ****************************************************************
           IF KEY-HIT = 4
               MOVE "S"        TO INIT-SIM-FLAG
               CALL "SPMSINIT" USING DBPARAMETERS
                               VIEW-COMAREA
                               LANGUAGE-PARMS
                               INIT-SIM-FLAG
               GO TO 81-MAIN
           ELSE
      ****************************************************************
           IF KEY-HIT = 5
               MOVE "S"        TO INIT-SIM-FLAG
               CALL "SPMFRCST" USING DBPARAMETERS
                               VIEW-COMAREA
                               LANGUAGE-PARMS
                               INIT-SIM-FLAG
               GO TO 81-MAIN
           ELSE
      ****************************************************************
           IF KEY-HIT = 6
               CALL "TRACKLIST"
               GO TO 81-MAIN
           ELSE
      ****************************************************************
           IF KEY-HIT = 7
               CALL "SPMHELPM" USING HELP-SW
               GO TO 81-MAIN.

      ****************************************************************
           MOVE CC-SAVE        TO CNUM-BUF.
           MOVE PER-EMP-NAME   TO CNAM-BUF CC-USER.
           CALL "TDISPMES"     USING DBPARAMETERS
                               MSG-AREA.
           GO TO 8-MAIN.

       82-MAIN.
           MOVE "MENU_REP2"    TO SCREEN-NAME.
           MOVE 8              TO HELP-SW.
           PERFORM CHECK-FOR-MAIL THRU CFM-EXIT.

       82-SHOWFORM.
           MOVE "00"           TO SCREEN-STATUS.
           MOVE SCREEN-DATA    TO DISPLAY-REC.

           WRITE DISPLAY-REC   FORMAT IS SCREEN-NAME
                               INDIC ARE SCREEN-INDICATORS.
           IF SCREEN-STATUS NOT = "00"
               DISPLAY "SCREEN WRITE ERROR.  SCREEN-STATUS IS "
                               SCREEN-STATUS
               GO TO 2-EOJ.

           READ  DISPLAY-FILE  FORMAT IS SCREEN-NAME
                               INDIC ARE SCREEN-INDICATORS.
           IF SCREEN-STATUS NOT = "00"
               DISPLAY "SCREEN READ ERROR.  SCREEN-STATUS IS "
                               SCREEN-STATUS
               GO TO 2-EOJ.

           MOVE DISPLAY-REC    TO SCREEN-DATA.
           MOVE ALL B"0"       TO SCREEN-INDICATORS.

           IF KEY-HIT = 3 OR 8
               GO TO 8-MAIN.

      ****************************************************************
           IF KEY-HIT = 1
               CALL "SPMJPINQ" USING VIEW-COMAREA
                               DBPARAMETERS
                               LANGUAGE-PARMS
               GO TO 82-MAIN
           ELSE
      ****************************************************************
           IF KEY-HIT = 2
               CALL "SPMSKINQ" USING DBPARAMETERS
               GO TO 82-MAIN
           ELSE
      ****************************************************************
           IF KEY-HIT = 4
               CALL "SPMINWOI" USING VIEW-COMAREA
                               DBPARAMETERS
                               LANGUAGE-PARMS
               GO TO 82-MAIN
           ELSE
      ****************************************************************
           IF KEY-HIT = 5
               MOVE CC-SAVE    TO CNUM-MSG CNUM-BUF
               MOVE PER-EMP-NAME TO CNAM-BUF
               CALL "TMSGEXEC" USING DBPARAMETERS
                               CNUM-BUFFER
                               PERS-DATA
               IF CNUM-BUF NOT = CC-SAVE
                   MOVE "  "   TO PERPASS-SW
               END-IF
               MOVE CNUM-BUF   TO CC-SAVE CNUM-MSG
               MOVE CNAM-BUF   TO CC-USER PER-EMP-NAME
               GO TO 82-MAIN
           ELSE
      ****************************************************************
           IF KEY-HIT = 6
               MOVE CC-SAVE    TO CNUM-BUF
               MOVE PER-EMP-NAME TO CNAM-BUF
               CALL "SPMSETUP" USING
                               CNUM-BUFFER
               MOVE CNUM-BUF   TO CC-SAVE CNUM-MSG
               MOVE CNAM-BUF   TO CC-USER PER-EMP-NAME
               GO TO 82-MAIN
           ELSE
      ****************************************************************
           IF KEY-HIT = 7
               CALL "SPMHELPM" USING HELP-SW
               GO TO 82-MAIN.

      ****************************************************************
           MOVE CC-SAVE        TO CNUM-BUF.
           MOVE PER-EMP-NAME   TO CNAM-BUF.
           CALL "TDISPMES"     USING DBPARAMETERS
                               MSG-AREA.
           GO TO 82-MAIN.

       CHECK-FOR-MAIL.
           MOVE SPACES         TO CC-MAIL MSG-SAVE.
           MOVE CC-SAVE        TO TOCC OF WO-MESSAGE-CC
                                  CNUM-MSG CNUM-BUF.
           START WO-MESSAGE-CC KEY = TOCC OF WO-MESSAGE-CC
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
               MOVE MSG-SAVE   TO SCRN-MSG
               GO TO CFM-EXIT.

       CHECK-MAIL-LOOP.
           READ WO-MESSAGE-CC  NEXT INTO MESSAGE-DATA-BUFF
               AT END          MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
               MOVE MSG-SAVE   TO SCRN-MSG
               GO TO CFM-EXIT.

           IF CC-SAVE NOT = TO-CC
               MOVE MSG-SAVE   TO SCRN-MSG
               GO TO CFM-EXIT.

           IF DEL-DATE NOT = SPACES
               GO TO CHECK-MAIL-LOOP.

           MOVE "MAIL"         TO CC-MAIL.
           MOVE "Press 'ENTER' key"
                               TO MSGSONE.
           MOVE "to receive mail. "
                               TO MSGSTWO.
           MOVE MSG-SAVE       TO SCRN-MSG.

       CFM-EXIT.               EXIT.

       999-CATREAD.
           MOVE SPACES         TO MESSAGE-BUFFER.
           CALL "CCATREAD"     USING CATREAD-PARMS.
           MOVE CATREAD-MSG-TEXT TO MESSAGE-BUFFER.

       999-CATREAD-EXIT.       EXIT.

       999-ERROR.
           MOVE MESSAGE-BUFFER TO ERRMSG.
           MOVE TRUE-VAL       TO IND(01) IND(99).

