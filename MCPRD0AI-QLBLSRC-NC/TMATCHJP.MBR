000200 IDENTIFICATION DIVISION.
000300 PROGRAM-ID.      TMATCHJP.
000400 ENVIRONMENT DIVISION.
000500 CONFIGURATION SECTION.
000600 SOURCE-COMPUTER. AS400.
000700 OBJECT-COMPUTER. AS400.
       COPY SPECIALN IN COPYLIB.
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT JOBPLAN-FILE
               ASSIGN TO DATABASE-MCFLMM1801
               ORGANIZATION IS INDEXED
               ACCESS IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY WITH DUPLICATES
               FILE STATUS IS JF-STATUS.
           SELECT PRINT-FILE
               ASSIGN TO PRINTER-MCPRT.
           SELECT WO-BASIC-FILE
               ASSIGN TO DATABASE-MCFLMM1001
               ORGANIZATION IS INDEXED
               ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
               FILE STATUS IS WBF-STATUS.
           SELECT WO-PLANNED-FILE
               ASSIGN TO DATABASE-MCFLMM1101
               ORGANIZATION IS INDEXED
               ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
               FILE STATUS IS WPF-STATUS.
000800 DATA DIVISION.
       FILE SECTION.
       FD  JOBPLAN-FILE
           LABEL RECORDS ARE STANDARD
           DATA RECORD IS JFREC.
       01  JFREC.
           COPY DDS-ALL-FORMATS OF MCFLMM1801.
       FD  PRINT-FILE
           RECORD CONTAINS 132 CHARACTERS
           DATA RECORD IS PRINTF.
       01  PRINTF                PIC X(132).
       FD  WO-BASIC-FILE
           LABEL RECORDS ARE STANDARD
           DATA RECORD IS WBFREC.
       01  WBFREC.
           COPY DDS-ALL-FORMATS OF MCFLMM1001.
       FD  WO-PLANNED-FILE
           LABEL RECORDS ARE STANDARD
           DATA RECORD IS WPFREC.
       01  WPFREC.
           COPY DDS-ALL-FORMATS OF MCFLMM1101.
000900 WORKING-STORAGE SECTION.
       77  LINE-CTR                  PIC 99 VALUE 60.
001000 77  SUB1                      PIC S9(4) COMP.
008300 01  ANSWER-SW                 PIC X  VALUE "N".
       01  CURRENT-TIME              PIC X(6).
001100 01  DEL-CTR                   PIC 9(7).
       01  DETAIL-LINE.
           05  DETAIL-DEF-1.
               10  D-JPSEQ-1         PIC X(14).
               10  D-LIT-1           PIC X(66).
           05  DETAIL-DEF-2 REDEFINES DETAIL-DEF-1.
               10  D-LIT-2A          PIC X(29).
               10  D-CTR-2           PIC Z(6)9.
               10  D-LIT-2B          PIC X(44).
           05  DETAIL-DEF-3 REDEFINES DETAIL-DEF-1.
               10  D-JPWOSEQ-3       PIC X(14).
               10  D-LIT-3           PIC X(66).
001200 01  DBPARAMETERS.     COPY DBPARMS IN COPYLIB.
       01  HEADER-1.
           05  FILLER                PIC X(13) VALUE "JOBPLAN SEQS".
           05  FILLER                PIC X(11) VALUE " WITH NO WO".
           05  FILLER                PIC X(10) VALUE " MATCH -  ".
           05  FILLER                PIC X(46) VALUE "AND DELETEABLE".
       01  HEADER-2.
           05  FILLER                PIC X(80) VALUE ALL "-".
       01  JF-STATUS                 PIC XX.
001400 01  JOBPLAN-BUFFER.   COPY DJOBPLAN IN COPYLIB.
       01  JOBPLAN-DELETE-TABLE.
           05  JPWO OCCURS 5000 TIMES  PIC X(10).
       01  JOBP-WO-SEQ.
           05  JOBP-WONUM            PIC X(10).
           05  FILLER                PIC X(4).
       COPY OVRPFDATA IN COPYLIB.
001500 01  RECDS-CTR-DW              PIC 9(7).
001600 01  RECDS-CTR-FF              PIC 9(7).
001700 01  RECORD-CTR-WA.
001800     05  RECDS-CTR             PIC 9(7).
001900     05  R-C-2 REDEFINES RECDS-CTR.
002000         10  R-C-FIRST-4       PIC 9999.
002100         10  R-C-LAST-3        PIC 999.
002200     05  R-C-3 REDEFINES RECDS-CTR.
002300         10  FILLER            PIC XX.
002400         10  R-C-LAST-5        PIC 99999.
002500 COPY DBSTAT  IN COPYLIB.
002600 01  STATUS-AREA2.
002700     05  COND-WORD2            PIC S9(4) COMP.
002800     05  FILLER                PIC X(22).
002900 01  TABLE-FFS.
003000     05  TABLE-WOS OCCURS 100.
003100         10  T-WO              PIC X(10).
003200         10  T-CTR             PIC 9(6).
       01  WBF-STATUS                PIC XX.
       01  WPF-STATUS                PIC XX.
003300 01  WO-PLANNED-DATA.  COPY DWOPLAN  IN COPYLIB.
003400 PROCEDURE DIVISION.
003500 START-PGM.
003600     PERFORM 1-HSK.
003700     PERFORM 6-MAIN.
003800 2-EOJ.
003900     CLOSE JOBPLAN-FILE.
           CLOSE PRINT-FILE.
           CLOSE WO-BASIC-FILE.
           CLOSE WO-PLANNED-FILE.
004000     GOBACK.
004100 1-HSK.
004200     MOVE LOW-VALUES TO STATUS-AREA STATUS-AREA2.
004300     MOVE SPACES TO TABLE-FFS.
004400     MOVE 0 TO RECDS-CTR DEL-CTR RECDS-CTR-DW
004500         RECDS-CTR-FF SUB1.
           OPEN I-O   JOBPLAN-FILE.
           OPEN INPUT WO-BASIC-FILE.
           OPEN INPUT WO-PLANNED-FILE.
           PERFORM 996-OVERRIDE-PRINT-FILE.
           OPEN OUTPUT PRINT-FILE.
           MOVE SPACES TO JOBPLAN-DELETE-TABLE.
005800 6-MAIN.
           MOVE 0 TO COND-WORD.
           READ JOBPLAN-FILE NEXT INTO JOBPLAN-BUFFER
               AT END    MOVE 11 TO COND-WORD.
           IF JF-STATUS NOT = "00" MOVE 11 TO COND-WORD.
006100     IF COND-WORD = 11
006200         MOVE "EOF ENCOUNTERED" TO DETAIL-LINE
               PERFORM 6-WRITE-LINE
               DISPLAY "TOTAL JOBPLAN RECORDS READ = " RECDS-CTR
               DISPLAY "DELETEABLE JOBPLAN RECORDS = " DEL-CTR
               MOVE "TOTAL JOBPLAN RECORDS READ = " TO D-LIT-2A
               MOVE RECDS-CTR                       TO D-CTR-2
               PERFORM 6-WRITE-LINE
               MOVE "DW DELETEABLE JOBPLANS     = " TO D-LIT-2A
               MOVE RECDS-CTR-DW                    TO D-CTR-2
               PERFORM 6-WRITE-LINE
               MOVE "FF DELETEABLE JOBPLANS     = " TO D-LIT-2A
               MOVE RECDS-CTR-FF                    TO D-CTR-2
               PERFORM 6-WRITE-LINE
               MOVE "DELETEABLE JOBPLAN RECORDS = " TO D-LIT-2A
               MOVE DEL-CTR                         TO D-CTR-2
               PERFORM 6-WRITE-LINE
012700         DISPLAY "LAST CHANCE BEFORE DELETE - CONTINUE (Y/N)?"
012800         ACCEPT ANSWER-SW
012900         IF ANSWER-SW = "Y"
                   PERFORM 61-DELETE-JP-ENTRIES THRU 61-DJE-X
                       VARYING SUB1 FROM 1 BY 1
                       UNTIL (SUB1 > 5000) OR (JPWO (SUB1) = SPACES)
006700*            PERFORM 61-PRINT-TABLE-FFS THRU 61-PTF-X
006800*                VARYING SUB1 FROM 1 BY 1 UNTIL SUB1 > 100
                   GO TO 2-EOJ
013100         ELSE
006900         GO TO 2-EOJ.
007600     ADD 1 TO RECDS-CTR.
007700     IF R-C-LAST-5 = ZEROES
               ACCEPT CURRENT-TIME FROM TIME
007800         DISPLAY "       " CURRENT-TIME "       "
007900         DISPLAY RECDS-CTR " JOBPLAN RECORDS HAVE BEEN READ "
008000         DISPLAY RECDS-CTR-DW " DELETEABLE DW JOBPLAN RECORDS"
008100         DISPLAY RECDS-CTR-FF " DELETEABLE FF JOBPLAN RECORDS".
008200*    IF R-C-LAST-3 = ZEROES
008300*        DISPLAY RECDS-CTR " JOBPLAN RECORDS HAVE BEEN READ "
008400*            RECDS-CTR-FF " DELETEABLE".
           MOVE JOBPLAN-WO-NO TO WONUM OF WPFREC.
           START WO-PLANNED-FILE KEY = EXTERNALLY-DESCRIBED-KEY
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF WPF-STATUS NOT = "00" MOVE 17 TO COND-WORD.
008900     IF COND-WORD = 17
009000         ADD 1 TO DEL-CTR
               MOVE SPACES TO DETAIL-LINE
               MOVE JOBPLAN-WO-NO-SEQ  TO D-JPWOSEQ-3
               MOVE " IS DELETEABLE "  TO D-LIT-3
               PERFORM 6-WRITE-LINE
               MOVE JOBPLAN-WO-NO TO JPWO (DEL-CTR)
               IF DEL-CTR = 5000
                   DISPLAY "5000 JOBPLAN ENTRIES ARE DELETEABLE"
                   DISPLAY "TOTAL JOBPLAN RECORDS READ = " RECDS-CTR
                   DISPLAY "DELETEABLE JOBPLAN RECORDS = " DEL-CTR
                   MOVE "TOTAL JOBPLAN RECORDS READ = " TO D-LIT-2A
                   MOVE RECDS-CTR                       TO D-CTR-2
                   PERFORM 6-WRITE-LINE
                   MOVE "DW DELETEABLE JOBPLANS     = " TO D-LIT-2A
                   MOVE RECDS-CTR-DW                    TO D-CTR-2
                   PERFORM 6-WRITE-LINE
                   MOVE "FF DELETEABLE JOBPLANS     = " TO D-LIT-2A
                   MOVE RECDS-CTR-FF                    TO D-CTR-2
                   PERFORM 6-WRITE-LINE
                   MOVE "DELETEABLE JOBPLAN RECORDS = " TO D-LIT-2A
                   MOVE DEL-CTR                         TO D-CTR-2
                   PERFORM 6-WRITE-LINE
012700             DISPLAY "LAST CHANCE BEFORE DELETE - CONTINUE (Y/N)?"
012800             ACCEPT ANSWER-SW
012900             IF ANSWER-SW = "Y"
                       PERFORM 61-DELETE-JP-ENTRIES THRU 61-DJE-X
                           VARYING SUB1 FROM 1 BY 1
                           UNTIL (SUB1 > 5000) OR (JPWO (SUB1) = SPACES)
006700*                PERFORM 61-PRINT-TABLE-FFS THRU 61-PTF-X
006800*                    VARYING SUB1 FROM 1 BY 1 UNTIL SUB1 > 100
                       GO TO 2-EOJ
013100             ELSE
                   GO TO 2-EOJ
               ELSE
009300         GO TO 6-MAIN.
           READ WO-PLANNED-FILE NEXT INTO WO-PLANNED-DATA
               AT END    MOVE 15 TO COND-WORD.
           IF WPF-STATUS NOT = "00" MOVE 15 TO COND-WORD.
009600     IF COND-WORD = 0 GO TO 6-MAIN-CONT.
           MOVE JOBPLAN-WO-NO TO WONUM OF WBFREC
           START WO-BASIC-FILE KEY = EXTERNALLY-DESCRIBED-KEY
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF WBF-STATUS NOT = "00" MOVE 17 TO COND-WORD.
010000     IF COND-WORD = 17
010100         ADD 1 TO DEL-CTR
               MOVE SPACES TO DETAIL-LINE
               MOVE JOBPLAN-WO-NO-SEQ  TO D-JPWOSEQ-3
               MOVE " IS DELETEABLE "  TO D-LIT-3
               PERFORM 6-WRITE-LINE
               IF DEL-CTR = 5000
                   DISPLAY "5000 JOBPLAN ENTRIES ARE DELETEABLE"
                   DISPLAY "TOTAL JOBPLAN RECORDS READ = " RECDS-CTR
                   DISPLAY "DELETEABLE JOBPLAN RECORDS = " DEL-CTR
                   MOVE "TOTAL JOBPLAN RECORDS READ = " TO D-LIT-2A
                   MOVE RECDS-CTR                       TO D-CTR-2
                   PERFORM 6-WRITE-LINE
                   MOVE "DW DELETEABLE JOBPLANS     = " TO D-LIT-2A
                   MOVE RECDS-CTR-DW                    TO D-CTR-2
                   PERFORM 6-WRITE-LINE
                   MOVE "FF DELETEABLE JOBPLANS     = " TO D-LIT-2A
                   MOVE RECDS-CTR-FF                    TO D-CTR-2
                   PERFORM 6-WRITE-LINE
                   MOVE "DELETEABLE JOBPLAN RECORDS = " TO D-LIT-2A
                   MOVE DEL-CTR                         TO D-CTR-2
                   PERFORM 6-WRITE-LINE
012700             DISPLAY "LAST CHANCE BEFORE DELETE - CONTINUE (Y/N)?"
012800             ACCEPT ANSWER-SW
012900             IF ANSWER-SW = "Y"
                       PERFORM 61-DELETE-JP-ENTRIES THRU 61-DJE-X
                           VARYING SUB1 FROM 1 BY 1
                           UNTIL (SUB1 > 5000) OR (JPWO (SUB1) = SPACES)
006700*                PERFORM 61-PRINT-TABLE-FFS THRU 61-PTF-X
006800*                    VARYING SUB1 FROM 1 BY 1 UNTIL SUB1 > 100
                       GO TO 2-EOJ
013100             ELSE
                   GO TO 2-EOJ
               ELSE
010400         GO TO 6-MAIN
010500     ELSE
           READ WO-BASIC-FILE NEXT INTO WO-PLANNED-DATA
               AT END    MOVE 15 TO COND-WORD.
           IF WBF-STATUS NOT = "00" MOVE 15 TO COND-WORD.
010800     IF COND-WORD = 0 GO TO 6-MAIN-CONT.
010900     ADD 1 TO DEL-CTR.
           MOVE SPACES TO DETAIL-LINE.
           MOVE JOBPLAN-WO-NO-SEQ  TO D-JPWOSEQ-3.
           MOVE " IS DELETEABLE "  TO D-LIT-3.
           PERFORM 6-WRITE-LINE.
           IF DEL-CTR = 5000
               DISPLAY "5000 JOBPLAN ENTRIES ARE DELETEABLE"
               DISPLAY "TOTAL JOBPLAN RECORDS READ = " RECDS-CTR
               DISPLAY "DELETEABLE JOBPLAN RECORDS = " DEL-CTR
               MOVE "TOTAL JOBPLAN RECORDS READ = " TO D-LIT-2A
               MOVE RECDS-CTR                       TO D-CTR-2
               PERFORM 6-WRITE-LINE
               MOVE "DW DELETEABLE JOBPLANS     = " TO D-LIT-2A
               MOVE RECDS-CTR-DW                    TO D-CTR-2
               PERFORM 6-WRITE-LINE
               MOVE "FF DELETEABLE JOBPLANS     = " TO D-LIT-2A
               MOVE RECDS-CTR-FF                    TO D-CTR-2
               PERFORM 6-WRITE-LINE
               MOVE "DELETEABLE JOBPLAN RECORDS = " TO D-LIT-2A
               MOVE DEL-CTR                         TO D-CTR-2
               PERFORM 6-WRITE-LINE
012700         DISPLAY "LAST CHANCE BEFORE DELETE - CONTINUE (Y/N)?"
012800         ACCEPT ANSWER-SW
012900         IF ANSWER-SW = "Y"
                   PERFORM 61-DELETE-JP-ENTRIES THRU 61-DJE-X
                       VARYING SUB1 FROM 1 BY 1
                       UNTIL (SUB1 > 5000) OR (JPWO (SUB1) = SPACES)
006700*            PERFORM 61-PRINT-TABLE-FFS THRU 61-PTF-X
006800*                VARYING SUB1 FROM 1 BY 1 UNTIL SUB1 > 100
                   GO TO 2-EOJ
013100         ELSE
               GO TO 2-EOJ.
011200     GO TO 6-MAIN.
       6-MAIN-CONT.
011300     IF WO-STATUS-P = "DW"
011400         IF WO-START-STATUS = "AA" OR "AR"
011500             IF SAVE-HIST-SW = "  "
011600                 IF WO-NUM-SUFF-P = "000"
011700                     NEXT SENTENCE
011800                 ELSE
011900                 ADD 1 TO RECDS-CTR-DW.
012000     IF WO-STATUS-P = "FF"
012100         IF WO-START-STATUS = "AA" OR "AR"
012200             IF SAVE-HIST-SW = "  "
012300                 IF WO-NUM-SUFF-P = "000"
012400                     NEXT SENTENCE
012500                 ELSE
012600                 ADD 1 TO RECDS-CTR-FF
012700                 MOVE 0 TO SUB1
012800                 PERFORM 60-LOAD-FFS THRU 60-LF-X.
012900     GO TO 6-MAIN.
013000
       6-WRITE-LINE.
           ADD 1 TO LINE-CTR.
           IF LINE-CTR > 59
               MOVE 0 TO LINE-CTR
               WRITE PRINTF FROM HEADER-1 AFTER ADVANCING NEW-PAGE
               WRITE PRINTF FROM HEADER-2 AFTER ADVANCING 1
               WRITE PRINTF FROM DETAIL-LINE AFTER ADVANCING 1
               MOVE 3 TO LINE-CTR
           ELSE
           WRITE PRINTF FROM DETAIL-LINE AFTER ADVANCING 1.

013100 60-LOAD-FFS.
013200     ADD 1 TO SUB1.
013300     IF SUB1 > 100 GO TO 60-LF-X.
013400     IF T-WO (SUB1) = "          "
013500         MOVE JOBPLAN-WO-NO TO T-WO (SUB1)
013600         MOVE 1 TO T-CTR (SUB1)
013700         GO TO 60-LF-X.
013800     IF T-WO (SUB1) = JOBPLAN-WO-NO
013900         ADD 1 TO T-CTR (SUB1)
014000         GO TO 60-LF-X.
014100     GO TO 60-LOAD-FFS.
014200
014300 60-LF-X.    EXIT.
014400
       61-DELETE-JP-ENTRIES.
           MOVE JPWO (SUB1) TO JOBPWOSEQ.
           START JOBPLAN-FILE
               KEY IS NOT LESS THAN JOBPWOSEQ.
           IF JF-STATUS = "00"
               PERFORM 61-DELETE-JOBPLAN-C THRU 61-DJE-X
           ELSE
           DISPLAY "ERROR READING JOBPLAN FILE " JF-STATUS
           GO TO 61-DJE-X.

       61-DELETE-JOBPLAN-C.
           READ JOBPLAN-FILE NEXT RECORD.
           IF JF-STATUS NOT = "00" GO TO 61-DJE-X.

           MOVE JOBPWOSEQ TO JOBP-WO-SEQ.
           IF JOBP-WONUM NOT = JPWO (SUB1)
               REWRITE JFREC
               GO TO 61-DJE-X.

           DELETE JOBPLAN-FILE RECORD.
           IF JF-STATUS NOT = "00"
               DISPLAY "DELETE OF JOBPLAN ENTRY = "
                   JPWO (SUB1) " FAILED " JF-STATUS
               GO TO 2-EOJ
           ELSE
           MOVE JOBPWOSEQ OF JFREC TO D-JPWOSEQ-3
           MOVE " WAS DELETED" TO D-LIT-3
           PERFORM 6-WRITE-LINE
           GO TO 61-DELETE-JOBPLAN-C.
       61-DJE-X.    EXIT.

014500 61-PRINT-TABLE-FFS.
014600     IF T-WO (SUB1) = "          "
014700         NEXT SENTENCE
014800     ELSE
014900     DISPLAY "FF WO TO DELETE = " T-WO (SUB1) " "
015000         T-CTR (SUB1).
015100 61-PTF-X.    EXIT.

       COPY OVRPFCALL IN COPYLIB.
