       01  PRINT-CODE-LINE6 REDEFINES PRINT-LINE1.
           05  FILLER                 PIC X(2).
           05  PRT-LAST-ACT-LIT       PIC X(8).
           05  FILLER                 PIC X(2).
           05  PRT-LAST-ACT-DATE      PIC X(8).
           05  FILLER                 PIC X(6).
           05  PRT-MAXIMUM-LIT        PIC X(7).
           05  FILLER                 PIC X(3).
           05  PRT-MAXIMUM            PIC Z(7)9.
           05  FILLER                 PIC X(4).
           05  FILLER                 PIC X(1).
           05  PRT-INS                PIC X.
           05  FILLER                 PIC X(3).
           05  PRT-OE                 PIC X.
           05  FILLER                 PIC X(3).
           05  PRT-MR                 PIC X.
           05  FILLER                 PIC X(3).
           05  PRT-OR                 PIC X.
           05  FILLER                 PIC X(3).
           05  PRT-IMP                PIC X.
           05  FILLER                 PIC X(4).
           05  PRT-STOCK-OT           PIC X.
           05  FILLER                 PIC X(3).
           05  PRT-CO                 PIC X.

       01  PRINT-CODE-LINE7 REDEFINES PRINT-LINE1.
           05  FILLER                 PIC X(2).
           05  PRT-LAST-ISS-LIT       PIC X(8).
           05  FILLER                 PIC X(2).
