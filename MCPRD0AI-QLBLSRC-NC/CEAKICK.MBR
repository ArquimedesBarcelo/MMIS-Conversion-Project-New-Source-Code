           05  PRT-BUDGET-NO-LIT   PIC X(13).
           05  FILLER              PIC X.
           05  BUDGET-NO-OUT       PIC X(12).
           05  FILLER              PIC X.
           05  PRT-BUDGET-AMT-LIT  PIC X(13).
           05  FILLER              PIC X.
           05  BUDGET-AMT-OUT      PIC Z(9)9.
           05  BUDGET-AMT-OUT-R  REDEFINES  BUDGET-AMT-OUT
                                   PIC X(10).

       01  PRINT-LINE5 REDEFINES PRINT-LINE1.
           05  PRT-ORIGIN-LIT         PIC X(6).
           05  ORIG-HYPHEN            PIC X.
           05  ORIGIN-OUT             PIC X(17).
           05  FILLER                 PIC X(1).
           05  PRT-QUANTITY-LIT       PIC X(8).
           05  FILLER                 PIC X(4).
           05  QTY-OUT                PIC Z(7)9.
           05  FILLER                 PIC X(2).
           05  QTY-UM-OUT             PIC X(2).
           05  FILLER                 PIC X(7).
           05  PRT-EST-COST-LIT       PIC X(9).
           05  FILLER                 PIC X(1).
           05  EST-COST-OUT           PIC Z(8)9.9999.

       01  PRINT-LINE9 REDEFINES PRINT-LINE1.
           05  ASTERISK-LINE          PIC X(80).

       01  PRINT-LINE11 REDEFINES PRINT-LINE1.
           05  CORP-CODE-OUT          PIC X(7).
