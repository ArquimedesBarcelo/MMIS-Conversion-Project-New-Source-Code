       IDENTIFICATION DIVISION.
       PROGRAM-ID.    CEAKICK.
       AUTHOR.        BRUCE GEISER.
       DATE-WRITTEN.  NOVEMBER 2002.

      *******************************************************
      *                                                     *
      *                 C E A K I C K                       *
      *                                                     *
      *   THIS SUB PROGRAM GENERATES A SINGLE PAGE PRINT    *
      *   OF A REQUISITION THAT CONTAINS BASIC REQ DATA AS  *
      *   WELL AS THE CURRENT APPOVAL PATH WITH HISTORY.    *
      *   TO BE USED AS A TOOL TO KICK START THE APPROVAL   *
      *   OF HIGH PRIORITY REQS.                            *
      *                                                     *
      *******************************************************
      * 11/08/2002 GEISER                                   *
      *   NEW PROGRAM.                                      *
      *                                                     *
      * 08/14/2003 GEISER                                   *
      *   PRINT ALL NON-STR DESCRIPTION LINES.              *
      *                                                     *
      * 08/04/2004 GEISER        (GADSDEN REQUEST)          *
      *   ADDED REQ TYPE LITERAL (SERVICE/REPAIR/MATERIAL). *
      *                                                     *
      *******************************************************

       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.
       SOURCE-COMPUTER.  AS-400.
       OBJECT-COMPUTER.  AS-400.

       SPECIAL-NAMES.  C01 IS NEWPAGE.

       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT ONLINE-PRT ASSIGN TO PRINTER-MCPRT.

           SELECT MREQ-I
                  ASSIGN TO DATABASE-MCFLCS2001
                  ORGANIZATION IS INDEXED
                    ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                  FILE STATUS IS FILE-STATUS.

           SELECT MSTORERM-I
                  ASSIGN TO DATABASE-MCFLCS0201
                  ORGANIZATION IS INDEXED
                    ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                  FILE STATUS IS FILE-STATUS.

           SELECT DREQD-I
                  ASSIGN TO DATABASE-MCFLCS2101
                  ORGANIZATION IS INDEXED
                    ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                    WITH DUPLICATES
                  FILE STATUS IS FILE-STATUS.

           SELECT DREQITM-I
                  ASSIGN TO DATABASE-MCFLCS2201
                  ORGANIZATION IS INDEXED
                    ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                    WITH DUPLICATES
                  FILE STATUS IS FILE-STATUS.

           SELECT DREQDESC-I
                  ASSIGN TO DATABASE-MCFLCS2301
                  ORGANIZATION IS INDEXED
                    ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                    WITH DUPLICATES
                  FILE STATUS IS FILE-STATUS.

           SELECT PERSONNEL-I
                  ASSIGN TO DATABASE-MCFLMM0301
                  ORGANIZATION IS INDEXED
                    ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                  FILE STATUS IS FILE-STATUS.

           SELECT DREQQUE-I
                  ASSIGN TO DATABASE-MCFLCS4401
                  ORGANIZATION IS INDEXED
                    ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                    WITH DUPLICATES
                  FILE STATUS IS FILE-STATUS.


       DATA DIVISION.
       FILE SECTION.
       FD  ONLINE-PRT
           LABEL RECORDS ARE OMITTED
           RECORD CONTAINS 80  CHARACTERS
           DATA RECORD IS PRINT-RCD.
       01  PRINT-RCD.
           05  PRINT-LINE        PIC X(80).

       FD  MREQ-I
           LABEL RECORDS ARE STANDARD.
       01  MREQ-REC-I.
           COPY DDS-ALL-FORMATS  OF MCFLCS2001.

       FD  MSTORERM-I
           LABEL RECORDS ARE STANDARD.
       01  MSTORERM-REC-I.
           COPY DDS-ALL-FORMATS  OF MCFLCS0201.

       FD  DREQD-I
           LABEL RECORDS ARE STANDARD.
       01  DREQD-REC-I.
           COPY DDS-ALL-FORMATS  OF MCFLCS2101.

       FD  DREQITM-I
           LABEL RECORDS ARE STANDARD.
       01  DREQITM-REC-I.
           COPY DDS-ALL-FORMATS  OF MCFLCS2201.

       FD  DREQDESC-I
           LABEL RECORDS ARE STANDARD.
       01  DREQDESC-REC-I.
           COPY DDS-ALL-FORMATS  OF MCFLCS2301.

       FD  PERSONNEL-I
           LABEL RECORDS ARE STANDARD.
       01  PERSONNEL-REC-I.
           COPY DDS-ALL-FORMATS  OF MCFLMM0301.

       FD  DREQQUE-I
           LABEL RECORDS ARE STANDARD.
       01  DREQQUE-REC-I.
           COPY DDS-MCRPCS4400  OF MCFLCS4401.

       WORKING-STORAGE SECTION.
       01  FILE-STATUS.
           05  FILE-STATUS-1       PIC X     VALUE "0".
           05  FILE-STATUS-2       PIC X     VALUE "0".
       77  COMPANY-SAVE            PIC X(3)  VALUE SPACES.
       77  LINE-ADV                PIC 9(4) COMP-4 VALUE ZEROS.
       77  LINE-CTR                PIC 9(4) COMP-4 VALUE ZEROS.
       77  TOT-PRINT-LINES         PIC 9(4) COMP-4 VALUE ZEROS.

       01  WORK-AREA.
           05  SAVE-REQ-PRT-NO         PIC 9(2).
           05  SAVE-REQ-PRT-NO-X  REDEFINES SAVE-REQ-PRT-NO
                                       PIC XX.
           05  SAVE-REMARK-LINE-2      PIC X(80)   VALUE SPACES.
           05  SAVE-TODAYS-DATE        PIC X(6)    VALUE SPACES.

       01  MORE-DESC-LIT               PIC X(70)  VALUE SPACES.

       COPY TDATECHK   IN COPYLIB.

       COPY CDESC      IN COPYLIB.

       01  RET-CODE                     PIC X(2)   VALUE SPACES.

      **************************************************************
      **************************************************************
      **                                                          **
      **                DATABASE I/O BUFFER AREA                  **
      **                                                          **
      **************************************************************
      **************************************************************

       COPY MSTORERM   IN COPYLIB.

       COPY MREQ       IN COPYLIB.

       COPY DREQITM    IN COPYLIB.

       COPY DREQD      IN COPYLIB.

       COPY DREQDESC   IN COPYLIB.

       COPY DREQQUE    IN COPYLIB.

       01 BUF-PER-PERSONNEL.
       COPY MPERSONL IN COPYLIB.

       COPY DBMODES    IN COPYLIB.

       01 ARG-VALUES.
           05  CODE-ARG                 PIC X(8)  VALUE SPACES.
           05  REQ-ARG                  PIC X(12) VALUE SPACES.
           05  EMPL-ARG                 PIC X(6)  VALUE SPACES.

      ***************************************************
      **   REMARKS AREA USED WHEN CALLING CREQREM
      **   TO RETRIEVE THE REMARKS FOR A REQ.
      ***************************************************

       01  CREQREM-REMARKS.
           05  CREQREM-REMARK-1         PIC X(79).
           05  CREQREM-REMARK-2         PIC X(79).

      ***************************************************
      **   PARAMETERS FOR CALLING 'SONORDER' WHICH
      **   CALCULATES ONORDER FOR A CODE
      ***************************************************

       COPY SONORDER IN COPYLIB.

      **************************************************
      *                                                *
      *      PRINT LINES FOR REQUISITION FORM          *
      *                                                *
      **************************************************

       01  PRINT-LINE1.
           05  PRT-REQ-NO-LIT      PIC X(6).
           05  REQ-NO-OUT          PIC X(12).
           05  FILLER              PIC X(7).
           05  REQ-HEADER          PIC X(21).
           05  PRT-DASH-1          PIC X(1).
           05  APPROVAL-LIT        PIC X(11).
           05  FILLER              PIC X(1).
           05  REQ-REPRINT-HEAD    PIC X(10).
           05  FILLER              PIC X(3).
           05  TODAYS-DATE-OUT     PIC X(8).
           05  FILLER              PIC X(2).

       01  PRINT-LINE2 REDEFINES PRINT-LINE1.
           05  PRT-WO-NO-LIT       PIC X(2).
           05  FILLER              PIC X.
           05  WO-NO-OUT           PIC X(10).
           05  FILLER              PIC X(1).
           05  PRT-STAG-LIT        PIC X(8).
           05  STAG-OUT            PIC X(4).
           05  FILLER              PIC X(5).
           05  PRT-REQ-DATE-LIT    PIC X(9).
