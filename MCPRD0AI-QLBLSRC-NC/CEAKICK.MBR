           05  FILLER                 PIC X(2).

       01  PRINT-CODE-LINE8 REDEFINES PRINT-LINE1.
           05  FILLER                 PIC X(2).
           05  FILLER                 PIC X(6).
           05  PRT-TO-LIT             PIC X(3).
           05  FILLER                 PIC X(1).
           05  PRT-ISS-DEPT           PIC X(6).
           05  FILLER                 PIC X(8).
           05  PRT-EXPEDITE-LIT       PIC X(8).
           05  FILLER                 PIC X(2).
           05  PRT-EXPEDITE           PIC Z(7)9.

      *--------- APPROVAL LINE.
       01  PRINT-APPRV-LINE REDEFINES PRINT-LINE1.
           05  PRT-PMGR-LIT           PIC X(7).
           05  UNDERLINE-1            PIC X(7).
           05  FILLER                 PIC X(1).
           05  PRT-ENGR-LIT           PIC X(7).
           05  UNDERLINE-2            PIC X(7).
           05  FILLER                 PIC X(1).
           05  PRT-MGR1-LIT           PIC X(7).
           05  UNDERLINE-3            PIC X(7).
           05  FILLER                 PIC X(1).
           05  PRT-MGR2-LIT           PIC X(7).
           05  UNDERLINE-4            PIC X(7).
           05  FILLER                 PIC X(1).
           05  PRT-MGR3-LIT           PIC X(7).
           05  UNDERLINE-5            PIC X(7).
           05  FILLER                 PIC X(1).

      *--------- APPROVAL PATH DETAIL.
       01  PRINT-PATH-DETAIL REDEFINES PRINT-LINE1.
           05  PRT-APP-LEVEL          PIC X(02).
           05  FILLER                 PIC X(02).
           05  PRT-QUE-DATE           PIC X(08).
           05  FILLER                 PIC X(01).
           05  PRT-APP-DATE           PIC X(08).
           05  FILLER                 PIC X(01).
           05  PRT-APP-EMPL           PIC X(04).
           05  FILLER                 PIC X(01).
           05  PRT-APP-EMPL-NAME      PIC X(16).
           05  FILLER                 PIC X(01).
           05  PRT-APP-COMMENT        PIC X(33).
           05  FILLER                 PIC X(03).

      *--------- APPROVAL PATH HEADER.
       01  PRINT-PATH-HEADER.
           05  FILLER                 PIC X(04) VALUE "LVL ".
           05  FILLER                 PIC X(09) VALUE "QUE-DATE ".
           05  FILLER                 PIC X(09) VALUE "APP-DATE ".
           05  FILLER                 PIC X(05) VALUE " ID  ".
           05  FILLER                 PIC X(04) VALUE "NAME".
           05  FILLER                 PIC X(13) VALUE SPACES.
           05  FILLER                 PIC X(08) VALUE "COMMENTS".
           05  FILLER                 PIC X(28) VALUE SPACES.


      **************************************************
      **  LITERALS FROM SET NUMBER 54 IN MCFP000100   **
      **  ARE WRITTEN OVER THESE VALUES. CAN BE USED  **
      **  AS A FOREIGN LANGUAGE TRANSLATOR BY PLANTS  **
      **************************************************
       01  LITERALS.
           05  REQ-NO-LIT           PIC X(06)  VALUE "REQ # ".
           05  WO-NO-LIT            PIC X(02)  VALUE "WO".
           05  STAG-LIT             PIC X(08)  VALUE "STAGING ".
           05  REQ-DATE-LIT         PIC X(09)  VALUE "REQ DATE ".
           05  PO-NUM-LIT           PIC X(14)  VALUE "PURCHASE ORDER".
           05  BUDGET-NO-LIT        PIC X(13)  VALUE "BUDGET NUMBER".
           05  BUDGET-AMT-LIT       PIC X(13)  VALUE "BUDGET AMOUNT".
           05  ORIGIN-LIT           PIC X(06)  VALUE "ORIGIN".
           05  EST-COST-LIT         PIC X(12)  VALUE "EST. COST   ".
           05  APPROVE-LIT          PIC X(07)  VALUE "APPROVE".
           05  REMARKS-LIT          PIC X(07)  VALUE "REMARKS".
           05  PMGR-LIT             PIC X(07)  VALUE " P-MGR ".
           05  ENGR-LIT             PIC X(07)  VALUE " ENGR  ".
           05  MGR1-LIT             PIC X(07)  VALUE " MGR 1 ".
           05  MGR2-LIT             PIC X(07)  VALUE " MGR 2 ".
           05  MGR3-LIT             PIC X(07)  VALUE " MGR 3 ".
           05  DESC-LIT             PIC X(15)  VALUE "DESCRIPTION    ".
           05  PRICE-LIT            PIC X(05)  VALUE "PRICE".
           05  UM-LIT               PIC X(02)  VALUE "UM".
           05  QUANTITY-LIT         PIC X(08)  VALUE "QUANTITY".
           05  DATE-WANTED-LIT      PIC X(11)  VALUE "DATE WANTED".
           05  EST-LT-LIT           PIC X(06)  VALUE "EST LT".
           05  SHIP-DATE-LIT        PIC X(09)  VALUE "SHIP DATE".
           05  EXPECT-DATE-LIT      PIC X(11)  VALUE "EXPECT DATE".
           05  LAST-VENDOR-LIT      PIC X(11)  VALUE "LST PO/VEND".
           05  LAST-DELV-TIME-LIT   PIC X(18)  VALUE
                                  "LAST DELIVERY TIME".
           05  DAYS-LIT             PIC X(06)  VALUE "DAYS  ".
           05  CODE-DATA-LIT        PIC X(15)  VALUE "CODE DATA".
           05  STR-UM-LIT           PIC X(09)  VALUE "STORES UM".
           05  ONHAND-LIT           PIC X(06)  VALUE "ONHAND".
           05  AVG-COST-LIT         PIC X(08)  VALUE "AVG COST".
           05  ALT-UM1-LIT          PIC X(07)  VALUE "ALT UM1".
           05  RESERVED-LIT         PIC X(08)  VALUE "RESERVED".
           05  MKT-COST-LIT         PIC X(08)  VALUE "MKT COST".
           05  ALT-UM1-CONV-LIT     PIC X(08)  VALUE "UM1 CONV".
           05  ONORDER-LIT          PIC X(07)  VALUE "ONORDER".
           05  REPAIR-COST-LIT      PIC X(08)  VALUE "REPAIR ".
           05  ALT-UM2-LIT          PIC X(07)  VALUE "ALT UM2".
           05  AVG-ISS-LIT          PIC X(09)  VALUE "AVG ISSUE".
           05  CLASSIF-LIT          PIC X(27)  VALUE
                                  "IN  OE  MR  OR  IMP  SO  CO".
           05  ALT-UM2-CONV-LIT     PIC X(08)  VALUE "UM2 CONV".
           05  EOQ-LIT              PIC X(03)  VALUE "EOQ".
           05  LAST-ACT-LIT         PIC X(08)  VALUE "LAST ACT".
           05  SOQ-LIT              PIC X(03)  VALUE "SOQ".
           05  LAST-ISS-LIT         PIC X(08)  VALUE "LAST ISS".
           05  MAXIMUM-LIT          PIC X(07)  VALUE "MAXIMUM".
           05  TO-LIT               PIC X(02)  VALUE "TO".
           05  REORDER-LIT          PIC X(07)  VALUE "REORDER".
           05  EXPEDITE-LIT         PIC X(08)  VALUE "EXPEDITE".
           05  WO-AMT-APPROVED-LIT  PIC X(18)  VALUE SPACES.
           05  WO-AMT-COMMITTED-LIT PIC X(18)  VALUE SPACES.
           05  WO-AMT-REQ-LIT       PIC X(18)  VALUE SPACES.
           05  WO-AMT-AVAIL-LIT     PIC X(18)  VALUE SPACES.
           05  REPRINT-LIT          PIC X(10)  VALUE "(REPRINT) ".
           05  REPAIR-REQ-LIT       PIC X(21)  VALUE
                                         "REPAIR REQUISITON    ".
           05  PURCHASE-REQ-LIT     PIC X(21)  VALUE
                                         "PURCHASE REQUISITION ".
           05  APPROVED-LIT         PIC X(11)  VALUE SPACES.
           05  NON-APPROVED-LIT     PIC X(11)  VALUE SPACES.
           05  STOREROOM-LIT        PIC X(20)  VALUE SPACES.
           05  MORE-EXIST-LIT       PIC X(10)  VALUE SPACES.

       01  MESSAGE-BUFFER           PIC X(72)  VALUE SPACES.

       COPY CATREAD IN COPYLIB.

       COPY OVRPFDATA IN COPYLIB.

       COPY CCHKOBJ IN COPYLIB.

       01  WHO-PARMS.
           05  USERNAME             PIC X(10).
           05  TERMNUM              PIC X(10).
           05  CURRLIB              PIC X(10).
           05  JOBLIBX              PIC X(01).

       LINKAGE SECTION.

       01  BASE                     PIC X(10).

       01  BASE-MMISA.
           05  BASE-MMISA-2-CHAR    PIC X(2).
           05  FILLER               PIC X(22).

       COPY SREQPRNT   IN COPYLIB.

       COPY LANGSUB    IN COPYLIB.

       COPY DBSTAT     IN COPYLIB.

       01  BU-DISPLAY-MSG.
           05  BU-DISPLAY-MSG-1     PIC X(1).
           05  FILLER               PIC X(59).

       01  BU-DISPLAY-FLDS.
           05  BU-DISPLAY-LINE  OCCURS 5 TIMES.
               10  BU-DISPLAY-FLD   PIC X(14).
               10  BU-DISPLAY-FLD9  PIC S9(8).

       COPY VCOMLINK   IN COPYLIB.

       PROCEDURE DIVISION USING  BASE,
                                 BASE-MMISA,
                                 SREQPRNT-PARMS,
                                 LANGUAGE-PARMS,
                                 STATUS-AREA,
                                 BU-DISPLAY-MSG,
                                 BU-DISPLAY-FLDS,
                                 VIEW-COMAREA.

       1-BEGIN.
           OPEN INPUT MREQ-I, DREQD-I, DREQITM-I,
                      MSTORERM-I, DREQDESC-I, PERSONNEL-I, DREQQUE-I.

           PERFORM 1-HSK  THRU  1-HSK-X.

           PERFORM 6-WRITE-REQ  THRU  6-WR-X.

           CLOSE      MREQ-I, DREQD-I, DREQITM-I,
                      MSTORERM-I, DREQDESC-I, PERSONNEL-I, DREQQUE-I.
           GOBACK.

       1-HSK.
           IF REQ-SREQPRNT-CALLED = "Y"
               GO TO 1-HSK-X
           ELSE
               MOVE "Y"                 TO  REQ-SREQPRNT-CALLED.

      *************************************************
      **  LOAD PRINT LITERALS FROM SET NUMBER 54
      **   CAN BE USED AS A FOREIGN LANGUAGE TRANSLATOR
      *************************************************
           MOVE 54                      TO  LANG-SETNUM.
           MOVE 1                       TO  LANG-MSGNUM.
           PERFORM 999-CATREAD  THRU  999-CATREAD-EXIT.
           MOVE MESSAGE-BUFFER          TO  REQ-NO-LIT.
           MOVE 2                       TO  LANG-MSGNUM.
           PERFORM 999-CATREAD  THRU  999-CATREAD-EXIT.
           MOVE MESSAGE-BUFFER          TO  WO-NO-LIT.
           MOVE 3                       TO  LANG-MSGNUM.
           PERFORM 999-CATREAD  THRU  999-CATREAD-EXIT.
           MOVE MESSAGE-BUFFER          TO  PURCHASE-REQ-LIT.
           MOVE 4                       TO  LANG-MSGNUM.
           PERFORM 999-CATREAD  THRU  999-CATREAD-EXIT.
           MOVE MESSAGE-BUFFER          TO  REPRINT-LIT.
           MOVE 5                       TO  LANG-MSGNUM.
           PERFORM 999-CATREAD  THRU  999-CATREAD-EXIT.
           MOVE MESSAGE-BUFFER          TO  STAG-LIT.
           MOVE 6                       TO  LANG-MSGNUM.
           PERFORM 999-CATREAD  THRU  999-CATREAD-EXIT.
           MOVE MESSAGE-BUFFER          TO  REQ-DATE-LIT.
           MOVE 7                       TO  LANG-MSGNUM.
           PERFORM 999-CATREAD  THRU  999-CATREAD-EXIT.
           MOVE MESSAGE-BUFFER          TO  PO-NUM-LIT.
           MOVE 8                       TO  LANG-MSGNUM.
           PERFORM 999-CATREAD  THRU  999-CATREAD-EXIT.
           MOVE MESSAGE-BUFFER          TO  BUDGET-NO-LIT.
           MOVE 9                       TO  LANG-MSGNUM.
           PERFORM 999-CATREAD  THRU  999-CATREAD-EXIT.
           MOVE MESSAGE-BUFFER          TO  BUDGET-AMT-LIT.
           MOVE 10                      TO  LANG-MSGNUM.
           PERFORM 999-CATREAD  THRU  999-CATREAD-EXIT.
           MOVE MESSAGE-BUFFER          TO  ORIGIN-LIT.
           MOVE 15                      TO  LANG-MSGNUM.
           PERFORM 999-CATREAD  THRU  999-CATREAD-EXIT.
           MOVE MESSAGE-BUFFER          TO  EST-COST-LIT.
           MOVE 16                      TO  LANG-MSGNUM.
           PERFORM 999-CATREAD  THRU  999-CATREAD-EXIT.
           MOVE MESSAGE-BUFFER          TO  DESC-LIT.
           MOVE 17                      TO  LANG-MSGNUM.
           PERFORM 999-CATREAD  THRU  999-CATREAD-EXIT.
           MOVE MESSAGE-BUFFER          TO  PRICE-LIT.
           MOVE 18                      TO  LANG-MSGNUM.
           PERFORM 999-CATREAD  THRU  999-CATREAD-EXIT.
           MOVE MESSAGE-BUFFER          TO  UM-LIT.
           MOVE 19                      TO  LANG-MSGNUM.
           PERFORM 999-CATREAD  THRU  999-CATREAD-EXIT.
           MOVE MESSAGE-BUFFER          TO  QUANTITY-LIT.
           MOVE 22                      TO  LANG-MSGNUM.
           PERFORM 999-CATREAD  THRU  999-CATREAD-EXIT.
           MOVE MESSAGE-BUFFER          TO  REMARKS-LIT.
           MOVE 24                      TO  LANG-MSGNUM.
           PERFORM 999-CATREAD  THRU  999-CATREAD-EXIT.
           MOVE MESSAGE-BUFFER          TO  DATE-WANTED-LIT.
           MOVE 33                      TO  LANG-MSGNUM.
           PERFORM 999-CATREAD  THRU  999-CATREAD-EXIT.
           MOVE MESSAGE-BUFFER          TO  MORE-EXIST-LIT.
           MOVE 39                      TO  LANG-MSGNUM.
           PERFORM 999-CATREAD  THRU  999-CATREAD-EXIT.
           MOVE MESSAGE-BUFFER          TO  STR-UM-LIT.
           MOVE 40                      TO  LANG-MSGNUM.
           PERFORM 999-CATREAD  THRU  999-CATREAD-EXIT.
           MOVE MESSAGE-BUFFER          TO  ALT-UM1-LIT.
           MOVE 41                      TO  LANG-MSGNUM.
           PERFORM 999-CATREAD  THRU  999-CATREAD-EXIT.
           MOVE MESSAGE-BUFFER          TO  ALT-UM1-CONV-LIT.
           MOVE 42                      TO  LANG-MSGNUM.
           PERFORM 999-CATREAD  THRU  999-CATREAD-EXIT.
           MOVE MESSAGE-BUFFER          TO  ALT-UM2-LIT.
           MOVE 43                      TO  LANG-MSGNUM.
           PERFORM 999-CATREAD  THRU  999-CATREAD-EXIT.
           MOVE MESSAGE-BUFFER          TO  ALT-UM2-CONV-LIT.
           MOVE 44                      TO  LANG-MSGNUM.
           PERFORM 999-CATREAD  THRU  999-CATREAD-EXIT.
           MOVE MESSAGE-BUFFER          TO  LAST-ACT-LIT.
           MOVE 45                      TO  LANG-MSGNUM.
           PERFORM 999-CATREAD  THRU  999-CATREAD-EXIT.
           MOVE MESSAGE-BUFFER          TO  LAST-ISS-LIT.
           MOVE 46                      TO  LANG-MSGNUM.
           PERFORM 999-CATREAD  THRU  999-CATREAD-EXIT.
           MOVE MESSAGE-BUFFER          TO  TO-LIT.
           MOVE 47                      TO  LANG-MSGNUM.
           PERFORM 999-CATREAD  THRU  999-CATREAD-EXIT.
           MOVE MESSAGE-BUFFER          TO  ONHAND-LIT.
           MOVE 48                      TO  LANG-MSGNUM.
           PERFORM 999-CATREAD  THRU  999-CATREAD-EXIT.
           MOVE MESSAGE-BUFFER          TO  RESERVED-LIT.
           MOVE 49                      TO  LANG-MSGNUM.
           PERFORM 999-CATREAD  THRU  999-CATREAD-EXIT.
           MOVE MESSAGE-BUFFER          TO  AVG-ISS-LIT.
           MOVE 50                      TO  LANG-MSGNUM.
           PERFORM 999-CATREAD  THRU  999-CATREAD-EXIT.
           MOVE MESSAGE-BUFFER          TO  EOQ-LIT.
           MOVE 51                      TO  LANG-MSGNUM.
           PERFORM 999-CATREAD  THRU  999-CATREAD-EXIT.
           MOVE MESSAGE-BUFFER          TO  SOQ-LIT.
           MOVE 52                      TO  LANG-MSGNUM.
           PERFORM 999-CATREAD  THRU  999-CATREAD-EXIT.
           MOVE MESSAGE-BUFFER          TO  REORDER-LIT.
           MOVE 53                      TO  LANG-MSGNUM.
           PERFORM 999-CATREAD  THRU  999-CATREAD-EXIT.
           MOVE MESSAGE-BUFFER          TO  EXPEDITE-LIT.
           MOVE 54                      TO  LANG-MSGNUM.
           PERFORM 999-CATREAD  THRU  999-CATREAD-EXIT.
           MOVE MESSAGE-BUFFER          TO  MAXIMUM-LIT.
           MOVE 55                      TO  LANG-MSGNUM.
           PERFORM 999-CATREAD  THRU  999-CATREAD-EXIT.
           MOVE MESSAGE-BUFFER          TO  AVG-COST-LIT.
           MOVE 56                      TO  LANG-MSGNUM.
           PERFORM 999-CATREAD  THRU  999-CATREAD-EXIT.
           MOVE MESSAGE-BUFFER          TO  MKT-COST-LIT.
           MOVE 57                      TO  LANG-MSGNUM.
           PERFORM 999-CATREAD  THRU  999-CATREAD-EXIT.
           MOVE MESSAGE-BUFFER          TO  CLASSIF-LIT.
           MOVE 73                      TO  LANG-MSGNUM.
           PERFORM 999-CATREAD  THRU  999-CATREAD-EXIT.
           MOVE MESSAGE-BUFFER          TO  ONORDER-LIT.
           MOVE 74                      TO  LANG-MSGNUM.
           PERFORM 999-CATREAD  THRU  999-CATREAD-EXIT.
           MOVE MESSAGE-BUFFER          TO  REPAIR-REQ-LIT.
           MOVE 75                      TO  LANG-MSGNUM.
           PERFORM 999-CATREAD  THRU  999-CATREAD-EXIT.
           MOVE MESSAGE-BUFFER          TO  APPROVED-LIT.
           MOVE 76                      TO  LANG-MSGNUM.
           PERFORM 999-CATREAD  THRU  999-CATREAD-EXIT.
           MOVE MESSAGE-BUFFER          TO  NON-APPROVED-LIT.
           MOVE 81                      TO  LANG-MSGNUM.
           PERFORM 999-CATREAD  THRU  999-CATREAD-EXIT.
           MOVE MESSAGE-BUFFER          TO  STOREROOM-LIT.
           MOVE 83                      TO  LANG-MSGNUM.
           PERFORM 999-CATREAD  THRU  999-CATREAD-EXIT.
           MOVE MESSAGE-BUFFER          TO  WO-AMT-APPROVED-LIT.
           MOVE 84                      TO  LANG-MSGNUM.
           PERFORM 999-CATREAD  THRU  999-CATREAD-EXIT.
           MOVE MESSAGE-BUFFER          TO  WO-AMT-COMMITTED-LIT
           MOVE 85                      TO  LANG-MSGNUM.
           PERFORM 999-CATREAD  THRU  999-CATREAD-EXIT.
           MOVE MESSAGE-BUFFER          TO  WO-AMT-REQ-LIT.
           MOVE 86                      TO  LANG-MSGNUM.
           PERFORM 999-CATREAD  THRU  999-CATREAD-EXIT.
           MOVE MESSAGE-BUFFER          TO  WO-AMT-AVAIL-LIT.
           MOVE 87                      TO  LANG-MSGNUM.
           PERFORM 999-CATREAD  THRU  999-CATREAD-EXIT.
           MOVE MESSAGE-BUFFER          TO  REPAIR-COST-LIT.
           MOVE 89                      TO  LANG-MSGNUM.
           PERFORM 999-CATREAD  THRU  999-CATREAD-EXIT.
           MOVE MESSAGE-BUFFER          TO  MORE-DESC-LIT.
           MOVE 90                      TO  LANG-MSGNUM.
           PERFORM 999-CATREAD  THRU  999-CATREAD-EXIT.
           MOVE MESSAGE-BUFFER          TO  CODE-DATA-LIT.
           MOVE 102                     TO  LANG-MSGNUM.
           PERFORM 999-CATREAD  THRU  999-CATREAD-EXIT.
           MOVE MESSAGE-BUFFER          TO  APPROVE-LIT.
           MOVE 103                     TO  LANG-MSGNUM.
           PERFORM 999-CATREAD  THRU  999-CATREAD-EXIT.
           MOVE MESSAGE-BUFFER          TO  PMGR-LIT.
           MOVE 104                     TO  LANG-MSGNUM.
           PERFORM 999-CATREAD  THRU  999-CATREAD-EXIT.
           MOVE MESSAGE-BUFFER          TO  ENGR-LIT.
           MOVE 105                     TO  LANG-MSGNUM.
           PERFORM 999-CATREAD  THRU  999-CATREAD-EXIT.
           MOVE MESSAGE-BUFFER          TO  MGR1-LIT.
           MOVE 106                     TO  LANG-MSGNUM.
           PERFORM 999-CATREAD  THRU  999-CATREAD-EXIT.
           MOVE MESSAGE-BUFFER          TO  MGR2-LIT.
           MOVE 107                     TO  LANG-MSGNUM.
           PERFORM 999-CATREAD  THRU  999-CATREAD-EXIT.
           MOVE MESSAGE-BUFFER          TO  MGR3-LIT.

           CALL "CLWHO" USING USERNAME TERMNUM CURRLIB JOBLIBX.

       1-HSK-X.
           EXIT.

       2-BLOWUP.
           MOVE REQ-NUMBER              TO  BU-DISPLAY-FLD (1).
           MOVE CODE-ARG                TO  BU-DISPLAY-FLD (2).
           MOVE "CEAKICK"               TO  BU-DISPLAY-FLD (5).
           GOBACK.

       2-BLOWUP-X.
           EXIT.

      **************************************************
      *                                                *
      *   THIS PROCEDURE DOES THE ACTUAL PRINTING OF   *
      *   THE REQUISITION TO THE REQUESTED PRINTER     *
      *                                                *
      **************************************************

       6-WRITE-REQ.
           MOVE REQ-SPOOL-PRT           TO  OVRPRTF-TOFILE-NUM-X.
           MOVE 66                      TO  OVRPRTF-PAGESIZE.
           MOVE 60                      TO  OVRPRTF-OVRFLW.
           MOVE 6                       TO  OVRPRTF-LPI.
           PERFORM 996-OVERRIDE-PRINT-FILE.
           OPEN OUTPUT ONLINE-PRT.

           PERFORM 6100-LOAD-PRINT-FILES   THRU 6100-LPF-X.
           PERFORM 7000-LOAD-APPROVAL-PATH THRU 7090-LAP-X.

      *------- WRITE APPROVAL LINE.
           MOVE SPACES                  TO PRINT-LINE1
                                           PRINT-LINE.
           WRITE PRINT-RCD BEFORE ADVANCING 1 LINE.
           MOVE ALL "_"                 TO UNDERLINE-1   UNDERLINE-2
                                           UNDERLINE-3   UNDERLINE-4
                                           UNDERLINE-5.
           MOVE PMGR-LIT                TO PRT-PMGR-LIT.
           MOVE ENGR-LIT                TO PRT-ENGR-LIT.
           MOVE MGR1-LIT                TO PRT-MGR1-LIT.
           MOVE MGR2-LIT                TO PRT-MGR2-LIT.
           MOVE MGR3-LIT                TO PRT-MGR3-LIT.
           MOVE PRINT-APPRV-LINE        TO PRINT-LINE.
           WRITE PRINT-RCD BEFORE ADVANCING NEWPAGE.

           CLOSE ONLINE-PRT.

       6-WR-X.
           EXIT.

       65-PRINT-LINE.
           ADD LINE-ADV                 TO LINE-CTR.
           WRITE PRINT-RCD FROM PRINT-LINE1 BEFORE
               ADVANCING LINE-ADV.
           MOVE SPACES                  TO PRINT-LINE1.
           IF LINE-CTR > 79
               MOVE SPACES              TO PRINT-LINE
               WRITE PRINT-RCD BEFORE ADVANCING NEWPAGE
               MOVE 2                   TO LINE-ADV
               PERFORM 65-PRINT-HEADER-LINE.

       65-PRINT-HEADER-LINE.
           MOVE SPACES                  TO PRINT-LINE1.
           MOVE ZEROS                   TO LINE-CTR.
           MOVE REQ-NO-LIT              TO PRT-REQ-NO-LIT.
           MOVE REQ-NUMBER              TO REQ-NO-OUT.

      *************************************
      *  IF REPAIR REQ PRINT 'REPAIR' AT
      *  TOP OF REQ. INSTEAD OF 'PURCHASE'
      *************************************
           IF REQ-REPAIR-INDIC NOT = SPACE
               MOVE REPAIR-REQ-LIT      TO REQ-HEADER
           ELSE
               MOVE PURCHASE-REQ-LIT    TO REQ-HEADER.
           IF REQ-REPRINT-INDIC  =  "R"
               MOVE REPRINT-LIT         TO REQ-REPRINT-HEAD
           ELSE
               MOVE SPACES              TO REQ-REPRINT-HEAD.
           MOVE "-"                     TO PRT-DASH-1.
           IF REQ-MATCONT-RELEASE = "X"
               MOVE APPROVED-LIT        TO APPROVAL-LIT
           ELSE
               MOVE NON-APPROVED-LIT    TO APPROVAL-LIT.
           MOVE 1                       TO DATE-MODE.
           CALL "TDATECHK" USING DATE-CHECK-AREA.
           MOVE DATE-SLASH-OUT          TO TODAYS-DATE-OUT.
           PERFORM 65-PRINT-LINE.


      **************************************************
      *                                                *
      *   LOAD PRINT FILES FROM DATA FOUND IN MSTORERM *
      *   MREQ AND DREQITM                             *
      *                                                *
      **************************************************

       6100-LOAD-PRINT-FILES.
           MOVE ZEROS                   TO LINE-CTR.

           MOVE REQ-NUMBER              TO REQ-ARG.
           MOVE REQ-ARG TO REQNO OF MREQ-REC-I.
           READ MREQ-I INTO BUF-MREQ
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE "GET MREQ * 6100-LPF" TO BU-DISPLAY-MSG
               GO TO 2-BLOWUP.

           MOVE REQ-ARG TO REQNO OF DREQD-REC-I.
           START DREQD-I KEY = REQNO OF DREQD-REC-I
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS = "23"
               MOVE SPACES  TO  BUF-DREQD
               MOVE MREQ-NUMBER TO DREQD-REQ-NUMBER
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE "FIND DREQD * 6100-LPF"  TO  BU-DISPLAY-MSG
               GO TO 2-BLOWUP
           ELSE
               READ DREQD-I NEXT INTO BUF-DREQD
                   AT END MOVE FILE-STATUS TO FILE-STATUS
               END-READ
               IF FILE-STATUS NOT = "00" OR
                  REQNO OF DREQD-REC-I NOT = REQ-ARG
                  MOVE "GET DREQD * 6100-LPF"   TO  BU-DISPLAY-MSG
                  GO TO 2-BLOWUP.

           MOVE REQ-ARG TO REQNO OF DREQITM-REC-I.
           START DREQITM-I KEY = REQNO OF DREQITM-REC-I
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE "FIND DREQITM * 6100-LPF" TO BU-DISPLAY-MSG
               GO TO 2-BLOWUP.

           READ DREQITM-I NEXT INTO BUF-DREQITM
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00" OR
              REQNO OF DREQITM-REC-I NOT = REQ-ARG
               MOVE "DBGET DREQITM * 6110-LPF" TO BU-DISPLAY-MSG
               GO TO 2-BLOWUP.

           MOVE 1                       TO LINE-ADV.
           PERFORM 65-PRINT-HEADER-LINE.

           MOVE WO-NO-LIT               TO PRT-WO-NO-LIT
           IF DREQD-WO-NUMBER NOT = SPACES
               MOVE DREQD-WO-NUMBER     TO WO-NO-OUT
           ELSE
               MOVE SPACES              TO PRT-WO-NO-LIT
                                           WO-NO-OUT.

           MOVE STAG-LIT                TO PRT-STAG-LIT.
           MOVE REQ-STAGING-AREA        TO STAG-OUT.
           IF STAG-OUT = SPACES
               MOVE ALL "_"             TO STAG-OUT.
           MOVE REQ-DATE-LIT            TO PRT-REQ-DATE-LIT.
           IF REQ-SERVICE-FLAG = "S"
               MOVE "TYPE-SERVICE "     TO REQ-TYPE-LIT
           ELSE
               IF REQ-SERVICE-FLAG = "R"
                   MOVE "TYPE-REPAIR  " TO REQ-TYPE-LIT
               ELSE
                   MOVE "TYPE-MATERIAL" TO REQ-TYPE-LIT.
           MOVE DATE-FORMATTED-TIME-OUT TO TODAYS-TIME-OUT.
           MOVE DATE-YMD-OUT            TO SAVE-TODAYS-DATE.
           MOVE 4                       TO DATE-MODE.
           MOVE REQ-DATE                TO DATE-VALIDATE-IN.
           CALL "TDATECHK" USING DATE-CHECK-AREA.
           MOVE DATE-SLASH-OUT          TO REQ-DATE-OUT.
           MOVE 2                       TO LINE-ADV.
           PERFORM 65-PRINT-LINE.

           MOVE PO-NUM-LIT              TO PRT-PO-NUM-LIT.
           MOVE BUDGET-NO-LIT           TO PRT-BUDGET-NO-LIT.
           MOVE BUDGET-AMT-LIT          TO PRT-BUDGET-AMT-LIT.

           IF DREQD-PO-NUM-RLSE NOT = SPACES
               MOVE DREQD-PO-NUM-RLSE   TO PO-NUM-OUT
           ELSE
               MOVE ALL "_"             TO PO-NUM-OUT.
           IF REQ-BUDGET-NO NOT = SPACES
               MOVE REQ-BUDGET-NO       TO BUDGET-NO-OUT
           ELSE
               MOVE ALL "_"             TO BUDGET-NO-OUT.
           IF REQ-BUDGET-AMT > 0
               MOVE REQ-BUDGET-AMT      TO BUDGET-AMT-OUT
           ELSE
               MOVE ALL "_"             TO BUDGET-AMT-OUT-R.
           MOVE 1                       TO LINE-ADV.
           PERFORM 65-PRINT-LINE.

           MOVE ORIGIN-LIT              TO PRT-ORIGIN-LIT.
           IF REQ-MMIS-INDIC = SPACES  AND  REQ-MAT-TYPE = "S"
               MOVE STOREROOM-LIT       TO ORIGIN-OUT
           ELSE
               PERFORM 6150-GET-ORIGINATOR.
           IF ORIGIN-OUT = SPACES
               MOVE ALL "_"             TO ORIGIN-OUT.
           MOVE "-"                     TO ORIG-HYPHEN.

           IF REQITM-CORP-CODE = "NON-STR"
               MOVE SPACES TO BUF-MSTORERM
           ELSE
               MOVE REQITM-CORP-CODE  TO  CODE-ARG
               MOVE CODE-ARG TO CORPCDE OF MSTORERM-REC-I
               READ MSTORERM-I INTO BUF-MSTORERM
                   INVALID KEY MOVE FILE-STATUS TO FILE-STATUS
               END-READ
               IF FILE-STATUS NOT = "00"
                   MOVE "GET MSTORERM 6100-LPF" TO  BU-DISPLAY-MSG
                   GO TO 2-BLOWUP.

           MOVE QUANTITY-LIT            TO PRT-QUANTITY-LIT.
           MOVE REQITM-QTY-TO-ORD       TO QTY-OUT.
           MOVE REQITM-UM               TO QTY-UM-OUT.

           MOVE EST-COST-LIT            TO PRT-EST-COST-LIT.
           MOVE REQITM-UNIT-PRICE       TO EST-COST-OUT.
           IF REQITM-CORP-CODE = "NON-STR"
               NEXT SENTENCE
           ELSE
               IF REQITM-UNIT-PRICE  = ZEROS
                   MOVE STR-MKT-COST    TO EST-COST-OUT.
           MOVE 1                       TO LINE-ADV.
           PERFORM 65-PRINT-LINE.

           MOVE ALL "*"                 TO ASTERISK-LINE.
           MOVE 1                       TO LINE-ADV.
           PERFORM 65-PRINT-LINE.

      **********************************************************
      **  TIME TO DECIDE WHAT TYPE OF REQ DESCRIPTION TO PRINT *
      **********************************************************

           IF REQITM-CORP-CODE = "NON-STR"
               PERFORM 6200-LOAD-NON-CODED-DESC THRU  6200-LNCD-X
               PERFORM 6400-PRINT-DREQDESC      UNTIL
                (REQDESC-LINE-NO = "95" OR "96") OR (COND-WORD NOT = 0)
           ELSE
               MOVE CORP-CODE                TO CORP-CODE-OUT
               PERFORM 6300-LOAD-CODED-DESC  THRU  6300-LCD-X.

           MOVE REMARKS-LIT             TO PRT-REMARKS-LIT.
           MOVE 1                       TO LINE-ADV.
           PERFORM 65-PRINT-LINE.

      ********************************************
      **  IF FREE VERBAGE IS PASSED THEN THERE
      **  IS NO NEED TO CALL 'CREQREM'.  CREQREM
      **  GETS THE REMARKS FOR A REQUISITION.
      ********************************************

           IF REQ-FREE-VERBAGE = SPACES
               CALL "CREQREM" USING BASE,
                                    BASE-MMISA,
                                    STATUS-AREA,
                                    BUF-DREQD,
                                    REQ-STATUS,
                                    CREQREM-REMARKS,
                                    BU-DISPLAY-MSG
               IF BU-DISPLAY-MSG-1 NOT = SPACES
                   GO TO 2-BLOWUP
               ELSE
                   MOVE CREQREM-REMARK-1    TO REMARK-LINE-1
                   MOVE CREQREM-REMARK-2    TO SAVE-REMARK-LINE-2
           ELSE
               MOVE REQ-FREE-VERB-LINE (1)  TO REMARK-LINE-1
               MOVE REQ-FREE-VERB-LINE (2)  TO SAVE-REMARK-LINE-2.
           MOVE 1                       TO LINE-ADV.
           PERFORM 65-PRINT-LINE.

           MOVE SAVE-REMARK-LINE-2      TO REMARK-LINE-2.
           MOVE 1                       TO LINE-ADV.
           PERFORM 65-PRINT-LINE.

           MOVE ALL "-"                 TO DASH-LINE.
           MOVE 1                       TO LINE-ADV.
           PERFORM 65-PRINT-LINE.

           MOVE DATE-WANTED-LIT         TO PRT-DATE-WANTED-LIT.
           IF REQ-DATE-WANTED  = SPACES
               MOVE SPACES              TO DATE-WANTED-OUT
           ELSE
               MOVE 4                   TO DATE-MODE
               MOVE REQ-DATE-WANTED     TO DATE-VALIDATE-IN
               CALL "TDATECHK" USING DATE-CHECK-AREA
               MOVE DATE-SLASH-OUT      TO DATE-WANTED-OUT.
           MOVE EST-LT-LIT              TO PRT-EST-LT-LIT.
           IF REQITM-CORP-CODE = "NON-STR"
               NEXT SENTENCE
           ELSE
                MOVE STR-EST-LT         TO EST-LT-OUT.

           MOVE 1                       TO LINE-ADV.
           PERFORM 65-PRINT-LINE.

           IF REQ-MAT-TYPE = "S"
               PERFORM 6175-PRINT-CODED-DATA  THRU 6175-PCD-X.

       6100-LPF-X.
           EXIT.

       6150-GET-ORIGINATOR.
           MOVE REQ-ORIGINATOR              TO  EMPL-ARG.
           MOVE EMPL-ARG                    TO PERCCNUM
                                            OF PERSONNEL-REC-I.
           READ PERSONNEL-I INTO BUF-PER-PERSONNEL
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS = "00"
               MOVE PER-EMP-NAME            TO ORIGIN-OUT
           ELSE
               IF FILE-STATUS-1 = "2"
                   MOVE REQ-ORIGINATOR      TO ORIGIN-OUT
           ELSE
               MOVE "DBGET ERR PERSONNEL 6150-GO" TO BU-DISPLAY-MSG
               GO TO 2-BLOWUP.

      ************************************************
      *  PRINT MSTORERM DATA RELATED TO CODED ITEM   *
      ************************************************
       6175-PRINT-CODED-DATA.
           MOVE 1                       TO LINE-ADV.
           MOVE CODE-DATA-LIT           TO PRT-CODE-DATA-LIT.
           PERFORM 65-PRINT-LINE.

           MOVE STR-UM-LIT              TO PRT-STR-UM-LIT.
           MOVE STR-UM                  TO PRT-STR-UM.
           MOVE ONHAND-LIT              TO PRT-ONHAND-LIT.
           MOVE STR-ONHAND              TO PRT-ONHAND.
           MOVE AVG-ISS-LIT             TO PRT-AVG-ISS-LIT.
           MOVE STR-MTH-FCST            TO PRT-AVG-ISS.
           PERFORM 65-PRINT-LINE.

           MOVE ALT-UM1-LIT             TO PRT-ALT-UM1-LIT.
           MOVE STR-UM1                 TO PRT-ALT-UM1.
           MOVE RESERVED-LIT            TO PRT-RESERVED-LIT.
           MOVE STR-RESERVED            TO PRT-RESV.
           MOVE AVG-COST-LIT            TO PRT-AVG-COST-LIT.
           MOVE STR-AVG-COST            TO PRT-AVG-COST.
           PERFORM 65-PRINT-LINE.

           MOVE ALT-UM1-CONV-LIT        TO PRT-ALT-UM1-CONV-LIT.
           MOVE STR-UM1-CF              TO PRT-UM1-CONV.
           MOVE ONORDER-LIT             TO PRT-ONORDER-LIT.
           MOVE "Y"                     TO SONORDER-CALC-DIR-ORD-SW.
           MOVE REQ-COMPANY-SAVE        TO COMPANY-SAVE.
           CALL "SONORDER" USING BASE,
                                 CODE-ARG,
                                 SONORDER-PARMS,
                                 COMPANY-SAVE,
                                 STATUS-AREA,
                                 BU-DISPLAY-MSG,
                                 BU-DISPLAY-FLDS.
           IF BU-DISPLAY-MSG NOT = SPACES
               GO TO 2-BLOWUP.
           MOVE SONORDER-TOTAL-ONORDER  TO PRT-ONORDER.
           MOVE MKT-COST-LIT            TO PRT-MKT-COST-LIT.
           MOVE STR-MKT-COST            TO PRT-MKT-COST.
           PERFORM 65-PRINT-LINE.

           MOVE ALT-UM2-LIT             TO PRT-ALT-UM2-LIT.
           MOVE STR-UM2                 TO PRT-ALT-UM2.
           MOVE EOQ-LIT                 TO PRT-EOQ-LIT.
           MOVE STR-EOQ                 TO PRT-EOQ.
           MOVE REPAIR-COST-LIT         TO PRT-REPAIR-COST-LIT.
           MOVE STR-OUT-REPAIR-COST     TO PRT-REPAIR-COST.
           PERFORM 65-PRINT-LINE.

           MOVE ALT-UM2-CONV-LIT        TO PRT-ALT-UM2-CONV-LIT.
           MOVE STR-UM2-CF              TO PRT-UM2-CONV.
           MOVE SOQ-LIT                 TO PRT-SOQ-LIT.
           MOVE STR-SOQ                 TO PRT-SOQ.
           MOVE CLASSIF-LIT             TO PRT-CLASSIF-LIT.
           PERFORM 65-PRINT-LINE.

           MOVE LAST-ACT-LIT            TO PRT-LAST-ACT-LIT.
           IF STR-ACT-DATE  =  SPACES
               MOVE SPACES              TO PRT-LAST-ACT-DATE
           ELSE
               MOVE 4                   TO DATE-MODE
               MOVE STR-ACT-DATE        TO DATE-VALIDATE-IN
               CALL "TDATECHK" USING DATE-CHECK-AREA
               MOVE DATE-SLASH-OUT      TO PRT-LAST-ACT-DATE.
           MOVE MAXIMUM-LIT             TO PRT-MAXIMUM-LIT.
           MOVE STR-MAX                 TO PRT-MAXIMUM.
           MOVE STR-INS-ITM             TO PRT-INS.
           MOVE STR-ORD-ENG             TO PRT-OE.
           MOVE STR-MAINT               TO PRT-MR.
           MOVE STR-OUT-REP             TO PRT-OR.
           MOVE STR-IMPORT-IND          TO PRT-IMP.
           MOVE STR-STOCK-OT            TO PRT-STOCK-OT.
           MOVE STR-CONS-IND            TO PRT-CO.
           PERFORM 65-PRINT-LINE.

           MOVE LAST-ISS-LIT            TO PRT-LAST-ISS-LIT.
           IF STR-LAST-IDATE  =  SPACES
               MOVE SPACES              TO PRT-LAST-ISS-DATE
           ELSE
               MOVE 4                   TO DATE-MODE
               MOVE STR-LAST-IDATE      TO DATE-VALIDATE-IN
               CALL "TDATECHK" USING DATE-CHECK-AREA
               MOVE DATE-SLASH-OUT      TO PRT-LAST-ISS-DATE.
           MOVE REORDER-LIT             TO PRT-REORDER-LIT.
           MOVE STR-REORDER             TO PRT-REORDER.
           PERFORM 65-PRINT-LINE.

           MOVE TO-LIT                  TO PRT-TO-LIT.
           MOVE STR-LAST-CHARGE         TO PRT-ISS-DEPT.
           MOVE EXPEDITE-LIT            TO PRT-EXPEDITE-LIT.
           MOVE STR-EXPEDITE            TO PRT-EXPEDITE.
           PERFORM 65-PRINT-LINE.

       6175-PCD-X.
           EXIT.

       6200-LOAD-NON-CODED-DESC.
           MOVE 1       TO  LINE-ADV.
           PERFORM 65-PRINT-LINE.
           MOVE REQ-ARG TO REQNO OF DREQDESC-REC-I.
           START DREQDESC-I KEY = REQNO OF DREQDESC-REC-I
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
                   NEXT SENTENCE
               ELSE
                   MOVE "FIND DREQDESC * 6200-LNCD" TO BU-DISPLAY-MSG
                   GO TO 2-BLOWUP.

       6250-GET-DREQDESC.
           PERFORM 6600-GET-DREQDESC.
           IF COND-WORD = 15
               MOVE SPACES   TO  BUF-DREQDESC.

      *********************************************
      **  REMARKS ARE STORED IN  LINES 95 AND 96
      **  SO DONT PRINT THOSE IN THE DESC. AREA
      *********************************************
           IF REQDESC-LINE-NO = "95" OR "96"
               GO TO 6250-GET-DREQDESC.

           IF REQDESC-DATA NOT = SPACES
               MOVE REQDESC-DATA        TO DESC-LINE-1
               PERFORM 65-PRINT-LINE.

       6200-LNCD-X.
           EXIT.


       6300-LOAD-CODED-DESC.
      **************************************************
      *  CALL 'CDESC' TO PRINT CODE DESCRIPTION        *
      *   GET ONLY SELECTED MANUFACTURERS    (but why?)*
      **************************************************
           MOVE "S"        TO CDESC-MANUFACT-OPTION.
           MOVE 8          TO CDESC-LINES-TO-GET.
           CALL "CDESC" USING RET-CODE,
                              BASE,
                              STATUS-AREA,
                              BU-DISPLAY-MSG,
                              CODE-ARG,
                              CDESC-DATA.
           IF BU-DISPLAY-MSG-1  NOT = SPACES
               GO TO 2-BLOWUP.

           MOVE CDESC (1)           TO KEYWORD-ADJ-OUT.
           MOVE 1                   TO LINE-ADV.
           PERFORM 65-PRINT-LINE.

           IF CDESC-LINES-GOT >= 2
               MOVE CDESC (2)           TO DESC-LINE-1
           ELSE
               MOVE SPACES              TO DESC-LINE-1.
           PERFORM 65-PRINT-LINE.

           IF CDESC-LINES-GOT >= 3
               MOVE CDESC (3)           TO DESC-LINE-1
           ELSE
               MOVE SPACES              TO DESC-LINE-1.
           MOVE 1                       TO LINE-ADV.
           PERFORM 65-PRINT-LINE.

           IF CDESC-LINES-GOT >= 4
               MOVE CDESC (4)           TO DESC-LINE-1
           ELSE
               MOVE SPACES              TO DESC-LINE-1.
           MOVE 1                       TO LINE-ADV.
           PERFORM 65-PRINT-LINE.

           IF CDESC-LINES-GOT >= 5
               MOVE CDESC (5)           TO DESC-LINE-1
           ELSE
               MOVE SPACES              TO DESC-LINE-1.
           MOVE 1                       TO LINE-ADV.
           PERFORM 65-PRINT-LINE.

           IF CDESC-LINES-GOT > 6
               MOVE MORE-DESC-LIT       TO DESC-LINE-1
           ELSE
               IF CDESC-LINES-GOT = 6
                   MOVE CDESC (6)       TO DESC-LINE-1
           ELSE
               MOVE SPACES              TO DESC-LINE-1.
           PERFORM 65-PRINT-LINE.

       6300-LCD-X.
           EXIT.

       6400-PRINT-DREQDESC.
           PERFORM 6600-GET-DREQDESC.

           IF REQDESC-DATA = SPACES
               NEXT SENTENCE
           ELSE
               MOVE REQDESC-DATA        TO DESC-LINE-1
               MOVE 1                   TO LINE-ADV
               PERFORM 65-PRINT-LINE.

       6400-PD-X.
           EXIT.

       6600-GET-DREQDESC.
           MOVE 0 TO COND-WORD.
           READ DREQDESC-I NEXT INTO BUF-DREQDESC
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   MOVE 15 TO COND-WORD
                   MOVE SPACES   TO  BUF-DREQDESC
               ELSE
                   MOVE "DBGET DREQDESC * 6600-GD" TO BU-DISPLAY-MSG
                   GO TO 2-BLOWUP.
           IF REQNO OF DREQDESC-REC-I NOT = REQ-ARG
               MOVE SPACES       TO  BUF-DREQDESC
               MOVE 15 TO COND-WORD.

      *********************************************
      *  START OF LOGIC TO GET APPROVAL PATHS     *
      *********************************************

       7000-LOAD-APPROVAL-PATH.
           MOVE ALL "-"                  TO DASH-LINE.
           MOVE 1                        TO LINE-ADV.
           PERFORM 65-PRINT-LINE.

           MOVE PRINT-PATH-HEADER        TO PRINT-LINE1.
           MOVE 1                        TO LINE-ADV.
           PERFORM 65-PRINT-LINE.
           PERFORM 7100-DBFIND.
           IF NOT GOOD-CALL
               GO TO 7090-LAP-X.

       7010-GET-DREQQUE-LOOP.
           MOVE 0                TO COND-WORD.
           READ DREQQUE-I NEXT INTO BUF-DREQQUE
               AT END MOVE 15 TO COND-WORD.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   MOVE 15 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.
           IF REQNO OF DREQQUE-REC-I NOT = MREQ-NUMBER
               MOVE 15 TO COND-WORD.
           IF END-OF-CHAIN
               GO TO 7090-LAP-X
           ELSE
           IF NOT GOOD-CALL
               MOVE "DBGET ERR DREQQUE 7010-LOOP" TO BU-DISPLAY-MSG
               PERFORM 2-BLOWUP.

           MOVE DRQQ-LEVEL-NUM           TO PRT-APP-LEVEL.
           MOVE 4                        TO DATE-MODE.
           MOVE DRQQ-APPROVE-DATE        TO DATE-VALIDATE-IN.
           CALL "TDATECHK" USING DATE-CHECK-AREA.
           MOVE DATE-SLASH-OUT           TO PRT-APP-DATE.
           MOVE DRQQ-QUEUED-DATE         TO DATE-VALIDATE-IN.
           CALL "TDATECHK" USING DATE-CHECK-AREA.
           MOVE DATE-SLASH-OUT           TO PRT-QUE-DATE.
           MOVE DRQQ-EMPL-QUEUED         TO PRT-APP-EMPL.
           PERFORM 7200-GET-EMPLOYEE-MMIS.
           MOVE PER-EMP-NAME             TO PRT-APP-EMPL-NAME.
           MOVE DRQQ-COMMENT-1           TO PRT-APP-COMMENT.
           MOVE 1                        TO LINE-ADV.
           PERFORM 65-PRINT-LINE.

           GO TO 7010-GET-DREQQUE-LOOP.

       7090-LAP-X.
           EXIT.

       7100-DBFIND.
      *------ IN CASE REQ FROM REQ INQUIRY WAS DELETED BY SOMEONE ELSE,
      *------ EXIT FROM THE INQUIRY WITHOUT DOING ANYTHING
           MOVE 0             TO COND-WORD.
           MOVE MREQ-NUMBER   TO REQNO OF DREQQUE-REC-I.
           START DREQQUE-I KEY = REQNO OF DREQQUE-REC-I
               INVALID KEY MOVE 0 TO COND-WORD.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
                   MOVE 0 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.
           IF NO-ENTRY
               NEXT SENTENCE
           ELSE
           IF NOT GOOD-CALL
               MOVE "DBFIND ERR DREQQUE 7100-D" TO BU-DISPLAY-MSG
               PERFORM 2-BLOWUP.


       7200-GET-EMPLOYEE-MMIS.
           MOVE DRQQ-EMPL-QUEUED         TO EMPL-ARG.
           MOVE EMPL-ARG                 TO PERCCNUM
                                         OF PERSONNEL-REC-I.
           READ PERSONNEL-I INTO BUF-PER-PERSONNEL
               INVALID KEY MOVE 17 TO COND-WORD.
           IF FILE-STATUS-1 = "2"
               MOVE "UNKNOWN EMPLOYEE "  TO PER-EMP-NAME
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE "DBGET ERR PERSONNEL 7200-GEM" TO BU-DISPLAY-MSG
               PERFORM 2-BLOWUP.

      *********************************************
      *    END OF LOGIC TO GET APPROVAL PATHS     *
      *********************************************

       COPY OVRPFCALL IN COPYLIB.

       999-CATREAD.
           IF CATREAD-MSG-NUMBER = ZEROS
               MOVE LANG-SETNUM TO CATREAD-MSG-SET
               MOVE LANG-MSGNUM TO CATREAD-MSG-NUM.
           CALL "CCATREAD" USING CATREAD-PARMS.
           MOVE CATREAD-MSG-TEXT TO MESSAGE-BUFFER.
       999-CATREAD-EXIT.
           EXIT.

