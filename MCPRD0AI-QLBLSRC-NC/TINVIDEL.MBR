010000
010100 01  DE-BUFFER1.
010200     05  DE1-PO-RLSE.
010300         10  DE1-PO            PIC X(7).
010400         10  DE1-RLSE          PIC X(3).
010500     05  DE1-INV-NUM           PIC X(14).
010600     05  DE1-REG-NUM           PIC ZZZZ9.
010700     05  DE1-ITEM-INFORMATION.
010800         10  DE1-ITEM-NO       PIC ZZZ9.
010900         10  DE1-CORPCODE      PIC X(7).
011000         10  DE1-PO-UNPD-QTY   PIC -(8)9.9(4).
011100         10  DE1-PO-UM         PIC X(2).
011200         10  DE1-PO-UPRICE     PIC -(11)9.9(4).
011300         10  DE1-PO-ITEM-EXT   PIC -(11)9.9(4).
011400         10  DE1-INV-UNPD-QTY  PIC -(8)9.9(4).
011500         10  DE1-INV-UM        PIC X(2).
011600         10  DE1-INV-UPRICE    PIC -(11)9.9(4).
011700         10  DE1-INV-ITEM-EXT  PIC -(11)9.9(4).
011800         10  DE1-MEMO-QTY-MSG-LINE   PIC X(70).
011900         10  DE1-DESC-TABLE.
012000             15  DE1-DESC-LINE  OCCURS  4  TIMES
012100                               PIC X(79).
012200         10  DE1-ACCOUNTING-TABLE  OCCURS  5  TIMES.
012300             15  DE1-ACCTG-ENTRY.
012400                 20  DE1-PRIME     PIC X(3).
012500                 20  DE1-SUB       PIC X(3).
012600                 20  DE1-SUBD      PIC X(4).
012700                 20  DE1-ADDL-DATA PIC X(6).
012800             15  DE1-PERCENT       PIC ZZ9.99.
012900      05  DE1-COMMAND-LINE         PIC X(79).
013000      05  DE1-MSG-LINE             PIC X(79).
