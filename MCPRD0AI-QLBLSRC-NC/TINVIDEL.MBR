019400
019500 LINKAGE SECTION.
019600
019700 01  BASE                      PIC X(10).
019900 01  SUB-ERROR-SW              PIC X.
020100 COPY VCOMLINK   IN COPYLIB.
020300*01  SCREEN-PRINT-PARMS.
020400*    05  PRINT-CTL             PIC S9(4)    COMP.
020500*    05  PAGE-CTL              PIC S9(4)    COMP.
020600*    05  SPOOLFIL-OPEN-SW      PIC X.
020700*
020800*01  PASS-SPOOL-PRT-NO         PIC S9(2)    COMP.
021000 01  MAIN-ITEM-NUMBER          PIC 9(4).
021200 01  ARGUMENT-VALUES.
021300     05  PLT-ARG               PIC X(4).
021400     05  PO-ARG                PIC X(14).
021500     05  VEN-ARG.
021600         10  VEN-ARG1-7        PIC X(7).
021700         10  VEN-ARG8-10       PIC X(3).
021800     05  CODE-ARG              PIC X(8).
021900     05  REGISTER-ARG          PIC X(6).
022100 COPY DINVRCD   IN COPYLIB.
022300 COPY LANGSUB   IN COPYLIB.
       01  MESSAGE-BUFFER            PIC X(72).
       01  FIELD-NUMBER              PIC S9(4) COMP.

022800 PROCEDURE DIVISION USING  BASE,
022900                           SUB-ERROR-SW,
023000                           VIEW-COMAREA,
023100*                          SCREEN-PRINT-PARMS,
023200*                          PASS-SPOOL-PRT-NO,
023300                           MAIN-ITEM-NUMBER,
023400                           ARGUMENT-VALUES,
023500                           BUF-DINVRCD,
023600                           LANGUAGE-PARMS,
                                 MESSAGE-BUFFER,
                                 FIELD-NUMBER.
023700
023800
023900 DELETE-ITEM SECTION 03.
024000     OPEN INPUT DINVITM-I, DINVACCT-I.
           OPEN I-O   DINVITM-O, DINVACCT-O, DISPLAY-FILE.
024100     PERFORM  6-DELETE-ITEM  THRU  6-DELETE-ITEM-X.
           CLOSE DINVITM-I, DINVITM-O, DINVACCT-I, DINVACCT-O,
                 DISPLAY-FILE.
024200     GOBACK.
024300
024400 2-BLOWUP.
024500     MOVE REGISTER-ARG     TO  BU-DISPLAY-FLD (1).
024600     MOVE "TINVIDEL"       TO  BU-PGM-NAME.
024700     CALL "TBLOWUP" USING BASE, BU-PGM-NAME, STATUS-AREA,
024800         VIEW-COMAREA, FILE-STATUS, BU-DISPLAY-MSG,
024900                 BU-DISPLAY-FLDS.
025000
025100 2-BLOWUP-X.
025200     EXIT.
025300
025400
025500 6-DELETE-ITEM.
025600     MOVE SPACE            TO  DE-BUFFER1.
025700     MOVE INV-PO-NO        TO  DE1-PO.
025800     MOVE INV-RLSE         TO  DE1-RLSE.
025900     MOVE INV-NO           TO  DE1-INV-NUM.
026000     MOVE INV-REG-NO-9     TO  DE1-REG-NUM.
026100
026200 6-FIND-DINVITM.
026300     MOVE INV-REG-NO    TO  REGISTER-ARG.
           MOVE REGISTER-ARG TO REGISTERNO OF DINVITM-I-REC.
           MOVE MAIN-ITEM-NUMBER TO ITEMNO OF DINVITM-I-REC.
           READ DINVITM-I INTO BUF-DINVITM
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
028400             MOVE "Y"  TO  SUB-ERROR-SW
028500             MOVE 12   TO  FIELD-NUMBER
028600*            ***  ITEM NUMBER DOES NOT EXIST ON THIS INVOICE  ***
028700             MOVE   9 TO LANG-SETNUM
028800             MOVE  45 TO LANG-MSGNUM
028900             PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
029100             GO TO  6-DELETE-ITEM-X
               ELSE
027100         MOVE "READ DINVITM*6-FD"  TO  BU-DISPLAY-MSG
027200         GO TO  2-BLOWUP.

030200     MOVE INVITM-ITEM-NO       TO  DE1-ITEM-NO.
030300     MOVE INVITM-CORPCODE      TO  DE1-CORPCODE,
030400                                   CODE-ARG.
030500     MOVE INVITM-INV-QTY-PD    TO  DE1-INV-UNPD-QTY.
030600     MOVE INVITM-PO-UM         TO  DE1-PO-UM,
030700                                   DE1-INV-UM.
030800     MOVE INVITM-INV-UPRICE    TO  DE1-INV-UPRICE.
030900     IF INVITM-INV-QTY-PD = ZEROS
031000         MOVE INVITM-INV-UPRICE TO  DE1-INV-ITEM-EXT
031100     ELSE
031200         MULTIPLY INVITM-INV-QTY-PD  BY  INVITM-INV-UPRICE
031300             GIVING CALC-INV-EXT  ROUNDED
031400         MOVE CALC-INV-EXT      TO  DE1-INV-ITEM-EXT.
031500     IF INVITM-MEMO-INDIC = "X"
031600* *** THIS ITEM QUANTITY IS A MEMO QUANTITY (QUANTITY PAID IS
031700*     NOT UPDATED) ***
031800         MOVE  20 TO LANG-SETNUM
031900         MOVE  13 TO LANG-MSGNUM
032000         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
032100         MOVE MESSAGE-BUFFER TO DE1-MEMO-QTY-MSG-LINE.
032200
032300     MOVE INVITM-PO-QTY-PD      TO  DE1-PO-UNPD-QTY.
032400     MOVE INVITM-PO-UPRICE      TO  DE1-PO-UPRICE.
032500     IF INVITM-PO-QTY-PD = ZEROS
032600         MOVE INVITM-PO-UPRICE  TO  DE1-PO-ITEM-EXT
032700     ELSE
032800         MULTIPLY INVITM-PO-QTY-PD  BY  INVITM-PO-UPRICE
032900             GIVING CALC-PO-EXT  ROUNDED
033000         MOVE CALC-PO-EXT       TO  DE1-PO-ITEM-EXT.
033100
033200 6-FIND-DINVACCT.
           MOVE REGISTER-ARG TO REGISTERNO OF DINVACCT-I-REC.
           START DINVACCT-I KEY = REGISTERNO OF DINVACCT-I-REC
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
                   GO TO 6-TYPE-OF-CODE
               ELSE
034000         MOVE "DBFIND DINVACCT*6-FD"  TO  BU-DISPLAY-MSG
034100         GO TO  2-BLOWUP.
034200
034300     MOVE ZERO  TO  ACCT-SUB.
034400
034500 6-GET-DINVACCT-LOOP.
           READ DINVACCT-I NEXT INTO BUF-DINVACCT
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   GO TO 6-TYPE-OF-CODE
               ELSE
035700             MOVE "DBGET5 DINVACCT*6-GDL"  TO  BU-DISPLAY-MSG
035800             GO TO  2-BLOWUP.
           IF REGISTERNO OF DINVACCT-I-REC NOT = REGISTER-ARG
               GO TO 6-TYPE-OF-CODE.
035900
036000     IF MAIN-ITEM-NUMBER = INVACCT-ITEM
036100         NEXT SENTENCE
036200     ELSE
036300         GO TO  6-GET-DINVACCT-LOOP.
036400
036500     ADD +1  TO  ACCT-SUB.
036600     MOVE INVACCT-PRIME      TO  DE1-PRIME (ACCT-SUB).
036700     MOVE INVACCT-SUB        TO  DE1-SUB (ACCT-SUB).
036800     MOVE INVACCT-SUBD       TO  DE1-SUBD (ACCT-SUB).
036900     MOVE INVACCT-ADDL-DATA  TO  DE1-ADDL-DATA (ACCT-SUB).
037000     MOVE INVACCT-PCT        TO  DE1-PERCENT (ACCT-SUB).
037100     GO TO  6-GET-DINVACCT-LOOP.
037200
037300 6-TYPE-OF-CODE.
037400     IF INVITM-CORPCODE = "NON-STR"
037500         PERFORM 61-GET-NONCODED-DESC  THRU  61-GND-X
037600     ELSE
037700         PERFORM 61-GET-CODED-DESC  THRU  61-GCD-X.
037800
037900
038000 6C-FILLBUFF1-CONT.
038100     MOVE ITEMS  TO  VIEW-NFNAME.
040200
040300 6C-SHOWFORM1.
           MOVE DE-BUFFER1 TO DISPLAY-REC.
           PERFORM 998-WRITE-SCREEN THRU 998-READ-SCREEN.
           MOVE DISPLAY-REC   TO DE-BUFFER1.
042700     IF VIEW-LASTKEY = 3
042800         GO TO 6-DELETE-ITEM-X
042900     ELSE
043900     IF VIEW-LASTKEY = 1  OR
044000        VIEW-LASTKEY = 2  OR
044100        VIEW-LASTKEY = 3  OR
044200        VIEW-LASTKEY = 4  OR
              VIEW-LASTKEY = 5  OR
044300        VIEW-LASTKEY = 6  OR
044400        VIEW-LASTKEY = 7
044500*        ***  INVALID FUNCTION KEY ENTERED  ***
044600         MOVE   9 TO LANG-SETNUM
044700         MOVE  10 TO LANG-MSGNUM
044800         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER TO DE1-MSG-LINE
               MOVE B"1" TO IND(99)
045000         GO TO  6C-SHOWFORM1.
045100
045200 6C-LOCK3.
026300     MOVE INV-REG-NO    TO  REGISTER-ARG.
           MOVE REGISTER-ARG TO REGISTERNO OF DINVITM-O-REC.
           MOVE MAIN-ITEM-NUMBER TO ITEMNO OF DINVITM-O-REC.
           READ DINVITM-O INTO BUF-DINVITM
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS = "00"
               DELETE DINVITM-O
                  INVALID KEY MOVE FILE-STATUS TO FILE-STATUS
               END-DELETE
               IF FILE-STATUS NOT = "00"
                   MOVE "DELETE DINVITM*6C-DDL" TO BU-DISPLAY-MSG
                   GO TO 2-BLOWUP.

026300     MOVE INV-REG-NO    TO  REGISTER-ARG.
           MOVE REGISTER-ARG TO REGISTERNO OF DINVACCT-O-REC.
           START DINVACCT-O KEY = REGISTERNO OF DINVACCT-O-REC
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
                   GO TO 6-DELETE-ITEM-X
               ELSE
               MOVE "START DINVACCT*6C-DDL" TO BU-DISPLAY-MSG
               GO TO 2-BLOWUP.

050700 6C-DELETE-DINVACCT-LOOP.
           READ DINVACCT-O NEXT INTO BUF-DINVACCT
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   GO TO 6-DELETE-ITEM-X
               ELSE
                   MOVE "READ DINVACCT*6C-DDL" TO BU-DISPLAY-MSG
                   GO TO 2-BLOWUP.
           IF REGISTERNO OF DINVACCT-O-REC NOT = REGISTER-ARG
               GO TO 6-DELETE-ITEM-X.

052200     IF MAIN-ITEM-NUMBER = INVACCT-ITEM
               DELETE DINVACCT-O
                  INVALID KEY MOVE FILE-STATUS TO FILE-STATUS
               END-DELETE
052900         IF FILE-STATUS NOT = "00"
053000             MOVE "DBDELETE DINVACCT*6C-DDL"  TO  BU-DISPLAY-MSG
053100             GO TO  2-BLOWUP
               ELSE
                   NEXT SENTENCE
053200     ELSE
053300     IF MAIN-ITEM-NUMBER < INVACCT-ITEM
053400         GO TO 6-DELETE-ITEM-X.
053500
053600     GO TO  6C-DELETE-DINVACCT-LOOP.
053800
055500 6-DELETE-ITEM-X.
055600     EXIT.
055700
055800 61-GET-CODED-DESC.
055900**************************************************
056000**  CALL CDESC FOR DESCRIPTION LINES. (CODED)   **
056100**************************************************
056200     MOVE 4                       TO  CDESC-LINES-TO-GET.
056300     CALL "CDESC" USING RET-CODE,
056400                        BASE,
056500                        STATUS-AREA,
056600                        BU-DISPLAY-MSG,
056700                        CODE-ARG,
056800                        CDESC-DATA.
056900     IF BU-DISPLAY-MSG-1  NOT = SPACES
057000         MOVE CODE-ARG            TO  BU-DISPLAY-FLD (4)
057100         GO TO 2-BLOWUP.
057200
057300     IF CDESC-LINES-GOT  =  0
057400*        *** NO DESCRIPTION ON FILE ***
057500         MOVE  14 TO LANG-SETNUM
057600         MOVE   3 TO LANG-MSGNUM
057700         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
057800         MOVE MESSAGE-BUFFER TO DE1-DESC-LINE (1)
057900         GO TO  61-GCD-X.
058000
058100     MOVE ZEROS                   TO  DESC-SUB.
058200
058300 61-GET-DESC-LOOP.
058400     ADD 1                        TO  DESC-SUB.
058500     IF DESC-SUB > CDESC-LINES-GOT  OR
058600        DESC-SUB > 4
058700         GO TO 61-GCD-X.
058800
058900     MOVE CDESC (DESC-SUB)        TO  DE1-DESC-LINE (DESC-SUB).
059000     GO TO 61-GET-DESC-LOOP.
059100
059200 61-GCD-X.
059300     EXIT.
059400
059500 61-GET-NONCODED-DESC.
059600     MOVE 4                       TO  CNDESC-LINES-TO-GET.
059700     MOVE 0                       TO  CNDESC-LINES-GOT.
059800     CALL "CNDESC" USING BASE, PO-ARG, INVITM-ITEM-NO,
059900         CNDESC-DATA.
060000
060100     IF CNDESC-LINES-GOT  =  0
060200*        *** NO DESCRIPTION ON FILE ***
060300         MOVE  14 TO LANG-SETNUM
060400         MOVE   3 TO LANG-MSGNUM
060500         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
060600         MOVE MESSAGE-BUFFER TO DE1-DESC-LINE (1)
060700         GO TO  61-GND-X.
060800
060900     MOVE ZEROS                   TO  DESC-SUB.
061000
061100 61-GET-NONCODED-LOOP.
061200     ADD 1                        TO  DESC-SUB.
061300     IF DESC-SUB > CNDESC-LINES-GOT  OR
061400        DESC-SUB > 4
061500         GO TO 61-GND-X.
061600
061700     MOVE CNDESC (DESC-SUB)       TO  DE1-DESC-LINE (DESC-SUB).
061800     GO TO 61-GET-NONCODED-LOOP.
061900
062000 61-GND-X.
062100     EXIT.
062200
062300 COPY DISPCALL IN COPYLIB.
069000 999-CATREAD.
           IF CATREAD-MSG-NUMBER = ZEROS
               MOVE LANG-SETNUM TO CATREAD-MSG-SET
               MOVE LANG-MSGNUM TO CATREAD-MSG-NUM.
           CALL "CCATREAD" USING CATREAD-PARMS.
           MOVE CATREAD-MSG-TEXT TO MESSAGE-BUFFER.
070600 999-CATREAD-EXIT.
070700     EXIT.
