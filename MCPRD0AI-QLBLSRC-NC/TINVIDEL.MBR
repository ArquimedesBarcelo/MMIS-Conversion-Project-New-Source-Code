000200 IDENTIFICATION DIVISION.
000300 PROGRAM-ID.    TINVIDEL.
000400 AUTHOR.        KURT MOVSESIAN.
000600 INSTALLATION.  GOODYEAR TIRE AND RUBBER CO.
000500 DATE-WRITTEN.  JUNE 22, 1985.
000700
000800*REMARKS.         INVOICE PROCESSING.
001000**************************************************************
001100*                                                            *
001200*   T I N V I D E L                                          *
001300*                                                            *
001400*   THIS SUB PROGRAM DELETES AN ITEM OFF AN INVOICE.         *
001500*   THE INVOICE MUST BE ON HOLD BEFORE THIS PROGRAM          *
001600*   WILL DO THE ITEM DELETE.                                 *
001700*                                                            *
001800**************************************************************
001900*   N O T E    T H I S   S U B R O U T I N E   I S           *
002000*         C A L L E D    B Y :                               *
002100*      1. TINVMOD.SOURCE - INVOICE MODICATION                *
002200**************************************************************
003600
003700 ENVIRONMENT DIVISION.
003800 CONFIGURATION SECTION.
003900 SOURCE-COMPUTER.    HP-3000.
004000 OBJECT-COMPUTER.    HP-3000.
       SPECIAL-NAMES.  I-O-FEEDBACK IS I-O-FEEDBACK-AREA.
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT DISPLAY-FILE
                  ASSIGN TO WORKSTATION-ZINVOICE-SI
                  ORGANIZATION IS TRANSACTION
                  ACCESS IS SEQUENTIAL
                  FILE STATUS IS DISPLAY-STATUS
                  CONTROL-AREA IS WS-CONTROL.
           SELECT DINVITM-I
                  ASSIGN TO DATABASE-MCFLCS2601
                  ORGANIZATION IS INDEXED
                    ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                    WITH DUPLICATES
                  FILE STATUS IS FILE-STATUS.
           SELECT DINVITM-O
                  ASSIGN TO DATABASE-MCFLCS2601
                  ORGANIZATION IS INDEXED
                    ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                    WITH DUPLICATES
                  FILE STATUS IS FILE-STATUS.
           SELECT DINVACCT-I
                  ASSIGN TO DATABASE-MCFLCS2701
                  ORGANIZATION IS INDEXED
                    ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                    WITH DUPLICATES
                  FILE STATUS IS FILE-STATUS.
           SELECT DINVACCT-O
                  ASSIGN TO DATABASE-MCFLCS2701
                  ORGANIZATION IS INDEXED
                    ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                    WITH DUPLICATES
                  FILE STATUS IS FILE-STATUS.
004100
004200 DATA DIVISION.
       FILE SECTION.
       FD  DISPLAY-FILE
           LABEL RECORDS ARE OMITTED.
       01  DISPLAY-REC.
           COPY DD-INVMOD4-O OF ZINVOICE.
       FD  DINVITM-I
           LABEL RECORDS ARE STANDARD.
       01  DINVITM-I-REC.
           COPY DDS-ALL-FORMATS OF MCFLCS2601.
       FD  DINVITM-O
           LABEL RECORDS ARE STANDARD.
       01  DINVITM-O-REC.
           COPY DDS-ALL-FORMATS OF MCFLCS2601.
       FD  DINVACCT-I
           LABEL RECORDS ARE STANDARD.
       01  DINVACCT-I-REC.
           COPY DDS-ALL-FORMATS OF MCFLCS2701.
       FD  DINVACCT-O
           LABEL RECORDS ARE STANDARD.
       01  DINVACCT-O-REC.
           COPY DDS-ALL-FORMATS OF MCFLCS2701.
004300
004400 WORKING-STORAGE SECTION.
       01  FILE-STATUS.
           05  FILE-STATUS-1         PIC X VALUE "0".
           05  FILE-STATUS-2         PIC X VALUE "0".
004600 77  BLOWUP-SW                 PIC X        VALUE SPACE.
