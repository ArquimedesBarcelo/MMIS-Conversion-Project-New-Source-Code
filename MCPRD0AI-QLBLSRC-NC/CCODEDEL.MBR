      *------ FD STATEMENT AREA FOR IBM ONLY ------*

       WORKING-STORAGE SECTION.
       77  SUB                           PIC S9(4) COMP-4 VALUE 0.
      **************************************************************
      **                                                          **
      **               K S A M   W O R K                          **
      **                                                          **
      **************************************************************
       01  FILE-STATUS.
           05  FILE-STATUS-1            PIC X  VALUE "0".
           05  FILE-STATUS-2            PIC X  VALUE "0".

       01  KEY-VALUE                     PIC X(8)  VALUE SPACES.
       01  KEY-LOC                       PIC S9(4) COMP-4 VALUE 3.
       01  KEY-LENGTH                    PIC S9(4) COMP-4 VALUE 8.
       01  RELOP                         PIC S9(4) COMP-4 VALUE 2.
       01  RECSIZE                       PIC S9(4) COMP-4 VALUE 66.
       01  RESULT                        PIC 9(4)  VALUE ZEROS.
       01  LOCK-COND                     PIC S9(4) COMP-4 VALUE 1.

       01  NEW-CODE                     PIC X(08)  VALUE SPACES.
       01  NEW-UM                       PIC X(02)  VALUE SPACES.
       01  NEW-UM-CF                    PIC S9(8)  VALUE ZEROS.
       01  BU-DISPLAY-FLDS.
           05  BU-DISPLAY-LINE OCCURS 5 TIMES.
               10  BU-DISPLAY-FLD       PIC X(14).
               10  BU-DISPLAY-FLD9      PIC S9(8).

       COPY USAGEFIL IN COPYLIB.

       01  BUF-RECEIPTFIL.
           05  R-CORP-CODE               PIC X(8).
           05  R-MONTHS                  OCCURS 14 TIMES.
               10  R-MTH-RECEIPTS        PIC S9(9) COMP-4.

      ********************************************
      **     I-O TYPE :  0 = INPUT ONLY         **
      **                 1 = OUTPUT ONLY        **
      **                 2 = INPUT-OUTPUT       **
      **                                        **
      **     A-MODE      0 = SEQUENTIAL ONLY    **
      **                 1 = RANDOM ONLY        **
      **                 2 = DYNAMIC            **
      ********************************************

       01  FILE-TABLE.
           05  FILENUMBER               PIC S9(4) COMP-4 VALUE 0.
           05  FILENAME                 PIC X(8)  VALUE "USAGEFIL".
           05  I-O-TYPE                 PIC S9(4) COMP-4 VALUE 2.
           05  A-MODE                   PIC S9(4) COMP-4 VALUE 2.
           05  PREV-OP                  PIC S9(4) COMP-4 VALUE 0.

       01  KSAM-STATUS.
           05  K-STAT-1                 PIC X.
           05  FILLER                   PIC X.

      **************************************************************
      **                                                          **
      **                     DATA BASE WORK                       **
      **                                                          **
      **************************************************************

       01  CODE-ARG                     PIC X(8).

       COPY DBMODES    IN COPYLIB.

       01  DSET-TABLE-AREA.
           05  FILLER                PIC X(16) VALUE "DWLITEM;        ".
           05  FILLER                PIC X(16) VALUE "DMANPART;       ".
           05  FILLER                PIC X(16) VALUE "DDESC;          ".
           05  FILLER                PIC X(16) VALUE "DDESC2;         ".
           05  FILLER                PIC X(16) VALUE "DDESC3;         ".
           05  FILLER                PIC X(16) VALUE "DRESERVE;       ".
           05  FILLER                PIC X(16) VALUE "DCODE;          ".
           05  FILLER                PIC X(16) VALUE "DREQITM;        ".
           05  FILLER                PIC X(16) VALUE "DVENDITM;       ".
           05  FILLER                PIC X(16) VALUE "DPOITEM;        ".
           05  FILLER                PIC X(16) VALUE "DINVITM;        ".
           05  FILLER                PIC X(16) VALUE "DRCVITEM;       ".
           05  FILLER                PIC X(16) VALUE "DTALLY;         ".
           05  FILLER                PIC X(16) VALUE "DRCVCORR;       ".
           05  FILLER                PIC X(16) VALUE "DCHATNO;        ".

       01  DSET-TABLE REDEFINES DSET-TABLE-AREA.
           05  DSET-TABLE-NAME OCCURS 13 TIMES PIC X(16).

       01 SOME-DB-STUFF.
           05  ALL-ITEMS             PIC X(2)  VALUE "@;".
           05  CODE-SEARCH           PIC X(16) VALUE "CORP-CODE;".
           05  DSET-NAME             PIC X(16) VALUE SPACES.

      **************************************************************
      **************************************************************
      **                                                          **
      **                     DATA BASE BUFFERS                    **
      **                                                          **
      **************************************************************
      **************************************************************
       01  BUF-ANY                   PIC X(900).

      **************************************************************
      **                                                          **
      **            L I N K A G E   S E C T I O N                 **
      **                                                          **
      **************************************************************
       LINKAGE SECTION.
       01  BASE                          PIC X(10).
       COPY DBSTAT     IN COPYLIB.
       01  BU-DISPLAY-MSG.
           05  BU-DISPLAY-SUBPROG.
               10  BU-DISPLAY-MSG-1      PIC X(1).
               10  FILLER                PIC X(8).
           05  BU-DISPLAY-REST           PIC X(51).

       01  PASSED-CORP-CODE              PIC X(8).

       01  PASSED-KSAM-FILE-NUMBER       PIC S9(4) COMP-4.
       01  PASSED-PADDING                PIC X(50).

       PROCEDURE DIVISION USING BASE,
                                STATUS-AREA,
                                BU-DISPLAY-MSG,
                                PASSED-CORP-CODE
                                PASSED-KSAM-FILE-NUMBER,
                                PASSED-PADDING.
       6000-MAIN.
           PERFORM 9980-OPENS.
           MOVE PASSED-CORP-CODE         TO   CODE-ARG.
           MOVE 0                        TO   SUB.
       6310-DELETE-DETAIL-LOOP.
           ADD 1                         TO   SUB.
           IF SUB > 13
               GO TO 6390-UNLOCK.

           MOVE DSET-TABLE-NAME (SUB)    TO   DSET-NAME.
           PERFORM 6500-DELETE-DETAIL THRU 6590-DD-X.
           IF BU-DISPLAY-MSG-1 NOT = SPACES
               GO TO 6990-MAIN-X.

           GO TO 6310-DELETE-DETAIL-LOOP.

       6390-UNLOCK.

       6400-DELETE-MSTORERM.
           MOVE "MSTORERM"               TO   DSET-NAME.
      *    CALL "DBGET" USING BASE, DSET-NAME, MODE7,
      *      STATUS-AREA, ALL-ITEMS, BUF-ANY,
      *      PASSED-CORP-CODE.
           PERFORM 9999-DBGET7-MSTORERM-CD-O.
           IF COND-WORD = 17
               GO TO 6990-MAIN-X.

      *    CALL "DBDELETE" USING BASE, DSET-NAME, MODE1, STATUS-AREA.
           PERFORM 9999-DBDELETE-MSTORERM-CD-O.

       6419-DELETE-ALT-KEY.
           MOVE SPACES TO BU-DISPLAY-MSG.
           CALL "SCCALTCH" USING PASSED-CORP-CODE NEW-CODE
                          BU-DISPLAY-MSG BU-DISPLAY-FLDS.
           IF BU-DISPLAY-MSG NOT = SPACES
               MOVE BU-DISPLAY-FLD9 (3) TO COND-WORD
               GO TO 6990-MAIN-X.

       6420-DELETE-PM-JOBPLAN.
           MOVE SPACES TO BU-DISPLAY-MSG.
           CALL "SJOBPCOD" USING PASSED-CORP-CODE NEW-CODE NEW-UM
                NEW-UM-CF BU-DISPLAY-MSG BU-DISPLAY-FLDS.
           IF BU-DISPLAY-MSG NOT = SPACES
               MOVE BU-DISPLAY-FLD9 (3) TO COND-WORD
               GO TO 6990-MAIN-X.

       6425-DELETE-CC-LINK.
           MOVE SPACES TO BU-DISPLAY-MSG.
           CALL "SCCLKCHG" USING PASSED-CORP-CODE NEW-CODE
                          BU-DISPLAY-MSG BU-DISPLAY-FLDS.
           IF BU-DISPLAY-MSG NOT = SPACES
               MOVE BU-DISPLAY-FLD9 (3) TO COND-WORD
               GO TO 6990-MAIN-X.

       6450-DELETE-KSAM.
           MOVE PASSED-CORP-CODE         TO   KEY-VALUE.
      *    CALL "CKREADBYKEY" USING FILE-TABLE, KSAM-STATUS,
      *      USAGE-REC, KEY-VALUE, KEY-LOC, RECSIZE.
           PERFORM 9999-DBGET7-USAGEFIL-CD-O.
           IF COND-WORD = 17
               GO TO 6455-DELETE-RECEIPTS.

      *    CALL "CKDELETE" USING FILE-TABLE, KSAM-STATUS.
           PERFORM 9999-DBDELETE-USAGEFIL-CD-O.

       6455-DELETE-RECEIPTS.
           PERFORM 9999-DBGET7-RECEIPTFIL-CD-O.
           IF COND-WORD = 17
               GO TO 6990-MAIN-X.

           PERFORM 9999-DBDELETE-RECEIPTFIL-CD-O.

           GO TO 6990-MAIN-X.

       6500-DELETE-DETAIL.
      *    CALL "DBFIND" USING BASE, DSET-NAME, MODE1, STATUS-AREA,
      *      CODE-SEARCH, PASSED-CORP-CODE.
           PERFORM 9000-DBFIND.
           IF BU-DISPLAY-MSG-1 NOT = SPACES
               GO TO 6590-DD-X.

       6510-GET-DETAIL-LOOP.
      *    CALL "DBGET" USING BASE, DSET-NAME, MODE5, STATUS-AREA,
      *      ALL-ITEMS, BUF-ANY, PASSED-CORP-CODE.
           PERFORM 9100-DBGET.
           IF COND-WORD = 15
               GO TO 6590-DD-X
           ELSE
           IF COND-WORD NOT = 0
               GO TO 6590-DD-X.

      *    CALL "DBDELETE" USING BASE, DSET-NAME, MODE1, STATUS-AREA.
           PERFORM 9200-DBDELETE.
           IF BU-DISPLAY-MSG-1 NOT = SPACES
               GO TO 6590-DD-X.

           GO TO 6510-GET-DETAIL-LOOP.

       6590-DD-X.
           EXIT.

       6990-MAIN-X.
           PERFORM 9981-CLOSES.
           IF BU-DISPLAY-MSG-1 NOT = SPACES
               MOVE BU-DISPLAY-MSG TO BU-DISPLAY-REST
               MOVE "CCODEDEL" TO BU-DISPLAY-SUBPROG.
           GOBACK.

       9000-DBFIND.
           IF DSET-NAME = "DWLITEM;"
               PERFORM 9999-DBFIND-DWLITEM-CD-O
           ELSE
           IF DSET-NAME = "DMANPART;"
               PERFORM 9999-DBFIND-DMANPART-CD-O
           ELSE
           IF DSET-NAME = "DDESC;"
               PERFORM 9999-DBFIND-DDESC-CD-O
           ELSE
           IF DSET-NAME = "DDESC2;"
               PERFORM 9999-DBFIND-DDESC2-CD-O
           ELSE
           IF DSET-NAME = "DRESERVE;"
               PERFORM 9999-DBFIND-DRESERVE-CD-O
           ELSE
           IF DSET-NAME = "DCODE;"
               PERFORM 9999-DBFIND-DCODE-CD-O
           ELSE
           IF DSET-NAME = "DREQITM;"
               PERFORM 9999-DBFIND-DREQITM-CD-O
           ELSE
           IF DSET-NAME = "DVENDITM;"
               PERFORM 9999-DBFIND-DVENDITM-CD-O
           ELSE
           IF DSET-NAME = "DPOITEM;"
               PERFORM 9999-DBFIND-DPOITEM-CD-O
           ELSE
           IF DSET-NAME = "DINVITM;"
               PERFORM 9999-DBFIND-DINVITM-CD-O
           ELSE
           IF DSET-NAME = "DRCVITEM;"
               PERFORM 9999-DBFIND-DRCVITEM-CD-O
           ELSE
           IF DSET-NAME = "DTALLY;"
               PERFORM 9999-DBFIND-DTALLY-CD-O
           ELSE
           IF DSET-NAME = "DRCVCORR;"
               PERFORM 9999-DBFIND-DRCVCORR-CD-O
           ELSE
           IF DSET-NAME = "DCHATNO;"
               PERFORM 9999-DBFIND-DCHATNO-CD-O.

        9100-DBGET.
           IF DSET-NAME = "DWLITEM;"
               PERFORM 9999-DBGET5-DWLITEM-CD-O
           ELSE
           IF DSET-NAME = "DMANPART;"
               PERFORM 9999-DBGET5-DMANPART-CD-O
           ELSE
           IF DSET-NAME = "DDESC;"
               PERFORM 9999-DBGET5-DDESC-CD-O
           ELSE
           IF DSET-NAME = "DDESC2;"
               PERFORM 9999-DBGET5-DDESC2-CD-O
           ELSE
           IF DSET-NAME = "DRESERVE;"
               PERFORM 9999-DBGET5-DRESERVE-CD-O
           ELSE
           IF DSET-NAME = "DCODE;"
               PERFORM 9999-DBGET5-DCODE-CD-O
           ELSE
           IF DSET-NAME = "DREQITM;"
               PERFORM 9999-DBGET5-DREQITM-CD-O
           ELSE
           IF DSET-NAME = "DVENDITM;"
               PERFORM 9999-DBGET5-DVENDITM-CD-O
           ELSE
           IF DSET-NAME = "DPOITEM;"
               PERFORM 9999-DBGET5-DPOITEM-CD-O
           ELSE
           IF DSET-NAME = "DINVITM;"
               PERFORM 9999-DBGET5-DINVITM-CD-O
           ELSE
           IF DSET-NAME = "DRCVITEM;"
               PERFORM 9999-DBGET5-DRCVITEM-CD-O
           ELSE
           IF DSET-NAME = "DTALLY;"
               PERFORM 9999-DBGET5-DTALLY-CD-O
           ELSE
           IF DSET-NAME = "DRCVCORR;"
               PERFORM 9999-DBGET5-DRCVCORR-CD-O
           ELSE
           IF DSET-NAME = "DCHATNO;"
               PERFORM 9999-DBGET5-DCHATNO-CD-O.

        9200-DBDELETE.
           IF DSET-NAME = "DWLITEM;"
               PERFORM 9999-DBDELETE-DWLITEM-CD-O
           ELSE
           IF DSET-NAME = "DMANPART;"
               PERFORM 9999-DBDELETE-DMANPART-CD-O
           ELSE
           IF DSET-NAME = "DDESC;"
               PERFORM 9999-DBDELETE-DDESC-CD-O
           ELSE
           IF DSET-NAME = "DDESC2;"
               PERFORM 9999-DBDELETE-DDESC2-CD-O
           ELSE
           IF DSET-NAME = "DRESERVE;"
               PERFORM 9999-DBDELETE-DRESERVE-CD-O
           ELSE
           IF DSET-NAME = "DCODE;"
               PERFORM 9999-DBDELETE-DCODE-CD-O
           ELSE
           IF DSET-NAME = "DREQITM;"
               PERFORM 9999-DBDELETE-DREQITM-CD-O
           ELSE
           IF DSET-NAME = "DVENDITM;"
               PERFORM 9999-DBDELETE-DVENDITM-CD-O
           ELSE
           IF DSET-NAME = "DPOITEM;"
               PERFORM 9999-DBDELETE-DPOITEM-CD-O
           ELSE
           IF DSET-NAME = "DINVITM;"
               PERFORM 9999-DBDELETE-DINVITM-CD-O
           ELSE
           IF DSET-NAME = "DRCVITEM;"
               PERFORM 9999-DBDELETE-DRCVITEM-CD-O
           ELSE
           IF DSET-NAME = "DTALLY;"
               PERFORM 9999-DBDELETE-DTALLY-CD-O
           ELSE
           IF DSET-NAME = "DRCVCORR;"
               PERFORM 9999-DBDELETE-DRCVCORR-CD-O
           ELSE
           IF DSET-NAME = "DCHATNO;"
               PERFORM 9999-DBDELETE-DCHATNO-CD-O.

       9980-OPENS.
           OPEN I-O DWLITEM-CD-O, DMANPART-CD-O, DDESC-CD-O,
                    DRESERVE-CD-O, DCODE-CD-O, DREQITM-CD-O,
                    DVENDITM-CD-O, DPOITEM-CD-O, DINVITM-CD-O,
                    DRCVITEM-CD-O, MSTORERM-CD-O, USAGEFIL-CD-O,
