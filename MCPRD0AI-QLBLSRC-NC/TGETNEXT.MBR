       IDENTIFICATION DIVISION.
       PROGRAM-ID.             TGETNEXT.
       AUTHOR.                 W. ROXBURY.
       INSTALLATION.           GOODYEAR TIRE & RUBBER CO.
       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.
       SOURCE-COMPUTER.        IBM-AS400.
       OBJECT-COMPUTER.        IBM-AS400.
       SPECIAL-NAMES.          I-O-FEEDBACK IS I-O-FEEDBACK-AREA.
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT WO-BASIC
                  ASSIGN       TO DATABASE-MCFLMM1001
                  ORGANIZATION IS INDEXED
                  ACCESS MODE  IS DYNAMIC
                  RECORD KEY   IS EXTERNALLY-DESCRIBED-KEY
                               WITH DUPLICATES
                  FILE STATUS  IS FILE-STAT.

           SELECT WO-Q-ZONE
                  ASSIGN       TO DATABASE-MCFLMM1901
                  ORGANIZATION IS INDEXED
                  ACCESS MODE  IS DYNAMIC
                  RECORD KEY   IS EXTERNALLY-DESCRIBED-KEY
                               WITH DUPLICATES
                  FILE STATUS  IS FILE-STAT.

           SELECT WO-Q-CCNO
                  ASSIGN       TO DATABASE-MCFLMM1903
                  ORGANIZATION IS INDEXED
                  ACCESS MODE  IS DYNAMIC
                  RECORD KEY   IS EXTERNALLY-DESCRIBED-KEY
                               WITH DUPLICATES
                  FILE STATUS  IS FILE-STAT.

           SELECT WO-Q-REL
                  ASSIGN       TO DATABASE-MCFPMM1900
                  ORGANIZATION IS RELATIVE
                  ACCESS MODE  IS DYNAMIC
                  RELATIVE KEY IS REC-NO
                  FILE STATUS  IS FILE-STAT.

           SELECT WO-CRAFTS-REQD
                  ASSIGN       TO DATABASE-MCFLMM0601
                  ORGANIZATION IS INDEXED
                  ACCESS MODE  IS DYNAMIC
                  RECORD KEY   IS EXTERNALLY-DESCRIBED-KEY
                  FILE STATUS  IS FILE-STAT.

       DATA DIVISION.
       FILE SECTION.
       FD  WO-BASIC
           LABEL RECORDS ARE STANDARD.
       01  VWO-REC.
           COPY DDS-ALL-FORMATS OF MCFLMM1001.

       FD  WO-Q-ZONE
           LABEL RECORDS ARE STANDARD.
       01  ZONE-REC.
           COPY DDS-ALL-FORMATS OF MCFLMM1901.

       FD  WO-Q-CCNO
           LABEL RECORDS ARE STANDARD.
       01  CCNO-REC.
           COPY DDS-ALL-FORMATS OF MCFLMM1903.

       FD  WO-Q-REL
           LABEL RECORDS ARE STANDARD.
       01  QREL-REC.
           COPY DDS-ALL-FORMATS OF MCFPMM1900.

       FD  WO-CRAFTS-REQD
           LABEL RECORDS ARE STANDARD.
       01  CR-REC.
           COPY DDS-ALL-FORMATS OF MCFLMM0601.

       WORKING-STORAGE SECTION.
       77  SKILL-SW            PIC 9  VALUE 1.
       77  HOLD-SKILL          PIC XX.
       77  QUEUE-SW            PIC X  VALUE SPACE.
       77  QUEUE-ERROR         PIC X(76).
       77  REC-NO              PIC 9(08).
       77  SAVE-REC-NO         PIC S9(8) COMP-4.

       01  FILE-STAT.
           05  FILE-STAT-1     PIC X  VALUE "0".
           05  FILE-STAT-2     PIC X  VALUE "0".

       01  ZONE-ARGUMENT.
           05  ZONE-ARG        PIC X(4).
           05  ZONE-PRTY       PIC XX  VALUE "1 ".

       01  WO-QUEUE-HOLD.
           05  H-ZONE-PRI.
               10  H-ZONE      PIC X(4).
               10  H-PRTY      PIC X(2).
           05  H-WO-NUM.
               10  H-WO-NUM-6  PIC X(6).
               10  H-WO-YR     PIC X.
               10  H-WO-SUF    PIC X(3).
           05  H-WO-STAT       PIC XX.
           05  H-CC-NUM        PIC X(4).
           05  H-FACTOR        PIC 99.
           05  H-EQUIP-NUM     PIC X(6).
           05  H-DESCRIPTION   PIC X(30).
           05  H-SKILL-1       PIC XX.
           05  H-SKILL-2       PIC XX.
           05  H-SKILL-3       PIC XX.
           05  H-PAD           PIC X(20).

       01  DB-ERROR.
           05  DB-FUNC         PIC X(10) VALUE SPACES.
           05  DB-FILE         PIC X(18) VALUE SPACES.
           05  FILLER          PIC X(20) VALUE "ERROR - FILE-STAT = ".
           05  CON-WORD        PIC XX.

           COPY IOFEEDBACK     IN COPYLIB.

           COPY CATREAD        IN COPYLIB.

       01  WO-CRAFT-DATA.
           COPY MWOCRAFT       IN COPYLIB.

       LINKAGE SECTION.
       01  DBPARAMETERS.
           COPY DBPARMS        IN COPYLIB.

       01  WO-QUEUE-DATA.
           COPY DWOOPENQ       IN COPYLIB.

       01  WO-PERS-DATA.
           COPY MPERSONL       IN COPYLIB.

       01  WO-BASIC-DATA.
           COPY DWOBASIC       IN COPYLIB.

       01  CNUM-BUFFER.
           05  CNUM-BUF        PIC XXXX.
           05  CNAM-BUF        PIC X(16).
       01  TEMP-ZONE           PIC X(04).
       01  MESSAGE-BUFFER      PIC X(76).
       01  RETURN-COD          PIC 9.

       PROCEDURE DIVISION      USING DBPARAMETERS
                               WO-QUEUE-DATA
                               WO-PERS-DATA
                               WO-BASIC-DATA
                               CNUM-BUFFER
                               TEMP-ZONE
                               MESSAGE-BUFFER
                               RETURN-COD.
       BEGIN.
           OPEN INPUT          WO-BASIC.
           OPEN INPUT          WO-Q-ZONE.
           OPEN INPUT          WO-Q-CCNO.
           OPEN INPUT          WO-Q-REL.
           OPEN INPUT          WO-CRAFTS-REQD.
           MOVE SPACES         TO MESSAGE-BUFFER WO-QUEUE-HOLD.
           MOVE 0              TO H-FACTOR RETURN-COD.
           MOVE 1              TO SKILL-SW.

       61-GET-WO-DATA.
           MOVE SPACES         TO WO-CRAFT-DATA.
           MOVE PER-CRAFT      TO CRAFTREQD OF WO-CRAFTS-REQD.
           READ WO-CRAFTS-REQD INTO WO-CRAFT-DATA
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF CRAFT-MSTR NOT = PER-CRAFT
               DISPLAY "READ CRAFT FILE ERROR, PROG - TGETNEXT"
               GO TO END-OF-JOB.

           PERFORM 62-GET-QUEUE THRU 62-GQ-EXIT.
           IF RETURN-COD = 1
               GO TO END-OF-JOB.

           MOVE WO-QUEUE-HOLD  TO WO-QUEUE-DATA.
           MOVE H-WO-NUM       TO WONUM OF WO-BASIC.
           READ WO-BASIC       INTO WO-BASIC-DATA
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
               MOVE "READ    " TO DB-FUNC
               MOVE "WO-BASIC" TO DB-FILE
               MOVE FILE-STAT  TO CON-WORD
               MOVE DB-ERROR   TO MESSAGE-BUFFER
               GO TO END-OF-JOB.

           GO TO END-OF-JOB.

       62-GET-QUEUE.
           MOVE CNUM-BUF       TO PERCCNUM OF WO-Q-CCNO.
           START WO-Q-CCNO     KEY = PERCCNUM OF WO-Q-CCNO
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
               IF FILE-STAT-1 = "2"
                   GO TO FIND-CNUM-CONT
               ELSE
                   MOVE "START   "  TO DB-FUNC
                   MOVE "WO-Q-CCNO" TO DB-FILE
                   MOVE FILE-STAT   TO CON-WORD
                   MOVE DB-ERROR    TO MESSAGE-BUFFER
                   GO TO END-OF-JOB.

       FIND-DBGET-C.
           READ WO-Q-CCNO      NEXT INTO WO-QUEUE-DATA
               AT END          MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
               IF FILE-STAT = "10" OR "14" OR "46"
                   GO TO FIND-CNUM-CONT
               ELSE
                   MOVE "READ    "  TO DB-FUNC
                   MOVE "WO-Q-CCNO" TO DB-FILE
                   MOVE FILE-STAT   TO CON-WORD
                   MOVE DB-ERROR    TO MESSAGE-BUFFER
                   GO TO END-OF-JOB.

           IF CNUM-BUF NOT = Q-CC-NUM
                   GO TO FIND-CNUM-CONT.

           ACCEPT IOFEEDBACK   FROM I-O-FEEDBACK-AREA.
           IF QUEUE-FACTOR IS GREATER THAN H-FACTOR
               MOVE WO-QUEUE-DATA TO WO-QUEUE-HOLD
               MOVE IO-REL-NO     TO SAVE-REC-NO
           ELSE
           IF QUEUE-FACTOR = H-FACTOR
               IF Q-WO-YR < H-WO-YR
                   MOVE WO-QUEUE-DATA TO WO-QUEUE-HOLD
                   MOVE IO-REL-NO TO SAVE-REC-NO
               ELSE
               IF Q-WO-YR = H-WO-YR
                   IF Q-WO-NUM-6 < H-WO-NUM-6
                       MOVE WO-QUEUE-DATA TO WO-QUEUE-HOLD
                       MOVE IO-REL-NO TO SAVE-REC-NO.

           GO TO FIND-DBGET-C.

       FIND-CNUM-CONT.
           IF CRAFT-FLAG = "1 " OR "2 " OR " 1" OR " 2"
               GO TO FIND-PLANTWIDE.

           MOVE PER-MAINT-ZONE TO ZONE-ARG.
           IF PER-TEMP-ZONE NOT = SPACES
               MOVE PER-TEMP-ZONE TO ZONE-ARG.
           IF TEMP-ZONE NOT = SPACES
               MOVE TEMP-ZONE  TO ZONE-ARG.

           MOVE ZONE-ARGUMENT  TO ZONEPRTY OF WO-Q-ZONE.
           START WO-Q-ZONE     KEY = ZONEPRTY OF WO-Q-ZONE
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
               IF FILE-STAT-1 = "2"
                   GO TO FIND-ZONE-CONT
               ELSE
                   MOVE "START   "  TO DB-FUNC
                   MOVE "WO-Q-ZONE" TO DB-FILE
                   MOVE FILE-STAT   TO CON-WORD
                   MOVE DB-ERROR    TO MESSAGE-BUFFER
                   GO TO END-OF-JOB.

       FIND-DBGET-Z.
           READ WO-Q-ZONE      NEXT INTO WO-QUEUE-DATA
               AT END          MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
               IF FILE-STAT = "10" OR "14" OR "46"
                   GO TO FIND-ZONE-CONT
               ELSE
                   MOVE "READ    "  TO DB-FUNC
                   MOVE "WO-Q-ZONE" TO DB-FILE
                   MOVE FILE-STAT   TO CON-WORD
                   MOVE DB-ERROR    TO MESSAGE-BUFFER
                   GO TO END-OF-JOB.

           IF ZONE-ARGUMENT NOT = Q-ZONE-PRI
               GO TO FIND-ZONE-CONT.

           ACCEPT IOFEEDBACK   FROM I-O-FEEDBACK-AREA.
           IF SKILL-SW = 1
               MOVE Q-SKILL-1  TO HOLD-SKILL
           ELSE
           IF SKILL-SW = 2
               MOVE Q-SKILL-2  TO HOLD-SKILL
           ELSE
               MOVE Q-SKILL-3  TO HOLD-SKILL.

           IF PER-CRAFT NOT = HOLD-SKILL
               GO TO FIND-DBGET-Z.

           IF Q-CC-NUM NOT = "9999"
               GO TO FIND-DBGET-Z.

           IF QUEUE-FACTOR IS GREATER THAN H-FACTOR
               MOVE WO-QUEUE-DATA TO WO-QUEUE-HOLD
               MOVE IO-REL-NO     TO SAVE-REC-NO
           ELSE
           IF QUEUE-FACTOR = H-FACTOR
               IF Q-WO-YR < H-WO-YR
                   MOVE WO-QUEUE-DATA TO WO-QUEUE-HOLD
                   MOVE IO-REL-NO     TO SAVE-REC-NO
               ELSE
               IF Q-WO-YR = H-WO-YR
                   IF Q-WO-NUM-6 < H-WO-NUM-6
                       MOVE WO-QUEUE-DATA TO WO-QUEUE-HOLD
                       MOVE IO-REL-NO     TO SAVE-REC-NO.

           GO TO FIND-DBGET-Z.

       FIND-PLANTWIDE.
           MOVE LOW-VALUES     TO ZONEPRTY OF WO-Q-ZONE.
           START WO-Q-ZONE     KEY NOT < ZONEPRTY OF WO-Q-ZONE
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
               IF FILE-STAT-1 = "2"
                   GO TO FIND-ZONE-CONT
               ELSE
                   MOVE "START   "  TO DB-FUNC
                   MOVE "WO-Q-ZONE" TO DB-FILE
                   MOVE FILE-STAT   TO CON-WORD
                   MOVE DB-ERROR    TO MESSAGE-BUFFER
                   GO TO END-OF-JOB.

       PLANTWIDE-LOOP.
           READ WO-Q-ZONE      NEXT INTO WO-QUEUE-DATA
               AT END          MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
               IF FILE-STAT = "10" OR "14" OR "46"
                   GO TO FIND-ZONE-CONT
               ELSE
                   MOVE "READ    "  TO DB-FUNC
                   MOVE "WO-Q-ZONE" TO DB-FILE
                   MOVE FILE-STAT   TO CON-WORD
                   MOVE DB-ERROR    TO MESSAGE-BUFFER
                   GO TO END-OF-JOB.

           ACCEPT IOFEEDBACK   FROM I-O-FEEDBACK-AREA.
           IF SKILL-SW = 1
               MOVE Q-SKILL-1  TO HOLD-SKILL
           ELSE
           IF SKILL-SW = 2
               MOVE Q-SKILL-2  TO HOLD-SKILL
           ELSE
               MOVE Q-SKILL-3  TO HOLD-SKILL.

           IF PER-CRAFT NOT = HOLD-SKILL
               GO TO PLANTWIDE-LOOP.

           IF Q-CC-NUM NOT = "9999"
               GO TO PLANTWIDE-LOOP.

           IF QUEUE-FACTOR IS GREATER THAN H-FACTOR
               MOVE WO-QUEUE-DATA TO WO-QUEUE-HOLD
               MOVE IO-REL-NO     TO SAVE-REC-NO
           ELSE
           IF QUEUE-FACTOR = H-FACTOR
               IF Q-WO-YR < H-WO-YR
                   MOVE WO-QUEUE-DATA TO WO-QUEUE-HOLD
                   MOVE IO-REL-NO     TO SAVE-REC-NO
               ELSE
               IF Q-WO-YR = H-WO-YR
                   IF Q-WO-NUM-6 < H-WO-NUM-6
                       MOVE WO-QUEUE-DATA TO WO-QUEUE-HOLD
                       MOVE IO-REL-NO     TO SAVE-REC-NO.

           GO TO PLANTWIDE-LOOP.

       FIND-ZONE-CONT.
           IF H-WO-NUM NOT = SPACES
               GO TO CHECKOUT-CYCLE.

           IF SKILL-SW = 3
      ******************************************************************
      **   MESSAGE:  040/001:
      **  NO WORKORDERS AVAILABLE FOR AUTOMATIC ASSIGNMENT
      ******************************************************************
               MOVE  40        TO CATREAD-MSG-SET
               MOVE   1        TO CATREAD-MSG-NUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE 1          TO RETURN-COD
               GO TO 62-GQ-EXIT.

           IF SKILL-SW = 2
               MOVE 3          TO SKILL-SW
               GO TO FIND-CNUM-CONT.

           MOVE 2              TO SKILL-SW.
           GO TO FIND-CNUM-CONT.

       CHECKOUT-CYCLE.
           MOVE SAVE-REC-NO    TO REC-NO.
           READ WO-Q-REL       INTO WO-QUEUE-DATA
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = ZEROS
               MOVE "READ    " TO DB-FUNC
               MOVE "WO-Q-REL" TO DB-FILE
               MOVE FILE-STAT  TO CON-WORD
               MOVE DB-ERROR   TO MESSAGE-BUFFER
               GO TO END-OF-JOB.

           IF CNUM-BUF = Q-CC-NUM
               MOVE "RR"       TO Q-CHKOUT
           ELSE
               MOVE CNUM-BUF   TO Q-CC-NUM
               MOVE "XX"       TO Q-CHKOUT.

           MOVE "C"            TO QUEUE-SW.
           CALL "TQUPDATE"     USING DBPARAMETERS
                               WO-QUEUE-DATA
                               QUEUE-SW
                               QUEUE-ERROR.

           IF QUEUE-ERROR NOT = SPACES
               MOVE QUEUE-ERROR TO MESSAGE-BUFFER
               GO TO END-OF-JOB.

       62-GQ-EXIT.             EXIT.

       END-OF-JOB.
           IF MESSAGE-BUFFER NOT = SPACES
               DISPLAY MESSAGE-BUFFER.
           CLOSE               WO-BASIC.
           CLOSE               WO-Q-ZONE.
           CLOSE               WO-Q-CCNO.
           CLOSE               WO-Q-REL.
           CLOSE               WO-CRAFTS-REQD.
           GOBACK.

       999-CATREAD.
           MOVE SPACES         TO MESSAGE-BUFFER.
           CALL "CCATREAD"     USING CATREAD-PARMS.
           MOVE CATREAD-MSG-TEXT TO MESSAGE-BUFFER.

       999-CATREAD-EXIT.       EXIT.

      ***********************  END OF FILE  ***********************
