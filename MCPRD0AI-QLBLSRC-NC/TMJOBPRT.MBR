000200 IDENTIFICATION DIVISION.
000300 PROGRAM-ID.    TMJOBPRT.
      *C
      *C  SEPT 06, 1996     CA YODER
      *C   RE-COMPILED PROGRAM TO PICK UP CENTURY DATABASE CHANGES.
      *C
000600 ENVIRONMENT DIVISION.
000700 CONFIGURATION SECTION.
000800 SOURCE-COMPUTER.   AS400.
000900 OBJECT-COMPUTER.   AS400.
       SPECIAL-NAMES. C01 IS NEW-PAGE
                      I-O-FEEDBACK IS I-O-FEEDBACK-AREA
                      LOCAL-DATA IS LOCAL-DATA-AREA.
001400 INPUT-OUTPUT SECTION.
001500 FILE-CONTROL.
           SELECT JOBPLAN-BANK
               ASSIGN TO DATABASE-MCFLMM3601
               ORGANIZATION IS INDEXED
               ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                   WITH DUPLICATES
               FILE STATUS IS JB-STATUS.
001600     SELECT PRNT-FILE ASSIGN TO PRINTER-MCPRT.
           SELECT WO-LAST-NUM-USED
               ASSIGN TO DATABASE-MCFPMM0800
               ORGANIZATION IS RELATIVE
               ACCESS MODE IS RANDOM
               RELATIVE KEY IS ARG-NO
               FILE STATUS IS WLNU-STATUS.
001900 DATA DIVISION.
002000 FILE SECTION.
       FD  JOBPLAN-BANK
           LABEL RECORD IS STANDARD
           DATA RECORD IS JBREC.
       01  JBREC.
           COPY DDS-ALL-FORMATS OF MCFLMM3601.
002200 FD  PRNT-FILE
002300     RECORD CONTAINS 80 CHARACTERS
002400     LABEL RECORD IS OMITTED
002500     DATA RECORD IS PRNTF.
002600 01  PRNTF                   PIC X(80).
002700 FD  WO-LAST-NUM-USED
           LABEL RECORDS ARE STANDARD
           DATA RECORD IS WLNUREC.
       01  WLNUREC.
           COPY DDS-ALL-FORMATS OF MCFPMM0800.
002800 WORKING-STORAGE SECTION.
003000 01  ARG-NO                  PIC 9(9).
       01  FILE-STATUSES.
           05  JB-STATUS           PIC XX.
           05  WLNU-STATUS         PIC XX.
003800 01  DBPARAMETERS.           COPY DBPARMS  OF COPYLIB.
004000 COPY TDATESUB OF COPYLIB.
       COPY IOFEEDBACK OF COPYLIB.
005000 01  JOB-CMP-SEQ             PIC 9999.
005200 01  JOBPLAN-BUFFER.         COPY DJOBBANK OF COPYLIB.
006100 01  JOBPLAN-KEY.
006200     05 JOBP-WO-NO           PIC X(10).
006300     05 JOBP-SEQ-NO          PIC 999.
006400     05 FILLER               PIC X.
006800 COPY LANGSUB  OF COPYLIB.
007000 01  LAST-WO-USED-DATA.      COPY MLASTWO  OF COPYLIB.
007400 01  LINES-PER-PAGE          PIC 99.
007800 01  MISC-BUFFER             PIC X(80) VALUE SPACES.
008000 01  OPEN-SW                 PIC X VALUE "N".
       COPY OVRPFDATA IN COPYLIB.
008200 01  PRINT-PAGE.
008300     05 LINE1.
008400        10 PAGE-LIT          PIC X(7) VALUE "PAGE : ".
008500        10 PAGE-VAL          PIC 9(4).
008600        10 FILLER            PIC X(69) VALUE SPACES.
008800     05 LINE2.
008900        10 DATE-LIT          PIC X(7) VALUE "DATE : ".
009000        10 DATE-VAL          PIC X(8).
009100        10 FILLER            PIC X(65) VALUE SPACES.
009300     05 LINE3                PIC X(80) VALUE SPACES.
009500     05 LINE4.
009600        10 FILLER            PIC X(16) VALUE SPACES.
009700        10 TITLE1            PIC X(48) VALUE
009800           "G E N E R I C  W O R K  O R D E R  J O B P L A N".
009900        10 FILLER            PIC X(16) VALUE SPACES.
010100     05 LINE5.
010200        10 FILLER            PIC X(33) VALUE SPACES.
010300        10 FILLER            PIC X(2)  VALUE "* ".
010400        10 MASTER-JOBPLAN    PIC X(10).
010500        10 FILLER            PIC X(2)  VALUE " *".
010600        10 FILLER            PIC X(33).
010800     05 LINE6                PIC X(80) VALUE SPACES.
011000     05 LINE7.
011100        10 SEQ-LIT           PIC X(9) VALUE "SEQUENCE ".
011200        10 SEQ-VAL           PIC X(3).
011300        10 FILLER            PIC X(68) VALUE SPACES.
011500     05 LINE8                PIC X(80) VALUE SPACES.
011700     05 LINE9                PIC X(80).
011900     05 LINE10               PIC X(80) VALUE SPACES.
012100     05 LINE11.
012300        10 JOBPLAN-DATA OCCURS 70 TIMES.
012500           15 FILLER         PIC X(4).
012600           15 JDESC          PIC X(50).
012700           15 FILLER         PIC X(2).
012800           15 JDOWN          PIC ZZZ.Z.
012900           15 FILLER         PIC X(2).
013000           15 JCRFT          PIC X(2).
013100           15 FILLER         PIC X(2).
013200           15 JMEN           PIC ZZ.
013300           15 FILLER         PIC X(2).
013400           15 JEST           PIC ZZZ.Z.
013500           15 FILLER         PIC X(4).
       01  SAVE-SEQ-NO             PIC X(4).
013700 01  S1                      PIC 9(4) COMP-4.
013900 01  S2                      PIC 9(4) COMP-4.
014100 COPY DBSTAT   OF COPYLIB.
       LINKAGE SECTION.
       01  TSUFFR01-DATA.
007600     05  MJPLAN-FIELD        PIC X(10).
006600     05  JOBSEQ-FIELD        PIC 999.
007600     05  MMPLAN-FIELD        PIC X(10).
003600     05  SPOOLER-FIELD       PIC 9(3).
007200     05  LINESP-FIELD        PIC X.
014400 PROCEDURE DIVISION USING TSUFFR01-DATA.
014500
014600 START-PROGRAM.
014700     PERFORM 1-HSK.
024000     MOVE SPACES TO JOBPLAN-KEY SAVE-SEQ-NO.
024100     MOVE MJPLAN-FIELD TO JOBP-WO-NO.
           IF JOBSEQ-FIELD = 0 MOVE 1 TO JOB-CMP-SEQ.
014800     PERFORM 6-MAIN THRU 6-MAIN-EXIT UNTIL COND-WORD = 15.
015000
015100 2-EOJ.
           CLOSE JOBPLAN-BANK.
           CLOSE WO-LAST-NUM-USED.
016100     IF OPEN-SW = "Y" CLOSE PRNT-FILE.
017200     GOBACK.
017300
017500 1-HSK.
           OPEN INPUT  JOBPLAN-BANK.
           OPEN INPUT  WO-LAST-NUM-USED.
019300     MOVE 0 TO COND-WORD.
019400     MOVE 1 TO ARG-NO.
019600     READ WO-LAST-NUM-USED INTO LAST-WO-USED-DATA
019700         INVALID KEY    MOVE 17 TO COND-WORD.
019800     IF COND-WORD = 17 MOVE 1 TO DATE-FLAG-SW.
020000     MOVE DATE-FLAG-SW TO DATE-CODE DATE-FLAG.
020700     MOVE 0 TO PAGE-VAL.
020900     STRING "    "
021000            "DESCRIPTION ______________________________________"
021100            "   "
021200            "DOWN "
021300            "CRF "
021400            "MEN  "
021500            "CLOCK    "
021700           DELIMITED BY SIZE INTO LINE9.
021900     MOVE 1 TO DATE-MODE.
022000     CALL "TDATECK2" USING DATE-CHECK-AREA LANGUAGE-PARMS.
022100     MOVE DATE-SLASH-OUT TO DATE-VAL.
022300     MOVE MJPLAN-FIELD TO MASTER-JOBPLAN.
022500     IF LINESP-FIELD = "6" MOVE 50 TO LINES-PER-PAGE
022600     ELSE
022700     IF LINESP-FIELD = "8" MOVE 70 TO LINES-PER-PAGE.
022900     MOVE SPOOLER-FIELD TO OVRPRTF-TOFILE-NUM.
023000     PERFORM 996-OVERRIDE-PRINT-FILE.
023200     OPEN OUTPUT PRNT-FILE.
023400     MOVE "Y" TO OPEN-SW.
023500
023700 6-MAIN.
024300     IF JOBSEQ-FIELD = 0
025200         MOVE SPACES TO LINE11
025300         MOVE 1 TO S1
               PERFORM 69-START-JOBPLAN-BANK
               IF COND-WORD = 17
                   ADD 1 TO JOB-CMP-SEQ
                   IF JOB-CMP-SEQ > 999
                       MOVE 15 TO COND-WORD
                   ELSE
                   NEXT SENTENCE
               ELSE
024400         PERFORM 60-READ-JOBPLAN THRU 60-RJ-EXIT
024500             UNTIL COND-WORD = 15
024600     ELSE
025200     MOVE SPACES TO LINE11
025300     MOVE 1 TO S1
024700     MOVE JOBSEQ-FIELD TO JOB-CMP-SEQ
           PERFORM 69-START-JOBPLAN-BANK
           IF COND-WORD = 17
               MOVE 15 TO COND-WORD
           ELSE
024800     PERFORM 60-READ-JOBPLAN THRU 60-RJ-EXIT
               UNTIL COND-WORD = 15.
024900
       6-MAIN-EXIT.    EXIT.

025100 60-READ-JOBPLAN.
           MOVE 0 TO COND-WORD.
           READ JOBPLAN-BANK NEXT INTO JOBPLAN-BUFFER
               AT END    MOVE 15 TO COND-WORD.
           IF SAVE-SEQ-NO = SPACES MOVE JOBPLAN-SEQ-NO TO SAVE-SEQ-NO.
           IF JOBSEQ-FIELD = 0
               IF MJPLAN-FIELD = JOBPLAN-NAME
                   IF JOBPLAN-SEQ-NO = SAVE-SEQ-NO
                       NEXT SENTENCE
                   ELSE
                   PERFORM 600-WRITE-PAGE
                   MOVE JOBPLAN-SEQ-NO TO SAVE-SEQ-NO
               ELSE
               PERFORM 600-WRITE-PAGE
               MOVE 15 TO COND-WORD
           ELSE
           IF JOBPLAN-KEY = JOBP-N-S
               NEXT SENTENCE
           ELSE
           PERFORM 600-WRITE-PAGE
           MOVE 15 TO COND-WORD.
           MOVE JOBPLAN-SEQ-NO TO SAVE-SEQ-NO.
           IF JB-STATUS NOT = "00" MOVE 15 TO COND-WORD.
           IF COND-WORD = 15 GO TO 60-RJ-EXIT.
028100     IF S1 > LINES-PER-PAGE
028200         PERFORM 600-WRITE-PAGE.
028400     MOVE JOBPLAN-DESCRIP  TO JDESC (S1).
           IF JOBPLAN-DT = "    "
               NEXT SENTENCE
           ELSE
028500     MOVE JOBP-DOWNT       TO JDOWN (S1).
028600     MOVE JOBPLAN-CRAFT    TO JCRFT (S1).
           IF JOBPLAN-MEN-X = "  "
               NEXT SENTENCE
           ELSE
028700     MOVE JOBPLAN-MEN      TO JMEN  (S1).
           IF JOBPLAN-EST = "    "
               NEXT SENTENCE
           ELSE
028800     MOVE JOBPLAN-EST-TIME TO JEST  (S1).
029000     ADD 1 TO S1.
029200     GO TO 60-READ-JOBPLAN.
029300
029400 60-RJ-EXIT.   EXIT.
029600
029800 600-WRITE-PAGE.
029900     ADD 1 TO PAGE-VAL.
030000     WRITE PRNTF FROM LINE1 AFTER ADVANCING NEW-PAGE.
030200     WRITE PRNTF FROM LINE2.
030300     WRITE PRNTF FROM LINE3.
030400     WRITE PRNTF FROM LINE4.
030500     WRITE PRNTF FROM LINE5.
030600     WRITE PRNTF FROM LINE6.
030800     MOVE SAVE-SEQ-NO TO SEQ-VAL.
030900     WRITE PRNTF FROM LINE7.
031100     WRITE PRNTF FROM LINE8.
031200     WRITE PRNTF FROM LINE9.
031300     WRITE PRNTF FROM LINE10.
031500     PERFORM 6000-WRITE-PAGE-CONT VARYING S2 FROM 1 BY 1 UNTIL
031600             S2 > LINES-PER-PAGE
031700             OR
031800             JOBPLAN-DATA (S2) = SPACES.
032000     MOVE SPACES TO LINE11.
032100     MOVE 1 TO S1.
032200
032300 6000-WRITE-PAGE-CONT.
032400     WRITE PRNTF FROM JOBPLAN-DATA (S2).

       69-START-JOBPLAN-BANK.
           MOVE 0 TO COND-WORD.
025500     MOVE JOB-CMP-SEQ TO JOBP-SEQ-NO.
           MOVE JOBP-SEQ-NO TO SAVE-SEQ-NO.
           MOVE JOBPLAN-KEY TO GJOBPSEQ OF JBREC.
           START JOBPLAN-BANK KEY > EXTERNALLY-DESCRIBED-KEY
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF JB-STATUS NOT = "00" MOVE 17 TO COND-WORD.

       COPY OVRPFCALL IN COPYLIB.
