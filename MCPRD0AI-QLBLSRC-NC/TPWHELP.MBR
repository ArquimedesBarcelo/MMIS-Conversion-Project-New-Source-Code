       IDENTIFICATION DIVISION.
       PROGRAM-ID.             TPWHELP.
       AUTHOR.                 W. ROXBURY.
       INSTALLATION.           GOODYEAR TIRE & RUBBER CO.
      *REMARKS.                MMIS PASSWORD MAINTENANCE
      *                        HELP DISPLAY PROGRAM
      *                        ****.
       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.
       SOURCE-COMPUTER.        IBM-AS400.
       OBJECT-COMPUTER.        IBM-AS400.
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT DISPLAY-FILE
                  ASSIGN       TO WORKSTATION-ZPWSEC-SI
                  ORGANIZATION IS TRANSACTION
                  ACCESS MODE  IS SEQUENTIAL
                  FILE STATUS  IS SCREEN-STATUS
                               MAJOR-MINOR
                  CONTROL-AREA IS SCREEN-CONTROL.

       DATA DIVISION.
       FILE SECTION.
       FD  DISPLAY-FILE
           LABEL RECORDS       ARE OMITTED.
       01  DISPLAY-REC         PIC X(2000).

       WORKING-STORAGE SECTION.
       77  SCREEN-DATA         PIC X.

       01  PASSWORD-INFORMATION.
           05  NAME-OF-PROGRAM     PIC X(08) VALUE "TPWHELP ".
           05  PROGRAM-TYPE        PIC X(02) VALUE "IN".
           05  PROGRAM-RELEASE     PIC X(12) VALUE " E0100010001".
           05  PROGRAM-DESCRIPTION.
               10  PROG-DESC-A     PIC X(30) VALUE
                   "DISPLAYS HELP SCREENS FOR THE ".
               10  PROG-DESC-A     PIC X(30) VALUE
                   "MMIS PASSWORD SECURITY SYSTEM ".
               10  PROG-DESC-B     PIC X(60) VALUE
                   "MAINTENANCE PROGRAMS.         ".
               10  PROG-FUNCTION   PIC X(60) VALUE
                   "    DO NOT APPLY PASSWORD     ".
           05  PASSWORD-FLAG       PIC X.

       01  FILE-STAT.
           05 FILE-STAT-1      PIC X   VALUE "0".
           05 FILE-STAT-2      PIC X   VALUE "0".

           COPY SCREENIO       IN COPYLIB.

       01  MESSAGE-BUFFER.
           COPY ERRORLIN       IN COPYLIB.

       LINKAGE SECTION.
       01  HELP-SW                   PIC 9(04).

       PROCEDURE DIVISION USING HELP-SW.
       BEGIN.
           OPEN I-O            DISPLAY-FILE.

           IF HELP-SW < 0 OR > 40
                MOVE 0         TO HELP-SW.
           PERFORM GET-FORM.

       SHOWFORM.
           MOVE "00"           TO SCREEN-STATUS.
           MOVE SPACES         TO DISPLAY-REC.

           WRITE DISPLAY-REC  FORMAT IS SCREEN-NAME
               INDIC ARE SCREEN-INDICATORS.
           IF SCREEN-STATUS NOT = "00"
               DISPLAY "SCREEN WRITE ERROR.  SCREEN-STATUS IS "
                        SCREEN-STATUS
               GO TO END-OF-JOB.

           READ  DISPLAY-FILE FORMAT IS SCREEN-NAME
               INDIC ARE SCREEN-INDICATORS
           IF SCREEN-STATUS NOT = "00"
               DISPLAY "SCREEN READ ERROR.  SCREEN-STATUS IS "
                        SCREEN-STATUS
               GO TO END-OF-JOB.

           MOVE ALL B"0"       TO SCREEN-INDICATORS.

           IF KEY-HIT = 3
               GO TO END-OF-JOB
           ELSE
           IF KEY-HIT = 1
               MOVE 10         TO HELP-SW
               PERFORM GET-FORM
               GO TO SHOWFORM
           ELSE
           IF KEY-HIT = 2
               MOVE 20         TO HELP-SW
               PERFORM GET-FORM
               GO TO SHOWFORM
           ELSE
           IF KEY-HIT = 8
               MOVE 30         TO HELP-SW
               PERFORM GET-FORM
               GO TO SHOWFORM
           ELSE
           IF KEY-HIT = 4
               MOVE 40         TO HELP-SW
               PERFORM GET-FORM
               GO TO SHOWFORM
           ELSE
           IF KEY-HIT = 7
               MOVE  0         TO HELP-SW
               PERFORM GET-FORM
               GO TO SHOWFORM
           ELSE
               ADD 10          TO HELP-SW
               PERFORM GET-FORM
               GO TO SHOWFORM.

       GET-FORM.
           IF HELP-SW = 50
               MOVE 0          TO HELP-SW.

           IF HELP-SW = 0
               MOVE "VPWHELP"  TO SCREEN-NAME
           ELSE
           IF HELP-SW = 10
               MOVE "VHELP1"   TO SCREEN-NAME
           ELSE
           IF HELP-SW = 20
               MOVE "VHELP2"   TO SCREEN-NAME
           ELSE
           IF HELP-SW = 30
               MOVE "VHELP3"   TO SCREEN-NAME
           ELSE
           IF HELP-SW = 40
               MOVE "VHELP4"   TO SCREEN-NAME.

       END-OF-JOB.
           CLOSE               DISPLAY-FILE.
           GOBACK.

