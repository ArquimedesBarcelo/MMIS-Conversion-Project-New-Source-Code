001100 IDENTIFICATION DIVISION.
001200 PROGRAM-ID.    TQTUPD2.
001300 AUTHOR.        BARBARA WINTER.
001400 DATE-WRITTEN.  AUGUST 1987.
001500*INSTALLATION.  GOODYEAR TIRE AND RUBBER CO.
001600
001700*REMARKS.
001800*D  QUOTE UPDATE PROGRAM - UPDATES QUOTE DEFAULTS BY
001900*D  QUOTE NUMBER, VENDOR CODE, OR CORPORATE CODE.  IF
002000*D  BUYER CODE WAS CHANGED, THE ITEM HAS TO BE DELETED
002100*D  AND READDED SINCE BUYER IS A KEY, OTHERWISE THE ITEM
002200*D  IS SIMPLY UPDATED.
      *C  09/12/96  WL  MCINTYRE
      *C    MADE REVISIONS FOR YEAR 2000 COMPATABILITY
      *C
002400 ENVIRONMENT DIVISION.
002500 CONFIGURATION SECTION.
002600 SOURCE-COMPUTER.    HP-3000.
002700 OBJECT-COMPUTER.    HP-3000.
003100 INPUT-OUTPUT SECTION.
003200 FILE-CONTROL.
            SELECT DVENDITM-O
              ASSIGN TO DATABASE-MCFLCS0803
              ORGANIZATION IS INDEXED
                 ACCESS MODE IS DYNAMIC
              RECORD KEY IS EXTERNALLY-DESCRIBED-KEY WITH DUPLICATES
              FILE STATUS IS FILE-STATUS.
005400 DATA DIVISION.
005500 FILE SECTION.
       FD  DVENDITM-O
           LABEL RECORDS ARE STANDARD.
       01  DVENDITM-REC-O.
           COPY DDS-MCRPCS0800  OF MCFLCS0803.
003100 WORKING-STORAGE SECTION.
       01  FILE-STATUS.
           05  FILE-STATUS-1       PIC X.
           05  FILE-STATUS-2       PIC X.
005100
003200
003300 01  TQTUPD2-PARMS.
003400     05  UPDATE-MODE          PIC 9 VALUE 0.
003500     05  SAVE-DATE1           PIC X(6).
003600     05  SAVE-DATE2           PIC X(6).
003700     05  SAVE-DATE3           PIC X(6).
003800     05  SAVE-DATE4           PIC X(6).
003900     05  FILLER               PIC X(55) VALUE SPACES.
004000
       01  SAVE-DATE-CN-PARMS.
           05  SAVE-DATE1-CN        PIC X(8)  VALUE SPACES.
           05  SAVE-DATE2-CN        PIC X(8)  VALUE SPACES.
           05  SAVE-DATE3-CN        PIC X(8)  VALUE SPACES.
           05  SAVE-DATE4-CN        PIC X(8)  VALUE SPACES.

       01  CY-FORMAT-DATE.
           05  FORMAT-CENT          PIC X(2)  VALUE SPACES.
           05  FORMAT-DATE.
               10  FORMAT-YEAR      PIC X(2)  VALUE SPACES.
               10  FILLER           PIC X(4)  VALUE SPACES.
004100
004200*---------- VPRINTFORM
004300 01  SCREEN-PRINT-PARMS.
004400     05  PRINT-CTL            PIC S9(4)    VALUE 1 COMP.
004500     05  PAGE-CTL             PIC S9(4)    VALUE 49    COMP.
004600     05  SPOOL-FIL-OPEN-SW    PIC X        VALUE "Y".
004700 01  RETURN-STATUS            PIC X        VALUE SPACE.
004800
004900*---------- TBLOWUP (PRINTS ERRORS TO AN ERROR FILE "BLOWUP.PUB" +)
005000*---------- (ABORTS PROGRAM.  RUN XBLPRT.OBJECT TO READ ERRORS.)
005100 01  BU-DISPLAY-MSG           PIC X(60)    VALUE SPACES.
005200 01  BU-PGM-NAME              PIC X(8)     VALUE "TQTUPD2".
005300 01  BU-DISPLAY-AREA          PIC X(110)   VALUE ALL "0".
005400 01  BU-DISPLAY-FLDS REDEFINES BU-DISPLAY-AREA.
005500     05  BU-DISPLAY-LINE OCCURS 5 TIMES.
005600         10  BU-DISPLAY-FLD   PIC X(14).
005700         10  BU-DISPLAY-FLD9  PIC S9(8).
005800 01  KSAM-STATUS-AREA         PIC X(2)     VALUE "00".
005900 01  VIEW-COMAREA.
006000     05  FILLER                 PIC X(118) VALUE ALL "0".
006100     05  FILLER                 PIC S9(4)  COMP VALUE 9999.
006200
006300 01  FORM-GNAME.
006400     05  FORM-GNAME1            PIC X(5) VALUE "FLANG".
006500     05  FORM-GNAME2            PIC X(3) VALUE SPACES.
006600
006700 01  SCREEN3-BUFFER.
006800     05  V3-QUOTE              PIC X(6).
006900     05  V3-BTERMS             PIC X(2).
007000     05  V3-BUYC               PIC X(4).
007100     05  V3-FB                 PIC X(2).
007200     05  V3-EXPDATE            PIC X(8).
007300     05  V3-LEAD               PIC 9(4).
007400     05  V3-EFFDATE            PIC X(8).
007500     05  V3-TO-RETURN          PIC X(8).
007600     05  V3-RETURNED           PIC X(8).
007610     05  V3-SPLC               PIC X(10).
007700     05  FILLER                PIC X(20).
007800 COPY DATAB OF COPYLIB.
007900
008000 01  DIRECTED-ADDR            PIC S9(9)  COMP VALUE 0.
008100 01  SAVE-END-ADDR            PIC S9(9) COMP VALUE 0.
008200
009100 01  SAVE-BUFFER               PIC X(254) VALUE SPACES.
009200
009300 01  QUOTE-ARG.
009400     05  QUOTE-ARG-NUM        PIC X(6)     VALUE SPACES.
009500     05  FILLER               PIC X(4)     VALUE SPACES.
010400 COPY DVENDITM  OF COPYLIB.
010500 COPY LANGUAGE OF COPYLIB.
010600*******************************************************************
010700*                     PROCEDURE DIVISION
010800*******************************************************************
010900 PROCEDURE DIVISION.
011000
011100 00-MAIN.
011200     MOVE SPACES TO SCREEN3-BUFFER, TQTUPD2-PARMS.
011300     ACCEPT TQTUPD2-PARMS.
011400     DISPLAY TQTUPD2-PARMS.
011500     ACCEPT SCREEN3-BUFFER.
011600     DISPLAY SCREEN3-BUFFER.
           OPEN I-O DVENDITM-O.
014000     MOVE V3-QUOTE TO QUOTE-ARG-NUM.
           MOVE 0 TO COND-WORD.
           MOVE QUOTE-ARG TO QUOTENUM OF DVENDITM-REC-O.
           START DVENDITM-O KEY = QUOTENUM OF DVENDITM-REC-O
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
                   MOVE 17 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.
014900     IF NO-ENTRY
015000          GO TO 99-EXIT.
015100     IF NOT GOOD-CALL
015200        MOVE "DBFIND DVENDITM 163 TQTUPD2" TO BU-DISPLAY-MSG
015300        PERFORM 990-BLOWUP THRU 999-EXIT.
015400
016400 05-GET-ITEMS.
           MOVE 0 TO COND-WORD.
           READ DVENDITM-O NEXT INTO BUF-DVENDITM
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   MOVE 15 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.
           IF QUOTENUM OF DVENDITM-REC-O NOT = QUOTE-ARG
               MOVE 15 TO COND-WORD.
015800     IF END-OF-CHAIN
015900        GO TO 99-EXIT.
016000     IF NOT GOOD-CALL
016100        MOVE "DBGET DVENDITM 05 TQTUPD2" TO BU-DISPLAY-MSG
016200        PERFORM 990-BLOWUP THRU 999-EXIT.
016300
017000     PERFORM 200-UPDATE THRU 299-EXIT.
018000     GO TO 05-GET-ITEMS.
018100
018200 99-EXIT.
018700     CLOSE DVENDITM-O.
018800     GOBACK.
018900
021900*----------  UPDATE EACH ITEM ON QUOTE WITH NEW DEFAULT VALUES
022100 200-UPDATE.

      *-----  ADD CENTURY TO DATE FIELDS

           PERFORM 2000-FORMAT-SAVE-DATES THRU 2000-EXIT.
022200     MOVE SAVE-DATE1-CN    TO VEN-ITM-PRICE-DATE-CN.
022300     MOVE SAVE-DATE2-CN    TO VEN-CREATE-DATE-CN.
022400     MOVE SAVE-DATE3-CN    TO VEN-RETURN-DATE-CN.
022500     MOVE SAVE-DATE4-CN    TO VEN-ACTUAL-DATE-RETURNED-CN.
007000     MOVE V3-BUYC          TO VEN-BUYER-CODE.
022600     MOVE V3-FB            TO VEN-FOB.
022700     MOVE V3-BTERMS         TO VEN-TERMS.
022800     MOVE V3-LEAD           TO VEN-EST-LT.
022810     MOVE V3-SPLC          TO VEN-SPLC.
022900
           MOVE 0 TO COND-WORD.
           REWRITE DVENDITM-REC-O FROM BUF-DVENDITM
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD.
023200     IF NOT GOOD-CALL
023300     MOVE "DBUPDATE 600 TQTUPD2" TO BU-DISPLAY-MSG
023400     PERFORM 990-BLOWUP THRU 999-EXIT.
023500
023600 299-EXIT.  EXIT.
023700
       2000-FORMAT-SAVE-DATES.
           MOVE SPACES TO CY-FORMAT-DATE.
           MOVE SAVE-DATE1 TO FORMAT-DATE.
           PERFORM 20000-GET-CENT THRU 20000-EXIT.
           MOVE CY-FORMAT-DATE TO SAVE-DATE1-CN.
           MOVE SPACES TO CY-FORMAT-DATE.
           MOVE SAVE-DATE2 TO FORMAT-DATE.
           PERFORM 20000-GET-CENT THRU 20000-EXIT.
           MOVE CY-FORMAT-DATE TO SAVE-DATE2-CN.
           MOVE SPACES TO CY-FORMAT-DATE.
           MOVE SAVE-DATE3 TO FORMAT-DATE.
           PERFORM 20000-GET-CENT THRU 20000-EXIT.
           MOVE CY-FORMAT-DATE TO SAVE-DATE3-CN.
           MOVE SPACES TO CY-FORMAT-DATE.
           MOVE SAVE-DATE4 TO FORMAT-DATE.
           PERFORM 20000-GET-CENT THRU 20000-EXIT.
           MOVE CY-FORMAT-DATE TO SAVE-DATE4-CN.

       2000-EXIT.
           EXIT.

       20000-GET-CENT.
           IF FORMAT-DATE NOT NUMERIC
              GO TO 20000-EXIT.
           IF FORMAT-YEAR > "70"
              MOVE "19" TO FORMAT-CENT
           ELSE
              MOVE "20" TO FORMAT-CENT.

       20000-EXIT.
           EXIT.

023800******************************************************************
024900 990-BLOWUP.
025000     MOVE QUOTE-ARG       TO BU-DISPLAY-FLD (1).
025100     CALL "TBLOWUP" USING BASE, BU-PGM-NAME, STATUS-AREA,
025200                   VIEW-COMAREA, FILE-STATUS, BU-DISPLAY-MSG     ,
025300                   BU-DISPLAY-FLDS.
025400 999-EXIT.     EXIT.
