000200 IDENTIFICATION DIVISION.
000300 PROGRAM-ID.    TSUFFQ02.
000600 ENVIRONMENT DIVISION.
000700 CONFIGURATION SECTION.
000800 SOURCE-COMPUTER.   AS400.
000900 OBJECT-COMPUTER.   AS400.
       SPECIAL-NAMES. I-O-FEEDBACK IS I-O-FEEDBACK-AREA
                      LOCAL-DATA IS LOCAL-DATA-AREA.
001000 INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT DISPLAY-FILE
               ASSIGN TO WORKSTATION-ZSUFFIX-SI
               ORGANIZATION IS TRANSACTION
               ACCESS IS SEQUENTIAL
               FILE STATUS IS DSPLY-STATUS
               CONTROL-AREA IS WS-CONTROL.
           SELECT MASTER-PRTPLAN
               ASSIGN TO DATABASE-MCFLMM3701
               ORGANIZATION IS INDEXED
               ACCESS MODE IS SEQUENTIAL
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
               FILE STATUS IS MP-STATUS.
001100 DATA DIVISION.
       FILE SECTION.
       FD  DISPLAY-FILE
           LABEL RECORDS ARE OMITTED.
       01  DSPLY-REC               PIC X(2000).
       FD  MASTER-PRTPLAN
           LABEL RECORDS ARE STANDARD
           DATA RECORD IS MPREC.
       01  MPREC.
           COPY DDS-ALL-FORMATS OF MCFLMM3701.
001500 WORKING-STORAGE SECTION.
002900
       01  BLOWUP-BASE             PIC X(16).

       COPY CATREAD OF COPYLIB.

       COPY CPYIND  OF COPYLIB.

       01  DSPLY-STATUS            PIC XX.

       COPY IOFEEDBACK OF COPYLIB.

004600 01  MASTER-PRTPLAN-DATA.    COPY MMSTPART OF COPYLIB.
004700
004400 01  MISC-BUFFER             PIC X(80) VALUE SPACES.
004500
       01  MP-STATUS               PIC XX.

004800 01  PASSED-SPOOL-PRT        PIC 99 COMP.
004900
005200 01  PASSWORD-INFORMATION.
005300     05  NAME-OF-PROGRAM     PIC X(08) VALUE "TSUFFQ02".
005400     05  PROGRAM-TYPE        PIC X(02) VALUE "UP".
005500     05  PROGRAM-RELEASE     PIC X(12) VALUE " E0100010001".
005600     05  PROGRAM-DESCRIPTION.
005700         10  PROG-DESC-A     PIC X(60) VALUE
005800             " LIST GENERIC PRT PLANS - I2 "                     .
005900         10  PROG-DESC-B     PIC X(60) VALUE SPACES.
006100         10  PROG-FUNCTION   PIC X(60) VALUE SPACES.
006300     05  PASSWORD-FLAG       PIC X.
006400
006500 01  SCREEN-PRINT-PARMS.
006600     05  PRINTCNTL           PIC S9(4) VALUE ZERO  COMP.
006700     05  PAGECNTL            PIC S9(4) VALUE 49    COMP.
006800     05  SPOOLFIL-OPEN-SW    PIC X VALUE "N".
006900
007000 COPY DBSTAT   OF COPYLIB.
007100
007600 01  S1                      PIC S9(4) COMP-4.
007700
007800 01  SCREEN-DATA.
007900     05  SCREEN-LINE OCCURS 15 TIMES
008000                            PIC X(44).
008100     05  SCREEN-MPRTP       PIC X(10).
           05  SCREEN-CMD-LINE    PIC X(79).
           05  SCREEN-ERR-LINE    PIC X(79).
008200
       COPY TBLOWUP  OF COPYLIB.
       COPY WSCONTROL OF COPYLIB.
008300 LINKAGE SECTION.
008500 01  DBPARAMETERS.           COPY DBPARMS OF COPYLIB.
008600 COPY VCOMLINK  OF COPYLIB.
008700 COPY LANGSUB   OF COPYLIB.
009000 PROCEDURE DIVISION USING    DBPARAMETERS
009100                             VIEW-COMAREA
009200                             LANGUAGE-PARMS.
009300
009400 START-PROGRAM.
009500     PERFORM 1-HSK.
009600     PERFORM 6-MAIN UNTIL VIEW-LASTKEY = 3.
009800
009900 2-EOJ.
           CLOSE DISPLAY-FILE.
           CLOSE MASTER-PRTPLAN.
010000     GOBACK.
010100
010300 1-HSK.
           OPEN I-O   DISPLAY-FILE.
           OPEN INPUT MASTER-PRTPLAN.
010400     CALL "TPWORD" USING PASSWORD-INFORMATION.
010800     IF PASSWORD-FLAG = "N" GO TO 2-EOJ.
012500     MOVE SPACES TO SCREEN-DATA.
012300     MOVE 0 TO S1 COND-WORD.
           PERFORM 69-READ-MASTER THRU 69-RMX UNTIL (COND-WORD = 15)
               OR (S1 = 15).
011800
012000 6-MAIN.
018700     MOVE "FSUFFQ02" TO VIEW-CFNAME.
           IF S1 = 15
               MOVE 66125 TO CATREAD-MSG-NUMBER
           ELSE
           MOVE 66191 TO CATREAD-MSG-NUMBER.
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
           MOVE MISC-BUFFER TO SCREEN-CMD-LINE.
           MOVE SCREEN-DATA TO DSPLY-REC.
020700     PERFORM 99-SCREEN-WRITE.
020800     PERFORM 98-SCREEN-READ.
021900     IF VIEW-LASTKEY = 3 GO TO 2-EOJ.
           MOVE DSPLY-REC TO SCREEN-DATA.
           IF S1 = 15
               MOVE 0 TO S1
               MOVE SPACES TO SCREEN-DATA
               PERFORM 69-READ-MASTER THRU 69-RMX
                   UNTIL (COND-WORD = 15) OR (S1 = 15).
015600
015800 69-READ-MASTER.
           MOVE 0 TO COND-WORD.
           READ MASTER-PRTPLAN NEXT INTO MASTER-PRTPLAN-DATA
               AT END    MOVE 15 TO COND-WORD.
           IF MP-STATUS NOT = "00" MOVE 15 TO COND-WORD.
016900     IF COND-WORD = 0
017000         ADD 1 TO S1
               MOVE MASTER-PRTPLAN-DATA TO SCREEN-LINE (S1)
017200     ELSE
017300     IF COND-WORD = 15
017400         NEXT SENTENCE
017500     ELSE
017600     PERFORM 998-BLOWUP.
017800
018200 69-RMX.    EXIT.

       98-SCREEN-READ.
           READ DISPLAY-FILE FORMAT IS VIEW-CFNAME
               INDIC IS INDICS.
           ACCEPT IOFEEDBACK FROM I-O-FEEDBACK-AREA.
           MOVE ALL B"0" TO INDICS.
           IF DSPLY-STATUS NOT = "00"
               MOVE 3 TO VIEW-LASTKEY
           ELSE
           MOVE FUNCTION-NUM TO VIEW-LASTKEY.

       99-SCREEN-WRITE.
           WRITE DSPLY-REC FORMAT IS VIEW-CFNAME
               INDIC IS INDICS.
           MOVE ALL B"0" TO INDICS.

076200 998-BLOWUP.
076300     MOVE "TSUFFQ01" TO BU-PGM-NAME.
076400     CALL "TBLOWUP" USING BLOWUP-BASE BU-PGM-NAME STATUS-AREA
076500                      VIEW-COMAREA DUMMY-KSAM-STAT
076600                      BU-DISPLAY-MSG BU-DISPLAY-FLDS.

049700 999-CATREAD.
049800     MOVE SPACES TO MISC-BUFFER.
049900     CALL "CCATREAD" USING CATREAD-PARMS.
           MOVE CATREAD-MSG-TEXT TO MISC-BUFFER.
050800 999-CATREAD-EXIT.    EXIT.
