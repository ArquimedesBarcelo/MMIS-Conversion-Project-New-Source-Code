009000********* DSET NAMES FOR STORES HISTORY 'STHIST'
009100
009200     05  DSET-DPODESC-H         PIC X(16)  VALUE "DPODESC;".
009300     05  DSET-DRCVITEM-H        PIC X(16)  VALUE "DRCVITEM;".
009400
009800 COPY DBSTAT IN COPYLIB.
009900
010000 01 ITEMS-LISTING.
010100     05  ALL-ITEMS              PIC XX    VALUE "@;".
010200     05  PO-SEARCH              PIC X(10) VALUE "PO-RCV-NO;".
010300     05  VEN-SEARCH             PIC X(10) VALUE "VEN-CODE;".
010400     05  REG-SEARCH             PIC X(16)
010500                                VALUE "REGISTER-NUMBER;".
010600
010700 01  ARG-VALUES.
010800     05  PO-ARG                 PIC X(14) VALUE SPACES.
010900     05  VEN-ARG                PIC X(10) VALUE SPACES.
011000     05  REGISTER-ARG           PIC X(6)  VALUE SPACES.
011100     05  RCVR-ARG.
011200         10  RCVR-PO-NUM        PIC X(7)  VALUE SPACES.
011300         10  RCVR-PO-REL        PIC X(3)  VALUE SPACES.
011400         10  RCVR-PO-RCVR       PIC 9(3)  VALUE ZEROS.
011500         10  RCVR-DUP-ID        PIC X     VALUE SPACES.
011600
011700
012400 COPY TDATECHK IN COPYLIB.
012500
012600 COPY TBLOWUP IN COPYLIB.
012700
012800 LINKAGE SECTION.
012900
013000 01  BASE-STHIST      PIC X(10).
013100
013200 01  BUILD-PO-NUMBER.
013300     05  BUILD-PO-NUM           PIC X(7).
013400     05  BUILD-PO-REL           PIC X(3).
013500     05  BUILD-PO-RCVR          PIC 9(3).
013600     05  BUILD-PO-DUP-ID        PIC 9.
013700
