014300
014400 PO-HISTORY-DELETE SECTION 15.
       BEGIN-HERE.
           OPEN I-O DPORECDH-O, DPOITEMH-O, DPODESCH-O, DVENDORH-O,
                    DPOFREIGHTH-O, DRCVITEMH-O, DINVRCDH-O, DINVITMH-O,
                    DINVACCTH-O, DRCVCORRH-O.
           OPEN INPUT DPORECDH-I.

014500
014600     PERFORM 6-MAIN  THRU  6-MAIN-X.
014700
           CLOSE DPORECDH-O, DPOITEMH-O, DPODESCH-O, DVENDORH-O,
                 DPOFREIGHTH-O, DRCVITEMH-O, DINVRCDH-O, DINVITMH-O,
                 DINVACCTH-O, DPORECDH-I, DRCVCORRH-O.
014800     GOBACK.
014900
015000
015100
015200******************************************************
015300**                                                  **
015400**   BLOWUP ROUTINE                                 **
015500**                                                  **
015600******************************************************
015700
015800 2-BLOWUP.
015900     MOVE "SPOHTDL"  TO BU-PGM-NAME.
016000     CALL "TBLOWUP" USING BASE-STHIST, BU-PGM-NAME, STATUS-AREA,
016100         DUMMY-VIEW-AREA, DUMMY-KSAM-STAT, BU-DISPLAY-MSG,
016200             BU-DISPLAY-FLDS.
016300
016400
016500
016600 6-MAIN.
017600     MOVE BUILD-PO-NUMBER       TO  PO-ARG,
017700                                    BU-DISPLAY-FLD (1).
018300
018400     PERFORM 62-DELETE-PO-HISTORY  THRU  62-DPH-X.
018500
018600     PERFORM 63-DELETE-RECEIVING-HISTORY  THRU  63-DRH-X.
018700
018800     PERFORM 64-DELETE-INVOICING-HISTORY  THRU  64-DIH-X.
019500
019600 6-MAIN-X.
019700     EXIT.
019800
019900
020000
020100 62-DELETE-PO-HISTORY.
           MOVE ZEROS TO SAVE-LAST-RCVR.
021100     MOVE SPACES   TO  BUF-DPORECD-H.

           MOVE PO-ARG TO PORCVNO OF DPORECDH-REC-O.
           START DPORECDH-O KEY = PORCVNO OF DPORECDH-REC-O
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
                   GO TO 62-DELETE-ITEMS
               ELSE
                   MOVE "START DPORECDH *62-DPH" TO BU-DISPLAY-MSG
                   GO TO 2-BLOWUP.
021000
           MOVE 0 TO COND-WORD.
           READ DPORECDH-O NEXT INTO BUF-DPORECD-H
               AT END MOVE 15 TO COND-WORD.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14"
                   MOVE 15 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.
           IF PORCVNO OF DPORECDH-REC-O NOT = PO-ARG
               MOVE 15 TO COND-WORD.
021200*A   CALL "DBGET" USING BASE-STHIST, DSET-DPORECD, MODE5,
021300*A         STATUS-AREA, ALL-ITEMS, BUF-DPORECD-H, PO-ARG.
021400     IF COND-WORD NOT = 0
021500         IF COND-WORD = 15
021600             GO TO 62-DELETE-ITEMS
021700         ELSE
021800             MOVE "GET DPORECD*62-DPH" TO BU-DISPLAY-MSG
021900             GO TO 2-BLOWUP.
022000
022100     MOVE POH-LAST-RCVR         TO  SAVE-LAST-RCVR.
022200
022300 62-DELETE-HEADER.
           DELETE DPORECDH-O
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
022700         MOVE "DELETE DPORECD*62-DH" TO BU-DISPLAY-MSG
022800         GO TO 2-BLOWUP.
022900
023000 62-DELETE-ITEMS.
023100     PERFORM 621-DELETE-PO-ITEMS  THRU  621-DPI-X.
023200
023300     PERFORM 622-DELETE-VENDOR-NAME  THRU  622-DVN-X.
023400
023500 62-DPH-X.
023600     EXIT.
023700
023800
023900 621-DELETE-PO-ITEMS.
           MOVE PO-ARG TO PORCVNO OF DPOITEMH-REC-O.
           START DPOITEMH-O KEY = PORCVNO OF DPOITEMH-REC-O
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
024400             GO TO 621-DPI-X
024500         ELSE
024600             MOVE "FIND DPOITEM * 621-DPI" TO BU-DISPLAY-MSG
024700             GO TO 2-BLOWUP.
024800
024900 621-GET-DPOITEM.
           MOVE 0 TO COND-WORD.
           READ DPOITEMH-O NEXT INTO BUF-DPOITEM-H
               AT END MOVE 15 TO COND-WORD.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14"
                   MOVE 15 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.
           IF PORCVNO OF DPOITEMH-REC-O NOT = PO-ARG
               MOVE 15 TO COND-WORD.
025000*A   CALL "DBGET" USING BASE-STHIST, DSET-DPOITEM, MODE5,
025100*A         STATUS-AREA, ALL-ITEMS, BUF-DPOITEM-H, PO-ARG.
025200     IF COND-WORD NOT = 0
025300         IF COND-WORD = 15
025400             GO TO 621-FIND-DPODESC
025500         ELSE
025600             MOVE "GET DPOITEM*621-GD" TO BU-DISPLAY-MSG
025700             GO TO 2-BLOWUP.
025800
025900
026000 621-DELETE-DPOITEM.
           DELETE DPOITEMH-O
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
026400         MOVE "DELETE DPOITEM*621-DD" TO BU-DISPLAY-MSG
026500         GO TO 2-BLOWUP.
026600
026700     GO TO 621-GET-DPOITEM.
026800
026900 621-FIND-DPODESC.
           MOVE PO-ARG TO PORCVNO OF DPODESCH-REC-O.
           START DPODESCH-O KEY = PORCVNO OF DPODESCH-REC-O
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
027400             GO TO 621-DPI-X
027500         ELSE
027600             MOVE "FIND DPODESC*621-FD" TO BU-DISPLAY-MSG
027700             GO TO 2-BLOWUP.
027800
027900 621-GET-DPODESC.
           MOVE 0 TO COND-WORD.
           READ DPODESCH-O NEXT INTO BUF-DPODESC-H
               AT END MOVE 15 TO COND-WORD.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14"
                   MOVE 15 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.
           IF PORCVNO OF DPODESCH-REC-O NOT = PO-ARG
               MOVE 15 TO COND-WORD.
028000*A   CALL "DBGET" USING BASE-STHIST, DSET-DPODESC-H, MODE5,
028100*A       STATUS-AREA, ALL-ITEMS, BUF-DPODESC-H, PO-ARG.
028200     IF COND-WORD NOT = 0
028300         IF COND-WORD = 15
028400             GO TO 621-DPI-X
028500         ELSE
028600             MOVE "GET DPODESC*621-GD" TO BU-DISPLAY-MSG
028700             GO TO 2-BLOWUP.
028800
028900 621-DELETE-DPODESC.
           DELETE DPODESCH-O
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
029300         MOVE "DELETE DPODESC*621-PD" TO BU-DISPLAY-MSG
029400         GO TO 2-BLOWUP.
029500
029600     GO TO 621-GET-DPODESC.
029700
029800 621-DPI-X.
029900     EXIT.
030000
030100
030200 622-DELETE-VENDOR-NAME.
030300     MOVE POH-VEN-CODE          TO  VEN-ARG.
           MOVE VEN-ARG TO VENCDE OF DPORECDH-REC-I.
           START DPORECDH-I KEY = VENCDE OF DPORECDH-REC-I
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
030800             NEXT SENTENCE
030900         ELSE
031000             MOVE "FIND DPORECD*622-DVN" TO BU-DISPLAY-MSG
031100             GO TO 2-BLOWUP
           ELSE
               GO TO 622-DVN-X.

           MOVE VEN-ARG TO VENCDE OF DVENDORH-REC-O.
           START DVENDORH-O KEY = VENCDE OF DVENDORH-REC-O
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
                   GO TO 622-DVN-X
               ELSE
032000             MOVE "FIND DVENDOR * 622-DVN" TO BU-DISPLAY-MSG
032100             GO TO 2-BLOWUP.
032200
032300 622-GET-DVENDOR.
           MOVE 0 TO COND-WORD.
           READ DVENDORH-O NEXT INTO BUF-DVENDOR-H
               AT END MOVE 15 TO COND-WORD.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14"
                   MOVE 15 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.
           IF VENCDE OF DVENDORH-REC-O NOT = VEN-ARG
               MOVE 15 TO COND-WORD.
032400*A   CALL "DBGET" USING BASE-STHIST, DSET-DVENDOR, MODE5,
032500*A         STATUS-AREA, ALL-ITEMS, BUF-DVENDOR-H, VEN-ARG.
032600     IF COND-WORD NOT = 0
032700         IF COND-WORD = 15
032800             GO TO 622-DVN-X
032900         ELSE
033000             MOVE "GET DVENDOR*622-GD" TO BU-DISPLAY-MSG
033100             GO TO 2-BLOWUP.
033200
033300
033400 622-DELETE-DVENDOR.
           DELETE DVENDORH-O
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
033800         MOVE "PUT DVENDOR*622-PD" TO BU-DISPLAY-MSG
033900         GO TO 2-BLOWUP.
034000
034100     GO TO 622-GET-DVENDOR.
034200
034300 622-DVN-X.
034400     EXIT.
034500
034600
034700
034800
034900 63-DELETE-RECEIVING-HISTORY.
035000     MOVE BUILD-PO-NUMBER       TO  RCVR-ARG.
035100
035200****** LOAD ALL FREIGHT BILLS FOUND UNDER THE PO NUMBER KEY
035300****** SINCE THESE FREIGHT BILLS CAN BE PUT OUT BY THE INVOICE
035400****** PROCESSING PROGRAM.
035500
035600     PERFORM 631-DELETE-FREIGHT-INFO  THRU  631-DFI-X.
035700
035800 63-DELETE-RCVR-LOOP.
035900     IF SAVE-LAST-RCVR = RCVR-PO-RCVR
036000         GO TO 63-DRH-X.
036100     ADD 1  TO  RCVR-PO-RCVR.
036200     PERFORM 631-DELETE-FREIGHT-INFO  THRU  631-DFI-X.
036300
036400******** LOAD RECEIVING SLIP ITEMS
036500
036600     PERFORM 632-DELETE-RCV-SLIP  THRU  632-DRS-X.
036700
036800     GO TO 63-DELETE-RCVR-LOOP.
036900
037000 63-DRH-X.
037100     EXIT.
037200
037300 631-DELETE-FREIGHT-INFO.
           MOVE RCVR-ARG TO PORCVNO OF DPOFREIGHTH-REC-O.
           START DPOFREIGHTH-O KEY = PORCVNO OF DPOFREIGHTH-REC-O
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
037800             GO TO 631-DFI-X
037900         ELSE
038000             MOVE "FIND DPOFREIGHT * 631-DFI" TO BU-DISPLAY-MSG
038100             GO TO 2-BLOWUP.
038200
038300 631-GET-FREIGHT-LOOP.
           MOVE 0 TO COND-WORD.
           READ DPOFREIGHTH-O NEXT INTO BUF-DPOFREIGHT-H
               AT END MOVE 15 TO COND-WORD.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14"
                   MOVE 15 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.
           IF PORCVNO OF DPOFREIGHTH-REC-O NOT = RCVR-ARG
               MOVE 15 TO COND-WORD.
038400*A   CALL "DBGET" USING BASE-STHIST, DSET-DPOFREIGHT, MODE5,
038500*A         STATUS-AREA, ALL-ITEMS, BUF-DPOFREIGHT-H, RCVR-ARG.
038600     IF COND-WORD NOT = 0
038700         IF COND-WORD = 15
038800             GO TO 631-DFI-X
038900         ELSE
039000             MOVE "GET DPOFREIGHT*631-GFL" TO BU-DISPLAY-MSG
039100             GO TO 2-BLOWUP.
039200
039300 631-DELETE-FREIGHT.
           DELETE DPOFREIGHTH-O
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
039700         MOVE "DELETE DPOFREIGHT*631-DF" TO BU-DISPLAY-MSG
039800         GO TO 2-BLOWUP.
039900
040000     GO TO 631-GET-FREIGHT-LOOP.
040100
040200 631-DFI-X.
040300     EXIT.
040400
040500 632-DELETE-RCV-SLIP.
           MOVE RCVR-ARG TO PORCVNO OF DRCVITEMH-REC-O.
           START DRCVITEMH-O KEY = PORCVNO OF DRCVITEMH-REC-O
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
041000             GO TO 632-DRS-X
041100         ELSE
041200             MOVE "FIND DRCVITEM * 632-DRS" TO BU-DISPLAY-MSG
041300             GO TO 2-BLOWUP.
041400
041500 632-GET-RCVR-ITEM-LOOP.
           MOVE 0 TO COND-WORD.
           READ DRCVITEMH-O NEXT INTO BUF-DRCVITEM-H
               AT END MOVE 15 TO COND-WORD.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14"
                   MOVE 15 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.
           IF PORCVNO OF DRCVITEMH-REC-O NOT = RCVR-ARG
