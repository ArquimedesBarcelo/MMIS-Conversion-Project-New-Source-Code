008000 01  DSET-NAMES.
008100     05  DSET-NAME              PIC X(16)  VALUE SPACES.
008200     05  DSET-DPORECD           PIC X(16)  VALUE "DPORECD;".
008300     05  DSET-DPOITEM           PIC X(16)  VALUE "DPOITEM;".
008400     05  DSET-DPOFREIGHT        PIC X(16)  VALUE "DPOFREIGHT;".
008500     05  DSET-DINVRCD           PIC X(16)  VALUE "DINVRCD;".
008600     05  DSET-DINVITM           PIC X(16)  VALUE "DINVITM;".
008700     05  DSET-DINVACCT          PIC X(16)  VALUE "DINVACCT;".
008800     05  DSET-DVENDOR           PIC X(16)  VALUE "DVENDOR;".
