019700 01  STORES-PASSWORD      PIC X(8)    VALUE "JADE; ".
019800
019900 COPY DBMODES IN COPYLIB.
020000
020100 COPY DBSTAT  IN COPYLIB.
020200
020300 01  DATASET-NAMES.
020400     05  DSET-MMATL-ACCUM PIC X(16)  VALUE "MMATL-ACCUM;".
020500     05  DSET-MSTORERM    PIC X(16)  VALUE "MSTORERM;".
020600     05  DSET-MACCT       PIC X(16)  VALUE "MACCOUNT-INFO;".
020700     05  DSET-DTRANS      PIC X(16)  VALUE "DTRANS;".
020900
021000 01  ITEMS-LISTING.
021100     05  ALL-ITEMS        PIC X(2)   VALUE "@;".
021200     05  MATL-KEY         PIC X(10)  VALUE "MATL-CODE;".
021300     05  CORP-KEY         PIC X(10)  VALUE "CORP-CODE;".
021400
021500 01  IMAGE-ARGS.
021600     05  MMATL-CODE-ARG    PIC X(8)   VALUE SPACES.
021700     05  MACCT-KEY         PIC X(4)  VALUE SPACES.
021800
021900******************************************
022000**   PARAMETERS FOR CALLING 'CBLOWSRT'
022100******************************************
022200
022300*COPY CBLOWSRT IN COPYLIB.
022400*
022500 COPY TBLOWUP IN COPYLIB.
022600
022900 PROCEDURE DIVISION.
023000
023100 001-BEGIN SECTION.
023200
023300 010-MAINLINE.
           MOVE "C" TO MCXCBLERR-SCOPE.
           CALL "MCXCBLERR" USING MCXCBLERR-SCOPE.

023400*******************************************************
023500**   CALL 'CBLOWSRT' FIRST BEFORE GOING INTO THE
023600**   SORT VERB.  THE FIRST CALL TO 'CBLOWSRT' OPENS
023700**   UP A NEW TEMPORARY FILE 'BLUPDATA' THAT IS USED
023800**   TO WRITE THE BLOWUP INFORMATION IF A BLOWUP
023900**   OCCURS
024000*******************************************************
024100*
024200*    CALL "CBLOWSRT" USING CBLOWSRT-PARMS,
024300*                          ACCTG-BASE,
024400*                          BU-PGM-NAME,
024500*                          STATUS-AREA,
024600*                          DUMMY-VIEW-AREA,
024700*                          DUMMY-KSAM-STAT,
024800*                          BU-DISPLAY-MSG,
024900*                          BU-DISPLAY-FLDS.
025000
025100     SORT SORT-FILE ON ASCENDING KEY SORT-DELETE-FLAG
025200                                     SORT-CLASS
025300                                     SORT-MATL-CODE
025400         INPUT PROCEDURE IS 050-PROCESS-TRANS
025500         OUTPUT PROCEDURE IS 700-CREATE-REPORT.
025600     PERFORM 1000-CLOSE-FILES.
025700     GOBACK.
025800
025900
026000 050-PROCESS-TRANS SECTION.
       050-PROCESS-TRANS-PARA.
026100     PERFORM 100-BEGIN.
026200     PERFORM 200-PROCESS-DETAIL
026300         UNTIL END-OF-FILE.
026400
026500**********************************************************
026600*  TRANSFER CONTROL TO LAST STATEMENT IN INPUT PROCEDURE *
026700*  FOR SORTING OF RECORDS.                               *
026800**********************************************************
026900
027000     GO TO 699-PROCESS-EXIT.
027100
027200 100-BEGIN.
           OPEN I-O MATLACUM-O, DTRANS-O.
           OPEN INPUT MSTORERM-I, MACTINFO-I.

029200     MOVE "MY"                    TO MACCT-KEY.
           MOVE MACCT-KEY  TO INFOKEY OF MACTINFO-REC-I.
           READ MACTINFO-I INTO BUF-MACCT-INFO
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS = "00"
030100         MOVE MACCT-MONTH         TO MONTH-PARM
030200         MOVE MACCT-YEAR          TO YEAR-PARM
030300     ELSE
030400         MOVE "DBGET MACCOUNT-INFO * 100-B" TO BU-DISPLAY-MSG
030500         MOVE MACCT-KEY TO BU-DISPLAY-FLD (1)
030600         PERFORM 990-BLOWUP.
030700     MOVE SPACES                  TO SORT-REC.
034500     MOVE ZEROS                   TO SORT-BEG-UNITS
034600                                     SORT-BEG-DOLLARS
034700                                     SORT-UNITS-RNI
034800                                     SORT-RCPT-DOLLARS
034900                                     SORT-UNITS-INR
035000                                     SORT-DOLLARS-INR.

           MOVE SPACES TO MATLCODE OF MATLACUM-REC-O.
           START MATLACUM-O KEY >= MATLCODE OF MATLACUM-REC-O
             INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.

030800     PERFORM 400-GET-MMATL-ACCUM.
030900
031000
031100 200-PROCESS-DETAIL.
031200     IF MATL-STORES-CODE = "NON-STR"
031300         NEXT SENTENCE
031400     ELSE
031500         IF MATL-STORES-CODE-1-4  IS ALPHABETIC
031600             NEXT SENTENCE
031700         ELSE
031800             PERFORM 600-BUILD-SORT-REC.
031900     PERFORM 400-GET-MMATL-ACCUM.
032000
032100 400-GET-MMATL-ACCUM.
           MOVE 0 TO COND-WORD.
           READ MATLACUM-O NEXT INTO BUF-MATLACUM
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   MOVE 11 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.
032900     IF GOOD-CALL
033000         NEXT SENTENCE
033100     ELSE
033200         IF END-OF-FILE
033300             NEXT SENTENCE
033400         ELSE
033500             MOVE "GET MMATL-ACCUM * 400-GMC" TO BU-DISPLAY-MSG
033600             PERFORM 990-BLOWUP.
033700
033800 600-BUILD-SORT-REC.
033900     PERFORM 650-GET-MSTORERM.
034000     IF NO-ENTRY
034100         DISPLAY "CODE = " MATL-STORES-CODE
034200         PERFORM 660-CHECK-BALANCES
034300         RELEASE SORT-REC
034400         MOVE SPACES              TO SORT-REC
034500         MOVE ZERO                TO SORT-BEG-UNITS
034600                                     SORT-BEG-DOLLARS
034700                                     SORT-UNITS-RNI
034800                                     SORT-RCPT-DOLLARS
034900                                     SORT-UNITS-INR
035000                                     SORT-DOLLARS-INR.
035100
035200 650-GET-MSTORERM.
           MOVE 0 TO COND-WORD.
035300     MOVE MATL-STORES-CODE TO MMATL-CODE-ARG.
           MOVE MMATL-CODE-ARG TO CORPCDE OF MSTORERM-REC-I.
           READ MSTORERM-I INTO BUF-MSTORERM
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS-1 = "2"
               MOVE 17 TO COND-WORD
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD.
036100     IF GOOD-CALL
036200         NEXT SENTENCE
036300     ELSE
036400         IF NO-ENTRY
036500             NEXT SENTENCE
036600         ELSE
036700             MOVE "GET MSTORERM * 650-GM" TO BU-DISPLAY-MSG
036800             MOVE MMATL-CODE-ARG TO BU-DISPLAY-FLD (1)
036900             PERFORM 990-BLOWUP.
037000
037100 660-CHECK-BALANCES.
037200********************************************************
037300**   CALL 'SOPNRAV' TO GET STOREROOM OPEN RECEIVERS
037400**   AND INVOICES
037500********************************************************
037600     MOVE MMATL-CODE-ARG          TO SOPNRAV-MATL-CODE.
037700     CALL "SOPNRAV" USING ACCTG-BASE,
037800                          SOPNRAV-PARMS,
037900                          STATUS-AREA,
038000                          BU-DISPLAY-MSG,
038100                          BU-DISPLAY-FLDS.
038200     IF BU-DISPLAY-MSG NOT = SPACES
038300         PERFORM 990-BLOWUP.
038400
038500     IF MATL-BEG-BAL-DOLLARS = 0
038600         NEXT SENTENCE
038700     ELSE
038800         ADD 1 TO NO-DELETE
038900         MOVE MATL-BEG-BAL-DOLLARS  TO SORT-BEG-DOLLARS.
039000     IF MATL-BEG-BAL-UNITS = 0
039100         NEXT SENTENCE
039200     ELSE
039300         ADD 1 TO NO-DELETE
039400         MOVE MATL-BEG-BAL-UNITS TO SORT-BEG-UNITS.
039500     IF S-STR-OPEN-RCVR-DLRS = 0
039600         NEXT SENTENCE
039700     ELSE
039800         ADD 1 TO NO-DELETE
039900         MOVE S-STR-OPEN-RCVR-DLRS TO SORT-RCPT-DOLLARS.
040000     IF S-STR-OPEN-RCVR-UNITS = 0
040100         NEXT SENTENCE
040200     ELSE
040300         ADD 1 TO NO-DELETE
040400         MOVE S-STR-OPEN-RCVR-UNITS TO SORT-UNITS-RNI.
040500     IF S-STR-OPEN-INV-UNITS = 0
040600         NEXT SENTENCE
040700     ELSE
040800         ADD 1 TO NO-DELETE
040900         MOVE S-STR-OPEN-INV-UNITS TO SORT-UNITS-INR.
041000     IF S-STR-OPEN-INV-DLRS = 0
041100         NEXT SENTENCE
041200     ELSE
041300         ADD 1 TO NO-DELETE
041400         MOVE S-STR-OPEN-INV-DLRS TO SORT-DOLLARS-INR.
041500
041600     MOVE MATL-STORES-CODE        TO SORT-MATL-CODE,
041700                                     BU-DISPLAY-FLD (1).
041800     MOVE MATL-CLASS              TO SORT-CLASS.
041900
042000************************************************
042100**   SORT-DELETE-FLAG = 2 ITEM CANT BE DELETED
042200**   SORT-DELETE-FLAG = 1 ITEM WILL BE DELETED
042300************************************************
042400     IF NO-DELETE > 0
042500         MOVE 0 TO NO-DELETE
042600         MOVE 2 TO SORT-DELETE-FLAG
042700     ELSE
042800         MOVE 1 TO SORT-DELETE-FLAG
042900         PERFORM 670-DELETE-CODE.
043000
043100 670-DELETE-CODE.
043200*************************************************
043300**   DELETE DTRANS ENTRIES IF ANY FOR THE CODE
043400*************************************************
           MOVE MMATL-CODE-ARG TO MATLCODE OF DTRANS-REC-O.
           START DTRANS-O KEY = MATLCODE OF DTRANS-REC-O
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
                   NEXT SENTENCE
               ELSE
044400             MOVE "DBFIND DTRANS * 680-FD" TO BU-DISPLAY-MSG
044500             PERFORM 990-BLOWUP
044600     ELSE
045000         PERFORM 680-DELETE-DTRANS.
045100
047200**************************************
047300**   DELETE MMATL-ACCUM
047400**************************************
           DELETE MATLACUM-O
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
049200         MOVE "DBDELETE MMATL * 670-DC" TO BU-DISPLAY-MSG
049300         PERFORM 990-BLOWUP.
050500
050600 680-DELETE-DTRANS.
051700     PERFORM 690-GET-DTRANS
051800         UNTIL END-OF-CHAIN.
      *------- DO A START > HIGH-VALUES TO UNLOCK
           MOVE HIGH-VALUES TO MATLCODE OF DTRANS-REC-O.
           START DTRANS-O KEY > MATLCODE OF DTRANS-REC-O
               INVALID KEY MOVE "00" TO FILE-STATUS.
053000
053100 690-GET-DTRANS.
           MOVE 0 TO COND-WORD.
           READ DTRANS-O NEXT INTO BUF-DTRANS
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   MOVE 15 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.
           IF MATLCODE OF DTRANS-REC-O NOT = MMATL-CODE-ARG
               MOVE 15 TO COND-WORD.
053900     IF GOOD-CALL
               DELETE DTRANS-O
                   INVALID KEY MOVE FILE-STATUS TO FILE-STATUS
               END-DELETE
               IF FILE-STATUS = "00"
                   NEXT SENTENCE
               ELSE
054700             MOVE "DELETE DTRANS * 690-GD" TO BU-DISPLAY-MSG
054800             PERFORM 990-BLOWUP
054900     ELSE
055000         IF END-OF-CHAIN
055100             NEXT SENTENCE
055200         ELSE
055300             MOVE "DBGET DTRANS * 690-GD" TO BU-DISPLAY-MSG
055400             PERFORM 990-BLOWUP.
055500
060800 699-PROCESS-EXIT.
060900     EXIT.
061000
061100 700-CREATE-REPORT SECTION.
       700-CREATE-REPORT-PARA.
061200     DISPLAY "BEGIN REPORT".
061300     PERFORM 710-BEGIN-REPORT.
061400     PERFORM 720-PROCESS-CLASS
061500        UNTIL NO-MORE-SORT = "YES".
061600
061700**************************************************
061800**  BRANCH TO LAST STATEMENT OF OUTPUT SECTION  **
061900**  TO COMPLETE PROCESSING OF REPORT            **
062000**************************************************
062100
062200     GO TO 799-CREATE-EXIT.
062300
062400 710-BEGIN-REPORT.
062500     OPEN OUTPUT ONLINE-PRT.
062600     RETURN SORT-FILE
062700        AT END
062800            MOVE "YES" TO NO-MORE-SORT.
062900     PERFORM 750-PRINT-HEADINGS.
063000     IF NO-MORE-SORT = "YES"
063100         WRITE PRT-REC FROM NO-CODES-FOUND-MSG AFTER 2.
063200
063300 720-PROCESS-CLASS.
063400     PERFORM 721-BEGIN-REPORT.
063500     PERFORM 722-PROCESS-TRANS
063600         UNTIL SORT-DELETE-FLAG NOT = PREV-DELETE-FLAG
063700             OR NO-MORE-SORT = "YES".
063800     PERFORM 723-END-REPORT.
063900
064000 721-BEGIN-REPORT.
064100     MOVE SORT-DELETE-FLAG        TO PREV-DELETE-FLAG.
064200
064300
064400
064500 722-PROCESS-TRANS.
064600     MOVE SORT-CLASS              TO PRT-CLASS.
064700     MOVE SORT-MATL-CODE          TO PRT-CODE.
064800     IF SORT-DELETE-FLAG = 2
064900         MOVE SORT-BEG-DOLLARS    TO PRT-BEG-DLRS
065000         MOVE SORT-BEG-UNITS      TO PRT-BEG-UNITS
065100         MOVE SORT-RCPT-DOLLARS   TO PRT-OPEN-RCVR-DLRS
065200         MOVE SORT-UNITS-RNI      TO PRT-OPEN-RCVR-UNITS
065300         MOVE SORT-UNITS-INR      TO PRT-OPEN-INV-UNITS
065400         MOVE SORT-DOLLARS-INR    TO PRT-OPEN-INV-DLRS
065500         MOVE "CODE NOT DELETED"  TO PRT-DELETE-DESCR
065600         WRITE PRT-REC FROM DETAIL-LINE AFTER 2
065700         ADD 2                    TO LINE-CNT
065800         ADD 1                    TO TOT-CODES
065900     ELSE
066000         MOVE "CODE DELETED"      TO PRT-DELETE-DESCR
066100         WRITE PRT-REC FROM DETAIL-LINE AFTER 2
066200         ADD 2                    TO LINE-CNT
066300         ADD 1                    TO TOT-CODES.
066400     IF LINE-CNT > 55
066500         PERFORM 750-PRINT-HEADINGS.
066600     RETURN SORT-FILE
066700        AT END
066800             MOVE "YES"           TO NO-MORE-SORT.
066900
067000 723-END-REPORT.
067100     MOVE "TOTAL CODES"           TO TOT-DESCR.
067200     MOVE TOT-CODES               TO PRT-TOT-CODES.
067300     WRITE PRT-REC FROM TOT-LINE AFTER 3.
067400     MOVE ZERO                    TO TOT-CODES.
067500     IF NO-MORE-SORT = "YES"
067600         NEXT SENTENCE
067700     ELSE
067800         PERFORM 750-PRINT-HEADINGS.
067900
068000
068100 750-PRINT-HEADINGS.
068200     MOVE 1                       TO DATE-MODE.
068300     CALL "TDATECHK" USING DATE-CHECK-AREA.
068400     MOVE DATE-SLASH-OUT          TO DATE-H1.
068500     MOVE DATE-FORMATTED-TIME-OUT TO TIME-H2.
068600     MOVE MONTH-T (MONTH-PARM)    TO MONTH-H3.
068700     MOVE YEAR-PARM               TO YEAR-H3B.
068800     ADD 1                        TO PAGE-CNT.
068900     MOVE PAGE-CNT                TO PAGE-H2.
069000     WRITE PRT-REC FROM HEADER1 AFTER ADVANCING TOP-OF-FORM.
069100     WRITE PRT-REC FROM HEADER2 AFTER ADVANCING 1.
069200     WRITE PRT-REC FROM HEADER3 AFTER ADVANCING 1.
069300     WRITE PRT-REC FROM HEADER4 AFTER ADVANCING 2.
069400     WRITE PRT-REC FROM HEADER5 AFTER ADVANCING 1.
069500     MOVE SPACES                  TO PRT-REC.
069600     WRITE PRT-REC AFTER ADVANCING 1.
069700     MOVE 7                       TO LINE-CNT.
069800
069900
070000 799-CREATE-EXIT.
070100     EXIT.
070200
070300 900-ERROR SECTION.
070400
070500 990-BLOWUP.
070600
070700***************************************************************
070800**   CALL 'CBLOWSRT' INSTEAD OF 'TBLOWUP' WHEN A BLOWUP      **
070900**   SITUATION OCCURS SINCE THIS PROGRAM USES THE 'SORT'     **
071000**   VERB.  'CBLOWSRT' WRITES ALL THE BLOWUP INFORMATION     **
071100**   TO A TEMPORARY FILE 'BLUPDATA' (WHICH WAS OPENED AT     **
071200**   THE BEGINNING OF THE PROGRAM) THE CLOSES IT. THEN IT    **
071300**   CREATESA A SON PROCESS 'XBLOWSRT' THAT READS THE        **
071400**   BLOWUP INFORMATION OUT OF 'BLUPDATA' AND CALLS          **
071500**   'TBLOWUP' USING THIS INFO.  SINCE THE NEW PROCESS       **
071600**   'XBLOWSRT' HAS ITS OWN STACK THE STACK OVERFLOW         **
071700**   PROBLEM IS AVOIDED.                                     **
071800***************************************************************
071900
072000     MOVE "TCSDLCDE"              TO  BU-PGM-NAME.
           CALL "TBLOWUP" USING ACCTG-BASE, BU-PGM-NAME, STATUS-AREA,
               DUMMY-VIEW-AREA, FILE-STATUS, BU-DISPLAY-MSG,
                       BU-DISPLAY-FLDS.
072100**   CALL "CBLOWSRT" USING CBLOWSRT-PARMS,
072200**                         ACCTG-BASE,
072300**                         BU-PGM-NAME,
072408**                         STATUS-AREA,
072500**                         DUMMY-VIEW-AREA,
072600**                         DUMMY-KSAM-STAT,
072700**                         BU-DISPLAY-MSG,
072800**                         BU-DISPLAY-FLDS.
072900**
073000
073100
073200
073300 1000-CLOSE-FILES.
073400     CLOSE ONLINE-PRT.
           CLOSE MATLACUM-O, DTRANS-O.
           CLOSE MSTORERM-I, MACTINFO-I.

