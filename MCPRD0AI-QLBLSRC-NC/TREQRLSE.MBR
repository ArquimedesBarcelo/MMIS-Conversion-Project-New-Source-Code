000200 IDENTIFICATION DIVISION.
000300 PROGRAM-ID.          TREQRLSE.
000400 AUTHOR.              C HILLES.
000500 DATE-WRITTEN.        29 JAN 87.
000600 DATE-COMPILED.
000700*INSTALLATION.        GOODYEAR TIRE AND RUBBER - AKRON.
000800*SECURITY.
000900*REMARKS.    EXECUTIVE PROGRAM (MAIN PROGRAM) FOR RELEASE REQS
001000*            SUB-PROGRAM. THE SUBPROG "SMREQINQ"
001100*            CAN BE THE REQ INQUIRY OR CAN ALSO BE THE RELEASE REQ
001200*            PROGRAM IF THE RELEASE REQ FLAG IS SET WHEN CALLING IT.
001300*
001400 ENVIRONMENT DIVISION.
001500 CONFIGURATION SECTION.
001600 SOURCE-COMPUTER.  HP-3000.
001700 OBJECT-COMPUTER.  HP-3000.
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT MPLTINFO
                  ASSIGN TO DATABASE-MCFLCS0501
                  ORGANIZATION IS INDEXED
                    ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                  FILE STATUS IS FILE-STATUS.

001800
001900 DATA DIVISION.
       FILE SECTION.
       FD  MPLTINFO
           LABEL RECORDS ARE STANDARD.
       01  MPLTINFO-REC.
           COPY DDS-MCRPCS0500  OF MCFLCS0501.

002000 WORKING-STORAGE SECTION.
002100
002200 77  PASS-SPOOL-PRT-NO             PIC S9(2) COMP-4 VALUE 0.
002300
002400**************************************************************
002500**                                                          **
002600**     C O M M U N I C A T I O N S   A R E A S              **
002700**                                                          **
002800**************************************************************
002900
003000 COPY TBLOWUP    IN COPYLIB.
003100 COPY CWHO       IN COPYLIB.
003200 COPY ESCNAM2    IN COPYLIB.
003300 01  REQI-RET-CODE                 PIC S9(4) COMP-4 VALUE 0.
003400 COPY SMREQINQ   IN COPYLIB.
003500 COPY REQGLOBS   IN COPYLIB.
       COPY CSWITCHF   IN COPYLIB.
003600
003700**************************************************************
003800**                                                          **
003900**                  V I E W   W O R K                       **
004000**                                                          **
004100**************************************************************
004200
       COPY VCOMAREA IN COPYLIB.
008900 01  FORMFILE.
009000     05  FORM-FNAME                PIC X(8)  VALUE "FCSISINQ".
009100     05  FILLER                    PIC X     VALUE ".".
009200     05  FORM-GNAME.
009300         10  FORM-GNAME1           PIC X(5)  VALUE "FLANG".
009400         10  FORM-GNAME2           PIC X(3)  VALUE SPACES.
009500     05  FILLER                    PIC X(19) VALUE SPACES.
009600
009700 01  TERMFILENAME         PIC X(11) VALUE "TERM;".
009800
009900 01  MESSAGE-BUFLEN            PIC S9(4)    VALUE 76  COMP-4.
010000
010100 01  MESSAGE-ACTLEN            PIC S9(4)    VALUE ZERO COMP-4.
010200
010300 01  MESSAGE-BUFFER.
010400     05  MSG-TEXT              PIC X(68)    VALUE SPACE.
010500     05  MSG-FLD               PIC X(8)     VALUE SPACE.
010600     05  MSG-FLD-9  REDEFINES  MSG-FLD      PIC ZZZZZZZ9.
010700
010800**************************************************************
010900**                                                          **
011000**            D A T A B A S E   W O R K                     **
011100**                                                          **
011200**************************************************************
011300
       01  FILE-STATUS.
           05  FILE-STATUS-1            PIC X  VALUE "0".
           05  FILE-STATUS-2            PIC X  VALUE "0".

       COPY DBSTAT IN COPYLIB.
011400 01  BASE                       PIC X(24) VALUE "  STORES;".
011500 01  BASE-STHIST                PIC X(10) VALUE "  STHIST;".
011600 01  BASE-MMISA                 PIC X(24) VALUE "  MMISA;".
011700 01  BASE-BUDGET                PIC X(24) VALUE "  BUDGET;".
011800 01  PASSWORD                   PIC X(5)  VALUE "JADE;".
012700 01  DSET-NAMES.
012800     05  DSET-DUMMY             PIC X(2)  VALUE SPACES.
012900     05  DSET-MPLTINFO          PIC X(16) VALUE "MPLTINFO;".
013000
013100 01  MODE-AREA.
013200     05  MODE1                  PIC S9(4) COMP-4 VALUE 1.
013300     05  MODE7                  PIC S9(4) COMP-4 VALUE 7.
013400
013500 01  MPLTINFO-LIST.
013600     05  FILLER                 PIC X(13) VALUE "PLTINFO-DATA;".
013700
013800 01  PLT-ARG                    PIC X(4)  VALUE "P 01".
013900
014000**************************************************************
014100**                                                          **
014200**           D A T A B A S E   B U F F E R S                **
014300**                                                          **
014400**************************************************************
014500
014600 COPY MPLT0    IN COPYLIB.
014700 COPY MPLTP01 IN COPYLIB.
014800 COPY MEMPL    IN COPYLIB.
014900
015000**************************************
015100*                                    *
015200*    NATIVE LANGUAGE SUPPORT AREA    *
015300*                                    *
015400**************************************
015500
015600 COPY LANGUAGE   IN COPYLIB.
015700
015800
015900 PROCEDURE DIVISION.
016000 1000-HOUSEKEEP.
           OPEN INPUT MPLTINFO.
016100
016200     CALL "TESCSEQ" USING ESC-NAME.
016300
016400     MOVE "TREQRLSE"               TO  BU-PGM-NAME.
016500*    CALL INTRINSIC "WHO" USING MOD CAP LATTR
016600*          USERNAME GRPNAME ACCTNAME HOMEGRP TNUM.
016700*
016800*    CALL "DBOPEN" USING BASE, PASSWORD, MODE1, STATUS-AREA.
016900*    IF COND-WORD NOT = 0
017000*        MOVE "DBOPEN ERROR" TO BU-DISPLAY-MSG
017100*        GO TO 2-BLOWUP.
017200*
017300*    CALL INTRINSIC "FINDJCW" USING LANG-JCW-NAME, LANG-JCW-VALUE,
017400*                               LANG-JCW-STATUS.
017500*    IF LANG-JCW-STATUS NOT = 0
017600*        MOVE 1 TO LANG-JCW-VALUE.
017700*
017800*    CALL INTRINSIC "NLAPPEND" USING FORM-GNAME, LANG-JCW-VALUE,
017900*         LANG-ERROR.
018000*    IF LANG-ERROR1 NOT = 0
018100*        MOVE "001" TO FORM-GNAME2.
018200*
018300*    MOVE FORM-GNAME2 TO LANG-ERCAT-FNAME2, LANG-ERCAT-GNAME2.
018400*
018500*    CALL INTRINSIC "CATOPEN" USING LANG-ERCAT, LANG-ERROR,
018600*        GIVING LANG-INDEX.
018700*    IF LANG-ERROR1 NOT = 0
018800*        MOVE "CATOPEN FAILED * TMTSTEXC" TO BU-DISPLAY-MSG
018900*        GO TO 2-BLOWUP.
019000*
019100*    CALL "VOPENFORMF" USING VIEW-COMAREA FORMFILE.
019200*    IF VIEW-STATUS NOT = 0
019300*        MOVE "VOPENFORMF ERR 1-H" TO BU-DISPLAY-MSG
019400*        GO TO 2-BLOWUP.
019500*
019600*    CALL "SOPENTRM" USING VIEW-COMAREA, BU-DISPLAY-MSG.
019700*    IF BU-DISPLAY-MSG-1 NOT = SPACES
019800*        GO TO 2-BLOWUP.
019900*
020000*    CALL "DBGET" USING BASE DSET-MPLTINFO MODE7 STATUS-AREA
020100*      MPLTINFO-LIST BUF-MPLTINFO PLT-ARG.
           MOVE 0 TO COND-WORD.
           MOVE PLT-ARG TO PLTINFOKEY OF MPLTINFO-REC.
           READ MPLTINFO INTO BUF-MPLTINFO
               INVALID KEY MOVE 17 TO COND-WORD.
           IF FILE-STATUS-1 = "2"
               MOVE 17 TO COND-WORD
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD.
020200     IF COND-WORD NOT = 0
020300         MOVE "DBGET ERR MPLTINFO" TO BU-DISPLAY-MSG
020400         GO TO 2-BLOWUP.
020500
           CLOSE MPLTINFO.

020600*------- SET UP THE SUBPROGRAM TO BE USED TO RELEASE REQS.
020700     MOVE SPACES                   TO   REQI-DATA.
020800     MOVE "Y"                      TO   REQI-APPROVE-FLAG.
020900     CALL "SMREQINQ" USING         REQI-RET-CODE,
021000                                   BASE,
021100                                   BASE-STHIST,
021200                                   BASE-MMISA,
021300                                   BASE-BUDGET,
021400                                   STATUS-AREA,
021500                                   VIEW-COMAREA,
021600                                   LANGUAGE-PARMS,
021700                                   REQI-DATA,
021800                                   REQ-GLOBALS,
021900                                   MPLTINFO-COMPANY,
022000                                   PASS-SPOOL-PRT-NO,
022100                                   ESC-NAME.
022200
022300 1-EOJ.
022400*    CALL INTRINSIC "CATCLOSE" USING LANG-INDEX, LANG-ERROR.
022500*    CALL "VCLOSETERM" USING VIEW-COMAREA.
022600*    CALL "VCLOSEFORMF" USING VIEW-COMAREA.
022700*    CALL "DBCLOSE" USING BASE, DSET-DUMMY, MODE1,
022800*        STATUS-AREA.
022900     GOBACK.
023000
023100 2-BLOWUP.
023200     CALL "TBLOWUP" USING BASE, BU-PGM-NAME, STATUS-AREA,
023300       VIEW-COMAREA, FILE-STATUS, BU-DISPLAY-MSG,
023400       BU-DISPLAY-FLDS.
