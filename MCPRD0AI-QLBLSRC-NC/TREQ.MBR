216100************************************************
216200*                                              *
216300*   PUT OUT THE ID FOR THE CODE TO IDENTIFY    *
216400*   WHY A REQUISITION WAS CREATED FOR THE CODE *
216500*   EITHER "BLRO", "NEO", "MAN"                *
216600*                                              *
216700************************************************
216800
216900     IF REQ-RETURN-SW  =  " "
217000         MOVE "BLRO"           TO  ID-OUT
217100     ELSE
217200     IF REQ-RETURN-SW  =  "A" OR "E"
217300         MOVE "NEO "           TO  ID-OUT
217400     ELSE
217500     IF REQ-RETURN-SW  =  "M"
217600         MOVE "MAN"            TO  ID-OUT
217700     ELSE
217800     IF REQ-RETURN-SW  =  "W"
217900         MOVE "ENG"            TO  ID-OUT
218000     ELSE
218100         MOVE SPACES           TO  ID-OUT.
218200     MOVE ST-CLASS             TO  CLASS-OUT.
218300     MOVE AVAILABLE-ONHAND     TO  QTY-ONHAND-OUT.
218400     MOVE STR-MAX              TO  MAX-OUT.
218500     MOVE STR-REORDER          TO  REORDER-OUT.
218600     MOVE STR-EXPEDITE         TO  EXPEDITE-OUT.
218700     IF REQ-DATE-WANTED  =  SPACES
218800         MOVE SPACES            TO  DATE-WANTED-OUT
218900     ELSE
219000         MOVE 4                 TO  DATE-MODE
219100         MOVE REQ-DATE-WANTED   TO  DATE-VALIDATE-IN
219200         CALL "TDATECHK" USING DATE-CHECK-AREA
219300         MOVE DATE-SLASH-OUT    TO  DATE-WANTED-OUT.
219400     MOVE REQITM-QTY-TO-ORD    TO  SOQ-OUT.
219500     MOVE STR-UM               TO  UM-OUT.
219600     IF COMPANY-SAVE = "630"
219700         MOVE STR-PREV-CODE    TO  MAJ-LOC-OUT
219800     ELSE
219900         MOVE STR-LOC (1)      TO  MAJ-LOC-OUT.
220000     MOVE DETAIL-LINE          TO  PRINT-LINE.
220100     MOVE 2                    TO  PRT-CTL.
220200     WRITE PRINT-RCD.
220300     ADD 2                     TO  LINE-CTR.
220400
