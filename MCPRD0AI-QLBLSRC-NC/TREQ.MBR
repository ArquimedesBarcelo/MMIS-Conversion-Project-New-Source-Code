168200*  CALCULATE SUGGESTED QTY TO ORDER          *
168300*    1) USE STR-SOQ ( IF THAT IS NOT         *
168400*       AVAILABLE)                          *
168500*    2) USE (STR-MAX  -  STR-EXPEDITE  =     *
168600*       QTY-TO-ORDER                         *
168700*                                            *
168800**********************************************
168900
169000 62-COMPUTE-QTY-ORDERED.
           IF COMPANY-SAVE = "631"
               MOVE CALC-REORDER-QTY TO SAVE-QTY-TO-ORD
               GO TO 62-BUILD-DREQITM.
169100     IF STR-SOQ  =  ZEROS
169200         NEXT SENTENCE
169300     ELSE
169400         MOVE STR-SOQ  TO  SAVE-QTY-TO-ORD
169500         GO TO 62-BUILD-DREQITM.
169600     SUBTRACT STR-EXPEDITE  FROM  STR-MAX
169700         GIVING SAVE-QTY-TO-ORD.
169800     IF SAVE-QTY-TO-ORD = ZEROS
169900         MOVE STR-EXPEDITE  TO  SAVE-QTY-TO-ORD.
170000
170100********************************************
170200*                                          *
170300*  BUILD DREQITM                           *
170400*                                          *
170500********************************************
170600
170700 62-BUILD-DREQITM.
170800     MOVE SPACES                  TO  BUF-DREQITM.
170900     MOVE ZEROS                   TO  REQITM-UNIT-PRICE,
171000                                      REQITM-BUDGET-AMT.
           MOVE ZEROS                   TO  REQITM-UNIT-PRICE-CURR.
171100     MOVE SAVE-QTY-TO-ORD         TO  REQITM-QTY-TO-ORD.
171200
171300 62-PUT-DREQITM.
171400     MOVE REQ-CORP-CODE           TO  REQITM-CORP-CODE.
171500     MOVE STR-UM                  TO  REQITM-UM.
171600     MOVE BUILD-REQ-NO            TO  REQITM-REQ-NUMBER.
           WRITE DREQITM-REC-O FROM BUF-DREQITM
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
172000         MOVE "PUT DREQITM *62-BUILD-DREQITM" TO BU-DISPLAY-MSG
172100         GO TO 2-BLOWUP.
172200
172300***********************************
172400*                                 *
172500*  COMPUTE EOQ                    *
172600*                                 *
172700***********************************
172800
172900 62-COMPUTE-EOQ.
173000     IF STR-MTH-FCST > 0
173100         NEXT SENTENCE
173200     ELSE
173300         GO TO 62-UPDATE-MSTORERM.
173400
173500     MULTIPLY STR-MTH-FCST          BY
173600              12                    GIVING EOQ-ANNUAL-USAGE.
173700
173800     MULTIPLY EOQ-ORDER-COST        BY
173900              2                     GIVING EOQ-TWICE-ORDER-COST.
174000
174100     MULTIPLY EOQ-TWICE-ORDER-COST  BY
174200              EOQ-ANNUAL-USAGE      GIVING EOQ-NUMERATOR.
174300
174400     IF STR-MKT-COST = ZEROS
174500         MOVE STR-AVG-COST TO EOQ-UNIT-COST
174600     ELSE
174700         MOVE STR-MKT-COST TO EOQ-UNIT-COST.
174800
174900     MULTIPLY EOQ-UNIT-COST         BY
175000              EOQ-CARRY-COST        GIVING EOQ-DENOMINATOR.
175100
175200     DIVIDE   EOQ-NUMERATOR         BY
175300              EOQ-DENOMINATOR       GIVING EOQ-SQ.
175400
175500     COMPUTE  EOQ-SQ-ROOT ROUNDED = EOQ-SQ ** .5.
175600     MOVE EOQ-SQ-ROOT             TO  STR-EOQ.
175700
175800********************************************
175900*                                          *
176000*  UPDATE MSTORERM                         *
176100*   1) LAST-REQ-NO                         *
176200*   2) LAST-REQ-DATE                       *
176300*   3) STR-EOQ                             *
176400*                                          *
176500********************************************
176600
176700 62-UPDATE-MSTORERM.
176800     MOVE BUILD-REQ-NO          TO  STR-LAST-REQ-NO.
176900     MOVE CUR-DATE              TO  STR-LAST-REQ-DATE.
           IF STR-REQ-DATE-YY > "70"
               MOVE "19"              TO  STR-REQ-DATE-CC
           ELSE
           MOVE "20"                  TO  STR-REQ-DATE-CC.
           REWRITE MSTORERM-REC-O FROM BUF-MSTORERM
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
177300         MOVE "UPDATE MSTORERM *62-UM" TO BU-DISPLAY-MSG
177400         GO TO 2-BLOWUP.
178000
178100***********************************************
178200*  IF THIS IS A MMIS REQ. THEN CALL 'TREQINTF'
178300*  TO CONVEY THE CSIS REQ. NUMBER ASSIGNED TO
178400*  THE ITEM ON THE WORK ORDER
178500***********************************************
178600
178700     IF REQ-RETURN-SW = "W"
178800         PERFORM 621-SEND-REQ-NO-TO-MMIS  THRU  621-SRNTM-X.
178900
179000********************************************
179100*                                          *
179200*  PRINT REQ ON REPORT                     *
179300*                                          *
179400********************************************
179500
179600     PERFORM 621-PRINT-REQ.
179700     MOVE "Y"  TO  AT-LEAST-ONE-REQ.
179800
179900***********************************************
180000*                                             *
180100*   SAVE THE FIRST REQ NO. FOR BOTH ENG. AND  *
180200*   RAW MATERIALS FOR UPDATING THE REQDATE    *
180300*   FILE                                      *
180400*                                             *
180500***********************************************
180600
180700     IF CORP-CODE-1-2  = "26" OR "27"
180800         IF AT-LEAST-ONE-RAW-MAT  =  "N"
180900             MOVE "Y"           TO  AT-LEAST-ONE-RAW-MAT
181000             MOVE SAVE-REQ-NO   TO  SAVE-FIRST-RAW-REQ-NO
181100         ELSE
181200             NEXT SENTENCE
181300     ELSE
181400         IF AT-LEAST-ONE-ENG-MAT  =  "N"
181500             MOVE "Y"           TO  AT-LEAST-ONE-ENG-MAT
181600             MOVE SAVE-REQ-NO   TO  SAVE-FIRST-ENG-REQ-NO.
181700
181800***************************************
181900*                                     *
182000*   IF ITEM IS A STOCK OUT THEN WRITE *
182100*   TO STOCKOUT-TEMP FILE             *
182200*                                     *
182300***************************************
182400
182500     IF AVAILABLE-ONHAND = 0
182600         MOVE SPACES  TO  REQ-RETURN-SW
182700         PERFORM 64-STOCKOUT-REQ  THRU  64-S-R-X.
182800
182900 62-B-R-X.
183000     EXIT.
183100
       620-GET-REQ-GLOBALS.
           MOVE "RQGB" TO PLTINFOKEY OF MPLTINFO-REC-O.
           READ MPLTINFO-O INTO REQ-GLOBALS
               INVALID KEY    MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE "Y" TO PRINT-WO-REQPK
               MOVE "N" TO WOAP-TO-CUT-REQ
               MOVE "N" TO WOAP-TO-APP-REQ
               MOVE "N" TO DISP-WO-AMTS.

183200**********************************************
183300*                                            *
183400*   THIS PARAGRAPH ASSIGNS THE REQ. NO.      *
183500*                                            *
183600**********************************************
183700
183800 621-ASSIGN-REQ-NUM.
183900     ADD 1           TO  SAVE-REQ-NO.
184000     IF SAVE-REQ-NO  =  ZEROS
184100         ADD 1       TO  SAVE-REQ-NO.
184200     MOVE SAVE-REQ-NO      TO  BUILD-REQ-NO.
184300     INSPECT BUILD-REQ-NO  REPLACING LEADING "0" BY " ".
184400     MOVE 1          TO  SUB1.
184500     MOVE ZEROS      TO  SUB2.
184600
184700 621-LEFT-SHIFT-REQ-LOOP.
184800     ADD 1           TO  SUB2.
184900     IF SUB2 > 6
               MOVE MREQ-NUMBER       TO  REQ-MMIS-REQ-NO
185000         MOVE BUILD-REQ-NO      TO  MREQ-NUMBER
185100     ELSE
185200     IF REQ-NO (SUB2) = SPACES
185300         GO TO 621-LEFT-SHIFT-REQ-LOOP
185400     ELSE
185500     IF SUB1 = SUB2
               MOVE MREQ-NUMBER       TO  REQ-MMIS-REQ-NO
185600         MOVE BUILD-REQ-NO      TO  MREQ-NUMBER
185700     ELSE
185800         MOVE REQ-NO (SUB2)     TO  REQ-NO (SUB1)
185900         MOVE SPACES            TO  REQ-NO (SUB2)
186000         ADD 1  TO  SUB1
186100         GO TO 621-LEFT-SHIFT-REQ-LOOP.
186200
186300 621-ARN-X.
186400     EXIT.
186500
186600*********************************************************
186700**  THIS ROUTINE CALCULATES AN AVERAGE OF THE LAST
186800**  3 ACTUAL LEAD TIMES.  THIS AVERAGE IS USED WHEN
186900**  CALCULATING DATE WANTED WHEN GDYR EST LEAD TIME
187000**  IS ZERO
187100*********************************************************
187200 621-CALC-LAST-DLV-AVG.
187300     MOVE ZEROS                   TO  SUB,
187400                                      NO-OF-DLV,
187500                                      TOTAL-DLV-TIME.
187600 621-ADD-LAST-DLV-LOOP.
187700     ADD 1 TO SUB.
187800     IF SUB > 3
187900         GO TO 621-CALC-AVG-DLV.
188000     IF STR-LAST-DLVTIMES (SUB) = ZEROS
188100         NEXT SENTENCE
188200     ELSE
188300         ADD STR-LAST-DLVTIMES (SUB) TO TOTAL-DLV-TIME
188400         ADD 1                       TO  NO-OF-DLV.
188500
188600     GO TO 621-ADD-LAST-DLV-LOOP.
188700
188800 621-CALC-AVG-DLV.
188900     IF NO-OF-DLV = ZEROS
189000         MOVE ZEROS               TO  LEAD-TIME
189100     ELSE
189200         DIVIDE TOTAL-DLV-TIME    BY  NO-OF-DLV
189300             GIVING LEAD-TIME ROUNDED.
189400
189500 621-CLDA-X.
189600     EXIT.
189700
189800*********************************************************
189900*
190000*  CALL 'TREQINTF' TO CONVEY TO THE MMIS WO WHAT CSIS
190100*  REQ. NUMBER HAS BEEN ASSIGNED TO THE PARTICULAR
190200*  CODE ON THE WO
190300*
190400*********************************************************
190500
190600 621-SEND-REQ-NO-TO-MMIS.
190700     MOVE SPACES                TO  MMIS-REQ-STATUS-PARMS.
190800     MOVE DREQD-WO-NUMBER       TO  MMIS-WO-NO.
190900     MOVE DREQD-WO-ITM-NO       TO  MMIS-WO-ITM-NO.
191000     MOVE REQ-CORP-CODE         TO  MMIS-CORP-CODE.
191100     MOVE BUILD-REQ-NO          TO  MMIS-REQ-NO.
191200     CALL "TREQINTF" USING BASE-MMISA,
191300                           MMIS-REQ-STATUS-PARMS,
191400                           STATUS-AREA.
191500     IF COND-WORD = 0 OR 15 OR 17
191600         NEXT SENTENCE
191700     ELSE
191800         MOVE "ERROR IN TREQINTF" TO BU-DISPLAY-MSG
191900         GO TO 2-BLOWUP.
192000
192100 621-SRNTM-X.
192200     EXIT.
192300
192400**********************************************
192500*                                            *
192600*   THIS PARAGRAPH GETS TO MREQ ENTRY UNDER  *
192700*   THE WO REQ. NO ENTRY                     *
192800*                                            *
192900**********************************************
193000
193100 621-MREQ-MMIS-PROC.
193200     MOVE SPACES             TO  ERR-SW.
193300     MOVE REQ-NUM-MMIS       TO  REQ-ARG.
           MOVE REQ-ARG TO REQNO OF MREQ-REC-O.
           READ MREQ-O INTO BUF-MREQ
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
193800             MOVE REQ-NUM-MMIS  TO  MMIS-REQ-NO-OUT
193900             MOVE REQ-CORP-CODE TO  CODE-WO-REQ-OUT
194000             MOVE MISSING-WO-REQ-MSG  TO  PRINT-LINE
