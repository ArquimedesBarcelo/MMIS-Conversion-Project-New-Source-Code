137600     ELSE
           IF COMPANY-SAVE = "631"
               IF REQ-RETURN-SW = "W"
                   PERFORM 62-BUILD-REQ THRU 62-B-R-X
               ELSE
               MOVE "N" TO CREATE-REQ-SW
               MOVE REQ-CORP-CODE TO PASSED-CODE
               MOVE ZEROES TO CALC-REORDER-QTY
               CALL "SNAPCALC" USING PASSED-PARMS
                                     CREATE-REQ-SW
               IF CREATE-REQ-SW = "N"
                   GO TO 60-READ-REQ-FILE
               ELSE
               PERFORM 62-BUILD-REQ  THRU  62-B-R-X
           ELSE
