098000*********************************************
098100*                                           *
098200*  OPEN ALL FILES & DATA BASE               *
098300*       OUTPUT                              *
098400*        1) REQ-REPORT, 2) REORDER-TEMP,    *
098500*        3) EXPEDITE-TEMP, 4) RAWMAT-TEMP   *
098600*        5) REQ-FILE2, 6) STOCKOUT-TEMP     *
098700*                                           *
098800*********************************************
098900
099000 1-HSK.
      *----- CALL CCRTFILE TO CREATE A TEMPORARY FILE 'RAWMAT'
      *----- LIBRARY 'QTEMP' IS USED FOR TEMPORARY FILES
           MOVE SPACES        TO CCRTFILE-PARMS.
           MOVE "QTEMP"       TO CCRTFILE-LIBRARY.
           MOVE "RAWMAT"      TO CCRTFILE-FILE.
           MOVE "0021"        TO CCRTFILE-RECORD-LENGTH.
           MOVE "01000"       TO CCRTFILE-NO-RECORDS.
           MOVE "00500"       TO CCRTFILE-INCREMENT-AMT.
           MOVE "10"          TO CCRTFILE-NO-INCREMENTS.
           CALL "CCRTFILE" USING CCRTFILE-LIBRARY,
                                 CCRTFILE-FILE,
                                 CCRTFILE-RECORD-LENGTH,
                                 CCRTFILE-NO-RECORDS,
                                 CCRTFILE-INCREMENT-AMT,
                                 CCRTFILE-NO-INCREMENTS,
                                 CCRTFILE-STATUS.
           IF CCRTFILE-STATUS NOT = "00"
               MOVE "CCRTFILE CREATE OF 'PRNTWORK' FAILED"
                  TO BU-DISPLAY-MSG
               GO TO 2-BLOWUP.

      *----- CALL CCRTFILE TO CREATE A TEMPORARY FILE 'REORDER'
      *----- LIBRARY 'QTEMP' IS USED FOR TEMPORARY FILES
           MOVE SPACES        TO CCRTFILE-PARMS.
           MOVE "QTEMP"       TO CCRTFILE-LIBRARY.
           MOVE "REORDER"     TO CCRTFILE-FILE.
           MOVE "0007"        TO CCRTFILE-RECORD-LENGTH.
           MOVE "01000"       TO CCRTFILE-NO-RECORDS.
           MOVE "00500"       TO CCRTFILE-INCREMENT-AMT.
           MOVE "10"          TO CCRTFILE-NO-INCREMENTS.
           CALL "CCRTFILE" USING CCRTFILE-LIBRARY,
                                 CCRTFILE-FILE,
                                 CCRTFILE-RECORD-LENGTH,
                                 CCRTFILE-NO-RECORDS,
                                 CCRTFILE-INCREMENT-AMT,
                                 CCRTFILE-NO-INCREMENTS,
                                 CCRTFILE-STATUS.
           IF CCRTFILE-STATUS NOT = "00"
               MOVE "CCRTFILE CREATE OF 'PRNTWORK' FAILED"
                  TO BU-DISPLAY-MSG
               GO TO 2-BLOWUP.

      *----- CALL CCRTFILE TO CREATE A TEMPORARY FILE 'EXPEDITE'
      *----- LIBRARY 'QTEMP' IS USED FOR TEMPORARY FILES
           MOVE SPACES        TO CCRTFILE-PARMS.
           MOVE "QTEMP"       TO CCRTFILE-LIBRARY.
           MOVE "EXPEDITE"    TO CCRTFILE-FILE.
           MOVE "0021"        TO CCRTFILE-RECORD-LENGTH.
           MOVE "01000"       TO CCRTFILE-NO-RECORDS.
           MOVE "00500"       TO CCRTFILE-INCREMENT-AMT.
           MOVE "10"          TO CCRTFILE-NO-INCREMENTS.
           CALL "CCRTFILE" USING CCRTFILE-LIBRARY,
                                 CCRTFILE-FILE,
                                 CCRTFILE-RECORD-LENGTH,
                                 CCRTFILE-NO-RECORDS,
                                 CCRTFILE-INCREMENT-AMT,
                                 CCRTFILE-NO-INCREMENTS,
                                 CCRTFILE-STATUS.
           IF CCRTFILE-STATUS NOT = "00"
               MOVE "CCRTFILE CREATE OF 'PRNTWORK' FAILED"
                  TO BU-DISPLAY-MSG
               GO TO 2-BLOWUP.

      *----- CALL CCRTFILE TO CREATE A TEMPORARY FILE 'STOCKOUT'
      *----- LIBRARY 'QTEMP' IS USED FOR TEMPORARY FILES
           MOVE SPACES        TO CCRTFILE-PARMS.
           MOVE "QTEMP"       TO CCRTFILE-LIBRARY.
           MOVE "STOCKOUT"    TO CCRTFILE-FILE.
           MOVE "0021"        TO CCRTFILE-RECORD-LENGTH.
           MOVE "01000"       TO CCRTFILE-NO-RECORDS.
           MOVE "00500"       TO CCRTFILE-INCREMENT-AMT.
           MOVE "10"          TO CCRTFILE-NO-INCREMENTS.
           CALL "CCRTFILE" USING CCRTFILE-LIBRARY,
                                 CCRTFILE-FILE,
                                 CCRTFILE-RECORD-LENGTH,
                                 CCRTFILE-NO-RECORDS,
                                 CCRTFILE-INCREMENT-AMT,
                                 CCRTFILE-NO-INCREMENTS,
                                 CCRTFILE-STATUS.
           IF CCRTFILE-STATUS NOT = "00"
               MOVE "CCRTFILE CREATE OF 'PRNTWORK' FAILED"
                  TO BU-DISPLAY-MSG
               GO TO 2-BLOWUP.

099100     OPEN OUTPUT REQ-REPORT, REORDER-TEMP, EXPEDITE-TEMP,
099200         RAWMAT-TEMP, STOCKOUT-TEMP.
099300     OPEN OUTPUT REQ-FILE2.
100400
           OPEN I-O MPLTINFO-O, MREQFILE-O, MSTORERM-O, MREQ-O,
                    DREQITM-O, DREQD-O, DREQDESC-O, DREQQUE-O.
           OPEN INPUT DREQITMC-I, DPOITEM-I, DPORECD-I, DVENDOR-I.

100500**********************************************
100600*                                            *
100700*    RETRIEVE PDER-SW FROM PLANT STARTUP     *
100800*    USER OPTIONS TO INFORM PROGRAM THAT     *
100900*    NO DEPARTMENT/EXP CLASS ARE BROUGHT     *
101000*    FORWARD ON THE REQ                      *
101100**********************************************

101200     MOVE "Y"            TO  SAVE-PDER-SW.
101300     MOVE "PDER"         TO  PLT-ARG.
           MOVE PLT-ARG TO PLTINFOKEY OF MPLTINFO-REC-O.
           READ MPLTINFO-O INTO BUF-MPLTINFO
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
101700         MOVE "GET MPLTINFO *TREQ*" TO BU-DISPLAY-MSG
101800         MOVE PLT-ARG               TO BU-DISPLAY-FLD (2)
101900         GO TO 2-BLOWUP.
102000     MOVE MPLTINFO-PDER-SW  TO  SAVE-PDER-SW.
102400
100500**********************************************
100600*                                            *
100700*    DO DBGET MPLTINFO WITH  "P 01" =        *
100800*    PLTINFO-KEY TO GET PLANT CODE TO        *
100900*    PRINT ON THE PAGE HEADINGS              *
101000*                                            *
101100**********************************************
101200
101300     MOVE "P 01"         TO  PLT-ARG.
           MOVE PLT-ARG TO PLTINFOKEY OF MPLTINFO-REC-O.
           READ MPLTINFO-O INTO BUF-MPLTINFO
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
101700         MOVE "GET MPLTINFO*1-HSK" TO BU-DISPLAY-MSG
101800         MOVE PLT-ARG             TO BU-DISPLAY-FLD (2)
101900         GO TO 2-BLOWUP.
102000     MOVE MPLTINFO-COMPANY  TO  PRT-CO,
102100                                PRT-CO-E-R,
102200                                COMPANY-SAVE.
102300     MOVE MPLTINFO-PRIME    TO  PRIME-SAVE.
102400
102500**************************************************
102600*                                                *
102700*   GET STOREROOM FROM MPLTINFO USING 'P 03'     *
102800*   AS THE ARGUMENT IT IS USED TO PRINT ON REQ   *
102900*                                                *
103000**************************************************
103100
103200     MOVE "P 03"  TO  PLT-ARG.
           MOVE PLT-ARG TO PLTINFOKEY OF MPLTINFO-REC-O.
           READ MPLTINFO-O INTO BUF-MPLTINFO
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
103700             MOVE SPACES  TO  STOREROOM-SAVE
103800         ELSE
103900             MOVE "DBGET MPLTINFO* 1-HSK"  TO  BU-DISPLAY-MSG
104000             MOVE PLT-ARG                  TO  BU-DISPLAY-FLD (2)
104100             GO TO 2-BLOWUP
104200     ELSE
104300         MOVE MPLTINFO-STOREROOM  TO  STOREROOM-SAVE.
104400*********************************************
104500*                                           *
104600*  DO DBGET MPLTINFO WITH "P 20" =          *
104700*  PLTINFO-KEY TO GET THE ORDERING COST     *
104800*  AND CARRYING COST FOR EOQ CALCULATIONS   *
104900*                                           *
105000*********************************************
105100
105200     MOVE "P 20"         TO  PLT-ARG.
           MOVE PLT-ARG TO PLTINFOKEY OF MPLTINFO-REC-O.
           READ MPLTINFO-O INTO BUF-MPLTINFO
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
105600         MOVE "GET MPLTINFO *1-HSK" TO  BU-DISPLAY-MSG
105700         MOVE PLT-ARG               TO  BU-DISPLAY-FLD (2)
105800         GO TO 2-BLOWUP.
105900
106000     MOVE MPLTINFO-CARRY-COST  TO  EOQ-CARRY-COST.
106100     IF EOQ-CARRY-COST = ZEROS
106200         MOVE 0.30             TO  EOQ-CARRY-COST.
106300     IF MPLTINFO-EXP-ORDER-COST NUMERIC
106400         MOVE MPLTINFO-EXP-ORDER-COST  TO  EOQ-ORDER-COST
106500     ELSE
106600         MOVE MPLTINFO-ORDER-COST      TO  EOQ-ORDER-COST
106700         PERFORM 11-MOVE-MPLTINFO-ORDER-COST  THRU  11-MMOC-X.
106800
106900*********************************************
107000*                                           *
107100*  DO DBGET MPLTINFO WITH "PREQ" =          *
107200*  PLTINFO-KEY TO GET THE LAST REQ-NO. THEN *
107300*  LOAD REPORT-HDR BUFFER WITH CURRENT DATE *
107400*                                           *
107500*********************************************
107600
107700     MOVE "PREQ"         TO  PLT-ARG.
           MOVE PLT-ARG TO PLTINFOKEY OF MPLTINFO-REC-O.
           READ MPLTINFO-O INTO BUF-MPLTINFO
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
108100         MOVE "GET MPLTINFO * 1-HSK" TO BU-DISPLAY-MSG
108200         MOVE PLT-ARG                TO BU-DISPLAY-FLD (2)
108300         GO TO 2-BLOWUP
108400     ELSE
108500         MOVE MPLTINFO-REQ-NO        TO  SAVE-REQ-NO
108600         MOVE MPLTINFO-DATE-WANT-SW  TO  CALC-DATE-WANTED-SW.
108700**********************************************
108800*                                            *
108900*   CALL TDATECHK FOR TODAYS DATE & TIME     *
109000*                                            *
109100**********************************************
109200
109300     CALL "TDATECHK" USING DATE-CHECK-AREA.
109400     MOVE DATE-SLASH-OUT        TO  PRT-DATE,
109500                                    PRT-DATE-E-R.
109600     MOVE DATE-FORMATTED-TIME-OUT  TO  PRT-TIME,
109700                                       PRT-TIME-E-R.
109800     MOVE DATE-YMD-OUT          TO  CUR-DATE.
111700
      *------- DO A START > HIGH-VALUES TO UNLOCK
           MOVE HIGH-VALUES TO PLTINFOKEY OF MPLTINFO-REC-O.
           START MPLTINFO-O KEY > PLTINFOKEY OF MPLTINFO-REC-O
               INVALID KEY MOVE "00" TO FILE-STATUS.

111800     PERFORM 621-REPORT-HDR THRU 621-R-H-X.
111900     PERFORM 621-PAGE-HDR  THRU  621-P-H-X.

112000 1-H-X.
112100     EXIT.
112200
112300****************************************************
112400**  THIS IS A TEMPORARY ROUTINE THAT MOVES
112500**  ORDERING COSTS FROM A 2 BYTE FIELD TO A 6
112600**  BYTE FIELD ON THE SAME RECORD IN MPLTINFO
112700**  THIS WAS NEEDED SINCE ORDERING COSTS IS TOO
112800**  SMALL
112900****************************************************
113000
113100 11-MOVE-MPLTINFO-ORDER-COST.
114200     MOVE MPLTINFO-ORDER-COST     TO  MPLTINFO-EXP-ORDER-COST.
114300     MOVE ZEROS                   TO  MPLTINFO-ORDER-COST.
           REWRITE MPLTINFO-REC-O FROM BUF-MPLTINFO
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
114700         MOVE "UPDATE MPLTINFO * 11-MMOC" TO BU-DISPLAY-MSG
114800         GO TO 2-BLOWUP.
115500
115600 11-MMOC-X.
115700     EXIT.
115800
115900
116000 2-EOJ.
116100     CLOSE REQ-REPORT, REORDER-TEMP, EXPEDITE-TEMP,
116200         REQ-FILE2, RAWMAT-TEMP, STOCKOUT-TEMP.
116300
           CLOSE MPLTINFO-O, MREQFILE-O, MSTORERM-O, MREQ-O,
                 DREQITM-O, DREQD-O, DREQDESC-O, DREQQUE-O,
                 DREQITMC-I, DPOITEM-I, DPORECD-I, DVENDOR-I.
118100
118200 2-EOJ-X.
118300     EXIT.
118400
118500
118600
