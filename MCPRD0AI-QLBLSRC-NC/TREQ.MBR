236200******************************************
236300*                                        *
236400*  ROUTINE WRITES CODE INCREASED ABOVE   *
236500*  REORDER TO REORDER-TEMP FILE FOR      *
236600*  REPORT PURPOSES LATER                 *
236700*                                        *
236800******************************************
236900
237000 63-RETURN-REQ.
237100     MOVE REQ-CORP-CODE  TO CODE-REORDER.
237200     WRITE REORDER-RCD.
237300     MOVE "Y"   TO  RETURN-RCD-SW.
237400
237500 63-R-R-X.
237600     EXIT.
237700
237800******************************************
237900*                                        *
238000*  ROUTINE WRITES CODES REDUCED BELOW    *
238100*  EXPEDITE TO EXPEDITE-TEMP FILE FOR    *
238200*  REPORT PURPOSES LATER.  FIRST HOW-    *
238300*  EVER THE CODE IS CHECKED FOR          *
238400*  SUFFICIENT ONORDER OR OPEN REQS IF    *
238500*  CODE IS PUT ON A REQ. IT IS NOT PUT   *
238600*  ON THE EXPEDITE REPORT                *
238700*                                        *
238800******************************************
238900
239000 64-EXPEDITE-REQ.
239100     PERFORM 68-CHECK-ONORDER-AND-REQS  THRU  68-COAR-X.
239200     IF CODE-QUALIFIES-FOR-REQ  =  "Y"
239300         GO TO 64-E-R-X.
           PERFORM 640-GET-LAST-VENDOR THRU 640-GLV-X.
           MOVE STR-LAST-VENDOR TO  VENDOR-EXPEDITE.
239400     MOVE REQ-CORP-CODE   TO  CODE-EXPEDITE.
239500     WRITE EXPEDITE-RCD.
239600     MOVE "Y"             TO  EXPEDITE-RCD-SW.
239700
239800 64-E-R-X.
239900     EXIT.
240000
240100****************************************************
240200*                                                  *
240300*  ROUTINE WRITES CODES THAT ARE AT A STOCK OUT    *
240400*  SITUATION (ONHAND=0) TO STOCKOUT-TEMP FILE FOR  *
240500*  REPORT PURPOSES LATER                           *
240600*                                                  *
240700****************************************************
240800
240900 64-STOCKOUT-REQ.
241000     MOVE REQ-CORP-CODE   TO  CODE-STOCKOUT.
241100     MOVE REQ-RETURN-SW   TO  STOCKOUT-SW.
           PERFORM 640-GET-LAST-VENDOR THRU 640-GLV-X.
           MOVE STR-LAST-VENDOR TO  VENDOR-STOCKOUT.
241200     WRITE STOCKOUT-RCD.
241300     MOVE "Y"             TO  STOCKOUT-RCD-SW.
241400
241500 64-S-R-X.
241600     EXIT.
241700
       640-GET-LAST-VENDOR.
           MOVE REQ-CORP-CODE TO CORPCDE OF MSTORERM-REC-O.
           READ MSTORERM-O INTO BUF-MSTORERM
               INVALID KEY    MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
                   MOVE REQ-CORP-CODE TO BAD-CODE-OUT
                   MOVE BAD-CORP-CODE-MSG TO PRINT-LINE
                   MOVE 2                 TO PRT-CTL
                   WRITE PRINT-RCD
                   ADD 2                  TO LINE-CTR
                   GO TO 640-GLV-X
               ELSE
               MOVE "GET-LAST-VENDOR ERROR *TREQ*"
                   TO BU-DISPLAY-MSG
               GO TO 2-BLOWUP.
           MOVE HIGH-VALUES TO CORPCDE OF MSTORERM-REC-O.
           START MSTORERM-O KEY > EXTERNALLY-DESCRIBED-KEY
               INVALID KEY    MOVE FILE-STATUS TO FILE-STATUS.
       640-GLV-X.    EXIT.

241800******************************************
241900*                                        *
242000*  ROUTINE UPDATES THE LAST REQ NO.      *
242100*  MAINTAINED IN MPLTINFO. A LOCK OF     *
242200*  MPLTINFO IS DONE AT THE RECORD LEVEL  *
242300*  USING PLTINFO-KEY = "PREQ"            *
242400*                                        *
242500******************************************
242600
242700 65-UPDATE-MPLTINFO.
243700     MOVE "PREQ"         TO  PLT-ARG.
           MOVE PLT-ARG TO PLTINFOKEY OF MPLTINFO-REC-O.
           READ MPLTINFO-O INTO BUF-MPLTINFO
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
244100         MOVE "GET MPLTINFO * 65-UM" TO BU-DISPLAY-MSG
244200         MOVE PLT-ARG                TO BU-DISPLAY-FLD (2)
244300         GO TO 2-BLOWUP.
244400     MOVE SAVE-REQ-NO    TO  MPLTINFO-REQ-NO.
           REWRITE MPLTINFO-REC-O FROM BUF-MPLTINFO
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
244800         MOVE "UPDATE MPLTINFO* 65-UM" TO
244900             BU-DISPLAY-MSG
245000         GO TO 2-BLOWUP.
245700
245800 65-U-M-X.
245900     EXIT.
246000
246100
246200******************************************
246300*                                        *
246400*  READ THE REORDER-TEMP FILE AND        *
246500*  GENERATE THE REPORT 'CORP CODES       *
246600*  INCREASED ABOVE REORDER'              *
246700*                                        *
246800******************************************
246900
247000 66-WRITE-RETURN-REPORT.
247100     MOVE REORDER-HEADER    TO  HEADER-EX-RE.
247200     MOVE ZEROS             TO  PAGE-CTR, LINE-CTR.
247300     PERFORM 661-REPORT-HDR.
247400
247500 66-READ-REORDER-FILE.
247600     READ REORDER-TEMP  AT END
247700         GO TO 66-WRR-X.
247800     MOVE CODE-REORDER   TO CODE-ARG.
           MOVE CODE-ARG TO CORPCDE OF MSTORERM-REC-O.
           READ MSTORERM-O INTO BUF-MSTORERM
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
248300             MOVE CODE-REORDER      TO BAD-CODE-OUT
248400             MOVE BAD-CORP-CODE-MSG TO PRINT-LINE
248500             MOVE 2                 TO PRT-CTL
248600             WRITE PRINT-RCD
248700             ADD 2  TO  LINE-CTR
248800             GO TO 66-READ-REORDER-FILE
248900         ELSE
249000             MOVE "DBGET 66-READ-REORDER" TO BU-DISPLAY-MSG
249100             GO TO 2-BLOWUP.
249200
249300     MOVE SPACES   TO  DETAIL-LINE-EX-RE.
249400     MOVE CODE-REORDER           TO  EX-RE-CODE-OUT.
249500     MOVE ST-CLASS               TO  EX-RE-CLASS-OUT.
249600
249700     PERFORM 660-CHECK-LAST-REQ  THRU 660-CLR-X.
249800
249900     PERFORM 661-PRINT-DETAIL.
250000
250100     GO TO 66-READ-REORDER-FILE.
250200
250300 66-WRR-X.
250400     EXIT.
250500
250600******************************************
250700*                                        *
250800*  READ THE EXPEDITE-TEMP FILE AND       *
250900*  GENERATE THE REPORT ENTITLED          *
251000*  'CORP-CODE REDUCED BELOW EXPEDITE'    *
251100*                                        *
251200******************************************
251300
251400 66-WRITE-EXPEDITE-REPORT.
251500     MOVE EXPEDITE-HEADER   TO  HEADER-EX-RE.
251600     MOVE ZEROS             TO  PAGE-CTR, LINE-CTR.
251700     PERFORM 661-REPORT-HDR.
251800
251900 66-READ-EXPEDITE-FILE.
252000     READ EXPEDITE-TEMP  AT END
252100         GO TO 66-WER-X.
252200     MOVE CODE-EXPEDITE   TO CODE-ARG.
           MOVE CODE-ARG TO CORPCDE OF MSTORERM-REC-O.
           READ MSTORERM-O INTO BUF-MSTORERM
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
252700             MOVE CODE-EXPEDITE     TO BAD-CODE-OUT
252800             MOVE BAD-CORP-CODE-MSG TO PRINT-LINE
252900             MOVE 2                 TO PRT-CTL
253000             WRITE PRINT-RCD
253100             ADD 2  TO  LINE-CTR
253200             GO TO 66-READ-EXPEDITE-FILE
253300         ELSE
253400             MOVE "DBGET 66-READ-EXPEDITE" TO BU-DISPLAY-MSG
253500             GO TO 2-BLOWUP.
253600
253700     MOVE SPACES   TO  DETAIL-LINE-EX-RE.
253800     MOVE CODE-EXPEDITE          TO  EX-RE-CODE-OUT.
253900     MOVE ST-CLASS               TO  EX-RE-CLASS-OUT.
254000     PERFORM 660-CHECK-LAST-REQ  THRU 660-CLR-X.
254100
254200     PERFORM 661-PRINT-DETAIL.
254300
           IF COMPANY-SAVE = "153"
               MOVE SPACES             TO  DETAIL-LINE-EX-RE
               MOVE STR-DFLT-DEPT      TO  EX-RE-CODE-OUT
               MOVE DETAIL-LINE-EX-RE  TO  PRINT-LINE
               MOVE 1                  TO  PRT-CTL
               WRITE PRINT-RCD
               ADD 1                   TO  LINE-CTR.

           PERFORM PRINT-KEY-WORD-MODIFIER.
           PERFORM PRINT-PO-INFO.
254300
254400     GO TO 66-READ-EXPEDITE-FILE.
254500
254600 66-WER-X.
254700     EXIT.
254800
254900*******************************************
255000**   CHECK LAST REQ AND PO STATUS FOR    **
255100**   PRINT PURPOSES ON THE REORDER,      **
255200**   EXPEDITE, AND STOCKOUT REPORTS      **
255300*******************************************
255400
255500 660-CHECK-LAST-REQ.
255600     IF STR-LAST-REQ-NO  =  SPACES
255700         MOVE "NONE"        TO LAST-REQ-NO-OUT
255800     ELSE
255900         MOVE STR-LAST-REQ-NO    TO LAST-REQ-NO-OUT
256000         PERFORM 662-GET-MREQ THRU 662-GM-X.
256100
256200     IF STR-LAST-REQ-DATE  =  SPACES  OR "XXXXXX"
256300         NEXT SENTENCE
256400     ELSE
256500         MOVE 4                    TO  DATE-MODE
256600         MOVE STR-LAST-REQ-DATE    TO  DATE-VALIDATE-IN
256700         CALL "TDATECHK" USING DATE-CHECK-AREA
256800         MOVE DATE-SLASH-OUT       TO  LAST-REQ-DATE.
256900
257000     IF STR-LAST-RLSE  =  "000"
257100         MOVE STR-LAST-PO       TO  LAST-PO-OUT
257200     ELSE
257300         MOVE STR-LAST-PO-RLSE  TO  LAST-PO-OUT.
257400
257500     IF BUYER-CODE-OUT = SPACES
257600         MOVE STR-BUYER           TO BUYER-CODE-OUT.
257700
257800 660-CLR-X.
257900     EXIT.
258000
258100
258200******************************************
258300*                                        *
258400*  PRINT ROUTINE TO PRINT DETAIL LINE    *
258500*  FOR BOTH REORDER AND EXPEDITE REPORT  *
258600*                                        *
258700******************************************
258800
258900 661-PRINT-DETAIL.
259000     IF LINE-CTR > 50
259100         PERFORM 661-REPORT-HDR.
259200     MOVE DETAIL-LINE-EX-RE  TO  PRINT-LINE.
259300     MOVE 2                  TO  PRT-CTL.
259400     WRITE  PRINT-RCD.
259500     ADD 2  TO  LINE-CTR.
259600
259700******************************************
259800*                                        *
259900*  PRINT ROUTINE TO PRINT REPORT HDR     *
260000*  FOR BOTH REORDER & EXPEDITE REPORT    *
260100*                                        *
260200******************************************
260300
260400 661-REPORT-HDR.
260500     ADD 1          TO PAGE-CTR.
260600     MOVE PAGE-CTR  TO E-R-PAGE-NO-OUT.
260700     MOVE PRINT-EX-RE-HDR1  TO  PRINT-LINE.
260800     MOVE 0                 TO  PRT-CTL.
260900     WRITE  PRINT-RCD.
261000     MOVE PRINT-EX-RE-HDR2  TO  PRINT-LINE.
261100     MOVE 2                 TO  PRT-CTL.
261200     WRITE  PRINT-RCD.
           IF COMPANY-SAVE = "153"
               MOVE "DFLT DEPT"   TO  V-DEPT
           ELSE
           MOVE SPACES            TO  V-DEPT.
           MOVE PRINT-EX-RE-HDR3  TO  PRINT-LINE.
           MOVE 1                 TO  PRT-CTL.
           WRITE  PRINT-RCD.
261300     MOVE DOT-LINE          TO  PRINT-LINE.
261400     MOVE 1                 TO  PRT-CTL.
261500     WRITE  PRINT-RCD.
261600     MOVE ZEROS             TO  LINE-CTR.
261700
261800******************************************
261900*                                        *
262000*  GET MREQ SO THAT THE STATUS OF        *
262100*  OF THE LAST REQ CAN BE FOUND.         *
262200*  IF NO REQ IS FOUND THEN EITHER THE    *
262300*  REQ WAS CANCELLED IN WHICH CASE       *
262400*  STR-LAST-REQ-DATE IN MSTORERM IS      *
262500*  EQUAL TO "XXXXXX" OR THE REQ WAS      *
262600*  'PROCESSED & DELETED' WHICH MEANS     *
262700*  A P.O. WAS CUT BUT THE REQ WAS        *
262800*  DELETED WHEN THE PO WAS DELETED.      *
262900*  IF REQ-STAT = "XX" THEN A P.O. HAS    *
263000*  BEEN CUT. IF REQ-STAT = "X " THEN     *
263100*  MATERIALS CONTROL RELEASED THE REQ    *
263200*  FOR PURCH BUT A PO HAS NOT BEEN CUT   *
263300*  YET. IF REQ-STAT = "  " THEN MATCONT  *
263400*  HAS NOT RELEASED THE REQ YET.  THE    *
263500*  HOLD STATUS OF THE REQ IS FOUND IN    *
263600*  REQ-PAD. IF THE REQ IS IN MATCONT THE *
263700*  DEFAULT HOLD STATUS IS 'MTL. CTL.' IF *
263800*  REQ-PAD IS SPACES.  THE DEFAULT IF    *
263900*  THE REQ IS IN PURCHASING IS           *
264000*  'PURCHASING'                          *
264100*                                        *
264200******************************************
264300
264400 662-GET-MREQ.
264500     MOVE STR-LAST-REQ-NO   TO  REQ-ARG.
           MOVE REQ-ARG TO REQNO OF MREQ-REC-O.
           READ MREQ-O INTO BUF-MREQ
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
265000             IF STR-LAST-REQ-DATE  =  "XXXXXX"
265100                 MOVE "CANCELLED"  TO  REQ-STATUS-OUT
265200             ELSE
265300                 MOVE "P.O. CUT & DELETED" TO REQ-STATUS-OUT
265400         ELSE
265500             MOVE "DBGET MREQ* 662-GM"  TO  BU-DISPLAY-MSG
265600             MOVE REQ-ARG  TO  BU-DISPLAY-FLD (2)
265700             GO TO 2-BLOWUP
265800     ELSE
265900         PERFORM 663-GET-DREQD  THRU 663-GD-X
266000         IF REQ-RELEASE-STAT = "XX"
266100             MOVE "P.O. CUT"  TO  REQ-STATUS-OUT
266200         ELSE
266300         IF REQ-RELEASE-STAT  =  "X "
266400             IF REQ-HOLD-STATUS  =  SPACES
266500                 MOVE "PURCHASING"    TO  REQ-STATUS-OUT
266600             ELSE
266700                 MOVE REQ-HOLD-STATUS TO  REQ-STATUS-OUT
266800         ELSE
266900             IF REQ-HOLD-STATUS  =  SPACES
267000                 MOVE "MTL. CTL."     TO  REQ-STATUS-OUT
267100             ELSE
267200                 MOVE REQ-HOLD-STATUS TO  REQ-STATUS-OUT.
267300
267400 662-GM-X.
267500     EXIT.
267600
267700******************************************
267800*                                        *
267900*  GET DREQD TO GET THE BUYER CODE FOR   *
268000*  LAST REQUISITION SO IT CAN BE SHOWN   *
268100*  ON THE EXPIDITE, REORDER, AND STOCK   *
268200*  OUT REPORT.                           *
268300*                                        *
268400******************************************
268500
268600 663-GET-DREQD.
           MOVE REQ-ARG TO REQNO OF DREQD-REC-O.
           START DREQD-O KEY = REQNO OF DREQD-REC-O
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
                   GO TO 663-GD-X
               ELSE
269000             MOVE "FIND DREQD * 663-GD" TO BU-DISPLAY-MSG
269100             GO TO 2-BLOWUP.
269200
           READ DREQD-O NEXT INTO BUF-DREQD
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
269700             NEXT SENTENCE
269800         ELSE
269900             MOVE "DBGET DREQD* 663-GD"  TO  BU-DISPLAY-MSG
270000             MOVE REQ-ARG  TO  BU-DISPLAY-FLD (2)
270100             GO TO 2-BLOWUP
270200     ELSE
270300         MOVE DREQD-BUYER-CODE    TO BUYER-CODE-OUT.
270400
270500 663-GD-X.
270600     EXIT.
270700
270800******************************************
270900*                                        *
271000*  THIS ROUTINE UPDATES THE PERM. FILE   *
271100*  "REQDATE" THAT KEEPS THE REQ. NO.     *
271200*  SEQ. RANGE FOR BOTH ENG. & RAW        *
271300*  MATERIAL CODE REQUISITIONS EACH DAY   *
271400*  FOR UP TO 5 DAYS. THIS IS WHY RAW     *
271500*  MATERIAL CODES ARE PROCESSED ALL      *
271600*  TOGETHER TO KEEP ENG AND RAW MATERIAL *
271700*  CODES SEPERATE                        *
271800*  THE LOCK OF MPLTINFO "PREQ" KEY IS TO *
271900*  PREVENT THE REQUPDT PROGRAM AND THIS  *
272000*  PROGRAM FROM TRYING TO OPEN THE       *
272100*  REQ-DATE-SEQ-FILE AT THE SAME TIME IN *
272200*  WHICH CASE ONE PGM WOULD BLOW OFF     *
272300*                                        *
272400******************************************
272500
272600 67-UPDATE-REQ-DATE-FILE.
273600     OPEN I-O REQ-DATE-SEQ-FILE.
273700     MOVE 5  TO  REQ-SUB1.
273800     MOVE 6  TO  REQ-SUB2.
273900     READ REQ-DATE-SEQ-FILE  AT END
274000         MOVE "EOF ERROR OF REQDATE" TO BU-DISPLAY-MSG
274100         DISPLAY "FIRST SEQ= ", SAVE-FIRST-ENG-REQ-NO,
274200                                SAVE-LAST-ENG-REQ-NO
274300         DISPLAY "LAST SEQ= ", SAVE-FIRST-RAW-REQ-NO,
274400                               SAVE-LAST-RAW-REQ-NO
274500         GO TO 2-BLOWUP.
274600
274700 67-CONT-UPDATE-REQ-DATE.
274800     SUBTRACT  1  FROM REQ-SUB1, REQ-SUB2.
274900     IF REQ-SUB1 < 1
275000         GO TO 67-UPDATE-CURRENT-DATE.
275100     MOVE REQ-DATE-NO (REQ-SUB1) TO REQ-DATE-NO (REQ-SUB2)
275200     GO TO 67-CONT-UPDATE-REQ-DATE.
275300
275400 67-UPDATE-CURRENT-DATE.
275500     MOVE CUR-DATE              TO REQ-SEQ-DATE (1).
275600     MOVE SAVE-FIRST-ENG-REQ-NO TO FIRST-ENG-REQ-NO (1).
275700     MOVE SAVE-LAST-ENG-REQ-NO  TO LAST-ENG-REQ-NO (1).
275800
275900******************************************
276000**  THIS IS TEMPORARY LOGIC UNTIL RAW   **
276100**  MATERIALS ARE HANDLED. NOW WHEN     **
276200**  WHEN THE DATE IS RETRIEVED BOTH     **
276300**  ENG. AND RAW MATERIAL REQS. WILL BE **
276400**  RETRIEVED                           **
276500******************************************
276600
276700     IF SAVE-LAST-RAW-REQ-NO = ZEROS
276800         NEXT SENTENCE
276900     ELSE
277000         MOVE SAVE-LAST-RAW-REQ-NO  TO LAST-ENG-REQ-NO (1)
277100         IF SAVE-FIRST-ENG-REQ-NO  =  ZEROS
277200             MOVE SAVE-FIRST-RAW-REQ-NO  TO
277300                  FIRST-ENG-REQ-NO (1).
277400     MOVE SAVE-FIRST-RAW-REQ-NO TO FIRST-RAW-REQ-NO (1).
277500     MOVE SAVE-LAST-RAW-REQ-NO  TO LAST-RAW-REQ-NO (1).
277600     REWRITE REQ-DATE-RCD.
277700
277800 67-CLOSE-DATE-FILE.
277900     CLOSE REQ-DATE-SEQ-FILE.
278500
278600 67-URD-X.
278700     EXIT.
278800
278900******************************************************
279000*                                                    *
279100*   THIS CHECK ALL CODES THAT HAVE HAD ACTIVITY      *
279200*   BELOW REORDER THAT FELL BELOW REORDER A PRIOR    *
279300*   RUN TO THIS RUN. THE REQ-RETURN-SW = "A" OR "E"  *
279400*   IN THIS CASE. A CHECK TO SEE IF THE OUTSTANDING  *
279500*   ONORDER WILL TAKE IT BACK TO OR ABOVE REORDER OR *
279600*   IS THERE AN OPEN REQ. IF NEITHER CONDITION IS    *
279700*   TRUE THEN A REQUISITION IS CUT FOR THE CODE.     *
279800*   THIS IS A BACK UP IN CASE OF PARTIAL SHIPMENTS   *
279900*   OR A REQ. IS CANCELLED BY MISTAKE                *
280000*                                                    *
280100******************************************************
280200
280300 68-CHECK-ONORDER-AND-REQS.
280400     MOVE "N"  TO  CODE-QUALIFIES-FOR-REQ.
280500     MOVE REQ-CORP-CODE       TO  CODE-ARG.
           MOVE CODE-ARG TO CORPCDE OF MSTORERM-REC-O.
           READ MSTORERM-O INTO BUF-MSTORERM
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
281000             MOVE REQ-CORP-CODE     TO BAD-CODE-OUT
281100             MOVE BAD-CORP-CODE-MSG TO PRINT-LINE
281200             MOVE 2                 TO PRT-CTL
281300             WRITE PRINT-RCD
281400             ADD 2  TO  LINE-CTR
281500             GO TO 68-COAR-X
281600         ELSE
281700             MOVE "DBGET MSTORERM 68-COAR" TO BU-DISPLAY-MSG
281800             GO TO 2-BLOWUP.
281900
282000*****************************************
282100*                                       *
282200*   CALCULATE AVAILABLE                 *
282300*                                       *
282400*****************************************
282500
282600     SUBTRACT STR-RESERVED  FROM  STR-ONHAND
282700         GIVING AVAILABLE-ONHAND.
282800
282900************************************************
283000**   GET TOTAL STOREROOM ONORDER
283100**   BY CALLING 'SONORDER'
283200************************************************
283300
283400     MOVE "Y"                     TO  SONORDER-CALC-DIR-ORD-SW.
283500     CALL "SONORDER" USING BASE,
283600                           CODE-ARG,
283700                           SONORDER-PARMS,
283800                           COMPANY-SAVE,
283900                           STATUS-AREA,
284000                           BU-DISPLAY-MSG,
284100                           BU-DISPLAY-FLDS.
284200     IF BU-DISPLAY-MSG NOT = SPACES
284300         GO TO 2-BLOWUP.
284400     IF AKRON-PLT
284500         MOVE SONORDER-TOTAL-ONORDER TO SAVE-TOTAL-STR-ONORDER
284600     ELSE
284700         MOVE SONORDER-STR-ONORDER   TO SAVE-TOTAL-STR-ONORDER.
284800
284900*************************************************
285000*                                               *
285100*   CHECK ONORDER AND ONHAND AGAINST REORDER    *
285200*   IF THERE IS SUFFICIENT ONORDER THEN CHECK   *
285300*   FOR STOCK OUT CONDITION IF THIS IS TRUE     *
285400*   WRITE CODE IN STOCK OUT FILE OTHERWISE EXIT *
285500*   THE ROUTINE. IF THERE IS NOT SUFFICIENT     *
285600*   ONORDER THEN CHECK FOR OPEN REQS.           *
285700*                                               *
285800*************************************************
285900
286000     ADD SAVE-TOTAL-STR-ONORDER, AVAILABLE-ONHAND  GIVING
286100         TOTAL-ONORDER-ONHAND.
286200     IF TOTAL-ONORDER-ONHAND  <  STR-REORDER
286300         NEXT SENTENCE
286400     ELSE
286500         IF AVAILABLE-ONHAND = 0
286600             PERFORM 64-STOCKOUT-REQ  THRU  64-S-R-X
286700             GO TO 68-COAR-X
286800         ELSE
286900             GO TO 68-COAR-X.
287000
287100 68-CHECK-FOR-OPEN-REQS.
           MOVE CODE-ARG TO CORPCDE OF DREQITMC-REC-I.
           START DREQITMC-I KEY = CORPCDE OF DREQITMC-REC-I
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
                   GO TO 68-CHECK-ITEM-ON-DOCK
               ELSE
287500             MOVE "FIND DREQITM * 68-CFOR"  TO  BU-DISPLAY-MSG
287600             GO TO 2-BLOWUP.
287700
287800 68-GET-DREQITM.
           READ DREQITMC-I NEXT INTO BUF-DREQITM
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14"
288300             GO TO 68-CHECK-ITEM-ON-DOCK
288400         ELSE
288500             MOVE "GET DREQITM * 68-GD"  TO  BU-DISPLAY-MSG
288600             GO TO 2-BLOWUP.
           IF CORPCDE OF DREQITMC-REC-I NOT = CODE-ARG
               GO TO 68-CHECK-ITEM-ON-DOCK.
288700
288800 68-GET-MREQ.
288900     MOVE REQITM-REQ-NUMBER    TO  REQ-ARG.
           MOVE REQ-ARG TO REQNO OF MREQ-REC-O.
           READ MREQ-O INTO BUF-MREQ
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
289300         MOVE "GET MREQ * 68-GM"  TO  BU-DISPLAY-MSG
289400         MOVE REQ-ARG             TO  BU-DISPLAY-FLD (2)
289500         GO TO 2-BLOWUP.
289600
289700*************************************************
289800*                                               *
289900*   CHECK FOR OPEN REQS. IF THERE IS AT LEAST   *
290000*   ONE THEN CHECK FOR STOCKOUT AND IF THERE IS *
290100*   A STOCK OUT THEN WRITE THIS CODE TO THE     *
290200*   STOCK OUT FILE OTHERWISE EXIT THE ROUTINE.  *
290300*   NOTE A REQ IS CLOSED (ASSIGNED A PO) IF THE *
290400*   REQ RELEASE STATUS = "XX" EXCEPT WHEN THE   *
290500*   HOLD STATUS IS EQUAL TO "BATCHFILE" WHICH   *
290600*   MEANS THE REQ IS IN THE BATCH RELEASE FILE  *
290700*   AND HAS NOT BEEN ASSIGNED A RELEASE (PO)    *
290800*   BUT IS CONSIDERED A CLOSE REQ IN PURCHASING *
290900*   AND AN OPEN REQ. FOR THIS CALCULATION.      *
291000*   IF THERE IS NO OPEN REQS THEN CHECK FOR     *
291100*   QUANTITY ON DOCK THAT WILL TAKE THE ONHAND  *
291200*   BACK ABOVE REORDER                          *
291300*                                               *
291400*************************************************
291500
291600     IF REQ-RELEASE-STAT  =  "XX"
291700         IF REQ-HOLD-STATUS  =  "BATCHFILE"
291800             NEXT SENTENCE
291900         ELSE
292000             GO TO 68-GET-DREQITM.
292100
292200     IF AVAILABLE-ONHAND = 0
292300         PERFORM 64-STOCKOUT-REQ  THRU  64-S-R-X
292400         GO TO 68-COAR-X
292500     ELSE
292600         GO TO 68-COAR-X.
292700
292800*************************************************
292900*                                               *
293000*   CHECK TO SEE IF THERE IS ANY QUANTITY ON    *
293100*   THE DOCK BUT NOT YET STORED AND ADD THIS    *
293200*   QUANTITY TO ONORDER AND CHECK TO SEE        *
293300*   IF THIS TOTAL IS EQUAL OR GREATER TO        *
293400*   REORDER                                     *
293500*                                               *
293600*************************************************
293700
293800 68-CHECK-ITEM-ON-DOCK.
294500     MOVE ZEROS  TO  TOTAL-ON-DOCK, QTY-ON-DOCK.
294600
           MOVE CODE-ARG TO CORPCDE OF DPOITEM-REC-I.
           START DPOITEM-I KEY = CORPCDE OF DPOITEM-REC-I
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
                   GO TO 68-CHECK-ON-DOCK
               ELSE
294200             MOVE "FIND DREQITM * 68-CIOD"  TO  BU-DISPLAY-MSG
294300             GO TO 2-BLOWUP.
294400
294700 68-GET-DPOITEM.
           READ DPOITEM-I NEXT INTO BUF-DPOITEM
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
295200             GO TO 68-CHECK-ON-DOCK
295300         ELSE
295400             MOVE "GET DREQITM * 68-GD"  TO  BU-DISPLAY-MSG
295500             GO TO 2-BLOWUP.
           IF CORPCDE OF DPOITEM-REC-I NOT = CODE-ARG
               GO TO 68-CHECK-ON-DOCK.
295600
295700     IF ITM-QTY-DLVR > ITM-QTY-STORED
295800         SUBTRACT ITM-QTY-STORED FROM ITM-QTY-DLVR GIVING
295900             QTY-ON-DOCK
296000         IF ITM-UM = STR-UM
296100             MULTIPLY QTY-ON-DOCK  BY 1 GIVING
296200                 STR-QTY-ON-DOCK ROUNDED
296300             ADD STR-QTY-ON-DOCK TO TOTAL-ON-DOCK
296400         ELSE
296500         IF ITM-UM = STR-UM1
296600             MULTIPLY QTY-ON-DOCK  BY  STR-UM1-CF GIVING
296700                 STR-QTY-ON-DOCK ROUNDED
296800             ADD STR-QTY-ON-DOCK  TO  TOTAL-ON-DOCK
296900         ELSE
297000         IF ITM-UM = STR-UM2
297100             MULTIPLY QTY-ON-DOCK  BY  STR-UM2-CF GIVING
297200                 STR-QTY-ON-DOCK ROUNDED
297300             ADD STR-QTY-ON-DOCK  TO  TOTAL-ON-DOCK.
297400     GO TO 68-GET-DPOITEM.
297500
297600 68-CHECK-ON-DOCK.
297700     IF TOTAL-ON-DOCK = 0
297800         NEXT SENTENCE
297900     ELSE
298000         ADD  SAVE-TOTAL-STR-ONORDER, AVAILABLE-ONHAND
298100             TO  TOTAL-ON-DOCK
298200         IF TOTAL-ON-DOCK < STR-REORDER
298300             NEXT SENTENCE
298400         ELSE
298500             IF AVAILABLE-ONHAND = 0
298600                 PERFORM 64-STOCKOUT-REQ  THRU  64-S-R-X
298700                 GO TO 68-COAR-X
298800             ELSE
298900                 GO TO 68-COAR-X.
299000
299100 68-BUILD-REQ.
299200     PERFORM 62-BUILD-REQ  THRU  62-B-R-X.
299300     MOVE "Y"  TO  CODE-QUALIFIES-FOR-REQ.
299400
299500 68-COAR-X.
299600     EXIT.
299700
299800******************************************
299900*                                        *
300000*  READ THE STOCKOUT-TEMP FILE AND       *
300100*  GENERATE THE REPORT ENTITLED          *
300200*  'CORP-CODE REDUCED TO STOCKOUT LEVEL' *
300300*                                        *
300400******************************************
300500
300600 69-WRITE-STOCKOUT-REPORT.
300700     MOVE STOCKOUT-HEADER   TO  HEADER-EX-RE.
300800     MOVE ZEROS             TO  PAGE-CTR, LINE-CTR.
300900     PERFORM 661-REPORT-HDR.
301000
301100 69-READ-STOCKOUT-FILE.
301200     READ STOCKOUT-TEMP  AT END
301300         GO TO 69-WSR-X.
301400     MOVE CODE-STOCKOUT   TO CODE-ARG.
           MOVE CODE-ARG TO CORPCDE OF MSTORERM-REC-O.
           READ MSTORERM-O INTO BUF-MSTORERM
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
301900             MOVE CODE-STOCKOUT     TO BAD-CODE-OUT
302000             MOVE BAD-CORP-CODE-MSG TO PRINT-LINE
302100             MOVE 2                 TO PRT-CTL
302200             WRITE PRINT-RCD
302300             ADD 2  TO  LINE-CTR
302400             GO TO 69-READ-STOCKOUT-FILE
302500         ELSE
302600             MOVE "DBGET 69-READ-STOCKOUT" TO BU-DISPLAY-MSG
302700             GO TO 2-BLOWUP.
302800
302900     MOVE SPACES   TO  DETAIL-LINE-EX-RE.
303000     MOVE CODE-STOCKOUT          TO  EX-RE-CODE-OUT.
303100     MOVE ST-CLASS               TO  EX-RE-CLASS-OUT.
303200
303300     PERFORM 660-CHECK-LAST-REQ  THRU  660-CLR-X.
303400
303500*****************************************************
303600*                                                   *
303700*   CHECK THE RETURN-REQ-SW ON THE STOCKOUT FILE    *
303800*   TO DETERMINE IF THE CODE IS ON ANOTHER REPORT   *
303900*   IF IT IS THEN WRITE THE CORRECT CROSS-REF.      *
304000*   REPORT NAME ON THE REPORT                       *
304100*                                                   *
304200*****************************************************
304300
304400     IF STOCKOUT-SW  =  "E"
304500         MOVE "BELOW EXPEDITE"  TO  REPORT-CROSS-OUT
304600     ELSE
304700     IF STOCKOUT-SW  =  " "
304800         MOVE "PRE AUDIT"       TO  REPORT-CROSS-OUT
304900     ELSE
305000         MOVE SPACES            TO  REPORT-CROSS-OUT.
305100     PERFORM 661-PRINT-DETAIL.
305200
           IF COMPANY-SAVE = "153"
               MOVE SPACES            TO  DETAIL-LINE-EX-RE
               MOVE STR-DFLT-DEPT     TO  EX-RE-CODE-OUT
               MOVE DETAIL-LINE-EX-RE TO  PRINT-LINE
               MOVE 1                 TO  PRT-CTL
               WRITE PRINT-RCD
               ADD 1                  TO  LINE-CTR.

           PERFORM PRINT-KEY-WORD-MODIFIER.
           PERFORM PRINT-PO-INFO.
305200
305300     GO TO 69-READ-STOCKOUT-FILE.
305400
305500 69-WSR-X.
305600     EXIT.

       PRINT-KEY-WORD-MODIFIER.
           MOVE SPACES     TO RET-CODE.
           MOVE "F"        TO CDESC-DESC-OPTION.
           MOVE CORP-CODE  TO DE-CODE.
           CALL "CDESC" USING RET-CODE,
                              BASE,
                              STATUS-AREA,
                              BU-DISPLAY-MSG,
                              DE-CODE,
                              CDESC-DATA.
           IF RET-CODE = "00"
               MOVE CDESC( 1 )              TO CORP-CODE-MODIFIER-OUT
               MOVE CORP-CODE-MODIFIER-LINE TO PRINT-LINE
               MOVE  1                      TO PRT-CTL
               WRITE PRINT-RCD
               ADD 1                        TO LINE-CTR.

       PRINT-PO-INFO.

           MOVE CORP-CODE TO CORPCDE OF DPOITEM-REC-I.
           START DPOITEM-I KEY = CORPCDE OF DPOITEM-REC-I
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS  = "00"
               READ DPOITEM-I NEXT INTO BUF-DPOITEM
                   AT END MOVE FILE-STATUS TO FILE-STATUS.
           PERFORM GET-PRINT-PO-INFO  UNTIL
                   FILE-STATUS              NOT = "00"
                OR CORPCDE OF DPOITEM-REC-I NOT =  CORP-CODE.

       GET-PRINT-PO-INFO.
           MOVE SPACES TO DETAIL-LINE-PO.
           IF ITM-QTY-DLVR < ITM-QTY-ORD
               IF ITM-COMPLETE-FLAG = SPACES
                   SUBTRACT ITM-QTY-DLVR FROM ITM-QTY-ORD GIVING
                            ITM-QTY-ORD
                   MOVE ITM-PO-NO    TO   ITM-PO-NO-FORMAT
                   MOVE ITM-PO-REL   TO   ITM-PO-REL-FORMAT
                   MOVE FORMATTED-PO TO   PO-RCV-NO-OUT
                   MOVE ITM-QTY-ORD  TO   ITM-QTY-ORD-OUT
                   PERFORM GET-VENCODE-VENDOR-DETAILS
                   PERFORM PRINT-PO-LINE.
           READ DPOITEM-I NEXT INTO BUF-DPOITEM
               AT END MOVE FILE-STATUS TO FILE-STATUS.

       GET-VENCODE-VENDOR-DETAILS.
           MOVE ITM-PO-RCV-NO TO PORCVNO OF DPORECD-REC-I.
           START DPORECD-I KEY = PORCVNO OF DPORECD-REC-I
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS  = "00"
               READ DPORECD-I NEXT INTO BUF-DPORECD
                   IF FILE-STATUS = "00"
                        MOVE PO-DATE  TO DATE-VALIDATE-IN
                        MOVE 4 TO DATE-MODE
                        CALL "TDATECHK"   USING DATE-CHECK-AREA
                        MOVE DATE-SLASH-OUT TO PO-DATE-OUT
                        PERFORM MOVE-SHIP-DATE
                        PERFORM MOVE-EXPECT-DATE
                        MOVE PO-VEN-CODE  TO VENCDE OF DVENDOR-REC-I
                        START DVENDOR-I KEY = VENCDE OF DVENDOR-REC-I
                            INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS = "00"
               MOVE " "  TO VEN-DETAILS-STATUS
               PERFORM GET-VENDOR-NAME-PHONE UNTIL
                       GOT-REQUIRED-OR-END-CHAIN.

       MOVE-SHIP-DATE.
           IF   PO-SHIP-YY NUMERIC   AND
                PO-SHIP-MM NUMERIC   AND
                PO-SHIP-MM NUMERIC
                MOVE PO-SHIP-DATE  TO DATE-VALIDATE-IN
                MOVE 4             TO DATE-MODE
                CALL "TDATECHK"    USING DATE-CHECK-AREA
                MOVE DATE-SLASH-OUT TO PO-SHIP-DATE-OUT
           ELSE
                MOVE PO-SHIP-DATE  TO PO-SHIP-DATE-OUT.

       MOVE-EXPECT-DATE.
           IF   PO-EXPECT-YY NUMERIC   AND
                PO-EXPECT-MM NUMERIC   AND
                PO-EXPECT-MM NUMERIC
                MOVE PO-EXPECT-DATE  TO DATE-VALIDATE-IN
                MOVE 4             TO DATE-MODE
                CALL "TDATECHK"    USING DATE-CHECK-AREA
                MOVE DATE-SLASH-OUT TO PO-EXPECT-DT-OUT
           ELSE
                MOVE PO-EXPECT-DATE  TO PO-EXPECT-DT-OUT.

       GET-VENDOR-NAME-PHONE.
           READ DVENDOR-I NEXT INTO BUF-DVENDOR
                AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS           NOT = "00"
           OR VEN-VEN-CODE OF BUF-DVENDOR NOT = PO-VEN-CODE
               MOVE "Y" TO VEN-DETAILS-STATUS
           ELSE
               IF VEN-ITM-NO = 00
                    MOVE VEN-ITM-DATA TO PO-VEN-NAME-OUT
               ELSE
                   IF VEN-ITM-NO = 09
                       PERFORM MOVE-PHONE-NUMBER
                       MOVE "Y" TO VEN-DETAILS-STATUS.

       MOVE-PHONE-NUMBER.
           IF  VEN-CONTACT-PHONE = SPACES
               NEXT SENTENCE
           ELSE
               IF VEN-PH2-TEST  =  SPACES
                   MOVE VEN-PH2-FIRST3 TO PRT-PHONE-FIRST3
                   MOVE VEN-PH2-LAST4  TO PRT-PHONE-LAST4
                   MOVE "-"            TO PRT-PHONE-DASH2
               ELSE
                   IF VEN-PH3-TEST = SPACES
                       MOVE VEN-PH3-FIRST3  TO  PRT-PHONE-FIRST3
                       MOVE VEN-PH3-LAST4   TO PRT-PHONE-LAST4
                       MOVE "-"             TO PRT-PHONE-DASH2
                   ELSE
                       MOVE VEN-PH-AREA     TO PRT-CONTACT-AREA-CODE
                       MOVE VEN-PH-FIRST3   TO PRT-PHONE-FIRST3
                       MOVE VEN-PH-LAST4    TO PRT-PHONE-LAST4
                       MOVE "-"             TO PRT-PHONE-DASH1,
                                               PRT-PHONE-DASH2.

       PRINT-PO-LINE.
           IF LINE-CTR > 50
               PERFORM 661-REPORT-HDR
               MOVE 2       TO PRT-CTL
               MOVE DETAIL-LINE-EX-RE  TO PRINT-LINE
               WRITE PRINT-RCD
               ADD 2 TO LINE-CTR
               MOVE 1 TO PRT-CTL
               MOVE CORP-CODE-MODIFIER-LINE TO PRINT-LINE
               WRITE PRINT-RCD
               ADD 1 TO LINE-CTR.
           MOVE 1 TO PRT-CTL.
           MOVE DETAIL-LINE-PO TO PRINT-LINE.
           WRITE PRINT-RCD.
           ADD 1 TO LINE-CTR.

