194200             WRITE PRINT-RCD
194300             ADD 2              TO  LINE-CTR
194400             MOVE "Y"           TO  ERR-SW
194500             GO TO 621-MMP-X
194600         ELSE
194700             MOVE "GET MREQ 621-MMP"  TO BU-DISPLAY-MSG
194800             MOVE REQ-ARG             TO BU-DISPLAY-FLD (2)
194900             GO TO 2-BLOWUP
195000     ELSE
195100         MOVE "X"                TO  REQ-MMIS-INDIC.
195200
195300 621-MMP-X.
195400     EXIT.
195500
195600**********************************************
195700*                                            *
195800*   THIS ROUTINE DELETES THE MREQ, DREQD,    *
195900*   AND DREQITM ENTRIES UNDER THE WO REQ. NO *
196000*   AND PUTS A DREQD ENTRY UNDER THE CSIS    *
196100*   REQ. NO OUT WITH A POINTER TO AWONUM     *
196200*   BY WO NUMBER                             *
196300*                                            *
196400**********************************************
196500
196600 621-DREQ-NUM-MMIS.
198800     MOVE REQ-NUM-MMIS  TO  REQ-ARG.
           MOVE REQ-ARG TO REQNO OF DREQITM-REC-O.
           START DREQITM-O KEY = REQNO OF DREQITM-REC-O
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
199200         MOVE "FIND DREQITM 621-DNM" TO BU-DISPLAY-MSG
199300         MOVE REQ-ARG                TO BU-DISPLAY-FLD (2)
199400         GO TO 2-BLOWUP.
           READ DREQITM-O NEXT INTO BUF-DREQITM
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00" OR
              REQNO OF DREQITM-REC-O NOT = REQ-ARG
199800         MOVE "GET DREQITM 621-DNM" TO BU-DISPLAY-MSG
199900         MOVE REQ-ARG               TO BU-DISPLAY-FLD (2)
200000         GO TO 2-BLOWUP.
200100
           DELETE DREQITM-O
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
200500         MOVE "DELETE DREQITM 621-DNM" TO BU-DISPLAY-MSG
200600         MOVE REQ-ARG                  TO BU-DISPLAY-FLD (2)
200700         GO TO 2-BLOWUP.
200800
200900 621-GET-DREQD.
           MOVE REQ-ARG TO REQNO OF DREQD-REC-O.
           START DREQD-O KEY = REQNO OF DREQD-REC-O
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
201300         MOVE "FIND DREQD 621-GD" TO BU-DISPLAY-MSG
201400         MOVE REQ-ARG             TO BU-DISPLAY-FLD (2)
201500         GO TO 2-BLOWUP.
           READ DREQD-O NEXT INTO BUF-DREQD
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00" OR
              REQNO OF DREQD-REC-O NOT = REQ-ARG
201900         MOVE "GET DREQD 621-GD" TO BU-DISPLAY-MSG
202000         MOVE REQ-ARG            TO BU-DISPLAY-FLD (2)
202100         GO TO 2-BLOWUP.
202200
           DELETE DREQD-O
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
202600         MOVE "DELETE DREQD 621-GD" TO BU-DISPLAY-MSG
202700         MOVE REQ-ARG               TO BU-DISPLAY-FLD (2)
202800         GO TO 2-BLOWUP.
202900
203000 621-PUT-DREQD.
203100     MOVE BUILD-REQ-NO         TO  DREQD-REQ-NUMBER.
           WRITE DREQD-REC-O FROM BUF-DREQD
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
203500         MOVE "PUT DREQD 621-PD" TO BU-DISPLAY-MSG
203600         MOVE BUILD-REQ-NO   TO  BU-DISPLAY-FLD (2)
203700         GO TO 2-BLOWUP.
203800
203900 621-FIND-DREQDESC.
           MOVE REQ-ARG TO REQNO OF DREQDESC-REC-O.
           START DREQDESC-O KEY = REQNO OF DREQDESC-REC-O
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
                   GO TO 621-FIND-DREQQUE
               ELSE
204300             MOVE "FIND DREQDESC 621-FD" TO BU-DISPLAY-MSG
204400             MOVE REQ-ARG             TO BU-DISPLAY-FLD (2)
204500             GO TO 2-BLOWUP.
205000
205100 621-GET-DREQDESC.
           READ DREQDESC-O NEXT INTO BUF-DREQDESC
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   GO TO 621-FIND-DREQQUE
               ELSE
205700             MOVE "GET DREQDESC 621-GD" TO BU-DISPLAY-MSG
205800             MOVE REQ-ARG            TO BU-DISPLAY-FLD (2)
205900             GO TO 2-BLOWUP.
           IF REQNO OF DREQDESC-REC-O NOT = REQ-ARG
               GO TO 621-FIND-DREQQUE.
206200
           DELETE DREQDESC-O
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
206600         MOVE "DELETE DREQDESC 621-GD" TO BU-DISPLAY-MSG
206700         MOVE REQ-ARG               TO BU-DISPLAY-FLD (2)
206800         GO TO 2-BLOWUP.
206900
207000 621-PUT-DREQDESC.
207100     MOVE BUILD-REQ-NO         TO  REQDESC-REQ-NUMBER.
           WRITE DREQDESC-REC-O FROM BUF-DREQDESC
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
