       IDENTIFICATION DIVISION.
       PROGRAM-ID.     TAKRACTF.
       AUTHOR.         CA YODER.
       INSTALLATION.   GOODYEAR TIRE & RUBBER CO.
       DATE-WRITTEN.   JULY 2004.

      *D REMARKS.
      *D
      *D THIS PROGRAM CREATES A FILE CONTAINING INFORMATION FOR
      *D CODES IN MCFPCS0200 FOR AN AKRON ACCOUNTING PROCESS ON THE
      *D MAINFRAME.
      *D
      *D REQUEST #2004-07574
      *D
      *C CHANGES.
      *C

       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.
       SOURCE-COMPUTER.    IBM-AS400.
       OBJECT-COMPUTER.    IBM-AS400.

       INPUT-OUTPUT SECTION.
       FILE-CONTROL.

           SELECT MPLTINFO-I
               ASSIGN TO DATABASE-MCFLCS0501
               ORGANIZATION IS INDEXED
                 ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
               FILE STATUS IS FILE-STATUS.

           SELECT ACCT-O
               ASSIGN TO DATABASE-AKRACTFL
               ORGANIZATION IS SEQUENTIAL
               ACCESS MODE IS SEQUENTIAL
               FILE STATUS IS FILE-STATUS.

           SELECT MSTORERM-I
               ASSIGN TO DATABASE-MCFLCS0201
               ORGANIZATION IS INDEXED
                  ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
               FILE STATUS IS FILE-STATUS.

           SELECT DDESC-I
               ASSIGN TO DATABASE-MCFLCS1401
               ORGANIZATION IS INDEXED
                  ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                  WITH DUPLICATES
               FILE STATUS IS FILE-STATUS.

       DATA DIVISION.
       FILE SECTION.

       FD  MPLTINFO-I
           LABEL RECORDS ARE STANDARD.
       01  MPLTINFO-REC-I.
           COPY DDS-MCRPCS0500  OF MCFLCS0501.

       FD  ACCT-O
           LABEL RECORDS ARE STANDARD.
       01  ACCT-REC-O.
           COPY DDS-ALL-FORMATS  OF AKRACTFL.

       FD  MSTORERM-I
           LABEL RECORDS ARE STANDARD.
       01  MSTORERM-REC-I.
           COPY DDS-ALL-FORMATS  OF MCFLCS0201.

       FD  DDESC-I
           LABEL RECORDS ARE STANDARD.
       01  DDESC-REC-I.
           COPY DDS-ALL-FORMATS  OF MCFLCS1401.

       WORKING-STORAGE SECTION.

       77  CODE-ARG                       PIC X(8)  VALUE SPACES.
       77  PLT-ARG                        PIC X(4)  VALUE SPACES.
       77  SAVE-COMPANY                   PIC X(3).

       01  FILE-STATUS.
           05  FILE-STATUS-1              PIC X     VALUE "0".
           05  FILE-STATUS-2              PIC X     VALUE "0".

       COPY DATAB IN COPYLIB.

       COPY TBLOWUP IN COPYLIB.

       01  END-OF-INPUT-FILE               PIC X    VALUE "N".
           88  ALL-INPUT-RECORDS-PROCESSED          VALUE "Y".

       COPY MPLT0      IN COPYLIB.
       COPY MPLTP01    IN COPYLIB.

       COPY MSTORERM   IN COPYLIB.

       COPY DDESC      IN COPYLIB.

       COPY AKRACTFL   IN COPYLIB.

       PROCEDURE DIVISION.

       0-BEGIN.
           PERFORM 1-HSK.
           PERFORM 6-MAIN UNTIL
               ALL-INPUT-RECORDS-PROCESSED.
           PERFORM 2-EOJ.
           GOBACK.

       1-HSK.
           OPEN INPUT MPLTINFO-I, MSTORERM-I, DDESC-I.
           OPEN EXTEND ACCT-O.

           MOVE "P 01"  TO  PLT-ARG.
           MOVE PLT-ARG TO PLTINFOKEY OF MPLTINFO-REC-I.
           READ MPLTINFO-I INTO BUF-MPLTINFO
               INVALID KEY MOVE FILE-STATUS  TO  FILE-STATUS.
           IF FILE-STATUS = "00"
               MOVE MPLTINFO-COMPANY         TO  SAVE-COMPANY.

           MOVE "N" TO END-OF-INPUT-FILE.
           MOVE LOW-VALUES TO CORPCDE OF MSTORERM-REC-I.
           START MSTORERM-I KEY > CORPCDE OF MSTORERM-REC-I
              INVALID KEY
                 MOVE "BAD START ON BSTORERM-I*1-HSK" TO BU-DISPLAY-MSG
                 PERFORM 2-BLOWUP.
           READ MSTORERM-I NEXT INTO BUF-MSTORERM
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE "Y" TO END-OF-INPUT-FILE.

       2-EOJ.
           CLOSE MPLTINFO-I, MSTORERM-I, DDESC-I, ACCT-O.

       2-BLOWUP.
           MOVE "TAKRACTF" TO BU-PGM-NAME.
           CALL "TBLOWUP" USING BASE, BU-PGM-NAME, STATUS-AREA,
               DUMMY-VIEW-AREA, DUMMY-KSAM-STAT, BU-DISPLAY-MSG,
               BU-DISPLAY-AREA.

       6-MAIN.
           MOVE STR-PREV-CODE     TO  AKR-LOC-CD.
           MOVE CORP-CODE         TO  AKR-CORP-CD.
           MOVE STR-INIT-DATE     TO  AKR-INIT-DATE.
           MOVE STR-ONHAND        TO  AKR-ONHAND.
           MOVE STR-REORDER       TO  AKR-REORDER.
           MOVE STR-EOQ           TO  AKR-EOQ-SOQ.
           MOVE ST-CLASS          TO  AKR-CLASS.
           MOVE STR-AVG-COST      TO  AKR-AVG-COST.
           MOVE STR-UM            TO  AKR-UM.
           MOVE STR-MKT-COST      TO  AKR-MKT-COST.
           MOVE STR-STD-COST      TO  AKR-STD-COST.
           MOVE STR-WR-DOWN       TO  AKR-WR-DOWN.
           PERFORM 61-GET-DDESC.
           EVALUATE SAVE-COMPANY
               WHEN "111"   MOVE "10" TO AKR-STOREROOM
               WHEN "112"   MOVE "20" TO AKR-STOREROOM
               WHEN "115"   MOVE "50" TO AKR-STOREROOM
               WHEN "117"   MOVE "70" TO AKR-STOREROOM
               WHEN "119"   MOVE "90" TO AKR-STOREROOM.

           IF CORP-CODE NOT = "NON-STR"
               WRITE ACCT-REC-O FROM BUF-AKRACTFL.

           READ MSTORERM-I NEXT INTO BUF-MSTORERM
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE "Y" TO END-OF-INPUT-FILE.

       61-GET-DDESC.
           MOVE CORP-CODE   TO  CODE-ARG.
           MOVE CODE-ARG    TO  CORPCDE OF DDESC-REC-I.
           START DDESC-I KEY = CORPCDE OF DDESC-REC-I
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS = "00"
               READ DDESC-I NEXT INTO BUF-DDESC
                   AT END MOVE FILE-STATUS TO FILE-STATUS
               END-READ
               IF FILE-STATUS NOT = "00"
                   MOVE "* NO DESCRIPTION ON FILE *" TO  AKR-KWRD-ADJ
               ELSE
               IF DESC-CORP-CODE NOT = CODE-ARG
                   MOVE "* NO DESCRIPTION ON FILE *" TO  AKR-KWRD-ADJ
               ELSE
                   MOVE KWRD-ADJ                     TO  AKR-KWRD-ADJ.

