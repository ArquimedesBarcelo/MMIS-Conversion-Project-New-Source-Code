       IDENTIFICATION DIVISION.
       PROGRAM-ID.             TVOIDWOS.
       AUTHOR.                 W. ROXBURY.
       INSTALLATION.           GOODYEAR TIRE & RUBBER CO.
      *REMARKS.                THIS PROGRAM IS FOR MASS-VOIDING "OO"
      *                        STATUS VERBAL WORKORDERS TO GET RID OF
      *                        DUPLICATE OR IMPROPERLY CREATED WO'S.
      *                        ****.
       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.
       SOURCE-COMPUTER.        IBM-AS400.
       OBJECT-COMPUTER.        IBM-AS400.
       SPECIAL-NAMES.          REQUESTOR IS WORK-STATION
                               SYSTEM-CONSOLE IS CONSOLE
                               LOCAL-DATA IS LOCAL-DATA-AREA.

       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT DISPLAY-FILE
                  ASSIGN       TO WORKSTATION-ZVOIDWOS-SI
                  ORGANIZATION IS TRANSACTION
                  ACCESS MODE  IS DYNAMIC
                  RELATIVE KEY IS RECNO1
                  FILE STATUS  IS SCREEN-STATUS
                               MAJOR-MINOR
                  CONTROL-AREA IS SCREEN-CONTROL.

           SELECT DISPLAY-FILE2
                  ASSIGN       TO WORKSTATION-ZVOIDWOS-SI
                  ORGANIZATION IS TRANSACTION
                  ACCESS MODE  IS DYNAMIC
                  RELATIVE KEY IS RECNO2
                  FILE STATUS  IS SCREEN-STATUS
                               MAJOR-MINOR
                  CONTROL-AREA IS SCREEN-CONTROL.

           SELECT WO-LAST-NUM-USED
                  ASSIGN       TO DATABASE-MCFPMM0800
                  ORGANIZATION IS RELATIVE
                  ACCESS MODE  IS RANDOM
                  RELATIVE KEY IS ARG-NO
                  FILE STATUS  IS FILE-STAT.

           SELECT WO-BASIC-WO
                  ASSIGN       TO DATABASE-MCFLMM1001
                  ORGANIZATION IS INDEXED
                  ACCESS MODE  IS DYNAMIC
                  RECORD KEY   IS EXTERNALLY-DESCRIBED-KEY
                               WITH DUPLICATES
                  FILE STATUS  IS FILE-STAT.

           SELECT WO-BASIC-ZONE
                  ASSIGN       TO DATABASE-MCFLMM1008
                  ORGANIZATION IS INDEXED
                  ACCESS MODE  IS DYNAMIC
                  RECORD KEY   IS EXTERNALLY-DESCRIBED-KEY
                               WITH DUPLICATES
                  FILE STATUS  IS FILE-STAT.

           SELECT WO-BASIC-ZONE-E
                  ASSIGN       TO DATABASE-MCFLMM1009
                  ORGANIZATION IS INDEXED
                  ACCESS MODE  IS DYNAMIC
                  RECORD KEY   IS EXTERNALLY-DESCRIBED-KEY
                               WITH DUPLICATES
                  FILE STATUS  IS FILE-STAT.

           SELECT WO-BASIC-ZONE-D
                  ASSIGN       TO DATABASE-MCFLMM1010
                  ORGANIZATION IS INDEXED
                  ACCESS MODE  IS DYNAMIC
                  RECORD KEY   IS EXTERNALLY-DESCRIBED-KEY
                               WITH DUPLICATES
                  FILE STATUS  IS FILE-STAT.

           SELECT WO-ZONE-PRTY
                  ASSIGN       TO DATABASE-MCFLMM0501
                  ORGANIZATION IS INDEXED
                  ACCESS MODE  IS DYNAMIC
                  RECORD KEY   IS EXTERNALLY-DESCRIBED-KEY
                  FILE STATUS  IS FILE-STAT.

       DATA DIVISION.
       FILE SECTION.
       FD  DISPLAY-FILE
           LABEL RECORDS       ARE OMITTED.
       01  DISPLAY-REC         PIC X(2000).

       FD  DISPLAY-FILE2
           LABEL RECORDS       ARE OMITTED.
       01  DISPLAY-REC2        PIC X(2000).

       FD  WO-LAST-NUM-USED
           LABEL RECORDS       ARE STANDARD.
       01  WO-REC.
           COPY DDS-ALL-FORMATS OF MCFPMM0800.

       FD  WO-BASIC-WO
           LABEL RECORDS       ARE STANDARD.
       01  VWO-REC.
           COPY DDS-ALL-FORMATS OF MCFLMM1001.

       FD  WO-BASIC-ZONE
           LABEL RECORDS       ARE STANDARD.
       01  ZWO-REC.
           COPY DDS-ALL-FORMATS OF MCFLMM1008.

       FD  WO-BASIC-ZONE-E
           LABEL RECORDS       ARE STANDARD.
       01  ZWOE-REC.
           COPY DDS-ALL-FORMATS OF MCFLMM1009.

       FD  WO-BASIC-ZONE-D
           LABEL RECORDS       ARE STANDARD.
       01  ZWOE-REC.
           COPY DDS-ALL-FORMATS OF MCFLMM1010.

       FD  WO-ZONE-PRTY
           LABEL RECORDS ARE STANDARD.
       01  ZP-REC.
           COPY DDS-ALL-FORMATS OF MCFLMM0501.

       WORKING-STORAGE SECTION.
       77  ARG-NO              PIC 9999   VALUE 1.
       77  CTR                 PIC 9999   VALUE 0.
       77  RECNO1              PIC 9(08)  VALUE 0.
       77  RECNO2              PIC 9(08)  VALUE 0.
       77  RECNO-SAV           PIC 9(08)  VALUE 0.
       77  SORT-KEY            PIC 9      VALUE 1.
       77  VERIFY-SW           PIC 9      VALUE 0.
       77  QUEUE-SW            PIC X.
       77  QUEUE-ERROR         PIC X(76).
       77  NEG-VAL             PIC 1      VALUE B"0".
       77  TRUE-VAL            PIC 1      VALUE B"1".

       01  PASSWORD-INFORMATION.
           05  NAME-OF-PROGRAM     PIC X(08) VALUE "TVOIDWOS".
           05  PROGRAM-TYPE        PIC X(02) VALUE "UP".
           05  PROGRAM-RELEASE     PIC X(12) VALUE " J0100010001".
           05  PROGRAM-DESCRIPTION.
               10  PROG-DESC-A1    PIC X(30) VALUE
                   "PROGRAM TO MASS-VOID VERBAL WO".
               10  PROG-DESC-A2    PIC X(30) VALUE
                   "RKORDERS THAT HAVE BEEN DUPLIC".
               10  PROG-DESC-B1    PIC X(30) VALUE
                   "ATED OR IMPROPERLY CREATED.   ".
               10  PROG-DESC-B2    PIC X(30) VALUE
                   "IT IS HIGHLY RECOMMENDED THAT ".
               10  PROG-FUNCTION1  PIC X(30) VALUE
                   "THIS PROGRAM BE PASSWORD PROTE".
               10  PROG-FUNCTION2  PIC X(30) VALUE
                   "CTED.                         ".
           05  PASSWORD-FLAG       PIC X.

       01  FILE-STAT.
           05 FILE-STAT-1      PIC X.
           05 FILE-STAT-2      PIC X.

       01  WO-BUFFER.
           05 WO-NUM-BUF       PIC X(07).
           05 WO-NUM-SUF       PIC X(03).

       01  SCREEN-DATA.
           05  ZONE-DISP       PIC XXXX.
           05  SCR-MSG.
               10  CMDMSG      PIC X(79).
               10  ERRMSG      PIC X(79).

       01  SUBFILE-DATA.
           05  WO-NUM-SEL      PIC X.
           05  WO-NUM-SUB      PIC X(07).
           05  WO-PRI-SUB      PIC X.
           05  EQUIP-SUB       PIC X(06).
           05  DESC-SUB        PIC X(30).
           05  SKILL-A-SUB     PIC XX.
           05  SKILL-B-SUB     PIC XX.
           05  SKILL-C-SUB     PIC XX.
           05  SUB-DATE-TIME.
               10  SUB-DATE.
                   15  SUB-MM  PIC XX.
                   15  SLASH1  PIC X.
                   15  SUB-DD  PIC XX.
                   15  SLASH2  PIC X.
                   15  SUB-YY  PIC XX.
               10  SUB-FILL    PIC XX.
               10  SUB-TIME.
                   15  SUB-HR  PIC XX.
                   15  COLON   PIC X.
                   15  SUB-MN  PIC XX.

       01  SCREEN2-DATA.
           05  SCR2-MSG.
               10  CMDMSG2     PIC X(79).
               10  ERRMSG2     PIC X(79).

       01  SUBFILE2-DATA.
           05  WO-NUM-SUB2     PIC X(07).

       01  CURDATE-BUF.
           05  YY-BUFFER.
               10  FILLER      PIC X.
               10  DATE-YEAR   PIC X.
           05  MM-BUFFER       PIC XX.
           05  DD-BUFFER       PIC XX.

       01  TIME-BUFFER.
           05  TIME-HM.
               10  TIME-HRS    PIC 99 VALUE ZEROS.
               10  TIME-MINS   PIC 99 VALUE ZEROS.
           05  FILLER          PIC XXXX.

       01  ZONE-SCREEN-DATA.
           05  ZONE-BUF        PIC XXXX.
           05  CMDMSGZ         PIC X(79).
           05  ERRMSGZ         PIC X(79).

       01  ZONE-ARGUMENT.
           05  Z-ARG           PIC X(4).
           05  FILLER          PIC XX   VALUE "1 ".

       01  WO-PRI.
           05 WO-PR1           PIC X.
           05 WO-PR2           PIC X.

       01  DB-ERROR.
           05  DB-FUNC   PIC X(10) VALUE SPACES.
           05  DB-FILE   PIC X(18) VALUE SPACES.
           05  FILLER    PIC X(20) VALUE "ERROR - FILE-STAT = ".
           05  CON-WORD  PIC XX.

           COPY SCREENIO       IN COPYLIB.

           COPY CATREAD        IN COPYLIB.

           COPY JCWAREA        IN COPYLIB.

       01  DBPARAMETERS.
           COPY DBPARMS        IN COPYLIB.

       01  WO-BASIC-DATA.
           COPY DWOBASIC       IN COPYLIB.

       01  LAST-WO-USED-DATA.
           COPY MLASTWO        IN COPYLIB.

       01  WO-TRACK-DATA.
           COPY DWOTRACK       IN COPYLIB.

       01  WO-QUEUE-DATA.
           COPY DWOOPENQ       IN COPYLIB.

       01  ZONE-DATA.
           COPY MZONPRTY       IN COPYLIB.

       01  MESSAGE-BUFFER-DATA.
           COPY ERRORLIN       IN COPYLIB.

       01  WHO-VARIABLES.
           COPY WHOPARMS       IN COPYLIB.

       PROCEDURE DIVISION.
       MAIN-SECTION            SECTION 01.
       BEGIN.
           CALL "TPWORD"       USING PASSWORD-INFORMATION.
           IF PASSWORD-FLAG = "N"
               GOBACK.

           OPEN I-O            WO-BASIC-WO.
           OPEN INPUT          WO-BASIC-ZONE.
           OPEN INPUT          WO-BASIC-ZONE-E.
           OPEN INPUT          WO-BASIC-ZONE-D.
           OPEN I-O            DISPLAY-FILE.
           OPEN I-O            DISPLAY-FILE2.
           OPEN INPUT          WO-ZONE-PRTY.
           OPEN INPUT          WO-LAST-NUM-USED.

           MOVE 1              TO SORT-KEY.
           ACCEPT CURDATE-BUF  FROM DATE.
           ACCEPT MC-LOCAL-DATA-AREA FROM LOCAL-DATA-AREA.

           READ WO-LAST-NUM-USED INTO LAST-WO-USED-DATA
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = ZEROS
               DISPLAY "UNABLE TO GET LAST-WO-USED DATA."
                               "    FILE-STAT = " FILE-STAT
               DISPLAY "DEFAULT TO AMERICAN DATE FORMAT."
               MOVE 1          TO DATE-FLAG-SW.

           CLOSE               WO-LAST-NUM-USED.
           MOVE DATE-FLAG-SW   TO DATE-FLAG.

           MOVE SPACES         TO WO-TRACK-DATA.
           CALL "WHO"          USING MOD CAP LATTR USERNAME GRPNAME
                               ACCTNAME HOMEGRP TERMNUM.
           MOVE USERNAME       TO USER-NAME.
           MOVE TERMNUM        TO TNUM.
           MOVE TNUM           TO USER-TERM.

           IF JCW-ZJCW-269 = "    "
               PERFORM 1-GETZONE-JCW THRU 1-GZJ-EXIT
               MOVE JCW-ZJCW-269 TO ZONE-BUF Z-ARG
           ELSE
               MOVE JCW-ZJCW-269 TO ZONE-BUF Z-ARG
               MOVE ZONE-ARGUMENT TO ZONE-DATA.

           MOVE ZONE-BUF       TO ZONE-DISP.
           GO TO 6-MAIN.

       1-GETZONE-JCW.
           MOVE SPACES         TO ZONE-SCREEN-DATA MESSAGE-BUFFER.
           MOVE "VGETZONE"     TO SCREEN-NAME.

       1-SHOWFORM.
           MOVE ZONE-SCREEN-DATA TO DISPLAY-REC.
           MOVE "00"           TO SCREEN-STATUS.

           WRITE DISPLAY-REC   FORMAT IS SCREEN-NAME
               INDIC ARE SCREEN-INDICATORS.
           IF SCREEN-STATUS NOT = "00"
               DISPLAY "SCREEN WRITE ERROR.  SCREEN-STATUS IS "
                        SCREEN-STATUS
               GO TO END-OF-JOB.

           READ  DISPLAY-FILE  FORMAT IS SCREEN-NAME
               INDIC ARE SCREEN-INDICATORS
           IF SCREEN-STATUS NOT = "00"
               DISPLAY "SCREEN READ ERROR.  SCREEN-STATUS IS "
                        SCREEN-STATUS
               GO TO END-OF-JOB.

           MOVE ALL B"0"       TO SCREEN-INDICATORS.
           MOVE DISPLAY-REC    TO ZONE-SCREEN-DATA.

           IF KEY-HIT = 1 OR 3
               GO TO END-OF-JOB.

           IF KEY-HIT NOT = 0
               GO TO 1-SHOWFORM.

           IF ZONE-BUF = SPACES
      **********************************************************************
      **    MESSAGE 052/001:
      ** ZONE IS REQUIRED
      **********************************************************************
               MOVE  52        TO CATREAD-MSG-SET
               MOVE   1        TO CATREAD-MSG-NUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER TO ERRMSGZ
               MOVE TRUE-VAL   TO IND(1) IND(99)
               GO TO 1-SHOWFORM.

           MOVE ZONE-BUF       TO Z-ARG.
           MOVE ZONE-ARGUMENT  TO ZONEPRTY OF WO-ZONE-PRTY.
           READ WO-ZONE-PRTY   INTO ZONE-DATA
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
      **********************************************************************
      **    MESSAGE 035/044:
      ** INVALID ZONE
      **********************************************************************
               MOVE  35        TO CATREAD-MSG-SET
               MOVE  44        TO CATREAD-MSG-NUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER TO ERRMSGZ
               MOVE TRUE-VAL   TO IND(1) IND(99)
               GO TO 1-SHOWFORM.

           MOVE ZONE-BUF       TO JCW-ZJCW-269 SETJCW-VALUE.
           MOVE 269            TO SETJCW-STARTING-POS.
           MOVE 4              TO SETJCW-LENGTH.
           CALL "SETJCW"       USING SETJCW-VALUE,
                               SETJCW-STARTING-POS,
                               SETJCW-LENGTH,
                               SETJCW-STATUS.

           IF SETJCW-STATUS NOT = "00"
               MOVE "    "     TO JCW-ZJCW-269.

       1-GZJ-EXIT.             EXIT.

       1-CHANGE-ZONE.
           PERFORM 1-GETZONE-JCW THRU 1-GZJ-EXIT.
           GO TO 6-MAIN.

       6-PRE-SHOWFORM.
           MOVE "VOIDDISP"     TO SCREEN-NAME.
           MOVE ZONE-BUF       TO ZONE-DISP.
           MOVE SCREEN-DATA    TO DISPLAY-REC.
           MOVE "00"           TO SCREEN-STATUS.

           WRITE DISPLAY-REC   FORMAT IS SCREEN-NAME
                               INDIC ARE SCREEN-INDICATORS.
           IF SCREEN-STATUS NOT = "00"
               DISPLAY
               "SCREEN WRITE ERROR.  SCREEN-STATUS IS "
                               SCREEN-STATUS
               GO TO END-OF-JOB.

           READ  DISPLAY-FILE  FORMAT IS SCREEN-NAME
                               INDIC ARE SCREEN-INDICATORS
           IF SCREEN-STATUS NOT = "00"
               DISPLAY "SCREEN READ ERROR.  SCREEN-STATUS IS "
                               SCREEN-STATUS
               GO TO END-OF-JOB.

           MOVE ALL B"0"       TO SCREEN-INDICATORS.

           IF KEY-HIT = 1
               GO TO 1-CHANGE-ZONE.

           IF KEY-HIT = 3 OR 8
               GO TO END-OF-JOB.

           IF KEY-HIT = 4
               MOVE 1          TO SORT-KEY
               GO TO 6-MAIN.

           IF KEY-HIT = 5
               MOVE 2          TO SORT-KEY
               GO TO 6-MAIN.

           IF KEY-HIT = 6
               MOVE 3          TO SORT-KEY
               GO TO 6-MAIN.

           GO TO 6-PRE-SHOWFORM.

       6-MAIN.
           MOVE ZONE-BUF       TO ZONE-DISP.
           MOVE ZONE-ARGUMENT  TO ZONEPRTY OF WO-BASIC-ZONE
                                  ZONEPRTY OF WO-BASIC-ZONE-E
                                  ZONEPRTY OF WO-BASIC-ZONE-D.
           MOVE LOW-VALUES     TO WONUM    OF WO-BASIC-ZONE
                                  WONUM    OF WO-BASIC-ZONE-E
                                  EQPNUM   OF WO-BASIC-ZONE-E
                                  DATERECD OF WO-BASIC-ZONE-D
                                  TIMERECD OF WO-BASIC-ZONE-D.

           IF SORT-KEY = 1
               START WO-BASIC-ZONE
                   KEY NOT LESS THAN ZONEPRTY OF WO-BASIC-ZONE
                   INVALID KEY MOVE FILE-STAT TO FILE-STAT
               END-START
           ELSE
           IF SORT-KEY = 2
               START WO-BASIC-ZONE-E
                   KEY NOT LESS THAN ZONEPRTY OF WO-BASIC-ZONE-E
                   INVALID KEY MOVE FILE-STAT TO FILE-STAT
               END-START
           ELSE
               START WO-BASIC-ZONE-D
                   KEY NOT LESS THAN ZONEPRTY OF WO-BASIC-ZONE-D
                   INVALID KEY MOVE FILE-STAT TO FILE-STAT
               END-START.

           IF FILE-STAT = "23"
      **********************************************************************
      **    MESSAGE 040/002:
      ** NO WORK ORDERS IN THE BACKLOG FOR THIS ZONE
      **********************************************************************
               MOVE  40        TO CATREAD-MSG-SET
               MOVE   2        TO CATREAD-MSG-NUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER TO ERRMSG
               MOVE TRUE-VAL   TO IND(99)
               GO TO 6-PRE-SHOWFORM
           ELSE
           IF FILE-STAT NOT = "00"
               MOVE "START ERROR, WO-BASIC-ZONE(-E/D)       FILE-STAT ="
                               TO MSG-TEXT
               MOVE FILE-STAT  TO MSG-FLD
               MOVE MESSAGE-BUFFER TO ERRMSG
               MOVE TRUE-VAL   TO IND(1) IND(99)
               GO TO 6-PRE-SHOWFORM.

           MOVE 0              TO RECNO1.
           MOVE NEG-VAL        TO IND(75).
           MOVE TRUE-VAL       TO IND(77) IND(76).
           MOVE SPACES         TO SUBFILE-DATA
                                  DISPLAY-REC.
           WRITE DISPLAY-REC   FORMAT "VOID"
                               INDIC ARE SCREEN-INDICATORS.
           IF SCREEN-STATUS NOT = "00"
               DISPLAY
               "SUBFILE CLEAR WRITE ERROR.  SCREEN-STATUS IS "
                               SCREEN-STATUS.
           MOVE NEG-VAL        TO IND(77).

       DBGET-LOOP.
           IF SORT-KEY = 1
               READ WO-BASIC-ZONE  NEXT INTO WO-BASIC-DATA
                   AT END      MOVE FILE-STAT TO FILE-STAT
               END-READ
           ELSE
           IF SORT-KEY = 2
               READ WO-BASIC-ZONE-E NEXT INTO WO-BASIC-DATA
                   AT END      MOVE FILE-STAT TO FILE-STAT
               END-READ
           ELSE
               READ WO-BASIC-ZONE-D NEXT INTO WO-BASIC-DATA
                   AT END      MOVE FILE-STAT TO FILE-STAT
               END-READ.

           IF FILE-STAT = "10" OR "14" OR "46"
               GO TO SUBF-CONT
           ELSE
           IF FILE-STAT NOT = "00"
               MOVE SPACES     TO MESSAGE-BUFFER
               MOVE "READ ERROR, WO-BASIC-ZONE(-E/D)        FILE-STAT ="
                               TO MSG-TEXT
               MOVE FILE-STAT  TO MSG-FLD
               MOVE MESSAGE-BUFFER TO ERRMSG
               MOVE TRUE-VAL   TO IND(1) IND(99)
               GO TO 6-PRE-SHOWFORM.

           IF ZONE NOT = ZONE-BUF
               GO TO SUBF-CONT.

           IF WO-STATUS NOT = "OO"
               GO TO DBGET-LOOP.

           MOVE SPACES         TO SUBFILE-DATA.
           MOVE WO-NUM         TO WO-NUM-SUB.
           MOVE PRIORITY       TO WO-PRI.
           MOVE WO-PR1         TO WO-PRI-SUB.
           MOVE EQUIP-NUM      TO EQUIP-SUB.
           MOVE DESCRIPTION-1  TO DESC-SUB.
           MOVE CRAFTS-REQD-1  TO SKILL-A-SUB.
           MOVE CRAFTS-REQD-2  TO SKILL-B-SUB.
           MOVE CRAFTS-REQD-3  TO SKILL-C-SUB.
           MOVE DATE-RECD-MM   TO SUB-MM.
           MOVE DATE-RECD-DD   TO SUB-DD.
           MOVE DATE-RECD-YY   TO SUB-YY.
           MOVE "/"            TO SLASH1 SLASH2.
           MOVE TIME-RECD-HH   TO SUB-HR.
           MOVE TIME-RECD-MM   TO SUB-MN.
           MOVE ":"            TO COLON.

           ADD 1               TO RECNO1.
           MOVE SUBFILE-DATA   TO DISPLAY-REC.
           MOVE "00"           TO SCREEN-STATUS.
           WRITE SUBFILE       DISPLAY-REC FORMAT "VOIDWOS"
                               INDIC ARE SCREEN-INDICATORS
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF SCREEN-STATUS NOT = "00"
               DISPLAY   "SUBFILE 1 WRITE ERROR.  SCREEN STATUS IS "
                               SCREEN-STATUS
               GO TO END-OF-JOB.

           GO TO DBGET-LOOP.

       SUBF-CONT.
           IF RECNO1 EQUAL 0
      **********************************************************************
      **    MESSAGE 040/002:
      ** NO WORK ORDERS IN THE BACKLOG FOR THIS ZONE
      **********************************************************************
               MOVE  40        TO CATREAD-MSG-SET
               MOVE   2        TO CATREAD-MSG-NUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE FILE-STAT  TO MSG-FLD
               MOVE MESSAGE-BUFFER TO ERRMSG
               MOVE TRUE-VAL   TO IND(99)
               GO TO 6-PRE-SHOWFORM.

           WRITE DISPLAY-REC   FORMAT "VOIDSEL"
                               INDIC ARE SCREEN-INDICATORS.
           MOVE TRUE-VAL       TO IND(76).
           IF RECNO1 GREATER THAN 0
               MOVE TRUE-VAL   TO IND(75)
           ELSE
               MOVE NEG-VAL    TO IND(75).
           MOVE SCREEN-DATA    TO DISPLAY-REC.
           WRITE DISPLAY-REC   FORMAT "VOID"
                               INDIC ARE SCREEN-INDICATORS.
           READ DISPLAY-FILE   FORMAT "VOID"
                               INDIC ARE SCREEN-INDICATORS.

           IF KEY-HIT = 3 OR 8
               GO TO END-OF-JOB.

           IF KEY-HIT = 1
               GO TO 1-CHANGE-ZONE.

           IF KEY-HIT = 4
               MOVE 1          TO SORT-KEY
               GO TO 6-MAIN.

           IF KEY-HIT = 5
               MOVE 2          TO SORT-KEY
               GO TO 6-MAIN.

           IF KEY-HIT = 6
               MOVE 3          TO SORT-KEY
               GO TO 6-MAIN.

           MOVE 0              TO VERIFY-SW RECNO2.
           PERFORM UNTIL SUBFILE-DATA = SPACES
               MOVE SPACES     TO SUBFILE-DATA
               READ SUBFILE    DISPLAY-FILE
                               NEXT MODIFIED INTO SUBFILE-DATA
                               FORMAT "VOIDWOS"
                               INDIC ARE SCREEN-INDICATORS
               END-READ
               IF SUBFILE-DATA NOT = SPACES
                   IF VERIFY-SW = 0
                       PERFORM DISPLAY-SUBFILE2
                       MOVE 1          TO VERIFY-SW
                   END-IF
                   MOVE SPACES         TO SUBFILE2-DATA
                   MOVE WO-NUM-SUB     TO WO-NUM-SUB2
                   MOVE SUBFILE2-DATA  TO DISPLAY-REC2
                   MOVE "00"           TO SCREEN-STATUS
                   ADD 1               TO RECNO2
                   WRITE SUBFILE       DISPLAY-REC2 FORMAT "VERIFY"
                                       INDIC ARE SCREEN-INDICATORS
                       INVALID KEY     MOVE FILE-STAT TO FILE-STAT
                   END-WRITE
                   IF SCREEN-STATUS NOT = "00"
                       DISPLAY
                       "SUBFILE 2 WRITE ERROR.  SCREEN STATUS IS "
                                       SCREEN-STATUS
                       GO TO END-OF-JOB
                   END-IF
               END-IF
           END-PERFORM.

           PERFORM SUBFILE2-CONT THRU SUBFILE2-EXIT.
           GO TO 6-MAIN.

       DISPLAY-SUBFILE2.
           MOVE 0              TO RECNO2.
           MOVE NEG-VAL        TO IND(75).
           MOVE TRUE-VAL       TO IND(77) IND(76).
           MOVE SPACES         TO SUBFILE2-DATA
                                  DISPLAY-REC2.
           WRITE DISPLAY-REC2  FORMAT "VERIFYF"
                               INDIC ARE SCREEN-INDICATORS.
           IF SCREEN-STATUS NOT = "00"
               DISPLAY
               "SUBFILE 2 CLEAR WRITE ERROR.  SCREEN-STATUS IS "
                               SCREEN-STATUS.
           MOVE NEG-VAL        TO IND(77).

       SUBFILE2-CONT.
           IF RECNO2 EQUAL 0
               GO TO SUBFILE2-EXIT.

           WRITE DISPLAY-REC2  FORMAT "VERSEL"
                               INDIC ARE SCREEN-INDICATORS.
           MOVE TRUE-VAL       TO IND(76).
           IF RECNO2 GREATER THAN 0
               MOVE TRUE-VAL   TO IND(75)
           ELSE
               MOVE NEG-VAL    TO IND(75).
           MOVE RECNO2         TO RECNO-SAV.
           MOVE SUBFILE2-DATA  TO DISPLAY-REC2.
           WRITE DISPLAY-REC2  FORMAT "VERIFYF"
                               INDIC ARE SCREEN-INDICATORS.
           READ DISPLAY-FILE2  FORMAT "VERIFYF"
                               INDIC ARE SCREEN-INDICATORS.

           IF KEY-HIT = 3 OR 8
               GO TO 6-MAIN.

           IF KEY-HIT = 0
               PERFORM VARYING CTR FROM 1 BY 1 UNTIL CTR > RECNO-SAV
                   MOVE CTR        TO RECNO2
                   READ SUBFILE    DISPLAY-FILE2
                                   INTO SUBFILE2-DATA
                                   FORMAT "VERIFY"
                                   INDIC ARE SCREEN-INDICATORS
                   INVALID KEY     MOVE FILE-STAT TO FILE-STAT
                   END-READ
                   MOVE WO-NUM-SUB2 TO WO-NUM-BUF
                   MOVE "   "       TO WO-NUM-SUF
                   PERFORM VOID-LIST THRU VOID-LIST-EXIT
               END-PERFORM.

       SUBFILE2-EXIT.          EXIT.

       VOID-LIST.
           MOVE WO-BUFFER      TO WONUM OF WO-BASIC-WO.
           START WO-BASIC-WO   KEY = WONUM OF WO-BASIC-WO
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
               GO TO VOID-LIST-EXIT.

           READ WO-BASIC-WO    NEXT INTO WO-BASIC-DATA
               AT END          MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
               GO TO VOID-LIST-EXIT.

           MOVE "VO"           TO WO-STATUS.

           REWRITE VWO-REC     FROM WO-BASIC-DATA
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
               GO TO VOID-LIST-EXIT.

           MOVE SPACES         TO WO-QUEUE-DATA QUEUE-ERROR.
           MOVE WO-NUM         TO Q-WO-NUM.
           MOVE "D"            TO QUEUE-SW.
           CALL "TQUPDATE"     USING DBPARAMETERS
                               WO-QUEUE-DATA
                               QUEUE-SW
                               QUEUE-ERROR.

           IF QUEUE-ERROR NOT = SPACES
               GO TO VOID-LIST-EXIT.

           MOVE SPACES         TO T-WO-DATA T-STATUS-DATA.
           MOVE WO-NUM         TO WO-NUM-TRACK.
           MOVE CURDATE-BUF    TO DATE-STAMP.

           IF DATE-STAMP-YY > 70
               MOVE 19 TO DATE-STAMP-CC
           ELSE
               MOVE 20 TO DATE-STAMP-CC.

           ACCEPT TIME-BUFFER  FROM TIME.
           MOVE TIME-HM        TO TIME-STAMP.
           MOVE WO-STRT-STATUS TO WO-TYPE-STATUS.
           MOVE "VOID"         TO USER-ID CLOCK-CARD.
           MOVE WO-STATUS      TO WO-STATUS-TRACK TRANS-STATUS.
           MOVE "TVOIDWOS"     TO PROGRAM-NAME.
           CALL "TWOTRACK"     USING WO-TRACK-DATA.

       VOID-LIST-EXIT.         EXIT.

       END-OF-JOB.
           CLOSE               WO-BASIC-WO.
           CLOSE               WO-BASIC-ZONE.
           CLOSE               WO-BASIC-ZONE-E.
           CLOSE               WO-BASIC-ZONE-D.
           CLOSE               WO-ZONE-PRTY.
           CLOSE               DISPLAY-FILE.
           CLOSE               DISPLAY-FILE2.
           GOBACK.

       999-CATREAD.
           MOVE SPACES         TO MESSAGE-BUFFER.
           CALL "CCATREAD"     USING CATREAD-PARMS.
           MOVE CATREAD-MSG-TEXT TO MESSAGE-BUFFER.

       999-CATREAD-EXIT.       EXIT.

