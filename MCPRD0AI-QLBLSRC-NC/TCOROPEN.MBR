000200 IDENTIFICATION DIVISION.
000300 PROGRAM-ID. TCOROPEN.
000400 AUTHOR. KURT MOVSESIAN.
000500*REMARKS.
000700**************************************************************
000800*                                                            *
000900*   T C O R O P E N  (CSAS)  GIVES CAPABILITY TO MOVE OPEN   *
001000*    RECEIVER QUANTITIES TO PAID QUANTITIES AND CHANGE OPEN  *
001100*    RECEIVER DOLLARS.  EITHER THE CORPORATE CODE OR         *
001200*    PURCHASE ORDER AND ITEM NUMBER MUST BE ENTERED          *
001300*    TO CALL UP THE TRANSACTION TO MODIFY.                   *
001400*                                                            *
001500**************************************************************
      *C  13SEP1996      DAVE PLUM
      *C    REVISED FOR CENTURY DATABASE CHANGES.
      *C
001800 ENVIRONMENT DIVISION.
001900 CONFIGURATION SECTION.
002000 SOURCE-COMPUTER.  IBM-AS400.
002100 OBJECT-COMPUTER.  IBM-AS400.
002200
002300 SPECIAL-NAMES.    I-O-FEEDBACK IS I-O-FEEDBACK-AREA.
002500
002600 INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT DISPLAY-FILE
                  ASSIGN TO WORKSTATION-ZCOROPEN-SI
                  ORGANIZATION IS TRANSACTION
                  ACCESS IS SEQUENTIAL
                  FILE STATUS IS DISPLAY-STATUS
                  CONTROL-AREA IS WS-CONTROL.

           SELECT MATLACUM-I
                  ASSIGN TO DATABASE-MCFLCA0601
                  ORGANIZATION IS INDEXED
                    ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                  FILE STATUS IS FILE-STATUS.

           SELECT MCLASS-I
                  ASSIGN TO DATABASE-MCFLCS4901
                  ORGANIZATION IS INDEXED
                    ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                  FILE STATUS IS FILE-STATUS.

           SELECT DTRANS-PHYSICAL
                  ASSIGN TO DATABASE-MCFPCA0700
                  ORGANIZATION IS RELATIVE
                    ACCESS MODE IS RANDOM
                  RELATIVE KEY IS PFKEY
                  FILE STATUS IS FILE-STATUS.

           SELECT DTRANS-I-CDE
                  ASSIGN TO DATABASE-MCFLCA0701
                  ORGANIZATION IS INDEXED
                    ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                    WITH DUPLICATES
                  FILE STATUS IS FILE-STATUS.

           SELECT DTRANS-I-PO
                  ASSIGN TO DATABASE-MCFLCA0703
                  ORGANIZATION IS INDEXED
                    ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                    WITH DUPLICATES
                  FILE STATUS IS FILE-STATUS.

           SELECT DTRANS-O-PO
                  ASSIGN TO DATABASE-MCFLCA0703
                  ORGANIZATION IS INDEXED
                    ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                    WITH DUPLICATES
                  FILE STATUS IS FILE-STATUS.
002700
002800 DATA DIVISION.
002900 FILE SECTION.
       FD  DISPLAY-FILE
           LABEL RECORDS ARE OMITTED.
       01  DISPLAY-REC           PIC X(2000).

       FD  MATLACUM-I
           LABEL RECORDS ARE STANDARD.
       01  MATLACUM-REC-I.
           COPY DDS-ALL-FORMATS OF MCFLCA0601.

       FD  MCLASS-I
           LABEL RECORDS ARE STANDARD.
       01  MCLASS-REC-I.
           COPY DDS-ALL-FORMATS OF MCFLCS4901.

       FD  DTRANS-PHYSICAL
           LABEL RECORDS ARE STANDARD.
       01  DTRANS-REC-PHYSICAL.
           COPY DDS-ALL-FORMATS OF MCFPCA0700.

       FD  DTRANS-I-CDE
           LABEL RECORDS ARE STANDARD.
       01  DTRANS-REC-I-CDE.
           COPY DDS-ALL-FORMATS OF MCFLCA0701.

       FD  DTRANS-I-PO
           LABEL RECORDS ARE STANDARD.
       01  DTRANS-REC-I-PO.
           COPY DDS-ALL-FORMATS OF MCFLCA0703.

       FD  DTRANS-O-PO
           LABEL RECORDS ARE STANDARD.
       01  DTRANS-REC-O-PO.
           COPY DDS-ALL-FORMATS OF MCFLCA0703.

003200 WORKING-STORAGE SECTION.
003300 77  FATAL-ERR-SW                 PIC X(1)   VALUE SPACES.
003400 77  EOJ-SW                       PIC X(1)   VALUE SPACES.
003500 77  ERR-SW                       PIC X(1)   VALUE SPACES.
003600 77  AT-LEAST-ONE-FOUND-SW        PIC X(1)   VALUE SPACES.
003700 77  FOUND-ENTRY                  PIC X(1)   VALUE SPACES.
003800 77  OLD-RCVR-UNIT-VALUE          PIC S9(12)V9(2) VALUE ZEROS.
003900 77  NEW-RCVR-UNIT-VALUE          PIC S9(12)V9(2) VALUE ZEROS.
004000 77  RCVR-QTY-CHG                 PIC S9(10) VALUE ZEROS.
004100 77  SAVE-REC-ADDR                PIC S9(9) COMP VALUE ZEROS.

       01  FILE-STATUS.
           05  FILE-STATUS-1            PIC X      VALUE SPACES.
           05  FILE-STATUS-2            PIC X      VALUE SPACES.

       01  PFKEY                        PIC 9(9).
       01  SAVE-REC-NO                  PIC S9(9)  COMP-4.
