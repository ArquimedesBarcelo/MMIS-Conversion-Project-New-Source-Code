000200 IDENTIFICATION DIVISION.
000300 PROGRAM-ID.    TTYPDEL.
000600*REMARKS.  ***  THIS PROGRAM IS THE SUB-EXECUTIVE
000700*               FOR THE DELETION OF GENERIC RECORDS
000800*               FROM THE EQUIPMENT REFERENCE FILE
000900*          ***  SUBROUTINES CALLED:
001000*               TTYPDEL2
001100*               TTYPDEL3
001200*               TTYPDEL4
001300*                   ****.
001400 ENVIRONMENT DIVISION.
001500 CONFIGURATION SECTION.
001600 SOURCE-COMPUTER.    AS400.
001700 OBJECT-COMPUTER.    AS400.
       SPECIAL-NAMES. I-O-FEEDBACK IS I-O-FEEDBACK-AREA
                      LOCAL-DATA IS LOCAL-DATA-AREA.
001000 INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT DISPLAY-FILE
               ASSIGN TO WORKSTATION-ZIEQPREF-SI
               ORGANIZATION IS TRANSACTION
               ACCESS IS SEQUENTIAL
               FILE STATUS IS DSPLY-STATUS
               CONTROL-AREA IS WS-CONTROL.
001900 DATA DIVISION.
       FILE SECTION.
       FD  DISPLAY-FILE
           LABEL RECORDS ARE OMITTED.
       01  DSPLY-REC                    PIC X(2000).
002000 WORKING-STORAGE SECTION.
       COPY CATREAD OF COPYLIB.

       COPY CPYIND  OF COPYLIB.

       01  DSPLY-STATUS                 PIC XX.

       COPY IOFEEDBACK OF COPYLIB.

       01  MESSAGE-BUFFER.
           05  MESSAGE-LIT1        PIC X(38).
           05  MESSAGE-TYPNUM      PIC X(8).
           05  MESSAGE-LIT2        PIC X(13).
           05  MESSAGE-SUBSYS      PIC X(4).
           05  MESSAGE-LIT3        PIC X(17).


002100 01  PASSWORD-INFORMATION.
002200     05  NAME-OF-PROGRAM     PIC X(08) VALUE "TTYPDEL ".
002300     05  PROGRAM-TYPE        PIC X(02) VALUE "UP".
002400     05  PROGRAM-RELEASE     PIC X(12) VALUE " E0100010001".
002500     05  PROGRAM-DESCRIPTION.
002600         10  PROG-DESC-A.
                   15  FILLER      PIC X(13) VALUE "DISPLAYS THE ".
                   15  FILLER      PIC X(14) VALUE "DELETION MENU ".
                   15  FILLER      PIC X(12) VALUE "FOR GENERIC ".
                   15  FILLER      PIC X(21) VALUE "RECORDS FOR THE ".
002800         10  PROG-DESC-B.
                   15  FILLER      PIC X(10) VALUE "EQUIPMENT ".
                   15  FILLER      PIC X(50) VALUE "REFERENCE FILE ".
003000         10  PROG-FUNCTION.
                   15  FILLER      PIC X(16) VALUE "RUNS FROM THE F5".
                   15  FILLER      PIC X(12) VALUE " KEY OF THE ".
                   15  FILLER      PIC X(08) VALUE "GENERIC ".
                   15  FILLER      PIC X(24) VALUE "MAINTENANCE MENU".
003200     05  PASSWORD-FLAG       PIC X.
003300
003400 01  SCREEN-BUFFER.
003500     05  ACD-DISP                 PIC X(06).
003600     05  TYPE-NUMBER              PIC X(08).
003700     05  TYPE-DISP                PIC X(08).
003800     05  SUB-SYS                  PIC X(04).
003900     05  TYPE-OLD                 PIC X(08).
004000     05  TYPE-NEW                 PIC X(08).
           05  SCREEN-CMD-LINE          PIC X(79).
           05  SCREEN-ERR-LINE          PIC X(79).
004100
       COPY DBSTAT OF COPYLIB.

       01  TRUE-VAL                     PIC 1 VALUE B"1".

004200 01  TYPE-BUFFER                  PIC X(08).
004300
       COPY WSCONTROL OF COPYLIB.
005500 LINKAGE SECTION.
       COPY VCOMLINK OF COPYLIB.
005700 01  DBPARAMETERS.        COPY DBPARMS OF COPYLIB.
006000 01  EQP-SUB-BUFFER.
006100     05  EQP-NUM-BUF              PIC X(06).
006200     05  SUB-SYS-BUF              PIC X(04).
006300     05  EQP-SUB-DESC-BUF         PIC X(40).
006400     05  EQP-TYPE-BUF             PIC X(08).
006500     05  ACD-FUNCTION             PIC X(06).
006600     05  ACD-SW                   PIC X(01).
006700
006800 PROCEDURE DIVISION USING VIEW-COMAREA
006900                          DBPARAMETERS
007200                          EQP-SUB-BUFFER.
007300 BEGIN-PGM.
           PERFORM 1-HSK.
           PERFORM 6-MAIN THRU 6-MAIN-EXIT UNTIL VIEW-LASTKEY = 3.
       2-EOJ.
           CLOSE DISPLAY-FILE.
           GOBACK.
007400 1-HSK.
           MOVE LOW-VALUES TO STATUS-AREA.
           OPEN I-O   DISPLAY-FILE.
007500     CALL "TPWORD" USING PASSWORD-INFORMATION.
007900     IF PASSWORD-FLAG = "N" GO TO 2-EOJ.
           MOVE SPACES TO DSPLY-REC.
008400
008500 6-MAIN.
008600     MOVE "FTYPDEL" TO VIEW-CFNAME.
           IF TRUE-VAL = INDS (99)
               MOVE MESSAGE-BUFFER TO SCREEN-ERR-LINE
           ELSE
011900     MOVE SPACES TO SCREEN-BUFFER.
012000     MOVE EQP-TYPE-BUF TO TYPE-NUMBER TYPE-OLD.
012100     MOVE ACD-FUNCTION TO ACD-DISP.
           MOVE 66288 TO CATREAD-MSG-NUMBER.
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
           MOVE MESSAGE-BUFFER TO SCREEN-CMD-LINE.
           MOVE SCREEN-BUFFER TO DSPLY-REC.
           PERFORM 99-SCREEN-WRITE.
           PERFORM 98-SCREEN-READ.
           MOVE DSPLY-REC TO SCREEN-BUFFER.
014600     IF VIEW-LASTKEY = 1 OR 3 GO TO 2-EOJ.
014900     IF VIEW-LASTKEY = 2
015000         PERFORM 62-FUNCTION-2 THRU 62-F2-EXIT
015200         GO TO 6-MAIN.
015300
015400     IF VIEW-LASTKEY = 4
015500         PERFORM 62-FUNCTION-4 THRU 62-F4-EXIT
015700         GO TO 6-MAIN.
015800
015900     IF VIEW-LASTKEY = 5
016000         PERFORM 62-FUNCTION-5 THRU 62-F5-EXIT
016200         GO TO 6-MAIN.
016400
       6-MAIN-EXIT.    EXIT.

016500 62-FUNCTION-2.
016600     MOVE "FTYPDEL2" TO VIEW-CFNAME.
019900     MOVE 48005 TO CATREAD-MSG-NUMBER.
020100**MESSAGE******************************************************
020200** VERIFY TYPE NUMBER TO BE DELETED AND PRESS `ENTER'        **
020300***************************************************************
020400     PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
020500     MOVE MESSAGE-BUFFER TO SCREEN-CMD-LINE.
           MOVE SCREEN-BUFFER TO DSPLY-REC.
           PERFORM 99-SCREEN-WRITE.
           PERFORM 98-SCREEN-READ.
           MOVE DSPLY-REC TO SCREEN-BUFFER.
022800     IF VIEW-LASTKEY = 1 OR 3 GO TO 2-EOJ.
023600     IF TYPE-DISP = TYPE-NUMBER
023700         CALL "TTYPDEL2" USING VIEW-COMAREA
023800                              DBPARAMETERS
024100                              EQP-SUB-BUFFER
               IF VIEW-LASTKEY = 3
                   MOVE 0 TO VIEW-LASTKEY
                   MOVE 27050 TO CATREAD-MSG-NUMBER
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE MESSAGE-BUFFER TO SCREEN-CMD-LINE
                   MOVE TRUE-VAL TO INDS (98)
                   MOVE SCREEN-BUFFER TO DSPLY-REC
                   PERFORM 99-SCREEN-WRITE
                   PERFORM 98A-SCREEN-READ
                   CALL "CLPAUSE2"
                   GO TO 62-F2-EXIT
               ELSE
               MOVE 0 TO VIEW-LASTKEY
               MOVE TRUE-VAL TO INDS (98)
               MOVE 66326 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE TYPE-NUMBER TO MESSAGE-TYPNUM
               MOVE MESSAGE-BUFFER TO SCREEN-CMD-LINE
               MOVE SCREEN-BUFFER TO DSPLY-REC
               PERFORM 99-SCREEN-WRITE
               PERFORM 98A-SCREEN-READ
               CALL "CLPAUSE2"
024500         GO TO 62-F2-EXIT
024600     ELSE
024400     MOVE 46006 TO CATREAD-MSG-NUMBER
024600**MESSAGE******************************************************
024700** TYPE NOT VERIFIED - RETURN TO INITIATE SCREEN             **
024800***************************************************************
024900     PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
           MOVE MESSAGE-BUFFER TO SCREEN-CMD-LINE
           MOVE SCREEN-BUFFER TO DSPLY-REC
           MOVE TRUE-VAL TO INDS (98)
           PERFORM 99-SCREEN-WRITE
           PERFORM 98A-SCREEN-READ
           CALL "CLPAUSE2".
026100
026200 62-F2-EXIT.    EXIT.
026300
026400 62-FUNCTION-4.
026500     MOVE "FTYPDEL3" TO VIEW-CFNAME.
029600     MOVE SPACES TO SUB-SYS.
029900     MOVE 31006 TO CATREAD-MSG-NUMBER.
030100**MESSAGE******************************************************
030200** ENTER SUBSYSTEM NUMBER AND PRESS `ENTER'                  **
030300***************************************************************
030400     PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
030500     MOVE MESSAGE-BUFFER TO SCREEN-CMD-LINE.
           MOVE SCREEN-BUFFER TO DSPLY-REC.
           PERFORM 99-SCREEN-WRITE.
           PERFORM 98-SCREEN-READ.
032800     IF VIEW-LASTKEY = 1 OR 3 GO TO 2-EOJ.
           MOVE DSPLY-REC TO SCREEN-BUFFER.
034400     MOVE SUB-SYS TO SUB-SYS-BUF.
034500     CALL "TTYPDEL3" USING VIEW-COMAREA
034600                           DBPARAMETERS
034900                           EQP-SUB-BUFFER.
035000
           IF VIEW-LASTKEY = 3
               MOVE 0 TO VIEW-LASTKEY
               MOVE TRUE-VAL TO INDS (98)
               MOVE 66325 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE TYPE-NUMBER TO MESSAGE-TYPNUM
               MOVE SUB-SYS  TO MESSAGE-SUBSYS
               MOVE MESSAGE-BUFFER TO SCREEN-CMD-LINE
               MOVE SCREEN-BUFFER TO DSPLY-REC
               PERFORM 99-SCREEN-WRITE
               PERFORM 98A-SCREEN-READ
               CALL "CLPAUSE2"
               GO TO 62-F4-EXIT.
           IF VIEW-LASTKEY > 0
               MOVE 0 TO VIEW-LASTKEY
               MOVE TRUE-VAL TO INDS (98)
               MOVE 66324 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER TO SCREEN-CMD-LINE
               MOVE SCREEN-BUFFER TO DSPLY-REC
               PERFORM 99-SCREEN-WRITE
               PERFORM 98A-SCREEN-READ
               CALL "CLPAUSE2"
               GO TO 62-FUNCTION-4.
035100 62-F4-EXIT.    EXIT.
035200
035300 62-FUNCTION-5.
035400     MOVE "FTYPDEL4" TO VIEW-CFNAME.
038500     MOVE SPACES TO SUB-SYS.
038800     MOVE 31084 TO CATREAD-MSG-NUMBER.
039000**MESSAGE******************************************************
039100** ENTER NEW TYPE NUMBER AND PRESS `ENTER'                   **
039200***************************************************************
039300     PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
039400     MOVE MESSAGE-BUFFER TO SCREEN-CMD-LINE.
           MOVE SCREEN-BUFFER TO DSPLY-REC.
           PERFORM 99-SCREEN-WRITE.
           PERFORM 98-SCREEN-READ.
041700     IF VIEW-LASTKEY = 1 OR 3 GO TO 2-EOJ.
           MOVE DSPLY-REC TO SCREEN-BUFFER.
043300     MOVE TYPE-NEW TO TYPE-BUFFER.
043400     CALL "TTYPDEL4" USING VIEW-COMAREA
043500                           DBPARAMETERS
043800                           EQP-SUB-BUFFER
043900                           TYPE-BUFFER.
           MOVE 0 TO VIEW-LASTKEY.
           MOVE 27051 TO CATREAD-MSG-NUMBER.
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
           MOVE MESSAGE-BUFFER TO SCREEN-CMD-LINE.
           MOVE SCREEN-BUFFER TO DSPLY-REC.
           MOVE TRUE-VAL TO INDS (98).
           PERFORM 99-SCREEN-WRITE.
           PERFORM 98A-SCREEN-READ.
           CALL "CLPAUSE2".
044100 62-F5-EXIT.    EXIT.
044200
       98-SCREEN-READ.
           READ DISPLAY-FILE FORMAT IS VIEW-CFNAME
               INDIC IS INDICS.
           ACCEPT IOFEEDBACK FROM I-O-FEEDBACK-AREA.
           MOVE ALL B"0" TO INDICS.
           IF DSPLY-STATUS NOT = "00"
               MOVE 3 TO VIEW-LASTKEY
           ELSE
           MOVE FUNCTION-NUM TO VIEW-LASTKEY.

       98A-SCREEN-READ.
           READ DISPLAY-FILE TERMINAL IS TERMINAL-ID
               INDIC IS INDICS
                  NO DATA MOVE DSPLY-STATUS TO DSPLY-STATUS.
           MOVE ALL B"0" TO INDICS.

       99-SCREEN-WRITE.
           WRITE DSPLY-REC FORMAT IS VIEW-CFNAME
               INDIC IS INDICS.
           MOVE ALL B"0" TO INDICS.

044800 999-CATREAD.
044900     MOVE SPACES TO MESSAGE-BUFFER.
           CALL "CCATREAD" USING CATREAD-PARMS.
           MOVE CATREAD-MSG-TEXT TO MESSAGE-BUFFER.
045900 999-CATREAD-EXIT.    EXIT.
