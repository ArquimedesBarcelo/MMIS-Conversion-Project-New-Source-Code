                      MSTORERM-I
                      MPLTINFO-I
                      DPORECD-I,
                      DPORECDH-I.
           OPEN I-O DISPLAY-FILE.

           MOVE "P 01" TO PLTINFOKEY  OF MPLTINFO-I.
           READ MPLTINFO-I INTO BUF-MPLTINFO INVALID KEY
                MOVE FILE-STATUS TO FILE-STATUS.
033300     IF FILE-STATUS NOT = "00"
033400           MOVE "DBGET MPLTINFO - TPOINQCS " TO BU-DISPLAY-MSG
033500           PERFORM 2100-BLOWUP.
033600     MOVE MPLTINFO-COMPANY TO PLT-NUMBER.

027100     PERFORM 6000-MAIN THRU 6990-MAIN-X.

           CLOSE      DPOITEMC-I,
                      DPOITEMP-I,
                      DRCVITEMC-I,
                      DRCVITEMP-I,
                      DPOITEMCH-I,
                      DPOITEMPH-I,
                      DRCVITEMCH-I,
                      DRCVITEMPH-I,
                      MSTORERM-I,
                      MPLTINFO-I,
                      DPORECD-I,
                      DPORECDH-I,
                      DISPLAY-FILE.
027200     GOBACK.
027300
027400 2100-BLOWUP.
027600     MOVE "TPOINQCS" TO BU-PGM-NAME.
027700     CALL "TBLOWUP" USING BASE BU-PGM-NAME STATUS-AREA
027800       VIEW-COMAREA FILE-STATUS BU-DISPLAY-MSG
027900           BU-DISPLAY-FLDS.
028000
028100 6000-MAIN.
028300     MOVE CORP-CODE-SCREEN  TO VIEW-NFNAME.
           MOVE SPACES TO SCREEN-BUFFER-CODE.
030200
030300 6200-SHOW-FORM-1.
           MOVE SCREEN-BUFFER-CODE TO DISPLAY-REC.
           PERFORM 998-WRITE-SCREEN THRU 998-READ-SCREEN.
           MOVE DISPLAY-REC    TO SCREEN-BUFFER-CODE.

           IF VIEW-LASTKEY = 1 OR 2 OR 4 OR 5 OR 7 OR 8
      *        ***  INVALID FUNCTION KEY ENTERED  ***
               MOVE   9 TO LANG-SETNUM
               MOVE  10 TO LANG-MSGNUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE 1  TO  FIELD-NUMBER
034700         PERFORM  9-USER-ERROR  THRU  9-USER-ERROR-X
034800         GO TO 6200-SHOW-FORM-1.
031100
031200     IF VIEW-LASTKEY = 3
031300         GO TO 6990-MAIN-X.
031100
031200     IF VIEW-LASTKEY = 6
031300         MOVE "X"     TO HIST-SEARCH-FLG
032200         MOVE 0       TO VIEW-LASTKEY.

      *------SORT SELECTION MAY ONLY BE "A" OR "D"
           IF DE-SORT NOT = "A" AND DE-SORT NOT = "D"
                                AND DE-SORT NOT = " "
      *        ***  INVALID ENTRY ***
               MOVE  35 TO LANG-SETNUM
               MOVE 105 TO LANG-MSGNUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE 2  TO  FIELD-NUMBER
034700         PERFORM  9-USER-ERROR  THRU  9-USER-ERROR-X
034800         GO TO 6200-SHOW-FORM-1.
032200
      *------ ADDED LOGIC TO FORCE DESCENDING ORDER FOR LAWTON
      *------ IF THEY FORGOT TO LOAD A VALUE FOR SORTING.
           IF DE-SORT = " "
               IF PLT-NUMBER = "153"
                   MOVE "D" TO DE-SORT.

032300*------ FIND AND GET ALL THE ACCUMULATOR ENTRIES FOR THAT CODE.
032400 6240-FIND-DPOITEM.
032500
032600*------ CHECK TO SEE IF THIS IS AN ALTERNATE KEY.  THE SUBPROG
032700*------ WILL NOT DO ANY PROCESSING IF IT IS A 7-DIGIT NUMERIC
032800     MOVE DE-CODE                  TO   ALT-KEY-ARG.
032900     CALL "TALTKEY" USING ALT-RET-CODE, BASE, STATUS-AREA,
033000       ALT-KEY-ARG, ALT-CORP-CODE.
033100     IF ALT-RET-CODE NOT = "00"
033200         MOVE "TALTKEY ERR 623-GB" TO   BU-DISPLAY-MSG
033300         PERFORM 2100-BLOWUP.
033400
033500     MOVE ALT-CORP-CODE            TO   DE-CODE.
033600
033700     MOVE 0                        TO   SUB.
033800     MOVE DE-CODE                  TO   CODE-ARG.
           MOVE CODE-ARG TO CORPCDE OF MSTORERM-REC-I.
           READ MSTORERM-I INTO BUF-MSTORERM
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
034300*            "S9: STORES CODE DOES NOT EXIST"
034400             MOVE  19 TO LANG-SETNUM  MOVE   9 TO LANG-MSGNUM
034500             PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
034600             MOVE 1  TO  FIELD-NUMBER
034700             PERFORM  9-USER-ERROR  THRU  9-USER-ERROR-X
034800             GO TO 6200-SHOW-FORM-1
               ELSE
                   MOVE "READ MSTORERM-I *6240-FD" TO BU-DISPLAY-MSG
                   PERFORM 2100-BLOWUP.

           IF HIST-SEARCH-FLG = "X"
               MOVE CODE-ARG TO CORPCDE OF DPOITEMCH-REC-I
               START DPOITEMCH-I KEY > CORPCDE OF DPOITEMCH-REC-I
                   INVALID KEY MOVE FILE-STATUS TO FILE-STATUS
               END-START
           ELSE
               MOVE CODE-ARG TO CORPCDE OF DPOITEMC-REC-I
               START DPOITEMC-I KEY > CORPCDE OF DPOITEMC-REC-I
                   INVALID KEY MOVE FILE-STATUS TO FILE-STATUS
               END-START
           END-IF.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
      *------- SET THE FILE TO THE LAST RECORD AND SEE IF IT IS
      *------- THE CORP CODE THAT THE USER IS TRYING TO RETRIEVE
      *------- INFORMATION FOR.
                   IF HIST-SEARCH-FLG = "X"
                       READ DPOITEMCH-I LAST RECORD INTO BUF-DPOITEM-H
                       IF CORPCDE OF DPOITEMCH-REC-I = CODE-ARG
                           GO TO 6245-GAL-CONT
                       ELSE
                       GO TO 6245-GET-ACCUMULATOR-LOOP
                   ELSE
                       READ DPOITEMC-I LAST RECORD INTO BUF-DPOITEM
                       IF CORPCDE OF DPOITEMC-REC-I = CODE-ARG
                           GO TO 6245-GAL-CONT
                       ELSE
                       GO TO 6245-GET-ACCUMULATOR-LOOP
034900         ELSE
035000             MOVE "DBFIND ERR DPOITEM 6240-FD" TO BU-DISPLAY-MSG
035100             PERFORM 2100-BLOWUP.
035200
035300*------- WE MUST GET ALL PO'S FOR THE CODE, SO WE DONT BOTHER GOING
035400*------- BACKWARD.  IF MORE THAN 300 POS FOR A CODE, THERE IS A
035500*------- PROBLEM.
035600 6245-GET-ACCUMULATOR-LOOP.
           IF HIST-SEARCH-FLG = "X"
               READ DPOITEMCH-I PRIOR RECORD INTO BUF-DPOITEM-H
                   AT END MOVE FILE-STATUS TO FILE-STATUS
               END-READ
           ELSE
               READ DPOITEMC-I PRIOR RECORD INTO BUF-DPOITEM
                   AT END MOVE FILE-STATUS TO FILE-STATUS
               END-READ
           END-IF.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   GO TO 6300-FIND-DRCVITEM
               ELSE
036300             MOVE "DBGET ERR DPOITEM 6245-GAL" TO BU-DISPLAY-MSG
036400             PERFORM 2100-BLOWUP.
           IF HIST-SEARCH-FLG = "X"
               IF CORPCDE OF DPOITEMCH-REC-I NOT = CODE-ARG
                   GO TO 6300-FIND-DRCVITEM
               END-IF
           ELSE
               IF CORPCDE OF DPOITEMC-REC-I NOT = CODE-ARG
                   GO TO 6300-FIND-DRCVITEM
               END-IF
           END-IF.
036500
       6245-GAL-CONT.
036600     ADD 1                         TO   SUB.
036700     IF SUB > TABLE-MAX
036800         MOVE TABLE-MAX            TO   TABLE-LIMIT
036900         GO TO 6340-SORT-TABLE.
037000
037000     IF HIST-SEARCH-FLG = "X"
037100         MOVE ITMH-PO-RCV-NO        TO   SAVE-PO-RCV-NO (SUB)
037200         MOVE ITMH-NUMBER           TO   SAVE-ITEM-NO (SUB)
037300         MOVE "++ HISTORY DATABASE ++" TO HISTORY-MESSAGE
               MOVE SAVE-POH (SUB)        TO   PO-ARG-NO-H
               MOVE PO-ARG-H TO PORCVNO OF DPORECDH-I
               READ DPORECDH-I INTO BUF-DPORECD-H
               END-READ
               IF FILE-STATUS NOT = "00"
                   MOVE ZEROS TO SAVE-PO-DATE (SUB)
               ELSE
                   MOVE POH-DATE TO HOLD-DATE
                   MOVE HOLD-DATE TO SAVE-PO-DATE (SUB)
               END-IF
037000     ELSE
037100         MOVE ITM-PO-RCV-NO        TO   SAVE-PO-RCV-NO (SUB)
037200         MOVE ITM-NUMBER           TO   SAVE-ITEM-NO (SUB)
037300         MOVE "++++ LIVE DATABASE ++++" TO HISTORY-MESSAGE
               MOVE SAVE-PO (SUB)        TO   PO-ARG-NO
               MOVE PO-ARG TO PORCVNO OF DPORECD-I
               READ DPORECD-I INTO BUF-DPORECD
               END-READ
               IF FILE-STATUS NOT = "00"
                   MOVE ZEROS TO SAVE-PO-DATE (SUB)
               ELSE
                   MOVE PO-DATE-CN TO SAVE-PO-DATE (SUB)
               END-IF.
037600
037400     GO TO 6245-GET-ACCUMULATOR-LOOP.
037500
037600
037700*------ FIND AND GET ALL RECEIVERS FOR THAT CODE.
037800 6300-FIND-DRCVITEM.
           IF HIST-SEARCH-FLG = "X"
               MOVE CODE-ARG TO CORPCDE OF DRCVITEMCH-REC-I
               START DRCVITEMCH-I KEY > CORPCDE OF DRCVITEMCH-REC-I
                   INVALID KEY MOVE FILE-STATUS TO FILE-STATUS
               END-START
           ELSE
               MOVE CODE-ARG TO CORPCDE OF DRCVITEMC-REC-I
               START DRCVITEMC-I KEY > CORPCDE OF DRCVITEMC-REC-I
                   INVALID KEY MOVE FILE-STATUS TO FILE-STATUS
               END-START
           END-IF.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
      *--------- SET TO END OF FILE IN CASE CORP CODE BEING LOOKED
      *--------- FOR IS THE LAST ONE ON THE FILE
                   IF HIST-SEARCH-FLG = "X"
                       START DRCVITEMCH-I KEY > HV-KEY
                           INVALID KEY MOVE FILE-STATUS TO FILE-STATUS
                       END-START
                       GO TO 6310-GET-RECEIVER-LOOP
                   ELSE
                   START DRCVITEMC-I KEY > HV-KEY
                       INVALID KEY MOVE FILE-STATUS TO FILE-STATUS
                   END-START
                   GO TO 6310-GET-RECEIVER-LOOP
034900         ELSE
039000         MOVE "DBFIND ERR DRCVITEM 6300-FR" TO BU-DISPLAY-MSG
039100         PERFORM 2100-BLOWUP.
039200
039300*--------- LOAD UP THE RECEIVER TABLE.
039400*--------- GO BACKWARDS TO GET THE LATEST ENTRIES
039500 6310-GET-RECEIVER-LOOP.
           IF HIST-SEARCH-FLG = "X"
               READ DRCVITEMCH-I PRIOR RECORD INTO BUF-DRCVITEM-H
                   AT END MOVE FILE-STATUS TO FILE-STATUS
               END-READ
           ELSE
               READ DRCVITEMC-I PRIOR RECORD INTO BUF-DRCVITEM
                   AT END MOVE FILE-STATUS TO FILE-STATUS
               END-READ
           END-IF.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
040000             MOVE SUB              TO   TABLE-LIMIT
040100             GO TO 6340-SORT-TABLE
               ELSE
036300             MOVE "DBGET ERR DPOITEM 6245-GAL" TO BU-DISPLAY-MSG
036400             PERFORM 2100-BLOWUP.
           IF HIST-SEARCH-FLG = "X"
               IF CORPCDE OF DRCVITEMCH-REC-I NOT = CODE-ARG
040000             MOVE SUB              TO   TABLE-LIMIT
040100             GO TO 6340-SORT-TABLE
040500         END-IF
040500     ELSE
               IF CORPCDE OF DRCVITEMC-REC-I NOT = CODE-ARG
040000             MOVE SUB              TO   TABLE-LIMIT
040100             GO TO 6340-SORT-TABLE
040500         END-IF
040500     END-IF.
040500
040500
040600     ADD 1                         TO   SUB.
040700     IF SUB > TABLE-MAX
040800         MOVE TABLE-MAX            TO   TABLE-LIMIT
040900         GO TO 6340-SORT-TABLE.
041000
           IF HIST-SEARCH-FLG = "X"
041100         MOVE RCVH-PO-RCV-NO       TO   SAVE-PO-RCV-NO (SUB)
041200         MOVE RCVH-ITEM-NUMBER     TO   SAVE-ITEM-NO (SUB)
037300         MOVE "++ HISTORY DATABASE ++" TO HISTORY-MESSAGE
      *---------- GET PO DATE OF RECEIVER TO SORT WITH PO
               MOVE SAVE-POH (SUB)        TO   PO-ARG-NO-H
               MOVE PO-ARG-H TO PORCVNO OF DPORECDH-I
               READ DPORECDH-I INTO BUF-DPORECD-H
               END-READ
               IF FILE-STATUS NOT = "00"
                   MOVE ZEROS TO SAVE-PO-DATE (SUB)
               ELSE
                   MOVE POH-DATE TO HOLD-DATE
                   MOVE HOLD-DATE TO SAVE-PO-DATE (SUB)
               END-IF
040500     ELSE
041100         MOVE RCV-PO-RCV-NO        TO   SAVE-PO-RCV-NO (SUB)
041200         MOVE RCV-ITEM-NUMBER      TO   SAVE-ITEM-NO (SUB)
037300         MOVE "++++ LIVE DATABASE ++++" TO HISTORY-MESSAGE
      *---------- GET PO DATE OF RECEIVER TO SORT WITH PO
               MOVE SAVE-PO (SUB)        TO   PO-ARG-NO
               MOVE PO-ARG TO PORCVNO OF DPORECD-I
               READ DPORECD-I INTO BUF-DPORECD
               END-READ
               IF FILE-STATUS NOT = "00"
                   MOVE ZEROS TO SAVE-PO-DATE (SUB)
               ELSE
                   MOVE PO-DATE-CN TO SAVE-PO-DATE (SUB)
               END-IF.
040500
041300     GO TO 6310-GET-RECEIVER-LOOP.
041400
041500*------ NOW USE THE BUBBLE SORT TO SORT IN ORDER BY RECEIVER NUMBER
      *
      *------ 01/10/97  INCLUDE A FIRST LEVEL CHECK IN THE SORTING TO
      *------  FIRST SORT BY DATE, THEN SORT BY PO NUMBER.  SORTING BY
      *------  DATE CAN BE EITHER DESCENDING OR ASCENDING.
041600 6340-SORT-TABLE.
041700     SUBTRACT 1 FROM TABLE-LIMIT GIVING TABLE-LIMIT-MINUS-1.
041800 6340-SORT-TABLE-OUTER-LOOP.
041900     MOVE 0                        TO   SUB.
042000     MOVE "N"                      TO   SWITCH-FLAG.
042100 6350-SORT-TABLE-INNER-LOOP.
042200     ADD 1                         TO   SUB.
042300     IF SUB > TABLE-LIMIT-MINUS-1
042400         IF SWITCH-FLAG = "Y"
042500             GO TO 6340-SORT-TABLE-OUTER-LOOP
042600         ELSE
042700             GO TO 6400-SETUP-SCREEN.
042800
042900     ADD 1, SUB GIVING SUBP1.
      *------ SORT PO DATE DESCEND AND PO NUMBER
           IF DE-SORT = "D"
               IF SAVE-PO-DATE (SUB) < SAVE-PO-DATE (SUBP1)
                 MOVE "Y"                    TO   SWITCH-FLAG
                 MOVE SAVE-PO-RCV-NO (SUB)   TO   TEMP-PO-RCV-NO
                 MOVE SAVE-PO-RCV-NO (SUBP1) TO   SAVE-PO-RCV-NO (SUB)
                 MOVE TEMP-PO-RCV-NO         TO   SAVE-PO-RCV-NO (SUBP1)
                 MOVE SAVE-ITEM-NO (SUB)     TO   TEMP-ITEM-NO
                 MOVE SAVE-ITEM-NO (SUBP1)   TO   SAVE-ITEM-NO (SUB)
                 MOVE TEMP-ITEM-NO           TO   SAVE-ITEM-NO (SUBP1)
                 MOVE SAVE-PO-DATE (SUB)     TO   TEMP-PO-DATE
                 MOVE SAVE-PO-DATE (SUBP1)   TO   SAVE-PO-DATE (SUB)
                 MOVE TEMP-PO-DATE           TO   SAVE-PO-DATE (SUBP1)
               ELSE
                 IF SAVE-PO-DATE (SUB) = SAVE-PO-DATE (SUBP1) AND
043000              SAVE-PO-RCV-NO (SUB) > SAVE-PO-RCV-NO (SUBP1)
043100             MOVE "Y"                    TO   SWITCH-FLAG
043200             MOVE SAVE-PO-RCV-NO (SUB)   TO   TEMP-PO-RCV-NO
043300             MOVE SAVE-PO-RCV-NO (SUBP1) TO   SAVE-PO-RCV-NO (SUB)
043400             MOVE TEMP-PO-RCV-NO         TO SAVE-PO-RCV-NO (SUBP1)
043500             MOVE SAVE-ITEM-NO (SUB)     TO   TEMP-ITEM-NO
043600             MOVE SAVE-ITEM-NO (SUBP1)   TO   SAVE-ITEM-NO (SUB)
043700             MOVE TEMP-ITEM-NO           TO SAVE-ITEM-NO (SUBP1)
                   MOVE TEMP-PO-RCV-NO         TO SAVE-PO-RCV-NO (SUBP1)
                   MOVE SAVE-PO-DATE (SUB)     TO   TEMP-PO-DATE
                   MOVE SAVE-PO-DATE (SUBP1)   TO   SAVE-PO-DATE (SUB)
                   MOVE TEMP-PO-DATE           TO SAVE-PO-DATE (SUBP1)
                 END-IF
               END-IF
           ELSE
      *------ SORT PO DATE ASCEND AND PO NUMBER
             IF DE-SORT = "A"
               IF SAVE-PO-DATE (SUB) > SAVE-PO-DATE (SUBP1)
                 MOVE "Y"                    TO   SWITCH-FLAG
                 MOVE SAVE-PO-RCV-NO (SUB)   TO   TEMP-PO-RCV-NO
                 MOVE SAVE-PO-RCV-NO (SUBP1) TO   SAVE-PO-RCV-NO (SUB)
                 MOVE TEMP-PO-RCV-NO         TO   SAVE-PO-RCV-NO (SUBP1)
                 MOVE SAVE-ITEM-NO (SUB)     TO   TEMP-ITEM-NO
                 MOVE SAVE-ITEM-NO (SUBP1)   TO   SAVE-ITEM-NO (SUB)
                 MOVE TEMP-ITEM-NO           TO   SAVE-ITEM-NO (SUBP1)
                 MOVE SAVE-PO-DATE (SUB)     TO   TEMP-PO-DATE
                 MOVE SAVE-PO-DATE (SUBP1)   TO   SAVE-PO-DATE (SUB)
                 MOVE TEMP-PO-DATE           TO SAVE-PO-DATE (SUBP1)
               ELSE
                 IF SAVE-PO-DATE (SUB) = SAVE-PO-DATE (SUBP1) AND
                    SAVE-PO-RCV-NO (SUB) > SAVE-PO-RCV-NO (SUBP1)
                   MOVE "Y"                    TO   SWITCH-FLAG
                   MOVE SAVE-PO-RCV-NO (SUB)   TO   TEMP-PO-RCV-NO
                   MOVE SAVE-PO-RCV-NO (SUBP1) TO   SAVE-PO-RCV-NO (SUB)
                   MOVE TEMP-PO-RCV-NO         TO SAVE-PO-RCV-NO (SUBP1)
                   MOVE SAVE-ITEM-NO (SUB)     TO   TEMP-ITEM-NO
                   MOVE SAVE-ITEM-NO (SUBP1)   TO   SAVE-ITEM-NO (SUB)
                   MOVE TEMP-ITEM-NO           TO SAVE-ITEM-NO (SUBP1)
                   MOVE SAVE-PO-DATE (SUB)     TO   TEMP-PO-DATE
                   MOVE SAVE-PO-DATE (SUBP1)   TO   SAVE-PO-DATE (SUB)
                   MOVE TEMP-PO-DATE           TO SAVE-PO-DATE (SUBP1)
                 END-IF
               END-IF
             ELSE
      *------ SORT BY PO NUMBER ONLY
                 IF SAVE-PO-RCV-NO (SUB) > SAVE-PO-RCV-NO (SUBP1)
                   MOVE "Y"                    TO   SWITCH-FLAG
                   MOVE SAVE-PO-RCV-NO (SUB)   TO   TEMP-PO-RCV-NO
                   MOVE SAVE-PO-RCV-NO (SUBP1) TO   SAVE-PO-RCV-NO (SUB)
                   MOVE TEMP-PO-RCV-NO         TO SAVE-PO-RCV-NO (SUBP1)
                   MOVE SAVE-ITEM-NO (SUB)     TO   TEMP-ITEM-NO
                   MOVE SAVE-ITEM-NO (SUBP1)   TO   SAVE-ITEM-NO (SUB)
                   MOVE TEMP-ITEM-NO           TO SAVE-ITEM-NO (SUBP1)
                   MOVE SAVE-PO-DATE (SUB)     TO   TEMP-PO-DATE
                   MOVE SAVE-PO-DATE (SUBP1)   TO   SAVE-PO-DATE (SUB)
                   MOVE TEMP-PO-DATE           TO SAVE-PO-DATE (SUBP1)
                 END-IF
               END-IF
           END-IF.
043800
043900     GO TO 6350-SORT-TABLE-INNER-LOOP.
044000
044100 6400-SETUP-SCREEN.
044200     MOVE INQUIRY-SCREEN TO  VIEW-NFNAME.
045000
045100********************************
045200*                              *
045300*  MSTOREROOM - ONORDER & UM   *
045400*                              *
045500********************************
045600
045700 6410-GET-STOREROOM.
           MOVE CODE-ARG TO CORPCDE OF MSTORERM-REC-I.
           READ MSTORERM-I INTO BUF-MSTORERM
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
046100         MOVE "DBGET  MSTORERM -TPOINQCS" TO BU-DISPLAY-MSG
046200         PERFORM 2100-BLOWUP.

046300*---  CALL "SONORDER" TO GET TOTAL ONORDER IN STR UM
046400*        MOVE "111" TO COMPANY, WE DON'T KNOW IT AND WE
046500*        DON'T CARE SINCE WE JUST WANT TOTAL ONORDER ANYWAY
046600     MOVE "111"                  TO      COMPANY-SAVE.
046700     MOVE "N"                     TO  SONORDER-CALC-DIR-ORD-SW.
046800     CALL "SONORDER" USING BASE,
046900                           CODE-ARG,
047000                           SONORDER-PARMS,
047100                           COMPANY-SAVE,
047200                           STATUS-AREA,
047300                           BU-DISPLAY-MSG,
047400                           BU-DISPLAY-FLDS.
047500     IF BU-DISPLAY-MSG NOT = SPACES
047600         MOVE "ERROR  "          TO      SCREEN-ONORDER-RED
047700         MOVE SPACES             TO      BU-DISPLAY-MSG
047800         MOVE ALL "0"            TO      BU-DISPLAY-AREA
047900     ELSE
048000         MOVE SONORDER-TOTAL-ONORDER TO  SCREEN-ONORDER.

048100     MOVE STR-UM                 TO      SCREEN-ONORDER-UM.
048200     MOVE CODE-ARG               TO      SCREEN-CODE.
048300     MOVE STR-LOC (1)            TO      SCREEN-BIN-LOC.
048400
048500********************************
048600*                              *
048700*  DDESC - KEYWORD & ADJECTIVE *
048800*                              *
048900********************************
049000
049100 6420-GET-DESC.
049200     MOVE 1                        TO   CDESC-LINES-TO-GET.
049300     MOVE "K"                      TO   CDESC-DESC-OPTION.
049400     CALL "CDESC" USING CDESC-RET-CODE, BASE, STATUS-AREA,
049500       BU-DISPLAY-MSG, CODE-ARG, CDESC-DATA.
049600     IF BU-DISPLAY-MSG-1 NOT = SPACES
049700         PERFORM 2100-BLOWUP.
049800     MOVE CDESC (1)                TO   SCREEN-DESC.
049900
050000*------ INITIALIZE THE TABLE COUNTERS FOR THIS SCREEN.
050100     MOVE 0                        TO   TABLE-END-SCREEN.
050200     MOVE 0                        TO   TABLE-START-SCREEN.
050300     MOVE 0                        TO   TABLE-SUB.
050400
050500 6430-GET-MORE.
050600*--------- TO START, GET THE FIRST 10 OR SO RECEIVERS AND MOVE TO SCREEN.
050700     PERFORM 7000-NEXT-RECEIVERS THRU 7090-NR-X.
050800
050900 6431-DETERMINE-IF-PREV-NEXT.
051000*------ FUNCTION KEY 1 IS FOR PREVIOUS DATA, F2 IS FOR MORE DATA.
051100*------ FIND OUT IF THOSE ARE VALID OR NOT.
           MOVE SPACES                   TO F1-INVALID-SW,
                                            F2-INVALID-SW.
051200     IF TABLE-START-SCREEN < 2
051300         MOVE "Y"                  TO F1-INVALID-SW.
051400     IF TABLE-END-SCREEN = TABLE-LIMIT OR
051500       TABLE-END-SCREEN > TABLE-LIMIT
051600         MOVE "Y"                  TO F2-INVALID-SW.
051700
051800     IF F1-INVALID-SW = "Y" AND F2-INVALID-SW = "Y"
051900         MOVE SPACES               TO   SCREEN-CONTINUATION-MSG
052000     ELSE
052100     IF F1-INVALID-SW = "Y"
052200         MOVE FRWD-MSG             TO   SCREEN-CONTINUATION-MSG
052300     ELSE
052400     IF F2-INVALID-SW = "Y"
052500         MOVE BKWD-MSG             TO   SCREEN-CONTINUATION-MSG
052600     ELSE
052700         MOVE BKWD-FRWD-MSG        TO   SCREEN-CONTINUATION-MSG.
053600
053700 6400-SHOWFORM-2.
           MOVE SRF-INDICATORS TO SAVE-SRF-INDICATORS.
           MOVE SCREEN-INQUIRY-BY-CODE TO DISPLAY-REC.
           PERFORM 998-WRITE-SCREEN THRU 998-READ-SCREEN.
           MOVE DISPLAY-REC    TO SCREEN-INQUIRY-BY-CODE.

           IF VIEW-LASTKEY = 4 OR 5 OR 8
      *        ***  INVALID FUNCTION KEY ENTERED  ***
               MOVE   9 TO LANG-SETNUM
               MOVE  10 TO LANG-MSGNUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE 99 TO  FIELD-NUMBER
034700         PERFORM  9-USER-ERROR  THRU  9-USER-ERROR-X
               MOVE SAVE-SRF-INDICATORS TO SRF-INDICATORS
034800         GO TO 6400-SHOWFORM-2.
031100
031200     IF VIEW-LASTKEY = 6
031100         IF HIST-SEARCH-FLG = "X"
031100             MOVE SPACES TO HIST-SEARCH-FLG
031100         ELSE
031100             MOVE "X"    TO HIST-SEARCH-FLG
031100         END-IF
031300         GO TO 6240-FIND-DPOITEM.
054500
031200     IF VIEW-LASTKEY = 3
031300         GO TO 6990-MAIN-X.
054500
054600     IF VIEW-LASTKEY = 7
054700         GO TO 6000-MAIN.
054800
055200     IF VIEW-LASTKEY = 1
               IF F1-INVALID-SW = "Y"
      *            ***  INVALID FUNCTION KEY ENTERED  ***
                   MOVE   9 TO LANG-SETNUM
                   MOVE  10 TO LANG-MSGNUM
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE 99 TO  FIELD-NUMBER
034700             PERFORM  9-USER-ERROR  THRU  9-USER-ERROR-X
                   MOVE SAVE-SRF-INDICATORS TO SRF-INDICATORS
034800             GO TO 6400-SHOWFORM-2
               ELSE
055300             PERFORM 7100-PREV-RECEIVERS THRU 7190-PR-X
055400             GO TO 6431-DETERMINE-IF-PREV-NEXT
055500     ELSE
055600     IF VIEW-LASTKEY = 2
               IF F2-INVALID-SW = "Y"
      *            ***  INVALID FUNCTION KEY ENTERED  ***
                   MOVE   9 TO LANG-SETNUM
                   MOVE  10 TO LANG-MSGNUM
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE 99 TO  FIELD-NUMBER
034700             PERFORM  9-USER-ERROR  THRU  9-USER-ERROR-X
                   MOVE SAVE-SRF-INDICATORS TO SRF-INDICATORS
034800             GO TO 6400-SHOWFORM-2
               ELSE
055700             PERFORM 7000-NEXT-RECEIVERS THRU 7090-NR-X
055800             GO TO 6431-DETERMINE-IF-PREV-NEXT.
055900
           PERFORM 6991-CHECK-INQ THRU 6991-EXIT
              VARYING INQSUB FROM 1 BY 1
              UNTIL INQSUB > 12.
           MOVE INQUIRY-SCREEN TO  VIEW-NFNAME.
           MOVE SAVE-SRF-INDICATORS TO SRF-INDICATORS.
034800     GO TO 6400-SHOWFORM-2.
067600
056000 6990-MAIN-X.
056100     EXIT.

       6991-CHECK-INQ.
           IF SCREEN-INQ (INQSUB) NOT = SPACES
               MOVE SPACES TO SCREEN-INQ (INQSUB)
               MOVE SCREEN-PO (INQSUB)   TO   PASS-PO-NUM
               MOVE SCREEN-RLS (INQSUB)  TO   PASS-PO-RLSE
               IF SCREEN-RCV (INQSUB) > SPACES
                   PERFORM 6992-RCV-INQ THRU 6992-EXIT
               ELSE
                   PERFORM 6993-PO-INQ THRU 6993-EXIT
               END-IF
           END-IF.
       6991-EXIT.
           EXIT.

       6992-RCV-INQ.
           MOVE PLT-NUMBER           TO   PASS-PLT-NUMBER.
           MOVE "R"                  TO   PASS-INQUIRY.
           MOVE 1                    TO   PASS-SAVE-LASTKEY.
           MOVE SCREEN-RCV (INQSUB)  TO   PASS-START-RECEIVER
                                          PASS-LAST-RECEIVER
                                          PASS-NO-LEFT-OFF-AT.
           MOVE 1                    TO   PASS-ITEM.
           IF HIST-SEARCH-FLG = "X"
               MOVE "Y"              TO   PASS-HISTORY-FLAG
           ELSE
               MOVE SPACES           TO   PASS-HISTORY-FLAG.
       6992-INQ.
           IF PASS-SAVE-LASTKEY = 1
               CALL "SINQRSI"    USING BASE, VIEW-COMAREA,
                             SUBROUTINE-PARMS, LANGUAGE-PARMS
           ELSE
             IF PASS-SAVE-LASTKEY = 2
               CALL "SINQFRT" USING BASE, VIEW-COMAREA
                              SUBROUTINE-PARMS, LANGUAGE-PARMS
             ELSE
               IF PASS-SAVE-LASTKEY = 4
                 CALL "SINQRSIC" USING BASE, VIEW-COMAREA
                                SUBROUTINE-PARMS, LANGUAGE-PARMS
               END-IF
             END-IF
           END-IF.
           IF PASS-SAVE-LASTKEY = 1 OR 2 OR 4
             GO TO 6992-INQ
           END-IF.
       6992-EXIT.
           EXIT.

       6993-PO-INQ.
           IF HIST-SEARCH-FLG NOT = "X"
               MOVE PLT-NUMBER TO ARG-PLT
               MOVE PASS-PO    TO ARG-PO
               CALL "TPOINQH" USING  BASE,
                                     SCREEN-PRINT-PARMS,
                                     PASS-SPOOL,
                                     VIEW-COMAREA,
                                     PO-ARGUMENT-VALUES,
                                     SAVE-POINQ-AREA,
                                     LANGUAGE-PARMS
               IF VIEW-LASTKEY EQUAL 2
                   CALL "TPOINQI" USING  BASE,
                                         SCREEN-PRINT-PARMS,
                                         PASS-SPOOL,
                                         VIEW-COMAREA,
                                         PO-ARGUMENT-VALUES,
                                         SAVE-POINQ-AREA,
                                         LANGUAGE-PARMS
                   IF VIEW-LASTKEY EQUAL 1
                       GO TO  6993-PO-INQ
                   END-IF
               END-IF
           ELSE
               MOVE PLT-NUMBER TO ARG-PLT
               MOVE PASS-HIST-PO  TO ARG-PO
               CALL "SPOINQHH" USING BASE,
                                     BASE-STHIST,
                                     SCREEN-PRINT-PARMS,
                                     PASS-SPOOL,
                                     VIEW-COMAREA,
                                     PO-ARGUMENT-VALUES,
                                     SAVE-POINQ-AREA,
                                     LANGUAGE-PARMS
               IF VIEW-LASTKEY EQUAL 2
                   CALL "SPOINQIH" USING BASE,
                                         BASE-STHIST,
                                         SCREEN-PRINT-PARMS,
                                         PASS-SPOOL,
                                         VIEW-COMAREA,
                                         PO-ARGUMENT-VALUES,
                                         SAVE-POINQ-AREA,
                                         LANGUAGE-PARMS
                   IF VIEW-LASTKEY EQUAL 1
                       GO TO 6993-PO-INQ
                   END-IF
               END-IF
           END-IF.
       6993-EXIT.
           EXIT.
056200
056300
056400 7000-NEXT-RECEIVERS.
056500*------ SCREEN SUB KEEPS TRACK OF POSITION ON SCREEN.
056600*------ WE START WITH ONE PAST THE LAST RECEIVER SHOWN ON THE
056700*------ LAST SCREEN.
056800     MOVE SPACES                   TO   SCREEN-RECEIVER-LINE-AREA.
056900     MOVE 0                        TO   SCREEN-SUB.
057000     MOVE TABLE-END-SCREEN         TO   TABLE-SUB.
057100     MOVE "Y"                      TO   FIRST-TIME-SW.

057200 7010-NEXT-RECEIVERS-LOOP.
057300     ADD 1                         TO   SCREEN-SUB.
057400     IF SCREEN-SUB > 12
057500         GO TO 7050-FINISH-NEXT.
057600
057700     ADD 1                         TO   TABLE-SUB.
057800     IF TABLE-SUB > TABLE-LIMIT
057900         SUBTRACT 1 FROM TABLE-SUB
               IF SCREEN-SUB NOT > 12
                  PERFORM UNTIL SCREEN-SUB > 12
                     MOVE B"1" TO IND(SCREEN-SUB)
                     ADD 1 TO SCREEN-SUB
                  END-PERFORM
058000         GO TO 7050-FINISH-NEXT.
058100
058200*------ WE SKIP A LINE BETWEEN DIFFERENT PO NUMBERS.
058300     IF FIRST-TIME-SW = "Y"
058400         MOVE "N"                  TO   FIRST-TIME-SW
058500         MOVE SAVE-PO-RCV-NO (TABLE-SUB) TO TEMP-PO-RCV-NO
058600     ELSE
058700     IF SAVE-PO (TABLE-SUB) NOT = TEMP-PO
               MOVE B"1" TO IND(SCREEN-SUB)
058800         ADD 1                     TO   SCREEN-SUB
058900         IF SCREEN-SUB > 12
059000             SUBTRACT 1 FROM TABLE-SUB
059100             GO TO 7050-FINISH-NEXT
059200         ELSE
059300             MOVE SAVE-PO-RCV-NO (TABLE-SUB) TO TEMP-PO-RCV-NO.
059400
059500*------ NOW GET THE SCREEN INFO
059600     PERFORM 7200-GET-RECEIVER-DATA THRU 7290-GRD-X.
059700     GO TO 7010-NEXT-RECEIVERS-LOOP.
059800
059900 7050-FINISH-NEXT.
060000*------ NOW SAVE THE BEGINNING AND ENDING POSITION IN THE RECEIVER
060100*------ TABLE FOR BEGIN AND END OF THE SCREEN.
060200     ADD 1, TABLE-END-SCREEN GIVING TABLE-START-SCREEN.
060300     MOVE TABLE-SUB TO TABLE-END-SCREEN.
060400
060500 7090-NR-X.
060600     EXIT.
060700
060800 7100-PREV-RECEIVERS.
060900*------ FOR GOING BACKWARDS, WE WILL START AT BOTTOM OF SCREEN
061000*------ AND MOVE TO THE TOP, STARTING WITH THE RECEIVER JUST
061100*------ BEFORE THE FIRST RECEIVER ON THE SCREEN.
061200     MOVE SPACES                   TO   SCREEN-RECEIVER-LINE-AREA.
061300     MOVE 13                       TO   SCREEN-SUB.
061400     MOVE TABLE-START-SCREEN       TO   TABLE-SUB.
061500     MOVE "Y"                      TO   FIRST-TIME-SW.
061600
061700 7110-PREV-RECEIVERS-LOOP.
061800     SUBTRACT 1 FROM SCREEN-SUB.
061900     IF SCREEN-SUB < 1
062000         GO TO 7150-FINISH-PREV.
062100
062200     SUBTRACT 1 FROM TABLE-SUB.
062300     IF TABLE-SUB < 1
               IF SCREEN-SUB > 0
                  PERFORM UNTIL SCREEN-SUB < 1
                      MOVE B"1" TO IND (SCREEN-SUB)
                      SUBTRACT 1 FROM SCREEN-SUB
                  END-PERFORM
062400         ADD 1                     TO   TABLE-SUB
062500         GO TO 7150-FINISH-PREV.
062600
062700*------ WE SKIP A LINE BETWEEN DIFFERENT PO NUMBERS.
062800     IF FIRST-TIME-SW = "Y"
062900         MOVE "N"                  TO   FIRST-TIME-SW
063000         MOVE SAVE-PO-RCV-NO (TABLE-SUB) TO TEMP-PO-RCV-NO
063100     ELSE
063200     IF SAVE-PO (TABLE-SUB) NOT = TEMP-PO
               MOVE B"1" TO IND (SCREEN-SUB)
063300         SUBTRACT 1                FROM SCREEN-SUB
063400         IF SCREEN-SUB < 1
063500             ADD 1 TO TABLE-SUB
063600             GO TO 7150-FINISH-PREV
063700         ELSE
063800             MOVE SAVE-PO-RCV-NO (TABLE-SUB) TO TEMP-PO-RCV-NO.
063900
064000     PERFORM 7200-GET-RECEIVER-DATA THRU 7290-GRD-X.
064100     GO TO 7110-PREV-RECEIVERS-LOOP.
064200
064300 7150-FINISH-PREV.
064400     SUBTRACT 1 FROM TABLE-START-SCREEN GIVING TABLE-END-SCREEN.
064500     MOVE TABLE-SUB                TO   TABLE-START-SCREEN.
064600
064700 7190-PR-X.
064800     EXIT.
064900
065000 7200-GET-RECEIVER-DATA.
064900     IF HIST-SEARCH-FLG = "X"
065100         MOVE SAVE-PO-RCV-NO (TABLE-SUB) TO   WSH-RECEIVER
               MOVE " "                        TO   WSH-PO-INDIC
065200         IF WSH-RS = "000"
065300             PERFORM 7300-GET-ACCUM-DATA THRU 7390-GAD-X
065400         ELSE
065500             PERFORM 7400-GET-RCVR-DATA THRU 7490-GRD-X
               END-IF
064900     ELSE
065100         MOVE SAVE-PO-RCV-NO (TABLE-SUB) TO   WS-RECEIVER
065200         IF WS-RS = "000"
065300             PERFORM 7300-GET-ACCUM-DATA THRU 7390-GAD-X
065400         ELSE
065500             PERFORM 7400-GET-RCVR-DATA THRU 7490-GRD-X
               END-IF
           END-IF.
065600 7290-GRD-X.
065700     EXIT.
065800
065900 7300-GET-ACCUM-DATA.
065800     IF HIST-SEARCH-FLG = "X"
               MOVE WSH-RECEIVER TO PORCVNO OF DPOITEMPH-REC-I
               START DPOITEMPH-I KEY = PORCVNO OF DPOITEMPH-REC-I
                   INVALID KEY MOVE FILE-STATUS TO FILE-STATUS
065800     ELSE
               MOVE WS-RECEIVER TO PORCVNO OF DPOITEMP-REC-I
               START DPOITEMP-I KEY = PORCVNO OF DPOITEMP-REC-I
                   INVALID KEY MOVE FILE-STATUS TO FILE-STATUS
065800     END-IF.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
                   NEXT SENTENCE
               ELSE
066300             MOVE "DBFIND ERR 7300-GAD" TO BU-DISPLAY-MSG
066400             PERFORM 2100-BLOWUP.
066500
066600 7310-GET-ACCUM-DATA-LOOP.
066500     IF HIST-SEARCH-FLG = "X"
               READ DPOITEMPH-I NEXT INTO BUF-DPOITEM-H
                   AT END MOVE FILE-STATUS TO FILE-STATUS
066500     ELSE
               READ DPOITEMP-I NEXT INTO BUF-DPOITEM
                   AT END MOVE FILE-STATUS TO FILE-STATUS
066500     END-IF.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
067000             GO TO 7390-GAD-X
               ELSE
067300             MOVE "DBGET ERR 7310-GADL" TO BU-DISPLAY-MSG
067400             PERFORM 2100-BLOWUP.
067500     IF HIST-SEARCH-FLG = "X"
               IF PORCVNO OF DPOITEMPH-REC-I NOT = WSH-RECEIVER
067000             GO TO 7390-GAD-X
067500         END-IF
067600         IF ITMH-NUMBER NOT = SAVE-ITEM-NO (TABLE-SUB)
067700             GO TO 7310-GET-ACCUM-DATA-LOOP
067500         END-IF
      *
067900         MOVE SPACES         TO  SCREEN-DATA (SCREEN-SUB)
068000         MOVE ITMH-PO-NO     TO  SCREEN-PO (SCREEN-SUB)
068100         MOVE "-"            TO  SCREEN-DASH1 (SCREEN-SUB)
068200         MOVE ITMH-PO-REL    TO  SCREEN-RLS (SCREEN-SUB)
068300*------ TO MAKE THE SCREEN EASIER TO READ, THE "-000" PART OF THE
068400*------ ACCUMULATOR ENTRIES ARE SPACED OUT.  THIS HELPS SET THE
068500*------ ACCUMULATOR APART FROM THE RECEIVERS ON THE SCREEN.
068600         MOVE SPACES         TO  SCREEN-DASH2 (SCREEN-SUB)
068700         MOVE SPACES         TO  SCREEN-RCV (SCREEN-SUB)
068800         MOVE ITMH-NUMBER    TO  SCREEN-ITEM (SCREEN-SUB)
               IF NOT A-KELLY-PLANT
068900           MOVE ITMH-QTY-UM    TO  SCREEN-UM (SCREEN-SUB)
069000           MOVE ITMH-QTY-ORD   TO  SCREEN-ORD-QTY (SCREEN-SUB)
069100           MOVE ITMH-QTY-DLVR  TO  SCREEN-DLVR-QTY (SCREEN-SUB)
069200           MOVE ITMH-QTY-STORED TO  SCREEN-STORED-QTY (SCREEN-SUB)
               ELSE
                 IF ITMH-QTY-ORD = ZERO OR ITMH-KELLY-PO-QTY = ZERO
                   MOVE 1 TO KELLY-CF
                 ELSE
                   DIVIDE ITMH-QTY-ORD BY ITMH-KELLY-PO-QTY
                     GIVING KELLY-CF ROUNDED
                 END-IF
                 MOVE ITMH-KELLY-PO-UM TO SCREEN-UM (SCREEN-SUB)
                 MOVE ITMH-KELLY-PO-QTY TO SCREEN-ORD-QTY (SCREEN-SUB)
                 DIVIDE ITMH-QTY-DLVR BY KELLY-CF
                   GIVING CHECK-QTY ROUNDED
                 MOVE CHECK-QTY TO SCREEN-DLVR-QTY (SCREEN-SUB)
                 DIVIDE ITMH-QTY-STORED BY KELLY-CF
                   GIVING CHECK-QTY ROUNDED
                 MOVE CHECK-QTY TO SCREEN-STORED-QTY (SCREEN-SUB)
               END-IF
      *---------SUBTRACT 19M OR 20M BEFORE REFORMATING DATE
               MOVE ITMH-DATE-RCVD TO TEMP-DATE
               IF TEMP-DATE NUMERIC
                 IF TEMP-YEAR > 70
                     COMPUTE DISPLAY-DATE = ITMH-DATE-RCVD - 19000000
                 ELSE
                     COMPUTE DISPLAY-DATE = ITMH-DATE-RCVD - 20000000
                 END-IF
069400           MOVE DISPLAY-DATE   TO  DATE-VALIDATE-IN
069500           MOVE 4              TO  DATE-MODE
069600           CALL "TDATECHK" USING DATE-CHECK-AREA
069700           MOVE DATE-SLASH-OUT TO  SCREEN-DLVR-DATE (SCREEN-SUB)
               ELSE
                 MOVE SPACES TO SCREEN-DLVR-DATE (SCREEN-SUB)
               END-IF
      *---------FIELD NOT BINARY, NO NEED TO SUBTRACT
069800         MOVE ITMH-DATE-STORED TO  DATE-VALIDATE-IN
069900         CALL "TDATECHK" USING DATE-CHECK-AREA
070000         MOVE DATE-SLASH-OUT TO  SCREEN-STORED-DATE (SCREEN-SUB)
067500     ELSE
               IF PORCVNO OF DPOITEMP-REC-I NOT = WS-RECEIVER
067000             GO TO 7390-GAD-X
067500         END-IF
067600         IF ITM-NUMBER NOT = SAVE-ITEM-NO (TABLE-SUB)
067700             GO TO 7310-GET-ACCUM-DATA-LOOP
067500         END-IF
      *
067900         MOVE SPACES      TO  SCREEN-DATA (SCREEN-SUB)
068000         MOVE ITM-PO-NO   TO  SCREEN-PO (SCREEN-SUB)
068100         MOVE "-"         TO  SCREEN-DASH1 (SCREEN-SUB)
068200         MOVE ITM-PO-REL  TO  SCREEN-RLS (SCREEN-SUB)
068300*------ TO MAKE THE SCREEN EASIER TO READ, THE "-000" PART OF THE
068400*------ ACCUMULATOR ENTRIES ARE SPACED OUT.  THIS HELPS SET THE
068500*------ ACCUMULATOR APART FROM THE RECEIVERS ON THE SCREEN.
068600         MOVE SPACES      TO  SCREEN-DASH2 (SCREEN-SUB)
068700         MOVE SPACES      TO  SCREEN-RCV (SCREEN-SUB)
068800         MOVE ITM-NUMBER  TO  SCREEN-ITEM (SCREEN-SUB)
               IF NOT A-KELLY-PLANT
068900           MOVE ITM-UM      TO  SCREEN-UM (SCREEN-SUB)
069000           MOVE ITM-QTY-ORD TO  SCREEN-ORD-QTY (SCREEN-SUB)
069100           MOVE ITM-QTY-DLVR TO  SCREEN-DLVR-QTY (SCREEN-SUB)
069200           MOVE ITM-QTY-STORED TO SCREEN-STORED-QTY (SCREEN-SUB)
               ELSE
                 IF ITM-QTY-ORD = ZERO OR ITM-KELLY-PO-QTY = ZERO
                   MOVE 1 TO KELLY-CF
                 ELSE
                   DIVIDE ITM-QTY-ORD BY ITM-KELLY-PO-QTY
                     GIVING KELLY-CF ROUNDED
                 END-IF
                 MOVE ITM-KELLY-PO-UM  TO SCREEN-UM (SCREEN-SUB)
                 MOVE ITM-KELLY-PO-QTY TO SCREEN-ORD-QTY (SCREEN-SUB)
                 DIVIDE ITM-QTY-DLVR BY KELLY-CF
                   GIVING CHECK-QTY ROUNDED
                 MOVE CHECK-QTY        TO SCREEN-DLVR-QTY (SCREEN-SUB)
                 DIVIDE ITM-QTY-STORED BY KELLY-CF
                   GIVING CHECK-QTY ROUNDED
                 MOVE CHECK-QTY        TO SCREEN-STORED-QTY (SCREEN-SUB)
               END-IF
069300
069400         MOVE ITM-DATE-RCVD  TO  DATE-VALIDATE-IN
069500         MOVE 4              TO  DATE-MODE
069600         CALL "TDATECHK" USING DATE-CHECK-AREA
069700         MOVE DATE-SLASH-OUT TO  SCREEN-DLVR-DATE (SCREEN-SUB)
069800         MOVE ITM-DATE-STORED TO  DATE-VALIDATE-IN
069900         CALL "TDATECHK" USING DATE-CHECK-AREA
070000         MOVE DATE-SLASH-OUT  TO  SCREEN-STORED-DATE (SCREEN-SUB)
067500     END-IF.
070100
070200     PERFORM 7500-SPACE-OUT-ZDEC.
070300
070400 7390-GAD-X.
070500     EXIT.
070600
070700
070800 7400-GET-RCVR-DATA.
070900*------ GET THE INFO FOR ONE RECEIVER IN THE TABLE
070700     IF HIST-SEARCH-FLG = "X"
               MOVE WSH-RECEIVER TO PORCVNO OF DRCVITEMPH-REC-I
               START DRCVITEMPH-I KEY = PORCVNO OF DRCVITEMPH-REC-I
                   INVALID KEY MOVE FILE-STATUS TO FILE-STATUS
070700     ELSE
               MOVE WS-RECEIVER TO PORCVNO OF DRCVITEMP-REC-I
               START DRCVITEMP-I KEY = PORCVNO OF DRCVITEMP-REC-I
