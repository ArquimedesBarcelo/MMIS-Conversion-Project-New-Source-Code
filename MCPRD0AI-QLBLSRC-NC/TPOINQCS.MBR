                   AT END MOVE FILE-STATUS TO FILE-STATUS
071500     ELSE
               READ DRCVITEMP-I NEXT INTO BUF-DRCVITEM
                   AT END MOVE FILE-STATUS TO FILE-STATUS
071500     END-IF.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   GO TO 7490-GRD-X
               ELSE
072300             MOVE "DBGET ERR 7310-GADL" TO BU-DISPLAY-MSG
072400             PERFORM 2100-BLOWUP.

           IF HIST-SEARCH-FLG = "X"
               IF PORCVNO OF DRCVITEMPH-REC-I NOT = WSH-RECEIVER
                   GO TO 7490-GRD-X
072500         END-IF
072600         IF RCVH-ITEM-NUMBER NOT = SAVE-ITEM-NO (TABLE-SUB)
072700             GO TO 7410-GET-RCVR-DATA-LOOP
072800         END-IF
073900*
072900         MOVE SPACES          TO  SCREEN-DATA (SCREEN-SUB)
073000         MOVE RCVH-PO-NO      TO  SCREEN-PO (SCREEN-SUB)
073100         MOVE "-"             TO  SCREEN-DASH1 (SCREEN-SUB)
073200         MOVE RCVH-PO-REL     TO  SCREEN-RLS (SCREEN-SUB)
