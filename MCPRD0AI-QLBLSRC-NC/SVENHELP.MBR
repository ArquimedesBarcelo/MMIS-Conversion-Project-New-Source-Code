000200 IDENTIFICATION DIVISION.
000300 PROGRAM-ID.     SVENHELP.

000400 INSTALLATION.   GOODYEAR TIRE & RUBBER CO.
000500 DATE-WRITTEN.   OCTOBER 4, 1993.

000600*************************************************************
000700* THIS IS A VENDOR INQUIRY PROGRAM FOR PURCHASING PERSONNEL *
000800* TO HELP FIND AND LOAD VENDOR INFORMATION                  *
000900*************************************************************


      *****************************************************************
      **          M O D I F I C A T I O N    H I S T O R Y
      *****************************************************************
      *C   4/11/94.   MARVIN MITCHELL  REQUEST #6490
      *C     COMMENTED EACH OF THE 'COPY' CODE STATEMENTS AT
      *C     THE END OF THIS PROGRAM, AND COPIED THE ACTUAL
      *C     COPYLIB MEMBERS' SOURCE CODE.
      *C
      *C   8/08/94.   MARVIN MITCHELL
      *C   CHANGED ALL REFERENCES FOR COPYCSIS/COPYMMIS TO COPYLIB.
      *C
      *C   5/03/95.   WILL MCINTYRE    REQUEST #95-007
      *C     ADDED CALL TO TALTVENK TO ALLOW USER TO ENTER AN
      *C     ALTERNATE KEY, AND HAVE THE LINKED VENDOR CODE
      *C     SUBSTITUTED IN THE ALTERNATE KEY'S PLACE.
      *C
      *C   5/02/96.   JIM COFFMAN      REQUEST 96-021
      *C     ADDED VENDOR-TABLE TO WORKING STORAGE AND CALL
      *C     TO SMKWINQ.
      *C
      *C   02/03/98     CA YODER    REQ #97-018
      *C     ADDED LOGIC TO DISPLAY STANDARD INSTRUCTIONS WITH A
      *C     VENDOR CODE.
      *C---------------------------------------------------------------
      *C MAR 10, 2005  D.RAUCH       DCR01    REQUEST# 2005-78515
      *C    DISPLAY FILE PROCESSING CHANGED FROM USING ZCSISINQ
      *C    NEW DISPLAY FILE ZSVENHELP CREATED - FORMATS COPIED
      *C    FROM ZCSISINQ.
      *C---------------------------------------------------------------
      *C MMM DD, CCYY  XXXNAMEXXX    XXX01    REQUEST# 2005-XXXXX
      *C    XXXXXXXXXXXXXXXXXX DESC XXXXXXXXXXXXXXXXXXXXXXXXXXXXX
      *****************************************************************
      *C
001000 ENVIRONMENT DIVISION.
001100 CONFIGURATION SECTION.
001200 COPY SPECIALN IN COPYLIB.
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT DVENDOR-VN-I
               ASSIGN TO DATABASE-MCFLCS0701
               ORGANIZATION IS INDEXED
                 ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                 WITH DUPLICATES
               FILE STATUS IS FILE-STATUS.

           SELECT MVALIDUM-UM-I
               ASSIGN TO DATABASE-MCFLCS0401
               ORGANIZATION IS INDEXED
                 ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
               FILE STATUS IS FILE-STATUS.

           SELECT DISPLAY-FILE
                  ASSIGN TO WORKSTATION-ZSVENHELP-SI
                  ORGANIZATION IS TRANSACTION
                  ACCESS IS SEQUENTIAL
                  FILE STATUS IS DISPLAY-STATUS
                  CONTROL-AREA IS WS-CONTROL.

001400 DATA DIVISION.
001500 FILE SECTION.
001700 FD  MVALIDUM-UM-I
001800     LABEL RECORDS ARE STANDARD.
001900 01  MVALIDUM-UM-REC-I.
002000     COPY DDS-MCRPCS0400  OF MCFLCS0401.
002100
002200 FD  DVENDOR-VN-I
002300     LABEL RECORDS ARE STANDARD.
002400 01  DVENDOR-VN-REC-I.
002500     COPY DDS-MCRPCS0700  OF MCFLCS0701.
002600
002700 FD  DISPLAY-FILE
002800     LABEL RECORDS ARE OMITTED.
002900 01  DISPLAY-REC                   PIC X(2000).
003100 WORKING-STORAGE SECTION.
003200
003300 77  SUB                           PIC S9     BINARY.
003400 77  HANDLE-BLOWUP-FLAG            PIC X      VALUE "Y".
       77  RET-CODE-TALTVENK             PIC X(02)  VALUE "00".
       77  BASE-TALTVENK                 PIC X(20).
       77  ALT-KEY-ARG                   PIC X(10).
       77  ALT-VEND-CODE                 PIC X(10).
       77  VSUB                          PIC 9(2)   VALUE 0 COMP-4.

003500 01  SAVE-TITLE                    PIC X(35)  VALUE SPACES.
003600 01  SAVE-INSTRUCTION              PIC X(75)  VALUE SPACES.
003700
003800*
003900* DATABASE STUFF
004000*
004100 COPY FILESTAT IN COPYLIB.
004200 01  DB-PARAMETERS.
004300     05  DSET-NAME                 PIC X(16)  VALUE SPACES.
004400     05  DSET-DVENDOR              PIC X(16)  VALUE "DVENDOR;".
004500     05  VEN-SEARCH                PIC X(10)  VALUE "VEN-CODE;"  .
004600     05  VEN-ARG                   PIC X(10)  VALUE SPACES.
004700     05  DSET-MVALIDUM             PIC X(16)  VALUE "MVALIDUM;"  .
004800     05  UM-ARG                    PIC X(2)   VALUE SPACES.
004900     05  ALL-ITEMS                 PIC X(2)   VALUE "@;".
005000
005100 COPY DBSTAT      IN COPYLIB.
005200 COPY DBMODES     OF COPYLIB.
005300 COPY MKWINQ      OF COPYLIB.
005400 COPY DVENDOR     OF COPYLIB.
005500 COPY MVALIDUM    OF COPYLIB.
005600
005700*
005800* SCREEN STUFF
005900*
006000 COPY IOFEEDBACK IN COPYLIB.
006100 COPY DISPDAT2   IN COPYLIB.
006200 COPY FUNCTDEF   IN COPYLIB.
006300
006400 01  DE-FIELDS-1.
           05 VDE-TITLE                  PIC X(35).
           05 VDE-INSTRUCTION            PIC X(75).
           05 VDE-VENDOR.
              10 VDE-VENDOR-1-7          PIC X(07).
              10 VDE-VENDOR-8-10         PIC X(03).
           05 VDE-NAME                   PIC X(44).
           05 VDE-ADDRESS-LINES     OCCURS 6 TIMES.
              10 VDE-ADDRESS             PIC X(44).
           05 VDE-CITY                   PIC X(24).
           05 VDE-STATE                  PIC X(2).
           05 VDE-POSTAL-CODE.
              10 VDE-ZIP                 PIC X(5).
              10 VDE-ZIP-9 REDEFINES VDE-ZIP PIC 9(5).
              10 FILLER                  PIC X(4).
           05 VDE-ZIP-PLACEMENT          PIC X.
           05 VDE-PROVINCE               PIC X(4).
           05 VDE-COUNTRY                PIC X(18).
           05 VDE-CC                     PIC X(2).
           05 VDE-CC-DESC                PIC X(12).
           05 VDE-CONTACT                PIC X(34).
           05 VDE-FAX                    PIC X(24).
           05 VDE-NOTE1                  PIC X(44).
           05 VDE-TELEX                  PIC X(10).
           05 VDE-NOTE2                  PIC X(44).
           05 VDE-PHONE                  PIC X(10).
           05 VDE-FOB                    PIC X(20).
           05 VDE-TERMS.
              10  VDE-TERMS-PCT          PIC X.
              10  VDE-TERMS-DUE-DATE     PIC X.
           05 VDE-MIN-ORDER              PIC X(4).
           05 VDE-INVLESS-IND            PIC X(1).
           05 VDE-EDI-VENDOR             PIC X(1).
           05 VDE-DOLLAR-MAX             PIC X(7).
           05 VDE-EDIFACT-ID             PIC X(1).
           05 VDE-GOODYEAR-CODE          PIC X(17).
           05 VDE-TRADING-ID             PIC X(16).
           05 VDE-STATUS-IND             PIC X.
           05 VDE-EXCODE-IND             PIC X.
           05 VDE-INSTRUCTIONS.
              10 VDE-STD-INST   OCCURS  4 TIMES.
                 15  VDE-STD-INSTR       PIC X(3).
                 15  VDE-BEFORE-AFTER    PIC X.
           05 DE-COMMAND-LINE-1          PIC X(79).
010700
010800 COPY HMSGBUF IN COPYLIB.
010900
011000*
011100* SUBPROGRAM STUFF
011200*
011300 COPY TBLOWUP OF COPYLIB.
011400 COPY CATREAD IN COPYLIB.
011500
011600 01  CUSTOM-FKEY-DEFINITIONS.
011700*
011800*              F1   F2   F3   F4   F5   F6   F7   F8
011900*
012000*------ FOR HP ONLY ------*
012100*    05 FILLER                     PIC X(40)
012200*       VALUE "I    I    I    I    I    I              ".
012300*------ FOR HP ONLY ------*
012400*------ FOR IBM ONLY ------*
012500     05 FILLER                     PIC X(40)
012600*              F1   F2   F3   F4   F5   F6   F7   F8
012700        VALUE "I    I         I    I    I         I    ".
012800*------ FOR IBM ONLY ------*
012900
013000 01  CUSTOM-FKEYS-TABLE REDEFINES CUSTOM-FKEY-DEFINITIONS.
013100     05 CUSTOM-FKEYS OCCURS 1 TIMES PIC X(40).
013200
013300 COPY TSHWRDFM IN COPYLIB.
013400
       01  VENDOR-TABLE.
           05  VENDOR-CODE-T OCCURS 16.
               10  VC-T                  PIC X(10).

013500 LINKAGE SECTION.
013600 01  BASE                          PIC X(10).
013700 COPY VCOMLINK OF COPYLIB.
013800 01  SPOOLER-NUMBER                PIC S9(2) BINARY.
013900 COPY LANGSUB  IN COPYLIB.
014000 01  VENCODE-HELP                  PIC X(10).
014100 PROCEDURE DIVISION USING BASE, VIEW-COMAREA,
014200                          SPOOLER-NUMBER, LANGUAGE-PARMS,
014300                          VENCODE-HELP.
014400
014500 MAIN-LINE-LOGIC.
014600
014700     PERFORM 1-INIT.
014800     PERFORM 80-CLEAR-FORM.
014900     MOVE CUSTOM-FKEYS(1) TO SRF-FKEY-AREA.
015000     PERFORM 9999-DO-SCREEN-1.
015100
015200     PERFORM UNTIL VIEW-LASTKEY EQUAL EXIT-PROGRAM
015300
015400       IF VIEW-LASTKEY EQUAL F7-KEY
015500
015600         PERFORM 80-CLEAR-FORM
015700
015800       ELSE
015900
016000         IF VDE-VENDOR EQUAL SPACES
016100
016200*
016300* T62: THIS FIELD IS REQUIRED
016400*
016500             MOVE 20 TO LANG-SETNUM
016600             MOVE 62 TO LANG-MSGNUM
016700             PERFORM 999-CATREAD
016800             MOVE 1 TO SRF-ERROR-FLD
016900
017000         ELSE
017100
017200           PERFORM 81-FIND-VENDOR-INFO
017300           IF SRF-ERROR-FLD EQUAL ZERO
017400             PERFORM 82-GET-VENDOR-INFO
017500           END-IF
017600
017700         END-IF
017800
017900       END-IF
018000
018100       MOVE CUSTOM-FKEYS(1) TO SRF-FKEY-AREA
018200       PERFORM 9999-DO-SCREEN-1
018300
018400     END-PERFORM.
018500
018600     PERFORM 9999-CLOSES.
           MOVE VDE-VENDOR TO VENCODE-HELP.
018700     GOBACK.
018800
018900***************************************************************
019000* PARAGRAPH : 1-INIT                                          *
019100* PURPOSE   : TO SETUP FUNCTION KEYS FOR DO-SCREEN PERFORMS   *
019200*             , GET FORM, TITLE AND INSTRUCTION.              *
019300***************************************************************
019400 1-INIT.
019500
019600     MOVE 0 TO SRF-KEYSET.
019700     PERFORM 9999-OPENS.
019800
019900*
020000* MOVE SPOOLER NUMBER OVER FOR DO-SCREEN CALL
020100* AND FLAG NO "BEHIND THE BACK PROCESSING"
020200*
020300     MOVE SPOOLER-NUMBER TO SRF-SPOOL-PRT-NO.
020400     MOVE "NNNN" TO SRF-RET-FLAGS.
           MOVE SPACES TO VENDOR-TABLE.
           MOVE 0      TO VSUB.
020500
020600*
020700* V E N D O R  I N Q U I R Y
020800*
020900     MOVE 22 TO LANG-SETNUM.
021000     MOVE 18 TO LANG-MSGNUM.
021100     PERFORM 999-CATREAD.
021200     MOVE MESSAGE-BUFFER TO SAVE-TITLE.
021300
021400*
021500* E5: ENTER THE VENDOR CODE AND PRESS ENTER
021600*
021700     MOVE 5 TO LANG-SETNUM.
021800     MOVE 5 TO LANG-MSGNUM.
021900     PERFORM 999-CATREAD.
022000     MOVE MESSAGE-BUFFER TO SAVE-INSTRUCTION.
022100
022200     MOVE "INQVEND" TO VIEW-NFNAME.
022300     PERFORM 9999-GETNEXTFORM.
022400
022500***************************************************************
022600* PARAGRAPH : 2100-BLOWUP                                     *
022700* PURPOSE   : TO BLOWUP THE PROGRAM.                          *
022800***************************************************************
022900 2100-BLOWUP.
023000     MOVE "SVENHELP"  TO BU-PGM-NAME.
023100     MOVE VIEW-NFNAME TO BU-DISPLAY-FLD (1).
023200     MOVE VEN-ARG     TO BU-DISPLAY-FLD (2).
023300     CALL "TBLOWUP" USING BASE, BU-PGM-NAME, STATUS-AREA,
023400           VIEW-COMAREA, DUMMY-KSAM-STAT, BU-DISPLAY-MSG,
023500           BU-DISPLAY-FLDS.
023600
023700***************************************************************
023800* PARAGRAPH : 80-CLEAR-FORM                                   *
023900* PURPOSE   : TO CLEAR THE FORM AND MESSAGE AREA.             *
024000***************************************************************
024100 80-CLEAR-FORM.
024200     MOVE SPACES TO DE-FIELDS-1,
                          VENDOR-TABLE.
           MOVE 0      TO VSUB.
024300     MOVE SAVE-TITLE TO VDE-TITLE.
024400     MOVE SAVE-INSTRUCTION TO VDE-INSTRUCTION.
024500     MOVE SPACES TO MESSAGE-BUFFER.
024600     PERFORM 9999-RESET-SCREEN.
024700
024800***************************************************************
024900* PARAGRAPH : 81-FIND-VENDOR-INFO                             *
025000* PURPOSE   : TO FIND VENDOR INFORMATION FOR SELECTED VENDOR. *
025100*             IF IT'S NOT FOUND THEN USE KSAM FILE            *
025200*             TO GIVE USER CHOICES OF VENDORS.                *
025300***************************************************************
025400 81-FIND-VENDOR-INFO.
025500
025600*
025700* CLEAR BUFFER AND MOVE VENDOR CODE TO SEARCH FOR INTO VEN-ARG
025800*
025900     MOVE VDE-VENDOR TO VEN-ARG.
026000     MOVE SPACES TO DE-FIELDS-1.
026100     MOVE VEN-ARG TO VDE-VENDOR.
026200     MOVE SAVE-TITLE TO VDE-TITLE.
026300     MOVE SAVE-INSTRUCTION TO VDE-INSTRUCTION.
026400
026500*
026600* SEARCH FOR VENDOR INFORMATION
026700*

      *-----  CALL ALT KEY SUB-PGM TO GET ALT KEY IF ONE EXISTS
           MOVE VEN-ARG TO ALT-KEY-ARG.
           CALL "TALTVENK" USING RET-CODE-TALTVENK,
                                 BASE-TALTVENK,
                                 STATUS-AREA,
                                 ALT-KEY-ARG,
                                 ALT-VEND-CODE.
           IF RET-CODE-TALTVENK NOT EQUAL "00"
              MOVE "TALTVENK ERROR 81-FVI" TO BU-DISPLAY-MSG
              PERFORM 2100-BLOWUP.
           MOVE ALT-VEND-CODE   TO VEN-ARG VDE-VENDOR.

026800     PERFORM 9999-CHAINHD-DVENDOR-VN-I.
026900     PERFORM 9999-GETNEXT-DVENDOR-VN-I.
027000     IF END-OF-CHAIN
027100
027200*
027300* NOT FOUND -- GIVE USER OPTIONS TO SELECT FROM LIST OF VENDORS
027400*
027500       MOVE SPACES TO MANUFACT-KEYWORD-INQUIRY
027600       MOVE "V" TO MKW-TYPE
027700       MOVE VEN-ARG TO MKW-PASS-AREA
027800       CALL "SMKWINQ" USING VIEW-COMAREA,
027900                            MANUFACT-KEYWORD-INQUIRY,
028000                            BASE, LANGUAGE-PARMS,
                                  VENDOR-TABLE
028100       MOVE "INQVEND" TO VIEW-NFNAME
028200       PERFORM 9999-GETNEXTFORM
028300       MOVE MKW-RETURN-AREA TO VDE-VENDOR, VEN-ARG,
028400           VENCODE-HELP
028500       IF MKW-MESSAGE-AREA NOT EQUAL SPACES
028600
028700*
028800* AN ERROR OCCURED ON THE LIST OF VENDORS
028900*
029000         MOVE MKW-MESSAGE-AREA TO MESSAGE-BUFFER
029100         MOVE 1 TO SRF-ERROR-FLD
029200
029300       ELSE
029400
029500         IF MKW-RETURN-STATUS EQUAL "S"
029600
029700*
029800* THE USER SELECTED A VENDOR -- CHECK TO SEE IF IT EXISTS
029900*
030000           PERFORM 9999-CHAINHD-DVENDOR-VN-I
030100           PERFORM 9999-GETNEXT-DVENDOR-VN-I
030200           IF NOT GOOD-CALL
030300
030400*
030500* V3: VENDOR CODE DOESN'T EXIST
030600*
030700             MOVE  22 TO LANG-SETNUM
030800             MOVE   3 TO LANG-MSGNUM
030900             PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
031000             MOVE 1 TO SRF-ERROR-FLD
031100
031200           END-IF
031300         END-IF
031400       END-IF
031500     END-IF.
031600
031700***************************************************************
031800* PARAGRAPH : 82-GET-VENDOR-INFO                              *
031900* PURPOSE   : TO GET THE VENDORS INFORMATION AND PUT IT IN THE*
032000*             SCREEN BUFFER.                                  *
032100***************************************************************
032200 82-GET-VENDOR-INFO.
032300
032400     MOVE 0 TO SUB.
032500     MOVE "N" TO VDE-EDI-VENDOR.
032600     PERFORM UNTIL END-OF-CHAIN
032700
032800       EVALUATE VEN-ITM-NO
032900         WHEN "00"
033000
033100           MOVE VEN-NAME TO VDE-NAME
033200
033300         WHEN "01" THRU "06"
033400
033500           ADD 1 TO SUB
033600           MOVE VEN-ADDRESS TO VDE-ADDRESS(SUB)
033700
033800         WHEN "07"
033900
034000           MOVE VEN-CITY TO VDE-CITY
034100           MOVE VEN-STATE-CODE TO VDE-STATE
034200           MOVE VEN-PROV-CODE TO VDE-PROVINCE
034300           MOVE VEN-ZIP TO VDE-POSTAL-CODE
034400           MOVE VEN-ZIP-BEFORE-CITY TO VDE-ZIP-PLACEMENT
034500
034600         WHEN "08"
034700
034800           MOVE VEN-COUNTRY TO VDE-COUNTRY
034900
035000         WHEN "09"
035100
035200           MOVE VEN-CONTACT TO VDE-CONTACT
035300           MOVE VEN-CONTACT-PHONE TO VDE-PHONE
035400
035500         WHEN "10"
035600
035700           MOVE VEN-FAX TO VDE-FAX
035800           MOVE VEN-MIN-ORDER TO VDE-MIN-ORDER
035900           MOVE VEN-INVLESS-IND TO VDE-INVLESS-IND
036000           MOVE VEN-TELEX TO VDE-TELEX
036100           MOVE VEN-CC TO VDE-CC, UM-ARG
036200           PERFORM 9999-GETKEY-MVALIDUM-UM-I
036300           IF NO-ENTRY
036400             MOVE "????????????" TO VDE-CC-DESC
036500           ELSE
036600             MOVE VALID-CURRENCY-DESC TO VDE-CC-DESC
036700           END-IF
036800
036900         WHEN "12"
037000
037100           MOVE VEN-12-RCD TO VDE-NOTE1
037200
037300         WHEN "13"
037400
037500           MOVE VEN-13-RCD TO VDE-NOTE2
037600
037700         WHEN "14"
037800
037900           MOVE "Y" TO VDE-EDI-VENDOR
038000           MOVE VEN-DOLLAR-MAX TO VDE-DOLLAR-MAX
038100           MOVE VEN-EDIFACT-ID TO VDE-EDIFACT-ID
038200           MOVE VEN-GOODYEAR-CODE TO VDE-GOODYEAR-CODE
038300           MOVE VEN-TRADING-ID TO VDE-TRADING-ID
038400           MOVE VEN-STATUS-IND TO VDE-STATUS-IND
038500           MOVE VEN-EXCODE-IND TO VDE-EXCODE-IND
038600
038700*        WHEN "15"
038800*          MOVE VEN-PARTNER-CTRY TO VDE-PARTNER-CTRY
038900*          MOVE VEN-ORIGIN-CTRY  TO VDE-ORIGIN-CTRY
039000*          MOVE VEN-VAT-NUMBER   TO VDE-VAT-NUMBER
039100
039200         WHEN "16"
039300           MOVE VEN-PO-FOB       TO VDE-FOB
039400           MOVE VEN-PO-TERMS     TO VDE-TERMS
039500
               WHEN "17"

                 MOVE VEN-17-RCD       TO VDE-INSTRUCTIONS

039600       END-EVALUATE
039700
039800       PERFORM 9999-GETNEXT-DVENDOR-VN-I
039900
040000     END-PERFORM.
040100
       9999-OPENS.
           OPEN INPUT MVALIDUM-UM-I.
           OPEN INPUT DVENDOR-VN-I.
           OPEN I-O DISPLAY-FILE.

       9999-CLOSES.
           CLOSE DISPLAY-FILE,
                 MVALIDUM-UM-I,
                 DVENDOR-VN-I.

       9999-GETNEXTFORM.
       9999-PUTWINDOW.
       9999-INITFORM.
       9999-SHOWFORM.
       9999-SETKEYLABEL.
       998-WRITE-SCREEN.
           IF SRF-CURSOR-FLD > ZERO
               MOVE B"1" TO IND (SRF-CURSOR-FLD)
               MOVE ZERO TO SRF-CURSOR-FLD.
           WRITE DISPLAY-REC  FORMAT IS VIEW-NFNAME
               INDIC ARE SRF-INDICATORS.
           MOVE ALL B"0" TO SRF-INDICATORS.

       998-READ-SCREEN.
           READ  DISPLAY-FILE FORMAT IS VIEW-NFNAME
               INDIC ARE SRF-INDICATORS.
           ACCEPT IOFEEDBACK FROM I-O-FEEDBACK-AREA.
           MOVE ALL B"0" TO SRF-INDICATORS.

      *------ A BAD STATUS MAY MEAN USER TURNED OFF TERMINAL.
      *------ IF SO, SIMULATE THE F3 KEY TO EXIT PROGRAM.
           IF DISPLAY-STATUS NOT = "00"
               MOVE EXIT-PROGRAM TO VIEW-LASTKEY
           ELSE
               MOVE FUNCTION-NUM TO VIEW-LASTKEY.
           IF SRF-KEYSET = 1 OR 3 OR 5 OR 7
               MOVE "I" TO SRF-FKEY (7).
           IF SRF-KEYSET > 0
               MOVE "I" TO SRF-FKEY (5).
           IF SRF-KEYSET = 1 OR 2 OR 5 OR 6 OR 7 OR 8
               MOVE "I" TO SRF-FKEY (4).
           IF SRF-KEYSET = 5 OR 6
               MOVE "I" TO SRF-FKEY (8), SRF-FKEY (6)
           ELSE
           IF SRF-KEYSET = 7 OR 8
               MOVE "I" TO SRF-FKEY (1), SRF-FKEY (2), SRF-FKEY (8).
           MOVE SPACES TO MESSAGE-BUFFER-1.
           IF VIEW-LASTKEY = ENTER-KEY
               IF SRF-ENTER-FLAG = "I"
      *            "E28: 'ENTER' NOT VALID HERE"
                   MOVE 5 TO LANG-SETNUM
                   MOVE 28 TO LANG-MSGNUM
                   MOVE 05028 TO CATREAD-MSG-NUMBER
                   MOVE 1 TO SRF-ERROR-FLD
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               ELSE
                   NEXT SENTENCE
           ELSE
           IF SRF-FKEY (VIEW-LASTKEY) = "I"
      *        "I10: INVALID FUNCTION KEY"
               MOVE 9 TO LANG-SETNUM
               MOVE 10 TO LANG-MSGNUM
               MOVE 09010 TO CATREAD-MSG-NUMBER
               MOVE 1 TO SRF-ERROR-FLD
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
           IF MESSAGE-BUFFER-1 = SPACES
               MOVE SPACES TO SRF-FKEY-AREA, SRF-ENTER-FLAG.
       9989-WS-X.
           EXIT.

       9999-RESET-SCREEN.
           MOVE B"1" TO IND(97).
           MOVE B"1" TO IND(96).

040400*COPY SCRNCL1  IN COPYLIB.
       9999-GETBUFFER-1.
           MOVE DISPLAY-REC TO DE-FIELDS-1.

       9999-PUTBUFFER-1.
           MOVE DE-FIELDS-1 TO DISPLAY-REC.

       9999-SETERROR-1.
           MOVE MESSAGE-BUFFER TO DE-COMMAND-LINE-1.
           IF SRF-MSG-AND-GO = "Y"
             MOVE "N" TO SRF-MSG-AND-GO
             MOVE B"1" TO IND (98)
             MOVE DE-FIELDS-1 TO DISPLAY-REC
             PERFORM 998-WRITE-SCREEN
             READ DISPLAY-FILE TERMINAL IS TERMINAL-ID
               INDIC ARE SRF-INDICATORS
               NO DATA CONTINUE
             END-READ
             MOVE B"0" TO IND(98)
             PERFORM 998-WRITE-SCREEN
             MOVE SPACES TO MESSAGE-BUFFER
           ELSE
             MOVE B"1" TO IND (SRF-ERROR-FLD).

       9999-DO-SCREEN-1.
           MOVE SRF-SAVE-COMMAND-LINE TO DE-COMMAND-LINE-1.
           IF SRF-ERROR-FLD > ZERO
               PERFORM 9999-SETERROR-1.
           PERFORM 9999-PUTBUFFER-1.
           PERFORM 998-WRITE-SCREEN THRU 9989-WS-X.
           PERFORM 9999-GETBUFFER-1.
           IF SRF-LAST-FORM NOT = VIEW-NFNAME
               MOVE VIEW-NFNAME       TO SRF-LAST-FORM
               MOVE DE-COMMAND-LINE-1 TO SRF-SAVE-COMMAND-LINE.
           IF MESSAGE-BUFFER-1 NOT = SPACES
               GO TO 9999-DO-SCREEN-1.
           IF SRF-ERROR-FLD > ZERO
               MOVE ZERO TO SRF-ERROR-FLD
               MOVE SRF-SAVE-COMMAND-LINE TO DE-COMMAND-LINE-1.
           IF VIEW-LASTKEY = 3
               NEXT SENTENCE
           ELSE
           IF VENDOR-TABLE = SPACES
               NEXT SENTENCE
           ELSE
           ADD 1 TO VSUB
           IF VSUB > 16
               MOVE 7      TO VIEW-LASTKEY
           ELSE
           IF VC-T (VSUB) = SPACES
               MOVE 7      TO VIEW-LASTKEY
           ELSE
           MOVE VC-T (VSUB) TO VDE-VENDOR.

       999-CATREAD.
           IF CATREAD-MSG-NUMBER = ZEROS
               MOVE LANG-SETNUM TO CATREAD-MSG-SET
               MOVE LANG-MSGNUM TO CATREAD-MSG-NUM.
           CALL "CCATREAD" USING CATREAD-PARMS.
           MOVE CATREAD-MSG-TEXT TO MESSAGE-BUFFER.
           IF MESSAGE-BUFFER-1  = SPACES
               MOVE "* ERROR ON THIS FIELD *" TO MESSAGE-BUFFER.
       999-CATREAD-EXIT.
           EXIT.

       9999-CHAINHD-DVENDOR-VN-I.
           MOVE 0 TO COND-WORD.
           MOVE VEN-ARG TO VENCDE OF DVENDOR-VN-REC-I.
           START DVENDOR-VN-I KEY = VENCDE OF DVENDOR-VN-REC-I
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF (FILE-STATUS NOT = "00") AND (FILE-STATUS-1 NOT = "2")
               MOVE 99 TO COND-WORD
               IF HANDLE-BLOWUP-FLAG = "Y"
                   MOVE "CHAINHD ERR 9999-CHAINHD-DVENDOR-VN-I"
                       TO BU-MSG-AREA
                   PERFORM 2100-BLOWUP.

       9999-GETNEXT-DVENDOR-VN-I.
           MOVE 0 TO COND-WORD.
           READ DVENDOR-VN-I NEXT INTO BUF-DVENDOR
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   MOVE 15 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD
                   IF HANDLE-BLOWUP-FLAG = "Y"
                       MOVE "GETNEXT ERR 9999-GETNEXT-DVENDOR-VN-I"
                           TO BU-MSG-AREA
                       PERFORM 2100-BLOWUP
                   END-IF
           ELSE
           IF VENCDE OF DVENDOR-VN-REC-I NOT = VEN-ARG
               MOVE 15 TO COND-WORD.

       9999-GETKEY-MVALIDUM-UM-I.
           MOVE 0 TO COND-WORD.
           MOVE UM-ARG TO VALIDUM OF MVALIDUM-UM-REC-I.
           READ MVALIDUM-UM-I INTO BUF-MVALIDUM
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS = "23"
               MOVE 17 TO COND-WORD
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD
               IF HANDLE-BLOWUP-FLAG = "Y"
                   MOVE "GETKEY ERR 9999-GETKEY-MVALIDUM-UM-I"
                       TO BU-MSG-AREA
                   PERFORM 2100-BLOWUP.

