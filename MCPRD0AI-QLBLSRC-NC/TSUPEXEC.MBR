       IDENTIFICATION DIVISION.
       PROGRAM-ID.             TSUPEXEC.
       AUTHOR.                 W. ROXBURY.
       INSTALLATION.           GOODYEAR TIRE & RUBBER CO.
      *
      *REMARKS.                THIS IS THE SUPERVISOR'S FUNCTIONS EXECUTIVE
      *                        SUBROUTINES CALLED:
      *                          TMSGEXEC
      *                          TSUPDATE
      *                          TINITWO
      *                          TSHOWQUE
      *                          TSCURRWO
      *                          TDISPEXS
      *                          TRELWO
      *                          ****.
       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.
       SOURCE-COMPUTER.        AS-400.
       OBJECT-COMPUTER.        AS-400.
       SPECIAL-NAMES.          I-O-FEEDBACK   IS I-O-FEEDBACK-AREA
                               REQUESTOR      IS WORK-STATION
                               SYSTEM-CONSOLE IS CONSOLE
                               LOCAL-DATA     IS LOCAL-DATA-AREA.
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT WO-LAST-NUM-USED
                  ASSIGN       TO DATABASE-MCFPMM0800
                  ORGANIZATION IS RELATIVE
                  ACCESS MODE  IS RANDOM
                  RELATIVE KEY IS ARG-NO
                  FILE STATUS  IS FILE-STAT.

           SELECT DISPLAY-FILE
                  ASSIGN       TO WORKSTATION-ZCORLESS-SI
                  ORGANIZATION IS TRANSACTION
                  ACCESS MODE  IS SEQUENTIAL
                  FILE STATUS  IS SCREEN-STATUS
                               MAJOR-MINOR
                  CONTROL-AREA IS SCREEN-CONTROL.

       DATA DIVISION.
       FILE SECTION.
       FD  WO-LAST-NUM-USED
           LABEL RECORDS       ARE STANDARD.
       01  WO-REC.
           COPY DD-ALL-FORMATS OF MCFPMM0800.

       FD  DISPLAY-FILE
           LABEL RECORDS       ARE OMITTED.
       01  DISPLAY-REC         PIC X(2000).

       WORKING-STORAGE SECTION.
       77  ARG-NO              PIC 9999 VALUE 1.

       01  FILE-STAT.
           05  FILE-STAT-1     PIC X  VALUE "0".
           05  FILE-STAT-2     PIC X  VALUE "0".

       01  PASSWORD-INFORMATION.
           05  NAME-OF-PROGRAM     PIC X(08) VALUE "TSUPEXEC".
           05  PROGRAM-TYPE        PIC X(02) VALUE "UP".
           05  PROGRAM-RELEASE     PIC X(12) VALUE " E0100010001".
           05  PROGRAM-DESCRIPTION.
               10  PROG-DESCA1 PIC X(30) VALUE
                   "THE SUPERVISOR FUNCTIONS PRIMA".
               10  PROG-DESCA2 PIC X(30) VALUE
                   "RY MENU PROGRAM.  ALLOWS ALL  ".
               10  PROG-DESCB1 PIC X(30) VALUE
                   "NECESSARY FUNCTIONS TO BE DRIV".
               10  PROG-DESCB2 PIC X(30) VALUE
                   "EN FROM FUNCTION KEYS.        ".
               10  PROG-FUNC   PIC X(30) VALUE SPACES.
           05  PASSWORD-FLAG       PIC X.

       01  ERROR-SWITCH.
           05  ERR-SW                          PIC S9(4) COMP-4.

       01  PERS-DATA.
           05  PER-CC              PIC XXXX.
           05  PER-ZONE            PIC XXXX.
           05  PER-SKILL           PIC XX.

       01  CNUM-BUFFER.
           05  CNUM-BUF            PIC X(04).
           05  CNAM-BUF            PIC X(16).

       01  DB-ERROR.
           05  DB-FUNC   PIC X(10) VALUE SPACES.
           05  DB-FILE   PIC X(18) VALUE SPACES.
           05  FILLER    PIC X(20) VALUE "ERROR - FILE-STAT = ".
           05  CON-WORD  PIC XX.

           COPY SCREENIO       IN COPYLIB.

           COPY JCWAREA        IN COPYLIB.

       01  DBPARAMETERS.
           COPY DBPARMS        IN COPYLIB.

           COPY VCOMLINK       IN COPYLIB.

       01  LAST-WO-USED-DATA.
           COPY MLASTWO        IN COPYLIB.

       01  WO-TRACK-DATA.
           COPY DWOTRACK       IN COPYLIB.

       01  WHO-VARIABLES.
           COPY WHOPARMS       IN COPYLIB.

       PROCEDURE DIVISION.
       BEGIN.
           MOVE SPACES         TO CNUM-BUFFER PERS-DATA.
           MOVE SPACES         TO WO-TRACK-DATA.
           MOVE SPACES         TO LAST-WO-USED-DATA.
           MOVE 1              TO DATE-FLAG-SW.
           OPEN I-O            DISPLAY-FILE.

           OPEN INPUT          WO-LAST-NUM-USED.
           READ  WO-LAST-NUM-USED INTO LAST-WO-USED-DATA
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = ZEROS
               DISPLAY "UNABLE TO GET LAST-WO-USED DATA."
                       "    FILE-STATUS = " FILE-STAT
               CLOSE           WO-LAST-NUM-USED
               GO TO END-OF-JOB.

           MOVE DATE-FLAG-SW   TO DATE-FLAG.
           CLOSE               WO-LAST-NUM-USED.

           CALL "WHO" USING MOD CAP LATTR USERNAME GRPNAME
                            ACCTNAME HOMEGRP TERMNUM.
           MOVE USERNAME       TO USER-NAME.
           MOVE TERMNUM        TO TNUM.
           MOVE TNUM           TO USER-TERM.

           CALL "TPWORD" USING PASSWORD-INFORMATION.
           IF PASSWORD-FLAG = "N"
               GO TO END-OF-JOB.

      **************************************
      **   SETJCW  JCW-MLOCK-262
      **************************************
           MOVE 262            TO SETJCW-STARTING-POS.
           MOVE " "            TO SETJCW-VALUE.
           IF A-SWITCH = "O"
               MOVE "1"        TO SETJCW-VALUE.
           MOVE 1              TO SETJCW-LENGTH.

           CALL "SETJCW" USING SETJCW-VALUE
                               SETJCW-STARTING-POS
                               SETJCW-LENGTH
                               SETJCW-STATUS.

      **************************************
      **   SETJCW  JCW-ASBSTS-306
      **************************************
           MOVE 306            TO SETJCW-STARTING-POS.
           MOVE " "            TO SETJCW-VALUE.
           IF I-SWITCH = "O"
               MOVE "1"        TO SETJCW-VALUE.
           MOVE 1              TO SETJCW-LENGTH.

           CALL "SETJCW" USING SETJCW-VALUE
                               SETJCW-STARTING-POS
                               SETJCW-LENGTH
                               SETJCW-STATUS.

       6-MAIN.
           MOVE "SUPEXECNEW"   TO SCREEN-NAME.
           MOVE "00"           TO SCREEN-STATUS.

           WRITE DISPLAY-REC  FORMAT IS SCREEN-NAME
               INDIC ARE SCREEN-INDICATORS.
           IF SCREEN-STATUS NOT = "00"
               DISPLAY "SCREEN WRITE ERROR.  SCREEN-STATUS IS "
                        SCREEN-STATUS
               GO TO END-OF-JOB.

           READ  DISPLAY-FILE FORMAT IS SCREEN-NAME
               INDIC ARE SCREEN-INDICATORS.
           IF SCREEN-STATUS NOT = "00"
               DISPLAY "SCREEN READ ERROR.  SCREEN-STATUS IS "
                        SCREEN-STATUS
               GO TO END-OF-JOB.

           MOVE ALL B"0"       TO SCREEN-INDICATORS.

           IF KEY-HIT = 3
               GO TO END-OF-JOB
           ELSE
           IF KEY-HIT = 1
               CALL "TMSGEXEC" USING DBPARAMETERS
                                     CNUM-BUFFER
                                     PERS-DATA
               GO TO 6-MAIN
           ELSE
           IF KEY-HIT = 2
               CALL "TSUPDATE" USING DBPARAMETERS
                                     WO-TRACK-DATA
                                     LAST-WO-USED-DATA
               GO TO 6-MAIN
           ELSE
           IF KEY-HIT = 8
               CALL "TINITWO" USING DBPARAMETERS
                                    WO-TRACK-DATA
               GO TO 6-MAIN
           ELSE
           IF KEY-HIT = 4
               CALL "CLSHOWQUE" USING DBPARAMETERS
               GO TO 6-MAIN
           ELSE
           IF KEY-HIT = 5
               GO TO INQUIRY-FUNCTION
           ELSE
           IF KEY-HIT = 6
               CALL "TDISPEXS" USING DBPARAMETERS
                                     LAST-WO-USED-DATA
                                     ERROR-SWITCH
                                     VIEW-COMAREA
               GO TO 6-MAIN
           ELSE
           IF KEY-HIT = 7
               CALL "TRELWO" USING DBPARAMETERS
               GO TO 6-MAIN
           ELSE
               GO TO 6-MAIN.

       INQUIRY-FUNCTION.
           MOVE "VCWIPMNU"     TO SCREEN-NAME.
           MOVE SPACES         TO DISPLAY-REC.
           MOVE "00"           TO SCREEN-STATUS.

           WRITE DISPLAY-REC   FORMAT IS SCREEN-NAME
               INDIC ARE SCREEN-INDICATORS.
           IF SCREEN-STATUS NOT = "00"
               DISPLAY "SCREEN WRITE ERROR.  SCREEN-STATUS IS "
                        SCREEN-STATUS
               GO TO END-OF-JOB.

           READ  DISPLAY-FILE  FORMAT IS SCREEN-NAME
               INDIC ARE SCREEN-INDICATORS
           IF SCREEN-STATUS NOT = "00"
               DISPLAY "SCREEN READ ERROR.  SCREEN-STATUS IS "
                        SCREEN-STATUS
               GO TO END-OF-JOB.

           MOVE ALL B"0"       TO SCREEN-INDICATORS.

           IF KEY-HIT = 3 OR 8
               GO TO 6-MAIN.

           IF KEY-HIT = 1
               MOVE " "        TO RETURN-BYTE
               CALL "CLSCURRWO" USING DBPARAMETERS
               GO TO INQUIRY-FUNCTION
           ELSE
           IF KEY-HIT = 2
               CALL "SWOIPINQ" USING DBPARAMETERS
               GO TO INQUIRY-FUNCTION
           ELSE
               GO TO INQUIRY-FUNCTION.

       END-OF-JOB.
           CLOSE               DISPLAY-FILE.
           GOBACK.

