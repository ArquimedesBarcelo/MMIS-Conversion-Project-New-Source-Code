       IDENTIFICATION DIVISION.
       PROGRAM-ID.             TQUPDATE.
       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.
       SOURCE-COMPUTER.        IBM-AS400.
       OBJECT-COMPUTER.        IBM-AS400.

       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT WO-OPEN-QUEUE
                  ASSIGN       TO DATABASE-MCFLMM1902
                  ORGANIZATION IS INDEXED
                  ACCESS MODE  IS DYNAMIC
                  RECORD KEY   IS EXTERNALLY-DESCRIBED-KEY
                               WITH DUPLICATES
                  FILE STATUS  IS FILE-STAT.

           SELECT EQP-HOT-CODE
                  ASSIGN       TO DATABASE-MCFLMM2002
                  ORGANIZATION IS INDEXED
                  ACCESS MODE  IS DYNAMIC
                  RECORD KEY   IS EXTERNALLY-DESCRIBED-KEY
                               WITH DUPLICATES
                  FILE STATUS  IS FILE-STAT.

           SELECT CURRENT-LABOR
                  ASSIGN       TO DATABASE-MCFLMM1602
                  ORGANIZATION IS INDEXED
                  ACCESS MODE  IS DYNAMIC
                  RECORD KEY   IS EXTERNALLY-DESCRIBED-KEY
                               WITH DUPLICATES
                  FILE STATUS  IS FILE-STAT.

           SELECT WO-CRAFTS-REQD
                  ASSIGN       TO DATABASE-MCFLMM0601
                  ORGANIZATION IS INDEXED
                  ACCESS MODE  IS DYNAMIC
                  RECORD KEY   IS EXTERNALLY-DESCRIBED-KEY
                  FILE STATUS  IS FILE-STAT.

       DATA DIVISION.
       FILE SECTION.
       FD  WO-OPEN-QUEUE
           LABEL RECORDS       ARE STANDARD.
       01  WOQ-REC.
           COPY DDS-ALL-FORMATS OF MCFLMM1902.

       FD  EQP-HOT-CODE
           LABEL RECORDS       ARE STANDARD.
       01  HC-REC.
           COPY DDS-ALL-FORMATS OF MCFLMM2002.

       FD  CURRENT-LABOR
           LABEL RECORDS       ARE STANDARD.
       01  LC-REC.
           COPY DDS-ALL-FORMATS OF MCFLMM1602.

       FD  WO-CRAFTS-REQD
           LABEL RECORDS       ARE STANDARD.
       01  WO-CRAFTS-REQD-REC.
           COPY DDS-ALL-FORMATS OF MCFLMM0601.

       WORKING-STORAGE SECTION.
       77  FILE-STAT           PIC XX.
       77  WONUM-KEY           PIC X(10).
       77  CHG-CC-NUM          PIC XXXX.
       77  CHG-Q-FACT          PIC 99.
       77  CHG-Q-RES           PIC XX.
       77  CHG-Q-CWL           PIC XX.
       77  CHG-Q-CHK           PIC XX.
       77  HOT-CODE-SW         PIC 9       VALUE 0.
       77  CL-SW               PIC 9       VALUE 0.
       77  TRUE-PRTY           PIC XX.

       01  CURR-DATE-CN.
           05  CURR-CT-99      PIC 99.
           05  CURR-DATE-99.
               10  CURR-YR-99  PIC 99.
               10  CURR-MO-99  PIC 99.
               10  CURR-DY-99  PIC 99.

       01  CUR-TIME.
           05  CURR-TIME.
               10  CURR-HR     PIC XX.
               10  CURR-MN     PIC XX.
           05  FILLER          PIC XXXX.

       01  STRT-DATE-99        PIC 9(08).
       01  END-DATE-99         PIC 9(08).
       01  STRT-TIME-99        PIC 9(04).
       01  END-TIME-99         PIC 9(04).

       01  CRAFT-DATA.
           COPY MWOCRAFT       IN COPYLIB.

       01  HOT-CODE-DATA.
           COPY DHOTCODE       IN COPYLIB.

       01  LABOR-CURR-DATA.
           COPY DCURRLBR       IN COPYLIB.

       LINKAGE SECTION.
       01  DBPARAMETERS.
           COPY DBPARMS        IN COPYLIB.

       01  WO-QUEUE-DATA.
           COPY DWOOPENQ       IN COPYLIB.

       01  ACD-SW              PIC X.
       01  ERROR-MESSAGE.
           05  ERROR-TEXT      PIC X(70).
           05  ERROR-FILL      PIC X(06).
           05  ERROR-CODE      REDEFINES ERROR-FILL
                               PIC 9(06).

       PROCEDURE DIVISION USING DBPARAMETERS
                                WO-QUEUE-DATA
                                ACD-SW
                                ERROR-MESSAGE.

       START-PROCESSING.
           ACCEPT CURR-DATE-99 FROM DATE.
           MOVE 20             TO CURR-CT-99.
           IF CURR-YR-99 > 70
               MOVE 19         TO CURR-CT-99.
           ACCEPT CUR-TIME     FROM TIME.
           MOVE Q-WO-NUM       TO WONUM-KEY.
           MOVE Q-PRTY         TO TRUE-PRTY.
           MOVE "1 "           TO Q-PRTY.
           MOVE 0              TO CL-SW HOT-CODE-SW.
           MOVE SPACES         TO ERROR-MESSAGE.

           IF ACD-SW = "U"
               MOVE "C"        TO ACD-SW.

           IF ACD-SW = "A"
               GO TO ADD-FUNCTION
           ELSE
           IF ACD-SW = "C"
               GO TO CHG-FUNCTION
           ELSE
           IF ACD-SW = "D"
               GO TO DEL-FUNCTION
           ELSE
               MOVE "QUEUE-SW NOT SET - QUEUE NOT UPDATED"
                               TO ERROR-TEXT.
           GOBACK.

       ADD-FUNCTION.
           OPEN I-O            WO-OPEN-QUEUE.
           OPEN INPUT          EQP-HOT-CODE.
           OPEN INPUT          CURRENT-LABOR.
           OPEN INPUT          WO-CRAFTS-REQD.

           MOVE Q-WO-NUM       TO WONUM OF WO-OPEN-QUEUE.
           READ WO-OPEN-QUEUE  INTO WO-QUEUE-DATA
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT = "00"
               GO TO CLOSE-ADD-FILES.

           IF Q-SKILL-1 = SPACES
               GO TO CLOSE-ADD-FILES.

           MOVE Q-SKILL-1      TO CRAFTREQD OF WO-CRAFTS-REQD.
           READ WO-CRAFTS-REQD INTO CRAFT-DATA
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = ZEROS
               GO TO CLOSE-ADD-FILES.

           IF CRAFT-FLAG = "4"
               GO TO CLOSE-ADD-FILES.

           IF Q-SKILL-2 = SPACES
               NEXT SENTENCE
           ELSE
           MOVE Q-SKILL-2      TO CRAFTREQD OF WO-CRAFTS-REQD
           READ WO-CRAFTS-REQD INTO CRAFT-DATA
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT
           END-READ
           IF FILE-STAT NOT = ZEROS
               GO TO CLOSE-ADD-FILES
           ELSE
           IF CRAFT-FLAG = "4"
               GO TO CLOSE-ADD-FILES.

           IF Q-SKILL-3 = SPACES
               NEXT SENTENCE
           ELSE
           MOVE Q-SKILL-3      TO CRAFTREQD OF WO-CRAFTS-REQD
           READ WO-CRAFTS-REQD INTO CRAFT-DATA
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT
           END-READ
           IF FILE-STAT NOT = ZEROS
               GO TO CLOSE-ADD-FILES
           ELSE
           IF CRAFT-FLAG = "4"
               GO TO CLOSE-ADD-FILES.

           PERFORM CHECK-CURRENT-LABOR-FILE THRU CCLF-EXIT.

           IF CL-SW = 1
               MOVE "LABOR"    TO ERROR-MESSAGE
               GO TO CLOSE-ADD-FILES.

           PERFORM CHECK-HOT-CODE-FILE THRU CHCF-EXIT.

           IF HOT-CODE-SW = 1
               IF TRUE-PRTY = "1 "
                   MOVE 80     TO QUEUE-FACTOR
               ELSE
               IF TRUE-PRTY = "2 "
                   MOVE 79     TO QUEUE-FACTOR.

           WRITE WOQ-REC       FROM WO-QUEUE-DATA
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
               MOVE FILE-STAT  TO ERROR-FILL
               MOVE "WRITE ERROR - RECORD NOT ADDED TO QUEUE"
                               TO ERROR-TEXT.

       CLOSE-ADD-FILES.
           CLOSE               EQP-HOT-CODE.
           CLOSE               CURRENT-LABOR.
           CLOSE               WO-CRAFTS-REQD.
           GO TO END-OF-JOB.

       CHG-FUNCTION.
           OPEN I-O            WO-OPEN-QUEUE.
           MOVE Q-CC-NUM       TO CHG-CC-NUM.
           MOVE QUEUE-FACTOR   TO CHG-Q-FACT.
           MOVE Q-RESERVE      TO CHG-Q-RES.
           MOVE Q-CW-LINK      TO CHG-Q-CWL.
           MOVE Q-CHKOUT       TO CHG-Q-CHK.

           MOVE Q-WO-NUM       TO WONUM OF WO-OPEN-QUEUE.
           READ WO-OPEN-QUEUE  INTO WO-QUEUE-DATA
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
               MOVE FILE-STAT  TO ERROR-FILL
               MOVE "READ ERROR - RECORD NOT CHANGED IN QUEUE"
                               TO ERROR-TEXT
               GO TO END-OF-JOB.

           MOVE CHG-CC-NUM     TO Q-CC-NUM.
           MOVE CHG-Q-FACT     TO QUEUE-FACTOR.
           MOVE CHG-Q-RES      TO Q-RESERVE.
           MOVE CHG-Q-CWL      TO Q-CW-LINK.
           MOVE CHG-Q-CHK      TO Q-CHKOUT.

           REWRITE WOQ-REC FROM WO-QUEUE-DATA
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
               MOVE FILE-STAT  TO ERROR-FILL
               MOVE "REWRITE ERROR - RECORD NOT CHANGED IN QUEUE"
                               TO ERROR-TEXT
               GO TO END-OF-JOB.

           GO TO END-OF-JOB.

       DEL-FUNCTION.
           OPEN I-O            WO-OPEN-QUEUE.
           MOVE Q-WO-NUM       TO WONUM OF WO-OPEN-QUEUE.
           READ WO-OPEN-QUEUE  INTO WO-QUEUE-DATA
               INVALID KEY     GO TO END-OF-JOB.
           IF FILE-STAT NOT = "00"
               MOVE FILE-STAT  TO ERROR-FILL
               MOVE "READ ERROR - RECORD NOT DELETED IN QUEUE"
                               TO ERROR-TEXT
               GO TO END-OF-JOB.

           DELETE WO-OPEN-QUEUE
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
               MOVE FILE-STAT  TO ERROR-FILL
               MOVE "DELETE ERROR - RECORD NOT DELETED IN QUEUE"
                               TO ERROR-TEXT
               GO TO END-OF-JOB.

       END-OF-JOB.
           MOVE HIGH-VALUES    TO WONUM OF WO-OPEN-QUEUE.
           START WO-OPEN-QUEUE KEY = WONUM OF WO-OPEN-QUEUE
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           CLOSE               WO-OPEN-QUEUE.
           GOBACK.

       CHECK-HOT-CODE-FILE.
           MOVE Q-EQUIP-NUM    TO EQPNUM OF EQP-HOT-CODE.
           READ EQP-HOT-CODE   INTO HOT-CODE-DATA
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
               GO TO CHCF-EXIT.

           MOVE HC-STRT-DATE-CN TO STRT-DATE-99.
           MOVE HC-END-DATE-CN  TO END-DATE-99.

           IF CURR-DATE-CN > STRT-DATE-99 AND
              CURR-DATE-CN < END-DATE-99
               MOVE 1          TO HOT-CODE-SW
               GO TO CHCF-EXIT.

           MOVE HC-STRT-TIME   TO STRT-TIME-99.
           MOVE HC-END-TIME    TO END-TIME-99.
           IF CURR-DATE-CN = STRT-DATE-99 AND
              CURR-DATE-CN = END-DATE-99
               IF CURR-TIME > STRT-TIME-99 AND
                  CURR-TIME < END-TIME-99
                       MOVE 1  TO HOT-CODE-SW
                       GO TO CHCF-EXIT.

           IF CURR-DATE-CN = STRT-DATE-99
               IF CURR-TIME > STRT-TIME-99
                   MOVE 1      TO HOT-CODE-SW
                   GO TO CHCF-EXIT.

           IF CURR-DATE-CN = END-DATE-99
               IF CURR-TIME < END-TIME-99
                   MOVE 1      TO HOT-CODE-SW
                   GO TO CHCF-EXIT.

       CHCF-EXIT.              EXIT.

       CHECK-CURRENT-LABOR-FILE.
           MOVE Q-WO-NUM       TO WONUM OF CURRENT-LABOR.

           START CURRENT-LABOR KEY = EXTERNALLY-DESCRIBED-KEY
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
               GO TO CCLF-EXIT.

           READ CURRENT-LABOR INTO LABOR-CURR-DATA
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
               GO TO CCLF-EXIT.

           IF LCS-WO-NUM  NOT = WONUM-KEY
               GO TO CCLF-EXIT.

           MOVE 1              TO CL-SW.

       CCLF-EXIT.              EXIT.

