089900
       9999-DB-CALLS SECTION.
       COPY OVRPFCAL IN COPYLIB.

       9930-LOCK.
       9940-UNLOCK.
       9970-STARTSPOOL.
           MOVE "*YES"    TO OVRPRTF-SHARED.
           MOVE SPOOL-PRT TO OVRPRTF-TOFILE-NUM.
           PERFORM 996-OVERRIDE-PRINT-FILE.

       9971-STOPSPOOL.
            MOVE "DLTOVR FILE(MCPRT)" TO COMMAND.
            CALL "QCMDEXC" USING COMMAND-WORK, COMMAND-LEN.

       9999-DBGET7-MSTORERM-CD-I.
           MOVE 0 TO COND-WORD.
           MOVE CODE-ARG TO CORPCDE OF MSTORERM-CD-REC-I.
           READ MSTORERM-CD-I INTO BUF-MSTORERM
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS = "23"
               MOVE 17 TO COND-WORD
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE "DBGET7 ERR 9999-DBGET7-MSTORERM-CD-I"
                   TO BU-MSG-AREA
               MOVE 99 TO COND-WORD
               PERFORM 2100-BLOWUP.

       9999-DBGET2-MSTORERM-CD-I.
           MOVE 0 TO COND-WORD.
           READ MSTORERM-CD-I NEXT INTO BUF-MSTORERM
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS-1 = "1" OR FILE-STATUS = "46"
               MOVE 11 TO COND-WORD
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE "DBGET2 ERR 9999-DBGET2-MSTORERM-CD-I"
                   TO BU-MSG-AREA
               MOVE 99 TO COND-WORD
               PERFORM 2100-BLOWUP.

       9999-INIT-MSTORERM-CD-I.
           MOVE SPACES TO CORPCDE OF MSTORERM-CD-REC-I.
           START MSTORERM-CD-I KEY >= CORPCDE OF MSTORERM-CD-REC-I
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.

       9999-DBGET2-USAGEFIL-CD-I.
           MOVE 0 TO COND-WORD.
           READ USAGEFIL-CD-I NEXT INTO BUF-USAGEFIL
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS-1 = "1" OR FILE-STATUS = "46"
               MOVE 11 TO COND-WORD
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE "DBGET2 ERR 9999-DBGET2-USAGEFIL-CD-I"
                   TO BU-MSG-AREA
               MOVE 99 TO COND-WORD
               PERFORM 2100-BLOWUP.

       9999-INIT-USAGEFIL-CD-I.
           MOVE SPACES TO CORPCDE OF USAGEFIL-CD-REC-I.
           START USAGEFIL-CD-I KEY >= CORPCDE OF USAGEFIL-CD-REC-I
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.

       9999-START-USAGEFIL-CD-I.
           MOVE KEY-VALUE TO CORPCDE OF USAGEFIL-CD-REC-I.
           START USAGEFIL-CD-I KEY >= CORPCDE OF USAGEFIL-CD-REC-I
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS = "23"
               MOVE 17 TO COND-WORD
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE "START ERR 9999-START-USAGEFIL-CD-I"
                 TO BU-MSG-AREA
               MOVE 99 TO COND-WORD
               PERFORM 2100-BLOWUP.

       9999-DBFIND-DDESC-CD-I.
           MOVE 0 TO COND-WORD.
           MOVE CODE-ARG TO CORPCDE OF DDESC-CD-REC-I.
           START DDESC-CD-I KEY = CORPCDE OF DDESC-CD-REC-I
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF (FILE-STATUS NOT = "00") AND (FILE-STATUS-1 NOT = "2")
               MOVE "DBFIND ERR 9999-DBFIND-DDESC-CD-I"
                   TO BU-MSG-AREA
               MOVE 99 TO COND-WORD
               PERFORM 2100-BLOWUP.

       9999-DBGET5-DDESC-CD-I.
           MOVE 0 TO COND-WORD.
           READ DDESC-CD-I NEXT INTO BUF-DDESC
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   MOVE 15 TO COND-WORD
               ELSE
                   MOVE "DBGET5 ERR 9999-DBGET5-DDESC-CD-I"
                       TO BU-MSG-AREA
                   MOVE 99 TO COND-WORD
                   PERFORM 2100-BLOWUP
           ELSE
           IF CORPCDE OF DDESC-CD-REC-I NOT = CODE-ARG
               MOVE 15 TO COND-WORD.

       9999-OPEN-STUFF.
           OPEN INPUT MSTORERM-CD-I         DDESC-CD-I           .
           OPEN INPUT USAGEFIL-CD-I.

       9999-CLOSE-STUFF.
           CLOSE      MSTORERM-CD-I         DDESC-CD-I           .
           CLOSE USAGEFIL-CD-I.

       9999-SPECIAL-IBM-ESCAPES.
           MOVE IBM-DOUBLE-WIDE-OFF TO NORMAL-0A, NORMAL-3A,
                                       NORMAL-2.
