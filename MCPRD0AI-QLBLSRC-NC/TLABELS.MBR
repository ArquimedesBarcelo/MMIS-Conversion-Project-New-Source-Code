       86-KM-LABELS.
           IF DATA1-NUM-LABELS-9 NOT NUMERIC
               MOVE 1                 TO  DATA1-NUM-LABELS-9.
           PERFORM DATA1-NUM-LABELS-9 TIMES
               MOVE SORT-CODE         TO  PRT-CODE-C
               MOVE SORT-LOCATION     TO  PRT-BIN-C
               WRITE PRINT-REC FROM LABEL-LINE-C1 AFTER ADVANCING 3
               IF DESC (1) = SPACES
                   MOVE "* NO DESC AVAILABLE *"
                                      TO  PRT-DESC-C
               ELSE
                   MOVE DESC (1)      TO  PRT-DESC-C
               END-IF
               WRITE PRINT-REC FROM LABEL-LINE-C2 AFTER ADVANCING 1
               MOVE SPACES            TO  PRT-DESC-C
               WRITE PRINT-REC FROM LABEL-LINE-C2 AFTER ADVANCING 2
               IF DATA1-FORM-SIZE = "3" OR DATA1-FORM-SIZE
                   MOVE SPACES TO PRT-DESC
                   WRITE PRINT-REC FROM LABEL-DESC-LINE
                                               AFTER ADVANCING 6
               END-IF
               ADD 1  TO  LABEL-COUNT
               IF LABEL-COUNT = 20
                   WRITE PRINT-REC FROM NO-PERF AFTER ADVANCING 0
               END-IF
           END-PERFORM.

           GO TO 81-RETURN-SORT.
