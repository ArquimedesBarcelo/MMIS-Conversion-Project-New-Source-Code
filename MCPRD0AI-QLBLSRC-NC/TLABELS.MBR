031800 PROCEDURE DIVISION.
031900 1-HOUSEKEEP SECTION.
032000 1-HOUSEKEEPING.
           MOVE "10" TO BU-DISPLAY-PARA.
032200     CALL "TESCSEQ" USING ESC-NAME.

032300     MOVE CHAR-1636PI TO COMPRESS-1
032400                         COMPRESS-2
                               COMPRESS-2B
032500                         COMPRESS-3
032600     MOVE CHAR-10PI   TO NORMAL-0
                               NORMAL-1
                               NORMAL-1A
032700                         NORMAL-2
032800                         NORMAL-3
                               NORMAL-3B
                               NORMAL-3C
032900                         NORMAL-4
                               NORMAL-4B
033000                         NORMAL-5.

033100     MOVE CHAR-5PI    TO EXPAND-1
033200                         EXPAND-2
033300                         EXPAND-3
                               EXPAND-3B.
           PERFORM 9999-SPECIAL-IBM-ESCAPES.
033400     MOVE PERF-SKIP-ON TO PERF-BACK.
033500     MOVE PERF-SKIP-OFF TO NO-PERF.
033600
           PERFORM 9999-OPEN-STUFF.

           DISPLAY
           "INPUT PRT OPT, FORM SIZE, SORT OPT, SELECT, LOW, HIGH".
           DISPLAY "PPFSSLLLLLLLLLLLLHHHHHHHHHHHH".
034800     ACCEPT DATA-LINE-1.
           DISPLAY "PRINT-OPTION  = ", DATA1-PRINT-OPTION.
           DISPLAY "FORM-SIZE     = ", DATA1-FORM-SIZE.
           DISPLAY "SORT-OPTION   = ", DATA1-SORT-OPTION.
           DISPLAY "SELECT-OPTION = ", DATA1-SELECT-OPTION.
           DISPLAY "LOW-VALUE     = ", DATA1-LOW-VALUE.
           DISPLAY "HIGH-VALUE    = ", DATA1-HIGH-VALUE.
           DISPLAY "KM-OPTION     = ", DATA1-KM-OPTION.
           DISPLAY "NUM-LABELS    = ", DATA1-NUM-LABELS.
034900     IF DATA1-SELECT-OPTION = "5"
035000         PERFORM 4-CORP-CODE-INPUT THRU 4-CCI-X.
035100
           MOVE "14" TO BU-DISPLAY-PARA.
