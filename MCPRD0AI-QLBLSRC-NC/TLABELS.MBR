           PERFORM UNTIL SUB2 > 120 OR A-CODE = "0000000"
               DISPLAY "INPUT CORP CODE, '0000000' TO END"
               ACCEPT ACCEPT-CORP-CODE
               ADD 1 TO SUB2
               IF A-CODE NOT = "0000000"
                   MOVE A-CODE TO CORP-CODE-ITEM (SUB2)
                   DISPLAY "ADDING ", A-CODE, " TO TABLE"
               END-IF
           END-PERFORM.
           MOVE ZERO TO SUB2.
