       IDENTIFICATION DIVISION.
       PROGRAM-ID.  TISCSPCL.
       DATE-COMPILED.
      ************************************************************
      ** THIS PROGRAM REPORTS ON MSTORERM CORPORATELY CODED     **
      ** ITEMS SPECIFICALLY FOR ISC AS A FRANCHISED VENDOR.     **
      ************************************************************
       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.
       COPY SPECIALN OF COPYLIB.
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT MSTORERM-I
               ASSIGN TO DATABASE-MCFLCS0201
               ORGANIZATION IS INDEXED
                 ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
               FILE STATUS IS FILE-STATUS.

           SELECT PRINT-FILE ASSIGN TO PRINTER-MCPRT.

           SELECT SORT-FILE ASSIGN TO DISK-SORTFILE.

       DATA DIVISION.
       FILE SECTION.
       FD  MSTORERM-I
           LABEL RECORDS ARE STANDARD.
       01  MSTORERM-REC-I.
           COPY DDS-MCRPCS0200  OF MCFLCS0201.

       FD  PRINT-FILE
           LABEL RECORDS ARE OMITTED
           RECORD CONTAINS 132 CHARACTERS
           DATA RECORD IS PRINT-REC.
       01  PRINT-REC                     PIC X(132).

       SD  SORT-FILE RECORD CONTAINS 550 CHARACTERS
           DATA RECORD IS SORT-REC.
       01  SORT-REC.
           05  SORT-CODE                 PIC X(8).
           05  SORT-DESC1                PIC X(80).
           05  SORT-DESC2                PIC X(80).
           05  SORT-DESC3                PIC X(80).
           05  SORT-DESC4                PIC X(80).
           05  SORT-DESC5                PIC X(80).
           05  SORT-LOC1                 PIC X(12).
           05  SORT-ONH1                 PIC 9(8).
           05  SORT-ONH1-X REDEFINES SORT-ONH1  PIC X(8).
           05  SORT-LOC2                 PIC X(12).
           05  SORT-ONH2                 PIC 9(8).
           05  SORT-ONH2-X REDEFINES SORT-ONH2  PIC X(8).
           05  SORT-LOC3                 PIC X(12).
           05  SORT-ONH3                 PIC 9(8).
           05  SORT-ONH3-X REDEFINES SORT-ONH3  PIC X(8).
           05  SORT-LOC4                 PIC X(12).
           05  SORT-ONH4                 PIC 9(8).
           05  SORT-ONH4-X REDEFINES SORT-ONH4  PIC X(8).
           05  SORT-LOC5                 PIC X(12).
           05  SORT-ONH5                 PIC 9(8).
           05  SORT-ONH5-X REDEFINES SORT-ONH5  PIC X(8).
           05  SORT-LOC6                 PIC X(12).
           05  SORT-ONH6                 PIC 9(8).
           05  SORT-ONH6-X REDEFINES SORT-ONH6  PIC X(8).
           05  SORT-LASTPO.
               10  SORT-LASTPO-7         PIC X(7).
               10  SORT-LASTPO-RLSE      PIC X(3).
           05  SORT-BINLOC               PIC X(12).

       WORKING-STORAGE SECTION.
       77  BIN-SUB                       PIC S9(4) COMP-4.
       77  LINE-CTR                      PIC 99.
       77  QUALIFY-FLAG                  PIC X.
       77  SAVE-CODE                     PIC X(8).
       77  SUB                           PIC S9(4) COMP-4.
       77  TOT-RECS-CTR                  PIC 9(5).
       01  DETAIL-LINE-1.
           05  D-CODE                    PIC X(8).
           05  FILLER                    PIC X(5).
           05  D-LASTPO.
               10  D-LASTPO-7            PIC X(7).
               10  D-LASTPO-DASH         PIC X.
               10  D-LASTPO-RLSE         PIC X(3).
           05  FILLER                    PIC X(61).
           05  D-BIN1-VAR                PIC X(9).
           05  FILLER                    PIC X.
           05  D-BIN1-LOC                PIC X(12).
           05  FILLER                    PIC XX.
           05  D-QTY1-VAR                PIC X(4).
           05  FILLER                    PIC X.
           05  D-QTY1-QTY                PIC Z(7)9.
           05  FILLER                    PIC X(10).
       01  DETAIL-LINE-2.
           05  D-DESC                    PIC X(80).
           05  FILLER                    PIC X(5).
           05  D-BINX-QTYX-VARS.
               10  D-BIN2-6-VAR          PIC X(9).
               10  FILLER                PIC X.
               10  D-BIN2-6-LOC          PIC X(12).
               10  FILLER                PIC XX.
               10  D-QTY2-6-VAR          PIC X(4).
               10  FILLER                PIC X.
               10  D-QTY2-6-QTY          PIC Z(7)9.
               10  FILLER                PIC X(10).

       01  HANDLE-BLOWUP-FLAG            PIC X(1)  VALUE "Y".

       01  HEADER-0.
           05  FILLER                    PIC X(55) VALUE SPACES.
           05  FILLER                    PIC X(22)
               VALUE "FRANCHISED CODE REPORT".
           05  FILLER                    PIC X(42) VALUE SPACES.
           05  FILLER                    PIC X(5)  VALUE "DATE:".
           05  H0-DATE                   PIC X(8)  VALUE SPACES.

       01  HEADER-1.
           05  FILLER                    PIC X(8)  VALUE "CORPCODE".
           05  FILLER                    PIC X(5)  VALUE SPACES.
           05  FILLER                    PIC X(4)  VALUE "P.O.".
           05  FILLER                    PIC X(68) VALUE SPACES.
           05  FILLER                    PIC X(17)
               VALUE "BIN LOCS AND QTYS".
           05  FILLER                    PIC X(30) VALUE SPACES.

      *****************************************************************
      **                                                             **
      **  S U B P R O G R A M   A R E A                              **
      **                                                             **
      *****************************************************************
       COPY CDESC    IN COPYLIB.
       COPY TBLOWUP  IN COPYLIB.
       COPY TCHKBLKT IN COPYLIB.
       COPY TDATECHK IN COPYLIB.

      *****************************************************************
      **                                                             **
      **  D A T A B A S E   W O R K                                  **
      **                                                             **
      *****************************************************************
       01  BASE                          PIC X(10)  VALUE "  STORES;".
       COPY FILESTAT IN COPYLIB.
       COPY DBSTAT   IN COPYLIB.
       COPY OVRPFDATA  IN COPYLIB.
       01  CODE-ARG                      PIC X(8).

      *****************************************************************
      **                                                             **
      **  D A T A B A S E   B U F F E R S                            **
      **                                                             **
      *****************************************************************
       COPY MSTORERM IN COPYLIB.

       LINKAGE SECTION.
       COPY THDPRTB IN COPYLIB.
       01  MTLS-CNTL-DATA.
           05  MTLS-DATA-LINE-1.
               10  MTLS-SELECT-OPT     PIC X(2).
               10  MTLS-SELECT-OPT2    PIC X(2).
               10  MTLS-SORT-OPT       PIC X(2).
               10  MTLS-FROM-RANGE     PIC X(36).
               10  MTLS-TO-RANGE       PIC X(36).
               10  MTLS-FROM-RANGE2    PIC X(36).
               10  MTLS-TO-RANGE2      PIC X(36).
               10  FILLER              PIC X(2).

       PROCEDURE DIVISION USING HD-ROUTE-DATA, MTLS-CNTL-DATA.
       START-PGM SECTION.
       INIT.
           OPEN INPUT  MSTORERM-I.
           MOVE "MCPRT" TO OVRPRTF-FILE.
           PERFORM 996-OVERRIDE-PRINT-FILE.
           OPEN OUTPUT PRINT-FILE.
           MOVE 61 TO LINE-CTR.
           MOVE 0 TO TOT-RECS-CTR.
           MOVE SPACES TO SAVE-CODE.
           IF MTLS-SORT-OPT = "  " OR "01"
               SORT SORT-FILE ON ASCENDING KEY SORT-CODE
                   INPUT  PROCEDURE IS 7-SORT-RECORDS
                   OUTPUT PROCEDURE IS 8-WRITE-REPORT
      *    ELSE
      *    IF MTLS-SORT-OPT = "02"
      *        SORT SORT-FILE ON ASCENDING KEY SORT-CLASS
      *                                        SORT-CODE
      *            INPUT  PROCEDURE IS 7-SORT-RECORDS
      *            OUTPUT PROCEDURE IS 8-WRITE-REPORT
      *    ELSE
      *    IF MTLS-SORT-OPT = "03"
      *        SORT SORT-FILE ON ASCENDING KEY SORT-KEYWD-MOD
      *                                        SORT-CODE
      *            INPUT  PROCEDURE IS 7-SORT-RECORDS
      *            OUTPUT PROCEDURE IS 8-WRITE-REPORT
           ELSE
           IF MTLS-SORT-OPT = "04"
               SORT SORT-FILE ON ASCENDING KEY SORT-LOC1
                                               SORT-CODE
                   INPUT  PROCEDURE IS 7-SORT-RECORDS
                   OUTPUT PROCEDURE IS 8-WRITE-REPORT
           ELSE
      *    IF MTLS-SORT-OPT = "05"
      *        SORT SORT-FILE ON ASCENDING KEY SORT-AUTHOR
      *                                        SORT-CODE
      *            INPUT  PROCEDURE IS 7-SORT-RECORDS
      *            OUTPUT PROCEDURE IS 8-WRITE-REPORT
      *    ELSE
      *    IF MTLS-SORT-OPT = "06"
      *        SORT SORT-FILE ON ASCENDING KEY SORT-MANUFACT
      *                                        SORT-CODE
      *            INPUT  PROCEDURE IS 7-SORT-RECORDS
      *            OUTPUT PROCEDURE IS 8-WRITE-REPORT
      *    ELSE
      *    IF MTLS-SORT-OPT = "07"
      *        SORT SORT-FILE ON ASCENDING KEY SORT-DFLT-DEPT
      *                                        SORT-CODE
      *            INPUT  PROCEDURE IS 7-SORT-RECORDS
      *            OUTPUT PROCEDURE IS 8-WRITE-REPORT
      *    ELSE
           IF MTLS-SORT-OPT = "08"
               SORT SORT-FILE ON ASCENDING KEY SORT-LOC1
                                               SORT-CODE
                   INPUT  PROCEDURE IS 7-SORT-RECORDS
                   OUTPUT PROCEDURE IS 8-WRITE-REPORT
           ELSE
           IF MTLS-SORT-OPT = "09"
               SORT SORT-FILE ON ASCENDING KEY SORT-LASTPO
                                               SORT-CODE
                   INPUT  PROCEDURE IS 7-SORT-RECORDS
                   OUTPUT PROCEDURE IS 8-WRITE-REPORT
      *    ELSE
      *    IF MTLS-SORT-OPT = "10"
      *        SORT SORT-FILE ON ASCENDING KEY SORT-STR
      *                                        SORT-CODE
      *            INPUT  PROCEDURE IS 7-SORT-RECORDS
      *            OUTPUT PROCEDURE IS 8-WRITE-REPORT
           ELSE
           SORT SORT-FILE ON ASCENDING KEY SORT-CODE
               INPUT  PROCEDURE IS 7-SORT-RECORDS
               OUTPUT PROCEDURE IS 8-WRITE-REPORT.

           CLOSE MSTORERM-I.
           CLOSE PRINT-FILE.
           GOBACK.

       2100-BLOWUP.
           DISPLAY "FATAL ERROR, FILE-STATUS = ", FILE-STATUS.
           DISPLAY "COND-WORD = ", COND-WORD.
           GOBACK.

       COPY OVRPFCALL IN COPYLIB.

       9999-BEGFIL-MSTORERM-I.
           MOVE SPACES TO CORPCDE OF MSTORERM-REC-I.
           START MSTORERM-I KEY >= CORPCDE OF MSTORERM-REC-I
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.

       9999-GETSER-MSTORERM-I.
           MOVE 0 TO COND-WORD.
           READ MSTORERM-I NEXT INTO BUF-MSTORERM
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS-1 = "1"
               MOVE 11 TO COND-WORD
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD
               IF HANDLE-BLOWUP-FLAG = "Y"
                   MOVE "GETSER ERR 9999-GETSER-MSTORERM-I"
                       TO BU-MSG-AREA
                   PERFORM 2100-BLOWUP.

       7-SORT-RECORDS SECTION.
       7-SORT-INIT.
           PERFORM 9999-BEGFIL-MSTORERM-I.
       7-SR-LOOP.
           PERFORM 9999-GETSER-MSTORERM-I.
           IF END-OF-FILE
               DISPLAY "TOTAL RECORDS ON FILE   = " TOT-RECS-CTR
               GO TO 7-SR-EXIT.
           ADD 1 TO TOT-RECS-CTR.
           IF STR-CODE-OWNER = " " GO TO 7-SR-LOOP.
           MOVE SPACES             TO  SORT-REC.
           MOVE CORP-CODE          TO  SORT-CODE
                                       CODE-ARG.
           IF STR-LOC (1) = "            "
               NEXT SENTENCE
           ELSE
           MOVE STR-LOC (1)        TO  SORT-LOC1
           MOVE STR-LOC-ONHAND (1) TO  SORT-ONH1.
           IF STR-LOC (2) = "            "
               NEXT SENTENCE
           ELSE
           MOVE STR-LOC (2)        TO  SORT-LOC2
           MOVE STR-LOC-ONHAND (2) TO  SORT-ONH2.
           IF STR-LOC (3) = "            "
               NEXT SENTENCE
           ELSE
           MOVE STR-LOC (3)        TO  SORT-LOC3
           MOVE STR-LOC-ONHAND (3) TO  SORT-ONH3.
           IF STR-LOC (4) = "            "
               NEXT SENTENCE
           ELSE
           MOVE STR-LOC (4)        TO  SORT-LOC4
           MOVE STR-LOC-ONHAND (4) TO  SORT-ONH4.
           IF STR-LOC (5) = "            "
               NEXT SENTENCE
           ELSE
           MOVE STR-LOC (5)        TO  SORT-LOC5
           MOVE STR-LOC-ONHAND (5) TO  SORT-ONH5.
           IF STR-LOC (6) = "            "
               NEXT SENTENCE
           ELSE
           MOVE STR-LOC (6)        TO  SORT-LOC6
           MOVE STR-LOC-ONHAND (6) TO  SORT-ONH6.
           MOVE "F"                TO  CDESC-DESC-OPTION.
           MOVE 5                  TO  CDESC-LINES-TO-GET.
           MOVE "N"                TO  CDESC-LOCAL-DESC-OPTION.
126000     CALL "CDESC" USING CDESC-RET-CODE, BASE, STATUS-AREA,
126100       BU-DISPLAY-MSG, CODE-ARG, CDESC-DATA.
126200     IF BU-DISPLAY-MSG-1 NOT = SPACES
126300         PERFORM 2100-BLOWUP.
           MOVE CDESC (1)          TO  SORT-DESC1.
           MOVE CDESC (2)          TO  SORT-DESC2.
           MOVE CDESC (3)          TO  SORT-DESC3.
           MOVE CDESC (4)          TO  SORT-DESC4.
           MOVE CDESC (5)          TO  SORT-DESC5.
           MOVE STR-LAST-PO-RLSE   TO  SORT-LASTPO.
           IF MTLS-SELECT-OPT = SPACES
               GO TO 7-CHECK-SECONDARY-RANGE.
           IF MTLS-SELECT-OPT > SPACES AND (MTLS-FROM-RANGE = SPACES
                                       AND MTLS-TO-RANGE = SPACES)
               GO TO 7-CHECK-SECONDARY-RANGE.

      *---------- CHECK CORPORATE CODE.
           IF MTLS-SELECT-OPT = "01"
               IF CORP-CODE < MTLS-FROM-RANGE OR
                  CORP-CODE > MTLS-TO-RANGE
                   GO TO 7-SR-LOOP
               ELSE
                   GO TO 7-CHECK-SECONDARY-RANGE.

      *---------- CHECK ACCOUNTING CLASS.
      *    IF MTLS-SELECT-OPT = "02"
      *        IF STR-CLASS < MTLS-FROM-RANGE OR
      *           STR-CLASS > MTLS-TO-RANGE
      *            GO TO 7-SR-LOOP
      *        ELSE
      *            GO TO 7-CHECK-SECONDARY-RANGE.

      *---------- CHECK CODE DESCRIPTION.
      *    IF MTLS-SELECT-OPT = "03"
      *        IF SORT-KEYWD-MOD < MTLS-FROM-RANGE OR
      *           SORT-KEYWD-MOD > MTLS-TO-RANGE
      *            GO TO 7-SR-LOOP
      *        ELSE
      *            GO TO 7-CHECK-SECONDARY-RANGE.

      *---------- CHECK PRIMARY LOCATION.
           IF MTLS-SELECT-OPT = "04"
               IF STR-LOC(1) < MTLS-FROM-RANGE OR
                  STR-LOC(1) > MTLS-TO-RANGE
                   GO TO 7-SR-LOOP
               ELSE
                   GO TO 7-CHECK-SECONDARY-RANGE.

      *---------- CHECK ORIGINATOR.
      *    IF MTLS-SELECT-OPT = "05"
      *        IF STR-AUTHOR < MTLS-FROM-RANGE OR
      *           STR-AUTHOR > MTLS-TO-RANGE
      *            GO TO 7-SR-LOOP
      *        ELSE
      *            GO TO 7-CHECK-SECONDARY-RANGE.

      *---------- CHECK MANUFACTURER.
      *    IF MTLS-SELECT-OPT = "06"
      *        IF SORT-MANUFACT < MTLS-FROM-RANGE OR
      *           SORT-MANUFACT > MTLS-TO-RANGE
      *            GO TO 7-SR-LOOP
      *        ELSE
      *            GO TO 7-CHECK-SECONDARY-RANGE.

      *---------- CHECK DEFAULT DEPARTMENT.
      *    IF MTLS-SELECT-OPT = "07"
      *        IF STR-DFLT-DEPT < MTLS-FROM-RANGE OR
      *           STR-DFLT-DEPT > MTLS-TO-RANGE
      *            GO TO 7-SR-LOOP
      *        ELSE
      *            GO TO 7-CHECK-SECONDARY-RANGE.

      *---------- CHECK BIN LOCATION.
           IF MTLS-SELECT-OPT = "08"
               MOVE "N"    TO  QUALIFY-FLAG
               PERFORM VARYING BIN-SUB FROM 1 BY 1
                       UNTIL QUALIFY-FLAG EQUAL "Y" OR
                             BIN-SUB GREATER THAN 6
                   IF STR-LOC(BIN-SUB) NOT EQUAL SPACES AND
                       STR-LOC(BIN-SUB) >= MTLS-FROM-RANGE AND
                       STR-LOC(BIN-SUB) <= MTLS-TO-RANGE
                       MOVE "Y" TO QUALIFY-FLAG
                       MOVE STR-LOC(BIN-SUB)  TO  SORT-BINLOC
                   END-IF
               END-PERFORM
               IF QUALIFY-FLAG = "N"
                   GO TO 7-SR-LOOP
               ELSE
                   GO TO 7-CHECK-SECONDARY-RANGE.

      *---------- CHECK PURCHASE ORDER.
           IF MTLS-SELECT-OPT = "09"
               IF SORT-LASTPO-7 < MTLS-FROM-RANGE OR
                   SORT-LASTPO-7 > MTLS-TO-RANGE
                       GO TO 7-SR-LOOP
               ELSE
      *        MOVE SPACES           TO  R11-SMALL-PO
      *                                  R11-LARGE-PO
      *        MOVE MTLS-FROM-RANGE  TO  R11-SMALL-PO
      *        MOVE MTLS-TO-RANGE    TO  R11-LARGE-PO
      *        CALL "TCHKBLKT" USING BASE, CODE-ARG, CHKBLKT-PARMS
      *        IF TOTAL-BLANKET-COUNT < 1
      *            GO TO 7-SR-LOOP
      *        ELSE
      *            MOVE FIRST-UNEXPIRED-BLKT  TO  SORT-PO-NUM
                   GO TO 7-CHECK-SECONDARY-RANGE.

      *---------- CHECK MULTIPLE STOREROOM.
      *    IF MTLS-SELECT-OPT = "10"
      *        MOVE "N"    TO  QUALIFY-FLAG
      *        PERFORM VARYING BIN-SUB FROM 1 BY 1
      *                UNTIL QUALIFY-FLAG EQUAL "Y" OR
      *                      BIN-SUB GREATER THAN 6
      *            IF STR-LOC-1-2 (BIN-SUB) NOT EQUAL SPACES AND
      *                STR-LOC-1-2 (BIN-SUB) >= MTLS-FROM-RANGE AND
      *                STR-LOC-1-2 (BIN-SUB) <= MTLS-TO-RANGE
      *                MOVE "Y" TO QUALIFY-FLAG
      *                MOVE STR-LOC-1-2 (BIN-SUB)  TO  SORT-STR
      *            END-IF
      *        END-PERFORM
      *        IF QUALIFY-FLAG = "N"
      *            GO TO 7-SR-LOOP
      *        ELSE
      *            GO TO 7-CHECK-SECONDARY-RANGE.

      *---------- SECONDARY SELECT.
       7-CHECK-SECONDARY-RANGE.
           IF MTLS-SELECT-OPT2 = SPACES
               GO TO 7-WRITE-SORT.
           IF MTLS-SELECT-OPT2 > SPACES
                                   AND (MTLS-FROM-RANGE2 = SPACES
                                   AND MTLS-TO-RANGE2 = SPACES)
               GO TO 7-WRITE-SORT.

      *---------- CHECK CORPORATE CODE.
           IF MTLS-SELECT-OPT2 = "01"
               IF CORP-CODE < MTLS-FROM-RANGE2 OR
                  CORP-CODE > MTLS-TO-RANGE2
                   GO TO 7-SR-LOOP
               ELSE
                   GO TO 7-WRITE-SORT.

      *---------- CHECK ACCOUNTING CLASS.
      *    IF MTLS-SELECT-OPT2 = "02"
      *        IF STR-CLASS < MTLS-FROM-RANGE2 OR
      *           STR-CLASS > MTLS-TO-RANGE2
      *            GO TO 7-SR-LOOP
      *        ELSE
      *            GO TO 7-WRITE-SORT.

      *---------- CHECK CODE DESCRIPTION.
      *    IF MTLS-SELECT-OPT2 = "03"
      *        IF SORT-KEYWD-MOD < MTLS-FROM-RANGE2 OR
      *           SORT-KEYWD-MOD > MTLS-TO-RANGE2
      *            GO TO 7-SR-LOOP
      *        ELSE
      *            GO TO 7-WRITE-SORT.

      *---------- CHECK PRIMARY LOCATION.
           IF MTLS-SELECT-OPT2 = "04"
               IF STR-LOC(1) < MTLS-FROM-RANGE2 OR
                  STR-LOC(1) > MTLS-TO-RANGE2
                   GO TO 7-SR-LOOP
               ELSE
                   GO TO 7-WRITE-SORT.

      *---------- CHECK ORIGINATOR.
      *    IF MTLS-SELECT-OPT2 = "05"
      *        IF STR-AUTHOR < MTLS-FROM-RANGE2 OR
      *           STR-AUTHOR > MTLS-TO-RANGE2
      *            GO TO 7-SR-LOOP
      *        ELSE
      *            GO TO 7-WRITE-SORT.

      *---------- CHECK MANUFACTURER.
      *    IF MTLS-SELECT-OPT2 = "06"
      *        IF SORT-MANUFACT < MTLS-FROM-RANGE2 OR
      *           SORT-MANUFACT > MTLS-TO-RANGE2
      *            GO TO 7-SR-LOOP
      *        ELSE
      *            GO TO 7-WRITE-SORT.

      *---------- CHECK DEFAULT DEPARTMENT.
      *    IF MTLS-SELECT-OPT2 = "07"
      *        IF STR-DFLT-DEPT < MTLS-FROM-RANGE2 OR
      *           STR-DFLT-DEPT > MTLS-TO-RANGE2
      *            GO TO 7-SR-LOOP
      *        ELSE
      *            GO TO 7-WRITE-SORT.

      *---------- CHECK BIN LOCATION.
           IF MTLS-SELECT-OPT2 = "08"
               MOVE "N"    TO  QUALIFY-FLAG
               PERFORM VARYING BIN-SUB FROM 1 BY 1
                       UNTIL QUALIFY-FLAG EQUAL "Y" OR
                             BIN-SUB GREATER THAN 6
                   IF STR-LOC(BIN-SUB) NOT EQUAL SPACES AND
                       STR-LOC(BIN-SUB) >= MTLS-FROM-RANGE2 AND
                       STR-LOC(BIN-SUB) <= MTLS-TO-RANGE2
                       MOVE "Y" TO QUALIFY-FLAG
                       MOVE STR-LOC(BIN-SUB)  TO  SORT-BINLOC
                   END-IF
               END-PERFORM
               IF QUALIFY-FLAG = "N"
                   GO TO 7-SR-LOOP
               ELSE
                   GO TO 7-WRITE-SORT.

      *---------- CHECK PURCHASE ORDER.
           IF MTLS-SELECT-OPT2 = "09"
               IF SORT-LASTPO-7 < MTLS-FROM-RANGE2 OR
                   SORT-LASTPO-7 > MTLS-TO-RANGE2
                       GO TO 7-SR-LOOP
               ELSE
      *        MOVE SPACES            TO  R11-SMALL-PO
      *                                   R11-LARGE-PO
      *        MOVE MTLS-FROM-RANGE2  TO  R11-SMALL-PO
      *        MOVE MTLS-TO-RANGE2    TO  R11-LARGE-PO
      *        CALL "TCHKBLKT" USING BASE, CODE-ARG, CHKBLKT-PARMS
      *        IF TOTAL-BLANKET-COUNT < 1
      *            GO TO 7-SR-LOOP
      *        ELSE
      *            MOVE FIRST-UNEXPIRED-BLKT  TO  SORT-PO-NUM
                   GO TO 7-WRITE-SORT.

      *---------- CHECK MULTIPLE STOREROOM.
      *    IF MTLS-SELECT-OPT2 = "10"
      *
      *        PERFORM VARYING BIN-SUB FROM 1 BY 1
      *                UNTIL QUALIFY-FLAG EQUAL "Y" OR
      *                      BIN-SUB GREATER THAN 6
      *            IF STR-LOC-1-2 (BIN-SUB) NOT EQUAL SPACES AND
      *                STR-LOC-1-2 (BIN-SUB) >= MTLS-FROM-RANGE2 AND
      *                STR-LOC-1-2 (BIN-SUB) <= MTLS-TO-RANGE2
      *                MOVE "Y" TO QUALIFY-FLAG
      *                MOVE STR-LOC-1-2 (BIN-SUB)  TO  SORT-STR
      *            END-IF
      *        END-PERFORM
      *        IF QUALIFY-FLAG = "N"
      *            GO TO 7-SR-LOOP
      *        ELSE
      *            GO TO 7-WRITE-SORT.
       7-WRITE-SORT.
           RELEASE SORT-REC.
           GO TO 7-SR-LOOP.

       7-SR-EXIT.
           EXIT.

       8-WRITE-REPORT SECTION.
       8-WR-INIT.
           MOVE 0 TO LINE-CTR.
           PERFORM 8-WRITE-HEADERS.
       8-WR-LOOP.
           RETURN SORT-FILE AT END GO TO 8-WR-X.
           MOVE SPACES          TO  DETAIL-LINE-1
                                    DETAIL-LINE-2.
           ADD 7                TO  LINE-CTR.
           IF LINE-CTR > 60
               PERFORM 8-WRITE-HEADERS.
           MOVE SORT-CODE       TO  D-CODE.
           IF SORT-LASTPO = SPACES
               NEXT SENTENCE
           ELSE
           MOVE SORT-LASTPO-7   TO  D-LASTPO-7
           MOVE "-"             TO  D-LASTPO-DASH
           MOVE SORT-LASTPO-RLSE TO D-LASTPO-RLSE.
           IF SORT-LOC1 = SPACES
               NEXT SENTENCE
           ELSE
           MOVE "BIN LOC1:"     TO  D-BIN1-VAR
           MOVE SORT-LOC1       TO  D-BIN1-LOC
           MOVE "QTY:"          TO  D-QTY1-VAR
           IF SORT-ONH1 = SPACES
               MOVE 0           TO  D-QTY1-QTY
           ELSE
           MOVE SORT-ONH1       TO  D-QTY1-QTY.
           MOVE SPACES          TO  PRINT-REC.
           STRING DETAIL-LINE-1
               DELIMITED BY SIZE INTO PRINT-REC.
           WRITE PRINT-REC AFTER ADVANCING 1 LINES.
           MOVE SORT-DESC1      TO  D-DESC.
           IF SORT-LOC2 = SPACES
               MOVE SPACES      TO  D-BINX-QTYX-VARS
           ELSE
           MOVE "BIN LOC2:"     TO  D-BIN2-6-VAR
           MOVE SORT-LOC2       TO  D-BIN2-6-LOC
           MOVE "QTY:"          TO  D-QTY2-6-VAR
           IF SORT-ONH2 = SPACES
               MOVE 0           TO  D-QTY2-6-QTY
           ELSE
           MOVE SORT-ONH2       TO  D-QTY2-6-QTY.
           MOVE SPACES          TO  PRINT-REC.
           STRING DETAIL-LINE-2
               DELIMITED BY SIZE INTO PRINT-REC.
           WRITE PRINT-REC AFTER ADVANCING 1 LINES.
           MOVE SPACES          TO  DETAIL-LINE-2.
           MOVE SORT-DESC2      TO  D-DESC.
           IF SORT-LOC3 = SPACES
               MOVE SPACES      TO  D-BINX-QTYX-VARS
           ELSE
           MOVE "BIN LOC3:"     TO  D-BIN2-6-VAR
           MOVE SORT-LOC3       TO  D-BIN2-6-LOC
           MOVE "QTY:"          TO  D-QTY2-6-VAR
           IF SORT-ONH3 = SPACES
               MOVE 0           TO  D-QTY2-6-QTY
           ELSE
           MOVE SORT-ONH3       TO  D-QTY2-6-QTY.
           MOVE SPACES          TO  PRINT-REC.
           STRING DETAIL-LINE-2
               DELIMITED BY SIZE INTO PRINT-REC.
           WRITE PRINT-REC AFTER ADVANCING 1 LINES.
           MOVE SPACES          TO  DETAIL-LINE-2.
           MOVE SORT-DESC3      TO  D-DESC.
           IF SORT-LOC4 = SPACES
               MOVE SPACES      TO  D-BINX-QTYX-VARS
           ELSE
           MOVE "BIN LOC4:"     TO  D-BIN2-6-VAR
           MOVE SORT-LOC4       TO  D-BIN2-6-LOC
           MOVE "QTY:"          TO  D-QTY2-6-VAR
           IF SORT-ONH4 = SPACES
               MOVE 0           TO  D-QTY2-6-QTY
           ELSE
           MOVE SORT-ONH4       TO  D-QTY2-6-QTY.
           MOVE SPACES          TO  PRINT-REC.
           STRING DETAIL-LINE-2
               DELIMITED BY SIZE INTO PRINT-REC.
           WRITE PRINT-REC AFTER ADVANCING 1 LINES.
           MOVE SPACES          TO  DETAIL-LINE-2.
           MOVE SORT-DESC4      TO  D-DESC.
           IF SORT-LOC5 = SPACES
               MOVE SPACES      TO  D-BINX-QTYX-VARS
           ELSE
           MOVE "BIN LOC5:"     TO  D-BIN2-6-VAR
           MOVE SORT-LOC5       TO  D-BIN2-6-LOC
           MOVE "QTY:"          TO  D-QTY2-6-VAR
           IF SORT-ONH5 = SPACES
               MOVE 0           TO  D-QTY2-6-QTY
           ELSE
           MOVE SORT-ONH5       TO  D-QTY2-6-QTY.
           MOVE SPACES          TO  PRINT-REC.
           STRING DETAIL-LINE-2
               DELIMITED BY SIZE INTO PRINT-REC.
           WRITE PRINT-REC AFTER ADVANCING 1 LINES.
           MOVE SPACES          TO  DETAIL-LINE-2.
           MOVE SORT-DESC5      TO  D-DESC.
           IF SORT-LOC6 = SPACES
               MOVE SPACES      TO  D-BINX-QTYX-VARS
           ELSE
           MOVE "BIN LOC6:"     TO  D-BIN2-6-VAR
           MOVE SORT-LOC6       TO  D-BIN2-6-LOC
           MOVE "QTY:"          TO  D-QTY2-6-VAR
           IF SORT-ONH6 = SPACES
               MOVE 0           TO  D-QTY2-6-QTY
           ELSE
           MOVE SORT-ONH6       TO  D-QTY2-6-QTY.
           MOVE SPACES          TO  PRINT-REC.
           STRING DETAIL-LINE-2
               DELIMITED BY SIZE INTO PRINT-REC.
           WRITE PRINT-REC AFTER ADVANCING 1 LINES.
           MOVE SPACES          TO  DETAIL-LINE-2.
           MOVE SPACES          TO  PRINT-REC.
           WRITE PRINT-REC AFTER ADVANCING 1 LINES.
           GO TO 8-WR-LOOP.

       8-WRITE-HEADERS.
           MOVE SPACES TO  PRINT-REC.
           WRITE PRINT-REC AFTER ADVANCING NEW-PAGE.
           ACCEPT H0-DATE FROM DATE.
           STRING HEADER-0
             DELIMITED BY SIZE INTO PRINT-REC.
           WRITE PRINT-REC AFTER ADVANCING 1.
           MOVE SPACES  TO PRINT-REC.
           STRING HEADER-1
               DELIMITED BY SIZE INTO PRINT-REC.
           WRITE PRINT-REC AFTER ADVANCING 1 LINES.
           MOVE ALL "-" TO PRINT-REC.
           WRITE PRINT-REC AFTER ADVANCING 1 LINES.
           MOVE 4 TO LINE-CTR.

       8-WR-X.    EXIT.
