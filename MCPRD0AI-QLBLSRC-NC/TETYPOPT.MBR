000200 IDENTIFICATION DIVISION.
000300 PROGRAM-ID.    TETYPOPT.
000500 ENVIRONMENT DIVISION.
000600 CONFIGURATION SECTION.
000700 SOURCE-COMPUTER.   AS400.
000800 OBJECT-COMPUTER.   AS400.
       COPY SPECIALN IN COPYLIB.
001000 INPUT-OUTPUT SECTION.
001100 FILE-CONTROL.
           SELECT DISPLAY-FILE
               ASSIGN TO WORKSTATION-ZREPORT-SI
               ORGANIZATION IS TRANSACTION
               FILE STATUS IS DSPLY-STATUS
               CONTROL-AREA IS WS-CONTROL.
001200     SELECT OUT-FILE
               ASSIGN TO DATABASE-MCFPOUTF
               ORGANIZATION IS SEQUENTIAL
               ACCESS IS SEQUENTIAL
               FILE STATUS IS OF-STATUS.
001600 DATA DIVISION.
001700 FILE SECTION.
       FD  DISPLAY-FILE
           LABEL RECORDS ARE OMITTED.
       01  DSPLY-REC                   PIC X(2000).
001800 FD  OUT-FILE
001900     RECORD CONTAINS 12 CHARACTERS
002000     DATA RECORD IS OUTF.
002100 01  OUTF                      PIC X(12).
002400 WORKING-STORAGE SECTION.
       01  BLOWUP-BASE               PIC X(16).
       COPY CATREAD    OF COPYLIB.
       COPY CPYIND     OF COPYLIB.
       COPY CCRTFILE   OF COPYLIB.
       01  DSPLY-STATUS              PIC XX.
       01  ERROR-BUFFER              PIC X(80).
       COPY IOFEEDBACK IN COPYLIB.
       COPY JCWAREA IN COPYLIB.
       01  OF-STATUS                 PIC XX.
004100 01  READ-ETYPES.
004200     05  READ-ETYP OCCURS 5 TIMES.
004300         10  READ-ETYPE        PIC X(8).
004400         10  READ-ESUBS        PIC X(4).
           05  READ-CMD-LINE         PIC X(79).
           05  READ-MSG-LINE         PIC X(79).
       COPY DBSTAT    OF COPYLIB.
004600 01  SUB9                      PIC S9(4) COMP-4.
       COPY TBLOWUP   OF COPYLIB.
       01  TRUE-VAL                  PIC 1 VALUE B"1".
       COPY VCOMLINK  OF COPYLIB.
004900 COPY WSCONTROL OF COPYLIB.
005100 PROCEDURE DIVISION.
005200
       START-PGM.
           PERFORM 1-HSK.
           PERFORM 6-MAIN THRU 6-MAIN-LOOP UNTIL VIEW-LASTKEY = 3.
015400 2-EOJ.
           CLOSE DISPLAY-FILE.
015700     CLOSE OUT-FILE.
           MOVE "058"       TO SETJCW-VALUE.
           MOVE 278         TO SETJCW-STARTING-POS.
           MOVE 3           TO SETJCW-LENGTH.
           CALL "SETJCW" USING SETJCW-VALUE,
                               SETJCW-STARTING-POS,
                               SETJCW-LENGTH,
                               SETJCW-STATUS.
           IF SETJCW-STATUS NOT = "00"
               MOVE "SETJCW ERROR" TO BU-DISPLAY-MSG
               PERFORM 998-BLOWUP.

           CALL "TRSCREN2".

015800     GOBACK.
005300 1-HSK.
           MOVE "*CURLIB"     TO CCRTFILE-LIBRARY.
           MOVE "MCFPOUTF"    TO CCRTFILE-FILE.
           MOVE "0012"        TO CCRTFILE-RECORD-LENGTH.
           MOVE "01000"       TO CCRTFILE-NO-RECORDS.
           MOVE "01000"       TO CCRTFILE-INCREMENT-AMT.
           MOVE "03"          TO CCRTFILE-NO-INCREMENTS.
           CALL "CCRTFILE" USING CCRTFILE-LIBRARY,
                                 CCRTFILE-FILE,
                                 CCRTFILE-RECORD-LENGTH,
                                 CCRTFILE-NO-RECORDS,
                                 CCRTFILE-INCREMENT-AMT,
                                 CCRTFILE-NO-INCREMENTS,
                                 CCRTFILE-STATUS.
           IF CCRTFILE-STATUS NOT = "00"
               MOVE "CCRTFILE CREATE OF 'MCFPOUTF' FAILED"
                  TO BU-DISPLAY-MSG
               PERFORM 998-BLOWUP.
           OPEN I-O    DISPLAY-FILE.
006500     OPEN OUTPUT OUT-FILE.
007800     MOVE "FETYPOPT" TO VIEW-CFNAME.
009000     MOVE SPACES TO READ-ETYPES.
           MOVE SPACES TO DSPLY-REC.
           MOVE 0 TO VIEW-LASTKEY.
010200 6-MAIN.
           IF ERROR-BUFFER NOT = SPACES
               MOVE ERROR-BUFFER TO READ-MSG-LINE.
           MOVE READ-ETYPES TO DSPLY-REC.
           PERFORM 99-SCREEN-WRITE.
           PERFORM 98-SCREEN-READ.
           MOVE DSPLY-REC TO READ-ETYPES.
           MOVE SPACES TO ERROR-BUFFER.
011300     IF VIEW-LASTKEY = 3 GO TO 2-EOJ.
011400     IF VIEW-LASTKEY NOT = 0
               MOVE 35026 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE TRUE-VAL TO INDS (99)
               GO TO 6-MAIN.
012700     MOVE 0 TO SUB9.
012900 6-MAIN-LOOP.
013000     ADD 1 TO SUB9.
013200     IF SUB9 > 5 OR READ-ETYP (SUB9) = SPACES
               MOVE SPACES TO READ-ETYPES DSPLY-REC
               GO TO 6-MAIN.
014200     MOVE SPACES TO OUTF.
           MOVE READ-ETYP (SUB9) TO OUTF.
014600     WRITE OUTF.
015100     GO TO 6-MAIN-LOOP.

       98-SCREEN-READ.
           READ DISPLAY-FILE FORMAT IS VIEW-CFNAME
               INDIC IS INDICS.
           ACCEPT IOFEEDBACK FROM I-O-FEEDBACK-AREA.
           MOVE ALL B"0" TO INDICS.
           IF DSPLY-STATUS NOT = "00"
               MOVE 3 TO VIEW-LASTKEY
           ELSE
           MOVE FUNCTION-NUM TO VIEW-LASTKEY.

       98A-SCREEN-READ.
           READ DISPLAY-FILE TERMINAL IS TERMINAL-ID
               INDIC IS INDICS
                  NO DATA MOVE DSPLY-STATUS TO DSPLY-STATUS.
           MOVE ALL B"0" TO INDICS.

       99-SCREEN-WRITE.
           WRITE DSPLY-REC FORMAT IS VIEW-CFNAME
               INDIC IS INDICS.
           MOVE ALL B"0" TO INDICS.
045400 998-BLOWUP.
045500     MOVE "TETYPOPT" TO BU-PGM-NAME.
045600     CALL "TBLOWUP" USING BLOWUP-BASE BU-PGM-NAME STATUS-AREA
045700                      VIEW-COMAREA DUMMY-KSAM-STAT
045800                      BU-DISPLAY-MSG BU-DISPLAY-FLDS.

       999-CATREAD.
           MOVE SPACES TO ERROR-BUFFER.
           CALL "CCATREAD" USING CATREAD-PARMS.
           MOVE CATREAD-MSG-TEXT TO ERROR-BUFFER.
       999-CATREAD-EXIT.    EXIT.
