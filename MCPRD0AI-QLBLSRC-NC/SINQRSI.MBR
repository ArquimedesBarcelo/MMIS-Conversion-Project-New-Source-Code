047810 850-MATCH-ITEM.
           MOVE 0 TO COND-WORD.
           IF PASS-HISTORY-FLAG NOT = "Y"
               READ DRCVITEM NEXT INTO BUF-DRCVITEM
                   AT END MOVE 15 TO COND-WORD
               END-READ
           ELSE
               READ DRCVITEM-ST NEXT INTO BUF-DRCVITEM-H
                   AT END MOVE 15 TO COND-WORD
               END-READ
           END-IF.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   MOVE 15 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.
