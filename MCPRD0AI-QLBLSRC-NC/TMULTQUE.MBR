           05  TABLE-BUFFER.
               10  WO-A.
                   15  A-SELECT              PIC X.
                   15  A-FACTOR              PIC 99.
                   15  A-EQUIP               PIC X(6).
                   15  A-DOWN                PIC X.
                   15  A-WO-NUM.
                       20  A-WO-NUM-6        PIC X(6).
                       20  A-WO-YR           PIC X.
                       20  A-WO-SUF          PIC X(3).
                   15  A-DESCRIPTION         PIC X(30).
                   15  A-SKILL-1             PIC XX.
                   15  A-SKILL-2             PIC XX.
                   15  A-SKILL-3             PIC XX.
               10  WO-B.
                   15  B-SELECT              PIC X.
                   15  B-FACTOR              PIC 99.
                   15  B-EQUIP               PIC X(6).
                   15  B-DOWN                PIC X.
                   15  B-WO-NUM.
                       20  B-WO-NUM-6        PIC X(6).
                       20  B-WO-YR           PIC X.
                       20  B-WO-SUF          PIC X(3).
                   15  B-DESCRIPTION         PIC X(30).
                   15  B-SKILL-1             PIC XX.
                   15  B-SKILL-2             PIC XX.
                   15  B-SKILL-3             PIC XX.
               10  WO-C.
                   15  C-SELECT              PIC X.
                   15  C-FACTOR              PIC 99.
                   15  C-EQUIP               PIC X(6).
                   15  C-DOWN                PIC X.
                   15  C-WO-NUM.
                       20  C-WO-NUM-6        PIC X(6).
                       20  C-WO-YR           PIC X.
                       20  C-WO-SUF          PIC X(3).
                   15  C-DESCRIPTION         PIC X(30).
                   15  C-SKILL-1             PIC XX.
                   15  C-SKILL-2             PIC XX.
                   15  C-SKILL-3             PIC XX.
               10  WO-D.
                   15  D-SELECT              PIC X.
                   15  D-FACTOR              PIC 99.
                   15  D-EQUIP               PIC X(6).
                   15  D-DOWN                PIC X.
                   15  D-WO-NUM.
                       20  D-WO-NUM-6        PIC X(6).
                       20  D-WO-YR           PIC X.
                       20  D-WO-SUF          PIC X(3).
                   15  D-DESCRIPTION         PIC X(30).
                   15  D-SKILL-1             PIC XX.
                   15  D-SKILL-2             PIC XX.
                   15  D-SKILL-3             PIC XX.
               10  WO-E.
                   15  E-SELECT              PIC X.
                   15  E-FACTOR              PIC 99.
                   15  E-EQUIP               PIC X(6).
                   15  E-DOWN                PIC X.
                   15  E-WO-NUM.
                       20  E-WO-NUM-6        PIC X(6).
                       20  E-WO-YR           PIC X.
                       20  E-WO-SUF          PIC X(3).
                   15  E-DESCRIPTION         PIC X(30).
                   15  E-SKILL-1             PIC XX.
                   15  E-SKILL-2             PIC XX.
                   15  E-SKILL-3             PIC XX.
           05  CMDMSG          PIC X(79).
           05  ERRMSG          PIC X(79).

       01  RES-CC-MSG.
