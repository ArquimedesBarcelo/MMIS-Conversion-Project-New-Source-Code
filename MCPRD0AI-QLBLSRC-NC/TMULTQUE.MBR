       01  QUEUE-RECORDS.
           05  QWO-A.
               10  QA-SELECT             PIC X.
               10  QA-FACTOR             PIC 99.
               10  QA-EQUIP              PIC X(6).
               10  QA-DOWN               PIC X.
               10  QA-WO-NUM.
                   15  QA-WO-NUM-6       PIC X(6).
                   15  QA-WO-YR          PIC X.
                   15  QA-WO-SUF         PIC X(3).
               10  QA-DESCRIPTION        PIC X(30).
               10  QA-SKILL-1            PIC XX.
               10  QA-SKILL-2            PIC XX.
               10  QA-SKILL-3            PIC XX.
           05  QWO-B.
               10  QB-SELECT             PIC X.
               10  QB-FACTOR             PIC 99.
               10  QB-EQUIP              PIC X(6).
               10  QB-DOWN               PIC X.
               10  QB-WO-NUM.
                   15  QB-WO-NUM-6       PIC X(6).
                   15  QB-WO-YR          PIC X.
                   15  QB-WO-SUF         PIC X(3).
               10  QB-DESCRIPTION        PIC X(30).
               10  QB-SKILL-1            PIC XX.
               10  QB-SKILL-2            PIC XX.
               10  QB-SKILL-3            PIC XX.
           05  QWO-C.
               10  QC-SELECT             PIC X.
               10  QC-FACTOR             PIC 99.
               10  QC-EQUIP              PIC X(6).
               10  QC-DOWN               PIC X.
               10  QC-WO-NUM.
                   15  QC-WO-NUM-6       PIC X(6).
                   15  QC-WO-YR          PIC X.
                   15  QC-WO-SUF         PIC X(3).
               10  QC-DESCRIPTION        PIC X(30).
               10  QC-SKILL-1            PIC XX.
               10  QC-SKILL-2            PIC XX.
               10  QC-SKILL-3            PIC XX.
           05  QWO-D.
               10  QD-SELECT             PIC X.
               10  QD-FACTOR             PIC 99.
               10  QD-EQUIP              PIC X(6).
               10  QD-DOWN               PIC X.
               10  QD-WO-NUM.
                   15  QD-WO-NUM-6       PIC X(6).
                   15  QD-WO-YR          PIC X.
                   15  QD-WO-SUF         PIC X(3).
               10  QD-DESCRIPTION        PIC X(30).
               10  QD-SKILL-1            PIC XX.
               10  QD-SKILL-2            PIC XX.
               10  QD-SKILL-3            PIC XX.
           05  QWO-E.
               10  QE-SELECT             PIC X.
               10  QE-FACTOR             PIC 99.
               10  QE-EQUIP              PIC X(6).
               10  QE-DOWN               PIC X.
               10  QE-WO-NUM.
                   15  QE-WO-NUM-6       PIC X(6).
                   15  QE-WO-YR          PIC X.
                   15  QE-WO-SUF         PIC X(3).
               10  QE-DESCRIPTION        PIC X(30).
               10  QE-SKILL-1            PIC XX.
               10  QE-SKILL-2            PIC XX.
               10  QE-SKILL-3            PIC XX.

       01  SORT-BUFFER.
           05  A-ENTRY         PIC X(56).
           05  B-ENTRY         PIC X(56).
           05  C-ENTRY         PIC X(56).
           05  D-ENTRY         PIC X(56).
           05  E-ENTRY         PIC X(56).

       01  HOLD-BUFFER.
           05  H-SELECT        PIC X.
           05  H-FACTOR.
               10  H-FACT1     PIC 9.
               10  H-FACT2     PIC 9.
           05  H-EQUIP         PIC X(6).
           05  H-DOWN          PIC X.
           05  H-WO-NUM.
               10  H-WO-NUM-6  PIC X(6).
               10  H-WO-YR     PIC X.
               10  H-WO-SUF    PIC X(3).
           05  H-DESCRIPTION   PIC X(30).
           05  H-SKILL-1       PIC XX.
           05  H-SKILL-2       PIC XX.
           05  H-SKILL-3       PIC XX.

       01  COMPARE-FACTORS.
           05  A-FACT                  PIC Z9.
           05  A-FAC9 REDEFINES A-FACT PIC 99.
           05  B-FACT                  PIC Z9.
           05  B-FAC9 REDEFINES B-FACT PIC 99.
           05  C-FACT                  PIC Z9.
           05  C-FAC9 REDEFINES C-FACT PIC 99.
           05  D-FACT                  PIC Z9.
           05  D-FAC9 REDEFINES D-FACT PIC 99.
           05  E-FACT                  PIC Z9.
           05  E-FAC9 REDEFINES E-FACT PIC 99.
           05  H-FACT                  PIC Z9.
           05  H-FAC9 REDEFINES H-FACT PIC 99.

       01 RESERVATION-SCREEN.
           05  RM-1            PIC X(50) VALUE ALL "*".
           05  RM-2            PIC X(50) VALUE ALL "*".
           05  RM-3            PIC X(50) VALUE SPACES.
           05  RM-4            PIC X(50) VALUE SPACES.
           05  RM-5            PIC X(50) VALUE SPACES.
           05  RM-6            PIC X(50) VALUE SPACES.
           05  RM-7            PIC X(50) VALUE ALL "*".
           05  RM-8            PIC X(50) VALUE ALL "*".
           05  CMDMSGR         PIC X(79).
           05  ERRMSGR         PIC X(79).

       01  DB-ERROR.
           05  DB-FUNC   PIC X(10) VALUE SPACES.
           05  DB-FILE   PIC X(18) VALUE SPACES.
           05  FILLER    PIC X(20) VALUE "ERROR - FILE-STAT = ".
           05  CON-WORD  PIC XX.

           COPY SCREENIO       IN COPYLIB.

           COPY CATREAD        IN COPYLIB.

           COPY JCWAREA        IN COPYLIB.

       01  WO-BASIC-DATA.
           COPY DWOBASIC       IN COPYLIB.

       01  WO-PLANNED-DATA.
           COPY DWOPLAN        IN COPYLIB.

       01  PERSONNEL-DATA.
           COPY MPERSONL       IN COPYLIB.

       01  WO-QUEUE-DATA.
           COPY DWOOPENQ       IN COPYLIB.

       01  MESSAGE-BUF-DATA.
           COPY ERRORLIN       IN COPYLIB.

       LINKAGE SECTION.
       01  EQUIP-BUF           PIC X(06).

       01  CNUM-BUFFER.
           05  CNUM-BUF        PIC XXXX.
           05  CNAM-BUF        PIC X(16).

       01  QUEUE-WO-DATA.
           05  QUEUE-WO-SAVE   PIC X(10).
           05  QUEUE-RESET     PIC X.

       01  DBPARAMETERS.
           COPY DBPARMS        IN COPYLIB.

       PROCEDURE DIVISION      USING EQUIP-BUF
                               CNUM-BUFFER
                               QUEUE-WO-DATA
                               DBPARAMETERS.

       BEGIN.
           OPEN I-O            DISPLAY-FILE.
           OPEN INPUT          PER-PERSONNEL.
           OPEN INPUT          WO-BASIC.
           OPEN INPUT          WO-OPEN-Q-EQP.
           OPEN I-O            WO-OPEN-Q-WO.

           MOVE SPACES         TO HOLD-BUFFER SCREEN-DATA
                                  WO-BASIC-DATA WO-PLANNED-DATA
                                  MESSAGE-BUFFER.
           MOVE EQUIP-BUF      TO EQP-DISP.
           MOVE 0              TO LOOP-CTR FIND-SW.
           ACCEPT MC-LOCAL-DATA-AREA FROM LOCAL-DATA-AREA.

      **************************************************
      **  IF JCW `AUTOQSW' IS EQUAL TO A SPACE, THE   **
      **  EXECUTIVE PROGRAM WILL RUN THE AUTO-QUEUE   **
      **  VERSION OF `f1' (TAUTOQZ).  IF THE JCW IS   **
      **  SET TO ANY OTHER VALUE, THE AUTO-CRAFT      **
      **  VERSION OF `f1' (TAUTOQC) WILL BE EXECUTED. **
      **************************************************
           MOVE "Q"            TO AUTOQ-SW.
           IF JCW-AUTOQSW-266 = " "
               NEXT SENTENCE
           ELSE
               MOVE "C"        TO AUTOQ-SW.

           MOVE CNUM-BUF       TO PERCCNUM OF PER-PERSONNEL.
           READ PER-PERSONNEL  INTO PERSONNEL-DATA
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
               MOVE FILE-STAT  TO CON-WORD
               MOVE "READ    " TO DB-FUNC
               MOVE "PER-PERSONNEL" TO DB-FILE
               DISPLAY DB-ERROR
               GO TO END-OF-JOB.

       READ-QUEUE.
           MOVE EQUIP-BUF      TO EQPNUM OF WO-OPEN-Q-EQP.
           START WO-OPEN-Q-EQP KEY = EQPNUM OF WO-OPEN-Q-EQP
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
               IF FILE-STAT-1 = "2"
                   GO TO SCREEN-DISPLAY
               ELSE
                   MOVE FILE-STAT  TO CON-WORD
                   MOVE "START   " TO DB-FUNC
                   MOVE "WO-OPEN-Q-EQP" TO DB-FILE
                   DISPLAY DB-ERROR
                   GO TO END-OF-JOB.

       DBGET-LOOP.
           READ WO-OPEN-Q-EQP  NEXT INTO WO-QUEUE-DATA
               AT END          MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
               IF FILE-STAT = "10" OR "14" OR "46"
                   IF FIND-SW = 1
                       PERFORM SORT-TABLE
                       GO TO SCREEN-DISPLAY
                   ELSE
                       GO TO SCREEN-DISPLAY
               ELSE
                   MOVE FILE-STAT  TO CON-WORD
                   MOVE "READ    " TO DB-FUNC
                   MOVE "WO-OPEN-Q-EQP" TO DB-FILE
                   DISPLAY DB-ERROR
                   GO TO END-OF-JOB.

           IF EQUIP-BUF NOT = Q-EQUIP-NUM
               IF FIND-SW = 1
                   PERFORM SORT-TABLE
                   GO TO SCREEN-DISPLAY
               ELSE
                   GO TO SCREEN-DISPLAY.

           IF Q-CC-NUM NOT = "9999"
               GO TO DBGET-LOOP.

           IF PER-CRAFT = Q-SKILL-1 OR Q-SKILL-2 OR Q-SKILL-3
               NEXT SENTENCE
           ELSE
               GO TO DBGET-LOOP.

           MOVE 1              TO FIND-SW.
           ADD  1              TO LOOP-CTR.
           PERFORM LOAD-HOLD.
           IF LOOP-CTR = 1
               MOVE HOLD-BUFFER TO WO-A
               MOVE H-FACTOR    TO A-FACT
           ELSE
           IF LOOP-CTR = 2
               MOVE HOLD-BUFFER TO WO-B
               MOVE H-FACTOR    TO B-FACT
           ELSE
           IF LOOP-CTR = 3
               MOVE HOLD-BUFFER TO WO-C
               MOVE H-FACTOR    TO C-FACT
           ELSE
           IF LOOP-CTR = 4
               MOVE HOLD-BUFFER TO WO-D
               MOVE H-FACTOR    TO D-FACT
           ELSE
           IF LOOP-CTR = 5
               MOVE HOLD-BUFFER TO WO-E
               MOVE H-FACTOR    TO E-FACT
           ELSE
           IF LOOP-CTR > 5
               PERFORM SORT-TABLE
               PERFORM RE-ADJUST.

           GO TO DBGET-LOOP.

       SORT-TABLE.
           MOVE ZEROS          TO COMPARE-FACTORS.
           IF A-FACTOR IS NUMERIC
               MOVE A-FACTOR   TO A-FAC9.
           IF B-FACTOR IS NUMERIC
               MOVE B-FACTOR   TO B-FAC9.
           IF C-FACTOR IS NUMERIC
               MOVE C-FACTOR   TO C-FAC9.
           IF D-FACTOR IS NUMERIC
               MOVE D-FACTOR   TO D-FAC9.
           IF E-FACTOR IS NUMERIC
               MOVE E-FACTOR   TO E-FAC9.

           MOVE SPACES         TO SORT-BUFFER HOLD-BUFFER.
           MOVE " "            TO RESET-SW.
           MOVE 0              TO H-FACT.
           PERFORM SORT-LOOP THRU SORT-EXIT.
           MOVE HOLD-BUFFER    TO A-ENTRY.
           PERFORM RESET-FACTOR.

           PERFORM SORT-LOOP THRU SORT-EXIT.
           MOVE HOLD-BUFFER    TO B-ENTRY.
           PERFORM RESET-FACTOR.

           PERFORM SORT-LOOP THRU SORT-EXIT.
           MOVE HOLD-BUFFER    TO C-ENTRY.
           PERFORM RESET-FACTOR.

           PERFORM SORT-LOOP THRU SORT-EXIT.
           MOVE HOLD-BUFFER    TO D-ENTRY.
           PERFORM RESET-FACTOR.

           PERFORM SORT-LOOP THRU SORT-EXIT.
           MOVE HOLD-BUFFER    TO E-ENTRY.
           MOVE SORT-BUFFER    TO TABLE-BUFFER.

       SORT-LOOP.
           IF A-FAC9 > H-FAC9
               MOVE "A"        TO RESET-SW
               MOVE WO-A       TO HOLD-BUFFER
               MOVE A-FAC9     TO H-FACT.

           IF B-FAC9 > H-FAC9
               MOVE "B"        TO RESET-SW
               MOVE WO-B       TO HOLD-BUFFER
               MOVE B-FAC9     TO H-FACT.

           IF C-FAC9 > H-FAC9
               MOVE "C"        TO RESET-SW
               MOVE WO-C       TO HOLD-BUFFER
               MOVE C-FAC9     TO H-FACT.

           IF D-FAC9 > H-FAC9
               MOVE "D"        TO RESET-SW
               MOVE WO-D       TO HOLD-BUFFER
               MOVE D-FAC9     TO H-FACT.

           IF E-FAC9 > H-FAC9
               MOVE "E"        TO RESET-SW
               MOVE WO-E       TO HOLD-BUFFER
               MOVE E-FAC9     TO H-FACT.

       SORT-EXIT.    EXIT.

       RESET-FACTOR.
           MOVE SPACES         TO HOLD-BUFFER.
           IF RESET-SW = "A"
               MOVE 0          TO A-FAC9 H-FAC9
           ELSE
           IF RESET-SW = "B"
               MOVE 0          TO B-FAC9 H-FAC9
           ELSE
           IF RESET-SW = "C"
               MOVE 0          TO C-FAC9 H-FAC9
           ELSE
           IF RESET-SW = "D"
               MOVE 0          TO D-FAC9 H-FAC9
           ELSE
           IF RESET-SW = "E"
               MOVE 0          TO E-FAC9 H-FAC9.

       RE-ADJUST.
           IF E-FACTOR NOT NUMERIC
               MOVE 0          TO E-FACTOR.
           IF QUEUE-FACTOR NOT NUMERIC
               MOVE 0          TO QUEUE-FACTOR.
           IF QUEUE-FACTOR > E-FACTOR
               PERFORM LOAD-HOLD
               MOVE H-FACTOR   TO E-FACT
               MOVE HOLD-BUFFER TO WO-E
               PERFORM SORT-TABLE.

       LOAD-HOLD.
           MOVE SPACES         TO H-SELECT H-EQUIP.
           MOVE Q-EQP-DN       TO H-DOWN.
           MOVE Q-WO-NUM       TO H-WO-NUM.
           MOVE QUEUE-FACTOR   TO H-FACTOR.
           IF H-FACT1 NOT NUMERIC MOVE 0 TO H-FACT1.
           MOVE Q-DESCRIPTION  TO H-DESCRIPTION.
           MOVE Q-SKILL-1      TO H-SKILL-1.
           MOVE Q-SKILL-2      TO H-SKILL-2.
           MOVE Q-SKILL-3      TO H-SKILL-3.

       SCREEN-DISPLAY.
           MOVE "VMULTQUE"     TO SCREEN-NAME.
           MOVE SCREEN-DATA    TO DISPLAY-REC.

       SHOWFORM.
           IF FIND-SW = 0
               PERFORM EMPTY-QUEUE-DISPLAY.

           MOVE "00"           TO SCREEN-STATUS.

           WRITE DISPLAY-REC  FORMAT IS SCREEN-NAME
               INDIC ARE SCREEN-INDICATORS.
           IF SCREEN-STATUS NOT = "00"
               DISPLAY "SCREEN WRITE ERROR.  SCREEN-STATUS IS "
                        SCREEN-STATUS
               GO TO END-OF-JOB.

           READ  DISPLAY-FILE FORMAT IS SCREEN-NAME
               INDIC ARE SCREEN-INDICATORS
           IF SCREEN-STATUS NOT = "00"
               DISPLAY "SCREEN READ ERROR.  SCREEN-STATUS IS "
                        SCREEN-STATUS
               GO TO END-OF-JOB.

           IF SCREEN-NAME = "VMULTQUE"
               MOVE DISPLAY-REC TO SCREEN-DATA.
           MOVE ALL B"0"       TO SCREEN-INDICATORS.

           IF KEY-HIT = 3
               GO TO END-OF-JOB.

           IF KEY-HIT = 7
               IF RETURN-BYTE = "J"
                   MOVE 0      TO KEY-HIT.

           IF KEY-HIT = 7
               PERFORM COUNT-RESERVATIONS THRU COUNT-EXIT
               IF RESERVATIONS = 5
                   GO TO RESERVE-WO
               ELSE
               MOVE TABLE-BUFFER TO QUEUE-RECORDS
               IF AUTOQ-SW = "Q"
                   MOVE 1      TO FUNCTION-SW
                   CALL "CLAUTOQZ" USING DBPARAMETERS
                                         FUNCTION-SW
                                         CNUM-BUFFER
                                         QUEUE-RECORDS
                                         RESERVATIONS
                   MOVE QUEUE-RECORDS TO TABLE-BUFFER
                   PERFORM COUNT-RESERVATIONS THRU COUNT-EXIT
                   IF RESERVATIONS > 0
                       MOVE 1 TO FIND-SW
                       GO TO SCREEN-DISPLAY
                   ELSE
                       GO TO SCREEN-DISPLAY
               ELSE
                   MOVE 1      TO FUNCTION-SW
                   CALL "CLAUTOQC" USING DBPARAMETERS
                                         FUNCTION-SW
                                         CNUM-BUFFER
                                         QUEUE-RECORDS
                                         RESERVATIONS
                   MOVE QUEUE-RECORDS TO TABLE-BUFFER
                   PERFORM COUNT-RESERVATIONS THRU COUNT-EXIT
                   IF RESERVATIONS > 0
                       MOVE 1 TO FIND-SW
                       GO TO SCREEN-DISPLAY
                   ELSE
                       GO TO SCREEN-DISPLAY.

           IF KEY-HIT = 6
               PERFORM HELP-FUNCTION
               GO TO SCREEN-DISPLAY.

           IF KEY-HIT = 1
               MOVE A-WO-NUM   TO WO-KEY
               PERFORM DISPLAY-WO THRU DISPLAY-EXIT
               GO TO SHOWFORM.

           IF KEY-HIT = 2
               MOVE B-WO-NUM   TO WO-KEY
               PERFORM DISPLAY-WO THRU DISPLAY-EXIT
               GO TO SHOWFORM.

           IF KEY-HIT = 8
               MOVE C-WO-NUM   TO WO-KEY
               PERFORM DISPLAY-WO THRU DISPLAY-EXIT
               GO TO SHOWFORM.

           IF KEY-HIT = 4
               MOVE D-WO-NUM   TO WO-KEY
               PERFORM DISPLAY-WO THRU DISPLAY-EXIT
               GO TO SHOWFORM.

           IF KEY-HIT = 5
               MOVE E-WO-NUM   TO WO-KEY
               PERFORM DISPLAY-WO THRU DISPLAY-EXIT
               GO TO SHOWFORM.

       RESERVE-WO.
           IF A-SELECT NOT = SPACE
               MOVE SPACES     TO RES-CC
               MOVE A-WO-NUM   TO WO-KEY
               PERFORM RESERVE-FUNCTION THRU RESERVE-EXIT
               IF RES-CC NOT = SPACES
                   MOVE SPACE  TO A-SELECT
                   MOVE RES-CC-MSG TO A-DESCRIPTION
                   GO TO SHOWFORM.

           IF B-SELECT NOT = SPACE
               MOVE SPACES     TO RES-CC
               MOVE B-WO-NUM   TO WO-KEY
               PERFORM RESERVE-FUNCTION THRU RESERVE-EXIT
               IF RES-CC NOT = SPACES
                   MOVE SPACE  TO B-SELECT
                   MOVE RES-CC-MSG TO B-DESCRIPTION
                   GO TO SHOWFORM.

           IF C-SELECT NOT = SPACE
               MOVE SPACES     TO RES-CC
               MOVE C-WO-NUM   TO WO-KEY
               PERFORM RESERVE-FUNCTION THRU RESERVE-EXIT
               IF RES-CC NOT = SPACES
                   MOVE SPACE  TO C-SELECT
                   MOVE RES-CC-MSG TO C-DESCRIPTION
                   GO TO SHOWFORM.

           IF D-SELECT NOT = SPACE
               MOVE SPACES     TO RES-CC
               MOVE D-WO-NUM   TO WO-KEY
               PERFORM RESERVE-FUNCTION THRU RESERVE-EXIT
               IF RES-CC NOT = SPACES
                   MOVE SPACE  TO D-SELECT
                   MOVE RES-CC-MSG TO D-DESCRIPTION
                   GO TO SHOWFORM.

           IF E-SELECT NOT = SPACE
               MOVE SPACES     TO RES-CC
               MOVE E-WO-NUM   TO WO-KEY
               PERFORM RESERVE-FUNCTION THRU RESERVE-EXIT
               IF RES-CC NOT = SPACES
                   MOVE SPACE  TO E-SELECT
                   MOVE RES-CC-MSG TO E-DESCRIPTION
                   GO TO SHOWFORM.

           GO TO END-OF-JOB.

       COUNT-RESERVATIONS.
           MOVE 0              TO RESERVATIONS.
           MOVE SPACES         TO SORT-BUFFER.
           IF A-SELECT NOT = SPACE ADD 1 TO RESERVATIONS.
           IF A-SELECT     = SPACE
               MOVE WO-A       TO A-ENTRY
               MOVE SPACES     TO WO-A.
           IF B-SELECT NOT = SPACE ADD 1 TO RESERVATIONS.
           IF B-SELECT     = SPACE
               MOVE WO-B       TO B-ENTRY
               MOVE SPACES     TO WO-B.
           IF C-SELECT NOT = SPACE ADD 1 TO RESERVATIONS.
           IF C-SELECT     = SPACE
               MOVE WO-C       TO C-ENTRY
               MOVE SPACES     TO WO-C.
           IF D-SELECT NOT = SPACE ADD 1 TO RESERVATIONS.
           IF D-SELECT     = SPACE
               MOVE WO-D       TO D-ENTRY
               MOVE SPACES     TO WO-D.
           IF E-SELECT NOT = SPACE ADD 1 TO RESERVATIONS.
           IF E-SELECT     = SPACE
               MOVE WO-E       TO E-ENTRY
               MOVE SPACES     TO WO-E.

           IF RESERVATIONS = 5
               GO TO COUNT-EXIT
           ELSE
           IF RESERVATIONS = 0
               MOVE SORT-BUFFER TO TABLE-BUFFER
               GO TO COUNT-EXIT.
           PERFORM COMPRESS-SCREEN 4 TIMES.
           MOVE TABLE-BUFFER   TO HOLD-AREA.
           MOVE SORT-BUFFER    TO TABLE-BUFFER.
           PERFORM COMPRESS-SCREEN 4 TIMES.
           MOVE TABLE-BUFFER   TO SORT-BUFFER.
           MOVE HOLD-AREA      TO TABLE-BUFFER.
           PERFORM REFILL-FROM-TOP.

       COUNT-EXIT.    EXIT.

       COMPRESS-SCREEN.
           IF WO-A = SPACES
               MOVE WO-B       TO WO-A
               MOVE WO-C       TO WO-B
               MOVE WO-D       TO WO-C
               MOVE WO-E       TO WO-D
               MOVE SPACES     TO WO-E.

           IF WO-B = SPACES
               MOVE WO-C       TO WO-B
               MOVE WO-D       TO WO-C
               MOVE WO-E       TO WO-D
               MOVE SPACES     TO WO-E.

           IF WO-C = SPACES
               MOVE WO-D       TO WO-C
               MOVE WO-E       TO WO-D
               MOVE SPACES     TO WO-E.

           IF WO-D = SPACES
               MOVE WO-E       TO WO-D
               MOVE SPACES     TO WO-E.

       REFILL-FROM-TOP.
           IF WO-B = SPACES
               MOVE A-ENTRY    TO WO-B
               MOVE B-ENTRY    TO WO-C
               MOVE C-ENTRY    TO WO-D
               MOVE D-ENTRY    TO WO-E
           ELSE
           IF WO-C = SPACES
               MOVE A-ENTRY    TO WO-C
               MOVE B-ENTRY    TO WO-D
               MOVE C-ENTRY    TO WO-E
           ELSE
           IF WO-D = SPACES
               MOVE A-ENTRY    TO WO-D
               MOVE B-ENTRY    TO WO-E
           ELSE
           IF WO-E = SPACES
               MOVE A-ENTRY    TO WO-E.

       RESERVE-FUNCTION.
           MOVE WO-KEY         TO WONUM OF WO-OPEN-Q-WO.
           START WO-OPEN-Q-WO  KEY = WONUM OF WO-OPEN-Q-WO
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
               IF FILE-STAT-1 = "2"
                   GO TO RESERVE-EXIT
               ELSE
                   MOVE FILE-STAT  TO CON-WORD
                   MOVE "START   " TO DB-FUNC
                   MOVE "WO-OPEN-Q-WO" TO DB-FILE
                   DISPLAY DB-ERROR
                   GO TO RESERVE-EXIT.

       RESERVE-LOOP.
           READ WO-OPEN-Q-WO   NEXT INTO WO-QUEUE-DATA
               AT END          MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
               IF FILE-STAT = "10" OR "14" OR "46"
                   GO TO RESERVE-EXIT
               ELSE
                   MOVE FILE-STAT  TO CON-WORD
                   MOVE "READ    " TO DB-FUNC
                   MOVE "WO-OPEN-Q-WO" TO DB-FILE
                   DISPLAY DB-ERROR
                   GO TO RESERVE-EXIT.

           IF WO-KEY NOT = Q-WO-NUM
               GO TO RESERVE-EXIT.

           IF Q-WO-NUM = QUEUE-WO-SAVE
               NEXT SENTENCE
           ELSE
           IF Q-RESERVE = "XX"
               MOVE Q-CC-NUM   TO RES-CC
               GO TO RESERVE-EXIT.

           MOVE CNUM-BUF       TO Q-CC-NUM.
           MOVE "XX"           TO Q-RESERVE.

           REWRITE QWO-REC     FROM WO-QUEUE-DATA
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
               MOVE FILE-STAT  TO CON-WORD
               MOVE "REWRITE " TO DB-FUNC
               MOVE "WO-OPEN-Q-WO" TO DB-FILE
               DISPLAY DB-ERROR
               GO TO RESERVE-EXIT.

       RESERVE-EXIT.    EXIT.

       HELP-FUNCTION.
           MOVE "VHELPMULT"    TO SCREEN-NAME.
           MOVE "00"           TO SCREEN-STATUS.

           WRITE DISPLAY-REC  FORMAT IS SCREEN-NAME
               INDIC ARE SCREEN-INDICATORS.
           IF SCREEN-STATUS NOT = "00"
               DISPLAY "SCREEN WRITE ERROR.  SCREEN-STATUS IS "
                        SCREEN-STATUS
               GO TO END-OF-JOB.

           READ  DISPLAY-FILE FORMAT IS SCREEN-NAME
               INDIC ARE SCREEN-INDICATORS
           IF SCREEN-STATUS NOT = "00"
               DISPLAY "SCREEN READ ERROR.  SCREEN-STATUS IS "
                        SCREEN-STATUS
               GO TO END-OF-JOB.

           MOVE ALL B"0"       TO SCREEN-INDICATORS.

       DISPLAY-WO.
           MOVE WO-KEY         TO WONUM OF WO-BASIC.
           START WO-BASIC      KEY = WONUM OF WO-BASIC
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
               IF FILE-STAT-1 = "2"
      **********************************************************************
      **    MESSAGE 035/040:
      ** INVALID WORKORDER NUMBER
      **********************************************************************
                   MOVE  35        TO CATREAD-MSG-SET
                   MOVE  40        TO CATREAD-MSG-NUM
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE MESSAGE-BUFFER TO ERRMSG
                   GO TO DISPLAY-EXIT
               ELSE
                   MOVE FILE-STAT  TO CON-WORD
                   MOVE "START   " TO DB-FUNC
                   MOVE "WO-BASIC" TO DB-FILE
                   MOVE DB-ERROR   TO MESSAGE-BUFFER
                   MOVE MESSAGE-BUFFER TO ERRMSG
                   GO TO DISPLAY-EXIT.

           READ WO-BASIC       NEXT INTO WO-BASIC-DATA
               AT END          MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
               IF FILE-STAT = "10" OR "14" OR "46"
      **********************************************************************
      **    MESSAGE 035/040:
      ** INVALID WORKORDER NUMBER
      **********************************************************************
                   MOVE  35        TO CATREAD-MSG-SET
                   MOVE  40        TO CATREAD-MSG-NUM
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE MESSAGE-BUFFER TO ERRMSG
                   GO TO DISPLAY-EXIT
               ELSE
                   MOVE FILE-STAT  TO CON-WORD
                   MOVE "READ    " TO DB-FUNC
                   MOVE "WO-BASIC" TO DB-FILE
                   MOVE DB-ERROR   TO MESSAGE-BUFFER
                   MOVE MESSAGE-BUFFER TO ERRMSG
                   GO TO DISPLAY-EXIT.

           IF WO-KEY NOT = WO-NUM
      **********************************************************************
      **    MESSAGE 035/040:
      ** INVALID WORKORDER NUMBER
      **********************************************************************
               MOVE  35        TO CATREAD-MSG-SET
               MOVE  40        TO CATREAD-MSG-NUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER TO ERRMSG
               GO TO DISPLAY-EXIT.

           CALL "TDISPWO" USING DBPARAMETERS
                                WO-BASIC-DATA
                                WO-PLANNED-DATA
                                FILE-SW.

           MOVE "VMULTQUE"     TO SCREEN-DATA.

       DISPLAY-EXIT.    EXIT.

       END-OF-JOB.
           MOVE SPACE          TO QUEUE-RESET.
           IF QUEUE-WO-DATA = SPACES
               GO TO EOJ-CLOSE-FILES.

           IF A-WO-NUM NOT = SPACES
               IF A-WO-NUM = QUEUE-WO-SAVE
                   MOVE "X" TO QUEUE-RESET
                   GO TO EOJ-CLOSE-FILES.

           IF B-WO-NUM NOT = SPACES
               IF B-WO-NUM = QUEUE-WO-SAVE
                   MOVE "X" TO QUEUE-RESET
                   GO TO EOJ-CLOSE-FILES.

           IF C-WO-NUM NOT = SPACES
               IF C-WO-NUM = QUEUE-WO-SAVE
                   MOVE "X" TO QUEUE-RESET
                   GO TO EOJ-CLOSE-FILES.

           IF D-WO-NUM NOT = SPACES
               IF D-WO-NUM = QUEUE-WO-SAVE
                   MOVE "X" TO QUEUE-RESET
                   GO TO EOJ-CLOSE-FILES.

           IF E-WO-NUM NOT = SPACES
               IF E-WO-NUM = QUEUE-WO-SAVE
                   MOVE "X" TO QUEUE-RESET.

       EOJ-CLOSE-FILES.
           CLOSE               PER-PERSONNEL.
           CLOSE               WO-BASIC.
           CLOSE               WO-OPEN-Q-EQP.
           CLOSE               WO-OPEN-Q-WO.
           CLOSE               DISPLAY-FILE.
           GOBACK.

       EMPTY-QUEUE-DISPLAY.
      **********************************************************************
      **    MESSAGE 065/001:
      ** ***  THERE ARE NO WORKORDERS IN THE QUEUE FOR  ***
      **********************************************************************
           MOVE  65            TO CATREAD-MSG-SET.
           MOVE   1            TO CATREAD-MSG-NUM.
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
           MOVE MESSAGE-BUFFER TO RM-3.

      **********************************************************************
      **    MESSAGE 065/002:
      ** ***  THE EQUIPMENT NAMED ABOVE.  IF YOU WISH   ***
      **********************************************************************
           MOVE  65            TO CATREAD-MSG-SET.
           MOVE   2            TO CATREAD-MSG-NUM.
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
           MOVE MESSAGE-BUFFER TO RM-4.

      **********************************************************************
      **    MESSAGE 065/003:
      ** ***  TO RESERVE FROM THE QUEUE, PRESS THE `f7' ***
      **********************************************************************
           MOVE  65            TO CATREAD-MSG-SET.
           MOVE   3            TO CATREAD-MSG-NUM.
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
           MOVE MESSAGE-BUFFER TO RM-5.

      **********************************************************************
      **    MESSAGE 065/004:
      ** ***  KEY, OR PRESS THE `ENTER' KEY TO CONTINUE ***
      **********************************************************************
           MOVE  65            TO CATREAD-MSG-SET.
           MOVE   4            TO CATREAD-MSG-NUM.
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
           MOVE MESSAGE-BUFFER TO RM-6.

           MOVE "VRESMSGS"      TO SCREEN-NAME.
           MOVE RESERVATION-SCREEN TO DISPLAY-REC.

       999-CATREAD.
           MOVE SPACES         TO MESSAGE-BUFFER.
           CALL "CCATREAD" USING CATREAD-PARMS.
           MOVE CATREAD-MSG-TEXT TO MESSAGE-BUFFER.

       999-CATREAD-EXIT.    EXIT.

