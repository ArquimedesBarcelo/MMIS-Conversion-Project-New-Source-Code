       IDENTIFICATION DIVISION.
       PROGRAM-ID.             TMULTQUE.
       AUTHOR.                 W. ROXBURY.
       INSTALLATION.           GOODYEAR TIRE & RUBBER CO.
       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.
       SOURCE-COMPUTER.        IBM-AS400.
       OBJECT-COMPUTER.        IBM-AS400.
       SPECIAL-NAMES.          REQUESTOR IS WORK-STATION
                               SYSTEM-CONSOLE IS CONSOLE
                               LOCAL-DATA IS LOCAL-DATA-AREA.
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT WO-BASIC
                  ASSIGN       TO DATABASE-MCFLMM1001
                  ORGANIZATION IS INDEXED
                  ACCESS MODE  IS DYNAMIC
                  RECORD KEY   IS EXTERNALLY-DESCRIBED-KEY
                               WITH DUPLICATES
                  FILE STATUS  IS FILE-STAT.

           SELECT PER-PERSONNEL
                  ASSIGN       TO DATABASE-MCFLMM0301
                  ORGANIZATION IS INDEXED
                  ACCESS MODE  IS DYNAMIC
                  RECORD KEY   IS EXTERNALLY-DESCRIBED-KEY
                  FILE STATUS  IS FILE-STAT.

           SELECT WO-OPEN-Q-WO
                  ASSIGN       TO DATABASE-MCFLMM1902
                  ORGANIZATION IS INDEXED
                  ACCESS MODE  IS DYNAMIC
                  RECORD KEY   IS EXTERNALLY-DESCRIBED-KEY
                               WITH DUPLICATES
                  FILE STATUS  IS FILE-STAT.

           SELECT WO-OPEN-Q-EQP
                  ASSIGN       TO DATABASE-MCFLMM1904
                  ORGANIZATION IS INDEXED
                  ACCESS MODE  IS DYNAMIC
                  RECORD KEY   IS EXTERNALLY-DESCRIBED-KEY
                               WITH DUPLICATES
                  FILE STATUS  IS FILE-STAT.

           SELECT DISPLAY-FILE
                  ASSIGN       TO WORKSTATION-ZCFTHELP-SI
                  ORGANIZATION IS TRANSACTION
                  ACCESS MODE  IS SEQUENTIAL
                  FILE STATUS  IS SCREEN-STATUS
                               MAJOR-MINOR
                  CONTROL-AREA IS SCREEN-CONTROL.

       DATA DIVISION.
       FILE SECTION.
       FD  WO-BASIC
           LABEL RECORDS ARE STANDARD.
       01  VWO-REC.
           COPY DDS-ALL-FORMATS OF MCFLMM1001.

       FD  PER-PERSONNEL
           LABEL RECORDS ARE STANDARD.
       01  PERS-REC.
           COPY DDS-ALL-FORMATS OF MCFLMM0301.

       FD  WO-OPEN-Q-WO
           LABEL RECORDS ARE STANDARD.
       01  QWO-REC.
           COPY DDS-ALL-FORMATS OF MCFLMM1902.

       FD  WO-OPEN-Q-EQP
           LABEL RECORDS ARE STANDARD.
       01  QEQP-REC.
           COPY DDS-ALL-FORMATS OF MCFLMM1904.

       FD  DISPLAY-FILE
           LABEL RECORDS ARE OMITTED.
       01  DISPLAY-REC         PIC X(2000).

       WORKING-STORAGE SECTION.
       77  LOOP-CTR            PIC S9(4)  COMP-4 VALUE 0.
       77  FUNCTION-SW         PIC  9(4)         VALUE 1.
       77  RESERVATIONS        PIC  9(4)         VALUE 0.
       77  FIND-SW             PIC  9(4)         VALUE 0.
       77  RESET-SW            PIC X      VALUE SPACE.
       77  QUEUE-ERROR         PIC X(76).
       77  FILE-SW             PIC X      VALUE "B".
       77  WO-KEY              PIC X(10).
       77  HOLD-AREA           PIC X(280) VALUE SPACES.
       77  AUTOQ-SW            PIC X      VALUE "Q".

       01  FILE-STAT.
           05  FILE-STAT-1     PIC X  VALUE "0".
           05  FILE-STAT-2     PIC X  VALUE "0".

       01  SCREEN-DATA.
