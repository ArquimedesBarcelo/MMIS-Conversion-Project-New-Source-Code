021600*****************************************************************
021700*****          P R O C E D U R E   D I V I S I O N         ******
021800*****************************************************************
021900
022000 PROCEDURE DIVISION USING HD-ROUTE-DATA, OPTION-AREA.
022100 START-UP SECTION.
022200 HOUSEKEEPING.
9406CK     MOVE "C" TO SCOPE.
9406CK     CALL "MCXCBLERR" USING SCOPE.

           OPEN INPUT MVALIDPLTDATA-I,
                      MCLASS-I,
                      MPLTINFO-I.
022900     MOVE 1 TO DATE-MODE.
023000     CALL "TDATECHK" USING DATE-CHECK-AREA.
023100     MOVE DATE-SLASH-OUT           TO  PRT-DATE.
023200     MOVE DATE-FORMATTED-TIME-OUT  TO  PRT-TIME.
           MOVE "PREQ"                   TO  PLT-ARG.
           MOVE PLT-ARG TO PLTINFOKEY OF MPLTINFO-REC.
           READ MPLTINFO-I INTO BUF-MPLTINFO
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE "N"                       TO  SAVE-REQ-SYNR3-SW
           ELSE
               MOVE MPLTINFO-REQ-SYNR3-SW     TO  SAVE-REQ-SYNR3-SW.
023300
023400******* ACCEPT SELECTION CRITERIA AND HEADER INFORMATION
023500 1-GET-SELECTION.
      ************************************
      **   DISPLAY ROUTE DATA
      ************************************
023600     DISPLAY HD-ROUTE-DATA.
082000     MOVE HD-SPOOLER-NUMBER       TO  OVRPRTF-TOFILE-NUM.
           MOVE "*YES"                  TO  OVRPRTF-SHARED.
082100     MOVE HD-NO-OF-COPIES         TO  OVRPRTF-COPIES.
           PERFORM 996-OVERRIDE-PRINT-FILE.
023800
023900     OPEN OUTPUT ONLINE-PRT.
024100     MOVE "DHDR25.PUB"  TO HD-FILE-NAME.
024200     CALL "THDPRT2" USING HD-RET-CODE, HD-FILE-NAME, FNUM,
024300       HD-ROUTE-DATA, ESC-NAME.
024400     IF HD-RET-CODE NOT = 0
024500         MOVE "THDPRT2 ERROR IN 3-GET-SELECTION"
024600            TO BU-DISPLAY-MSG
024700         MOVE "HD-RET-CODE = "          TO BU-DISPLAY-FLD (1)
024800         MOVE HD-RET-CODE               TO BU-DISPLAY-FLD9 (1)
024900         GO TO 2-BLOWUP.
025000
025100      CALL "TESCSEQ" USING ESC-NAME.
025200      MOVE CHAR-1636PI     TO COMPRESS-PRINT.
025300      MOVE CHAR-10PI       TO NORMAL-PRINT.
025600
025600     IF SELECT-D = "X" OR
025600        SELECT-O = "X" OR
025600        SELECT-E = "X" OR
025600        SELECT-N = "X" OR
025600        SELECT-C = "X" OR
025600        SELECT-P = "X" OR
025600        SELECT-I = "X"
025700         SORT SORT-MVALIDPLT-FILE
025800           ON ASCENDING KEY      SORT-FIELD
025900              INPUT  PROCEDURE IS  ABSTRACT-CODES
026000              OUTPUT PROCEDURE IS  WRITE-REPORT.
026100
025600     IF SELECT-L = "X"
025700         SORT SORT-MCLASS-FILE
025800           ON ASCENDING KEY      SORT-MCLASS-CLS
025900              INPUT  PROCEDURE IS  SORT-ACCT-CODES
026000              OUTPUT PROCEDURE IS  WRITE-ACCT-REPORT.
026000
026200
026200
026300 2-SHUTDOWN-DB.
026500     WRITE PRINT-RCD FROM NORMAL-PRINT AFTER ADVANCING 0.
026600     CLOSE ONLINE-PRT.
           CLOSE MVALIDPLTDATA-I,
                 MCLASS-I,
                 MPLTINFO-I.
027100     GOBACK.
027200
027300 2-BLOWUP.
022300     MOVE "TRPTACC" TO BU-PGM-NAME.
027400     CALL "TBLOWUP" USING BASE, BU-PGM-NAME, STATUS-AREA,
027500         DUMMY-VIEW-AREA, DUMMY-KSAM-STAT, BU-DISPLAY-MSG,
027600             BU-DISPLAY-AREA.
027700
027800 2-BLOWUP-X.
027900     EXIT.
028000
028100
028200*******************************************
028300*                                         *
028400*    I N P U T    P R O C E D U R E       *
028500*           FOR  MVALIDPLTDATA            *
028600*******************************************
028700
028800 ABSTRACT-CODES SECTION.
028900 ABSTRACT-LOOP.
029000
029100*** SERIAL GET THRU MVALIDPLTDATA
029200
           READ MVALIDPLTDATA-I NEXT INTO BUF-MVALIDPLTDATA
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
030000             GO TO AC-X
030100         ELSE
030200             MOVE "READ MVALIDPLTDATA *AL" TO BU-DISPLAY-MSG
030400             GO TO 2-BLOWUP.
030500
030600 DOES-CODE-QUALIFY.
030700     MOVE VALID-DATA-KEY    TO SORT-FIELD.
030700     MOVE VALID-DATA-CO-PR  TO SORT-CO-PR.
030800
030900     RELEASE SORT-RCD.
031000
031100     GO TO ABSTRACT-LOOP.
031200 AC-X.
031300     EXIT.
031400
031500*******************************************
031600*                                         *
031700*    O U T P U T   P R O C E D U R E      *
031800*          FOR   MVALIDPLTDATA            *
031900*******************************************
032000
032100 WRITE-REPORT SECTION.
032200 WRITE-RPT.
032300     IF PAPER-IS-132-COLS
032400         NEXT SENTENCE
032500     ELSE
032600         WRITE PRINT-RCD FROM COMPRESS-PRINT AFTER ADVANCING 0.
032800     MOVE SPACES TO ITEM-LINE-1, ITEM-LINE-2, ITEM-LINE-3.

032900 AGAIN.
033000     PERFORM RETURN-RCD.
033100     IF EOF-SW = "Y"
033100         GO TO FINAL-PROCEDURE.
033200     MOVE SORT-DETAIL   TO CODE-LINE.
033300
033400     IF CLASS-CODE = "DP"
033500         IF SELECT-D = "X" OR
033500            SELECT-O = "X"
033600             NEXT SENTENCE
033700         ELSE
033800             GO TO AGAIN
033900     ELSE
034000     IF CLASS-CODE = "EC"
034100         IF SELECT-E = "X"
034200             NEXT SENTENCE
034300         ELSE
034400             GO TO AGAIN
034500     ELSE
034600     IF CLASS-CODE = "NW"
034700         IF SELECT-N = "X"
034800             NEXT SENTENCE
034900         ELSE
035000             GO TO AGAIN
035100     ELSE
034600     IF CLASS-CODE = "CO"
034700         IF SELECT-C = "X"
034800             NEXT SENTENCE
034900         ELSE
035000             GO TO AGAIN
035100     ELSE
034600     IF CLASS-CODE = "PR"
034700         IF SELECT-P = "X"
034800             NEXT SENTENCE
034900         ELSE
035000             GO TO AGAIN
035100     ELSE
           IF CLASS-CODE = "RC"
                GO TO AGAIN
           ELSE
035200     IF CLASS-CODE-1X = "S"
035300          GO TO AGAIN
035400     ELSE
035500          PERFORM BADONE
035600          GO TO AGAIN.
035800
035900     IF CLASS-CODE NOT EQUAL TO CLASS-PAGE
036000         IF KOUNT > 0
036100         PERFORM CHANGE-OF-CLASS
036200         PERFORM PAGE-HDR
036300     ELSE
036400         PERFORM PAGE-HDR.
036500
036600     IF ITMS-PER-PAGE > 49 PERFORM PAGE-HDR.
036700     PERFORM TYPE-PROCEDURE.
036800     GO TO AGAIN.

036900 FINAL-PROCEDURE.
037000     IF KOUNT > 0 PERFORM  CHANGE-OF-CLASS.
037100     IF BAD-KOUNT > 0
037200         PERFORM BAD-CODE-LISTING
037300         PERFORM BAD-LOOP
037400             VARYING BAD-KOUNT-OUT FROM 1 BY 1
037500                 UNTIL BAD-KOUNT-OUT > BAD-KOUNT
037600         IF KOUNT > 0
037700             MOVE ITEM-LINE-2 TO PRINT-LINE
037800             PERFORM WRITE-ITEM-LINE.
037900     GO TO WR-X.
038300
038000 RETURN-RCD.
038100     RETURN SORT-MVALIDPLT-FILE
038200         AT END MOVE "Y" TO EOF-SW.
038300
038400*******************************************
038500*                                         *
038600*    V A L I D  C O D E S  R E P O R T    *
038700*           FOR   MVALIDPLTDATA           *
038800*******************************************
038900
039000 WRITE-ITEM-LINE.
039100     WRITE PRINT-RCD  AFTER ADVANCING 1 LINES.
039200     MOVE 0 TO KOUNT.
039300     ADD 1 TO ITMS-PER-PAGE.
032800     MOVE SPACES TO ITEM-LINE-1, ITEM-LINE-2, ITEM-LINE-3.
039500
039600 PAGE-HDR.
039700     MOVE SPACES         TO PRINT-LINE.
039800     WRITE PRINT-RCD AFTER ADVANCING NEW-PAGE.
039900     ADD 1               TO PG-CTR.
040000     MOVE PG-CTR         TO PRT-OVER-PG.
040100     MOVE REPORT-HEADER          TO PRINT-RCD.
040200     WRITE PRINT-RCD AFTER  ADVANCING 1 LINES.
040300     MOVE 0 TO ITMS-PER-PAGE.
040400     MOVE CLASS-CODE TO CLASS-PAGE.

040500     IF CLASS-PAGE = "DP"
              IF SELECT-O = "X"
                  PERFORM TYPE-1-DL-HDR
              ELSE
                  PERFORM TYPE-1-HDR.
040600     IF CLASS-PAGE = "EC"
040600         PERFORM TYPE-2-HDR.
040700     IF CLASS-PAGE = "NW"
040600         PERFORM TYPE-3-HDR.
040700     IF CLASS-PAGE = "CO"
040600         PERFORM TYPE-4-HDR.
040700     IF CLASS-PAGE = "PR"
040600         PERFORM TYPE-5-HDR.
040800     IF CLASS-PAGE = "XX"
040800         PERFORM BAD-CLASS-CODE.
040900     WRITE PRINT-RCD  AFTER ADVANCING 1 LINES.
041000     MOVE SPACES TO PRINT-LINE.
041100     WRITE PRINT-RCD FROM DOT-LINE AFTER ADVANCING 1 LINES.
041200     MOVE SPACES TO PRINT-LINE.
041300     WRITE PRINT-RCD AFTER ADVANCING 1 LINES.
041400
041500 TYPE-PROCEDURE.
041600     IF CLASS-PAGE = "DP"
041400         IF SELECT-O = "X"
041400             PERFORM TYPE-DL
041400         ELSE
041400             PERFORM TYPE-DP
041700     ELSE
041800     IF CLASS-PAGE = "EC" OR "NW"
042100         PERFORM TYPE-EC-NW
041900     ELSE
042000     IF CLASS-PAGE = "CO" OR "PR"
042100         PERFORM TYPE-CO-PR.
042100
042200 CHANGE-OF-CLASS.
042300     IF CLASS-PAGE = "DP"
042100         IF SELECT-O = "X"
042100             MOVE ITEM-LINE-1-DL TO PRINT-LINE
042100         ELSE
042100             MOVE ITEM-LINE-1    TO PRINT-LINE.
042400     IF CLASS-PAGE = "EC" OR "NW"
042400         MOVE ITEM-LINE-2        TO PRINT-LINE.
042500     IF CLASS-PAGE = "CO" OR "PR"
042400         MOVE ITEM-LINE-3        TO PRINT-LINE.

042600     PERFORM WRITE-ITEM-LINE.

042700 TYPE-1-HDR.
042800     MOVE HDR-DP TO PRINT-LINE.

042700 TYPE-1-DL-HDR.
042800     MOVE HDR-DL TO PRINT-LINE.
042900
043000 TYPE-2-HDR.
043100     MOVE HDR-EC TO PRINT-LINE.
043200
043300 TYPE-3-HDR.
           IF SAVE-REQ-SYNR3-SW = "Y"
               MOVE HDR-NW-R3 TO PRINT-LINE
           ELSE
043400     MOVE HDR-NW TO PRINT-LINE.
043200
043300 TYPE-4-HDR.
043400     MOVE HDR-CO TO PRINT-LINE.
043200
043300 TYPE-5-HDR.
043400     MOVE HDR-PR TO PRINT-LINE.
043200
043500 BAD-CLASS-CODE.
043600     MOVE BAD-CODE-HDR TO PRINT-LINE.
043700
043800 TYPE-DP.
043900     ADD 1 TO KOUNT.
044000     MOVE NUM-PART TO  ITEM-DP(KOUNT).
044100     IF KOUNT = 4
044200         MOVE ITEM-LINE-1 TO PRINT-LINE
044300         PERFORM WRITE-ITEM-LINE.
043700
043800 TYPE-DL.
043900     ADD 1 TO KOUNT.
044000     MOVE SPACES   TO  ITEM-DP-LINK (KOUNT),
044000                       ITEM-CO-LINK (KOUNT),
044000                       ITEM-PR-LINK (KOUNT).
044000     MOVE NUM-PART TO  ITEM-DP-LINK (KOUNT).
044000     MOVE CO-CODE  TO  ITEM-CO-LINK (KOUNT).
044000     MOVE PR-CODE  TO  ITEM-PR-LINK (KOUNT).
044100     IF KOUNT = 4
044200         MOVE ITEM-LINE-1-DL TO PRINT-LINE
044300         PERFORM WRITE-ITEM-LINE.
044400
044500 TYPE-EC-NW.
044600     ADD 1 TO KOUNT.
044700     MOVE NUM-PART TO ITEM-EC-NW(KOUNT).
044800     IF KOUNT = 4
044900         MOVE ITEM-LINE-2 TO PRINT-LINE
045000         PERFORM WRITE-ITEM-LINE.
044400
044500 TYPE-CO-PR.
044600     ADD 1 TO KOUNT.
044700     MOVE NUM-PART TO ITEM-CO-PR(KOUNT).
044800     IF KOUNT = 4
044900         MOVE ITEM-LINE-3 TO PRINT-LINE
045000         PERFORM WRITE-ITEM-LINE.
045100
045200 BAD-CODE-LISTING.
045300     MOVE "XX" TO CLASS-CODE.
045400     PERFORM PAGE-HDR.
045500
045600 BAD-LOOP.
045700     ADD 1 TO KOUNT.
045800     MOVE B-CODE(BAD-KOUNT-OUT) TO ITEM-EC-NW(KOUNT).
045900     IF KOUNT = 4
046000         MOVE ITEM-LINE-2 TO PRINT-LINE
046100         PERFORM WRITE-ITEM-LINE.
046200 BADONE.
046300     ADD 1 TO BAD-KOUNT.
046400     MOVE CODE-LINE TO B-CODE(BAD-KOUNT).
046500
       COPY OVRPFCALL IN COPYLIB.
046800
046900 WR-X.
047000     EXIT.
028100
028200*******************************************
028300*                                         *
028400*    I N P U T    P R O C E D U R E       *
028500*           FOR    MCLASS                 *
028600*******************************************
028700
028800 SORT-ACCT-CODES SECTION.
028900 SORT-ACCT-LOOP.
029000
029100*** SERIAL GET THRU MCLASS
029200
           READ MCLASS-I NEXT INTO BUF-MCLASS
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
030000             GO TO SAC-X
030100         ELSE
030200             MOVE "READ MCLASS *AL" TO BU-DISPLAY-MSG
030400             GO TO 2-BLOWUP.
030500
030600 DOES-ACCT-CODE-QUALIFY.
030700     MOVE MCLASS-CLS          TO SORT-MCLASS-CLS
030700     MOVE MCLASS-CLASS-DESCR  TO SORT-MCLASS-DESC.
030800
030900     RELEASE SORT-MCLASS-RCD.
031000
031100     GO TO SORT-ACCT-LOOP.
031200 SAC-X.
031300     EXIT.
031400
031500*******************************************
031600*                                         *
031700*    O U T P U T   P R O C E D U R E      *
031800*          FOR   MCLASS                   *
031900*******************************************
032000
032100 WRITE-ACCT-REPORT SECTION.
032200 WRITE-ACCT-RPT.
025600
032300     IF PAPER-IS-132-COLS
032400         NEXT SENTENCE
032500     ELSE
032600         WRITE PRINT-RCD FROM COMPRESS-PRINT AFTER ADVANCING 0.
032800     MOVE "N"    TO EOF-SW.
032800     MOVE SPACES TO ITEM-LINE-4.
           PERFORM MCLASS-PAGE-HDR.

032900 DO-AGAIN.
033000     PERFORM RETURN-MCLASS-RCD.
033100     IF EOF-SW = "Y"
033100         GO TO WAR-X.
033200     MOVE SORT-MCLASS-CLS   TO ITEM-AC.
033200     MOVE SORT-MCLASS-DESC  TO ITEM-DESC.
036500
036600     IF ITMS-PER-PAGE > 49
036600         PERFORM MCLASS-PAGE-HDR.
036600     IF ITEM-AC NOT = SPACES
033200         MOVE ITEM-LINE-4   TO PRINT-LINE
036700         PERFORM WRITE-MCLASS-LINE.
036800     GO TO DO-AGAIN.

038000 RETURN-MCLASS-RCD.
038100     RETURN SORT-MCLASS-FILE
038200         AT END MOVE "Y" TO EOF-SW.
038900
039000 WRITE-MCLASS-LINE.
039100     WRITE PRINT-RCD  AFTER ADVANCING 1 LINES.
039300     ADD 1 TO ITMS-PER-PAGE.
032800     MOVE SPACES TO ITEM-LINE-4.
039500
039600 MCLASS-PAGE-HDR.
039700     MOVE SPACES         TO PRINT-LINE.
039800     WRITE PRINT-RCD AFTER ADVANCING NEW-PAGE.
039900     ADD 1               TO PG-CTR.
040000     MOVE PG-CTR         TO PRT-OVER-PG.
040100     MOVE REPORT-HEADER          TO PRINT-RCD.
040200     WRITE PRINT-RCD AFTER  ADVANCING 1 LINES.
040100     MOVE HDR-AC                 TO PRINT-RCD.
040200     WRITE PRINT-RCD AFTER  ADVANCING 1 LINES.
040300     MOVE 0 TO ITMS-PER-PAGE.
039700     MOVE SPACES         TO PRINT-LINE.

       WAR-X.
038300     EXIT.
047100
047200 END-OF-PROGRAM SECTION.
047300 END-OF-PGM-PAR.
