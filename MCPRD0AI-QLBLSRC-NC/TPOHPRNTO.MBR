065600
065700
065800
065900******************************************************
066000**                                                  **
066100**   BLOWUP ROUTINE                                 **
066200**                                                  **
066300******************************************************
066400
066500 2-BLOWUP.
066600     MOVE "TPOHPRNT"              TO BU-PGM-NAME.
066700     CALL "TBLOWUP" USING BASE-STHIST, BU-PGM-NAME, STATUS-AREA,
066800         DUMMY-VIEW-AREA, DUMMY-KSAM-STAT, BU-DISPLAY-MSG,
066900             BU-DISPLAY-FLDS.
067000
067100
067200
067300 6-MAIN.
067400     OPEN INPUT PO-HISTORY-FILE.
067600     PERFORM 60-ACCEPT-OPTIONS.
067700
082000     MOVE HD-SPOOLER-NUMBER       TO  OVRPRTF-TOFILE-NUM.
           MOVE "*YES"                  TO  OVRPRTF-SHARED.
082100     MOVE HD-NO-OF-COPIES         TO  OVRPRTF-COPIES.
           PERFORM 996-OVERRIDE-PRINT-FILE.
067500     OPEN OUTPUT ONLINE-PRT.
067900
068000     MOVE "DHDRPT85.PUB"          TO HD-FILE-NAME.
068100     CALL "THDPRT2" USING HD-RET-CODE, HD-FILE-NAME, FNUM
068200          HD-ROUTE-DATA, ESC-NAME.
068300     IF HD-RET-CODE NOT = 0
068400         MOVE "THDPRT2 ERR 6-MAIN" TO BU-DISPLAY-MSG
068500         MOVE HD-RET-CODE       TO BU-DISPLAY-FLD (1)
068600         GO TO 2-BLOWUP.
068700
068800***********************************************************
068900**   IF PRINTING ON A CHARACTER PRINTER (HD-PAPER-FLAG   **
069000**   NOT = "X"), WE USE COMPRESSED PRINT TO FIT 132      **
069100**   CHARACTERS ON 8.5 IN WIDE PAPER.  ALSO, IF CP, WE   **
069200**   CHANGE THE TEXT LENGTH TO 61 LINES.                 **
069300***********************************************************
069400
069500     IF PAPER-IS-132-COLS
069600         NEXT SENTENCE
069700     ELSE
069800         WRITE PRT-REC FROM COMPRESS-PRINT AFTER ADVANCING 0.
069900
070000     PERFORM 70-PRINT-HEADINGS.
070100
070200     MOVE "N"                     TO END-OF-FILE-SW,
070300                                     PO-FOUND-SW.
070400     PERFORM 61-READ-PO-HISTORY-FILE  THRU 61-RPHF-X
070500         UNTIL END-OF-FILE-SW = "Y".
070600
070700     IF PO-FOUND-SW = "Y"
070800         NEXT SENTENCE
070900     ELSE
071000         WRITE PRT-REC FROM PO-NOT-FOUND-MSG1 AFTER 3
071100         WRITE PRT-REC FROM PO-NOT-FOUND-MSG2 AFTER 2
071200         WRITE PRT-REC FROM PO-NOT-FOUND-MSG3 AFTER 1.
071300
071400     IF PAPER-IS-132-COLS
071500         NEXT SENTENCE
071600     ELSE
071700         WRITE PRT-REC FROM NORMAL-PRINT AFTER ADVANCING 0.
071800
071900     CLOSE PO-HISTORY-FILE,
072000           ONLINE-PRT.
072100
072200 6-MAIN-X.
072300     EXIT.
072400
072500 60-ACCEPT-OPTIONS.
072700     DISPLAY "HD-ROUTE DATA = ", HD-ROUTE-DATA.
072800
072900******************************************************
073000**   ACCEPT THE PO NUMBER FOR PRINT REQUEST
073100******************************************************
073200
073300**** DISPLAY "ENTER PO NUMBER OF PRINT REQUEST 'xxxxxxxxxx'".
073400**** ACCEPT ACCEPT-PO-NUMBER.
           IF ACCEPT-PO-REL NOT NUMERIC
               MOVE "000" TO ACCEPT-PO-REL.
073500     DISPLAY "PO NUMBER REQUESTED IS ", ACCEPT-PO-NUMBER.
073600     MOVE ACCEPT-PO-NUM           TO PRT-PO-NUM-HDR.
073700     MOVE ACCEPT-PO-REL           TO PRT-PO-REL-HDR.
073800
073900
074000 61-READ-PO-HISTORY-FILE.
074100     READ PO-HISTORY-FILE
074200         AT END
074300             MOVE "Y"             TO END-OF-FILE-SW
074400             GO TO 61-RPHF-X.
074500
074600     IF ACCEPT-PO-NUMBER > PO-HIST-PO-REL
074700         NEXT SENTENCE
074800     ELSE
074900     IF ACCEPT-PO-NUMBER = PO-HIST-PO-REL
075000         PERFORM 611-PRINT-HISTORY-RECORD
075100     ELSE
075200         MOVE "Y"                 TO END-OF-FILE-SW.
075300
075400 61-RPHF-X.
075500     EXIT.
075600
075700
075800 70-PRINT-HEADINGS.
075900     ADD 1                        TO PAGE-CTR.
076000     MOVE PAGE-CTR                TO PRT-PAGE-NO.
076100     MOVE 1                       TO DATE-MODE.
076200     CALL "TDATECHK" USING DATE-CHECK-AREA.
076300     MOVE DATE-SLASH-OUT          TO PRT-DATE.
076400     MOVE DATE-FORMATTED-TIME-OUT TO PRT-TIME.
076500     MOVE ZEROS                   TO LINE-CTR.
076600     WRITE PRT-REC FROM HEADER1 AFTER ADVANCING NEW-PAGE.
076700     WRITE PRT-REC FROM DASH-LINE AFTER 2.
076800     MOVE SPACES                  TO PRT-REC.
076900     WRITE PRT-REC AFTER 1.
077000
077100
077200 611-PRINT-HISTORY-RECORD.
077300     MOVE "Y"                     TO PO-FOUND-SW.
077400     MOVE PO-HIST-PO-NUM          TO BU-DISPLAY-FLD (1).
077500     MOVE PO-HIST-DSET-NAME       TO BU-DISPLAY-FLD (2).
077600
