000600     KURT MOVSESIAN.
000700*REMARKS.
000800*
000900**************************************************************
001000*                                                            *
001100*   T I N V T C        THIS PROGRAMS CREATES INVOICE         *
001200*     TRANSACTIONS '490' AND '492' AND IS EXECUTED IN THE    *
001300*     MANIFEST JOB WHENEVER A RELEASE IS DONE.  THE          *
001400*     TRANACTIONS ARE PUT INTO THE 'DDAILYTC' DATA SET       *
001500*     AND ARE SENT UP WITH ALL THE OTHER 'CSIS' TRANACTIONS  *
001600*                                                            *
001700*     THIS PROGRAM IS EXECUTED IN THE TEMPORARY JOB STREAM   *
001800*     'BXMANJOB.PUB' WHICH IS CREATED BY 'TINVMAN'           *
001900*                                                            *
002000*     FILE DEFINITIONS (INPUTS/OUTPUTS)                      *
002100*        1) MANSTFLnn- THE LOCAL STORES FILE USED BY THE SUB *
002200*                     PLANTS FOR THEIR LOCAL STORES ACCTG.   *
002300*                     SYSTEMS.  THIS FILE IS ONLY CREATED    *
002400*                     WHEN THE 'RLSE' MANIFEST OPTION IS     *
002500*                     SELECTED.                              *
002600*                                                            *
002700**************************************************************
      *C  JUNE 23, 1994   CR KALMAN
      *C   ADDED CALL TO COBOL ERROR HANDLER -MCXCBLERR.
      *C
      *C  JULY 3, 1996    CA YODER
      *C   RE-COMPILED TO PICK UP CENTURY DATABASE CHANGES.
002800
002900
003000 ENVIRONMENT DIVISION.
003100 CONFIGURATION SECTION.
003200 SOURCE-COMPUTER.  IBM-AS400.
003300 OBJECT-COMPUTER.  IBM-AS400.
012800
012900 INPUT-OUTPUT SECTION.
       FILE-CONTROL.
007500     SELECT MAN-STORES-FILE
                  ASSIGN TO DATABASE-MANSTR.

           SELECT DINVRCD-I
                  ASSIGN TO DATABASE-MCFLCS2501
                  ORGANIZATION IS INDEXED
                    ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                    WITH DUPLICATES
                  FILE STATUS IS FILE-STATUS.

           SELECT DDAILYTC-O
                  ASSIGN TO DATABASE-MCFLCS1601
                  ORGANIZATION IS INDEXED
                    ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                    WITH DUPLICATES
                  FILE STATUS IS FILE-STATUS.

           SELECT MPLTINFO-I
                  ASSIGN TO DATABASE-MCFLCS0501
                  ORGANIZATION IS INDEXED
                    ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                  FILE STATUS IS FILE-STATUS.

       DATA DIVISION.
       FILE SECTION.

       FD  MPLTINFO-I
           LABEL RECORDS ARE STANDARD.
       01  MPLTINFO-I-REC.
           COPY DDS-ALL-FORMATS  OF MCFLCS0501.

       FD  DINVRCD-I
           LABEL RECORDS ARE STANDARD.
       01  DINVRCD-I-REC.
           COPY DDS-ALL-FORMATS OF MCFLCS2501.

       FD  DDAILYTC-O
           LABEL RECORDS ARE STANDARD.
       01  DDAILYTC-O-REC.
           COPY DDS-ALL-FORMATS OF MCFLCS1601.

004200 FD  MAN-STORES-FILE
004300     LABEL RECORDS ARE OMITTED
004400     RECORD CONTAINS 80 CHARACTERS
004500     DATA RECORDS ARE STORES-ID1-RCD,
004600                      STORES-ID5-RCD.
004700 01  STORES-ID1-RCD.
004800     05  RECORD-ID1            PIC X.
004900     05  STORES-REG-NO-ID1     PIC X(5).
005000     05  STORES-INVOICE-TYPE   PIC X.
005100     05  STORES-PO-NUMBER      PIC X(10).
005200     05  STORES-VENDOR-CODE    PIC X(7).
005300     05  STORES-BUDGT-NO       PIC X(12).
005400     05  STORES-DIST-COST      PIC S9(8)V99.
005500     05  STORES-DISCOUNT       PIC S9(8)V99.
005600     05  STORES-TERMS          PIC X(2).
005700     05  STORES-TOTAL-TAX      PIC S9(8)V99.
005800     05  STORES-TAX-CODE       PIC X(2).
005900     05  STORES-NO-CHECK       PIC X.
006000     05  FILLER                PIC X(9).
006100 01  STORES-ID5-RCD.
006200     05  RECORD-ID5            PIC X.
006300     05  STORES-REG-NO-ID5     PIC X(5).
006400     05  STORES-CORP-CODE      PIC X(7).
006500     05  STORES-CLASS          PIC X(3).
006600     05  STORES-ITEM-NO        PIC 9(3).
006700     05  STORES-QTY            PIC S9(8)V99.
006800     05  STORES-UM             PIC X(2).
006900     05  STORES-VALUE          PIC S9(8)V99.
007000     05  STORES-ITM-FRT        PIC S9(8)V99.
007100     05  STORES-ITM-TAX        PIC S9(8)V99.
007200     05  STORES-ITM-ACCOUNTING.
007300         10  STORES-PRIME      PIC X(3).
007400         10  STORES-SUB        PIC X(3).
007500         10  STORES-SUBD       PIC X(4).
007600         10  STORES-ADDL-DATA  PIC X(6).
007700     05  STORES-ITM-MEMO-INDIC PIC X.
007800     05  FILLER                PIC X(2).
007900
008000
008100 WORKING-STORAGE SECTION.
008200 77  COMPANY-SAVE                 PIC X(3)  VALUE SPACES.
008300 77  TOTAL-ITEM-CHARGES           PIC S9(11)V9(2) VALUE ZEROS.
008400 77  TOTAL-ITEM-QTY               PIC S9(8)V9(2)  VALUE ZEROS.
008500 77  DDAILYTC-TC-CTR              PIC S9(4) COMP-4  VALUE ZEROS.
9406CK 01  SCOPE   PIC X.
008600
008700 01  SAVE-ITEM-DATA.
008800     05  SAVE-ITEM-NO             PIC 9(4)       VALUE ZEROS.
008900     05  SAVE-CORP-CODE           PIC X(7)       VALUE SPACES.
009000     05  SAVE-ITEM-QTY-UM         PIC X(2)       VALUE SPACES.
009100
009200**************************************
009300*                                    *
009400*   SWITCHES                         *
009500*                                    *
009600**************************************
009700
009800 01  SWITCH-AREA.
009900     05  PREVIOUS-ITEM-SW         PIC X     VALUE "N".
010000     05  DDAILYTC-LOCKED-SW       PIC X     VALUE "N".
010100         88  DDAILYTC-LOCKED                VALUE "Y".
010200
010300
010400 01  COMMAND-AREA.
           05  QCMDEXC-MANSTR.
               10  OVRDBF-MANSTR      PIC X(70) VALUE SPACES.
               10  DBF-MANSTR-PARM2 PIC S9(10)V9(5) COMP-3 VALUE 70.
       COPY CCHKOBJ  IN COPYLIB.
       COPY CCRTFILE IN COPYLIB.

       01  MAN-STR-LIT.
           05  FILLER                 PIC X(6)  VALUE "MANSTR".
           05  MAN-STR-FILE-NO        PIC 99    VALUE ZEROS.

012800**************************************************************
012900**************************************************************
