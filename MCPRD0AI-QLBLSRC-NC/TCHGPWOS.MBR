       IDENTIFICATION DIVISION.
       PROGRAM-ID. TCHGPWOS.
       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.
       SOURCE-COMPUTER. AS400.
       OBJECT-COMPUTER. AS400.
       COPY SPECIALN OF COPYLIB.
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT DISPLAY-FILE
               ASSIGN TO WORKSTATION-ZCHGPWOS-SI
               ORGANIZATION IS TRANSACTION
               ACCESS IS SEQUENTIAL
               FILE STATUS IS DSPLY-STATUS
               CONTROL-AREA IS WS-CONTROL.

           SELECT ONLINE-PRT ASSIGN TO PRINTER-MCPRT.

           SELECT WO-PLANNED-FILE1
               ASSIGN TO DATABASE-MCFLMM1101
               ORGANIZATION IS INDEXED
               ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
               FILE STATUS IS WPF1-STATUS.

           SELECT WO-PLANNED-FILE2
               ASSIGN TO DATABASE-MCFLMM1102
               ORGANIZATION IS INDEXED
               ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                   WITH DUPLICATES
               FILE STATUS IS WPF2-STATUS.
       DATA DIVISION.
       FILE SECTION.
       FD  DISPLAY-FILE
           LABEL RECORDS ARE OMITTED.
       01  DSPLY-REC             PIC X(2000).

       FD  ONLINE-PRT
           LABEL RECORDS ARE OMITTED
           RECORD CONTAINS 132 CHARACTERS
           DATA RECORD IS PRINT-RCD.
       01  PRINT-RCD.
           05  PRINT-LINE        PIC X(132).

       FD  WO-PLANNED-FILE1
           LABEL RECORDS ARE STANDARD
           DATA RECORD IS WPF1REC.
       01  WPF1REC.
           COPY DDS-ALL-FORMATS OF MCFLMM1101.

       FD  WO-PLANNED-FILE2
           LABEL RECORDS ARE STANDARD
           DATA RECORD IS WPF2REC.
       01  WPF2REC.
           COPY DDS-ALL-FORMATS OF MCFLMM1102.
       WORKING-STORAGE SECTION.
       77  DISP-SUB              PIC 9(4).
       77  LINE-CTR              PIC 99   VALUE 59.
       77  SUB                   PIC S9(4) COMP.
       01  ARG-CW                PIC XX VALUE "CW".

       COPY CPYIND   IN COPYLIB.

       01  CURRENT-DATE-WA.
           05  CD-Y              PIC 99.
           05  CD-M              PIC 99.
           05  CD-D              PIC 99.

       01  CURRENT-TIME.
           05  CUR-TIME          PIC X(4).
           05  FILLER            PIC 99.

       01  DBPARAMETERS.        COPY DBPARMS OF COPYLIB.

       01  DSPLY-STATUS          PIC XX.

       01  HDR-0.
           05  FILLER            PIC X(35)
               VALUE "WORK ORDERS MOVED FROM 'CW' TO 'DW'".
           05  FILLER            PIC X(45) VALUE SPACES.

       01  HDR-1.
           05  FILLER            PIC X(80) VALUE ALL "_".

       01  INPUT-BUFFER.
           05  INPUT-ZONE        PIC X(4).
           05  INPUT-EQPNUM      PIC X(6).
           05  INPUT-YEAR        PIC X.
           05  INPUT-CMD-LINE    PIC X(79).
           05  INPUT-ERR-LINE    PIC X(79).

       01  INPUT-BUFFER2.
           05  INPUT-CTR2        PIC X(6).
           05  INPUT-DELSW2      PIC X.
           05  INPUT-CMD-LINE2   PIC X(79).
           05  INPUT-ERR-LINE2   PIC X(79).

       COPY IOFEEDBACK IN COPYLIB.

       COPY OVRPFDATA  IN COPYLIB.

       01  PUT-ERR-MSG.
           05  FILLER  PIC X(22) VALUE "COULD NOT PUT W/O # = ".
           05  PUT-WO  PIC X(10) VALUE SPACES.
           05  FILLER  PIC X(13) VALUE " ERROR WAS = ".
           05  PUT-CWORD PIC -9(4).
           05  FILLER  PIC X(30) VALUE SPACES.

       01  READD-MSG.
           05  FILLER  PIC X(6)  VALUE "W/O # ".
           05  R-WO    PIC X(10) VALUE SPACES.
           05  FILLER  PIC X(63) VALUE " WAS MOVED TO 'DW' STATUS ".

           COPY DBSTAT  OF COPYLIB.

       01  WPF1-STATUS           PIC XX.
       01  WPF2-STATUS           PIC XX.

       01  WO-PLANNED-DATA.     COPY DWOPLAN OF COPYLIB.

       01  WO-TABLE.
           05  WO-NOS OCCURS 5000 TIMES   PIC X(10).

       COPY VCOMLINK   IN COPYLIB.

       COPY WSCONTROL  IN COPYLIB.
       PROCEDURE DIVISION.
       START-PGM.
           PERFORM 1-HSK.
           PERFORM 6-MAIN THRU 6-M-X.
       2-EOJ.
           CLOSE DISPLAY-FILE.
           CLOSE WO-PLANNED-FILE1, WO-PLANNED-FILE2.
           CLOSE ONLINE-PRT.
           GOBACK.
       1-HSK.
           OPEN I-O    DISPLAY-FILE.
           OPEN I-O    WO-PLANNED-FILE1.
           OPEN INPUT  WO-PLANNED-FILE2.
           MOVE "MCPRT"       TO OVRPRTF-FILE.
           PERFORM 996-OVERRIDE-PRINT-FILE
           OPEN OUTPUT ONLINE-PRT.
           MOVE SPACES        TO WO-PLANNED-DATA WO-TABLE.
           MOVE 0             TO SUB.
           ACCEPT CURRENT-TIME FROM TIME.
           ACCEPT CURRENT-DATE-WA FROM DATE.
           MOVE SPACES        TO INPUT-BUFFER.
           MOVE 59            TO LINE-CTR.
       6-MAIN.
           MOVE "FCHGPWOS"    TO VIEW-CFNAME.
           MOVE INPUT-BUFFER  TO DSPLY-REC.
           PERFORM 99-SCREEN-WRITE.
           PERFORM 98-SCREEN-READ.
           IF VIEW-LASTKEY = 3 GO TO 2-EOJ.
           MOVE DSPLY-REC     TO INPUT-BUFFER.
           MOVE SPACES        TO INPUT-ERR-LINE.
           IF INPUT-ZONE = "    "
               IF INPUT-EQPNUM = "      "
                   IF INPUT-YEAR = " "
                       MOVE "AT LEAST ONE SELECTION MUST BE MADE"
                           TO INPUT-ERR-LINE
                       MOVE B"1" TO INDS (99)
                       GO TO 6-MAIN.
           PERFORM 60-FIND-QUALIFIED-WOS THRU 60-FQW-EXIT.
           IF INPUT-ERR-LINE NOT = SPACES GO TO 6-MAIN.
           MOVE "FCHGPWO2" TO VIEW-CFNAME.
           MOVE SUB TO INPUT-CTR2.
           MOVE 0 TO SUB.
           MOVE "N" TO INPUT-DELSW2.
           MOVE INPUT-BUFFER2 TO DSPLY-REC.
           PERFORM 99-SCREEN-WRITE.
           PERFORM 98-SCREEN-READ.
           MOVE DSPLY-REC TO INPUT-BUFFER2.
           IF (INPUT-DELSW2) = "N" OR (VIEW-LASTKEY = 3)
               PERFORM 6-PRINT-WOS THRU 6-PW-X
                   VARYING SUB FROM 1 BY 1 UNTIL SUB > 5000
           ELSE
           PERFORM 61-RETRIEVE-AND-MOVE-WOS THRU 61-RAMW-EXIT.

       6-M-X.    EXIT.

       6-PRINT-WOS.
           IF WO-NOS (SUB) = "          "
               MOVE 5001 TO SUB
               GO TO 6-PW-X
           ELSE
           ADD 1 TO LINE-CTR
           IF LINE-CTR > 59
               STRING "W/O'S WHICH ARE CANDIDATES TO BE MOVED TO 'DW'"
                   DELIMITED BY SIZE INTO PRINT-RCD
               WRITE PRINT-RCD AFTER ADVANCING NEW-PAGE
               WRITE PRINT-RCD FROM HDR-1 AFTER ADVANCING 1
               MOVE SPACES TO PRINT-RCD
               STRING WO-NOS (SUB), " WAS SELECTED TO BE MOVED ",
                   "FROM 'CW' TO 'DW' STATUS",
                   DELIMITED BY SIZE INTO PRINT-RCD
               WRITE PRINT-RCD AFTER ADVANCING 1
               MOVE 3 TO LINE-CTR
           ELSE
           MOVE SPACES TO PRINT-RCD
           STRING WO-NOS (SUB), " WAS SELECTED TO BE MOVED ",
               "FROM 'CW' TO 'DW' STATUS",
               DELIMITED BY SIZE INTO PRINT-RCD
           WRITE PRINT-RCD AFTER ADVANCING 1.
       6-PW-X.    EXIT.

       60-FIND-QUALIFIED-WOS.
           MOVE 0 TO COND-WORD.
           MOVE ARG-CW TO WOSTATUS OF WPF2REC.
           START WO-PLANNED-FILE2 KEY = EXTERNALLY-DESCRIBED-KEY
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF WPF2-STATUS NOT = "00" MOVE 17 TO COND-WORD.
           IF COND-WORD NOT = 0
               MOVE "NO CW STATUS PLANNED W/O'S EXIST IN DATABASE"
                  TO INPUT-ERR-LINE
               MOVE B"1" TO INDS (99)
               GO TO 60-FQW-EXIT.
       60-FQW-CONT.
           MOVE 0 TO COND-WORD.
           READ WO-PLANNED-FILE2 NEXT INTO WO-PLANNED-DATA
               AT END    MOVE 15 TO COND-WORD.
           IF WO-STATUS-P NOT = ARG-CW MOVE 15 TO COND-WORD.
           IF WPF2-STATUS NOT = "00" MOVE 15 TO COND-WORD.
           IF COND-WORD = 15
               IF SUB = 0
                 MOVE "NO CW STATUS PLANNED W/O'S EXIST IN DATABASE"
                    TO INPUT-ERR-LINE
                 MOVE B"1" TO INDS (99)
                 GO TO 60-FQW-EXIT
               ELSE
               GO TO 60-FQW-EXIT.

           IF INPUT-ZONE = "    "
               IF INPUT-EQPNUM = "      "
                   IF INPUT-YEAR = WO-NUM-P-7
                       NEXT SENTENCE
                   ELSE
                   GO TO 60-FQW-CONT
               ELSE
               IF INPUT-EQPNUM = EQUIP-NUM-P
                   IF INPUT-YEAR = " " OR WO-NUM-P-7
                       NEXT SENTENCE
                   ELSE
                   GO TO 60-FQW-CONT
               ELSE
               GO TO 60-FQW-CONT
           ELSE
           IF INPUT-ZONE = ZONE-P
               IF INPUT-EQPNUM = "      " OR EQUIP-NUM-P
                   IF INPUT-YEAR = " " OR WO-NUM-P-7
                       NEXT SENTENCE
                   ELSE
                   GO TO 60-FQW-CONT
               ELSE
               GO TO 60-FQW-CONT
           ELSE
           GO TO 60-FQW-CONT.

           ADD 1 TO SUB.
           IF SUB > 5000 GO TO 60-FQW-EXIT.
           MOVE WO-NUM-PLANNED TO WO-NOS (SUB).
           GO TO 60-FQW-CONT.

       60-FQW-EXIT.    EXIT.

       61-RETRIEVE-AND-MOVE-WOS.
           ADD 1 TO SUB.
           IF SUB > 5000
               DISPLAY "5000 TABLE ENTRIES WERE PROCESSED"
               GO TO 61-RAMW-EXIT
           ELSE
           IF WO-NOS (SUB) = SPACES
               SUBTRACT 1 FROM SUB
               MOVE SUB TO DISP-SUB
      *        DISPLAY DISP-SUB " TABLE ENTRIES WERE PROCESSED"
               GO TO 61-RAMW-EXIT.
           MOVE 0 TO COND-WORD.
           MOVE WO-NOS (SUB) TO WONUM OF WPF1REC.
           START WO-PLANNED-FILE1 KEY = EXTERNALLY-DESCRIBED-KEY
               INVALID KEY   MOVE 17 TO COND-WORD.
           IF WPF1-STATUS NOT = "00" MOVE 17 TO COND-WORD.
           IF COND-WORD NOT = 0
               DISPLAY "COULD NOT FIND W/O = " WO-NOS (SUB)
               GO TO 61-RETRIEVE-AND-MOVE-WOS.
       61-RAMW-CONT.
           MOVE 0 TO COND-WORD.
           READ WO-PLANNED-FILE1 NEXT INTO WO-PLANNED-DATA
               AT END    MOVE 15 TO COND-WORD.
           IF WONUM OF WPF1REC NOT = WO-NOS (SUB) MOVE 15 TO COND-WORD.
           IF WPF1-STATUS NOT = "00" MOVE 15 TO COND-WORD.
           IF COND-WORD = 15 GO TO 61-RETRIEVE-AND-MOVE-WOS.
           IF DATE-COMP-P = "      "
               MOVE CD-Y TO DATE-COMP-P-YY
               MOVE CD-M TO DATE-COMP-P-MM
               MOVE CD-D TO DATE-COMP-P-DD
               MOVE CUR-TIME TO TIME-COMP-P.
           IF TIME-COMP-P = "    "
               MOVE CUR-TIME TO TIME-COMP-P.
           MOVE "DW" TO WO-STATUS-P.
           REWRITE WPF1REC FROM WO-PLANNED-DATA
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF WPF1-STATUS NOT = "00" MOVE 17 TO COND-WORD.
           IF COND-WORD NOT = 0
               MOVE WO-NUM-PLANNED TO PUT-WO
               MOVE COND-WORD TO PUT-CWORD
               DISPLAY PUT-ERR-MSG
               GO TO 61-RETRIEVE-AND-MOVE-WOS
           ELSE
           MOVE WO-NUM-PLANNED TO R-WO
           ADD 1 TO LINE-CTR
           IF LINE-CTR > 59
               WRITE PRINT-RCD FROM HDR-0 AFTER ADVANCING NEW-PAGE
               WRITE PRINT-RCD FROM HDR-1 AFTER ADVANCING 1
               MOVE SPACES TO PRINT-RCD
               WRITE PRINT-RCD FROM READD-MSG AFTER ADVANCING 1
               MOVE 3 TO LINE-CTR
           ELSE
           WRITE PRINT-RCD FROM READD-MSG AFTER ADVANCING 1.
           GO TO 61-RETRIEVE-AND-MOVE-WOS.

       61-RAMW-EXIT.    EXIT.

       98-SCREEN-READ.
           READ DISPLAY-FILE FORMAT IS VIEW-CFNAME
               INDIC IS INDICS.
           ACCEPT IOFEEDBACK FROM I-O-FEEDBACK-AREA.
           MOVE ALL B"0" TO INDICS.
           IF DSPLY-STATUS NOT = "00"
               MOVE 3 TO VIEW-LASTKEY
           ELSE
           MOVE FUNCTION-NUM TO VIEW-LASTKEY.

       98A-SCREEN-READ.
           READ DISPLAY-FILE TERMINAL IS TERMINAL-ID
               INDIC IS INDICS
                  NO DATA MOVE DSPLY-STATUS TO DSPLY-STATUS.
           MOVE ALL B"0" TO INDICS.

       99-SCREEN-WRITE.
           WRITE DSPLY-REC FORMAT IS VIEW-CFNAME
               INDIC IS INDICS.
           MOVE ALL B"0" TO INDICS.

       COPY OVRPFCALL IN COPYLIB.
