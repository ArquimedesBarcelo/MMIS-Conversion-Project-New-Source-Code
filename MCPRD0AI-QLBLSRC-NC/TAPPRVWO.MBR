       IDENTIFICATION DIVISION.
       PROGRAM-ID. TAPPRVWO.
       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.
       SOURCE-COMPUTER.   AS400.
       OBJECT-COMPUTER.   AS400.
       SPECIAL-NAMES.     LOCAL-DATA IS LOCAL-DATA-AREA
                          I-O-FEEDBACK IS I-O-FEEDBACK-AREA.
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT DISPLAY-FILE
               ASSIGN TO WORKSTATION-ZOFFLINE-SI
               ORGANIZATION IS TRANSACTION
               ACCESS IS SEQUENTIAL
               FILE STATUS IS DSPLY-STATUS
               CONTROL-AREA IS WS-CONTROL.
           SELECT MPLTINFO-FILE
               ASSIGN TO DATABASE-MCFLCS0501
               ORGANIZATION IS INDEXED
               ACCESS IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
               FILE STATUS IS MF-STATUS.
           SELECT WO-BASIC-FILE
               ASSIGN TO DATABASE-MCFLMM1001
               ORGANIZATION IS INDEXED
               ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                   WITH DUPLICATES
               FILE STATUS IS WBF-STATUS.
           SELECT WO-LAST-NUM-USED
               ASSIGN TO DATABASE-MCFPMM0800
               ORGANIZATION IS RELATIVE
               ACCESS MODE IS RANDOM
               RELATIVE KEY IS ARG-NO
               FILE STATUS IS WLNU-STATUS.
           SELECT WO-PARTS-FILE
               ASSIGN TO DATABASE-MCFLMM1201
               ORGANIZATION IS INDEXED
               ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                   WITH DUPLICATES
               FILE STATUS IS WPFD-STATUS.
           SELECT WO-PARTS-FILE-PF
               ASSIGN TO DATABASE-MCFPMM1200
               ORGANIZATION IS RELATIVE
               ACCESS MODE IS RANDOM
               RELATIVE KEY IS PFKEY
               FILE STATUS IS WPFDP-STATUS.
           SELECT WO-PLANNED-FILE
               ASSIGN TO DATABASE-MCFLMM1101
               ORGANIZATION IS INDEXED
               ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                   WITH DUPLICATES
               FILE STATUS IS WPF-STATUS.
       DATA DIVISION.
       FILE SECTION.
       FD  DISPLAY-FILE
           LABEL RECORDS ARE OMITTED.
       01  DSPLY-REC                   PIC X(2000).
       FD  MPLTINFO-FILE
           LABEL RECORDS ARE STANDARD
           DATA RECORD IS MFREC.
       01  MFREC.
           COPY DDS-ALL-FORMATS OF MCFLCS0501.
       FD  WO-BASIC-FILE
           LABEL RECORDS ARE STANDARD
           DATA RECORD IS WBFREC.
       01  WBFREC.
           COPY DDS-ALL-FORMATS OF MCFLMM1001.
       FD  WO-LAST-NUM-USED
           LABEL RECORDS ARE STANDARD
           DATA RECORD IS WLNUREC.
       01  WLNUREC.
           COPY DDS-ALL-FORMATS OF MCFPMM0800.
       FD  WO-PARTS-FILE
           LABEL RECORDS ARE STANDARD
           DATA RECORD IS WPFDREC.
       01  WPFDREC.
           COPY DDS-ALL-FORMATS OF MCFLMM1201.
       FD  WO-PARTS-FILE-PF
           LABEL RECORDS ARE STANDARD
           DATA RECORD IS WPFDPREC.
       01  WPFDPREC.
           COPY DDS-ALL-FORMATS OF MCFPMM1200.
       FD  WO-PLANNED-FILE
           LABEL RECORDS ARE STANDARD
           DATA RECORD IS WPFREC.
       01  WPFREC.
           COPY DDS-ALL-FORMATS OF MCFLMM1101.
       WORKING-STORAGE SECTION.
       77  PRT-SEQ                     PIC 9(4).
       77  REQS-CUT-SW                 PIC 9.
       77  SAVE-LAST-SUFFIX-INIT       PIC X(4).
       77  SUB                         PIC S9(4) COMP-4.
       77  WS-SW                       PIC 9.
       77  YR-SAVE                     PIC X.
       01  ARG-NO                      PIC 9(9).
       01  BASE-BG                     PIC X(24).
       01  BASE-DUMMY                  PIC X(24).
       01  BASE-MMISA                  PIC X(24).
       01  BLOWUP-BASE                 PIC X(16).
       COPY CATREAD IN COPYLIB.
       COPY CEAWOAP IN COPYLIB.
       COPY CMANREQ IN COPYLIB.
       COPY CPYIND  IN COPYLIB.
       01  CUR-DATE-BUFFER.
           05  FILLER                  PIC X.
           05  C-D-YDIG                PIC X.
           05  FILLER                  PIC X(4).
       01  DBPARAMETERS.            COPY DBPARMS     OF COPYLIB.
       01  ERROR-BUFFER.
           05  ERROR-A.
               10  ERROR-76            PIC X(76).
               10  FILLER              PIC XXXX.
           05  ERROR-B REDEFINES ERROR-A.
               10  FILLER              PIC X(74).
               10  ERROR-DELAY         PIC X(6).
           05  ERROR-C REDEFINES ERROR-A.
               10  FILLER              PIC X(12).
               10  ERR-WO              PIC X(10).
               10  FILLER              PIC X(58).
       01  ERROR-SWITCH                PIC S9(4) COMP.
       01  ESTIMATE-FIELDS.
           05  P-WONUM                 PIC X(10).
           05  LABOR-ESTIMATE          PIC 9(16).
           05  STORE-ESTIMATE          PIC 9(16).
           05  PURCH-ESTIMATE          PIC 9(16).
       COPY ESCNAM2 IN COPYLIB.
       01  FILE-STATUSES.
           05  BMF-STATUS              PIC XX.
           05  BMR-STATUS              PIC XX.
           05  DSPLY-STATUS            PIC XX.
           05  MF-STATUS               PIC XX.
           05  PWB-STATUS              PIC XX.
           05  WBF-STATUS              PIC XX.
           05  WLNU-STATUS             PIC XX.
           05  WPF-STATUS              PIC XX.
           05  WPFD-STATUS             PIC XX.
           05  WPFDP-STATUS            PIC XX.
       COPY IOFEEDBACK OF COPYLIB.
       COPY JCWAREA  IN COPYLIB.
       COPY LANGSUB  IN COPYLIB.
       01  LAST-WO-BUFF.            COPY MLASTWO  OF COPYLIB.
       COPY MPLT0    IN COPYLIB.
       COPY MPLTRQGB IN COPYLIB.
       01  MPLTINFO-ARG                PIC X(4).
       01  PASSED-BASE                 PIC X(10).
       01  PASS-COMP                   PIC X(4).
       01  PASSED-SPOOL-PRT            PIC S99 COMP.
       01  PASSWORD-INFORMATION.
           05  NAME-OF-PROGRAM     PIC X(08) VALUE "TAPPRVWO".
           05  PROGRAM-TYPE        PIC X(02) VALUE "UP".
           05  PROGRAM-RELEASE     PIC X(12) VALUE " E0100010001".
           05  PROGRAM-DESCRIPTION.
               10  PROG-DESC-A.
                   15  FILLER      PIC X(13) VALUE " PLANNED W/O ".
                   15  FILLER      PIC X(16) VALUE "APPROVAL PROGRAM".
                   15  FILLER      PIC X(31) VALUE SPACES.
               10  PROG-DESC-B     PIC X(60) VALUE SPACES.
               10  PROG-FUNCTION   PIC X(60) VALUE SPACES.
           05  PASSWORD-FLAG       PIC X.
       01  PFKEY                   PIC 9(9).
       01  READD-MSG.
           05  FILLER  PIC X(6)  VALUE "W/O # ".
           05  R-WO    PIC X(10) VALUE SPACES.
           05  FILLER  PIC X(63) VALUE " HAS BEEN APPROVED ".
       COPY REQGLOB IN COPYLIB.
       01  REQ-ISSUED-MSG.
           05  FILLER  PIC X(20) VALUE SPACES.
           05  REQ-ISS PIC X(12) VALUE SPACES.
           05  FILLER  PIC X(23) VALUE SPACES.
           05  REQU-WO PIC X(10) VALUE SPACES.
           05  FILLER  PIC X(14) VALUE SPACES.
       01  RET-CODE                    PIC XX.
       01  RETURN-ERROR.
           05  ERROR-TEXT              PIC X(68).
           05  ERROR-NUM               PIC 9(8).
       01  SCREEN-PRINT-PARMS.
           05  PRINTCNTL               PIC S9(4) VALUE ZERO  COMP.
           05  PAGECNTL                PIC S9(4) VALUE 49    COMP.
           05  SPOOLFIL-OPEN-SW        PIC X   VALUE "N".
       01  SAVE-REC-NO                 PIC 9(9).
       01  START-KEY-PARTS             PIC X(10).
       COPY DBSTAT   IN COPYLIB.
       01  SUFF-WO.
           05  SUFF-WO-1-7             PIC X(7).
           05  SUFF-SUFF               PIC XXX.
           05  SUFF-SUFF-9 REDEFINES SUFF-SUFF  PIC 999.
       COPY TBLOWUP  IN COPYLIB.
       01  TRUE-VAL                    PIC 1 VALUE B"1".
       COPY VCOMLINK IN COPYLIB.
       01  WO-BASIC-DATA.           COPY DWOBASIC OF COPYLIB.
       01  WO-NUM-BUFFER.
           05  WO-NUMB OCCURS 24 TIMES.
               10  WO-NUMB-1-6         PIC X(6).
               10  WO-NUMB-7           PIC X.
               10  WO-NUMB-8-10        PIC XXX.
           05  WO-NUM-CMD-LINE         PIC X(79).
           05  WO-NUM-ERR-LINE         PIC X(79).
       01  WO-NUMBER                   PIC X(10).
       01  WO-PARTS-DATA.           COPY DWOPARTS OF COPYLIB.
       01  WO-PLANNED-DATA.         COPY DWOPLAN  OF COPYLIB.
       01  WO-PLANNED-DATA3.
           05  FILLER                  PIC X(26).
           05  WO-APPROVAL-P3          PIC X.
           05  FILLER                  PIC X(817).
       COPY WSCONTROL IN COPYLIB.
       PROCEDURE DIVISION.
       START-PGM.
           PERFORM 1-HSK.
           PERFORM 6-MAIN THRU 6-MAIN-EXIT.
       2-EOJ.
           CLOSE DISPLAY-FILE.
           CLOSE MPLTINFO-FILE.
           CLOSE WO-BASIC-FILE.
           CLOSE WO-LAST-NUM-USED.
           CLOSE WO-PARTS-FILE.
           CLOSE WO-PARTS-FILE-PF.
           CLOSE WO-PLANNED-FILE.
           GOBACK.
       1-HSK.
           OPEN I-O   DISPLAY-FILE.
           OPEN INPUT MPLTINFO-FILE.
           OPEN INPUT WO-BASIC-FILE.
           OPEN INPUT WO-LAST-NUM-USED.
           OPEN I-O   WO-PARTS-FILE.
           OPEN I-O   WO-PARTS-FILE-PF.
           OPEN I-O   WO-PLANNED-FILE.
           MOVE LOW-VALUES TO STATUS-AREA VIEW-COMAREA.
           MOVE 1 TO ARG-NO.
           MOVE 0 TO COND-WORD.
           READ WO-LAST-NUM-USED INTO LAST-WO-BUFF
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF WLNU-STATUS NOT = "00" MOVE 17 TO COND-WORD.
           IF COND-WORD = 17 MOVE 1 TO DATE-FLAG-SW.
           MOVE DATE-FLAG-SW TO DATE-FLAG.
           CALL "TPWORD" USING PASSWORD-INFORMATION.
           IF PASSWORD-FLAG = "N"
               MOVE "  PWORD" TO BLOWUP-BASE
               MOVE "FAILED PASSWORD CHECK - TAPPRVWO"
                   TO BU-DISPLAY-MSG
               PERFORM 998-BLOWUP.
           MOVE PLANT-IDENT TO PASS-COMP.
           PERFORM 69-START-MPLTINFO-FILE.
           IF COND-WORD = 17
               MOVE "Y" TO MPLT-PRINT-WO-REQPK
               MOVE "N" TO MPLT-WOAP-TO-CUT-REQ
               MOVE "N" TO MPLT-WOAP-TO-APP-REQ
               MOVE MPLTINFO-RQGB TO REQ-GLOBALS
           ELSE
           PERFORM 69-READ-MPLTINFO-FILE
           IF COND-WORD = 15
               MOVE "Y" TO MPLT-PRINT-WO-REQPK
               MOVE "N" TO MPLT-WOAP-TO-CUT-REQ
               MOVE "N" TO MPLT-WOAP-TO-APP-REQ
               MOVE MPLTINFO-RQGB TO REQ-GLOBALS
           ELSE
           MOVE MPLTINFO-RQGB TO REQ-GLOBALS.
           ACCEPT CUR-DATE-BUFFER FROM DATE.
           IF C-D-YDIG = 0
               MOVE "A" TO YR-SAVE
           ELSE
           IF C-D-YDIG = 1
               MOVE "B" TO YR-SAVE
           ELSE
           IF C-D-YDIG = 2
               MOVE "C" TO YR-SAVE
           ELSE
           IF C-D-YDIG = 3
               MOVE "D" TO YR-SAVE
           ELSE
           IF C-D-YDIG = 4
               MOVE "E" TO YR-SAVE
           ELSE
           IF C-D-YDIG = 5
               MOVE "F" TO YR-SAVE
           ELSE
           IF C-D-YDIG = 6
               MOVE "G" TO YR-SAVE
           ELSE
           IF C-D-YDIG = 7
               MOVE "H" TO YR-SAVE
           ELSE
           IF C-D-YDIG = 8
               MOVE "J" TO YR-SAVE
           ELSE
           MOVE "K" TO YR-SAVE.
           CALL "TESCSEQ" USING ESC-NAME.
           ACCEPT MC-LOCAL-DATA-AREA FROM LOCAL-DATA-AREA.
           MOVE HIGH-VALUES TO START-KEY-PARTS.
       6-MAIN.
           MOVE SPACES TO WO-NUM-BUFFER.
           PERFORM 61-SET-YR-DIGIT VARYING SUB FROM 1 BY 1
               UNTIL SUB > 24.
           MOVE "FAPPRVWO" TO VIEW-CFNAME.
           MOVE WO-NUM-BUFFER TO DSPLY-REC.
           PERFORM 99-SCREEN-WRITE.
           PERFORM 98-SCREEN-READ.
           MOVE DSPLY-REC TO WO-NUM-BUFFER.
           MOVE SPACES TO ERROR-BUFFER.
           IF VIEW-LASTKEY = 3 GO TO 2-EOJ.
           MOVE 0 TO SUB.
       6-MAIN-CONT.
           ADD 1 TO SUB.
           IF SUB > 24
               MOVE 0 TO SUB
               GO TO 6-MAIN.
           IF WO-NUMB-1-6 (SUB) = SPACES GO TO 6-MAIN-CONT.
           MOVE WO-NUMB (SUB) TO WO-NUMBER.
           CALL "TALWONO" USING WO-NUMBER RET-CODE.
           MOVE WO-NUMBER TO WO-NUMB (SUB).
           MOVE TRUE-VAL TO INDS (98).
           MOVE WO-NUM-BUFFER TO DSPLY-REC.
           PERFORM 99-SCREEN-WRITE.
           PERFORM 98A-SCREEN-READ.
           MOVE SPACES TO WO-BASIC-DATA WO-PLANNED-DATA.
           MOVE 0 TO ERROR-SWITCH REQS-CUT-SW WS-SW.
           PERFORM 69-START-WO-BASIC-FILE.
           IF COND-WORD = 17
               PERFORM 69-START-WO-PLANNED-FILE
               IF COND-WORD = 17
                   MOVE 49056 TO CATREAD-MSG-NUMBER
      *M           "WORK ORDER DOES NOT EXIST"
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE ERROR-BUFFER TO WO-NUM-ERR-LINE
                   MOVE TRUE-VAL TO INDS (SUB) INDS (99)
                   SUBTRACT 1 FROM SUB
                   MOVE WO-NUM-BUFFER TO DSPLY-REC
                   PERFORM 99-SCREEN-WRITE
                   PERFORM 98-SCREEN-READ
                   MOVE DSPLY-REC TO WO-NUM-BUFFER
                   GO TO 6-MAIN-CONT
               ELSE
               PERFORM 69-READ-WO-PLANNED-FILE
               IF COND-WORD = 15
                   MOVE 49056 TO CATREAD-MSG-NUMBER
      *M           "WORK ORDER DOES NOT EXIST"
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE ERROR-BUFFER TO WO-NUM-ERR-LINE
                   MOVE TRUE-VAL TO INDS (SUB) INDS (99)
                   SUBTRACT 1 FROM SUB
                   MOVE WO-NUM-BUFFER TO DSPLY-REC
                   PERFORM 99-SCREEN-WRITE
                   PERFORM 98-SCREEN-READ
                   MOVE DSPLY-REC TO WO-NUM-BUFFER
                   GO TO 6-MAIN-CONT
               ELSE
      *        IF APPROVAL-CODE-P = "A " AND EXP-CLASS-P > "00010000"
      *            MOVE 66345 TO CATREAD-MSG-NUMBER
      *            PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
      *            MOVE WO-NUMB (SUB) TO ERR-WO
      *            MOVE ERROR-BUFFER TO WO-NUM-CMD-LINE
      *            MOVE TRUE-VAL TO INDS (98)
      *            MOVE WO-NUM-BUFFER TO DSPLY-REC
      *            PERFORM 99-SCREEN-WRITE
      *            PERFORM 98A-SCREEN-READ
      *            CALL "CLPAUSE2"
      *            GO TO 6-MAIN-CONT
      *        ELSE
               IF WO-NUM-SUFF-P = SPACES
                   PERFORM 611-KICK-REQS-LOOSE THRU 611-KRL-EXIT
               ELSE
               NEXT SENTENCE
           ELSE
           PERFORM 69-READ-WO-BASIC-FILE
           IF COND-WORD = 15
               MOVE 49056 TO CATREAD-MSG-NUMBER
      *M       "WORK ORDER DOES NOT EXIST"
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE ERROR-BUFFER TO WO-NUM-ERR-LINE
               MOVE TRUE-VAL TO INDS (SUB) INDS (99)
               SUBTRACT 1 FROM SUB
               MOVE WO-NUM-BUFFER TO DSPLY-REC
               PERFORM 99-SCREEN-WRITE
               PERFORM 98-SCREEN-READ
               MOVE DSPLY-REC TO WO-NUM-BUFFER
               GO TO 6-MAIN-CONT
           ELSE
      *    IF APPROVAL-CODE = "A" AND EXP-CLASS > "00010000"
      *        MOVE 66345 TO CATREAD-MSG-NUMBER
      *        PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
      *        MOVE WO-NUMB (SUB) TO ERR-WO
      *        MOVE ERROR-BUFFER TO WO-NUM-CMD-LINE
      *        MOVE TRUE-VAL TO INDS (98)
      *        MOVE WO-NUM-BUFFER TO DSPLY-REC
      *        PERFORM 99-SCREEN-WRITE
      *        PERFORM 98A-SCREEN-READ
      *        CALL "CLPAUSE2"
      *        GO TO 6-MAIN-CONT
      *    ELSE
           PERFORM 611-KICK-REQS-LOOSE THRU 611-KRL-EXIT.
           IF WO-BASIC-DATA = SPACES
               IF WO-NUM-SUFF-P = SPACES
                   PERFORM 69-DELETE-WO-PLANNED-FILE
                   IF COND-WORD = 17
                       MOVE "  MMISA" TO BLOWUP-BASE
                       MOVE "W/O DELETE ON APPROVAL FAILED * TAPPRVWO *"
                           TO BU-DISPLAY-MSG
                       MOVE "WO-PLANNED-FILE" TO BU-DISPLAY-FLD (1)
                       MOVE "WORK ORDER = " TO BU-DISPLAY-FLD (2)
                       MOVE WO-NUMB (SUB)  TO BU-DISPLAY-FLD (3)
                       PERFORM 998-BLOWUP
                   ELSE
                   PERFORM 6111-SET-APPRVL-STATUS THRU 6111-SAS-EXIT
                   PERFORM 69-WRITE-WO-PLANNED-FILE
                   IF COND-WORD = 17
                       MOVE "  MMISA" TO BLOWUP-BASE
                       MOVE "DBPUT FAILED ON WO-PLANNED * TAPPRVWO *"
                           TO BU-DISPLAY-MSG
                       MOVE "WO-PLANNED-FILE" TO BU-DISPLAY-FLD (1)
                       MOVE "WORK ORDER = " TO BU-DISPLAY-FLD (2)
                       MOVE WO-NUMB (SUB)   TO BU-DISPLAY-FLD (3)
                       PERFORM 998-BLOWUP
                   ELSE
                   MOVE WO-NUMB (SUB) TO R-WO
                   MOVE TRUE-VAL TO INDS (98)
                   MOVE READD-MSG TO WO-NUM-CMD-LINE
                   MOVE WO-NUM-BUFFER TO DSPLY-REC
                   PERFORM 99-SCREEN-WRITE
                   PERFORM 98A-SCREEN-READ
                   CALL "CLPAUSE2"
                   GO TO 6-MAIN-CONT
               ELSE
               IF WO-NUM-SUFF-P = "000"
                   PERFORM 6111-SET-APPRVL-STATUS THRU 6111-SAS-EXIT
                   PERFORM 69-DELETE-WO-PLANNED-FILE
                   IF COND-WORD = 17
                       MOVE "  MMISA" TO BLOWUP-BASE
                       MOVE "W/O DELETE ON APPROVAL FAILED * TAPPRVWO *"
                           TO BU-DISPLAY-MSG
                       MOVE "WO-PLANNED-FILE" TO BU-DISPLAY-FLD (1)
                       MOVE "WORK ORDER = " TO BU-DISPLAY-FLD (2)
                       MOVE WO-NUMB (SUB)  TO BU-DISPLAY-FLD (3)
                       PERFORM 998-BLOWUP
                   ELSE
                   PERFORM 69-WRITE-WO-PLANNED-FILE
                   IF COND-WORD = 17
                       MOVE "  MMISA" TO BLOWUP-BASE
                       MOVE "DBPUT FAILED ON WO-PLANNED * TAPPRVWO *"
                           TO BU-DISPLAY-MSG
                       MOVE "WO-PLANNED-FILE" TO BU-DISPLAY-FLD (1)
                       MOVE "WORK ORDER = " TO BU-DISPLAY-FLD (2)
                       MOVE WO-NUMB (SUB)   TO BU-DISPLAY-FLD (3)
                       PERFORM 998-BLOWUP
                   ELSE
                   MOVE WO-NUMB (SUB) TO R-WO
                   MOVE READD-MSG TO WO-NUM-CMD-LINE
                   MOVE WO-NUM-BUFFER TO DSPLY-REC
                   PERFORM 99-SCREEN-WRITE
                   PERFORM 98A-SCREEN-READ
                   CALL "CLPAUSE2"
                   GO TO 6-MAIN-CONT
               ELSE
               MOVE WO-NUM-PLANNED TO SUFF-WO
               MOVE "000" TO SUFF-SUFF
               PERFORM 69-START-WO-PLANNED-FILE-SUFF
               IF COND-WORD = 17
                   MOVE 40071 TO CATREAD-MSG-NUMBER
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE ERROR-BUFFER TO WO-NUM-CMD-LINE
                   MOVE TRUE-VAL TO INDS (98)
                   MOVE WO-NUM-BUFFER TO DSPLY-REC
                   PERFORM 99-SCREEN-WRITE
                   PERFORM 98A-SCREEN-READ
                   CALL "CLPAUSE2"
                   MOVE SPACES TO ERROR-BUFFER WO-NUM-CMD-LINE
                   GO TO 6-MAIN-CONT
               ELSE
               PERFORM 69-READ-WO-PLANNED-FILE-SUFF
               IF COND-WORD = 15
                   MOVE 40071 TO CATREAD-MSG-NUMBER
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE ERROR-BUFFER TO WO-NUM-CMD-LINE
                   MOVE TRUE-VAL TO INDS (98)
                   MOVE WO-NUM-BUFFER TO DSPLY-REC
                   PERFORM 99-SCREEN-WRITE
                   PERFORM 98A-SCREEN-READ
                   CALL "CLPAUSE2"
                   MOVE SPACES TO ERROR-BUFFER WO-NUM-CMD-LINE
                   GO TO 6-MAIN-CONT
               ELSE
               IF WO-APPROVAL-P3 NOT = "A"
                   MOVE 39042 TO CATREAD-MSG-NUMBER
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE ERROR-BUFFER TO WO-NUM-CMD-LINE
                   MOVE TRUE-VAL TO INDS (98)
                   MOVE WO-NUM-BUFFER TO DSPLY-REC
                   PERFORM 99-SCREEN-WRITE
                   PERFORM 98A-SCREEN-READ
                   CALL "CLPAUSE2"
                   MOVE SPACES TO ERROR-BUFFER WO-NUM-CMD-LINE
                   GO TO 6-MAIN-CONT
               ELSE
               PERFORM 611-KICK-REQS-LOOSE THRU 611-KRL-EXIT

      *------- IF NO 'M' PARTS 'CMANREQ' IS NOT CALLED AND
      *------- THEREFORE THE SUFFIX IS NOT REREAD.

      *------- THE SUFFIX NEEDS TO BE REREAD BECAUSE OF THE
      *------- ABOVE READ OF THE MASTER - OTHERWISE THE
      *------- DELETE FAILS.

               PERFORM 69-REREAD-SUFFIX
               PERFORM 6111-SET-APPRVL-STATUS THRU 6111-SAS-EXIT
               PERFORM 69-DELETE-WO-PLANNED-FILE
               IF COND-WORD = 17
                   MOVE "  MMISA" TO BLOWUP-BASE
                   MOVE "W/O DELETE ON APPROVAL FAILED * TAPPRVWO *"
                       TO BU-DISPLAY-MSG
                   MOVE "WO-PLANNED-FILE" TO BU-DISPLAY-FLD (1)
                   MOVE "WORK ORDER = " TO BU-DISPLAY-FLD (2)
                   MOVE WO-NUMB (SUB)  TO BU-DISPLAY-FLD (3)
                   PERFORM 998-BLOWUP
               ELSE
               PERFORM 69-WRITE-WO-PLANNED-FILE
               IF COND-WORD = 17
                   MOVE "  MMISA" TO BLOWUP-BASE
                   MOVE "DBPUT FAILED ON WO-PLANNED * TAPPRVWO *"
                       TO BU-DISPLAY-MSG
                   MOVE "WO-PLANNED-FILE"  TO BU-DISPLAY-FLD (1)
                   MOVE "WORK ORDER = " TO BU-DISPLAY-FLD (2)
                   MOVE WO-NUMB (SUB)   TO BU-DISPLAY-FLD (3)
                   PERFORM 998-BLOWUP
               ELSE
               MOVE WO-NUMB (SUB) TO R-WO
               MOVE TRUE-VAL TO INDS (98)
               MOVE READD-MSG TO WO-NUM-CMD-LINE
               MOVE WO-NUM-BUFFER TO DSPLY-REC
               PERFORM 99-SCREEN-WRITE
               PERFORM 98A-SCREEN-READ
               CALL "CLPAUSE2"
               GO TO 6-MAIN-CONT
           ELSE
           PERFORM 6111-SET-APPRVL-STATUS THRU 6111-SAS-EXIT
           PERFORM 69-DELETE-WO-PLANNED-FILE
           IF COND-WORD = 17
               MOVE "  MMISA" TO BLOWUP-BASE
               MOVE "W/O DELETE ON APPROVAL FAILED * TAPPRVWO *"
                   TO BU-DISPLAY-MSG
               MOVE "WO-PLANNED-FILE" TO BU-DISPLAY-FLD (1)
               MOVE "WORK ORDER = " TO BU-DISPLAY-FLD (2)
               MOVE WO-NUMB (SUB)  TO BU-DISPLAY-FLD (3)
               PERFORM 998-BLOWUP
           ELSE
           PERFORM 69-WRITE-WO-PLANNED-FILE
           IF COND-WORD = 17
               MOVE "  MMISA" TO BLOWUP-BASE
               MOVE "DBPUT FAILED ON WO-PLANNED * TAPPRVWO *"
                   TO BU-DISPLAY-MSG
               MOVE "WO-PLANNED-FILE"  TO BU-DISPLAY-FLD (1)
               MOVE "WORK ORDER = " TO BU-DISPLAY-FLD (2)
               MOVE WO-NUMB (SUB)   TO BU-DISPLAY-FLD (3)
               PERFORM 998-BLOWUP
           ELSE
           MOVE WO-NUMB (SUB) TO R-WO
           MOVE TRUE-VAL TO INDS (98)
           MOVE READD-MSG TO WO-NUM-CMD-LINE
           MOVE WO-NUM-BUFFER TO DSPLY-REC
           PERFORM 99-SCREEN-WRITE
           PERFORM 98A-SCREEN-READ
           CALL "CLPAUSE2"
           GO TO 6-MAIN-CONT.
       6-MAIN-EXIT.    EXIT.

       61-SET-YR-DIGIT.
           MOVE YR-SAVE TO WO-NUMB-7 (SUB).
       611-KICK-REQS-LOOSE.
           IF JCW-AREQJCW-259 = 1
               NEXT SENTENCE
           ELSE
           GO TO 611-KRL-EXIT.
           MOVE WO-NUMBER TO WONUM OF WPFDREC.
           MOVE 0 TO PRT-SEQ.
           PERFORM 69-START-WO-PARTS-FILE.
           IF COND-WORD = 17 GO TO 611-KRL-EXIT.
       611-KRL-CONT.
           PERFORM 69-READ-WO-PARTS-FILE.
           IF COND-WORD = 15 GO TO 611-KRL-EXIT.
           ADD 1 TO PRT-SEQ.
           IF PRT-DELETE-FLAG = "D" GO TO 611-KRL-CONT.
           IF PRT-STATUS-1 NOT = "M" GO TO 611-KRL-CONT.
           IF PRT-REQ-NO NOT = "      "
               PERFORM 611-CALL-CEAWOAP
               GO TO 611-KRL-CONT.
           IF PRT-PO-NO NOT = "          " GO TO 611-KRL-CONT.
      **************************************************************
      *    THE FOLLOWING CALL TO TPRINTWS WAS ADDED 5-12-86        *
      *    TO PRINT THE WORKSHEET THEN RESET THE DBCB ON WO-PARTS  *
      *    AND ASSIGN THE REQUISITIONS THROUGH CSIS WHEN THE       *
      *    WORK ORDER IS APPROVED                                  *
      **************************************************************
           IF WS-SW > 0
               NEXT SENTENCE
           ELSE
           IF PRINT-WO-REQPK = "Y"
               CALL "TPRINTWS" USING DBPARAMETERS WO-PLANNED-DATA
                                 ERROR-SWITCH VIEW-COMAREA
               MOVE 1 TO WS-SW
               GO TO 611-KICK-REQS-LOOSE.
           ACCEPT IOFEEDBACK FROM I-O-FEEDBACK-AREA.
           MOVE IO-REL-NO TO PFKEY.
           MOVE 0 TO COND-WORD.
           MOVE START-KEY-PARTS TO WONUM OF WPFDREC.
           START WO-PARTS-FILE KEY IS > EXTERNALLY-DESCRIBED-KEY
               INVALID KEY     MOVE 17 TO COND-WORD.
           MOVE SPACES TO CMR-DATA CMR-DESC CMR-REMARKS
               CMR-RETURNED-DATA CMR-MISC-PARMS.
           PERFORM 6110-PRINT-REQS THRU 6110-PR-EXIT.
           READ WO-PARTS-FILE-PF INTO WO-PARTS-DATA
               INVALID KEY    MOVE 15 TO COND-WORD.
           IF WPFDP-STATUS NOT = "00" MOVE 15 TO COND-WORD.
           IF COND-WORD = 15
               MOVE "  MMISA" TO BLOWUP-BASE
               MOVE "PHYS. READ/WO-PARTS FAILED * TAPPRVWO *"
                   TO BU-DISPLAY-MSG
               PERFORM 998-BLOWUP.
           MOVE CMR-REQ-NUMBER TO PRT-REQ-NO.
           MOVE CMR-QTY TO PRT-ACT-QTY-9.
           MOVE PRT-SEQ TO PRT-ITEM-NO.
           MOVE 0 TO COND-WORD.
           REWRITE WPFDPREC FROM WO-PARTS-DATA
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF WPFDP-STATUS NOT = "00" MOVE 17 TO COND-WORD.
           IF COND-WORD = 17
               MOVE "  MMISA" TO BLOWUP-BASE
               MOVE "WO-PARTS UPDATE FAILED * TAPPRVWO *"
                   TO BU-DISPLAY-MSG
               MOVE "WO-PARTS"     TO BU-DISPLAY-FLD (1)
               MOVE PRT-REQ-NO     TO BU-DISPLAY-FLD (2)
               PERFORM 998-BLOWUP.
           PERFORM 611-CALL-CEAWOAP.
           GO TO 611-KICK-REQS-LOOSE.

       611-KRL-EXIT.    EXIT.

       6110-PRINT-REQS.
           MOVE "CR" TO CMR-CALL-MODE.
           MOVE PRT-WO-NU TO CMR-WO-NUMBER.
           MOVE PRT-SEQ TO CMR-WO-ITEM-NUMBER.
           MOVE PRT-NUM-7 TO CMR-CORP-CODE.
           MOVE DEPT-P TO CMR-FOR-DEPT.
           MOVE PRT-DATE-USED-CN TO CMR-DATE-REQUIRED-CN.
           MOVE PRT-STAGE TO CMR-STAGING-AREA.
           MOVE PRT-EST-QTY-9 TO CMR-QTY PRT-ACT-QTY-9.
           MOVE PRT-UNIT-MEAS TO CMR-UM.
           MOVE BUDGET-NO TO CMR-BUDGET-NUMBER.
           MOVE SPACES TO CMR-DESC.
           MOVE SPACES TO CMR-MISC-PARMS.
           MOVE SPACES TO CMR-RETURNED-DATA.
           MOVE 0 TO CMR-SPOOL-PRT.
           MOVE P-UNIT-COST TO CMR-EST-UNIT-PRICE.
           MOVE PRT-DESC TO CMR-DESC-LINE (1).
           MOVE PRT-DESC-2 TO CMR-DESC-LINE (2).
           MOVE PRT-DESC-3 TO CMR-DESC-LINE (3).
           MOVE PRT-DESC-4 TO CMR-DESC-LINE (4).
           MOVE PRT-DESC-5 TO CMR-DESC-LINE (5).
           MOVE PRT-REMARKS   TO CMR-REMARK-1.
           MOVE PRT-REMARKS-2 TO CMR-REMARK-2.
           MOVE PRT-ADDL-INFO TO CMR-ADDTL-INFO.
           MOVE PRT-SUGG-VENDOR TO CMR-SUGGESTED-VENDOR.
           MOVE PRT-SEQ TO CMR-WO-ITEM-NUMBER.
           MOVE PRT-SUB-1-3 TO CMR-SUB.
           MOVE PRT-ORIGINATOR TO CMR-REQ-ORIG.
           MOVE EXP-CLASS-P TO CMR-EXPENSE-CLASS.
      *    OLD LOGIC UNLOCKED MMIS RECORD HERE                         .
           CALL "CMANREQ" USING PASSED-BASE
                                BASE-MMISA
                                BASE-BG
                                BASE-DUMMY
                                ERROR-76
                                CMR-CALL-MODE
                                CMR-DATA
                                CMR-DESC
                                CMR-REMARKS
                                CMR-RETURNED-DATA
                                CMR-MISC-PARMS
                                REQ-GLOBALS
                                LANGUAGE-PARMS
                                ESC-NAME
                                VIEW-COMAREA.
           IF CMR-RETURN-STATUS = "OK"
               MOVE 44110 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE ERROR-BUFFER TO REQ-ISSUED-MSG
               MOVE CMR-WO-NUMBER TO REQU-WO
               MOVE CMR-REQ-NUMBER TO REQ-ISS
               MOVE TRUE-VAL TO INDS (98)
               MOVE REQ-ISSUED-MSG TO WO-NUM-CMD-LINE
               MOVE WO-NUM-BUFFER TO DSPLY-REC
               PERFORM 99-SCREEN-WRITE
               PERFORM 98A-SCREEN-READ
               CALL "CLPAUSE2"
           ELSE
           IF CMR-RETURN-STATUS = "RE"
               MOVE 44025 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE TRUE-VAL TO INDS (98)
               MOVE ERROR-BUFFER TO WO-NUM-CMD-LINE
               MOVE WO-NUM-BUFFER TO DSPLY-REC
               PERFORM 99-SCREEN-WRITE
               PERFORM 98A-SCREEN-READ
               CALL "CLPAUSE2"
           ELSE
           IF CMR-RETURN-STATUS = "DE"
               MOVE "CSIS FILE ERROR - PLEASE CONTACT STAFF"
                       TO ERROR-BUFFER
               MOVE TRUE-VAL TO INDS (98)
               MOVE ERROR-BUFFER TO WO-NUM-CMD-LINE
               MOVE WO-NUM-BUFFER TO DSPLY-REC
               PERFORM 99-SCREEN-WRITE
               PERFORM 98A-SCREEN-READ
               CALL "CLPAUSE2"
           ELSE
           IF CMR-RETURN-STATUS = "BB"
               MOVE 28021 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE TRUE-VAL TO INDS (98)
               MOVE ERROR-BUFFER TO WO-NUM-CMD-LINE
               MOVE WO-NUM-BUFFER TO DSPLY-REC
               PERFORM 99-SCREEN-WRITE
               PERFORM 98A-SCREEN-READ
               CALL "CLPAUSE2"
           ELSE
           MOVE 45048 TO CATREAD-MSG-NUMBER
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
           MOVE TRUE-VAL TO INDS (98)
           MOVE ERROR-BUFFER TO WO-NUM-CMD-LINE
           MOVE WO-NUM-BUFFER TO DSPLY-REC
           PERFORM 99-SCREEN-WRITE
           PERFORM 98A-SCREEN-READ
           CALL "CLPAUSE2".
       6110-PR-EXIT.    EXIT.

       611-CALL-CEAWOAP.
      *    UNLOCK OF MMIS OCCURRED HERE
           MOVE PRT-REQ-NO TO EAWOAP-REQ-NUMBER.
           MOVE SPACES TO EAWOAP-RET-CODE.
           MOVE SPACES TO BU-DISPLAY-MSG BU-DISPLAY-FLDS.
           MOVE 0 TO PASSED-SPOOL-PRT.
           CALL "CEAWOAP" USING PASSED-BASE
                                BASE-MMISA
                                BASE-BG
                                STATUS-AREA
                                REQ-GLOBALS
                                PASSED-SPOOL-PRT
                                PASS-COMP
                                EAWOAP-PARMS
                                ESC-NAME
                                VIEW-COMAREA
                                LANGUAGE-PARMS
                                BU-DISPLAY-MSG
                                BU-DISPLAY-FLDS.

      *    RE-LOCK OF MMIS SETS OCCURRED HERE

       6111-SET-APPRVL-STATUS.
           IF WO-BASIC-DATA = SPACES
               MOVE "A" TO APPROVAL-CODE-P
               IF REQS-CUT-SW = 0
                   IF WO-STATUS-P = "HA"
                       MOVE "HS" TO WO-STATUS-P
                   ELSE
                   NEXT SENTENCE
               ELSE
               IF WO-STATUS-P = "OO" OR "HA"
                   MOVE "HM" TO WO-STATUS-P
               ELSE
               NEXT SENTENCE
           ELSE
           MOVE "A" TO APPROVAL-CODE.

       6111-SAS-EXIT.    EXIT.

       6112-APPROVE-ALL-SUFFIXES.
           ADD 1 TO SUFF-SUFF-9.
           IF SUFF-SUFF > SAVE-LAST-SUFFIX-INIT
               GO TO 6112-AAS-EXIT.
           MOVE SUFF-WO TO WONUM OF WPFREC WO-NUMB (SUB).
           MOVE 0 TO ERROR-SWITCH REQS-CUT-SW WS-SW.
           START WO-PLANNED-FILE KEY IS = EXTERNALLY-DESCRIBED-KEY
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF WPF-STATUS NOT = "00" MOVE 17 TO COND-WORD.
           IF COND-WORD = 17 GO TO 6112-AAS-EXIT.
           READ WO-PLANNED-FILE NEXT INTO WO-PLANNED-DATA
               AT END    MOVE 15 TO COND-WORD.
           IF WPF-STATUS NOT = "00" MOVE 15 TO COND-WORD.
           IF COND-WORD = 15 GO TO 6112-AAS-EXIT.
           PERFORM 611-KICK-REQS-LOOSE THRU 611-KRL-EXIT.
           PERFORM 6111-SET-APPRVL-STATUS THRU 6111-SAS-EXIT.
           DELETE WO-PLANNED-FILE RECORD
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF WPF-STATUS NOT = "00" MOVE 17 TO COND-WORD.
           IF COND-WORD = 17
               MOVE "  MMISA" TO BLOWUP-BASE
               MOVE "W/O DELETE ON APPROVAL FAILED * TAPPRVWO *"
                   TO BU-DISPLAY-MSG
               MOVE "WO-PLANNED-FILE" TO BU-DISPLAY-FLD (1)
               MOVE "WORK ORDER = " TO BU-DISPLAY-FLD (2)
               MOVE WO-NUMB (SUB) TO BU-DISPLAY-FLD (3)
               PERFORM 998-BLOWUP
           ELSE
           WRITE WPFREC FROM WO-PLANNED-DATA
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF WPF-STATUS NOT = "00" MOVE 17 TO COND-WORD.
           IF COND-WORD = 17
               MOVE "  MMISA" TO BLOWUP-BASE
               MOVE "DBPUT FAILED ON WO-PLANNED * TAPPRVWO *"
                   TO BU-DISPLAY-MSG
               MOVE "WO-PLANNED-FILE"  TO BU-DISPLAY-FLD (1)
               MOVE "WORK ORDER = " TO BU-DISPLAY-FLD (2)
               MOVE WO-NUMB (SUB)   TO BU-DISPLAY-FLD (3)
               PERFORM 998-BLOWUP
           ELSE
           MOVE SUFF-WO TO R-WO
           GO TO 6112-APPROVE-ALL-SUFFIXES.
       6112-AAS-EXIT.    EXIT.

       69-READ-MPLTINFO-FILE.
           MOVE 0 TO COND-WORD.
           READ MPLTINFO-FILE INTO BUF-MPLTINFO
               INVALID KEY MOVE 15 TO COND-WORD.
           IF MF-STATUS NOT = "00" MOVE 15 TO COND-WORD.

       69-START-MPLTINFO-FILE.
           MOVE 0 TO COND-WORD.
           MOVE "RQGB" TO PLTINFOKEY OF MFREC.
           START MPLTINFO-FILE KEY IS = EXTERNALLY-DESCRIBED-KEY
               INVALID KEY     MOVE 17 TO COND-WORD.
           IF MF-STATUS NOT = "00" MOVE 17 TO COND-WORD.

       69-READ-WO-BASIC-FILE.
           MOVE 0 TO COND-WORD.
           READ WO-BASIC-FILE NEXT INTO WO-BASIC-DATA
               AT END    MOVE 15 TO COND-WORD.
           IF WBF-STATUS NOT = "00" MOVE 15 TO COND-WORD.

       69-START-WO-PARTS-FILE.
           MOVE 0 TO COND-WORD.
           MOVE WO-NUMBER TO WONUM OF WPFDREC.
           START WO-PARTS-FILE KEY IS = EXTERNALLY-DESCRIBED-KEY
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF WPFD-STATUS NOT = "00" MOVE 17 TO COND-WORD.

       69-READ-WO-PARTS-FILE.
           MOVE 0 TO COND-WORD.
           READ WO-PARTS-FILE NEXT INTO WO-PARTS-DATA
               AT END    MOVE 15 TO COND-WORD.
           IF WO-NUMBER NOT = WONUM OF WPFDREC MOVE 15 TO COND-WORD.
           IF WPFD-STATUS NOT = "00" MOVE 15 TO COND-WORD.

       69-START-WO-BASIC-FILE.
           MOVE 0 TO COND-WORD.
           MOVE WO-NUMB (SUB) TO WONUM OF WBFREC.
           START WO-BASIC-FILE KEY IS = EXTERNALLY-DESCRIBED-KEY
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF WBF-STATUS NOT = "00" MOVE 17 TO COND-WORD.

       69-DELETE-WO-PLANNED-FILE.
           MOVE 0 TO COND-WORD.
           DELETE WO-PLANNED-FILE RECORD
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF WPF-STATUS NOT = "00" MOVE 17 TO COND-WORD.

       69-READ-WO-PLANNED-FILE.
           MOVE 0 TO COND-WORD.
           READ WO-PLANNED-FILE NEXT INTO WO-PLANNED-DATA
               AT END    MOVE 15 TO COND-WORD.
           IF WPF-STATUS NOT = "00" MOVE 15 TO COND-WORD.

       69-START-WO-PLANNED-FILE.
           MOVE 0 TO COND-WORD.
           MOVE WO-NUMB (SUB) TO WONUM OF WPFREC.
           START WO-PLANNED-FILE KEY IS = EXTERNALLY-DESCRIBED-KEY
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF WPF-STATUS NOT = "00" MOVE 17 TO COND-WORD.

       69-START-WO-PLANNED-FILE-SUFF.
           MOVE 0 TO COND-WORD.
           MOVE WO-NUM-PLANNED TO SUFF-WO.
           MOVE "000" TO SUFF-SUFF.
           MOVE SUFF-WO TO WONUM OF WPFREC.
           START WO-PLANNED-FILE KEY IS = EXTERNALLY-DESCRIBED-KEY
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF WPF-STATUS NOT = "00" MOVE 17 TO COND-WORD.

       69-READ-WO-PLANNED-FILE-SUFF.
           MOVE 0 TO COND-WORD.
           READ WO-PLANNED-FILE NEXT INTO WO-PLANNED-DATA3
               AT END    MOVE 15 TO COND-WORD.
           IF WPF-STATUS NOT = "00" MOVE 15 TO COND-WORD.

       69-WRITE-WO-PLANNED-FILE.
           MOVE 0 TO COND-WORD.
           WRITE WPFREC FROM WO-PLANNED-DATA
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF WPF-STATUS NOT = "00" MOVE 17 TO COND-WORD.

       69-REREAD-SUFFIX.
           MOVE 0 TO COND-WORD.
           MOVE WO-NUM-PLANNED TO WONUM OF WPFREC.
           START WO-PLANNED-FILE KEY IS = EXTERNALLY-DESCRIBED-KEY
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF WPF-STATUS NOT = "00" MOVE 17 TO COND-WORD.
           IF COND-WORD = 17 GO TO 2-EOJ.
           READ WO-PLANNED-FILE NEXT INTO WO-PLANNED-DATA
               AT END    MOVE 17 TO COND-WORD.
           IF WPF-STATUS NOT = "00" MOVE 17 TO COND-WORD.

       98-SCREEN-READ.
           READ DISPLAY-FILE FORMAT IS VIEW-CFNAME
               INDIC IS INDICS.
           ACCEPT IOFEEDBACK FROM I-O-FEEDBACK-AREA.
           MOVE ALL B"0" TO INDICS.
           IF DSPLY-STATUS NOT = "00"
               MOVE 3 TO VIEW-LASTKEY
           ELSE
           MOVE FUNCTION-NUM TO VIEW-LASTKEY.

       98A-SCREEN-READ.
           READ DISPLAY-FILE TERMINAL IS TERMINAL-ID
               INDIC IS INDICS
                  NO DATA MOVE DSPLY-STATUS TO DSPLY-STATUS.
           MOVE ALL B"0" TO INDICS.

       99-SCREEN-WRITE.
           WRITE DSPLY-REC FORMAT IS VIEW-CFNAME
               INDIC IS INDICS.
           MOVE ALL B"0" TO INDICS.

       998-BLOWUP.
           MOVE "TAPPRVWO" TO BU-PGM-NAME.
           CALL "TBLOWUP" USING BLOWUP-BASE BU-PGM-NAME STATUS-AREA
                            VIEW-COMAREA DUMMY-KSAM-STAT
                            BU-DISPLAY-MSG BU-DISPLAY-FLDS.

       999-CATREAD.
           MOVE SPACES TO ERROR-BUFFER.
           CALL "CCATREAD" USING CATREAD-PARMS.
           MOVE CATREAD-MSG-TEXT TO ERROR-BUFFER.
       999-CATREAD-EXIT.    EXIT.
