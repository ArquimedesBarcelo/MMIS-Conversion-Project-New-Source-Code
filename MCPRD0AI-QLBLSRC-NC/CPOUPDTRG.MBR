       IDENTIFICATION DIVISION.

       PROGRAM-ID.     CPOUPDTRG.
       AUTHOR.         EXLTECH, INC - DAN RAUCH

      **===========================================================**
      ** -----------  T R I G G E R    P R O G R A M  ------------- *
      **===========================================================**

      ***************************************************************
      **                    C P O U P D T R G                      **
      ***************************************************************
      ** PO UPDATE TRIGGER PROGRAM ON THE FOLLOWING FILES          **
      **    MCFPCS0900 MCFPCS1000 MCFPCS1100 MCFPCS6400            **
      ***************************************************************
      ** NOTE:  SHOULD COMPILE TO THE FILE LIBRARY                 **
      ***************************************************************

      *****************************************************************
      **            M O D I F I C A T I O N    H I S T O R Y
      ***------------------------------------------------------------***
      *   APRIL 01 2003      DAN RAUCH
      *   INITIAL AUTHOR   XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX  'G
      *   XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX  'G
      ***------------------------------------------------------------***
                                                                       *
      *================================================================
       ENVIRONMENT DIVISION.
      *================================================================

       CONFIGURATION SECTION.

       SOURCE-COMPUTER.       IBM-AS400.
       OBJECT-COMPUTER.       IBM-AS400.
       SPECIAL-NAMES.         LOCAL-DATA IS LDA.

       INPUT-OUTPUT SECTION.
       FILE-CONTROL.

           SELECT PO-UPDTRG-FILE     ASSIGN TO DATABASE-MCFPCS7300
                  ORGANIZATION IS INDEXED
                  ACCESS IS DYNAMIC
                  FILE STATUS WS-FILE-STATUS
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY.

           SELECT PO-UPDPGM-FILE     ASSIGN TO DATABASE-MCFPCS7400
                  ORGANIZATION IS INDEXED
                  ACCESS IS DYNAMIC
                  FILE STATUS WS-FILE-STATUS
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY.

           SELECT DPORECD-FILE       ASSIGN TO DATABASE-MCFLCS0901
                  ORGANIZATION IS INDEXED
                  ACCESS IS DYNAMIC
                  FILE STATUS WS-FILE-STATUS
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY.

      *============================================================    ====
       DATA DIVISION.
      *============================================================    ====
       FILE SECTION.

       FD  PO-UPDTRG-FILE.
       01  PO-UPDTRG-REC.
       COPY DDS-ALL-FORMATS OF MCFPCS7300.

       FD  PO-UPDPGM-FILE.
       01  PO-UPDPGM-REC.
       COPY DDS-ALL-FORMATS OF MCFPCS7400.

       FD  DPORECD-FILE.
       01  DPORECD-REC.
       COPY DDS-ALL-FORMATS OF MCFLCS0901.

      *----------------------------------------------------------------
       WORKING-STORAGE SECTION.
      *----------------------------------------------------------------

      *****************************************************************
      * FILE STATUS AREA
      *****************************************************************
       COPY FILESTATUS  IN COPYLIB.
       COPY DTSPARMS2   IN COPYLIB.
       COPY CPOLOGPRM   IN COPYLIB.
       COPY ZMPLTWS     IN COPYLIB.

      **************************************************************** *
      *  DATABASE RECORD TABLE AREA
      **************************************************************** *
       01  WS-DATABASE-RECORD-AREA.
           03  WS-A-STR           PIC 9(04)      VALUE ZERO.
           03  WS-A-LEN           PIC 9(04)      VALUE ZERO.

           03  WS-B-STR           PIC 9(04)      VALUE ZERO.
           03  WS-B-LEN           PIC 9(04)      VALUE ZERO.

           03  WS-A-DBR           PIC X(1500)     VALUE SPACE.
           03  WS-B-DBR           PIC X(1500)     VALUE SPACE.
           03  WS-DB-REC          PIC X(1500)     VALUE SPACE.

      **************************************************************** *
      * TRIGGER PROGRAM BUFFER AREA  (record length * 2) + 96
      ****************************************************************
       01  WS-BUFFER-DATA.
           03  WS-BD-FILE-NAME    PIC X(10)       VALUE SPACE.
               88  BD-DPORECD                     VALUE "MCFPCS0900".
               88  BD-DPOITEM                     VALUE "MCFPCS1000".
               88  BD-DPODTAITM                   VALUE "MCFPCS1100".
               88  BD-DRCVTRAK                    VALUE "MCFPCS6400".
           03  WS-BD-LIBR-NAME    PIC X(10)       VALUE SPACE.
           03  WS-BD-MBR-NAME     PIC X(10)       VALUE SPACE.
           03  WS-BD-EVENT        PIC X(01)       VALUE SPACE.
               88  BD-RECORD-INSERT               VALUE "1".
               88  BD-RECORD-DELETE               VALUE "2".
               88  BD-RECORD-UPDATE               VALUE "3".
           03  WS-BD-TIME         PIC X(01)       VALUE SPACE.
           03  WS-BD-COMMIT-LVL   PIC X(01)       VALUE SPACE.
           03  FILLER             PIC X(03)       VALUE SPACE.
           03  WS-BD-CCSID         PIC 9(08) BINARY VALUE ZERO.
           03  FILLER              PIC X(08)        VALUE SPACE.
           03  WS-BD-BEFORE-OS     PIC 9(08) BINARY VALUE ZERO.
           03  WS-BD-BEFORE-LENGTH PIC 9(08) BINARY VALUE ZERO.
           03  WS-BD-BEFORE-NULL1  PIC 9(08) BINARY VALUE ZERO.
           03  WS-BD-BEFORE-NULL2  PIC 9(08) BINARY VALUE ZERO.
           03  WS-BD-AFTER-OS      PIC 9(08) BINARY VALUE ZERO.
           03  WS-BD-AFTER-LENGTH  PIC 9(08) BINARY VALUE ZERO.
           03  WS-BD-AFTER-NULL1   PIC 9(08) BINARY VALUE ZERO.
           03  WS-BD-AFTER-NULL2   PIC 9(08) BINARY VALUE ZERO.
           03  FILLER              PIC X(16)      VALUE SPACE.


      *************************************************************    ****
      *  JUNK WORK FIELDS
      *************************************************************    ****
       01  WS-MISCELLANEOUS-FIELDS.

           03  WS-PORCVNO.
               05  FILLER         PIC X(11)            VALUE SPACE.
               05  WS-PORCVR      PIC X(03)            VALUE SPACE.

           03  WS-LEVEL           PIC S9(03)  COMP-3   VALUE ZERO.
           03  WS-CMPNY-KEY       PIC X(04)            VALUE "P 01".
           03  WS-CPOLOG-KEY      PIC X(04)            VALUE "POLG".
           03  WS-PLTINFO-KEY     PIC X(04)            VALUE SPACE.
           03  WS-PLANT-CODE      PIC X(04)            VALUE SPACE.
           03  WS-USERID          PIC X(10)            VALUE SPACE.
           03  WS-JOBNAME         PIC X(10)            VALUE SPACE.
           03  WS-JNBR            PIC X(06)            VALUE SPACE.
           03  WS-EDIT-ERRORS-SW  PIC X(01)            VALUE SPACE.
               88  NO-ERROR-YET                   VALUE "N".
               88  LETS-EXIT-PROGRAM              VALUE "Y".

           03  WS-CHEK-PO-FLDS-SW PIC X(01)            VALUE SPACE.
               88  CHEK-PO-FLDS-NO                VALUE "N".
               88  CHEK-PO-FLDS-YES               VALUE "Y".

           03  WS-PO-FLDS-CHGD-SW PIC X(01)            VALUE SPACE.
               88  PO-FLDS-CHGD-NO                VALUE "N".
               88  PO-FLDS-CHGD-YES               VALUE "Y".

           03  WS-EVENT-CDE       PIC X(01)            VALUE SPACE.
           03  WS-EVENT-FLD       PIC X(10)            VALUE SPACE.
               88  EVENT-INSERT               VALUE "*INSERT".
               88  EVENT-UPDATE               VALUE "*UPDATE".
               88  EVENT-DELETE               VALUE "*DELETE".

           03  WS-CALLING-PGM     PIC X(10)            VALUE SPACE.
           03  WS-CALLING-PGM-R1  REDEFINES WS-CALLING-PGM.
               05  WS-PGM-CHAR1   PIC X(01).
                   88  IBM-PROGRAM        VALUE "Q".
               05  FILLER         PIC X(09).

           03  WS-PGM-TYPE        PIC X(07)            VALUE "*PGM".

           03  WS-PGM-LIBRARY    PIC X(10)             VALUE SPACE.
           03  WS-PGM-LIBRARY-R1 REDEFINES WS-PGM-LIBRARY.
               05  WS-LIB-CHAR1   PIC X(01).
                   88  IBM-LIBRARY        VALUE "Q".
               05  FILLER         PIC X(09).

           03  WS-PGM-LIBRARY-R2 REDEFINES WS-PGM-LIBRARY.
               05  FILLER         PIC X(10).
                   88  NO-LIBRARY-FND     VALUE SPACE.
      ****************************
      **** 03  WS-PGM-LIBRARY-R3 REDEFINES WS-PGM-LIBRARY.
      ****     05  FILLER         PIC X(10).
      ****         88  PROD-PGM-LIBRARY   VALUE "MCPRD" "MCBETA".

      *==============================================================  ==
      *===              L I N K A G E    S E C T I O N              =  ==
      *==============================================================  ==
       LINKAGE SECTION.
       01  LS-BUFFER-DATA         PIC X(1500).
       01  LS-BUFFER-LENGTH       PIC X(2).


      *==============================================================  ==
      *===        P R O C E D U R E    D I V I S I O N              == =
      *=============================================================== =
       PROCEDURE DIVISION  USING LS-BUFFER-DATA LS-BUFFER-LENGTH.
       0000-PROGRAM-ENTRY.

           OPEN INPUT  PO-UPDPGM-FILE
                       DPORECD-FILE
                  I-O  PO-UPDTRG-FILE.

      *=---------------------------------------------------------------=
      *= CHECK PLANT INFO FILE BE SURE PO LOGGING IS TURNED ON FOR     =
      *= THIS PLANT -  KEY = "POLG" AND 1ST CHAR OF PLTINFODATA = "Y"  =
      *=---------------------------------------------------------------=
           MOVE WS-CPOLOG-KEY      TO  WS-ZMPLT-KEY.
           PERFORM ZMPLT-GET-MPLTINFO  THRU ZMPLT-EXIT.
           IF  WS-ZMPLT-PLTINFODTA(1:1) NOT = "Y"
               GO TO 0000-CLOSE-FILES
           END-IF.

           MOVE LS-BUFFER-DATA    TO WS-BUFFER-DATA.

           PERFORM 0010-INITIALIZE   THRU 0010-EXIT.
           PERFORM 1000-MAIN-LOGIC   THRU 1000-EXIT.

         0000-CLOSE-FILES.

           CLOSE       PO-UPDPGM-FILE
                       PO-UPDTRG-FILE
                       DPORECD-FILE.

         0000-PROGRAM-END.
             GOBACK.

      ***************************************************************  *
      * PROGRAM INIT ROUTINE
      ***************************************************************  *
       0010-INITIALIZE.

           CALL "GETDTSTMP2" USING WS-SYSTEM-DATE-TIME2.
           CALL "GETJOBACL"  USING WS-USERID  WS-JOBNAME  WS-JNBR.

      *=---------------------------------------------------------------=
      *= GET THE COMPANY CODE                                          =
      *=---------------------------------------------------------------=
           MOVE WS-CMPNY-KEY       TO  WS-ZMPLT-KEY.
           PERFORM ZMPLT-GET-MPLTINFO  THRU ZMPLT-EXIT.
           MOVE WS-ZMPLT-PLTINFODTA(1:3) TO WS-PLANT-CODE.

       0010-EXIT.
           EXIT.

      ***************************************************************  **
      * MAIN LOGIC ROUTINE
      ***************************************************************  **
       1000-MAIN-LOGIC.

           PERFORM 1100-EDIT-CHECKS           THRU 1100-EXIT.
           IF LETS-EXIT-PROGRAM
              GO TO 1000-EXIT
           END-IF.

      *=---------------------------------------------------------------=
      *=  AT THIS POINT ALL EDITS HAVE PASSED & AT LEAST ONE OF THE    =
      *=  FOLLOWING WILL TAKE PLACE:                                   =
      *=    1) LOG RECORD MAYBE WRITTEN DEPENDING ON "LOGTIME" VALUE   =
      *=       LOGTIME = "X" - LOGGING IS DONE EXTERNALLY BY APP PGM   =
      *=                       USING THE SCRATCH RECORD                =
      *=       LOGTIME = "T" - LOGGING IS DONE @ TRIGGER TIME          =
      *=                                                               =
      *=    2) PO UPD SCRATCH FILE WILL BE UPDATED(WRT\REWRT)          =
      *=       WRITE  ==> USER\JOB\JNBR\PO#\EVENT\TIMESTAMP            =
      *=       REWRT  ==> PO#                                          =
      *=---------------------------------------------------------------=

      *=---------------------------------------------------------------=
      *== SET EVENT FIELD VALUE                                        =
      *=---------------------------------------------------------------=
           PERFORM 3000-SET-THE-EVENT     THRU 3000-EXIT.


      *=---------------------------------------------------------------=
      *= CALL THE LOG PROGRAM                                          =
      *=---------------------------------------------------------------=
           IF LOGTIME = "T"
               PERFORM 7000-CALL-CPOLOG   THRU 7000-EXIT
           END-IF.

      *=---------------------------------------------------------------=
      *= WRITE OR REWRITE TRIGGER SCRATCH RECORD                       =
      *=---------------------------------------------------------------=
           PERFORM 9000-READK-PO-UPDTRG-2  THRU 9000-READK2-EXIT.
           IF  FS-GOOD-FILE-IO
               PERFORM 9000-REWRT-PO-UPDTRG    THRU 9000-REWRT-EXIT
           ELSE
               PERFORM 9000-WRITE-PO-UPDTRG    THRU 9000-WRITE-EXIT
           END-IF.

       1000-EXIT.
           EXIT.

      *********************************************************************
      * GET BEFORE/AFTER RECORD IMAGES                                 D
      *********************************************************************
       1100-EDIT-CHECKS.

           SET NO-ERROR-YET       TO TRUE.

      *=---------------------------------------------------------------=
      *= GET THE DATABASE RECORDS FROM BUFFER DATA                     =
      *=---------------------------------------------------------------=
           PERFORM 2000-GET-DATABASE-RECORDS  THRU 2000-EXIT.


      *=---------------------------------------------------------------=
      *= IF DPORECD IS DELETED PROCESS A MAJOR PO DELETE REQUEST       =
      *=---------------------------------------------------------------=
           IF  BD-DPORECD
           AND BD-RECORD-DELETE

               PERFORM 1120-MAJOR-DELETE       THRU 1120-EXIT
               GO TO 1100-EXIT

           END-IF.


      *=---------------------------------------------------------------=
      *= ------- ONE LOG RECORD CREATED PER SCRATCH RECORD -------     =
      *= IF A SCRATCH RECORD EXISTS FOR THIS USR\JOB\JNBR\PO# THEN     =
      *= EXIT PROGRAM BECAUSE EITHER CHANGES TO THIS PO HAVE ALREADY   =
      *= BEEN LOGGED(LOGTIME="T") OR THEY WILL BE LOGGED EXTERNALLY.   =
      *=---------------------------------------------------------------=
           PERFORM 1110-CHECK-UPDTRG-FILE  THRU 1110-EXIT.
           IF LETS-EXIT-PROGRAM
              GO TO 1100-EXIT
           END-IF.


      *=---------------------------------------------------------------=
      *== GET THE CALLING PROGRAM (THE PGM THAT DID THE UPDATE)        =
      *=---------------------------------------------------------------=
           MOVE SPACE            TO WS-CALLING-PGM.
           MOVE 1                TO WS-LEVEL.
           PERFORM 4000-GET-CALLING-PGM    THRU 4000-EXIT.


      *=---------------------------------------------------------------=
      *= ONLY PROGRAM NAMES IN FILE MCFPPOUPGM CAN TRIGGER A LOGGING   =
      *= EVENT - MAKE SURE THE CALLING PROGRAM IS IN FILE MCFPPOUPGM   =
      *=---------------------------------------------------------------=
           PERFORM 9100-READK-PO-UPDPGM    THRU 9100-READK-EXIT.
           IF FS-RECORD-NOT-FOUND
              SET LETS-EXIT-PROGRAM TO TRUE
              GO TO 1100-EXIT
           END-IF.

      *=---------------------------------------------------------------=
      *= GET DPORECD                                                   =
      *=---------------------------------------------------------------=
           PERFORM 9200-READK-DPORECD      THRU 9200-READK-EXIT.
           IF FS-RECORD-NOT-FOUND
              SET LETS-EXIT-PROGRAM TO TRUE
              GO TO 1100-EXIT
           END-IF.


      *=---------------------------------------------------------------=
      **   IF BUYER CODE = BLANKS
      ***     PO ADD IN PROGRESS BUT NOT COMPLETE - EXIT PROGRAM
      *=---------------------------------------------------------------=
           IF  BUYERCDE  OF DPORECD-REC = SPACE
               SET LETS-EXIT-PROGRAM TO TRUE
               GO TO 1100-EXIT
           END-IF.


       1100-EXIT.
           EXIT.

      *************************************************************    ****
      * CHEK THE UPD TRIGGER SCRATCH FILE FOR USER\JOB\JNBR RECORD     D
      *************************************************************    ****
       1110-CHECK-UPDTRG-FILE.

           PERFORM 9000-READK-PO-UPDTRG    THRU 9000-READK-EXIT.
           IF  FS-RECORD-NOT-FOUND
               GO TO 1110-EXIT
           END-IF.

      *---------------------------
      ***  A MAJOR DELETE
      *---------------------------
           IF  BD-DPORECD
           AND BD-RECORD-DELETE
               GO TO 1110-EXIT
           END-IF.

      *---------------------------
      ***  PROCESS'G THE SAME PO
      *---------------------------
           IF  WS-PORCVNO = JPONO
               SET LETS-EXIT-PROGRAM TO TRUE
               GO TO 1110-EXIT
           END-IF.


       1110-EXIT.
            EXIT.

      *************************************************************    ****
      * PROCESS A MAJOR DELETE REQUEST - ENTIRE PO HAS BEEN DELETED    D
      *************************************************************    ****
       1120-MAJOR-DELETE.

      *=---------------------------------------------------------------=
      *== GET THE CALLING PROGRAM (THE PGM THAT DID THE UPDATE)        =
      *=---------------------------------------------------------------=
           MOVE SPACE            TO WS-CALLING-PGM.
           MOVE 1                TO WS-LEVEL.
           PERFORM 4000-GET-CALLING-PGM    THRU 4000-EXIT.

      *=---------------------------------------------------------------=
      *= MAKE SURE THE CALLING PROGRAM IS IN FILE MCFPCS7400           =
      *=---------------------------------------------------------------=
           PERFORM 9100-READK-PO-UPDPGM    THRU 9100-READK-EXIT.
           IF  FS-RECORD-NOT-FOUND
               SET LETS-EXIT-PROGRAM TO TRUE
               GO TO 1120-EXIT
           END-IF.


      *=---------------------------------------------------------------=
      *= LINE ITEMS MAY HAVE BEEN DELETED 1ST THUS CREATING AN "UPDATE"=
      *= TRIGGER RECORD - REMOVE IT SO A "DELETE" RECORD CAN BE WRITTEN=
      *=---------------------------------------------------------------=
           PERFORM 9000-READK-PO-UPDTRG-2    THRU 9000-READK2-EXIT.
           IF  FS-GOOD-FILE-IO
               PERFORM 9000-DELET-PO-UPDTRG  THRU 9000-DELET-EXIT
           END-IF.

       1120-EXIT.
            EXIT.

      *************************************************************    ****
      * DIG THE DATABASE RECORD OUT OF THE TRIGGER BUFFER AREA BASE    D
      * ON EVENT CRITERIA - ADD/CHG/DEL - BEFORE/AFTER
      *************************************************************    ****
       2000-GET-DATABASE-RECORDS.

           MOVE SPACE              TO WS-A-DBR  WS-B-DBR  WS-DB-REC.
           IF  BD-RECORD-DELETE
           OR  BD-RECORD-UPDATE
               COMPUTE WS-B-STR = (WS-BD-BEFORE-OS + 1)
               COMPUTE WS-B-LEN =  WS-BD-BEFORE-LENGTH
               MOVE LS-BUFFER-DATA(WS-B-STR:WS-B-LEN)  TO WS-B-DBR
               MOVE LS-BUFFER-DATA(WS-B-STR:WS-B-LEN)  TO WS-DB-REC
           END-IF.


           IF  BD-RECORD-UPDATE
           OR  BD-RECORD-INSERT
               COMPUTE WS-A-STR = (WS-BD-AFTER-OS + 1)
               COMPUTE WS-A-LEN =  WS-BD-AFTER-LENGTH
               MOVE LS-BUFFER-DATA(WS-A-STR:WS-A-LEN) TO WS-A-DBR
               MOVE LS-BUFFER-DATA(WS-A-STR:WS-A-LEN) TO WS-DB-REC
           END-IF.

      *=---------------------------------------------------------------=
      *= GET THE PO NUMBER                                             =
      *= SOMETIMES THE PO# IS 1ST 14 CHARACTERS                        =
      *=---------------------------------------------------------------=
           IF  BD-DPORECD
           OR  BD-DPODTAITM
           OR  BD-DRCVTRAK
               MOVE  WS-DB-REC(1:14)   TO WS-PORCVNO
           END-IF.

      *=---------------------------------------------------------------=
      *== AND SOMETIMES THE PO# IS ELSE WHERE                          =
      *=---------------------------------------------------------------=
           IF  BD-DPOITEM
               MOVE  WS-DB-REC(89:14)  TO WS-PORCVNO
           END-IF.

           MOVE  ZERO               TO WS-PORCVR.

          2000-EXIT.
              EXIT.

      *************************************************************    ****
      * DETERMINE VALUE OF EVENT FIELD                                 D
      *************************************************************    ****
       3000-SET-THE-EVENT.

      *=---------------------------------------------------------------=
      *=  DEFAULT EVENT = *UPDATE                                      =
      *=   -- INSERTS & DELETES TO "PARTS" OF THE PO ARE TREATED AS    =
      *=      UPDATES TO THE OVERALL PO                                =
      *=---------------------------------------------------------------=
           SET EVENT-UPDATE TO TRUE.

      *=---------------------------------------------------------------=
      *=  IF DPORECD AND THE BEFORE IMAGE BUYER CODE = BLANKS          =
      *=  AND THE AFTER IMAGE BUYER CODE > BLANKS                      =
      *=      THEN A PO HAS BEEN ADDED - SET EVENT TO *INSERT          =
      *=---------------------------------------------------------------=
           IF  BD-DPORECD
               IF  WS-B-DBR(201:4)  = SPACE
               AND WS-A-DBR(201:4)  > SPACE
                   SET EVENT-INSERT  TO TRUE
               END-IF
           END-IF.


           IF  BD-DPORECD
           AND BD-RECORD-DELETE
               SET EVENT-DELETE  TO TRUE
           END-IF.

       3000-EXIT.
           EXIT.

      *************************************************************    ****
      * GET THE CALLING PROGRAM NAME FROM THE CALL STACK               D
      *************************************************************    ****
       4000-GET-CALLING-PGM.

           ADD   1              TO WS-LEVEL.
           CALL "GETPGMCL"  USING WS-LEVEL  WS-CALLING-PGM.


           MOVE SPACE           TO WS-PGM-LIBRARY.
           CALL "GETOBJLIB" USING WS-CALLING-PGM
                                  WS-PGM-LIBRARY
                                  WS-PGM-TYPE.

           IF  IBM-LIBRARY
           OR  IBM-PROGRAM
           OR  NO-LIBRARY-FND
               GO TO 4000-GET-CALLING-PGM
           END-IF.


       4000-EXIT.
           EXIT.

      *************************************************************    ****
      * BUILD PARM LIST AND CALL PO UPD LOG PROGRAM - CPOLOG           D
      *************************************************************    ****
       7000-CALL-CPOLOG.

           INITIALIZE  LS-CPOLOG-PARMS.

           MOVE  WS-PLANT-CODE  TO LS-CPOLOG-PLANT-CODE.
           MOVE  WS-PORCVNO     TO LS-CPOLOG-PO-NUMBER.
           MOVE  WS-BD-EVENT    TO LS-CPOLOG-IO-EVNTCD.
           MOVE  WS-EVENT-FLD   TO LS-CPOLOG-IO-EVNTDS.

           CALL "CPOLOG"  USING LS-CPOLOG-PARMS.

       7000-EXIT.
           EXIT.

       COPY ZMPLTSUBR  IN COPYLIB.

      *****************************************************************
      **  READ BY KEY FILE MCFPPOUTRG
      *****************************************************************
       9000-READK-PO-UPDTRG.

           INITIALIZE PO-UPDTRG-REC.
           MOVE  WS-USERID          TO USER.
           MOVE  WS-JOBNAME         TO JOBNAME.
           MOVE  WS-JNBR            TO JNUMBER.

           READ PO-UPDTRG-FILE  NO LOCK
           END-READ.

       9000-READK-EXIT.
           EXIT.

      *****************************************************************
      **  READ BY KEY FILE MCFPPOUTRG
      *****************************************************************
       9000-READK-PO-UPDTRG-2.

           INITIALIZE PO-UPDTRG-REC.
           MOVE  WS-USERID          TO USER.
           MOVE  WS-JOBNAME         TO JOBNAME.
           MOVE  WS-JNBR            TO JNUMBER.

           READ PO-UPDTRG-FILE
           END-READ.

       9000-READK2-EXIT.
           EXIT.

      *****************************************************************
      ***  WRITE FILE MCFPPOTRG
      *****************************************************************
       9000-WRITE-PO-UPDTRG.

           INITIALIZE PO-UPDTRG-REC.
           MOVE  WS-USERID          TO USER.
           MOVE  WS-JOBNAME         TO JOBNAME.
           MOVE  WS-JNBR            TO JNUMBER.
           MOVE  WS-PORCVNO         TO JPONO.
           MOVE  WS-PLANT-CODE      TO PLANT.

           IF  EVENT-INSERT
               MOVE  "1"            TO EVNTCD
           END-IF.

           IF  EVENT-DELETE
               MOVE  "2"            TO EVNTCD
           END-IF.

           IF  EVENT-UPDATE
               MOVE  "3"            TO EVNTCD
           END-IF.

           MOVE  WS-EVENT-FLD       TO EVNTDS.
           MOVE  WS-SYSTEM-DATE-TIME2 TO DATETIME14.

           WRITE  PO-UPDTRG-REC
           END-WRITE.

       9000-WRITE-EXIT.
           EXIT.

      *****************************************************************
      ***  REWRITE FILE MCFPPOTRG
      *****************************************************************
       9000-REWRT-PO-UPDTRG.

           MOVE  WS-PORCVNO         TO JPONO.

           REWRITE  PO-UPDTRG-REC
           END-REWRITE.

       9000-REWRT-EXIT.
           EXIT.

      *****************************************************************
      ***  DELETE  FILE MCFPPOTRG
      *****************************************************************
       9000-DELET-PO-UPDTRG.

           DELETE   PO-UPDTRG-FILE
           END-DELETE.

       9000-DELET-EXIT.
           EXIT.

      *****************************************************************
      ***  READ BY KEY FILE MCFPCS0900  (DPORECD)
      *****************************************************************
       9100-READK-PO-UPDPGM.

           INITIALIZE PO-UPDPGM-REC.
           MOVE  WS-CALLING-PGM     TO PROGNAME.

           READ PO-UPDPGM-FILE
           END-READ.

       9100-READK-EXIT.
              EXIT.

      *****************************************************************
      ***  READ BY KEY FILE MCFPCS0900  (DPORECD)
      *****************************************************************
       9200-READK-DPORECD.

           INITIALIZE DPORECD-REC.
           MOVE  WS-PORCVNO         TO PORCVNO OF DPORECD-REC.

           READ DPORECD-FILE
           END-READ.

           IF FS-RECORD-NOT-FOUND
              GO TO 9200-READK-EXIT
           END-IF.

       9200-READK-EXIT.
           EXIT.
      **************************************************************   ***
      *            E N D   O F   S O U R C E   C O D E
      **************************************************************   ***
