007700**                                                          **
007800**            D A T A B A S E   W O R K                     **
007900**                                                          **
008000**************************************************************
       01  FILE-STATUS.
           05  FILE-STATUS-1            PIC X  VALUE "0".
           05  FILE-STATUS-2            PIC X  VALUE "0".
008100
008200 COPY DBSTAT     IN COPYLIB.
008300 01  DSET-NAMES.
008400     05  DSET-MLEVEL               PIC X(16) VALUE "MLEVEL;".
008500     05  DSET-PER-PERSONNEL  PIC X(16) VALUE "PER-PERSONNEL;".
008600
008700 01  MODE-AREA.
008800     05  MODE2                     PIC S9(4)   COMP       VALUE 2.
008900     05  MODE3                     PIC S9(4)   COMP       VALUE 3.
009000     05  MODE7                     PIC S9(4)   COMP       VALUE 7.
009100
009200 01  ALL-ITEMS                     PIC X(2)  VALUE "@;".
009300 01  LEVEL-SEARCH                  PIC X(10) VALUE "LEVEL-NUM;".
009400 01  LEVEL-ARG                     PIC X(2).
009500
