DCR01 *  MMM DD, CCYY  XXNAMEXX      XXX01    REQUEST# 2005-XXXXX
DCR01 *****************************************************************

001300 ENVIRONMENT DIVISION.
001400 CONFIGURATION SECTION.
001500 SOURCE-COMPUTER.  HP-3000.
001600 OBJECT-COMPUTER.  HP-3000.
       SPECIAL-NAMES. I-O-FEEDBACK IS I-O-FEEDBACK-AREA.
001800 INPUT-OUTPUT SECTION.
001900 FILE-CONTROL.
002000     SELECT SORT-FILE ASSIGN TO DISK-SORT.
002100     SELECT LEV-FILE ASSIGN TO DISK-DEALEVIQ.
           SELECT MLEVEL-I
                  ASSIGN TO DATABASE-MCFLCS4101
                  ORGANIZATION IS INDEXED
                    ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                  FILE STATUS IS FILE-STATUS.

           SELECT PER-PERSONNEL-I
                  ASSIGN TO DATABASE-MCFLMM0301
                  ORGANIZATION IS INDEXED
                    ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                  FILE STATUS IS FILE-STATUS.

           SELECT DISPLAY-FILE
                  ASSIGN TO WORKSTATION-ZSEALEVIQ-SI
                  ORGANIZATION IS TRANSACTION
                  ACCESS IS SEQUENTIAL
                  FILE STATUS IS DISPLAY-STATUS
                  CONTROL-AREA IS WS-CONTROL.
001700
002200
002300 DATA DIVISION.
002400 FILE SECTION.
002500 FD  LEV-FILE.
002600 01  LEV-REC.
002700     05  LV-LEVEL-NUM              PIC X(2).
002800     05  LV-LEVEL-DESC             PIC X(36).
002900     05  LV-ACTIVE-EMPL            PIC X(4).
003000
003100 SD  SORT-FILE.
003200 01  SORT-REC.
003300     05  SORT-LV                   PIC X(2).
003400     05  SORT-DESC                 PIC X(36).
           05  SORT-ACTIVE-EMPL          PIC X(4).
003500
       FD  MLEVEL-I
           LABEL RECORDS ARE STANDARD.
       01  MLEVEL-REC-I.
           COPY DDS-MCRPCS4100  OF MCFLCS4101.

       FD  PER-PERSONNEL-I
           LABEL RECORDS ARE STANDARD.
       01  PER-PERSONNEL-REC-I.
           COPY DDS-MCRPMM0300  OF MCFLMM0301.

       FD  DISPLAY-FILE
           LABEL RECORDS ARE OMITTED.
       01  DISPLAY-REC        PIC X(2000).

003600 WORKING-STORAGE SECTION.
003700
003800 77  SUB                           PIC S9(4) COMP-4 VALUE 0.
004200 77  END-OF-LEVS-FLAG              PIC X(1)  VALUE SPACES.
004300
