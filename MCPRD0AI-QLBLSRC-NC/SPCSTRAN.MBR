000200 IDENTIFICATION DIVISION.
000300 PROGRAM-ID.     SPCSTRAN.
000400 AUTHOR.         CA YODER.
000500 DATE-WRITTEN.   OCTOBER 1995.
000600 DATE-COMPILED.
000700 INSTALLATION.   THE GOODYEAR TIRE AND RUBBER COMPANY - AKRON.
000800*REMARKS.
000900**************************************************************
001000*                                                            *
001100*    SPCSTRAN          EDI   TERMS OF TRANSPORT              *
001200*                                                            *
001300*     THIS PROGRAM IS USED TO ADD PAYMENT METHODS AND        *
001400*     TERMS OF DELIVERY AS WELL AS MODES OF TRANSPORT        *
001500*                                                            *
      *     ** COPIED FROM SEDITRAN AND MODIFIED **                *
      *                                                            *
001600*     THIS PROGRAM IS CALLED BY:                             *
001700*                       1.  SPUROPT                          *
001800*                                                            *
001900**************************************************************
002000
002100 ENVIRONMENT DIVISION.
002200 CONFIGURATION SECTION.
002300 SOURCE-COMPUTER.  AS400.
002400 OBJECT-COMPUTER.  AS400.
       SPECIAL-NAMES. I-O-FEEDBACK IS I-O-FEEDBACK-AREA.
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT DISPLAY-FILE
                  ASSIGN TO WORKSTATION-ZSTARTUP-SI
                  ORGANIZATION IS TRANSACTION
                  ACCESS IS SEQUENTIAL
                  FILE STATUS IS DISPLAY-STATUS
                  CONTROL-AREA IS WS-CONTROL.

            SELECT MPLTINFO-PK-O
                ASSIGN TO DATABASE-MCFLCS0501
                ORGANIZATION IS INDEXED
                  ACCESS MODE IS DYNAMIC
                RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                FILE STATUS IS FILE-STATUS.
002500
002600 DATA DIVISION.
       FILE SECTION.
       FD  DISPLAY-FILE
           LABEL RECORDS ARE OMITTED.
       01  DISPLAY-REC                   PIC X(2000).

       FD  MPLTINFO-PK-O
           LABEL RECORDS ARE STANDARD.
       01  MPLTINFO-PK-REC-O.
           COPY DDS-MCRPCS0500 OF MCFLCS0501.
002800
002700 WORKING-STORAGE SECTION.
002900 77  WS-MODE                       PIC X(1)       VALUE " ".
003000     88 ADD-MODE                                  VALUE "A".
003100     88 MODIFY-MODE                               VALUE "M".
003200     88 DELETE-MODE                               VALUE "D".
003300 77  HANDLE-BLOWUP-FLAG            PIC X(1)       VALUE "Y".
003400 77  WS-EDI-INSTAL                 PIC X(1)       VALUE SPACES.
003500 77  PASSED-SPOOL-PRT              PIC S9(2) COMP VALUE 0.
       01  DISPLAY-STATUS                PIC XX.
       01  FILE-STATUS                   PIC XX.
003600*************************************************************
003700*************************************************************
003800**                                                         **
003900**              D A T A    B A S E    A R E A              **
004000**                                                         **
004100*************************************************************
004200*************************************************************
004300
004400 COPY MPLTINFO IN COPYLIB.
004500
004600 01  DSET-NAMES.
004700     05  DSET-NAME                 PIC X(16)  VALUE SPACES.
004800     05  DSET-MPLTINFO             PIC X(16)  VALUE "MPLTINFO;".
004900
005000 01  ARG-VALUES.
005100     05  MPLTINFO-ARG              PIC X(4)   VALUE SPACES.
005200     05  PLT-ARG                   PIC X(4)   VALUE SPACES.
005300
005400 01  SEARCH-ITEMS.
005500     05  ALL-ITEMS                 PIC X(2)  VALUE "@;".
005600
005700 01  DB-LOG-VALUES.
005800     05  DB-LOG-TEXT               PIC X(8)  VALUE "SPCSTRAN".
005900     05  DB-LOG-TEXT-LEN           PIC S9(4) COMP  VALUE -8.
006000
006100 01  MESSAGE-BUFLEN                PIC S9(4) COMP VALUE 78.
006200 01  MESSAGE-ACTLEN                PIC S9(4) COMP VALUE 78.
006300 01  MSG-ACTUALEN                  PIC S9(4) COMP VALUE 78.
006400 01  FIELD-NUMBER                  PIC S9(4) COMP VALUE 1.
006500
006600 01  MESSAGE-BUFFER.
006700     05  MSG-TEXT                  PIC X(66)  VALUE SPACES.
006800     05  MSG-FLD                   PIC X(12)  VALUE SPACES.
006900
006600 01  MESSAGE-BUFFER-1.
006700     05  MSG-TEXT-1                PIC X(66)  VALUE SPACES.
006800     05  MSG-FLD-1                 PIC X(12)  VALUE SPACES.
006900
007000 01  MPLTINFO-KEY1.
007100     05  FILLER                    PIC X(2)   VALUE "TP".
007200     05  TRANS-PAY-METHOD-IN       PIC X(2)   VALUE SPACES.
007300
007400 01  MPLTINFO-KEY2.
007500     05  FILLER                    PIC X(1)   VALUE "D".
007600     05  TERMS-OF-DELIVERY-IN      PIC X(3)   VALUE SPACES.
007700
007800
007900 COPY DBMODES IN COPYLIB.
008000
008100 COPY DBSTAT  IN COPYLIB.
008200
008500*************************************************************
008600*************************************************************
008700**                                                         **
008800**                 TERMINAL I/O DATA AREA                  **
008900**                                                         **
009000*************************************************************
009100*************************************************************
009200
009300 COPY FUNCTDEF IN COPYLIB.
009400
009500
009600 01  DE-FIELDS-1.
009700     05  WS-MESSAGE-LINE-MENU      PIC X(79).
           05  DE-COMMAND-LINE-1         PIC X(79).
           05  DE-MESSAGE-LINE-1         PIC X(79).
009800
009900 01  DE-FIELDS-2.
010000     05  TRANS-PAY-METHOD          PIC X(2).
           05  TRANS-PAY-METHOD-DEF      PIC X(39).
010100     05  TERMS-OF-DELIVERY         PIC X(3).
           05  TERMS-OF-DELIVERY-DEF     PIC X(39).
010200     05  WS-MESSAGE-LINE           PIC X(79).
           05  DE-COMMAND-LINE-2         PIC X(79).
           05  DE-MESSAGE-LINE-2         PIC X(79).
010300
010400*************************************************************
010500*************************************************************
010600**                                                         **
010700**                 COMMUNICATIONS AREAS                    **
010800**                                                         **
010900*************************************************************
011000*************************************************************
011100
       COPY CATREAD    IN COPYLIB.

       COPY IOFEEDBACK IN COPYLIB.

011200 COPY TSHWRDFM   IN COPYLIB.
011300***** NOTE THAT "TSCRPRT2" ALSO USES PASSED-SPOOL-PRT, *****
011400***** AND VIEW-COMAREA AS PARAMETERS IN ADDITION TO    *****
011500***** THOSE LISTED BELOW.                              *****
011600
011700 01  TSCRPRT2-PARAMETERS.
011800     05  TSCRPRT2-PRINTCNTL        PIC S9(4) COMP VALUE 0.
011900     05  TSCRPRT2-PAGECNTL         PIC S9(4) COMP VALUE 49.
012000     05  TSCRPRT2-SPOOLSW          PIC X(1)  VALUE "N".
012100
012200 01  TSCRPRT2-ERROR-SW             PIC X(1)  VALUE "N".
012300
012400 01  TSCRPRT2-DISPLAY-AREA.
012500     05     FILLER                 PIC X(2).
012600     05  TSCRPRT2-MSG              PIC X(27).
012700     05     FILLER                 PIC X(2).
012800     05  TSCRPRT2-STAT             PIC S9(4).
012900     05     FILLER                 PIC X(2).
013000     05  TSCRPRT2-FLD              PIC X(14).
013100     05     FILLER                 PIC X(2).
013200
013300 COPY TBLOWUP   IN COPYLIB.
013400
       COPY WSCONTROL IN COPYLIB.
013500*************************************************************
013600*************************************************************
013700**                                                         **
013800**               LINKAGE   SECTION                         **
013900**                                                         **
014000*************************************************************
014100*************************************************************
014200
014300 LINKAGE SECTION.
014400
014500 01  BASE                          PIC X(10).
014600
014700 COPY VCOMLINK IN COPYLIB.
014800
014900 COPY LANGSUB  IN COPYLIB.
015000
015100
015200*************************************************************
015300**#########################################################**
015400*************************************************************
015500**                                                         **
015600**          P R O C E D U R E    D I V I S I O N           **
015700**                                                         **
015800*************************************************************
015900**#########################################################**
016000*************************************************************
016100
016200 PROCEDURE DIVISION USING BASE,
016300                          VIEW-COMAREA,
016400                          LANGUAGE-PARMS.
016500
016600 0-SBUYRCODE-SEC SECTION 1.
016700
016800 0-BEGIN-HERE.
016900     PERFORM 1-HSK.
017000     PERFORM 6-MAIN THRU 6-MAIN-X.
017100     PERFORM 2-EOJ.
017200
017300 1-HSK.
017400     MOVE "SPCSTRAN" TO BU-PGM-NAME.
017500     OPEN I-O DISPLAY-FILE, MPLTINFO-PK-O.
           MOVE "N"        TO WS-EDI-INSTAL.
017600     MOVE "EDI "       TO MPLTINFO-ARG PLT-ARG.
017700     PERFORM 9999-GETKEY-MPLTINFO-PK-O.
017800     IF  FILE-STATUS = "00"
017900         IF  EDI-INSTAL = "Y"
018000             MOVE  "Y"  TO  WS-EDI-INSTAL.
           PERFORM 9999-RESET-MPLTINFO-PK-O.
018500 2-EOJ.
           CLOSE DISPLAY-FILE, MPLTINFO-PK-O.
018600     GOBACK.
018700
018800******************************************************
018900**                 BLOWUP ROUTINE                   **
019000******************************************************
019100
019200 2100-BLOWUP.
019300     CALL "TBLOWUP" USING BASE, BU-PGM-NAME, STATUS-AREA,
019400           VIEW-COMAREA, DUMMY-KSAM-STAT, BU-DISPLAY-MSG,
019500           BU-DISPLAY-AREA.
021700
021800**************************************************
021900*                                                *
022000*                  6 - M A I N                   *
022100*                                                *
022200**************************************************
022300 6-MAIN.
022400     MOVE "TRANMENU" TO VIEW-NFNAME.
022500     PERFORM 9999-GETNEXTFORM.
022600     MOVE SPACES TO DE-FIELDS-1.
022700 6-PUT-WINDOW.
022800     MOVE SPACES TO MESSAGE-BUFFER.
022900     PERFORM 9999-PUTWINDOW.
023000
023100 6-SHOW-FORM.
023200     MOVE 6                  TO SRF-KEYSET.
023300     MOVE "I"                TO SRF-FKEY(7).
023500     PERFORM 9999-DO-SCREEN-1.
023600
023700     IF VIEW-LASTKEY = EXIT-PROGRAM
023800         GO TO 6-MAIN-X.
023900
024400     IF VIEW-LASTKEY = F1-KEY
024500        PERFORM  61-ADD-EDI-TRANSTERMS THRU
024600                 61-ADD-EDI-TRANSTERMS-X
024700        GO TO 6-MAIN.
024800
           IF VIEW-LASTKEY = F2-KEY
               CALL "SPCSMODE" USING BASE, VIEW-COMAREA,
                                 LANGUAGE-PARMS
               GO TO 6-MAIN.

024900     GO TO 6-MAIN.
025000
025100 6-MAIN-X.
025200     EXIT.
025300
025400
025500 61-ADD-EDI-TRANSTERMS.
025600     MOVE "TRANADD" TO VIEW-NFNAME.
025700     PERFORM 9999-GETNEXTFORM.
025800     MOVE SPACES             TO DE-FIELDS-2.
025900*** INPUT DATA ABOVE AND THEN PRESS ENTER
           MOVE 09020              TO CATREAD-MSG-NUMBER.
026200     PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
026300     MOVE MESSAGE-BUFFER     TO WS-MESSAGE-LINE.
026400     MOVE SPACES             TO MESSAGE-BUFFER.
026500     PERFORM 9999-PUTWINDOW.
026600     MOVE 6                  TO SRF-KEYSET.
026700     MOVE "I"                TO SRF-FKEY(7).
026800 61-ADD-EDI-ACCEPT-SCREEN.
026900     PERFORM 9999-DO-SCREEN-2.
027000
027100     IF VIEW-LASTKEY = EXIT-PROGRAM
027200         GO TO 61-ADD-EDI-TRANSTERMS-X.
027300
027800     IF VIEW-LASTKEY = F1-KEY  OR VIEW-LASTKEY = F2-KEY
027900         PERFORM 65-HELP-SCREEN THRU 65-HELP-SCREEN-X
028000         GO TO 61-ADD-EDI-TRANSTERMS.
028100
028200     IF VIEW-LASTKEY = ENTER-KEY
028300        PERFORM 61-PUT-EDI-TRANSTERM-KEYS.
028400
028500     GO TO 61-ADD-EDI-TRANSTERMS.
028600
028700 61-ADD-EDI-TRANSTERMS-X.
028800     EXIT.
028900
029000 61-PUT-EDI-TRANSTERM-KEYS.
029100     MOVE DSET-MPLTINFO      TO DSET-NAME.
           PERFORM 9999-DSET-LOCK.
           IF TRANS-PAY-METHOD = SPACES
               NEXT SENTENCE
           ELSE
029300     MOVE TRANS-PAY-METHOD      TO TRANS-PAY-METHOD-IN
029400     MOVE MPLTINFO-KEY1         TO PLT-ARG
029500     PERFORM 9999-GETKEY-MPLTINFO-PK-O
029600     IF GOOD-CALL
029700* RECORD EXISTING
029800         MOVE 44013          TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER TO DE-MESSAGE-LINE-2
               MOVE 3              TO SRF-ERROR-FLD
               GO TO 61-ADD-EDI-ACCEPT-SCREEN
029900     ELSE
030000     MOVE SPACES                TO BUF-MPLTINFO
030100     MOVE MPLTINFO-KEY1         TO MPLTINFO-KEY
           MOVE TRANS-PAY-METHOD-DEF  TO MPLTINFO-DATA
030200     PERFORM 9999-PUT-MPLTINFO-PK-O.
           IF TERMS-OF-DELIVERY = "   "
               NEXT SENTENCE
           ELSE
030300     MOVE TERMS-OF-DELIVERY     TO TERMS-OF-DELIVERY-IN
030400     MOVE MPLTINFO-KEY2         TO PLT-ARG
030500     PERFORM 9999-GETKEY-MPLTINFO-PK-O
030600     IF GOOD-CALL
030700* RECORD EXISTING
029800         MOVE 44013          TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER TO DE-MESSAGE-LINE-2
               MOVE 4              TO SRF-ERROR-FLD
               GO TO 61-ADD-EDI-ACCEPT-SCREEN
030900     ELSE
031000     MOVE SPACES                TO BUF-MPLTINFO
031100     MOVE MPLTINFO-KEY2         TO MPLTINFO-KEY
           MOVE TERMS-OF-DELIVERY-DEF TO MPLTINFO-DATA
031200     PERFORM 9999-PUT-MPLTINFO-PK-O.
           PERFORM 9999-UNLOCK.
031400
031500 65-HELP-SCREEN.
031600     IF  VIEW-LASTKEY = F1-KEY
031700         MOVE "HELP7"  TO VIEW-NFNAME
031800     ELSE
031900         MOVE "HELP8"  TO VIEW-NFNAME.
032000     PERFORM 9999-GETNEXTFORM.
032100     MOVE SPACES   TO DE-FIELDS-1.
032200 65-PUT-WINDOW.
032300     MOVE SPACES   TO MESSAGE-BUFFER.
032400     PERFORM 9999-PUTWINDOW.
032500 65-SHOW-FORM.
032600     MOVE 8         TO SRF-KEYSET.
032700     MOVE "I"       TO SRF-FKEY(7).
032800     PERFORM 9999-DO-SCREEN-1.
033100 65-HELP-SCREEN-X.
033200     EXIT.
033300
033400 999-CATREAD.
           MOVE SPACES TO MESSAGE-BUFFER.
           CALL "CCATREAD" USING CATREAD-PARMS.
           MOVE CATREAD-MSG-TEXT TO MESSAGE-BUFFER.
       999-CATREAD-EXIT.    EXIT.

       9999-GETKEY-MPLTINFO-PK-O.
           MOVE 0 TO COND-WORD.
           MOVE PLT-ARG TO PLTINFOKEY OF MPLTINFO-PK-REC-O.
           READ MPLTINFO-PK-O INTO BUF-MPLTINFO
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS = "23"
               MOVE 17 TO COND-WORD
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD
               IF HANDLE-BLOWUP-FLAG = "Y"
                   MOVE "GETKEY ERR 9999-GETKEY-MPLTINFO-PK-O"
                       TO BU-MSG-AREA
                   PERFORM 2100-BLOWUP.

       9999-RESET-MPLTINFO-PK-O.
           MOVE HIGH-VALUES TO PLTINFOKEY OF MPLTINFO-PK-REC-O.
           START MPLTINFO-PK-O KEY > PLTINFOKEY OF MPLTINFO-PK-REC-O
               INVALID KEY MOVE "00" TO FILE-STATUS.

       9999-DELETE-MPLTINFO-PK-O.
           MOVE 0 TO COND-WORD.
           DELETE MPLTINFO-PK-O
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD
               IF HANDLE-BLOWUP-FLAG = "Y"
                   MOVE "DELETE ERR 9999-DELETE-MPLTINFO-PK-O"
                       TO BU-MSG-AREA
                   PERFORM 2100-BLOWUP.

       9999-PUT-MPLTINFO-PK-O.
           MOVE 0 TO COND-WORD.
           WRITE MPLTINFO-PK-REC-O FROM BUF-MPLTINFO
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD
               IF HANDLE-BLOWUP-FLAG = "Y"
                   MOVE "PUT ERR 9999-PUT-MPLTINFO-PK-O"
                       TO BU-MSG-AREA
                   PERFORM 2100-BLOWUP.

       COPY MLOCKCAL IN COPYLIB.
       COPY UNLOCK   IN COPYLIB.
       COPY DLOCKCAL IN COPYLIB.
036200 COPY SCRNCALL IN COPYLIB.
036300 COPY SCRNCL1  IN COPYLIB.
036400 COPY SCRNCL2  IN COPYLIB.
       9999-UPDATE-MPLTINFO-PK-O.
           MOVE 0 TO COND-WORD.
           REWRITE MPLTINFO-PK-REC-O FROM BUF-MPLTINFO
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD
               IF HANDLE-BLOWUP-FLAG = "Y"
                   MOVE "UPDATE ERR 9999-UPDATE-MPLTINFO-PK-O"
                       TO BU-MSG-AREA
                   PERFORM 2100-BLOWUP.

