       01  TIME-BUFFER.
           05  TIME-BUFF                     PIC X(4).
           05  FILLER                        PIC XX.
       01  TRUE-VAL                          PIC 1 VALUE B"1".
       01  WHO-VARIABLES.
           05  USERNAME                      PIC X(10).
           05  TERMNUM                       PIC X(10).
           05  CURRLIB                       PIC X(10).
           05  JOBLIBX                       PIC X.
       01  WO-BASIC-DATA.      COPY DWOBASIC OF COPYLIB.
       01  WO-PARTS-DATA.      COPY DWOPARTS OF COPYLIB.
       01  WO-PLANNED-DATA.    COPY DWOPLAN  OF COPYLIB.
       01  WO-QUEUE-DATA.      COPY DWOOPENQ OF COPYLIB.
       01  WO-TRACK-DATA.      COPY DWOTRACK OF COPYLIB.
       01  WORK-ORDER-NUMBER                 PIC X(10).
       01  WO-NUMBER-BUF.
           05  WONO-BUF.
               10  WO-NUMBER-B6              PIC X(6).
               10  WO-NUMBER-B7              PIC X.
               10  FILLER                    PIC XXX.
           05  FDUPL-CMD-LINE                PIC X(79).
           05  FDUPL-MSG-LINE                PIC X(79).
       COPY WSCONTROL OF COPYLIB.
       LINKAGE SECTION.
       01  DBPARAMETERS.       COPY DBPARMS OF COPYLIB.
       COPY VCOMLINK OF COPYLIB.
       PROCEDURE DIVISION USING DBPARAMETERS VIEW-COMAREA.
       PROCESS-DUPLICATE.
           PERFORM 1-HSK.
           PERFORM 6-MAIN THRU 6-MAIN-EXIT UNTIL VIEW-LASTKEY = 3.
       2-EOJ.
           CLOSE DISPLAY-FILE.
           CLOSE EQUIPMENT-FILE.
           CLOSE JOBPLAN-FILE.
           CLOSE JOBPLAN-FILE2.
           CLOSE PERSONNEL-FILE.
           CLOSE WO-BASIC-FILE.
           CLOSE WO-CRAFTS-MSTR-FILE.
           CLOSE WO-LAST-NUM-USED.
           CLOSE WO-PARTS-FILE.
           CLOSE WO-PARTS-FILE-2.
           CLOSE WO-PLANNED-FILE.
           CLOSE WO-STATUS-MSTR-FILE.
           CLOSE WO-ZONE-PRTY-FILE.
           CLOSE WO-NUMBER-FILE.
           GOBACK.
       1-HSK.
           OPEN I-O   DISPLAY-FILE.
           OPEN INPUT EQUIPMENT-FILE.
           OPEN INPUT JOBPLAN-FILE.
           OPEN I-O   JOBPLAN-FILE2.
           OPEN INPUT PERSONNEL-FILE.
           OPEN INPUT WO-BASIC-FILE.
           OPEN INPUT WO-CRAFTS-MSTR-FILE.
           OPEN INPUT WO-LAST-NUM-USED.
           OPEN INPUT WO-PARTS-FILE.
           OPEN I-O   WO-PARTS-FILE-2.
           OPEN I-O   WO-PLANNED-FILE.
           OPEN INPUT WO-STATUS-MSTR-FILE.
           OPEN INPUT WO-ZONE-PRTY-FILE.
           OPEN INPUT WO-NUMBER-FILE.
           MOVE 0 TO DATE-COMPARE-BUFFER.
           MOVE SPACES TO BUFFER.
           MOVE SPACES TO ARG-NO.
           CALL "CLWHO" USING USERNAME TERMNUM CURRLIB JOBLIBX.
           MOVE 0 TO COND-WORD.
           MOVE 1 TO ARG-NUM.
           READ WO-LAST-NUM-USED INTO LAST-WO-BUFF
               INVALID KEY    MOVE 15 TO COND-WORD.
           IF WLNU-STATUS NOT = "00" MOVE 15 TO COND-WORD.
           IF COND-WORD = 15 MOVE 1 TO DATE-FLAG-SW.
           MOVE DATE-FLAG-SW TO DATE-FLAG.
           MOVE DATE-FLAG TO DATE-CODE.
           MOVE 1 TO DATE-MODE.
           CALL "TDATECHK" USING DATE-CHECK-AREA.
           MOVE DATE-DB TO DATE-CURR-BUF.
           IF DATE-CURR-BUF-YY > "70"
               MOVE "19" TO DATE-CURR-BUF-CC
           ELSE
           MOVE "20" TO DATE-CURR-BUF-CC.
           ACCEPT CUR-DATE-BUFF FROM DATE.
           CALL "TPWORD" USING PASSWORD-INFORMATION.
           IF PASSWORD-FLAG = "N"
               MOVE "  PWORD" TO BLOWUP-BASE
               MOVE "FAILED PASSWORD CHECK - TDUPLSUB"
                   TO BU-DISPLAY-MSG
               PERFORM 998-BLOWUP.
           IF C-D-YDIG = 0
               MOVE "A" TO YR-SAVE
           ELSE
           IF C-D-YDIG = 1
               MOVE "B" TO YR-SAVE
           ELSE
           IF C-D-YDIG = 2
               MOVE "C" TO YR-SAVE
           ELSE
           IF C-D-YDIG = 3
               MOVE "D" TO YR-SAVE
           ELSE
           IF C-D-YDIG = 4
               MOVE "E" TO YR-SAVE
           ELSE
           IF C-D-YDIG = 5
               MOVE "F" TO YR-SAVE
           ELSE
           IF C-D-YDIG = 6
               MOVE "G" TO YR-SAVE
           ELSE
           IF C-D-YDIG = 7
               MOVE "H" TO YR-SAVE
           ELSE
           IF C-D-YDIG = 8
               MOVE "J" TO YR-SAVE
           ELSE
           MOVE "K" TO YR-SAVE.
           CALL "TESCSEQ" USING ESC-NAME.
           MOVE SPACES TO WO-NUMBER-BUF DSPLY-REC ERROR-BUFFER.
       6-MAIN.
           MOVE YR-SAVE TO WO-NUMBER-B7.
           MOVE ERROR-BUFFER TO FDUPL-MSG-LINE.
           MOVE "FDUPLWO" TO VIEW-CFNAME.
           MOVE WO-NUMBER-BUF TO DSPLY-REC.
       6-WRITE.
           PERFORM 99-SCREEN-WRITE.
           PERFORM 98-SCREEN-READ.
           MOVE DSPLY-REC TO WO-NUMBER-BUF.
           IF VIEW-LASTKEY = 1 OR 3 GO TO 2-EOJ.
           IF WO-NUMBER-B6 = "      "
               MOVE 29020 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE TRUE-VAL TO INDS (1) INDS (99)
               GO TO 6-MAIN.
           CALL "TALWONO" USING WONO-BUF RETURN-CODE.
           MOVE SPACES TO INPUT-CMD-LINE MATL-CMD-LINE FDUPL-CMD-LINE
               ERROR-BUFFER.
           PERFORM 611-GET-WONUM-ASKED4-PARA THRU 611-GWAP-EXIT.
           PERFORM 621-GMFU-VERBAL THRU 621-GMFU-EXIT.
           PERFORM 631-HM-PARA.
           IF VIEW-LASTKEY = 3
               GO TO 2-EOJ
           ELSE
           PERFORM 641-UOM-VERBAL THRU 641-UOM-EXIT
           MOVE 49008 TO CATREAD-MSG-NUMBER
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
           MOVE ERROR-BUFFER TO P-COMP-LIT
           MOVE WONO-BUF TO WO-IN
           MOVE WORK-ORDER-NUMBER TO WO-OUT
           MOVE TRUE-VAL TO INDS (98)
           IF PLANNED-SW = 0
               MOVE P-COMP-LIT    TO WOB-CMD-LINE FDUPL-CMD-LINE
               MOVE WO-BASIC-BUF  TO DSPLY-REC
               PERFORM 99-SCREEN-WRITE
               PERFORM 98A-SCREEN-READ
               CALL "CLPAUSE2"
               MOVE SPACES TO BUFFER WONO-BUF
           ELSE
           MOVE P-COMP-LIT TO WOP-CMD-LINE
           MOVE WO-PLANNED-BUF TO DSPLY-REC
           PERFORM 99-SCREEN-WRITE
           PERFORM 98A-SCREEN-READ
           CALL "CLPAUSE2"
           MOVE SPACES TO WOP-CMD-LINE.
           IF PLANNED-SW = 0 GO TO 6-MAIN-EXIT.
           MOVE SPACES TO INPUT-WA.
           MOVE "FDUPLOP1" TO VIEW-CFNAME.
           MOVE 0 TO COND-WORD.
           MOVE WONO-BUF TO WONUM OF WPFDREC.
           START WO-PARTS-FILE KEY IS = EXTERNALLY-DESCRIBED-KEY
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF WPFD-STATUS NOT = "00" MOVE 17 TO COND-WORD.
           IF COND-WORD = 17 GO TO 6-MAIN-JOBPLAN-DUP.
      *    ASTERISKED FOLLOWING LINES FROM TYLER 12-21-89
      *        MOVE 40029 TO CATREAD-MSG-NUMBER
      *        PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
      *        MOVE ERROR-BUFFER TO INPUT-CMD-LINE
      *        MOVE INPUT-WA TO DSPLY-REC
      *        MOVE TRUE-VAL TO INDS (98)
      *        PERFORM 99-SCREEN-WRITE
      *        PERFORM 98A-SCREEN-READ
      *        CALL "CLPAUSE2"
      *        MOVE SPACES TO INPUT-WA
      *        GO TO 6-MAIN-JOBPLAN-DUP.
       6-MAIN-READ-PARTS.
           IF TRUE-VAL = INDS (99)
               MOVE ERROR-BUFFER TO INPUT-MSG-LINE.
           MOVE INPUT-WA TO DSPLY-REC.
           PERFORM 99-SCREEN-WRITE.
           PERFORM 98-SCREEN-READ.
           MOVE DSPLY-REC TO INPUT-WA.
           IF VIEW-LASTKEY = 8 GO TO 6-MAIN-JOBPLAN-DUP.
           IF VIEW-LASTKEY = 3 GO TO 6-MAIN-EXIT.
           IF INPUT-X = "X"
               NEXT SENTENCE
           ELSE
           GO TO 6-MAIN-JOBPLAN-DUP.
           IF INPUT-DATE-CC = SPACES
               PERFORM 651-DUPLICATE-PARTS THRU 651-DP-EXIT
               GO TO 6-MAIN-JOBPLAN-DUP.
           IF INPUT-CC = "    "
                MOVE 31017 TO CATREAD-MSG-NUMBER
                PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                MOVE TRUE-VAL TO INDS (5) INDS (99)
                GO TO 6-MAIN-READ-PARTS.
           MOVE 0 TO COND-WORD.
           MOVE INPUT-CC TO PERCCNUM OF PFREC.
           START PERSONNEL-FILE KEY IS = EXTERNALLY-DESCRIBED-KEY
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF PF-STATUS NOT = "00" MOVE 17 TO COND-WORD.
           IF COND-WORD = 17
               MOVE 35047 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE TRUE-VAL TO INDS (5) INDS (99)
               GO TO 6-MAIN-READ-PARTS.
           IF INPUT-DATE = SPACES
               MOVE 30022 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE TRUE-VAL TO INDS (2) INDS (99)
               GO TO 6-MAIN-READ-PARTS
           ELSE
           MOVE 3 TO DATE-MODE
           MOVE INPUT-DATE TO DATE-VALIDATE-IN
           CALL "TDATECHK" USING DATE-CHECK-AREA
           MOVE DATE-DB TO DATE-INPT-BUF
           PERFORM 610-SET-DATE-INPT-CC
           IF DATE-INPT-BUF-CN < DATE-CURR-BUF-CN
               MOVE 30022 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE TRUE-VAL TO INDS (2) INDS (99)
               GO TO 6-MAIN-READ-PARTS.
           PERFORM 651-DUPLICATE-PARTS THRU 651-DP-EXIT.
       6-MAIN-JOBPLAN-DUP.
           IF LAST-JOBPLAN-SEQ = "    " GO TO 6-MAIN-WRITE-COMP.
           IF LAST-JOBPLAN-SEQ-1-3 > 000
               NEXT SENTENCE
           ELSE
           GO TO 6-MAIN-WRITE-COMP.
           MOVE SPACES TO INPUT-WA.
           MOVE "FDUPLOP2" TO VIEW-CFNAME.
           MOVE INPUT-WA TO DSPLY-REC.
           PERFORM 99-SCREEN-WRITE.
           PERFORM 98-SCREEN-READ.
           MOVE DSPLY-REC TO INPUT-WA.
           IF VIEW-LASTKEY = 8
               MOVE 9 TO VIEW-LASTKEY
               PERFORM 662-UPDATE-LJS THRU 662-ULJS-EXIT
           ELSE
           IF VIEW-LASTKEY = 3
               GO TO 6-MAIN-EXIT
           ELSE
           IF INPUT-X = "X"
               MOVE 30038 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE ERROR-BUFFER TO INPUT-CMD-LINE
               MOVE INPUT-WA TO DSPLY-REC
               MOVE TRUE-VAL TO INDS (98)
               PERFORM 99-SCREEN-WRITE
               PERFORM 98A-SCREEN-READ
               PERFORM 661-DUPLICATE-JOBPLAN THRU 661-DJ-EXIT
           ELSE
           PERFORM 662-UPDATE-LJS THRU 662-ULJS-EXIT.
       6-MAIN-WRITE-COMP.
           MOVE 49008 TO CATREAD-MSG-NUMBER.
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
           MOVE ERROR-BUFFER TO P-COMP-LIT.
           MOVE WONO-BUF TO WO-IN.
           MOVE WORK-ORDER-NUMBER TO WO-OUT.
           MOVE P-COMP-LIT TO FDUPL-CMD-LINE.
           MOVE SPACES TO BUFFER WONO-BUF.
       6-MAIN-EXIT.    EXIT.
       610-SET-DATE-INPT-CC.
           IF DATE-INPT-BUF-YY > "70"
               MOVE "19" TO DATE-INPT-BUF-CC
           ELSE
           MOVE "20"     TO DATE-INPT-BUF-CC.
       611-GET-WONUM-ASKED4-PARA.
           MOVE 0 TO PLANNED-SW.
           MOVE 0 TO COND-WORD.
           MOVE WONO-BUF TO WONUM OF WBFREC.
           START WO-BASIC-FILE KEY IS = EXTERNALLY-DESCRIBED-KEY
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF WBF-STATUS NOT = "00" MOVE 17 TO COND-WORD.
           IF COND-WORD = 17 GO TO 6111-CHECK-WO-PLANNED.
           READ WO-BASIC-FILE NEXT INTO WO-BASIC-DATA
               AT END    MOVE 15 TO COND-WORD.
           IF WBF-STATUS NOT = "00" MOVE 15 TO COND-WORD.
           IF COND-WORD = 15 GO TO 6111-CHECK-WO-PLANNED.
           MOVE HIGH-VALUES TO WONUM OF WBFREC.
           START WO-BASIC-FILE KEY IS > EXTERNALLY-DESCRIBED-KEY.
           MOVE SPACES TO WO-PLANNED-DATA.
           GO TO 611-GWAP-EXIT.
       6111-CHECK-WO-PLANNED.
           MOVE 0 TO COND-WORD.
           MOVE WONO-BUF TO WONUM OF WPFREC.
           START WO-PLANNED-FILE KEY IS = EXTERNALLY-DESCRIBED-KEY
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF WPF-STATUS NOT = "00" MOVE 17 TO COND-WORD.
           IF COND-WORD = 17 GO TO 6112-GET-WONUM-NUMBER.
           READ WO-PLANNED-FILE NEXT INTO WO-PLANNED-DATA
               AT END    MOVE 15 TO COND-WORD.
           IF WPF-STATUS NOT = "00" MOVE 15 TO COND-WORD.
           IF COND-WORD = 15 GO TO 6112-GET-WONUM-NUMBER.
           IF WO-NUM-SUFF-P = SPACES
               NEXT SENTENCE
           ELSE
           MOVE 45051 TO CATREAD-MSG-NUMBER
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
           MOVE TRUE-VAL TO INDS (99)
           GO TO 2-EOJ.
           MOVE HIGH-VALUES TO WONUM OF WPFREC.
           START WO-PLANNED-FILE KEY IS > EXTERNALLY-DESCRIBED-KEY.
           MOVE 1 TO PLANNED-SW.
           MOVE SPACES TO WO-BASIC-DATA.
       6112-GET-WONUM-NUMBER.
           MOVE 0 TO COND-WORD.
           MOVE WONO-BUF TO WONUM OF WNFREC.
           START WO-NUMBER-FILE KEY IS = EXTERNALLY-DESCRIBED-KEY
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF WNF-STATUS NOT = "00" MOVE 17 TO COND-WORD.
           IF COND-WORD = 17
      *M  *********************
      *M  MESSAGE SET 49   NUMBER 30
      *M  WORK ORDER {          } IS NOT IN THE DATABASE
      *M  *********************
               MOVE 49030 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE ERROR-BUFFER   TO ERROR-BUFFER-2
               MOVE WONO-BUF       TO ERROR-WO-NUM
               MOVE ERROR-BUFFER-2 TO ERROR-BUFFER
               MOVE ERROR-BUFFER TO INPUT-CMD-LINE
               MOVE INPUT-WA TO DSPLY-REC
               MOVE TRUE-VAL TO INDS (98)
               GO TO 6-WRITE.
           READ WO-PLANNED-FILE NEXT INTO WO-PLANNED-DATA
               AT END    MOVE 15 TO COND-WORD.
           IF WNF-STATUS NOT = "00" MOVE 15 TO COND-WORD.
           IF COND-WORD = 15
               MOVE 49030 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE ERROR-BUFFER   TO ERROR-BUFFER-2
               MOVE WONO-BUF       TO ERROR-WO-NUM
               MOVE ERROR-BUFFER-2 TO ERROR-BUFFER
               MOVE ERROR-BUFFER TO INPUT-CMD-LINE
               MOVE INPUT-WA TO DSPLY-REC
               MOVE TRUE-VAL TO INDS (98)
               GO TO 6-WRITE.
       611-GWAP-EXIT.    EXIT.
       621-GMFU-VERBAL.
           IF PLANNED-SW = 0
               MOVE "FDUPLBAS" TO VIEW-CFNAME
           ELSE
           MOVE "FDUPLPLN" TO VIEW-CFNAME.
           ACCEPT TIME-BUFFER FROM TIME.
           MOVE 1 TO DATE-MODE.
           CALL "TDATECHK" USING DATE-CHECK-AREA.
           IF PLANNED-SW = 1 GO TO 621-GMFU-PLANNED.
           MOVE DATE-OUT TO WO-DATE-REC-P.
           MOVE TIME-BUFF TO WO-TIME-REC.
           MOVE APPROVAL-CODE TO WO-APPR-CODE.
           MOVE REQUESTER-B TO WO-REQUESTER.
           MOVE SPACES TO WO-EQPNUM WO-EQPNAME WO-EQPTYP WO-DEPT
               WO-MAINT-ZONE WO-LOC.
           MOVE PRIORITY TO WO-PRIORITY.
           MOVE EQUIP-DOWN TO WO-EQPDWN.
           MOVE CRAFTS-REQD-1 TO WO-CRAFTS-REQD-1
               SAVE-CRAFTS-REQD-1.
           MOVE CRAFTS-REQD-2 TO WO-CRAFTS-REQD-2
               SAVE-CRAFTS-REQD-2.
           MOVE CRAFTS-REQD-3 TO WO-CRAFTS-REQD-3
               SAVE-CRAFTS-REQD-3.
           MOVE EXP-CLASS TO WO-EXPCLASS.
           MOVE DESCRIPTION-1 TO WO-DESC-1.
           MOVE DESCRIPTION-2-1 TO WO-DESC-2.
           MOVE DESCRIPTION-2-2 TO WO-DESC-3.
           MOVE SPACES TO WO-CRAFTSMEN-1 WO-CRAFTSMEN-2
               WO-CRAFTSMEN-3.
           MOVE SPACES TO WO-DATE-STRT WO-TIME-STRT WO-FAILURE
               WO-DATE-COMP WO-TIME-COMP.
           GO TO 621-GMFU-CONT.
       621-GMFU-PLANNED.
           MOVE DATE-OUT TO WO-DATE-REC-P.
           MOVE TIME-BUFF TO WO-TIME-REC-P.
           MOVE "U" TO WO-APPR-CODE-P.
           MOVE REQUESTER-P TO WO-REQUESTER-P.
           MOVE SPACES TO WO-EQPNUM-P WO-EQPNAME-P WO-EQPTYP-P
               WO-DEPT-P WO-MAINT-ZONE-P WO-LOC-P.
           MOVE PRIORITY-P TO WO-PRIORITY-P.
           MOVE EQUIP-DOWN-P TO WO-EQPDWN-P.
           MOVE EXP-CLASS-P TO WO-EXPCLASS-P.
           IF RIME-P = "  "
               MOVE "00"  TO WO-RIME-P
           ELSE
           MOVE RIME-P TO WO-RIME-P.
           MOVE DESCRIPTION-1-P TO WO-DESC-1-P.
           MOVE DESCRIPTION-2-1-P TO WO-DESC-2-P.
           MOVE DESCRIPTION-2-2-P TO WO-DESC-3-P.
           MOVE DESCRIPTION-3-1-P TO WO-DESC-4-P.
           MOVE DESCRIPTION-3-2-P TO WO-DESC-5-P.
           MOVE SPACES TO WO-DATE-STRT-P WO-TIME-STRT-P
               WO-FAILURE-P WO-DATE-COMP-P WO-TIME-COMP-P.
           MOVE SPECL-INSTR-1 TO WO-SPECL-INSTR-1-P.
           MOVE SPECL-INSTR-2 TO WO-SPECL-INSTR-2-P.
           MOVE SPECL-EQUIP TO WO-SPECL-EQUIP-P.
           MOVE SAFETY-NOTE TO WO-SFTYNOTE-P.
           MOVE SPACES TO WO-DATE-REQD-P WO-TIME-REQD-P.
           MOVE ENGINEER TO WO-ENGINEER-P.
           MOVE ENGR-RESP-IND TO WO-ENGINEER-RESP-IND.
           MOVE PLANNER TO WO-PLANNER-P.
           MOVE PLNR-RESP-IND TO WO-PLANNER-RESP-IND.
           MOVE SCHEDULER TO WO-SCHEDULER-P.
           MOVE SCHD-RESP-IND TO WO-SCHEDULER-RESP-IND.
           MOVE SPACES TO WO-BGT-NO-P.
           MOVE REQUEST-NO TO WO-REQ-NO-P.
           MOVE SPACES TO WO-SCHD-DATE-P WO-TIME-SCHD-P.
       621-GMFU-CONT.
           MOVE BUFFER TO DSPLY-REC.
           PERFORM 99-SCREEN-WRITE.
       621-GMFU-EXIT. EXIT.
       631-HM-PARA.
           PERFORM 67-READTERM THRU 67-RT-EXIT.
           IF VIEW-LASTKEY = 9
               NEXT SENTENCE
           ELSE
           PERFORM 631-CK-KEY-MODIFICATIONS THRU 631-CKM-EXIT.
       631-CK-KEY-MODIFICATIONS.
           MOVE 0 TO COND-WORD.
           MOVE EDIT-WO-STAT TO WOSTATUS OF WSMFREC.
           START WO-STATUS-MSTR-FILE KEY IS = EXTERNALLY-DESCRIBED-KEY
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF COND-WORD = 17
               MOVE 35001 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE TRUE-VAL TO INDS (1) INDS (99)
               MOVE ERROR-BUFFER TO WOP-ERR-LINE
               MOVE BUFFER TO DSPLY-REC
               PERFORM 99-SCREEN-WRITE
               PERFORM 67-READTERM THRU 67-RT-EXIT
               GO TO 631-CK-KEY-MODIFICATIONS.
           IF EDIT-WO-STAT = "IP" OR "VO" OR "CW" OR "FF" OR "LV"
               OR "HV" OR "HP" OR "HE" OR "DW"
               MOVE 35001 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE TRUE-VAL TO INDS (1) INDS (99)
               MOVE ERROR-BUFFER TO WOP-ERR-LINE
               MOVE BUFFER TO DSPLY-REC
               PERFORM 99-SCREEN-WRITE
               PERFORM 67-READTERM THRU 67-RT-EXIT
               GO TO 631-CK-KEY-MODIFICATIONS.
           IF PLANNED-SW = 1
               IF EDIT-WO-STAT = "IP"
                   IF WO-STATUS-P  = "SD" OR "HS" OR "PR"
                       IF WO-EXPCLASS-P = SPACES
                           MOVE 49016 TO CATREAD-MSG-NUMBER
                           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                           MOVE TRUE-VAL TO INDS (18) INDS (99)
                           MOVE ERROR-BUFFER TO WOP-ERR-LINE
                           MOVE BUFFER TO DSPLY-REC
                           PERFORM 99-SCREEN-WRITE
                           PERFORM 67-READTERM THRU 67-RT-EXIT
                           GO TO 631-CK-KEY-MODIFICATIONS
                       ELSE
                       NEXT SENTENCE
                   ELSE
                   MOVE 35092 TO CATREAD-MSG-NUMBER
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE TRUE-VAL TO INDS (1) INDS (99)
                   MOVE ERROR-BUFFER TO WOP-ERR-LINE
                   MOVE BUFFER TO DSPLY-REC
                   PERFORM 99-SCREEN-WRITE
                   PERFORM 67-READTERM THRU 67-RT-EXIT
                   GO TO 631-CK-KEY-MODIFICATIONS.
      *6311-BEGIN-EDIT-CHECKS.
           MOVE 0 TO COND-WORD.
           MOVE EDIT-EQUIP-NUM TO EQPNUM OF EFREC.
      *****************************************************************
      *    DETERMINE IF EQUIP-NUMBER IS IN DATABASE.
      *****************************************************************
           START EQUIPMENT-FILE KEY IS = EXTERNALLY-DESCRIBED-KEY
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF COND-WORD = 17
               MOVE 35004 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE TRUE-VAL TO INDS (9) INDS (99)
               MOVE ERROR-BUFFER TO WOP-ERR-LINE
               MOVE BUFFER TO DSPLY-REC
               PERFORM 99-SCREEN-WRITE
               PERFORM 67-READTERM THRU 67-RT-EXIT
               GO TO 631-CK-KEY-MODIFICATIONS.
           READ EQUIPMENT-FILE NEXT INTO EQP-EQUIPMENT
               AT END    MOVE 15 TO COND-WORD.
           IF EF-STATUS NOT = "00" MOVE 15 TO COND-WORD.
           IF PLANNED-SW = 0
               MOVE EQP-EQUIP-NAME TO EDIT-EQUIP-NAME WO-EQPNAME
               MOVE EQP-TYPE       TO EDIT-TYPE-NUM WO-EQPTYP
               MOVE EQP-DEPT       TO EDIT-DEPT WO-DEPT
               MOVE EQP-MAINT-ZONE TO EDIT-ZONE WO-MAINT-ZONE
               MOVE EQP-LOCATION   TO EDIT-LOCATION WO-LOC
               PERFORM 99-SCREEN-WRITE
           ELSE
           MOVE EQP-EQUIP-NAME     TO EDIT-EQUIP-NAME WO-EQPNAME-P
           MOVE EQP-TYPE           TO EDIT-TYPE-NUM WO-EQPTYP-P
           MOVE EQP-DEPT           TO EDIT-DEPT WO-DEPT-P
           MOVE EQP-MAINT-ZONE     TO EDIT-ZONE WO-MAINT-ZONE-P
           MOVE EQP-LOCATION       TO EDIT-LOCATION WO-LOC-P
           PERFORM 99-SCREEN-WRITE.
      *****************************************************************
      *    PRIORITY CHECK.
      *****************************************************************
           MOVE SPACES TO ARG-NO.
           MOVE EDIT-ZONE TO ARG-NO-1-4.
           MOVE EDIT-PRIORITY TO ARG-NO-5.
           MOVE ARG-NO TO ZONEPRTY OF WZPFREC.
      *****************************************************************
      *    DETERMINE IF ZONE-PRIORITY IS IN DATABASE.
      *****************************************************************
           START WO-ZONE-PRTY-FILE KEY IS = EXTERNALLY-DESCRIBED-KEY
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF WZPF-STATUS NOT = "00" MOVE 17 TO COND-WORD.
           IF COND-WORD = 17
             IF PLANNED-SW = 0
               MOVE 35080 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE TRUE-VAL TO INDS (15) INDS (99)
               MOVE ERROR-BUFFER TO WOP-ERR-LINE
               MOVE BUFFER TO DSPLY-REC
               PERFORM 99-SCREEN-WRITE
               PERFORM 67-READTERM THRU 67-RT-EXIT
               GO TO 631-CK-KEY-MODIFICATIONS
             ELSE
             MOVE 35080 TO CATREAD-MSG-NUMBER
             PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
             MOVE TRUE-VAL TO INDS (15) INDS (99)
             MOVE ERROR-BUFFER TO WOP-ERR-LINE
             MOVE BUFFER TO DSPLY-REC
             PERFORM 99-SCREEN-WRITE
             PERFORM 67-READTERM THRU 67-RT-EXIT
             GO TO 631-CK-KEY-MODIFICATIONS.
           IF PLANNED-SW = 0
               NEXT SENTENCE
           ELSE
           IF RIME-NO NOT NUMERIC
               MOVE 0 TO WO-RIME-P
           ELSE
           IF EDIT-PRI = 1
               MULTIPLY 9 BY RIME-NO GIVING WO-RIME-P
           ELSE
           IF EDIT-PRI = 2
               MULTIPLY 6 BY RIME-NO GIVING WO-RIME-P
           ELSE
           IF EDIT-PRI = 3
               MULTIPLY 4 BY RIME-NO GIVING WO-RIME-P
           ELSE
           IF EDIT-PRI = 4
               MULTIPLY 2 BY RIME-NO GIVING WO-RIME-P
           ELSE
           MOVE RIME-NO TO WO-RIME-P.
      *****************************************************************
      *     CHECK EQUIPMENT DOWN CODE
      *****************************************************************
           IF EDIT-EQUIP-DOWN = "Y" OR "N" OR "?" NEXT SENTENCE ELSE
             IF PLANNED-SW = 0
               MOVE 31033 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE TRUE-VAL TO INDS (16) INDS (99)
               MOVE ERROR-BUFFER TO WOP-ERR-LINE
               MOVE BUFFER TO DSPLY-REC
               PERFORM 99-SCREEN-WRITE
               PERFORM 67-READTERM THRU 67-RT-EXIT
               GO TO 631-CK-KEY-MODIFICATIONS
             ELSE
             MOVE 31033 TO CATREAD-MSG-NUMBER
             PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
             MOVE TRUE-VAL TO INDS (17) INDS (99)
             MOVE ERROR-BUFFER TO WOP-ERR-LINE
             MOVE BUFFER TO DSPLY-REC
             PERFORM 99-SCREEN-WRITE
             PERFORM 67-READTERM THRU 67-RT-EXIT
             GO TO 631-CK-KEY-MODIFICATIONS.
           IF PLANNED-SW = 1 GO TO 6315-CHECK-EXPCLASS.
      ******************************************************************
      *    CHECK CRAFTS FOR VALIDITY
      ******************************************************************
           IF SAVE-CRAFTS-REQD-1 NOT = WO-CRAFTS-REQD-1
               MOVE WO-CRAFTS-REQD-1 TO ARG-NO
               PERFORM 6319-VERIFY-CRAFT
               IF COND-WORD = 0 NEXT SENTENCE ELSE
                   MOVE 35037 TO CATREAD-MSG-NUMBER
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE TRUE-VAL TO INDS (88) INDS (99)
                   MOVE ERROR-BUFFER TO WOP-ERR-LINE
                   MOVE BUFFER TO DSPLY-REC
                   PERFORM 99-SCREEN-WRITE
                   PERFORM 67-READTERM THRU 67-RT-EXIT
                   GO TO 631-CK-KEY-MODIFICATIONS.
           IF SAVE-CRAFTS-REQD-2 NOT = WO-CRAFTS-REQD-2
               MOVE WO-CRAFTS-REQD-2 TO ARG-NO
               PERFORM 6319-VERIFY-CRAFT
               IF COND-WORD = 0 NEXT SENTENCE ELSE
                   MOVE 35037 TO CATREAD-MSG-NUMBER
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE TRUE-VAL TO INDS (89) INDS (99)
                   MOVE ERROR-BUFFER TO WOP-ERR-LINE
                   MOVE BUFFER TO DSPLY-REC
                   PERFORM 99-SCREEN-WRITE
                   PERFORM 67-READTERM THRU 67-RT-EXIT
                   GO TO 631-CK-KEY-MODIFICATIONS.
           IF SAVE-CRAFTS-REQD-3 NOT = WO-CRAFTS-REQD-3
               MOVE WO-CRAFTS-REQD-3 TO ARG-NO
               PERFORM 6319-VERIFY-CRAFT
               IF COND-WORD = 0 NEXT SENTENCE ELSE
                   MOVE 35037 TO CATREAD-MSG-NUMBER
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE TRUE-VAL TO INDS (90) INDS (99)
                   MOVE ERROR-BUFFER TO WOP-ERR-LINE
                   MOVE BUFFER TO DSPLY-REC
                   PERFORM 99-SCREEN-WRITE
                   PERFORM 67-READTERM THRU 67-RT-EXIT
                   GO TO 631-CK-KEY-MODIFICATIONS.
      *****************************************************************
      *    EXP-CLASS CHECK.
      *****************************************************************
       6315-CHECK-EXPCLASS.
           IF EDIT-EXPCLASS = "      "
               MOVE "        " TO EDIT-EXPCLASS
           ELSE
           IF ECB-1 NUMERIC
               IF ECB-2 NUMERIC
                   IF ECB-3 NUMERIC
                       IF ECB-4 NUMERIC
                           IF ECB-5 NUMERIC
                               IF ECB-6 NUMERIC
                                   IF ECB-7 NUMERIC
                                       IF ECB-8 NUMERIC
                                           NEXT SENTENCE
                                       ELSE
                                       MOVE ECB-7 TO ECB-8
                                       MOVE ECB-6 TO ECB-7
                                       MOVE ECB-5 TO ECB-6
                                       MOVE ECB-4 TO ECB-5
                                       MOVE ECB-3 TO ECB-4
                                       MOVE ECB-2 TO ECB-3
                                       MOVE ECB-1 TO ECB-2
                                       MOVE "0" TO ECB-1
                                   ELSE
                                   MOVE ECB-6 TO ECB-8
                                   MOVE ECB-5 TO ECB-7
                                   MOVE ECB-4 TO ECB-6
                                   MOVE ECB-3 TO ECB-5
                                   MOVE ECB-2 TO ECB-4
                                   MOVE ECB-1 TO ECB-3
                                   MOVE "0" TO ECB-2 ECB-1
                               ELSE
                               MOVE ECB-5 TO ECB-8
                               MOVE ECB-4 TO ECB-7
                               MOVE ECB-3 TO ECB-6
                               MOVE ECB-2 TO ECB-5
                               MOVE ECB-1 TO ECB-4
                               MOVE "0" TO ECB-3 ECB-2 ECB-1
                           ELSE
                           MOVE ECB-4 TO ECB-8
                           MOVE ECB-3 TO ECB-7
                           MOVE ECB-2 TO ECB-6
                           MOVE ECB-1 TO ECB-5
                           MOVE "0" TO ECB-4 ECB-3 ECB-2 ECB-1
                       ELSE
                       MOVE ECB-3 TO ECB-8
                       MOVE ECB-2 TO ECB-7
                       MOVE ECB-1 TO ECB-6
                       MOVE "0" TO ECB-5 ECB-4 ECB-3 ECB-2 ECB-1
                   ELSE
                   MOVE ECB-2 TO ECB-8
                   MOVE ECB-1 TO ECB-7
                   MOVE "0" TO ECB-6 ECB-5 ECB-4 ECB-3 ECB-2 ECB-1
               ELSE
               MOVE ECB-1 TO ECB-8
               MOVE "0" TO ECB-7 ECB-6 ECB-5 ECB-4 ECB-3 ECB-2 ECB-1
           ELSE
           MOVE 35024 TO CATREAD-MSG-NUMBER
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
           MOVE TRUE-VAL TO INDS (18) INDS (99)
           MOVE ERROR-BUFFER TO WOP-ERR-LINE
           MOVE BUFFER TO DSPLY-REC
           PERFORM 99-SCREEN-WRITE
           PERFORM 67-READTERM THRU 67-RT-EXIT
           GO TO 631-CK-KEY-MODIFICATIONS.
           IF PLANNED-SW = 0 GO TO 631-CKM-EXIT.

      *****************************************************************
      *    DATE-REQD CHECK.
      *****************************************************************
           IF WO-DATE-REQD-P = "      "
               NEXT SENTENCE
           ELSE
           IF DATE-FLAG = 3
               IF WO-DATE-REQD-P-MD > 0 AND < 32
                   IF WO-DATE-REQD-P-DM > 0 AND < 13
                       IF WO-DATE-REQD-P-YY NUMERIC
                           NEXT SENTENCE
                       ELSE
                       MOVE 35032 TO CATREAD-MSG-NUMBER
                       PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                       MOVE TRUE-VAL TO INDS (21) INDS (99)
                       MOVE ERROR-BUFFER TO WOP-ERR-LINE
                       MOVE BUFFER TO DSPLY-REC
                       PERFORM 99-SCREEN-WRITE
                       PERFORM 67-READTERM THRU 67-RT-EXIT
                       GO TO 631-CK-KEY-MODIFICATIONS
                   ELSE
                   MOVE 35031 TO CATREAD-MSG-NUMBER
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE TRUE-VAL TO INDS (20) INDS (99)
                   MOVE ERROR-BUFFER TO WOP-ERR-LINE
                   MOVE BUFFER TO DSPLY-REC
                   PERFORM 99-SCREEN-WRITE
                   PERFORM 67-READTERM THRU 67-RT-EXIT
                   GO TO 631-CK-KEY-MODIFICATIONS
               ELSE
               MOVE 35030 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE TRUE-VAL TO INDS (19) INDS (99)
               MOVE ERROR-BUFFER TO WOP-ERR-LINE
               MOVE BUFFER TO DSPLY-REC
               PERFORM 99-SCREEN-WRITE
               PERFORM 67-READTERM THRU 67-RT-EXIT
               GO TO 631-CK-KEY-MODIFICATIONS
           ELSE
           IF WO-DATE-REQD-P-MD > 0 AND < 13
               IF WO-DATE-REQD-P-DM > 0 AND < 32
                   IF WO-DATE-REQD-P-YY NUMERIC
                       NEXT SENTENCE
                   ELSE
                   MOVE 35032 TO CATREAD-MSG-NUMBER
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE TRUE-VAL TO INDS (21) INDS (99)
                   MOVE ERROR-BUFFER TO WOP-ERR-LINE
                   MOVE BUFFER TO DSPLY-REC
                   PERFORM 99-SCREEN-WRITE
                   PERFORM 67-READTERM THRU 67-RT-EXIT
                   GO TO 631-CK-KEY-MODIFICATIONS
               ELSE
               MOVE 35030 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE TRUE-VAL TO INDS (20) INDS (99)
               MOVE ERROR-BUFFER TO WOP-ERR-LINE
               MOVE BUFFER TO DSPLY-REC
               PERFORM 99-SCREEN-WRITE
               PERFORM 67-READTERM THRU 67-RT-EXIT
               GO TO 631-CK-KEY-MODIFICATIONS
           ELSE
           MOVE 35031 TO CATREAD-MSG-NUMBER
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
           MOVE TRUE-VAL TO INDS (19) INDS (99)
           MOVE ERROR-BUFFER TO WOP-ERR-LINE
           MOVE BUFFER TO DSPLY-REC
           PERFORM 99-SCREEN-WRITE
           PERFORM 67-READTERM THRU 67-RT-EXIT
           GO TO 631-CK-KEY-MODIFICATIONS.
      ******************************************************************
      *    TIME PROMISED CHECK
      ******************************************************************
           IF WO-TIME-REQD-P = "    "
               NEXT SENTENCE
           ELSE
           IF WO-TIME-REQD-P-HH < 24
               NEXT SENTENCE
           ELSE
           MOVE 35055 TO CATREAD-MSG-NUMBER
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
           MOVE TRUE-VAL TO INDS (22) INDS (99)
           MOVE ERROR-BUFFER TO WOP-ERR-LINE
           MOVE BUFFER TO DSPLY-REC
           PERFORM 99-SCREEN-WRITE
           PERFORM 67-READTERM THRU 67-RT-EXIT
           GO TO 631-CK-KEY-MODIFICATIONS.
           IF WO-TIME-REQD-P = "    "
               NEXT SENTENCE
           ELSE
           IF WO-TIME-REQD-P-MM < 60
               NEXT SENTENCE
           ELSE
           MOVE 35054 TO CATREAD-MSG-NUMBER
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
           MOVE TRUE-VAL TO INDS (23) INDS (99)
           MOVE ERROR-BUFFER TO WOP-ERR-LINE
           MOVE BUFFER TO DSPLY-REC
           PERFORM 99-SCREEN-WRITE
           PERFORM 67-READTERM THRU 67-RT-EXIT
           GO TO 631-CK-KEY-MODIFICATIONS.
      *****************************************************************
      *    CHECK DATE SCHEDULED
      *****************************************************************
           IF WO-SCHD-DATE-P = "      "
               NEXT SENTENCE
           ELSE
           IF DATE-FLAG = 3
               IF WO-SCHD-DATE-P-MD > 0 AND < 32
                   IF WO-SCHD-DATE-P-DM > 0 AND < 13
                       IF WO-SCHD-DATE-P-YY NUMERIC
                           NEXT SENTENCE
                       ELSE
                       MOVE 35032 TO CATREAD-MSG-NUMBER
                       PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                       MOVE TRUE-VAL TO INDS (38) INDS (99)
                       MOVE ERROR-BUFFER TO WOP-ERR-LINE
                       MOVE BUFFER TO DSPLY-REC
                       PERFORM 99-SCREEN-WRITE
                       PERFORM 67-READTERM THRU 67-RT-EXIT
                       GO TO 631-CK-KEY-MODIFICATIONS
                   ELSE
                   MOVE 35031 TO CATREAD-MSG-NUMBER
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE TRUE-VAL TO INDS (37) INDS (99)
                   MOVE ERROR-BUFFER TO WOP-ERR-LINE
                   MOVE BUFFER TO DSPLY-REC
                   PERFORM 99-SCREEN-WRITE
                   PERFORM 67-READTERM THRU 67-RT-EXIT
                   GO TO 631-CK-KEY-MODIFICATIONS
               ELSE
               MOVE 35030 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE TRUE-VAL TO INDS (36) INDS (99)
               MOVE ERROR-BUFFER TO WOP-ERR-LINE
               MOVE BUFFER TO DSPLY-REC
               PERFORM 99-SCREEN-WRITE
               PERFORM 67-READTERM THRU 67-RT-EXIT
               GO TO 631-CK-KEY-MODIFICATIONS
           ELSE
           IF WO-SCHD-DATE-P-MD > 0 AND < 13
               IF WO-SCHD-DATE-P-DM > 0 AND < 32
                   IF WO-SCHD-DATE-P-YY NUMERIC
                       NEXT SENTENCE
                   ELSE
                   MOVE 35032 TO CATREAD-MSG-NUMBER
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE TRUE-VAL TO INDS (38) INDS (99)
                   MOVE ERROR-BUFFER TO WOP-ERR-LINE
                   MOVE BUFFER TO DSPLY-REC
                   PERFORM 99-SCREEN-WRITE
                   PERFORM 67-READTERM THRU 67-RT-EXIT
                   GO TO 631-CK-KEY-MODIFICATIONS
               ELSE
               MOVE 35030 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE TRUE-VAL TO INDS (37) INDS (99)
               MOVE ERROR-BUFFER TO WOP-ERR-LINE
               MOVE BUFFER TO DSPLY-REC
               PERFORM 99-SCREEN-WRITE
               PERFORM 67-READTERM THRU 67-RT-EXIT
               GO TO 631-CK-KEY-MODIFICATIONS
           ELSE
           MOVE 35031 TO CATREAD-MSG-NUMBER
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
           MOVE TRUE-VAL TO INDS (36) INDS (99)
           MOVE ERROR-BUFFER TO WOP-ERR-LINE
           MOVE BUFFER TO DSPLY-REC
           PERFORM 99-SCREEN-WRITE
           PERFORM 67-READTERM THRU 67-RT-EXIT
           GO TO 631-CK-KEY-MODIFICATIONS.
           IF WO-SCHD-DATE-P = "      "
               NEXT SENTENCE
           ELSE
           IF DATE-PROM-BUF-CN < DATE-RECD-BUF-CN
               MOVE 45025 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE TRUE-VAL TO INDS (36) INDS (99)
               MOVE ERROR-BUFFER TO WOP-ERR-LINE
               MOVE BUFFER TO DSPLY-REC
               PERFORM 99-SCREEN-WRITE
               PERFORM 67-READTERM THRU 67-RT-EXIT
               GO TO 631-CK-KEY-MODIFICATIONS.
      ******************************************************************
      *    TIME SCHEDULED CHECK
      ******************************************************************
           IF WO-TIME-SCHD-P = "    "
               NEXT SENTENCE
           ELSE
           IF WO-TIME-SCHD-P-HH < 24
               NEXT SENTENCE
           ELSE
           MOVE 35055 TO CATREAD-MSG-NUMBER
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
           MOVE TRUE-VAL TO INDS (39) INDS (99)
           MOVE ERROR-BUFFER TO WOP-ERR-LINE
           MOVE BUFFER TO DSPLY-REC
           PERFORM 99-SCREEN-WRITE
           PERFORM 67-READTERM THRU 67-RT-EXIT
           GO TO 631-CK-KEY-MODIFICATIONS.
           IF WO-TIME-SCHD-P = "    "
               NEXT SENTENCE
           ELSE
           IF WO-TIME-SCHD-P-MM < 60
               NEXT SENTENCE
           ELSE
           MOVE 35054 TO CATREAD-MSG-NUMBER
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
           MOVE TRUE-VAL TO INDS (40) INDS (99)
           MOVE ERROR-BUFFER TO WOP-ERR-LINE
           MOVE BUFFER TO DSPLY-REC
           PERFORM 99-SCREEN-WRITE
           PERFORM 67-READTERM THRU 67-RT-EXIT
           GO TO 631-CK-KEY-MODIFICATIONS.
           IF WO-TIME-SCHD-P = "    " AND
               WO-SCHD-DATE-P NOT = "      "
               MOVE 29027 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE TRUE-VAL TO INDS (39) INDS (99)
               MOVE ERROR-BUFFER TO WOP-ERR-LINE
               MOVE BUFFER TO DSPLY-REC
               PERFORM 99-SCREEN-WRITE
               PERFORM 67-READTERM THRU 67-RT-EXIT
               GO TO 631-CK-KEY-MODIFICATIONS.
           IF DATE-PROM-BUF-CN = DATE-RECD-BUF-CN AND
               WO-TIME-SCHD-P < WO-TIME-REC-P
                   MOVE 46023 TO CATREAD-MSG-NUMBER
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE TRUE-VAL TO INDS (39) INDS (99)
                   MOVE ERROR-BUFFER TO WOP-ERR-LINE
                   MOVE BUFFER TO DSPLY-REC
                   PERFORM 99-SCREEN-WRITE
                   PERFORM 67-READTERM THRU 67-RT-EXIT
                   GO TO 631-CK-KEY-MODIFICATIONS.
       631-CKM-EXIT.   EXIT.
       6319-VERIFY-CRAFT.
           MOVE 0 TO COND-WORD.
           START WO-CRAFTS-MSTR-FILE KEY IS = EXTERNALLY-DESCRIBED-KEY
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF WCMF-STATUS NOT = "00" MOVE 17 TO COND-WORD.
       641-UOM-VERBAL.
           IF PLANNED-SW = 1 GO TO 6412-UOM-PLANNED.
           MOVE EDIT-WO-STAT TO WO-STATUS.
           MOVE 1 TO DATE-MODE.
           CALL "TDATECHK" USING DATE-CHECK-AREA.
           MOVE DATE-DB TO DATE-RECD.
           IF DATE-RECD-YY > "70"
               MOVE "19" TO DATE-RECD-CC
           ELSE
           MOVE "20" TO DATE-RECD-CC.
           MOVE DATE-OUT TO EDIT-DATE-RECD.
           IF WO-NUM = SPACES MOVE WONO-BUF TO WO-NUM.
           ACCEPT TIME-BUFFER FROM TIME.
           MOVE TIME-BUFF TO EDIT-TIME-RECD TIME-RECD.
           MOVE EDIT-APPROVAL-CODE TO APPROVAL-CODE.
           MOVE EDIT-REQUESTER TO REQUESTER-B.
           MOVE EDIT-EQUIP-NUM TO EQUIP-NUM.
           MOVE EDIT-EQUIP-NAME TO EQUIP-NAME.
           MOVE EDIT-TYPE-NUM TO TYPE-NUM.
           MOVE EDIT-DEPT TO DEPT.
           MOVE EDIT-ZONE TO ZONE.
           MOVE EDIT-LOCATION TO LOCATION.
           MOVE EDIT-PRIORITY TO PRIORITY.
           MOVE EDIT-EQUIP-DOWN TO EQUIP-DOWN.
           MOVE EDIT-EXPCLASS TO EXP-CLASS.
           MOVE WO-DESC-1 TO DESCRIPTION-1.
           MOVE WO-DESC-2 TO DESCRIPTION-2-1.
           MOVE WO-DESC-3 TO DESCRIPTION-2-2.
           MOVE WO-CRAFTS-REQD-1 TO CRAFTS-REQD-1.
           MOVE WO-CRAFTS-REQD-2 TO CRAFTS-REQD-2.
           MOVE WO-CRAFTS-REQD-3 TO CRAFTS-REQD-3.
           MOVE SPACES TO CRAFTSMEN-1 CRAFTSMEN-2 CRAFTSMEN-3
               WO-CRAFTSMEN-1 WO-CRAFTSMEN-2 WO-CRAFTSMEN-3.
           MOVE SPACES TO EDIT-DATE-STRT DATE-STRT-CN.
           MOVE SPACES TO EDIT-TIME-STRT TIME-STRT.
           MOVE SPACES TO WO-FAILURE FAILURE-CODE.
           MOVE SPACES TO EDIT-DATE-COMP DATE-COMP-CN EDIT-TIME-COMP
               TIME-COMP.
           CALL "TNEWWONU" USING DBPARAMETERS, STATUS-AREA,
                             LAST-WO-BUFF, ERROR-SWITCH.
           MOVE LAST-WO-NUM TO WORK-ORDER-NUMBER.
           IF ERR-SW = 99 GO TO 2-EOJ.
           MOVE WORK-ORDER-NUMBER TO WO-NUM.
           MOVE "0" TO CONDIT-CODE.
           CALL "TADDWO" USING DBPARAMETERS WO-BASIC-DATA
                           CONDIT-CODE  ERROR-SWITCH.
           IF WO-STATUS = "OO"
               PERFORM 6411-UOM-VERBAL-QUEUE.
           MOVE SPACES TO WO-TRACK-DATA.
           MOVE USERNAME TO USER-NAME.
           MOVE TERMNUM TO USER-TERM.
           MOVE WO-NUM TO WO-NUM-TRACK.
           MOVE 1 TO DATE-MODE.
           CALL "TDATECHK" USING DATE-CHECK-AREA.
           MOVE DATE-DB TO DATE-STAMP.
           IF DATE-STAMP-YY > "70"
               MOVE "19" TO DATE-STAMP-CC
           ELSE
           MOVE "20" TO DATE-STAMP-CC.
           ACCEPT TIME-BUFF FROM TIME.
           MOVE TIME-BUFF TO TIME-STAMP.
           MOVE WO-STRT-STATUS TO WO-TYPE-STATUS.
           MOVE USERNAME TO USER-ID.
           MOVE "    " TO CLOCK-CARD.
           MOVE WO-STATUS TO WO-STATUS-TRACK.
           MOVE "TDUPLSUB" TO PROGRAM-NAME.
           CALL "TWOTRACK" USING WO-TRACK-DATA.
           GO TO 641-UOM-EXIT.
       6411-UOM-VERBAL-QUEUE.
           MOVE 0 TO COND-WORD.
           MOVE EQUIP-NUM TO EQPNUM OF EFREC.
           START EQUIPMENT-FILE KEY IS = EXTERNALLY-DESCRIBED-KEY
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF EF-STATUS NOT = "00" MOVE 17 TO COND-WORD.
           IF COND-WORD = 17 GO TO 6412-UOM-PLANNED.
           READ EQUIPMENT-FILE NEXT INTO EQP-EQUIPMENT
               AT END    MOVE 15 TO COND-WORD.
           IF EF-STATUS NOT = "00" MOVE 15 TO COND-WORD.
           IF COND-WORD = 15 GO TO 6412-UOM-PLANNED.
           MOVE SPACES TO WO-QUEUE-DATA.
           MOVE ZONE          TO Q-ZONE.
           MOVE "1 "          TO Q-PRTY.
           MOVE WO-NUM        TO Q-WO-NUM.
           MOVE EQUIP-DOWN    TO Q-EQP-DOWN.
           MOVE "9999"        TO Q-CC-NUM.
           MOVE EQUIP-NUM     TO Q-EQUIP-NUM.
           MOVE DESCRIPTION-1 TO Q-DESCRIPTION.
           MOVE CRAFTS-REQD-1 TO Q-SKILL-1.
           MOVE CRAFTS-REQD-2 TO Q-SKILL-2.
           MOVE CRAFTS-REQD-3 TO Q-SKILL-3.
           IF PRIORITY = "1 " MOVE 9 TO QUEUE-PRTY.
           IF PRIORITY = "2 " MOVE 6 TO QUEUE-PRTY.
           IF PRIORITY = "3 " MOVE 4 TO QUEUE-PRTY.
           IF PRIORITY = "4 " MOVE 2 TO QUEUE-PRTY.
           IF PRIORITY = "5 " MOVE 1 TO QUEUE-PRTY.
           COMPUTE QUEUE-FACTOR = RIME-NO * QUEUE-PRTY.
           MOVE "A" TO QUEUE-SW.
           CALL "TQUPDATE" USING DBPARAMETERS WO-QUEUE-DATA
                             QUEUE-SW ERROR-BUFFER.
       6412-UOM-PLANNED.
           MOVE EDIT-WO-STAT TO WO-STATUS-P.
           MOVE 1 TO DATE-MODE.
           CALL "TDATECHK" USING DATE-CHECK-AREA.
           MOVE DATE-DB TO DATE-RECD-P.
           IF DATE-RECD-P-YY > "70"
               MOVE "19" TO DATE-RECD-P-CC
           ELSE
           MOVE "20"     TO DATE-RECD-P-CC.
           MOVE DATE-OUT TO EDIT-DATE-RECD.
           IF WO-NUM-PLANNED = SPACES
               MOVE WONO-BUF TO WO-NUM-PLANNED.
           ACCEPT TIME-BUFFER FROM TIME.
           MOVE TIME-BUFF TO EDIT-TIME-RECD TIME-RECD-P.
           MOVE "U" TO EDIT-APPROVAL-CODE APPROVAL-CODE-P.
           MOVE EDIT-REQUESTER TO REQUESTER-P.
           MOVE EDIT-EQUIP-NUM TO EQUIP-NUM-P.
           MOVE EDIT-EQUIP-NAME TO EQUIP-NAME-P.
           MOVE EDIT-TYPE-NUM TO TYPE-NUM-P.
           MOVE EDIT-DEPT TO DEPT-P.
           MOVE EDIT-ZONE TO ZONE-P.
           MOVE EDIT-LOCATION TO LOCATION-P.
           MOVE EDIT-PRIORITY TO PRIORITY-P.
           MOVE EDIT-EQUIP-DOWN TO EQUIP-DOWN-P.
           MOVE EDIT-EXPCLASS TO EXP-CLASS-P.
           MOVE EDIT-ENGINEER TO ENGINEER-P
           MOVE EDIT-PLANNER TO PLANNER-P.
           MOVE EDIT-SCHEDULER TO SCHEDULER-P.
           MOVE WO-RIME-P TO RIME-P.
           MOVE WO-DESC-1-P TO DESCRIPTION-1-P.
           MOVE WO-DESC-2-P TO DESCRIPTION-2-1-P.
           MOVE WO-DESC-3-P TO DESCRIPTION-2-2-P.
           MOVE WO-DESC-4-P TO DESCRIPTION-3-1-P.
           MOVE WO-DESC-5-P TO DESCRIPTION-3-2-P.
           MOVE WO-SPECL-INSTR-1-P TO SPECL-INSTR-1.
           MOVE WO-SPECL-INSTR-2-P TO SPECL-INSTR-2.
           MOVE WO-SPECL-EQUIP-P TO SPECL-EQUIP.
           MOVE WO-SFTYNOTE-P TO SAFETY-NOTE.
           MOVE WO-REQ-NO-P TO REQUEST-NO.
           MOVE SPACES TO DATE-REQD-CN TIME-REQD.
           IF WO-DATE-REQD-P = SPACES
               NEXT SENTENCE
           ELSE
           MOVE WO-TIME-REQD-P TO TIME-REQD
           MOVE 3              TO DATE-MODE
           MOVE WO-DATE-REQD-P TO DATE-VALIDATE-IN
           CALL "TDATECHK" USING DATE-CHECK-AREA
           MOVE DATE-DB        TO DATE-REQD
           IF DATE-REQD-P-YY > "70"
               MOVE "19"       TO DATE-REQD-P-CC
           ELSE
           MOVE "20"           TO DATE-REQD-P-CC.
           IF WO-STATUS-P = "SD" OR "PR"
               IF WO-SCHD-DATE-P = "      "
                   MOVE SPACES TO WO-SCHD-DATE-P DATE-SCHD-CN
                       WO-TIME-SCHD-P TIME-SCHD
               ELSE
               MOVE 3 TO DATE-MODE
               MOVE WO-SCHD-DATE-P TO DATE-VALIDATE-IN
               CALL "TDATECHK" USING DATE-CHECK-AREA
               MOVE DATE-DB TO DATE-SCHD
               PERFORM 64120-SET-DATE-SCHD-CC
               MOVE WO-TIME-SCHD-P    TO TIME-SCHD
           ELSE
           IF WO-SCHD-DATE-P = "      "
               MOVE SPACES TO WO-SCHD-DATE-P DATE-SCHD-CN WO-TIME-SCHD-P
                   TIME-SCHD
           ELSE
           MOVE 3 TO DATE-MODE
           MOVE EDIT-DATE-SCHD TO DATE-VALIDATE-IN
           CALL "TDATECHK" USING DATE-CHECK-AREA
           MOVE DATE-DB TO DATE-SCHD
           PERFORM 64120-SET-DATE-SCHD-CC
           MOVE DATE-OUT TO WO-SCHD-DATE-P
           MOVE EDIT-TIME-SCHD TO TIME-SCHD WO-TIME-SCHD-P.
           MOVE SPACES TO EDIT-DATE-STRT DATE-STRT-P-CN EDIT-TIME-STRT
               TIME-STRT-P.
           MOVE SPACES TO WO-FAILURE-P FAILURE-CODE-P.
           MOVE SPACES TO EDIT-DATE-COMP DATE-COMP-P-CN EDIT-TIME-COMP
               TIME-COMP-P.
           MOVE EDIT-WO-CURRENT-TYPE TO WO-CURRENT-TYPE.
           CALL "TNEWWONU" USING DBPARAMETERS, STATUS-AREA,
                       LAST-WO-BUFF, ERROR-SWITCH.
           MOVE LAST-WO-NUM TO WORK-ORDER-NUMBER.
           IF ERR-SW = 99 GO TO 2-EOJ.
           MOVE WORK-ORDER-NUMBER TO WO-NUM-PLANNED.
           MOVE "0" TO CONDIT-CODE.
           CALL "TADDWOII" USING DBPARAMETERS, STATUS-AREA,
                       WO-PLANNED-DATA, CONDIT-CODE, ERROR-SWITCH.
           MOVE SPACES TO WO-TRACK-DATA.
           MOVE USERNAME TO USER-NAME.
           MOVE TERMNUM TO USER-TERM.
           MOVE WO-NUM-PLANNED TO WO-NUM-TRACK.
           MOVE 1 TO DATE-MODE.
           CALL "TDATECHK" USING DATE-CHECK-AREA.
           MOVE DATE-DB TO DATE-STAMP.
           IF DATE-STAMP-YY > "70"
               MOVE "19"  TO DATE-STAMP-CC
           ELSE
           MOVE "20"      TO DATE-STAMP-CC.
           ACCEPT TIME-BUFF FROM TIME.
           MOVE TIME-BUFF TO TIME-STAMP.
           IF WO-CURRENT-TYPE = "E"
               MOVE "EE" TO WO-TYPE-STATUS
           ELSE
           IF WO-CURRENT-TYPE = "P"
               MOVE "PP" TO WO-TYPE-STATUS.
           MOVE USERNAME TO USER-ID.
           MOVE "    " TO CLOCK-CARD.
           MOVE WO-STATUS-P TO WO-STATUS-TRACK.
           MOVE "TDUPLSUB" TO PROGRAM-NAME.
           CALL "TWOTRACK" USING WO-TRACK-DATA.
       641-UOM-EXIT.  EXIT.

       64120-SET-DATE-SCHD-CC.
           IF DATE-SCHD-P-YY > "70"
               MOVE "19" TO DATE-SCHD-P-CC
           ELSE
           MOVE "20"     TO DATE-SCHD-P-CC.
       651-DUPLICATE-PARTS.
           MOVE 0 TO ITEMS-CTR.
       651-DP-LOOP.
           MOVE 0 TO COND-WORD.
           READ WO-PARTS-FILE NEXT INTO WO-PARTS-DATA
               AT END    MOVE 15 TO COND-WORD.
           IF WONO-BUF NOT = WONUM OF WPFDREC
               MOVE 15 TO COND-WORD.
           IF WPFD-STATUS NOT = "00" MOVE 15 TO COND-WORD.
           IF COND-WORD = 15 GO TO 651-DP-EXIT.
      ****************************************************************
      *    A CHECK TO SEE IF THE PART WAS DELETED AFTER THE W/O      *
      *    WAS APPROVED WAS ADDED ON 1-14-88 SO THAT THESE DELETED   *
      *    PARTS WERE NOT DUPLICATED                                 *
      ****************************************************************
           IF PRT-DELETE-FLAG = "D" GO TO 651-DP-LOOP.
           IF PRT-EST-QTY = "        " AND PRT-ACT-QTY = "        "
               GO TO 651-DP-LOOP.
           MOVE 30037 TO CATREAD-MSG-NUMBER.
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
           IF VIEW-CFNAME = "FDUPLMAT"
               MOVE ERROR-BUFFER TO MATL-CMD-LINE
               MOVE MATL-WORKAREA TO DSPLY-REC
           ELSE
           MOVE ERROR-BUFFER TO INPUT-CMD-LINE
           MOVE INPUT-WA TO DSPLY-REC.
           MOVE TRUE-VAL TO INDS (98).
           PERFORM 99-SCREEN-WRITE.
           PERFORM 98A-SCREEN-READ.
           ADD 1 TO ITEMS-CTR.
           MOVE SPACES TO MATL-WORKAREA.
           MOVE WORK-ORDER-NUMBER        TO WO-NUM-WA.
           MOVE DESCRIPTION-1-P          TO DESCRIPTION-WA.
           MOVE APPROVAL-CODE-P          TO A-C-WA.
           MOVE WO-STATUS-P              TO WO-STATUS-WA.
           MOVE EQUIP-NUM-P              TO EQPNUM-WA.
           MOVE ZONE-P                   TO ZONE-WA.
           MOVE EXP-CLASS-P              TO ADDL-DATA-WA.
           MOVE SPACES                   TO DATE-SCHD-WA.
           MOVE SPACES                   TO TIME-SCHD-WA.
           MOVE PRT-STATUS               TO PRT-STATUS-WA.
           MOVE PRT-PRIME                TO PRIME-WA.
           MOVE ITEMS-CTR                TO ITEM-NO-WA.
           IF PRT-EST-QTY = SPACES
               IF PRT-ACT-QTY = SPACES
                   MOVE 0 TO PRT-EST-QTY-9 PRT-ACT-QTY-9
               ELSE
               MOVE PRT-ACT-QTY-9 TO PRT-EST-QTY-9.
           IF PRT-REQ-NO = SPACES OR "CANCEL"
               MOVE PRT-STATUS           TO PRT-STATUS-WA
               MOVE PRT-EST-QTY-9        TO PRT-QUANT-WA-9
               MOVE PRT-NUM              TO PRT-CODE-WA
               MOVE PRT-UNIT-MEAS        TO PRT-UNIT-MEAS-WA
               MOVE P-UNIT-COST          TO PRT-UP-WA-9
               MOVE PRT-PRIME-1-3        TO PRIME-WA
               MOVE PRT-SUB-1-3          TO SUB-WA
               MOVE PRT-STAGE            TO STAGE-WA
               MOVE INPUT-CC             TO ORIG-WA
               MOVE INPUT-DATE           TO DATE-REQD-WA
               MOVE PRT-ADDL-INFO        TO ADDL-INFO-WA
               MOVE PRT-SUGG-VENDOR      TO SUGG-VENDOR-WA
               MOVE SPACES               TO REQ-NO-WA
                                            PRT-REQ-NO
               MOVE PRT-DESC             TO P-D-WA-80 (1)
               MOVE PRT-DESC-2           TO P-D-WA-80 (2)
               MOVE PRT-DESC-3           TO P-D-WA-80 (3)
               MOVE PRT-DESC-4           TO P-D-WA-80 (4)
               MOVE PRT-DESC-5           TO P-D-WA-80 (5)
               MOVE PRT-REMARKS          TO REMARKS-1-WA
               MOVE PRT-REMARKS-2        TO REMARKS-2-WA
           ELSE
           MOVE "IN"                     TO CMR-CALL-MODE
           MOVE SPACES TO CMR-DATA CMR-RETURNED-DATA CMR-DESC
               CMR-REMARKS CMR-MISC-PARMS BU-DISPLAY-MSG
           MOVE WORK-ORDER-NUMBER        TO CMR-WO-NUMBER
           MOVE PRT-REQ-NO               TO CMR-REQ-NUMBER
           CALL "CMANINQ" USING BASE-STORES
                                CMR-CALL-MODE
                                CMR-DATA
                                CMR-DESC
                                CMR-REMARKS
                                CMR-RETURNED-DATA
                                CMR-MISC-PARMS
                                LANGUAGE-PARMS
                                ESC-NAME
                                STATUS-AREA
                                BU-DISPLAY-MSG
           IF CMR-RETURN-STATUS = "OK"
               MOVE CMR-CORP-CODE        TO PRT-CODE-WA
               MOVE SPACES               TO PRT-REQ-NO
               MOVE INPUT-CC             TO ORIG-WA
               MOVE INPUT-DATE           TO DATE-REQD-WA
               MOVE CMR-STAGING-AREA     TO STAGE-WA
               MOVE CMR-QTY              TO PRT-QUANT-WA-9
               MOVE CMR-UM               TO PRT-UNIT-MEAS-WA
               MOVE CMR-EST-UNIT-PRICE   TO PRT-UP-WA-9
               MOVE CMR-SUB              TO SUB-WA
               MOVE CMR-EXPENSE-CLASS    TO ADDL-DATA-WA
               MOVE CMR-SUGGESTED-VENDOR TO SUGG-VENDOR-WA
               MOVE CMR-ADDTL-INFO       TO ADDL-INFO-WA
               MOVE CMR-DESC-LINE (1)    TO P-D-WA-80 (1)
               MOVE CMR-DESC-LINE (2)    TO P-D-WA-80 (2)
               MOVE CMR-DESC-LINE (3)    TO P-D-WA-80 (3)
               MOVE CMR-DESC-LINE (4)    TO P-D-WA-80 (4)
               MOVE CMR-DESC-LINE (5)    TO P-D-WA-80 (5)
               MOVE CMR-REMARK-1         TO REMARKS-1-WA
               MOVE CMR-REMARK-2         TO REMARKS-2-WA
           ELSE
           MOVE PRT-STATUS               TO PRT-STATUS-WA
           MOVE PRT-EST-QTY-9            TO PRT-QUANT-WA-9
           MOVE PRT-NUM                  TO PRT-CODE-WA
           MOVE PRT-UNIT-MEAS            TO PRT-UNIT-MEAS-WA
           MOVE P-UNIT-COST              TO PRT-UP-WA-9
           MOVE PRT-PRIME-1-3            TO PRIME-WA
           MOVE PRT-SUB-1-3              TO SUB-WA
           MOVE PRT-STAGE                TO STAGE-WA
           MOVE INPUT-CC                 TO ORIG-WA
           MOVE INPUT-DATE               TO DATE-REQD-WA
           MOVE PRT-ADDL-INFO            TO ADDL-INFO-WA
           MOVE PRT-SUGG-VENDOR          TO SUGG-VENDOR-WA
           MOVE SPACES                   TO REQ-NO-WA
                                            PRT-REQ-NO
           MOVE PRT-DESC                 TO P-D-WA-80 (1)
           MOVE PRT-DESC-2               TO P-D-WA-80 (2)
           MOVE PRT-DESC-3               TO P-D-WA-80 (3)
           MOVE PRT-DESC-4               TO P-D-WA-80 (4)
           MOVE PRT-DESC-5               TO P-D-WA-80 (5)
           MOVE PRT-REMARKS              TO REMARKS-1-WA
           MOVE PRT-REMARKS-2            TO REMARKS-2-WA.
           PERFORM 6510-SET-REQD-DATE THRU 6510-SRD-EXIT.
           IF VIEW-LASTKEY = 3
               MOVE 0 TO VIEW-LASTKEY
               MOVE VIEW-NFNAME TO VIEW-CFNAME
               GO TO 651-DP-EXIT.
           MOVE WO-NUM-WA                TO PRT-WO-NU.
           MOVE SPACES                   TO PRT-ITEM-NO.
           MOVE PRT-STATUS-WA            TO PRT-STATUS.
           MOVE PRT-QUANT-WA-9           TO PRT-EST-QTY-9.
           MOVE PRT-CODE-WA              TO PRT-NUM.
           MOVE PRT-UNIT-MEAS-WA         TO PRT-UNIT-MEAS.
           MOVE PRT-UP-WA-9              TO P-UNIT-COST.
           MOVE "120"                    TO PRT-PRIME.
           MOVE STAGE-WA                 TO PRT-STAGE.
           MOVE ORIG-WA                  TO PRT-ORIGINATOR.
           MOVE ADDL-INFO-WA             TO PRT-ADDL-INFO.
           MOVE SUGG-VENDOR-WA           TO PRT-SUGG-VENDOR.
           MOVE SPACES                   TO PRT-REQ-NO.
           MOVE P-D-WA-80 (1)            TO PRT-DESC.
           MOVE P-D-WA-80 (2)            TO PRT-DESC-2.
           MOVE P-D-WA-80 (3)            TO PRT-DESC-3.
           MOVE P-D-WA-80 (4)            TO PRT-DESC-4.
           MOVE P-D-WA-80 (5)            TO PRT-DESC-5.
           MOVE REMARKS-1-WA             TO PRT-REMARKS.
           MOVE REMARKS-2-WA             TO PRT-REMARKS-2.
           MULTIPLY PRT-EST-QTY-9 BY P-UNIT-COST
               GIVING P-EST-COST.
           MOVE SPACES                   TO PRT-ACT-QTY.
           MOVE SPACES                   TO PRT-ACT-COST.
           MOVE SPACES                   TO PRT-PO-NO.
           MOVE " "                      TO PRT-EST-QTY-FLAG.
           MOVE WORK-ORDER-NUMBER TO PRT-WO-NU.
           MOVE " " TO PRT-EST-QTY-FLAG.
           IF PRT-EST-QTY-9 = 0
               IF PRT-ACT-QTY = "        "
                   GO TO 651-DP-LOOP
               ELSE
               IF PRT-ACT-QTY-9 > 0
                   MOVE PRT-ACT-QTY-9 TO PRT-EST-QTY-9.
           MOVE SPACES TO PRT-ACT-QTY PRT-PO-NO.
           MOVE SPACES TO PRT-ITEM-NO PRT-ACT-COST PRT-STAGE.
           IF PRT-NUM = "NON-STR" MOVE "        " TO PRT-NUM.
           IF ORIG-WA = "    "
               MOVE "9999" TO PRT-ORIGINATOR
           ELSE
           MOVE ORIG-WA TO PRT-ORIGINATOR.
           IF DATE-REQD-WA = "      "
               MOVE "99999999" TO PRT-DATE-USED-CN
           ELSE
           MOVE 3 TO DATE-MODE
           MOVE DATE-REQD-WA TO DATE-VALIDATE-IN
           CALL "TDATECHK" USING DATE-CHECK-AREA
           MOVE DATE-DB TO PRT-DATE-USED.
           IF PRT-DATE-USED-YY > "70"
               MOVE "19" TO PRT-DATE-USED-CC
           ELSE
           MOVE "20"     TO PRT-DATE-USED-CC.
           MOVE 0 TO COND-WORD.
           WRITE WPFD2REC FROM WO-PARTS-DATA
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF WPFD2-STATUS NOT = "00" MOVE 17 TO COND-WORD.
           IF COND-WORD = 17
               MOVE 31037 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               PERFORM 99-SCREEN-WRITE
               GO TO 651-DP-EXIT.
           MOVE 35098 TO CATREAD-MSG-NUMBER.
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
           MOVE TRUE-VAL TO INDS (98).
           IF VIEW-CFNAME = "FDUPLMAT"
               MOVE ERROR-BUFFER TO MATL-CMD-LINE
               MOVE MATL-WORKAREA TO DSPLY-REC
           ELSE
           MOVE ERROR-BUFFER TO FDUPL-CMD-LINE
           MOVE INPUT-WA TO DSPLY-REC.
           PERFORM 99-SCREEN-WRITE.
           PERFORM 98A-SCREEN-READ.
           CALL "CLPAUSE2".
           MOVE 0 TO ERROR-SWITCH.
           MOVE SPACES TO ERROR-BUFFER.
           GO TO 651-DP-LOOP.
       651-DP-EXIT.    EXIT.

       6510-SET-REQD-DATE.
           IF INPUT-DATE = SPACES
               NEXT SENTENCE
           ELSE
           MOVE INPUT-DATE TO DATE-REQD-WA
      *    IF ENG-PL-SCHD-ID = "    "
      *        GO TO 6510-SRD-EXIT
      *    ELSE
      *    MOVE ENG-PL-SCHD-ID TO PRT-ORIGINATOR
           GO TO 6510-SRD-EXIT.
           MOVE VIEW-CFNAME TO VIEW-NFNAME.
           MOVE "FDUPLMAT" TO VIEW-CFNAME.
           IF PRT-CODE-WA = "NON-STR" MOVE "       " TO PRT-CODE-WA.
           MOVE "ENTER ORIGINATOR AND DATA REQUIRED" TO MESSAGE-WA.
           MOVE MATL-WORKAREA TO DSPLY-REC.
           PERFORM 99-SCREEN-WRITE.
       6510-SRD-READ.
           PERFORM 98-SCREEN-READ.
           IF VIEW-LASTKEY = 3 GO TO 6510-SRD-EXIT.
           MOVE DSPLY-REC TO MATL-WORKAREA.
           IF ORIG-WA = "    "
               MOVE 41015 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE ERROR-BUFFER TO MATL-ERR-LINE
               MOVE TRUE-VAL TO INDS (20) INDS (99)
               PERFORM 99-SCREEN-WRITE
               GO TO 6510-SRD-READ.
           MOVE ORIG-WA TO ARG-NO-1-4.
           MOVE ARG-NO-1-4 TO PERCCNUM OF PFREC.
           MOVE 0 TO COND-WORD.
           START PERSONNEL-FILE KEY IS = EXTERNALLY-DESCRIBED-KEY
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF PF-STATUS NOT = "00" MOVE 17 TO COND-WORD.
           IF COND-WORD = 17
               MOVE 41001 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE ERROR-BUFFER TO MATL-ERR-LINE
               MOVE TRUE-VAL TO INDS (20) INDS (99)
               PERFORM 99-SCREEN-WRITE
               GO TO 6510-SRD-READ.
           IF DATE-REQD-WA = "      "
               MOVE 30020 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE ERROR-BUFFER TO MATL-ERR-LINE
               MOVE TRUE-VAL TO INDS (35) INDS (99)
               PERFORM 99-SCREEN-WRITE
               GO TO 6510-SRD-READ
           ELSE
           IF DATE-FLAG = 3
               IF DATE-REQD-MD-WA > 00 AND < 32
                   IF DATE-REQD-DM-WA > 00 AND < 13
                       IF DATE-REQD-YY-WA IS NUMERIC
                           NEXT SENTENCE
                       ELSE
                       MOVE 35032 TO CATREAD-MSG-NUMBER
                       PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                       MOVE ERROR-BUFFER TO MATL-ERR-LINE
                       MOVE TRUE-VAL TO INDS (37) INDS (99)
                       PERFORM 99-SCREEN-WRITE
                       GO TO 6510-SRD-READ
                   ELSE
                   MOVE 35031 TO CATREAD-MSG-NUMBER
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE ERROR-BUFFER TO MATL-ERR-LINE
                   MOVE TRUE-VAL TO INDS (36) INDS (99)
                   PERFORM 99-SCREEN-WRITE
                   GO TO 6510-SRD-READ
               ELSE
               MOVE 35030 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE ERROR-BUFFER TO MATL-ERR-LINE
               MOVE TRUE-VAL TO INDS (35) INDS (99)
               PERFORM 99-SCREEN-WRITE
               GO TO 6510-SRD-READ
           ELSE
           IF DATE-REQD-MD-WA > 00 AND < 13
               IF DATE-REQD-DM-WA > 00 AND < 32
                   IF DATE-REQD-YY-WA IS NUMERIC
                       NEXT SENTENCE
                   ELSE
                   MOVE 35032 TO CATREAD-MSG-NUMBER
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE ERROR-BUFFER TO MATL-ERR-LINE
                   MOVE TRUE-VAL TO INDS (37) INDS (99)
                   PERFORM 99-SCREEN-WRITE
                   GO TO 6510-SRD-READ
               ELSE
               MOVE 35030 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE ERROR-BUFFER TO MATL-ERR-LINE
               MOVE TRUE-VAL TO INDS (36) INDS (99)
               PERFORM 99-SCREEN-WRITE
               GO TO 6510-SRD-READ
           ELSE
           MOVE 35031 TO CATREAD-MSG-NUMBER
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
           MOVE ERROR-BUFFER TO MATL-ERR-LINE
           MOVE TRUE-VAL TO INDS (35) INDS (99)
           PERFORM 99-SCREEN-WRITE
           GO TO 6510-SRD-READ.

       6510-SRD-EXIT.    EXIT.

       661-DUPLICATE-JOBPLAN.
           MOVE SPACES TO JOBP-KEY JOBPLAN-BUFFER.
           MOVE WONO-BUF TO JOBP-WO-NO.
           MOVE 001 TO JOBP-SEQ-NO.
       661-DJ-FIND.
           MOVE 0 TO COND-WORD.
           MOVE JOBP-KEY TO JOBPWOSEQ OF JFREC.
           START JOBPLAN-FILE KEY IS = EXTERNALLY-DESCRIBED-KEY
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF JF-STATUS NOT = "00" MOVE 17 TO COND-WORD.
           IF COND-WORD = 17 GO TO 661-DJ-EXIT.
       661-DJ-LOOP.
           MOVE 0 TO COND-WORD.
           READ JOBPLAN-FILE NEXT INTO JOBPLAN-BUFFER
               AT END    MOVE 15 TO COND-WORD.
           IF JOBPLAN-WO-NO NOT = JOBP-WO-NO
               MOVE 15 TO COND-WORD.
           IF JF-STATUS NOT = "00" MOVE 15 TO COND-WORD.
           IF COND-WORD = 15 GO TO 661-DJ-EXIT.
           MOVE WORK-ORDER-NUMBER TO JOBPLAN-WO-NO.
           WRITE JF2REC FROM JOBPLAN-BUFFER
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF JF2-STATUS NOT = "00" MOVE 17 TO COND-WORD.
           IF COND-WORD = 17
               MOVE 31038 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               PERFORM 99-SCREEN-WRITE
               GO TO 661-DJ-EXIT.
           GO TO 661-DJ-LOOP.
       661-DJ-EXIT.    EXIT.

       662-UPDATE-LJS.
           MOVE 0 TO COND-WORD.
           MOVE WORK-ORDER-NUMBER TO WONUM OF WPFREC.
           START WO-PLANNED-FILE KEY = EXTERNALLY-DESCRIBED-KEY
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF WPF-STATUS NOT = "00" MOVE 17 TO COND-WORD.
           IF COND-WORD = 17 GO TO 662-ULJS-EXIT.
           READ WO-PLANNED-FILE NEXT INTO WO-PLANNED-DATA
               AT END    MOVE 15 TO COND-WORD.
           IF WPF-STATUS NOT = "00" MOVE 15 TO COND-WORD.
           IF COND-WORD = 15 GO TO 662-ULJS-EXIT.
           MOVE "    " TO LAST-JOBPLAN-SEQ.
           REWRITE WPFREC FROM WO-PLANNED-DATA.
       662-ULJS-EXIT.    EXIT.

       6611-SET-LABOR-RATE.
           READ PERSONNEL-FILE NEXT INTO PER-PERSONNEL-DATA
               AT END    MOVE 15 TO COND-WORD.
           IF PF-STATUS NOT = "00" MOVE 15 TO COND-WORD.
           IF COND-WORD = 15
               MOVE 35.00 TO PLANT-LABOR-RATE
               GO TO 6611-SLR-EXIT.
           IF JOBPLAN-CRAFT NOT = PER-CRAFT
               GO TO 6611-SET-LABOR-RATE.
           MOVE PER-LABOR-RATE TO PLANT-LABOR-RATE.

       6611-SLR-EXIT.    EXIT.

       67-READTERM.
           MOVE SPACES TO BUFFER EDIT-WORK-AREA.
           PERFORM 98-SCREEN-READ.
           IF VIEW-LASTKEY = 3 GO TO 2-EOJ.
           MOVE DSPLY-REC TO BUFFER.
           IF PLANNED-SW = 0
               MOVE WO-STAT            TO  EDIT-WO-STAT
               MOVE WO-DATE-REC        TO  EDIT-DATE-RECD
               PERFORM 671-SET-REC-BUF
               MOVE WO-TIME-REC        TO  EDIT-TIME-RECD
               MOVE WO-APPR-CODE       TO  EDIT-APPROVAL-CODE
               MOVE WO-REQUESTER       TO  EDIT-REQUESTER
               MOVE WO-EQPNUM          TO  EDIT-EQUIP-NUM
               MOVE WO-EQPNAME         TO  EDIT-EQUIP-NAME
               MOVE WO-EQPTYP          TO  EDIT-TYPE-NUM
               MOVE WO-DEPT            TO  EDIT-DEPT
               MOVE WO-MAINT-ZONE      TO  EDIT-ZONE
               MOVE WO-LOC             TO  EDIT-LOCATION
               MOVE WO-PRIORITY        TO  EDIT-PRIORITY
               MOVE WO-EQPDWN          TO  EDIT-EQUIP-DOWN
               MOVE WO-EXPCLASS        TO  EDIT-EXPCLASS
               MOVE WO-DATE-STRT       TO  EDIT-DATE-STRT
               PERFORM 673-SET-STRT-BUF
               MOVE WO-TIME-STRT       TO  EDIT-TIME-STRT
               MOVE WO-DATE-COMP       TO  EDIT-DATE-COMP
               PERFORM 674-SET-COMP-BUF
               MOVE WO-TIME-COMP       TO  EDIT-TIME-COMP
           ELSE
           MOVE WO-STAT-P              TO  EDIT-WO-STAT
           MOVE WO-DATE-REC-P          TO  EDIT-DATE-RECD
           PERFORM 671-SET-REC-BUF
           MOVE WO-TIME-REC-P          TO  EDIT-TIME-RECD
           MOVE WO-APPR-CODE-P         TO  EDIT-APPROVAL-CODE
           MOVE WO-REQUESTER-P         TO  EDIT-REQUESTER
           MOVE WO-EQPNUM-P            TO  EDIT-EQUIP-NUM
           MOVE WO-EQPNAME-P           TO  EDIT-EQUIP-NAME
           MOVE WO-EQPTYP-P            TO  EDIT-TYPE-NUM
           MOVE WO-DEPT-P              TO  EDIT-DEPT
           MOVE WO-MAINT-ZONE-P        TO  EDIT-ZONE
           MOVE WO-LOC-P               TO  EDIT-LOCATION
           MOVE WO-PRIORITY-P          TO  EDIT-PRIORITY
           MOVE WO-EQPDWN-P            TO  EDIT-EQUIP-DOWN
           MOVE WO-EXPCLASS-P          TO  EDIT-EXPCLASS
           MOVE WO-ENGINEER-P          TO  EDIT-ENGINEER
           MOVE WO-PLANNER-P           TO  EDIT-PLANNER
           MOVE WO-SCHEDULER-P         TO  EDIT-SCHEDULER
           MOVE WO-SCHD-DATE-P         TO  EDIT-DATE-SCHD
           PERFORM 672-SET-SCHD-BUF
           MOVE WO-TIME-SCHD-P         TO  EDIT-TIME-SCHD
           MOVE WO-DATE-STRT-P         TO  EDIT-DATE-STRT
           PERFORM 673-SET-STRT-BUF
           MOVE WO-TIME-STRT-P         TO  EDIT-TIME-STRT
           MOVE WO-DATE-COMP-P         TO  EDIT-DATE-COMP
           PERFORM 674-SET-COMP-BUF
           MOVE WO-TIME-COMP-P         TO  EDIT-TIME-COMP
           IF USERNAME = "ENG"
               MOVE "E"                TO EDIT-WO-CURRENT-TYPE
           ELSE
           IF USERNAME = "PLANNER"
               MOVE "P"                TO EDIT-WO-CURRENT-TYPE
           ELSE
           MOVE WO-CURRENT-TYPE        TO  EDIT-WO-CURRENT-TYPE.
       67-RT-EXIT.    EXIT.
       671-SET-REC-BUF.
           MOVE 3 TO DATE-MODE.
           IF PLANNED-SW = 0
               MOVE WO-DATE-REC TO DATE-VALIDATE-IN
               CALL "TDATECHK" USING DATE-CHECK-AREA
               MOVE DATE-DB TO DATE-RECD-BUF
           ELSE
           MOVE WO-DATE-REC-P TO DATE-VALIDATE-IN
           CALL "TDATECHK" USING DATE-CHECK-AREA
           MOVE DATE-DB TO DATE-RECD-BUF.
           IF DATE-RECD-BUF-YY > "70"
               MOVE "19" TO DATE-RECD-BUF-CC
           ELSE
           MOVE "20"     TO DATE-RECD-BUF-CC.
       672-SET-SCHD-BUF.
           MOVE 3 TO DATE-MODE.
           MOVE WO-SCHD-DATE-P TO DATE-VALIDATE-IN.
           CALL "TDATECHK" USING DATE-CHECK-AREA.
           MOVE DATE-DB TO DATE-PROM-BUF.
           IF DATE-PROM-BUF-YY > "70"
               MOVE "19" TO DATE-PROM-BUF-CC
           ELSE
           MOVE "20"     TO DATE-PROM-BUF-CC.
       673-SET-STRT-BUF.
           MOVE 3 TO DATE-MODE.
           IF PLANNED-SW = 0
               MOVE WO-DATE-STRT TO DATE-VALIDATE-IN
               CALL "TDATECHK" USING DATE-CHECK-AREA
               MOVE DATE-DB TO DATE-STRT-BUF
           ELSE
           MOVE WO-DATE-STRT-P TO DATE-VALIDATE-IN
           CALL "TDATECHK" USING DATE-CHECK-AREA
           MOVE DATE-DB TO DATE-STRT-BUF.
           IF DATE-STRT-BUF-YY > "70"
               MOVE "19" TO DATE-STRT-BUF-CC
           ELSE
           MOVE "20"     TO DATE-STRT-BUF-CC.
       674-SET-COMP-BUF.
           MOVE 3 TO DATE-MODE.
           IF PLANNED-SW = 0
               MOVE WO-DATE-COMP TO DATE-VALIDATE-IN
               CALL "TDATECHK" USING DATE-CHECK-AREA
               MOVE DATE-DB TO DATE-COMP-BUF
           ELSE
           MOVE WO-DATE-COMP-P TO DATE-VALIDATE-IN
           CALL "TDATECHK" USING DATE-CHECK-AREA
           MOVE DATE-DB TO DATE-COMP-BUF.
           IF DATE-COMP-BUF-YY > "70"
               MOVE "19" TO DATE-COMP-BUF-CC
           ELSE
           MOVE "20"     TO DATE-COMP-BUF-CC.

       98-SCREEN-READ.
           READ DISPLAY-FILE FORMAT IS VIEW-CFNAME
               INDIC IS INDICS.
           ACCEPT IOFEEDBACK FROM I-O-FEEDBACK-AREA.
           MOVE ALL B"0" TO INDICS.
           IF DSPLY-STATUS NOT = "00"
               MOVE 3 TO VIEW-LASTKEY
           ELSE
           MOVE FUNCTION-NUM TO VIEW-LASTKEY.

       98A-SCREEN-READ.
           READ DISPLAY-FILE TERMINAL IS TERMINAL-ID
               INDIC IS INDICS
                  NO DATA MOVE DSPLY-STATUS TO DSPLY-STATUS.
           MOVE ALL B"0" TO INDICS.

       99-SCREEN-WRITE.
           WRITE DSPLY-REC FORMAT IS VIEW-CFNAME
               INDIC IS INDICS.
           MOVE ALL B"0" TO INDICS.

       998-BLOWUP.
           MOVE "TDUPLSUB" TO BU-PGM-NAME.
           CALL "TBLOWUP" USING BLOWUP-BASE BU-PGM-NAME STATUS-AREA
                            VIEW-COMAREA DUMMY-KSAM-STAT
                            BU-DISPLAY-MSG BU-DISPLAY-FLDS.

       999-CATREAD.
           MOVE SPACES TO ERROR-BUFFER.
           CALL "CCATREAD" USING CATREAD-PARMS.
           MOVE CATREAD-MSG-TEXT TO ERROR-BUFFER.
       999-CATREAD-EXIT.
           EXIT.
