
       IDENTIFICATION DIVISION.
       PROGRAM-ID.             SPMFRCST.
       AUTHOR.                 J.S. BUNGO.
       INSTALLATION.           GOODYEAR TIRE & RUBBER CO.
      *REMARKS.                PM FORCASTING OF SCHEDULE AND REVIEW OF
      *                        SCHEDULE SIMULATOR.
      *                        ****.
       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.
       SOURCE-COMPUTER.        IBM-AS400.
       OBJECT-COMPUTER.        IBM-AS400.
       SPECIAL-NAMES.          C01 IS NEW-PAGE
                               I-O-FEEDBACK IS I-O-FEEDBACK-AREA.

      *C***************************************************************
      *C  07/28/94  JEFF BUNGO  REQUEST #6522
      *C  CHANGED PROGRAM TO ALLOW NEW SELECTION ON A FORECAST TO
      *C  REPORT ONLY THE NEXT RELEASE OF A WORKORDER NUMBER.
      *C***************************************************************
      *C  09/26/94  W. ROXBURY
      *C  ADDED EUROPEAN DATE CODING TO PROGRAM.  WAS NOT INCLUDED IN
      *C  ORIGINAL VERSION BUT IS NEEDED FOR AUSTRALIA.
      *C***************************************************************

       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT DISPLAY-FILE
                  ASSIGN       TO WORKSTATION-ZPMMAINT-SI
                  ORGANIZATION IS TRANSACTION
                  ACCESS MODE  IS SEQUENTIAL
                  FILE STATUS  IS SCREEN-STATUS
                  CONTROL-AREA IS WS-CONTROL.

           SELECT OUT-FILE
                  ASSIGN       TO DISK-OPMFRCST
                  ORGANIZATION IS RELATIVE
                  ACCESS MODE  IS DYNAMIC
                  RELATIVE KEY IS ACT-KEY
                  FILE STATUS  IS FILE-STATUS.

           SELECT PRINT-FILE
                  ASSIGN       TO PRINTER-MCPRT
                  FILE STATUS  IS FILE-STATUS.

           SELECT WO-PLANNED
                  ASSIGN       TO DATABASE-MCFLMM1101
                  ORGANIZATION IS INDEXED
                  ACCESS MODE  IS DYNAMIC
                  RECORD KEY   IS EXTERNALLY-DESCRIBED-KEY
                               WITH DUPLICATES
                  FILE STATUS  IS FILE-STATUS.

           SELECT PM-SCHEDULE-WO
                  ASSIGN       TO DATABASE-MCFLMM4404
                  ORGANIZATION IS INDEXED
                  ACCESS MODE  IS DYNAMIC
                  RECORD KEY   IS EXTERNALLY-DESCRIBED-KEY
                               WITH DUPLICATES
                  FILE STATUS  IS FILE-STATUS.

           SELECT PM-SCHEDULE-EQP
                  ASSIGN       TO DATABASE-MCFLMM4403
                  ORGANIZATION IS INDEXED
                  ACCESS MODE  IS DYNAMIC
                  RECORD KEY   IS EXTERNALLY-DESCRIBED-KEY
                               WITH DUPLICATES
                  FILE STATUS  IS FILE-STATUS.

           SELECT PM-SCHEDULE-ZN
                  ASSIGN       TO DATABASE-MCFLMM4405
                  ORGANIZATION IS INDEXED
                  ACCESS MODE  IS DYNAMIC
                  RECORD KEY   IS EXTERNALLY-DESCRIBED-KEY
                               WITH DUPLICATES
                  FILE STATUS  IS FILE-STATUS.

           SELECT PM-SCHEDULE-ALL
                  ASSIGN       TO DATABASE-MCFLMM4401
                  ORGANIZATION IS INDEXED
                  ACCESS MODE  IS DYNAMIC
                  RECORD KEY   IS EXTERNALLY-DESCRIBED-KEY
                               WITH DUPLICATES
                  FILE STATUS  IS FILE-STATUS.

           SELECT PM-SIMULATOR-WO
                  ASSIGN       TO DATABASE-MCFLMM4504
                  ORGANIZATION IS INDEXED
                  ACCESS MODE  IS DYNAMIC
                  RECORD KEY   IS EXTERNALLY-DESCRIBED-KEY
                               WITH DUPLICATES
                  FILE STATUS  IS FILE-STATUS.

           SELECT PM-SIMULATOR-EQP
                  ASSIGN       TO DATABASE-MCFLMM4503
                  ORGANIZATION IS INDEXED
                  ACCESS MODE  IS DYNAMIC
                  RECORD KEY   IS EXTERNALLY-DESCRIBED-KEY
                               WITH DUPLICATES
                  FILE STATUS  IS FILE-STATUS.

           SELECT PM-SIMULATOR-ZN
                  ASSIGN       TO DATABASE-MCFLMM4505
                  ORGANIZATION IS INDEXED
                  ACCESS MODE  IS DYNAMIC
                  RECORD KEY   IS EXTERNALLY-DESCRIBED-KEY
                               WITH DUPLICATES
                  FILE STATUS  IS FILE-STATUS.

           SELECT PM-SIMULATOR-ALL
                  ASSIGN       TO DATABASE-MCFLMM4501
                  ORGANIZATION IS INDEXED
                  ACCESS MODE  IS DYNAMIC
                  RECORD KEY   IS EXTERNALLY-DESCRIBED-KEY
                               WITH DUPLICATES
                  FILE STATUS  IS FILE-STATUS.

           SELECT SORT-FILE
                  ASSIGN       TO DISK-SORTFILE.

       DATA DIVISION.
       FILE SECTION.
       FD  DISPLAY-FILE
           LABEL RECORDS       ARE OMITTED.
       01  DISPLAY-REC         PIC X(2000).

       FD  OUT-FILE RECORD     CONTAINS 55 CHARACTERS
           LABEL RECORDS       ARE OMITTED
           DATA RECORD         IS OUT-REC.
       01  OUT-REC.
           05  OUT-RLSE-DATE.
               10  OUT-RLSE-YYYY PIC X(04).
               10  OUT-RLSE-MM PIC X(02).
               10  OUT-RLSE-DD PIC X(02).
