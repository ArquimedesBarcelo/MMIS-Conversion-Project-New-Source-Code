       LINKAGE SECTION.
       01  DBPARAMETERS.       COPY DBPARMS   IN COPYLIB.

           COPY VCOMLINK       IN COPYLIB.

           COPY LANGSUB        IN COPYLIB.

       01  INIT-SIM-FLAG       PIC X(01).
           88  INITIATOR                      VALUE "I".
           88  SIMULATOR                      VALUE "S".

       PROCEDURE DIVISION      USING DBPARAMETERS
                               VIEW-COMAREA
                               LANGUAGE-PARMS
                               INIT-SIM-FLAG.
       BEGIN-SORT SECTION 01.
       BEGIN-PROC.
           PERFORM 1-HSK       THRU 1-EXIT.
           GO TO SELECTION-CRITERIA.

       1-HSK.
      *----CLEAR ALL SIMULATIONS GREATER THAN 30 DAYS OLD
           IF SIMULATOR
               OPEN I-O        PM-SIMULATOR-ALL
               PERFORM CALC-CLEAR-DATE THRU CALC-CLEAR-DATE-EXIT
               PERFORM CLEAR-SIMULATOR THRU CLEAR-SIMULATOR-EXIT
               CLOSE           PM-SIMULATOR-ALL
           END-IF.

           CALL "CLPMFRCST".
           OPEN I-O            DISPLAY-FILE.
           OPEN INPUT          WO-PLANNED.

           IF INITIATOR
               OPEN INPUT      PM-SCHEDULE-WO
                               PM-SCHEDULE-EQP
                               PM-SCHEDULE-ZN
           ELSE
               OPEN INPUT      PM-SIMULATOR-WO
                               PM-SIMULATOR-EQP
                               PM-SIMULATOR-ZN
           END-IF.

           ACCEPT TD-YMD       FROM DATE.
           IF TD-YY > 90
               MOVE "19"       TO PRT-DATE-CT
           ELSE
               MOVE "20"       TO PRT-DATE-CT.

           MOVE TD-YY          TO PRT-DATE-YY.
           MOVE TD-MM          TO PRT-DATE-MM.
           MOVE TD-DD          TO PRT-DATE-DD.
           ACCEPT CT-HMS       FROM TIME.
           MOVE CT-HH          TO PRT-TIME-HH.
           MOVE CT-MM          TO PRT-TIME-MM.
           MOVE CT-SS          TO PRT-TIME-SS.

       1-EXIT.                 EXIT.

       2-EOJ.
           CLOSE               WO-PLANNED
                               DISPLAY-FILE
                               OUT-FILE.
           IF INITIATOR
               CLOSE           PM-SCHEDULE-WO
                               PM-SCHEDULE-EQP
                               PM-SCHEDULE-ZN
                               PM-SCHEDULE-ALL
           ELSE
               CLOSE           PM-SIMULATOR-WO
                               PM-SIMULATOR-EQP
                               PM-SIMULATOR-ZN
                               PM-SIMULATOR-ALL
           END-IF.
           GOBACK.

       SELECTION-CRITERIA.
           MOVE SPACES         TO MESSAGE-BUFFER
                                  SEL-SCREEN-BUFFER
                                  RPT-SCREEN-BUFFER.
           IF INITIATOR
               MOVE "1"        TO SEL-CALENDAR
               MOVE "N"        TO SEL-NEXT-ONLY.
           MOVE "1"            TO SEL-SORT.
           IF INITIATOR
             MOVE "VSELFRCST"  TO VIEW-NFNAME
           ELSE
             MOVE "VSELSMLTR"  TO VIEW-NFNAME
           END-IF.
           MOVE 41             TO HELP-SW.

       SHOWFORM-SELECTION.
           MOVE "00"           TO SCREEN-STATUS.
           IF SEL-WO = "ALL       "
               MOVE SPACES     TO SEL-WO.
           MOVE "000"          TO SEL-SUFF.
           MOVE SEL-SCREEN-BUFFER TO DISPLAY-REC.

           WRITE DISPLAY-REC   FORMAT IS VIEW-NFNAME
                               INDIC ARE SRF-INDICATORS.
           IF SCREEN-STATUS NOT = "00"
               DISPLAY "SCREEN WRITE ERROR, STATUS=" SCREEN-STATUS
               GO TO 2-EOJ.
           MOVE ALL B"0"       TO SRF-INDICATORS.

           READ DISPLAY-FILE   FORMAT IS VIEW-NFNAME
                               INDIC ARE SRF-INDICATORS.
           ACCEPT IOFEEDBACK   FROM I-O-FEEDBACK-AREA.
           IF SCREEN-STATUS NOT = "00"
               DISPLAY "SCREEN READ ERROR, STATUS=" SCREEN-STATUS
               GO TO 2-EOJ
           ELSE
               MOVE FUNCTION-NUM TO VIEW-LASTKEY.
           MOVE DISPLAY-REC    TO SEL-SCREEN-BUFFER.

           IF VIEW-LASTKEY = 3 OR 8
               GO TO 2-EOJ.

           IF VIEW-LASTKEY = 7
               CALL "SPMHELPM" USING HELP-SW
               GO TO SELECTION-CRITERIA.

           IF VIEW-LASTKEY NOT = 0
               GO TO SHOWFORM-SELECTION.

           IF SEL-STRT-DATE = SPACES
               MOVE "ALL     " TO SEL-STRT-DATE
           ELSE
           IF SEL-STRT-DATE = "ALL     "
               NEXT SENTENCE
           ELSE
               MOVE SPACE      TO DATE-EDIT-SW
               MOVE SEL-STRT-DATE TO CHECK-DATE
               PERFORM EDIT-DATE-FUNCTION THRU EDF-EXIT
               IF DATE-EDIT-SW NOT = " "
                   MOVE TRUE-VAL TO IND(FIELD-NUMBER) IND(99)
                   GO TO SHOWFORM-SELECTION.

           IF SEL-END-DATE = SPACES
               MOVE "ALL     " TO SEL-END-DATE
           ELSE
           IF SEL-END-DATE = "ALL     "
               NEXT SENTENCE
           ELSE
               MOVE SPACE      TO DATE-EDIT-SW
               MOVE SEL-END-DATE TO CHECK-DATE
               PERFORM EDIT-DATE-FUNCTION THRU EDF-EXIT
               IF DATE-EDIT-SW NOT = " "
                   ADD  3      TO FIELD-NUMBER
                   MOVE TRUE-VAL TO IND(FIELD-NUMBER) IND(99)
                   GO TO SHOWFORM-SELECTION.

           IF SEL-WO-7 = SPACES
               MOVE "ALL       " TO SEL-WO.

           IF SEL-EQUIP = SPACES
               MOVE "ALL   "   TO SEL-EQUIP.

           IF SEL-ZONE = SPACES
               MOVE "ALL "     TO SEL-ZONE.

           IF SEL-WO NOT = "ALL       "
               CALL "TALWONO"  USING SEL-WO RETURN-COD
               IF RET-CODE = "1"
      *C********************************************************************
      *C    MESSAGE 035/040:
      *C INVALID WORKORDER NUMBER
      *C********************************************************************
                   MOVE  35    TO LANG-SETNUM
                   MOVE  40    TO LANG-MSGNUM
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE 1      TO FIELD-NUMBER
                   MOVE TRUE-VAL TO IND(FIELD-NUMBER) IND(99)
                   GO TO SHOWFORM-SELECTION
               ELSE
               IF INITIATOR
                 MOVE SEL-WO   TO WONUM OF PM-SCHEDULE-WO
                 READ PM-SCHEDULE-WO
                     INVALID KEY MOVE FILE-STATUS TO FILE-STATUS
               ELSE
                 MOVE SEL-WO   TO WONUM OF PM-SIMULATOR-WO
                 READ PM-SIMULATOR-WO
                     INVALID KEY MOVE FILE-STATUS TO FILE-STATUS
               END-IF
               IF FILE-STATUS NOT = "00"
                   IF INITIATOR
      *C********************************************************************
      *C    MESSAGE 049/065:
      *C WORKORDER HAS NOT BEEN SCHEDULED
      *C********************************************************************
                       MOVE 49 TO LANG-SETNUM
                       MOVE 65 TO LANG-MSGNUM
                   ELSE
      *C********************************************************************
      *C    MESSAGE 049/066:
      *C WORKORDER HAS NOT BEEN SIMULATED
      *C********************************************************************
                       MOVE 49 TO LANG-SETNUM
                       MOVE 66 TO LANG-MSGNUM
                   END-IF
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE 7      TO FIELD-NUMBER
                   MOVE TRUE-VAL TO IND(FIELD-NUMBER) IND(99)
                   GO TO SHOWFORM-SELECTION.

           IF SEL-EQUIP NOT = "ALL   "
               IF INITIATOR
                 MOVE SEL-EQUIP TO PMEQPNUM OF PM-SCHEDULE-EQP
                 READ PM-SCHEDULE-EQP
                     INVALID KEY MOVE FILE-STATUS TO FILE-STATUS
               ELSE
                 MOVE SEL-EQUIP TO PMEQPNUM OF PM-SIMULATOR-EQP
                 READ PM-SIMULATOR-EQP
                     INVALID KEY MOVE FILE-STATUS TO FILE-STATUS
               END-IF
               IF FILE-STATUS NOT = "00"
                   IF INITIATOR
      *C********************************************************************
      *C    MESSAGE 031/104:
      *C EQUIPMENT HAS NOT BEEN SCHEDULED
      *C********************************************************************
                       MOVE 31 TO LANG-SETNUM
                       MOVE 104 TO LANG-MSGNUM
                   ELSE
      *C********************************************************************
      *C    MESSAGE 031/105:
      *C EQUIPMENT HAS NOT BEEN SIMULATED
      *C********************************************************************
                       MOVE 31 TO LANG-SETNUM
                       MOVE 105 TO LANG-MSGNUM
                   END-IF
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE 8      TO FIELD-NUMBER
                   MOVE TRUE-VAL TO IND(FIELD-NUMBER) IND(99)
                   GO TO SHOWFORM-SELECTION.

           IF SEL-ZONE NOT = "ALL "
               IF INITIATOR
                 MOVE SEL-ZONE TO ZONE OF PM-SCHEDULE-ZN
                 READ PM-SCHEDULE-ZN
                     INVALID KEY MOVE FILE-STATUS TO FILE-STATUS
               ELSE
                 MOVE SEL-ZONE TO ZONE OF PM-SIMULATOR-ZN
                 READ PM-SIMULATOR-ZN
                     INVALID KEY MOVE FILE-STATUS TO FILE-STATUS
               END-IF
               IF FILE-STATUS NOT = "00"
                   IF INITIATOR
      *C********************************************************************
      *C    MESSAGE 040/081:
      *C NOTHING IN ZONE HAS BEEN SCHEDULED
      *C********************************************************************
                       MOVE 40 TO LANG-SETNUM
                       MOVE 81 TO LANG-MSGNUM
                   ELSE
      *C********************************************************************
      *C    MESSAGE 040/082:
      *C NOTHING IN ZONE HAS BEEN SIMULATED
      *C********************************************************************
                       MOVE 40 TO LANG-SETNUM
                       MOVE 82 TO LANG-MSGNUM
                   END-IF
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE 9      TO FIELD-NUMBER
                   MOVE TRUE-VAL TO IND(FIELD-NUMBER) IND(99)
                   GO TO SHOWFORM-SELECTION.
           MOVE "F" TO SORT-IT-AGAIN.

       SORT-IT.
           MOVE 0 TO ACT-KEY.
           IF SEL-SORT-X = "1"
               SORT SORT-FILE  ASCENDING KEY SORT-RLSE-DATE
                                             SORT-ZONE
                                             SORT-EQUIP-NUM
                 INPUT PROCEDURE SORT-SCHED
                 OUTPUT PROCEDURE SORT-OUT
           ELSE IF SEL-SORT-X = "2"
               SORT SORT-FILE  ASCENDING KEY SORT-ZONE
                                             SORT-RLSE-DATE
                                             SORT-EQUIP-NUM
                 INPUT PROCEDURE SORT-SCHED
                 OUTPUT PROCEDURE SORT-OUT
           ELSE IF SEL-SORT-X = "3"
               SORT SORT-FILE  ASCENDING KEY SORT-EQUIP-NUM
                                             SORT-ZONE
                                             SORT-RLSE-DATE
                 INPUT PROCEDURE SORT-SCHED
                 OUTPUT PROCEDURE SORT-OUT
           ELSE IF SEL-SORT-X = "4"
               SORT SORT-FILE  ASCENDING KEY SORT-EQUIP-NUM
                                             SORT-RLSE-DATE
                                             SORT-ZONE
                 INPUT PROCEDURE SORT-SCHED
                 OUTPUT PROCEDURE SORT-OUT
           ELSE
      *C********************************************************************
      *C    MESSAGE 035/095:
      *C INVALID SORT ORDER
      *C********************************************************************
               MOVE   35       TO LANG-SETNUM
               MOVE   95       TO LANG-MSGNUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE 12         TO FIELD-NUMBER
               MOVE TRUE-VAL   TO IND(FIELD-NUMBER) IND(99)
               GO TO SHOWFORM-SELECTION.

           IF MAX-KEY = 0
      *C********************************************************************
      *C    MESSAGE 040/011:
      *C NO RECORDS FOUND WHICH MATCH YOUR SELECTION
      *C********************************************************************
               MOVE   40       TO LANG-SETNUM
               MOVE   11       TO LANG-MSGNUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE 1          TO FIELD-NUMBER
               MOVE TRUE-VAL   TO IND(FIELD-NUMBER) IND(99)
               GO TO SHOWFORM-SELECTION
           END-IF.

           IF SEL-PRINT = "Y"
      *      MOVE 0            TO OVRPRTF-TOFILE-NUM
             MOVE "P "         TO OVRPRTF-TOFILE-NUM-X
             MOVE "MCPRT"      TO OVRPRTF-FILE
             PERFORM 996-OVERRIDE-PRINT-FILE
             OPEN OUTPUT       PRINT-FILE
           END-IF.

           MOVE 0              TO ACT-KEY.
           MOVE "N"            TO EOF-SW.
           OPEN INPUT          OUT-FILE.

       61-RESET-SCREEN.
           MOVE SPACES         TO RPT-SCREEN-BUFFER.
           MOVE SPACES         TO MESSAGE-BUFFER.
           IF SEL-STRT-DATE NOT = "ALL     "
               MOVE "/"        TO RPT-STRT-SL1 RPT-STRT-SL2
               MOVE SEL-STRT-YYYY TO RPT-STRT-YYYY
               MOVE SEL-STRT-MM TO RPT-STRT-MM
               MOVE SEL-STRT-DD TO RPT-STRT-DD
           ELSE
               MOVE SEL-STRT-DATE TO RPT-STRT-DATE.

           IF SEL-END-DATE NOT = "ALL     "
               MOVE "/"        TO RPT-END-SL1 RPT-END-SL2
               MOVE SEL-END-YYYY TO RPT-END-YYYY
               MOVE SEL-END-MM TO RPT-END-MM
               MOVE SEL-END-DD TO RPT-END-DD
           ELSE
               MOVE SEL-END-DATE TO RPT-END-DATE.

           MOVE SEL-WO         TO RPT-WO-SEL.
           MOVE SEL-EQUIP      TO RPT-EQUIP-SEL.
           MOVE SEL-ZONE       TO RPT-ZONE-SEL.

           IF SIMULATOR
               MOVE SPACES     TO SEL-CALENDAR
               MOVE SPACES     TO RPT-CALENDAR
               MOVE SPACES     TO SEL-NEXT-ONLY
               MOVE SPACES     TO RPT-RLSE-SEL
           ELSE IF SEL-CALENDAR = "1"
               MOVE CALENDAR1  TO RPT-CALENDAR
           ELSE IF SEL-CALENDAR = "2"
               MOVE CALENDAR2  TO RPT-CALENDAR
           ELSE IF SEL-CALENDAR = "3"
               MOVE CALENDAR3  TO RPT-CALENDAR
           ELSE
               MOVE CALENDAR1  TO RPT-CALENDAR.

           IF SEL-SORT = 1
               MOVE SORT1      TO RPT-SORT-SEL
           ELSE IF SEL-SORT = 2
               MOVE SORT2      TO RPT-SORT-SEL
           ELSE IF SEL-SORT = 3
               MOVE SORT3      TO RPT-SORT-SEL
           ELSE IF SEL-SORT = 4
               MOVE SORT4      TO RPT-SORT-SEL.

           IF SEL-NEXT-ONLY = "N"
               MOVE RLSE-NEXT1 TO RPT-RLSE-SEL
           ELSE IF SEL-NEXT-ONLY = "Y"
               MOVE RLSE-NEXT2 TO RPT-RLSE-SEL
           ELSE MOVE RLSE-NEXT1 TO RPT-RLSE-SEL
                MOVE "N"       TO SEL-NEXT-ONLY.

           IF SEL-PRINT = "Y"
                MOVE RPT-STRT-DATE TO PRT-SEL-STRT
                MOVE RPT-END-DATE TO PRT-SEL-END
                MOVE RPT-WO-SEL TO PRT-SEL-WO
                MOVE RPT-EQUIP-SEL TO PRT-SEL-EQUIP
                MOVE RPT-ZONE-SEL TO PRT-SEL-ZONE
                MOVE RPT-RLSE-SEL TO PRT-SEL-RLSE
                IF SIMULATOR
                    MOVE SPACES TO HDR-CALENDAR
                    MOVE SPACES TO PRT-CALENDAR
                    MOVE SPACES TO HDR-CL
                    MOVE SPACES TO LINE-CL
                ELSE
                    MOVE "CALENDAR ENTRIES: " TO HDR-CALENDAR
                    MOVE RPT-CALENDAR TO PRT-CALENDAR
                    MOVE "CLNDR" TO HDR-CL
                    MOVE "=====" TO LINE-CL
                END-IF
                MOVE RPT-SORT-SEL TO PRT-SEL-SORT
                PERFORM 63-PRINT-HEADINGS THRU 63-PRINT-HEADINGS-EXIT.

           MOVE "N"            TO SCREEN-FILLED.
           MOVE 0              TO PAGE-KEY.
           PERFORM 62-FILL-SCREEN THRU 62-FILL-SCREEN-EXIT
                               UNTIL SCREEN-FILLED = "Y"
                               OR EOF-SW = "Y".

           IF SEL-PRINT = "Y"
               CLOSE           PRINT-FILE
               CLOSE           OUT-FILE
               IF INITIATOR
      *C********************************************************************
      *C    MESSAGE 042/149:
      *C PRINT HAS COMPLETED FOR SCHEDULE FORECASTER
      *C********************************************************************
                 MOVE   42     TO LANG-SETNUM
                 MOVE   149    TO LANG-MSGNUM
               ELSE
      *C********************************************************************
      *C    MESSAGE 042/150:
      *C PRINT HAS COMPLETED FOR SCHEDULE SIMULATOR
      *C********************************************************************
                 MOVE   42     TO LANG-SETNUM
                 MOVE   150    TO LANG-MSGNUM
               END-IF
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE 11         TO FIELD-NUMBER
               MOVE TRUE-VAL   TO IND(FIELD-NUMBER) IND(99)
               GO TO SHOWFORM-SELECTION
           END-IF.

       61-GETFORM.
           MOVE 42 TO HELP-SW.
           IF INITIATOR
             MOVE "VDSPFRCST" TO VIEW-NFNAME
           ELSE
             MOVE "VDSPSMLTR" TO VIEW-NFNAME.

       61-SHOWFORM.
           MOVE "00"           TO SCREEN-STATUS.
           MOVE RPT-SCREEN-BUFFER TO DISPLAY-REC.

           WRITE DISPLAY-REC   FORMAT IS VIEW-NFNAME
                               INDIC ARE SRF-INDICATORS.
           IF SCREEN-STATUS NOT = "00"
               DISPLAY "SCREEN WRITE ERROR, STATUS=" SCREEN-STATUS
               GO TO SELECTION-CRITERIA.
           MOVE ALL B"0"       TO SRF-INDICATORS.

           READ DISPLAY-FILE   FORMAT IS VIEW-NFNAME
                               INDIC ARE SRF-INDICATORS.
           ACCEPT IOFEEDBACK   FROM I-O-FEEDBACK-AREA.
           IF SCREEN-STATUS NOT = "00"
               DISPLAY "SCREEN READ ERROR, STATUS=" SCREEN-STATUS
               GO TO SELECTION-CRITERIA
           ELSE
               MOVE FUNCTION-NUM TO VIEW-LASTKEY.

           MOVE DISPLAY-REC    TO RPT-SCREEN-BUFFER.

           IF VIEW-LASTKEY = 8
               CLOSE           OUT-FILE
               GO TO SELECTION-CRITERIA.

           IF VIEW-LASTKEY = 1
               CLOSE           OUT-FILE
               MOVE "T"        TO SORT-IT-AGAIN
               MOVE 1          TO SEL-SORT
               GO TO SORT-IT.

           IF VIEW-LASTKEY = 2
               CLOSE           OUT-FILE
               MOVE "T"        TO SORT-IT-AGAIN
               MOVE 2          TO SEL-SORT
               GO TO SORT-IT.

           IF VIEW-LASTKEY = 3
               CLOSE           OUT-FILE
               MOVE "T "       TO SORT-IT-AGAIN
               MOVE 3          TO SEL-SORT
               GO TO SORT-IT.

           IF VIEW-LASTKEY = 4
               CLOSE           OUT-FILE
               MOVE "T"        TO SORT-IT-AGAIN
               MOVE 4          TO SEL-SORT
               GO TO SORT-IT.

           IF VIEW-LASTKEY = 5
               GO TO 61-SHOWFORM.

           IF VIEW-LASTKEY = 6
               IF ACT-KEY NOT > MAX-LINES
                   GO TO 61-SHOWFORM
               ELSE
                 COMPUTE ACT-KEY = ACT-KEY - PAGE-KEY - MAX-LINES
                 MOVE "N"      TO EOF-SW
                 GO TO 61-RESET-SCREEN.

           IF VIEW-LASTKEY = 0
               MOVE 1          TO WO-SUB
               PERFORM 66-DISPLAY-WO THRU 66-DISPLAY-WO-EXIT
               GO TO 61-GETFORM.

           IF VIEW-LASTKEY NOT = 7
               GO TO 61-SHOWFORM.

           IF EOF-SW = "Y"
               GO TO 61-SHOWFORM.

           GO TO 61-RESET-SCREEN.

       62-FILL-SCREEN.
           ADD 1               TO ACT-KEY PAGE-KEY.
           IF ACT-KEY > MAX-KEY
               MOVE "Y"        TO EOF-SW
               SUBTRACT 1      FROM ACT-KEY PAGE-KEY
               GO TO 62-FILL-SCREEN-EXIT.
           IF PAGE-KEY > MAX-LINES
               IF SEL-PRINT = "Y"
                   MOVE 1      TO PAGE-KEY
               ELSE
                   MOVE "Y"    TO SCREEN-FILLED
                   SUBTRACT 1  FROM ACT-KEY PAGE-KEY
                   GO TO 62-FILL-SCREEN-EXIT
               END-IF.

           MOVE SPACES         TO OUT-REC.
           READ OUT-FILE       INVALID KEY
               MOVE "Y"        TO EOF-SW
               GO TO 62-FILL-SCREEN-EXIT.

           MOVE OUT-RLSE-YYYY  TO DD-YYYY.
           MOVE OUT-RLSE-MM    TO DD-MM.
           MOVE OUT-RLSE-DD    TO DD-DD.
           IF DATE-FLAG = 3
               MOVE OUT-RLSE-MM  TO DD-DD
               MOVE OUT-RLSE-DD  TO DD-MM.
           MOVE DATE-DISP      TO RPT-DATE(PAGE-KEY).
           MOVE OUT-ZONE       TO RPT-ZONE(PAGE-KEY).
           MOVE OUT-EQUIP-NUM  TO RPT-EQUIP(PAGE-KEY).
           MOVE OUT-WO-NUM     TO RPT-WO(PAGE-KEY).
           MOVE OUT-JOBPLAN    TO RPT-JOBPLAN(PAGE-KEY).
           MOVE OUT-LEVEL      TO RPT-LEVEL(PAGE-KEY).
           MOVE OUT-PRIORITY   TO RPT-PRIORITY(PAGE-KEY).
           MOVE OUT-PRE-REL    TO RPT-PRE-REL(PAGE-KEY).
           MOVE OUT-CL         TO RPT-CL(PAGE-KEY).
           IF SEL-PRINT = "Y"
               PERFORM 64-PRINT-RECORD THRU 64-PRINT-RECORD-EXIT.

       62-FILL-SCREEN-EXIT.    EXIT.

       63-PRINT-HEADINGS.
           MOVE PRT-DATE-TIME-STAMP TO PRT-REC.
           WRITE PRINT-REC     AFTER ADVANCING NEW-PAGE.
           MOVE SPACES         TO PRT-REC.

           IF INITIATOR
               MOVE PRT-MAIN-HEADING-I TO PRT-REC
           ELSE
               MOVE PRT-MAIN-HEADING-S TO PRT-REC.

           WRITE PRINT-REC     AFTER ADVANCING 1 LINES.
           MOVE PRT-SEL-HEADING TO PRT-REC.
           WRITE PRINT-REC     AFTER ADVANCING 2 LINES.
           MOVE PRT-SORT-HEADING TO PRT-REC.
           WRITE PRINT-REC     AFTER ADVANCING 1 LINE.
           MOVE PRT-RLSE-SEL-HEADING TO PRT-REC.
           WRITE PRINT-REC     AFTER ADVANCING 1 LINE.
           MOVE PRT-LABEL-HEADING TO PRT-REC.
           WRITE PRINT-REC     AFTER ADVANCING 1 LINE.
           MOVE PRT-LABEL-HEADING2 TO PRT-REC.
           WRITE PRINT-REC     AFTER ADVANCING 1 LINE.
           MOVE 7              TO LINE-CTR.

       63-PRINT-HEADINGS-EXIT. EXIT.

       64-PRINT-RECORD.
           IF LINE-CTR > 54
               MOVE SPACES     TO PRT-REC
               WRITE PRINT-REC AFTER ADVANCING NEW-PAGE
               MOVE PRT-LABEL-HEADING TO PRT-REC
               WRITE PRINT-REC AFTER ADVANCING 2 LINES
               MOVE PRT-LABEL-HEADING2 TO PRT-REC
               WRITE PRINT-REC AFTER ADVANCING 1 LINE
               MOVE 4          TO LINE-CTR.

           MOVE SPACES                 TO PRT-REC.
           MOVE RPT-DATE(PAGE-KEY)     TO PRT-DATE.
           MOVE RPT-ZONE(PAGE-KEY)     TO PRT-ZONE.
           MOVE RPT-EQUIP(PAGE-KEY)    TO PRT-EQUIP.
           MOVE RPT-WO(PAGE-KEY)       TO PRT-WO.
           MOVE RPT-JOBPLAN(PAGE-KEY)  TO PRT-JOBPLAN.
           MOVE RPT-LEVEL(PAGE-KEY)    TO PRT-LEVEL.
           MOVE RPT-PRIORITY(PAGE-KEY) TO PRT-PRIORITY.
           MOVE RPT-PRE-REL(PAGE-KEY)  TO PRT-PRE-REL.
           MOVE RPT-CL(PAGE-KEY)       TO PRT-CL.
           WRITE PRINT-REC     AFTER ADVANCING 1 LINE.
           ADD 1               TO LINE-CTR.

       64-PRINT-RECORD-EXIT.   EXIT.

       66-DISPLAY-WO.
           IF RPT-WO-DISPLAY(WO-SUB) = SPACES
               ADD 1           TO WO-SUB
               IF WO-SUB > MAX-LINES
                   GO TO 66-DISPLAY-WO-EXIT
               ELSE
                   GO TO 66-DISPLAY-WO
           ELSE
               IF RPT-WO(WO-SUB) = SPACES
                   ADD 1       TO WO-SUB
                   IF WO-SUB > MAX-LINES
                       GO TO 66-DISPLAY-WO-EXIT
                   ELSE
                       GO TO 66-DISPLAY-WO.

           MOVE RPT-WO(WO-SUB) TO WONUM OF WO-PLANNED.
           READ WO-PLANNED     INTO WO-PLANNED-DATA
               INVALID KEY     MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE "DBGET ERROR FOR WO" TO ERRMSG
               MOVE TRUE-VAL   TO IND(99)
               GO TO 66-DISPLAY-WO-EXIT.

           MOVE SPACES         TO MESSAGE-BUFFER WO-BASIC-DATA.
           CALL "TDISPWO"      USING DBPARAMETERS
                               WO-BASIC-DATA
                               WO-PLANNED-DATA
                               FILE-SW.
           IF INITIATOR
             MOVE "VDSPFRCST"  TO VIEW-NFNAME
           ELSE
             MOVE "VDSPSMLTR"  TO VIEW-NFNAME.

       66-DISPLAY-WO-EXIT.     EXIT.

       CALC-CLEAR-DATE.
           MOVE SPACES         TO CLEAR-DATE.
           ACCEPT CD-YMD       FROM DATE.
           IF CD-YY > 90
               MOVE 19         TO CD-CT
           ELSE
               MOVE 20         TO CD-CT.

           MOVE CURRENTDATE    TO GREG-DATE.
           MOVE SPACES         TO JUL-DATE D-PARM L-PARM.
           CALL "JULGREG"      USING
                               GREG-DATE
                               JUL-DATE
                               D-PARM
                               L-PARM.

           MOVE J-DAY          TO JUL-SIGN.
           SUBTRACT 30         FROM JUL-SIGN.
           PERFORM UNTIL       JUL-SIGN > 0
               ADD 365         TO JUL-SIGN
               SUBTRACT 1      FROM J-YEAR
           END-PERFORM.

           MOVE JUL-SIGN       TO J-DAY.
           MOVE JUL-DATE       TO CLEAR-DATE-9.

       CALC-CLEAR-DATE-EXIT.   EXIT.

       CLEAR-SIMULATOR.
           READ PM-SIMULATOR-ALL NEXT INTO PM-SCHED-DATA
               AT END          MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS = "10" OR "14" OR "46"
               GO TO CLEAR-SIMULATOR-EXIT
           ELSE IF FILE-STATUS NOT = "00"
               MOVE "CLEAR PM-SIMULATOR READ ERROR" TO BU-DISPLAY-MSG
               PERFORM 999-BLOWUP.

           IF SCH-PR-ID < CLEAR-DATE
               DELETE PM-SIMULATOR-ALL
                   INVALID KEY MOVE FILE-STATUS TO FILE-STATUS
               END-DELETE
               IF FILE-STATUS NOT = "00"
                   MOVE "CLEAR PM-SIMULATOR ERROR" TO BU-DISPLAY-MSG
                   PERFORM 999-BLOWUP
               END-IF
           END-IF.

           GO TO CLEAR-SIMULATOR.

       CLEAR-SIMULATOR-EXIT.   EXIT.

       EDIT-DATE-FUNCTION.
           IF CHK-CT = "19" OR "20"
               NEXT SENTENCE
           ELSE
      *C********************************************************************
      *C    MESSAGE 035/032:
      *C  INVALID YEAR
      *C********************************************************************
               MOVE  35        TO LANG-SETNUM
               MOVE  32        TO LANG-MSGNUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE 1          TO FIELD-NUMBER
               MOVE "X"        TO DATE-EDIT-SW
               GO TO EDF-EXIT.

           IF CHECK-DATE IS NUMERIC
               IF DATE-FLAG = 1
                   IF CHK-MM > 0 AND CHK-MM < 13
                       IF CHK-DD > 0 AND CHK-DD < 32
                           NEXT SENTENCE
                       ELSE
      *C********************************************************************
      *C    MESSAGE 035/030:
      *C  INVALID DAY
      *C********************************************************************
                       MOVE 35 TO LANG-SETNUM
                       MOVE 30 TO LANG-MSGNUM
                       PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                       MOVE 3  TO FIELD-NUMBER
                       MOVE "X" TO DATE-EDIT-SW
                       GO TO EDF-EXIT
                   ELSE
      *C********************************************************************
      *C    MESSAGE 035/031:
      *C  INVALID MONTH
      *C********************************************************************
                   MOVE 35     TO LANG-SETNUM
                   MOVE 31     TO LANG-MSGNUM
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE 2      TO FIELD-NUMBER
                   MOVE "X"    TO DATE-EDIT-SW
                   GO TO EDF-EXIT
               ELSE
               IF CHK-MM > 0 AND CHK-MM < 32
                   IF CHK-DD > 0 AND CHK-DD < 13
                       NEXT SENTENCE
                   ELSE
      *C********************************************************************
      *C    MESSAGE 035/031:
      *C  INVALID MONTH
      *C********************************************************************
                   MOVE 35     TO LANG-SETNUM
                   MOVE 31     TO LANG-MSGNUM
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE 2      TO FIELD-NUMBER
                   MOVE "X"    TO DATE-EDIT-SW
                   GO TO EDF-EXIT
               ELSE
      *C********************************************************************
      *C    MESSAGE 035/030:
      *C  INVALID DAY
      *C********************************************************************
               MOVE  35        TO LANG-SETNUM
               MOVE  30        TO LANG-MSGNUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE 3          TO FIELD-NUMBER
               MOVE "X"        TO DATE-EDIT-SW
               GO TO EDF-EXIT
           ELSE
      *C********************************************************************
      *C    MESSAGE 035/032:
      *C  INVALID YEAR
      *C********************************************************************
           MOVE  35            TO LANG-SETNUM
           MOVE  32            TO LANG-MSGNUM
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
           MOVE 1              TO FIELD-NUMBER
           MOVE "X"            TO DATE-EDIT-SW
           GO TO EDF-EXIT.

       EDF-EXIT.               EXIT.

      ** OVERRIDE PRINTFILE PARAGRAPH
           COPY OVRPFCALL      IN COPYLIB.

       999-CATREAD.
           MOVE SPACES         TO CATREAD-MSG-TEXT.
           MOVE LANG-SETNUM    TO CATREAD-MSG-SET.
           MOVE LANG-MSGNUM    TO CATREAD-MSG-NUM.
           CALL "CCATREAD"     USING CATREAD-PARMS.
           IF CATREAD-MSG-NOT-FOUND
               MOVE "ERROR ON THIS FIELD**" TO ERRMSG
           ELSE
               MOVE CATREAD-MSG-TEXT TO ERRMSG.

       999-CATREAD-EXIT.       EXIT.

       999-BLOWUP.
           MOVE "SPMFRCST"     TO BU-PGM-NAME.
           MOVE VIEW-NFNAME    TO BU-DISPLAY-FLD(1).
           CALL "TBLOWUP"      USING BASE BU-PGM-NAME STATUS-AREA
                               VIEW-COMAREA FILE-STATUS
                               BU-DISPLAY-MSG BU-DISPLAY-FLDS.

       SORT-SCHED SECTION 02.

       BEGIN-SORT-SCHED.
           PERFORM SORT-MAIN   THRU SORT-MAIN-X.
           GO TO SORT-SCHED-EXIT.

       SORT-MAIN.
           IF SORT-IT-AGAIN = "T"
               OPEN INPUT      OUT-FILE
               PERFORM READ-OUT-FILE THRU READ-OUT-FILE-EXIT
           ELSE
           IF SEL-WO NOT = "ALL       "
               PERFORM READ-BY-WO THRU READ-BY-WO-EXIT
           ELSE
           IF SEL-EQUIP NOT = "ALL   "
               PERFORM READ-BY-EQUIP THRU READ-BY-EQUIP-EXIT
           ELSE
           IF SEL-ZONE NOT = "ALL "
               PERFORM READ-BY-ZONE THRU READ-BY-ZONE-EXIT
           ELSE
               PERFORM READ-ALL THRU READ-ALL-EXIT.

       SORT-MAIN-X.            EXIT.

       READ-BY-WO.
           IF INITIATOR
             MOVE SEL-WO       TO WONUM OF PM-SCHEDULE-WO
             START PM-SCHEDULE-WO KEY = WONUM OF PM-SCHEDULE-WO
                 INVALID KEY   MOVE FILE-STATUS TO FILE-STATUS
           ELSE
             MOVE SEL-WO       TO WONUM OF PM-SIMULATOR-WO
             START PM-SIMULATOR-WO KEY = WONUM OF PM-SIMULATOR-WO
                 INVALID KEY   MOVE FILE-STATUS TO FILE-STATUS
           END-IF.

           IF FILE-STATUS NOT = "00"
               GO TO READ-BY-WO-EXIT.

       READ-BY-WO-LOOP.
           IF INITIATOR
               READ PM-SCHEDULE-WO NEXT INTO PM-SCHED-DATA
                   AT END      MOVE FILE-STATUS TO FILE-STATUS
           ELSE
               READ PM-SIMULATOR-WO NEXT INTO PM-SCHED-DATA
                   AT END      MOVE FILE-STATUS TO FILE-STATUS
           END-IF.

           IF FILE-STATUS = "10" OR "14" OR "46"
               GO TO READ-BY-WO-EXIT
           ELSE IF FILE-STATUS NOT = "00"
               MOVE "READ NEXT, READ-BY-WO ERR" TO BU-DISPLAY-MSG
               IF INITIATOR
                   MOVE "PM-SCHEDULE" TO BU-DISPLAY-FLD(2)
               ELSE
                   MOVE "PM-SIMULATOR" TO BU-DISPLAY-FLD(2)
               END-IF
               MOVE SEL-WO     TO BU-DISPLAY-FLD(3)
               PERFORM 999-BLOWUP.

           IF SCH-WO-NUM NOT = SEL-WO
               GO TO READ-BY-WO-EXIT.

      *----CHECK FOR OTHER SELECTION CRITERIA.
           IF SCH-REC-TYP = "MS"
               GO TO READ-BY-WO-LOOP.

           IF SEL-EQUIP NOT = "ALL   " AND SCH-EQUIP-NUM NOT = SEL-EQUIP
               GO TO READ-BY-WO-LOOP.

           IF SEL-ZONE NOT = "ALL " AND SCH-ZONE NOT = SEL-ZONE
               GO TO READ-BY-WO-LOOP.

           IF SEL-STRT-DATE NOT = "ALL     "
               MOVE SEL-STRT-YYYY TO COMPARE-YYYY
               MOVE SEL-STRT-MM   TO COMPARE-MM
               MOVE SEL-STRT-DD   TO COMPARE-DD
               IF DATE-FLAG = 3
                   MOVE SEL-STRT-MM TO COMPARE-DD
                   MOVE SEL-STRT-DD TO COMPARE-MM
               END-IF
               IF SCH-RELEASE-DATE < COMPARE-DATE
                   GO TO READ-BY-WO-LOOP.

           IF SEL-END-DATE NOT = "ALL     "
               MOVE SEL-END-YYYY TO COMPARE-YYYY
               MOVE SEL-END-MM   TO COMPARE-MM
               MOVE SEL-END-DD   TO COMPARE-DD
               IF DATE-FLAG = 3
                   MOVE SEL-END-MM TO COMPARE-DD
                   MOVE SEL-END-DD TO COMPARE-MM
               END-IF
               IF SCH-RELEASE-DATE > COMPARE-DATE
                   GO TO READ-BY-WO-LOOP.

           IF INITIATOR
               IF SEL-CALENDAR = "2" AND SCH-REC-TYP = "CL"
                   GO TO READ-BY-WO-LOOP
               END-IF
               IF SEL-CALENDAR = "3" AND SCH-REC-TYP NOT = "CL"
                   GO TO READ-BY-WO-LOOP
               END-IF
           END-IF.

           PERFORM RELEASE-SORT-REC THRU RELEASE-SORT-REC-EXIT.
           GO TO READ-BY-WO-LOOP.

       READ-BY-WO-EXIT.        EXIT.

       READ-BY-EQUIP.
           IF INITIATOR
             MOVE SEL-EQUIP    TO PMEQPNUM OF PM-SCHEDULE-EQP
             START PM-SCHEDULE-EQP KEY = PMEQPNUM OF PM-SCHEDULE-EQP
                 INVALID KEY   MOVE FILE-STATUS TO FILE-STATUS
           ELSE
             MOVE SEL-EQUIP    TO PMEQPNUM OF PM-SIMULATOR-EQP
             START PM-SIMULATOR-EQP KEY = PMEQPNUM OF PM-SIMULATOR-EQP
                 INVALID KEY   MOVE FILE-STATUS TO FILE-STATUS
           END-IF.

           IF FILE-STATUS NOT = "00"
               GO TO READ-BY-EQUIP-EXIT.

       READ-BY-EQUIP-LOOP.
           IF INITIATOR
               READ PM-SCHEDULE-EQP NEXT INTO PM-SCHED-DATA
                   AT END      MOVE FILE-STATUS TO FILE-STATUS
           ELSE
               READ PM-SIMULATOR-EQP NEXT INTO PM-SCHED-DATA
                   AT END      MOVE FILE-STATUS TO FILE-STATUS
           END-IF.

           IF FILE-STATUS = "10" OR "14" OR "46"
               GO TO READ-BY-EQUIP-EXIT
           ELSE IF FILE-STATUS NOT = "00"
               MOVE "READ NEXT READ-BY-EQUIP ERR" TO BU-DISPLAY-MSG
               IF INITIATOR
                   MOVE "PM-SCHEDULE" TO BU-DISPLAY-FLD(2)
               ELSE
                   MOVE "PM-SIMULATOR" TO BU-DISPLAY-FLD(2)
               END-IF
               MOVE SEL-EQUIP  TO BU-DISPLAY-FLD(3)
               PERFORM 999-BLOWUP.

           IF SCH-EQUIP-NUM NOT = SEL-EQUIP
               GO TO READ-BY-EQUIP-EXIT.

      *----CHECK FOR OTHER SELECTION CRITERIA.
           IF SCH-REC-TYP = "MS"
               GO TO READ-BY-EQUIP-LOOP.

           IF SEL-WO NOT = "ALL       " AND SCH-WO-NUM NOT = SEL-WO
               GO TO READ-BY-EQUIP-LOOP.

           IF SEL-ZONE NOT = "ALL " AND SCH-ZONE NOT = SEL-ZONE
               GO TO READ-BY-EQUIP-LOOP.

           IF SEL-STRT-DATE NOT = "ALL     "
               MOVE SEL-STRT-YYYY TO COMPARE-YYYY
               MOVE SEL-STRT-MM   TO COMPARE-MM
               MOVE SEL-STRT-DD   TO COMPARE-DD
               IF DATE-FLAG = 3
                   MOVE SEL-STRT-MM TO COMPARE-DD
                   MOVE SEL-STRT-DD TO COMPARE-MM
               END-IF
               IF SCH-RELEASE-DATE < COMPARE-DATE
                   GO TO READ-BY-EQUIP-LOOP.

           IF SEL-END-DATE NOT = "ALL     "
               MOVE SEL-END-YYYY TO COMPARE-YYYY
               MOVE SEL-END-MM   TO COMPARE-MM
               MOVE SEL-END-DD   TO COMPARE-DD
               IF DATE-FLAG = 3
                   MOVE SEL-END-MM TO COMPARE-DD
                   MOVE SEL-END-DD TO COMPARE-MM
               END-IF
               IF SCH-RELEASE-DATE > COMPARE-DATE
                   GO TO READ-BY-EQUIP-LOOP.

           IF INITIATOR
               IF SEL-CALENDAR = "2" AND SCH-REC-TYP = "CL"
                   GO TO READ-BY-EQUIP-LOOP
               END-IF
               IF SEL-CALENDAR = "3" AND SCH-REC-TYP NOT = "CL"
                   GO TO READ-BY-EQUIP-LOOP
               END-IF
           END-IF.

           PERFORM RELEASE-SORT-REC THRU RELEASE-SORT-REC-EXIT.
           GO TO READ-BY-EQUIP-LOOP.

       READ-BY-EQUIP-EXIT.     EXIT.

       READ-BY-ZONE.
           IF INITIATOR
             MOVE SEL-ZONE     TO ZONE OF PM-SCHEDULE-ZN
             START PM-SCHEDULE-ZN KEY = ZONE OF PM-SCHEDULE-ZN
                 INVALID KEY   MOVE FILE-STATUS TO FILE-STATUS
           ELSE
             MOVE SEL-ZONE     TO ZONE OF PM-SIMULATOR-ZN
             START PM-SIMULATOR-ZN KEY = ZONE OF PM-SIMULATOR-ZN
                 INVALID KEY   MOVE FILE-STATUS TO FILE-STATUS
           END-IF.

           IF FILE-STATUS NOT = "00"
               GO TO READ-BY-ZONE-EXIT.

       READ-BY-ZONE-LOOP.
           IF INITIATOR
               READ PM-SCHEDULE-ZN NEXT INTO PM-SCHED-DATA
                   AT END      MOVE FILE-STATUS TO FILE-STATUS
           ELSE
               READ PM-SIMULATOR-ZN NEXT INTO PM-SCHED-DATA
                   AT END      MOVE FILE-STATUS TO FILE-STATUS
           END-IF.

           IF FILE-STATUS = "10" OR "14" OR "46"
               GO TO READ-BY-ZONE-EXIT
           ELSE IF FILE-STATUS NOT = "00"
               MOVE "READ NEXT READ-BY-ZONE ERR" TO BU-DISPLAY-MSG
               IF INITIATOR
                   MOVE "PM-SCHEDULE" TO BU-DISPLAY-FLD(2)
               ELSE
                   MOVE "PM-SIMULATOR" TO BU-DISPLAY-FLD(2)
               END-IF
               MOVE SEL-ZONE   TO BU-DISPLAY-FLD(3)
               PERFORM 999-BLOWUP.

           IF SCH-ZONE NOT = SEL-ZONE
               GO TO READ-BY-ZONE-EXIT.

      *----CHECK FOR OTHER SELECTION CRITERIA.
           IF SCH-REC-TYP = "MS"
               GO TO READ-BY-ZONE-LOOP.

           IF SEL-WO NOT = "ALL       " AND SCH-WO-NUM NOT = SEL-WO
               GO TO READ-BY-ZONE-LOOP.

           IF SEL-EQUIP NOT = "ALL   " AND SCH-EQUIP-NUM NOT = SEL-EQUIP
               GO TO READ-BY-ZONE-LOOP.

           IF SEL-STRT-DATE NOT = "ALL     "
               MOVE SEL-STRT-YYYY TO COMPARE-YYYY
               MOVE SEL-STRT-MM   TO COMPARE-MM
               MOVE SEL-STRT-DD   TO COMPARE-DD
               IF DATE-FLAG = 3
                   MOVE SEL-STRT-MM TO COMPARE-DD
                   MOVE SEL-STRT-DD TO COMPARE-MM
               END-IF
               IF SCH-RELEASE-DATE < COMPARE-DATE
                   GO TO READ-BY-ZONE-LOOP.

           IF SEL-END-DATE NOT = "ALL     "
               MOVE SEL-END-YYYY TO COMPARE-YYYY
               MOVE SEL-END-MM   TO COMPARE-MM
               MOVE SEL-END-DD   TO COMPARE-DD
               IF DATE-FLAG = 3
                   MOVE SEL-END-MM TO COMPARE-DD
                   MOVE SEL-END-DD TO COMPARE-MM
               END-IF
               IF SCH-RELEASE-DATE > COMPARE-DATE
                   GO TO READ-BY-ZONE-LOOP.

           IF INITIATOR
               IF SEL-CALENDAR = "2" AND SCH-REC-TYP = "CL"
                   GO TO READ-BY-ZONE-LOOP
               END-IF
               IF SEL-CALENDAR = "3" AND SCH-REC-TYP NOT = "CL"
                   GO TO READ-BY-ZONE-LOOP
               END-IF
           END-IF.

           PERFORM RELEASE-SORT-REC THRU RELEASE-SORT-REC-EXIT.
           GO TO READ-BY-ZONE-LOOP.

       READ-BY-ZONE-EXIT.      EXIT.

       READ-ALL.
           IF INITIATOR
             OPEN INPUT        PM-SCHEDULE-ALL
           ELSE
             OPEN INPUT        PM-SIMULATOR-ALL
           END-IF.

       READ-ALL-LOOP.
           IF INITIATOR
             READ PM-SCHEDULE-ALL NEXT INTO PM-SCHED-DATA
                 AT END        MOVE FILE-STATUS TO FILE-STATUS
           ELSE
             READ PM-SIMULATOR-ALL NEXT INTO PM-SCHED-DATA
                 AT END        MOVE FILE-STATUS TO FILE-STATUS
           END-IF.

           IF FILE-STATUS = "10" OR "14" OR "46"
               IF INITIATOR
                   CLOSE       PM-SCHEDULE-ALL
               ELSE
                   CLOSE       PM-SIMULATOR-ALL
               END-IF
               GO TO READ-ALL-EXIT
           ELSE IF FILE-STATUS NOT = "00"
               MOVE "DBGET READ-ALL ERR" TO BU-DISPLAY-MSG
               IF INITIATOR
                   MOVE "PM-SCHEDULE" TO BU-DISPLAY-FLD(2)
               ELSE
                   MOVE "PM-SIMULATOR" TO BU-DISPLAY-FLD(2)
               END-IF
               MOVE ARG-NO     TO BU-DISPLAY-FLD(3)
               PERFORM 999-BLOWUP.

      *----CHECK FOR OTHER SELECTION CRITERIA.
           IF SCH-REC-TYP = "MS"
               GO TO READ-ALL-LOOP.

           IF SEL-WO NOT = "ALL       " AND SCH-WO-NUM NOT = SEL-WO
               GO TO READ-ALL-LOOP.

           IF SEL-EQUIP NOT = "ALL   " AND SCH-EQUIP-NUM NOT = SEL-EQUIP
               GO TO READ-ALL-LOOP.

           IF SEL-ZONE NOT = "ALL " AND SCH-ZONE NOT = SEL-ZONE
               GO TO READ-ALL-LOOP.

           IF SEL-STRT-DATE NOT = "ALL     "
               MOVE SEL-STRT-YYYY TO COMPARE-YYYY
               MOVE SEL-STRT-MM   TO COMPARE-MM
               MOVE SEL-STRT-DD   TO COMPARE-DD
               IF DATE-FLAG = 3
                   MOVE SEL-STRT-MM TO COMPARE-DD
                   MOVE SEL-STRT-DD TO COMPARE-MM
               END-IF
               IF SCH-RELEASE-DATE < COMPARE-DATE
                   GO TO READ-ALL-LOOP.

           IF SEL-END-DATE NOT = "ALL     "
               MOVE SEL-END-YYYY TO COMPARE-YYYY
               MOVE SEL-END-MM   TO COMPARE-MM
               MOVE SEL-END-DD   TO COMPARE-DD
               IF DATE-FLAG = 3
                   MOVE SEL-END-MM TO COMPARE-DD
                   MOVE SEL-END-DD TO COMPARE-MM
               END-IF
               IF SCH-RELEASE-DATE > COMPARE-DATE
                   GO TO READ-ALL-LOOP.

           IF INITIATOR
               IF SEL-CALENDAR = "2" AND SCH-REC-TYP = "CL"
                   GO TO READ-ALL-LOOP
               END-IF
               IF SEL-CALENDAR = "3" AND SCH-REC-TYP NOT = "CL"
                   GO TO READ-ALL-LOOP
               END-IF
           END-IF.

           PERFORM RELEASE-SORT-REC THRU RELEASE-SORT-REC-EXIT.
           GO TO READ-ALL-LOOP.

       READ-ALL-EXIT.          EXIT.

       READ-OUT-FILE.
           ADD 1               TO ACT-KEY.
           IF ACT-KEY > MAX-KEY
               CLOSE           OUT-FILE
               GO TO READ-OUT-FILE-EXIT.
           READ OUT-FILE       INVALID KEY
               CLOSE           OUT-FILE
               GO TO READ-OUT-FILE-EXIT.
           MOVE OUT-REC        TO SORT-REC.
           RELEASE             SORT-REC.
           GO TO READ-OUT-FILE.

       READ-OUT-FILE-EXIT.     EXIT.

       RELEASE-SORT-REC.
           ADD 1               TO ARG-NO.
           MOVE SPACES         TO SORT-REC.
           MOVE SCH-RELEASE-DATE TO SORT-RLSE-DATE.
           MOVE SCH-ZONE       TO SORT-ZONE.
           MOVE SCH-EQUIP-NUM  TO SORT-EQUIP-NUM.
           MOVE SCH-WO-NUM     TO SORT-WO-NUM.
           MOVE SCH-LEVEL      TO SORT-LEVEL.
           MOVE SCH-PRIORITY   TO SORT-PRIORITY.

           IF SCH-PREREL-DATE NOT = SPACES
               IF SCH-REC-TYP = "RI"
                   MOVE "REINITIATE" TO SORT-PRE-REL
               ELSE
               IF SCH-REC-PR NOT = SPACES
                   MOVE "PRERELEASE" TO SORT-PRE-REL
               ELSE
                   MOVE SCH-PR-YR  TO DD-YYYY
                   MOVE SCH-PR-MO  TO DD-MM
                   MOVE SCH-PR-DAY TO DD-DD
                   IF DATE-FLAG = 3
                       MOVE SCH-PR-MO  TO DD-DD
                       MOVE SCH-PR-DAY TO DD-MM
                   END-IF
                   MOVE DATE-DISP  TO SORT-PRE-REL.

           IF SCH-REC-TYP = "DM"
               MOVE "--"          TO SORT-LEVEL SORT-PRIORITY
               MOVE "MASTER REC"  TO SORT-PRE-REL
               IF SEL-NEXT-ONLY = "Y"
                   GO TO RELEASE-SORT-REC-EXIT.


           MOVE SCH-WO-NUM     TO WONUM OF WO-PLANNED.
           READ WO-PLANNED     INTO WO-PLANNED-DATA
               INVALID KEY     MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS = "23"
               PERFORM STOP-SCHEDULE
               GO TO RELEASE-SORT-REC-EXIT
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE "READ WO-PLANNED ERR" TO BU-DISPLAY-MSG
               MOVE SCH-WO-NUM TO BU-DISPLAY-FLD(2)
               PERFORM 999-BLOWUP.

           MOVE PM-JOBPLAN-KEY TO SORT-JOBPLAN.
           IF SCH-REC-TYP = "CL"
               MOVE "YES"      TO SORT-CL
           ELSE
               MOVE SPACES     TO SORT-CL.
           RELEASE             SORT-REC.

       RELEASE-SORT-REC-EXIT.  EXIT.

       STOP-SCHEDULE.
           MOVE SPACES         TO BU-DISPLAY-MSG.
           MOVE "&"            TO STOP-CALENDAR-SW.
           MOVE "N"            TO PM-QUEUE-MSG-SW.
           CALL "SPMSKSTP"     USING DBPARAMETERS
                               SCH-WO-NUM
                               STOP-CALENDAR-SW
                               PM-QUEUE-MSG-SW
                               BU-DISPLAY-MSG
                               BU-DISPLAY-FLDS.

       SORT-SCHED-EXIT.        EXIT.

       SORT-OUT SECTION 03.
           OPEN OUTPUT         OUT-FILE.
           MOVE 0              TO ACT-KEY.
           MOVE SPACES         TO NEXT-RLSE-ONLY-TABLE.
           MOVE 0              TO ONLY-SUB-LIMIT.

       BEGIN-SORT-OUT.
           RETURN SORT-FILE    AT END
               CLOSE           OUT-FILE
               MOVE ACT-KEY    TO MAX-KEY
               GO TO SORT-OUT-EXIT.

           IF SEL-NEXT-ONLY = "Y"
             SET ONLY-SUB      TO 1
             SEARCH NEXT-RLSE-ONLY-ENTRY
                AT END
                  MOVE "F"     TO FOUND-SW
                WHEN SORT-WO-NUM = NEXT-ONLY-WO(ONLY-SUB)
                  MOVE "T"     TO FOUND-SW
             END-SEARCH
             IF FOUND
               IF SORT-LEVEL NOT = NEXT-ONLY-LV(ONLY-SUB)
                 GO TO BEGIN-SORT-OUT
               ELSE
                 MOVE SORT-PRE-REL TO DATE-WITH-SLASH
                 MOVE DWS-MM   TO COMPARE-MM
                 MOVE DWS-DD   TO COMPARE-DD
                 MOVE DWS-YYYY TO COMPARE-YYYY
                 IF COMPARE-DATE NOT = NEXT-ONLY-PR(ONLY-SUB)
                   GO TO BEGIN-SORT-OUT
                 END-IF
               END-IF
             END-IF
             ADD 1             TO ONLY-SUB-LIMIT
             MOVE SORT-WO-NUM  TO NEXT-ONLY-WO(ONLY-SUB-LIMIT)
             MOVE SORT-LEVEL   TO NEXT-ONLY-LV(ONLY-SUB-LIMIT)
             MOVE SORT-RLSE-DATE TO NEXT-ONLY-PR(ONLY-SUB-LIMIT)
           END-IF.

           ADD 1               TO ACT-KEY.
           MOVE SORT-REC       TO OUT-REC
           WRITE OUT-REC       INVALID KEY
               MOVE "WRITE OUT-REC ERROR" TO BU-DISPLAY-MSG
               MOVE ACT-KEY    TO BU-DISPLAY-FLD(2)
               PERFORM 999-BLOWUP.
           GO TO BEGIN-SORT-OUT.

       SORT-OUT-EXIT.          EXIT.

