044900*************************************************************
045000
045100 PROCEDURE DIVISION USING BASE, PASSED-PARMS, LANGUAGE-PARMS.
045200 START-PGM.
           OPEN INPUT DCOMMENT-MC-I.
           OPEN I-O DEDILOG-LK-O.
           OPEN INPUT DPODATAITM-PO-I.
           OPEN INPUT DPOITEM-PO-I.
           OPEN I-O DPORECD-PO-O.
           OPEN INPUT DVENDOR-VN-I.
047900***************************************************************
048000**   DO A CLEAR PHYSICAL FILE MEMBER ON EDIABST              **
      **   TO CLEAR IT FOR NEXT BATCH TRANSMISSION                 **
048500***************************************************************
048600     MOVE "CLRPFM FILE(*LIBL/EDIABST)" TO OVRDBF-PARM1.
048700     CALL "QCMDEXC" USING OVRDBF-PARM1, OVRDBF-PARM2.
048800     OPEN OUTPUT EDI-FILEABS.
      ***************************************************************
      **   CHECK FOR EXISTANCE OF THE CIRCULAR ERROR FILE 'EDIERRFL'*  '.
      **       IF NOT THERE, BUILD IT.                              *
      **      CALL CCRTFILE TO CREATE A TEMPORARY FILE 'EDIERRFL'   *
      ***************************************************************
           MOVE "*LIBL"       TO CCRTFILE-LIBRARY.
           MOVE "EDIERRFL"    TO CCRTFILE-FILE.
           MOVE "0133"        TO CCRTFILE-RECORD-LENGTH.
           MOVE "01000"       TO CCRTFILE-NO-RECORDS.
           MOVE "01000"       TO CCRTFILE-INCREMENT-AMT.
           MOVE "01"          TO CCRTFILE-NO-INCREMENTS.
           SET CIRCULAR-FILE TO TRUE.
           CALL "CCRTFILE" USING CCRTFILE-LIBRARY,
                                 CCRTFILE-FILE,
                                 CCRTFILE-RECORD-LENGTH,
                                 CCRTFILE-NO-RECORDS,
                                 CCRTFILE-INCREMENT-AMT,
                                 CCRTFILE-NO-INCREMENTS,
                                 CCRTFILE-STATUS.
           IF CCRTFILE-STATUS NOT = "00"
               MOVE "CCRTFILE CREATE OF 'DPOERFIL' FAILED"
                  TO BU-DISPLAY-MSG
               PERFORM 2100-BLOWUP.
048900     OPEN EXTEND EDI-ERROR-FILE.
      ***************************************************************
      **   CHECK FOR EXISTANCE OF THE CIRCULAR ERROR FILE 'EDIRPTFL'*  '.
      **       IF NOT THERE, BUILD IT.                              *
      **      CALL CCRTFILE TO CREATE A TEMPORARY FILE 'EDIRPTFL'   *
      ***************************************************************
           MOVE "*LIBL"       TO CCRTFILE-LIBRARY.
           MOVE "EDIRPTFL"    TO CCRTFILE-FILE.
           MOVE "0133"        TO CCRTFILE-RECORD-LENGTH.
           MOVE "01000"       TO CCRTFILE-NO-RECORDS.
           MOVE "01000"       TO CCRTFILE-INCREMENT-AMT.
           MOVE "01"          TO CCRTFILE-NO-INCREMENTS.
           SET CIRCULAR-FILE TO TRUE.
           CALL "CCRTFILE" USING CCRTFILE-LIBRARY,
                                 CCRTFILE-FILE,
                                 CCRTFILE-RECORD-LENGTH,
                                 CCRTFILE-NO-RECORDS,
                                 CCRTFILE-INCREMENT-AMT,
                                 CCRTFILE-NO-INCREMENTS,
                                 CCRTFILE-STATUS.
049000     OPEN EXTEND EDI-REPORT-FILE.
           OPEN INPUT MBUYER-BY-I.
           OPEN INPUT MCOMMENT-MC-I.
           OPEN INPUT MPLTINFO-PK-I.
           OPEN I-O MPLTINFO-PK-O.
           OPEN INPUT MTAX-TX-I.
           OPEN INPUT MVALIDUM-UM-I.
      ***************************************************************
      **      CALL CCRTFILE TO CREATE A TEMPORARY FILE 'EDIPORPT'   *
      ***************************************************************
           MOVE "*LIBL"       TO CCRTFILE-LIBRARY.
           MOVE "EDIPORPT"    TO CCRTFILE-FILE.
           MOVE "0080"        TO CCRTFILE-RECORD-LENGTH.
           MOVE "01000"       TO CCRTFILE-NO-RECORDS.
           MOVE "01000"       TO CCRTFILE-INCREMENT-AMT.
           MOVE "01"          TO CCRTFILE-NO-INCREMENTS.
           CALL "CCRTFILE" USING CCRTFILE-LIBRARY,
                                 CCRTFILE-FILE,
                                 CCRTFILE-RECORD-LENGTH,
                                 CCRTFILE-NO-RECORDS,
                                 CCRTFILE-INCREMENT-AMT,
                                 CCRTFILE-NO-INCREMENTS,
                                 CCRTFILE-STATUS.
049600     OPEN OUTPUT OUT-FILE.
049700     OPEN OUTPUT PRINT-REPORT-FILE.
060400     MOVE DSET-MPLTINFO           TO DSET-NAME.
060500     MOVE "EPOR"                  TO MPLTINFO-ARG, PLT-ARG.
060900     PERFORM  9999-GETKEY-MPLTINFO-PK-O.
061000     MOVE BUF-MPLTINFO            TO BUF-MPLTINFO-SAVE.
061100     ADD  1                       TO MPLTINFO-LOG-BATCH-NO-S.
           IF PASSED-BATCHNO-X NOT = SPACES
               MOVE PASSED-BATCHNO      TO H-1-BATCH
           ELSE
           MOVE MPLTINFO-LOG-BATCH-NO-S TO H-1-BATCH.
049800     MOVE 0                       TO OPEN-RPT1-SW.
049900     MOVE 0                       TO TAB-SUB
050000                                     REL-RECS-CTR.
050100     MOVE "20"                    TO WS-CENTURY.
050200     MOVE SPACES                  TO RECORD-TABLE.
050300     MOVE 1                       TO DATE-MODE.
050400     CALL "TDATECHK" USING DATE-CHECK-AREA.
050500     MOVE DATE-YMD-OUT            TO WS-DATE
050600                                     TODAY-DATE.
050700     SORT SORT-FILE ON ASCENDING KEY SORT-KEY
050800         INPUT PROCEDURE  7-SORT-PODATA
050900         OUTPUT PROCEDURE 8-WRITE-POINFO.
051000*    MOVE A CONTROL DATE TO THE EDI REPORT FILE, SO THAT
051100*    "XPRTRPT" CAN RETRIEVE A RANGE OF DATES AND PRINT
051200     MOVE SPACES                  TO EDI-REP-REC.
051300     MOVE "*"                     TO CTL.
051400     MOVE TODAY-DATE              TO CONTROL-DATE.
051500     WRITE EDI-REP-REC.
051600     IF REL-RECS-CTR > 0
051700         NEXT SENTENCE
051800     ELSE
051900     MOVE "NO RECORDS SELECTED TO BE TRANSMITTED"
052000         TO PRINT-AREA EDI-REPORT-LINE
052100     WRITE PRINT-RECORD AFTER ADVANCING 1 LINES
052200     MOVE 1 TO CTL
052300     WRITE EDI-REP-REC
052400     GO TO 2-EOJ.
           CLOSE OUT-FILE.
           OPEN INPUT OUT-FILE.
052500     MOVE 1 TO ACT-KEY.
052600     MOVE 59 TO LINE-CTR.
052700 1-READ-OUTF-LOOP.
052800     IF ACT-KEY > REL-RECS-CTR GO TO 2-EOJ.
052900     READ OUT-FILE    INVALID KEY GO TO 2-EOJ.
053000     MOVE SPACES TO DETAIL-1.
053100     MOVE "__________"   TO DET-UL-1.
053200     MOVE OUT-BUYER      TO DET-BUYER-1.
053300     MOVE OUT-PO         TO DET-PO-1.
053400     MOVE OUT-BGTAMT     TO DET-BGT-AMT-1.
053500     MOVE OUT-BGTNO      TO DET-BGT-NUMBER.
053600     MOVE OUT-VENDOR     TO DET-VEN-CODE-1.
053700     MOVE OUT-PODATE     TO DET-PO-DATE-1.
           EVALUATE OUT-FUNCTION
               WHEN "00"
                   MOVE "NEW"       TO DET-FUNCTION
               WHEN "04"
                   MOVE "MODIFY"    TO DET-FUNCTION
               WHEN "05"
                   MOVE "REPLACE"   TO DET-FUNCTION
           END-EVALUATE.
053800     ADD 1 TO LINE-CTR.
053900     IF LINE-CTR > 59 PERFORM 10-WRITE-HEADERS.
054000     MOVE DETAIL-1       TO PRINT-AREA.
054100     WRITE PRINT-RECORD FROM DETAIL-1 AFTER ADVANCING 1.
054200     MOVE 1              TO CTL.
054300     MOVE DETAIL-1       TO EDI-REPORT-LINE.
054400     WRITE EDI-REP-REC.
054500     ADD 1               TO ACT-KEY.
054600     GO TO 1-READ-OUTF-LOOP.
054700
054800 10-WRITE-HEADERS.
054900     MOVE 0              TO LINE-CTR.
055000     WRITE PRINT-RECORD FROM HEADER-1 AFTER ADVANCING NEW-PAGE.
055100     MOVE SPACES TO PRINT-AREA.
055200     WRITE PRINT-RECORD AFTER ADVANCING 1.
055300     WRITE PRINT-RECORD FROM HEADER-2 AFTER ADVANCING 1.
055400     WRITE PRINT-RECORD FROM STAR-132 AFTER ADVANCING 1.
055500     MOVE 0              TO CTL.
055600     MOVE HEADER-1       TO EDI-REPORT-LINE.
055700     WRITE EDI-REP-REC.
055800     MOVE 1              TO CTL.
055900     MOVE SPACES         TO EDI-REPORT-LINE.
056000     WRITE EDI-REP-REC.
056100     MOVE 1              TO CTL.
056200     MOVE HEADER-2       TO EDI-REPORT-LINE.
056300     WRITE EDI-REP-REC.
056400     MOVE 1              TO CTL.
056500     MOVE STAR-132       TO EDI-REPORT-LINE.
056600     WRITE EDI-REP-REC.
056700     MOVE 4              TO LINE-CTR.
056800
056900 2-EOJ.
           CLOSE DCOMMENT-MC-I.
           CLOSE DEDILOG-LK-O.
           CLOSE DPODATAITM-PO-I.
           CLOSE DPOITEM-PO-I.
           CLOSE DPORECD-PO-O.
           CLOSE DVENDOR-VN-I.
057600     CLOSE EDI-ERROR-FILE.
057700     CLOSE EDI-FILEABS.
057800     CLOSE EDI-REPORT-FILE.
           CLOSE MBUYER-BY-I.
           CLOSE MCOMMENT-MC-I.
           CLOSE MPLTINFO-PK-I.
           CLOSE MPLTINFO-PK-O.
           CLOSE MTAX-TX-I.
           CLOSE MVALIDUM-UM-I.
058400     CLOSE OUT-FILE.
058500     IF OPEN-RPT1-SW > 0 CLOSE SPOOL-ERROR-FILE.
058600     CLOSE PRINT-REPORT-FILE.
058700     CALL "TFORMRJE".
      *    MOVE "CLSENDEDI"    TO  SUBMIT-PGM.
      *    MOVE SPACES         TO  SUBMIT-PARM.
      *    MOVE "SEDIABST"     TO  SUBMIT-JOB.
      *    MOVE "MCMGR"        TO  SUBMIT-JOBD.
      *    MOVE "*JOBD"        TO  SUBMIT-OUTQ.
      *    MOVE "*JOBD"        TO  SUBMIT-USER.
      *    CALL "CLSUBMIT" USING   SUBMIT-PGM
      *                            SUBMIT-PARM
      *                            SUBMIT-JOB
      *                            SUBMIT-JOBD
      *                            SUBMIT-OUTQ
      *                            SUBMIT-USER.
058800     GOBACK.
058900
059000******************************************************
059100**                 BLOWUP ROUTINE                   **
059200******************************************************
059300
059400 2100-BLOWUP.
059500     CALL "TBLOWUP" USING BASE, BU-PGM-NAME, STATUS-AREA,
059600           VIEW-COMAREA, DUMMY-KSAM-STAT, BU-DISPLAY-MSG,
059700           BU-DISPLAY-AREA.
059800
059900
060000 7-SORT-PODATA.
           MOVE 0 TO BATCH-SW.
060100     PERFORM 7-SORT-DATA THRU 7-S-D-X.
060300 7-SORT-DATA.
           IF BATCH-SW = 0
               MOVE 1 TO BATCH-SW
061200         PERFORM 7000-CREATE-HEADER-RECORD.
061300     IF PASSED-PARMS = SPACES
061400         PERFORM 9999-BEGFIL-DEDILOG-LK-O
061500         PERFORM 70-READ-EDILOG-SERIAL THRU 70-RES-X
061600     ELSE
061700     IF PASSED-PO = SPACES
061800         PERFORM 9999-BEGFIL-DEDILOG-LK-O
061900         PERFORM 70-READ-EDILOG-SERIAL THRU 70-RES-X
062000     ELSE
062100     PERFORM  71-FIND-AND-GET-PO THRU 71-FAGP-X.
062200     PERFORM  7099-CREATE-TRAILER-RECORD.
062900*************************************************************
063000*    RE-READ "EPOR" RECORD OF MPLTINFO AND UPDATE DEDILOG
063100*    BY RETRIEVING EACH RECORD THAT WAS STORED IN THE TABLE
063200*    TO UPDATE BATCH NUMBER AND SEND FLAG AS WELL AS THE
063300*    DPORECD SEGMENT WITH THE INDICATOR THAT THE P.O. IS
063400*    AN EDI P.O.
063500*************************************************************
063600     IF TAB-SUB > 0
               IF PASSED-BATCHNO-X NOT = SPACES
                   NEXT SENTENCE
               ELSE
062300         MOVE DSET-MPLTINFO       TO DSET-NAME, DSET-NAME-1
062400         MOVE "EPOR"              TO MPLTINFO-ARG, PLT-ARG,
                                           LOCK-VALUE-1
               MOVE 1                   TO NUMBER-OF-DSETS-LOCKED
               PERFORM 9999-MULTI-LOCK
062500         PERFORM 9999-GETKEY-MPLTINFO-PK-O
061000         MOVE BUF-MPLTINFO        TO BUF-MPLTINFO-SAVE
061100         ADD  1                   TO MPLTINFO-LOG-BATCH-NO-S
062600         MOVE BUF-MPLTINFO-SAVE   TO BUF-MPLTINFO
062700         PERFORM  9999-UPDATE-MPLTINFO-PK-O
062800         PERFORM  9999-UNLOCK
063700         MOVE 0                   TO TAB-SUB
063800         MOVE DSET-DEDILOG        TO DSET-NAME
057100         CLOSE DEDILOG-LK-O
               OPEN I-O  DEDILOG-LK-O
061800         PERFORM 9999-BEGFIL-DEDILOG-LK-O
063900*        CALL "DBCLOSE" USING BASE, DSET-NAME, MODE3, STATUS-AREA
064000         PERFORM  72-UPDATE-DATA THRU 72-UD-EXIT.
064100 7-S-D-X.    EXIT.
064200
064300 70-READ-EDILOG-SERIAL.
064400     PERFORM 9999-GETSER-DEDILOG-LK-O.
064500     IF END-OF-FILE GO TO 70-RES-X.
           IF LOG-REL-NO = "999"
               MOVE "EDI "              TO PLT-ARG
               PERFORM 9999-GETKEY-MPLTINFO-PK-I
               IF GOOD-CALL
                   IF EDI-SEND-BLKTS = "Y"
                       NEXT SENTENCE
                   ELSE
071800             PERFORM 79-HEADER-ROUTINE
071900             MOVE SPACES          TO DETAIL-X
072000             MOVE LOG-KEY         TO DET-PO
072100             MOVE "BLANKET ORDER SEND FLAG NOT SET - NO SEND"
072200                                  TO DET-REASON
072300             WRITE SPOOL-RECORD FROM DETAIL-X AFTER ADVANCING 1
072400             MOVE 1 TO CTL-E
072500             MOVE DETAIL-X        TO EDI-ERROR-LINE
072600             WRITE EDI-ERR-REC
                   GO TO 70-READ-EDILOG-SERIAL
               ELSE
071800         PERFORM 79-HEADER-ROUTINE
071900         MOVE SPACES              TO DETAIL-X
072000         MOVE LOG-KEY             TO DET-PO
072100         MOVE "BLANKET ORDER SEND FLAG NOT SET - NO SEND"
072200                                  TO DET-REASON
072300         WRITE SPOOL-RECORD FROM DETAIL-X AFTER ADVANCING 1
072400         MOVE 1 TO CTL-E
072500         MOVE DETAIL-X            TO EDI-ERROR-LINE
072600         WRITE EDI-ERR-REC
               GO TO 70-READ-EDILOG-SERIAL.
064600     IF PASSED-BATCHNO NUMERIC
064700         IF PASSED-BATCHNO-X = LOG-BATCHNO-X
064800             NEXT SENTENCE
064900         ELSE
065000         GO TO 70-READ-EDILOG-SERIAL
065100     ELSE
065200     IF LOG-BATCHNO NUMERIC
065300         IF LOG-FLAG-SEND = " "
065400             NEXT SENTENCE
065500         ELSE
065600         GO TO 70-READ-EDILOG-SERIAL.
065700     MOVE LOG-KEY                 TO SEDIVNCK-PO-NUMBER.
065800     MOVE SPACES                  TO SEDIVNCK-VEN-CODE
065900                                     SEDIVNCK-EDI-IND.
066000     CALL "SEDIVNCK" USING BASE,
066100                           SEDIVNCK-PARMS.
066400     IF SEDIVNCK-EDI-IND = "Y"
066500         NEXT SENTENCE
066600     ELSE
066700     PERFORM 79-HEADER-ROUTINE
066800     MOVE SPACES                  TO DETAIL-X
066900     MOVE LOG-KEY                 TO DET-PO
067000     MOVE "VENDOR IS NO LONGER AN EDI VENDOR" TO DET-REASON
067100     WRITE SPOOL-RECORD FROM DETAIL-X AFTER ADVANCING 1
067200     MOVE 1 TO CTL-E
067300     MOVE DETAIL-X TO EDI-ERROR-LINE
067400     WRITE EDI-ERR-REC
067500     GO TO 70-READ-EDILOG-SERIAL.
067600     MOVE 0                       TO NO-SEND-SW.
067700     PERFORM 7010-CREATE-TRANS-CONT-RECORD.
067800     IF NO-SEND-SW > 0 GO TO 70-READ-EDILOG-SERIAL.
067900     PERFORM 7011-CREATE-PAYMENT-RECORD.
068000     IF NO-SEND-SW > 0 GO TO 70-READ-EDILOG-SERIAL.
068100     PERFORM 7012-CREATE-SHIP-TO-RECORD.
068200****************************************************************
068300*    MULTIPLE REC014 RECORDS MAY BE WRITTEN DEPENDING ON THE   *
068400*    NUMBER OF STANDARD INSTRUCTIONS TIED TO THE HEADER        *
068500*    SO THEY WILL BE CREATED WHEN ALL THE RECORDS ARE WRITTEN  *
068600*    TO THE FLATFILE                                           *
068700****************************************************************
068800     PERFORM 7015-CREATE-MISC-INFO-RECORD.
068900     IF NO-SEND-SW > 0 GO TO 70-READ-EDILOG-SERIAL.
069000****************************************************************
069100*    MULTIPLE REC020, REC021, AND REC023 TYPES MAY BE WRITTEN  *
069200*    TO THE FLATFILE BASED ON THE NUMBER OF ITEMS TIED TO THE  *
069300*    PURCHASE ORDER SO THEY WILL BE HANDLED AT RECORD          *
069400*    GENERATION TIME
069500****************************************************************
069600     PERFORM 7090-CREATE-TRAILER-PO-RECORD.
069700     PERFORM 7999-WRITE-EDI-FLATFILE.
069800     GO TO 70-READ-EDILOG-SERIAL.
069900 70-RES-X.    EXIT.
070000
070100 71-FIND-AND-GET-PO.
070200     MOVE 0                       TO NO-SEND-SW.
070300     MOVE PASSED-PO               TO PO-ARG.
070400     PERFORM 9999-CHAINHD-DEDILOG-LK-O.
070500     IF NOT GOOD-CALL
070600         PERFORM 79-HEADER-ROUTINE
070700         MOVE SPACES              TO DETAIL-X
070800         MOVE PASSED-PO           TO DET-PO
070900         MOVE "PURCHASE ORDER RECORD NON-RETRIEVABLE"
071000                                  TO DET-REASON
071100         WRITE SPOOL-RECORD FROM DETAIL-X AFTER ADVANCING 1
071200         MOVE 1 TO CTL-E
071300         MOVE DETAIL-X TO EDI-ERROR-LINE
071400         WRITE EDI-ERR-REC
071500         GO TO 71-FAGP-X.
071600     PERFORM 9999-GETNEXT-DEDILOG-LK-O.
071700     IF NOT GOOD-CALL
071800         PERFORM 79-HEADER-ROUTINE
071900         MOVE SPACES              TO DETAIL-X
072000         MOVE PASSED-PO           TO DET-PO
072100         MOVE "PURCHASE ORDER RECORD NON-RETRIEVABLE"
072200                                  TO DET-REASON
072300         WRITE SPOOL-RECORD FROM DETAIL-X AFTER ADVANCING 1
072400         MOVE 1 TO CTL-E
072500         MOVE DETAIL-X TO EDI-ERROR-LINE
072600         WRITE EDI-ERR-REC
072700         GO TO 71-FAGP-X.
           IF LOG-REL-NO = "999"
               MOVE "EDI "              TO PLT-ARG
               PERFORM 9999-GETKEY-MPLTINFO-PK-I
               IF GOOD-CALL
                   IF EDI-SEND-BLKTS = "Y"
                       NEXT SENTENCE
                   ELSE
071800             PERFORM 79-HEADER-ROUTINE
071900             MOVE SPACES          TO DETAIL-X
072000             MOVE PASSED-PO       TO DET-PO
072100             MOVE "BLANKET ORDER SEND FLAG NOT SET - NO SEND"
072200                                  TO DET-REASON
072300             WRITE SPOOL-RECORD FROM DETAIL-X AFTER ADVANCING 1
072400             MOVE 1 TO CTL-E
072500             MOVE DETAIL-X TO EDI-ERROR-LINE
072600             WRITE EDI-ERR-REC
072700             GO TO 71-FAGP-X
               ELSE
071800         PERFORM 79-HEADER-ROUTINE
071900         MOVE SPACES              TO DETAIL-X
072000         MOVE PASSED-PO           TO DET-PO
072100         MOVE "BLANKET ORDER SEND FLAG NOT SET - NO SEND"
072200                                  TO DET-REASON
072300         WRITE SPOOL-RECORD FROM DETAIL-X AFTER ADVANCING 1
072400         MOVE 1 TO CTL-E
072500         MOVE DETAIL-X TO EDI-ERROR-LINE
072600         WRITE EDI-ERR-REC
072700         GO TO 71-FAGP-X.
           PERFORM 7005-PRECHECK-FOR-ITEMS THRU 7005-PFI-X.
           IF GOOD-CALL
               NEXT SENTENCE
           ELSE
           PERFORM 79-HEADER-ROUTINE
           MOVE SPACES          TO DETAIL-X
           MOVE PASSED-PO       TO DET-PO
           MOVE "PURCHASE ORDER HAS NO ACTIVE ITEMS - NO SEND"
                                TO DET-REASON
           WRITE SPOOL-RECORD FROM DETAIL-X AFTER ADVANCING 1 LINES
           MOVE 1               TO CTL-E
           MOVE DETAIL-X        TO EDI-ERROR-LINE
           WRITE EDI-ERR-REC
           GO TO 71-FAGP-X.
072800     PERFORM 7010-CREATE-TRANS-CONT-RECORD.
072900     IF NO-SEND-SW > 0 GO TO 71-FAGP-X.
073000     PERFORM 7011-CREATE-PAYMENT-RECORD.
073100     IF NO-SEND-SW > 0 GO TO 71-FAGP-X.
073200     PERFORM 7012-CREATE-SHIP-TO-RECORD.
073300****************************************************************
073400*    MULTIPLE REC014 RECORDS MAY BE WRITTEN DEPENDING ON THE   *
073500*    NUMBER OF STANDARD INSTRUCTIONS TIED TO THE HEADER        *
073600*    SO THEY WILL BE CREATED WHEN ALL THE RECORDS ARE WRITTEN  *
073700*    TO THE FLATFILE                                           *
073800****************************************************************
073900     PERFORM 7015-CREATE-MISC-INFO-RECORD.
074000     IF NO-SEND-SW > 0 GO TO 71-FAGP-X.
074100****************************************************************
074200*    MULTIPLE REC020, REC021, AND REC023 TYPES MAY BE WRITTEN  *
074300*    TO THE FLATFILE BASED ON THE NUMBER OF ITEMS TIED TO THE  *
074400*    PURCHASE ORDER SO THEY WILL BE HANDLED AT RECORD          *
074500*    GENERATION TIME
074600****************************************************************
074700     PERFORM 7090-CREATE-TRAILER-PO-RECORD.
074800     PERFORM 7999-WRITE-EDI-FLATFILE.
074900
075000 71-FAGP-X.    EXIT.
075100
075200 72-UPDATE-DATA.
075300     ADD 1                        TO TAB-SUB.
075400     IF TAB-SUB > 200 OR RECORD-ENTRY (TAB-SUB) = SPACES
075500         GO TO 72-UD-EXIT.
075600 72-UD-CONT.
075700     PERFORM 9999-GETSER-DEDILOG-LK-O.
075800     IF END-OF-FILE GO TO 72-UD-EXIT.
075900     IF R-E (TAB-SUB) = LOG-RECORD-NO
076000         NEXT SENTENCE
076100     ELSE
076200     GO TO 72-UD-CONT.
076300     PERFORM 9999-DSET-LOCK.
076400     MOVE MPLTINFO-LOG-BATCH-NO-S TO LOG-BATCHNO.
076500     MOVE DATE-YMD-OUT            TO LOG-SEND-DATE.
           IF LOG-SEND-DATE-YY > "70"
               MOVE "19"                TO LOG-SEND-DATE-CC
           ELSE
           MOVE "20"                    TO LOG-SEND-DATE-CC.
076600     ACCEPT LOG-SEND-TIME FROM TIME.
076700     MOVE "X"                     TO LOG-FLAG-SEND.
076800     IF PASSED-IND = "M" MOVE "X" TO LOG-FLAG-M.
           PERFORM 70113-FIND-SUB-TRANSACTION.
           MOVE HOLD-SUB-TRANS          TO LOG-SUB-TRANS-NUM.
076900     PERFORM 9999-UPDATE-DEDILOG-LK-O.
077000     PERFORM 9999-UNLOCK.
077100     MOVE DSET-DPORECD            TO DSET-NAME, DSET-NAME-1.
077200     MOVE LOG-KEY                 TO PO-ARG, LOCK-VALUE-1.
077300     MOVE 1                       TO NUMBER-OF-DSETS-LOCKED.
077400     PERFORM 9999-MULTI-LOCK.
077500     PERFORM 9999-CHAINHD-DPORECD-PO-O.
077600     PERFORM 9999-GETNEXT-DPORECD-PO-O.
077700     MOVE "Y"                     TO PO-EDI-FLAG.
077800     PERFORM 9999-UPDATE-DPORECD-PO-O.
077900     PERFORM 9999-UNLOCK.
078000     MOVE DSET-DEDILOG        TO DSET-NAME.
           CLOSE DEDILOG-LK-O.
           OPEN I-O DEDILOG-LK-O.
061800     PERFORM 9999-BEGFIL-DEDILOG-LK-O.
078100*    CALL "DBCLOSE" USING BASE, DSET-NAME, MODE3, STATUS-AREA.
078200     GO TO 72-UPDATE-DATA.
078300 72-UD-EXIT.    EXIT.
078400
078500 79-HEADER-ROUTINE.
078600     IF OPEN-RPT1-SW = 0
078700         MOVE 1               TO OPEN-RPT1-SW
078800*        MOVE 0               TO OVRPRTF-TOFILE-NUM
078900*        PERFORM 996-OVERRIDE-PRINT-FILE
079000         OPEN OUTPUT SPOOL-ERROR-FILE
079100         MOVE SPACES          TO EDI-ERROR-LINE
079200         MOVE "*"             TO CTL-E
079300         MOVE TODAY-DATE      TO CONTROL-DATE-E
079400         WRITE EDI-ERR-REC
079500         MOVE HEADER-X        TO SPOOL-RECORD
