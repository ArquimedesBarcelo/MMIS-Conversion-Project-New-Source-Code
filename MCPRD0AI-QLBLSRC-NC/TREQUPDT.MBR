DCR01 *----------------------------------------------------------------
DCR01 *--- ARIBA PROCESSING ADDED - WRITE A LOG RECORD
DCR01 *----------------------------------------------------------------
DCR01  69-CREATE-CREQLOG.
DCR01
VER23      MOVE SAVE-SGETABPF-PARMS TO SGETABPF-PARMS.
DCR01      INITIALIZE  LS-CREQLOG-PARMS.
DCR01      MOVE  BUILD-REQ-NO     TO LS-CREQLOG-REQNO.
DCR01      MOVE  CODE-ARG         TO LS-CREQLOG-CORP-CODE.
DCR01      MOVE  COMPANY-SAVE     TO LS-CREQLOG-PLANT-CODE.
DCR01      MOVE  SGETABPF-MANF-NAME TO LS-CREQLOG-MANFACT-NAME.
DCR01      MOVE  SGETABPF-MANF-PARTNO TO LS-CREQLOG-MANFACT-PARTNO.
DCR01      MOVE  SGETABPF-VENDOR-CODE TO LS-CREQLOG-VENDOR-CODE.
DCR01      MOVE  SGETABPF-VENDOR-PARTNO TO LS-CREQLOG-VENDOR-PARTNO.
DCR01      MOVE  SGETABPF-VENDOR-AUXID  TO LS-CREQLOG-VENDOR-AUXID.
DCR01      MOVE  SGETABPF-UM            TO LS-CREQLOG-UOM.
DCR01      CALL "CREQLOG"  USING LS-CREQLOG-PARMS.
DCR01
DCR01  69-CREQLOG-EXIT.
DCR01      EXIT.
DCR01 *----------------------------------------------------------------

VER23 *****************************************************************
VER23 *  LOGGING EXCEPTION TO SENDING REQ. TO ARIBA - USER ENTERED    *
VER23 *  STATUS OF 'AB' TO BY-PASS ARIBA AND SEND TO PURCHASING       *
VER23 *****************************************************************
VER23
VER23 *---------------------------------------------------------------
VER23 *- WE DO NOT KNOW WHAT THEY COULD HAVE ORDERED THRU ARIBA OR   -
VER23 *- WHAT THEY DID ORDER THROUGH CSIS - SO WE JUST ADD WHAT      -
VER23 *- WE DO KNOW.                                                 -
VER23 *---------------------------------------------------------------
VER23  69-LOG-EXCEPTION.
VER23      INITIALIZE BUF-DARIBEXP.
VER23      MOVE DISP-REQ-NO          TO ARIBAEXP-REQ-NUMBER.
VER23      MOVE DISP-CODE            TO ARIBAEXP-CORP-CODE.
VER23      MOVE DISP-SCREEN2-COMP    TO ARIBAEXP-PLANT-ID.
VER23      MOVE USERNAME             TO ARIBAEXP-USER-ID.
VER23      MOVE TRM-REQ-QTY          TO ARIBAEXP-REQ-QTY,
VER23                                   ARIBAEXP-QTY-ORD.
VER23      MOVE DISP-UM              TO ARIBAEXP-REQ-QTY-UM.
VER23      MOVE SPACES               TO ARIBAEXP-PRF-MANUFACT-NAME,
VER23                                   ARIBAEXP-PRF-MANUFACT-PARTNO,
VER23                                   ARIBAEXP-PRF-VENDOR-CODE,
VER23                                   ARIBAEXP-PRF-VENDOR-PARTNO,
VER23                                   ARIBAEXP-PRF-VENDOR-AUXID,
VER23                                   ARIBAEXP-PRF-CURR-CODE,
VER23                                   ARIBAEXP-EXP-MANUFACT-NAME,
VER23                                   ARIBAEXP-EXP-MANUFACT-PARTNO,
VER23                                   ARIBAEXP-EXP-VENDOR-CODE,
VER23                                   ARIBAEXP-EXP-VENDOR-PARTNO,
VER23                                   ARIBAEXP-EXP-VENDOR-AUXID,
VER23                                   ARIBAEXP-EXP-CURR-CODE.
VER23      MOVE ZEROS                TO ARIBAEXP-PRF-VENDOR-PRICE,
VER23                                   ARIBAEXP-EXP-PURCH-PRICE.
VER23      MOVE EXCEPTION-NO         TO ARIBAEXP-REASON-CODE.
VER23      MOVE EXCEPTION-REASON     TO ARIBAEXP-REASON-TEXT.
VER23      CALL "GETDTSTMP2"         USING WS-SYSTEM-DATE-TIME2.
VER23      MOVE WS-SYSTEM-DATE-TIME2 TO ARIBAEXP-DATE-TIME.
VER23      WRITE DARIBAEXCEPT-REC-O  FROM BUF-DARIBEXP
VER23        INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
VER23      IF FILE-STATUS NOT = "00"
VER23          MOVE "PUT DARIBAEXEPT * 69-LE" TO BU-DISPLAY-MSG
VER23          GO TO 2-BLOWUP
VER23      END-IF.
VER23
VER23  69-LE-X.
VER23      EXIT.
VER23
       9000-START-MVALIDPLTDATA-I.
           MOVE 0 TO COND-WORD.
           MOVE MVALIDPLT-ARG TO VALDTAKEY OF MVALIDPLTDATA-REC-I.
           START MVALIDPLTDATA-I KEY = VALDTAKEY OF MVALIDPLTDATA-REC-I
               INVALID KEY MOVE 17 TO COND-WORD.
           IF FILE-STATUS-1 = "2"
               MOVE 17 TO COND-WORD
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD.

       9000-START-MCLASS-I.
           MOVE 0 TO COND-WORD.
           MOVE PLT-ARG TO ACTGCLASS OF MCLASS-REC-I.
           START MCLASS-I KEY = EXTERNALLY-DESCRIBED-KEY
               INVALID KEY MOVE 17 TO COND-WORD.
           IF FILE-STATUS-1 = "2"
               MOVE 17 TO COND-WORD
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD.

       COPY DISPCALL IN COPYLIB.

       998-AUTO-READ-SCREEN.
           READ  DISPLAY-FILE TERMINAL IS TERMINAL-ID
               INDIC ARE SRF-INDICATORS
                   NO DATA MOVE DISPLAY-STATUS TO DISPLAY-STATUS.
           MOVE ALL B"0" TO SRF-INDICATORS.

       999-CATREAD.
           IF CATREAD-MSG-NUMBER = ZEROS
               MOVE LANG-SETNUM TO CATREAD-MSG-SET
               MOVE LANG-MSGNUM TO CATREAD-MSG-NUM.
           CALL "CCATREAD" USING CATREAD-PARMS.
           MOVE CATREAD-MSG-TEXT TO MESSAGE-BUFFER.
       999-CATREAD-EXIT.
           EXIT.
