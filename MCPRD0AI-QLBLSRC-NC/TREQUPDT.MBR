119900 61-WRITE-FIRST-SCREEN.
120000     MOVE "FREQUPDT1"  TO  VIEW-NFNAME.
120500
120600**************************************************
120700*                                                *
120800*    UPON THE FIRST WRITE OF FORM-BUF1           *
120900*    'AT-LEAST-ONE-REQ' IS INITIALLY "Y" SO      *
121000*    AS TO BY PASS THIS IF STATEMENT WHICH IS    *
121100*    USED EVERY TIME AFTER THE FIRST READ        *
121200*    TO DETERMINE......                          *
121300*      1) IF WHILE PROCESSING BY DATE WHETHER    *
121400*         OR NOT AT LEAST ONE REQ WAS FOUND      *
121500*         EITHER (BY DATE) OR (BY DATE WITHIN    *
121600*         MAJOR GROUP RANGE)                     *
121700*                                                *
121800**************************************************
121900
122000     MOVE SPACES                  TO  REQ-DATE-PROC,
122100                                      SAVE-REQ-NO,
                                            SAVE-AUTH-FLAG.
122200
122300     IF AT-LEAST-ONE-REQ  =  "Y"
122400       MOVE SPACES  TO  AT-LEAST-ONE-REQ
122500     ELSE
122600       MOVE TRM-REQ-DATE  TO  MSG-FLD
122700       MOVE 1  TO  FIELD-NUMBER
122800       IF TRM-REQUIRE-OPTION = "X"
122900         IF REQ-QUALIFIES-SW  =  "Y"
123000*** ALL REQS ON OPEN REQUIREMENT ORDERS FOR DATE ARE PROCESSED ***
123100             MOVE   1 TO LANG-SETNUM
123200             MOVE  20 TO LANG-MSGNUM
123300             PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
123400             PERFORM 4-PGM-ERROR  THRU  4-PGM-ERROR-X
123500             GO TO 61-SHOWFORM-SCREEN-1
123600         ELSE
123700*** NO REQS ON OPEN REQUIREMENT ORDERS FOR DATE ENTERED WERE CREATED ***
123800             MOVE  14 TO LANG-SETNUM
123900             MOVE  81 TO LANG-MSGNUM
124000             PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
124100             PERFORM 4-PGM-ERROR  THRU  4-PGM-ERROR-X
124200             GO TO 61-SHOWFORM-SCREEN-1
124300       ELSE
124400         IF TRM-FROM-MAJ-GRP NOT = SPACES
124500             IF REQ-QUALIFIES-SW = "Y"
124600*** ALL REQS FOR DATE & MAJOR GROUP RANGE ENTERED ARE PROCESSED ***
124700                 MOVE   1 TO LANG-SETNUM
124800                 MOVE  21 TO LANG-MSGNUM
124900                 PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
125000                 PERFORM 4-PGM-ERROR THRU 4-PGM-ERROR-X
125100                 GO TO 61-SHOWFORM-SCREEN-1
125200             ELSE
125300*** NO REQS FOR DATE & MAJOR GROUP RANGE ENTERED WERE CREATED ***
125400                 MOVE  14 TO LANG-SETNUM
125500                 MOVE  82 TO LANG-MSGNUM
125600                 PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
125700                 PERFORM 4-PGM-ERROR THRU 4-PGM-ERROR-X
125800                 GO TO 61-SHOWFORM-SCREEN-1
125900         ELSE
126000*** ALL REQUISITIONS FOR DATE ENTERED ARE PROCESSED ***
126100             MOVE   1 TO LANG-SETNUM
126200             MOVE  22 TO LANG-MSGNUM
126300             PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
126400             PERFORM 4-PGM-ERROR THRU 4-PGM-ERROR-X
126500             GO TO 61-SHOWFORM-SCREEN-1.
126600
126700     MOVE SPACES  TO SCREEN-1.
      **** MOVE ZEROS   TO TRM-REQ-NUM.
126800     MOVE COMP-SCREEN-INDIC  TO  DISP-SCREEN1-COMP.
128300
128400 61-SHOWFORM-SCREEN-1.
           MOVE SCREEN-1 TO DISPLAY-REC.
           PERFORM 998-WRITE-SCREEN THRU 998-READ-SCREEN.
           MOVE DISPLAY-REC TO SCREEN-1.
130100
130200     IF VIEW-LASTKEY = 3
130300         MOVE "Y"  TO  EOJ-SW
130400         GO TO 61-WFS-X
130500     ELSE
132800     IF VIEW-LASTKEY = 1
