      **********************************************
      *  ADDED THE FOLLOWING CODE 8/9/94 TO ROUTE  *
      *  A CODED REQ TO AN APPROVAL PATH IF THE    *
      *  USER HAS TURNED THE AUTHORIZATION FLAG ON *
      *  FOR THE CORPORATE CODED ITEM VIA (MP1)    *
      **********************************************
DCR01 *----------------------------------------------------------------
DCR01 *--- ARIBA PROCESSING ADDED
DCR01 *----------------------------------------------------------------
DCR01      IF  CODE-FILTER-FND-YES
DCR01          GO TO 64-CONT-NO-APPS
DCR01      END-IF.
DCR01 *----------------------------------------------------------------

           IF SAVE-AUTH-FLAG = "X"
               NEXT SENTENCE
           ELSE
           GO TO 64-CONT-NO-APPS.

           IF REQ-REPAIR-INDIC NOT = " " GO TO 64-CONT-NO-APPS.
           IF REQ-APPROVALS-LEFT > "  "
               IF REQ-APPROVALS-LEFT = "00"
                   NEXT SENTENCE
               ELSE
               GO TO 64-PR-X.
           PERFORM 640-DELETE-00-DREQQ THRU 640-D00D-X.
           MOVE SPACES              TO  RQPH-AREA.
           MOVE "R"                 TO  RQPH-PATH-TYPE.
           MOVE REQ-SUB             TO  RQPH-CLASS.
           IF REQ-AUTH-APPVL-DEPT = "    "
               MOVE REQ-SUBD        TO  RQPH-DEPARTMENT
                                        RQPH-REQ-DEPT
                                        REQ-AUTH-APPVL-DEPT
           ELSE
           MOVE REQ-AUTH-APPVL-DEPT TO  RQPH-DEPARTMENT
                                        RQPH-REQ-DEPT.
           IF COMPANY-SAVE = "631"
               IF TRM-REQ-SUBD = SAVE-STRMDEPT
                   IF SAVE-DFLT-DEPT = "      "
                       MOVE REQ-ADDTL-DATA TO RQPH-EXPENSE-CLASS
                   ELSE
                   MOVE "999999"    TO  RQPH-EXPENSE-CLASS
               ELSE
               MOVE REQ-ADDTL-DATA  TO  RQPH-EXPENSE-CLASS
           ELSE
           MOVE REQ-ADDTL-DATA      TO  RQPH-EXPENSE-CLASS.
           IF REQ-MMIS-REQ-NO = "            "
               IF SAVE-PREQ-AUTH-SW = "Y"
                   IF SAVE-AUTH-EXP NOT = "      "
                       IF COMPANY-SAVE = "153"
                           IF SAVE-LAST-CHARGE-DEPT NOT = "    "
                               MOVE SAVE-AUTH-EXP
                                   TO RQPH-EXPENSE-CLASS
                               MOVE SAVE-LAST-CHARGE-DEPT
                                   TO RQPH-REQ-DEPT
                                      RQPH-DEPARTMENT
                           ELSE
                           MOVE SAVE-AUTH-EXP TO RQPH-EXPENSE-CLASS
                           MOVE SAVE-DFLT-DEPT TO RQPH-REQ-DEPT
                                                  RQPH-DEPARTMENT
                       ELSE
                       MOVE SAVE-AUTH-EXP   TO  RQPH-EXPENSE-CLASS
                       MOVE SAVE-DFLT-DEPT  TO  RQPH-REQ-DEPT,
                                                RQPH-DEPARTMENT.
           MOVE REQ-BUDGET-NO       TO  RQPH-BUDGET-NUMBER.
           MOVE REQ-BUDGET-AMT      TO  RQPH-VALUE.
           CALL "CEARQPH" USING BASE,
                                STATUS-AREA,
                                RQPH-AREA,
                                BU-DISPLAY-MSG.
           IF BU-DISPLAY-MSG-1 NOT = SPACES
               GO TO 2-BLOWUP.
           PERFORM 640-GET-REQ-GLOBALS.
           MOVE SPACES              TO  EAQ-AREA.
           MOVE BUILD-REQ-NO        TO  EAQ-REQ-NUMBER
                                        MREQ-NUMBER.
           MOVE RQPH-RET-PATH       TO  EAQ-PATH-ARG.
           MOVE RQPH-RET-PATH2      TO  EAQ-PATH-ARG2.
           MOVE REQ-ORIGINATOR      TO  EAQ-ORIG-EMPL.
           MOVE "R"                 TO  EAQ-QUEUE-TYPE.
           MOVE "A"                 TO  EAQ-WO-APP.
           MOVE "N"                 TO  EAQ-WO-FLAG.
           MOVE "X"                 TO  EAQ-AUTH-FLAG.
           CALL "CEAQUE" USING BASE, STATUS-AREA, EAQ-AREA,
                           REQ-GLOBALS, BUF-MREQ,
                           BU-DISPLAY-MSG.
           IF BU-DISPLAY-MSG-1 NOT = SPACES
               GO TO 2-BLOWUP.
           MOVE " "                 TO  EAQ-AUTH-FLAG.

