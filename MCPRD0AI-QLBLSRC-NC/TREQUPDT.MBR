133300                              LANGUAGE-PARMS
133400         MOVE "Y"                 TO  AT-LEAST-ONE-REQ
133500         GO TO 61-WRITE-FIRST-SCREEN
133600     ELSE
133700     IF VIEW-LASTKEY = 2 OR
133800        VIEW-LASTKEY = 4 OR
133800        VIEW-LASTKEY = 5 OR
133900        VIEW-LASTKEY = 6 OR
134000        VIEW-LASTKEY = 7 OR
134000        VIEW-LASTKEY = 8
134200*        *** INVALID FUNCTION KEY ENTERED ***
134300         MOVE   9 TO LANG-SETNUM
134400         MOVE  10 TO LANG-MSGNUM
134500         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
134600         MOVE 4  TO  FIELD-NUMBER
134700         PERFORM 4-PGM-ERROR  THRU  4-PGM-ERROR-X
134800         GO TO 61-SHOWFORM-SCREEN-1.
136800
      *------ FIELD EDITS

           IF TRM-REQ-NUM = SPACES  AND
              TRM-REQ-DATE = SPACES
      *         NO DATA ENTERED
               MOVE 66120 TO CATREAD-MSG-NUMBER
069800         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
069900         MOVE 1  TO FIELD-NUMBER
070000         PERFORM 4-PGM-ERROR  THRU  4-PGM-ERROR-X
070100         GO TO 61-SHOWFORM-SCREEN-1.
067100
           IF TRM-REQ-NUM NOT = SPACES  AND
              TRM-REQ-DATE NOT = SPACES
      *         CHOOSE ONLY ONE OPTION - DATE OR NUMBER
               MOVE 66211 TO CATREAD-MSG-NUMBER
069800         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
069900         MOVE 1  TO FIELD-NUMBER
070000         PERFORM 4-PGM-ERROR  THRU  4-PGM-ERROR-X
070100         GO TO 61-SHOWFORM-SCREEN-1.
067100
           IF TRM-REQ-DATE = SPACES  AND
              TRM-REQUIRE-OPTION = "X"
      *         CANNOT SELECT REQS ON REQUIREMENT ORDERS WHEN
      *         PROCESSING BY NUMBER
               MOVE 66212 TO CATREAD-MSG-NUMBER
069800         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
069900         MOVE 6  TO FIELD-NUMBER
070000         PERFORM 4-PGM-ERROR  THRU  4-PGM-ERROR-X
070100         GO TO 61-SHOWFORM-SCREEN-1.
067100
           IF TRM-REQ-DATE = SPACES  AND
              TRM-FROM-MAJ-GRP NOT = SPACES
      *         CANNOT SELECT MAJOR GROUP WHEN PROCESSING BY NUMBER
               MOVE 66213 TO CATREAD-MSG-NUMBER
069800         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
069900         MOVE 2  TO FIELD-NUMBER
070000         PERFORM 4-PGM-ERROR  THRU  4-PGM-ERROR-X
070100         GO TO 61-SHOWFORM-SCREEN-1.
067100
           IF TRM-REQ-DATE = SPACES  AND
              TRM-TO-MAJ-GRP NOT = SPACES
      *         CANNOT SELECT MAJOR GROUP WHEN PROCESSING BY NUMBER
               MOVE 66213 TO CATREAD-MSG-NUMBER
069800         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
069900         MOVE 3  TO FIELD-NUMBER
070000         PERFORM 4-PGM-ERROR  THRU  4-PGM-ERROR-X
070100         GO TO 61-SHOWFORM-SCREEN-1.
067100
           IF TRM-REQ-DATE = SPACES  AND
              TRM-DEPT NOT = SPACES
      *         CANNOT SELECT DEPT WHEN PROCESSING BY NUMBER
      *        MOVE 66213 TO CATREAD-MSG-NUMBER
      *        PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE "CANNOT SELECT DEPT WHEN PROCESSING BY NUMBER"
                 TO MESSAGE-BUFFER
               MOVE 7  TO FIELD-NUMBER
               PERFORM 4-PGM-ERROR  THRU  4-PGM-ERROR-X
               GO TO 61-SHOWFORM-SCREEN-1.

           IF TRM-TO-MAJ-GRP NOT = SPACES AND
              TRM-FROM-MAJ-GRP = SPACES
      *         DATA REQUIRED - 'FROM' MAJOR GROUP
               MOVE 66214 TO CATREAD-MSG-NUMBER
069800         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
069900         MOVE 2  TO FIELD-NUMBER
070000         PERFORM 4-PGM-ERROR  THRU  4-PGM-ERROR-X
070100         GO TO 61-SHOWFORM-SCREEN-1.
067100
           IF TRM-FROM-MAJ-GRP NOT = SPACES AND
              TRM-TO-MAJ-GRP = SPACES
      *         DATA REQUIRED - 'TO' MAJOR GROUP
               MOVE 66215 TO CATREAD-MSG-NUMBER
069800         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
069900         MOVE 3  TO FIELD-NUMBER
070000         PERFORM 4-PGM-ERROR  THRU  4-PGM-ERROR-X
070100         GO TO 61-SHOWFORM-SCREEN-1.
067100
           IF TRM-FROM-MAJ-GRP > TRM-TO-MAJ-GRP
      *         'FROM' MAJOR GROUP IS GREATER THAN 'TO' MAJOR GROUP
               MOVE 66216 TO CATREAD-MSG-NUMBER
069800         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
069900         MOVE 2  TO FIELD-NUMBER
070000         PERFORM 4-PGM-ERROR  THRU  4-PGM-ERROR-X
070100         GO TO 61-SHOWFORM-SCREEN-1.
067100
136900     IF TRM-REQ-DATE = SPACES
