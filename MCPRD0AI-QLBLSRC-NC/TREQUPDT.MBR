DCR01 *----------------------------------------------------------------
DCR01 *--- ARIBA PROCESSING
DCR01 *----------------------------------------------------------------

DCR01      SET  ARIBA-ENABLED-NO   TO TRUE.
DCR01 *----------------------------------------------------------------
DCR01 * RETRIEVE PLTINFO KEY = 'ARIB' IF FOUND THEN ARIBA ENABLED *
DCR01 *----------------------------------------------------------------
DCR01      MOVE "ARIB"  TO PLT-ARG.
DCR01      MOVE PLT-ARG TO PLTINFOKEY OF MPLTINFO-REC.
DCR01      READ MPLTINFO INTO BUF-MPLTINFO
DCR01          INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
DCR01      IF FILE-STATUS = "00"
DCR01          SET  ARIBA-ENABLED-YES  TO TRUE
DCR01          MOVE MPLTINFO-ARIBA-FILTER-LENGTH TO SAVE-ARIBA-LENGTH
DCR01      END-IF.
DCR04      MOVE ARIBA-ENABLED-SW   TO SAVE-ARIBA-ENABLED-SW.
DCR01 *----------------------------------------------------------------


           MOVE "N"    TO SAVE-PDER-SW
                          SAVE-PDER-USERID.

           MOVE "PDER" TO PLT-ARG.
           MOVE PLT-ARG TO PLTINFOKEY OF MPLTINFO-REC.
           READ MPLTINFO INTO BUF-MPLTINFO
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE "DBGET MPLTINFO 1-HSK PDER"  TO  BU-DISPLAY-MSG
               MOVE PLT-ARG            TO BU-DISPLAY-FLD (1)
               GO TO 2-BLOWUP.
           MOVE MPLTINFO-PDER-SW  TO SAVE-PDER-SW.
           MOVE MPLTINFO-PDER-USERID TO SAVE-PDER-USERID.

           MOVE "PREQ" TO  PLTINFOKEY OF MPLTINFO-REC.
           READ MPLTINFO INTO BUF-MPLTINFO
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
094700         MOVE "DBGET MPLTINFO 1-HSK PREQ"  TO  BU-DISPLAY-MSG
094800         MOVE PLT-ARG            TO BU-DISPLAY-FLD (1)
094900         GO TO 2-BLOWUP.
           IF MPLTINFO-AUTH-FLAG-SW = "Y"
               MOVE MPLTINFO-AUTH-FLAG-SW TO SAVE-PREQ-AUTH-SW
               IF MPLTINFO-AUTH-EXP NOT = "      "
                   MOVE MPLTINFO-AUTH-EXP TO SAVE-AUTH-EXP
               ELSE
               MOVE "      "              TO SAVE-AUTH-EXP
           ELSE
           MOVE "      "                  TO SAVE-AUTH-EXP.

093600**************************************************
093700*                                                *
093800*   GET CO. AND PRIME FROM MPLTINFO              *
093900*   USING 'P 01' AS THE ARGUMENT                 *
094000*                                                *
094100**************************************************
094200     MOVE SPACES                  TO  SREQPRNT-PARMS.
094300     MOVE "P 01"                  TO  PLT-ARG.
           MOVE PLT-ARG TO PLTINFOKEY OF MPLTINFO-REC.
           READ MPLTINFO INTO BUF-MPLTINFO
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
094700         MOVE "DBGET MPLTINFO 1-HSK P 01"  TO  BU-DISPLAY-MSG
094800         MOVE PLT-ARG            TO BU-DISPLAY-FLD (1)
094900         GO TO 2-BLOWUP.
095000     MOVE MPLTINFO-COMPANY   TO  COMPANY-SAVE, COMP-SCREEN-INDIC,
095100                                 REQ-COMPANY-SAVE.
095200
095300**************************************************
095400*                                                *
095500*   GET REQUISITION AND PO PRINTER NUM FROM      *
095600*   MPLTINFO USING 'POPT' AS THE ARGUMENT        *
095700*                                                *
095800**************************************************
095900
096000     MOVE "POPT"  TO  PLT-ARG.
           MOVE PLT-ARG TO PLTINFOKEY OF MPLTINFO-REC.
           READ MPLTINFO INTO BUF-MPLTINFO
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
096400         MOVE "DBGET MPLTINFO 1-HSK POPT"  TO  BU-DISPLAY-MSG
096500         MOVE PLT-ARG            TO BU-DISPLAY-FLD (1)
096600         GO TO 2-BLOWUP
096700     ELSE
               IF MPLTINFO-SHIP-REL-PRT-NO NOT = SPACES
036600             MOVE MPLTINFO-SHIP-REL-PRT-NO TO SAVE-PO-PRT-NUM
               ELSE
      *------------- UPDATE SHIP REL PRINTER IF NOT DEFINED
                   MOVE MPLTINFO-PO-PRT-NO TO SAVE-PO-PRT-NUM
                                              MPLTINFO-SHIP-REL-PRT-NO
                   CLOSE MPLTINFO
                   OPEN I-O MPLTINFO
035500             MOVE "POPT"                  TO  PLT-ARG
                   MOVE PLT-ARG TO PLTINFOKEY OF MPLTINFO-REC
                   READ MPLTINFO
                       INVALID KEY MOVE FILE-STATUS TO FILE-STATUS
                   END-READ
                   REWRITE MPLTINFO-REC FROM BUF-MPLTINFO
                       INVALID KEY MOVE FILE-STATUS TO FILE-STATUS
                   END-REWRITE
                   CLOSE MPLTINFO
                   OPEN INPUT MPLTINFO
               END-IF
096800         MOVE MPLTINFO-REQ-PRT-NO  TO  SAVE-REQ-PRT
               MOVE MPLTINFO-PO-PRT-NO   TO  SAVE-PO-PRT-NUM
097000         MOVE MPLTINFO-ADDTL-DATA-EDIT-SW
097100                                   TO  EDIT-ADDTL-DATA-SW.
097200
