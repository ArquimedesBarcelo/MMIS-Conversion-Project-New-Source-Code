DCR01
           ACCEPT CUR-DATE          FROM DATE.
           MOVE CUR-DATE            TO  REQ-REL-MC-DATE.
           IF YY OF CUR-DATE > "70"
               MOVE "19" TO REQ-REL-MC-DATE-CC
           ELSE
               MOVE "20" TO REQ-REL-MC-DATE-CC.
           MOVE SAVE-REQ-DATE-WANT-YMD  TO  REQ-DATE-WANTED.
           IF REQ-DATE-WANTED = SPACES
               NEXT SENTENCE
           ELSE
           IF REQ-DATE-WANT-YY > "70"
               MOVE "19" TO REQ-DATE-WANT-CC
           ELSE
               MOVE "20" TO REQ-DATE-WANT-CC.
           MOVE SPACES              TO  REQ-HOLD-STATUS-CODE,
                                        REQ-HOLD-STATUS.
290000     MOVE TRM-REQ-CO          TO  REQ-CO.
290100     MOVE TRM-REQ-PRIME       TO  REQ-PRIME.
290200     MOVE TRM-REQ-SUB         TO  REQ-SUB.
290300     MOVE TRM-REQ-SUBD        TO  REQ-SUBD.
290400     MOVE TRM-REQ-ADDTL-DATA  TO  REQ-ADDTL-DATA.
290500     MOVE TRM-REPAIR-HEADER   TO  REQ-REPAIR-INDIC.
      *------REQUEST TO ADD DOCK NOTIFY USERID FROM MA2
           MOVE TRM-DOCK-NOTIFY     TO  REQ-DOCK-NOTIFY.
      *    MOVE SAVE-AUTH-FLAG      TO  REQ-AUTH-CODE-FLAG.
           IF SAVE-AUTH-FLAG = "X"
               IF TRM-AUTH-FLAG = " "
                   MOVE " "         TO  REQ-AUTH-CODE-FLAG,
                                        SAVE-AUTH-FLAG
                   MOVE "    "      TO  REQ-AUTH-APPVL-DEPT
               ELSE
               MOVE SAVE-AUTH-FLAG  TO  REQ-AUTH-CODE-FLAG
               IF REQ-ORIGINATOR = "    "
                   MOVE 9999        TO  REQ-ORIGINATOR
                   MOVE STR-DFLT-DEPT TO REQ-AUTH-APPVL-DEPT
                   IF TRM-REQ-SUBD NOT = SAVE-REQ-SUBD
                       MOVE TRM-REQ-SUBD TO REQ-AUTH-APPVL-DEPT
                   ELSE
                   NEXT SENTENCE
               ELSE
               IF TRM-REQ-SUBD NOT = SAVE-REQ-SUBD
                   MOVE TRM-REQ-SUBD TO REQ-AUTH-APPVL-DEPT
               ELSE
               NEXT SENTENCE
           ELSE
           IF TRM-AUTH-FLAG = "X"
               IF REQ-ORIGINATOR = "    "
                   MOVE 9999        TO  REQ-ORIGINATOR
                   MOVE "X"         TO  REQ-AUTH-CODE-FLAG
                                        SAVE-AUTH-FLAG
                   IF TRM-REQ-SUBD = SAVE-STRMDEPT
                       IF SAVE-DFLT-DEPT = "      "
                           MOVE TRM-REQ-SUBD TO REQ-AUTH-APPVL-DEPT
                       ELSE
                       MOVE SAVE-DFLT-DEPT TO REQ-AUTH-APPVL-DEPT
                   ELSE
                   MOVE TRM-REQ-SUBD TO REQ-AUTH-APPVL-DEPT
               ELSE
               MOVE "X"             TO  REQ-AUTH-CODE-FLAG,
                                        SAVE-AUTH-FLAG
               IF TRM-REQ-SUBD = SAVE-STRMDEPT
                   IF SAVE-DFLT-DEPT = "      "
                       MOVE TRM-REQ-SUBD TO REQ-AUTH-APPVL-DEPT
                   ELSE
                   MOVE SAVE-DFLT-DEPT TO REQ-AUTH-APPVL-DEPT
               ELSE
               MOVE TRM-REQ-SUBD    TO  REQ-AUTH-APPVL-DEPT.
           IF REQ-AUTH-CODE-FLAG = "X"
               IF REQ-APPROVALS-LEFT = "  "
                   MOVE "X"         TO  REQ-MATCONT-RELEASE
               ELSE
               IF REQ-APPROVALS-LEFT-9 > 0
                   MOVE " "         TO  REQ-MATCONT-RELEASE
               ELSE
               MOVE "X"             TO  REQ-MATCONT-RELEASE
           ELSE
