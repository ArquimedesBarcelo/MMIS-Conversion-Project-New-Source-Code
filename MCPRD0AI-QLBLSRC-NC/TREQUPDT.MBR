           READ DREQDESC-O NEXT INTO BUF-DREQDESC
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14"
                   GO TO 641-FIND-DREQQUE
               ELSE
331100             MOVE "GET DREQDESC *641-GD" TO BU-DISPLAY-MSG
331200             GO TO 2-BLOWUP.
           IF REQNO OF DREQDESC-REC-O NOT = REQ-ARG
               GO TO 641-FIND-DREQQUE.
