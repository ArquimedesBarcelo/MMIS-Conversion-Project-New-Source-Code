325300*   WRITE OF THE REQ. SCREEN                     *
325400*                                                *
325500**************************************************
325600
           DELETE DREQITM-O
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
326000         MOVE "DBDELETE DREQITM *641-CR"  TO  BU-DISPLAY-MSG
326100         GO TO 2-BLOWUP.
326200
326300**************************************************
326400*                                                *
326500*   FIND AND GET DREQD IF IT EXIST THEN DELETE   *
326600*   DREQD                                        *
326700*                                                *
326800**************************************************
326900
           MOVE REQ-ARG TO REQNO OF DREQD-REC-O.
           START DREQD-O KEY = REQNO OF DREQD-REC-O
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
                   GO TO 641-FIND-DREQDESC
               ELSE
327300             MOVE "FIND DREQD *641-CR" TO BU-DISPLAY-MSG
327400             GO TO 2-BLOWUP.
           READ DREQD-O NEXT INTO BUF-DREQD
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14"
                   GO TO 641-FIND-DREQDESC
               ELSE
328100             MOVE "GET DREQD *641-CR" TO BU-DISPLAY-MSG
328200             GO TO 2-BLOWUP.
           IF REQNO OF DREQD-REC-O NOT = REQ-ARG
      *------- DO A START > HIGH-VALUES TO UNLOCK
               MOVE HIGH-VALUES TO REQNO OF DREQD-REC-O
               START DREQD-O KEY > REQNO OF DREQD-REC-O
                   INVALID KEY MOVE "00" TO FILE-STATUS END-START
               GO TO 641-FIND-DREQDESC.
328300
328400 641-DELETE-DREQD.
           DELETE DREQD-O
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
328800         MOVE "DELETE DREQD *641-DD"  TO  BU-DISPLAY-MSG
328900         GO TO 2-BLOWUP.
