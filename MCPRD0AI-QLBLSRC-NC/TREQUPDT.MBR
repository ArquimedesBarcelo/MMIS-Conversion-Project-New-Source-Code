               IF FILE-STATUS-1 = "2"
                   GO TO 641-FIND-DREQQUE
               ELSE
330100             MOVE "FIND DREQDESC *641-FD" TO BU-DISPLAY-MSG
330200             GO TO 2-BLOWUP.
