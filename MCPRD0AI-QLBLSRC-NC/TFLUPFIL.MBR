000200 IDENTIFICATION DIVISION.
000300 PROGRAM-ID.     TFLUPFIL.
000400 AUTHOR.         KURT MOVSESIAN/JIM COFFMAN (MAINTAINER).
000500 DATE-WRITTEN.   APRIL 24, 1987.
000700
000800**************************************************************
000900**                                                          **
001000**   T F L U P F I L - PURCHASING FOLLOWUP FILE CREATE      **
001100**                                                          **
001200**   THIS PROGRAM CREATES A FILE OF ALL POs PAST A CERTAIN  **
001300**   NO. OF DAYS SINCE THE LAST FOLLOWUP DATE OR IF NO      **
001400**   FOLLOWUP DATE IS FOUND PAST A CERTAIN NO. OF DAYS      **
001500**   PAST EXPECTED DELIVERY DATE.  A FILE IS CREATED THAT   **
001600**   SHOWS PO NUMBER AND VENDOR CODE.  THIS FILE IS CREATED **
001700**   BY BUYER CODE AND BUYER CODE IS THE LAST 4 DIGITS OF   **
001800**   THE FILE NAME 'DPOBnnnn'  WHERE 'nnnn' IS THE BUYER    **
001900**   CODE WITH NO EMBEDDED SPACES.  THIS FILE WILL BE USED  **
002000**   BY THE BUYER AS INPUT INTO AN ONLINE PROGRAM THAT WILL **
002100**   CREATE PURCHASE ORDER FOLLOWUP DOCUMENTS TO BE MAILED  **
002200**   TO THE VENDOR.                                         **
002300**                                                          **
002400**************************************************************
      *C
      *C   MARCH 1995  JE COFFMAN
      *C   ADDED CHANGE REQUESTED BY MARILYN DOGGETT IN NAPANEE
      *C   TO CHECK TO SEE IF BOTH THE BUYER CODE AND THE VENDOR
      *C   CODE WERE SELECTED TO SCREEN THE P.O'S. THE OLD LOGIC
      *C   IGNORED THE BUYER CODE SELECTIVITY IF THE VENDOR CODE
      *C   WAS ENTERED.
      *C
      *C   09/11/96  JEFF BUNGO
      *C   EXPAND DATE FIELDS FOR YEAR 2000 COMPLIANCE.
      *C   INCLUDE CENTURY ON FOLLOWUP DATE AND EXPECT DATE
      *C   AND ON THE COMPARES.  ALSO CHANGE JULIAN AND GREGORIAN
      *C   DATE CHANGES TO USE JULGREG PROGRAM.
      *C
002500
002600 ENVIRONMENT DIVISION.
002700 CONFIGURATION SECTION.
002800 SOURCE-COMPUTER.
002900 OBJECT-COMPUTER.
003000 INPUT-OUTPUT SECTION.
003100 FILE-CONTROL.
003200     SELECT PO-FILE ASSIGN TO DATABASE-DPOBUYER.
003300     SELECT SORT-FILE ASSIGN TO DISK-SORT.

           SELECT DPORECD-I
                  ASSIGN TO DATABASE-MCFLCS0902
                  ORGANIZATION IS INDEXED
                    ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                    WITH DUPLICATES
                  FILE STATUS IS FILE-STATUS.

           SELECT DPOITEM-I
                  ASSIGN TO DATABASE-MCFLCS1002
                  ORGANIZATION IS INDEXED
                    ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                    WITH DUPLICATES
                  FILE STATUS IS FILE-STATUS.

           SELECT MPLTINFO-I
                  ASSIGN TO DATABASE-MCFLCS0501
                  ORGANIZATION IS INDEXED
                    ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                  FILE STATUS IS FILE-STATUS.
003400
003500 DATA DIVISION.
003600 FILE SECTION.
003700 FD  PO-FILE
003800     LABEL RECORDS ARE OMITTED
003900     RECORD CONTAINS 24 CHARACTERS
004000     DATA RECORD IS PO-REC.
004100 01  PO-REC.
004200     05  POFILE-PO-NUMBER         PIC X(14).
004300     05  POFILE-VEN-CODE          PIC X(10).
004400
004500 SD  SORT-FILE
004600     RECORD CONTAINS 24 CHARACTERS
004700     DATA RECORD IS SORT-REC.
004800 01  SORT-REC.
004900     05  SORT-PO-NUMBER           PIC X(14).
005000     05  SORT-VENDOR-CODE         PIC X(10).
005100
       FD  DPORECD-I
           LABEL RECORDS ARE STANDARD.
       01  DPORECD-REC-I.
           COPY DDS-ALL-FORMATS  OF MCFLCS0902.

       FD  DPOITEM-I
           LABEL RECORDS ARE STANDARD.
       01  DPOITEM-REC-I.
           COPY DDS-ALL-FORMATS  OF MCFLCS1002.

       FD  MPLTINFO-I
           LABEL RECORDS ARE STANDARD.
       01  MPLTINFO-REC-I.
           COPY DDS-ALL-FORMATS  OF MCFLCS0501.

005200 WORKING-STORAGE SECTION.
       01  FILE-STATUS.
           05  FILE-STATUS-1            PIC X  VALUE "0".
           05  FILE-STATUS-2            PIC X  VALUE "0".
005300 77  TODAYS-JULIAN                PIC S9(4) COMP-4 VALUE ZEROS.
005400 77  COMPANY-SAVE                 PIC X(3)       VALUE SPACES.
005500 77  PO-OPEN-SW                   PIC X(1)       VALUE SPACES.
       77  EOF-SW                       PIC X(1)       VALUE SPACES.
005600
006200
006300 01  DATES-AND-TIMES.
           05  CUR-DATE-CN.
               10  CC               PIC XX.
006400         10  CUR-DATE.
006500             15  YY           PIC XX.
006600             15  MM           PIC XX.
006700             15  DD           PIC XX.
007200
007300 COPY TDATECHK IN COPYLIB.
007400
       01  EXP-DATE-CN.
           05  CC-EXP-DATE      PIC 99.
007500     05  EXP-DATE.
007600         10  YY-EXP-DATE      PIC 99.
007700         10  MM-EXP-DATE      PIC 99.
007800         10  DD-EXP-DATE      PIC 99.
007900
       01  FLUP-DATE-CN.
           05  CC-FLUP-DATE     PIC 99.
008000     05  FLUP-DATE.
008100         10  YY-FLUP-DATE     PIC 99.
008200         10  MM-FLUP-DATE     PIC 99.
008300         10  DD-FLUP-DATE     PIC 99.

       01  GREGDATE                 PIC X(8).
       01  JULDATE.
           05  JULYEAR              PIC 9(4).
           05  JULDAY               PIC 9(3).
       01  DAYDIGIT                 PIC X.
       01  LEAPYEAR                 PIC X.
008400
009100
       COPY CCRTFILE IN COPYLIB.

       01  OVRDBF-PARM1  PIC X(70) VALUE SPACES.
       01  OVRDBF-PARM2  PIC S9(10)V9(5) COMP-3 VALUE 70.

009200
009300**************************************************************
009400**
009500**        DATABASE I/O WORK AREA
009600**
009700**************************************************************
009800
009900 COPY DPORECD IN COPYLIB.
010000
010100 COPY DPOITEM IN COPYLIB.
010200
010300 COPY MPLT0 IN COPYLIB.
010400
010500 COPY MPLTP01 IN COPYLIB.
010600
010700 COPY DATAB IN COPYLIB.
012600
012700 01 ARG-VALUES.
012800     05  PLT-ARG                  PIC X(4)  VALUE SPACES.
012900     05  PO-ARG                   PIC X(14) VALUE SPACES.
013000     05  VEN-ARG                  PIC X(10) VALUE SPACES.
013100
013200
013300 COPY TBLOWUP IN COPYLIB.
013400
013500 COPY LANGUAGE IN COPYLIB.
013600
       LINKAGE SECTION.

       01  PARM1.
002300     05  STRM-ROUTE-DATA.                                         STRMJOB
002400         10  STRM-RT-NAME          PIC X(15).                     STRMJOB
002500         10  STRM-RT-DEPT          PIC X(4).                      STRMJOB
002600         10  STRM-RT-LP            PIC 9(3).                      STRMJOB
002700         10  STRM-RT-USER          PIC X(8).                      STRMJOB
002800         10  STRM-RT-ACCOUNT       PIC X(8).                      STRMJOB
002900         10  STRM-RT-GROUP         PIC X(8).                      STRMJOB
003000         10  STRM-RT-TERM          PIC X(4).                      STRMJOB
003100         10  STRM-RT-PAPER-FLAG    PIC X(1).                      STRMJOB
003200         10  STRM-RT-PRTRPT-FLAG   PIC X(1).                      STRMJOB
003300         10  STRM-RT-NO-OF-COPIES  PIC 9(2).                      STRMJOB
003400         10  FILLER                PIC X(26).                     STRMJOB
       01  PARM2.
005700     05  BUYER-CODE-SEL.
005800         10  SEL-BUYER-CODE           PIC X(4).
005900         10  DAYS-PAST-EXP-DATE       PIC 9(2).
006000         10  DAYS-PAST-FLUP-DATE      PIC 9(2).
006100         10  SEL-VENDOR-CODE          PIC X(10).
014700         10  BUYER-FILE-NAME.
014800             15  FILLER               PIC X(4).
014900             15  BUYER-CODE-PART      PIC X(4).
               10  FILLER                   PIC X(52).
           05  FILLER               PIC X(81).

011800 PROCEDURE DIVISION USING PARM1,
                                PARM2.

013800 0-BEGIN.
013900     PERFORM  1-HSK  THRU  1-HSK-X.
014000     PERFORM  6-MAIN  THRU  6-MAIN-X.
014100     PERFORM  2-CLOSE-FILES  THRU  2-CLOSE-FILES-X.
014200
014300     GOBACK.
014400
014500
014600 1-HSK.
           OPEN INPUT MPLTINFO-I, DPORECD-I, DPOITEM-I.

           MOVE "P 01"  TO PLT-ARG.
           MOVE PLT-ARG TO PLTINFOKEY OF MPLTINFO-REC-I.
           READ MPLTINFO-I INTO BUF-MPLTINFO
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
016600         MOVE "DBGET MPLTINFO*1-HSK"  TO  BU-DISPLAY-MSG
016700         GO TO  2-BLOWUP
           ELSE
016400         MOVE MPLTINFO-COMPANY  TO  COMPANY-SAVE.
016800
016900 1-HSK-X.
017000     EXIT.
017100
017200
017300 2-CLOSE-FILES.
           CLOSE MPLTINFO-I, DPORECD-I, DPOITEM-I.
018100
018200 2-CLOSE-FILES-X.
018300     EXIT.
018400
018500
018600******************************************************
018700**                                                  **
018800**   BLOWUP ROUTINE                                 **
018900**                                                  **
019000******************************************************
019100
019200 2-BLOWUP.
019300     MOVE "TFLUPFIL"              TO  BU-PGM-NAME.
019400     CALL "TBLOWUP" USING BASE, BU-PGM-NAME, STATUS-AREA,
019500         DUMMY-VIEW-AREA, FILE-STATUS, BU-DISPLAY-MSG,
019600             BU-DISPLAY-FLDS.
019700
019800
019900
020000 6-MAIN.
      *----- CALL CCRTFILE TO CREATE A BUYER CODE FILE 'DPOBNNNN'
           MOVE SPACES        TO CCRTFILE-PARMS.
           MOVE BUYER-FILE-NAME TO CCRTFILE-FILE.
           MOVE "0024"        TO CCRTFILE-RECORD-LENGTH.
           MOVE "05000"       TO CCRTFILE-NO-RECORDS.
           MOVE "02000"       TO CCRTFILE-INCREMENT-AMT.
           MOVE "20"          TO CCRTFILE-NO-INCREMENTS.
           CALL "CCRTFILE" USING CCRTFILE-LIBRARY,
                                 CCRTFILE-FILE,
                                 CCRTFILE-RECORD-LENGTH,
                                 CCRTFILE-NO-RECORDS,
                                 CCRTFILE-INCREMENT-AMT,
                                 CCRTFILE-NO-INCREMENTS,
                                 CCRTFILE-STATUS.
           IF CCRTFILE-STATUS NOT = "00"
               MOVE "CCRTFILE CREATE OF 'DPOBNNNN' FAILED"
                  TO BU-DISPLAY-MSG
               MOVE BUYER-FILE-NAME   TO BU-DISPLAY-FLD (1)
               MOVE CCRTFILE-STATUS   TO BU-DISPLAY-FLD (2)
               GO TO 2-BLOWUP.

      *----- OVERRIDE 'DPOBFILE' TO BUYER FILE 'DPOBNNNN'
      *----- REPLACES FILE STATEMENT 'FILE DPOBUYER=DPOBNNNN'
           STRING "OVRDBF FILE(DPOBUYER) TOFILE("
                  BUYER-FILE-NAME ")"
               DELIMITED BY SIZE  INTO OVRDBF-PARM1.
           CALL "QCMDEXC" USING OVRDBF-PARM1, OVRDBF-PARM2.

020300     OPEN OUTPUT PO-FILE.
020400     PERFORM 61-GET-OPEN-POS  THRU  61-GOP-X.
020500     CLOSE PO-FILE.
020600
020700     SORT SORT-FILE ON ASCENDING KEY SORT-VENDOR-CODE,
020800                                     SORT-PO-NUMBER
020900         USING PO-FILE
021000         GIVING PO-FILE.
021100
021200 6-MAIN-X.
021300     EXIT.
021400
023000
023100 61-GET-OPEN-POS.
023200     MOVE 1                       TO  DATE-MODE.
023300     CALL "TDATECHK" USING DATE-CHECK-AREA.
023400     MOVE DATE-YMD-OUT            TO  CUR-DATE.
           IF YY > "70"
               MOVE "19" TO CC
           ELSE
               MOVE "20" TO CC.
023500
023600******************************************
023700**   CALCULATE CALENDER DATE FOR THE
023800**   EXPECTED DELIVERY DATE CUTOFF
023900******************************************
024000
           MOVE CUR-DATE-CN TO GREGDATE.
           MOVE SPACES TO JULDATE.
           CALL "JULGREG" USING GREGDATE JULDATE DAYDIGIT LEAPYEAR.
           MOVE JULDAY TO TODAYS-JULIAN.

025100     IF TODAYS-JULIAN > DAYS-PAST-EXP-DATE
025200         NEXT SENTENCE
025300     ELSE
025400         ADD  365         TO  TODAYS-JULIAN
025500         SUBTRACT 1       FROM JULYEAR.
025600
025700     SUBTRACT DAYS-PAST-EXP-DATE  FROM  TODAYS-JULIAN.
025800     MOVE TODAYS-JULIAN           TO    JULDAY.
           MOVE SPACES TO GREGDATE.
           CALL "JULGREG" USING GREGDATE JULDATE DAYDIGIT LEAPYEAR.
           MOVE GREGDATE TO EXP-DATE-CN.
026500     DISPLAY "EXPECTED DELIVERY DATE CUTOFF=", EXP-DATE-CN.
026600
026700******************************************
026800**   CALCULATE CALENDER DATE FOR THE
026900**   FOLLOWUP DATE CUTOFF
027000******************************************
027100
           MOVE CUR-DATE-CN  TO GREGDATE.
           MOVE SPACES TO JULDATE.
           CALL "JULGREG" USING GREGDATE JULDATE DAYDIGIT LEAPYEAR.
028000     MOVE JULDAY            TO  TODAYS-JULIAN.
028100
028200     IF TODAYS-JULIAN > DAYS-PAST-FLUP-DATE
028300         NEXT SENTENCE
028400     ELSE
028500         ADD  365         TO  TODAYS-JULIAN
028600         SUBTRACT 1       FROM JULYEAR.
028700
028800     SUBTRACT DAYS-PAST-FLUP-DATE FROM  TODAYS-JULIAN.
028900     MOVE TODAYS-JULIAN           TO    JULDAY.
           MOVE SPACES TO GREGDATE.
           CALL "JULGREG" USING GREGDATE JULDATE DAYDIGIT LEAPYEAR.
           MOVE GREGDATE TO FLUP-DATE-CN.
029600     DISPLAY "FOLLOWUP DATE CUTOFF=", FLUP-DATE-CN.
029700     DISPLAY "VENDOR-CODE=", SEL-VENDOR-CODE.
029800
029900***************************************************************
030000*    IF VENDOR CODE IS SELECTED THEN DO A DBFIND ON DPORECD   *
030100*    SINCE I AM GOING TO DO A CHAIN READ OF 'DPORECD' BY      *
030200*    VENDOR CODE (MODE5) NOT A SEQUENTIAL READ (MODE2)        *
030300***************************************************************
030400
030500     IF SEL-VENDOR-CODE NOT = SPACES
               PERFORM 612-READ-BY-VENDOR THRU 612-RBV-X
               IF EOF-SW = "Y"
                   GO TO 61-GOP-X
               ELSE
                   NEXT SENTENCE
           ELSE
               PERFORM 613-READ-FIRST THRU 613-RF-X
               IF EOF-SW = "Y"
                   GO TO 61-GOP-X.

040200 61-CHECK-IF-PO-OPEN.
034700**********************************************************
034800*    IF THE PO IS A REQUIREMENT ORDER OR A NON-RECEIVABLE
034900*    THEN SKIP THE ORDER
035000**********************************************************
035100
035200     IF PO-RLS-NO = "999"  OR
035300        PO-NON-RCV-INDIC = "X"
035400         GO TO 61-GET-DPORECD.
035500
035600**********************************************************
035700*   CHECK THE BUYER CODE OF THE ORDER WITH THE BUYER CODE
035800*   SELECTED. IF ITS A MATCH CONTINUE OTHERWISE READ THE
035900*   NEXT ORDER.  IF THE BUYER CODE ENTERED IS '    ' THEN
036000*   THE USER REQUESTED A BUYER CODE OF SPACES SINCE
036100*   BUYER CODE WAS NOT ALWAYS A REQUIRED FIELD AND SOME
036200*   OLD ORDERS MAY NOT HAVE BUYER CODES
036500**********************************************************
036600
036700     IF SEL-VENDOR-CODE  NOT = SPACES
               IF SEL-BUYER-CODE = SPACES
                   NEXT SENTENCE
               ELSE
               IF SEL-BUYER-CODE = PO-BUYER-CODE
                   NEXT SENTENCE
               ELSE
036800         GO TO 61-GET-DPORECD
036900     ELSE
037000     IF SEL-BUYER-CODE = PO-BUYER-CODE
037100         NEXT SENTENCE
037200     ELSE
037300     GO TO 61-GET-DPORECD.
037400
037500*******************************************************
037600*    IF THE PO HAS A FOLLOW-UP DATE THEN COMPARE IT
037700*    TO THE FOLLOW-UP DATE CUTOFF IF IT QUALIFIES
037800*    WRITE IT TO THE FILE
037900*******************************************************
038000
038100     IF PO-FOLLOWUP-DATE = SPACES
038200         NEXT SENTENCE
038300     ELSE
038400         IF PO-FOLLOWUP-DATE-CN < FLUP-DATE-CN
038500             GO TO 61-CHECK-PO-ITEMS
038600         ELSE
038700             GO TO 61-GET-DPORECD.
038800
038900****************************************************
039000*    IF NO FOLLOWUP DATE USE EXPECTED DELIVERY
039100*    IF NO EXPECTED DELIVERY DATE THEN SKIP ORDER
039200****************************************************
039300
039400     IF PO-EXPECT-DATE = SPACES
039500         GO TO 61-GET-DPORECD
039600     ELSE
039700         IF PO-EXPECT-DATE-CN < EXP-DATE-CN
039800             NEXT SENTENCE
039900         ELSE
040000             GO TO 61-GET-DPORECD.
040100
       61-CHECK-PO-ITEMS.
040300     PERFORM 611-CHECK-PO-ITEMS  THRU  611-CPI-X.
040400     IF PO-OPEN-SW = "Y"
040500         NEXT SENTENCE
040600     ELSE
040700         GO TO 61-GET-DPORECD.
040800
040900     MOVE PO-RCV-NO               TO  POFILE-PO-NUMBER.
041000     MOVE PO-VEN-CODE             TO  POFILE-VEN-CODE.
041100     WRITE PO-REC.

031700 61-GET-DPORECD.
031800**************************************************************
031900*    I DO A SERIAL READ (MODE2) ON THE DPORECD DATASET       *
032000*    IF THE VENDOR CODE OPTION IS NOT SELECTED (VENDOR CODE  *
032100*    EQUALS SPACES).  IF THE VENDOR CODE OPTION IS SELECTED  *
032200*    THEN DO A CHAINED READ (MODE5) ON DPORECD BY VENDOR     *
032300*    CODE SELECTED.                                          *
032400**************************************************************
032500
           READ DPORECD-I NEXT INTO BUF-DPORECD
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14"
                   GO TO 61-GOP-X
               ELSE
                   MOVE "READ NEXT DPORECD *61-GD" TO BU-DISPLAY-MSG
                   GO TO 2-BLOWUP.

032600     IF SEL-VENDOR-CODE NOT = SPACES
               IF VENCDE OF DPORECD-REC-I NOT = VEN-ARG
                   GO TO 61-GOP-X.
033200
041200     GO TO 61-CHECK-IF-PO-OPEN.
041300
041400 61-GOP-X.
041500     EXIT.
041600
041700
041800 611-CHECK-PO-ITEMS.
041900     MOVE "N"                     TO  PO-OPEN-SW.
042000     MOVE PO-RCV-NO               TO  PO-ARG,
042100                                      BU-DISPLAY-FLD (1).
           MOVE PO-ARG TO PORCVNO OF DPOITEM-REC-I.
           START DPOITEM-I KEY = PORCVNO OF DPOITEM-REC-I
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
                   GO TO 611-CPI-X
               ELSE
042500             MOVE "FIND DPOITEM*611-CPI" TO BU-DISPLAY-MSG
042600             GO TO 2-BLOWUP.
042700
042800 611-GET-DPOITEM.
           READ DPOITEM-I NEXT INTO BUF-DPOITEM
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14"
                   GO TO 611-CPI-X
               ELSE
043500             MOVE "GET DPOITEM *611-GD" TO BU-DISPLAY-MSG
043600             GO TO 2-BLOWUP.
           IF PORCVNO OF DPOITEM-REC-I NOT = PO-ARG
               GO TO 611-CPI-X.
043700
043800     IF ITM-COMPLETE-FLAG NOT = SPACES
043900         GO TO 611-GET-DPOITEM
044000     ELSE
044100         IF ITM-QTY-DLVR  <  ITM-QTY-ORD
044200             MOVE "Y"             TO  PO-OPEN-SW
044300         ELSE
044400             GO TO 611-GET-DPOITEM.
044500
044600 611-CPI-X.
044700     EXIT.

       612-READ-BY-VENDOR.
           MOVE SPACES TO EOF-SW.
030600     MOVE SEL-VENDOR-CODE     TO VEN-ARG
           MOVE VEN-ARG TO VENCDE OF DPORECD-REC-I
           START DPORECD-I KEY = VENCDE OF DPORECD-REC-I
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
                   MOVE "Y" TO EOF-SW
031100             GO TO 612-RBV-X
031200         ELSE
031300             MOVE "FIND DPORECD *612-RBV" TO BU-DISPLAY-MSG
031400             MOVE VEN-ARG     TO BU-DISPLAY-FLD (1)
031500             GO TO 2-BLOWUP.

           READ DPORECD-I NEXT INTO BUF-DPORECD
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14"
                   MOVE "Y" TO EOF-SW
               ELSE
                   MOVE "READ DPORECD *612-RBV" TO BU-DISPLAY-MSG
                   GO TO 2-BLOWUP
           ELSE
           IF VENCDE OF DPORECD-REC-I NOT = VEN-ARG
               MOVE "Y" TO EOF-SW.

       612-RBV-X.
           EXIT.

       613-READ-FIRST.
           MOVE SPACES TO EOF-SW.
           READ DPORECD-I FIRST INTO BUF-DPORECD
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "1"
                   MOVE "Y" TO EOF-SW
               ELSE
                   MOVE "READ FIRST DPORECD *613-RF" TO BU-DISPLAY-MSG
                   GO TO 2-BLOWUP.

       613-RF-X.
           EXIT.
