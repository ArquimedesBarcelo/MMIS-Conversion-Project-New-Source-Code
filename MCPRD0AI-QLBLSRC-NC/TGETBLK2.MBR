000200 IDENTIFICATION DIVISION.
000300 PROGRAM-ID.    TGETBLK2.
000500 AUTHOR.        KURT MOVSESIAN/JIM COFFMAN (MAINTAINER).
000800
000900******************************************************
001000*                                                    *
001100*   T G E T B L K 2                                  *
001200*                                                    *
001300*   THIS SUBROUTINE SHOWS UP TO 7 REQUIREMENT ORDERS *
001400*   THAT CAN BE SELECTED FOR CUTTING A SHIPPING      *
001500*   RELEASE AS LONG AS THE REQUIREMENT ORDER HAS     *
001600*   NOT EXPIRED.  REQUIREMENT ORDERS                 *
001700*   ARE IDENTIFIED BY '999' IN THE RLSE FIELD OF THE *
001800*   P.O. NUMBER                                      *
001900*                                                    *
002000******************************************************
002100
      *C
      *C   MAY  1996    JE COFFMAN
      *C   ADDED LOGIC TO CHECK TO SEE IF THE MATERIAL CONTROL PERSON
      *C   SELECTED THE LEAST EXPENSIVE ITEM FROM HIS LIST OF REQUIREMENT
      *C   ORDERS. THE PROGRAM WILL FORCE THE MATERIAL CONTROL PERSON TO
      *C   HIT THE 'F1' KEY TO PROCESS HIS SELECTION, OR THE 'F2' KEY
      *C   TO GO BACK AND MAKE THE LEAST EXPENSIVE CHOICE. THIS REQUEST
      *C   WAS MADE BY JIM USREY IN UNION CITY.
      *C
      *C   06/18/1996   CA YODER
      *C   MODIFIED FOR CENTURY DATABASE CHANGES.
      *C
      *C   NOV 1997     JE COFFMAN
      *C   ADDED LOGIC TO HANDLE A SITUATION WHERE LAWTON HAD MORE THAN
      *C   12 REQUIREMENT ORDERS FOR A SINGLE CODE AND THERE WAS NO WAY
      *C   FOR THEM TO VIEW OR SELECT THEM.
      *C
      *C   01/05/00     CA YODER
      *C   ADDED LOGIC TO HIDE CERTAIN COLUMNS & FIELDS ON SCREEN FOR
      *C   AKRON PLANTS.  THEY WERE NOT NECESSARY FOR THE MA2 SELECTION
      *C   SCREEN FOR CHOOSING REQUIREMENT ORDERS FOR SENDING RELEASES
      *C   TO CORP. PURCHASING.
      *C
003700
003800 ENVIRONMENT DIVISION.
003900 CONFIGURATION SECTION.
004000 SOURCE-COMPUTER.  HP-3000.
004100 OBJECT-COMPUTER.  HP-3000.
       SPECIAL-NAMES.  I-O-FEEDBACK IS I-O-FEEDBACK-AREA.
012800
012900 INPUT-OUTPUT SECTION.
       FILE-CONTROL.

           SELECT DISPLAY-FILE
                  ASSIGN TO WORKSTATION-ZRELMAN-SI
                  ORGANIZATION IS TRANSACTION
                  ACCESS IS SEQUENTIAL
                  FILE STATUS IS DISPLAY-STATUS
                  CONTROL-AREA IS WS-CONTROL.

           SELECT DPORECD-I
                  ASSIGN TO DATABASE-MCFLCS0901
                  ORGANIZATION IS INDEXED
                    ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                    WITH DUPLICATES
                  FILE STATUS IS FILE-STATUS.

           SELECT DPOITEM-I
                  ASSIGN TO DATABASE-MCFLCS1001
                  ORGANIZATION IS INDEXED
                    ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                    WITH DUPLICATES
                  FILE STATUS IS FILE-STATUS.

       DATA DIVISION.
       FILE SECTION.
       FD  DISPLAY-FILE
           LABEL RECORDS ARE OMITTED.
       01  DISPLAY-REC.
           COPY DD-FGETBLKT-O OF ZRELMAN.

       FD  DPORECD-I
           LABEL RECORDS ARE STANDARD.
       01  DPORECD-REC-I.
           COPY DDS-ALL-FORMATS  OF MCFLCS0901.

       FD  DPOITEM-I
           LABEL RECORDS ARE STANDARD.
       01  DPOITEM-REC-I.
           COPY DDS-ALL-FORMATS  OF MCFLCS1001.

003800 WORKING-STORAGE SECTION.
       77  SELECTED-ORDER-SUB          PIC S9(4).
       77  MORE-THAN-ONE-SELECT        PIC X(1).
004700 77  SUB                         PIC S9(4)   VALUE ZEROS.
004800 77  TOTAL-BLK-COUNT             PIC S9(4)   VALUE ZEROS.
004900 77  UNEXPIRED-BLKT-COUNT        PIC S9(4)   VALUE ZEROS.
005000 77  FIRST-UNEXP-BLK-SUB         PIC S9(4)   VALUE ZEROS.
       77  ERR-SW                      PIC X       VALUE SPACES.
       77  HIDE-FLD-SW                 PIC X       VALUE "N".
005300
       01  FILE-STATUS.
           05  FILE-STATUS-1            PIC X  VALUE "0".
           05  FILE-STATUS-2            PIC X  VALUE "0".
004200
       01  LOW-ITEM-COST.
           05  ITEM-PRICE               PIC Z(10)9.9(4).

005400 01  MORE-THAN-7-REQ.
005500     05  FILLER  PIC X(69).
005600
005700 01  NO-REQ-MSG.
005800     05  FILLER  PIC X(69).
006000
006100 01  MESSAGE-BUFFER.
006200     05  MSG-TEXT              PIC X(68)    VALUE SPACE.
006300     05  MSG-FLD               PIC X(8)     VALUE SPACE.
006400     05  MSG-FLD-9  REDEFINES  MSG-FLD      PIC ZZZZZZZ9.
006500
007000 01  FIELD-NUMBER              PIC S9(4)    VALUE ZERO  COMP-4.
007100
       COPY DISPDATA IN COPYLIB.

       COPY IOFEEDBACK IN COPYLIB.

       COPY CATREAD IN COPYLIB.
007200
007300 01  SCREEN-1.
007400     05  SCREEN-1-COMP           PIC X(3).
007500     05  DISP-CODE               PIC X(7).
           05  DISP-BLANKETS.
007600         10  DISP-BLANKET-TABLE  OCCURS 12 TIMES.
007700             15  DE-SELECT-BLK   PIC X.
007800             15  DISP-PO-NUM     PIC X(7).
007900             15  DISP-ITM-NUM    PIC ----9.
008000             15  DISP-UM         PIC XX.
008100             15  DISP-PRICE      PIC Z(10)9.9(4).
008200             15  DISP-PRICE-UM   PIC X(2).
008300             15  DISP-REQ-DATE   PIC X(8).
008400             15  DISP-EXP-DATE   PIC X(8).
                   15  DISP-AVAIL-QTY  PIC Z(7)9.
008500     05  DISP-MORE-7-MSG         PIC X(69).
           05  DE-COMMAND-LINE         PIC X(79).
           05  DE-MESSAGE-LINE         PIC X(79).
009000
009100
009200**************************************************************
009300**************************************************************
009400**                                                          **
009500**                DATABASE I/O BUFFER AREA                  **
009600**                                                          **
009700**************************************************************
009800**************************************************************
009900
010000 COPY DPOITEM IN COPYLIB.
010100
010200 COPY DPORECD IN COPYLIB.
010300
010400
010500*********************
010600*                   *
010700*   DATA SET NAMES  *
010800*                   *
010900*********************
011000
011100 01  DSET-NAMES.
011300     05  DSET-DPOITEM           PIC X(16)  VALUE "DPOITEM;".
011400     05  DSET-DPORECD           PIC X(16)  VALUE "DPORECD;".
011500
011600 COPY DBSTAT IN COPYLIB.
011700
012100 01 ITEMS-LISTING.
012200     05  ALL-ITEMS              PIC XX    VALUE "@;".
012300     05  CODE-SEARCH            PIC X(10) VALUE "CORP-CODE;".
012400     05  PO-SEARCH              PIC X(10) VALUE "PO-RCV-NO;".
012500
012600 01  ARG-VALUES.
012700     05  PO-ARG                 PIC X(14) VALUE SPACES.
012800
012900
013000**************************************************
013100**                DATE AREAS                    **
013200**************************************************
013300
013400 01  DATES-AND-TIMES.
           05  CUR-DATE-CN.
               10  CUR-DATE-CC       PIC XX.
014100         10  CUR-DATE-YMD.
014200             15  CUR-DATE-YY   PIC XX.
014300             15  CUR-DATE-MM   PIC XX.
014400             15  CUR-DATE-DD   PIC XX.
014500
           05  HOLD-DATE-CN.
               10  HOLD-DATE-CC      PIC XX.
               10  HOLD-DATE-YMD.
                   15  HOLD-DATE-YY  PIC XX.
                   15  HOLD-DATE-MM  PIC XX.
                   15  HOLD-DATE-DD  PIC XX.

014600
014700 COPY TDATECHK IN COPYLIB.
014800
014900 COPY TBLOWUP IN COPYLIB.
015000
015100
015200 LINKAGE SECTION.
015300
015400 01  BASE                    PIC X(10).
015500
015600 01  CODE-ARG                PIC X(8).
015700
015800 01  SELECTED-BLANKET-NO     PIC X(7).
015900
016000 01  COMP-SCREEN-INDIC       PIC X(3).
016100
016200 COPY VCOMLINK IN COPYLIB.
016300
016400
016500 01  SCREEN-PRINT-PARMS.
016600     05  PRINTCNTL              PIC S9(4)  COMP-4.
016700     05  PAGECNTL               PIC S9(4)  COMP-4.
016800     05  SPOOLFIL-OPEN-SW       PIC X.
016900
017000 01  PASSED-SPOOL-PRT           PIC S9(2)  COMP-4.
017100
017200 COPY LANGSUB IN COPYLIB.
017300
017400
017500
017600 PROCEDURE DIVISION USING  BASE,
017700                           CODE-ARG,
017800                           SELECTED-BLANKET-NO,
017900                           COMP-SCREEN-INDIC,
018000                           VIEW-COMAREA,
018100                           SCREEN-PRINT-PARMS,
018200                           PASSED-SPOOL-PRT,
018300                           LANGUAGE-PARMS.
018400
018500
018600 1-BEGIN.
           OPEN INPUT DPORECD-I, DPOITEM-I.
           OPEN I-O DISPLAY-FILE.

      *--------- HIDE CERTAIN PARTS OF SCREEN FOR AKRON PLANTS.
           IF COMP-SCREEN-INDIC (1:2) = "11"
               MOVE "Y"    TO  HIDE-FLD-SW
           ELSE
               MOVE "N"    TO  HIDE-FLD-SW.

018700     PERFORM 61-PRINT-BLANKET-SCREEN  THRU  61-PBS-X.
018800
           CLOSE DPORECD-I, DPOITEM-I, DISPLAY-FILE.
018900     GOBACK.
019000
019100
019200 2-BLOWUP.
019300     MOVE "TGETBLKT"              TO  BU-PGM-NAME.
019400     MOVE CODE-ARG                TO  BU-DISPLAY-FLD (1).
019500     CALL "TBLOWUP" USING BASE, BU-PGM-NAME, STATUS-AREA,
019600         VIEW-COMAREA, FILE-STATUS, BU-DISPLAY-MSG,
019700                 BU-DISPLAY-FLDS.
019800
019900 2-BLOWUP-X.
020000     EXIT.
020100
023700
023800 4-PGM-ERROR.
           IF FIELD-NUMBER < 97
               MOVE B"0" TO IND (97)
               MOVE B"1" TO IND (FIELD-NUMBER)
           ELSE
               MOVE B"1" TO IND (97)
               COMPUTE FIELD-NUMBER = FIELD-NUMBER - 97 + 1.
           MOVE B"1" TO IND (99).
           MOVE MESSAGE-BUFFER TO DE-MESSAGE-LINE.
024600
024700 4-PGM-ERROR-X.
024800     EXIT.
024900
026800
026900
027000 61-PRINT-BLANKET-SCREEN.
           ACCEPT CUR-DATE-YMD FROM DATE.
      *-------- ACCOUNT FOR CENTURY.
           IF CUR-DATE-YY > "70"
               MOVE "19"                TO  CUR-DATE-CC
           ELSE
               MOVE "20"                TO  CUR-DATE-CC.
027300     MOVE SPACES                  TO  SCREEN-1.
027400     MOVE CODE-ARG                TO  DISP-CODE.
027500     MOVE COMP-SCREEN-INDIC       TO  SCREEN-1-COMP.
027600     MOVE ZERO                    TO  SUB,  TOTAL-BLK-COUNT,
                                            UNEXPIRED-BLKT-COUNT,
                                            FIRST-UNEXP-BLK-SUB.
           MOVE CODE-ARG TO CORPCDE OF DPOITEM-REC-I.
           START DPOITEM-I KEY = CORPCDE OF DPOITEM-REC-I
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
                   NEXT SENTENCE
               ELSE
028000             MOVE "FIND DPOITEM * 61-PBS"  TO  BU-DISPLAY-MSG
028100             GO TO 2-BLOWUP.
028200
028300 61-GET-DPOITEM.
           MOVE 0 TO COND-WORD.
           READ DPOITEM-I NEXT INTO BUF-DPOITEM
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   MOVE 15 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.
           IF CORPCDE OF DPOITEM-REC-I NOT = CODE-ARG
               MOVE 15 TO COND-WORD.
028400*A   CALL "DBGET" USING BASE, DSET-DPOITEM, MODE5,
028500*A       STATUS-AREA, ALL-ITEMS, BUF-DPOITEM, CODE-ARG.
028600     IF COND-WORD NOT = 0
028700         IF COND-WORD = 15
028800             IF SUB = 0
      *                "N5: NO REQUIREMENT ORDERS EXIST FOR THIS CODE"
028900                 MOVE  14 TO LANG-SETNUM
029000                 MOVE   5 TO LANG-MSGNUM
029100                 PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
029200                 MOVE MESSAGE-BUFFER TO NO-REQ-MSG
029300                 MOVE NO-REQ-MSG  TO  DISP-MORE-7-MSG
029400                 GO TO 61-WRITE-SCREEN-1
029500             ELSE
029600                 GO TO 61-WRITE-SCREEN-1
029700         ELSE
029800             MOVE "GET DPOITEM * 61-GD" TO  BU-DISPLAY-MSG
029900             GO TO 2-BLOWUP.
030000
      **************************************************************
      *    ADDED CODE PER JIM THOMAS' VERBAL REQUEST TO SHUT OFF   *
      *    DANVILLE FROM ORDERING MATERIALS FROM ITOV ORDERS       *
      *    AS THE OUTSOURCING STOREROOM PEOPLE WERE ABUSING IT     *
      *    AND ORDERING MATERIAL FROM MALAYSIA, ETC.
      **************************************************************
           IF COMP-SCREEN-INDIC = "126"
               IF ITM-PO-NO-1-4 = "ITOV"
                   GO TO 61-GET-DPOITEM.

030100 61-CHECK-IF-BLKT.
030200     IF ITM-PO-RCVR  =  "000"
030300       IF ITM-PO-REL  =  "999"
030400         ADD 1                    TO SUB, TOTAL-BLK-COUNT
030500         IF SUB < 12
030600           MOVE ITM-PO-NO         TO DISP-PO-NUM (SUB)
030700           MOVE ITM-NUMBER        TO DISP-ITM-NUM (SUB)
030800           MOVE ITM-UM            TO DISP-UM (SUB)
030900           MOVE ITM-UNIT-PRICE    TO DISP-PRICE (SUB)
031000           MOVE ITM-PRICE-UM      TO DISP-PRICE-UM (SUB)
                 PERFORM 611-SET-LOW-PRICE-ITEM
                 PERFORM 611-SET-SELECTION
                 MOVE ITM-QTY-PAID      TO DISP-AVAIL-QTY (SUB)
031100           PERFORM 611-GET-EXPIRATION  THRU  611-GE-X
031200         ELSE
030600           MOVE ITM-PO-NO         TO DISP-PO-NUM (SUB)
030700           MOVE ITM-NUMBER        TO DISP-ITM-NUM (SUB)
030800           MOVE ITM-UM            TO DISP-UM (SUB)
030900           MOVE ITM-UNIT-PRICE    TO DISP-PRICE (SUB)
031000           MOVE ITM-PRICE-UM      TO DISP-PRICE-UM (SUB)
                 PERFORM 611-SET-LOW-PRICE-ITEM
                 PERFORM 611-SET-SELECTION
                 MOVE ITM-QTY-PAID      TO DISP-AVAIL-QTY (SUB)
031100           PERFORM 611-GET-EXPIRATION  THRU  611-GE-X
      *          "MORE REQUIREMENT ORDERS EXIST, PRESS F6 TO VIEW"
031300           MOVE  13               TO LANG-SETNUM
031400           MOVE  72               TO LANG-MSGNUM
031500           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
031600           MOVE MESSAGE-BUFFER    TO MORE-THAN-7-REQ
031700           MOVE MORE-THAN-7-REQ   TO  DISP-MORE-7-MSG
031800           MOVE 7                 TO  TOTAL-BLK-COUNT
031900           GO TO 61-WRITE-SCREEN-1.
032000
032100     GO TO 61-GET-DPOITEM.
032300
032400 61-WRITE-SCREEN-1.
032500     MOVE "FGETBLKT"  TO  VIEW-NFNAME.

034600
034700 61-READ-SCREEN-1.
           IF HIDE-FLD-SW = "Y"
               MOVE B"1" TO IND (30).
           MOVE SCREEN-1       TO DISPLAY-REC.
           PERFORM 998-WRITE-SCREEN THRU 998-READ-SCREEN.
           MOVE DISPLAY-REC    TO SCREEN-1.
035700
035800     IF VIEW-LASTKEY = 3
035900         GO TO 61-PBS-X
036000     ELSE
           IF VIEW-LASTKEY = 6
               MOVE SPACES TO DISP-BLANKETS
               MOVE 0      TO SUB
               GO TO 61-GET-DPOITEM
           ELSE
038300     IF VIEW-LASTKEY = 1 OR
038400        VIEW-LASTKEY = 2 OR
038400        VIEW-LASTKEY = 4 OR
038400        VIEW-LASTKEY = 5 OR
              VIEW-LASTKEY = 7 OR
038700        VIEW-LASTKEY = 8
      *        "I10: INVALID FUNCTION KEY"
038900         MOVE   9 TO LANG-SETNUM
039000         MOVE  10 TO LANG-MSGNUM
039100         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
039200         MOVE 99  TO FIELD-NUMBER
039300         PERFORM 4-PGM-ERROR  THRU  4-PGM-ERROR-X
039400         GO TO 61-READ-SCREEN-1.
039600
041600 61-CHECK-SELECTION.
           MOVE SPACES TO ERR-SW.
           PERFORM 611-EDIT-SELECTION
               VARYING SUB FROM 1 BY 1
                   UNTIL SUB > 7 OR ERR-SW = "Y".
           IF ERR-SW = "Y"
               MOVE 66142 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               COMPUTE FIELD-NUMBER = SUB + 57
               PERFORM 4-PGM-ERROR  THRU 4-PGM-ERROR-X
               GO TO 61-READ-SCREEN-1.

041700     IF UNEXPIRED-BLKT-COUNT = 0
      *        "N44: NO UNEXPIRED REQUIREMENT ORDERS EXIST"
041800         MOVE  14 TO LANG-SETNUM
041900         MOVE  44 TO LANG-MSGNUM
042000         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
042100         MOVE 59  TO  FIELD-NUMBER
042200         PERFORM 4-PGM-ERROR  THRU  4-PGM-ERROR-X
042300         GO TO 61-READ-SCREEN-1.
042400
           MOVE ZERO TO SUB.
           MOVE "N" TO MORE-THAN-ONE-SELECT.
           MOVE ZERO TO SELECTED-ORDER-SUB.
           PERFORM UNTIL SUB > 11 OR MORE-THAN-ONE-SELECT = "Y"
               ADD 1 TO SUB
               IF DE-SELECT-BLK (SUB) > SPACES
                   IF SELECTED-ORDER-SUB = ZERO
                       MOVE SUB TO SELECTED-ORDER-SUB
                   ELSE
                       MOVE "Y" TO MORE-THAN-ONE-SELECT
                   END-IF
               END-IF
           END-PERFORM.
           MOVE SELECTED-ORDER-SUB TO SUB.

           IF MORE-THAN-ONE-SELECT = "Y"
      *        "S11: SELECT ONLY ONE REQUIREMENT ORDER WHEN PROCESSING"
               MOVE 19 TO LANG-SETNUM
               MOVE 11 TO LANG-MSGNUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE 59 TO FIELD-NUMBER
               PERFORM 4-PGM-ERROR THRU 4-PGM-ERROR-X
               GO TO 61-READ-SCREEN-1.

           IF UNEXPIRED-BLKT-COUNT = 1
               IF SUB = ZERO OR SUB = FIRST-UNEXP-BLK-SUB
                   MOVE DISP-PO-NUM (FIRST-UNEXP-BLK-SUB)
                       TO SELECTED-BLANKET-NO
                   GO TO 61-PBS-X.

           IF SUB = ZERO
      *        "M28: MORE THAN ONE REQ ORDER EXISTS; SELECT ONE"
               MOVE 13 TO LANG-SETNUM
               MOVE 28 TO LANG-MSGNUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE 59 TO FIELD-NUMBER
               PERFORM 4-PGM-ERROR THRU 4-PGM-ERROR-X
               GO TO 61-READ-SCREEN-1.

051000 61-CHECK-EXP-OF-SELECTION.
051100     MOVE 3                     TO  DATE-MODE.
051200     MOVE DISP-EXP-DATE (SUB)   TO  DATE-VALIDATE-IN.
051300     CALL "TDATECK2" USING DATE-CHECK-AREA, LANGUAGE-PARMS.
051400
           MOVE DATE-YMD-OUT          TO  HOLD-DATE-YMD.
      *--------- ACCOUNT FOR CENTURY.
           IF HOLD-DATE-YY > "70"
               MOVE "19"              TO  HOLD-DATE-CC
           ELSE
               MOVE "20"              TO  HOLD-DATE-CC.

051500     IF HOLD-DATE-CN  <  CUR-DATE-CN
051600         MOVE  20 TO LANG-SETNUM
051700         MOVE  20 TO LANG-MSGNUM
051800         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
051900         ADD 58, SUB  GIVING FIELD-NUMBER
052000         PERFORM  4-PGM-ERROR  THRU  4-PGM-ERROR-X
052100         GO TO 61-READ-SCREEN-1.
052200
      *------------ SKIP THIS CHECK FOR AKRON PLANTS.
           IF HIDE-FLD-SW = "N"
             IF DISP-PRICE (SUB) > ITEM-PRICE
      *M   "CHEAPEST ITEM NOT SELECTED - F1 TO CONTINUE, F2 TO CHANGE"
               MOVE   3 TO LANG-SETNUM
               MOVE 621 TO LANG-MSGNUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE 59  TO FIELD-NUMBER
               PERFORM 4-PGM-ERROR THRU 4-PGM-ERROR-X
               MOVE SCREEN-1 TO DISPLAY-REC
               PERFORM 998-WRITE-SCREEN THRU 998-READ-SCREEN
               MOVE DISPLAY-REC TO SCREEN-1
               IF VIEW-LASTKEY = 1
                   NEXT SENTENCE
               ELSE
               MOVE " "    TO DE-SELECT-BLK (SUB)
               MOVE SPACES TO DE-MESSAGE-LINE
               GO TO 61-READ-SCREEN-1.

052300     MOVE DISP-PO-NUM (SUB)  TO  SELECTED-BLANKET-NO.
052400
052500 61-PBS-X.
052600     EXIT.
052700
052800 611-GET-EXPIRATION.
052900     MOVE ITM-PO-RCV-NO  TO  PO-ARG.
           MOVE PO-ARG TO PORCVNO OF DPORECD-REC-I.
           START DPORECD-I KEY = PORCVNO OF DPORECD-REC-I
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
053300         MOVE "FIND DPORECD * 611-GE"  TO  BU-DISPLAY-MSG
053400         MOVE PO-ARG                    TO  BU-DISPLAY-FLD (2)
053500         GO TO 2-BLOWUP.
053600
           READ DPORECD-I NEXT INTO BUF-DPORECD
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
054000         MOVE "GET DPORECD * 611-GE"  TO  BU-DISPLAY-MSG
054100         MOVE PO-ARG                   TO  BU-DISPLAY-FLD (2)
054200         GO TO 2-BLOWUP.
054300
054400     MOVE 4                       TO  DATE-MODE.
054500     MOVE PO-DATE                 TO  DATE-VALIDATE-IN.
054600     CALL "TDATECK2" USING DATE-CHECK-AREA, LANGUAGE-PARMS.
054700     MOVE DATE-SLASH-OUT          TO  DISP-REQ-DATE (SUB).
054800     MOVE PO-EXPECT-DATE          TO  DATE-VALIDATE-IN.
054900     CALL "TDATECK2" USING DATE-CHECK-AREA, LANGUAGE-PARMS.
055000     MOVE DATE-SLASH-OUT          TO  DISP-EXP-DATE (SUB).
055100
055200     IF PO-EXPECT-DATE-CN < CUR-DATE-CN
055300         NEXT SENTENCE
055400     ELSE
055500         ADD 1  TO  UNEXPIRED-BLKT-COUNT
055600         IF UNEXPIRED-BLKT-COUNT = 1
055700             MOVE SUB  TO  FIRST-UNEXP-BLK-SUB.
055800
055900 611-GE-X.
056000     EXIT.
056100
       611-EDIT-SELECTION.
           IF DE-SELECT-BLK (SUB) NOT = SPACES
               IF DISP-PO-NUM (SUB) = SPACES
                   MOVE "Y" TO ERR-SW.

       611-SET-LOW-PRICE-ITEM.
           IF SUB = 1
               MOVE ITM-UNIT-PRICE TO ITEM-PRICE
           ELSE
           IF DISP-PRICE (SUB) < ITEM-PRICE
               MOVE ITM-UNIT-PRICE TO ITEM-PRICE.

       611-SET-SELECTION.
           IF COMP-SCREEN-INDIC (1:2) = "11"
               IF SELECTED-BLANKET-NO > SPACES AND
                  ITM-PO-NO = SELECTED-BLANKET-NO
                   MOVE "X" TO DE-SELECT-BLK (SUB).

       COPY DISPCALL IN COPYLIB.

056200 999-CATREAD.
           IF CATREAD-MSG-NUMBER = ZEROS
               MOVE LANG-SETNUM TO CATREAD-MSG-SET
               MOVE LANG-MSGNUM TO CATREAD-MSG-NUM.
           CALL "CCATREAD" USING CATREAD-PARMS.
           MOVE CATREAD-MSG-TEXT TO MESSAGE-BUFFER.
057800 999-CATREAD-EXIT.
057900     EXIT.
