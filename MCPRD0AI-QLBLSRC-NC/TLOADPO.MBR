001000*****************************************************
001100*  INPUT FILE FOR TLOADPO.SOURCE (ABSTFILE LAYOUT)  *
001110* PO-REC IS MOVED TO ANOTHER AREA BASED ON PO-TRANS *
001120* IF PO-DEL-FLAG = 'D' AND                          *
001130*    PO-TRANS=1  -  DELETE PO HEADER                *
001140*    PO-TRANS=3  -  DELETE CODED ITEM               *
001150*    PO-TRANS=4  -  DELETE NONCODED ITEM            *
001160*    PO-TRANS=5  -  DELETE DESCRIPTION              *
      *    PO-TRANS=6  -  P.O. TRAILER COMMENTS           *
001170*                                                   *
001180* IF PO-DEL-FLANG = ' ' AND                         *
001190*    PO-TRANS=1  -  ADD PO HEADER                   *
001191*    PO-TRANS=2  -  ADD VENDOR RECORD               *
001192*    PO-TRANS=3  -  ADD CODED ITEM                  *
001193*    PO-TRANS=4  -  ADD NONCODED ITEM               *
001194*    PO-TRANS=5  -  ADD DESCRIPTION                 *
      *    PO-TRANS=6  -  MODIFY ITEM (MEXICO, 659 ONLY)  *
001195*    PO-TRANS= ,7,8 ARE IGNORED                     *
      *    PO-TRANS=A  -  P.O. TRAILER COMMENTS           *
001196*    ALL OTHERS ARE INVALID                         *
001200*****************************************************
001300 FD  INPUT-PO-FILE
001400     LABEL RECORDS ARE OMITTED
001500     RECORD CONTAINS 133 CHARACTERS
001600     DATA RECORD IS INPUT-PO-REC.
001700 01  INPUT-PO-REC.
001800     05  FILLER                         PIC X.
001900     05  PO-TRANS                       PIC X.
           05  RECORDS-1-8.
002000         10  PO-DEL-FLAG                PIC X.
002100         10  PO-INPUT-NUM.
002200             15  PO-NUM-1-7             PIC X(7).
002300             15  PO-RLSE-8-10           PIC X(3).
002400         10  PO-REC                     PIC X(120).
           05  RECORD-A REDEFINES RECORDS-1-8.
               10  FILLER                     PIC X.
               10  PO-REC-A                   PIC X(129).
002500
       FD  KVENDOR-VN-O
           LABEL RECORDS ARE STANDARD.
       01  KVENDOR-VN-REC-O.
           COPY DDS-MCRPCSVEND  OF MCFLCSVEN2.

       FD  MBUYER-BY-I
           LABEL RECORDS ARE STANDARD.
       01  MBUYER-BY-REC-I.
           COPY DDS-MCRPCS0600  OF MCFLCS0601.

       FD  MPLTINFO-PK-I
           LABEL RECORDS ARE STANDARD.
       01  MPLTINFO-PK-REC-I.
           COPY DDS-MCRPCS0500  OF MCFLCS0501.

       FD  MPLTINFO-PK-O
           LABEL RECORDS ARE STANDARD.
       01  MPLTINFO-PK-REC-O.
           COPY DDS-MCRPCS0500  OF MCFLCS0501.

       FD  MPORCV-PO-I
           LABEL RECORDS ARE STANDARD.
       01  MPORCV-PO-REC-I.
           COPY DDS-MCRPCS0100  OF MCFLCS0101.

       FD  MPORCV-PO-O
           LABEL RECORDS ARE STANDARD.
       01  MPORCV-PO-REC-O.
           COPY DDS-MCRPCS0100  OF MCFLCS0101.

       FD  MREQ-RQ-O
           LABEL RECORDS ARE STANDARD.
       01  MREQ-RQ-REC-O.
           COPY DDS-MCRPCS2000  OF MCFLCS2001.

       FD  MSTORERM-CD-I
           LABEL RECORDS ARE STANDARD.
       01  MSTORERM-CD-REC-I.
           COPY DDS-MCRPCS0200  OF MCFLCS0201.

       FD  MVALIDUM-UM-I
           LABEL RECORDS ARE STANDARD.
       01  MVALIDUM-UM-REC-I.
           COPY DDS-MCRPCS0400  OF MCFLCS0401.

       FD  DPORECDH-I
           LABEL RECORDS ARE STANDARD.
       01  DPORECDH-REC-I.
           COPY DDS-ALL-FORMATS  OF MCFLST0301.

       FD  PRINT-FILE
           LABEL RECORDS ARE OMITTED
           RECORD CONTAINS 132 CHARACTERS
           DATA RECORD IS PRINT-REC.
       01  PRINT-REC.
           05  PRINT-LINE                PIC X(132).

       FD  PO-ERROR-FILE
           LABEL RECORDS ARE OMITTED
           RECORD CONTAINS 133 CHARACTERS
           DATA RECORD IS PO-ERROR-REC.
       01  PO-ERROR-REC.
           05  CTL                       PIC X(1).
           05  PO-ERROR-LINE.
               10  CONTROL-DATE          PIC X(6).
               10  FILLER                PIC X(126).

       WORKING-STORAGE SECTION.
       77  CONVERT-NUM                   PIC 9(4)  VALUE 0.
       77  DELETE-IT                     PIC 9     VALUE 0.
       77  HANDLE-BLOWUP-FLAG            PIC X     VALUE "N".
       77  SAVE-IN-QUOTE                 PIC X(6)  VALUE SPACES.
       77  SAVE-CHAT-SW                  PIC X     VALUE "N".
       77  TRAILER-SW                    PIC 9     VALUE 0.
       77  ITEMSEQNO-9                   PIC 9(6)  VALUE 0.
       77  MCXCBLERR-SCOPE               PIC X(1)  VALUE "C".
       77  PO-IN-HIST-SW                 PIC X     VALUE "N".
       77  ADD-2-SW                      PIC X     VALUE "N".

       01  YMD-DATE.
           05  YMD-YY                    PIC X(2).
           05  YMD-MM                    PIC X(2).
           05  YMD-DD                    PIC X(2).

       01  TEMP-DATE-9                   PIC 9(8).
       01  TEMP-DATE   REDEFINES  TEMP-DATE-9
                                         PIC X(8).

       01  FROM-QUOTE                    PIC X     VALUE "N".
      *------- THIS FLAGS WHAT TYPE OF FUNCTION WE ARE PROCESSING
      *------- FOR A RECORD - ADD, MOD, DELETE / ITEM, HEADER, DATAITEM
       01  RECORD-FUNCTION-D.
           05  RECORD-FUNCTION.
               10  RECORD-FUNCTION-1     PIC X(1).
               10  RECORD-FUNCTION-2     PIC X(1).
           05  FILLER                    PIC X(1).
           05  RECORD-FUNCTION-DESC      PIC X(14).

       01  ITEM-TO-SEARCH-FOR            PIC X(4).

       01  WORK-AREA-DATA-NAMES.
           05  OLD-ORD-QTY-SAVE          PIC S9(8)  VALUE ZEROS.
           05  ORD-QTY-SAVE              PIC S9(8)  VALUE ZEROS.
           05  SAVE-PO-NUM-REL           PIC X(10)  VALUE SPACES.
           05  SAVE-PO-NUM-REL-2         PIC X(19)  VALUE SPACES.
           05  LINE-CTR                  PIC 9(2)   VALUE ZERO.
           05  PAGE-CTR                  PIC 9(3)   VALUE ZERO.
           05  POR-LINE-CTR              PIC 9(2)   VALUE ZERO.
           05  POR-PAGE-CTR              PIC 9(3)   VALUE ZERO.
           05  RECORD-COUNTER            PIC 9(6)   VALUE ZEROS.
           05  TC-TYPE-SAVE              PIC X(3)   VALUE SPACES.
           05  OLD-BUDGET-AMT            PIC S9(11) VALUE ZEROS.
           05  SUB                       PIC S9(4)  VALUE ZEROS.
           05  DUPLICATE-PO-NO           PIC X(14)  VALUE SPACES.
           05  SAVE-PARA-NO              PIC 9(2)   VALUE 0.
           05  SAVE-STR-CF               PIC S9(11)V9(4).
           05  FORMAT-QTY                PIC S9(8)V9(4).
           05  SAV-ORD-STR-UM            PIC S9(11)V9(4).
