       66-DDE-X.
           EXIT.

       67-DELETE-DRELTRAK-ENTRIES.
           MOVE 0 TO COND-WORD.
           MOVE PO-ARG TO PORCVNO OF DRELTRAK-REC-O.
           START DRELTRAK-O KEY = PORCVNO OF DRELTRAK-REC-O
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
                   GO TO 67-DDE-X
               ELSE
                   MOVE 99 TO COND-WORD.
           IF COND-WORD NOT = 0
               MOVE "FIND DRELTRAK * 67-DDE" TO BU-DISPLAY-MSG
               GO TO 2-BLOWUP.

       67-GET-DRELTRAK.
           MOVE 0 TO COND-WORD.
           READ DRELTRAK-O NEXT INTO BUF-DRELTRAK
               AT END MOVE 15 TO COND-WORD.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   MOVE 15 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.
           IF PORCVNO OF DRELTRAK-REC-O NOT = PO-ARG
               MOVE HIGH-VALUES TO PORCVNO OF DRELTRAK-REC-O
               START DRELTRAK-O KEY > PORCVNO OF DRELTRAK-REC-O
                 INVALID KEY MOVE "00" TO FILE-STATUS
               END-START
               MOVE 15 TO COND-WORD.
           IF COND-WORD NOT = 0
               IF COND-WORD = 15
                   GO TO 67-DDE-X
               ELSE
                   MOVE "GET DRELTRAK*66-GD" TO BU-DISPLAY-MSG
                   GO TO 2-BLOWUP.

           DELETE DRELTRAK-O
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE "DELETE DRELTRAK*66-DD" TO BU-DISPLAY-MSG
               GO TO 2-BLOWUP.

           GO TO 67-GET-DRELTRAK.

       67-DDE-X.
           EXIT.

       68-DELETE-DRCVTRAK-ENTRIES.
           MOVE 0 TO COND-WORD.
           MOVE PO-ARG TO PORCVNO OF DRCVTRAK-REC-O.
           START DRCVTRAK-O KEY NOT < EXTERNALLY-DESCRIBED-KEY
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
                   GO TO 68-DDE-X
               ELSE
                   MOVE 99 TO COND-WORD.
           IF COND-WORD NOT = 0
               MOVE "FIND DRCVTRAK * 68-DDE" TO BU-DISPLAY-MSG
               GO TO 2-BLOWUP.

       68-GET-DRCVTRAK.
           MOVE 0 TO COND-WORD.
           READ DRCVTRAK-O NEXT INTO BUF-DRCVTRAK
               AT END MOVE 15 TO COND-WORD.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   MOVE 15 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.
           IF PORCVNO OF DRCVTRAK-REC-O NOT = PO-ARG
               MOVE HIGH-VALUES TO PORCVNO OF DRCVTRAK-REC-O
               START DRCVTRAK-O KEY > EXTERNALLY-DESCRIBED-KEY
                 INVALID KEY MOVE "00" TO FILE-STATUS
               END-START
               MOVE 15 TO COND-WORD.
           IF COND-WORD NOT = 0
               IF COND-WORD = 15
                   GO TO 68-DDE-X
               ELSE
                   MOVE "GET DRCVTRAK*68-GD" TO BU-DISPLAY-MSG
                   GO TO 2-BLOWUP.

           DELETE DRCVTRAK-O
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE "DELETE DRCVTRAK*68-DD" TO BU-DISPLAY-MSG
               GO TO 2-BLOWUP.

           GO TO 68-GET-DRCVTRAK.

       68-DDE-X.
           EXIT.
