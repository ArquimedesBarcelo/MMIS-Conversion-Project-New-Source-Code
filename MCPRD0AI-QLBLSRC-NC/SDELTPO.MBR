           SELECT DPOTRACK-O
               ASSIGN         TO DATABASE-MCFLCS5602
               ORGANIZATION   IS INDEXED
               ACCESS MODE    IS DYNAMIC
               RECORD KEY     IS EXTERNALLY-DESCRIBED-KEY
                              WITH DUPLICATES
               FILE STATUS    IS FILE-STATUS.

           SELECT DRELTRAK-O
               ASSIGN         TO DATABASE-MCFLCS6102
               ORGANIZATION   IS INDEXED
               ACCESS MODE    IS DYNAMIC
               RECORD KEY     IS EXTERNALLY-DESCRIBED-KEY
                              WITH DUPLICATES
               FILE STATUS    IS FILE-STATUS.

           SELECT DRCVTRAK-O
               ASSIGN         TO DATABASE-MCFLCS6401
               ORGANIZATION   IS INDEXED
               ACCESS MODE    IS DYNAMIC
               RECORD KEY     IS EXTERNALLY-DESCRIBED-KEY
                              WITH DUPLICATES
               FILE STATUS    IS FILE-STATUS.

       DATA DIVISION.
       FILE SECTION.
       FD  DPORECD-O
           LABEL RECORDS ARE STANDARD.
       01  DPORECD-REC-O.
           COPY DDS-ALL-FORMATS  OF MCFLCS0901.

       FD  MPORCV-O
           LABEL RECORDS ARE STANDARD.
       01  MPORCV-REC-O.
           COPY DDS-ALL-FORMATS  OF MCFLCS0101.

       FD  DVENDOR-O
           LABEL RECORDS ARE STANDARD.
       01  DVENDOR-REC-O.
           COPY DDS-ALL-FORMATS  OF MCFLCS0701.

       FD  DVENDITM-O
           LABEL RECORDS ARE STANDARD.
       01  DVENDITM-REC-O.
           COPY DDS-ALL-FORMATS  OF MCFLCS0801.

       FD  DPOITEM-O
           LABEL RECORDS ARE STANDARD.
       01  DPOITEM-REC-O.
           COPY DDS-ALL-FORMATS  OF MCFLCS1002.

       FD  DDAILYTC-O
           LABEL RECORDS ARE STANDARD.
       01  DDAILYTC-REC-O.
           COPY DDS-ALL-FORMATS  OF MCFLCS1601.

       FD  DPODATAITM-O
           LABEL RECORDS ARE STANDARD.
       01  DPODATAITM-REC-O.
           COPY DDS-ALL-FORMATS  OF MCFLCS1101.

       FD  MSTORERM-I
           LABEL RECORDS ARE STANDARD.
       01  MSTORERM-REC-I.
           COPY DDS-ALL-FORMATS  OF MCFLCS0201.

       FD  DREQD-O
           LABEL RECORDS ARE STANDARD.
       01  DREQD-REC-O.
           COPY DDS-ALL-FORMATS  OF MCFLCS2102.

       FD  MREQ-O
           LABEL RECORDS ARE STANDARD.
       01  MREQ-REC-O.
           COPY DDS-ALL-FORMATS  OF MCFLCS2001.

       FD  DREQITM-O
           LABEL RECORDS ARE STANDARD.
       01  DREQITM-REC-O.
           COPY DDS-ALL-FORMATS  OF MCFLCS2201.

       FD  DREQDESC-O
           LABEL RECORDS ARE STANDARD.
       01  DREQDESC-REC-O.
           COPY DDS-ALL-FORMATS  OF MCFLCS2301.

       FD  DREQQUE-O
           LABEL RECORDS ARE STANDARD.
       01  DREQQUE-REC-O.
           COPY DDS-ALL-FORMATS  OF MCFLCS4401.

       FD  DPOFREIGHT-O
           LABEL RECORDS ARE STANDARD.
       01  DPOFREIGHT-REC-O.
           COPY DDS-ALL-FORMATS  OF MCFLCS2401.

       FD  DRCVITEM-O
           LABEL RECORDS ARE STANDARD.
       01  DRCVITEM-REC-O.
           COPY DDS-ALL-FORMATS  OF MCFLCS1201.

       FD  DTALLY-O
           LABEL RECORDS ARE STANDARD.
       01  DTALLY-REC-O.
           COPY DDS-ALL-FORMATS  OF MCFLCS4702.

       FD  DRAWLOT-O
           LABEL RECORDS ARE STANDARD.
       01  DRAWLOT-REC-O.
           COPY DDS-ALL-FORMATS  OF MCFLCS4602.

       FD  DINVRCD-O
           LABEL RECORDS ARE STANDARD.
       01  DINVRCD-REC-O.
           COPY DDS-ALL-FORMATS OF MCFLCS2502.

       FD  DINVITM-O
           LABEL RECORDS ARE STANDARD.
       01  DINVITM-REC-O.
           COPY DDS-ALL-FORMATS OF MCFLCS2601.

       FD  DINVACCT-O
           LABEL RECORDS ARE STANDARD.
       01  DINVACCT-REC-O.
           COPY DDS-ALL-FORMATS OF MCFLCS2701.

       FD  DRCVCORR-O
           LABEL RECORDS ARE STANDARD.
       01  DRCVCORR-REC-O.
           COPY DDS-ALL-FORMATS  OF MCFLCS5401.

       FD  DTRAILER-O
