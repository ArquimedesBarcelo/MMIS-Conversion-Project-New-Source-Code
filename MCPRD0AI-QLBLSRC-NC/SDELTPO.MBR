       01  DTRAILER-REC-O.
           COPY DDS-ALL-FORMATS  OF MCFLCS6001.

       FD  DPOTRACK-O
           LABEL RECORDS ARE STANDARD.
       01  DPOTRACK-REC-O.
           COPY DDS-ALL-FORMATS OF MCFLCS5602.

       FD  DRELTRAK-O
           LABEL RECORDS ARE STANDARD.
       01  DRELTRAK-REC-O.
           COPY DDS-ALL-FORMATS OF MCFLCS6102.

       FD  DRCVTRAK-O
           LABEL RECORDS ARE STANDARD.
       01  DRCVTRAK-REC-O.
           COPY DDS-ALL-FORMATS OF MCFLCS6401.

       WORKING-STORAGE SECTION.
       01  FILE-STATUS.
           05  FILE-STATUS-1            PIC X  VALUE "0".
           05  FILE-STATUS-2            PIC X  VALUE "0".

       01  WORK-AREA.
           05  SAVE-LAST-RCVR         PIC 9(3)  VALUE ZEROS.
           05  PO-FOUND-SW            PIC X     VALUE SPACES.
               88  PO-NOT-FOUND                 VALUE "N".

       01  ITEM-TO-HISTORY-SW         PIC X     VALUE "N".

      **************************************************************
      **************************************************************
      **                                                          **
      **                DATABASE I/O BUFFER AREA                  **
      **                                                          **
      **************************************************************
      **************************************************************

       COPY MPORCV     IN COPYLIB.

       COPY DPORECD    IN COPYLIB.

       COPY DPOITEM    IN COPYLIB.

       COPY DPODATA    IN COPYLIB.

       COPY DRCVITEM   IN COPYLIB.

       COPY DFREIGHT   IN COPYLIB.

       COPY DTALLY     IN COPYLIB.

       COPY DRAWLOT    IN COPYLIB.

       COPY DVENDOR    IN COPYLIB.

       COPY DVENDITM   IN COPYLIB.

       COPY MREQ       IN COPYLIB.

       COPY DREQD      IN COPYLIB.

       COPY DREQITM    IN COPYLIB.

       COPY DREQDESC   IN COPYLIB.

       COPY MSTORERM   IN COPYLIB.

       COPY DINVRCD    IN COPYLIB.

       COPY DINVITM    IN COPYLIB.

       COPY DINVACCT   IN COPYLIB.

       COPY DDAILYTC   IN COPYLIB.

       COPY TC32D      IN COPYLIB.

       COPY DREQQUE    IN COPYLIB.

       COPY DRCVCORR   IN COPYLIB.

       COPY DTRAILER   IN COPYLIB.

       01  BUF-DPOTRACK.
       COPY DPOTRACK   IN COPYLIB.

       COPY DRELTRAK   IN COPYLIB.

       COPY DRCVTRAK   IN COPYLIB.

      *********************
      *                   *
      *   DATA SET NAMES  *
      *                   *
      *********************

       01  DSET-NAMES.
           05  DSET-DPORECD           PIC X(16)  VALUE "DPORECD;".
           05  DSET-MPORCV            PIC X(16)  VALUE "MPORCV;".
           05  DSET-MREQ              PIC X(16)  VALUE "MREQ;".
           05  DSET-DREQD             PIC X(16)  VALUE "DREQD;".
           05  DSET-DREQITM           PIC X(16)  VALUE "DREQITM;".
           05  DSET-DREQDESC          PIC X(16)  VALUE "DREQDESC;".
           05  DSET-DREQQUE           PIC X(16)  VALUE "DREQQUE;".
           05  DSET-DPOITEM           PIC X(16)  VALUE "DPOITEM;".
           05  DSET-DPODATAITM        PIC X(16)  VALUE "DPODATAITM;".
           05  DSET-DRCVITEM          PIC X(16)  VALUE "DRCVITEM;".
           05  DSET-DPOFREIGHT        PIC X(16)  VALUE "DPOFREIGHT;".
           05  DSET-DTALLY            PIC X(16)  VALUE "DTALLY;".
           05  DSET-DRAWLOT           PIC X(16)  VALUE "DRAWLOT;".
           05  DSET-DINVRCD           PIC X(16)  VALUE "DINVRCD;".
           05  DSET-DINVITM           PIC X(16)  VALUE "DINVITM;".
           05  DSET-DINVACCT          PIC X(16)  VALUE "DINVACCT;".
           05  DSET-DVENDOR           PIC X(16)  VALUE "DVENDOR;".
           05  DSET-DVENDITM          PIC X(16)  VALUE "DVENDITM;".
           05  DSET-MSTORERM          PIC X(16)  VALUE "MSTORERM;".
           05  DSET-DDAILYTC          PIC X(16)  VALUE "DDAILYTC;".
           05  DSET-DRCVCORR          PIC X(16)  VALUE "DRCVCORR;".
           05  DSET-DTRAILER          PIC X(16)  VALUE "DTRAILER;".

       COPY DBSTAT     IN COPYLIB.

       01 ITEMS-LISTING.
           05  ALL-ITEMS              PIC XX    VALUE "@;".
           05  CODE-SEARCH            PIC X(10) VALUE "CORP-CODE;".
           05  REQ-SEARCH             PIC X(12) VALUE "REQ-NUMBER;".
           05  PO-SEARCH              PIC X(10) VALUE "PO-RCV-NO;".
           05  VEN-SEARCH             PIC X(10) VALUE "VEN-CODE;".
           05  REG-SEARCH             PIC X(16)
                                      VALUE "REGISTER-NUMBER;".

       01  ARG-VALUES.
           05  REQ-ARG                PIC X(12) VALUE SPACES.
           05  CODE-ARG               PIC X(8)  VALUE SPACES.
           05  VEN-ARG                PIC X(10) VALUE SPACES.
           05  REGISTER-ARG           PIC X(6)  VALUE SPACES.
           05  RCVR-ARG.
               10  RCVR-PO-PREFIX     PIC X     VALUE SPACES.
               10  RCVR-PO-NUM        PIC X(7)  VALUE SPACES.
               10  RCVR-PO-REL        PIC X(3)  VALUE SPACES.
               10  RCVR-PO-RCVR       PIC 9(3)  VALUE ZEROS.

      ************************************
      *
      *  PARAMETERS FOR CALLING
      *  STC320.SOURCE
      *
      ************************************

       COPY STC320     IN COPYLIB.


       COPY SCALCBGT IN COPYLIB.

       COPY TDATECHK   IN COPYLIB.

       COPY TBLOWUP    IN COPYLIB.

       LINKAGE SECTION.

       01  BASE             PIC X(10).

       01  PO-ARG           PIC X(14).

       01  COMPANY-SAVE     PIC X(3).


       PROCEDURE DIVISION USING  BASE,
                                 PO-ARG,
                                 COMPANY-SAVE.



       PO-DELETE SECTION 15.
       BEGIN-HERE.

           PERFORM 1-HSK  THRU  1-HSK-X.

           PERFORM 6-MAIN  THRU  6-MAIN-X.

           CLOSE DPORECD-O, MPORCV-O, DVENDOR-O, DVENDITM-O,
                 DPOITEM-O, DDAILYTC-O, DPODATAITM-O, DREQD-O,
                 MREQ-O, DREQITM-O, DREQDESC-O, DREQQUE-O,
                 DPOFREIGHT-O, DRCVITEM-O, DTALLY-O, DRAWLOT-O,
                 DINVRCD-O, DINVITM-O, DINVACCT-O, MSTORERM-I
                 DRCVCORR-O, DTRAILER-O, DPOTRACK-O, DRELTRAK-O
                 DRCVTRAK-O.
           GOBACK.

       1-HSK.
      *---------- CHECK FIRST CHARACTER OF BASE FIELD TO SEE IF
      *---------- PROGRAM CALLED FROM PO MOVE TO HISTORY ROUTINE.
           IF BASE (1:1) = "H"
               MOVE "Y" TO ITEM-TO-HISTORY-SW
               MOVE " " TO BASE (1:1)
           ELSE
               MOVE "N" TO ITEM-TO-HISTORY-SW.

           OPEN INPUT MSTORERM-I.
           OPEN I-O DPORECD-O, MPORCV-O, DVENDOR-O, DVENDITM-O,
                    DPOITEM-O, DDAILYTC-O, DPODATAITM-O, DREQD-O,
                    MREQ-O, DREQITM-O, DREQDESC-O, DREQQUE-O,
                    DPOFREIGHT-O, DRCVITEM-O, DTALLY-O, DRAWLOT-O,
                    DINVRCD-O, DINVITM-O, DINVACCT-O, DRCVCORR-O,
                    DTRAILER-O, DPOTRACK-O, DRELTRAK-O DRCVTRAK-O.

       1-HSK-X.
           EXIT.



      ******************************************************
      **                                                  **
      **   BLOWUP ROUTINE                                 **
      **                                                  **
      ******************************************************

       2-BLOWUP.
           IF FILE-STATUS NUMERIC
               MOVE FILE-STATUS TO COND-WORD.
           MOVE "SDELTPO"  TO BU-PGM-NAME.
           CALL "TBLOWUP" USING BASE, BU-PGM-NAME, STATUS-AREA,
               DUMMY-VIEW-AREA, FILE-STATUS, BU-DISPLAY-MSG,
                   BU-DISPLAY-FLDS.



       6-MAIN.
           MOVE PO-ARG                TO  BU-DISPLAY-FLD (1).
           PERFORM 61-DELETE-PO-DATA  THRU  61-DPD-X.
           IF PO-NOT-FOUND
               GO TO 6-MAIN-X.

           PERFORM 62-DELETE-REQUISITIONS    THRU  62-DR-X.

           PERFORM 63-DELETE-RECEIVING-DATA  THRU  63-DRD-X.

           PERFORM 64-DELETE-INVOICING-DATA  THRU  64-DID-X.

           PERFORM 65-DELETE-MPORCV-ENTRIES  THRU  65-DME-X.

           PERFORM 66-DELETE-DPOTRACK-ENTRIES THRU 66-DDE-X.

           PERFORM 67-DELETE-DRELTRAK-ENTRIES THRU 67-DDE-X.

           PERFORM 68-DELETE-DRCVTRAK-ENTRIES THRU 68-DDE-X.

       6-MAIN-X.
           EXIT.


       61-DELETE-PO-DATA.
           MOVE SPACES                TO  PO-FOUND-SW.
           MOVE PO-ARG TO PORCVNO OF MPORCV-REC-O.
           START MPORCV-O KEY = PORCVNO OF MPORCV-REC-O
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00" AND FILE-STATUS-1 NOT = "2"
               MOVE "START MPORCV *61-DPD" TO BU-DISPLAY-MSG
               GO TO 2-BLOWUP.
           MOVE 0 TO COND-WORD.
           MOVE PO-ARG TO PORCVNO OF DPORECD-REC-O.
           START DPORECD-O KEY = PORCVNO OF DPORECD-REC-O
               INVALID KEY MOVE 17 TO COND-WORD.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
                   MOVE 17 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.
      *A   CALL "DBFIND" USING BASE, DSET-DPORECD, MODE1,
      *A       STATUS-AREA, PO-SEARCH, PO-ARG.
           IF COND-WORD NOT = 0
               IF COND-WORD = 17
                   MOVE SPACES TO BUF-DPORECD
                   GO TO  61-CHECK-FOR-RCVRS
               ELSE
                   MOVE "FIND DPORECD*61-DPD" TO BU-DISPLAY-MSG
                   GO TO 2-BLOWUP.
           MOVE 0 TO COND-WORD.
           READ DPORECD-O NEXT INTO BUF-DPORECD
               AT END MOVE 15 TO COND-WORD.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14"
                   MOVE 15 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.
           IF PORCVNO OF DPORECD-REC-O NOT = PO-ARG
               MOVE HIGH-VALUES TO PORCVNO OF DPORECD-REC-O
               START DPORECD-O KEY > PORCVNO OF DPORECD-REC-O
                 INVALID KEY MOVE "00" TO FILE-STATUS
               END-START
               MOVE 15 TO COND-WORD.
      *A   CALL "DBGET" USING BASE, DSET-DPORECD, MODE5,
      *A       STATUS-AREA, ALL-ITEMS, BUF-DPORECD, PO-ARG.
           IF COND-WORD NOT = 0
               IF COND-WORD = 15
                    MOVE SPACES  TO  BUF-DPORECD
                    GO TO 61-CHECK-FOR-RCVRS
                ELSE
                    MOVE "GET DPORECD*61-DPD" TO BU-DISPLAY-MSG
                    GO TO 2-BLOWUP.

           DELETE DPORECD-O
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE "DELETE DPORECD*61-DD" TO BU-DISPLAY-MSG
               GO TO 2-BLOWUP.

      ******** IF THE PO IS A NON-RECEIVABLE THEN THERE ARE NO
      ******** RECEIVING SLIPS SO MOVE ZERO TO LAST RECEIVING SLIP
      ******** THIS ALSO APPLIES TO PO's THAT HAVE NO RECEIVING SLIPS
      ******** FOR SOME OTHER REASON (M-PO-RCV-DATA=SPACES).

       61-CHECK-FOR-RCVRS.
           MOVE 0 TO COND-WORD.
           MOVE PO-ARG TO PORCVNO OF MPORCV-REC-O.
           READ MPORCV-O INTO BUF-MPORCV
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD.
      *A   CALL "DBGET" USING BASE, DSET-MPORCV, MODE7,
      *A       STATUS-AREA, ALL-ITEMS, BUF-MPORCV, PO-ARG.
           IF COND-WORD NOT = 0
               MOVE "GET MPORCV*61-DPD" TO BU-DISPLAY-MSG
               GO TO 2-BLOWUP.

           MOVE HIGH-VALUES TO PORCVNO OF MPORCV-REC-O.
           START MPORCV-O KEY > PORCVNO OF MPORCV-REC-O
             INVALID KEY MOVE "00" TO FILE-STATUS
           END-START.
           IF M-PO-LAST-RCVR-X NUMERIC
               MOVE M-PO-LAST-RCVR    TO  SAVE-LAST-RCVR
           ELSE
               MOVE ZEROS             TO  SAVE-LAST-RCVR.

      *------ CHECK FOR TEMPORARY VENDOR AND DELETE
           IF PO-VEN-CODE-T = "T"
               PERFORM 611-DELETE-TEMP-VENDOR  THRU  611-DTV-X.

      *------ DELETE ITEMS
           PERFORM 612-DELETE-PO-ITEMS  THRU  612-DPI-X.

      *------ DELETE TRAILER COMMENTS
           PERFORM 613-DELETE-TRAILERS  THRU  613-DT-X.

       61-DPD-X.
           EXIT.


       611-DELETE-TEMP-VENDOR.
           MOVE PO-VEN-CODE  TO VEN-ARG.
           MOVE 0 TO COND-WORD.
           MOVE VEN-ARG TO VENCDE OF DVENDOR-REC-O.
           START DVENDOR-O KEY = VENCDE OF DVENDOR-REC-O
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
                   MOVE 17 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.
      *A   CALL "DBFIND" USING BASE, DSET-DVENDOR, MODE1,
      *A       STATUS-AREA, VEN-SEARCH, VEN-ARG.
           IF COND-WORD NOT = 0
               IF COND-WORD = 17
                   GO TO 611-DELETE-DVENDITM
               ELSE
                   MOVE "FIND DVENDOR*611-DTV" TO BU-DISPLAY-MSG
                   GO TO 2-BLOWUP.

       611-GET-DVENDOR.
           MOVE 0 TO COND-WORD.
           READ DVENDOR-O NEXT INTO BUF-DVENDOR
               AT END MOVE 15 TO COND-WORD.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14"
                   MOVE 15 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.
           IF VENCDE OF DVENDOR-REC-O NOT = VEN-ARG
               MOVE HIGH-VALUES TO VENCDE OF DVENDOR-REC-O
               START DVENDOR-O KEY > VENCDE OF DVENDOR-REC-O
                 INVALID KEY MOVE "00" TO FILE-STATUS
               END-START
               MOVE 15 TO COND-WORD.
      *A   CALL "DBGET" USING BASE, DSET-DVENDOR, MODE5,
      *A       STATUS-AREA, ALL-ITEMS, BUF-DVENDOR, VEN-ARG.
           IF COND-WORD NOT = 0
               IF COND-WORD = 15
                   GO TO 611-DELETE-DVENDITM
               ELSE
                   MOVE "GET DVENDOR*611-GD" TO BU-DISPLAY-MSG
                   GO TO 2-BLOWUP.
           DELETE DVENDOR-O
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE "DELETE DVENDOR*611-GD" TO BU-DISPLAY-MSG
               GO TO 2-BLOWUP.

           GO TO 611-GET-DVENDOR.

       611-DELETE-DVENDITM.
           MOVE 0 TO COND-WORD.
           MOVE VEN-ARG TO VENCDE OF DVENDITM-REC-O.
           START DVENDITM-O KEY = VENCDE OF DVENDITM-REC-O
               INVALID KEY MOVE 17 TO COND-WORD.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
                   MOVE 17 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.
      *A   CALL "DBFIND" USING BASE, DSET-DVENDITM, MODE1,
      *A       STATUS-AREA, VEN-SEARCH, VEN-ARG.
           IF COND-WORD NOT = 0
               IF COND-WORD = 17
                   GO TO 611-DTV-X
               ELSE
                   MOVE "FIND DVENDITM*611-DD" TO BU-DISPLAY-MSG
                   GO TO 2-BLOWUP.

       611-GET-DVENDITM.
           MOVE 0 TO COND-WORD.
           READ DVENDITM-O NEXT INTO BUF-DVENDITM
               AT END MOVE 15 TO COND-WORD.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14"
                   MOVE 15 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.
           IF VENCDE OF DVENDITM-REC-O NOT = VEN-ARG
               MOVE HIGH-VALUES TO VENCDE OF DVENDITM-REC-O
               START DVENDITM-O KEY > VENCDE OF DVENDITM-REC-O
                 INVALID KEY MOVE "00" TO FILE-STATUS
               END-START
               MOVE 15 TO COND-WORD.
      *A   CALL "DBGET" USING BASE, DSET-DVENDITM, MODE5,
      *A       STATUS-AREA, ALL-ITEMS, BUF-DVENDITM, VEN-ARG.
           IF COND-WORD NOT = 0
               IF COND-WORD = 15
                   GO TO 611-DTV-X
               ELSE
                   MOVE "GET DVENDITM*611-GD" TO BU-DISPLAY-MSG
                   GO TO 2-BLOWUP.

           DELETE DVENDITM-O
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE "DELETE DVENDITM*611-GD" TO BU-DISPLAY-MSG
               GO TO 2-BLOWUP.

           GO TO 611-GET-DVENDITM.

       611-DTV-X.
           EXIT.


       612-DELETE-PO-ITEMS.
           MOVE 0 TO COND-WORD.
           MOVE PO-ARG TO PORCVNO OF DPOITEM-REC-O.
           START DPOITEM-O KEY = PORCVNO OF DPOITEM-REC-O
               INVALID KEY MOVE 17 TO COND-WORD.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
                   GO TO 612-FIND-DPODATAITM
               ELSE
                   MOVE 99 TO COND-WORD.
      *A   CALL "DBFIND" USING BASE, DSET-DPOITEM, MODE1,
      *A       STATUS-AREA, PO-SEARCH, PO-ARG.
           IF COND-WORD NOT = 0
               MOVE "FIND DPOITEM * 612-DPI" TO BU-DISPLAY-MSG
               GO TO 2-BLOWUP.

       612-GET-DPOITEM.
           MOVE 0 TO COND-WORD.
           READ DPOITEM-O NEXT INTO BUF-DPOITEM
               AT END MOVE 15 TO COND-WORD.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14"
                   MOVE 15 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.
           IF PORCVNO OF DPOITEM-REC-O NOT = PO-ARG
               MOVE HIGH-VALUES TO PORCVNO OF DPOITEM-REC-O
               START DPOITEM-O KEY > PORCVNO OF DPOITEM-REC-O
                 INVALID KEY MOVE "00" TO FILE-STATUS
               END-START
               MOVE 15 TO COND-WORD.
      *A   CALL "DBGET" USING BASE, DSET-DPOITEM, MODE5,
      *A         STATUS-AREA, ALL-ITEMS, BUF-DPOITEM, PO-ARG.
           IF COND-WORD NOT = 0
               IF COND-WORD = 15
                   GO TO 612-FIND-DPODATAITM
               ELSE
                   MOVE "GET DPOITEM*612-GD" TO BU-DISPLAY-MSG
                   GO TO 2-BLOWUP.

           IF ITM-QTY-DLVR < ITM-QTY-ORD
               PERFORM 6121-ADJUST-ONORDER THRU 6121-AO-X.

           DELETE DPOITEM-O
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE "DELETE DPOITEM*612-DD" TO BU-DISPLAY-MSG
               GO TO 2-BLOWUP.

       612-PUT-DDAILYTC.
           MOVE SPACES                TO  BUF-DDAILYTC.
           MOVE 1                     TO  DATE-MODE.
           CALL "TDATECHK" USING DATE-CHECK-AREA.
           MOVE DATE-YMD-OUT          TO  DDAILYTC-DATE.
           ACCEPT DDAILYTC-TIME FROM TIME.
           MOVE "32D"                 TO  DDAILYTC-TC.
           MOVE COMPANY-SAVE          TO  DDAILYTC-PLT.
           MOVE ITM-CORP-CODE         TO  TC32D-CORP-CODE.
           MOVE ITM-PO-RCV-NO         TO  TC32D-PO-RLS.
           MOVE ITM-NUMBER            TO  TC32D-ITEM-NO.
           IF ITEM-TO-HISTORY-SW = "Y"
               MOVE "H"               TO  TC32D-ITEM-STATUS.
           WRITE DDAILYTC-REC-O FROM BUF-DDAILYTC
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE "PUT DDAILYTC 612-PD" TO BU-DISPLAY-MSG
               GO TO 2-BLOWUP.

           GO TO 612-GET-DPOITEM.

       612-FIND-DPODATAITM.
           MOVE 0 TO COND-WORD.
           MOVE PO-ARG TO PORCVNO OF DPODATAITM-REC-O.
           START DPODATAITM-O KEY = PORCVNO OF DPODATAITM-REC-O
               INVALID KEY MOVE 17 TO COND-WORD.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
                   GO TO 612-DPI-X
               ELSE
                   MOVE 99 TO COND-WORD.
      *A   CALL "DBFIND" USING BASE, DSET-DPODATAITM, MODE1,
      *A       STATUS-AREA, PO-SEARCH, PO-ARG.
           IF COND-WORD NOT = 0
               MOVE "FIND DPODATAITM*612-FD" TO BU-DISPLAY-MSG
               GO TO 2-BLOWUP.

       612-GET-DPODATAITM.
           MOVE 0 TO COND-WORD.
           READ DPODATAITM-O NEXT INTO BUF-DPODATAITM
               AT END MOVE 15 TO COND-WORD.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14"
                   MOVE 15 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.
           IF PORCVNO OF DPODATAITM-REC-O NOT = PO-ARG
               MOVE HIGH-VALUES TO PORCVNO OF DPODATAITM-REC-O
               START DPODATAITM-O KEY > PORCVNO OF DPODATAITM-REC-O
                 INVALID KEY MOVE "00" TO FILE-STATUS
               END-START
               MOVE 15 TO COND-WORD.
      *A   CALL "DBGET" USING BASE, DSET-DPODATAITM, MODE5,
      *A       STATUS-AREA, ALL-ITEMS, BUF-DPODATAITM, PO-ARG.
           IF COND-WORD NOT = 0
               IF COND-WORD = 15
                   GO TO 612-DPI-X
               ELSE
                   MOVE "GET DPODATAITM*612-GD" TO BU-DISPLAY-MSG
                   GO TO 2-BLOWUP.

           DELETE DPODATAITM-O
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE "DELETE DPODATA*612-DD" TO BU-DISPLAY-MSG
               GO TO 2-BLOWUP.

           GO TO 612-GET-DPODATAITM.

       612-DPI-X.
           EXIT.

       6121-ADJUST-ONORDER.
           IF ITM-CORP-CODE = "NON-STR"
               GO TO 6121-CUT-DDAILYTC-321.

           MOVE ITM-CORP-CODE         TO  CODE-ARG.
           MOVE 0 TO COND-WORD.
           MOVE CODE-ARG TO CORPCDE OF MSTORERM-REC-I.
           READ MSTORERM-I INTO BUF-MSTORERM
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD.
      *A   CALL "DBGET" USING BASE, DSET-MSTORERM, MODE7,
      *A       STATUS-AREA, ALL-ITEMS, BUF-MSTORERM, CODE-ARG.
           IF COND-WORD NOT = 0
               MOVE "GET MSTORERM*6121-AO" TO BU-DISPLAY-MSG
               GO TO 2-BLOWUP.

       6121-CUT-DDAILYTC-321.
           MOVE SPACES                  TO  STC320-PARMS.
           MOVE "21"                    TO  STC320-ITEM-TC-ID.
           MOVE COMPANY-SAVE            TO  STC320-COMPANY-SAVE.
           IF ITM-CORP-CODE = "NON-STR"
               MOVE "NC"                TO  STC320-CODE
           ELSE
               MOVE ITM-CORP-CODE       TO  STC320-CODE.
           MOVE ITM-PO-RCV-NO           TO  STC320-PO-NUM.
           MOVE ITM-NUMBER              TO  STC320-ITEM.
           IF ITM-CORP-CODE = "NON-STR"
               MOVE ITM-QTY-DLVR        TO  STC320-QTY
               MOVE ITM-UM              TO  STC320-QTY-UM
           ELSE
           IF ITM-UM = STR-UM
               MOVE ITM-QTY-DLVR        TO  STC320-QTY
               MOVE ITM-UM              TO  STC320-QTY-UM
           ELSE
           IF ITM-UM = STR-UM1
               MULTIPLY ITM-QTY-DLVR       BY  STR-UM1-CF
                                       GIVING STC320-QTY ROUNDED
               MULTIPLY ITM-QTY-ORD        BY  STR-UM1-CF
                                       GIVING ITM-QTY-ORD ROUNDED
               MOVE STR-UM              TO  STC320-QTY-UM
           ELSE
           IF ITM-UM = STR-UM2
               MULTIPLY ITM-QTY-DLVR       BY  STR-UM2-CF
                                       GIVING STC320-QTY ROUNDED
               MULTIPLY ITM-QTY-ORD        BY  STR-UM2-CF
                                       GIVING ITM-QTY-ORD ROUNDED
               MOVE STR-UM              TO  STC320-QTY-UM
           ELSE
               MOVE ZEROS               TO  STC320-QTY
               MOVE STR-UM              TO  STC320-QTY-UM.

           IF ITM-CORP-CODE = "NON-STR"
               MOVE ITM-UNIT-PRICE      TO  STC320-PRICE
               MOVE ITM-PRICE-UM        TO  STC320-PRICE-UM
           ELSE
           IF ITM-PRICE-UM = STR-UM
               MOVE ITM-UNIT-PRICE      TO  STC320-PRICE
               MOVE ITM-PRICE-UM        TO  STC320-PRICE-UM
             ELSE
           IF ITM-PRICE-UM = STR-UM1
               DIVIDE ITM-UNIT-PRICE    BY  STR-UM1-CF
                                       GIVING STC320-PRICE  ROUNDED
               MOVE STR-UM              TO  STC320-PRICE-UM
             ELSE
           IF ITM-PRICE-UM = STR-UM2
               DIVIDE ITM-UNIT-PRICE    BY  STR-UM2-CF
                                       GIVING STC320-PRICE ROUNDED
               MOVE STR-UM              TO  STC320-PRICE-UM
           ELSE
               MOVE ZEROS               TO  STC320-PRICE
               MOVE STR-UM              TO  STC320-PRICE-UM.

      **** MULTIPLY ITM-QTY-ORD  BY  STC320-PRICE
      ****                      GIVING STC320-OLD-BUDGET-AMT ROUNDED.

           MOVE ITM-QTY-ORD      TO  SCALCBGT-QTY.
           MOVE STC320-PRICE     TO  SCALCBGT-PRICE.
           MOVE ITM-TAX-CODE     TO  SCALCBGT-TAX-CODE.
           MOVE 0                TO  SCALCBGT-BUDGET.
           CALL "SCALCBGT"  USING  SCALCBGT-PARMS.
           MOVE SCALCBGT-BUDGET  TO  STC320-OLD-BUDGET-AMT.

           MOVE ITM-TAX-CODE            TO  STC320-TAX-CODE.
           MOVE ITM-CLASS               TO  STC320-SUB.
           IF ITM-CORP-CODE = "NON-STR"
               NEXT SENTENCE
           ELSE
               IF STC320-SUB = SPACES
                   MOVE STR-CLASS       TO  STC320-SUB.
           MOVE ITM-SUB-DETL            TO  STC320-SUBD.
           MOVE ITM-ADDL-DATA           TO  STC320-ADDTL-DATA.
           MOVE PO-BUDGET-NUMBER        TO  STC320-BUDGET-NO.
           MOVE PO-CURRENCY-CODE        TO  STC320-CUR-CODE.
           CALL "STC320" USING BASE,
                               STC320-PARMS,
                               STATUS-AREA,
                               BU-DISPLAY-MSG,
                               BU-DISPLAY-FLDS.
           IF BU-DISPLAY-MSG-1  NOT = SPACES
               GO TO 2-BLOWUP.

       6121-AO-X.
           EXIT.


       613-DELETE-TRAILERS.
           MOVE 0 TO COND-WORD.
           MOVE PO-ARG TO PORCVNO OF DTRAILER-REC-O.
           START DTRAILER-O KEY = PORCVNO OF DTRAILER-REC-O
               INVALID KEY MOVE 17 TO COND-WORD.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
                   GO TO 613-DT-X
               ELSE
               MOVE 99 TO COND-WORD.
           IF COND-WORD NOT = 0
               MOVE "FIND DTRAILER*613-DT" TO BU-DISPLAY-MSG
               GO TO 2-BLOWUP.

       613-GET-DTRAILER.
           MOVE 0 TO COND-WORD.
           READ DTRAILER-O NEXT INTO BUF-DTRAILER
               AT END MOVE 15 TO COND-WORD.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14"
                   MOVE 15 TO COND-WORD
               ELSE
               MOVE 99 TO COND-WORD.
           IF PORCVNO OF DTRAILER-REC-O NOT = PO-ARG
               MOVE HIGH-VALUES TO PORCVNO OF DTRAILER-REC-O
               START DTRAILER-O KEY > PORCVNO OF DTRAILER-REC-O
                 INVALID KEY MOVE "00" TO FILE-STATUS
               END-START
               MOVE 15 TO COND-WORD.
           IF COND-WORD NOT = 0
               IF COND-WORD = 15
                   GO TO 613-DT-X
               ELSE
               MOVE "GET DTRAILER*613-GT" TO BU-DISPLAY-MSG
               GO TO 2-BLOWUP.

           DELETE DTRAILER-O
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE "DELETE DTRAILER*613-DT" TO BU-DISPLAY-MSG
               GO TO 2-BLOWUP.

           GO TO 613-GET-DTRAILER.

       613-DT-X.    EXIT.

      **************************************
      *                                    *
      *  DELETE ALL REQUISITIONS ASSOCIATED*
      *  WITH THE P.O. BY GOING THROUGH    *
      *  DREQD                             *
      *                                    *
      **************************************

       62-DELETE-REQUISITIONS.
           MOVE 0 TO COND-WORD.
           MOVE PO-ARG TO PORCVNO OF DREQD-REC-O.
           START DREQD-O KEY = PORCVNO OF DREQD-REC-O
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
                   GO TO 62-DR-X
               ELSE
                   MOVE 99 TO COND-WORD.
      *A   CALL "DBFIND" USING BASE, DSET-DREQD, MODE1,
      *A       STATUS-AREA, PO-SEARCH, PO-ARG.
           IF COND-WORD NOT = 0
               MOVE "FIND DREQD*62-DR" TO BU-DISPLAY-MSG
               GO TO 2-BLOWUP.

       62-GET-DREQD.
           MOVE 0 TO COND-WORD.
           READ DREQD-O NEXT INTO BUF-DREQD
               AT END MOVE 15 TO COND-WORD.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   MOVE 15 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.
           IF PORCVNO OF DREQD-REC-O NOT = PO-ARG
               MOVE HIGH-VALUES TO PORCVNO OF DREQD-REC-O
               START DREQD-O KEY > PORCVNO OF DREQD-REC-O
                 INVALID KEY MOVE "00" TO FILE-STATUS
               END-START
               MOVE 15 TO COND-WORD.
      *A   CALL "DBGET" USING BASE, DSET-DREQD, MODE5,
      *A       STATUS-AREA, ALL-ITEMS, BUF-DREQD, PO-ARG.
           IF COND-WORD NOT = 0
               IF COND-WORD  =  15
                   GO TO 62-DR-X
               ELSE
                   MOVE "GET DREQD*62-GD" TO BU-DISPLAY-MSG
                   GO TO 2-BLOWUP.

           MOVE DREQD-REQ-NUMBER  TO  REQ-ARG.
           DELETE DREQD-O
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE "DELETE DREQD*62-GD" TO BU-DISPLAY-MSG
               GO TO 2-BLOWUP.

           PERFORM 621-DELETE-REQ-ITEMS THRU 621-DRI-X.

           PERFORM 621-DELETE-REQ-DESC THRU 621-DRD-X.

           PERFORM 621-DELETE-DREQQUE THRU 621-DD-X.

       62-DELETE-MREQ.
           MOVE 0 TO COND-WORD.
           MOVE REQ-ARG TO REQNO OF MREQ-REC-O.
           READ MREQ-O INTO BUF-MREQ
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD.
      *A   CALL "DBGET" USING BASE, DSET-MREQ, MODE7, STATUS-AREA,
      *A       ALL-ITEMS, BUF-MREQ, REQ-ARG.
           IF COND-WORD NOT = 0
               MOVE "GET MREQ*62-DM" TO BU-DISPLAY-MSG
               GO TO 2-BLOWUP.

           DELETE MREQ-O
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE "DELETE MREQ*62-DM" TO BU-DISPLAY-MSG
               GO TO 2-BLOWUP.

           GO TO 62-GET-DREQD.

       62-DR-X.
           EXIT.

       621-DELETE-REQ-ITEMS.
           MOVE 0 TO COND-WORD.
           MOVE REQ-ARG TO REQNO OF DREQITM-REC-O.
           START DREQITM-O KEY = REQNO OF DREQITM-REC-O
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
                   GO TO 621-DRI-X
               ELSE
                   MOVE 99 TO COND-WORD.
      *A   CALL "DBFIND" USING BASE, DSET-DREQITM, MODE1,
      *A       STATUS-AREA, REQ-SEARCH, REQ-ARG.
           IF COND-WORD NOT = 0
               MOVE "FIND REQ ITEMS*621-DRI" TO BU-DISPLAY-MSG
               GO TO 2-BLOWUP.

       621-GET-DREQITM.
           MOVE 0 TO COND-WORD.
           READ DREQITM-O NEXT INTO BUF-DREQITM
               AT END MOVE 15 TO COND-WORD.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14"
                   MOVE 15 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.
           IF REQNO OF DREQITM-REC-O NOT = REQ-ARG
               MOVE HIGH-VALUES TO REQNO OF DREQITM-REC-O
               START DREQITM-O KEY > REQNO OF DREQITM-REC-O
                 INVALID KEY MOVE "00" TO FILE-STATUS
               END-START
               MOVE 15 TO COND-WORD.
      *A   CALL "DBGET" USING BASE, DSET-DREQITM, MODE5,
      *A       STATUS-AREA, ALL-ITEMS, BUF-DREQITM, REQ-ARG.
           IF COND-WORD NOT = 0
               IF COND-WORD = 15
                   GO TO 621-DRI-X
               ELSE
                   MOVE "GET REQ ITEMS*621-GD" TO BU-DISPLAY-MSG
                   GO TO 2-BLOWUP.

           DELETE DREQITM-O
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE "DELETE REQ ITEM*621-GD" TO BU-DISPLAY-MSG
               GO TO 2-BLOWUP.

           GO TO 621-GET-DREQITM.

       621-DRI-X.
           EXIT.

       621-DELETE-REQ-DESC.
           MOVE 0 TO COND-WORD.
           MOVE REQ-ARG TO REQNO OF DREQDESC-REC-O.
           START DREQDESC-O KEY = REQNO OF DREQDESC-REC-O
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
                   GO TO 621-DRD-X
               ELSE
                   MOVE 99 TO COND-WORD.
      *A   CALL "DBFIND" USING BASE, DSET-DREQDESC, MODE1,
      *A       STATUS-AREA, REQ-SEARCH, REQ-ARG.
           IF COND-WORD NOT = 0
               MOVE "FIND REQ DESC*621-DRD" TO BU-DISPLAY-MSG
               GO TO 2-BLOWUP.

       621-GET-DREQDESC.
           MOVE 0 TO COND-WORD.
           READ DREQDESC-O NEXT INTO BUF-DREQDESC
               AT END MOVE 15 TO COND-WORD.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14"
                   MOVE 15 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.
           IF REQNO OF DREQDESC-REC-O NOT = REQ-ARG
               MOVE HIGH-VALUES TO REQNO OF DREQDESC-REC-O
               START DREQDESC-O KEY > REQNO OF DREQDESC-REC-O
                 INVALID KEY MOVE "00" TO FILE-STATUS
               END-START
               MOVE 15 TO COND-WORD.
      *A   CALL "DBGET" USING BASE, DSET-DREQDESC, MODE5,
      *A       STATUS-AREA, ALL-ITEMS, BUF-DREQDESC, REQ-ARG.
           IF COND-WORD NOT = 0
               IF COND-WORD = 15
                   GO TO 621-DRD-X
               ELSE
                   MOVE "GET REQ DESC*621-GD" TO BU-DISPLAY-MSG
                   GO TO 2-BLOWUP.

           DELETE DREQDESC-O
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE "DELETE REQ DESC*621-GD" TO BU-DISPLAY-MSG
               GO TO 2-BLOWUP.

           GO TO 621-GET-DREQDESC.

       621-DRD-X.
           EXIT.


       621-DELETE-DREQQUE.
           MOVE REQ-ARG TO REQNO OF DREQQUE-REC-O.
           START DREQQUE-O KEY = REQNO OF DREQQUE-REC-O
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
                   GO TO 621-DD-X
               ELSE
                   MOVE "START REQQUE*621-DD" TO BU-DISPLAY-MSG
                   GO TO 2-BLOWUP.

       621-GET-DREQQUE.
           READ DREQQUE-O NEXT INTO BUF-DREQQUE
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14"
                   GO TO 621-DD-X
               ELSE
                   MOVE "READ DREQQUE *621-GD" TO BU-DISPLAY-MSG
                   GO TO 2-BLOWUP.
           IF REQNO OF DREQQUE-REC-O NOT = REQ-ARG
               MOVE HIGH-VALUES TO REQNO OF DREQQUE-REC-O
               START DREQQUE-O KEY > REQNO OF DREQQUE-REC-O
                 INVALID KEY MOVE "00" TO FILE-STATUS
               END-START
               GO TO 621-DD-X.

           DELETE DREQQUE-O
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE "DELETE REQQUE*621-GD" TO BU-DISPLAY-MSG
               GO TO 2-BLOWUP.

           GO TO 621-GET-DREQQUE.

       621-DD-X.
           EXIT.




       63-DELETE-RECEIVING-DATA.
           MOVE PO-ARG                TO  RCVR-ARG.

      ****** DELETE ALL FREIGHT BILLS FOUND UNDER THE PO NUMBER KEY
      ****** SINCE THESE FREIGHT BILLS CAN BE PUT OUT BY THE INVOICE
      ****** PROCESSING PROGRAM.

           PERFORM 631-DELETE-FREIGHT-INFO  THRU  631-DFI-X.

       63-DELETE-RCVR-LOOP.
           IF SAVE-LAST-RCVR = RCVR-PO-RCVR
               GO TO 63-DRD-X.
           ADD 1  TO  RCVR-PO-RCVR.
           PERFORM 631-DELETE-FREIGHT-INFO  THRU  631-DFI-X.

      ******** DELETE RECEIVING SLIP ITEMS

           PERFORM 632-DELETE-RCV-SLIP  THRU  632-DRS-X.

      ******** DELETE DTALLY DATA SET

           PERFORM 633-DELETE-DTALLY  THRU  633-DD-X.

      ******** DELETE DRAWLOT DATA SET

           PERFORM 634-DELETE-DRAWLOT  THRU  634-DD-X.

      ******** DELETE RECEIVING CORRECTION EXPLANATIONS
           PERFORM 635-DELETE-DRCVCORR THRU 635-DD-X.

           GO TO 63-DELETE-RCVR-LOOP.

       63-DRD-X.
           EXIT.

       631-DELETE-FREIGHT-INFO.
           MOVE 0 TO COND-WORD.
           MOVE RCVR-ARG TO PORCVNO OF DPOFREIGHT-REC-O.
           START DPOFREIGHT-O KEY = PORCVNO OF DPOFREIGHT-REC-O
               INVALID KEY MOVE 17 TO COND-WORD.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
                   MOVE 17 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.
      *A   CALL "DBFIND" USING BASE, DSET-DPOFREIGHT, MODE1,
      *A       STATUS-AREA, PO-SEARCH, RCVR-ARG.
           IF COND-WORD NOT = 0
               IF COND-WORD = 17
                   GO TO 631-DFI-X
               ELSE
                   MOVE "FIND DPOFREIGHT * 631-DFI" TO BU-DISPLAY-MSG
                   GO TO 2-BLOWUP.

       631-GET-FREIGHT-LOOP.
           MOVE 0 TO COND-WORD.
           READ DPOFREIGHT-O NEXT INTO BUF-DPOFREIGHT
               AT END MOVE 15 TO COND-WORD.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14"
                   MOVE 15 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.
           IF PORCVNO OF DPOFREIGHT-REC-O NOT = RCVR-ARG
               MOVE HIGH-VALUES TO PORCVNO OF DPOFREIGHT-REC-O
               START DPOFREIGHT-O KEY > PORCVNO OF DPOFREIGHT-REC-O
                 INVALID KEY MOVE "00" TO FILE-STATUS
               END-START
               MOVE 15 TO COND-WORD.
      *A   CALL "DBGET" USING BASE, DSET-DPOFREIGHT, MODE5,
      *A         STATUS-AREA, ALL-ITEMS, BUF-DPOFREIGHT, RCVR-ARG.
           IF COND-WORD NOT = 0
               IF COND-WORD = 15
                   GO TO 631-DFI-X
               ELSE
                   MOVE "GET DPOFREIGHT*631-GFL" TO BU-DISPLAY-MSG
                   GO TO 2-BLOWUP.

           DELETE DPOFREIGHT-O
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE "DELETE DPOFREIGHT*631-DF" TO BU-DISPLAY-MSG
               GO TO 2-BLOWUP.

           GO TO 631-GET-FREIGHT-LOOP.

       631-DFI-X.
           EXIT.

