           COPY SCREENIO       IN COPYLIB.

           COPY CATREAD        IN COPYLIB.

           COPY JCWAREA        IN COPYLIB.

           COPY VCOMAREA       IN COPYLIB.

           COPY OVRPFDATA      IN COPYLIB.

       01  MESSAGE-FILE-DATA.
           COPY ERRORLIN       IN COPYLIB.

       01  WO-BASIC-DATA.
           COPY DWOBASIC       IN COPYLIB.

       01  WO-PLANNED-DATA.
           COPY DWOPLAN        IN COPYLIB.

       01  LAST-WO-USED-DATA.
           COPY MLASTWO        IN COPYLIB.

       01  ZONE-DATA.
           COPY MZONPRTY       IN COPYLIB.

       01  PM-QUEUE-DATA.
           COPY DPMOPENQ       IN COPYLIB.

       LINKAGE SECTION.
       01  DBPARAMETERS.
           COPY DBPARMS        IN COPYLIB.

       PROCEDURE DIVISION      USING DBPARAMETERS.
       BEGIN-SORT SECTION 01.
       CHECK-PASSWORD.
           CALL "TPWORD"       USING PASSWORD-INFORMATION.
           IF PASSWORD-FLAG NOT = "N"
               GO TO OPEN-FILES.
           GOBACK.

       OPEN-FILES.
           CALL "CLPMLISTQ".
           MOVE SPACES         TO LAST-WO-USED-DATA
                                  WO-BASIC-DATA PR-ON-SW
                                  EQP-MSG SEARCH-KEY.

           OPEN INPUT          WO-LAST-NUM-USED.
           READ  WO-LAST-NUM-USED INTO LAST-WO-USED-DATA
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = ZEROS
               MOVE " "        TO PR-ON-SW.

           IF J-SWITCH = "O"
               MOVE "O"        TO PR-ON-SW.

           CLOSE               WO-LAST-NUM-USED.

           MOVE "1"            TO SORT-SW.
           MOVE 0              TO PRINT-SW.
           OPEN I-O            DISPLAY-FILE.
           OPEN INPUT          WO-PLANNED.
           OPEN INPUT          WO-ZONE-PRTY.
           OPEN INPUT          PM-OPEN-QUEUE.
           ACCEPT MC-LOCAL-DATA-AREA FROM LOCAL-DATA-AREA.
      *    MOVE 0              TO OVRPRTF-TOFILE-NUM.
           MOVE "P "           TO OVRPRTF-TOFILE-NUM-X.
           MOVE "MCPRT"        TO OVRPRTF-FILE.
           PERFORM 996-OVERRIDE-PRINT-FILE.

       BEGIN-PROC.
           PERFORM 1-HSK THRU 1-EXIT.
           GO TO 6-MAIN.

       END-OF-JOB.
           CLOSE               DISPLAY-FILE.
           CLOSE               WO-PLANNED.
           CLOSE               WO-ZONE-PRTY.
           CLOSE               PM-OPEN-QUEUE.
           CLOSE               OUT-FILE.
           GOBACK.

       1-HSK.
           MOVE SPACES         TO MESSAGE-BUFFER
                                  SCREEN-DATA
                                  ZONE-SCREEN-DATA
                                  SAVE-MSG.
      **********************************************************************
      **    MESSAGE 031/058:
      ** EQUIPMENT SEARCH FOR:
      **********************************************************************
           MOVE  31            TO CATREAD-MSG-SET.
           MOVE  58            TO CATREAD-MSG-NUM.
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
           MOVE MESSAGE-BUFFER TO SAVE-MSG.

      **********************************************************************
      **    MESSAGE 052/009:
      ** Z O N E
      **********************************************************************
           MOVE  52            TO CATREAD-MSG-SET.
           MOVE   9            TO CATREAD-MSG-NUM.
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
           MOVE MESSAGE-BUFFER TO SAVE-TITLE.
           IF SAVE-TITLE = SPACES
               MOVE "Z O N E   " TO SAVE-TITLE ZONE-TITLE.

           IF JCW-ZJCW-269 = "    "
               CALL "TRTVZONE" USING ZONE-FIELD
               IF ZONE-FIELD = SPACES
                   GO TO END-OF-JOB
               ELSE
                   ACCEPT MC-LOCAL-DATA-AREA FROM LOCAL-DATA-AREA.

           MOVE JCW-ZJCW-269   TO ZONE-BUF Z-ARG.
           MOVE ZONE-ARGUMENT  TO ZONE-DATA.

           MOVE ZONE-FIELD     TO ZONE-DISP P-ZONE.
           MOVE "Q-FACT"       TO SORT-KEY P-SORT.
           IF SORT-SW = "2"    MOVE "STATUS" TO SORT-KEY P-SORT.
           IF SORT-SW = "3"    MOVE "EQUIP." TO SORT-KEY P-SORT.
           MOVE "VPMQUEUE"     TO SCREEN-NAME.

       1-EXIT.                 EXIT.

       6-MAIN.
           MOVE 0              TO ACT-KEY PAGE-CTR.
           MOVE 60             TO LINE-CTR.
           MOVE SPACES         TO MESSAGE-BUFFER.

           IF SORT-SW = "2"
               SORT SORT-FILE  ASCENDING  KEY SORT-STATUS
                                              SORT-EQUIP
                                              SORT-WO-NUM
                   INPUT  PROCEDURE SORT-PMQ-RECS
                   OUTPUT PROCEDURE SORT-PMQ-OUT
           ELSE
           IF SORT-SW = "3"
               SORT SORT-FILE  ASCENDING  KEY SORT-EQUIP
                               DESCENDING KEY SORT-PM-QUEUE
                               ASCENDING  KEY SORT-WO-NUM
                   INPUT  PROCEDURE SORT-PMQ-RECS
                   OUTPUT PROCEDURE SORT-PMQ-OUT
           ELSE
               SORT SORT-FILE  DESCENDING KEY SORT-PM-QUEUE
                               ASCENDING  KEY SORT-EQUIP
                               ASCENDING  KEY SORT-WO-NUM
                   INPUT  PROCEDURE SORT-PMQ-RECS
                   OUTPUT PROCEDURE SORT-PMQ-OUT.

           OPEN INPUT          OUT-FILE.
           IF ACT-KEY = 0
               MOVE SPACES     TO SCREEN-DATA
               MOVE SAVE-TITLE TO ZONE-TITLE
               MOVE ZONE-FIELD TO ZONE-DISP P-ZONE
               MOVE EQP-MSG    TO SEARCH-MSG P-MSG
               PERFORM SET-SORT-KEY
      **********************************************************************
      **    MESSAGE 040/002:
      ** NO WORK ORDERS IN THE BACKLOG FOR THIS ZONE
      **********************************************************************
               MOVE  40        TO CATREAD-MSG-SET
               MOVE   2        TO CATREAD-MSG-NUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER TO ERRMSG2
               GO TO 61-SHOWFORM.

           MOVE 0              TO ACT-KEY.

       61-RESET-SCREEN.
           MOVE 0              TO EOF-SW.
           MOVE "P"            TO FILE-SW.
           MOVE SPACES         TO SCREEN-DATA MESSAGE-BUFFER.
           MOVE SAVE-TITLE     TO ZONE-TITLE.
           MOVE ZONE-FIELD     TO ZONE-DISP P-ZONE.
           MOVE EQP-MSG        TO SEARCH-MSG P-MSG.
           MOVE "Q-FACT"       TO SORT-KEY P-SORT.
           IF SORT-SW = "2"    MOVE "STATUS" TO SORT-KEY P-SORT.
           IF SORT-SW = "3"    MOVE "EQUIP." TO SORT-KEY P-SORT.
           PERFORM 62-FILL-SCREEN THRU 62-FS-EXIT.

       61-SHOWFORM.
           MOVE "00"           TO SCREEN-STATUS.
           MOVE SCREEN-DATA    TO DISPLAY-REC.

           WRITE DISPLAY-REC   FORMAT IS SCREEN-NAME
               INDIC ARE SCREEN-INDICATORS.
           IF SCREEN-STATUS NOT = "00"
               DISPLAY "SCREEN WRITE ERROR.  SCREEN-STATUS IS "
                        SCREEN-STATUS
               GO TO END-OF-JOB.

           READ  DISPLAY-FILE  FORMAT IS SCREEN-NAME
               INDIC ARE SCREEN-INDICATORS
           IF SCREEN-STATUS NOT = "00"
               DISPLAY "SCREEN READ ERROR.  SCREEN-STATUS IS "
                        SCREEN-STATUS
               GO TO END-OF-JOB.

           MOVE DISPLAY-REC    TO SCREEN-DATA.
           MOVE ALL B"0"       TO SCREEN-INDICATORS.

           IF KEY-HIT = 3 OR 8
               GO TO END-OF-JOB.

           IF KEY-HIT = 1
               MOVE "    "     TO JCW-ZJCW-269
               CLOSE           OUT-FILE
               GO TO BEGIN-PROC.

           IF KEY-HIT = 2
               MOVE "1"        TO SORT-SW
               CLOSE           OUT-FILE
               GO TO BEGIN-PROC.

           IF KEY-HIT = 4
               PERFORM GET-SEARCH-KEY THRU GSK-EXIT
               CLOSE           OUT-FILE
               GO TO BEGIN-PROC.

           IF KEY-HIT = 5
               MOVE SPACES     TO EQP-MSG SEARCH-KEY
               CLOSE           OUT-FILE
               GO TO 6-MAIN.

           IF KEY-HIT = 6
               MOVE "2"        TO SORT-SW
               CLOSE           OUT-FILE
               GO TO BEGIN-PROC.

           IF KEY-HIT = 7
               MOVE "3"        TO SORT-SW
               CLOSE           OUT-FILE
               GO TO BEGIN-PROC.

           IF KEY-HIT = 9
               MOVE 1          TO PRINT-SW
               CLOSE           OUT-FILE
               ACCEPT CUR-DATE FROM DATE
               MOVE CUR-YY     TO P-DATE-YY
               MOVE CUR-MM     TO P-DATE-MM
               MOVE CUR-DD     TO P-DATE-DD
               ACCEPT TIME-BUF FROM TIME
               MOVE HRS        TO TIME-H
               MOVE MIN        TO TIME-M
               MOVE SEC        TO TIME-S
               MOVE TIME-EXP   TO P-TIME
               GO TO BEGIN-PROC.

           IF KEY-HIT NOT = 0
               GO TO 61-SHOWFORM.

           IF SPACE  = WO-S1   AND
                       WO-S2   AND
                       WO-S3   AND
                       WO-S4   AND
                       WO-S5   AND
                       WO-S6   AND
                       WO-S7   AND
                       WO-S8   AND
                       WO-S9   AND
                       WO-S10  AND
                       WO-S11  AND
                       WO-S12  AND
                       WO-S13  AND
                       WO-S14
               IF EOF-SW = 1
                   MOVE 0      TO EOF-SW
                   CLOSE       OUT-FILE
                   GO TO 6-MAIN.

           MOVE SPACE          TO WO-SW.
           IF WO-S1 NOT = SPACE
               MOVE WO-NUM-1   TO DWO-BUFFER
               MOVE WO-S1      TO WO-SW
               MOVE SPACE      TO WO-S1
               PERFORM 64-DISPLAY-WO THRU 64-EXIT.

           IF WO-S2 NOT = SPACE
               MOVE WO-NUM-2   TO DWO-BUFFER
               MOVE WO-S2      TO WO-SW
               MOVE SPACE      TO WO-S2
               PERFORM 64-DISPLAY-WO THRU 64-EXIT.

           IF WO-S3 NOT = SPACE
               MOVE WO-NUM-3   TO DWO-BUFFER
               MOVE WO-S3      TO WO-SW
               MOVE SPACE      TO WO-S3
               PERFORM 64-DISPLAY-WO THRU 64-EXIT.

           IF WO-S4 NOT = SPACE
               MOVE WO-NUM-4   TO DWO-BUFFER
               MOVE WO-S4      TO WO-SW
               MOVE SPACE      TO WO-S4
               PERFORM 64-DISPLAY-WO THRU 64-EXIT.

           IF WO-S5 NOT = SPACE
               MOVE WO-NUM-5   TO DWO-BUFFER
               MOVE WO-S5      TO WO-SW
               MOVE SPACE      TO WO-S5
               PERFORM 64-DISPLAY-WO THRU 64-EXIT.

           IF WO-S6 NOT = SPACE
               MOVE WO-NUM-6   TO DWO-BUFFER
               MOVE WO-S6      TO WO-SW
               MOVE SPACE      TO WO-S6
               PERFORM 64-DISPLAY-WO THRU 64-EXIT.

           IF WO-S7 NOT = SPACE
               MOVE WO-NUM-7   TO DWO-BUFFER
               MOVE WO-S7      TO WO-SW
               MOVE SPACE      TO WO-S7
               PERFORM 64-DISPLAY-WO THRU 64-EXIT.

           IF WO-S8 NOT = SPACE
               MOVE WO-NUM-8   TO DWO-BUFFER
               MOVE WO-S8      TO WO-SW
               MOVE SPACE      TO WO-S8
               PERFORM 64-DISPLAY-WO THRU 64-EXIT.

           IF WO-S9 NOT = SPACE
               MOVE WO-NUM-9   TO DWO-BUFFER
               MOVE WO-S9      TO WO-SW
               MOVE SPACE      TO WO-S9
               PERFORM 64-DISPLAY-WO THRU 64-EXIT.

           IF WO-S10 NOT = SPACE
               MOVE WO-NUM-10  TO DWO-BUFFER
               MOVE WO-S10     TO WO-SW
               MOVE SPACE      TO WO-S10
               PERFORM 64-DISPLAY-WO THRU 64-EXIT.

           IF WO-S11 NOT = SPACE
               MOVE WO-NUM-11  TO DWO-BUFFER
               MOVE WO-S11     TO WO-SW
               MOVE SPACE      TO WO-S11
               PERFORM 64-DISPLAY-WO THRU 64-EXIT.

           IF WO-S12 NOT = SPACE
               MOVE WO-NUM-12  TO DWO-BUFFER
               MOVE WO-S12     TO WO-SW
               MOVE SPACE      TO WO-S12
               PERFORM 64-DISPLAY-WO THRU 64-EXIT.

           IF WO-S13 NOT = SPACE
               MOVE WO-NUM-13  TO DWO-BUFFER
               MOVE WO-S13     TO WO-SW
               MOVE SPACE      TO WO-S13
               PERFORM 64-DISPLAY-WO THRU 64-EXIT.

           IF WO-S14 NOT = SPACE
               MOVE WO-NUM-14  TO DWO-BUFFER
               MOVE WO-S14     TO WO-SW
               MOVE SPACE      TO WO-S14
               PERFORM 64-DISPLAY-WO THRU 64-EXIT.

           IF WO-SW NOT = SPACE
               GO TO 61-SHOWFORM.

           GO TO 61-RESET-SCREEN.

       62-FILL-SCREEN.
           ADD 1               TO ACT-KEY.
           MOVE SPACES         TO OUT-REC.
           READ OUT-FILE       INVALID KEY
               MOVE 1          TO EOF-SW
               GO TO 62-FS-EXIT.
           IF ACT-KEY > MAX-KEY
               MOVE 1          TO EOF-SW
               GO TO 62-FS-EXIT.
           MOVE OUT-REC        TO LINE-1.
           MOVE OUT-DATE1      TO  DATE-MOVE.
           PERFORM DATE-ADJUST THRU DA-EXIT.
           MOVE DATE-DISP      TO DATE-1.
           MOVE OUT-DATE2      TO  DATE-MOVE.
           PERFORM DATE-ADJUST THRU DA-EXIT.
           MOVE DATE-DISP      TO DATP-1.

           ADD 1               TO ACT-KEY.
           MOVE SPACES         TO OUT-REC.
           READ OUT-FILE       INVALID KEY
               MOVE 1          TO EOF-SW
               GO TO 62-FS-EXIT.
           IF ACT-KEY > MAX-KEY
               MOVE 1          TO EOF-SW
               GO TO 62-FS-EXIT.
           MOVE OUT-REC        TO LINE-2.
           MOVE OUT-DATE1      TO  DATE-MOVE.
           PERFORM DATE-ADJUST THRU DA-EXIT.
           MOVE DATE-DISP      TO DATE-2.
           MOVE OUT-DATE2      TO  DATE-MOVE.
           PERFORM DATE-ADJUST THRU DA-EXIT.
           MOVE DATE-DISP      TO DATP-2.

           ADD 1               TO ACT-KEY.
           MOVE SPACES         TO OUT-REC.
           READ OUT-FILE       INVALID KEY
               MOVE 1          TO EOF-SW
               GO TO 62-FS-EXIT.
           IF ACT-KEY > MAX-KEY
               MOVE 1          TO EOF-SW
               GO TO 62-FS-EXIT.
           MOVE OUT-REC        TO LINE-3.
           MOVE OUT-DATE1      TO  DATE-MOVE.
           PERFORM DATE-ADJUST THRU DA-EXIT.
           MOVE DATE-DISP      TO DATE-3.
           MOVE OUT-DATE2      TO  DATE-MOVE.
           PERFORM DATE-ADJUST THRU DA-EXIT.
           MOVE DATE-DISP      TO DATP-3.

           ADD 1               TO ACT-KEY.
           MOVE SPACES         TO OUT-REC.
           READ OUT-FILE       INVALID KEY
               MOVE 1          TO EOF-SW
               GO TO 62-FS-EXIT.
           IF ACT-KEY > MAX-KEY
               MOVE 1          TO EOF-SW
               GO TO 62-FS-EXIT.
           MOVE OUT-REC        TO LINE-4.
           MOVE OUT-DATE1      TO  DATE-MOVE.
           PERFORM DATE-ADJUST THRU DA-EXIT.
           MOVE DATE-DISP      TO DATE-4.
           MOVE OUT-DATE2      TO  DATE-MOVE.
           PERFORM DATE-ADJUST THRU DA-EXIT.
           MOVE DATE-DISP      TO DATP-4.

           ADD 1               TO ACT-KEY.
           MOVE SPACES         TO OUT-REC.
           READ OUT-FILE       INVALID KEY
               MOVE 1          TO EOF-SW
               GO TO 62-FS-EXIT.
           IF ACT-KEY > MAX-KEY
               MOVE 1          TO EOF-SW
               GO TO 62-FS-EXIT.
           MOVE OUT-REC        TO LINE-5.
           MOVE OUT-DATE1      TO  DATE-MOVE.
           PERFORM DATE-ADJUST THRU DA-EXIT.
           MOVE DATE-DISP      TO DATE-5.
           MOVE OUT-DATE2      TO  DATE-MOVE.
           PERFORM DATE-ADJUST THRU DA-EXIT.
           MOVE DATE-DISP      TO DATP-5.

           ADD 1               TO ACT-KEY.
           MOVE SPACES         TO OUT-REC.
           READ OUT-FILE       INVALID KEY
               MOVE 1          TO EOF-SW
               GO TO 62-FS-EXIT.
           IF ACT-KEY > MAX-KEY
               MOVE 1          TO EOF-SW
               GO TO 62-FS-EXIT.
           MOVE OUT-REC        TO LINE-6.
           MOVE OUT-DATE1      TO  DATE-MOVE.
           PERFORM DATE-ADJUST THRU DA-EXIT.
           MOVE DATE-DISP      TO DATE-6.
           MOVE OUT-DATE2      TO  DATE-MOVE.
           PERFORM DATE-ADJUST THRU DA-EXIT.
           MOVE DATE-DISP      TO DATP-6.

           ADD 1               TO ACT-KEY.
           MOVE SPACES         TO OUT-REC.
           READ OUT-FILE       INVALID KEY
               MOVE 1          TO EOF-SW
               GO TO 62-FS-EXIT.
           IF ACT-KEY > MAX-KEY
               MOVE 1          TO EOF-SW
               GO TO 62-FS-EXIT.
           MOVE OUT-REC        TO LINE-7.
           MOVE OUT-DATE1      TO  DATE-MOVE.
           PERFORM DATE-ADJUST THRU DA-EXIT.
           MOVE DATE-DISP      TO DATE-7.
           MOVE OUT-DATE2      TO  DATE-MOVE.
           PERFORM DATE-ADJUST THRU DA-EXIT.
           MOVE DATE-DISP      TO DATP-7.

           ADD 1               TO ACT-KEY.
           MOVE SPACES         TO OUT-REC.
           READ OUT-FILE       INVALID KEY
               MOVE 1          TO EOF-SW
               GO TO 62-FS-EXIT.
           IF ACT-KEY > MAX-KEY
               MOVE 1          TO EOF-SW
               GO TO 62-FS-EXIT.
           MOVE OUT-REC        TO LINE-8.
           MOVE OUT-DATE1      TO  DATE-MOVE.
           PERFORM DATE-ADJUST THRU DA-EXIT.
           MOVE DATE-DISP      TO DATE-8.
           MOVE OUT-DATE2      TO  DATE-MOVE.
           PERFORM DATE-ADJUST THRU DA-EXIT.
           MOVE DATE-DISP      TO DATP-8.

           ADD 1               TO ACT-KEY.
           MOVE SPACES         TO OUT-REC.
           READ OUT-FILE       INVALID KEY
               MOVE 1          TO EOF-SW
               GO TO 62-FS-EXIT.
           IF ACT-KEY > MAX-KEY
               MOVE 1          TO EOF-SW
               GO TO 62-FS-EXIT.
           MOVE OUT-REC        TO LINE-9.
           MOVE OUT-DATE1      TO  DATE-MOVE.
           PERFORM DATE-ADJUST THRU DA-EXIT.
           MOVE DATE-DISP      TO DATE-9.
           MOVE OUT-DATE2      TO  DATE-MOVE.
           PERFORM DATE-ADJUST THRU DA-EXIT.
           MOVE DATE-DISP      TO DATP-9.

           ADD 1               TO ACT-KEY.
           MOVE SPACES         TO OUT-REC.
           READ OUT-FILE       INVALID KEY
               MOVE 1          TO EOF-SW
               GO TO 62-FS-EXIT.
           IF ACT-KEY > MAX-KEY
               MOVE 1          TO EOF-SW
               GO TO 62-FS-EXIT.
           MOVE OUT-REC        TO LINE-10.
           MOVE OUT-DATE1      TO  DATE-MOVE.
           PERFORM DATE-ADJUST THRU DA-EXIT.
           MOVE DATE-DISP      TO DATE-10.
           MOVE OUT-DATE2      TO  DATE-MOVE.
           PERFORM DATE-ADJUST THRU DA-EXIT.
           MOVE DATE-DISP      TO DATP-10.

           ADD 1               TO ACT-KEY.
           MOVE SPACES         TO OUT-REC.
           READ OUT-FILE       INVALID KEY
               MOVE 1          TO EOF-SW
               GO TO 62-FS-EXIT.
           IF ACT-KEY > MAX-KEY
               MOVE 1          TO EOF-SW
               GO TO 62-FS-EXIT.
           MOVE OUT-REC        TO LINE-11.
           MOVE OUT-DATE1      TO  DATE-MOVE.
           PERFORM DATE-ADJUST THRU DA-EXIT.
           MOVE DATE-DISP      TO DATE-11.
           MOVE OUT-DATE2      TO  DATE-MOVE.
           PERFORM DATE-ADJUST THRU DA-EXIT.
           MOVE DATE-DISP      TO DATP-11.

           ADD 1               TO ACT-KEY.
           MOVE SPACES         TO OUT-REC.
           READ OUT-FILE       INVALID KEY
               MOVE 1          TO EOF-SW
               GO TO 62-FS-EXIT.
           IF ACT-KEY > MAX-KEY
               MOVE 1          TO EOF-SW
               GO TO 62-FS-EXIT.
           MOVE OUT-REC        TO LINE-12.
           MOVE OUT-DATE1      TO  DATE-MOVE.
           PERFORM DATE-ADJUST THRU DA-EXIT.
           MOVE DATE-DISP      TO DATE-12.
           MOVE OUT-DATE2      TO  DATE-MOVE.
           PERFORM DATE-ADJUST THRU DA-EXIT.
           MOVE DATE-DISP      TO DATP-12.

           ADD 1               TO ACT-KEY.
           MOVE SPACES         TO OUT-REC.
           READ OUT-FILE       INVALID KEY
               MOVE 1          TO EOF-SW
               GO TO 62-FS-EXIT.
           IF ACT-KEY > MAX-KEY
               MOVE 1          TO EOF-SW
               GO TO 62-FS-EXIT.
           MOVE OUT-REC        TO LINE-13.
           MOVE OUT-DATE1      TO  DATE-MOVE.
           PERFORM DATE-ADJUST THRU DA-EXIT.
           MOVE DATE-DISP      TO DATE-13.
           MOVE OUT-DATE2      TO  DATE-MOVE.
           PERFORM DATE-ADJUST THRU DA-EXIT.
           MOVE DATE-DISP      TO DATP-13.

           ADD 1               TO ACT-KEY.
           MOVE SPACES         TO OUT-REC.
           READ OUT-FILE       INVALID KEY
               MOVE 1          TO EOF-SW
               GO TO 62-FS-EXIT.
           IF ACT-KEY > MAX-KEY
               MOVE 1          TO EOF-SW
               GO TO 62-FS-EXIT.
           MOVE OUT-REC        TO LINE-14.
           MOVE OUT-DATE1      TO  DATE-MOVE.
           PERFORM DATE-ADJUST THRU DA-EXIT.
           MOVE DATE-DISP      TO DATE-14.
           MOVE OUT-DATE2      TO  DATE-MOVE.
           PERFORM DATE-ADJUST THRU DA-EXIT.
           MOVE DATE-DISP      TO DATP-14.

       62-FS-EXIT.             EXIT.

       DATE-ADJUST.
           IF DATE-MOVE = "------"
               MOVE "--"       TO DD-MM
               MOVE "--"       TO DD-DD
               MOVE "--"       TO DD-YY
               GO TO DA-EXIT.

           MOVE DM-MM          TO  DD-MM.
           MOVE DM-DD          TO  DD-DD.
           MOVE DM-YY          TO  DD-YY.
           IF DATE-FLAG = 3
               MOVE DM-MM      TO  DD-DD
               MOVE DM-DD      TO  DD-MM.
           MOVE "/"            TO  SLASH1 SLASH2.
           IF "00" = DD-MM AND DD-DD AND DD-YY
               MOVE SPACES     TO DATE-DISP.

       DA-EXIT.                EXIT.

       64-DISPLAY-WO.
           MOVE DWO-BUFFER     TO WONUM OF WO-PLANNED.
           READ WO-PLANNED     INTO WO-PLANNED-DATA
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
               MOVE "READ    " TO DB-FUNC
               MOVE "WO-PLANNED" TO DB-FILE
               MOVE FILE-STAT  TO CON-WORD
               MOVE DB-ERROR   TO MESSAGE-BUFFER
               MOVE DWO-BUFFER TO MSG-FLD
               GO TO 64-EXIT.

           IF DWO-BUFFER NOT = WO-NUM-PLANNED
               MOVE "READ    " TO DB-FUNC
               MOVE "WO-PLANNED" TO DB-FILE
               MOVE FILE-STAT  TO CON-WORD
               MOVE DB-ERROR   TO MESSAGE-BUFFER
               MOVE WO-NUM-PLANNED TO MSG-FLD
               GO TO 64-EXIT.

           MOVE SPACES         TO MESSAGE-BUFFER WO-BASIC-DATA.

           IF WO-SW = "P"
           CALL "TPRINTWS"     USING DBPARAMETERS
                               WO-PLANNED-DATA
                               ERROR-SWITCH
                               VIEW-COMAREA
           ELSE
           CALL "TDISPWO"      USING DBPARAMETERS
                               WO-BASIC-DATA
                               WO-PLANNED-DATA
                               FILE-SW.

           MOVE "VPMQUEUE"     TO SCREEN-NAME.

       64-EXIT.                EXIT.

       GET-SEARCH-KEY.
           MOVE SPACES         TO SEARCH-KEY MESSAGE-BUFFER.
           MOVE "VGETEQP"      TO SCREEN-NAME.
           MOVE "00"           TO SCREEN-STATUS.
           MOVE SEARCH-KEY     TO DISPLAY-REC.

           WRITE DISPLAY-REC   FORMAT IS SCREEN-NAME
               INDIC ARE SCREEN-INDICATORS.
           IF SCREEN-STATUS NOT = "00"
               DISPLAY "SCREEN WRITE ERROR.  SCREEN-STATUS IS "
                        SCREEN-STATUS
               GO TO END-OF-JOB.

           READ  DISPLAY-FILE  FORMAT IS SCREEN-NAME
               INDIC ARE SCREEN-INDICATORS
           IF SCREEN-STATUS NOT = "00"
               DISPLAY "SCREEN READ ERROR.  SCREEN-STATUS IS "
                        SCREEN-STATUS
               GO TO END-OF-JOB.

           MOVE DISPLAY-REC    TO SEARCH-KEY.
           MOVE ALL B"0"       TO SCREEN-INDICATORS.

           IF KEY-HIT = 1 OR 3 OR 8
               GO TO END-OF-JOB.

           MOVE SAVE-MSG       TO E-MSG.
           MOVE SEARCH-KEY     TO S-KEY.

       GSK-EXIT.               EXIT.

       SET-SORT-KEY.
           MOVE "Q-FACT"       TO SORT-KEY P-SORT.
           IF SORT-SW = "2"    MOVE "STATUS" TO SORT-KEY P-SORT.
           IF SORT-SW = "3"    MOVE "EQUIP." TO SORT-KEY P-SORT.

       65-ERROR.
           MOVE TRUE-VAL       TO IND(FIELD-NUMBER) IND(99).

       999-CATREAD.
           MOVE SPACES         TO MESSAGE-BUFFER.
           CALL "CCATREAD"     USING CATREAD-PARMS.
           MOVE CATREAD-MSG-TEXT TO MESSAGE-BUFFER.

       999-CATREAD-EXIT.       EXIT.

       SORT-PMQ-RECS SECTION 02.
       SORT-PMQ.
           PERFORM SORT-MAIN   THRU SORT-M-EXIT.
           GO TO SORT-IP-EXIT.

       SORT-MAIN.
           MOVE ZONE-PRTY-FIELD TO ZONEPRTY OF PM-OPEN-QUEUE.
           START PM-OPEN-QUEUE  KEY = ZONEPRTY OF PM-OPEN-QUEUE
               INVALID KEY      MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
               IF FILE-STAT-1 = "2"
                   GO TO SORT-M-EXIT
               ELSE
                   MOVE "START   " TO DB-FUNC
                   MOVE "PM-OPEN-QUEUE" TO DB-FILE
                   MOVE FILE-STAT  TO CON-WORD
                   MOVE DB-ERROR   TO ERRMSG2
                   MOVE 1          TO FIELD-NUMBER
                   PERFORM 65-ERROR
                   GO TO END-OF-JOB.

           PERFORM SORT-DBGET  THRU SORT-DBGET-EXIT.

       SORT-M-EXIT.            EXIT.

       SORT-DBGET.
           MOVE SPACES         TO SORT-REC.
           READ PM-OPEN-QUEUE  NEXT INTO PM-QUEUE-DATA
               AT END          MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
               IF FILE-STAT = "10" OR "14" OR "46"
                   GO TO SORT-DBGET-EXIT
               ELSE
                   MOVE "READ    " TO DB-FUNC
                   MOVE "PM-OPEN-QUEUE" TO DB-FILE
                   MOVE FILE-STAT  TO CON-WORD
                   MOVE DB-ERROR   TO ERRMSG2
                   MOVE 1          TO FIELD-NUMBER
                   PERFORM 65-ERROR
                   GO TO END-OF-JOB.

           IF ZONE-PRTY-FIELD NOT = PMQ-ZONE-PRI
               GO TO SORT-DBGET-EXIT.

      *C**************************************************************
      *C*  12/93   CHANGED PROGRAM TO DISPLAY 'PR' RECORDS PER     ***
      *C*   WDR    BOB NESSELROADE - DANVILLE                      ***
      *C**************************************************************
      *C*  06/95   CHANGED PROGRAM TO DISPLAY 'PR' RECORDS BASED   ***
      *C*   WDR    ON A SWITCH IN THE MMIS SYSTEM SWITCHES.        ***
      *C*          NAPANEE DID NOT WANT THE 'PR'S TO DISPLAY.      ***
      *C**************************************************************
           IF PR-SW-IS-OFF
               IF PMQ-REC-PR = "PR"
                   GO TO SORT-DBGET.
      ****************************************************************

           MOVE PM-QUEUE-FACTOR TO  SORT-PM-QUEUE.
           MOVE PMQ-EQUIP-NUM   TO  SORT-EQUIP.

           IF SK-1 = SE-1 OR SPACES
               IF SK-2 = SE-2 OR SPACES
                   IF SK-3 = SE-3 OR SPACES
                       IF SK-4 = SE-4 OR SPACES
                           IF SK-5 = SE-5 OR SPACES
                               IF SK-6 = SE-6 OR SPACES
                                   NEXT SENTENCE
                               ELSE GO TO SORT-DBGET
                           ELSE GO TO SORT-DBGET
                       ELSE GO TO SORT-DBGET
                   ELSE GO TO SORT-DBGET
               ELSE GO TO SORT-DBGET
           ELSE GO TO SORT-DBGET.

           MOVE PMQ-WO-NUM       TO  SORT-WO-NUM DWO-BUFFER.
           MOVE PMQ-DESCRIPTION  TO  SORT-DESC.
           MOVE SORT-LV          TO  SORT-LEVEL.
           MOVE SORT-M-C         TO  SORT-MC.
           IF SD-1 = "*"
               MOVE SPACES       TO  SORT-LEVEL SORT-MC.
           MOVE "------"         TO  SORT-DATE1.
           PERFORM GET-WO-STATUS THRU GWS-EXIT.
           MOVE WO-STATUS-P      TO  SORT-STATUS.
           IF SPECL-INSTR-2 NOT = SPACES
               MOVE SPECL-INSTR-2 TO  SORT-DESC.
           MOVE DATE-STRT-P      TO  SORT-DATE2.
           MOVE DATE-SCHD        TO  SORT-DATE1.
           IF SORT-DATE1 = SPACES
               MOVE DATE-REQD    TO  SORT-DATE1.
           RELEASE SORT-REC.

           GO TO SORT-DBGET.

       SORT-DBGET-EXIT.        EXIT.

       GET-WO-STATUS.
           MOVE SPACES         TO WO-PLANNED-DATA.
           MOVE DWO-BUFFER     TO WONUM OF WO-PLANNED.
           READ WO-PLANNED     INTO WO-PLANNED-DATA
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
               MOVE "------"   TO SORT-DATE1 DATE-STRT-P
               MOVE "--"       TO WO-STATUS-P
               GO TO GWS-EXIT.

           IF DWO-BUFFER NOT = WO-NUM-PLANNED
               MOVE "------"   TO SORT-DATE1 DATE-STRT-P
               MOVE "--"       TO WO-STATUS-P.

       GWS-EXIT.               EXIT.

       SORT-IP-EXIT.           EXIT.

       SORT-PMQ-OUT SECTION 03.
       SORT-QUEUE-OUT.
           OPEN OUTPUT         OUT-FILE.
           PERFORM SORT-READ-LOOP THRU SRL-EXIT.
           CLOSE               OUT-FILE.
           PERFORM SORT-PRINT-LOOP THRU SPL-EXIT.
           GO TO SORT-WF-EXIT.

       SORT-READ-LOOP.
           RETURN SORT-FILE    AT END
               MOVE ACT-KEY    TO MAX-KEY
               GO TO SRL-EXIT.
           ADD 1               TO ACT-KEY.
           MOVE SORT-REC       TO OUT-REC.
           WRITE OUT-REC       INVALID KEY
               DISPLAY "WRITE OUT-FILE ERR"
               GO TO SRL-EXIT.
           GO TO SORT-READ-LOOP.

       SRL-EXIT.               EXIT.

       SORT-PRINT-LOOP.
           IF PRINT-SWITCH-IS-OFF
               GO TO SPL-EXIT.

           MOVE 0              TO OVRPRTF-TOFILE-NUM.
           MOVE "MCPRT"        TO OVRPRTF-FILE.
           PERFORM 996-OVERRIDE-PRINT-FILE.
           MOVE 0              TO ACT-KEY.
           OPEN INPUT          OUT-FILE.
           OPEN OUTPUT         PRINT-FILE.

       PRINT-LOOP.
           IF LINE-CTR > 59
               PERFORM PRINT-HEADINGS.

           ADD 1               TO ACT-KEY.
           MOVE SPACES         TO OUT-REC.
           READ OUT-FILE       INVALID KEY
               GO TO PL-EXIT.
           IF ACT-KEY > MAX-KEY
               GO TO PL-EXIT.

           MOVE OUT-PM-QUEUE   TO P-QF.
           MOVE OUT-WO-NUM     TO P-WO.
           MOVE OUT-STATUS     TO P-STAT.
           MOVE OUT-EQUIP      TO P-EQP.
           MOVE OUT-LEVEL      TO P-LV.
           MOVE OUT-MC         TO P-MC.
           MOVE OUT-DESC       TO P-DESC.

           MOVE OUT-DATE1      TO  DATE-MOVE.
           PERFORM DATE-ADJUST THRU DA-EXIT.
           MOVE DATE-DISP      TO P-DATE1.
           MOVE OUT-DATE2      TO  DATE-MOVE.
           PERFORM DATE-ADJUST THRU DA-EXIT.
           MOVE DATE-DISP      TO P-DATE2.
           MOVE PRINT-LINE     TO PRINT-REC.
           WRITE PRINT-REC     AFTER ADVANCING 1 LINES.
           ADD  1              TO LINE-CTR.
           GO TO PRINT-LOOP.

       PL-EXIT.
           CLOSE               OUT-FILE.
           CLOSE               PRINT-FILE.
           MOVE 0              TO PRINT-SW.
           GO TO SPL-EXIT.

       PRINT-HEADINGS.
           ADD  1              TO PAGE-CTR.
           MOVE PAGE-CTR       TO ZPAGE.
           MOVE DATE-HEADER    TO PRINT-REC.
           WRITE PRINT-REC     AFTER ADVANCING NEW-PAGE.
           MOVE DASH-LINE      TO PRINT-REC.
           WRITE PRINT-REC     AFTER ADVANCING 1 LINES.
           MOVE TITLE-HEADER   TO PRINT-REC.
           WRITE PRINT-REC     AFTER ADVANCING 1 LINES.
           MOVE DASH-LINE      TO PRINT-REC.
           WRITE PRINT-REC     AFTER ADVANCING 1 LINES.
           MOVE SORT-HEADER    TO PRINT-REC
           WRITE PRINT-REC     AFTER ADVANCING 1 LINES.
           MOVE TEXT-HEADER    TO PRINT-REC
           WRITE PRINT-REC     AFTER ADVANCING 1 LINES.
           MOVE DASH-LINE      TO PRINT-REC.
           WRITE PRINT-REC     AFTER ADVANCING 1 LINES.
           MOVE 7              TO LINE-CTR.

       COPY OVRPFCALL IN COPYLIB.

       SPL-EXIT.               EXIT.

       SORT-WF-EXIT.           EXIT.

      *************  END OF FILE  -  SPMLISTQ  *****************
