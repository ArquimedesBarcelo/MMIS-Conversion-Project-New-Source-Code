       IDENTIFICATION DIVISION.
       PROGRAM-ID.             SPMLISTQ.
       AUTHOR.                 W. ROXBURY.
       INSTALLATION.           GOODYEAR TIRE & RUBBER CO.
      *REMARKS.            *** PM QUEUE-FILE INQUIRY PROGRAM
      *                        SORTED BY ZONE.

       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.
       SOURCE-COMPUTER.        AS-400.
       OBJECT-COMPUTER.        AS-400.
       SPECIAL-NAMES.          REQUESTOR IS WORK-STATION
                               SYSTEM-CONSOLE IS CONSOLE
                               LOCAL-DATA IS LOCAL-DATA-AREA
                               C01 IS NEW-PAGE.
      *C****************************************************************
      *C  12-15-93   W. ROXBURY
      *C  CHANGED PROGRAM TO DISPLAY 'PR' RECORDS PER BOB NESSELROADE
      *C  IN DANVILLE.
      *C****************************************************************
      *C  06-09-94   W. ROXBURY
      *C  ADDED ABILITY TO PRINT CRAFTSMAN'S WORKSHEET FROM PM OPEN
      *C  QUEUE DISPLAY.
      *C****************************************************************
      *C  04-24-95   W. ROXBURY
      *C  ADDED ABILITY TO PRINT QUEUE BACKLOG BY PRESSING THE F9 KEY.
      *C****************************************************************
      *C  06-07-95   W. ROXBURY
      *C  CHANGED PROGRAM TO DISPLAY 'PR' RECORDS BASED ON A SWITCH IN
      *C  THE MMIS SYSTEM SWITCHES.
      *C  NAPANEE DID NOT WANT THE 'PR'S TO DISPLAY.
      *C****************************************************************
      *C  02-01-98   W. ROXBURY
      *C  ADDED CALL TO 'TRTVZONE' TO ALLOW SELECTION OF ZONE FROM LIST.
      *C****************************************************************

       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT WO-LAST-NUM-USED
                  ASSIGN       TO DATABASE-MCFPMM0800
                  ORGANIZATION IS RELATIVE
                  ACCESS MODE  IS RANDOM
                  RELATIVE KEY IS ARG-NO
                  FILE STATUS  IS FILE-STAT.

           SELECT WO-ZONE-PRTY
                  ASSIGN       TO DATABASE-MCFLMM0501
                  ORGANIZATION IS INDEXED
                  ACCESS MODE  IS DYNAMIC
                  RECORD KEY   IS EXTERNALLY-DESCRIBED-KEY
                  FILE STATUS  IS FILE-STAT.

           SELECT WO-PLANNED
                  ASSIGN       TO DATABASE-MCFLMM1101
                  ORGANIZATION IS INDEXED
                  ACCESS MODE  IS DYNAMIC
                  RECORD KEY   IS EXTERNALLY-DESCRIBED-KEY
                               WITH DUPLICATES
                  FILE STATUS  IS FILE-STAT.

           SELECT PM-OPEN-QUEUE
                  ASSIGN       TO DATABASE-MCFLMM3903
                  ORGANIZATION IS INDEXED
                  ACCESS MODE  IS DYNAMIC
                  RECORD KEY   IS EXTERNALLY-DESCRIBED-KEY
                               WITH DUPLICATES
                  FILE STATUS  IS FILE-STAT.

           SELECT PRINT-FILE
                  ASSIGN       TO PRINTER-MCPRT
                  FILE STATUS  IS FILE-STAT.

           SELECT DISPLAY-FILE
                  ASSIGN       TO WORKSTATION-ZPMMAINT-SI
                  ORGANIZATION IS TRANSACTION
                  ACCESS MODE  IS SEQUENTIAL
                  FILE STATUS  IS SCREEN-STATUS
                               MAJOR-MINOR
                  CONTROL-AREA IS SCREEN-CONTROL.

           SELECT OUT-FILE
                  ASSIGN       TO DISK-AUTOQPM
                  ORGANIZATION IS RELATIVE
                  ACCESS MODE  IS DYNAMIC
                  RELATIVE KEY IS ACT-KEY
                  FILE STATUS  IS FILE-STAT.

           SELECT SORT-FILE
                  ASSIGN       TO DISK-SORTFILE.

       DATA DIVISION.
       FILE SECTION.
       FD  WO-LAST-NUM-USED
           LABEL RECORDS ARE STANDARD.
       01  WO-REC.
           COPY DDS-ALL-FORMATS OF MCFPMM0800.

       FD  WO-ZONE-PRTY
           LABEL RECORDS       ARE STANDARD.
       01  ZP-REC.
           COPY DDS-ALL-FORMATS OF MCFLMM0501.

       FD  WO-PLANNED
           LABEL RECORDS       ARE STANDARD.
       01  PWO-REC.
           COPY DDS-ALL-FORMATS OF MCFLMM1101.

       FD  PM-OPEN-QUEUE
           LABEL RECORDS       ARE STANDARD.
       01  PMQ-REC.
           COPY DDS-ALL-FORMATS OF MCFLMM3903.

       FD  PRINT-FILE
           LABEL RECORD        IS OMITTED
           RECORD CONTAINS     79 CHARACTERS.
       01  PRINT-REC           PIC X(79).

       FD  DISPLAY-FILE
           LABEL RECORDS       ARE OMITTED.
       01  DISPLAY-REC         PIC X(2000).

       FD  OUT-FILE RECORD     CONTAINS 66 CHARACTERS
           LABEL RECORDS       ARE OMITTED
           DATA RECORD         IS OUT-REC.
       01  OUT-REC.
           05  OUT-PM-QUEUE    PIC 99.
           05  OUT-FILLER      PIC X.
           05  OUT-WO-NUM      PIC X(10).
           05  OUT-STATUS      PIC X(02).
           05  OUT-EQUIP       PIC X(06).
           05  OUT-LEVEL       PIC X(02).
           05  OUT-DESC        PIC X(30).
           05  OUT-MC          PIC X.
           05  OUT-DATE1       PIC X(06).
           05  OUT-DATE2       PIC X(06).

       SD  SORT-FILE RECORD    CONTAINS 66 CHARACTERS
           DATA RECORD         IS SORT-REC.
       01  SORT-REC.
           05  SORT-PM-QUEUE   PIC 99.
           05  SORT-FILLER     PIC X.
           05  SORT-WO-NUM     PIC X(10).
           05  SORT-STATUS     PIC X(02).
           05  SORT-EQUIP.
               10  SE-1        PIC X.
               10  SE-2        PIC X.
               10  SE-3        PIC X.
               10  SE-4        PIC X.
               10  SE-5        PIC X.
               10  SE-6        PIC X.
           05  SORT-LEVEL      PIC X(02).
           05  SORT-DESC.
               10  SD-1        PIC X.
               10  SD-2        PIC X(05).
               10  SORT-LV     PIC XX.
               10  SD-3        PIC X(14).
               10  SORT-M-C    PIC X.
               10  SD-4        PIC X(07).
           05  SORT-MC         PIC X.
           05  SORT-DATE1      PIC X(06).
           05  SORT-DATE2      PIC X(06).

       WORKING-STORAGE SECTION.
       77  ARG-NO              PIC 9999   VALUE 1.
       77  ACT-KEY             PIC 9999   VALUE 0.
       77  MAX-KEY             PIC 9999   VALUE 0.
       77  SAVE-KEY            PIC 9999   VALUE 0.
       77  EOF-SW              PIC 9      VALUE 0.
       77  PRINT-SW            PIC 9      VALUE 0.
           88  PRINT-SWITCH-IS-OFF        VALUE 0.
       77  LINE-CTR            PIC 99     VALUE 60.
       77  PAGE-CTR            PIC 99     VALUE 0.
       77  PR-ON-SW            PIC X      VALUE " ".
           88  PR-SW-IS-OFF               VALUE " ".
       77  SAVE-TITLE          PIC X(10).
       77  SAVE-MSG            PIC X(23).
       77  DWO-BUFFER          PIC X(10).
       77  WO-SW               PIC X.
       77  SORT-SW             PIC X      VALUE "1".
       77  FILE-SW             PIC X      VALUE "P".
       77  DASH-LINE           PIC X(79)  VALUE ALL "-".
       77  TRUE-VAL            PIC 1      VALUE B"1".

       01  PASSWORD-INFORMATION.
           05  NAME-OF-PROGRAM PIC X(08) VALUE "SPMLISTQ".
           05  PROGRAM-TYPE    PIC X(02) VALUE "IN".
           05  PROGRAM-RELEASE PIC X(12) VALUE " J0100010001".
           05  PROGRAM-DESCRIPTION.
               10  PROG-DESC-A PIC X(60) VALUE
           "AUTOMATIC QUEUE BACKLOG INQUIRY FOR PM WO's SORTED BY ZONE".
               10  PROG-DESC-B PIC X(60) VALUE
           "CONTINUOUSLY DISPLAYS CHANGES TO THE PM WORKORDER QUEUE.  ".
               10  PROG-FUNC   PIC X(60) VALUE
           "RUNS FROM THE f1 KEY OF THE EXECUTIVE SECONDARY MENU.     ".
           05  PASSWORD-FLAG   PIC X.

       01  FILE-STAT.
           05  FILE-STAT-1     PIC X  VALUE "0".
           05  FILE-STAT-2     PIC X  VALUE "0".

