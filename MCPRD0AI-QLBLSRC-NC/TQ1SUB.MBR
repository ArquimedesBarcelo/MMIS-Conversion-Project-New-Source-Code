                   15  WOSU-OUT       PIC X(3).
               10  WODESC-OUT         PIC X(30).
               10  EQNUM-OUT          PIC X(6).
               10  EQDOWN-OUT         PIC XX.
               10  DATE-RCVD.
                   15  DATE-RCVD-MM   PIC XX.
                   15  DATE-RCVD-DD   PIC XX.
                   15  DATE-RCVD-YY   PIC XX.
               10  TIME-RCVD          PIC XXXX.
               10  TIME-COMP-OUT      PIC XXXX.
               10  CRAFTSREQ-OUT.
                   15  C1-OUT         PIC XX.
                   15  C2-OUT         PIC XX.
                   15  C3-OUT         PIC XX.
               10  CMAN-1-OUT         PIC XXXX.
               10  CMAN-2-OUT         PIC XXXX.
               10  CMAN-3-OUT         PIC XXXX.
               10  TSTRT-OUT          PIC XXXX.
               10  TSTRT-OUT-9 REDEFINES TSTRT-OUT    PIC 9999.
               10  RETM-OUT           PIC XXXX.
               10  DTIM-OUT           PIC XXXX.
               10  SCHED-DATE-OUT.
                   15  SC-DATE-YY     PIC XX.
                   15  SC-DATE-MM     PIC XX.
                   15  SC-DATE-DD     PIC XX.
               10  SCHED-SHIFT-OUT    PIC X.
           05  FILLER                 PIC X(6).

