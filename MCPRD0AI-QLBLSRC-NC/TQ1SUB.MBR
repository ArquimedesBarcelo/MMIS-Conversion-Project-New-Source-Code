       IDENTIFICATION DIVISION.
       PROGRAM-ID. NQ1SUB.
      *C---------------------------------------------------------------
      *C 02/25/93  JSB REQ #6306
      *C      ADDED "PR" AS A NEW WO STATUS FOR PRE-RELEASE.
      *C---------------------------------------------------------------
      *C SEPTEMBER 1996  JE COFFMAN  REQ# 6619
      *C      EXPANDED DATE FIELDS FOR YEAR 2000 COMPLIANCE.
      *C---------------------------------------------------------------
      *C SEPTEMBER 1998  JE COFFMAN
      *C      INSTALLED LOGIC TO HANDLE A SHIFT "ROLLOVER"
      *C      (WHEN A SHIFT ROLLS OVER FROM ONE DAY TO THE
      *C      NEXT) FOR THE SHIFT SUMMARY ('SR') REQUESTS.
      *C         - BILL BUCKLER IN LAWTON MADE THE REQUEST
      *C
       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.
       SOURCE-COMPUTER.   AS400.
       OBJECT-COMPUTER.   AS400.
       COPY SPECIALN IN COPYLIB.
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT DISPLAY-FILE
               ASSIGN TO WORKSTATION-ZINQUIRY-SI
               ORGANIZATION IS TRANSACTION
               ACCESS IS SEQUENTIAL
               FILE STATUS IS DSPLY-STATUS
               CONTROL-AREA IS WS-CONTROL.
           SELECT LABOR-CURR-STAT-FILE
               ASSIGN TO DATABASE-MCFLMM1602
               ORGANIZATION IS INDEXED
               ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY WITH DUPLICATES
               FILE STATUS IS LCSF-STATUS.
           SELECT OUT-FILE
               ASSIGN TO DATABASE-OUTFILQ1
               ORGANIZATION IS RELATIVE
               ACCESS MODE IS RANDOM
               RELATIVE KEY IS ACT-KEY
               FILE STATUS IS OF-STATUS.
           SELECT PERSONNEL-FILE
               ASSIGN TO DATABASE-MCFLMM0301
               ORGANIZATION IS INDEXED
               ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
               FILE STATUS IS PF-STATUS.
           SELECT SORT-FILE
               ASSIGN TO DISK-SORTFILE.
           SELECT PRINT-FILE
               ASSIGN TO PRINTER-MCPRT.
           SELECT WO-BASIC-FILE
               ASSIGN TO DATABASE-MCFLMM1002
               ORGANIZATION IS INDEXED
               ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY WITH DUPLICATES
               FILE STATUS IS WBF-STATUS.
           SELECT WO-CRAFTS-REQD-FILE
               ASSIGN TO DATABASE-MCFLMM0601
               ORGANIZATION IS INDEXED
               ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
               FILE STATUS IS WCRF-STATUS.
           SELECT WO-LABOR-FILE
               ASSIGN TO DATABASE-MCFLMM1301
               ORGANIZATION IS INDEXED
               ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY WITH DUPLICATES
               FILE STATUS IS WLF-STATUS.
           SELECT WO-LAST-NUM-USED
               ASSIGN TO DATABASE-MCFPMM0800
               ORGANIZATION IS RELATIVE
               ACCESS MODE IS RANDOM
               RELATIVE KEY IS ARG-NO
               FILE STATUS IS WLNU-STATUS.
           SELECT WO-PLANNED-FILE
               ASSIGN TO DATABASE-MCFLMM1102
               ORGANIZATION IS INDEXED
               ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY WITH DUPLICATES
               FILE STATUS IS WPF-STATUS.
           SELECT WO-ZONE-PRTY-FILE
               ASSIGN TO DATABASE-MCFLMM0501
               ORGANIZATION IS INDEXED
               ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
               FILE STATUS IS WZPF-STATUS.
       DATA DIVISION.
       FILE SECTION.
       FD  DISPLAY-FILE
           LABEL RECORDS ARE OMITTED.
       01  DSPLY-REC                    PIC X(2000).
       FD  LABOR-CURR-STAT-FILE
           LABEL RECORDS ARE STANDARD
           DATA RECORD IS LCSFREC.
       01  LCSFREC.
           COPY DDS-ALL-FORMATS OF MCFLMM1602.
       FD  OUT-FILE
           RECORD CONTAINS 120 CHARACTERS
           LABEL RECORD IS OMITTED
           DATA RECORD IS OUT-REC.
       01  OUT-REC.
           05  OUT-DATA.
               10  DEPT-OUT           PIC X(4).
               10  ZONE-OUT.
