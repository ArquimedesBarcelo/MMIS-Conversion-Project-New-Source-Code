000200 IDENTIFICATION DIVISION.
000300 PROGRAM-ID.           TCALCAVG.
000400 AUTHOR.               MK MADDEN.
000600 INSTALLATION.         GOODYEAR TIRE AND RUBBER CO.
000500 DATE-WRITTEN.         MAY 30, 1985.
000700
000800*REMARKS.              THIS PROGRAM WILL READ THROUGH THE
000900*                      MATERIAL ACCUM MASTER DATA SET
001000*                      AND CALCULATE A NEW AVERAGE COST FOR ALL
001100*                      CODES THAT HAVE BEEN UPDATED IN DAILY
001200*                      ACTIVITY.  THIS PROGRAM WILL PRINT A
001300*                      REPORT OF ALL NEW AVERAGE COSTS AND
001400*                      WILL FLAG THOSE AVERAGE COSTS WHICH
001500*                      HAVE CHANGED MORE THAN 15%.
      *C
      *C   25FEB1994    DAVE PLUM
      *C     ADDED CALL TO THE COBOL ERROR HANDLER - MCXCBLERR.
      *C
      *C   12SEP1996    DAVE PLUM
      *C     RECOMPILED FOR CENTURY DATABASE CHANGES.
      *C
001700 ENVIRONMENT DIVISION.
001800 CONFIGURATION SECTION.
001900 SOURCE-COMPUTER.      IBM-AS400.
002000 OBJECT-COMPUTER.      IBM-AS400.
002100 SPECIAL-NAMES.        C01 IS TOP-OF-FORM.
002200
002300 INPUT-OUTPUT SECTION.
002400 FILE-CONTROL.
002500     SELECT ONLINE-PRT   ASSIGN TO PRINTER-MCPRT.

002600     SELECT SORT-FILE    ASSIGN TO DISK-SORT.

           SELECT MACTINFO-I
                  ASSIGN TO DATABASE-MCFLCA0101
                  ORGANIZATION IS INDEXED
                    ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                  FILE STATUS IS FILE-STATUS.

           SELECT MATLACUM-I
                  ASSIGN TO DATABASE-MCFLCA0601
                  ORGANIZATION IS INDEXED
                    ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                  FILE STATUS IS FILE-STATUS.

           SELECT MSTORERM-I
                  ASSIGN TO DATABASE-MCFLCS0201
                  ORGANIZATION IS INDEXED
                    ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                  FILE STATUS IS FILE-STATUS.

           SELECT MATLACUM-O
                  ASSIGN TO DATABASE-MCFLCA0601
                  ORGANIZATION IS INDEXED
                    ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                  FILE STATUS IS FILE-STATUS.

           SELECT MSTORERM-O
                  ASSIGN TO DATABASE-MCFLCS0201
                  ORGANIZATION IS INDEXED
                    ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                  FILE STATUS IS FILE-STATUS.

           SELECT DDAILYTC-O
                  ASSIGN TO DATABASE-MCFLCS1601
                  ORGANIZATION IS INDEXED
                    ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                    WITH DUPLICATES
                  FILE STATUS IS FILE-STATUS.

002800 DATA DIVISION.
