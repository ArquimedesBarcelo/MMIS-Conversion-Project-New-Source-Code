       IDENTIFICATION DIVISION.
       PROGRAM-ID.             TDLINIT.
       AUTHOR.                 W. ROXBURY.
       INSTALLATION.           GOODYEAR TIRE & RUBBER CO.
       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.
       SOURCE-COMPUTER.        IBM-AS400.
       OBJECT-COMPUTER.        IBM-AS400.
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT NEWS-TABLE
                  ASSIGN       TO DATABASE-MCFLMM2801
                  ORGANIZATION IS INDEXED
                  ACCESS MODE  IS DYNAMIC
                  RECORD KEY   IS EXTERNALLY-DESCRIBED-KEY
                               WITH DUPLICATES
                  FILE STATUS  IS FILE-STAT.

           SELECT PER-PERSONNEL
                  ASSIGN       TO DATABASE-MCFLMM0301
                  ORGANIZATION IS INDEXED
                  ACCESS MODE  IS DYNAMIC
                  RECORD KEY   IS EXTERNALLY-DESCRIBED-KEY
                  FILE STATUS  IS FILE-STAT.

           SELECT WO-CRAFTS-REQD
                  ASSIGN       TO DATABASE-MCFLMM0601
                  ORGANIZATION IS INDEXED
                  ACCESS MODE  IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                  FILE STATUS IS FILE-STAT.

           SELECT WO-ZONE-PRTY
                  ASSIGN       TO DATABASE-MCFLMM0501
                  ORGANIZATION IS INDEXED
                  ACCESS MODE  IS DYNAMIC
                  RECORD KEY   IS EXTERNALLY-DESCRIBED-KEY
                  FILE STATUS  IS FILE-STAT.

           SELECT DISPLAY-FILE
                  ASSIGN       TO WORKSTATION-ZBBNEW-SI
                  ORGANIZATION IS TRANSACTION
                  ACCESS MODE  IS DYNAMIC
                  RELATIVE KEY IS RECNO
                  FILE STATUS  IS SCREEN-STATUS
                               MAJOR-MINOR
                  CONTROL-AREA IS SCREEN-CONTROL.

       DATA DIVISION.
       FILE SECTION.
       FD  NEWS-TABLE
           LABEL RECORDS ARE STANDARD.
       01  DL-REC.
           COPY DDS-ALL-FORMATS OF MCFLMM2801.

       FD  PER-PERSONNEL
           LABEL RECORDS ARE STANDARD.
       01  PERS-REC.
           COPY DDS-ALL-FORMATS OF MCFLMM0301.

       FD  WO-CRAFTS-REQD
           LABEL RECORDS ARE STANDARD.
       01  CR-REC.
           COPY DDS-ALL-FORMATS OF MCFLMM0601.

       FD  WO-ZONE-PRTY
           LABEL RECORDS ARE STANDARD.
       01  ZP-REC.
           COPY DDS-ALL-FORMATS OF MCFLMM0501.

       FD  DISPLAY-FILE
           LABEL RECORDS ARE OMITTED.
       01  DISPLAY-REC         PIC X(2000).

       WORKING-STORAGE SECTION.
       77  EDIT-SW       VALUE 0   PIC 9.
       77  RECNO                   PIC 9999   VALUE 0.
       77  TRUE-VAL                PIC 1      VALUE B"1".
       77  NEG-VAL                 PIC 1      VALUE B"0".

       01  PASSWORD-INFORMATION.
           05  NAME-OF-PROGRAM     PIC X(08) VALUE "TDLINIT ".
           05  PROGRAM-TYPE        PIC X(02) VALUE "UP".
           05  PROGRAM-RELEASE     PIC X(12) VALUE " E0100010001".
           05  PROGRAM-DESCRIPTION.
               10  PROG-DESC-A     PIC X(60) VALUE
         "INITIATES DISTRIBUTION LISTS FOR THE MMIS NEWS BULLETIN     ".
               10  PROG-DESC-B     PIC X(60) VALUE
         "BOARD PROGRAM.  RUNS FROM THE f5 KEY OF THE DISTRIBUTION    ".
               10  PROG-FUNCTION   PIC X(60) VALUE
         "LIST MAINTENANCE MENU.                                      ".
           05  PASSWORD-FLAG       PIC X.

       01  FILE-STAT.
           05 FILE-STAT-1      PIC X   VALUE "0".
           05 FILE-STAT-2      PIC X   VALUE "0".

       01  HELP-DATA.
           05  HELP-SW             PIC 9(04) BINARY VALUE ZEROS.
           05  HELP-LOCA           PIC X(40).
           05  HELP-MSGLINE        PIC X(70).

       01  SCREEN-DATA.
           05  LOCA-ID                         PIC X(40).
           05  DLIST-CODE                      PIC X(06).
           05  DISTRIBUTION-LIST.
               10  DIST-CC-BUF                 PIC X(04).
               10  DIST-ZONE-BUF               PIC X(04).
               10  DIST-CRFT-BUF               PIC X(02).
           05  HELP-LINE                       PIC X(70).
           05  SCREEN-MSGS.
               10  CMDMSG                      PIC X(79).
               10  ERRMSG                      PIC X(79).

       01  ZONE-ARGUMENT.
           05  ZONE-ARG                        PIC X(04).
           05  FILLER      VALUE "1 "          PIC X(02).

       01  DLIST-LINE.
           05  DIST-CC PIC X(04).
           05  DIST-ZN PIC X(04).
           05  DIST-CR PIC X(02).

       01  DB-ERROR.
           05  DB-FUNC   PIC X(10) VALUE SPACES.
           05  DB-FILE   PIC X(18) VALUE SPACES.
           05  FILLER    PIC X(20) VALUE "ERROR - FILE-STAT = ".
           05  CON-WORD  PIC XX.

           COPY SCREENIO       IN COPYLIB.

           COPY CATREAD        IN COPYLIB.

       01  WO-PERS-DATA.
           COPY MPERSONL       IN COPYLIB.

       01  WO-ZONE-DATA.
           COPY MZONPRTY       IN COPYLIB.

       01  WO-CRAFT-DATA.
           COPY MWOCRAFT       IN COPYLIB.

       01  DISTRIBUTION-TABLE.
           COPY DNEWSTBL       IN COPYLIB.

       01  MESSAGE-DATA.
           COPY ERRORLIN       IN COPYLIB.

       LINKAGE SECTION.
       01  DBPARAMETERS.
           COPY DBPARMS        IN COPYLIB.

       01  DLIST-DATA.
           05  DIST-CODE           PIC X(06).
           05  DIST-LOCA           PIC X(40).
           05  DIST-HELP           PIC X(70).

       PROCEDURE DIVISION USING DBPARAMETERS
                                DLIST-DATA.
       CHECK-PASSWORD.
           CALL "TPWORD" USING PASSWORD-INFORMATION.
           IF PASSWORD-FLAG NOT = "N"
               GO TO BEGIN-PROC.
           GOBACK.

       BEGIN-PROC.
           OPEN I-O            NEWS-TABLE.
           OPEN INPUT          PER-PERSONNEL.
           OPEN INPUT          WO-CRAFTS-REQD.
           OPEN INPUT          WO-ZONE-PRTY.
           OPEN I-O            DISPLAY-FILE.
           IF DIST-CODE = "ALL   "
               GO TO END-OF-JOB.

           MOVE "VDLINIT"      TO SCREEN-NAME.
           MOVE SPACES         TO SCREEN-DATA MESSAGE-BUFFER.
           MOVE 0              TO RECNO.
           MOVE DIST-CODE      TO DLIST-CODE.
           MOVE DIST-LOCA      TO LOCA-ID HELP-LOCA.
           MOVE DIST-HELP      TO HELP-LINE HELP-MSGLINE.

           MOVE DIST-CODE      TO NEWSKEY OF NEWS-TABLE.
           READ NEWS-TABLE     INTO DISTRIBUTION-TABLE
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
               IF FILE-STAT = "10" OR "14" OR "46" OR "23"
                   GO TO MAIN
               ELSE
                   MOVE "READ    " TO DB-FUNC
                   MOVE "NEWS-TABLE" TO DB-FILE
                   MOVE FILE-STAT  TO CON-WORD
                   MOVE DB-ERROR   TO MESSAGE-BUFFER
                   PERFORM ERROR-ROUTINE
                   GO TO SHOWFORM.

           MOVE SPACES         TO DISTRIBUTION-LIST.
      **********************************************************************
      **    MESSAGE 044/014:
      **  DISTRIBUTION LIST ALREADY EXISTS - RECORDS MAY BE ADDED IF DESIRED
      **********************************************************************
           MOVE  44            TO CATREAD-MSG-SET.
           MOVE  14            TO CATREAD-MSG-NUM.
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
           MOVE 1              TO FIELD-NUMBER
           PERFORM ERROR-ROUTINE
           GO TO SHOWFORM.

       MAIN.
           MOVE SPACES         TO DISTRIBUTION-LIST MESSAGE-BUFFER.

       SHOWFORM.
           MOVE "00"           TO SCREEN-STATUS.
           MOVE SCREEN-DATA    TO DISPLAY-REC.

           WRITE DISPLAY-REC  FORMAT IS SCREEN-NAME
               INDIC ARE SCREEN-INDICATORS.
           IF SCREEN-STATUS NOT = "00"
               DISPLAY "SCREEN WRITE ERROR.  SCREEN-STATUS IS "
                        SCREEN-STATUS
               GO TO END-OF-JOB.

           READ  DISPLAY-FILE FORMAT IS SCREEN-NAME
               INDIC ARE SCREEN-INDICATORS
           IF SCREEN-STATUS NOT = "00"
               DISPLAY "SCREEN READ ERROR.  SCREEN-STATUS IS "
                        SCREEN-STATUS
               GO TO END-OF-JOB.

           MOVE DISPLAY-REC    TO SCREEN-DATA.
           MOVE ALL B"0"       TO SCREEN-INDICATORS.

           IF KEY-HIT = 1 OR 3
               GO TO END-OF-JOB.

           IF KEY-HIT = 6
               IF DLIST-CODE = "000000"
                   GO TO SHOWFORM
               ELSE
                   PERFORM SUBF-CLEAR
                   PERFORM GET-DLIST THRU GDL-EXIT
                   GO TO SHOWFORM.

           IF KEY-HIT = 7
               MOVE 60         TO HELP-SW
               CALL "TBBHELP" USING HELP-DATA
               MOVE "VDLINIT"  TO SCREEN-NAME
               GO TO SHOWFORM.

           IF KEY-HIT NOT = 0
               GO TO SHOWFORM.

           IF DISTRIBUTION-LIST = SPACES
               GO TO SHOWFORM.

       EDIT-DISTRIBUTION.
           MOVE 0              TO EDIT-SW.
           IF DIST-CC-BUF   NOT = SPACES  ADD 2 TO EDIT-SW.
           IF DIST-ZONE-BUF NOT = SPACES  ADD 1 TO EDIT-SW.
           IF DIST-CRFT-BUF NOT = SPACES  ADD 1 TO EDIT-SW.

           IF EDIT-SW > 2
      **********************************************************************
      **    MESSAGE 029/073:
      **  CLOCK CARD NUMBER MAY BE ADDRESSED BY ITSELF - NO ZONE OR CRAFT
      **********************************************************************
               MOVE  29        TO CATREAD-MSG-SET
               MOVE  73        TO CATREAD-MSG-NUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE 1              TO FIELD-NUMBER
               PERFORM ERROR-ROUTINE
               GO TO SHOWFORM.

       EDIT-CLOCK-CARD.
           IF DIST-CC-BUF = SPACES
               GO TO EDIT-ZONE.

           IF DIST-CC-BUF = "9999" OR "NEWS"
      **********************************************************************
      **    MESSAGE 035/047:
      **  INVALID CLOCK CARD NUMBER
      **********************************************************************
               MOVE  35        TO CATREAD-MSG-SET
               MOVE  47        TO CATREAD-MSG-NUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE 1              TO FIELD-NUMBER
               PERFORM ERROR-ROUTINE
               GO TO SHOWFORM.

           MOVE DIST-CC-BUF    TO PERCCNUM OF PER-PERSONNEL.
           START PER-PERSONNEL KEY = PERCCNUM OF PER-PERSONNEL
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
      **********************************************************************
      **    MESSAGE 035/047:
      **  INVALID CLOCK CARD NUMBER
      **********************************************************************
               MOVE  35        TO CATREAD-MSG-SET
               MOVE  47        TO CATREAD-MSG-NUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE 1              TO FIELD-NUMBER
               PERFORM ERROR-ROUTINE
               GO TO SHOWFORM.

       EDIT-ZONE.
           IF DIST-ZONE-BUF = SPACES
               GO TO EDIT-CRAFT.

           MOVE DIST-ZONE-BUF  TO ZONE-ARG.
           MOVE ZONE-ARGUMENT  TO ZONEPRTY OF WO-ZONE-PRTY.
           START WO-ZONE-PRTY  KEY = ZONEPRTY OF WO-ZONE-PRTY
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
      **********************************************************************
      **    MESSAGE 035/044:
      **  INVALID ZONE
      **********************************************************************
               MOVE  35        TO CATREAD-MSG-SET
               MOVE  44        TO CATREAD-MSG-NUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE 2              TO FIELD-NUMBER
               PERFORM ERROR-ROUTINE
               GO TO SHOWFORM.

       EDIT-CRAFT.
           IF DIST-CRFT-BUF = SPACES
               GO TO ADD-DIST-RECORD.

           MOVE DIST-CRFT-BUF  TO CRAFTREQD OF WO-CRAFTS-REQD.
           START WO-CRAFTS-REQD KEY = CRAFTREQD OF WO-CRAFTS-REQD
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
      **********************************************************************
      **    MESSAGE 035/043:
      **  INVALID CRAFT/SKILL
      **********************************************************************
               MOVE  35        TO CATREAD-MSG-SET
               MOVE  43        TO CATREAD-MSG-NUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE 3              TO FIELD-NUMBER
               PERFORM ERROR-ROUTINE
               GO TO SHOWFORM.

       ADD-DIST-RECORD.
           MOVE SPACES         TO DISTRIBUTION-TABLE.
           MOVE DLIST-CODE     TO DIST-KEY.
           MOVE DIST-ZONE-BUF  TO DIST-ZONE.
           MOVE "1 "           TO DIST-PRTY.
           MOVE DIST-CRFT-BUF  TO DIST-CRFT.

           IF DIST-CC-BUF NOT = SPACES
               MOVE DIST-CC-BUF TO DIST-CC-NUM
           ELSE
               MOVE "9999"     TO DIST-CC-NUM.

           WRITE DL-REC        FROM DISTRIBUTION-TABLE.
           IF FILE-STAT NOT = "00"
               MOVE FILE-STAT  TO CON-WORD
               MOVE "WRITE   " TO DB-FUNC
               MOVE "NEWS-TABLE" TO DB-FILE
               MOVE DB-ERROR   TO MESSAGE-BUFFER
               PERFORM ERROR-ROUTINE
               GO TO SHOWFORM.

           GO TO MAIN.

       GET-DLIST.
           MOVE SPACES         TO MESSAGE-BUFFER.
           MOVE DLIST-CODE     TO NEWSKEY OF NEWS-TABLE.
           START NEWS-TABLE    KEY = NEWSKEY OF NEWS-TABLE
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
      **********************************************************************
      **    MESSAGE 040/015:
      **  NO RECORDS FOUND
      **********************************************************************
               MOVE  40        TO CATREAD-MSG-SET
               MOVE  15        TO CATREAD-MSG-NUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER TO ERRMSG
               MOVE TRUE-VAL   TO IND(99)
               GO TO GDL-EXIT.

       DBGET-DLIST.
           READ NEWS-TABLE     NEXT INTO DISTRIBUTION-TABLE
               AT END          MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
               IF FILE-STAT = "10" OR "14" OR "46"
                   GO TO GDL-CONT
               ELSE
                   MOVE "READ    " TO DB-FUNC
                   MOVE "NEWS-TABLE" TO DB-FILE
                   MOVE FILE-STAT  TO CON-WORD
                   MOVE DB-ERROR   TO ERRMSG
                   MOVE TRUE-VAL   TO IND(99)
                   GO TO GDL-EXIT.

           IF DIST-KEY NOT = DLIST-CODE
               GO TO GDL-CONT.

           IF DIST-CC-NUM = "9999"
               MOVE SPACES     TO DIST-CC
           ELSE
              MOVE DIST-CC-NUM TO DIST-CC.

           MOVE DIST-ZONE      TO DIST-ZN.
           MOVE DIST-CRFT      TO DIST-CR.
           MOVE DLIST-LINE     TO DISPLAY-REC.
           ADD  1              TO RECNO.
           WRITE SUBFILE DISPLAY-REC FORMAT "RDSF"
               INDIC ARE SCREEN-INDICATORS.
           GO TO DBGET-DLIST.

       GDL-CONT.
           WRITE DISPLAY-REC FORMAT "RDSB"
               INDIC ARE SCREEN-INDICATORS.
           MOVE B"1"           TO IND(76).
           IF RECNO > 0
               MOVE TRUE-VAL   TO IND(75)
           ELSE
               MOVE NEG-VAL    TO IND(75).
           MOVE DLIST-CODE     TO DISPLAY-REC.
           WRITE DISPLAY-REC FORMAT "RDSC"
               INDIC ARE SCREEN-INDICATORS.
           READ DISPLAY-FILE FORMAT "RDSC"
               INDIC ARE SCREEN-INDICATORS.

       GDL-EXIT.    EXIT.

       SUBF-CLEAR.
           MOVE 0              TO RECNO.
           MOVE NEG-VAL        TO IND(75) IND(76).
           MOVE TRUE-VAL       TO IND(77).
           MOVE SPACES         TO DISPLAY-REC.
           WRITE DISPLAY-REC FORMAT "RDSC"
               INDIC ARE SCREEN-INDICATORS.
           MOVE NEG-VAL        TO IND(77).

       ERROR-ROUTINE.
           MOVE MESSAGE-BUFFER TO ERRMSG.
           MOVE TRUE-VAL       TO IND(FIELD-NUMBER) IND(99).

       END-OF-JOB.
           CLOSE               NEWS-TABLE.
           CLOSE               PER-PERSONNEL.
           CLOSE               WO-CRAFTS-REQD.
           CLOSE               WO-ZONE-PRTY.
           CLOSE               DISPLAY-FILE.
           GOBACK.

       999-CATREAD.
           MOVE SPACES         TO MESSAGE-BUFFER.
           CALL "CCATREAD" USING CATREAD-PARMS.
           MOVE CATREAD-MSG-TEXT TO MESSAGE-BUFFER.

       999-CATREAD-EXIT.    EXIT.

