046400*************************************************************
046500*************************************************************
046600**                PROCEDURE DIVISION                       **
046700**                                                         **
046800**   FIND ALL INVOICES THAT ARE ON HOLD AND PRINT REPORT.  **
046900**                                                         **
047000**     1.  READ ENTIRE DINVRCD DATASET.                    **
047100**     2.  IF INV-STATUS NOT = H OR I (H=HOLD INVOICE AND  **
047200**            I=HOLD ITEMS) THEN GO TO 1.                  **
047300**     3.  WRITE INVOICE TO A FILE.                        **
047400**     4.  GO TO 1 UNTIL ALL OF INVRCD HAS BEEN READ.      **
047500**     5.  SORT FILE BY OLDEST DUE DATE.                   **
047600**     6.  READ SORT FILE.                                 **
047700**     7.  USE REGISTER NUMBER AND READ DFREIGHT DATASET.  **
047800**     8.  PRINT FREIGHT DATA UNTIL CHAIN ENDS ON DFREIGHT.**
047900**     9.  USE REGISTER NUMBER AND READ DINVITM.           **
048000**         A)  USE REGISTER NUMBER AND READ DINVACCT.      **
048100**         B)  COMPARE DINVACCT ITEM NUMBER WITH DINVITM   **
048200**             ITEM NUMBER.  IF ITEM NUMBERS MATCH,        **
048300**             PRINT DATA.  CONTINUE THIS UNTIL ITEMS ARE  **
048400**             DIFFERENT.  THEN GO TO 9.                   **
048500**    10.  PRINT DINVITM DATA ON ITEMS UNTIL CHAIN ENDS.   **
048600**    11.  GO TO 6 UNTIL ALL OF DINVRCD HAS BEEN READ.     **
048700**                                                         **
048800*************************************************************
048900*************************************************************
       PROCEDURE DIVISION USING HD-ROUTE-DATA, DE-LINE.
049100 00-MAIN.
9406CK     MOVE "C" TO SCOPE.
9406CK     CALL "MCXCBLERR" USING SCOPE.

049200     PERFORM 010-OPEN-FILES THRU 019-EXIT.
049300
049400     PERFORM 100-FIND-INVOICES-ON-HOLD THRU 199-EXIT.
049500
049600     PERFORM 200-SORT-BY-DUE-DATE THRU 299-EXIT.
049700
049800     PERFORM 300-BEGIN-REPORT THRU 399-EXIT.
049900
050000     PERFORM 020-CLOSE-FILES THRU 029-EXIT.
050100
050200     GOBACK.
050400*************************************************************
050500*           OPEN DATABASE AND PRINT FILE                    *
050600*************************************************************
050700 010-OPEN-FILES.
           OPEN INPUT DINVRCD-I, DPOFREIGHT-I, DINVITM-I,
                      DINVACCT-I, DVENDOR-I.
051200
      *----- CALL CCRTFILE TO CREATE A TEMPORARY FILE FOR SORTING
      *----- LIBRARY 'QTEMP' IS USED FOR TEMPORARY FILES
           MOVE SPACES        TO CCRTFILE-PARMS.
           MOVE "QTEMP"       TO CCRTFILE-LIBRARY.
           MOVE "INVSRT"      TO CCRTFILE-FILE.
           MOVE "0014"        TO CCRTFILE-RECORD-LENGTH.
           MOVE "90000"       TO CCRTFILE-NO-RECORDS.
           MOVE "02000"       TO CCRTFILE-INCREMENT-AMT.
           MOVE "10"          TO CCRTFILE-NO-INCREMENTS.
           CALL "CCRTFILE" USING CCRTFILE-LIBRARY,
                                 CCRTFILE-FILE,
                                 CCRTFILE-RECORD-LENGTH,
                                 CCRTFILE-NO-RECORDS,
                                 CCRTFILE-INCREMENT-AMT,
                                 CCRTFILE-NO-INCREMENTS,
                                 CCRTFILE-STATUS.
           IF CCRTFILE-STATUS NOT = "00"
               MOVE "CCRTFILE CREATE OF 'INVSRT' FAILED"
                  TO BU-DISPLAY-MSG
               PERFORM 990-BLOWUP THRU 999-EXIT.
052500
052600*----------  OPEN OUTPUT FILE
052700     OPEN OUTPUT HOLD-FILE.
052800
053200 019-EXIT.  EXIT.
053300
053400*************************************************************
053500*               CLOSE DATABASE AND PRINT FILE               *
053600*************************************************************
053700 020-CLOSE-FILES.
053800     CLOSE DISC-PRT, HOLD-FILE.
           CLOSE DINVRCD-I, DPOFREIGHT-I, DINVITM-I, DINVACCT-I,
                 DVENDOR-I.
054000 029-EXIT.  EXIT.
054200*************************************************************
054300*************************************************************
054400*       READ ALL OF DINVRCD ENTRIES AND USE ONLY THE        *
054500*       RECORDS THAT ARE ON HOLD STATUS.                    *
054600*************************************************************
054700*************************************************************
054800 100-FIND-INVOICES-ON-HOLD.
           READ DINVRCD-I FIRST RECORD INTO BUF-DINVRCD.
           IF FILE-STATUS NOT = "00"
               GO TO 199-EXIT.

           IF INV-STATUS = "H " OR "I "
               GO TO 105-WRITE.

       101-SERIAL-READ-DINVRCD.
           READ DINVRCD-I NEXT INTO BUF-DINVRCD
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   GO TO 199-EXIT
               ELSE
055400        MOVE "READN DINVRCD AT 101 IN TINVHLD" TO BU-DISPLAY-MSG
055500        PERFORM 990-BLOWUP THRU 999-EXIT.
055600
055700     IF INV-STATUS = "H " OR "I "
055800         GO TO 105-WRITE.
055900     GO TO 101-SERIAL-READ-DINVRCD.
056000
056100 105-WRITE.
056200
056300*----------  WRITE INVOICE NUMBER AND DUE DATE TO A FILE
056400     MOVE INV-REG-NO             TO HOLD-REG-NO.
      *----------  ACCOUNT FOR CENTURY.
056500     MOVE INV-DUE-CN             TO HOLD-DUE-DATE.
056600     WRITE HOLD-REC.
056700     GO TO 101-SERIAL-READ-DINVRCD.
056800
056900 199-EXIT.  EXIT.
057000
057100*************************************************************
057200*************************************************************
057300**         SORT HOLD FILE BY OLDEST DUE DATE               **
057400*************************************************************
057500*************************************************************
057600 200-SORT-BY-DUE-DATE.
057700     CLOSE HOLD-FILE.
057800     IF DE-OPTION = "R"
057900     SORT SORT-FILE ON ASCENDING KEY SORT-INV-NO
058000          USING HOLD-FILE
058100          GIVING HOLD-FILE
058200     ELSE
058300        SORT SORT-FILE ON ASCENDING KEY SORT-DUE-DATE
058400             USING HOLD-FILE
058500             GIVING HOLD-FILE.
058600
058700     OPEN  INPUT HOLD-FILE.

058900 299-EXIT.  EXIT.
059100*************************************************************
059200*************************************************************
059300**                 CREATE REPORT                           **
059400**     READ EACH SORTED RECORD AND GET ALL ASSOCIATED      **
059500**     ITEMS WITH THE INVOICE.  ITEM INFORMATION WILL      **
059600**     BE RETRIEVED FROM DINVITM, DFREIGHT, AND DINVACCT.  **
059700*************************************************************
059800*************************************************************
059900 300-BEGIN-REPORT.
      *---------- OPEN THE PRINT FILE, GET THE FILE NUMBER OF THE PRINT
      *---------- FILE, AND PRINT THE HEADER PAGE.

           MOVE HD-SPOOLER-NUMBER TO OVRPRTF-TOFILE-NUM.
           MOVE "*YES"            TO OVRPRTF-SHARED.
           MOVE HD-NO-OF-COPIES   TO OVRPRTF-COPIES.
           MOVE "MCPRT"           TO OVRPRTF-FILE.
           PERFORM 996-OVERRIDE-PRINT-FILE.
           OPEN OUTPUT DISC-PRT.

060300     CALL "THDPRT2" USING HD-RET-CODE, HD-FILE-NAME, FNUM
060400       HD-ROUTE-DATA, ESC-NAME.
060500     IF HD-RET-CODE NOT = 0
060600         DISPLAY "THDPRT2 ERROR, RET-CODE = ", HD-RET-CODE
060700         PERFORM 990-BLOWUP THRU 999-EXIT.
060800
060900 303-CREATE-REPORT.
061000     READ HOLD-FILE AT END
061100        MOVE SPACES             TO PRINT-LINE
061200        MOVE ALL "*"            TO PRINT-LINE
061400        MOVE PRINT-LINE         TO PRT-LINE
061500        WRITE PRT-REC AFTER ADVANCING 3 LINES
061600        PERFORM 379-PRINT-TOTALS
061610         GO TO 399-EXIT.
061700
061800*----------  READ EACH INVOICE RECORD
062400
062500 305-GET-DINVRCD.
           MOVE HOLD-REG-NO TO REGISTERNO OF DINVRCD-REC-I.
           READ DINVRCD-I INTO BUF-DINVRCD
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS-1 = "2"
               GO TO 303-CREATE-REPORT
           ELSE
           IF FILE-STATUS NOT = "00"
063100        MOVE "DBGET DINVRCD AT 305 IN TINVHLD" TO BU-DISPLAY-MSG
063200        PERFORM 990-BLOWUP THRU 999-EXIT.
063300
063400*----------  WRITE FIRST 14 LINES OF DINVRCD DATA
063500     IF LINE-CTR > 58
063600        PERFORM 800-NEW-PAGE THRU 809-EXIT.
063700
063800     MOVE SPACES                TO PRINT-LINE.
063900     MOVE ALL "*"               TO PRINT-LINE.
064100     MOVE PRINT-LINE            TO PRT-LINE.
064200     WRITE PRT-REC AFTER ADVANCING 3 LINES.
064300
064400     MOVE SPACES                TO PRINT-LINE.
064500     MOVE "REGISTER"            TO HEAD2-REGISTER.
064600     MOVE "INVOICE NUMBER"      TO HEAD2-INVOICE.
064700     MOVE "STATUS"              TO HEAD2-STATUS.
064800     MOVE "INVOICE DATE"        TO HEAD2-INV-DATE.
064900     MOVE "ENTRY DATE"          TO HEAD2-ENTRY-DATE.
