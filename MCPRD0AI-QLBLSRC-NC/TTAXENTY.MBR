000300 IDENTIFICATION DIVISION.
000400 PROGRAM-ID.          TTAXENTY.
000500 AUTHOR.              KURT MOVSESIAN.
000600 DATE-WRITTEN.        MAY 8, 1985.
000900
001000
001100******************************************************
001200*                                                    *
001300*   PU6   MODIFY TAX CODES - THIS PROGRAM ADDS,      *
001400*         MODIFIES AND DELETES TAX CODES USED IN     *
001500*         PURCHASING AND ACCOUNTS PAYABLE            *
001600*                                                    *
001700******************************************************
      *
      *C  06/02/99   CA YODER   (DECATUR REQUEST)
      *C    EXPANDED TAX RATE PERCENTAGE FROM 2 DECIMAL
      *C    PLACES TO 4.
      *
004300
004400
004500 ENVIRONMENT DIVISION.
004600 CONFIGURATION SECTION.
004700 SOURCE-COMPUTER.  HP-3000.
004800 OBJECT-COMPUTER.  HP-3000.
       SPECIAL-NAMES. I-O-FEEDBACK IS I-O-FEEDBACK-AREA.

       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT DISPLAY-FILE
                  ASSIGN TO WORKSTATION-ZTAXENTY-SI
                  ORGANIZATION IS TRANSACTION
                  ACCESS IS SEQUENTIAL
                  FILE STATUS IS DISPLAY-STATUS
                  CONTROL-AREA IS WS-CONTROL.

           SELECT MPLTINFO-I
                  ASSIGN TO DATABASE-MCFLCS0501
                  ORGANIZATION IS INDEXED
                  ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                  FILE STATUS IS FILE-STATUS.

           SELECT MTAX-O
                  ASSIGN TO DATABASE-MCFLCS3701
                  ORGANIZATION IS INDEXED
                  ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                  FILE STATUS IS FILE-STATUS.

           SELECT MCOMMENT-O
                  ASSIGN TO DATABASE-MCFLCS1801
                  ORGANIZATION IS INDEXED
                  ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                  FILE STATUS IS FILE-STATUS.

           SELECT DCOMMENT-O
                  ASSIGN TO DATABASE-MCFLCS1901
                  ORGANIZATION IS INDEXED
                  ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                  WITH DUPLICATES
                  FILE STATUS IS FILE-STATUS.


004900
005000 DATA DIVISION.
       FILE SECTION.

       FD  DISPLAY-FILE
           LABEL RECORDS ARE OMITTED.
       01  DISPLAY-REC.
           COPY DDS-ALL-FORMATS OF ZTAXENTY.
005100
       FD  MPLTINFO-I
           LABEL RECORDS ARE STANDARD.
       01  MPLTINFO-REC-I.
           COPY DDS-ALL-FORMATS OF MCFLCS0501.

       FD  MTAX-O
           LABEL RECORDS ARE STANDARD.
       01  MTAX-REC-O.
           COPY DDS-ALL-FORMATS OF MCFLCS3701.

       FD  MCOMMENT-O
           LABEL RECORDS ARE STANDARD.
       01  MCOMMENT-REC-O.
           COPY DDS-ALL-FORMATS OF MCFLCS1801.

       FD  DCOMMENT-O
           LABEL RECORDS ARE STANDARD.
       01  DCOMMENT-REC-O.
           COPY DDS-ALL-FORMATS OF MCFLCS1901.

005200 WORKING-STORAGE SECTION.
       01  FILE-STATUS.
           05  FILE-STATUS-1            PIC X  VALUE "0".
           05  FILE-STATUS-2            PIC X  VALUE "0".

005300 77  COMPANY-SAVE                 PIC X(3)    VALUE SPACES.
005500
005600
