016300**************************************************************
016400**************************************************************
016500**                                                          **
016600**             TERMINAL I/O DATA AREA                       **
016700**                                                          **
016800**************************************************************
016900**************************************************************
017000
017100 01  SCREEN-1.
017200     05  DISP-COMPANY-1          PIC X(3)  VALUE SPACES.
           05  DISP-COMMAND-LINE       PIC X(79) VALUE SPACES.
           05  DISP-MESSAGE-LINE       PIC X(79) VALUE SPACES.
017300
017400 01  SCREEN-2.
017500     05  DISP-COMPANY-2          PIC X(3)  VALUE SPACES.
017600     05  DISP-TAX-DISTRICT-LIST.
017700         10  DISP-TAX-DIST       PIC X(15) OCCURS 4 TIMES.
017800     05  DE-TAX-CODE             PIC X(2)  VALUE SPACES.
017900     05  DE-TAX-PERCENT-LIST  OCCURS 4 TIMES.
018000****     10  DE-TAX-PERCENT      PIC 99V99.
018000         10  DE-TAX-PERCENT      PIC 99V9999.
018100         10  DE-TAX-PAY-INDIC    PIC X.
018200     05  DE-TAX-DESC.
018300         10  DE-TAX-DESC-LINE    PIC X(36) OCCURS 6 TIMES.
           05  DE-COMMAND-LINE         PIC X(79).
           05  DE-MESSAGE-LINE         PIC X(79).
018400
       COPY DISPDATA IN COPYLIB.

       COPY IOFEEDBACK IN COPYLIB.

       COPY CATREAD IN COPYLIB.
018500
018600 01  SAVE-TAX-DISTRICTS.
018700     05  TAX-DISTRICT           PIC X(15)  OCCURS 4 TIMES.
018800
018900 01  SAVE-OLD-TAX-DESC.
019000     05  TAX-DESC-LINE          PIC X(36)  OCCURS 6 TIMES.
019100
019200 COPY TBLOWUP IN COPYLIB.
019300
019400 COPY LANGUAGE IN COPYLIB.
019500
019600
019700 PROCEDURE DIVISION.
019800
019900 PROC-DIV SECTION 01.
020000
020100 BEGIN-HERE.
020200
020300     PERFORM 1-HSK THRU 1-H-X.
020400
020500     PERFORM 6-MAIN  THRU  6-M-X.
020600
020700     PERFORM 2-EOJ  THRU 2-EOJ-X.
020800
020900     GOBACK.
021000
021100 1-HSK.
           OPEN I-O DISPLAY-FILE, MTAX-O, MCOMMENT-O, DCOMMENT-O.
           OPEN INPUT MPLTINFO-I.

025600**************************************************
025700*                                                *
025800*   GET CO. AND PRIME FROM MPLTINFO              *
025900*   USING 'P 01' AS THE ARGUMENT                 *
026000*                                                *
026100**************************************************
026200
026300     MOVE "P 01"  TO  PLT-ARG.
           MOVE PLT-ARG TO PLTINFOKEY OF MPLTINFO-REC-I.
           READ MPLTINFO-I INTO BUF-MPLTINFO
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
026700         MOVE "DBGET MPLTINFO 1-HSK P 01"  TO  BU-DISPLAY-MSG
026800         MOVE PLT-ARG                  TO  BU-DISPLAY-FLD (2)
026900         GO TO 2-BLOWUP.
027000     MOVE MPLTINFO-COMPANY    TO  COMPANY-SAVE.
027100
027200     MOVE "PTX1"              TO  PLT-ARG.
           MOVE PLT-ARG TO PLTINFOKEY OF MPLTINFO-REC-I.
           READ MPLTINFO-I INTO BUF-MPLTINFO
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
027600         MOVE "DBGET MPLTINFO 1-HSK PTX1"  TO  BU-DISPLAY-MSG
027700         MOVE PLT-ARG                  TO  BU-DISPLAY-FLD (2)
027800         GO TO 2-BLOWUP.
027900
028000     MOVE MPLTINFO-TAX-DISTRICT (1)   TO  TAX-DISTRICT (1).
028100     MOVE MPLTINFO-TAX-DISTRICT (2)   TO  TAX-DISTRICT (2).
028200
028300     MOVE "PTX2"                TO  PLT-ARG.
           MOVE PLT-ARG TO PLTINFOKEY OF MPLTINFO-REC-I.
           READ MPLTINFO-I INTO BUF-MPLTINFO
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
028700         IF FILE-STATUS-1 = "2"
028800             MOVE SPACES        TO  TAX-DISTRICT (3),
028900                                    TAX-DISTRICT (4)
029000         ELSE
029100             MOVE "GET MPLTINFO 1-HSK PTX2" TO BU-DISPLAY-MSG
029200             MOVE PLT-ARG  TO  BU-DISPLAY-FLD (2)
029300             GO TO 2-BLOWUP
029400     ELSE
029500         MOVE MPLTINFO-TAX-DISTRICT (1)  TO  TAX-DISTRICT (3)
029600         MOVE MPLTINFO-TAX-DISTRICT (2)  TO  TAX-DISTRICT (4).
029700
029800*************************************************
029900*                                               *
030000*  LOAD MTAX WITH MTAX-CODE = "NO".  FOR USE    *
030100*  IN COUNTRIES THAT DO NOT HAVE A TAX CODE.    *
030200*                                               *
030300*************************************************
030400
031300
031400     MOVE SPACES  TO BUF-MTAX.
031500     MOVE "NO"    TO MTAX-CODE.
031600     MOVE ZEROES  TO MTAX-PERCENT (1),
031700                     MTAX-PERCENT (2),
031800                     MTAX-PERCENT (3),
031900                     MTAX-PERCENT (4).
032000     MOVE SPACES  TO MTAX-PAY-INDIC-LIST (1),
032100                     MTAX-PAY-INDIC-LIST (2),
032200                     MTAX-PAY-INDIC-LIST (3),
032300                     MTAX-PAY-INDIC-LIST (4).
032400
           WRITE MTAX-REC-O FROM BUF-MTAX
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS = "00" OR FILE-STATUS = "22"
032800         NEXT SENTENCE
032900     ELSE
033000         MOVE "PUT MTAX ERROR IN 1-HSK" TO BU-DISPLAY-MSG
033100         GO TO 2-BLOWUP.
033200
033300     MOVE "T NO"              TO MCOM-COMMENT-NO.
           WRITE MCOMMENT-REC-O FROM BUF-MCOMMENT
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS = "00" OR FILE-STATUS = "22"
033700         NEXT SENTENCE
033800     ELSE
033900         MOVE "PUT MCOMMENT 1-HSK" TO BU-DISPLAY-MSG
034000         MOVE "T NO"               TO BU-DISPLAY-FLD (2)
034100         GO TO 2-BLOWUP.
034200
035000 1-H-X.
035100     EXIT.
035200
035300
035400 2-EOJ.
           CLOSE    DISPLAY-FILE, MTAX-O, MCOMMENT-O, DCOMMENT-O,
                    MPLTINFO-I.
037400
037500 2-EOJ-X.
037600      EXIT.
037700
037800******************************************************
037900**                                                  **
038000**   BLOWUP ROUTINE                                 **
038100**                                                  **
038200******************************************************
038300
038400 2-BLOWUP.
038500     MOVE "TTAXENTY"              TO  BU-PGM-NAME.
038600     CALL "TBLOWUP" USING BASE, BU-PGM-NAME, STATUS-AREA,
038700         VIEW-COMAREA, FILE-STATUS, BU-DISPLAY-MSG,
038800                 BU-DISPLAY-FLDS.
038900
039000 2-BLOWUP-X.
039100     EXIT.
039200
042000
042100 4-PGM-ERROR.
           MOVE B"1" TO IND (FIELD-NUMBER) IND (99).
           MOVE MESSAGE-BUFFER TO DISP-MESSAGE-LINE,
                                  DE-MESSAGE-LINE.
042900
043000 4-PGM-ERROR-X.
043100     EXIT.
043200
045200
045300**************************************************
045400*                                                *
045500*     6 - M A I N                                *
045600*                                                *
045700**************************************************
045800
045900 6-MAIN.
046000     MOVE "TAXENTY1"  TO  VIEW-NFNAME.
047400
047600     MOVE SPACES        TO  SCREEN-1.
047700     MOVE COMPANY-SAVE  TO  DISP-COMPANY-1.
048400
048500 6-SHOWFORM-SCREEN-1.
           MOVE SCREEN-1       TO DISPLAY-REC.
           PERFORM 998-WRITE-SCREEN THRU 998-READ-SCREEN.
           MOVE DISPLAY-REC    TO SCREEN-1.
050300
050400     IF VIEW-LASTKEY = 3
050500         GO TO 6-M-X.
051900
052100     IF VIEW-LASTKEY = 1
052200         PERFORM 61-ADD-TAX-CODE  THRU  61-ATC-X
052300     ELSE
052400     IF VIEW-LASTKEY = 2
052500         PERFORM 62-MODIFY-TAX-CODE  THRU  62-MTC-X
052600     ELSE
052700     IF VIEW-LASTKEY = 8
052800         PERFORM 63-DELETE-TAX-CODE  THRU  63-DTC-X
052900     ELSE
053000*        *** PRESS DESIRED FUNCTION KEY ***
053100         MOVE  16 TO LANG-SETNUM
053200         MOVE  43 TO LANG-MSGNUM
053300         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
053400         MOVE 99  TO  FIELD-NUMBER
053500         PERFORM 4-PGM-ERROR  THRU  4-PGM-ERROR-X
053600         GO TO 6-SHOWFORM-SCREEN-1.
053700
053800     GO TO 6-MAIN.
053900
054000 6-M-X.
054100     EXIT.
054200
054300*********************************************************
054400*                                                       *
054500*   A D D   T A X   C O D E S                           *
054600*                                                       *
054700*********************************************************
054800
054900 61-ADD-TAX-CODE.
055000     MOVE "TAXENTY2"  TO  VIEW-NFNAME.
056600     MOVE SPACES        TO  SCREEN-2.
056700     MOVE COMPANY-SAVE TO  DISP-COMPANY-2.
056800     MOVE SAVE-TAX-DISTRICTS  TO  DISP-TAX-DISTRICT-LIST.
           PERFORM 66-ZERO-OUT-PERCENT
               VARYING SUB FROM 1 BY 1 UNTIL SUB > 4.
057500
057600 61-SHOWFORM-SCREEN-2.
           MOVE SCREEN-2       TO DISPLAY-REC.
           PERFORM 998-WRITE-SCREEN THRU 998-READ-SCREEN.
           MOVE DISPLAY-REC    TO SCREEN-2.
060200
060300     IF VIEW-LASTKEY = 3
060400         GO TO 61-ATC-X
           ELSE
061900     IF VIEW-LASTKEY = 1 OR
062000        VIEW-LASTKEY = 2 OR
062100        VIEW-LASTKEY = 4 OR
062200        VIEW-LASTKEY = 5 OR
062300        VIEW-LASTKEY = 6 OR
062400        VIEW-LASTKEY = 7 OR
              VIEW-LASTKEY = 8
062600*        *** INVALID FUNCTION KEY ENTERED ***
062700         MOVE   9 TO LANG-SETNUM
062800         MOVE  10 TO LANG-MSGNUM
062900         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
063000         MOVE 5  TO  FIELD-NUMBER
063100         PERFORM 4-PGM-ERROR  THRU  4-PGM-ERROR-X
063200         GO TO 61-SHOWFORM-SCREEN-2.
065600
065700 61-EDIT-TAX-CODE.
           IF DE-TAX-CODE = SPACES
      *         YOU MUST ENTER A TAX CODE
               MOVE 66164 TO CATREAD-MSG-NUMBER
069800         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
069900         MOVE 5  TO FIELD-NUMBER
070000         PERFORM 4-PGM-ERROR  THRU  4-PGM-ERROR-X
070100         GO TO 61-SHOWFORM-SCREEN-2.

065800     MOVE DE-TAX-CODE            TO  TAX-ARG.
           MOVE TAX-ARG TO TAXCDE OF MTAX-REC-O.
           READ MTAX-O INTO BUF-MTAX
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
066200         IF FILE-STATUS-1 = "2"
066300             NEXT SENTENCE
066400         ELSE
066500             MOVE "GET MTAX * 61-ET" TO BU-DISPLAY-MSG
066600             MOVE TAX-ARG               TO BU-DISPLAY-FLD (1)
066700             GO TO 2-BLOWUP
066800     ELSE
066900*        *** TAX CODE ALREADY EXISTS ***
067000         MOVE  20 TO LANG-SETNUM
067100         MOVE  44 TO LANG-MSGNUM
067200         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
067300         MOVE DE-TAX-CODE  TO  MSG-FLD
067400         MOVE 5        TO  FIELD-NUMBER
067500         PERFORM 4-PGM-ERROR  THRU  4-PGM-ERROR-X
      *------- DO A START > HIGH-VALUES TO UNLOCK
               MOVE HIGH-VALUES TO TAXCDE OF MTAX-REC-O
               START MTAX-O KEY > TAXCDE OF MTAX-REC-O
                   INVALID KEY MOVE "00" TO FILE-STATUS END-START
067600         GO TO 61-SHOWFORM-SCREEN-2.
067700
067800     PERFORM 66-EDIT-TAX-PCT  THRU  66-ETP-X.
067900     IF ERR-SW = "Y"
068000         GO TO 61-SHOWFORM-SCREEN-2.
068100
068200 61-BUILD-TAX-CODE-DSETS.
070000     MOVE SPACES              TO  BUF-MTAX.
070100     MOVE DE-TAX-CODE         TO  BUILD-TAX-CODE,
070200                                  MTAX-CODE.
070300     MOVE ZEROS               TO  SUB.
070400
070500 61-MOVE-TAX-PERCENT.
070600     ADD 1  TO  SUB.
070700     IF SUB > 4
070800         NEXT SENTENCE
070900     ELSE
071000         MOVE DE-TAX-PERCENT (SUB)     TO  MTAX-PERCENT (SUB)
071100         MOVE DE-TAX-PAY-INDIC (SUB)   TO  MTAX-PAY-INDIC (SUB)
071200         GO TO 61-MOVE-TAX-PERCENT.
071300
           WRITE MTAX-REC-O FROM BUF-MTAX
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
071700         MOVE "PUT MTAX 61-PTC" TO BU-DISPLAY-MSG
071800         MOVE TAX-ARG           TO BU-DISPLAY-FLD (1)
071900         GO TO 2-BLOWUP.
072000
072100 61-BUILD-MCOMMENT.
072200     MOVE BUILD-TAX-CODE-KEY  TO  MCOM-COMMENT-NO.
           WRITE MCOMMENT-REC-O FROM BUF-MCOMMENT
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
072600         MOVE "PUT MCOMMENT 61-BM" TO BU-DISPLAY-MSG
072700         MOVE BUILD-TAX-CODE-KEY  TO BU-DISPLAY-FLD (1)
072800         GO TO 2-BLOWUP.
072900
073000     PERFORM 661-ADD-DESC  THRU  661-AD-X.
073100
074000     GO TO 61-ADD-TAX-CODE.
074100
074200 61-ATC-X.
074300     EXIT.
074400
074500*********************************************************
074600*                                                       *
074700*   M O D I F Y   T A X   C O D E S                     *
074800*                                                       *
074900*********************************************************
075000
075100 62-MODIFY-TAX-CODE.
075200     MOVE "TAXENTY3"    TO  VIEW-NFNAME.
076800     MOVE SPACES        TO  SCREEN-2.
076900     MOVE COMPANY-SAVE  TO  DISP-COMPANY-2.
077000     MOVE SAVE-TAX-DISTRICTS  TO  DISP-TAX-DISTRICT-LIST.
           PERFORM 66-ZERO-OUT-PERCENT
               VARYING SUB FROM 1 BY 1 UNTIL SUB > 4.
077700
077800 62-SHOWFORM-SCREEN-3.
           MOVE SCREEN-2       TO DISPLAY-REC.
           PERFORM 998-WRITE-SCREEN THRU 998-READ-SCREEN.
           MOVE DISPLAY-REC    TO SCREEN-2.
079600
079700     IF VIEW-LASTKEY = 3
079800         GO TO 62-MTC-X
079900     ELSE
081300     IF VIEW-LASTKEY = 1 OR
081400        VIEW-LASTKEY = 2 OR
081500        VIEW-LASTKEY = 4 OR
081600        VIEW-LASTKEY = 5 OR
081700        VIEW-LASTKEY = 6 OR
081800        VIEW-LASTKEY = 7 OR
              VIEW-LASTKEY = 8
082000*        *** INVALID FUNCTION KEY ENTERED ***
082100         MOVE   9 TO LANG-SETNUM
082200         MOVE  10 TO LANG-MSGNUM
082300         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
082400         MOVE 5  TO  FIELD-NUMBER
082500         PERFORM 4-PGM-ERROR  THRU  4-PGM-ERROR-X
082600         GO TO 62-SHOWFORM-SCREEN-3.
084600
084700 62-EDIT-TAX.
           IF DE-TAX-CODE = SPACES
      *         YOU MUST ENTER A TAX CODE
               MOVE 66164 TO CATREAD-MSG-NUMBER
069800         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
069900         MOVE 5  TO FIELD-NUMBER
070000         PERFORM 4-PGM-ERROR  THRU  4-PGM-ERROR-X
070100         GO TO 62-SHOWFORM-SCREEN-3.

084800     MOVE DE-TAX-CODE            TO  TAX-ARG.
           MOVE TAX-ARG TO TAXCDE OF MTAX-REC-O.
           READ MTAX-O INTO BUF-MTAX
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
085200         IF FILE-STATUS-1 = "2"
085300*            *** TAX CODE DOESN'T EXIST ***
085400             MOVE  20 TO LANG-SETNUM
085500             MOVE   7 TO LANG-MSGNUM
085600             PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
085700             MOVE DE-TAX-CODE  TO  MSG-FLD
085800             MOVE 5        TO  FIELD-NUMBER
085900             PERFORM 4-PGM-ERROR  THRU  4-PGM-ERROR-X
086000             GO TO 62-SHOWFORM-SCREEN-3
086100         ELSE
086200             MOVE "GET MTAX * 62-ET" TO BU-DISPLAY-MSG
086300             MOVE TAX-ARG          TO BU-DISPLAY-FLD (1)
086400             GO TO 2-BLOWUP.
086500
      *------- DO A START > HIGH-VALUES TO UNLOCK
           MOVE HIGH-VALUES TO TAXCDE OF MTAX-REC-O.
           START MTAX-O KEY > TAXCDE OF MTAX-REC-O
               INVALID KEY MOVE "00" TO FILE-STATUS.

086600 62-GET-SCREEN-3B.
086700     MOVE "TAXENTY3B"  TO  VIEW-NFNAME.
088200     PERFORM 66-GET-TAX-INFO  THRU  66-GTI-X.
