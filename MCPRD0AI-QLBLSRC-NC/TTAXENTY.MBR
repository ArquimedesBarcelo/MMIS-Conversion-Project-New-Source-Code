009900
010000 01  DSET-NAMES.
010100     05  DSET-NAME           PIC X(16)  VALUE SPACES.
010200     05  DSET-MPLTINFO       PIC X(16)  VALUE "MPLTINFO;".
010300     05  DSET-MTAX           PIC X(16)  VALUE "MTAX;".
010400     05  DSET-MCOMMENT       PIC X(16)  VALUE "MCOMMENT;".
010500     05  DSET-DCOMMENT       PIC X(16)  VALUE "DCOMMENT;".
010600
010700 COPY DATAB IN COPYLIB.
010800
010900 01 ITEMS-LISTING.
011000     05  COMMENT-SEARCH         PIC X(16)
011100                                 VALUE "MCOM-COMMENT-NO;".
011200     05  ALL-ITEMS              PIC XX    VALUE "@;".
011300
011400 01 ARG-VALUES.
011500     05  PLT-ARG                PIC X(4)  VALUE SPACES.
011600     05  TAX-ARG                PIC X(2)  VALUE SPACES.
011700     05  COMMENT-ARG            PIC X(4)  VALUE SPACES.
011800
012100 01  BUILD-TAX-CODE-KEY.
012200     05  FILLER                 PIC X(2)  VALUE "T ".
012300     05  BUILD-TAX-CODE         PIC X(2)  VALUE SPACES.
012400
012500 01  BEGIN-EXP-PRINT            PIC X(5) VALUE "*EXP*".
012600
012700 01  END-EXP-PRINT              PIC X(5) VALUE SPACES.
012800
012900
013000 COPY VCOMAREA IN COPYLIB.
013100
014200 01  MESSAGE-BUFFER.
014300     05  MSG-TEXT              PIC X(64)    VALUE SPACE.
014400     05  MSG-FLD               PIC X(12)    VALUE SPACE.
014500     05  MSG-FLD-9  REDEFINES  MSG-FLD      PIC Z(11)9.
014600
015100 01  FIELD-NUMBER              PIC S9(4)    VALUE 1   COMP-4.
015200
015300
015400 01  PASSED-SPOOL-PRT          PIC S9(2)    VALUE ZEROS COMP-4.
015500
015600 01  SCREEN-PRINT-PARMS.
015700     05  PRINTCNTL             PIC S9(4)    VALUE ZERO  COMP-4.
015800     05  PAGECNTL              PIC S9(4)    VALUE 49      COMP-4.
015900     05  SPOOLFIL-OPEN-SW      PIC X        VALUE "N".
016000
016100
