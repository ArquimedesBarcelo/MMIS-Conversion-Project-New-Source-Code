       IDENTIFICATION DIVISION.
       PROGRAM-ID.  TROCKSPL.
       DATE-COMPILED.
      ************************************************************
      ** THIS PROGRAM IS A SPECIAL PROGRAM WRITTEN FOR LARRY    **
      ** ROCK IN CORPORATE PURCHASING TO TOTAL 1999 PO DOLLAR   **
      ** AMOUNTS.                                               **
      *                                                         **
      *C 12/19/00 CHANGED DATES FOR YEAR 2000                   **
      *C   JEFF BUNGO                                           **
      ************************************************************
       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.
       COPY SPECIALN OF COPYLIB.
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT DPOITEM
               ASSIGN TO DATABASE-MCFLCS1002
               ORGANIZATION IS INDEXED
               ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                   WITH DUPLICATES
               FILE STATUS IS FILE-STATUS.

           SELECT DPOITMH
               ASSIGN TO DATABASE-MCFLST0401
               ORGANIZATION IS INDEXED
               ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                   WITH DUPLICATES
               FILE STATUS IS FILE-STATUS.

           SELECT DPORECD
               ASSIGN TO DATABASE-MCFLCS0901
               ORGANIZATION IS INDEXED
               ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
               FILE STATUS IS FILE-STATUS.

           SELECT DPORECDH
               ASSIGN TO DATABASE-MCFLST0301
               ORGANIZATION IS INDEXED
               ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
               FILE STATUS IS FILE-STATUS.

           SELECT DRCVITEM
               ASSIGN TO DATABASE-MCFLCS1201
               ORGANIZATION IS INDEXED
               ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                   WITH DUPLICATES
               FILE STATUS IS FILE-STATUS.

           SELECT DRCVITMH
               ASSIGN TO DATABASE-MCFLST0601
               ORGANIZATION IS INDEXED
               ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                   WITH DUPLICATES
               FILE STATUS IS FILE-STATUS.

           SELECT MPLTINFO
               ASSIGN TO DATABASE-MCFLCS0501
               ORGANIZATION IS INDEXED
               ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
               FILE STATUS IS FILE-STATUS.

           SELECT PRINT-FILE ASSIGN TO PRINTER-MCPRT.

       DATA DIVISION.
       FILE SECTION.
       FD  DPOITEM
           LABEL RECORDS ARE STANDARD.
       01  DPOITEM-REC.
           COPY DDS-MCRPCS1000  OF MCFLCS1002.

       FD  DPOITMH
           LABEL RECORDS ARE STANDARD.
       01  DPOITMH-REC.
           COPY DDS-MCRPST0400  OF MCFLST0401.

       FD  DPORECD
           LABEL RECORDS ARE STANDARD.
       01  DPORECD-REC.
           COPY DDS-MCRPCS0900  OF MCFLCS0901.

       FD  DPORECDH
           LABEL RECORDS ARE STANDARD.
       01  DPORECDH-REC.
           COPY DDS-MCRPST0300  OF MCFLST0301.

       FD  DRCVITEM
           LABEL RECORDS ARE STANDARD.
       01  DRCVITEM-REC.
           COPY DDS-MCRPCS1200  OF MCFLCS1201.

       FD  DRCVITMH
           LABEL RECORDS ARE STANDARD.
       01  DRCVITMH-REC.
           COPY DDS-MCRPST0600  OF MCFLST0601.

       FD  MPLTINFO
           LABEL RECORDS ARE STANDARD.
       01  MPLTINFO-REC.
           COPY DDS-ALL-FORMATS OF MCFLCS0501.

       FD  PRINT-FILE
           LABEL RECORDS ARE OMITTED
           RECORD CONTAINS 132 CHARACTERS
           DATA RECORD IS PRINT-REC.
       01  PRINT-REC                     PIC X(132).

       WORKING-STORAGE SECTION.
       77  CC-EXCHANGE-RATE   PIC 9(5)V9(7) VALUE ZEROES COMP-4.
       77  DISP-BGT-AMT                  PIC Z(11).
       77  DISP-HPO-CTR-COD              PIC Z(6)9.
       77  DISP-HPO-CTR-NON              PIC Z(6)9.
       77  DISP-HPO-CTR-RAW              PIC Z(6)9.
       77  DISP-HPO-DOLS-COD             PIC ZZZ,ZZZ,ZZZ,ZZ9.
       77  DISP-HPO-DOLS-NON             PIC ZZZ,ZZZ,ZZZ,ZZ9.
       77  DISP-HPO-DOLS-RAW             PIC ZZZ,ZZZ,ZZZ,ZZ9.
       77  DISP-LPO-CTR-COD              PIC Z(6)9.
       77  DISP-LPO-CTR-NON              PIC Z(6)9.
       77  DISP-LPO-CTR-RAW              PIC Z(6)9.
       77  DISP-LPO-DOLS-COD             PIC ZZZ,ZZZ,ZZZ,ZZ9.
       77  DISP-LPO-DOLS-NON             PIC ZZZ,ZZZ,ZZZ,ZZ9.
       77  DISP-LPO-DOLS-RAW             PIC ZZZ,ZZZ,ZZZ,ZZ9.
       77  DISP-TPO-CTR-COD              PIC Z(6)9.
       77  DISP-TPO-CTR-NON              PIC Z(6)9.
       77  DISP-TPO-CTR-RAW              PIC Z(6)9.
       77  DISP-TPO-DOLS-COD             PIC ZZZ,ZZZ,ZZZ,ZZ9.
       77  DISP-TPO-DOLS-NON             PIC ZZZ,ZZZ,ZZZ,ZZ9.
       77  DISP-TPO-DOLS-RAW             PIC ZZZ,ZZZ,ZZZ,ZZ9.
       77  DISP-UNIQVEN                  PIC Z(6)9.
       77  FOUND-MATCH                   PIC X.
       77  LINE-CTR                      PIC 99.
       77  LIVE-PO-CTR-COD               PIC 9(7).
       77  LIVE-PO-CTR-NON               PIC 9(7).
       77  LIVE-PO-CTR-RAW               PIC 9(7).
       77  LIVE-PO-DOLS-COD              PIC 9(12).
       77  LIVE-PO-DOLS-NON              PIC 9(12).
       77  LIVE-PO-DOLS-RAW              PIC 9(12).
       77  HIST-PO-CTR-COD               PIC 9(7).
       77  HIST-PO-CTR-NON               PIC 9(7).
       77  HIST-PO-CTR-RAW               PIC 9(7).
       77  HIST-PO-DOLS-COD              PIC 9(12).
       77  HIST-PO-DOLS-NON              PIC 9(12).
       77  HIST-PO-DOLS-RAW              PIC 9(12).
       77  SAVE-COMPANY                  PIC X(3).
       77  SAVE-HOME-CUR-CODE            PIC X(2).
       77  SAVE-VENCDE                   PIC X(10) VALUE SPACES.
       77  SUB1                          PIC S9(5) COMP-4.
       77  TOTAL-ALL-PO-CTR              PIC 9(7).
       77  TOTAL-PO-CTR-COD              PIC 9(7).
       77  TOTAL-PO-CTR-NON              PIC 9(7).
       77  TOTAL-PO-CTR-RAW              PIC 9(7).
       77  TOTAL-PO-DOLS-COD             PIC 9(12).
       77  TOTAL-PO-DOLS-NON             PIC 9(12).
       77  TOTAL-PO-DOLS-RAW             PIC 9(12).
       77  UNIQUE-VENCDE-CTR             PIC 9(7).

       01  BUILD-CUR-KEY.
           05  CUR-KEY-LIT               PIC X(2).
           05  CUR-KEY                   PIC X(2).

       01  BUILD-PO-ARG-LIVE.
           05  FILLER                    PIC X     VALUE "P".
           05  BUILD-PO-NO-LIVE.
               10  BUILD-PO-NO-L         PIC X(7).
               10  BUILD-PO-REL-L        PIC X(3).
           05  FILLER                    PIC X(3)  VALUE "000".

       01  BUILD-PO-ARG-HIST.
           05  BUILD-PO-NO-HIST.
               10  BUILD-PO-NO-H         PIC X(7).
               10  BUILD-PO-REL-H        PIC X(3).
           05  FILLER                    PIC X(3)  VALUE "000".
           05  BUILD-PO-DUP-IND          PIC X.

       01  HANDLE-BLOWUP-FLAG            PIC X(1)  VALUE "Y".

       01  ITEM-DOLLARS                  PIC 9(14).

       01  HIST-PO-TABLE.
           05  HIST-PO OCCURS 10000.
               10  H-PO-7                PIC X(7).
               10  H-PO-REL              PIC X(3).

       01  LIVE-PO-TABLE.
           05  LIVE-PO OCCURS 10000.
               10  L-PO-7                PIC X(7).
               10  L-PO-REL              PIC X(3).

      *****************************************************************
      **                                                             **
      **  S U B P R O G R A M   A R E A                              **
      **                                                             **
      *****************************************************************
       COPY SCURCONV IN COPYLIB.
       COPY TBLOWUP  IN COPYLIB.
       COPY TDATECHK IN COPYLIB.

      *****************************************************************
      **                                                             **
      **  D A T A B A S E   W O R K                                  **
      **                                                             **
      *****************************************************************
       01  BASE                          PIC X(10)  VALUE "  STORES;".
       COPY FILESTAT IN COPYLIB.
       COPY DBSTAT   IN COPYLIB.
       COPY OVRPFDATA  IN COPYLIB.
       01  PO-ARG                        PIC X(14).
       COPY DBPOARG1 IN COPYLIB.

      *****************************************************************
      **                                                             **
      **  D A T A B A S E   B U F F E R S                            **
      **                                                             **
      *****************************************************************
       COPY DPOITEM  IN COPYLIB.

       COPY DPOITEMH IN COPYLIB.

       COPY DPORECD  IN COPYLIB.

       COPY DPORECDH IN COPYLIB.

       COPY DRCVITEM IN COPYLIB.

       COPY DRCVITMH IN COPYLIB.

       COPY MPLTINFO IN COPYLIB.

       PROCEDURE DIVISION.
       START-PGM.
           OPEN INPUT  DPOITEM.
           OPEN INPUT  DPOITMH.
           OPEN INPUT  DPORECD.
           OPEN INPUT  DPORECDH.
           OPEN INPUT  DRCVITEM.
           OPEN INPUT  DRCVITMH.
           OPEN INPUT  MPLTINFO.
           MOVE "P 01" TO PLTINFOKEY OF MPLTINFO-REC.
           READ MPLTINFO INTO BUF-MPLTINFO.
           MOVE MPLTINFO-COMPANY TO SAVE-COMPANY.
           MOVE "CCHM" TO PLTINFOKEY OF MPLTINFO-REC.
           READ MPLTINFO INTO BUF-MPLTINFO.
           IF FILE-STATUS NOT = "00"
               MOVE "01"               TO SAVE-HOME-CUR-CODE
           ELSE
           MOVE MPLTINFO-HOME-CUR-CODE TO SAVE-HOME-CUR-CODE.
           MOVE 0 TO LIVE-PO-CTR-COD
                     LIVE-PO-CTR-NON
                     LIVE-PO-CTR-RAW
                     LIVE-PO-DOLS-COD
                     LIVE-PO-DOLS-NON
                     LIVE-PO-DOLS-RAW
                     HIST-PO-CTR-COD
                     HIST-PO-CTR-NON
                     HIST-PO-CTR-RAW
                     HIST-PO-DOLS-COD
                     HIST-PO-DOLS-NON
                     HIST-PO-DOLS-RAW
                     TOTAL-ALL-PO-CTR
                     TOTAL-PO-CTR-COD
                     TOTAL-PO-CTR-NON
                     TOTAL-PO-CTR-RAW
                     TOTAL-PO-DOLS-COD
                     TOTAL-PO-DOLS-NON
                     TOTAL-PO-DOLS-RAW
                     UNIQUE-VENCDE-CTR.
           MOVE SPACES  TO HIST-PO-TABLE,
                           LIVE-PO-TABLE.
           MOVE "N"     TO FOUND-MATCH.
           MOVE "MCPRT" TO OVRPRTF-FILE.
           MOVE "L "    TO OVRPRTF-TOFILE-NUM-X.
           PERFORM 996-OVERRIDE-PRINT-FILE.
           OPEN OUTPUT PRINT-FILE.
           MOVE 61 TO LINE-CTR.
           PERFORM 6000-MAIN THRU 6990-MAIN-X.
           CLOSE DPOITEM.
           CLOSE DPOITMH.
           CLOSE DPORECD.
           CLOSE DPORECDH.
           CLOSE DRCVITEM.
           CLOSE DRCVITMH.
           CLOSE MPLTINFO.
           CLOSE PRINT-FILE.
           GOBACK.

       2100-BLOWUP.
           DISPLAY "FATAL ERROR, FILE-STATUS = ", FILE-STATUS.
           DISPLAY "COND-WORD = ", COND-WORD.
           GOBACK.

       6000-MAIN.
           PERFORM 9999-BEGFIL-DRCVITEM.
       6000-READ-LOOP.
           PERFORM 9999-GETSER-DRCVITEM.
           IF END-OF-FILE OR FILE-STATUS = "46"
               MOVE SPACES TO SAVE-VENCDE
               GO TO 6000-READ-LOOP-HISTORY-BEGFIL.
      *    IF RCV-DATE-RCVD-CN > "19990100" AND < "19991232"
           IF RCV-DATE-RCVD-CN > "20000100" AND < "20001232"
               NEXT SENTENCE
           ELSE
           GO TO 6000-READ-LOOP.
           IF RCV-PO-REL = "999" GO TO 6000-READ-LOOP.
           MOVE RCV-PO-NO            TO BUILD-PO-NO-L.
           MOVE RCV-PO-REL           TO BUILD-PO-REL-L.
           MOVE BUILD-PO-ARG-LIVE    TO PORCVNO OF DPORECD-REC.
           READ DPORECD INTO BUF-DPORECD
               INVALID KEY    MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00" GO TO 6000-READ-LOOP.
           MOVE BUILD-PO-ARG-LIVE    TO PORCVNO OF DPOITEM-REC.
           MOVE RCV-ITEM-NUMBER      TO ITEMNO  OF DPOITEM-REC.
           READ DPOITEM INTO BUF-DPOITEM
               INVALID KEY    MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00" GO TO 6000-READ-LOOP.
           MULTIPLY RCV-QTY-STORED BY ITM-UNIT-PRICE
               GIVING ITEM-DOLLARS ROUNDED.
           ADD 1 TO TOTAL-ALL-PO-CTR.
           IF TOTAL-ALL-PO-CTR = 1
               MOVE BUILD-PO-NO-LIVE TO LIVE-PO (1)
           ELSE
           MOVE "N" TO FOUND-MATCH
           PERFORM 60000-LOAD-LIVE-TABLE THRU 60000-LLT-X
               VARYING SUB1 FROM 1 BY 1
                   UNTIL SUB1 > 10000.
           MOVE ZEROES TO CC-EXCHANGE-RATE.
           IF SAVE-HOME-CUR-CODE = "01"
               IF PO-CURRENCY-CODE = "01"
                   PERFORM 6001-ADD-LIVE-TOTALS
               ELSE
               MOVE "CC"             TO CUR-KEY-LIT
               MOVE PO-CURRENCY-CODE TO CUR-KEY
               MOVE BUILD-CUR-KEY    TO PLTINFOKEY OF MPLTINFO-REC
               READ MPLTINFO INTO BUF-MPLTINFO
               IF FILE-STATUS NOT = "00"
                   MOVE ZEROES TO MPLTINFO-CC-EXCHANGE-RATE
               END-IF
               IF MPLTINFO-CC-EXCHANGE-RATE = ZEROS
                   PERFORM 6001-ADD-LIVE-TOTALS
               ELSE
               DIVIDE 1 BY MPLTINFO-CC-EXCHANGE-RATE
                   GIVING CC-EXCHANGE-RATE ROUNDED
               MULTIPLY CC-EXCHANGE-RATE BY ITEM-DOLLARS
               MOVE ITEM-DOLLARS     TO DISP-BGT-AMT
               PERFORM 6001-ADD-LIVE-TOTALS
           ELSE
           IF PO-CURRENCY-CODE = "01"
               PERFORM 6001-ADD-LIVE-TOTALS
           ELSE
           MOVE "CC01" TO PLTINFOKEY OF MPLTINFO-REC
           READ MPLTINFO INTO BUF-MPLTINFO
           IF FILE-STATUS NOT = "00"
               MOVE ZEROES       TO  MPLTINFO-CC-EXCHANGE-RATE
           END-IF
           IF MPLTINFO-CC-EXCHANGE-RATE = ZEROS
               PERFORM 6001-ADD-LIVE-TOTALS
           ELSE
           MOVE ITEM-DOLLARS  TO DISP-BGT-AMT
      *    DISPLAY "ITEM-DOLLARS BEFORE CONV = " DISP-BGT-AMT
           MULTIPLY MPLTINFO-CC-EXCHANGE-RATE BY ITEM-DOLLARS
           MOVE ITEM-DOLLARS  TO DISP-BGT-AMT
      *    DISPLAY "ITEM-DOLLARS AFTER  CONV = " DISP-BGT-AMT
           PERFORM 6001-ADD-LIVE-TOTALS.
           IF PO-VEN-CODE NOT EQUAL SAVE-VENCDE
               MOVE PO-VEN-CODE TO SAVE-VENCDE
               ADD 1 TO UNIQUE-VENCDE-CTR.
           GO TO 6000-READ-LOOP.

       6000-READ-LOOP-HISTORY-BEGFIL.
           PERFORM 9999-BEGFIL-DRCVITMH.
       6000-READ-LOOP-HISTORY.
           PERFORM 9999-GETSER-DRCVITMH.
           IF END-OF-FILE OR FILE-STATUS = "46"
               PERFORM 6999-HEADER
               MOVE SPACES TO PRINT-REC
               MOVE LIVE-PO-CTR-COD   TO DISP-LPO-CTR-COD
               MOVE LIVE-PO-CTR-NON   TO DISP-LPO-CTR-NON
               MOVE LIVE-PO-CTR-RAW   TO DISP-LPO-CTR-RAW
               MOVE LIVE-PO-DOLS-COD  TO DISP-LPO-DOLS-COD
               MOVE LIVE-PO-DOLS-NON  TO DISP-LPO-DOLS-NON
               MOVE LIVE-PO-DOLS-RAW  TO DISP-LPO-DOLS-RAW
               MOVE HIST-PO-CTR-COD   TO DISP-HPO-CTR-COD
               MOVE HIST-PO-CTR-NON   TO DISP-HPO-CTR-NON
               MOVE HIST-PO-CTR-RAW   TO DISP-HPO-CTR-RAW
               MOVE HIST-PO-DOLS-COD  TO DISP-HPO-DOLS-COD
               MOVE HIST-PO-DOLS-NON  TO DISP-HPO-DOLS-NON
               MOVE HIST-PO-DOLS-RAW  TO DISP-HPO-DOLS-RAW
               MOVE TOTAL-PO-CTR-COD  TO DISP-TPO-CTR-COD
               MOVE TOTAL-PO-CTR-NON  TO DISP-TPO-CTR-NON
               MOVE TOTAL-PO-CTR-RAW  TO DISP-TPO-CTR-RAW
               MOVE TOTAL-PO-DOLS-COD TO DISP-TPO-DOLS-COD
               MOVE TOTAL-PO-DOLS-NON TO DISP-TPO-DOLS-NON
               MOVE TOTAL-PO-DOLS-RAW TO DISP-TPO-DOLS-RAW
               MOVE UNIQUE-VENCDE-CTR TO DISP-UNIQVEN
               STRING "TYPE", " LIVEPO", "     LIVE PO $$$", "  HISTPO",
                   "     HIST PO $$$", " TOTALPO",
                   "    TOTAL PO $$$ "
               DELIMITED BY SIZE INTO PRINT-REC
               WRITE PRINT-REC
               STRING "COD ", DISP-LPO-CTR-COD, " ", DISP-LPO-DOLS-COD,
                   " ", DISP-HPO-CTR-COD, " ", DISP-HPO-DOLS-COD, " ",
                   DISP-TPO-CTR-COD, " ", DISP-TPO-DOLS-COD
                   DELIMITED BY SIZE INTO PRINT-REC
                   WRITE PRINT-REC
               STRING "NON ", DISP-LPO-CTR-NON, " ", DISP-LPO-DOLS-NON,
                   " ", DISP-HPO-CTR-NON, " ", DISP-HPO-DOLS-NON, " ",
                   DISP-TPO-CTR-NON, " ", DISP-TPO-DOLS-NON
                   DELIMITED BY SIZE INTO PRINT-REC
                   WRITE PRINT-REC
               STRING "RAW ", DISP-LPO-CTR-RAW, " ", DISP-LPO-DOLS-RAW,
                   " ", DISP-HPO-CTR-RAW, " ", DISP-HPO-DOLS-RAW " ",
                   DISP-TPO-CTR-RAW, " ", DISP-TPO-DOLS-RAW
                   DELIMITED BY SIZE INTO PRINT-REC
                   WRITE PRINT-REC
               MOVE SPACES TO PRINT-REC
               WRITE PRINT-REC
               MOVE SPACES TO PRINT-REC
               WRITE PRINT-REC
               STRING "                        TOTAL PO'S:",
                   TOTAL-ALL-PO-CTR
                   DELIMITED BY SIZE INTO PRINT-REC
                   WRITE PRINT-REC
               GO TO 6990-MAIN-X.
      *    IF RCVH-DATE-RCVD-CN > "19990100" AND < "19991232"
           IF RCVH-DATE-RCVD-CN > "20000100" AND < "20001232"
                   NEXT SENTENCE
           ELSE
           GO TO 6000-READ-LOOP-HISTORY.
           IF RCVH-PO-REL = "999" GO TO 6000-READ-LOOP-HISTORY.
           MOVE RCVH-PO-NO           TO BUILD-PO-NO-H.
           MOVE RCVH-PO-REL          TO BUILD-PO-REL-H.
           MOVE RCVH-PO-ID           TO BUILD-PO-DUP-IND.
           MOVE BUILD-PO-ARG-HIST    TO PORCVNO OF DPORECDH-REC.
           READ DPORECDH INTO BUF-DPORECD-H
               INVALID KEY    MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00" GO TO 6000-READ-LOOP-HISTORY.
           MOVE BUILD-PO-ARG-HIST    TO PORCVNO OF DPOITMH-REC.
           MOVE RCVH-ITEM-NUMBER     TO ITMNO   OF DPOITMH-REC.
           READ DPOITMH INTO BUF-DPOITEM-H
               INVALID KEY    MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00" GO TO 6000-READ-LOOP-HISTORY.
           MULTIPLY RCVH-QTY-STORED BY ITMH-UNIT-PRICE
               GIVING ITEM-DOLLARS ROUNDED.
           ADD 1 TO TOTAL-ALL-PO-CTR.
           IF TOTAL-ALL-PO-CTR = 1
               MOVE BUILD-PO-NO-HIST TO HIST-PO (1)
           ELSE
           MOVE "N" TO FOUND-MATCH
           PERFORM 60010-LOAD-HIST-TABLE THRU 60010-LHT-X
               VARYING SUB1 FROM 1 BY 1
                   UNTIL SUB1 > 10000.
           MOVE ZEROES TO CC-EXCHANGE-RATE.
           IF SAVE-HOME-CUR-CODE = "01"
               IF POH-CURRENCY-CODE = "01"
                   PERFORM 6001-ADD-HIST-TOTALS
               ELSE
               MOVE "CC"              TO CUR-KEY-LIT
               MOVE POH-CURRENCY-CODE TO CUR-KEY
               MOVE BUILD-CUR-KEY     TO PLTINFOKEY OF MPLTINFO-REC
               READ MPLTINFO INTO BUF-MPLTINFO
               IF FILE-STATUS NOT = "00"
                   MOVE ZEROES TO MPLTINFO-CC-EXCHANGE-RATE
               END-IF
               IF MPLTINFO-CC-EXCHANGE-RATE = ZEROS
                   PERFORM 6001-ADD-HIST-TOTALS
               ELSE
               DIVIDE 1 BY MPLTINFO-CC-EXCHANGE-RATE
                   GIVING CC-EXCHANGE-RATE ROUNDED
               MULTIPLY CC-EXCHANGE-RATE BY ITEM-DOLLARS
               MOVE ITEM-DOLLARS      TO DISP-BGT-AMT
               PERFORM 6001-ADD-HIST-TOTALS
           ELSE
           IF POH-CURRENCY-CODE = "01"
               PERFORM 6001-ADD-HIST-TOTALS
           ELSE
           MOVE "CC01" TO PLTINFOKEY OF MPLTINFO-REC
           READ MPLTINFO INTO BUF-MPLTINFO
           IF FILE-STATUS NOT = "00"
               MOVE ZEROES       TO  MPLTINFO-CC-EXCHANGE-RATE
           END-IF
           IF MPLTINFO-CC-EXCHANGE-RATE = ZEROS
               PERFORM 6001-ADD-HIST-TOTALS
           ELSE
           MOVE ITEM-DOLLARS   TO DISP-BGT-AMT
      *    DISPLAY "ITEM-DOLLARS  BEFORE CONV = " DISP-BGT-AMT
           MULTIPLY MPLTINFO-CC-EXCHANGE-RATE BY ITEM-DOLLARS
           MOVE ITEM-DOLLARS   TO DISP-BGT-AMT
      *    DISPLAY "ITEM-DOLLARS  AFTER  CONV = " DISP-BGT-AMT
           PERFORM 6001-ADD-HIST-TOTALS.
           IF POH-VEN-CODE NOT EQUAL SAVE-VENCDE
               MOVE POH-VEN-CODE TO SAVE-VENCDE
               ADD 1 TO UNIQUE-VENCDE-CTR.
           GO TO 6000-READ-LOOP-HISTORY.

       6990-MAIN-X.
           EXIT.

       6001-ADD-LIVE-TOTALS.
           IF RCV-CORP-CODE-1-2 = "26" OR "27" OR "28" OR "29"
               IF FOUND-MATCH = "Y"
                   ADD ITEM-DOLLARS TO LIVE-PO-DOLS-RAW
                                       TOTAL-PO-DOLS-RAW
               ELSE
               ADD 1                TO LIVE-PO-CTR-RAW
                                       TOTAL-PO-CTR-RAW
               ADD ITEM-DOLLARS     TO LIVE-PO-DOLS-RAW
                                       TOTAL-PO-DOLS-RAW
           ELSE
           IF RCV-CORP-CODE = "NON-STR "
               IF FOUND-MATCH = "Y"
                   ADD ITEM-DOLLARS TO LIVE-PO-DOLS-NON
                                       TOTAL-PO-DOLS-NON
               ELSE
               ADD 1                TO LIVE-PO-CTR-NON
                                       TOTAL-PO-CTR-NON
               ADD ITEM-DOLLARS     TO LIVE-PO-DOLS-NON
                                       TOTAL-PO-DOLS-NON
           ELSE
           IF FOUND-MATCH = "Y"
               ADD ITEM-DOLLARS     TO LIVE-PO-DOLS-COD
                                       TOTAL-PO-DOLS-COD
           ELSE
           ADD 1                    TO LIVE-PO-CTR-COD
                                       TOTAL-PO-CTR-COD
           ADD ITEM-DOLLARS         TO LIVE-PO-DOLS-COD
                                       TOTAL-PO-DOLS-COD.

       6001-ADD-HIST-TOTALS.
           IF RCVH-CORP-CODE-1-2 = "26" OR "27" OR "28" OR "29"
               IF FOUND-MATCH = "Y"
                   ADD ITEM-DOLLARS TO HIST-PO-DOLS-RAW
                                       TOTAL-PO-DOLS-RAW
               ELSE
               ADD 1                TO HIST-PO-CTR-RAW
                                       TOTAL-PO-CTR-RAW
               ADD ITEM-DOLLARS     TO HIST-PO-DOLS-RAW
                                       TOTAL-PO-DOLS-RAW
           ELSE
           IF RCVH-CORP-CODE = "NON-STR "
               IF FOUND-MATCH = "Y"
                   ADD ITEM-DOLLARS TO HIST-PO-DOLS-NON
                                       TOTAL-PO-DOLS-NON
               ELSE
               ADD 1                TO HIST-PO-CTR-NON
                                       TOTAL-PO-CTR-NON
               ADD ITEM-DOLLARS     TO HIST-PO-DOLS-NON
                                       TOTAL-PO-DOLS-NON
           ELSE
           IF FOUND-MATCH = "Y"
               ADD ITEM-DOLLARS     TO HIST-PO-DOLS-COD
                                       TOTAL-PO-DOLS-COD
           ELSE
           ADD 1                    TO HIST-PO-CTR-COD
                                       TOTAL-PO-CTR-COD
           ADD ITEM-DOLLARS         TO HIST-PO-DOLS-COD
                                       TOTAL-PO-DOLS-COD.

       60000-LOAD-LIVE-TABLE.
           IF BUILD-PO-NO-LIVE = LIVE-PO (SUB1)
               MOVE "Y"          TO FOUND-MATCH
               MOVE 10001        TO SUB1
               GO TO 60000-LLT-X
           ELSE
           IF LIVE-PO (SUB1) = SPACES
               MOVE BUILD-PO-NO-LIVE TO LIVE-PO (SUB1)
               MOVE 10001        TO SUB1.
       60000-LLT-X.    EXIT.

       60010-LOAD-HIST-TABLE.
           IF BUILD-PO-NO-HIST = HIST-PO (SUB1)
               MOVE "Y"          TO FOUND-MATCH
               MOVE 10001        TO SUB1
               GO TO 60010-LHT-X
           ELSE
           IF HIST-PO (SUB1) = SPACES
               MOVE BUILD-PO-NO-HIST TO HIST-PO (SUB1)
               MOVE 10001        TO SUB1.
       60010-LHT-X.    EXIT.

       6999-HEADER.
           MOVE SPACES TO  PRINT-REC.
           WRITE PRINT-REC AFTER ADVANCING NEW-PAGE.
           STRING "PURCHASE ORDER INFORMATION FOR DATES ",
             "20000101 THRU 20001231 FOR ", SAVE-COMPANY
             DELIMITED BY SIZE INTO PRINT-REC.
           WRITE PRINT-REC AFTER ADVANCING 1.
           MOVE ALL "-" TO PRINT-REC.
           WRITE PRINT-REC AFTER ADVANCING 1 LINES.
           MOVE 4 TO LINE-CTR.

       COPY OVRPFCALL IN COPYLIB.

       9999-BEGFIL-DRCVITEM.
           MOVE SPACES TO PORCVNO OF DRCVITEM-REC.
           START DRCVITEM KEY >= PORCVNO OF DRCVITEM-REC
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.

       9999-GETSER-DRCVITEM.
           MOVE 0 TO COND-WORD.
           READ DRCVITEM NEXT INTO BUF-DRCVITEM
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS-1 = "1"
               MOVE 11 TO COND-WORD
           ELSE
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "46"
                   NEXT SENTENCE
               ELSE
               MOVE 99 TO COND-WORD
               IF HANDLE-BLOWUP-FLAG = "Y"
                   MOVE "GETSER ERR 9999-GETSER-DRCVITEM"
                       TO BU-MSG-AREA
                   PERFORM 2100-BLOWUP.

       9999-BEGFIL-DRCVITMH.
           MOVE SPACES TO PORCVNO OF DRCVITMH-REC.
           START DRCVITMH KEY >= PORCVNO OF DRCVITMH-REC
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.

       9999-GETSER-DRCVITMH.
           MOVE 0 TO COND-WORD.
           READ DRCVITMH NEXT INTO BUF-DRCVITEM-H
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS-1 = "1"
               MOVE 11 TO COND-WORD
           ELSE
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "46"
                   NEXT SENTENCE
               ELSE
               MOVE 99 TO COND-WORD
               IF HANDLE-BLOWUP-FLAG = "Y"
                   MOVE "GETSER ERR 9999-GETSER-DRCVITMH"
                       TO BU-MSG-AREA
                   PERFORM 2100-BLOWUP.

