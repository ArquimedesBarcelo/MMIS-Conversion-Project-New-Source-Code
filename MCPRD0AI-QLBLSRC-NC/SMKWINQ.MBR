000200 IDENTIFICATION DIVISION.
000300 PROGRAM-ID.    SMKWINQ.
000400 AUTHOR.        BARBARA WINTER.
000500 DATE-WRITTEN.  JUNE 1988.
000600*INSTALLATION.  GOODYEAR TIRE AND RUBBER CO.
000700*
000800*REMARKS.
      *****************************************************************
      *  ADD AN ASSOCIATION BETWEEN VENDOR AND SHIPPING POINT LOCATION
      *****************************************************************

      *****************************************************************
      **          M O D I F I C A T I O N    H I S T O R Y
      *****************************************************************
      *C   5/02/96    JIM COFFMAN      REQUEST 96-021
      *C     ADDED THE ABILITY FOR THE USER TO 'X' MORE THAN
      *C     ONE VENDOR FROM A SCREEN REQUESTING A GENERIC
      *C     LIST OF VENDOR CODES.
      *C---------------------------------------------------------------
      *C MAR 10, 2005  D.RAUCH       DCR01    REQUEST# 2005-78515
      *C    DISPLAY FILE PROCESSING CHANGED FROM USING ZCSISINQ
      *C    NEW DISPLAY FILE ZSMKWINQ CREATED - FORMATS COPIED
      *C    FROM ZCSISINQ.
      *C---------------------------------------------------------------

001000 ENVIRONMENT DIVISION.
001100 CONFIGURATION SECTION.
001200 SOURCE-COMPUTER.    HP-3000.
001300 OBJECT-COMPUTER.    HP-3000.
       SPECIAL-NAMES.  I-O-FEEDBACK IS I-O-FEEDBACK-AREA.
001600 INPUT-OUTPUT SECTION.
001700 FILE-CONTROL.
001800
           SELECT DISPLAY-FILE
                  ASSIGN TO WORKSTATION-ZSMKWINQ-SI
                  ORGANIZATION IS TRANSACTION
                  ACCESS IS SEQUENTIAL
                  FILE STATUS IS DISPLAY-STATUS
                  CONTROL-AREA IS WS-CONTROL.

001900     SELECT MANUFACT-FILE  ASSIGN TO DATABASE-MCFLCS3501
002000                          ORGANIZATION IS INDEXED
002100                          ACCESS MODE IS DYNAMIC
002200                          RECORD KEY IS MANUFACT-NAME
002300                          STATUS IS MANUFACT-STAT.
002400
002500     SELECT KEYWORD-FILE  ASSIGN TO DATABASE-MCFLCS3301
002600                          ORGANIZATION IS INDEXED
002700                          ACCESS MODE IS DYNAMIC
002800                          RECORD KEY IS KEYWORD-RECORD
002900                          STATUS IS MANUFACT-STAT.
002910
003400     SELECT KVENDOR-FILE  ASSIGN TO DATABASE-MCFLCSVEND
003500       ORGANIZATION IS INDEXED
003600       ACCESS MODE IS DYNAMIC
003700       RECORD KEY IS EXTERNALLY-DESCRIBED-KEY WITH DUPLICATES
004000       STATUS IS MANUFACT-STAT.
003000 DATA DIVISION.
003100 FILE SECTION.
       FD  DISPLAY-FILE
           LABEL RECORDS ARE OMITTED.
       01  DISPLAY-REC        PIC X(2000).

003200 FD  MANUFACT-FILE.
003300 01  MANUFACT-RECORD.
003400     05  MANUFACT-NAME           PIC X(26).
003500
003600 FD  KEYWORD-FILE.
003700 01  KEYWORD-RECORD.
003800     05  KEYWORD-KEYWORD         PIC X(20).
003900     05  KEYWORD-MODIFIER        PIC X(30).
003910
004300 FD  KVENDOR-FILE.
004400 01  KVENDOR-RECORD.
004500     COPY DDS-MCRPCSVEND OF MCFLCSVEND.

004100 WORKING-STORAGE SECTION.
       01  VSUB                     PIC 9(2)  VALUE 0 COMP-4.
004200 01  X                        PIC 9(2)  VALUE 0 COMP-4.
004300 01  END-LIMIT                PIC S9(2) VALUE 0 COMP-4.
004400 01  FILE-NUM                   PIC S9(4) VALUE ZEROES COMP-4.
004500 01  MANUFCT-NAME             PIC X(9)  VALUE "MANUFCT  ".
004600 01  MANUFACT-STAT.
004700     05  MANUFACT-STAT1           PIC X     VALUE SPACE.
004800     05  MANUFACT-STAT2           PIC X     VALUE SPACE.
004900
005000 01  FOUND-REC                PIC 9     VALUE 0.
005100 01  END-OF-RECORDS           PIC 9     VALUE 0.
007600
      *------ WS CONTROL AREA
       01  MAJOR-MINOR                 PIC XXXX.
       01  WS-CONTROL.
           02  FUNCTION-NUM            PIC XX.
                   88  EXIT-KEY-F8-USED                     VALUE "08". LVW000LS
                   88  REFRESH-KEY-F4-USED                  VALUE "04". LVW000LS
                   88  ENTER-KEY-USED                       VALUE "00". LVW000LS
                   88  F1-KEY-USED                          VALUE "01". LVW000LS
                   88  F2-KEY-USED                          VALUE "02". LVW000LS
                   88  F3-KEY-USED                          VALUE "03". LVW000LS
                   88  F4-KEY-USED                          VALUE "04". LVW000LS
                   88  F5-KEY-USED                          VALUE "05". LVW000LS
                   88  F6-KEY-USED                          VALUE "06". LVW000LS
                   88  F7-KEY-USED                          VALUE "07". LVW000LS
                   88  F8-KEY-USED                          VALUE "08". LVW000LS
           02 FUN-KEY REDEFINES FUNCTION-NUM PIC XX.
           02 TERMINAL-ID PIC X(10).
           02 FORMAT-NAME PIC X(10).

       01  DISPLAY-STATUS              PIC X(2).

       01  SRF-INDICATORS.
           05  IND OCCURS 99 TIMES   PIC 1 INDICATOR 01.

       COPY IOFEEDBACK OF COPYLIB.
007700
005300 01  SAVE-VIEW-LASTKEY        PIC S9(4) COMP-4 VALUE 0.
       COPY FUNCTDEF IN COPYLIB.
005400
       COPY CATREAD IN COPYLIB.

005500*---------- VSETERROR AND VPUTWINDOW
005600 01  MESSAGE-BUFFER           PIC X(76)    VALUE SPACES.
005700 01  MESSAGE-BUFFER-RD REDEFINES MESSAGE-BUFFER.
005800     05  MSG-BUFFER           PIC X(68).
005900     05  MSG-VALUE            PIC X(8).
006000 01  MESSAGE-BUFLEN           PIC S9(4) VALUE 76  COMP-4.
006100 01  MESSAGE-ACTLEN           PIC S9(4) VALUE 0   COMP-4.
006200 01  FIELD-NUMBER             PIC S9(4) VALUE 1   COMP-4.
006300
006400*---------- VPRINTFORM
006500 01  SCREEN-PRINT-PARMS.
006600     05  PRINT-CTL            PIC S9(4)    VALUE 1 COMP-4.
006700     05  PAGE-CTL             PIC S9(4)    VALUE 49    COMP-4.
006800     05  SPOOL-FIL-OPEN-SW    PIC X        VALUE "Y".
006900 01  RETURN-STATUS            PIC X        VALUE SPACE.
007000
007200 01  RET-CODE                 PIC X(2)     VALUE "00".
007300*---------- TBLOWUP (PRINTS ERRORS TO AN ERROR FILE "BLOWUP.PUB" +)
007400*---------- (ABORTS PROGRAM.  RUN XBLPRT.OBJECT TO READ ERRORS.)
007500 01  BU-DISPLAY-MSG           PIC X(60)    VALUE SPACES.
007600 01  BU-PGM-NAME              PIC X(8)     VALUE "SMKWINQ".
007700 01  BU-DISPLAY-AREA          PIC X(110)   VALUE ALL "0".
007800 01  BU-DISPLAY-FLDS REDEFINES BU-DISPLAY-AREA.
007900     05  BU-DISPLAY-LINE OCCURS 5 TIMES.
008000         10  BU-DISPLAY-FLD   PIC X(14).
008100         10  BU-DISPLAY-FLD9  PIC S9(8).
008200 01  KSAM-STATUS-AREA         PIC X(2)     VALUE "00".
008500 01  TERMFILENAME               PIC X(11)  VALUE "TERM;".
008600
008700 01  SCREEN-BUFFER.
008800     05  SCREEN-AREA OCCURS 34 TIMES.
008900         10  SCR-X            PIC X.
009000         10  SCR-MANUF        PIC X(26).
           05  DE-COMMAND-LINE-1    PIC X(79).
           05  DE-MESSAGE-LINE-1    PIC X(79).
009100
009200 01  SCREEN2-BUFFER.
009300     05  SCREEN2-AREA OCCURS 17 TIMES.
009400         10  SCR2-X           PIC X.
009500         10  SCR2-KW          PIC X(20).
009600         10  SCR2-MOD         PIC X(30).
           05  DE-COMMAND-LINE-2    PIC X(79).
           05  DE-MESSAGE-LINE-2    PIC X(79).
009700
009710 01  SCREEN3-BUFFER.
009720     05  SCREEN3-AREA OCCURS 17 TIMES.
009730         10  SCR3-X           PIC X.
009731         10  SCR3-CODE        PIC X(10).
009740         10  SCR3-VENDOR      PIC X(44).
           05  DE-COMMAND-LINE-3    PIC X(79).
           05  DE-MESSAGE-LINE-3    PIC X(79).
009800
009900 01  STATUS-AREA.
010000     05  COND-WORD            PIC S9(4)    VALUE ZERO COMP-4.
010100         88  GOOD-CALL                            VALUE 0.
010200         88  END-OF-FILE                          VALUE 11.
010300         88  START-OF-CHAIN                       VALUE 14.
010400         88  END-OF-CHAIN                         VALUE 15.
010500         88  NO-ENTRY                             VALUE 17.
010600     05  DATA-LENGTH          PIC S9(4)              COMP-4.
010700     05  RCD-NO               PIC S9(9)              COMP-4.
010800     05  CHAIN-LENGTH         PIC S9(9)              COMP-4.
010900     05  BKWD-ADDR            PIC S9(9)              COMP-4.
011000     05  FWRD-ADDR            PIC S9(9)              COMP-4.
011100
011200
011300 01  MODE-AREA.
011400     05  MODE1                PIC S9(4)    VALUE 1   COMP-4.
011500     05  MODE3                PIC S9(4)    VALUE 3   COMP-4.
011600     05  MODE4                PIC S9(4)    VALUE 4   COMP-4.
011700     05  MODE5                PIC S9(4)    VALUE 5   COMP-4.
011800     05  MODE6                PIC S9(4)    VALUE 6   COMP-4.
011900     05  MODE7                PIC S9(4)    VALUE 7   COMP-4.
012100
012200 LINKAGE SECTION.
012300 COPY VCOMLINK  OF COPYLIB.
012400 COPY MKWINQ OF COPYLIB.
012500 01  BASE                     PIC X(10).
012600 COPY LANGSUB  OF COPYLIB.
       01  VENDOR-TABLE.
           05  VENDOR-C0DE-T OCCURS 16.
               10  VC-T             PIC X(10).
012700
012800*******************************************************************
012900*                     PROCEDURE DIVISION
013000*******************************************************************
013100 PROCEDURE DIVISION USING   VIEW-COMAREA,
013200                            MANUFACT-KEYWORD-INQUIRY
013300                            BASE
013400                            LANGUAGE-PARMS
                                  VENDOR-TABLE.
013500
013600 00-MAIN.
           MOVE 0 TO X, END-LIMIT, FOUND-REC, END-OF-RECORDS, VSUB.
           OPEN I-O DISPLAY-FILE.
013800     IF MKW-TYPE = "K"
013900        MOVE 18 TO END-LIMIT
014000        OPEN INPUT KEYWORD-FILE
014010     ELSE
014020     IF MKW-TYPE = "V"
014030        MOVE 18 TO END-LIMIT
014040        OPEN INPUT KVENDOR-FILE
014100     ELSE
014200        MOVE 35 TO END-LIMIT
014300        OPEN INPUT MANUFACT-FILE.
014400
014500     MOVE "N" TO MKW-RETURN-STATUS.
014600     MOVE SPACES TO MKW-MESSAGE-AREA,
014700                    MKW-RETURN-AREA.
014800     MOVE SPACES TO MESSAGE-BUFFER.
014900     PERFORM 100-SHOW-SCREEN THRU 199-EXIT.
015000
015100     IF MKW-TYPE = "K"
015200        CLOSE KEYWORD-FILE
015210     ELSE
015220     IF MKW-TYPE = "V"
015230        CLOSE KVENDOR-FILE
015300     ELSE
015400        CLOSE MANUFACT-FILE.
015500     MOVE MESSAGE-BUFFER TO MKW-MESSAGE-AREA.
           CLOSE DISPLAY-FILE.
015600 09-EXIT.
           GOBACK.
015700
015800*************************************************************
015900*       READ AND VALIDATE INPUT                             *
016000*************************************************************
016100 100-SHOW-SCREEN.
016200     PERFORM 810-GET-SCREEN.
016300     MOVE SPACES TO SCREEN-BUFFER, MESSAGE-BUFFER.
016400     MOVE SPACES TO SCREEN2-BUFFER, SCREEN3-BUFFER.
           MOVE SPACES TO VENDOR-TABLE.
016500     MOVE 0 TO END-OF-RECORDS.
016510     IF MKW-TYPE = "V"
016520        MOVE MKW-PASS-AREA TO KVENNAME
016530        START KVENDOR-FILE
016540              KEY IS GREATER OR EQUAL KVENNAME
016550              INVALID KEY PERFORM 820-CHECK-ERROR.
016600     IF MKW-TYPE = "M"
016700        MOVE MKW-PASS-MANUFCT TO MANUFACT-NAME
016800        START MANUFACT-FILE
016900              KEY IS GREATER OR EQUAL MANUFACT-NAME
017000              INVALID KEY PERFORM 820-CHECK-ERROR.
017100     IF MKW-TYPE = "K"
017200        MOVE MKW-PASS-AREA TO KEYWORD-RECORD
017300        START KEYWORD-FILE
017400              KEY IS GREATER OR EQUAL KEYWORD-RECORD
017500              INVALID KEY PERFORM 820-CHECK-ERROR.
017600     IF MESSAGE-BUFFER NOT = SPACES
017700        GO TO 199-EXIT.
017800
017900 110-FILL-SCREEN.
018000     MOVE 1 TO X.
018100     PERFORM 300-READ-AGAIN THRU 399-EXIT.
019600
019700 120-SHOW-FORM.
019800      MOVE SPACES TO MESSAGE-BUFFER.
            IF MKW-TYPE = "V"
                MOVE SCREEN3-BUFFER TO DISPLAY-REC
            ELSE
            IF MKW-TYPE = "M"
                MOVE SCREEN-BUFFER TO DISPLAY-REC
            ELSE
                MOVE SCREEN2-BUFFER TO DISPLAY-REC.
           WRITE DISPLAY-REC FORMAT IS VIEW-NFNAME
              INDIC ARE SRF-INDICATORS.
           MOVE ALL B"0" TO SRF-INDICATORS.

           READ  DISPLAY-FILE FORMAT IS VIEW-NFNAME
               INDIC ARE SRF-INDICATORS.
           ACCEPT IOFEEDBACK FROM I-O-FEEDBACK-AREA.
           MOVE ALL B"0" TO SRF-INDICATORS.

      *------ A BAD STATUS MAY MEAN USER TURNED OFF TERMINAL.
      *------ IF SO, SIMULATE THE F3 KEY TO EXIT PROGRAM.
           IF DISPLAY-STATUS NOT = "00"
               MOVE EXIT-PROGRAM TO VIEW-LASTKEY
           ELSE
               MOVE FUNCTION-NUM TO VIEW-LASTKEY.
034600
017300     IF VIEW-LASTKEY EQUAL HP-F3-KEY OR
017500        VIEW-LASTKEY EQUAL 4  OR
              VIEW-LASTKEY EQUAL 5  OR
017600        VIEW-LASTKEY EQUAL 6  OR
017700        VIEW-LASTKEY EQUAL 7
017800         MOVE   9 TO LANG-SETNUM
017900         MOVE  10 TO LANG-MSGNUM
018000         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
018100         PERFORM  940-VSETERROR THRU 949-EXIT
018200         GO TO  120-SHOW-FORM.
            IF MKW-TYPE = "V"
                MOVE DISPLAY-REC TO SCREEN3-BUFFER
            ELSE
            IF MKW-TYPE = "M"
                MOVE DISPLAY-REC TO SCREEN-BUFFER
            ELSE
                MOVE DISPLAY-REC TO SCREEN2-BUFFER.
020600
020700      IF VIEW-LASTKEY = EXIT-PROGRAM
020800        GO TO 199-EXIT.
020900
021000     IF VIEW-LASTKEY = 1
021100        GO TO 100-SHOW-SCREEN.
021200
021300*----------  MORE RECORDS
021400     IF VIEW-LASTKEY = 2
pdr   ****    PERFORM 800-READ
021600        IF END-OF-RECORDS = 1
021700*** NO MORE RECORDS TO REVIEW-CHOOSE ANOTHER FUNCTION
021800           MOVE 14 TO LANG-SETNUM
021900           MOVE 96 TO LANG-MSGNUM
022000           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
022100           PERFORM 940-VSETERROR THRU 949-EXIT
022200           GO TO 120-SHOW-FORM
022300        ELSE
022400           MOVE SPACES TO MESSAGE-BUFFER, SCREEN-BUFFER
022500                          SCREEN2-BUFFER, SCREEN3-BUFFER
022600           GO TO 110-FILL-SCREEN.
023800
023900     MOVE 1 TO X.
024000     MOVE "N" TO MKW-RETURN-STATUS.
024100     IF MKW-TYPE = "K"
024200        PERFORM 840-FIND-SELECTED-KW THRU 849-EXIT
024210     ELSE
024220     IF MKW-TYPE = "V"
024230        PERFORM 850-FIND-SELECTED-VENDOR THRU 859-EXIT
024300     ELSE
024400        PERFORM 830-FIND-SELECTED-MANUF THRU 839-EXIT.
024500 199-EXIT.  EXIT.
024600
024700 300-READ-AGAIN.
024800     PERFORM 800-READ.
024900     IF END-OF-RECORDS = 1

      *
      * MOVE SPACES TO ANY REMAINING LINES
      *
             PERFORM UNTIL X >= END-LIMIT

               EVALUATE MKW-TYPE
                 WHEN "M"

                   MOVE SPACES TO SCR-MANUF(X)

                 WHEN "V"

                   MOVE SPACES TO SCR3-VENDOR(X), SCR3-CODE(X)

                 WHEN OTHER

                   MOVE SPACES TO SCR2-KW(X), SCR2-MOD(X)

               END-EVALUATE
               ADD 1 TO X

             END-PERFORM
025000       GO TO 399-EXIT.
025100     IF MKW-TYPE = "M"
025200        MOVE MANUFACT-NAME TO SCR-MANUF (X)
025210     ELSE
025220     IF MKW-TYPE = "V"
025230        MOVE KVENNAME     TO SCR3-VENDOR (X)
025240        MOVE KVENCDE      TO SCR3-CODE (X)
025300     ELSE
025400        MOVE KEYWORD-KEYWORD TO SCR2-KW (X)
025500        MOVE KEYWORD-MODIFIER TO SCR2-MOD (X).
025600     ADD 1 TO X.
025700     IF X = END-LIMIT
025800        NEXT SENTENCE
025900     ELSE
026000        GO TO 300-READ-AGAIN.
026100 399-EXIT.  EXIT.
026200
026300 800-READ.
026400     IF MKW-TYPE = "M"
026500       READ MANUFACT-FILE NEXT RECORD
026600          AT END MOVE 1 TO END-OF-RECORDS.
026700     IF MKW-TYPE = "K"
026800       READ KEYWORD-FILE NEXT RECORD
026900          AT END MOVE 1 TO END-OF-RECORDS.
026910     IF MKW-TYPE = "V"
026920        READ KVENDOR-FILE NEXT RECORD
026930           AT END MOVE 1 TO END-OF-RECORDS.
027000
027100 810-GET-SCREEN.
027200     IF MKW-TYPE = "M"
027300         MOVE "FINQMANUF" TO VIEW-NFNAME
027310     ELSE
027320     IF MKW-TYPE = "V"
027330        MOVE "FINQVEN" TO VIEW-NFNAME
027400     ELSE
027500         MOVE "FINQKWM" TO VIEW-NFNAME.

028200*----------  CHECK KSAM ERROR ON FILE 'MANUFACT' OR 'KEYADJ'
028300 820-CHECK-ERROR.
028400     IF MANUFACT-STAT = "22"
028500*        "RECORD ALREADY EXISTS"
028600         MOVE  18 TO LANG-SETNUM
028700         MOVE  72 TO LANG-MSGNUM
028800         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
028900     ELSE
029000     IF MANUFACT-STAT = "23"
029100*        "*** RECORD DOES NOT EXIST - REENTER ***"
029200         MOVE  18 TO LANG-SETNUM
029300         MOVE  73 TO LANG-MSGNUM
029400         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
029500     ELSE
029600         MOVE "MANUFACT/KEYWORD KSAM ERR 820" TO BU-DISPLAY-MSG
029700         PERFORM 990-BLOWUP.
029800
029900 830-FIND-SELECTED-MANUF.
030000     IF SCR-X (X) NOT = SPACE
030100        IF SCR-MANUF (X) NOT = SPACES
030200           MOVE SCR-MANUF (X) TO MKW-RETURN-MANUFCT
030300            MOVE "S" TO MKW-RETURN-STATUS
030400           GO TO 839-EXIT.
030500
030600     ADD 1 TO X.
030700     IF X = 35
030800        NEXT SENTENCE
030900     ELSE
031000        GO TO 830-FIND-SELECTED-MANUF.
031100 839-EXIT.  EXIT.
031200
031300 840-FIND-SELECTED-KW.
031400     IF SCR2-X (X) NOT = SPACE
031500        IF SCR2-KW (X) NOT = SPACES
031600           MOVE SCR2-KW (X) TO MKW-RETURN-KEYWORD
031700           MOVE SCR2-MOD (X) TO MKW-RETURN-MODIFIER
031800           MOVE "S" TO MKW-RETURN-STATUS
031810           GO TO 849-EXIT.
031900
032000     ADD 1 TO X.
032100     IF X = END-LIMIT
032200        NEXT SENTENCE
032300     ELSE
032400        GO TO 840-FIND-SELECTED-KW.
032500 849-EXIT.  EXIT.
032510 850-FIND-SELECTED-VENDOR.
032511     IF SCR3-X (X) NOT = SPACE
              IF MKW-RETURN-STATUS = "S"
                  ADD 1 TO VSUB
                  MOVE SCR3-CODE (X) TO VC-T (VSUB)
              ELSE
032512        IF SCR3-CODE (X) NOT = SPACES
032513           MOVE SCR3-CODE (X) TO MKW-RETURN-AREA
032515           MOVE "S" TO MKW-RETURN-STATUS.
032517
032518     ADD 1 TO X.
032519     IF X = END-LIMIT
032520        NEXT SENTENCE
032521     ELSE
032522        GO TO 850-FIND-SELECTED-VENDOR.
032523 859-EXIT.  EXIT.
032600
034000 940-VSETERROR.
           MOVE B"1" TO IND (99).
           MOVE B"1" TO IND (FIELD-NUMBER).
           MOVE MESSAGE-BUFFER TO DE-MESSAGE-LINE-1.
           MOVE MESSAGE-BUFFER TO DE-MESSAGE-LINE-2.
           MOVE MESSAGE-BUFFER TO DE-MESSAGE-LINE-3.
051300
035300 949-EXIT.  EXIT.
035400******************************************************************
035500*                       B L O W U P                              *
035600*      CHECK FOR IMAGE, VIEW, OR SPOOL ERROR.  CLOSE             *
035700*      FILES, GET OUT OF BLOCK MODE, AND DISPLAY                 *
035800*      APPROPRIATE ERROR MESSAGE ON SCREEN.                      *
035900*                                                                *
036000*      ALSO APPENDS THE ERROR MESSAGE TO A FILE CALLED           *
036100*      BLOWUP.PUB.  TO READ THIS FILE, RUN "XBLPRT.OBJECT".      *
036200*                                                                *
036300*         |||   PROGRAM IS ABORTED IN TBLOWUP   |||              *
036400******************************************************************
036500 990-BLOWUP.
036600     MOVE VIEW-NFNAME     TO BU-DISPLAY-FLD (3).
036700     CALL "TBLOWUP" USING BASE, BU-PGM-NAME, STATUS-AREA,
036800                   VIEW-COMAREA, MANUFACT-STAT, BU-DISPLAY-MSG,
036900                   BU-DISPLAY-FLDS.
037000 999-EXIT.     EXIT.
037100
037200 999-CATREAD.
           IF CATREAD-MSG-NUMBER = ZEROS
               MOVE LANG-SETNUM TO CATREAD-MSG-SET
               MOVE LANG-MSGNUM TO CATREAD-MSG-NUM.
           CALL "CCATREAD" USING CATREAD-PARMS.
           MOVE CATREAD-MSG-TEXT TO MESSAGE-BUFFER.
038800 999-CATREAD-EXIT.
038900     EXIT.
