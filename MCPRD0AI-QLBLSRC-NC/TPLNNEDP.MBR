026200 PROCEDURE DIVISION USING LINK-DATA.
026500 BEGIN-PROG.
026700     PERFORM 1-HSK.
026800     PERFORM 6-SORT-PAR THRU 6-SORT-PAR-EXIT.
       2-EOJ.
100300     MOVE SPACES TO PRNTF.
100400     WRITE PRNTF AFTER ADVANCING NEW-PAGE.
           CLOSE JOBPLAN-FILE.
           CLOSE PERSONNEL-FILE.
           CLOSE PRNT-FILE.
           CLOSE WO-LABOR-FILE.
           CLOSE WO-LAST-NUM-USED.
           CLOSE WO-PARTS-FILE.
           CLOSE WO-PLANNED-FILE.
           GOBACK.
029300
029500 1-HSK.
           OPEN INPUT  JOBPLAN-FILE.
           OPEN INPUT  PERSONNEL-FILE.
029900     OPEN OUTPUT PRNT-FILE.
           OPEN INPUT  WO-LABOR-FILE.
           OPEN INPUT  WO-LAST-NUM-USED.
           OPEN INPUT  WO-PARTS-FILE.
           OPEN INPUT  WO-PLANNED-FILE.
031000     MOVE LOW-VALUES TO STATUS-AREA.
           MOVE 0 TO COND-WORD.
033300     MOVE 1 TO ARG-NO.
           READ WO-LAST-NUM-USED INTO LAST-WO-BUFF
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF WLNU-STATUS NOT = "00" MOVE 17 TO COND-WORD.
034800     IF PLANT-IDENT = "126" OR "129" OR "131" OR "133" OR "153"
034900                            OR "211"
035000         MOVE 15000 TO AMOUNT
035100     ELSE
035200     MOVE 10000 TO AMOUNT.
035300     MOVE 0 TO COND-WORD.
           READ PERSONNEL-FILE NEXT INTO PER-PERSONNEL
               AT END    MOVE 15 TO COND-WORD.
           IF PF-STATUS NOT = "00" MOVE 15 TO COND-WORD.
036800     MOVE DATE-FLAG-SW TO DATE-CODE.
036900     MOVE 1 TO DATE-MODE.
037000     CALL "TDATECK2" USING DATE-CHECK-AREA LANGUAGE-PARMS.
037100     MOVE DATE-SLASH-OUT TO T-DATE.
037200     MOVE PERCENT-B  TO T-P PERCENT-INPUT.
037300     MOVE CODE-B     TO CODE-R.
037400     MOVE EQPNUM-B   TO EQPNUM-R.
037500     MOVE DEPT-B     TO DEPT-R.
037600     MOVE ZONE-B     TO ZONE-R.
037700     MOVE EXPCLASS-B TO CLASS-R.
037800     IF BUDGET-B = "           "
037900         MOVE SPACES TO BUDGET-R
038000     ELSE
038100     MOVE BUDGET-B   TO BUDGET-R.
038200     MOVE REQUEST-B  TO REQUEST-R.
038300
038500 6-SORT-PAR.
038600     IF SORT-B = "C"
038700         MOVE "C" TO SORT-SWITCH
038800         SORT SORT-FILE ON ASCENDING KEY S-CLASS S-WONUM
038900             INPUT PROCEDURE  7-INPUT-RECORDS
039000             OUTPUT PROCEDURE 8-OUTPUT-RECORDS
039100             GO TO 6-SORT-PAR-EXIT.
039200     IF SORT-B = "B"
039300         MOVE "B" TO SORT-SWITCH
039400         SORT SORT-FILE ON ASCENDING KEY S-BUDGET S-WONUM
039500             INPUT PROCEDURE  7-INPUT-RECORDS
039600             OUTPUT PROCEDURE 8-OUTPUT-RECORDS
039700             GO TO 6-SORT-PAR-EXIT.
039800     IF SORT-B = "R"
039900         MOVE "R" TO SORT-SWITCH
040000         SORT SORT-FILE ON ASCENDING KEY S-REQUEST S-WONUM
040100             INPUT PROCEDURE  7-INPUT-RECORDS
040200             OUTPUT PROCEDURE 8-OUTPUT-RECORDS
040300             GO TO 6-SORT-PAR-EXIT.
040400     MOVE "Z" TO SORT-SWITCH.
040500     SORT SORT-FILE ON ASCENDING KEY S-ZONE S-WONUM
040600         INPUT PROCEDURE  7-INPUT-RECORDS
040700         OUTPUT PROCEDURE 8-OUTPUT-RECORDS.
040800 6-SORT-PAR-EXIT.    EXIT.
041000
041200 7-INPUT-RECORDS.
041300     PERFORM 70-INPUT-RECS THRU 70-IRE VARYING ST-INDEX
041400         FROM 1 BY 1 UNTIL ST (ST-INDEX) = SPACES.
041700
041900 70-INPUT-RECS.
042100     PERFORM 79-START-WO-PLANNED-FILE.
042500     IF COND-WORD = 17 GO TO 70-IRE.
           PERFORM 79-READ-WO-PLANNED-FILE.
044000     IF COND-WORD = 15 GO TO 70-IRE.
045300     PERFORM 701-READ-STATUS-CHAIN THRU 701-RSCE
               UNTIL COND-WORD = 15.
045400 70-IRE.    EXIT.
045600
045800 701-READ-STATUS-CHAIN.
045900     MOVE APPROVAL-CODE-P TO A-CODE.
046000     IF CODE-B = SPACES
046100         NEXT SENTENCE
046200     ELSE
046300     IF A-CODE = CODE-B
046400         NEXT SENTENCE
046500     ELSE
           PERFORM 79-READ-WO-PLANNED-FILE
046800     IF COND-WORD = 15 GO TO 701-RSCE.
048100     IF EQPNUM-B = SPACES
048200         NEXT SENTENCE
048300     ELSE
048400     IF EQUIP-NUM-P = EQPNUM-B
048500         NEXT SENTENCE
048600     ELSE
048700     PERFORM 79-READ-WO-PLANNED-FILE
048900     IF COND-WORD = 15 GO TO 701-RSCE.
050200     IF DEPT-B = SPACES
050300         NEXT SENTENCE
050400     ELSE
050500     IF DEPT-P = DEPT-B
050600         NEXT SENTENCE
050700     ELSE
050800     PERFORM 79-READ-WO-PLANNED-FILE
051000     IF COND-WORD = 15 GO TO 701-RSCE.
052300     IF ZONE-B = SPACES
052400         NEXT SENTENCE
052500     ELSE
052600     IF ZONE-P = ZONE-B
052700         NEXT SENTENCE
052800     ELSE
052900     PERFORM 79-READ-WO-PLANNED-FILE
053100     IF COND-WORD = 15 GO TO 701-RSCE.
054400     IF EXPCLASS-B = SPACES
054500       NEXT SENTENCE
054600     ELSE
054700     IF EXP-CLASS-P = EXPCLASS-B
054800       NEXT SENTENCE
054900     ELSE
055000     PERFORM 79-READ-WO-PLANNED-FILE
055200     IF COND-WORD = 15 GO TO 701-RSCE.
056500     IF BUDGET-B = "           "
056600       NEXT SENTENCE
056700     ELSE
056800     IF BUDGET-NO = BUDGET-B
056900         NEXT SENTENCE
057000     ELSE
057100     PERFORM 79-READ-WO-PLANNED-FILE
057300     IF COND-WORD = 15 GO TO 701-RSCE.
058600     IF REQUEST-B = SPACES
058700       NEXT SENTENCE
058800     ELSE
058900     IF REQUEST-NO = REQUEST-B
05900          NEXT SENTENCE
059100     ELSE
059200     PERFORM 79-READ-WO-PLANNED-FILE
059400     IF COND-WORD = 15 GO TO 701-RSCE.
060700     MOVE ZONE-P TO S-ZONE.
060800     MOVE WO-NUM-PLANNED TO S-WONUM.
060900     MOVE WO-STATUS-P TO S-STATUS.
061000     MOVE EQUIP-NUM-P TO S-EQPNUM.
061100     MOVE DESCRIPTION-1-P TO S-DESCRIPTION.
061200     MOVE EXP-CLASS-P TO S-CLASS.
061300     MOVE BUDGET-NO TO S-BUDGET.
061400     MOVE REQUEST-NO TO S-REQUEST.
061500     MOVE SPACE TO S-DEFAULT.
061600     MOVE 0 TO ESTIMATE-TOTAL.
061700
061900 701-RSGL.
062000     MOVE 0 TO LABOR-TOTAL.
062100     PERFORM 79-START-WO-LABOR-FILE.
062600     IF COND-WORD = 17 GO TO 701-RSGM.
063900     PERFORM 79-READ-WO-LABOR-FILE.
064100     IF COND-WORD = 15 GO TO 701-RSGM.
065400     PERFORM 7010-READ-LABOR-CHAIN THRU 7010-RLCE
               UNTIL COND-WORD = 15.
065500
065700 701-RSGM.
065800     MOVE 0 TO MATER-TOTAL PURCH-TOTAL.
065900     PERFORM 79-START-WO-PARTS-FILE.
066400     IF COND-WORD = 17 GO TO 701-RSJP.
067700     PERFORM 79-READ-WO-PARTS-FILE.
067900     IF COND-WORD = 15 GO TO 701-RSJP.
069200     PERFORM 7011-READ-MATER-CHAIN THRU 7011-RMCE
               UNTIL COND-WORD = 15.
069300
069500 701-RSJP.
070000     IF LAST-JOBPLAN-SEQ = "    " OR "000 " GO TO 701-RSCC.
069600     PERFORM 79-START-JOBPLAN-FILE.
           IF COND-WORD = 17 GO TO 701-RSCC.
070200     PERFORM 7012-READ-JOBPLAN-CHAINS THRU 7012-RJCE
070300         UNTIL COND-WORD = 15.
070500
070700 701-RSCC.
070800     MOVE LABOR-TOTAL TO S-LABOR-CST.
070900     MOVE MATER-TOTAL TO S-MATER-CST.
071000     MOVE PURCH-TOTAL TO S-PURCH-CST.
071100     COMPUTE WONUM-TOTAL = LABOR-TOTAL + MATER-TOTAL
071200                                       + PURCH-TOTAL.
071300     MOVE WONUM-TOTAL TO S-TOTAL-CST.
071400     IF ESTIMATE-TOTAL = 0
071500         MOVE AMOUNT TO ESTIMATE-TOTAL
071600         MOVE "D" TO S-DEFAULT.
071700     MOVE ESTIMATE-TOTAL TO S-ESTIMATE.
071800     COMPUTE S-PERCENT = WONUM-TOTAL / ESTIMATE-TOTAL * 100.
071900     IF S-PERCENT > INPUT-PERCENT OR S-PERCENT = INPUT-PERCENT
072000         RELEASE SORTF.
072200     PERFORM 79-READ-WO-PLANNED-FILE.
072400     IF COND-WORD = 15 GO TO 701-RSCE.
073800
073900 701-RSCE.    EXIT.
074100
074300 7010-READ-LABOR-CHAIN.
074400     IF LABOR-COST NUMERIC
074500         ADD LABOR-COST TO LABOR-TOTAL.
074600     PERFORM 79-READ-WO-LABOR-FILE.
074800     IF COND-WORD = 15 GO TO 7010-RLCE.
076100 7010-RLCE.    EXIT.
076300
076500 7011-READ-MATER-CHAIN.
076600     IF P-ACT-COST NUMERIC
076700         IF PRT-PO-NO = SPACES
076800             ADD P-ACT-COST TO MATER-TOTAL
076900         ELSE
077000         ADD P-ACT-COST TO PURCH-TOTAL.
077100     IF P-EST-COST NUMERIC
077200         ADD P-EST-COST TO ESTIMATE-TOTAL.
077300     PERFORM 79-READ-WO-PARTS-FILE.
077500     IF COND-WORD = 15 GO TO 7011-RMCE.
078800 7011-RMCE.    EXIT.
079000
079200 7012-READ-JOBPLAN-CHAINS.
081000     PERFORM 79-READ-JOBPLAN-FILE.
081200     IF COND-WORD = 15 GO TO 7012-RJCE.
082500     PERFORM 70120-COMPUTE-LABOR-EST THRU 70120-CLEE
               UNTIL COND-WORD = 15.
082600 7012-RJCE.    EXIT.
082800
083000 70120-COMPUTE-LABOR-EST.
083100     IF JOBPLAN-MEN NUMERIC AND JOBPLAN-EST-TIME NUMERIC
083200         COMPUTE LABOR-EST = PER-LABOR-RATE * JOBPLAN-MEN
083300                                            * JOBPLAN-EST-TIME
083400         ADD LABOR-EST TO ESTIMATE-TOTAL.
083500     PERFORM 79-READ-JOBPLAN-FILE.
083700     IF COND-WORD = 15 GO TO 70120-CLEE.
085000 70120-CLEE.    EXIT.
085200
       79-START-JOBPLAN-FILE.
           MOVE 0 TO COND-WORD.
           MOVE SPACES TO JOBPLAN-KEY.
069800     MOVE WO-NUM-PLANNED TO JOBWONUM.
           MOVE 0 TO SEQNUM.
           START JOBPLAN-FILE KEY IS > EXTERNALLY-DESCRIBED-KEY
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF JF-STATUS NOT = "00" MOVE 17 TO COND-WORD.

       79-READ-JOBPLAN-FILE.
           MOVE 0 TO COND-WORD.
           READ JOBPLAN-FILE NEXT INTO JOBPLAN-DATA
               AT END    MOVE 15 TO COND-WORD.
           IF JOBPLAN-WO-NO NOT = WONUM OF WPFREC
               MOVE 15 TO COND-WORD.
           IF JF-STATUS NOT = "00" MOVE 15 TO COND-WORD.

       79-START-WO-LABOR-FILE.
           MOVE 0 TO COND-WORD.
           MOVE WO-NUM-PLANNED TO WONUM OF WLFREC.
           START WO-LABOR-FILE KEY IS = EXTERNALLY-DESCRIBED-KEY
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF WLF-STATUS NOT = "00" MOVE 17 TO COND-WORD.

       79-READ-WO-LABOR-FILE.
           MOVE 0 TO COND-WORD.
           READ WO-LABOR-FILE NEXT INTO WO-LABOR-DATA
               AT END    MOVE 15 TO COND-WORD.
           IF WONUM OF WLFREC NOT = WO-NUM-PLANNED
               MOVE 15 TO COND-WORD.
           IF WLF-STATUS NOT = "00" MOVE 15 TO COND-WORD.

       79-START-WO-PARTS-FILE.
           MOVE 0 TO COND-WORD.
           MOVE WO-NUM-PLANNED TO WONUM OF WPFDREC.
           START WO-PARTS-FILE KEY IS = EXTERNALLY-DESCRIBED-KEY
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF WPFD-STATUS NOT = "00" MOVE 17 TO COND-WORD.

       79-READ-WO-PARTS-FILE.
           MOVE 0 TO COND-WORD.
           READ WO-PARTS-FILE NEXT INTO WO-MATER-DATA
               AT END    MOVE 15 TO COND-WORD.
           IF WONUM OF WPFDREC NOT = WO-NUM-PLANNED
               MOVE 15 TO COND-WORD.
           IF WPFD-STATUS NOT = "00" MOVE 15 TO COND-WORD.

       79-START-WO-PLANNED-FILE.
           MOVE 0 TO COND-WORD.
042200     MOVE ST (ST-INDEX) TO WOSTATUS OF WPFREC.
           START WO-PLANNED-FILE KEY IS = EXTERNALLY-DESCRIBED-KEY
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF WPF-STATUS NOT = "00" MOVE 17 TO COND-WORD.

       79-READ-WO-PLANNED-FILE.
           MOVE 0 TO COND-WORD.
           READ WO-PLANNED-FILE NEXT INTO WO-PLNND-DATA
               AT END    MOVE 15 TO COND-WORD.
           IF WOSTATUS OF WPFREC NOT = ST (ST-INDEX)
               MOVE 15 TO COND-WORD.
           IF WPF-STATUS NOT = "00" MOVE 15 TO COND-WORD.

085400 8-OUTPUT-RECORDS.
