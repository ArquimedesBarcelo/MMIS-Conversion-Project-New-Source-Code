       COPY CCRTFILE IN COPYLIB.

       01  RET-CODE                      PIC X(2)   VALUE "00".
      *---------- TBLOWUP (PRINTS ERRORS TO AN ERROR FILE "BLOWUP.PUB" +)
      *---------- (ABORTS PROGRAM.  RUN XBLPRT.OBJECT TO READ ERRORS.)
       01  BU-DISPLAY-MSG                PIC X(60)  VALUE SPACES.
       01  BU-PGM-NAME                   PIC X(8)   VALUE "SQTCREAT".
       01  BU-DISPLAY-AREA               PIC X(110) VALUE ALL "0".
       01  BU-DISPLAY-FLDS REDEFINES BU-DISPLAY-AREA.
           05  BU-DISPLAY-LINE OCCURS 5 TIMES.
               10  BU-DISPLAY-FLD        PIC X(14).
               10  BU-DISPLAY-FLD9       PIC S9(8).
       01  KSAM-STATUS-AREA              PIC X(2)   VALUE "00".

       01      MAIN-SCREEN               PIC X(10)  VALUE "CREATE_QUO".
       01      ITEM-SCREEN               PIC X(9)   VALUE "CREATEQU2".
       01      QUOTE-TEXT                PIC X(10)  VALUE "QUOTE_TEXT".
       01      NONCODED-SCREEN1          PIC X(10)  VALUE "QUOTE_NONC".
       01      NONCODED-SCREEN2          PIC X(9)   VALUE "QUOTENON2".

