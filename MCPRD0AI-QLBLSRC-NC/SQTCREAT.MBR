       COPY DREQITM   OF COPYLIB.
      **************************************************************
      *           L I N K A G E   S E C T I O N                    *
      **************************************************************
       LINKAGE SECTION.
       01  BASE                          PIC X(10).
       COPY VCOMLINK OF COPYLIB.
       01  FORMFILE                      PIC X(26).
       COPY LANGSUB  OF COPYLIB.
       01  PASS-SPOOL                    PIC S9(2)  COMP-4.
       01  PASS-QUOTE-PRT.
           05  PASS-QUOTE-PRT-01         PIC 9(2)   COMP-4.
           05  PASS-QUOTE-PRT-02         PIC 9(2)   COMP-4.
           05  PASS-QUOTE-PRT-LP         PIC 9(2)   COMP-4.

      *******************************************************************
      *                     PROCEDURE DIVISION                          *
      *******************************************************************
       PROCEDURE DIVISION USING    BASE,
                                   VIEW-COMAREA,
                                   FORMFILE,
                                   LANGUAGE-PARMS,
                                   PASS-SPOOL,
                                   PASS-QUOTE-PRT.

       6-MAIN.
           OPEN I-O DISPLAY-FILE MPLTINFO-O.
           OPEN INPUT DVENDOR-I MSTORERM-I MBUYER-I
                      DQUOTEXT-I DREQITM-I
DCR01                 MREQ-FILE.
      *******************************************************************
      *   PROCESS FIRST SCREEN WITH BUYER, VENDORS, CODED ITEMS         *
      *******************************************************************
       6-PROCESS.
           MOVE SPACES                   TO  AREA1.
           MOVE SPACES                   TO  VNC-QTY.
           PERFORM 63-VALIDATE-FIRST-SCREEN THRU 63-EXIT.
           IF VIEW-LASTKEY = 3
              GO TO 6-EXIT.
           IF VIEW-LASTKEY = 7
              GO TO 6-MAIN.

      *******************************************************************
      *  PROCESS MORE CODED ITEMS IF THE USER REQUESTED MORE            *
      *******************************************************************
           IF V-MORE = "X"
           PERFORM 64-VALIDATE-CORPCODES THRU 64-EXIT
           IF VIEW-LASTKEY = 3
              PERFORM 62-PURGE-FILE THRU 62-EXIT
              GO TO 6-PROCESS.

      *******************************************************************
      *  PROCESS NONCODED ITEMS IF THE USER REQUESTED ANY               *
      *******************************************************************
           IF V-MORE = "N"
              PERFORM 65-NONCODED-ITEMS THRU 65-EXIT.

      ********************************************************************
      *     DISPLAY QUOTE PARAGRAPH AND ALLOW CHANGES                    *
      ********************************************************************
           IF V-PARAGRAPH = "X"
              PERFORM 66-DISPLAY-TEXT THRU 66-EXIT
              IF VIEW-LASTKEY = 3
                 PERFORM 62-PURGE-FILE THRU 62-EXIT
                 GO TO 6-MAIN
              ELSE
                 NEXT SENTENCE
           ELSE
              PERFORM 68-USE-OLD-PARAGRAPH THRU 68-EXIT.

           CLOSE CODE-FILE.
           CLOSE NONCODE-FILE.

      *---------- IF FILE IS EMPTY, THEN PURGE IT.
           MOVE SPACES                   TO  STRM-OVR1.
           OPEN INPUT CODE-FILE.
           READ CODE-FILE
                AT END PERFORM 62-PURGE-FILE
                MOVE SPACES              TO  ACCEPT-CODED-FILE
                GO TO 6-CHECK-NONCODED.

           MOVE FILE-COMMAND-WORK        TO  STRM-OVR1.
           CLOSE CODE-FILE.

       6-CHECK-NONCODED.
           MOVE SPACES                   TO  STRM-OVR2.
           OPEN INPUT NONCODE-FILE.
           READ NONCODE-FILE
                AT END PERFORM 62-NONCODED THRU 62-EXIT
                MOVE SPACES              TO  ACCEPT-NONCODED-FILE
                GO TO 6-STREAM.

           MOVE FILE-COMMAND-WORK2       TO  STRM-OVR2.
           CLOSE NONCODE-FILE.
      *********************************************************************
      *  CREATE JOB STREAM AND KICK OFF THE JOB TO STORE THE NEW QUOTE    *
      *********************************************************************
       6-STREAM.
           PERFORM 67-STREAM-ADD-PROGRAM THRU 67-EXIT.

           GO TO 6-MAIN.

       6-EXIT.
           CLOSE    DISPLAY-FILE MPLTINFO-O.
           CLOSE      DVENDOR-I MSTORERM-I MBUYER-I
                      DQUOTEXT-I DREQITM-I
DCR01                 MREQ-FILE.
           GOBACK.

      *********************************************************************
      *  CREATE FILES TO HOLD CODED AND NONCODED ITEMS TO PASS LATER      *
      *********************************************************************
       61-GET-FILE-NAME.
           MOVE SPACES                   TO  INFO-LINE.
           PERFORM 610-GET-NEXT-QUOTE-NUMBER THRU 610-EXIT.
           MOVE MPLTINFO-FILE-NO         TO  BUILD-WS,
                                                    FILE-WS,
                                                    FILE-WS2,
                                                    FILE-WS3,
                                                    FILE-DQ1,
                                                    FILE-DN1
                                                    PURGE-WS2,
                                                    PURGE-WS.

           MOVE SPACES                   TO  CCRTFILE-PARMS.
           MOVE "DQ"                     TO  BUILD-FILE.
           MOVE BUILD-COMMAND-WORK       TO  CCRTFILE-FILE,
                                      ACCEPT-CODED-FILE.
           MOVE "0028"                   TO  CCRTFILE-RECORD-LENGTH.
           CALL "CCRTFILE" USING    CCRTFILE-LIBRARY
                                    CCRTFILE-FILE
                                    CCRTFILE-RECORD-LENGTH
                                    CCRTFILE-NO-RECORDS
                                    CCRTFILE-INCREMENT-AMT
                                    CCRTFILE-NO-INCREMENTS
                                    CCRTFILE-STATUS.
           IF CCRTFILE-STATUS NOT = "00"
              MOVE "CCRTFILE CREATE OF DQ FAILED" TO BU-DISPLAY-MSG
              MOVE "BUILD-COMMAND-WORK"  TO  BU-DISPLAY-FLD (1)
              PERFORM 990-BLOWUP THRU 990-EXIT.

           MOVE 38                       TO  CMD-LENGTH.
           CALL "QCMDEXC" USING FILE-COMMAND-WORK, CMD-LENGTH.

           MOVE SPACES                   TO  CCRTFILE-PARMS.
           MOVE "DN"                     TO  BUILD-FILE.
           MOVE BUILD-COMMAND-WORK       TO  CCRTFILE-FILE,
                                       ACCEPT-NONCODED-FILE.
           MOVE "0080"                   TO  CCRTFILE-RECORD-LENGTH.
           CALL "CCRTFILE" USING    CCRTFILE-LIBRARY
                                    CCRTFILE-FILE
                                    CCRTFILE-RECORD-LENGTH
                                    CCRTFILE-NO-RECORDS
                                    CCRTFILE-INCREMENT-AMT
                                    CCRTFILE-NO-INCREMENTS
                                    CCRTFILE-STATUS.
           IF CCRTFILE-STATUS NOT = "00"
              MOVE "CCRTFILE CREATE OF DN FAILED" TO BU-DISPLAY-MSG
              MOVE "BUILD-COMMAND-WORK"  TO  BU-DISPLAY-FLD (1)
              PERFORM 990-BLOWUP THRU 990-EXIT.

           MOVE 38                       TO  CMD-LENGTH.
           CALL "QCMDEXC" USING FILE-COMMAND-WORK2, CMD-LENGTH.

           MOVE SPACES                   TO  CCRTFILE-PARMS.
           MOVE "DJ"                     TO  BUILD-FILE.
           MOVE BUILD-COMMAND-WORK       TO  CCRTFILE-FILE,
                                       ACCEPT-JOB-FILE.
           MOVE "0720"                   TO  CCRTFILE-RECORD-LENGTH.
           CALL "CCRTFILE" USING    CCRTFILE-LIBRARY
                                    CCRTFILE-FILE
                                    CCRTFILE-RECORD-LENGTH
                                    CCRTFILE-NO-RECORDS
                                    CCRTFILE-INCREMENT-AMT
                                    CCRTFILE-NO-INCREMENTS
                                    CCRTFILE-STATUS.
           IF CCRTFILE-STATUS NOT = "00"
              MOVE "CCRTFILE CREATE OF DJ FAILED" TO BU-DISPLAY-MSG
              MOVE "BUILD-COMMAND-WORK"  TO  BU-DISPLAY-FLD (1)
              PERFORM 990-BLOWUP THRU 990-EXIT.

           MOVE 38                       TO  CMD-LENGTH.
           CALL "QCMDEXC" USING FILE-COMMAND-WORK3, CMD-LENGTH.

           OPEN OUTPUT NONCODE-FILE.
           OPEN OUTPUT CODE-FILE.
           OPEN OUTPUT STREAM-FILE.

      *----------  FILL IN VENDOR/QUOTE PAIRS TO PASS TO PROGRAM
      *            THAT UPDATES THE DATABASE
           MOVE MPLTINFO-FILE-NO         TO  ACCEPT-QUOTE (1).
           MOVE V-VENDOR (1)             TO  VENDOR (1).
           MOVE 2                        TO  X, Y.

       61-GET-VENDOR-QUOTE.
           IF V-VENDOR (X) NOT = SPACES
              PERFORM 610-GET-NEXT-QUOTE-NUMBER THRU 610-EXIT
              MOVE MPLTINFO-FILE-NO      TO  ACCEPT-QUOTE (Y)
              MOVE V-VENDOR (X)          TO  VENDOR (Y)
              ADD 1                      TO  X, Y
            ELSE
              ADD 1                      TO  X.

           IF X < 11
              GO TO 61-GET-VENDOR-QUOTE.
       61-EXIT.  EXIT.

      ******************************************************************
      *  PURGE THE CODED AND/OR NONCODED FILES IF THERE WERE NONE      *
      ******************************************************************
       62-PURGE-FILE.
              CLOSE CODE-FILE.
           MOVE 19                       TO  CMD-LENGTH.
           CALL "QCMDEXC" USING PURGE-COMMAND-WORK, CMD-LENGTH.

       62-NONCODED.
           CLOSE NONCODE-FILE.
           MOVE 19                       TO  CMD-LENGTH.
           CALL "QCMDEXC" USING PURGE-COMMAND-WORK2 CMD-LENGTH.
       62-EXIT.  EXIT.


      ****************************************************************
      *     VALIDATE BUYER, VENDOR, RETURN DATE, CORPORATE CODES     *
      ****************************************************************
       63-VALIDATE-FIRST-SCREEN.
           MOVE SPACES                   TO  CODE-ARG, SCREEN-BUFFER.
           MOVE "1"                      TO  V-PRINTER.
           MOVE ALL B"1"                 TO  IND(1).
       63-ALLSHOW-FORM.
           MOVE MAIN-SCREEN              TO  VIEW-NFNAME.
       63-SHOW-FORM.
           MOVE SCREEN-BUFFER            TO  DISPLAY-REC.
           WRITE DISPLAY-REC FORMAT IS VIEW-NFNAME
              INDIC ARE SRF-INDICATORS.
           MOVE ALL B"0"                 TO  SRF-INDICATORS.

           READ  DISPLAY-FILE FORMAT IS VIEW-NFNAME
               INDIC ARE SRF-INDICATORS.
           ACCEPT IOFEEDBACK FROM I-O-FEEDBACK-AREA.
           MOVE ALL B"0"                 TO  SRF-INDICATORS.
           MOVE DISPLAY-REC              TO  SCREEN-BUFFER.

      *------ A BAD STATUS MAY MEAN USER TURNED OFF TERMINAL.
      *------ IF SO, SIMULATE THE F3 KEY TO EXIT PROGRAM.
           IF DISPLAY-STATUS NOT = "00"
               MOVE 3                    TO  VIEW-LASTKEY
           ELSE
               MOVE FUNCTION-NUM         TO  VIEW-LASTKEY.
           IF VIEW-LASTKEY EQUAL 4 OR
              VIEW-LASTKEY EQUAL 5
              PERFORM 940-VSETERROR THRU 940-EXIT
              GO TO 63-SHOW-FORM.

      *----------  F3 OR F7 - EXIT PARAGRAPH
            IF VIEW-LASTKEY = 3 OR 7
              GO TO 63-EXIT.

      *----------  F1=HELP SCREEN
           IF VIEW-LASTKEY = 1
              MOVE "ZUDCQUOT"            TO  VIEW-CFNAME
              MOVE "HQTCRT"              TO  HELP-FORMNAME
              CALL "SHELPSCR" USING VIEW-COMAREA LANGUAGE-PARMS
                                    HELP-FORMNAME
              GO TO 63-ALLSHOW-FORM.

      *----------  F6=VENDOR HELP SCREEN
           IF VIEW-LASTKEY = 6
              MOVE SPACES TO VENCODE-HELP
              CALL "SVENHELP" USING BASE, VIEW-COMAREA
                              PASS-SPOOL, LANGUAGE-PARMS,
                              VENCODE-HELP
              IF VENCODE-HELP > SPACES
                 MOVE 1 TO X
                 PERFORM 960-PLACE-VENCODE THRU 960-EXIT
              END-IF
              GO TO 63-ALLSHOW-FORM.

      *----------  F2  TAB TO CODES
            IF VIEW-LASTKEY = 2
               MOVE 7                    TO  FIELD-NUMBER
               MOVE SPACES               TO  MESSAGE-BUFFER
               PERFORM 950-VSETERROR THRU 950-EXIT
               GO TO 63-SHOW-FORM.

      *----------  F8  TAB TO 'X' FIELD
           IF VIEW-LASTKEY = 8
              MOVE 38                    TO  FIELD-NUMBER
              MOVE SPACES                TO  MESSAGE-BUFFER
              PERFORM 950-VSETERROR THRU 950-EXIT
              GO TO 63-SHOW-FORM.

           MOVE V-BUYER                  TO  BUYER-ARG.

      *----------  VALIDATE BUYER CODE
           MOVE 0                        TO  COND-WORD.
           MOVE BUYER-ARG                TO  BUYERCDE OF MBUYER-REC-I.
           READ MBUYER-I INTO BUF-MBUYER
               INVALID KEY MOVE 17       TO  COND-WORD.
           IF FILE-STATUS-1 = "2"
               MOVE 17                   TO  COND-WORD
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE 99                   TO  COND-WORD.
           IF NO-ENTRY
      *** BUYER CODE DOES NOT EXIST
              MOVE 04                    TO  LANG-MSGNUM
              MOVE 02                    TO  LANG-SETNUM
              PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
              PERFORM 940-VSETERROR THRU 940-EXIT
              GO TO 63-SHOW-FORM.

DCR01 ***========================================================
DCR01      IF V-BUYER = 'ARBA'
DCR01 *** BUYER CODE CAN NOT BE ARIBA
DCR01         MOVE 02                    TO  LANG-SETNUM
DCR01         MOVE 10                    TO  LANG-MSGNUM
DCR01         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
DCR01         PERFORM 940-VSETERROR THRU 940-EXIT
DCR01         GO TO 63-SHOW-FORM.
DCR01 ***========================================================

           MOVE 1                        TO  DATE-MODE.
           CALL "TDATECK2" USING DATE-CHECK-AREA, LANGUAGE-PARMS.
           MOVE DATE-YMD-OUT             TO  TODAY-DATE.

      *----------  VALIDATE DATE FOR VENDOR TO RETURN
           MOVE V-RETURN-DATE            TO  DATE-VALIDATE-IN.
           MOVE 3                        TO  DATE-MODE.
           CALL "TDATECK2" USING DATE-CHECK-AREA, LANGUAGE-PARMS.
           IF DATE-RET-CODE NOT = ZERO
              MOVE DATE-MSG              TO  MESSAGE-BUFFER
              MOVE 32                    TO  FIELD-NUMBER
              PERFORM 940-VSETERROR THRU 940-EXIT
              GO TO 63-SHOW-FORM.

      *-----  FORMAT BOTH DATES WITH CENTURY TO HANDLE YEAR 2000

           MOVE DATE-YMD-OUT             TO  RETURN-DATE.

           IF RETURN-DATE NUMERIC
              IF RETURN-YEAR > "70"
                 MOVE "19" TO RETURN-CENT
              ELSE
                 MOVE "20" TO RETURN-CENT
              END-IF
           END-IF.
           IF TODAY-YEAR > "70"
              MOVE "19" TO TODAY-CENT
           ELSE
              MOVE "20" TO TODAY-CENT.

           IF CY-TODAY-DATE  > CY-RETURN-DATE
      *-------DATE MUST BE A FUTURE DATE
              MOVE 15                    TO  LANG-MSGNUM
              MOVE 04                    TO  LANG-SETNUM
              PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
              MOVE 32                    TO  FIELD-NUMBER
              PERFORM 940-VSETERROR THRU 940-EXIT
              GO TO 63-SHOW-FORM.

           MOVE CY-RETURN-DATE           TO  ACCEPT-RETURN-DATE.

      *----------  VALIDATE VENDORS
           MOVE 1                        TO  X.

       63-VALIDATE-PRINTER.
           IF V-PRINTER = SPACES
      *--------- YOU MUST SELECT A PRINTER OPTION
            MOVE 25                 TO  LANG-SETNUM
            MOVE 31                 TO  LANG-MSGNUM
            PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
            MOVE 28                    TO  FIELD-NUMBER
            PERFORM 940-VSETERROR THRU 940-EXIT
            GO TO 63-SHOW-FORM
           ELSE
           IF (V-PRINTER = "1")
             IF (PASS-QUOTE-PRT-01 NOT > 00)
      *--------- PRINTER #1 HAS NOT BEEN DEFINED
               MOVE 16                 TO  LANG-SETNUM
               MOVE 168                TO  LANG-MSGNUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE 28                    TO  FIELD-NUMBER
               PERFORM 940-VSETERROR THRU 940-EXIT
               GO TO 63-SHOW-FORM
             ELSE
               MOVE PASS-QUOTE-PRT-01 TO QUOTE-PRINTER
           ELSE
           IF (V-PRINTER = "2")
             IF (PASS-QUOTE-PRT-02 NOT > 00)
      *--------- PRINTER #2 HAS NOT BEEN DEFINED
               MOVE 16                 TO  LANG-SETNUM
               MOVE 169                TO  LANG-MSGNUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE 28                    TO  FIELD-NUMBER
               PERFORM 940-VSETERROR THRU 940-EXIT
               GO TO 63-SHOW-FORM
             ELSE
               MOVE PASS-QUOTE-PRT-02 TO QUOTE-PRINTER
           ELSE
           IF (V-PRINTER = "3")
             IF (PASS-QUOTE-PRT-LP NOT > 00)
      *--------- NO LINE PRINTER HAS BEEN DEFINED
               MOVE 14                 TO  LANG-SETNUM
               MOVE 124                TO  LANG-MSGNUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE 28                    TO  FIELD-NUMBER
               PERFORM 940-VSETERROR THRU 940-EXIT
               GO TO 63-SHOW-FORM
             ELSE
               MOVE PASS-QUOTE-PRT-LP TO QUOTE-PRINTER
           ELSE
      *--------- INVALID SELECTION, ENTER 1, 2, OR 3
               MOVE 09                 TO  LANG-SETNUM
               MOVE 110                TO  LANG-MSGNUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE 28                    TO  FIELD-NUMBER
               PERFORM 940-VSETERROR THRU 940-EXIT
               GO TO 63-SHOW-FORM.


       63-VALIDATE-VENDORS.

      *-----  AT LEAST ONE VENDOR MUST BE ENTERED

           IF V-VENDOR-AREA = SPACES
      ***       AT LEAST ONE VENDOR CODE MUST BE ENTERED
              MOVE  1                    TO LANG-MSGNUM
              MOVE  1                    TO LANG-SETNUM
              MOVE  2                    TO FIELD-NUMBER
              PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
              PERFORM 940-VSETERROR THRU 940-EXIT
              GO TO 63-SHOW-FORM.

           IF V-VENDOR (X)  = SPACES OR "*"
              NEXT SENTENCE
           ELSE
              MOVE V-VENDOR (X)          TO  VENDOR-ARG
      *-----  CALL ALT KEY SUB-PGM TO GET ALT KEY IF ONE EXISTS
              MOVE VENDOR-ARG TO ALT-KEY-ARG
              CALL "TALTVENK" USING RET-CODE-TALTVENK,
                                    BASE-TALTVENK,
                                    STATUS-AREA,
                                    ALT-KEY-ARG,
                                    ALT-VEND-CODE
              IF RET-CODE-TALTVENK NOT EQUAL "00"
                 MOVE "TALTVENK ERROR 63-VV" TO BU-DISPLAY-MSG
                 PERFORM 990-BLOWUP THRU 990-EXIT
              END-IF
              MOVE ALT-VEND-CODE   TO VENDOR-ARG V-VENDOR (X)
              PERFORM 632-VALIDATE-VENDOR THRU 632-EXIT
              IF NO-ENTRY
                 COMPUTE FIELD-NUMBER = 1 + X
      *--------- THIS VENDOR CODE DOES NOT EXIST
                 MOVE 22                 TO  LANG-SETNUM
                 MOVE 03                 TO  LANG-MSGNUM
                 PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                 PERFORM 940-VSETERROR THRU 940-EXIT
                 GO TO 63-SHOW-FORM.
           IF X < 10
              ADD 1                      TO  X
              GO TO 63-VALIDATE-VENDORS.

      *----------  CHECK IF ANY ITEMS WERE ENTERED
           IF V-CORP-CODE-AREA  = SPACES
              IF V-MORE = "N"
                 PERFORM 61-GET-FILE-NAME THRU 61-EXIT
                 GO TO 63-EXIT
              ELSE
      *------    "C103: CODE IS A REQUIRED FIELD"
                 MOVE 3                  TO  LANG-SETNUM
                 MOVE 103                TO  LANG-MSGNUM
                 PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                 MOVE 7                  TO  FIELD-NUMBER
                 PERFORM 940-VSETERROR THRU 940-EXIT
                 GO TO 63-SHOW-FORM.

      *----------  VALIDATE CORPORATE CODES AND REQS
           MOVE 1                        TO  X.

       63-VALIDATE-CODES.
           MOVE 0                        TO  LANG-SETNUM
           PERFORM 630-VALIDATE-CODES THRU 630-EXIT.
           IF LANG-SETNUM NOT = 0
              GO TO 63-SHOW-FORM.
           IF X < 21
              ADD 1                      TO  X
              GO TO 63-VALIDATE-CODES.

           PERFORM 61-GET-FILE-NAME THRU 61-EXIT.
           MOVE 1                        TO  X.
           PERFORM 631-WRITE-CODES.

       63-EXIT.     EXIT.

      ***************************************************************
      *  VALIDATE CONTINUOUS SCREENS OF CORPORATE CODES             *
      ***************************************************************
       64-VALIDATE-CORPCODES.
           MOVE ITEM-SCREEN              TO  VIEW-NFNAME.

       64-MORE-LOOP.
           MOVE SPACES                   TO  MESSAGE-BUFFER,
                                           V-MORE, V-CORP-CODE-AREA.

       64-SHOW-FORM.
           MOVE SCREEN-BUFFER            TO  DISPLAY-REC.
           WRITE DISPLAY-REC FORMAT IS VIEW-NFNAME
              INDIC ARE SRF-INDICATORS.
           MOVE ALL B"0"                 TO  SRF-INDICATORS.

           READ  DISPLAY-FILE FORMAT IS VIEW-NFNAME
               INDIC ARE SRF-INDICATORS.
           ACCEPT IOFEEDBACK FROM I-O-FEEDBACK-AREA.
           MOVE ALL B"0"                 TO  SRF-INDICATORS.
           MOVE DISPLAY-REC              TO  SCREEN-BUFFER.

      *------ A BAD STATUS MAY MEAN USER TURNED OFF TERMINAL.
      *------ IF SO, SIMULATE THE F3 KEY TO EXIT PROGRAM.
           IF DISPLAY-STATUS NOT = "00"
               MOVE 3                    TO  VIEW-LASTKEY
           ELSE
               MOVE FUNCTION-NUM         TO  VIEW-LASTKEY.
           IF VIEW-LASTKEY EQUAL 5 OR
              VIEW-LASTKEY EQUAL 1 OR
              VIEW-LASTKEY EQUAL 4 OR
              VIEW-LASTKEY EQUAL 2 OR
              VIEW-LASTKEY EQUAL 6
              PERFORM 940-VSETERROR THRU 940-EXIT
              GO TO 64-SHOW-FORM.

            IF VIEW-LASTKEY = 3 OR 7
              GO TO 64-EXIT.

      *----------  TAB TO 'X','N'
           IF VIEW-LASTKEY = 8
              MOVE 38                    TO  FIELD-NUMBER
              MOVE SPACES                TO  MESSAGE-BUFFER
              PERFORM 940-VSETERROR THRU 940-EXIT
              GO TO 64-SHOW-FORM.

      *----------  VALIDATE CODES ONLY
           MOVE 1                        TO  X.
       64-VALIDATE-CODE-LOOP.
           MOVE 0                        TO  LANG-SETNUM.
           PERFORM 630-VALIDATE-CODES THRU 630-EXIT.
           IF LANG-SETNUM NOT = 0
              GO TO 64-SHOW-FORM.
           IF X < 21
              ADD 1                      TO  X
              GO TO 64-VALIDATE-CODE-LOOP.

           MOVE 1                        TO  X.
           PERFORM 631-WRITE-CODES.

           IF V-MORE = "X"
              GO TO  64-MORE-LOOP.

       64-EXIT.  EXIT.

      ************************************************************
      *    PROCESS NONCODED QTY, UM, AND DESCRIPTION LINES       *
      ************************************************************
       65-NONCODED-ITEMS.
           MOVE NONCODED-SCREEN1         TO  VIEW-NFNAME.
       65-MORE-LOOP.
           MOVE SPACES                   TO  MESSAGE-BUFFER,
                                   NONCODED-SCREEN.
           MOVE "00000000"               TO  VNC-QTY.

           MOVE NONCODED-SCREEN          TO  DISPLAY-REC.
           WRITE DISPLAY-REC FORMAT IS VIEW-NFNAME
              INDIC ARE SRF-INDICATORS.
           MOVE ALL B"0"                 TO  SRF-INDICATORS.

           READ  DISPLAY-FILE FORMAT IS VIEW-NFNAME
               INDIC ARE SRF-INDICATORS.
           ACCEPT IOFEEDBACK FROM I-O-FEEDBACK-AREA.
           MOVE ALL B"0"                 TO  SRF-INDICATORS.
           MOVE DISPLAY-REC              TO  NONCODED-SCREEN.

      *------ A BAD STATUS MAY MEAN USER TURNED OFF TERMINAL.
      *------ IF SO, SIMULATE THE F3 KEY TO EXIT PROGRAM.
           IF DISPLAY-STATUS NOT = "00"
               MOVE 3                    TO  VIEW-LASTKEY
           ELSE
               MOVE FUNCTION-NUM         TO  VIEW-LASTKEY.
           IF VIEW-LASTKEY EQUAL 5 OR
              VIEW-LASTKEY EQUAL 1 OR
              VIEW-LASTKEY EQUAL 4 OR
              VIEW-LASTKEY EQUAL 2 OR
              VIEW-LASTKEY EQUAL 8 OR
              VIEW-LASTKEY EQUAL 6
              PERFORM 940-VSETERROR THRU 940-EXIT
              GO TO 64-SHOW-FORM.
            IF VIEW-LASTKEY = 7
              GO TO 65-EXIT.

      *----------  CHECK IF ANY NONCODED ITEMS WERE REALLY ENTERED
           IF VIEW-LASTKEY = 3
                 GO TO 65-EXIT.

           MOVE SPACES                   TO  WORK-NONCODED-LINE.
           MOVE "QUOTE     "             TO  WORK-QUOTE.
           MOVE VNC-QTY                  TO  WORK-QTY.
           MOVE VNC-UM                   TO  WORK-UM.
           WRITE NONCODED-REC FROM WORK-NONCODED-LINE.
           MOVE 1                        TO  X.

       65-WRITE-DESC-1.
           IF X > 10
              NEXT SENTENCE
           ELSE
              IF VNC-DESC(X) = SPACES
                 ADD 1                   TO  X
                 GO TO 65-WRITE-DESC-1
              ELSE
                 WRITE NONCODED-REC FROM VNC-DESC(X)
                 ADD 1                   TO  X
                 GO TO 65-WRITE-DESC-1.

           IF VNC-MORE = "X"
              GO TO 65-MORE-DESCRIPTION.

           GO TO 65-MORE-LOOP.
       65-MORE-DESCRIPTION.
           MOVE NONCODED-SCREEN2         TO  VIEW-NFNAME.
           MOVE SPACES                   TO  MESSAGE-BUFFER,
           VNC-DESC (1), VNC-DESC (2), VNC-DESC (3), VNC-DESC (4)
           VNC-DESC (5), VNC-DESC (6), VNC-DESC (7), VNC-DESC (8)
           VNC-DESC (9), VNC-DESC (10), VNC-MORE.
      *    MOVE "00000000" TO VNC-QTY.

       65-SHOW-FORM.
           MOVE NONCODED-SCREEN          TO  DISPLAY-REC.
           WRITE DISPLAY-REC FORMAT IS VIEW-NFNAME
              INDIC ARE SRF-INDICATORS.
           MOVE ALL B"0"                 TO  SRF-INDICATORS.

           READ  DISPLAY-FILE FORMAT IS VIEW-NFNAME
               INDIC ARE SRF-INDICATORS.
           ACCEPT IOFEEDBACK FROM I-O-FEEDBACK-AREA.
           MOVE ALL B"0"                 TO  SRF-INDICATORS.
           MOVE DISPLAY-REC              TO  NONCODED-SCREEN.

      *------ A BAD STATUS MAY MEAN USER TURNED OFF TERMINAL.
      *------ IF SO, SIMULATE THE F3 KEY TO EXIT PROGRAM.
           IF DISPLAY-STATUS NOT = "00"
               MOVE 3                    TO  VIEW-LASTKEY
           ELSE
               MOVE FUNCTION-NUM         TO  VIEW-LASTKEY.
           IF VIEW-LASTKEY EQUAL 5 OR
              VIEW-LASTKEY EQUAL 1 OR
              VIEW-LASTKEY EQUAL 4 OR
              VIEW-LASTKEY EQUAL 2 OR
              VIEW-LASTKEY EQUAL 6 OR
              VIEW-LASTKEY EQUAL 8
              PERFORM 940-VSETERROR THRU 940-EXIT
              GO TO 65-SHOW-FORM.
            IF VIEW-LASTKEY = 7  OR VIEW-LASTKEY = 3
              GO TO 65-EXIT.
           MOVE 1                        TO  X.

       65-WRITE-DESC-2.
           IF X > 10
              NEXT SENTENCE
           ELSE
              IF VNC-DESC(X) = SPACES
                 ADD 1                   TO  X
                 GO TO 65-WRITE-DESC-2
              ELSE
                 WRITE NONCODED-REC FROM VNC-DESC(X)
                 ADD 1                   TO  X
                 GO TO 65-WRITE-DESC-2

           IF VNC-MORE = "X"
              GO TO 65-MORE-DESCRIPTION.

           MOVE NONCODED-SCREEN1         TO  VIEW-NFNAME.
           GO TO 65-MORE-LOOP.
       65-EXIT.  EXIT.

      ************************************************************
      *  DISPLAY STANDARD QUOTE PARAGRAPH AND ALLOW CHANGES      *
      ************************************************************
       66-DISPLAY-TEXT.
           MOVE QUOTE-TEXT               TO  VIEW-NFNAME.
           MOVE SPACES            TO STANDARD-MSG-AREA, NEW-MSG-AREA
           MOVE 1                        TO  X.
           MOVE "STAND"                  TO  QT-STD-ARG.
           MOVE 0                        TO  COND-WORD.
           MOVE QT-STD-ARG TO QUOTENUM   OF DQUOTEXT-REC-I.
           START DQUOTEXT-I KEY = QUOTENUM OF DQUOTEXT-REC-I
               INVALID KEY MOVE 17       TO  COND-WORD.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
                   MOVE 17               TO  COND-WORD
               ELSE
                   MOVE 99               TO  COND-WORD.
           IF NOT GOOD-CALL
              MOVE "NO STANDARD QUOTE PARAGRAPH EXISTS|"
                                         TO  STANDARD-AREA (X)
              GO TO 66-SHOW-TEXT.
       66-GET-TEXT.
           MOVE 0                        TO  COND-WORD.
           READ DQUOTEXT-I NEXT INTO BUF-DQUOTEXT
               AT END MOVE 15            TO  COND-WORD.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   MOVE 15               TO  COND-WORD
               ELSE
                   MOVE 99               TO  COND-WORD.
           IF QUOTENUM OF DQUOTEXT-REC-I NOT = QT-STD-ARG
               MOVE 15                   TO  COND-WORD.
           IF END-OF-CHAIN
              GO TO 66-SHOW-TEXT.
           IF NOT GOOD-CALL
              MOVE "DBGET DQUOTEXT 66- SQTCREAT" TO BU-DISPLAY-MSG
              PERFORM 990-BLOWUP THRU 990-EXIT.
           IF DQUOTEXT-ITM-NO = "0000"
              MOVE DQUOTEXT-DATA         TO  STANDARD-AREA (X)
              ADD 1                      TO  X.
           GO TO 66-GET-TEXT.
       66-SHOW-TEXT.
           MOVE SCREEN-TEXT              TO  DISPLAY-REC.
           WRITE DISPLAY-REC FORMAT IS VIEW-NFNAME
              INDIC ARE SRF-INDICATORS.
           MOVE ALL B"0"                 TO  SRF-INDICATORS.

           READ  DISPLAY-FILE FORMAT IS VIEW-NFNAME
               INDIC ARE SRF-INDICATORS.
           ACCEPT IOFEEDBACK FROM I-O-FEEDBACK-AREA.
           MOVE ALL B"0"                 TO  SRF-INDICATORS.
           MOVE DISPLAY-REC              TO  SCREEN-TEXT.

      *------ A BAD STATUS MAY MEAN USER TURNED OFF TERMINAL.
      *------ IF SO, SIMULATE THE F3 KEY TO EXIT PROGRAM.
           IF DISPLAY-STATUS NOT = "00"
               MOVE 3                    TO  VIEW-LASTKEY
           ELSE
               MOVE FUNCTION-NUM         TO  VIEW-LASTKEY.
           IF VIEW-LASTKEY EQUAL 5 OR
              VIEW-LASTKEY EQUAL 1 OR
              VIEW-LASTKEY EQUAL 4 OR
              VIEW-LASTKEY EQUAL 2 OR
              VIEW-LASTKEY EQUAL 6 OR
              VIEW-LASTKEY EQUAL 8
              PERFORM 940-VSETERROR THRU 940-EXIT
              GO TO 66-SHOW-TEXT.
           IF VIEW-LASTKEY = 3
               GO TO  66-EXIT.

       66-EXIT.  EXIT.

       67-STREAM-ADD-PROGRAM.
      *************************************************************
      *      STREAM THE JOB THAT WILL PRINT THE QUOTE.  THIS      *
      *      ALLOWS THE PROGRAM TO RETURN IMMEDIATELY TO THE      *
      *      USER WHO IS WAITING TO DO SOMETHING ELSE WITH THE    *
      *      VIEW SCREEN.                                         *
      *************************************************************
      *    MOVE  14                             TO LANG-SETNUM
      *    MOVE   2                             TO LANG-MSGNUM
      *    PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
      *    PERFORM 940-VSETERROR THRU 940-EXIT.
      *
      *----------  CREATE REST OF STREAM FILE
           MOVE "TQTSTORE"               TO  STRM-RUN-CARD.
      *    MOVE 9   TO STRM-OPTION-CARD2-CTR.

      *--------  PASS THE OPTIONS
           MOVE FILE-COMMAND-WORK3       TO  OVR-STREAM-FILE.
           MOVE V-BUYER                  TO  ACCEPT-BUYER.
           IF NEW-MSG-AREA = SPACES
              MOVE "S"                   TO  PARAGRAPH-TYPE
           ELSE
              MOVE " "                   TO  PARAGRAPH-TYPE.
           MOVE QUOTE-PRINTER            TO  ACCEPT-PRINTER.
           MOVE SPACES TO AREA2 AREA3 AREA4 AREA5 AREA6 AREA7.
           MOVE INFO-LINE                TO  AREA2.
      *----------  PASS TEXT FOR QUOTE SHEET
           IF NEW-MSG-AREA = SPACES
              MOVE STANDARD-AREA (1)     TO  AREA3
              MOVE STANDARD-AREA (2)     TO  AREA4
              MOVE STANDARD-AREA (3)     TO  AREA5
              MOVE STANDARD-AREA (4)     TO  AREA6
              MOVE STANDARD-AREA (5)     TO  AREA7
           ELSE
              MOVE NEW-MSG (1)           TO  AREA3
              MOVE NEW-MSG (2)           TO  AREA4
              MOVE NEW-MSG (3)           TO  AREA5
              MOVE NEW-MSG (4)           TO  AREA6
              MOVE NEW-MSG (5)           TO  AREA7.

           WRITE STREAM-REC.
           CLOSE STREAM-FILE.
           CALL "TSTRMJOB" USING STRMRPT-COMAREA.
           IF STRM-RET-CODE NOT = "00"
              MOVE STRM-RET-CODE         TO  BU-DISPLAY-FLD9 (1)
              MOVE "STREAM COMMAND FAILED SQTCREAT" TO BU-DISPLAY-MSG
              PERFORM 990-BLOWUP THRU 990-EXIT.

      *    CALL "TQTSTORE" USING AREA1, PARM2.
       67-EXIT.  EXIT.

       68-USE-OLD-PARAGRAPH.
           MOVE SPACES            TO STANDARD-MSG-AREA, NEW-MSG-AREA
           MOVE 1                        TO  X.
           MOVE "STAND"                  TO  QT-STD-ARG.
           MOVE 0                        TO  COND-WORD.
           MOVE QT-STD-ARG TO QUOTENUM OF DQUOTEXT-REC-I.
           START DQUOTEXT-I KEY = QUOTENUM OF DQUOTEXT-REC-I
               INVALID KEY MOVE 17       TO  COND-WORD.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
                   MOVE 17               TO  COND-WORD
               ELSE
                   MOVE 99               TO  COND-WORD.
           IF NOT GOOD-CALL
              MOVE "NO STANDARD QUOTE PARAGRAPH EXISTS|"
                                         TO  STANDARD-AREA (X)
              GO TO 68-EXIT.
       68-GET-TEXT.
           MOVE 0                        TO  COND-WORD.
           READ DQUOTEXT-I NEXT INTO BUF-DQUOTEXT
               AT END MOVE 15            TO  COND-WORD.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   MOVE 15               TO  COND-WORD
               ELSE
                   MOVE 99               TO  COND-WORD.
           IF QUOTENUM OF DQUOTEXT-REC-I NOT = QT-STD-ARG
               MOVE 15                   TO  COND-WORD.
           IF END-OF-CHAIN
              GO TO 68-EXIT.
           IF NOT GOOD-CALL
              MOVE "DBGET DQUOTEXT 68- SQTCREAT" TO BU-DISPLAY-MSG
              PERFORM 990-BLOWUP THRU 990-EXIT.
           IF DQUOTEXT-ITM-NO = "0000"
              MOVE DQUOTEXT-DATA         TO  STANDARD-AREA (X)
              ADD 1                      TO  X.
           GO TO 68-GET-TEXT.
       68-EXIT.  EXIT.

       610-GET-NEXT-QUOTE-NUMBER.
           MOVE "PQNO"                   TO  MPLTINFO-ARG.
           MOVE 0                        TO  COND-WORD.
           MOVE MPLTINFO-ARG TO PLTINFOKEY  OF MPLTINFO-REC-O.
           READ MPLTINFO-O INTO BUF-MPLTINFO
               INVALID KEY MOVE 17       TO  COND-WORD.
           IF FILE-STATUS-1 = "2"
               MOVE 17                   TO  COND-WORD
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE 99                   TO  COND-WORD.
           IF NOT GOOD-CALL
              MOVE "PQNO KEY NOT IN MPLTINFO!!!!! " TO BU-DISPLAY-MSG
              PERFORM 990-BLOWUP THRU 990-EXIT.

           ADD 1                         TO  MPLTINFO-FILE-NO.
           MOVE 0                        TO  COND-WORD.
           REWRITE MPLTINFO-REC-O FROM BUF-MPLTINFO
               INVALID KEY MOVE 99       TO  COND-WORD.
           IF FILE-STATUS NOT = "00"
               MOVE 99                   TO  COND-WORD.
           IF NOT GOOD-CALL
              MOVE "DBUPDATE MPLTINFO SQTCREAT 610" TO BU-DISPLAY-MSG
              PERFORM 990-BLOWUP THRU 990-EXIT.
      *------- DO A START > HIGH-VALUES TO UNLOCK
           MOVE HIGH-VALUES TO PLTINFOKEY OF MPLTINFO-REC-O.
           START MPLTINFO-O KEY > PLTINFOKEY OF MPLTINFO-REC-O
               INVALID KEY MOVE "00"     TO  FILE-STATUS.

       610-EXIT.  EXIT.

      **********************************************************************
      *         VALIDATE CORPORATE CODE BY CHECKING IF IT EXISTS           *
      **********************************************************************
       630-VALIDATE-CODES.
           IF V-CORPCODE (X) NOT = SPACES
              MOVE V-CORPCODE (X)        TO  CODE-ARG
              PERFORM 630-VALIDATE-MSTORERM
              IF NO-ENTRY
      *** CODE DOES NOT EXIST
                 MOVE 23                 TO  LANG-MSGNUM
                 MOVE  3                 TO  LANG-SETNUM
                 IF X = 6
                    MOVE 27              TO  FIELD-NUMBER
                    PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                    PERFORM 940-VSETERROR THRU 940-EXIT
                 ELSE
                    IF X < 6
                       COMPUTE FIELD-NUMBER = 6 + X
                       PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                       PERFORM 940-VSETERROR THRU 940-EXIT
                    ELSE
                        COMPUTE FIELD-NUMBER = 5 + X
                        PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                        PERFORM 940-VSETERROR THRU 940-EXIT
               ELSE
                 IF NOT GOOD-CALL
                    MOVE "DBGET MSTORERM SQTCREAT 630" TO BU-DISPLAY-MSG
                    PERFORM 990-BLOWUP THRU 990-EXIT.

           IF V-REQ (X) = SPACES
              GO TO 630-EXIT.

DCR01 **============================================================
DCR01      INITIALIZE  BUF-MREQ.
DCR01      MOVE V-REQ (X)                TO  MREQ-NUMBER OF BUF-MREQ.
DCR01
DCR01      READ  MREQ-FILE
DCR01      END-READ.
DCR01
DCR01      IF  FILE-STATUS = "00"
DCR01      AND REQ-HOLD-STATUS-CODE = "AR"
DCR01 *----------  REQUISITION BELONGS TO ARIBA BUYER
DCR01         COMPUTE FIELD-NUMBER = X + 38
DCR01         MOVE 18                    TO  LANG-SETNUM
DCR01         MOVE 61                    TO  LANG-MSGNUM
DCR01         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
DCR01         PERFORM 940-VSETERROR THRU 940-EXIT
DCR01         GO TO 630-EXIT
DCR01      END-IF.
DCR01 **============================================================

           MOVE V-REQ (X)                TO  REQ-ARG.
           MOVE 0                        TO  COND-WORD.
           MOVE REQ-ARG                  TO  REQNO OF DREQITM-REC-I.
           START DREQITM-I KEY = REQNO OF DREQITM-REC-I
               INVALID KEY MOVE 17       TO  COND-WORD.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
                   MOVE 17               TO  COND-WORD
               ELSE
                   MOVE 99               TO  COND-WORD.
           IF NO-ENTRY
              COMPUTE FIELD-NUMBER = X + 38
      *----------  REQUISITION NUMBER DOES NOT EXIST
              MOVE 18                    TO  LANG-SETNUM
              MOVE 05                    TO  LANG-MSGNUM
              PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
              PERFORM 940-VSETERROR THRU 940-EXIT
              GO TO 630-EXIT
           ELSE
              IF NOT GOOD-CALL
                 MOVE "DBFIND DREQITM SQTCREAT" TO BU-DISPLAY-MSG
                 PERFORM 990-BLOWUP THRU 990-EXIT.

           MOVE 0                        TO  COND-WORD.
           READ DREQITM-I NEXT INTO BUF-DREQITM
               AT END MOVE 15            TO  COND-WORD.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   MOVE 15               TO  COND-WORD
               ELSE
                   MOVE 99               TO  COND-WORD.
           IF REQNO OF DREQITM-REC-I NOT = REQ-ARG
               MOVE 15                   TO  COND-WORD.
           IF NOT GOOD-CALL
              MOVE "DBGET DREQITM IN SQTCREAT" TO BU-DISPLAY-MSG
              PERFORM 990-BLOWUP THRU 990-EXIT.

           IF V-CORPCODE (X) NOT = SPACES
              IF REQITM-CORP-CODE NOT = V-CORPCODE (X)
      *----------  CORPORATE XXX HAS BEEN ASSIGNED REQ XXX
                 MOVE 03                 TO  LANG-SETNUM
                 MOVE 18                 TO  LANG-MSGNUM
                 COMPUTE FIELD-NUMBER = X + 38
                 PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                 MOVE MESSAGE-BUFFER     TO  REQ-ERROR-BUF
                 MOVE REQITM-CORP-CODE   TO  REQ-BUF1
                 MOVE REQ-ARG            TO  REQ-BUF2
                  MOVE REQ-ERROR-BUF     TO  MESSAGE-BUFFER
                 PERFORM 940-VSETERROR THRU 940-EXIT
                 GO TO 630-EXIT.

           MOVE REQITM-CORP-CODE         TO  V-CORPCODE (X).
           GO TO 630-EXIT.

       630-VALIDATE-MSTORERM.
           MOVE 0                        TO  COND-WORD.
           MOVE CODE-ARG                 TO  CORPCDE OF MSTORERM-REC-I.
           START MSTORERM-I KEY = CORPCDE OF MSTORERM-REC-I
               INVALID KEY MOVE 17       TO  COND-WORD.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
                   MOVE 17               TO  COND-WORD
               ELSE
                   MOVE 99               TO  COND-WORD.
       630-EXIT.  EXIT.
      *******************************************************************
      *   WRITE CODED ITEMS TO THE FILE THAT WILL BE PASSED LATER       *
      *******************************************************************
       631-WRITE-CODES.
      *    MOVE SPACES TO CODE-REC.
           IF V-REQ (X) NOT = SPACES
              PERFORM 6300-GET-REQ THRU 6300-EXIT
           ELSE
              MOVE SPACES                TO  REQITM-UM
              MOVE ZEROES                TO  REQITM-QTY-TO-ORD.

           IF V-CORPCODE (X) = "NON-STR"
              MOVE SPACES                TO  WORK-NONCODED-LINE
              MOVE V-REQ (X)             TO  WORK-REQ
              MOVE "QUOTE     "          TO  WORK-QUOTE
              MOVE REQITM-UM             TO  WORK-UM
              MOVE REQITM-QTY-TO-ORD     TO  WORK-QTY
              WRITE NONCODED-REC FROM WORK-NONCODED-LINE
           ELSE
            IF V-CORPCODE (X) NOT = SPACES
              MOVE V-CORPCODE (X)        TO  CODE-NUMBER
              MOVE V-REQ (X)             TO  CODE-REQ
              MOVE REQITM-QTY-TO-ORD     TO  CODE-REQ-ORD
              WRITE CODE-REC.
           ADD 1                         TO  X.
           IF X < 22
              GO TO 631-WRITE-CODES.

       850-COMPUTE-FIELD.
           IF X = 6
              MOVE 27                    TO  FIELD-NUMBER
           ELSE
              IF X < 6
                 COMPUTE FIELD-NUMBER = X + 6
              ELSE
                 COMPUTE FIELD-NUMBER = X + 7.
       859-EXIT.  EXIT.

       6300-GET-REQ.
           MOVE V-REQ (X)                TO  REQ-ARG.
           MOVE 0                        TO  COND-WORD.
           MOVE REQ-ARG                  TO  REQNO OF DREQITM-REC-I.
           START DREQITM-I KEY = REQNO OF DREQITM-REC-I
               INVALID KEY MOVE 17       TO  COND-WORD.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
                   MOVE 17               TO  COND-WORD
               ELSE
                   MOVE 99               TO  COND-WORD.
           IF NOT GOOD-CALL
              MOVE "DBFIND 6300 DREQITM SQTCREAT" TO BU-DISPLAY-MSG
              PERFORM 990-BLOWUP THRU 990-EXIT.

           MOVE 0                        TO  COND-WORD.
           READ DREQITM-I NEXT INTO BUF-DREQITM
               AT END MOVE 15            TO  COND-WORD.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   MOVE 15               TO  COND-WORD
               ELSE
                   MOVE 99               TO  COND-WORD.
           IF REQNO OF DREQITM-REC-I NOT = REQ-ARG
               MOVE 15                   TO  COND-WORD.
           IF NOT GOOD-CALL
              MOVE "DBGET DREQITM 6300 SQTCREAT" TO BU-DISPLAY-MSG
              PERFORM 990-BLOWUP THRU 990-EXIT.

       6300-EXIT.  EXIT.
       632-VALIDATE-VENDOR.
           MOVE 0                        TO  COND-WORD
           MOVE VENDOR-ARG               TO  VENCDE OF DVENDOR-REC-I.
           START DVENDOR-I KEY = VENCDE OF DVENDOR-REC-I
               INVALID KEY MOVE 17       TO  COND-WORD.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
                   MOVE 17               TO  COND-WORD
               ELSE
                   MOVE 99               TO  COND-WORD.
       632-EXIT.  EXIT.
      *******************************************************************
      **           P E R F O R M E D     R O U T I N E S               **
      *******************************************************************
       940-VSETERROR.
           MOVE B"1"                     TO  IND (99).
           MOVE B"1"                     TO  IND (FIELD-NUMBER).
           MOVE MESSAGE-BUFFER           TO  DE-MESSAGE-LINE1
                                  DE-MESSAGE-LINE2
                                  DE-MESSAGE-LINE3.

       940-EXIT.  EXIT.
       950-VSETERROR.
           MOVE B"1"                     TO  IND (FIELD-NUMBER).
           MOVE MESSAGE-BUFFER           TO  DE-MESSAGE-LINE1
                                  DE-MESSAGE-LINE2
                                  DE-MESSAGE-LINE3.

       950-EXIT.  EXIT.

       960-PLACE-VENCODE.
           IF V-VENDOR (X) = SPACES OR "*"
              MOVE VENCODE-HELP TO V-VENDOR (X)
              GO TO 960-EXIT.
           IF X = 10
              GO TO 960-EXIT.
           ADD 1 TO X.
           GO TO 960-PLACE-VENCODE.

       960-EXIT.
           EXIT.

       990-BLOWUP.
           MOVE VIEW-NFNAME              TO  BU-DISPLAY-FLD (1).
           MOVE CODE-ARG                 TO  BU-DISPLAY-FLD (2).
           CALL "TBLOWUP" USING BASE, BU-PGM-NAME, STATUS-AREA,
                         VIEW-COMAREA, FILE-STATUS, BU-DISPLAY-MSG     ,
                         BU-DISPLAY-FLDS.
       990-EXIT.     EXIT.

       999-CATREAD.
           IF CATREAD-MSG-NUMBER = ZEROS
               MOVE LANG-SETNUM          TO  CATREAD-MSG-SET
               MOVE LANG-MSGNUM          TO  CATREAD-MSG-NUM.
           CALL "CCATREAD" USING CATREAD-PARMS.
           MOVE CATREAD-MSG-TEXT         TO  MESSAGE-BUFFER.
       999-CATREAD-EXIT.  EXIT.
