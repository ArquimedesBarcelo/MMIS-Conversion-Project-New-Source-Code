023300
023400 01  SCREEN-PRINT-PARMS.
023500     05  PRINT-CTL                   PIC S9(4)  VALUE ZERO COMP.
023600     05  PAGE-CTL                    PIC S9(4)  VALUE 49 COMP.
023700     05  SPOOLFIL-OPEN-SW            PIC X      VALUE "N".
023800
023900 01  PASS-SPOOL-PRT-NO               PIC S9(2)  VALUE ZERO COMP.

024300 PROCEDURE DIVISION.
024400
024500 001-BEGIN SECTION.
024600
024700 010-MAINLINE.
024800     PERFORM 100-BEGIN THRU 199-EXIT.
029600     IF CURRENT-REV > MACCT-MONTH-END-DATE
              GO TO 019-EXIT.
024900     PERFORM 200-PROCESS-UPDATE
025000       UNTIL VIEW-LASTKEY = 3.
025100     PERFORM 1000-CLOSE-FILES.
       019-EXIT.
025200     GOBACK.
025400
025500 100-BEGIN.
025600     MOVE SPACES TO BU-DISPLAY-AREA.
           OPEN I-O DISPLAY-FILE.
           OPEN INPUT MACCOUNT MMATL-ACCUM MCHT-ACCTS DPOITEM.
           OPEN INPUT DAPPLFRT-I.
      *****OPEN I-O DAPPLFRT MCLASS DTRANS.
           OPEN I-O DAPPLFRT DTRANS.
           OPEN INPUT MCLASS.
025700
030200*----------  GET AND SAVE STOREROOM DEPARTMENT
030300     MOVE "SDPT" TO MACCT-KEY.
           MOVE 0 TO COND-WORD.
           MOVE MACCT-KEY TO INFOKEY OF MACCOUNT-REC.
           READ MACCOUNT INTO BUF-MACCT-INFO
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS-1 = "2"
               MOVE 17 TO COND-WORD
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD.

031100     IF GOOD-CALL
031200         NEXT SENTENCE
031300     ELSE
031400         MOVE "DBGET MACCOUNT-INFO SDPT * 100-B"
031500             TO BU-DISPLAY-MSG
031600         PERFORM 990-BLOWUP.

031700     MOVE MACCT-STR-DEPT TO SAVE-STR-DEPT.
035100
027700*----------  GET ACCOUNTING MONTH END DATE
027800     MOVE "MTED" TO MACCT-KEY.
           MOVE 0 TO COND-WORD.
           MOVE MACCT-KEY TO INFOKEY OF MACCOUNT-REC.
           READ MACCOUNT INTO BUF-MACCT-INFO
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS-1 = "2"
               MOVE 17 TO COND-WORD
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD.

028600     IF GOOD-CALL
028700         NEXT SENTENCE
028800     ELSE
028900         MOVE "DBGET MACCOUNT-INFO MTED * 100-B"
029000             TO BU-DISPLAY-MSG
029100         PERFORM 990-BLOWUP.

048600     MOVE 1 TO DATE-MODE.
048800     CALL "TDATECHK" USING DATE-CHECK-AREA.
           MOVE DATE-SLASH-OUT TO DATE-DIV.
029300     MOVE MONTH-DIV TO CURR-MO.
029400     MOVE DAY-DIV TO CURR-DA.
029500     MOVE YEAR-DIV TO CURR-YR.

029600     IF CURRENT-REV > MACCT-MONTH-END-DATE
029700        DISPLAY "MONTH END CLOSING IS STILL IN PROGRESS---"
029800        DISPLAY "THIS PROGRAM CANNOT BE RUN UNTIL THAT IS",
029900                  " COMPLETED...."
030000        GO TO 199-EXIT.
030100
035200     OPEN INPUT CARRIER-FILE.

       199-EXIT.
           EXIT.
035300
035600 200-PROCESS-UPDATE.
035700     MOVE UPD-HEADER TO VIEW-NFNAME.
035800
           MOVE INQHDR-BUFFER TO DISPLAY-REC.
           WRITE DISPLAY-REC FORMAT IS VIEW-NFNAME
              INDIC ARE SRF-INDICATORS.
           MOVE ALL B"0" TO SRF-INDICATORS.

           READ  DISPLAY-FILE FORMAT IS VIEW-NFNAME
               INDIC ARE SRF-INDICATORS.
           ACCEPT IOFEEDBACK FROM I-O-FEEDBACK-AREA.
           MOVE ALL B"0" TO SRF-INDICATORS.
           MOVE DISPLAY-REC TO INQHDR-BUFFER.

      *------ A BAD STATUS MAY MEAN USER TURNED OFF TERMINAL.
      *------ IF SO, SIMULATE THE F3 KEY TO EXIT PROGRAM.
           IF DISPLAY-STATUS NOT = "00"
               MOVE 3 TO VIEW-LASTKEY
           ELSE
               MOVE FUNCTION-NUM TO VIEW-LASTKEY.
036200     IF VIEW-LASTKEY EQUAL 1 OR
036300        VIEW-LASTKEY EQUAL 2 OR
036400        VIEW-LASTKEY EQUAL 8 OR
036500        VIEW-LASTKEY EQUAL 4 OR
036600        VIEW-LASTKEY EQUAL 7 OR
036700        VIEW-LASTKEY EQUAL 6
036800        PERFORM 940-VSETERROR THRU 949-EXIT
036900        GO TO 200-PROCESS-UPDATE.
037200
037300     IF VIEW-LASTKEY = 3
037400         NEXT SENTENCE
037500     ELSE
037600         PERFORM 210-FIND-FRT-PRO-NO THRU 210-EXIT
037700            UNTIL  VIEW-LASTKEY = 8
037800               OR  VIEW-LASTKEY = 7 OR 2 OR 3
037900     MOVE "YES" TO ERROR-SW.
038100
038200 210-FIND-FRT-PRO-NO.
038700     MOVE HDR-FRT-PRO-NO TO FRT-ARG.
038800
           MOVE 0 TO COND-WORD.
           MOVE FRT-ARG TO FRTPRONO OF DAPPLFRT-REC-I.
           START DAPPLFRT-I KEY = FRTPRONO OF DAPPLFRT-REC-I
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
                   MOVE 17 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.
039500     IF GOOD-CALL
039600         PERFORM 220-GET-FRT-PRO-NO
039700             UNTIL END-OF-CHAIN OR NO-ERRORS = "YES"
039800         MOVE "NO" TO NO-ERRORS
039900         MOVE 0 TO CARR-FOUND
040000                   ITEM-FOUND
040100     ELSE
040200     IF NO-ENTRY
040300*             "** FRIEGHT BILL DOES NOT EXIST - REENTER **"
040400         MOVE  6 TO LANG-SETNUM
040500         MOVE 22 TO LANG-MSGNUM
040600         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
040700         PERFORM 940-VSETERROR THRU 949-EXIT
040800         PERFORM 800-SHOW-FORM THRU 800-EXIT
040900         GO TO 210-EXIT
041000     ELSE
041100         MOVE "DBFIND DAPPLFRT * 210-FFPN"
041200             TO BU-DISPLAY-MSG
               MOVE FRT-ARG TO BU-DISPLAY-FLD (1)
041300         PERFORM 990-BLOWUP.
041400
041500 210-EXIT.
041600     EXIT.

042000 220-GET-FRT-PRO-NO.
           MOVE 0 TO COND-WORD.
           READ DAPPLFRT-I NEXT INTO BUF-DAPPLFRT
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   MOVE 15 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.
           IF FRTPRONO OF DAPPLFRT-REC-I NOT = FRT-ARG
               MOVE 15 TO COND-WORD.
042800     IF GOOD-CALL
042900         IF DAPPL-CARRIER = HDR-FRT-CARR
043000             MOVE 1 TO CARR-FOUND
043100             IF DAPPL-ITEM-NUM = HDR-FRT-ITEM
043200                 MOVE 1 TO ITEM-FOUND
043300                 IF DAPPL-CANCEL-FLAG-1 = "X"
043400*             "** FRIEGHT BILL HAS BEEN CANCELLED **"
043500                     MOVE  6 TO LANG-SETNUM
043600                     MOVE 23 TO LANG-MSGNUM
043700                     PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
043800                     PERFORM 940-VSETERROR THRU 949-EXIT
043900                     PERFORM 800-SHOW-FORM THRU 800-EXIT
044000                 ELSE
044100                     PERFORM 230-GET-CARRIER-NAME
044200              ELSE
044300                  NEXT SENTENCE
044400         ELSE
044500             NEXT SENTENCE
044600     ELSE
044700     IF END-OF-CHAIN
044800         IF CARR-FOUND = 1
044900             IF ITEM-FOUND = 1
045000                 NEXT SENTENCE
045100             ELSE
045200*             "** INVALID ITEM FOR THIS FREIGHT BILL - REENTER **"
045300                 MOVE  9 TO LANG-SETNUM
045400                 MOVE 73 TO LANG-MSGNUM
045500                 PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
045600                 PERFORM 940-VSETERROR THRU 949-EXIT
045700                 PERFORM 800-SHOW-FORM THRU 800-EXIT
045800         ELSE
045900*             "** INVALID CARRIER FOR THIS FREIGHT BILL - REENTER **"
046000             MOVE  9 TO LANG-SETNUM
046100             MOVE 74 TO LANG-MSGNUM
046200             PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
046300             PERFORM 940-VSETERROR THRU 949-EXIT
046400             PERFORM 800-SHOW-FORM THRU 800-EXIT
046500     ELSE
046600         MOVE "DBGET DAPPLFRT * 220-GFPN" TO BU-DISPLAY-MSG
               MOVE FRT-ARG TO BU-DISPLAY-FLD (1)
046700         PERFORM 990-BLOWUP.
046900
047000 230-GET-CARRIER-NAME.
047100     MOVE DAPPL-CARRIER TO CARRIER-CODE.
047200
047300     READ CARRIER-FILE
047500          INVALID KEY MOVE "CARRIER NOT FOUND" TO CARRIER-NAME.
047600
047700     MOVE CARRIER-NAME TO DTL-CARRIER-NAME.
047800     MOVE DAPPL-CARRIER TO DTL-CARRIER-CODE.
047900     MOVE DAPPL-PO-NUM TO DTL-PO-NUMBER.
048000     MOVE DAPPL-RCVR TO DTL-RCVR.
048100     MOVE DAPPL-ITEM-NUM TO DTL-ITEM.
048200     MOVE DAPPL-RAIL-CAR TO DTL-RAIL-CAR.
048300     MOVE DAPPL-CORP-CODE TO DTL-MATL-CODE.
048400     MOVE DAPPL-PRO-NO TO DTL-FRT-PRO-NO.
048500     MOVE DAPPL-TERMS TO DTL-TERMS.
048600     MOVE 4 TO DATE-MODE.
048700     MOVE DAPPL-PAID-DATE TO DATE-VALIDATE-IN.
048800     CALL "TDATECHK" USING DATE-CHECK-AREA.
048900     MOVE DATE-OUT TO DTL-PAID-DATE.
049000     MOVE DAPPL-PAID-AMT TO VALUE-UNSIGNED.
049100     MOVE VALUE-UNSIGNED TO VALUE-HOLD.
049200     MOVE VALUE-1 TO DTL-PAID-DOL.
049300     MOVE VALUE-2 TO DTL-PAID-DEC.
049400     IF DAPPL-PAID-AMT < 0
049500         MOVE "-" TO DTL-PAID-SIGN
049600     ELSE
049700         MOVE "+" TO DTL-PAID-SIGN.
049800     MOVE 0 TO VALUE-UNSIGNED
049900               VALUE-HOLD.
050000     MOVE 4 TO DATE-MODE.
050100     MOVE DAPPL-SHIP-DATE TO DATE-VALIDATE-IN.
050200     CALL "TDATECHK" USING DATE-CHECK-AREA.
050300     MOVE DATE-OUT TO DTL-SHIP-DATE.
050400     MOVE DAPPL-RATED-AMT TO VALUE-UNSIGNED.
050500     MOVE VALUE-UNSIGNED TO VALUE-HOLD.
050600     MOVE VALUE-1 TO DTL-RATED-DOL.
050700     MOVE VALUE-2 TO DTL-RATED-DEC.
050800     IF DAPPL-RATED-AMT < 0
050900         MOVE "-" TO DTL-RATED-SIGN
051000     ELSE
051100         MOVE "+" TO DTL-RATED-SIGN.
051200     MOVE 0 TO VALUE-UNSIGNED
051300               VALUE-HOLD.
051400     MOVE DAPPL-USE-TAX TO VALUE-UNSIGNED.
051500     MOVE VALUE-UNSIGNED TO VALUE-HOLD.
051600     MOVE VALUE-1 TO DTL-TAX-DOL.
051700     MOVE VALUE-2 TO DTL-TAX-DEC.
051800     IF DAPPL-USE-TAX < 0
051900         MOVE "-" TO DTL-TAX-SIGN
052000     ELSE
052100         MOVE "+" TO DTL-TAX-SIGN.
052200     MOVE 0 TO VALUE-UNSIGNED
052300               VALUE-HOLD.
052400
052500     MOVE ADD-DATE TO VIEW-NFNAME.
           MOVE ADD-DATE-BUFFER TO DISPLAY-REC.
           WRITE DISPLAY-REC FORMAT IS VIEW-NFNAME
              INDIC ARE SRF-INDICATORS.
           MOVE ALL B"0" TO SRF-INDICATORS.

           READ  DISPLAY-FILE FORMAT IS VIEW-NFNAME
               INDIC ARE SRF-INDICATORS.
           ACCEPT IOFEEDBACK FROM I-O-FEEDBACK-AREA.
           MOVE ALL B"0" TO SRF-INDICATORS.
           MOVE DISPLAY-REC TO ADD-DATE-BUFFER.

      *------ A BAD STATUS MAY MEAN USER TURNED OFF TERMINAL.
      *------ IF SO, SIMULATE THE F3 KEY TO EXIT PROGRAM.
           IF DISPLAY-STATUS NOT = "00"
               MOVE 3 TO VIEW-LASTKEY
           ELSE
               MOVE FUNCTION-NUM TO VIEW-LASTKEY.
036100
055100     IF VIEW-LASTKEY = 7 OR 3
055200         NEXT SENTENCE
055300     ELSE
055400     IF VIEW-LASTKEY = 2
055500         PERFORM 250-ADD-CANCEL-FLAG THRU 250-EXIT.
056000
056100 250-ADD-CANCEL-FLAG.
           MOVE HDR-FRT-PRO-NO TO FRT-ARG.
           MOVE 0 TO COND-WORD.
           MOVE FRT-ARG TO FRTPRONO OF DAPPLFRT-REC.
           START DAPPLFRT KEY = FRTPRONO OF DAPPLFRT-REC
              INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF NOT GOOD-CALL
              GO TO 250-EXIT.

       250-LOOP.
           MOVE 0 TO COND-WORD.
           READ DAPPLFRT NEXT INTO BUF-DAPPLFRT
                AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF NOT GOOD-CALL
              GO TO 250-EXIT.
           IF FRTPRONO OF DAPPLFRT-REC NOT = FRT-ARG
              GO TO 250-EXIT.
           IF DAPPL-CARRIER = HDR-FRT-CARR
              IF DAPPL-ITEM-NUM = HDR-FRT-ITEM
                 NEXT SENTENCE
              ELSE
                 GO TO 250-LOOP
            ELSE
              GO TO 250-LOOP.

056400     MOVE DAPPL-PO-NUM TO KEY-PO-NO.
056500     MOVE 1 TO DATE-MODE.
056600     CALL "TDATECHK" USING DATE-CHECK-AREA.
056700     MOVE DATE-YMD-OUT TO DAPPL-CANCEL-DATE.
056800     MOVE "X" TO DAPPL-CANCEL-FLAG-1.
           MOVE DTL-MONEY-FLAG TO DAPPL-CANCEL-FLAG-2.
058200
           MOVE 0 TO COND-WORD.
           REWRITE DAPPLFRT-REC FROM BUF-DAPPLFRT
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD.
058900     IF GOOD-CALL
059000         NEXT SENTENCE
059100     ELSE
059200         MOVE "DBUPDATE DAPPLFRT * 250-LOOP"
059300             TO BU-DISPLAY-MSG
059400         PERFORM 990-BLOWUP.
059500
      *------- DO A START > HIGH-VALUES TO UNLOCK
           MOVE HIGH-VALUES TO FRTPRONO  OF DAPPLFRT-REC.
           START DAPPLFRT KEY > FRTPRONO OF DAPPLFRT-REC
               INVALID KEY MOVE "00" TO FILE-STATUS.
060000     IF GOOD-CALL
060100         NEXT SENTENCE
060200     ELSE
060300         MOVE "DBUNLOCK DAPPLFRT * 250-LOOP"
060400             TO BU-DISPLAY-MSG
060500         PERFORM 990-BLOWUP.
060600
060700*----------  IF TRANSACTION IS A MANUAL, THERE ARE NO DTRANS
060800*            ENTRIES, BUT THERE ARE THOUSANDS OF ENTRIES WITHOUT
060900*            PO NUMBER WHICH REALLY SLOWS DOWN PROCESSING AND
061000*            ACCOMPLISHES NOTHING, SO SKIP ADD-DTRANS
061100     IF DAPPL-PO-NUM NOT = SPACES
061600        IF DTL-MONEY-FLAG = "Y"
061610           PERFORM 270-ADD-DTRANS
061620           IF DAPPL-CORP-CODE = "NON-STR"
061630               NEXT SENTENCE
061640           ELSE
                     IF TRANS-DEPT = SAVE-STR-DEPT
061700                   PERFORM 260-UPDATE-MMATL-ACCUM.

       250-EXIT.
           EXIT.
066200
066300 260-UPDATE-MMATL-ACCUM.
066400     MOVE DAPPL-CORP-CODE TO MMATL-CODE-ARG.
           MOVE 0 TO COND-WORD.
           MOVE MMATL-CODE-ARG TO MATLCODE OF MMATL-ACCUM-REC.
           READ MMATL-ACCUM  INTO BUF-MATLACUM
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS-1 = "2"
               MOVE 17 TO COND-WORD
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD.

067200     IF GOOD-CALL
067300         NEXT SENTENCE
067400     ELSE
067500         MOVE "DBGET MMATL-ACCUM * 260-UMA" TO BU-DISPLAY-MSG
               MOVE MMATL-CODE-ARG TO BU-DISPLAY-FLD (1)
067600         MOVE DAPPL-PRO-NO TO BU-DISPLAY-FLD (2)
067700         PERFORM 990-BLOWUP.
067800
067900     IF DAPPL-PAID-AMT > 0
068000        SUBTRACT DAPPL-PAID-AMT FROM MATL-INV-DOLLARS
068100     ELSE
068200        SUBTRACT DAPPL-RATED-AMT FROM MATL-INV-DOLLARS.

068300     MOVE SPACES TO BU-DISPLAY-MSG.
068400     CALL "SUPDMATL" USING ACCTG-BASE, BUF-MATLACUM,
068500                     STATUS-AREA, BU-DISPLAY-MSG, BU-DISPLAY-FLDS.
068600     IF BU-DISPLAY-MSG NOT = SPACES
068700        PERFORM 990-BLOWUP.
068800
      ****************************************************************
      *** 06/29/92 COMMENTED OUT THE FOLLOWING PARAGRAPH AND ITS EXIT
      *** SINCE IT WAS NEVER BEING EXECUTED ANYWAYS.  ---DAVE PLUM
      ****************************************************************
068900*265-GET-MCLASS.
069000*    MOVE TRANS-CLASS TO CLASS-ARG.
      *    MOVE 0 TO COND-WORD.
      *    MOVE CLASS-ARG TO ACTGCLASS OF MCLASS-REC.
      *    READ MCLASS INTO BUF-MCLASS
      *        INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
      *    IF FILE-STATUS-1 = "2"
      *        MOVE 17 TO COND-WORD
      *    ELSE
      *    IF FILE-STATUS NOT = "00"
      *        MOVE 99 TO COND-WORD.
069800*    IF GOOD-CALL
069900*        NEXT SENTENCE
070000*    ELSE
070100*        GO TO 265-EXIT.
070200*
070300*    SUBTRACT DAPPL-RATED-AMT FROM MCLASS-DCHG-DOLLARS.
070400*
      *    MOVE 0 TO COND-WORD.
      *    REWRITE MCLASS-REC FROM BUF-MCLASS
      *        INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
      *    IF FILE-STATUS NOT = "00"
      *        MOVE 99 TO COND-WORD.
      *
072300*    IF GOOD-CALL
072400*        NEXT SENTENCE
072500*    ELSE
072600*        MOVE "DBUPDATE MCLASS * 265-GET" TO BU-DISPLAY-MSG
072700*        MOVE DAPPL-PRO-NO TO BU-DISPLAY-FLD (1)
072800*        PERFORM 990-BLOWUP.
072900*
      *------- DO A START > HIGH-VALUES TO UNLOCK
      *    MOVE HIGH-VALUES TO ACTGCLASS  OF MCLASS-REC.
      *    START MCLASS KEY > ACTGCLASS OF MCLASS-REC
      *        INVALID KEY MOVE "00" TO FILE-STATUS.
073500*    IF GOOD-CALL
073600*        NEXT SENTENCE
073700*    ELSE
073800*        MOVE "DBUNLOCK MCLASS * 265-GET" TO BU-DISPLAY-MSG
073900*        MOVE DAPPL-PRO-NO TO BU-DISPLAY-FLD (1)
074000*        PERFORM 990-BLOWUP.
074100*
074200*265-EXIT.
      *    EXIT.
      ***************************************************************
074300
074400 270-ADD-DTRANS.
074500     MOVE SPACES TO BUF-DTRANS.
074600     PERFORM 642-GET-ITEM-DATA THRU 642-EXIT.
074700     MOVE 1 TO DATE-MODE.
074800     CALL "TDATECHK" USING DATE-CHECK-AREA.
074900     MOVE DATE-YMD-OUT TO TRANS-DATE.
075000     MOVE DATE-UNFORMATTED-TIME-OUT TO TRANS-TIME.
075100     MOVE DAPPL-CORP-CODE       TO TRANS-STORES-CODE.
075200     MOVE DAPPL-PO-NUM          TO TRANS-PO-NUM.
075300     MOVE DAPPL-RCVR            TO TRANS-RCVR-NUM.
075400     MOVE DAPPL-ITEM-NUM        TO TRANS-ITEM-NUM.
075500     MOVE DAPPL-PRO-NO          TO TRANS-DOCUMENT-NUM.
075700     MOVE "CANC"                TO TRANS-EMP.
075800     MOVE "FRT"                 TO TRANS-CODE.
           MOVE ZEROES                TO TRANS-QTY TRANS-BALANCE-QTY.
075900     IF DAPPL-PAID-AMT > 0
076000        COMPUTE TRANS-VALUE = DAPPL-PAID-AMT * -1
076100     ELSE
076200        COMPUTE TRANS-VALUE = DAPPL-RATED-AMT * -1.
077500
           MOVE 0 TO COND-WORD.
           WRITE DTRANS-REC FROM BUF-DTRANS
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD.
077800     IF GOOD-CALL
077900         NEXT SENTENCE
078000     ELSE
078100         MOVE "DBPUT DTRANS * 270-AD" TO BU-DISPLAY-MSG
               MOVE TRANS-STORES-CODE TO BU-DISPLAY-FLD (1)
               MOVE DAPPL-PRO-NO      TO BU-DISPLAY-FLD (2)
               MOVE TRANS-PO-NUM      TO BU-DISPLAY-FLD (3)
               MOVE TRANS-RCVR-NUM    TO BU-DISPLAY-FLD (4)
               MOVE TRANS-ITEM-NUM    TO BU-DISPLAY-FLD (5)
078200         PERFORM 990-BLOWUP.
078300
      *------- DO A START > HIGH-VALUES TO UNLOCK
           MOVE HIGH-VALUES TO MATLCODE OF DTRANS-REC.
           START DTRANS KEY > MATLCODE OF DTRANS-REC
               INVALID KEY MOVE "00" TO FILE-STATUS.
078800     IF GOOD-CALL
078900         NEXT SENTENCE
079000     ELSE
079100         MOVE "DBUNLOCK DTRANS * 270-AD" TO BU-DISPLAY-MSG
079300         PERFORM 990-BLOWUP.

079400*----------  GET PO ITEM DATA FOR PUTTING DTRANS
079500 642-GET-ITEM-DATA.
079600     MOVE "P" TO KEY-REC-ID.
079700     MOVE "000 "   TO TRANS-CLASS.
079800     MOVE "0000  " TO TRANS-DEPT.
079900     MOVE "000000" TO TRANS-ACCT.
           MOVE 0 TO COND-WORD.
           MOVE CSIS-PO-ARG    TO PORCVNO OF DPOITEM-REC.
           START DPOITEM KEY = PORCVNO OF DPOITEM-REC
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
                   MOVE 17 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.
080700     IF NOT GOOD-CALL
080800        GO TO 642-EXIT.
080900
081000 642-DBGET.
           MOVE 0 TO COND-WORD.
           READ DPOITEM NEXT INTO BUF-DPOITEM
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   MOVE 15 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.
           IF PORCVNO OF DPOITEM-REC NOT = CSIS-PO-ARG
               MOVE 15 TO COND-WORD.
081800     IF GOOD-CALL
081900        IF DAPPL-ITEM-NUM = ITM-NUMBER
082000           MOVE ITM-CLASS TO TRANS-CLASS
082100           MOVE ITM-SUB-DETL TO TRANS-DEPT
082200           MOVE ITM-ADDL-DATA TO TRANS-ACCT
082300           PERFORM 643-VALIDATE-DEPT
                 PERFORM 644-VALIDATE-CLASS
082400        ELSE
082500           GO TO 642-DBGET
082600     ELSE
082700        IF END-OF-CHAIN
082800           GO TO 642-EXIT
082900        ELSE
083000           MOVE "DBGET DPOITEM 642-DBGET" TO BU-DISPLAY-MSG
083100           MOVE CSIS-PO-ARG TO BU-DISPLAY-FLD (1)
083200           PERFORM 990-BLOWUP.

083300 642-EXIT.
           EXIT.
083400
083500 643-VALIDATE-DEPT.
083600     MOVE TRANS-DEPT TO DEPT-ARG.
           MOVE 0 TO COND-WORD.
           MOVE DEPT-ARG TO DEPT OF MCHT-ACCTS-REC.
           READ MCHT-ACCTS INTO BUF-MCHTACCTS
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS-1 = "2"
               MOVE 17 TO COND-WORD
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD.

084400     IF GOOD-CALL
084500         NEXT SENTENCE
084600     ELSE
084700         IF NO-ENTRY
084800            MOVE "0000  " TO TRANS-DEPT
084900         ELSE
085000            MOVE "DBGET MCHT-ACCTS * 643-V-D" TO BU-DISPLAY-MSG
                  MOVE DEPT-ARG TO BU-DISPLAY-FLD (1)
085100            PERFORM 990-BLOWUP.
085200
       644-VALIDATE-CLASS.
           MOVE TRANS-CLASS TO CLASS-ARG.
           MOVE 0 TO COND-WORD.
           MOVE CLASS-ARG TO ACTGCLASS OF MCLASS-REC.
           READ MCLASS INTO BUF-MCLASS
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS-1 = "2"
               MOVE 17 TO COND-WORD
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD.

           IF GOOD-CALL
               NEXT SENTENCE
           ELSE
               IF NO-ENTRY
                   MOVE "000 " TO TRANS-CLASS
               ELSE
                   MOVE "DBGET MCLASS * 644-V-C" TO BU-DISPLAY-MSG
                   MOVE CLASS-ARG TO BU-DISPLAY-FLD (1)
                   PERFORM 990-BLOWUP.

085300 645-INIT-TABLES.
085400     MOVE SPACES TO ACCT-CHARA (SUB)
085500                    ACCT-CHARB (SUB).
085600
085700 646-CHECK-ACCT.
085800     MOVE TRANS-ACCT TO ACCT-TABLE-BEFORE.
085900     PERFORM 647-FIND-CHAR
086000        VARYING SUB FROM 1 BY 1
086100            UNTIL SUB > 6 OR ACCT-FOUND = 1.
086200     MOVE 0 TO ACCT-FOUND.
086300     IF SUB > 6
086400         NEXT SENTENCE
086500     ELSE
086600         MOVE ACCT-TABLE-AFTER TO TRANS-ACCT-HOLD
086700         INSPECT TRANS-ACCT-HOLD REPLACING LEADING SPACES BY
086800                   ZERO
086900         MOVE TRANS-ACCT-HOLD TO TRANS-ACCT.
087000
087100 647-FIND-CHAR.
087200     IF ACCT-CHARB (SUB) NOT NUMERIC
087300         MOVE 1 TO ACCT-FOUND
087400         SUBTRACT 1 FROM SUB
087500         MOVE 6 TO NEW-SUB
087600         PERFORM 648-MOVE-CHAR
087700            VARYING SUB1 FROM SUB BY COUNT-BACK
087800                 UNTIL SUB1 = 0
087900     ELSE
088000         NEXT SENTENCE.
088100
088200 648-MOVE-CHAR.
088300     MOVE ACCT-CHARB (SUB1) TO ACCT-CHARA (NEW-SUB).
088400     SUBTRACT 1 FROM NEW-SUB.
089400
089500 800-SHOW-FORM.
           MOVE INQHDR-BUFFER TO DISPLAY-REC.
           WRITE DISPLAY-REC FORMAT IS VIEW-NFNAME
              INDIC ARE SRF-INDICATORS.
           MOVE ALL B"0" TO SRF-INDICATORS.

           READ  DISPLAY-FILE FORMAT IS VIEW-NFNAME
               INDIC ARE SRF-INDICATORS.
           ACCEPT IOFEEDBACK FROM I-O-FEEDBACK-AREA.
           MOVE ALL B"0" TO SRF-INDICATORS.
           MOVE DISPLAY-REC TO INQHDR-BUFFER.

      *------ A BAD STATUS MAY MEAN USER TURNED OFF TERMINAL.
      *------ IF SO, SIMULATE THE F3 KEY TO EXIT PROGRAM.
           IF DISPLAY-STATUS NOT = "00"
               MOVE 3 TO VIEW-LASTKEY
           ELSE
               MOVE FUNCTION-NUM TO VIEW-LASTKEY.
091700 800-EXIT.
091800     EXIT.

128700 940-VSETERROR.
           MOVE B"1" TO IND (99).
           MOVE B"1" TO IND (FIELD-NUMBER).
           MOVE MESSAGE-BUFFER TO DE-MESSAGE-LINE,
                                  DE-MESSAGE-LINE2.

048600 949-EXIT.
           EXIT.

093000************************************************************
093100*                    B L O W U P                           *
093200*     CHECK FOR IMAGE, VIEW, OR SPOOL ERROR.  CLOSE        *
093300*     FILES, GET OUT OF BLOCK MODE, AND DISPLAY            *
093400*     APPROPRIATE ERROR MESSAGE ON SCREEN.                 *
093500*                                                          *
093600*     ALSO APPENDS THE ERROR MESSAGE TO A FILE CALLED      *
093700*     BLOWUP.PUB.  TO READ THIS FILE, RUN "XBLPRT.OBJECT". *
093800*                                                          *
093900*         |||  PROGRAM IS ABORTED IN TBLOWUP  |||          *
094000************************************************************
094100 990-BLOWUP.
094200     MOVE "TFRTCANC"   TO BU-PGM-NAME.
094300     CALL "TBLOWUP" USING ACCTG-BASE, BU-PGM-NAME, STATUS-AREA,
094400           VIEW-COMAREA, FILE-STATUS, BU-DISPLAY-MSG,
094500           BU-DISPLAY-FLDS.

094600 999-EXIT.
           EXIT.
094700
094800 999-CATREAD.
           IF CATREAD-MSG-NUMBER = ZEROS
               MOVE LANG-SETNUM TO CATREAD-MSG-SET
               MOVE LANG-MSGNUM TO CATREAD-MSG-NUM.
           CALL "CCATREAD" USING CATREAD-PARMS.
           MOVE CATREAD-MSG-TEXT TO MESSAGE-BUFFER.

096400 999-CATREAD-EXIT.
096500     EXIT.
096600
096700 1000-CLOSE-FILES.
           CLOSE MACCOUNT MMATL-ACCUM MCLASS MCHT-ACCTS DPOITEM.
           CLOSE DISPLAY-FILE.
           CLOSE DAPPLFRT DTRANS.
