001100 IDENTIFICATION DIVISION.
001200 PROGRAM-ID.           TFRTCANC.
001300 AUTHOR.               MK MADDEN.
001400 DATE-WRITTEN.         MAR 17, 1987.
001500*INSTALLATION.         GOODYEAR TIRE AND RUBBER CO.
001600*D REMARKS.            THIS PROGRAM IS USED TO CANCEL FREIGHT
001700*D                     BILLS.
002100*D
      *C 06/29/1992     DAVE PLUM     REQUEST #6214
      *C CORRECTED A PROBLEM WITH THE "DEFAULT" VALUES MOVES TO
      *C THE DTRANS FIELDS FOR CLASS AND DEPARTMENT.  EVEN THOUGH
      *C CLASS IS A 4 BYTE FIELD, "000 " SHOULD BE USED AS THE
      *C DEFAULT VALUE INSTEAD OF "0000".  AND SIMILARLY; EVEN
      *C THOUGH DEPARTMENT IS A 6 BYTE FIELD, "0000  " SHOULD BE USED
      *C AS THE DEFAULT VALUE INSTEAD OF "000000".  ALSO CORRECTED
      *C A FEW TBLOWUP ERROR MESSAGES TO INSURE THAT THE PROPER
      *C PARAGRAPH NAME WAS BEING REFERENCED.
      *C - COMMENTED OUT PARAGRAPH 265-GET-MCLASS SINCE IT WAS NEVER
      *C   BEING EXECUTED.  COPIED MUCH OF THE LOGIC IN THIS
      *C   PARAGRAPH TO FORM PARAGRAPH 644-VALIDATE-CLASS.
      *C
002200 ENVIRONMENT DIVISION.
002300 CONFIGURATION SECTION.
002400 SOURCE-COMPUTER.      HP-3000.
002500 OBJECT-COMPUTER.      HP-3000.
       SPECIAL-NAMES.  I-O-FEEDBACK IS I-O-FEEDBACK-AREA.
002600 INPUT-OUTPUT SECTION.
002700 FILE-CONTROL.
           SELECT DISPLAY-FILE
                  ASSIGN TO WORKSTATION-ZFRTCANC-SI
                  ORGANIZATION IS TRANSACTION
                  ACCESS IS DYNAMIC
                  RELATIVE KEY IS RELATIVE-RECNO
                  FILE STATUS IS DISPLAY-STATUS
                  CONTROL-AREA IS WS-CONTROL.

003700     SELECT CARRIER-FILE  ASSIGN TO DATABASE-MCFLCACARR
003800                          ORGANIZATION IS INDEXED
003900                          ACCESS MODE IS DYNAMIC
004000                          RECORD KEY IS CARRIER-CODE
004100                          FILE STATUS IS FILE-STATUS.

            SELECT DAPPLFRT
              ASSIGN TO DATABASE-MCFLCA0803
              ORGANIZATION IS INDEXED
                 ACCESS MODE IS DYNAMIC
              RECORD KEY IS EXTERNALLY-DESCRIBED-KEY WITH DUPLICATES
              FILE STATUS IS FILE-STATUS.
004200
            SELECT DAPPLFRT-I
              ASSIGN TO DATABASE-MCFLCA0803
              ORGANIZATION IS INDEXED
                 ACCESS MODE IS DYNAMIC
              RECORD KEY IS EXTERNALLY-DESCRIBED-KEY WITH DUPLICATES
              FILE STATUS IS FILE-STATUS.
004200
            SELECT MACCOUNT
              ASSIGN TO DATABASE-MCFLCA0101
              ORGANIZATION IS INDEXED
                 ACCESS MODE IS DYNAMIC
              RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
              FILE STATUS IS FILE-STATUS.

            SELECT DTRANS
              ASSIGN TO DATABASE-MCFLCA0701
              ORGANIZATION IS INDEXED
                 ACCESS MODE IS DYNAMIC
              RECORD KEY IS EXTERNALLY-DESCRIBED-KEY WITH DUPLICATES
              FILE STATUS IS FILE-STATUS.
004200
            SELECT MMATL-ACCUM
              ASSIGN TO DATABASE-MCFLCA0601
              ORGANIZATION IS INDEXED
                 ACCESS MODE IS DYNAMIC
              RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
              FILE STATUS IS FILE-STATUS.
004200
            SELECT MCLASS
              ASSIGN TO DATABASE-MCFLCS4901
              ORGANIZATION IS INDEXED
                 ACCESS MODE IS DYNAMIC
              RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
              FILE STATUS IS FILE-STATUS.

            SELECT MCHT-ACCTS
              ASSIGN TO DATABASE-MCFLCA0301
              ORGANIZATION IS INDEXED
                 ACCESS MODE IS DYNAMIC
              RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
              FILE STATUS IS FILE-STATUS.

             SELECT DPOITEM
               ASSIGN TO DATABASE-MCFLCS1002
               ORGANIZATION IS INDEXED
                  ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY WITH DUPLICATES
               FILE STATUS IS FILE-STATUS.

