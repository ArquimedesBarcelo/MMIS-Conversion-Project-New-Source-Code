000200 IDENTIFICATION DIVISION.
000300 PROGRAM-ID.    TIERTYPE.
000600*REMARKS.  ***  THIS IS THE SUB-EXECUTIVE FOR
000700*               THE GENERIC EQUIPMENT TYPE SUBSYSTEM
000800*               OF THE EQUIPMENT REFERENCE FILE
000900*          ***  SUBROUTINES CALLED:
001000*               TTYPREFA
001100*               TTYPREFC
001200*               TTYPDEL
001300*                   ****.
001400 ENVIRONMENT DIVISION.
001500 CONFIGURATION SECTION.
001600 SOURCE-COMPUTER.    AS400.
001700 OBJECT-COMPUTER.    AS400.
       SPECIAL-NAMES. I-O-FEEDBACK IS I-O-FEEDBACK-AREA
                      LOCAL-DATA IS LOCAL-DATA-AREA.
001000 INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT DISPLAY-FILE
               ASSIGN TO WORKSTATION-ZIEQPREF-SI
               ORGANIZATION IS TRANSACTION
               ACCESS IS SEQUENTIAL
               FILE STATUS IS DSPLY-STATUS
               CONTROL-AREA IS WS-CONTROL.
001900 DATA DIVISION.
       FILE SECTION.
       FD  DISPLAY-FILE
           LABEL RECORDS ARE OMITTED.
       01  DSPLY-REC               PIC X(2000).
002000 WORKING-STORAGE SECTION.
       COPY CATREAD    IN COPYLIB.

       COPY CPYIND     IN COPYLIB.

003400 01  CUR-TYPE-DISP.
003500     05  CE-LITERAL          PIC X(28).
003600     05  TYPE-NUM            PIC X(08).
003700
004200 01  EQP-SAVE-BUFFER.
004300     05  FILLER              PIC X(50) VALUE SPACES.
004400     05  TYPE-NUM-SAVE       PIC X(08) VALUE SPACES.
004500     05  FILLER              PIC X(07) VALUE SPACES.
004600
       01  FILE-STATUSES.
           05  DSPLY-STATUS        PIC XX.

       COPY IOFEEDBACK IN COPYLIB.

005200 01  MESSAGE-BUFFER.
           05  MESSAGE-LIT         PIC X(28).
           05  FILLER              PIC X(52).
005900
002100 01  PASSWORD-INFORMATION.
002200     05  NAME-OF-PROGRAM     PIC X(08) VALUE "TIERTYPE".
002300     05  PROGRAM-TYPE        PIC X(02) VALUE "UP".
002400     05  PROGRAM-RELEASE     PIC X(12) VALUE " E0100010001".
002500     05  PROGRAM-DESCRIPTION.
002600         10  PROG-DESC-A.
                   15  FILLER      PIC X(16) VALUE "MENU FOR OPTIONS".
                   15  FILLER      PIC X(15) VALUE " SELECTION FOR ".
                   15  FILLER      PIC X(14) VALUE "GENERIC (TYPE ".
                   15  FILLER      PIC X(15) VALUE "NUMBER) RECORD ".
002800         10  PROG-DESC-B.
                   15  FILLER      PIC X(15) VALUE "MAINTENANCE IN ".
                   15  FILLER      PIC X(14) VALUE "THE EQUIPMENT ".
                   15  FILLER      PIC X(31) VALUE "REFERENCE FILE".
003000         10  PROG-FUNCTION.
                   15  FILLER      PIC X(14) VALUE "RUNS FROM THE ".
                   15  FILLER      PIC X(14) VALUE "F6 KEY OF THE ".
                   15  FILLER      PIC X(08) VALUE "PRIMARY ".
                   15  FILLER      PIC X(24) VALUE "MAINTENANCE MENU".
003200     05  PASSWORD-FLAG       PIC X.
003300
003800 01  SCREEN-BUFFER.
003900     05  SCREEN-TYPE-DISP    PIC X(08).
004000     05  SCREEN-C-T-DISP     PIC X(36).
           05  SCREEN-CMD-LINE     PIC X(79).
           05  SCREEN-ERR-LINE     PIC X(79).
004100
       COPY DBSTAT OF COPYLIB.

004700 01  TEMP-BUFFER.
004800     05  DESC-BUFFER         PIC X(40).
004900     05  FILLER              PIC X(10).
005000
       01  TRUE-VAL                PIC 1 VALUE B"1".

       COPY WSCONTROL IN COPYLIB.
006000 LINKAGE SECTION.
       COPY VCOMLINK OF COPYLIB.
006200 01  DBPARAMETERS.        COPY DBPARMS OF COPYLIB.
006500 01  EQP-SUB-BUFFER.
006600     05  EQP-NUM-BUF         PIC X(06).
006700     05  SUB-SYS-BUF         PIC X(04).
006800     05  EQP-SUB-DESC-BUF    PIC X(40).
006900     05  EQP-TYPE-BUF        PIC X(08).
007000     05  ACD-FUNCTION        PIC X(06).
007100     05  ACD-SW              PIC X(01).
007200
007300 PROCEDURE DIVISION USING VIEW-COMAREA
007400                          DBPARAMETERS
007700                          EQP-SUB-BUFFER.
007800
       BEGIN-PGM.
           PERFORM 1-HSK.
           PERFORM 6-MAIN THRU 6-MAIN-EXIT
               UNTIL VIEW-LASTKEY = 1 OR 3.
       2-EOJ.
           CLOSE DISPLAY-FILE.
           GOBACK.
       1-HSK.
           MOVE LOW-VALUES TO STATUS-AREA.
           OPEN I-O   DISPLAY-FILE.
008000     CALL "TPWORD" USING PASSWORD-INFORMATION.
008400     IF PASSWORD-FLAG = "N" GO TO 2-EOJ.
013700     MOVE SPACES TO EQP-SUB-BUFFER.
008900
009000 6-MAIN.
009200     MOVE "FIERTYPE" TO VIEW-CFNAME.
           MOVE 66310 TO CATREAD-MSG-NUMBER.
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
           MOVE MESSAGE-BUFFER TO SCREEN-CMD-LINE.
           MOVE SCREEN-BUFFER TO DSPLY-REC.
013800     PERFORM 99-SCREEN-WRITE.
           PERFORM 98-SCREEN-READ.
           MOVE DSPLY-REC TO SCREEN-BUFFER.
           MOVE SCREEN-TYPE-DISP TO EQP-TYPE-BUF.
           IF VIEW-LASTKEY = 1 OR 3 GO TO 6-MAIN-EXIT.
016200     IF VIEW-LASTKEY = 0
016300         MOVE 42017 TO CATREAD-MSG-NUMBER
016500**MESSAGE******************************************************
016600** PRESS APPROPRIATE FUNCTION KEY TO CONTINUE                **
016700***************************************************************
016800         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER TO SCREEN-CMD-LINE
               MOVE SCREEN-BUFFER TO DSPLY-REC
016900         MOVE TRUE-VAL TO INDS (98)
               PERFORM 99-SCREEN-WRITE
               PERFORM 98A-SCREEN-READ
               CALL "CLPAUSE2"
017100         GO TO 6-MAIN.
012300     MOVE EQP-SUB-BUFFER TO EQP-SAVE-BUFFER.
012400     IF EQP-TYPE-BUF = SPACES
012500         MOVE SPACES TO SCREEN-BUFFER
012600     ELSE
012800     MOVE EQP-TYPE-BUF TO TYPE-NUM
012700     MOVE SPACES TO CE-LITERAL
012900     MOVE 29062 TO CATREAD-MSG-NUMBER
013100**MESSAGE******************************************************
013200** CURRENT EQUIPMENT TYPE IS                                 **
013300***************************************************************
013400     PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
013500     MOVE MESSAGE-LIT TO CE-LITERAL
013600     MOVE CUR-TYPE-DISP TO SCREEN-C-T-DISP.
017200     IF TYPE-NUM-SAVE NOT = SPACES
017800         MOVE SCREEN-TYPE-DISP TO EQP-TYPE-BUF
017900         IF EQP-TYPE-BUF = SPACES
018000             MOVE EQP-SAVE-BUFFER TO EQP-SUB-BUFFER
018100             GO TO 6-MAIN-LOOP.
018800     IF SCREEN-TYPE-DISP = SPACES
018900         MOVE 31002 TO CATREAD-MSG-NUMBER
019100**MESSAGE******************************************************
019200** EQUIPMENT TYPE IS REQUIRED                                **
019300***************************************************************
019400         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER TO SCREEN-ERR-LINE
019500         MOVE TRUE-VAL TO INDS (01) INDS (99)
019700         GO TO 6-MAIN.
019900     MOVE SCREEN-TYPE-DISP TO EQP-TYPE-BUF.

       6-MAIN-LOOP.
020400     IF VIEW-LASTKEY = 1 OR 3 GO TO 6-MAIN-EXIT.
020600     IF VIEW-LASTKEY = 2
020700         MOVE "A" TO ACD-SW
020800         MOVE 27048 TO CATREAD-MSG-NUMBER
021000**MESSAGE******************************************************
021100** ADD                                                       **
021200***************************************************************
021300         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
021400         MOVE MESSAGE-BUFFER TO ACD-FUNCTION
021500         CALL "TTYPREFA" USING VIEW-COMAREA
021600                               DBPARAMETERS
021900                               EQP-SUB-BUFFER
               IF VIEW-LASTKEY = 3
                   GO TO 6-MAIN-EXIT
               ELSE
               MOVE 0 TO VIEW-LASTKEY
022400         GO TO 6-MAIN-LOOP.
022500     IF VIEW-LASTKEY = 4
022600         MOVE "C" TO ACD-SW
022700         MOVE 29061 TO CATREAD-MSG-NUMBER
022900**MESSAGE******************************************************
023000** CHANGE                                                    **
023100***************************************************************
023200         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
023300         MOVE MESSAGE-BUFFER TO ACD-FUNCTION
023400         CALL "TTYPREFC" USING VIEW-COMAREA
023500                               DBPARAMETERS
023800                               EQP-SUB-BUFFER
               IF VIEW-LASTKEY = 3
                   GO TO 6-MAIN-EXIT
               ELSE
               MOVE 0 TO VIEW-LASTKEY
024300         GO TO 6-MAIN-LOOP.
024400     IF VIEW-LASTKEY = 5
024500         MOVE "D" TO ACD-SW
024600         MOVE 30053 TO CATREAD-MSG-NUMBER
024800**MESSAGE******************************************************
024900** DELETE                                                    **
025000***************************************************************
025100         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
025200         MOVE MESSAGE-BUFFER TO ACD-FUNCTION
025300         CALL "TTYPDEL" USING VIEW-COMAREA
025400                              DBPARAMETERS
025700                              EQP-SUB-BUFFER
               IF VIEW-LASTKEY = 3
                   GO TO 6-MAIN-EXIT
               ELSE
               MOVE 0 TO VIEW-LASTKEY
026200         GO TO 6-MAIN-LOOP.

       6-MAIN-EXIT.    EXIT.

       98-SCREEN-READ.
           READ DISPLAY-FILE FORMAT IS VIEW-CFNAME
               INDIC IS INDICS.
           ACCEPT IOFEEDBACK FROM I-O-FEEDBACK-AREA.
           MOVE ALL B"0" TO INDICS.
           IF DSPLY-STATUS NOT = "00"
               MOVE 3 TO VIEW-LASTKEY
           ELSE
           MOVE FUNCTION-NUM TO VIEW-LASTKEY.

       98A-SCREEN-READ.
           READ DISPLAY-FILE TERMINAL IS TERMINAL-ID
               INDIC IS INDICS
                  NO DATA MOVE DSPLY-STATUS TO DSPLY-STATUS.
           MOVE ALL B"0" TO INDICS.

       99-SCREEN-WRITE.
           WRITE DSPLY-REC FORMAT IS VIEW-CFNAME
               INDIC IS INDICS.
           MOVE ALL B"0" TO INDICS.

027100 999-CATREAD.
027200     MOVE SPACES TO MESSAGE-BUFFER.
           CALL "CCATREAD" USING CATREAD-PARMS.
           MOVE CATREAD-MSG-TEXT TO MESSAGE-BUFFER.
028200 999-CATREAD-EXIT.    EXIT.
