      ********************************************************
      *    MAKE SURE THE PRINT FILE EXISTS BY CALLING THE CL
      *    PROGRAM 'CCHKOBJ'.  IF IT DOESNT CHANGE THE PRINT
      *    FILE OVERRIDE BACK TO 'MCPRT' DEFAULT.
      ********************************************************
           MOVE SPOOL-PRT TO OVRPRTF-TOFILE-NUM.
           MOVE OVRPRTF-TOFILE TO CHKOBJ-FILE-NAME.
           CALL "CCHKOBJ" USING CHKOBJ-FILE-NAME,
                                CHKOBJ-RETURN-STATUS.
           IF CHKOBJ-RETURN-STATUS NOT = "00"
               MOVE "MCPRT" TO OVRPRTF-TOFILE.

      *------ MOVE THE OVERPRTF-TOFILE NAME TO THE SPOOLFILE NAME
      *------ SO 'MCPRDNN' SHOWUP ON THE OUTPUT QUEUE AS FILE NAME
      *------ INSTEAD OF 'MCPRD'
           MOVE OVRPRTF-TOFILE TO OVRPRTF-SPLFNAME.

      *------ OVERRIDE PRINTER FILE AND/OR COPIES
           STRING "OVRPRTF FILE(" OVRPRTF-FILE ") TOFILE(*LIBL/"
                  OVRPRTF-TOFILE ") COPIES(" OVRPRTF-COPIES ")"
                  " SHARE(" OVRPRTF-SHARED ")" " PAGESIZE("
                  OVRPRTF-PAGESIZE ")" " OVRFLW(" OVRPRTF-OVRFLW ")"
                  " LPI(" OVRPRTF-LPI ") SPLFNAME(" OVRPRTF-SPLFNAME
                  ")"
               DELIMITED BY SIZE  INTO OVRPRTF-PARM1.
           CALL "QCMDEXC" USING OVRPRTF-PARM1, OVRPRTF-PARM2.
           MOVE 0 TO OVRPRTF-TOFILE-NUM.

       9971-STOPSPOOL.
           MOVE "DLTOVR FILE(MCPRT)" TO OVRPRTF-PARM1.
           CALL "QCMDEXC" USING OVRPRTF-PARM1, OVRPRTF-PARM2.

       9999-DBGET7-MPORCV-PO-O.
           MOVE 0 TO COND-WORD.
           MOVE PO-ARG-ALL TO PORCVNO OF MPORCV-PO-REC-O.
           READ MPORCV-PO-O INTO BUF-MPORCV
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS = "23"
               MOVE 17 TO COND-WORD
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE "DBGET7 ERR 9999-DBGET7-MPORCV-PO-O"
                   TO BU-MSG-AREA
               MOVE 99 TO COND-WORD
               PERFORM 2100-BLOWUP.

       9999-DBFIND-DRCVITEM-PO-O.
           MOVE 0 TO COND-WORD.
           MOVE PO-ARG-ALL TO PORCVNO OF DRCVITEM-PO-REC-O.
           START DRCVITEM-PO-O KEY = PORCVNO OF DRCVITEM-PO-REC-O
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF (FILE-STATUS NOT = "00") AND (FILE-STATUS-1 NOT = "2")
               MOVE "DBFIND ERR 9999-DBFIND-DRCVITEM-PO-O"
                   TO BU-MSG-AREA
               MOVE 99 TO COND-WORD
               PERFORM 2100-BLOWUP.

       9999-DBGET5-DRCVITEM-PO-O.
           MOVE 0 TO COND-WORD.
           READ DRCVITEM-PO-O NEXT INTO BUF-DRCVITEM
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14"
                   PERFORM 9999-RESET-DRCVITEM-PO-O
                   MOVE 15 TO COND-WORD
               ELSE
               IF FILE-STATUS = "46"
                   MOVE 15 TO COND-WORD
               ELSE
                   MOVE "DBGET5 ERR 9999-DBGET5-DRCVITEM-PO-O"
                       TO BU-MSG-AREA
                   MOVE 99 TO COND-WORD
           ELSE
           IF PORCVNO OF DRCVITEM-PO-REC-O NOT = PO-ARG-ALL
               PERFORM 9999-RESET-DRCVITEM-PO-O
               MOVE 15 TO COND-WORD.

       9999-RESET-DRCVITEM-PO-O.
           MOVE HIGH-VALUES TO PORCVNO OF DRCVITEM-PO-REC-O.
           START DRCVITEM-PO-O KEY > PORCVNO OF DRCVITEM-PO-REC-O
               INVALID KEY MOVE "00" TO FILE-STATUS.

       9999-DBUPDATE-DRCVITEM-PO-O.
           MOVE 0 TO COND-WORD.
           REWRITE DRCVITEM-PO-REC-O FROM BUF-DRCVITEM
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE "DBUPDATE ERR 9999-DBUPDATE-DRCVITEM-PO-O"
                   TO BU-MSG-AREA
               MOVE 99 TO COND-WORD
               PERFORM 2100-BLOWUP.

       9999-DBUPDATE-MPORCV-PO-O.
           MOVE 0 TO COND-WORD.
           REWRITE MPORCV-PO-REC-O FROM BUF-MPORCV
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE "DBUPDATE ERR 9999-DBUPDATE-MPORCV-PO-O"
                   TO BU-MSG-AREA
               MOVE 99 TO COND-WORD
               PERFORM 2100-BLOWUP.

