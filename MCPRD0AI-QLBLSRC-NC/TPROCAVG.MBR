000200 IDENTIFICATION DIVISION.
000300 PROGRAM-ID.           TPROCAVG.
000400 AUTHOR.               MK MADDEN.
000500 DATE-WRITTEN.         MAY 30, 1985.
000600*INSTALLATION.         GOODYEAR TIRE AND RUBBER CO.
      *
000800*REMARKS.              THIS PROGRAM WILL READ THROUGH THE
000900*                      MATERIAL ACCUM MASTER DATA SET
001000*                      AND CALCULATE A NEW AVERAGE COST FOR ALL
001100*                      PROCESS ITEMS (100 AND 400 CLASSES).
001200*                      IT WILL ALSO VALUE ALL ISSUES FOR THE
001300*                      MONTH AT THE NEW AVERAGE.
001400*                      THIS PROGRAM WILL PRINT A
001500*                      REPORT OF ALL NEW AVERAGE COSTS AND
001600*                      WILL FLAG THOSE AVERAGE COSTS WHICH
001700*                      HAVE CHANGED MORE THAN 15%.
001800*                      THIS PROGRAM WILL BE RUN ONLY AT THE END
001900*                      OF EACH MONTH FOLLOWING THE LAST MANIFEST
002000*                      RELEASE TO STORES.
      *C
      *C   25FEB1994    DAVE PLUM
      *C     ADDED CALL TO THE COBOL ERROR HANDLER - MCXCBLERR.
      *C
      *C   16SEP1996    DAVE PLUM
      *C     RECOMPILED FOR CENTURY DATABASE CHANGES.
      *C
002200 ENVIRONMENT DIVISION.
002300 CONFIGURATION SECTION.
002400 SOURCE-COMPUTER.      HP-3000.
002500 OBJECT-COMPUTER.      HP-3000.
       COPY SPECIALN IN COPYLIB.
002700
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT MMATL-ACCUM-MC-O
               ASSIGN TO DATABASE-MCFLCA0601
               ORGANIZATION IS INDEXED
                 ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
               FILE STATUS IS FILE-STATUS.

           SELECT MSTORERM-CD-O
               ASSIGN TO DATABASE-MCFLCS0201
               ORGANIZATION IS INDEXED
                 ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
               FILE STATUS IS FILE-STATUS.

           SELECT DTRANS-MC-O
               ASSIGN TO DATABASE-MCFLCA0701
               ORGANIZATION IS INDEXED
                 ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                 WITH DUPLICATES
               FILE STATUS IS FILE-STATUS.

           SELECT MCHT-ACCTS-DP-I
               ASSIGN TO DATABASE-MCFLCA0301
               ORGANIZATION IS INDEXED
                 ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
               FILE STATUS IS FILE-STATUS.

           SELECT DDAILYTC-DT-O
               ASSIGN TO DATABASE-MCFLCS1601
               ORGANIZATION IS INDEXED
                 ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                 WITH DUPLICATES
               FILE STATUS IS FILE-STATUS.

           SELECT MACCOUNT-INFO-IK-O
               ASSIGN TO DATABASE-MCFLCA0101
               ORGANIZATION IS INDEXED
                 ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
               FILE STATUS IS FILE-STATUS.

           SELECT ONLINE-PRT ASSIGN TO PRINTER-MCPRT.

           SELECT SORT-FILE ASSIGN TO DISK-SORT.
