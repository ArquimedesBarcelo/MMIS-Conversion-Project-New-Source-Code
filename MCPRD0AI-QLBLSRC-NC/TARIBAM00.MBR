       IDENTIFICATION DIVISION.

       PROGRAM-ID.     TARIBAM00.
       AUTHOR.         EXLTECH, INC - DAN RAUCH

      ***************************************************************
      **        MENU OF OPTIONS FOR MONITOR PROCESS
      ***************************************************************

      *================================================================
       ENVIRONMENT DIVISION.
      *===============================================================
       CONFIGURATION SECTION.

       SOURCE-COMPUTER.       IBM-AS400.
       OBJECT-COMPUTER.       IBM-AS400.
       SPECIAL-NAMES.         LOCAL-DATA LDA.

       INPUT-OUTPUT SECTION.
       FILE-CONTROL.

           SELECT DISPLAY-FILE  ASSIGN TO WORKSTATION-TARIBAM00D-SI
                  ORGANIZATION IS TRANSACTION
                  ACCESS IS SEQUENTIAL
                  FILE STATUS IS WS-FILE-STATUS
                  CONTROL-AREA IS WS-KEYBOARD-RETURN-AREA.

      *================================================================
       DATA DIVISION.
      *================================================================
       FILE SECTION.

       FD  DISPLAY-FILE.
       01  DISPLAY-REC.
       COPY DD-ALL-FORMATS OF TARIBAM00D.

      *----------------------------------------------------------------
       WORKING-STORAGE SECTION.
      *----------------------------------------------------------------
       COPY FILESTATUS IN COPYLIB.
       COPY DTSPARMS2  IN COPYLIB.
       COPY KEYBDRTN   IN COPYLIB.

      *****************************************************************
      *  ALL PROGRAM INDICATORS
      *****************************************************************
       01  WS-ALL-INDICATORS.
           03  IN10              PIC 1   INDIC 10   VALUE B"0".
               88  S1OPTION-ERROR-NO                VALUE B"0".
               88  S1OPTION-ERROR-YES               VALUE B"1".

           03  IN99              PIC 1   INDIC 99   VALUE B"0".
               88  DISPLAY-ERROR-MSSG-OFF           VALUE B"0".
               88  DISPLAY-ERROR-MSSG-ON            VALUE B"1".

           03  IN98              PIC 1   INDIC 98   VALUE B"0".
               88  DISPLAY-CLRWHT-MSSG-OFF          VALUE B"0".
               88  DISPLAY-CLRWHT-MSSG-ON           VALUE B"1".


       01  WS-ALL-SCREEN-FIELDS.
            03  WS-H01-FLDS.
                05  HDDATE            PIC X(13)          VALUE SPACE.
                05  HDTIME            PIC X(08)          VALUE SPACE.

            03  WS-S01-FLDS.
                05  S1OPTION          PIC X(01)      VALUE SPACE.

            03  WS-B01-FLDS.
                05  MSSG              PIC X(78)          VALUE SPACE.

      *****************************************************************
      *  PROGRAM MESSAGES
      *****************************************************************
       01  WS-PROGRAM-MESSAGES.
           03  WS-OPTION-ERROR-MSG        PIC X(78)     VALUE
               "INVALID OPTION - RE-ENTER".
           03  WS-START-MSG               PIC X(78)     VALUE
               "START OF JOB TARIBAMON INITIATED".
           03  WS-END-MSG                 PIC X(78)     VALUE
               "END OF JOB TARIBAMON INITIATED".

      *****************************************************************
      *  MISCELLANEOUS WORK FIELDS
      *****************************************************************
       01  WS-MISCELLANEOUS-FIELDS.
           03  WS-STARTMON-PGM   PIC X(10)  VALUE "TARIBA00C".
           03  WS-ENDMON-PGM     PIC X(10)  VALUE "TARIBA99C".
           03  WS-PROCJOBS-PGM   PIC X(10)  VALUE "TARIBA100C".
           03  WS-DQPMAINT-PGM   PIC X(10)  VALUE "TARIBA110C".

           03  WS-HEADING-DATE   PIC X(13)  VALUE SPACE.
           03  WS-HEADING-TIME   PIC X(08)  VALUE SPACE.

      *================================================================
      *=             P R O C E D U R E    D I V I S I O N
      *================================================================
       PROCEDURE DIVISION.
       0000-PROGRAM-ENTRY.

           OPEN  I-O    DISPLAY-FILE.

           PERFORM 0010-INITIALIZE       THRU 0010-EXIT.

           PERFORM 1000-PROCESS-SCREEN-1 THRU 1000-EXIT
                   UNTIL KB-F03-KEY.

           CLOSE        DISPLAY-FILE.

       0000-PROGRAM-END.
           GOBACK.

      *****************************************************************
      ** 1ST TIME PROCESSING ROUTINE
      *****************************************************************
       0010-INITIALIZE.

           SET KB-ENTER-KEY     TO TRUE.

       0010-EXIT.
            EXIT.

      *****************************************************************
      ***  MAIN PROCESSING LOOP ROUTINE
      *****************************************************************
       1000-PROCESS-SCREEN-1.

           PERFORM 8000-DISPLAY-SCREEN-1  THRU 8000-DSP-EXIT.
           IF  KB-F03-KEY
               GO TO 1000-EXIT
           END-IF.

      ***  OPTION FIELD IS BLANK JUST REDISPLAY
           IF  S1OPTION OF WS-S01-FLDS = SPACE
               GO TO 1000-EXIT
           END-IF.

      *===============================================================
      ***  OPTION 1) = START MONITOR JOB TARIBAMON
      ***  OPTION 2) = END   MONITOR JOB TARIBAMON
      ***  OPTION 3) = MAINTAIN PROCESS AND JOB FILES
      ***  OPTION 4) = MAINTAIN DATAQ PARAMETERS
      *===============================================================
           EVALUATE S1OPTION OF WS-S01-FLDS
           WHEN  "1"
               PERFORM 1001-PROCESS-OPTION-1  THRU 1001-EXIT
           WHEN  "2"
               PERFORM 1002-PROCESS-OPTION-2  THRU 1002-EXIT
           WHEN  "3"
               PERFORM 1003-PROCESS-OPTION-3  THRU 1003-EXIT
           WHEN  "4"
               PERFORM 1004-PROCESS-OPTION-4  THRU 1004-EXIT
           WHEN OTHER
               PERFORM 1099-PROCESS-OPTION-ERROR THRU 1099-EXIT
           END-EVALUATE.

       1000-EXIT.
            EXIT.

      *****************************************************************
      ** PROCESS OPTION 1 - START MONITOR JOB
      *****************************************************************
       1001-PROCESS-OPTION-1.

           CALL  WS-STARTMON-PGM.
           MOVE WS-START-MSG   TO MSSG OF WS-B01-FLDS.
           MOVE SPACE          TO S1OPTION OF WS-S01-FLDS.
           SET DISPLAY-CLRWHT-MSSG-ON  TO TRUE.

       1001-EXIT.
            EXIT.

      *****************************************************************
      ** PROCESS OPTION 2 - END MONITOR JOB
      *****************************************************************
       1002-PROCESS-OPTION-2.

           CALL  WS-ENDMON-PGM.
           MOVE WS-END-MSG     TO MSSG OF WS-B01-FLDS.
           MOVE SPACE          TO S1OPTION OF WS-S01-FLDS.
           SET DISPLAY-CLRWHT-MSSG-ON  TO TRUE.

       1002-EXIT.
            EXIT.

      *****************************************************************
      ** PROCESS OPTION 3 - MAINTAIN PROCESS FILE AND JOBS FILE
      *****************************************************************
       1003-PROCESS-OPTION-3.

           CALL  WS-PROCJOBS-PGM.
           MOVE SPACE          TO S1OPTION OF WS-S01-FLDS.

       1003-EXIT.
            EXIT.

      *****************************************************************
      ** PROCESS OPTION 4 - MAINTAIN DATAQ PARAMETERS
      *****************************************************************
       1004-PROCESS-OPTION-4.

           CALL  WS-DQPMAINT-PGM.
           MOVE SPACE          TO S1OPTION OF WS-S01-FLDS.

       1004-EXIT.
            EXIT.

      *****************************************************************
      ** INVALID OPTION ERROR
      *****************************************************************
       1099-PROCESS-OPTION-ERROR.

           MOVE WS-OPTION-ERROR-MSG   TO MSSG OF WS-B01-FLDS.
           SET S1OPTION-ERROR-YES     TO TRUE.
           SET DISPLAY-ERROR-MSSG-ON  TO TRUE.

       1099-EXIT.
            EXIT.

      *****************************************************************
      ***  GET DATE AND TIME STAMP
      *****************************************************************
       7000-GET-DATE-TIME.

      **** CALL WS-DTS-PGM2  USING WS-SYSTEM-DATE-TIME2.
           CALL "GETDTSTMP2" USING WS-SYSTEM-DATE-TIME2.

       7000-GDT-EXIT.
           EXIT.

      *****************************************************************
      ***  BUILD HEADING FLDS
      *****************************************************************
       7200-BUILD-HEADING-FLDS.

           PERFORM 7000-GET-DATE-TIME    THRU 7000-GDT-EXIT.
           MOVE WS-SYSTEM-HEADING-DATE2 TO WS-HEADING-DATE.
           MOVE WS-SYSTEM-TIME2-HRS     TO WS-HEADING-TIME(1:2)
           MOVE ":"                     TO WS-HEADING-TIME(3:1)
           MOVE WS-SYSTEM-TIME2-MIN     TO WS-HEADING-TIME(4:2)
           MOVE ":"                     TO WS-HEADING-TIME(6:1)
           MOVE WS-SYSTEM-TIME2-SEC     TO WS-HEADING-TIME(7:2)
           IF  WS-HEADING-TIME(1:1) = "0"
               MOVE SPACE               TO WS-HEADING-TIME(1:1)
           END-IF.

       7200-EXIT.
            EXIT.

      *****************************************************************
      ** DISPLAY SCREEN 1 - LIST PROCESSES & ALLOW SELECTION
      *****************************************************************
       8000-DISPLAY-SCREEN-1.

           PERFORM 7200-BUILD-HEADING-FLDS THRU 7200-EXIT.
           MOVE WS-HEADING-DATE          TO HDDATE OF WS-H01-FLDS.
           MOVE WS-HEADING-TIME          TO HDTIME OF WS-H01-FLDS.

           MOVE CORR WS-H01-FLDS    TO H01-O.
           WRITE DISPLAY-REC FORMAT "H01"
                 INDICATORS ARE WS-ALL-INDICATORS
           END-WRITE.

           MOVE CORR WS-B01-FLDS    TO B01-O.
           WRITE DISPLAY-REC FORMAT "B01"
                 INDICATORS ARE WS-ALL-INDICATORS
           END-WRITE.


           MOVE CORR WS-S01-FLDS  TO S01-O.
           WRITE DISPLAY-REC FORMAT "S01"
                 INDICATORS ARE WS-ALL-INDICATORS
           END-WRITE.

           INITIALIZE  WS-S01-FLDS  WS-B01-FLDS.

           READ  DISPLAY-FILE FORMAT "S01"
                 INDICATORS ARE WS-ALL-INDICATORS
           END-READ.
           MOVE CORR S01-I TO WS-S01-FLDS.


      ** RESET DISPLAY INDICATORS
           SET S1OPTION-ERROR-NO       TO TRUE.
           SET DISPLAY-ERROR-MSSG-OFF  TO TRUE.
           SET DISPLAY-CLRWHT-MSSG-OFF TO TRUE.

       8000-DSP-EXIT.
            EXIT.

      *****************************************************************
      ***              END  OF  SOURCE  MEMBER
      *****************************************************************
