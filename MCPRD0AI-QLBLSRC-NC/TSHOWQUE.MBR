       IDENTIFICATION DIVISION.
       PROGRAM-ID.             TSHOWQUE.
       AUTHOR.                 W. ROXBURY.
       INSTALLATION.           GOODYEAR TIRE & RUBBER CO.
       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.
       SOURCE-COMPUTER.        AS-400.
       OBJECT-COMPUTER.        AS-400.
       SPECIAL-NAMES.          I-O-FEEDBACK     IS I-O-FEEDBACK-AREA
                               REQUESTOR        IS WORK-STATION
                               SYSTEM-CONSOLE   IS CONSOLE
                               LOCAL-DATA       IS LOCAL-DATA-AREA.

       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT PER-PERSONNEL
                  ASSIGN       TO DATABASE-MCFLMM0301
                  ORGANIZATION IS INDEXED
                  ACCESS MODE  IS DYNAMIC
                  RECORD KEY   IS EXTERNALLY-DESCRIBED-KEY
                  FILE STATUS  IS FILE-STAT.

           SELECT WO-CRAFTS-REQD
                  ASSIGN       TO DATABASE-MCFLMM0601
                  ORGANIZATION IS INDEXED
                  ACCESS MODE  IS DYNAMIC
                  RECORD KEY   IS EXTERNALLY-DESCRIBED-KEY
                  FILE STATUS  IS FILE-STAT.

           SELECT WO-OPEN-QUEUE-ZP
                  ASSIGN       TO DATABASE-MCFLMM1901
                  ORGANIZATION IS INDEXED
                  ACCESS MODE  IS DYNAMIC
                  RECORD KEY   IS EXTERNALLY-DESCRIBED-KEY
                               WITH DUPLICATES
                  FILE STATUS  IS FILE-STAT.

           SELECT WO-OPEN-QUEUE-CC
                  ASSIGN       TO DATABASE-MCFLMM1903
                  ORGANIZATION IS INDEXED
                  ACCESS MODE  IS DYNAMIC
                  RECORD KEY   IS EXTERNALLY-DESCRIBED-KEY
                               WITH DUPLICATES
                  FILE STATUS  IS FILE-STAT.

           SELECT WO-OPEN-QUEUE-CR
                  ASSIGN       TO DATABASE-MCFLMM1905
                  ORGANIZATION IS INDEXED
                  ACCESS MODE  IS DYNAMIC
                  RECORD KEY   IS EXTERNALLY-DESCRIBED-KEY
                               WITH DUPLICATES
                  FILE STATUS  IS FILE-STAT.

           SELECT WO-ZONE-PRTY
                  ASSIGN       TO DATABASE-MCFLMM0501
                  ORGANIZATION IS INDEXED
                  ACCESS MODE  IS DYNAMIC
                  RECORD KEY   IS EXTERNALLY-DESCRIBED-KEY
                  FILE STATUS  IS FILE-STAT.

           SELECT DISPLAY-FILE
                  ASSIGN       TO WORKSTATION-ZCORLESS-SI
                  ORGANIZATION IS TRANSACTION
                  ACCESS MODE  IS SEQUENTIAL
                  FILE STATUS  IS SCREEN-STATUS
                               MAJOR-MINOR
                  CONTROL-AREA IS SCREEN-CONTROL.

           SELECT OUT-FILE
                  ASSIGN       TO DISK-SHOWQUE
                  ORGANIZATION IS RELATIVE
                  ACCESS MODE  IS DYNAMIC
                  RELATIVE KEY IS ACT-KEY
                  FILE STATUS  IS FILE-STAT.

           SELECT SORT-FILE
                  ASSIGN       TO DISK-SORT.

       DATA DIVISION.
       FILE SECTION.
       FD  PER-PERSONNEL
           LABEL RECORDS       ARE STANDARD.
       01  PP-REC.
           COPY DDS-ALL-FORMATS OF MCFLMM0301.

       FD  WO-CRAFTS-REQD
           LABEL RECORDS       ARE STANDARD.
       01  CR-REC.
           COPY DDS-ALL-FORMATS OF MCFLMM0601.

       FD  WO-OPEN-QUEUE-ZP
           LABEL RECORDS       ARE STANDARD.
       01  QZP-REC.
           COPY DDS-ALL-FORMATS OF MCFLMM1901.

       FD  WO-OPEN-QUEUE-CC
           LABEL RECORDS       ARE STANDARD.
       01  QCC-REC.
           COPY DDS-ALL-FORMATS OF MCFLMM1903.

       FD  WO-OPEN-QUEUE-CR
           LABEL RECORDS       ARE STANDARD.
       01  QCR-REC.
           COPY DDS-ALL-FORMATS OF MCFLMM1905.

       FD  WO-ZONE-PRTY
           LABEL RECORDS       ARE STANDARD.
       01  ZP-REC.
           COPY DDS-ALL-FORMATS OF MCFLMM0501.

       FD  DISPLAY-FILE
           LABEL RECORDS       ARE OMITTED.
       01  DISPLAY-REC         PIC X(2000).

       FD  OUT-FILE RECORD     CONTAINS 59 CHARACTERS
           LABEL RECORDS       ARE OMITTED
           DATA RECORD         IS OUT-REC.
       01  OUT-REC.
           05  OUT-WO-QUEUE    PIC 99.
           05  OUT-CC-NUM      PIC XXXX.
           05  OUT-EQUIP       PIC X(06).
           05  OUT-DOWN        PIC X.
           05  OUT-WO-NUM      PIC X(10).
           05  OUT-DESC        PIC X(30).
           05  OUT-SKILL-1     PIC XX.
           05  OUT-SKILL-2     PIC XX.
           05  OUT-SKILL-3     PIC XX.

       SD  SORT-FILE RECORD    CONTAINS 59 CHARACTERS
           DATA RECORD         IS SORT-REC.
       01  SORT-REC.
           05  SORT-WO-QUEUE   PIC 99.
           05  SORT-CC-NUM     PIC XXXX.
           05  SORT-EQUIP.
               10  SORT-EQ1    PIC X.
               10  SORT-EQ2    PIC X.
               10  SORT-EQ3    PIC X.
               10  SORT-EQ4    PIC X.
               10  SORT-EQ5    PIC X.
               10  SORT-EQ6    PIC X.
           05  SORT-DOWN       PIC X.
           05  SORT-WO-NUM     PIC X(10).
           05  SORT-DESC       PIC X(30).
           05  SORT-SKILL-1    PIC XX.
           05  SORT-SKILL-2    PIC XX.
           05  SORT-SKILL-3    PIC XX.

       WORKING-STORAGE SECTION.
       77  ACT-KEY             PIC 9999         VALUE 0.
       77  MAX-KEY             PIC 9999         VALUE 0.
       77  SAVE-KEY            PIC 9999         VALUE 0.
       77  CC-NUM-KEY          PIC XXXX.
       77  EOF-SW              PIC 9            VALUE 0.
       77  QUEUE-SW            PIC X.
       77  QUEUE-ERROR         PIC X(76).
       77  TRUE-VAL            PIC 1            VALUE B"1".

       01  FILE-STAT.
           05 FILE-STAT-1      PIC X   VALUE "0".
           05 FILE-STAT-2      PIC X   VALUE "0".

       01  PASSWORD-INFORMATION.
           05  NAME-OF-PROGRAM     PIC X(08) VALUE "TSHOWQUE".
           05  PROGRAM-TYPE        PIC X(02) VALUE "UP".
           05  PROGRAM-RELEASE     PIC X(12) VALUE " E0100010001".
           05  PROGRAM-DESCRIPTION.
               10  PROG-DESC-A1    PIC X(30) VALUE
                   "DISPLAYS THE WORKORDER QUEUE S".
               10  PROG-DESC-A2    PIC X(30) VALUE
                   "ORTED BY ZONE OR CRAFT AND    ".
               10  PROG-DESC-B1    PIC X(30) VALUE
                   "CAN CHANGE QUEUE FACTOR AND RE".
               10  PROG-DESC-B2    PIC X(30) VALUE
                   "SERVE WORKORDER FOR SPECIFIC  ".
               10  PROG-FUNCTION1  PIC X(30) VALUE
                   "CRAFTSMAN.  RUNS FROM f4 KEY O".
               10  PROG-FUNCTION2  PIC X(30) VALUE
                   "F SUPERVISOR FUNCTIONS MENU.  ".
           05  PASSWORD-FLAG       PIC X.

       01  REWRITE-KEYS.
           05  KEY-1           PIC 9999     VALUE ZEROS.
           05  KEY-2           PIC 9999     VALUE ZEROS.
           05  KEY-3           PIC 9999     VALUE ZEROS.
           05  KEY-4           PIC 9999     VALUE ZEROS.
           05  KEY-5           PIC 9999     VALUE ZEROS.
           05  KEY-6           PIC 9999     VALUE ZEROS.
           05  KEY-7           PIC 9999     VALUE ZEROS.

       01  SELECT-BUFFER.
           05  ZONE-BUF        PIC XXXX.
           05  CC-NUM-BUF      PIC XXXX.
           05  CRAFT-BUF       PIC XX.
           05  EQUIP-BUF.
               10  EQ1         PIC X.
               10  EQ2         PIC X.
               10  EQ3         PIC X.
               10  EQ4         PIC X.
               10  EQ5         PIC X.
               10  EQ6         PIC X.
           05  CMDMSG1         PIC X(79).
           05  ERRMSG1         PIC X(79).

       01  LINE-UP.
           05  WO-QUEUE-UP     PIC 99 VALUE ZEROS.
           05  WO-Q-X-UP       REDEFINES WO-QUEUE-UP PIC XX.
           05  CC-NUM-UP       PIC XXXX.
           05  EQUIP-UP        PIC X(06).
           05  EQP-DN-UP       PIC X.
           05  WO-NUM-UP       PIC X(10).
           05  DESC-UP         PIC X(30).
           05  SKILL-A-UP      PIC XX.
           05  SKILL-B-UP      PIC XX.
           05  SKILL-C-UP      PIC XX.

       01  SCREEN-DATA.
           05  LINE-1.
               10  WO-QUEUE-1  PIC 99 VALUE ZEROS.
               10  WO-Q-X-1    REDEFINES WO-QUEUE-1 PIC XX.
               10  CC-NUM-1    PIC XXXX.
               10  EQUIP-1     PIC X(06).
               10  DOWN-1      PIC X.
               10  WO-NUM-1    PIC X(10).
               10  DESC-1      PIC X(30).
               10  SKILL-A-1   PIC XX.
               10  SKILL-B-1   PIC XX.
               10  SKILL-C-1   PIC XX.
           05  LINE-2.
               10  WO-QUEUE-2  PIC 99 VALUE ZEROS.
               10  WO-Q-X-2    REDEFINES WO-QUEUE-2 PIC XX.
               10  CC-NUM-2    PIC XXXX.
               10  EQUIP-2     PIC X(06).
               10  DOWN-2      PIC X.
               10  WO-NUM-2    PIC X(10).
               10  DESC-2      PIC X(30).
               10  SKILL-A-2   PIC XX.
               10  SKILL-B-2   PIC XX.
               10  SKILL-C-2   PIC XX.
           05  LINE-3.
               10  WO-QUEUE-3  PIC 99 VALUE ZEROS.
               10  WO-Q-X-3    REDEFINES WO-QUEUE-3 PIC XX.
               10  CC-NUM-3    PIC XXXX.
               10  EQUIP-3     PIC X(06).
               10  DOWN-3      PIC X.
               10  WO-NUM-3    PIC X(10).
               10  DESC-3      PIC X(30).
               10  SKILL-A-3   PIC XX.
               10  SKILL-B-3   PIC XX.
               10  SKILL-C-3   PIC XX.
           05  LINE-4.
               10  WO-QUEUE-4  PIC 99 VALUE ZEROS.
               10  WO-Q-X-4    REDEFINES WO-QUEUE-4 PIC XX.
               10  CC-NUM-4    PIC XXXX.
               10  EQUIP-4     PIC X(06).
               10  DOWN-4      PIC X.
               10  WO-NUM-4    PIC X(10).
               10  DESC-4      PIC X(30).
               10  SKILL-A-4   PIC XX.
               10  SKILL-B-4   PIC XX.
               10  SKILL-C-4   PIC XX.
           05  LINE-5.
               10  WO-QUEUE-5  PIC 99 VALUE ZEROS.
               10  WO-Q-X-5    REDEFINES WO-QUEUE-5 PIC XX.
               10  CC-NUM-5    PIC XXXX.
               10  EQUIP-5     PIC X(06).
               10  DOWN-5      PIC X.
               10  WO-NUM-5    PIC X(10).
               10  DESC-5      PIC X(30).
               10  SKILL-A-5   PIC XX.
               10  SKILL-B-5   PIC XX.
               10  SKILL-C-5   PIC XX.
           05  LINE-6.
               10  WO-QUEUE-6  PIC 99 VALUE ZEROS.
               10  WO-Q-X-6    REDEFINES WO-QUEUE-6 PIC XX.
               10  CC-NUM-6    PIC XXXX.
               10  EQUIP-6     PIC X(06).
               10  DOWN-6      PIC X.
               10  WO-NUM-6    PIC X(10).
               10  DESC-6      PIC X(30).
               10  SKILL-A-6   PIC XX.
               10  SKILL-B-6   PIC XX.
               10  SKILL-C-6   PIC XX.
           05  LINE-7.
               10  WO-QUEUE-7  PIC 99 VALUE ZEROS.
               10  WO-Q-X-7    REDEFINES WO-QUEUE-7 PIC XX.
               10  CC-NUM-7    PIC XXXX.
               10  EQUIP-7     PIC X(06).
               10  DOWN-7      PIC X.
               10  WO-NUM-7    PIC X(10).
               10  DESC-7      PIC X(30).
               10  SKILL-A-7   PIC XX.
               10  SKILL-B-7   PIC XX.
               10  SKILL-C-7   PIC XX.
           05  CMDMSG2         PIC X(79).
           05  ERRMSG2         PIC X(79).

       01  HOLD-BUFFER.
           05  HOLD-1.
               10  HOLD-QUEUE-1 PIC XX.
               10  HOLD-CC-1    PIC XXXX.
               10  FILLER       PIC X(53).
           05  HOLD-2.
               10  HOLD-QUEUE-2 PIC XX.
               10  HOLD-CC-2    PIC XXXX.
               10  FILLER       PIC X(53).
           05  HOLD-3.
               10  HOLD-QUEUE-3 PIC XX.
               10  HOLD-CC-3    PIC XXXX.
               10  FILLER       PIC X(53).
           05  HOLD-4.
               10  HOLD-QUEUE-4 PIC XX.
               10  HOLD-CC-4    PIC XXXX.
               10  FILLER       PIC X(53).
           05  HOLD-5.
               10  HOLD-QUEUE-5 PIC XX.
               10  HOLD-CC-5    PIC XXXX.
               10  FILLER       PIC X(53).
           05  HOLD-6.
               10  HOLD-QUEUE-6 PIC XX.
               10  HOLD-CC-6    PIC XXXX.
               10  FILLER       PIC X(53).
           05  HOLD-7.
               10  HOLD-QUEUE-7 PIC XX.
               10  HOLD-CC-7    PIC XXXX.
               10  FILLER       PIC X(53).

       01  ZONE-ARGUMENT.
           05  Z-ARG           PIC X(4).
           05  FILLER          PIC XX   VALUE "1 ".

       01  DB-ERROR.
           05  DB-FUNC         PIC X(10) VALUE SPACES.
           05  DB-FILE         PIC X(18) VALUE SPACES.
           05  FILLER          PIC X(20) VALUE "ERROR - FILE-STAT = ".
           05  CON-WORD        PIC XX.

           COPY SCREENIO       IN COPYLIB.

           COPY CATREAD        IN COPYLIB.

           COPY JCWAREA        IN COPYLIB.

       01  PERS-DATA.
           COPY MPERSONL       IN COPYLIB.

       01  WO-QUEUE-DATA.
           COPY DWOOPENQ       IN COPYLIB.

       01  ZONE-DATA.
           COPY MZONPRTY       IN COPYLIB.

       01  CRAFT-DATA.
           COPY MWOCRAFT       IN COPYLIB.

       01  MESSAGE-BUFFER-DATA.
           COPY ERRORLIN       IN COPYLIB.

       LINKAGE SECTION.
       01  DBPARAMETERS.
           COPY DBPARMS        IN COPYLIB.

       PROCEDURE DIVISION USING DBPARAMETERS.
       BEGIN-SORT SECTION 01.
       CHECK-PASSWORD.
           CALL "TPWORD" USING PASSWORD-INFORMATION.
           IF PASSWORD-FLAG NOT = "N"
               GO TO OPEN-FILES.
           GOBACK.

       OPEN-FILES.
           OPEN INPUT          PER-PERSONNEL.
           OPEN INPUT          WO-CRAFTS-REQD.
           OPEN INPUT          WO-OPEN-QUEUE-ZP.
           OPEN INPUT          WO-OPEN-QUEUE-CC.
           OPEN INPUT          WO-OPEN-QUEUE-CR.
           OPEN INPUT          WO-ZONE-PRTY.
           OPEN I-O            DISPLAY-FILE.

       CLEAR-BUFFERS.
           MOVE SPACES         TO SELECT-BUFFER MESSAGE-BUFFER.
           ACCEPT MC-LOCAL-DATA-AREA FROM LOCAL-DATA-AREA.
           MOVE JCW-ZJCW-269   TO ZONE-BUF.

       BEGIN-PROC.
           PERFORM 1-HSK THRU 1-EXIT.
           GO TO 6-MAIN.

       END-OF-JOB.
           CLOSE               PER-PERSONNEL.
           CLOSE               WO-CRAFTS-REQD.
           CLOSE               WO-OPEN-QUEUE-ZP.
           CLOSE               WO-OPEN-QUEUE-CC.
           CLOSE               WO-OPEN-QUEUE-CR.
           CLOSE               WO-ZONE-PRTY.
           CLOSE               DISPLAY-FILE.
           CLOSE               OUT-FILE.
           GOBACK.

       1-HSK.
           MOVE 0              TO EOF-SW.
           MOVE "VSELECTQ"     TO SCREEN-NAME.

       1-SHOWFORM.
           MOVE SELECT-BUFFER  TO DISPLAY-REC.
           WRITE DISPLAY-REC  FORMAT IS SCREEN-NAME
               INDIC ARE SCREEN-INDICATORS.
           IF SCREEN-STATUS NOT = "00"
               DISPLAY "SCREEN WRITE ERROR.  SCREEN-STATUS IS "
                        SCREEN-STATUS
               GO TO END-OF-JOB.

           READ  DISPLAY-FILE FORMAT IS SCREEN-NAME
               INDIC ARE SCREEN-INDICATORS
           IF SCREEN-STATUS NOT = "00"
               DISPLAY "SCREEN READ ERROR.  SCREEN-STATUS IS "
                        SCREEN-STATUS
               GO TO END-OF-JOB.

           MOVE DISPLAY-REC    TO SELECT-BUFFER.
           MOVE ALL B"0"       TO SCREEN-INDICATORS.

           IF KEY-HIT = 1 OR 3
               GO TO END-OF-JOB.

           IF KEY-HIT = 5
               CALL "SPMLISTQ" USING DBPARAMETERS
               GO TO 1-HSK.

           IF KEY-HIT NOT = 0
               GO TO 1-SHOWFORM.

           IF SPACES = ZONE-BUF AND CRAFT-BUF AND CC-NUM-BUF
      **********************************************************************
      **    MESSAGE 031/081:
      ** EITHER  ZONE  -OR-  CLOCK CARD  -OR-  CRAFT  IS REQUIRED
      **********************************************************************
               MOVE  31        TO CATREAD-MSG-SET
               MOVE  81        TO CATREAD-MSG-NUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE 1          TO FIELD-NUMBER
               MOVE MESSAGE-BUFFER TO ERRMSG1
               MOVE TRUE-VAL   TO IND(FIELD-NUMBER) IND(99)
               GO TO 1-SHOWFORM.

           IF ZONE-BUF = SPACES
               NEXT SENTENCE
           ELSE
               MOVE ZONE-BUF   TO Z-ARG
               MOVE ZONE-ARGUMENT TO ZONEPRTY OF WO-ZONE-PRTY
               READ WO-ZONE-PRTY INTO ZONE-DATA
                   INVALID KEY MOVE FILE-STAT TO FILE-STAT
                   END-READ
               IF FILE-STAT NOT = "00"
      **********************************************************************
      **    MESSAGE 035/044:
      ** INVALID ZONE
      **********************************************************************
                   MOVE  35    TO CATREAD-MSG-SET
                   MOVE  44    TO CATREAD-MSG-NUM
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE 1      TO FIELD-NUMBER
                   MOVE MESSAGE-BUFFER TO ERRMSG1
                   MOVE TRUE-VAL   TO IND(FIELD-NUMBER) IND(99)
                   GO TO 1-SHOWFORM
               ELSE
                   MOVE ZONE-BUF       TO SETJCW-VALUE
                   MOVE 269            TO SETJCW-STARTING-POS
                   MOVE 4              TO SETJCW-LENGTH
                   CALL "SETJCW" USING SETJCW-VALUE
                                       SETJCW-STARTING-POS
                                       SETJCW-LENGTH
                                       SETJCW-STATUS
                   IF SETJCW-STATUS NOT = "00"
                       MOVE "    "     TO JCW-ZJCW-269.

           IF CC-NUM-BUF = SPACES
               NEXT SENTENCE
           ELSE
           IF CC-NUM-BUF = "NEWS" OR "9999"
      **********************************************************************
      **    MESSAGE 035/049:
      ** INVALID CRAFTSMAN NUMBER
      **********************************************************************
               MOVE  35        TO CATREAD-MSG-SET
               MOVE  49        TO CATREAD-MSG-NUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE 2          TO FIELD-NUMBER
               MOVE MESSAGE-BUFFER TO ERRMSG1
               MOVE TRUE-VAL   TO IND(FIELD-NUMBER) IND(99)
               GO TO 1-SHOWFORM
           ELSE
               MOVE CC-NUM-BUF  TO PERCCNUM OF PER-PERSONNEL
               READ PER-PERSONNEL INTO PERS-DATA
                   INVALID KEY MOVE FILE-STAT TO FILE-STAT
                   END-READ
               IF FILE-STAT NOT = "00"
      **********************************************************************
      **    MESSAGE 035/049:
      ** INVALID CRAFTSMAN NUMBER
      **********************************************************************
                   MOVE  35    TO CATREAD-MSG-SET
                   MOVE  49    TO CATREAD-MSG-NUM
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE 2      TO FIELD-NUMBER
                   MOVE MESSAGE-BUFFER TO ERRMSG1
                   MOVE TRUE-VAL   TO IND(FIELD-NUMBER) IND(99)
                   GO TO 1-SHOWFORM.

           IF CRAFT-BUF = SPACES
               NEXT SENTENCE
           ELSE
               MOVE CRAFT-BUF   TO CRAFTREQD OF WO-CRAFTS-REQD
               READ WO-CRAFTS-REQD INTO CRAFT-DATA
                   INVALID KEY MOVE FILE-STAT TO FILE-STAT
                   END-READ
               IF FILE-STAT NOT = "00"
      **********************************************************************
      **    MESSAGE 035/035:
      ** INVALID SKILL
      **********************************************************************
                   MOVE  35    TO CATREAD-MSG-SET
                   MOVE  35    TO CATREAD-MSG-NUM
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE 3      TO FIELD-NUMBER
                   MOVE MESSAGE-BUFFER TO ERRMSG1
                   MOVE TRUE-VAL   TO IND(FIELD-NUMBER) IND(99)
                   GO TO 1-SHOWFORM.

       1-EXIT.    EXIT.

       6-MAIN.
           MOVE 0              TO ACT-KEY.
           SORT SORT-FILE DESCENDING KEY SORT-WO-QUEUE
                            SORT-EQUIP SORT-SKILL-1
               INPUT PROCEDURE SORT-INPUT-RECORDS
               OUTPUT PROCEDURE SORT-WRITE-FILE.

           IF ACT-KEY = 0
      **********************************************************************
      **    MESSAGE 040/011:
      **  NO RECORDS FOUND WHICH MATCH YOUR SELECTION
      **********************************************************************
               MOVE  40        TO CATREAD-MSG-SET
               MOVE  11        TO CATREAD-MSG-NUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER TO ERRMSG1
               MOVE TRUE-VAL   TO IND(99)
               GO TO BEGIN-PROC.

           MOVE 0              TO ACT-KEY.
           MOVE "VSHOWQUEUE"   TO SCREEN-NAME.
           OPEN I-O            OUT-FILE.

       61-RESET-SCREEN.
           MOVE SPACES         TO SCREEN-DATA MESSAGE-BUFFER.
           PERFORM 62-FILL-SCREEN THRU 62-FS-EXIT.
           MOVE SCREEN-DATA    TO HOLD-BUFFER.

       61-SHOWFORM.
           MOVE SCREEN-DATA    TO DISPLAY-REC.
           WRITE DISPLAY-REC  FORMAT IS SCREEN-NAME
               INDIC ARE SCREEN-INDICATORS.
           IF SCREEN-STATUS NOT = "00"
               DISPLAY "SCREEN WRITE ERROR.  SCREEN-STATUS IS "
                        SCREEN-STATUS
               GO TO END-OF-JOB.

           READ  DISPLAY-FILE FORMAT IS SCREEN-NAME
               INDIC ARE SCREEN-INDICATORS
           IF SCREEN-STATUS NOT = "00"
               DISPLAY "SCREEN READ ERROR.  SCREEN-STATUS IS "
                        SCREEN-STATUS
               GO TO END-OF-JOB.

           MOVE DISPLAY-REC    TO SCREEN-DATA.
           MOVE ALL B"0"       TO SCREEN-INDICATORS.

           IF KEY-HIT = 1 OR 3
               GO TO END-OF-JOB.

           IF KEY-HIT = 2
               CLOSE           OUT-FILE
               GO TO CLEAR-BUFFERS.

           IF KEY-HIT = 8
               CLOSE           OUT-FILE
               GO TO 6-MAIN.

           IF KEY-HIT = 4
               MOVE 0          TO ACT-KEY
               GO TO 61-RESET-SCREEN.

           IF KEY-HIT NOT = 0
               IF EOF-SW = 1
                   GO TO END-OF-JOB
               ELSE
                   GO TO 61-SHOWFORM.

           IF EOF-SW = 1
               MOVE 0          TO EOF-SW
               MOVE 0          TO ACT-KEY.

           IF SCREEN-DATA NOT = HOLD-BUFFER
               PERFORM 63-UPDATE-FILE THRU 63-UF-EXIT
               IF QUEUE-ERROR NOT = SPACES
                   GO TO 61-SHOWFORM.

           GO TO 61-RESET-SCREEN.

       62-FILL-SCREEN.
           ADD 1               TO ACT-KEY.
           MOVE ACT-KEY        TO KEY-1.
           MOVE SPACES         TO OUT-REC.
           READ OUT-FILE INVALID KEY
               MOVE 1          TO EOF-SW
               GO TO 62-FS-EXIT.
           IF ACT-KEY > MAX-KEY
               MOVE 1          TO EOF-SW
               GO TO 62-FS-EXIT.
           MOVE OUT-REC        TO LINE-1.
           ADD 1               TO ACT-KEY.
           MOVE ACT-KEY        TO KEY-2.
           MOVE SPACES         TO OUT-REC.
           READ OUT-FILE INVALID KEY
               MOVE 1          TO EOF-SW
               GO TO 62-FS-EXIT.
           IF ACT-KEY > MAX-KEY
               MOVE 1          TO EOF-SW
               GO TO 62-FS-EXIT.
           MOVE OUT-REC        TO LINE-2.
           ADD 1               TO ACT-KEY.
           MOVE ACT-KEY        TO KEY-3.
           MOVE SPACES         TO OUT-REC.
           READ OUT-FILE INVALID KEY
               MOVE 1          TO EOF-SW
               GO TO 62-FS-EXIT.
           IF ACT-KEY > MAX-KEY
               MOVE 1          TO EOF-SW
               GO TO 62-FS-EXIT.
           MOVE OUT-REC        TO LINE-3.
           ADD 1               TO ACT-KEY.
           MOVE ACT-KEY        TO KEY-4.
           MOVE SPACES         TO OUT-REC.
           READ OUT-FILE INVALID KEY
               MOVE 1          TO EOF-SW
               GO TO 62-FS-EXIT.
           IF ACT-KEY > MAX-KEY
               MOVE 1          TO EOF-SW
               GO TO 62-FS-EXIT.
           MOVE OUT-REC        TO LINE-4.
           ADD 1               TO ACT-KEY.
           MOVE ACT-KEY        TO KEY-5.
           MOVE SPACES         TO OUT-REC.
           READ OUT-FILE INVALID KEY
               MOVE 1          TO EOF-SW
               GO TO 62-FS-EXIT.
           IF ACT-KEY > MAX-KEY
               MOVE 1          TO EOF-SW
               GO TO 62-FS-EXIT.
           MOVE OUT-REC        TO LINE-5.
           ADD 1               TO ACT-KEY.
           MOVE ACT-KEY        TO KEY-6.
           MOVE SPACES         TO OUT-REC.
           READ OUT-FILE INVALID KEY
               MOVE 1          TO EOF-SW
               GO TO 62-FS-EXIT.
           IF ACT-KEY > MAX-KEY
               MOVE 1          TO EOF-SW
               GO TO 62-FS-EXIT.
           MOVE OUT-REC        TO LINE-6.
           ADD 1               TO ACT-KEY.
           MOVE ACT-KEY        TO KEY-7.
           MOVE SPACES         TO OUT-REC.
           READ OUT-FILE INVALID KEY
               MOVE 1          TO EOF-SW
               GO TO 62-FS-EXIT.
           IF ACT-KEY > MAX-KEY
               MOVE 1          TO EOF-SW
               GO TO 62-FS-EXIT.
           MOVE OUT-REC        TO LINE-7.

       62-FS-EXIT.    EXIT.

       63-UPDATE-FILE.
           IF WO-QUEUE-1 = HOLD-QUEUE-1 AND
              CC-NUM-1   = HOLD-CC-1
                 NEXT SENTENCE
           ELSE
      **************************************************************
      ***  AN `*/' WILL SET THE QUEUE FACTOR TO ZERO AND DELETE  ***
      ***  THE RECORD FROM THE QUEUE.                            ***
      **************************************************************
               IF WO-Q-X-1 = "*/"
                   MOVE 0      TO WO-QUEUE-1
                   MOVE LINE-1 TO LINE-UP
                   MOVE ACT-KEY TO SAVE-KEY
                   MOVE KEY-1  TO ACT-KEY
                   MOVE 9      TO FIELD-NUMBER
                   PERFORM 631-CALL-UPDATE
                   MOVE SAVE-KEY TO ACT-KEY
                   IF QUEUE-ERROR NOT = SPACES
                       GO TO 63-UF-EXIT
                   ELSE
                       NEXT SENTENCE
               ELSE
               IF WO-QUEUE-1 NOT NUMERIC
      **********************************************************************
      **    MESSAGE 035/050:
      **  INVALID QUEUE FACTOR - MUST BE NUMERIC
      **********************************************************************
                   MOVE  35    TO CATREAD-MSG-SET
                   MOVE  50    TO CATREAD-MSG-NUM
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE 9      TO FIELD-NUMBER
                   PERFORM 65-ERROR
                   MOVE "X"    TO QUEUE-ERROR
                   GO TO 63-UF-EXIT
               ELSE
               IF WO-QUEUE-1 < 1 OR > 81
      **********************************************************************
      **    MESSAGE 035/051:
      **  INVALID QUEUE FACTOR - MUST BE 81 OR LESS
      **********************************************************************
