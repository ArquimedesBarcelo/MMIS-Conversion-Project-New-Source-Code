                   GO TO 63-UF-EXIT
               ELSE
               IF WO-QUEUE-7 < 1 OR > 81
      **********************************************************************
      **    MESSAGE 035/051:
      **  INVALID QUEUE FACTOR - MUST BE 81 OR LESS
      **********************************************************************
                   MOVE  35    TO CATREAD-MSG-SET
                   MOVE  51    TO CATREAD-MSG-NUM
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE 57     TO FIELD-NUMBER
                   PERFORM 65-ERROR
                   MOVE "X"    TO QUEUE-ERROR
                   GO TO 63-UF-EXIT
               ELSE
               IF WO-QUEUE-7 = 79 OR 80
      **********************************************************************
      **    MESSAGE 032/002:
      **  FACTORS 79 AND 80 ARE RESERVED FOR HOT CODES
      **********************************************************************
                   MOVE  32    TO CATREAD-MSG-SET
                   MOVE   2    TO CATREAD-MSG-NUM
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE 57     TO FIELD-NUMBER
                   PERFORM 65-ERROR
                   MOVE "X"    TO QUEUE-ERROR
                   GO TO 63-UF-EXIT
               ELSE
               IF CC-NUM-7 NOT = SPACES
                   IF CC-NUM-7 = "NEWS" OR "9999"
      **********************************************************************
      **    MESSAGE 035/049:
      **  INVALID CRAFTSMAN NUMBER
      **********************************************************************
                       MOVE  35 TO CATREAD-MSG-SET
                       MOVE  49 TO CATREAD-MSG-NUM
                       PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                       MOVE 58  TO FIELD-NUMBER
                       PERFORM 65-ERROR
                       MOVE "X" TO QUEUE-ERROR
                       GO TO 63-UF-EXIT
                   ELSE
                   MOVE CC-NUM-7 TO CC-NUM-KEY
                   MOVE CC-NUM-KEY TO PERCCNUM OF PER-PERSONNEL
                   READ PER-PERSONNEL INTO PERS-DATA
                       INVALID KEY MOVE FILE-STAT TO FILE-STAT
                       END-READ
                   IF FILE-STAT NOT = "00"
      **********************************************************************
      **    MESSAGE 035/049:
      **  INVALID CRAFTSMAN NUMBER
      **********************************************************************
                       MOVE  35 TO CATREAD-MSG-SET
                       MOVE  49 TO CATREAD-MSG-NUM
                       PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                       MOVE 58  TO FIELD-NUMBER
                       PERFORM 65-ERROR
                       MOVE "X" TO QUEUE-ERROR
                       GO TO 63-UF-EXIT
                   ELSE
                   MOVE LINE-7  TO LINE-UP
                   MOVE ACT-KEY TO SAVE-KEY
                   MOVE KEY-7   TO ACT-KEY
                   MOVE 57      TO FIELD-NUMBER
                   PERFORM 631-CALL-UPDATE
                   MOVE SAVE-KEY TO ACT-KEY
                   IF QUEUE-ERROR NOT = SPACES
                       GO TO 63-UF-EXIT
                   ELSE
                       NEXT SENTENCE
               ELSE
               MOVE LINE-7     TO LINE-UP
               MOVE ACT-KEY    TO SAVE-KEY
               MOVE KEY-7      TO ACT-KEY
               MOVE 57         TO FIELD-NUMBER
               PERFORM 631-CALL-UPDATE
               MOVE SAVE-KEY   TO ACT-KEY
               IF QUEUE-ERROR NOT = SPACES
                   GO TO 63-UF-EXIT.

       63-UF-EXIT.    EXIT.

       631-CALL-UPDATE.
           MOVE LINE-UP        TO OUT-REC.
           REWRITE OUT-REC INVALID KEY
               DISPLAY "REWRITE OUT FILE ERROR - FILE-STATUS IS "
                        FILE-STAT.
           MOVE SPACES         TO WO-QUEUE-DATA.
           MOVE WO-QUEUE-UP    TO QUEUE-FACTOR.
           MOVE WO-NUM-UP      TO Q-WO-NUM.
           MOVE "9999"         TO Q-CC-NUM.
           IF CC-NUM-UP NOT = SPACES
               MOVE CC-NUM-UP  TO Q-CC-NUM.
           MOVE "C"            TO QUEUE-SW.
           IF WO-QUEUE-UP = 0
               MOVE "D"        TO QUEUE-SW.
           CALL "TQUPDATE" USING DBPARAMETERS
                                 WO-QUEUE-DATA
                                 QUEUE-SW
                                 QUEUE-ERROR.
           IF QUEUE-ERROR NOT = SPACES
               MOVE QUEUE-ERROR TO MESSAGE-BUFFER
               PERFORM 65-ERROR.

       65-ERROR.
           MOVE MESSAGE-BUFFER TO ERRMSG2.
           MOVE TRUE-VAL       TO IND(FIELD-NUMBER) IND(99).

       999-CATREAD.
           MOVE SPACES         TO MESSAGE-BUFFER.
           CALL "CCATREAD" USING CATREAD-PARMS.
           MOVE CATREAD-MSG-TEXT TO MESSAGE-BUFFER.

       999-CATREAD-EXIT.    EXIT.

       SORT-INPUT-RECORDS SECTION 02.
           IF CC-NUM-BUF = SPACES
               IF ZONE-BUF = SPACES
                   PERFORM SORT-CRAFT THRU SORT-CFT-EXIT
               ELSE
                   PERFORM SORT-ZONE THRU SORT-Z-EXIT
           ELSE
               PERFORM SORT-CNUM THRU SORT-C-EXIT.

           GO TO SORT-IP-EXIT.

       SORT-ZONE.
           MOVE ZONE-PRTY-FIELD TO ZONEPRTY OF WO-OPEN-QUEUE-ZP.
           START WO-OPEN-QUEUE-ZP KEY = ZONEPRTY OF WO-OPEN-QUEUE-ZP
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
               IF FILE-STAT-1 = "2"
                   GO TO SORT-Z-EXIT
               ELSE
               MOVE "START   " TO DB-FUNC
               MOVE "WO-OPEN-QUEUE-ZP" TO DB-FILE
               MOVE FILE-STAT  TO CON-WORD
               MOVE DB-ERROR   TO MESSAGE-BUFFER
               MOVE 1          TO FIELD-NUMBER
               PERFORM SORT-ERROR
               GO TO 61-SHOWFORM.

           PERFORM SORT-DBGET THRU SORT-DBGET-EXIT.

       SORT-Z-EXIT.    EXIT.

       SORT-DBGET.
           MOVE SPACES         TO SORT-REC.
           READ WO-OPEN-QUEUE-ZP NEXT INTO WO-QUEUE-DATA
               AT END          MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
               IF FILE-STAT = "10" OR "14" OR "46"
                   GO TO SORT-DBGET-EXIT
               ELSE
                   MOVE "READ    " TO DB-FUNC
                   MOVE "WO-OPEN-QUEUE-ZP" TO DB-FILE
                   MOVE FILE-STAT  TO CON-WORD
                   MOVE DB-ERROR   TO MESSAGE-BUFFER
                   MOVE 1          TO FIELD-NUMBER
                   PERFORM SORT-ERROR
                   GO TO 61-SHOWFORM.

           IF ZONE-PRTY-FIELD NOT = Q-ZONE-PRI
               GO TO SORT-DBGET-EXIT.

           MOVE Q-EQUIP-NUM    TO SORT-EQUIP.
           IF EQ1 = SORT-EQ1 OR SPACES
             IF EQ2 = SORT-EQ2 OR SPACES
               IF EQ3 = SORT-EQ3 OR SPACES
                 IF EQ4 = SORT-EQ4 OR SPACES
                   IF EQ5 = SORT-EQ5 OR SPACES
                     IF EQ6 = SORT-EQ6 OR SPACES
                         NEXT SENTENCE
                     ELSE
                         GO TO SORT-DBGET
                   ELSE
                       GO TO SORT-DBGET
                 ELSE
                     GO TO SORT-DBGET
               ELSE
                   GO TO SORT-DBGET
             ELSE
                 GO TO SORT-DBGET
           ELSE
               GO TO SORT-DBGET.

           IF CRAFT-BUF NOT = SPACES
               IF CRAFT-BUF NOT = Q-SKILL-1
                   GO TO SORT-DBGET.

           MOVE QUEUE-FACTOR   TO SORT-WO-QUEUE.
           MOVE Q-WO-NUM       TO SORT-WO-NUM.
           IF Q-CC-NUM NOT = "9999"
               MOVE Q-CC-NUM   TO SORT-CC-NUM.
           IF Q-EQP-DN = "Y"
               MOVE "D"        TO SORT-DOWN.
           MOVE Q-DESCRIPTION  TO SORT-DESC.
           MOVE Q-SKILL-1      TO SORT-SKILL-1.
           MOVE Q-SKILL-2      TO SORT-SKILL-2.
           MOVE Q-SKILL-3      TO SORT-SKILL-3.
           RELEASE SORT-REC.
           GO TO SORT-DBGET.

       SORT-DBGET-EXIT.    EXIT.

       SORT-CRAFT.
           MOVE CRAFT-BUF      TO CRAFTREQD1 OF WO-OPEN-QUEUE-CR.
           START WO-OPEN-QUEUE-CR KEY = CRAFTREQD1 OF WO-OPEN-QUEUE-CR
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
               IF FILE-STAT-1 = "2"
                   GO TO SORT-CFT-EXIT
               ELSE
               MOVE "START   " TO DB-FUNC
               MOVE "WO-OPEN-QUEUE-CR" TO DB-FILE
               MOVE FILE-STAT  TO CON-WORD
               MOVE DB-ERROR   TO MESSAGE-BUFFER
               MOVE 1          TO FIELD-NUMBER
               PERFORM SORT-ERROR
               GO TO 61-SHOWFORM.

           PERFORM SORT-DBGET-CRAFT THRU SORT-DBGET-CRAFT-EXIT.

       SORT-CFT-EXIT.    EXIT.

       SORT-DBGET-CRAFT.
           MOVE SPACES         TO SORT-REC.
           READ WO-OPEN-QUEUE-CR NEXT INTO WO-QUEUE-DATA
               AT END          MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
               IF FILE-STAT = "10" OR "14" OR "46"
                   GO TO SORT-DBGET-CRAFT-EXIT
               ELSE
                   MOVE "READ    " TO DB-FUNC
                   MOVE "WO-OPEN-QUEUE-CR" TO DB-FILE
                   MOVE FILE-STAT  TO CON-WORD
                   MOVE DB-ERROR   TO MESSAGE-BUFFER
                   MOVE 1          TO FIELD-NUMBER
                   PERFORM SORT-ERROR
                   GO TO 61-SHOWFORM.

           IF CRAFT-BUF NOT = Q-SKILL-1
               GO TO SORT-DBGET-CRAFT-EXIT.

           MOVE Q-EQUIP-NUM    TO SORT-EQUIP.
           IF EQ1 = SORT-EQ1 OR SPACES
             IF EQ2 = SORT-EQ2 OR SPACES
               IF EQ3 = SORT-EQ3 OR SPACES
                 IF EQ4 = SORT-EQ4 OR SPACES
                   IF EQ5 = SORT-EQ5 OR SPACES
                     IF EQ6 = SORT-EQ6 OR SPACES
                         NEXT SENTENCE
                     ELSE
                         GO TO SORT-DBGET-CRAFT
                   ELSE
                       GO TO SORT-DBGET-CRAFT
                 ELSE
                     GO TO SORT-DBGET-CRAFT
               ELSE
                   GO TO SORT-DBGET-CRAFT
             ELSE
                 GO TO SORT-DBGET-CRAFT
           ELSE
               GO TO SORT-DBGET-CRAFT.

           MOVE QUEUE-FACTOR   TO SORT-WO-QUEUE.
           MOVE Q-WO-NUM       TO SORT-WO-NUM.
           IF Q-CC-NUM NOT = "9999"
               MOVE Q-CC-NUM   TO SORT-CC-NUM.
           IF Q-EQP-DN = "Y"
               MOVE "D"        TO SORT-DOWN.
           MOVE Q-DESCRIPTION  TO SORT-DESC.
           MOVE Q-SKILL-1      TO SORT-SKILL-1.
           MOVE Q-SKILL-2      TO SORT-SKILL-2.
           MOVE Q-SKILL-3      TO SORT-SKILL-3.
           RELEASE SORT-REC.
           GO TO SORT-DBGET-CRAFT.

       SORT-DBGET-CRAFT-EXIT.    EXIT.

       SORT-CNUM.
           MOVE CC-NUM-BUF     TO PERCCNUM OF WO-OPEN-QUEUE-CC.
           START WO-OPEN-QUEUE-CC KEY = PERCCNUM OF WO-OPEN-QUEUE-CC
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
               IF FILE-STAT-1 = "2"
                   GO TO SORT-C-EXIT
               ELSE
               MOVE "START   " TO DB-FUNC
               MOVE "WO-OPEN-QUEUE-CC" TO DB-FILE
               MOVE FILE-STAT  TO CON-WORD
               MOVE DB-ERROR   TO MESSAGE-BUFFER
               MOVE 1          TO FIELD-NUMBER
               PERFORM SORT-ERROR
               GO TO 61-SHOWFORM.

           PERFORM SORT-DBGET-C THRU SORT-DBGET-C-EXIT.

       SORT-C-EXIT.    EXIT.

       SORT-DBGET-C.
           MOVE SPACES         TO SORT-REC.
           READ WO-OPEN-QUEUE-CC NEXT INTO WO-QUEUE-DATA
               AT END          MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
               IF FILE-STAT = "10" OR "14" OR "46"
                   GO TO SORT-DBGET-C-EXIT
               ELSE
                   MOVE "READ    " TO DB-FUNC
                   MOVE "WO-OPEN-QUEUE-CC" TO DB-FILE
                   MOVE FILE-STAT  TO CON-WORD
                   MOVE DB-ERROR   TO MESSAGE-BUFFER
                   MOVE 1          TO FIELD-NUMBER
                   PERFORM SORT-ERROR
                   GO TO 61-SHOWFORM.

           IF CC-NUM-BUF NOT = Q-CC-NUM
               GO TO SORT-DBGET-C-EXIT.

           MOVE Q-EQUIP-NUM    TO SORT-EQUIP.
           IF EQ1 = SORT-EQ1 OR SPACES
             IF EQ2 = SORT-EQ2 OR SPACES
               IF EQ3 = SORT-EQ3 OR SPACES
                 IF EQ4 = SORT-EQ4 OR SPACES
                   IF EQ5 = SORT-EQ5 OR SPACES
                     IF EQ6 = SORT-EQ6 OR SPACES
                         NEXT SENTENCE
                     ELSE
                         GO TO SORT-DBGET-C
                   ELSE
                       GO TO SORT-DBGET-C
                 ELSE
                     GO TO SORT-DBGET-C
               ELSE
                   GO TO SORT-DBGET-C
             ELSE
                 GO TO SORT-DBGET-C
           ELSE
               GO TO SORT-DBGET-C.

           MOVE QUEUE-FACTOR   TO SORT-WO-QUEUE.
           MOVE Q-WO-NUM       TO SORT-WO-NUM.
           MOVE Q-CC-NUM       TO SORT-CC-NUM.
           IF Q-EQP-DN = "Y"
               MOVE "D"        TO SORT-DOWN.
           MOVE Q-DESCRIPTION  TO SORT-DESC.
           MOVE Q-SKILL-1      TO SORT-SKILL-1.
           MOVE Q-SKILL-2      TO SORT-SKILL-2.
           MOVE Q-SKILL-3      TO SORT-SKILL-3.
           RELEASE SORT-REC.
           GO TO SORT-DBGET-C.

       SORT-DBGET-C-EXIT.    EXIT.

       SORT-ERROR.
           MOVE MESSAGE-BUFFER TO ERRMSG2.
           MOVE TRUE-VAL       TO IND(FIELD-NUMBER) IND(99).

       SORT-IP-EXIT.    EXIT.

       SORT-WRITE-FILE SECTION 03.
           OPEN OUTPUT         OUT-FILE.
           PERFORM SORT-READ-LOOP THRU SRL-EXIT.
           CLOSE               OUT-FILE.
           GO TO SORT-WF-EXIT.

       SORT-READ-LOOP.
           RETURN SORT-FILE AT END
               MOVE ACT-KEY    TO MAX-KEY
               GO TO SRL-EXIT.
           ADD 1               TO ACT-KEY.
           MOVE SORT-REC       TO OUT-REC.
           WRITE OUT-REC INVALID KEY
               DISPLAY "WRITE OUT-FILE ERR - FILE-STATUS IS "
                        FILE-STAT
               GO TO SRL-EXIT.
           GO TO SORT-READ-LOOP.

       SRL-EXIT.    EXIT.

       SORT-WF-EXIT.    EXIT.

