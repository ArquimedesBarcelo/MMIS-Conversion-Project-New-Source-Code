000200 IDENTIFICATION DIVISION.
000300 PROGRAM-ID.    TJMOVCOP.
000600 ENVIRONMENT DIVISION.
000700 CONFIGURATION SECTION.
000800 SOURCE-COMPUTER.  AS400.
000900 OBJECT-COMPUTER.  AS400.
       SPECIAL-NAMES. I-O-FEEDBACK IS I-O-FEEDBACK-AREA
                      LOCAL-DATA IS LOCAL-DATA-AREA.
001000 INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT JOBPLAN-BANK
               ASSIGN TO DATABASE-MCFLMM3601
               ORGANIZATION IS INDEXED
               ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                   WITH DUPLICATES
               FILE STATUS IS JB-STATUS.
           SELECT JOBPLAN-BANK-PF
               ASSIGN TO DATABASE-MCFPMM3600
               ORGANIZATION IS RELATIVE
               ACCESS MODE IS RANDOM
               RELATIVE KEY IS PFKEY
               FILE STATUS IS JBPF-STATUS.
001200 DATA DIVISION.
       FILE SECTION.
       FD  JOBPLAN-BANK
           LABEL RECORDS ARE STANDARD
           DATA RECORD JBREC.
       01  JBREC.
           COPY DDS-ALL-FORMATS OF MCFLMM3601.
       FD  JOBPLAN-BANK-PF
           LABEL RECORDS ARE STANDARD
           DATA RECORD JBPFREC.
       01  JBPFREC.
           COPY DDS-ALL-FORMATS OF MCFPMM3600.
001300 WORKING-STORAGE SECTION.
       01  BLOWUP-BASE             PIC X(16).

       COPY IOFEEDBACK OF COPYLIB.

       01  JB-STATUS               PIC XX.

       01  JBPF-STATUS             PIC XX.

001500 01  JOBPLAN-KEY.
001600     05 JOBP-WO-NO           PIC X(10).
001700     05 JOBP-SEQ-NO          PIC 999.
001800     05 FILLER               PIC X.
001900
002000 01  JOBPLAN-DATA.           COPY DJOBBANK OF COPYLIB.
002100
002200 01  MISC-BUFFER             PIC X(80) VALUE SPACES.
002300
002400 01  PASSWORD-INFORMATION.
002500     05  NAME-OF-PROGRAM     PIC X(08) VALUE "TJMOVCOP".
002600     05  PROGRAM-TYPE        PIC X(02) VALUE "UP".
002700     05  PROGRAM-RELEASE     PIC X(12) VALUE " E0100010001".
002800     05  PROGRAM-DESCRIPTION.
002900         10  PROG-DESC-A     PIC X(60) VALUE
003000           " MOVE OR COPY GENERIC JOBPLAN SEQUENCES  "           .
003100         10  PROG-DESC-B     PIC X(60) VALUE SPACES.
003300         10  PROG-FUNCTION   PIC X(60) VALUE SPACES.
003500     05  PASSWORD-FLAG       PIC X.
003600
       01  PFKEY                   PIC 9(9).

003700 01  SAVE-REC-NO             PIC 9(9).
003800
       COPY DBSTAT OF COPYLIB.

       COPY TBLOWUP   OF COPYLIB.
004100 LINKAGE SECTION.
004300 01  DBPARAMETERS.           COPY DBPARMS OF COPYLIB.
       COPY VCOMLINK OF COPYLIB.
       COPY LANGSUB OF COPYLIB.
004600 01  MJOBPLAN-NAME           PIC X(10).
004700 01  SEQ2                    PIC X(3).
004800 01  SEQ3                    PIC X(3).
004900 01  MC-BYTE                 PIC X.
005000
005200 PROCEDURE DIVISION USING    DBPARAMETERS
005300                             VIEW-COMAREA
005400                             LANGUAGE-PARMS
005500                             MJOBPLAN-NAME
005600                             SEQ2
005700                             SEQ3
005800                             MC-BYTE.
005900
006000 START-PROGRAM.
006100     PERFORM 1-HSK.
006200     PERFORM 6-MAIN.
006400
006500 2-EOJ.
           CLOSE JOBPLAN-BANK.
           CLOSE JOBPLAN-BANK-PF.
006600     GOBACK.
006700
006900 1-HSK.
           OPEN I-O   JOBPLAN-BANK.
           OPEN I-O   JOBPLAN-BANK-PF.
007000     CALL "TPWORD" USING PASSWORD-INFORMATION.
007400     IF PASSWORD-FLAG = "N" GO TO 2-EOJ.
007800     MOVE SPACES             TO JOBPLAN-KEY.
007900     MOVE MJOBPLAN-NAME      TO JOBP-WO-NO.
008000     MOVE SEQ3               TO JOBP-SEQ-NO.
009000     MOVE SEQ2               TO JOBP-SEQ-NO.
009100
009300 6-MAIN.
009400     MOVE 0 TO COND-WORD.
009500     MOVE JOBPLAN-KEY TO GJOBPSEQ OF JBREC.
           START JOBPLAN-BANK KEY IS > EXTERNALLY-DESCRIBED-KEY
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF JB-STATUS NOT = "00" MOVE 17 TO COND-WORD.
009600     IF COND-WORD = 17
009700         NEXT SENTENCE
009800     ELSE
009900     IF COND-WORD = 0
010000         PERFORM 61-MOVCOP-SEQ THRU 61-M-S-E
                   UNTIL COND-WORD = 15.
010400
010600 61-MOVCOP-SEQ.
010700     READ JOBPLAN-BANK NEXT INTO JOBPLAN-DATA
010800         AT END    MOVE 15 TO COND-WORD.
           IF JOBPLAN-KEY NOT = GJOBPSEQ OF JBREC
               MOVE 15 TO COND-WORD.
           IF JB-STATUS NOT = "00" MOVE 15 TO COND-WORD.
010900     IF COND-WORD = 15
011000         GO TO 61-M-S-E
011100     ELSE
011200     IF COND-WORD = 0
               ACCEPT IOFEEDBACK FROM I-O-FEEDBACK-AREA
               MOVE IO-REL-NO TO SAVE-REC-NO
               PERFORM 69-REWRITE-JOBPLAN-BANK
               IF COND-WORD = 17
                   MOVE "REWRITE ERROR * TJMOVCOP *"
                       TO BU-DISPLAY-MSG
                   PERFORM 998-BLOWUP.
011700
011800     MOVE SEQ3 TO JOBPLAN-SEQ-NO.
           MOVE 0 TO COND-WORD.
           WRITE JBREC FROM JOBPLAN-DATA
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF JB-STATUS NOT = "00" MOVE 17 TO COND-WORD.
012100     IF COND-WORD = 17 PERFORM 998-BLOWUP.
013000
013100     IF MC-BYTE = "M"
               PERFORM 69-READ-JOBPLAN-BANK-PF
012700         IF COND-WORD = 17
012800             PERFORM 998-BLOWUP
               ELSE
               PERFORM 69-DELETE-JOBPLAN-BANK-PF
013300         IF COND-WORD = 17
                   MOVE "DELETE ERROR * TJMOVCOP *"
                       TO BU-DISPLAY-MSG
013400             PERFORM 998-BLOWUP.
013600 61-M-S-E.    EXIT.
049600
       69-DELETE-JOBPLAN-BANK-PF.
           MOVE 0 TO COND-WORD.
           DELETE JOBPLAN-BANK-PF RECORD
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF JBPF-STATUS NOT = "00" MOVE 17 TO COND-WORD.

       69-READ-JOBPLAN-BANK-PF.
           MOVE 0 TO COND-WORD.
036900     MOVE SAVE-REC-NO TO PFKEY.
           READ JOBPLAN-BANK-PF INTO JOBPLAN-DATA
                INVALID KEY    MOVE 17 TO COND-WORD.
           IF JBPF-STATUS NOT = "00" MOVE 17 TO COND-WORD.

       69-REWRITE-JOBPLAN-BANK.
           MOVE 0 TO COND-WORD.
           REWRITE JBREC FROM JOBPLAN-DATA
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF JB-STATUS NOT = "00" MOVE 17 TO COND-WORD.

076200 998-BLOWUP.
076300     MOVE "TJMOVCOP" TO BU-PGM-NAME.
076400     CALL "TBLOWUP" USING BLOWUP-BASE BU-PGM-NAME STATUS-AREA
076500                      VIEW-COMAREA DUMMY-KSAM-STAT
076600                      BU-DISPLAY-MSG BU-DISPLAY-FLDS.
