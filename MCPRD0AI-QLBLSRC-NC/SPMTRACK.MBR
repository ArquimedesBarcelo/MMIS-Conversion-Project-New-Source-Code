       IDENTIFICATION DIVISION.
       PROGRAM-ID.             SPMTRACK.
       AUTHOR.                 W. ROXBURY.
       INSTALLATION.           GOODYEAR TIRE & RUBBER CO.
      *REMARKS.                INQUIRY FOR AUDIT TRAIL RECORDS BY EITHER
      *                        WO NUMBER OR EQUIPMENT NUMBER.
       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.
       SOURCE-COMPUTER.        IBM-AS400.
       OBJECT-COMPUTER.        IBM-AS400.
       SPECIAL-NAMES.          C01 IS NEW-PAGE
                               I-O-FEEDBACK IS I-O-FEEDBACK-AREA.

       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT WO-PLANNED
                  ASSIGN       TO DATABASE-MCFLMM1101
                  ORGANIZATION IS INDEXED
                  ACCESS MODE  IS DYNAMIC
                  RECORD KEY   IS EXTERNALLY-DESCRIBED-KEY
                  FILE STATUS  IS FILE-STAT.

           SELECT EQP-EQUIPMENT
                  ASSIGN       TO DATABASE-MCFLMM0201
                  ORGANIZATION IS INDEXED
                  ACCESS MODE  IS DYNAMIC
                  RECORD KEY   IS EXTERNALLY-DESCRIBED-KEY
                  FILE STATUS  IS FILE-STAT.

           SELECT PM-AUDIT-EQUIP
                  ASSIGN       TO DATABASE-MCFLMM4603
                  ORGANIZATION IS INDEXED
                  ACCESS MODE  IS DYNAMIC
                  RECORD KEY   IS EXTERNALLY-DESCRIBED-KEY
                               WITH DUPLICATES
                  FILE STATUS  IS FILE-STAT.

           SELECT PM-AUDIT-WO
                  ASSIGN       TO DATABASE-MCFLMM4604
                  ORGANIZATION IS INDEXED
                  ACCESS MODE  IS DYNAMIC
                  RECORD KEY   IS EXTERNALLY-DESCRIBED-KEY
                               WITH DUPLICATES
                  FILE STATUS  IS FILE-STAT.

           SELECT PM-AUDIT-DATE
                  ASSIGN       TO DATABASE-MCFLMM4601
                  ORGANIZATION IS INDEXED
                  ACCESS MODE  IS DYNAMIC
                  RECORD KEY   IS EXTERNALLY-DESCRIBED-KEY
                               WITH DUPLICATES
                  FILE STATUS  IS FILE-STAT.

           SELECT DISPLAY-FILE
                  ASSIGN       TO WORKSTATION-ZPMMAINT-SI
                  ORGANIZATION IS TRANSACTION
                  ACCESS MODE  IS SEQUENTIAL
                  FILE STATUS  IS SCREEN-STATUS
                  CONTROL-AREA IS SCREEN-CONTROL.

           SELECT OUT-FILE
                  ASSIGN       TO DISK-OPMTRACK
                  ORGANIZATION IS RELATIVE
                  ACCESS MODE  IS DYNAMIC
                  RELATIVE KEY IS ACT-KEY
                  FILE STATUS  IS FILE-STAT.

           SELECT SORT-FILE
                  ASSIGN       TO DISK-SORTFILE.

           SELECT PRINT-FILE
                  ASSIGN       TO PRINTER-MCPRT
                  FILE STATUS  IS FILE-STAT.

       DATA DIVISION.
       FILE SECTION.
       FD  WO-PLANNED
           LABEL RECORDS       ARE STANDARD.
       01  PWO-REC.
           COPY DDS-ALL-FORMATS OF MCFLMM1101.

       FD  EQP-EQUIPMENT
           LABEL RECORDS       ARE STANDARD.
       01  EQP-REC.
           COPY DDS-ALL-FORMATS OF MCFLMM0201.

       FD  PM-AUDIT-EQUIP
           LABEL RECORDS       ARE STANDARD.
       01  PMA-EQP-REC.
           COPY DDS-ALL-FORMATS OF MCFLMM4603.

       FD  PM-AUDIT-WO
           LABEL RECORDS       ARE STANDARD.
       01  PMA-WO-REC.
           COPY DDS-ALL-FORMATS OF MCFLMM4604.

       FD  PM-AUDIT-DATE
           LABEL RECORDS       ARE STANDARD.
       01  PMA-DATE-REC.
           COPY DDS-ALL-FORMATS OF MCFLMM4601.

       FD  DISPLAY-FILE
           LABEL RECORDS       ARE OMITTED.
       01  DISPLAY-REC         PIC X(2000).

       FD  OUT-FILE RECORD     CONTAINS 64 CHARACTERS
           LABEL RECORDS       ARE OMITTED
           DATA RECORD         IS OUT-REC.
       01  OUT-REC.
           05  OUT-AUD-DATE.
               10  OUT-AUD-YYYY  PIC X(04).
               10  OUT-AUD-MM    PIC X(02).
               10  OUT-AUD-DD    PIC X(02).
           05  OUT-AUD-TIME.
               10  OUT-AUD-HH    PIC X(02).
               10  OUT-AUD-MN    PIC X(02).
           05  OUT-TRANS         PIC X(02).
           05  OUT-EQUIP-NUM     PIC X(06).
           05  OUT-WO-NUM        PIC X(10).
           05  OUT-WOSTAT        PIC X(02).
           05  OUT-LEVEL         PIC X(02).
           05  OUT-DESC          PIC X(30).

       SD  SORT-FILE RECORD CONTAINS 64 CHARACTERS
           DATA RECORD IS SORT-REC.
       01  SORT-REC.
           05  SORT-AUD-DATE.
               10  SORT-AUD-YYYY PIC X(04).
               10  SORT-AUD-MM   PIC X(02).
               10  SORT-AUD-DD   PIC X(02).
           05  SORT-AUD-TIME     PIC X(04).
           05  SORT-TRANS        PIC X(02).
           05  SORT-EQUIP-NUM    PIC X(06).
           05  SORT-WO-NUM       PIC X(10).
           05  SORT-WOSTAT       PIC X(02).
           05  SORT-LEVEL        PIC X(02).
           05  SORT-DESC         PIC X(30).

       FD  PRINT-FILE RECORD   CONTAINS 80 CHARACTERS
           LABEL RECORDS       ARE OMITTED
           DATA RECORD         IS PRINT-REC.
       01  PRINT-REC.
           05  PRT-REC         PIC X(80).

       WORKING-STORAGE SECTION.
       77  MAX-LINES           PIC S9(2)  VALUE 16.
       77  SUB                 PIC S9(2)  VALUE 0.
       77  PAGE-NO             PIC 9(2)   VALUE 0.
       77  ACT-KEY             PIC 9(8).
       77  MAX-KEY             PIC 9(8).
       77  SAVE-KEY            PIC S9(8).
       77  EOF-SW              PIC X      VALUE "N".
       77  SCREEN-FILLED       PIC X      VALUE "N".
       77  LINE-CTR            PIC S9(2)  VALUE 60.
       77  FILE-SW             PIC X(1)   VALUE "P".
       77  TRUE-VAL            PIC 1      VALUE B"1".
       77  FILE-STAT           PIC X(02).
       77  HEADING-DOTS        PIC X(80)  VALUE ALL "=".
       77  HEADING-DASHES      PIC X(80)  VALUE ALL "-".

       01  PASSWORD-INFORMATION.
           05  NAME-OF-PROGRAM PIC X(08) VALUE "SPMTRACK".
           05  PROGRAM-TYPE    PIC X(02) VALUE "IN".
           05  PROGRAM-RELEASE PIC X(12) VALUE " J0100010001".
           05  PROGRAM-DESCRIPTION.
               10  PROG-DESC-A PIC X(60) VALUE
                  "AUDIT TRAIL INQUIRY FOR PM WORKORDERS.".
               10  PROG-DESC-B PIC X(60) VALUE SPACES.
               10  PROG-FUNC   PIC X(60) VALUE SPACES.
           05  PASSWORD-FLAG   PIC X.

       01  TD-YMD.
           05  TD-YY           PIC 9(02).
           05  TD-MM           PIC 9(02).
           05  TD-DD           PIC 9(02).

       01  CT-HMS.
           05  CT-HH           PIC 9(02).
           05  CT-MM           PIC 9(02).
           05  CT-SS           PIC 9(02).

       01  RETURN-COD.
           05  RET-CODE        PIC X.
           05  FILLER          PIC X.

       01  SCREEN-DATA.
           05  SEL-WO.
               10  SEL-WO-7    PIC X(07).
               10  SEL-WO-SUF  PIC X(03).
           05  SEL-DATE        REDEFINES SEL-WO.
               10  SEL-DATE-2  PIC X(02).
               10  SEL-DATE-8  PIC X(08).
           05  SEL-EQUIP       PIC X(06).
           05  SEL-PRINT       PIC X.
           05  CMDMSG          PIC X(79).
           05  ERRMSG          PIC X(79).

       01  RPT-SCREEN-DATA.
           05  RPT-EQUIP       PIC X(06).
           05  RPT-DATA        OCCURS 16 TIMES
                               PIC X(61).
           05  CMDMSGR         PIC X(79).
           05  ERRMSGR         PIC X(79).

       01  LINE-DATA.
           05  L-DATE.
               10  L-MM        PIC XX.
               10  SLASH1      PIC X.
               10  L-DD        PIC XX.
               10  SLASH2      PIC X.
               10  L-YY        PIC XXXX.
           05  DASH1           PIC X.
           05  L-TIME.
               10  L-HH        PIC XX.
               10  COLON1      PIC X.
               10  L-MN        PIC XX.
           05  L-INPUT.
               10  L-IN        PIC X.
               10  L-WO        PIC X(10).
           05  L-STATUS        PIC XX.
           05  L-LEVEL         PIC XX.
           05  L-DESC          PIC X(30).

       01  PRINT-DATA.
           05  FILLER          PIC X(03) VALUE SPACES.
           05  PRT-MM          PIC X(02) VALUE SPACES.
           05  SLASH3          PIC X(01) VALUE SPACES.
           05  PRT-DD          PIC X(02) VALUE SPACES.
           05  SLASH4          PIC X(01) VALUE SPACES.
           05  PRT-YY          PIC X(04) VALUE SPACES.
           05  DASH2           PIC X(01) VALUE SPACES.
           05  PRT-HH          PIC X(02) VALUE SPACES.
           05  COLON2          PIC X(01) VALUE SPACES.
           05  PRT-MN          PIC X(02) VALUE SPACES.
           05  FILLER          PIC X(03) VALUE SPACES.
           05  PRT-WO          PIC X(10) VALUE SPACES.
           05  FILLER          PIC X(03) VALUE SPACES.
           05  PRT-STATUS      PIC X(02) VALUE SPACES.
           05  FILLER          PIC X(05) VALUE SPACES.
           05  PRT-LEVEL       PIC X(02) VALUE SPACES.
           05  FILLER          PIC X(04) VALUE SPACES.
           05  PRT-DESC        PIC X(30) VALUE SPACES.
           05  FILLER          PIC X(02) VALUE SPACES.

       01  DATE-LINE.
           05  FILLER          PIC X(06) VALUE SPACES.
           05  PRT-PROG        PIC X(08) VALUE "SPMTRACK".
           05  FILLER          PIC X(09) VALUE SPACES.
           05  FILLER          PIC X(07) VALUE "DATE:  ".
           05  CUR-MM          PIC X(02) VALUE SPACES.
           05  FILLER          PIC X(01) VALUE "/".
           05  CUR-DD          PIC X(02) VALUE SPACES.
           05  FILLER          PIC X(01) VALUE "/".
           05  CUR-CT          PIC X(02) VALUE SPACES.
           05  CUR-YY          PIC X(02) VALUE SPACES.
           05  FILLER          PIC X(02) VALUE SPACES.
           05  FILLER          PIC X(04) VALUE SPACES.
           05  FILLER          PIC X(07) VALUE "TIME:  ".
           05  CUR-HH          PIC X(02) VALUE SPACES.
           05  FILLER          PIC X(01) VALUE ":".
           05  CUR-MN          PIC X(02) VALUE SPACES.
           05  FILLER          PIC X(09) VALUE SPACES.
           05  FILLER          PIC X(05) VALUE "PAGE ".
           05  PAGENO          PIC Z9    VALUE SPACES.
           05  FILLER          PIC X(06) VALUE SPACES.

       01  HEADING-1.
           05  FILLER          PIC X(08) VALUE SPACES.
           05  FILLER          PIC X(20) VALUE "P M   W O R K O R D ".
           05  FILLER          PIC X(20) VALUE "E R   A U D I T   T ".
           05  FILLER          PIC X(18) VALUE "R A I L   F O R   ".
           05  PRT-EQUIP       PIC X(06) VALUE SPACES.
           05  FILLER          PIC X(08) VALUE SPACES.

       01  HEADING-2.
           05  FILLER          PIC X(03) VALUE SPACES.
           05  FILLER          PIC X(19) VALUE "DATE/TIME  STAMP   ".
           05  FILLER          PIC X(19) VALUE "WORKORDER  STATUS  ".
           05  FILLER          PIC X(18) VALUE "LEVEL  DESCRIPTION".
           05  FILLER          PIC X(21) VALUE SPACES.

       01  DB-ERROR.
           05  DB-TYPE         PIC X(24) VALUE SPACES.
           05  FILLER          PIC X(22) VALUE "  ERROR - COND-WORD = ".
           05  CON-WORD        PIC XX.

           COPY SCREENIO       IN COPYLIB.

           COPY CATREAD        IN COPYLIB.

           COPY OVRPFDATA      IN COPYLIB.

       01  EQUIPMENT-DATA.     COPY MEQPFILE  IN COPYLIB.

       01  WO-BASIC-DATA.      COPY DWOBASIC  IN COPYLIB.

       01  WO-PLANNED-DATA.    COPY DWOPLAN   IN COPYLIB.

       01  MESSAGE-FILE-DATA.  COPY ERRORLIN  IN COPYLIB.

       01  AUDIT-DATA.         COPY DPMAUDIT  IN COPYLIB.

       LINKAGE SECTION.
       01  DBPARAMETERS.       COPY DBPARMS   IN COPYLIB.

       PROCEDURE DIVISION      USING DBPARAMETERS.
       BEGIN-SORT              SECTION 01.
       BEGIN-PROC.
           MOVE 60             TO LINE-CTR.
           CALL "CLPMTRACK".
           OPEN I-O            DISPLAY-FILE.
           OPEN INPUT          WO-PLANNED.
           OPEN INPUT          EQP-EQUIPMENT.
           OPEN INPUT          PM-AUDIT-WO.
           OPEN INPUT          PM-AUDIT-EQUIP.
           OPEN INPUT          PM-AUDIT-DATE.

           ACCEPT TD-YMD       FROM DATE.
           IF TD-YY > 90
               MOVE "19"       TO CUR-CT
           ELSE
               MOVE "20"       TO CUR-CT.

           MOVE TD-YY          TO CUR-YY.
           MOVE TD-MM          TO CUR-MM.
           MOVE TD-DD          TO CUR-DD.

           ACCEPT CT-HMS       FROM TIME.
           MOVE CT-HH          TO CUR-HH.
           MOVE CT-MM          TO CUR-MN.

       SELECTION-CRITERIA.
           MOVE SPACES         TO MESSAGE-BUFFER
                                  SCREEN-DATA.
           MOVE "VSELAUDIT"    TO SCREEN-NAME.

       SHOWFORM-SELECTION.
           MOVE "00"           TO SCREEN-STATUS.
           MOVE SCREEN-DATA    TO DISPLAY-REC.
           WRITE DISPLAY-REC   FORMAT IS SCREEN-NAME
                               INDIC ARE SCREEN-INDICATORS.
           IF SCREEN-STATUS NOT = "00"
               DISPLAY "SCREEN WRITE ERROR, STATUS=" SCREEN-STATUS
               GO TO 2-EOJ.

           READ DISPLAY-FILE   FORMAT IS SCREEN-NAME
                               INDIC ARE SCREEN-INDICATORS.
           IF SCREEN-STATUS NOT = "00"
               DISPLAY "SCREEN READ ERROR, STATUS=" SCREEN-STATUS
               GO TO 2-EOJ.

           MOVE ALL B"0"       TO SCREEN-INDICATORS.
           MOVE DISPLAY-REC    TO SCREEN-DATA.

           IF KEY-HIT = 3 OR 8
               GO TO 2-EOJ.

           IF KEY-HIT NOT = 0
               GO TO SHOWFORM-SELECTION.

           IF SPACES = SEL-WO AND SEL-EQUIP
               GO TO SHOWFORM-SELECTION.

           IF SEL-DATE-2 = "DD"
               MOVE SPACES     TO SEL-EQUIP
               GO TO SORT-IT.

           IF SEL-WO NOT = SPACES
               MOVE " "        TO RETURN-COD
               CALL "TALWONO" USING SEL-WO RETURN-COD
               IF RET-CODE = "1"
      **********************************************************************
      **    MESSAGE 035/040:
      ** INVALID WORKORDER NUMBER
      **********************************************************************
                   MOVE  35    TO CATREAD-MSG-SET
                   MOVE  40    TO CATREAD-MSG-NUM
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE   1    TO FIELD-NUMBER
                   PERFORM 65-ERROR
                   GO TO SHOWFORM-SELECTION
               ELSE
               IF SEL-WO-SUF = "   "
                   MOVE "000"  TO SEL-WO-SUF
               END-IF
               MOVE SEL-WO     TO WONUM OF WO-PLANNED
               READ WO-PLANNED INTO WO-PLANNED-DATA
                   INVALID KEY MOVE FILE-STAT TO FILE-STAT
               END-READ
               IF FILE-STAT NOT = "00"
      **********************************************************************
      **    MESSAGE 035/040:
      ** INVALID WORKORDER NUMBER
      **********************************************************************
                   MOVE  35    TO CATREAD-MSG-SET
                   MOVE  40    TO CATREAD-MSG-NUM
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE   1    TO FIELD-NUMBER
                   PERFORM 65-ERROR
                   GO TO SHOWFORM-SELECTION
               ELSE
                   MOVE EQUIP-NUM-P TO SEL-EQUIP.

           IF SEL-EQUIP NOT = SPACES
               MOVE SEL-EQUIP  TO EQPNUM OF EQP-EQUIPMENT
               READ EQP-EQUIPMENT INTO EQUIPMENT-DATA
                   INVALID KEY MOVE FILE-STAT TO FILE-STAT
               END-READ
               IF FILE-STAT NOT = "00"
      **********************************************************************
      **    MESSAGE 035/004:
      ** INVALID EQUIPMENT NUMBER
      **********************************************************************
                   MOVE  35    TO CATREAD-MSG-SET
                   MOVE   4    TO CATREAD-MSG-NUM
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE   2    TO FIELD-NUMBER
                   PERFORM 65-ERROR
                   GO TO SHOWFORM-SELECTION.

       SORT-IT.
           MOVE 0              TO ACT-KEY.
           SORT SORT-FILE      ASCENDING KEY SORT-WO-NUM
                                             SORT-AUD-DATE
                                             SORT-AUD-TIME
               INPUT PROCEDURE  SORT-AUDIT
               OUTPUT PROCEDURE SORT-OUT.

           IF MAX-KEY = 0
      **********************************************************************
      **    MESSAGE 040/011:
      ** NO RECORDS FOUND WHICH MATCH YOUR SELECTION
      **********************************************************************
               MOVE   40       TO CATREAD-MSG-SET
               MOVE   11       TO CATREAD-MSG-NUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE 1          TO FIELD-NUMBER
               PERFORM 65-ERROR
               GO TO SHOWFORM-SELECTION.

           MOVE 0              TO ACT-KEY.
           MOVE "N"            TO EOF-SW.
           OPEN INPUT          OUT-FILE.

           IF SEL-PRINT = "Y"
      *        MOVE 0          TO OVRPRTF-TOFILE-NUM PAGE-NO
               MOVE 0          TO PAGE-NO
               MOVE "P "       TO OVRPRTF-TOFILE-NUM-X
               MOVE 60         TO LINE-CTR
               MOVE SEL-EQUIP  TO PRT-EQUIP
               MOVE "MCPRT"    TO OVRPRTF-FILE
               PERFORM 996-OVERRIDE-PRINT-FILE
               OPEN OUTPUT     PRINT-FILE
               PERFORM PRINT-RECORD THRU PRINT-RECORD-EXIT
               CLOSE           PRINT-FILE
               CLOSE           OUT-FILE
               GO TO SELECTION-CRITERIA.

       RESET-SCREEN.
           MOVE "VPMTRACK"     TO SCREEN-NAME.
           MOVE SPACES         TO RPT-SCREEN-DATA.
           MOVE SPACES         TO MESSAGE-BUFFER.
           MOVE SEL-EQUIP      TO RPT-EQUIP.
           MOVE "N"            TO SCREEN-FILLED.
           MOVE 0              TO SUB.

           PERFORM FILL-SCREEN THRU FILL-SCREEN-EXIT
                               UNTIL SCREEN-FILLED = "Y"
                               OR EOF-SW = "Y".

       SHOWFORM.
           MOVE "00"           TO SCREEN-STATUS.
           MOVE RPT-SCREEN-DATA TO DISPLAY-REC.

           WRITE DISPLAY-REC   FORMAT IS SCREEN-NAME
                               INDIC ARE SCREEN-INDICATORS.
           IF SCREEN-STATUS NOT = "00"
               DISPLAY "SCREEN WRITE ERROR, STATUS=" SCREEN-STATUS
               GO TO SELECTION-CRITERIA.

           READ DISPLAY-FILE   FORMAT IS SCREEN-NAME
                               INDIC ARE SCREEN-INDICATORS.
           IF SCREEN-STATUS NOT = "00"
               DISPLAY "SCREEN READ ERROR, STATUS=" SCREEN-STATUS
               GO TO SELECTION-CRITERIA.

           MOVE ALL B"0"       TO SCREEN-INDICATORS.
           MOVE DISPLAY-REC    TO RPT-SCREEN-DATA.

           IF KEY-HIT = 3 OR 8
               CLOSE           OUT-FILE
               GO TO 2-EOJ.

           IF KEY-HIT = 1
               CLOSE           OUT-FILE
               GO TO SELECTION-CRITERIA.

           IF KEY-HIT = 4
               MOVE ACT-KEY    TO SAVE-KEY
               SUBTRACT SUB    FROM SAVE-KEY
               SUBTRACT 15     FROM SAVE-KEY
               IF SAVE-KEY < 0
                   MOVE 0      TO SAVE-KEY
               END-IF
               MOVE SAVE-KEY   TO ACT-KEY
               MOVE "N"        TO EOF-SW
               GO TO RESET-SCREEN.

           IF KEY-HIT = 5
               MOVE 0          TO KEY-HIT.

           MOVE 0              TO SUB.
           PERFORM WO-DISPLAY-SEARCH
                               UNTIL SUB > 15.

           IF EOF-SW = "Y"
               MOVE 0          TO ACT-KEY
               MOVE "N"        TO EOF-SW.

           GO TO RESET-SCREEN.

       FILL-SCREEN.
           ADD 1               TO SUB ACT-KEY.
           IF ACT-KEY > MAX-KEY
               MOVE "Y"        TO EOF-SW
               SUBTRACT 1      FROM ACT-KEY
               GO TO FILL-SCREEN-EXIT.

           IF SUB > MAX-LINES
               MOVE "Y"        TO SCREEN-FILLED
               SUBTRACT 1      FROM ACT-KEY
               GO TO FILL-SCREEN-EXIT.

           MOVE SPACES         TO OUT-REC.
           READ OUT-FILE       INVALID KEY
               MOVE "Y"        TO EOF-SW
               GO TO FILL-SCREEN-EXIT.

           MOVE OUT-AUD-YYYY   TO L-YY.
           MOVE OUT-AUD-MM     TO L-MM.
           MOVE OUT-AUD-DD     TO L-DD.
           MOVE "/"            TO SLASH1 SLASH2.
           MOVE OUT-AUD-HH     TO L-HH.
           MOVE OUT-AUD-MN     TO L-MN.
           MOVE ":"            TO COLON1.
           MOVE "-"            TO DASH1.
           MOVE OUT-WO-NUM     TO L-WO.
           MOVE OUT-LEVEL      TO L-LEVEL.
           MOVE OUT-WOSTAT     TO L-STATUS.
           MOVE OUT-DESC       TO L-DESC.
           MOVE LINE-DATA      TO RPT-DATA(SUB).

       FILL-SCREEN-EXIT.    EXIT.

       PRINT-RECORD.
           IF LINE-CTR > 54
               PERFORM PRINT-HEADINGS.

           ADD 1               TO ACT-KEY.
           MOVE SPACES         TO OUT-REC PRT-REC.
           READ OUT-FILE       INVALID KEY
               MOVE "Y"        TO EOF-SW
               GO TO PRINT-RECORD-EXIT.

           MOVE OUT-AUD-YYYY   TO PRT-YY.
           MOVE OUT-AUD-MM     TO PRT-MM.
           MOVE OUT-AUD-DD     TO PRT-DD.
           MOVE "/"            TO SLASH3 SLASH4.
           MOVE OUT-AUD-HH     TO PRT-HH.
           MOVE OUT-AUD-MN     TO PRT-MN.
           MOVE ":"            TO COLON2.
           MOVE "-"            TO DASH2.
           MOVE OUT-WO-NUM     TO PRT-WO.
           MOVE OUT-LEVEL      TO PRT-LEVEL.
           MOVE OUT-WOSTAT     TO PRT-STATUS.
           MOVE OUT-DESC       TO PRT-DESC.
           MOVE PRINT-DATA     TO PRT-REC.
           WRITE PRINT-REC     AFTER ADVANCING 1 LINE.
           ADD 1               TO LINE-CTR.
           GO TO PRINT-RECORD.

       PRINT-RECORD-EXIT.   EXIT.

       PRINT-HEADINGS.
           ADD  1              TO PAGE-NO.
           MOVE PAGE-NO        TO PAGENO.
           MOVE SPACES         TO PRT-REC.
           MOVE DATE-LINE      TO PRT-REC.
           WRITE PRINT-REC     AFTER ADVANCING NEW-PAGE.
           MOVE SPACES         TO PRT-REC.
           MOVE HEADING-DOTS   TO PRT-REC.
           WRITE               PRINT-REC.
           MOVE SPACES         TO PRT-REC.
           MOVE HEADING-1      TO PRT-REC.
           WRITE               PRINT-REC.
           MOVE SPACES         TO PRT-REC.
           MOVE HEADING-DOTS   TO PRT-REC.
           WRITE               PRINT-REC.
           MOVE SPACES         TO PRT-REC.
           MOVE HEADING-2      TO PRT-REC.
           WRITE               PRINT-REC.
           MOVE SPACES         TO PRT-REC.
           MOVE HEADING-DASHES TO PRT-REC.
           WRITE               PRINT-REC.
           MOVE 6              TO LINE-CTR.

       WO-DISPLAY-SEARCH.
           ADD 1               TO SUB.
           MOVE RPT-DATA(SUB)  TO LINE-DATA.
           IF L-IN NOT = SPACES
               MOVE " "        TO L-IN
               IF L-DATE NOT = SPACES
                   PERFORM DISPLAY-WO.

       DISPLAY-WO.
           MOVE L-WO           TO WONUM OF WO-PLANNED.
           READ WO-PLANNED     INTO WO-PLANNED-DATA
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
               NEXT SENTENCE
           ELSE
           MOVE SPACES         TO MESSAGE-BUFFER WO-BASIC-DATA
           CALL "TDISPWO"      USING DBPARAMETERS
                               WO-BASIC-DATA
                               WO-PLANNED-DATA
                               FILE-SW.

       65-ERROR.
           MOVE TRUE-VAL       TO IND(FIELD-NUMBER) IND(99).
           MOVE MESSAGE-BUFFER TO ERRMSG.

       2-EOJ.
           CLOSE               PM-AUDIT-WO.
           CLOSE               PM-AUDIT-EQUIP.
           CLOSE               PM-AUDIT-DATE.
           CLOSE               EQP-EQUIPMENT.
           CLOSE               WO-PLANNED.
           CLOSE               DISPLAY-FILE.
           CLOSE               OUT-FILE.
           GOBACK.

           COPY OVRPFCALL      IN COPYLIB.

       999-CATREAD.
           MOVE SPACES         TO MESSAGE-BUFFER.
           CALL "CCATREAD"     USING CATREAD-PARMS.
           MOVE CATREAD-MSG-TEXT TO MESSAGE-BUFFER.

       999-CATREAD-EXIT.       EXIT.

       SORT-AUDIT              SECTION 02.

       BEGIN-SORT-AUDIT.
           PERFORM SORT-MAIN   THRU SORT-MAIN-X.
           GO TO SORT-AUDIT-EXIT.

       SORT-MAIN.
           IF SEL-DATE-2 = "DD"
               PERFORM READ-BY-DATE THRU READ-BY-DATE-EXIT
           ELSE
           IF SEL-WO NOT = SPACES
               PERFORM READ-BY-WO THRU READ-BY-WO-EXIT
           ELSE
               PERFORM READ-BY-EQUIP THRU READ-BY-EQUIP-EXIT.

       SORT-MAIN-X.            EXIT.

       READ-BY-WO.
           MOVE SEL-WO         TO WONUM OF PM-AUDIT-WO.
           START PM-AUDIT-WO   KEY NOT LESS THAN WONUM OF PM-AUDIT-WO
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
               GO TO READ-BY-WO-EXIT.

       READ-BY-WO-LOOP.
           READ PM-AUDIT-WO    NEXT INTO AUDIT-DATA
               AT END          MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT = "10" OR "14" OR "46"
               GO TO READ-BY-WO-EXIT
           ELSE
           IF FILE-STAT NOT = "00"
               MOVE "READ NEXT PM-AUDIT-WO" TO DB-TYPE
               MOVE FILE-STAT  TO CON-WORD
               MOVE DB-ERROR   TO MESSAGE-BUFFER
               MOVE 1          TO FIELD-NUMBER
               PERFORM 65-ERROR
               GO TO SHOWFORM-SELECTION.

           IF AUDIT-WO-7 NOT = SEL-WO-7
               GO TO READ-BY-WO-EXIT.

           IF SEL-WO-SUF NOT = "000"
               IF AUDIT-WO-NUM NOT = SEL-WO
                   GO TO READ-BY-WO-EXIT.

           PERFORM RELEASE-SORT-REC THRU RELEASE-SORT-REC-EXIT.
           GO TO READ-BY-WO-LOOP.

       READ-BY-WO-EXIT.        EXIT.

       READ-BY-EQUIP.
           MOVE SEL-EQUIP      TO PMEQPNUM OF PM-AUDIT-EQUIP.
           START PM-AUDIT-EQUIP KEY = PMEQPNUM OF PM-AUDIT-EQUIP
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
               GO TO READ-BY-EQUIP-EXIT.

       READ-BY-EQUIP-LOOP.
           READ PM-AUDIT-EQUIP NEXT INTO AUDIT-DATA
               AT END          MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT = "10" OR "14" OR "46"
               GO TO READ-BY-EQUIP-EXIT
           ELSE
           IF FILE-STAT NOT = "00"
               MOVE "READ NEXT PM-AUDIT-EQUIP" TO DB-TYPE
               MOVE FILE-STAT  TO CON-WORD
               MOVE DB-ERROR   TO MESSAGE-BUFFER
               MOVE 1          TO FIELD-NUMBER
               PERFORM 65-ERROR
               GO TO SHOWFORM-SELECTION.

           IF AUDIT-EQUIP-NUM NOT = SEL-EQUIP
               GO TO READ-BY-EQUIP-EXIT.

           PERFORM RELEASE-SORT-REC THRU RELEASE-SORT-REC-EXIT.
           GO TO READ-BY-EQUIP-LOOP.

       READ-BY-EQUIP-EXIT.     EXIT.

       READ-BY-DATE.
           MOVE SEL-DATE-8     TO AUDITDATE OF PM-AUDIT-DATE.
           START PM-AUDIT-DATE KEY NOT LESS THAN
                               AUDITDATE OF PM-AUDIT-DATE
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
               GO TO READ-BY-DATE-EXIT.

       READ-BY-DATE-LOOP.
           READ PM-AUDIT-DATE  NEXT INTO AUDIT-DATA
               AT END          MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT = "10" OR "14" OR "46"
               GO TO READ-BY-DATE-EXIT
           ELSE
           IF FILE-STAT NOT = "00"
               MOVE "READ NEXT PM-AUDIT-DATE" TO DB-TYPE
               MOVE FILE-STAT  TO CON-WORD
               MOVE DB-ERROR   TO MESSAGE-BUFFER
               MOVE 1          TO FIELD-NUMBER
               PERFORM 65-ERROR
               GO TO SHOWFORM-SELECTION.

           IF AUDIT-DATE NOT = SEL-DATE-8
               GO TO READ-BY-DATE-EXIT.

           PERFORM RELEASE-SORT-REC THRU RELEASE-SORT-REC-EXIT.
           GO TO READ-BY-DATE-LOOP.

       READ-BY-DATE-EXIT.      EXIT.

       RELEASE-SORT-REC.
           MOVE SPACES          TO SORT-REC.
           MOVE AUDIT-DATE      TO SORT-AUD-DATE.
           MOVE AUDIT-TIME      TO SORT-AUD-TIME.
           MOVE AUDIT-TRANS     TO SORT-TRANS.
           MOVE AUDIT-EQUIP-NUM TO SORT-EQUIP-NUM.
           MOVE AUDIT-WO-NUM    TO SORT-WO-NUM.
           MOVE AUDIT-WO-STATUS TO SORT-WOSTAT.
           MOVE AUDIT-PM-LEVEL  TO SORT-LEVEL.
           MOVE AUDIT-DESC      TO SORT-DESC.
           RELEASE              SORT-REC.

       RELEASE-SORT-REC-EXIT.  EXIT.

       SORT-AUDIT-EXIT.        EXIT.

       SORT-OUT                SECTION 03.
       SORT-OUT-PARAGRAPH.
           OPEN OUTPUT         OUT-FILE.
           MOVE 0              TO ACT-KEY.

       BEGIN-SORT-OUT.
           RETURN SORT-FILE
               AT END          CLOSE OUT-FILE
               MOVE ACT-KEY    TO MAX-KEY
               GO TO SORT-OUT-EXIT.
           ADD 1               TO ACT-KEY.
           MOVE SORT-REC       TO OUT-REC
           WRITE OUT-REC       INVALID KEY
               DISPLAY "WRITE OUT-REC ERROR"
               DISPLAY "ACTUAL KEY = " ACT-KEY
               GO TO 2-EOJ.
           GO TO BEGIN-SORT-OUT.

       SORT-OUT-EXIT.          EXIT.

