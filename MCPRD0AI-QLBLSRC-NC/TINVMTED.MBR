       COPY MPLT0    IN COPYLIB.
       COPY MPLTP01  IN COPYLIB.
       COPY MPLTPTX1 IN COPYLIB.

       COPY DINVRCD  IN COPYLIB.

      *************************************************************
      **                                                         **
      **                    W O R K   A R E A                    **
      **                                                         **
      *************************************************************

       01  SELECT-MFEST-MONTH          PIC X VALUE SPACES.

       01  CREDIT-TO-AP                PIC S9(11)V9(2) VALUE ZEROS.

       01  MONTH-END-TOTALS.
           05  TOTAL-ACCOUNTS-PAY      PIC S9(11)V9(2) VALUE ZEROS.
           05  TOTAL-STAT-TAX          PIC S9(11)V9(2) VALUE ZEROS.
           05  TOTAL-IT-TAX            PIC S9(11)V9(2) VALUE ZEROS.
           05  TOTAL-CE9               PIC S9(11)V9(2) VALUE ZEROS.
           05  TOTAL-COLLECT-FREIGHT   PIC S9(11)V9(2) VALUE ZEROS.
           05  TOTAL-GEN-LEDGER        PIC S9(11)V9(2) VALUE ZEROS.
           05  TOTAL-ATAX-BAL          PIC S9(11)V9(2) VALUE ZEROS.
           05  TOTAL-GEN-LEDGER-BAL    PIC S9(11)V9(2) VALUE ZEROS.

       01  TAX-CODE-TABLE.
           05  TCT-ENTRY   OCCURS 100 TIMES INDEXED BY TCT-X.
               10  TCT-TAX-CODE            PIC XX.
               10  TCT-CATEGORY-1          PIC S9(11)V9(2).
               10  TCT-CATEGORY-2          PIC S9(11)V9(2).
               10  TCT-CATEGORY-3          PIC S9(11)V9(2).
               10  TCT-CATEGORY-4          PIC S9(11)V9(2).

       01  ACCRUED-TAX.
           05  ACCRUED-TAX-ENTRIES OCCURS 4 TIMES.
               10  ACCRUED-TAX-AMOUNT     PIC S9(11)V9(2).
               10  ACCRUED-TAX-IT-AMOUNT  PIC S9(11)V9(2).
               10  ACCRUED-TAX-DISTRICT   PIC X(15).
               10  ACCRUED-TAX-CE-ACCT    PIC X(9).
               10  ACCRUED-TAX-VOLUME     PIC S9(11)V9(2).

0792CK 01  TOTAL-TAX-PAID                 PIC S9(12)V99.
0792CK 01  TOTAL-GST-PAID                 PIC S9(12)V99.

       01  COMPANY-SAVE              PIC X(3)     VALUE SPACE.

      *PARMS FOR CALL TO THDPRT2 - HEADER PAGE SUBPROGRAM
       01  HD-RET-CODE               PIC S9(4)    COMP-4 VALUE 0.
       01  HD-FILE-NAME              PIC X(17)    VALUE SPACES.
       01  FNUM                      PIC S9(4)    COMP-4 VALUE 0.

       COPY TDATECHK IN COPYLIB.

       COPY TBLOWUP  IN COPYLIB.

       COPY OVRPFDATA IN COPYLIB.

       COPY CCHKOBJ   IN COPYLIB.

       LINKAGE SECTION.

       COPY THDPRTB   IN COPYLIB.

       01  SELECTED-MONTH-YEAR.
           05  SELECTED-MONTH.
               10  FILLER              PIC X.
               10  MONTH-SECOND-DIG    PIC X.
           05  SELECTED-YEAR           PIC X(2).
           05  FILLER                  PIC X(108).

       PROCEDURE DIVISION USING HD-ROUTE-DATA, SELECTED-MONTH-YEAR.
       BEGIN-PGM.
           PERFORM  1-HSK  THRU  1-HSK-X.
           PERFORM  6-MAIN  THRU  6-MAIN-X.
           PERFORM  2-CLOSE-FILES  THRU  2-CLOSE-FILES-X.

           GOBACK.

       1-HSK.
9406CK     MOVE "C" TO SCOPE.
9406CK     CALL "MCXCBLERR" USING SCOPE.

           CALL "TESCSEQ" USING ESC-NAME.
           MOVE CHAR-1636PI TO COMPRESS-PRINT.
           MOVE CHAR-10PI   TO NORMAL-PRINT.

           OPEN INPUT MPLTINFO-PK-I.
           OPEN INPUT DINVRCD-RG-I.

           MOVE "P 01"  TO  PLT-ARG.
           PERFORM 9999-GETKEY-MPLTINFO-PK-I.
           MOVE MPLTINFO-COMPANY  TO  COMPANY-SAVE.

           MOVE 1  TO  DATE-MODE.
           CALL "TDATECHK" USING DATE-CHECK-AREA.
           MOVE DATE-SLASH-OUT  TO  PRT-DATE.
           MOVE DATE-FORMATTED-TIME-OUT  TO  PRT-TIME.

       1-HSK-X.
           EXIT.

       2-CLOSE-FILES.

           CLOSE MPLTINFO-PK-I.
           CLOSE DINVRCD-RG-I.

       2-CLOSE-FILES-X.
           EXIT.

      ******************************************************
      **                                                  **
      **   BLOWUP ROUTINE                                 **
      **                                                  **
      ******************************************************

       2100-BLOWUP.
           MOVE "TINVMTED"              TO  BU-PGM-NAME.
           CALL "TBLOWUP" USING BASE, BU-PGM-NAME, STATUS-AREA,
               DUMMY-VIEW-AREA, FILE-STATUS, BU-DISPLAY-MSG,
                   BU-DISPLAY-FLDS.


       6-MAIN.
           PERFORM 60-ACCEPT-OPTIONS  THRU  60-ACCEPT-OPTIONS-X.

0792CK     INITIALIZE  ACCRUED-TAX  TOTAL-TAX-PAID  TOTAL-GST-PAID.

           MOVE HIGH-VALUES TO TAX-CODE-TABLE.

           PERFORM 61-ACCUMULATE-MONTH-END-TOTALS  THRU  61-AMET-X.

           PERFORM 62-PRINT-SUMMARY-REPORTS  THRU  62-PSR-X.

       6-MAIN-X.
           EXIT.



       60-ACCEPT-OPTIONS.
           DISPLAY "HD ROUTE DATA = ", HD-ROUTE-DATA.
           DISPLAY "SELECTED MONTH = ", SELECTED-MONTH.
           DISPLAY "SELECTED YEAR = ", SELECTED-YEAR.
           IF SELECTED-MONTH = "10"
               MOVE "O"                TO  SELECT-MFEST-MONTH
           ELSE
           IF SELECTED-MONTH = "11"
               MOVE "N"                TO  SELECT-MFEST-MONTH
           ELSE
           IF SELECTED-MONTH = "12"
               MOVE "D"                TO  SELECT-MFEST-MONTH
           ELSE
               MOVE MONTH-SECOND-DIG   TO  SELECT-MFEST-MONTH.

       60-ACCEPT-OPTIONS-X.
           EXIT.

      ***********************************************************
      **                                                       **
      **    GET INVOICES NEEDED FOR MONTH END TOTAL AND        **
      **    ACCUMULATE TOTALS                                  **
      **                                                       **
      ***********************************************************

       61-ACCUMULATE-MONTH-END-TOTALS.
           PERFORM 9999-GETSER-DINVRCD-RG-I.
           IF END-OF-FILE
               GO TO 61-AMET-X.

           IF INV-MFEST-PREFIX = SELECT-MFEST-MONTH  AND
              INV-MFEST-YY = SELECTED-YEAR
               NEXT SENTENCE
           ELSE
               GO TO 61-ACCUMULATE-MONTH-END-TOTALS.

           PERFORM 64-GET-TAX-CODE-RPT THRU 64-GTCR-X.

0792CK
  .   *----ADDED FOR VALLEFIELD ONLY.
  .        IF COMPANY-SAVE = "629"
  .           ADD INV-ADD-TAX TO TOTAL-TAX-PAID
0792CK        ADD INV-ADD-GST TO TOTAL-GST-PAID.

           IF INV-NO-CHECK-INDIC = SPACES
               MOVE "N" TO NO-CHECK-SW
           ELSE
               MOVE "Y" TO NO-CHECK-SW
               MOVE ZEROS   TO SUB
               GO TO 61-ADD-ATAX-LOOP.

           ADD INV-NET-DUE-VENDOR           TO TOTAL-ACCOUNTS-PAY,
                                               TOTAL-GEN-LEDGER.
           MULTIPLY CE9-CASH-DSCNT  BY  -1  GIVING CE9-CASH-DSCNT.
           ADD CE9-CASH-DSCNT               TO TOTAL-CE9,
                                               TOTAL-GEN-LEDGER.
           ADD INV-TOTAL-CFRT               TO TOTAL-COLLECT-FREIGHT.

           MOVE ZEROS  TO  SUB.

       61-ADD-ATAX-LOOP.
           ADD 1  TO  SUB.
           IF SUB > 4
               GO TO 61-ACCUMULATE-MONTH-END-TOTALS.

           IF SUB = 1
               IF COMPANY-SAVE = "129"
                   IF INV-TAX-CODE = "9"
                       IF NOT NO-CHECK-INV
                           ADD INV-ATAX-AMT (SUB)
                              TO ACCRUED-TAX-AMOUNT (4), TOTAL-STAT-TAX,
                                 TOTAL-GEN-LEDGER
                           GO TO 61-ADD-ATAX-LOOP
                       ELSE
                           ADD INV-ATAX-AMT (SUB)
                              TO ACCRUED-TAX-IT-AMOUNT (4), TOTAL-IT-TAX,
                                 TOTAL-GEN-LEDGER
                           GO TO 61-ADD-ATAX-LOOP.
           IF NOT NO-CHECK-INV
               ADD INV-ATAX-AMT (SUB)  TO  ACCRUED-TAX-AMOUNT (SUB),
                                           TOTAL-STAT-TAX,
                                           TOTAL-GEN-LEDGER
           ELSE
               ADD INV-ATAX-AMT (SUB)  TO  ACCRUED-TAX-IT-AMOUNT (SUB),
                                           TOTAL-IT-TAX,
                                           TOTAL-GEN-LEDGER.
           IF COMPANY-SAVE = "129"
               IF SUB = 3
                   IF NOT NO-CHECK-INV
                       IF INV-ATAX-AMT (3) NOT = ZEROS
                           IF INV-PAYMENT-IND = "P"
                               ADD INV-P-MATL-EXT  TO
                                   ACCRUED-TAX-VOLUME (3)
                           ELSE
                               ADD INV-I-MATL-EXT  TO
                                   ACCRUED-TAX-VOLUME (3).

           GO TO 61-ADD-ATAX-LOOP.

       61-AMET-X.
           EXIT.

      **********************************************************
      **                                                      **
      **    PRINT REPORTS                                     **
      **                                                      **
      **********************************************************

       62-PRINT-SUMMARY-REPORTS.
           MOVE HD-SPOOLER-NUMBER       TO  OVRPRTF-TOFILE-NUM.
           MOVE "*YES"                  TO  OVRPRTF-SHARED.
           MOVE HD-NO-OF-COPIES         TO  OVRPRTF-COPIES.
           MOVE "MCPRT"                 TO  OVRPRTF-FILE.
           PERFORM 996-OVERRIDE-PRINT-FILE.

           OPEN OUTPUT PRINT-FILE.
           MOVE "DHDR14.PUB"       TO  HD-FILE-NAME.
           CALL "THDPRT2" USING HD-RET-CODE, HD-FILE-NAME, FNUM
                HD-ROUTE-DATA, ESC-NAME.
           IF HD-RET-CODE NOT = 0
               MOVE "THDPRT2 ERR 62-PSR" TO BU-DISPLAY-MSG
               MOVE HD-RET-CODE       TO BU-DISPLAY-FLD (1)
               GO TO 2100-BLOWUP.

      ***********************************************************
      **   IF PRINTING ON A CHARACTER PRINTER (HD-PAPER-FLAG   **
      **   NOT = "X"), WE USE COMPRESSED PRINT TO FIT 132      **
      **   CHARACTERS ON 8.5 IN WIDE PAPER.  ALSO, IF CP, WE   **
      **   CHANGE THE TEXT LENGTH TO 61 LINES.                 **
      ***********************************************************

           IF PAPER-IS-132-COLS
               NEXT SENTENCE
           ELSE
               WRITE PRINT-REC FROM COMPRESS-PRINT AFTER ADVANCING 0.

           MOVE SELECTED-MONTH     TO  MONTH-OUT.
           MOVE SELECTED-YEAR      TO  YEAR-OUT.
           MOVE "TAX REPORT"       TO  HEADER-LIT.
           MOVE 1                  TO  PAGE-CTR,
                                       PAGE-OUT.
           MOVE HEADER1            TO  PRINT-REC.
           WRITE PRINT-REC AFTER ADVANCING NEW-PAGE.
           MOVE DASH-LINE  TO  PRINT-REC.
           WRITE PRINT-REC AFTER ADVANCING 1 LINES.
           MOVE DETAIL1-LINE1      TO  PRINT-REC.
           WRITE PRINT-REC AFTER ADVANCING 5 LINES.
           PERFORM 622-GET-TAX-DISTRICTS  THRU  622-GTD-X.
           MOVE ZEROS              TO  SUB.

       62-WRITE-TAX-DETAILS.
           ADD 1  TO  SUB.
           IF SUB > 4
               GO TO 62-WRITE-TAX-REPORT-TOTAL.
           IF COMPANY-SAVE = "129"
               IF SUB = 4
                   MOVE "STATE UTILITY" TO ACCRUED-TAX-DISTRICT (SUB).

           IF ACCRUED-TAX-DISTRICT (SUB) = SPACES
               GO TO 62-WRITE-TAX-DETAILS.
           MOVE SPACES                   TO  DETAIL1-LINE2.
           MOVE ACCRUED-TAX-AMOUNT (SUB) TO  ATAX-OUT.
           MOVE ACCRUED-TAX-IT-AMOUNT (SUB) TO  ATAX-IT-OUT.
           MOVE ACCRUED-TAX-DISTRICT (SUB)  TO  ATAX-DIST.
           MOVE ACCRUED-TAX-CE-ACCT (SUB)  TO  ATAX-ACCT.
           IF COMPANY-SAVE = "129"
               IF SUB = 3
                   MOVE ACCRUED-TAX-VOLUME (SUB) TO ATAX-VOL-OUT
                   MOVE "TAX VOLUME"             TO ATAX-VOL-LIT-OUT.
           ADD ACCRUED-TAX-AMOUNT (SUB), ACCRUED-TAX-IT-AMOUNT (SUB)
                                          TO  TOTAL-ATAX-BAL.
           MOVE DETAIL1-LINE2             TO  PRINT-REC.
           WRITE PRINT-REC AFTER ADVANCING 2 LINES.
           GO TO 62-WRITE-TAX-DETAILS.

       62-WRITE-TAX-REPORT-TOTAL.
           MOVE DETAIL1-LINE6             TO  PRINT-REC.
           WRITE PRINT-REC AFTER ADVANCING 2 LINES.
           MOVE TOTAL-STAT-TAX            TO  TOT-ATAX-OUT.
           MOVE DETAIL1-LINE3             TO  PRINT-REC.
           WRITE PRINT-REC AFTER ADVANCING 2 LINES.
           MOVE TOTAL-IT-TAX              TO  TOT-IT-OUT.
           MOVE DETAIL1-LINE3B            TO  PRINT-REC.
           WRITE PRINT-REC AFTER ADVANCING 1 LINES.
           MOVE TOTAL-ATAX-BAL            TO  BAL-ATAX-OUT.
           MOVE DETAIL1-LINE4             TO  PRINT-REC.
           WRITE PRINT-REC AFTER ADVANCING 2 LINES.
           IF TOTAL-STAT-TAX NOT = TOTAL-ATAX-BAL
               MOVE OUT-BALANCE-MSG       TO  PRINT-REC
               WRITE PRINT-REC AFTER ADVANCING 2 LINES
               WRITE PRINT-REC AFTER ADVANCING 2 LINES.
0792CK
  .   *----THE FOLLOWING IF STATEMENT PRINTS OUT THE AMOUNT OF QST/TVQ
  .   *----FOR VALLEYFIELD. THIS STATEMENT WILL ONLY WORK FOR VALLEYFIELD.
  .
  .        IF COMPANY-SAVE = "629"
  .           WRITE PRINT-REC FROM DETAIL1-LINE7
  .              AFTER ADVANCING 10 LINES
  .           SUBTRACT TOTAL-GST-PAID FROM TOTAL-TAX-PAID
  .              GIVING DTL1-8-TAX-PAID
  .           MOVE "    QST/TVQ    " TO DTL1-8-TAX-NAME
  .           WRITE PRINT-REC FROM DETAIL1-LINE8
  .              AFTER ADVANCING 2 LINES
  .           MOVE TOTAL-GST-PAID TO DTL1-8-TAX-PAID
  .           MOVE "      GST      " TO DTL1-8-TAX-NAME
  .           WRITE PRINT-REC FROM DETAIL1-LINE8
  .              AFTER ADVANCING 2 LINES
  .           MOVE TOTAL-TAX-PAID TO DTL1-8-TAX-PAID
  .           MOVE "     TOTAL     " TO DTL1-8-TAX-NAME
  .           WRITE PRINT-REC FROM DETAIL1-LINE8
0792CK           AFTER ADVANCING 2 LINES.

       62-WRITE-MONTH-END-REPORT.
           ADD 1  TO  PAGE-CTR.
           MOVE PAGE-CTR                  TO  PAGE-OUT.
           MOVE "PAYMENTS"                TO  HEADER-LIT.
           MOVE HEADER1                   TO  PRINT-REC.
           WRITE PRINT-REC AFTER ADVANCING NEW-PAGE.
           MOVE DASH-LINE                 TO  PRINT-REC.
           WRITE PRINT-REC AFTER ADVANCING 2 LINES.
           MOVE TOTAL-ACCOUNTS-PAY        TO  CREDIT-TO-AP-OUT.
           ADD TOTAL-ACCOUNTS-PAY         TO  TOTAL-GEN-LEDGER-BAL.
           MOVE DETAIL2-LINE1             TO  PRINT-REC.
           WRITE PRINT-REC AFTER ADVANCING 4 LINES.
           MOVE TOTAL-STAT-TAX            TO  TOT-STAT-TAX-OUT.
           ADD TOTAL-STAT-TAX             TO  TOTAL-GEN-LEDGER-BAL.
           MOVE DETAIL2-LINE2             TO  PRINT-REC.
           WRITE PRINT-REC AFTER ADVANCING 2 LINES.
           MOVE TOTAL-IT-TAX              TO  TOT-IT-TAX-OUT.
           ADD TOTAL-IT-TAX               TO  TOTAL-GEN-LEDGER-BAL.
           MOVE DETAIL2-LINE2B            TO  PRINT-REC.
           WRITE PRINT-REC AFTER ADVANCING 1 LINES.
           MOVE TOTAL-CE9                 TO  TOT-CE9-OUT.
           ADD TOTAL-CE9                  TO  TOTAL-GEN-LEDGER-BAL.
           MOVE DETAIL2-LINE3             TO  PRINT-REC.
           WRITE PRINT-REC AFTER ADVANCING 2 LINES.
           MOVE DETAIL2-LINE7             TO  PRINT-REC.
           WRITE PRINT-REC AFTER ADVANCING 2 LINES.
           MOVE TOTAL-GEN-LEDGER          TO  TOT-GEN-LEDGER-OUT.
           MOVE DETAIL2-LINE4             TO  PRINT-REC.
           WRITE PRINT-REC AFTER ADVANCING 2 LINES.
           MOVE TOTAL-GEN-LEDGER-BAL      TO  TOT-GEN-CONTROL-OUT.
           MOVE DETAIL2-LINE5             TO  PRINT-REC.
           WRITE PRINT-REC AFTER ADVANCING 2 LINES.
           MOVE TOTAL-COLLECT-FREIGHT     TO  TOT-COLLECT-FRT-OUT.
           MOVE DETAIL2-LINE6             TO  PRINT-REC.
           WRITE PRINT-REC AFTER ADVANCING 2 LINES.
           IF TOTAL-GEN-LEDGER NOT = TOTAL-GEN-LEDGER-BAL
               MOVE OUT-BALANCE-MSG       TO  PRINT-REC
               WRITE PRINT-REC AFTER ADVANCING 2 LINES
               WRITE PRINT-REC AFTER ADVANCING 2 LINES.

       62-WRITE-TAX-CODE-REPORT.
           ADD 1  TO  PAGE-CTR.
           MOVE PAGE-CTR                  TO  PAGE-OUT.
           MOVE "BY TAX CD"               TO  HEADER-LIT.
           MOVE HEADER1                   TO  PRINT-REC.
           WRITE PRINT-REC AFTER ADVANCING NEW-PAGE.
           MOVE DASH-LINE                 TO  PRINT-REC.
           WRITE PRINT-REC AFTER ADVANCING 2 LINES.
           MOVE HEADER3-LINE2             TO  PRINT-REC.
           WRITE PRINT-REC AFTER ADVANCING 2 LINES.
           MOVE HEADER3-LINE3             TO  PRINT-REC.
           WRITE PRINT-REC AFTER ADVANCING 1 LINES.
           PERFORM VARYING TCT-X FROM 1 BY 1 UNTIL
              TCT-TAX-CODE (TCT-X) = HIGH-VALUES
                 IF TCT-X = 30 OR 60 OR 90
                     ADD 1                TO PAGE-CTR
                     MOVE PAGE-CTR        TO PAGE-OUT
                     MOVE HEADER1         TO  PRINT-REC
                     WRITE PRINT-REC AFTER ADVANCING NEW-PAGE
                     MOVE DASH-LINE       TO  PRINT-REC
                     WRITE PRINT-REC AFTER ADVANCING 2 LINES
                     MOVE HEADER3-LINE2   TO  PRINT-REC
                     WRITE PRINT-REC AFTER ADVANCING 2 LINES
                     MOVE HEADER3-LINE3   TO  PRINT-REC
                     WRITE PRINT-REC AFTER ADVANCING 1 LINES
                 END-IF
                 MOVE TCT-TAX-CODE  (TCT-X) TO  D3-TAX-CODE
                 MOVE TCT-CATEGORY-1(TCT-X) TO  D3-CAT-1
                 MOVE TCT-CATEGORY-2(TCT-X) TO  D3-CAT-2
                 MOVE TCT-CATEGORY-3(TCT-X) TO  D3-CAT-3
                 MOVE TCT-CATEGORY-4(TCT-X) TO  D3-CAT-4
                 MOVE DETAIL3-LINE1         TO  PRINT-REC
                 WRITE PRINT-REC AFTER ADVANCING 2 LINES
           END-PERFORM.

       62-CLOSE-FILES.
           IF PAPER-IS-132-COLS
               NEXT SENTENCE
           ELSE
               WRITE PRINT-REC FROM NORMAL-PRINT AFTER ADVANCING 0.

           MOVE SPACES TO PRINT-REC.
           WRITE PRINT-REC AFTER ADVANCING NEW-PAGE.

           CLOSE PRINT-FILE.

       62-PSR-X.
           EXIT.

       622-GET-TAX-DISTRICTS.
           MOVE "PTX1"              TO  PLT-ARG.
           PERFORM 9999-GETKEY-MPLTINFO-PK-I.

           MOVE MPLTINFO-TAX-DISTRICT (1)
               TO ACCRUED-TAX-DISTRICT (1) D3-DIST-1.
           MOVE MPLTINFO-TAX-DISTRICT (2)
               TO ACCRUED-TAX-DISTRICT (2) D3-DIST-2.
           MOVE MPLTINFO-TAX-CE-ACCTG (1)
                                   TO  ACCRUED-TAX-CE-ACCT (1).
           MOVE MPLTINFO-TAX-CE-ACCTG (2)
                                   TO  ACCRUED-TAX-CE-ACCT (2).

           MOVE "PTX2"                TO  PLT-ARG.
           PERFORM 9999-GETKEY-MPLTINFO-PK-I.
           IF GOOD-CALL
               MOVE MPLTINFO-TAX-DISTRICT (1)
                   TO ACCRUED-TAX-DISTRICT (3) D3-DIST-3
               MOVE MPLTINFO-TAX-DISTRICT (2)
                   TO ACCRUED-TAX-DISTRICT (4) D3-DIST-4
               MOVE MPLTINFO-TAX-CE-ACCTG (1)
                                      TO  ACCRUED-TAX-CE-ACCT (3)
               MOVE MPLTINFO-TAX-CE-ACCTG (2)
                                      TO  ACCRUED-TAX-CE-ACCT (4).

       622-GTD-X.
           EXIT.

       64-GET-TAX-CODE-RPT.
           IF   INV-ATAX-AMT(1) = ZEROES
           AND  INV-ATAX-AMT(2) = ZEROES
           AND  INV-ATAX-AMT(3) = ZEROES
           AND  INV-ATAX-AMT(4) = ZEROES
             NEXT SENTENCE
           ELSE
             SET TCT-X TO 1
             SEARCH TCT-ENTRY      VARYING TCT-X
               AT END MOVE
                 "TAX-CODE-TABLE OVERFLOW-CONTACT PROGRAMMING STAFF"
                      TO BU-DISPLAY-MSG
                 PERFORM 2100-BLOWUP
               WHEN TCT-TAX-CODE (TCT-X) = HIGH-VALUES
                 MOVE INV-TAX-CODE     TO TCT-TAX-CODE   (TCT-X)
                 MOVE INV-ATAX-AMT (1) TO TCT-CATEGORY-1 (TCT-X)
                 MOVE INV-ATAX-AMT (2) TO TCT-CATEGORY-2 (TCT-X)
                 MOVE INV-ATAX-AMT (3) TO TCT-CATEGORY-3 (TCT-X)
                 MOVE INV-ATAX-AMT (4) TO TCT-CATEGORY-4 (TCT-X)
               WHEN TCT-TAX-CODE (TCT-X) = INV-TAX-CODE
                 ADD  INV-ATAX-AMT (1) TO TCT-CATEGORY-1 (TCT-X)
                 ADD  INV-ATAX-AMT (2) TO TCT-CATEGORY-2 (TCT-X)
                 ADD  INV-ATAX-AMT (3) TO TCT-CATEGORY-3 (TCT-X)
                 ADD  INV-ATAX-AMT (4) TO TCT-CATEGORY-4 (TCT-X).

       64-GTCR-X.
           EXIT.

       996-OVERRIDE-PRINT-FILE.
      *****************************************************************
      * OVERRIDE THE PRINT FILE TO PASSED PRINT FILE NUM. IF THAT
      * DOESNT EXIST, USE DEFAULT OUTQ FROM LOCAL DATA AREA. IF THE
      * OUTQ DOESN'T EXIST, DEFAULT TO 'MCPRT' PRINT FILE (OUTQ=*JOB)
      ********************************************************
           CALL "COVRPRT" USING OVRPRTF-PARMS.
           CALL "QCMDEXC" USING OVRPRTF-PARM1, OVRPRTF-PARM2.

       9999-GETKEY-MPLTINFO-PK-I.
           MOVE 0 TO COND-WORD.
           MOVE PLT-ARG TO PLTINFOKEY OF MPLTINFO-PK-REC-I.
           READ MPLTINFO-PK-I INTO BUF-MPLTINFO
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS = "23"
               MOVE 17 TO COND-WORD
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD
               IF HANDLE-BLOWUP-FLAG = "Y"
                   MOVE "GETKEY ERR 9999-GETKEY-MPLTINFO-PK-I"
                       TO BU-MSG-AREA
                   PERFORM 2100-BLOWUP.

       9999-GETSER-DINVRCD-RG-I.
           MOVE 0 TO COND-WORD.
           READ DINVRCD-RG-I NEXT INTO BUF-DINVRCD
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS-1 = "1"
               MOVE 11 TO COND-WORD
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD
               IF HANDLE-BLOWUP-FLAG = "Y"
                   MOVE "GETSER ERR 9999-GETSER-DINVRCD-RG-I"
                       TO BU-MSG-AREA
                   PERFORM 2100-BLOWUP.

       9999-BEGFIL-DINVRCD-RG-I.
           MOVE SPACES TO REGISTERNO OF DINVRCD-RG-REC-I.
           START DINVRCD-RG-I KEY >= REGISTERNO OF DINVRCD-RG-REC-I
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.

