       IDENTIFICATION DIVISION.
       PROGRAM-ID.             TDFINIT.
       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.
       SOURCE-COMPUTER.        IBM-AS400.
       OBJECT-COMPUTER.        IBM-AS400.

       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT DISPLAY-FILE
                  ASSIGN       TO WORKSTATION-ZDRAWING-SI
                  ORGANIZATION IS TRANSACTION
                  ACCESS MODE  IS SEQUENTIAL
                  FILE STATUS  IS SCREEN-STATUS
                               MAJOR-MINOR
                  CONTROL-AREA IS SCREEN-CONTROL.

           SELECT DRAWING-FILE
                  ASSIGN       TO DATABASE-MCFLDF0101
                  ORGANIZATION IS INDEXED
                  ACCESS MODE  IS DYNAMIC
                  RECORD KEY   IS EXTERNALLY-DESCRIBED-KEY
                               WITH DUPLICATES
                  FILE STATUS  IS FILE-STAT.

       DATA DIVISION.
       FILE SECTION.
       FD  DISPLAY-FILE
           LABEL RECORDS       ARE OMITTED.
       01  DISPLAY-REC         PIC X(2000).

       FD  DRAWING-FILE
           LABEL RECORDS       ARE STANDARD
           DATA RECORD         IS DFREC.
       01  DFREC.
           COPY DDS-ALL-FORMATS OF MCFLDF0101.

       WORKING-STORAGE SECTION.
       77  TRUE-VAL            PIC 1 VALUE B"1".

       01  PASSWORD-INFORMATION.
           05  NAME-OF-PROGRAM PIC X(08) VALUE "TDFINIT ".
           05  PROGRAM-TYPE    PIC X(02) VALUE "MA".
           05  PROGRAM-RELEASE PIC X(12) VALUE " E0100010001".
           05  PROGRAM-DESCRIPTION.
               10  PROG-DESC-A.
                   15  FILLER  PIC X(10) VALUE "INITIATES ".
                   15  FILLER  PIC X(17) VALUE "DRAWINGS INTO THE".
                   15  FILLER  PIC X(13) VALUE " ENGINEERING ".
                   15  FILLER  PIC X(20) VALUE "DRAWING FILE ".
               10  PROG-DESC-B PIC X(60) VALUE SPACES.
               10  PROG-FUNC   PIC X(60) VALUE SPACES.
           05  PASSWORD-FLAG   PIC X.

       01  FILE-STAT.
           05  FILE-STAT-1     PIC X.
           05  FILE-STAT-2     PIC X.

       01  DATE-COMPARE.
           05  INIT-COMP-CCYY.
               10  INIT-C-CC       PIC 99.
               10  INIT-COMP.
                   15  INIT-C-YY   PIC 99.
                   15  INIT-C-MM   PIC 99.
                   15  INIT-C-DD   PIC 99.
           05  REV-COMP-CCYY.
               10  REV-C-CC        PIC 99.
               10  REV-COMP.
                   15  REV-C-YY    PIC 99.
                   15  REV-C-MM    PIC 99.
                   15  REV-C-DD    PIC 99.
           05  DATE-HOLD.
               10  DH-MM       PIC 99.
               10  DH-DD       PIC 99.
               10  DH-YY       PIC 99.

       01  ERROR-BUFFER.
           05  FILLER          PIC X(16).
           05  E-DWGNO         PIC X(16).
           05  FILLER          PIC X.
           05  E-REVNO         PIC X(4).
           05  FILLER          PIC X(43).

       01  SCREEN-DATA.
           05  DRAW-NUM-BUF                    PIC X(16).
           05  REV-NUM-BUF                     PIC X(04).
           05  DRAW-DESC-BUF                   PIC X(50).
           05  DRAWING-CODE-BUF.
               10  DRAW-CODE-BUF               PIC X(08).
               10  DRAW-SELECT-BUF             PIC X(01).
           05  VEND-CODE-BUF                   PIC X(04).
           05  DRAW-EQUIP-NUMS.
               10  DRAW-ENUM-BUF               PIC X(06).
               10  DRAW-TNUM-BUF               PIC 9(08).
           05  DRAW-SUBSYS-BUF                 PIC 9(04).
           05  DRAW-ZONE-BUF                   PIC X(04).
           05  DRAW-DEPT-BUF                   PIC X(04).
           05  DRAW-BLDG-BUF                   PIC X(04).
           05  INIT-DATE-BUF.
               10  INIT-MM-BUF                 PIC 9(02).
               10  INIT-DD-BUF                 PIC 9(02).
               10  INIT-YY-BUF                 PIC 9(02).
           05  REV-DATE-BUF.
               10  REV-MM-BUF                  PIC 9(02).
               10  REV-DD-BUF                  PIC 9(02).
               10  REV-YY-BUF                  PIC 9(02).
           05  KP-LIST-BUF                     PIC X(08).
           05  DRAWING-LOC-BUF                 PIC X(08).
           05  SCREEN-MSG-LINE                 PIC X(79).
           05  SCREEN-CMD-LINE                 PIC X(79).
           05  SCREEN-ERR-LINE                 PIC X(79).

           COPY SCREENIO       OF COPYLIB.

           COPY CATREAD        OF COPYLIB.

       01  DRAW-FILE-DATA.
           COPY DDRAWFIL       OF COPYLIB.

       LINKAGE SECTION.
       01  DBPARAMETERS.
           COPY DBPARMS        OF COPYLIB.

       PROCEDURE DIVISION      USING DBPARAMETERS.
       START-PGM.
           OPEN I-O            DISPLAY-FILE.
           OPEN I-O            DRAWING-FILE.

           CALL "TPWORD"       USING PASSWORD-INFORMATION.
           IF PASSWORD-FLAG = "N"
               GO TO END-OF-JOB.

           MOVE SPACES         TO SCREEN-DATA ERROR-BUFFER.

       6-MAIN.
           MOVE "VDRAWADD"     TO SCREEN-NAME.
           IF IND(99) = TRUE-VAL
               MOVE ERROR-BUFFER TO SCREEN-ERR-LINE.

           MOVE SCREEN-DATA    TO DISPLAY-REC
           MOVE "00"           TO SCREEN-STATUS.

           WRITE DISPLAY-REC   FORMAT IS SCREEN-NAME
                               INDIC ARE SCREEN-INDICATORS.
           IF SCREEN-STATUS NOT = "00"
               DISPLAY "SCREEN WRITE ERROR.  SCREEN-STATUS IS "
                               SCREEN-STATUS
               GO TO END-OF-JOB.

           READ  DISPLAY-FILE  FORMAT IS SCREEN-NAME
                               INDIC ARE SCREEN-INDICATORS.
           IF SCREEN-STATUS NOT = "00"
               DISPLAY "SCREEN READ ERROR.  SCREEN-STATUS IS "
                               SCREEN-STATUS
               GO TO END-OF-JOB.

           MOVE ALL B"0"       TO SCREEN-INDICATORS.
           MOVE DISPLAY-REC TO SCREEN-DATA.

           IF KEY-HIT = 1 OR 3
               GO TO END-OF-JOB.

           IF KEY-HIT NOT = 0
               MOVE 35128      TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE TRUE-VAL   TO IND(99)
               GO TO 6-MAIN.

           IF SCREEN-DATA = SPACES
               MOVE 66120      TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE TRUE-VAL   TO IND(99)
               GO TO 6-MAIN.

           IF DRAW-NUM-BUF = SPACES
               MOVE 30071      TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE TRUE-VAL   TO IND(1) IND(99)
               GO TO 6-MAIN.

           IF DRAW-DESC-BUF = SPACES
               MOVE 30042      TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE TRUE-VAL   TO IND(3) IND(99)
               GO TO 6-MAIN.

           IF DRAW-CODE-BUF = SPACES
               MOVE 30072      TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE TRUE-VAL   TO IND(4) IND(99)
               GO TO 6-MAIN.

           IF DRAW-SELECT-BUF = SPACE
               MOVE 30075      TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE TRUE-VAL   TO IND(5) IND(99)
               GO TO 6-MAIN.

           IF DRAW-SELECT-BUF = "F" OR "G"
               NEXT SENTENCE
           ELSE
           MOVE 35123          TO CATREAD-MSG-NUMBER
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
           MOVE TRUE-VAL       TO IND(5) IND(99)
           GO TO 6-MAIN.

           IF DRAW-SELECT-BUF = "G"
               MOVE SPACES     TO VEND-CODE-BUF
           ELSE
           IF VEND-CODE-BUF = SPACES
               MOVE 48007      TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE TRUE-VAL   TO IND(6) IND(99)
               GO TO 6-MAIN.

           IF DRAW-EQUIP-NUMS = SPACES
               MOVE 31092      TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE TRUE-VAL   TO IND(7) IND(99)
               GO TO 6-MAIN.

           IF DRAW-ENUM-BUF NOT = SPACES AND
              DRAW-TNUM-BUF NOT = SPACES
               MOVE 31092      TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE TRUE-VAL   TO IND(7) IND(99)
               GO TO 6-MAIN.

           IF DRAW-ENUM-BUF = SPACES
               IF DRAW-TNUM-BUF NOT NUMERIC
                    MOVE 31093 TO CATREAD-MSG-NUMBER
                    PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                    MOVE TRUE-VAL TO IND(8) IND(99)
                    GO TO 6-MAIN.

           IF DRAW-SUBSYS-BUF NOT NUMERIC
               MOVE 45044      TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE TRUE-VAL   TO IND(9) IND(99)
               GO TO 6-MAIN.

           IF DRAW-ZONE-BUF = SPACES
               MOVE 31094      TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE TRUE-VAL   TO IND(10) IND(99)
               GO TO 6-MAIN.

           IF INIT-DATE-BUF NOT NUMERIC
               MOVE 35124      TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE TRUE-VAL   TO IND(13) IND(99)
               GO TO 6-MAIN.

           IF INIT-YY-BUF IS NUMERIC
               IF DATE-FLAG = 1
                   IF INIT-MM-BUF > 0 AND INIT-MM-BUF < 13
                       IF INIT-DD-BUF > 0 AND INIT-DD-BUF < 32
                           NEXT SENTENCE
                       ELSE
                       MOVE 35030 TO CATREAD-MSG-NUMBER
                       PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                       MOVE TRUE-VAL TO IND(14) IND(99)
                       GO TO 6-MAIN
                   ELSE
                   MOVE 35031  TO CATREAD-MSG-NUMBER
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE TRUE-VAL TO IND(13) IND(99)
                   GO TO 6-MAIN
               ELSE
               IF INIT-MM-BUF > 0 AND INIT-MM-BUF < 32
                   IF INIT-DD-BUF > 0 AND INIT-DD-BUF < 13
                       NEXT SENTENCE
                   ELSE
                   MOVE 35031  TO CATREAD-MSG-NUMBER
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE TRUE-VAL TO IND(14) IND(99)
                   GO TO 6-MAIN
               ELSE
               MOVE 35030      TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE TRUE-VAL   TO IND(13) IND(99)
               GO TO 6-MAIN
           ELSE
           MOVE 35032          TO CATREAD-MSG-NUMBER
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
           MOVE TRUE-VAL       TO IND(15) IND(99)
           GO TO 6-MAIN.

           IF REV-NUM-BUF = SPACES
               MOVE SPACES     TO REV-DATE-BUF
           ELSE
           IF REV-DATE-BUF NOT NUMERIC
               MOVE 35125      TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE TRUE-VAL   TO IND(16) IND(99)
               GO TO 6-MAIN
           ELSE
           IF REV-YY-BUF IS NUMERIC
               IF DATE-FLAG = 1
                   IF REV-MM-BUF > 0 AND REV-MM-BUF < 13
                       IF REV-DD-BUF > 0 AND REV-DD-BUF < 32
                           NEXT SENTENCE
                       ELSE
                       MOVE 35030 TO CATREAD-MSG-NUMBER
                       PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                       MOVE TRUE-VAL TO IND(17) IND(99)
                       GO TO 6-MAIN
                   ELSE
                   MOVE 35031  TO CATREAD-MSG-NUMBER
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE TRUE-VAL TO IND(16) IND(99)
                   GO TO 6-MAIN
               ELSE
               IF REV-MM-BUF > 0 AND REV-MM-BUF < 32
                   IF REV-DD-BUF > 0 AND REV-DD-BUF < 13
                       NEXT SENTENCE
                   ELSE
                   MOVE 35031  TO CATREAD-MSG-NUMBER
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE TRUE-VAL TO IND(17) IND(99)
                   GO TO 6-MAIN
               ELSE
               MOVE 35030      TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE TRUE-VAL   TO IND(16) IND(99)
               GO TO 6-MAIN
           ELSE
           MOVE 35032          TO CATREAD-MSG-NUMBER
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
           MOVE TRUE-VAL       TO IND(18) IND(99)
           GO TO 6-MAIN.

           IF REV-DATE-BUF = ZEROES OR SPACES
               NEXT SENTENCE
           ELSE
           MOVE INIT-DATE-BUF  TO DATE-HOLD
           MOVE DH-YY          TO INIT-C-YY
           MOVE DH-MM          TO INIT-C-MM
           MOVE DH-DD          TO INIT-C-DD
           IF DATE-FLAG = 3
               MOVE DH-MM      TO INIT-C-DD
               MOVE DH-DD      TO INIT-C-MM
           END-IF
           IF INIT-C-YY > "70"
               MOVE "19"       TO INIT-C-CC
           ELSE
           MOVE "20"           TO INIT-C-CC
           END-IF
           IF REV-C-YY > "70"
               MOVE "19"       TO REV-C-CC
           ELSE
           MOVE "20"           TO REV-C-CC
           END-IF
           MOVE REV-DATE-BUF   TO DATE-HOLD
           MOVE DH-YY          TO REV-C-YY
           MOVE DH-MM          TO REV-C-MM
           MOVE DH-DD          TO REV-C-DD
           IF DATE-FLAG = 3
               MOVE DH-MM      TO REV-C-DD
               MOVE DH-DD      TO REV-C-MM
           END-IF
           IF REV-C-YY > "70"
               MOVE "19"       TO REV-C-CC
           ELSE
           MOVE "20"           TO REV-C-CC
           END-IF
           IF REV-COMP-CCYY < INIT-COMP-CCYY
               MOVE 44106      TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE TRUE-VAL   TO IND(16) IND(99)
               GO TO 6-MAIN.

           IF DRAWING-LOC-BUF = SPACES
               MOVE 30073      TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE TRUE-VAL   TO IND(20) IND(99)
               GO TO 6-MAIN.

           MOVE SPACES         TO DRAW-FILE-DATA.
           MOVE DRAW-NUM-BUF   TO DRAWING-NUM.
           MOVE REV-NUM-BUF    TO REV-NUM.
           MOVE DRAW-DESC-BUF  TO DRAW-DESC.
           MOVE DRAW-CODE-BUF  TO DRAW-CODE.
           MOVE DRAW-SELECT-BUF TO DRAW-SELECT.
           MOVE VEND-CODE-BUF  TO VEND-CODE.
           MOVE DRAW-ENUM-BUF  TO DRAW-ENUM.
           MOVE DRAW-TNUM-BUF  TO DRAW-TNUM.

           IF DRAW-TNUM = "00000000"
               MOVE SPACES     TO DRAW-TNUM.

           MOVE DRAW-SUBSYS-BUF TO DRAW-SUBSYS.
           MOVE DRAW-ZONE-BUF  TO DRAW-ZONE.
           MOVE DRAW-DEPT-BUF  TO DRAW-DEPT.
           MOVE DRAW-BLDG-BUF  TO DRAW-BLDG.
           MOVE KP-LIST-BUF    TO KP-LIST.
           MOVE DRAWING-LOC-BUF TO DRAWING-LOC.

           MOVE INIT-YY-BUF    TO INIT-YY.
           MOVE INIT-MM-BUF    TO INIT-MM.
           MOVE INIT-DD-BUF    TO INIT-DD.
           IF DATE-FLAG = 3
               MOVE INIT-MM-BUF TO INIT-DD
               MOVE INIT-DD-BUF TO INIT-MM.

           MOVE "20"           TO INIT-CC.
           IF INIT-YY > "70"
               MOVE "19"       TO INIT-CC.

           MOVE REV-YY-BUF     TO REV-YY.
           MOVE REV-MM-BUF     TO REV-MM.
           MOVE REV-DD-BUF     TO REV-DD.
           IF DATE-FLAG = 3
               MOVE REV-MM-BUF TO REV-DD
               MOVE REV-DD-BUF TO REV-MM.

           IF REV-DATE-BUF = SPACES
               NEXT SENTENCE
           ELSE
           MOVE "20"           TO REV-CC
           IF REV-YY > "70"
               MOVE "19"       TO REV-CC.

           IF REV-DATE = "000000"
               MOVE SPACES     TO REV-DATE.

           WRITE DFREC         FROM DRAW-FILE-DATA
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
               DISPLAY "CANNOT WRITE DRAWING FILE RECORD - TDFINIT"
               GO TO 6-MAIN.

           MOVE 66166          TO CATREAD-MSG-NUMBER.
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
           MOVE DRAW-NUM-BUF   TO E-DWGNO.
           MOVE REV-NUM-BUF    TO E-REVNO.
           MOVE SPACES         TO SCREEN-DATA.
           MOVE ERROR-BUFFER   TO SCREEN-MSG-LINE.
           GO TO 6-MAIN.

       END-OF-JOB.
           CLOSE               DISPLAY-FILE.
           CLOSE               DRAWING-FILE.
           GOBACK.

       999-CATREAD.
           MOVE SPACES         TO ERROR-BUFFER.
           CALL "CCATREAD"     USING CATREAD-PARMS.
           MOVE CATREAD-MSG-TEXT TO ERROR-BUFFER.

       999-CATREAD-EXIT.       EXIT.

