       62-FS-EXIT.             EXIT.

       63-ALARM-SCREEN.
           MOVE "VALARM"       TO SCREEN-NAME.

       63-SHOWFORM.
           MOVE SCREEN-DATA    TO DISPLAY-REC.
           MOVE "00"           TO SCREEN-STATUS.

           WRITE DISPLAY-REC   FORMAT IS SCREEN-NAME
               INDIC ARE SCREEN-INDICATORS.
           IF SCREEN-STATUS NOT = "00"
               DISPLAY "SCREEN WRITE ERROR.  SCREEN-STATUS IS "
                        SCREEN-STATUS
               GO TO END-OF-JOB.

           READ  DISPLAY-FILE  FORMAT IS SCREEN-NAME
               INDIC ARE SCREEN-INDICATORS
           IF SCREEN-STATUS NOT = "00"
               DISPLAY "SCREEN READ ERROR.  SCREEN-STATUS IS "
                        SCREEN-STATUS
               GO TO END-OF-JOB.

           MOVE ALL B"0"       TO SCREEN-INDICATORS.
           MOVE DISPLAY-REC    TO SCREEN-DATA.

           IF KEY-HIT = 0 OR 1 OR 2 OR 3 OR 4 OR 5 OR 6 OR 7 OR 8
               NEXT SENTENCE
           ELSE
               GO TO 63-SHOWFORM.

           MOVE "VAUTOQUE"     TO SCREEN-NAME.

       63-ALARM-EXIT.          EXIT.

       64-DISPLAY-WO.
           IF DESC-UP = " * * *  R E S E R V E D  * * *"
               MOVE "X"        TO WO-NUM-SEL.

           IF FUNCTION-SW = 1
               IF WO-NUM-SEL = "R"
                   IF WO-NUM-UP = R-1 OR R-2 OR R-3 OR R-4 OR R-5
                       GO TO 64-EXIT
                   ELSE
                   IF WO-NUM-UP = QA-WO-NUM
                       PERFORM R-FILL
                       MOVE "R" TO QA-SELECT
                       MOVE " * * *  R E S E R V E D  * * *"
                               TO DESC-UP
                       GO TO 64-EXIT
                   ELSE
                   IF WO-NUM-UP = QB-WO-NUM
                       PERFORM R-FILL
                       MOVE "R" TO QB-SELECT
                       MOVE " * * *  R E S E R V E D  * * *"
                               TO DESC-UP
                       GO TO 64-EXIT
                   ELSE
                   IF WO-NUM-UP = QC-WO-NUM
                       PERFORM R-FILL
                       MOVE "R" TO QC-SELECT
                       MOVE " * * *  R E S E R V E D  * * *"
                               TO DESC-UP
                       GO TO 64-EXIT
                   ELSE
                   IF WO-NUM-UP = QD-WO-NUM
                       PERFORM R-FILL
                       MOVE "R" TO QD-SELECT
                       MOVE " * * *  R E S E R V E D  * * *"
                               TO DESC-UP
                       GO TO 64-EXIT
                   ELSE
                   IF WO-NUM-UP = QE-WO-NUM
                       PERFORM R-FILL
                       MOVE "R" TO QE-SELECT
                       MOVE " * * *  R E S E R V E D  * * *"
                               TO DESC-UP
                       GO TO 64-EXIT
                   ELSE
                       PERFORM RESERVE-FUNCTION
                       MOVE " * * *  R E S E R V E D  * * *"
                               TO DESC-UP
                       GO TO 64-EXIT.

           IF KEY-HIT = 5 AND CNUM-BUF = SPACES
               MOVE
           "YOU ARE NOT SIGNED INTO THE CRAFTSMAN'S FUNCTIONS SCREEN."
                               TO MESSAGE-BUFFER
               GO TO 64-EXIT.

           MOVE DWO-BUFFER     TO WONUM OF WO-BASIC.
           READ WO-BASIC       INTO WO-BASIC-DATA
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
               MOVE "READ    " TO DB-FUNC
               MOVE "WO-BASIC" TO DB-FILE
               MOVE FILE-STAT  TO CON-WORD
               MOVE DB-ERROR   TO MESSAGE-BUFFER
               MOVE DWO-BUFFER TO MSG-FLD
               GO TO 64-EXIT.

           IF DWO-BUFFER NOT = WO-NUM
               MOVE "READ    " TO DB-FUNC
               MOVE "WO-BASIC" TO DB-FILE
               MOVE FILE-STAT  TO CON-WORD
               MOVE DB-ERROR   TO MESSAGE-BUFFER
               MOVE DWO-BUFFER TO MSG-FLD
               GO TO 64-EXIT.

           MOVE SPACES         TO MESSAGE-BUFFER WO-PLANNED-DATA.
           IF KEY-HIT = 4
               MOVE "C"        TO RETURN-BYTE
               CALL "TCHNGWO"  USING DBPARAMETERS
                               WO-TRACK-DATA
               CLOSE           OUT-FILE
               GO TO 6-MAIN
           ELSE
           IF KEY-HIT = 5
               MOVE CNUM-BUF       TO PERCCNUM OF CURRENT-LABOR
               READ CURRENT-LABOR  INTO LABOR-CURR-DATA
                   INVALID KEY     MOVE FILE-STAT TO FILE-STAT
               END-READ
               IF FILE-STAT = "23"
                   MOVE "J"        TO RETURN-BYTE
                   CALL "TIPNEWWO" USING DBPARAMETERS
                                   QUEUE-WO-DATA
                                   WO-BASIC-DATA
                                   WO-PLANNED-DATA
                                   WO-TRACK-DATA
                                   CNUM-BUFFER
                                   MESSAGE-BUFFER
                                   FILE-SW
                   CLOSE           OUT-FILE
                   GO TO 6-MAIN
               ELSE
                   MOVE "YOU ARE ALREADY 'IP' ON A WORKORDER."
                               TO MESSAGE-BUFFER
                   GO TO 64-EXIT
           ELSE
               CALL "TDISPWO"  USING DBPARAMETERS
                               WO-BASIC-DATA
                               WO-PLANNED-DATA
                               FILE-SW.

           MOVE "VAUTOQUE"     TO SCREEN-NAME.

       64-EXIT.                EXIT.

       RESERVE-FUNCTION.
           IF RESERVATIONS < 5
               ADD 1           TO RESERVATIONS
               PERFORM R-FILL
               PERFORM LOAD-QUEUE-HOLD
               IF QE-SELECT = SPACE
                   MOVE QUEUE-HOLD TO QWO-E
               ELSE
               IF QD-SELECT = SPACE
                   MOVE QUEUE-HOLD TO QWO-D
               ELSE
               IF QC-SELECT = SPACE
                   MOVE QUEUE-HOLD TO QWO-C
               ELSE
               IF QB-SELECT = SPACE
                   MOVE QUEUE-HOLD TO QWO-B
               ELSE
               IF QA-SELECT = SPACE
                   MOVE QUEUE-HOLD TO QWO-A
               ELSE
                   NEXT SENTENCE
           ELSE
               GO TO END-OF-JOB.

       LOAD-QUEUE-HOLD.
           MOVE SPACES         TO QUEUE-HOLD.
           MOVE WO-NUM-SEL     TO QH-SELECT.
           MOVE WO-QUEUE-UP    TO QH-FACTOR.
           MOVE EQUIP-UP       TO QH-EQUIP.
           IF EQP-DN-UP = "D"
               MOVE "Y"        TO QH-DOWN
           ELSE
               MOVE "N"        TO QH-DOWN.
           MOVE WO-NUM-UP      TO QH-WO-NUM.
           MOVE DESC-UP        TO QH-DESCRIPTION.
           MOVE SKILL-A-UP     TO QH-SKILL-1.
           MOVE SKILL-B-UP     TO QH-SKILL-2.
           MOVE SKILL-C-UP     TO QH-SKILL-3.

       R-FILL.
           IF R-1 = SPACES MOVE WO-NUM-UP TO R-1 ELSE
             IF R-2 = SPACES MOVE WO-NUM-UP TO R-2 ELSE
               IF R-3 = SPACES MOVE WO-NUM-UP TO R-3 ELSE
                 IF R-4 = SPACES MOVE WO-NUM-UP TO R-4 ELSE
                   IF R-5 = SPACES MOVE WO-NUM-UP TO R-5.

       66-ERROR.
           MOVE TRUE-VAL       TO IND(FIELD-NUMBER) IND(99).

       999-CATREAD.
           MOVE SPACES         TO MESSAGE-BUFFER.
           CALL "CCATREAD"     USING CATREAD-PARMS.
           MOVE CATREAD-MSG-TEXT TO MESSAGE-BUFFER.

       999-CATREAD-EXIT.       EXIT.

       SORT-AQ-RECS-SECT       SECTION 02.
       SORT-AQ-RECS.
           PERFORM SORT-MAIN   THRU SORT-M-EXIT.

       SORT-MAIN.
           MOVE ZONE-FIELD      TO ZONEPRTY OF WO-OPEN-QUEUE.
           START WO-OPEN-QUEUE KEY > ZONEPRTY OF WO-OPEN-QUEUE
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
      *    MOVE ZONE-PRTY-FIELD TO ZONEPRTY OF WO-OPEN-QUEUE.
      *    START WO-OPEN-QUEUE KEY = ZONEPRTY OF WO-OPEN-QUEUE
      *        INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
               IF FILE-STAT-1 = "2"
                   GO TO SORT-M-EXIT
               ELSE
                   MOVE "START   " TO DB-FUNC
                   MOVE "WO-OPEN-QUEUE" TO DB-FILE
                   MOVE FILE-STAT  TO CON-WORD
                   MOVE DB-ERROR   TO ERRMSG2
                   MOVE 1          TO FIELD-NUMBER
                   PERFORM 66-ERROR
                   GO TO END-OF-JOB.

           PERFORM SORT-DBGET  THRU SORT-DBGET-EXIT.

       SORT-M-EXIT.            EXIT.

       SORT-DBGET.
           MOVE SPACES         TO SORT-REC.
           READ WO-OPEN-QUEUE  NEXT INTO WO-QUEUE-DATA
               AT END          MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
               IF FILE-STAT = "10" OR "14" OR "46"
                   GO TO SORT-DBGET-EXIT
               ELSE
                   MOVE "READ    " TO DB-FUNC
                   MOVE "WO-OPEN-QUEUE" TO DB-FILE
                   MOVE FILE-STAT  TO CON-WORD
                   MOVE DB-ERROR   TO ERRMSG2
                   MOVE 1          TO FIELD-NUMBER
                   PERFORM 66-ERROR
                   GO TO END-OF-JOB.

           IF ZONE-FIELD NOT = Q-ZONE GO TO SORT-DBGET-EXIT.
      *    IF ZONE-PRTY-FIELD NOT = Q-ZONE-PRI
      *        GO TO SORT-DBGET-EXIT.

           IF FUNCTION-SW = 1
               IF Q-RESERVE = "XX"
                   GO TO SORT-DBGET
               ELSE
                   NEXT SENTENCE
           ELSE
               IF Q-RESERVE = "XX"
                   MOVE " * * *  R E S E R V E D  * * *"
                               TO Q-DESCRIPTION.

           MOVE QUEUE-FACTOR   TO SORT-WO-QUEUE.
           MOVE Q-EQUIP-NUM    TO SORT-EQUIP.
           MOVE Q-WO-NUM       TO SORT-WO-NUM.
           IF Q-CC-NUM NOT = "9999"
               MOVE Q-CC-NUM   TO SORT-CC-NUM.
           IF Q-EQP-DN = "Y"
               MOVE "D"        TO SORT-DOWN.
           MOVE Q-DESCRIPTION  TO SORT-DESC.
           MOVE Q-SKILL-1      TO SORT-SKILL-1.
           MOVE Q-SKILL-2      TO SORT-SKILL-2.
           MOVE Q-SKILL-3      TO SORT-SKILL-3.
           RELEASE SORT-REC.

           GO TO SORT-DBGET.

       SORT-DBGET-EXIT.        EXIT.

       SORT-AQ-OUT-SECT        SECTION 03.
       SORT-AQ-OUT.
           OPEN OUTPUT         OUT-FILE.
           PERFORM SORT-READ-LOOP THRU SRL-EXIT.
           CLOSE               OUT-FILE.

       SORT-READ-LOOP.
           RETURN SORT-FILE    AT END
               MOVE ACT-KEY    TO MAX-KEY
               GO TO SRL-EXIT.
           ADD 1               TO ACT-KEY.
           MOVE SORT-REC       TO OUT-REC.
           WRITE OUT-REC       INVALID KEY
               DISPLAY "WRITE OUT-FILE ERR"
               GO TO SRL-EXIT.
           GO TO SORT-READ-LOOP.

       SRL-EXIT.               EXIT.

