       IDENTIFICATION DIVISION.
       PROGRAM-ID.             TAUTOQZ.
       AUTHOR.                 W. ROXBURY.
       INSTALLATION.           GOODYEAR TIRE & RUBBER CO.
      *REMARKS.                AUTOMATICALLY REFRESHING QUEUE-FILE
      *                        INQUIRY PROGRAM SORTED BY ZONE.
      *                        WHEN RUN FROM THE MULTI-IP SCREEN IT
      *                        ALLOWS RESERVATION OF WORKORDERS ALSO.
      *                        IF MMIS SWITCH-H (JCW-QRFRSH-305) IS SET
      *                        'ON', SCREEN WILL REFRESH EVERY 3 MINUTES.
      *                        ****.
       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.
       SOURCE-COMPUTER.        AS-400.
       OBJECT-COMPUTER.        AS-400.
       SPECIAL-NAMES.          REQUESTOR IS WORK-STATION
                               SYSTEM-CONSOLE IS CONSOLE
                               LOCAL-DATA IS LOCAL-DATA-AREA.
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT CURRENT-LABOR
                  ASSIGN       TO DATABASE-MCFLMM1601
                  ORGANIZATION IS INDEXED
                  ACCESS MODE  IS DYNAMIC
                  RECORD KEY   IS EXTERNALLY-DESCRIBED-KEY
                               WITH DUPLICATES
                  FILE STATUS  IS FILE-STAT.

           SELECT WO-ZONE-PRTY
                  ASSIGN       TO DATABASE-MCFLMM0501
                  ORGANIZATION IS INDEXED
                  ACCESS MODE  IS DYNAMIC
                  RECORD KEY   IS EXTERNALLY-DESCRIBED-KEY
                  FILE STATUS  IS FILE-STAT.

           SELECT WO-BASIC
                  ASSIGN       TO DATABASE-MCFLMM1001
                  ORGANIZATION IS INDEXED
                  ACCESS MODE  IS DYNAMIC
                  RECORD KEY   IS EXTERNALLY-DESCRIBED-KEY
                               WITH DUPLICATES
                  FILE STATUS  IS FILE-STAT.

           SELECT WO-OPEN-QUEUE
                  ASSIGN       TO DATABASE-MCFLMM1901
                  ORGANIZATION IS INDEXED
                  ACCESS MODE  IS DYNAMIC
                  RECORD KEY   IS EXTERNALLY-DESCRIBED-KEY
                               WITH DUPLICATES
                  FILE STATUS  IS FILE-STAT.

           SELECT DISPLAY-FILE
                  ASSIGN       TO WORKSTATION-ZCFTHELP-SI
                  ORGANIZATION IS TRANSACTION
                  ACCESS MODE  IS SEQUENTIAL
                  FILE STATUS  IS SCREEN-STATUS
                               MAJOR-MINOR
                  CONTROL-AREA IS SCREEN-CONTROL.

           SELECT OUT-FILE
                  ASSIGN       TO DISK-AUTOQZ
                  ORGANIZATION IS RELATIVE
                  ACCESS MODE  IS DYNAMIC
                  RELATIVE KEY IS ACT-KEY
                  FILE STATUS  IS FILE-STAT.

           SELECT SORT-FILE
                  ASSIGN       TO DISK-SORTFILE.

       DATA DIVISION.
       FILE SECTION.
       FD  CURRENT-LABOR
           LABEL RECORDS ARE STANDARD.
       01  LC-REC.
           COPY DDS-ALL-FORMATS OF MCFLMM1601.

       FD  WO-ZONE-PRTY
           LABEL RECORDS ARE STANDARD.
       01  ZP-REC.
           COPY DDS-ALL-FORMATS OF MCFLMM0501.

       FD  WO-BASIC
           LABEL RECORDS ARE STANDARD.
       01  VWO-REC.
           COPY DDS-ALL-FORMATS OF MCFLMM1001.

       FD  WO-OPEN-QUEUE
           LABEL RECORDS ARE STANDARD.
       01  WOQ-REC.
           COPY DDS-ALL-FORMATS OF MCFLMM1901.

       FD  DISPLAY-FILE
           LABEL RECORDS ARE OMITTED.
       01  DISPLAY-REC         PIC X(2000).

       FD  OUT-FILE RECORD CONTAINS 60 CHARACTERS
           LABEL RECORDS ARE OMITTED
           DATA RECORD IS OUT-REC.
       01  OUT-REC.
           05  OUT-WO-QUEUE    PIC 99.
           05  OUT-CC-NUM      PIC XXXX.
           05  OUT-EQUIP       PIC X(06).
           05  OUT-DOWN        PIC X.
           05  OUT-FILLER      PIC X.
           05  OUT-WO-NUM      PIC X(10).
           05  OUT-DESC        PIC X(30).
           05  OUT-SKILL-1     PIC XX.
           05  OUT-SKILL-2     PIC XX.
           05  OUT-SKILL-3     PIC XX.

       SD  SORT-FILE RECORD CONTAINS 60 CHARACTERS
           DATA RECORD IS SORT-REC.
       01  SORT-REC.
           05  SORT-WO-QUEUE   PIC 99.
           05  SORT-CC-NUM     PIC XXXX.
           05  SORT-EQUIP.
               10  SORT-EQ1    PIC X.
               10  SORT-EQ2    PIC X.
               10  SORT-EQ3    PIC X.
               10  SORT-EQ4    PIC X.
               10  SORT-EQ5    PIC X.
               10  SORT-EQ6    PIC X.
           05  SORT-DOWN       PIC X.
           05  SORT-FILLER     PIC X.
           05  SORT-WO-NUM     PIC X(10).
           05  SORT-DESC       PIC X(30).
           05  SORT-SKILL-1    PIC XX.
           05  SORT-SKILL-2    PIC XX.
           05  SORT-SKILL-3    PIC XX.

