       01  RESERVATIONS        PIC  9(4).

       PROCEDURE DIVISION      USING DBPARAMETERS
                               FUNCTION-SW
                               CNUM-BUFFER
                               QUEUE-RECORDS
                               RESERVATIONS.

       BEGIN-SORT              SECTION 01.
       CHECK-PASSWORD.
           CALL "TPWORD"       USING PASSWORD-INFORMATION.
           IF PASSWORD-FLAG NOT = "N"
               GO TO OPEN-FILES.
           GOBACK.

       OPEN-FILES.
           MOVE 0              TO WRITE-CTR TO-CTR.
           MOVE 36             TO TO-CYCLE.
           MOVE SPACES         TO WO-PLANNED-DATA.
           OPEN INPUT          WO-ZONE-PRTY.
           OPEN INPUT          WO-BASIC.
           OPEN INPUT          WO-OPEN-QUEUE.
           OPEN INPUT          CURRENT-LABOR.
           OPEN I-O            DISPLAY-FILE.
           IF SCREEN-STATUS NOT = "00"
               DISPLAY "SCREEN FILE OPEN ERROR.  SCREEN-STATUS IS "
                               SCREEN-STATUS
               GO TO END-OF-JOB.

           ACCEPT MC-LOCAL-DATA-AREA FROM LOCAL-DATA-AREA.

       BEGIN-PROC.
           PERFORM 1-HSK       THRU 1-EXIT.
           GO TO 6-MAIN.

       END-OF-JOB.
           CLOSE               WO-ZONE-PRTY.
           CLOSE               WO-BASIC.
           CLOSE               WO-OPEN-QUEUE.
           CLOSE               CURRENT-LABOR.
           CLOSE               OUT-FILE.
           CLOSE               DISPLAY-FILE.
           GOBACK.

       1-HSK.
           MOVE 0              TO EOF-SW ALARM.
           MOVE "B"            TO FILE-SW.
           MOVE SPACES         TO MESSAGE-BUFFER.
           MOVE SPACES         TO SCREEN-DATA.
           MOVE SPACES         TO ZONE-SCREEN-DATA.
           MOVE SPACES         TO RESERVATION-TABLE.

           IF QA-SELECT NOT = SPACE
               MOVE QA-WO-NUM  TO R-1.
           IF QB-SELECT NOT = SPACE
               MOVE QB-WO-NUM  TO R-2.
           IF QC-SELECT NOT = SPACE
               MOVE QC-WO-NUM  TO R-3.
           IF QD-SELECT NOT = SPACE
               MOVE QD-WO-NUM  TO R-4.
           IF QE-SELECT NOT = SPACE
               MOVE QE-WO-NUM  TO R-5.

           MOVE " "            TO TIMEOUT-SW.
           IF FUNCTION-SW NOT = 1
               IF JCW-QRFRSH-305 = "1"
                   MOVE "X"    TO TIMEOUT-SW.

      **********************************************************************
      **    MESSAGE 052/009:
      ** Z O N E
      **********************************************************************
           MOVE  52            TO CATREAD-MSG-SET.
           MOVE   9            TO CATREAD-MSG-NUM.
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
           MOVE MESSAGE-BUFFER TO SAVE-TITLE.
           IF SAVE-TITLE = SPACES
               MOVE "Z O N E   " TO SAVE-TITLE ZONE-TITLE.

      *    IF JCW-ZJCW-269 = "    "
      *        PERFORM 1-GETZONE-JCW THRU 1-GZJ-EXIT
      *    ELSE
      *        MOVE JCW-ZJCW-269 TO ZONE-BUF Z-ARG
      *        MOVE ZONE-ARGUMENT TO ZONE-DATA.
      *
           IF JCW-ZJCW-269 = "    "
               CALL "TRTVZONE" USING ZONE-BUF
               IF ZONE-BUF = SPACES
                   GO TO END-OF-JOB
               ELSE
                   MOVE ZONE-BUF TO Z-ARG
                   MOVE ZONE-ARGUMENT TO ZONE-DATA
           ELSE
               MOVE JCW-ZJCW-269 TO ZONE-BUF Z-ARG
               MOVE ZONE-ARGUMENT TO ZONE-DATA.

           MOVE ZONE-FIELD     TO ZONE-DISP.
           MOVE "VAUTOQUE"     TO SCREEN-NAME.

       1-EXIT.                 EXIT.

      *1-GETZONE-JCW.
      *    MOVE SPACES         TO ZONE-SCREEN-DATA MESSAGE-BUFFER.
      *    MOVE "VGETZONE"     TO SCREEN-NAME.
      *
      *1-SHOWFORM.
      *    MOVE ZONE-SCREEN-DATA TO DISPLAY-REC.
      *    MOVE "00"           TO SCREEN-STATUS.
      *
      *    WRITE DISPLAY-REC   FORMAT IS SCREEN-NAME
      *        INDIC ARE SCREEN-INDICATORS.
      *    IF SCREEN-STATUS NOT = "00"
      *        DISPLAY "SCREEN WRITE ERROR.  SCREEN-STATUS IS "
      *                 SCREEN-STATUS
      *        GO TO END-OF-JOB.
      *
      *    READ  DISPLAY-FILE  FORMAT IS SCREEN-NAME
      *        INDIC ARE SCREEN-INDICATORS
      *    IF SCREEN-STATUS NOT = "00"
      *        DISPLAY "SCREEN READ ERROR.  SCREEN-STATUS IS "
      *                 SCREEN-STATUS
      *        GO TO END-OF-JOB.
      *
      *    MOVE ALL B"0"       TO SCREEN-INDICATORS.
      *    MOVE DISPLAY-REC    TO ZONE-SCREEN-DATA.
      *
      *    IF KEY-HIT = 1 OR 3
      *        GO TO END-OF-JOB.
      *
      *    IF KEY-HIT NOT = 0
      *        GO TO 1-SHOWFORM.
      *
      *    IF ZONE-BUF = SPACES
      **********************************************************************
      **    MESSAGE 052/001:
      ** ZONE IS REQUIRED
      **********************************************************************
      *        MOVE  52        TO CATREAD-MSG-SET
      *        MOVE   1        TO CATREAD-MSG-NUM
      *        PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
      *        MOVE MESSAGE-BUFFER TO ERRMSG1
      *        MOVE 1          TO FIELD-NUMBER
      *        PERFORM 66-ERROR
      *        GO TO 1-SHOWFORM.
      *
      *    MOVE ZONE-BUF       TO Z-ARG.
      *    MOVE ZONE-ARGUMENT  TO ZONEPRTY OF WO-ZONE-PRTY.
      *    READ WO-ZONE-PRTY   INTO ZONE-DATA
      *        INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
      *    IF FILE-STAT NOT = "00"
      **********************************************************************
      **    MESSAGE 035/044:
      ** INVALID ZONE
      **********************************************************************
      *        MOVE  35        TO CATREAD-MSG-SET
      *        MOVE  44        TO CATREAD-MSG-NUM
      *        PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
      *        MOVE MESSAGE-BUFFER TO ERRMSG1
      *        MOVE 1          TO FIELD-NUMBER
      *        PERFORM 66-ERROR
      *        GO TO 1-SHOWFORM.
      *
      *    MOVE ZONE-BUF       TO JCW-ZJCW-269 SETJCW-VALUE.
      *    MOVE 269            TO SETJCW-STARTING-POS.
      *    MOVE 4              TO SETJCW-LENGTH.
      *    CALL "SETJCW"       USING SETJCW-VALUE,
      *                        SETJCW-STARTING-POS,
      *                        SETJCW-LENGTH,
      *                        SETJCW-STATUS.
      *    IF SETJCW-STATUS NOT = "00"
      *        MOVE "    "     TO JCW-ZJCW-269.
      *
      *1-GZJ-EXIT.             EXIT.

       6-MAIN.
           MOVE 0              TO ACT-KEY.
           MOVE SPACES         TO MESSAGE-BUFFER.

           SORT SORT-FILE      DESCENDING KEY SORT-WO-QUEUE
                               SORT-EQUIP SORT-SKILL-1
              INPUT  PROCEDURE SORT-AQ-RECS
              OUTPUT PROCEDURE SORT-AQ-OUT.

           OPEN INPUT          OUT-FILE.
           IF ACT-KEY = 0
               MOVE 1          TO ALARM
               MOVE SPACES     TO SCREEN-DATA
               MOVE SAVE-TITLE TO ZONE-TITLE
               MOVE ZONE-FIELD TO ZONE-DISP
      **********************************************************************
      **    MESSAGE 040/002:
      ** NO WORK ORDERS IN THE BACKLOG FOR THIS ZONE
      **********************************************************************
               MOVE  40        TO CATREAD-MSG-SET
               MOVE   2        TO CATREAD-MSG-NUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER TO CMDMSG2
               GO TO 61-SHOWFORM.

           IF ALARM = 1
               PERFORM 63-ALARM-SCREEN THRU 63-ALARM-EXIT.
           MOVE 0              TO ACT-KEY ALARM.

       61-RESET-SCREEN.
           MOVE SPACES         TO SCREEN-DATA MESSAGE-BUFFER.
           MOVE SAVE-TITLE     TO ZONE-TITLE.
           MOVE ZONE-FIELD     TO ZONE-DISP.
           PERFORM 62-FILL-SCREEN THRU 62-FS-EXIT.

           IF FUNCTION-SW = 1
      **********************************************************************
      **    MESSAGE 031/055:
      ** ENTER AN `R' TO RESERVE A WORKORDER, ENTER AN `X' TO DISPLAY
      **********************************************************************
               MOVE  31        TO CATREAD-MSG-SET
               MOVE  55        TO CATREAD-MSG-NUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER TO CMDMSG2.

       61-PUTBUFFER.
           MOVE SCREEN-DATA    TO SCREEN-SAVE.

       61-SHOWFORM.
           MOVE SCREEN-DATA    TO DISPLAY-REC.
           MOVE "00"           TO SCREEN-STATUS.

       61-WRITEFORM.
           MOVE 0              TO WRITE-CTR.
           IF TIMEOUT-ON
               MOVE TRUE-VAL   TO IND(97).

       61-WRITELOOP.
           WRITE DISPLAY-REC   FORMAT IS SCREEN-NAME
               INDIC ARE SCREEN-INDICATORS.
           IF SCREEN-STATUS = "9I"
               IF WRITE-CTR < 5
                   ADD 1       TO WRITE-CTR
                   CALL "CLAUTOQTO"
                   GO TO 61-WRITELOOP
               ELSE
               DISPLAY "SCREEN WRITE ERROR.  SCREEN-STATUS IS "
                               SCREEN-STATUS
               GO TO END-OF-JOB
           ELSE
           IF SCREEN-STATUS NOT = "00"
               DISPLAY "SCREEN WRITE ERROR.  SCREEN-STATUS IS "
                               SCREEN-STATUS
               GO TO END-OF-JOB.

           IF TIMEOUT-ON
               ADD 1           TO TO-CTR
               IF TO-CTR NOT > TO-CYCLE
                   CALL "CLAUTOQTO"
                   READ DISPLAY-FILE TERMINAL IS TERMINAL-ID
                               INDIC ARE SCREEN-INDICATORS
                       NO DATA GO TO 61-WRITEFORM
               ELSE
                   MOVE 2      TO KEY-HIT
                   MOVE 0      TO TO-CTR
                   GO TO END-READ-CYCLE
           ELSE
               READ  DISPLAY-FILE FORMAT IS SCREEN-NAME
                   INDIC ARE SCREEN-INDICATORS
               IF SCREEN-STATUS NOT = "00"
                   DISPLAY "SCREEN READ ERROR.  SCREEN-STATUS IS "
                               SCREEN-STATUS
                   GO TO END-OF-JOB.

       END-READ-CYCLE.
           MOVE 0              TO TO-CTR.
           MOVE ALL B"0"       TO SCREEN-INDICATORS.
           MOVE DISPLAY-REC    TO SCREEN-DATA.

           IF KEY-HIT = 3
               GO TO END-OF-JOB.

           IF KEY-HIT = 2
               GO TO 6-MAIN.

           IF KEY-HIT = 1
               MOVE "    "     TO JCW-ZJCW-269
               CLOSE           OUT-FILE
               GO TO BEGIN-PROC.

           IF KEY-HIT = 0 OR 4 OR 5
               NEXT SENTENCE
           ELSE
               GO TO 61-SHOWFORM.

           MOVE SPACES         TO DISP-SW MESSAGE-BUFFER.
           IF WO-S1 NOT = SPACE
               MOVE "X"        TO DISP-SW
               MOVE 0          TO WRITE-CTR
               MOVE LINE-1     TO LINE-UP
               MOVE WO-NUM-1   TO DWO-BUFFER
               MOVE WO-NUM-1   TO WO-NUM-TRACK OF WO-TRACK-DATA
               MOVE SPACE      TO WO-S1
               PERFORM 64-DISPLAY-WO THRU 64-EXIT
               IF DESC-UP = " * * *  R E S E R V E D  * * *"
                   MOVE SPACE  TO WO-NUM-SEL
                   MOVE LINE-UP TO LINE-1
                   GO TO 61-PUTBUFFER.

           IF WO-S2 NOT = SPACE
               MOVE "X"        TO DISP-SW
               MOVE 0          TO WRITE-CTR
               MOVE LINE-2     TO LINE-UP
               MOVE WO-NUM-2   TO DWO-BUFFER
               MOVE WO-NUM-2   TO WO-NUM-TRACK OF WO-TRACK-DATA
               MOVE SPACE      TO WO-S2
               PERFORM 64-DISPLAY-WO THRU 64-EXIT
               IF DESC-UP = " * * *  R E S E R V E D  * * *"
                   MOVE SPACE  TO WO-NUM-SEL
                   MOVE LINE-UP TO LINE-2
                   GO TO 61-PUTBUFFER.

           IF WO-S3 NOT = SPACE
               MOVE "X"        TO DISP-SW
               MOVE 0          TO WRITE-CTR
               MOVE LINE-3     TO LINE-UP
               MOVE WO-NUM-3   TO DWO-BUFFER
               MOVE WO-NUM-3   TO WO-NUM-TRACK OF WO-TRACK-DATA
               MOVE SPACE      TO WO-S3
               PERFORM 64-DISPLAY-WO THRU 64-EXIT
               IF DESC-UP = " * * *  R E S E R V E D  * * *"
                   MOVE SPACE  TO WO-NUM-SEL
                   MOVE LINE-UP TO LINE-3
                   GO TO 61-PUTBUFFER.

           IF WO-S4 NOT = SPACE
               MOVE "X"        TO DISP-SW
               MOVE 0          TO WRITE-CTR
               MOVE LINE-4     TO LINE-UP
               MOVE WO-NUM-4   TO DWO-BUFFER
               MOVE WO-NUM-4   TO WO-NUM-TRACK OF WO-TRACK-DATA
               MOVE SPACE      TO WO-S4
               PERFORM 64-DISPLAY-WO THRU 64-EXIT
               IF DESC-UP = " * * *  R E S E R V E D  * * *"
                   MOVE SPACE  TO WO-NUM-SEL
                   MOVE LINE-UP TO LINE-4
                   GO TO 61-PUTBUFFER.

           IF WO-S5 NOT = SPACE
               MOVE "X"        TO DISP-SW
               MOVE 0          TO WRITE-CTR
               MOVE LINE-5     TO LINE-UP
               MOVE WO-NUM-5   TO DWO-BUFFER
               MOVE WO-NUM-5   TO WO-NUM-TRACK OF WO-TRACK-DATA
               MOVE SPACE      TO WO-S5
               PERFORM 64-DISPLAY-WO THRU 64-EXIT
               IF DESC-UP = " * * *  R E S E R V E D  * * *"
                   MOVE SPACE  TO WO-NUM-SEL
                   MOVE LINE-UP TO LINE-5
                   GO TO 61-PUTBUFFER.

           IF WO-S6 NOT = SPACE
               MOVE "X"        TO DISP-SW
               MOVE 0          TO WRITE-CTR
               MOVE LINE-6     TO LINE-UP
               MOVE WO-NUM-6   TO DWO-BUFFER
               MOVE WO-NUM-6   TO WO-NUM-TRACK OF WO-TRACK-DATA
               MOVE SPACE      TO WO-S6
               PERFORM 64-DISPLAY-WO THRU 64-EXIT
               IF DESC-UP = " * * *  R E S E R V E D  * * *"
                   MOVE SPACE  TO WO-NUM-SEL
                   MOVE LINE-UP TO LINE-6
                   GO TO 61-PUTBUFFER.

           IF WO-S7 NOT = SPACE
               MOVE "X"        TO DISP-SW
               MOVE 0          TO WRITE-CTR
               MOVE LINE-7     TO LINE-UP
               MOVE WO-NUM-7   TO DWO-BUFFER
               MOVE WO-NUM-7   TO WO-NUM-TRACK OF WO-TRACK-DATA
               MOVE SPACE      TO WO-S7
               PERFORM 64-DISPLAY-WO THRU 64-EXIT
               IF DESC-UP = " * * *  R E S E R V E D  * * *"
                   MOVE SPACE  TO WO-NUM-SEL
                   MOVE LINE-UP TO LINE-7
                   GO TO 61-PUTBUFFER.

           IF WO-S8 NOT = SPACE
               MOVE "X"        TO DISP-SW
               MOVE 0          TO WRITE-CTR
               MOVE LINE-8     TO LINE-UP
               MOVE WO-NUM-8   TO DWO-BUFFER
               MOVE WO-NUM-8   TO WO-NUM-TRACK OF WO-TRACK-DATA
               MOVE SPACE      TO WO-S8
               PERFORM 64-DISPLAY-WO THRU 64-EXIT
               IF DESC-UP = " * * *  R E S E R V E D  * * *"
                   MOVE SPACE  TO WO-NUM-SEL
                   MOVE LINE-UP TO LINE-8
                   GO TO 61-PUTBUFFER.

           IF WO-S9 NOT = SPACE
               MOVE "X"        TO DISP-SW
               MOVE 0          TO WRITE-CTR
               MOVE LINE-9     TO LINE-UP
               MOVE WO-NUM-9   TO DWO-BUFFER
               MOVE WO-NUM-9   TO WO-NUM-TRACK OF WO-TRACK-DATA
               MOVE SPACE      TO WO-S9
               PERFORM 64-DISPLAY-WO THRU 64-EXIT
               IF DESC-UP = " * * *  R E S E R V E D  * * *"
                   MOVE SPACE  TO WO-NUM-SEL
                   MOVE LINE-UP TO LINE-9
                   GO TO 61-PUTBUFFER.

           IF WO-S10 NOT = SPACE
               MOVE "X"        TO DISP-SW
               MOVE 0          TO WRITE-CTR
               MOVE LINE-10    TO LINE-UP
               MOVE WO-NUM-10  TO DWO-BUFFER
               MOVE WO-NUM-10  TO WO-NUM-TRACK OF WO-TRACK-DATA
               MOVE SPACE      TO WO-S10
               PERFORM 64-DISPLAY-WO THRU 64-EXIT
               IF DESC-UP = " * * *  R E S E R V E D  * * *"
                   MOVE SPACE  TO WO-NUM-SEL
                   MOVE LINE-UP TO LINE-10
                   GO TO 61-PUTBUFFER.

           IF WO-S11 NOT = SPACE
               MOVE "X"        TO DISP-SW
               MOVE 0          TO WRITE-CTR
               MOVE LINE-11    TO LINE-UP
               MOVE WO-NUM-11  TO DWO-BUFFER
               MOVE WO-NUM-11  TO WO-NUM-TRACK OF WO-TRACK-DATA
               MOVE SPACE      TO WO-S11
               PERFORM 64-DISPLAY-WO THRU 64-EXIT
               IF DESC-UP = " * * *  R E S E R V E D  * * *"
                   MOVE SPACE  TO WO-NUM-SEL
                   MOVE LINE-UP TO LINE-11
                   GO TO 61-PUTBUFFER.

           IF WO-S12 NOT = SPACE
               MOVE "X"        TO DISP-SW
               MOVE 0          TO WRITE-CTR
               MOVE LINE-12    TO LINE-UP
               MOVE WO-NUM-12  TO DWO-BUFFER
               MOVE WO-NUM-12  TO WO-NUM-TRACK OF WO-TRACK-DATA
               MOVE SPACE      TO WO-S12
               PERFORM 64-DISPLAY-WO THRU 64-EXIT
               IF DESC-UP = " * * *  R E S E R V E D  * * *"
                   MOVE SPACE  TO WO-NUM-SEL
                   MOVE LINE-UP TO LINE-12
                   GO TO 61-PUTBUFFER.

           IF WO-S13 NOT = SPACE
               MOVE "X"        TO DISP-SW
               MOVE 0          TO WRITE-CTR
               MOVE LINE-13    TO LINE-UP
               MOVE WO-NUM-13  TO DWO-BUFFER
               MOVE WO-NUM-13  TO WO-NUM-TRACK OF WO-TRACK-DATA
               MOVE SPACE      TO WO-S13
               PERFORM 64-DISPLAY-WO THRU 64-EXIT
               IF DESC-UP = " * * *  R E S E R V E D  * * *"
                   MOVE SPACE  TO WO-NUM-SEL
                   MOVE LINE-UP TO LINE-13
                   GO TO 61-PUTBUFFER.

           IF WO-S14 NOT = SPACE
               MOVE "X"        TO DISP-SW
               MOVE 0          TO WRITE-CTR
               MOVE LINE-14    TO LINE-UP
               MOVE WO-NUM-14  TO DWO-BUFFER
               MOVE WO-NUM-14  TO WO-NUM-TRACK OF WO-TRACK-DATA
               MOVE SPACE      TO WO-S14
               PERFORM 64-DISPLAY-WO THRU 64-EXIT
               IF DESC-UP = " * * *  R E S E R V E D  * * *"
                   MOVE SPACE  TO WO-NUM-SEL
                   MOVE LINE-UP TO LINE-14
                   GO TO 61-PUTBUFFER.

           IF DISP-SW = "X"
               MOVE SCREEN-SAVE TO SCREEN-BUFFER
               IF MESSAGE-BUFFER NOT = SPACES
                   MOVE MESSAGE-BUFFER TO ERRMSG2
                   MOVE B"1"   TO IND(99)
               END-IF
               GO TO 61-SHOWFORM.

           IF EOF-SW = 1
               MOVE 0          TO EOF-SW
               CLOSE           OUT-FILE
               GO TO 6-MAIN.

           GO TO 61-RESET-SCREEN.

       62-FILL-SCREEN.
           ADD 1               TO ACT-KEY.
           MOVE SPACES         TO OUT-REC.
           READ OUT-FILE       INVALID KEY
               MOVE 1          TO EOF-SW
               GO TO 62-FS-EXIT.
           IF ACT-KEY > MAX-KEY
               MOVE 1          TO EOF-SW
               GO TO 62-FS-EXIT.
           IF OUT-WO-NUM = R-1 OR R-2 OR R-3 OR R-4 OR R-5
               MOVE " * * *  R E S E R V E D  * * *" TO OUT-DESC.
           MOVE OUT-REC        TO LINE-1.

           ADD 1               TO ACT-KEY.
           MOVE SPACES         TO OUT-REC.
           READ OUT-FILE       INVALID KEY
               MOVE 1          TO EOF-SW
               GO TO 62-FS-EXIT.
           IF ACT-KEY > MAX-KEY
               MOVE 1          TO EOF-SW
               GO TO 62-FS-EXIT.
           IF OUT-WO-NUM = R-1 OR R-2 OR R-3 OR R-4 OR R-5
               MOVE " * * *  R E S E R V E D  * * *" TO OUT-DESC.
           MOVE OUT-REC        TO LINE-2.

           ADD 1               TO ACT-KEY.
           MOVE SPACES         TO OUT-REC.
           READ OUT-FILE       INVALID KEY
               MOVE 1          TO EOF-SW
               GO TO 62-FS-EXIT.
           IF ACT-KEY > MAX-KEY
               MOVE 1          TO EOF-SW
               GO TO 62-FS-EXIT.
           IF OUT-WO-NUM = R-1 OR R-2 OR R-3 OR R-4 OR R-5
               MOVE " * * *  R E S E R V E D  * * *" TO OUT-DESC.
           MOVE OUT-REC        TO LINE-3.

           ADD 1               TO ACT-KEY.
           MOVE SPACES         TO OUT-REC.
           READ OUT-FILE       INVALID KEY
               MOVE 1          TO EOF-SW
               GO TO 62-FS-EXIT.
           IF ACT-KEY > MAX-KEY
               MOVE 1          TO EOF-SW
               GO TO 62-FS-EXIT.
           IF OUT-WO-NUM = R-1 OR R-2 OR R-3 OR R-4 OR R-5
               MOVE " * * *  R E S E R V E D  * * *" TO OUT-DESC.
           MOVE OUT-REC        TO LINE-4.

           ADD 1               TO ACT-KEY.
           MOVE SPACES         TO OUT-REC.
           READ OUT-FILE       INVALID KEY
               MOVE 1          TO EOF-SW
               GO TO 62-FS-EXIT.
           IF ACT-KEY > MAX-KEY
               MOVE 1          TO EOF-SW
               GO TO 62-FS-EXIT.
           IF OUT-WO-NUM = R-1 OR R-2 OR R-3 OR R-4 OR R-5
               MOVE " * * *  R E S E R V E D  * * *" TO OUT-DESC.
           MOVE OUT-REC        TO LINE-5.

           ADD 1               TO ACT-KEY.
           MOVE SPACES         TO OUT-REC.
           READ OUT-FILE       INVALID KEY
               MOVE 1          TO EOF-SW
               GO TO 62-FS-EXIT.
           IF ACT-KEY > MAX-KEY
               MOVE 1          TO EOF-SW
               GO TO 62-FS-EXIT.
           IF OUT-WO-NUM = R-1 OR R-2 OR R-3 OR R-4 OR R-5
               MOVE " * * *  R E S E R V E D  * * *" TO OUT-DESC.
           MOVE OUT-REC        TO LINE-6.

           ADD 1               TO ACT-KEY.
           MOVE SPACES         TO OUT-REC.
           READ OUT-FILE       INVALID KEY
               MOVE 1          TO EOF-SW
               GO TO 62-FS-EXIT.
           IF ACT-KEY > MAX-KEY
               MOVE 1          TO EOF-SW
               GO TO 62-FS-EXIT.
           IF OUT-WO-NUM = R-1 OR R-2 OR R-3 OR R-4 OR R-5
               MOVE " * * *  R E S E R V E D  * * *" TO OUT-DESC.
           MOVE OUT-REC        TO LINE-7.

