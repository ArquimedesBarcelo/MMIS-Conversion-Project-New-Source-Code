001100 IDENTIFICATION DIVISION.
001200 PROGRAM-ID.    SQTDEL2.
001300 AUTHOR.        BARBARA WINTER.
001400*DATE-WRITTEN.  MAY 1990.
001500*INSTALLATION.  GOODYEAR TIRE AND RUBBER CO.
001600*
001700*REMARKS.
001800*************************************************************
001900*                     S Q T D E L 2                         *
002000*   -- DELETES QUOTES THAT HAVE NEVER BEEN RETURNED BY --   *
002100*      THE VENDOR                                           *
002200*   WHEN THE QUOTE IS CREATED, A DATE IS FILLED IN THAT     *
002300*   SPECIFIES WHEN A QUOTE IS TO BE RETURNED TO GOODYEAR    *
002400*   BY THE VENDOR.  THIS PROGRAM LOOKS AT THAT DATE AND     *
002500*   THEN SEES IF THE QUOTE WAS ACTUALLY RETURNED FROM THE   *
002600*   VENDOR BY LOOKING AT THE 'RETURNED' DATE.  IF THIS      *
002700*   DATE IS BLANK, THE QUOTE IS DELETED.                    *
002900*************************************************************
003000 ENVIRONMENT DIVISION.
003100 CONFIGURATION SECTION.
003200 SOURCE-COMPUTER.    HP-3000.
003300 OBJECT-COMPUTER.    HP-3000.
       COPY SPECIALN IN COPYLIB.
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT DISPLAY-FILE
               ASSIGN TO WORKSTATION-ZUDCQUOT-SI
               ORGANIZATION IS TRANSACTION
               ACCESS IS SEQUENTIAL
               FILE STATUS IS DISPLAY-STATUS
               CONTROL-AREA IS WS-CONTROL.

       DATA DIVISION.
       FILE SECTION.
       FD  DISPLAY-FILE
           LABEL RECORDS ARE OMITTED.
       01  DISPLAY-REC                   PIC X(2000).

       WORKING-STORAGE SECTION.
       77  HANDLE-BLOWUP-FLAG            PIC X   VALUE "Y".
       COPY FILESTAT IN COPYLIB.

       COPY CATREAD  IN COPYLIB.

       COPY TBLOWUP  IN COPYLIB.

      *
      * SCREEN AREA
      *

       01  TERMFILENAME                  PIC X(11) VALUE "TERM;".

       01  DE-FIELDS-1  VALUE SPACES.
           05  VIEW-OLDDATE              PIC X(6).
           05  VIEW-EXP-DATE             PIC X(6).
           05  DE-COMMAND-LINE-1         PIC X(79).
           05  DE-MESSAGE-LINE-1         PIC X(79).

       COPY CSWITCHF   IN COPYLIB.

       COPY FUNCTDEF   IN COPYLIB.

       COPY IOFEEDBACK IN COPYLIB.

       COPY TSHWRDFM   IN COPYLIB.

       COPY DISPDAT2   IN COPYLIB.

       COPY HMSGBUF    IN COPYLIB.

       COPY DBSTAT     IN COPYLIB.

       01  PASS-TO-STRMJOB.
           05  PASS-STRM1           PIC X(6)   VALUE SPACES.
           05  PASS-STRM2           PIC X(6)   VALUE SPACES.

       COPY CSTRMJB2 OF COPYLIB.
       COPY TDATECHK OF COPYLIB.

       LINKAGE SECTION.
       01  BASE                     PIC X(10).
       01  PASS-SPOOL               PIC S9(2) COMP-4.
       COPY VCOMLINK OF COPYLIB.
       01  FORMFILE                   PIC X(26).
       COPY LANGSUB  OF COPYLIB.

      *******************************************************************
      *                     PROCEDURE DIVISION
      *******************************************************************
       PROCEDURE DIVISION USING   BASE,
                                  PASS-SPOOL,
                                  VIEW-COMAREA,
                                  FORMFILE,
                                  LANGUAGE-PARMS.

       00-MAIN.
       COPY OPDISPL IN COPYLIB.

      *************************************************************
      *       READ AND VALIDATE INPUT                             *
      *************************************************************
           MOVE "DELETE_QT2" TO VIEW-NFNAME.
           MOVE SPACES        TO MESSAGE-BUFFER, DE-FIELDS-1.
           PERFORM 9999-GETNEXTFORM.
           PERFORM 9999-DO-SCREEN-1.
           PERFORM UNTIL VIEW-LASTKEY EQUAL EXIT-PROGRAM
             IF VIEW-LASTKEY = ENTER-KEY
               IF VIEW-OLDDATE NOT = SPACES
                 MOVE VIEW-OLDDATE TO DATE-VALIDATE-IN
                 MOVE 3 TO DATE-MODE
                 CALL "TDATECK2" USING DATE-CHECK-AREA LANGUAGE-PARMS
                 IF DATE-RET-CODE NOT = 0
                   MOVE DATE-MSG TO MESSAGE-BUFFER
                   MOVE 1 TO SRF-ERROR-FLD
                 END-IF
                 IF VIEW-EXP-DATE NOT = SPACES
                   MOVE VIEW-EXP-DATE TO DATE-VALIDATE-IN
                   MOVE 3 TO DATE-MODE
                   CALL "TDATECK2" USING DATE-CHECK-AREA LANGUAGE-PARMS
                   IF DATE-RET-CODE NOT = 0
                     MOVE DATE-MSG TO MESSAGE-BUFFER
                     MOVE 2 TO SRF-ERROR-FLD
                   END-IF
                 ELSE
      *            ***  DATE REQUIRED  ***
                   MOVE 30 TO LANG-SETNUM
                   MOVE 20 TO LANG-MSGNUM
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE 2 TO SRF-ERROR-FLD
                 END-IF
               ELSE
      *          ***  DATE REQUIRED  ***
                 MOVE 30 TO LANG-SETNUM
                 MOVE 20 TO LANG-MSGNUM
                 PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                 MOVE 1 TO SRF-ERROR-FLD
               END-IF
               IF SRF-ERROR-FLD = 0
                 PERFORM 200-STREAM-DELETE-JOB
               END-IF
             END-IF
             PERFORM 9999-DO-SCREEN-1
             MOVE 0 TO SRF-ERROR-FLD
           END-PERFORM.

           CLOSE DISPLAY-FILE.

       09-EXIT.
           GOBACK.

       200-STREAM-DELETE-JOB.
           MOVE "Y" TO CSTRM-JOBCARD-FLAG.
           MOVE "BQTDL2JB" TO CSTRM-JOBNAME.
           MOVE ":RUN XQTDL2JB.OBJECT;LIB=P"  TO CSTRM-RUN-CARD(1).
           MOVE VIEW-OLDDATE      TO CSTRM-RUN-CARD(2).
           MOVE VIEW-EXP-DATE     TO CSTRM-RUN-CARD(3).
           CALL "CSTRMJB2" USING CSTRMJB2-PARMS VIEW-COMAREA.

       2100-BLOWUP.
           MOVE "SQTDEL2"       TO BU-PGM-NAME.
           MOVE VIEW-OLDDATE    TO BU-DISPLAY-FLD (1).
           MOVE VIEW-EXP-DATE   TO BU-DISPLAY-FLD (2).
           MOVE VIEW-NFNAME     TO BU-DISPLAY-FLD (3).
           CALL "TBLOWUP" USING BASE, BU-PGM-NAME, STATUS-AREA,
                         VIEW-COMAREA, FILE-STATUS, BU-DISPLAY-MSG     ,
                         BU-DISPLAY-FLDS.

       COPY SCRNCALL IN COPYLIB.
       COPY SCRNCL1  IN COPYLIB.
       COPY HCATREAD IN COPYLIB.
