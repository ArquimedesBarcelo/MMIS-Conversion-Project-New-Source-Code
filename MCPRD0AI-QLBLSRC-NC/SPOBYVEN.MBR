017000
       COPY CATREAD OF COPYLIB.
018800
019510 LINKAGE SECTION.
019520 01  BASE                        PIC X(10).
019530 COPY VCOMLINK OF COPYLIB.
019540 COPY LANGSUB  OF COPYLIB.
019550 01  FORMFILE.
019560     05  FORM-FNAME                PIC X(8).
019570     05  FILLER                    PIC X.
019580     05  FORM-GNAME.
019590         10  FORM-GNAME1           PIC X(5).
019600         10  FORM-GNAME2           PIC X(3).
019610     05  FILLER                    PIC X(19).
019800 PROCEDURE DIVISION USING BASE, VIEW-COMAREA, LANGUAGE-PARMS,
019810                          FORMFILE.
019900 0-BEGIN.
020100
           OPEN I-O    DISPLAY-FILE.
           OPEN INPUT DVENDOR-I
                      DPORECD-I
                      DPORECDH-I.
020200     PERFORM 6-MAIN THRU 6-MAIN-X.
           CLOSE DISPLAY-FILE DVENDOR-I DPORECD-I.
020400
020500     GOBACK.
029500 6-MAIN.
030200     MOVE VENDOR-REQUEST  TO  VIEW-NFNAME.
033900 6-PROCESS-FORM1.
           MOVE DE-BUFFER1 TO DISPLAY-REC.
           WRITE DISPLAY-REC FORMAT IS VIEW-NFNAME
              INDIC ARE SRF-INDICATORS.
           MOVE ALL B"0" TO SRF-INDICATORS.

           READ  DISPLAY-FILE FORMAT IS VIEW-NFNAME
               INDIC ARE SRF-INDICATORS.
           ACCEPT IOFEEDBACK FROM I-O-FEEDBACK-AREA.
           MOVE ALL B"0" TO SRF-INDICATORS.
           MOVE DISPLAY-REC TO DE-BUFFER1.

      *------ A BAD STATUS MAY MEAN USER TURNED OFF TERMINAL.
      *------ IF SO, SIMULATE THE F3 KEY TO EXIT PROGRAM.
           IF DISPLAY-STATUS NOT = "00"
               MOVE 3 TO VIEW-LASTKEY
           ELSE
               MOVE FUNCTION-NUM TO VIEW-LASTKEY.
035800
035900     IF VIEW-LASTKEY EQUAL 3
036000        GO TO 6-MAIN-X.

           IF VIEW-LASTKEY EQUAL 1
               MOVE SPACES TO VENCODE-HELP
               CALL "SVENHELP" USING BASE, VIEW-COMAREA
                                 PASS-SPOOL-PRT-NO, LANGUAGE-PARMS,
                                 VENCODE-HELP
               MOVE VENCODE-HELP1-7 TO DE1-VENDOR-7
               MOVE VENCODE-HELP8-10 TO DE1-VENDOR-3
               GO TO 6-MAIN.
036100
      *    IF VIEW-LASTKEY EQUAL 1 OR
9502CZ*       VIEW-LASTKEY EQUAL 2 OR
036400     IF VIEW-LASTKEY EQUAL 8 OR
036500        VIEW-LASTKEY EQUAL 4 OR
036600        VIEW-LASTKEY EQUAL 7
              MOVE 9 TO LANG-SETNUM
              MOVE 10 TO LANG-MSGNUM
036800        PERFORM 940-VSETERROR THRU 949-EXIT
036900        GO TO 6-PROCESS-FORM1.
037000
037100     IF VIEW-LASTKEY EQUAL 8
037200         GO TO  6-MAIN-X
037300     ELSE
037400     IF VIEW-LASTKEY EQUAL 6
037500        NEXT SENTENCE
037600     ELSE
037400     IF VIEW-LASTKEY EQUAL 2
037500        NEXT SENTENCE
037600     ELSE
037400     IF VIEW-LASTKEY EQUAL 0
037500        NEXT SENTENCE
037600     ELSE
037700         MOVE 1  TO  FIELD-NUMBER
037800*M----   ***  INVALID FUNCTION KEY ENTERED  ***
037900         MOVE   9 TO LANG-SETNUM
038000         MOVE  10 TO LANG-MSGNUM
038100         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
038200         PERFORM 940-VSETERROR THRU 949-EXIT
038300         GO TO  6-PROCESS-FORM1.
038400
041700         IF DE-BUFFER1 = SPACES
041800            MOVE 1 TO FIELD-NUMBER
041900*M----      *** MUST ENTER A VENDOR CODE, OR 'F8' ***
042000            MOVE  13 TO LANG-SETNUM
042100            MOVE  38 TO LANG-MSGNUM
042200            PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
042300            PERFORM 940-VSETERROR THRU 949-EXIT
042400            GO TO 6-PROCESS-FORM1.
042500
042600 6-VERIFY-VENDOR-EXISTENCE.
042700
042800************************
042900**  VERIFY VENDOR     **
043000**  CODE  EXISTENCE   **
043100************************
043200
043300     MOVE DE1-VENDOR-CODE TO VEN-ARG.
           MOVE 0 TO COND-WORD.
      *-----  CALL ALT KEY SUB-PGM TO GET ALT KEY IF ONE EXISTS
           MOVE VEN-ARG TO ALT-KEY-ARG.
           CALL "TALTVENK" USING RET-CODE-TALTVENK,
                                 BASE-TALTVENK,
                                 STATUS-AREA,
                                 ALT-KEY-ARG,
                                 ALT-VEND-CODE.
           IF RET-CODE-TALTVENK NOT EQUAL "00"
              MOVE "TALTVENK ERROR 6-VVE" TO BU-DISPLAY-MSG
              PERFORM 990-BLOWUP THRU 999-EXIT.
           MOVE ALT-VEND-CODE   TO VEN-ARG DE1-VENDOR-CODE.
           MOVE ZERO            TO COND-WORD.
           MOVE VEN-ARG TO VENCDE OF DVENDOR-REC-I.
           START DVENDOR-I KEY = VENCDE OF DVENDOR-REC-I
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
                   MOVE 17 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.
047300     IF COND-WORD NOT = 0
              IF COND-WORD = 17
      *    "VENDOR CODE DOES NOT EXIST"
                   MOVE 22 TO LANG-SETNUM
                   MOVE  3 TO LANG-MSGNUM
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   PERFORM 940-VSETERROR THRU 949-EXIT
                   GO TO 6-PROCESS-FORM1
              ELSE
047400        MOVE "*** DBFIND DVENDOR FAILED ***" TO
047500            BU-DISPLAY-MSG
047600        PERFORM 990-BLOWUP THRU 999-EXIT.
047800
047900     MOVE SPACES TO SAVE-PO-VENDOR-NAME.
048000     MOVE SPACES TO SAVE-PO-VENDOR-CSZ.
048100     PERFORM 62-GET-VENDOR THRU 62-GET-VENDOR-X UNTIL
048200         VEN-ITM-NO = "07" OR COND-WORD = 15.
048300
048300     IF VIEW-LASTKEY = 6
048300         GO TO 6-CALL-SINVPOBH
048300     ELSE
048300     GO TO 6-CALL-SINVPOBV.
048300
048400 6-CALL-SINVPOBH.
048600**************************************************
048700**  CALL SINVPOBH PASSING VENDOR CODE.          **
048800**     +++++  HISTORY SEARCH  +++++             **
048900**************************************************
043300     MOVE DE1-VENDOR-CODE TO VEN-ARG.
           MOVE 0 TO COND-WORD.
           MOVE VEN-ARG TO VENCDE OF DPORECDH-REC-I.
           START DPORECDH-I KEY = VENCDE OF DPORECDH-REC-I
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS = "00"
               NEXT SENTENCE
           ELSE
044300          MOVE  1  TO FIELD-NUMBER
044400*M----    *** NO PO'S EXIST IN HISTORY DATABASE ***
044500          MOVE  20 TO LANG-SETNUM
044600          MOVE  73 TO LANG-MSGNUM
044700          PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
044900          PERFORM  940-VSETERROR THRU 949-EXIT
045000          GO TO  6-PROCESS-FORM1.
046600
049000     MOVE DE1-VENDOR-CODE TO VEN-ARG.
049100     CALL "SINVPOBH" USING BASE
049200                           BASE-STHIST
049200                           SCREEN-PRINT-PARMS
049300                           PASS-SPOOL-PRT-NO
049400                           VIEW-COMAREA
049500                           ARGUMENT-VALUES
049600                           SAVE-POINQ-AREA
049700                           SAVE-POBV-AREA
049800                           LANGUAGE-PARMS
049900                           FORMFILE
                                 DE1-BUYER.
050000     GO TO 6-MAIN.
048300
048400 6-CALL-SINVPOBV.
           MOVE 0 TO COND-WORD.
           MOVE VEN-ARG TO VENCDE OF DPORECD-REC-I.
           START DPORECD-I KEY = VENCDE OF DPORECD-REC-I
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
                   MOVE 17 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.
044100     IF COND-WORD EQUAL 17
044300          MOVE  1  TO FIELD-NUMBER
044400*         *** THERE ARE NO PO'S FOR THIS VENDOR ***
044500          MOVE  20 TO LANG-SETNUM
044600          MOVE  51 TO LANG-MSGNUM
044700          PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
044900          PERFORM  940-VSETERROR THRU 949-EXIT
045000          GO TO  6-PROCESS-FORM1.
046600
048600**************************************************
048700**  CALL TINVPOBV PASSING VENDOR CODE.          **
048800**     +++++  LIVE SEARCH  +++++                **
048900**************************************************
049000     MOVE DE1-VENDOR-CODE TO VEN-ARG.
049100     CALL "SINVPOBV" USING BASE
049200                           SCREEN-PRINT-PARMS
049300                           PASS-SPOOL-PRT-NO
049400                           VIEW-COMAREA
049500                           ARGUMENT-VALUES
049600                           SAVE-POINQ-AREA
049700                           SAVE-POBV-AREA
049800                           LANGUAGE-PARMS
049900                           FORMFILE
                                 DE1-BUYER.
050000     GO TO 6-MAIN.
050100 6-MAIN-X.
050200     EXIT.
050300
054700 62-GET-VENDOR.
           MOVE 0 TO COND-WORD.
           READ DVENDOR-I NEXT INTO BUF-DVENDOR
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   MOVE 15 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.
           IF VEN-VEN-CODE NOT = VEN-ARG
               MOVE 15 TO COND-WORD.
055500     IF COND-WORD NOT = 0  AND  COND-WORD NOT = 15
055600        MOVE "DBGET DVENDOR * 6-GET-VENDOR" TO
055700        BU-DISPLAY-MSG
055800        PERFORM 990-BLOWUP THRU 999-EXIT.
055900
           IF COND-WORD = 15
               NEXT SENTENCE
           ELSE
056000     IF VEN-ITM-NO = "00"
056100        MOVE VEN-ITM-DATA TO SAVE-PO-VENDOR-NAME
056300     ELSE
056400     IF VEN-ITM-NO = "07"
056500        MOVE VEN-ITM-DATA TO SAVE-PO-VENDOR-CSZ.
056700
056800 62-GET-VENDOR-X.
056900     EXIT.
057000
128700 940-VSETERROR.
           MOVE B"1" TO IND (99).
           MOVE B"1" TO IND (FIELD-NUMBER).
           MOVE MESSAGE-BUFFER TO DE1-MESSAGE-LINE.
051300
048600 949-EXIT.  EXIT.
204300 990-BLOWUP.
068510     MOVE "SPOBYVEN" TO BU-PGM-NAME.
068600     MOVE VEN-ARG TO BU-DISPLAY-FLD (1).
068700     MOVE PO-ARG TO BU-DISPLAY-FLD (2).
068800     MOVE REQ-ARG TO BU-DISPLAY-FLD (3).
204900     CALL "TBLOWUP" USING BASE, BU-PGM-NAME, STATUS-AREA,
205000                   VIEW-COMAREA, FILE-STATUS, BU-DISPLAY-MSG,
205100                   BU-DISPLAY-FLDS.
205200 999-EXIT.     EXIT.
205300
205400 999-CATREAD.
           IF CATREAD-MSG-NUMBER = ZEROS
               MOVE LANG-SETNUM TO CATREAD-MSG-SET
               MOVE LANG-MSGNUM TO CATREAD-MSG-NUM.
           CALL "CCATREAD" USING CATREAD-PARMS.
           MOVE CATREAD-MSG-TEXT TO MESSAGE-BUFFER.
207000 999-CATREAD-EXIT.
207100     EXIT.
