011730*************************************************************
011740 01  STATUS-AREA.
011750     05  COND-WORD              PIC S9(4)   COMP-4.
011760         88  GOOD-CALL                      VALUE 0.
011770         88  END-OF-FILE                    VALUE 11.
011780         88  START-OF-CHAIN                 VALUE 14.
011790         88  END-OF-CHAIN                   VALUE 15.
011800         88  NO-ENTRY                       VALUE 17.
011810     05  DATA-LENG              PIC S9(4)   COMP-4.
011820     05  RCD-NO                 PIC S9(9)   COMP-4.
011830     05  CHAIN-LENGTH           PIC S9(9)   COMP-4.
011840     05  BKWD-ADDR              PIC S9(9)   COMP-4.
011850     05  FWRD-ADDR              PIC S9(9)   COMP-4.
011860
011860 01  BASE-STHIST                PIC X(10)  VALUE "  STHIST;".
011860
011970 01  PASSWORD                   PIC X(8)   VALUE "JADE;   ".
013200
014800 01  ARGUMENT-VALUES.
014900     05  PLT-ARG               PIC X(4)     VALUE SPACE.
015000     05  PO-ARG                PIC X(14)    VALUE SPACE.
015100     05  VEN-ARG               PIC X(10)    VALUE SPACE.
015200     05  REQ-ARG               PIC X(12)    VALUE SPACE.
015300
015400 01  SAVE-POINQ-AREA.
015500     05  SAVE-COMPANY          PIC X(3)     VALUE SPACE.
015600     05  SAVE-ITEM-NUMBER      PIC X(4)     VALUE SPACE.
015700     05  SAVE-CORPCODE         PIC X(7)     VALUE SPACE.
015800     05  SAVE-PO-COUNT         PIC 9(2)     VALUE ZERO.
015900
016000 01  SAVE-POBV-AREA.
016100     05  SAVE-PO-VENDOR        PIC X(10)    VALUE SPACE.
016200     05  SAVE-PO-VENDOR-NAME   PIC X(44)    VALUE SPACE.
016300     05  SAVE-PO-VENDOR-CSZ    PIC X(44)    VALUE SPACE.
016400
016500 01  BUILD-PO-KEY-VALUE.
016600     05  B-PO-PREFIX           PIC X        VALUE "P".
016700     05  B-PO-NO               PIC X(7)     VALUE SPACE.
016800     05  B-PO-RLSE             PIC X(3)     VALUE SPACE.
016900     05  B-PO-RCV              PIC X(3)     VALUE ZERO.
017000
017100 01  BUILD-REQ-KEY-VALUE.
017200     05  B-REQ-PREFIX          PIC X        VALUE "A".
017300     05  B-REQ-NO              PIC X(6)     VALUE SPACE.
017400     05  B-REQ-PAD             PIC X(5)     VALUE SPACE.
017000
018400 COPY DVENDOR OF COPYLIB.
017000
018600 COPY DPORECD OF COPYLIB.
017000
018600 COPY DPORECDH OF COPYLIB.
017000
