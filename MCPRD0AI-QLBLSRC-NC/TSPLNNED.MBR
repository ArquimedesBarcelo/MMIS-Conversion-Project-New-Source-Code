000200 IDENTIFICATION DIVISION.
000300 PROGRAM-ID.    TSPLNNED.
000500 INSTALLATION.  GOODYEAR.
000700*REMARKS.       THIS PROGRAM SUBMITS AN OFFLINE JOB  THAT
000800*               CREATES A HARD COPY REPORT LISTING PLNNED
000900*               WORK ORDERS THAT HAVE REACHED A CERTAIN %
001000*               OF THEIR ESTIMATED COST.
001100*               IT ALSO CALLS A PROGRAM THAT DISPLAYS THIS
001200*               PERCENT FOR A PARTICULAR WORK ORDER NUMBER.
      *C
      *C 02/27/97     JEFF BUNGO
      *C    READ JOBD FROM MCFPMMJOBD.
      *C
001500 ENVIRONMENT DIVISION.
001600 CONFIGURATION SECTION.
001700 SOURCE-COMPUTER.   AS400.
001800 OBJECT-COMPUTER.   AS400.
       COPY SPECIALN IN COPYLIB.
001900 INPUT-OUTPUT SECTION.
002000 FILE-CONTROL.
           SELECT DISPLAY-FILE
               ASSIGN TO WORKSTATION-ZREPORT-SI
               ORGANIZATION IS TRANSACTION
               ACCESS IS SEQUENTIAL
               FILE STATUS IS DSPLY-STATUS
               CONTROL-AREA IS WS-CONTROL.
           SELECT PLANT-JOBD-FILE ASSIGN TO DATABASE-MCFPMMJOBD.
002500 DATA DIVISION.
002600 FILE SECTION.
       FD  DISPLAY-FILE
           LABEL RECORDS ARE OMITTED.
       01  DSPLY-REC                  PIC X(2000).
       FD  PLANT-JOBD-FILE
           RECORD CONTAINS 10 CHARACTERS.
       01  PLANT-JOBD                 PIC X(10).
003700 WORKING-STORAGE SECTION.
       77  R-C                        PIC 9.
004700 01  BUDGET                     PIC X(14).
       COPY CATREAD OF COPYLIB.
       COPY CPYIND  OF COPYLIB.
005000 01  DBPARAMETERS.              COPY DBPARMS OF COPYLIB.
       01  DSPLY-STATUS               PIC XX.
006400 01  HD-ROUTE-DATA.
006500     05  HD-NAME                PIC X(15) VALUE SPACES.
006600     05  HD-DEPT                PIC X(4)  VALUE SPACES.
006700     05  HD-SPOOLER-NUM         PIC 9(3)  VALUE 0.
006800     05  HD-USER                PIC X(8)  VALUE SPACES.
006900     05  HD-ACCOUNT             PIC X(8)  VALUE SPACES.
007000     05  HD-GROUP               PIC X(8)  VALUE SPACES.
007100     05  HD-TERM                PIC X(4)  VALUE SPACES.
007200     05  HD-PAPER-FLAG          PIC X     VALUE SPACE.
007300         88  PAPER-IS-132-COLS            VALUE "X".
007400     05  HD-PRTRPT-FLAG         PIC X     VALUE SPACE.
007500     05  FILLER                 PIC X(28) VALUE SPACES.
       COPY IOFEEDBACK IN COPYLIB.
008200 COPY LANGSUB    IN COPYLIB.
       01  LINK-DATA.
           05  LINK-58                PIC X(58).
           05  LINK-80                PIC X(80).
           05  FILLER                 PIC X(62).
008800 01  MISC-BUFFER                PIC X(80) VALUE SPACES.
009200 01  PASS-WONUM                 PIC X(10).
009900 01  ROUTE-FIELDS.
010000     05  R-NAME                 PIC X(15).
010100     05  R-DEPT                 PIC X(4).
010200     05  R-PRINTER              PIC 9(3).
010300     05  R-PAPER-FLAG           PIC X.
010400 COPY DBSTAT     IN COPYLIB.
010200 01  STATUS-CHECK               PIC X VALUE "O".
       01  SUBMIT-PGM                 PIC X(10).
       01  SUBMIT-PARM                PIC X(200).
       01  SUBMIT-JOB                 PIC X(10).
       01  SUBMIT-JOBD                PIC X(10).
       01  SUBMIT-OUTQ                PIC X(10).
       01  SUBMIT-USER                PIC X(10).
011200 01  TERM-BUFFER.
           05  TERM-INFO.
011300         10  PERCENT-B          PIC X(2).
011400         10  CODE-B             PIC X.
011500         10  EQPNUM-B           PIC X(6).
011600         10  DEPT-B             PIC X(4).
011700         10  ZONE-B             PIC X(4).
011800         10  WONUM-B            PIC X(10).
011900         10  EXPCLASS-B         PIC X(8).
012000         10  BUDGET-B.
012100            15  BUD1            PIC X(3).
012200            15  BUD2            PIC X(2).
012300            15  BUD3            PIC X(2).
012400            15  BUD4            PIC X(3).
012500         10  REQUEST-B          PIC X(12).
012600         10  SORT-B             PIC X.
           05  TERM-CMD-LINE          PIC X(79).
           05  TERM-ERR-LINE          PIC X(79).
       01  TRUE-VAL                   PIC 1 VALUE B"1".
012900 COPY VCOMLINK  IN COPYLIB.
013000 01  WHO-VARIABLES.
013100     05  MOD                    PIC S9(4) COMP-4.
013200     05  CAP                    PIC S9(8) COMP-4.
013300     05  LATTR                  PIC S9(8) COMP-4.
013400     05  USERNAME               PIC X(8).
013500     05  GRPNAME                PIC X(8).
013600     05  ACCTNAME               PIC X(8).
013700     05  HOMEGRP                PIC X(8).
013800     05  TNUM                   PIC 99 COMP-4.
013900     05  FILLER                 PIC X(2).
       COPY WSCONTROL IN COPYLIB.
014200 PROCEDURE DIVISION.
014300 BEGIN-PAR.
           PERFORM 1-HSK.
           PERFORM 6-MAIN THRU 6-MAIN-EXIT.
       2-EOJ.
           CLOSE DISPLAY-FILE.
           GOBACK.
       1-HSK.
           OPEN I-O   DISPLAY-FILE.
           MOVE SPACES TO TERM-BUFFER.
           CALL "WHO" USING MOD CAP LATTR USERNAME GRPNAME
                        ACCTNAME HOMEGRP TNUM.
           OPEN INPUT PLANT-JOBD-FILE.
           READ PLANT-JOBD-FILE NEXT.
           CLOSE PLANT-JOBD-FILE.
       6-MAIN.
           IF INDS (99) = TRUE-VAL
               MOVE MISC-BUFFER TO TERM-ERR-LINE
           ELSE
           MOVE SPACES TO MISC-BUFFER TERM-ERR-LINE.
019000     MOVE "PERCENTG1" TO VIEW-CFNAME.
           MOVE TERM-BUFFER TO DSPLY-REC.
020500     PERFORM 99-SCREEN-WRITE.
           PERFORM 98-SCREEN-READ.
           IF VIEW-LASTKEY = 3 GO TO 2-EOJ.
           MOVE DSPLY-REC TO TERM-BUFFER.
024800     MOVE SPACES TO BUDGET.
024900     STRING BUD1 "-" BUD2 "-" BUD3 "-" BUD4 DELIMITED BY SIZE
025000         INTO BUDGET.
025100     MOVE 0 TO R-C.
025200     IF PERCENT-B = SPACES
025300         IF WONUM-B = SPACES
025400             MOVE TRUE-VAL TO INDS (1) INDS (99)
025600             MOVE 42021 TO CATREAD-MSG-NUMBER
025800             PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE MISC-BUFFER TO TERM-CMD-LINE
026400             GO TO 6-MAIN.
026500     MOVE 0 TO R-C.
026600     IF EXPCLASS-B NOT = SPACES ADD 1 TO R-C.
026700     IF BUDGET-B   NOT = SPACES ADD 1 TO R-C.
026800     IF REQUEST-B  NOT = SPACES ADD 1 TO R-C.
026900     IF R-C > 1
028300         MOVE 29022 TO CATREAD-MSG-NUMBER
028500         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE TRUE-VAL TO INDS (R-C) INDS (99)
029000         GO TO 6-MAIN.
029100     IF WONUM-B = SPACES
032600         MOVE SPACES TO ROUTE-FIELDS HD-ROUTE-DATA
024600         MOVE "ROUTE" TO VIEW-CFNAME
               MOVE ROUTE-FIELDS TO DSPLY-REC
025300         PERFORM 99-SCREEN-WRITE
               PERFORM 98-SCREEN-READ
               MOVE DSPLY-REC TO ROUTE-FIELDS
032900         MOVE R-NAME TO HD-NAME
033000         MOVE R-DEPT TO HD-DEPT
033100         MOVE R-PAPER-FLAG TO HD-PAPER-FLAG
035000         MOVE USERNAME TO HD-USER
035100         MOVE ACCTNAME TO HD-ACCOUNT
035200         MOVE GRPNAME TO HD-GROUP
035300         MOVE TNUM TO HD-TERM
025400         PERFORM 6-SUBMIT-PLNNED
030300     ELSE
030400     MOVE WONUM-B TO PASS-WONUM
030500     CALL "TPLNNEDD" USING PASS-WONUM STATUS-CHECK MISC-BUFFER
030600                           VIEW-COMAREA DBPARAMETERS
030700                           LANGUAGE-PARMS
030800     IF STATUS-CHECK = "E"
030900         MOVE SPACES TO TERM-BUFFER
031000     ELSE
031100     IF STATUS-CHECK = "O"
031200         MOVE "PERCENTG1" TO VIEW-CFNAME
               MOVE SPACES TO TERM-BUFFER
031900         GO TO 6-MAIN
032000     ELSE
032100     IF STATUS-CHECK = "D"
               MOVE TRUE-VAL TO INDS (7) INDS (99)
               GO TO 6-MAIN.

       6-MAIN-EXIT.    EXIT.
040900
041100 6-SUBMIT-PLNNED.
           MOVE "CLSPLNNED"   TO  SUBMIT-PGM.
           MOVE SPACES        TO  LINK-DATA.
           MOVE TERM-INFO     TO  LINK-58.
           MOVE HD-ROUTE-DATA TO  LINK-80.
           MOVE LINK-DATA     TO  SUBMIT-PARM.
           MOVE "TSPLNNED"    TO  SUBMIT-JOB.
           MOVE PLANT-JOBD    TO  SUBMIT-JOBD.
           MOVE "*JOBD"       TO  SUBMIT-OUTQ.
           MOVE "*JOBD"       TO  SUBMIT-USER.
           CALL "CLSUBMIT"  USING SUBMIT-PGM
                                  SUBMIT-PARM
                                  SUBMIT-JOB
                                  SUBMIT-JOBD
                                  SUBMIT-OUTQ
                                  SUBMIT-USER.

       98-SCREEN-READ.
           READ DISPLAY-FILE FORMAT IS VIEW-CFNAME
               INDIC IS INDICS.
           ACCEPT IOFEEDBACK FROM I-O-FEEDBACK-AREA.
           MOVE ALL B"0" TO INDICS.
           IF DSPLY-STATUS NOT = "00"
               MOVE 3 TO VIEW-LASTKEY
           ELSE
           MOVE FUNCTION-NUM TO VIEW-LASTKEY.

       99-SCREEN-WRITE.
           WRITE DSPLY-REC FORMAT IS VIEW-CFNAME
               INDIC IS INDICS.
           MOVE ALL B"0" TO INDICS.

046200
046400 999-CATREAD.
046500     MOVE SPACES TO MISC-BUFFER.
           CALL "CCATREAD" USING CATREAD-PARMS.
           MOVE CATREAD-MSG-TEXT TO MISC-BUFFER.
048100 999-CATREAD-EXIT.    EXIT.
