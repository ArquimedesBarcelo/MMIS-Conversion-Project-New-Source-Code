029300
029400 PROCEDURE DIVISION USING BASE,
029500                          VIEW-COMAREA,
029600                          LANGUAGE-PARMS,
029700                          MPLTINFO-PARMS,
029800                          MULTIPLE-DB-PLANT,
029900                          BASE-AREA.
030000
030300 0-BEGIN-HERE.
030400     PERFORM 1-HSK.
030500     PERFORM 6-MAIN THRU 6-MAIN-X.
030700
031200 2-EOJ.
      *##############################################################
031300*####IF ALL-DBS-OPEN-SW NOT = "N" AND
031400*####    MULTIPLE-DB-PLANT = "Y"
031500*####        MOVE 0 TO DB-SUB
031600*####        PERFORM 2-CLOSE-ALL-DBS THRU 2-CADB-X.
      *##############################################################
           CLOSE DCODE, DDESC, DDESC2, MALTKEY, MKEYADJ-I,
               MSTORERM-I.
031700     GOBACK.
031800
031900
      *##############################################################
032000*2-CLOSE-ALL-DBS.
032100*####ADD 1 TO DB-SUB.
032200*####IF BASES (DB-SUB) = SPACES OR DB-SUB = 10
032300*####    GO TO 2-CADB-X.
032400*####
032500*####IF BASE-PLT (DB-SUB) = MPLTINFO-PLANT-CODE
032600*####    GO TO 2-CLOSE-ALL-DBS.
032700*####
      *##############################################################
032800*    CALL "DBCLOSE" USING BASES (DB-SUB), DSET-MSTORERM,
032900*        MODE1, STATUS-AREA.
033000*    IF NOT GOOD-CALL
033100*        MOVE "DBCLOSE ERR * 2-CLOSE-ALL-DBS"
033200*            TO BU-DISPLAY-MSG
033300*        MOVE BASES (DB-SUB)       TO BU-DISPLAY-FLD (1)
033400*        PERFORM 2-BLOWUP.
033500*####
033600*####GO TO 2-CLOSE-ALL-DBS.
033700*####
033800*2-CADB-X.
033900*####EXIT.
034000
030800 1-HSK.
           OPEN INPUT MKEYADJ-I, MSTORERM-I.
           OPEN I-O DCODE, DDESC, DDESC2, DISPLAY-FILE, MALTKEY.
030900     MOVE "SDSCTRNS" TO BU-PGM-NAME.
031000     MOVE MPLTINFO-PLANT-CODE TO PLANT-CHK.
031100
034100*********************************************************
034200**                  BLOWUP ROUTINE                     **
034300*********************************************************
034400
034500 2-BLOWUP.
034600     CALL "TBLOWUP" USING BASE, BU-PGM-NAME, STATUS-AREA,
034700           VIEW-COMAREA, DUMMY-KSAM-STAT, BU-DISPLAY-MSG,
034800           BU-DISPLAY-AREA.
043900
044000*********************************************************
044100**             M A I N      P R O G R A M              **
044200*********************************************************
044300
044600 6-MAIN.
035100*    MOVE "DSCTRNS" TO VIEW-NFNAME.
035200*    PERFORM 998-WRITE-SCREEN THRU 998-READ-SCREEN.
044800
044900 60-TRNS-DESC.
045000     MOVE SPACES TO SAVE-AREA-PICX.
045100     MOVE "DSCTRNS1" TO VIEW-NFNAME.
046900     MOVE SPACES          TO CODE-SCREEN.
047000***  ENTER STORES CODE AND PRESS 'ENTER'  ***
047100     MOVE   5 TO LANG-SETNUM.
047200     MOVE  20 TO LANG-MSGNUM.
047300     PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
047400     MOVE MESSAGE-BUFFER TO MSG-LINE.
       60-TD-CONT.
           MOVE CODE-SCREEN TO DISPLAY-REC.
           PERFORM 998-WRITE-SCREEN THRU 998-READ-SCREEN.

049800     IF VIEW-LASTKEY = 3
049900         GO TO 6-MAIN-X.
050000
050500     IF VIEW-LASTKEY = 1 OR
050600        VIEW-LASTKEY = 2 OR
050700        VIEW-LASTKEY = 4 OR
050800        VIEW-LASTKEY = 5 OR
050900        VIEW-LASTKEY = 6 OR
051000        VIEW-LASTKEY = 7 OR
              VIEW-LASTKEY = 8
051100*****    INVALID FUNCTION KEY    *****
051200         MOVE   9 TO LANG-SETNUM
051300         MOVE  10 TO LANG-MSGNUM
051400         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER TO ERR-LINE
051500         MOVE B"1" TO INDS(99)
051600         GO TO 60-TD-CONT.
051700
           MOVE DISPLAY-REC TO CODE-SCREEN.
           MOVE SPACES TO CMD-LINE, ERR-LINE.

053800 60-EDIT-CODE.
           MOVE 0 TO COND-WORD.
053900     MOVE CODE-STORES TO SAVE-CODE-STORES, CODE-ARG,
                               CORPCDE OF MSTORERM-REC-I.
054000     READ MSTORERM-I INTO BUF-MSTORERM
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF FILE-STATUS NOT = "00" MOVE 17 TO COND-WORD.
054400     IF COND-WORD NOT = 0
054500       IF COND-WORD = 17
054600*****    STORES CODE DOES NOT EXIST   *****
054700         MOVE  19 TO LANG-SETNUM
054800         MOVE   9 TO LANG-MSGNUM
054900         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER TO ERR-LINE
055000         MOVE B"1" TO INDS(1) INDS(99)
055200         GO TO 60-TD-CONT
055300       ELSE
055400         MOVE "DBGET MSTORERM ERROR IN 60-EDIT-CODE"
055500             TO BU-DISPLAY-MSG
055600         PERFORM 2-BLOWUP.
055700
055800
055900 60-RETRIEVE-DATA.
056000***  NOW RETRIEVING DATA  ***
056100     MOVE  14 TO LANG-SETNUM.
056200     MOVE  27 TO LANG-MSGNUM.
056300     PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
           MOVE B"1" TO INDS(98).
056400     MOVE MESSAGE-BUFFER TO CMD-LINE.
           MOVE CODE-SCREEN TO DISPLAY-REC.
           PERFORM 998-WRITE-SCREEN.
           PERFORM 998A-READ-SCREEN.
           MOVE SPACES TO CMD-LINE.
056600
056700     PERFORM 62-RETRIEVE-DDESC.
056800
056900     PERFORM 63-RETRIEVE-DDESC2.
057000
057100     IF SAVE-CODE-KWM1 = SPACES
057200         MOVE "YES"          TO KWM1-DCODE-FLAG
057300         MOVE SAVE-CODE-KWM2 TO SAVE-CODE-KWM1.
057400
057500     IF SAVE-CODE-KWM2 = SPACES
057600         MOVE "YES"          TO KWM2-DCODE-FLAG
057700         MOVE SAVE-CODE-KWM1 TO SAVE-CODE-KWM2.
057800
057900***** THE AMERICAN LANGUAGE DESCRIPTION ASSOCIATED         *****
058000***** WITH A CORPORATE CODE IS NOT TO BE MODIFIED USING    *****
058100***** THIS PROGRAM.   THESE CHANGES MUST BE MADE ON THE    *****
058200***** IBM SYSTEM AND DOWNLOADED TO THE PLANT.              *****
058300*****                                                      *****
058400***** THE FOLLOWING IF STATEMENT DIRECTS EXECUTION TO      *****
058500***** DIFFERENT PARAGRAPHS DEPENDING ON WHETHER THE CODE   *****
058600***** IS A CORPORATE CODE, AND WHICH DATASET AMERICAN      *****
058700***** LANGUAGE DESCRIPTION TEXT IS MAINTAINED.             *****
058800*****                                                      *****
058900***** IF MPLTINFO-DDESC-LANG = "001" (AMERICAN)            *****
059000*****   THE CORPORATE DESCRIPTION IS MAINTAINED IN DDESC.  *****
059100*****                                                      *****
059200***** IF MPLTINFO-DDESC2-LANG = "001" (AMERICAN)           *****
059300*****   THE CORPORATE DESCRIPTION IS MAINTAINED IN DDESC2. *****
059400
059500     MOVE CODE-STORES TO CODE-CHK-IN.
059600
059700     CALL "CCODECHK" USING CCODECHK-PARMS.
059800
059900     IF  CODE-IS-CORP-CODE
060000        IF MPLTINFO-DDESC-LANG = "001"
060100           MOVE "2" TO KWM-REPLACE-SW, DESC-REPLACE-SW
060200           PERFORM 66-ALLOW-MOD-DDESC2 THRU 66-ALLOW-MOD-DDESC2-X
060300        ELSE
060400          IF MPLTINFO-DDESC2-LANG = "001"
060500             MOVE "1" TO KWM-REPLACE-SW, DESC-REPLACE-SW
060600             PERFORM 65-ALLOW-MOD-DDESC THRU 65-ALLOW-MOD-DDESC-X
060700          ELSE
060800             MOVE "B" TO KWM-REPLACE-SW, DESC-REPLACE-SW
