064500* RETRIEVE DESCRIPTION TEXT IN DDESC (REC-ID=9 THRU 23) *
064600*********************************************************
064700
064800 62-RETRIEVE-DDESC.
           MOVE 0 TO COND-WORD.
           MOVE CODE-ARG TO CORPCDE OF DDESC-REC.
           MOVE "00"     TO DESCIDNUM OF DDESC-REC.
           START DDESC KEY = EXTERNALLY-DESCRIBED-KEY
               INVALID KEY    MOVE FILE-STATUS TO FILE-STATUS.
           IF (FILE-STATUS NOT = "00") AND (FILE-STATUS-1 NOT = "2")
065200         MOVE "FIND DDESC ERROR IN 62-RETRIEVE-DDESC"
065300             TO BU-DISPLAY-MSG
065400         PERFORM 2-BLOWUP.
065500
065600     MOVE SPACES TO SAVE-DESC-TBL, BUF-DDESC.
065700     SET SDESC-INDEX TO 1.
065800
065900     PERFORM 621-GET-DDESC THRU 621-GD-EXIT
066000        UNTIL (SDESC-INDEX IS GREATER THAN 15)
                  OR (COND-WORD = 15).
066200
066300     IF SDESC-INDEX IS GREATER THAN 8
066400         MOVE "YES" TO IF-MORE-DDESC.
066500
066600
066700 621-GET-DDESC.
           MOVE 0 TO COND-WORD.
           READ DDESC NEXT INTO BUF-DDESC
               AT END    MOVE 15 TO COND-WORD.
           IF FILE-STATUS NOT = "00" MOVE 15 TO COND-WORD.
           IF DESC-CORP-CODE NOT = CODE-ARG MOVE 15 TO COND-WORD.
           IF COND-WORD = 15 GO TO 621-GD-EXIT.
067400
067500     IF DESC-ID-NUM = "00"
067600         MOVE DESC-KW       TO SAVE-CODE-KW1
067700         MOVE DESC-MOD      TO SAVE-CODE-MOD1
067800     ELSE
067900     IF DESC-ID-NUM NOT = "99"
068000         MOVE DESC-DATA TO SAVE-DESC (SDESC-INDEX)
068100         SET SDESC-INDEX UP BY 1.
       621-GD-EXIT.    EXIT.
068200
068300*********************************************************
068400* RETRIEVE DESCRIPTION TEXT IN DDESC2 (REC-ID=9 THRU 23)*
068500*********************************************************
068600
068700 63-RETRIEVE-DDESC2.
           MOVE 0 TO COND-WORD.
           MOVE CODE-ARG TO CORPCDE OF DDESC2-REC.
           MOVE "00"     TO DESCIDNUM OF DDESC2-REC.
           START DDESC2 KEY = EXTERNALLY-DESCRIBED-KEY
               INVALID KEY    MOVE FILE-STATUS TO FILE-STATUS.
           IF (FILE-STATUS NOT = "00") AND (FILE-STATUS-1 NOT = "2")
069100         MOVE "FIND DDESC2 ERROR IN 63-RETRIEVE-DDESC2"
069200             TO BU-DISPLAY-MSG
069300         PERFORM 2-BLOWUP.
069400
069500     MOVE SPACES TO SAVE-DESC2-TBL, BUF-DDESC2.
069600     SET SDESC2-INDEX TO 1.
