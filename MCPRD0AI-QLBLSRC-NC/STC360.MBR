000200 IDENTIFICATION DIVISION.
000300 PROGRAM-ID.
000400          STC360.
000500 AUTHOR.
000600     KURT MOVSESIAN.
000800
000900***************************************************************
001000*                                                             *
001100*   S T C 3 6 0                                               *
001200*                                                             *
001300*   THIS SUB PROGRAM CUTS TCs 360, & 361                      *
001400*   FOR PURCHASE ORDER HEADER                                 *
001500*                                                             *
001600***************************************************************
      *                                                             *
      *C*  06/18/1996  CA YODER                                     *
      *C*    RECOMPILED TO PICK UP CENTURY DATABASE CHANGES.        *
      *C*                                                           *
      ***************************************************************
001700
001800 ENVIRONMENT DIVISION.
001900 CONFIGURATION SECTION.
002000 SOURCE-COMPUTER.  HP-3000.
002100 OBJECT-COMPUTER.  HP-3000.
002200
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT DDAILYTC
                  ASSIGN TO DATABASE-MCFLCS1601
                  ORGANIZATION IS INDEXED
                    ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                    WITH DUPLICATES
                  FILE STATUS IS FILE-STATUS.

           SELECT DVENDOR-I
                  ASSIGN TO DATABASE-MCFLCS0701
                  ORGANIZATION IS INDEXED
                    ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                    WITH DUPLICATES
                  FILE STATUS IS FILE-STATUS.

002300 DATA DIVISION.
       FILE SECTION.
       FD  DDAILYTC
           LABEL RECORDS ARE STANDARD.
       01  DDAILYTC-REC.
           COPY DDS-ALL-FORMATS  OF MCFLCS1601.

       FD  DVENDOR-I
           LABEL RECORDS ARE STANDARD.
       01  DVENDOR-REC-I.
           COPY DDS-ALL-FORMATS  OF MCFLCS0701.

002400
002500 WORKING-STORAGE SECTION.
002600
       01  FILE-STATUS.
           05  FILE-STATUS-1            PIC X  VALUE "0".
           05  FILE-STATUS-2            PIC X  VALUE "0".

002700 01  DATES-AND-TIMES.
002800     05  HP-CUR-DATE.
002900         10  MM                PIC XX.
003000         10  FILLER            PIC X.
003100         10  DD                PIC XX.
003200         10  FILLER            PIC X.
003300         10  YY                PIC XX.
003400     05  CUR-DATE.
003500         10  YY.
003600             15 FILLER         PIC X.
003700             15 YR-YR          PIC X.
003800         10  MM                PIC XX.
003900         10  DD                PIC XX.
004000
004100
004200**************************************************************
004300**************************************************************
004400**                                                          **
004500**                DATABASE I/O BUFFER AREA                  **
004600**                                                          **
004700**************************************************************
004800**************************************************************
004900
005000 COPY DDAILYTC IN COPYLIB.
005100
005200 COPY TC360 IN COPYLIB.
005300
005400 COPY DVENDOR IN COPYLIB.
005500
005600
005700*********************
005800*                   *
005900*   DATA SET NAMES  *
006000*                   *
006100*********************
006200
006300 01  DSET-NAMES.
006400     05  DSET-NAME              PIC X(16)  VALUE SPACES.
006500     05  DSET-DDAILYTC          PIC X(16)  VALUE "DDAILYTC;".
006600     05  DSET-DVENDOR           PIC X(16)  VALUE "DVENDOR;".
006700
006800 01 ITEMS-LISTING.
006900     05  VEN-SEARCH             PIC X(10) VALUE "VEN-CODE;".
007000     05  ALL-ITEMS              PIC XX    VALUE "@;".
007100     05  VEN-ARG                PIC X(10) VALUE SPACES.
007200
007300 COPY DBMODES IN COPYLIB.
007400
007500
007600 LINKAGE SECTION.
007700
007800 01  BASE             PIC X(10).
007900
008000 01  COMPANY-SAVE     PIC X(3).
008100
008200 01  STC360-TC        PIC X(3).
008300
008400 COPY DPORECD IN COPYLIB.
008500
008600 COPY DBSTAT IN COPYLIB.
008700
008800 01  BU-DISPLAY-MSG.
008900     05  BU-DISPLAY-MSG-1         PIC X(1).
009000     05  FILLER                   PIC X(59).
009100
009200 01  BU-DISPLAY-FLDS.
009300     05  BU-DISPLAY-LINE  OCCURS 5 TIMES.
009400         10  BU-DISPLAY-FLD       PIC X(14).
009500         10  BU-DISPLAY-FLD9      PIC S9(8).
009600
009700
009800
009900 PROCEDURE DIVISION USING  BASE,
010000                           COMPANY-SAVE,
010100                           STC360-TC,
010200                           BUF-DPORECD,
010300                           STATUS-AREA,
010400                           BU-DISPLAY-MSG,
010500                           BU-DISPLAY-FLDS.
010600
010700
010800 STC360 SECTION 02.
010900
011000 BEGIN-HERE.
           OPEN INPUT DVENDOR-I.
           OPEN I-O DDAILYTC.

011100     PERFORM 6-MAIN THRU 6-M-X.

           CLOSE DVENDOR-I, DDAILYTC.
011200
011300     GOBACK.
011400
011500
011600******************************************************
011700**                                                  **
011800**   BLOWUP ROUTINE                                 **
011900**                                                  **
012000******************************************************
012100
012200 2-BLOWUP.
012300     MOVE "STC360"             TO  BU-DISPLAY-FLD (5).
012400     MOVE PO-RCV-NO            TO  BU-DISPLAY-FLD (4).
012500     GOBACK.
012600
012700
012800 6-MAIN.
012900*----------- MAKE SURE THE TC CODE PASSED IS EITHER 360 OR 361
013000     IF STC360-TC = "360" OR "361"
013100         NEXT SENTENCE
013200     ELSE
013300         MOVE "INVALID TC CODE NOT 360/361" TO BU-DISPLAY-MSG
013400         GO TO 2-BLOWUP.
013500
014100     MOVE SPACES               TO  BUF-DDAILYTC.
014200*    MOVE CURRENT-DATE         TO  HP-CUR-DATE.
014300*    MOVE CORR HP-CUR-DATE     TO  CUR-DATE.
           ACCEPT CUR-DATE FROM DATE.
014400     MOVE CUR-DATE             TO  DDAILYTC-DATE.
014500*    MOVE TIME-OF-DAY          TO  DDAILYTC-TIME.
           ACCEPT DDAILYTC-TIME FROM TIME.
014600     MOVE COMPANY-SAVE         TO  DDAILYTC-PLT.
014700     MOVE STC360-TC            TO  DDAILYTC-TC.
014800     MOVE PO-RCV-NO            TO  TC360-PO-RLS.
014900     MOVE PO-FOB               TO  TC360-PO-FOB.
015000     MOVE PO-VEN-CODE          TO  TC360-VENDOR-CODE,
015100                                   VEN-ARG.
015200     MOVE PO-TERMS             TO  TC360-PO-TERMS.
015300     MOVE PO-CURRENCY-CODE     TO  TC360-CURRENCY-CODE.
           MOVE 0 TO COND-WORD.
           MOVE VEN-ARG TO VENCDE OF DVENDOR-REC-I.
           START DVENDOR-I KEY = VENCDE OF DVENDOR-REC-I
               INVALID KEY MOVE 17 TO COND-WORD.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
                   MOVE 17 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.
015400*    CALL "DBFIND" USING BASE, DSET-DVENDOR, MODE1,
015500*        STATUS-AREA, VEN-SEARCH, VEN-ARG.
015600     IF COND-WORD NOT = 0
015700         MOVE "FIND DVENDOR *6-MAIN" TO BU-DISPLAY-MSG
015800         MOVE VEN-ARG          TO BU-DISPLAY-FLD (3)
015900         GO TO 2-BLOWUP.
           MOVE 0 TO COND-WORD.
           READ DVENDOR-I NEXT INTO BUF-DVENDOR
               AT END MOVE 15 TO COND-WORD.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14"
                   MOVE 15 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.
           IF VENCDE OF DVENDOR-REC-I NOT = VEN-ARG
               MOVE 15 TO COND-WORD.
016000*    CALL "DBGET" USING BASE, DSET-DVENDOR, MODE5,
016100*        STATUS-AREA, ALL-ITEMS, BUF-DVENDOR, VEN-ARG.
016200     IF COND-WORD NOT = 0
016300         IF COND-WORD = 15
016400             NEXT SENTENCE
016500         ELSE
016600             MOVE "GET DVENDOR * 6-MAIN" TO BU-DISPLAY-MSG
016700             MOVE VEN-ARG TO BU-DISPLAY-FLD (3)
016800             GO TO 2-BLOWUP.
016900
017000     IF VEN-ITM-NO = 0
017100         MOVE VEN-NAME            TO TC360-VENDOR-NAME
017200     ELSE
017300         MOVE "VEN NAME NOT FOUND" TO TC360-VENDOR-NAME.
017400
           MOVE 0 TO COND-WORD.
           WRITE DDAILYTC-REC FROM BUF-DDAILYTC
               INVALID KEY MOVE 99 TO COND-WORD.
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD.
017500*    CALL "DBPUT" USING BASE, DSET-DDAILYTC, MODE1,
017600*        STATUS-AREA, ALL-ITEMS, BUF-DDAILYTC.
017700     IF COND-WORD NOT = ZERO
017800         MOVE "PUT DDAILYTC * 6-M"  TO  BU-DISPLAY-MSG
017900         GO TO 2-BLOWUP.
018700
018800 6-M-X.
018900     EXIT.
