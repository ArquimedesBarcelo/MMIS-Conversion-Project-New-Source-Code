       IDENTIFICATION DIVISION.
       PROGRAM-ID. TCNOTICE.
       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.
       SOURCE-COMPUTER. AS400.
       OBJECT-COMPUTER. AS400.
       COPY SPECIALN OF COPYLIB.
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT AUTH-FILE
               ASSIGN TO DATABASE-MCFLCSAUTH
               ORGANIZATION IS INDEXED
               ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
               FILE STATUS IS FILE-STATUS.

           SELECT DISPLAY-FILE
               ASSIGN TO WORKSTATION-ZCNOTICE-SI
               ORGANIZATION IS TRANSACTION
               ACCESS IS SEQUENTIAL
               FILE STATUS IS DSPLY-STATUS
               CONTROL-AREA IS WS-CONTROL.

           SELECT DPOITEM
               ASSIGN TO DATABASE-MCFLCS1002
               ORGANIZATION IS INDEXED
               ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
               FILE STATUS IS FILE-STATUS.

           SELECT DPORECD
               ASSIGN TO DATABASE-MCFLCS0901
               ORGANIZATION IS INDEXED
               ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
               FILE STATUS IS FILE-STATUS.

           SELECT DVENDOR
               ASSIGN TO DATABASE-MCFLCS0701
               ORGANIZATION IS INDEXED
               ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                   WITH DUPLICATES
               FILE STATUS IS FILE-STATUS.

           SELECT MPLTINFO
               ASSIGN TO DATABASE-MCFLCS0501
               ORGANIZATION IS INDEXED
               ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
               FILE STATUS IS FILE-STATUS.

           SELECT ONLINE-PRT ASSIGN TO PRINTER-MCPRT.

       DATA DIVISION.
       FILE SECTION.
       FD  AUTH-FILE
           LABEL RECORDS ARE STANDARD
           DATA RECORD IS AF-REC.
       01  AF-REC.
           COPY DDS-ALL-FORMATS  OF MCFLCSAUTH.

       FD  DISPLAY-FILE
           LABEL RECORDS ARE OMITTED.
       01  DSPLY-REC             PIC X(2000).

       FD  DPOITEM
           LABEL RECORDS ARE STANDARD.
       01  DPOITEM-REC.
           COPY DDS-ALL-FORMATS  OF MCFLCS1002.

       FD  DPORECD
           LABEL RECORDS ARE STANDARD.
       01  DPORECD-REC.
           COPY DDS-ALL-FORMATS  OF MCFLCS0901.

       FD  DVENDOR
           LABEL RECORDS ARE STANDARD.
       01  DVENDOR-REC.
           COPY DDS-ALL-FORMATS  OF MCFLCS0701.

       FD  MPLTINFO
           LABEL RECORDS ARE STANDARD.
       01  MPLTINFO-REC.
           COPY DDS-ALL-FORMATS  OF MCFLCS0501.

       FD  ONLINE-PRT
           LABEL RECORDS ARE OMITTED
           RECORD CONTAINS 80 CHARACTERS
           DATA RECORD IS PRINT-RCD.
       01  PRINT-RCD.
           05  PRINT-LINE        PIC X(80).

       WORKING-STORAGE SECTION.
       77  LINE-CTR              PIC 99   VALUE 59.
       77  OK-PRT                PIC X.
       77  SUB                   PIC S9(4) COMP.

       01  AUTH-BUF.
           05  AUTH-USERNAME     PIC X(10).
           05  AUTH-PRICE-SW     PIC X.
           05  FILLER            PIC X(09).

       01  BUILD-PO-ARG.
           05  FILLER            PIC X    VALUE "P".
           05  BUILD-PO-7        PIC X(7) VALUE SPACES.
           05  BUILD-PO-REL      PIC X(3) VALUE SPACES.
           05  FILLER            PIC X(3) VALUE "000".

       COPY CPYIND     IN COPYLIB.

       01  CURRENT-DATE-WA.
           05  CD-Y              PIC 99.
           05  CD-M              PIC 99.
           05  CD-D              PIC 99.

       01  CURRENT-TIME.
           05  CUR-TIME          PIC X(4).
           05  FILLER            PIC 99.

       COPY DBSTAT     IN COPYLIB.

       COPY DPOITEM    IN COPYLIB.

       COPY DPORECD    IN COPYLIB.

       COPY DVENDOR    IN COPYLIB.

       01  DSPLY-STATUS          PIC XX.

       01  DTL1.
           05  FILLER  PIC X(7)  VALUE "DATE   ".
           05  D1-DATE PIC X(8)  VALUE SPACES.
           05  FILLER  PIC X(6)  VALUE SPACES.
           05  FILLER  PIC X(11) VALUE "----REASON ".
           05  FILLER  PIC X(28)
               VALUE "(USE X OR TYPE IN OTHER)----".
           05  FILLER  PIC X(23) VALUE SPACES.

       01  DTL2.
           05  FILLER  PIC X(7)  VALUE "REQ #  ".
           05  D2-REQ  PIC X(12) VALUE SPACES.
           05  FILLER  PIC X(4)  VALUE SPACES.
           05  FILLER  PIC X(13) VALUE "CHANGE PRICE".
           05  D2-CHP  PIC X(4)  VALUE SPACES.
           05  FILLER  PIC X(3)  VALUE SPACES.
           05  FILLER  PIC X(11) VALUE "CHANGE QTY ".
           05  D2-CHQ  PIC X(4)  VALUE SPACES.
           05  FILLER  PIC X(3)  VALUE SPACES.
           05  FILLER  PIC X(13) VALUE "ADD TO ORDER ".
           05  D2-ATO  PIC X(4)  VALUE SPACES.
           05  FILLER  PIC X(2)  VALUE SPACES.

       01  DTL3.
           05  FILLER  PIC X(7)  VALUE "PO #   ".
           05  D3-PO   PIC X(12) VALUE SPACES.
           05  FILLER  PIC X(4)  VALUE SPACES.
           05  FILLER  PIC X(13) VALUE "CANCEL ITEM  ".
           05  D3-CI   PIC X(4)  VALUE SPACES.
           05  FILLER  PIC X(3)  VALUE SPACES.
           05  FILLER  PIC X(11) VALUE "CANCEL PO# ".
           05  D3-CPO  PIC X(4)  VALUE SPACES.
           05  FILLER  PIC X(3)  VALUE SPACES.
           05  FILLER  PIC X(13) VALUE "NEW ITEM     ".
           05  D3-NI   PIC X(4)  VALUE SPACES.
           05  FILLER  PIC X(3)  VALUE SPACES.

       01  DTL4.
           05  FILLER  PIC X(7)  VALUE "BUYER  ".
           05  D4-BUY  PIC X(12) VALUE SPACES.
           05  FILLER  PIC X(4)  VALUE SPACES.
           05  FILLER  PIC X(13) VALUE "OBSOLETE IT  ".
           05  D4-OBS  PIC X(4)  VALUE SPACES.
           05  FILLER  PIC X(3)  VALUE SPACES.
           05  FILLER  PIC X(11) VALUE "SCRAP      ".
           05  D4-SCR  PIC X(4)  VALUE SPACES.
           05  FILLER  PIC X(3)  VALUE SPACES.
           05  FILLER  PIC X(13) VALUE "ERROR        ".
           05  D4-ERR  PIC X(4)  VALUE SPACES.
           05  FILLER  PIC X(2)  VALUE SPACES.

       01  DTL5.
           05  FILLER  PIC X(11) VALUE SPACES.
           05  FILLER  PIC X(7)  VALUE "OTHER:".
           05  D5-OTH  PIC X(40) VALUE SPACES.
           05  FILLER  PIC X(22) VALUE SPACES.

       01  DTL6.
           05  FILLER  PIC X(17) VALUE SPACES.
           05  D6-VEN  PIC X(44) VALUE SPACES.
           05  FILLER  PIC X(19) VALUE SPACES.

       01  DTL7.
           05  FILLER  PIC X(9)  VALUE SPACES.
           05  D7-ITM  PIC Z(4).
           05  FILLER  PIC X(3)  VALUE SPACES.
           05  D7-QTY  PIC Z(8).
           05  FILLER  PIC X(3)  VALUE SPACES.
           05  D7-CDE  PIC X(30) VALUE SPACES.
           05  FILLER  PIC X(4)  VALUE SPACES.
           05  D7-PRI  PIC Z(10).
           05  FILLER  PIC X(9)  VALUE SPACES.

       01  DTL8.
           05  FILLER  PIC X(9)  VALUE SPACES.
           05  FILLER  PIC X(10) VALUE "REMARKS:  ".
           05  D8-RM1  PIC X(20) VALUE SPACES.
           05  FILLER  PIC X(2)  VALUE SPACES.
           05  FILLER  PIC X(29)
               VALUE "ESTIMATED PRICE:  INCREASE $".
           05  D8-PRI  PIC Z(10).

       01  DTL9.
           05  FILLER  PIC X(9)  VALUE SPACES.
           05  D9-RM2  PIC X(30) VALUE SPACES.
           05  FILLER  PIC X(41) VALUE SPACES.

       01  DTL10.
           05  FILLER  PIC X(9)  VALUE SPACES.
           05  FILLER  PIC X(13) VALUE "RECORDS ONLY ".
           05  D10-RO  PIC X(2)  VALUE SPACES.
           05  FILLER  PIC X     VALUE SPACE.
           05  FILLER  PIC X(14) VALUE "CPY TO VENDOR ".
           05  D10-CP  PIC X(2)  VALUE SPACES.
           05  FILLER  PIC X(18) VALUE SPACES.
           05  FILLER  PIC X(11) VALUE "DECREASE $ ".
           05  D10-PRI PIC Z(10).

       01  DTL11.
           05  FILLER  PIC X(39) VALUE SPACES.
           05  FILLER  PIC X(10) VALUE "AUTHORITY ".
           05  D11-AU  PIC X(20) VALUE SPACES.
           05  FILLER  PIC X     VALUE SPACE.
           05  FILLER  PIC X(5)  VALUE "DEPT ".
           05  D11-DP  PIC X(4)  VALUE SPACES.
           05  FILLER  PIC X     VALUE SPACE.

       01  FILE-STATUS           PIC XX.

       01  HDR0.
           05  FILLER  PIC X(37) VALUE SPACES.
           05  FILLER  PIC X(6)  VALUE "STORES".
           05  FILLER  PIC X(37) VALUE SPACES.

       01  HDR1.
           05  FILLER  PIC X(27) VALUE SPACES.
           05  FILLER  PIC X(12) VALUE "REQUEST FOR ".
           05  FILLER  PIC X(13) VALUE "CHANGE NOTICE".
           05  FILLER  PIC X(28) VALUE SPACES.

       01  HDR3.
           05  FILLER  PIC X(27) VALUE SPACES.
           05  FILLER  PIC X(25) VALUE ALL "_".
           05  FILLER  PIC X(28) VALUE SPACES.

       01  HDR4.
           05  FILLER  PIC X(17) VALUE SPACES.
           05  FILLER  PIC X(13) VALUE "((((((((((   ".
           05  FILLER  PIC X(18) VALUE "VENDOR INFORMATION".
           05  FILLER  PIC X(13) VALUE "   ))))))))))".
           05  FILLER  PIC X(19) VALUE SPACES.

       01  HDR5.
           05  FILLER  PIC X(33) VALUE SPACES.
           05  FILLER  PIC X(11) VALUE "DESCRIPTION".
           05  FILLER  PIC X(17) VALUE SPACES.
           05  FILLER  PIC X(6)  VALUE "PRICE ".
           05  FILLER  PIC X(13) VALUE SPACES.

       01  HDR6.
           05  FILLER  PIC X(80) VALUE ALL "_".

       01  HDR7.
           05  FILLER  PIC X(26) VALUE SPACES.
           05  FILLER  PIC X(23)
               VALUE "----ORDER NOW READS----".
           05  FILLER  PIC X(31) VALUE SPACES.

       01  HDR8.
           05  FILLER  PIC X(9)  VALUE SPACES.
           05  FILLER  PIC X(4)  VALUE "ITM#".
           05  FILLER  PIC X(3)  VALUE SPACES.
           05  FILLER  PIC X(8)  VALUE "QUANTITY".
           05  FILLER  PIC X(3)  VALUE SPACES.
           05  FILLER  PIC X(32)
               VALUE "STORES CODE OR OTHER DESCRIPTION".
           05  FILLER  PIC X(21) VALUE SPACES.

       01  HDR9.
           05  FILLER  PIC X(26) VALUE SPACES.
           05  FILLER  PIC X(23)
               VALUE "----CHANGE TO READ----".
           05  FILLER  PIC X(31) VALUE SPACES.

