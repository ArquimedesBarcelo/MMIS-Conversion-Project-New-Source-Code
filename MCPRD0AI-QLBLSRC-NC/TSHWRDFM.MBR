046300     05  SRF-PADDING               PIC X(44).
046400
046500 01  BU-DISPLAY-MSG.
046600     05  BU-DISPLAY-MSG-1-7.
046700         10  BU-DISPLAY-MSG-1      PIC X(1).
046800         10  FILLER                PIC X(6).
046900     05  BU-DISPLAY-MSG-8-60       PIC X(53).
047000
047100 01  VIEW-COMAREA.
047200     05  VIEW-STATUS           PIC S9(4) COMP-4.
047300     05  VIEW-LANGUAGE         PIC S9(4) COMP-4.
047400     05  VIEW-COMAREALEN       PIC S9(4) COMP-4.
047500     05  VIEW-USERBUFLEN       PIC S9(4) COMP-4.
047600     05  VIEW-MODE             PIC S9(4) COMP-4.
047700     05  VIEW-LASTKEY          PIC S9(4) COMP-4.
047800     05  VIEW-NUMERRS          PIC S9(4) COMP-4.
047900     05  VIEW-WINDOWENH        PIC S9(4) COMP-4.
048000     05  VIEW-MULTIUSAGE       PIC S9(4) COMP-4.
048100     05  VIEW-LABELOPT         PIC S9(4) COMP-4.
048200     05  VIEW-CFNAME           PIC X(16).
048300     05  VIEW-NFNAME           PIC X(16).
048400     05  VIEW-REPEATOPT        PIC S9(4) COMP-4.
048500     05  VIEW-NFOPT            PIC S9(4) COMP-4.
048600     05  VIEW-CFNUMLINES       PIC S9(4) COMP-4.
048700     05  VIEW-DBUFLEN          PIC S9(4) COMP-4.
048800     05  FILLER                PIC S9(4) COMP-4.
048900     05  VIEW-LOOKAHEAD        PIC S9(4) COMP-4.
049000     05  VIEW-DELETEFLAG       PIC S9(4) COMP-4.
049100     05  VIEW-SHOWCONTROL      PIC S9(4) COMP-4.
049200     05  FILLER                PIC S9(4) COMP-4.
049300     05  VIEW-PRINTFILNUM      PIC S9(4) COMP-4.
049400     05  VIEW-FILERRNUM        PIC S9(4) COMP-4.
049500     05  VIEW-ERRFILENUM       PIC S9(4) COMP-4.
049600     05  VIEW-FORMSTORESIZE    PIC S9(4) COMP-4.
049700     05  FILLER                PIC S9(4) COMP-4.
049800     05  FILLER                PIC S9(4) COMP-4.
049900     05  FILLER                PIC S9(4) COMP-4.
050000     05  VIEW-NUMRECS          PIC S9(8) COMP-4.
050100     05  VIEW-RECNUM           PIC S9(8) COMP-4.
050200     05  FILLER                PIC S9(4) COMP-4.
