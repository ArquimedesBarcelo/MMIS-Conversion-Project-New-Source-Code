053500         10  SRF-SPOOL-NO          PIC 9(2).
053600**************************************
053700*    NATIVE LANGUAGE SUPPORT AREA    *
053800**************************************
053900
054000 COPY LANGSUB IN COPYLIB.
       01  SCREEN-BUFFER                      PIC X(2000).
       01  SCREEN-BUFFER-AREA REDEFINES SCREEN-BUFFER.
           05  SCR-BUF-BYTE OCCURS 2000 TIMES PIC X(1).

       PROCEDURE DIVISION USING SRF-COMAREA,
                                BU-DISPLAY-MSG,
                                VIEW-COMAREA,
                                SRF-BASE,
                                SRF-STATUS-AREA,
                                SRF-SPOOLER-REC,
                                LANGUAGE-PARMS,
                                SCREEN-BUFFER.

       6000-MAIN.
           MOVE 0 TO SAVE-VIEW-LASTKEY.
           MOVE 0 TO SUB.
           MOVE SPACES TO SAVE-ERROR-FROM.
           MOVE 0 TO PLACE-CURSOR-FIELD.
           IF SRF-CALL-COUNT < 9
               ADD 1 TO SRF-CALL-COUNT
               IF SRF-CALL-COUNT = 1
                   MOVE "Y" TO SRF-FIRST-TIME-SW
               ELSE
                   MOVE "N" TO SRF-FIRST-TIME-SW.

           MOVE VIEW-CFNAME TO TEST-FORMFILE-NAME.
           MOVE VIEW-NFNAME TO HOLD-FORM-NAME.
           IF TEST-FORMFILE-NAME NOT = HOLD-FORMFILE-NAME
               IF FIRST-CALL-SW = "Y"
                   MOVE "N" TO FIRST-CALL-SW
                   MOVE TEST-FORMFILE-NAME TO HOLD-FORMFILE-NAME
                   STRING "OVRDSPF FILE(ZSHWRDFM) TOFILE(",
                     HOLD-FORMFILE-NAME, ")",
                     DELIMITED BY SIZE INTO OVRDSPF-WORK
                   CALL "QCMDEXC" USING OVRDSPF-WORK, OVRDSPF-LEN
                   OPEN I-O DISPLAY-FILE
               ELSE
                   CLOSE DISPLAY-FILE
                   MOVE TEST-FORMFILE-NAME TO HOLD-FORMFILE-NAME
                   STRING "OVRDSPF FILE(ZSHWRDFM) TOFILE(",
                     HOLD-FORMFILE-NAME, ")",
                     DELIMITED BY SIZE INTO OVRDSPF-WORK
                   CALL "QCMDEXC" USING OVRDSPF-WORK, OVRDSPF-LEN
                   OPEN I-O DISPLAY-FILE.

           IF (SRF-KEYSET < 0) OR (SRF-KEYSET > 8)
               MOVE 7 TO SRF-KEYSET.

           IF SRF-KEYSET > 0
               PERFORM 7500-MOVE-KEY-DEFAULTS 8 TIMES.

      *------ FOR IBM, 'F3' IS THE END PROG KEY INSTEAD OF 'F8'.
      *------ SO WE SWAP 'F3' AND 'F8'.
           MOVE FKEY (8) TO SAVE-FKEY.
           MOVE FKEY (3) TO FKEY (8).
           MOVE SAVE-FKEY TO FKEY (3).

       6100-SHOW-FORM.
           MOVE SCREEN-BUFFER TO DISPLAY-REC.

           IF SRF-ERROR-SW = "Y"
               MOVE B"1" TO IND(99).
           WRITE DISPLAY-REC  FORMAT IS HOLD-FORM-NAME
                 INDIC ARE SRF-INDICATORS.
           MOVE B"0" TO IND(99).
           IF SRF-CALL-MODE = 3
               GO TO 6150-READ-FIELDS.

      *------- CALL IN MODE 4 MEAN ONLY TO A WRITE OF THE SCREEN
      *------- SO LETS SKIP TO THE END OF THE PROGRAM NOW
           IF SRF-CALL-MODE = 4
               GO TO 6990-MAIN-X.

           IF SRF-MPLTINFO-FLAG = "Y"
               IF SRF-MPLTINFO-COMPANY = SPACES
                   PERFORM 7100-GET-MPLTINFO THRU 7190-GM-X
                   IF COND-WORD NOT = 0
                       MOVE "GET MPLTINFO ERR TSHWRDF"
                         TO BU-DISPLAY-MSG
                       MOVE 2 TO SRF-RET-CODE
                       GO TO 6990-MAIN-X.

       6150-READ-FIELDS.
           READ  DISPLAY-FILE FORMAT IS HOLD-FORM-NAME
                 INDIC ARE SRF-INDICATORS.
           ACCEPT IOFEEDBACK FROM I-O-FEEDBACK-AREA.
           MOVE ALL B"0" TO SRF-INDICATORS.
           MOVE "N" TO SRF-ERROR-SW.

      *------ A BAD STATUS MAY MEAN USER TURNED OFF TERMINAL.
      *------ IF SO, SIMULATE THE F3 KEY TO EXIT PROGRAM.
           IF DISPLAY-STATUS NOT = "00"
               MOVE 3 TO VIEW-LASTKEY
           ELSE
               MOVE FUNCTION-NUM TO VIEW-LASTKEY.

           MOVE DISPLAY-REC TO SCREEN-BUFFER.

063800*------ IF MODE IS 3 GO DIRECTLY TO THE END OF ROUTINE AND
063900*------ GOBACK SINCE ALL MODE3 DOES IN 'VSHOWFORM' AND
064000*------ 'VREADFIELDS'
064100
064200     IF SRF-CALL-MODE = 3
064300         GO TO 9999-GOBACK.
064400
064500     IF VIEW-LASTKEY = 0
064600         IF SRF-ENTER-FLAG = "I"
065700*           "E28: 'ENTER' NOT VALID HERE"
064800             MOVE   5 TO LANG-SETNUM
064900             MOVE  28 TO LANG-MSGNUM
065000             PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
065100             PERFORM 9610-PUTWINDOW
065200             GO TO 6100-SHOW-FORM
065300         ELSE
065400             GO TO 6990-MAIN-X.
065500
      *------ FOR IBM, THE FLOP SCRN, REFRESH, CLEAR FORM, AND PRINT
      *------ SCRN FUNCTIONS ARE INVALID. (CLR FORM DOES'NT WORK CAUSE
      *------ SCRN MIGHT HAVE NUMERIC FIELDS, CAN'T JUST SPACE OUT).
065600     IF FKEY-B1 (VIEW-LASTKEY) = "I" OR "F" OR "R" OR "C" OR "P"
064700*        "I10: INVALID FUNCTION KEY"
065800         MOVE   9 TO LANG-SETNUM
065900         MOVE  10 TO LANG-MSGNUM
066000         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
066100         PERFORM 9610-PUTWINDOW
066200         GO TO 6100-SHOW-FORM.
066300
072400     IF FKEY-B1 (VIEW-LASTKEY) = "C"
072500         PERFORM 9400-CLEAR-FORM THRU 9490-CF-X
072600         IF VIEW-STATUS NOT = 0
072700             GO TO 6990-MAIN-X
072800         ELSE
072900         IF FKEY-B3 (VIEW-LASTKEY) = "F"
073000             PERFORM 9600-SHOWFORM
073100             GO TO 6990-MAIN-X
073200         ELSE
073300             GO TO 6100-SHOW-FORM.
073400
       6990-MAIN-X.
075700*------ CLEAR THE MESSAGE WINDOW BEFORE RETURNING
075800*------ TO MAIN PROGRAM.
075900     IF BU-DISPLAY-MSG-1 NOT = SPACES
076000         MOVE 9                    TO   SRF-RET-CODE
076100         GO TO 9999-GOBACK.
      *------ CAN'T CLEAR FORM ON THE IBM: BECAUSE YOU MUST CLEAR BUF
076200*    PERFORM 9400-CLEAR-FORM.
076300*------ RESET THE ENTER FLAG TO SPACES.
076400     MOVE SPACES                   TO   SRF-ENTER-FLAG.
076500*------ FKEY DEFINITIONS ARE RESET TO SPACES EACH CALL
076600     MOVE SPACES                   TO   FKEY-AREA.
076700*------ RESET THE PLACE CURSOR FIELD: CALLING PROG MUST SET
076800*------ EACH TIME.
076900     MOVE ZERO                     TO   SRF-CURSOR-FLD.
      *------ SO HP PROGS DON'T HAVE TO CHANGE, SWAP THE F3 AND
      *------ F8 KEYS: F3 ACTUALLY EXITS PROGRAM, BUT THE CALLING PROG
      *------ THINKS IT'S 'F8'.
           IF VIEW-LASTKEY = 3
               MOVE 8 TO VIEW-LASTKEY
           ELSE
           IF VIEW-LASTKEY = 8
               MOVE 3 TO VIEW-LASTKEY.

           GO TO 9999-GOBACK.
077000
078100 7100-GET-MPLTINFO.
078200*    CALL "DBGET" USING SRF-BASE, DSET-MPLTINFO, MODE7,
078300*      SRF-STATUS-AREA, ALL-ITEM-LIST, SRF-BUF-MPLTINFO,
078400*      MPLTINFO-ARG.
           OPEN INPUT MPLTINFO.
           MOVE 0 TO COND-WORD.
           MOVE MPLTINFO-ARG TO PLTINFOKEY OF MPLTINFO-REC.
           READ MPLTINFO INTO SRF-BUF-MPLTINFO INVALID KEY
                MOVE 17 TO COND-WORD.
           CLOSE MPLTINFO.
078500 7190-GM-X.
078600     EXIT.

080700 7500-MOVE-KEY-DEFAULTS.
080800     ADD 1                         TO   SUB.
080900*------- USER MAY OVERRIDE INDIVIDUAL FUNCTION KEYS WITHIN KEYSET.
081000     IF FKEY (SUB) = SPACES
081100         MOVE FUNCTION-KEY (SRF-KEYSET, SUB) TO FKEY (SUB).
081200
086000 9400-CLEAR-FORM.
086100     MOVE SPACES                   TO   SCREEN-BUFFER.
       9490-CF-X.
           EXIT.

       9600-SHOWFORM.
           MOVE SCREEN-BUFFER TO DISPLAY-REC.

           IF SRF-ERROR-SW = "Y"
               MOVE B"1" TO IND(99).
           WRITE DISPLAY-REC  FORMAT IS HOLD-FORM-NAME
                 INDIC ARE SRF-INDICATORS.
           MOVE B"0" TO IND(99).

       9610-PUTWINDOW.
            MOVE "Y" TO SRF-ERROR-SW.
            MOVE B"1" TO IND (1).
      *------ MOVE THE MESSAGE BUFFER INTO THE SCREEN BUFFER.
      *------ THE MESSAGE LINE DOESNT COUNT IN THE REC LEN,
      *------ BECAUSE ITS OUTPUT ONLY. SO WE HAVE TO START
      *------ 79 BYTES BEYOND THE END OF THE COMMAND LINE (WE
      *------ LOAD THE MSG IN BACKWARD STARTING FROM END)
            MOVE 76 TO SUB.
            ADD IO-REC-LEN, 79 GIVING SUB2.
            SUBTRACT 3 FROM SUB2.
            PERFORM 9620-MOVE-MSG 76 TIMES.

       9620-MOVE-MSG.
           MOVE MSG-BYTE (SUB) TO SCR-BUF-BYTE (SUB2).
           SUBTRACT 1 FROM SUB.
           SUBTRACT 1 FROM SUB2.

       999-CATREAD.
           MOVE LANG-SETNUM TO CATREAD-MSG-SET.
           MOVE LANG-MSGNUM TO CATREAD-MSG-NUM.
           CALL "CCATREAD" USING CATREAD-PARMS.
           MOVE CATREAD-MSG-TEXT TO MESSAGE-BUFFER.
       999-CATREAD-EXIT.
           EXIT.

       9999-GOBACK.
           GOBACK.

