       IDENTIFICATION DIVISION.
       PROGRAM-ID.    TSHWRDFM.
       AUTHOR.        C.I.HILLES.
      *INSTALLATION.  GOODYEAR TIRE AND RUBBER - AKRON.
       DATE-COMPILED.
       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.
       SOURCE-COMPUTER. IBM-AS400.
       OBJECT-COMPUTER. IBM-AS400.
       SPECIAL-NAMES.
           I-O-FEEDBACK IS I-O-FEEDBACK-AREA.

       INPUT-OUTPUT SECTION.

       FILE-CONTROL.
           SELECT DISPLAY-FILE
                  ASSIGN TO WORKSTATION-ZSHWRDFM-SI
                  ORGANIZATION IS TRANSACTION
                  ACCESS IS SEQUENTIAL
                  FILE STATUS IS DISPLAY-STATUS
                  CONTROL-AREA IS WS-CONTROL.

           SELECT MPLTINFO
                  ASSIGN TO DATABASE-MCFLCS0501
                  ORGANIZATION IS INDEXED
                    ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                  FILE STATUS IS MPLTINFO-STATUS.

       DATA DIVISION.
       FILE SECTION.
       FD  DISPLAY-FILE
           LABEL RECORDS ARE OMITTED.
       01  DISPLAY-REC                       PIC X(2000).

       FD  MPLTINFO
           LABEL RECORDS ARE STANDARD.
       01  MPLTINFO-REC.
           COPY DDS-MCRPCS0500  OF MCFLCS0501.

       WORKING-STORAGE SECTION.

       01  FIRST-CALL-SW                     PIC X(1) VALUE "Y".
       01  HOLD-FORM-NAME                    PIC X(10).
       01  HOLD-FORMFILE-NAME                PIC X(10) VALUE SPACES.
       01  TEST-FORMFILE-NAME                PIC X(10).
       01  OVRDSPF-WORK                      PIC X(70).
       01  OVRDSPF-LEN      PIC S9(10)V9(5) COMP-3 VALUE 70.

024900 77  SAVE-VIEW-LASTKEY             PIC S9(4) COMP-4 VALUE 0.
025000 77  VERR-COUNT                    PIC S9(4) COMP-4 VALUE 0.
025100 77  SUB                           PIC S9(4) COMP-3 VALUE 0.
025100 77  SUB2                          PIC S9(4) COMP-3 VALUE 0.
025200 77  FIVE-VIEW-ERRORS              PIC X(1)  VALUE "N".
025300 77  SAVE-ERROR-FROM               PIC X(8)  VALUE SPACES.
025400 77  PLACE-CURSOR-FIELD            PIC S9(4) COMP VALUE 0.
       77  SAVE-FKEY                     PIC X(5).
025500
025600*         f1---f2---f3---f4---f5---f6---f7---f8---
025700 01  FUNCTION-KEY-TABLE.
025800     05  FILLER                    PIC X(40) VALUE
025900         "               RA   P         CA        ".
026000     05  FILLER                    PIC X(40) VALUE
026100         "               RA   P                   ".
026200     05  FILLER                    PIC X(40) VALUE
026300         "                    P         CA        ".
026400     05  FILLER                    PIC X(40) VALUE
026500         "                    P                   ".
026600     05  FILLER                    PIC X(40) VALUE
026700         "          I    RA   P    I    CA        ".
026800     05  FILLER                    PIC X(40) VALUE
026900         "          I    RA   P    I              ".
027000     05  FILLER                    PIC X(40) VALUE
027100         "I    I    I    RA   P    I    CA        ".
027200     05  FILLER                    PIC X(40) VALUE
027300         "I    I    I    RA   P    I              ".
027400
027500 01  FUNCTION-KEY-TABLE-AREA REDEFINES FUNCTION-KEY-TABLE.
027600     05  FUNCTION-KEY-LINE OCCURS 8 TIMES.
027700         10  FUNCTION-KEY OCCURS 8 TIMES PIC X(5).

       01  DISPLAY-STATUS              PIC X(2).
       01  MPLTINFO-STATUS             PIC X(2).
       01  MPLTINFO-ARG                PIC X(4)  VALUE "P 01".

      *------ WS CONTROL AREA
       01  MAJOR-MINOR                 PIC XXXX.
       01  WS-CONTROL.
           02  FUNCTION-NUM            PIC XX.
                   88  EXIT-KEY-F8-USED                     VALUE "08". LVW000LS
                   88  REFRESH-KEY-F4-USED                  VALUE "04". LVW000LS
                   88  ENTER-KEY-USED                       VALUE "00". LVW000LS
                   88  F1-KEY-USED                          VALUE "01". LVW000LS
                   88  F2-KEY-USED                          VALUE "02". LVW000LS
                   88  F3-KEY-USED                          VALUE "03". LVW000LS
                   88  F4-KEY-USED                          VALUE "04". LVW000LS
                   88  F5-KEY-USED                          VALUE "05". LVW000LS
                   88  F6-KEY-USED                          VALUE "06". LVW000LS
                   88  F7-KEY-USED                          VALUE "07". LVW000LS
                   88  F8-KEY-USED                          VALUE "08". LVW000LS
           02 FUN-KEY REDEFINES FUNCTION-NUM PIC XX.
           02 TERMINAL-ID PIC X(10).
           02 FORMAT-NAME PIC X(10).
      *

       COPY CATREAD IN COPYLIB.
       COPY IOFEEDBACK IN COPYLIB.

       01  MESSAGE-BUFFER.
           05  MSG-BYTE OCCURS 76 TIMES PIC X(1).

