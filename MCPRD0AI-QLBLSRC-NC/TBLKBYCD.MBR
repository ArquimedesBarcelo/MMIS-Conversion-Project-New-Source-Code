029900**********************************************************************
030000**********************************************************************
030100**    PROCESS REPORT OF REQUIREMENT ORDERS BY CORPORATE CODE        **
030200**********************************************************************
030300**********************************************************************
030400 PROCEDURE DIVISION USING HD-ROUTE-DATA SORT-DATA.
030500 00-MAIN.
030600
030700      PERFORM 050-INITIALIZATION THRU 059-EXIT.
030800
030900      SORT  SORT-FILE
031000            ASCENDING KEY SORT-CORP-CODE
031100            DESCENDING KEY SORT-EXP-DATE-CN
031200            INPUT PROCEDURE IS 7-INPUT THRU 799-EXIT
031300            OUTPUT PROCEDURE IS 8-OUTPUT THRU 899-EXIT.
031400
031500      PERFORM 090-END-PROGRAM THRU 099-EXIT.
031600      GOBACK.
031700
031800 050-INITIALIZATION.
031900
032000*----------  SET UP PRINTER ESCAPE SEQUENCES
032100     CALL "TESCSEQ" USING ESC-NAME.
032200     MOVE CHAR-1636PI     TO COMPRESS-PRINT.
032300     MOVE CHAR-10PI       TO NORMAL-PRINT.
032400     MOVE TEXT-LENGTH-61 TO ESC-TEXT-61.
032500     MOVE TEXT-LENGTH-60 TO ESC-TEXT-60.
078400*----------  OPEN OUTPUT FILE
           MOVE HD-SPOOLER-NUMBER TO OVRPRTF-TOFILE-NUM.
           MOVE "*YES"       TO OVRPRTF-SHARED.
028100     MOVE HD-NO-OF-COPIES TO OVRPRTF-COPIES.
           MOVE "MCPRT"      TO OVRPRTF-FILE.
           PERFORM 996-OVERRIDE-PRINT-FILE.
032800     OPEN OUTPUT PRINT-REPORT-FILE.
032900
021900*----------  PRINT HEADER PAGE
022100     MOVE "DHDR72.PUB" TO HD-FILE-NAME.
022200     CALL "THDPRT2" USING HD-RET-CODE, HD-FILE-NAME,
022300        FNUM, HD-ROUTE-DATA, ESC-NAME.
022400     IF PAPER-IS-132-COLS
022500          NEXT SENTENCE
022600     ELSE
022700         WRITE PRT-REC FROM COMPRESS-PRINT AFTER ADVANCING 0
022800         WRITE PRT-REC FROM ESC-TEXT-61 AFTER ADVANCING 0.
022900     IF HD-RET-CODE NOT = 0
023000         DISPLAY "THDRPT ERROR".
033500     MOVE DE-LOW-RANGE             TO PRT-FROM-CODE.
           IF DE-HIGH-RANGE = SPACES OR < DE-LOW-RANGE
               MOVE DE-LOW-RANGE         TO DE-HIGH-RANGE.
033600     MOVE DE-HIGH-RANGE            TO PRT-THRU-CODE.
033700
035200     MOVE 1 TO DATE-MODE.
035300     CALL "TDATECHK" USING DATE-CHECK-AREA.
035400     MOVE DATE-SLASH-OUT                 TO PRT-DATE.
035500
           OPEN INPUT DPOITEM, DPORECD, MPLTINFO, MSTORERM,
036000                USAGEFIL.
037400
037500      MOVE DE-LOW-RANGE TO CODE-ARG.
           MOVE CODE-ARG TO CORPCDE OF USAGEFIL-REC.
           MOVE 0 TO COND-WORD.
           START USAGEFIL KEY >= CORPCDE OF USAGEFIL-REC
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STAT1 = "2"
                   MOVE 17 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.
038400     MOVE "P 01" TO PLT-ARG.
           MOVE 0 TO COND-WORD.
           MOVE PLT-ARG TO PLTINFOKEY OF MPLTINFO-REC.
           READ MPLTINFO INTO BUF-MPLTINFO
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STAT1 = "2"
               MOVE 17 TO COND-WORD
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD.
038700     IF NOT GOOD-CALL
038800        MOVE "DBGET MPLTINFO 050 TBLKBYCD" TO BU-DISPLAY-MSG
038900        PERFORM 990-BLOWUP THRU 999-EXIT.
039000
039100     MOVE MPLTINFO-COMPANY TO PRT-PLT.
039200
039300 059-EXIT.  EXIT.
039400
039500 090-END-PROGRAM.
039600*----------  PRINT REPORT, CLOSE FILES, AND QUIT
039700     IF PAPER-IS-132-COLS
039800         NEXT SENTENCE
039900     ELSE
040000         WRITE PRT-REC FROM NORMAL-PRINT AFTER ADVANCING 0
040100         WRITE PRT-REC FROM ESC-TEXT-60 AFTER ADVANCING 0.
040400
040800     CLOSE PRINT-REPORT-FILE.
           CLOSE DPOITEM, DPORECD, MSTORERM, MPLTINFO, USAGEFIL.
041100 099-EXIT.  EXIT.
041200
041300******************************************************************
041400*  INPUT SECTION:  READ THE RANGE OF CODES SPECIFIED AND ADD UP  *
041500*                  THE USAGE FOR THE PAST 12 MONTHS.  FIND ANY   *
041600*                  BLANKETS TIED TO CODE AND THEIR EXPIRATION    *
041700*                  DATES.  WRITE TO SORT FILE.                   *
041800******************************************************************
041900 7-INPUT.
           MOVE "00" TO KSAM-STATUS.
042000     PERFORM 780-READ-KSAM THRU 789-EXIT.
042100
042200     PERFORM 710-MAIN THRU 719-EXIT UNTIL
042300             (K-CORP-CODE > DE-HIGH-RANGE) OR
042400             (K-STAT-1 = 1)                OR
042500             (KSAM-STATUS = "23").
042600
042700     IF K-CORP-CODE > DE-HIGH-RANGE
042800        COMPUTE TOTAL-KSAM-CODES = TOTAL-KSAM-CODES - 1.
042900
043000     GO TO 799-EXIT.
043100
043200*----------  FIND THE CODES THAT ARE WITHIN THE RANGE GIVEN AND WRITE
043300*            TO SORT RECORD
043400 710-MAIN.
043500      MOVE SPACES TO SORT-REC.
043600      MOVE SPACES TO BLANKET.
043700      MOVE 0 TO CODE-USAGE.
043800      MOVE 1 TO INDEX1.
043900      PERFORM 750-ADD-USAGE THRU 759-EXIT 12 TIMES.
044000      MOVE CODE-USAGE TO SORT-USAGE.
044100      PERFORM 760-FIND-BLANKETS THRU 769-EXIT.
044200
044300*----------  IF CODE IS NOT TIED TO ANY BLANKETS, ONLY WRITE TO SORT FILE
044400*            IF USER WANTED TO SEE ALL CODES ANYWAY
044500      IF BLANKET NOT = "YES"
044600       IF DE-KEY = "X"
              IF DE-BUYER-CODE = SPACES OR PO-BUYER-CODE
044700         MOVE "*******" TO SORT-PO-NO
044800         MOVE SPACES TO SORT-ITEM-NO
044900         MOVE SPACES TO SORT-EXP-DATE-CN
045000         MOVE ZEROES TO SORT-UNIT-PRICE
045100         MOVE K-CORP-CODE TO SORT-CORP-CODE
045200         RELEASE SORT-REC.
045300
045400      PERFORM 780-READ-KSAM THRU 789-EXIT.
045500 719-EXIT.  EXIT.
045600
045700*------------  ADD THE LAST 12 MONTHS USAGE TOTALS FOR THIS CODE
045800 750-ADD-USAGE.
045900         ADD K-MTH-USAGE(INDEX1) TO CODE-USAGE.
046000      ADD 1 TO INDEX1.
046100 759-EXIT.  EXIT.
046200
046300*----------  SEARCH FOR ANY REQUIREMENTS ORDERS THAT HAVE THIS
046400*            CORPORATE CODE
046500 760-FIND-BLANKETS.
046600     MOVE K-CORP-CODE TO CODE-ARG.
           MOVE 0 TO COND-WORD.
           MOVE CODE-ARG TO CORPCDE OF DPOITEM-REC.
           START DPOITEM KEY > CORPCDE OF DPOITEM-REC
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STAT1 = "2"
                   MOVE 17 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.
046900     IF COND-WORD = 17
047000        GO TO 769-EXIT
047100     ELSE
047200     IF NOT GOOD-CALL
047300        MOVE "DBFIND DPOITEM 760" TO BU-DISPLAY-MSG
047400        MOVE CODE-ARG             TO BU-DISPLAY-FLD (1)
047500        PERFORM 990-BLOWUP THRU 999-EXIT.
047600
047700 765-GET-AT-LEAST-ONE-BLKT.
           MOVE 0 TO COND-WORD.
           READ DPOITEM PRIOR RECORD INTO BUF-DPOITEM
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STAT1 = "1"
                   MOVE 14 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.
           IF CORPCDE OF DPOITEM-REC NOT = CODE-ARG
               MOVE 14 TO COND-WORD.
048000     IF COND-WORD NOT = 0
048100         IF COND-WORD = 14
048200             GO TO 769-EXIT
048300         ELSE
048400             MOVE "DBGET DPOITEM 765" TO BU-DISPLAY-MSG
048500             PERFORM 990-BLOWUP THRU 999-EXIT.
048600
048700     IF ITM-PO-RCVR  =  "000"
048800         IF ITM-PO-REL  =  "999"
048900            MOVE "YES" TO BLANKET
049000            MOVE K-CORP-CODE TO SORT-CORP-CODE
049100            MOVE ITM-NUMBER TO SORT-ITEM-NO
049200            MOVE ITM-PRICE-UM TO SORT-PRICE-UM
049300            MOVE ITM-UNIT-PRICE TO SORT-UNIT-PRICE
049400            MOVE ITM-PO-RCV-NO TO SORT-PO-NO, PO-ARG
049500            PERFORM 770-PO-EXP-DATE THRU 779-EXIT
                  IF DE-BUYER-CODE = SPACES OR PO-BUYER-CODE
049600                RELEASE SORT-REC.
049700
049800     GO TO 765-GET-AT-LEAST-ONE-BLKT.
049900
050000 769-EXIT.  EXIT.
050100
050200*----------  FIND PO EXPECT DATE WHICH IS REALLY THE PO EXPIRATION
050300*            DATE FOR REQUIREMENT ORDERS
050400 770-PO-EXP-DATE.
           MOVE 0 TO COND-WORD.
           MOVE PO-ARG TO PORCVNO OF DPORECD-REC.
           START DPORECD KEY = PORCVNO OF DPORECD-REC
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STAT1 = "2"
                   MOVE 17 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.
050700     IF COND-WORD NOT = 0
050800        GO TO 779-EXIT.
050900
051200     IF COND-WORD NOT = 0
051300        GO TO 779-EXIT.
           MOVE 0 TO COND-WORD.
           READ DPORECD NEXT INTO BUF-DPORECD
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   MOVE 15 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.
           IF PORCVNO OF DPORECD-REC NOT = PO-ARG
               MOVE 15 TO COND-WORD.
051400
      *--------- ACCOUNT FOR CENTURY.
051500     MOVE PO-EXPECT-DATE-CN TO SORT-EXP-DATE-CN.
051600 779-EXIT.  EXIT.
051700
051800 780-READ-KSAM.
           MOVE 0 TO COND-WORD.
           READ USAGEFIL NEXT INTO USAGE-REC
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   MOVE 15 TO COND-WORD
                   MOVE "23" TO KSAM-STATUS
               ELSE
                   MOVE "23" TO KSAM-STATUS
                   MOVE 99 TO COND-WORD.
052100*----------  IF FIRST RECORD IS CONTROL RECORD, SKIP IT
052200      IF K-CORP-CODE = "00000000"
052300           GO TO 780-READ-KSAM.
            IF K-CORP-CODE OF USAGE-REC > DE-HIGH-RANGE
               MOVE 15 TO COND-WORD
               MOVE "23" TO KSAM-STATUS.
            IF COND-WORD = 99
               MOVE "BAD READ USAGEFIL 780 TBLKBYCD" TO BU-DISPLAY-MSG
               PERFORM 990-BLOWUP THRU 999-EXIT.
053300      ADD 1 TO TOTAL-KSAM-CODES.
053400
053500 789-EXIT.  EXIT.
053600
053700 799-EXIT.  EXIT.
053800
053900*******************************************************************
054000*  OUTPUT SECTION:  PRINT EACH CORPORATE CODE ALONG WITH THE      *
054100*                   REQUIREMENT ORDER DATA.  IF A CODE IS NOT     *
054200*                   ON ANY REQUIREMENT ORDER, ASTERICKS WILL BE   *
054300*                   PRINTED INSTEAD OF PO DATA.                   *
054400*******************************************************************
054500 8-OUTPUT.
054600     RETURN SORT-FILE AT END
054700       MOVE "Y" TO END-OF-SORT-FILE
054800       PERFORM 880-HEADINGS THRU 889-EXIT
054900       MOVE EMPTY-SORT-MSG TO PRT-LINE
055000       WRITE PRT-REC AFTER ADVANCING 1 LINE
055100       GO TO 899-EXIT.
055200
055300     PERFORM 810-PROCESS-SORTED-RECORDS THRU 819-EXIT
055400             UNTIL ALL-SORTED-RECORDS-PROCESSED.
055500
055600     MOVE TOTAL-CODES-TO-REPORT           TO PRT-TOTAL.
055700     MOVE "TOTAL CODES ON REPORT"         TO PRT-LIT.
055800     WRITE PRT-REC FROM PRINT-TOTALS AFTER ADVANCING 9 LINES.
055900     MOVE TOTAL-KSAM-CODES                TO PRT-TOTAL.
056000     MOVE "TOTAL CODES COMPARED IN RANGE" TO PRT-LIT.
056100     WRITE PRT-REC FROM PRINT-TOTALS AFTER ADVANCING 1 LINE.
056200     MOVE SPACES                          TO PRT-REC.
056300     WRITE PRT-REC AFTER ADVANCING NEW-PAGE.
056400
056500     GO TO 899-EXIT.
056600
056700******************************************************************
056800*  READ EACH SORT RECORD AND PRINT A CORPORATE CODE, IT'S  DESC- *
056900*  RIPTION, AND THE REQUIREMENT ORDERS THAT USE THE CODE.        *
057000******************************************************************
057100 810-PROCESS-SORTED-RECORDS.
057200     IF LINE-CNT > 55
057300        PERFORM 880-HEADINGS THRU 889-EXIT.
057400
057500*----------  PRINT NEW CORPORATE CODE INFORMATION
057600     IF SORT-CORP-CODE NOT EQUAL SAVE-SORT-CORP-CODE
057700        ADD 1 TO TOTAL-CODES-TO-REPORT
057800        PERFORM 860-PRT-DESCRIPTION THRU 869-EXIT
057900        MOVE SORT-CORP-CODE TO SAVE-SORT-CORP-CODE.
058000
058100*----------  PRINT REQUIREMENT ORDER INFORMATION
058200     PERFORM 850-FIND-UM THRU 859-EXIT.
058300
058400     IF SORT-PO-NO = "*******"
058500        MOVE SORT-USAGE                  TO PRT-USAGE-B
058600        MOVE PRT-UM                      TO PRT-UM-B
058700        MOVE PRT-PLANT                   TO PRT-PLANT-B
058800        WRITE PRT-REC FROM REPORT-DETAIL-LINE2-B AFTER
058900                                         ADVANCING 1 LINE
059000        ADD 1                            TO LINE-CNT
059100     ELSE
059200        MOVE SORT-USAGE                  TO PRT-USAGE
059300        MOVE SORT-PO-NO                  TO PRT-PO-BLK-NO
059400        MOVE SORT-ITEM-NO                TO PRT-LINE-ITEM-NO
059500        MOVE SORT-UNIT-PRICE             TO PRT-UNIT-PRICE
059600        MOVE SORT-PRICE-UM               TO PRT-PRICE-UM
059700        MOVE SORT-EXP-DATE               TO DATE-VALIDATE-IN
059800        MOVE 4                           TO DATE-MODE
059900        CALL "TDATECHK" USING DATE-CHECK-AREA
060000        MOVE DATE-SLASH-OUT              TO PRT-EXP-DATE
060100        WRITE PRT-REC FROM REPORT-DETAIL-LINE2 AFTER ADVANCING
060200                                         1 LINE
060300            ADD 1                        TO LINE-CNT.
060400
060500     RETURN SORT-FILE  AT END
060600            MOVE "Y"                     TO END-OF-SORT-FILE.
060700
060800 819-EXIT.  EXIT.
060900
061000*-----------  GET CODE'S UNIT OF MEASURE
061100 850-FIND-UM.
061200      MOVE SPACES TO PRT-UM.
061300      MOVE K-CORP-CODE  TO CODE-ARG.
           MOVE 0 TO COND-WORD.
           MOVE CODE-ARG TO CORPCDE OF MSTORERM-REC.
           READ MSTORERM INTO BUF-MSTORERM
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STAT1 = "2"
               MOVE 17 TO COND-WORD
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD.
061600      IF NOT GOOD-CALL
061700         MOVE SPACES TO PRT-UM
061800      ELSE
061900         MOVE STR-UM TO PRT-UM.
062000 859-EXIT.  EXIT.
062100
062200*----------  GET CODE'S DESCRIPTION AND PRINT IT
062300 860-PRT-DESCRIPTION.
062400     MOVE SPACES                         TO PRT-REC.
062500     WRITE PRT-REC AFTER ADVANCING 1 LINE.
062600     ADD 1                               TO LINE-CNT.
062700
062800     MOVE SPACES                         TO CDESC-AREA.
062900     CALL "CDESC" USING CDESC-RET-CODE, BASE, STATUS-AREA,
063000                  BU-DISPLAY-MSG, SORT-CORP-CODE, CDESC-DATA.
063100     ADD CDESC-LINES-GOT                 TO LINE-CNT.
063200     IF LINE-CNT > 55
063300        PERFORM 880-HEADINGS THRU 889-EXIT
063400        ADD CDESC-LINES-GOT              TO LINE-CNT.
063500
063600     MOVE 1                              TO INDEX1.
063700     MOVE SORT-CORP-CODE                 TO PRT-CORP-CODE.

063800     PERFORM 865-MOVE-DESC CDESC-LINES-GOT TIMES.

063900     GO TO 869-EXIT.
064000
064100 865-MOVE-DESC.
064200     MOVE CDESC (INDEX1)                 TO PRT-DESCRIPTION.
064300     WRITE PRT-REC FROM REPORT-DETAIL-LINE1.
064400     ADD 1                               TO INDEX1.
064500     MOVE SPACES                         TO PRT-CORP-CODE.
064600 869-EXIT.  EXIT.
064700
064800*----------  PRINT REPORT HEADINGS
064900 880-HEADINGS.
            IF DE-BUYER-CODE = SPACES
                MOVE SPACES                    TO PRT-BUYER-CODE
            ELSE
                MOVE DE-BUYER-CODE             TO PRT-BUYER-CODE.

065000      MOVE 8                             TO LINE-CNT.
065100      ADD 1                              TO PAGE-CNT.
065200      MOVE PAGE-CNT                      TO PRT-PAGE-CNT.
065300      WRITE PRT-REC FROM HEADER-1 AFTER ADVANCING NEW-PAGE.
065400      WRITE PRT-REC FROM HEADER-2 AFTER ADVANCING 1.
065500      WRITE PRT-REC FROM HEADER-3 AFTER ADVANCING 1.
            IF PRT-BUYER-CODE NOT = SPACES
                ADD 1                          TO LINE-CNT
065500          WRITE PRT-REC FROM HEADER-31 AFTER ADVANCING 1.
065600      WRITE PRT-REC FROM HEADER-4 AFTER ADVANCING 3.
065700      WRITE PRT-REC FROM HEADER-5 AFTER ADVANCING 1.
065800      WRITE PRT-REC FROM HEADER-6.
065900 889-EXIT.  EXIT.
066000
066100 899-EXIT.  EXIT.
066200
       COPY OVRPFCALL IN COPYLIB.
066400*************************************************************
066500*                    BLOWUP   ROUTINE                       *
066600*************************************************************
066700 990-BLOWUP.
066800     WRITE PRT-REC FROM ESC-TEXT-61  AFTER ADVANCING 0.
066900     WRITE PRT-REC FROM NORMAL-PRINT AFTER ADVANCING 0.
067000
067100     MOVE "TBLKBYCD" TO BU-PGM-NAME.
067200     MOVE SORT-CORP-CODE TO BU-DISPLAY-FLD (3).
067300     CALL "TBLOWUP" USING BASE, BU-PGM-NAME, STATUS-AREA,
067400           DUMMY-VIEW-AREA, FILE-STATUS, BU-DISPLAY-MSG,
067500           BU-DISPLAY-AREA.
067600
067700 999-EXIT.  EXIT.
