       IDENTIFICATION DIVISION.
       PROGRAM-ID.     TCOMMIT.
       AUTHOR.         ANNETTE M. KRAUSS.
       DATE-WRITTEN.   SEPT 1987.
       DATE-COMPILED.
      *REMARKS.
      **************************************************************
      *                                                            *
      *D   TCOMMIT                                                 *
      *                                                            *
      *D    THIS REPORT SHOWS TOTAL VENDOR COMMITMENT BY PO UNITS/ *
      *D    PRICES OR INVOICE UNITS/PRICES.                        *
      *                                                            *
      **************************************************************
      *C  02/21/94  JEFF BUNGO  REQ #6449
      *C    ADDED NEW FIELDS TO HISTORY DATABASES TO MATCH LIVE
      *C    DATABASES.  CHANGED PROGRAM TO USE THESE NEW FIELDS
      *C    IN HISTORY.
      *C  09/12/96  W L  MCINTYRE
      *C    MADE REVISIONS FOR END-OF-CENTURY COMPATABILITY
      *C
      *C  04/19/99  CA YODER
      *C    ADDED OPTION FOR NAPANEE TO SELECT INVOICELESS POS ONLY
      *C    FOR THE REPORT.
      *C
      *C  04/18/01  CA YODER
      *C    ADDED OPTION FOR NAPANEE TO PRINT EITHER DETAIL OR SUMMARY
      *C    REPORT.
      *C
      *C  06/15/04  CA YODER    NAPANEE REQUEST
      *C    ADDED OPTION TO INCLUDE ITEMS BY INVOICE DATE INSTEAD OF
      *C    PO DATE.
      *C

       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.
       SOURCE-COMPUTER.  IBM-AS400.
       OBJECT-COMPUTER.  IBM-AS400.
       SPECIAL-NAMES.    C01 IS NEW-PAGE.

       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT PRINT-FILE        ASSIGN TO PRINTER-MCPRT.
           SELECT SVENDOR-FILE      ASSIGN TO DISK-SORT.
           SELECT SPO-FILE          ASSIGN TO DISK-SORT.
           SELECT PO-MST-FILE       ASSIGN TO DISK-POSORT.
           SELECT VENDOR-MST-FILE   ASSIGN TO DISK-VENDSORT.
           SELECT MPLTINFO-I
                  ASSIGN TO DATABASE-MCFLCS0501
                  ORGANIZATION IS INDEXED
                    ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                  FILE STATUS IS FILE-STATUS.

           SELECT DVENDOR-I
                  ASSIGN TO DATABASE-MCFLCS0701
                  ORGANIZATION IS INDEXED
                    ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                    WITH DUPLICATES
                  FILE STATUS IS FILE-STATUS.

           SELECT VENDCODE-I
                  ASSIGN TO DATABASE-MCFLCSVEN2
                  ORGANIZATION IS INDEXED
                    ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                  FILE STATUS IS FILE-STATUS.

           SELECT DPORECD-I
                  ASSIGN TO DATABASE-MCFLCS0902
                  ORGANIZATION IS INDEXED
                    ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                  FILE STATUS IS FILE-STATUS.

           SELECT DPOITEM-I
                  ASSIGN TO DATABASE-MCFLCS1002
                  ORGANIZATION IS INDEXED
                    ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                    WITH DUPLICATES
                  FILE STATUS IS FILE-STATUS.

           SELECT DINVRCD-I
                  ASSIGN TO DATABASE-MCFLCS2502
                  ORGANIZATION IS INDEXED
                    ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                    WITH DUPLICATES
                  FILE STATUS IS FILE-STATUS.

           SELECT DPORECDH-I
                  ASSIGN TO DATABASE-MCFLST0302
                  ORGANIZATION IS INDEXED
                    ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                    WITH DUPLICATES
                  FILE STATUS IS FILE-STATUS.

           SELECT DPOITEMH-I
                  ASSIGN TO DATABASE-MCFLST0401
                  ORGANIZATION IS INDEXED
                    ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                    WITH DUPLICATES
                  FILE STATUS IS FILE-STATUS.

           SELECT DINVRCDH-I
                  ASSIGN TO DATABASE-MCFLST0802
                  ORGANIZATION IS INDEXED
                    ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                    WITH DUPLICATES
                  FILE STATUS IS FILE-STATUS.
       DATA DIVISION.
       FILE SECTION.

       SD  SPO-FILE
           RECORD CONTAINS 46 CHARACTERS.
       01  SPO-REC.
           05  SPO-VENDOR-CODE        PIC X(10).
           05  SPO-PO-NUMBER          PIC X(13).
           05  SPO-PO-DATE            PIC X(6).
           05  SPO-AMOUNT             PIC S9(13)V9(4).

       SD  SVENDOR-FILE
           RECORD CONTAINS 27 CHARACTERS.
       01  SVENDOR-REC.
           05  SVENDOR-CODE           PIC X(10).
           05  SVENDOR-AMOUNT         PIC S9(13)V9(4).

       FD  PO-MST-FILE
           RECORD CONTAINS 46 CHARACTERS.
       01  PO-REC.
           05  PO-VENDOR-CODE         PIC X(10).
           05  PO-PO-NUMBER           PIC X(13).
