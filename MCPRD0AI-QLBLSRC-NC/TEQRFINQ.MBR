       IDENTIFICATION DIVISION.
       PROGRAM-ID.             TEQRFINQ.
       AUTHOR.                 W. ROXBURY.
       INSTALLATION.           GOODYEAR TIRE & RUBBER CO.
      *REMARKS.   *** THIS IS THE EXECUTIVE PROGRAM FOR
      *               THE EQUIPMENT REFERENCE FILE INQUIRY
      *                 SUBROUTINES CALLED:
      *                   TERINDEX
      *                   TEQRFIDX
      *                   TEQRFREF
      *                   TEQRFREM
      *                   TEQRFOPS
      *                   TEQRFSPR
      *                   TEQRFDRW
      *                   ****.
       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.
       SOURCE-COMPUTER.        IBM-AS400.
       OBJECT-COMPUTER.        IBM-AS400.
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT EQP-EQUIPMENT
                  ASSIGN TO DATABASE-MCFLMM0201
                  ORGANIZATION IS INDEXED
                  ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                  FILE STATUS IS FILE-STAT.

           SELECT DISPLAY-FILE
                  ASSIGN TO WORKSTATION-ZEQPREFI-SI
                  ORGANIZATION IS TRANSACTION
                  ACCESS IS SEQUENTIAL
                  FILE STATUS IS SCREEN-STATUS
                  MAJOR-MINOR
                  CONTROL-AREA IS SCREEN-CONTROL.

       DATA DIVISION.
       FILE SECTION.
       FD  EQP-EQUIPMENT
           LABEL RECORDS ARE STANDARD.
       01  EQP-REC.
           COPY DDS-ALL-FORMATS OF MCFLMM0201.

       FD  DISPLAY-FILE
           LABEL RECORDS ARE OMITTED.
       01  DISPLAY-REC             PIC X(2000).

       WORKING-STORAGE SECTION.
       77  NEXT-FUNCTION           PIC 99  VALUE ZERO.

       01  PASSWORD-INFORMATION.
           05  NAME-OF-PROGRAM     PIC X(08) VALUE "TEQRFINQ".
           05  PROGRAM-TYPE        PIC X(02) VALUE "IN".
           05  PROGRAM-RELEASE     PIC X(12) VALUE " E0100010001".
           05  PROGRAM-DESCRIPTION.
               10  PROG-DESC-A     PIC X(60) VALUE
         "EQUIPMENT REFERENCE FILE INQUIRY FROM THE CRAFTSMAN's       ".
               10  PROG-DESC-B     PIC X(60) VALUE
         "EXECUTIVE PROGRAM.  PRIMARY PROGRAM INTO THE REFERENCE FILE.".
               10  PROG-FUNCTION   PIC X(60) VALUE
         "RUNS FROM THE f3 KEY OF THE EXECUTIVE SECONDARY MENU.       ".
           05  PASSWORD-FLAG       PIC X     VALUE "Y".

       01  FILE-STAT.
           05  FILE-STAT-1           PIC X  VALUE "0".
           05  FILE-STAT-2           PIC X  VALUE "0".

       01  SCREEN-DATA.
           05  EQP-NUM-SC            PIC X(06) VALUE SPACES.
           05  SUB-SYS-SC            PIC X(04) VALUE SPACES.
           05  SCREEN-MSGS.
               10  CMDMSG            PIC X(79) VALUE SPACES.
               10  ERRMSG            PIC X(79) VALUE SPACES.

       01  EQP-SUB-BUFFER.
           05  EQP-NUM-BUF           PIC X(06) VALUE SPACES.
           05  SUB-SYS-BUF           PIC X(04) VALUE SPACES.
           05  EQP-SUB-DESC          PIC X(50) VALUE SPACES.
           05  EQP-TYPE-BUF          PIC X(08) VALUE SPACES.

       01  SWITCHES.
           05  EQPREF-SW             PIC X.
           05  EQPREM-SW             PIC X.
           05  EQPOPS-SW             PIC X.
           05  PARTS-SW              PIC X.
           05  ACTIVE-KEY            PIC 99.

       01  TEMP-BUFFER.
           05  DESC-BUFFER            PIC X(40).
           05  FILLER                 PIC X(10).

           COPY SCREENIO       IN COPYLIB.

           COPY CATREAD        IN COPYLIB.

       01  EQP-EQUIP-DATA.
           COPY MEQPFILE       IN COPYLIB.

       01  LAST-WO-USED-DATA.
           COPY MLASTWO        IN COPYLIB.

       01  MESSAGE-BUFFER-DATA.
           COPY ERRORLIN       IN COPYLIB.

       LINKAGE SECTION.
       01  EXECUTIVE-DATA.
           05  X-WO-NUM                  PIC X(10).
           05  X-CC-NUM                  PIC X(04).
           05  X-EQUIP-NUM               PIC X(06).
           05  X-PARTS.
               10  PART-1                PIC X(07).
               10  PART-2                PIC X(07).
               10  PART-3                PIC X(07).
               10  PART-4                PIC X(07).
               10  PART-5                PIC X(07).
               10  PART-6                PIC X(07).
               10  PART-7                PIC X(07).
               10  PART-8                PIC X(07).

       01  DBPARAMETERS.
           COPY DBPARMS        IN COPYLIB.

       PROCEDURE DIVISION USING EXECUTIVE-DATA
                                DBPARAMETERS.

       CHECK-PASSWORD.
           CALL "TPWORD" USING PASSWORD-INFORMATION.
           IF PASSWORD-FLAG = "N"
               GO TO END-OF-JOB.

       BEGIN.
           OPEN I-O            DISPLAY-FILE.
           OPEN INPUT          EQP-EQUIPMENT.

       6-MAIN.
           MOVE 0              TO ACTIVE-KEY.
           MOVE "VEXEC"        TO SCREEN-NAME.
           MOVE SPACES         TO SCREEN-DATA EQP-SUB-BUFFER.

           IF X-EQUIP-NUM NOT = SPACES
               MOVE X-EQUIP-NUM TO EQP-NUM-SC EQP-NUM-BUF.

       61-SHOWFORM.
           MOVE "00"           TO SCREEN-STATUS.
           MOVE SCREEN-DATA    TO DISPLAY-REC.

           WRITE DISPLAY-REC  FORMAT IS SCREEN-NAME
               INDIC ARE SCREEN-INDICATORS.
           IF SCREEN-STATUS NOT = "00"
               DISPLAY "SCREEN WRITE ERROR.  SCREEN-STATUS IS "
                        SCREEN-STATUS
               GO TO END-OF-JOB.

           READ  DISPLAY-FILE FORMAT IS SCREEN-NAME
               INDIC ARE SCREEN-INDICATORS
           IF SCREEN-STATUS NOT = "00"
               DISPLAY "SCREEN READ ERROR.  SCREEN-STATUS IS "
                        SCREEN-STATUS
               GO TO END-OF-JOB.

           MOVE DISPLAY-REC    TO SCREEN-DATA.
           MOVE ALL B"0"       TO SCREEN-INDICATORS.
           MOVE EQP-NUM-SC     TO EQP-NUM-BUF.
           MOVE SUB-SYS-SC     TO SUB-SYS-BUF.

           IF KEY-HIT = 1
               CALL "TERINDEX" USING DBPARAMETERS
               GO TO 6-MAIN.

           IF KEY-HIT = 3
               GO TO END-OF-JOB.

           MOVE KEY-HIT        TO NEXT-FUNCTION.

       61-GET-DESCRIPTION.
           MOVE EQP-NUM-BUF    TO EQPNUM OF EQP-EQUIPMENT.
           READ EQP-EQUIPMENT  INTO EQP-EQUIP-DATA.
           IF FILE-STAT = "00"
               MOVE EQP-TYPE       TO EQP-TYPE-BUF
               MOVE EQP-EQUIP-NAME TO TEMP-BUFFER
               MOVE DESC-BUFFER    TO EQP-SUB-DESC
           ELSE
               MOVE ZEROS          TO EQP-TYPE-BUF
      **********************************************************************
      **    MESSAGE 030/052:
      **  DEVICE NOT IN EQUIPMENT FILE
      **********************************************************************
               MOVE  30            TO CATREAD-MSG-SET
               MOVE  52            TO CATREAD-MSG-NUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER TO EQP-SUB-DESC.

           IF SUB-SYS-BUF = SPACES
               MOVE 2          TO NEXT-FUNCTION.

       61-FUNCTION-KEY-SELECTION.
           IF NEXT-FUNCTION = 1
               GO TO 6-MAIN.

           IF NEXT-FUNCTION = 0 OR 2
               CALL "TEQRFIDX" USING DBPARAMETERS
                                     EQP-SUB-BUFFER
                                     SWITCHES
               IF ACTIVE-KEY = 3
                   GO TO END-OF-JOB
               ELSE
                   MOVE ACTIVE-KEY TO NEXT-FUNCTION
                   GO TO 61-FUNCTION-KEY-SELECTION.

           IF NEXT-FUNCTION = 4
               CALL "TEQRFREF" USING DBPARAMETERS
                                     EQP-SUB-BUFFER
                                     SWITCHES
               IF ACTIVE-KEY = 3
                   GO TO END-OF-JOB
               ELSE
                   MOVE ACTIVE-KEY TO NEXT-FUNCTION
                   GO TO 61-FUNCTION-KEY-SELECTION.

           IF NEXT-FUNCTION = 5
               CALL "TEQRFREM" USING DBPARAMETERS
                                     EQP-SUB-BUFFER
                                     SWITCHES
               IF ACTIVE-KEY = 3
                   GO TO END-OF-JOB
               ELSE
                   MOVE ACTIVE-KEY TO NEXT-FUNCTION
                   GO TO 61-FUNCTION-KEY-SELECTION.

           IF NEXT-FUNCTION = 7
               CALL "TEQRFSPR" USING DBPARAMETERS
                                     EQP-SUB-BUFFER
                                     SWITCHES
                                     EXECUTIVE-DATA
               IF ACTIVE-KEY = 3
                   GO TO END-OF-JOB
               ELSE
                   MOVE ACTIVE-KEY TO NEXT-FUNCTION
                   GO TO 61-FUNCTION-KEY-SELECTION.

           IF NEXT-FUNCTION = 6
               CALL "TEQRFOPS" USING DBPARAMETERS
                                     EQP-SUB-BUFFER
                                     SWITCHES
               IF ACTIVE-KEY = 3
                   GO TO END-OF-JOB
               ELSE
                   MOVE ACTIVE-KEY TO NEXT-FUNCTION
                   GO TO 61-FUNCTION-KEY-SELECTION.

           IF NEXT-FUNCTION = 8
               CALL "TEQRFDRW" USING DBPARAMETERS
                                     EQP-SUB-BUFFER
                                     SWITCHES
               IF ACTIVE-KEY = 3
                   GO TO END-OF-JOB
               ELSE
                   MOVE ACTIVE-KEY TO NEXT-FUNCTION
                   GO TO 61-FUNCTION-KEY-SELECTION.

           GO TO 6-MAIN.

       END-OF-JOB.
           CLOSE               EQP-EQUIPMENT.
           CLOSE               DISPLAY-FILE.
           GOBACK.

       999-CATREAD.
           MOVE SPACES         TO MESSAGE-BUFFER.
           CALL "CCATREAD" USING CATREAD-PARMS.
           MOVE CATREAD-MSG-TEXT TO MESSAGE-BUFFER.

       999-CATREAD-EXIT.    EXIT.

