           05  FILLER           PIC X(14)  VALUE " ON RECEIVING ".
           05  FILLER           PIC X(13)  VALUE "SLIP NUMBER  ".
           05  DISPLAY-PO-RLSE-RS.
               07  DISP-PO               PIC X(7)   VALUE SPACES.
               07  FILLER                PIC X      VALUE "-".
               07  DISP-RLSE             PIC X(3)   VALUE SPACES.
               07  FILLER                PIC X      VALUE "-".
               07  DISP-RS               PIC X(3)   VALUE SPACES.
