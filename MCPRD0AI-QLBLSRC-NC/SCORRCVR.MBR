           05  FILLER                    PIC X(23)  VALUE SPACES.

       01  HDR-3.
           05  FILLER                    PIC X(4)   VALUE "ITEM".
           05  FILLER                    PIC XXX    VALUE SPACES.
           05  FILLER                    PIC X(9)   VALUE "CORP CODE".
           05  FILLER                    PIC X(20)  VALUE SPACES.
           05  FILLER           PIC X(13)  VALUE "PREV QTY DLVR".
           05  FILLER                    PIC XX     VALUE SPACES.
           05  FILLER                    PIC XX     VALUE "UM".
           05  FILLER                    PIC XXX    VALUE SPACES.
           05  FILLER           PIC X(12)  VALUE "NEW QTY DLVR".
           05  FILLER                    PIC XX     VALUE SPACES.
           05  FILLER                    PIC XX     VALUE "UM".
           05  FILLER                    PIC XX     VALUE SPACES.

       01  PRT-ITM-HDR.
