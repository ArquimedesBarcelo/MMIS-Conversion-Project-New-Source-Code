       WORKING-STORAGE SECTION.
       01  RELATIVE-RECNO                PIC 9(9).
       01  SUB                           PIC S9(4) PACKED-DECIMAL.

       01  OLD-LOT                       PIC X(4)  VALUE SPACES.
       01  LOT-ARG.
           05  LOT-CORP-CODE             PIC X(08).
           05  LOT-LOT                   PIC X(04).

      *------02/18/98, JSB FRANCHISE TABLE
       01  FRAN-SUB                      PIC 99   VALUE ZERO.
       01  FRANCHISE-VENDOR-SW           PIC X(1) VALUE "N".
           88  FRANCHISE-VENDOR                   VALUE "Y".

       01  FRAN-TABLE.
           05  FRAN-ENTRY OCCURS 4 TIMES INDEXED BY FRAN-IDX.
               10  FRAN-ID             PIC X(1).
               10  FRAN-NAME           PIC X(4).
               10  FRAN-VEN-CODE       PIC X(10).

      *------ WS CONTROL AREA
       01  MAJOR-MINOR                   PIC XXXX.
       01  WS-CONTROL.
           02  FUNCTION-NUM              PIC XX.
                   88  EXIT-KEY-F8-USED                     VALUE "08". LVW000LS
                   88  REFRESH-KEY-F4-USED                  VALUE "04". LVW000LS
                   88  ENTER-KEY-USED                       VALUE "00". LVW000LS
                   88  F1-KEY-USED                          VALUE "01". LVW000LS
                   88  F2-KEY-USED                          VALUE "02". LVW000LS
                   88  F3-KEY-USED                          VALUE "03". LVW000LS
                   88  F4-KEY-USED                          VALUE "04". LVW000LS
                   88  F5-KEY-USED                          VALUE "05". LVW000LS
                   88  F6-KEY-USED                          VALUE "06". LVW000LS
                   88  F7-KEY-USED                          VALUE "07". LVW000LS
                   88  F8-KEY-USED                          VALUE "08". LVW000LS
           02 FUN-KEY REDEFINES FUNCTION-NUM PIC XX.
           02 TERMINAL-ID                PIC X(10).
           02 FORMAT-NAME                PIC X(10).

       01  DISPLAY-STATUS                PIC X(2).
       01  SAVE-VIEW-NFNAME              PIC X(16) VALUE SPACES.

       01  SRF-INDICATORS.
           05  IND OCCURS 99 TIMES       PIC 1 INDICATOR 01.

       COPY IOFEEDBACK OF COPYLIB.
       01  FILE-STATUS.
           05  FILE-STATUS-1             PIC X.
           05  FILE-STATUS-2             PIC X.
       01  NEED-PRICE-QTY-SW             PIC X      VALUE "N".
       01  STORE-SW                      PIC X.
       01  SAVE-RCV-SEQ                  PIC X(6).
       01  SAVE-UNIT-PRICE               PIC S9(10)V99 VALUE ZERO.
       01  C-ORDER-SW                    PIC X      VALUE "N".
       01  PRINT-EXTRA-TITLES-SW         PIC X      VALUE "N".
       01  LINE-ADV                      PIC 99     VALUE ZEROS.
       01  PRT-SUB                       PIC 99     VALUE ZEROS.

       01  STRIP                         PIC X(5) JUSTIFIED RIGHT.

      *----------  RECEIVED DATE TO COMPARE AGAINST CUTOFF DATE
      *            (KELLY PLANTS ONLY)
       01  RECEIPT-DATE                  PIC 9(6).

       01  DATE-CYMD.
           05  DATE-CYMD-CC              PIC 9(2).
           05  DATE-CYMD-YMD.
               10  DATE-CYMD-YY          PIC 9(2).
               10  DATE-CYMD-MM          PIC 9(2).
               10  DATE-CYMD-DD          PIC 9(2).

       01  SAVE-LAST-CUTOFF-DATE         PIC 9(6).
       01  SAVE-EXTSYS                   PIC X(1) VALUE "N".
       01  SAVE-EXTAUTO                  PIC X(1) VALUE "N".
       01  EXT-QTY                       PIC S9(8) COMP-3 VALUE ZEROS.
       01  EXT-CORRECT                   PIC X(1) VALUE "X".

      *---------- DETERMINES WHICH PLANT IS RUNNING:  AKRON OR SUBPLANT
       01  WHICH-PLANT.
           05  PT-TYPE.
               07  PLT-TYPE-1            PIC X.
               07  FILLER                PIC X.
           05  FILLER                    PIC X.

       01  PLANT-TYPE                    PIC 9    VALUE ZERO.
           88  AKRON                           VALUE 1.
           88  KELLY                           VALUE 2.

       01  CONTAINER-FLAG                PIC 9 VALUE 0.
           88  CONTAINER-ONLY               VALUE 1.

      *----------  CONTAINER ITEM IS SHIFTED LEFT BY 1 AND AN ASTERICK
      *            IS PUT ON THE RIGHT
       01  WORK-ITEM.
           05  FILLER                    PIC X     VALUE SPACES.
           05  SHIFTED-ITEM.
               07  WK-ITEM               PIC X(3)  VALUE SPACES.
               07  WK-ASTERICK           PIC X     VALUE SPACES.

       01  PO-SUB-BREAKDOWN.
           05  PO-SUB-CHAR               PIC X.
           05  FILLER                    PIC X(2).


       01  ITEM-DATA.
       COPY RCVITEM IN COPYLIB.

      *----------  HOLD AREAS FOR UPDATING DATABASE (ALSO PARAMETER
      *            PASSED TO 'CVALITEM')
       01  HOLD-FLDS.
           05  HOLD-PO-PAID              PIC S9(8)V9(4) VALUE ZEROS.
           05  DLVR-TOTAL                PIC S9(8)V9(4) VALUE ZEROS.
           05  HOLD-RS-PREV-DLVR         PIC S9(8)V9(4) VALUE ZEROS.
           05  HOLD-RS-PREV-STORED       PIC S9(8)V9(4) VALUE ZEROS.
           05  HOLD-ADJ-QTY              PIC S9(8)V9(4) VALUE ZEROS.
           05  HOLD-ADJ-QTY-RD REDEFINES HOLD-ADJ-QTY.
               10  FILLER                PIC S9(8).
               10  HOLD-ADJ-QTY-DEC      PIC 9(4).
           05  HOLD-ADJ-QTY-STR-UM       PIC S9(8)V9(4) VALUE ZEROES.
           05  HOLD-ADJ-QTY-STR-UM-RD REDEFINES HOLD-ADJ-QTY-STR-UM.
               10  FILLER                PIC S9(8).
               10  HOLD-ADJ-QTY-STR-UM-DEC PIC 9(4).
           05  KELLY-STR-ADJ-QTY         PIC S9(8)V9(4) VALUE ZEROS.
           05  KELLY-STR-ADJ-QTY-RD REDEFINES KELLY-STR-ADJ-QTY.
               10  FILLER                PIC S9(8).
               10  KELLY-STR-ADJ-QTY-DEC PIC 9(4).
           05  KELLY-STR-NEW-QTY         PIC S9(8)V9(4) VALUE ZEROS.


      *----------  KSAM AREAS FOR USAGEFIL FILE
       01  KEY-VALUE                     PIC X(8)  VALUE SPACES.
       01  RESULT                        PIC 9(4)  VALUE ZEROS.

       01  USAGE-RECORD.
           05  FILLER                    PIC XX.
           05  K-CORP-CODE               PIC X(8).
           05  K-MONTHS                 OCCURS 14 TIMES.
               10  K-MTH-USAGE           PIC S9(9) COMP-4.
           05  K-MONTHS-DD              OCCURS 14 TIMES.
               10  K-MTH-USAGE-DD        PIC S9(9) COMP-4.

       COPY CATREAD IN COPYLIB.
      *----------  PO AND RECEIVING SLIP WORK AREA
       COPY DBPOARG1 IN COPYLIB.
       COPY DBPOARG2 IN COPYLIB.
       COPY CDESC  IN COPYLIB.
       COPY CNDESC IN COPYLIB.
       01  RET-CODE                      PIC X(2)    VALUE SPACES.
       01  WS-SD-ITM                     PIC X(4)   VALUE SPACES.

      *----------  QTY WORK AREA
       01  QTY-WORK-AREA.
           05  WORK-QTY-X.
               10  WORK-QTY-BDP-X        PIC X(8).
               10  WORK-QTY-ADP-X        PIC X(4).
           05  WORK-QTY REDEFINES WORK-QTY-X PIC 9(8)V9(4).
       01  CHECK-ONHAND                  PIC S9(8)  VALUE ZEROS.

      *---------- VSETERROR AND VPUTWINDOW
       01  MESSAGE-BUFFER                PIC X(76)    VALUE SPACES.
       01  MESSAGE-BUFFER-RD REDEFINES MESSAGE-BUFFER.
           05  MSG-BUFFER                PIC X(62).
           05  MSG-VALUE                 PIC X(14).
