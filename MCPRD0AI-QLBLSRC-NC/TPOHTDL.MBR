000200 IDENTIFICATION DIVISION.
000300 PROGRAM-ID.    TPOHTDL.
000500 AUTHOR.        JIM COFFMAN.

000800***************************************************************
000900**                                                           **
001000**   TPOHTDL.UTIL   - UTILITY PROGRAM FOR CALLING THE        **
001100**                    SUBROUTINE 'SPOHTDL' WHICH DELETES     **
001200**                    A PURCHASE ORDER.                      **
001300**                                                           **
001400***************************************************************
      *C
      *C 09/11/96  JEFF BUNGO
      *C   EXPAND DATE FIELDS FOR YEAR 2000 COMPLIANCE.
      *C   RECOMPILE TO PICK UP COPYLIB CHANGES.
001600
001700 ENVIRONMENT DIVISION.
001800 CONFIGURATION SECTION.
001900 SOURCE-COMPUTER.  AS400.
002000 OBJECT-COMPUTER.  AS400.
002600 SPECIAL-NAMES.    I-O-FEEDBACK IS I-O-FEEDBACK-AREA.
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.

           SELECT DPORECDH-I
                  ASSIGN TO DATABASE-MCFLST0301
                  ORGANIZATION IS INDEXED
                    ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                    WITH DUPLICATES
                  FILE STATUS IS FILE-STATUS.

003600 DATA DIVISION.
       FILE SECTION.
       FD  DPORECDH-I
           LABEL RECORDS ARE STANDARD.
       01  DPORECDH-REC-I.
           COPY DDS-ALL-FORMATS  OF MCFLST0301.

011200 WORKING-STORAGE SECTION.
       01  FILE-STATUS.
           05  FILE-STATUS-1            PIC X  VALUE "0".
           05  FILE-STATUS-2            PIC X  VALUE "0".
002100
002700**************************************************************
002800**************************************************************
002900**                                                          **
003000**                DATABASE I/O BUFFER AREA                  **
003100**                                                          **
003200**************************************************************
003300**************************************************************
003400
003700 COPY DPORECDH IN COPYLIB.
005400
005500 COPY DATAB    IN COPYLIB.
005600
005700 COPY DBSTHIST IN COPYLIB.
005800
005900 01 ITEMS-LISTING.
006000     05  ALL-ITEMS                PIC XX    VALUE "@;".
006100     05  PO-SEARCH                PIC X(10) VALUE "PO-RCV-NO;".
006200
006300 01  ARG-VALUES.
006400     05  PLT-ARG                  PIC X(4)  VALUE SPACES.
006500     05  PO-ARG                   PIC X(14) VALUE SPACES.
006600
006900 01  PO-NUMBER                    PIC X(10).
007000
007100 01  BUILD-PO-NUM.
007300     05  PO-NUM-REL               PIC X(10) VALUE SPACES.
007400     05  FILLER                   PIC X(3)  VALUE "000".
007200     05  FILLER                   PIC X(1)  VALUE " ".
007500
007800 COPY TBLOWUP IN COPYLIB.
007900
008000 COPY VIEWDUM IN COPYLIB.
008100
008200 PROCEDURE DIVISION.
008700 1-BEGIN.
008800     OPEN INPUT DPORECDH-I.
009000     PERFORM 6-MAIN THRU 6-M-X.
009200     CLOSE DPORECDH-I.
009400     GOBACK.
009500
014900*********************************************
015000*                                           *
015100*  BLOWUP ROUTINE EXECUTES WHENEVER A       *
015200*  FATAL ERROR OCCURS                       *
015300*                                           *
015400*********************************************
015500
015600 2-BLOWUP.
015700     MOVE "TPOHTDL"  TO  BU-PGM-NAME.
015800     CALL "TBLOWUP" USING BASE, BU-PGM-NAME, STATUS-AREA,
015900         VIEW-COMAREA, FILE-STATUS, BU-DISPLAY-MSG,
016000             BU-DISPLAY-FLDS.
016300
016400**************************************************
016500*                                                *
016600*     6 - M A I N                                *
016700*                                                *
016800**************************************************
017000
017100 6-MAIN.
017200     MOVE SPACES                  TO PO-NUMBER.
017300     DISPLAY "ENTER PO NUMBER TO DELETE FROM HISTORY X(10)".
017400     ACCEPT PO-NUMBER.
017500     IF PO-NUMBER = SPACES GO TO 6-M-X.
018600     MOVE PO-NUMBER               TO  PO-NUM-REL.
018700     MOVE BUILD-PO-NUM            TO  PO-ARG.
           MOVE 0 TO COND-WORD.
           MOVE PO-ARG TO PORCVNO OF DPORECDH-REC-I.
           START DPORECDH-I KEY = PORCVNO OF DPORECDH-REC-I
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
019200             DISPLAY "PO DOESN'T EXIST; TRY AGAIN  ",
019300                 PO-NUMBER
019400             GO TO 6-MAIN
019500         ELSE
019600         MOVE "FIND DPORECDH * 6-MAIN" TO BU-DISPLAY-MSG
019700         GO TO 2-BLOWUP.
           READ DPORECDH-I NEXT INTO BUF-DPORECD-H
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14"
020200             DISPLAY "NO PO HEADER ENTRY; CANT DELETE HISTORY"
020400         ELSE
020500         MOVE "GET DPORECDH * 6-MAIN" TO BU-DISPLAY-MSG
020600         GO TO 2-BLOWUP.
           IF PORCVNO OF DPORECDH-REC-I NOT = PO-ARG
020200         DISPLAY "NO PO HEADER ENTRY; CANT DELETE HISTORY"
020300         GO TO 2-BLOWUP.
020700
021100     CALL "SPOHTDL" USING BASE,
021200                          PO-ARG.
021400     DISPLAY "SUCCESSFUL CALL TO SPOHTDL".
021500     GO TO 6-MAIN.
021700 6-M-X.    EXIT.
