       IDENTIFICATION DIVISION.
       PROGRAM-ID.    TMSUBSYS.
       AUTHOR.        R L ENSMINGER.
       INSTALLATION.  GTR.
      *REMARKS.
      ************************************************************
      *C  MAY 28, 1992  -  JEFF BUNGO    (5691)                  *
      *C       ADDED A FEATURE TO FORCE THE USER TO PRESS F4     *
      *C       A SECOND TIME TO VERIFY A DELETE OF A SUBSYSTEM   *
      *C       IF THE LOWER LEVELS OR SPARE PARTS OF A SUBSYSTEM *
      *C       WILL ALSO BE DELETED.                             *
      ************************************************************
       DATE-COMPILED.
       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.
       SOURCE-COMPUTER. IBM-AS400.
       OBJECT-COMPUTER. IBM-AS400.
       SPECIAL-NAMES. I-O-FEEDBACK IS I-O-FEEDBACK-AREA
                      LOCAL-DATA IS LOCAL-DATA-AREA.
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT CCLINK-LF2
               ASSIGN TO DATABASE-MCFLMM2101
               ORGANIZATION IS INDEXED
               ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                   WITH DUPLICATES
               FILE STATUS IS CCLINK-STATUS.

           SELECT DISPLAY-FILE
               ASSIGN TO WORKSTATION-ZMASTER-SI
               ORGANIZATION IS TRANSACTION
               ACCESS IS SEQUENTIAL
               FILE STATUS IS DSPLY-STATUS
               CONTROL-AREA IS WS-CONTROL.

           SELECT SUBSYS-PF
               ASSIGN TO DATABASE-MCFPMM1700
               ORGANIZATION IS RELATIVE
               ACCESS MODE IS RANDOM
               RELATIVE KEY IS PFKEY
               FILE STATUS IS SUBSYS-STATUS.

           SELECT SUBSYS-LF1
               ASSIGN TO DATABASE-MCFLMM1701
               ORGANIZATION IS INDEXED
               ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                   WITH DUPLICATES
               FILE STATUS IS SUBSYS-STATUS.

           SELECT SUBSYS-LF2
               ASSIGN TO DATABASE-MCFLMM1701
               ORGANIZATION IS INDEXED
               ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                   WITH DUPLICATES
               FILE STATUS IS SUBSYS-STATUS.

       DATA DIVISION.
       FILE SECTION.
       FD  CCLINK-LF2
           LABEL RECORDS ARE STANDARD.
       01  CCLINKRCD-LF2.
           COPY DDS-ALL-FORMATS OF MCFLMM2101.

       FD  DISPLAY-FILE
           LABEL RECORDS ARE OMITTED.
       01  DSPLY-REC                   PIC X(2000).

       FD  SUBSYS-PF
           LABEL RECORDS ARE STANDARD.
       01  SUBSYSRCD-PF.
           COPY DDS-ALL-FORMATS OF MCFPMM1700.

       FD  SUBSYS-LF1
           LABEL RECORDS ARE STANDARD.
       01  SUBSYSRCD-LF1.
           COPY DDS-ALL-FORMATS OF MCFLMM1701.

       FD  SUBSYS-LF2
           LABEL RECORDS ARE STANDARD.
       01  SUBSYSRCD-LF2.
           COPY DDS-ALL-FORMATS OF MCFLMM1701.

       WORKING-STORAGE SECTION.
       COPY CATREAD OF COPYLIB.
       01  CONTINUE-UPDATE-SWITCH            PIC X  VALUE "Y".
           88  CONTINUE-UPDATE                      VALUE "Y".
           88  NOT-CONTINUE-UPDATE                  VALUE "N".
       01  UPDATE-VERIFY-SWITCH              PIC X  VALUE "N".
           88  UPDATE-BEING-VERIFIED                VALUE "Y".
           88  UPDATE-NOT-BEING-VERIFIED            VALUE "N".
       01  CCLINK-STATUS                     PIC XX.
       01  COMP1-BYTES.
           05 COMP1 OCCURS 4 TIMES           PIC 9.
       01  COMP2-BYTES.
           05 COMP2 OCCURS 4 TIMES           PIC 9.
       COPY CPYIND  OF COPYLIB.
       01  DELETED-SW                        PIC X.
       01  DESC-TABLE.
           05 SCREEN-DESC2 OCCURS 9 TIMES    PIC X(50).
       01  DSPLY-STATUS                      PIC XX.
       01  EDIT-SW                           PIC X.
       01  EDIT-SUBSYS.
           05 B1                             PIC 9.
           05 B2                             PIC 9.
           05 B3                             PIC 9.
           05 B4                             PIC 9.
       01  ERROR-BUFFER                      PIC X(80).
       01  F-VAL                             PIC 1 VALUE B"0".
       COPY IOFEEDBACK OF COPYLIB.
       01  KEY-TABLE.
           05 PKEY OCCURS 9 TIMES            PIC 9(9).
       01  LOCK-KEY                          PIC X(14).
       01  PARENT-RRN                        PIC 9(9).
       01  PARENT-DESC                       PIC X(50).
       01  PARENT-KEY.
           05 PK1                            PIC 9.
           05 PK2                            PIC 9.
           05 PK3                            PIC 9.
           05 PK4                            PIC 9.
       01  PASSWORD-INFORMATION.
           05  NAME-OF-PROGRAM     PIC X(08) VALUE "TMSUBSYS".
           05  PROGRAM-TYPE        PIC X(02) VALUE "MA".
           05  PROGRAM-RELEASE     PIC X(12) VALUE " E0100010001".
           05  PROGRAM-DESCRIPTION.
               10  PROG-DESC-A     PIC X(60) VALUE
             "MAINTAIN SUBSYSTEM HIERARCHY FILE IN THE MMIS DATABASE. ".
               10  PROG-DESC-B     PIC X(60) VALUE SPACES.
               10  PROG-FUNCTION   PIC X(60) VALUE SPACES.
           05  PASSWORD-FLAG       PIC X.
       01  PFKEY                             PIC 9(9).
       01  SAVE-CCLINK-KEY                   PIC X(14).
       01  SCREEN8.
           COPY DD-SCREEN8 OF ZMASTER.
       01  STOP-READ                         PIC X.
       01  STOP-READ1                        PIC X.
       01  SUBSYS-STATUS                     PIC XX.
       01  SUBSYSBUFFER1.
           05  SUBSYS-KEY.
               10  SUBSYS-TYPE           PIC X(08).
               10  SUBSYS-PARENT.
                   15  SUBSYS-PARENT-NUM PIC X(04).
                   15  FILLER            PIC X(02).
           05  SUBSYS-CHILD.
               10  SUBSYS-CHILD-NUM      PIC X(04).
               10  FILLER                PIC X(02).
           05  SUBSYS-DESC               PIC X(50).
       01  SUBSYSBUFFER2.
           05  SUBSYS-KEY.
               10  SUBSYS-TYPE           PIC X(08).
               10  SUBSYS-PARENT.
                   15  SUBSYS-PARENT-NUM PIC X(04).
                   15  FILLER            PIC X(02).
           05  SUBSYS-CHILD.
               10  SUBSYS-CHILD-NUM      PIC X(04).
               10  FILLER                PIC X(02).
           05  SUBSYS-DESC               PIC X(50).
       01  S1                                PIC 99 COMP-3.
       01  S2                                PIC 99 COMP-3.
       01  S3                                PIC 99 COMP-3.
       01  T-VAL                             PIC 1 VALUE B"1".
       COPY VCOMLINK  OF COPYLIB.
       01  WS-SCREEN.
           05 WS-SUBSYS                      PIC X(4).
           05 WS-TYPENUM                     PIC X(8).
           05 WS-EDIT.
              10 WS-TYPENUM1                 PIC X(8).
              10 WS-SUB0                     PIC X(4).
              10 WS-DESC0                    PIC X(50).
              10 SUBSYS-TABLE OCCURS 9 TIMES.
                 15 SCREEN-SUBSYS.
                    20 SS-B1                 PIC 9.
                    20 SS-B2                 PIC 9.
                    20 SS-B3                 PIC 9.
                    20 SS-B4                 PIC 9.
                 15 SCREEN-DESC              PIC X(50).
           05 WS-L                           PIC X.
           05 WS-S                           PIC X.
           05 WS-ERRMSG                      PIC X(79).
       COPY WSCONTROL OF COPYLIB.
       PROCEDURE DIVISION.
       OPEN-PAR.
           OPEN I-O    CCLINK-LF2.
           OPEN I-O    DISPLAY-FILE.
           OPEN I-O    SUBSYS-LF2.
           OPEN INPUT  SUBSYS-LF1.
           OPEN I-O    SUBSYS-PF.
           CALL "TPWORD" USING PASSWORD-INFORMATION.
           IF PASSWORD-FLAG = "N" GO TO END-PAR.
           MOVE SPACES TO SCREEN8 LOCK-KEY.
           MOVE "Y" TO L OF SCREEN8-O
                       S OF SCREEN8-O.
           MOVE 0 TO VIEW-LASTKEY.
           PERFORM SHOW-SCREEN UNTIL VIEW-LASTKEY = 3.

       END-PAR.
           IF LOCK-KEY = SPACES
               NEXT SENTENCE
           ELSE
           MOVE LOCK-KEY TO HIERKEY OF SUBSYSRCD-LF2
           READ   SUBSYS-LF2
           DELETE SUBSYS-LF2 RECORD.
           CLOSE CCLINK-LF2.
           CLOSE DISPLAY-FILE.
           CLOSE SUBSYS-LF2.
           CLOSE SUBSYS-LF1.
           CLOSE SUBSYS-PF.
           GOBACK.

       SHOW-SCREEN.
           MOVE "SCREEN8" TO VIEW-CFNAME.
           MOVE  SCREEN8  TO DSPLY-REC.
           PERFORM 99-SCREEN-WRITE.
           PERFORM 98-SCREEN-READ.
           MOVE DSPLY-REC TO SCREEN8.

           IF UPDATE-BEING-VERIFIED AND VIEW-LASTKEY NOT = 4
               SET UPDATE-NOT-BEING-VERIFIED TO TRUE
               MOVE SPACES TO VERIFYMSG.

           IF VIEW-LASTKEY = 3 GO TO END-PAR.

           IF VIEW-LASTKEY = 1 OR 2
             PERFORM LIST-SUBSYSTEM THRU LIST-SUBSYSTEM-EXIT.

           IF VIEW-LASTKEY = 4 AND TYPENUM1 OF SCREEN8-O NOT = SPACES
             MOVE SCREEN8 TO WS-SCREEN
             SET CONTINUE-UPDATE TO TRUE
             PERFORM UPDATE-VERIFY THRU UPDATE-VERIFY-EXIT
             IF CONTINUE-UPDATE
               PERFORM EDIT-PARENT THRU EDIT-PARENT-EXIT
               PERFORM EDIT-SUBSYSTEMS THRU EDIT-SUBSYSTEMS-EXIT
                   VARYING S1 FROM 1 BY 1 UNTIL S1 > 9
               MOVE SPACES TO WS-EDIT
               MOVE WS-SCREEN TO SCREEN8.

           IF VIEW-LASTKEY = 5
               MOVE 0 TO VIEW-LASTKEY
               CALL "TTYPHIER" USING VIEW-COMAREA.

       LIST-SUBSYSTEM.
           MOVE SUBSYS OF SCREEN8-O TO EDIT-SUBSYS.
           INSPECT EDIT-SUBSYS REPLACING ALL " " BY "0".
           MOVE EDIT-SUBSYS TO SUBSYS OF SCREEN8-O.

           IF EDIT-SUBSYS NUMERIC
             NEXT SENTENCE
           ELSE
             MOVE 27016 TO CATREAD-MSG-NUMBER
             PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
             MOVE ERROR-BUFFER TO ERRMSG
             MOVE T-VAL TO INDS (1) INDS (99)
             GO TO LIST-SUBSYSTEM-EXIT.

           IF B1 = 0
             MOVE 27016 TO CATREAD-MSG-NUMBER
             PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
             MOVE ERROR-BUFFER TO ERRMSG
             MOVE T-VAL TO INDS (1) INDS (99)
             GO TO LIST-SUBSYSTEM-EXIT.

           IF B2 = 0 AND B3 NOT = 0
             MOVE 27016 TO CATREAD-MSG-NUMBER
             PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
             MOVE ERROR-BUFFER TO ERRMSG
             MOVE T-VAL TO INDS (1) INDS (99)
             GO TO LIST-SUBSYSTEM-EXIT.

           IF B3 = 0 AND B4 NOT = 0
             MOVE 27016 TO CATREAD-MSG-NUMBER
             PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
             MOVE ERROR-BUFFER TO ERRMSG
             MOVE T-VAL TO INDS (1) INDS (99)
             GO TO LIST-SUBSYSTEM-EXIT.

           IF TYPENUM OF SCREEN8-O = SPACES
             MOVE 27017 TO CATREAD-MSG-NUMBER
             PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
             MOVE ERROR-BUFFER TO ERRMSG
             MOVE T-VAL TO INDS (2) INDS (99)
             GO TO LIST-SUBSYSTEM-EXIT.

           IF VIEW-LASTKEY = 1
             IF LOCK-KEY NOT = SPACES
             MOVE LOCK-KEY TO HIERKEY OF SUBSYSRCD-LF2
             READ   SUBSYS-LF2
             DELETE SUBSYS-LF2 RECORD
             MOVE SPACES TO LOCK-KEY.

           IF VIEW-LASTKEY = 2
             IF LOCK-KEY = SPACES
               MOVE "N" TO EDIT-SW
               STRING "EDIT" TYPENUM OF SCREEN8-O DELIMITED BY SIZE
                INTO LOCK-KEY
               MOVE LOCK-KEY TO SUBSYSRCD-LF1
               READ SUBSYS-LF1
                INVALID KEY
                 MOVE "Y" TO EDIT-SW
                 MOVE LOCK-KEY TO SUBSYSRCD-LF2
                 WRITE SUBSYSRCD-LF2
               END-READ
             ELSE
               IF LOCK-KEY NOT = TYPENUM OF SCREEN8-O
                 MOVE LOCK-KEY TO HIERKEY OF SUBSYSRCD-LF2
                 READ   SUBSYS-LF2
                 DELETE SUBSYS-LF2 RECORD
                 MOVE SPACES TO LOCK-KEY
                 MOVE "N" TO EDIT-SW
                 STRING "EDIT" TYPENUM OF SCREEN8-O DELIMITED BY SIZE
                  INTO LOCK-KEY
                 MOVE LOCK-KEY TO SUBSYSRCD-LF1
                 READ SUBSYS-LF1
                  INVALID KEY
                   MOVE "Y" TO EDIT-SW
                   MOVE LOCK-KEY TO SUBSYSRCD-LF2
                   WRITE SUBSYSRCD-LF2
                 END-READ
               ELSE
                 MOVE "Y" TO EDIT-SW.

           IF VIEW-LASTKEY = 2 AND EDIT-SW = "N"
             MOVE SPACES TO LOCK-KEY TYPENUM1 OF SCREEN8-O
             MOVE 27018 TO CATREAD-MSG-NUMBER
             PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
             MOVE ERROR-BUFFER TO ERRMSG
             MOVE T-VAL TO INDS (99)
             GO TO LIST-SUBSYSTEM-EXIT.

           IF VIEW-LASTKEY = 1
             MOVE SPACES TO TYPENUM1 OF SCREEN8-O
           ELSE
           IF VIEW-LASTKEY = 2
             MOVE TYPENUM OF SCREEN8-O TO TYPENUM1 OF SCREEN8-O.

           MOVE EDIT-SUBSYS TO SUB0 OF SCREEN8-O.
           PERFORM LOAD-PARENT-DESC THRU LOAD-PARENT-EXIT.
           MOVE SCREEN8 TO WS-SCREEN.
           PERFORM CAL-SUBS THRU CAL-SUBS-EXIT VARYING S1 FROM 1 BY 1
            UNTIL S1 > 9.
           PERFORM INIT-DESC VARYING S1 FROM 1 BY 1 UNTIL S1 > 9.
           PERFORM LOAD-DESCS THRU LOAD-DESCS-EXIT.
           MOVE WS-SCREEN TO SCREEN8.

       LIST-SUBSYSTEM-EXIT.
           EXIT.

       LOAD-PARENT-DESC.
           MOVE 999999999 TO PARENT-RRN.
           MOVE SPACES TO PARENT-DESC.
           MOVE SPACES TO DESC0 OF SCREEN8-O.
           MOVE SPACES TO SUBSYS-KEY OF SUBSYSBUFFER1.
           MOVE TYPENUM OF SCREEN8-O TO SUBSYS-TYPE OF SUBSYSBUFFER1.
           MOVE SUB0    OF SCREEN8-O TO PARENT-KEY.
           PERFORM CAL-PARENT-KEY.
           MOVE PARENT-KEY TO SUBSYS-PARENT-NUM OF SUBSYSBUFFER1.
           MOVE SUBSYS-KEY OF SUBSYSBUFFER1 TO HIERKEY
            OF SUBSYSRCD-LF1.
           START SUBSYS-LF1
            KEY IS EQUAL HIERKEY OF SUBSYSRCD-LF1
             INVALID KEY
              GO TO LOAD-PARENT-EXIT.
           MOVE "N" TO STOP-READ.
           PERFORM READ-PARENT THRU READ-PARENT-EXIT
            UNTIL STOP-READ = "Y".

       LOAD-PARENT-EXIT.
           EXIT.

       CAL-PARENT-KEY.
           IF PK2 = 0
             MOVE 0 TO PK1
           ELSE
           IF PK3 = 0
             MOVE 0 TO PK2
           ELSE
           IF PK4 = 0
             MOVE 0 TO PK3
           ELSE
             MOVE 0 TO PK4.

       READ-PARENT.
           READ SUBSYS-LF1 NEXT RECORD INTO SUBSYSBUFFER1
            AT END
              MOVE "Y" TO STOP-READ
              GO TO READ-PARENT-EXIT.
           IF SUBSYS-PARENT-NUM OF SUBSYSBUFFER1 NOT = PARENT-KEY
            OR SUBSYS-TYPE OF SUBSYSBUFFER1 NOT = TYPENUM OF SCREEN8-O
             MOVE "Y" TO STOP-READ
             GO TO READ-PARENT-EXIT.
           IF SUBSYS-CHILD-NUM OF SUBSYSBUFFER1 = SUB0 OF SCREEN8-O
             MOVE SUBSYS-DESC  OF SUBSYSBUFFER1 TO DESC0 OF SCREEN8-O
                                                   PARENT-DESC
             ACCEPT IOFEEDBACK FROM I-O-FEEDBACK-AREA
             MOVE IO-REL-NO TO PARENT-RRN.

       READ-PARENT-EXIT.
           EXIT.

       LOAD-DESCS.
           MOVE ALL "9" TO KEY-TABLE.
           MOVE SPACES TO SUBSYS-KEY OF SUBSYSBUFFER1.
           MOVE TYPENUM OF SCREEN8-O TO SUBSYS-TYPE OF SUBSYSBUFFER1.
           MOVE SUB0    OF SCREEN8-O TO SUBSYS-PARENT-NUM
            OF SUBSYSBUFFER1.
           MOVE SUBSYS-KEY OF SUBSYSBUFFER1 TO HIERKEY
            OF SUBSYSRCD-LF1.
           START SUBSYS-LF1
            KEY IS EQUAL HIERKEY OF SUBSYSRCD-LF1
             INVALID KEY
              GO TO LOAD-DESCS-EXIT.
           MOVE "N" TO STOP-READ.
           PERFORM READ-SUBS THRU READ-SUBS-EXIT UNTIL STOP-READ = "Y".

       LOAD-DESCS-EXIT.
           EXIT.

       READ-SUBS.
           READ SUBSYS-LF1 NEXT RECORD INTO SUBSYSBUFFER1
            AT END
              MOVE "Y" TO STOP-READ
              GO TO READ-SUBS-EXIT.
           IF SUBSYS-PARENT-NUM OF SUBSYSBUFFER1 NOT = SUB0
            OF SCREEN8-O
            OR SUBSYS-TYPE OF SUBSYSBUFFER1 NOT = TYPENUM OF SCREEN8-O
             MOVE "Y" TO STOP-READ
             GO TO READ-SUBS-EXIT.
           PERFORM FILL-DESC VARYING S1 FROM 1 BY 1 UNTIL S1 > 9.

       READ-SUBS-EXIT.
           EXIT.

       INIT-DESC.
           MOVE SPACES TO SCREEN-DESC (S1) SCREEN-DESC2 (S1).

       FILL-DESC.
           IF SCREEN-SUBSYS (S1) = SUBSYS-CHILD-NUM OF SUBSYSBUFFER1
             MOVE SUBSYS-DESC OF SUBSYSBUFFER1 TO SCREEN-DESC  (S1)
                                                  SCREEN-DESC2 (S1)
             ACCEPT IOFEEDBACK FROM I-O-FEEDBACK-AREA
             MOVE IO-REL-NO TO PKEY (S1)
             MOVE 10 TO S1.

       CAL-SUBS.
           MOVE EDIT-SUBSYS TO SCREEN-SUBSYS (S1).
           IF SS-B2 (S1) = 0 ADD S1 TO SS-B2 (S1)
           ELSE
           IF SS-B3 (S1) = 0 ADD S1 TO SS-B3 (S1)
           ELSE
           IF SS-B4 (S1) = 0 ADD S1 TO SS-B4 (S1)
           ELSE              MOVE SPACES TO SCREEN-SUBSYS (S1).

       CAL-SUBS-EXIT.
           EXIT.

       UPDATE-VERIFY.
           PERFORM PARENT-UPDATE-VERIFY THRU PARENT-UPDATE-VERIFY-EXIT.
           IF CONTINUE-UPDATE
             PERFORM SUBSYS-UPDATE-VERIFY THRU SUBSYS-UPDATE-VERIFY-EXIT
               VARYING S1 FROM 1 BY 1 UNTIL S1 > 9.
      *        UNTIL S1 > 9 OR NOT-CONTINUE-UPDATE.
       UPDATE-VERIFY-EXIT.
           EXIT.

       PARENT-UPDATE-VERIFY.
           IF PARENT-RRN NOT = 999999999 AND WS-DESC0  = SPACES
               IF UPDATE-BEING-VERIFIED
                 SET CONTINUE-UPDATE TO TRUE
                 SET UPDATE-NOT-BEING-VERIFIED TO TRUE
                 MOVE SPACES TO VERIFYMSG
               ELSE
                 SET UPDATE-BEING-VERIFIED TO TRUE
                 SET NOT-CONTINUE-UPDATE TO TRUE
                 IF WS-L = "Y" OR WS-S = "Y"
      *M         "LOWER LEVELS AND SPARE PARTS WILL BE DELETED, PRESS"
      *M         "F4 TO CONTINUE DELETE"
                   MOVE 38018 TO CATREAD-MSG-NUMBER
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE ERROR-BUFFER TO VERIFYMSG
                 ELSE
      *M         "PRESS F4 AGAIN TO CONFIRM THE DELETE OF THE SUBSYSTEM"
                   MOVE 42143 TO CATREAD-MSG-NUMBER
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE ERROR-BUFFER TO VERIFYMSG
                 END-IF
               END-IF.
       PARENT-UPDATE-VERIFY-EXIT.
           EXIT.

       SUBSYS-UPDATE-VERIFY.
           IF PKEY (S1) NOT = 999999999 AND SCREEN-DESC (S1) = SPACES
               IF UPDATE-BEING-VERIFIED
                 SET CONTINUE-UPDATE TO TRUE
                 SET UPDATE-NOT-BEING-VERIFIED TO TRUE
                 MOVE SPACES TO VERIFYMSG
               ELSE
                 SET UPDATE-BEING-VERIFIED TO TRUE
                 SET NOT-CONTINUE-UPDATE TO TRUE
                 IF WS-L = "Y" OR WS-S = "Y"
      *M         "LOWER LEVELS AND SPARE PARTS WILL BE DELETED, PRESS"
      *M         "F4 TO CONTINUE DELETE"
                   MOVE 38018 TO CATREAD-MSG-NUMBER
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE ERROR-BUFFER TO VERIFYMSG
                 ELSE
      *M         "PRESS F4 AGAIN TO CONFIRM THE DELETE OF THE SUBSYSTEM"
                   MOVE 42143 TO CATREAD-MSG-NUMBER
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE ERROR-BUFFER TO VERIFYMSG
                 END-IF
               END-IF
             END-IF.
       SUBSYS-UPDATE-VERIFY-EXIT.
           EXIT.

       EDIT-PARENT.
           MOVE "N" TO DELETED-SW.

           IF PARENT-RRN = 999999999 AND WS-DESC0 NOT = SPACES
             PERFORM ADD-PARENT THRU ADD-PARENT-EXIT
           ELSE
           IF PARENT-RRN NOT = 999999999 AND WS-DESC0 = SPACES
             PERFORM DEL-PARENT THRU DEL-PARENT-EXIT
           ELSE
           IF PARENT-RRN NOT = 999999999 AND
           (WS-DESC0 NOT = PARENT-DESC)
             PERFORM MOD-PARENT THRU MOD-PARENT-EXIT.

       EDIT-PARENT-EXIT.
           EXIT.

       ADD-PARENT.
           MOVE SPACES TO SUBSYSRCD-LF2.
           STRING TYPENUM1 OF SCREEN8-O
                  PARENT-KEY
            DELIMITED BY SIZE INTO HIERKEY OF SUBSYSRCD-LF2.
           MOVE WS-SUB0            TO HIERDSPCOD OF SUBSYSRCD-LF2.
           MOVE WS-DESC0           TO HIERSUBNAM OF SUBSYSRCD-LF2.
           WRITE SUBSYSRCD-LF2
            INVALID KEY
             MOVE 27027 TO CATREAD-MSG-NUMBER
             PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
             MOVE ERROR-BUFFER TO WS-ERRMSG
             MOVE T-VAL TO INDS (99).

       ADD-PARENT-EXIT.
           EXIT.

       MOD-PARENT.
           MOVE SPACES TO SUBSYSRCD-PF.
           STRING TYPENUM1 OF SCREEN8-O
                  PARENT-KEY
            DELIMITED BY SIZE INTO HIERKEY OF SUBSYSRCD-PF.
           MOVE WS-SUB0            TO HIERDSPCOD OF SUBSYSRCD-PF.
           MOVE WS-DESC0           TO HIERSUBNAM OF SUBSYSRCD-PF.

           MOVE PARENT-RRN TO PFKEY.
           REWRITE SUBSYSRCD-PF
            INVALID KEY
             MOVE 27028 TO CATREAD-MSG-NUMBER
             PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
             MOVE ERROR-BUFFER TO WS-ERRMSG
             MOVE T-VAL TO INDS (99).

       MOD-PARENT-EXIT.
           EXIT.

       DEL-PARENT.
           MOVE PARENT-RRN TO PFKEY.
           DELETE SUBSYS-PF RECORD
            INVALID KEY
             MOVE 27030 TO CATREAD-MSG-NUMBER
             PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
             MOVE ERROR-BUFFER TO WS-ERRMSG
             MOVE T-VAL TO INDS (99)
             GO TO DEL-PARENT-EXIT.

           IF WS-S = "Y"
             MOVE "N" TO STOP-READ1
             MOVE SPACES TO HIERKEY OF CCLINKRCD-LF2
             STRING TYPENUM1 OF SCREEN8-O
                    WS-SUB0
              DELIMITED BY SIZE INTO HIERKEY OF CCLINKRCD-LF2
             MOVE HIERKEY OF CCLINKRCD-LF2 TO SAVE-CCLINK-KEY
             START CCLINK-LF2
              KEY IS = HIERKEY OF CCLINKRCD-LF2
               INVALID KEY
                MOVE "Y" TO STOP-READ1
             END-START
             PERFORM DEL-CCLINK THRU DEL-CCLINK-EXIT
              UNTIL STOP-READ1 = "Y".

           MOVE 0 TO S2.
           INSPECT WS-SUB0 TALLYING S2 FOR ALL "0".
           IF S2 = 3 MOVE 1 TO S2
           ELSE
           IF S2 = 2 MOVE 2 TO S2
           ELSE
           IF S2 = 1 MOVE 3 TO S2
           ELSE      MOVE 4 TO S2.
           MOVE WS-SUB0 TO COMP1-BYTES.

           IF WS-L = "Y"
             MOVE "Y" TO DELETED-SW
             MOVE SPACES TO HIERKEY OF SUBSYSRCD-LF2
             STRING TYPENUM1 OF SCREEN8-O WS-SUB0
              DELIMITED BY SIZE INTO HIERKEY OF SUBSYSRCD-LF2
             START SUBSYS-LF2
              KEY IS NOT LESS THAN HIERKEY OF SUBSYSRCD-LF2
               INVALID KEY
                GO TO DEL-PARENT-EXIT
             END-START
             MOVE "N" TO STOP-READ
             PERFORM DEL-CONT THRU DEL-CONT-EXIT UNTIL STOP-READ = "Y".

       DEL-PARENT-EXIT.
           EXIT.

       EDIT-SUBSYSTEMS.
           IF DELETED-SW = "Y"
             MOVE 10 TO S1
             GO TO EDIT-SUBSYSTEMS-EXIT.

           IF PKEY (S1) = 999999999 AND SCREEN-DESC (S1) NOT = SPACES
             PERFORM ADD-SUBSYSTEM THRU ADD-SUBSYSTEM-EXIT
           ELSE
           IF PKEY (S1) NOT = 999999999 AND SCREEN-DESC (S1) = SPACES
             PERFORM DEL-SUBSYSTEM THRU DEL-SUBSYSTEM-EXIT
           ELSE
           IF PKEY (S1) NOT = 999999999 AND
           (SCREEN-DESC (S1) NOT = SCREEN-DESC2 (S1))
             PERFORM MOD-SUBSYSTEM THRU MOD-SUBSYSTEM-EXIT.

       EDIT-SUBSYSTEMS-EXIT.
           EXIT.

       ADD-SUBSYSTEM.
           MOVE SPACES TO SUBSYSRCD-LF2.
           STRING TYPENUM1 OF SCREEN8-O
                  SUB0     OF SCREEN8-O
            DELIMITED BY SIZE INTO HIERKEY OF SUBSYSRCD-LF2.
           MOVE SCREEN-SUBSYS (S1) TO HIERDSPCOD OF SUBSYSRCD-LF2.
           MOVE SCREEN-DESC   (S1) TO HIERSUBNAM OF SUBSYSRCD-LF2.
           WRITE SUBSYSRCD-LF2
            INVALID KEY
             MOVE 4 TO CATREAD-MSG-NUM
             PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
             MOVE ERROR-BUFFER TO WS-ERRMSG
             MOVE T-VAL TO INDS (99).

       ADD-SUBSYSTEM-EXIT.
           EXIT.

       MOD-SUBSYSTEM.
           MOVE SPACES TO SUBSYSRCD-PF.
           STRING TYPENUM1 OF SCREEN8-O
                  SUB0     OF SCREEN8-O
            DELIMITED BY SIZE INTO HIERKEY OF SUBSYSRCD-PF.
           MOVE SCREEN-SUBSYS (S1) TO HIERDSPCOD OF SUBSYSRCD-PF.
           MOVE SCREEN-DESC   (S1) TO HIERSUBNAM OF SUBSYSRCD-PF.

           MOVE PKEY (S1) TO PFKEY.
           REWRITE SUBSYSRCD-PF
            INVALID KEY
             MOVE 27029 TO CATREAD-MSG-NUM
             PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
             MOVE ERROR-BUFFER TO WS-ERRMSG
             MOVE T-VAL TO INDS (99).

       MOD-SUBSYSTEM-EXIT.
           EXIT.

       DEL-SUBSYSTEM.
           MOVE PKEY (S1) TO PFKEY.
           DELETE SUBSYS-PF RECORD
            INVALID KEY
             MOVE 7 TO CATREAD-MSG-NUMBER
             PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
             MOVE ERROR-BUFFER TO WS-ERRMSG
             MOVE T-VAL TO INDS (99)
             GO TO DEL-SUBSYSTEM-EXIT.

           IF WS-S = "Y"
             MOVE "N" TO STOP-READ1
             MOVE SPACES TO HIERKEY OF CCLINKRCD-LF2
             STRING TYPENUM1 OF SCREEN8-O
                    SCREEN-SUBSYS (S1)
              DELIMITED BY SIZE INTO HIERKEY OF CCLINKRCD-LF2
             MOVE HIERKEY OF CCLINKRCD-LF2 TO SAVE-CCLINK-KEY
             START CCLINK-LF2
              KEY IS = HIERKEY OF CCLINKRCD-LF2
               INVALID KEY
                MOVE "Y" TO STOP-READ1
             END-START
             PERFORM DEL-CCLINK THRU DEL-CCLINK-EXIT
              UNTIL STOP-READ1 = "Y".

           MOVE 0 TO S2.
           INSPECT SCREEN-SUBSYS (S1) TALLYING S2 FOR ALL "0".
           IF S2 = 3 MOVE 1 TO S2
           ELSE
           IF S2 = 2 MOVE 2 TO S2
           ELSE
           IF S2 = 1 MOVE 3 TO S2
           ELSE      MOVE 4 TO S2.
           MOVE SCREEN-SUBSYS (S1) TO COMP1-BYTES.

           IF WS-L = "Y"
             MOVE SPACES TO HIERKEY OF SUBSYSRCD-LF2
             STRING TYPENUM1 OF SCREEN8-O SCREEN-SUBSYS (S1)
              DELIMITED BY SIZE INTO HIERKEY OF SUBSYSRCD-LF2
             START SUBSYS-LF2
              KEY IS NOT LESS THAN HIERKEY OF SUBSYSRCD-LF2
               INVALID KEY
                GO TO DEL-SUBSYSTEM-EXIT
             END-START
             MOVE "N" TO STOP-READ
             PERFORM DEL-CONT THRU DEL-CONT-EXIT UNTIL STOP-READ = "Y".

       DEL-SUBSYSTEM-EXIT.
           EXIT.

       DEL-CONT.
           READ SUBSYS-LF2 NEXT RECORD INTO SUBSYSBUFFER2
            AT END
              MOVE "Y" TO STOP-READ
              GO TO DEL-CONT-EXIT.
           MOVE SUBSYS-PARENT OF SUBSYSBUFFER2 TO COMP2-BYTES.
           IF SUBSYS-TYPE OF SUBSYSBUFFER2 NOT = TYPENUM1 OF SCREEN8-O
             REWRITE SUBSYSRCD-LF2
             MOVE "Y" TO STOP-READ
             GO TO DEL-CONT-EXIT.
           PERFORM COMPARE-BYTES VARYING S3 FROM 1 BY 1 UNTIL S3 > S2.
           IF STOP-READ = "Y"
             REWRITE SUBSYSRCD-LF2
             GO TO DEL-CONT-EXIT.

           DELETE SUBSYS-LF2 RECORD
            INVALID KEY
             MOVE 7 TO CATREAD-MSG-NUMBER
             PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
             MOVE ERROR-BUFFER TO WS-ERRMSG
             MOVE T-VAL TO INDS (99).

           IF WS-S NOT = "Y"
             GO TO DEL-CONT-EXIT.

           MOVE SPACES TO HIERKEY OF CCLINKRCD-LF2.
           STRING SUBSYS-TYPE OF SUBSYSBUFFER2
                  SUBSYS-CHILD-NUM OF SUBSYSBUFFER2
            DELIMITED BY SIZE INTO HIERKEY OF CCLINKRCD-LF2.
           MOVE HIERKEY OF CCLINKRCD-LF2 TO SAVE-CCLINK-KEY.
           START CCLINK-LF2
            KEY IS = HIERKEY OF CCLINKRCD-LF2
             INVALID KEY
              GO TO DEL-CONT-EXIT.
           MOVE "N" TO STOP-READ1.
           PERFORM DEL-CCLINK THRU DEL-CCLINK-EXIT
            UNTIL STOP-READ1 = "Y".

       DEL-CONT-EXIT.
           EXIT.

       COMPARE-BYTES.
           IF COMP1 (S3) NOT = COMP2 (S3)
             MOVE "Y" TO STOP-READ.

       DEL-CCLINK.
           READ CCLINK-LF2 NEXT RECORD
            AT END
              MOVE "Y" TO STOP-READ1
              GO TO DEL-CCLINK-EXIT.

           IF HIERKEY OF CCLINKRCD-LF2 NOT = SAVE-CCLINK-KEY
             REWRITE CCLINKRCD-LF2
             MOVE "Y" TO STOP-READ1
             GO TO DEL-CCLINK-EXIT.

           DELETE CCLINK-LF2 RECORD
            INVALID KEY
             MOVE 7 TO CATREAD-MSG-NUMBER
             PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
             MOVE ERROR-BUFFER TO WS-ERRMSG
             MOVE T-VAL TO INDS (99).

       DEL-CCLINK-EXIT.
           EXIT.

       98-SCREEN-READ.
           READ DISPLAY-FILE FORMAT IS VIEW-CFNAME
               INDIC IS INDICS.
           ACCEPT IOFEEDBACK FROM I-O-FEEDBACK-AREA.
           MOVE ALL B"0" TO INDICS.
           IF DSPLY-STATUS NOT = "00"
               MOVE 3 TO VIEW-LASTKEY
           ELSE
           MOVE FUNCTION-NUM TO VIEW-LASTKEY.

       98A-SCREEN-READ.
           READ DISPLAY-FILE TERMINAL IS TERMINAL-ID
               INDIC IS INDICS
                  NO DATA MOVE DSPLY-STATUS TO DSPLY-STATUS.
           MOVE ALL B"0" TO INDICS.

       99-SCREEN-WRITE.
           WRITE DSPLY-REC FORMAT IS VIEW-CFNAME
               INDIC IS INDICS.
           MOVE ALL B"0" TO INDICS.

178200 999-CATREAD.
178300     MOVE SPACES TO ERROR-BUFFER.
           CALL "CCATREAD" USING CATREAD-PARMS.
           MOVE CATREAD-MSG-TEXT TO ERROR-BUFFER.
179800 999-CATREAD-EXIT.    EXIT.
