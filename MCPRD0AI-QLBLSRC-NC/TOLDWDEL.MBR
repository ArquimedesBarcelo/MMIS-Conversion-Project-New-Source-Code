000200 IDENTIFICATION DIVISION.
000300 PROGRAM-ID. TOLDWDEL.
000600*REMARKS.
000700*D    THIS PROGRAM DELETES ALL WORK ORDERS PRIOR TO A DATE
000800*D    THAT WAS SPECIFIED BY THE USER.
      *C
      *C 09/11/96  JEFF BUNGO
      *C    EXPAND DATE FIELDS FOR YEAR 2000 COMPLIANCE.
      *C    MOVE INPUT DATE TO TEMP DATE TO COMPUTE CENTURY,
      *C    USE TEMP DATE IN COMPARISON.
      *C
001300 ENVIRONMENT DIVISION.
001400 CONFIGURATION SECTION.
001500 SOURCE-COMPUTER.  IBM-AS400.
001600 OBJECT-COMPUTER.  IBM-AS400.
       COPY SPECIALN OF COPYLIB.
002100 INPUT-OUTPUT SECTION.
002200 FILE-CONTROL.
           SELECT DISPLAY-FILE
               ASSIGN TO WORKSTATION-ZOLDWDEL-SI
               ORGANIZATION IS TRANSACTION
               ACCESS IS SEQUENTIAL
               FILE STATUS IS DSPLY-STATUS
               CONTROL-AREA IS WS-CONTROL.

002300     SELECT WO-FILE
                  ASSIGN TO DATABASE-DWOFIL
                  ORGANIZATION IS SEQUENTIAL.

           SELECT SORT-FILE ASSIGN TO DISK-SORT.

           SELECT WO-BASIC
                  ASSIGN TO DATABASE-MCFLMM1001
                  ORGANIZATION IS INDEXED
                  ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                  FILE STATUS IS FILE-STATUS.

           SELECT WO-PLANNED
                  ASSIGN TO DATABASE-MCFLMM1101
                  ORGANIZATION IS INDEXED
                  ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                  FILE STATUS IS FILE-STATUS.

           SELECT ONLINE-PRT ASSIGN TO PRINTER-MCPRT.

002500 DATA DIVISION.
002600 FILE SECTION.
       FD  DISPLAY-FILE
           LABEL RECORDS ARE OMITTED.
       01  DSPLY-REC                     PIC X(2000).

002800 FD  WO-FILE
002900     LABEL RECORDS ARE OMITTED
003000     RECORD CONTAINS 10  CHARACTERS.
003100 01  WO-RCD.
003200     05  WO-NUMBER         PIC X(10).

       SD  SORT-FILE
           DATA RECORD IS SORT-REC.
       01  SORT-REC.
           05  SORT-WO-NUMBER    PIC X(10).

       FD  WO-BASIC
           LABEL RECORDS ARE STANDARD.
       01  WO-BASIC-REC.
           COPY DDS-MCRPMM1000  OF MCFLMM1001.

       FD  WO-PLANNED
           LABEL RECORDS ARE STANDARD.
       01  WO-PLANNED-REC.
           COPY DDS-MCRPMM1100  OF MCFLMM1101.

       FD  ONLINE-PRT
           LABEL RECORDS ARE OMITTED
           RECORD CONTAINS 132 CHARACTERS
           DATA RECORD IS PRINT-RCD.
       01  PRINT-RCD.
           05  PRINT-LINE        PIC X(132).

003500 WORKING-STORAGE SECTION.
003600 77  DELETED-WOS-CTR       PIC 9(6) VALUE 0.
       77  LINE-CTR              PIC 99   VALUE 59.
003700 77  WOS-TO-DELETE-CTR     PIC 9(6) VALUE 0.
003800
022300 COPY CCRTFILE IN COPYLIB.

       01  TEMP-DATE-CN.
           05  TEMP-DATE-CC      PIC XX.
           05  TEMP-DATE.
               10  TEMP-DATE-YY  PIC XX.
               10  FILLER        PIC X(4).

       01  CDATE.
           05 YY                 PIC 99.
           05 MM                 PIC 99.
           05 DD                 PIC 99.

       COPY CPYIND   IN COPYLIB.

       01  DSPLY-STATUS          PIC XX.

       01  FILE-STATUS.
           05  FILE-STATUS-1     PIC X.
           05  FILE-STATUS-2     PIC X.

       01  DETAIL-1.
           05  FILLER            PIC X(3)  VALUE SPACES.
           05  D-WO              PIC X(10) VALUE SPACES.
           05  FILLER            PIC X(2)  VALUE SPACES.
           05  D-LIT             PIC X(32) VALUE SPACES.
           05  D-DATE-RECD       PIC X(8)  VALUE SPACES.
           05  FILLER            PIC X(3)  VALUE SPACES.
           05  D-ZONE            PIC X(4)  VALUE SPACES.
           05  FILLER            PIC X(3)  VALUE SPACES.
           05  D-EQUIP           PIC X(6)  VALUE SPACES.
           05  FILLER            PIC X(3)  VALUE SPACES.
           05  D-STATUS          PIC X(2)  VALUE SPACES.
           05  FILLER            PIC X(4)  VALUE SPACES.

       01  ERROR-LINE            PIC X(80) VALUE SPACES.

       01  HEADER-0.
           05  FILLER            PIC X(23) VALUE SPACES.
           05  FILLER            PIC X(25)
               VALUE "WORK ORDER DELETE UTILITY".
           05  FILLER            PIC X(24) VALUE SPACES.
           05  H0-DATE.
               10  H0-MM         PIC XX    VALUE SPACES.
               10  FILLER        PIC X     VALUE "/".
               10  H0-DD         PIC XX    VALUE SPACES.
               10  FILLER        PIC X     VALUE "/".
               10  H0-YY         PIC XX    VALUE SPACES.

       01  HEADER-1.
           05  FILLER            PIC X(12) VALUE "INPUT DATE: ".
           05  H-1-DATE          PIC X(6)  VALUE SPACES.
           05  FILLER            PIC X(3)  VALUE SPACES.
           05  FILLER            PIC X(12) VALUE "INPUT ZONE: ".
           05  H-1-ZONE          PIC X(4)  VALUE SPACES.
           05  FILLER            PIC X(3)  VALUE SPACES.
           05  FILLER            PIC X(13) VALUE "INPUT EQUIP: ".
           05  H-1-EQUIP         PIC X(6)  VALUE SPACES.
           05  FILLER            PIC X(3)  VALUE SPACES.
           05  FILLER            PIC X(14) VALUE "INPUT STATUS: ".
           05  H-1-STATUS        PIC X(2)  VALUE SPACES.
           05  FILLER            PIC X(2)  VALUE SPACES.

       01  HEADER-U.
           05  FILLER            PIC X(80) VALUE ALL "-".

       01  INPUT-BUFFER.
           05  INPUT-DATE        PIC X(6).
           05  INPUT-VERBAL-SW   PIC X.
           05  INPUT-PLANNED-SW  PIC X.
           05  INPUT-SUFFIXED-SW PIC X.
           05  INPUT-PRINT-SW    PIC X.
           05  INPUT-ZONE        PIC X(4).
           05  INPUT-EQPNUM      PIC X(6).
           05  INPUT-STATUS      PIC XX.
           05  INPUT-CMD-LINE    PIC X(79).
           05  INPUT-ERR-LINE    PIC X(79).

       01  INPUT-BUFFER2.
           05  INPUT-CTR2        PIC X(6).
           05  INPUT-DELSW2      PIC X.
           05  INPUT-CMD-LINE2   PIC X(79).
           05  INPUT-ERR-LINE2   PIC X(79).

       COPY IOFEEDBACK IN COPYLIB.

       COPY OVRPFDATA  IN COPYLIB.

       COPY VCOMLINK   IN COPYLIB.

       COPY WSCONTROL  IN COPYLIB.
003900**************************************************************
004000**************************************************************
004100**                                                          **
004200**                DATABASE I/O BUFFER AREA                  **
004300**                                                          **
004400**************************************************************
004500**************************************************************
004600
005700 COPY DATAB    IN COPYLIB.
005900
006000*********************
006100*                   *
006200*   DATA SET NAMES  *
006300*                   *
006400*********************
006500
006600 01  DSET-NAMES.
006700     05  DSET-NAME              PIC X(16)  VALUE SPACES.
006800     05  DSET-WOBASIC           PIC X(16)  VALUE "WO-BASIC;".
006900     05  DSET-WOPLAN            PIC X(16)  VALUE "WO-PLANNED;".
007300
007400 01 ITEMS-LISTING.
007500     05  ALL-ITEMS              PIC XX    VALUE "@;".
007600     05  WO-SEARCH              PIC X(11) VALUE "WO-NUM;".
007700
007800 01 ARG-VALUES.
007900     05  WO-ARG                 PIC X(10) VALUE SPACES.
008000
008500 COPY TBLOWUP   IN COPYLIB.
008700
004700 01  WO-BASIC-DATA.         COPY DWOBASIC IN COPYLIB.
004800
       01  WO-NUMBER-SCREEN.
           05  DELETE-WO-NUM          PIC X(10).
           05  WO-CMD-LINE            PIC X(79).
           05  WO-ERR-LINE            PIC X(79).

004700 01  WO-PLANNED-DATA.       COPY DWOPLAN  IN COPYLIB.
004800
008800 PROCEDURE DIVISION.
008900 BEGIN-HERE.
009000     PERFORM 1-HSK THRU 1-H-X.
009100     PERFORM 6-MAIN  THRU 6-M-X.
009200
009300 2-EOJ.
           CLOSE DISPLAY-FILE.
           CLOSE WO-BASIC, WO-PLANNED.
           CLOSE ONLINE-PRT.
009800     GOBACK.
009900
010000 1-HSK.
           OPEN I-O    DISPLAY-FILE.
           OPEN I-O    WO-BASIC.
           OPEN I-O    WO-PLANNED.
           ACCEPT CDATE        FROM DATE.
           MOVE MM             TO H0-MM.
           MOVE DD             TO H0-DD.
           MOVE YY             TO H0-YY.
           MOVE 59             TO LINE-CTR.
           MOVE 0              TO WOS-TO-DELETE-CTR,
                                  DELETED-WOS-CTR.
           MOVE SPACES         TO INPUT-BUFFER.
           MOVE "MCPRT"        TO OVRPRTF-FILE.
           PERFORM 996-OVERRIDE-PRINT-FILE.
           OPEN OUTPUT ONLINE-PRT.

010500 1-H-X.
010600     EXIT.
010700
010800*********************************************
010900*                                           *
011000*  BLOWUP ROUTINE EXECUTES WHENEVER A       *
011100*  FATAL ERROR OCCURS                       *
011200*                                           *
011300*********************************************
011400
011500 2-BLOWUP.
011600     MOVE "TOLDWDEL"  TO  BU-PGM-NAME.
011700     CALL "TBLOWUP" USING BASE, BU-PGM-NAME, STATUS-AREA,
011800         DUMMY-VIEW-AREA, DUMMY-KSAM-STAT, BU-DISPLAY-MSG,
011900                 BU-DISPLAY-FLDS.
012000
012100 6-MAIN.
      ***************************************************************
      **   CREATE TEMPORARY FILE ('WOFIL') TO CONTAIN ALL REQS      *
      **   IN THE DATABASE THAT ARE DELETEABLE.                     *
      ***************************************************************
           MOVE "*LIBL"       TO CCRTFILE-LIBRARY.
           MOVE "DWOFIL"      TO CCRTFILE-FILE.
           MOVE "0010"        TO CCRTFILE-RECORD-LENGTH.
           MOVE "10000"       TO CCRTFILE-NO-RECORDS.
           MOVE "01000"       TO CCRTFILE-INCREMENT-AMT.
           MOVE "01"          TO CCRTFILE-NO-INCREMENTS.
           CALL "CCRTFILE" USING CCRTFILE-LIBRARY,
                                 CCRTFILE-FILE,
                                 CCRTFILE-RECORD-LENGTH,
                                 CCRTFILE-NO-RECORDS,
                                 CCRTFILE-INCREMENT-AMT,
                                 CCRTFILE-NO-INCREMENTS,
                                 CCRTFILE-STATUS.
           IF CCRTFILE-STATUS NOT = "00"
               MOVE "CCRTFILE CREATE OF 'DWOFIL' FAILED"
                  TO BU-DISPLAY-MSG
               PERFORM 2-BLOWUP.

       6-MAIN-CONT.
           MOVE "FOLDWODL"    TO VIEW-CFNAME.
           MOVE INPUT-BUFFER  TO DSPLY-REC.
           PERFORM 99-SCREEN-WRITE.
           PERFORM 98-SCREEN-READ.
           MOVE DSPLY-REC     TO INPUT-BUFFER.
           MOVE SPACES        TO INPUT-ERR-LINE.
           MOVE INPUT-DATE    TO H-1-DATE.
           MOVE INPUT-ZONE    TO H-1-ZONE.
           MOVE INPUT-EQPNUM  TO H-1-EQUIP.
           MOVE INPUT-STATUS  TO H-1-STATUS.
           IF VIEW-LASTKEY = 3 GO TO 6-M-X.

           MOVE INPUT-DATE TO TEMP-DATE.
           IF TEMP-DATE-YY > "70"
               MOVE "19" TO TEMP-DATE-CC
           ELSE
               MOVE "20" TO TEMP-DATE-CC.

012200     OPEN OUTPUT WO-FILE.
012300     PERFORM 61-GET-WOS-TO-DELETE  THRU  61-GWTD-X.
012400     CLOSE WO-FILE.

           IF WOS-TO-DELETE-CTR > 0
               SORT SORT-FILE ON ASCENDING SORT-WO-NUMBER
                   USING WO-FILE
                   GIVING WO-FILE
           ELSE
           MOVE "NO WORK ORDERS TO DELETE" TO INPUT-ERR-LINE
           MOVE B"1" TO INDS (99)
           MOVE SPACES TO WONUM OF WO-BASIC-REC
                                   WO-PLANNED-REC
           START WO-BASIC KEY > WONUM OF WO-BASIC-REC
           START WO-PLANNED KEY > WONUM OF WO-PLANNED-REC
           GO TO 6-MAIN-CONT.
013400
           MOVE "FOLDWOD2" TO VIEW-CFNAME.
           MOVE WOS-TO-DELETE-CTR TO INPUT-CTR2.
           MOVE "N" TO INPUT-DELSW2.
           MOVE INPUT-BUFFER2 TO DSPLY-REC.
           PERFORM 99-SCREEN-WRITE.
           PERFORM 98-SCREEN-READ.
           MOVE DSPLY-REC TO INPUT-BUFFER2.
           IF (INPUT-DELSW2  = "N") OR (VIEW-LASTKEY = 3)
               OPEN INPUT WO-FILE
               PERFORM 6-PRINT-WOS THRU 6-PW-X
           ELSE
013500     OPEN INPUT WO-FILE
013600     PERFORM 62-DELETE-WO  THRU  62-DW-X.
013700     CLOSE WO-FILE.
013800
013900 6-M-X.
014000     EXIT.
014100
       6-PRINT-WOS.
           READ WO-FILE AT END GO TO 6-PW-X.
           ADD 1 TO LINE-CTR.
           IF LINE-CTR > 59
               MOVE SPACES TO PRINT-RCD
               WRITE PRINT-RCD FROM HEADER-0 AFTER ADVANCING NEW-PAGE
               WRITE PRINT-RCD FROM HEADER-1 AFTER ADVANCING 1
               WRITE PRINT-RCD FROM HEADER-U AFTER ADVANCING 1
               MOVE SPACES TO PRINT-RCD
               STRING WO-NUMBER, " FITS YOUR INPUT CRITERIA",
                   " AND COULD BE DELETED",
                   DELIMITED BY SIZE INTO PRINT-RCD
               WRITE PRINT-RCD AFTER ADVANCING 1
               MOVE 4 TO LINE-CTR
           ELSE
           MOVE SPACES TO PRINT-RCD
           STRING WO-NUMBER, " FITS YOUR INPUT CRITERIA",
               " AND COULD BE DELETED"
               DELIMITED BY SIZE INTO PRINT-RCD
           WRITE PRINT-RCD AFTER ADVANCING 1.
           GO TO 6-PRINT-WOS.
       6-PW-X.    EXIT.

014200*************************************************
014300*                                               *
014400*   SERIAL GET OF WO-BASIC THEN WO-PLANNED      *
014500*                                               *
014600*************************************************
014700
014800 61-GET-WOS-TO-DELETE.
           IF INPUT-VERBAL-SW = "N" GO TO 61-GET-PLANNEDS-TOO.
           MOVE 0 TO COND-WORD.
           READ WO-BASIC NEXT INTO WO-BASIC-DATA
               AT END MOVE 11 TO COND-WORD.
           IF FILE-STATUS NOT = "00" MOVE 11 TO COND-WORD.
015100     IF COND-WORD NOT = 0
015200         IF COND-WORD = 11
015300             GO TO 61-GET-PLANNEDS-TOO
015400         ELSE
015500         MOVE WO-NUM  TO  BU-DISPLAY-FLD (1)
015600         MOVE "DBGET 61-GRTD"  TO  BU-DISPLAY-MSG
015700         GO TO 2-BLOWUP.
015800
      *-----USE TEMP DATE WITH CENTURY FOR COMPARISON
           IF DATE-RECD-CN NOT < TEMP-DATE-CN
               GO TO 61-GET-WOS-TO-DELETE.

           IF INPUT-ZONE = SPACES
               IF INPUT-EQPNUM = SPACES
                   IF INPUT-STATUS = "  " OR WO-STATUS
                       MOVE WO-NUM       TO  WO-NUMBER
                                             D-WO
                       ADD 1             TO  WOS-TO-DELETE-CTR
                       WRITE WO-RCD
                       MOVE DATE-RECD-CN TO  D-DATE-RECD
                       MOVE ZONE         TO  D-ZONE
                       MOVE EQUIP-NUM    TO  D-EQUIP
                       MOVE WO-STATUS    TO  D-STATUS
                       PERFORM 610-SET-AUDIT
                   ELSE
                   NEXT SENTENCE
               ELSE
               IF INPUT-EQPNUM = EQUIP-NUM
                   IF INPUT-STATUS = "  " OR WO-STATUS
                       MOVE WO-NUM       TO  WO-NUMBER
                                             D-WO
                       ADD 1             TO  WOS-TO-DELETE-CTR
                       WRITE WO-RCD
                       MOVE DATE-RECD-CN TO  D-DATE-RECD
                       MOVE ZONE         TO  D-ZONE
                       MOVE EQUIP-NUM    TO  D-EQUIP
                       MOVE WO-STATUS    TO  D-STATUS
                       PERFORM 610-SET-AUDIT
                   ELSE
                   NEXT SENTENCE
               ELSE
               NEXT SENTENCE
           ELSE
           IF INPUT-ZONE = ZONE
               IF INPUT-EQPNUM = EQUIP-NUM
                   IF INPUT-STATUS = "  " OR WO-STATUS
                       MOVE WO-NUM       TO  WO-NUMBER
                                             D-WO
                       ADD 1             TO  WOS-TO-DELETE-CTR
                       WRITE WO-RCD
                       MOVE DATE-RECD-CN TO  D-DATE-RECD
                       MOVE ZONE         TO  D-ZONE
                       MOVE EQUIP-NUM    TO  D-EQUIP
                       MOVE WO-STATUS    TO  D-STATUS
                       PERFORM 610-SET-AUDIT
                   ELSE
                   NEXT SENTENCE
               ELSE
               IF INPUT-EQPNUM = SPACES
                   IF INPUT-STATUS = "  " OR WO-STATUS
                       MOVE WO-NUM       TO  WO-NUMBER
                                             D-WO
                       ADD 1             TO  WOS-TO-DELETE-CTR
                       WRITE WO-RCD
                       MOVE DATE-RECD-CN TO  D-DATE-RECD
                       MOVE ZONE         TO  D-ZONE
                       MOVE EQUIP-NUM    TO  D-EQUIP
                       MOVE WO-STATUS    TO  D-STATUS
                       PERFORM 610-SET-AUDIT.
017800     GO TO 61-GET-WOS-TO-DELETE.
017900
       61-GET-PLANNEDS-TOO.
           IF INPUT-PLANNED-SW = "N" GO TO 61-GWTD-X.
           MOVE 0 TO COND-WORD.
           READ WO-PLANNED NEXT INTO WO-PLANNED-DATA
               AT END MOVE 11 TO COND-WORD.
           IF FILE-STATUS NOT = "00" MOVE 11 TO COND-WORD.
015100     IF COND-WORD NOT = 0
015200         IF COND-WORD = 11
015300             GO TO 61-GWTD-X
015400         ELSE
015500         MOVE WO-NUM-PLANNED   TO  BU-DISPLAY-FLD (1)
015600         MOVE "DBGET 61-GRTD"  TO  BU-DISPLAY-MSG
015700         GO TO 2-BLOWUP.
015800
      *-----USE TEMP DATE WITH CENTURY FOR COMPARE
           IF DATE-RECD-P-CN NOT < TEMP-DATE-CN
               GO TO 61-GET-PLANNEDS-TOO.

           IF SAVE-HIST-SW NOT = "  " GO TO 61-GET-PLANNEDS-TOO.

           IF WO-NUM-SUFF-P > "   "
               IF INPUT-SUFFIXED-SW = "Y"
                   NEXT SENTENCE
               ELSE
               GO TO 61-GET-PLANNEDS-TOO.

           IF INPUT-ZONE = SPACES
               IF INPUT-EQPNUM = SPACES
                   IF INPUT-STATUS = "  " OR WO-STATUS-P
                       MOVE WO-NUM-PLANNED TO  WO-NUMBER
                                               D-WO
                       ADD 1               TO  WOS-TO-DELETE-CTR
                       WRITE WO-RCD
                       MOVE DATE-RECD-P-CN TO  D-DATE-RECD
                       MOVE ZONE-P         TO  D-ZONE
                       MOVE EQUIP-NUM-P    TO  D-EQUIP
                       MOVE WO-STATUS-P    TO  D-STATUS
                       PERFORM 610-SET-AUDIT
                   ELSE
                   NEXT SENTENCE
               ELSE
               IF INPUT-EQPNUM = EQUIP-NUM-P
                   IF INPUT-STATUS = "  " OR WO-STATUS-P
                       MOVE WO-NUM-PLANNED TO  WO-NUMBER
                                               D-WO
                       ADD 1               TO  WOS-TO-DELETE-CTR
                       WRITE WO-RCD
                       MOVE DATE-RECD-P-CN TO  D-DATE-RECD
                       MOVE ZONE-P         TO  D-ZONE
                       MOVE EQUIP-NUM-P    TO  D-EQUIP
                       MOVE WO-STATUS-P    TO  D-STATUS
                       PERFORM 610-SET-AUDIT
                   ELSE
                   NEXT SENTENCE
               ELSE
               NEXT SENTENCE
           ELSE
           IF INPUT-ZONE = ZONE-P
               IF INPUT-EQPNUM = EQUIP-NUM-P
                   IF INPUT-STATUS = "  " OR WO-STATUS-P
                       MOVE WO-NUM-PLANNED TO  WO-NUMBER
                                               D-WO
                       ADD 1               TO  WOS-TO-DELETE-CTR
                       WRITE WO-RCD
                       MOVE DATE-RECD-P-CN TO  D-DATE-RECD
                       MOVE ZONE-P         TO  D-ZONE
                       MOVE EQUIP-NUM-P    TO  D-EQUIP
                       MOVE WO-STATUS-P    TO  D-STATUS
                       PERFORM 610-SET-AUDIT
                   ELSE
                   NEXT SENTENCE
               ELSE
               IF INPUT-EQPNUM = SPACES
                   IF INPUT-STATUS = "  " OR WO-STATUS
                       MOVE WO-NUM-PLANNED TO  WO-NUMBER
                                               D-WO
                       ADD 1               TO  WOS-TO-DELETE-CTR
                       WRITE WO-RCD
                       MOVE DATE-RECD-P-CN TO  D-DATE-RECD
                       MOVE ZONE-P         TO  D-ZONE
                       MOVE EQUIP-NUM-P    TO  D-EQUIP
                       MOVE WO-STATUS-P    TO  D-STATUS
                       PERFORM 610-SET-AUDIT.
017800     GO TO 61-GET-PLANNEDS-TOO.
018000 61-GWTD-X.    EXIT.
018200
       610-SET-AUDIT.
           IF INPUT-PRINT-SW = "Y"
             ADD 1 TO LINE-CTR
             MOVE "IS DELETEABLE FROM THE SYSTEM" TO D-LIT
             IF LINE-CTR > 59
               WRITE PRINT-RCD FROM HEADER-0 AFTER ADVANCING NEW-PAGE
               WRITE PRINT-RCD FROM HEADER-1 AFTER ADVANCING 1 LINES
               WRITE PRINT-RCD FROM HEADER-U AFTER ADVANCING 1 LINES
               WRITE PRINT-RCD FROM DETAIL-1 AFTER ADVANCING 1 LINES
               MOVE 4 TO LINE-CTR
             ELSE
             WRITE PRINT-RCD FROM DETAIL-1 AFTER ADVANCING 1 LINES.

       62-DELETE-WO.
           READ WO-FILE   AT END GO TO 62-DW-X.
025500     ADD 1 TO DELETED-WOS-CTR.
           MOVE SPACES TO WO-NUMBER-SCREEN.
           MOVE WO-NUMBER TO D-WO,
                             DELETE-WO-NUM.
           CALL "TMMDELSUB" USING WO-NUMBER-SCREEN.
           IF WO-ERR-LINE = SPACES
               MOVE "WAS DELETED FROM THE SYSTEM" TO D-LIT
           ELSE
           IF INPUT-PRINT-SW = "N"
               NEXT SENTENCE
           ELSE
           STRING "UNABLE TO DELETE W/O = ", DELETE-WO-NUM,
              " THE ERROR WAS ", FILE-STATUS
              DELIMITED BY SIZE INTO ERROR-LINE
           ADD 1 TO LINE-CTR
           IF LINE-CTR > 59
               WRITE PRINT-RCD FROM HEADER-0 AFTER ADVANCING NEW-PAGE
               WRITE PRINT-RCD FROM HEADER-1 AFTER ADVANCING 1 LINES
               WRITE PRINT-RCD FROM HEADER-U AFTER ADVANCING 1 LINES
               WRITE PRINT-RCD FROM ERROR-LINE AFTER ADVANCING 1 LINES
               MOVE 4 TO LINE-CTR
           ELSE
           WRITE PRINT-RCD FROM ERROR-LINE AFTER ADVANCING 1 LINES
           GO TO 62-DELETE-WO.
           IF INPUT-PRINT-SW = "Y"
               ADD 1 TO LINE-CTR
               IF LINE-CTR > 59
                 WRITE PRINT-RCD FROM HEADER-0 AFTER ADVANCING NEW-PAGE
                 WRITE PRINT-RCD FROM HEADER-1 AFTER ADVANCING 1 LINES
                 WRITE PRINT-RCD FROM HEADER-U AFTER ADVANCING 1 LINES
                 WRITE PRINT-RCD FROM DETAIL-1 AFTER ADVANCING 1 LINES
                 MOVE 4 TO LINE-CTR
               ELSE
               WRITE PRINT-RCD FROM DETAIL-1 AFTER ADVANCING 1 LINES.
           GO TO 62-DELETE-WO.
       62-DW-X.    EXIT.

       98-SCREEN-READ.
           READ DISPLAY-FILE FORMAT IS VIEW-CFNAME
               INDIC IS INDICS.
           ACCEPT IOFEEDBACK FROM I-O-FEEDBACK-AREA.
           MOVE ALL B"0" TO INDICS.
           IF DSPLY-STATUS NOT = "00"
               MOVE 3 TO VIEW-LASTKEY
           ELSE
           MOVE FUNCTION-NUM TO VIEW-LASTKEY.

       98A-SCREEN-READ.
           READ DISPLAY-FILE TERMINAL IS TERMINAL-ID
               INDIC IS INDICS
                  NO DATA MOVE DSPLY-STATUS TO DSPLY-STATUS.
           MOVE ALL B"0" TO INDICS.

       99-SCREEN-WRITE.
           WRITE DSPLY-REC FORMAT IS VIEW-CFNAME
               INDIC IS INDICS.
           MOVE ALL B"0" TO INDICS.

       COPY OVRPFCALL IN COPYLIB.
