000200 IDENTIFICATION DIVISION.
000300 PROGRAM-ID.    TLISTEQP.
000700*REMARKS.   THIS PROGRAM DISPLAYS THE EQUIPMENT
000800*       FILE.
      *C
      *C  09/11/1996    CA YODER
      *C    RE-COMPILED PROGRAM TO PICK UP CENTURY DATABASE CHANGES.
      *C
000900 ENVIRONMENT DIVISION.
001000 CONFIGURATION SECTION.
001100 SOURCE-COMPUTER.    AS400.
001200 OBJECT-COMPUTER.    AS400.
001300 INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT DISPLAY-FILE
               ASSIGN TO WORKSTATION-ZINQUIRY-SI
               ORGANIZATION IS TRANSACTION
               FILE STATUS IS DSPLY-STATUS
               CONTROL-AREA IS WS-CONTROL.
           SELECT EQUIPMENT-FILE
               ASSIGN TO DATABASE-MCFLMM0201
               ORGANIZATION IS INDEXED
               ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
               FILE STATUS IS EF-STATUS.
           SELECT WO-LAST-NUM-USED
               ASSIGN TO DATABASE-MCFPMM0800
               ORGANIZATION IS RELATIVE
               ACCESS MODE IS RANDOM
               RELATIVE KEY IS ACT-KEY
               FILE STATUS IS WLNU-STATUS.
001400 DATA DIVISION.
001500 FILE SECTION.
       FD  DISPLAY-FILE
           LABEL RECORDS ARE OMITTED.
       01  DSPLY-REC                   PIC X(1200).
001600 FD  EQUIPMENT-FILE
           LABEL RECORDS ARE STANDARD
           DATA RECORD IS EFREC.
       01  EFREC.
           COPY DDS-ALL-FORMATS OF MCFLMM0201.
       FD  WO-LAST-NUM-USED
           LABEL RECORDS ARE STANDARD
           DATA RECORD IS WLNUREC.
       01  WLNUREC.
           COPY DDS-ALL-FORMATS OF MCFPMM0800.
001700 WORKING-STORAGE SECTION.
002100 77  ACT-KEY                      PIC 9(9).
002400
       COPY CPYIND OF COPYLIB.

       COPY TDATESUB OF COPYLIB.

011000 01  DBPARAMETERS.       COPY DBPARMS OF COPYLIB.

011200 01  EQUIPMENT-DATA.     COPY MEQPFILE OF COPYLIB.

005800 01  ERROR-BUFFER.
005900     05  FILLER                   PIC X(32)
006000       VALUE "UNABLE TO FIND EQUIPMENT NUMBER ".
006100     05  EQUIP-1-10               PIC X(6) VALUE SPACES.
006200     05  FILLER                   PIC X(42) VALUE SPACES.
006300
       01  FILE-STATUSES.
           05  DSPLY-STATUS             PIC XX.
           05  EF-STATUS                PIC XX.
           05  WLNU-STATUS              PIC XX.

       01  INPUT-DATA.
           05  INPUT-EQUIP-NUM          PIC X(6).
           05  INPUT-CMD-LINE           PIC X(79).
           05  INPUT-MSG-LINE           PIC X(79).

011500 01  LAST-WO-BUFF.       COPY MLASTWO OF COPYLIB.
011700
       01  OUTPUT-DATA.
           05  OUTPUT-DATE         PIC X(8).
           05  OUTPUT-TIME.
               10  OUTPUT-HR       PIC XX.
               10  OUTPUT-COLON    PIC X.
               10  OUTPUT-MIN      PIC XX.
           05  OUTPUT-EQUIP-DATA   PIC X(146).
           05  OUTPUT-CMD-LINE     PIC X(79).
           05  OUTPUT-ERR-LINE     PIC X(79).

002500 01  PASSWORD-INFORMATION.
002600     05  NAME-OF-PROGRAM     PIC X(08) VALUE "TLISTEQP".
002700     05  PROGRAM-TYPE        PIC X(02) VALUE "IN".
002800     05  PROGRAM-RELEASE     PIC X(12) VALUE " E0100010001".
002900     05  PROGRAM-DESCRIPTION.
003000         10  PROG-DESC-A     PIC X(60) VALUE
003100             "EQUIPMENT FILE INQUIRY  "                          .
003200         10  PROG-DESC-B     PIC X(60) VALUE SPACES.
003400         10  PROG-FUNCTION   PIC X(60) VALUE SPACES.
003600     05  PASSWORD-FLAG       PIC X.
003700
       COPY DBSTAT OF COPYLIB.

010500 01  TMP-TIME-AREA.
010600     05  TTA-HRS                  PIC XX.
010700     05  TTA-MIN                  PIC XX.
010800     05  TTA-SEC                  PIC XX.
010900
       01  TRUE-VAL                     PIC 1 VALUE B"1".

       COPY VCOMAREA OF COPYLIB.

       COPY WSCONTROL OF COPYLIB.

011800 PROCEDURE DIVISION.
011900 BEGIN.
012000     PERFORM 1-HSK.
012100     PERFORM 6-MAIN THRU 6-MAIN-EXIT UNTIL VIEW-LASTKEY = 3.
012200
012300 2-EOJ.
           CLOSE DISPLAY-FILE.
           CLOSE EQUIPMENT-FILE.
           CLOSE WO-LAST-NUM-USED.
012700     GOBACK.
012800
012900****************************************************************
013000*    HOUSEKEEPING                                              *
013100****************************************************************
013200 1-HSK.
           OPEN I-O   DISPLAY-FILE.
           OPEN INPUT EQUIPMENT-FILE.
           OPEN INPUT WO-LAST-NUM-USED.
           MOVE 1 TO ACT-KEY.
           MOVE 0 TO COND-WORD.
           READ WO-LAST-NUM-USED INTO LAST-WO-BUFF
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF WLNU-STATUS NOT = "00" MOVE 17 TO COND-WORD.
           IF COND-WORD = 17 MOVE 1 TO DATE-FLAG-SW.
016200     MOVE DATE-FLAG-SW TO DATE-FLAG.
020000     CALL "TPWORD" USING PASSWORD-INFORMATION.
020400     IF PASSWORD-FLAG = "N" GO TO 2-EOJ.
           MOVE SPACES TO DSPLY-REC INPUT-DATA.

020700 6-MAIN.
020900     MOVE "FLISTEQ1" TO VIEW-CFNAME.
           MOVE INPUT-DATA TO DSPLY-REC.
           PERFORM 99-SCREEN-WRITE.
           PERFORM 98-SCREEN-READ.
           MOVE DSPLY-REC TO INPUT-DATA.
           IF VIEW-LASTKEY = 3 GO TO 6-MAIN-EXIT.
           MOVE 0 TO COND-WORD.
           MOVE INPUT-EQUIP-NUM TO EQPNUM OF EFREC.
           START EQUIPMENT-FILE KEY IS = EXTERNALLY-DESCRIBED-KEY
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF EF-STATUS NOT = "00" MOVE 17 TO COND-WORD.
027900     IF COND-WORD = 17
028100         MOVE INPUT-EQUIP-NUM TO EQUIP-1-10
028500         MOVE TRUE-VAL TO INDS (1) INDS (99)
               MOVE ERROR-BUFFER TO INPUT-MSG-LINE
               GO TO 6-MAIN.
           READ EQUIPMENT-FILE NEXT INTO EQUIPMENT-DATA
               AT END MOVE 15 TO COND-WORD.
           IF EF-STATUS NOT = "00" MOVE 15 TO COND-WORD.
028800     IF COND-WORD = 15
029000         MOVE INPUT-EQUIP-NUM TO EQUIP-1-10
               MOVE TRUE-VAL TO INDS (1) INDS (99)
               MOVE ERROR-BUFFER TO INPUT-MSG-LINE
029400         GO TO 6-MAIN.
           MOVE SPACES TO INPUT-DATA OUTPUT-DATA.
033100     MOVE "FLISTEQ2" TO VIEW-CFNAME.
034000     ACCEPT TMP-TIME-AREA FROM TIME.
           MOVE TTA-HRS TO OUTPUT-HR.
           MOVE ":" TO OUTPUT-COLON.
           MOVE TTA-MIN TO OUTPUT-MIN.
034100     MOVE 1 TO DATE-MODE.
034200     MOVE DATE-FLAG TO DATE-CODE.
034300     CALL "TDATECHK" USING DATE-CHECK-AREA.
034400     MOVE DATE-SLASH-OUT TO OUTPUT-DATE.
           MOVE EQUIPMENT-DATA TO OUTPUT-EQUIP-DATA.
           MOVE OUTPUT-DATA TO DSPLY-REC.
034700     PERFORM 99-SCREEN-WRITE.
034800     PERFORM 98-SCREEN-READ.
           MOVE DSPLY-REC TO OUTPUT-DATA.

       6-MAIN-EXIT.    EXIT.

       98-SCREEN-READ.
           READ DISPLAY-FILE INDIC IS INDICS
               MOVE FUNCTION-NUM TO VIEW-LASTKEY
               MOVE ALL B"0" TO INDICS.
       99-SCREEN-WRITE.
           WRITE DSPLY-REC FORMAT IS VIEW-CFNAME
               INDIC IS INDICS.

