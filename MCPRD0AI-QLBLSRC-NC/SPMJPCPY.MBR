       IDENTIFICATION DIVISION.
       PROGRAM-ID.             SPMJPCPY.
       AUTHOR.                 J S  BUNGO.
       INSTALLATION.           GOODYEAR TIRE & RUBBER CO.
       DATE-WRITTEN.           AUGUST 1, 1992
       DATE-COMPILED.
      *REMARKS.
      **************************************************************
      *D  SPMJPCPY  -  THIS PROGRAM WILL ALLOW A USER TO COPY A
      *D               A COMPLETE JOBPLAN TO A NEW JOBPLAN NAME.
      *
      *   THE JOBPLAN ITSELF IS COPIED IN PM-JOBPLAN AND THEN
      *   THE JOBPLAN KEYS IN PM-JOBPLAN-KEYS IS COPIED.
      **************************************************************
       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.
       SOURCE-COMPUTER.        HP-3000.
       OBJECT-COMPUTER.        HP-3000.

       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT PM-JOBPLAN
                  ASSIGN TO DATABASE-MCFLMM4101
                  ORGANIZATION IS INDEXED
                  ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                  WITH DUPLICATES
                  FILE STATUS IS FILE-STAT.
           SELECT PM-JOBPLAN-KEYS
                  ASSIGN TO DATABASE-MCFLMM4002
                  ORGANIZATION IS INDEXED
                  ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                  WITH DUPLICATES
                  FILE STATUS IS FILE-STAT.
           SELECT PM-JOBPLAN-2
                  ASSIGN TO DATABASE-MCFLMM4101
                  ORGANIZATION IS INDEXED
                  ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                  WITH DUPLICATES
                  FILE STATUS IS FILE-STAT.
           SELECT PM-JOBPLAN-KEYS-2
                  ASSIGN TO DATABASE-MCFLMM4002
                  ORGANIZATION IS INDEXED
                  ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                  WITH DUPLICATES
                  FILE STATUS IS FILE-STAT.

       DATA DIVISION.
       FILE SECTION.
       FD  PM-JOBPLAN
           LABEL RECORDS ARE STANDARD.
       01  PM-JOBPLAN-REC.
           COPY DDS-ALL-FORMATS OF MCFLMM4101.
       FD  PM-JOBPLAN-KEYS
           LABEL RECORDS ARE STANDARD.
       01  PM-JOBPLAN-KEYS-REC.
           COPY DDS-ALL-FORMATS OF MCFLMM4002.
       FD  PM-JOBPLAN-2
           LABEL RECORDS ARE STANDARD.
       01  PM-JOBPLAN-REC-2.
           COPY DDS-ALL-FORMATS OF MCFLMM4101.
       FD  PM-JOBPLAN-KEYS-2
           LABEL RECORDS ARE STANDARD.
       01  PM-JOBP-KEYS-REC-2.
           COPY DDS-ALL-FORMATS OF MCFLMM4002.

       WORKING-STORAGE SECTION.
       01  BASE                PIC X(16).
       01  FILE-STAT           PIC X(02).
       01  CURRENT-TASK        PIC X(4).

       01  PASSWORD-INFORMATION.
           05  NAME-OF-PROGRAM     PIC X(08) VALUE "SPMJPCPY".
           05  PROGRAM-TYPE        PIC X(02) VALUE "UP".
           05  PROGRAM-RELEASE     PIC X(12) VALUE " J0100010001".
           05  PROGRAM-DESCRIPTION.
               10  PROG-DESC-A1    PIC X(30) VALUE
                   "MASTER JOBPLAN COMPLETE COPY  ".
               10  PROG-DESC-A2    PIC X(30) VALUE SPACES.
               10  PROG-DESC-B1    PIC X(30) VALUE SPACES.
               10  PROG-DESC-B2    PIC X(30) VALUE SPACES.
               10  PROG-FUNCTION1  PIC X(30) VALUE
                   "RUNS FROM PROGRAM XPMMAINT.   ".
               10  PROG-FUNCTION2  PIC X(30) VALUE
                   "                              ".
           05  PASSWORD-FLAG       PIC X.

       01  DB-ERROR.
           05  DB-TYPE   PIC X(08) VALUE SPACES.
           05  DB-FILE   PIC X(18) VALUE SPACES.
           05  FILLER    PIC X(21) VALUE " ERROR - COND-WORD = ".
           05  CON-WORD  PIC -9999.

           COPY TBLOWUP        IN COPYLIB.
           COPY CATREAD        IN COPYLIB.
           COPY DBSTAT         IN COPYLIB.
       01  MESSAGE-DATA.       COPY ERRORLIN IN COPYLIB.
       01  PM-JOBPLAN-DATA.    COPY DPMJBPLN IN COPYLIB.
       01  PM-JOBP-KEYS-DATA.  COPY DPMJBKEY IN COPYLIB.

       LINKAGE SECTION.
       01  DBPARAMETERS.       COPY DBPARMS  IN COPYLIB.
       01  RETURN-MSG.
           05  E1              PIC X(78).
           05  E5              PIC S9(4).
           COPY VCOMLINK       IN COPYLIB.
           COPY LANGSUB        IN COPYLIB.
       01  COPY-FROM-NAME      PIC X(10).
       01  COPY-TO-NAME        PIC X(10).
       01  ORIGINATOR-CC       PIC X(04).
       01  JP-TITLE-BUF        PIC X(50).

       PROCEDURE DIVISION USING DBPARAMETERS
                                RETURN-MSG
                                VIEW-COMAREA
                                LANGUAGE-PARMS
                                COPY-FROM-NAME
                                COPY-TO-NAME
                                ORIGINATOR-CC
                                JP-TITLE-BUF.
       BEGIN.
           MOVE "MMISA;" TO BASE.
           MOVE SPACES TO E1.
           MOVE ZEROS  TO E5.
           MOVE SPACES TO CURRENT-TASK.
           MOVE LOW-VALUES     TO STATUS-AREA.
      *----OPEN ALL DATABASE FILES
           OPEN INPUT PM-JOBPLAN
                      PM-JOBPLAN-KEYS.
           OPEN I-O   PM-JOBPLAN-2
                      PM-JOBPLAN-KEYS-2.

           PERFORM COPY-PM-JOBPLAN THRU COPY-PM-JOBPLAN-EXIT.
           PERFORM COPY-PMJP-KEYS THRU COPY-PMJP-KEYS-EXIT.

       END-OF-JOB.
           GOBACK.

       COPY-PM-JOBPLAN.
           MOVE SPACES         TO PM-JOBPLAN-DATA.
           MOVE COPY-FROM-NAME TO PMJOBPKEY OF PM-JOBPLAN.
           START PM-JOBPLAN KEY = PMJOBPKEY OF PM-JOBPLAN
               INVALID KEY MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
      ******************************************************************
      *M    MESSAGE 036/008:
      *M  JOBPLAN DOES NOT EXIST
      ******************************************************************
               MOVE 36   TO CATREAD-MSG-SET
               MOVE 08   TO CATREAD-MSG-NUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE CATREAD-MSG-TEXT TO E1
               MOVE 5 TO E5
               GO TO END-OF-JOB.

           PERFORM READ-LOOP THRU READ-LOOP-EXIT
               UNTIL FILE-STAT NOT = "00".
       COPY-PM-JOBPLAN-EXIT.
           EXIT.

       READ-LOOP.
           READ PM-JOBPLAN NEXT INTO PM-JOBPLAN-DATA
               AT END MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT = "10" OR "14" OR "46"
               GO TO READ-LOOP-EXIT
           ELSE
           IF FILE-STAT NOT = "00"
               MOVE FILE-STAT  TO CON-WORD COND-WORD
               MOVE "DBGET   " TO DB-TYPE
               MOVE "PM-JOBPLAN" TO DB-FILE
               MOVE DB-ERROR   TO E1
               MOVE 5 TO E5
               GO TO END-OF-JOB.
           IF JOBPLAN-KEY NOT = COPY-FROM-NAME
               MOVE "10" TO FILE-STAT
               GO TO READ-LOOP-EXIT.

           MOVE COPY-TO-NAME TO JOBPLAN-KEY  PMJP-KEY.
           PERFORM WRITE-COPY THRU WRITE-COPY-EXIT.
       READ-LOOP-EXIT.
           EXIT.

       WRITE-COPY.
           WRITE PM-JOBPLAN-REC-2 FROM PM-JOBPLAN-DATA
               INVALID KEY MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
               MOVE FILE-STAT TO CON-WORD COND-WORD
               MOVE COPY-TO-NAME TO BU-DISPLAY-FLD (2)
               MOVE PMJP-SEQ-LINE TO BU-DISPLAY-FLD (3)
               MOVE "DBPUT ERR - WRITE-COPY" TO BU-DISPLAY-MSG
               PERFORM 999-BLOWUP.

           MOVE SPACES TO PM-JOBPLAN-DATA.
       WRITE-COPY-EXIT.
           EXIT.

       COPY-PMJP-KEYS.
           MOVE COPY-FROM-NAME TO PMJOBPKEY OF PM-JOBPLAN-KEYS.
           START PM-JOBPLAN-KEYS KEY = PMJOBPKEY OF PM-JOBPLAN-KEYS
               INVALID KEY MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
               MOVE FILE-STAT  TO CON-WORD COND-WORD
               MOVE "DBFIND  " TO DB-TYPE
               MOVE "PM-JOBP-KEYS" TO DB-FILE
               MOVE DB-ERROR   TO E1
               MOVE 5 TO E5
               GO TO END-OF-JOB.
       COPY-PMJP-LOOP.
           READ PM-JOBPLAN-KEYS NEXT INTO PM-JOBP-KEYS-DATA
               AT END MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT = "10" OR "14" OR "46"
      ******************************************************************
      *M    MESSAGE 036/017:
      *M  JOBPLAN HAS BEEN COPED SUCCESSFULLY
      ******************************************************************
               MOVE 36   TO CATREAD-MSG-SET
               MOVE 17   TO CATREAD-MSG-NUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE CATREAD-MSG-TEXT TO E1
               MOVE 6 TO E5
               GO TO COPY-PMJP-KEYS-EXIT
           ELSE
           IF FILE-STAT NOT = "00"
               MOVE FILE-STAT  TO CON-WORD COND-WORD
               MOVE "DBGET   " TO DB-TYPE
               MOVE "PM-JOBP-KEYS" TO DB-FILE
               MOVE DB-ERROR   TO E1
               MOVE 5 TO E5
               GO TO END-OF-JOB.
           IF PMJPK-JOBP-KEY NOT = COPY-FROM-NAME
               MOVE "10" TO FILE-STAT
      ******************************************************************
      *M    MESSAGE 036/017:
      *M  JOBPLAN HAS BEEN COPED SUCCESSFULLY
      ******************************************************************
               MOVE 36   TO CATREAD-MSG-SET
               MOVE 17   TO CATREAD-MSG-NUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE CATREAD-MSG-TEXT TO E1
               MOVE 6 TO E5
               GO TO COPY-PMJP-KEYS-EXIT.

               MOVE COPY-TO-NAME TO PMJPK-JOBP-KEY  PMJPK-JOBP-NAME.
               MOVE ORIGINATOR-CC TO PMJPK-ORIGINATOR.
               ACCEPT PMJPK-DATE-STAMP FROM DATE.
               ACCEPT PMJPK-TIME-STAMP FROM TIME.
               IF RECORD-KEY = "KEYREC"
                   MOVE JP-TITLE-BUF TO PMJPK-KEY-TITLE.
               PERFORM WRITE-JOBPLAN-KEYS THRU WRITE-JOBPLAN-KEYS-EXIT.
               GO TO COPY-PMJP-LOOP.
       COPY-PMJP-KEYS-EXIT.
           EXIT.

       WRITE-JOBPLAN-KEYS.
           WRITE PM-JOBP-KEYS-REC-2 FROM PM-JOBP-KEYS-DATA
                INVALID KEY MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
               MOVE FILE-STAT TO CON-WORD COND-WORD
               MOVE COPY-TO-NAME TO BU-DISPLAY-FLD (2)
               MOVE PMJP-SEQ-LINE TO BU-DISPLAY-FLD (3)
               MOVE "DBPUT ERR - WRITE-COPY" TO BU-DISPLAY-MSG
               PERFORM 999-BLOWUP.
       WRITE-JOBPLAN-KEYS-EXIT.
           EXIT.

       999-CATREAD.
           MOVE SPACES TO CATREAD-MSG-TEXT.
           CALL "CCATREAD" USING CATREAD-PARMS.
           IF CATREAD-MSG-NOT-FOUND
                MOVE "ERROR ON THIS FIELD, NO MSG FOUND"
                   TO CATREAD-MSG-TEXT.
       999-CATREAD-EXIT.
           EXIT.

       999-BLOWUP.
           MOVE "SPMJPCPY" TO BU-PGM-NAME.
           MOVE VIEW-NFNAME TO BU-DISPLAY-FLD (1).
           CALL "TBLOWUP" USING BASE, BU-PGM-NAME, STATUS-AREA,
                                VIEW-COMAREA, COND-WORD,
                                BU-DISPLAY-MSG, BU-DISPLAY-FLDS.
      *******************>>>  END OF FILE  <<<*********************
