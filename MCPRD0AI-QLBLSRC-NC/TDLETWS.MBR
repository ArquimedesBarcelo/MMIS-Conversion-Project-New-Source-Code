001100 IDENTIFICATION DIVISION.
001200 PROGRAM-ID.          TDLETWS.
001300 AUTHOR.              ANDREW T LEPERA.
001400 DATE-WRITTEN.        FEB 18,1979.
001500 DATE-COMPILED.
001600*INSTALLATION.        GOODYEAR TIRE AND RUBBER - AKRON.
001700*SECURITY.
001800*REMARKS.
      *C
      *C 06/12/96   JEFF BUNGO
      *C    EXPAND DATE FIELDS FOR YEAR 2000 COMPLIANCE.
      *C    INCLUDE CENTURY ON THE DELETION DATE.
      *
001900 ENVIRONMENT DIVISION.
002000 CONFIGURATION SECTION.
002100 SOURCE-COMPUTER.  HP-3000.
002200 OBJECT-COMPUTER.  HP-3000.
       COPY SPECIALN IN COPYLIB.
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT MWRKLIST-WK-O
               ASSIGN TO DATABASE-MCFLCS0301
               ORGANIZATION IS INDEXED
                 ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
               FILE STATUS IS FILE-STATUS.

           SELECT DWLITEM-WK-O
               ASSIGN TO DATABASE-MCFLCS1501
               ORGANIZATION IS INDEXED
                 ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                 WITH DUPLICATES
               FILE STATUS IS FILE-STATUS.

           SELECT DDESC-CD-I
               ASSIGN TO DATABASE-MCFLCS1401
               ORGANIZATION IS INDEXED
                 ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                 WITH DUPLICATES
               FILE STATUS IS FILE-STATUS.

           SELECT PRINT-FILE ASSIGN TO PRINTER-MCPRT.
002500
003000 DATA DIVISION.
003100 FILE SECTION.
003300 FD  PRINT-FILE
003400     LABEL RECORDS ARE OMITTED
003500     RECORD CONTAINS 132 CHARACTERS
003600     DATA RECORD IS PRINT-REC.
003700 01  PRINT-REC               PIC X(132).
003900
       FD  MWRKLIST-WK-O
           LABEL RECORDS ARE STANDARD.
       01  MWRKLIST-WK-REC-O.
           COPY DDS-MCRPCS0300  OF MCFLCS0301.

       FD  DWLITEM-WK-O
           LABEL RECORDS ARE STANDARD.
       01  DWLITEM-WK-REC-O.
           COPY DDS-MCRPCS1500  OF MCFLCS1501.

       FD  DDESC-CD-I
           LABEL RECORDS ARE STANDARD.
       01  DDESC-CD-REC-I.
           COPY DDS-MCRPCS1400  OF MCFLCS1401.

004000 WORKING-STORAGE SECTION.
004100
004200 77  BASE                       PIC X(10)  VALUE "  STORES;".
004300 77  PASSWORD                   PIC X(5)   VALUE "JADE;".
004500 77  WL-TOT-QTY                 PIC 9(8)   VALUE ZEROS.
004600
004700*****ARGUMENT VALUES*****
004800 77  CODE-ARG                   PIC X(8)   VALUE SPACES.
004900 77  WL-ARG                     PIC X(6)   VALUE SPACES.
005000
005100 77  LINE-ADV                   PIC 99     VALUE ZEROS.

       01  DLET-DATE-CN.
           05  DLET-DATE-CC           PIC X(2).
           05  DLET-DATE.
               10  DLET-DATE-YY       PIC X(2).
               10  FILLER             PIC X(4).

       01  MCXCBLERR-SCOPE            PIC X      VALUE "C".
005200
       COPY TDATECHK IN COPYLIB.
       COPY TBLOWUP IN COPYLIB.

       01  GREGDATE.
           05  GREGDATE-CC   PIC X(2).
           05  GREGDATE-YMD.
               10  GREGDATE-YY PIC X(2).
               10  FILLER      PIC X(4).
       01  JULDATE.
           05  JULYEAR       PIC 9(4).
           05  JULDAY        PIC 9(3).
       01  DAYDIGIT          PIC X.
       01  LEAPYEAR          PIC X.

006000 01  ITEM-LISTINGS.
006100     05  ALL-ITEMS              PIC XX     VALUE "@;".
006200     05  CODE-SEARCH            PIC X(10)  VALUE "CORP-CODE;".
006300     05  WL-SEARCH              PIC X(7)   VALUE "WL-KEY;".
006400
       01  FILE-STATUS.
           05  FILE-STATUS-1            PIC X  VALUE "0".
           05  FILE-STATUS-2            PIC X  VALUE "0".

007100 01  DSET-NAMES.
007200     05  DSET-NAME              PIC X(16)  VALUE SPACES.
007300     05  DSET-DESC              PIC X(16)  VALUE "DDESC;".
007400     05  DSET-MWRKLIST          PIC X(16)  VALUE "MWRKLIST;".
007500     05  DSET-DWLITEM           PIC X(16)  VALUE "DWLITEM;".
007600
007700********************
007800*                  *
007900*   MODE  VALUES   *
008000*                  *
008100********************
008200
008300 01  MODE-AREA.
008400     05  MODE1                  PIC S9(4)   COMP       VALUE 1.
008500     05  MODE2                  PIC S9(4)   COMP       VALUE 2.
008600     05  MODE3                  PIC S9(4)   COMP       VALUE 3.
008700     05  MODE5                  PIC S9(4)   COMP       VALUE 5.
008800
008900*********************************
009000*                               *
009100*  BELOW ARE THE BUFFER AREAS   *
009200*    SET UP FOR EACH DATASET IN *
009300*    THE DATABASE - STORES      *
009400*                               *
009500*********************************
       COPY MWRKLIST IN COPYLIB.
009900
010000 01  BUF-DDESC.
010100     05  DESC-CORP-CODE         PIC X(8).
010200     05  DESC-ID-NUM            PIC XX.
010300     05  DESC-DATA              PIC X(80).
010400
010500 01  BUF-DWLITEM.
010600     05  WL-KEY                 PIC X(6).
010700     05  WL-RCD-DATA.
010800         10  WL-CODE            PIC X(8).
010900         10  WL-CHARGE          PIC X(6).
011000         10  WL-WRKORDER        PIC X(12).
011100         10  WL-EMP-ID          PIC X(4).
011200         10  WL-UM              PIC XX.
011300         10  WL-BINDATA OCCURS 6 TIMES.
011400             15  WL-BIN-LOC     PIC X(12).
011500             15  WL-BIN-QTY     PIC 9(8).
011600         10  WL-REQ-DEPT        PIC X(4).
011700         10  WL-REQ-DEPT        PIC X(6).
011800
011900 01  WS-WL-KEY.
012000     05  WS-WL-LIT              PIC XX     VALUE SPACES.
012100     05  WS-WL-NO               PIC 9(4)   VALUE ZEROS.
012200
       COPY DBSTAT IN COPYLIB.

015600*****************
015700*               *
015800* H E A D E R S *
015900*               *
016000*****************
016100
016200 01  HDR-1.
016300     05  FILLER    PIC X(34)  VALUE SPACES.
016400     05  FILLER    PIC X(20)  VALUE "S T O R E R O O M   ".
016500     05  FILLER    PIC X(18)  VALUE "W O R K  S H E E T".
016600     05  FILLER    PIC X(16)  VALUE "   D E L E T E S".
016700     05  FILLER    PIC X(19)  VALUE SPACES.
016800     05  FILLER    PIC X(5)   VALUE "DATE ".
016900     05  PRT-DATE  PIC X(8).
017500     05  FILLER    PIC XX     VALUE SPACES.
017600     05  PRT-TIME  PIC X(8).
018200     05  FILLER    PIC XXX    VALUE SPACES.
018300 01  HDR-2.
018400     05  PRT-RET-ISS PIC X(6) VALUE SPACES.
018500     05  FILLER    PIC X(18)  VALUE " WORK SHEET NO. : ".
018600     05  PRT-WS-NO PIC X(4)   VALUE SPACES.
018700     05  FILLER    PIC X(10)  VALUE " PREPARED ".
018800     05  PRT-WS-DATE PIC X(8).
019400     05  FILLER    PIC X(50)  VALUE SPACES.
019500
019600 01  HDR-3.
019700     05  PRT-CODE  PIC X(9)   VALUE SPACES.
019800     05  PRT-DESC1 PIC X(71)  VALUE SPACES.
019900 01  HDR-3A.
020000     05  PRT-DESC2 PIC X(80)  VALUE SPACES.
020100 01  HDR-4.
020200     05  FILLER    PIC XX     VALUE SPACES.
020300     05  FILLER    PIC X(21)  VALUE "LOCATION     QUANTITY".
020400     05  FILLER    PIC X(6)   VALUE SPACES.
020500     05  FILLER    PIC X(21)  VALUE "LOCATION     QUANTITY".
020600     05  FILLER    PIC X(6)   VALUE SPACES.
020700     05  FILLER    PIC X(21)  VALUE "LOCATION     QUANTITY".
020800 01  HDR-5.
020900     05  PRT-FLDS OCCURS 3 TIMES.
021000        10 PRT-LOC PIC X(12).
021100        10 FILLER  PIC XX.
021200        10 PRT-QTY PIC Z(8).
021300        10 FILLER  PIC X.
021400        10 PRT-UM  PIC XX.
021500        10 FILLER  PIC XX.
021600 01  HDR-6.
021700     05  FILLER    PIC X(14)  VALUE "    TOTAL QTY-".
021800     05  PRT-T-QTY PIC Z(7)9  VALUE ZEROS.
021900     05  FILLER    PIC X(14)  VALUE "  CHARGED TO: ".
022000     05  PRT-CHG   PIC X(6)   VALUE SPACES.
022100     05  FILLER    PIC X(12)  VALUE "  EMPLOYEE: ".
022200     05  PRT-EMP   PIC X(4)   VALUE SPACES.
022300     05  FILLER    PIC X(5)   VALUE SPACES.
022400     05 PRT-WO-LIT PIC X(15)  VALUE SPACES.
022500     05  PRT-WO    PIC X(12)  VALUE SPACES.
022600     05  FILLER    PIC X(6)   VALUE SPACES.
022700
022800 01  WO-LIT.
022900     05  FILLER    PIC X(15)  VALUE "WORK ORDER NO. ".
023000
023100 PROCEDURE DIVISION.
023200 1-HOUSEKEEPING.
           MOVE "C" TO MCXCBLERR-SCOPE.
           CALL "MCXCBLERR" USING MCXCBLERR-SCOPE.
           PERFORM 9999-OPEN-STUFF.
027000     OPEN OUTPUT PRINT-FILE.
033900     WRITE PRINT-REC FROM HDR-1 AFTER ADVANCING 2.
034000
           CALL "TDATECHK" USING DATE-CHECK-AREA.
           MOVE DATE-YMD-OUT TO PRT-DATE.
           MOVE DATE-FORMATTED-TIME-OUT TO PRT-TIME.
           MOVE DATE-YMD-OUT TO GREGDATE-YMD.
           IF GREGDATE-YY > "70"
               MOVE "19" TO GREGDATE-CC
           ELSE
               MOVE "20" TO GREGDATE-CC.
           MOVE SPACES TO JULDATE.
           CALL "JULGREG" USING GREGDATE JULDATE DAYDIGIT LEAPYEAR.
025000     IF JULDAY < 3
025100         MOVE 365                TO   JULDAY
               SUBTRACT 1 FROM JULYEAR
025300     ELSE
025400         SUBTRACT 2              FROM JULDAY.
           MOVE SPACES TO GREGDATE.
           CALL "JULGREG" USING GREGDATE JULDATE DAYDIGIT LEAPYEAR.
           MOVE GREGDATE TO DLET-DATE-CN.
026500
027100     PERFORM 6-MAIN              THRU 6-MAIN-X.
           PERFORM 9999-CLOSE-STUFF.
027200     CLOSE PRINT-FILE.
027700     GOBACK.
027800
049800 2100-BLOWUP.
050000     MOVE "TIRSNGL"                TO   BU-PGM-NAME.
050100     MOVE WL-ARG                   TO   BU-DISPLAY-FLD (1).
050200     MOVE CODE-ARG                 TO   BU-DISPLAY-FLD (2).
050300     CALL "TBLOWUP" USING BASE BU-PGM-NAME STATUS-AREA
050400       DUMMY-VIEW-AREA FILE-STATUS BU-DISPLAY-MSG
050500       BU-DISPLAY-FLDS.
050600
032200 6-MAIN.
032300     PERFORM 9999-DBGET2-MWRKLIST-WK-O.
032500     IF COND-WORD = 11
032600         GO TO 6-MAIN-X.
032900
033000     IF WRKLIST-DATE-CN > DLET-DATE-CN
033100         GO TO 6-MAIN.
033200     IF WRKLIST-KEY = "ST0000" OR "SW0000" OR "IV0000"
033300         GO TO 6-MAIN.
033400
034100     MOVE WRKLIST-KEY            TO   WS-WL-KEY.
034200     IF WS-WL-LIT = "SW"
034300         MOVE " ISSUE"           TO   PRT-RET-ISS
034400       ELSE
034500     IF WS-WL-LIT = "ST"
034600         MOVE "RETURN"           TO   PRT-RET-ISS
034700       ELSE
034800         GO TO 6-MAIN.
034900
035000     MOVE WS-WL-NO               TO   PRT-WS-NO.
           MOVE 4 TO DATE-MODE.
           MOVE WRKLIST-DATE TO DATE-VALIDATE-IN.
           CALL "TDATECHK" USING DATE-CHECK-AREA.
           MOVE DATE-SLASH-OUT         TO  PRT-WS-DATE.
           WRITE PRINT-REC FROM HDR-2 AFTER ADVANCING 2.
035800
035900     MOVE WRKLIST-KEY            TO   WL-ARG.
036000     PERFORM 9999-DBFIND-DWLITEM-WK-O.
036300
036400 61-PRT-RTN.
036500     PERFORM 9999-DBGET5-DWLITEM-WK-O.
036800     IF COND-WORD = 15
036900         MOVE "MWRKLIST;" TO DSET-NAME
037000         PERFORM 9930-LOCK
               PERFORM 9999-DBDELETE-MWRKLIST-WK-O
               PERFORM 9940-UNLOCK
037100         GO TO 6-MAIN.
037400
037500*******************************************************
037600*                                                     *
037700*  HERE EXP WORKSHEET GOES TO PRINT AREA FOR HARDCOPY *
037800*                                                     *
037900*******************************************************
038000
038100     MOVE WL-CODE                TO   PRT-CODE.
038200     MOVE WL-CODE                TO   CODE-ARG.
038300     PERFORM 9999-DBFIND-DDESC-CD-I.
038400     IF NOT GOOD-CALL
038500         MOVE "* NO DESCRIPTION ON FILE *" TO PRT-DESC1
038600         MOVE SPACES             TO   PRT-DESC2
038700         GO TO 61-CONT.
038800     PERFORM 9999-DBGET5-DDESC-CD-I.
038900     IF NOT GOOD-CALL
039000         MOVE "* NO DESCRIPTION ON FILE *" TO PRT-DESC1
039100         MOVE SPACES             TO   PRT-DESC2
039200         GO TO 61-CONT.
039300     MOVE DESC-DATA              TO   PRT-DESC1.
039400     PERFORM 9999-DBGET5-DDESC-CD-I.
039500     IF NOT GOOD-CALL
039600         MOVE SPACES             TO   PRT-DESC2
039700     ELSE
039800         MOVE DESC-DATA          TO   PRT-DESC2.
039900
040000 61-CONT.
           WRITE PRINT-REC FROM HDR-3 AFTER ADVANCING 1.
           WRITE PRINT-REC FROM HDR-3A AFTER ADVANCING 2.
           WRITE PRINT-REC FROM HDR-4 AFTER ADVANCING 1.
040700
041200     MOVE WL-BIN-LOC (1)         TO   PRT-LOC (1).
041300     MOVE WL-BIN-QTY (1)         TO   PRT-QTY (1).
041400     MOVE WL-UM                  TO   PRT-UM (1).
041500     MOVE WL-BIN-LOC (2)         TO   PRT-LOC (2).
041600     MOVE WL-BIN-QTY (2)         TO   PRT-QTY (2).
041700     MOVE WL-UM                  TO   PRT-UM (2).
041800     MOVE WL-BIN-LOC (3)         TO   PRT-LOC (3).
041900     MOVE WL-BIN-QTY (3)         TO   PRT-QTY (3).
042000     MOVE WL-UM                  TO   PRT-UM (3).
           WRITE PRINT-REC FROM HDR-5 AFTER ADVANCING 1.
042400
042500     MOVE WL-BIN-LOC (4)         TO   PRT-LOC (1).
042600     MOVE WL-BIN-QTY (4)         TO   PRT-QTY (1).
042700     MOVE WL-UM                  TO   PRT-UM (1).
042800     MOVE WL-BIN-LOC (5)         TO   PRT-LOC (2).
042900     MOVE WL-BIN-QTY (5)         TO   PRT-QTY (2).
043000     MOVE WL-UM                  TO   PRT-UM (2).
043100     MOVE WL-BIN-LOC (6)         TO   PRT-LOC (3).
043200     MOVE WL-BIN-QTY (6)         TO   PRT-QTY (3).
043300     MOVE WL-UM                  TO   PRT-UM (3).
           WRITE PRINT-REC FROM HDR-5 AFTER ADVANCING 2.
043700
043800     ADD WL-BIN-QTY (1), WL-BIN-QTY (2), WL-BIN-QTY (3)
043900         WL-BIN-QTY (4), WL-BIN-QTY (5), WL-BIN-QTY (6)
044000     GIVING WL-TOT-QTY.
044100     MOVE WL-TOT-QTY             TO   PRT-T-QTY.
044200     MOVE WL-CHARGE              TO   PRT-CHG.
044300     MOVE WL-EMP-ID              TO   PRT-EMP.
044400     IF PRT-RET-ISS = " ISSUE"
044500         MOVE WO-LIT             TO   PRT-WO-LIT
044600         MOVE WL-WRKORDER        TO   PRT-WO
044700       ELSE
044800     IF PRT-RET-ISS = "RETURN"
044900         MOVE SPACES             TO   PRT-WO-LIT
045000                                      PRT-WO.
           WRITE PRINT-REC FROM HDR-6 AFTER ADVANCING 3.
045400
045500     MOVE "DWLITEM;"             TO   DSET-NAME.
           PERFORM 9930-LOCK.
           PERFORM 9999-DBDELETE-DWLITEM-WK-O.
           PERFORM 9940-UNLOCK.
045700     GO TO 61-PRT-RTN.
045800
046800 6-MAIN-X.
046900     EXIT.

       9930-LOCK.
       9940-UNLOCK.
       9999-DBGET2-MWRKLIST-WK-O.
           MOVE 0 TO COND-WORD.
           READ MWRKLIST-WK-O NEXT INTO BUF-MWRKLIST
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS-1 = "1" OR FILE-STATUS = "46"
               MOVE 11 TO COND-WORD
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE "DBGET2 ERR 9999-DBGET2-MWRKLIST-WK-O"
                   TO BU-MSG-AREA
               MOVE 99 TO COND-WORD
               PERFORM 2100-BLOWUP.

       9999-INIT-MWRKLIST-WK-O.
           MOVE SPACES TO WLKEY OF MWRKLIST-WK-REC-O.
           START MWRKLIST-WK-O KEY >= WLKEY OF MWRKLIST-WK-REC-O
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.

       9999-DBFIND-DWLITEM-WK-O.
           MOVE 0 TO COND-WORD.
           MOVE WL-ARG TO WLKEY OF DWLITEM-WK-REC-O.
           START DWLITEM-WK-O KEY = WLKEY OF DWLITEM-WK-REC-O
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF (FILE-STATUS NOT = "00") AND (FILE-STATUS-1 NOT = "2")
               MOVE "DBFIND ERR 9999-DBFIND-DWLITEM-WK-O"
                   TO BU-MSG-AREA
               MOVE 99 TO COND-WORD
               PERFORM 2100-BLOWUP.

       9999-DBGET5-DWLITEM-WK-O.
           MOVE 0 TO COND-WORD.
           READ DWLITEM-WK-O NEXT INTO BUF-DWLITEM
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14"
                   PERFORM 9999-RESET-DWLITEM-WK-O
                   MOVE 15 TO COND-WORD
               ELSE
               IF FILE-STATUS = "46"
                   MOVE 15 TO COND-WORD
               ELSE
                   MOVE "DBGET5 ERR 9999-DBGET5-DWLITEM-WK-O"
                       TO BU-MSG-AREA
                   MOVE 99 TO COND-WORD
                   PERFORM 2100-BLOWUP
           ELSE
           IF WLKEY OF DWLITEM-WK-REC-O NOT = WL-ARG
               PERFORM 9999-RESET-DWLITEM-WK-O
               MOVE 15 TO COND-WORD.

       9999-RESET-DWLITEM-WK-O.
           MOVE HIGH-VALUES TO WLKEY OF DWLITEM-WK-REC-O.
           START DWLITEM-WK-O KEY > WLKEY OF DWLITEM-WK-REC-O
               INVALID KEY MOVE "00" TO FILE-STATUS.

       9999-DBFIND-DDESC-CD-I.
           MOVE 0 TO COND-WORD.
           MOVE CODE-ARG TO CORPCDE OF DDESC-CD-REC-I.
           START DDESC-CD-I KEY = CORPCDE OF DDESC-CD-REC-I
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF (FILE-STATUS NOT = "00") AND (FILE-STATUS-1 NOT = "2")
               MOVE "DBFIND ERR 9999-DBFIND-DDESC-CD-I"
                   TO BU-MSG-AREA
               MOVE 99 TO COND-WORD
               PERFORM 2100-BLOWUP.

       9999-DBGET5-DDESC-CD-I.
           MOVE 0 TO COND-WORD.
           READ DDESC-CD-I NEXT INTO BUF-DDESC
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   MOVE 15 TO COND-WORD
               ELSE
                   MOVE "DBGET5 ERR 9999-DBGET5-DDESC-CD-I"
                       TO BU-MSG-AREA
                   MOVE 99 TO COND-WORD
                   PERFORM 2100-BLOWUP
           ELSE
           IF CORPCDE OF DDESC-CD-REC-I NOT = CODE-ARG
               MOVE 15 TO COND-WORD.

       9999-DBDELETE-MWRKLIST-WK-O.
           MOVE 0 TO COND-WORD.
           DELETE MWRKLIST-WK-O
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE "DBDELETE ERR 9999-DBDELETE-MWRKLIST-WK-O"
                   TO BU-MSG-AREA
               MOVE 99 TO COND-WORD
               PERFORM 2100-BLOWUP.

       9999-DBDELETE-DWLITEM-WK-O.
           MOVE 0 TO COND-WORD.
           DELETE DWLITEM-WK-O
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE "DBDELETE ERR 9999-DBDELETE-DWLITEM-WK-O"
                   TO BU-MSG-AREA
               MOVE 99 TO COND-WORD
               PERFORM 2100-BLOWUP.

       9999-OPEN-STUFF.
           OPEN INPUT DDESC-CD-I                                 .
           OPEN I-O   MWRKLIST-WK-O         DWLITEM-WK-O         .

       9999-CLOSE-STUFF.
           CLOSE      MWRKLIST-WK-O         DWLITEM-WK-O
                      DDESC-CD-I                                 .
