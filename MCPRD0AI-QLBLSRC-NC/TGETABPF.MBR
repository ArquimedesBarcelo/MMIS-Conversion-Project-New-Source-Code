       IDENTIFICATION DIVISION.

       PROGRAM-ID.     TGETABPF.
       AUTHOR.         EXLTECH, LLC - DAN RAUCH

      *****************************************************************
      **     ARIBA CATALOG OVERRIDE MAINTENANCE - FILE MCFPAB2600
      **   ----------------------------------------------------------
      **  THIS PROGRAM ONLY MAINTAINS CATALOG ITEM OVERRIDES !! THERE
      **  ARE NO EXCEPTION RECORDS WRITTEN HERE  - EXCEPTION RECS ARE
      **  WRITTEN DURING CATALOG ITEM SELECTION(PGM SGETABPF) WHEN AN
      **  ITEM OTHER THAN THE PREFERRED CATALOG ITEM IS SELECTED.
      **  WHEN AN OVERRIDE ITEM IS SELECTED, THE EXCEPTION REC IS AUTO
      **  GENERATED USING THE OVERRIDE REASON CODE ESTABLISHED HERE.
      *****************************************************************

      *================================================================
       ENVIRONMENT DIVISION.
      *===============================================================
       CONFIGURATION SECTION.

       SOURCE-COMPUTER.       IBM-AS400.
       OBJECT-COMPUTER.       IBM-AS400.
       SPECIAL-NAMES.         LOCAL-DATA LDA.

       INPUT-OUTPUT SECTION.
       FILE-CONTROL.

           SELECT DISPLAY-FILE  ASSIGN TO WORKSTATION-ZGETABPF2-SI
                  ORGANIZATION IS TRANSACTION
                  ACCESS IS DYNAMIC
                  FILE STATUS IS WS-FILE-STATUS
                  RELATIVE KEY IS WS-RRN
                  CONTROL-AREA IS WS-KEYBOARD-RETURN-AREA.

           SELECT CATALOG-FILE  ASSIGN TO DATABASE-MCFLAB2003
                  ORGANIZATION IS INDEXED
                  ACCESS IS DYNAMIC
                  FILE STATUS IS WS-FILE-STATUS
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                  WITH DUPLICATES.

           SELECT VENDOR-FILE  ASSIGN TO DATABASE-MCFLCS0701
                  ORGANIZATION IS INDEXED
                  ACCESS IS DYNAMIC
                  FILE STATUS IS WS-FILE-STATUS
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY.

           SELECT DMANPART-FILE ASSIGN TO DATABASE-MCFLCS3603
                  ORGANIZATION IS INDEXED
                  ACCESS IS DYNAMIC
                  FILE STATUS IS WS-FILE-STATUS
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY.

           SELECT REASONCD-FILE ASSIGN TO DATABASE-MCFPAB2600
                  ORGANIZATION IS INDEXED
                  ACCESS IS DYNAMIC
                  FILE STATUS IS WS-FILE-STATUS
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY.

      *================================================================
       DATA DIVISION.
      *================================================================
       FILE SECTION.

       FD  DISPLAY-FILE.
       01  DISPLAY-REC.
       COPY DDS-ALL-FORMATS OF ZGETABPF2.

       FD  CATALOG-FILE.
       01  CATALOG-REC.
       COPY DDS-ALL-FORMATS OF MCFLAB2003.
       COPY DARIBACAT  IN COPYLIB.

       FD  VENDOR-FILE.
       01  VENDOR-REC.
       COPY DDS-ALL-FORMATS OF MCFLCS0701.
       COPY DVENDOR    IN COPYLIB.

       FD  DMANPART-FILE.
       01  DMANPART-REC.
       COPY DDS-ALL-FORMATS OF MCFLCS3603.
       COPY DMANPART   IN COPYLIB.

       FD  REASONCD-FILE.
       01  REASONCD-REC.
       COPY DDS-ALL-FORMATS OF MCFPAB2600.

      *****************************************************************
       WORKING-STORAGE SECTION.
      *****************************************************************
       01  WS-PROGRAM-VERSION     PIC X(13)       VALUE "TGETABPFV00".

       COPY FILESTATUS  IN COPYLIB.
       COPY ZMPLTWS     IN COPYLIB.
       COPY DTSPARMS2   IN COPYLIB.
       COPY KEYBDRTN    IN COPYLIB.

      *****************************************************************
      *  ALL PROGRAM INDICATORS
      *****************************************************************
       01  WS-ALL-INDICATORS.
           03  IN83              PIC 1   INDIC 83   VALUE B"0".
               88  SFL-END-OFF                      VALUE B"0".
               88  SFL-END-ON                       VALUE B"1".
           03  IN84              PIC 1   INDIC 84   VALUE B"0".
               88  SFL-CLEAR-OFF                    VALUE B"0".
               88  SFL-CLEAR-ON                     VALUE B"1".
           03  IN85              PIC 1   INDIC 85   VALUE B"0".
               88  SFL-DISPLAY-OFF                  VALUE B"0".
               88  SFL-DISPLAY-ON                   VALUE B"1".
           03  IN86              PIC 1   INDIC 86   VALUE B"0".
               88  SFL-NXTCHG-OFF                   VALUE B"0".
               88  SFL-NXTCHG-ON                    VALUE B"1".

           03  IN99              PIC 1   INDIC 99   VALUE B"0".
               88  DISPLAY-ERROR-MSSG-OFF           VALUE B"0".
               88  DISPLAY-ERROR-MSSG-ON            VALUE B"1".

           03  IN50              PIC 1   INDIC 50   VALUE B"0".
               88  SEL-FLD-DISPLAY-YES              VALUE B"0".
               88  SEL-FLD-DISPLAY-NO               VALUE B"1".

           03  IN51              PIC 1   INDIC 51   VALUE B"0".
               88  ADHOC-CURSOR-POS-NO              VALUE B"0".
               88  ADHOC-CURSOR-POS-YES             VALUE B"1".

           03  IN52              PIC 1   INDIC 52   VALUE B"0".
               88  SEL-FLD-POS-CUR-NO               VALUE B"0".
               88  SEL-FLD-POS-CUR-YES              VALUE B"1".

           03  IN40              PIC 1   INDIC 40   VALUE B"0".
               88  DSPLY-F4-KEY-OFF                 VALUE B"0".
               88  DSPLY-F4-KEY-ON                  VALUE B"1".

           03  IN60              PIC 1   INDIC 60   VALUE B"0".
               88  CORPCODE-FLD-ERROR-NO            VALUE B"0".
               88  CORPCODE-FLD-ERROR-YES           VALUE B"1".


       01  WS-ALL-SCREEN-FIELDS.
            03  WS-H01-FLDS.
                05  VERSION           PIC X(15)          VALUE SPACE.

            03  WS-H02-FLDS.
                05  VERSION           PIC X(15)          VALUE SPACE.

            03  WS-H03-FLDS.
                05  VERSION           PIC X(15)          VALUE SPACE.

            03  WS-CTL01-FLDS.
                05  CRRN              PIC S9(04)         VALUE +0.
                05  CREC              PIC X(10)          VALUE SPACE.
                05  CFLD              PIC X(10)          VALUE SPACE.
                05  CLOC              PIC S9(05)         VALUE +0.
                05  CORPCODE          PIC X(08)          VALUE SPACE.
                05  REQMSG            PIC X(60)          VALUE SPACE.
                05  DUMMY             PIC X(01)          VALUE SPACE.

            03  WS-SFL01-FLDS.
                05  SEL               PIC X(01)          VALUE SPACE.
                05  PFLAG             PIC X(02)          VALUE SPACE.
                    88  PREFERRED-VENDOR-YES             VALUE "**".
                05  MANFNAME          PIC X(15)          VALUE SPACE.
                05  MANFPART          PIC X(20)          VALUE SPACE.
                05  PRICE             PIC 9(05)V9999     VALUE ZERO.
                05  UOM               PIC X(02)          VALUE SPACE.
                05  VENDNAME          PIC X(20)          VALUE SPACE.
                05  OVERRIDE          PIC X(01)          VALUE SPACE.
                    88  PREFERRED-OVERRIDE-YES           VALUE "Y".
                05  CATREC            PIC X(400)         VALUE SPACE.

            03  WS-S01-FLDS.
                05  CORPCODE          PIC X(08)          VALUE SPACE.
                05  DUMMY             PIC X(01)          VALUE SPACE.

            03  WS-S02-FLDS.
                05  CORPCODE          PIC X(08)          VALUE SPACE.
                05  PFLAG             PIC X(02)          VALUE SPACE.
                05  MANFNAME          PIC X(50)          VALUE SPACE.
                05  MANFPART          PIC X(50)          VALUE SPACE.
                05  VNDCDE            PIC X(10)          VALUE SPACE.
                05  VNDPART           PIC X(50)          VALUE SPACE.
                05  VNDAUXID          PIC X(50)          VALUE SPACE.
                05  VNDPRICE          PIC 9(11)V9999     VALUE ZERO.
                05  CNVPRICE          PIC 9(11)V9999     VALUE ZERO.
                05  EMPPRICE          PIC 9(11)V9999     VALUE ZERO.
                05  QTYUOM            PIC X(02)          VALUE SPACE.
                05  STRUOM            PIC X(02)          VALUE SPACE.
                05  VNDUOM            PIC X(02)          VALUE SPACE.
                05  VENDNAME          PIC X(20)          VALUE SPACE.
                05  OVERRIDE          PIC X(01)          VALUE SPACE.
                05  REASONCD          PIC X(04)          VALUE SPACE.
                05  REASONTX          PIC X(55)          VALUE SPACE.
                05  CURRCD            PIC X(02)          VALUE SPACE.
                05  HOMECURR          PIC X(02)          VALUE SPACE.
                05  DATETIME          PIC X(14)          VALUE SPACE.

            03  WS-B01-FLDS.
                05  MSSG              PIC X(75)          VALUE SPACE.

            03  WS-B02-FLDS.
                05  MSSG              PIC X(75)          VALUE SPACE.

            03  WS-B03-FLDS.
                05  MSSG              PIC X(75)          VALUE SPACE.

      *****************************************************************
      *  PROGRAM MESSAGES
      *****************************************************************
       01  WS-PROGRAM-MESSAGES.

           03  WS-INIT-MSSG.
               05  FILLER            PIC X(75)           VALUE
               "A selection other than the preferred item will require a
      -        " reason code entry".

           03  WS-EMPTY-MSG.
               05  FILLER            PIC X(75)           VALUE
                  "File is Empty".

           03  WS-CC-MSSG.
               05  FILLER            PIC X(75)           VALUE
                  "Enter a valid CorpCode and Press <ENTER>".

           03  WS-INVALID-CC-MSSG1.
               05  FILLER            PIC X(75)           VALUE
                  "Enter a valid CorpCode - Can NOT be blank".

           03  WS-INVALID-CC-MSSG2.
               05  FILLER            PIC X(75)           VALUE
                  "Invalid CorpCode - Not found in Ariba Catalog".

           03  WS-SELECT-CNT-MSSG.
               05  FILLER            PIC X(75)           VALUE
                  "Select ONLY one Catalog Item".

           03  WS-ADHOC-MSSG.
               05  FILLER            PIC X(75)           VALUE
                   "No Ariba Catalog Records found  ".

       01  WS-EXCPTN-PGM            PIC X(10)   VALUE "SRSNCDPF".
       01  WS-EXCPTN-REASON-CDE PIC X(04)       VALUE SPACE.
       01  WS-EXCPTN-REASON-TXT PIC X(74)       VALUE SPACE.

      *****************************************************************
      *  MISCELLANEOUS WORK FIELDS
      *****************************************************************
       01  WS-MISCELLANEOUS-FIELDS.

           03  WS-EDIT-ERROR-SW       PIC X(01)     VALUE "N".
               88  THERE-ARE-ERRORS-YES             VALUE "Y".
               88  THERE-ARE-ERRORS-NO              VALUE "N".

           03  WS-ADHOC-SELECTION-SW  PIC X(01)     VALUE "N".
               88  ADHOC-SELECTION-IS-ON            VALUE "Y".
               88  ADHOC-SELECTION-IS-OFF           VALUE "N".

           03  WS-OVERRIDE-MODE  PIC X(01)          VALUE SPACE.
               88  REMOVE-ITEM-OVERRIDE             VALUE "1".
               88  ADD-ITEM-OVERRIDE                VALUE "2".

           03  WS-SELECTION-SW   PIC X(01)          VALUE "N".
               88  SELECTION-WAS-MADE-YES           VALUE "Y".
               88  SELECTION-WAS-MADE-NO            VALUE "N".

           03  WS-DSP-OVR-SW     PIC X(01)          VALUE "N".
               88  DISPLAY-OVERRIDE-YES             VALUE "Y".
      *----------------------------------------------------------------
      *  SOMEWHERE ON THE SCREEN AN ITEM OVERRIDE IS DISPLAYED
      *----------------------------------------------------------------
               88  DISPLAY-OVERRIDE-NO              VALUE "N".

           03  WS-REASON-CODE    PIC  X(04)         VALUE SPACE.
               88  EXCPTN-EXIT-YES                  VALUE "EXIT".

           03  WS-ALLOW-F4-SW    PIC  X(01)         VALUE "N".
               88  ALLOW-F4-KEY-NO                  VALUE "N".
               88  ALLOW-F4-KEY-YES                 VALUE "Y".

           03  WS-PASSED-CATREC  PIC  X(400)        VALUE SPACE.
           03  WS-SAVE-PRF-REC   PIC  X(400)        VALUE SPACE.
           03  WS-SAVE-PRF-PRICE PIC 9(05)V9999     VALUE ZERO.
           03  WS-SAVE-OVR-REC   PIC  X(400)        VALUE SPACE.
           03  WS-SAVE-OVR-PRICE PIC 9(05)V9999     VALUE ZERO.

           03  WS-CORP-CODE      PIC  X(08)         VALUE SPACE.
           03  WS-PLANT-KEY      PIC  X(04)         VALUE "P 01".
           03  WS-REASONCD-KEY   PIC  X(04)         VALUE SPACE.
           03  WS-PLANT-CODE     PIC  X(04)         VALUE SPACE.
           03  WS-SELECT-CNT     PIC  9(05)         VALUE ZERO.

           03  WS-RRN            PIC  9(05)         VALUE ZERO.
           03  WS-RRN1           PIC  9(05)         VALUE ZERO.
           03  WS-DSP-RRN        PIC  9(05)         VALUE ZERO.
           03  WS-SAVE-RRN       PIC  9(05)         VALUE ZERO.


      *================================================================
      *=             P R O C E D U R E    D I V I S I O N
      *================================================================
       PROCEDURE DIVISION.
       0000-PROGRAM-ENTRY.

           OPEN  INPUT  VENDOR-FILE
                        DMANPART-FILE
                        CATALOG-FILE
                        REASONCD-FILE
                 I-O    DISPLAY-FILE.


           PERFORM 0010-INITIALIZE       THRU 0010-EXIT.

           PERFORM 0100-ENTER-CORPCODE   THRU 0100-EXIT
                   UNTIL KB-F03-KEY.

           PERFORM 0099-END-OF-JOB       THRU 0099-EXIT.


           CLOSE        VENDOR-FILE
                        DMANPART-FILE
                        DISPLAY-FILE
                        REASONCD-FILE
                        CATALOG-FILE.

       0000-PROGRAM-END.
           GOBACK.

      *****************************************************************
      ** 1ST TIME PROCESSING ROUTINE
      *****************************************************************
       0010-INITIALIZE.

           SET  ALLOW-F4-KEY-NO  TO TRUE.
           SET  DSPLY-F4-KEY-OFF TO TRUE.

           SET  KB-ENTER-KEY     TO TRUE.
           SET  SELECTION-WAS-MADE-NO  TO TRUE.
           SET  ADHOC-SELECTION-IS-OFF TO TRUE.

           MOVE WS-PLANT-KEY       TO  WS-ZMPLT-KEY.
           PERFORM ZMPLT-GET-MPLTINFO  THRU ZMPLT-EXIT.
           MOVE WS-ZMPLT-FILE-STATUS  TO WS-FILE-STATUS.
           MOVE WS-ZMPLT-PLTINFODTA(1:3) TO WS-PLANT-CODE.

           MOVE WS-CC-MSSG          TO MSSG  OF WS-B01-FLDS.

       0010-EXIT.
            EXIT.

      *****************************************************************
      ** END OF JOB ROUTINE
      *****************************************************************
       0099-END-OF-JOB.


       0099-EXIT.
            EXIT.

      *****************************************************************
      ***  ENTER CORPCODE - SCREEN S01
      *****************************************************************
       0100-ENTER-CORPCODE.

           PERFORM 8200-DISPLAY-SCREEN-S01 THRU 8200-DSP-EXIT.
           IF  KB-F03-KEY
               GO TO 0100-EXIT
           END-IF.

           PERFORM 0110-EDIT-CORPCODE    THRU 0110-EXIT.
           IF  THERE-ARE-ERRORS-YES
               GO TO 0100-EXIT
           END-IF.

      ***  PROCESS CATALOG OVERRIDES
           PERFORM 1999-BUILD-SFL01      THRU 1999-EXIT.
           PERFORM 1000-PROCESS-OVERRIDES THRU 1000-EXIT
                   UNTIL KB-F03-KEY.

           INITIALIZE  WS-S01-FLDS.
           MOVE WS-CC-MSSG          TO MSSG  OF WS-B01-FLDS.

           SET  KB-ENTER-KEY            TO TRUE.
           SET  SELECTION-WAS-MADE-NO   TO TRUE.

       0100-EXIT.
            EXIT.

      *****************************************************************
      ***  EDIT CORPCODE
      *****************************************************************
       0110-EDIT-CORPCODE.

           SET  THERE-ARE-ERRORS-NO    TO TRUE.

           IF  CORPCODE  OF WS-S01-FLDS = SPACE
               MOVE WS-INVALID-CC-MSSG1  TO MSSG  OF WS-B01-FLDS
               SET  CORPCODE-FLD-ERROR-YES  TO TRUE
               GO TO 0110-ERROR
           END-IF.

           MOVE  CORPCODE OF WS-S01-FLDS TO WS-CORP-CODE.
           PERFORM 9000-START-CATALOG   THRU 9000-START-EXIT.
           PERFORM 9000-READN-CATALOG   THRU 9000-READN-EXIT.
           IF  FS-END-OF-FILE
               MOVE WS-INVALID-CC-MSSG2 TO MSSG  OF WS-B01-FLDS
               SET  CORPCODE-FLD-ERROR-YES  TO TRUE
               GO TO 0110-ERROR
           END-IF.

           GO TO 0110-EXIT.

       0110-ERROR.

           SET  DISPLAY-ERROR-MSSG-ON  TO TRUE.
           SET  THERE-ARE-ERRORS-YES   TO TRUE.

       0110-EXIT.
            EXIT.

      *****************************************************************
      ***  PROCESS CATALOG OVERRIDES
      *****************************************************************
       1000-PROCESS-OVERRIDES.

           PERFORM 8000-DISPLAY-OVRMNT-SCREEN THRU 8000-DSP-EXIT.
           IF  KB-F03-KEY
               GO TO 1000-EXIT
           END-IF.

      **===============================================================
      ** IF THERE ARE SFL RECORDS TO DISPLAY ..............
      **===============================================================
           IF  SFL-DISPLAY-ON

      ***  NO CATALOG ITEMS - JUST ITEMS FROM DMANPART
               IF  ADHOC-SELECTION-IS-ON
                   SET  SELECTION-WAS-MADE-YES  TO TRUE
                   GO TO 1000-EXIT
               END-IF

      ***  CHECK FOR DISPLAY OF DETAIL SCREEN
               MOVE ZERO             TO WS-SELECT-CNT
               PERFORM 1300-CHECK-S02DSP THRU 1300-EXIT
               IF  WS-SELECT-CNT > ZERO
                   GO TO 1000-RELOAD
               END-IF

      ***  CHECK FOR MORE THAN ONE SELECTION
               MOVE ZERO             TO WS-SELECT-CNT
               PERFORM 1200-CHECK-SELCNT THRU 1200-EXIT
               IF  WS-SELECT-CNT > 1
                   PERFORM 1210-SELCNT-ERROR THRU 1210-EXIT
                   GO TO 1000-EXIT
               END-IF

      ***  ONLY CATALOG ITEMS CAN BE SELECTED AND ONLY ONE OF THEM
               IF  WS-SELECT-CNT = 1
                   PERFORM 1100-CHECK-SFL01  THRU 1100-EXIT
                   SET  KB-ENTER-KEY            TO TRUE
               END-IF

      *****    IF  SELECTION-WAS-MADE-YES
      *****        GO TO 1000-EXIT
      *****    END-IF

           END-IF.

       1000-RELOAD.
      **===============================================================
      ** REBUILD SFL AND DISPLAY
      **===============================================================
           PERFORM 1999-BUILD-SFL01      THRU 1999-EXIT.

       1000-EXIT.
            EXIT.

      *****************************************************************
      ***  CHECK SFL01 FOR USER SELECTION
      *****************************************************************
       1100-CHECK-SFL01.

           PERFORM 8000-READN-SFL01      THRU 8000-READN-EXIT.
           IF  FS-END-OF-FILE
               GO TO 1100-EXIT
           END-IF.

           IF  SEL  OF WS-SFL01-FLDS = 'X'

      *================================================================
      ***  PREFERRED VENDOR HAS BEEN SELECTED - ACCEPT IT & RETURN
      *================================================================
               IF  PREFERRED-VENDOR-YES
      ******** OR  PREFERRED-OVERRIDE-YES
                   PERFORM 1110-GOOD-SELECTION   THRU 1110-EXIT
                   GO TO 1100-EXIT
               END-IF

      *================================================================
      ***  ALLOW SELECTION OTHER THAN PREFERRED VENDOR ONLY IF
      ***  THE SELECTED VENDOR PRICE = PREFERRED VENDOR PRICE
      *================================================================
               IF  PRICE    OF WS-SFL01-FLDS = WS-SAVE-PRF-PRICE
                   PERFORM 1110-GOOD-SELECTION   THRU 1110-EXIT
                   GO TO 1100-EXIT
               END-IF

               PERFORM 1112-BAD-SELECTION     THRU 1112-EXIT
               GO TO 1100-EXIT
           END-IF.

           SET  SFL-NXTCHG-OFF  TO TRUE.
           MOVE SPACE           TO SEL   OF WS-SFL01-FLDS.

           PERFORM 8000-REWRT-SFL01      THRU 8000-REWRT-EXIT.
           GO TO 1100-CHECK-SFL01.

       1100-EXIT.
            EXIT.

      *****************************************************************
      ***  GOOD SELECTION
      *****************************************************************
       1110-GOOD-SELECTION.

           SET  SELECTION-WAS-MADE-YES  TO TRUE.

           MOVE CATREC   OF WS-SFL01-FLDS  TO BUF-DARIBCAT.

      *================================================================
      ***  AN OVERRIDE WAS INITIALLY DISPLAYED BUT THE PREFERRED
      ***  WAS SELECTED - REMOVE THE ITEM OVERRIDE
      *================================================================
           IF  PREFERRED-VENDOR-YES
           AND DISPLAY-OVERRIDE-YES
               MOVE SPACE             TO ARIBACAT-OVRD-FLAG
               MOVE SPACE             TO ARIBACAT-REASON-CODE
               PERFORM 2000-RMV-OVERRIDE  THRU 2000-EXIT
           END-IF.

       1110-EXIT.
            EXIT.
      *****************************************************************
      ***  BAD  SELECTION - REASON CODE ENTRY THE CALL THE OVERRIDE
      ***  MAINT PGM TO "ADD" OVERRIDE REC
      *****************************************************************
       1112-BAD-SELECTION.

           CALL  WS-EXCPTN-PGM USING WS-EXCPTN-REASON-CDE
                                     WS-EXCPTN-REASON-TXT.
           MOVE WS-EXCPTN-REASON-CDE  TO WS-REASON-CODE.
           IF  EXCPTN-EXIT-YES
               GO TO 1112-EXIT
           END-IF.

           SET  SELECTION-WAS-MADE-YES  TO TRUE.

      ***  ADD PREFERRED ITEM OVERRIDE (CALL CCATOVRUP)
           MOVE CATREC   OF WS-SFL01-FLDS  TO BUF-DARIBCAT.
           MOVE "Y"                   TO ARIBACAT-OVRD-FLAG.
           MOVE WS-EXCPTN-REASON-CDE  TO ARIBACAT-REASON-CODE.
           PERFORM 2100-ADD-OVERRIDE     THRU 2100-EXIT.

       1112-EXIT.
            EXIT.
      *****************************************************************
      ***  MAKE SURE ONLY ONE SELECTION WAS MADE
      *****************************************************************
       1200-CHECK-SELCNT.

           PERFORM 8000-READN-SFL01      THRU 8000-READN-EXIT.
           IF  FS-END-OF-FILE
               GO TO 1200-EXIT
           END-IF.

           SET  SFL-NXTCHG-OFF  TO TRUE.
           IF  SEL  OF WS-SFL01-FLDS = 'X'
               ADD  1           TO WS-SELECT-CNT
               SET  SFL-NXTCHG-ON   TO TRUE
           END-IF.

           IF  CATREC   OF  WS-SFL01-FLDS = SPACE
               SET  SEL-FLD-DISPLAY-NO   TO TRUE
           ELSE
               SET  SEL-FLD-DISPLAY-YES  TO TRUE
           END-IF.

           IF  SEL  OF WS-SFL01-FLDS NOT = 'X'
           AND SEL  OF WS-SFL01-FLDS NOT = SPACE
               MOVE SPACE           TO SEL   OF WS-SFL01-FLDS
           END-IF.

           PERFORM 8000-REWRT-SFL01      THRU 8000-REWRT-EXIT.
           GO TO 1200-CHECK-SELCNT.

       1200-EXIT.
            EXIT.

      *****************************************************************
      ***  MORE THAN ONE SELECTION WAS MADE - DISPLAY ERROR MSSG
      *****************************************************************
       1210-SELCNT-ERROR.

           SET  DISPLAY-ERROR-MSSG-ON   TO TRUE.
           MOVE WS-SELECT-CNT-MSSG  TO MSSG  OF WS-B02-FLDS.

       1210-EXIT.
            EXIT.

      *****************************************************************
      *** CHECK FOR DISPLAY OF DETAIL SCREEN
      *****************************************************************
       1300-CHECK-S02DSP.

           PERFORM 8000-READN-SFL01      THRU 8000-READN-EXIT.
           IF  FS-END-OF-FILE
               GO TO 1300-EXIT
           END-IF.

           SET  SFL-NXTCHG-OFF  TO TRUE.
           IF  SEL  OF WS-SFL01-FLDS = 'X'
               SET  SFL-NXTCHG-ON   TO TRUE
               SET  SEL-FLD-DISPLAY-YES  TO TRUE
               GO TO 1300-UPD-SFL
           END-IF.

           IF  CATREC   OF  WS-SFL01-FLDS = SPACE
               SET  SEL-FLD-DISPLAY-NO   TO TRUE
           ELSE
               SET  SEL-FLD-DISPLAY-YES  TO TRUE
           END-IF.

           IF  SEL  OF WS-SFL01-FLDS = 'I'
               ADD  1           TO WS-SELECT-CNT
               MOVE SPACE       TO SEL   OF WS-SFL01-FLDS
               MOVE CATREC OF WS-SFL01-FLDS TO BUF-DARIBCAT
               PERFORM 1310-PROCESS-S02      THRU 1310-EXIT
           END-IF.

       1300-UPD-SFL.

           IF  SEL  OF WS-SFL01-FLDS NOT = 'X'
           AND SEL  OF WS-SFL01-FLDS NOT = SPACE
               MOVE SPACE           TO SEL   OF WS-SFL01-FLDS
           END-IF.

           PERFORM 8000-REWRT-SFL01      THRU 8000-REWRT-EXIT.
           GO TO 1300-CHECK-S02DSP.

       1300-EXIT.
            EXIT.

      *****************************************************************
      ***  BUILD AND DISPLAY SCREEN S02
      *****************************************************************
       1310-PROCESS-S02.

           PERFORM 1311-BUILD-S02    THRU 1311-EXIT.

           PERFORM 8100-DISPLAY-SCREEN-2 THRU 8100-DSP-EXIT.

           SET  KB-ENTER-KEY     TO TRUE.

       1310-EXIT.
            EXIT.

      *****************************************************************
      ***  LOAD S02 FLDS
      *****************************************************************
       1311-BUILD-S02.

           INITIALIZE  WS-S02-FLDS.

           MOVE ARIBACAT-CORP-CODE       TO CORPCODE OF WS-S02-FLDS.
           MOVE ARIBACAT-MANUFACT-NAME   TO MANFNAME OF WS-S02-FLDS.
           MOVE ARIBACAT-MANUFACT-PARTNO TO MANFPART OF WS-S02-FLDS.
           MOVE ARIBACAT-VENDOR-CODE     TO VNDCDE  OF WS-S02-FLDS.
           MOVE ARIBACAT-VENDOR-PARTNO   TO VNDPART OF WS-S02-FLDS.
           MOVE ARIBACAT-VENDOR-AUXID    TO VNDAUXID OF WS-S02-FLDS.
           MOVE ARIBACAT-CONVER-PRICE    TO CNVPRICE OF WS-S02-FLDS.
           MOVE ARIBACAT-VENDOR-PRICE    TO VNDPRICE OF WS-S02-FLDS.
           MOVE ARIBACAT-EMPTY-PRICE     TO EMPPRICE OF WS-S02-FLDS.
           MOVE ARIBACAT-CURR-CODE       TO CURRCD OF WS-S02-FLDS.
           MOVE ARIBACAT-HOME-CURR-CODE  TO HOMECURR OF WS-S02-FLDS.
           MOVE ARIBACAT-PREF-FLAG       TO PFLAG OF WS-S02-FLDS.
           MOVE ARIBACAT-OVRD-FLAG       TO OVERRIDE OF WS-S02-FLDS.
           MOVE ARIBACAT-STOREROOM-UM    TO STRUOM   OF WS-S02-FLDS.
           MOVE ARIBACAT-VENDOR-UM       TO VNDUOM   OF WS-S02-FLDS.
           MOVE ARIBACAT-QTY-UM          TO QTYUOM   OF WS-S02-FLDS.
           MOVE ARIBACAT-REASON-CODE     TO REASONCD OF WS-S02-FLDS.

           IF  ARIBACAT-REASON-CODE NOT = SPACE
               MOVE ARIBACAT-REASON-CODE TO WS-REASONCD-KEY
               PERFORM 9400-READK-REASONCD  THRU 9400-READK-EXIT
               MOVE RDESC                TO REASONTX OF WS-S02-FLDS
           END-IF.

           MOVE ARIBACAT-DATE-TIME-STMP  TO DATETIME OF WS-S02-FLDS.

       1311-EXIT.
            EXIT.

      *****************************************************************
      ***  CLEAR SFL01
      *****************************************************************
       1998-CLEAR-SFL01.

           INITIALIZE  WS-SFL01-FLDS.
           MOVE ZERO             TO WS-RRN  WS-RRN1.
           MOVE 1                TO WS-DSP-RRN.
           MOVE ZERO             TO WS-SELECT-CNT.
           MOVE 1                TO WS-SAVE-RRN.

           SET  SFL-CLEAR-ON     TO TRUE.
           PERFORM 8000-WRITE-CTL01      THRU 8000-WRTCR-EXIT.
           SET  SFL-CLEAR-OFF    TO TRUE.

           SET  SFL-END-ON       TO TRUE.
           SET  SFL-NXTCHG-OFF   TO TRUE.
           SET  SFL-DISPLAY-OFF  TO TRUE.
           SET  SEL-FLD-DISPLAY-YES  TO TRUE.
           SET  ADHOC-SELECTION-IS-OFF TO TRUE.
           SET  ADHOC-CURSOR-POS-NO    TO TRUE.
           SET  DISPLAY-OVERRIDE-NO    TO TRUE.

           MOVE WS-CORP-CODE     TO CORPCODE  OF WS-CTL01-FLDS.
           MOVE SPACE            TO REQMSG    OF WS-CTL01-FLDS.
           MOVE SPACE            TO WS-SAVE-PRF-REC.

       1998-EXIT.
            EXIT.

      *****************************************************************
      ***  BUILD SFL01 - FIRST PAGE
      *****************************************************************
       1999-BUILD-SFL01.

           PERFORM 1998-CLEAR-SFL01     THRU 1998-EXIT.
           PERFORM 1999A-LOAD-CATALOG   THRU 1999A-CAT-EXIT.

           IF  WS-RRN = ZERO
               SET  ADHOC-SELECTION-IS-ON  TO TRUE
               SET  ADHOC-CURSOR-POS-YES   TO TRUE
               MOVE WS-ADHOC-MSSG       TO MSSG  OF WS-B01-FLDS
           ELSE
              IF  DISPLAY-OVERRIDE-YES
                  MOVE  WS-RRN      TO WS-SAVE-RRN
                  PERFORM 1999C-RESET-PREFRRED THRU 1999C-PREF-EXIT
                  MOVE  WS-SAVE-RRN TO WS-RRN
              END-IF
           END-IF.

           PERFORM 1999B-LOAD-DMANPART  THRU 1999B-DMAN-EXIT.

       1999-EXIT.
            EXIT.

      *****************************************************************
      ***  BUILD SFL01  - LOAD CATALOG DATA
      *****************************************************************
       1999A-LOAD-CATALOG.

           PERFORM 9000-START-CATALOG   THRU 9000-START-EXIT.

       1999A-READ-LOOP1.

           PERFORM 9000-READN-CATALOG   THRU 9000-READN-EXIT.
           IF  FS-END-OF-FILE
               GO TO 1999A-CAT-EXIT
           END-IF.

           SET  SFL-NXTCHG-OFF  TO TRUE.
           SET  SEL-FLD-DISPLAY-YES  TO TRUE.
           SET  SEL-FLD-POS-CUR-NO   TO TRUE.

           MOVE SPACE         TO SEL           OF WS-SFL01-FLDS.
           MOVE SPACE         TO PFLAG         OF WS-SFL01-FLDS.
           MOVE SPACE         TO OVERRIDE      OF WS-SFL01-FLDS.

           IF  ARIBACAT-PREF-FLAG = "Y"
               MOVE "**"      TO PFLAG         OF WS-SFL01-FLDS
               MOVE "X"       TO SEL           OF WS-SFL01-FLDS
               MOVE CATALOG-REC    TO WS-SAVE-PRF-REC
               MOVE ARIBACAT-CONVER-PRICE    TO WS-SAVE-PRF-PRICE
               SET  SFL-NXTCHG-ON  TO TRUE
           ELSE
              IF  ARIBACAT-OVRD-FLAG = "Y"
                  MOVE ARIBACAT-REASON-CODE(3:2)
                                        TO PFLAG OF WS-SFL01-FLDS
                  MOVE "X"       TO SEL OF WS-SFL01-FLDS
                  MOVE CATALOG-REC    TO WS-SAVE-OVR-REC
                  MOVE ARIBACAT-CONVER-PRICE    TO WS-SAVE-OVR-PRICE
                  SET  SFL-NXTCHG-ON  TO TRUE
                  SET  DISPLAY-OVERRIDE-YES TO TRUE
                  SET  SEL-FLD-POS-CUR-YES  TO TRUE
                  SET  PREFERRED-OVERRIDE-YES TO TRUE
              END-IF
           END-IF.

           PERFORM 9100-READK-VENDOR    THRU 9100-READK-EXIT.

           MOVE ARIBACAT-MANUFACT-NAME   TO MANFNAME OF WS-SFL01-FLDS.
           MOVE ARIBACAT-MANUFACT-PARTNO TO MANFPART OF WS-SFL01-FLDS.
           MOVE ARIBACAT-CONVER-PRICE    TO PRICE    OF WS-SFL01-FLDS.
           MOVE ARIBACAT-STOREROOM-UM    TO UOM      OF WS-SFL01-FLDS.
           MOVE VEN-NAME                 TO VENDNAME OF WS-SFL01-FLDS.
           MOVE CATALOG-REC              TO CATREC   OF WS-SFL01-FLDS.
           MOVE ARIBACAT-OVRD-FLAG       TO OVERRIDE OF WS-SFL01-FLDS.

           ADD  1  TO WS-RRN.
           PERFORM 8000-WRITE-SFL01      THRU 8000-WRTSF-EXIT.

           GO TO 1999A-READ-LOOP1.

       1999A-CAT-EXIT.
            EXIT.

      *****************************************************************
      ***  BUILD SFL01  - LOAD DMANPART DATA
      *****************************************************************
       1999B-LOAD-DMANPART.

           PERFORM 9300-START-DMANPART  THRU 9300-START-EXIT.

       1999B-READ-LOOP1.

           PERFORM 9300-READN-DMANPART  THRU 9300-READN-EXIT.
           IF  FS-END-OF-FILE
               GO TO 1999B-DMAN-EXIT
           END-IF.

           SET  SEL-FLD-DISPLAY-NO   TO TRUE.
           SET  SFL-NXTCHG-OFF  TO TRUE.
           SET  SEL-FLD-POS-CUR-NO   TO TRUE.

           MOVE SPACE         TO SEL           OF WS-SFL01-FLDS.

           MOVE MAN-PARTNO-SELECT        TO PFLAG    OF WS-SFL01-FLDS
           MOVE MAN-NAME                 TO MANFNAME OF WS-SFL01-FLDS.
           MOVE MAN-PARTNO               TO MANFPART OF WS-SFL01-FLDS.
           MOVE ZERO                     TO PRICE    OF WS-SFL01-FLDS.
           MOVE SPACE                    TO UOM      OF WS-SFL01-FLDS.
           MOVE SPACE                    TO VENDNAME OF WS-SFL01-FLDS.
           MOVE SPACE                    TO CATREC   OF WS-SFL01-FLDS.

           ADD  1  TO WS-RRN.

           PERFORM 8000-WRITE-SFL01      THRU 8000-WRTSF-EXIT.
           GO TO 1999B-READ-LOOP1.

       1999B-DMAN-EXIT.
            EXIT.

      *****************************************************************
      ***  RESET PREFERRED ITEM TO OVERRIDE ITEM
      *****************************************************************
       1999C-RESET-PREFRRED.

           MOVE  1           TO WS-RRN.
           PERFORM 8000-READK-SFL01     THRU 8000-READK-EXIT.

           MOVE SPACE     TO SEL           OF WS-SFL01-FLDS.
           SET  SFL-NXTCHG-OFF TO TRUE.
           SET  SEL-FLD-POS-CUR-NO   TO TRUE.

           PERFORM 8000-REWRT-SFL01     THRU 8000-REWRT-EXIT.

       1999C-PREF-EXIT.
            EXIT.

      *****************************************************************
      ** REMOVE THE CURRENT ITEM OVERRIDE
      *****************************************************************
       2000-RMV-OVERRIDE.

           SET REMOVE-ITEM-OVERRIDE TO TRUE.
           MOVE BUF-DARIBCAT      TO WS-PASSED-CATREC.

           CALL "CCATOVRUP"  USING  WS-OVERRIDE-MODE
                                    WS-PASSED-CATREC.

       2000-EXIT.
            EXIT.
      *****************************************************************
      ** ADD A NEW ITEM OVERRIDE
      **  -- RMV THE CURRENT OVERRIDE
      **  -- ADD A NEW OVERRIDE
      *****************************************************************
       2100-ADD-OVERRIDE.

           SET ADD-ITEM-OVERRIDE  TO TRUE.
           MOVE BUF-DARIBCAT      TO WS-PASSED-CATREC.

           CALL "CCATOVRUP"  USING  WS-OVERRIDE-MODE
                                    WS-PASSED-CATREC.

       2100-EXIT.
            EXIT.
      *****************************************************************
      ** GET DATE AND TIME STAMP - CCYYMMDDHHMMSS  X(14)
      *****************************************************************
       7999-GET-DATE-TIME.

           CALL WS-DTS-PGM2  USING WS-SYSTEM-DATE-TIME2.

       7999-GDT-EXIT.
            EXIT.

      *****************************************************************
      ** DISPLAY CATALOG OVERRIDE MAINTENANCE SCREEN
      *****************************************************************
       8000-DISPLAY-OVRMNT-SCREEN.

           MOVE WS-PROGRAM-VERSION TO VERSION OF WS-H02-FLDS.
           MOVE "-S2"              TO VERSION OF WS-H02-FLDS(12:3).

           MOVE CORR WS-H02-FLDS    TO H02-O.
           WRITE DISPLAY-REC FORMAT "H02"
      *******    INDICATORS ARE WS-ALL-INDICATORS.
           END-WRITE.

           IF  WS-RRN1 > ZERO
               IF  WS-SELECT-CNT <= 1
                   MOVE WS-INIT-MSSG TO MSSG  OF WS-B02-FLDS
               END-IF
               IF  ADHOC-SELECTION-IS-ON
                   MOVE WS-ADHOC-MSSG TO MSSG OF WS-B02-FLDS
               END-IF
           ELSE
               MOVE WS-EMPTY-MSG    TO MSSG  OF WS-B02-FLDS
           END-IF.

           SET  DSPLY-F4-KEY-OFF TO TRUE.

           MOVE CORR WS-B02-FLDS    TO B02-O.
           WRITE DISPLAY-REC FORMAT "B02"
                 INDICATORS ARE WS-ALL-INDICATORS
           END-WRITE.

           IF  WS-RRN1 > ZERO
               SET SFL-DISPLAY-ON   TO TRUE
           END-IF.
           MOVE WS-DSP-RRN TO CRRN OF WS-CTL01-FLDS.

           MOVE CORR WS-CTL01-FLDS  TO CTL01-O.
           WRITE DISPLAY-REC FORMAT "CTL01"
                 INDICATORS ARE WS-ALL-INDICATORS
           END-WRITE.

           READ  DISPLAY-FILE FORMAT "CTL01"
                 INDICATORS ARE WS-ALL-INDICATORS
           END-READ.
           MOVE CORR CTL01-I TO WS-CTL01-FLDS.

           SET  DISPLAY-ERROR-MSSG-OFF  TO TRUE.
           MOVE SPACE           TO MSSG  OF WS-B02-FLDS.

       8000-DSP-EXIT.
            EXIT.

      *****************************************************************
      *** CTL01 WRITE CONTROL RECORD
      *****************************************************************
       8000-WRITE-CTL01.

           WRITE DISPLAY-REC FORMAT "CTL01"
                 INDICATORS ARE WS-ALL-INDICATORS
           END-WRITE.

       8000-WRTCR-EXIT.
            EXIT.
      *****************************************************************
      *** SFL01 READ NEXT MODIFIED RECORD
      *****************************************************************
       8000-READN-SFL01.

           READ SUBFILE DISPLAY-FILE
                NEXT MODIFIED RECORD FORMAT IS "SFL01"
                     INDICATORS ARE WS-ALL-INDICATORS
           END-READ.
           IF FS-GOOD-FILE-IO
              MOVE CORR SFL01-I        TO WS-SFL01-FLDS
           END-IF.

       8000-READN-EXIT.
            EXIT.
      *****************************************************************
      *** SFL01 READ BY KEY (RRN)
      *****************************************************************
       8000-READK-SFL01.

           READ SUBFILE DISPLAY-FILE
                RECORD FORMAT IS "SFL01"
                INDICATORS ARE WS-ALL-INDICATORS
           END-READ.
           IF FS-GOOD-FILE-IO
              MOVE CORR SFL01-I        TO WS-SFL01-FLDS
           END-IF.

       8000-READK-EXIT.
            EXIT.
      *****************************************************************
      *** SFL01 WRITE SUBFILE RECORD
      *****************************************************************
       8000-WRITE-SFL01.

           MOVE WS-RRN              TO WS-RRN1.

           MOVE CORR WS-SFL01-FLDS  TO SFL01-O.
           WRITE SUBFILE DISPLAY-REC FORMAT "SFL01"
                         INDICATORS ARE WS-ALL-INDICATORS
           END-WRITE.

       8000-WRTSF-EXIT.
            EXIT.
      *****************************************************************
      *** SFL01 REWRITE SUBFILE RECORD
      *****************************************************************
       8000-REWRT-SFL01.

           MOVE CORR WS-SFL01-FLDS  TO SFL01-O.
           REWRITE SUBFILE DISPLAY-REC FORMAT "SFL01"
                         INDICATORS ARE WS-ALL-INDICATORS
           END-REWRITE.

       8000-REWRT-EXIT.
            EXIT.

      *****************************************************************
      ** DISPLAY SCREEN 2 - DISPLAY CATALOG ITEM DETAIL SCREEN
      *****************************************************************
       8100-DISPLAY-SCREEN-2.

           MOVE WS-PROGRAM-VERSION TO VERSION OF WS-H03-FLDS.
           MOVE "-S3"              TO VERSION OF WS-H03-FLDS(12:3).

           MOVE CORR WS-H03-FLDS    TO H03-O.
           WRITE DISPLAY-REC FORMAT "H03"
      *******    INDICATORS ARE WS-ALL-INDICATORS.
           END-WRITE.

           MOVE CORR WS-B03-FLDS    TO B03-O.
           WRITE DISPLAY-REC FORMAT "B03"
                 INDICATORS ARE WS-ALL-INDICATORS
           END-WRITE.


           MOVE CORR WS-S02-FLDS    TO S02-O.
           WRITE DISPLAY-REC FORMAT "S02"
                 INDICATORS ARE WS-ALL-INDICATORS
           END-WRITE.

           READ  DISPLAY-FILE FORMAT "S02"
                 INDICATORS ARE WS-ALL-INDICATORS
           END-READ.
      **** MOVE CORR S02-I TO WS-S02-FLDS.

           MOVE SPACE           TO MSSG  OF WS-B03-FLDS.

       8100-DSP-EXIT.
            EXIT.

      *****************************************************************
      ** DISPLAY SCREEN S01 - ENTER CORPCODE
      *****************************************************************
       8200-DISPLAY-SCREEN-S01.

           MOVE WS-PROGRAM-VERSION TO VERSION OF WS-H01-FLDS.
           MOVE "-S1"              TO VERSION OF WS-H01-FLDS(12:3).

           MOVE CORR WS-H01-FLDS    TO H01-O.
           WRITE DISPLAY-REC FORMAT "H01"
      *******    INDICATORS ARE WS-ALL-INDICATORS.
           END-WRITE.

           MOVE CORR WS-B01-FLDS    TO B01-O.
           WRITE DISPLAY-REC FORMAT "B01"
                 INDICATORS ARE WS-ALL-INDICATORS
           END-WRITE.


           MOVE CORR WS-S01-FLDS    TO S01-O.
           WRITE DISPLAY-REC FORMAT "S01"
                 INDICATORS ARE WS-ALL-INDICATORS
           END-WRITE.

           READ  DISPLAY-FILE FORMAT "S01"
                 INDICATORS ARE WS-ALL-INDICATORS
           END-READ.
           MOVE CORR S01-I   TO WS-S01-FLDS.

           SET  CORPCODE-FLD-ERROR-NO  TO TRUE.
           MOVE SPACE           TO MSSG  OF WS-B01-FLDS.

       8200-DSP-EXIT.
            EXIT.


       COPY ZMPLTSUBR  IN COPYLIB.

      *----------------------------------------------------------------
      *
      *                ALL FILE I-O'S BELOW THIS POINT
      *
      *----------------------------------------------------------------

      *****************************************************************
      ***  START CATALOG FILE
      *****************************************************************
       9000-START-CATALOG.

           INITIALIZE CATALOG-REC.
           MOVE WS-CORP-CODE     TO ARIBACAT-CORP-CODE.
           MOVE ZERO             TO ARIBACAT-CONVER-PRICE.

           START CATALOG-FILE
                 KEY IS >= EXTERNALLY-DESCRIBED-KEY
           END-START.

       9000-START-EXIT.
            EXIT.

      *****************************************************************
      *** READ CATALOG FILE SEQUENTIALLY
      *****************************************************************
       9000-READN-CATALOG.

           READ CATALOG-FILE NEXT RECORD
           END-READ.

           IF  ARIBACAT-CORP-CODE  NOT = WS-CORP-CODE
               SET FS-END-OF-FILE  TO TRUE
               INITIALIZE BUF-DARIBCAT
           END-IF.

       9000-READN-EXIT.
            EXIT.

      *****************************************************************
      *** READ VENDOR FILE BY KEY - VENDOR CODE
      *****************************************************************
       9100-READK-VENDOR.

           INITIALIZE VENDOR-REC.

           MOVE ARIBACAT-VENDOR-CODE  TO VEN-VEN-CODE.
           MOVE ZERO                  TO VEN-ITM-NO.

           READ VENDOR-FILE
           END-READ.

           IF  FS-RECORD-NOT-FOUND
               MOVE "UNKNOWN"  TO VEN-NAME
           END-IF.

       9100-READK-EXIT.
            EXIT.
      *****************************************************************
      ***  START DMANPART FILE
      *****************************************************************
       9300-START-DMANPART.

           INITIALIZE DMANPART-REC.
           MOVE WS-CORP-CODE TO MAN-CORPCODE.

           START DMANPART-FILE
                 KEY IS >= EXTERNALLY-DESCRIBED-KEY
           END-START.

       9300-START-EXIT.
            EXIT.

      *****************************************************************
      *** READ DMANPART FILE SEQUENTIALLY
      *****************************************************************
       9300-READN-DMANPART.

           READ DMANPART-FILE NEXT RECORD
           END-READ.

           IF  MAN-CORPCODE  NOT = WS-CORP-CODE
               SET FS-END-OF-FILE  TO TRUE
           END-IF.

       9300-READN-EXIT.
            EXIT.

      *****************************************************************
      *** READ DMANPART FILE SEQUENTIALLY
      *****************************************************************
       9400-READK-REASONCD.

           INITIALIZE REASONCD-REC.

           MOVE WS-REASONCD-KEY   TO  RCODE.

           READ REASONCD-FILE
           END-READ.

           IF  FS-RECORD-NOT-FOUND
               MOVE SPACE  TO RDESC
           END-IF.

       9400-READK-EXIT.
            EXIT.
      *****************************************************************
      ***              END  OF  SOURCE  MEMBER
      *****************************************************************
