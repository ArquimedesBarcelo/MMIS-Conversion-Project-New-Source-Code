       IDENTIFICATION DIVISION.
       PROGRAM-ID.             TEQPHIER.
       ENVIRONMENT DIVISION.
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT WO-EQUIP-HIER
                  ASSIGN TO DATABASE-MCFLMM1701
                  ORGANIZATION IS INDEXED
                  ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                  WITH DUPLICATES
                  FILE STATUS IS FILE-STAT.

       DATA DIVISION.
       FILE SECTION.
       FD  WO-EQUIP-HIER
           LABEL RECORDS ARE STANDARD.
       01  HIER-REC.
           COPY DDS-ALL-FORMATS OF MCFLMM1701.

       WORKING-STORAGE SECTION.
       77  LEVEL-SW            PIC 9.
       77  SUB                 PIC 99.

       01  FILE-STAT.
           05  FILE-STAT-1     PIC X  VALUE "0".
           05  FILE-STAT-2     PIC X  VALUE "0".

       01  SEARCH-KEY.
           05  SEARCH-TYPE     PIC X(8).
           05  SEARCH-VARIABLES.
               10  SV-9        PIC X.
               10  SV-10       PIC X.
               10  SV-11       PIC X.
               10  SV-12       PIC X.
           05  SEARCH-REST     PIC XX.

       01  SUFFIX-KEY.
           05  SUFFIX-TYPE     PIC X(8).
           05  SUFFIX-VARIABLES.
               10  SUFFIX-9    PIC X.
               10  SUFFIX-10   PIC X.
               10  SUFFIX-11   PIC X.
               10  SUFFIX-12   PIC X.
           05  SUFFIX-REST     PIC XX.

       01  HIER-WORK-AREA.
           05  HIER-KEY-WA      PIC X(14).
           05  HIER-DISP-CODE-WA.
               10  HIER-DC-WA.
                   15  HDC-1-WA PIC X.
                   15  HDC-2-WA PIC X.
                   15  HDC-3-WA PIC X.
                   15  HDC-4-WA PIC X.
               10  FILLER       PIC XX.
           05  HIER-NAME-WA     PIC X(50).

       01  HOLD-TABLE.
           05  HOLD-AREA OCCURS 10 TIMES PIC X(41).

       01  HOLD-BUFFER.
           05  SUB-BUF         PIC X.
           05  DESC-BUF        PIC X(40).

           COPY CATREAD        IN COPYCSIS.

       LINKAGE SECTION.
       01  DBPARAMETERS.
           COPY DBPARMS        IN COPYLIB.

       01  EQUIP-TYPE          PIC X(8).

       01  FAILURE-CODE.
           05  TYPE-FAILURE    PIC XX.
           05  SUBSYSTEM-KEY.
               10  SUBSYSTEM-1 PIC X.
               10  SUBSYSTEM-2 PIC X.
               10  SUBSYSTEM-3 PIC X.
               10  SUBSYSTEM-4 PIC X.

       01  DESC-BUFFER.
           05  SUB-BUF-1       PIC X.
           05  DESC-BUF-1      PIC X(40).
           05  SUB-BUF-2       PIC X.
           05  DESC-BUF-2      PIC X(40).
           05  SUB-BUF-3       PIC X.
           05  DESC-BUF-3      PIC X(40).
           05  SUB-BUF-4       PIC X.
           05  DESC-BUF-4      PIC X(40).
           05  SUB-BUF-5       PIC X.
           05  DESC-BUF-5      PIC X(40).
           05  SUB-BUF-6       PIC X.
           05  DESC-BUF-6      PIC X(40).
           05  SUB-BUF-7       PIC X.
           05  DESC-BUF-7      PIC X(40).
           05  SUB-BUF-8       PIC X.
           05  DESC-BUF-8      PIC X(40).
           05  SUB-BUF-9       PIC X.
           05  DESC-BUF-9      PIC X(40).
           05  SUB-BUF-10      PIC X.
           05  DESC-BUF-10     PIC X(40).

       01  HIGHEST-SUB         PIC 99.

       PROCEDURE DIVISION USING DBPARAMETERS
                                EQUIP-TYPE
                                FAILURE-CODE
                                DESC-BUFFER
                                HIGHEST-SUB.

       START-PROGRAM.
           PERFORM 1-HSK.
           PERFORM 6-MAIN THRU 6-MAIN-EXIT.

       2-EOJ.
           IF DESC-BUFFER = SPACES
               MOVE HOLD-TABLE TO DESC-BUFFER.
           CLOSE               WO-EQUIP-HIER.
           GOBACK.

       1-HSK.
           OPEN INPUT          WO-EQUIP-HIER.
           MOVE EQUIP-TYPE     TO SEARCH-TYPE SUFFIX-TYPE.
           MOVE SPACES         TO DESC-BUFFER HOLD-TABLE.
           MOVE "0000"         TO SEARCH-VARIABLES SUFFIX-VARIABLES.
           MOVE "  "           TO SEARCH-REST SUFFIX-REST.
           MOVE 0              TO LEVEL-SW HIGHEST-SUB.

       6-MAIN.
           IF SUBSYSTEM-1 = "X" OR "?" OR " "
               MOVE 1          TO LEVEL-SW
               PERFORM 61-FIND-RECORDS THRU 61-FR-EXIT
               GO TO 6-MAIN-EXIT
           ELSE
               MOVE SUBSYSTEM-1 TO SV-9.

           IF SUBSYSTEM-2 = "X" OR "?" OR " "
               MOVE 2          TO LEVEL-SW
               PERFORM 61-FIND-RECORDS THRU 61-FR-EXIT
               GO TO 6-MAIN-EXIT
           ELSE
               MOVE SUBSYSTEM-2 TO SV-10.

           IF SUBSYSTEM-3 = "X" OR "?" OR " "
               MOVE 3          TO LEVEL-SW
               PERFORM 61-FIND-RECORDS THRU 61-FR-EXIT
               GO TO 6-MAIN-EXIT
           ELSE
               MOVE SUBSYSTEM-3 TO SV-11.

           IF SUBSYSTEM-4 = "X" OR "?" OR " "
               MOVE 4          TO LEVEL-SW
               PERFORM 61-FIND-RECORDS THRU 61-FR-EXIT
               GO TO 6-MAIN-EXIT
           ELSE
               MOVE SUBSYSTEM-4 TO SV-12.

           IF SUBSYSTEM-4 > "0"
               MOVE "0"         TO SV-12
               MOVE SUBSYSTEM-3 TO SV-11
               MOVE SUBSYSTEM-2 TO SV-10
               MOVE SUBSYSTEM-1 TO SV-9
               PERFORM 61-FIND-RECORDS THRU 61-FR-EXIT
               GO TO 6-MAIN-EXIT
           ELSE
           IF SUBSYSTEM-3 > "0"
               MOVE "0"         TO SV-12 SV-11
               MOVE SUBSYSTEM-2 TO SV-10
               MOVE SUBSYSTEM-1 TO SV-9
               PERFORM 61-FIND-RECORDS THRU 61-FR-EXIT
               GO TO 6-MAIN-EXIT
           ELSE
           IF SUBSYSTEM-2 > "0"
               MOVE "0"         TO SV-12 SV-11 SV-10
               MOVE SUBSYSTEM-1 TO SV-9
               PERFORM 61-FIND-RECORDS THRU 61-FR-EXIT
               GO TO 6-MAIN-EXIT
           ELSE
           IF SUBSYSTEM-1 > "0"
               MOVE "0"        TO SV-12 SV-11 SV-10 SV-9
               PERFORM 61-FIND-RECORDS THRU 61-FR-EXIT
               GO TO 6-MAIN-EXIT
           ELSE
           GO TO 6-MAIN-EXIT.

       6-MAIN-EXIT.    EXIT.

       61-FIND-RECORDS.
           IF SEARCH-VARIABLES IS NOT NUMERIC
      *********************************************************************
      **   MESSAGE:  040/061
      **  **** NO SUBSYSTEMS BELOW THIS LEVEL ****
      *********************************************************************
               MOVE  40        TO CATREAD-MSG-SET
               MOVE  61        TO CATREAD-MSG-NUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               GO TO 61-FR-EXIT.

           MOVE SEARCH-KEY     TO HIERKEY OF WO-EQUIP-HIER.
           START WO-EQUIP-HIER KEY = HIERKEY OF WO-EQUIP-HIER.
           IF FILE-STAT NOT = "00"
               IF FILE-STAT-1 = "2"
      *********************************************************************
      **   MESSAGE:  040/061
      **  **** NO SUBSYSTEMS BELOW THIS LEVEL ****
      *********************************************************************
                   MOVE  40    TO CATREAD-MSG-SET
                   MOVE  61    TO CATREAD-MSG-NUM
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   GO TO 61-FR-EXIT
               ELSE
      *********************************************************************
      **   MESSAGE:  045/036
      **  SUBSYSTEM NOT FOUND
      *********************************************************************
                   MOVE  45        TO CATREAD-MSG-SET
                   MOVE  36        TO CATREAD-MSG-NUM
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   GO TO 61-FR-EXIT.

           PERFORM 610-GET-AND-DISPLAY-A-RECORD THRU 610-GADAR-EXIT.

       61-FR-EXIT.    EXIT.

       610-GET-AND-DISPLAY-A-RECORD.
           READ WO-EQUIP-HIER NEXT INTO HIER-WORK-AREA
               AT END GO TO 610-GADAR-EXIT.
           IF FILE-STAT NOT = "00"
               IF FILE-STAT = "10" OR "14" OR "46"
                   IF LEVEL-SW = 0
      *********************************************************************
      **   MESSAGE:  028/001
      **  BREAKDOWN DOES NOT EXIST
      *********************************************************************
                       MOVE  28    TO CATREAD-MSG-SET
                       MOVE   1    TO CATREAD-MSG-NUM
                       PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                       GO TO 610-GADAR-EXIT
                   ELSE
      *********************************************************************
      **   MESSAGE:  047/014
      **  UNABLE TO RETRIEVE LEVEL REQUESTED
      *********************************************************************
                       MOVE  47        TO CATREAD-MSG-SET
                       MOVE  14        TO CATREAD-MSG-NUM
                       PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                       GO TO 610-GADAR-EXIT.

           IF HIER-KEY-WA NOT = SEARCH-KEY
               GO TO 610-GADAR-EXIT.

           IF LEVEL-SW = 1
               MOVE HDC-1-WA     TO SUB-BUF
               MOVE HIER-NAME-WA TO DESC-BUF
               PERFORM 65-FIND-SUB
               MOVE HOLD-BUFFER  TO HOLD-AREA (SUB)
           ELSE
           IF LEVEL-SW = 2
               MOVE HDC-2-WA     TO SUB-BUF
               MOVE HIER-NAME-WA TO DESC-BUF
               PERFORM 65-FIND-SUB
               MOVE HOLD-BUFFER  TO HOLD-AREA (SUB)
           ELSE
           IF LEVEL-SW = 3
               MOVE HDC-3-WA     TO SUB-BUF
               MOVE HIER-NAME-WA TO DESC-BUF
               PERFORM 65-FIND-SUB
               MOVE HOLD-BUFFER  TO HOLD-AREA (SUB)
           ELSE
           IF LEVEL-SW = 4
               MOVE HDC-4-WA     TO SUB-BUF
               MOVE HIER-NAME-WA TO DESC-BUF
               PERFORM 65-FIND-SUB
               MOVE HOLD-BUFFER  TO HOLD-AREA (SUB)
           ELSE
           IF HIER-DC-WA = SUBSYSTEM-KEY
               GO TO 610-GADAR-EXIT.

           GO TO 610-GET-AND-DISPLAY-A-RECORD.

       610-GADAR-EXIT.    EXIT.

       65-FIND-SUB.
           IF SUB-BUF = "1" MOVE 1  TO SUB.
           IF SUB-BUF = "2" MOVE 2  TO SUB.
           IF SUB-BUF = "3" MOVE 3  TO SUB.
           IF SUB-BUF = "4" MOVE 4  TO SUB.
           IF SUB-BUF = "5" MOVE 5  TO SUB.
           IF SUB-BUF = "6" MOVE 6  TO SUB.
           IF SUB-BUF = "7" MOVE 7  TO SUB.
           IF SUB-BUF = "8" MOVE 8  TO SUB.
           IF SUB-BUF = "9" MOVE 9  TO SUB.
           IF SUB-BUF = "0" MOVE 10 TO SUB.
           IF SUB > HIGHEST-SUB
               MOVE SUB             TO HIGHEST-SUB.

       999-CATREAD.
           MOVE SPACES           TO DESC-BUF-4.
           CALL "CCATREAD" USING CATREAD-PARMS.
           MOVE CATREAD-MSG-TEXT TO DESC-BUF-4.

       999-CATREAD-EXIT.    EXIT.

